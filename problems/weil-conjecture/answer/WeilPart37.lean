      intro b
      dsimp only [weilProjectiveSpaceOver, CategoryTheory.Over.mk_left, CategoryTheory.Over.mk_hom]
      rw [← CategoryTheory.cancel_epi (j b).inv, ← CategoryTheory.Category.assoc, hj_inv_ι b,
        CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc
          (AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X b) (hX b) hpos),
        AlgebraicGeometry.Proj.awayι_toSpecZero,
        ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp,
        ← CategoryTheory.Category.assoc (j b).inv, (j b).inv_hom_id,
        CategoryTheory.Category.id_comp]
      congr 2
      apply RingHom.ext
      intro c
      change φ b (c_hom b c) = Polynomial.C c
      have hc_ψ : c_hom b c = ψ b (Polynomial.C c) := by simp [ψ]
      rw [hc_ψ]
      exact congrArg (fun f => f (Polynomial.C c)) (hφψ b)

    have hj_ov : ∀ b : Fin (1 + 1),
        (TopologicalSpace.Opens.map (D b).ι.base).obj (D (other b)) =
          (TopologicalSpace.Opens.map (j b).hom.base).obj
            (PrimeSpectrum.basicOpen (Polynomial.X : Polynomial K)) := by
      intro b
      have hφ_elem : φ b (HomogeneousLocalization.Away.isLocalizationElem (hX b) (hX (other b))) =
          Polynomial.X := by
        have heq_elem : HomogeneousLocalization.Away.isLocalizationElem (hX b) (hX (other b)) =
            t_el b := by
          rw [HomogeneousLocalization.ext_iff_val]
          change Localization.mk (MvPolynomial.X (other b) ^ 1) ⟨MvPolynomial.X b ^ 1, _⟩ =
            Localization.mk (MvPolynomial.X (other b)) ⟨MvPolynomial.X b ^ 1, _⟩
          simp [pow_one]
        rw [heq_elem, hφ_mk b 1 (MvPolynomial.X (other b)) (hX_smul1 (other b)), hev_Xother b]
      have hpre_away :=
        AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜 (hX b) hpos (hX (other b)) hpos
      apply SetLike.ext
      intro u
      have hu1 : u ∈ (TopologicalSpace.Opens.map (D b).ι.base).obj (D (other b)) ↔
          (j b).hom.base u ∈
            (TopologicalSpace.Opens.map ((j b).inv ≫ (D b).ι).base).obj (D (other b)) := by
        change (D b).ι.base u ∈ D (other b) ↔ ((j b).hom ≫ (j b).inv ≫ (D b).ι).base u ∈ D (other b)
        rw [← CategoryTheory.Category.assoc (j b).hom (j b).inv, (j b).hom_inv_id,
          CategoryTheory.Category.id_comp]
      rw [hu1, hj_inv_ι b]
      change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ b))).base ((j b).hom.base u) ∈
          (TopologicalSpace.Opens.map
            (AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X b) (hX b) hpos).base).obj
            (D (other b)) ↔
        (j b).hom.base u ∈ PrimeSpectrum.basicOpen (Polynomial.X : Polynomial K)
      rw [hpre_away]
      exact (PrimeSpectrum.mem_basicOpen _ _).trans
        ((not_congr (Iff.of_eq (congrArg (· ∈ ((j b).hom.base u).asIdeal) hφ_elem))).trans
          (PrimeSpectrum.mem_basicOpen _ _).symm)

    
    have hDGlue :
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_id) ≫ (j 0).inv ≫ (D 0).ι =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_inv) ≫ (j 1).inv ≫ (D 1).ι := by
      let x01 : A := MvPolynomial.X 0 * MvPolynomial.X 1
      have hx0 : x01 = MvPolynomial.X 0 * MvPolynomial.X 1 := rfl
      have hx1 : x01 = MvPolynomial.X 1 * MvPolynomial.X 0 := mul_comm _ _
      let ev01 : A →+* L_X := α_id.comp (ev 0)
      have hev01_X0 : ev01 (MvPolynomial.X 0) = 1 := by
        simp [ev01, hev_Xb 0]
      have hev01_X1 : ev01 (MvPolynomial.X 1) = α_id X_poly := by
        change α_id (ev 0 (MvPolynomial.X (other 0))) = α_id X_poly
        rw [hev_Xother 0]
      have hev01_x01 : ev01 x01 = α_id X_poly := by
        dsimp [x01]
        rw [map_mul, hev01_X0, hev01_X1, one_mul]
      have hu_x01 : IsUnit (ev01 x01) := by
        rw [hev01_x01]
        exact IsLocalization.Away.algebraMap_isUnit X_poly
      let lift01 : Localization (Submonoid.powers x01) →+* L_X :=
        IsLocalization.Away.lift x01 hu_x01
      let ω : HomogeneousLocalization.Away 𝒜 x01 →+* L_X :=
        lift01.comp (algebraMap _ _)
      let m0 : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 0) →+*
          HomogeneousLocalization.Away 𝒜 x01 :=
        HomogeneousLocalization.awayMap 𝒜 (hX 1) hx0
      let m1 : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 1) →+*
          HomogeneousLocalization.Away 𝒜 x01 :=
        HomogeneousLocalization.awayMap 𝒜 (hX 0) hx1
      have hC_mem0 : ∀ c : K, (MvPolynomial.C c : A) ∈ 𝒜 (0 • 1) := by
        intro c
        rw [zero_smul]
        have hC_eq : (MvPolynomial.C c : A) = (algebraMap K ↥(𝒜 0) c).1 := (halg0_val c).symm
        rw [hC_eq]
        exact (algebraMap K ↥(𝒜 0) c).2
      have hc_eq_mk : ∀ (b : Fin (1 + 1)) (c : K),
          c_hom b c = HomogeneousLocalization.Away.mk 𝒜 (hX b) 0 (MvPolynomial.C c) (hC_mem0 c) := by
        intro b c
        rw [HomogeneousLocalization.ext_iff_val, ← HomogeneousLocalization.algebraMap_apply,
          hval_c b c, HomogeneousLocalization.Away.val_mk]
        have hsub1 : (⟨MvPolynomial.X b ^ 0, 0, rfl⟩ : Submonoid.powers (MvPolynomial.X b : A)) = 1 :=
          Subtype.ext (pow_zero _)
        rw [hsub1]
        rfl
      have hm0_ψ : (ω.comp m0).comp (ψ 0) = α_id := by
        apply Polynomial.ringHom_ext'
        · apply RingHom.ext
          intro c
          simp only [RingHom.comp_apply, ψ, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
          rw [hc_eq_mk 0 c]
          dsimp [m0]
          rw [HomogeneousLocalization.awayMap_mk]
          dsimp only [ω, RingHom.comp_apply]
          rw [HomogeneousLocalization.algebraMap_apply,
            HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk']
          dsimp [lift01, IsLocalization.Away.lift]
          rw [IsLocalization.lift_mk'_spec]
          change ev01 (MvPolynomial.C c * MvPolynomial.X 1 ^ 0) =
            ev01 (x01 ^ 0) * α_id (Polynomial.C c)
          have hev0_C : ev 0 (MvPolynomial.C c) = Polynomial.C c := by
            dsimp [ev]
            exact MvPolynomial.eval₂Hom_C _ _ _
          rw [pow_zero, pow_zero, mul_one, map_one, one_mul]
          exact congrArg α_id hev0_C
        · simp only [RingHom.comp_apply, ψ, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
          dsimp [t_el, m0]
          rw [HomogeneousLocalization.awayMap_mk]
          dsimp only [ω, RingHom.comp_apply]
          rw [HomogeneousLocalization.algebraMap_apply,
            HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk']
          dsimp [lift01, IsLocalization.Away.lift]
          rw [IsLocalization.lift_mk'_spec]
          have ho0 : other 0 = 1 := rfl
          change ev01 (MvPolynomial.X (other 0) * MvPolynomial.X 1 ^ 1) =
            ev01 (x01 ^ 1) * α_id X_poly
          rw [ho0, pow_one, pow_one, map_mul, hev01_X1, hev01_x01]
      have hm1_ψ : (ω.comp m1).comp (ψ 1) = α_inv := by
        apply Polynomial.ringHom_ext'
        · apply RingHom.ext
          intro c
          simp only [RingHom.comp_apply, ψ, α_inv, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
          rw [hc_eq_mk 1 c]
          dsimp [m1]
          rw [HomogeneousLocalization.awayMap_mk]
          dsimp only [ω, RingHom.comp_apply]
          rw [HomogeneousLocalization.algebraMap_apply,
            HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk']
          dsimp [lift01, IsLocalization.Away.lift]
          rw [IsLocalization.lift_mk'_spec]
          change ev01 (MvPolynomial.C c * MvPolynomial.X 0 ^ 0) =
            ev01 (x01 ^ 0) * α_id (Polynomial.C c)
          have hev0_C : ev 0 (MvPolynomial.C c) = Polynomial.C c := by
            dsimp [ev]
            exact MvPolynomial.eval₂Hom_C _ _ _
          rw [pow_zero, pow_zero, mul_one, map_one, one_mul]
          exact congrArg α_id hev0_C
        · simp only [RingHom.comp_apply, ψ, α_inv, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
          dsimp [t_el, m1]
          rw [HomogeneousLocalization.awayMap_mk]
          dsimp only [ω, RingHom.comp_apply]
          rw [HomogeneousLocalization.algebraMap_apply,
            HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk']
          dsimp [lift01, IsLocalization.Away.lift]
          rw [IsLocalization.lift_mk'_spec]
          have ho1 : other 1 = 0 := rfl
          change ev01 (MvPolynomial.X (other 1) * MvPolynomial.X 0 ^ 1) =
            ev01 (x01 ^ 1) * IsLocalization.Away.invSelf (S := L_X) X_poly
          rw [ho1, pow_one, pow_one, map_mul, hev01_X0, one_mul, hev01_x01]
          exact (IsLocalization.Away.mul_invSelf X_poly).symm
      have h0_spec :
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_id) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ 0)) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom ω) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom m0) := by
        have hm0 : α_id.comp (φ 0) = ω.comp m0 := by
          rw [← hm0_ψ, RingHom.comp_assoc, hψφ 0, RingHom.comp_id]
        rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hm0]
      have h1_spec :
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_inv) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ 1)) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom ω) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom m1) := by
        have hm1 : α_inv.comp (φ 1) = ω.comp m1 := by
          rw [← hm1_ψ, RingHom.comp_assoc, hψφ 1, RingHom.comp_id]
        rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hm1]
      rw [hj_inv_ι 0, hj_inv_ι 1,
        ← CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_id)),
        ← CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_inv)),
        h0_spec, h1_spec, CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        AlgebraicGeometry.Proj.SpecMap_awayMap_awayι 𝒜 (hX 0) hpos (hX 1) hx0,
        AlgebraicGeometry.Proj.SpecMap_awayMap_awayι 𝒜 (hX 1) hpos (hX 0) hx1]

    
    have hOpenExt : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (W₀ W₁ : X.Opens),
        W₀ ⊔ W₁ = ⊤ →
        ∀ (g₁ g₂ : X ⟶ Y),
          W₀.ι ≫ g₁ = W₀.ι ≫ g₂ →
          W₁.ι ≫ g₁ = W₁.ι ≫ g₂ →
          g₁ = g₂ := by
      intro X Y W₀ W₁ hWCov g₁ g₂ hg0 hg1
      let W : Fin 2 → X.Opens := Fin.cases W₀ (fun _ => W₁)
      have hWSup : (⨆ a : Fin 2, W a) = ⊤ := by
        rw [eq_top_iff]
        intro x _
        have hx : x ∈ W₀ ⊔ W₁ := by rw [hWCov]; trivial
        rw [TopologicalSpace.Opens.mem_iSup]
        rcases hx with h0 | h1
        · exact ⟨0, h0⟩
        · exact ⟨1, h1⟩
      let 𝒰 : X.OpenCover :=
        X.openCoverOfIsOpenCover W (TopologicalSpace.IsOpenCover.mk hWSup)
      refine 𝒰.hom_ext g₁ g₂ ?_
      change ∀ a : Fin 2, (W a).ι ≫ g₁ = (W a).ι ≫ g₂
      intro a
      fin_cases a
      · exact hg0
      · exact hg1

    have hGlueHom : ∀ {X Y : AlgebraicGeometry.Scheme.{u}}
        (W₀ W₁ : X.Opens) (hWCov : W₀ ⊔ W₁ = ⊤)
        (p₀ : W₀.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial K)))
        (p₁ : W₁.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial K)))
        (hWOv₀ : (TopologicalSpace.Opens.map W₀.ι.base).obj W₁ =
          (TopologicalSpace.Opens.map p₀.hom.base).obj
            (PrimeSpectrum.basicOpen (Polynomial.X : Polynomial K)))
        (hWGlue : AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_id) ≫ p₀.inv ≫ W₀.ι =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_inv) ≫ p₁.inv ≫ W₁.ι)
        (V₀ V₁ : Y.Opens)
        (q₀ : V₀.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial K)))
        (q₁ : V₁.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial K)))
        (hVGlue : AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_id) ≫ q₀.inv ≫ V₀.ι =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_inv) ≫ q₁.inv ≫ V₁.ι),
        ∃ Φ : X ⟶ Y,
          W₀.ι ≫ Φ = p₀.hom ≫ q₀.inv ≫ V₀.ι ∧
          W₁.ι ≫ Φ = p₁.hom ≫ q₁.inv ≫ V₁.ι := by
      intro X Y W₀ W₁ hWCov p₀ p₁ hWOv₀ hWGlue V₀ V₁ q₀ q₁ hVGlue
      let W : Fin 2 → X.Opens := Fin.cases W₀ (fun _ => W₁)
      have hWSup : (⨆ a : Fin 2, W a) = ⊤ := by
        rw [eq_top_iff]
        intro x _
        have hx : x ∈ W₀ ⊔ W₁ := by rw [hWCov]; trivial
        rw [TopologicalSpace.Opens.mem_iSup]
        rcases hx with h0 | h1
        · exact ⟨0, h0⟩
        · exact ⟨1, h1⟩
      let 𝒰 : X.OpenCover :=
        X.openCoverOfIsOpenCover W (TopologicalSpace.IsOpenCover.mk hWSup)
      let f : ∀ a : Fin 2, (W a).toScheme ⟶ Y :=
        Fin.cases (p₀.hom ≫ q₀.inv ≫ V₀.ι) (fun _ => p₁.hom ≫ q₁.inv ≫ V₁.ι)
      
      have h01 : CategoryTheory.Limits.pullback.fst W₀.ι W₁.ι ≫ (p₀.hom ≫ q₀.inv ≫ V₀.ι) =
          CategoryTheory.Limits.pullback.snd W₀.ι W₁.ι ≫ (p₁.hom ≫ q₁.inv ≫ V₁.ι) := by
        let π₀ := CategoryTheory.Limits.pullback.fst W₀.ι W₁.ι
        let π₁ := CategoryTheory.Limits.pullback.snd W₀.ι W₁.ι
        let s_id : AlgebraicGeometry.Spec (CommRingCat.of L_X) ⟶
            AlgebraicGeometry.Spec (CommRingCat.of (Polynomial K)) :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_id)
        let lam₀ : AlgebraicGeometry.Spec (CommRingCat.of L_X) ⟶ X :=
          s_id ≫ p₀.inv ≫ W₀.ι
        have hRangeEq : Set.range ⇑(π₀ ≫ W₀.ι) = Set.range ⇑lam₀ := by
          have hRange1 : Set.range ⇑(π₀ ≫ W₀.ι) = (W₀ : Set X) ∩ (W₁ : Set X) := by
            ext x
            constructor
            · rintro ⟨z, rfl⟩
              refine ⟨?_, ?_⟩
              · rw [← AlgebraicGeometry.Scheme.Opens.range_ι]
                exact ⟨π₀ z, rfl⟩
              · have hcond : π₀ ≫ W₀.ι = π₁ ≫ W₁.ι :=
                  CategoryTheory.Limits.pullback.condition
                rw [hcond, ← AlgebraicGeometry.Scheme.Opens.range_ι]
                exact ⟨π₁ z, rfl⟩
            · rintro ⟨hx0, hx1⟩
              rw [← AlgebraicGeometry.Scheme.Opens.range_ι] at hx0 hx1
              rcases hx0 with ⟨u0, hu0⟩
              rcases hx1 with ⟨u1, hu1⟩
              obtain ⟨z, hz0, _⟩ :=
                AlgebraicGeometry.Scheme.exists_preimage_of_isPullback
                  (CategoryTheory.IsPullback.of_hasPullback W₀.ι W₁.ι)
                  u0 u1 (hu0.trans hu1.symm)
              refine ⟨z, ?_⟩
              change W₀.ι (π₀ z) = x
              rw [hz0, hu0]
          have hRange2 : Set.range ⇑lam₀ = (W₀ : Set X) ∩ (W₁ : Set X) := by
            have hLocRange : Set.range (PrimeSpectrum.comap α_id) =
                (PrimeSpectrum.basicOpen X_poly : Set (PrimeSpectrum (Polynomial K))) :=
              PrimeSpectrum.localization_away_comap_range L_X X_poly
            ext x
            constructor
            · rintro ⟨q, rfl⟩
              let u0 : W₀.toScheme := p₀.inv (s_id q)
              have hu0_x : W₀.ι u0 = lam₀ q := rfl
              refine ⟨?_, ?_⟩
              · rw [← hu0_x, ← AlgebraicGeometry.Scheme.Opens.range_ι]
                exact ⟨u0, rfl⟩
              · have hp0_u0 : p₀.hom.base u0 = PrimeSpectrum.comap α_id q := by
                  change (p₀.inv ≫ p₀.hom) (s_id q) = s_id q
                  rw [p₀.inv_hom_id]
                  rfl
                have hmem_basic :
                    (p₀.hom.base u0 : PrimeSpectrum (Polynomial K)) ∈
                      (PrimeSpectrum.basicOpen X_poly : Set (PrimeSpectrum (Polynomial K))) := by
                  rw [hp0_u0, ← hLocRange]
                  exact ⟨q, rfl⟩
                have hmem_pre : u0 ∈ (TopologicalSpace.Opens.map p₀.hom.base).obj
                    (PrimeSpectrum.basicOpen X_poly) := hmem_basic
                rw [← hWOv₀] at hmem_pre
                exact hmem_pre
            · rintro ⟨hx0, hx1⟩
              rw [← AlgebraicGeometry.Scheme.Opens.range_ι] at hx0
              rcases hx0 with ⟨u0, rfl⟩
              have hmem_pre : u0 ∈ (TopologicalSpace.Opens.map W₀.ι.base).obj W₁ := hx1
              rw [hWOv₀] at hmem_pre
              have hmem_basic :
                  (p₀.hom.base u0 : PrimeSpectrum (Polynomial K)) ∈
                    (PrimeSpectrum.basicOpen X_poly : Set (PrimeSpectrum (Polynomial K))) :=
                hmem_pre
              rw [← hLocRange] at hmem_basic
              rcases hmem_basic with ⟨q, hq⟩
              refine ⟨q, ?_⟩
              change W₀.ι (p₀.inv (s_id q)) = W₀.ι u0
              have hq' : s_id q = p₀.hom u0 := hq
              rw [hq']
              have hinv_hom : p₀.inv (p₀.hom u0) = u0 := by
                change (p₀.hom ≫ p₀.inv) u0 = u0
                rw [p₀.hom_inv_id]
                rfl
              rw [hinv_hom]
          rw [hRange1, hRange2]
        let ε : CategoryTheory.Limits.pullback W₀.ι W₁.ι ≅
            AlgebraicGeometry.Spec (CommRingCat.of L_X) :=
          AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq (π₀ ≫ W₀.ι) lam₀ hRangeEq
        have hε_fac : ε.inv ≫ (π₀ ≫ W₀.ι) = lam₀ :=
          AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_inv_fac (π₀ ≫ W₀.ι) lam₀ hRangeEq
        have hε_π0 : ε.inv ≫ π₀ = s_id ≫ p₀.inv := by
          rw [← CategoryTheory.cancel_mono W₀.ι, CategoryTheory.Category.assoc, hε_fac]
          rfl
        have hε_π1 : ε.inv ≫ π₁ =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_inv) ≫ p₁.inv := by
          rw [← CategoryTheory.cancel_mono W₁.ι, CategoryTheory.Category.assoc,
            ← CategoryTheory.Limits.pullback.condition, hε_fac,
            show lam₀ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_id) ≫ p₀.inv ≫ W₀.ι
              from rfl,
            hWGlue, CategoryTheory.Category.assoc]
        rw [← CategoryTheory.cancel_epi ε.inv, ← CategoryTheory.Category.assoc, hε_π0,
          ← CategoryTheory.Category.assoc ε.inv π₁, hε_π1]
        calc
          (s_id ≫ p₀.inv) ≫ p₀.hom ≫ q₀.inv ≫ V₀.ι
            = s_id ≫ (p₀.inv ≫ p₀.hom) ≫ q₀.inv ≫ V₀.ι := by
              simp only [CategoryTheory.Category.assoc]
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_id) ≫ q₀.inv ≫ V₀.ι := by
              rw [p₀.inv_hom_id, CategoryTheory.Category.id_comp]
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_inv) ≫ q₁.inv ≫ V₁.ι := hVGlue
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_inv) ≫
                (p₁.inv ≫ p₁.hom) ≫ q₁.inv ≫ V₁.ι := by
              rw [p₁.inv_hom_id, CategoryTheory.Category.id_comp]
          _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_inv) ≫ p₁.inv) ≫
                p₁.hom ≫ q₁.inv ≫ V₁.ι := by
              simp only [CategoryTheory.Category.assoc]
      have hf : ∀ (a b : 𝒰.I₀),
          CategoryTheory.Limits.pullback.fst (𝒰.f a) (𝒰.f b) ≫ f a =
            CategoryTheory.Limits.pullback.snd (𝒰.f a) (𝒰.f b) ≫ f b := by
        change ∀ (a b : Fin 2),
          CategoryTheory.Limits.pullback.fst (W a).ι (W b).ι ≫ f a =
            CategoryTheory.Limits.pullback.snd (W a).ι (W b).ι ≫ f b
        intro a b
        refine Fin.cases ?_ (fun a0 => ?_) a
        · refine Fin.cases ?_ (fun b0 => ?_) b
          · change CategoryTheory.Limits.pullback.fst W₀.ι W₀.ι ≫ (p₀.hom ≫ q₀.inv ≫ V₀.ι) =
              CategoryTheory.Limits.pullback.snd W₀.ι W₀.ι ≫ (p₀.hom ≫ q₀.inv ≫ V₀.ι)
            have heq : CategoryTheory.Limits.pullback.fst W₀.ι W₀.ι =
                CategoryTheory.Limits.pullback.snd W₀.ι W₀.ι := by
              rw [← CategoryTheory.cancel_mono W₀.ι]
              exact CategoryTheory.Limits.pullback.condition
            rw [heq]
          · have hb0 : b0 = 0 := Subsingleton.elim _ _
            subst hb0
            exact h01
        · have ha0 : a0 = 0 := Subsingleton.elim _ _
          subst ha0
          refine Fin.cases ?_ (fun b0 => ?_) b
          · change CategoryTheory.Limits.pullback.fst W₁.ι W₀.ι ≫ (p₁.hom ≫ q₁.inv ≫ V₁.ι) =
              CategoryTheory.Limits.pullback.snd W₁.ι W₀.ι ≫ (p₀.hom ≫ q₀.inv ≫ V₀.ι)
            rw [← CategoryTheory.cancel_epi
                (CategoryTheory.Limits.pullbackSymmetry W₀.ι W₁.ι).hom,
              ← CategoryTheory.Category.assoc
                (CategoryTheory.Limits.pullbackSymmetry W₀.ι W₁.ι).hom,
              CategoryTheory.Limits.pullbackSymmetry_hom_comp_fst,
              ← CategoryTheory.Category.assoc
                (CategoryTheory.Limits.pullbackSymmetry W₀.ι W₁.ι).hom,
              CategoryTheory.Limits.pullbackSymmetry_hom_comp_snd]
            exact h01.symm
          · have hb0 : b0 = 0 := Subsingleton.elim _ _
            subst hb0
            change CategoryTheory.Limits.pullback.fst W₁.ι W₁.ι ≫ (p₁.hom ≫ q₁.inv ≫ V₁.ι) =
              CategoryTheory.Limits.pullback.snd W₁.ι W₁.ι ≫ (p₁.hom ≫ q₁.inv ≫ V₁.ι)
            have heq : CategoryTheory.Limits.pullback.fst W₁.ι W₁.ι =
                CategoryTheory.Limits.pullback.snd W₁.ι W₁.ι := by
              rw [← CategoryTheory.cancel_mono W₁.ι]
              exact CategoryTheory.Limits.pullback.condition
            rw [heq]
      refine ⟨𝒰.glueMorphisms f hf, ?_, ?_⟩
      · exact 𝒰.ι_glueMorphisms f hf (0 : Fin 2)
      · exact 𝒰.ι_glueMorphisms f hf (1 : Fin 2)

    dsimp only [weilProjectiveSpaceOver, CategoryTheory.Over.mk_left, CategoryTheory.Over.mk_hom]
      at hj_hom ⊢
    obtain ⟨Φ, hΦ0, hΦ1⟩ :=
      hGlueHom (Y := AlgebraicGeometry.Proj 𝒜) U₀ U₁ hCov i₀ i₁ hOv₀ hGlue
        (D 0) (D 1) (j 0) (j 1) hDGlue
    obtain ⟨Ψ, hΨ0, hΨ1⟩ :=
      hGlueHom (X := AlgebraicGeometry.Proj 𝒜) (D 0) (D 1) hDCov (j 0) (j 1) (hj_ov 0) hDGlue
        U₀ U₁ i₀ i₁ hGlue

    have hΦΨ : Φ ≫ Ψ = 𝟙 T.left := by
      refine hOpenExt U₀ U₁ hCov (Φ ≫ Ψ) (𝟙 T.left) ?_ ?_
      · rw [← CategoryTheory.Category.assoc, hΦ0, CategoryTheory.Category.assoc,
          CategoryTheory.Category.assoc, hΨ0, ← CategoryTheory.Category.assoc (j 0).inv,
          (j 0).inv_hom_id, CategoryTheory.Category.id_comp,
          ← CategoryTheory.Category.assoc i₀.hom, i₀.hom_inv_id,
          CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]
      · rw [← CategoryTheory.Category.assoc, hΦ1, CategoryTheory.Category.assoc,
          CategoryTheory.Category.assoc, hΨ1, ← CategoryTheory.Category.assoc (j 1).inv,
          (j 1).inv_hom_id, CategoryTheory.Category.id_comp,
          ← CategoryTheory.Category.assoc i₁.hom, i₁.hom_inv_id,
          CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]

    have hΨΦ : Ψ ≫ Φ = 𝟙 (AlgebraicGeometry.Proj 𝒜) := by
      refine hOpenExt (D 0) (D 1) hDCov (Ψ ≫ Φ) (𝟙 _) ?_ ?_
      · rw [← CategoryTheory.Category.assoc, hΨ0, CategoryTheory.Category.assoc,
          CategoryTheory.Category.assoc, hΦ0, ← CategoryTheory.Category.assoc i₀.inv,
          i₀.inv_hom_id, CategoryTheory.Category.id_comp,
          ← CategoryTheory.Category.assoc (j 0).hom, (j 0).hom_inv_id,
          CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]
      · rw [← CategoryTheory.Category.assoc, hΨ1, CategoryTheory.Category.assoc,
          CategoryTheory.Category.assoc, hΦ1, ← CategoryTheory.Category.assoc i₁.inv,
          i₁.inv_hom_id, CategoryTheory.Category.id_comp,
          ← CategoryTheory.Category.assoc (j 1).hom, (j 1).hom_inv_id,
          CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]

    have hΦ_hom :
        Φ ≫
            (AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K ↥(𝒜 0)))) =
          T.hom := by
      refine hOpenExt U₀ U₁ hCov _ T.hom ?_ ?_
      · rw [← CategoryTheory.Category.assoc, hΦ0, CategoryTheory.Category.assoc,
          CategoryTheory.Category.assoc, hj_hom 0,
          ← CategoryTheory.Category.assoc (j 0).inv, (j 0).inv_hom_id,
          CategoryTheory.Category.id_comp, hi₀]
      · rw [← CategoryTheory.Category.assoc, hΦ1, CategoryTheory.Category.assoc,
          CategoryTheory.Category.assoc, hj_hom 1,
          ← CategoryTheory.Category.assoc (j 1).inv, (j 1).inv_hom_id,
          CategoryTheory.Category.id_comp, hi₁]

    exact ⟨{ hom := Φ, inv := Ψ, hom_inv_id := hΦΨ, inv_hom_id := hΨΦ }, hΦ_hom⟩

theorem weil_split_quad_cone_incidence_subscheme_and_charts (K : Type u) [Field K]
    (m : ℕ)
    (Q_succ Z_cone Q_m : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
    [AlgebraicGeometry.IsProper Z_cone.hom]
    [AlgebraicGeometry.IsProper Q_m.hom]
    (ι_succ : Q_succ.left ⟶ (weilProjectiveSpaceOver K (2 * (m + 1) + 1)).left)
    (hι_succ : ι_succ ≫ (weilProjectiveSpaceOver K (2 * (m + 1) + 1)).hom = Q_succ.hom)
    (i_Z : Z_cone ⟶ Q_succ)
    (ι_m : Q_m.left ⟶ (weilProjectiveSpaceOver K (2 * m + 1)).left)
    (hι_m : ι_m ≫ (weilProjectiveSpaceOver K (2 * m + 1)).hom = Q_m.hom)
    (hSplit_succ : IsHomogeneousHypersurfacePullbackOver K (2 * (m + 1) + 1) 2
      (𝟙 (weilProjectiveSpaceOver K (2 * (m + 1) + 1)))
      (∑ j ∈ Finset.range (m + 1 + 1),
        if h : 2 * j + 1 < 2 * (m + 1) + 1 + 1 then
          (MvPolynomial.X ⟨2 * j, Nat.lt_of_succ_lt h⟩ :
            MvPolynomial (Fin (2 * (m + 1) + 1 + 1)) K) *
            MvPolynomial.X ⟨2 * j + 1, h⟩
        else 0)
      ι_succ)
    (hSplit_Z : IsHomogeneousHypersurfacePullbackOver K (2 * (m + 1) + 1) 1
      (CategoryTheory.Over.homMk ι_succ hι_succ)
      (MvPolynomial.X 0)
      i_Z.left)
    (hSplit_m : IsHomogeneousHypersurfacePullbackOver K (2 * m + 1) 2
      (𝟙 (weilProjectiveSpaceOver K (2 * m + 1)))
      (∑ j ∈ Finset.range (m + 1),
        if h : 2 * j + 1 < 2 * m + 1 + 1 then
          (MvPolynomial.X ⟨2 * j, Nat.lt_of_succ_lt h⟩ :
            MvPolynomial (Fin (2 * m + 1 + 1)) K) *
            MvPolynomial.X ⟨2 * j + 1, h⟩
        else 0)
      ι_m) :
    let Z_chart : Fin (2 * (m + 1) + 2) → Z_cone.left.Opens :=
      fun μ => (TopologicalSpace.Opens.map (i_Z.left ≫ ι_succ).base).obj
        (weilProjBasicOpen K (2 * (m + 1) + 1) μ)
    let U_Z : Z_cone.left.Opens := ⨆ c : Fin (2 * m + 2), Z_chart c.succ.succ
    let W : Fin (2 * m + 2) → Q_m.left.Opens :=
      fun b => (TopologicalSpace.Opens.map ι_m.base).obj (weilProjBasicOpen K (2 * m + 1) b)
    Z_chart 0 = ⊥ →
    Z_chart 1 ⊔ U_Z = ⊤ →
    ∀ (p₀ : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ Z_cone.left)
      (σ_inf : Q_m ⟶ Z_cone)
      (hp₀_D1 : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of K)).Opens) ≤
        (TopologicalSpace.Opens.map (p₀ ≫ i_Z.left ≫ ι_succ).base).obj
          (weilProjBasicOpen K (2 * (m + 1) + 1) 1))
      (hσ_Db : ∀ b : Fin (2 * m + 2),
        W b ≤ (TopologicalSpace.Opens.map (σ_inf.left ≫ i_Z.left ≫ ι_succ).base).obj
          (weilProjBasicOpen K (2 * (m + 1) + 1) b.succ.succ)),
      p₀ ≫ Z_cone.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of K)) →
      (U_Z : Set Z_cone.left) = (Set.range p₀.base)ᶜ →
      Set.range σ_inf.left.base ⊆ (U_Z : Set Z_cone.left) →
      (∀ a : Fin (2 * m + 2),
        (letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (2 * (m + 1) + 2)) K) :=
          MvPolynomial.gradedAlgebra
         ((p₀ ≫ i_Z.left ≫ ι_succ).appLE
           (weilProjBasicOpen K (2 * (m + 1) + 1) 1) ⊤ hp₀_D1).hom
           ((AlgebraicGeometry.Proj.awayToSection
             (MvPolynomial.homogeneousSubmodule (Fin (2 * (m + 1) + 2)) K)
             (MvPolynomial.X 1)).hom
             (HomogeneousLocalization.Away.mk
               (MvPolynomial.homogeneousSubmodule (Fin (2 * (m + 1) + 2)) K)
               (MvPolynomial.isHomogeneous_X K 1) 1
               (MvPolynomial.X a.succ.succ)
               (MvPolynomial.isHomogeneous_X K a.succ.succ)))) = 0) →
      (∀ b a : Fin (2 * m + 2),
        (letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (2 * (m + 1) + 2)) K) :=
          MvPolynomial.gradedAlgebra
         letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (2 * m + 2)) K) :=
          MvPolynomial.gradedAlgebra
         ((σ_inf.left ≫ i_Z.left ≫ ι_succ).appLE
           (weilProjBasicOpen K (2 * (m + 1) + 1) b.succ.succ) (W b) (hσ_Db b)).hom
           ((AlgebraicGeometry.Proj.awayToSection
             (MvPolynomial.homogeneousSubmodule (Fin (2 * (m + 1) + 2)) K)
             (MvPolynomial.X b.succ.succ)).hom
             (HomogeneousLocalization.Away.mk
               (MvPolynomial.homogeneousSubmodule (Fin (2 * (m + 1) + 2)) K)
               (MvPolynomial.isHomogeneous_X K b.succ.succ) 1
               (MvPolynomial.X a.succ.succ)
               (MvPolynomial.isHomogeneous_X K a.succ.succ))) =
         (ι_m.appLE (weilProjBasicOpen K (2 * m + 1) b) (W b) (le_refl _)).hom
           ((AlgebraicGeometry.Proj.awayToSection
             (MvPolynomial.homogeneousSubmodule (Fin (2 * m + 2)) K)
             (MvPolynomial.X b)).hom
             (HomogeneousLocalization.Away.mk
               (MvPolynomial.homogeneousSubmodule (Fin (2 * m + 2)) K)
               (MvPolynomial.isHomogeneous_X K b) 1
               (MvPolynomial.X a)
               (MvPolynomial.isHomogeneous_X K a))))) →
      ∃ (Z_tilde : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
        (_ : AlgebraicGeometry.IsProper Z_tilde.hom)
        (π_Z : Z_tilde ⟶ Z_cone)
        (_ : AlgebraicGeometry.IsProper π_Z.left)
        (p_Q : Z_tilde ⟶ Q_m)
        (_ : AlgebraicGeometry.IsProper p_Q.left)
        (i₀ i_inf : Q_m ⟶ Z_tilde)
        (V_plus : Z_tilde.left.Opens)
        (s_inf_V : Q_m.left ⟶ V_plus.toScheme)
        (R_b : Fin (2 * m + 2) → Type u)
        (hCR : ∀ b : Fin (2 * m + 2), CommRing (R_b b))
        (hAlg : ∀ b : Fin (2 * m + 2), letI := hCR b; Algebra K (R_b b))
        (i_Wb : ∀ b : Fin (2 * m + 2),
          letI := hCR b
          (W b).toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of (R_b b)))
        (U_chart0 U_chart1 : Fin (2 * m + 2) → Z_tilde.left.Opens)
        (j_0 : ∀ b : Fin (2 * m + 2),
          letI := hCR b
          (U_chart0 b).toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial (R_b b))))
        (j_1 : ∀ b : Fin (2 * m + 2),
          letI := hCR b
          (U_chart1 b).toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial (R_b b)))),
        (CategoryTheory.IsIso (π_Z.left ∣_ U_Z) ∧
          i₀ ≫ p_Q = 𝟙 Q_m ∧
          i_inf ≫ p_Q = 𝟙 Q_m ∧
          AlgebraicGeometry.IsClosedImmersion i₀.left ∧
          (V_plus : Set Z_tilde.left) = (Set.range i₀.left.base)ᶜ ∧
          CategoryTheory.IsPullback i₀.left Q_m.hom π_Z.left p₀ ∧
          s_inf_V ≫ V_plus.ι = i_inf.left) ∧
        (∀ b : Fin (2 * m + 2),
          letI : CommRing (R_b b) := hCR b
          letI : Algebra K (R_b b) := hAlg b
          (i_Wb b).inv ≫ (W b).ι ≫ Q_m.hom =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K (R_b b))) ∧
          (TopologicalSpace.Opens.map p_Q.left.base).obj (W b) = U_chart0 b ⊔ U_chart1 b ∧
          (TopologicalSpace.Opens.map p_Q.left.base).obj (W b) ⊓ V_plus = U_chart1 b ∧
          (∃ (q_0 : (U_chart0 b).toScheme ⟶ (W b).toScheme)
             (q_1 : (U_chart1 b).toScheme ⟶ (W b).toScheme),
            q_0 ≫ (W b).ι = (U_chart0 b).ι ≫ p_Q.left ∧
            q_1 ≫ (W b).ι = (U_chart1 b).ι ≫ p_Q.left ∧
            q_0 ≫ (i_Wb b).hom =
              (j_0 b).hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) ∧
            q_1 ≫ (i_Wb b).hom =
              (j_1 b).hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C)) ∧
          (TopologicalSpace.Opens.map (U_chart0 b).ι.base).obj (U_chart1 b) =
            (TopologicalSpace.Opens.map (j_0 b).hom.base).obj
              (PrimeSpectrum.basicOpen (Polynomial.X : Polynomial (R_b b))) ∧
          (TopologicalSpace.Opens.map (U_chart1 b).ι.base).obj (U_chart0 b) =
            (TopologicalSpace.Opens.map (j_1 b).hom.base).obj
              (PrimeSpectrum.basicOpen (Polynomial.X : Polynomial (R_b b))) ∧
          AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom
                (algebraMap (Polynomial (R_b b))
                  (Localization.Away (Polynomial.X : Polynomial (R_b b))))) ≫
            (j_0 b).inv ≫ (U_chart0 b).ι =
          AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom
                (Polynomial.eval₂RingHom
                  ((algebraMap (Polynomial (R_b b))
                    (Localization.Away (Polynomial.X : Polynomial (R_b b)))).comp Polynomial.C)
                  (IsLocalization.Away.invSelf
                    (S := Localization.Away (Polynomial.X : Polynomial (R_b b)))
                    (Polynomial.X : Polynomial (R_b b))))) ≫
            (j_1 b).inv ≫ (U_chart1 b).ι) ∧
        (1 ≤ m →
          (∀ b : Fin (2 * m + 2), Nonempty ↥(W ⟨0, by omega⟩ ⊓ W b)) →
          ∀ b : Fin (2 * m + 2),
            Nonempty ↥(U_chart0 ⟨0, by omega⟩ ⊓ U_chart0 b) ∧
            Nonempty ↥(U_chart0 ⟨0, by omega⟩ ⊓ U_chart1 b)) :=
by
  classical
  intro Z_chart U_Z W _hZ0 hZ_cov p₀ σ_inf hp₀_D1 hσ_Db hp₀_hom hUZ_compl hσ_range hp₀_coord hσ_coord

  
  
  
  have hSpecHomEq : ∀ {R S : CommRingCat.{u}}
      (g₁ g₂ : AlgebraicGeometry.Spec S ⟶ AlgebraicGeometry.Spec R),
      g₁.appTop = g₂.appTop → g₁ = g₂ := by
    intro R S g₁ g₂ h_app
    have hpre : ∀ g : AlgebraicGeometry.Spec S ⟶ AlgebraicGeometry.Spec R,
        AlgebraicGeometry.Spec.preimage g =
          (AlgebraicGeometry.Scheme.ΓSpecIso R).inv ≫ g.appTop ≫
            (AlgebraicGeometry.Scheme.ΓSpecIso S).hom := by
      intro g
      have hnat := AlgebraicGeometry.Scheme.ΓSpecIso_naturality
        (AlgebraicGeometry.Spec.preimage g)
      rw [AlgebraicGeometry.Spec.map_preimage g] at hnat
      have h1 := congrArg ((AlgebraicGeometry.Scheme.ΓSpecIso R).inv ≫ ·) hnat
      simp only [CategoryTheory.Iso.inv_hom_id_assoc] at h1
      exact h1.symm
    rw [← AlgebraicGeometry.Spec.map_preimage g₁, ← AlgebraicGeometry.Spec.map_preimage g₂,
      hpre g₁, hpre g₂, h_app]

  have hFromSpecApp : ∀ {X : AlgebraicGeometry.Scheme.{u}} {U : X.Opens}
      (hAff : AlgebraicGeometry.IsAffineOpen U)
      (h_le : (⊤ : (AlgebraicGeometry.Spec (X.presheaf.obj (Opposite.op U))).Opens) ≤
        (TopologicalSpace.Opens.map hAff.fromSpec.base).obj U),
      hAff.fromSpec.appLE U ⊤ h_le =
        (AlgebraicGeometry.Scheme.ΓSpecIso (X.presheaf.obj (Opposite.op U))).inv := by
    intro X U hAff h_le
    have happ_map : hAff.fromSpec.app U ≫
        (AlgebraicGeometry.Spec (X.presheaf.obj (Opposite.op U))).presheaf.map
          (CategoryTheory.homOfLE h_le).op =
        hAff.fromSpec.appLE U ⊤ h_le := by
      rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE hAff.fromSpec (U := U),
        AlgebraicGeometry.Scheme.Hom.appLE_map]
    have h_map_id : ∀ (w : Opposite.op
            (⊤ : (AlgebraicGeometry.Spec (X.presheaf.obj (Opposite.op U))).Opens) ⟶
          Opposite.op ⊤),
        (AlgebraicGeometry.Spec (X.presheaf.obj (Opposite.op U))).presheaf.map w = 𝟙 _ := by
      intro w; rw [Subsingleton.elim w (𝟙 _), CategoryTheory.Functor.map_id]
    rw [← happ_map, hAff.fromSpec_app_self, CategoryTheory.Category.assoc,
      ← CategoryTheory.Functor.map_comp, h_map_id, CategoryTheory.Category.comp_id]

  have hFromSpecComp : ∀ {X : AlgebraicGeometry.Scheme.{u}}
      (f : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of K)) {U : X.Opens}
      (hAff : AlgebraicGeometry.IsAffineOpen U),
      hAff.fromSpec ≫ f =
        AlgebraicGeometry.Spec.map
          ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫
            f.appLE ⊤ U le_top) := by
    intro X f U hAff
    let K_c := CommRingCat.of K
    let φ_U := (AlgebraicGeometry.Scheme.ΓSpecIso K_c).inv ≫ f.appLE ⊤ U le_top
    have h_le : (⊤ : (AlgebraicGeometry.Spec (X.presheaf.obj (Opposite.op U))).Opens) ≤
        (TopologicalSpace.Opens.map hAff.fromSpec.base).obj U :=
      fun pt _ => (hAff.isoSpec.inv.base pt).2
    apply hSpecHomEq
    have hLHS : (hAff.fromSpec ≫ f).appTop =
        f.appLE ⊤ U le_top ≫
          (AlgebraicGeometry.Scheme.ΓSpecIso (X.presheaf.obj (Opposite.op U))).inv := by
      calc (hAff.fromSpec ≫ f).appTop
        _ = (hAff.fromSpec ≫ f).appLE ⊤ ⊤ le_top :=
            AlgebraicGeometry.Scheme.Hom.app_eq_appLE (hAff.fromSpec ≫ f) (U := ⊤)
        _ = f.appLE ⊤ U le_top ≫ hAff.fromSpec.appLE U ⊤ h_le :=
            (AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE hAff.fromSpec f ⊤ U ⊤ le_top h_le).symm
        _ = f.appLE ⊤ U le_top ≫
              (AlgebraicGeometry.Scheme.ΓSpecIso (X.presheaf.obj (Opposite.op U))).inv := by
            rw [hFromSpecApp hAff h_le]
    have hRHS : (AlgebraicGeometry.Spec.map φ_U).appTop =
        f.appLE ⊤ U le_top ≫
          (AlgebraicGeometry.Scheme.ΓSpecIso (X.presheaf.obj (Opposite.op U))).inv := by
      have hnat := AlgebraicGeometry.Scheme.ΓSpecIso_inv_naturality φ_U
      have h1 := congrArg ((AlgebraicGeometry.Scheme.ΓSpecIso K_c).hom ≫ ·) hnat.symm
      rw [← CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id,
        CategoryTheory.Category.id_comp] at h1
      have hφ : (AlgebraicGeometry.Scheme.ΓSpecIso K_c).hom ≫ φ_U = f.appLE ⊤ U le_top := by
        dsimp [φ_U]
        rw [← CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id,
          CategoryTheory.Category.id_comp]
      rwa [← CategoryTheory.Category.assoc, hφ] at h1
    exact hLHS.trans hRHS.symm

  
  
  
  have hSubscheme : ∀ (P : AlgebraicGeometry.Scheme.{u}) (ι κ : Type)
      (C : ι → P.Opens), (⨆ i : ι, C i) = ⊤ →
      ∀ (Φ : ∀ i : ι, κ → ↑(P.presheaf.obj (Opposite.op (C i)))),
      (∀ i j : ι,
        ∃ u : ↑(P.presheaf.obj (Opposite.op (C i ⊓ C j))),
          IsUnit u ∧
          ∀ k : κ,
            (P.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (Φ i k) =
              u * (P.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom (Φ j k)) →
      ∃ (Z_sch : AlgebraicGeometry.Scheme.{u}) (ι_Z : Z_sch ⟶ P),
        AlgebraicGeometry.IsClosedImmersion ι_Z ∧
        (∀ (i : ι), AlgebraicGeometry.IsAffineOpen (C i) →
          let V_i : Z_sch.Opens := (TopologicalSpace.Opens.map ι_Z.base).obj (C i)
          let J_i : Ideal ↑(P.presheaf.obj (Opposite.op (C i))) :=
            Ideal.span (Set.range (Φ i))
          AlgebraicGeometry.IsAffineOpen V_i ∧
          ∃ e_Vi : (↑(P.presheaf.obj (Opposite.op (C i))) ⧸ J_i) ≃+*
              ↑(Z_sch.presheaf.obj (Opposite.op V_i)),
            ∀ s : ↑(P.presheaf.obj (Opposite.op (C i))),
              (ι_Z.appLE (C i) V_i (le_refl _)).hom s = e_Vi (Ideal.Quotient.mk J_i s)) ∧
        (∀ (Y : AlgebraicGeometry.Scheme.{u}) (g : Y ⟶ P)
           [AlgebraicGeometry.QuasiCompact g] (ν : Type) (W_Y : ν → Y.Opens),
          (⨆ l : ν, W_Y l) = ⊤ →
          ∀ (idx : ν → ι)
            (hW_le : ∀ l : ν, W_Y l ≤ (TopologicalSpace.Opens.map g.base).obj (C (idx l))),
            (∀ (l : ν) (k : κ),
              (g.appLE (C (idx l)) (W_Y l) (hW_le l)).hom (Φ (idx l) k) = 0) →
            ∃ g_lift : Y ⟶ Z_sch, g_lift ≫ ι_Z = g) := by
    intro P ι κ C hCov Φ hCocycle
    have hResComp : ∀ {U₁ U₂ U₃ : P.Opens} (h₁₂ : U₂ ≤ U₁) (h₂₃ : U₃ ≤ U₂)
        (x : ↑(P.presheaf.obj (Opposite.op U₁))),
        (P.presheaf.map (CategoryTheory.homOfLE h₂₃).op).hom
          ((P.presheaf.map (CategoryTheory.homOfLE h₁₂).op).hom x) =
        (P.presheaf.map (CategoryTheory.homOfLE (h₂₃.trans h₁₂)).op).hom x := by
      intro U₁ U₂ U₃ h₁₂ h₂₃ x
      have hcomp : P.presheaf.map (CategoryTheory.homOfLE h₁₂).op ≫
          P.presheaf.map (CategoryTheory.homOfLE h₂₃).op =
          P.presheaf.map (CategoryTheory.homOfLE (h₂₃.trans h₁₂)).op := by
        rw [← CategoryTheory.Functor.map_comp, ← CategoryTheory.op_comp]; rfl
      exact congrArg
        (fun f : P.presheaf.obj (Opposite.op U₁) ⟶ P.presheaf.obj (Opposite.op U₃) => f.hom x) hcomp
    have hAwayClear : ∀ {R S : Type u} [CommRing R] [CommRing S] [Algebra R S]
        (f : R) [IsLocalization.Away f S] (b ϕ : R),
        algebraMap R S b ∈ Ideal.span {algebraMap R S ϕ} →
        ∃ d : ℕ, f ^ d * b ∈ Ideal.span {ϕ} := by
      intro R S _ _ _ f _ b ϕ hmem
      rw [Ideal.mem_span_singleton] at hmem
      obtain ⟨q, hq⟩ := hmem
      obtain ⟨m₁, c, hc⟩ := IsLocalization.Away.surj f q
      have heq : algebraMap R S (f ^ m₁ * b) = algebraMap R S (c * ϕ) := by
        calc algebraMap R S (f ^ m₁ * b)
          _ = (algebraMap R S f) ^ m₁ * algebraMap R S b := by rw [map_mul, map_pow]
          _ = (algebraMap R S f) ^ m₁ * (algebraMap R S ϕ * q) := by rw [hq]
          _ = (q * (algebraMap R S f) ^ m₁) * algebraMap R S ϕ := by ring
          _ = algebraMap R S c * algebraMap R S ϕ := by rw [hc]
          _ = algebraMap R S (c * ϕ) := (map_mul _ _ _).symm
      obtain ⟨⟨s, m₂, hm₂⟩, hs_eq⟩ := IsLocalization.exists_of_eq (M := Submonoid.powers f) heq
      dsimp at hm₂ hs_eq
      refine ⟨m₂ + m₁, Ideal.mem_span_singleton.mpr ⟨f ^ m₂ * c, ?_⟩⟩
      calc f ^ (m₂ + m₁) * b
        _ = f ^ m₂ * (f ^ m₁ * b) := by rw [pow_add, mul_assoc]
        _ = s * (f ^ m₁ * b) := by rw [hm₂]
        _ = s * (c * ϕ) := hs_eq
        _ = f ^ m₂ * (c * ϕ) := by rw [← hm₂]
        _ = ϕ * (f ^ m₂ * c) := by ring
    have hSingleEx : ∀ k : κ, ∃ I_k : P.IdealSheafData,
        ∀ (U : P.affineOpens) (i₀ : ι) (hU₀ : U.1 ≤ C i₀),
          I_k.ideal U =
            Ideal.span {(P.presheaf.map (CategoryTheory.homOfLE hU₀).op).hom (Φ i₀ k)} := by
      intro k
      let I : ∀ U : P.affineOpens, Ideal ↑(P.presheaf.obj (Opposite.op U.1)) :=
        fun U =>
          ⨅ (i : ι), ⨅ (W : P.affineOpens), ⨅ (hW : W.1 ≤ U.1 ⊓ C i),
            Ideal.comap
              ((P.presheaf.map (CategoryTheory.homOfLE (hW.trans inf_le_left)).op).hom)
              (Ideal.span
                {(P.presheaf.map (CategoryTheory.homOfLE (hW.trans inf_le_right)).op).hom (Φ i k)})
      have mem_I_iff : ∀ (U : P.affineOpens) (b : ↑(P.presheaf.obj (Opposite.op U.1))),
          b ∈ I U ↔
            ∀ (i : ι) (W : P.affineOpens) (hW : W.1 ≤ U.1 ⊓ C i),
              (P.presheaf.map (CategoryTheory.homOfLE (hW.trans inf_le_left)).op).hom b ∈
                Ideal.span
                  {(P.presheaf.map (CategoryTheory.homOfLE (hW.trans inf_le_right)).op).hom (Φ i k)} := by
        intro U b; simp only [I, Ideal.mem_iInf, Ideal.mem_comap]
      have hChart : ∀ (U : P.affineOpens) (i₀ : ι) (hU₀ : U.1 ≤ C i₀),
          I U = Ideal.span {(P.presheaf.map (CategoryTheory.homOfLE hU₀).op).hom (Φ i₀ k)} := by
        intro U i₀ hU₀
        apply le_antisymm
        · intro b hb
          have hb₀ := (mem_I_iff U b).mp hb i₀ U (le_inf (le_refl U.1) hU₀)
          have hid : P.presheaf.map (CategoryTheory.homOfLE (le_refl U.1)).op = 𝟙 _ := by
            rw [Subsingleton.elim (CategoryTheory.homOfLE (le_refl U.1)) (𝟙 U.1),
              CategoryTheory.op_id, CategoryTheory.Functor.map_id]
          simpa [hid] using hb₀
        · rw [Ideal.span_singleton_le_iff_mem, mem_I_iff]
          intro i W hW
          have hW_ov : W.1 ≤ C i₀ ⊓ C i :=
            le_inf ((hW.trans inf_le_left).trans hU₀) (hW.trans inf_le_right)
          obtain ⟨u, _, hu⟩ := hCocycle i₀ i
          rw [hResComp hU₀ (hW.trans inf_le_left) (Φ i₀ k)]
          have hLHS : (P.presheaf.map (CategoryTheory.homOfLE ((hW.trans inf_le_left).trans hU₀)).op).hom
              (Φ i₀ k) =
              (P.presheaf.map (CategoryTheory.homOfLE hW_ov).op).hom
                ((P.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (Φ i₀ k)) :=
            (hResComp inf_le_left hW_ov (Φ i₀ k)).symm
          rw [hLHS, hu k, map_mul, hResComp inf_le_right hW_ov (Φ i k)]
          exact Ideal.mul_mem_left _ _ (Ideal.subset_span rfl)
      have hPartition : ∀ (U : P.affineOpens),
          ∃ (n : ℕ) (g : Fin n → ↑(P.presheaf.obj (Opposite.op U.1)))
            (idx : Fin n → ι) (h_le : ∀ r : Fin n, P.basicOpen (g r) ≤ C (idx r)),
            Ideal.span (Set.range g) = ⊤ ∧
            ∀ b : ↑(P.presheaf.obj (Opposite.op U.1)),
              (∀ r : Fin n,
                (P.presheaf.map (CategoryTheory.homOfLE (P.basicOpen_le (g r))).op).hom b ∈
                  Ideal.span {(P.presheaf.map (CategoryTheory.homOfLE (h_le r)).op).hom (Φ (idx r) k)}) →
              b ∈ I U := by
        intro U
        let R := ↑(P.presheaf.obj (Opposite.op U.1))
        let S_U : Set R := { g : R | ∃ i : ι, P.basicOpen g ≤ C i }
        have hU_le : U.1 ≤ ⨆ g : S_U, P.basicOpen g.1 := by
          intro x hxU
          rw [TopologicalSpace.Opens.mem_iSup]
          have hx_top : x ∈ (⊤ : P.Opens) := trivial
          rw [← hCov, TopologicalSpace.Opens.mem_iSup] at hx_top
          obtain ⟨i, hxCi⟩ := hx_top
          obtain ⟨g, hg_le, hxg⟩ :=
            U.2.exists_basicOpen_le (V := U.1 ⊓ C i) ⟨x, hxU, hxCi⟩ hxU
          exact ⟨⟨g, i, hg_le.trans inf_le_right⟩, hxg⟩
        have hSpanSU : Ideal.span S_U = ⊤ := U.2.self_le_iSup_basicOpen_iff.mp hU_le
        have h1_mem : (1 : R) ∈ Ideal.span S_U := by rw [hSpanSU]; trivial
        obtain ⟨n, r_c, g_sub, hsum1⟩ := Submodule.mem_span_set'.mp h1_mem
        let g : Fin n → R := fun m₀ => (g_sub m₀).1
        let idx : Fin n → ι := fun m₀ => Classical.choose (g_sub m₀).2
        have h_le : ∀ m₀ : Fin n, P.basicOpen (g m₀) ≤ C (idx m₀) :=
          fun m₀ => Classical.choose_spec (g_sub m₀).2
        have hSpanG : Ideal.span (Set.range g) = ⊤ := by
          rw [Ideal.eq_top_iff_one, ← hsum1]
          refine Submodule.sum_mem _ fun m₀ _ => ?_
          change r_c m₀ * g m₀ ∈ Ideal.span (Set.range g)
          exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨m₀, rfl⟩)
        refine ⟨n, g, idx, h_le, hSpanG, fun b hb => ?_⟩
        rw [mem_I_iff]
        intro j W hW
        let A_W := ↑(P.presheaf.obj (Opposite.op W.1))
        let res_UW : R →+* A_W :=
          (P.presheaf.map (CategoryTheory.homOfLE (hW.trans inf_le_left)).op).hom
        let b_W : A_W := res_UW b
        let ϕ_W : A_W :=
          (P.presheaf.map (CategoryTheory.homOfLE (hW.trans inf_le_right)).op).hom (Φ j k)
        let h_W : Fin n → A_W := fun m₀ => res_UW (g m₀)
        have hSpanHW : Ideal.span (Set.range h_W) = ⊤ := by
          rw [Ideal.eq_top_iff_one]
          have h1W : (∑ m₀ : Fin n, res_UW (r_c m₀) * h_W m₀) = 1 := by
            calc ∑ m₀ : Fin n, res_UW (r_c m₀) * h_W m₀
              _ = res_UW (∑ m₀ : Fin n, r_c m₀ * g m₀) := by simp [h_W, map_sum, map_mul]
              _ = res_UW 1 := congrArg res_UW hsum1
              _ = 1 := map_one res_UW
          rw [← h1W]
          refine Submodule.sum_mem _ fun m₀ _ => ?_
          exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨m₀, rfl⟩)
        have hd_ex : ∀ m₀ : Fin n, ∃ d : ℕ, (h_W m₀) ^ d * b_W ∈ Ideal.span {ϕ_W} := by
          intro m₀
          let hm := h_W m₀
          have hBasic_hm : P.basicOpen hm = W.1 ⊓ P.basicOpen (g m₀) :=
            P.toRingedSpace.basicOpen_res (CategoryTheory.homOfLE (hW.trans inf_le_left)).op (g m₀)
          have h_le_gm : P.basicOpen hm ≤ P.basicOpen (g m₀) := hBasic_hm.le.trans inf_le_right
          have h_le_W : P.basicOpen hm ≤ W.1 := P.basicOpen_le hm
          have h_ov : P.basicOpen hm ≤ C (idx m₀) ⊓ C j :=
            le_inf (h_le_gm.trans (h_le m₀)) (h_le_W.trans (hW.trans inf_le_right))
          obtain ⟨u_mj, _, hu_mj⟩ := hCocycle (idx m₀) j
          let res_W_hm : A_W →+* ↑(P.presheaf.obj (Opposite.op (P.basicOpen hm))) :=
            (P.presheaf.map (CategoryTheory.homOfLE h_le_W).op).hom
          let _ : Algebra A_W ↑(P.presheaf.obj (Opposite.op (P.basicOpen hm))) := res_W_hm.toAlgebra
          have _ : IsLocalization.Away hm ↑(P.presheaf.obj (Opposite.op (P.basicOpen hm))) :=
            W.2.isLocalization_basicOpen hm
          apply hAwayClear (S := ↑(P.presheaf.obj (Opposite.op (P.basicOpen hm)))) hm b_W ϕ_W
          change res_W_hm b_W ∈ Ideal.span {res_W_hm ϕ_W}
          have hb_hm : res_W_hm b_W =
              (P.presheaf.map (CategoryTheory.homOfLE h_le_gm).op).hom
                ((P.presheaf.map (CategoryTheory.homOfLE (P.basicOpen_le (g m₀))).op).hom b) := by
            dsimp [res_W_hm, b_W, res_UW]; rw [hResComp, hResComp]
          have hbm_mem : (P.presheaf.map (CategoryTheory.homOfLE h_le_gm).op).hom
              ((P.presheaf.map (CategoryTheory.homOfLE (P.basicOpen_le (g m₀))).op).hom b) ∈
              Ideal.span {(P.presheaf.map (CategoryTheory.homOfLE (h_le_gm.trans (h_le m₀))).op).hom
                (Φ (idx m₀) k)} := by
            obtain ⟨q, hq⟩ := Ideal.mem_span_singleton.mp (hb m₀)
            refine Ideal.mem_span_singleton.mpr
              ⟨(P.presheaf.map (CategoryTheory.homOfLE h_le_gm).op).hom q, ?_⟩
            rw [hq, map_mul, hResComp]
          rw [hb_hm]
          have hsub_span : Ideal.span
              {(P.presheaf.map (CategoryTheory.homOfLE (h_le_gm.trans (h_le m₀))).op).hom
                (Φ (idx m₀) k)} ≤
              Ideal.span {res_W_hm ϕ_W} := by
            rw [Ideal.span_singleton_le_iff_mem]
            have hΦ_eq : (P.presheaf.map (CategoryTheory.homOfLE (h_le_gm.trans (h_le m₀))).op).hom
                (Φ (idx m₀) k) =
                (P.presheaf.map (CategoryTheory.homOfLE h_ov).op).hom
                  ((P.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (Φ (idx m₀) k)) :=
              (hResComp inf_le_left h_ov (Φ (idx m₀) k)).symm
            rw [hΦ_eq, hu_mj k, map_mul, hResComp inf_le_right h_ov (Φ j k)]
            have hϕ_eq : (P.presheaf.map (CategoryTheory.homOfLE (h_ov.trans inf_le_right)).op).hom
                (Φ j k) = res_W_hm ϕ_W := by
              dsimp [res_W_hm, ϕ_W]; rw [hResComp]
            rw [hϕ_eq]
            exact Ideal.mul_mem_left _ _ (Ideal.subset_span rfl)
          exact hsub_span hbm_mem
        let S_W : Set A_W := Set.range h_W
        have hd_SW : ∀ x : S_W, ∃ d : ℕ, (x : A_W) ^ d * b_W ∈ Ideal.span {ϕ_W} := by
          rintro ⟨x, m₀, rfl⟩; exact hd_ex m₀
        let d_fn : S_W → ℕ := fun x => Classical.choose (hd_SW x)
        have hPowTop : Ideal.span (Set.range fun x : S_W => (x : A_W) ^ d_fn x) = ⊤ :=
          Ideal.span_range_pow_eq_top S_W hSpanHW d_fn
        have h1_pow : (1 : A_W) ∈ Ideal.span (Set.range fun x : S_W => (x : A_W) ^ d_fn x) := by
          rw [hPowTop]; trivial
        have hMulMem : ∀ z ∈ Ideal.span (Set.range fun x : S_W => (x : A_W) ^ d_fn x),
            z * b_W ∈ Ideal.span {ϕ_W} := by
          intro z hz
          refine Submodule.span_induction ?_ ?_ ?_ ?_ hz
          · rintro _ ⟨x, rfl⟩; exact Classical.choose_spec (hd_SW x)
          · rw [zero_mul]; exact Ideal.zero_mem _
          · intro x₁ x₂ _ _ hx₁ hx₂; rw [add_mul]; exact Ideal.add_mem _ hx₁ hx₂
          · intro c x₁ _ hx₁
            change (c * x₁) * b_W ∈ Ideal.span {ϕ_W}
            rw [mul_assoc]; exact Ideal.mul_mem_left _ c hx₁
        simpa [one_mul] using hMulMem 1 h1_pow
      have hMapBasic : ∀ (U : P.affineOpens) (f : ↑(P.presheaf.obj (Opposite.op U.1))),
          Ideal.map ((P.presheaf.map (CategoryTheory.homOfLE (P.basicOpen_le f)).op).hom) (I U) =
            I (P.affineBasicOpen f) := by
        intro U f
        let R := ↑(P.presheaf.obj (Opposite.op U.1))
        let U_f : P.affineOpens := ⟨P.basicOpen f, U.2.basicOpen f⟩
        let ρ_f : R →+* ↑(P.presheaf.obj (Opposite.op U_f.1)) :=
          (P.presheaf.map (CategoryTheory.homOfLE (P.basicOpen_le f)).op).hom
        change Ideal.map ρ_f (I U) = I U_f
        apply le_antisymm
        · intro y hy
          refine Submodule.span_induction ?_ ?_ ?_ ?_ hy
          · rintro _ ⟨a, ha, rfl⟩
            rw [mem_I_iff]
            intro i W hW
            have hW' : W.1 ≤ U.1 ⊓ C i :=
              le_inf ((hW.trans inf_le_left).trans (P.basicOpen_le f)) (hW.trans inf_le_right)
            have ha' := (mem_I_iff U a).mp ha i W hW'
            dsimp [ρ_f]
            rwa [hResComp (P.basicOpen_le f) (hW.trans inf_le_left) a]
          · exact Ideal.zero_mem _
          · intro x₁ x₂ _ _ hx₁ hx₂; exact Ideal.add_mem _ hx₁ hx₂
          · intro c x₁ _ hx₁; exact Ideal.mul_mem_left _ c hx₁
        · intro y hy
          let _ : Algebra R ↑(P.presheaf.obj (Opposite.op (P.basicOpen f))) := ρ_f.toAlgebra
          have _ : IsLocalization.Away f ↑(P.presheaf.obj (Opposite.op (P.basicOpen f))) :=
            U.2.isLocalization_basicOpen f
          obtain ⟨n₀, a, ha_eq⟩ := IsLocalization.Away.surj f y
          have hρa_mem : ρ_f a ∈ I U_f := by
            change algebraMap R ↑(P.presheaf.obj (Opposite.op (P.basicOpen f))) a ∈ I U_f
            rw [← ha_eq, mul_comm]
            exact Ideal.mul_mem_left _ _ hy
          obtain ⟨n, g, idx, h_le, _, hCrit⟩ := hPartition U
          have hm_ex : ∀ m₀ : Fin n, ∃ e : ℕ,
              (P.presheaf.map (CategoryTheory.homOfLE (P.basicOpen_le (g m₀))).op).hom (f ^ e * a) ∈
                Ideal.span {(P.presheaf.map (CategoryTheory.homOfLE (h_le m₀)).op).hom
                  (Φ (idx m₀) k)} := by
            intro m₀
            let W_m : P.affineOpens := ⟨P.basicOpen (g m₀), U.2.basicOpen (g m₀)⟩
            let res_m : R →+* ↑(P.presheaf.obj (Opposite.op (P.basicOpen (g m₀)))) :=
              (P.presheaf.map (CategoryTheory.homOfLE (P.basicOpen_le (g m₀))).op).hom
            let f_m := res_m f
            let W_mf : P.affineOpens := ⟨P.basicOpen f_m, W_m.2.basicOpen f_m⟩
            have hBasic_fm : W_mf.1 = P.basicOpen (g m₀) ⊓ P.basicOpen f :=
              P.toRingedSpace.basicOpen_res (CategoryTheory.homOfLE (P.basicOpen_le (g m₀))).op f
            have hW_mf_le : W_mf.1 ≤ U_f.1 ⊓ C (idx m₀) :=
              le_inf (hBasic_fm.le.trans inf_le_right)
                ((hBasic_fm.le.trans inf_le_left).trans (h_le m₀))
            have hmem_mf := (mem_I_iff U_f (ρ_f a)).mp hρa_mem (idx m₀) W_mf hW_mf_le
            let res_Wm_Wmf : ↑(P.presheaf.obj (Opposite.op (P.basicOpen (g m₀)))) →+*
                ↑(P.presheaf.obj (Opposite.op (P.basicOpen f_m))) :=
              (P.presheaf.map (CategoryTheory.homOfLE (P.basicOpen_le f_m)).op).hom
            let _ : Algebra ↑(P.presheaf.obj (Opposite.op (P.basicOpen (g m₀))))
                ↑(P.presheaf.obj (Opposite.op (P.basicOpen f_m))) := res_Wm_Wmf.toAlgebra
            have _ : IsLocalization.Away f_m ↑(P.presheaf.obj (Opposite.op (P.basicOpen f_m))) :=
              W_m.2.isLocalization_basicOpen f_m
            have hmem_loc : res_Wm_Wmf (res_m a) ∈
                Ideal.span {res_Wm_Wmf ((P.presheaf.map (CategoryTheory.homOfLE (h_le m₀)).op).hom
                  (Φ (idx m₀) k))} := by
              have hLHS_mf : res_Wm_Wmf (res_m a) =
                  (P.presheaf.map (CategoryTheory.homOfLE (hW_mf_le.trans inf_le_left)).op).hom
                    (ρ_f a) := by
                dsimp [res_Wm_Wmf, res_m, ρ_f]
                rw [hResComp (P.basicOpen_le (g m₀)) (P.basicOpen_le f_m) a,
                  hResComp (P.basicOpen_le f) (hW_mf_le.trans inf_le_left) a]
              have hRHS_mf : res_Wm_Wmf ((P.presheaf.map (CategoryTheory.homOfLE (h_le m₀)).op).hom
                  (Φ (idx m₀) k)) =
                  (P.presheaf.map (CategoryTheory.homOfLE (hW_mf_le.trans inf_le_right)).op).hom
                    (Φ (idx m₀) k) := by
                dsimp [res_Wm_Wmf]
                rw [hResComp (h_le m₀) (P.basicOpen_le f_m) (Φ (idx m₀) k)]
              rw [hLHS_mf, hRHS_mf]
              exact hmem_mf
            obtain ⟨e, he⟩ := hAwayClear
              (S := ↑(P.presheaf.obj (Opposite.op (P.basicOpen f_m)))) f_m (res_m a)
              ((P.presheaf.map (CategoryTheory.homOfLE (h_le m₀)).op).hom (Φ (idx m₀) k)) hmem_loc
            refine ⟨e, ?_⟩
            simpa [res_m, f_m, map_mul, map_pow] using he
          let e_fn : Fin n → ℕ := fun m₀ => Classical.choose (hm_ex m₀)
          let M₀ : ℕ := Finset.univ.sup e_fn
          have hfMa_mem : f ^ M₀ * a ∈ I U := by
            apply hCrit
            intro m₀
            have hle_m : e_fn m₀ ≤ M₀ := Finset.le_sup (Finset.mem_univ m₀)
            have hpow_split : f ^ M₀ * a = f ^ (M₀ - e_fn m₀) * (f ^ e_fn m₀ * a) := by
              rw [← mul_assoc, ← pow_add, Nat.sub_add_cancel hle_m]
            rw [hpow_split, map_mul]
            exact Ideal.mul_mem_left _ _ (Classical.choose_spec (hm_ex m₀))
          have hmap_mem : ρ_f (f ^ M₀ * a) ∈ Ideal.map ρ_f (I U) :=
            Ideal.mem_map_of_mem ρ_f hfMa_mem
          have hρf_eq : ρ_f (f ^ M₀ * a) = (ρ_f f) ^ (M₀ + n₀) * y := by
            change algebraMap R ↑(P.presheaf.obj (Opposite.op (P.basicOpen f))) (f ^ M₀ * a) =
              (algebraMap R ↑(P.presheaf.obj (Opposite.op (P.basicOpen f))) f) ^ (M₀ + n₀) * y
            rw [map_mul, map_pow, ← ha_eq, pow_add]; ring
          rw [hρf_eq] at hmap_mem
          have hu_f : IsUnit ((ρ_f f) ^ (M₀ + n₀)) :=
            (IsLocalization.Away.algebraMap_isUnit f).pow (M₀ + n₀)
          obtain ⟨v_f, hv_f⟩ := isUnit_iff_exists_inv'.mp hu_f
          have hy_eq : y = v_f * ((ρ_f f) ^ (M₀ + n₀) * y) := by
            rw [← mul_assoc, hv_f, one_mul]
          rw [hy_eq]
          exact Ideal.mul_mem_left _ _ hmap_mem
      refine ⟨{ ideal := I
                map_ideal_basicOpen := hMapBasic
                supportSet := ⋂ U, P.zeroLocus (I U : Set ↑(P.presheaf.obj (Opposite.op U.1)))
