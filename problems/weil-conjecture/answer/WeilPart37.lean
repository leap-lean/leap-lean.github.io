    intro m₀
    induction m₀ with
    | zero =>
      intro Q _ _ ι hι hSplit₀
      obtain ⟨hDim0, _⟩ := weil_split_quad_dim_zero_and_p1_chart_decomp K
      obtain ⟨U₀, U₁, hInf, hSup, hIso₀, hIso₁⟩ := hDim0 Q ι hι hSplit₀
      let _ : CategoryTheory.IsIso (U₀.ι ≫ Q.hom) := hIso₀
      let _ : CategoryTheory.IsIso (U₁.ι ≫ Q.hom) := hIso₁
      exact hClopenPkg Q
        (CategoryTheory.Over.mk (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of K)))) (2 * 0)
        U₀ U₁ hInf hSup
        (CategoryTheory.asIso (U₀.ι ≫ Q.hom)) (CategoryTheory.Category.comp_id (U₀.ι ≫ Q.hom))
        (CategoryTheory.asIso (U₁.ι ≫ Q.hom)) (CategoryTheory.Category.comp_id (U₁.ι ≫ Q.hom))
        hSpecK_odd hSpecK_even
    | succ m₀ ih =>
      intro Q_succ _ _ ι_succ hι_succ hSplit_succ
      obtain ⟨hGeom_Qsucc, O_succ, e_O, Z_cone, hProp_Zcone, i_Z,
          Q_m, hProp_Qm, hSm_Qm, hGeom_Qm, ι_m,
          p₀, U_Z, Z_tilde, hProp_Ztilde, hSm_Ztilde, hGeom_Ztilde,
          π_Z, hProp_πZ, hSurj_πZ, p_Q, hProp_pQ, i₀, i_inf, V_plus, s_inf_V, W,
          ⟨he_O, hiZ_cl, hO_compl⟩,
          ⟨hι_m, hSplit_m⟩,
          ⟨hp₀_sec, hUZ_compl, hIso_πZ⟩,
          ⟨hi₀_pQ, hi_inf_pQ, hi₀_cl, hV_compl, hPb_i₀, hs_inf_V⟩,
          ⟨hW_cov, hW_triv⟩,
          hW_m0⟩ :=
        weil_split_quad_cone_blowup_p1_bundle_step K m₀ Q_succ ι_succ hι_succ hSplit_succ
      let _ : AlgebraicGeometry.GeometricallyIrreducible Q_succ.hom := hGeom_Qsucc
      let _ : AlgebraicGeometry.IsProper Z_cone.hom := hProp_Zcone
      let _ : AlgebraicGeometry.IsProper Q_m.hom := hProp_Qm
      let _ : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m₀) Q_m.hom := hSm_Qm
      let _ : AlgebraicGeometry.IsProper Z_tilde.hom := hProp_Ztilde
      let _ : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m₀ + 1) Z_tilde.hom := hSm_Ztilde
      let _ : AlgebraicGeometry.IsProper π_Z.left := hProp_πZ
      let _ : AlgebraicGeometry.Surjective π_Z.left := hSurj_πZ
      let _ : AlgebraicGeometry.IsProper p_Q.left := hProp_pQ

      
      have hZtilde_pkg :
