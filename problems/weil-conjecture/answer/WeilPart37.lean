      · exact ⟨1, (AlgebraicGeometry.Proj.mem_basicOpen 𝒜₁ (MvPolynomial.X 1) x).mpr h1⟩
    rcases hμ with ⟨μ, hxμ⟩
    have hAff_Dμ : AlgebraicGeometry.IsAffineOpen (D_proj μ) :=
      AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜₁ (MvPolynomial.X μ) (hX μ) zero_lt_one
    have h_le_top : D_proj μ ≤ (TopologicalSpace.Opens.map P1_hom.base).obj ⊤ :=
      fun _ _ => trivial
    refine ⟨⊤, isAffineOpen_top S_K, D_proj μ, hAff_Dμ, hxμ, h_le_top, ?_⟩
    let isoAway := AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜₁ (MvPolynomial.X μ) (hX μ) zero_lt_one
    have hAwayHom : AlgebraicGeometry.Proj.awayToSection 𝒜₁ (MvPolynomial.X μ) = isoAway.hom :=
      (AlgebraicGeometry.Proj.basicOpenIsoAway_hom 𝒜₁ (MvPolynomial.X μ) (hX μ) zero_lt_one).symm
    have hLHS :
        (D_proj μ).toSpecΓ ≫
          AlgebraicGeometry.Spec.map
            ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫
              P1_hom.appLE ⊤ (D_proj μ) h_le_top) =
        (D_proj μ).ι ≫ P1_hom := by
      have htop_inv :
          (⊤ : S_K.Opens).toSpecΓ ≫
            AlgebraicGeometry.Spec.map
              (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).inv =
          (⊤ : S_K.Opens).ι := by
        rw [AlgebraicGeometry.Scheme.Opens.toSpecΓ_top,
          ← AlgebraicGeometry.SpecMap_ΓSpecIso_hom (CommRingCat.of K),
          CategoryTheory.Category.assoc,
          ← AlgebraicGeometry.Spec.map_comp,
          CategoryTheory.Iso.inv_hom_id,
          AlgebraicGeometry.Spec.map_id,
          CategoryTheory.Category.comp_id]
      rw [AlgebraicGeometry.Spec.map_comp, ← CategoryTheory.Category.assoc,
        AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_appLE P1_hom ⊤ (D_proj μ) h_le_top,
        CategoryTheory.Category.assoc, htop_inv]
      simp
    have hRHS :
        (D_proj μ).toSpecΓ ≫
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (MvPolynomial.C : K →+* MvPolynomial (Fin 1) K) ≫
              (e_away μ).toCommRingCatIso.hom ≫ isoAway.hom) =
        (D_proj μ).ι ≫ P1_hom := by
      have hSpecIso :
          (D_proj μ).toSpecΓ ≫ AlgebraicGeometry.Spec.map isoAway.hom =
            (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜₁ (MvPolynomial.X μ)
              (hX μ) zero_lt_one).hom := by
        rw [← hAwayHom]
        exact (AlgebraicGeometry.Proj.basicOpenIsoSpec_hom 𝒜₁ (MvPolynomial.X μ)
          (hX μ) zero_lt_one).symm
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp,
        ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc, hSpecIso]
      change (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜₁ (MvPolynomial.X μ)
          (hX μ) zero_lt_one).hom ≫ (spec_e μ).hom ≫ A1_hom = (D_proj μ).ι ≫ P1_hom
      rw [← CategoryTheory.Category.assoc]
      exact he_chart_hom μ
    have _ : CategoryTheory.IsIso (D_proj μ).toSpecΓ := by
      rw [← hAff_Dμ.isoSpec_hom]
      infer_instance
    have hSpecEq := (cancel_epi (D_proj μ).toSpecΓ).mp (hLHS.trans hRHS.symm)
    have hMorEq := AlgebraicGeometry.Spec.map_injective hSpecEq
    have happ_eq :
        P1_hom.appLE ⊤ (D_proj μ) h_le_top =
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).hom ≫
            CommRingCat.ofHom (MvPolynomial.C : K →+* MvPolynomial (Fin 1) K) ≫
              ((e_away μ).toCommRingCatIso ≪≫ isoAway).hom := by
      have h1 := congrArg
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).hom ≫ ·) hMorEq
      rw [CategoryTheory.Iso.hom_inv_id_assoc] at h1
      rw [h1, CategoryTheory.Iso.trans_hom]
    have hSmC : RingHom.IsStandardSmoothOfRelativeDimension 1
        (MvPolynomial.C : K →+* MvPolynomial (Fin 1) K) := by
      unfold RingHom.IsStandardSmoothOfRelativeDimension
      have halg : (MvPolynomial.C : K →+* MvPolynomial (Fin 1) K).toAlgebra =
          (inferInstance : Algebra K (MvPolynomial (Fin 1) K)) :=
        Algebra.algebra_ext _ _ fun _ => rfl
      rw [halg]
      have hMV : Algebra.IsStandardSmoothOfRelativeDimension (Nat.card (Fin 1)) K
          (MvPolynomial (Fin 1) K) :=
        Algebra.IsStandardSmoothOfRelativeDimension.mvPolynomial K (Fin 1)
      rwa [Nat.card_fin] at hMV
    let e_src := (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).commRingCatIsoToRingEquiv
    let e_tgt := ((e_away μ).toCommRingCatIso ≪≫ isoAway).commRingCatIsoToRingEquiv
    have hSm1 := (@RingHom.isStandardSmoothOfRelativeDimension_respectsIso 1).1
      (MvPolynomial.C : K →+* MvPolynomial (Fin 1) K) e_tgt hSmC
    have hSm2 := (@RingHom.isStandardSmoothOfRelativeDimension_respectsIso 1).2
      (e_tgt.toRingHom.comp (MvPolynomial.C : K →+* MvPolynomial (Fin 1) K)) e_src hSm1
    have hEqHom : (P1_hom.appLE ⊤ (D_proj μ) h_le_top).hom =
        (e_tgt.toRingHom.comp (MvPolynomial.C : K →+* MvPolynomial (Fin 1) K)).comp
          e_src.toRingHom := by
      rw [happ_eq]
      rfl
    rw [hEqHom]
    exact hSm2

  · 
    change ∃ (i₀_P1 : S_K ⟶ P1_sch) (V_P1 : P1_sch.Opens)
        (s_inf_P1 : S_K ⟶ V_P1.toScheme) (e_VP1 : V_P1.toScheme ≅ A1_sch),
        i₀_P1 ≫ P1_hom = 𝟙 S_K ∧
        AlgebraicGeometry.IsClosedImmersion i₀_P1 ∧
        (V_P1 : Set P1_sch) = (Set.range i₀_P1.base)ᶜ ∧
        s_inf_P1 ≫ V_P1.ι ≫ P1_hom = 𝟙 S_K ∧
        e_VP1.hom ≫ A1_hom = V_P1.ι ≫ P1_hom
    let σ₀ : S_K ⟶ A1_sch := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev₀)
    have hσ₀_sec : σ₀ ≫ A1_hom = 𝟙 S_K := by
      dsimp [σ₀, A1_hom]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      have hid : ev₀.comp MvPolynomial.C = RingHom.id K := by
        ext c
        simp [ev₀]
      rw [hid, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
    let i₀_P1 : S_K ⟶ P1_sch := σ₀ ≫ (e_chart 0).inv ≫ (D_proj 0).ι
    let V_P1 : P1_sch.Opens := D_proj 1
    let e_VP1 : V_P1.toScheme ≅ A1_sch := e_chart 1
    let s_inf_P1 : S_K ⟶ V_P1.toScheme := σ₀ ≫ e_VP1.inv
    have hi₀_sec : i₀_P1 ≫ P1_hom = 𝟙 S_K := by
      dsimp [i₀_P1]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, he_chart_inv 0, hσ₀_sec]
    have hi₀_cl : AlgebraicGeometry.IsClosedImmersion i₀_P1 := by
      have _ : AlgebraicGeometry.IsProper P1_hom := hProp_P1
      have _ : AlgebraicGeometry.IsSeparated P1_hom := AlgebraicGeometry.IsProper.toIsSeparated
      have _ : AlgebraicGeometry.IsClosedImmersion (i₀_P1 ≫ P1_hom) := by
        rw [hi₀_sec]
        infer_instance
      exact AlgebraicGeometry.IsClosedImmersion.of_comp i₀_P1 P1_hom
    refine ⟨i₀_P1, V_P1, s_inf_P1, e_VP1, hi₀_sec, hi₀_cl, ?_, ?_, he_chart_hom 1⟩
    · let j0 : AlgebraicGeometry.Spec (CommRingCat.of
          (HomogeneousLocalization.Away 𝒜₁ (MvPolynomial.X 0))) ⟶ P1_sch :=
        AlgebraicGeometry.Proj.awayι 𝒜₁ (MvPolynomial.X 0) (hX 0) zero_lt_one
      have hi₀_j0 : i₀_P1 =
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (ev₀.comp (e_away 0).symm.toRingHom)) ≫ j0 := by
        dsimp [i₀_P1, σ₀, e_chart, spec_e, j0]
        rw [CategoryTheory.Category.assoc,
          AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι,
          ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp]
        rfl
      let pt_K : ↥S_K := (⊥ : PrimeSpectrum K)
      let q0 : PrimeSpectrum (HomogeneousLocalization.Away 𝒜₁ (MvPolynomial.X 0)) :=
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (ev₀.comp (e_away 0).symm.toRingHom))).base pt_K
      let t0 := HomogeneousLocalization.Away.isLocalizationElem (hX 0) (hX 1)
      have ht0_eq : e_away 0 (MvPolynomial.X 0) = t0 := (he_away 0).2.1
      have hq0_ideal : q0.asIdeal = Ideal.span {t0} := by
        ext a
        change (ev₀.comp (e_away 0).symm.toRingHom) a = 0 ↔ a ∈ Ideal.span {t0}
        have hker_mem : ev₀ ((e_away 0).symm a) = 0 ↔
            (e_away 0).symm a ∈ Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 1) K)} := by
          rw [← hKer_ev₀]
          rfl
        rw [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe,
          hker_mem, Ideal.mem_span_singleton, Ideal.mem_span_singleton]
        refine ⟨?_, ?_⟩
        · rintro ⟨b, hb⟩
          refine ⟨e_away 0 b, ?_⟩
          have happ := congrArg (e_away 0) hb
          rw [(e_away 0).apply_symm_apply, map_mul, ht0_eq] at happ
          exact happ
        · rintro ⟨b, rfl⟩
          refine ⟨(e_away 0).symm b, ?_⟩
          rw [map_mul, ← ht0_eq, (e_away 0).symm_apply_apply]
      have hq0_max : q0.asIdeal.IsMaximal := by
        rw [Ideal.isMaximal_iff]
        refine ⟨?_, ?_⟩
        · intro h1
          rw [hq0_ideal, Ideal.mem_span_singleton] at h1
          rcases h1 with ⟨b, hb⟩
          have hb' := congrArg (e_away 0).symm hb
          rw [map_one, map_mul, ← ht0_eq, (e_away 0).symm_apply_apply] at hb'
          exact (Ideal.isMaximal_iff.mp hMax_X0).1 (Ideal.mem_span_singleton.mpr ⟨_, hb'⟩)
        · intro J a hqJ haq0 haJ
          let J' : Ideal (MvPolynomial (Fin 1) K) := Ideal.comap (e_away 0).toRingHom J
          have hsub' : Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 1) K)} ≤ J' := by
            rw [Ideal.span_le, Set.singleton_subset_iff]
            change e_away 0 (MvPolynomial.X 0) ∈ J
            rw [ht0_eq]
            exact hqJ (hq0_ideal ▸ Ideal.subset_span rfl)
          have ha' : (e_away 0).symm a ∉
              Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 1) K)} := by
            intro hmem
            apply haq0
            rw [hq0_ideal, Ideal.mem_span_singleton]
            rcases Ideal.mem_span_singleton.mp hmem with ⟨c, hc⟩
            refine ⟨e_away 0 c, ?_⟩
            have happ := congrArg (e_away 0) hc
            rw [(e_away 0).apply_symm_apply, map_mul, ht0_eq] at happ
            exact happ
          have haJ' : (e_away 0).symm a ∈ J' := by
            change e_away 0 ((e_away 0).symm a) ∈ J
            rwa [(e_away 0).apply_symm_apply]
          have h1' : (1 : MvPolynomial (Fin 1) K) ∈ J' :=
            (Ideal.isMaximal_iff.mp hMax_X0).2 J' ((e_away 0).symm a) hsub' ha' haJ'
          simpa [J'] using h1'
      have hpre := AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜₁
        (hX 0) zero_lt_one (hX 1) zero_lt_one
      have hrange_j0 := AlgebraicGeometry.Proj.opensRange_awayι 𝒜₁
        (MvPolynomial.X 0) (hX 0) zero_lt_one
      ext p
      change p ∈ D_proj 1 ↔ p ∉ Set.range i₀_P1.base
      refine ⟨?_, ?_⟩
      · intro hp_D1 ⟨z, hz⟩
        have hz_eq : z = pt_K := hPt_uniq z pt_K
        subst hz_eq
        rw [hi₀_j0] at hz
        have hq0_j0 : j0.base q0 = p := hz
        have hq0_mem : q0 ∈ (TopologicalSpace.Opens.map j0.base).obj (D_proj 1) := by
          change j0.base q0 ∈ D_proj 1
          rwa [hq0_j0]
        dsimp [D_proj] at hq0_mem
        rw [hpre] at hq0_mem
        have ht0_not : t0 ∉ q0.asIdeal := hq0_mem
        exact ht0_not (hq0_ideal ▸ Ideal.subset_span rfl)
      · intro hp_not_range
        by_contra hp_not_D1
        have hp_X1 : (MvPolynomial.X 1 : MvPolynomial (Fin 2) K) ∈ p.asHomogeneousIdeal := by
          by_contra hX1_not
          exact hp_not_D1 ((AlgebraicGeometry.Proj.mem_basicOpen 𝒜₁ (MvPolynomial.X 1) p).mpr hX1_not)
        have hp_X0 : (MvPolynomial.X 0 : MvPolynomial (Fin 2) K) ∉ p.asHomogeneousIdeal := by
          rcases hCov p with h0 | h1
          · exact h0
          · exact False.elim (h1 hp_X1)
        have hp_D0 : p ∈ j0.opensRange := by
          rw [hrange_j0]
          exact (AlgebraicGeometry.Proj.mem_basicOpen 𝒜₁ (MvPolynomial.X 0) p).mpr hp_X0
        rcases hp_D0 with ⟨q, rfl⟩
        have hq_not_pre : q ∉ (TopologicalSpace.Opens.map j0.base).obj (D_proj 1) := hp_not_D1
        dsimp [D_proj] at hq_not_pre
        rw [hpre] at hq_not_pre
        have ht0_in_q : t0 ∈ (q : PrimeSpectrum _).asIdeal := by
          by_contra ht0_out
          exact hq_not_pre ht0_out
        have hle_ideals : q0.asIdeal ≤ (q : PrimeSpectrum _).asIdeal := by
          rw [hq0_ideal, Ideal.span_le, Set.singleton_subset_iff]
          exact ht0_in_q
        have heq_ideals : q0.asIdeal = (q : PrimeSpectrum _).asIdeal :=
          hq0_max.eq_of_le (q : PrimeSpectrum _).isPrime.ne_top hle_ideals
        have hqq0 : (q : PrimeSpectrum _) = q0 := PrimeSpectrum.ext heq_ideals.symm
        apply hp_not_range
        refine ⟨pt_K, ?_⟩
        rw [hi₀_j0]
        change j0.base q0 = j0.base q
        exact congrArg j0.base hqq0.symm
    · dsimp [s_inf_P1, V_P1, e_VP1]
      rw [CategoryTheory.Category.assoc, he_chart_inv 1, hσ₀_sec]

theorem weil_split_quad_hypersurface_pullback_and_cone_vertex (K : Type u) [Field K] :
    (∀ (M₀ d₀ : ℕ), 1 ≤ d₀ →
      ∀ (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
        (ι_X : X ⟶ weilProjectiveSpaceOver K M₀)
        (F : MvPolynomial (Fin (M₀ + 1)) K),
        F ∈ MvPolynomial.homogeneousSubmodule (Fin (M₀ + 1)) K (d₀ • 1) →
        ∃ (H : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
          (ι_H : H ⟶ X),
          IsHomogeneousHypersurfacePullbackOver K M₀ d₀ ι_X F ι_H.left) ∧
    (∀ (m : ℕ)
      (Q_succ Z_cone Q_m : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
      (ι_succ : Q_succ.left ⟶ (weilProjectiveSpaceOver K (2 * (m + 1) + 1)).left)
      (hι_succ : ι_succ ≫ (weilProjectiveSpaceOver K (2 * (m + 1) + 1)).hom = Q_succ.hom)
      (i_Z : Z_cone ⟶ Q_succ)
      (ι_m : Q_m.left ⟶ (weilProjectiveSpaceOver K (2 * m + 1)).left),
      ι_m ≫ (weilProjectiveSpaceOver K (2 * m + 1)).hom = Q_m.hom →
      IsHomogeneousHypersurfacePullbackOver K (2 * (m + 1) + 1) 2
        (𝟙 (weilProjectiveSpaceOver K (2 * (m + 1) + 1)))
        (∑ j ∈ Finset.range (m + 1 + 1),
          if h : 2 * j + 1 < 2 * (m + 1) + 1 + 1 then
            (MvPolynomial.X ⟨2 * j, Nat.lt_of_succ_lt h⟩ :
              MvPolynomial (Fin (2 * (m + 1) + 1 + 1)) K) *
              MvPolynomial.X ⟨2 * j + 1, h⟩
          else 0)
        ι_succ →
      IsHomogeneousHypersurfacePullbackOver K (2 * (m + 1) + 1) 1
        (CategoryTheory.Over.homMk ι_succ hι_succ)
        (MvPolynomial.X 0)
        i_Z.left →
      IsHomogeneousHypersurfacePullbackOver K (2 * m + 1) 2
        (𝟙 (weilProjectiveSpaceOver K (2 * m + 1)))
        (∑ j ∈ Finset.range (m + 1),
          if h : 2 * j + 1 < 2 * m + 1 + 1 then
            (MvPolynomial.X ⟨2 * j, Nat.lt_of_succ_lt h⟩ :
              MvPolynomial (Fin (2 * m + 1 + 1)) K) *
              MvPolynomial.X ⟨2 * j + 1, h⟩
          else 0)
        ι_m →
      let Z_chart : Fin (2 * (m + 1) + 2) → Z_cone.left.Opens :=
        fun μ => (TopologicalSpace.Opens.map (i_Z.left ≫ ι_succ).base).obj
          (weilProjBasicOpen K (2 * (m + 1) + 1) μ)
      let U_Z : Z_cone.left.Opens := ⨆ c : Fin (2 * m + 2), Z_chart c.succ.succ
      let W : Fin (2 * m + 2) → Q_m.left.Opens :=
        fun b => (TopologicalSpace.Opens.map ι_m.base).obj (weilProjBasicOpen K (2 * m + 1) b)
      Z_chart 0 = ⊥ ∧
      Z_chart 1 ⊔ U_Z = ⊤ ∧
      ∃ (p₀ : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ Z_cone.left)
        (σ_inf : Q_m ⟶ Z_cone)
        (hp₀_D1 : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of K)).Opens) ≤
          (TopologicalSpace.Opens.map (p₀ ≫ i_Z.left ≫ ι_succ).base).obj
            (weilProjBasicOpen K (2 * (m + 1) + 1) 1))
        (hσ_Db : ∀ b : Fin (2 * m + 2),
          W b ≤ (TopologicalSpace.Opens.map (σ_inf.left ≫ i_Z.left ≫ ι_succ).base).obj
            (weilProjBasicOpen K (2 * (m + 1) + 1) b.succ.succ)),
        p₀ ≫ Z_cone.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of K)) ∧
        (U_Z : Set Z_cone.left) = (Set.range p₀.base)ᶜ ∧
        Set.range σ_inf.left.base ⊆ (U_Z : Set Z_cone.left) ∧
        (∀ a : Fin (2 * m + 2),
          (letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (2 * (m + 1) + 2)) K) :=
            MvPolynomial.gradedAlgebra
           ((p₀ ≫ i_Z.left ≫ ι_succ).appLE
             (weilProjBasicOpen K (2 * (m + 1) + 1) 1) ⊤ hp₀_D1).hom
             ((AlgebraicGeometry.Proj.awayToSection
               (MvPolynomial.homogeneousSubmodule (Fin (2 * (m + 1) + 2)) K)
               (MvPolynomial.X 1)).hom
               (HomogeneousLocalization.Away.mk
                 (MvPolynomial.homogeneousSubmodule (Fin (2 * (m + 1) + 2)) K)
                 (MvPolynomial.isHomogeneous_X K 1) 1
                 (MvPolynomial.X a.succ.succ)
                 (MvPolynomial.isHomogeneous_X K a.succ.succ)))) = 0) ∧
        (∀ b a : Fin (2 * m + 2),
          (letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (2 * (m + 1) + 2)) K) :=
            MvPolynomial.gradedAlgebra
           letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (2 * m + 2)) K) :=
            MvPolynomial.gradedAlgebra
           ((σ_inf.left ≫ i_Z.left ≫ ι_succ).appLE
             (weilProjBasicOpen K (2 * (m + 1) + 1) b.succ.succ) (W b) (hσ_Db b)).hom
             ((AlgebraicGeometry.Proj.awayToSection
               (MvPolynomial.homogeneousSubmodule (Fin (2 * (m + 1) + 2)) K)
               (MvPolynomial.X b.succ.succ)).hom
               (HomogeneousLocalization.Away.mk
                 (MvPolynomial.homogeneousSubmodule (Fin (2 * (m + 1) + 2)) K)
                 (MvPolynomial.isHomogeneous_X K b.succ.succ) 1
                 (MvPolynomial.X a.succ.succ)
                 (MvPolynomial.isHomogeneous_X K a.succ.succ))) =
           (ι_m.appLE (weilProjBasicOpen K (2 * m + 1) b) (W b) (le_refl _)).hom
             ((AlgebraicGeometry.Proj.awayToSection
               (MvPolynomial.homogeneousSubmodule (Fin (2 * m + 2)) K)
               (MvPolynomial.X b)).hom
               (HomogeneousLocalization.Away.mk
                 (MvPolynomial.homogeneousSubmodule (Fin (2 * m + 2)) K)
                 (MvPolynomial.isHomogeneous_X K b) 1
                 (MvPolynomial.X a)
                 (MvPolynomial.isHomogeneous_X K a)))))) :=
by
  
  have hBasicOpenRes : ∀ (S : AlgebraicGeometry.Scheme.{u}) {V U : S.Opens}
      (f : ↑(S.presheaf.obj (Opposite.op U))) (hle : V ≤ U),
      S.basicOpen ((S.presheaf.map (CategoryTheory.homOfLE hle).op).hom f) =
        V ⊓ S.basicOpen f :=
    fun S _ _ f hle => AlgebraicGeometry.Scheme.basicOpen_res S f (CategoryTheory.homOfLE hle).op

  have hBasicOpenMul : ∀ (S : AlgebraicGeometry.Scheme.{u}) {U : S.Opens}
      (f g : ↑(S.presheaf.obj (Opposite.op U))),
      S.basicOpen (f * g) = S.basicOpen f ⊓ S.basicOpen g :=
    fun S _ f g => AlgebraicGeometry.RingedSpace.basicOpen_mul S.toRingedSpace f g

  have hBasicOpenPow : ∀ (S : AlgebraicGeometry.Scheme.{u}) {U : S.Opens}
      (f : ↑(S.presheaf.obj (Opposite.op U))) (n : ℕ), 0 < n →
      S.basicOpen (f ^ n) = S.basicOpen f :=
    fun S _ f n hn => AlgebraicGeometry.RingedSpace.basicOpen_pow S.toRingedSpace f n hn

  have hPresheafComp : ∀ (S : AlgebraicGeometry.Scheme.{u}) {U V W : S.Opens}
      (hWV : W ≤ V) (hVU : V ≤ U) (a : ↑(S.presheaf.obj (Opposite.op U))),
      (S.presheaf.map (CategoryTheory.homOfLE hWV).op).hom
        ((S.presheaf.map (CategoryTheory.homOfLE hVU).op).hom a) =
      (S.presheaf.map (CategoryTheory.homOfLE (hWV.trans hVU)).op).hom a := by
    intro S U V W hWV hVU a
    have hc : S.presheaf.map (CategoryTheory.homOfLE hVU).op ≫
        S.presheaf.map (CategoryTheory.homOfLE hWV).op =
        S.presheaf.map (CategoryTheory.homOfLE (hWV.trans hVU)).op := by
      rw [← CategoryTheory.Functor.map_comp]
      exact congrArg S.presheaf.map (Subsingleton.elim _ _)
    exact congrArg (fun φ => φ.hom a) hc

  have hIdAppLE : ∀ (S : AlgebraicGeometry.Scheme.{u}) (U : S.Opens)
      (s : ↑(S.presheaf.obj (Opposite.op U))),
      (AlgebraicGeometry.Scheme.Hom.appLE (𝟙 S) U U (le_refl U)).hom s = s := by
    intro S U s
    have heq : AlgebraicGeometry.Scheme.Hom.appLE (𝟙 S) U ((𝟙 S) ⁻¹ᵁ U) (le_refl U) =
        𝟙 (S.presheaf.obj (Opposite.op U)) := by
      rw [← AlgebraicGeometry.Scheme.Hom.app_eq_appLE]
      exact AlgebraicGeometry.Scheme.Hom.id_app U
    exact congrArg (fun φ => φ.hom s) heq

  
  have hProjCov : ∀ (N : ℕ),
      (letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) :=
        MvPolynomial.gradedAlgebra
       ⨆ μ : Fin (N + 1),
         AlgebraicGeometry.Proj.basicOpen
           (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X μ)) = ⊤ := by
    intro N
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K
    letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    apply AlgebraicGeometry.Proj.iSup_basicOpen_eq_top' 𝒜 (fun μ : Fin (N + 1) => MvPolynomial.X μ)
    · intro μ
      exact ⟨1, MvPolynomial.isHomogeneous_X K μ⟩
    · ext p
      simp only [Algebra.mem_top, iff_true]
      induction p using MvPolynomial.induction_on with
      | C c =>
        have hc : MvPolynomial.C c ∈ 𝒜 0 := MvPolynomial.isHomogeneous_C (Fin (N + 1)) c
        have heq : (algebraMap ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) K)) ⟨MvPolynomial.C c, hc⟩ =
            MvPolynomial.C c := rfl
        rw [← heq]
        exact Subalgebra.algebraMap_mem _ _
      | add f g hf hg => exact Subalgebra.add_mem _ hf hg
      | mul_X f μ hf =>
        exact Subalgebra.mul_mem _ hf (Algebra.subset_adjoin ⟨μ, rfl⟩)

  
  have hAwayPre : ∀ (N : ℕ),
      let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K
      letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
      ∀ (μ : Fin (N + 1)) (z : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X μ))
        (p : AlgebraicGeometry.Spec (CommRingCat.of (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X μ)))),
        (AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X μ) (MvPolynomial.isHomogeneous_X K μ) zero_lt_one).base p ∈
          (AlgebraicGeometry.Proj 𝒜).basicOpen ((AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X μ)).hom z) ↔
        p ∈ PrimeSpectrum.basicOpen z := by
    intro N
    dsimp only
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K
    letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    intro μ z p
    let f : MvPolynomial (Fin (N + 1)) K := MvPolynomial.X μ
    have hf : f ∈ 𝒜 1 := MvPolynomial.isHomogeneous_X K μ
    let D := AlgebraicGeometry.Proj.basicOpen 𝒜 f
    have h1 : (TopologicalSpace.Opens.map D.ι.base).obj
        ((AlgebraicGeometry.Proj 𝒜).basicOpen ((AlgebraicGeometry.Proj.awayToSection 𝒜 f).hom z)) =
        (TopologicalSpace.Opens.map D.toSpecΓ.base).obj
          (PrimeSpectrum.basicOpen ((AlgebraicGeometry.Proj.awayToSection 𝒜 f).hom z)) :=
      (AlgebraicGeometry.Scheme.Opens.toSpecΓ_preimage_basicOpen D
        ((AlgebraicGeometry.Proj.awayToSection 𝒜 f).hom z)).symm
    have h3 : D.toSpecΓ ≫ AlgebraicGeometry.Spec.map (AlgebraicGeometry.Proj.awayToSection 𝒜 f) =
        (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 f hf zero_lt_one).hom :=
      (AlgebraicGeometry.Proj.basicOpenIsoSpec_hom 𝒜 f hf zero_lt_one).symm
    have h4 : AlgebraicGeometry.Proj.awayι 𝒜 f hf zero_lt_one =
        (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 f hf zero_lt_one).inv ≫ D.ι :=
      (AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜 f hf zero_lt_one).symm
    have hp1 : (AlgebraicGeometry.Proj.awayι 𝒜 f hf zero_lt_one).base p ∈
        (AlgebraicGeometry.Proj 𝒜).basicOpen ((AlgebraicGeometry.Proj.awayToSection 𝒜 f).hom z) ↔
        (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 f hf zero_lt_one).inv.base p ∈
          (TopologicalSpace.Opens.map D.ι.base).obj
            ((AlgebraicGeometry.Proj 𝒜).basicOpen
              ((AlgebraicGeometry.Proj.awayToSection 𝒜 f).hom z)) := by
      rw [h4]
      rfl
    have hp2 : (AlgebraicGeometry.Spec.map (AlgebraicGeometry.Proj.awayToSection 𝒜 f)).base
        (D.toSpecΓ.base ((AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 f hf zero_lt_one).inv.base p)) =
        p := by
      change ((AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 f hf zero_lt_one).inv ≫
        (D.toSpecΓ ≫ AlgebraicGeometry.Spec.map (AlgebraicGeometry.Proj.awayToSection 𝒜 f))).base p = p
      rw [h3, CategoryTheory.Iso.inv_hom_id]
      rfl
    let q_D : PrimeSpectrum ↑((AlgebraicGeometry.Proj 𝒜).presheaf.obj (Opposite.op D)) :=
      D.toSpecΓ.base ((AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 f hf zero_lt_one).inv.base p)
    have hmid1 : (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 f hf zero_lt_one).inv.base p ∈
        (TopologicalSpace.Opens.map D.ι.base).obj
          ((AlgebraicGeometry.Proj 𝒜).basicOpen
            ((AlgebraicGeometry.Proj.awayToSection 𝒜 f).hom z)) ↔
        q_D ∈ PrimeSpectrum.basicOpen ((AlgebraicGeometry.Proj.awayToSection 𝒜 f).hom z) := by
      rw [h1]
      rfl
    have hmid2 : q_D ∈ PrimeSpectrum.basicOpen ((AlgebraicGeometry.Proj.awayToSection 𝒜 f).hom z) ↔
        p ∈ PrimeSpectrum.basicOpen z := by
      refine (PrimeSpectrum.mem_basicOpen _ q_D).trans ?_
      have hmem_eq : ((AlgebraicGeometry.Proj.awayToSection 𝒜 f).hom z ∈ q_D.asIdeal) ↔
          (z ∈ p.asIdeal) := by
        conv_rhs => rw [← hp2]
        rfl
      exact (not_congr hmem_eq).trans (PrimeSpectrum.mem_basicOpen z p).symm
    exact hp1.trans (hmid1.trans hmid2)

  
  have hProjQS : ∀ (N : ℕ),
      AlgebraicGeometry.QuasiSeparated (weilProjectiveSpaceOver K N).hom := by
    intro N
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K
    letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    change AlgebraicGeometry.QuasiSeparated
      (AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K ↥(𝒜 0))))
    infer_instance

  have hProjQC : ∀ (N : ℕ),
      AlgebraicGeometry.QuasiCompact (weilProjectiveSpaceOver K N).hom := by
    intro N
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K
    letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    let D : Fin (N + 1) → (AlgebraicGeometry.Proj 𝒜).Opens :=
      fun μ => AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X μ)
    have hcov : (⨆ μ : Fin (N + 1), D μ) = ⊤ := hProjCov N
    have hcomp_univ : IsCompact (Set.univ : Set ↥(AlgebraicGeometry.Proj 𝒜)) := by
      have huniv : (Set.univ : Set ↥(AlgebraicGeometry.Proj 𝒜)) = ⋃ μ : Fin (N + 1), (D μ : Set _) := by
        rw [← TopologicalSpace.Opens.coe_top, ← hcov, TopologicalSpace.Opens.coe_iSup]
      rw [huniv]
      exact isCompact_iUnion fun μ =>
        (AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜 (MvPolynomial.X μ)
          (MvPolynomial.isHomogeneous_X K μ) zero_lt_one).isCompact
    refine ⟨fun U _ _ => ?_⟩
    by_cases hne : U.Nonempty
    · obtain ⟨pt, hpt⟩ := hne
      have hU_univ : U = Set.univ := by
        ext q
        simp only [Set.mem_univ, iff_true]
        have hsub : Subsingleton ↥(AlgebraicGeometry.Spec (CommRingCat.of K)) := by
          change Subsingleton (PrimeSpectrum K)
          infer_instance
        rwa [hsub.elim q pt]
      rw [hU_univ, Set.preimage_univ]
      exact hcomp_univ
    · rw [Set.not_nonempty_iff_eq_empty.mp hne, Set.preimage_empty]
      exact isCompact_empty

  
  have hLocMemMap : ∀ {R S : Type u} [CommRing R] [CommRing S] (φ : R →+* S) (f : R),
      (letI : Algebra R S := φ.toAlgebra; IsLocalization.Away f S) →
      ∀ (I : Ideal R) (y : R),
        φ y ∈ Ideal.map φ I ↔ ∃ k : ℕ, f ^ k * y ∈ I := by
    intro R S _ _ φ f hloc I y
    letI : Algebra R S := φ.toAlgebra
    haveI : IsLocalization.Away f S := hloc
    have halg : algebraMap R S = φ := rfl
    rw [← halg, IsLocalization.mem_map_algebraMap_iff (Submonoid.powers f) S]
    constructor
    · rintro ⟨⟨⟨x, hxI⟩, ⟨_, k, rfl⟩⟩, hxy⟩
      have heq : algebraMap R S (f ^ k * y) = algebraMap R S x := by
        rw [map_mul, mul_comm, hxy]
      obtain ⟨⟨_, l, rfl⟩, hcl⟩ := (IsLocalization.eq_iff_exists (Submonoid.powers f) S).mp heq
      refine ⟨l + k, ?_⟩
      have hmul : f ^ (l + k) * y = f ^ l * x := by
        calc
          f ^ (l + k) * y = f ^ l * (f ^ k * y) := by rw [pow_add, mul_assoc]
          _ = f ^ l * x := hcl
      rw [hmul]
      exact Ideal.mul_mem_left _ _ hxI
    · rintro ⟨k, hky⟩
      refine ⟨⟨⟨f ^ k * y, hky⟩, ⟨f ^ k, k, rfl⟩⟩, ?_⟩
      simp only [map_mul, mul_comm]

  refine ⟨?_, ?_⟩
