        CategoryTheory.Limits.preservesBinaryBiproducts_of_preservesBinaryCoproducts (pb_of s)
      have : (pb_of s).Additive :=
        CategoryTheory.Functor.additive_of_preservesBinaryBiproducts (pb_of s)
      have hκΦ : (pb_of s).map κ ≫ (pb_of s).map Φ = 0 := by
        rw [← (pb_of s).map_comp, CategoryTheory.Limits.kernel.condition, (pb_of s).map_zero]
      have happ0 : ((((pb_of s).map Φ).hom.app (Opposite.op T_k)).hom
          ((((pb_of s).map κ).hom.app (Opposite.op T_k)).hom x)) = 0 :=
        ConcreteCategory.congr_hom
          (congrArg (fun m => m.hom.app (Opposite.op T_k)) hκΦ) x
      have hκx0 : (((pb_of s).map κ).hom.app (Opposite.op T_k)).hom x = 0 :=
        (hBij s hs).1 (happ0.trans (map_zero _).symm)
      exact hPbMonoInj s κ (hκx0.trans (map_zero _).symm)
    have hEpi : CategoryTheory.Epi Φ := by
      rw [CategoryTheory.Preadditive.epi_iff_isZero_cokernel]
      refine hZeroCons (CategoryTheory.Limits.cokernel Φ) fun s hs => ?_
      have : CategoryTheory.Limits.PreservesColimitsOfSize.{0, 0} (pb_of s) :=
        (adj_of s).leftAdjoint_preservesColimits
      let e_cok : (pb_of s).obj (CategoryTheory.Limits.cokernel Φ) ≅
          CategoryTheory.Limits.cokernel ((pb_of s).map Φ) :=
        CategoryTheory.Limits.PreservesCokernel.iso (pb_of s) Φ
      have : CategoryTheory.Epi ((pb_of s).map Φ) := hEpiSpec _ (hBij s hs).2
      have hZ_cok : CategoryTheory.Limits.IsZero
          (CategoryTheory.Limits.cokernel ((pb_of s).map Φ)) :=
        (CategoryTheory.Preadditive.epi_iff_isZero_cokernel _).mp inferInstance
      exact hSubOfIsZero _ T_k (hZ_cok.of_iso e_cok)
    exact CategoryTheory.isIso_of_mono_of_epi Φ

  
  
  
