        have hinv_snd : inv_W ≫ snd₂ = snd_k ≫ u_k_k₂ := CategoryTheory.Limits.pullback.lift_snd _ _ _
        have hto_fst : to_W₂ ≫ fst₁ = fst_k := CategoryTheory.Limits.pullback.lift_fst _ _ _
        have hto_snd : to_W₂ ≫ W₂.hom = snd_k ≫ u_k_k₂ ≫ g_F₂k₂ :=
          CategoryTheory.Limits.pullback.lift_snd _ _ _
        have hc₂ : fst₂ ≫ W₂.hom = snd₂ ≫ g_F₂k₂ := CategoryTheory.Limits.pullback.condition
        apply CategoryTheory.Limits.pullback.hom_ext
