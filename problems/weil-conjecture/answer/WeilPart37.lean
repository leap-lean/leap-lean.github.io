                      exact map_nsmul φ.hom c.down.val v) }
                invFun := fun ψ => ModuleCat.ofHom
                  { toFun := fun v => (ψ.hom v).1
                    map_add' := fun v₁ v₂ => congrArg Subtype.val (map_add ψ.hom v₁ v₂)
                    map_smul' := fun c v => by
                      let wv : ↥W := (ψ.hom v).1
                      change (ψ.hom (c.down.val • v)).1 = c • wv
