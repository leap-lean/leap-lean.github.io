        by_cases hac : a = c
        · subst hac
          dsimp only [ev_c2, ev_cm]
          rw [MvPolynomial.eval₂Hom_X', Fin.insertNth_apply_same,
            MvPolynomial.eval₂Hom_X', Fin.insertNth_apply_same, map_one]
        · obtain ⟨i, rfl⟩ := Fin.exists_succAbove_eq hac
          have hsucc2 : (c.succAbove i).succ.succ = c.succ.succ.succAbove i.succ.succ := by
