theorem weil_odp_punct_sm_val_ring_colimit_and_pointed_etale_lift (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    let P := Polynomial k
    let Ω := AlgebraicClosure (FractionRing P)
    ∃ (R_bar : Type u) (_ : CommRing R_bar) (_ : IsDomain R_bar) (_ : IsLocalRing R_bar)
      (p_R : P →+* R_bar) (t_bar : R_bar) (π_cl : R_bar →+* k) (φ_R_Ω : R_bar →+* Ω)
      (ℐ : Type u) (_ : CategoryTheory.SmallCategory ℐ) (_ : CategoryTheory.IsFiltered ℐ)
      (D : ℐ ⥤ CommRingCat.{u})
      (α : (CategoryTheory.Functor.const ℐ).obj (CommRingCat.of P) ⟶ D)
      (c : CategoryTheory.Limits.Cocone D) (_ : CategoryTheory.Limits.IsColimit c)
      (e_pt : c.pt ≅ CommRingCat.of R_bar),
      (p_R Polynomial.X = t_bar ∧
        π_cl.comp p_R = Polynomial.evalRingHom 0 ∧
        φ_R_Ω.comp p_R = algebraMap P Ω ∧
        Function.Injective φ_R_Ω ∧
        @IsLocalization.Away R_bar _ t_bar Ω _ φ_R_Ω.toAlgebra) ∧
      ((∀ i : ℐ,
          (α.app i) ≫ (c.ι.app i) ≫ e_pt.hom = CommRingCat.ofHom p_R ∧
          Function.Injective ((c.ι.app i) ≫ e_pt.hom).hom) ∧
        (∀ i : ℐ,
          ∃ (ϖ : ↑(D.obj i)) (u : (↑(D.obj i))ˣ) (e : ℕ)
            (ψ_i : Polynomial k →+* ↑(D.obj i)),
            1 ≤ e ∧
            ((c.ι.app i) ≫ e_pt.hom).hom ϖ ∈ IsLocalRing.maximalIdeal R_bar ∧
            (α.app i).hom Polynomial.X = ↑u * ϖ ^ e ∧
            ψ_i.comp Polynomial.C = (α.app i).hom.comp Polynomial.C ∧
            ψ_i Polynomial.X = ϖ ∧
            ψ_i.Etale ∧
            ∃ (i₁ : ℐ) (θ : i ⟶ i₁) (β : ↑(D.obj i₁))
              (ψ₁ : Polynomial k →+* ↑(D.obj i₁)),
              (D.map θ).hom ϖ = β ^ ℓ ∧
              ψ₁.comp Polynomial.C = (α.app i₁).hom.comp Polynomial.C ∧
              ψ₁ Polynomial.X = β ∧
              ψ₁.Etale)) ∧
      (∀ {S W₀ : AlgebraicGeometry.Scheme.{u}} (w₀ : W₀ ⟶ S) [AlgebraicGeometry.Etale w₀]
          (g_S : AlgebraicGeometry.Spec (CommRingCat.of R_bar) ⟶ S)
          (s_tilde : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ W₀),
        s_tilde ≫ w₀ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_cl) ≫ g_S →
        ∃ g_tilde : AlgebraicGeometry.Spec (CommRingCat.of R_bar) ⟶ W₀,
          g_tilde ≫ w₀ = g_S ∧
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_cl) ≫ g_tilde = s_tilde) :=
by
  classical
  let P := Polynomial k
  let K₀ := FractionRing P
  let Ω := AlgebraicClosure K₀

  have hinj_PΩ : Function.Injective (algebraMap P Ω) := by
    rw [IsScalarTower.algebraMap_eq P K₀ Ω]
    exact (RingHom.injective (algebraMap K₀ Ω)).comp (IsFractionRing.injective P K₀)

  
  
  
  
  have h_pillar1 :
      ∃ (R_bar : Type u) (_ : CommRing R_bar) (_ : IsDomain R_bar) (_ : IsLocalRing R_bar)
        (p_R : P →+* R_bar) (t_bar : R_bar) (π_cl : R_bar →+* k) (φ_R_Ω : R_bar →+* Ω),
        (p_R Polynomial.X = t_bar ∧
          t_bar ∈ IsLocalRing.maximalIdeal R_bar ∧
          t_bar ≠ 0 ∧
          Function.Injective p_R) ∧
        (RingHom.ker π_cl = IsLocalRing.maximalIdeal R_bar ∧
          π_cl.comp p_R = Polynomial.evalRingHom 0) ∧
        (φ_R_Ω.comp p_R = algebraMap P Ω ∧
          Function.Injective φ_R_Ω ∧
          @IsLocalization.Away R_bar _ t_bar Ω _ φ_R_Ω.toAlgebra) ∧
        (∀ w : R_bar, ∃ (a s : R_bar),
          _root_.IsIntegral P (φ_R_Ω a) ∧
          _root_.IsIntegral P (φ_R_Ω s) ∧
          IsUnit s ∧ w * s = a) ∧
        (∀ z : Ω, _root_.IsIntegral P z → ∃ r : R_bar, φ_R_Ω r = z) ∧
        (∀ (n : ℕ) (y : R_bar),
          1 ≤ n → y ∈ IsLocalRing.maximalIdeal R_bar →
          ∃ β ∈ IsLocalRing.maximalIdeal R_bar, β ^ n = y) ∧
        (∀ (F : Polynomial R_bar), F.Monic → ∀ c₀ : k,
          Polynomial.eval₂ π_cl c₀ F = 0 →
          ∃ a : R_bar, Polynomial.eval a F = 0 ∧ π_cl a = c₀) := by
    let B_bar : Subalgebra P Ω := integralClosure P Ω
    have hinj_PB : Function.Injective (algebraMap P ↥B_bar) := fun x y hxy =>
      hinj_PΩ (congrArg Subtype.val hxy)
    let ev₀ : P →+* k := Polynomial.evalRingHom 0
    have hev₀_surj : Function.Surjective ev₀ := fun c => ⟨Polynomial.C c, Polynomial.eval_C⟩
    let m₀ : Ideal P := RingHom.ker ev₀
    haveI : m₀.IsMaximal := RingHom.ker_isMaximal_of_surjective ev₀ hev₀_surj
    have hker_le : RingHom.ker (algebraMap P ↥B_bar) ≤ m₀ := by
      intro x hx
      rw [RingHom.mem_ker] at hx
      rw [hinj_PB (hx.trans (map_zero _).symm)]
      exact Ideal.zero_mem m₀

    obtain ⟨M_max, hM_max, hM_over⟩ :=
      Ideal.exists_ideal_over_maximal_of_isIntegral (S := ↥B_bar) m₀ hker_le
    letI : M_max.IsMaximal := hM_max
    letI : M_max.IsPrime := hM_max.isPrime

    let R_loc : Type u := Localization.AtPrime M_max
    haveI : IsDomain R_loc :=
      IsLocalization.isDomain_of_le_nonZeroDivisors R_loc M_max.primeCompl_le_nonZeroDivisors
    let b_to_R : ↥B_bar →+* R_loc := algebraMap ↥B_bar R_loc
    let p_R : P →+* R_loc := b_to_R.comp (algebraMap P ↥B_bar)
    let t_bar : R_loc := p_R Polynomial.X

    have hX_mem_M : algebraMap P ↥B_bar Polynomial.X ∈ M_max := by
      have hX_m₀ : Polynomial.X ∈ m₀ := Polynomial.eval_X
      rwa [← hM_over] at hX_m₀
    have ht_max : t_bar ∈ IsLocalRing.maximalIdeal R_loc :=
      (IsLocalization.AtPrime.to_map_mem_maximal_iff R_loc M_max _).mpr hX_mem_M

    have h_units_Ω : ∀ y : M_max.primeCompl, IsUnit (B_bar.val.toRingHom y.1) := by
      intro y
      have hy_ne : y.1 ≠ 0 := fun h0 => y.2 (h0 ▸ M_max.zero_mem)
      exact IsUnit.mk0 _ (fun h0 => hy_ne (Subtype.ext h0))
    let φ_R_Ω : R_loc →+* Ω := IsLocalization.lift (M := M_max.primeCompl) h_units_Ω
    have hφ_b : ∀ b : ↥B_bar, φ_R_Ω (b_to_R b) = b.1 := IsLocalization.lift_eq h_units_Ω
    have hφ_pR : φ_R_Ω.comp p_R = algebraMap P Ω := by
      apply RingHom.ext
      intro x
      change φ_R_Ω (b_to_R (algebraMap P ↥B_bar x)) = algebraMap P Ω x
      rw [hφ_b]
      rfl
    have hφ_inj : Function.Injective φ_R_Ω := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      obtain ⟨⟨b, s⟩, hbs⟩ := IsLocalization.surj M_max.primeCompl x
      have hb0 : (b : Ω) = 0 := by
        have h1 := congrArg φ_R_Ω hbs
        rw [map_mul, hx, zero_mul, hφ_b] at h1
        exact h1.symm
      have hb0' : b = 0 := Subtype.ext hb0
      rw [hb0', map_zero] at hbs
      exact (IsLocalization.map_units R_loc s).mul_left_eq_zero.mp hbs
    have hp_inj : Function.Injective p_R := fun x y hxy =>
      hinj_PΩ (by simpa [← RingHom.comp_apply, hφ_pR] using congrArg φ_R_Ω hxy)
    have ht_ne : t_bar ≠ 0 := fun h0 => Polynomial.X_ne_zero (hp_inj (h0.trans (map_zero p_R).symm))

    have hCommonDenom : ∀ (m : ℕ) (c : ℕ → R_loc),
        ∃ (s : M_max.primeCompl) (d : ℕ → ↥B_bar),
          ∀ i < m, c i * b_to_R s.1 = b_to_R (d i) := by
      intro m c
      induction m with
      | zero => exact ⟨1, fun _ => 0, fun i hi => absurd hi (Nat.not_lt_zero i)⟩
      | succ m ih =>
        obtain ⟨s₀, d₀, hd₀⟩ := ih
        obtain ⟨⟨b_m, s_m⟩, hbm⟩ := IsLocalization.surj M_max.primeCompl (c m)
        refine ⟨s₀ * s_m, fun i => if i = m then b_m * s₀.1 else d₀ i * s_m.1, ?_⟩
        intro i hi
        by_cases him : i = m
        · subst him
          simp only [↓reduceIte, Submonoid.coe_mul, map_mul]
          calc c i * (b_to_R s₀.1 * b_to_R s_m.1)
              = (c i * b_to_R s_m.1) * b_to_R s₀.1 := by ring
            _ = b_to_R b_m * b_to_R s₀.1 := by rw [hbm]
        · have hi_lt : i < m := Nat.lt_of_le_of_ne (Nat.lt_succ_iff.mp hi) him
          simp only [him, ↓reduceIte, Submonoid.coe_mul, map_mul]
          calc c i * (b_to_R s₀.1 * b_to_R s_m.1)
              = (c i * b_to_R s₀.1) * b_to_R s_m.1 := by ring
            _ = b_to_R (d₀ i) * b_to_R s_m.1 := by rw [hd₀ i hi_lt]

    have hLiftRoot : ∀ (F : Polynomial R_loc), F.Monic →
        ∀ (α : Ω), Polynomial.eval₂ φ_R_Ω α F = 0 → ∃ r : R_loc, φ_R_Ω r = α := by
      intro F hF α hα
      let m := F.natDegree
      obtain ⟨s, d, hd⟩ := hCommonDenom m F.coeff
      have hd_Ω : ∀ i < m, φ_R_Ω (F.coeff i) * (s.1 : Ω) = (d i : Ω) := by
        intro i hi
        have h1 := congrArg φ_R_Ω (hd i hi)
        rwa [map_mul, hφ_b, hφ_b] at h1
      let G : Polynomial ↥B_bar :=
        Polynomial.X ^ m +
          ∑ i ∈ Finset.range m, Polynomial.C (d i * s.1 ^ (m - 1 - i)) * Polynomial.X ^ i
      have hG_monic : G.Monic := by
        rcases Nat.eq_zero_or_pos m with hm0 | hm_pos
        · dsimp only [G]
          rw [hm0, pow_zero, Finset.range_zero, Finset.sum_empty, add_zero]
          exact Polynomial.monic_one
        · apply Polynomial.monic_X_pow_add
          rw [Polynomial.degree_lt_iff_coeff_zero]
          intro idx hidx
          rw [Polynomial.finset_sum_coeff]
          apply Finset.sum_eq_zero
          intro i hi
          rw [Finset.mem_range] at hi
          rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, if_neg (by omega), mul_zero]
      have hF_sum : α ^ m + ∑ i ∈ Finset.range m, φ_R_Ω (F.coeff i) * α ^ i = 0 := by
        have hev := F.eval₂_eq_sum_range φ_R_Ω α
        rw [hα, Finset.sum_range_succ, hF.coeff_natDegree, map_one, one_mul, add_comm] at hev
        exact hev.symm
      have hG_eval : Polynomial.eval₂ B_bar.val.toRingHom ((s.1 : Ω) * α) G = 0 := by
        dsimp only [G]
        rw [Polynomial.eval₂_add, Polynomial.eval₂_X_pow, Polynomial.eval₂_finset_sum]
        have hterm : ∀ i ∈ Finset.range m,
            Polynomial.eval₂ B_bar.val.toRingHom ((s.1 : Ω) * α)
              (Polynomial.C (d i * s.1 ^ (m - 1 - i)) * Polynomial.X ^ i) =
            (s.1 : Ω) ^ m * (φ_R_Ω (F.coeff i) * α ^ i) := by
          intro i hi
          rw [Finset.mem_range] at hi
          rw [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X_pow]
          change ((d i : Ω) * (s.1 : Ω) ^ (m - 1 - i)) * ((s.1 : Ω) * α) ^ i = _
          rw [← hd_Ω i hi, mul_pow]
          have hexp : 1 + (m - 1 - i) + i = m := by omega
          calc (φ_R_Ω (F.coeff i) * (s.1 : Ω) * (s.1 : Ω) ^ (m - 1 - i)) * ((s.1 : Ω) ^ i * α ^ i)
              = ((s.1 : Ω) ^ 1 * (s.1 : Ω) ^ (m - 1 - i) * (s.1 : Ω) ^ i) *
                  (φ_R_Ω (F.coeff i) * α ^ i) := by ring
            _ = (s.1 : Ω) ^ m * (φ_R_Ω (F.coeff i) * α ^ i) := by
                  rw [← pow_add, ← pow_add, hexp]
        rw [Finset.sum_congr rfl hterm, ← Finset.mul_sum, mul_pow, ← mul_add, hF_sum, mul_zero]
      have hInt_B : _root_.IsIntegral ↥B_bar ((s.1 : Ω) * α) := ⟨G, hG_monic, hG_eval⟩
      have hInt_P : _root_.IsIntegral P ((s.1 : Ω) * α) :=
        _root_.isIntegral_trans (R := P) (A := ↥B_bar) _ hInt_B
      let w_α : ↥B_bar := ⟨(s.1 : Ω) * α, hInt_P⟩
      let r : R_loc := IsLocalization.mk' R_loc w_α s
      refine ⟨r, ?_⟩
      have hrs : (s.1 : Ω) * φ_R_Ω r = (s.1 : Ω) * α := by
        have h1 := congrArg φ_R_Ω (IsLocalization.mk'_spec' R_loc w_α s)
        rwa [map_mul, hφ_b, hφ_b] at h1
      have hs_ne : (s.1 : Ω) ≠ 0 := by
        intro h0
        have hs0 : s.1 = 0 := Subtype.ext h0
        exact s.2 (hs0 ▸ M_max.zero_mem)
      exact mul_left_cancel₀ hs_ne hrs

    have hRootPow : ∀ (n : ℕ) (y : R_loc),
        1 ≤ n → y ∈ IsLocalRing.maximalIdeal R_loc →
        ∃ β ∈ IsLocalRing.maximalIdeal R_loc, β ^ n = y := by
      intro n y hn hy
      obtain ⟨α, hα⟩ := IsAlgClosed.exists_pow_nat_eq (φ_R_Ω y) (by omega : 0 < n)
      let F : Polynomial R_loc := Polynomial.X ^ n - Polynomial.C y
      have hF_monic : F.Monic := Polynomial.monic_X_pow_sub_C y (by omega)
      have hF_eval : Polynomial.eval₂ φ_R_Ω α F = 0 := by
        dsimp only [F]
        rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, hα, sub_self]
      obtain ⟨β, hβ_eq⟩ := hLiftRoot F hF_monic α hF_eval
      have hβ_pow : β ^ n = y := hφ_inj (by rw [map_pow, hβ_eq, hα])
      have hβ_max : β ∈ IsLocalRing.maximalIdeal R_loc :=
        (inferInstance : (IsLocalRing.maximalIdeal R_loc).IsPrime).mem_of_pow_mem n (hβ_pow.symm ▸ hy)
      exact ⟨β, hβ_max, hβ_pow⟩

    let res : R_loc →+* IsLocalRing.ResidueField R_loc := IsLocalRing.residue R_loc
    let ρ_k : k →+* IsLocalRing.ResidueField R_loc := res.comp (p_R.comp Polynomial.C)
    have hres_pR : res.comp p_R = ρ_k.comp ev₀ := by
      apply Polynomial.ringHom_ext'
      · ext c
        simp [ρ_k, ev₀, Polynomial.eval_C]
      · simp only [RingHom.comp_apply, ev₀, Polynomial.coe_evalRingHom, Polynomial.eval_X, map_zero]
        exact (IsLocalRing.residue_eq_zero_iff t_bar).mpr ht_max

    have hAlgClosedRange : ∀ (m : ℕ) (Q₀ : Polynomial k),
        Q₀.natDegree = m → Q₀.Monic →
        ∀ z : IsLocalRing.ResidueField R_loc, Polynomial.eval₂ ρ_k z Q₀ = 0 →
        z ∈ Set.range ρ_k := by
      intro m
      induction m using Nat.strong_induction_on with
      | h m ih =>
        intro Q₀ hm hQ₀ z hz
        rcases Nat.eq_zero_or_pos m with rfl | hm_pos
        · rw [Polynomial.eq_one_of_monic_natDegree_zero hQ₀ hm, Polynomial.eval₂_one] at hz
          exact absurd hz one_ne_zero
        · have hdeg_ne : Q₀.degree ≠ 0 := by
            rw [Polynomial.degree_eq_natDegree hQ₀.ne_zero, hm]
            exact mod_cast (by omega : m ≠ 0)
          obtain ⟨c, hc⟩ := IsAlgClosed.exists_root Q₀ hdeg_ne
          obtain ⟨Q₁, hQ₁_fac⟩ := Polynomial.dvd_iff_isRoot.mpr hc
          have hQ₁_monic : Q₁.Monic :=
            Polynomial.Monic.of_mul_monic_left (Polynomial.monic_X_sub_C c) (hQ₁_fac ▸ hQ₀)
          have hdeg_sum : Q₀.natDegree = 1 + Q₁.natDegree := by
            rw [hQ₁_fac, Polynomial.natDegree_mul (Polynomial.monic_X_sub_C c).ne_zero hQ₁_monic.ne_zero,
              Polynomial.natDegree_X_sub_C]
          rw [hQ₁_fac, Polynomial.eval₂_mul, Polynomial.eval₂_sub, Polynomial.eval₂_X,
            Polynomial.eval₂_C, mul_eq_zero] at hz
          rcases hz with hzc | hz₁
          · exact ⟨c, (sub_eq_zero.mp hzc).symm⟩
          · exact ih Q₁.natDegree (by omega) Q₁ rfl hQ₁_monic z hz₁

    have hρ_b_range : ∀ b : ↥B_bar, res (b_to_R b) ∈ Set.range ρ_k := by
      intro b
      obtain ⟨Q, hQ_monic, hQ_eval⟩ := b.2
      have hQ_B : Polynomial.eval₂ (algebraMap P ↥B_bar) b Q = 0 := by
        apply Subtype.ext
        change B_bar.val.toRingHom (Polynomial.eval₂ (algebraMap P ↥B_bar) b Q) = 0
        rw [Polynomial.hom_eval₂]
        exact hQ_eval
      let Q₀ : Polynomial k := Q.map ev₀
      have hQ₀_monic : Q₀.Monic := hQ_monic.map ev₀
      have hQ₀_eval : Polynomial.eval₂ ρ_k (res (b_to_R b)) Q₀ = 0 := by
        dsimp only [Q₀]
        rw [Polynomial.eval₂_map, ← hres_pR]
        have h1 := congrArg (res.comp b_to_R) hQ_B
        rw [Polynomial.hom_eval₂, map_zero] at h1
        exact h1
      exact hAlgClosedRange Q₀.natDegree Q₀ rfl hQ₀_monic _ hQ₀_eval

    have hρ_surj : Function.Surjective ρ_k := by
      intro z
      obtain ⟨x, rfl⟩ := IsLocalRing.residue_surjective (R := R_loc) z
      obtain ⟨⟨b, s⟩, hbs⟩ := IsLocalization.surj M_max.primeCompl x
      obtain ⟨c, hc⟩ := hρ_b_range b
      obtain ⟨d, hd⟩ := hρ_b_range s.1
      have hs_unit : IsUnit (res (b_to_R s.1)) := (IsLocalization.map_units R_loc s).map res
      have hd_ne : d ≠ 0 := by
        intro hd0
        rw [hd0, map_zero] at hd
        exact hs_unit.ne_zero hd.symm
      refine ⟨c * d⁻¹, ?_⟩
      apply hs_unit.mul_left_cancel
      have h1 := congrArg res hbs
      rw [map_mul] at h1
      have hdd : ρ_k d * ρ_k d⁻¹ = 1 := by
        rw [← map_mul, mul_inv_cancel₀ hd_ne, map_one]
      rw [map_mul, ← hd]
      calc ρ_k d * (ρ_k c * ρ_k d⁻¹)
          = ρ_k c * (ρ_k d * ρ_k d⁻¹) := by ring
        _ = ρ_k c := by rw [hdd, mul_one]
        _ = res (b_to_R b) := hc
        _ = res x * res (b_to_R s.1) := h1.symm
        _ = ρ_k d * res x := by rw [← hd, mul_comm]

    let e_res : k ≃+* IsLocalRing.ResidueField R_loc :=
      RingEquiv.ofBijective ρ_k ⟨ρ_k.injective, hρ_surj⟩
    let π_cl : R_loc →+* k := e_res.symm.toRingHom.comp res
    have hπ_ker : RingHom.ker π_cl = IsLocalRing.maximalIdeal R_loc := by
      ext x
      rw [RingHom.mem_ker, RingHom.comp_apply]
      change e_res.symm (res x) = 0 ↔ x ∈ IsLocalRing.maximalIdeal R_loc
      rw [map_eq_zero_iff e_res.symm e_res.symm.injective]
      exact IsLocalRing.residue_eq_zero_iff x
    have hπ_pR : π_cl.comp p_R = ev₀ := by
      apply Polynomial.ringHom_ext'
      · ext c
        change e_res.symm (e_res c) = Polynomial.eval 0 (Polynomial.C c)
        rw [e_res.symm_apply_apply, Polynomial.eval_C]
      · simp only [RingHom.comp_apply, ev₀, Polynomial.coe_evalRingHom, Polynomial.eval_X]
        exact RingHom.mem_ker.mp (hπ_ker.symm ▸ ht_max)

    have hPointedMonicRoot : ∀ (m : ℕ) (F : Polynomial R_loc),
        F.natDegree = m → F.Monic → ∀ c₀ : k, Polynomial.eval₂ π_cl c₀ F = 0 →
        ∃ a : R_loc, Polynomial.eval a F = 0 ∧ π_cl a = c₀ := by
      intro m
      induction m using Nat.strong_induction_on with
      | h m ih =>
        intro F hm hF c₀ hc₀
        rcases Nat.eq_zero_or_pos m with rfl | hm_pos
        · rw [Polynomial.eq_one_of_monic_natDegree_zero hF hm, Polynomial.eval₂_one] at hc₀
          exact absurd hc₀ one_ne_zero
        · have hmap_monic : (F.map φ_R_Ω).Monic := hF.map φ_R_Ω
          have hdeg_ne : (F.map φ_R_Ω).degree ≠ 0 := by
            rw [Polynomial.degree_eq_natDegree hmap_monic.ne_zero, hF.natDegree_map, hm]
            exact mod_cast (by omega : m ≠ 0)
          obtain ⟨α, hα⟩ := IsAlgClosed.exists_root (F.map φ_R_Ω) hdeg_ne
          rw [Polynomial.IsRoot.def, Polynomial.eval_map] at hα
          obtain ⟨r, hr⟩ := hLiftRoot F hF α hα
          have hr_root : F.IsRoot r := by
            rw [Polynomial.IsRoot.def]
            apply hφ_inj
            rw [map_zero, ← Polynomial.eval₂_hom, hr, hα]
          obtain ⟨F₁, hF₁_fac⟩ := Polynomial.dvd_iff_isRoot.mpr hr_root
          have hF₁_monic : F₁.Monic :=
            Polynomial.Monic.of_mul_monic_left (Polynomial.monic_X_sub_C r) (hF₁_fac ▸ hF)
          have hdeg_sum : F.natDegree = 1 + F₁.natDegree := by
            rw [hF₁_fac, Polynomial.natDegree_mul (Polynomial.monic_X_sub_C r).ne_zero hF₁_monic.ne_zero,
              Polynomial.natDegree_X_sub_C]
          rw [hF₁_fac, Polynomial.eval₂_mul, Polynomial.eval₂_sub, Polynomial.eval₂_X,
            Polynomial.eval₂_C, mul_eq_zero] at hc₀
          rcases hc₀ with hrc₀ | hF₁c₀
          · exact ⟨r, hr_root, (sub_eq_zero.mp hrc₀).symm⟩
          · obtain ⟨a, ha_root, ha_cl⟩ := ih F₁.natDegree (by omega) F₁ rfl hF₁_monic c₀ hF₁c₀
            refine ⟨a, ?_, ha_cl⟩
            rw [hF₁_fac, Polynomial.eval_mul, ha_root, mul_zero]

    have hPolyFactorX : ∀ (m : ℕ) (g : P), g.natDegree = m → g ≠ 0 →
        ∃ (r : ℕ) (h : P), g = Polynomial.X ^ r * h ∧ ev₀ h ≠ 0 := by
      intro m
      induction m using Nat.strong_induction_on with
      | h m ih =>
        intro g hm hg_ne
        by_cases hg0 : ev₀ g = 0
        · have hg_root : g.IsRoot 0 := hg0
          have hX_eq : Polynomial.X - Polynomial.C (0 : k) = Polynomial.X := by simp
          obtain ⟨g₁, hg₁_fac⟩ := Polynomial.dvd_iff_isRoot.mpr hg_root
          rw [hX_eq] at hg₁_fac
          have hg₁_ne : g₁ ≠ 0 := fun h0 => hg_ne (by rw [hg₁_fac, h0, mul_zero])
          have hdeg_sum : g.natDegree = 1 + g₁.natDegree := by
            rw [hg₁_fac, Polynomial.natDegree_mul Polynomial.X_ne_zero hg₁_ne, Polynomial.natDegree_X]
          obtain ⟨r₁, h, hh_fac, hh0⟩ := ih g₁.natDegree (by omega) g₁ rfl hg₁_ne
          refine ⟨r₁ + 1, h, ?_, hh0⟩
          rw [hg₁_fac, hh_fac, pow_succ', mul_assoc]
        · exact ⟨0, g, by simp, hg0⟩

    have hLocAway : @IsLocalization.Away R_loc _ t_bar Ω _ φ_R_Ω.toAlgebra := by
      letI : Algebra R_loc Ω := φ_R_Ω.toAlgebra
      refine { map_units := ?_, surj := ?_, exists_of_eq := ?_ }
      · rintro ⟨_, r, rfl⟩
        have hne : φ_R_Ω (t_bar ^ r) ≠ 0 := by
          rw [map_pow]
          exact pow_ne_zero r (fun h0 => ht_ne (hφ_inj (h0.trans (map_zero φ_R_Ω).symm)))
        exact IsUnit.mk0 _ hne
      · intro z
        have hz_int : _root_.IsIntegral K₀ z :=
          (Algebra.IsAlgebraic.isAlgebraic (R := K₀) z).isIntegral
        obtain ⟨m_nz, hm_int⟩ :=
          _root_.IsIntegral.exists_multiple_integral_of_isLocalization (nonZeroDivisors P) z hz_int
        let g : P := m_nz.1
        have hg_ne : g ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp m_nz.2
        have hm_smul : (m_nz • z : Ω) = algebraMap P Ω g * z := by
          rw [Submonoid.smul_def, Algebra.smul_def]
        rw [hm_smul] at hm_int
        obtain ⟨r, h, hgh, hh0⟩ := hPolyFactorX g.natDegree g rfl hg_ne
        let h_B : ↥B_bar := algebraMap P ↥B_bar h
        have hh_not_M : h_B ∉ M_max := by
          intro hhM
          have hh_m₀ : h ∈ m₀ := by
            rw [← hM_over]
            exact hhM
          exact hh0 hh_m₀
        let s_h : M_max.primeCompl := ⟨h_B, hh_not_M⟩
        let w_z : ↥B_bar := ⟨algebraMap P Ω g * z, hm_int⟩
        let x_R : R_loc := IsLocalization.mk' R_loc w_z s_h
        refine ⟨(x_R, ⟨t_bar ^ r, r, rfl⟩), ?_⟩
        change z * φ_R_Ω (t_bar ^ r) = φ_R_Ω x_R
        have hh_Ω_ne : algebraMap P Ω h ≠ 0 :=
          fun h0 => hh0 (by rw [hinj_PΩ (h0.trans (map_zero _).symm), map_zero])
        apply mul_right_cancel₀ hh_Ω_ne
        have hx_spec := congrArg φ_R_Ω (IsLocalization.mk'_spec' R_loc w_z s_h)
        rw [map_mul, hφ_b, hφ_b] at hx_spec
        have ht_Ω : φ_R_Ω (t_bar ^ r) = (algebraMap P Ω Polynomial.X) ^ r := by
          rw [map_pow]
          have h1 : φ_R_Ω t_bar = (φ_R_Ω.comp p_R) Polynomial.X := rfl
          rw [h1, hφ_pR]
        calc (z * φ_R_Ω (t_bar ^ r)) * algebraMap P Ω h
            = z * ((algebraMap P Ω Polynomial.X) ^ r * algebraMap P Ω h) := by rw [ht_Ω]; ring
          _ = z * algebraMap P Ω g := by rw [hgh, map_mul, map_pow]
          _ = (w_z : Ω) := mul_comm z _
          _ = φ_R_Ω x_R * algebraMap P Ω h := by
                rw [← hx_spec]
                exact mul_comm _ _
      · intro x y hxy
        exact ⟨⟨1, 0, pow_zero t_bar⟩, by simp [hφ_inj hxy]⟩

    have h_intFrac : ∀ w : R_loc, ∃ (a s : R_loc),
        _root_.IsIntegral P (φ_R_Ω a) ∧ _root_.IsIntegral P (φ_R_Ω s) ∧ IsUnit s ∧ w * s = a := by
      intro w
      obtain ⟨⟨b, s⟩, hbs⟩ := IsLocalization.surj M_max.primeCompl w
      refine ⟨b_to_R b, b_to_R s.1, ?_, ?_, IsLocalization.map_units R_loc s, hbs⟩
      · rw [hφ_b]; exact b.2
      · rw [hφ_b]; exact s.1.2

    have h_int_in_R : ∀ z : Ω, _root_.IsIntegral P z → ∃ r : R_loc, φ_R_Ω r = z :=
      fun z hz => ⟨b_to_R ⟨z, hz⟩, hφ_b ⟨z, hz⟩⟩

    exact ⟨R_loc, inferInstance, inferInstance, inferInstance,
      p_R, t_bar, π_cl, φ_R_Ω,
      ⟨rfl, ht_max, ht_ne, hp_inj⟩,
      ⟨hπ_ker, hπ_pR⟩,
      ⟨hφ_pR, hφ_inj, hLocAway⟩,
      h_intFrac, h_int_in_R, hRootPow,
      fun F hF c₀ hc₀ => hPointedMonicRoot F.natDegree F rfl hF c₀ hc₀⟩

  
  obtain ⟨R_bar, hCR_R, hDom_R, hLoc_R, p_R, t_bar, π_cl, φ_R_Ω,
    ⟨ht_eq, ht_max, ht_ne, hp_inj⟩,
    ⟨hπ_ker, hπ_pR⟩,
    ⟨hφ_pR, hφ_inj, hLocAway⟩,
    h_intFrac, h_int_in_R, hRootPow, hPointedMonicRoot⟩ := h_pillar1
  letI : CommRing R_bar := hCR_R
  letI : IsDomain R_bar := hDom_R
  letI : IsLocalRing R_bar := hLoc_R

  
  
  
  have hEtaleUnramifiedKill :
      ∀ (Bt : Type u) [CommRing Bt] [IsDomain Bt] [Algebra k Bt] [Algebra.FiniteType k Bt]
        (p_Bt : Ideal Bt) [p_Bt.IsPrime]
        (κ_Bt : Bt →+* k)
        (hκ_ker : RingHom.ker κ_Bt = p_Bt)
        (hκ_k : ∀ c : k, κ_Bt (algebraMap k Bt c) = c)
        (ϖ₀ : Bt) (hϖ₀_ne : ϖ₀ ≠ 0)
        (h_span_max : IsLocalRing.maximalIdeal (Localization.AtPrime p_Bt) =
          Ideal.span {algebraMap Bt (Localization.AtPrime p_Bt) ϖ₀}),
      ∃ f_et : Bt, f_et ∉ p_Bt ∧
        ∀ (g_extra : Bt), g_extra ∉ p_Bt →
          ((algebraMap Bt (Localization.Away (f_et * g_extra))).comp
            (Polynomial.aeval (R := k) (A := Bt) ϖ₀).toRingHom).Etale := by
    intro Bt _ _ _ _ p_Bt _ κ_Bt hκ_ker hκ_k ϖ₀ hϖ₀_ne h_span_max
    let ψ₀ : P →+* Bt := (Polynomial.aeval (R := k) (A := Bt) ϖ₀).toRingHom
    letI : Algebra P Bt := ψ₀.toAlgebra
    haveI : IsScalarTower k P Bt := IsScalarTower.of_algebraMap_eq'
      (RingHom.ext fun c => (Polynomial.aeval_C ϖ₀ c).symm)
    haveI : Algebra.FiniteType P Bt := Algebra.FiniteType.of_restrictScalars_finiteType k P Bt
    haveI : Algebra.FinitePresentation P Bt := Algebra.FinitePresentation.of_finiteType.mp inferInstance

    have hψ₀_inj_deg : ∀ (m : ℕ) (q : P), q.natDegree = m → ψ₀ q = 0 → q = 0 := by
      intro m
      induction m using Nat.strong_induction_on with
      | h m ih =>
        intro q hm hq0
        by_cases hq_z : q = 0
        · exact hq_z
        · rcases Nat.eq_zero_or_pos m with rfl | hm_pos
          · let c_q : k := q.coeff 0
            have hq_C : q = Polynomial.C c_q := Polynomial.eq_C_of_natDegree_eq_zero hm
            rw [hq_C] at hq0 hq_z
            have hc0 : c_q = 0 := by
              have h1 := congrArg κ_Bt hq0
              rw [map_zero] at h1
              change κ_Bt (Polynomial.aeval ϖ₀ (Polynomial.C c_q)) = 0 at h1
              rwa [Polynomial.aeval_C, hκ_k] at h1
            exact absurd (hc0 ▸ Polynomial.C_0) hq_z
          · have hdeg_ne : q.degree ≠ 0 := by
              rw [Polynomial.degree_eq_natDegree hq_z, hm]
              exact mod_cast (by omega : m ≠ 0)
            obtain ⟨c, hc⟩ := IsAlgClosed.exists_root q hdeg_ne
            obtain ⟨q₁, hq₁_fac⟩ := Polynomial.dvd_iff_isRoot.mpr hc
            have hq₁_ne : q₁ ≠ 0 := fun h0 => hq_z (by rw [hq₁_fac, h0, mul_zero])
            have hdeg_sum : q.natDegree = 1 + q₁.natDegree := by
              rw [hq₁_fac, Polynomial.natDegree_mul (Polynomial.monic_X_sub_C c).ne_zero hq₁_ne,
                Polynomial.natDegree_X_sub_C]
            rw [hq₁_fac, map_mul, mul_eq_zero] at hq0
            rcases hq0 with hlin | hq₁_0
            · have hϖ_c : ϖ₀ = algebraMap k Bt c := by
                rw [map_sub] at hlin
                have h1 : ψ₀ Polynomial.X = ϖ₀ := Polynomial.aeval_X ϖ₀
                have h2 : ψ₀ (Polynomial.C c) = algebraMap k Bt c := Polynomial.aeval_C ϖ₀ c
                rw [h1, h2] at hlin
                exact sub_eq_zero.mp hlin
              have hϖ_p : ϖ₀ ∈ p_Bt := by
                have hmem : algebraMap Bt (Localization.AtPrime p_Bt) ϖ₀ ∈
                    IsLocalRing.maximalIdeal (Localization.AtPrime p_Bt) := by
                  rw [h_span_max]
                  exact Ideal.subset_span rfl
                exact (IsLocalization.AtPrime.to_map_mem_maximal_iff _ p_Bt ϖ₀).mp hmem
              have hc0 : c = 0 := by
                have hker : ϖ₀ ∈ RingHom.ker κ_Bt := hκ_ker.symm ▸ hϖ_p
                rw [RingHom.mem_ker, hϖ_c, hκ_k] at hker
                exact hker
              rw [hc0, map_zero] at hϖ_c
              exact absurd hϖ_c hϖ₀_ne
            · exact absurd (ih q₁.natDegree (by omega) q₁ rfl hq₁_0) hq₁_ne

    have hψ₀_inj : Function.Injective ψ₀ :=
      (injective_iff_map_eq_zero ψ₀).mpr fun q hq => hψ₀_inj_deg q.natDegree q rfl hq
    haveI : Module.IsTorsionFree P Bt := Module.isTorsionFree_iff_algebraMap_injective.mpr hψ₀_inj
    haveI : Module.Flat P Bt := inferInstance

    let V_Bt := Localization.AtPrime p_Bt
    haveI : Algebra.EssFiniteType Bt V_Bt := Algebra.EssFiniteType.of_isLocalization V_Bt p_Bt.primeCompl
    haveI : Algebra.EssFiniteType P V_Bt := Algebra.EssFiniteType.comp P Bt V_Bt

    have h_units_κ : ∀ y : p_Bt.primeCompl, IsUnit (κ_Bt y.1) := fun y =>
      IsUnit.mk0 _ (fun h0 => y.2 (hκ_ker ▸ h0))
    let κ₀ : V_Bt →+* k := IsLocalization.lift (M := p_Bt.primeCompl) h_units_κ
    have hκ₀_le_max : RingHom.ker κ₀ ≤ IsLocalRing.maximalIdeal V_Bt :=
      IsLocalRing.le_maximalIdeal (RingHom.ker_ne_top κ₀)
    have hκ₀_C : ∀ c : k, κ₀ (algebraMap P V_Bt (Polynomial.C c)) = c := by
      intro c
      rw [IsScalarTower.algebraMap_apply P Bt V_Bt, IsLocalization.lift_eq h_units_κ]
      change κ_Bt (Polynomial.aeval ϖ₀ (Polynomial.C c)) = c
      rw [Polynomial.aeval_C, hκ_k]
    have hX_V : algebraMap P V_Bt Polynomial.X = algebraMap Bt V_Bt ϖ₀ := by
      rw [IsScalarTower.algebraMap_apply P Bt V_Bt]
      change algebraMap Bt V_Bt (Polynomial.aeval ϖ₀ Polynomial.X) = _
      rw [Polynomial.aeval_X]

    have hSub_V : Subsingleton (Ω[V_Bt ⁄ P]) := by
      have h_top_le : (⊤ : Submodule V_Bt (Ω[V_Bt ⁄ P])) ≤
          (IsLocalRing.maximalIdeal V_Bt) • (⊤ : Submodule V_Bt (Ω[V_Bt ⁄ P])) := by
        conv_lhs => rw [← KaehlerDifferential.span_range_derivation P V_Bt]
        rw [Submodule.span_le]
        rintro _ ⟨v, rfl⟩
        let c := κ₀ v
        have hv_ker : v - algebraMap P V_Bt (Polynomial.C c) ∈ RingHom.ker κ₀ := by
          rw [RingHom.mem_ker, map_sub, hκ₀_C c, sub_self]
        have hv_span : v - algebraMap P V_Bt (Polynomial.C c) ∈
            Ideal.span {algebraMap P V_Bt Polynomial.X} := by
          rw [hX_V, ← h_span_max]
          exact hκ₀_le_max hv_ker
        rw [Ideal.mem_span_singleton] at hv_span
        obtain ⟨w, hw⟩ := hv_span
        have hv_eq : v = algebraMap P V_Bt (Polynomial.C c) + algebraMap P V_Bt Polynomial.X * w :=
          eq_add_of_sub_eq' hw
        rw [hv_eq, map_add, Derivation.map_algebraMap, zero_add, Derivation.leibniz,
          Derivation.map_algebraMap, smul_zero, add_zero]
        have hX_max : algebraMap P V_Bt Polynomial.X ∈ IsLocalRing.maximalIdeal V_Bt := by
          rw [hX_V, h_span_max]
          exact Ideal.subset_span rfl
        exact Submodule.smul_mem_smul hX_max Submodule.mem_top
      have h_fg : (⊤ : Submodule V_Bt (Ω[V_Bt ⁄ P])).FG := Module.Finite.fg_top
      have h_jac : IsLocalRing.maximalIdeal V_Bt ≤ (⊥ : Ideal V_Bt).jacobson :=
        IsLocalRing.maximalIdeal_le_jacobson (⊥ : Ideal V_Bt)
      have h_bot : (⊤ : Submodule V_Bt (Ω[V_Bt ⁄ P])) = ⊥ :=
        Submodule.eq_bot_of_le_smul_of_le_jacobson_bot _ _ h_fg h_top_le h_jac
      refine (subsingleton_iff_forall_eq 0).mpr fun ω => ?_
      have hmem : ω ∈ (⊤ : Submodule V_Bt (Ω[V_Bt ⁄ P])) := Submodule.mem_top
      rw [h_bot, Submodule.mem_bot] at hmem
      exact hmem

    have h_fg_Bt : (⊤ : Submodule Bt (Ω[Bt ⁄ P])).FG := Module.Finite.fg_top
    obtain ⟨S_ω, hS_ω⟩ := h_fg_Bt
    let map_V := KaehlerDifferential.map P P Bt V_Bt
    haveI : IsLocalizedModule p_Bt.primeCompl map_V := inferInstance
    have h_kill_each : ∀ ω : Ω[Bt ⁄ P], ∃ s : p_Bt.primeCompl, s.1 • ω = 0 := by
      intro ω
      have h0 : map_V ω = 0 := Subsingleton.elim _ _
      exact (IsLocalizedModule.eq_zero_iff p_Bt.primeCompl map_V).mp h0
    let s_et : p_Bt.primeCompl := ∏ ω ∈ S_ω, Classical.choose (h_kill_each ω)
    have hs_et_kill_gen : ∀ ω ∈ S_ω, s_et.1 • ω = 0 := by
      intro ω hω
      let s_ω := Classical.choose (h_kill_each ω)
      have hs_ω : s_ω.1 • ω = 0 := Classical.choose_spec (h_kill_each ω)
      rcases Finset.dvd_prod_of_mem (fun x => Classical.choose (h_kill_each x)) hω with ⟨t, ht⟩
      have hval : s_et.1 = t.1 * s_ω.1 := by
        dsimp only [s_et]
        rw [ht, Submonoid.coe_mul, mul_comm]
      rw [hval, mul_smul, hs_ω, smul_zero]
    have hs_et_kill : ∀ ω : Ω[Bt ⁄ P], s_et.1 • ω = 0 := by
      intro ω
      have hmem : ω ∈ Submodule.span Bt (S_ω : Set (Ω[Bt ⁄ P])) := hS_ω ▸ Submodule.mem_top
      refine Submodule.span_induction ?_ ?_ ?_ ?_ hmem
      · intro x hx; exact hs_et_kill_gen x hx
      · exact smul_zero _
      · intro x y _ _ hx hy; rw [smul_add, hx, hy, add_zero]
      · intro a x _ hx; rw [smul_comm, hx, smul_zero]

    refine ⟨s_et.1, s_et.2, fun g_extra _ => ?_⟩
    let f_tot : Bt := s_et.1 * g_extra
    let B_loc := Localization.Away f_tot
    haveI : Module.Flat P B_loc := Module.Flat.trans P Bt B_loc
    haveI : Algebra.FinitePresentation P B_loc := Algebra.FinitePresentation.trans P Bt B_loc
    let map_loc := KaehlerDifferential.map P P Bt B_loc
    haveI : IsLocalizedModule (Submonoid.powers f_tot) map_loc := inferInstance
    have hSub_loc : Subsingleton (Ω[B_loc ⁄ P]) := by
      refine (subsingleton_iff_forall_eq 0).mpr fun ξ => ?_
      obtain ⟨⟨ω, s_pow⟩, hξ⟩ := IsLocalizedModule.surj (Submonoid.powers f_tot) map_loc ξ
      rcases s_pow with ⟨_, m, rfl⟩
      have h_unit : IsUnit (algebraMap Bt B_loc (f_tot ^ (m + 1))) := by
        rw [map_pow]
        exact (IsLocalization.Away.algebraMap_isUnit f_tot).pow (m + 1)
      obtain ⟨u_loc, hu_loc⟩ := h_unit
      have h_zero : u_loc • ξ = 0 := by
        change (u_loc : B_loc) • ξ = 0
        rw [hu_loc, pow_succ', map_mul, mul_smul,
          IsScalarTower.algebraMap_smul, IsScalarTower.algebraMap_smul]
        have hξ' : (f_tot ^ m : Bt) • ξ = map_loc ω := hξ
        rw [hξ', ← map_loc.map_smul]
        have hf_kill : f_tot • ω = 0 := by
          dsimp only [f_tot]
          rw [mul_comm, mul_smul, hs_et_kill ω, smul_zero]
        rw [hf_kill, map_zero]
      simpa using congrArg (u_loc⁻¹ • ·) h_zero
    haveI : Algebra.FormallyUnramified P B_loc := ⟨hSub_loc⟩
    haveI : Algebra.Etale P B_loc := Algebra.Etale.of_formallyUnramified_of_flat
    have h_alg_eq : (algebraMap Bt B_loc).comp ψ₀ = algebraMap P B_loc :=
      RingHom.ext fun q => (IsScalarTower.algebraMap_apply P Bt B_loc q).symm
    rw [h_alg_eq]
    exact RingHom.etale_algebraMap.mpr inferInstance

  have hEtaleCompRingHom : ∀ (R₁ R₂ R₃ : Type u) [CommRing R₁] [CommRing R₂] [CommRing R₃]
      (f : R₁ →+* R₂) (g : R₂ →+* R₃),
      @RingHom.Etale R₁ R₂ _ _ f →
      @RingHom.Etale R₂ R₃ _ _ g →
      @RingHom.Etale R₁ R₃ _ _ (g.comp f) := by
    intro R₁ R₂ R₃ _ _ _ f g hf hg
    letI : Algebra R₁ R₂ := f.toAlgebra
    letI : Algebra R₂ R₃ := g.toAlgebra
    letI : Algebra R₁ R₃ := (g.comp f).toAlgebra
    haveI : IsScalarTower R₁ R₂ R₃ := IsScalarTower.of_algebraMap_eq' rfl
    haveI : Algebra.Etale R₁ R₂ := RingHom.etale_algebraMap.mp hf
    haveI : Algebra.Etale R₂ R₃ := RingHom.etale_algebraMap.mp hg
    haveI : Algebra.Etale R₁ R₃ := Algebra.Etale.comp R₁ R₂ R₃
    exact RingHom.etale_algebraMap.mpr inferInstance

  have hKummerPushoutEtale :
      ∀ (B₀ : Type u) [CommRing B₀] (ψ₀ : P →+* B₀), @RingHom.Etale P B₀ _ _ ψ₀ →
        let Q₀ : Polynomial B₀ := Polynomial.X ^ ℓ - Polynomial.C (ψ₀ Polynomial.X)
        @RingHom.Etale P (AdjoinRoot Q₀) _ _
          (Polynomial.eval₂RingHom ((AdjoinRoot.of Q₀).comp (ψ₀.comp Polynomial.C))
            (AdjoinRoot.root Q₀)) := by
    intro B₀ _ ψ₀ hψ₀ Q₀
    let M₁ := MvPolynomial (Fin 1) k
    let κ_mv : P →+* M₁ := (Polynomial.aeval (MvPolynomial.X 0 ^ ℓ : M₁)).toRingHom
    letI : Algebra P M₁ := κ_mv.toAlgebra
    letI : Algebra P B₀ := ψ₀.toAlgebra
    haveI : Algebra.Etale P B₀ := RingHom.etale_algebraMap.mp hψ₀
    haveI : Algebra.Etale M₁ (TensorProduct P M₁ B₀) := inferInstance

    have h_root_pow : (AdjoinRoot.root Q₀) ^ ℓ = AdjoinRoot.of Q₀ (ψ₀ Polynomial.X) := by
      have h1 := AdjoinRoot.eval₂_root Q₀
      dsimp only [Q₀] at h1
      rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C] at h1
      exact sub_eq_zero.mp h1

    let g_mv_ring : M₁ →+* AdjoinRoot Q₀ :=
      MvPolynomial.eval₂Hom ((AdjoinRoot.of Q₀).comp (ψ₀.comp Polynomial.C))
        (fun _ => AdjoinRoot.root Q₀)
    have hg_mv_comm : ∀ p : P, g_mv_ring (algebraMap P M₁ p) = algebraMap P (AdjoinRoot Q₀) p := by
      have h_eq : g_mv_ring.comp κ_mv = (AdjoinRoot.of Q₀).comp ψ₀ := by
        apply Polynomial.ringHom_ext'
        · ext c
          change g_mv_ring (Polynomial.aeval (MvPolynomial.X 0 ^ ℓ : M₁) (Polynomial.C c)) =
            AdjoinRoot.of Q₀ (ψ₀ (Polynomial.C c))
          rw [Polynomial.aeval_C]
          exact MvPolynomial.eval₂Hom_C _ _ c
        · change g_mv_ring (Polynomial.aeval (MvPolynomial.X 0 ^ ℓ : M₁) Polynomial.X) =
            AdjoinRoot.of Q₀ (ψ₀ Polynomial.X)
          rw [Polynomial.aeval_X, map_pow]
          have hX_mv : g_mv_ring (MvPolynomial.X 0) = AdjoinRoot.root Q₀ :=
            MvPolynomial.eval₂Hom_X' _ _ 0
          rw [hX_mv, h_root_pow]
      intro p
      rw [IsScalarTower.algebraMap_apply P B₀ (AdjoinRoot Q₀)]
      exact RingHom.congr_fun h_eq p
    let g_mv_alg : M₁ →ₐ[P] AdjoinRoot Q₀ := { g_mv_ring with commutes' := hg_mv_comm }
    let of_alg : B₀ →ₐ[P] AdjoinRoot Q₀ :=
      { AdjoinRoot.of Q₀ with
        commutes' := fun p => (IsScalarTower.algebraMap_apply P B₀ (AdjoinRoot Q₀) p).symm }
    let fwd_alg : TensorProduct P M₁ B₀ →ₐ[P] AdjoinRoot Q₀ :=
      Algebra.TensorProduct.lift g_mv_alg of_alg (fun _ _ => mul_comm _ _)
    let fwd : TensorProduct P M₁ B₀ →+* AdjoinRoot Q₀ := fwd_alg.toRingHom
    have hfwd_tmul : ∀ (m : M₁) (b : B₀),
        fwd (m ⊗ₜ[P] b) = g_mv_ring m * AdjoinRoot.of Q₀ b :=
      fun m b => Algebra.TensorProduct.lift_tmul g_mv_alg of_alg (fun _ _ => mul_comm _ _) m b

    let inr_ring : B₀ →+* TensorProduct P M₁ B₀ :=
      { toFun := fun b => (1 : M₁) ⊗ₜ[P] b
        map_one' := rfl
        map_mul' := fun _ _ => by simp
        map_zero' := TensorProduct.tmul_zero _ _
        map_add' := fun _ _ => TensorProduct.tmul_add _ _ _ }
    have h_tmul_pow :
        Polynomial.eval₂ inr_ring
          (MvPolynomial.X 0 ⊗ₜ[P] (1 : B₀)) Q₀ = 0 := by
      dsimp only [Q₀]
      rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C,
        Algebra.TensorProduct.tmul_pow, one_pow]
      have hκX : MvPolynomial.X 0 ^ ℓ = algebraMap P M₁ Polynomial.X := by
        change MvPolynomial.X 0 ^ ℓ = Polynomial.aeval (MvPolynomial.X 0 ^ ℓ : M₁) Polynomial.X
        rw [Polynomial.aeval_X]
      have hψX : ψ₀ Polynomial.X = algebraMap P B₀ Polynomial.X := rfl
      have hinr : inr_ring (algebraMap P B₀ Polynomial.X) =
          (1 : M₁) ⊗ₜ[P] (algebraMap P B₀ Polynomial.X) := rfl
      rw [hκX, hψX, hinr, Algebra.algebraMap_eq_smul_one, Algebra.algebraMap_eq_smul_one,
        TensorProduct.smul_tmul]
      exact sub_self _
    let bwd : AdjoinRoot Q₀ →+* TensorProduct P M₁ B₀ :=
      AdjoinRoot.lift inr_ring
        (MvPolynomial.X 0 ⊗ₜ[P] (1 : B₀)) h_tmul_pow

    have h_fb : fwd.comp bwd = RingHom.id (AdjoinRoot Q₀) := by
      apply AdjoinRoot.ringHom_ext
      · ext b
        change fwd (bwd (AdjoinRoot.of Q₀ b)) = AdjoinRoot.of Q₀ b
        rw [AdjoinRoot.lift_of]
        change fwd ((1 : M₁) ⊗ₜ[P] b) = AdjoinRoot.of Q₀ b
        rw [hfwd_tmul, map_one, one_mul]
      · change fwd (bwd (AdjoinRoot.root Q₀)) = AdjoinRoot.root Q₀
        rw [AdjoinRoot.lift_root, hfwd_tmul, map_one, mul_one]
        exact MvPolynomial.eval₂Hom_X' _ _ 0
    have h_bf : bwd.comp fwd = RingHom.id (TensorProduct P M₁ B₀) := by
      have h_left : ∀ m : M₁, bwd (fwd (m ⊗ₜ[P] (1 : B₀))) = m ⊗ₜ[P] (1 : B₀) := by
        intro m
        induction m using MvPolynomial.induction_on with
        | C c =>
          rw [hfwd_tmul, map_one, mul_one]
          have hC_eval : g_mv_ring (MvPolynomial.C c) = AdjoinRoot.of Q₀ (ψ₀ (Polynomial.C c)) :=
            MvPolynomial.eval₂Hom_C _ _ c
          rw [hC_eval, AdjoinRoot.lift_of]
          change (1 : M₁) ⊗ₜ[P] (ψ₀ (Polynomial.C c)) = (MvPolynomial.C c : M₁) ⊗ₜ[P] (1 : B₀)
          have h1 : ψ₀ (Polynomial.C c) = algebraMap P B₀ (Polynomial.C c) := rfl
          have h2 : (MvPolynomial.C c : M₁) = algebraMap P M₁ (Polynomial.C c) := by
            change MvPolynomial.C c = Polynomial.aeval (MvPolynomial.X 0 ^ ℓ : M₁) (Polynomial.C c)
            rw [Polynomial.aeval_C]; rfl
          rw [h1, h2, Algebra.algebraMap_eq_smul_one, Algebra.algebraMap_eq_smul_one,
            TensorProduct.smul_tmul]
        | add p₁ p₂ hp₁ hp₂ =>
          rw [TensorProduct.add_tmul, map_add, map_add, hp₁, hp₂]
        | mul_X p₁ i hp₁ =>
          have hi0 : i = 0 := Subsingleton.elim i 0
          subst hi0
          have hmul : (p₁ * MvPolynomial.X 0) ⊗ₜ[P] (1 : B₀) =
              (p₁ ⊗ₜ[P] (1 : B₀)) * (MvPolynomial.X 0 ⊗ₜ[P] (1 : B₀)) := by simp
          rw [hmul, map_mul, map_mul, hp₁, hfwd_tmul, map_one, mul_one]
          have hX_eval : g_mv_ring (MvPolynomial.X 0) = AdjoinRoot.root Q₀ :=
            MvPolynomial.eval₂Hom_X' _ _ 0
          rw [hX_eval, AdjoinRoot.lift_root]
      apply RingHom.ext
      intro x
      change bwd (fwd x) = x
      induction x using TensorProduct.induction_on with
      | zero => rw [map_zero, map_zero]
      | tmul m b =>
        have hm : m ⊗ₜ[P] b = (m ⊗ₜ[P] (1 : B₀)) * ((1 : M₁) ⊗ₜ[P] b) := by simp
        rw [hm, map_mul, map_mul, h_left m]
        have h2 : bwd (fwd ((1 : M₁) ⊗ₜ[P] b)) = (1 : M₁) ⊗ₜ[P] b := by
          rw [hfwd_tmul, map_one, one_mul, AdjoinRoot.lift_of]
          rfl
        rw [h2]
      | add x₁ y₁ hx₁ hy₁ => rw [map_add, map_add, hx₁, hy₁]

    have h_fwd_bij : Function.Bijective fwd :=
      ⟨Function.HasLeftInverse.injective ⟨bwd, RingHom.congr_fun h_bf⟩,
       Function.HasRightInverse.surjective ⟨bwd, RingHom.congr_fun h_fb⟩⟩
    let e_mv : P ≃+* M₁ := (MvPolynomial.uniqueAlgEquiv k (Fin 1)).symm.toRingEquiv
    have h_et1 : @RingHom.Etale P M₁ _ _ e_mv.toRingHom :=
      RingHom.Etale.of_bijective e_mv.bijective
    have h_et2 : @RingHom.Etale M₁ (TensorProduct P M₁ B₀) _ _
        (algebraMap M₁ (TensorProduct P M₁ B₀)) :=
      RingHom.etale_algebraMap.mpr inferInstance
    have h_et3 : @RingHom.Etale (TensorProduct P M₁ B₀) (AdjoinRoot Q₀) _ _ fwd :=
      RingHom.Etale.of_bijective h_fwd_bij
    have h_et_comp :
        @RingHom.Etale P (AdjoinRoot Q₀) _ _
          (fwd.comp ((algebraMap M₁ (TensorProduct P M₁ B₀)).comp e_mv.toRingHom)) :=
      hEtaleCompRingHom P (TensorProduct P M₁ B₀) (AdjoinRoot Q₀) _ fwd
        (hEtaleCompRingHom P M₁ (TensorProduct P M₁ B₀) _ _ h_et1 h_et2) h_et3
    have halg_l : ∀ m : M₁, algebraMap M₁ (TensorProduct P M₁ B₀) m = m ⊗ₜ[P] (1 : B₀) :=
      fun _ => rfl
    have h_eq_hom :
        Polynomial.eval₂RingHom ((AdjoinRoot.of Q₀).comp (ψ₀.comp Polynomial.C))
          (AdjoinRoot.root Q₀) =
        fwd.comp ((algebraMap M₁ (TensorProduct P M₁ B₀)).comp e_mv.toRingHom) := by
      apply Polynomial.ringHom_ext'
      · ext c
        rw [RingHom.comp_apply, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C,
          RingHom.comp_apply, RingHom.comp_apply, RingHom.comp_apply,
          RingHom.comp_apply, RingHom.comp_apply]
        have he_C : e_mv.toRingHom (Polynomial.C c) = MvPolynomial.C c :=
          (MvPolynomial.uniqueAlgEquiv k (Fin 1)).symm.commutes c
        rw [he_C, halg_l, hfwd_tmul, map_one, mul_one]
        dsimp only [g_mv_ring]
        rw [MvPolynomial.eval₂Hom_C]
        rfl
      · rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X,
          RingHom.comp_apply, RingHom.comp_apply]
        have he_X : e_mv.toRingHom Polynomial.X = MvPolynomial.X 0 := by
          apply (MvPolynomial.uniqueAlgEquiv k (Fin 1)).injective
          change (MvPolynomial.uniqueAlgEquiv k (Fin 1))
            ((MvPolynomial.uniqueAlgEquiv k (Fin 1)).symm Polynomial.X) = _
          simp
        rw [he_X, halg_l, hfwd_tmul, map_one, mul_one]
        dsimp only [g_mv_ring]
        rw [MvPolynomial.eval₂Hom_X']
    rwa [h_eq_hom]

  have hEtaleFinGenK : ∀ (B₀ : Type u) [CommRing B₀] (ψ₀ : P →+* B₀),
      @RingHom.Etale P B₀ _ _ ψ₀ →
      ∃ S₀ : Finset B₀, ∀ (R' : Subring B₀),
        Set.range (ψ₀.comp Polynomial.C) ⊆ (R' : Set B₀) →
        (S₀ : Set B₀) ⊆ (R' : Set B₀) →
        R' = ⊤ := by
    intro B₀ _ ψ₀ hψ₀
    letI : Algebra P B₀ := ψ₀.toAlgebra
    letI : Algebra k B₀ := (ψ₀.comp Polynomial.C).toAlgebra
    haveI : IsScalarTower k P B₀ := IsScalarTower.of_algebraMap_eq' rfl
    haveI : Algebra.Etale P B₀ := RingHom.etale_algebraMap.mp hψ₀
    haveI : Algebra.FiniteType k B₀ :=
      Algebra.FiniteType.trans
        (inferInstance : Algebra.FiniteType k P)
        (inferInstance : Algebra.FiniteType P B₀)
    obtain ⟨S₀, hS₀⟩ := Algebra.FiniteType.out (R := k) (A := B₀)
    refine ⟨S₀, fun R' hR'_k hR'_S => ?_⟩
    let A' : Subalgebra k B₀ := { R' with algebraMap_mem' := fun c => hR'_k ⟨c, rfl⟩ }
    have htop : A' = ⊤ := top_unique (hS₀ ▸ Algebra.adjoin_le hR'_S)
    ext x
    change x ∈ A' ↔ True
    rw [htop]
    simp

  have hEtaleCompEquiv : ∀ (B₀ B₁_t : Type u) [CommRing B₀] [CommRing B₁_t]
      (ψ₀ : P →+* B₀) (e₀ : B₀ ≃+* B₁_t),
      @RingHom.Etale P B₀ _ _ ψ₀ →
      @RingHom.Etale P B₁_t _ _ (e₀.toRingHom.comp ψ₀) := by
    intro B₀ B₁_t _ _ ψ₀ e₀ hψ₀
    have he_et : e₀.toRingHom.Etale := RingHom.Etale.of_bijective e₀.bijective
    letI : Algebra P B₀ := ψ₀.toAlgebra
    letI : Algebra B₀ B₁_t := e₀.toRingHom.toAlgebra
    letI : Algebra P B₁_t := (e₀.toRingHom.comp ψ₀).toAlgebra
    haveI : IsScalarTower P B₀ B₁_t := IsScalarTower.of_algebraMap_eq' rfl
    haveI : Algebra.Etale P B₀ := RingHom.etale_algebraMap.mp hψ₀
    haveI : Algebra.Etale B₀ B₁_t := RingHom.etale_algebraMap.mp he_et
    haveI : Algebra.Etale P B₁_t := Algebra.Etale.comp P B₀ B₁_t
    exact RingHom.etale_algebraMap.mpr inferInstance

  
  
  
  
  letI : Algebra P R_bar := p_R.toAlgebra
  let IsGoodStage (B : Subalgebra P R_bar) : Prop :=
    ∃ (ϖ : ↥B) (u : (↥B)ˣ) (e : ℕ) (ψ : Polynomial k →+* ↥B),
      1 ≤ e ∧
      B.val ϖ ∈ IsLocalRing.maximalIdeal R_bar ∧
      algebraMap P ↥B Polynomial.X = ↑u * ϖ ^ e ∧
      ψ.comp Polynomial.C = (algebraMap P ↥B).comp Polynomial.C ∧
      ψ Polynomial.X = ϖ ∧
      @RingHom.Etale P ↥B _ _ ψ ∧
      (∀ c : ↥B, c ≠ 0 → ∃ (n : ℕ) (v : R_barˣ), B.val c = ↑v * (B.val ϖ) ^ n)

  have h_dedekind_norm : ∀ F : Finset R_bar,
      ∃ (Bt : Type u) (_ : CommRing Bt) (_ : IsDomain Bt) (_ : IsDedekindDomain Bt)
        (_ : Algebra k Bt) (_ : Algebra.FiniteType k Bt)
        (ι_Bt : Bt →+* R_bar) (p_to_Bt : P →+* Bt),
        Function.Injective ι_Bt ∧
        ι_Bt.comp p_to_Bt = p_R ∧
        (∀ c : k, p_to_Bt (Polynomial.C c) = algebraMap k Bt c) ∧
        (∀ w ∈ F, ∃ (x_num x_den : Bt), IsUnit (ι_Bt x_den) ∧ w * ι_Bt x_den = ι_Bt x_num) := by
    intro F
    let a_of := fun w : R_bar => Classical.choose (h_intFrac w)
    let s_of := fun w : R_bar => Classical.choose (Classical.choose_spec (h_intFrac w))
    have hs_spec : ∀ w : R_bar,
        _root_.IsIntegral P (φ_R_Ω (a_of w)) ∧
        _root_.IsIntegral P (φ_R_Ω (s_of w)) ∧
        IsUnit (s_of w) ∧ w * s_of w = a_of w :=
      fun w => Classical.choose_spec (Classical.choose_spec (h_intFrac w))
    let S_R : Finset R_bar := F.image a_of ∪ F.image s_of
    let S_Ω : Finset Ω := S_R.image φ_R_Ω
    have hS_Ω_int : ∀ z ∈ S_Ω, _root_.IsIntegral P z := by
      intro z hz
      rcases Finset.mem_image.mp hz with ⟨r, hr, rfl⟩
      rcases Finset.mem_union.mp hr with ha | hs
      · rcases Finset.mem_image.mp ha with ⟨w, _, rfl⟩
        exact (hs_spec w).1
      · rcases Finset.mem_image.mp hs with ⟨w, _, rfl⟩
        exact (hs_spec w).2.1

    obtain ⟨p, _⟩ := ExpChar.exists k
    have hp_pos : 0 < p := expChar_pos k p
    haveI : PerfectField k := IsAlgClosed.perfectField k
    haveI : PerfectRing k p := PerfectField.toPerfectRing p
    haveI : ExpChar P p := expChar_of_injective_algebraMap Polynomial.C_injective p
    haveI : ExpChar K₀ p := expChar_of_injective_algebraMap (IsFractionRing.injective P K₀) p
    haveI : ExpChar Ω p := expChar_of_injective_algebraMap (RingHom.injective (algebraMap K₀ Ω)) p

    let L₀ : IntermediateField K₀ Ω := IntermediateField.adjoin K₀ (S_Ω : Set Ω)
    haveI : FiniteDimensional K₀ ↥L₀ :=
      IntermediateField.finiteDimensional_adjoin fun x _ =>
        (Algebra.IsAlgebraic.isAlgebraic (R := K₀) x).isIntegral
    let M_sep : IntermediateField K₀ ↥L₀ := separableClosure K₀ ↥L₀
    haveI : ExpChar ↥M_sep p :=
      expChar_of_injective_algebraMap (RingHom.injective (algebraMap K₀ ↥M_sep)) p

    have hexp_each : ∀ (z : Ω) (hz : z ∈ S_Ω),
        ∃ m : ℕ, (⟨z, IntermediateField.subset_adjoin K₀ (S_Ω : Set Ω) hz⟩ : ↥L₀) ^ (p ^ m) ∈ M_sep := by
      intro z hz
      let z_L : ↥L₀ := ⟨z, IntermediateField.subset_adjoin K₀ (S_Ω : Set Ω) hz⟩
      obtain ⟨m, y_M, hy_M⟩ := IsPurelyInseparable.pow_mem ↥M_sep p z_L
      exact ⟨m, hy_M ▸ y_M.2⟩
    let m_of : Ω → ℕ := fun z => if hz : z ∈ S_Ω then Classical.choose (hexp_each z hz) else 0
    let n : ℕ := S_Ω.sup m_of
    have hSep_K₀ : ∀ z ∈ S_Ω, IsSeparable K₀ (z ^ (p ^ n)) := by
      intro z hz
      let z_L : ↥L₀ := ⟨z, IntermediateField.subset_adjoin K₀ (S_Ω : Set Ω) hz⟩
      let m := m_of z
      have hm_le : m ≤ n := Finset.le_sup (f := m_of) hz
      have hm_mem : z_L ^ (p ^ m) ∈ M_sep := by
        dsimp only [m, m_of]; rw [dif_pos hz]; exact Classical.choose_spec (hexp_each z hz)
      have hn_mem : z_L ^ (p ^ n) ∈ M_sep := by
        have hexp : p ^ n = p ^ m * p ^ (n - m) := by rw [← pow_add, Nat.add_sub_of_le hm_le]
        rw [hexp, pow_mul]; exact M_sep.toSubalgebra.pow_mem hm_mem (p ^ (n - m))
      let w_M : ↥M_sep := ⟨z_L ^ (p ^ n), hn_mem⟩
      have hw_sep : IsSeparable K₀ w_M := Algebra.IsSeparable.isSeparable K₀ w_M
      have hmap : (L₀.val.comp M_sep.val) w_M = z ^ (p ^ n) := rfl
      rw [← hmap]
      exact hw_sep.map (L₀.val.comp M_sep.val) (L₀.val.injective.comp M_sep.val.injective)

    obtain ⟨t_n, _, ht_n_pow⟩ := hRootPow (p ^ n) t_bar (Nat.pow_pos hp_pos) ht_max
    let τ_n : Ω := φ_R_Ω t_n
    have hτ_n_pow : τ_n ^ (p ^ n) = algebraMap P Ω Polynomial.X := by
      dsimp only [τ_n]
      rw [← map_pow, ht_n_pow, ← ht_eq]
      exact RingHom.congr_fun hφ_pR Polynomial.X
    have hτ_n_int : _root_.IsIntegral P τ_n := by
      refine ⟨Polynomial.X ^ (p ^ n) - Polynomial.C Polynomial.X,
        Polynomial.monic_X_pow_sub_C Polynomial.X (Nat.pow_pos hp_pos).ne', ?_⟩
      rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, hτ_n_pow, sub_self]

    let ι_n_alg : P →ₐ[k] Ω := Polynomial.aeval (R := k) (A := Ω) τ_n
    let ι_n : P →+* Ω := ι_n_alg.toRingHom
    have hι_frob : (iterateFrobenius Ω p n).comp ι_n =
        (algebraMap P Ω).comp (Polynomial.mapRingHom (iterateFrobenius k p n)) := by
      apply Polynomial.ringHom_ext'
      · ext c
        change (Polynomial.aeval τ_n (Polynomial.C c)) ^ (p ^ n) =
          algebraMap P Ω (Polynomial.map (iterateFrobenius k p n) (Polynomial.C c))
        rw [Polynomial.aeval_C, Polynomial.map_C]
        simp only [iterateFrobenius_def]
        have h1 : algebraMap P Ω (Polynomial.C (c ^ (p ^ n))) = algebraMap k Ω (c ^ (p ^ n)) := rfl
        rw [h1, map_pow]
      · change (Polynomial.aeval τ_n Polynomial.X) ^ (p ^ n) =
          algebraMap P Ω (Polynomial.map (iterateFrobenius k p n) Polynomial.X)
        rw [Polynomial.aeval_X, Polynomial.map_X]
        exact hτ_n_pow

    have hι_n_inj : Function.Injective ι_n := by
      have h_rhs_inj : Function.Injective
          ((algebraMap P Ω).comp (Polynomial.mapRingHom (iterateFrobenius k p n))) :=
        hinj_PΩ.comp (Polynomial.map_injective _ (RingHom.injective _))
      intro x y hxy
      apply h_rhs_inj
      rw [← hι_frob]
      exact congrArg (iterateFrobenius Ω p n) hxy

    have hP_as_pow : ∀ f : P, ∃ f_t : P, (f = 0 ↔ f_t = 0) ∧ (ι_n f_t) ^ (p ^ n) = algebraMap P Ω f := by
      intro f
      let φ_inv : k →+* k := (iterateFrobeniusEquiv k p n).symm.toRingHom
      let f_t : P := f.map φ_inv
      have h_zero_iff : f = 0 ↔ f_t = 0 :=
        ⟨fun h => by dsimp only [f_t]; rw [h, Polynomial.map_zero],
         fun h => Polynomial.map_injective φ_inv (iterateFrobeniusEquiv k p n).symm.injective
           (by dsimp only [f_t] at h; rw [h, Polynomial.map_zero])⟩
      have h_pow : (ι_n f_t) ^ (p ^ n) = algebraMap P Ω f := by
        change ((iterateFrobenius Ω p n).comp ι_n) f_t = algebraMap P Ω f
        rw [hι_frob, RingHom.comp_apply, Polynomial.coe_mapRingHom]
        dsimp only [f_t]; rw [Polynomial.map_map]
        have h_id : (iterateFrobenius k p n).comp φ_inv = RingHom.id k :=
          RingHom.ext (iterateFrobeniusEquiv k p n).apply_symm_apply
        rw [h_id, Polynomial.map_id]
      exact ⟨f_t, h_zero_iff, h_pow⟩

    let A_n : Subalgebra k Ω := ι_n_alg.range
    let e_An : P ≃ₐ[k] ↥A_n := AlgEquiv.ofInjective ι_n_alg hι_n_inj
    haveI : IsPrincipalIdealRing ↥A_n :=
      IsPrincipalIdealRing.of_surjective e_An.toRingEquiv.toRingHom e_An.surjective
    haveI : IsDedekindDomain ↥A_n := inferInstance
    haveI : Algebra.FiniteType k ↥A_n := Algebra.FiniteType.equiv inferInstance e_An

    let B_int : Subalgebra P Ω := integralClosure P Ω
    have hAn_sub_Bint : ∀ a : ↥A_n, _root_.IsIntegral P (a : Ω) := by
      intro a
      rcases a.2 with ⟨q, hq⟩
      let τ_B : ↥B_int := ⟨τ_n, hτ_n_int⟩
      let b_q : ↥B_int := Polynomial.eval₂ ((algebraMap P ↥B_int).comp Polynomial.C) τ_B q
      have h_eq : (a : Ω) = (b_q : Ω) := by
        rw [← hq]
        change Polynomial.eval₂ (algebraMap k Ω) τ_n q = B_int.val.toRingHom b_q
        dsimp only [b_q]
        rw [Polynomial.hom_eval₂]
        congr 1
      rw [h_eq]
      exact b_q.2

    have hP_in_An : ∀ q : P, algebraMap P Ω q ∈ A_n := by
      intro q
      refine ⟨q.comp (Polynomial.X ^ (p ^ n)), ?_⟩
      change Polynomial.aeval τ_n (q.comp (Polynomial.X ^ (p ^ n))) = algebraMap P Ω q
      rw [Polynomial.aeval_comp, map_pow, Polynomial.aeval_X, hτ_n_pow]
      exact AlgHom.congr_fun
        (Polynomial.algHom_ext (f := Polynomial.aeval (algebraMap P Ω Polynomial.X))
          (g := IsScalarTower.toAlgHom k P Ω)
          (Polynomial.aeval_X (algebraMap P Ω Polynomial.X))) q

    let K_n := FractionRing ↥A_n
    let j_Kn_Ω : K_n →+* Ω :=
      IsFractionRing.lift (A := ↥A_n) (K := K_n) (g := A_n.val.toRingHom) Subtype.val_injective
    let instAlgKnΩ : Algebra K_n Ω := j_Kn_Ω.toAlgebra
    letI : Algebra K_n Ω := instAlgKnΩ
    letI : SMul K_n Ω := instAlgKnΩ.toSMul
    letI : SMul ↥A_n Ω := (inferInstance : Algebra ↥A_n Ω).toSMul
    haveI : IsScalarTower ↥A_n K_n Ω :=
      IsScalarTower.of_algebraMap_eq fun a =>
        (IsFractionRing.lift_algebraMap (K := K_n) (g := A_n.val.toRingHom)
          Subtype.val_injective a).symm
    haveI : ExpChar ↥A_n p := expChar_of_injective_algebraMap (algebraMap k ↥A_n).injective p
    haveI : ExpChar K_n p := expChar_of_injective_algebraMap (IsFractionRing.injective ↥A_n K_n) p

    have hK₀_as_pow : ∀ r : K₀, ∃ u : K_n, algebraMap K_n Ω (u ^ (p ^ n)) = algebraMap K₀ Ω r := by
      intro r
      obtain ⟨⟨f₁, s₂⟩, hr_mk⟩ := IsLocalization.mk'_surjective (nonZeroDivisors P) r
      dsimp only at hr_mk
      obtain ⟨f₁_t, _, hf₁_pow⟩ := hP_as_pow f₁
      obtain ⟨s₂_t, hs₂_z, hs₂_pow⟩ := hP_as_pow s₂.1
      have hs₂_ne : s₂.1 ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s₂.2
      have hs₂_t_ne : s₂_t ≠ 0 := fun h0 => hs₂_ne (hs₂_z.mpr h0)
      let a₁ : ↥A_n := ⟨ι_n f₁_t, f₁_t, rfl⟩
      let a₂ : ↥A_n := ⟨ι_n s₂_t, s₂_t, rfl⟩
      let u : K_n := algebraMap ↥A_n K_n a₁ * (algebraMap ↥A_n K_n a₂)⁻¹
      refine ⟨u, ?_⟩
      have h_alg_An : ∀ a : ↥A_n, algebraMap K_n Ω (algebraMap ↥A_n K_n a) = (a : Ω) := fun a => by
        rw [← IsScalarTower.algebraMap_apply ↥A_n K_n Ω]; rfl
      rw [mul_pow, inv_pow, map_mul, map_inv₀, map_pow, map_pow, h_alg_An a₁, h_alg_An a₂]
      change (ι_n f₁_t) ^ (p ^ n) * ((ι_n s₂_t) ^ (p ^ n))⁻¹ = algebraMap K₀ Ω r
      rw [hf₁_pow, hs₂_pow, ← hr_mk,
        IsScalarTower.algebraMap_apply P K₀ Ω f₁,
        IsScalarTower.algebraMap_apply P K₀ Ω s₂.1,
        ← map_inv₀, ← map_mul]
      congr 1
      rw [IsLocalization.mk'_eq_mul_mk'_one]
      congr 1
      have hs₂_K₀_ne : algebraMap P K₀ s₂.1 ≠ 0 :=
        fun h0 => hs₂_ne ((IsFractionRing.injective P K₀) (h0.trans (map_zero _).symm))
      apply mul_right_cancel₀ hs₂_K₀_ne
      rw [inv_mul_cancel₀ hs₂_K₀_ne, IsLocalization.mk'_spec, map_one]

    have hSep_Kn : ∀ z ∈ (S_Ω : Set Ω), IsSeparable K_n z := by
      intro z hz
      have hz_fin : z ∈ S_Ω := hz
      let g₀ : Polynomial K₀ := minpoly K₀ (z ^ (p ^ n))
      have hg₀_sep : g₀.Separable := hSep_K₀ z hz_fin
      let u_coeff : ℕ → K_n := fun i =>
        if i ≤ g₀.natDegree then Classical.choose (hK₀_as_pow (g₀.coeff i)) else 0
      have hu_coeff : ∀ i ≤ g₀.natDegree,
          algebraMap K_n Ω ((u_coeff i) ^ (p ^ n)) = algebraMap K₀ Ω (g₀.coeff i) := by
        intro i hi; dsimp only [u_coeff]; rw [if_pos hi]
        exact Classical.choose_spec (hK₀_as_pow (g₀.coeff i))
      let g_t : Polynomial K_n :=
        ∑ i ∈ Finset.range (g₀.natDegree + 1), Polynomial.C (u_coeff i) * Polynomial.X ^ i
      have hg_map_eq :
          (g_t.map (iterateFrobenius K_n p n)).map (algebraMap K_n Ω) =
          g₀.map (algebraMap K₀ Ω) := by
        ext i
        rw [Polynomial.coeff_map, Polynomial.coeff_map, Polynomial.coeff_map]
        dsimp only [g_t]
        rw [Polynomial.finset_sum_coeff]
        simp only [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, mul_ite, mul_one, mul_zero,
          Finset.sum_ite_eq, Finset.mem_range]
        by_cases hi : i < g₀.natDegree + 1
        · rw [if_pos hi]; exact hu_coeff i (Nat.lt_succ_iff.mp hi)
        · rw [if_neg hi, map_zero, map_zero,
            Polynomial.coeff_eq_zero_of_natDegree_lt (by omega), map_zero]
      have hg_t_sep : g_t.Separable := by
        have h1 : (g₀.map (algebraMap K₀ Ω)).Separable :=
          (Polynomial.separable_map (algebraMap K₀ Ω)).mpr hg₀_sep
        rw [← hg_map_eq] at h1
        exact (Polynomial.separable_map (iterateFrobenius K_n p n)).mp
          ((Polynomial.separable_map (algebraMap K_n Ω)).mp h1)
      have hg_t_eval : Polynomial.aeval z g_t = 0 := by
        have hpow0 : (Polynomial.aeval z g_t) ^ (p ^ n) = 0 := by
          change iterateFrobenius Ω p n (Polynomial.eval₂ (algebraMap K_n Ω) z g_t) = 0
          rw [Polynomial.hom_eval₂]
          have h_comm : (iterateFrobenius Ω p n).comp (algebraMap K_n Ω) =
              (algebraMap K_n Ω).comp (iterateFrobenius K_n p n) := by
            ext x; simp [iterateFrobenius_def, map_pow]
          have h_z : iterateFrobenius Ω p n z = z ^ (p ^ n) := rfl
          rw [h_comm, h_z, ← Polynomial.eval₂_map, Polynomial.eval₂_eq_eval_map,
            hg_map_eq, ← Polynomial.eval₂_eq_eval_map]
          exact minpoly.aeval K₀ (z ^ (p ^ n))
        by_contra hne
        exact pow_ne_zero (p ^ n) hne hpow0
      exact hg_t_sep.of_dvd (minpoly.dvd K_n z hg_t_eval)

    have hInt_An : ∀ z ∈ (S_Ω : Set Ω), _root_.IsIntegral ↥A_n z := by
      intro z hz
      obtain ⟨Q, hQ_monic, hQ_eval⟩ := hS_Ω_int z hz
      let Q_An : Polynomial ↥A_n :=
        Q.map { toFun := fun q => ⟨algebraMap P Ω q, hP_in_An q⟩
                map_one' := Subtype.ext (map_one _)
                map_mul' := fun x y => Subtype.ext (map_mul _ x y)
                map_zero' := Subtype.ext (map_zero _)
                map_add' := fun x y => Subtype.ext (map_add _ x y) }
      refine ⟨Q_An, hQ_monic.map _, ?_⟩
      dsimp only [Q_An]; rw [Polynomial.eval₂_map]; exact hQ_eval

    let E : IntermediateField K_n Ω := IntermediateField.adjoin K_n (S_Ω : Set Ω)
    haveI : Algebra.IsSeparable K_n ↥E :=
      (IntermediateField.isSeparable_adjoin_iff_isSeparable K_n Ω).mpr hSep_Kn
    haveI : FiniteDimensional K_n ↥E :=
      IntermediateField.finiteDimensional_adjoin fun z hz =>
        _root_.IsIntegral.tower_top (R := ↥A_n) (hInt_An z hz)

    let instAlgAnE : Algebra ↥A_n ↥E :=
      ((algebraMap K_n ↥E).comp (algebraMap ↥A_n K_n)).toAlgebra
    letI : Algebra ↥A_n ↥E := instAlgAnE
    letI : SMul ↥A_n ↥E := instAlgAnE.toSMul
    haveI : IsScalarTower ↥A_n K_n ↥E := IsScalarTower.of_algebraMap_eq fun _ => rfl
    let B_tilde : Subalgebra ↥A_n ↥E := integralClosure ↥A_n ↥E
    letI : Algebra ↥A_n ↥B_tilde := B_tilde.algebra
    letI : Module ↥A_n ↥B_tilde := B_tilde.algebra.toModule
    letI : SMul ↥A_n ↥B_tilde := B_tilde.algebra.toSMul
    haveI : IsScalarTower ↥A_n ↥B_tilde ↥E := IsScalarTower.of_algebraMap_eq fun _ => rfl
    let instAlgkBt : Algebra k ↥B_tilde :=
      ((algebraMap ↥A_n ↥B_tilde).comp (algebraMap k ↥A_n)).toAlgebra
    letI : Algebra k ↥B_tilde := instAlgkBt
    letI : SMul k ↥B_tilde := instAlgkBt.toSMul
    haveI : IsScalarTower k ↥A_n ↥B_tilde := IsScalarTower.of_algebraMap_eq fun _ => rfl
    haveI : IsDedekindDomain ↥B_tilde := integralClosure.isDedekindDomain_fractionRing ↥A_n ↥E
    haveI : Module.Finite ↥A_n ↥B_tilde := IsIntegralClosure.finite ↥A_n K_n ↥E ↥B_tilde
    have hFT_An_Bt : Algebra.FiniteType ↥A_n ↥B_tilde := by
      have hfg : ∃ S_fin : Finset ↥B_tilde, Submodule.span ↥A_n (S_fin : Set ↥B_tilde) = ⊤ :=
        Module.Finite.fg_top
      obtain ⟨S_fin, hS_fin⟩ := hfg
      refine ⟨⟨S_fin, top_unique fun x _ => ?_⟩⟩
      have hx : x ∈ Submodule.span ↥A_n (S_fin : Set ↥B_tilde) := by
        rw [hS_fin]
        trivial
      exact Algebra.span_le_adjoin ↥A_n (S_fin : Set ↥B_tilde) hx
    letI : Algebra.FiniteType ↥A_n ↥B_tilde := hFT_An_Bt
    haveI : Algebra.FiniteType k ↥B_tilde :=
      Algebra.FiniteType.trans
        (inferInstance : Algebra.FiniteType k ↥A_n)
        (inferInstance : Algebra.FiniteType ↥A_n ↥B_tilde)

    have hE_comp_An : E.val.toRingHom.comp (algebraMap ↥A_n ↥E) = A_n.val.toRingHom := by
      ext a
      change algebraMap K_n Ω (algebraMap ↥A_n K_n a) = (a : Ω)
      rw [← IsScalarTower.algebraMap_apply ↥A_n K_n Ω]
      rfl

    let j_An_B : ↥A_n →+* ↥B_int :=
      { toFun := fun a => ⟨(a : Ω), hAn_sub_Bint a⟩
        map_one' := Subtype.ext rfl
        map_mul' := fun _ _ => Subtype.ext rfl
        map_zero' := Subtype.ext rfl
        map_add' := fun _ _ => Subtype.ext rfl }
    have hBt_intP : ∀ x : ↥B_tilde, _root_.IsIntegral P (x.1 : Ω) := by
      intro x
      obtain ⟨Q, hQm, hQe⟩ := x.2
      have hQe_Ω : Polynomial.eval₂ A_n.val.toRingHom (x.1 : Ω) Q = 0 := by
        have h1 := congrArg E.val.toRingHom hQe
        rw [Polynomial.hom_eval₂, map_zero, hE_comp_An] at h1
        exact h1
      have hIntB : _root_.IsIntegral ↥B_int (x.1 : Ω) :=
        ⟨Q.map j_An_B, hQm.map j_An_B, by rw [Polynomial.eval₂_map]; exact hQe_Ω⟩
      exact _root_.isIntegral_trans (R := P) (A := ↥B_int) _ hIntB

    let ι_fn : ↥B_tilde → R_bar := fun x => Classical.choose (h_int_in_R (x.1 : Ω) (hBt_intP x))
    have hφ_ιfn : ∀ x : ↥B_tilde, φ_R_Ω (ι_fn x) = (x.1 : Ω) :=
      fun x => Classical.choose_spec (h_int_in_R (x.1 : Ω) (hBt_intP x))
    let ι_Bt : ↥B_tilde →+* R_bar :=
      { toFun := ι_fn
        map_one' := hφ_inj (by rw [hφ_ιfn, map_one]; rfl)
        map_mul' := fun x y => hφ_inj (by rw [hφ_ιfn, map_mul, hφ_ιfn, hφ_ιfn]; rfl)
        map_zero' := hφ_inj (by rw [hφ_ιfn, map_zero]; rfl)
        map_add' := fun x y => hφ_inj (by rw [hφ_ιfn, map_add, hφ_ιfn, hφ_ιfn]; rfl) }
    have hφ_ιBt : ∀ x : ↥B_tilde, φ_R_Ω (ι_Bt x) = (x.1 : Ω) := hφ_ιfn
    have hιBt_inj : Function.Injective ι_Bt := fun x y hxy =>
      Subtype.ext (Subtype.ext (by rw [← hφ_ιBt x, ← hφ_ιBt y, hxy]))

    have hAn_to_Ω : ∀ a : ↥A_n, ((algebraMap ↥A_n ↥B_tilde a).1 : Ω) = (a : Ω) := fun a => by
      change (E.val.toRingHom.comp (algebraMap ↥A_n ↥E)) a = (a : Ω)
      rw [hE_comp_An]
      rfl

    let p_to_An : P →+* ↥A_n :=
      { toFun := fun q => ⟨algebraMap P Ω q, hP_in_An q⟩
        map_one' := Subtype.ext (map_one _)
        map_mul' := fun x y => Subtype.ext (map_mul _ x y)
        map_zero' := Subtype.ext (map_zero _)
        map_add' := fun x y => Subtype.ext (map_add _ x y) }
    let p_to_Bt : P →+* ↥B_tilde := (algebraMap ↥A_n ↥B_tilde).comp p_to_An
    have hιBt_p : ι_Bt.comp p_to_Bt = p_R := by
      apply RingHom.ext; intro q; apply hφ_inj
      rw [RingHom.comp_apply, hφ_ιBt]
      dsimp only [p_to_Bt, RingHom.comp_apply]
      rw [hAn_to_Ω]
      exact (RingHom.congr_fun hφ_pR q).symm
    have hp_Bt_C : ∀ c : k, p_to_Bt (Polynomial.C c) = algebraMap k ↥B_tilde c := by
      intro c; apply hιBt_inj; apply hφ_inj
      rw [hφ_ιBt, hφ_ιBt]
      dsimp only [p_to_Bt, RingHom.comp_apply]
      change ((algebraMap ↥A_n ↥B_tilde (p_to_An (Polynomial.C c))).1 : Ω) =
        ((algebraMap ↥A_n ↥B_tilde (algebraMap k ↥A_n c)).1 : Ω)
      rw [hAn_to_Ω, hAn_to_Ω]
      rfl

    have hSR_in_Bt : ∀ r ∈ S_R, ∃ x : ↥B_tilde, ι_Bt x = r := by
      intro r hr
      have hr_Ω : φ_R_Ω r ∈ (S_Ω : Set Ω) := Finset.mem_image_of_mem φ_R_Ω hr
      let z_E : ↥E := ⟨φ_R_Ω r, IntermediateField.subset_adjoin K_n (S_Ω : Set Ω) hr_Ω⟩
      have hz_int : _root_.IsIntegral ↥A_n z_E := by
        obtain ⟨Q, hQm, hQe⟩ := hInt_An (φ_R_Ω r) hr_Ω
        refine ⟨Q, hQm, Subtype.ext ?_⟩
        change E.val.toRingHom (Polynomial.eval₂ (algebraMap ↥A_n ↥E) z_E Q) = 0
        rw [Polynomial.hom_eval₂, hE_comp_An]
        exact hQe
      exact ⟨⟨z_E, hz_int⟩, hφ_inj (hφ_ιBt _)⟩

    refine ⟨↥B_tilde, inferInstance, inferInstance, inferInstance,
      inferInstance, inferInstance, ι_Bt, p_to_Bt, hιBt_inj, hιBt_p, hp_Bt_C, ?_⟩
    intro w hw
    obtain ⟨x_num, hx_num⟩ := hSR_in_Bt (a_of w)
      (Finset.mem_union_left _ (Finset.mem_image_of_mem _ hw))
    obtain ⟨x_den, hx_den⟩ := hSR_in_Bt (s_of w)
      (Finset.mem_union_right _ (Finset.mem_image_of_mem _ hw))
    refine ⟨x_num, x_den, hx_den.symm ▸ (hs_spec w).2.2.1, ?_⟩
    rw [hx_den, hx_num]
    exact (hs_spec w).2.2.2

  have hGoodSuperset : ∀ F : Finset R_bar,
      ∃ B : Subalgebra P R_bar, (F : Set R_bar) ⊆ (B : Set R_bar) ∧ IsGoodStage B := by
    intro F
    obtain ⟨Bt, hCR_Bt, hDom_Bt, hDed_Bt, hAlg_Bt, hFT_Bt, ι_Bt, p_to_Bt,
      hιBt_inj, hιBt_p, hp_Bt_C, hF_frac⟩ := h_dedekind_norm F
    letI : CommRing Bt := hCR_Bt
    letI : IsDomain Bt := hDom_Bt
    letI : IsDedekindDomain Bt := hDed_Bt
    letI : Algebra k Bt := hAlg_Bt
    letI : Algebra.FiniteType k Bt := hFT_Bt

    let p_L : Ideal Bt := Ideal.comap ι_Bt (IsLocalRing.maximalIdeal R_bar)
    haveI : p_L.IsPrime := Ideal.comap_isPrime ι_Bt (IsLocalRing.maximalIdeal R_bar)
    have hp_L_ne : p_L ≠ ⊥ := by
      intro hbot
      have hX_mem : p_to_Bt Polynomial.X ∈ p_L := by
        change ι_Bt (p_to_Bt Polynomial.X) ∈ IsLocalRing.maximalIdeal R_bar
        rw [← RingHom.comp_apply, hιBt_p, ht_eq]
        exact ht_max
      rw [hbot, Ideal.mem_bot] at hX_mem
      have h0 := congrArg ι_Bt hX_mem
      rw [map_zero] at h0
      exact ht_ne (ht_eq.symm.trans ((RingHom.congr_fun hιBt_p Polynomial.X).symm.trans h0))

    
    have h_dvr_extract :
        ∃ (ϖ₀ b_num s_den : Bt) (e : ℕ),
          1 ≤ e ∧ ϖ₀ ≠ 0 ∧ ϖ₀ ∈ p_L ∧ b_num ∉ p_L ∧ s_den ∉ p_L ∧
          s_den * p_to_Bt Polynomial.X = b_num * ϖ₀ ^ e ∧
          IsLocalRing.maximalIdeal (Localization.AtPrime p_L) =
            Ideal.span {algebraMap Bt (Localization.AtPrime p_L) ϖ₀} ∧
          (∀ b : Bt, b ≠ 0 → ∃ (m : ℕ) (v : R_barˣ), ι_Bt b = ↑v * (ι_Bt ϖ₀) ^ m) := by
      let V₀ := Localization.AtPrime p_L
      haveI : IsDomain V₀ :=
        IsLocalization.isDomain_of_le_nonZeroDivisors V₀ p_L.primeCompl_le_nonZeroDivisors
      haveI : IsDiscreteValuationRing V₀ :=
        IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain Bt hp_L_ne V₀

      obtain ⟨g₀, hg₀_span⟩ := Submodule.IsPrincipal.principal (IsLocalRing.maximalIdeal V₀)
      obtain ⟨⟨ϖ₀, s₀⟩, hϖ₀_mk⟩ := IsLocalization.mk'_surjective p_L.primeCompl g₀
      dsimp only at hϖ₀_mk
      have h_span_V₀ : IsLocalRing.maximalIdeal V₀ = Ideal.span {algebraMap Bt V₀ ϖ₀} := by
        rw [hg₀_span]
        apply le_antisymm
        · rw [Ideal.span_singleton_le_iff_mem, Ideal.mem_span_singleton]
          obtain ⟨u_s, hu_s⟩ := IsLocalization.map_units V₀ s₀
          refine ⟨↑u_s⁻¹, ?_⟩
          apply mul_right_cancel₀ u_s.ne_zero
          calc g₀ * ↑u_s
              = IsLocalization.mk' V₀ ϖ₀ s₀ * algebraMap Bt V₀ s₀.1 := by rw [← hϖ₀_mk, hu_s]
            _ = algebraMap Bt V₀ ϖ₀ := IsLocalization.mk'_spec V₀ ϖ₀ s₀
            _ = algebraMap Bt V₀ ϖ₀ * (↑u_s⁻¹ * ↑u_s) := by rw [Units.inv_mul, mul_one]
            _ = (algebraMap Bt V₀ ϖ₀ * ↑u_s⁻¹) * ↑u_s := by ring
        · rw [Ideal.span_singleton_le_iff_mem, Ideal.mem_span_singleton]
          refine ⟨algebraMap Bt V₀ s₀.1, ?_⟩
          rw [← hϖ₀_mk]
          exact (IsLocalization.mk'_spec V₀ ϖ₀ s₀).symm

      have hϖ₀_ne : ϖ₀ ≠ 0 := by
        intro h0
        have hbot : IsLocalRing.maximalIdeal V₀ = ⊥ := by
          rw [h_span_V₀, h0, map_zero, Ideal.span_singleton_eq_bot]
        exact IsDiscreteValuationRing.not_a_field V₀ hbot
      have hϖ₀_pL : ϖ₀ ∈ p_L := by
        have hmem : algebraMap Bt V₀ ϖ₀ ∈ IsLocalRing.maximalIdeal V₀ := by
          rw [h_span_V₀]; exact Ideal.subset_span rfl
        exact (IsLocalization.AtPrime.to_map_mem_maximal_iff V₀ p_L ϖ₀).mp hmem

      have hDVR_val : ∀ y : V₀, y ≠ 0 →
          ∃ (m : ℕ) (u_y : V₀ˣ), y = ↑u_y * (algebraMap Bt V₀ ϖ₀) ^ m := by
        intro y hy_ne
        let m_V := IsLocalRing.maximalIdeal V₀
        let ϖ_V := algebraMap Bt V₀ ϖ₀
        have hiInf : ⨅ r : ℕ, m_V ^ r = ⊥ :=
          Ideal.iInf_pow_eq_bot_of_isLocalRing m_V
            (inferInstance : (IsLocalRing.maximalIdeal V₀).IsPrime).ne_top
        have hex : ∃ r : ℕ, y ∉ m_V ^ r := by
          by_contra hall; push_neg at hall
          have hmem : y ∈ ⨅ r : ℕ, m_V ^ r := Ideal.mem_iInf.mpr hall
          rw [hiInf, Ideal.mem_bot] at hmem; exact hy_ne hmem
        let r := Nat.find hex
        have hr_not : y ∉ m_V ^ r := Nat.find_spec hex
        have hr_pos : 1 ≤ r := by
          rcases Nat.eq_zero_or_pos r with hr0 | hpos
          · exfalso; apply hr_not; rw [hr0, pow_zero, Ideal.one_eq_top]; exact Submodule.mem_top
          · exact hpos
        let m := r - 1
        have hmr : m + 1 = r := Nat.sub_add_cancel hr_pos
        have hy_mem : y ∈ m_V ^ m := by
          by_contra hnot; exact Nat.find_min hex (by omega : m < r) hnot
        have hpow_span : m_V ^ m = Ideal.span {ϖ_V ^ m} := by
          dsimp only [m_V, ϖ_V]
          rw [h_span_V₀, Ideal.span_singleton_pow]
        rw [hpow_span, Ideal.mem_span_singleton] at hy_mem
        obtain ⟨u₀, hu₀_eq⟩ := hy_mem
        have hu₀_not_max : u₀ ∉ m_V := by
          intro hu_in
          dsimp only [m_V] at hu_in
          rw [h_span_V₀, Ideal.mem_span_singleton] at hu_in
          obtain ⟨w, hw⟩ := hu_in
          apply hr_not
          dsimp only [m_V]
          rw [← hmr, h_span_V₀, Ideal.span_singleton_pow, Ideal.mem_span_singleton]
          exact ⟨w, by dsimp only [ϖ_V] at hu₀_eq; rw [hu₀_eq, hw, pow_succ]; ring⟩
        obtain ⟨u_y, hu_y⟩ := IsLocalRing.notMem_maximalIdeal.mp hu₀_not_max
        exact ⟨m, u_y, by rw [hu₀_eq, ← hu_y, mul_comm]⟩

      have h_units_V₀ : ∀ s : p_L.primeCompl, IsUnit (ι_Bt s.1) := fun s =>
        IsLocalRing.notMem_maximalIdeal.mp s.2
      let ι_V₀ : V₀ →+* R_bar := IsLocalization.lift (M := p_L.primeCompl) h_units_V₀
      have hι_V₀_eq : ∀ x : Bt, ι_V₀ (algebraMap Bt V₀ x) = ι_Bt x :=
        IsLocalization.lift_eq h_units_V₀

      have hinj_Bt_V₀ : Function.Injective (algebraMap Bt V₀) :=
        IsLocalization.injective V₀ p_L.primeCompl_le_nonZeroDivisors
      let x_Bt : Bt := p_to_Bt Polynomial.X
      have hx_Bt_ne : x_Bt ≠ 0 := by
        intro h0
        have h1 := congrArg ι_Bt h0
        rw [map_zero] at h1
        exact ht_ne (ht_eq.symm.trans ((RingHom.congr_fun hιBt_p Polynomial.X).symm.trans h1))
      have hx_V₀_ne : algebraMap Bt V₀ x_Bt ≠ 0 :=
        fun h0 => hx_Bt_ne (hinj_Bt_V₀ (h0.trans (map_zero _).symm))
      obtain ⟨e, u_X, hu_X_eq⟩ := hDVR_val (algebraMap Bt V₀ x_Bt) hx_V₀_ne
      have he_pos : 1 ≤ e := by
        rcases Nat.eq_zero_or_pos e with rfl | hpos
        · exfalso
          rw [pow_zero, mul_one] at hu_X_eq
          have hx_max : algebraMap Bt V₀ x_Bt ∈ IsLocalRing.maximalIdeal V₀ := by
            apply (IsLocalization.AtPrime.to_map_mem_maximal_iff V₀ p_L x_Bt).mpr
            change ι_Bt (p_to_Bt Polynomial.X) ∈ IsLocalRing.maximalIdeal R_bar
            rw [← RingHom.comp_apply, hιBt_p, ht_eq]
            exact ht_max
          rw [hu_X_eq] at hx_max
          exact IsLocalRing.notMem_maximalIdeal.mpr u_X.isUnit hx_max
        · exact hpos

      obtain ⟨⟨b_num, s_den⟩, hb_num_mk⟩ := IsLocalization.mk'_surjective p_L.primeCompl (u_X : V₀)
      dsimp only at hb_num_mk
      have hb_num_not : b_num ∉ p_L := by
        intro hb_in
        have hmem : (u_X : V₀) * algebraMap Bt V₀ s_den.1 ∈ IsLocalRing.maximalIdeal V₀ := by
          rw [← hb_num_mk, IsLocalization.mk'_spec]
          exact (IsLocalization.AtPrime.to_map_mem_maximal_iff V₀ p_L b_num).mpr hb_in
        have hs_not : algebraMap Bt V₀ s_den.1 ∉ IsLocalRing.maximalIdeal V₀ :=
          IsLocalRing.notMem_maximalIdeal.mpr (IsLocalization.map_units V₀ s_den)
        rcases (inferInstance : (IsLocalRing.maximalIdeal V₀).IsPrime).mem_or_mem hmem with hu_in | hs_in
        · exact IsLocalRing.notMem_maximalIdeal.mpr u_X.isUnit hu_in
        · exact hs_not hs_in
      have hX_Bt_eq : s_den.1 * x_Bt = b_num * ϖ₀ ^ e := by
        apply hinj_Bt_V₀
        rw [map_mul, map_mul, map_pow, hu_X_eq, ← hb_num_mk]
        calc algebraMap Bt V₀ s_den.1 * (IsLocalization.mk' V₀ b_num s_den * (algebraMap Bt V₀ ϖ₀) ^ e)
            = (IsLocalization.mk' V₀ b_num s_den * algebraMap Bt V₀ s_den.1) *
                (algebraMap Bt V₀ ϖ₀) ^ e := by ring
          _ = algebraMap Bt V₀ b_num * (algebraMap Bt V₀ ϖ₀) ^ e := by rw [IsLocalization.mk'_spec]

      refine ⟨ϖ₀, b_num, s_den.1, e, he_pos, hϖ₀_ne, hϖ₀_pL, hb_num_not, s_den.2,
        hX_Bt_eq, h_span_V₀, ?_⟩
      intro b hb_ne
      have hb_V₀ : algebraMap Bt V₀ b ≠ 0 :=
        fun h0 => hb_ne (hinj_Bt_V₀ (h0.trans (map_zero _).symm))
      obtain ⟨m_b, u_b, hu_b_eq⟩ := hDVR_val (algebraMap Bt V₀ b) hb_V₀
      refine ⟨m_b, Units.map ι_V₀.toMonoidHom u_b, ?_⟩
      rw [← hι_V₀_eq b, hu_b_eq, map_mul, map_pow, hι_V₀_eq]
      rfl

    obtain ⟨ϖ₀, b_num, s_den, e, he_pos, hϖ₀_ne, hϖ₀_pL, hb_num_not, hs_den_not,
      hX_Bt_eq, h_span_V₀, hBt_val⟩ := h_dvr_extract

    have hκ_Bt_ker : RingHom.ker (π_cl.comp ι_Bt) = p_L := by
      ext x
      change π_cl (ι_Bt x) = 0 ↔ ι_Bt x ∈ IsLocalRing.maximalIdeal R_bar
      rw [← RingHom.mem_ker, hπ_ker]
    have hκ_Bt_k : ∀ c : k, (π_cl.comp ι_Bt) (algebraMap k Bt c) = c := by
      intro c
      rw [RingHom.comp_apply, ← hp_Bt_C c]
      change π_cl ((ι_Bt.comp p_to_Bt) (Polynomial.C c)) = c
      rw [hιBt_p]
      change (π_cl.comp p_R) (Polynomial.C c) = c
      rw [hπ_pR]
      exact Polynomial.eval_C

    obtain ⟨f_et, hf_et_not, hf_et_etale⟩ :=
      hEtaleUnramifiedKill Bt p_L (π_cl.comp ι_Bt) hκ_Bt_ker hκ_Bt_k ϖ₀ hϖ₀_ne h_span_V₀

    let num_of : { w : R_bar // w ∈ F } → Bt := fun w => Classical.choose (hF_frac w.1 w.2)
    let den_of : { w : R_bar // w ∈ F } → Bt :=
      fun w => Classical.choose (Classical.choose_spec (hF_frac w.1 w.2))
    have hden_spec : ∀ w : { w : R_bar // w ∈ F },
        IsUnit (ι_Bt (den_of w)) ∧ w.1 * ι_Bt (den_of w) = ι_Bt (num_of w) :=
      fun w => Classical.choose_spec (Classical.choose_spec (hF_frac w.1 w.2))
    have hden_not_pL : ∀ w : { w : R_bar // w ∈ F }, den_of w ∉ p_L := fun w hw_in =>
      IsLocalRing.notMem_maximalIdeal.mpr (hden_spec w).1 hw_in

    let s_F : p_L.primeCompl := ∏ w ∈ F.attach, ⟨den_of w, hden_not_pL w⟩
    let s_extra : p_L.primeCompl := s_F * (⟨b_num, hb_num_not⟩ * ⟨s_den, hs_den_not⟩)
    let f_tot : Bt := f_et * s_extra.1
    have hf_tot_not : f_tot ∉ p_L := Submonoid.mul_mem _ hf_et_not s_extra.2

    let B_loc := Localization.Away f_tot
    have hψ_loc_et : ((algebraMap Bt B_loc).comp
        (Polynomial.aeval (R := k) (A := Bt) ϖ₀).toRingHom).Etale :=
      hf_et_etale s_extra.1 s_extra.2

    have hf_tot_unit_R : IsUnit (ι_Bt f_tot) := IsLocalRing.notMem_maximalIdeal.mp hf_tot_not
    let ι_loc : B_loc →+* R_bar := IsLocalization.Away.lift f_tot hf_tot_unit_R
    have hι_loc_Bt : ∀ x : Bt, ι_loc (algebraMap Bt B_loc x) = ι_Bt x :=
      IsLocalization.Away.lift_eq f_tot hf_tot_unit_R
    have hι_loc_inj : Function.Injective ι_loc := by
      rw [injective_iff_map_eq_zero]
      intro z hz
      obtain ⟨⟨x, ⟨_, k_m, rfl⟩⟩, hxz⟩ := IsLocalization.surj (Submonoid.powers f_tot) z
      have hx0 : ι_Bt x = 0 := by
        have h1 := congrArg ι_loc hxz
        rw [map_mul, hz, zero_mul, hι_loc_Bt] at h1
        exact h1.symm
      rw [hιBt_inj (hx0.trans (map_zero _).symm), map_zero] at hxz
      have hpow_unit : IsUnit (algebraMap Bt B_loc (f_tot ^ k_m)) := by
        rw [map_pow]; exact (IsLocalization.Away.algebraMap_isUnit f_tot).pow k_m
      exact hpow_unit.mul_left_eq_zero.mp hxz

    letI : Algebra P B_loc := ((algebraMap Bt B_loc).comp p_to_Bt).toAlgebra
    let ι_loc_alg : B_loc →ₐ[P] R_bar :=
      { ι_loc with
        commutes' := fun q => by
          change ι_loc (algebraMap Bt B_loc (p_to_Bt q)) = p_R q
          rw [hι_loc_Bt]; exact RingHom.congr_fun hιBt_p q }
    let B : Subalgebra P R_bar := ι_loc_alg.range
    let e_Bloc : B_loc ≃ₐ[P] ↥B := AlgEquiv.ofInjective ι_loc_alg hι_loc_inj

    have hf_tot_unit_loc : IsUnit (algebraMap Bt B_loc f_tot) :=
      IsLocalization.Away.algebraMap_isUnit f_tot
    have h_dvd_unit_loc : ∀ d : Bt, d ∣ f_tot → IsUnit (algebraMap Bt B_loc d) := by
      intro d ⟨c_d, hc_d⟩
      apply isUnit_of_mul_isUnit_left (y := algebraMap Bt B_loc c_d)
      rw [← map_mul, ← hc_d]; exact hf_tot_unit_loc

    refine ⟨B, ?_, ?_⟩
    · intro w hw
      let w_sub : { w : R_bar // w ∈ F } := ⟨w, hw⟩
      have h_dvd_den : den_of w_sub ∣ f_tot := by
        rcases Finset.dvd_prod_of_mem
          (fun v : { w : R_bar // w ∈ F } => (⟨den_of v, hden_not_pL v⟩ : p_L.primeCompl))
          (Finset.mem_attach F w_sub) with ⟨t1, ht1⟩
        refine ⟨f_et * (t1.1 * (b_num * s_den)), ?_⟩
        have ht1_val : s_F.1 = den_of w_sub * t1.1 := by
          dsimp only [s_F]
          rw [ht1, Submonoid.coe_mul]
        change f_et * (s_F.1 * (b_num * s_den)) = _
        rw [ht1_val]; ring
      obtain ⟨u_den, hu_den⟩ := h_dvd_unit_loc (den_of w_sub) h_dvd_den
      refine ⟨algebraMap Bt B_loc (num_of w_sub) * ↑u_den⁻¹, ?_⟩
      change ι_loc (algebraMap Bt B_loc (num_of w_sub) * ↑u_den⁻¹) = w
      apply mul_right_cancel₀ (hden_spec w_sub).1.ne_zero
      have h_u_cancel : (algebraMap Bt B_loc (num_of w_sub) * ↑u_den⁻¹) * ↑u_den =
          algebraMap Bt B_loc (num_of w_sub) := by
        rw [mul_assoc, Units.inv_mul, mul_one]
      calc ι_loc (algebraMap Bt B_loc (num_of w_sub) * ↑u_den⁻¹) * ι_Bt (den_of w_sub)
          = ι_loc (algebraMap Bt B_loc (num_of w_sub) * ↑u_den⁻¹) *
              ι_loc (algebraMap Bt B_loc (den_of w_sub)) := by rw [hι_loc_Bt]
        _ = ι_loc ((algebraMap Bt B_loc (num_of w_sub) * ↑u_den⁻¹) * ↑u_den) := by
              rw [← hu_den, ← map_mul]
        _ = ι_Bt (num_of w_sub) := by rw [h_u_cancel, hι_loc_Bt]
        _ = w * ι_Bt (den_of w_sub) := ((hden_spec w_sub).2).symm
    · let ϖ : ↥B := e_Bloc (algebraMap Bt B_loc ϖ₀)
      obtain ⟨u_bn, hu_bn⟩ := h_dvd_unit_loc b_num
        ⟨f_et * s_F.1 * s_den, by change f_et * (s_F.1 * (b_num * s_den)) = _; ring⟩
      obtain ⟨u_sd, hu_sd⟩ := h_dvd_unit_loc s_den
        ⟨f_et * s_F.1 * b_num, by change f_et * (s_F.1 * (b_num * s_den)) = _; ring⟩
      let u_loc : B_locˣ := u_bn * u_sd⁻¹
      let u : (↥B)ˣ := Units.map e_Bloc.toRingEquiv.toMonoidHom u_loc
      let ψ : Polynomial k →+* ↥B := e_Bloc.toRingEquiv.toRingHom.comp
        ((algebraMap Bt B_loc).comp (Polynomial.aeval (R := k) (A := Bt) ϖ₀).toRingHom)
      refine ⟨ϖ, u, e, ψ, he_pos, ?_, ?_, ?_, ?_, ?_, ?_⟩
      · change ι_loc (algebraMap Bt B_loc ϖ₀) ∈ IsLocalRing.maximalIdeal R_bar
        rw [hι_loc_Bt]; exact hϖ₀_pL
      · apply e_Bloc.symm.injective
        have h_lhs : e_Bloc.symm (algebraMap P ↥B Polynomial.X) =
            algebraMap Bt B_loc (p_to_Bt Polynomial.X) := e_Bloc.symm.commutes Polynomial.X
        have h_rhs : e_Bloc.symm (↑u * ϖ ^ e) = ↑u_loc * (algebraMap Bt B_loc ϖ₀) ^ e := by
          rw [map_mul, map_pow]; simp [ϖ, u]
        rw [h_lhs, h_rhs]
        have hu_sd_bn : (u_sd : B_loc) * ↑u_loc = ↑u_bn := by
          dsimp only [u_loc]
          rw [Units.val_mul]
          calc (u_sd : B_loc) * (↑u_bn * ↑u_sd⁻¹)
              = ↑u_bn * (↑u_sd⁻¹ * ↑u_sd) := by ring
            _ = ↑u_bn := by rw [Units.inv_mul, mul_one]
        have h_mul_sd : (u_sd : B_loc) * algebraMap Bt B_loc (p_to_Bt Polynomial.X) =
            (u_sd : B_loc) * (↑u_loc * (algebraMap Bt B_loc ϖ₀) ^ e) := by
          calc (u_sd : B_loc) * algebraMap Bt B_loc (p_to_Bt Polynomial.X)
              = algebraMap Bt B_loc (s_den * p_to_Bt Polynomial.X) := by rw [hu_sd, map_mul]
            _ = algebraMap Bt B_loc (b_num * ϖ₀ ^ e) := by rw [hX_Bt_eq]
            _ = (u_bn : B_loc) * (algebraMap Bt B_loc ϖ₀) ^ e := by rw [map_mul, map_pow, hu_bn]
            _ = (u_sd : B_loc) * (↑u_loc * (algebraMap Bt B_loc ϖ₀) ^ e) := by
                  rw [← mul_assoc, hu_sd_bn]
        have h_cancel := congrArg ((↑u_sd⁻¹ : B_loc) * ·) h_mul_sd
        simpa only [← mul_assoc, Units.inv_mul, one_mul] using h_cancel
      · apply RingHom.ext; intro c
        rw [RingHom.comp_apply, RingHom.comp_apply]
        change e_Bloc (algebraMap Bt B_loc (Polynomial.aeval ϖ₀ (Polynomial.C c))) =
          algebraMap P ↥B (Polynomial.C c)
        rw [Polynomial.aeval_C, ← hp_Bt_C c]
        exact e_Bloc.commutes (Polynomial.C c)
      · simp [ψ, ϖ]
      · exact hEtaleCompEquiv B_loc ↥B _ e_Bloc.toRingEquiv hψ_loc_et
      · intro c hc_ne
        let c_loc : B_loc := e_Bloc.symm c
        have hc_loc_ne : c_loc ≠ 0 :=
          fun h0 => hc_ne (e_Bloc.symm.injective (h0.trans (map_zero _).symm))
        obtain ⟨⟨b_c, ⟨_, k_c, rfl⟩⟩, hbc_spec⟩ :=
          IsLocalization.surj (Submonoid.powers f_tot) c_loc
        have hb_c_ne : b_c ≠ 0 := by
          intro h0
          rw [h0, map_zero] at hbc_spec
          have hpow_u : IsUnit (algebraMap Bt B_loc (f_tot ^ k_c)) := by
            rw [map_pow]; exact hf_tot_unit_loc.pow k_c
          exact hc_loc_ne (hpow_u.mul_left_eq_zero.mp hbc_spec)
        obtain ⟨m_c, v_b, hv_b_eq⟩ := hBt_val b_c hb_c_ne
        obtain ⟨u_f_R, hu_f_R⟩ := hf_tot_unit_R
        let v_R : R_barˣ := v_b * (u_f_R ^ k_c)⁻¹
        refine ⟨m_c, v_R, ?_⟩
        have hc_val : B.val c = ι_loc c_loc := by
          have h1 : e_Bloc c_loc = c := e_Bloc.apply_symm_apply c
          rw [← h1]; rfl
        have hϖ_val : B.val ϖ = ι_Bt ϖ₀ := hι_loc_Bt ϖ₀
        rw [hc_val, hϖ_val]
        apply mul_right_cancel₀ (u_f_R ^ k_c).ne_zero
        have h_lhs : ι_loc c_loc * ↑(u_f_R ^ k_c) = ι_Bt b_c := by
          rw [Units.val_pow_eq_pow_val, hu_f_R, ← map_pow, ← hι_loc_Bt (f_tot ^ k_c),
            ← map_mul, hbc_spec, hι_loc_Bt]
        rw [h_lhs, hv_b_eq]
        dsimp only [v_R]
        rw [Units.val_mul]
        calc (v_b : R_bar) * ι_Bt ϖ₀ ^ m_c
            = ((v_b : R_bar) * (↑(u_f_R ^ k_c)⁻¹ * ↑(u_f_R ^ k_c))) * ι_Bt ϖ₀ ^ m_c := by
                rw [Units.inv_mul, mul_one]
          _ = ((v_b : R_bar) * ↑(u_f_R ^ k_c)⁻¹ * ι_Bt ϖ₀ ^ m_c) * ↑(u_f_R ^ k_c) := by ring

  
  
  
  have hKummerExt : ∀ (B : Subalgebra P R_bar), IsGoodStage B →
      ∀ (ϖ : ↥B) (u : (↥B)ˣ) (e : ℕ) (ψ : Polynomial k →+* ↥B),
        1 ≤ e →
        B.val ϖ ∈ IsLocalRing.maximalIdeal R_bar →
        algebraMap P ↥B Polynomial.X = ↑u * ϖ ^ e →
        ψ.comp Polynomial.C = (algebraMap P ↥B).comp Polynomial.C →
        ψ Polynomial.X = ϖ →
        @RingHom.Etale P ↥B _ _ ψ →
        (∀ c : ↥B, c ≠ 0 → ∃ (n : ℕ) (v : R_barˣ), B.val c = ↑v * (B.val ϖ) ^ n) →
        ∃ (B₁ : Subalgebra P R_bar) (hle : B ≤ B₁) (β₁ : ↥B₁)
          (ψ₁ : Polynomial k →+* ↥B₁),
          IsGoodStage B₁ ∧
          Subalgebra.inclusion hle ϖ = β₁ ^ ℓ ∧
          ψ₁.comp Polynomial.C = (algebraMap P ↥B₁).comp Polynomial.C ∧
          ψ₁ Polynomial.X = β₁ ∧
          @RingHom.Etale P ↥B₁ _ _ ψ₁ := by
    intro B _ ϖ u e ψ he hϖ_max hX_eq hψ_C hψ_X hψ_et h_val
    have hℓ_prime : Nat.Prime ℓ := Fact.out
    have hℓ_pos : 1 ≤ ℓ := hℓ_prime.pos
    obtain ⟨β_R, hβ_max, hβ_pow⟩ := hRootPow ℓ (B.val ϖ) hℓ_pos hϖ_max
    have hϖ_R_ne : B.val ϖ ≠ 0 := by
      intro h0
      have hX_R : t_bar = B.val ↑u * (B.val ϖ) ^ e := by
        rw [← ht_eq]
        change B.val (algebraMap P ↥B Polynomial.X) = _
        rw [hX_eq, map_mul, map_pow]
      rw [h0, zero_pow (by omega : e ≠ 0), mul_zero] at hX_R
      exact ht_ne hX_R
    have hβ_ne : β_R ≠ 0 := fun h0 =>
      hϖ_R_ne (by rw [← hβ_pow, h0, zero_pow hℓ_prime.ne_zero])

    have hModEllFactor : ∀ c : Fin ℓ → ↥B, (∃ j : Fin ℓ, c j ≠ 0) →
        ∃ (m₀ : ℕ) (v₀ : R_barˣ),
          (∑ j : Fin ℓ, B.val (c j) * β_R ^ j.1) = ↑v₀ * β_R ^ m₀ := by
      intro c ⟨j_wit, hj_wit⟩
      let S_nz : Finset (Fin ℓ) := Finset.univ.filter (fun j => c j ≠ 0)
      have hS_ne : S_nz.Nonempty := ⟨j_wit, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hj_wit⟩⟩
      let n_j : Fin ℓ → ℕ := fun j => if hj : c j ≠ 0 then Classical.choose (h_val (c j) hj) else 0
      let v_j : Fin ℓ → R_barˣ := fun j =>
        if hj : c j ≠ 0 then Classical.choose (Classical.choose_spec (h_val (c j) hj)) else 1
      have hterm_nz : ∀ j ∈ S_nz,
          B.val (c j) * β_R ^ j.1 = ↑(v_j j) * β_R ^ (ℓ * n_j j + j.1) := by
        intro j hj
        have hj_ne : c j ≠ 0 := (Finset.mem_filter.mp hj).2
        have hv_eq : B.val (c j) = ↑(v_j j) * (B.val ϖ) ^ (n_j j) := by
          dsimp only [v_j, n_j]; rw [dif_pos hj_ne, dif_pos hj_ne]
          exact Classical.choose_spec (Classical.choose_spec (h_val (c j) hj_ne))
        rw [hv_eq, ← hβ_pow, ← pow_mul, mul_assoc, ← pow_add]
      let m_fn : Fin ℓ → ℕ := fun j => ℓ * n_j j + j.1
      obtain ⟨j₀, hj₀_mem, hj₀_min⟩ := Finset.exists_min_image S_nz m_fn hS_ne
      let m₀ := m_fn j₀
      have hlt_erase : ∀ j ∈ S_nz.erase j₀, m₀ < m_fn j := by
        intro j hj
        have hj_ne_j₀ : j ≠ j₀ := (Finset.mem_erase.mp hj).1
        have hj_S : j ∈ S_nz := (Finset.mem_erase.mp hj).2
        refine lt_of_le_of_ne (hj₀_min j hj_S) fun heq => hj_ne_j₀ (Fin.ext ?_)
        have hm1 : m₀ % ℓ = j₀.1 := by
          dsimp only [m₀, m_fn]; rw [Nat.mul_add_mod_self_left, Nat.mod_eq_of_lt j₀.2]
        have hm2 : m_fn j % ℓ = j.1 := by
          dsimp only [m_fn]; rw [Nat.mul_add_mod_self_left, Nat.mod_eq_of_lt j.2]
        rw [← hm2, ← heq, hm1]
      let rem_sum : R_bar := ∑ j ∈ S_nz.erase j₀, ↑(v_j j) * β_R ^ (m_fn j - m₀)
      have hrem_max : rem_sum ∈ IsLocalRing.maximalIdeal R_bar := by
        apply Ideal.sum_mem; intro j hj
        have hd_pos : 1 ≤ m_fn j - m₀ := by have := hlt_erase j hj; omega
        have hpow_max : β_R ^ (m_fn j - m₀) ∈ IsLocalRing.maximalIdeal R_bar := by
          rw [← Nat.sub_add_cancel hd_pos, pow_succ]
          exact Ideal.mul_mem_left _ _ hβ_max
        exact Ideal.mul_mem_left _ _ hpow_max
      have htot_not_max : (↑(v_j j₀) + rem_sum : R_bar) ∉ IsLocalRing.maximalIdeal R_bar := by
        intro h_in
        have hv_in : (↑(v_j j₀) : R_bar) ∈ IsLocalRing.maximalIdeal R_bar := by
          have hsub := Ideal.sub_mem _ h_in hrem_max
          rwa [add_sub_cancel_right] at hsub
        exact IsLocalRing.notMem_maximalIdeal.mpr (v_j j₀).isUnit hv_in
      obtain ⟨v₀, hv₀⟩ := IsLocalRing.notMem_maximalIdeal.mp htot_not_max
      refine ⟨m₀, v₀, ?_⟩
      have hsum_filter : (∑ j : Fin ℓ, B.val (c j) * β_R ^ j.1) =
          ∑ j ∈ S_nz, B.val (c j) * β_R ^ j.1 := by
        symm
        apply Finset.sum_subset (Finset.subset_univ S_nz)
        intro j _ hj_not
        have hcj0 : c j = 0 := by
          by_contra hne
          exact hj_not (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hne⟩)
        rw [hcj0, map_zero, zero_mul]
      rw [hsum_filter, Finset.sum_congr rfl hterm_nz, ← Finset.add_sum_erase _ _ hj₀_mem]
      change ↑(v_j j₀) * β_R ^ m₀ + ∑ j ∈ S_nz.erase j₀, ↑(v_j j) * β_R ^ (m_fn j) = _
      have herase_eq : (∑ j ∈ S_nz.erase j₀, ↑(v_j j) * β_R ^ (m_fn j)) = rem_sum * β_R ^ m₀ := by
        dsimp only [rem_sum]
        rw [Finset.sum_mul]
        apply Finset.sum_congr rfl
        intro j hj
        rw [mul_assoc, ← pow_add, Nat.sub_add_cancel (hlt_erase j hj).le]
      rw [herase_eq, ← add_mul, ← hv₀]

    let Q_kum : Polynomial ↥B := Polynomial.X ^ ℓ - Polynomial.C ϖ
    have hQ_monic : Q_kum.Monic := Polynomial.monic_X_pow_sub_C ϖ hℓ_prime.ne_zero
    have hQ_eval_β : Polynomial.eval₂ B.val.toRingHom β_R Q_kum = 0 := by
      dsimp only [Q_kum]
      rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, hβ_pow]
      exact sub_self _
    let Φ_ring : AdjoinRoot Q_kum →+* R_bar := AdjoinRoot.lift B.val.toRingHom β_R hQ_eval_β
    let Φ_P : AdjoinRoot Q_kum →ₐ[P] R_bar :=
      { Φ_ring with
        commutes' := fun q => by
          rw [IsScalarTower.algebraMap_apply P ↥B (AdjoinRoot Q_kum)]
          change AdjoinRoot.lift B.val.toRingHom β_R hQ_eval_β
            (AdjoinRoot.of Q_kum (algebraMap P ↥B q)) = algebraMap P R_bar q
          rw [AdjoinRoot.lift_of]
          exact B.val.commutes q }

    let pb := AdjoinRoot.powerBasis' hQ_monic
    have hpb_dim : pb.dim = ℓ := by
      rw [AdjoinRoot.powerBasis'_dim, Polynomial.natDegree_X_pow_sub_C]
    let e_fin : Fin pb.dim ≃ Fin ℓ := finCongr hpb_dim

    have hAdjoinFactor : ∀ z : AdjoinRoot Q_kum, z ≠ 0 →
        ∃ (m₀ : ℕ) (v₀ : R_barˣ), Φ_P z = ↑v₀ * β_R ^ m₀ := by
      intro z hz_ne
      let c_pb := pb.basis.repr z
      let c : Fin ℓ → ↥B := fun j => c_pb (e_fin.symm j)
      have hc_ex : ∃ j : Fin ℓ, c j ≠ 0 := by
        by_contra hall; push_neg at hall; apply hz_ne
        rw [← pb.basis.sum_repr z]
        apply Finset.sum_eq_zero; intro idx _
        have h0 : c_pb idx = 0 := by simpa [c] using hall (e_fin idx)
        rw [h0, zero_smul]
      obtain ⟨m₀, v₀, hv₀_eq⟩ := hModEllFactor c hc_ex
      refine ⟨m₀, v₀, ?_⟩
      have hz_sum := pb.basis.sum_repr z
      have hΦ_z : Φ_P z = ∑ idx : Fin pb.dim, B.val (c_pb idx) * β_R ^ idx.1 := by
        conv_lhs => rw [← hz_sum]
        rw [map_sum]
        apply Finset.sum_congr rfl; intro idx _
        rw [pb.basis_eq_pow, AdjoinRoot.powerBasis'_gen]
        change Φ_ring (c_pb idx • (AdjoinRoot.root Q_kum) ^ idx.1) = _
        rw [Algebra.smul_def, map_mul, map_pow, AdjoinRoot.algebraMap_eq Q_kum,
          AdjoinRoot.lift_of, AdjoinRoot.lift_root]
        rfl
      rw [hΦ_z, ← hv₀_eq]
      exact (Finset.sum_congr rfl fun idx _ => by
        dsimp only [c]; rw [e_fin.symm_apply_apply]; rfl).trans
        (e_fin.sum_comp (fun j : Fin ℓ => B.val (c j) * β_R ^ j.1))

    have hΦ_inj : Function.Injective Φ_P := by
      rw [injective_iff_map_eq_zero]; intro z hz; by_contra hz_ne
      obtain ⟨m₀, v₀, hv₀_eq⟩ := hAdjoinFactor z hz_ne
      exact mul_ne_zero v₀.ne_zero (pow_ne_zero m₀ hβ_ne) (hv₀_eq.symm.trans hz)

    let B₁ : Subalgebra P R_bar := Φ_P.range
    have hle : B ≤ B₁ := fun x hx =>
      ⟨AdjoinRoot.of Q_kum ⟨x, hx⟩, AdjoinRoot.lift_of hQ_eval_β⟩
    let e_kum : AdjoinRoot Q_kum ≃ₐ[P] ↥B₁ := AlgEquiv.ofInjective Φ_P hΦ_inj
    let β₁ : ↥B₁ := e_kum (AdjoinRoot.root Q_kum)
    have hβ₁_val : B₁.val β₁ = β_R := AdjoinRoot.lift_root hQ_eval_β
    have hincl_ϖ : Subalgebra.inclusion hle ϖ = β₁ ^ ℓ :=
      Subtype.ext (by change B.val ϖ = (B₁.val β₁) ^ ℓ; rw [hβ₁_val, hβ_pow])

    let u₁ : (↥B₁)ˣ := Units.map (Subalgebra.inclusion hle).toRingHom.toMonoidHom u
    let e₁ : ℕ := ℓ * e
    have he₁_pos : 1 ≤ e₁ := Nat.mul_pos hℓ_pos he
    have hX_B₁ : algebraMap P ↥B₁ Polynomial.X = ↑u₁ * β₁ ^ e₁ := by
      have h1 : algebraMap P ↥B₁ Polynomial.X =
          Subalgebra.inclusion hle (algebraMap P ↥B Polynomial.X) :=
        ((Subalgebra.inclusion hle).commutes Polynomial.X).symm
      rw [h1, hX_eq, map_mul, map_pow, hincl_ϖ, ← pow_mul]; rfl

    let ψ₁_adj : P →+* AdjoinRoot Q_kum :=
      Polynomial.eval₂RingHom ((AdjoinRoot.of Q_kum).comp (ψ.comp Polynomial.C))
        (AdjoinRoot.root Q_kum)
    have hψ₁_adj_et : @RingHom.Etale P (AdjoinRoot Q_kum) _ _ ψ₁_adj := by
      subst hψ_X; exact hKummerPushoutEtale ↥B ψ hψ_et
    let ψ₁ : Polynomial k →+* ↥B₁ := e_kum.toRingEquiv.toRingHom.comp ψ₁_adj
    have hψ₁_et : @RingHom.Etale P ↥B₁ _ _ ψ₁ :=
      hEtaleCompEquiv (AdjoinRoot Q_kum) ↥B₁ ψ₁_adj e_kum.toRingEquiv hψ₁_adj_et
    have hψ₁_C : ψ₁.comp Polynomial.C = (algebraMap P ↥B₁).comp Polynomial.C := by
      apply RingHom.ext; intro c
      rw [RingHom.comp_apply, RingHom.comp_apply]
      change e_kum (Polynomial.eval₂ ((AdjoinRoot.of Q_kum).comp (ψ.comp Polynomial.C))
        (AdjoinRoot.root Q_kum) (Polynomial.C c)) = algebraMap P ↥B₁ (Polynomial.C c)
      rw [Polynomial.eval₂_C, RingHom.comp_apply, hψ_C, RingHom.comp_apply,
        ← AdjoinRoot.algebraMap_eq Q_kum,
        ← IsScalarTower.algebraMap_apply P ↥B (AdjoinRoot Q_kum)]
      exact e_kum.commutes (Polynomial.C c)
    have hψ₁_X : ψ₁ Polynomial.X = β₁ := by simp [ψ₁, ψ₁_adj, β₁]

    have h_val₁ : ∀ c₁ : ↥B₁, c₁ ≠ 0 →
        ∃ (n₁ : ℕ) (v₁ : R_barˣ), B₁.val c₁ = ↑v₁ * (B₁.val β₁) ^ n₁ := by
      intro c₁ hc₁_ne
      let z : AdjoinRoot Q_kum := e_kum.symm c₁
      have hz_ne : z ≠ 0 := fun h0 => hc₁_ne (e_kum.symm.injective (h0.trans (map_zero _).symm))
      obtain ⟨m₀, v₀, hv₀_eq⟩ := hAdjoinFactor z hz_ne
      refine ⟨m₀, v₀, ?_⟩
      rw [hβ₁_val, ← hv₀_eq]
      have h1 : e_kum z = c₁ := e_kum.apply_symm_apply c₁
      rw [← h1]; rfl

    have hGood₁ : IsGoodStage B₁ :=
      ⟨β₁, u₁, e₁, ψ₁, he₁_pos, hβ₁_val ▸ hβ_max, hX_B₁, hψ₁_C, hψ₁_X, hψ₁_et, h_val₁⟩
    exact ⟨B₁, hle, β₁, ψ₁, hGood₁, hincl_ϖ, hψ₁_C, hψ₁_X, hψ₁_et⟩

  
  
  
  have hPointedEtaleLiftAlg :
      ∀ (E_alg : Type u) [CommRing E_alg] (φ_E : R_bar →+* E_alg) (hφ_et : φ_E.Etale)
        (χ₀ : E_alg →+* k) (hχ₀ : χ₀.comp φ_E = π_cl),
      ∃ τ_E : E_alg →+* R_bar,
        τ_E.comp φ_E = RingHom.id R_bar ∧ π_cl.comp τ_E = χ₀ := by
    intro E_alg _ φ_E hφ_et χ₀ hχ₀
    letI : Algebra R_bar E_alg := φ_E.toAlgebra
    haveI : Algebra.Etale R_bar E_alg := RingHom.etale_algebraMap.mp hφ_et
    let q₀ : Ideal E_alg := RingHom.ker χ₀
    haveI : q₀.IsPrime := RingHom.ker_isPrime χ₀
    obtain ⟨f_loc, hf_not_q₀, hStd⟩ := Algebra.IsEtaleAt.exists_isStandardEtale (R := R_bar) q₀
    let E_loc := Localization.Away f_loc
    letI : Algebra.IsStandardEtale R_bar E_loc := hStd
    obtain ⟨pres⟩ :=
      Algebra.IsStandardEtale.nonempty_standardEtalePresentation (R := R_bar) (S := E_loc)

    have hf_unit_k : IsUnit (χ₀ f_loc) := IsUnit.mk0 _ (fun h0 => hf_not_q₀ h0)
    let χ_loc : E_loc →+* k := IsLocalization.Away.lift f_loc hf_unit_k
    have hχ_loc_E : χ_loc.comp (algebraMap E_alg E_loc) = χ₀ :=
      RingHom.ext (IsLocalization.Away.lift_eq f_loc hf_unit_k)

    letI : Algebra R_bar k := π_cl.toAlgebra
    let χ_alg : E_loc →ₐ[R_bar] k :=
      { χ_loc with
        commutes' := fun r => by
          rw [IsScalarTower.algebraMap_apply R_bar E_alg E_loc]
          change (χ_loc.comp (algebraMap E_alg E_loc)) (φ_E r) = π_cl r
          rw [hχ_loc_E]; exact RingHom.congr_fun hχ₀ r }

    let P_et : StandardEtalePair R_bar := pres.P
    let c₀ : k := χ_alg pres.x
    have hc₀_map : P_et.HasMap c₀ := pres.hasMap.map χ_alg
    obtain ⟨a, ha_f, ha_cl⟩ := hPointedMonicRoot P_et.f P_et.monic_f c₀ hc₀_map.1
    have ha_g_unit : IsUnit (Polynomial.eval a P_et.g) := by
      apply IsLocalRing.notMem_maximalIdeal.mp
      rw [← hπ_ker, RingHom.mem_ker]
      intro hg0
      have h1 : Polynomial.eval₂ π_cl c₀ P_et.g = 0 := by
        rw [← ha_cl]
        have h_hom := Polynomial.hom_eval₂ P_et.g (RingHom.id R_bar) π_cl a
        rw [RingHom.comp_id] at h_hom
        exact h_hom.symm.trans hg0
      exact hc₀_map.2.ne_zero h1
    have ha_map : P_et.HasMap a := ⟨by simpa using ha_f, by simpa using ha_g_unit⟩

    let e_pres : P_et.Ring ≃ₐ[R_bar] E_loc :=
      AlgEquiv.ofBijective (P_et.lift pres.x pres.hasMap) pres.lift_bijective
    let τ_loc : E_loc →ₐ[R_bar] R_bar := (P_et.lift a ha_map).comp e_pres.symm.toAlgHom
    let τ_E : E_alg →+* R_bar := τ_loc.toRingHom.comp (algebraMap E_alg E_loc)
    refine ⟨τ_E, ?_, ?_⟩
    · ext r
      change τ_loc (algebraMap E_alg E_loc (algebraMap R_bar E_alg r)) = r
      rw [← IsScalarTower.algebraMap_apply R_bar E_alg E_loc]
      exact τ_loc.commutes r
    · have h_alg_eq : (Algebra.ofId R_bar k).comp (P_et.lift a ha_map) =
          χ_alg.comp (P_et.lift pres.x pres.hasMap) := by
        apply StandardEtalePair.hom_ext
        simp only [AlgHom.comp_apply, StandardEtalePair.lift_X]
        exact ha_cl
      ext y
      change (Algebra.ofId R_bar k)
        ((P_et.lift a ha_map) (e_pres.symm (algebraMap E_alg E_loc y))) = χ₀ y
      have h1 := AlgHom.congr_fun h_alg_eq (e_pres.symm (algebraMap E_alg E_loc y))
      simp only [AlgHom.comp_apply] at h1
      rw [h1]
      have h2 : (P_et.lift pres.x pres.hasMap) (e_pres.symm (algebraMap E_alg E_loc y)) =
          algebraMap E_alg E_loc y := e_pres.apply_symm_apply _
      rw [h2]; exact RingHom.congr_fun hχ_loc_E y

  have hPointedSchemeLift :
      ∀ {S W₀ : AlgebraicGeometry.Scheme.{u}} (w₀ : W₀ ⟶ S) [AlgebraicGeometry.Etale w₀]
        (g_S : AlgebraicGeometry.Spec (CommRingCat.of R_bar) ⟶ S)
        (s_tilde : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ W₀),
      s_tilde ≫ w₀ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_cl) ≫ g_S →
      ∃ g_tilde : AlgebraicGeometry.Spec (CommRingCat.of R_bar) ⟶ W₀,
        g_tilde ≫ w₀ = g_S ∧
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_cl) ≫ g_tilde = s_tilde := by
    intro S W₀ w₀ _ g_S s_tilde hcomm
    let S_R := AlgebraicGeometry.Spec (CommRingCat.of R_bar)
    let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
    let i_cl : S_k ⟶ S_R := AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_cl)
    let W_R := CategoryTheory.Limits.pullback w₀ g_S
    let fst_W : W_R ⟶ W₀ := CategoryTheory.Limits.pullback.fst w₀ g_S
    let snd_W : W_R ⟶ S_R := CategoryTheory.Limits.pullback.snd w₀ g_S
    let σ₀ : S_k ⟶ W_R := CategoryTheory.Limits.pullback.lift s_tilde i_cl hcomm

    let pt_k : ↥S_k := (⊥ : PrimeSpectrum k)
    obtain ⟨U_W, hAff_UW, hy_UW, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
        (U := (⊤ : W_R.Opens)) (x := σ₀.base pt_k) trivial
    have hRange_σ₀ : Set.range σ₀.base ⊆ Set.range hAff_UW.fromSpec.base := by
      rw [hAff_UW.range_fromSpec]
      rintro _ ⟨z, rfl⟩
      rw [Subsingleton.elim z pt_k]; exact hy_UW
    let σ_E : S_k ⟶ AlgebraicGeometry.Spec (W_R.presheaf.obj (Opposite.op U_W)) :=
      AlgebraicGeometry.IsOpenImmersion.lift hAff_UW.fromSpec σ₀ hRange_σ₀
    have hσ_E_fac : σ_E ≫ hAff_UW.fromSpec = σ₀ :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac hAff_UW.fromSpec σ₀ hRange_σ₀

    let E_cat := W_R.presheaf.obj (Opposite.op U_W)
    let f_aff : AlgebraicGeometry.Spec E_cat ⟶ S_R := hAff_UW.fromSpec ≫ snd_W
    haveI : AlgebraicGeometry.Etale f_aff := inferInstance
    let φ_mor : CommRingCat.of R_bar ⟶ E_cat := AlgebraicGeometry.Spec.preimage f_aff
    have hφ_spec : AlgebraicGeometry.Spec.map φ_mor = f_aff :=
      AlgebraicGeometry.Spec.map_preimage f_aff
    have hφ_et : φ_mor.hom.Etale :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
        (hφ_spec.symm ▸ (inferInstance : AlgebraicGeometry.Etale f_aff))

    let χ_mor : E_cat ⟶ CommRingCat.of k := AlgebraicGeometry.Spec.preimage σ_E
    have hχ_spec : AlgebraicGeometry.Spec.map χ_mor = σ_E :=
      AlgebraicGeometry.Spec.map_preimage σ_E
    have hχ_comp_φ : χ_mor.hom.comp φ_mor.hom = π_cl := by
      have h_map : AlgebraicGeometry.Spec.map (φ_mor ≫ χ_mor) = i_cl := by
        rw [AlgebraicGeometry.Spec.map_comp, hχ_spec, hφ_spec]
        dsimp only [f_aff]
        rw [← Category.assoc, hσ_E_fac]
        exact CategoryTheory.Limits.pullback.lift_snd s_tilde i_cl hcomm
      have h_hom := AlgebraicGeometry.Spec.map_injective h_map
      ext r; exact ConcreteCategory.congr_hom h_hom r

    obtain ⟨τ_E, hτ_id, hτ_cl⟩ :=
      hPointedEtaleLiftAlg ↑E_cat φ_mor.hom hφ_et χ_mor.hom hχ_comp_φ
    let τ_mor : E_cat ⟶ CommRingCat.of R_bar := CommRingCat.ofHom τ_E
    let g_tilde : S_R ⟶ W₀ := AlgebraicGeometry.Spec.map τ_mor ≫ hAff_UW.fromSpec ≫ fst_W
    refine ⟨g_tilde, ?_, ?_⟩
    · dsimp only [g_tilde, fst_W]
      rw [Category.assoc, Category.assoc, CategoryTheory.Limits.pullback.condition]
      change AlgebraicGeometry.Spec.map τ_mor ≫ f_aff ≫ g_S = g_S
      rw [← hφ_spec, ← Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
      have h_id_mor : φ_mor ≫ τ_mor = 𝟙 (CommRingCat.of R_bar) := CommRingCat.hom_ext hτ_id
      rw [h_id_mor, AlgebraicGeometry.Spec.map_id, Category.id_comp]
    · dsimp only [g_tilde]
      rw [← Category.assoc, ← Category.assoc]
      have h_cl_mor : τ_mor ≫ CommRingCat.ofHom π_cl = χ_mor := CommRingCat.hom_ext hτ_cl
      have h_spec_eq : i_cl ≫ AlgebraicGeometry.Spec.map τ_mor = σ_E := by
        dsimp only [i_cl]; rw [← AlgebraicGeometry.Spec.map_comp, h_cl_mor, hχ_spec]
      rw [h_spec_eq, Category.assoc, ← Category.assoc σ_E, hσ_E_fac]
      exact CategoryTheory.Limits.pullback.lift_fst s_tilde i_cl hcomm

  
  
  
  let ℐ : Type u := { B : Subalgebra P R_bar // IsGoodStage B }
  letI : Preorder ℐ := Preorder.lift Subtype.val
  letI : CategoryTheory.SmallCategory ℐ := Preorder.smallCategory ℐ

  have hStageGenSet : ∀ i : ℐ, ∃ G_i : Finset R_bar,
      ∀ C : Subalgebra P R_bar, (G_i : Set R_bar) ⊆ (C : Set R_bar) → i.1 ≤ C := by
    intro i
    rcases i.2 with ⟨ϖ, u, e, ψ, _, _, _, hψ_C, _, hψ_et, _⟩
    obtain ⟨S₀, hS₀_top⟩ := hEtaleFinGenK ↥i.1 ψ hψ_et
    refine ⟨S₀.image i.1.val, fun C hC_sub => ?_⟩
    let R' : Subring ↥i.1 := C.toSubring.comap i.1.val.toRingHom
    have hR'_k : Set.range (ψ.comp Polynomial.C) ⊆ (R' : Set ↥i.1) := by
      rintro _ ⟨c, rfl⟩
      change i.1.val ((ψ.comp Polynomial.C) c) ∈ C
      rw [hψ_C, RingHom.comp_apply]
      have h1 : i.1.val (algebraMap P ↥i.1 (Polynomial.C c)) = algebraMap P R_bar (Polynomial.C c) :=
        i.1.val.commutes (Polynomial.C c)
      rw [h1]; exact C.algebraMap_mem (Polynomial.C c)
    have hR'_S : (S₀ : Set ↥i.1) ⊆ (R' : Set ↥i.1) := fun s hs =>
      hC_sub (Finset.mem_image_of_mem _ hs)
    have htop : R' = ⊤ := hS₀_top R' hR'_k hR'_S
    intro x hx
    have hmem : (⟨x, hx⟩ : ↥i.1) ∈ R' := by rw [htop]; trivial
    exact hmem

  have hFilt_ℐ : CategoryTheory.IsFiltered ℐ := by
    refine
      { toIsFilteredOrEmpty :=
          { cocone_objs := fun i₁ i₂ => ?_
            cocone_maps := fun {i₁ i₂} f g => ⟨i₂, 𝟙 i₂, by rw [Subsingleton.elim f g]⟩ }
        nonempty := ?_ }
    · obtain ⟨G₁, hG₁⟩ := hStageGenSet i₁
      obtain ⟨G₂, hG₂⟩ := hStageGenSet i₂
      obtain ⟨B₃, hB₃_sub, hB₃_good⟩ := hGoodSuperset (G₁ ∪ G₂)
      rw [Finset.coe_union, Set.union_subset_iff] at hB₃_sub
      exact ⟨⟨B₃, hB₃_good⟩, homOfLE (hG₁ B₃ hB₃_sub.1), homOfLE (hG₂ B₃ hB₃_sub.2), trivial⟩
    · obtain ⟨B₀, _, hB₀_good⟩ := hGoodSuperset ∅
      exact ⟨⟨B₀, hB₀_good⟩⟩
  letI : CategoryTheory.IsFiltered ℐ := hFilt_ℐ

  let D : ℐ ⥤ CommRingCat.{u} :=
    { obj := fun i => CommRingCat.of ↥i.1
      map := fun {i j} h => CommRingCat.ofHom (Subalgebra.inclusion (leOfHom h)).toRingHom
      map_id := fun i => by apply CommRingCat.hom_ext; ext x; rfl
      map_comp := fun f g => by apply CommRingCat.hom_ext; ext x; rfl }

  let α : (CategoryTheory.Functor.const ℐ).obj (CommRingCat.of P) ⟶ D :=
    { app := fun i => CommRingCat.ofHom (algebraMap P ↥i.1)
      naturality := fun i j h => by
        apply CommRingCat.hom_ext; apply RingHom.ext; intro q
        simp only [CategoryTheory.Functor.const_obj_obj, CategoryTheory.Functor.const_obj_map,
          Category.id_comp, D, CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply]
        exact ((Subalgebra.inclusion (leOfHom h)).commutes q).symm }

  let c : CategoryTheory.Limits.Cocone D :=
    { pt := CommRingCat.of R_bar
      ι :=
        { app := fun i => CommRingCat.ofHom i.1.val.toRingHom
          naturality := fun i j h => by apply CommRingCat.hom_ext; ext x; rfl } }

  have hCover : ∀ x : R_bar, ∃ i : ℐ, x ∈ i.1 := by
    intro x
    obtain ⟨B_x, hBx_sub, hBx_good⟩ := hGoodSuperset {x}
    exact ⟨⟨B_x, hBx_good⟩, hBx_sub (Finset.mem_singleton_self x)⟩

  have hCompat : ∀ (s : CategoryTheory.Limits.Cocone D) (i₁ i₂ : ℐ)
      (x : R_bar) (hx₁ : x ∈ i₁.1) (hx₂ : x ∈ i₂.1),
      (s.ι.app i₁).hom ⟨x, hx₁⟩ = (s.ι.app i₂).hom ⟨x, hx₂⟩ := by
    intro s i₁ i₂ x hx₁ hx₂
    let i₃ := CategoryTheory.IsFiltered.max i₁ i₂
    let θ₁ : i₁ ⟶ i₃ := CategoryTheory.IsFiltered.leftToMax i₁ i₂
    let θ₂ : i₂ ⟶ i₃ := CategoryTheory.IsFiltered.rightToMax i₁ i₂
    have hw₁ := ConcreteCategory.congr_hom (s.w θ₁) ⟨x, hx₁⟩
    have hw₂ := ConcreteCategory.congr_hom (s.w θ₂) ⟨x, hx₂⟩
    exact hw₁.symm.trans hw₂

  have hc_colim : CategoryTheory.Limits.IsColimit c :=
    { desc := fun s =>
        CommRingCat.ofHom
          { toFun := fun x =>
              (s.ι.app (Classical.choose (hCover x))).hom ⟨x, Classical.choose_spec (hCover x)⟩
            map_one' := by
              obtain ⟨i₀⟩ := hFilt_ℐ.nonempty
              rw [hCompat s _ i₀ 1 _ i₀.1.one_mem]
              exact map_one (s.ι.app i₀).hom
            map_mul' := fun x y => by
              let i_x := Classical.choose (hCover x)
              let i_y := Classical.choose (hCover y)
              let i_m := CategoryTheory.IsFiltered.max i_x i_y
              have hx_m : x ∈ i_m.1 :=
                leOfHom (CategoryTheory.IsFiltered.leftToMax i_x i_y)
                  (Classical.choose_spec (hCover x))
              have hy_m : y ∈ i_m.1 :=
                leOfHom (CategoryTheory.IsFiltered.rightToMax i_x i_y)
                  (Classical.choose_spec (hCover y))
              rw [hCompat s _ i_m (x * y) _ (i_m.1.mul_mem hx_m hy_m),
                hCompat s _ i_m x _ hx_m, hCompat s _ i_m y _ hy_m]
              exact map_mul (s.ι.app i_m).hom ⟨x, hx_m⟩ ⟨y, hy_m⟩
            map_zero' := by
              obtain ⟨i₀⟩ := hFilt_ℐ.nonempty
              rw [hCompat s _ i₀ 0 _ i₀.1.zero_mem]
              exact map_zero (s.ι.app i₀).hom
            map_add' := fun x y => by
              let i_x := Classical.choose (hCover x)
              let i_y := Classical.choose (hCover y)
              let i_m := CategoryTheory.IsFiltered.max i_x i_y
              have hx_m : x ∈ i_m.1 :=
                leOfHom (CategoryTheory.IsFiltered.leftToMax i_x i_y)
                  (Classical.choose_spec (hCover x))
              have hy_m : y ∈ i_m.1 :=
                leOfHom (CategoryTheory.IsFiltered.rightToMax i_x i_y)
                  (Classical.choose_spec (hCover y))
              rw [hCompat s _ i_m (x + y) _ (i_m.1.add_mem hx_m hy_m),
                hCompat s _ i_m x _ hx_m, hCompat s _ i_m y _ hy_m]
              exact map_add (s.ι.app i_m).hom ⟨x, hx_m⟩ ⟨y, hy_m⟩ }
      fac := fun s j => by
        apply CommRingCat.hom_ext; ext y
        simp only [c, CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply,
          RingHom.coe_mk, MonoidHom.coe_mk, OneHom.coe_mk]
        exact hCompat s _ j y.1 _ y.2
      uniq := fun s m hm => by
        apply CommRingCat.hom_ext; ext x
        exact ConcreteCategory.congr_hom (hm (Classical.choose (hCover x)))
          ⟨x, Classical.choose_spec (hCover x)⟩ }

  let e_pt : c.pt ≅ CommRingCat.of R_bar := CategoryTheory.Iso.refl (CommRingCat.of R_bar)

  refine ⟨R_bar, hCR_R, hDom_R, hLoc_R,
    p_R, t_bar, π_cl, φ_R_Ω,
    ℐ, inferInstance, hFilt_ℐ, D, α, c, hc_colim, e_pt,
    ⟨ht_eq, hπ_pR, hφ_pR, hφ_inj, hLocAway⟩, ⟨?_, ?_⟩, ?_⟩
  · intro i
    refine ⟨?_, ?_⟩
    · apply CommRingCat.hom_ext; apply RingHom.ext; intro q
      exact i.1.val.commutes q
    · exact Subtype.val_injective
  · intro i
    rcases i.2 with ⟨ϖ, u, e, ψ_i, he, hϖ_max, hX_eq, hψ_C, hψ_X, hψ_et, h_val⟩
    obtain ⟨B₁, hle, β₁, ψ₁, hGood₁, hincl_ϖ, hψ₁_C, hψ₁_X, hψ₁_et⟩ :=
      hKummerExt i.1 i.2 ϖ u e ψ_i he hϖ_max hX_eq hψ_C hψ_X hψ_et h_val
    refine ⟨ϖ, u, e, ψ_i, he, hϖ_max, hX_eq, hψ_C, hψ_X, hψ_et,
      ⟨B₁, hGood₁⟩, homOfLE hle, β₁, ψ₁, hincl_ϖ, hψ₁_C, hψ₁_X, hψ₁_et⟩
  · intro S W₀ w₀ _ g_S s_tilde hcomm
    exact hPointedSchemeLift w₀ g_S s_tilde hcomm

theorem weil_odp_val_acyc_affine_etale_colimit_and_kummer_stage_descent (k : Type u) [Field k]
    (d_rel ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (R_bar : Type u) [CommRing R_bar] [IsDomain R_bar] [IsLocalRing R_bar]
    (p_R : Polynomial k →+* R_bar)
    (t_bar : R_bar) (ht_eq : p_R Polynomial.X = t_bar)
    (Ω : Type u) [Field Ω]
    (φ_R_Ω : R_bar →+* Ω) (hLoc : @IsLocalization.Away R_bar _ t_bar Ω _ φ_R_Ω.toAlgebra)
    (ℐ : Type u) [CategoryTheory.SmallCategory ℐ] [CategoryTheory.IsFiltered ℐ]
    (D : ℐ ⥤ CommRingCat.{u})
    (α : (CategoryTheory.Functor.const ℐ).obj (CommRingCat.of (Polynomial k)) ⟶ D)
    (c : CategoryTheory.Limits.Cocone D) (hc : CategoryTheory.Limits.IsColimit c)
    (e_pt : c.pt ≅ CommRingCat.of R_bar)
    (hCocone : ∀ i : ℐ,
      (α.app i) ≫ (c.ι.app i) ≫ e_pt.hom = CommRingCat.ofHom p_R ∧
      Function.Injective ((c.ι.app i) ≫ e_pt.hom).hom)
    (hStage : ∀ i : ℐ,
      ∃ (ϖ : ↑(D.obj i)) (u : (↑(D.obj i))ˣ) (e : ℕ)
        (ψ_i : Polynomial k →+* ↑(D.obj i)),
        1 ≤ e ∧
        ((c.ι.app i) ≫ e_pt.hom).hom ϖ ∈ IsLocalRing.maximalIdeal R_bar ∧
        (α.app i).hom Polynomial.X = ↑u * ϖ ^ e ∧
        ψ_i.comp Polynomial.C = (α.app i).hom.comp Polynomial.C ∧
        ψ_i Polynomial.X = ϖ ∧
        ψ_i.Etale ∧
        ∃ (i₁ : ℐ) (θ : i ⟶ i₁) (β : ↑(D.obj i₁))
          (ψ₁ : Polynomial k →+* ↑(D.obj i₁)),
          (D.map θ).hom ϖ = β ^ ℓ ∧
          ψ₁.comp Polynomial.C = (α.app i₁).hom.comp Polynomial.C ∧
          ψ₁ Polynomial.X = β ∧
          ψ₁.Etale) :
    let S_d := weilAffineSpaceOver k d_rel
    let A1_k := AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))
    let Gm_k := AlgebraicGeometry.Spec
      (CommRingCat.of (Localization.Away (Polynomial.X : Polynomial k)))
    let j_Gm : Gm_k ⟶ A1_k := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap (Polynomial k)
        (Localization.Away (Polynomial.X : Polynomial k))))
    let κ_A1 : A1_k ⟶ A1_k := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom ((Polynomial.aeval ((Polynomial.X : Polynomial k) ^ ℓ)).toRingHom))
    let p_A1 : A1_k ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k))
    let Y_d := CategoryTheory.Limits.pullback S_d.hom p_A1
    let j_d := CategoryTheory.Limits.pullback.snd j_Gm
      (CategoryTheory.Limits.pullback.snd S_d.hom p_A1)
    let g_k_R : AlgebraicGeometry.Spec (CommRingCat.of R_bar) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of k) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (p_R.comp Polynomial.C))
    let j_R : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of R_bar) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R_Ω)
    let A_R := CategoryTheory.Limits.pullback S_d.hom g_k_R
    let j_A := CategoryTheory.Limits.pullback.snd j_R
      (CategoryTheory.Limits.pullback.snd S_d.hom g_k_R)
    ∀ (W : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W]
      (w : W ⟶ A_R) [AlgebraicGeometry.Etale w],
      ∃ (𝒥 : Type u) (_ : CategoryTheory.SmallCategory 𝒥) (_ : CategoryTheory.IsFiltered 𝒥)
        (E_diag U_diag : 𝒥 ⥤ CommRingCat.{u})
        (lam_diag : E_diag ⟶ U_diag)
        (c_W : CategoryTheory.Limits.Cocone E_diag) (_ : CategoryTheory.Limits.IsColimit c_W)
        (c_U : CategoryTheory.Limits.Cocone U_diag) (_ : CategoryTheory.Limits.IsColimit c_U)
        (lam_inf : c_W.pt ⟶ c_U.pt)
        (e_W : AlgebraicGeometry.Spec c_W.pt ≅ W)
        (e_WU : AlgebraicGeometry.Spec c_U.pt ≅ CategoryTheory.Limits.pullback j_A w),
        ((e_WU.hom ≫ CategoryTheory.Limits.pullback.snd j_A w =
            AlgebraicGeometry.Spec.map lam_inf ≫ e_W.hom) ∧
          (∀ j : 𝒥, (c_W.ι.app j) ≫ lam_inf = (lam_diag.app j) ≫ (c_U.ι.app j))) ∧
        (∀ j : 𝒥,
          ∃ (w_j : AlgebraicGeometry.Spec (E_diag.obj j) ⟶ Y_d) (_ : AlgebraicGeometry.Etale w_j)
            (e_Uj : AlgebraicGeometry.Spec (U_diag.obj j) ≅ CategoryTheory.Limits.pullback j_d w_j),
            (e_Uj.hom ≫ CategoryTheory.Limits.pullback.snd j_d w_j =
              AlgebraicGeometry.Spec.map (lam_diag.app j)) ∧
            CategoryTheory.IsPullback
              (e_WU.inv ≫ AlgebraicGeometry.Spec.map (c_U.ι.app j) ≫ e_Uj.hom)
              (CategoryTheory.Limits.pullback.snd j_A w)
              (CategoryTheory.Limits.pullback.snd j_d w_j)
              (e_W.inv ≫ AlgebraicGeometry.Spec.map (c_W.ι.app j)) ∧
            ∃ (j₁ : 𝒥) (θ : j ⟶ j₁)
              (w₁ : AlgebraicGeometry.Spec (E_diag.obj j₁) ⟶ Y_d) (_ : AlgebraicGeometry.Etale w₁)
              (e_Uj₁ : AlgebraicGeometry.Spec (U_diag.obj j₁) ≅ CategoryTheory.Limits.pullback j_d w₁),
              (e_Uj₁.hom ≫ CategoryTheory.Limits.pullback.snd j_d w₁ =
                AlgebraicGeometry.Spec.map (lam_diag.app j₁)) ∧
              CategoryTheory.IsPullback
                (e_WU.inv ≫ AlgebraicGeometry.Spec.map (c_U.ι.app j₁) ≫ e_Uj₁.hom)
                (CategoryTheory.Limits.pullback.snd j_A w)
                (CategoryTheory.Limits.pullback.snd j_d w₁)
                (e_W.inv ≫ AlgebraicGeometry.Spec.map (c_W.ι.app j₁)) ∧
              (AlgebraicGeometry.Spec.map (E_diag.map θ) ≫ w_j ≫
                  CategoryTheory.Limits.pullback.fst S_d.hom p_A1 =
                w₁ ≫ CategoryTheory.Limits.pullback.fst S_d.hom p_A1) ∧
              (AlgebraicGeometry.Spec.map (E_diag.map θ) ≫ w_j ≫
                  CategoryTheory.Limits.pullback.snd S_d.hom p_A1 =
                w₁ ≫ CategoryTheory.Limits.pullback.snd S_d.hom p_A1 ≫ κ_A1)) :=
by
  classical
  
  have hAwayOfAlgebraMap :
      ∀ {R : Type u} [CommRing R] (r : R),
        @IsLocalization.Away R _ r (Localization.Away r) _
          (algebraMap R (Localization.Away r)).toAlgebra := by
    clear * -
    intro R _ r
    have h_eq : (algebraMap R (Localization.Away r)).toAlgebra =
        (inferInstance : Algebra R (Localization.Away r)) :=
      Algebra.algebra_ext _ _ (fun _ => rfl)
    rw [h_eq]
    infer_instance

  
  have hEtalePresentationDescent :
      ∀ {ℐ₀ : Type u} [CategoryTheory.SmallCategory ℐ₀] [CategoryTheory.IsFiltered ℐ₀]
        (B : ℐ₀ ⥤ CommRingCat.{u})
        (c₀ : CategoryTheory.Limits.Cocone B) (_ : CategoryTheory.Limits.IsColimit c₀)
        (E_inf : CommRingCat.{u}) (f_E : c₀.pt ⟶ E_inf),
        (f_E.hom).Etale →
        ∃ (i₀ : ℐ₀) (E₀ : CommRingCat.{u}) (f₀ : B.obj i₀ ⟶ E₀) (g₀ : E₀ ⟶ E_inf),
          (f₀.hom).Etale ∧ CategoryTheory.IsPushout (c₀.ι.app i₀) f₀ f_E g₀ := by
    clear * -
    intro ℐ₀ _ _ B c₀ hc₀ E_inf f_E hf_E
    let F_fgt := CategoryTheory.forget CommRingCat.{u}
    let hc_type : CategoryTheory.Limits.IsColimit (F_fgt.mapCocone c₀) :=
      CategoryTheory.Limits.isColimitOfPreserves F_fgt hc₀
    have hNonemptyℐ : Nonempty ℐ₀ := CategoryTheory.IsFiltered.nonempty
    have hLiftSet₀ : ∀ {α : Type} (S : Finset α) (x : α → ↑c₀.pt),
        ∃ (i : ℐ₀) (y : α → ↑(B.obj i)),
          ∀ a ∈ S, (CommRingCat.Hom.hom (c₀.ι.app i)) (y a) = x a := by
      intro α S x
      induction S using Finset.induction_on with
      | empty =>
        obtain ⟨i₀⟩ := hNonemptyℐ
        exact ⟨i₀, fun _ => 0, fun _ h => False.elim (Finset.notMem_empty _ h)⟩
      | insert a₀ S' ha₀ ih =>
        obtain ⟨i₁, y₁, hy₁⟩ := ih
        obtain ⟨i₂, z, hz⟩ :=
          CategoryTheory.Limits.Types.jointly_surjective (B ⋙ F_fgt) hc_type (x a₀)
        have hz' : (CommRingCat.Hom.hom (c₀.ι.app i₂)) z = x a₀ := hz
        let i₃ := CategoryTheory.IsFiltered.max i₁ i₂
        let u₁ : i₁ ⟶ i₃ := CategoryTheory.IsFiltered.leftToMax i₁ i₂
        let u₂ : i₂ ⟶ i₃ := CategoryTheory.IsFiltered.rightToMax i₁ i₂
        refine ⟨i₃, fun a => if a = a₀ then (CommRingCat.Hom.hom (B.map u₂)) z
            else (CommRingCat.Hom.hom (B.map u₁)) (y₁ a), ?_⟩
        intro a ha
        rcases Finset.mem_insert.mp ha with rfl | haS'
        · simp only [↓reduceIte]
          have hw₂ := congrArg (fun g => (CommRingCat.Hom.hom g) z) (c₀.w u₂)
          exact hw₂.trans hz'
        · have hne : a ≠ a₀ := fun h => ha₀ (h ▸ haS')
          simp only [hne, ↓reduceIte]
          have hw₁ := congrArg (fun g => (CommRingCat.Hom.hom g) (y₁ a)) (c₀.w u₁)
          exact hw₁.trans (hy₁ a haS')
    have hZeroSet₀ : ∀ {α : Type} (S : Finset α) (i₁ : ℐ₀) (y : α → ↑(B.obj i₁)),
        (∀ a ∈ S, (CommRingCat.Hom.hom (c₀.ι.app i₁)) (y a) = 0) →
        ∃ (i₀ : ℐ₀) (θ : i₁ ⟶ i₀), ∀ a ∈ S, (CommRingCat.Hom.hom (B.map θ)) (y a) = 0 := by
      intro α S i₁ y hy
      induction S using Finset.induction_on with
      | empty =>
        exact ⟨i₁, 𝟙 i₁, fun _ h => False.elim (Finset.notMem_empty _ h)⟩
      | insert a₀ S' ha₀ ih =>
        obtain ⟨i₂, θ₁, hθ₁⟩ := ih (fun a ha => hy a (Finset.mem_insert_of_mem ha))
        have h_eq₀ : (CategoryTheory.ConcreteCategory.hom ((F_fgt.mapCocone c₀).ι.app i₂))
            ((CommRingCat.Hom.hom (B.map θ₁)) (y a₀)) =
          (CategoryTheory.ConcreteCategory.hom ((F_fgt.mapCocone c₀).ι.app i₂)) (0 : ↑(B.obj i₂)) := by
          change (CommRingCat.Hom.hom (c₀.ι.app i₂)) ((CommRingCat.Hom.hom (B.map θ₁)) (y a₀)) =
            (CommRingCat.Hom.hom (c₀.ι.app i₂)) 0
          rw [map_zero]
          have hw := congrArg (fun g => (CommRingCat.Hom.hom g) (y a₀)) (c₀.w θ₁)
          exact hw.trans (hy a₀ (Finset.mem_insert_self a₀ S'))
        obtain ⟨i₀, θ₂, hθ₂⟩ :=
          (CategoryTheory.Limits.Types.FilteredColimit.isColimit_eq_iff' hc_type _ _).mp h_eq₀
        have hθ₂' : (CommRingCat.Hom.hom (B.map θ₂)) ((CommRingCat.Hom.hom (B.map θ₁)) (y a₀)) = 0 := by
          have h₁ : (CommRingCat.Hom.hom (B.map θ₂)) ((CommRingCat.Hom.hom (B.map θ₁)) (y a₀)) =
              (CommRingCat.Hom.hom (B.map θ₂)) 0 := hθ₂
          rwa [map_zero] at h₁
        refine ⟨i₀, θ₁ ≫ θ₂, ?_⟩
        intro a ha
        rw [Functor.map_comp, CommRingCat.hom_comp, RingHom.comp_apply]
        rcases Finset.mem_insert.mp ha with rfl | haS'
        · exact hθ₂'
        · rw [hθ₁ a haS', map_zero]
    have hLiftPoly : ∀ {n : ℕ} (p : MvPolynomial (Fin n) ↑c₀.pt),
        ∃ (i : ℐ₀) (p_lift : MvPolynomial (Fin n) ↑(B.obj i)),
          MvPolynomial.map (CommRingCat.Hom.hom (c₀.ι.app i)) p_lift = p := by
      intro n p
      obtain ⟨i, y, hy⟩ := hLiftSet₀ p.support (fun m => p.coeff m)
      refine ⟨i, ∑ m ∈ p.support, MvPolynomial.monomial m (y m), ?_⟩
      ext m
      rw [MvPolynomial.coeff_map, MvPolynomial.coeff_sum]
      simp only [MvPolynomial.coeff_monomial]
      by_cases hm : m ∈ p.support
      · rw [Finset.sum_eq_single m
          (fun x _ hxm => by simp only [hxm, ↓reduceIte])
          (fun h => absurd hm h)]
        simp only [↓reduceIte]
        exact hy m hm
      · have hsum0 : (∑ x ∈ p.support, if x = m then y x else 0) = 0 := by
          refine Finset.sum_eq_zero fun x hx => ?_
          have hxm : x ≠ m := fun h => hm (h ▸ hx)
          simp only [hxm, ↓reduceIte]
        rw [hsum0, map_zero, MvPolynomial.notMem_support_iff.mp hm]
    have hLiftPolyFam : ∀ {n r : ℕ} (F : Fin r → MvPolynomial (Fin n) ↑c₀.pt),
        ∃ (i : ℐ₀) (F_lift : Fin r → MvPolynomial (Fin n) ↑(B.obj i)),
          ∀ s : Fin r, MvPolynomial.map (CommRingCat.Hom.hom (c₀.ι.app i)) (F_lift s) = F s := by
      intro n r F
      suffices ∀ (T : Finset (Fin r)),
          ∃ (i : ℐ₀) (F_lift : Fin r → MvPolynomial (Fin n) ↑(B.obj i)),
            ∀ s ∈ T, MvPolynomial.map (CommRingCat.Hom.hom (c₀.ι.app i)) (F_lift s) = F s by
        obtain ⟨i, F_lift, hF⟩ := this Finset.univ
        exact ⟨i, F_lift, fun s => hF s (Finset.mem_univ s)⟩
      intro T
      induction T using Finset.induction_on with
      | empty =>
        obtain ⟨i₀⟩ := hNonemptyℐ
        exact ⟨i₀, fun _ => 0, fun _ h => False.elim (Finset.notMem_empty _ h)⟩
      | insert s₀ T' hs₀ ih =>
        obtain ⟨i₁, F₁, hF₁⟩ := ih
        obtain ⟨i₂, p₂, hp₂⟩ := hLiftPoly (F s₀)
        let i₃ := CategoryTheory.IsFiltered.max i₁ i₂
        let u₁ : i₁ ⟶ i₃ := CategoryTheory.IsFiltered.leftToMax i₁ i₂
        let u₂ : i₂ ⟶ i₃ := CategoryTheory.IsFiltered.rightToMax i₁ i₂
        refine ⟨i₃, fun s => if s = s₀ then MvPolynomial.map (CommRingCat.Hom.hom (B.map u₂)) p₂
            else MvPolynomial.map (CommRingCat.Hom.hom (B.map u₁)) (F₁ s), ?_⟩
        intro s hs
        rcases Finset.mem_insert.mp hs with rfl | hsT'
        · simp only [↓reduceIte, MvPolynomial.map_map]
          have hw₂ : (CommRingCat.Hom.hom (c₀.ι.app i₃)).comp (CommRingCat.Hom.hom (B.map u₂)) =
              CommRingCat.Hom.hom (c₀.ι.app i₂) := by
            rw [← CommRingCat.hom_comp, c₀.w u₂]
          rw [hw₂, hp₂]
        · have hne : s ≠ s₀ := fun h => hs₀ (h ▸ hsT')
          simp only [hne, ↓reduceIte, MvPolynomial.map_map]
          have hw₁ : (CommRingCat.Hom.hom (c₀.ι.app i₃)).comp (CommRingCat.Hom.hom (B.map u₁)) =
              CommRingCat.Hom.hom (c₀.ι.app i₁) := by
            rw [← CommRingCat.hom_comp, c₀.w u₁]
          rw [hw₁, hF₁ s hsT']
    let _ : Algebra ↑c₀.pt ↑E_inf := (CommRingCat.Hom.hom f_E).toAlgebra
    have halg_fE : algebraMap (↑c₀.pt) (↑E_inf) = CommRingCat.Hom.hom f_E := rfl
    have hEt_inf : Algebra.Etale (↑c₀.pt) (↑E_inf) := by
      rw [← RingHom.etale_algebraMap, halg_fE]
      exact hf_E
    have hStd_inf : Algebra.IsStandardSmoothOfRelativeDimension 0 (↑c₀.pt) (↑E_inf) :=
      Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero.mp hEt_inf
    obtain ⟨ι, σ, hFin_σ, hFin_ι, P, hdim⟩ := hStd_inf.out
    let n : ℕ := Nat.card ι
    let r : ℕ := Nat.card σ
    let e_ι : Fin n ≃ ι := (Finite.equivFin ι).symm
    let e_σ : Fin r ≃ σ := (Finite.equivFin σ).symm
    let P₀ : Algebra.SubmersivePresentation (↑c₀.pt) (↑E_inf) (Fin n) (Fin r) :=
      P.reindex e_ι e_σ
    have hdim₀ : P₀.dimension = 0 := by
      rw [← hdim]
      exact P.toPresentation.dimension_reindex e_ι e_σ
    let R_inf : Fin r → MvPolynomial (Fin n) ↑c₀.pt := P₀.relation
    let g_inf : Fin r → MvPolynomial (Fin n) ↑c₀.pt := P₀.jacobianRelations
    let h_inf : MvPolynomial (Fin n) ↑c₀.pt := P₀.σ ↑(P₀.jacobian_isUnit.unit⁻¹)
    have hBezout_inf : ∑ s : Fin r, g_inf s * R_inf s = P₀.jacobiMatrix.det * h_inf - 1 :=
      P₀.jacobianRelations_spec
    obtain ⟨i_R, R_lift_R, hR_lift_R⟩ := hLiftPolyFam R_inf
    obtain ⟨i_g, g_lift_g, hg_lift_g⟩ := hLiftPolyFam g_inf
    obtain ⟨i_h, h_lift_h, hh_lift_h⟩ := hLiftPoly h_inf
    let i_Rg := CategoryTheory.IsFiltered.max i_R i_g
    let u_R : i_R ⟶ i_Rg := CategoryTheory.IsFiltered.leftToMax i_R i_g
    let u_g : i_g ⟶ i_Rg := CategoryTheory.IsFiltered.rightToMax i_R i_g
    let i₁ := CategoryTheory.IsFiltered.max i_Rg i_h
    let u_Rg : i_Rg ⟶ i₁ := CategoryTheory.IsFiltered.leftToMax i_Rg i_h
    let u_h : i_h ⟶ i₁ := CategoryTheory.IsFiltered.rightToMax i_Rg i_h
    let R_tilde : Fin r → MvPolynomial (Fin n) ↑(B.obj i₁) :=
      fun s => MvPolynomial.map (CommRingCat.Hom.hom (B.map (u_R ≫ u_Rg))) (R_lift_R s)
    let g_tilde : Fin r → MvPolynomial (Fin n) ↑(B.obj i₁) :=
      fun s => MvPolynomial.map (CommRingCat.Hom.hom (B.map (u_g ≫ u_Rg))) (g_lift_g s)
    let h_tilde : MvPolynomial (Fin n) ↑(B.obj i₁) :=
      MvPolynomial.map (CommRingCat.Hom.hom (B.map u_h)) h_lift_h
    have hR_tilde : ∀ s : Fin r,
        MvPolynomial.map (CommRingCat.Hom.hom (c₀.ι.app i₁)) (R_tilde s) = R_inf s := by
      intro s
      dsimp [R_tilde]
      rw [MvPolynomial.map_map, ← CommRingCat.hom_comp, c₀.w (u_R ≫ u_Rg), hR_lift_R s]
    have hg_tilde : ∀ s : Fin r,
        MvPolynomial.map (CommRingCat.Hom.hom (c₀.ι.app i₁)) (g_tilde s) = g_inf s := by
      intro s
      dsimp [g_tilde]
      rw [MvPolynomial.map_map, ← CommRingCat.hom_comp, c₀.w (u_g ≫ u_Rg), hg_lift_g s]
    have hh_tilde :
        MvPolynomial.map (CommRingCat.Hom.hom (c₀.ι.app i₁)) h_tilde = h_inf := by
      dsimp [h_tilde]
      rw [MvPolynomial.map_map, ← CommRingCat.hom_comp, c₀.w u_h, hh_lift_h]
    let J_mat₁ : Matrix (Fin r) (Fin r) (MvPolynomial (Fin n) ↑(B.obj i₁)) :=
      fun s₁ s₂ => MvPolynomial.pderiv (P₀.map s₁) (R_tilde s₂)
    have hJ_mat₁_map :
        (MvPolynomial.map (CommRingCat.Hom.hom (c₀.ι.app i₁))).mapMatrix J_mat₁ =
          P₀.jacobiMatrix := by
      refine Matrix.ext fun s₁ s₂ => ?_
      change MvPolynomial.map (CommRingCat.Hom.hom (c₀.ι.app i₁))
        (MvPolynomial.pderiv (P₀.map s₁) (R_tilde s₂)) = P₀.jacobiMatrix s₁ s₂
      rw [← MvPolynomial.pderiv_map, hR_tilde s₂, P₀.jacobiMatrix_apply]
    have hJ_det₁_map :
        MvPolynomial.map (CommRingCat.Hom.hom (c₀.ι.app i₁)) J_mat₁.det =
          P₀.jacobiMatrix.det := by
      rw [RingHom.map_det (MvPolynomial.map (CommRingCat.Hom.hom (c₀.ι.app i₁))) J_mat₁,
        hJ_mat₁_map]
    let Δ₁ : MvPolynomial (Fin n) ↑(B.obj i₁) :=
      (∑ s : Fin r, g_tilde s * R_tilde s) - (J_mat₁.det * h_tilde - 1)
    have hΔ₁_map : MvPolynomial.map (CommRingCat.Hom.hom (c₀.ι.app i₁)) Δ₁ = 0 := by
      dsimp [Δ₁]
      rw [map_sub, map_sum, map_sub, map_mul, map_one, hJ_det₁_map, hh_tilde]
      have hsum_eq : (∑ s : Fin r,
          MvPolynomial.map (CommRingCat.Hom.hom (c₀.ι.app i₁)) (g_tilde s * R_tilde s)) =
          ∑ s : Fin r, g_inf s * R_inf s := by
        refine Finset.sum_congr rfl fun s _ => ?_
        rw [map_mul, hg_tilde s, hR_tilde s]
      rw [hsum_eq, hBezout_inf, sub_self]
    have hΔ₁_coeff : ∀ m ∈ Δ₁.support,
        (CommRingCat.Hom.hom (c₀.ι.app i₁)) (Δ₁.coeff m) = 0 := by
      intro m _
      rw [← MvPolynomial.coeff_map, hΔ₁_map]
      simp
    obtain ⟨i₀, θ, hθ_zero⟩ := hZeroSet₀ Δ₁.support i₁ (fun m => Δ₁.coeff m) hΔ₁_coeff
    have hΔ₀ : MvPolynomial.map (CommRingCat.Hom.hom (B.map θ)) Δ₁ = 0 := by
      ext m
      rw [MvPolynomial.coeff_map]
      have h0 : (0 : MvPolynomial (Fin n) ↑(B.obj i₀)).coeff m = 0 := by simp
      rw [h0]
      by_cases hm : m ∈ Δ₁.support
      · exact hθ_zero m hm
      · rw [MvPolynomial.notMem_support_iff.mp hm, map_zero]
    let R₀ : Fin r → MvPolynomial (Fin n) ↑(B.obj i₀) :=
      fun s => MvPolynomial.map (CommRingCat.Hom.hom (B.map θ)) (R_tilde s)
    let g₀_poly : Fin r → MvPolynomial (Fin n) ↑(B.obj i₀) :=
      fun s => MvPolynomial.map (CommRingCat.Hom.hom (B.map θ)) (g_tilde s)
    let h₀_poly : MvPolynomial (Fin n) ↑(B.obj i₀) :=
      MvPolynomial.map (CommRingCat.Hom.hom (B.map θ)) h_tilde
    let J₀ : Ideal (MvPolynomial (Fin n) ↑(B.obj i₀)) := Ideal.span (Set.range R₀)
    let Q₀ := MvPolynomial (Fin n) ↑(B.obj i₀) ⧸ J₀
    let E₀ : CommRingCat.{u} := CommRingCat.of Q₀
    let f₀ : B.obj i₀ ⟶ E₀ :=
      CommRingCat.ofHom ((Ideal.Quotient.mk J₀).comp MvPolynomial.C)
    let s₀ : Q₀ → MvPolynomial (Fin n) ↑(B.obj i₀) :=
      Function.surjInv Ideal.Quotient.mk_surjective
    have hs₀ : ∀ x : Q₀, Ideal.Quotient.mk J₀ (s₀ x) = x :=
      Function.surjInv_eq Ideal.Quotient.mk_surjective
    let P_pre₀ : Algebra.PreSubmersivePresentation ↑(B.obj i₀) Q₀ (Fin n) (Fin r) :=
      Algebra.PreSubmersivePresentation.naive (v := R₀) P₀.map P₀.map_inj s₀ hs₀
    let J_mat₀ : Matrix (Fin r) (Fin r) (MvPolynomial (Fin n) ↑(B.obj i₀)) :=
      fun s₁ s₂ => MvPolynomial.pderiv (P₀.map s₁) (R₀ s₂)
    have hJ_mat₀_eq : P_pre₀.jacobiMatrix = J_mat₀ := by
      refine Matrix.ext fun s₁ s₂ => ?_
      exact Algebra.PreSubmersivePresentation.jacobiMatrix_naive (v := R₀)
        P₀.map P₀.map_inj s₀ hs₀ s₁ s₂
    have hJ_mat₁_to_0 :
        (MvPolynomial.map (CommRingCat.Hom.hom (B.map θ))).mapMatrix J_mat₁ = J_mat₀ := by
      refine Matrix.ext fun s₁ s₂ => ?_
      change MvPolynomial.map (CommRingCat.Hom.hom (B.map θ))
        (MvPolynomial.pderiv (P₀.map s₁) (R_tilde s₂)) =
        MvPolynomial.pderiv (P₀.map s₁)
          (MvPolynomial.map (CommRingCat.Hom.hom (B.map θ)) (R_tilde s₂))
      exact MvPolynomial.pderiv_map.symm
    have hJ_det₁_to_0 :
        MvPolynomial.map (CommRingCat.Hom.hom (B.map θ)) J_mat₁.det = J_mat₀.det := by
      rw [RingHom.map_det (MvPolynomial.map (CommRingCat.Hom.hom (B.map θ))) J_mat₁,
        hJ_mat₁_to_0]
    have hBezout₀ : ∑ s : Fin r, g₀_poly s * R₀ s = J_mat₀.det * h₀_poly - 1 := by
      have hsub : (∑ s : Fin r, g₀_poly s * R₀ s) - (J_mat₀.det * h₀_poly - 1) = 0 := by
        rw [← hΔ₀]
        dsimp [Δ₁, g₀_poly, R₀, h₀_poly]
        rw [map_sub, map_sum, map_sub, map_mul, map_one, hJ_det₁_to_0]
        congr 1
        exact Finset.sum_congr rfl fun s _ => (map_mul _ _ _).symm
      exact sub_eq_zero.mp hsub
    have halg_pre₀_apply : ∀ p : MvPolynomial (Fin n) ↑(B.obj i₀),
        (algebraMap P_pre₀.Ring Q₀) p = Ideal.Quotient.mk J₀ p := by
      have h_aeval : (MvPolynomial.aeval P_pre₀.val).toRingHom = Ideal.Quotient.mk J₀ := by
        apply MvPolynomial.ringHom_ext
        · intro b
          change (MvPolynomial.aeval P_pre₀.val) (MvPolynomial.C b) =
            Ideal.Quotient.mk J₀ (MvPolynomial.C b)
          rw [MvPolynomial.aeval_C]
          rfl
        · intro m
          change (MvPolynomial.aeval P_pre₀.val) (MvPolynomial.X m) =
            Ideal.Quotient.mk J₀ (MvPolynomial.X m)
          rw [MvPolynomial.aeval_X]
          rfl
      intro p
      rw [P_pre₀.algebraMap_apply]
      exact congrArg (fun h : MvPolynomial (Fin n) ↑(B.obj i₀) →+* Q₀ => h p) h_aeval
    have hJac_unit₀ : IsUnit P_pre₀.jacobian := by
      rw [P_pre₀.jacobian_eq_jacobiMatrix_det, halg_pre₀_apply, hJ_mat₀_eq]
      refine IsUnit.of_mul_eq_one (Ideal.Quotient.mk J₀ h₀_poly) ?_
      rw [← map_mul, ← sub_eq_zero]
      have hmk1 : (1 : Q₀) = Ideal.Quotient.mk J₀ 1 := rfl
      rw [hmk1, ← map_sub, ← hBezout₀, map_sum]
      refine Finset.sum_eq_zero fun s _ => ?_
      have hs_mem : R₀ s ∈ J₀ := Ideal.subset_span ⟨s, rfl⟩
      rw [map_mul, Ideal.Quotient.eq_zero_iff_mem.mpr hs_mem, mul_zero]
    let P_sub₀ : Algebra.SubmersivePresentation ↑(B.obj i₀) Q₀ (Fin n) (Fin r) :=
      { __ := P_pre₀, jacobian_isUnit := hJac_unit₀ }
    have hStd₀ : Algebra.IsStandardSmoothOfRelativeDimension 0 ↑(B.obj i₀) Q₀ :=
      P_sub₀.isStandardSmoothOfRelativeDimension hdim₀
    have hEt_Q₀ : Algebra.Etale ↑(B.obj i₀) Q₀ :=
      @Algebra.instEtaleOfIsStandardSmoothOfRelativeDimensionOfNatNat _ _ _ _ _ hStd₀
    have hf₀_et : (f₀.hom).Etale := by
      change ((Ideal.Quotient.mk J₀).comp MvPolynomial.C).Etale
      have halg_Q₀ : algebraMap (↑(B.obj i₀)) Q₀ = (Ideal.Quotient.mk J₀).comp MvPolynomial.C :=
        rfl
      rw [← halg_Q₀, RingHom.etale_algebraMap]
      exact hEt_Q₀
    let φ_inf : MvPolynomial (Fin n) ↑c₀.pt →+* ↑E_inf := (MvPolynomial.aeval P₀.val).toRingHom
    have hφ_ri : Function.RightInverse P₀.σ' ⇑φ_inf := fun x => P₀.aeval_val_σ' x
    have hker_φ : RingHom.ker φ_inf = Ideal.span (Set.range R_inf) := by
      change RingHom.ker (MvPolynomial.aeval P₀.val) = Ideal.span (Set.range P₀.relation)
      rw [← P₀.ker_eq_ker_aeval_val, P₀.span_range_relation_eq_ker]
    have hR₀_map_inf : ∀ s : Fin r,
        MvPolynomial.map (CommRingCat.Hom.hom (c₀.ι.app i₀)) (R₀ s) = R_inf s := by
      intro s
      dsimp [R₀]
      rw [MvPolynomial.map_map, ← CommRingCat.hom_comp, c₀.w θ, hR_tilde s]
    have hJ₀_le :
        J₀ ≤ RingHom.ker (φ_inf.comp (MvPolynomial.map (CommRingCat.Hom.hom (c₀.ι.app i₀)))) := by
      rw [Ideal.span_le]
      intro x hx
      obtain ⟨s, rfl⟩ := hx
      rw [SetLike.mem_coe, RingHom.mem_ker, RingHom.comp_apply, hR₀_map_inf s]
      exact RingHom.mem_ker.mp (hker_φ.symm ▸ Ideal.subset_span ⟨s, rfl⟩)
    have hJ₀_zero : ∀ a ∈ J₀,
        (φ_inf.comp (MvPolynomial.map (CommRingCat.Hom.hom (c₀.ι.app i₀)))) a = 0 :=
      fun a ha => RingHom.mem_ker.mp (hJ₀_le ha)
    let g₀_bar : Q₀ →+* ↑E_inf :=
      Ideal.Quotient.lift J₀ (φ_inf.comp (MvPolynomial.map (CommRingCat.Hom.hom (c₀.ι.app i₀))))
        hJ₀_zero
    let g₀ : E₀ ⟶ E_inf := CommRingCat.ofHom g₀_bar
    have hw_push : c₀.ι.app i₀ ≫ f_E = f₀ ≫ g₀ := by
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro b
      change (CommRingCat.Hom.hom f_E) ((CommRingCat.Hom.hom (c₀.ι.app i₀)) b) =
        g₀_bar (Ideal.Quotient.mk J₀ (MvPolynomial.C b))
      dsimp [g₀_bar]
      rw [Ideal.Quotient.lift_mk, RingHom.comp_apply, MvPolynomial.map_C]
      dsimp [φ_inf]
      rw [MvPolynomial.aeval_C, halg_fE]
    let ψ_of : ∀ (s : CategoryTheory.Limits.PushoutCocone (c₀.ι.app i₀) f₀),
        MvPolynomial (Fin n) ↑c₀.pt →+* ↑s.pt :=
      fun s => MvPolynomial.eval₂Hom (CommRingCat.Hom.hom s.inl)
        (fun m => (CommRingCat.Hom.hom s.inr) (Ideal.Quotient.mk J₀ (MvPolynomial.X m)))
    have hψ_comp : ∀ (s : CategoryTheory.Limits.PushoutCocone (c₀.ι.app i₀) f₀),
        (ψ_of s).comp (MvPolynomial.map (CommRingCat.Hom.hom (c₀.ι.app i₀))) =
          (CommRingCat.Hom.hom s.inr).comp (Ideal.Quotient.mk J₀) := by
      intro s
      apply MvPolynomial.ringHom_ext
      · intro b
        simp only [RingHom.comp_apply, MvPolynomial.map_C, ψ_of, MvPolynomial.eval₂Hom_C]
        exact congrArg (fun g => (CommRingCat.Hom.hom g) b) s.condition
      · intro m
        simp only [RingHom.comp_apply, MvPolynomial.map_X, ψ_of, MvPolynomial.eval₂Hom_X']
    have hker_le_ψ : ∀ (s : CategoryTheory.Limits.PushoutCocone (c₀.ι.app i₀) f₀),
        RingHom.ker φ_inf ≤ RingHom.ker (ψ_of s) := by
      intro s
      rw [hker_φ, Ideal.span_le]
      intro x hx
      obtain ⟨t, rfl⟩ := hx
      rw [SetLike.mem_coe, RingHom.mem_ker, ← hR₀_map_inf t]
      have h1 := congrArg (fun h => h (R₀ t)) (hψ_comp s)
      simp only [RingHom.comp_apply] at h1
      have ht_mem : R₀ t ∈ J₀ := Ideal.subset_span ⟨t, rfl⟩
      rw [h1, Ideal.Quotient.eq_zero_iff_mem.mpr ht_mem, map_zero]
    let desc_hom : ∀ (s : CategoryTheory.Limits.PushoutCocone (c₀.ι.app i₀) f₀),
        ↑E_inf →+* ↑s.pt :=
      fun s => φ_inf.liftOfRightInverse P₀.σ' hφ_ri ⟨ψ_of s, hker_le_ψ s⟩
    let desc_fn : ∀ (s : CategoryTheory.Limits.PushoutCocone (c₀.ι.app i₀) f₀),
        E_inf ⟶ s.pt :=
      fun s => CommRingCat.ofHom (desc_hom s)
    refine ⟨i₀, E₀, f₀, g₀, hf₀_et, ?_⟩
    refine CategoryTheory.IsPushout.of_isColimit
      (CategoryTheory.Limits.PushoutCocone.IsColimit.mk hw_push desc_fn ?_ ?_ ?_)
    · intro s
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro a
      change desc_hom s ((CommRingCat.Hom.hom f_E) a) = (CommRingCat.Hom.hom s.inl) a
      have hfE_a : (CommRingCat.Hom.hom f_E) a = φ_inf (MvPolynomial.C a) := by
        dsimp [φ_inf]
        rw [MvPolynomial.aeval_C, halg_fE]
      rw [hfE_a]
      dsimp [desc_hom]
      rw [RingHom.liftOfRightInverse_comp_apply]
      exact MvPolynomial.eval₂Hom_C _ _ a
    · intro s
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro q
      obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective q
      change desc_hom s (g₀_bar (Ideal.Quotient.mk J₀ p)) =
        (CommRingCat.Hom.hom s.inr) (Ideal.Quotient.mk J₀ p)
      have hg₀_p : g₀_bar (Ideal.Quotient.mk J₀ p) =
          φ_inf (MvPolynomial.map (CommRingCat.Hom.hom (c₀.ι.app i₀)) p) := by
        dsimp [g₀_bar]
        rw [Ideal.Quotient.lift_mk, RingHom.comp_apply]
      rw [hg₀_p]
      dsimp [desc_hom]
      rw [RingHom.liftOfRightInverse_comp_apply]
      exact congrArg (fun h => h p) (hψ_comp s)
    · intro s m hm_inl hm_inr
      have hm_comp : (CommRingCat.Hom.hom m).comp φ_inf = ψ_of s := by
        apply MvPolynomial.ringHom_ext
        · intro a
          simp only [RingHom.comp_apply, ψ_of, MvPolynomial.eval₂Hom_C]
          dsimp [φ_inf]
          rw [MvPolynomial.aeval_C, halg_fE]
          exact congrArg (fun g => (CommRingCat.Hom.hom g) a) hm_inl
        · intro m_idx
          simp only [RingHom.comp_apply, ψ_of, MvPolynomial.eval₂Hom_X']
          have hXm : φ_inf (MvPolynomial.X m_idx) =
              g₀_bar (Ideal.Quotient.mk J₀ (MvPolynomial.X m_idx)) := by
            dsimp [g₀_bar]
            rw [Ideal.Quotient.lift_mk, RingHom.comp_apply, MvPolynomial.map_X]
          rw [hXm]
          exact congrArg (fun h => (CommRingCat.Hom.hom h)
            (Ideal.Quotient.mk J₀ (MvPolynomial.X m_idx))) hm_inr
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro e
      change (CommRingCat.Hom.hom m) e = desc_hom s e
      have he := hφ_ri e
      conv_lhs => rw [← he]
      conv_rhs => rw [← he]
      have hlhs : (CommRingCat.Hom.hom m) (φ_inf (P₀.σ' e)) = (ψ_of s) (P₀.σ' e) :=
        congrArg (fun h => h (P₀.σ' e)) hm_comp
      rw [hlhs]
      dsimp [desc_hom]
      rw [RingHom.liftOfRightInverse_comp_apply]

  
  have hMvPushout :
      ∀ (d₀ : ℕ) {A B : Type u} [CommRing A] [CommRing B] (φ : A →+* B),
        CategoryTheory.IsPushout
          (CommRingCat.ofHom (MvPolynomial.C : A →+* MvPolynomial (Fin d₀) A))
          (CommRingCat.ofHom φ)
          (CommRingCat.ofHom (MvPolynomial.map φ))
          (CommRingCat.ofHom (MvPolynomial.C : B →+* MvPolynomial (Fin d₀) B)) := by
    clear * -
    intro d₀ A B _ _ φ
    let f_A : CommRingCat.of A ⟶ CommRingCat.of (MvPolynomial (Fin d₀) A) :=
      CommRingCat.ofHom MvPolynomial.C
    let g_φ : CommRingCat.of A ⟶ CommRingCat.of B := CommRingCat.ofHom φ
    let inl_φ : CommRingCat.of (MvPolynomial (Fin d₀) A) ⟶
        CommRingCat.of (MvPolynomial (Fin d₀) B) :=
      CommRingCat.ofHom (MvPolynomial.map φ)
    let inr_B : CommRingCat.of B ⟶ CommRingCat.of (MvPolynomial (Fin d₀) B) :=
      CommRingCat.ofHom MvPolynomial.C
    have hcomm : f_A ≫ inl_φ = g_φ ≫ inr_B := by
      apply CommRingCat.hom_ext
      ext a
      simp [f_A, g_φ, inl_φ, inr_B]
    exact CategoryTheory.IsPushout.of_isColimit
      (CategoryTheory.Limits.PushoutCocone.IsColimit.mk hcomm
        (fun s => CommRingCat.ofHom
          (MvPolynomial.eval₂Hom s.inr.hom (fun m => s.inl.hom (MvPolynomial.X m))))
        (fun s => by
          apply CommRingCat.hom_ext
          apply MvPolynomial.ringHom_ext'
          · ext a
            simp only [inl_φ, CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply,
              MvPolynomial.map_C, MvPolynomial.eval₂Hom_C]
            exact (ConcreteCategory.congr_hom s.condition a).symm
          · intro m
            simp [inl_φ])
        (fun s => by
          apply CommRingCat.hom_ext
          ext b
          simp [inr_B])
        (fun s m hm₁ hm₂ => by
          apply CommRingCat.hom_ext
          apply MvPolynomial.ringHom_ext'
          · ext b
            simpa [inr_B] using ConcreteCategory.congr_hom hm₂ b
          · intro m_idx
            have h1 := ConcreteCategory.congr_hom hm₁ (MvPolynomial.X m_idx)
            simpa [inl_φ] using h1))

  
  have hAwayUnitPow :
      ∀ {R : Type u} [CommRing R] (ϖ : R) (u : Rˣ) (e : ℕ), 1 ≤ e →
        ∀ {S : Type u} [CommRing S] (f : R →+* S),
          @IsLocalization.Away R _ (↑u * ϖ ^ e) S _ f.toAlgebra →
          @IsLocalization.Away R _ ϖ S _ f.toAlgebra := by
    clear * -
    intro R _ ϖ u e he S _ f hLoc_u
    let _ : Algebra R S := f.toAlgebra
    have hf_eq : algebraMap R S = f := rfl
    let x₀ : R := ↑u * ϖ ^ e
    have _ : IsLocalization.Away x₀ S := hLoc_u
    have h_unit_x₀ : IsUnit (f x₀) := by
      rw [← hf_eq]
      exact IsLocalization.Away.algebraMap_isUnit x₀
    have he_eq : e = (e - 1) + 1 := (Nat.sub_add_cancel he).symm
    have hx₀_fac : x₀ = (↑u * ϖ ^ (e - 1)) * ϖ := by
      dsimp [x₀]
      conv_lhs => rw [he_eq, pow_succ]
      ring
    have h_unit_ϖ : IsUnit (f ϖ) := by
      rw [hx₀_fac, map_mul] at h_unit_x₀
      exact isUnit_of_mul_isUnit_right h_unit_x₀
    have h_pow_inv : ∀ n : ℕ, x₀ ^ n * (↑(u⁻¹) : R) ^ n = ϖ ^ (e * n) := by
      intro n
      calc x₀ ^ n * (↑(u⁻¹) : R) ^ n
          = (x₀ * ↑(u⁻¹)) ^ n := (mul_pow _ _ _).symm
        _ = ((↑u * ↑(u⁻¹)) * ϖ ^ e) ^ n := by dsimp [x₀]; ring
        _ = (1 * ϖ ^ e) ^ n := by rw [Units.mul_inv]
        _ = ϖ ^ (e * n) := by rw [one_mul, ← pow_mul]
    refine {
      map_units := ?_
      surj := ?_
      exists_of_eq := ?_
    }
    · rintro ⟨_, ⟨m, rfl⟩⟩
      rw [hf_eq, map_pow]
      exact h_unit_ϖ.pow m
    · intro z
      obtain ⟨⟨r, ⟨_, ⟨n, rfl⟩⟩⟩, hzr⟩ := IsLocalization.surj (Submonoid.powers x₀) z
      refine ⟨⟨r * (↑(u⁻¹) : R) ^ n, ⟨ϖ ^ (e * n), ⟨e * n, rfl⟩⟩⟩, ?_⟩
      dsimp only at hzr ⊢
      rw [hf_eq] at hzr ⊢
      calc z * f (ϖ ^ (e * n))
          = z * f (x₀ ^ n * (↑(u⁻¹) : R) ^ n) := by rw [h_pow_inv n]
        _ = (z * f (x₀ ^ n)) * f ((↑(u⁻¹) : R) ^ n) := by rw [map_mul, mul_assoc]
        _ = f r * f ((↑(u⁻¹) : R) ^ n) := by rw [hzr]
        _ = f (r * (↑(u⁻¹) : R) ^ n) := (map_mul _ _ _).symm
    · intro r₁ r₂ h12
      rw [← hf_eq] at h12
      obtain ⟨⟨_, ⟨n, rfl⟩⟩, heq⟩ := IsLocalization.exists_of_eq (M := Submonoid.powers x₀) h12
      dsimp only at heq
      refine ⟨⟨ϖ ^ (e * n), ⟨e * n, rfl⟩⟩, ?_⟩
      dsimp only
      calc ϖ ^ (e * n) * r₁
          = (↑(u⁻¹) : R) ^ n * (x₀ ^ n * r₁) := by rw [← h_pow_inv n]; ring
        _ = (↑(u⁻¹) : R) ^ n * (x₀ ^ n * r₂) := by rw [heq]
        _ = ϖ ^ (e * n) * r₂ := by rw [← h_pow_inv n]; ring

  
  have hMvPolyAway :
      ∀ (d₀ : ℕ) {R₀ : Type u} [CommRing R₀] (t₀ : R₀)
        {L₀ : Type u} [CommRing L₀] (φ₀ : R₀ →+* L₀),
        @IsLocalization.Away R₀ _ t₀ L₀ _ φ₀.toAlgebra →
        @IsLocalization.Away (MvPolynomial (Fin d₀) R₀) _ (MvPolynomial.C t₀)
          (MvPolynomial (Fin d₀) L₀) _ (MvPolynomial.map φ₀).toAlgebra := by
    clear * -
    intro d₀ R₀ _ t₀ L₀ _ φ₀ hLoc₀
    let _ : Algebra R₀ L₀ := φ₀.toAlgebra
    have hφ_alg : algebraMap R₀ L₀ = φ₀ := rfl
    have _ : IsLocalization.Away t₀ L₀ := hLoc₀
    let C_R := MvPolynomial (Fin d₀) R₀
    let C_L := MvPolynomial (Fin d₀) L₀
    let ψ : C_R →+* C_L := MvPolynomial.map φ₀
    let _ : Algebra C_R C_L := ψ.toAlgebra
    have hψ_alg : algebraMap C_R C_L = ψ := rfl
    have h_unit_t₀ : IsUnit (φ₀ t₀) := by
      rw [← hφ_alg]
      exact IsLocalization.Away.algebraMap_isUnit t₀
    have h_unit_Ct₀ : IsUnit (ψ (MvPolynomial.C t₀)) := by
      dsimp [ψ]
      rw [MvPolynomial.map_C]
      exact h_unit_t₀.map MvPolynomial.C
    refine {
      map_units := ?_
      surj := ?_
      exists_of_eq := ?_
    }
    · rintro ⟨_, ⟨m, rfl⟩⟩
      rw [hψ_alg, map_pow]
      exact h_unit_Ct₀.pow m
    · intro P
      have h_coeff : ∀ μ : Fin d₀ →₀ ℕ,
          ∃ (n : ℕ) (r : R₀), P.coeff μ * φ₀ (t₀ ^ n) = φ₀ r := by
        intro μ
        obtain ⟨⟨r, ⟨_, ⟨n, rfl⟩⟩⟩, hμ⟩ := IsLocalization.surj (Submonoid.powers t₀) (P.coeff μ)
        exact ⟨n, r, hμ⟩
      choose n_of r_of hnr using h_coeff
      let N : ℕ := P.support.sup n_of
      let Q : C_R := ∑ μ ∈ P.support,
        MvPolynomial.monomial μ (r_of μ * t₀ ^ (N - n_of μ))
      refine ⟨⟨Q, ⟨(MvPolynomial.C t₀) ^ N, ⟨N, rfl⟩⟩⟩, ?_⟩
      dsimp only
      rw [hψ_alg, ← MvPolynomial.C_pow]
      dsimp only [ψ]
      rw [MvPolynomial.map_C]
      have hmulC : P * MvPolynomial.C (φ₀ (t₀ ^ N)) = MvPolynomial.C (φ₀ (t₀ ^ N)) * P :=
        mul_comm _ _
      rw [hmulC]
      ext μ
      rw [MvPolynomial.coeff_C_mul, mul_comm (φ₀ (t₀ ^ N)) (P.coeff μ), MvPolynomial.coeff_map]
      dsimp [Q]
      rw [MvPolynomial.coeff_sum]
      simp only [MvPolynomial.coeff_monomial]
      by_cases hμ : μ ∈ P.support
      · rw [Finset.sum_eq_single μ
          (fun ν _ hν => by simp only [hν, ↓reduceIte])
          (fun h => absurd hμ h)]
        simp only [↓reduceIte]
        have hle : n_of μ ≤ N := Finset.le_sup hμ
        have hN_eq : n_of μ + (N - n_of μ) = N := Nat.add_sub_of_le hle
        calc P.coeff μ * φ₀ (t₀ ^ N)
            = P.coeff μ * φ₀ (t₀ ^ (n_of μ + (N - n_of μ))) := by rw [hN_eq]
          _ = (P.coeff μ * φ₀ (t₀ ^ n_of μ)) * φ₀ (t₀ ^ (N - n_of μ)) := by
                rw [pow_add, map_mul, mul_assoc]
          _ = φ₀ (r_of μ) * φ₀ (t₀ ^ (N - n_of μ)) := by rw [hnr μ]
          _ = φ₀ (r_of μ * t₀ ^ (N - n_of μ)) := (map_mul _ _ _).symm
      · have h0 : (∑ x ∈ P.support, if x = μ then r_of x * t₀ ^ (N - n_of x) else 0) = 0 := by
          refine Finset.sum_eq_zero fun x hx => ?_
          have hne : x ≠ μ := fun h => hμ (h ▸ hx)
          simp only [hne, ↓reduceIte]
        rw [h0, map_zero, MvPolynomial.notMem_support_iff.mp hμ, zero_mul]
    · intro P₁ P₂ h12
      rw [hψ_alg] at h12
      let D_poly_diff := P₁ - P₂
      have hD_coeff : ∀ μ : Fin d₀ →₀ ℕ,
          ∃ m : ℕ, t₀ ^ m * D_poly_diff.coeff μ = 0 := by
        intro μ
        have h_eq : algebraMap R₀ L₀ (D_poly_diff.coeff μ) = algebraMap R₀ L₀ 0 := by
          rw [map_zero, hφ_alg]
          dsimp [D_poly_diff]
          rw [map_sub, ← MvPolynomial.coeff_map, ← MvPolynomial.coeff_map, h12, sub_self]
        obtain ⟨⟨_, ⟨m, rfl⟩⟩, hm⟩ := IsLocalization.exists_of_eq (M := Submonoid.powers t₀) h_eq
        dsimp only at hm
        rw [mul_zero] at hm
        exact ⟨m, hm⟩
      choose m_of hm_of using hD_coeff
      let K : ℕ := D_poly_diff.support.sup m_of
      refine ⟨⟨(MvPolynomial.C t₀) ^ K, ⟨K, rfl⟩⟩, ?_⟩
      dsimp only
      rw [← sub_eq_zero, ← mul_sub, ← MvPolynomial.C_pow]
      change MvPolynomial.C (t₀ ^ K) * D_poly_diff = 0
      ext μ
      have h0_coeff : (0 : C_R).coeff μ = 0 := by simp
      rw [MvPolynomial.coeff_C_mul, h0_coeff]
      by_cases hμ : μ ∈ D_poly_diff.support
      · have hle : m_of μ ≤ K := Finset.le_sup hμ
        have hK_eq : K = (K - m_of μ) + m_of μ := (Nat.sub_add_cancel hle).symm
        rw [hK_eq, pow_add, mul_assoc, hm_of μ, mul_zero]
      · rw [MvPolynomial.notMem_support_iff.mp hμ, mul_zero]

  
  intro S_d A1_k Gm_k j_Gm κ_A1 p_A1 Y_d j_d g_k_R j_R A_R j_A W _ w _

  have hSpecMapComp_Sd :
      ∀ {A B : CommRingCat.{u}}
        (g : CommRingCat.of (MvPolynomial (Fin d_rel) k) ⟶ A) (h : A ⟶ B),
        (AlgebraicGeometry.Spec.map h ≫ AlgebraicGeometry.Spec.map g :
          AlgebraicGeometry.Spec B ⟶ S_d.left) =
          AlgebraicGeometry.Spec.map (g ≫ h) :=
    fun g h => (AlgebraicGeometry.Spec.map_comp g h).symm

  
  have hRelAffineAwayPullback :
      ∀ {R₀ : Type u} [CommRing R₀] (c₀ : k →+* R₀) (t₀ : R₀)
        {L₀ : Type u} [CommRing L₀] (φ₀ : R₀ →+* L₀),
        @IsLocalization.Away R₀ _ t₀ L₀ _ φ₀.toAlgebra →
        let g₀ : AlgebraicGeometry.Spec (CommRingCat.of R₀) ⟶
            AlgebraicGeometry.Spec (CommRingCat.of k) :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom c₀)
        let j₀ : AlgebraicGeometry.Spec (CommRingCat.of L₀) ⟶
            AlgebraicGeometry.Spec (CommRingCat.of R₀) :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀)
        let B₀ := CategoryTheory.Limits.pullback S_d.hom g₀
        let j_B := CategoryTheory.Limits.pullback.snd j₀
          (CategoryTheory.Limits.pullback.snd S_d.hom g₀)
        ∀ (E U : CommRingCat.{u}) (lam : E ⟶ U)
          (W_sch : AlgebraicGeometry.Scheme.{u})
          (e_W₀ : AlgebraicGeometry.Spec E ≅ W_sch)
          (w₀ : W_sch ⟶ B₀)
          (f_E₀ : CommRingCat.of (MvPolynomial (Fin d_rel) R₀) ⟶ E),
          e_W₀.hom ≫ w₀ ≫ CategoryTheory.Limits.pullback.fst S_d.hom g₀ =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (MvPolynomial.map c₀) ≫ f_E₀) →
          e_W₀.hom ≫ w₀ ≫ CategoryTheory.Limits.pullback.snd S_d.hom g₀ =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C ≫ f_E₀) →
          @IsLocalization.Away ↑E _ (f_E₀.hom (MvPolynomial.C t₀)) ↑U _ lam.hom.toAlgebra →
          ∃ (e_WU₀ : AlgebraicGeometry.Spec U ≅ CategoryTheory.Limits.pullback j_B w₀),
            e_WU₀.hom ≫ CategoryTheory.Limits.pullback.snd j_B w₀ =
              AlgebraicGeometry.Spec.map lam ≫ e_W₀.hom := by
    intro R₀ _ c₀ t₀ L₀ _ φ₀ hLoc₀ g₀ j₀ B₀ j_B E U lam W_sch e_W₀ w₀ f_E₀ hw_fst hw_snd hLocU
    let f_k : CommRingCat.of k ⟶ CommRingCat.of (MvPolynomial (Fin d_rel) k) :=
      CommRingCat.ofHom MvPolynomial.C
    let C_R := MvPolynomial (Fin d_rel) R₀
    let C_L := MvPolynomial (Fin d_rel) L₀
    let φ_C : CommRingCat.of C_R ⟶ CommRingCat.of C_L :=
      CommRingCat.ofHom (MvPolynomial.map φ₀)
    have hPb_BR : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (MvPolynomial.map c₀)))
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (MvPolynomial.C : R₀ →+* MvPolynomial (Fin d_rel) R₀)))
        S_d.hom g₀ :=
      AlgebraicGeometry.isPullback_SpecMap_of_isPushout f_k (CommRingCat.ofHom c₀)
        (CommRingCat.ofHom (MvPolynomial.map c₀))
        (CommRingCat.ofHom (MvPolynomial.C : R₀ →+* MvPolynomial (Fin d_rel) R₀))
        (hMvPushout d_rel c₀)
    let e_BR : AlgebraicGeometry.Spec (CommRingCat.of C_R) ≅ B₀ := hPb_BR.isoPullback
    have he_BR_fst : e_BR.hom ≫ CategoryTheory.Limits.pullback.fst S_d.hom g₀ =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (MvPolynomial.map c₀)) :=
      hPb_BR.isoPullback_hom_fst
    have he_BR_snd : e_BR.hom ≫ CategoryTheory.Limits.pullback.snd S_d.hom g₀ =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (MvPolynomial.C : R₀ →+* MvPolynomial (Fin d_rel) R₀)) :=
      hPb_BR.isoPullback_hom_snd
    have hw_fac : e_W₀.hom ≫ w₀ = AlgebraicGeometry.Spec.map f_E₀ ≫ e_BR.hom := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [Category.assoc, hw_fst, Category.assoc, he_BR_fst]
        exact AlgebraicGeometry.Spec.map_comp _ _
      · rw [Category.assoc, hw_snd, Category.assoc, he_BR_snd]
        exact AlgebraicGeometry.Spec.map_comp _ _
    have hPb_BL₀ : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (MvPolynomial.C : L₀ →+* MvPolynomial (Fin d_rel) L₀)))
        (AlgebraicGeometry.Spec.map φ_C)
        j₀
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (MvPolynomial.C : R₀ →+* MvPolynomial (Fin d_rel) R₀))) :=
      (AlgebraicGeometry.isPullback_SpecMap_of_isPushout
        (CommRingCat.ofHom (MvPolynomial.C : R₀ →+* MvPolynomial (Fin d_rel) R₀))
        (CommRingCat.ofHom φ₀) φ_C
        (CommRingCat.ofHom (MvPolynomial.C : L₀ →+* MvPolynomial (Fin d_rel) L₀))
        (hMvPushout d_rel φ₀)).flip
    have hPb_BL : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (MvPolynomial.C : L₀ →+* MvPolynomial (Fin d_rel) L₀)))
        (AlgebraicGeometry.Spec.map φ_C ≫ e_BR.hom)
        j₀
        (CategoryTheory.Limits.pullback.snd S_d.hom g₀) :=
      CategoryTheory.IsPullback.of_iso hPb_BL₀
        (Iso.refl _) (Iso.refl _) e_BR (Iso.refl _)
        (by simp) (by simp) (by simp)
        (by rw [Iso.refl_hom, Category.comp_id, he_BR_snd])
    let e_BL : AlgebraicGeometry.Spec (CommRingCat.of C_L) ≅
        CategoryTheory.Limits.pullback j₀ (CategoryTheory.Limits.pullback.snd S_d.hom g₀) :=
      hPb_BL.isoPullback
    have he_BL_snd : e_BL.hom ≫ j_B = AlgebraicGeometry.Spec.map φ_C ≫ e_BR.hom :=
      hPb_BL.isoPullback_hom_snd
    let _ : Algebra C_R C_L := (MvPolynomial.map φ₀).toAlgebra
    have _ : IsLocalization.Away (MvPolynomial.C t₀ : C_R) C_L :=
      hMvPolyAway d_rel t₀ φ₀ hLoc₀
    let _ : Algebra ↑E ↑U := lam.hom.toAlgebra
    have _ : IsLocalization.Away (f_E₀.hom (MvPolynomial.C t₀)) ↑U := hLocU
    have h_unit_tC : IsUnit ((lam.hom.comp f_E₀.hom) (MvPolynomial.C t₀)) := by
      rw [RingHom.comp_apply]
      exact IsLocalization.Away.algebraMap_isUnit (S := ↑U) (f_E₀.hom (MvPolynomial.C t₀))
    let u_hom : C_L →+* ↑U :=
      IsLocalization.Away.lift (S := C_L) (MvPolynomial.C t₀ : C_R) h_unit_tC
    have hu_comp : u_hom.comp (algebraMap C_R C_L) = (algebraMap ↑E ↑U).comp f_E₀.hom := by
      apply RingHom.ext
      intro p
      exact IsLocalization.Away.lift_eq (S := C_L) (x := (MvPolynomial.C t₀ : C_R)) h_unit_tC p
    have _ : IsLocalization
        (Submonoid.map f_E₀.hom (Submonoid.powers (MvPolynomial.C t₀ : C_R))) ↑U := by
      rw [Submonoid.map_powers]
      exact hLocU
    have hPush_WU : CategoryTheory.IsPushout f_E₀ φ_C lam (CommRingCat.ofHom u_hom) :=
      CommRingCat.isPushout_of_isLocalization (R := C_R) (S := ↑E) (Rₘ := C_L) (Sₘ := ↑U)
        f_E₀.hom u_hom hu_comp (Submonoid.powers (MvPolynomial.C t₀ : C_R))
    have hPb_WU₀ : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom u_hom))
        (AlgebraicGeometry.Spec.map lam)
        (AlgebraicGeometry.Spec.map φ_C)
        (AlgebraicGeometry.Spec.map f_E₀) :=
      (AlgebraicGeometry.isPullback_SpecMap_of_isPushout f_E₀ φ_C lam
        (CommRingCat.ofHom u_hom) hPush_WU).flip
    have hPb_WU : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom u_hom) ≫ e_BL.hom)
        (AlgebraicGeometry.Spec.map lam ≫ e_W₀.hom)
        j_B w₀ :=
      CategoryTheory.IsPullback.of_iso hPb_WU₀
        (Iso.refl _) e_BL e_W₀ e_BR
        (by simp) (by simp) he_BL_snd.symm hw_fac.symm
    exact ⟨hPb_WU.isoPullback, hPb_WU.isoPullback_hom_snd⟩

  
  let c_R : k →+* R_bar := p_R.comp Polynomial.C
  let D_poly : ℐ ⥤ CommRingCat.{u} :=
    { obj := fun i => CommRingCat.of (MvPolynomial (Fin d_rel) ↑(D.obj i))
      map := fun θ => CommRingCat.ofHom (MvPolynomial.map (D.map θ).hom)
      map_id := fun i => by
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro p
        simp only [D.map_id, CommRingCat.hom_ofHom, CommRingCat.hom_id,
          MvPolynomial.map_id, RingHom.id_apply]
      map_comp := fun θ₁ θ₂ => by
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro p
        simp only [Functor.map_comp, CommRingCat.hom_comp, CommRingCat.hom_ofHom,
          RingHom.comp_apply, MvPolynomial.map_map] }
  let c_poly : CategoryTheory.Limits.Cocone D_poly :=
    { pt := CommRingCat.of (MvPolynomial (Fin d_rel) R_bar)
      ι :=
        { app := fun i =>
            CommRingCat.ofHom (MvPolynomial.map ((c.ι.app i ≫ e_pt.hom).hom))
          naturality := fun i i' θ => by
            dsimp only [D_poly, Functor.const_obj_obj, Functor.const_obj_map]
            rw [Category.comp_id]
            apply CommRingCat.hom_ext
            apply RingHom.ext
            intro p
            simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply,
              MvPolynomial.map_map]
            have hw_hom :
                (((e_pt.hom).hom.comp (c.ι.app i').hom).comp (D.map θ).hom) =
                (e_pt.hom).hom.comp (c.ι.app i).hom := by
              rw [← CommRingCat.hom_comp, ← CommRingCat.hom_comp, ← Category.assoc, c.w θ,
                CommRingCat.hom_comp]
            rw [hw_hom] } }
  have hc_poly : CategoryTheory.Limits.IsColimit c_poly := by
    let i_star : ℐ := Classical.choice CategoryTheory.IsFiltered.nonempty
    let s_D_of : CategoryTheory.Limits.Cocone D_poly → CategoryTheory.Limits.Cocone D :=
      fun s =>
        { pt := s.pt
          ι :=
            { app := fun i =>
                CommRingCat.ofHom (MvPolynomial.C : ↑(D.obj i) →+* MvPolynomial (Fin d_rel) ↑(D.obj i)) ≫
                  s.ι.app i
              naturality := fun i i' θ => by
                dsimp only [Functor.const_obj_obj, Functor.const_obj_map]
                have hC_nat :
                    D.map θ ≫
                      CommRingCat.ofHom
                        (MvPolynomial.C : ↑(D.obj i') →+* MvPolynomial (Fin d_rel) ↑(D.obj i')) =
                    CommRingCat.ofHom
                        (MvPolynomial.C : ↑(D.obj i) →+* MvPolynomial (Fin d_rel) ↑(D.obj i)) ≫
                      D_poly.map θ := by
                  apply CommRingCat.hom_ext
                  ext r₀
                  simp [D_poly]
                rw [Category.comp_id, ← Category.assoc, hC_nat, Category.assoc, s.w θ] } }
    let g_R_of : ∀ s : CategoryTheory.Limits.Cocone D_poly, CommRingCat.of R_bar ⟶ s.pt :=
      fun s => e_pt.inv ≫ hc.desc (s_D_of s)
    have hg_R_fac : ∀ (s : CategoryTheory.Limits.Cocone D_poly) (i : ℐ),
        (c.ι.app i ≫ e_pt.hom) ≫ g_R_of s =
          CommRingCat.ofHom (MvPolynomial.C : ↑(D.obj i) →+* MvPolynomial (Fin d_rel) ↑(D.obj i)) ≫
            s.ι.app i := by
      intro s i
      dsimp only [g_R_of]
      rw [Category.assoc, Iso.hom_inv_id_assoc, hc.fac (s_D_of s) i]
    have hX_indep : ∀ (s : CategoryTheory.Limits.Cocone D_poly) (i : ℐ) (m : Fin d_rel),
        (s.ι.app i).hom (MvPolynomial.X m) = (s.ι.app i_star).hom (MvPolynomial.X m) := by
      intro s i m
      let u_max := CategoryTheory.IsFiltered.max i_star i
      let l_u : i_star ⟶ u_max := CategoryTheory.IsFiltered.leftToMax i_star i
      let r_u : i ⟶ u_max := CategoryTheory.IsFiltered.rightToMax i_star i
      have hl := ConcreteCategory.congr_hom (s.w l_u) (MvPolynomial.X m)
      have hr := ConcreteCategory.congr_hom (s.w r_u) (MvPolynomial.X m)
      simp only [D_poly, CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply,
        MvPolynomial.map_X] at hl hr
      exact hr.symm.trans hl
    refine CategoryTheory.Limits.IsColimit.mk
      (fun s => CommRingCat.ofHom
        (MvPolynomial.eval₂Hom (g_R_of s).hom
          (fun m => (s.ι.app i_star).hom (MvPolynomial.X m))))
      (fun s i => ?_)
      (fun s m hm => ?_)
    · apply CommRingCat.hom_ext
      apply MvPolynomial.ringHom_ext'
      · ext r₀
        simp only [c_poly, CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply,
          MvPolynomial.map_C, MvPolynomial.eval₂Hom_C]
        exact ConcreteCategory.congr_hom (hg_R_fac s i) r₀
      · intro m_idx
        simp only [c_poly, CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply,
          MvPolynomial.map_X, MvPolynomial.eval₂Hom_X']
        exact (hX_indep s i m_idx).symm
    · have hm_C : CommRingCat.ofHom
