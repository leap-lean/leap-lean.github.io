    have hpr_Us : pr_Zs.base (e_Zs.inv.base y) ∈ (U_s : Set Z_s.left) := hy_UY
    rw [hUs_compl, Set.mem_compl_iff] at hpr_Us
    apply hpr_Us
    have hx_prZ : pr_Z.base ((CategoryTheory.Limits.pullback.fst f_bar.left s_bar).base y) ∈
