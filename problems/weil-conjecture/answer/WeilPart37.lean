            rw [(C₂.obj AM).obj.map_comp]
            change ((C₂.obj AM).obj.map h.op).hom (((C₂.obj AM).obj.map g.op).hom s) = 0
            rw [hg, map_zero] }
      have hRE_mem : R_E ∈ J₂ E := by
        refine (h_mem_etale S₂ E R_E).mpr (fun x => ?_)
        obtain ⟨O_et, f_O, y, hEt_fO, hy, hC1, hC2⟩ := h_basis E x
        have hIso_O : CategoryTheory.IsIso (u_sh.hom.app (Opposite.op O_et)) :=
