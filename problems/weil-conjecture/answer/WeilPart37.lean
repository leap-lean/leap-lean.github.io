  let P_2 := CategoryTheory.Limits.pullback π_s.left
    (AlgebraicGeometry.Spec.map (CommRingCat.ofHom incR_2) ≫ U'.2.fromSpec)
  let π_P2 : P_2 ⟶ AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct F F₂ A')) :=
    CategoryTheory.Limits.pullback.snd π_s.left
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom incR_2) ≫ U'.2.fromSpec)
  have : Nonempty ↥P_2 := by
    have : CategoryTheory.IsIso (π_P2 ∣_ PrimeSpectrum.basicOpen (g_2 0)) :=
      hIso_away2 g_2 hMapKer_2 0
    let q_bot : ↥(PrimeSpectrum.basicOpen (g_2 0) :
        (AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct F F₂ A'))).Opens) :=
      ⟨⟨⊥, inferInstance⟩, by
        change g_2 0 ∉ (⊥ : Ideal (TensorProduct F F₂ A'))
        rw [Ideal.mem_bot]
