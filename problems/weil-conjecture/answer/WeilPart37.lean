  have hMakeBaseChangeHom : ∀ {E₁ E₂ : Type u} [Field E₁] [Field E₂] [Algebra E₁ E₂]
      {X₁ X₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of E₁))}
      (φ : X₁ ⟶ X₂),
      let g_E := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E₁ E₂))
      let X₁' := weilBaseChangeOver E₁ E₂ X₁
      let X₂' := weilBaseChangeOver E₁ E₂ X₂
      ∃ (φ' : X₁' ⟶ X₂'),
        φ'.left ≫ CategoryTheory.Limits.pullback.fst X₂.hom g_E =
          CategoryTheory.Limits.pullback.fst X₁.hom g_E ≫ φ.left ∧
        CategoryTheory.IsPullback
          (CategoryTheory.Limits.pullback.fst X₁.hom g_E) φ'.left
          φ.left (CategoryTheory.Limits.pullback.fst X₂.hom g_E) := by
    intro E₁ E₂ _ _ _ X₁ X₂ φ g_E X₁' X₂'
    let φ_left : X₁'.left ⟶ X₂'.left :=
      CategoryTheory.Limits.pullback.map X₁.hom g_E X₂.hom g_E
        φ.left (𝟙 _) (𝟙 _)
        (by rw [CategoryTheory.Category.comp_id]; exact φ.w.symm)
        (by rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
    have hφ_fst : φ_left ≫ CategoryTheory.Limits.pullback.fst X₂.hom g_E =
        CategoryTheory.Limits.pullback.fst X₁.hom g_E ≫ φ.left :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hφ_snd : φ_left ≫ X₂'.hom = X₁'.hom :=
      (CategoryTheory.Limits.pullback.lift_snd _ _ _).trans (CategoryTheory.Category.comp_id _)
    let φ' : X₁' ⟶ X₂' := CategoryTheory.Over.homMk φ_left hφ_snd
    have hOuter : CategoryTheory.IsPullback (φ'.left ≫ X₂'.hom)
        (CategoryTheory.Limits.pullback.fst X₁.hom g_E) g_E (φ.left ≫ X₂.hom) := by
      rw [φ'.w, φ.w]
      exact (CategoryTheory.IsPullback.of_hasPullback X₁.hom g_E).flip
    have hPb : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst X₁.hom g_E) φ'.left
        φ.left (CategoryTheory.Limits.pullback.fst X₂.hom g_E) :=
      (CategoryTheory.IsPullback.of_right hOuter hφ_fst
        (CategoryTheory.IsPullback.of_hasPullback X₂.hom g_E).flip).flip
    exact ⟨φ', hφ_fst, hPb⟩

  
  let Z_bar := weilBaseChangeOver F k Z_tilde
  have : AlgebraicGeometry.IsProper D_bar.hom :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (CategoryTheory.IsPullback.of_hasPullback D₀.hom g_k) inferInstance
  have : AlgebraicGeometry.IsProper Z_bar.hom :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (CategoryTheory.IsPullback.of_hasPullback Z_tilde.hom g_k) inferInstance
  let pr_D : D_bar.left ⟶ D₀.left := CategoryTheory.Limits.pullback.fst D₀.hom g_k
  let pr_Z : Z_bar.left ⟶ Z_tilde.left := CategoryTheory.Limits.pullback.fst Z_tilde.hom g_k
  have hPb_fbar' : CategoryTheory.IsPullback pr_Z f_bar.left f₀.left pr_D := hPb_fbar
  let U_bar : D_bar.left.Opens := (TopologicalSpace.Opens.map pr_D.base).obj U₀
  have hg_surj : AlgebraicGeometry.Surjective g_k :=
    ⟨fun _ => ⟨default, Subsingleton.elim _ _⟩⟩
  have hprD_surj : AlgebraicGeometry.Surjective pr_D :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (CategoryTheory.IsPullback.of_hasPullback D₀.hom g_k).flip hg_surj
  have hU_bar_ne : Nonempty ↥U_bar.toScheme := by
    obtain ⟨u₀⟩ := hU₀_ne
    obtain ⟨y, hy⟩ := hprD_surj.1 (U₀.ι.base u₀)
    have hy_mem : y ∈ U_bar := by
      change pr_D.base y ∈ U₀
      rw [hy]
      exact u₀.2
    exact ⟨⟨y, hy_mem⟩⟩

  have hResPb : ∀ {X₁ B₁ X₀ B₀ : AlgebraicGeometry.Scheme.{u}}
      (q_X : X₁ ⟶ X₀) (f₁ : X₁ ⟶ B₁) (f₀' : X₀ ⟶ B₀) (q_B : B₁ ⟶ B₀)
      (hpb : CategoryTheory.IsPullback q_X f₁ f₀' q_B) (W₀ : B₀.Opens),
      let W₁ : B₁.Opens := (TopologicalSpace.Opens.map q_B.base).obj W₀
      ∃ (u_V : (f₁ ⁻¹ᵁ W₁).toScheme ⟶ (f₀' ⁻¹ᵁ W₀).toScheme)
        (u_W : W₁.toScheme ⟶ W₀.toScheme),
        CategoryTheory.IsPullback u_V (f₁ ∣_ W₁) (f₀' ∣_ W₀) u_W := by
    intro X₁ B₁ X₀ B₀ q_X f₁ f₀' q_B hpb W₀ W₁
    have hrange_W : Set.range (W₁.ι ≫ q_B).base ⊆ Set.range W₀.ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rintro _ ⟨w, rfl⟩
      exact w.2
    let u_W : W₁.toScheme ⟶ W₀.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift W₀.ι (W₁.ι ≫ q_B) hrange_W
    have hu_W : u_W ≫ W₀.ι = W₁.ι ≫ q_B :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac W₀.ι (W₁.ι ≫ q_B) hrange_W
    have hpb_res₁ := (AlgebraicGeometry.isPullback_morphismRestrict f₁ W₁).flip
    have hpb_res₀ := (AlgebraicGeometry.isPullback_morphismRestrict f₀' W₀).flip
    have hpb_paste := hpb_res₁.paste_horiz hpb
    have hcond : ((f₁ ⁻¹ᵁ W₁).ι ≫ q_X) ≫ f₀' = ((f₁ ∣_ W₁) ≫ u_W) ≫ W₀.ι := by
      calc
        ((f₁ ⁻¹ᵁ W₁).ι ≫ q_X) ≫ f₀' = (f₁ ∣_ W₁) ≫ (W₁.ι ≫ q_B) := hpb_paste.w
        _ = (f₁ ∣_ W₁) ≫ (u_W ≫ W₀.ι) := by rw [hu_W]
        _ = ((f₁ ∣_ W₁) ≫ u_W) ≫ W₀.ι := (CategoryTheory.Category.assoc _ _ _).symm
    let u_V : (f₁ ⁻¹ᵁ W₁).toScheme ⟶ (f₀' ⁻¹ᵁ W₀).toScheme :=
      hpb_res₀.lift ((f₁ ⁻¹ᵁ W₁).ι ≫ q_X) ((f₁ ∣_ W₁) ≫ u_W) hcond
    have hpb_outer : CategoryTheory.IsPullback (u_V ≫ (f₀' ⁻¹ᵁ W₀).ι) (f₁ ∣_ W₁) f₀' (u_W ≫ W₀.ι) := by
      rw [hpb_res₀.lift_fst, hu_W]
      exact hpb_paste
    exact ⟨u_V, u_W, CategoryTheory.IsPullback.of_right hpb_outer (hpb_res₀.lift_snd _ _ _) hpb_res₀⟩

  obtain ⟨_, _, hpb_Ubar⟩ := hResPb pr_Z f_bar.left f₀.left pr_D hPb_fbar' U₀
  have hSm_Ubar : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (f_bar.left ∣_ U_bar) :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_Ubar hSm_U₀

  have hIsoPb : ∀ {B₁ X₁ B₀ X₀ : AlgebraicGeometry.Scheme.{u}}
      (fst : X₁ ⟶ X₀) (snd : X₁ ⟶ B₁) (f : X₀ ⟶ B₀) (g : B₁ ⟶ B₀),
      CategoryTheory.IsPullback fst snd f g → CategoryTheory.IsIso f →
      CategoryTheory.IsIso snd := by
    intro B₁ X₁ B₀ X₀ fst snd f g hpb hf
    let s_inv : B₁ ⟶ X₁ := hpb.lift (g ≫ inv f) (𝟙 B₁) (by simp)
    refine ⟨⟨s_inv, ?_, hpb.lift_snd _ _ _⟩⟩
    apply hpb.hom_ext
    · rw [CategoryTheory.Category.assoc, hpb.lift_fst, CategoryTheory.Category.id_comp,
        ← CategoryTheory.Category.assoc, ← hpb.w, CategoryTheory.Category.assoc,
        CategoryTheory.IsIso.hom_inv_id, CategoryTheory.Category.comp_id]
    · rw [CategoryTheory.Category.assoc, hpb.lift_snd, CategoryTheory.Category.comp_id,
        CategoryTheory.Category.id_comp]

  have hSecPb : ∀ (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
      (σ : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ Y.left),
      σ ≫ Y.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)) →
      let Y_bar := weilBaseChangeOver F k Y
      let pr_Y : Y_bar.left ⟶ Y.left := CategoryTheory.Limits.pullback.fst Y.hom g_k
      ∃ σ_bar : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ Y_bar.left,
        σ_bar ≫ pr_Y = g_k ≫ σ ∧
        σ_bar ≫ Y_bar.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) ∧
        CategoryTheory.IsPullback σ_bar g_k pr_Y σ ∧
        (∀ y : Y_bar.left, pr_Y.base y ∈ Set.range σ.base ↔ y ∈ Set.range σ_bar.base) := by
    intro Y σ hσ Y_bar pr_Y
    let σ_bar : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ Y_bar.left :=
      CategoryTheory.Limits.pullback.lift (g_k ≫ σ) (𝟙 _) (by
        rw [CategoryTheory.Category.assoc, hσ, CategoryTheory.Category.comp_id,
