  have hP1BundlePkg : ∀ (d₀ : ℕ)
      (B P : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
      [AlgebraicGeometry.GeometricallyIrreducible B.hom]
      [AlgebraicGeometry.IsProper B.hom]
      [AlgebraicGeometry.SmoothOfRelativeDimension (2 * d₀) B.hom]
      [AlgebraicGeometry.GeometricallyIrreducible P.hom]
      [AlgebraicGeometry.IsProper P.hom]
      [AlgebraicGeometry.SmoothOfRelativeDimension (2 * d₀ + 1) P.hom],
      (∀ c : ℕ,
        Subsingleton (weilEtaleTorsionH (weilGeomScheme K B) (ℓ ^ (r + 1)) (2 * c + 1))) →
      (∀ c : ℕ, c ≤ 2 * d₀ →
        ∀ (f_B : weilEtaleTorsionH (weilGeomScheme K B) (ℓ ^ (r + 1)) (2 * c) →+
              weilEtaleTorsionH (weilGeomScheme K B) (ℓ ^ (r + 1)) (2 * c)),
          WeilIsTorsionGeomFrobAction K B (ℓ ^ (r + 1)) (2 * c) f_B →
          ∀ u, f_B u = (Nat.card K ^ c) • u) →
      ∀ (p : P ⟶ B) (i₀ i_inf : B ⟶ P) (V_plus : P.left.Opens)
        (s_inf_V : B.left ⟶ V_plus.toScheme) (M : ℕ) (W : Fin M → B.left.Opens),
        i₀ ≫ p = 𝟙 B →
        i_inf ≫ p = 𝟙 B →
        AlgebraicGeometry.IsClosedImmersion i₀.left →
        (V_plus : Set P.left) = (Set.range i₀.left.base)ᶜ →
        s_inf_V ≫ V_plus.ι = i_inf.left →
        (⨆ j : Fin M, W j) = ⊤ →
        (∀ j : Fin M,
          let V_j : V_plus.toScheme.Opens :=
            (TopologicalSpace.Opens.map (V_plus.ι ≫ p.left).base).obj (W j)
          ∃ (e_Wj : (W j).toScheme ≅ (weilAffineSpaceOver K (2 * d₀)).left)
            (e_Vj : V_j.toScheme ≅
              CategoryTheory.Limits.pullback (weilAffineSpaceOver K (2 * d₀)).hom
                (weilAffineSpaceOver K 1).hom),
            e_Wj.hom ≫ (weilAffineSpaceOver K (2 * d₀)).hom = (W j).ι ≫ B.hom ∧
            e_Vj.hom ≫
                CategoryTheory.Limits.pullback.fst (weilAffineSpaceOver K (2 * d₀)).hom
                  (weilAffineSpaceOver K 1).hom =
              ((V_plus.ι ≫ p.left) ∣_ (W j)) ≫ e_Wj.hom) →
        (∀ c : ℕ,
          Subsingleton (weilEtaleTorsionH (weilGeomScheme K P) (ℓ ^ (r + 1)) (2 * c + 1))) ∧
        (∀ c : ℕ, c ≤ 2 * d₀ + 1 →
          ∀ (f_P : weilEtaleTorsionH (weilGeomScheme K P) (ℓ ^ (r + 1)) (2 * c) →+
                weilEtaleTorsionH (weilGeomScheme K P) (ℓ ^ (r + 1)) (2 * c)),
            WeilIsTorsionGeomFrobAction K P (ℓ ^ (r + 1)) (2 * c) f_P →
            ∀ w, f_P w = (Nat.card K ^ c) • w) := by
    intro d₀ B P _ _ _ _ _ _ hB_odd hB_even p i₀ i_inf V_plus s_inf_V M W
      hi₀_p hi_inf_p hi₀_cl hV_compl hs_inf_V hW_cov hW_triv
    let V_ov : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)) :=
      CategoryTheory.Over.mk (V_plus.ι ≫ P.hom)
    let j_V : V_ov ⟶ P := CategoryTheory.Over.homMk V_plus.ι rfl
    let f_V : V_ov ⟶ B := CategoryTheory.Over.homMk (V_plus.ι ≫ p.left)
      (by change (V_plus.ι ≫ p.left) ≫ B.hom = V_plus.ι ≫ P.hom
          rw [CategoryTheory.Category.assoc, p.w])
    let s_V_ov : B ⟶ V_ov := CategoryTheory.Over.homMk s_inf_V
      (by change s_inf_V ≫ V_plus.ι ≫ P.hom = B.hom
          rw [← CategoryTheory.Category.assoc, hs_inf_V, i_inf.w])
    obtain ⟨j_V_bar, hjV_fst, hpb_jV⟩ := hMakeBcHom j_V
    obtain ⟨f_V_bar, hfV_fst, _⟩ := hMakeBcHom f_V
    obtain ⟨s_V_bar, hsV_fst, _⟩ := hMakeBcHom s_V_ov
    obtain ⟨p_bar, hp_fst, _⟩ := hMakeBcHom p
    obtain ⟨i₀_bar, hi₀_fst, hpb_i₀⟩ := hMakeBcHom i₀
    obtain ⟨i_inf_bar, hiinf_fst, _⟩ := hMakeBcHom i_inf

    let pr_B : weilGeomScheme K B ⟶ B.left := CategoryTheory.Limits.pullback.fst B.hom
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))
    let W_bar : Fin M → (weilGeomScheme K B).Opens :=
      fun j => (TopologicalSpace.Opens.map pr_B.base).obj (W j)
    have hW_bar_cov : (⨆ j : Fin M, W_bar j) = ⊤ := by
      rw [eq_top_iff]
      intro y _
      have hy : pr_B.base y ∈ (⨆ j : Fin M, W j) := by
