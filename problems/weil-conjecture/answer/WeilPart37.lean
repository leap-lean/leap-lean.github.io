      intro a
      obtain ⟨y₀, hy₀⟩ := hf_Xi_bij.2 (θ_i a)
      obtain ⟨a₀, ha₀_y⟩ := hθ_i_bij.2 y₀
      have ha₀ : f_Xi (θ_i a₀) = θ_i a := by rw [ha₀_y, hy₀]
      have hCup1 : θ_top (CategoryTheory.Abelian.Ext.comp a b₁ hc_top) =
          (Nat.card K ^ d) • θ_top (CategoryTheory.Abelian.Ext.comp a₀ b₀ hc_top) := by
        have h1 := (hFrobModPkg K X).2.2 (ℓ ^ (r + 1)) (2 * d - 2 * c) (2 * c) (2 * d)
          hc_top f_Xi f_X f_top θ_i θ_2c θ_top hf_Xi hf_X hf_top hθ_i hθ_2c hθ_top
          a₀ b₀ a b₁ ha₀ (by rw [hb₀, hb₁])
        have htop_smul := weil_etale_top_degree_geom_frob_smul K X d ℓ hℓ (r + 1) f_top hf_top
          (θ_top (CategoryTheory.Abelian.Ext.comp a₀ b₀ hc_top))
        rw [← h1, htop_smul]
      have hγ₀_Z : p_iZ (θ_i ((Nat.card K ^ (d - c)) • a₀ - a)) = 0 := by
        rw [map_sub, map_nsmul, map_sub, map_nsmul, ← ha₀,
