      rw [TopologicalSpace.Opens.mem_iSup] at hz_top
      rcases hz_top with ⟨b, hzb⟩
      let w : ↥(W b).toScheme := ⟨z, hzb⟩
      have hw_val : (W b).ι.base w = z := rfl
      have hΨz : Ψ.base z = (Ψ_chart b).base w := by
        dsimp only [Ψ_chart]
        rw [← hw_val, ← hΨ_chart b]
        rfl
      change Ψ.base z ∈ D_μ ↔ z ∈ W μ
      rw [hΨz]
      have h_pre_away :=
        AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜_K (hX_hom b) zero_lt_one
