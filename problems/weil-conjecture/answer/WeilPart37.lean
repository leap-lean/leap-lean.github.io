        (MvPolynomial.C : K →+* MvPolynomial (Fin d) K) e_tgt hSmC
      have hSm2 := (@RingHom.isStandardSmoothOfRelativeDimension_respectsIso d).2
        (e_tgt.toRingHom.comp (MvPolynomial.C : K →+* MvPolynomial (Fin d) K)) e_src hSm1
      have hEqHom : (Y.hom.appLE ⊤ (C i) h_le_top).hom =
