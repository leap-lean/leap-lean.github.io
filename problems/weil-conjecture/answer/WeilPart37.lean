  have hpb_outer_Zs : CategoryTheory.IsPullback (π_Zbar ≫ pr_Z) Z_s_bar.hom f₀.left (s_bar ≫ pr_D) := by
    rw [hπ_fst, hs_fst]
    exact hpb_paste_Zs
  have hπ_fbar : π_Zbar ≫ f_bar.left = Z_s_bar.hom ≫ s_bar := by
    have hcond_Zs : pr_Zs ≫ Z_s.hom = Z_s_bar.hom ≫ g_k :=
      CategoryTheory.Limits.pullback.condition
    apply CategoryTheory.Limits.pullback.hom_ext
    · change (π_Zbar ≫ f_bar.left) ≫ pr_D = (Z_s_bar.hom ≫ s_bar) ≫ pr_D
      rw [CategoryTheory.Category.assoc, ← hPb_fbar'.w, ← CategoryTheory.Category.assoc,
        hπ_fst, CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition]
      change pr_Zs ≫ Z_s.hom ≫ s = (Z_s_bar.hom ≫ s_bar) ≫ pr_D
      rw [← CategoryTheory.Category.assoc, hcond_Zs, CategoryTheory.Category.assoc,
        CategoryTheory.Category.assoc, hs_fst]
    · change (π_Zbar ≫ f_bar.left) ≫ D_bar.hom = (Z_s_bar.hom ≫ s_bar) ≫ D_bar.hom
      rw [CategoryTheory.Category.assoc, f_bar.w, hπ_snd, CategoryTheory.Category.assoc,
        hs_snd, CategoryTheory.Category.comp_id]
  have hpb_Zs_bar : CategoryTheory.IsPullback π_Zbar Z_s_bar.hom f_bar.left s_bar :=
    CategoryTheory.IsPullback.of_right hpb_outer_Zs hπ_fbar hPb_fbar'
  let e_Zs := hpb_Zs_bar.isoPullback

  
  let n_mod : ℕ := ℓ ^ (r + 1)
