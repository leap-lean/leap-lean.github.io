      rw [h_u10, hOv₁]
      have hpre_inv : (TopologicalSpace.Opens.map (j_1.inv ≫ U₁.ι).base).obj
          (Z_t.basicOpen (ψ₁ Polynomial.X)) =
          PrimeSpectrum.basicOpen (Polynomial.X : Polynomial R) := by
        have hj1_inv : j_1.inv ≫ U₁.ι =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁.symm.toRingHom) ≫ hAff₁.fromSpec := by
          change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁.symm.toRingHom) ≫
            hAff₁.isoSpec.inv) ≫ U₁.ι = _
          rw [CategoryTheory.Category.assoc, hAff₁.isoSpec_inv_ι]
        rw [hj1_inv]
        change (TopologicalSpace.Opens.map
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁.symm.toRingHom)).base).obj
          (hAff₁.fromSpec ⁻¹ᵁ Z_t.basicOpen (ψ₁ Polynomial.X)) = _
        rw [AlgebraicGeometry.Scheme.Hom.preimage_basicOpen, hAff₁.basicOpen_fromSpec_app,
