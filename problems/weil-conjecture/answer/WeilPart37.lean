    have hev_Xb : ∀ b : Fin (1 + 1), ev b (MvPolynomial.X b) = 1 := by
      intro b
      dsimp [ev]
      rw [MvPolynomial.eval₂Hom_X']
      simp only [↓reduceIte]
    have hev_Xother : ∀ b : Fin (1 + 1), ev b (MvPolynomial.X (other b)) = Polynomial.X := by
      intro b
