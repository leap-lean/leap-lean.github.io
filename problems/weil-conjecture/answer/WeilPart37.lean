  let _ : AlgebraicGeometry.IsProper π_s.left := hProp_πs
  let _ : CategoryTheory.IsIso (π_s.left ∣_ U_s) := hIso_πs

  obtain ⟨y₀, hy₀_fst, hy₀_sec, _, hy₀_range⟩ := hSecPb Z_s x_s0 hx_s0_sec
  let U_Y : Z_s_bar.left.Opens := (TopologicalSpace.Opens.map pr_Zs.base).obj U_s
  have hUY_compl : (U_Y : Set Z_s_bar.left) = (Set.range y₀.base)ᶜ := by
    ext y
