                  ℓ ^ (t + 1) * (a + b).val + ℓ ^ (t + 2) * ((a.val + b.val) / ℓ)
                      = ℓ ^ (t + 1) * ((a + b).val + ℓ * ((a.val + b.val) / ℓ)) := by ring
                  _ = ℓ ^ (t + 1) * (a.val + b.val) := by rw [hdiv]
                  _ = ℓ ^ (t + 1) * a.val + ℓ ^ (t + 1) * b.val := mul_add _ _ _
              have hcast := congrArg (fun n : ℕ => (n : ZMod (ℓ ^ (t + 2)))) hmul
              push_cast at hcast ⊢
              have hz : ((ℓ : ZMod (ℓ ^ (t + 2))) ^ (t + 2)) = 0 := by
                rw [← Nat.cast_pow, CharP.cast_eq_zero]
              rw [hz, zero_mul, add_zero] at hcast
              exact hcast }
      let hdvd_t : ℓ ^ (t + 1) ∣ ℓ ^ (t + 2) := pow_dvd_pow ℓ (Nat.le_succ (t + 1))
      let π_t : AddCommGrpCat.of (ZMod (ℓ ^ (t + 2))) ⟶ AddCommGrpCat.of (ZMod (ℓ ^ (t + 1))) :=
        AddCommGrpCat.ofHom (ZMod.castHom hdvd_t (ZMod (ℓ ^ (t + 1)))).toAddMonoidHom
      have h0_t : ι_t ≫ π_t = 0 := by
        ext a
        change ZMod.castHom hdvd_t (ZMod (ℓ ^ (t + 1)))
          ((ℓ ^ (t + 1) * a.val : ℕ) : ZMod (ℓ ^ (t + 2))) = 0
        rw [map_natCast, Nat.cast_mul, CharP.cast_eq_zero, zero_mul]
      have hMono_ιt : CategoryTheory.Mono ι_t := by
        rw [AddCommGrpCat.mono_iff_injective, injective_iff_map_eq_zero]
        intro a ha
        change ((ℓ ^ (t + 1) * a.val : ℕ) : ZMod (ℓ ^ (t + 2))) = 0 at ha
        rw [ZMod.natCast_eq_zero_iff] at ha
        have hdvd : ℓ ∣ a.val :=
          (Nat.mul_dvd_mul_iff_left (pow_pos hPrime.pos (t + 1))).mp (pow_succ ℓ (t + 1) ▸ ha)
        have hval0 : a.val = 0 := Nat.eq_zero_of_dvd_of_lt hdvd (ZMod.val_lt a)
        exact ZMod.val_injective ℓ (hval0.trans ZMod.val_zero.symm)
      have hEpi_πt : CategoryTheory.Epi π_t := by
        rw [AddCommGrpCat.epi_iff_surjective]
        intro b
        refine ⟨(b.val : ZMod (ℓ ^ (t + 2))), ?_⟩
        change ZMod.castHom hdvd_t (ZMod (ℓ ^ (t + 1))) ((b.val : ℕ) : ZMod (ℓ ^ (t + 2))) = b
        rw [map_natCast, ZMod.natCast_zmod_val]
      have hEx_t : (CategoryTheory.ShortComplex.mk ι_t π_t h0_t).Exact := by
        rw [CategoryTheory.ShortComplex.ab_exact_iff_range_eq_ker]
        apply le_antisymm
        · rintro _ ⟨a, rfl⟩
          exact ConcreteCategory.congr_hom h0_t a
        · intro y hy
          change ZMod.castHom hdvd_t (ZMod (ℓ ^ (t + 1))) y = 0 at hy
          rw [← ZMod.natCast_zmod_val y, map_natCast, ZMod.natCast_eq_zero_iff] at hy
          rcases hy with ⟨q, hq⟩
          let a : ZMod ℓ := (q : ZMod ℓ)
          refine ⟨a, ?_⟩
          have hq_div : a.val + ℓ * (q / ℓ) = q := by
            dsimp [a]
            rw [ZMod.val_natCast]
            exact Nat.mod_add_div q ℓ
          have hmul : ℓ ^ (t + 1) * a.val + ℓ ^ (t + 2) * (q / ℓ) = y.val := by
            calc
              ℓ ^ (t + 1) * a.val + ℓ ^ (t + 2) * (q / ℓ)
                  = ℓ ^ (t + 1) * (a.val + ℓ * (q / ℓ)) := by ring
              _ = ℓ ^ (t + 1) * q := by rw [hq_div]
              _ = y.val := hq.symm
          have hcast := congrArg (fun n : ℕ => (n : ZMod (ℓ ^ (t + 2)))) hmul
          push_cast at hcast
          have hz : ((ℓ : ZMod (ℓ ^ (t + 2))) ^ (t + 2)) = 0 := by
            rw [← Nat.cast_pow, CharP.cast_eq_zero]
          rw [hz, zero_mul, add_zero, ZMod.natCast_zmod_val] at hcast
          change (((ℓ ^ (t + 1) * a.val : ℕ) : ZMod (ℓ ^ (t + 2)))) = y
          push_cast
          exact hcast
      have hSE_t : (CategoryTheory.ShortComplex.mk ι_t π_t h0_t).ShortExact :=
        CategoryTheory.ShortComplex.ShortExact.mk' hEx_t hMono_ιt hEpi_πt
      let SC_ulift := (CategoryTheory.ShortComplex.mk ι_t π_t h0_t).map AddCommGrpCat.uliftFunctor.{u, 0}
      have hSE_ulift : SC_ulift.ShortExact :=
        hSE_t.map_of_exact AddCommGrpCat.uliftFunctor.{u, 0}
      let SC_const := SC_ulift.map (CategoryTheory.Functor.const (Opposite Z.left.Etale))
      have hSE_const : SC_const.ShortExact :=
        hSE_ulift.map_of_exact (CategoryTheory.Functor.const (Opposite Z.left.Etale))
      let SC_sh := SC_const.map (CategoryTheory.presheafToSheaf J_Z AddCommGrpCat.{u})
      have hSE_sh : SC_sh.ShortExact :=
        hSE_const.map_of_exact (CategoryTheory.presheafToSheaf J_Z AddCommGrpCat.{u})
      let F_coh := CategoryTheory.Sheaf.cohomologyPresheafFunctor J_Z p
      let α_pre := CategoryTheory.Functor.whiskerLeft B_i.op (F_coh.map SC_sh.f)
      let β_pre := CategoryTheory.Functor.whiskerLeft B_i.op (F_coh.map SC_sh.g)
      have hαβ_pre : α_pre ≫ β_pre = 0 := by
        have hcomp_coh : F_coh.map SC_sh.f ≫ F_coh.map SC_sh.g = 0 := by
          rw [← F_coh.map_comp, SC_sh.zero]
          ext V_op x
          let x' : CategoryTheory.Abelian.Ext _ SC_sh.X₁ p := x
          change x'.comp (CategoryTheory.Abelian.Ext.mk₀ (0 : SC_sh.X₁ ⟶ SC_sh.X₃))
            (Nat.add_zero p) = 0
          rw [CategoryTheory.Abelian.Ext.mk₀_zero, CategoryTheory.Abelian.Ext.comp_zero]
        apply CategoryTheory.NatTrans.ext
        funext W_op
        exact CategoryTheory.NatTrans.congr_app hcomp_coh (B_i.op.obj W_op)
      let SC_pre := CategoryTheory.ShortComplex.mk α_pre β_pre hαβ_pre
      have hEx_pre : SC_pre.Exact := by
        rw [CategoryTheory.ShortComplex.exact_iff_epi_kernel_lift]
        have : ∀ (W_op : Opposite X.left.Etale),
            CategoryTheory.Epi ((CategoryTheory.Limits.kernel.lift β_pre α_pre hαβ_pre).app W_op) := by
          intro W_op
          let ev_W := (CategoryTheory.evaluation (Opposite X.left.Etale) AddCommGrpCat.{u}).obj W_op
          let SC_W := CategoryTheory.ShortComplex.mk (ev_W.map α_pre) (ev_W.map β_pre)
            (congrArg (fun γ => ev_W.map γ) hαβ_pre)
          have hEx_W : SC_W.Exact := by
            rw [CategoryTheory.ShortComplex.ab_exact_iff_range_eq_ker]
            apply le_antisymm
            · rintro _ ⟨w_x, rfl⟩
              exact ConcreteCategory.congr_hom SC_W.zero w_x
            · intro x hx
              exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ _ hSE_sh x hx
          have hEpi_liftW : CategoryTheory.Epi
              (CategoryTheory.Limits.kernel.lift SC_W.g SC_W.f SC_W.zero) :=
            (CategoryTheory.ShortComplex.exact_iff_epi_kernel_lift SC_W).mp hEx_W
          let e_ker := CategoryTheory.Limits.PreservesKernel.iso ev_W β_pre
          have hfac_ker : ev_W.map (CategoryTheory.Limits.kernel.lift β_pre α_pre hαβ_pre) ≫
              e_ker.hom = CategoryTheory.Limits.kernel.lift SC_W.g SC_W.f SC_W.zero := by
            apply (CategoryTheory.cancel_mono (CategoryTheory.Limits.kernel.ι (ev_W.map β_pre))).mp
            change (ev_W.map (CategoryTheory.Limits.kernel.lift β_pre α_pre hαβ_pre) ≫
                e_ker.hom) ≫ CategoryTheory.Limits.kernel.ι (ev_W.map β_pre) =
              CategoryTheory.Limits.kernel.lift (ev_W.map β_pre) (ev_W.map α_pre) SC_W.zero ≫
                CategoryTheory.Limits.kernel.ι (ev_W.map β_pre)
            rw [CategoryTheory.Category.assoc,
              CategoryTheory.Limits.PreservesKernel.iso_hom,
              CategoryTheory.Limits.kernelComparison_comp_ι,
              CategoryTheory.Limits.kernel.lift_ι,
              ← ev_W.map_comp,
              CategoryTheory.Limits.kernel.lift_ι]
          have heq_app : (CategoryTheory.Limits.kernel.lift β_pre α_pre hαβ_pre).app W_op =
              CategoryTheory.Limits.kernel.lift SC_W.g SC_W.f SC_W.zero ≫ e_ker.inv :=
            (CategoryTheory.Category.comp_id _).symm.trans
              ((congrArg (_ ≫ ·) e_ker.hom_inv_id.symm).trans
                ((CategoryTheory.Category.assoc _ e_ker.hom e_ker.inv).symm.trans
                  (congrArg (· ≫ e_ker.inv) hfac_ker)))
          have hEpi_einv : CategoryTheory.Epi e_ker.inv :=
            ⟨fun a b hab =>
              (CategoryTheory.Category.id_comp a).symm.trans
                ((congrArg (· ≫ a) e_ker.hom_inv_id.symm).trans
                  ((CategoryTheory.Category.assoc e_ker.hom e_ker.inv a).trans
                    ((congrArg (e_ker.hom ≫ ·) hab).trans
                      ((CategoryTheory.Category.assoc e_ker.hom e_ker.inv b).symm.trans
                        ((congrArg (· ≫ b) e_ker.hom_inv_id).trans
                          (CategoryTheory.Category.id_comp b))))))⟩
          rw [heq_app]
          exact ⟨fun a b hab => hEpi_einv.left_cancellation a b
            (hEpi_liftW.left_cancellation (e_ker.inv ≫ a) (e_ker.inv ≫ b)
              ((CategoryTheory.Category.assoc _ e_ker.inv a).symm.trans
                (hab.trans (CategoryTheory.Category.assoc _ e_ker.inv b))))⟩
        exact CategoryTheory.NatTrans.epi_of_epi_app _
      let shX := CategoryTheory.presheafToSheaf J_X AddCommGrpCat.{u}
      have hEx_shX : (SC_pre.map shX).Exact := hEx_pre.map shX
      have hZ₁ : CategoryTheory.Limits.IsZero ((SC_pre.map shX).X₁) := hBase_ℓ p hp
      have hZ₃ : CategoryTheory.Limits.IsZero ((SC_pre.map shX).X₃) := iht p hp
      have hf0 : (SC_pre.map shX).f = 0 := hZ₁.eq_of_src _ 0
      have hg0 : (SC_pre.map shX).g = 0 := hZ₃.eq_of_tgt _ 0
      have : CategoryTheory.Epi
          (CategoryTheory.Limits.kernel.lift (SC_pre.map shX).g (SC_pre.map shX).f
            (SC_pre.map shX).zero) :=
        (CategoryTheory.ShortComplex.exact_iff_epi_kernel_lift (SC_pre.map shX)).mp hEx_shX
      have hlift0 : CategoryTheory.Limits.kernel.lift (SC_pre.map shX).g (SC_pre.map shX).f
          (SC_pre.map shX).zero = 0 := by
        apply (CategoryTheory.cancel_mono (CategoryTheory.Limits.kernel.ι (SC_pre.map shX).g)).mp
        rw [CategoryTheory.Limits.kernel.lift_ι, hf0, CategoryTheory.Limits.zero_comp]
      have hZ_ker : CategoryTheory.Limits.IsZero (CategoryTheory.Limits.kernel (SC_pre.map shX).g) := by
        rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero,
          ← CategoryTheory.cancel_epi (CategoryTheory.Limits.kernel.lift (SC_pre.map shX).g
            (SC_pre.map shX).f (SC_pre.map shX).zero),
          CategoryTheory.Category.comp_id, CategoryTheory.Limits.comp_zero, hlift0]
      let e_ker_mid : CategoryTheory.Limits.kernel (SC_pre.map shX).g ≅ (SC_pre.map shX).X₂ :=
        { hom := CategoryTheory.Limits.kernel.ι (SC_pre.map shX).g
          inv := CategoryTheory.Limits.kernel.lift (SC_pre.map shX).g (𝟙 _)
            (by rw [hg0, CategoryTheory.Limits.comp_zero])
          hom_inv_id := by
            apply (CategoryTheory.cancel_mono (CategoryTheory.Limits.kernel.ι (SC_pre.map shX).g)).mp
            simp
          inv_hom_id := CategoryTheory.Limits.kernel.lift_ι _ _ _ }
      exact hZ_ker.of_iso e_ker_mid.symm
  exact hBock r

theorem weil_sq_rmcc_point_modif_localTorsion_counit_pullback_bijective (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ r : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ)
    (Y_tilde Y E : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsProper Y_tilde.hom]
    [AlgebraicGeometry.IsProper Y.hom]
