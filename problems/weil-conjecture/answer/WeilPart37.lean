  let _ : AlgebraicGeometry.GeometricallyIrreducible Z_tilde_s.hom := hGeom_Zts
  let _ : AlgebraicGeometry.IsProper Z_tilde_s.hom := hProp_Zts
  let _ : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) Z_tilde_s.hom := hSm_Zts
  let _ : AlgebraicGeometry.IsProper Q_s.hom := hProp_Qs
