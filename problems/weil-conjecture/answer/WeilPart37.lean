      CategoryTheory.Limits.pullback.lift (fst₂ ≫ fst₁) (snd₂ ≫ u_k₂_k) (by
        have hc₁ : fst₁ ≫ W.hom = W₂.hom ≫ g_FF₂ := CategoryTheory.Limits.pullback.condition
        have hc₂ : fst₂ ≫ W₂.hom = snd₂ ≫ g_F₂k₂ := CategoryTheory.Limits.pullback.condition
