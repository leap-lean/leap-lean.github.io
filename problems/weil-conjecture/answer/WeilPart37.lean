    let adj_L : ∀ (m : ℕ) [Fact (1 < m)], L_0 m ⊣ Fgt_of m :=
      fun m _ =>
        letI : ∀ (A : AddCommGrpCat.{u}),
            Module (ULift.{u, 0} (ZMod m)) (↥A ⧸ (nsmulAddMonoidHom m : ↥A →+ ↥A).range) :=
          modQuot_of m
        CategoryTheory.Adjunction.mkOfHomEquiv
          { homEquiv := fun A V =>
              { toFun := fun φ => AddCommGrpCat.ofHom
                  (((Fgt_of m).map φ).hom.comp (QuotientAddGroup.mk' _))
                invFun := fun ψ => ModuleCat.ofHom
                  { toAddHom := (QuotientAddGroup.lift _ ψ.hom (by
                      rintro _ ⟨a, rfl⟩
                      simp only [AddMonoidHom.mem_ker, nsmulAddMonoidHom_apply, map_nsmul]
                      exact hMod_tor m V (ψ.hom a))).toAddHom
                    map_smul' := fun c q => by
                      obtain ⟨a, rfl⟩ := QuotientAddGroup.mk_surjective q
                      let va : ↥V := ψ.hom a
