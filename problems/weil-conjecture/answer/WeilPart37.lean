          have h : eq₀.symm.toRingHom.comp eq₀.toRingHom = RingHom.id _ :=
            RingHom.ext eq₀.symm_apply_apply
          rw [h, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
        inv_hom_id := by
          rw [← hsymm, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          have h : eq₀.toRingHom.comp eq₀.symm.toRingHom = RingHom.id _ :=
            RingHom.ext eq₀.apply_symm_apply
          rw [h, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id] }
    exact ⟨e₀_spec⟩

  have hAffSuccIso : ∀ N : ℕ,
      Nonempty ((weilAffineSpaceOver k (N + 1)).left ≅
        CategoryTheory.Limits.pullback (weilAffineSpaceOver k N).hom
          (weilAffineSpaceOver k 1).hom) := by
    intro N
    let R_N := MvPolynomial (Fin N) k
    let R_1 := MvPolynomial (Fin 1) k
    let e₁ : MvPolynomial (Fin (N + 1)) k ≃+* Polynomial R_N :=
      (MvPolynomial.finSuccEquiv k N).toRingEquiv
    let e₂_alg : MvPolynomial (Fin 1) R_N ≃ₐ[R_N] Polynomial R_N :=
      MvPolynomial.uniqueAlgEquiv R_N (Fin 1)
    let e₃_alg : TensorProduct k R_N R_1 ≃ₐ[R_N] MvPolynomial (Fin 1) R_N :=
      MvPolynomial.algebraTensorAlgEquiv k R_N
    let e_ring : MvPolynomial (Fin (N + 1)) k ≃+* TensorProduct k R_N R_1 :=
      (e₁.trans e₂_alg.symm.toRingEquiv).trans e₃_alg.symm.toRingEquiv
    let e_spec : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin (N + 1)) k)) ≅
        AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct k R_N R_1)) :=
      { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_ring.symm.toRingHom)
        inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_ring.toRingHom)
        hom_inv_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          have h : e_ring.symm.toRingHom.comp e_ring.toRingHom = RingHom.id _ :=
            RingHom.ext e_ring.symm_apply_apply
          rw [h, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
        inv_hom_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          have h : e_ring.toRingHom.comp e_ring.symm.toRingHom = RingHom.id _ :=
            RingHom.ext e_ring.apply_symm_apply
          rw [h, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id] }
    exact ⟨e_spec ≪≫ (AlgebraicGeometry.pullbackSpecIso k R_N R_1).symm⟩

  
  
  
  have hBundleBij : ∀ (B V : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (f : V ⟶ B) (δ M : ℕ) (W : Fin M → B.left.Opens),
      (⨆ j : Fin M, W j) = ⊤ →
      (∀ j : Fin M,
        let V_j : V.left.Opens := (TopologicalSpace.Opens.map f.left.base).obj (W j)
        ∃ (e_B : (W j).toScheme ≅ (weilAffineSpaceOver k δ).left)
          (e_V : V_j.toScheme ≅
            CategoryTheory.Limits.pullback (weilAffineSpaceOver k δ).hom
              (weilAffineSpaceOver k 1).hom),
          e_B.hom ≫ (weilAffineSpaceOver k δ).hom = (W j).ι ≫ B.hom ∧
          e_V.hom ≫
              CategoryTheory.Limits.pullback.fst (weilAffineSpaceOver k δ).hom
                (weilAffineSpaceOver k 1).hom =
            (f.left ∣_ (W j)) ≫ e_B.hom) →
      ∀ (q : ℕ)
        (p_f : weilEtaleTorsionH B.left (ℓ ^ (r + 1)) q →+
          weilEtaleTorsionH V.left (ℓ ^ (r + 1)) q),
        WeilIsTorsionEtalePullback f.left (ℓ ^ (r + 1)) q p_f →
        Function.Bijective p_f := by
    intro B V f δ M W hCov hTriv q p_f hp_f
    refine weil_odp_punct_sm_bockstein_prime_pow_pullback_bijective ℓ f.left ?_ r q p_f hp_f
    intro q₁ p₁ hp₁
    rcases hp₁ with ⟨hCont, hRightAdj, hAdd, hLim, hColim, T_V, hT_V, T_B, hT_B, ιℤ, hι₁, hι₂, hp₁_eq⟩
    let _ := hCont
    let _ := hRightAdj
    let _ := hAdd
    let _ := hLim
    let _ := hColim
    let B_f := weilEtaleSitePullback f.left
    let J_V := V.left.smallEtaleTopology
    let J_B := B.left.smallEtaleTopology
    let A_ℓ := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))
    let F_V := weilEtaleTorsionSheaf V.left ℓ
    let F_B := weilEtaleTorsionSheaf B.left ℓ
    let pf_f := B_f.sheafPushforwardContinuous AddCommGrpCat.{u} J_B J_V
    let adj_V := CategoryTheory.constantSheafAdj J_V AddCommGrpCat.{u} hT_V
    let adj_B := CategoryTheory.constantSheafAdj J_B AddCommGrpCat.{u} hT_B
    let τ_f := hT_V.from (B_f.obj T_B)
    let η_f : F_B ⟶ pf_f.obj F_V :=
      (adj_B.homEquiv A_ℓ (pf_f.obj F_V)).symm
        (CategoryTheory.CategoryStruct.comp (adj_V.unit.app A_ℓ) (F_V.obj.map τ_f.op))
    have hIso_η : CategoryTheory.IsIso η_f :=
      hConstUnitIso f.left hT_V hT_B A_ℓ (hBundleConnBasis B V f δ M W hCov hTriv)
    have hHDIZero : ∀ b : ℕ, 1 ≤ b →
        CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f.left b F_V) := by
      intro b hb
      let R_B := weilEtaleHigherDirectImage f.left b F_V
      let S_δ := weilAffineSpaceOver k δ
      let S_1 := weilAffineSpaceOver k 1
      let P_δ := CategoryTheory.Limits.pullback S_δ.hom S_1.hom
      let pr₁ := CategoryTheory.Limits.pullback.fst S_δ.hom S_1.hom
      let F_Pδ := weilEtaleTorsionSheaf P_δ ℓ
      let R_model := weilEtaleHigherDirectImage pr₁ b F_Pδ
      have hZero_model : CategoryTheory.Limits.IsZero R_model := hA1Zero δ b hb
      obtain ⟨hPB_ex, _, hPB_comp, hPB_const, _, _⟩ := weil_etale_pullback_exact_and_pseudofunctor.{u} ℓ
      refine weil_etale_geometric_point_stalk_conservativity B.left R_B ?_
      intro Ω _ _ x_bar
      obtain ⟨pt₀⟩ : Nonempty ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)) := inferInstance
      have hx_top : x_bar.base pt₀ ∈ (⨆ j : Fin M, W j) := by
        rw [hCov]; trivial
      obtain ⟨j, hxj⟩ := TopologicalSpace.Opens.mem_iSup.mp hx_top
      obtain ⟨e_B, e_V, _, he_V⟩ := hTriv j
      have hrange_x : Set.range x_bar.base ⊆ Set.range (W j).ι.base := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        rintro _ ⟨pt, rfl⟩
        have hpt : pt = pt₀ := Subsingleton.elim pt pt₀
        rwa [hpt]
      let x_W : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ (W j).toScheme :=
        AlgebraicGeometry.IsOpenImmersion.lift (W j).ι x_bar hrange_x
      have hx_W : x_W ≫ (W j).ι = x_bar :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac (W j).ι x_bar hrange_x
      let V_j : V.left.Opens := (TopologicalSpace.Opens.map f.left.base).obj (W j)
      let f_j : V_j.toScheme ⟶ (W j).toScheme := f.left ∣_ (W j)
      let F_Vj := weilEtaleTorsionSheaf V_j.toScheme ℓ
      let R_Wj := weilEtaleHigherDirectImage f_j b F_Vj
      have hPB_Wj : WeilIsEtaleSheafPullback (W j).ι R_B R_Wj :=
        weil_leray_sec_etale_baseChange_higherDirectImage B.left V.left (W j).toScheme V_j.toScheme
          f.left (W j).ι f_j V_j.ι (AlgebraicGeometry.isPullback_morphismRestrict f.left (W j))
          F_V F_Vj (hPB_const V_j.ι A_ℓ) b
      have hPB_eB : WeilIsEtaleSheafPullback e_B.hom R_model R_Wj :=
        weil_leray_sec_etale_baseChange_higherDirectImage S_δ.left P_δ (W j).toScheme V_j.toScheme
          pr₁ e_B.hom f_j e_V.hom (CategoryTheory.IsPullback.of_vert_isIso ⟨he_V.symm⟩)
          F_Pδ F_Vj (hPB_const e_V.hom A_ℓ) b
      obtain ⟨F_pull, hPB_Fpull, _, hZero_Fpull_imp⟩ := hPB_ex e_B.hom R_model
      have hZero_Fpull : CategoryTheory.Limits.IsZero F_pull := hZero_Fpull_imp hZero_model
      have hZero_RWj : CategoryTheory.Limits.IsZero R_Wj := by
        rcases hPB_eB with ⟨hc₁, hr₁, ⟨iso₁⟩⟩
        rcases hPB_Fpull with ⟨hc₂, hr₂, ⟨iso₂⟩⟩
        have h_c : hc₁ = hc₂ := Subsingleton.elim _ _
        subst h_c
        have h_r : hr₁ = hr₂ := Subsingleton.elim _ _
        subst h_r
        exact hZero_Fpull.of_iso (iso₁.symm ≪≫ iso₂)
      obtain ⟨G₀, hPB_xW, _, hZero_G₀_imp⟩ := hPB_ex x_W R_Wj
      have hZero_G₀ : CategoryTheory.Limits.IsZero G₀ := hZero_G₀_imp hZero_RWj
      have hPB_comp_x : WeilIsEtaleSheafPullback (x_W ≫ (W j).ι) R_B G₀ :=
        (hPB_comp x_W (W j).ι R_B R_Wj G₀).1 hPB_Wj hPB_xW
      rw [hx_W] at hPB_comp_x
      exact ⟨G₀, hPB_comp_x, hZero_G₀⟩
    have hBij_can := ((weil_etale_bockstein_and_degenerate_leray_ext_calculus.{u}).2.2.1
      f.left hT_V hT_B ιℤ hι₁ hι₂).1 F_B F_V η_f hIso_η hHDIZero q₁
    have hp₁_fun : (⇑p₁ : weilEtaleTorsionH B.left ℓ q₁ → weilEtaleTorsionH V.left ℓ q₁) = _ :=
      funext hp₁_eq
    rw [hp₁_fun]
    exact hBij_can

  have hAffSub : ∀ (N q : ℕ), 1 ≤ q →
      Subsingleton (weilEtaleTorsionH (weilAffineSpaceOver k N).left (ℓ ^ (r + 1)) q) := by
    intro N q hq
    set n_mod := ℓ ^ (r + 1)
    induction N with
    | zero =>
      let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
      let Z₀ : CategoryTheory.Over S_k := CategoryTheory.Over.mk (𝟙 S_k)
      have hLFT₀ : AlgebraicGeometry.LocallyOfFiniteType Z₀.hom := by
        change AlgebraicGeometry.LocallyOfFiniteType (𝟙 S_k); infer_instance
      have hQC₀ : AlgebraicGeometry.QuasiCompact Z₀.hom := by
        change AlgebraicGeometry.QuasiCompact (𝟙 S_k); infer_instance
      have hDim₀ : topologicalKrullDim Z₀.left ≤ (0 : WithBot ℕ∞) := by
        have h1 : topologicalKrullDim ↥S_k = ringKrullDim k :=
          PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim k
        change topologicalKrullDim ↥S_k ≤ (0 : WithBot ℕ∞)
        rw [h1, ringKrullDim_eq_zero_of_field]
      have hSub_k : Subsingleton (weilEtaleTorsionH S_k n_mod q) :=
        weil_etale_dim_zero_algClosed_cohomology_subsingleton k Z₀ hDim₀
          (weilEtaleTorsionSheaf Z₀.left n_mod) q hq
      obtain ⟨e₀⟩ := hAffZeroIso
      obtain ⟨p_e₀, hBij_e₀⟩ := hPullIsoBij e₀ n_mod q
      refine ⟨fun x y => ?_⟩
      obtain ⟨a, rfl⟩ := hBij_e₀.2 x
      obtain ⟨b, rfl⟩ := hBij_e₀.2 y
      exact congrArg p_e₀ (hSub_k.elim a b)
    | succ N ih =>
      let B_N := weilAffineSpaceOver k N
      let S_1 := weilAffineSpaceOver k 1
      let pr₁_N := CategoryTheory.Limits.pullback.fst B_N.hom S_1.hom
      let P_N : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
        CategoryTheory.Over.mk (pr₁_N ≫ B_N.hom)
      let f_N : P_N ⟶ B_N := CategoryTheory.Over.homMk pr₁_N rfl
      have hTriv_N : ∀ j : Fin 1,
          let V_j : P_N.left.Opens := (TopologicalSpace.Opens.map f_N.left.base).obj ⊤
          ∃ (e_B : (⊤ : B_N.left.Opens).toScheme ≅ B_N.left)
            (e_V : V_j.toScheme ≅ CategoryTheory.Limits.pullback B_N.hom S_1.hom),
            e_B.hom ≫ B_N.hom = (⊤ : B_N.left.Opens).ι ≫ B_N.hom ∧
            e_V.hom ≫ pr₁_N = (f_N.left ∣_ (⊤ : B_N.left.Opens)) ≫ e_B.hom := by
        intro _ V_j
        refine ⟨B_N.left.topIso, P_N.left.topIso, ?_, ?_⟩
        · rw [AlgebraicGeometry.Scheme.topIso_hom]
        · rw [AlgebraicGeometry.Scheme.topIso_hom, AlgebraicGeometry.Scheme.topIso_hom]
          exact (AlgebraicGeometry.morphismRestrict_ι f_N.left ⊤).symm
      obtain ⟨p_fN, hp_fN⟩ := hPullEx f_N.left n_mod q
      have hBij_fN := hBundleBij B_N P_N f_N N 1 (fun _ => ⊤) iSup_const hTriv_N q p_fN hp_fN
      have hSub_PN : Subsingleton (weilEtaleTorsionH P_N.left n_mod q) := by
        refine ⟨fun u v => ?_⟩
        obtain ⟨a, rfl⟩ := hBij_fN.2 u
        obtain ⟨b, rfl⟩ := hBij_fN.2 v
        exact congrArg p_fN (ih.elim a b)
      obtain ⟨e_succ⟩ := hAffSuccIso N
      obtain ⟨p_succ, hBij_succ⟩ := hPullIsoBij e_succ n_mod q
      refine ⟨fun x y => ?_⟩
      obtain ⟨u, rfl⟩ := hBij_succ.2 x
      obtain ⟨v, rfl⟩ := hBij_succ.2 y
      exact congrArg p_succ (hSub_PN.elim u v)

  exact ⟨hAffSub, hBundleBij⟩

theorem weil_sq_rmcc_clopen_freeYoneda_partition_of_unity (S : AlgebraicGeometry.Scheme.{u}) (U₀ U₁ : S.Opens)
    (hInf : U₀ ⊓ U₁ = ⊥) (hSup : U₀ ⊔ U₁ = ⊤) :
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let J_S := S.smallEtaleTopology
    let Fℤ_S := (CategoryTheory.constantSheaf J_S AddCommGrpCat.{u}).obj Aℤ
    let Pℤ_S := (CategoryTheory.Functor.const (Opposite S.Etale)).obj Aℤ
    let U₀_et : S.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ U₀.ι
      (inferInstance : AlgebraicGeometry.Etale U₀.ι)
    let U₁_et : S.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ U₁.ι
      (inferInstance : AlgebraicGeometry.Etale U₁.ι)
    let Z₀ := CategoryTheory.Sheaf.freeYoneda J_S U₀_et Aℤ
    let Z₁ := CategoryTheory.Sheaf.freeYoneda J_S U₁_et Aℤ
    let κ₀ : Z₀ ⟶ Fℤ_S := CategoryTheory.Sheaf.freeYonedaHomEquiv.symm
      (((CategoryTheory.sheafificationAdjunction J_S AddCommGrpCat.{u}).unit.app Pℤ_S).app
        (Opposite.op U₀_et))
    let κ₁ : Z₁ ⟶ Fℤ_S := CategoryTheory.Sheaf.freeYonedaHomEquiv.symm
      (((CategoryTheory.sheafificationAdjunction J_S AddCommGrpCat.{u}).unit.app Pℤ_S).app
        (Opposite.op U₁_et))
    ∃ (σ₀ : Fℤ_S ⟶ Z₀) (σ₁ : Fℤ_S ⟶ Z₁),
      σ₀ ≫ κ₀ + σ₁ ≫ κ₁ = 𝟙 Fℤ_S :=
by
  intro Aℤ J_S Fℤ_S Pℤ_S U₀_et U₁_et Z₀ Z₁ κ₀ κ₁
  have : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  have hJ_eq :=
    AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology S
      (le_refl (@AlgebraicGeometry.Etale))
  let T_S : S.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (𝟙 S)
    (inferInstance : AlgebraicGeometry.Etale (𝟙 S))
  let toTS : ∀ W : S.Etale, W ⟶ T_S := fun W =>
    CategoryTheory.MorphismProperty.Over.homMk W.hom (CategoryTheory.Category.comp_id W.hom) trivial
  have hT_S : CategoryTheory.Limits.IsTerminal T_S :=
    CategoryTheory.Limits.IsTerminal.ofUniqueHom toTS (fun W g =>
      CategoryTheory.MorphismProperty.Comma.Hom.ext
        ((CategoryTheory.Category.comp_id g.left).symm.trans
          (CategoryTheory.MorphismProperty.Over.w g))
        (Subsingleton.elim _ _))
  let adj_S := CategoryTheory.constantSheafAdj J_S AddCommGrpCat.{u} hT_S
  let X_fam : Bool → S.Etale := fun i => match i with | false => U₀_et | true => U₁_et
  let u_fam : ∀ i : Bool, X_fam i ⟶ T_S := fun i => toTS (X_fam i)
  have hBot_of_empty : ∀ (W : S.Etale), IsEmpty ↥W.left → ⊥ ∈ J_S W := by
    intro W hEmpty
    let R_bot : CategoryTheory.Sieve W := ⊥
    change R_bot ∈ (AlgebraicGeometry.Scheme.smallGrothendieckTopology (@AlgebraicGeometry.Etale) S) W
    rw [hJ_eq]
    exact (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
      (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) W R_bot).mpr
      (fun w => hEmpty.elim w)
  have hf_cov : CategoryTheory.Sieve.ofArrows X_fam u_fam ∈ J_S T_S := by
    change CategoryTheory.Sieve.ofArrows X_fam u_fam ∈
      (AlgebraicGeometry.Scheme.smallGrothendieckTopology (@AlgebraicGeometry.Etale) S) T_S
    rw [hJ_eq]
    refine (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
      (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) T_S _).mpr (fun x => ?_)
    let x' : ↥S := x
    have hx_top : x' ∈ U₀ ⊔ U₁ := hSup.symm ▸ (trivial : x' ∈ (⊤ : S.Opens))
    rcases TopologicalSpace.Opens.mem_sup.mp hx_top with hx₀ | hx₁
    · have hx₀' : x' ∈ Set.range U₀.ι.base := by
        rwa [AlgebraicGeometry.Scheme.Opens.range_ι]
      rcases hx₀' with ⟨y, hy⟩
      exact ⟨X_fam false, u_fam false, y,
        CategoryTheory.Sieve.ofArrows_mk X_fam u_fam false,
        (inferInstance : AlgebraicGeometry.Etale U₀.ι), hy⟩
    · have hx₁' : x' ∈ Set.range U₁.ι.base := by
        rwa [AlgebraicGeometry.Scheme.Opens.range_ι]
      rcases hx₁' with ⟨y, hy⟩
      exact ⟨X_fam true, u_fam true, y,
        CategoryTheory.Sieve.ofArrows_mk X_fam u_fam true,
        (inferInstance : AlgebraicGeometry.Etale U₁.ι), hy⟩
  have hDisjEmpty : ∀ (W : S.Etale) (g₀ : W ⟶ U₀_et) (g₁ : W ⟶ U₁_et), IsEmpty ↥W.left := by
    intro W g₀ g₁
    refine ⟨fun w => ?_⟩
    have hw₀_eq : U₀.ι.base (g₀.left.base w) = W.hom.base w :=
      (AlgebraicGeometry.Scheme.Hom.comp_apply g₀.left U₀.ι w).symm.trans
        (congrArg (fun h : W.left ⟶ S => h.base w) (CategoryTheory.MorphismProperty.Over.w g₀))
    have hw₀ : W.hom.base w ∈ U₀ := by
      change W.hom.base w ∈ (U₀ : Set ↥S)
      rw [← AlgebraicGeometry.Scheme.Opens.range_ι U₀]
      exact ⟨g₀.left.base w, hw₀_eq⟩
    have hw₁_eq : U₁.ι.base (g₁.left.base w) = W.hom.base w :=
      (AlgebraicGeometry.Scheme.Hom.comp_apply g₁.left U₁.ι w).symm.trans
        (congrArg (fun h : W.left ⟶ S => h.base w) (CategoryTheory.MorphismProperty.Over.w g₁))
    have hw₁ : W.hom.base w ∈ U₁ := by
      change W.hom.base w ∈ (U₁ : Set ↥S)
      rw [← AlgebraicGeometry.Scheme.Opens.range_ι U₁]
      exact ⟨g₁.left.base w, hw₁_eq⟩
    have hmem : W.hom.base w ∈ U₀ ⊓ U₁ := TopologicalSpace.Opens.mem_inf.mpr ⟨hw₀, hw₁⟩
    rw [hInf] at hmem
    change W.hom.base w ∈ ((⊥ : S.Opens) : Set ↥S) at hmem
    rw [TopologicalSpace.Opens.coe_bot] at hmem
    exact hmem
  let 𝒢 : CategoryTheory.Sheaf J_S AddCommGrpCat.{u} := CategoryTheory.Limits.biprod Z₀ Z₁
  let s_fam : ∀ i : Bool, Aℤ ⟶ 𝒢.obj.obj (Opposite.op (X_fam i)) := fun i =>
    match i with
    | false => CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.Limits.biprod.inl : Z₀ ⟶ 𝒢)
    | true => CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.Limits.biprod.inr : Z₁ ⟶ 𝒢)
  have hx : ∀ ⦃W : S.Etale⦄ ⦃i j : Bool⦄ (a : W ⟶ X_fam i) (b : W ⟶ X_fam j),
      a ≫ u_fam i = b ≫ u_fam j →
      s_fam i ≫ 𝒢.obj.map a.op = s_fam j ≫ 𝒢.obj.map b.op := by
    intro W i j a b _hab
    cases i <;> cases j
    · have hab_left : a.left = b.left := by
        apply (CategoryTheory.cancel_mono U₀.ι).mp
        exact (CategoryTheory.MorphismProperty.Over.w a).trans
          (CategoryTheory.MorphismProperty.Over.w b).symm
      have hab_eq : a = b :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext hab_left (Subsingleton.elim _ _)
      rw [hab_eq]
    · exact (CategoryTheory.Sheaf.isTerminalOfBotCover 𝒢 W
        (hBot_of_empty W (hDisjEmpty W a b))).hom_ext _ _
    · exact (CategoryTheory.Sheaf.isTerminalOfBotCover 𝒢 W
        (hBot_of_empty W (hDisjEmpty W b a))).hom_ext _ _
    · have hab_left : a.left = b.left := by
        apply (CategoryTheory.cancel_mono U₁.ι).mp
        exact (CategoryTheory.MorphismProperty.Over.w a).trans
          (CategoryTheory.MorphismProperty.Over.w b).symm
      have hab_eq : a = b :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext hab_left (Subsingleton.elim _ _)
      rw [hab_eq]
  let s : Aℤ ⟶ 𝒢.obj.obj (Opposite.op T_S) :=
    𝒢.property.amalgamateOfArrows u_fam hf_cov s_fam hx
  have hs_false : s ≫ 𝒢.obj.map (u_fam false).op = s_fam false :=
    𝒢.property.amalgamateOfArrows_map u_fam hf_cov s_fam hx false
  have hs_true : s ≫ 𝒢.obj.map (u_fam true).op = s_fam true :=
    𝒢.property.amalgamateOfArrows_map u_fam hf_cov s_fam hx true
  let ψ : Fℤ_S ⟶ 𝒢 := (adj_S.homEquiv Aℤ 𝒢).symm s
  let σ₀ : Fℤ_S ⟶ Z₀ := ψ ≫ CategoryTheory.Limits.biprod.fst
  let σ₁ : Fℤ_S ⟶ Z₁ := ψ ≫ CategoryTheory.Limits.biprod.snd
  let κ_desc : 𝒢 ⟶ Fℤ_S := CategoryTheory.Limits.biprod.desc κ₀ κ₁
  have hFreeEquiv_comp : ∀ (U_et : S.Etale)
      {F G : CategoryTheory.Sheaf J_S AddCommGrpCat.{u}}
      (α : CategoryTheory.Sheaf.freeYoneda J_S U_et Aℤ ⟶ F) (g : F ⟶ G),
      CategoryTheory.Sheaf.freeYonedaHomEquiv (α ≫ g) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ g.hom.app (Opposite.op U_et) :=
    fun U_et {F G} α g =>
      (congrArg CategoryTheory.Presheaf.freeYonedaHomEquiv
        ((CategoryTheory.sheafificationAdjunction J_S AddCommGrpCat.{u}).homEquiv_naturality_right α g)).trans
        (CategoryTheory.Presheaf.freeYonedaHomEquiv_comp _ g.hom)
  let η_const : Pℤ_S ⟶ Fℤ_S.obj :=
    (CategoryTheory.sheafificationAdjunction J_S AddCommGrpCat.{u}).unit.app Pℤ_S
  have hLHS : (adj_S.homEquiv Aℤ Fℤ_S) (ψ ≫ κ_desc) = s ≫ κ_desc.hom.app (Opposite.op T_S) :=
    (adj_S.homEquiv_naturality_right ψ κ_desc).trans
      (congrArg (fun m => m ≫ κ_desc.hom.app (Opposite.op T_S))
        ((adj_S.homEquiv Aℤ 𝒢).apply_symm_apply s))
  have hRHS : (adj_S.homEquiv Aℤ Fℤ_S) (𝟙 Fℤ_S) =
      (η_const.app (Opposite.op T_S) : Aℤ ⟶ Fℤ_S.obj.obj (Opposite.op T_S)) :=
    (adj_S.homEquiv_unit Aℤ Fℤ_S (𝟙 Fℤ_S)).trans
      ((congrArg (fun m => adj_S.unit.app Aℤ ≫ m)
          (((CategoryTheory.sheafSections J_S AddCommGrpCat.{u}).obj (Opposite.op T_S)).map_id Fℤ_S)).trans
        ((CategoryTheory.Category.comp_id (adj_S.unit.app Aℤ)).trans
          ((CategoryTheory.Adjunction.comp_unit_app
              (CategoryTheory.constantPresheafAdj AddCommGrpCat.{u} hT_S)
              (CategoryTheory.sheafificationAdjunction J_S AddCommGrpCat.{u}) Aℤ).trans
            ((congrArg (fun m => m ≫ η_const.app (Opposite.op T_S))
                (CategoryTheory.constantPresheafAdj_unit_app AddCommGrpCat.{u} hT_S Aℤ)).trans
              (CategoryTheory.Category.id_comp (η_const.app (Opposite.op T_S)))))))
  refine ⟨σ₀, σ₁, ?_⟩
  have hSum : σ₀ ≫ κ₀ + σ₁ ≫ κ₁ = ψ ≫ κ_desc := by
    dsimp [σ₀, σ₁, κ_desc]
    rw [CategoryTheory.Limits.biprod.desc_eq, CategoryTheory.Preadditive.comp_add,
      CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]
  rw [hSum]
  apply (adj_S.homEquiv Aℤ Fℤ_S).injective
  refine hLHS.trans ((?_ : s ≫ κ_desc.hom.app (Opposite.op T_S) =
    (η_const.app (Opposite.op T_S) : Aℤ ⟶ Fℤ_S.obj.obj (Opposite.op T_S))).trans hRHS.symm)
  refine Fℤ_S.property.hom_ext_ofArrows u_fam hf_cov (fun i => ?_)
  cases i
  · calc
      (s ≫ κ_desc.hom.app (Opposite.op T_S)) ≫ Fℤ_S.obj.map (u_fam false).op
          = s ≫ (κ_desc.hom.app (Opposite.op T_S) ≫ Fℤ_S.obj.map (u_fam false).op) :=
            CategoryTheory.Category.assoc _ _ _
      _ = s ≫ (𝒢.obj.map (u_fam false).op ≫ κ_desc.hom.app (Opposite.op U₀_et)) :=
            congrArg (fun m => s ≫ m) (κ_desc.hom.naturality (u_fam false).op).symm
      _ = (s ≫ 𝒢.obj.map (u_fam false).op) ≫ κ_desc.hom.app (Opposite.op U₀_et) :=
            (CategoryTheory.Category.assoc _ _ _).symm
      _ = s_fam false ≫ κ_desc.hom.app (Opposite.op U₀_et) :=
            congrArg (fun m => m ≫ κ_desc.hom.app (Opposite.op U₀_et)) hs_false
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv
            ((CategoryTheory.Limits.biprod.inl : Z₀ ⟶ 𝒢) ≫ κ_desc) :=
            (hFreeEquiv_comp U₀_et CategoryTheory.Limits.biprod.inl κ_desc).symm
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv κ₀ :=
            congrArg CategoryTheory.Sheaf.freeYonedaHomEquiv
              (CategoryTheory.Limits.biprod.inl_desc κ₀ κ₁)
      _ = (η_const.app (Opposite.op U₀_et) : Aℤ ⟶ Fℤ_S.obj.obj (Opposite.op U₀_et)) :=
            CategoryTheory.Sheaf.freeYonedaHomEquiv.apply_symm_apply _
      _ = Pℤ_S.map (u_fam false).op ≫ η_const.app (Opposite.op U₀_et) :=
            (CategoryTheory.Category.id_comp (η_const.app (Opposite.op U₀_et))).symm
      _ = (η_const.app (Opposite.op T_S) : Aℤ ⟶ Fℤ_S.obj.obj (Opposite.op T_S)) ≫
            Fℤ_S.obj.map (u_fam false).op :=
            η_const.naturality (u_fam false).op
  · calc
      (s ≫ κ_desc.hom.app (Opposite.op T_S)) ≫ Fℤ_S.obj.map (u_fam true).op
          = s ≫ (κ_desc.hom.app (Opposite.op T_S) ≫ Fℤ_S.obj.map (u_fam true).op) :=
            CategoryTheory.Category.assoc _ _ _
      _ = s ≫ (𝒢.obj.map (u_fam true).op ≫ κ_desc.hom.app (Opposite.op U₁_et)) :=
            congrArg (fun m => s ≫ m) (κ_desc.hom.naturality (u_fam true).op).symm
      _ = (s ≫ 𝒢.obj.map (u_fam true).op) ≫ κ_desc.hom.app (Opposite.op U₁_et) :=
            (CategoryTheory.Category.assoc _ _ _).symm
      _ = s_fam true ≫ κ_desc.hom.app (Opposite.op U₁_et) :=
            congrArg (fun m => m ≫ κ_desc.hom.app (Opposite.op U₁_et)) hs_true
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv
            ((CategoryTheory.Limits.biprod.inr : Z₁ ⟶ 𝒢) ≫ κ_desc) :=
            (hFreeEquiv_comp U₁_et CategoryTheory.Limits.biprod.inr κ_desc).symm
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv κ₁ :=
            congrArg CategoryTheory.Sheaf.freeYonedaHomEquiv
              (CategoryTheory.Limits.biprod.inr_desc κ₀ κ₁)
      _ = (η_const.app (Opposite.op U₁_et) : Aℤ ⟶ Fℤ_S.obj.obj (Opposite.op U₁_et)) :=
            CategoryTheory.Sheaf.freeYonedaHomEquiv.apply_symm_apply _
      _ = Pℤ_S.map (u_fam true).op ≫ η_const.app (Opposite.op U₁_et) :=
            (CategoryTheory.Category.id_comp (η_const.app (Opposite.op U₁_et))).symm
      _ = (η_const.app (Opposite.op T_S) : Aℤ ⟶ Fℤ_S.obj.obj (Opposite.op T_S)) ≫
            Fℤ_S.obj.map (u_fam true).op :=
            η_const.naturality (u_fam true).op

theorem weil_sq_rmcc_open_int_freeYoneda_counit_comp_zero (S : AlgebraicGeometry.Scheme.{u}) (U : S.Opens) (n q : ℕ)
    (p_U : weilEtaleTorsionH S n q →+ weilEtaleTorsionH U.toScheme n q)
    (hp_U : WeilIsTorsionEtalePullback U.ι n q p_U)
    (x : weilEtaleTorsionH S n q) (hx : p_U x = 0) :
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let J_S := S.smallEtaleTopology
    let Fℤ_S := (CategoryTheory.constantSheaf J_S AddCommGrpCat.{u}).obj Aℤ
    let Pℤ_S := (CategoryTheory.Functor.const (Opposite S.Etale)).obj Aℤ
    let U_et : S.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ U.ι
      (inferInstance : AlgebraicGeometry.Etale U.ι)
    let Z_U := CategoryTheory.Sheaf.freeYoneda J_S U_et Aℤ
    let κℤ_U : Z_U ⟶ Fℤ_S := CategoryTheory.Sheaf.freeYonedaHomEquiv.symm
      (((CategoryTheory.sheafificationAdjunction J_S AddCommGrpCat.{u}).unit.app Pℤ_S).app
        (Opposite.op U_et))
    (CategoryTheory.Abelian.Ext.mk₀ κℤ_U).comp x (Nat.zero_add q) = 0 :=
by
  haveI : CategoryTheory.EnoughInjectives
      (CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}) :=
    inferInstance

  
  have hStep2Engine :
      ∀ {C₁ C₂ : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C₁]
        [CategoryTheory.Category.{u, u + 1} C₂]
        (J₁ : CategoryTheory.GrothendieckTopology C₁)
        (J₂ : CategoryTheory.GrothendieckTopology C₂)
        [CategoryTheory.HasSheafify J₂ AddCommGrpCat.{u}]
        (F : C₁ ⥤ C₂) [F.IsContinuous J₁ J₂]
        (W : C₂)
        (Z_obj : ∀ V : C₂, (V ⟶ W) → C₁)
        (u_tilde : ∀ {V' V : C₂} (u : V' ⟶ V) (φ : V ⟶ W), Z_obj V' (u ≫ φ) ⟶ Z_obj V φ)
        (π_Z : ∀ Z : C₁, F.obj Z ⟶ W)
        (e_Z : ∀ Z : C₁, Z_obj (F.obj Z) (π_Z Z) ⟶ Z)
        (κ_Vφ : ∀ (V : C₂) (φ : V ⟶ W), V ⟶ F.obj (Z_obj V φ))
        (h_ut_id : ∀ (V : C₂) (φ : V ⟶ W),
          u_tilde (𝟙 V) φ = CategoryTheory.eqToHom (congrArg (Z_obj V) (CategoryTheory.Category.id_comp φ)))
        (h_ut_comp : ∀ {V'' V' V : C₂} (u₁ : V'' ⟶ V') (u₂ : V' ⟶ V) (φ : V ⟶ W),
          u_tilde (u₁ ≫ u₂) φ =
            CategoryTheory.eqToHom (congrArg (Z_obj V'') (CategoryTheory.Category.assoc u₁ u₂ φ)) ≫
              u_tilde u₁ (u₂ ≫ φ) ≫ u_tilde u₂ φ)
        (h_F_π : ∀ {Z₁ Z₂ : C₁} (g : Z₁ ⟶ Z₂), F.map g ≫ π_Z Z₂ = π_Z Z₁)
        (h_ut_e : ∀ {Z₁ Z₂ : C₁} (g : Z₁ ⟶ Z₂),
          u_tilde (F.map g) (π_Z Z₂) ≫ e_Z Z₂ =
            CategoryTheory.eqToHom (congrArg (Z_obj (F.obj Z₁)) (h_F_π g)) ≫ e_Z Z₁ ≫ g)
        (h_κ_F : ∀ {V' V : C₂} (u : V' ⟶ V) (φ : V ⟶ W),
          κ_Vφ V' (u ≫ φ) ≫ F.map (u_tilde u φ) = u ≫ κ_Vφ V φ)
        (h_κ_π : ∀ (V : C₂) (φ : V ⟶ W), κ_Vφ V φ ≫ π_Z (Z_obj V φ) = φ)
        (h_ut_κ_e : ∀ (V : C₂) (φ : V ⟶ W),
          u_tilde (κ_Vφ V φ) (π_Z (Z_obj V φ)) ≫ e_Z (Z_obj V φ) =
            CategoryTheory.eqToHom (congrArg (Z_obj V) (h_κ_π V φ)))
        (h_κ_Fe : ∀ Z : C₁, κ_Vφ (F.obj Z) (π_Z Z) ≫ F.map (e_Z Z) = 𝟙 (F.obj Z)),
        let R_sh := F.sheafPushforwardContinuous AddCommGrpCat.{u} J₁ J₂
        CategoryTheory.Limits.PreservesFiniteLimits R_sh ∧
          ∀ (ℐ : CategoryTheory.Sheaf J₂ AddCommGrpCat.{u}) [CategoryTheory.Injective ℐ],
            CategoryTheory.Injective (R_sh.obj ℐ) := by
    intro C₁ C₂ _ _ J₁ J₂ _ F _ W Z_obj u_tilde π_Z e_Z κ_Vφ
      h_ut_id h_ut_comp h_F_π h_ut_e h_κ_F h_κ_π h_ut_κ_e h_κ_Fe
    let R_sh := F.sheafPushforwardContinuous AddCommGrpCat.{u} J₁ J₂
    have hadj_LR : ∃ L_sh : CategoryTheory.Sheaf J₁ AddCommGrpCat.{u} ⥤
          CategoryTheory.Sheaf J₂ AddCommGrpCat.{u},
        L_sh.PreservesMonomorphisms ∧ Nonempty (L_sh ⊣ R_sh) := by
      let fam : (C₁ᵒᵖ ⥤ AddCommGrpCat.{u}) → ∀ V : C₂, (V ⟶ W) → AddCommGrpCat.{u} :=
        fun P_pre V ψ => P_pre.obj (Opposite.op (Z_obj V ψ))
      have hIdxEq : ∀ (P_pre : C₁ᵒᵖ ⥤ AddCommGrpCat.{u}) {V : C₂} {ψ₁ ψ₂ : V ⟶ W} (hψ : ψ₁ = ψ₂),
          P_pre.map (CategoryTheory.eqToHom (congrArg (Z_obj V) hψ)).op ≫
            CategoryTheory.Limits.Sigma.ι (fam P_pre V) ψ₁ =
          CategoryTheory.Limits.Sigma.ι (fam P_pre V) ψ₂ := by
        intro P_pre V ψ₁ ψ₂ hψ
        subst hψ
        rw [CategoryTheory.eqToHom_refl, CategoryTheory.op_id, P_pre.map_id,
          CategoryTheory.Category.id_comp]
      let L_pre : (C₁ᵒᵖ ⥤ AddCommGrpCat.{u}) ⥤ (C₂ᵒᵖ ⥤ AddCommGrpCat.{u}) :=
        { obj := fun P_pre =>
            { obj := fun V_op => CategoryTheory.Limits.sigmaObj (fam P_pre V_op.unop)
              map := fun {V₁_op V₂_op} f =>
                CategoryTheory.Limits.Sigma.desc fun φ =>
                  P_pre.map (u_tilde f.unop φ).op ≫
                    CategoryTheory.Limits.Sigma.ι (fam P_pre V₂_op.unop) (f.unop ≫ φ)
              map_id := fun V_op => by
                apply CategoryTheory.Limits.Sigma.hom_ext
                intro φ
                rw [CategoryTheory.Limits.Sigma.ι_comp_desc, CategoryTheory.Category.comp_id,
                  CategoryTheory.unop_id, h_ut_id]
                exact hIdxEq P_pre (CategoryTheory.Category.id_comp φ)
              map_comp := fun {V₁_op V₂_op V₃_op} f₁ f₂ => by
                apply CategoryTheory.Limits.Sigma.hom_ext
                intro φ
                rw [CategoryTheory.Limits.Sigma.ι_comp_desc, ← CategoryTheory.Category.assoc,
                  CategoryTheory.Limits.Sigma.ι_comp_desc, CategoryTheory.Category.assoc,
                  CategoryTheory.Limits.Sigma.ι_comp_desc, CategoryTheory.unop_comp, h_ut_comp]
                simp only [CategoryTheory.op_comp, CategoryTheory.Functor.map_comp,
                  CategoryTheory.Category.assoc]
                exact congrArg (fun t => P_pre.map _ ≫ P_pre.map _ ≫ t)
                  (hIdxEq P_pre (CategoryTheory.Category.assoc f₂.unop f₁.unop φ)) }
          map := fun {P₁ P₂} α =>
            { app := fun V_op =>
                CategoryTheory.Limits.Sigma.desc fun φ =>
                  α.app (Opposite.op (Z_obj V_op.unop φ)) ≫
                    CategoryTheory.Limits.Sigma.ι (fam P₂ V_op.unop) φ
              naturality := fun {V₁_op V₂_op} f => by
                apply CategoryTheory.Limits.Sigma.hom_ext
                intro φ
                dsimp
                rw [CategoryTheory.Limits.Sigma.ι_comp_desc_assoc, CategoryTheory.Category.assoc,
                  CategoryTheory.Limits.Sigma.ι_comp_desc,
                  CategoryTheory.Limits.Sigma.ι_comp_desc_assoc, CategoryTheory.Category.assoc,
                  CategoryTheory.Limits.Sigma.ι_comp_desc, ← CategoryTheory.Category.assoc,
                  α.naturality (u_tilde f.unop φ).op, CategoryTheory.Category.assoc] }
          map_id := fun P_pre => by
            ext V_op : 2
            apply CategoryTheory.Limits.Sigma.hom_ext
            intro φ
            dsimp
            rw [CategoryTheory.Limits.Sigma.ι_comp_desc, CategoryTheory.Category.id_comp,
              CategoryTheory.Category.comp_id]
          map_comp := fun {P₁ P₂ P₃} α β => by
            ext V_op : 2
            apply CategoryTheory.Limits.Sigma.hom_ext
            intro φ
            dsimp
            rw [CategoryTheory.Limits.Sigma.ι_comp_desc,
              CategoryTheory.Limits.Sigma.ι_comp_desc_assoc, CategoryTheory.Category.assoc,
              CategoryTheory.Category.assoc, CategoryTheory.Limits.Sigma.ι_comp_desc] }
      have : L_pre.PreservesMonomorphisms :=
        { preserves := fun {P₁ P₂} α hα => by
            rw [CategoryTheory.NatTrans.mono_iff_mono_app] at hα
            have : ∀ V_op : C₂ᵒᵖ, CategoryTheory.Mono ((L_pre.map α).app V_op) := fun V_op => by
              let Idx_V : Type u := V_op.unop ⟶ W
              have := CategoryTheory.AB4OfSize.ofShape (C := AddCommGrpCat.{u}) Idx_V
              let τ : CategoryTheory.Discrete.functor (fam P₁ V_op.unop) ⟶
                  CategoryTheory.Discrete.functor (fam P₂ V_op.unop) :=
                CategoryTheory.Discrete.natTrans fun j =>
                  α.app (Opposite.op (Z_obj V_op.unop j.as))
              have : ∀ j : CategoryTheory.Discrete Idx_V, CategoryTheory.Mono (τ.app j) :=
                fun _ => hα _
              have : CategoryTheory.Mono τ := CategoryTheory.NatTrans.mono_of_mono_app τ
              exact CategoryTheory.Limits.colim.map_mono' τ
                (CategoryTheory.Limits.colimit.isColimit
                  (CategoryTheory.Discrete.functor (fam P₁ V_op.unop)))
                (CategoryTheory.Limits.colimit.isColimit
                  (CategoryTheory.Discrete.functor (fam P₂ V_op.unop)))
                ((L_pre.map α).app V_op)
                (fun ⟨φ⟩ => CategoryTheory.Limits.Sigma.ι_comp_desc _ φ)
            exact CategoryTheory.NatTrans.mono_of_mono_app (L_pre.map α) }
      let R_pre : (C₂ᵒᵖ ⥤ AddCommGrpCat.{u}) ⥤ (C₁ᵒᵖ ⥤ AddCommGrpCat.{u}) :=
        { obj := fun Q => F.op ⋙ Q
          map := fun g => CategoryTheory.Functor.whiskerLeft F.op g }
      let ePreLR : ∀ (P_pre : C₁ᵒᵖ ⥤ AddCommGrpCat.{u}) (Q_pre : C₂ᵒᵖ ⥤ AddCommGrpCat.{u}),
          (L_pre.obj P_pre ⟶ Q_pre) ≃ (P_pre ⟶ R_pre.obj Q_pre) :=
        fun P_pre Q_pre =>
          { toFun := fun α =>
              { app := fun Z_op =>
                  P_pre.map (e_Z Z_op.unop).op ≫
                    CategoryTheory.Limits.Sigma.ι (fam P_pre (F.obj Z_op.unop)) (π_Z Z_op.unop) ≫
                      α.app (Opposite.op (F.obj Z_op.unop))
                naturality := fun {Z₁_op Z₂_op} g => by
                  dsimp [R_pre]
                  rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
                    ← α.naturality (F.map g.unop).op]
                  dsimp [L_pre]
                  rw [← CategoryTheory.Category.assoc (CategoryTheory.Limits.Sigma.ι _ _),
                    CategoryTheory.Limits.Sigma.ι_comp_desc,
                    ← CategoryTheory.Category.assoc (P_pre.map (e_Z Z₁_op.unop).op),
                    ← CategoryTheory.Category.assoc (P_pre.map (e_Z Z₁_op.unop).op),
                    ← P_pre.map_comp, ← CategoryTheory.op_comp, h_ut_e g.unop]
                  simp only [CategoryTheory.op_comp, CategoryTheory.Functor.map_comp,
                    CategoryTheory.Category.assoc]
                  have hidx := congrArg (· ≫ α.app (Opposite.op (F.obj Z₂_op.unop)))
                    (hIdxEq P_pre (h_F_π g.unop))
                  rw [CategoryTheory.Category.assoc] at hidx
                  exact congrArg (fun t => P_pre.map g ≫ P_pre.map (e_Z Z₂_op.unop).op ≫ t) hidx.symm }
            invFun := fun β =>
              { app := fun V_op =>
                  CategoryTheory.Limits.Sigma.desc fun φ =>
                    β.app (Opposite.op (Z_obj V_op.unop φ)) ≫
                      Q_pre.map (κ_Vφ V_op.unop φ).op
                naturality := fun {V₁_op V₂_op} f => by
                  apply CategoryTheory.Limits.Sigma.hom_ext
                  intro φ
                  dsimp [L_pre]
                  rw [CategoryTheory.Limits.Sigma.ι_comp_desc_assoc, CategoryTheory.Category.assoc,
                    CategoryTheory.Limits.Sigma.ι_comp_desc,
                    CategoryTheory.Limits.Sigma.ι_comp_desc_assoc, ← CategoryTheory.Category.assoc,
                    β.naturality (u_tilde f.unop φ).op]
                  dsimp [R_pre]
                  rw [CategoryTheory.Category.assoc, ← Q_pre.map_comp, ← CategoryTheory.op_comp,
                    h_κ_F f.unop φ, CategoryTheory.op_comp, Q_pre.map_comp,
                    CategoryTheory.Category.assoc]
                  rfl }
            left_inv := fun α => by
              ext V_op : 2
              apply CategoryTheory.Limits.Sigma.hom_ext
              intro φ
              dsimp
              rw [CategoryTheory.Limits.Sigma.ι_comp_desc, CategoryTheory.Category.assoc,
                CategoryTheory.Category.assoc, ← α.naturality (κ_Vφ V_op.unop φ).op]
              dsimp [L_pre]
              rw [← CategoryTheory.Category.assoc (CategoryTheory.Limits.Sigma.ι _ _),
                CategoryTheory.Limits.Sigma.ι_comp_desc,
                ← CategoryTheory.Category.assoc (P_pre.map _),
                ← CategoryTheory.Category.assoc (P_pre.map _),
                ← P_pre.map_comp, ← CategoryTheory.op_comp, h_ut_κ_e V_op.unop φ]
              exact (CategoryTheory.Category.assoc _ _ _).trans
                (congrArg (· ≫ α.app V_op) (hIdxEq P_pre (h_κ_π V_op.unop φ)))
            right_inv := fun β => by
              ext Z_op : 2
              dsimp
              rw [CategoryTheory.Limits.Sigma.ι_comp_desc, ← CategoryTheory.Category.assoc,
                β.naturality (e_Z Z_op.unop).op]
              dsimp [R_pre]
              rw [CategoryTheory.Category.assoc, ← Q_pre.map_comp, ← CategoryTheory.op_comp,
                h_κ_Fe Z_op.unop, CategoryTheory.op_id, Q_pre.map_id,
                CategoryTheory.Category.comp_id] }
      have hePreLR_left_symm : ∀ {P' P : C₁ᵒᵖ ⥤ AddCommGrpCat.{u}} {Q : C₂ᵒᵖ ⥤ AddCommGrpCat.{u}}
          (f : P' ⟶ P) (β : P ⟶ R_pre.obj Q),
          (ePreLR P' Q).symm (f ≫ β) = L_pre.map f ≫ (ePreLR P Q).symm β := by
        intro P' P Q f β
        ext V_op : 2
        apply CategoryTheory.Limits.Sigma.hom_ext
        intro φ
        dsimp [L_pre, ePreLR]
        rw [CategoryTheory.Limits.Sigma.ι_comp_desc,
          CategoryTheory.Limits.Sigma.ι_comp_desc_assoc, CategoryTheory.Category.assoc,
