              ((𝒦.obj.map (Opposite.op (M_h.map u_f₁ ≫ π₁_cov T))).hom s)) := by
      intro g T s Y f₁ hEt_VY V_Y u_f₁ ι_Y
      have hfac : ι_Y ≫ M_h.map u_f₁ = f₁ :=
        CategoryTheory.MorphismProperty.Over.Hom.ext (CategoryTheory.Category.id_comp f₁.left)
      have h1 : (ℱ.obj.map (Opposite.op f₁)).hom
          ((g.hom.app (Opposite.op (V_cov T))).hom ((𝒦.obj.map (Opposite.op (π₁_cov T))).hom s)) =
          (ℱ.obj.map (Opposite.op ι_Y)).hom
            ((ℱ.obj.map (Opposite.op (M_h.map u_f₁))).hom
              ((g.hom.app (Opposite.op (V_cov T))).hom ((𝒦.obj.map (Opposite.op (π₁_cov T))).hom s))) :=
        (congrArg (fun k => (ℱ.obj.map (Opposite.op k)).hom _) hfac.symm).trans
          (congrArg (fun φ => (AddCommGrpCat.Hom.hom φ) _)
            (ℱ.obj.map_comp (Opposite.op (M_h.map u_f₁)) (Opposite.op ι_Y)))
      have hgnat := congrArg
        (fun φ => (AddCommGrpCat.Hom.hom φ) ((𝒦.obj.map (Opposite.op (π₁_cov T))).hom s))
        (g.hom.naturality (Opposite.op u_f₁))
      have h2 : (𝒦.obj.map (Opposite.op (M_h.map u_f₁))).hom
          ((𝒦.obj.map (Opposite.op (π₁_cov T))).hom s) =
          (𝒦.obj.map (Opposite.op (M_h.map u_f₁ ≫ π₁_cov T))).hom s :=
        congrArg (fun φ => (AddCommGrpCat.Hom.hom φ) s)
          (𝒦.obj.map_comp (Opposite.op (π₁_cov T)) (Opposite.op (M_h.map u_f₁))).symm
      exact h1.trans
        (congrArg (ℱ.obj.map (Opposite.op ι_Y)).hom
          (hgnat.symm.trans (congrArg (g.hom.app (Opposite.op V_Y)).hom h2)))
    have hVanishPull : ∀ (g : Quiver.Hom (h_res.obj 𝒦) (h_res.obj ℱ))
        (T : S.Etale) (s : ↥(𝒦.obj.obj (Opposite.op T)))
        {Y : S.Etale} (f₁ : Y ⟶ M_h.obj (V_cov T)),
        Set.range Y.hom.base ⊆ (U_c : Set ↥S) →
        (ℱ.obj.map (Opposite.op f₁)).hom
          ((g.hom.app (Opposite.op (V_cov T))).hom ((𝒦.obj.map (Opposite.op (π₁_cov T))).hom s)) = 0 := by
      intro g T s Y f₁ hY_range
      let hEt_VY : AlgebraicGeometry.Etale (f₁.left ≫ (V_cov T).hom) :=
        CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
          f₁.left (V_cov T).hom (hEtLeft f₁) (V_cov T).prop
      let V_Y : W₀.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤
        (f₁.left ≫ (V_cov T).hom) hEt_VY
      let u_f₁ : V_Y ⟶ V_cov T := CategoryTheory.MorphismProperty.Over.homMk f₁.left rfl trivial
      let ι_Y : Y ⟶ M_h.obj V_Y := CategoryTheory.MorphismProperty.Over.homMk
        (CategoryTheory.CategoryStruct.id Y.left)
        ((CategoryTheory.Category.id_comp _).trans
          ((CategoryTheory.Category.assoc f₁.left (V_cov T).hom h).trans (hOverW f₁)))
        trivial
      have hMVY_range : Set.range (M_h.obj V_Y).hom.base ⊆ (U_c : Set ↥S) := by
        have hhom : (M_h.obj V_Y).hom = Y.hom :=
          (CategoryTheory.Category.assoc f₁.left (V_cov T).hom h).trans (hOverW f₁)
        rw [hhom]
        exact hY_range
      have h0 := hVanish (M_h.obj V_Y) hMVY_range
        ((𝒦.obj.map (Opposite.op (M_h.map u_f₁ ≫ π₁_cov T))).hom s)
      exact (hFormulaStar g T s f₁).trans
        ((congrArg (fun z => (ℱ.obj.map (Opposite.op ι_Y)).hom
          ((g.hom.app (Opposite.op V_Y)).hom z)) h0).trans
          ((congrArg (ℱ.obj.map (Opposite.op ι_Y)).hom
            (g.hom.app (Opposite.op V_Y)).hom.map_zero).trans
            (ℱ.obj.map (Opposite.op ι_Y)).hom.map_zero))
    let secFam (g : Quiver.Hom (h_res.obj 𝒦) (h_res.obj ℱ))
        (T : S.Etale) (s : ↥(𝒦.obj.obj (Opposite.op T))) :
        ∀ b : Bool, ↥(ℱ.obj.obj (Opposite.op (covObj T b))) :=
      Bool.rec
        ((g.hom.app (Opposite.op (V_cov T))).hom ((𝒦.obj.map (Opposite.op (π₁_cov T))).hom s))
        0
    have hCompatCov : ∀ (g : Quiver.Hom (h_res.obj 𝒦) (h_res.obj ℱ))
        (T : S.Etale) (s : ↥(𝒦.obj.obj (Opposite.op T))),
        CategoryTheory.Presieve.Arrows.Compatible
          (ℱ.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u})
          (covHom T) (secFam g T s) := by
      intro g T s b₁ b₂ Y f₁ f₂ hf12
      cases b₁ <;> cases b₂
      · change (ℱ.obj.map (Opposite.op f₁)).hom
            ((g.hom.app (Opposite.op (V_cov T))).hom ((𝒦.obj.map (Opposite.op (π₁_cov T))).hom s)) =
          (ℱ.obj.map (Opposite.op f₂)).hom
            ((g.hom.app (Opposite.op (V_cov T))).hom ((𝒦.obj.map (Opposite.op (π₁_cov T))).hom s))
        let p_T := CategoryTheory.Limits.pullback.fst T.hom h
        let p_W := CategoryTheory.Limits.pullback.snd T.hom h
        let w₁ : Y.left ⟶ W₀ := f₁.left ≫ p_W
        let w₂ : Y.left ⟶ W₀ := f₂.left ≫ p_W
        have hw₁ : w₁ ≫ h = Y.hom :=
          (CategoryTheory.Category.assoc f₁.left p_W h).trans (hOverW f₁)
        have hw₂ : w₂ ≫ h = Y.hom :=
          (CategoryTheory.Category.assoc f₂.left p_W h).trans (hOverW f₂)
        let δ₁₂ : Y.left ⟶ CategoryTheory.Limits.pullback h h :=
          CategoryTheory.Limits.pullback.lift w₁ w₂ (hw₁.trans hw₂.symm)
        let O₁ : Y.left.Opens := (TopologicalSpace.Opens.map δ₁₂.base).obj Δ_h.opensRange
        let O₂ : Y.left.Opens := (TopologicalSpace.Opens.map Y.hom.base).obj U_c
        let Y₁ : S.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (O₁.ι ≫ Y.hom)
          (CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
            O₁.ι Y.hom inferInstance Y.prop)
        let Y₂ : S.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (O₂.ι ≫ Y.hom)
          (CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
            O₂.ι Y.hom inferInstance Y.prop)
        let j₁ : Y₁ ⟶ Y := CategoryTheory.MorphismProperty.Over.homMk O₁.ι rfl trivial
        let j₂ : Y₂ ⟶ Y := CategoryTheory.MorphismProperty.Over.homMk O₂.ι rfl trivial
        let diagObj : Bool → S.Etale := Bool.rec Y₁ Y₂
        let diagHom : ∀ c : Bool, diagObj c ⟶ Y := Bool.rec j₁ j₂
        have hDiagSieve : CategoryTheory.Sieve.ofArrows diagObj diagHom ∈ J_S Y := by
          rw [hMemEt]
          intro y
          by_cases hy : Y.hom.base y ∈ Set.range s_S.base
          · obtain ⟨z, hz⟩ := hy
            have hpt : (CategoryTheory.Limits.pullback.fst h h ≫ h).base (δ₁₂.base y) = s_S.base z := by
              calc
                (CategoryTheory.Limits.pullback.fst h h ≫ h).base (δ₁₂.base y)
                  = (δ₁₂ ≫ (CategoryTheory.Limits.pullback.fst h h ≫ h)).base y :=
                    (AlgebraicGeometry.Scheme.Hom.comp_apply _ _ y).symm
                _ = ((δ₁₂ ≫ CategoryTheory.Limits.pullback.fst h h) ≫ h).base y := by
                    rw [CategoryTheory.Category.assoc]
                _ = (w₁ ≫ h).base y := by
                    rw [CategoryTheory.Limits.pullback.lift_fst]
                _ = Y.hom.base y := by rw [hw₁]
                _ = s_S.base z := hz.symm
            obtain ⟨z₀, hz₀, _⟩ :=
              AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hpb_diag (δ₁₂.base y) z hpt
            have hyO₁ : y ∈ O₁ := by
              change δ₁₂.base y ∈ Set.range Δ_h.base
              refine ⟨s_W.base z₀, ?_⟩
              rw [← AlgebraicGeometry.Scheme.Hom.comp_apply s_W Δ_h z₀]
              exact hz₀
            exact ⟨diagObj false, diagHom false, ⟨y, hyO₁⟩,
              CategoryTheory.Sieve.ofArrows_mk diagObj diagHom false,
              (inferInstance : AlgebraicGeometry.Etale O₁.ι), rfl⟩
          · exact ⟨diagObj true, diagHom true, ⟨y, hy⟩,
              CategoryTheory.Sieve.ofArrows_mk diagObj diagHom true,
              (inferInstance : AlgebraicGeometry.Etale O₂.ι), rfl⟩
        have hf_pT : f₁.left ≫ p_T = f₂.left ≫ p_T := by
          have hleft := congrArg (fun k : Y ⟶ T => k.left) hf12
          exact hleft
        have hY₂_range : Set.range Y₂.hom.base ⊆ (U_c : Set ↥S) := by
          rintro _ ⟨y', rfl⟩
          have hy' : (O₂.ι ≫ Y.hom).base y' = Y.hom.base (O₂.ι.base y') :=
            AlgebraicGeometry.Scheme.Hom.comp_apply O₂.ι Y.hom y'
          change (O₂.ι ≫ Y.hom).base y' ∈ (U_c : Set ↥S)
          rw [hy']
          exact (y' : ↥O₂).2
        have hSep := CategoryTheory.Presieve.isSeparatedFor_iff_generate.mpr
          (hℱ_typeSheaf _ hDiagSieve).isSeparatedFor
        apply hSep.ext
        intro W u_W hu_W
        rcases hu_W with ⟨c⟩
        cases c
        · have hrange_Δ : Set.range (O₁.ι ≫ δ₁₂).base ⊆ Set.range Δ_h.base := by
            rintro _ ⟨y', rfl⟩
            rw [AlgebraicGeometry.Scheme.Hom.comp_apply]
            exact y'.2
          let d_lift : O₁.toScheme ⟶ W₀ :=
            AlgebraicGeometry.IsOpenImmersion.lift Δ_h (O₁.ι ≫ δ₁₂) hrange_Δ
          have hd_fac : d_lift ≫ Δ_h = O₁.ι ≫ δ₁₂ :=
            AlgebraicGeometry.IsOpenImmersion.lift_fac Δ_h (O₁.ι ≫ δ₁₂) hrange_Δ
          have hw12_O₁ : O₁.ι ≫ w₁ = O₁.ι ≫ w₂ := by
            have hd₁ : d_lift = O₁.ι ≫ w₁ := by
              calc
                d_lift = d_lift ≫ CategoryTheory.CategoryStruct.id W₀ :=
                  (CategoryTheory.Category.comp_id _).symm
                _ = d_lift ≫ (Δ_h ≫ CategoryTheory.Limits.pullback.fst h h) := by
                  rw [CategoryTheory.Limits.pullback.diagonal_fst]
                _ = (d_lift ≫ Δ_h) ≫ CategoryTheory.Limits.pullback.fst h h :=
                  (CategoryTheory.Category.assoc _ _ _).symm
                _ = O₁.ι ≫ (δ₁₂ ≫ CategoryTheory.Limits.pullback.fst h h) := by
                  rw [hd_fac, CategoryTheory.Category.assoc]
                _ = O₁.ι ≫ w₁ := by rw [CategoryTheory.Limits.pullback.lift_fst]
            have hd₂ : d_lift = O₁.ι ≫ w₂ := by
              calc
                d_lift = d_lift ≫ CategoryTheory.CategoryStruct.id W₀ :=
                  (CategoryTheory.Category.comp_id _).symm
                _ = d_lift ≫ (Δ_h ≫ CategoryTheory.Limits.pullback.snd h h) := by
                  rw [CategoryTheory.Limits.pullback.diagonal_snd]
                _ = (d_lift ≫ Δ_h) ≫ CategoryTheory.Limits.pullback.snd h h :=
                  (CategoryTheory.Category.assoc _ _ _).symm
                _ = O₁.ι ≫ (δ₁₂ ≫ CategoryTheory.Limits.pullback.snd h h) := by
                  rw [hd_fac, CategoryTheory.Category.assoc]
                _ = O₁.ι ≫ w₂ := by rw [CategoryTheory.Limits.pullback.lift_snd]
            exact hd₁.symm.trans hd₂
          have hj1_eq : j₁ ≫ f₁ = j₁ ≫ f₂ := by
            apply CategoryTheory.MorphismProperty.Over.Hom.ext
            apply CategoryTheory.Limits.pullback.hom_ext
            · exact (CategoryTheory.Category.assoc O₁.ι f₁.left p_T).trans
                ((congrArg (O₁.ι ≫ ·) hf_pT).trans
                  (CategoryTheory.Category.assoc O₁.ι f₂.left p_T).symm)
            · exact hw12_O₁
          change (ℱ.obj.map (Opposite.op j₁)).hom ((ℱ.obj.map (Opposite.op f₁)).hom _) =
            (ℱ.obj.map (Opposite.op j₁)).hom ((ℱ.obj.map (Opposite.op f₂)).hom _)
          have hm₁ : (ℱ.obj.map (Opposite.op j₁)).hom ((ℱ.obj.map (Opposite.op f₁)).hom
              ((g.hom.app (Opposite.op (V_cov T))).hom ((𝒦.obj.map (Opposite.op (π₁_cov T))).hom s))) =
              (ℱ.obj.map (Opposite.op (j₁ ≫ f₁))).hom
                ((g.hom.app (Opposite.op (V_cov T))).hom ((𝒦.obj.map (Opposite.op (π₁_cov T))).hom s)) :=
            congrArg (fun φ => (AddCommGrpCat.Hom.hom φ) _)
              (ℱ.obj.map_comp (Opposite.op f₁) (Opposite.op j₁)).symm
          have hm₂ : (ℱ.obj.map (Opposite.op j₁)).hom ((ℱ.obj.map (Opposite.op f₂)).hom
              ((g.hom.app (Opposite.op (V_cov T))).hom ((𝒦.obj.map (Opposite.op (π₁_cov T))).hom s))) =
              (ℱ.obj.map (Opposite.op (j₁ ≫ f₂))).hom
                ((g.hom.app (Opposite.op (V_cov T))).hom ((𝒦.obj.map (Opposite.op (π₁_cov T))).hom s)) :=
            congrArg (fun φ => (AddCommGrpCat.Hom.hom φ) _)
              (ℱ.obj.map_comp (Opposite.op f₂) (Opposite.op j₁)).symm
          exact hm₁.trans ((congrArg (fun k => (ℱ.obj.map (Opposite.op k)).hom _) hj1_eq).trans hm₂.symm)
        · change (ℱ.obj.map (Opposite.op j₂)).hom ((ℱ.obj.map (Opposite.op f₁)).hom _) =
            (ℱ.obj.map (Opposite.op j₂)).hom ((ℱ.obj.map (Opposite.op f₂)).hom _)
          have hm₁ : (ℱ.obj.map (Opposite.op j₂)).hom ((ℱ.obj.map (Opposite.op f₁)).hom
              ((g.hom.app (Opposite.op (V_cov T))).hom ((𝒦.obj.map (Opposite.op (π₁_cov T))).hom s))) =
              (ℱ.obj.map (Opposite.op (j₂ ≫ f₁))).hom
                ((g.hom.app (Opposite.op (V_cov T))).hom ((𝒦.obj.map (Opposite.op (π₁_cov T))).hom s)) :=
            congrArg (fun φ => (AddCommGrpCat.Hom.hom φ) _)
              (ℱ.obj.map_comp (Opposite.op f₁) (Opposite.op j₂)).symm
          have hm₂ : (ℱ.obj.map (Opposite.op j₂)).hom ((ℱ.obj.map (Opposite.op f₂)).hom
              ((g.hom.app (Opposite.op (V_cov T))).hom ((𝒦.obj.map (Opposite.op (π₁_cov T))).hom s))) =
              (ℱ.obj.map (Opposite.op (j₂ ≫ f₂))).hom
                ((g.hom.app (Opposite.op (V_cov T))).hom ((𝒦.obj.map (Opposite.op (π₁_cov T))).hom s)) :=
            congrArg (fun φ => (AddCommGrpCat.Hom.hom φ) _)
              (ℱ.obj.map_comp (Opposite.op f₂) (Opposite.op j₂)).symm
          exact hm₁.trans ((hVanishPull g T s (j₂ ≫ f₁) hY₂_range).trans
            ((hVanishPull g T s (j₂ ≫ f₂) hY₂_range).symm.trans hm₂.symm))
      · have hY_range : Set.range Y.hom.base ⊆ (U_c : Set ↥S) := by
          rintro _ ⟨y, rfl⟩
          have hy_eq : Y.hom.base y = T.hom.base ((O_cov T).ι.base (f₂.left.base y)) :=
            (congrArg (fun k : Y.left ⟶ S => k.base y) (hOverW f₂).symm).trans
              ((AlgebraicGeometry.Scheme.Hom.comp_apply f₂.left ((O_cov T).ι ≫ T.hom) y).trans
                (AlgebraicGeometry.Scheme.Hom.comp_apply (O_cov T).ι T.hom (f₂.left.base y)))
          rw [hy_eq]
          exact (f₂.left.base y : ↥(O_cov T)).2
        change (ℱ.obj.map (Opposite.op f₁)).hom _ = (ℱ.obj.map (Opposite.op f₂)).hom 0
        exact (hVanishPull g T s f₁ hY_range).trans (ℱ.obj.map (Opposite.op f₂)).hom.map_zero.symm
      · have hY_range : Set.range Y.hom.base ⊆ (U_c : Set ↥S) := by
          rintro _ ⟨y, rfl⟩
          have hy_eq : Y.hom.base y = T.hom.base ((O_cov T).ι.base (f₁.left.base y)) :=
            (congrArg (fun k : Y.left ⟶ S => k.base y) (hOverW f₁).symm).trans
              ((AlgebraicGeometry.Scheme.Hom.comp_apply f₁.left ((O_cov T).ι ≫ T.hom) y).trans
                (AlgebraicGeometry.Scheme.Hom.comp_apply (O_cov T).ι T.hom (f₁.left.base y)))
          rw [hy_eq]
          exact (f₁.left.base y : ↥(O_cov T)).2
        change (ℱ.obj.map (Opposite.op f₁)).hom 0 = (ℱ.obj.map (Opposite.op f₂)).hom _
        exact (ℱ.obj.map (Opposite.op f₁)).hom.map_zero.trans (hVanishPull g T s f₂ hY_range).symm
      · change (ℱ.obj.map (Opposite.op f₁)).hom 0 = (ℱ.obj.map (Opposite.op f₂)).hom 0
        exact (ℱ.obj.map (Opposite.op f₁)).hom.map_zero.trans
          (ℱ.obj.map (Opposite.op f₂)).hom.map_zero.symm
    have hGlueEx : ∀ (g : Quiver.Hom (h_res.obj 𝒦) (h_res.obj ℱ))
        (T : S.Etale) (s : ↥(𝒦.obj.obj (Opposite.op T))),
        ∃! t : ↥(ℱ.obj.obj (Opposite.op T)),
          ∀ b : Bool, (ℱ.obj.map (Opposite.op (covHom T b))).hom t = secFam g T s b := by
      intro g T s
      have hShFor := (CategoryTheory.Presieve.isSheafFor_iff_generate
        (CategoryTheory.Presieve.ofArrows (covObj T) (covHom T))).mpr
        (hℱ_typeSheaf _ (hCovSieve T))
      exact (CategoryTheory.Presieve.isSheafFor_arrows_iff
        (ℱ.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u}) (covHom T)).mp
        hShFor (secFam g T s) (hCompatCov g T s)
    let glueFun (g : Quiver.Hom (h_res.obj 𝒦) (h_res.obj ℱ))
        (T : S.Etale) (s : ↥(𝒦.obj.obj (Opposite.op T))) : ↥(ℱ.obj.obj (Opposite.op T)) :=
      Classical.choose (hGlueEx g T s)
    have hGlueSpec : ∀ (g : Quiver.Hom (h_res.obj 𝒦) (h_res.obj ℱ))
        (T : S.Etale) (s : ↥(𝒦.obj.obj (Opposite.op T))) (b : Bool),
        (ℱ.obj.map (Opposite.op (covHom T b))).hom (glueFun g T s) = secFam g T s b :=
      fun g T s => (Classical.choose_spec (hGlueEx g T s)).1
    have hGlueUniq : ∀ (g : Quiver.Hom (h_res.obj 𝒦) (h_res.obj ℱ))
        (T : S.Etale) (s : ↥(𝒦.obj.obj (Opposite.op T))) (t : ↥(ℱ.obj.obj (Opposite.op T))),
        (∀ b : Bool, (ℱ.obj.map (Opposite.op (covHom T b))).hom t = secFam g T s b) →
        t = glueFun g T s :=
      fun g T s t ht => (Classical.choose_spec (hGlueEx g T s)).2 t ht
    have hGlueZero : ∀ (g : Quiver.Hom (h_res.obj 𝒦) (h_res.obj ℱ)) (T : S.Etale),
        glueFun g T 0 = 0 := by
      intro g T
      symm
      apply hGlueUniq g T 0 0
      intro b
      cases b
      · exact (ℱ.obj.map (Opposite.op (covHom T false))).hom.map_zero.trans
          ((congrArg (g.hom.app (Opposite.op (V_cov T))).hom
            (𝒦.obj.map (Opposite.op (π₁_cov T))).hom.map_zero).trans
            (g.hom.app (Opposite.op (V_cov T))).hom.map_zero).symm
      · exact (ℱ.obj.map (Opposite.op (covHom T true))).hom.map_zero
    have hGlueAdd : ∀ (g : Quiver.Hom (h_res.obj 𝒦) (h_res.obj ℱ))
        (T : S.Etale) (s₁ s₂ : ↥(𝒦.obj.obj (Opposite.op T))),
        glueFun g T (s₁ + s₂) = glueFun g T s₁ + glueFun g T s₂ := by
      intro g T s₁ s₂
      symm
      apply hGlueUniq g T (s₁ + s₂) (glueFun g T s₁ + glueFun g T s₂)
      intro b
      cases b
      · refine ((ℱ.obj.map (Opposite.op (covHom T false))).hom.map_add _ _).trans ?_
        refine (congrArg₂ (· + ·) (hGlueSpec g T s₁ false) (hGlueSpec g T s₂ false)).trans ?_
        dsimp only [secFam]
        exact ((g.hom.app (Opposite.op (V_cov T))).hom.map_add _ _).symm.trans
          (congrArg (g.hom.app (Opposite.op (V_cov T))).hom
            ((𝒦.obj.map (Opposite.op (π₁_cov T))).hom.map_add s₁ s₂).symm)
      · refine ((ℱ.obj.map (Opposite.op (covHom T true))).hom.map_add _ _).trans ?_
        refine (congrArg₂ (· + ·) (hGlueSpec g T s₁ true) (hGlueSpec g T s₂ true)).trans ?_
        exact add_zero 0
    have hGlueNat : ∀ (g : Quiver.Hom (h_res.obj 𝒦) (h_res.obj ℱ))
        {T' T : S.Etale} (u : T' ⟶ T) (s : ↥(𝒦.obj.obj (Opposite.op T))),
        (ℱ.obj.map (Opposite.op u)).hom (glueFun g T s) =
          glueFun g T' ((𝒦.obj.map (Opposite.op u)).hom s) := by
      intro g T' T u s
      apply hGlueUniq g T' ((𝒦.obj.map (Opposite.op u)).hom s)
      intro b
      cases b
      · let m_u : CategoryTheory.Limits.pullback T'.hom h ⟶ CategoryTheory.Limits.pullback T.hom h :=
          CategoryTheory.Limits.pullback.lift
            (CategoryTheory.Limits.pullback.fst T'.hom h ≫ u.left)
