    exact hAbstractDimShift U_Y (i_push_mod.obj One_Z) (i_push_ab.obj Fℤ_Z) ζ_Z hBase0
      (fun m ℐ _ e => hVanishInj m (i_push_ab.obj Fℤ_Z) hMonoXab ℐ e)

  
  
  
  let π_ring : ∀ r : ℕ,
      ULift.{u, 0} (ZMod (ℓ ^ (r + 1))) →+* ULift.{u, 0} (ZMod (ℓ ^ r)) :=
    fun r =>
      ULift.ringEquiv.symm.toRingHom.comp
        ((ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r))).comp
          ULift.ringEquiv.toRingHom)

  have hResIsRightAdj : ∀ r : ℕ,
      (ModuleCat.restrictScalars.{u, u, u} (π_ring r)).IsRightAdjoint :=
    fun r => (ModuleCat.extendRestrictScalarsAdj.{u, u, u} (π_ring r)).isRightAdjoint

  have hCoextRingIsRightAdj : ∀ r : ℕ,
      (ModuleCat.coextendScalars.{u, u, u} (π_ring r)).IsRightAdjoint :=
    fun r => (ModuleCat.restrictCoextendScalarsAdj.{u, u, u} (π_ring r)).isRightAdjoint

  let ρ_functor : ∀ (S : AlgebraicGeometry.Scheme.{u}) (r : ℕ),
      letI := hResIsRightAdj r
      CategoryTheory.Sheaf S.smallEtaleTopology
        (ModuleCat.{u, u} (ULift.{u, 0} (ZMod (ℓ ^ r)))) ⥤
      CategoryTheory.Sheaf S.smallEtaleTopology
        (ModuleCat.{u, u} (ULift.{u, 0} (ZMod (ℓ ^ (r + 1))))) :=
    fun S r =>
      letI := hResIsRightAdj r
      CategoryTheory.sheafCompose S.smallEtaleTopology
        (ModuleCat.restrictScalars.{u, u, u} (π_ring r))

  have hρExact : ∀ (S : AlgebraicGeometry.Scheme.{u}) (r : ℕ),
      (ρ_functor S r).Additive ∧
      CategoryTheory.Limits.PreservesFiniteLimits (ρ_functor S r) ∧
      CategoryTheory.Limits.PreservesFiniteColimits (ρ_functor S r) := by
    intro S r
    letI := hResIsRightAdj r
    letI := hCoextRingIsRightAdj r
    let ρ_S := ρ_functor S r
    let adj_ρ : ρ_S ⊣ CategoryTheory.sheafCompose S.smallEtaleTopology
        (ModuleCat.coextendScalars.{u, u, u} (π_ring r)) :=
      sheafComposeAdj S.smallEtaleTopology
        (ModuleCat.restrictCoextendScalarsAdj.{u, u, u} (π_ring r))
    refine ⟨hSheafComposeAdditive (ModuleCat.restrictScalars.{u, u, u} (π_ring r)), ?_, ?_⟩
    · obtain ⟨L_ρ, ⟨adj_Lρ⟩⟩ := (inferInstance : ρ_S.IsRightAdjoint).exists_leftAdjoint
      have _ := adj_Lρ.rightAdjoint_preservesLimits.{0, 0}
      exact CategoryTheory.Limits.PreservesLimitsOfSize.preservesFiniteLimits ρ_S
    · have _ := adj_ρ.leftAdjoint_preservesColimits.{0, 0}
      exact CategoryTheory.Limits.PreservesColimitsOfSize.preservesFiniteColimits ρ_S

  let π_mod : ∀ r : ℕ,
      ModuleCat.of (ULift.{u, 0} (ZMod (ℓ ^ (r + 1))))
        (ULift.{u, 0} (ZMod (ℓ ^ (r + 1)))) ⟶
      (ModuleCat.restrictScalars.{u, u, u} (π_ring r)).obj
        (ModuleCat.of (ULift.{u, 0} (ZMod (ℓ ^ r))) (ULift.{u, 0} (ZMod (ℓ ^ r)))) :=
    fun r =>
      let R₁ := ULift.{u, 0} (ZMod (ℓ ^ (r + 1)))
      let R₀ := ULift.{u, 0} (ZMod (ℓ ^ r))
      let M₀_res := (ModuleCat.restrictScalars.{u, u, u} (π_ring r)).obj (ModuleCat.of R₀ R₀)
      ModuleCat.ofHom (Y := M₀_res)
        { toFun := fun x : R₁ => (show M₀_res from π_ring r x)
          map_add' := fun x y =>
            ((π_ring r).map_add x y : π_ring r (x + y) = π_ring r x + π_ring r y)
          map_smul' := fun a x => by
            change π_ring r (a * x) = π_ring r a * π_ring r x
            exact (π_ring r).map_mul a x }

  let c_const : ∀ (S : AlgebraicGeometry.Scheme.{u}) (r : ℕ),
      let R₁ := ULift.{u, 0} (ZMod (ℓ ^ (r + 1)))
      let R₀ := ULift.{u, 0} (ZMod (ℓ ^ r))
      let J_S := S.smallEtaleTopology
      ((CategoryTheory.constantSheaf J_S (ModuleCat.{u, u} R₁)).obj (ModuleCat.of R₁ R₁)) ⟶
        (ρ_functor S r).obj
          ((CategoryTheory.constantSheaf J_S (ModuleCat.{u, u} R₀)).obj (ModuleCat.of R₀ R₀)) :=
    fun S r =>
      let R₁ := ULift.{u, 0} (ZMod (ℓ ^ (r + 1)))
      let R₀ := ULift.{u, 0} (ZMod (ℓ ^ r))
      let J_S := S.smallEtaleTopology
      let hT_S := weilEtaleIdTerminalIsTerminal.{u} S
      let adj_S1 := CategoryTheory.constantSheafAdj J_S (ModuleCat.{u, u} R₁) hT_S
      let adj_S0 := CategoryTheory.constantSheafAdj J_S (ModuleCat.{u, u} R₀) hT_S
      let One_S0 := (CategoryTheory.constantSheaf J_S (ModuleCat.{u, u} R₀)).obj
        (ModuleCat.of R₀ R₀)
      (adj_S1.homEquiv (ModuleCat.of R₁ R₁) ((ρ_functor S r).obj One_S0)).symm
        (π_mod r ≫ (ModuleCat.restrictScalars.{u, u, u} (π_ring r)).map
          (adj_S0.unit.app (ModuleCat.of R₀ R₀)))

  
  have hConstRedComm : ∀ (r : ℕ) {S₁ S₂ : AlgebraicGeometry.Scheme.{u}}
      (B : S₂.Etale ⥤ S₁.Etale)
      [B.IsContinuous S₂.smallEtaleTopology S₁.smallEtaleTopology],
      let R₁ := ULift.{u, 0} (ZMod (ℓ ^ (r + 1)))
      let R₀ := ULift.{u, 0} (ZMod (ℓ ^ r))
      let R₁_mod := ModuleCat.of R₁ R₁
      let R₀_mod := ModuleCat.of R₀ R₀
      let T₂ := weilEtaleIdTerminal.{u} S₂
      let hT₂ := weilEtaleIdTerminalIsTerminal.{u} S₂
      let hT₁ := weilEtaleIdTerminalIsTerminal.{u} S₁
      let push_1 := B.sheafPushforwardContinuous (ModuleCat.{u, u} R₁)
        S₂.smallEtaleTopology S₁.smallEtaleTopology
      let push_0 := B.sheafPushforwardContinuous (ModuleCat.{u, u} R₀)
        S₂.smallEtaleTopology S₁.smallEtaleTopology
      let One₁_1 := (CategoryTheory.constantSheaf S₁.smallEtaleTopology
        (ModuleCat.{u, u} R₁)).obj R₁_mod
      let One₁_0 := (CategoryTheory.constantSheaf S₁.smallEtaleTopology
        (ModuleCat.{u, u} R₀)).obj R₀_mod
      let adj₂_1 := CategoryTheory.constantSheafAdj S₂.smallEtaleTopology
        (ModuleCat.{u, u} R₁) hT₂
      let adj₁_1 := CategoryTheory.constantSheafAdj S₁.smallEtaleTopology
        (ModuleCat.{u, u} R₁) hT₁
      let adj₂_0 := CategoryTheory.constantSheafAdj S₂.smallEtaleTopology
        (ModuleCat.{u, u} R₀) hT₂
      let adj₁_0 := CategoryTheory.constantSheafAdj S₁.smallEtaleTopology
        (ModuleCat.{u, u} R₀) hT₁
      let q₁ := (adj₂_1.homEquiv R₁_mod (push_1.obj One₁_1)).symm
        (adj₁_1.unit.app R₁_mod ≫ One₁_1.obj.map (hT₁.from (B.obj T₂)).op)
      let q₀ := (adj₂_0.homEquiv R₀_mod (push_0.obj One₁_0)).symm
        (adj₁_0.unit.app R₀_mod ≫ One₁_0.obj.map (hT₁.from (B.obj T₂)).op)
      q₁ ≫ push_1.map (c_const S₁ r) = c_const S₂ r ≫ (ρ_functor S₂ r).map q₀ := by
    intro r S₁ S₂ B _ R₁ R₀ R₁_mod R₀_mod T₂ hT₂ hT₁ push_1 push_0 One₁_1 One₁_0
      adj₂_1 adj₁_1 adj₂_0 adj₁_0 q₁ q₀
    let _ := hResIsRightAdj r
    let W_cod : CategoryTheory.Sheaf S₂.smallEtaleTopology (ModuleCat.{u, u} R₁) :=
      push_1.obj ((ρ_functor S₁ r).obj One₁_0)
    let HomT :=
      R₁_mod ⟶
        (ModuleCat.restrictScalars.{u, u, u} (π_ring r)).obj
          (One₁_0.obj.obj (Opposite.op (B.obj T₂)))
    apply (adj₂_1.homEquiv R₁_mod W_cod).injective
    have hLHS : (adj₂_1.homEquiv R₁_mod W_cod (q₁ ≫ push_1.map (c_const S₁ r)) : HomT) =
        ((adj₁_1.unit.app R₁_mod ≫ One₁_1.obj.map (hT₁.from (B.obj T₂)).op) ≫
          (c_const S₁ r).hom.app (Opposite.op (B.obj T₂)) : HomT) :=
      (adj₂_1.homEquiv_naturality_right q₁ (push_1.map (c_const S₁ r))).trans
        (congrArg (· ≫ _) (Equiv.apply_symm_apply _ _))
    have hRHS : (adj₂_1.homEquiv R₁_mod W_cod
          (c_const S₂ r ≫ (ρ_functor S₂ r).map q₀) : HomT) =
        ((π_mod r ≫
          (ModuleCat.restrictScalars.{u, u, u} (π_ring r)).map (adj₂_0.unit.app R₀_mod)) ≫
          (ModuleCat.restrictScalars.{u, u, u} (π_ring r)).map
            (q₀.hom.app (Opposite.op T₂)) : HomT) := by
      have h1 := adj₂_1.homEquiv_naturality_right (c_const S₂ r) ((ρ_functor S₂ r).map q₀)
      have h2 : adj₂_1.homEquiv R₁_mod ((ρ_functor S₂ r).obj _) (c_const S₂ r) =
          π_mod r ≫
            (ModuleCat.restrictScalars.{u, u, u} (π_ring r)).map (adj₂_0.unit.app R₀_mod) :=
        Equiv.apply_symm_apply _ _
      exact h1.trans (congrArg (· ≫ _) h2)
    refine hLHS.trans (Eq.trans ?_ hRHS.symm)
    have hc₁_unit : adj₁_1.unit.app R₁_mod ≫
        (c_const S₁ r).hom.app (Opposite.op (weilEtaleIdTerminal.{u} S₁)) =
        π_mod r ≫
          (ModuleCat.restrictScalars.{u, u, u} (π_ring r)).map (adj₁_0.unit.app R₀_mod) :=
      (CategoryTheory.Adjunction.homEquiv_unit adj₁_1 R₁_mod _ (c_const S₁ r)).symm.trans
        (Equiv.apply_symm_apply _ _)
    have hq₀_unit : (adj₂_0.unit.app R₀_mod ≫ q₀.hom.app (Opposite.op T₂) :
        R₀_mod ⟶ One₁_0.obj.obj (Opposite.op (B.obj T₂))) =
        adj₁_0.unit.app R₀_mod ≫ One₁_0.obj.map (hT₁.from (B.obj T₂)).op :=
      (CategoryTheory.Adjunction.homEquiv_unit adj₂_0 R₀_mod (push_0.obj One₁_0) q₀).symm.trans
        (Equiv.apply_symm_apply _ _)
    have hnat_c := (c_const S₁ r).hom.naturality (hT₁.from (B.obj T₂)).op
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    have h1 := congrArg (fun k => k.hom ((adj₁_1.unit.app R₁_mod).hom x)) hnat_c
    have h2 := congrArg
      (fun k => (One₁_0.obj.map (hT₁.from (B.obj T₂)).op).hom (k.hom x)) hc₁_unit
    have h3 := congrArg (fun k => k.hom (π_ring r x)) hq₀_unit.symm
    exact h1.trans (h2.trans h3)

  
  have hAlignForgetsTo : ∀ {Z Y : AlgebraicGeometry.Scheme.{u}} {i : Quiver.Hom Z Y}
      {m q : ℕ} (τ : WeilGysinSupportClass Z Y i m q)
      (cl : weilEtaleTorsionH Y m q),
      WeilGysinForgetsTo τ cl →
      letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) i :=
        CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
      letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
          (@AlgebraicGeometry.Etale) i :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
          (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
      let R := ULift.{u, 0} (ZMod m)
      let R_mod := ModuleCat.of R R
      let J_Y := Y.smallEtaleTopology
      let J_Z := Z.smallEtaleTopology
      let B_i : CategoryTheory.Functor Y.Etale Z.Etale :=
        CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ i
      letI := τ.hCont
      let i_push := B_i.sheafPushforwardContinuous (ModuleCat.{u, u} R) J_Y J_Z
      let One_Y := (CategoryTheory.constantSheaf J_Y (ModuleCat.{u, u} R)).obj R_mod
      let One_Z := (CategoryTheory.constantSheaf J_Z (ModuleCat.{u, u} R)).obj R_mod
      let F_fg := CategoryTheory.forget₂ (ModuleCat.{u, u} R) AddCommGrpCat.{u}
      letI : F_fg.IsRightAdjoint := hForgetIsRightAdj R
      let U₀ := CategoryTheory.sheafCompose J_Y F_fg
      letI : U₀.Additive := hSheafComposeAdditive F_fg
      letI : CategoryTheory.Limits.PreservesFiniteLimits U₀ := by
        obtain ⟨L_U, ⟨adj_LU⟩⟩ := (inferInstance : U₀.IsRightAdjoint).exists_leftAdjoint
        have _ := adj_LU.rightAdjoint_preservesLimits.{0, 0}
        exact CategoryTheory.Limits.PreservesLimitsOfSize.preservesFiniteLimits U₀
      letI : CategoryTheory.Limits.PreservesFiniteColimits U₀ := by
        letI : (coextModFunctor R).IsRightAdjoint := hCoextIsRightAdj R
        let adj_UC : U₀ ⊣ CategoryTheory.sheafCompose J_Y (coextModFunctor R) :=
          sheafComposeAdj J_Y (forgetCoextAdj R)
        have _ := adj_UC.leftAdjoint_preservesColimits.{0, 0}
        exact CategoryTheory.Limits.PreservesColimitsOfSize.preservesFiniteColimits U₀
      let T₀_Y := weilEtaleIdTerminal.{u} Y
      let hT₀_Y := weilEtaleIdTerminalIsTerminal.{u} Y
      let T₀_Z := weilEtaleIdTerminal.{u} Z
      let hT₀_Z := weilEtaleIdTerminalIsTerminal.{u} Z
      let adj_ab₀ := CategoryTheory.constantSheafAdj J_Y AddCommGrpCat.{u} hT₀_Y
      let adj_Y₀ := CategoryTheory.constantSheafAdj J_Y (ModuleCat.{u, u} R) hT₀_Y
      let adj_Z₀ := CategoryTheory.constantSheafAdj J_Z (ModuleCat.{u, u} R) hT₀_Z
      let q_i₀ : One_Y ⟶ i_push.obj One_Z :=
        (adj_Y₀.homEquiv R_mod (i_push.obj One_Z)).symm
          (adj_Z₀.unit.app R_mod ≫ One_Z.obj.map (hT₀_Z.from (B_i.obj T₀_Y)).op)
      let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
      let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
      let C_ab := CategoryTheory.constantSheaf J_Y AddCommGrpCat.{u}
      let Fℤ := C_ab.obj Aℤ
      let FM := C_ab.obj AM
      let ιM : AM ⟶ F_fg.obj R_mod := AddCommGrpCat.ofHom (AddMonoidHom.id R)
      let z_to_m : Aℤ ⟶ AM := AddCommGrpCat.ofHom
        { toFun := fun z => ULift.up ((z.down : ℤ) : ZMod m)
          map_zero' := congrArg ULift.up Int.cast_zero
          map_add' := fun x y => congrArg ULift.up (Int.cast_add x.down y.down) }
      let αM₀ : FM ⟶ U₀.obj One_Y :=
        (adj_ab₀.homEquiv AM (U₀.obj One_Y)).symm
          (ιM ≫ F_fg.map (adj_Y₀.unit.app R_mod))
      let ιℤ₀ : Fℤ ⟶ U₀.obj One_Y := C_ab.map z_to_m ≫ αM₀
      ∀ (πM₀ : U₀.obj One_Y ⟶ FM),
        αM₀ ≫ πM₀ = 𝟙 FM →
        cl = (CategoryTheory.Abelian.Ext.mk₀ πM₀).postcomp Fℤ (Nat.add_zero q)
          ((CategoryTheory.Abelian.Ext.mk₀ ιℤ₀).comp
            ((U₀.mapExtAddHom One_Y One_Y q)
              ((CategoryTheory.Abelian.Ext.mk₀ q_i₀).comp τ.val (Nat.zero_add q)))
            (Nat.zero_add q)) := by
    intro Z Y i m q τ cl hfg R R_mod J_Y J_Z B_i i_push One_Y One_Z
      F_fg U₀ T₀_Y hT₀_Y T₀_Z hT₀_Z adj_ab₀ adj_Y₀ adj_Z₀ q_i₀
      Aℤ AM C_ab Fℤ FM ιM z_to_m αM₀ ιℤ₀ πM₀ hαπ₀
    letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) i :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
        (@AlgebraicGeometry.Etale) i :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    letI := τ.hCont
    letI : F_fg.IsRightAdjoint := hForgetIsRightAdj R
    letI : U₀.Additive := hSheafComposeAdditive F_fg
    let _ : CategoryTheory.Limits.PreservesFiniteLimits U₀ := by
      obtain ⟨L_U, ⟨adj_LU⟩⟩ := (inferInstance : U₀.IsRightAdjoint).exists_leftAdjoint
      have _ := adj_LU.rightAdjoint_preservesLimits.{0, 0}
