    rcases hfg with ⟨U, hU_obj, hU_map, hAdd, hLim, hColim,
      T_Y, hT_Y, T_Z, hT_Z, u_unit, hu_unit, πM, hπ1, hπ2, hcl⟩
    letI := hAdd; letI := hLim; letI := hColim
    let adj_ab := CategoryTheory.constantSheafAdj J_Y AddCommGrpCat.{u} hT_Y
    let adj_Y := CategoryTheory.constantSheafAdj J_Y (ModuleCat.{u, u} R) hT_Y
    let adj_Z := CategoryTheory.constantSheafAdj J_Z (ModuleCat.{u, u} R) hT_Z
    
    have hEqToHomConj : ∀ {𝒞 : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} 𝒞]
        {A₁ A₂ B₁ B₂ : 𝒞} (f : A₁ ⟶ A₂) (g : B₁ ⟶ B₂) (h₁ : A₁ = B₁) (h₂ : A₂ = B₂),
        HEq f g → f ≫ CategoryTheory.eqToHom h₂ = CategoryTheory.eqToHom h₁ ≫ g := by
      intro 𝒞 _ A₁ A₂ B₁ B₂ f g h₁ h₂ hfg
      subst h₁; subst h₂; cases hfg
      rw [CategoryTheory.eqToHom_refl, CategoryTheory.eqToHom_refl,
        CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
    have hEqToHomComp : ∀ {𝒞 : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} 𝒞]
        {A B₁ B₂ : 𝒞} (f : A ⟶ B₁) (g : A ⟶ B₂) (h : B₁ = B₂),
        HEq f g → f ≫ CategoryTheory.eqToHom h = g := by
      intro 𝒞 _ A B₁ B₂ f g h hfg
      subst h; cases hfg
      exact CategoryTheory.Category.comp_id f
    have hEqToHomApp : ∀ {𝒞 𝒟 : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} 𝒞]
        [CategoryTheory.Category.{u, u + 1} 𝒟] {F G : 𝒞 ⥤ 𝒟} (h : F = G) (X : 𝒞),
        (CategoryTheory.eqToHom h).app X =
          CategoryTheory.eqToHom (congrArg (fun P => P.obj X) h) :=
      fun h _ => by subst h; rfl
    let σ : U ≅ U₀ :=
      CategoryTheory.NatIso.ofComponents
        (fun ℱ =>
          let hp : (U.obj ℱ).obj = (U₀.obj ℱ).obj := hU_obj ℱ
          { hom := CategoryTheory.ObjectProperty.homMk (CategoryTheory.eqToHom hp)
            inv := CategoryTheory.ObjectProperty.homMk (CategoryTheory.eqToHom hp.symm)
            hom_inv_id := CategoryTheory.Sheaf.hom_ext
              ((CategoryTheory.eqToHom_trans hp hp.symm).trans
                (CategoryTheory.eqToHom_refl (U.obj ℱ).obj _))
            inv_hom_id := CategoryTheory.Sheaf.hom_ext
              ((CategoryTheory.eqToHom_trans hp.symm hp).trans
                (CategoryTheory.eqToHom_refl (U₀.obj ℱ).obj _)) })
        (fun {ℱ₁ ℱ₂} u => by
          apply CategoryTheory.Sheaf.hom_ext
          apply CategoryTheory.NatTrans.ext
          funext V
          let hp₁ : (U.obj ℱ₁).obj = (U₀.obj ℱ₁).obj := hU_obj ℱ₁
          let hp₂ : (U.obj ℱ₂).obj = (U₀.obj ℱ₂).obj := hU_obj ℱ₂
          have h1 := hEqToHomApp hp₁ V
          have h2 := hEqToHomApp hp₂ V
          change (U.map u).hom.app V ≫ (CategoryTheory.eqToHom hp₂).app V =
            (CategoryTheory.eqToHom hp₁).app V ≫ F_fg.map (u.hom.app V)
          rw [h1, h2]
          exact hEqToHomConj _ _ _ _ (hU_map u V))
    
    have hAlignQGen : ∀ (B : Y.Etale ⥤ Z.Etale) [B.IsContinuous J_Y J_Z],
        let push := B.sheafPushforwardContinuous (ModuleCat.{u, u} R) J_Y J_Z
        (adj_Y.homEquiv R_mod (push.obj One_Z)).symm
          (adj_Z.unit.app R_mod ≫ One_Z.obj.map (hT_Z.from (B.obj T_Y)).op) =
        (adj_Y₀.homEquiv R_mod (push.obj One_Z)).symm
          (adj_Z₀.unit.app R_mod ≫ One_Z.obj.map (hT₀_Z.from (B.obj T₀_Y)).op) := by
      intro B _ push
