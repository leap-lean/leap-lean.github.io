            ((M_g ⋙ B_i).obj V') (B_i'.obj V') (u_inv V')
            (CategoryTheory.Limits.pullback.lift_snd _ _ _) trivial
          hom_inv_id := CategoryTheory.MorphismProperty.Over.Hom.ext
            (CategoryTheory.Limits.pullback.hom_ext
              ((CategoryTheory.Category.assoc (u_hom V') (u_inv V') _).trans
                ((congrArg (u_hom V' ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                  ((CategoryTheory.Limits.pullback.lift_fst _ _ _).trans
                    (CategoryTheory.Category.id_comp _).symm)))
              ((CategoryTheory.Category.assoc (u_hom V') (u_inv V') _).trans
                ((congrArg (u_hom V' ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
                  ((CategoryTheory.Limits.pullback.lift_snd _ _ _).trans
                    (CategoryTheory.Category.id_comp _).symm))))
          inv_hom_id := CategoryTheory.MorphismProperty.Over.Hom.ext
            (CategoryTheory.Limits.pullback.hom_ext
              ((CategoryTheory.Category.assoc (u_inv V') (u_hom V') _).trans
                ((congrArg (u_inv V' ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                  ((CategoryTheory.Limits.pullback.lift_fst _ _ _).trans
                    (CategoryTheory.Category.id_comp _).symm)))
              ((CategoryTheory.Category.assoc (u_inv V') (u_hom V') _).trans
                ((congrArg (u_inv V' ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
                  ((CategoryTheory.Limits.pullback.lift_snd _ _ _).trans
                    (CategoryTheory.Category.id_comp _).symm)))) })
      (fun {V'₁ V'₂} f => CategoryTheory.MorphismProperty.Over.Hom.ext
        (CategoryTheory.Limits.pullback.hom_ext
          (((CategoryTheory.Category.assoc _ (u_hom V'₂) _).trans
            ((congrArg (_ ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
              (CategoryTheory.Limits.pullback.lift_fst _ _ _))).trans
            (((CategoryTheory.Category.assoc (u_hom V'₁) _ _).trans
              ((congrArg (u_hom V'₁ ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                ((CategoryTheory.Category.assoc (u_hom V'₁) _ _).symm.trans
                  (congrArg (· ≫ f.left) (CategoryTheory.Limits.pullback.lift_fst _ _ _))))).symm))
          (((CategoryTheory.Category.assoc _ (u_hom V'₂) _).trans
            ((congrArg (_ ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
              (CategoryTheory.Limits.pullback.lift_snd _ _ _))).trans
            (((CategoryTheory.Category.assoc (u_hom V'₁) _ _).trans
              ((congrArg (u_hom V'₁ ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
