    have hFirst : ι_A ≫ π_A = 𝟙 (C_Y'.obj A) := by
      apply (adj_Y'.homEquiv A (C_Y'.obj A)).injective
      have hq_nat : F_Y.map μ.op ≫ q_A.hom.app (Opposite.op (M_g.obj T_Y')) =
          q_A.hom.app (Opposite.op T_Y) ≫ F_Y'.map (B_g.map μ).op :=
        q_A.hom.naturality μ.op
      have hTail : F_Y'.map τ.op ≫
          (F_Y'.map (B_g.map μ).op ≫ F_Y'.map (adj_MB.unit.app T_Y').op) =
          𝟙 (F_Y'.obj (Opposite.op T_Y')) :=
        (CategoryTheory.Category.assoc _ _ _).symm.trans
          (((congrArg (· ≫ F_Y'.map (adj_MB.unit.app T_Y').op)
              ((F_Y'.map_comp τ.op (B_g.map μ).op).symm.trans
                (congrArg F_Y'.map (op_comp (f := B_g.map μ) (g := τ)).symm))).trans
            ((F_Y'.map_comp (B_g.map μ ≫ τ).op (adj_MB.unit.app T_Y').op).symm.trans
              (congrArg F_Y'.map
                (op_comp (f := adj_MB.unit.app T_Y') (g := B_g.map μ ≫ τ)).symm))).trans
            ((congrArg (fun k => F_Y'.map k.op) (hT_Y'.hom_ext _ (𝟙 T_Y'))).trans
              (F_Y'.map_id (Opposite.op T_Y'))))
      have hLHS : adj_Y'.homEquiv A (C_Y'.obj A) (ι_A ≫ π_A) = adj_Y'.unit.app A :=
        (CategoryTheory.Adjunction.homEquiv_unit adj_Y' A (C_Y'.obj A) (ι_A ≫ π_A)).trans
          ((CategoryTheory.Category.assoc _ _ _).symm.trans
            ((congrArg₂ CategoryTheory.CategoryStruct.comp hι_eq hπ_app).trans
              ((CategoryTheory.Category.assoc _ _ _).trans
                ((congrArg (adj_Y.unit.app A ≫ ·)
                    ((CategoryTheory.Category.assoc _ _ _).symm.trans
                      ((congrArg (· ≫ F_Y'.map (adj_MB.unit.app T_Y').op) hq_nat).trans
                        (CategoryTheory.Category.assoc _ _ _)))).trans
                  ((CategoryTheory.Category.assoc _ _ _).symm.trans
                    ((congrArg (· ≫ (F_Y'.map (B_g.map μ).op ≫ F_Y'.map (adj_MB.unit.app T_Y').op))
                        hq_eq).trans
                      ((CategoryTheory.Category.assoc _ _ _).trans
                        ((congrArg (adj_Y'.unit.app A ≫ ·) hTail).trans
                          (CategoryTheory.Category.comp_id _)))))))))
      have hRHS : adj_Y'.homEquiv A (C_Y'.obj A) (𝟙 (C_Y'.obj A)) = adj_Y'.unit.app A :=
        (CategoryTheory.Adjunction.homEquiv_unit adj_Y' A (C_Y'.obj A) (𝟙 _)).trans
          (CategoryTheory.Category.comp_id _)
      exact hLHS.trans hRHS.symm
    have hSecond : π_A ≫ ι_A = 𝟙 (g_res.obj (C_Y.obj A)) := by
      let G₀ := g_res.obj (C_Y.obj A)
      apply (adj_rp.homEquiv (C_Y.obj A) G₀).injective
      apply (adj_Y.homEquiv A (g_push.obj G₀)).injective
      have hrp_lhs : adj_rp.homEquiv (C_Y.obj A) G₀ (π_A ≫ ι_A) = q_A ≫ g_push.map ι_A :=
        (adj_rp.homEquiv_naturality_right π_A ι_A).trans
          (congrArg (· ≫ g_push.map ι_A)
            ((adj_rp.homEquiv (C_Y.obj A) (C_Y'.obj A)).apply_symm_apply q_A))
      have hι_nat : F_Y'.map τ.op ≫ ι_A.hom.app (Opposite.op (B_g.obj T_Y)) =
          ι_A.hom.app (Opposite.op T_Y') ≫ F_Y.map (M_g.map τ).op :=
        ι_A.hom.naturality τ.op
      have hLHS : adj_Y.homEquiv A (g_push.obj G₀)
          (adj_rp.homEquiv (C_Y.obj A) G₀ (π_A ≫ ι_A)) =
          adj_Y.unit.app A ≫ F_Y.map (adj_MB.counit.app T_Y).op :=
        (congrArg (adj_Y.homEquiv A (g_push.obj G₀)) hrp_lhs).trans
          ((adj_Y.homEquiv_naturality_right q_A (g_push.map ι_A)).trans
            ((congrArg (· ≫ ι_A.hom.app (Opposite.op (B_g.obj T_Y)))
                ((adj_Y.homEquiv A (g_push.obj (C_Y'.obj A))).apply_symm_apply
                  (adj_Y'.unit.app A ≫ F_Y'.map τ.op))).trans
              ((CategoryTheory.Category.assoc _ _ _).trans
                ((congrArg (adj_Y'.unit.app A ≫ ·) hι_nat).trans
                  ((CategoryTheory.Category.assoc _ _ _).symm.trans
                    ((congrArg (· ≫ F_Y.map (M_g.map τ).op) hι_eq).trans
                      ((CategoryTheory.Category.assoc _ _ _).trans
                        (congrArg (adj_Y.unit.app A ≫ ·)
                          ((F_Y.map_comp μ.op (M_g.map τ).op).symm.trans
                            ((congrArg F_Y.map (op_comp (f := M_g.map τ) (g := μ)).symm).trans
                              (congrArg (fun k => F_Y.map k.op)
                                (hT_Y.hom_ext (M_g.map τ ≫ μ) (adj_MB.counit.app T_Y)))))))))))))
      have hrp_rhs : adj_rp.homEquiv (C_Y.obj A) G₀ (𝟙 G₀) = adj_rp.unit.app (C_Y.obj A) :=
        (CategoryTheory.Adjunction.homEquiv_unit adj_rp (C_Y.obj A) G₀ (𝟙 G₀)).trans
          ((congrArg (adj_rp.unit.app (C_Y.obj A) ≫ ·) (g_push.map_id G₀)).trans
            (CategoryTheory.Category.comp_id _))
      have hRHS : adj_Y.homEquiv A (g_push.obj G₀)
          (adj_rp.homEquiv (C_Y.obj A) G₀ (𝟙 G₀)) =
          adj_Y.unit.app A ≫ F_Y.map (adj_MB.counit.app T_Y).op :=
        (congrArg (adj_Y.homEquiv A (g_push.obj G₀)) hrp_rhs).trans
          (CategoryTheory.Adjunction.homEquiv_unit adj_Y A (g_push.obj G₀)
            (adj_rp.unit.app (C_Y.obj A)))
      exact hLHS.trans hRHS.symm
    exact ⟨hFirst, hSecond⟩
  have hSitePaste : ∀ {Z Y' Y : AlgebraicGeometry.Scheme.{u}}
      (g : Quiver.Hom Y' Y) (hg : AlgebraicGeometry.Etale g)
      (i' : Quiver.Hom Z Y') (i : Quiver.Hom Z Y),
      CategoryTheory.CategoryStruct.comp i' g = i →
      CategoryTheory.IsPullback i' (CategoryTheory.CategoryStruct.id Z) g i →
      Nonempty (CategoryTheory.Iso (weilEtaleSitePullback i')
        (CategoryTheory.Functor.comp (weilEtalePostcomp g hg) (weilEtaleSitePullback i))) := by
    intro Z Y' Y g hg i' i hig hpb
    let B_i' := weilEtaleSitePullback i'
    let B_i := weilEtaleSitePullback i
    let M_g := weilEtalePostcomp g hg
    have h_fwd : ∀ V' : Y'.Etale,
        CategoryTheory.Limits.pullback.fst V'.hom i' ≫ (V'.hom ≫ g) =
          CategoryTheory.Limits.pullback.snd V'.hom i' ≫ i := by
      intro V'
      rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
        CategoryTheory.Category.assoc, hig]
    have h_bwd : ∀ V' : Y'.Etale,
        CategoryTheory.Limits.pullback.fst (V'.hom ≫ g) i ≫ V'.hom =
          CategoryTheory.Limits.pullback.snd (V'.hom ≫ g) i ≫ i' := by
      intro V'
      let p₁ := CategoryTheory.Limits.pullback.fst (V'.hom ≫ g) i
      let p₂ := CategoryTheory.Limits.pullback.snd (V'.hom ≫ g) i
      let zl := hpb.lift (p₁ ≫ V'.hom) p₂
        (by rw [CategoryTheory.Category.assoc]; exact CategoryTheory.Limits.pullback.condition)
      have hzl : zl = p₂ := (CategoryTheory.Category.comp_id zl).symm.trans (hpb.lift_snd _ _ _)
      exact (hpb.lift_fst _ _ _).symm.trans (congrArg (· ≫ i') hzl)
    let u_hom (V' : Y'.Etale) : (B_i'.obj V').left ⟶ (B_i.obj (M_g.obj V')).left :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst V'.hom i')
        (CategoryTheory.Limits.pullback.snd V'.hom i') (h_fwd V')
    let u_inv (V' : Y'.Etale) : (B_i.obj (M_g.obj V')).left ⟶ (B_i'.obj V').left :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst (V'.hom ≫ g) i)
        (CategoryTheory.Limits.pullback.snd (V'.hom ≫ g) i) (h_bwd V')
    exact ⟨@CategoryTheory.NatIso.ofComponents Y'.Etale _ Z.Etale _ B_i' (M_g ⋙ B_i)
      (fun V' =>
        { hom := @CategoryTheory.MorphismProperty.Over.homMk _ _ (@AlgebraicGeometry.Etale) ⊤ Z _
            (B_i'.obj V') ((M_g ⋙ B_i).obj V') (u_hom V')
            (CategoryTheory.Limits.pullback.lift_snd _ _ _) trivial
