  let u_tilde_i : Quiver.Hom S_Ω U := τ_i ≫ CategoryTheory.Limits.pullback.fst u_P g_x
  let u_tilde_j : Quiver.Hom S_Ω U := τ_j ≫ CategoryTheory.Limits.pullback.fst u_P g_x
