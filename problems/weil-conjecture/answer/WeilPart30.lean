        map_smul' := fun _ _ => Subtype.ext (LocallyConstant.ext fun _ => rfl) }
    let KPre : ∀ (S : AlgebraicGeometry.Scheme.{u}) (V₀ : S.Opens),
        (S.Etale)ᵒᵖ ⥤ ModuleCat.{u, u} R := fun S V₀ =>
      { obj := fun W => ModuleCat.of R ↥(KSub S V₀ (Opposite.unop W))
        map := fun f => ModuleCat.ofHom (KRes f.unop)
        map_id := fun _ => by
          apply ModuleCat.hom_ext
          apply LinearMap.ext
          intro φ
          rfl
        map_comp := fun _ _ => by
          apply ModuleCat.hom_ext
          apply LinearMap.ext
          intro φ
          rfl }
    have hKIsSheaf : ∀ (S : AlgebraicGeometry.Scheme.{u}) (V₀ : S.Opens),
        CategoryTheory.Presheaf.IsSheaf S.smallEtaleTopology (KPre S V₀) := by
      intro S V₀
      refine hSheafModOfType (KPre S V₀) ?_
      intro W S_cov hS_cov
      have hcov_pts := (hMemSmallEtale W S_cov).mp hS_cov
      intro fam hcompat
      let valAt : ↥W.left → R := fun x =>
        let f_x := (hcov_pts x).choose_spec.choose
        let y_x := (hcov_pts x).choose_spec.choose_spec.choose
        let hf_x := (hcov_pts x).choose_spec.choose_spec.choose_spec.1
        (fam f_x hf_x).1 y_x
      have hagree : ∀ {Y' : S.Etale} (f' : Y' ⟶ W) (hf' : S_cov.arrows f') (y' : ↥Y'.left),
          (fam f' hf').1 y' = valAt (f'.left.base y') := by
        intro Y' f' hf' y'
        set x := f'.left.base y'
        set Y_x := (hcov_pts x).choose
        set f_x := (hcov_pts x).choose_spec.choose
        set y_x := (hcov_pts x).choose_spec.choose_spec.choose
        have hf_x := (hcov_pts x).choose_spec.choose_spec.choose_spec.1
        have het_x := (hcov_pts x).choose_spec.choose_spec.choose_spec.2.1
        have hy_x := (hcov_pts x).choose_spec.choose_spec.choose_spec.2.2
        haveI : AlgebraicGeometry.Etale f_x.left := het_x
        haveI : AlgebraicGeometry.Etale Y'.hom := Y'.prop
        let π₁ := CategoryTheory.Limits.pullback.fst f_x.left f'.left
        let π₂ := CategoryTheory.Limits.pullback.snd f_x.left f'.left
        haveI : AlgebraicGeometry.Etale π₂ := inferInstance
        let Z_pb : S.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (π₂ ≫ Y'.hom) inferInstance
        let p₁ : Z_pb ⟶ Y_x := CategoryTheory.MorphismProperty.Over.homMk π₁ (by
          change π₁ ≫ Y_x.hom = π₂ ≫ Y'.hom
          rw [← CategoryTheory.MorphismProperty.Over.w f_x,
            ← CategoryTheory.MorphismProperty.Over.w f',
            ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
            CategoryTheory.Limits.pullback.condition])
        let p₂ : Z_pb ⟶ Y' := CategoryTheory.MorphismProperty.Over.homMk π₂ rfl
        have hp_comm : p₁ ≫ f_x = p₂ ≫ f' := by
          apply CategoryTheory.MorphismProperty.Over.Hom.ext
          exact CategoryTheory.Limits.pullback.condition
        obtain ⟨z, hz₁, hz₂⟩ :=
          AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y_x y' hy_x
        have hcomp_eq := hcompat p₁ p₂ hf_x hf' hp_comm
        have hval_z : ((KPre S V₀ ⋙ CategoryTheory.forget _).map p₁.op (fam f_x hf_x)).1 z =
            ((KPre S V₀ ⋙ CategoryTheory.forget _).map p₂.op (fam f' hf')).1 z :=
          congrArg (fun u => u.1 z) hcomp_eq
        change (fam f_x hf_x).1 (π₁.base z) = (fam f' hf').1 (π₂.base z) at hval_z
        rw [hz₁, hz₂] at hval_z
        exact hval_z.symm
      have hLC : IsLocallyConstant valAt := by
        rw [IsLocallyConstant.iff_isOpen_fiber]
        intro r
        have h_union : valAt ⁻¹' {r} =
            ⋃ (Y' : S.Etale) (f' : Y' ⟶ W) (hf' : S_cov.arrows f')
              (_ : AlgebraicGeometry.Etale f'.left),
              f'.left.base '' ((fam f' hf').1 ⁻¹' {r}) := by
          ext x
          simp only [Set.mem_preimage, Set.mem_singleton_iff, Set.mem_iUnion, Set.mem_image]
          constructor
          · intro hxr
            refine ⟨(hcov_pts x).choose, (hcov_pts x).choose_spec.choose,
              (hcov_pts x).choose_spec.choose_spec.choose_spec.1,
              (hcov_pts x).choose_spec.choose_spec.choose_spec.2.1,
              (hcov_pts x).choose_spec.choose_spec.choose, hxr,
              (hcov_pts x).choose_spec.choose_spec.choose_spec.2.2⟩
          · rintro ⟨Y', f', hf', _, y', hy'r, rfl⟩
            rw [← hagree f' hf' y']
            exact hy'r
        rw [h_union]
        refine isOpen_iUnion fun Y' => isOpen_iUnion fun f' =>
          isOpen_iUnion fun hf' => isOpen_iUnion fun het' => ?_
        haveI : AlgebraicGeometry.Etale f'.left := het'
        haveI : AlgebraicGeometry.UniversallyOpen f'.left :=
          AlgebraicGeometry.UniversallyOpen.of_flat f'.left
        exact AlgebraicGeometry.Scheme.Hom.isOpenMap f'.left _
          ((fam f' hf').1.isLocallyConstant.isOpen_fiber r)
      have hSupp : ∀ x : ↥W.left, W.hom.base x ∉ (V₀ : Set ↥S) → valAt x = 0 := by
        intro x hx
        set Y_x := (hcov_pts x).choose
        set f_x := (hcov_pts x).choose_spec.choose
        set y_x := (hcov_pts x).choose_spec.choose_spec.choose
        have hf_x := (hcov_pts x).choose_spec.choose_spec.choose_spec.1
        have hy_x := (hcov_pts x).choose_spec.choose_spec.choose_spec.2.2
        refine (fam f_x hf_x).2 y_x (fun hmem => hx ?_)
        have hw : (f_x.left ≫ W.hom).base y_x = Y_x.hom.base y_x :=
          congrArg (fun k : Y_x.left ⟶ S => k.base y_x)
            (CategoryTheory.MorphismProperty.Over.w f_x)
        rw [← hy_x]
        exact hw.symm ▸ hmem
      let glued : (KPre S V₀ ⋙ CategoryTheory.forget _).obj (Opposite.op W) :=
        ⟨⟨valAt, hLC⟩, hSupp⟩
      refine ⟨glued, ?_, ?_⟩
      · intro Y' f' hf'
        apply Subtype.ext
        apply LocallyConstant.ext
        intro y'
        exact (hagree f' hf' y').symm
      · intro other hother
        apply Subtype.ext
        apply LocallyConstant.ext
        intro x
        set f_x := (hcov_pts x).choose_spec.choose
        set y_x := (hcov_pts x).choose_spec.choose_spec.choose
        have hf_x := (hcov_pts x).choose_spec.choose_spec.choose_spec.1
        have hy_x := (hcov_pts x).choose_spec.choose_spec.choose_spec.2.2
        have h_app := congrArg (fun u => u.1 y_x) (hother f_x hf_x)
        change other.1 (f_x.left.base y_x) = (fam f_x hf_x).1 y_x at h_app
        rw [hy_x] at h_app
        exact h_app
    let KSh : ∀ (S : AlgebraicGeometry.Scheme.{u}) (V₀ : S.Opens),
        CategoryTheory.Sheaf S.smallEtaleTopology (ModuleCat.{u, u} R) := fun S V₀ =>
      ⟨KPre S V₀, hKIsSheaf S V₀⟩

    
    have hConstIso : ∀ (S : AlgebraicGeometry.Scheme.{u}),
        let One_S := (CategoryTheory.constantSheaf S.smallEtaleTopology (ModuleCat.{u, u} R)).obj R_mod
        let adj_S := CategoryTheory.constantSheafAdj S.smallEtaleTopology (ModuleCat.{u, u} R) (hIsTerm S)
        let c_TS : R_mod ⟶ (KSh S ⊤).obj.obj (Opposite.op (mkTerm S)) :=
          ModuleCat.ofHom
            { toFun := fun r => ⟨LocallyConstant.const ↥(mkTerm S).left r, fun _ hx => (hx trivial).elim⟩
              map_add' := fun _ _ => Subtype.ext (LocallyConstant.ext fun _ => rfl)
              map_smul' := fun _ _ => Subtype.ext (LocallyConstant.ext fun _ => rfl) }
        CategoryTheory.IsIso ((adj_S.homEquiv R_mod (KSh S ⊤)).symm c_TS) := by
      intro S One_S adj_S c_TS
      set ϕ_S : One_S ⟶ KSh S ⊤ := (adj_S.homEquiv R_mod (KSh S ⊤)).symm c_TS
      let constSec : ∀ (W : S.Etale), R_mod ⟶ One_S.obj.obj (Opposite.op W) := fun W =>
        adj_S.unit.app R_mod ≫ One_S.obj.map ((hIsTerm S).from W).op
      have hϕ_const : ∀ (W : S.Etale) (r : R),
          (ϕ_S.hom.app (Opposite.op W)).hom ((constSec W).hom r) =
            ⟨LocallyConstant.const ↥W.left r, fun _ hx => (hx trivial).elim⟩ := by
        intro W r
        have hTS : adj_S.unit.app R_mod ≫ ϕ_S.hom.app (Opposite.op (mkTerm S)) = c_TS :=
          (CategoryTheory.Adjunction.homEquiv_unit adj_S R_mod (KSh S ⊤) ϕ_S).symm.trans
            (Equiv.apply_symm_apply _ _)
        have hW : constSec W ≫ ϕ_S.hom.app (Opposite.op W) =
            c_TS ≫ (KSh S ⊤).obj.map ((hIsTerm S).from W).op := by
          dsimp only [constSec]
          rw [CategoryTheory.Category.assoc, ϕ_S.hom.naturality ((hIsTerm S).from W).op,
            ← CategoryTheory.Category.assoc, hTS]
        exact ConcreteCategory.congr_hom hW r
      
      haveI hEpi_ϕ : CategoryTheory.Epi ϕ_S := by
        refine ⟨fun {ℋ} g₁ g₂ hg => ?_⟩
        apply CategoryTheory.Sheaf.hom_ext
        ext opW φ
        let W : S.Etale := Opposite.unop opW
        let O_x : ↥W.left → W.left.Opens := fun x =>
          ⟨φ.1 ⁻¹' {φ.1 x}, φ.1.isLocallyConstant.isOpen_fiber (φ.1 x)⟩
        let W_x : ↥W.left → S.Etale := fun x =>
          CategoryTheory.MorphismProperty.Over.mk ⊤ ((O_x x).ι ≫ W.hom)
            (by have : AlgebraicGeometry.Etale W.hom := W.prop; infer_instance)
        let u_x : ∀ x : ↥W.left, W_x x ⟶ W := fun x =>
          CategoryTheory.MorphismProperty.Over.homMk (O_x x).ι rfl
        have hcov : CategoryTheory.Sieve.ofArrows W_x u_x ∈ S.smallEtaleTopology W :=
          hOpenArrowsCover W O_x (fun x => ⟨x, rfl⟩)
        let spanHom : ↥(ℋ.obj.obj (Opposite.op W)) → (R_mod ⟶ ℋ.obj.obj (Opposite.op W)) :=
          fun v => ModuleCat.ofHom (LinearMap.toSpanSingleton R _ v)
        suffices hspan : spanHom ((g₁.hom.app (Opposite.op W)).hom φ) =
            spanHom ((g₂.hom.app (Opposite.op W)).hom φ) by
          have h1 : (1 : R) • (g₁.hom.app (Opposite.op W)).hom φ =
              (1 : R) • (g₂.hom.app (Opposite.op W)).hom φ :=
            LinearMap.congr_fun (congrArg ModuleCat.Hom.hom hspan) (1 : R)
          simpa only [one_smul] using h1
        refine CategoryTheory.Presheaf.IsSheaf.hom_ext_ofArrows ℋ.property u_x hcov fun x => ?_
        apply ModuleCat.hom_ext
        apply LinearMap.ext
        intro r
        have h_res : ((KSh S ⊤).obj.map (u_x x).op).hom φ =
            (ϕ_S.hom.app (Opposite.op (W_x x))).hom ((constSec (W_x x)).hom (φ.1 x)) := by
          rw [hϕ_const]
          apply Subtype.ext
          apply LocallyConstant.ext
          intro y
          exact y.2
        have hg_app : ∀ k : KSh S ⊤ ⟶ ℋ,
            (ℋ.obj.map (u_x x).op).hom ((k.hom.app (Opposite.op W)).hom φ) =
              ((ϕ_S ≫ k).hom.app (Opposite.op (W_x x))).hom ((constSec (W_x x)).hom (φ.1 x)) := by
          intro k
          have hnat : (ℋ.obj.map (u_x x).op).hom ((k.hom.app (Opposite.op W)).hom φ) =
              (k.hom.app (Opposite.op (W_x x))).hom (((KSh S ⊤).obj.map (u_x x).op).hom φ) :=
            (ConcreteCategory.congr_hom (k.hom.naturality (u_x x).op) φ).symm
          exact hnat.trans (congrArg (k.hom.app (Opposite.op (W_x x))).hom h_res)
        change (ℋ.obj.map (u_x x).op).hom (r • (g₁.hom.app (Opposite.op W)).hom φ) =
          (ℋ.obj.map (u_x x).op).hom (r • (g₂.hom.app (Opposite.op W)).hom φ)
        rw [map_smul, map_smul, hg_app g₁, hg_app g₂, hg]
      
      let fibO : ∀ (W : S.Etale) (φ : ↥(KSub S ⊤ W)), R → W.left.Opens :=
        fun _ φ r => ⟨φ.1 ⁻¹' {r}, φ.1.isLocallyConstant.isOpen_fiber r⟩
      let fibW : ∀ (W : S.Etale) (φ : ↥(KSub S ⊤ W)), R → S.Etale :=
        fun W φ r => CategoryTheory.MorphismProperty.Over.mk ⊤ ((fibO W φ r).ι ≫ W.hom)
          (by have : AlgebraicGeometry.Etale W.hom := W.prop; infer_instance)
      let fibU : ∀ (W : S.Etale) (φ : ↥(KSub S ⊤ W)) (r : R), fibW W φ r ⟶ W :=
        fun W φ r => CategoryTheory.MorphismProperty.Over.homMk (fibO W φ r).ι rfl
      have fibCov : ∀ (W : S.Etale) (φ : ↥(KSub S ⊤ W)),
          CategoryTheory.Sieve.ofArrows (fibW W φ) (fibU W φ) ∈ S.smallEtaleTopology W :=
        fun W φ => hOpenArrowsCover W (fibO W φ) (fun x => ⟨φ.1 x, rfl⟩)
      let fibLoc : ∀ (W : S.Etale) (φ : ↥(KSub S ⊤ W)) (r : R),
          R_mod ⟶ One_S.obj.obj (Opposite.op (fibW W φ r)) :=
        fun W φ r => ModuleCat.ofHom (LinearMap.toSpanSingleton R _ ((constSec (fibW W φ r)).hom r))
      have fibCompat : ∀ (W : S.Etale) (φ : ↥(KSub S ⊤ W))
          ⦃Z' : S.Etale⦄ ⦃r₁ r₂ : R⦄ (a : Z' ⟶ fibW W φ r₁) (b : Z' ⟶ fibW W φ r₂),
          a ≫ fibU W φ r₁ = b ≫ fibU W φ r₂ →
          fibLoc W φ r₁ ≫ One_S.obj.map a.op = fibLoc W φ r₂ ≫ One_S.obj.map b.op := by
        intro W φ Z' r₁ r₂ a b hab
        by_cases hr : r₁ = r₂
        · subst hr
          have hab_left : a.left ≫ (fibO W φ r₁).ι = b.left ≫ (fibO W φ r₁).ι :=
            congrArg (fun k => k.left) hab
          have ha_eq_b : a = b := by
            apply CategoryTheory.MorphismProperty.Over.Hom.ext
            exact (CategoryTheory.cancel_mono (fibO W φ r₁).ι).mp hab_left
          rw [ha_eq_b]
        · have hEmp : IsEmpty ↥Z'.left := ⟨fun z => by
            have hz_eq : (a.left ≫ (fibO W φ r₁).ι).base z = (b.left ≫ (fibO W φ r₂).ι).base z :=
              congrArg (fun k => k.left.base z) hab
            have h₁ : φ.1 ((fibO W φ r₁).ι.base (a.left.base z)) = r₁ := (a.left.base z).2
            have h₂ : φ.1 ((fibO W φ r₂).ι.base (b.left.base z)) = r₂ := (b.left.base z).2
            exact hr (h₁.symm.trans ((congrArg φ.1 hz_eq).trans h₂))⟩
          exact (CategoryTheory.Sheaf.isTerminalOfBotCover One_S Z'
            (hBotCover Z' hEmp)).hom_ext _ _
      let glueSec : ∀ (W : S.Etale) (φ : ↥(KSub S ⊤ W)), ↥(One_S.obj.obj (Opposite.op W)) :=
        fun W φ =>
          (One_S.property.amalgamateOfArrows (fibU W φ) (fibCov W φ)
            (fibLoc W φ) (fibCompat W φ)).hom (1 : R)
      have hglue_spec : ∀ (W : S.Etale) (φ : ↥(KSub S ⊤ W)) (r : R),
          (One_S.obj.map (fibU W φ r).op).hom (glueSec W φ) = (constSec (fibW W φ r)).hom r := by
        intro W φ r
        have hmap : (One_S.obj.map (fibU W φ r).op).hom (glueSec W φ) =
            (1 : R) • (constSec (fibW W φ r)).hom r :=
          LinearMap.congr_fun
            (congrArg ModuleCat.Hom.hom
              (One_S.property.amalgamateOfArrows_map (fibU W φ) (fibCov W φ)
                (fibLoc W φ) (fibCompat W φ) r)) (1 : R)
        exact hmap.trans (one_smul R _)
      have hconstSec_map : ∀ {W₁ W₂ : S.Etale} (f : W₁ ⟶ W₂) (r : R),
          (One_S.obj.map f.op).hom ((constSec W₂).hom r) = (constSec W₁).hom r := by
        intro W₁ W₂ f r
        have hhom : ((hIsTerm S).from W₂).op ≫ f.op = ((hIsTerm S).from W₁).op := by
          rw [← CategoryTheory.op_comp]
          exact congrArg Opposite.op ((hIsTerm S).hom_ext _ _)
        have hcomp : constSec W₂ ≫ One_S.obj.map f.op = constSec W₁ := by
          dsimp only [constSec]
          rw [CategoryTheory.Category.assoc, ← One_S.obj.map_comp, hhom]
        exact ConcreteCategory.congr_hom hcomp r
      have hglue_sub : ∀ (W : S.Etale) (φ : ↥(KSub S ⊤ W)) (O : W.left.Opens) (r : R)
          (hO : ∀ y : ↥O.toScheme, φ.1 (O.ι.base y) = r),
          let W_O : S.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (O.ι ≫ W.hom)
            (by have : AlgebraicGeometry.Etale W.hom := W.prop; infer_instance)
          let u_O : W_O ⟶ W := CategoryTheory.MorphismProperty.Over.homMk O.ι rfl
          (One_S.obj.map u_O.op).hom (glueSec W φ) = (constSec W_O).hom r := by
        intro W φ O r hO W_O u_O
        have hle : O ≤ fibO W φ r := fun x hx => hO ⟨x, hx⟩
        let ι_le : W_O ⟶ fibW W φ r := CategoryTheory.MorphismProperty.Over.homMk (W.left.homOfLE hle)
          (AlgebraicGeometry.Scheme.homOfLE_ι_assoc W.left hle W.hom)
        have hfac : ι_le ≫ fibU W φ r = u_O := by
          apply CategoryTheory.MorphismProperty.Over.Hom.ext
          exact AlgebraicGeometry.Scheme.homOfLE_ι W.left hle
        rw [← hfac, CategoryTheory.op_comp, One_S.obj.map_comp]
        change (One_S.obj.map ι_le.op).hom ((One_S.obj.map (fibU W φ r).op).hom (glueSec W φ)) = _
        rw [hglue_spec W φ r, hconstSec_map ι_le r]
      let ψ_S : KSh S ⊤ ⟶ One_S :=
        ⟨{ app := fun opW =>
             let W := Opposite.unop opW
             ModuleCat.ofHom
               { toFun := glueSec W
                 map_add' := fun φ₁ φ₂ => by
                   let O_p : R × R → W.left.Opens := fun p =>
                     ⟨φ₁.1 ⁻¹' {p.1} ∩ φ₂.1 ⁻¹' {p.2},
                       (φ₁.1.isLocallyConstant.isOpen_fiber p.1).inter
                         (φ₂.1.isLocallyConstant.isOpen_fiber p.2)⟩
                   let W_p : R × R → S.Etale := fun p =>
                     CategoryTheory.MorphismProperty.Over.mk ⊤ ((O_p p).ι ≫ W.hom)
                       (by have : AlgebraicGeometry.Etale W.hom := W.prop; infer_instance)
                   let u_p : ∀ p : R × R, W_p p ⟶ W := fun p =>
                     CategoryTheory.MorphismProperty.Over.homMk (O_p p).ι rfl
                   have hcov : CategoryTheory.Sieve.ofArrows W_p u_p ∈ S.smallEtaleTopology W :=
                     hOpenArrowsCover W O_p (fun x => ⟨(φ₁.1 x, φ₂.1 x), ⟨rfl, rfl⟩⟩)
                   let sp : ↥(One_S.obj.obj (Opposite.op W)) → (R_mod ⟶ One_S.obj.obj (Opposite.op W)) :=
                     fun v => ModuleCat.ofHom (LinearMap.toSpanSingleton R _ v)
                   suffices hsp : sp (glueSec W (φ₁ + φ₂)) = sp (glueSec W φ₁ + glueSec W φ₂) by
                     have h1 : (1 : R) • glueSec W (φ₁ + φ₂) =
                         (1 : R) • (glueSec W φ₁ + glueSec W φ₂) :=
                       LinearMap.congr_fun (congrArg ModuleCat.Hom.hom hsp) (1 : R)
                     simpa only [one_smul] using h1
                   refine CategoryTheory.Presheaf.IsSheaf.hom_ext_ofArrows One_S.property u_p hcov fun p => ?_
                   apply ModuleCat.hom_ext
                   apply LinearMap.ext
                   intro c
                   change (One_S.obj.map (u_p p).op).hom (c • glueSec W (φ₁ + φ₂)) =
                     (One_S.obj.map (u_p p).op).hom (c • (glueSec W φ₁ + glueSec W φ₂))
                   rw [map_smul, map_smul, map_add,
                     hglue_sub W (φ₁ + φ₂) (O_p p) (p.1 + p.2)
                       (fun y => congrArg₂ (· + ·) y.2.1 y.2.2),
                     hglue_sub W φ₁ (O_p p) p.1 (fun y => y.2.1),
                     hglue_sub W φ₂ (O_p p) p.2 (fun y => y.2.2), map_add]
                 map_smul' := fun c₀ φ => by
                   let sp : ↥(One_S.obj.obj (Opposite.op W)) → (R_mod ⟶ One_S.obj.obj (Opposite.op W)) :=
                     fun v => ModuleCat.ofHom (LinearMap.toSpanSingleton R _ v)
                   suffices hsp : sp (glueSec W (c₀ • φ)) = sp (c₀ • glueSec W φ) by
                     have h1 : (1 : R) • glueSec W (c₀ • φ) = (1 : R) • (c₀ • glueSec W φ) :=
                       LinearMap.congr_fun (congrArg ModuleCat.Hom.hom hsp) (1 : R)
                     change glueSec W (c₀ • φ) = c₀ • glueSec W φ
                     simpa only [one_smul] using h1
                   refine CategoryTheory.Presheaf.IsSheaf.hom_ext_ofArrows One_S.property
                     (fibU W φ) (fibCov W φ) fun r => ?_
                   apply ModuleCat.hom_ext
                   apply LinearMap.ext
                   intro c₁
                   change (One_S.obj.map (fibU W φ r).op).hom (c₁ • glueSec W (c₀ • φ)) =
                     (One_S.obj.map (fibU W φ r).op).hom (c₁ • (c₀ • glueSec W φ))
                   rw [map_smul, map_smul, map_smul,
                     hglue_sub W (c₀ • φ) (fibO W φ r) (c₀ * r)
                       (fun y => by
                         have hy : φ.1 ((fibO W φ r).ι.base y) = r := y.2
                         change c₀ • φ.1 ((fibO W φ r).ι.base y) = c₀ * r
                         rw [hy, smul_eq_mul]),
                     hglue_spec W φ r, ← smul_eq_mul, map_smul] }
           naturality := fun {opW₂ opW₁} f_op => by
             let W₁ := Opposite.unop opW₁
             let W₂ := Opposite.unop opW₂
