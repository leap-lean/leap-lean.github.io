theorem weil_gysin_finite_clopen_support_decomposition (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hContAll : ∀ (Z Y : AlgebraicGeometry.Scheme.{u}) (i : Quiver.Hom Z Y),
      letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) i :=
        CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
      letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
          (@AlgebraicGeometry.Etale) i :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
          (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
      let B : CategoryTheory.Functor Y.Etale Z.Etale :=
        CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ i
      B.IsContinuous Y.smallEtaleTopology Z.smallEtaleTopology) :
    ∀ (S₀ W X_sch : AlgebraicGeometry.Scheme.{u})
      (i_W : Quiver.Hom W X_sch),
      AlgebraicGeometry.IsClosedImmersion i_W →
      ∀ [Fintype ↥W] [DiscreteTopology ↥W]
        (s'_W : ∀ _ : ↥W, Quiver.Hom S₀ W),
        (∀ w : ↥W,
          AlgebraicGeometry.IsOpenImmersion (s'_W w) ∧
          Set.range (s'_W w).base = {w} ∧
          AlgebraicGeometry.IsClosedImmersion
            (CategoryTheory.CategoryStruct.comp (s'_W w) i_W)) →
        ∀ (r q : ℕ)
          (τ_W : WeilGysinSupportClass W X_sch i_W (ℓ ^ r) q)
          (cl_tot : weilEtaleTorsionH X_sch (ℓ ^ r) q),
          WeilGysinForgetsTo τ_W cl_tot →
          ∃ (τ_pt : ∀ w : ↥W,
              WeilGysinSupportClass S₀ X_sch
                (CategoryTheory.CategoryStruct.comp (s'_W w) i_W) (ℓ ^ r) q)
            (cl_pt : ∀ _ : ↥W, weilEtaleTorsionH X_sch (ℓ ^ r) q),
            (∀ w : ↥W, WeilGysinForgetsTo (τ_pt w) (cl_pt w)) ∧
            cl_tot = ∑ w : ↥W, cl_pt w ∧
            ∀ (w : ↥W) (U_w : X_sch.Opens) (s_Uw : Quiver.Hom S₀ U_w.toScheme)
              (τ_Uw : WeilGysinSupportClass S₀ U_w.toScheme s_Uw (ℓ ^ r) q),
              (U_w : Set X_sch) ∩ Set.range i_W.base = {i_W.base w} →
              CategoryTheory.CategoryStruct.comp s_Uw U_w.ι =
                CategoryTheory.CategoryStruct.comp (s'_W w) i_W →
              WeilGysinSupportPullback U_w.ι s_Uw i_W (ℓ ^ r) q τ_Uw τ_W →
              WeilGysinSupportPullback U_w.ι s_Uw
                (CategoryTheory.CategoryStruct.comp (s'_W w) i_W) (ℓ ^ r) q τ_Uw (τ_pt w) :=
by
  intro S₀ W X_sch i_W hi_W hFinW hDiscW s'_W hs'_W r q τ_W cl_tot hFg_tot
  letI : Fintype ↥W := hFinW
  letI : DiscreteTopology ↥W := hDiscW
  haveI : AlgebraicGeometry.IsClosedImmersion i_W := hi_W
  classical
  let m := ℓ ^ r
  let R := ULift.{u, 0} (ZMod m)
  let R_mod := ModuleCat.of R R
  
  have hConstUnitMap : ∀ {S : AlgebraicGeometry.Scheme.{u}}
      {𝒜 : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} 𝒜]
      [CategoryTheory.HasWeakSheafify S.smallEtaleTopology 𝒜]
      {T₁ T₂ : S.Etale} (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
      (hT₂ : CategoryTheory.Limits.IsTerminal T₂) (φ : T₂ ⟶ T₁) (X : 𝒜),
      (CategoryTheory.constantSheafAdj S.smallEtaleTopology 𝒜 hT₁).unit.app X ≫
        (((CategoryTheory.constantSheaf S.smallEtaleTopology 𝒜).obj X).obj.map φ.op) =
      (CategoryTheory.constantSheafAdj S.smallEtaleTopology 𝒜 hT₂).unit.app X := by
    intro S 𝒜 _ _ T₁ T₂ hT₁ hT₂ φ X
    let J := S.smallEtaleTopology
    let P_X := (CategoryTheory.Functor.const S.Etaleᵒᵖ).obj X
    let η_X := (CategoryTheory.sheafificationAdjunction J 𝒜).unit.app P_X
    have h_nat := η_X.naturality φ.op
    dsimp [P_X] at h_nat
    rw [CategoryTheory.Category.id_comp] at h_nat
    have h_u₁ : (CategoryTheory.constantSheafAdj J 𝒜 hT₁).unit.app X = η_X.app (Opposite.op T₁) := by
      dsimp only [CategoryTheory.constantSheafAdj]
      rw [CategoryTheory.Adjunction.comp_unit_app,
        CategoryTheory.constantPresheafAdj_unit_app, CategoryTheory.Category.id_comp]
      rfl
    have h_u₂ : (CategoryTheory.constantSheafAdj J 𝒜 hT₂).unit.app X = η_X.app (Opposite.op T₂) := by
      dsimp only [CategoryTheory.constantSheafAdj]
      rw [CategoryTheory.Adjunction.comp_unit_app,
        CategoryTheory.constantPresheafAdj_unit_app, CategoryTheory.Category.id_comp]
      rfl
    rw [h_u₁, h_u₂]
    exact h_nat.symm
  have hEmptyTerm : ∀ {S : AlgebraicGeometry.Scheme.{u}}
      (ℱ : CategoryTheory.Sheaf S.smallEtaleTopology (ModuleCat.{u, u} R))
      (V : S.Etale), IsEmpty ↥V.left →
      CategoryTheory.Limits.IsTerminal (ℱ.val.obj (Opposite.op V)) := by
    intro S ℱ V hEmp
    letI : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    let S_bot : CategoryTheory.Sieve V := ⊥
    have hEq := AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) S le_rfl
    have hBot : S_bot ∈ S.smallEtaleTopology V := by
      refine Eq.mp (congrArg (fun J => S_bot ∈ J V) hEq.symm) ?_
      refine (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) (S := S) V S_bot).mpr ?_
      intro x
      exact (hEmp.false x).elim
    exact CategoryTheory.Sheaf.isTerminalOfBotCover ℱ V hBot
  
  let openEtaleMap : ∀ {U S : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom U S)
      [AlgebraicGeometry.IsOpenImmersion f], U.Etale ⥤ S.Etale :=
    fun {U S} f _ =>
      letI : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
        CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
      { obj := fun V =>
          letI : AlgebraicGeometry.Etale V.hom := V.prop
          CategoryTheory.MorphismProperty.Over.mk ⊤ (V.hom ≫ f) inferInstance
        map := fun g =>
          CategoryTheory.MorphismProperty.Over.homMk g.left
            ((CategoryTheory.Category.assoc g.left _ f).symm.trans
              (congrArg (· ≫ f) (CategoryTheory.MorphismProperty.Over.w g)))
        map_id := fun _ => CategoryTheory.MorphismProperty.Over.Hom.ext rfl
        map_comp := fun _ _ => CategoryTheory.MorphismProperty.Over.Hom.ext rfl }
  let openEtaleSiteAdj : ∀ {U S : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom U S)
      [AlgebraicGeometry.IsOpenImmersion f],
      openEtaleMap f ⊣ weilEtaleSitePullback f :=
    fun {U S} f _ =>
      let B_f : S.Etale ⥤ U.Etale := weilEtaleSitePullback f
      CategoryTheory.Adjunction.mkOfHomEquiv
        { homEquiv := fun V W₀ =>
            { toFun := fun u =>
                CategoryTheory.MorphismProperty.Over.homMk
                  (CategoryTheory.Limits.pullback.lift u.left V.hom
                    (CategoryTheory.MorphismProperty.Over.w u))
                  (CategoryTheory.Limits.pullback.lift_snd _ _ _)
              invFun := fun v =>
                CategoryTheory.MorphismProperty.Over.homMk
                  (v.left ≫ CategoryTheory.Limits.pullback.fst W₀.hom f)
                  ((CategoryTheory.Category.assoc v.left _ W₀.hom).trans
                    ((congrArg (v.left ≫ ·) CategoryTheory.Limits.pullback.condition).trans
                      ((CategoryTheory.Category.assoc v.left _ f).symm.trans
                        (congrArg (· ≫ f) (CategoryTheory.MorphismProperty.Over.w v)))))
              left_inv := fun u => by
                apply CategoryTheory.MorphismProperty.Over.Hom.ext
                exact CategoryTheory.Limits.pullback.lift_fst _ _ _
              right_inv := fun v => by
                apply CategoryTheory.MorphismProperty.Over.Hom.ext
                apply CategoryTheory.Limits.pullback.hom_ext
                · exact CategoryTheory.Limits.pullback.lift_fst _ _ _
                · exact (CategoryTheory.Limits.pullback.lift_snd _ _ _).trans
                    (CategoryTheory.MorphismProperty.Over.w v).symm }
          homEquiv_naturality_left_symm := fun {V' V W₀} h v => by
            apply CategoryTheory.MorphismProperty.Over.Hom.ext
            exact (CategoryTheory.Category.assoc h.left v.left _).symm
          homEquiv_naturality_right := fun {V W₀ W₀'} u k => by
            apply CategoryTheory.MorphismProperty.Over.Hom.ext
            apply CategoryTheory.Limits.pullback.hom_ext
            · exact (CategoryTheory.Limits.pullback.lift_fst _ _ _).trans
                (((CategoryTheory.Category.assoc _ (B_f.map k).left _).trans
                  ((congrArg (CategoryTheory.Limits.pullback.lift u.left V.hom _ ≫ ·)
                    (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
