          (congrArg (· ≫ Θ_BC.inv.app _)
            ((CategoryTheory.Category.assoc q_si'₀ α'₀ _).symm.trans
              ((congrArg (· ≫ i'_push.map β_s) hq'₀).trans
                ((CategoryTheory.Category.assoc q_i'₀ _ _).trans
