        ((CategoryTheory.Category.assoc _ _ _).symm.trans
          ((congrArg (· ≫ CategoryTheory.Limits.pullback.fst Z.hom (g₀ ≫ s₀)) h_cg_id).trans
            (CategoryTheory.Category.id_comp _)))
    have hinv_gs :=
      CategoryTheory.MorphismProperty.Over.pullbackComp_inv_app_left g₀ s₀ (g₀ ≫ s₀) rfl Z
    have h_gs_fst :
        (e_gs.inv.app Z).left ≫ CategoryTheory.Limits.pullback.fst Z.hom (g₀ ≫ s₀) =
