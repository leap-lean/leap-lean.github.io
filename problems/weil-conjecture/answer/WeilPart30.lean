      hj_et hu_tilde_et p_Y_r z_Γ_r z_P_r hp_Y_r hz_Γ_r hz_P_r
    exact (congrArg (weilEtaleTorsionTransition P_c.left ℓ r (2 * (m + 1))) hEY_succ_eq).trans
      ((hTransCounit P_c.left U_P r (2 * (m + 1)) z_P_succ).trans hEY_r_eq.symm)
  
  
  
  · intro W hW hNe s s_W u hu_et hu_comm hs hChart r cl_Y cl_Pc hcl_Y hcl_Pc
    let u_tilde : W.toScheme ⟶ P_c.left := u ≫ ι_aff (m + 1)
    have hu_tilde_et : Etale u_tilde := by have := hu_et; infer_instance
    have hg : W.ι ≫ Y.hom = u_tilde ≫ P_c.hom := by rw [Category.assoc, hι_comm, hu_comm]
    let γ_u : W.toScheme ⟶ Limits.pullback Y.hom P_c.hom := Limits.pullback.lift W.ι u_tilde hg
    let Γ := γ_u.image
    let j_Γ := γ_u.toImage
    let π_Y := γ_u.imageι ≫ Limits.pullback.fst Y.hom P_c.hom
    let π_P := γ_u.imageι ≫ Limits.pullback.snd Y.hom P_c.hom
    obtain ⟨_, hPropΓ, hπ_comm, hj_Y, hj_P, hpb_jY, hOpen_j, _⟩ :=
      hGraphCounitBij W hW hNe P_c u_tilde hg
    obtain ⟨hOpen_spec, hChar⟩ := hEY_spec W hW hNe u hu_et hu_comm r
    cases Subsingleton.elim hOpen_spec hOpen_j
    have : IsOpenImmersion j_Γ := hOpen_j
    have hj_et : Etale j_Γ := inferInstance
    have : IsProper (π_Y ≫ Y.hom) := hPropΓ
    have hProp_πP : IsProper π_P := by
      have : IsProper (π_P ≫ P_c.hom) := by rw [hπ_comm]; infer_instance
      exact MorphismProperty.of_postcomp (W := @IsProper) (W' := @IsSeparated)
        π_P P_c.hom inferInstance this
    have : IsProper π_P := hProp_πP
    let s_Pc : S_k ⟶ P_c.left := weilGysinAffineOrigin k (m + 1) ≫ ι_aff (m + 1)
    have hs_Pc : s_Pc ≫ P_c.hom = 𝟙 S_k := by
      dsimp only [s_Pc]
      rw [Category.assoc, hι_comm]
      dsimp only [weilGysinAffineOrigin, weilGysinAffineStruct, weilGysinAffineSpace, S_k]
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
      have hev : (MvPolynomial.eval (0 : Fin (m + 1) → k)).comp MvPolynomial.C = RingHom.id k := by
        ext a; exact MvPolynomial.eval_C a
      rw [hev, CommRingCat.ofHom_id, Spec.map_id]
    let U_aff : P_c.left.Opens := (ι_aff (m + 1)).opensRange
    let e_aff : weilGysinAffineSpace k (m + 1) ≅ U_aff.toScheme := (ι_aff (m + 1)).isoOpensRange
    have he_aff : e_aff.hom ≫ U_aff.ι = ι_aff (m + 1) :=
      Scheme.Hom.isoOpensRange_hom_ι (ι_aff (m + 1))
    let s_UP : S_k ⟶ U_aff.toScheme := weilGysinAffineOrigin k (m + 1) ≫ e_aff.hom
    have hChart_P : WeilGysinIsEtaleOriginChart (m + 1) P_c.hom s_Pc U_aff s_UP e_aff.inv := by
      refine ⟨inferInstance, ?_, ?_, ?_⟩
      · rw [← hι_comm, ← he_aff, Category.assoc, Iso.inv_hom_id_assoc]
      · dsimp only [s_UP, s_Pc]; rw [Category.assoc, he_aff]
      · have hw : s_UP ≫ e_aff.inv = 𝟙 S_k ≫ weilGysinAffineOrigin k (m + 1) := by
          dsimp only [s_UP]
          rw [Category.assoc, Iso.hom_inv_id, Category.comp_id, Category.id_comp]
        refine IsPullback.of_isLimit (Limits.PullbackCone.IsLimit.mk hw
          (fun cone => cone.snd)
          (fun cone => by
            rw [← cancel_mono e_aff.inv, Category.assoc, hw, Category.id_comp]
            exact cone.condition.symm)
          (fun cone => Category.comp_id cone.snd)
          (fun _ _ _ hm₂ => by simpa using hm₂))
    obtain ⟨τ_Y, τ_W, cl'_Y, hpb_YW, hpb_u0, hfg_Y⟩ :=
      (hτ.1 (m + 1) Y.left Y.hom s hs).1 W s_W u hChart r
    have hcl_Y_eq : cl_Y = cl'_Y :=
      (hτ.1 (m + 1) Y.left Y.hom s hs).2.1 r cl_Y cl'_Y hcl_Y
        ⟨W, s_W, u, hChart, τ_Y, τ_W, hpb_YW, hpb_u0, hfg_Y⟩
    subst hcl_Y_eq
    obtain ⟨τ_P, τ_UP, cl'_Pc, hpb_PU, hpb_e0, hfg_P⟩ :=
      (hτ.1 (m + 1) P_c.left P_c.hom s_Pc hs_Pc).1 U_aff s_UP e_aff.inv hChart_P r
    have hcl_Pc_eq : cl_Pc = cl'_Pc :=
      (hτ.1 (m + 1) P_c.left P_c.hom s_Pc hs_Pc).2.1 r cl_Pc cl'_Pc hcl_Pc
        ⟨U_aff, s_UP, e_aff.inv, hChart_P, τ_P, τ_UP, hpb_PU, hpb_e0, hfg_P⟩
    subst hcl_Pc_eq
    obtain ⟨p_Y, hp_Y⟩ := hPull_ex π_Y (ℓ ^ r) (2 * (m + 1))
    obtain ⟨z_Γ0, z_P0, hz_Γ0, hz_cl0, hz_P0⟩ :=
      weil_gysin_etale_origin_point_class_local_bridge k ℓ (m + 1) r
        Y.left Γ P_c.left Y.hom (π_Y ≫ Y.hom) P_c.hom π_Y π_P rfl hπ_comm
        W s hs s_W u hChart j_Γ hj_Y hpb_jY (ι_aff (m + 1)) hι_comm hj_P hu_tilde_et
        U_aff s_UP e_aff he_aff rfl (τ (m + 1) r) τ_Y τ_W τ_P τ_UP cl_Y cl_Pc p_Y
        hpb_YW hpb_u0 hpb_PU hpb_e0 hfg_Y hfg_P hp_Y
    have hEY_cl := (hChar cl_Y).2 hj_et hu_tilde_et p_Y z_Γ0 z_P0 hp_Y hz_Γ0 hz_cl0
    exact hEY_cl.trans hz_P0

theorem weil_gysin_smooth_proper_point_normalized_torsion_trace (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : IsUnit (ℓ : k))
    (τ : ∀ (c r : ℕ), WeilGysinSupportClass
      (AlgebraicGeometry.Spec (CommRingCat.of k))
      (weilGysinAffineSpace k c) (weilGysinAffineOrigin k c) (ℓ ^ r) (2 * c))
    (hτ : WeilGysinIsAffineOriginThomTower k ℓ τ)
    (c : ℕ) (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hIntY : AlgebraicGeometry.IsIntegral Y.left)
    [AlgebraicGeometry.IsProper Y.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension c Y.hom] :
    ∃ tr_Y : ∀ r : ℕ, weilEtaleTorsionH Y.left (ℓ ^ r) (2 * c) →+ ZMod (ℓ ^ r),
      (∀ r : ℕ, Function.Bijective (tr_Y r)) ∧
      (∀ (r : ℕ) (u : weilEtaleTorsionH Y.left (ℓ ^ (r + 1)) (2 * c)),
        ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r)) (tr_Y (r + 1) u) =
          tr_Y r (weilEtaleTorsionTransition Y.left ℓ r (2 * c) u)) ∧
      (∀ (r : ℕ) (s : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) Y.left)
        (cl : weilEtaleTorsionH Y.left (ℓ ^ r) (2 * c)),
        CategoryTheory.CategoryStruct.comp s Y.hom =
          CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)) →
        WeilGysinIsPointClass (τ c r) Y.left Y.hom s cl →
        tr_Y r cl = 1) :=
by
  have hℓ_ne : (ℓ : k) ≠ 0 := hℓ.ne_zero
  have hℓ_char : ℓ ≠ ringChar k := by
    intro h
    apply hℓ_ne
    rw [h]
    exact CharP.cast_eq_zero k (ringChar k)
  have hCD_all : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (m n q : ℕ),
      1 ≤ n → IsUnit (n : Ω) →
      ∀ (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
        [AlgebraicGeometry.IsProper Z.hom],
        topologicalKrullDim Z.left ≤ (m : WithBot ℕ∞) →
        2 * m < q →
        Subsingleton (weilEtaleTorsionH Z.left n q) :=
    fun Ω _ _ m n q hn hUnit Z _ hDim hq =>
      weil_alt_proper_etale_cohomological_dimension Ω m n q hn hUnit Z hDim hq
  have hPBC_all : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω],
      (ℓ : Ω) ≠ 0 → WeilProperModPrimeBaseChangeHolds Ω ℓ :=
    fun Ω _ _ h => weil_etale_proper_base_change_mod_prime Ω ℓ h
  obtain ⟨hAffOrigin, ⟨ι_P1, s_inf, V_zero_compl, ι_aff, hComp⟩, hSteinitz⟩ :=
    weil_gysin_smooth_affine_charts_and_steinitz_chain k
  obtain ⟨hDim0Trace, hOriginNeZero⟩ :=
    weil_gysin_dim_zero_and_polyP1_origin_nonvanishing k ℓ hℓ τ hτ hCD_all hPBC_all
      ι_P1 s_inf V_zero_compl ι_aff hComp
  rcases Nat.eq_zero_or_pos c with rfl | hc_pos
  · have hDim0 : topologicalKrullDim Y.left = (0 : WithBot ℕ∞) :=
      weil_smooth_integral_krullDim_over_field k 0 Y hIntY
    have hIsoY : CategoryTheory.IsIso Y.hom := by
      have : AlgebraicGeometry.IsIntegral Y.left := hIntY
      have : IrreducibleSpace ↥Y.left := AlgebraicGeometry.irreducibleSpace_of_isIntegral Y.left
      let instTop : OrderTop (TopologicalSpace.IrreducibleCloseds ↥Y.left) :=
        { top := ⟨Set.univ, IrreducibleSpace.isIrreducible_univ (X := ↥Y.left), isClosed_univ⟩
          le_top := fun S => Set.subset_univ S.1 }
      have hSubIC : Subsingleton (TopologicalSpace.IrreducibleCloseds ↥Y.left) :=
        (@Order.krullDim_eq_zero_iff_of_orderTop _ _ instTop).mp hDim0
      have hClosUniv : ∀ x : ↥Y.left, closure ({x} : Set ↥Y.left) = Set.univ := by
        intro x
        let Sx : TopologicalSpace.IrreducibleCloseds ↥Y.left :=
          ⟨closure ({x} : Set ↥Y.left), isIrreducible_singleton.closure, isClosed_closure⟩
        have hEq : Sx = instTop.top := Subsingleton.elim Sx instTop.top
        exact congrArg SetLike.coe hEq
      have hSubY : Subsingleton ↥Y.left := ⟨fun x y => by
        apply Inseparable.eq
        rw [inseparable_iff_closure_eq, hClosUniv x, hClosUniv y]⟩
      obtain ⟨y₀⟩ : Nonempty ↥Y.left := inferInstance
      obtain ⟨V₀, hV₀, hy₀, -⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := (⊤ : Y.left.Opens))
          (x := y₀) trivial
      have hV₀_top : V₀ = ⊤ := by
        ext z
        exact ⟨fun _ => trivial, fun _ => Subsingleton.elim z y₀ ▸ hy₀⟩
      have hAffTop : AlgebraicGeometry.IsAffineOpen (⊤ : Y.left.Opens) := hV₀_top ▸ hV₀
      let R := Y.left.presheaf.obj (Opposite.op (⊤ : Y.left.Opens))
      let eTopSpec : (⊤ : Y.left.Opens).toScheme ≅ AlgebraicGeometry.Spec R := hAffTop.isoSpec
      let eSpec : Y.left ≅ AlgebraicGeometry.Spec R := Y.left.topIso.symm ≪≫ eTopSpec
      have hSubSpec : Subsingleton (PrimeSpectrum ↑R) := ⟨fun p q => by
        have hinj : Function.Injective eSpec.inv.base := fun a b hab => by
          have h1 := congrArg eSpec.hom.base hab
          simpa [← AlgebraicGeometry.Scheme.Hom.comp_apply] using h1
        exact hinj (Subsingleton.elim (eSpec.inv.base p) (eSpec.inv.base q))⟩
      have : IsDomain ↑R := inferInstance
      have hIsFieldR : IsField ↑R := by
        refine ⟨⟨0, 1, zero_ne_one⟩, mul_comm, fun {a} ha => ?_⟩
        by_contra hnu
        have hne_top : Ideal.span ({a} : Set ↑R) ≠ ⊤ := by
          rw [Ideal.ne_top_iff_one, Ideal.mem_span_singleton]
          rintro ⟨b, hb⟩
          exact hnu ⟨b, hb.symm⟩
        obtain ⟨m, hm_max, hle⟩ := Ideal.exists_le_maximal _ hne_top
        let p_m : PrimeSpectrum ↑R := ⟨m, hm_max.isPrime⟩
        let p_bot : PrimeSpectrum ↑R := ⟨⊥, Ideal.isPrime_bot⟩
        have hp_eq : p_m = p_bot := hSubSpec.elim p_m p_bot
        have hm_bot : m = ⊥ := congrArg PrimeSpectrum.asIdeal hp_eq
        have ha_mem : a ∈ (⊥ : Ideal ↑R) := hm_bot ▸ hle (Ideal.subset_span (Set.mem_singleton a))
        exact ha (Ideal.mem_bot.mp ha_mem)
      let _instFieldR : Field ↑R := hIsFieldR.toField
      have hf_lft : AlgebraicGeometry.LocallyOfFiniteType (eSpec.inv ≫ Y.hom) :=
        CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.LocallyOfFiniteType)
          eSpec.inv Y.hom inferInstance inferInstance
      let φ : CommRingCat.of k ⟶ R := AlgebraicGeometry.Spec.preimage (eSpec.inv ≫ Y.hom)
      have hφ_spec : AlgebraicGeometry.Spec.map φ = eSpec.inv ≫ Y.hom :=
        AlgebraicGeometry.Spec.map_preimage (eSpec.inv ≫ Y.hom)
      have hφ_ft : RingHom.FiniteType φ.hom :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp
          (hφ_spec.symm ▸ hf_lft)
      let _instAlg : Algebra k ↑R := φ.hom.toAlgebra
      have : Algebra.FiniteType k ↑R := hφ_ft
      have : IsJacobsonRing k := inferInstance
      have : Module.Finite k ↑R := finite_of_finite_type_of_isJacobsonRing k ↑R
      have : Algebra.IsIntegral k ↑R := Algebra.IsIntegral.of_finite k ↑R
      have hBij : Function.Bijective (algebraMap k ↑R) :=
        IsAlgClosed.algebraMap_bijective_of_isIntegral
      have : CategoryTheory.IsIso φ :=
        (ConcreteCategory.isIso_iff_bijective φ).mpr hBij
      have : CategoryTheory.IsIso (eSpec.inv ≫ Y.hom) := by
        rw [← hφ_spec]
        infer_instance
      have hY_eq : Y.hom = eSpec.hom ≫ (eSpec.inv ≫ Y.hom) := by simp
      rw [hY_eq]
      infer_instance
    exact hDim0Trace Y
  · have hc : 1 ≤ c := hc_pos
    let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
    let P_c := weilGysinPolyP1Over k c
    obtain ⟨hPc_int, hPc_prop, hPc_sm, _, hι_comm⟩ := hComp.2.1 c
    have : AlgebraicGeometry.IsProper P_c.hom := hPc_prop
    have : AlgebraicGeometry.SmoothOfRelativeDimension c P_c.hom := hPc_sm
    let s_Pc : Quiver.Hom S_k P_c.left :=
      CategoryTheory.CategoryStruct.comp (weilGysinAffineOrigin k c) (ι_aff c)
    have hs_Pc : CategoryTheory.CategoryStruct.comp s_Pc P_c.hom =
        CategoryTheory.CategoryStruct.id S_k := by
      change (weilGysinAffineOrigin k c ≫ ι_aff c) ≫ P_c.hom = 𝟙 S_k
      rw [Category.assoc, hι_comm]
      dsimp only [weilGysinAffineOrigin, weilGysinAffineStruct, weilGysinAffineSpace, S_k]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      have h_ev : (MvPolynomial.eval (0 : Fin c → k)).comp MvPolynomial.C = RingHom.id k := by
        ext x
        exact MvPolynomial.eval_C x
      rw [h_ev, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
    obtain ⟨W_Pc, s_WPc, u_Pc, _, hChart_Pc⟩ := hAffOrigin c P_c hPc_int s_Pc hs_Pc
    have hex_Pc : ∀ r : ℕ, ∃ cl : weilEtaleTorsionH P_c.left (ℓ ^ r) (2 * c),
        WeilGysinIsPointClass (τ c r) P_c.left P_c.hom s_Pc cl := by
      intro r
      obtain ⟨τ_Pc, τ_WPc, cl, hpb1, hpb2, hfg⟩ :=
        (hτ.1 c P_c.left P_c.hom s_Pc hs_Pc).1 W_Pc s_WPc u_Pc hChart_Pc r
      exact ⟨cl, ⟨W_Pc, s_WPc, u_Pc, hChart_Pc, τ_Pc, τ_WPc, hpb1, hpb2, hfg⟩⟩
    choose cl_Pc hcl_Pc using hex_Pc
    have hcl_Pc_trans : ∀ r : ℕ,
        weilEtaleTorsionTransition P_c.left ℓ r (2 * c) (cl_Pc (r + 1)) = cl_Pc r :=
      fun r => (hτ.1 c P_c.left P_c.hom s_Pc hs_Pc).2.2 r
        (cl_Pc (r + 1)) (cl_Pc r) (hcl_Pc (r + 1)) (hcl_Pc r)
    have hcl_Pc1_ne : cl_Pc 1 ≠ 0 :=
      hOriginNeZero c hc (cl_Pc 1) (hcl_Pc 1)
    obtain ⟨tr_Pc_pd, htr_Pc_bij, htr_Pc_trans, -⟩ :=
      weil_etale_smooth_proper_torsion_poincare_duality k P_c hPc_int c ℓ hℓ_char
    obtain ⟨tr_Y_pd, htr_Y_bij, -, -⟩ :=
      weil_etale_smooth_proper_torsion_poincare_duality k Y hIntY c ℓ hℓ_char
    have hPrime : Nat.Prime ℓ := Fact.out
    have hℓ_pos : 0 < ℓ := hPrime.pos
    have hpow_pos : ∀ r : ℕ, 0 < ℓ ^ r := fun r => pow_pos hℓ_pos r
    let α : ∀ r : ℕ, ZMod (ℓ ^ r) := fun r => tr_Pc_pd r (cl_Pc r)
    have hα_step : ∀ r : ℕ,
        ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r)) (α (r + 1)) = α r := by
      intro r
      dsimp only [α]
      rw [htr_Pc_trans r (cl_Pc (r + 1)), hcl_Pc_trans r]
    have hα_to_one : ∀ m : ℕ,
        ZMod.castHom (pow_dvd_pow ℓ (Nat.succ_pos m)) (ZMod (ℓ ^ 1)) (α (m + 1)) = α 1 := by
      intro m
      induction m with
      | zero => simp
      | succ m ih =>
        rw [← ih, ← hα_step (m + 1)]
        simp only [← RingHom.comp_apply, ZMod.castHom_comp]
    have hα1_ne : α 1 ≠ 0 := by
      intro h0
      apply hcl_Pc1_ne
      apply (htr_Pc_bij 1).injective
      rw [map_zero]
      exact h0
    have hα1_val_ne : (α 1).val ≠ 0 := by
      have : NeZero (ℓ ^ 1) := ⟨Nat.ne_of_gt (hpow_pos 1)⟩
      intro hv0
      apply hα1_ne
      rw [← ZMod.natCast_zmod_val (α 1), hv0, Nat.cast_zero]
    have hCop : ∀ r : ℕ, Nat.Coprime (α r).val (ℓ ^ r) := by
      intro r
      cases r with
      | zero => exact Nat.coprime_one_right _
      | succ m =>
        have : NeZero (ℓ ^ (m + 1)) := ⟨Nat.ne_of_gt (hpow_pos (m + 1))⟩
        have : NeZero (ℓ ^ 1) := ⟨Nat.ne_of_gt (hpow_pos 1)⟩
        have hcast := congrArg ZMod.val (hα_to_one m)
        rw [ZMod.castHom_apply, ZMod.cast_eq_val, ZMod.val_natCast] at hcast
        have hmod : (α (m + 1)).val % ℓ = (α 1).val := by
          simpa only [pow_one] using hcast
        have hcop_base : Nat.Coprime (α (m + 1)).val ℓ := by
          rw [Nat.coprime_comm, hPrime.coprime_iff_not_dvd]
          intro hdvd
          apply hα1_val_ne
          rw [← hmod]
          exact Nat.mod_eq_zero_of_dvd hdvd
        exact hcop_base.pow_right (m + 1)
    let u_α : ∀ r : ℕ, (ZMod (ℓ ^ r))ˣ :=
      fun r => ZMod.unitOfCoprime (α r).val (hCop r)
    have hu_coe : ∀ r : ℕ, ((u_α r : (ZMod (ℓ ^ r))ˣ) : ZMod (ℓ ^ r)) = α r := by
      intro r
      have : NeZero (ℓ ^ r) := ⟨Nat.ne_of_gt (hpow_pos r)⟩
      dsimp only [u_α]
      rw [ZMod.coe_unitOfCoprime, ZMod.natCast_zmod_val]
    let β : ∀ r : ℕ, ZMod (ℓ ^ r) := fun r => ↑((u_α r)⁻¹)
    have hβ_mul_α : ∀ r : ℕ, β r * α r = 1 := by
      intro r
      dsimp only [β]
      rw [← hu_coe r, Units.inv_mul]
    have hα_mul_β : ∀ r : ℕ, α r * β r = 1 := by
      intro r
      dsimp only [β]
      rw [← hu_coe r, Units.mul_inv]
    have hβ_step : ∀ r : ℕ,
        ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r)) (β (r + 1)) = β r := by
      intro r
      let φ := ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r))
      calc
        φ (β (r + 1)) = φ (β (r + 1)) * (α r * β r) := by rw [hα_mul_β r, mul_one]
        _ = (φ (β (r + 1)) * φ (α (r + 1))) * β r := by rw [hα_step r, mul_assoc]
        _ = φ (β (r + 1) * α (r + 1)) * β r := by rw [← map_mul]
        _ = φ 1 * β r := by rw [hβ_mul_α (r + 1)]
        _ = β r := by rw [map_one, one_mul]
    let tr_Pc_τ : ∀ r : ℕ, weilEtaleTorsionH P_c.left (ℓ ^ r) (2 * c) →+ ZMod (ℓ ^ r) :=
      fun r =>
        { toFun := fun z => β r * tr_Pc_pd r z
          map_zero' := by simp
          map_add' := fun x y => by rw [map_add, mul_add] }
    have htr_Pc_τ_norm : ∀ r : ℕ, tr_Pc_τ r (cl_Pc r) = 1 := fun r => hβ_mul_α r
    have htr_Pc_τ_trans : ∀ (r : ℕ) (z : weilEtaleTorsionH P_c.left (ℓ ^ (r + 1)) (2 * c)),
        ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r)) (tr_Pc_τ (r + 1) z) =
          tr_Pc_τ r (weilEtaleTorsionTransition P_c.left ℓ r (2 * c) z) := by
      intro r z
      change ZMod.castHom _ _ (β (r + 1) * tr_Pc_pd (r + 1) z) =
        β r * tr_Pc_pd r (weilEtaleTorsionTransition P_c.left ℓ r (2 * c) z)
      rw [map_mul, hβ_step r, htr_Pc_trans r z]
    have hex_s₀ : ∃ s₀ : Quiver.Hom S_k Y.left,
        CategoryTheory.CategoryStruct.comp s₀ Y.hom = CategoryTheory.CategoryStruct.id S_k := by
      have : AlgebraicGeometry.IsIntegral Y.left := hIntY
      obtain ⟨y₀⟩ : Nonempty ↥Y.left := inferInstance
      obtain ⟨V₀, hV₀, hy₀, -⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := (⊤ : Y.left.Opens))
          (x := y₀) trivial
      let R₀ := Y.left.presheaf.obj (Opposite.op V₀)
      have : Nontrivial ↑R₀ :=
        (PrimeSpectrum.nonempty_iff_nontrivial (R := ↑R₀)).mp
          ⟨hV₀.isoSpec.hom.base ⟨y₀, hy₀⟩⟩
      obtain ⟨m, hm_max⟩ := Ideal.exists_maximal ↑R₀
      let _instFieldQ : Field (↑R₀ ⧸ m) := Ideal.Quotient.field m
      have hf_lft : AlgebraicGeometry.LocallyOfFiniteType (hV₀.fromSpec ≫ Y.hom) :=
        CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.LocallyOfFiniteType)
          hV₀.fromSpec Y.hom inferInstance inferInstance
      let φ₀ : CommRingCat.of k ⟶ R₀ := AlgebraicGeometry.Spec.preimage (hV₀.fromSpec ≫ Y.hom)
      have hφ₀_spec : AlgebraicGeometry.Spec.map φ₀ = hV₀.fromSpec ≫ Y.hom :=
        AlgebraicGeometry.Spec.map_preimage (hV₀.fromSpec ≫ Y.hom)
      have hφ₀_ft : RingHom.FiniteType φ₀.hom :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp
          (hφ₀_spec.symm ▸ hf_lft)
      let ψ : k →+* (↑R₀ ⧸ m) := (Ideal.Quotient.mk m).comp φ₀.hom
      let _instAlgkQ : Algebra k (↑R₀ ⧸ m) := ψ.toAlgebra
      have hψ_ft : RingHom.FiniteType ψ :=
        RingHom.FiniteType.comp (RingHom.FiniteType.of_surjective _ Ideal.Quotient.mk_surjective) hφ₀_ft
      have : Algebra.FiniteType k (↑R₀ ⧸ m) := hψ_ft
      have : IsJacobsonRing k := inferInstance
      have : Module.Finite k (↑R₀ ⧸ m) := finite_of_finite_type_of_isJacobsonRing k (↑R₀ ⧸ m)
      have : Algebra.IsIntegral k (↑R₀ ⧸ m) := Algebra.IsIntegral.of_finite k (↑R₀ ⧸ m)
      have hBij : Function.Bijective (algebraMap k (↑R₀ ⧸ m)) :=
        IsAlgClosed.algebraMap_bijective_of_isIntegral
      let e_quot : k ≃+* (↑R₀ ⧸ m) := RingEquiv.ofBijective ψ hBij
      let ret : R₀ ⟶ CommRingCat.of k :=
        CommRingCat.ofHom (e_quot.symm.toRingHom.comp (Ideal.Quotient.mk m))
      have hφ_ret : φ₀ ≫ ret = 𝟙 (CommRingCat.of k) := by
        ext x
        exact e_quot.symm_apply_apply x
      refine ⟨AlgebraicGeometry.Spec.map ret ≫ hV₀.fromSpec, ?_⟩
      change (AlgebraicGeometry.Spec.map ret ≫ hV₀.fromSpec) ≫ Y.hom = 𝟙 S_k
      rw [Category.assoc, ← hφ₀_spec, ← AlgebraicGeometry.Spec.map_comp, hφ_ret,
        AlgebraicGeometry.Spec.map_id]
    obtain ⟨s₀, hs₀⟩ := hex_s₀
    obtain ⟨W₀, s_W₀, u₀, hW₀, hChart₀⟩ := hAffOrigin c Y hIntY s₀ hs₀
    obtain ⟨pt₀⟩ : Nonempty ↥S_k := inferInstance
    have hNe₀ : Nonempty ↥W₀ := ⟨s_W₀.base pt₀⟩
    have hu₀_et : AlgebraicGeometry.Etale u₀ := hChart₀.1
    have hu₀_comm : CategoryTheory.CategoryStruct.comp u₀ (weilGysinAffineStruct k c) =
        CategoryTheory.CategoryStruct.comp W₀.ι Y.hom := hChart₀.2.1
    have hCurveInv : WeilGysinCurveEtaleCounitInvarianceHolds.{u} ℓ :=
      weil_gysin_curve_etale_counit_invariance ℓ hCD_all hPBC_all
    obtain ⟨E_Y, hE_shrink, hE_coord, hE_trans, hE_pt⟩ :=
      weil_gysin_etale_chart_polyP1_pushforward k ℓ hℓ τ hτ hCD_all hPBC_all
        ι_P1 s_inf V_zero_compl ι_aff hComp hCurveInv c hc Y hIntY
    let tr_Y : ∀ r : ℕ, weilEtaleTorsionH Y.left (ℓ ^ r) (2 * c) →+ ZMod (ℓ ^ r) :=
      fun r => (tr_Pc_τ r).comp (E_Y W₀ hW₀ hNe₀ u₀ hu₀_et hu₀_comm r)
    have hE_congr : ∀ {W_a : Y.left.Opens} (hWa : AlgebraicGeometry.IsAffineOpen W_a)
        (hNea : Nonempty ↥W_a)
        {v₁ v₂ : Quiver.Hom W_a.toScheme (weilGysinAffineSpace k c)}
        (hv : v₁ = v₂)
        (he₁ : AlgebraicGeometry.Etale v₁)
        (hc₁ : CategoryTheory.CategoryStruct.comp v₁ (weilGysinAffineStruct k c) =
          CategoryTheory.CategoryStruct.comp W_a.ι Y.hom)
        (he₂ : AlgebraicGeometry.Etale v₂)
        (hc₂ : CategoryTheory.CategoryStruct.comp v₂ (weilGysinAffineStruct k c) =
          CategoryTheory.CategoryStruct.comp W_a.ι Y.hom)
        (r : ℕ),
        E_Y W_a hWa hNea v₁ he₁ hc₁ r = E_Y W_a hWa hNea v₂ he₂ hc₂ r := by
      intro W_a hWa hNea v₁ v₂ hv he₁ hc₁ he₂ hc₂ r
      subst hv
      rfl
    have htr_Y_pt : ∀ (r : ℕ) (s : Quiver.Hom S_k Y.left)
        (cl : weilEtaleTorsionH Y.left (ℓ ^ r) (2 * c)),
        CategoryTheory.CategoryStruct.comp s Y.hom = CategoryTheory.CategoryStruct.id S_k →
        WeilGysinIsPointClass (τ c r) Y.left Y.hom s cl →
        tr_Y r cl = 1 := by
      intro r s cl hs hcl
      obtain ⟨W_s, s_Ws, u_s, hW_s, hChart_s⟩ := hAffOrigin c Y hIntY s hs
      have hNe_s : Nonempty ↥W_s := ⟨s_Ws.base pt₀⟩
      have hu_s_et : AlgebraicGeometry.Etale u_s := hChart_s.1
      have hu_s_comm : CategoryTheory.CategoryStruct.comp u_s (weilGysinAffineStruct k c) =
          CategoryTheory.CategoryStruct.comp W_s.ι Y.hom := hChart_s.2.1
      have : AlgebraicGeometry.IsIntegral Y.left := hIntY
      have : IrreducibleSpace ↥Y.left := AlgebraicGeometry.irreducibleSpace_of_isIntegral Y.left
      have hW₀_ne : (Set.univ ∩ (W₀ : Set ↥Y.left)).Nonempty :=
        ⟨(s_W₀.base pt₀).1, trivial, (s_W₀.base pt₀).2⟩
      have hWs_ne : (Set.univ ∩ (W_s : Set ↥Y.left)).Nonempty :=
        ⟨(s_Ws.base pt₀).1, trivial, (s_Ws.base pt₀).2⟩
      obtain ⟨y_0s, -, hy₀, hys⟩ :=
        (IrreducibleSpace.isIrreducible_univ (X := ↥Y.left)).2
          (W₀ : Set ↥Y.left) (W_s : Set ↥Y.left) W₀.isOpen W_s.isOpen hW₀_ne hWs_ne
      have hy_inf : y_0s ∈ W₀ ⊓ W_s := ⟨hy₀, hys⟩
      obtain ⟨W_0s, hW_0s, hy_in, hsub⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := W₀ ⊓ W_s) hy_inf
      have hle_inf : W_0s ≤ W₀ ⊓ W_s := hsub
      have hle₀ : W_0s ≤ W₀ := hle_inf.trans inf_le_left
      have hle_s : W_0s ≤ W_s := hle_inf.trans inf_le_right
      have hNe_0s : Nonempty ↥W_0s := ⟨⟨y_0s, hy_in⟩⟩
      let u₀_0s : Quiver.Hom W_0s.toScheme (weilGysinAffineSpace k c) :=
        CategoryTheory.CategoryStruct.comp (Y.left.homOfLE hle₀) u₀
      let us_0s : Quiver.Hom W_0s.toScheme (weilGysinAffineSpace k c) :=
        CategoryTheory.CategoryStruct.comp (Y.left.homOfLE hle_s) u_s
      have hu₀_0s_et : AlgebraicGeometry.Etale u₀_0s := by
        have : AlgebraicGeometry.Etale u₀ := hu₀_et
        change AlgebraicGeometry.Etale (Y.left.homOfLE hle₀ ≫ u₀)
        infer_instance
      have hus_0s_et : AlgebraicGeometry.Etale us_0s := by
        have : AlgebraicGeometry.Etale u_s := hu_s_et
        change AlgebraicGeometry.Etale (Y.left.homOfLE hle_s ≫ u_s)
        infer_instance
      have hu₀_0s_comm : CategoryTheory.CategoryStruct.comp u₀_0s (weilGysinAffineStruct k c) =
          CategoryTheory.CategoryStruct.comp W_0s.ι Y.hom := by
        change (Y.left.homOfLE hle₀ ≫ u₀) ≫ weilGysinAffineStruct k c = W_0s.ι ≫ Y.hom
        rw [Category.assoc, hu₀_comm, AlgebraicGeometry.Scheme.homOfLE_ι_assoc]
      have hus_0s_comm : CategoryTheory.CategoryStruct.comp us_0s (weilGysinAffineStruct k c) =
          CategoryTheory.CategoryStruct.comp W_0s.ι Y.hom := by
        change (Y.left.homOfLE hle_s ≫ u_s) ≫ weilGysinAffineStruct k c = W_0s.ι ≫ Y.hom
        rw [Category.assoc, hu_s_comm, AlgebraicGeometry.Scheme.homOfLE_ι_assoc]
      obtain ⟨W', hle', N, w, hW', hNe', hw0, hwN, hw_valid, hw_step⟩ :=
        hSteinitz c hc Y hIntY W_0s hW_0s hNe_0s u₀_0s us_0s
          hu₀_0s_et hus_0s_et hu₀_0s_comm hus_0s_comm
      have hChain : ∀ (m : ℕ) (hm : m ≤ N),
          E_Y W' hW' hNe' (w ⟨m, Nat.lt_succ_of_le hm⟩)
            (hw_valid ⟨m, Nat.lt_succ_of_le hm⟩).1
            (hw_valid ⟨m, Nat.lt_succ_of_le hm⟩).2 r =
          E_Y W' hW' hNe' (w 0) (hw_valid 0).1 (hw_valid 0).2 r := by
        intro m
        induction m with
        | zero =>
          intro _
          rfl
        | succ m ih =>
          intro hm
          let idx : Fin N := ⟨m, hm⟩
          obtain ⟨i₀, hi₀⟩ := hw_step idx
          have hstep_eq :=
            hE_coord W' hW' hNe' (w idx.succ) (w idx.castSucc)
              (hw_valid idx.succ).1 (hw_valid idx.succ).2
              (hw_valid idx.castSucc).1 (hw_valid idx.castSucc).2
              i₀ hi₀ r
          exact hstep_eq.trans (ih (Nat.le_of_succ_le hm))
      have hChain_end :
          E_Y W' hW' hNe' (w (Fin.last N)) (hw_valid (Fin.last N)).1
            (hw_valid (Fin.last N)).2 r =
          E_Y W' hW' hNe' (w 0) (hw_valid 0).1 (hw_valid 0).2 r :=
        hChain N le_rfl
      have hle'₀ : W' ≤ W₀ := hle'.trans hle₀
      have hle'_s : W' ≤ W_s := hle'.trans hle_s
      have hu₀_W'_et : AlgebraicGeometry.Etale
          (CategoryTheory.CategoryStruct.comp (Y.left.homOfLE hle'₀) u₀) := by
        have : AlgebraicGeometry.Etale u₀ := hu₀_et
        change AlgebraicGeometry.Etale (Y.left.homOfLE hle'₀ ≫ u₀)
        infer_instance
      have hu₀_W'_comm : CategoryTheory.CategoryStruct.comp
          (CategoryTheory.CategoryStruct.comp (Y.left.homOfLE hle'₀) u₀)
          (weilGysinAffineStruct k c) =
          CategoryTheory.CategoryStruct.comp W'.ι Y.hom := by
        rw [Category.assoc, hu₀_comm, AlgebraicGeometry.Scheme.homOfLE_ι_assoc]
      have hus_W'_et : AlgebraicGeometry.Etale
          (CategoryTheory.CategoryStruct.comp (Y.left.homOfLE hle'_s) u_s) := by
        have : AlgebraicGeometry.Etale u_s := hu_s_et
        change AlgebraicGeometry.Etale (Y.left.homOfLE hle'_s ≫ u_s)
        infer_instance
      have hus_W'_comm : CategoryTheory.CategoryStruct.comp
          (CategoryTheory.CategoryStruct.comp (Y.left.homOfLE hle'_s) u_s)
          (weilGysinAffineStruct k c) =
          CategoryTheory.CategoryStruct.comp W'.ι Y.hom := by
        rw [Category.assoc, hu_s_comm, AlgebraicGeometry.Scheme.homOfLE_ι_assoc]
      have hw0_eq : CategoryTheory.CategoryStruct.comp (Y.left.homOfLE hle'₀) u₀ = w 0 := by
        rw [hw0]
        change Y.left.homOfLE hle'₀ ≫ u₀ = Y.left.homOfLE hle' ≫ (Y.left.homOfLE hle₀ ≫ u₀)
        rw [← Category.assoc, AlgebraicGeometry.Scheme.homOfLE_homOfLE]
      have hwN_eq : w (Fin.last N) =
          CategoryTheory.CategoryStruct.comp (Y.left.homOfLE hle'_s) u_s := by
        rw [hwN]
        change Y.left.homOfLE hle' ≫ (Y.left.homOfLE hle_s ≫ u_s) = Y.left.homOfLE hle'_s ≫ u_s
        rw [← Category.assoc, AlgebraicGeometry.Scheme.homOfLE_homOfLE]
      have hE_eq :
          E_Y W₀ hW₀ hNe₀ u₀ hu₀_et hu₀_comm r =
          E_Y W_s hW_s hNe_s u_s hu_s_et hu_s_comm r := by
        calc
          E_Y W₀ hW₀ hNe₀ u₀ hu₀_et hu₀_comm r =
              E_Y W' hW' hNe' (CategoryTheory.CategoryStruct.comp (Y.left.homOfLE hle'₀) u₀)
                hu₀_W'_et hu₀_W'_comm r :=
            (hE_shrink W' W₀ hle'₀ hW' hNe' hW₀ hNe₀ u₀ hu₀_et hu₀_comm
              hu₀_W'_et hu₀_W'_comm r).symm
          _ = E_Y W' hW' hNe' (w 0) (hw_valid 0).1 (hw_valid 0).2 r :=
            hE_congr hW' hNe' hw0_eq hu₀_W'_et hu₀_W'_comm (hw_valid 0).1 (hw_valid 0).2 r
          _ = E_Y W' hW' hNe' (w (Fin.last N)) (hw_valid (Fin.last N)).1
                (hw_valid (Fin.last N)).2 r :=
            hChain_end.symm
          _ = E_Y W' hW' hNe' (CategoryTheory.CategoryStruct.comp (Y.left.homOfLE hle'_s) u_s)
                hus_W'_et hus_W'_comm r :=
            hE_congr hW' hNe' hwN_eq (hw_valid (Fin.last N)).1 (hw_valid (Fin.last N)).2
              hus_W'_et hus_W'_comm r
          _ = E_Y W_s hW_s hNe_s u_s hu_s_et hu_s_comm r :=
            hE_shrink W' W_s hle'_s hW' hNe' hW_s hNe_s u_s hu_s_et hu_s_comm
              hus_W'_et hus_W'_comm r
      change tr_Pc_τ r (E_Y W₀ hW₀ hNe₀ u₀ hu₀_et hu₀_comm r cl) = 1
      rw [hE_eq, hE_pt W_s hW_s hNe_s s s_Ws u_s hu_s_et hu_s_comm hs hChart_s r
        cl (cl_Pc r) hcl (hcl_Pc r)]
      exact htr_Pc_τ_norm r
    refine ⟨tr_Y, ?_, ?_, htr_Y_pt⟩
    · intro r
      have : NeZero (ℓ ^ r) := ⟨Nat.ne_of_gt (hpow_pos r)⟩
      obtain ⟨τ_Y0, τ_W0, cl_Y0, hpbY1, hpbY2, hfgY⟩ :=
        (hτ.1 c Y.left Y.hom s₀ hs₀).1 W₀ s_W₀ u₀ hChart₀ r
      have hcl_Y0 : WeilGysinIsPointClass (τ c r) Y.left Y.hom s₀ cl_Y0 :=
        ⟨W₀, s_W₀, u₀, hChart₀, τ_Y0, τ_W0, hpbY1, hpbY2, hfgY⟩
      have htr1 : tr_Y r cl_Y0 = 1 := htr_Y_pt r s₀ cl_Y0 hs₀ hcl_Y0
      have hSurj : Function.Surjective (tr_Y r) := by
        intro a
        refine ⟨a.val • cl_Y0, ?_⟩
        rw [map_nsmul, htr1, nsmul_one, ZMod.natCast_zmod_val]
      let e_pd : weilEtaleTorsionH Y.left (ℓ ^ r) (2 * c) ≃ ZMod (ℓ ^ r) :=
        Equiv.ofBijective (tr_Y_pd r) (htr_Y_bij r)
      let g : ZMod (ℓ ^ r) → ZMod (ℓ ^ r) := fun z => tr_Y r (e_pd.symm z)
      have hg_surj : Function.Surjective g := hSurj.comp e_pd.symm.surjective
      have hg_bij : Function.Bijective g := Finite.surjective_iff_bijective.mp hg_surj
      have hcomp : (tr_Y r : weilEtaleTorsionH Y.left (ℓ ^ r) (2 * c) → ZMod (ℓ ^ r)) =
          g ∘ e_pd := by
        ext x
        simp [g]
      rw [hcomp]
      exact hg_bij.comp e_pd.bijective
    · intro r u
      change ZMod.castHom _ _ (tr_Pc_τ (r + 1) (E_Y W₀ hW₀ hNe₀ u₀ hu₀_et hu₀_comm (r + 1) u)) =
        tr_Pc_τ r (E_Y W₀ hW₀ hNe₀ u₀ hu₀_et hu₀_comm r
          (weilEtaleTorsionTransition Y.left ℓ r (2 * c) u))
      rw [htr_Pc_τ_trans r (E_Y W₀ hW₀ hNe₀ u₀ hu₀_et hu₀_comm (r + 1) u),
        hE_trans W₀ hW₀ hNe₀ u₀ hu₀_et hu₀_comm r u]

theorem weil_lefschetz_torsion_trace_and_product (k : Type u) [Field k] [IsAlgClosed k]
    (d : ℕ) (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hInt : AlgebraicGeometry.IsIntegral X.left)
    [AlgebraicGeometry.IsProper X.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : IsUnit (ℓ : k)) :
    ∃ (tr_X : ∀ r : ℕ, weilEtaleTorsionH X.left (ℓ ^ r) (2 * d) →+ ZMod (ℓ ^ r))
      (tr_P : ∀ r : ℕ, weilEtaleTorsionH
        (CategoryTheory.Limits.pullback X.hom X.hom) (ℓ ^ r) (4 * d) →+ ZMod (ℓ ^ r)),
      (∀ r : ℕ, Function.Bijective (tr_X r)) ∧
      (∀ (r : ℕ) (u : weilEtaleTorsionH X.left (ℓ ^ (r + 1)) (2 * d)),
        ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r)) (tr_X (r + 1) u) =
          tr_X r (weilEtaleTorsionTransition X.left ℓ r (2 * d) u)) ∧
      (∀ (r : ℕ) (z : weilEtaleTorsionH
          (CategoryTheory.Limits.pullback X.hom X.hom) (ℓ ^ (r + 1)) (4 * d)),
        ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r)) (tr_P (r + 1) z) =
          tr_P r (weilEtaleTorsionTransition
            (CategoryTheory.Limits.pullback X.hom X.hom) ℓ r (4 * d) z)) ∧
      (∀ (r : ℕ)
        (p₁_r p₂_r : weilEtaleTorsionH X.left (ℓ ^ r) (2 * d) →+
          weilEtaleTorsionH (CategoryTheory.Limits.pullback X.hom X.hom) (ℓ ^ r) (2 * d))
        (c_P_r : weilEtaleTorsionH (CategoryTheory.Limits.pullback X.hom X.hom) (ℓ ^ r) (2 * d) →+
          weilEtaleTorsionH (CategoryTheory.Limits.pullback X.hom X.hom) (ℓ ^ r) (2 * d) →+
          weilEtaleTorsionH (CategoryTheory.Limits.pullback X.hom X.hom) (ℓ ^ r) (4 * d)),
        WeilLefschetzTorsionPullback
          (CategoryTheory.Limits.pullback.fst X.hom X.hom) (ℓ ^ r) (2 * d) p₁_r →
        WeilLefschetzTorsionPullback
          (CategoryTheory.Limits.pullback.snd X.hom X.hom) (ℓ ^ r) (2 * d) p₂_r →
        WeilLefschetzIsTorsionCup
          (CategoryTheory.Limits.pullback X.hom X.hom) (ℓ ^ r) (2 * d) (2 * d) (4 * d)
          (by omega) c_P_r →
        ∀ (u w : weilEtaleTorsionH X.left (ℓ ^ r) (2 * d)),
          tr_P r (c_P_r (p₁_r u) (p₂_r w)) = tr_X r u * tr_X r w) :=
by
  classical
  suffices hMain : ∀ (N_top : ℕ) (hN_top : N_top = 2 * (2 * d)) (h4d : 2 * d + 2 * d = N_top),
      ∃ (tr_X : ∀ r : ℕ, weilEtaleTorsionH X.left (ℓ ^ r) (2 * d) →+ ZMod (ℓ ^ r))
        (tr_P : ∀ r : ℕ, weilEtaleTorsionH
          (CategoryTheory.Limits.pullback X.hom X.hom) (ℓ ^ r) N_top →+ ZMod (ℓ ^ r)),
        (∀ r : ℕ, Function.Bijective (tr_X r)) ∧
        (∀ (r : ℕ) (u : weilEtaleTorsionH X.left (ℓ ^ (r + 1)) (2 * d)),
          ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r)) (tr_X (r + 1) u) =
            tr_X r (weilEtaleTorsionTransition X.left ℓ r (2 * d) u)) ∧
        (∀ (r : ℕ) (z : weilEtaleTorsionH
            (CategoryTheory.Limits.pullback X.hom X.hom) (ℓ ^ (r + 1)) N_top),
          ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r)) (tr_P (r + 1) z) =
            tr_P r (weilEtaleTorsionTransition
              (CategoryTheory.Limits.pullback X.hom X.hom) ℓ r N_top z)) ∧
        (∀ (r : ℕ)
          (p₁_r p₂_r : weilEtaleTorsionH X.left (ℓ ^ r) (2 * d) →+
            weilEtaleTorsionH (CategoryTheory.Limits.pullback X.hom X.hom) (ℓ ^ r) (2 * d))
          (c_P_r : weilEtaleTorsionH (CategoryTheory.Limits.pullback X.hom X.hom) (ℓ ^ r) (2 * d) →+
            weilEtaleTorsionH (CategoryTheory.Limits.pullback X.hom X.hom) (ℓ ^ r) (2 * d) →+
            weilEtaleTorsionH (CategoryTheory.Limits.pullback X.hom X.hom) (ℓ ^ r) N_top),
          WeilLefschetzTorsionPullback
            (CategoryTheory.Limits.pullback.fst X.hom X.hom) (ℓ ^ r) (2 * d) p₁_r →
          WeilLefschetzTorsionPullback
            (CategoryTheory.Limits.pullback.snd X.hom X.hom) (ℓ ^ r) (2 * d) p₂_r →
