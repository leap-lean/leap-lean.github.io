  let πℤ_π' := weilEtaleConstPullbackHom π'
    (weilEtaleIdTerminalIsTerminal.{u} W'₀) (weilEtaleIdTerminalIsTerminal.{u} P'₀) Aℤ
  haveI : CategoryTheory.IsIso πℤ_π' := hConstIso π'
    (weilEtaleIdTerminalIsTerminal.{u} W'₀) (weilEtaleIdTerminalIsTerminal.{u} P'₀) Aℤ
  let ιℤ_π' : Fℤ_W' ⟶ pb_π'.obj Fℤ_P' := CategoryTheory.inv πℤ_π'

  obtain ⟨ψ_hat_P, Ψ_P, hψ_P_fst, hΨ_P_char, hΨ_P_counit⟩ :=
    hChartPull e_P e_U u_P hu_P u'_P hu'_P hcomm_U_P n
  let z'_P : weilGysinLocalTorsionH P'₀ n V'_P q :=
    (CategoryTheory.Abelian.Ext.mk₀ Ψ_P.hom).postcomp Fℤ_P' (Nat.add_zero q)
