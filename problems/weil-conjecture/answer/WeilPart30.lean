      CategoryTheory.Limits.pullback.lift (cone.fst ≫ U₁.ι) (cone.snd ≫ U₂.ι) (by
        simpa [CategoryTheory.Category.assoc] using cone.condition)
    have hm_P_range (cone : CategoryTheory.Limits.PullbackCone (U₁.ι ≫ X.hom) (U₂.ι ≫ X.hom)) :
