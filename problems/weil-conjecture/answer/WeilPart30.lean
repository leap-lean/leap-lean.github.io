            let w_mor : d₃ ⟶ d₂ := CategoryTheory.InducedCategory.homMk
              (CategoryTheory.MorphismProperty.Over.homMk (v.left ≫ O_eq.ι)
                ((CategoryTheory.Category.assoc v.left O_eq.ι _).trans
                  (CategoryTheory.MorphismProperty.Over.w v)))
            have hw_eq : w_mor ≫ u₁ = w_mor ≫ u₂ := by
              apply G_aff.map_injective
              apply CategoryTheory.MorphismProperty.Over.Hom.ext
              change (v.left ≫ O_eq.ι) ≫ (G_aff.map u₁).left =
                (v.left ≫ O_eq.ι) ≫ (G_aff.map u₂).left
              exact (CategoryTheory.Category.assoc _ _ _).trans
                ((congrArg (v.left ≫ ·) hO_eq_u).trans (CategoryTheory.Category.assoc _ _ _).symm)
            have hm₃ : LiftF.map w_mor δ₃ = δ₂ := Subtype.ext
              ((CategoryTheory.Category.assoc δ₃.1 v.left O_eq.ι).symm.trans
                ((congrArg (· ≫ O_eq.ι) hδ₃).trans hδ_O))
            let j₃ : J_idx := Opposite.op (CategoryTheory.Functor.elementsMk LiftF d₃ δ₃)
            let g₃ : j₂ ⟶ j₃ := Opposite.op ⟨w_mor, hm₃⟩
            refine ⟨j₃, g₃, ?_⟩
            apply Opposite.unop_injective
            ext
            exact congrArg (fun k => k.hom) hw_eq
          · obtain ⟨d₀, _, δ_d₀, _⟩ := hShrink W₀ δ₀ rfl
            exact ⟨Opposite.op (CategoryTheory.Functor.elementsMk LiftF d₀ δ_d₀)⟩
        let D_stalk : J_idx ⥤ ModuleCat.{u, u} R :=
          { obj := fun j => ℱ₂.obj.obj (Opposite.op (G_aff.obj j.unop.1))
            map := fun {_ _} f => ℱ₂.obj.map (G_aff.map f.unop.1).op
            map_id := fun j => by
              change ℱ₂.obj.map (G_aff.map (𝟙 j.unop.1)).op = _
