      have hρ₁_et : ρ₁.Etale := by
        apply RingHom.Etale.of_bijective
        have hcomp₁ : ρ₁_inv.comp ρ₁ = RingHom.id _ := by
          apply MvPolynomial.ringHom_ext
          · intro c
            simp only [RingHom.comp_apply, RingHom.id_apply, ρ₁, MvPolynomial.eval₂Hom_C,
