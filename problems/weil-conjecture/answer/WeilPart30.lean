        rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, CategoryTheory.Limits.pullback.lift_snd]
      exact ⟨by change p₁.base ((m_P_cone cone).base t) ∈ U₁; rw [ht₁]; exact (cone.fst.base t).2,
