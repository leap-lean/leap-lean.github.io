        rw [← map_natCast (ZMod.castHom (pow_dvd_pow ℓ (by omega : a ≤ c)) (ZMod (ℓ ^ a))) v.val,
          ZMod.natCast_zmod_val, hv0]
      obtain ⟨q, hq⟩ := (ZMod.natCast_eq_zero_iff v.val (ℓ ^ a)).mp hv_cast
      have hq_lt : q < ℓ ^ b := by
        have hv_lt : v.val < ℓ ^ a * ℓ ^ b := by
          rw [← pow_add, hab]
          exact ZMod.val_lt v
        rw [hq] at hv_lt
        exact Nat.lt_of_mul_lt_mul_left hv_lt
      refine ⟨ULift.up (q : ZMod (ℓ ^ b)), ?_⟩
      change ULift.up ((ℓ ^ a * (q : ZMod (ℓ ^ b)).val : ℕ) : ZMod (ℓ ^ c)) = ULift.up v
      congr 1
      rw [ZMod.val_natCast, Nat.mod_eq_of_lt hq_lt, ← hq, ZMod.natCast_zmod_val]
    · rw [AddCommGrpCat.mono_iff_injective]
      rintro ⟨u₁⟩ ⟨u₂⟩ h
      have h_eq : ((ℓ ^ a * u₁.val : ℕ) : ZMod (ℓ ^ c)) = ((ℓ ^ a * u₂.val : ℕ) : ZMod (ℓ ^ c)) :=
        ULift.up.inj h
      have hlt₁ : ℓ ^ a * u₁.val < ℓ ^ c := by
        rw [← hab, pow_add]
        exact Nat.mul_lt_mul_of_pos_left (ZMod.val_lt u₁) (pow_pos hℓ_pos a)
      have hlt₂ : ℓ ^ a * u₂.val < ℓ ^ c := by
        rw [← hab, pow_add]
        exact Nat.mul_lt_mul_of_pos_left (ZMod.val_lt u₂) (pow_pos hℓ_pos a)
      have hval := congrArg ZMod.val h_eq
      rw [ZMod.val_natCast, ZMod.val_natCast, Nat.mod_eq_of_lt hlt₁, Nat.mod_eq_of_lt hlt₂] at hval
      have hu_val : u₁.val = u₂.val := Nat.eq_of_mul_eq_mul_left (pow_pos hℓ_pos a) hval
      exact congrArg ULift.up (ZMod.val_injective (ℓ ^ b) hu_val)
    · rw [AddCommGrpCat.epi_iff_surjective]
      rintro ⟨w⟩
      obtain ⟨v, hv⟩ := ZMod.castHom_surjective (pow_dvd_pow ℓ (by omega : a ≤ c)) w
      exact ⟨ULift.up v, congrArg ULift.up hv⟩
  let SC_sh (a b c : ℕ) (hab : a + b = c) := (SC_ab a b c hab).map C
  have hSC_sh_exact (a b c : ℕ) (hab : a + b = c) : (SC_sh a b c hab).ShortExact :=
    (hSC_ab_exact a b c hab).map_of_exact C
  let f_step (r : ℕ) :
      weilEtaleTorsionH S (ℓ ^ r) (m + 1) →+ weilEtaleTorsionH S (ℓ ^ (r + 1)) (m + 1) :=
    (CategoryTheory.Abelian.Ext.mk₀ (C.map (ι_ab 1 r (r + 1) (Nat.add_comm 1 r)))).postcomp
      Fℤ (Nat.add_zero (m + 1))
  let g_gen (a c : ℕ) (hac : a ≤ c) (q : ℕ) :
      weilEtaleTorsionH S (ℓ ^ c) q →+ weilEtaleTorsionH S (ℓ ^ a) q :=
    (CategoryTheory.Abelian.Ext.mk₀ (C.map (π_ab a c hac))).postcomp Fℤ (Nat.add_zero q)
  let δ_map (r s : ℕ) :
      weilEtaleTorsionH S (ℓ ^ r) m →+ weilEtaleTorsionH S (ℓ ^ s) (m + 1) :=
    { toFun := fun u => u.comp (hSC_sh_exact r s (r + s) rfl).extClass rfl
      map_zero' := CategoryTheory.Abelian.Ext.zero_comp _ _ _ _ _
      map_add' := fun u₁ u₂ => CategoryTheory.Abelian.Ext.add_comp u₁ u₂ _ rfl }
  refine ⟨f_step, g_gen, δ_map, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro r q
    rfl
  · intro q x
    have hπ_id : π_ab 1 1 (le_refl 1) = CategoryTheory.CategoryStruct.id (A_M 1) := by
      ext ⟨u⟩
      change ULift.up (ZMod.castHom (pow_dvd_pow ℓ (le_refl 1)) (ZMod (ℓ ^ 1)) u) = ULift.up u
      rw [ZMod.castHom_self, RingHom.id_apply]
    change x.comp (CategoryTheory.Abelian.Ext.mk₀ (C.map (π_ab 1 1 (le_refl 1))))
      (Nat.add_zero q) = x
    rw [hπ_id, C.map_id, CategoryTheory.Abelian.Ext.comp_mk₀_id]
  · intro a b c hab hbc q x
    have hπ_comp : π_ab b c hbc ≫ π_ab a b hab = π_ab a c (le_trans hab hbc) := by
      ext ⟨u⟩
      change ULift.up ((ZMod.castHom (pow_dvd_pow ℓ hab) (ZMod (ℓ ^ a))).comp
        (ZMod.castHom (pow_dvd_pow ℓ hbc) (ZMod (ℓ ^ b))) u) =
        ULift.up (ZMod.castHom (pow_dvd_pow ℓ (le_trans hab hbc)) (ZMod (ℓ ^ a)) u)
      rw [ZMod.castHom_comp]
    change (x.comp (CategoryTheory.Abelian.Ext.mk₀ (C.map (π_ab b c hbc))) (Nat.add_zero q)).comp
      (CategoryTheory.Abelian.Ext.mk₀ (C.map (π_ab a b hab))) (Nat.add_zero q) =
      x.comp (CategoryTheory.Abelian.Ext.mk₀ (C.map (π_ab a c (le_trans hab hbc))))
        (Nat.add_zero q)
    rw [CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero q) (Nat.add_zero 0)
        (by omega),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, ← C.map_comp, hπ_comp]
  · intro r x hx
    exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ Fℤ
      (hSC_sh_exact 1 r (r + 1) (Nat.add_comm 1 r)) x hx
  · intro r w
    have h_comm_ab :
        π_ab r (r + 1) (Nat.le_succ r) ≫ ι_ab 1 r (r + 1) (Nat.add_comm 1 r) =
          ι_ab 1 (r + 1) (r + 2) (Nat.add_comm 1 (r + 1)) ≫
            π_ab (r + 1) (r + 2) (Nat.le_succ (r + 1)) := by
      have := hNeZero r
      have := hNeZero (r + 1)
      have := hNeZero (r + 2)
      ext ⟨u⟩
      change ULift.up ((ℓ ^ 1 * (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r)) u).val : ℕ) :
          ZMod (ℓ ^ (r + 1))) =
        ULift.up (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1)))
          ((ℓ ^ 1 * u.val : ℕ) : ZMod (ℓ ^ (r + 2))))
      congr 1
      have hcast_u : ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r)) u =
          ((ZMod.val u : ℕ) : ZMod (ℓ ^ r)) := by
        conv_lhs => rw [← ZMod.natCast_zmod_val u]
        rw [map_natCast]
      rw [hcast_u, ZMod.val_natCast, map_natCast]
      let n_u : ℕ := ZMod.val u
      change ((ℓ ^ 1 * (n_u % ℓ ^ r) : ℕ) : ZMod (ℓ ^ (r + 1))) =
        ((ℓ ^ 1 * n_u : ℕ) : ZMod (ℓ ^ (r + 1)))
      have hdiv := Nat.div_add_mod n_u (ℓ ^ r)
      have hmul : ℓ ^ (r + 1) * (n_u / ℓ ^ r) + ℓ ^ 1 * (n_u % ℓ ^ r) = ℓ ^ 1 * n_u := by
        calc
          ℓ ^ (r + 1) * (n_u / ℓ ^ r) + ℓ ^ 1 * (n_u % ℓ ^ r)
            = ℓ ^ 1 * (ℓ ^ r * (n_u / ℓ ^ r) + n_u % ℓ ^ r) := by
              rw [pow_succ]; ring
          _ = ℓ ^ 1 * n_u := by rw [hdiv]
      have hmod := congrArg (fun n : ℕ => (n : ZMod (ℓ ^ (r + 1)))) hmul
      simp only [Nat.cast_add, Nat.cast_mul, CharP.cast_eq_zero, zero_mul, zero_add] at hmod
      simpa only [Nat.cast_mul] using hmod
    change (w.comp (CategoryTheory.Abelian.Ext.mk₀ (C.map (π_ab r (r + 1) (Nat.le_succ r))))
        (Nat.add_zero (m + 1))).comp
        (CategoryTheory.Abelian.Ext.mk₀ (C.map (ι_ab 1 r (r + 1) (Nat.add_comm 1 r))))
        (Nat.add_zero (m + 1)) =
      (w.comp (CategoryTheory.Abelian.Ext.mk₀
        (C.map (ι_ab 1 (r + 1) (r + 2) (Nat.add_comm 1 (r + 1)))))
        (Nat.add_zero (m + 1))).comp
        (CategoryTheory.Abelian.Ext.mk₀ (C.map (π_ab (r + 1) (r + 2) (Nat.le_succ (r + 1)))))
        (Nat.add_zero (m + 1))
    rw [CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero (m + 1)) (Nat.add_zero 0) (by omega),
      CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero (m + 1)) (Nat.add_zero 0) (by omega),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
      ← C.map_comp, ← C.map_comp, h_comm_ab]
  · intro r y
    have h_ell_ab :
        π_ab r (r + 1) (Nat.le_succ r) ≫ ι_ab 1 r (r + 1) (Nat.add_comm 1 r) =
          ℓ • CategoryTheory.CategoryStruct.id (A_M (r + 1)) := by
      have := hNeZero r
      have := hNeZero (r + 1)
      ext ⟨v⟩
      change ULift.up ((ℓ ^ 1 * (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r)) v).val : ℕ) :
          ZMod (ℓ ^ (r + 1))) = ULift.up (ℓ • v)
      congr 1
      have hcast_v : ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r)) v =
          ((ZMod.val v : ℕ) : ZMod (ℓ ^ r)) := by
        conv_lhs => rw [← ZMod.natCast_zmod_val v]
        rw [map_natCast]
      rw [hcast_v, ZMod.val_natCast]
      let n_v : ℕ := ZMod.val v
      have hdiv := Nat.div_add_mod n_v (ℓ ^ r)
      have hmul : ℓ ^ (r + 1) * (n_v / ℓ ^ r) + ℓ ^ 1 * (n_v % ℓ ^ r) = ℓ * n_v := by
        calc
          ℓ ^ (r + 1) * (n_v / ℓ ^ r) + ℓ ^ 1 * (n_v % ℓ ^ r)
            = ℓ * (ℓ ^ r * (n_v / ℓ ^ r) + n_v % ℓ ^ r) := by
              rw [pow_succ, pow_one]; ring
          _ = ℓ * n_v := by rw [hdiv]
      have hmod := congrArg (fun n : ℕ => (n : ZMod (ℓ ^ (r + 1)))) hmul
      simp only [Nat.cast_add, Nat.cast_mul, CharP.cast_eq_zero, zero_mul, zero_add] at hmod
      change ((ℓ ^ 1 * (n_v % ℓ ^ r) : ℕ) : ZMod (ℓ ^ (r + 1))) = ℓ • v
      rw [Nat.cast_mul, hmod, nsmul_eq_mul, ZMod.natCast_zmod_val]
    change (y.comp (CategoryTheory.Abelian.Ext.mk₀ (C.map (π_ab r (r + 1) (Nat.le_succ r))))
        (Nat.add_zero (m + 1))).comp
        (CategoryTheory.Abelian.Ext.mk₀ (C.map (ι_ab 1 r (r + 1) (Nat.add_comm 1 r))))
        (Nat.add_zero (m + 1)) = ℓ • y
    rw [CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero (m + 1)) (Nat.add_zero 0) (by omega),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, ← C.map_comp, h_ell_ab, C.map_nsmul, C.map_id]
    exact hExt_nsmul (F_M (r + 1)) (m + 1) ℓ y
  · intro r s u
    have hsq1 :
        C.map (π_ab s (s + 1) (Nat.le_succ s)) ≫ C.map (ι_ab r s (r + s) rfl) =
          C.map (ι_ab r (s + 1) (r + (s + 1)) rfl) ≫
            C.map (π_ab (r + s) (r + (s + 1)) (Nat.add_le_add_left (Nat.le_succ s) r)) := by
      rw [← C.map_comp, ← C.map_comp]
      congr 1
      have := hNeZero s
      have := hNeZero (s + 1)
      have := hNeZero (r + s)
      have := hNeZero (r + (s + 1))
      ext ⟨w⟩
      change ULift.up ((ℓ ^ r * (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ s)) (ZMod (ℓ ^ s)) w).val : ℕ) :
          ZMod (ℓ ^ (r + s))) =
        ULift.up (ZMod.castHom (pow_dvd_pow ℓ (Nat.add_le_add_left (Nat.le_succ s) r))
          (ZMod (ℓ ^ (r + s))) ((ℓ ^ r * w.val : ℕ) : ZMod (ℓ ^ (r + (s + 1)))))
      congr 1
      have hcast_w : ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ s)) (ZMod (ℓ ^ s)) w =
          ((ZMod.val w : ℕ) : ZMod (ℓ ^ s)) := by
        conv_lhs => rw [← ZMod.natCast_zmod_val w]
        rw [map_natCast]
      rw [hcast_w, ZMod.val_natCast, map_natCast]
      let n_w : ℕ := ZMod.val w
      change ((ℓ ^ r * (n_w % ℓ ^ s) : ℕ) : ZMod (ℓ ^ (r + s))) =
        ((ℓ ^ r * n_w : ℕ) : ZMod (ℓ ^ (r + s)))
      have hdiv := Nat.div_add_mod n_w (ℓ ^ s)
      have hmul : ℓ ^ (r + s) * (n_w / ℓ ^ s) + ℓ ^ r * (n_w % ℓ ^ s) = ℓ ^ r * n_w := by
        calc
          ℓ ^ (r + s) * (n_w / ℓ ^ s) + ℓ ^ r * (n_w % ℓ ^ s)
            = ℓ ^ r * (ℓ ^ s * (n_w / ℓ ^ s) + n_w % ℓ ^ s) := by
              rw [pow_add]; ring
          _ = ℓ ^ r * n_w := by rw [hdiv]
      have hmod := congrArg (fun n : ℕ => (n : ZMod (ℓ ^ (r + s)))) hmul
      simp only [Nat.cast_add, Nat.cast_mul, CharP.cast_eq_zero, zero_mul, zero_add] at hmod
      simpa only [Nat.cast_mul] using hmod
    have hsq2 :
        C.map (π_ab (r + s) (r + (s + 1)) (Nat.add_le_add_left (Nat.le_succ s) r)) ≫
            C.map (π_ab r (r + s) (by omega)) =
          C.map (π_ab r (r + (s + 1)) (by omega)) ≫
            CategoryTheory.CategoryStruct.id (F_M r) := by
      rw [CategoryTheory.Category.comp_id, ← C.map_comp]
      congr 1
      ext ⟨w⟩
      change ULift.up ((ZMod.castHom (pow_dvd_pow ℓ (by omega : r ≤ r + s)) (ZMod (ℓ ^ r))).comp
        (ZMod.castHom (pow_dvd_pow ℓ (Nat.add_le_add_left (Nat.le_succ s) r))
          (ZMod (ℓ ^ (r + s)))) w) =
        ULift.up (ZMod.castHom (pow_dvd_pow ℓ (by omega : r ≤ r + (s + 1))) (ZMod (ℓ ^ r)) w)
      rw [ZMod.castHom_comp]
    let φ_sh : SC_sh r (s + 1) (r + (s + 1)) rfl ⟶ SC_sh r s (r + s) rfl :=
      CategoryTheory.ShortComplex.homMk
        (C.map (π_ab s (s + 1) (Nat.le_succ s)))
        (C.map (π_ab (r + s) (r + (s + 1)) (Nat.add_le_add_left (Nat.le_succ s) r)))
        (CategoryTheory.CategoryStruct.id (F_M r))
        hsq1 hsq2
    have hnat := CategoryTheory.ShortComplex.ShortExact.extClass_naturality
      (hSC_sh_exact r (s + 1) (r + (s + 1)) rfl)
      (hSC_sh_exact r s (r + s) rfl) φ_sh
    change (u.comp (hSC_sh_exact r (s + 1) (r + (s + 1)) rfl).extClass rfl).comp
        (CategoryTheory.Abelian.Ext.mk₀ (C.map (π_ab s (s + 1) (Nat.le_succ s))))
        (Nat.add_zero (m + 1)) =
      u.comp (hSC_sh_exact r s (r + s) rfl).extClass rfl
    rw [CategoryTheory.Abelian.Ext.comp_assoc _ _ _ rfl (Nat.add_zero 1) (by omega)]
    change u.comp ((hSC_sh_exact r (s + 1) (r + (s + 1)) rfl).extClass.comp
        (CategoryTheory.Abelian.Ext.mk₀ φ_sh.τ₁) (Nat.add_zero 1)) rfl = _
    rw [hnat]
    change u.comp ((CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id (F_M r))).comp
        (hSC_sh_exact r s (r + s) rfl).extClass (Nat.zero_add 1)) rfl = _
    rw [CategoryTheory.Abelian.Ext.mk₀_id_comp]
  · intro r s u hu
    exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ Fℤ
      (hSC_sh_exact r s (r + s) rfl) u rfl hu

theorem weil_lefschetz_abstract_konig_uniform_torsion_lift (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (H : ℕ → ℕ → Type u) [∀ r q : ℕ, AddCommGroup (H r q)]
    (hH_fin : ∀ (q r : ℕ), Finite (H r q))
    (hH_tors : ∀ (r q : ℕ) (w : H r q), (ℓ ^ r) • w = 0)
    (trans : ∀ (r q : ℕ), H (r + 1) q →+ H r q)
    (m : ℕ)
    (f_step : ∀ r : ℕ, H r (m + 1) →+ H (r + 1) (m + 1))
    (g_gen : ∀ (a c : ℕ), a ≤ c → ∀ q : ℕ, H c q →+ H a q)
    (δ_map : ∀ (r s : ℕ), H r m →+ H s (m + 1))
    (hg_step : ∀ (r q : ℕ), g_gen r (r + 1) (Nat.le_succ r) q = trans r q)
    (hg_id : ∀ (q : ℕ) (x : H 1 q), g_gen 1 1 (le_refl 1) q x = x)
    (hg_comp : ∀ (a b c : ℕ) (hab : a ≤ b) (hbc : b ≤ c) (q : ℕ) (x : H c q),
      g_gen a b hab q (g_gen b c hbc q x) = g_gen a c (le_trans hab hbc) q x)
    (hf_exact : ∀ (r : ℕ) (x : H (r + 1) (m + 1)),
      g_gen 1 (r + 1) (Nat.le_add_left 1 r) (m + 1) x = 0 →
      ∃ w : H r (m + 1), f_step r w = x)
    (hf_comm : ∀ (r : ℕ) (w : H (r + 1) (m + 1)),
      f_step r (trans r (m + 1) w) = trans (r + 1) (m + 1) (f_step (r + 1) w))
    (hf_mul_ell : ∀ (r : ℕ) (y : H (r + 1) (m + 1)),
      f_step r (g_gen r (r + 1) (Nat.le_succ r) (m + 1) y) = ℓ • y)
    (hδ_compat : ∀ (r s : ℕ) (u : H r m),
      trans s (m + 1) (δ_map r (s + 1) u) = δ_map r s u)
    (hδ_exact : ∀ (r s : ℕ) (u : H r m),
      δ_map r s u = 0 →
      ∃ c : H (r + s) m, g_gen r (r + s) (Nat.le_add_right r s) m c = u) :
    ∃ N : ℕ, ∀ (r : ℕ) (b : H r m),
      ∃ y : ∀ q : ℕ, H q m, (∀ q : ℕ, trans q m (y (q + 1)) = y q) ∧ y r = (ℓ ^ N) • b :=
by
  classical
  have h_konig : ∀ (E : ℕ → Type u),
      (∀ n : ℕ, Finite (E n)) →
      (∀ n : ℕ, Nonempty (E n)) →
      ∀ (τ : ∀ n : ℕ, E (n + 1) → E n),
        ∃ s : ∀ n : ℕ, E n, ∀ n : ℕ, τ n (s (n + 1)) = s n := by
    intro E hFinE hNonE τ
    let F : CategoryTheory.Functor ℕᵒᵖ (Type u) :=
      CategoryTheory.Functor.ofOpSequence (X := E) (fun n => TypeCat.ofHom (τ n))
    have : ∀ j : ℕᵒᵖ, Finite (F.obj j) := fun j => by
      dsimp [F]
      exact hFinE j.unop
    have : ∀ j : ℕᵒᵖ, Nonempty (F.obj j) := fun j => by
      dsimp [F]
      exact hNonE j.unop
    obtain ⟨sec, hsec⟩ := nonempty_sections_of_finite_inverse_system F
    refine ⟨fun n => sec (Opposite.op n), fun n => ?_⟩
    have hn := hsec (CategoryTheory.homOfLE (Nat.le_succ n)).op
    have hmap := CategoryTheory.Functor.ofOpSequence_map_homOfLE_succ
      (X := E) (fun k => TypeCat.ofHom (τ k)) n
    dsimp [F] at hn
    rw [hmap] at hn
    exact hn
  have hz0 : ∀ (q : ℕ) (w : H 0 q), w = 0 := by
    intro q w
    have h := hH_tors 0 q w
    simpa using h
  let IsCompat₁ (x : ∀ r : ℕ, H r (m + 1)) : Prop :=
    ∀ r : ℕ, trans r (m + 1) (x (r + 1)) = x r
  have h_div_ell : ∀ x : ∀ r : ℕ, H r (m + 1),
      IsCompat₁ x → x 1 = 0 →
      ∃ y : ∀ r : ℕ, H r (m + 1), IsCompat₁ y ∧ ℓ • y = x := by
    intro x hx hx1
    have hg1 : ∀ r : ℕ, g_gen 1 (r + 1) (Nat.le_add_left 1 r) (m + 1) (x (r + 1)) = x 1 := by
      intro r
      induction r with
      | zero => exact hg_id (m + 1) (x 1)
      | succ r ih =>
        have hc := hg_comp 1 (r + 1) (r + 2) (Nat.le_add_left 1 r) (Nat.le_succ (r + 1))
          (m + 1) (x (r + 2))
        rw [hg_step (r + 1) (m + 1), hx (r + 1), ih] at hc
        exact hc.symm
    let E (r : ℕ) : Type u := { w : H r (m + 1) // f_step r w = x (r + 1) }
    have hE_fin : ∀ r : ℕ, Finite (E r) := fun r => by
      have := hH_fin (m + 1) r
      exact Subtype.finite
    have hE_non : ∀ r : ℕ, Nonempty (E r) := fun r => by
      have h0 : g_gen 1 (r + 1) (Nat.le_add_left 1 r) (m + 1) (x (r + 1)) = 0 :=
        (hg1 r).trans hx1
      obtain ⟨w, hw⟩ := hf_exact r (x (r + 1)) h0
      exact ⟨⟨w, hw⟩⟩
    let τ_E (r : ℕ) (e : E (r + 1)) : E r :=
      ⟨trans r (m + 1) e.1, by rw [hf_comm r e.1, e.2, hx (r + 1)]⟩
    obtain ⟨sec, hsec⟩ := h_konig E hE_fin hE_non τ_E
    let y : ∀ r : ℕ, H r (m + 1) := fun r => (sec r).1
    have hy_compat : IsCompat₁ y := fun r => congrArg Subtype.val (hsec r)
    refine ⟨y, hy_compat, ?_⟩
    funext r
    cases r with
    | zero => exact (hz0 (m + 1) ((ℓ • y) 0)).trans (hz0 (m + 1) (x 0)).symm
    | succ r =>
      change ℓ • y (r + 1) = x (r + 1)
      have h1 : f_step r (y r) = x (r + 1) := (sec r).2
      have h2 : y r = g_gen r (r + 1) (Nat.le_succ r) (m + 1) (y (r + 1)) := by
        rw [hg_step r (m + 1)]
        exact (hy_compat r).symm
      rw [← h1, h2, hf_mul_ell r (y (r + 1))]
  let IsEllTors₁ (x : ∀ r : ℕ, H r (m + 1)) : Prop :=
    IsCompat₁ x ∧ ∃ k : ℕ, (ℓ ^ k) • x = 0
  let T_sub := { x : ∀ r : ℕ, H r (m + 1) // IsEllTors₁ x }
  have hT_sub : ∀ x₁ x₂ : T_sub, IsEllTors₁ (x₁.1 - x₂.1) := by
    intro x₁ x₂
    obtain ⟨k₁, hk₁⟩ := x₁.2.2
    obtain ⟨k₂, hk₂⟩ := x₂.2.2
    refine ⟨fun r => ?_, k₁ + k₂, ?_⟩
    · change trans r (m + 1) (x₁.1 (r + 1) - x₂.1 (r + 1)) = x₁.1 r - x₂.1 r
      rw [map_sub, x₁.2.1 r, x₂.2.1 r]
    · rw [smul_sub]
      have h1 : (ℓ ^ (k₁ + k₂)) • x₁.1 = 0 := by
        rw [pow_add, mul_comm, mul_smul, hk₁, smul_zero]
      have h2 : (ℓ ^ (k₁ + k₂)) • x₂.1 = 0 := by
        rw [pow_add, mul_smul, hk₂, smul_zero]
      rw [h1, h2, sub_zero]
  let ev₁ : T_sub → H 1 (m + 1) := fun x => x.1 1
  let I := Set.range ev₁
  have : Finite (H 1 (m + 1)) := hH_fin (m + 1) 1
  have : Finite ↥I := Subtype.finite
  let _ : Fintype ↥I := Fintype.ofFinite ↥I
  let rep (u : ↥I) : T_sub := u.2.choose
  have hrep_ev (u : ↥I) : (rep u).1 1 = u.1 := u.2.choose_spec
  let k_rep (u : ↥I) : ℕ := (rep u).2.2.choose
  have hk_rep (u : ↥I) : (ℓ ^ k_rep u) • (rep u).1 = 0 := (rep u).2.2.choose_spec
  let N : ℕ := Finset.univ.sup k_rep
  have hN_rep : ∀ u : ↥I, (ℓ ^ N) • (rep u).1 = 0 := by
    intro u
    have hle : k_rep u ≤ N := Finset.le_sup (f := k_rep) (Finset.mem_univ u)
    have hN_eq : N = (N - k_rep u) + k_rep u := (Nat.sub_add_cancel hle).symm
    rw [hN_eq, pow_add, mul_smul, hk_rep u, smul_zero]
  have hN_step : ∀ x : T_sub, ∃ y : T_sub, (ℓ ^ N) • x.1 = ℓ • ((ℓ ^ N) • y.1) := by
    intro x
    let u : ↥I := ⟨x.1 1, ⟨x, rfl⟩⟩
    have hd_tors : IsEllTors₁ (x.1 - (rep u).1) := hT_sub x (rep u)
    have hd1 : (x.1 - (rep u).1) 1 = 0 := by
      change x.1 1 - (rep u).1 1 = 0
      rw [hrep_ev u, sub_self]
    obtain ⟨y₀, hy₀_compat, hy₀_eq⟩ := h_div_ell (x.1 - (rep u).1) hd_tors.1 hd1
    obtain ⟨k_d, hk_d⟩ := hd_tors.2
    have hy₀_tors : IsEllTors₁ y₀ := by
      refine ⟨hy₀_compat, k_d + 1, ?_⟩
      rw [pow_succ, mul_smul, hy₀_eq, hk_d]
    refine ⟨⟨y₀, hy₀_tors⟩, ?_⟩
    have hx_eq : x.1 = (rep u).1 + ℓ • y₀ := by
      rw [hy₀_eq, add_sub_cancel]
    calc
      (ℓ ^ N) • x.1 = (ℓ ^ N) • ((rep u).1 + ℓ • y₀) := by rw [hx_eq]
      _ = (ℓ ^ N) • (rep u).1 + (ℓ ^ N) • (ℓ • y₀) := smul_add (ℓ ^ N) _ _
      _ = ℓ • ((ℓ ^ N) • y₀) := by rw [hN_rep u, zero_add, smul_comm]
  have hN_iter : ∀ (n : ℕ) (x : T_sub), ∃ y : T_sub, (ℓ ^ N) • x.1 = (ℓ ^ n) • ((ℓ ^ N) • y.1) := by
    intro n
    induction n with
    | zero =>
      intro x
      exact ⟨x, by simp⟩
    | succ n ih =>
      intro x
      obtain ⟨y₀, hy₀⟩ := ih x
      obtain ⟨y₁, hy₁⟩ := hN_step y₀
      refine ⟨y₁, ?_⟩
      rw [hy₀, hy₁, ← mul_smul, ← pow_succ]
  have hN_kill : ∀ x : T_sub, (ℓ ^ N) • x.1 = 0 := by
    intro x
    funext r
    obtain ⟨y_r, hy_r⟩ := hN_iter r x
    have hr := congrFun hy_r r
    change ((ℓ ^ N) • x.1) r = 0
    rw [hr]
    exact hH_tors r (m + 1) (((ℓ ^ N) • y_r.1) r)
  refine ⟨N, fun r b => ?_⟩
  let Δ_b : ∀ s : ℕ, H s (m + 1) := fun s => δ_map r s b
  have hΔ_tors : IsEllTors₁ Δ_b := by
    refine ⟨fun s => hδ_compat r s b, r, ?_⟩
    funext s
    change (ℓ ^ r) • δ_map r s b = 0
    rw [← map_nsmul, hH_tors r m b, map_zero]
  have hΔ_kill : (ℓ ^ N) • Δ_b = 0 := hN_kill ⟨Δ_b, hΔ_tors⟩
  have hδ_b : ∀ s : ℕ, δ_map r s ((ℓ ^ N) • b) = 0 := by
    intro s
    rw [map_nsmul]
    exact congrFun hΔ_kill s
  let K_fib (s : ℕ) : Type u :=
    { c : H (r + s) m // g_gen r (r + s) (Nat.le_add_right r s) m c = (ℓ ^ N) • b }
  have hK_fin : ∀ s : ℕ, Finite (K_fib s) := fun s => by
    have := hH_fin m (r + s)
    exact Subtype.finite
  have hK_non : ∀ s : ℕ, Nonempty (K_fib s) := fun s => by
    obtain ⟨c, hc⟩ := hδ_exact r s ((ℓ ^ N) • b) (hδ_b s)
    exact ⟨⟨c, hc⟩⟩
  let τ_K (s : ℕ) (c : K_fib (s + 1)) : K_fib s :=
    ⟨trans (r + s) m c.1, by
      rw [← hg_step (r + s) m, hg_comp r (r + s) (r + s + 1)
        (Nat.le_add_right r s) (Nat.le_succ (r + s)) m c.1]
      exact c.2⟩
  obtain ⟨c_sec, hc_sec⟩ := h_konig K_fib hK_fin hK_non τ_K
  let eval_sec (q s : ℕ) (hqs : q ≤ r + s) : H q m :=
    g_gen q (r + s) hqs m (c_sec s).1
  have heval_step : ∀ (q s : ℕ) (hqs : q ≤ r + s),
      eval_sec q (s + 1) (le_trans hqs (Nat.le_succ (r + s))) = eval_sec q s hqs := by
    intro q s hqs
    have hc : trans (r + s) m (c_sec (s + 1)).1 = (c_sec s).1 :=
      congrArg Subtype.val (hc_sec s)
    change g_gen q (r + s + 1) (le_trans hqs (Nat.le_succ (r + s))) m (c_sec (s + 1)).1 =
      g_gen q (r + s) hqs m (c_sec s).1
    rw [← hc, ← hg_step (r + s) m,
      hg_comp q (r + s) (r + s + 1) hqs (Nat.le_succ (r + s)) m (c_sec (s + 1)).1]
  let y_fun (q : ℕ) : H q m := eval_sec q q (Nat.le_add_left q r)
  refine ⟨y_fun, ?_, ?_⟩
  · intro q
    dsimp [y_fun, eval_sec]
    rw [← hg_step q m, hg_comp q (q + 1) (r + (q + 1))
      (Nat.le_succ q) (Nat.le_add_left (q + 1) r) m (c_sec (q + 1)).1]
    exact heval_step q q (Nat.le_add_left q r)
  · have heval_r : ∀ d : ℕ, eval_sec r d (Nat.le_add_right r d) =
        eval_sec r 0 (Nat.le_add_right r 0) := by
      intro d
      induction d with
      | zero => rfl
      | succ d ih =>
        exact (heval_step r d (Nat.le_add_right r d)).trans ih
    change eval_sec r r (Nat.le_add_left r r) = (ℓ ^ N) • b
    have hrr : eval_sec r r (Nat.le_add_left r r) = eval_sec r r (Nat.le_add_right r r) := rfl
    rw [hrr, heval_r r]
    exact (c_sec 0).2

theorem weil_lefschetz_padic_trace_functional_of_integral_lattice (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    {L_type : Type u} [AddCommMonoid L_type] [Module ℤ L_type]
    (V : Type u) [AddCommGroup V] [Module (Padic ℓ) V]
    (eV : TensorProduct ℤ ℚ L_type ≃+ V)
    (tr_L : ∀ r : ℕ, L_type → ZMod (ℓ ^ r))
    (htr_zero : ∀ r : ℕ, tr_L r 0 = 0)
    (htr_add : ∀ (r : ℕ) (x₁ x₂ : L_type), tr_L r (x₁ + x₂) = tr_L r x₁ + tr_L r x₂)
    (htr_compat : ∀ (r : ℕ) (x : L_type),
      ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r)) (tr_L (r + 1) x) = tr_L r x)
    (h_smul : ∀ (z : PadicInt ℓ) (x : L_type),
      ∃ y : L_type,
        (∀ r : ℕ, tr_L r y = PadicInt.toZModPow r z * tr_L r x) ∧
        eV (TensorProduct.tmul ℤ (1 : ℚ) y) =
          (z : Padic ℓ) • eV (TensorProduct.tmul ℤ (1 : ℚ) x)) :
    ∃ (η : V →ₗ[Padic ℓ] Padic ℓ) (tr_tilde : L_type →+ PadicInt ℓ),
      (∀ (x : L_type) (r : ℕ), PadicInt.toZModPow r (tr_tilde x) = tr_L r x) ∧
      (∀ x : L_type, η (eV (TensorProduct.tmul ℤ (1 : ℚ) x)) = (tr_tilde x : Padic ℓ)) :=
by
  have clear_den_rat_tensor : ∀ t : TensorProduct ℤ ℚ L_type,
      ∃ M : ℕ, 1 ≤ M ∧ ∃ x : L_type, M • t = TensorProduct.tmul ℤ (1 : ℚ) x := by
    intro t
    refine TensorProduct.inductionOn t ?_ ?_
    · intro q x₀
      refine ⟨q.den, q.pos, q.num • x₀, ?_⟩
      have hq : (q.den : ℤ) • q = q.num • (1 : ℚ) := by
        rw [zsmul_eq_mul, Int.cast_natCast, mul_comm, Rat.mul_den_eq_num, zsmul_one]
      rw [← natCast_zsmul, TensorProduct.smul_tmul', hq, TensorProduct.smul_tmul]
    · intro t₁ t₂ ⟨M₁, hM₁, x₁, hx₁⟩ ⟨M₂, hM₂, x₂, hx₂⟩
      refine ⟨M₁ * M₂, Nat.mul_pos hM₁ hM₂, M₂ • x₁ + M₁ • x₂, ?_⟩
      have hp1 : M₂ • TensorProduct.tmul ℤ (1 : ℚ) x₁ = TensorProduct.tmul ℤ (1 : ℚ) (M₂ • x₁) :=
        (map_nsmul (TensorProduct.mk ℤ ℚ L_type (1 : ℚ)) M₂ x₁).symm
      have hp2 : M₁ • TensorProduct.tmul ℤ (1 : ℚ) x₂ = TensorProduct.tmul ℤ (1 : ℚ) (M₁ • x₂) :=
        (map_nsmul (TensorProduct.mk ℤ ℚ L_type (1 : ℚ)) M₁ x₂).symm
      rw [smul_add, mul_comm M₁ M₂, mul_smul, hx₁, mul_comm M₂ M₁, mul_smul, hx₂,
        hp1, hp2, TensorProduct.tmul_add]
  have h_lift : ∀ a : ∀ k : ℕ, ZMod (ℓ ^ k),
      (∀ k : ℕ, ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ k)) (ZMod (ℓ ^ k)) (a (k + 1)) = a k) →
      ∃ z : PadicInt ℓ, ∀ k : ℕ, PadicInt.toZModPow k z = a k := by
    intro a ha_step
    have ha_le : ∀ (k₁ k₂ : ℕ) (hk : k₁ ≤ k₂),
        ZMod.castHom (pow_dvd_pow ℓ hk) (ZMod (ℓ ^ k₁)) (a k₂) = a k₁ := by
      intro k₁ k₂ hk
      induction hk with
      | refl => rw [ZMod.castHom_self, RingHom.id_apply]
      | @step m hkm ih =>
        rw [← ih, ← ha_step m, ← RingHom.comp_apply, ZMod.castHom_comp]
    let f (k : ℕ) : Polynomial ℤ →+* ZMod (ℓ ^ k) :=
      Polynomial.eval₂RingHom (Int.castRingHom (ZMod (ℓ ^ k))) (a k)
    have hf_compat : ∀ (k₁ k₂ : ℕ) (hk : k₁ ≤ k₂),
        (ZMod.castHom (pow_dvd_pow ℓ hk) (ZMod (ℓ ^ k₁))).comp (f k₂) = f k₁ := by
      intro k₁ k₂ hk
      apply Polynomial.ringHom_ext'
      · ext n
        simp [f]
      · simp [f, ha_le k₁ k₂ hk]
    refine ⟨PadicInt.lift hf_compat Polynomial.X, fun k => ?_⟩
    have hspec := RingHom.congr_fun (PadicInt.lift_spec hf_compat k) Polynomial.X
    simpa [f] using hspec
  have htr_seq : ∀ x : L_type, ∃ z : PadicInt ℓ, ∀ r : ℕ, PadicInt.toZModPow r z = tr_L r x :=
    fun x => h_lift (fun r => tr_L r x) (fun r => htr_compat r x)
  let tr_tilde : L_type →+ PadicInt ℓ :=
    { toFun := fun x => (htr_seq x).choose
      map_zero' := by
        rw [← PadicInt.ext_of_toZModPow]
        intro r
        rw [(htr_seq 0).choose_spec r, htr_zero r, map_zero]
      map_add' := fun x₁ x₂ => by
        rw [← PadicInt.ext_of_toZModPow]
        intro r
        rw [(htr_seq (x₁ + x₂)).choose_spec r, htr_add r x₁ x₂, map_add,
          (htr_seq x₁).choose_spec r, (htr_seq x₂).choose_spec r] }
  have htr_spec : ∀ (x : L_type) (r : ℕ), PadicInt.toZModPow r (tr_tilde x) = tr_L r x :=
    fun x r => (htr_seq x).choose_spec r
  have htr_zsmul : ∀ (n : ℤ) (x : L_type), tr_tilde (n • x) = n • tr_tilde x := by
    have htr_nat : ∀ (k : ℕ) (x : L_type), tr_tilde ((k : ℤ) • x) = (k : ℤ) • tr_tilde x := by
      intro k x
      induction k with
      | zero => simp
      | succ k ih =>
        push_cast
        rw [add_smul, one_smul, map_add, ih, add_smul, one_smul]
    intro n x
    cases n with
    | ofNat k => exact htr_nat k x
    | negSucc k =>
      change tr_tilde (-((k + 1 : ℕ) : ℤ) • x) = (-((k + 1 : ℕ) : ℤ)) • tr_tilde x
      have hsum : tr_tilde (-((k + 1 : ℕ) : ℤ) • x) + tr_tilde (((k + 1 : ℕ) : ℤ) • x) = 0 := by
        rw [← map_add, ← add_smul, neg_add_cancel, zero_smul, map_zero]
      rw [htr_nat (k + 1) x] at hsum
      rw [neg_smul]
      exact eq_neg_of_add_eq_zero_left hsum
  let bil_x (q : ℚ) : L_type →ₗ[ℤ] Padic ℓ :=
    { toFun := fun x => (q : Padic ℓ) * (tr_tilde x : Padic ℓ)
      map_add' := fun x₁ x₂ => by
        rw [map_add, PadicInt.coe_add, mul_add]
      map_smul' := fun n x => by
        dsimp only [RingHom.id_apply]
        rw [htr_zsmul n x, zsmul_eq_mul, zsmul_eq_mul]
        push_cast
        ring }
  let bil : ℚ →ₗ[ℤ] L_type →ₗ[ℤ] Padic ℓ :=
    { toFun := bil_x
      map_add' := fun q₁ q₂ => by
        ext x
        dsimp [bil_x]
        push_cast
        ring
      map_smul' := fun n q => by
        ext x
        dsimp [bil_x]
        rw [zsmul_eq_mul, zsmul_eq_mul]
        push_cast
        ring }
  let η_tp : TensorProduct ℤ ℚ L_type →ₗ[ℤ] Padic ℓ := TensorProduct.lift bil
  let η₀ : V →+ Padic ℓ := η_tp.toAddMonoidHom.comp eV.symm.toAddMonoidHom
  have hη₀_gen : ∀ x : L_type, η₀ (eV (TensorProduct.tmul ℤ (1 : ℚ) x)) = (tr_tilde x : Padic ℓ) := by
    intro x
    change η_tp (eV.symm (eV (TensorProduct.tmul ℤ (1 : ℚ) x))) = _
    rw [eV.symm_apply_apply]
    change bil (1 : ℚ) x = _
    dsimp [bil, bil_x]
    rw [Rat.cast_one, one_mul]
  have hη₀_int_gen : ∀ (z : PadicInt ℓ) (x : L_type),
      η₀ ((z : Padic ℓ) • eV (TensorProduct.tmul ℤ (1 : ℚ) x)) =
        (z : Padic ℓ) * η₀ (eV (TensorProduct.tmul ℤ (1 : ℚ) x)) := by
    intro z x
    obtain ⟨y, hy_tr, hy_smul⟩ := h_smul z x
    have htr_y : tr_tilde y = z * tr_tilde x := by
      rw [← PadicInt.ext_of_toZModPow]
      intro r
      rw [htr_spec y r, map_mul, htr_spec x r, hy_tr r]
    rw [← hy_smul, hη₀_gen y, hη₀_gen x, htr_y, PadicInt.coe_mul]
  have hη₀_int : ∀ (z : PadicInt ℓ) (v : V),
      η₀ ((z : Padic ℓ) • v) = (z : Padic ℓ) * η₀ v := by
    intro z v
    obtain ⟨M, hM, x, hx⟩ := clear_den_rat_tensor (eV.symm v)
    have hMv : M • v = eV (TensorProduct.tmul ℤ (1 : ℚ) x) := by
      rw [← hx, map_nsmul, eV.apply_symm_apply]
    have hM_ne : (M : Padic ℓ) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
    apply mul_left_cancel₀ hM_ne
    have h1 : (M : Padic ℓ) * η₀ ((z : Padic ℓ) • v) = (z : Padic ℓ) * η₀ (M • v) := by
      rw [← nsmul_eq_mul, ← map_nsmul, smul_comm M (z : Padic ℓ) v, hMv, hη₀_int_gen z x]
    have h2 : (M : Padic ℓ) * ((z : Padic ℓ) * η₀ v) = (z : Padic ℓ) * η₀ (M • v) := by
      rw [mul_left_comm, ← nsmul_eq_mul, ← map_nsmul]
    exact h1.trans h2.symm
  have hη₀_smul : ∀ (c : Padic ℓ) (v : V), η₀ (c • v) = c * η₀ v := by
    intro c v
    obtain ⟨⟨z, s⟩, hzs⟩ := IsLocalization.surj (nonZeroDivisors (PadicInt ℓ)) c
    have hs_ne_int : (s : PadicInt ℓ) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s.2
    have hs_ne : ((s : PadicInt ℓ) : Padic ℓ) ≠ 0 := PadicInt.coe_eq_zero.not.mpr hs_ne_int
    have hzs' : ((s : PadicInt ℓ) : Padic ℓ) * c = (z : Padic ℓ) := by
      rw [mul_comm]
      exact hzs
    apply mul_left_cancel₀ hs_ne
    have h1 : ((s : PadicInt ℓ) : Padic ℓ) * η₀ (c • v) = (z : Padic ℓ) * η₀ v := by
      rw [← hη₀_int (s : PadicInt ℓ) (c • v), smul_smul, hzs', hη₀_int z v]
    have h2 : ((s : PadicInt ℓ) : Padic ℓ) * (c * η₀ v) = (z : Padic ℓ) * η₀ v := by
      rw [← mul_assoc, hzs']
    exact h1.trans h2.symm
  let η : V →ₗ[Padic ℓ] Padic ℓ :=
    { toFun := η₀
      map_add' := η₀.map_add
      map_smul' := fun c v => by
        dsimp only [RingHom.id_apply, smul_eq_mul]
        exact hη₀_smul c v }
  exact ⟨η, tr_tilde, htr_spec, hη₀_gen⟩

theorem weil_lefschetz_padic_cup_duality_of_integral_lattices (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    {L_i L_j : Type u} [AddCommMonoid L_i] [Module ℤ L_i] [AddCommMonoid L_j] [Module ℤ L_j]
    (V_i V_j V_top : Type u)
    [AddCommGroup V_i] [Module (Padic ℓ) V_i] [Module.Finite (Padic ℓ) V_i]
    [AddCommGroup V_j] [Module (Padic ℓ) V_j] [Module.Finite (Padic ℓ) V_j]
    [AddCommGroup V_top] [Module (Padic ℓ) V_top]
    (e_i : TensorProduct ℤ ℚ L_i ≃+ V_i)
    (e_j : TensorProduct ℤ ℚ L_j ≃+ V_j)
    (cup_ij : V_i →ₗ[Padic ℓ] V_j →ₗ[Padic ℓ] V_top)
    (cup_ji : V_j →ₗ[Padic ℓ] V_i →ₗ[Padic ℓ] V_top)
    (η_top : V_top →ₗ[Padic ℓ] Padic ℓ)
    (h_kill_i : ∀ x : L_i,
      (∀ y : L_j,
        η_top (cup_ij (e_i (TensorProduct.tmul ℤ (1 : ℚ) x))
          (e_j (TensorProduct.tmul ℤ (1 : ℚ) y))) = 0) →
      e_i (TensorProduct.tmul ℤ (1 : ℚ) x) = 0)
    (h_kill_j : ∀ y : L_j,
      (∀ x : L_i,
        η_top (cup_ji (e_j (TensorProduct.tmul ℤ (1 : ℚ) y))
          (e_i (TensorProduct.tmul ℤ (1 : ℚ) x))) = 0) →
      e_j (TensorProduct.tmul ℤ (1 : ℚ) y) = 0) :
    Function.Bijective (fun u : V_i => η_top.comp (cup_ij u)) :=
by
  have clear_den_rat_tensor :
      ∀ {G : Type u} [AddCommMonoid G] [Module ℤ G] (t : TensorProduct ℤ ℚ G),
        ∃ M : ℕ, 1 ≤ M ∧ ∃ x : G, M • t = TensorProduct.tmul ℤ (1 : ℚ) x := by
    intro G _ _ t
    refine TensorProduct.inductionOn t ?_ ?_
    · intro q x₀
      refine ⟨q.den, q.pos, q.num • x₀, ?_⟩
      have hq : (q.den : ℤ) • q = q.num • (1 : ℚ) := by
        rw [zsmul_eq_mul, Int.cast_natCast, mul_comm, Rat.mul_den_eq_num, zsmul_one]
      rw [← natCast_zsmul, TensorProduct.smul_tmul', hq, TensorProduct.smul_tmul]
    · intro t₁ t₂ ⟨M₁, hM₁, x₁, hx₁⟩ ⟨M₂, hM₂, x₂, hx₂⟩
      refine ⟨M₁ * M₂, Nat.mul_pos hM₁ hM₂, M₂ • x₁ + M₁ • x₂, ?_⟩
      have hp1 : M₂ • TensorProduct.tmul ℤ (1 : ℚ) x₁ = TensorProduct.tmul ℤ (1 : ℚ) (M₂ • x₁) :=
        (map_nsmul (TensorProduct.mk ℤ ℚ G (1 : ℚ)) M₂ x₁).symm
      have hp2 : M₁ • TensorProduct.tmul ℤ (1 : ℚ) x₂ = TensorProduct.tmul ℤ (1 : ℚ) (M₁ • x₂) :=
        (map_nsmul (TensorProduct.mk ℤ ℚ G (1 : ℚ)) M₁ x₂).symm
      rw [smul_add, mul_comm M₁ M₂, mul_smul, hx₁, mul_comm M₂ M₁, mul_smul, hx₂,
        hp1, hp2, TensorProduct.tmul_add]
  have h_inj_gen : ∀ {K₁ K₂ : Type u} [AddCommMonoid K₁] [Module ℤ K₁]
      [AddCommMonoid K₂] [Module ℤ K₂]
      (W₁ W₂ : Type u) [AddCommGroup W₁] [Module (Padic ℓ) W₁]
      [AddCommGroup W₂] [Module (Padic ℓ) W₂]
      (f₁ : TensorProduct ℤ ℚ K₁ ≃+ W₁) (f₂ : TensorProduct ℤ ℚ K₂ ≃+ W₂)
      (cup_W : W₁ →ₗ[Padic ℓ] W₂ →ₗ[Padic ℓ] V_top),
      (∀ x : K₁,
        (∀ y : K₂,
          η_top (cup_W (f₁ (TensorProduct.tmul ℤ (1 : ℚ) x))
            (f₂ (TensorProduct.tmul ℤ (1 : ℚ) y))) = 0) →
        f₁ (TensorProduct.tmul ℤ (1 : ℚ) x) = 0) →
      ∀ Φ : W₁ →ₗ[Padic ℓ] Module.Dual (Padic ℓ) W₂,
        (∀ (u : W₁) (v : W₂), Φ u v = η_top (cup_W u v)) →
        Function.Injective Φ := by
    intro K₁ K₂ _ _ _ _ W₁ W₂ _ _ _ _ f₁ f₂ cup_W h_kill Φ hΦ_apply
    rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
    intro u hu
    rw [LinearMap.mem_ker] at hu
    obtain ⟨M, hM, x, hx⟩ := clear_den_rat_tensor (f₁.symm u)
    have hMu : M • u = f₁ (TensorProduct.tmul ℤ (1 : ℚ) x) := by
      rw [← hx, map_nsmul, f₁.apply_symm_apply]
    have hx_zero : f₁ (TensorProduct.tmul ℤ (1 : ℚ) x) = 0 := by
      apply h_kill x
      intro y
      rw [← hMu, ← Nat.cast_smul_eq_nsmul (Padic ℓ) M u,
        map_smul, LinearMap.smul_apply, map_smul, ← hΦ_apply, hu,
        LinearMap.zero_apply, smul_zero]
    have hu_nsmul : M • u = 0 := hMu.trans hx_zero
    have h_scalar_ne : ((M : Padic ℓ)) ≠ 0 :=
      Nat.cast_ne_zero.mpr (ne_of_gt hM)
    have hu_smul : ((M : Padic ℓ)) • u = 0 := by
      rw [Nat.cast_smul_eq_nsmul, hu_nsmul]
    exact (smul_eq_zero.mp hu_smul).resolve_left h_scalar_ne
  let Φ_ij : V_i →ₗ[Padic ℓ] Module.Dual (Padic ℓ) V_j :=
    { toFun := fun u => η_top.comp (cup_ij u)
      map_add' := fun u₁ u₂ => by ext v; simp
      map_smul' := fun c u => by ext v; simp }
  let Φ_ji : V_j →ₗ[Padic ℓ] Module.Dual (Padic ℓ) V_i :=
    { toFun := fun v => η_top.comp (cup_ji v)
      map_add' := fun v₁ v₂ => by ext u; simp
      map_smul' := fun c v => by ext u; simp }
  have hΦ_ij_inj : Function.Injective Φ_ij :=
    h_inj_gen V_i V_j e_i e_j cup_ij h_kill_i Φ_ij (fun _ _ => rfl)
  have hΦ_ji_inj : Function.Injective Φ_ji :=
    h_inj_gen V_j V_i e_j e_i cup_ji h_kill_j Φ_ji (fun _ _ => rfl)
  have hle1 : Module.finrank (Padic ℓ) V_i ≤ Module.finrank (Padic ℓ) V_j := by
    calc
      Module.finrank (Padic ℓ) V_i ≤ Module.finrank (Padic ℓ) (Module.Dual (Padic ℓ) V_j) :=
        LinearMap.finrank_le_finrank_of_injective hΦ_ij_inj
      _ = Module.finrank (Padic ℓ) V_j := Subspace.dual_finrank_eq
  have hle2 : Module.finrank (Padic ℓ) V_j ≤ Module.finrank (Padic ℓ) V_i := by
    calc
      Module.finrank (Padic ℓ) V_j ≤ Module.finrank (Padic ℓ) (Module.Dual (Padic ℓ) V_i) :=
        LinearMap.finrank_le_finrank_of_injective hΦ_ji_inj
      _ = Module.finrank (Padic ℓ) V_i := Subspace.dual_finrank_eq
  have hfin_eq :
      Module.finrank (Padic ℓ) V_i = Module.finrank (Padic ℓ) (Module.Dual (Padic ℓ) V_j) := by
    rw [Subspace.dual_finrank_eq]
    exact le_antisymm hle1 hle2
  have hΦ_ij_surj : Function.Surjective Φ_ij :=
    (LinearMap.injective_iff_surjective_of_finrank_eq_finrank hfin_eq).mp hΦ_ij_inj
  exact ⟨hΦ_ij_inj, hΦ_ij_surj⟩

theorem weil_lefschetz_padic_product_trace_of_integral_lattices (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    {L_X L_P4 : Type u} [AddCommMonoid L_X] [Module ℤ L_X] [AddCommMonoid L_P4] [Module ℤ L_P4]
    (V_X V_P2 V_P4 : Type u)
    [AddCommGroup V_X] [Module (Padic ℓ) V_X]
    [AddCommGroup V_P2] [Module (Padic ℓ) V_P2]
    [AddCommGroup V_P4] [Module (Padic ℓ) V_P4]
    (e_X : TensorProduct ℤ ℚ L_X ≃+ V_X)
    (e_P4 : TensorProduct ℤ ℚ L_P4 ≃+ V_P4)
    (fp₁ fp₂ : V_X →ₗ[Padic ℓ] V_P2)
    (cup_P : V_P2 →ₗ[Padic ℓ] V_P2 →ₗ[Padic ℓ] V_P4)
    (tr_X_tilde : L_X →+ PadicInt ℓ)
    (η_X : V_X →ₗ[Padic ℓ] Padic ℓ)
    (hη_X_gen : ∀ x : L_X, η_X (e_X (TensorProduct.tmul ℤ (1 : ℚ) x)) = (tr_X_tilde x : Padic ℓ))
    (tr_P_tilde : L_P4 →+ PadicInt ℓ)
    (η_P : V_P4 →ₗ[Padic ℓ] Padic ℓ)
    (hη_P_gen : ∀ z : L_P4, η_P (e_P4 (TensorProduct.tmul ℤ (1 : ℚ) z)) = (tr_P_tilde z : Padic ℓ))
    (h_prod_gen : ∀ x y : L_X,
      ∃ z : L_P4,
        (∀ r : ℕ,
          PadicInt.toZModPow r (tr_P_tilde z) =
            PadicInt.toZModPow r (tr_X_tilde x) *
              PadicInt.toZModPow r (tr_X_tilde y)) ∧
        cup_P (fp₁ (e_X (TensorProduct.tmul ℤ (1 : ℚ) x)))
            (fp₂ (e_X (TensorProduct.tmul ℤ (1 : ℚ) y))) =
          e_P4 (TensorProduct.tmul ℤ (1 : ℚ) z))
    (u w : V_X) :
    η_P (cup_P (fp₁ u) (fp₂ w)) = η_X u * η_X w :=
by
  have h_gen : ∀ x y : L_X,
      η_P (cup_P (fp₁ (e_X (TensorProduct.tmul ℤ (1 : ℚ) x)))
          (fp₂ (e_X (TensorProduct.tmul ℤ (1 : ℚ) y)))) =
        η_X (e_X (TensorProduct.tmul ℤ (1 : ℚ) x)) *
          η_X (e_X (TensorProduct.tmul ℤ (1 : ℚ) y)) := by
    intro x y
    obtain ⟨z', htr_mod, hcup_eq⟩ := h_prod_gen x y
    have htr_z' : tr_P_tilde z' = tr_X_tilde x * tr_X_tilde y := by
      rw [← PadicInt.ext_of_toZModPow]
      intro r
      rw [map_mul, htr_mod r]
    rw [hcup_eq, hη_P_gen z', hη_X_gen x, hη_X_gen y, htr_z', PadicInt.coe_mul]
  have clear_den : ∀ t : TensorProduct ℤ ℚ L_X,
      ∃ M : ℕ, 1 ≤ M ∧ ∃ x : L_X, M • t = TensorProduct.tmul ℤ (1 : ℚ) x := by
    intro t
    refine TensorProduct.inductionOn t ?_ ?_
    · intro q x₀
      refine ⟨q.den, q.pos, q.num • x₀, ?_⟩
      have hq : (q.den : ℤ) • q = q.num • (1 : ℚ) := by
        rw [zsmul_eq_mul, Int.cast_natCast, mul_comm, Rat.mul_den_eq_num, zsmul_one]
      rw [← natCast_zsmul, TensorProduct.smul_tmul', hq, TensorProduct.smul_tmul]
    · intro t₁ t₂ ⟨M₁, hM₁, x₁, hx₁⟩ ⟨M₂, hM₂, x₂, hx₂⟩
      refine ⟨M₁ * M₂, Nat.mul_pos hM₁ hM₂, M₂ • x₁ + M₁ • x₂, ?_⟩
      have hp1 : M₂ • TensorProduct.tmul ℤ (1 : ℚ) x₁ = TensorProduct.tmul ℤ (1 : ℚ) (M₂ • x₁) :=
        (map_nsmul (TensorProduct.mk ℤ ℚ L_X (1 : ℚ)) M₂ x₁).symm
      have hp2 : M₁ • TensorProduct.tmul ℤ (1 : ℚ) x₂ = TensorProduct.tmul ℤ (1 : ℚ) (M₁ • x₂) :=
        (map_nsmul (TensorProduct.mk ℤ ℚ L_X (1 : ℚ)) M₁ x₂).symm
      rw [smul_add, mul_comm M₁ M₂, mul_smul, hx₁, mul_comm M₂ M₁, mul_smul, hx₂,
        hp1, hp2, TensorProduct.tmul_add]
  obtain ⟨M₁, hM₁, x, hx⟩ := clear_den (e_X.symm u)
  obtain ⟨M₂, hM₂, y, hy⟩ := clear_den (e_X.symm w)
  have hM₁u : M₁ • u = e_X (TensorProduct.tmul ℤ (1 : ℚ) x) := by
    rw [← hx, map_nsmul, e_X.apply_symm_apply]
  have hM₂w : M₂ • w = e_X (TensorProduct.tmul ℤ (1 : ℚ) y) := by
    rw [← hy, map_nsmul, e_X.apply_symm_apply]
  have hM_ne : (((M₁ * M₂ : ℕ) : Padic ℓ)) ≠ 0 :=
    Nat.cast_ne_zero.mpr (ne_of_gt (Nat.mul_pos hM₁ hM₂))
  apply mul_left_cancel₀ hM_ne
  have hLHS : (((M₁ * M₂ : ℕ) : Padic ℓ)) * η_P (cup_P (fp₁ u) (fp₂ w)) =
      η_P (cup_P (fp₁ (M₁ • u)) (fp₂ (M₂ • w))) := by
    rw [← Nat.cast_smul_eq_nsmul (Padic ℓ) M₁ u, ← Nat.cast_smul_eq_nsmul (Padic ℓ) M₂ w,
      map_smul, map_smul, map_smul, LinearMap.smul_apply, map_smul, map_smul, map_smul,
      smul_eq_mul, smul_eq_mul, Nat.cast_mul, mul_assoc]
  have hRHS : (((M₁ * M₂ : ℕ) : Padic ℓ)) * (η_X u * η_X w) =
      η_X (M₁ • u) * η_X (M₂ • w) := by
    rw [← Nat.cast_smul_eq_nsmul (Padic ℓ) M₁ u, ← Nat.cast_smul_eq_nsmul (Padic ℓ) M₂ w,
      map_smul, map_smul, smul_eq_mul, smul_eq_mul, Nat.cast_mul]
    ring
  rw [hLHS, hRHS, hM₁u, hM₂w, h_gen x y]

theorem weil_lefschetz_ell_adic_trace_and_duality_of_torsion (X_sch P_sch : AlgebraicGeometry.Scheme.{u})
    (d ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (p₁ p₂ : Quiver.Hom P_sch X_sch)
    (H_X : ∀ i : ℕ, WeilLefschetzEllAdicSpace X_sch ℓ i)
    [∀ i : ℕ, Module.Finite (Padic ℓ) (H_X i).V]
    (H_P : ∀ i : ℕ, WeilLefschetzEllAdicSpace P_sch ℓ i)
    (fp₁_top fp₂_top : (H_X (2 * d)).V →ₗ[Padic ℓ] (H_P (2 * d)).V)
    (hfp₁_top : WeilLefschetzIsEllAdicPullback p₁ ℓ (2 * d) (H_P (2 * d)) (H_X (2 * d)) fp₁_top)
    (hfp₂_top : WeilLefschetzIsEllAdicPullback p₂ ℓ (2 * d) (H_P (2 * d)) (H_X (2 * d)) fp₂_top)
    (cup_X : ∀ (i j : ℕ), i + j = 2 * d →
      (H_X i).V →ₗ[Padic ℓ] (H_X j).V →ₗ[Padic ℓ] (H_X (2 * d)).V)
    (hcup_X : ∀ (i j : ℕ) (hij : i + j = 2 * d),
      WeilLefschetzIsEllAdicCup X_sch ℓ i j (2 * d) hij (H_X i) (H_X j) (H_X (2 * d))
        (cup_X i j hij))
    (cup_P_top : (H_P (2 * d)).V →ₗ[Padic ℓ] (H_P (2 * d)).V →ₗ[Padic ℓ] (H_P (4 * d)).V)
    (hcup_P_top : WeilLefschetzIsEllAdicCup P_sch ℓ (2 * d) (2 * d) (4 * d) (by omega)
      (H_P (2 * d)) (H_P (2 * d)) (H_P (4 * d)) cup_P_top)
    (hPullTrans : ∀ (h : Quiver.Hom P_sch X_sch) (r : ℕ)
      (p_succ : weilEtaleTorsionH X_sch (ℓ ^ (r + 1)) (2 * d) →+
        weilEtaleTorsionH P_sch (ℓ ^ (r + 1)) (2 * d))
      (p_curr : weilEtaleTorsionH X_sch (ℓ ^ r) (2 * d) →+
        weilEtaleTorsionH P_sch (ℓ ^ r) (2 * d)),
      WeilLefschetzTorsionPullback h (ℓ ^ (r + 1)) (2 * d) p_succ →
      WeilLefschetzTorsionPullback h (ℓ ^ r) (2 * d) p_curr →
      ∀ x : weilEtaleTorsionH X_sch (ℓ ^ (r + 1)) (2 * d),
        weilEtaleTorsionTransition P_sch ℓ r (2 * d) (p_succ x) =
          p_curr (weilEtaleTorsionTransition X_sch ℓ r (2 * d) x))
    (hCupTrans_X : ∀ (r i j : ℕ) (hij : i + j = 2 * d)
      (c_succ : weilEtaleTorsionH X_sch (ℓ ^ (r + 1)) i →+
        weilEtaleTorsionH X_sch (ℓ ^ (r + 1)) j →+ weilEtaleTorsionH X_sch (ℓ ^ (r + 1)) (2 * d))
      (c_curr : weilEtaleTorsionH X_sch (ℓ ^ r) i →+
        weilEtaleTorsionH X_sch (ℓ ^ r) j →+ weilEtaleTorsionH X_sch (ℓ ^ r) (2 * d)),
      WeilLefschetzIsTorsionCup X_sch (ℓ ^ (r + 1)) i j (2 * d) hij c_succ →
      WeilLefschetzIsTorsionCup X_sch (ℓ ^ r) i j (2 * d) hij c_curr →
      ∀ (x : weilEtaleTorsionH X_sch (ℓ ^ (r + 1)) i)
        (y : weilEtaleTorsionH X_sch (ℓ ^ (r + 1)) j),
        weilEtaleTorsionTransition X_sch ℓ r (2 * d) (c_succ x y) =
          c_curr (weilEtaleTorsionTransition X_sch ℓ r i x)
            (weilEtaleTorsionTransition X_sch ℓ r j y))
    (hCupTrans_P : ∀ (r : ℕ)
      (c_succ : weilEtaleTorsionH P_sch (ℓ ^ (r + 1)) (2 * d) →+
        weilEtaleTorsionH P_sch (ℓ ^ (r + 1)) (2 * d) →+
        weilEtaleTorsionH P_sch (ℓ ^ (r + 1)) (4 * d))
      (c_curr : weilEtaleTorsionH P_sch (ℓ ^ r) (2 * d) →+
        weilEtaleTorsionH P_sch (ℓ ^ r) (2 * d) →+
        weilEtaleTorsionH P_sch (ℓ ^ r) (4 * d)),
      WeilLefschetzIsTorsionCup P_sch (ℓ ^ (r + 1)) (2 * d) (2 * d) (4 * d) (by omega) c_succ →
      WeilLefschetzIsTorsionCup P_sch (ℓ ^ r) (2 * d) (2 * d) (4 * d) (by omega) c_curr →
      ∀ (x y : weilEtaleTorsionH P_sch (ℓ ^ (r + 1)) (2 * d)),
        weilEtaleTorsionTransition P_sch ℓ r (4 * d) (c_succ x y) =
          c_curr (weilEtaleTorsionTransition P_sch ℓ r (2 * d) x)
            (weilEtaleTorsionTransition P_sch ℓ r (2 * d) y))
    (hFin : ∀ (m r : ℕ), Finite (weilEtaleTorsionH X_sch (ℓ ^ r) m))
    (tr_X : ∀ r : ℕ, weilEtaleTorsionH X_sch (ℓ ^ r) (2 * d) →+ ZMod (ℓ ^ r))
    (tr_P : ∀ r : ℕ, weilEtaleTorsionH P_sch (ℓ ^ r) (4 * d) →+ ZMod (ℓ ^ r))
    (htr_X_bij : ∀ r : ℕ, Function.Bijective (tr_X r))
    (htr_X_compat : ∀ (r : ℕ) (u : weilEtaleTorsionH X_sch (ℓ ^ (r + 1)) (2 * d)),
      ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r)) (tr_X (r + 1) u) =
        tr_X r (weilEtaleTorsionTransition X_sch ℓ r (2 * d) u))
    (htr_P_compat : ∀ (r : ℕ) (z : weilEtaleTorsionH P_sch (ℓ ^ (r + 1)) (4 * d)),
      ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r)) (tr_P (r + 1) z) =
        tr_P r (weilEtaleTorsionTransition P_sch ℓ r (4 * d) z))
    (htr_prod : ∀ (r : ℕ)
      (p₁_r p₂_r : weilEtaleTorsionH X_sch (ℓ ^ r) (2 * d) →+
        weilEtaleTorsionH P_sch (ℓ ^ r) (2 * d))
      (c_P_r : weilEtaleTorsionH P_sch (ℓ ^ r) (2 * d) →+
        weilEtaleTorsionH P_sch (ℓ ^ r) (2 * d) →+
        weilEtaleTorsionH P_sch (ℓ ^ r) (4 * d)),
      WeilLefschetzTorsionPullback p₁ (ℓ ^ r) (2 * d) p₁_r →
      WeilLefschetzTorsionPullback p₂ (ℓ ^ r) (2 * d) p₂_r →
      WeilLefschetzIsTorsionCup P_sch (ℓ ^ r) (2 * d) (2 * d) (4 * d) (by omega) c_P_r →
      ∀ (u w : weilEtaleTorsionH X_sch (ℓ ^ r) (2 * d)),
        tr_P r (c_P_r (p₁_r u) (p₂_r w)) = tr_X r u * tr_X r w)
    (hCupNonDeg : ∀ (r i j : ℕ) (hij : i + j = 2 * d)
      (c_X : weilEtaleTorsionH X_sch (ℓ ^ r) i →+
        weilEtaleTorsionH X_sch (ℓ ^ r) j →+ weilEtaleTorsionH X_sch (ℓ ^ r) (2 * d)),
      WeilLefschetzIsTorsionCup X_sch (ℓ ^ r) i j (2 * d) hij c_X →
      ∀ a : weilEtaleTorsionH X_sch (ℓ ^ r) i,
        (∀ b : weilEtaleTorsionH X_sch (ℓ ^ r) j, c_X a b = 0) → a = 0) :
    ∃ (η_X : (H_X (2 * d)).V →ₗ[Padic ℓ] Padic ℓ)
      (η_P : (H_P (4 * d)).V →ₗ[Padic ℓ] Padic ℓ),
      (∀ (i j : ℕ) (hij : i + j = 2 * d),
        Function.Bijective (fun u : (H_X i).V => η_X.comp (cup_X i j hij u))) ∧
      (∀ (u w : (H_X (2 * d)).V),
        η_P (cup_P_top (fp₁_top u) (fp₂_top w)) = η_X u * η_X w) :=
by
  have hℓ_pos : 0 < ℓ := (Fact.out : Nat.Prime ℓ).pos
  have hNeZero : ∀ k : ℕ, NeZero (ℓ ^ k) :=
    fun k => ⟨ne_of_gt (pow_pos hℓ_pos k)⟩
  obtain ⟨h_mem_X, h_tors_X, h_bock_X⟩ :=
    weil_lefschetz_torsion_sheaf_bockstein_package ℓ X_sch
  obtain ⟨h_mem_P, h_tors_P, -⟩ :=
    weil_lefschetz_torsion_sheaf_bockstein_package ℓ P_sch
  have hLift_X : ∀ m : ℕ, ∃ N : ℕ, ∀ (r : ℕ) (b : weilEtaleTorsionH X_sch (ℓ ^ r) m),
      ∃ y : ↥(weilEtaleIntegralSystem X_sch ℓ m), y.1 r = (ℓ ^ N) • b := by
    intro m
    obtain ⟨f_step, g_gen, δ_map, hg_step, hg_id, hg_comp, hf_exact, hf_comm,
      hf_mul_ell, hδ_compat, hδ_exact⟩ := h_bock_X m
    obtain ⟨N, hN⟩ := weil_lefschetz_abstract_konig_uniform_torsion_lift ℓ
      (fun r q => weilEtaleTorsionH X_sch (ℓ ^ r) q)
      (fun q r => hFin q r) (fun r q w => h_tors_X (ℓ ^ r) q w)
      (fun r q => weilEtaleTorsionTransition X_sch ℓ r q) m
      f_step g_gen δ_map hg_step hg_id hg_comp hf_exact hf_comm
      hf_mul_ell hδ_compat hδ_exact
    refine ⟨N, fun r b => ?_⟩
    obtain ⟨y, hy_compat, hy_r⟩ := hN r b
    exact ⟨⟨y, (h_mem_X m y).mpr hy_compat⟩, hy_r⟩
  have h_kill_via_hsmul : ∀ (m N : ℕ) (x : ↥(weilEtaleIntegralSystem X_sch ℓ m)),
      (∀ r : ℕ, (ℓ ^ N) • (x.1 r) = 0) →
      (H_X m).equiv (TensorProduct.tmul ℤ (1 : ℚ) x) = 0 := by
    intro m N x hx
    let z : PadicInt ℓ := ((ℓ ^ N : ℕ) : PadicInt ℓ)
    have h0_mem : (fun r : ℕ => (0 : weilEtaleTorsionH X_sch (ℓ ^ r) m)) ∈
        weilEtaleIntegralSystem X_sch ℓ m :=
      (h_mem_X m _).mpr (fun r => map_zero _)
    let y0 : ↥(weilEtaleIntegralSystem X_sch ℓ m) := ⟨fun _ => 0, h0_mem⟩
    have hy0_zero : (H_X m).equiv (TensorProduct.tmul ℤ (1 : ℚ) y0) = 0 := by
      have h0 := (H_X m).hsmul (0 : PadicInt ℓ) x y0 (fun r => by
        change (0 : weilEtaleTorsionH X_sch (ℓ ^ r) m) = _
        rw [map_zero, ZMod.val_zero, zero_smul])
      simpa using h0
    have hval : ∀ r : ℕ, y0.1 r = (PadicInt.toZModPow r z).val • x.1 r := by
      intro r
      have := hNeZero r
      change (0 : weilEtaleTorsionH X_sch (ℓ ^ r) m) = _
      rw [map_natCast (PadicInt.toZModPow r) (ℓ ^ N), ZMod.val_natCast]
      have hdiv := Nat.div_add_mod (ℓ ^ N) (ℓ ^ r)
      have h0 : (ℓ ^ N) • (x.1 r) = ((ℓ ^ N) % (ℓ ^ r)) • (x.1 r) := by
        conv_lhs => rw [← hdiv]
        rw [add_smul, mul_comm (ℓ ^ r), mul_smul, h_tors_X (ℓ ^ r) m (x.1 r), smul_zero, zero_add]
      rw [← h0, hx r]
    have hsm := (H_X m).hsmul z x y0 hval
    rw [hy0_zero] at hsm
    have hz_ne : (z : Padic ℓ) ≠ 0 := by
      dsimp [z]
      exact_mod_cast ne_of_gt (pow_pos hℓ_pos N)
    exact (smul_eq_zero.mp hsm.symm).resolve_left hz_ne
  obtain ⟨η_X, tr_X_tilde, htr_X_spec, hη_X_gen⟩ :=
    @weil_lefschetz_padic_trace_functional_of_integral_lattice ℓ _
      ↥(weilEtaleIntegralSystem X_sch ℓ (2 * d)) _ _
      (H_X (2 * d)).V _ _ (H_X (2 * d)).equiv
      (fun r x => tr_X r (x.1 r))
      (fun r => (tr_X r).map_zero)
      (fun r x₁ x₂ => (tr_X r).map_add (x₁.1 r) (x₂.1 r))
      (fun r x => (htr_X_compat r (x.1 (r + 1))).trans
        (congrArg (tr_X r) ((h_mem_X (2 * d) x.1).mp x.2 r)))
      (fun z x => by
        let y_fun : ∀ r : ℕ, weilEtaleTorsionH X_sch (ℓ ^ r) (2 * d) :=
          fun r => (PadicInt.toZModPow r z).val • x.1 r
        have hy_mem : y_fun ∈ weilEtaleIntegralSystem X_sch ℓ (2 * d) := by
          rw [h_mem_X]
          intro r
          have := hNeZero r
          have := hNeZero (r + 1)
          dsimp [y_fun]
          rw [map_nsmul, (h_mem_X (2 * d) x.1).mp x.2 r]
          have hz_cast : PadicInt.toZModPow r z =
              ((PadicInt.toZModPow (r + 1) z).val : ZMod (ℓ ^ r)) := by
            have hc := RingHom.congr_fun
              (PadicInt.zmod_cast_comp_toZModPow r (r + 1) (Nat.le_succ r)) z
            rw [RingHom.comp_apply] at hc
            rw [← hc]
            conv_lhs => rw [← ZMod.natCast_zmod_val (PadicInt.toZModPow (r + 1) z)]
            rw [map_natCast]
          rw [hz_cast, ZMod.val_natCast]
          set m₀ := (PadicInt.toZModPow (r + 1) z).val
          conv_lhs => rw [← Nat.div_add_mod m₀ (ℓ ^ r)]
          rw [add_smul, mul_comm (ℓ ^ r), mul_smul,
            h_tors_X (ℓ ^ r) (2 * d) (x.1 r), smul_zero, zero_add]
        refine ⟨⟨y_fun, hy_mem⟩, fun r => ?_,
          (H_X (2 * d)).hsmul z x ⟨y_fun, hy_mem⟩ (fun _ => rfl)⟩
        have := hNeZero r
        dsimp [y_fun]
        rw [map_nsmul, nsmul_eq_mul, ZMod.natCast_zmod_val])
  obtain ⟨η_P, tr_P_tilde, htr_P_spec, hη_P_gen⟩ :=
    @weil_lefschetz_padic_trace_functional_of_integral_lattice ℓ _
      ↥(weilEtaleIntegralSystem P_sch ℓ (4 * d)) _ _
      (H_P (4 * d)).V _ _ (H_P (4 * d)).equiv
      (fun r x => tr_P r (x.1 r))
      (fun r => (tr_P r).map_zero)
      (fun r x₁ x₂ => (tr_P r).map_add (x₁.1 r) (x₂.1 r))
      (fun r x => (htr_P_compat r (x.1 (r + 1))).trans
        (congrArg (tr_P r) ((h_mem_P (4 * d) x.1).mp x.2 r)))
      (fun z x => by
        let y_fun : ∀ r : ℕ, weilEtaleTorsionH P_sch (ℓ ^ r) (4 * d) :=
          fun r => (PadicInt.toZModPow r z).val • x.1 r
        have hy_mem : y_fun ∈ weilEtaleIntegralSystem P_sch ℓ (4 * d) := by
          rw [h_mem_P]
          intro r
          have := hNeZero r
          have := hNeZero (r + 1)
          dsimp [y_fun]
          rw [map_nsmul, (h_mem_P (4 * d) x.1).mp x.2 r]
          have hz_cast : PadicInt.toZModPow r z =
              ((PadicInt.toZModPow (r + 1) z).val : ZMod (ℓ ^ r)) := by
            have hc := RingHom.congr_fun
              (PadicInt.zmod_cast_comp_toZModPow r (r + 1) (Nat.le_succ r)) z
            rw [RingHom.comp_apply] at hc
            rw [← hc]
            conv_lhs => rw [← ZMod.natCast_zmod_val (PadicInt.toZModPow (r + 1) z)]
            rw [map_natCast]
          rw [hz_cast, ZMod.val_natCast]
          set m₀ := (PadicInt.toZModPow (r + 1) z).val
          conv_lhs => rw [← Nat.div_add_mod m₀ (ℓ ^ r)]
          rw [add_smul, mul_comm (ℓ ^ r), mul_smul,
            h_tors_P (ℓ ^ r) (4 * d) (x.1 r), smul_zero, zero_add]
        refine ⟨⟨y_fun, hy_mem⟩, fun r => ?_,
          (H_P (4 * d)).hsmul z x ⟨y_fun, hy_mem⟩ (fun _ => rfl)⟩
        have := hNeZero r
        dsimp [y_fun]
        rw [map_nsmul, nsmul_eq_mul, ZMod.natCast_zmod_val])
  refine ⟨η_X, η_P, ?_, ?_⟩
  · intro i j hij
    have hji : j + i = 2 * d := (Nat.add_comm j i).trans hij
    exact @weil_lefschetz_padic_cup_duality_of_integral_lattices ℓ _
      ↥(weilEtaleIntegralSystem X_sch ℓ i)
      ↥(weilEtaleIntegralSystem X_sch ℓ j)
      _ _ _ _
      (H_X i).V (H_X j).V (H_X (2 * d)).V _ _ _ _ _ _ _ _
      (H_X i).equiv (H_X j).equiv
      (cup_X i j hij) (cup_X j i hji) η_X
      (by
        obtain ⟨c_ij, hc_ij_cup, hcup_ij_eq⟩ := hcup_X i j hij
        obtain ⟨N_j, hN_j⟩ := hLift_X j
        intro x hx_orth
        apply h_kill_via_hsmul i N_j x
        intro r
        apply hCupNonDeg r i j hij (c_ij r) (hc_ij_cup r) ((ℓ ^ N_j) • x.1 r)
        intro b_r
        apply (htr_X_bij r).1
        rw [map_zero]
        obtain ⟨y, hy⟩ := hN_j r b_r
        let z_fun : ∀ s : ℕ, weilEtaleTorsionH X_sch (ℓ ^ s) (2 * d) :=
          fun s => c_ij s (x.1 s) (y.1 s)
        have hz_mem : z_fun ∈ weilEtaleIntegralSystem X_sch ℓ (2 * d) := by
          rw [h_mem_X]
          intro s
          dsimp [z_fun]
          rw [hCupTrans_X s i j hij (c_ij (s + 1)) (c_ij s)
              (hc_ij_cup (s + 1)) (hc_ij_cup s),
            (h_mem_X i x.1).mp x.2 s, (h_mem_X j y.1).mp y.2 s]
        let z : ↥(weilEtaleIntegralSystem X_sch ℓ (2 * d)) := ⟨z_fun, hz_mem⟩
        have htr_z_padic : (tr_X_tilde z : Padic ℓ) = 0 := by
          rw [← hη_X_gen z, ← hcup_ij_eq x y z (fun _ => rfl)]
          exact hx_orth y
        have htr_z : tr_X_tilde z = 0 := PadicInt.coe_eq_zero.mp htr_z_padic
        have htr_zr : tr_X r (z.1 r) = 0 := by
          rw [← htr_X_spec z r, htr_z, map_zero]
        have hcup_smul : c_ij r ((ℓ ^ N_j) • x.1 r) b_r = z.1 r := by
          dsimp [z, z_fun]
          rw [hy, map_nsmul, AddMonoidHom.nsmul_apply, map_nsmul]
        rw [hcup_smul, htr_zr])
      (by
        obtain ⟨c_ji, hc_ji_cup, hcup_ji_eq⟩ := hcup_X j i hji
        obtain ⟨N_i, hN_i⟩ := hLift_X i
        intro y hy_orth
        apply h_kill_via_hsmul j N_i y
        intro r
        apply hCupNonDeg r j i hji (c_ji r) (hc_ji_cup r) ((ℓ ^ N_i) • y.1 r)
        intro a_r
        apply (htr_X_bij r).1
        rw [map_zero]
        obtain ⟨x, hx⟩ := hN_i r a_r
        let z_fun : ∀ s : ℕ, weilEtaleTorsionH X_sch (ℓ ^ s) (2 * d) :=
          fun s => c_ji s (y.1 s) (x.1 s)
        have hz_mem : z_fun ∈ weilEtaleIntegralSystem X_sch ℓ (2 * d) := by
          rw [h_mem_X]
          intro s
          dsimp [z_fun]
          rw [hCupTrans_X s j i hji (c_ji (s + 1)) (c_ji s)
              (hc_ji_cup (s + 1)) (hc_ji_cup s),
            (h_mem_X j y.1).mp y.2 s, (h_mem_X i x.1).mp x.2 s]
        let z : ↥(weilEtaleIntegralSystem X_sch ℓ (2 * d)) := ⟨z_fun, hz_mem⟩
        have htr_z_padic : (tr_X_tilde z : Padic ℓ) = 0 := by
          rw [← hη_X_gen z, ← hcup_ji_eq y x z (fun _ => rfl)]
          exact hy_orth x
        have htr_z : tr_X_tilde z = 0 := PadicInt.coe_eq_zero.mp htr_z_padic
        have htr_zr : tr_X r (z.1 r) = 0 := by
          rw [← htr_X_spec z r, htr_z, map_zero]
        have hcup_smul : c_ji r ((ℓ ^ N_i) • y.1 r) a_r = z.1 r := by
          dsimp [z, z_fun]
          rw [hx, map_nsmul, AddMonoidHom.nsmul_apply, map_nsmul]
        rw [hcup_smul, htr_zr])
  · intro u w
    obtain ⟨p₁_tors, hp₁_tors, hfp₁_eq⟩ := hfp₁_top
    obtain ⟨p₂_tors, hp₂_tors, hfp₂_eq⟩ := hfp₂_top
    obtain ⟨c_P_tors, hc_P_tors, hcup_P_eq⟩ := hcup_P_top
    exact @weil_lefschetz_padic_product_trace_of_integral_lattices ℓ _
      ↥(weilEtaleIntegralSystem X_sch ℓ (2 * d))
      ↥(weilEtaleIntegralSystem P_sch ℓ (4 * d))
      _ _ _ _
      (H_X (2 * d)).V (H_P (2 * d)).V (H_P (4 * d)).V _ _ _ _ _ _
      (H_X (2 * d)).equiv (H_P (4 * d)).equiv
      fp₁_top fp₂_top cup_P_top
      tr_X_tilde η_X hη_X_gen tr_P_tilde η_P hη_P_gen
      (fun x y => by
        let x'_fun : ∀ r : ℕ, weilEtaleTorsionH P_sch (ℓ ^ r) (2 * d) :=
          fun r => p₁_tors r (x.1 r)
        have hx'_mem : x'_fun ∈ weilEtaleIntegralSystem P_sch ℓ (2 * d) := by
          rw [h_mem_P]
          intro r
          dsimp [x'_fun]
          rw [hPullTrans p₁ r (p₁_tors (r + 1)) (p₁_tors r) (hp₁_tors (r + 1)) (hp₁_tors r),
            (h_mem_X (2 * d) x.1).mp x.2 r]
        let x' : ↥(weilEtaleIntegralSystem P_sch ℓ (2 * d)) := ⟨x'_fun, hx'_mem⟩
        let y'_fun : ∀ r : ℕ, weilEtaleTorsionH P_sch (ℓ ^ r) (2 * d) :=
          fun r => p₂_tors r (y.1 r)
        have hy'_mem : y'_fun ∈ weilEtaleIntegralSystem P_sch ℓ (2 * d) := by
          rw [h_mem_P]
          intro r
          dsimp [y'_fun]
          rw [hPullTrans p₂ r (p₂_tors (r + 1)) (p₂_tors r) (hp₂_tors (r + 1)) (hp₂_tors r),
            (h_mem_X (2 * d) y.1).mp y.2 r]
        let y' : ↥(weilEtaleIntegralSystem P_sch ℓ (2 * d)) := ⟨y'_fun, hy'_mem⟩
        let z'_fun : ∀ r : ℕ, weilEtaleTorsionH P_sch (ℓ ^ r) (4 * d) :=
          fun r => c_P_tors r (x'.1 r) (y'.1 r)
        have hz'_mem : z'_fun ∈ weilEtaleIntegralSystem P_sch ℓ (4 * d) := by
          rw [h_mem_P]
          intro r
          dsimp [z'_fun]
          rw [hCupTrans_P r (c_P_tors (r + 1)) (c_P_tors r) (hc_P_tors (r + 1)) (hc_P_tors r),
            (h_mem_P (2 * d) x'.1).mp x'.2 r,
            (h_mem_P (2 * d) y'.1).mp y'.2 r]
        let z' : ↥(weilEtaleIntegralSystem P_sch ℓ (4 * d)) := ⟨z'_fun, hz'_mem⟩
        refine ⟨z', fun r => ?_, ?_⟩
        · rw [htr_P_spec z' r, htr_X_spec x r, htr_X_spec y r]
          exact htr_prod r (p₁_tors r) (p₂_tors r) (c_P_tors r)
            (hp₁_tors r) (hp₂_tors r) (hc_P_tors r) (x.1 r) (y.1 r)
        · rw [hfp₁_eq x x' (fun _ => rfl), hfp₂_eq y y' (fun _ => rfl),
            hcup_P_eq x' y' z' (fun _ => rfl)])
      u w

theorem weil_lefschetz_poincare_trace_and_product (k : Type u) [Field k] [IsAlgClosed k]
    (d : ℕ) (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hInt : AlgebraicGeometry.IsIntegral X.left)
    [AlgebraicGeometry.IsProper X.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : IsUnit (ℓ : k))
    (H_X : ∀ i : ℕ, WeilLefschetzEllAdicSpace X.left ℓ i)
    [∀ i : ℕ, Module.Finite (Padic ℓ) (H_X i).V]
    (H_P : ∀ i : ℕ, WeilLefschetzEllAdicSpace (CategoryTheory.Limits.pullback X.hom X.hom) ℓ i)
    (fp₁_top fp₂_top : (H_X (2 * d)).V →ₗ[Padic ℓ] (H_P (2 * d)).V)
    (hfp₁_top : WeilLefschetzIsEllAdicPullback
      (CategoryTheory.Limits.pullback.fst X.hom X.hom) ℓ (2 * d)
      (H_P (2 * d)) (H_X (2 * d)) fp₁_top)
    (hfp₂_top : WeilLefschetzIsEllAdicPullback
      (CategoryTheory.Limits.pullback.snd X.hom X.hom) ℓ (2 * d)
      (H_P (2 * d)) (H_X (2 * d)) fp₂_top)
    (cup_X : ∀ (i j : ℕ), i + j = 2 * d →
      (H_X i).V →ₗ[Padic ℓ] (H_X j).V →ₗ[Padic ℓ] (H_X (2 * d)).V)
    (hcup_X : ∀ (i j : ℕ) (hij : i + j = 2 * d),
      WeilLefschetzIsEllAdicCup X.left ℓ i j (2 * d) hij (H_X i) (H_X j) (H_X (2 * d))
        (cup_X i j hij))
    (cup_P_top : (H_P (2 * d)).V →ₗ[Padic ℓ] (H_P (2 * d)).V →ₗ[Padic ℓ] (H_P (4 * d)).V)
    (hcup_P_top : WeilLefschetzIsEllAdicCup
      (CategoryTheory.Limits.pullback X.hom X.hom) ℓ (2 * d) (2 * d) (4 * d) (by omega)
      (H_P (2 * d)) (H_P (2 * d)) (H_P (4 * d)) cup_P_top) :
    ∃ (η_X : (H_X (2 * d)).V →ₗ[Padic ℓ] Padic ℓ)
      (η_P : (H_P (4 * d)).V →ₗ[Padic ℓ] Padic ℓ),
      (∀ (i j : ℕ) (hij : i + j = 2 * d),
        Function.Bijective (fun u : (H_X i).V => η_X.comp (cup_X i j hij u))) ∧
      (∀ (u w : (H_X (2 * d)).V),
        η_P (cup_P_top (fp₁_top u) (fp₂_top w)) = η_X u * η_X w) :=
by
  obtain ⟨hPullTrans, hCupTrans⟩ := weil_lefschetz_torsion_pullback_and_cup_transition.{u} ℓ
  have hFin : ∀ (m r : ℕ), Finite (weilEtaleTorsionH X.left (ℓ ^ r) m) :=
    weil_lefschetz_proper_torsion_finiteness_algClosed k d X hInt ℓ hℓ
  obtain ⟨tr_X, tr_P, htr_X_bij, htr_X_compat, htr_P_compat, htr_prod⟩ :=
    weil_lefschetz_torsion_trace_and_product k d X hInt ℓ hℓ
  have hCupNonDeg := weil_lefschetz_torsion_cup_left_nondegenerate k d X hInt ℓ hℓ
  exact weil_lefschetz_ell_adic_trace_and_duality_of_torsion
    X.left (CategoryTheory.Limits.pullback X.hom X.hom) d ℓ
    (CategoryTheory.Limits.pullback.fst X.hom X.hom)
    (CategoryTheory.Limits.pullback.snd X.hom X.hom)
    H_X H_P fp₁_top fp₂_top hfp₁_top hfp₂_top cup_X hcup_X cup_P_top hcup_P_top
    (fun h r p_succ p_curr hp_succ hp_curr x =>
      hPullTrans h r (2 * d) p_succ p_curr hp_succ hp_curr x)
    (fun r i j hij c_succ c_curr hc_succ hc_curr x y =>
      hCupTrans X.left r i j (2 * d) hij c_succ c_curr hc_succ hc_curr x y)
    (fun r c_succ c_curr hc_succ hc_curr x y =>
      hCupTrans (CategoryTheory.Limits.pullback X.hom X.hom) r (2 * d) (2 * d) (4 * d)
        (by omega) c_succ c_curr hc_succ hc_curr x y)
    hFin tr_X tr_P htr_X_bij htr_X_compat htr_P_compat htr_prod hCupNonDeg

theorem weil_gysin_product_integral_proper_smooth (k : Type u) [Field k] [IsAlgClosed k]
    (d : ℕ) (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hInt : AlgebraicGeometry.IsIntegral X.left)
    [AlgebraicGeometry.IsProper X.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension d X.hom] :
    let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
    let P := CategoryTheory.Limits.pullback X.hom X.hom
    let p₁ := CategoryTheory.Limits.pullback.fst X.hom X.hom
    AlgebraicGeometry.IsIntegral P ∧
    AlgebraicGeometry.IsProper (CategoryTheory.CategoryStruct.comp p₁ X.hom) ∧
    AlgebraicGeometry.SmoothOfRelativeDimension (2 * d)
      (CategoryTheory.CategoryStruct.comp p₁ X.hom) ∧
    (∃ s₀ : Quiver.Hom S_k X.left,
      CategoryTheory.CategoryStruct.comp s₀ X.hom = CategoryTheory.CategoryStruct.id S_k) :=
by
  classical
  have : AlgebraicGeometry.IsIntegral X.left := hInt
  let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
  let P := CategoryTheory.Limits.pullback X.hom X.hom
  let p₁ := CategoryTheory.Limits.pullback.fst X.hom X.hom
  let p₂ := CategoryTheory.Limits.pullback.snd X.hom X.hom
  
  have hP_prop : AlgebraicGeometry.IsProper (CategoryTheory.CategoryStruct.comp p₁ X.hom) :=
    inferInstance
  have hp₁_sm : AlgebraicGeometry.SmoothOfRelativeDimension d p₁ :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (P := @AlgebraicGeometry.SmoothOfRelativeDimension d)
      (CategoryTheory.IsPullback.of_hasPullback X.hom X.hom).flip inferInstance
  have hP_sm : AlgebraicGeometry.SmoothOfRelativeDimension (2 * d)
      (CategoryTheory.CategoryStruct.comp p₁ X.hom) := by
    rw [Nat.two_mul d]
    exact AlgebraicGeometry.smoothOfRelativeDimension_comp d d p₁ X.hom
  
  have hs₀_ex : ∃ s₀ : Quiver.Hom S_k X.left,
      CategoryTheory.CategoryStruct.comp s₀ X.hom = CategoryTheory.CategoryStruct.id S_k := by
    obtain ⟨x₀⟩ := AlgebraicGeometry.IsIntegral.nonempty (X := X.left)
    obtain ⟨U₀, hU₀, hx₀, -⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (X := X.left) (U := ⊤) (x := x₀) trivial
    let R₀ : CommRingCat.{u} := X.left.presheaf.obj (Opposite.op U₀)
    have : IsDomain ↑R₀ :=
      @AlgebraicGeometry.IsIntegral.component_integral X.left hInt U₀ ⟨⟨x₀, hx₀⟩⟩
    obtain ⟨𝔪, h𝔪⟩ := Ideal.exists_maximal ↑R₀
    have : Ideal.IsMaximal 𝔪 := h𝔪
    letI : Field (↑R₀ ⧸ 𝔪) := Ideal.Quotient.field 𝔪
    have hg₀_lft :
        AlgebraicGeometry.LocallyOfFiniteType (hU₀.fromSpec ≫ X.hom) :=
      inferInstance
    let φ_k : CommRingCat.of k ⟶ R₀ := AlgebraicGeometry.Spec.preimage (hU₀.fromSpec ≫ X.hom)
    have hφ_k_spec : AlgebraicGeometry.Spec.map φ_k = hU₀.fromSpec ≫ X.hom :=
      AlgebraicGeometry.Spec.map_preimage (hU₀.fromSpec ≫ X.hom)
    have hφ_k_ft : φ_k.hom.FiniteType := by
      rw [← hφ_k_spec] at hg₀_lft
      exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp hg₀_lft
    let π_𝔪 : ↑R₀ →+* (↑R₀ ⧸ 𝔪) := Ideal.Quotient.mk 𝔪
    have hcomp_ft : (π_𝔪.comp φ_k.hom).FiniteType :=
      (RingHom.FiniteType.of_surjective π_𝔪 Ideal.Quotient.mk_surjective).comp hφ_k_ft
    have hcomp_fin : (π_𝔪.comp φ_k.hom).Finite :=
      RingHom.finite_iff_finiteType_of_isJacobsonRing.mpr hcomp_ft
    have hcomp_int : (π_𝔪.comp φ_k.hom).IsIntegral := RingHom.IsIntegral.of_finite hcomp_fin
    have hcomp_bij : Function.Bijective (π_𝔪.comp φ_k.hom) :=
      IsAlgClosed.ringHom_bijective_of_isIntegral (π_𝔪.comp φ_k.hom) hcomp_int
    let e_k : k ≃+* (↑R₀ ⧸ 𝔪) := RingEquiv.ofBijective (π_𝔪.comp φ_k.hom) hcomp_bij
    let ev₀ : ↑R₀ →+* k := e_k.symm.toRingHom.comp π_𝔪
    have hev₀_comp : CategoryTheory.CategoryStruct.comp φ_k (CommRingCat.ofHom ev₀) =
        CategoryTheory.CategoryStruct.id (CommRingCat.of k) := by
      ext c
      exact e_k.symm_apply_apply c
    refine ⟨CategoryTheory.CategoryStruct.comp
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev₀)) hU₀.fromSpec, ?_⟩
    change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev₀) ≫ hU₀.fromSpec) ≫ X.hom = 𝟙 S_k
    rw [CategoryTheory.Category.assoc, ← hφ_k_spec, ← AlgebraicGeometry.Spec.map_comp,
      hev₀_comp, AlgebraicGeometry.Spec.map_id]
  
  have hTensorDom : ∀ (A B : Type u) [CommRing A] [IsDomain A] [Algebra k A]
      [CommRing B] [IsDomain B] [Algebra k B],
      IsDomain (TensorProduct k A B) := by
    intro A B _ _ _ _ _ _
    let ι := ↥(Module.Basis.ofVectorSpaceIndex k B)
    let b_B : Module.Basis ι k B := Module.Basis.ofVectorSpace k B
    let b_AB : Module.Basis ι A (TensorProduct k A B) := Algebra.TensorProduct.basis A b_B
    obtain ⟨i_star⟩ := b_B.index_nonempty
    have hb_ne : b_AB i_star ≠ 0 := by
      intro h0
      have h1 : (b_AB.repr (b_AB i_star)) i_star = (1 : A) := by
        rw [b_AB.repr_self, Finsupp.single_eq_same]
      rw [h0, map_zero, Finsupp.zero_apply] at h1
      exact one_ne_zero h1.symm
    have : Nontrivial (TensorProduct k A B) := ⟨⟨b_AB i_star, 0, hb_ne⟩⟩
    have : NoZeroDivisors (TensorProduct k A B) := by
      refine ⟨fun {x y} hxy => ?_⟩
      by_contra h_not_or
      rcases not_or.mp h_not_or with ⟨hx, hy⟩
      let cx : ι →₀ A := b_AB.repr x
      let cy : ι →₀ A := b_AB.repr y
      have hcx_ne : cx ≠ 0 := fun h0 => hx (b_AB.repr.injective (h0.trans (map_zero _).symm))
      have hcy_ne : cy ≠ 0 := fun h0 => hy (b_AB.repr.injective (h0.trans (map_zero _).symm))
      obtain ⟨i₀, hi₀⟩ := Finsupp.support_nonempty_iff.mpr hcx_ne
      obtain ⟨j₀, hj₀⟩ := Finsupp.support_nonempty_iff.mpr hcy_ne
      have hx_sum : x = ∑ i ∈ cx.support, cx i ⊗ₜ[k] b_B i := by
        conv_lhs => rw [← b_AB.linearCombination_repr x]
        rw [Finsupp.linearCombination_apply]
        change (∑ i ∈ cx.support, cx i • b_AB i) = _
        apply Finset.sum_congr rfl
        intro i _
        rw [Algebra.TensorProduct.basis_apply, TensorProduct.smul_tmul', smul_eq_mul, mul_one]
      have hy_sum : y = ∑ j ∈ cy.support, cy j ⊗ₜ[k] b_B j := by
        conv_lhs => rw [← b_AB.linearCombination_repr y]
        rw [Finsupp.linearCombination_apply]
        change (∑ j ∈ cy.support, cy j • b_AB j) = _
        apply Finset.sum_congr rfl
        intro j _
        rw [Algebra.TensorProduct.basis_apply, TensorProduct.smul_tmul', smul_eq_mul, mul_one]
      let S : Finset A := cx.support.image cx ∪ cy.support.image cy
      let A₀ : Subalgebra k A := Algebra.adjoin k (S : Set A)
      have : Algebra.FiniteType k ↥A₀ := Algebra.FiniteType.adjoin_of_finite S.finite_toSet
      have hcx_mem : ∀ i ∈ cx.support, cx i ∈ A₀ := fun i hi =>
        Algebra.subset_adjoin
          (Finset.mem_coe.mpr (Finset.mem_union_left _ (Finset.mem_image_of_mem cx hi)))
      have hcy_mem : ∀ j ∈ cy.support, cy j ∈ A₀ := fun j hj =>
        Algebra.subset_adjoin
          (Finset.mem_coe.mpr (Finset.mem_union_right _ (Finset.mem_image_of_mem cy hj)))
      let x₀ : TensorProduct k ↥A₀ B :=
        ∑ i ∈ cx.support.attach, (⟨cx i.1, hcx_mem i.1 i.2⟩ : ↥A₀) ⊗ₜ[k] b_B i.1
      let y₀ : TensorProduct k ↥A₀ B :=
        ∑ j ∈ cy.support.attach, (⟨cy j.1, hcy_mem j.1 j.2⟩ : ↥A₀) ⊗ₜ[k] b_B j.1
      let Φ : TensorProduct k ↥A₀ B →ₐ[k] TensorProduct k A B :=
        Algebra.TensorProduct.map A₀.val (AlgHom.id k B)
      have hΦ_x₀ : Φ x₀ = x := by
        dsimp [x₀, Φ]
        rw [map_sum, hx_sum, ← Finset.sum_attach cx.support]
        apply Finset.sum_congr rfl
        intro i _
        exact Algebra.TensorProduct.map_tmul A₀.val (AlgHom.id k B) _ _
      have hΦ_y₀ : Φ y₀ = y := by
        dsimp [y₀, Φ]
        rw [map_sum, hy_sum, ← Finset.sum_attach cy.support]
        apply Finset.sum_congr rfl
        intro j _
        exact Algebra.TensorProduct.map_tmul A₀.val (AlgHom.id k B) _ _
      have hΦ_eq_rTensor : Φ.toLinearMap = LinearMap.rTensor B A₀.val.toLinearMap := by
        apply TensorProduct.ext'
        intro a b
        change Φ (a ⊗ₜ[k] b) = LinearMap.rTensor B A₀.val.toLinearMap (a ⊗ₜ[k] b)
        rw [Algebra.TensorProduct.map_tmul, LinearMap.rTensor_tmul]
        rfl
      have hΦ_inj : Function.Injective Φ := by
        change Function.Injective Φ.toLinearMap
        rw [hΦ_eq_rTensor]
        exact Module.Flat.rTensor_preserves_injective_linearMap (M := B)
          A₀.val.toLinearMap Subtype.val_injective
      have hx₀y₀ : x₀ * y₀ = 0 := by
        apply hΦ_inj
        rw [map_mul, hΦ_x₀, hΦ_y₀, hxy, map_zero]
      let a_x : ↥A₀ := ⟨cx i₀, hcx_mem i₀ hi₀⟩
      let a_y : ↥A₀ := ⟨cy j₀, hcy_mem j₀ hj₀⟩
      have ha_x_ne : a_x ≠ 0 :=
        fun h0 => (Finsupp.mem_support_iff.mp hi₀) (congrArg Subtype.val h0)
      have ha_y_ne : a_y ≠ 0 :=
        fun h0 => (Finsupp.mem_support_iff.mp hj₀) (congrArg Subtype.val h0)
      let g : ↥A₀ := a_x * a_y
      have hg_ne : g ≠ 0 := mul_ne_zero ha_x_ne ha_y_ne
      have : IsJacobsonRing ↥A₀ := isJacobsonRing_of_finiteType (A := k)
      have hjac_bot : Ring.jacobson ↥A₀ = (⊥ : Ideal ↥A₀) := by
        rw [← Ideal.jacobson_bot]
        exact IsJacobsonRing.out' (⊥ : Ideal ↥A₀) (Ideal.IsPrime.isRadical inferInstance)
      have hsInf_bot : sInf {M : Ideal ↥A₀ | M.IsMaximal} = (⊥ : Ideal ↥A₀) := by
        rw [← Ring.jacobson_eq_sInf_isMaximal, hjac_bot]
      have hg_not_sInf : g ∉ sInf {M : Ideal ↥A₀ | M.IsMaximal} := by
        rw [hsInf_bot, Ideal.mem_bot]
        exact hg_ne
      rw [Ideal.mem_sInf] at hg_not_sInf
      obtain ⟨M, hM_not⟩ := not_forall.mp hg_not_sInf
      obtain ⟨hM_max, hg_not_M⟩ := Classical.not_imp.mp hM_not
      have : Ideal.IsMaximal M := hM_max
      letI : Field (↥A₀ ⧸ M) := Ideal.Quotient.field M
      let π_M : ↥A₀ →+* (↥A₀ ⧸ M) := Ideal.Quotient.mk M
      let f₀ : k →+* ↥A₀ := algebraMap k ↥A₀
      have hf₀_ft : f₀.FiniteType := RingHom.finiteType_algebraMap.mpr inferInstance
      have hπf₀_ft : (π_M.comp f₀).FiniteType :=
        (RingHom.FiniteType.of_surjective π_M Ideal.Quotient.mk_surjective).comp hf₀_ft
      have hπf₀_fin : (π_M.comp f₀).Finite :=
        RingHom.finite_iff_finiteType_of_isJacobsonRing.mpr hπf₀_ft
      have hπf₀_int : (π_M.comp f₀).IsIntegral := RingHom.IsIntegral.of_finite hπf₀_fin
      have hπf₀_bij : Function.Bijective (π_M.comp f₀) :=
        IsAlgClosed.ringHom_bijective_of_isIntegral (π_M.comp f₀) hπf₀_int
      let e_M : k ≃+* (↥A₀ ⧸ M) := RingEquiv.ofBijective (π_M.comp f₀) hπf₀_bij
      let χ : ↥A₀ →ₐ[k] k :=
        { toRingHom := e_M.symm.toRingHom.comp π_M
          commutes' := fun c => e_M.symm_apply_apply c }
      have hχ_g_ne : χ g ≠ 0 := by
        intro h0
        apply hg_not_M
        rw [← Ideal.Quotient.eq_zero_iff_mem]
        apply e_M.symm.injective
        rw [map_zero]
        exact h0
      have hχ_ax_ne : χ a_x ≠ 0 :=
        fun h0 => hχ_g_ne (by dsimp [g]; rw [map_mul, h0, zero_mul])
      have hχ_ay_ne : χ a_y ≠ 0 :=
        fun h0 => hχ_g_ne (by dsimp [g]; rw [map_mul, h0, mul_zero])
      let Ψ : TensorProduct k ↥A₀ B →ₐ[k] B :=
        (Algebra.TensorProduct.lid k B).toAlgHom.comp
          (Algebra.TensorProduct.map χ (AlgHom.id k B))
      have hΨ_tmul : ∀ (a : ↥A₀) (b : B), Ψ (a ⊗ₜ[k] b) = χ a • b := by
        intro a b
        simp [Ψ]
      have hΨ_x₀_ne : Ψ x₀ ≠ 0 := by
        intro h0
        have hcoord : (b_B.repr (Ψ x₀)) i₀ = χ a_x := by
          dsimp [x₀]
          rw [map_sum, map_sum, Finsupp.finsetSum_apply]
          rw [Finset.sum_eq_single ⟨i₀, hi₀⟩]
          · rw [hΨ_tmul, map_smul, b_B.repr_self, Finsupp.smul_single, smul_eq_mul, mul_one,
              Finsupp.single_eq_same]
          · intro i _ hi_ne
            have hval_ne : i.1 ≠ i₀ := fun heq => hi_ne (Subtype.ext heq)
            rw [hΨ_tmul, map_smul, b_B.repr_self, Finsupp.smul_single,
              Finsupp.single_eq_of_ne (Ne.symm hval_ne)]
          · intro hnot
            exact absurd (Finset.mem_attach cx.support ⟨i₀, hi₀⟩) hnot
        rw [h0, map_zero, Finsupp.zero_apply] at hcoord
        exact hχ_ax_ne hcoord.symm
      have hΨ_y₀_ne : Ψ y₀ ≠ 0 := by
        intro h0
        have hcoord : (b_B.repr (Ψ y₀)) j₀ = χ a_y := by
          dsimp [y₀]
          rw [map_sum, map_sum, Finsupp.finsetSum_apply]
          rw [Finset.sum_eq_single ⟨j₀, hj₀⟩]
          · rw [hΨ_tmul, map_smul, b_B.repr_self, Finsupp.smul_single, smul_eq_mul, mul_one,
              Finsupp.single_eq_same]
          · intro j _ hj_ne
            have hval_ne : j.1 ≠ j₀ := fun heq => hj_ne (Subtype.ext heq)
            rw [hΨ_tmul, map_smul, b_B.repr_self, Finsupp.smul_single,
              Finsupp.single_eq_of_ne (Ne.symm hval_ne)]
          · intro hnot
            exact absurd (Finset.mem_attach cy.support ⟨j₀, hj₀⟩) hnot
        rw [h0, map_zero, Finsupp.zero_apply] at hcoord
        exact hχ_ay_ne hcoord.symm
      have hΨ_prod_zero : Ψ x₀ * Ψ y₀ = 0 := by
        rw [← map_mul, hx₀y₀, map_zero]
      exact mul_ne_zero hΨ_x₀_ne hΨ_y₀_ne hΨ_prod_zero
    exact NoZeroDivisors.to_isDomain (TensorProduct k A B)
  
  let 𝒰 := X.left.affineCover
  let 𝒰_P := AlgebraicGeometry.Scheme.Pullback.openCoverOfLeftRight 𝒰 𝒰 X.hom X.hom
  have hChartInt : ∀ (i j : 𝒰.I₀), Nonempty ↥(𝒰.X i) → Nonempty ↥(𝒰.X j) →
      AlgebraicGeometry.IsIntegral (𝒰_P.X (i, j)) := by
    intro i j hi hj
    have : Nonempty ↥(𝒰.X i) := hi
    have : Nonempty ↥(𝒰.X j) := hj
    have hInt_i : AlgebraicGeometry.IsIntegral (𝒰.X i) :=
      AlgebraicGeometry.isIntegral_of_isOpenImmersion (𝒰.f i)
    have hInt_j : AlgebraicGeometry.IsIntegral (𝒰.X j) :=
      AlgebraicGeometry.isIntegral_of_isOpenImmersion (𝒰.f j)
    let R₁ : CommRingCat.{u} := (𝒰.X i).presheaf.obj (Opposite.op ⊤)
    let R₂ : CommRingCat.{u} := (𝒰.X j).presheaf.obj (Opposite.op ⊤)
    let e₁ : 𝒰.X i ≅ AlgebraicGeometry.Spec R₁ := (𝒰.X i).isoSpec
    let e₂ : 𝒰.X j ≅ AlgebraicGeometry.Spec R₂ := (𝒰.X j).isoSpec
    have : Nonempty ↥(AlgebraicGeometry.Spec R₁) := ⟨e₁.hom.base (Classical.choice hi)⟩
    have : Nonempty ↥(AlgebraicGeometry.Spec R₂) := ⟨e₂.hom.base (Classical.choice hj)⟩
    have hInt_Spec1 : AlgebraicGeometry.IsIntegral (AlgebraicGeometry.Spec R₁) :=
      AlgebraicGeometry.isIntegral_of_isOpenImmersion e₁.inv
    have hInt_Spec2 : AlgebraicGeometry.IsIntegral (AlgebraicGeometry.Spec R₂) :=
      AlgebraicGeometry.isIntegral_of_isOpenImmersion e₂.inv
    have : IsDomain ↑R₁ := (AlgebraicGeometry.affine_isIntegral_iff R₁).mp hInt_Spec1
    have : IsDomain ↑R₂ := (AlgebraicGeometry.affine_isIntegral_iff R₂).mp hInt_Spec2
    let φ₁ : CommRingCat.of k ⟶ R₁ :=
      AlgebraicGeometry.Spec.preimage (e₁.inv ≫ 𝒰.f i ≫ X.hom)
    let φ₂ : CommRingCat.of k ⟶ R₂ :=
      AlgebraicGeometry.Spec.preimage (e₂.inv ≫ 𝒰.f j ≫ X.hom)
    have hφ₁ : AlgebraicGeometry.Spec.map φ₁ = e₁.inv ≫ 𝒰.f i ≫ X.hom :=
      AlgebraicGeometry.Spec.map_preimage _
    have hφ₂ : AlgebraicGeometry.Spec.map φ₂ = e₂.inv ≫ 𝒰.f j ≫ X.hom :=
      AlgebraicGeometry.Spec.map_preimage _
    letI : Algebra k ↑R₁ := φ₁.hom.toAlgebra
    letI : Algebra k ↑R₂ := φ₂.hom.toAlgebra
    have : IsDomain (TensorProduct k ↑R₁ ↑R₂) := hTensorDom ↑R₁ ↑R₂
    have hInt_Tensor : AlgebraicGeometry.IsIntegral
        (AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct k ↑R₁ ↑R₂))) :=
      (AlgebraicGeometry.affine_isIntegral_iff
        (CommRingCat.of (TensorProduct k ↑R₁ ↑R₂))).mpr inferInstance
    have h_hom_cond :
        (CategoryTheory.Limits.pullback.fst (𝒰.f i ≫ X.hom) (𝒰.f j ≫ X.hom) ≫ e₁.hom) ≫
            AlgebraicGeometry.Spec.map φ₁ =
          (CategoryTheory.Limits.pullback.snd (𝒰.f i ≫ X.hom) (𝒰.f j ≫ X.hom) ≫ e₂.hom) ≫
            AlgebraicGeometry.Spec.map φ₂ := by
      rw [CategoryTheory.Category.assoc, hφ₁, ← CategoryTheory.Category.assoc e₁.hom,
        e₁.hom_inv_id, CategoryTheory.Category.id_comp,
        CategoryTheory.Category.assoc, hφ₂, ← CategoryTheory.Category.assoc e₂.hom,
        e₂.hom_inv_id, CategoryTheory.Category.id_comp,
        CategoryTheory.Limits.pullback.condition]
    have h_inv_cond :
        (CategoryTheory.Limits.pullback.fst (AlgebraicGeometry.Spec.map φ₁)
            (AlgebraicGeometry.Spec.map φ₂) ≫ e₁.inv) ≫ (𝒰.f i ≫ X.hom) =
          (CategoryTheory.Limits.pullback.snd (AlgebraicGeometry.Spec.map φ₁)
            (AlgebraicGeometry.Spec.map φ₂) ≫ e₂.inv) ≫ (𝒰.f j ≫ X.hom) := by
      rw [CategoryTheory.Category.assoc, ← hφ₁, CategoryTheory.Category.assoc, ← hφ₂,
        CategoryTheory.Limits.pullback.condition]
    let e_pull : CategoryTheory.Limits.pullback (𝒰.f i ≫ X.hom) (𝒰.f j ≫ X.hom) ≅
        CategoryTheory.Limits.pullback
          (AlgebraicGeometry.Spec.map φ₁) (AlgebraicGeometry.Spec.map φ₂) :=
      { hom := CategoryTheory.Limits.pullback.lift _ _ h_hom_cond
        inv := CategoryTheory.Limits.pullback.lift _ _ h_inv_cond
        hom_inv_id := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pullback.lift_fst, ← CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.assoc,
              e₁.hom_inv_id, CategoryTheory.Category.comp_id]
          · rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pullback.lift_snd, ← CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.assoc,
              e₂.hom_inv_id, CategoryTheory.Category.comp_id]
        inv_hom_id := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pullback.lift_fst, ← CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.assoc,
              e₁.inv_hom_id, CategoryTheory.Category.comp_id]
          · rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pullback.lift_snd, ← CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.assoc,
              e₂.inv_hom_id, CategoryTheory.Category.comp_id] }
    let e_ij : 𝒰_P.X (i, j) ≅
        AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct k ↑R₁ ↑R₂)) :=
      e_pull ≪≫ AlgebraicGeometry.pullbackSpecIso k ↑R₁ ↑R₂
    obtain ⟨t₀⟩ := AlgebraicGeometry.IsIntegral.nonempty
      (X := AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct k ↑R₁ ↑R₂)))
    have : Nonempty ↥(𝒰_P.X (i, j)) := ⟨e_ij.inv.base t₀⟩
    exact AlgebraicGeometry.isIntegral_of_isOpenImmersion e_ij.hom
  have hRed_pieces : ∀ (ij : 𝒰_P.I₀), AlgebraicGeometry.IsReduced (𝒰_P.X ij) := by
    rintro ⟨i, j⟩
    by_cases hne : Nonempty ↥(𝒰.X i) ∧ Nonempty ↥(𝒰.X j)
    · have : AlgebraicGeometry.IsIntegral (𝒰_P.X (i, j)) :=
        hChartInt i j hne.1 hne.2
      exact inferInstance
    · have hEmpty : IsEmpty ↥(𝒰_P.X (i, j)) := by
        refine ⟨fun u => hne ?_⟩
        exact ⟨⟨(CategoryTheory.Limits.pullback.fst (𝒰.f i ≫ X.hom) (𝒰.f j ≫ X.hom)).base u⟩,
          ⟨(CategoryTheory.Limits.pullback.snd (𝒰.f i ≫ X.hom) (𝒰.f j ≫ X.hom)).base u⟩⟩
      have : ∀ q : ↥(𝒰_P.X (i, j)), _root_.IsReduced ↑((𝒰_P.X (i, j)).presheaf.stalk q) :=
        fun q => hEmpty.elim q
      exact AlgebraicGeometry.isReduced_of_isReduced_stalk (𝒰_P.X (i, j))
  have hP_red : AlgebraicGeometry.IsReduced P :=
    AlgebraicGeometry.IsReduced.of_openCover P 𝒰_P
  
  have hMemRange : ∀ (ij : 𝒰.I₀ × 𝒰.I₀) (q : ↥P),
      p₁.base q ∈ Set.range (𝒰.f ij.1).base →
      p₂.base q ∈ Set.range (𝒰.f ij.2).base →
      q ∈ Set.range (𝒰_P.f ij).base := by
    intro ij q hq₁ hq₂
    let κ_q : AlgebraicGeometry.Spec (P.residueField q) ⟶ P := P.fromSpecResidueField q
    have hr₁ : Set.range (κ_q ≫ p₁).base ⊆ Set.range (𝒰.f ij.1).base := by
      rintro _ ⟨s, rfl⟩
      have hs : (κ_q ≫ p₁).base s = p₁.base q := by
        rw [AlgebraicGeometry.Scheme.Hom.comp_apply, P.fromSpecResidueField_apply q s]
      rw [hs]
      exact hq₁
    have hr₂ : Set.range (κ_q ≫ p₂).base ⊆ Set.range (𝒰.f ij.2).base := by
      rintro _ ⟨s, rfl⟩
      have hs : (κ_q ≫ p₂).base s = p₂.base q := by
        rw [AlgebraicGeometry.Scheme.Hom.comp_apply, P.fromSpecResidueField_apply q s]
      rw [hs]
      exact hq₂
    let g₁ : AlgebraicGeometry.Spec (P.residueField q) ⟶ 𝒰.X ij.1 :=
      AlgebraicGeometry.IsOpenImmersion.lift (𝒰.f ij.1) (κ_q ≫ p₁) hr₁
    have hg₁ : g₁ ≫ 𝒰.f ij.1 = κ_q ≫ p₁ :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac (𝒰.f ij.1) (κ_q ≫ p₁) hr₁
    let g₂ : AlgebraicGeometry.Spec (P.residueField q) ⟶ 𝒰.X ij.2 :=
      AlgebraicGeometry.IsOpenImmersion.lift (𝒰.f ij.2) (κ_q ≫ p₂) hr₂
    have hg₂ : g₂ ≫ 𝒰.f ij.2 = κ_q ≫ p₂ :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac (𝒰.f ij.2) (κ_q ≫ p₂) hr₂
    have hg_cond : g₁ ≫ (𝒰.f ij.1 ≫ X.hom) = g₂ ≫ (𝒰.f ij.2 ≫ X.hom) := by
      rw [← CategoryTheory.Category.assoc, hg₁, CategoryTheory.Category.assoc,
        CategoryTheory.Limits.pullback.condition,
        ← CategoryTheory.Category.assoc g₂, hg₂, CategoryTheory.Category.assoc]
    let g_ij : AlgebraicGeometry.Spec (P.residueField q) ⟶
        CategoryTheory.Limits.pullback (𝒰.f ij.1 ≫ X.hom) (𝒰.f ij.2 ≫ X.hom) :=
      CategoryTheory.Limits.pullback.lift g₁ g₂ hg_cond
    let f_map : CategoryTheory.Limits.pullback (𝒰.f ij.1 ≫ X.hom) (𝒰.f ij.2 ≫ X.hom) ⟶ P :=
      CategoryTheory.Limits.pullback.map (𝒰.f ij.1 ≫ X.hom) (𝒰.f ij.2 ≫ X.hom)
        X.hom X.hom (𝒰.f ij.1) (𝒰.f ij.2) (𝟙 S_k)
        (CategoryTheory.Category.comp_id _).symm (CategoryTheory.Category.comp_id _).symm
    have hg_map : g_ij ≫ f_map = κ_q := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · dsimp only [g_ij, f_map, CategoryTheory.Limits.pullback.map]
        rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst, hg₁]
      · dsimp only [g_ij, f_map, CategoryTheory.Limits.pullback.map]
        rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd, hg₂]
    have hf_map_eq : 𝒰_P.f ij = f_map :=
      AlgebraicGeometry.Scheme.Pullback.openCoverOfLeftRight_f 𝒰 𝒰 X.hom X.hom ij
    have hg_ij_f : (g_ij : AlgebraicGeometry.Spec (P.residueField q) ⟶ 𝒰_P.X ij) ≫ 𝒰_P.f ij =
        κ_q :=
      (congrArg (fun h : 𝒰_P.X ij ⟶ P =>
        (g_ij : AlgebraicGeometry.Spec (P.residueField q) ⟶ 𝒰_P.X ij) ≫ h) hf_map_eq).trans hg_map
    obtain ⟨pt_q, hpt_q⟩ : q ∈ Set.range κ_q.base := by
      rw [P.range_fromSpecResidueField q]
      exact Set.mem_singleton q
    refine ⟨g_ij.base pt_q, ?_⟩
    exact (AlgebraicGeometry.Scheme.Hom.comp_apply
      (g_ij : AlgebraicGeometry.Spec (P.residueField q) ⟶ 𝒰_P.X ij) (𝒰_P.f ij) pt_q).symm.trans
      ((congrArg (fun h => h.base pt_q) hg_ij_f).trans hpt_q)
  obtain ⟨x_any⟩ := AlgebraicGeometry.IsIntegral.nonempty (X := X.left)
  obtain ⟨p_any, -, -⟩ :=
    AlgebraicGeometry.Scheme.exists_preimage_of_isPullback
      (CategoryTheory.IsPullback.of_hasPullback X.hom X.hom)
      x_any x_any (Subsingleton.elim _ _)
  have hP_nonempty : Nonempty ↥P := ⟨p_any⟩
  have hP_preirr : PreirreducibleSpace ↥P := by
    refine ⟨fun O₁ O₂ hO₁ hO₂ ⟨q₁, _, hq₁⟩ ⟨q₂, _, hq₂⟩ => ?_⟩
    let α₁ : 𝒰.I₀ × 𝒰.I₀ := 𝒰_P.idx q₁
    let α₂ : 𝒰.I₀ × 𝒰.I₀ := 𝒰_P.idx q₂
    obtain ⟨u₁, hu₁⟩ := 𝒰_P.covers q₁
    obtain ⟨u₂, hu₂⟩ := 𝒰_P.covers q₂
    let a₁ : ↥(𝒰.X α₁.1) :=
      (CategoryTheory.Limits.pullback.fst (𝒰.f α₁.1 ≫ X.hom) (𝒰.f α₁.2 ≫ X.hom)).base u₁
    let b₁ : ↥(𝒰.X α₁.2) :=
      (CategoryTheory.Limits.pullback.snd (𝒰.f α₁.1 ≫ X.hom) (𝒰.f α₁.2 ≫ X.hom)).base u₁
    let a₂ : ↥(𝒰.X α₂.1) :=
      (CategoryTheory.Limits.pullback.fst (𝒰.f α₂.1 ≫ X.hom) (𝒰.f α₂.2 ≫ X.hom)).base u₂
    let b₂ : ↥(𝒰.X α₂.2) :=
      (CategoryTheory.Limits.pullback.snd (𝒰.f α₂.1 ≫ X.hom) (𝒰.f α₂.2 ≫ X.hom)).base u₂
    have hInt_α₁ : AlgebraicGeometry.IsIntegral (𝒰_P.X α₁) :=
      hChartInt α₁.1 α₁.2 ⟨a₁⟩ ⟨b₁⟩
    have hInt_α₂ : AlgebraicGeometry.IsIntegral (𝒰_P.X α₂) :=
      hChartInt α₂.1 α₂.2 ⟨a₂⟩ ⟨b₂⟩
    let W₁ : Set ↥P := Set.range (𝒰_P.f α₁).base
    let W₂ : Set ↥P := Set.range (𝒰_P.f α₂).base
    have hW₂_open : IsOpen W₂ := (𝒰_P.f α₂).isOpenEmbedding.isOpen_range
    have hW₁_irr : IsIrreducible W₁ := by
      dsimp [W₁]
      rw [← Set.image_univ]
      exact (IrreducibleSpace.isIrreducible_univ (X := ↥(𝒰_P.X α₁))).image _
        (𝒰_P.f α₁).isOpenEmbedding.continuous.continuousOn
    have hW₂_irr : IsIrreducible W₂ := by
      dsimp [W₂]
      rw [← Set.image_univ]
      exact (IrreducibleSpace.isIrreducible_univ (X := ↥(𝒰_P.X α₂))).image _
        (𝒰_P.f α₂).isOpenEmbedding.continuous.continuousOn
    obtain ⟨z₁, -, hz₁_1, hz₁_2⟩ :=
      (PreirreducibleSpace.isPreirreducible_univ (X := ↥X.left))
        (Set.range (𝒰.f α₁.1).base) (Set.range (𝒰.f α₂.1).base)
        (𝒰.f α₁.1).isOpenEmbedding.isOpen_range (𝒰.f α₂.1).isOpenEmbedding.isOpen_range
        ⟨(𝒰.f α₁.1).base a₁, trivial, ⟨a₁, rfl⟩⟩
        ⟨(𝒰.f α₂.1).base a₂, trivial, ⟨a₂, rfl⟩⟩
    obtain ⟨z₂, -, hz₂_1, hz₂_2⟩ :=
      (PreirreducibleSpace.isPreirreducible_univ (X := ↥X.left))
        (Set.range (𝒰.f α₁.2).base) (Set.range (𝒰.f α₂.2).base)
        (𝒰.f α₁.2).isOpenEmbedding.isOpen_range (𝒰.f α₂.2).isOpenEmbedding.isOpen_range
        ⟨(𝒰.f α₁.2).base b₁, trivial, ⟨b₁, rfl⟩⟩
        ⟨(𝒰.f α₂.2).base b₂, trivial, ⟨b₂, rfl⟩⟩
    obtain ⟨q, hq_p₁, hq_p₂⟩ :=
      AlgebraicGeometry.Scheme.exists_preimage_of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback X.hom X.hom)
        z₁ z₂ (Subsingleton.elim _ _)
    have hq_W₁ : q ∈ W₁ :=
      hMemRange α₁ q (hq_p₁.symm ▸ hz₁_1) (hq_p₂.symm ▸ hz₂_1)
    have hq_W₂ : q ∈ W₂ :=
      hMemRange α₂ q (hq_p₁.symm ▸ hz₁_2) (hq_p₂.symm ▸ hz₂_2)
    obtain ⟨r, -, hr_O₁, hr_W₂⟩ :=
      hW₁_irr.isPreirreducible O₁ W₂ hO₁ hW₂_open ⟨q₁, ⟨u₁, hu₁⟩, hq₁⟩ ⟨q, hq_W₁, hq_W₂⟩
    obtain ⟨p, -, hp_O₁, hp_O₂⟩ :=
      hW₂_irr.isPreirreducible O₁ O₂ hO₁ hO₂ ⟨r, hr_W₂, hr_O₁⟩ ⟨q₂, ⟨u₂, hu₂⟩, hq₂⟩
    exact ⟨p, trivial, hp_O₁, hp_O₂⟩
  have hP_irr : IrreducibleSpace ↥P := ⟨hP_nonempty⟩
  have hP_int : AlgebraicGeometry.IsIntegral P :=
    AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced P
  exact ⟨hP_int, hP_prop, hP_sm, hs₀_ex⟩

theorem weil_gysin_fixed_point_scheme_clopen_sections (k : Type u) [Field k] [IsAlgClosed k]
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsProper X.hom]
    (φ : Quiver.Hom X.left X.left)
    (hφ : CategoryTheory.CategoryStruct.comp φ X.hom = X.hom)
    (hW_fin : AlgebraicGeometry.IsFinite
      (CategoryTheory.CategoryStruct.comp
        (CategoryTheory.Limits.pullback.fst
          (CategoryTheory.Limits.pullback.diagonal X.hom)
          (CategoryTheory.Limits.pullback.lift (CategoryTheory.CategoryStruct.id X.left) φ
            ((CategoryTheory.Category.id_comp X.hom).trans hφ.symm)))
        X.hom))
    (hW_et : AlgebraicGeometry.Etale
      (CategoryTheory.CategoryStruct.comp
        (CategoryTheory.Limits.pullback.fst
          (CategoryTheory.Limits.pullback.diagonal X.hom)
          (CategoryTheory.Limits.pullback.lift (CategoryTheory.CategoryStruct.id X.left) φ
            ((CategoryTheory.Category.id_comp X.hom).trans hφ.symm)))
        X.hom)) :
    let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
    let Δ := CategoryTheory.Limits.pullback.diagonal X.hom
    let Γ_φ := CategoryTheory.Limits.pullback.lift (CategoryTheory.CategoryStruct.id X.left) φ
      ((CategoryTheory.Category.id_comp X.hom).trans hφ.symm)
    let W := CategoryTheory.Limits.pullback Δ Γ_φ
    let i_W := CategoryTheory.Limits.pullback.fst Δ Γ_φ
    (Finite ↥W ∧
      DiscreteTopology ↥W ∧
      AlgebraicGeometry.IsClosedImmersion Δ ∧
      AlgebraicGeometry.IsClosedImmersion Γ_φ ∧
      AlgebraicGeometry.IsClosedImmersion i_W ∧
      i_W = CategoryTheory.Limits.pullback.snd Δ Γ_φ ∧
      CategoryTheory.CategoryStruct.comp i_W φ = i_W) ∧
    (∃ s'_W : ∀ _ : ↥W, Quiver.Hom S_k W,
      ∀ w : ↥W,
        AlgebraicGeometry.IsOpenImmersion (s'_W w) ∧
        Set.range (s'_W w).base = {w} ∧
        CategoryTheory.CategoryStruct.comp
          (CategoryTheory.CategoryStruct.comp (s'_W w) i_W) X.hom =
          CategoryTheory.CategoryStruct.id S_k) ∧
    (∀ (U₂ U' : X.left.Opens)
        (hU₂ : AlgebraicGeometry.IsAffineOpen U₂)
        (hU' : AlgebraicGeometry.IsAffineOpen U')
        (hle : U' ≤ U₂)
        (he_φ : U' ≤ (TopologicalSpace.Opens.map φ.base).obj U₂)
        (f_k : k →+* ↑(X.left.presheaf.obj (Opposite.op U'))),
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_k) =
        CategoryTheory.CategoryStruct.comp hU'.fromSpec X.hom →
      ((Ideal.Quotient.mk (Ideal.span (Set.range
        (fun a : ↑(X.left.presheaf.obj (Opposite.op U₂)) =>
          (X.left.presheaf.map (CategoryTheory.homOfLE hle).op).hom a -
            (AlgebraicGeometry.Scheme.Hom.appLE φ U₂ U' he_φ).hom a)))).comp f_k).Etale) :=
by
  classical
  let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
  let Δ := CategoryTheory.Limits.pullback.diagonal X.hom
  let Γ_φ := CategoryTheory.Limits.pullback.lift (CategoryTheory.CategoryStruct.id X.left) φ
    ((CategoryTheory.Category.id_comp X.hom).trans hφ.symm)
  let W := CategoryTheory.Limits.pullback Δ Γ_φ
  let i_W := CategoryTheory.Limits.pullback.fst Δ Γ_φ
  have h_step1 : ∀ (Y S : AlgebraicGeometry.Scheme.{u}) (f : Y ⟶ S)
      [AlgebraicGeometry.IsSeparated f] (ψ : Y ⟶ Y) (hψ : ψ ≫ f = f),
      let Δ₀ := CategoryTheory.Limits.pullback.diagonal f
      let Γ₀ := CategoryTheory.Limits.pullback.lift (𝟙 Y) ψ
        ((CategoryTheory.Category.id_comp f).trans hψ.symm)
      let W₀ := CategoryTheory.Limits.pullback Δ₀ Γ₀
      let i₀ := CategoryTheory.Limits.pullback.fst Δ₀ Γ₀
      AlgebraicGeometry.IsClosedImmersion Δ₀ ∧
      AlgebraicGeometry.IsClosedImmersion Γ₀ ∧
      AlgebraicGeometry.IsClosedImmersion i₀ ∧
      i₀ = CategoryTheory.Limits.pullback.snd Δ₀ Γ₀ ∧
      i₀ ≫ ψ = i₀ ∧
      CategoryTheory.Mono i₀ ∧
      (∀ (T : AlgebraicGeometry.Scheme.{u}) (g : T ⟶ Y),
        g ≫ ψ = g → ∃ l : T ⟶ W₀, l ≫ i₀ = g) := by
    intro Y S f _ ψ hψ
    let p₁ := CategoryTheory.Limits.pullback.fst f f
    let p₂ := CategoryTheory.Limits.pullback.snd f f
    let Δ₀ := CategoryTheory.Limits.pullback.diagonal f
    let Γ₀ := CategoryTheory.Limits.pullback.lift (𝟙 Y) ψ
      ((CategoryTheory.Category.id_comp f).trans hψ.symm)
    let W₀ := CategoryTheory.Limits.pullback Δ₀ Γ₀
    let i₀ := CategoryTheory.Limits.pullback.fst Δ₀ Γ₀
    let j₀ := CategoryTheory.Limits.pullback.snd Δ₀ Γ₀
    have hcond : i₀ ≫ Δ₀ = j₀ ≫ Γ₀ := CategoryTheory.Limits.pullback.condition
    have hi_snd : i₀ = j₀ := by
      calc
        i₀ = i₀ ≫ 𝟙 Y := (CategoryTheory.Category.comp_id i₀).symm
        _ = i₀ ≫ (Δ₀ ≫ p₁) := by rw [CategoryTheory.Limits.pullback.diagonal_fst f]
        _ = (i₀ ≫ Δ₀) ≫ p₁ := (CategoryTheory.Category.assoc i₀ Δ₀ p₁).symm
        _ = (j₀ ≫ Γ₀) ≫ p₁ := congrArg (fun m => m ≫ p₁) hcond
        _ = j₀ ≫ (Γ₀ ≫ p₁) := CategoryTheory.Category.assoc j₀ Γ₀ p₁
        _ = j₀ ≫ 𝟙 Y := by rw [CategoryTheory.Limits.pullback.lift_fst]
        _ = j₀ := CategoryTheory.Category.comp_id j₀
    have hi_ψ : i₀ ≫ ψ = i₀ := by
      calc
        i₀ ≫ ψ = j₀ ≫ ψ := by rw [hi_snd]
        _ = j₀ ≫ (Γ₀ ≫ p₂) := by rw [CategoryTheory.Limits.pullback.lift_snd]
        _ = (j₀ ≫ Γ₀) ≫ p₂ := (CategoryTheory.Category.assoc j₀ Γ₀ p₂).symm
        _ = (i₀ ≫ Δ₀) ≫ p₂ := congrArg (fun m => m ≫ p₂) hcond.symm
        _ = i₀ ≫ (Δ₀ ≫ p₂) := CategoryTheory.Category.assoc i₀ Δ₀ p₂
        _ = i₀ ≫ 𝟙 Y := by rw [CategoryTheory.Limits.pullback.diagonal_snd f]
        _ = i₀ := CategoryTheory.Category.comp_id i₀
    have hi_mono : CategoryTheory.Mono i₀ :=
      ⟨fun a b hab => by
        apply CategoryTheory.Limits.pullback.hom_ext
        · exact hab
        · change a ≫ j₀ = b ≫ j₀
          rw [← hi_snd]
          exact hab⟩
    have h_univ : ∀ (T : AlgebraicGeometry.Scheme.{u}) (g : T ⟶ Y),
        g ≫ ψ = g → ∃ l : T ⟶ W₀, l ≫ i₀ = g := by
      intro T g hg
      have hg_eq : g ≫ Δ₀ = g ≫ Γ₀ := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · calc
            (g ≫ Δ₀) ≫ p₁ = g ≫ (Δ₀ ≫ p₁) := CategoryTheory.Category.assoc g Δ₀ p₁
            _ = g ≫ 𝟙 Y := by rw [CategoryTheory.Limits.pullback.diagonal_fst f]
            _ = g ≫ (Γ₀ ≫ p₁) := by rw [CategoryTheory.Limits.pullback.lift_fst]
            _ = (g ≫ Γ₀) ≫ p₁ := (CategoryTheory.Category.assoc g Γ₀ p₁).symm
        · calc
            (g ≫ Δ₀) ≫ p₂ = g ≫ (Δ₀ ≫ p₂) := CategoryTheory.Category.assoc g Δ₀ p₂
            _ = g ≫ 𝟙 Y := by rw [CategoryTheory.Limits.pullback.diagonal_snd f]
            _ = g := CategoryTheory.Category.comp_id g
            _ = g ≫ ψ := hg.symm
            _ = g ≫ (Γ₀ ≫ p₂) := by rw [CategoryTheory.Limits.pullback.lift_snd]
            _ = (g ≫ Γ₀) ≫ p₂ := (CategoryTheory.Category.assoc g Γ₀ p₂).symm
      exact ⟨CategoryTheory.Limits.pullback.lift g g hg_eq,
        CategoryTheory.Limits.pullback.lift_fst g g hg_eq⟩
    have hΔ_cl : AlgebraicGeometry.IsClosedImmersion Δ₀ :=
      AlgebraicGeometry.IsSeparated.isClosedImmersion_diagonal
    have hΓ_cl : AlgebraicGeometry.IsClosedImmersion Γ₀ := by
      haveI : AlgebraicGeometry.IsSeparated p₁ := inferInstance
      have hΓ_p₁ : Γ₀ ≫ p₁ = 𝟙 Y := CategoryTheory.Limits.pullback.lift_fst _ _ _
      haveI : AlgebraicGeometry.IsClosedImmersion (Γ₀ ≫ p₁) := by
        rw [hΓ_p₁]
        infer_instance
      exact AlgebraicGeometry.IsClosedImmersion.of_comp Γ₀ p₁
    have hi_cl : AlgebraicGeometry.IsClosedImmersion i₀ := by
      haveI : AlgebraicGeometry.IsClosedImmersion Γ₀ := hΓ_cl
      infer_instance
    exact ⟨hΔ_cl, hΓ_cl, hi_cl, hi_snd, hi_ψ, hi_mono, h_univ⟩
  have h_step2 : ∀ (W₀ : AlgebraicGeometry.Scheme.{u}) (p₀ : W₀ ⟶ S_k)
      [AlgebraicGeometry.IsFinite p₀] [AlgebraicGeometry.Etale p₀],
      Finite ↥W₀ ∧
      DiscreteTopology ↥W₀ ∧
      (∃ s' : ∀ _ : ↥W₀, S_k ⟶ W₀,
        ∀ w : ↥W₀,
          AlgebraicGeometry.IsOpenImmersion (s' w) ∧
          Set.range (s' w).base = {w} ∧
          s' w ≫ p₀ = 𝟙 S_k) := by
    intro W₀ p₀ _ _
    haveI : AlgebraicGeometry.IsAffineHom p₀ := inferInstance
    haveI : AlgebraicGeometry.IsAffine W₀ := AlgebraicGeometry.isAffine_of_isAffineHom p₀
    let R_W : CommRingCat.{u} := W₀.presheaf.obj (Opposite.op ⊤)
    let φ_W : AlgebraicGeometry.Spec R_W ⟶ S_k := W₀.isoSpec.inv ≫ p₀
    haveI : AlgebraicGeometry.IsFinite φ_W := inferInstance
    let g_W : CommRingCat.of k ⟶ R_W := AlgebraicGeometry.Spec.preimage φ_W
    have hg_W_spec : AlgebraicGeometry.Spec.map g_W = φ_W :=
      AlgebraicGeometry.Spec.map_preimage φ_W
    have hg_W_fin : g_W.hom.Finite := by
      apply (AlgebraicGeometry.IsFinite.SpecMap_iff g_W).mp
      rw [hg_W_spec]
      infer_instance
    letI : Algebra k ↑R_W := g_W.hom.toAlgebra
    have hg_W_alg : (algebraMap k ↑R_W).Finite := hg_W_fin
    haveI : Module.Finite k ↑R_W := RingHom.finite_algebraMap.mp hg_W_alg
    haveI : IsArtinianRing ↑R_W := IsArtinianRing.of_finite k ↑R_W
    haveI : AlgebraicGeometry.IsArtinianScheme (AlgebraicGeometry.Spec R_W) :=
      AlgebraicGeometry.Scheme.isArtinianScheme_Spec.mpr inferInstance
    let e_W : ↥W₀ ≃ₜ ↥(AlgebraicGeometry.Spec R_W) :=
      AlgebraicGeometry.Scheme.homeoOfIso W₀.isoSpec
    have hW₀_fin : Finite ↥W₀ := Finite.of_equiv ↥(AlgebraicGeometry.Spec R_W) e_W.symm.toEquiv
    have hW₀_disc : DiscreteTopology ↥W₀ := e_W.symm.discreteTopology
    haveI : DiscreteTopology ↥W₀ := hW₀_disc
    have hex_w : ∀ w : ↥W₀, ∃ s_w : S_k ⟶ W₀,
        AlgebraicGeometry.IsOpenImmersion s_w ∧
        Set.range s_w.base = {w} ∧
        s_w ≫ p₀ = 𝟙 S_k := by
      intro w
      let U_w : W₀.Opens := ⟨{w}, isOpen_discrete ({w} : Set ↥W₀)⟩
      haveI : Unique ↥U_w.toScheme :=
        { default := ⟨w, Set.mem_singleton w⟩
          uniq := fun y => Subtype.ext y.2 }
      haveI : Finite ↥U_w.toScheme := inferInstance
      haveI : DiscreteTopology ↥U_w.toScheme := Subsingleton.discreteTopology
      haveI : AlgebraicGeometry.IsAffine U_w.toScheme := inferInstance
      let B_w : CommRingCat.{u} := U_w.toScheme.presheaf.obj (Opposite.op ⊤)
      let e_Uw : ↥U_w.toScheme ≃ₜ PrimeSpectrum ↑B_w :=
        AlgebraicGeometry.Scheme.homeoOfIso U_w.toScheme.isoSpec
      haveI : Unique (PrimeSpectrum ↑B_w) := e_Uw.symm.toEquiv.unique
      haveI : Nontrivial ↑B_w := PrimeSpectrum.nonempty_iff_nontrivial.mp ⟨default⟩
      obtain ⟨𝔪, h𝔪⟩ := Ideal.exists_maximal ↑B_w
      haveI : Nonempty (MaximalSpectrum ↑B_w) := ⟨⟨𝔪, h𝔪⟩⟩
      haveI : Subsingleton (MaximalSpectrum ↑B_w) :=
        MaximalSpectrum.toPrimeSpectrum_injective.subsingleton
      haveI : IsLocalRing ↑B_w := IsLocalRing.of_singleton_maximalSpectrum
      let q_w : U_w.toScheme ⟶ S_k := U_w.ι ≫ p₀
      let q_spec : AlgebraicGeometry.Spec B_w ⟶ S_k := U_w.toScheme.isoSpec.inv ≫ q_w
      haveI : AlgebraicGeometry.Etale q_spec := inferInstance
      let α_w : CommRingCat.of k ⟶ B_w := AlgebraicGeometry.Spec.preimage q_spec
      have hα_spec : AlgebraicGeometry.Spec.map α_w = q_spec :=
        AlgebraicGeometry.Spec.map_preimage q_spec
      have hα_et : α_w.hom.Etale := by
        apply (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
        rw [hα_spec]
        infer_instance
      letI : Algebra k ↑B_w := α_w.hom.toAlgebra
      have hα_alg : (algebraMap k ↑B_w).Etale := hα_et
      haveI : Algebra.Etale k ↑B_w := RingHom.etale_algebraMap.mp hα_alg
      have hbij_alg : Function.Bijective ⇑(algebraMap k ↑B_w) :=
        Algebra.FormallyUnramified.bijective_of_isAlgClosed_of_isLocalRing k ↑B_w
      have hbij : Function.Bijective ⇑α_w.hom := hbij_alg
      let β_w : B_w ⟶ CommRingCat.of k :=
        CommRingCat.ofHom (RingEquiv.ofBijective α_w.hom hbij).symm.toRingHom
      have hαβ : α_w ≫ β_w = 𝟙 (CommRingCat.of k) := by
        ext x
        exact (RingEquiv.ofBijective α_w.hom hbij).symm_apply_apply x
      have hβα : β_w ≫ α_w = 𝟙 B_w := by
        ext x
        exact (RingEquiv.ofBijective α_w.hom hbij).apply_symm_apply x
      haveI : CategoryTheory.IsIso q_spec := by
        rw [← hα_spec]
        refine ⟨⟨AlgebraicGeometry.Spec.map β_w, ?_, ?_⟩⟩
        · rw [← AlgebraicGeometry.Spec.map_comp, hβα, AlgebraicGeometry.Spec.map_id]
        · rw [← AlgebraicGeometry.Spec.map_comp, hαβ, AlgebraicGeometry.Spec.map_id]
      have hqw_eq : q_w = U_w.toScheme.isoSpec.hom ≫ q_spec := by
        dsimp only [q_spec]
        rw [CategoryTheory.Iso.hom_inv_id_assoc]
      haveI : CategoryTheory.IsIso q_w := by
        rw [hqw_eq]
        infer_instance
      let s_w : S_k ⟶ W₀ := CategoryTheory.inv q_w ≫ U_w.ι
      have hs_open : AlgebraicGeometry.IsOpenImmersion s_w :=
        AlgebraicGeometry.IsOpenImmersion.comp (CategoryTheory.inv q_w) U_w.ι
      have hs_range : Set.range s_w.base = {w} := by
        have hsurj : Function.Surjective (CategoryTheory.inv q_w).base := by
          intro u
          refine ⟨q_w.base u, ?_⟩
          rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, CategoryTheory.IsIso.hom_inv_id]
          rfl
        have hcomp_fn : ⇑s_w.base = ⇑U_w.ι.base ∘ ⇑(CategoryTheory.inv q_w).base := by
          ext z
          exact AlgebraicGeometry.Scheme.Hom.comp_apply (CategoryTheory.inv q_w) U_w.ι z
        rw [hcomp_fn, hsurj.range_comp, AlgebraicGeometry.Scheme.Opens.range_ι]
        rfl
      have hs_sec : s_w ≫ p₀ = 𝟙 S_k := by
        change (CategoryTheory.inv q_w ≫ U_w.ι) ≫ p₀ = 𝟙 S_k
        rw [CategoryTheory.Category.assoc]
        exact CategoryTheory.IsIso.inv_hom_id q_w
      exact ⟨s_w, hs_open, hs_range, hs_sec⟩
    choose s' hs' using hex_w
    exact ⟨hW₀_fin, hW₀_disc, ⟨s', hs'⟩⟩
  have h_step3 : ∀ (W₀ : AlgebraicGeometry.Scheme.{u}) (i₀ : W₀ ⟶ X.left),
      i₀ ≫ φ = i₀ →
      CategoryTheory.Mono i₀ →
      (∀ (T : AlgebraicGeometry.Scheme.{u}) (g : T ⟶ X.left),
        g ≫ φ = g → ∃ l : T ⟶ W₀, l ≫ i₀ = g) →
      AlgebraicGeometry.Etale (i₀ ≫ X.hom) →
      ∀ (U₂ U' : X.left.Opens)
        (hU₂ : AlgebraicGeometry.IsAffineOpen U₂)
        (hU' : AlgebraicGeometry.IsAffineOpen U')
        (hle : U' ≤ U₂)
        (he_φ : U' ≤ (TopologicalSpace.Opens.map φ.base).obj U₂)
        (f_k : k →+* ↑(X.left.presheaf.obj (Opposite.op U'))),
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_k) =
        hU'.fromSpec ≫ X.hom →
      ((Ideal.Quotient.mk (Ideal.span (Set.range
        (fun a : ↑(X.left.presheaf.obj (Opposite.op U₂)) =>
          (X.left.presheaf.map (CategoryTheory.homOfLE hle).op).hom a -
            (AlgebraicGeometry.Scheme.Hom.appLE φ U₂ U' he_φ).hom a)))).comp f_k).Etale := by
    intro W₀ i₀ hi₀_φ hi₀_mono hW₀_univ hW₀_et U₂ U' hU₂ hU' hle he_φ f_k hf_k
    let R₂ : CommRingCat.{u} := X.left.presheaf.obj (Opposite.op U₂)
    let R' : CommRingCat.{u} := X.left.presheaf.obj (Opposite.op U')
    let ι_hom : R₂ ⟶ R' := X.left.presheaf.map (CategoryTheory.homOfLE hle).op
    let ψ_hom : R₂ ⟶ R' := AlgebraicGeometry.Scheme.Hom.appLE φ U₂ U' he_φ
    let I_W : Ideal ↑R' := Ideal.span (Set.range (fun a : ↑R₂ => ι_hom.hom a - ψ_hom.hom a))
    let R_Q : CommRingCat.{u} := CommRingCat.of (↑R' ⧸ I_W)
    let π : ↑R' →+* ↑R' ⧸ I_W := Ideal.Quotient.mk I_W
    let π_hom : R' ⟶ R_Q := CommRingCat.ofHom π
    have h_ι : AlgebraicGeometry.Spec.map ι_hom ≫ hU₂.fromSpec = hU'.fromSpec :=
      hU₂.map_fromSpec hU' (CategoryTheory.homOfLE hle).op
    have h_ψ : AlgebraicGeometry.Spec.map ψ_hom ≫ hU₂.fromSpec = hU'.fromSpec ≫ φ :=
      AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec φ hU₂ hU' he_φ
    let adj := AlgebraicGeometry.ΓSpec.adjunction.{u}
    let toHom : ∀ (T : AlgebraicGeometry.Scheme.{u}) (R : CommRingCat.{u}),
        (T ⟶ AlgebraicGeometry.Spec R) → (R ⟶ T.presheaf.obj (Opposite.op ⊤)) :=
      fun T R m => ((adj.homEquiv T (Opposite.op R)).symm m).unop
    let ofHom : ∀ (T : AlgebraicGeometry.Scheme.{u}) (R : CommRingCat.{u}),
        (R ⟶ T.presheaf.obj (Opposite.op ⊤)) → (T ⟶ AlgebraicGeometry.Spec R) :=
      fun T R α => (adj.homEquiv T (Opposite.op R)) α.op
    have h_toHom_inj : ∀ (T : AlgebraicGeometry.Scheme.{u}) (R : CommRingCat.{u})
        {m₁ m₂ : T ⟶ AlgebraicGeometry.Spec R},
        toHom T R m₁ = toHom T R m₂ → m₁ = m₂ := by
      intro T R m₁ m₂ h
      apply (adj.homEquiv T (Opposite.op R)).symm.injective
      exact congrArg Quiver.Hom.op h
    have h_toHom_ofHom : ∀ (T : AlgebraicGeometry.Scheme.{u}) (R : CommRingCat.{u})
        (α : R ⟶ T.presheaf.obj (Opposite.op ⊤)),
        toHom T R (ofHom T R α) = α :=
      fun T R α => congrArg Quiver.Hom.unop ((adj.homEquiv T (Opposite.op R)).symm_apply_apply α.op)
    have h_nat : ∀ (T : AlgebraicGeometry.Scheme.{u}) {R_a R_b : CommRingCat.{u}}
        (g : R_a ⟶ R_b) (m : T ⟶ AlgebraicGeometry.Spec R_b),
        toHom T R_a (m ≫ AlgebraicGeometry.Spec.map g) = g ≫ toHom T R_b m := by
      intro T R_a R_b g m
      have h1 : (adj.homEquiv T (Opposite.op R_a)).symm
            (m ≫ AlgebraicGeometry.Scheme.Spec.map g.op) =
          (adj.homEquiv T (Opposite.op R_b)).symm m ≫ g.op :=
        adj.homEquiv_naturality_right_symm m g.op
      exact congrArg Quiver.Hom.unop h1
    haveI hπ_mono : CategoryTheory.Mono (AlgebraicGeometry.Spec.map π_hom) :=
      ⟨fun {T} u v huv => by
        apply h_toHom_inj T R_Q
        have hcomp : π_hom ≫ toHom T R_Q u = π_hom ≫ toHom T R_Q v := by
          rw [← h_nat T π_hom u, ← h_nat T π_hom v, huv]
        ext z
        exact ConcreteCategory.congr_hom hcomp z⟩
    haveI : CategoryTheory.Mono i₀ := hi₀_mono
    haveI : CategoryTheory.Mono hU₂.fromSpec := inferInstance
    let PB := CategoryTheory.Limits.pullback i₀ hU'.fromSpec
    let pr₁ : PB ⟶ W₀ := CategoryTheory.Limits.pullback.fst i₀ hU'.fromSpec
    let pr₂ : PB ⟶ AlgebraicGeometry.Spec R' := CategoryTheory.Limits.pullback.snd i₀ hU'.fromSpec
    haveI : CategoryTheory.Mono pr₂ := inferInstance
    have hψι_π : ψ_hom ≫ π_hom = ι_hom ≫ π_hom := by
      ext a
      change π (ψ_hom.hom a) = π (ι_hom.hom a)
      symm
      rw [← sub_eq_zero, ← map_sub]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨a, rfl⟩)
    have h_eq_Q : (AlgebraicGeometry.Spec.map π_hom ≫ hU'.fromSpec) ≫ φ =
        AlgebraicGeometry.Spec.map π_hom ≫ hU'.fromSpec := by
      calc
        (AlgebraicGeometry.Spec.map π_hom ≫ hU'.fromSpec) ≫ φ =
            AlgebraicGeometry.Spec.map π_hom ≫ (hU'.fromSpec ≫ φ) :=
          CategoryTheory.Category.assoc _ _ _
        _ = AlgebraicGeometry.Spec.map π_hom ≫
            (AlgebraicGeometry.Spec.map ψ_hom ≫ hU₂.fromSpec) := by rw [← h_ψ]
        _ = (AlgebraicGeometry.Spec.map π_hom ≫ AlgebraicGeometry.Spec.map ψ_hom) ≫
            hU₂.fromSpec := (CategoryTheory.Category.assoc _ _ _).symm
        _ = AlgebraicGeometry.Spec.map (ψ_hom ≫ π_hom) ≫ hU₂.fromSpec := by
          rw [← AlgebraicGeometry.Spec.map_comp]
        _ = AlgebraicGeometry.Spec.map (ι_hom ≫ π_hom) ≫ hU₂.fromSpec := by rw [hψι_π]
        _ = (AlgebraicGeometry.Spec.map π_hom ≫ AlgebraicGeometry.Spec.map ι_hom) ≫
            hU₂.fromSpec := by rw [AlgebraicGeometry.Spec.map_comp]
        _ = AlgebraicGeometry.Spec.map π_hom ≫
            (AlgebraicGeometry.Spec.map ι_hom ≫ hU₂.fromSpec) :=
          CategoryTheory.Category.assoc _ _ _
        _ = AlgebraicGeometry.Spec.map π_hom ≫ hU'.fromSpec := by rw [h_ι]
    obtain ⟨l_Q, hl_Q⟩ := hW₀_univ (AlgebraicGeometry.Spec R_Q)
      (AlgebraicGeometry.Spec.map π_hom ≫ hU'.fromSpec) h_eq_Q
    let fwd : AlgebraicGeometry.Spec R_Q ⟶ PB :=
      CategoryTheory.Limits.pullback.lift l_Q (AlgebraicGeometry.Spec.map π_hom) hl_Q
    have hfwd_pr₂ : fwd ≫ pr₂ = AlgebraicGeometry.Spec.map π_hom :=
      CategoryTheory.Limits.pullback.lift_snd l_Q (AlgebraicGeometry.Spec.map π_hom) hl_Q
    have hpr₂_eq : pr₂ ≫ AlgebraicGeometry.Spec.map ψ_hom =
        pr₂ ≫ AlgebraicGeometry.Spec.map ι_hom := by
      apply (cancel_mono hU₂.fromSpec).mp
      calc
        (pr₂ ≫ AlgebraicGeometry.Spec.map ψ_hom) ≫ hU₂.fromSpec =
            pr₂ ≫ (AlgebraicGeometry.Spec.map ψ_hom ≫ hU₂.fromSpec) :=
          CategoryTheory.Category.assoc _ _ _
        _ = pr₂ ≫ (hU'.fromSpec ≫ φ) := by rw [h_ψ]
        _ = (pr₂ ≫ hU'.fromSpec) ≫ φ := (CategoryTheory.Category.assoc _ _ _).symm
        _ = (pr₁ ≫ i₀) ≫ φ := by rw [← CategoryTheory.Limits.pullback.condition]
        _ = pr₁ ≫ (i₀ ≫ φ) := CategoryTheory.Category.assoc _ _ _
        _ = pr₁ ≫ i₀ := by rw [hi₀_φ]
        _ = pr₂ ≫ hU'.fromSpec := CategoryTheory.Limits.pullback.condition
        _ = pr₂ ≫ (AlgebraicGeometry.Spec.map ι_hom ≫ hU₂.fromSpec) := by rw [← h_ι]
        _ = (pr₂ ≫ AlgebraicGeometry.Spec.map ι_hom) ≫ hU₂.fromSpec :=
          (CategoryTheory.Category.assoc _ _ _).symm
    let θ_hom : R' ⟶ PB.presheaf.obj (Opposite.op ⊤) := toHom PB R' pr₂
    have hθ_eq : ψ_hom ≫ θ_hom = ι_hom ≫ θ_hom := by
      dsimp only [θ_hom]
      rw [← h_nat PB ψ_hom pr₂, ← h_nat PB ι_hom pr₂, hpr₂_eq]
    have hθ_ker : ∀ x ∈ I_W, θ_hom.hom x = 0 := by
      intro x hx
      have hle_ker : I_W ≤ RingHom.ker θ_hom.hom := by
        rw [Ideal.span_le]
        rintro _ ⟨a, rfl⟩
        rw [SetLike.mem_coe, RingHom.mem_ker, map_sub, sub_eq_zero]
        exact (ConcreteCategory.congr_hom hθ_eq a).symm
      exact hle_ker hx
    let θ_bar : ↑R' ⧸ I_W →+* ↑(PB.presheaf.obj (Opposite.op ⊤)) :=
      Ideal.Quotient.lift I_W θ_hom.hom hθ_ker
    have hθ_bar_π : π_hom ≫ CommRingCat.ofHom θ_bar = θ_hom := by
      ext x
      exact Ideal.Quotient.lift_mk I_W θ_hom.hom hθ_ker
    let bwd : PB ⟶ AlgebraicGeometry.Spec R_Q :=
      ofHom PB R_Q (CommRingCat.ofHom θ_bar)
    have hbwd_π : bwd ≫ AlgebraicGeometry.Spec.map π_hom = pr₂ := by
      apply h_toHom_inj PB R'
      rw [h_nat PB π_hom bwd, h_toHom_ofHom PB R_Q (CommRingCat.ofHom θ_bar), hθ_bar_π]
    have h_fwd_bwd : fwd ≫ bwd = 𝟙 (AlgebraicGeometry.Spec R_Q) := by
      apply (cancel_mono (AlgebraicGeometry.Spec.map π_hom)).mp
      rw [CategoryTheory.Category.assoc, hbwd_π, hfwd_pr₂, CategoryTheory.Category.id_comp]
    have h_bwd_fwd : bwd ≫ fwd = 𝟙 PB := by
      apply (cancel_mono pr₂).mp
      rw [CategoryTheory.Category.assoc, hfwd_pr₂, hbwd_π, CategoryTheory.Category.id_comp]
    haveI : CategoryTheory.IsIso fwd := ⟨⟨bwd, h_fwd_bwd, h_bwd_fwd⟩⟩
    have h_spec_et : AlgebraicGeometry.Etale
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (π.comp f_k))) := by
      have hfac : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (π.comp f_k)) =
          fwd ≫ pr₁ ≫ (i₀ ≫ X.hom) := by
        calc
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (π.comp f_k)) =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_k ≫ π_hom) := by
            rw [← CommRingCat.ofHom_comp]
          _ = AlgebraicGeometry.Spec.map π_hom ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_k) :=
            AlgebraicGeometry.Spec.map_comp _ _
          _ = (fwd ≫ pr₂) ≫ (hU'.fromSpec ≫ X.hom) := by rw [← hfwd_pr₂, hf_k]
          _ = fwd ≫ (pr₂ ≫ hU'.fromSpec) ≫ X.hom := by
            simp only [CategoryTheory.Category.assoc]
          _ = fwd ≫ (pr₁ ≫ i₀) ≫ X.hom := by
            rw [← CategoryTheory.Limits.pullback.condition]
          _ = fwd ≫ pr₁ ≫ (i₀ ≫ X.hom) := by
            simp only [CategoryTheory.Category.assoc]
      rw [hfac]
      haveI : AlgebraicGeometry.Etale (i₀ ≫ X.hom) := hW₀_et
      infer_instance
    exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
      h_spec_et
  obtain ⟨hΔ_cl, hΓ_cl, hiW_cl, hiW_snd, hiW_φ, hiW_mono, hW_univ⟩ :=
    h_step1 X.left S_k X.hom φ hφ
  let p_W : W ⟶ S_k := i_W ≫ X.hom
  haveI : AlgebraicGeometry.IsFinite p_W := hW_fin
  haveI : AlgebraicGeometry.Etale p_W := hW_et
  obtain ⟨hW_fin_type, hW_disc, ⟨s'_W, hs'_W⟩⟩ := h_step2 W p_W
  refine ⟨⟨hW_fin_type, hW_disc, hΔ_cl, hΓ_cl, hiW_cl, hiW_snd, hiW_φ⟩,
    ⟨s'_W, fun w => ⟨(hs'_W w).1, (hs'_W w).2.1,
      (CategoryTheory.Category.assoc (s'_W w) i_W X.hom).trans (hs'_W w).2.2⟩⟩,
    h_step3 W i_W hiW_φ hiW_mono hW_univ hW_et⟩

theorem weil_gysin_shear_tubular_graph_chart (k : Type u) [Field k]
    (d : ℕ) (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (φ : Quiver.Hom X.left X.left)
    (hφ : CategoryTheory.CategoryStruct.comp φ X.hom = X.hom) :
    let P := CategoryTheory.Limits.pullback X.hom X.hom
    let Δ := CategoryTheory.Limits.pullback.diagonal X.hom
    let Γ_φ := CategoryTheory.Limits.pullback.lift (CategoryTheory.CategoryStruct.id X.left) φ
      ((CategoryTheory.Category.id_comp X.hom).trans hφ.symm)
    (∀ [AlgebraicGeometry.SmoothOfRelativeDimension d X.hom]
        (y : ↥X.left) (U_bound : X.left.Opens),
      y ∈ U_bound →
      ∃ (U : X.left.Opens) (_hU : AlgebraicGeometry.IsAffineOpen U)
        (g : MvPolynomial (Fin d) k →+* ↑(X.left.presheaf.obj (Opposite.op U))),
        y ∈ U ∧
        U ≤ U_bound ∧
        g.Etale ∧
        CategoryTheory.CategoryStruct.comp
          (CategoryTheory.CategoryStruct.comp U.toSpecΓ
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom g)))
          (weilGysinAffineStruct k d) =
          CategoryTheory.CategoryStruct.comp U.ι X.hom) ∧
    (∀ (U₁ U₂ : X.left.Opens)
        (_hU₁ : AlgebraicGeometry.IsAffineOpen U₁)
        (_hU₂ : AlgebraicGeometry.IsAffineOpen U₂)
        (he_φ : U₁ ≤ (TopologicalSpace.Opens.map φ.base).obj U₂)
        (g₁ : MvPolynomial (Fin d) k →+* ↑(X.left.presheaf.obj (Opposite.op U₁)))
        (g₂ : MvPolynomial (Fin d) k →+* ↑(X.left.presheaf.obj (Opposite.op U₂))),
      g₁.Etale →
      g₂.Etale →
      CategoryTheory.CategoryStruct.comp
        (CategoryTheory.CategoryStruct.comp U₁.toSpecΓ
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom g₁)))
        (weilGysinAffineStruct k d) =
        CategoryTheory.CategoryStruct.comp U₁.ι X.hom →
      CategoryTheory.CategoryStruct.comp
        (CategoryTheory.CategoryStruct.comp U₂.toSpecΓ
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom g₂)))
        (weilGysinAffineStruct k d) =
        CategoryTheory.CategoryStruct.comp U₂.ι X.hom →
      let u₁ := CategoryTheory.CategoryStruct.comp U₁.toSpecΓ
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom g₁))
      ∃ (V : P.Opens)
        (γ : Quiver.Hom U₁.toScheme V.toScheme)
        (p₁_V : Quiver.Hom V.toScheme U₁.toScheme)
        (v : Quiver.Hom V.toScheme (weilGysinAffineSpace k d))
        (Ψ : Quiver.Hom V.toScheme (weilGysinAffineSpace k (2 * d))),
        WeilGysinIsTubularGraphChart d X Γ_φ U₁ V γ p₁_V u₁ v Ψ ∧
        (∀ (hle₁₂ : U₁ ≤ U₂) (U' : X.left.Opens) (hle' : U' ≤ U₁)
            (δ : Quiver.Hom U'.toScheme V.toScheme),
          CategoryTheory.CategoryStruct.comp δ V.ι =
            CategoryTheory.CategoryStruct.comp U'.ι Δ →
          let ι' := (X.left.presheaf.map (CategoryTheory.homOfLE (hle'.trans hle₁₂)).op).hom
          let ψ' := (AlgebraicGeometry.Scheme.Hom.appLE φ U₂ U' (hle'.trans he_φ)).hom
          CategoryTheory.CategoryStruct.comp δ v =
            CategoryTheory.CategoryStruct.comp U'.toSpecΓ
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                (MvPolynomial.eval₂Hom ((ι'.comp g₂).comp MvPolynomial.C)
                  (fun j : Fin d =>
                    ι' (g₂ (MvPolynomial.X j)) - ψ' (g₂ (MvPolynomial.X j)))))))) :=
by
  classical
  let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
  let P := CategoryTheory.Limits.pullback X.hom X.hom
  let p₁ := CategoryTheory.Limits.pullback.fst X.hom X.hom
  let p₂ := CategoryTheory.Limits.pullback.snd X.hom X.hom
  let Δ := CategoryTheory.Limits.pullback.diagonal X.hom
  let Γ_φ := CategoryTheory.Limits.pullback.lift (CategoryTheory.CategoryStruct.id X.left) φ
    ((CategoryTheory.Category.id_comp X.hom).trans hφ.symm)
  have hEt_comp : ∀ {R₁ R₂ R₃ : Type u} [CommRing R₁] [CommRing R₂] [CommRing R₃]
      {f₁ : R₁ →+* R₂} {f₂ : R₂ →+* R₃}, f₁.Etale → f₂.Etale → (f₂.comp f₁).Etale := by
    intro R₁ R₂ R₃ _ _ _ f₁ f₂ hf₁ hf₂
    exact RingHom.Etale.stableUnderComposition f₁ f₂ hf₁ hf₂
  let e_fin : Fin (2 * d) ≃ Fin (d + d) := finCongr (Nat.two_mul d)
  let projLeft_hom : MvPolynomial (Fin d) k →+* MvPolynomial (Fin (2 * d)) k :=
    (MvPolynomial.rename
      (fun i : Fin d => Fin.cast (Nat.two_mul d).symm (Fin.castAdd d i))).toRingHom
  let projRight_hom : MvPolynomial (Fin d) k →+* MvPolynomial (Fin (2 * d)) k :=
    (MvPolynomial.rename
      (fun j : Fin d => Fin.cast (Nat.two_mul d).symm (Fin.natAdd d j))).toRingHom
  let axis_hom : MvPolynomial (Fin (2 * d)) k →+* MvPolynomial (Fin d) k :=
    MvPolynomial.eval₂Hom MvPolynomial.C
      (fun m : Fin (2 * d) =>
        Fin.addCases (fun i : Fin d => MvPolynomial.X i) (fun _ : Fin d => 0)
          (Fin.cast (Nat.two_mul d).symm.symm m))
  have hcast_left : ∀ i : Fin d,
      e_fin (Fin.cast (Nat.two_mul d).symm (Fin.castAdd d i)) = Fin.castAdd d i := by
    intro i; ext; rfl
  have hcast_right : ∀ j : Fin d,
      e_fin (Fin.cast (Nat.two_mul d).symm (Fin.natAdd d j)) = Fin.natAdd d j := by
    intro j; ext; rfl
  have hcast_symm : ∀ z : Fin (d + d),
      Fin.cast (Nat.two_mul d).symm.symm (e_fin.symm z) = z := by
    intro z; ext; rfl
