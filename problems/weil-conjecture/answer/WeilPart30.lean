                ext a
                let g_to_M : ↑A →+ ↑M := g.hom
                change (1 : R) • g_to_M a = g_to_M a
                exact one_smul R (g_to_M a) }
          homEquiv_naturality_left_symm := fun {A' A M} h g => by
            apply ModuleCat.hom_ext
            apply LinearMap.ext
            intro x
            induction x using TensorProduct.induction_on with
            | zero => simp
            | tmul r a' => rfl
            | add x₁ x₂ ih₁ ih₂ => rw [map_add, map_add, ih₁, ih₂]
          homEquiv_naturality_right := fun {A M M'} f k => by
            ext a
            rfl }
