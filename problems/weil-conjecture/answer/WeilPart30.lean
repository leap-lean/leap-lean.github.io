    exact hCartCounit W₁.left W₀.left U ν j₁ inferInstance j₀ inferInstance hj₁₀ hPb
      (ℓ ^ r) q p_ν hp_ν z₀ z₁ hcl

theorem weil_gysin_etale_mod_to_ab_support_bridge (m q : ℕ) :
    ∃ Φ_ab : ∀ {Z Y : AlgebraicGeometry.Scheme.{u}} (i : Quiver.Hom Z Y),
        WeilGysinSupportClass Z Y i m q → WeilGysinAbSupportClass Z Y i m q,
      (∀ {Z Y : AlgebraicGeometry.Scheme.{u}} (i : Quiver.Hom Z Y)
          (τ : WeilGysinSupportClass Z Y i m q) (cl : weilEtaleTorsionH Y m q),
        WeilGysinForgetsTo τ cl →
        ∀ (T_Z : Z.Etale) (hT_Z : CategoryTheory.Limits.IsTerminal T_Z)
          (T_Y : Y.Etale) (hT_Y : CategoryTheory.Limits.IsTerminal T_Y),
          letI : CategoryTheory.MorphismProperty.HasPullbacksAlong
              (@AlgebraicGeometry.Etale) i :=
            CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
          letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
              (@AlgebraicGeometry.Etale) i :=
            CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
              (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
          let B_i : CategoryTheory.Functor Y.Etale Z.Etale :=
            CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ i
          letI := (Φ_ab i τ).hCont
          let i_push := B_i.sheafPushforwardContinuous AddCommGrpCat.{u}
            Y.smallEtaleTopology Z.smallEtaleTopology
          let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
          let Fℤ_Z := (CategoryTheory.constantSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
          let Fℤ_Y := (CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
          let adj_Z := CategoryTheory.constantSheafAdj Z.smallEtaleTopology AddCommGrpCat.{u} hT_Z
          let adj_Y := CategoryTheory.constantSheafAdj Y.smallEtaleTopology AddCommGrpCat.{u} hT_Y
          let q_i : Quiver.Hom Fℤ_Y (i_push.obj Fℤ_Z) :=
            (adj_Y.homEquiv Aℤ (i_push.obj Fℤ_Z)).symm
              (CategoryTheory.CategoryStruct.comp (adj_Z.unit.app Aℤ)
                (Fℤ_Z.obj.map (Opposite.op (hT_Z.from (B_i.obj T_Y)))))
          (CategoryTheory.Abelian.Ext.mk₀ q_i).comp (Φ_ab i τ).val (Nat.zero_add q) = cl) ∧
      (∀ {Z Y' Y : AlgebraicGeometry.Scheme.{u}}
          (g : Quiver.Hom Y' Y) [AlgebraicGeometry.Etale g]
          (i' : Quiver.Hom Z Y') [AlgebraicGeometry.IsClosedImmersion i']
          (i : Quiver.Hom Z Y) [AlgebraicGeometry.IsClosedImmersion i],
        CategoryTheory.CategoryStruct.comp i' g = i →
        CategoryTheory.IsPullback i' (CategoryTheory.CategoryStruct.id Z) g i →
        ∀ (τ' : WeilGysinSupportClass Z Y' i' m q)
          (τ : WeilGysinSupportClass Z Y i m q),
          WeilGysinSupportPullback g i' i m q τ' τ →
          WeilGysinAbSupportPullback g i' i m q (Φ_ab i' τ') (Φ_ab i τ)) ∧
      (∀ {Z Y' Y : AlgebraicGeometry.Scheme.{u}}
          (g : Quiver.Hom Y' Y) [AlgebraicGeometry.Etale g]
          (i' : Quiver.Hom Z Y') [AlgebraicGeometry.IsClosedImmersion i']
          (i : Quiver.Hom Z Y) [AlgebraicGeometry.IsClosedImmersion i],
        CategoryTheory.CategoryStruct.comp i' g = i →
        CategoryTheory.IsPullback i' (CategoryTheory.CategoryStruct.id Z) g i →
        ∀ (α : WeilGysinAbSupportClass Z Y i m q),
          ∃ α' : WeilGysinAbSupportClass Z Y' i' m q,
            WeilGysinAbSupportPullback g i' i m q α' α) ∧
      (∀ {Z' Y' Z Y : AlgebraicGeometry.Scheme.{u}}
          (g : Quiver.Hom Y' Y)
          (i' : Quiver.Hom Z' Y') [AlgebraicGeometry.IsClosedImmersion i']
          (i : Quiver.Hom Z Y)
          (α : WeilGysinAbSupportClass Z Y i m q)
          (α'₁ α'₂ : WeilGysinAbSupportClass Z' Y' i' m q),
        WeilGysinAbSupportPullback g i' i m q α'₁ α →
        WeilGysinAbSupportPullback g i' i m q α'₂ α →
        α'₁ = α'₂) ∧
      (∀ {Z'' Y'' Z' Y' Z Y : AlgebraicGeometry.Scheme.{u}}
          (g₁ : Quiver.Hom Y'' Y') (g₂ : Quiver.Hom Y' Y)
          (i'' : Quiver.Hom Z'' Y'') (i' : Quiver.Hom Z' Y') (i : Quiver.Hom Z Y)
          (α'' : WeilGysinAbSupportClass Z'' Y'' i'' m q)
          (α' : WeilGysinAbSupportClass Z' Y' i' m q)
          (α : WeilGysinAbSupportClass Z Y i m q),
        WeilGysinAbSupportPullback g₁ i'' i' m q α'' α' →
        WeilGysinAbSupportPullback g₂ i' i m q α' α →
        WeilGysinAbSupportPullback (CategoryTheory.CategoryStruct.comp g₁ g₂) i'' i m q α'' α) :=
by
  classical
  have hContAll : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom S₁ S₂),
      (weilEtaleSitePullback h).IsContinuous S₂.smallEtaleTopology S₁.smallEtaleTopology := by
    intro S₁ S₂ h
    let B_h := weilEtaleSitePullback h
    have : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    have hBh_fst : ∀ {W₁ W₂ : S₂.Etale} (f : Quiver.Hom W₁ W₂),
        CategoryTheory.CategoryStruct.comp (B_h.map f).left
          (CategoryTheory.Limits.pullback.fst W₂.hom h) =
        CategoryTheory.CategoryStruct.comp
          (CategoryTheory.Limits.pullback.fst W₁.hom h) f.left :=
      fun _ => CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hBh_snd : ∀ {W₁ W₂ : S₂.Etale} (f : Quiver.Hom W₁ W₂),
        CategoryTheory.CategoryStruct.comp (B_h.map f).left
          (CategoryTheory.Limits.pullback.snd W₂.hom h) =
        CategoryTheory.Limits.pullback.snd W₁.hom h :=
      fun _ => CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hOverW : ∀ {S : AlgebraicGeometry.Scheme.{u}} {A B : S.Etale} (f : Quiver.Hom A B),
        CategoryTheory.CategoryStruct.comp f.left B.hom = A.hom :=
      fun f => CategoryTheory.MorphismProperty.Over.w f
    have hCov_B : CategoryTheory.CoverPreserving S₂.smallEtaleTopology S₁.smallEtaleTopology B_h := by
      refine ⟨fun {U R_s} hR => ?_⟩
      change R_s ∈ S₂.smallGrothendieckTopology (@AlgebraicGeometry.Etale) U at hR
      rw [AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        S₂ (Q := @AlgebraicGeometry.Etale) le_rfl] at hR
      change CategoryTheory.Sieve.functorPushforward B_h R_s ∈
        S₁.smallGrothendieckTopology (@AlgebraicGeometry.Etale) (B_h.obj U)
      rw [AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        S₁ (Q := @AlgebraicGeometry.Etale) le_rfl]
      refine (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) (B_h.obj U) _).mpr
        (fun p => ?_)
      let pr₁ := CategoryTheory.Limits.pullback.fst U.hom h
      let pr₂ := CategoryTheory.Limits.pullback.snd U.hom h
      obtain ⟨Y₀, f, y, hfR, _, hfy⟩ :=
        (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
          (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) U R_s).mp hR (pr₁.base p)
      let p_f1 := CategoryTheory.Limits.pullback.fst f.left pr₁
      let p_f2 := CategoryTheory.Limits.pullback.snd f.left pr₁
      have h_fwd_cond : p_f1 ≫ Y₀.hom = (p_f2 ≫ pr₂) ≫ h :=
        (congrArg (p_f1 ≫ ·) (hOverW f).symm).trans
          ((CategoryTheory.Category.assoc p_f1 f.left U.hom).symm.trans
            ((congrArg (· ≫ U.hom) CategoryTheory.Limits.pullback.condition).trans
              ((CategoryTheory.Category.assoc p_f2 pr₁ U.hom).trans
                ((congrArg (p_f2 ≫ ·) CategoryTheory.Limits.pullback.condition).trans
                  (CategoryTheory.Category.assoc p_f2 pr₂ h).symm))))
      let u_fwd : CategoryTheory.Limits.pullback f.left pr₁ ⟶ (B_h.obj Y₀).left :=
        CategoryTheory.Limits.pullback.lift p_f1 (p_f2 ≫ pr₂) h_fwd_cond
      have hu_snd : u_fwd ≫ (B_h.map f).left = p_f2 :=
        CategoryTheory.Limits.pullback.hom_ext
          ((CategoryTheory.Category.assoc u_fwd (B_h.map f).left pr₁).trans
            ((congrArg (u_fwd ≫ ·) (hBh_fst f)).trans
              ((CategoryTheory.Category.assoc u_fwd
                  (CategoryTheory.Limits.pullback.fst Y₀.hom h) f.left).symm.trans
                ((congrArg (· ≫ f.left)
                    (CategoryTheory.Limits.pullback.lift_fst p_f1 (p_f2 ≫ pr₂) h_fwd_cond)).trans
                  CategoryTheory.Limits.pullback.condition))))
          ((CategoryTheory.Category.assoc u_fwd (B_h.map f).left pr₂).trans
            ((congrArg (u_fwd ≫ ·) (hBh_snd f)).trans
              (CategoryTheory.Limits.pullback.lift_snd p_f1 (p_f2 ≫ pr₂) h_fwd_cond)))
      have hEt_Bf : AlgebraicGeometry.Etale (B_h.map f).left :=
        CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
          (B_h.map f).left (B_h.obj U).hom (B_h.obj U).prop
          ((hOverW (B_h.map f)).symm ▸ (B_h.obj Y₀).prop)
      obtain ⟨w, _, hw₂⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y p hfy
      refine ⟨B_h.obj Y₀, B_h.map f, u_fwd.base w,
        CategoryTheory.Sieve.image_mem_functorPushforward B_h R_s hfR, hEt_Bf, ?_⟩
      have hbase : ((u_fwd ≫ (B_h.map f).left).base) w = p_f2.base w :=
        congrArg (fun k => k.base w) hu_snd
      exact (AlgebraicGeometry.Scheme.Hom.comp_apply u_fwd (B_h.map f).left w).symm.trans
        (hbase.trans hw₂)
    have hCompat_B : CategoryTheory.CompatiblePreserving S₁.smallEtaleTopology B_h := by
      apply CategoryTheory.CompatiblePreserving.mk
      intro Fsh Z₀ T_s x hx Y₁ Y₂ X f₁ f₂ g₁ g₂ hg₁ hg₂ hcomm
      have : AlgebraicGeometry.Etale g₁.left :=
        CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
          g₁.left Z₀.hom Z₀.prop ((hOverW g₁).symm ▸ Y₁.prop)
      have : AlgebraicGeometry.Etale g₂.left :=
        CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
          g₂.left Z₀.hom Z₀.prop ((hOverW g₂).symm ▸ Y₂.prop)
      have : AlgebraicGeometry.Etale Y₁.hom := Y₁.prop
      let P_sch := CategoryTheory.Limits.pullback g₁.left g₂.left
      let q₁_sch := CategoryTheory.Limits.pullback.fst g₁.left g₂.left
      let q₂_sch := CategoryTheory.Limits.pullback.snd g₁.left g₂.left
      let P_et : S₂.Etale :=
        CategoryTheory.MorphismProperty.Over.mk (P := @AlgebraicGeometry.Etale) ⊤
          (q₁_sch ≫ Y₁.hom) inferInstance
      let q₁ : Quiver.Hom P_et Y₁ :=
        CategoryTheory.MorphismProperty.Over.homMk q₁_sch rfl trivial
      let q₂ : Quiver.Hom P_et Y₂ :=
        CategoryTheory.MorphismProperty.Over.homMk q₂_sch
          ((congrArg (q₂_sch ≫ ·) (hOverW g₂).symm).trans
            ((CategoryTheory.Category.assoc q₂_sch g₂.left Z₀.hom).symm.trans
              ((congrArg (· ≫ Z₀.hom) CategoryTheory.Limits.pullback.condition.symm).trans
                ((CategoryTheory.Category.assoc q₁_sch g₁.left Z₀.hom).trans
                  (congrArg (q₁_sch ≫ ·) (hOverW g₁))))))
          trivial
      have hq_comm : CategoryTheory.CategoryStruct.comp q₁ g₁ =
          CategoryTheory.CategoryStruct.comp q₂ g₂ :=
        CategoryTheory.MorphismProperty.Over.Hom.ext CategoryTheory.Limits.pullback.condition
      have ha_cond : (f₁.left ≫ CategoryTheory.Limits.pullback.fst Y₁.hom h) ≫ g₁.left =
          (f₂.left ≫ CategoryTheory.Limits.pullback.fst Y₂.hom h) ≫ g₂.left :=
        (CategoryTheory.Category.assoc f₁.left
            (CategoryTheory.Limits.pullback.fst Y₁.hom h) g₁.left).trans
          ((congrArg (f₁.left ≫ ·) (hBh_fst g₁).symm).trans
            ((CategoryTheory.Category.assoc f₁.left (B_h.map g₁).left
                (CategoryTheory.Limits.pullback.fst Z₀.hom h)).symm.trans
              ((congrArg (· ≫ CategoryTheory.Limits.pullback.fst Z₀.hom h)
                  (congrArg (fun k => k.left) hcomm)).trans
                ((CategoryTheory.Category.assoc f₂.left (B_h.map g₂).left
                    (CategoryTheory.Limits.pullback.fst Z₀.hom h)).trans
                  ((congrArg (f₂.left ≫ ·) (hBh_fst g₂)).trans
                    (CategoryTheory.Category.assoc f₂.left
                      (CategoryTheory.Limits.pullback.fst Y₂.hom h) g₂.left).symm)))))
      let a_sch : X.left ⟶ P_sch :=
        CategoryTheory.Limits.pullback.lift
          (f₁.left ≫ CategoryTheory.Limits.pullback.fst Y₁.hom h)
          (f₂.left ≫ CategoryTheory.Limits.pullback.fst Y₂.hom h) ha_cond
      have hu_cond : a_sch ≫ P_et.hom = X.hom ≫ h :=
        (CategoryTheory.Category.assoc a_sch q₁_sch Y₁.hom).symm.trans
          ((congrArg (· ≫ Y₁.hom)
              (CategoryTheory.Limits.pullback.lift_fst
                (f₁.left ≫ CategoryTheory.Limits.pullback.fst Y₁.hom h)
                (f₂.left ≫ CategoryTheory.Limits.pullback.fst Y₂.hom h) ha_cond)).trans
            ((CategoryTheory.Category.assoc f₁.left
                (CategoryTheory.Limits.pullback.fst Y₁.hom h) Y₁.hom).trans
              ((congrArg (f₁.left ≫ ·) CategoryTheory.Limits.pullback.condition).trans
                ((CategoryTheory.Category.assoc f₁.left
                    (CategoryTheory.Limits.pullback.snd Y₁.hom h) h).symm.trans
                  (congrArg (· ≫ h) (hOverW f₁))))))
      let u_sch : X.left ⟶ (B_h.obj P_et).left :=
        CategoryTheory.Limits.pullback.lift a_sch X.hom hu_cond
      let u_X : Quiver.Hom X (B_h.obj P_et) :=
        CategoryTheory.MorphismProperty.Over.homMk u_sch
          (CategoryTheory.Limits.pullback.lift_snd _ _ _) trivial
      have hu₁ : CategoryTheory.CategoryStruct.comp u_X (B_h.map q₁) = f₁ :=
        CategoryTheory.MorphismProperty.Over.Hom.ext
          (CategoryTheory.Limits.pullback.hom_ext
            ((CategoryTheory.Category.assoc u_sch (B_h.map q₁).left
                (CategoryTheory.Limits.pullback.fst Y₁.hom h)).trans
              ((congrArg (u_sch ≫ ·) (hBh_fst q₁)).trans
                ((CategoryTheory.Category.assoc u_sch
                    (CategoryTheory.Limits.pullback.fst P_et.hom h) q₁_sch).symm.trans
                  ((congrArg (· ≫ q₁_sch)
                      (CategoryTheory.Limits.pullback.lift_fst a_sch X.hom hu_cond)).trans
                    (CategoryTheory.Limits.pullback.lift_fst _ _ ha_cond)))))
            ((CategoryTheory.Category.assoc u_sch (B_h.map q₁).left
                (CategoryTheory.Limits.pullback.snd Y₁.hom h)).trans
              ((congrArg (u_sch ≫ ·) (hBh_snd q₁)).trans
                ((CategoryTheory.Limits.pullback.lift_snd a_sch X.hom hu_cond).trans
                  (hOverW f₁).symm))))
      have hu₂ : CategoryTheory.CategoryStruct.comp u_X (B_h.map q₂) = f₂ :=
        CategoryTheory.MorphismProperty.Over.Hom.ext
          (CategoryTheory.Limits.pullback.hom_ext
            ((CategoryTheory.Category.assoc u_sch (B_h.map q₂).left
                (CategoryTheory.Limits.pullback.fst Y₂.hom h)).trans
              ((congrArg (u_sch ≫ ·) (hBh_fst q₂)).trans
                ((CategoryTheory.Category.assoc u_sch
                    (CategoryTheory.Limits.pullback.fst P_et.hom h) q₂_sch).symm.trans
                  ((congrArg (· ≫ q₂_sch)
                      (CategoryTheory.Limits.pullback.lift_fst a_sch X.hom hu_cond)).trans
                    (CategoryTheory.Limits.pullback.lift_snd _ _ ha_cond)))))
            ((CategoryTheory.Category.assoc u_sch (B_h.map q₂).left
                (CategoryTheory.Limits.pullback.snd Y₂.hom h)).trans
              ((congrArg (u_sch ≫ ·) (hBh_snd q₂)).trans
                ((CategoryTheory.Limits.pullback.lift_snd a_sch X.hom hu_cond).trans
                  (hOverW f₂).symm))))
      have hx_eq := hx q₁ q₂ hg₁ hg₂ hq_comm
      have hmap₁ : Fsh.obj.map f₁.op =
          CategoryTheory.CategoryStruct.comp (Fsh.obj.map (B_h.map q₁).op) (Fsh.obj.map u_X.op) :=
        (congrArg (fun k => Fsh.obj.map k.op) hu₁.symm).trans
          ((congrArg Fsh.obj.map (op_comp (f := u_X) (g := B_h.map q₁))).trans
            (Fsh.obj.map_comp (B_h.map q₁).op u_X.op))
      have hmap₂ : Fsh.obj.map f₂.op =
          CategoryTheory.CategoryStruct.comp (Fsh.obj.map (B_h.map q₂).op) (Fsh.obj.map u_X.op) :=
        (congrArg (fun k => Fsh.obj.map k.op) hu₂.symm).trans
          ((congrArg Fsh.obj.map (op_comp (f := u_X) (g := B_h.map q₂))).trans
            (Fsh.obj.map_comp (B_h.map q₂).op u_X.op))
      exact (congrArg (fun φ => φ (x g₁ hg₁)) hmap₁).trans
        ((congrArg (Fsh.obj.map u_X.op) hx_eq).trans
          (congrArg (fun φ => φ (x g₂ hg₂)) hmap₂).symm)
    exact CategoryTheory.Functor.isContinuous_of_coverPreserving hCompat_B hCov_B
  have hInjShortExact : ∀ {𝒟 : Type (u + 1)} [CategoryTheory.Category.{u + 1} 𝒟]
      [CategoryTheory.Abelian 𝒟] [CategoryTheory.EnoughInjectives 𝒟] (B : 𝒟),
      let I := CategoryTheory.Injective.under B
      let f : Quiver.Hom B I := CategoryTheory.Injective.ι B
      let Q := CategoryTheory.Limits.cokernel f
      let p : Quiver.Hom I Q := CategoryTheory.Limits.cokernel.π f
      (CategoryTheory.ShortComplex.mk f p (CategoryTheory.Limits.cokernel.condition f)).ShortExact := by
    intro 𝒟 _ _ _ B
    let I := CategoryTheory.Injective.under B
    let f : Quiver.Hom B I := CategoryTheory.Injective.ι B
    let Q := CategoryTheory.Limits.cokernel f
    let p : Quiver.Hom I Q := CategoryTheory.Limits.cokernel.π f
    let S := CategoryTheory.ShortComplex.mk f p (CategoryTheory.Limits.cokernel.condition f)
    have hDesc : CategoryTheory.Limits.cokernel.desc S.f S.g S.zero =
        CategoryTheory.CategoryStruct.id Q := by
      apply (CategoryTheory.cancel_epi (CategoryTheory.Limits.cokernel.π f)).mp
      exact (CategoryTheory.Limits.cokernel.π_desc f p S.zero).trans
        (CategoryTheory.Category.comp_id p).symm
    have hExact : S.Exact := by
      rw [CategoryTheory.ShortComplex.exact_iff_mono_cokernel_desc, hDesc]
      infer_instance
    exact @CategoryTheory.ShortComplex.ShortExact.mk _ _ _ S hExact
      (inferInstance : CategoryTheory.Mono f) (inferInstance : CategoryTheory.Epi p)
  have hExtNatIso : ∀ {𝒟₁ 𝒟₂ : Type (u + 1)}
      [CategoryTheory.Category.{u + 1} 𝒟₁] [CategoryTheory.Abelian 𝒟₁]
      [CategoryTheory.HasExt.{u} 𝒟₁] [CategoryTheory.EnoughInjectives 𝒟₁]
      [CategoryTheory.Category.{u + 1} 𝒟₂] [CategoryTheory.Abelian 𝒟₂]
      [CategoryTheory.HasExt.{u} 𝒟₂]
      (P₁ P₂ : CategoryTheory.Functor 𝒟₁ 𝒟₂)
      [P₁.Additive] [CategoryTheory.Limits.PreservesFiniteLimits P₁]
      [CategoryTheory.Limits.PreservesFiniteColimits P₁]
      [P₂.Additive] [CategoryTheory.Limits.PreservesFiniteLimits P₂]
      [CategoryTheory.Limits.PreservesFiniteColimits P₂]
      (ξ : P₁ ≅ P₂) (n : ℕ) (A B : 𝒟₁) (y : CategoryTheory.Abelian.Ext.{u} A B n),
      (P₂.mapExtAddHom A B n) y =
        ((CategoryTheory.Abelian.Ext.mk₀ (ξ.inv.app A)).comp
          ((P₁.mapExtAddHom A B n) y) (Nat.zero_add n)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (ξ.hom.app B)) (Nat.add_zero n) := by
    intro 𝒟₁ 𝒟₂ _ _ _ _ _ _ _ P₁ P₂ _ _ _ _ _ _ ξ n
    induction n with
    | zero =>
      intro A B y
      obtain ⟨f, rfl⟩ := CategoryTheory.Abelian.Ext.homEquiv₀.symm.surjective y
      change CategoryTheory.Abelian.Ext.mapExactFunctor P₂ (CategoryTheory.Abelian.Ext.mk₀ f) =
        ((CategoryTheory.Abelian.Ext.mk₀ (ξ.inv.app A)).comp
          (CategoryTheory.Abelian.Ext.mapExactFunctor P₁ (CategoryTheory.Abelian.Ext.mk₀ f))
          (Nat.zero_add 0)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (ξ.hom.app B)) (Nat.add_zero 0)
      rw [CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
      congr 1
      rw [CategoryTheory.Category.assoc, ξ.hom.naturality f,
        ← CategoryTheory.Category.assoc, ξ.inv_hom_id_app A, CategoryTheory.Category.id_comp]
    | succ n ih =>
      intro A B y
      let I := CategoryTheory.Injective.under B
      let ι_B : Quiver.Hom B I := CategoryTheory.Injective.ι B
