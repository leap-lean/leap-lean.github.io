        B₀.smallEtaleTopology S₀.smallEtaleTopology
      let pb_is := (weilEtaleSitePullback i_s).sheafPullback AddCommGrpCat.{u}
        P.smallEtaleTopology P1.smallEtaleTopology
      let adj_is := (weilEtaleSitePullback i_s).sheafAdjunctionContinuous AddCommGrpCat.{u}
        P.smallEtaleTopology P1.smallEtaleTopology
      let pf_gP1 := (weilEtaleSitePullback g_P1).sheafPushforwardContinuous AddCommGrpCat.{u}
        S₀.smallEtaleTopology P1.smallEtaleTopology
      let pb_g' := (weilEtaleSitePullback g'_12).sheafPullback AddCommGrpCat.{u}
        Γ₁₂.smallEtaleTopology C_s.smallEtaleTopology
      let adj_g' := (weilEtaleSitePullback g'_12).sheafAdjunctionContinuous AddCommGrpCat.{u}
        Γ₁₂.smallEtaleTopology C_s.smallEtaleTopology
      let pf_πs := (weilEtaleSitePullback π_s).sheafPushforwardContinuous AddCommGrpCat.{u}
        P1.smallEtaleTopology C_s.smallEtaleTopology
      let pf_fs := (weilEtaleSitePullback f_s).sheafPushforwardContinuous AddCommGrpCat.{u}
        S₀.smallEtaleTopology C_s.smallEtaleTopology
      let e_pf_π := compPushIso π p_bar f_B hfib
      let e_bot : (weilEtaleSitePullback p_bar ⋙ weilEtaleSitePullback i_s) ≅
          (weilEtaleSitePullback s ⋙ weilEtaleSitePullback g_P1) :=
        (CategoryTheory.MorphismProperty.Over.pullbackComp i_s p_bar).symm ≪≫
          CategoryTheory.MorphismProperty.Over.pullbackCongr his ≪≫
          CategoryTheory.MorphismProperty.Over.pullbackComp g_P1 s
      letI : (weilEtaleSitePullback p_bar ⋙ weilEtaleSitePullback i_s).IsContinuous
          B₀.smallEtaleTopology P1.smallEtaleTopology :=
        CategoryTheory.Functor.isContinuous_comp _ _
          B₀.smallEtaleTopology P.smallEtaleTopology P1.smallEtaleTopology
      letI : (weilEtaleSitePullback s ⋙ weilEtaleSitePullback g_P1).IsContinuous
          B₀.smallEtaleTopology P1.smallEtaleTopology :=
        CategoryTheory.Functor.isContinuous_comp _ _
          B₀.smallEtaleTopology S₀.smallEtaleTopology P1.smallEtaleTopology
      let e_pf_bot := CategoryTheory.Functor.sheafPushforwardContinuousIso e_bot
        AddCommGrpCat.{u} B₀.smallEtaleTopology P1.smallEtaleTopology
      let bc₀_bot_M := (adj_s.homEquiv (pf_pbar.obj (pf_π.obj M))
          (pf_gP1.obj (pb_is.obj (pf_π.obj M)))).symm
        (pf_pbar.map (adj_is.unit.app (pf_π.obj M)) ≫
          e_pf_bot.hom.app (pb_is.obj (pf_π.obj M)))
      let e_top : (weilEtaleSitePullback π ⋙ weilEtaleSitePullback g'_12) ≅
          (weilEtaleSitePullback i_s ⋙ weilEtaleSitePullback π_s) :=
        (CategoryTheory.MorphismProperty.Over.pullbackComp g'_12 π).symm ≪≫
          CategoryTheory.MorphismProperty.Over.pullbackCongr htop ≪≫
          CategoryTheory.MorphismProperty.Over.pullbackComp π_s i_s
      letI : (weilEtaleSitePullback π ⋙ weilEtaleSitePullback g'_12).IsContinuous
          P.smallEtaleTopology C_s.smallEtaleTopology :=
        CategoryTheory.Functor.isContinuous_comp _ _
          P.smallEtaleTopology Γ₁₂.smallEtaleTopology C_s.smallEtaleTopology
      letI : (weilEtaleSitePullback i_s ⋙ weilEtaleSitePullback π_s).IsContinuous
          P.smallEtaleTopology C_s.smallEtaleTopology :=
        CategoryTheory.Functor.isContinuous_comp _ _
          P.smallEtaleTopology P1.smallEtaleTopology C_s.smallEtaleTopology
      let e_pf_top := CategoryTheory.Functor.sheafPushforwardContinuousIso e_top
        AddCommGrpCat.{u} P.smallEtaleTopology C_s.smallEtaleTopology
      let bc₀_top_M := (adj_is.homEquiv (pf_π.obj M) (pf_πs.obj (pb_g'.obj M))).symm
        (pf_π.map (adj_g'.unit.app M) ≫ e_pf_top.hom.app (pb_g'.obj M))
      let e_outer : (weilEtaleSitePullback f_B ⋙ weilEtaleSitePullback g'_12) ≅
          (weilEtaleSitePullback s ⋙ weilEtaleSitePullback f_s) :=
        (CategoryTheory.MorphismProperty.Over.pullbackComp g'_12 f_B).symm ≪≫
          CategoryTheory.MorphismProperty.Over.pullbackCongr houter ≪≫
          CategoryTheory.MorphismProperty.Over.pullbackComp f_s s
      letI : (weilEtaleSitePullback f_B ⋙ weilEtaleSitePullback g'_12).IsContinuous
          B₀.smallEtaleTopology C_s.smallEtaleTopology :=
        CategoryTheory.Functor.isContinuous_comp _ _
          B₀.smallEtaleTopology Γ₁₂.smallEtaleTopology C_s.smallEtaleTopology
      letI : (weilEtaleSitePullback s ⋙ weilEtaleSitePullback f_s).IsContinuous
          B₀.smallEtaleTopology C_s.smallEtaleTopology :=
        CategoryTheory.Functor.isContinuous_comp _ _
          B₀.smallEtaleTopology S₀.smallEtaleTopology C_s.smallEtaleTopology
      let e_pf_outer := CategoryTheory.Functor.sheafPushforwardContinuousIso e_outer
        AddCommGrpCat.{u} B₀.smallEtaleTopology C_s.smallEtaleTopology
      let bc₀_outer_M := (adj_s.homEquiv (pf_fB.obj M) (pf_fs.obj (pb_g'.obj M))).symm
        (pf_fB.map (adj_g'.unit.app M) ≫ e_pf_outer.hom.app (pb_g'.obj M))
      let e_pf_fs := compPushIso π_s g_P1 f_s hfs
      pb_s.map (e_pf_π.hom.app M) ≫ bc₀_bot_M ≫ pf_gP1.map bc₀_top_M =
        bc₀_outer_M ≫ e_pf_fs.hom.app (pb_g'.obj M) := by
    intro P1 S₀ C_s π hfib i_s g_P1 s his g'_12 f_s π_s htop hfs houter M
      pf_π pb_s adj_s pb_is adj_is pf_gP1 pb_g' adj_g' pf_πs pf_fs
      e_pf_π e_bot e_pf_bot bc₀_bot_M e_top e_pf_top bc₀_top_M
      e_outer e_pf_outer bc₀_outer_M e_pf_fs
    let pf_s := (weilEtaleSitePullback s).sheafPushforwardContinuous AddCommGrpCat.{u}
      B₀.smallEtaleTopology S₀.smallEtaleTopology
    let pf_is := (weilEtaleSitePullback i_s).sheafPushforwardContinuous AddCommGrpCat.{u}
      P.smallEtaleTopology P1.smallEtaleTopology
    let pf_g' := (weilEtaleSitePullback g'_12).sheafPushforwardContinuous AddCommGrpCat.{u}
      Γ₁₂.smallEtaleTopology C_s.smallEtaleTopology
    let N := pb_g'.obj M
    let e_bot_hom : ∀ (K : CategoryTheory.Sheaf P1.smallEtaleTopology AddCommGrpCat.{u}),
        pf_pbar.obj (pf_is.obj K) ⟶ pf_s.obj (pf_gP1.obj K) :=
      fun K => e_pf_bot.hom.app K
    let e_top_hom : ∀ (K : CategoryTheory.Sheaf C_s.smallEtaleTopology AddCommGrpCat.{u}),
        pf_π.obj (pf_g'.obj K) ⟶ pf_is.obj (pf_πs.obj K) :=
      fun K => e_pf_top.hom.app K
    let e_outer_hom : ∀ (K : CategoryTheory.Sheaf C_s.smallEtaleTopology AddCommGrpCat.{u}),
        pf_fB.obj (pf_g'.obj K) ⟶ pf_s.obj (pf_fs.obj K) :=
      fun K => e_pf_outer.hom.app K
    apply (adj_s.homEquiv (pf_fB.obj M) (pf_gP1.obj (pf_πs.obj N))).injective
    have h_bot_nat : pf_pbar.map (pf_is.map bc₀_top_M) ≫ e_bot_hom (pf_πs.obj N) =
        e_bot_hom (pb_is.obj (pf_π.obj M)) ≫ pf_s.map (pf_gP1.map bc₀_top_M) :=
      e_pf_bot.hom.naturality bc₀_top_M
    have h_is_unit : adj_is.unit.app (pf_π.obj M) ≫ pf_is.map bc₀_top_M =
        pf_π.map (adj_g'.unit.app M) ≫ e_top_hom N :=
      (CategoryTheory.Adjunction.homEquiv_unit adj_is _ _ bc₀_top_M).symm.trans
        (Equiv.apply_symm_apply _ _)
    have h_π_nat : pf_fB.map (adj_g'.unit.app M) ≫ e_pf_π.hom.app (pf_g'.obj N) =
        e_pf_π.hom.app M ≫ pf_pbar.map (pf_π.map (adj_g'.unit.app M)) :=
      e_pf_π.hom.naturality (adj_g'.unit.app M)
    have h_coh : e_pf_π.hom.app (pf_g'.obj N) ≫ pf_pbar.map (e_top_hom N) ≫
        e_bot_hom (pf_πs.obj N) =
        e_outer_hom N ≫ pf_s.map (e_pf_fs.hom.app N) := by
      apply CategoryTheory.Sheaf.hom_ext
      apply CategoryTheory.NatTrans.ext
      funext opU
      rcases opU with ⟨U⟩
      let e_comp_π : weilEtaleSitePullback f_B ≅
          weilEtaleSitePullback p_bar ⋙ weilEtaleSitePullback π :=
        (CategoryTheory.MorphismProperty.Over.pullbackCongr hfib).symm ≪≫
          CategoryTheory.MorphismProperty.Over.pullbackComp π p_bar
      let e_comp_fs : weilEtaleSitePullback f_s ≅
          weilEtaleSitePullback g_P1 ⋙ weilEtaleSitePullback π_s :=
        (CategoryTheory.MorphismProperty.Over.pullbackCongr hfs).symm ≪≫
          CategoryTheory.MorphismProperty.Over.pullbackComp π_s g_P1
      let B_pbar := weilEtaleSitePullback p_bar
      let B_π := weilEtaleSitePullback π
      let B_fB := weilEtaleSitePullback f_B
      let B_s := weilEtaleSitePullback s
      let B_is := weilEtaleSitePullback i_s
      let B_gP1 := weilEtaleSitePullback g_P1
      let B_g' := weilEtaleSitePullback g'_12
      let B_πs := weilEtaleSitePullback π_s
      let B_fs := weilEtaleSitePullback f_s
      let γ₁ : B_πs.obj (B_gP1.obj (B_s.obj U)) ⟶ B_g'.obj (B_fB.obj U) :=
        B_πs.map (e_bot.inv.app U) ≫ e_top.inv.app (B_pbar.obj U) ≫
          B_g'.map (e_comp_π.inv.app U)
      let γ₂ : B_πs.obj (B_gP1.obj (B_s.obj U)) ⟶ B_g'.obj (B_fB.obj U) :=
        e_comp_fs.inv.app (B_s.obj U) ≫ e_outer.inv.app U
      change ((e_pf_π.hom.app (pf_g'.obj N)).hom.app (Opposite.op U) ≫
          N.obj.map (e_top.inv.app (B_pbar.obj U)).op ≫
          N.obj.map (B_πs.map (e_bot.inv.app U)).op) =
        (N.obj.map (e_outer.inv.app U).op ≫
          (e_pf_fs.hom.app N).hom.app (Opposite.op (B_s.obj U)))
      rw [hCompPush_hom π p_bar f_B hfib (pf_g'.obj N) U,
        hCompPush_hom π_s g_P1 f_s hfs N (B_s.obj U)]
      change (N.obj.map (B_g'.map (e_comp_π.inv.app U)).op ≫
          N.obj.map (e_top.inv.app (B_pbar.obj U)).op ≫
          N.obj.map (B_πs.map (e_bot.inv.app U)).op) =
        (N.obj.map (e_outer.inv.app U).op ≫
          N.obj.map (e_comp_fs.inv.app (B_s.obj U)).op)
      have hL_map : N.obj.map (B_g'.map (e_comp_π.inv.app U)).op ≫
          N.obj.map (e_top.inv.app (B_pbar.obj U)).op ≫
          N.obj.map (B_πs.map (e_bot.inv.app U)).op = N.obj.map γ₁.op := by
        rw [← N.obj.map_comp, ← N.obj.map_comp, ← CategoryTheory.op_comp, ← CategoryTheory.op_comp]
        rfl
      have hR_map : N.obj.map (e_outer.inv.app U).op ≫
          N.obj.map (e_comp_fs.inv.app (B_s.obj U)).op = N.obj.map γ₂.op := by
        rw [← N.obj.map_comp, ← CategoryTheory.op_comp]
      rw [hL_map, hR_map]
      suffices hγ : γ₁ = γ₂ by rw [hγ]
      refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
      apply CategoryTheory.Limits.pullback.hom_ext
      · apply CategoryTheory.Limits.pullback.hom_ext
        · have h1_a : γ₁.left ≫
              CategoryTheory.Limits.pullback.fst (B_fB.obj U).hom g'_12 ≫
              CategoryTheory.Limits.pullback.fst U.hom f_B =
              CategoryTheory.Limits.pullback.fst (B_gP1.obj (B_s.obj U)).hom π_s ≫
                CategoryTheory.Limits.pullback.fst (B_s.obj U).hom g_P1 ≫
                CategoryTheory.Limits.pullback.fst U.hom s := by
            have h_c1 : (B_g'.map (e_comp_π.inv.app U)).left ≫
                CategoryTheory.Limits.pullback.fst (B_fB.obj U).hom g'_12 ≫
                CategoryTheory.Limits.pullback.fst U.hom f_B =
                CategoryTheory.Limits.pullback.fst (B_π.obj (B_pbar.obj U)).hom g'_12 ≫
                  CategoryTheory.Limits.pullback.fst (B_pbar.obj U).hom π ≫
                  CategoryTheory.Limits.pullback.fst U.hom p_bar :=
              (CategoryTheory.Category.assoc _ _ _).symm.trans
                ((congrArg (· ≫ CategoryTheory.Limits.pullback.fst U.hom f_B)
                  (hP1_map g'_12 (e_comp_π.inv.app U))).trans
                  ((CategoryTheory.Category.assoc _ _ _).trans
                    (congrArg (_ ≫ ·) (hP1_comp_inv π p_bar f_B hfib U))))
            have h_c2 : (e_top.inv.app (B_pbar.obj U)).left ≫
                (CategoryTheory.Limits.pullback.fst (B_π.obj (B_pbar.obj U)).hom g'_12 ≫
                  CategoryTheory.Limits.pullback.fst (B_pbar.obj U).hom π) =
                CategoryTheory.Limits.pullback.fst (B_is.obj (B_pbar.obj U)).hom π_s ≫
                  CategoryTheory.Limits.pullback.fst (B_pbar.obj U).hom i_s :=
              hP1_sq_inv g'_12 π π_s i_s htop (B_pbar.obj U)
            have h_c3 : (B_πs.map (e_bot.inv.app U)).left ≫
                CategoryTheory.Limits.pullback.fst (B_is.obj (B_pbar.obj U)).hom π_s ≫
                CategoryTheory.Limits.pullback.fst (B_pbar.obj U).hom i_s ≫
                CategoryTheory.Limits.pullback.fst U.hom p_bar =
                CategoryTheory.Limits.pullback.fst (B_gP1.obj (B_s.obj U)).hom π_s ≫
                  CategoryTheory.Limits.pullback.fst (B_s.obj U).hom g_P1 ≫
                  CategoryTheory.Limits.pullback.fst U.hom s :=
              (CategoryTheory.Category.assoc _ _ _).symm.trans
                ((congrArg (· ≫ _) (hP1_map π_s (e_bot.inv.app U))).trans
                  ((CategoryTheory.Category.assoc _ _ _).trans
                    (congrArg (_ ≫ ·) (hP1_sq_inv i_s p_bar g_P1 s his U))))
            have hγ₁_left : γ₁.left =
                (B_πs.map (e_bot.inv.app U)).left ≫
                  (e_top.inv.app (B_pbar.obj U)).left ≫
                  (B_g'.map (e_comp_π.inv.app U)).left := rfl
            exact (congrArg (· ≫ _) hγ₁_left).trans
              ((CategoryTheory.Category.assoc _ _ _).trans
                ((congrArg (_ ≫ ·)
                  ((CategoryTheory.Category.assoc _ _ _).trans
                    ((congrArg (_ ≫ ·) h_c1).trans
                      ((CategoryTheory.Category.assoc _ _ _).symm.trans
                        ((congrArg (· ≫ _)
                          ((CategoryTheory.Category.assoc _ _ _).symm.trans h_c2)).trans
                          (CategoryTheory.Category.assoc _ _ _)))))).trans h_c3))
          have h2_a : γ₂.left ≫
              CategoryTheory.Limits.pullback.fst (B_fB.obj U).hom g'_12 ≫
              CategoryTheory.Limits.pullback.fst U.hom f_B =
              CategoryTheory.Limits.pullback.fst (B_gP1.obj (B_s.obj U)).hom π_s ≫
                CategoryTheory.Limits.pullback.fst (B_s.obj U).hom g_P1 ≫
                CategoryTheory.Limits.pullback.fst U.hom s := by
            have hγ₂_left : γ₂.left =
                (e_comp_fs.inv.app (B_s.obj U)).left ≫ (e_outer.inv.app U).left := rfl
            exact (congrArg (· ≫ _) hγ₂_left).trans
              ((CategoryTheory.Category.assoc _ _ _).trans
                ((congrArg (_ ≫ ·) (hP1_sq_inv g'_12 f_B f_s s houter U)).trans
                  ((CategoryTheory.Category.assoc _ _ _).symm.trans
                    ((congrArg (· ≫ _) (hP1_comp_inv π_s g_P1 f_s hfs (B_s.obj U))).trans
                      (CategoryTheory.Category.assoc _ _ _)))))
          exact (CategoryTheory.Category.assoc _ _ _).trans
            (h1_a.trans (h2_a.symm.trans (CategoryTheory.Category.assoc _ _ _).symm))
        · have h_snd₁ : (γ₁.left ≫
              CategoryTheory.Limits.pullback.fst (B_fB.obj U).hom g'_12) ≫
              CategoryTheory.Limits.pullback.snd U.hom f_B =
              (B_πs.obj (B_gP1.obj (B_s.obj U))).hom ≫ g'_12 :=
            (CategoryTheory.Category.assoc _ _ _).trans
              ((congrArg (γ₁.left ≫ ·)
                (CategoryTheory.Limits.pullback.condition
                  (f := (B_fB.obj U).hom) (g := g'_12))).trans
                ((CategoryTheory.Category.assoc _ _ _).symm.trans
                  (congrArg (· ≫ g'_12) (CategoryTheory.MorphismProperty.Over.w γ₁))))
          have h_snd₂ : (γ₂.left ≫
              CategoryTheory.Limits.pullback.fst (B_fB.obj U).hom g'_12) ≫
              CategoryTheory.Limits.pullback.snd U.hom f_B =
              (B_πs.obj (B_gP1.obj (B_s.obj U))).hom ≫ g'_12 :=
            (CategoryTheory.Category.assoc _ _ _).trans
              ((congrArg (γ₂.left ≫ ·)
                (CategoryTheory.Limits.pullback.condition
                  (f := (B_fB.obj U).hom) (g := g'_12))).trans
                ((CategoryTheory.Category.assoc _ _ _).symm.trans
                  (congrArg (· ≫ g'_12) (CategoryTheory.MorphismProperty.Over.w γ₂))))
          exact h_snd₁.trans h_snd₂.symm
      · exact (CategoryTheory.MorphismProperty.Over.w γ₁).trans
          (CategoryTheory.MorphismProperty.Over.w γ₂).symm
    calc
      adj_s.homEquiv (pf_fB.obj M) (pf_gP1.obj (pf_πs.obj N))
          (pb_s.map (e_pf_π.hom.app M) ≫ bc₀_bot_M ≫ pf_gP1.map bc₀_top_M)
          = e_pf_π.hom.app M ≫
              adj_s.homEquiv (pf_pbar.obj (pf_π.obj M)) (pf_gP1.obj (pf_πs.obj N))
                (bc₀_bot_M ≫ pf_gP1.map bc₀_top_M) :=
            adj_s.homEquiv_naturality_left (e_pf_π.hom.app M) _
      _ = e_pf_π.hom.app M ≫
            (adj_s.homEquiv _ _ bc₀_bot_M ≫ pf_s.map (pf_gP1.map bc₀_top_M)) :=
            congrArg (e_pf_π.hom.app M ≫ ·)
              (adj_s.homEquiv_naturality_right bc₀_bot_M (pf_gP1.map bc₀_top_M))
      _ = e_pf_π.hom.app M ≫
            ((pf_pbar.map (adj_is.unit.app (pf_π.obj M)) ≫
              e_bot_hom (pb_is.obj (pf_π.obj M))) ≫ pf_s.map (pf_gP1.map bc₀_top_M)) :=
            congrArg (fun k => e_pf_π.hom.app M ≫ (k ≫ pf_s.map (pf_gP1.map bc₀_top_M)))
              (Equiv.apply_symm_apply _ _)
      _ = e_pf_π.hom.app M ≫ pf_pbar.map (adj_is.unit.app (pf_π.obj M)) ≫
            (e_bot_hom (pb_is.obj (pf_π.obj M)) ≫ pf_s.map (pf_gP1.map bc₀_top_M)) := by
            rw [CategoryTheory.Category.assoc (pf_pbar.map _)]
      _ = e_pf_π.hom.app M ≫ pf_pbar.map (adj_is.unit.app (pf_π.obj M)) ≫
            (pf_pbar.map (pf_is.map bc₀_top_M) ≫ e_bot_hom (pf_πs.obj N)) := by
            rw [← h_bot_nat]
      _ = e_pf_π.hom.app M ≫
            (pf_pbar.map (adj_is.unit.app (pf_π.obj M) ≫ pf_is.map bc₀_top_M)) ≫
            e_bot_hom (pf_πs.obj N) := by
            rw [← CategoryTheory.Category.assoc (pf_pbar.map _), ← pf_pbar.map_comp]
      _ = (e_pf_π.hom.app M ≫ pf_pbar.map (pf_π.map (adj_g'.unit.app M))) ≫
            pf_pbar.map (e_top_hom N) ≫ e_bot_hom (pf_πs.obj N) := by
            rw [h_is_unit, pf_pbar.map_comp, CategoryTheory.Category.assoc,
              ← CategoryTheory.Category.assoc (e_pf_π.hom.app M)]
      _ = pf_fB.map (adj_g'.unit.app M) ≫
            (e_pf_π.hom.app (pf_g'.obj N) ≫ pf_pbar.map (e_top_hom N) ≫
              e_bot_hom (pf_πs.obj N)) := by
            rw [← h_π_nat, CategoryTheory.Category.assoc]
      _ = (pf_fB.map (adj_g'.unit.app M) ≫ e_outer_hom N) ≫
            pf_s.map (e_pf_fs.hom.app N) := by
            rw [h_coh, CategoryTheory.Category.assoc]
      _ = adj_s.homEquiv (pf_fB.obj M) (pf_fs.obj N) bc₀_outer_M ≫
            pf_s.map (e_pf_fs.hom.app N) :=
            congrArg (· ≫ pf_s.map (e_pf_fs.hom.app N)) (Equiv.apply_symm_apply _ _).symm
      _ = adj_s.homEquiv (pf_fB.obj M) (pf_gP1.obj (pf_πs.obj N))
            (bc₀_outer_M ≫ e_pf_fs.hom.app N) :=
            (adj_s.homEquiv_naturality_right bc₀_outer_M (e_pf_fs.hom.app N)).symm
  clear hP1_map hP1_comp_inv hP1_sq_inv hCompPush_hom
  
  
  
  let L₁₂ := weilGysinLocalTorsionSheaf Γ₁₂ n U₁₂
  let L₁ := weilGysinLocalTorsionSheaf P n U₁
  let L₂ := weilGysinLocalTorsionSheaf P n U₂
  let pf₁ := (weilEtaleSitePullback π₁).sheafPushforwardContinuous AddCommGrpCat.{u}
    P.smallEtaleTopology Γ₁₂.smallEtaleTopology
  let pf₂ := (weilEtaleSitePullback π₂).sheafPushforwardContinuous AddCommGrpCat.{u}
    P.smallEtaleTopology Γ₁₂.smallEtaleTopology
  have : pf_pbar.Additive := (hSitePkg p_bar).2.1
  have : pf₁.Additive := (hSitePkg π₁).2.1
