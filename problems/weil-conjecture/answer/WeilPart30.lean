      rw [CategoryTheory.Adjunction.homEquiv_naturality_right adj_ab πℤ_g (C_ab_Y'.map z_to_m),
        CategoryTheory.Adjunction.homEquiv_naturality_left adj_ab (C_ab_Y.map z_to_m) πM_g,
        CategoryTheory.Adjunction.homEquiv_naturality_right adj_ab_Y,
        CategoryTheory.Adjunction.homEquiv_naturality_left adj_ab_Y]
      have h1 : adj_ab_Y.homEquiv Aℤ (g_push_ab.obj Fℤ_Y') (adj_ab.homEquiv Fℤ_Y Fℤ_Y' πℤ_g) =
          adj_ab_Y'.unit.app Aℤ ≫ Fℤ_Y'.obj.map (hT_Y'.from (B_g.obj T_Y)).op := by
        rw [hπℤ_eq, Equiv.apply_symm_apply, Equiv.apply_symm_apply]
        rfl
      have h2 : adj_ab_Y.homEquiv AM (g_push_ab.obj FM_Y') (adj_ab.homEquiv FM_Y FM_Y' πM_g) =
          adj_ab_Y'.unit.app AM ≫ FM_Y'.obj.map (hT_Y'.from (B_g.obj T_Y)).op := by
        rw [hπM_eq, Equiv.apply_symm_apply, Equiv.apply_symm_apply]
        rfl
      rw [h1, h2]
      let uℤ' : Aℤ ⟶ Fℤ_Y'.obj.obj (Opposite.op T_Y') := adj_ab_Y'.unit.app Aℤ
      let uM' : AM ⟶ FM_Y'.obj.obj (Opposite.op T_Y') := adj_ab_Y'.unit.app AM
      change (uℤ' ≫ (C_ab_Y'.obj Aℤ).obj.map (hT_Y'.from (B_g.obj T_Y)).op) ≫
        (C_ab_Y'.map z_to_m).hom.app (Opposite.op (B_g.obj T_Y)) =
        (z_to_m ≫ uM') ≫ FM_Y'.obj.map (hT_Y'.from (B_g.obj T_Y)).op
      rw [CategoryTheory.Category.assoc,
        (C_ab_Y'.map z_to_m).hom.naturality (hT_Y'.from (B_g.obj T_Y)).op,
        ← CategoryTheory.Category.assoc]
      have hu_nat : z_to_m ≫ uM' = uℤ' ≫ (C_ab_Y'.map z_to_m).hom.app (Opposite.op T_Y') :=
        adj_ab_Y'.unit.naturality z_to_m
      exact congrArg (· ≫ FM_Y'.obj.map (hT_Y'.from (B_g.obj T_Y)).op) hu_nat.symm
    have hπM_g_fac : P_pull_ab.map αM_Y0 ≫ η_UC.inv.app One_Y ≫ U_Y'.map π_Y ≫ πM_Y'0 = πM_g := by
      rw [hRightBdry,
        ← CategoryTheory.Category.assoc (η_UC.inv.app One_Y) (η_UC.hom.app One_Y),
        η_UC.inv_hom_id_app, CategoryTheory.Category.id_comp,
        ← CategoryTheory.Category.assoc (P_pull_ab.map αM_Y0) (P_pull_ab.map πM_Y0),
        ← P_pull_ab.map_comp, hπY0_1, P_pull_ab.map_id, CategoryTheory.Category.id_comp]
    have hLeftBdry : ιℤ_g ≫ P_pull_ab.map ιℤ_Y0 =
        ιℤ_Y'0 ≫ U_Y'.map ι_Y ≫ η_UC.hom.app One_Y := by
      have hzm : C_ab_Y'.map z_to_m = ιℤ_g ≫ P_pull_ab.map (C_ab_Y.map z_to_m) ≫ πM_g := by
        calc
          C_ab_Y'.map z_to_m = (ιℤ_g ≫ πℤ_g) ≫ C_ab_Y'.map z_to_m := by
            rw [hιℤ_1, CategoryTheory.Category.id_comp]
          _ = ιℤ_g ≫ P_pull_ab.map (C_ab_Y.map z_to_m) ≫ πM_g := by
            rw [CategoryTheory.Category.assoc, hπ_zm]
      dsimp only [ιℤ_Y0, ιℤ_Y'0]
      rw [hzm, ← hπM_g_fac]
      simp only [P_pull_ab.map_comp, CategoryTheory.Category.assoc]
      congr 2
      rw [← CategoryTheory.Category.assoc πM_Y'0, hπY'0_2, CategoryTheory.Category.id_comp,
        ← CategoryTheory.Category.assoc (U_Y'.map π_Y), ← U_Y'.map_comp,
        hιY_2, U_Y'.map_id, CategoryTheory.Category.id_comp,
        η_UC.inv_hom_id_app]
      exact (CategoryTheory.Category.comp_id (P_pull_ab.map αM_Y0)).symm
    rw [hq_i1_eq, hq_i'1_eq] at hqβ
    rw [hcl_eq, hcl'_eq, hp_g_eq]
    dsimp only [cl_Y0, cl_Y'0]
    have hq_tau' : (CategoryTheory.Abelian.Ext.mk₀ q_i'₀).comp τ'.val (Nat.zero_add q) =
        ((CategoryTheory.Abelian.Ext.mk₀ ι_Y).comp
          ((P_pull_mod.mapExtAddHom One_Y One_Y q)
            ((CategoryTheory.Abelian.Ext.mk₀ q_i₀).comp τ.val (Nat.zero_add q)))
          (Nat.zero_add q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ π_Y) (Nat.add_zero q) := by
      rw [hval']
      change (CategoryTheory.Abelian.Ext.mk₀ q_i'₀).comp
        (((CategoryTheory.Abelian.Ext.mk₀ β).comp
          ((P_pull_mod.mapExtAddHom _ _ q) τ.val) (Nat.zero_add q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ π_Y) (Nat.add_zero q)) (Nat.zero_add q) = _
      rw [← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
        ← CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hqβ,
        ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero]
      simp only [CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀]
    set γ_Y := (CategoryTheory.Abelian.Ext.mk₀ q_i₀).comp τ.val (Nat.zero_add q)
    rw [hq_tau']
    have hU_rhs : (U_Y'.mapExtAddHom One_Y' One_Y' q)
        (((CategoryTheory.Abelian.Ext.mk₀ ι_Y).comp
          ((P_pull_mod.mapExtAddHom One_Y One_Y q) γ_Y) (Nat.zero_add q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ π_Y) (Nat.add_zero q)) =
        ((CategoryTheory.Abelian.Ext.mk₀ (U_Y'.map ι_Y)).comp
          (((P_pull_mod ⋙ U_Y').mapExtAddHom One_Y One_Y q) γ_Y) (Nat.zero_add q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (U_Y'.map π_Y)) (Nat.add_zero q) := by
      rw [hMapExtComp P_pull_mod U_Y' One_Y One_Y q γ_Y]
      simp only [CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀]
    have hP_lhs : (P_pull_ab.mapExtAddHom Fℤ_Y FM_Y q)
        ((CategoryTheory.Abelian.Ext.mk₀ πM_Y0).postcomp Fℤ_Y (Nat.add_zero q)
          ((CategoryTheory.Abelian.Ext.mk₀ ιℤ_Y0).comp
            ((U_Y.mapExtAddHom One_Y One_Y q) γ_Y) (Nat.zero_add q))) =
        ((CategoryTheory.Abelian.Ext.mk₀ (P_pull_ab.map ιℤ_Y0)).comp
          (((U_Y ⋙ P_pull_ab).mapExtAddHom One_Y One_Y q) γ_Y) (Nat.zero_add q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (P_pull_ab.map πM_Y0)) (Nat.add_zero q) := by
      change (P_pull_ab.mapExtAddHom Fℤ_Y FM_Y q)
        (((CategoryTheory.Abelian.Ext.mk₀ ιℤ_Y0).comp
          ((U_Y.mapExtAddHom One_Y One_Y q) γ_Y) (Nat.zero_add q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ πM_Y0) (Nat.add_zero q)) = _
      rw [hMapExtComp U_Y P_pull_ab One_Y One_Y q γ_Y]
      simp only [CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀]
    rw [hU_rhs, hP_lhs, hExtIso (P_pull_mod ⋙ U_Y') (U_Y ⋙ P_pull_ab) η_UC One_Y One_Y q γ_Y]
    set ξ := ((U_Y ⋙ P_pull_ab).mapExtAddHom One_Y One_Y q) γ_Y
    have hRightInv : η_UC.inv.app One_Y ≫ U_Y'.map π_Y ≫ πM_Y'0 =
        P_pull_ab.map πM_Y0 ≫ πM_g := by
      rw [hRightBdry, ← CategoryTheory.Category.assoc,
        η_UC.inv_hom_id_app, CategoryTheory.Category.id_comp]
    change ((CategoryTheory.Abelian.Ext.mk₀ ιℤ_g).comp
        (((CategoryTheory.Abelian.Ext.mk₀ (P_pull_ab.map ιℤ_Y0)).comp ξ (Nat.zero_add q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (P_pull_ab.map πM_Y0)) (Nat.add_zero q))
        (Nat.zero_add q)).comp
        (CategoryTheory.Abelian.Ext.mk₀ πM_g) (Nat.add_zero q) =
      ((CategoryTheory.Abelian.Ext.mk₀ ιℤ_Y'0).comp
        (((CategoryTheory.Abelian.Ext.mk₀ (U_Y'.map ι_Y)).comp
          (((CategoryTheory.Abelian.Ext.mk₀ (η_UC.hom.app One_Y)).comp ξ (Nat.zero_add q)).comp
            (CategoryTheory.Abelian.Ext.mk₀ (η_UC.inv.app One_Y)) (Nat.add_zero q))
          (Nat.zero_add q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (U_Y'.map π_Y)) (Nat.add_zero q))
        (Nat.zero_add q)).comp
        (CategoryTheory.Abelian.Ext.mk₀ πM_Y'0) (Nat.add_zero q)
    calc
      ((CategoryTheory.Abelian.Ext.mk₀ ιℤ_g).comp
          (((CategoryTheory.Abelian.Ext.mk₀ (P_pull_ab.map ιℤ_Y0)).comp ξ (Nat.zero_add q)).comp
            (CategoryTheory.Abelian.Ext.mk₀ (P_pull_ab.map πM_Y0)) (Nat.add_zero q))
          (Nat.zero_add q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ πM_g) (Nat.add_zero q)
        = ((CategoryTheory.Abelian.Ext.mk₀ (ιℤ_g ≫ P_pull_ab.map ιℤ_Y0)).comp ξ (Nat.zero_add q)).comp
            (CategoryTheory.Abelian.Ext.mk₀ (P_pull_ab.map πM_Y0 ≫ πM_g)) (Nat.add_zero q) := by
          rw [← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
            ← CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero,
            CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
            CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
            CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
      _ = ((CategoryTheory.Abelian.Ext.mk₀ (ιℤ_Y'0 ≫ U_Y'.map ι_Y ≫ η_UC.hom.app One_Y)).comp ξ (Nat.zero_add q)).comp
            (CategoryTheory.Abelian.Ext.mk₀ (η_UC.inv.app One_Y ≫ U_Y'.map π_Y ≫ πM_Y'0)) (Nat.add_zero q) := by
          rw [hLeftBdry, hRightInv]
      _ = ((CategoryTheory.Abelian.Ext.mk₀ ιℤ_Y'0).comp
            (((CategoryTheory.Abelian.Ext.mk₀ (U_Y'.map ι_Y)).comp
              (((CategoryTheory.Abelian.Ext.mk₀ (η_UC.hom.app One_Y)).comp ξ (Nat.zero_add q)).comp
                (CategoryTheory.Abelian.Ext.mk₀ (η_UC.inv.app One_Y)) (Nat.add_zero q))
              (Nat.zero_add q)).comp
              (CategoryTheory.Abelian.Ext.mk₀ (U_Y'.map π_Y)) (Nat.add_zero q))
            (Nat.zero_add q)).comp
            (CategoryTheory.Abelian.Ext.mk₀ πM_Y'0) (Nat.add_zero q) := by
          simp only [← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
            CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero,
            CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero]

theorem weil_gysin_closed_immersion_cartesian_support_pullback (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    (∀ {Z' Y' Z Y : AlgebraicGeometry.Scheme.{u}}
      (g : Quiver.Hom Y' Y) (i' : Quiver.Hom Z' Y') (i : Quiver.Hom Z Y) (g_Z : Quiver.Hom Z' Z),
      AlgebraicGeometry.IsClosedImmersion i →
      CategoryTheory.IsPullback i' g_Z g i →
      ∀ (r q : ℕ) (τ : WeilGysinSupportClass Z Y i (ℓ ^ r) q),
        ∃ τ' : WeilGysinSupportClass Z' Y' i' (ℓ ^ r) q,
          WeilGysinSupportPullback g i' i (ℓ ^ r) q τ' τ) ∧
    (∀ {Z' Y' Z Y : AlgebraicGeometry.Scheme.{u}}
      (g : Quiver.Hom Y' Y) (i' : Quiver.Hom Z' Y') (i : Quiver.Hom Z Y),
      AlgebraicGeometry.IsClosedImmersion i' →
      ∀ (r q : ℕ) (τ : WeilGysinSupportClass Z Y i (ℓ ^ r) q)
        (τ'₁ τ'₂ : WeilGysinSupportClass Z' Y' i' (ℓ ^ r) q),
        WeilGysinSupportPullback g i' i (ℓ ^ r) q τ'₁ τ →
        WeilGysinSupportPullback g i' i (ℓ ^ r) q τ'₂ τ →
        τ'₁ = τ'₂) :=
by
  classical
  let etaleProp : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
    @AlgebraicGeometry.Etale
  haveI : CategoryTheory.MorphismProperty.IsStableUnderComposition etaleProp :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition

  
  let mkTerm : ∀ (S : AlgebraicGeometry.Scheme.{u}), S.Etale := fun S =>
    CategoryTheory.MorphismProperty.Over.mk ⊤ (CategoryTheory.CategoryStruct.id S)
      (inferInstance : AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.id S))
  have hIsTerm : ∀ (S : AlgebraicGeometry.Scheme.{u}),
      CategoryTheory.Limits.IsTerminal (mkTerm S) := by
    intro S
    refine CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun W => CategoryTheory.MorphismProperty.Over.homMk W.hom
        (CategoryTheory.Category.comp_id W.hom)) ?_
    intro W m
    apply CategoryTheory.MorphismProperty.Over.Hom.ext
    exact (CategoryTheory.Category.comp_id m.left).symm.trans
      (CategoryTheory.MorphismProperty.Over.w m)
  have hConstUnitMap : ∀ {S : AlgebraicGeometry.Scheme.{u}}
      {𝒜 : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} 𝒜]
      [CategoryTheory.HasWeakSheafify S.smallEtaleTopology 𝒜]
      {T₁ T₂ : S.Etale} (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
      (hT₂ : CategoryTheory.Limits.IsTerminal T₂) (φ : T₂ ⟶ T₁) (X : 𝒜),
      (CategoryTheory.constantSheafAdj S.smallEtaleTopology 𝒜 hT₁).unit.app X ≫
        (((CategoryTheory.constantSheaf S.smallEtaleTopology 𝒜).obj X).obj.map φ.op) =
      (CategoryTheory.constantSheafAdj S.smallEtaleTopology 𝒜 hT₂).unit.app X := by
    intro S 𝒜 _ _ T₁ T₂ hT₁ hT₂ φ X
    let J := S.smallEtaleTopology
    let P_X := (CategoryTheory.Functor.const (S.Etale)ᵒᵖ).obj X
    let η_X := (CategoryTheory.sheafificationAdjunction J 𝒜).unit.app P_X
    have h_nat := η_X.naturality φ.op
    dsimp [P_X] at h_nat
    rw [CategoryTheory.Category.id_comp] at h_nat
    have h_u₁ : (CategoryTheory.constantSheafAdj J 𝒜 hT₁).unit.app X = η_X.app (Opposite.op T₁) := by
      dsimp only [CategoryTheory.constantSheafAdj]
      rw [CategoryTheory.Adjunction.comp_unit_app,
        CategoryTheory.constantPresheafAdj_unit_app, CategoryTheory.Category.id_comp]
      rfl
    have h_u₂ : (CategoryTheory.constantSheafAdj J 𝒜 hT₂).unit.app X = η_X.app (Opposite.op T₂) := by
      dsimp only [CategoryTheory.constantSheafAdj]
      rw [CategoryTheory.Adjunction.comp_unit_app,
        CategoryTheory.constantPresheafAdj_unit_app, CategoryTheory.Category.id_comp]
      rfl
    rw [h_u₁, h_u₂]
    exact h_nat.symm
  have hConstSymmMap : ∀ {S : AlgebraicGeometry.Scheme.{u}}
      {𝒜 : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} 𝒜]
      [CategoryTheory.HasWeakSheafify S.smallEtaleTopology 𝒜]
      {T₁ T₂ : S.Etale} (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
      (hT₂ : CategoryTheory.Limits.IsTerminal T₂) (X : 𝒜)
      (ℱ : CategoryTheory.Sheaf S.smallEtaleTopology 𝒜)
      (f : X ⟶ ℱ.obj.obj (Opposite.op T₁)),
      ((CategoryTheory.constantSheafAdj S.smallEtaleTopology 𝒜 hT₂).homEquiv X ℱ).symm
        (f ≫ ℱ.obj.map (hT₁.from T₂).op) =
      ((CategoryTheory.constantSheafAdj S.smallEtaleTopology 𝒜 hT₁).homEquiv X ℱ).symm f := by
    intro S 𝒜 _ _ T₁ T₂ hT₁ hT₂ X ℱ f
    let J := S.smallEtaleTopology
    set rhs := ((CategoryTheory.constantSheafAdj J 𝒜 hT₁).homEquiv X ℱ).symm f
    apply ((CategoryTheory.constantSheafAdj J 𝒜 hT₂).homEquiv X ℱ).injective
    rw [Equiv.apply_symm_apply]
    have h₁ : ((CategoryTheory.constantSheafAdj J 𝒜 hT₁).homEquiv X ℱ) rhs = f :=
      Equiv.apply_symm_apply _ _
    rw [CategoryTheory.Adjunction.homEquiv_unit] at h₁ ⊢
    change (CategoryTheory.constantSheafAdj J 𝒜 hT₁).unit.app X ≫
        rhs.hom.app (Opposite.op T₁) = f at h₁
    change f ≫ ℱ.obj.map (hT₁.from T₂).op =
      (CategoryTheory.constantSheafAdj J 𝒜 hT₂).unit.app X ≫
        rhs.hom.app (Opposite.op T₂)
    rw [← hConstUnitMap hT₁ hT₂ (hT₁.from T₂) X, CategoryTheory.Category.assoc,
      rhs.hom.naturality (hT₁.from T₂).op, ← CategoryTheory.Category.assoc, h₁]

  
  have hMemSmallEtale : ∀ {S : AlgebraicGeometry.Scheme.{u}} (W : S.Etale)
      (R_sieve : CategoryTheory.Sieve W),
      R_sieve ∈ S.smallEtaleTopology W ↔
        ∀ (x : ↥W.left), ∃ (Y_x : S.Etale) (f_x : Y_x ⟶ W) (y_x : ↥Y_x.left),
          R_sieve.arrows f_x ∧ AlgebraicGeometry.Etale f_x.left ∧ f_x.left.base y_x = x := by
    intro S W R_sieve
    change R_sieve ∈ AlgebraicGeometry.Scheme.smallGrothendieckTopology etaleProp S W ↔ _
    rw [AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      (P := etaleProp) (Q := etaleProp) S (le_refl _)]
    exact AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
      (P := etaleProp) (Q := etaleProp) W R_sieve
  have hBotCover : ∀ {S : AlgebraicGeometry.Scheme.{u}} (W : S.Etale),
      IsEmpty ↥W.left → (⊥ : CategoryTheory.Sieve W) ∈ S.smallEtaleTopology W := by
    intro S W hEmp
    rw [hMemSmallEtale]
    intro x
    exact (hEmp.false x).elim
  have hOpenArrowsCover : ∀ {S : AlgebraicGeometry.Scheme.{u}} (W : S.Etale)
      {I : Type u} (O : I → W.left.Opens)
      (hcov : ∀ x : ↥W.left, ∃ idx : I, x ∈ O idx),
      let W_i : I → S.Etale := fun idx =>
        CategoryTheory.MorphismProperty.Over.mk ⊤ ((O idx).ι ≫ W.hom)
          (by have : AlgebraicGeometry.Etale W.hom := W.prop; infer_instance)
      let u_i : ∀ idx : I, W_i idx ⟶ W := fun idx =>
        CategoryTheory.MorphismProperty.Over.homMk (O idx).ι rfl
      CategoryTheory.Sieve.ofArrows W_i u_i ∈ S.smallEtaleTopology W := by
    intro S W I O hcov W_i u_i
    rw [hMemSmallEtale]
    intro x
    obtain ⟨idx, hx⟩ := hcov x
    refine ⟨W_i idx, u_i idx, ⟨x, hx⟩, CategoryTheory.Sieve.ofArrows_mk W_i u_i idx, ?_, ?_⟩
    · change AlgebraicGeometry.Etale (O idx).ι
      infer_instance
    · rfl
  have hFreeYonedaComp : ∀ {S : AlgebraicGeometry.Scheme.{u}} {m : ℕ} (X : S.Etale)
      {F₁ F₂ : CategoryTheory.Sheaf S.smallEtaleTopology
        (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m)))}
      (α : CategoryTheory.Sheaf.freeYoneda S.smallEtaleTopology X
        (ModuleCat.of (ULift.{u, 0} (ZMod m)) (ULift.{u, 0} (ZMod m))) ⟶ F₁)
      (φ : F₁ ⟶ F₂),
      CategoryTheory.Sheaf.freeYonedaHomEquiv (α ≫ φ) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ φ.hom.app (Opposite.op X) := by
    intro S m X F₁ F₂ α φ
    exact (congrArg CategoryTheory.Presheaf.freeYonedaHomEquiv
      (CategoryTheory.Adjunction.homEquiv_naturality_right
        (CategoryTheory.sheafificationAdjunction S.smallEtaleTopology _) α φ)).trans
      (CategoryTheory.Presheaf.freeYonedaHomEquiv_comp _ _)
  have hSheafAbOfType : ∀ {S : AlgebraicGeometry.Scheme.{u}}
      (Q : (S.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u}),
      CategoryTheory.Presieve.IsSheaf S.smallEtaleTopology
        (Q ⋙ CategoryTheory.forget AddCommGrpCat.{u}) →
      CategoryTheory.Presheaf.IsSheaf S.smallEtaleTopology Q := by
    intro S Q hQ A W S_cov hS_cov fam hcompat
    let fam_pt : ∀ a : ↥A, CategoryTheory.Presieve.FamilyOfElements
        (Q ⋙ CategoryTheory.forget AddCommGrpCat.{u}) S_cov.arrows :=
      fun a _ f hf => (fam f hf).hom a
    have hcompat_pt : ∀ a : ↥A, (fam_pt a).Compatible := by
      intro a Y₁ Y₂ Z' g₁ g₂ f₁ f₂ hf₁ hf₂ hcomm
      exact ConcreteCategory.congr_hom (hcompat g₁ g₂ hf₁ hf₂ hcomm) a
    let hglue : ↥A → ↥(Q.obj (Opposite.op W)) :=
      fun a => (hQ S_cov hS_cov).amalgamate (fam_pt a) (hcompat_pt a)
    have hglue_valid : ∀ (a : ↥A) {Y' : S.Etale} (f : Y' ⟶ W) (hf : S_cov.arrows f),
        (Q.map f.op).hom (hglue a) = (fam f hf).hom a :=
      fun a _ f hf => (hQ S_cov hS_cov).valid_glue (hcompat_pt a) f hf
    let gluedHom : A ⟶ Q.obj (Opposite.op W) := AddCommGrpCat.ofHom
      { toFun := hglue
        map_zero' := (hQ S_cov hS_cov).isSeparatedFor.ext fun Y' f hf => by
          change (Q.map f.op).hom (hglue 0) = (Q.map f.op).hom 0
