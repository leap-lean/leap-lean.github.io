      α₁ ≫ pf_π.map (mapFree_W φ) = mapFree_P φ ≫ α₂ := by
    intro m₁ m₂ φ α₁ α₂ hα₁_on hα₁_disj hα₂_on hα₂_disj
    let ξ₁_P : A m₁ ⟶ (pf_π.obj (L_W_m m₁)).obj.obj (Opposite.op U_P) :=
      CategoryTheory.Sheaf.freeYonedaHomEquiv α₁
    let ξ₂_P : A m₂ ⟶ (pf_π.obj (L_W_m m₂)).obj.obj (Opposite.op U_P) :=
      CategoryTheory.Sheaf.freeYonedaHomEquiv α₂
    let ξ₁ : A m₁ ⟶ (L_W_m m₁).obj.obj (Opposite.op Q_et) := ξ₁_P
    let ξ₂ : A m₂ ⟶ (L_W_m m₂).obj.obj (Opposite.op Q_et) := ξ₂_P
    let ψ_W : L_W_m m₁ ⟶ L_W_m m₂ := mapFree_W φ
    let ζ₁ : A m₁ ⟶ (L_W_m m₂).obj.obj (Opposite.op Q_et) :=
      ξ₁ ≫ ψ_W.hom.app (Opposite.op Q_et)
    let ζ₂ : A m₁ ⟶ (L_W_m m₂).obj.obj (Opposite.op Q_et) :=
      φ ≫ ξ₂
    have hα₁_on' : ξ₁ ≫ (L_W_m m₁).obj.map (Opposite.op σ₀) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 (L_W_m m₁)) := hα₁_on
    have hα₂_on' : ξ₂ ≫ (L_W_m m₂).obj.map (Opposite.op σ₀) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 (L_W_m m₂)) := hα₂_on
    have hζ_eq : ζ₁ = ζ₂ := by
      refine hClopenExt (L_W_m m₂) ζ₁ ζ₂ ?_ ?_
      · dsimp only [ζ₁, ζ₂]
        have hL : (ξ₁ ≫ ψ_W.hom.app (Opposite.op Q_et)) ≫ (L_W_m m₂).obj.map (Opposite.op σ₀) =
            (ξ₁ ≫ (L_W_m m₁).obj.map (Opposite.op σ₀)) ≫ ψ_W.hom.app (Opposite.op U_W) :=
          (CategoryTheory.Category.assoc _ _ _).trans
            ((congrArg (ξ₁ ≫ ·) (ψ_W.hom.naturality (Opposite.op σ₀)).symm).trans
              (CategoryTheory.Category.assoc _ _ _).symm)
        have hM : CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 (L_W_m m₁)) ≫
              ψ_W.hom.app (Opposite.op U_W) =
            φ ≫ CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 (L_W_m m₂)) := by
          calc CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 (L_W_m m₁)) ≫
                ψ_W.hom.app (Opposite.op U_W)
              = CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 (L_W_m m₁) ≫ ψ_W) :=
                (hRight_W (𝟙 (L_W_m m₁)) ψ_W).symm
            _ = CategoryTheory.Sheaf.freeYonedaHomEquiv (mapFree_W φ ≫ 𝟙 (L_W_m m₂)) :=
                congrArg CategoryTheory.Sheaf.freeYonedaHomEquiv
                  ((CategoryTheory.Category.id_comp ψ_W).trans
                    (CategoryTheory.Category.comp_id ψ_W).symm)
            _ = φ ≫ CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 (L_W_m m₂)) :=
                hLeft_W φ (𝟙 (L_W_m m₂))
        exact hL.trans
          ((congrArg (· ≫ ψ_W.hom.app (Opposite.op U_W)) hα₁_on').trans
            (hM.trans
              ((congrArg (φ ≫ ·) hα₂_on'.symm).trans
                (CategoryTheory.Category.assoc _ _ _).symm)))
      · intro V w hdisj
        dsimp only [ζ₁, ζ₂]
        have hL_w : (ξ₁ ≫ ψ_W.hom.app (Opposite.op Q_et)) ≫ (L_W_m m₂).obj.map (Opposite.op w) =
            (ξ₁ ≫ (L_W_m m₁).obj.map (Opposite.op w)) ≫ ψ_W.hom.app (Opposite.op V) :=
          (CategoryTheory.Category.assoc _ _ _).trans
            ((congrArg (ξ₁ ≫ ·) (ψ_W.hom.naturality (Opposite.op w)).symm).trans
              (CategoryTheory.Category.assoc _ _ _).symm)
        have hLHS0 : (ξ₁ ≫ ψ_W.hom.app (Opposite.op Q_et)) ≫ (L_W_m m₂).obj.map (Opposite.op w) = 0 :=
          hL_w.trans ((congrArg (· ≫ ψ_W.hom.app (Opposite.op V)) (hα₁_disj V w hdisj)).trans
            CategoryTheory.Limits.zero_comp)
        have hRHS0 : (φ ≫ ξ₂) ≫ (L_W_m m₂).obj.map (Opposite.op w) = 0 :=
          (CategoryTheory.Category.assoc _ _ _).trans
            ((congrArg (φ ≫ ·) (hα₂_disj V w hdisj)).trans CategoryTheory.Limits.comp_zero)
        exact hLHS0.trans hRHS0.symm
    apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
    exact (hRight_P α₁ (pf_π.map ψ_W)).trans (hζ_eq.trans (hLeft_P φ α₂).symm)

  induction r with
  | zero =>
    have hZero_LW0 : CategoryTheory.Limits.IsZero (L_W_m (ℓ ^ 0)) :=
      hZero_FW (A (ℓ ^ 0)) hZero_A0
    have hZero_LP0 : CategoryTheory.Limits.IsZero (L_P_m (ℓ ^ 0)) :=
      hZero_FP (A (ℓ ^ 0)) hZero_A0
    have hZero_pf0 : CategoryTheory.Limits.IsZero (pf_π.obj (L_W_m (ℓ ^ 0))) :=
      pf_π.map_isZero hZero_LW0
    refine ⟨?_, ?_⟩
    · intro s _
      exact hHDI_zero (L_W_m (ℓ ^ 0)) s hZero_LW0
    · intro α_π _ _ _
      exact ⟨⟨0, hZero_LP0.eq_of_src _ _, hZero_pf0.eq_of_src _ _⟩⟩
  | succ k ih =>
    obtain ⟨ι_k, π_k, hzero_k, hSE_A⟩ := hBock k
    obtain ⟨hzero_P, hSE_P⟩ := hSE_FP ι_k π_k hzero_k hSE_A
    obtain ⟨hzero_W, hSE_W⟩ := hSE_FW ι_k π_k hzero_k hSE_A
    let SC_P := CategoryTheory.ShortComplex.mk (mapFree_P ι_k) (mapFree_P π_k) hzero_P
    let SC_W := CategoryTheory.ShortComplex.mk (mapFree_W ι_k) (mapFree_W π_k) hzero_W
    have hHDI_succ : ∀ (s : ℕ), 1 ≤ s →
        CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage π s (L_W_m (ℓ ^ (k + 1)))) := by
      intro s hs
      exact hHDI_mid SC_W s hSE_W (hBase_HDI s hs) (ih.1 s hs)
    refine ⟨hHDI_succ, ?_⟩
    intro α_succ ξ_succ h_on_succ h_disj_succ
    have hSE_pfW : (SC_W.map pf_π).ShortExact :=
      hPushSE SC_W hSE_W hHDI_succ (hBase_HDI 1 le_rfl)
    obtain ⟨α₁, hα₁_on, hα₁_disj⟩ := hClopenWitness ℓ
    obtain ⟨α_k, hα_k_on, hα_k_disj⟩ := hClopenWitness (ℓ ^ k)
    have : CategoryTheory.IsIso α₁ := hBase_Iso α₁ hα₁_on hα₁_disj
    have : CategoryTheory.IsIso α_k := ih.2 α_k hα_k_on hα_k_disj
    let Φ_hom : SC_P ⟶ SC_W.map pf_π :=
      { τ₁ := α₁
        τ₂ := α_succ
        τ₃ := α_k
        comm₁₂ := hIntertwine ι_k α₁ α_succ hα₁_on hα₁_disj h_on_succ h_disj_succ
        comm₂₃ := hIntertwine π_k α_succ α_k h_on_succ h_disj_succ hα_k_on hα_k_disj }
    exact CategoryTheory.ShortComplex.isIso₂_of_shortExact_of_isIso₁₃ Φ_hom hSE_P hSE_pfW

theorem weil_gysin_clopen_fiber_sheaf_iso_and_higherDirectImage_zero (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (_ : IsUnit (ℓ : k))
    (_ : WeilProperModPrimeBaseChangeHolds k ℓ)
    (W₀ P₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsProper W₀.hom] [AlgebraicGeometry.IsProper P₀.hom]
    (π : Quiver.Hom W₀.left P₀.left)
    (_ : CategoryTheory.CategoryStruct.comp π P₀.hom = W₀.hom)
    (U : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine U]
    (j_W : Quiver.Hom U W₀.left) [AlgebraicGeometry.IsOpenImmersion j_W]
    (u_P : Quiver.Hom U P₀.left) (hu_P : AlgebraicGeometry.Etale u_P)
    (_ : CategoryTheory.CategoryStruct.comp j_W π = u_P)
    (hCont : (weilAltCdSitePullback π).IsContinuous
      P₀.left.smallEtaleTopology W₀.left.smallEtaleTopology)
    (σ₀ : Quiver.Hom (weilGysinEtaleObj j_W inferInstance)
      ((weilAltCdSitePullback π).obj (weilGysinEtaleObj u_P hu_P)))
    (_ : CategoryTheory.CategoryStruct.comp
      (((AlgebraicGeometry.Scheme.Etale.forget W₀.left).map σ₀).left)
      (CategoryTheory.Limits.pullback.fst u_P π) =
      CategoryTheory.CategoryStruct.id U)
    (_ : AlgebraicGeometry.IsOpenImmersion
      (((AlgebraicGeometry.Scheme.Etale.forget W₀.left).map σ₀).left))
    (_ : AlgebraicGeometry.IsClosedImmersion
      (((AlgebraicGeometry.Scheme.Etale.forget W₀.left).map σ₀).left))
    (r : ℕ) :
    let U_W := weilGysinEtaleObj j_W inferInstance
    let U_P := weilGysinEtaleObj u_P hu_P
    let pf_π := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
      (weilAltCdSitePullback π) AddCommGrpCat.{u} _
      P₀.left.smallEtaleTopology W₀.left.smallEtaleTopology hCont
    let L_P := weilGysinLocalTorsionSheaf P₀.left (ℓ ^ r) U_P
    let L_W := weilGysinLocalTorsionSheaf W₀.left (ℓ ^ r) U_W
    (∀ (s : ℕ), 1 ≤ s →
      CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage π s L_W)) ∧
    (∀ (α_π : Quiver.Hom L_P (pf_π.obj L_W)),
      let ξ := CategoryTheory.Sheaf.freeYonedaHomEquiv α_π
      CategoryTheory.CategoryStruct.comp ξ (L_W.obj.map (Opposite.op σ₀)) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id L_W) →
      (∀ (V : W₀.left.Etale)
          (w : Quiver.Hom V ((weilAltCdSitePullback π).obj U_P)),
        Disjoint
          (Set.range (((AlgebraicGeometry.Scheme.Etale.forget W₀.left).map w).left).base)
          (Set.range (((AlgebraicGeometry.Scheme.Etale.forget W₀.left).map σ₀).left).base) →
        CategoryTheory.CategoryStruct.comp ξ (L_W.obj.map (Opposite.op w)) = 0) →
      CategoryTheory.IsIso α_π) :=
by
  have hPBC : WeilProperModPrimeBaseChangeHolds k ℓ := ‹WeilProperModPrimeBaseChangeHolds k ℓ›
  have hπ : CategoryTheory.CategoryStruct.comp π P₀.hom = W₀.hom :=
    ‹CategoryTheory.CategoryStruct.comp π P₀.hom = W₀.hom›
  have hjπ : CategoryTheory.CategoryStruct.comp j_W π = u_P :=
    ‹CategoryTheory.CategoryStruct.comp j_W π = u_P›
  have hσ_fst : CategoryTheory.CategoryStruct.comp
      (((AlgebraicGeometry.Scheme.Etale.forget W₀.left).map σ₀).left)
      (CategoryTheory.Limits.pullback.fst u_P π) =
      CategoryTheory.CategoryStruct.id U := ‹_›
  have hσ_open : AlgebraicGeometry.IsOpenImmersion
      (((AlgebraicGeometry.Scheme.Etale.forget W₀.left).map σ₀).left) := ‹_›
  have hσ_closed : AlgebraicGeometry.IsClosedImmersion
      (((AlgebraicGeometry.Scheme.Etale.forget W₀.left).map σ₀).left) := ‹_›
  let U_W := weilGysinEtaleObj j_W inferInstance
  let U_P := weilGysinEtaleObj u_P hu_P
  let pf_π := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
    (weilAltCdSitePullback π) AddCommGrpCat.{u} _
    P₀.left.smallEtaleTopology W₀.left.smallEtaleTopology hCont
  have hProp_comp : AlgebraicGeometry.IsProper (π ≫ P₀.hom) := by
    rw [hπ]
    infer_instance
  have hProp_π : AlgebraicGeometry.IsProper π :=
    AlgebraicGeometry.IsProper.of_comp π P₀.hom
  have : AlgebraicGeometry.IsProper π := hProp_π
  have hAff_comp : AlgebraicGeometry.IsAffineHom (u_P ≫ P₀.hom) :=
    AlgebraicGeometry.isAffineHom_of_isAffine (u_P ≫ P₀.hom)
  have hAff_uP : AlgebraicGeometry.IsAffineHom u_P :=
    AlgebraicGeometry.IsAffineHom.of_comp u_P P₀.hom
  have : AlgebraicGeometry.IsAffineHom u_P := hAff_uP
  obtain ⟨hGeomCons, hSpecCons⟩ := weil_etale_geom_point_and_algClosed_sheaf_conservativity
  obtain ⟨hZeroReflect, hIsoReflect⟩ := hGeomCons P₀.left
  obtain ⟨_, P_pull_π, adj_π, _, hAdd_pf_aux, _, _, _⟩ :=
    weil_alt_cd_etale_pullback_adjunction_and_H0 π
  have hAdd_pf : pf_π.Additive := hAdd_pf_aux
  have hr_π : pf_π.IsRightAdjoint := ⟨P_pull_π, ⟨adj_π⟩⟩
  let L_P1 := weilGysinLocalTorsionSheaf P₀.left ℓ U_P
  let L_W1 := weilGysinLocalTorsionSheaf W₀.left ℓ U_W
  have hFiberData : ∀ (x : ↥P₀.left),
      let Ω_x := AlgebraicClosure ↥(P₀.left.residueField x)
      let S_x := AlgebraicGeometry.Spec (CommRingCat.of Ω_x)
      let g_x := CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥(P₀.left.residueField x) Ω_x)))
        (P₀.left.fromSpecResidueField x)
      let W_x := CategoryTheory.Limits.pullback π g_x
      let g'_0 := CategoryTheory.Limits.pullback.fst π g_x
      let f'_0 := CategoryTheory.Limits.pullback.snd π g_x
      let F_Wx := weilGysinLocalTorsionSheaf W_x ℓ ((weilAltCdSitePullback g'_0).obj U_W)
      (∀ q : ℕ, WeilIsEtaleSheafPullback g_x
        (weilEtaleHigherDirectImage π q L_W1)
        (weilEtaleHigherDirectImage f'_0 q F_Wx)) ∧
      (∀ s : ℕ, 1 ≤ s →
        CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f'_0 s F_Wx)) ∧
      (∀ (α₁ : Quiver.Hom L_P1 (pf_π.obj L_W1)),
        let ξ₁ := CategoryTheory.Sheaf.freeYonedaHomEquiv α₁
        CategoryTheory.CategoryStruct.comp ξ₁ (L_W1.obj.map (Opposite.op σ₀)) =
          CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id L_W1) →
        (∀ (V : W₀.left.Etale) (w : Quiver.Hom V ((weilAltCdSitePullback π).obj U_P)),
          Disjoint
            (Set.range (((AlgebraicGeometry.Scheme.Etale.forget W₀.left).map w).left).base)
            (Set.range (((AlgebraicGeometry.Scheme.Etale.forget W₀.left).map σ₀).left).base) →
          CategoryTheory.CategoryStruct.comp ξ₁ (L_W1.obj.map (Opposite.op w)) = 0) →
        ∃ (hc : (weilAltCdSitePullback g_x).IsContinuous
            P₀.left.smallEtaleTopology S_x.smallEtaleTopology)
          (P_pull_x : CategoryTheory.Functor
            (CategoryTheory.Sheaf P₀.left.smallEtaleTopology AddCommGrpCat.{u})
            (CategoryTheory.Sheaf S_x.smallEtaleTopology AddCommGrpCat.{u}))
          (_ : P_pull_x ⊣ @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
            (weilAltCdSitePullback g_x) AddCommGrpCat.{u} _
            P₀.left.smallEtaleTopology S_x.smallEtaleTopology hc)
          (_ : P_pull_x.Additive)
          (_ : CategoryTheory.Limits.PreservesFiniteLimits P_pull_x)
          (_ : CategoryTheory.Limits.PreservesFiniteColimits P_pull_x),
          CategoryTheory.IsIso (P_pull_x.map α₁)) := by
    intro x
    let Ω_x := AlgebraicClosure ↥(P₀.left.residueField x)
    let S_x := AlgebraicGeometry.Spec (CommRingCat.of Ω_x)
    let T_x := weilGysinEtaleObj (CategoryTheory.CategoryStruct.id S_x) inferInstance
    let g_x := CategoryTheory.CategoryStruct.comp
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥(P₀.left.residueField x) Ω_x)))
      (P₀.left.fromSpecResidueField x)
    let W_x := CategoryTheory.Limits.pullback π g_x
    let g'_0 := CategoryTheory.Limits.pullback.fst π g_x
    let f'_0 := CategoryTheory.Limits.pullback.snd π g_x
    have hpb_x : CategoryTheory.IsPullback g'_0 f'_0 π g_x :=
      CategoryTheory.IsPullback.of_hasPullback π g_x
    let F_Wx := weilGysinLocalTorsionSheaf W_x ℓ ((weilAltCdSitePullback g'_0).obj U_W)
    obtain ⟨hc_f', _⟩ := weil_alt_cd_etale_pullback_adjunction_and_H0 f'_0
    obtain ⟨hc_gx, P_pull_x, adj_x, hAdd_x, _, hLim_x, hColim_x, _⟩ :=
      weil_alt_cd_etale_pullback_adjunction_and_H0 g_x
    have : P_pull_x.Additive := hAdd_x
    obtain ⟨hZero_Tx, hIso_Tx, hProj_Tx⟩ := hSpecCons Ω_x
    obtain ⟨⟨hℓ_kill, hPb_LW⟩, hSub_Wx, ⟨d_x, ⟨equiv_fib⟩, hKron⟩⟩ :=
      weil_gysin_clopen_geom_fiber_kronecker_and_acyclicity Ω_x ℓ W₀.left P₀.left U W_x
        π g_x f'_0 g'_0 hpb_x j_W u_P hu_P hjπ hCont hc_f' hc_gx P_pull_x adj_x
        σ₀ hσ_fst hσ_open hσ_closed hProj_Tx
    let f_ov : W₀ ⟶ P₀ := CategoryTheory.Over.homMk π hπ
    let S'_ov : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
      CategoryTheory.Over.mk (g_x ≫ P₀.hom)
    let g_ov : S'_ov ⟶ P₀ := CategoryTheory.Over.homMk g_x rfl
    let X'_ov : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
      CategoryTheory.Over.mk (f'_0 ≫ S'_ov.hom)
    let f'_ov : X'_ov ⟶ S'_ov := CategoryTheory.Over.homMk f'_0 rfl
    let g'_ov : X'_ov ⟶ W₀ := CategoryTheory.Over.homMk g'_0 (by
      change g'_0 ≫ W₀.hom = f'_0 ≫ g_x ≫ P₀.hom
      rw [← hπ, ← CategoryTheory.Category.assoc, hpb_x.w, CategoryTheory.Category.assoc])
    have hPBC_x : ∀ q : ℕ, WeilIsEtaleSheafPullback g_x
        (weilEtaleHigherDirectImage π q L_W1)
        (weilEtaleHigherDirectImage f'_0 q F_Wx) :=
      hPBC W₀ P₀ S'_ov X'_ov f_ov g_ov f'_ov g'_ov hProp_π hpb_x L_W1 F_Wx hℓ_kill hPb_LW
    have hFibZero : ∀ s : ℕ, 1 ≤ s →
        CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f'_0 s F_Wx) := by
      intro s hs
      exact hZero_Tx _ (hSub_Wx s hs)
    refine ⟨hPBC_x, hFibZero, ?_⟩
    intro α₁ ξ₁ hα₁_on hα₁_disj
    obtain ⟨e₁, ev₂, h_linv⟩ := hKron α₁ hα₁_on hα₁_disj
    obtain ⟨hc_pbc0, hr_pbc0, ⟨e_pbc0⟩⟩ := hPBC_x 0
    have hhc_eq : hc_pbc0 = hc_gx := Subsingleton.elim _ _
    subst hhc_eq
    have : (weilAltCdSitePullback g_x).IsContinuous
      P₀.left.smallEtaleTopology S_x.smallEtaleTopology := hc_pbc0
    have : ((weilAltCdSitePullback g_x).sheafPushforwardContinuous AddCommGrpCat.{u}
      P₀.left.smallEtaleTopology S_x.smallEtaleTopology).IsRightAdjoint := hr_pbc0
    let pb_gx := (weilAltCdSitePullback g_x).sheafPullback AddCommGrpCat.{u}
      P₀.left.smallEtaleTopology S_x.smallEtaleTopology
    let adj_std := (weilAltCdSitePullback g_x).sheafAdjunctionContinuous AddCommGrpCat.{u}
      P₀.left.smallEtaleTopology S_x.smallEtaleTopology
    let e_uniq : P_pull_x ≅ pb_gx := CategoryTheory.Adjunction.leftAdjointUniq adj_x adj_std
    have : (weilAltCdSitePullback π).IsContinuous
      P₀.left.smallEtaleTopology W₀.left.smallEtaleTopology := hCont
    have : (weilAltCdSitePullback f'_0).IsContinuous
      S_x.smallEtaleTopology W_x.smallEtaleTopology := hc_f'
    obtain ⟨iso_π0⟩ := (weil_etale_higherDirectImage_shortExact_calculus π).2.1 L_W1
    obtain ⟨iso_f'0⟩ := (weil_etale_higherDirectImage_shortExact_calculus f'_0).2.1 F_Wx
    let iso_sheaf : P_pull_x.obj (pf_π.obj L_W1) ≅
        (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
          (weilAltCdSitePullback f'_0) AddCommGrpCat.{u} _
          S_x.smallEtaleTopology W_x.smallEtaleTopology hc_f').obj F_Wx :=
      (e_uniq.app (pf_π.obj L_W1)) ≪≫
        (pb_gx.mapIso iso_π0.symm) ≪≫
        e_pbc0 ≪≫
        iso_f'0
    let iso_sec : (P_pull_x.obj (pf_π.obj L_W1)).obj.obj (Opposite.op T_x) ≅
        ((@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
          (weilAltCdSitePullback f'_0) AddCommGrpCat.{u} _
          S_x.smallEtaleTopology W_x.smallEtaleTopology hc_f').obj F_Wx).obj.obj
          (Opposite.op T_x) :=
      ((CategoryTheory.sheafToPresheaf S_x.smallEtaleTopology AddCommGrpCat.{u} ⋙
        (CategoryTheory.evaluation (Opposite S_x.Etale) AddCommGrpCat.{u}).obj
          (Opposite.op T_x)).mapIso iso_sheaf)
    let e_sec : ↥((P_pull_x.obj (pf_π.obj L_W1)).obj.obj (Opposite.op T_x)) ≃
        ↥(((@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
          (weilAltCdSitePullback f'_0) AddCommGrpCat.{u} _
          S_x.smallEtaleTopology W_x.smallEtaleTopology hc_f').obj F_Wx).obj.obj
          (Opposite.op T_x)) :=
      { toFun := iso_sec.hom.hom
        invFun := iso_sec.inv.hom
        left_inv := fun y => by
          change (iso_sec.hom ≫ iso_sec.inv).hom y = y
          rw [iso_sec.hom_inv_id]
          rfl
        right_inv := fun y => by
          change (iso_sec.inv ≫ iso_sec.hom).hom y = y
          rw [iso_sec.inv_hom_id]
          rfl }
    let e₂ := e_sec.trans equiv_fib
    let f_x : ↥((P_pull_x.obj L_P1).obj.obj (Opposite.op T_x)) →
        ↥((P_pull_x.obj (pf_π.obj L_W1)).obj.obj (Opposite.op T_x)) :=
      ((P_pull_x.map α₁).hom.app (Opposite.op T_x)).hom
    have : NeZero ℓ := ⟨(Fact.out : Nat.Prime ℓ).ne_zero⟩
    have hinj₁ : Function.Injective (f_x ∘ e₁) :=
      Function.LeftInverse.injective h_linv
    have hinj₂ : Function.Injective (e₂ ∘ f_x ∘ e₁) :=
      e₂.injective.comp hinj₁
    have hbij_comp : Function.Bijective (e₂ ∘ f_x ∘ e₁) :=
      Finite.injective_iff_bijective.mp hinj₂
    have hbij_fx : Function.Bijective f_x := by
      have hfx_eq : f_x = ⇑e₂.symm ∘ (e₂ ∘ f_x ∘ e₁) ∘ ⇑e₁.symm := by
        funext z
        simp [Function.comp]
      rw [hfx_eq]
      exact e₂.symm.bijective.comp (hbij_comp.comp e₁.symm.bijective)
    exact ⟨hc_pbc0, P_pull_x, adj_x, hAdd_x, hLim_x, hColim_x, hIso_Tx (P_pull_x.map α₁) hbij_fx⟩
  have hBase_HDI : ∀ (s : ℕ), 1 ≤ s →
      CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage π s L_W1) := by
    intro s hs
    apply hZeroReflect
    intro x
    let Ω_x := AlgebraicClosure ↥(P₀.left.residueField x)
    let S_x := AlgebraicGeometry.Spec (CommRingCat.of Ω_x)
    let g_x := CategoryTheory.CategoryStruct.comp
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥(P₀.left.residueField x) Ω_x)))
      (P₀.left.fromSpecResidueField x)
    obtain ⟨hPBC_x, hFibZero_x, _⟩ := hFiberData x
    obtain ⟨hc_s, hr_s, ⟨e_s⟩⟩ := hPBC_x s
    have : (weilAltCdSitePullback g_x).IsContinuous
      P₀.left.smallEtaleTopology S_x.smallEtaleTopology := hc_s
    have : ((weilAltCdSitePullback g_x).sheafPushforwardContinuous AddCommGrpCat.{u}
      P₀.left.smallEtaleTopology S_x.smallEtaleTopology).IsRightAdjoint := hr_s
    let pb_s := (weilAltCdSitePullback g_x).sheafPullback AddCommGrpCat.{u}
      P₀.left.smallEtaleTopology S_x.smallEtaleTopology
    let adj_s := (weilAltCdSitePullback g_x).sheafAdjunctionContinuous AddCommGrpCat.{u}
      P₀.left.smallEtaleTopology S_x.smallEtaleTopology
    exact ⟨hc_s, pb_s, adj_s, (hFibZero_x s hs).of_iso e_s⟩
  have hBase_Iso : ∀ (α₁ : Quiver.Hom L_P1 (pf_π.obj L_W1)),
      let ξ₁ := CategoryTheory.Sheaf.freeYonedaHomEquiv α₁
      CategoryTheory.CategoryStruct.comp ξ₁ (L_W1.obj.map (Opposite.op σ₀)) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id L_W1) →
      (∀ (V : W₀.left.Etale) (w : Quiver.Hom V ((weilAltCdSitePullback π).obj U_P)),
        Disjoint
          (Set.range (((AlgebraicGeometry.Scheme.Etale.forget W₀.left).map w).left).base)
          (Set.range (((AlgebraicGeometry.Scheme.Etale.forget W₀.left).map σ₀).left).base) →
        CategoryTheory.CategoryStruct.comp ξ₁ (L_W1.obj.map (Opposite.op w)) = 0) →
      CategoryTheory.IsIso α₁ := by
    intro α₁ ξ₁ hα₁_on hα₁_disj
    apply hIsoReflect
    intro x
    exact (hFiberData x).2.2 α₁ hα₁_on hα₁_disj
  have hPushSE :
      letI : pf_π.Additive := hAdd_pf
      ∀ (SC : CategoryTheory.ShortComplex
          (CategoryTheory.Sheaf W₀.left.smallEtaleTopology AddCommGrpCat.{u})),
        SC.ShortExact →
        (∀ (p : ℕ), 1 ≤ p → CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage π p SC.X₂)) →
        CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage π 1 SC.X₁) →
        (SC.map pf_π).ShortExact := by
    have : (weilAltCdSitePullback π).IsContinuous
      P₀.left.smallEtaleTopology W₀.left.smallEtaleTopology := hCont
    have : pf_π.IsRightAdjoint := hr_π
    have : pf_π.Additive := hAdd_pf
    intro SC hSE hX₂ hX₁
    exact ((weil_etale_higherDirectImage_shortExact_calculus π).2.2 SC hSE hX₂).1.2 hX₁
  exact weil_gysin_clopen_freeYoneda_bockstein_tower ℓ W₀.left P₀.left U π
    j_W inferInstance u_P hu_P hjπ hCont hAdd_pf σ₀ hσ_fst hσ_open hσ_closed
    hPushSE hBase_HDI hBase_Iso r

theorem weil_gysin_clopen_degenerate_leray_and_witness_equiv (W₀ P₀ U : AlgebraicGeometry.Scheme.{u})
    (π : Quiver.Hom W₀ P₀)
    (j_W : Quiver.Hom U W₀) (hj_W : AlgebraicGeometry.Etale j_W)
    (u_P : Quiver.Hom U P₀) (hu_P : AlgebraicGeometry.Etale u_P)
    (_ : CategoryTheory.CategoryStruct.comp j_W π = u_P)
    (hCont : (weilAltCdSitePullback π).IsContinuous
      P₀.smallEtaleTopology W₀.smallEtaleTopology)
    (σ₀ : Quiver.Hom (weilGysinEtaleObj j_W hj_W)
      ((weilAltCdSitePullback π).obj (weilGysinEtaleObj u_P hu_P)))
    (_ : CategoryTheory.CategoryStruct.comp
      (((AlgebraicGeometry.Scheme.Etale.forget W₀).map σ₀).left)
      (CategoryTheory.Limits.pullback.fst u_P π) =
      CategoryTheory.CategoryStruct.id U)
    (_ : AlgebraicGeometry.IsOpenImmersion
      (((AlgebraicGeometry.Scheme.Etale.forget W₀).map σ₀).left))
    (_ : AlgebraicGeometry.IsClosedImmersion
      (((AlgebraicGeometry.Scheme.Etale.forget W₀).map σ₀).left))
    (m : ℕ) :
    let U_W := weilGysinEtaleObj j_W hj_W
    let U_P := weilGysinEtaleObj u_P hu_P
    let pf_π := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
      (weilAltCdSitePullback π) AddCommGrpCat.{u} _
      P₀.smallEtaleTopology W₀.smallEtaleTopology hCont
    let L_P := weilGysinLocalTorsionSheaf P₀ m U_P
    let L_W := weilGysinLocalTorsionSheaf W₀ m U_W
    ∃ (α_π : Quiver.Hom L_P (pf_π.obj L_W)),
      CategoryTheory.CategoryStruct.comp
          (CategoryTheory.Sheaf.freeYonedaHomEquiv α_π)
          (L_W.obj.map (Opposite.op σ₀)) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id L_W) ∧
      (∀ (V : W₀.Etale)
          (w : Quiver.Hom V ((weilAltCdSitePullback π).obj U_P)),
        Disjoint
          (Set.range (((AlgebraicGeometry.Scheme.Etale.forget W₀).map w).left).base)
          (Set.range (((AlgebraicGeometry.Scheme.Etale.forget W₀).map σ₀).left).base) →
        CategoryTheory.CategoryStruct.comp
          (CategoryTheory.Sheaf.freeYonedaHomEquiv α_π)
          (L_W.obj.map (Opposite.op w)) = 0) ∧
      (∀ (q : ℕ),
        ∃ (Φ : weilGysinLocalTorsionH P₀ m U_P q →+ weilGysinLocalTorsionH W₀ m U_W q),
          (∀ (z_P : weilGysinLocalTorsionH P₀ m U_P q)
              (z_W : weilGysinLocalTorsionH W₀ m U_W q),
            WeilGysinIsClopenPullbackOnLocalH π U_W U_P
              (CategoryTheory.Iso.refl U) m q z_P z_W ↔ Φ z_P = z_W) ∧
          (CategoryTheory.IsIso α_π →
            (∀ (s : ℕ), 1 ≤ s →
              CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage π s L_W)) →
            Function.Bijective Φ)) :=
by
  classical
  have hjπ : j_W ≫ π = u_P := ‹_›
  have hσ_fst : (((AlgebraicGeometry.Scheme.Etale.forget W₀).map σ₀).left) ≫
      CategoryTheory.Limits.pullback.fst u_P π = 𝟙 U := ‹_›
  have hσ_open : AlgebraicGeometry.IsOpenImmersion
      (((AlgebraicGeometry.Scheme.Etale.forget W₀).map σ₀).left) := ‹_›
  have hσ_closed : AlgebraicGeometry.IsClosedImmersion
      (((AlgebraicGeometry.Scheme.Etale.forget W₀).map σ₀).left) := ‹_›
  intro U_W U_P pf_π L_P L_W
  let Fgt_W := AlgebraicGeometry.Scheme.Etale.forget W₀
  let B_π := weilAltCdSitePullback π
  let J_W := W₀.smallEtaleTopology
  let J_P := P₀.smallEtaleTopology
  let Q_et : W₀.Etale := B_π.obj U_P
  let s₀ : U ⟶ Q_et.left := ((Fgt_W.map σ₀).left)
  let AM : AddCommGrpCat.{u} := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
  let η_free : AM ⟶ L_W.obj.obj (Opposite.op U_W) :=
    CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 L_W)

  
  
  
  have hPart1 : ∃ (ξ₀ : AM ⟶ L_W.obj.obj (Opposite.op Q_et)),
      ξ₀ ≫ L_W.obj.map (Opposite.op σ₀) = η_free ∧
      (∀ (V : W₀.Etale) (w : V ⟶ Q_et),
        Disjoint (Set.range ((Fgt_W.map w).left).base) (Set.range s₀.base) →
        ξ₀ ≫ L_W.obj.map (Opposite.op w) = 0) ∧
      (∀ (ξ' : AM ⟶ L_W.obj.obj (Opposite.op Q_et)),
        ξ' ≫ L_W.obj.map (Opposite.op σ₀) = η_free →
        (∀ (V : W₀.Etale) (w : V ⟶ Q_et),
          Disjoint (Set.range ((Fgt_W.map w).left).base) (Set.range s₀.base) →
          ξ' ≫ L_W.obj.map (Opposite.op w) = 0) →
        ξ' = ξ₀) := by
    let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
      @AlgebraicGeometry.Etale
    have : P_et.IsStableUnderComposition :=
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    have : AlgebraicGeometry.IsOpenImmersion s₀ := hσ_open
    have : AlgebraicGeometry.IsClosedImmersion s₀ := hσ_closed
    have hSheaf_LW : CategoryTheory.Presheaf.IsSheaf J_W L_W.obj := L_W.2

    have hMem_JW : ∀ {Z : W₀.Etale} (R : CategoryTheory.Sieve Z),
        (∀ x : ↥Z.left, ∃ (Y : W₀.Etale) (f : Y ⟶ Z) (y : ↥Y.left),
          R.arrows f ∧ P_et f.left ∧ f.left y = x) → R ∈ J_W Z := by
      intro Z R hcov
      change R ∈ AlgebraicGeometry.Scheme.smallGrothendieckTopology P_et W₀ Z
      rw [AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology W₀
        (le_refl P_et)]
      exact (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology Z R).mpr hcov

    have hEmpty_ext : ∀ (Z : W₀.Etale), IsEmpty ↥Z.left →
        ∀ (g₁ g₂ : AM ⟶ L_W.obj.obj (Opposite.op Z)), g₁ = g₂ := by
      intro Z hEmp g₁ g₂
      have hBot : (⊥ : CategoryTheory.Sieve Z) ∈ J_W Z :=
        hMem_JW ⊥ (fun x => IsEmpty.elim hEmp x)
      exact hSheaf_LW.hom_ext ⟨⊥, hBot⟩ g₁ g₂ (fun I => False.elim I.hf)

    have hσ_mono : ∀ {Y : W₀.Etale} {g₁ g₂ : Y ⟶ U_W}, g₁ ≫ σ₀ = g₂ ≫ σ₀ → g₁ = g₂ := by
      intro Y g₁ g₂ heq
      have hleft : g₁.left ≫ s₀ = g₂.left ≫ s₀ := congrArg (fun k => k.left) heq
      exact CategoryTheory.MorphismProperty.Comma.Hom.ext
        ((cancel_mono s₀).mp hleft) (Subsingleton.elim _ _)

    have hRange_closed : IsClosed (Set.range s₀.base) :=
      ((AlgebraicGeometry.IsClosedImmersion.iff_isPreimmersion (f := s₀)).mp hσ_closed).2
    let O_c : Q_et.left.Opens := ⟨(Set.range s₀.base)ᶜ, hRange_closed.isOpen_compl⟩
    have hEt_Vc : AlgebraicGeometry.Etale (O_c.ι ≫ Q_et.hom) := by
      have : AlgebraicGeometry.Etale Q_et.hom := Q_et.prop
      infer_instance
    let V_c : W₀.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (O_c.ι ≫ Q_et.hom) hEt_Vc
    let w_c : V_c ⟶ Q_et := CategoryTheory.MorphismProperty.Over.homMk O_c.ι rfl trivial
    have hRange_wc : Set.range w_c.left.base = (Set.range s₀.base)ᶜ :=
      AlgebraicGeometry.Scheme.Opens.range_ι O_c

    let Y_cl : Bool → W₀.Etale := fun b => Bool.rec V_c U_W b
    let f_cl : ∀ b : Bool, Y_cl b ⟶ Q_et := fun b => Bool.rec w_c σ₀ b
    let R_cl : CategoryTheory.Sieve Q_et := CategoryTheory.Sieve.ofArrows Y_cl f_cl
    have hR_cl_mem : R_cl ∈ J_W Q_et := by
      apply hMem_JW
      intro x
      by_cases hx : x ∈ Set.range s₀.base
      · obtain ⟨u, hu⟩ := hx
        exact ⟨U_W, σ₀, u, CategoryTheory.Sieve.ofArrows_mk Y_cl f_cl true, inferInstance, hu⟩
      · have hx_wc : x ∈ Set.range w_c.left.base := by
          rw [hRange_wc]
          exact hx
        obtain ⟨v, hv⟩ := hx_wc
        exact ⟨V_c, w_c, v, CategoryTheory.Sieve.ofArrows_mk Y_cl f_cl false, inferInstance, hv⟩
    let S_cl : J_W.Cover Q_et := ⟨R_cl, hR_cl_mem⟩

    have hArrow_cases : ∀ (I : S_cl.Arrow),
        (∃ g : I.Y ⟶ U_W, g ≫ σ₀ = I.f) ∨ (∃ u : I.Y ⟶ V_c, u ≫ w_c = I.f) := by
      intro I
      rcases I.hf with ⟨W_arr, u_arr, f_arr, ⟨b⟩, h_eq⟩
      cases b
      · right; exact ⟨u_arr, h_eq⟩
      · left; exact ⟨u_arr, h_eq⟩

    let x_fam : ∀ (I : S_cl.Arrow), AM ⟶ L_W.obj.obj (Opposite.op I.Y) :=
      fun I =>
        if h : ∃ g : I.Y ⟶ U_W, g ≫ σ₀ = I.f then
          η_free ≫ L_W.obj.map (Classical.choose h).op
        else 0

    have hDisj_empty : ∀ {Z : W₀.Etale} (a : Z ⟶ U_W) (b : Z ⟶ V_c),
        a ≫ σ₀ = b ≫ w_c → IsEmpty ↥Z.left := by
      intro Z a b hab
      refine ⟨fun z => ?_⟩
      have hpt : (a ≫ σ₀).left.base z = (b ≫ w_c).left.base z :=
        congrArg (fun k => k.left.base z) hab
      have h_in : (a ≫ σ₀).left.base z ∈ Set.range s₀.base := ⟨a.left.base z, rfl⟩
      have h_out : (b ≫ w_c).left.base z ∈ (Set.range s₀.base)ᶜ := by
        rw [← hRange_wc]
        exact ⟨b.left.base z, rfl⟩
      exact h_out (hpt ▸ h_in)

    have hx_compat : ∀ ⦃I₁ I₂ : S_cl.Arrow⦄ (r : I₁.Relation I₂),
        x_fam I₁ ≫ L_W.obj.map r.g₁.op = x_fam I₂ ≫ L_W.obj.map r.g₂.op := by
      intro I₁ I₂ r
      by_cases h₁ : ∃ g : I₁.Y ⟶ U_W, g ≫ σ₀ = I₁.f <;>
        by_cases h₂ : ∃ g : I₂.Y ⟶ U_W, g ≫ σ₀ = I₂.f
      · simp only [x_fam, h₁, h₂, ↓reduceDIte]
        have hg₁ := Classical.choose_spec h₁
        have hg₂ := Classical.choose_spec h₂
        have heq_σ : (r.g₁ ≫ Classical.choose h₁) ≫ σ₀ = (r.g₂ ≫ Classical.choose h₂) ≫ σ₀ := by
          rw [Category.assoc, hg₁, r.w, Category.assoc, hg₂]
        have heq_g : r.g₁ ≫ Classical.choose h₁ = r.g₂ ≫ Classical.choose h₂ := hσ_mono heq_σ
        rw [Category.assoc, ← L_W.obj.map_comp, ← op_comp, heq_g,
          op_comp, L_W.obj.map_comp, Category.assoc]
      · rcases hArrow_cases I₂ with h₂' | ⟨u₂, hu₂⟩
        · exact False.elim (h₂ h₂')
        · have hg₁ := Classical.choose_spec h₁
          have hab : (r.g₁ ≫ Classical.choose h₁) ≫ σ₀ = (r.g₂ ≫ u₂) ≫ w_c := by
            rw [Category.assoc, hg₁, r.w, Category.assoc, hu₂]
          exact hEmpty_ext r.Z (hDisj_empty _ _ hab) _ _
      · rcases hArrow_cases I₁ with h₁' | ⟨u₁, hu₁⟩
        · exact False.elim (h₁ h₁')
        · have hg₂ := Classical.choose_spec h₂
          have hab : (r.g₂ ≫ Classical.choose h₂) ≫ σ₀ = (r.g₁ ≫ u₁) ≫ w_c := by
            rw [Category.assoc, hg₂, ← r.w, Category.assoc, hu₁]
          exact hEmpty_ext r.Z (hDisj_empty _ _ hab) _ _
      · simp only [x_fam, h₁, h₂, ↓reduceDIte, Limits.zero_comp]

    let ξ₀ : AM ⟶ L_W.obj.obj (Opposite.op Q_et) := hSheaf_LW.amalgamate S_cl x_fam hx_compat

    have hξ₀_on : ξ₀ ≫ L_W.obj.map (Opposite.op σ₀) = η_free := by
      let I_σ : S_cl.Arrow := ⟨U_W, σ₀, CategoryTheory.Sieve.ofArrows_mk Y_cl f_cl true⟩
      have hmap := hSheaf_LW.amalgamate_map S_cl x_fam hx_compat I_σ
      change ξ₀ ≫ L_W.obj.map (Opposite.op σ₀) = x_fam I_σ at hmap
      rw [hmap]
      dsimp only [x_fam]
      split_ifs with hex
      · have hg_id : Classical.choose hex = 𝟙 U_W :=
          hσ_mono ((Classical.choose_spec hex).trans (Category.id_comp σ₀).symm)
        rw [hg_id, op_id, L_W.obj.map_id, Category.comp_id]
      · exact False.elim (hex ⟨𝟙 U_W, Category.id_comp σ₀⟩)

    have hξ₀_wc : ξ₀ ≫ L_W.obj.map (Opposite.op w_c) = 0 := by
      let I_wc : S_cl.Arrow := ⟨V_c, w_c, CategoryTheory.Sieve.ofArrows_mk Y_cl f_cl false⟩
      have hmap := hSheaf_LW.amalgamate_map S_cl x_fam hx_compat I_wc
      change ξ₀ ≫ L_W.obj.map (Opposite.op w_c) = x_fam I_wc at hmap
      rw [hmap]
      dsimp only [x_fam]
      split_ifs with hex
      · obtain ⟨g, hg⟩ := hex
        have hEmp : IsEmpty ↥V_c.left :=
          hDisj_empty g (𝟙 V_c) (hg.trans (Category.id_comp w_c).symm)
        exact hEmpty_ext V_c hEmp _ _
      · rfl

    have hξ₀_disj : ∀ (V : W₀.Etale) (w : V ⟶ Q_et),
        Disjoint (Set.range ((Fgt_W.map w).left).base) (Set.range s₀.base) →
        ξ₀ ≫ L_W.obj.map (Opposite.op w) = 0 := by
      intro V w hdisj
      have hsub : Set.range ⇑w.left ⊆ Set.range ⇑O_c.ι := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        intro y hy hys
        exact Set.disjoint_left.mp hdisj hy hys
      let u_lift : V.left ⟶ O_c.toScheme := AlgebraicGeometry.IsOpenImmersion.lift O_c.ι w.left hsub
      have hu_fac : u_lift ≫ O_c.ι = w.left :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac O_c.ι w.left hsub
      have hu_over : u_lift ≫ V_c.hom = V.hom := by
        change u_lift ≫ (O_c.ι ≫ Q_et.hom) = V.hom
        rw [← Category.assoc, hu_fac]
        exact CategoryTheory.MorphismProperty.Over.w w
      let ω : V ⟶ V_c := CategoryTheory.MorphismProperty.Over.homMk u_lift hu_over trivial
      have hω : ω ≫ w_c = w :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext hu_fac (Subsingleton.elim _ _)
      change ξ₀ ≫ L_W.obj.map w.op = 0
      have hwc0 : ξ₀ ≫ L_W.obj.map w_c.op = 0 := hξ₀_wc
      rw [← hω, op_comp, L_W.obj.map_comp, ← Category.assoc, hwc0, Limits.zero_comp]

    have hξ₀_uniq : ∀ (ξ' : AM ⟶ L_W.obj.obj (Opposite.op Q_et)),
        ξ' ≫ L_W.obj.map (Opposite.op σ₀) = η_free →
        (∀ (V : W₀.Etale) (w : V ⟶ Q_et),
          Disjoint (Set.range ((Fgt_W.map w).left).base) (Set.range s₀.base) →
          ξ' ≫ L_W.obj.map (Opposite.op w) = 0) →
        ξ' = ξ₀ := by
      intro ξ' h_on' h_disj'
      have hwc' : ξ' ≫ L_W.obj.map w_c.op = 0 := by
        apply h_disj' V_c w_c
        change Disjoint (Set.range w_c.left.base) (Set.range s₀.base)
        rw [hRange_wc]
        exact disjoint_compl_left
      have hwc0 : ξ₀ ≫ L_W.obj.map w_c.op = 0 := hξ₀_wc
      have hon' : ξ' ≫ L_W.obj.map σ₀.op = η_free := h_on'
      have hon0 : ξ₀ ≫ L_W.obj.map σ₀.op = η_free := hξ₀_on
      refine hSheaf_LW.hom_ext S_cl ξ' ξ₀ (fun I => ?_)
      rcases hArrow_cases I with ⟨g, hg⟩ | ⟨u, hu⟩
      · rw [← hg, op_comp, L_W.obj.map_comp, ← Category.assoc, ← Category.assoc, hon', hon0]
      · rw [← hu, op_comp, L_W.obj.map_comp, ← Category.assoc, ← Category.assoc, hwc', hwc0]

    exact ⟨ξ₀, hξ₀_on, hξ₀_disj, hξ₀_uniq⟩

  obtain ⟨ξ₀, hξ₀_on, hξ₀_disj, hξ₀_uniq⟩ := hPart1
  let equiv_P : (L_P ⟶ pf_π.obj L_W) ≃
      (AM ⟶ (pf_π.obj L_W).obj.obj (Opposite.op U_P)) :=
    CategoryTheory.Sheaf.freeYonedaHomEquiv
  let α_π : L_P ⟶ pf_π.obj L_W := equiv_P.symm ξ₀
  have hα_equiv : CategoryTheory.Sheaf.freeYonedaHomEquiv α_π = ξ₀ :=
    equiv_P.apply_symm_apply ξ₀

  
  
  
  obtain ⟨hCont₀, P_pull₀, adj_π₀, hAdd₀, hPushAdd₀, hLim₀, hColim₀, hInj₀, _⟩ :=
    weil_alt_cd_etale_pullback_adjunction_and_H0 π
  cases Subsingleton.elim hCont₀ hCont
  have : P_pull₀.Additive := hAdd₀
  have : pf_π.Additive := hPushAdd₀
  have : CategoryTheory.Limits.PreservesFiniteLimits P_pull₀ := hLim₀
  have : CategoryTheory.Limits.PreservesFiniteColimits P_pull₀ := hColim₀

  let Aℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
  let Fℤ_W : CategoryTheory.Sheaf J_W AddCommGrpCat.{u} :=
    (CategoryTheory.constantSheaf J_W AddCommGrpCat.{u}).obj Aℤ
  let Fℤ_P : CategoryTheory.Sheaf J_P AddCommGrpCat.{u} :=
    (CategoryTheory.constantSheaf J_P AddCommGrpCat.{u}).obj Aℤ
  let T_W₀ := weilEtaleIdTerminal.{u} W₀
  let hT_W₀ := weilEtaleIdTerminalIsTerminal.{u} W₀
  let T_P₀ := weilEtaleIdTerminal.{u} P₀
  let hT_P₀ := weilEtaleIdTerminalIsTerminal.{u} P₀
  let adj_W₀ := CategoryTheory.constantSheafAdj J_W AddCommGrpCat.{u} hT_W₀
  let adj_P₀ := CategoryTheory.constantSheafAdj J_P AddCommGrpCat.{u} hT_P₀
  let τ_π₀ : B_π.obj T_P₀ ⟶ T_W₀ := hT_W₀.from (B_π.obj T_P₀)
  let u₀_A : Fℤ_P ⟶ pf_π.obj Fℤ_W :=
    (adj_P₀.homEquiv Aℤ (pf_π.obj Fℤ_W)).symm
      (adj_W₀.unit.app Aℤ ≫ Fℤ_W.obj.map (Opposite.op τ_π₀))
  let πℤ₀ : P_pull₀.obj Fℤ_P ⟶ Fℤ_W := (adj_π₀.homEquiv Fℤ_P Fℤ_W).symm u₀_A

  have hEx_ιℤ₀ : ∃ (ιℤ₀ : Fℤ_W ⟶ P_pull₀.obj Fℤ_P),
      ιℤ₀ ≫ πℤ₀ = 𝟙 Fℤ_W ∧ πℤ₀ ≫ ιℤ₀ = 𝟙 (P_pull₀.obj Fℤ_P) := by
    let s_inv : W₀ ⟶ CategoryTheory.Limits.pullback (𝟙 P₀) π :=
      CategoryTheory.Limits.pullback.lift π (𝟙 W₀)
        ((Category.comp_id π).trans (Category.id_comp π).symm)
    let τ_inv : T_W₀ ⟶ B_π.obj T_P₀ :=
      CategoryTheory.MorphismProperty.Over.homMk s_inv
        (CategoryTheory.Limits.pullback.lift_snd _ _ _) trivial
    have hτ_inv_π₀ : τ_inv ≫ τ_π₀ = 𝟙 T_W₀ := hT_W₀.hom_ext _ _
    have hτ_π₀_inv : τ_π₀ ≫ τ_inv = 𝟙 (B_π.obj T_P₀) := by
      apply CategoryTheory.MorphismProperty.Comma.Hom.ext _ (Subsingleton.elim _ _)
      let τ_left : CategoryTheory.Limits.pullback (𝟙 P₀) π ⟶ W₀ := τ_π₀.left
      have hτ_left : τ_left = CategoryTheory.Limits.pullback.snd (𝟙 P₀) π :=
        (Category.comp_id τ_left).symm.trans (CategoryTheory.MorphismProperty.Over.w τ_π₀)
      change τ_left ≫ s_inv = 𝟙 (CategoryTheory.Limits.pullback (𝟙 P₀) π)
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_fst, hτ_left,
          ← CategoryTheory.Limits.pullback.condition, Category.comp_id, Category.id_comp]
      · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_snd, Category.comp_id,
          Category.id_comp, hτ_left]

    let sec_W := (CategoryTheory.sheafSections J_W AddCommGrpCat.{u}).obj (Opposite.op T_W₀)
    let sec_P := (CategoryTheory.sheafSections J_P AddCommGrpCat.{u}).obj (Opposite.op T_P₀)
    let map_τ_inv : ∀ (G : CategoryTheory.Sheaf J_W AddCommGrpCat.{u}),
        sec_P.obj (pf_π.obj G) ⟶ sec_W.obj G :=
      fun G => G.obj.map τ_inv.op
    let map_τ_π₀ : ∀ (G : CategoryTheory.Sheaf J_W AddCommGrpCat.{u}),
        sec_W.obj G ⟶ sec_P.obj (pf_π.obj G) :=
      fun G => G.obj.map τ_π₀.op

    have hmap_inv_π₀ : ∀ (G : CategoryTheory.Sheaf J_W AddCommGrpCat.{u}),
        map_τ_inv G ≫ map_τ_π₀ G = 𝟙 (sec_P.obj (pf_π.obj G)) := by
      intro G
      change G.obj.map τ_inv.op ≫ G.obj.map τ_π₀.op = 𝟙 _
      rw [← G.obj.map_comp, ← op_comp, hτ_π₀_inv, op_id, G.obj.map_id]

    have hmap_π₀_inv : ∀ (G : CategoryTheory.Sheaf J_W AddCommGrpCat.{u}),
        map_τ_π₀ G ≫ map_τ_inv G = 𝟙 (sec_W.obj G) := by
      intro G
      change G.obj.map τ_π₀.op ≫ G.obj.map τ_inv.op = 𝟙 _
      rw [← G.obj.map_comp, ← op_comp, hτ_inv_π₀, op_id, G.obj.map_id]

    let Ψ : ∀ (G : CategoryTheory.Sheaf J_W AddCommGrpCat.{u}),
        (P_pull₀.obj Fℤ_P ⟶ G) → (Fℤ_W ⟶ G) :=
      fun G f =>
        (adj_W₀.homEquiv Aℤ G).symm
          ((adj_P₀.homEquiv Aℤ (pf_π.obj G) (adj_π₀.homEquiv Fℤ_P G f)) ≫ map_τ_inv G)
    let Ψ_inv : ∀ (G : CategoryTheory.Sheaf J_W AddCommGrpCat.{u}),
        (Fℤ_W ⟶ G) → (P_pull₀.obj Fℤ_P ⟶ G) :=
      fun G g =>
        (adj_π₀.homEquiv Fℤ_P G).symm
          ((adj_P₀.homEquiv Aℤ (pf_π.obj G)).symm
            ((adj_W₀.homEquiv Aℤ G g) ≫ map_τ_π₀ G))

    have hΨ_left_inv : ∀ (G : CategoryTheory.Sheaf J_W AddCommGrpCat.{u})
        (f : P_pull₀.obj Fℤ_P ⟶ G), Ψ_inv G (Ψ G f) = f := by
      intro G f
      dsimp only [Ψ, Ψ_inv]
      rw [Equiv.apply_symm_apply, Category.assoc, hmap_inv_π₀, Category.comp_id,
        Equiv.symm_apply_apply, Equiv.symm_apply_apply]

    have hΨ_right_inv : ∀ (G : CategoryTheory.Sheaf J_W AddCommGrpCat.{u})
        (g : Fℤ_W ⟶ G), Ψ G (Ψ_inv G g) = g := by
      intro G g
      dsimp only [Ψ, Ψ_inv]
      rw [Equiv.apply_symm_apply, Equiv.apply_symm_apply, Category.assoc, hmap_π₀_inv,
        Category.comp_id, Equiv.symm_apply_apply]

    have hΨ_nat : ∀ {G G' : CategoryTheory.Sheaf J_W AddCommGrpCat.{u}}
        (f : P_pull₀.obj Fℤ_P ⟶ G) (h : G ⟶ G'),
        Ψ G' (f ≫ h) = Ψ G f ≫ h := by
      intro G G' f h
      dsimp only [Ψ]
      have hnat : sec_P.map (pf_π.map h) ≫ map_τ_inv G' = map_τ_inv G ≫ sec_W.map h :=
        (h.hom.naturality τ_inv.op).symm
      have h1 : adj_P₀.homEquiv Aℤ (pf_π.obj G') (adj_π₀.homEquiv Fℤ_P G' (f ≫ h)) =
          adj_P₀.homEquiv Aℤ (pf_π.obj G) (adj_π₀.homEquiv Fℤ_P G f) ≫ sec_P.map (pf_π.map h) := by
        rw [Adjunction.homEquiv_naturality_right, Adjunction.homEquiv_naturality_right]
      rw [h1, Category.assoc, hnat, ← Category.assoc, ← Adjunction.homEquiv_naturality_right_symm]

    have hπℤ₀_eq : πℤ₀ = Ψ_inv Fℤ_W (𝟙 Fℤ_W) := by
      dsimp only [πℤ₀, u₀_A, Ψ_inv, map_τ_π₀]
      congr 3

    let ιℤ₀ : Fℤ_W ⟶ P_pull₀.obj Fℤ_P := Ψ (P_pull₀.obj Fℤ_P) (𝟙 (P_pull₀.obj Fℤ_P))
    have hιπ₀ : ιℤ₀ ≫ πℤ₀ = 𝟙 Fℤ_W := by
      dsimp only [ιℤ₀]
      rw [← hΨ_nat, Category.id_comp, hπℤ₀_eq, hΨ_right_inv]
    have hπι₀ : πℤ₀ ≫ ιℤ₀ = 𝟙 (P_pull₀.obj Fℤ_P) := by
      have h1 : Ψ (P_pull₀.obj Fℤ_P) (πℤ₀ ≫ ιℤ₀) = Ψ (P_pull₀.obj Fℤ_P) (𝟙 _) := by
        rw [hΨ_nat, hπℤ₀_eq, hΨ_right_inv, Category.id_comp]
      exact (hΨ_left_inv _ _).symm.trans ((congrArg (Ψ_inv _) h1).trans (hΨ_left_inv _ _))
    exact ⟨ιℤ₀, hιπ₀, hπι₀⟩

  obtain ⟨ιℤ₀, hιπ₀, hπι₀⟩ := hEx_ιℤ₀

  have hMate_align : ∀ (P_pull' : CategoryTheory.Functor
        (CategoryTheory.Sheaf J_P AddCommGrpCat.{u})
        (CategoryTheory.Sheaf J_W AddCommGrpCat.{u}))
      (adj_π' : P_pull' ⊣ pf_π)
      {M_P : CategoryTheory.Sheaf J_P AddCommGrpCat.{u}}
      {M_W : CategoryTheory.Sheaf J_W AddCommGrpCat.{u}}
      (α : M_P ⟶ pf_π.obj M_W),
      let η := CategoryTheory.Adjunction.leftAdjointUniq adj_π' adj_π₀
      (adj_π'.homEquiv M_P M_W).symm α =
        η.hom.app M_P ≫ (adj_π₀.homEquiv M_P M_W).symm α := by
    intro P_pull' adj_π' M_P M_W α η
    apply (adj_π'.homEquiv M_P M_W).injective
    rw [Equiv.apply_symm_apply, Adjunction.homEquiv_unit, pf_π.map_comp, ← Category.assoc,
      CategoryTheory.Adjunction.unit_leftAdjointUniq_hom_app,
      ← Adjunction.homEquiv_unit, Equiv.apply_symm_apply]

  have hu_A_indep : ∀ (T_W : W₀.Etale) (hT_W : CategoryTheory.Limits.IsTerminal T_W)
      (T_P : P₀.Etale) (hT_P : CategoryTheory.Limits.IsTerminal T_P),
      let adj_W := CategoryTheory.constantSheafAdj J_W AddCommGrpCat.{u} hT_W
      let adj_P := CategoryTheory.constantSheafAdj J_P AddCommGrpCat.{u} hT_P
      (adj_P.homEquiv Aℤ (pf_π.obj Fℤ_W)).symm
        (adj_W.unit.app Aℤ ≫ Fℤ_W.obj.map (Opposite.op (hT_W.from (B_π.obj T_P)))) = u₀_A := by
    let Pℤ_W := (CategoryTheory.Functor.const (W₀.Etale)ᵒᵖ).obj Aℤ
    let Pℤ_P := (CategoryTheory.Functor.const (P₀.Etale)ᵒᵖ).obj Aℤ
    let shf_W := CategoryTheory.sheafificationAdjunction J_W AddCommGrpCat.{u}
    let shf_P := CategoryTheory.sheafificationAdjunction J_P AddCommGrpCat.{u}
    let η_shf_W : Pℤ_W ⟶ Fℤ_W.obj := shf_W.unit.app Pℤ_W
    let η_shf_P : Pℤ_P ⟶ Fℤ_P.obj := shf_P.unit.app Pℤ_P
    let η_pre : Pℤ_P ⟶ (CategoryTheory.sheafToPresheaf J_P AddCommGrpCat.{u}).obj (pf_π.obj Fℤ_W) :=
      CategoryTheory.Functor.whiskerLeft B_π.op η_shf_W
    let u_canon : Fℤ_P ⟶ pf_π.obj Fℤ_W :=
      (shf_P.homEquiv Pℤ_P (pf_π.obj Fℤ_W)).symm η_pre
    have h_unit_const : ∀ {C : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C]
        (J : CategoryTheory.GrothendieckTopology C)
        [CategoryTheory.HasWeakSheafify J AddCommGrpCat.{u}]
        {T : C} (hT : CategoryTheory.Limits.IsTerminal T),
        (CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT).unit.app Aℤ =
          ((CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}).unit.app
            ((CategoryTheory.Functor.const Cᵒᵖ).obj Aℤ)).app (Opposite.op T) := by
      intro C _ J _ T hT
      dsimp only [CategoryTheory.constantSheafAdj]
      rw [CategoryTheory.Adjunction.comp_unit_app, CategoryTheory.constantPresheafAdj_unit_app,
        Category.id_comp]
      rfl
    have h_any : ∀ (T_W : W₀.Etale) (hT_W : CategoryTheory.Limits.IsTerminal T_W)
        (T_P : P₀.Etale) (hT_P : CategoryTheory.Limits.IsTerminal T_P),
        let adj_W := CategoryTheory.constantSheafAdj J_W AddCommGrpCat.{u} hT_W
        let adj_P := CategoryTheory.constantSheafAdj J_P AddCommGrpCat.{u} hT_P
        (adj_P.homEquiv Aℤ (pf_π.obj Fℤ_W)).symm
          (adj_W.unit.app Aℤ ≫ Fℤ_W.obj.map (Opposite.op (hT_W.from (B_π.obj T_P)))) =
          u_canon := by
      intro T_W hT_W T_P hT_P adj_W adj_P
      apply (adj_P.homEquiv Aℤ (pf_π.obj Fℤ_W)).injective
      rw [Equiv.apply_symm_apply, Adjunction.homEquiv_unit, h_unit_const J_W hT_W,
        h_unit_const J_P hT_P]
      have h_nat_W : η_shf_W.app (Opposite.op T_W) ≫
            Fℤ_W.obj.map (Opposite.op (hT_W.from (B_π.obj T_P))) =
          η_shf_W.app (Opposite.op (B_π.obj T_P)) := by
        have hn := (η_shf_W.naturality (Opposite.op (hT_W.from (B_π.obj T_P)))).symm
        exact hn.trans (Category.id_comp (η_shf_W.app (Opposite.op (B_π.obj T_P))))
      have h_shf : η_shf_P ≫ (CategoryTheory.sheafToPresheaf J_P AddCommGrpCat.{u}).map u_canon =
          η_pre :=
        (Adjunction.homEquiv_unit shf_P Pℤ_P (pf_π.obj Fℤ_W) u_canon).symm.trans
          ((shf_P.homEquiv Pℤ_P (pf_π.obj Fℤ_W)).apply_symm_apply η_pre)
      exact h_nat_W.trans (congrArg (fun γ => γ.app (Opposite.op T_P)) h_shf).symm
    intro T_W hT_W T_P hT_P
    exact (h_any T_W hT_W T_P hT_P).trans (h_any T_W₀ hT_W₀ T_P₀ hT_P₀).symm

  
  
  
  let Edge : ∀ (M : CategoryTheory.Sheaf J_W AddCommGrpCat.{u}) (q : ℕ),
      (pf_π.obj M).H q →+ M.H q :=
    fun M q =>
      ((CategoryTheory.Abelian.Ext.mk₀ (adj_π₀.counit.app M)).postcomp Fℤ_W (Nat.add_zero q)).comp
        (((CategoryTheory.Abelian.Ext.mk₀ ιℤ₀).precomp
            (P_pull₀.obj (pf_π.obj M)) (Nat.zero_add q)).comp
          (P_pull₀.mapExtAddHom Fℤ_P (pf_π.obj M) q))

  have hEdge_apply : ∀ (M : CategoryTheory.Sheaf J_W AddCommGrpCat.{u}) (q : ℕ)
      (β : (pf_π.obj M).H q),
      Edge M q β =
        (((CategoryTheory.Abelian.Ext.mk₀ ιℤ₀).comp
            (CategoryTheory.Abelian.Ext.mapExactFunctor P_pull₀ β) (Nat.zero_add q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (adj_π₀.counit.app M)) (Nat.add_zero q)) := by
    intro M q β
    dsimp only [Edge, AddMonoidHom.comp_apply, CategoryTheory.Abelian.Ext.postcomp,
      CategoryTheory.Abelian.Ext.precomp]
    rw [CategoryTheory.Functor.mapExtAddHom_apply]
    rfl

  have hEdge_nat : ∀ {M₁ M₂ : CategoryTheory.Sheaf J_W AddCommGrpCat.{u}} (φ : M₁ ⟶ M₂)
      (q : ℕ) (β : (pf_π.obj M₁).H q),
      Edge M₂ q (β.comp (CategoryTheory.Abelian.Ext.mk₀ (pf_π.map φ)) (Nat.add_zero q)) =
        (Edge M₁ q β).comp (CategoryTheory.Abelian.Ext.mk₀ φ) (Nat.add_zero q) := by
    intro M₁ M₂ φ q β
    have h_counit_nat : P_pull₀.map (pf_π.map φ) ≫ adj_π₀.counit.app M₂ =
        adj_π₀.counit.app M₁ ≫ φ := adj_π₀.counit.naturality φ
    rw [hEdge_apply, hEdge_apply, CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
      CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
      CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
      CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, h_counit_nat,
      ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
    symm
    rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
      CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero]

  have hEdge_extClass : ∀ (S_W : CategoryTheory.ShortComplex
        (CategoryTheory.Sheaf J_W AddCommGrpCat.{u}))
      (hSE_W : S_W.ShortExact) (hSE_P : (S_W.map pf_π).ShortExact)
      (q : ℕ) (γ : (pf_π.obj S_W.X₃).H q),
      Edge S_W.X₁ (q + 1) (γ.comp hSE_P.extClass rfl) =
        (Edge S_W.X₃ q γ).comp hSE_W.extClass rfl := by
    intro S_W hSE_W hSE_P q γ
    let S_P := S_W.map pf_π
    let S_L := S_P.map P_pull₀
    have hSE_L : S_L.ShortExact := hSE_P.map_of_exact P_pull₀
    let τ_ε : S_L ⟶ S_W :=
      { τ₁ := adj_π₀.counit.app S_W.X₁
        τ₂ := adj_π₀.counit.app S_W.X₂
        τ₃ := adj_π₀.counit.app S_W.X₃
        comm₁₂ := (adj_π₀.counit.naturality S_W.f).symm
        comm₂₃ := (adj_π₀.counit.naturality S_W.g).symm }
    have h_nat_ext : hSE_L.extClass.comp
          (CategoryTheory.Abelian.Ext.mk₀ (adj_π₀.counit.app S_W.X₁)) (Nat.add_zero 1) =
        (CategoryTheory.Abelian.Ext.mk₀ (adj_π₀.counit.app S_W.X₃)).comp
          hSE_W.extClass (Nat.zero_add 1) :=
      CategoryTheory.ShortComplex.ShortExact.extClass_naturality hSE_L hSE_W τ_ε
    have h_map_ext : CategoryTheory.Abelian.Ext.mapExactFunctor P_pull₀ hSE_P.extClass =
        hSE_L.extClass :=
      CategoryTheory.Abelian.Ext.mapExactFunctor_extClass P_pull₀ hSE_P
    let u_γ := CategoryTheory.Abelian.Ext.mapExactFunctor P_pull₀ γ
    have h_ass₁ : (CategoryTheory.Abelian.Ext.mk₀ ιℤ₀).comp
          (u_γ.comp hSE_L.extClass rfl) (Nat.zero_add (q + 1)) =
        ((CategoryTheory.Abelian.Ext.mk₀ ιℤ₀).comp u_γ (Nat.zero_add q)).comp
          hSE_L.extClass rfl :=
      (CategoryTheory.Abelian.Ext.comp_assoc
        (CategoryTheory.Abelian.Ext.mk₀ ιℤ₀) u_γ hSE_L.extClass
        (Nat.zero_add q) rfl (Nat.zero_add (q + 1))).symm
    calc
      Edge S_W.X₁ (q + 1) (γ.comp hSE_P.extClass rfl)
          = ((CategoryTheory.Abelian.Ext.mk₀ ιℤ₀).comp
              (u_γ.comp hSE_L.extClass rfl) (Nat.zero_add (q + 1))).comp
              (CategoryTheory.Abelian.Ext.mk₀ (adj_π₀.counit.app S_W.X₁))
              (Nat.add_zero (q + 1)) := by
            rw [hEdge_apply, CategoryTheory.Abelian.Ext.mapExactFunctor_comp, h_map_ext]
      _ = (((CategoryTheory.Abelian.Ext.mk₀ ιℤ₀).comp u_γ (Nat.zero_add q)).comp
            hSE_L.extClass rfl).comp
            (CategoryTheory.Abelian.Ext.mk₀ (adj_π₀.counit.app S_W.X₁))
            (Nat.add_zero (q + 1)) := by
            rw [h_ass₁]
      _ = ((CategoryTheory.Abelian.Ext.mk₀ ιℤ₀).comp u_γ (Nat.zero_add q)).comp
            (hSE_L.extClass.comp
              (CategoryTheory.Abelian.Ext.mk₀ (adj_π₀.counit.app S_W.X₁)) (Nat.add_zero 1))
            rfl := by
            rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero]
      _ = ((CategoryTheory.Abelian.Ext.mk₀ ιℤ₀).comp u_γ (Nat.zero_add q)).comp
            ((CategoryTheory.Abelian.Ext.mk₀ (adj_π₀.counit.app S_W.X₃)).comp
              hSE_W.extClass (Nat.zero_add 1)) rfl := by
            rw [h_nat_ext]
      _ = (Edge S_W.X₃ q γ).comp hSE_W.extClass rfl := by
            rw [← CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero, hEdge_apply]

  let 𝒜 : CategoryTheory.Sheaf J_W AddCommGrpCat.{u} → Prop :=
    fun ℱ => ∀ s : ℕ, 1 ≤ s → CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage π s ℱ)

  have h𝒜_inj : ∀ (I : CategoryTheory.Sheaf J_W AddCommGrpCat.{u}),
      CategoryTheory.Injective I → 𝒜 I := by
    intro I hI s hs
    cases s with
    | zero => omega
    | succ s₀ =>
      let _ := hI
      dsimp only [weilEtaleHigherDirectImage]
      apply (CategoryTheory.presheafToSheaf J_P AddCommGrpCat.{u}).map_isZero
      rw [CategoryTheory.Functor.isZero_iff]
      intro U_op
      rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
      apply AddCommGrpCat.ext
      intro z
      exact CategoryTheory.Abelian.Ext.eq_zero_of_injective z

  have h𝒜_step : ∀ (W I Q : CategoryTheory.Sheaf J_W AddCommGrpCat.{u})
      [CategoryTheory.Injective I] (j : W ⟶ I) (p : I ⟶ Q) (hjp : j ≫ p = 0),
      𝒜 W → (CategoryTheory.ShortComplex.mk j p hjp).ShortExact →
      ((CategoryTheory.ShortComplex.mk j p hjp).map pf_π).ShortExact ∧ 𝒜 Q := by
    intro W I Q _ j p hjp hW hSE
    have : (weilAltCdSitePullback π).IsContinuous J_P J_W := hCont
    obtain ⟨hShift, ℬ, π_B, ι_B, δ_B, h₁, h₂, hfac, hSE₁, hSE₂⟩ :=
      weil_alt_cd_higherDirectImage_injective_step π W I Q j p hjp hSE
    have hQ : 𝒜 Q := by
      intro r hr
      obtain ⟨e_r⟩ := hShift r hr
      exact CategoryTheory.Limits.IsZero.of_iso (hW (r + 1) (by omega)) e_r
    have hW1 : CategoryTheory.Limits.IsZero (weilAltCdHigherDirectImage π 1 W) := hW 1 le_rfl
    have : CategoryTheory.IsIso ι_B := (hSE₂.isIso_f_iff).mpr hW1
    let e_SC : CategoryTheory.ShortComplex.mk (pf_π.map j) π_B h₁ ≅
        (CategoryTheory.ShortComplex.mk j p hjp).map pf_π :=
      CategoryTheory.ShortComplex.isoMk (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
        (CategoryTheory.asIso ι_B) (by simp) (by simpa using hfac.symm)
    exact ⟨CategoryTheory.ShortComplex.shortExact_of_iso e_SC hSE₁, hQ⟩

  have hEdge_bij : ∀ (q : ℕ) (M : CategoryTheory.Sheaf J_W AddCommGrpCat.{u}),
      𝒜 M → Function.Bijective (Edge M q) := by
    intro q
    induction q with
    | zero =>
      intro M _
      have hEdge0_mk₀ : ∀ (g : Fℤ_P ⟶ pf_π.obj M),
          Edge M 0 (CategoryTheory.Abelian.Ext.mk₀ g) =
            CategoryTheory.Abelian.Ext.mk₀
              (ιℤ₀ ≫ (adj_π₀.homEquiv Fℤ_P M).symm g) := by
        intro g
        rw [hEdge_apply, CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
          Category.assoc, Adjunction.homEquiv_counit]
      have haddEquiv_mk₀ : ∀ {X Y : CategoryTheory.Sheaf J_W AddCommGrpCat.{u}} (f : X ⟶ Y),
          CategoryTheory.Abelian.Ext.addEquiv₀ (CategoryTheory.Abelian.Ext.mk₀ f) = f := by
        intro X Y f
        rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply]
        exact CategoryTheory.Abelian.Ext.addEquiv₀.apply_symm_apply f
      let inv₀ : M.H 0 → (pf_π.obj M).H 0 := fun γ =>
        CategoryTheory.Abelian.Ext.mk₀
          (adj_π₀.homEquiv Fℤ_P M (πℤ₀ ≫ CategoryTheory.Abelian.Ext.addEquiv₀ γ))
      refine Function.bijective_iff_has_inverse.mpr ⟨inv₀, ?_, ?_⟩
      · intro β
        conv_lhs => rw [← CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply β]
        dsimp only [inv₀]
        rw [hEdge0_mk₀, haddEquiv_mk₀, ← Category.assoc, hπι₀, Category.id_comp,
          Equiv.apply_symm_apply, CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply]
      · intro γ
        dsimp only [inv₀]
        rw [hEdge0_mk₀, Equiv.symm_apply_apply, ← Category.assoc, hιπ₀, Category.id_comp,
          CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply]
    | succ q ih =>
      intro M hM
      let I : CategoryTheory.Sheaf J_W AddCommGrpCat.{u} := CategoryTheory.Injective.under M
      let j : M ⟶ I := CategoryTheory.Injective.ι M
      let Q : CategoryTheory.Sheaf J_W AddCommGrpCat.{u} := CategoryTheory.Limits.cokernel j
      let p : I ⟶ Q := CategoryTheory.Limits.cokernel.π j
      have hjp : j ≫ p = 0 := CategoryTheory.Limits.cokernel.condition j
      let S_W := CategoryTheory.ShortComplex.mk j p hjp
      have hSE_W : S_W.ShortExact :=
        CategoryTheory.ShortComplex.ShortExact.mk'
          (CategoryTheory.ShortComplex.exact_of_g_is_cokernel S_W
            (CategoryTheory.Limits.cokernelIsCokernel j))
          inferInstance inferInstance
      obtain ⟨hSE_P, hQ⟩ := h𝒜_step M I Q j p hjp hM hSE_W
      have hBij_I : Function.Bijective (Edge I q) := ih I (h𝒜_inj I inferInstance)
      have hBij_Q : Function.Bijective (Edge Q q) := ih Q hQ
      have : CategoryTheory.Injective (S_W.map pf_π).X₂ := hInj₀ I inferInstance
      have : CategoryTheory.Injective S_W.X₂ := inferInstance
      refine ⟨?_, ?_⟩
      · rw [injective_iff_map_eq_zero]
        intro x hx0
        have hx_j : x.comp (CategoryTheory.Abelian.Ext.mk₀ (S_W.map pf_π).f)
            (Nat.add_zero (q + 1)) = 0 :=
          CategoryTheory.Abelian.Ext.eq_zero_of_injective _
        obtain ⟨γ_P, hγ_P⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ_P hSE_P x hx_j rfl
        have hγ_W0 : (Edge Q q γ_P).comp hSE_W.extClass rfl = 0 := by
          rw [← hEdge_extClass S_W hSE_W hSE_P q γ_P, hγ_P, hx0]
        obtain ⟨β_W, hβ_W⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ Fℤ_W hSE_W (Edge Q q γ_P) rfl hγ_W0
        obtain ⟨β_P, hβ_P⟩ := hBij_I.2 β_W
        have hEdge_eq : Edge Q q (β_P.comp (CategoryTheory.Abelian.Ext.mk₀ (pf_π.map p))
            (Nat.add_zero q)) = Edge Q q γ_P := by
          rw [hEdge_nat p q β_P, hβ_P, hβ_W]
        have hβ_eq_γ : β_P.comp (CategoryTheory.Abelian.Ext.mk₀ (pf_π.map p))
            (Nat.add_zero q) = γ_P := hBij_Q.1 hEdge_eq
        rw [← hγ_P, ← hβ_eq_γ]
        change (β_P.comp (CategoryTheory.Abelian.Ext.mk₀ (S_W.map pf_π).g)
            (Nat.add_zero q)).comp hSE_P.extClass rfl = 0
        rw [CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero,
          hSE_P.comp_extClass, CategoryTheory.Abelian.Ext.comp_zero]
      · intro y
        have hy_j : y.comp (CategoryTheory.Abelian.Ext.mk₀ S_W.f) (Nat.add_zero (q + 1)) = 0 :=
          CategoryTheory.Abelian.Ext.eq_zero_of_injective _
        obtain ⟨γ_W, hγ_W⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ_W hSE_W y hy_j rfl
        obtain ⟨γ_P, hγ_P⟩ := hBij_Q.2 γ_W
        refine ⟨γ_P.comp hSE_P.extClass rfl, ?_⟩
        rw [hEdge_extClass S_W hSE_W hSE_P q γ_P, hγ_P, hγ_W]

  
  
  
  refine ⟨α_π, ?_, ?_, ?_⟩
  · rw [hα_equiv]
    exact hξ₀_on
  · intro V w hdisj
    rw [hα_equiv]
    exact hξ₀_disj V w hdisj
  · intro q
    let α_tilde₀ : P_pull₀.obj L_P ⟶ L_W := (adj_π₀.homEquiv L_P L_W).symm α_π
    let Φ : weilGysinLocalTorsionH P₀ m U_P q →+ weilGysinLocalTorsionH W₀ m U_W q :=
      ((CategoryTheory.Abelian.Ext.mk₀ α_tilde₀).postcomp Fℤ_W (Nat.add_zero q)).comp
        (((CategoryTheory.Abelian.Ext.mk₀ ιℤ₀).precomp (P_pull₀.obj L_P) (Nat.zero_add q)).comp
          (P_pull₀.mapExtAddHom Fℤ_P L_P q))
    refine ⟨Φ, ?_, ?_⟩
    · intro z_P z_W
      constructor
      · rintro ⟨_, hCont', P_pull', adj_π', hAdd', hLim', hColim',
            T_W', hT_W', T_P', hT_P', ιℤ', σ_e', α_π',
            hιπ', _, hσ'_fst, hξ'_on, hξ'_disj, hz_W⟩
        cases Subsingleton.elim hCont' hCont
        have : P_pull'.Additive := hAdd'
        have : CategoryTheory.Limits.PreservesFiniteLimits P_pull' := hLim'
        have : CategoryTheory.Limits.PreservesFiniteColimits P_pull' := hColim'
        have hσ_eq : σ_e' = σ₀ := by
          apply CategoryTheory.MorphismProperty.Comma.Hom.ext _ (Subsingleton.elim _ _)
          let s_e' : U ⟶ CategoryTheory.Limits.pullback u_P π := ((Fgt_W.map σ_e').left)
          let s_0 : U ⟶ CategoryTheory.Limits.pullback u_P π := ((Fgt_W.map σ₀).left)
          change s_e' = s_0
          apply CategoryTheory.Limits.pullback.hom_ext
          · exact hσ'_fst.trans hσ_fst.symm
          · exact (CategoryTheory.MorphismProperty.Over.w σ_e').trans
              (CategoryTheory.MorphismProperty.Over.w σ₀).symm
        subst hσ_eq
        have hα_eq : α_π' = α_π := by
          apply equiv_P.injective
          change CategoryTheory.Sheaf.freeYonedaHomEquiv α_π' =
            CategoryTheory.Sheaf.freeYonedaHomEquiv α_π
          rw [hα_equiv]
          exact hξ₀_uniq _ hξ'_on hξ'_disj
        subst hα_eq
        let η : P_pull' ≅ P_pull₀ := CategoryTheory.Adjunction.leftAdjointUniq adj_π' adj_π₀
        have hu'_eq :
            ((CategoryTheory.constantSheafAdj J_P AddCommGrpCat.{u} hT_P').homEquiv
              Aℤ (pf_π.obj Fℤ_W)).symm
              ((CategoryTheory.constantSheafAdj J_W AddCommGrpCat.{u} hT_W').unit.app Aℤ ≫
                Fℤ_W.obj.map (Opposite.op (hT_W'.from (B_π.obj T_P')))) = u₀_A :=
          hu_A_indep T_W' hT_W' T_P' hT_P'
        have hπℤ'_eq :
            (adj_π'.homEquiv Fℤ_P Fℤ_W).symm
              (((CategoryTheory.constantSheafAdj J_P AddCommGrpCat.{u} hT_P').homEquiv
                Aℤ (pf_π.obj Fℤ_W)).symm
                ((CategoryTheory.constantSheafAdj J_W AddCommGrpCat.{u} hT_W').unit.app Aℤ ≫
                  Fℤ_W.obj.map (Opposite.op (hT_W'.from (B_π.obj T_P'))))) =
            η.hom.app Fℤ_P ≫ πℤ₀ := by
          rw [hu'_eq]
          exact hMate_align P_pull' adj_π' u₀_A
        have hι'_align : ιℤ' ≫ η.hom.app Fℤ_P = ιℤ₀ := by
          have h1 : ιℤ' ≫ (η.hom.app Fℤ_P ≫ πℤ₀) = 𝟙 Fℤ_W := by
            rw [← hπℤ'_eq]
            exact hιπ'
          calc
            ιℤ' ≫ η.hom.app Fℤ_P = (ιℤ' ≫ η.hom.app Fℤ_P) ≫ (πℤ₀ ≫ ιℤ₀) := by
              rw [hπι₀, Category.comp_id]
            _ = (ιℤ' ≫ (η.hom.app Fℤ_P ≫ πℤ₀)) ≫ ιℤ₀ := by simp only [Category.assoc]
            _ = ιℤ₀ := by rw [h1, Category.id_comp]
        have hα_align : η.inv.app L_P ≫ (adj_π'.homEquiv L_P L_W).symm α_π = α_tilde₀ := by
          rw [hMate_align P_pull' adj_π' α_π, Iso.inv_hom_id_app_assoc]
        have hExt_iso :=
          weil_abelian_ext_mapExactFunctor_natIso P_pull' P_pull₀ η q Fℤ_P L_P z_P
        symm
        rw [hz_W]
        change ((CategoryTheory.Abelian.Ext.mk₀ ιℤ').comp
            ((P_pull'.mapExtAddHom Fℤ_P L_P q) z_P) (Nat.zero_add q)).comp
            (CategoryTheory.Abelian.Ext.mk₀ ((adj_π'.homEquiv L_P L_W).symm α_π))
            (Nat.add_zero q) =
          ((CategoryTheory.Abelian.Ext.mk₀ ιℤ₀).comp
            ((P_pull₀.mapExtAddHom Fℤ_P L_P q) z_P) (Nat.zero_add q)).comp
            (CategoryTheory.Abelian.Ext.mk₀ α_tilde₀) (Nat.add_zero q)
        rw [hExt_iso,
          ← CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero,
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hι'_align,
          CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
          CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hα_align]
        symm
        rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero]
      · intro hz_eq
        refine ⟨hjπ.trans (Category.id_comp u_P).symm, hCont, P_pull₀, adj_π₀, hAdd₀, hLim₀,
          hColim₀, T_W₀, hT_W₀, T_P₀, hT_P₀, ιℤ₀, σ₀, α_π, hιπ₀, hπι₀, hσ_fst, ?_, ?_, ?_⟩
        · rw [hα_equiv]; exact hξ₀_on
        · intro V w hdisj; rw [hα_equiv]; exact hξ₀_disj V w hdisj
        · exact hz_eq.symm
    · intro hIso_α hHDI
      have : CategoryTheory.IsIso α_π := hIso_α
      have hΦ_eq_Edge : ∀ z_P : L_P.H q,
          Φ z_P = Edge L_W q (z_P.comp (CategoryTheory.Abelian.Ext.mk₀ α_π) (Nat.add_zero q)) := by
        intro z_P
        rw [hEdge_apply]
        change ((CategoryTheory.Abelian.Ext.mk₀ ιℤ₀).comp
            ((P_pull₀.mapExtAddHom Fℤ_P L_P q) z_P) (Nat.zero_add q)).comp
            (CategoryTheory.Abelian.Ext.mk₀ α_tilde₀) (Nat.add_zero q) = _
        dsimp only [α_tilde₀]
        rw [CategoryTheory.Functor.mapExtAddHom_apply,
          CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
          CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
          CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
          CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
          CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, Adjunction.homEquiv_counit]
      have hPost_bij : Function.Bijective
          (fun z_P : L_P.H q =>
            z_P.comp (CategoryTheory.Abelian.Ext.mk₀ α_π) (Nat.add_zero q)) := by
        refine Function.bijective_iff_has_inverse.mpr
          ⟨fun β => β.comp (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.inv α_π))
              (Nat.add_zero q), ?_, ?_⟩
        · intro z_P
          dsimp only
          rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
            CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.IsIso.hom_inv_id,
            CategoryTheory.Abelian.Ext.comp_mk₀_id]
        · intro β
          dsimp only
          rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
            CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.IsIso.inv_hom_id,
            CategoryTheory.Abelian.Ext.comp_mk₀_id]
      have hComp_eq : (Φ : L_P.H q → L_W.H q) =
          (Edge L_W q) ∘ (fun z_P =>
            z_P.comp (CategoryTheory.Abelian.Ext.mk₀ α_π) (Nat.add_zero q)) :=
        funext hΦ_eq_Edge
      rw [hComp_eq]
      exact (hEdge_bij q L_W hHDI).comp hPost_bij

theorem weil_gysin_clopen_functoriality_and_cartesian_counit : ((∀ (S : AlgebraicGeometry.Scheme.{u}) {V₁ V₂ : S.Etale} (v : Quiver.Hom V₁ V₂)
        (m q : ℕ) (z : weilGysinLocalTorsionH S m V₁ q),
        weilGysinLocalTorsionCounitH S m V₂ q (weilEtaleLocalTorsionMapH S m v q z) =
          weilGysinLocalTorsionCounitH S m V₁ q z) ∧
      (∀ (S : AlgebraicGeometry.Scheme.{u}) (U : S.Etale) (ℓ r q : ℕ)
        (z : weilGysinLocalTorsionH S (ℓ ^ (r + 1)) U q),
        weilEtaleTorsionTransition S ℓ r q
          (weilGysinLocalTorsionCounitH S (ℓ ^ (r + 1)) U q z) =
        weilGysinLocalTorsionCounitH S (ℓ ^ r) U q
          (weilEtaleLocalTorsionTransition S ℓ r U q z))) ∧
    (∀ (W₁ W₀ P₀ U : AlgebraicGeometry.Scheme.{u})
        (ν : Quiver.Hom W₁ W₀) (π : Quiver.Hom W₀ P₀)
        (j₁ : Quiver.Hom U W₁) (hj₁ : AlgebraicGeometry.Etale j₁)
        (j₀ : Quiver.Hom U W₀) (hj₀ : AlgebraicGeometry.Etale j₀)
        (u_P : Quiver.Hom U P₀) (hu_P : AlgebraicGeometry.Etale u_P),
      CategoryTheory.CategoryStruct.comp j₁ ν = j₀ →
      CategoryTheory.CategoryStruct.comp j₀ π = u_P →
      (∃ σ_π : Quiver.Hom (weilGysinEtaleObj j₀ hj₀)
          ((weilAltCdSitePullback π).obj (weilGysinEtaleObj u_P hu_P)),
        CategoryTheory.CategoryStruct.comp
          (((AlgebraicGeometry.Scheme.Etale.forget W₀).map σ_π).left)
          (CategoryTheory.Limits.pullback.fst u_P π) =
          CategoryTheory.CategoryStruct.id U ∧
        AlgebraicGeometry.IsOpenImmersion
          (((AlgebraicGeometry.Scheme.Etale.forget W₀).map σ_π).left) ∧
        AlgebraicGeometry.IsClosedImmersion
          (((AlgebraicGeometry.Scheme.Etale.forget W₀).map σ_π).left)) →
      (∃ σ_ν : Quiver.Hom (weilGysinEtaleObj j₁ hj₁)
          ((weilAltCdSitePullback ν).obj (weilGysinEtaleObj j₀ hj₀)),
        CategoryTheory.CategoryStruct.comp
          (((AlgebraicGeometry.Scheme.Etale.forget W₁).map σ_ν).left)
          (CategoryTheory.Limits.pullback.fst j₀ ν) =
          CategoryTheory.CategoryStruct.id U ∧
        AlgebraicGeometry.IsOpenImmersion
          (((AlgebraicGeometry.Scheme.Etale.forget W₁).map σ_ν).left) ∧
        AlgebraicGeometry.IsClosedImmersion
          (((AlgebraicGeometry.Scheme.Etale.forget W₁).map σ_ν).left)) →
      (∃ σ_νπ : Quiver.Hom (weilGysinEtaleObj j₁ hj₁)
          ((weilAltCdSitePullback (CategoryTheory.CategoryStruct.comp ν π)).obj
            (weilGysinEtaleObj u_P hu_P)),
        CategoryTheory.CategoryStruct.comp
          (((AlgebraicGeometry.Scheme.Etale.forget W₁).map σ_νπ).left)
          (CategoryTheory.Limits.pullback.fst u_P (CategoryTheory.CategoryStruct.comp ν π)) =
          CategoryTheory.CategoryStruct.id U ∧
        AlgebraicGeometry.IsOpenImmersion
          (((AlgebraicGeometry.Scheme.Etale.forget W₁).map σ_νπ).left) ∧
        AlgebraicGeometry.IsClosedImmersion
          (((AlgebraicGeometry.Scheme.Etale.forget W₁).map σ_νπ).left)) →
      ∀ (m q : ℕ)
        (z_P : weilGysinLocalTorsionH P₀ m (weilGysinEtaleObj u_P hu_P) q)
        (z₀ : weilGysinLocalTorsionH W₀ m (weilGysinEtaleObj j₀ hj₀) q)
        (z₁ : weilGysinLocalTorsionH W₁ m (weilGysinEtaleObj j₁ hj₁) q),
        WeilGysinIsClopenPullbackOnLocalH π
          (weilGysinEtaleObj j₀ hj₀) (weilGysinEtaleObj u_P hu_P)
          (CategoryTheory.Iso.refl U) m q z_P z₀ →
        WeilGysinIsClopenPullbackOnLocalH ν
          (weilGysinEtaleObj j₁ hj₁) (weilGysinEtaleObj j₀ hj₀)
          (CategoryTheory.Iso.refl U) m q z₀ z₁ →
        WeilGysinIsClopenPullbackOnLocalH (CategoryTheory.CategoryStruct.comp ν π)
          (weilGysinEtaleObj j₁ hj₁) (weilGysinEtaleObj u_P hu_P)
          (CategoryTheory.Iso.refl U) m q z_P z₁) ∧
    ((∀ (W₀ P₀ U' U : AlgebraicGeometry.Scheme.{u})
        (π : Quiver.Hom W₀ P₀) (ι : Quiver.Hom U' U)
        (j_W : Quiver.Hom U W₀) (hj_W : AlgebraicGeometry.Etale j_W)
        (j'_W : Quiver.Hom U' W₀) (hj'_W : AlgebraicGeometry.Etale j'_W)
        (hj' : CategoryTheory.CategoryStruct.comp ι j_W = j'_W)
        (u_P : Quiver.Hom U P₀) (hu_P : AlgebraicGeometry.Etale u_P)
        (u'_P : Quiver.Hom U' P₀) (hu'_P : AlgebraicGeometry.Etale u'_P)
        (hu' : CategoryTheory.CategoryStruct.comp ι u_P = u'_P),
        CategoryTheory.CategoryStruct.comp j_W π = u_P →
        (∃ σ_U : Quiver.Hom (weilGysinEtaleObj j_W hj_W)
            ((weilAltCdSitePullback π).obj (weilGysinEtaleObj u_P hu_P)),
          CategoryTheory.CategoryStruct.comp
            (((AlgebraicGeometry.Scheme.Etale.forget W₀).map σ_U).left)
            (CategoryTheory.Limits.pullback.fst u_P π) =
            CategoryTheory.CategoryStruct.id U ∧
          AlgebraicGeometry.IsOpenImmersion
            (((AlgebraicGeometry.Scheme.Etale.forget W₀).map σ_U).left) ∧
          AlgebraicGeometry.IsClosedImmersion
            (((AlgebraicGeometry.Scheme.Etale.forget W₀).map σ_U).left)) →
        (∃ σ_U' : Quiver.Hom (weilGysinEtaleObj j'_W hj'_W)
            ((weilAltCdSitePullback π).obj (weilGysinEtaleObj u'_P hu'_P)),
          CategoryTheory.CategoryStruct.comp
            (((AlgebraicGeometry.Scheme.Etale.forget W₀).map σ_U').left)
            (CategoryTheory.Limits.pullback.fst u'_P π) =
            CategoryTheory.CategoryStruct.id U' ∧
          AlgebraicGeometry.IsOpenImmersion
            (((AlgebraicGeometry.Scheme.Etale.forget W₀).map σ_U').left) ∧
          AlgebraicGeometry.IsClosedImmersion
            (((AlgebraicGeometry.Scheme.Etale.forget W₀).map σ_U').left)) →
        let v_W : Quiver.Hom (weilGysinEtaleObj j'_W hj'_W)
            (weilGysinEtaleObj j_W hj_W) :=
