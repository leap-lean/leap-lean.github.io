    let map_nt : ∀ (n : ℕ) {G₁ G₂ : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}} (φ : G₁ ⟶ G₂),
        G₁.cohomologyPresheaf n ⟶ G₂.cohomologyPresheaf n := fun n {G₁ G₂} φ =>
      { app := fun W => AddCommGrpCat.ofHom
          ((CategoryTheory.Abelian.Ext.mk₀ φ).postcomp (L_op.obj W).unop (Nat.add_zero n))
        naturality := fun {W₁ W₂} w => by
          have hw₁ : (G₁.cohomologyPresheaf n).map w =
              ((CategoryTheory.Abelian.extFunctor n).map (L_op.map w)).app G₁ := rfl
          have hw₂ : (G₂.cohomologyPresheaf n).map w =
              ((CategoryTheory.Abelian.extFunctor n).map (L_op.map w)).app G₂ := rfl
          rw [hw₁, hw₂, CategoryTheory.Abelian.extFunctor_map_app,
            CategoryTheory.Abelian.extFunctor_map_app]
          exact hNat_post (CategoryTheory.Abelian.Ext.mk₀ φ) (Nat.add_zero n) (L_op.map w).unop }
    let δ_nt : ∀ n : ℕ, SC.X₃.cohomologyPresheaf n ⟶ SC.X₁.cohomologyPresheaf (n + 1) := fun n =>
      { app := fun W => AddCommGrpCat.ofHom (hSC.extClass.postcomp (L_op.obj W).unop (rfl : n + 1 = n + 1))
        naturality := fun {W₁ W₂} w => by
          have hw₁ : (SC.X₃.cohomologyPresheaf n).map w =
              ((CategoryTheory.Abelian.extFunctor n).map (L_op.map w)).app SC.X₃ := rfl
          have hw₂ : (SC.X₁.cohomologyPresheaf (n + 1)).map w =
              ((CategoryTheory.Abelian.extFunctor (n + 1)).map (L_op.map w)).app SC.X₁ := rfl
          rw [hw₁, hw₂, CategoryTheory.Abelian.extFunctor_map_app,
            CategoryTheory.Abelian.extFunctor_map_app]
          exact hNat_post hSC.extClass (rfl : n + 1 = n + 1) (L_op.map w).unop }
    have hZero_mid : ∀ (n : ℕ) (Z : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}),
        AddCommGrpCat.ofHom ((CategoryTheory.Abelian.Ext.mk₀ SC.f).postcomp Z (Nat.add_zero n)) ≫
          AddCommGrpCat.ofHom ((CategoryTheory.Abelian.Ext.mk₀ SC.g).postcomp Z (Nat.add_zero n)) = 0 := by
      intro n Z
      ext α
      change (α.comp (CategoryTheory.Abelian.Ext.mk₀ SC.f) (Nat.add_zero n)).comp
          (CategoryTheory.Abelian.Ext.mk₀ SC.g) (Nat.add_zero n) = 0
      rw [CategoryTheory.Abelian.Ext.comp_assoc α _ _ (Nat.add_zero n) (Nat.add_zero 0) (Nat.add_zero n),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, SC.zero,
        CategoryTheory.Abelian.Ext.mk₀_zero, CategoryTheory.Abelian.Ext.comp_zero]
    have hZero_L : ∀ (q : ℕ) (Z : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}),
        AddCommGrpCat.ofHom (hSC.extClass.postcomp Z (rfl : q + 1 = q + 1)) ≫
          AddCommGrpCat.ofHom ((CategoryTheory.Abelian.Ext.mk₀ SC.f).postcomp Z (Nat.add_zero (q + 1))) = 0 := by
      intro q Z
      ext α
      change (α.comp hSC.extClass (rfl : q + 1 = q + 1)).comp
          (CategoryTheory.Abelian.Ext.mk₀ SC.f) (Nat.add_zero (q + 1)) = 0
      rw [CategoryTheory.Abelian.Ext.comp_assoc α hSC.extClass _
          (rfl : q + 1 = q + 1) (Nat.add_zero 1) (rfl : q + 1 = q + 1),
        hSC.extClass_comp, CategoryTheory.Abelian.Ext.comp_zero]
    have hZero_R : ∀ (q : ℕ) (Z : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}),
        AddCommGrpCat.ofHom ((CategoryTheory.Abelian.Ext.mk₀ SC.g).postcomp Z (Nat.add_zero (q + 1))) ≫
          AddCommGrpCat.ofHom (hSC.extClass.postcomp Z (rfl : (q + 1) + 1 = q + 2)) = 0 := by
      intro q Z
      ext α
      change (α.comp (CategoryTheory.Abelian.Ext.mk₀ SC.g) (Nat.add_zero (q + 1))).comp
          hSC.extClass (rfl : (q + 1) + 1 = q + 2) = 0
      rw [CategoryTheory.Abelian.Ext.comp_assoc α _ hSC.extClass
          (Nat.add_zero (q + 1)) (Nat.zero_add 1) (rfl : (q + 1) + 1 = q + 2),
        hSC.comp_extClass, CategoryTheory.Abelian.Ext.comp_zero]
    have hMid_comp : ∀ n : ℕ, map_nt n SC.f ≫ map_nt n SC.g = 0 := fun n =>
      CategoryTheory.NatTrans.ext (funext fun W => hZero_mid n (L_op.obj W).unop)
    let PC_mid := fun n : ℕ =>
      CategoryTheory.ShortComplex.mk (map_nt n SC.f) (map_nt n SC.g) (hMid_comp n)
    have hMid_ex : ∀ n : ℕ, (((PC_mid n).map W_B).map Sh_S).Exact := by
      intro n
      apply hExact_of_pt
      intro W
      rw [CategoryTheory.ShortComplex.ab_exact_iff_function_exact]
      refine Function.Exact.of_comp_of_mem_range
        (funext fun x => CategoryTheory.ConcreteCategory.congr_hom (CategoryTheory.NatTrans.congr_app (hMid_comp n) W) x)
        (fun x₂ hx₂ => CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ (L_op.obj W).unop hSC x₂ hx₂)
    refine ⟨?_, ?_⟩
    · intro q hZ₁ hZ₃
      exact (hMid_ex q).isZero_X₂ (hZ₁.eq_of_src _ _) (hZ₃.eq_of_tgt _ _)
    · intro q hZ₃ hZ₁
      have hcomp_L : δ_nt q ≫ map_nt (q + 1) SC.f = 0 :=
        CategoryTheory.NatTrans.ext (funext fun W => hZero_L q (L_op.obj W).unop)
      have hcomp_R : map_nt (q + 1) SC.g ≫ δ_nt (q + 1) = 0 :=
        CategoryTheory.NatTrans.ext (funext fun W => hZero_R q (L_op.obj W).unop)
      let PC_L := CategoryTheory.ShortComplex.mk (δ_nt q) (map_nt (q + 1) SC.f) hcomp_L
      let PC_R := CategoryTheory.ShortComplex.mk (map_nt (q + 1) SC.g) (δ_nt (q + 1)) hcomp_R
      have hEx_L_sh : ((PC_L.map W_B).map Sh_S).Exact := by
        apply hExact_of_pt
        intro W
        rw [CategoryTheory.ShortComplex.ab_exact_iff_function_exact]
        refine Function.Exact.of_comp_of_mem_range
          (funext fun x => CategoryTheory.ConcreteCategory.congr_hom (CategoryTheory.NatTrans.congr_app hcomp_L W) x)
          (fun x₁ hx₁ => CategoryTheory.Abelian.Ext.covariant_sequence_exact₁
            (L_op.obj W).unop hSC x₁ hx₁ (rfl : q + 1 = q + 1))
      have hEx_R_sh : ((PC_R.map W_B).map Sh_S).Exact := by
        apply hExact_of_pt
        intro W
        rw [CategoryTheory.ShortComplex.ab_exact_iff_function_exact]
        refine Function.Exact.of_comp_of_mem_range
          (funext fun x => CategoryTheory.ConcreteCategory.congr_hom (CategoryTheory.NatTrans.congr_app hcomp_R W) x)
          (fun x₃ hx₃ => CategoryTheory.Abelian.Ext.covariant_sequence_exact₃
            (L_op.obj W).unop hSC x₃ (rfl : (q + 1) + 1 = q + 2) hx₃)
      let SC_sh := ((PC_mid (q + 1)).map W_B).map Sh_S
      have hEx_mid_sh : SC_sh.Exact := hMid_ex (q + 1)
      have hMono_u : CategoryTheory.Mono SC_sh.f :=
        hEx_L_sh.mono_g (hZ₃.eq_of_src _ _)
      have hEpi_v : CategoryTheory.Epi SC_sh.g :=
        hEx_R_sh.epi_f (hZ₁.eq_of_tgt _ _)
      exact ⟨SC_sh.f, SC_sh.g, SC_sh.zero, { exact := hEx_mid_sh, mono_f := hMono_u, epi_g := hEpi_v }⟩

  
  let adj_P_c := CategoryTheory.constantSheafAdj P.smallEtaleTopology AddCommGrpCat.{u} hT_P
