theorem weil_gysin_etale_origin_point_class_local_bridge (k : Type u) [Field k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (c r : ℕ)
    (Y Γ P : AlgebraicGeometry.Scheme.{u})
    (p_Y : Quiver.Hom Y (AlgebraicGeometry.Spec (CommRingCat.of k)))
