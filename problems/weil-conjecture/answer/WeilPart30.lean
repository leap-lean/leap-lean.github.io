          CategoryTheory.Limits.pullback.fst Z.hom f =
        CategoryTheory.Limits.pullback.fst ((weilEtaleSitePullback s₀).obj Z).hom g₀ ≫
          CategoryTheory.Limits.pullback.fst Z.hom s₀ := by
