      rw [CategoryTheory.Sheaf.Hom.add_app]
      rfl
    rw [zero_add] at h_add
    calc (((0 : G₁ ⟶ G₂).hom.app Z).hom z)
        = (((0 : G₁ ⟶ G₂).hom.app Z).hom z + ((0 : G₁ ⟶ G₂).hom.app Z).hom z) -
            ((0 : G₁ ⟶ G₂).hom.app Z).hom z := (add_sub_cancel_right _ _).symm
      _ = ((0 : G₁ ⟶ G₂).hom.app Z).hom z - ((0 : G₁ ⟶ G₂).hom.app Z).hom z := by
          rw [← h_add]
