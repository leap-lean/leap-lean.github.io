            · rw [CategoryTheory.Category.assoc, ← hp₂_box_ι, ← CategoryTheory.Category.assoc, hm₂,
                CategoryTheory.Limits.pullback.lift_snd]))
    let f₁_spec := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A₁))
    let f₂_spec := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A₂))
    have hpb_spec : CategoryTheory.IsPullback
        (p₁_box ≫ U₁.toSpecΓ) (p₂_box ≫ U₂.toSpecΓ) f₁_spec f₂_spec := by
      refine CategoryTheory.IsPullback.of_iso hpb_box
        (CategoryTheory.Iso.refl _) hU₁.isoSpec hU₂.isoSpec (CategoryTheory.Iso.refl _)
