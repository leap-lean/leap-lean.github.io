    obtain ⟨e_R0⟩ := hCalc_R0 (weilEtaleTorsionSheaf P (ℓ ^ 1))
    obtain ⟨hc_s0, hr_s0, ⟨e_pbc0⟩⟩ := hPBC_sec s hs 0
    obtain rfl : hc_s0 = hc_all s := Subsingleton.elim _ _
