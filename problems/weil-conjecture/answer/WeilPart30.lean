        DFinsupp.single (β := fun ψ : (T ⟶ U_h) => ↥(P.obj (Opposite.op (asOver T ψ))))
          φ₁ ((P.map (Opposite.op u₁)).hom x) =
        DFinsupp.single (β := fun ψ : (T ⟶ U_h) => ↥(P.obj (Opposite.op (asOver T ψ))))
          φ₂ ((P.map (Opposite.op u₂)).hom x) := by
      intro P T φ₁ φ₂ hφ W u₁ u₂ hu x
      subst hφ
      have hu_eq : u₁ = u₂ := CategoryTheory.MorphismProperty.Over.Hom.ext hu
      rw [hu_eq]
    let preMapHom (P : CategoryTheory.Functor (Opposite W₀.Etale) AddCommGrpCat.{u})
        {T' T : S.Etale} (g : T' ⟶ T) :
        (Π₀ φ : (T ⟶ U_h), ↥(P.obj (Opposite.op (asOver T φ)))) →+
          (Π₀ ψ : (T' ⟶ U_h), ↥(P.obj (Opposite.op (asOver T' ψ)))) :=
      DFinsupp.liftAddHom fun φ : (T ⟶ U_h) =>
        (DFinsupp.singleAddHom
          (fun ψ : (T' ⟶ U_h) => ↥(P.obj (Opposite.op (asOver T' ψ))))
          (g ≫ φ)).comp (P.map (Opposite.op (liftMap g φ))).hom
    have hPreMapSingle : ∀ (P : CategoryTheory.Functor (Opposite W₀.Etale) AddCommGrpCat.{u})
        {T' T : S.Etale} (g : T' ⟶ T) (φ : T ⟶ U_h)
        (x : ↥(P.obj (Opposite.op (asOver T φ)))),
        preMapHom P g (DFinsupp.single φ x) =
          DFinsupp.single (β := fun ψ : (T' ⟶ U_h) => ↥(P.obj (Opposite.op (asOver T' ψ))))
            (g ≫ φ) ((P.map (Opposite.op (liftMap g φ))).hom x) := by
      intro P _ _ g φ x
      simp only [preMapHom, DFinsupp.liftAddHom_apply_single]
      rfl
    let mapRangeHom {P₁ P₂ : CategoryTheory.Functor (Opposite W₀.Etale) AddCommGrpCat.{u}}
        (θ : P₁ ⟶ P₂) (T : S.Etale) :
        (Π₀ φ : (T ⟶ U_h), ↥(P₁.obj (Opposite.op (asOver T φ)))) →+
          (Π₀ φ : (T ⟶ U_h), ↥(P₂.obj (Opposite.op (asOver T φ)))) :=
      DFinsupp.mapRange.addMonoidHom fun φ : (T ⟶ U_h) =>
        (θ.app (Opposite.op (asOver T φ))).hom
    have hMapRangeSingle : ∀ {P₁ P₂ : CategoryTheory.Functor (Opposite W₀.Etale) AddCommGrpCat.{u}}
        (θ : P₁ ⟶ P₂) (T : S.Etale) (φ : T ⟶ U_h)
        (x : ↥(P₁.obj (Opposite.op (asOver T φ)))),
        mapRangeHom θ T (DFinsupp.single φ x) =
          DFinsupp.single (β := fun ψ : (T ⟶ U_h) => ↥(P₂.obj (Opposite.op (asOver T ψ))))
            φ ((θ.app (Opposite.op (asOver T φ))).hom x) :=
      fun θ T φ x => DFinsupp.mapRange_single (hf := fun i => (θ.app (Opposite.op (asOver T i))).hom.map_zero)
    let h_sh_pre : CategoryTheory.Functor
        (CategoryTheory.Functor (Opposite W₀.Etale) AddCommGrpCat.{u})
        (CategoryTheory.Functor (Opposite S.Etale) AddCommGrpCat.{u}) :=
      { obj := fun P =>
          { obj := fun T => AddCommGrpCat.of
              (Π₀ φ : (T.unop ⟶ U_h), ↥(P.obj (Opposite.op (asOver T.unop φ))))
            map := fun {T₁ T₂} g => AddCommGrpCat.ofHom (preMapHom P g.unop)
            map_id := fun T => by
              apply AddCommGrpCat.hom_ext
              refine DFinsupp.addHom_ext' fun φ => AddMonoidHom.ext fun x => ?_
              change preMapHom P (CategoryTheory.CategoryStruct.id T.unop) (DFinsupp.single φ x) =
                DFinsupp.single φ x
              refine (hPreMapSingle P (CategoryTheory.CategoryStruct.id T.unop) φ x).trans ?_
              refine (hSingleEq P (CategoryTheory.Category.id_comp φ)
                (liftMap (CategoryTheory.CategoryStruct.id T.unop) φ)
                (CategoryTheory.CategoryStruct.id (asOver T.unop φ)) rfl x).trans ?_
              exact congrArg
                (DFinsupp.single (β := fun ψ : (T.unop ⟶ U_h) =>
                  ↥(P.obj (Opposite.op (asOver T.unop ψ)))) φ)
                (congrArg (fun θ => (AddCommGrpCat.Hom.hom θ) x)
                  (P.map_id (Opposite.op (asOver T.unop φ))))
            map_comp := fun {T₁ T₂ T₃} g₁ g₂ => by
              apply AddCommGrpCat.hom_ext
              refine DFinsupp.addHom_ext' fun φ => AddMonoidHom.ext fun x => ?_
              change preMapHom P (g₂.unop ≫ g₁.unop) (DFinsupp.single φ x) =
                preMapHom P g₂.unop (preMapHom P g₁.unop (DFinsupp.single φ x))
              have hLHS := hPreMapSingle P (g₂.unop ≫ g₁.unop) φ x
              have hRHS : preMapHom P g₂.unop (preMapHom P g₁.unop (DFinsupp.single φ x)) =
                  DFinsupp.single (β := fun ψ : (T₃.unop ⟶ U_h) =>
                    ↥(P.obj (Opposite.op (asOver T₃.unop ψ))))
                    (g₂.unop ≫ g₁.unop ≫ φ)
                    ((P.map (Opposite.op (liftMap g₂.unop (g₁.unop ≫ φ) ≫ liftMap g₁.unop φ))).hom x) :=
                (congrArg (preMapHom P g₂.unop) (hPreMapSingle P g₁.unop φ x)).trans
                  ((hPreMapSingle P g₂.unop (g₁.unop ≫ φ) _).trans
                    (congrArg
                      (DFinsupp.single (β := fun ψ : (T₃.unop ⟶ U_h) =>
                        ↥(P.obj (Opposite.op (asOver T₃.unop ψ)))) (g₂.unop ≫ g₁.unop ≫ φ))
                      (congrArg (fun θ => (AddCommGrpCat.Hom.hom θ) x)
                        (P.map_comp (Opposite.op (liftMap g₁.unop φ))
                          (Opposite.op (liftMap g₂.unop (g₁.unop ≫ φ)))).symm)))
              exact hLHS.trans
                ((hSingleEq P (CategoryTheory.Category.assoc g₂.unop g₁.unop φ)
                  (liftMap (g₂.unop ≫ g₁.unop) φ)
                  (liftMap g₂.unop (g₁.unop ≫ φ) ≫ liftMap g₁.unop φ) rfl x).trans hRHS.symm) }
        map := fun {P₁ P₂} θ =>
          { app := fun T => AddCommGrpCat.ofHom (mapRangeHom θ T.unop)
            naturality := fun {T₁ T₂} g => by
              apply AddCommGrpCat.hom_ext
              refine DFinsupp.addHom_ext' fun φ => AddMonoidHom.ext fun x => ?_
              change mapRangeHom θ T₂.unop (preMapHom P₁ g.unop (DFinsupp.single φ x)) =
                preMapHom P₂ g.unop (mapRangeHom θ T₁.unop (DFinsupp.single φ x))
              have hL := (congrArg (mapRangeHom θ T₂.unop)
                (hPreMapSingle P₁ g.unop φ x)).trans (hMapRangeSingle θ T₂.unop (g.unop ≫ φ) _)
              have hR := (congrArg (preMapHom P₂ g.unop)
                (hMapRangeSingle θ T₁.unop φ x)).trans (hPreMapSingle P₂ g.unop φ _)
              have hnat := congrArg (fun ψ => (AddCommGrpCat.Hom.hom ψ) x)
                (θ.naturality (Opposite.op (liftMap g.unop φ)))
              exact hL.trans
                ((congrArg
                  (DFinsupp.single (β := fun ψ : (T₂.unop ⟶ U_h) =>
                    ↥(P₂.obj (Opposite.op (asOver T₂.unop ψ)))) (g.unop ≫ φ)) hnat).trans hR.symm) }
        map_id := fun P => by
          ext T : 2
          apply AddCommGrpCat.hom_ext
          refine DFinsupp.addHom_ext' fun φ => AddMonoidHom.ext fun x => ?_
          simp [mapRangeHom]
        map_comp := fun {P₁ P₂ P₃} θ₁ θ₂ => by
          ext T : 2
          apply AddCommGrpCat.hom_ext
          refine DFinsupp.addHom_ext' fun φ => AddMonoidHom.ext fun x => ?_
          simp [mapRangeHom] }
    let R_pre : CategoryTheory.Functor
        (CategoryTheory.Functor (Opposite S.Etale) AddCommGrpCat.{u})
        (CategoryTheory.Functor (Opposite W₀.Etale) AddCommGrpCat.{u}) :=
      (CategoryTheory.Functor.whiskeringLeft (Opposite W₀.Etale) (Opposite S.Etale)
        AddCommGrpCat.{u}).obj M_h.op
    let adjBackHom {P : CategoryTheory.Functor (Opposite W₀.Etale) AddCommGrpCat.{u}}
        {Q : CategoryTheory.Functor (Opposite S.Etale) AddCommGrpCat.{u}}
        (β : P ⟶ R_pre.obj Q) (T : S.Etale) :
        (Π₀ φ : (T ⟶ U_h), ↥(P.obj (Opposite.op (asOver T φ)))) →+
          ↥(Q.obj (Opposite.op T)) :=
      DFinsupp.liftAddHom fun φ : (T ⟶ U_h) =>
        (Q.map (Opposite.op (ι_slice T φ))).hom.comp
          (β.app (Opposite.op (asOver T φ))).hom
    have hAdjBackSingle : ∀ {P : CategoryTheory.Functor (Opposite W₀.Etale) AddCommGrpCat.{u}}
        {Q : CategoryTheory.Functor (Opposite S.Etale) AddCommGrpCat.{u}}
        (β : P ⟶ R_pre.obj Q) (T : S.Etale) (φ : T ⟶ U_h)
        (x : ↥(P.obj (Opposite.op (asOver T φ)))),
        adjBackHom β T (DFinsupp.single φ x) =
          (Q.map (Opposite.op (ι_slice T φ))).hom ((β.app (Opposite.op (asOver T φ))).hom x) := by
      intro _ _ β T φ x
      simp only [adjBackHom, DFinsupp.liftAddHom_apply_single, AddMonoidHom.comp_apply]
    let adj_pre : h_sh_pre ⊣ R_pre :=
      CategoryTheory.Adjunction.mkOfHomEquiv
        { homEquiv := fun P Q =>
            { toFun := fun α =>
                { app := fun V => AddCommGrpCat.ofHom
                    ((α.app (Opposite.op (M_h.obj V.unop))).hom.comp
                      ((DFinsupp.singleAddHom
                        (fun ψ : (M_h.obj V.unop ⟶ U_h) =>
                          ↥(P.obj (Opposite.op (asOver (M_h.obj V.unop) ψ))))
                        (π_slice V.unop)).comp (P.map (Opposite.op (κ_slice V.unop))).hom))
                  naturality := fun {V₁ V₂} u => by
                    apply AddCommGrpCat.ext
                    intro x
                    change (α.app (Opposite.op (M_h.obj V₂.unop))).hom
                        (DFinsupp.single (π_slice V₂.unop)
                          ((P.map (Opposite.op (κ_slice V₂.unop))).hom ((P.map u).hom x))) =
                      (Q.map (Opposite.op (M_h.map u.unop))).hom
                        ((α.app (Opposite.op (M_h.obj V₁.unop))).hom
                          (DFinsupp.single (π_slice V₁.unop)
                            ((P.map (Opposite.op (κ_slice V₁.unop))).hom x)))
                    have hnat := congrArg
                      (fun ψ => (AddCommGrpCat.Hom.hom ψ)
                        (DFinsupp.single (π_slice V₁.unop)
                          ((P.map (Opposite.op (κ_slice V₁.unop))).hom x)))
                      (α.naturality (Opposite.op (M_h.map u.unop)))
                    refine Eq.trans ?_ hnat
                    apply congrArg (α.app (Opposite.op (M_h.obj V₂.unop))).hom
                    have hRHS := hPreMapSingle P (M_h.map u.unop) (π_slice V₁.unop)
                      ((P.map (Opposite.op (κ_slice V₁.unop))).hom x)
                    refine Eq.trans ?_ hRHS.symm
                    have hcomp_u : (P.map (Opposite.op (liftMap (M_h.map u.unop) (π_slice V₁.unop)))).hom
                        ((P.map (Opposite.op (κ_slice V₁.unop))).hom x) =
                        (P.map (Opposite.op (liftMap (M_h.map u.unop) (π_slice V₁.unop) ≫
                          κ_slice V₁.unop))).hom x :=
                      congrArg (fun θ => (AddCommGrpCat.Hom.hom θ) x)
                        (P.map_comp (Opposite.op (κ_slice V₁.unop))
                          (Opposite.op (liftMap (M_h.map u.unop) (π_slice V₁.unop)))).symm
                    have hcomp_u2 : (P.map (Opposite.op (κ_slice V₂.unop))).hom
                        ((P.map u).hom x) =
                        (P.map (Opposite.op (κ_slice V₂.unop ≫ u.unop))).hom x :=
                      congrArg (fun θ => (AddCommGrpCat.Hom.hom θ) x)
                        (P.map_comp (Opposite.op u.unop) (Opposite.op (κ_slice V₂.unop))).symm
                    have hπ_eq : M_h.map u.unop ≫ π_slice V₁.unop = π_slice V₂.unop :=
                      CategoryTheory.MorphismProperty.Over.Hom.ext (hOverW u.unop)
                    exact (congrArg
                        (DFinsupp.single (β := fun ψ : (M_h.obj V₂.unop ⟶ U_h) =>
                          ↥(P.obj (Opposite.op (asOver (M_h.obj V₂.unop) ψ)))) (π_slice V₂.unop))
                        hcomp_u2).trans
                      ((hSingleEq P hπ_eq.symm
                        (κ_slice V₂.unop ≫ u.unop)
                        (liftMap (M_h.map u.unop) (π_slice V₁.unop) ≫ κ_slice V₁.unop)
                        ((CategoryTheory.Category.id_comp u.unop.left).trans
                          (CategoryTheory.Category.comp_id u.unop.left).symm) x).trans
                        (congrArg
                          (DFinsupp.single (β := fun ψ : (M_h.obj V₂.unop ⟶ U_h) =>
                            ↥(P.obj (Opposite.op (asOver (M_h.obj V₂.unop) ψ))))
                            (M_h.map u.unop ≫ π_slice V₁.unop))
                          hcomp_u.symm)) }
              invFun := fun β =>
                { app := fun T => AddCommGrpCat.ofHom (adjBackHom β T.unop)
                  naturality := fun {T₁ T₂} g => by
                    apply AddCommGrpCat.hom_ext
                    refine DFinsupp.addHom_ext' fun φ => AddMonoidHom.ext fun x => ?_
                    change adjBackHom β T₂.unop (preMapHom P g.unop (DFinsupp.single φ x)) =
                      (Q.map g).hom (adjBackHom β T₁.unop (DFinsupp.single φ x))
                    have hL := (congrArg (adjBackHom β T₂.unop)
                      (hPreMapSingle P g.unop φ x)).trans
                      (hAdjBackSingle β T₂.unop (g.unop ≫ φ) _)
                    have hR := congrArg (Q.map g).hom (hAdjBackSingle β T₁.unop φ x)
                    have hβ_nat := congrArg (fun ψ => (AddCommGrpCat.Hom.hom ψ) x)
                      (β.naturality (Opposite.op (liftMap g.unop φ)))
                    have hι_comm : g.unop ≫ ι_slice T₁.unop φ =
                        ι_slice T₂.unop (g.unop ≫ φ) ≫ M_h.map (liftMap g.unop φ) :=
                      CategoryTheory.MorphismProperty.Over.Hom.ext
                        ((CategoryTheory.Category.comp_id g.unop.left).trans
                          (CategoryTheory.Category.id_comp g.unop.left).symm)
                    have hQ1 : (Q.map (Opposite.op (ι_slice T₂.unop (g.unop ≫ φ)))).hom
                        ((Q.map (Opposite.op (M_h.map (liftMap g.unop φ)))).hom
                          ((β.app (Opposite.op (asOver T₁.unop φ))).hom x)) =
                        (Q.map (Opposite.op (ι_slice T₂.unop (g.unop ≫ φ) ≫
                          M_h.map (liftMap g.unop φ)))).hom
                          ((β.app (Opposite.op (asOver T₁.unop φ))).hom x) :=
                      congrArg (fun θ => (AddCommGrpCat.Hom.hom θ) _)
                        (Q.map_comp (Opposite.op (M_h.map (liftMap g.unop φ)))
                          (Opposite.op (ι_slice T₂.unop (g.unop ≫ φ)))).symm
                    have hQ2 : (Q.map g).hom
                        ((Q.map (Opposite.op (ι_slice T₁.unop φ))).hom
                          ((β.app (Opposite.op (asOver T₁.unop φ))).hom x)) =
                        (Q.map (Opposite.op (g.unop ≫ ι_slice T₁.unop φ))).hom
                          ((β.app (Opposite.op (asOver T₁.unop φ))).hom x) :=
                      congrArg (fun θ => (AddCommGrpCat.Hom.hom θ) _)
                        (Q.map_comp (Opposite.op (ι_slice T₁.unop φ)) (Opposite.op g.unop)).symm
                    exact hL.trans
                      ((congrArg (Q.map (Opposite.op (ι_slice T₂.unop (g.unop ≫ φ)))).hom hβ_nat).trans
                        (hQ1.trans ((congrArg (fun k => (Q.map (Opposite.op k)).hom _) hι_comm.symm).trans
                          (hQ2.symm.trans hR.symm)))) }
              left_inv := fun α => by
                ext T : 2
                apply AddCommGrpCat.hom_ext
                refine DFinsupp.addHom_ext' fun φ => AddMonoidHom.ext fun x => ?_
                dsimp only [AddCommGrpCat.hom_ofHom, AddMonoidHom.comp_apply,
                  DFinsupp.singleAddHom_apply]
                refine (hAdjBackSingle _ T.unop φ x).trans ?_
                dsimp only [AddCommGrpCat.hom_ofHom, AddMonoidHom.comp_apply,
                  DFinsupp.singleAddHom_apply]
                have hα_nat := congrArg
                  (fun ψ => (AddCommGrpCat.Hom.hom ψ)
                    (DFinsupp.single (π_slice (asOver T.unop φ))
                      ((P.map (Opposite.op (κ_slice (asOver T.unop φ)))).hom x)))
                  (α.naturality (Opposite.op (ι_slice T.unop φ)))
                refine hα_nat.symm.trans ?_
                apply congrArg (α.app T).hom
                have hLHS := hPreMapSingle P (ι_slice T.unop φ) (π_slice (asOver T.unop φ))
                  ((P.map (Opposite.op (κ_slice (asOver T.unop φ)))).hom x)
                refine hLHS.trans ?_
                have hP_comp : (P.map (Opposite.op (liftMap (ι_slice T.unop φ)
                      (π_slice (asOver T.unop φ))))).hom
                    ((P.map (Opposite.op (κ_slice (asOver T.unop φ)))).hom x) =
                    (P.map (Opposite.op (liftMap (ι_slice T.unop φ) (π_slice (asOver T.unop φ)) ≫
                      κ_slice (asOver T.unop φ)))).hom x :=
                  congrArg (fun θ => (AddCommGrpCat.Hom.hom θ) x)
                    (P.map_comp (Opposite.op (κ_slice (asOver T.unop φ)))
                      (Opposite.op (liftMap (ι_slice T.unop φ) (π_slice (asOver T.unop φ))))).symm
                have hιπ : ι_slice T.unop φ ≫ π_slice (asOver T.unop φ) = φ :=
                  CategoryTheory.MorphismProperty.Over.Hom.ext
                    (CategoryTheory.Category.id_comp φ.left)
                refine (congrArg
                  (DFinsupp.single (β := fun ψ : (T.unop ⟶ U_h) =>
                    ↥(P.obj (Opposite.op (asOver T.unop ψ))))
                    (ι_slice T.unop φ ≫ π_slice (asOver T.unop φ))) hP_comp).trans ?_
                refine (hSingleEq P hιπ
                  (liftMap (ι_slice T.unop φ) (π_slice (asOver T.unop φ)) ≫
                    κ_slice (asOver T.unop φ))
                  (CategoryTheory.CategoryStruct.id (asOver T.unop φ))
                  (CategoryTheory.Category.id_comp _) x).trans ?_
                exact congrArg
                  (DFinsupp.single (β := fun ψ : (T.unop ⟶ U_h) =>
                    ↥(P.obj (Opposite.op (asOver T.unop ψ)))) φ)
                  (congrArg (fun θ => (AddCommGrpCat.Hom.hom θ) x)
                    (P.map_id (Opposite.op (asOver T.unop φ))))
              right_inv := fun β => by
                ext V : 2
                apply AddCommGrpCat.ext
                intro x
                change adjBackHom β (M_h.obj V.unop)
                    (DFinsupp.single (π_slice V.unop)
                      ((P.map (Opposite.op (κ_slice V.unop))).hom x)) =
                  (β.app V).hom x
                refine (hAdjBackSingle β (M_h.obj V.unop) (π_slice V.unop) _).trans ?_
                have hβ_nat := congrArg (fun ψ => (AddCommGrpCat.Hom.hom ψ) x)
                  (β.naturality (Opposite.op (κ_slice V.unop)))
                have hQ_comp : (Q.map (Opposite.op (ι_slice (M_h.obj V.unop) (π_slice V.unop)))).hom
                    ((Q.map (Opposite.op (M_h.map (κ_slice V.unop)))).hom ((β.app V).hom x)) =
                    (Q.map (Opposite.op (ι_slice (M_h.obj V.unop) (π_slice V.unop) ≫
                      M_h.map (κ_slice V.unop)))).hom ((β.app V).hom x) :=
                  congrArg (fun θ => (AddCommGrpCat.Hom.hom θ) _)
                    (Q.map_comp (Opposite.op (M_h.map (κ_slice V.unop)))
                      (Opposite.op (ι_slice (M_h.obj V.unop) (π_slice V.unop)))).symm
                have hικ : ι_slice (M_h.obj V.unop) (π_slice V.unop) ≫
                    M_h.map (κ_slice V.unop) = CategoryTheory.CategoryStruct.id (M_h.obj V.unop) :=
                  CategoryTheory.MorphismProperty.Over.Hom.ext
                    (CategoryTheory.Category.id_comp (CategoryTheory.CategoryStruct.id V.unop.left))
                refine (congrArg (Q.map (Opposite.op (ι_slice (M_h.obj V.unop) (π_slice V.unop)))).hom
                  hβ_nat).trans (hQ_comp.trans ?_)
                refine (congrArg (fun k => (Q.map (Opposite.op k)).hom ((β.app V).hom x)) hικ).trans ?_
                exact congrArg (fun θ => (AddCommGrpCat.Hom.hom θ) ((β.app V).hom x))
                  (Q.map_id (Opposite.op (M_h.obj V.unop))) }
          homEquiv_naturality_left_symm := fun {P' P Q} θ β => by
            ext T : 2
            apply AddCommGrpCat.hom_ext
            refine DFinsupp.addHom_ext' fun φ => AddMonoidHom.ext fun x => ?_
            change adjBackHom β T.unop (mapRangeHom θ T.unop (DFinsupp.single φ x)) =
              adjBackHom (θ ≫ β) T.unop (DFinsupp.single φ x)
            exact (congrArg (adjBackHom β T.unop) (hMapRangeSingle θ T.unop φ x)).trans
              ((hAdjBackSingle β T.unop φ _).trans (hAdjBackSingle (θ ≫ β) T.unop φ x).symm)
          homEquiv_naturality_right := fun {P Q Q'} α η => by
            ext V : 2
            apply AddCommGrpCat.ext
            intro x
            rfl }
    have hLim_pre : CategoryTheory.Limits.PreservesFiniteLimits h_sh_pre := by
      apply CategoryTheory.preservesFiniteLimits_of_evaluation
      intro T
      let E_T := h_sh_pre.comp ((CategoryTheory.evaluation (Opposite S.Etale) AddCommGrpCat.{u}).obj T)
      haveI hAdd_ET : E_T.Additive :=
        { map_add := fun {P₁ P₂} {f g} => by
            apply AddCommGrpCat.hom_ext
            refine DFinsupp.addHom_ext' fun φ => AddMonoidHom.ext fun x => ?_
            simp [E_T, h_sh_pre, mapRangeHom] }
      rw [CategoryTheory.Functor.preservesFiniteLimits_iff_forall_exact_map_and_mono]
      intro SC hSC
      refine ⟨?_, ?_⟩
      · rw [CategoryTheory.ShortComplex.ab_exact_iff_ker_le_range]
        intro y hy
        rw [AddMonoidHom.mem_ker] at hy
