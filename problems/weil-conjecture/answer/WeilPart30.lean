        (Nat.add_zero 0)).comp (CategoryTheory.Abelian.Ext.mk₀ (pb_s.map ρ_inf)) (Nat.add_zero 0) = z
      have hz := (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply z).symm
      rw [hz, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        CategoryTheory.Category.assoc, ← pb_s.map_comp, hη_ρ, pb_s.map_id,
