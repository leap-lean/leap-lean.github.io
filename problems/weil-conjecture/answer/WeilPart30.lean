  have hFreeComp : ∀ {S : AlgebraicGeometry.Scheme.{u}} {m : ℕ} {V : S.Etale}
      {G₁ G₂ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
      (f : Quiver.Hom (weilGysinLocalTorsionSheaf S m V) G₁) (g : Quiver.Hom G₁ G₂),
      CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.comp f g) =
        CategoryTheory.CategoryStruct.comp
          (CategoryTheory.Sheaf.freeYonedaHomEquiv f)
          (g.hom.app (Opposite.op V)) := by
    intro S m V G₁ G₂ f g
    let P := CategoryTheory.Presheaf.freeYoneda V
      (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m)))
    let adj := CategoryTheory.sheafificationAdjunction S.smallEtaleTopology AddCommGrpCat.{u}
    let f' : (CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj P ⟶ G₁ := f
    have h1 : (adj.homEquiv P G₂) (f' ≫ g) = (adj.homEquiv P G₁) f' ≫ g.hom :=
