      (h : f₁ = f₂) (A : Y₂.Etale),
      let e_c : weilEtaleSitePullback f₁ ≅ weilEtaleSitePullback f₂ :=
        CategoryTheory.MorphismProperty.Over.pullbackCongr h
      ((AlgebraicGeometry.Scheme.Etale.forget Y₁).map (e_c.hom.app A)).left ≫
        CategoryTheory.Limits.pullback.fst
          ((AlgebraicGeometry.Scheme.Etale.forget Y₂).obj A).hom f₂ =
      CategoryTheory.Limits.pullback.fst
        ((AlgebraicGeometry.Scheme.Etale.forget Y₂).obj A).hom f₁ := by
    intro Y₁ Y₂ f₁ f₂ h A
    subst h
    change (CategoryTheory.Limits.pullback.congrHom rfl rfl).hom ≫
      CategoryTheory.Limits.pullback.fst
        ((AlgebraicGeometry.Scheme.Etale.forget Y₂).obj A).hom f₁ = _
    simp [CategoryTheory.Limits.pullback.congrHom, CategoryTheory.Limits.pullback.map]
    exact CategoryTheory.Limits.pullback.lift_fst _ _ _

  
  intro W₀ W'₀ U U' e_W e_U j_W hj_W j'_W hj'_W hcomm_W n q z_W
  let g' : W'₀ ⟶ W₀ := e_W.inv
  letI := hc_all g'; letI := hr_all g'
  let V_W := weilGysinEtaleObj j_W hj_W
  let V'_W := weilGysinEtaleObj j'_W hj'_W
  let L_W := weilGysinLocalTorsionSheaf W₀ n V_W
  let L'_W := weilGysinLocalTorsionSheaf W'₀ n V'_W
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let Fℤ_W := (CategoryTheory.constantSheaf W₀.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
  let Fℤ_W' := (CategoryTheory.constantSheaf W'₀.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
  let B_g' := weilEtaleSitePullback g'
  let pf_g' := B_g'.sheafPushforwardContinuous AddCommGrpCat.{u}
    W₀.smallEtaleTopology W'₀.smallEtaleTopology
  let pb_g' := B_g'.sheafPullback AddCommGrpCat.{u}
    W₀.smallEtaleTopology W'₀.smallEtaleTopology
  let adj_g' := B_g'.sheafAdjunctionContinuous AddCommGrpCat.{u}
    W₀.smallEtaleTopology W'₀.smallEtaleTopology
  letI : pb_g'.Additive := (hSitePkg g').1
  letI : CategoryTheory.Limits.PreservesFiniteLimits pb_g' := (hSitePkg g').2.2.1
  letI : CategoryTheory.Limits.PreservesFiniteColimits pb_g' := (hSitePkg g').2.2.2
  let πℤ_g' := weilEtaleConstPullbackHom g'
    (weilEtaleIdTerminalIsTerminal.{u} W'₀) (weilEtaleIdTerminalIsTerminal.{u} W₀) Aℤ
  haveI : CategoryTheory.IsIso πℤ_g' := hConstIso g'
    (weilEtaleIdTerminalIsTerminal.{u} W'₀) (weilEtaleIdTerminalIsTerminal.{u} W₀) Aℤ
  let ιℤ_g' : Fℤ_W' ⟶ pb_g'.obj Fℤ_W := CategoryTheory.inv πℤ_g'
