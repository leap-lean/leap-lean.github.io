      [CategoryTheory.Category.{u + 1, u + 1} 𝒞_Y]
      [CategoryTheory.Category.{u + 1, u + 1} 𝒞_Z']
      [CategoryTheory.Category.{u + 1, u + 1} 𝒞_Y']
      [CategoryTheory.Abelian 𝒞_Z] [CategoryTheory.Abelian 𝒞_Y]
      [CategoryTheory.Abelian 𝒞_Z'] [CategoryTheory.Abelian 𝒞_Y']
      [CategoryTheory.EnoughInjectives 𝒞_Z] [CategoryTheory.EnoughInjectives 𝒞_Y]
      [CategoryTheory.EnoughInjectives 𝒞_Z']
      [CategoryTheory.HasExt.{u} 𝒞_Z] [CategoryTheory.HasExt.{u} 𝒞_Y]
      [CategoryTheory.HasExt.{u} 𝒞_Z'] [CategoryTheory.HasExt.{u} 𝒞_Y']
