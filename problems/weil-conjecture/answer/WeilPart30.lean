        rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, hf_k_spec,
          ← CategoryTheory.Category.assoc, hψ'_spec, CategoryTheory.Category.assoc, hφ, hf'_k_spec]
      have hcat := AlgebraicGeometry.Spec.map_injective hspec
      ext c
      exact ConcreteCategory.congr_hom hcat c
    have hι'_et : ι'.Etale := by
      let _ : Algebra A₂ A' := ι'.toAlgebra
      have : IsLocalization.Away f₁ A' := hU₂.isLocalization_basicOpen f₁
      let e_loc : Localization.Away f₁ ≃ₐ[A₂] A' :=
        IsLocalization.algEquiv (Submonoid.powers f₁) (Localization.Away f₁) A'
      have : Algebra.Etale A₂ A' := Algebra.Etale.of_equiv e_loc
      exact RingHom.etale_algebraMap.mpr inferInstance
    have hB_et : ((Ideal.Quotient.mk (Ideal.span (Set.range (fun a : A₂ => ι' a - ψ' a)))).comp
        (ι'.comp f_k)).Etale :=
      hEqEtale U₂ U_aff hU₂ hU_aff hle_aff_U2 he_aff_φ (ι'.comp f_k) hf'_k_spec
    have hs_aff_range : Set.range s_w.base ⊆ Set.range U_aff.ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rintro _ ⟨z, rfl⟩
      rw [hS_k_uniq z, hs_w_pt]
      exact hx_aff
    let s_aff : Quiver.Hom S_k U_aff.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift U_aff.ι s_w hs_aff_range
    have hs_aff_ι : CategoryTheory.CategoryStruct.comp s_aff U_aff.ι = s_w :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac U_aff.ι s_w hs_aff_range
    let s_spec : Quiver.Hom S_k (AlgebraicGeometry.Spec (X.left.presheaf.obj (Opposite.op U_aff))) :=
      CategoryTheory.CategoryStruct.comp s_aff U_aff.toSpecΓ
    have hs_spec_from : CategoryTheory.CategoryStruct.comp s_spec hU_aff.fromSpec = s_w := by
      change (s_aff ≫ U_aff.toSpecΓ) ≫ hU_aff.fromSpec = s_w
      rw [CategoryTheory.Category.assoc, hU_aff.toSpecΓ_fromSpec, hs_aff_ι]
    let p_w : PrimeSpectrum A' := s_spec.base pt₀
    let ev_w_hom : X.left.presheaf.obj (Opposite.op U_aff) ⟶ CommRingCat.of k :=
      AlgebraicGeometry.Spec.preimage s_spec
    have hev_w_spec : AlgebraicGeometry.Spec.map ev_w_hom = s_spec :=
      AlgebraicGeometry.Spec.map_preimage s_spec
    have hev_w_eq : ev_w_hom.hom.comp ι' = ev_w_hom.hom.comp ψ' := by
      have h_mono : s_spec ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι') =
          s_spec ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ') := by
        apply (cancel_mono hU₂.fromSpec).mp
        rw [CategoryTheory.Category.assoc, hι'_spec, hs_spec_from,
          CategoryTheory.Category.assoc, hψ'_spec, ← CategoryTheory.Category.assoc,
          hs_spec_from]
        change (s'_W w ≫ i_W) = (s'_W w ≫ i_W) ≫ φ
        rw [CategoryTheory.Category.assoc, hiW_φ]
      rw [← hev_w_spec, ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp] at h_mono
      have hcat := AlgebraicGeometry.Spec.map_injective h_mono
      ext a
      exact ConcreteCategory.congr_hom hcat a
    have hp_w_ideal : Ideal.span (Set.range (fun a : A₂ => ι' a - ψ' a)) ≤ p_w.asIdeal := by
      rw [Ideal.span_le]
      rintro _ ⟨a, rfl⟩
      have hp_eq : p_w = (AlgebraicGeometry.Spec.map ev_w_hom).base pt₀ := by
        rw [hev_w_spec]
      rw [hp_eq]
      change ev_w_hom.hom (ι' a - ψ' a) ∈ pt₀.asIdeal
      have hev_zero : ev_w_hom.hom (ι' a - ψ' a) = 0 := by
        rw [map_sub, sub_eq_zero]
        exact RingHom.congr_fun hev_w_eq a
      rw [hev_zero]
      exact Ideal.zero_mem pt₀.asIdeal
    obtain ⟨f_det, hf_det_not_mem, hf_det_et⟩ :=
      weil_gysin_kaehler_jacobi_zariski_transversal_etale k d A₂ A' f_k g₂ ι' ψ' p_w
        rfl hg₂_et hι'_et hψ'_k hB_et hp_w_ideal
    let U_et : X.left.Opens := X.left.basicOpen f_det
    have hU_et : AlgebraicGeometry.IsAffineOpen U_et := hU_aff.basicOpen f_det
    have hle_et_aff : U_et ≤ U_aff := X.left.basicOpen_le f_det
    have hle_et_iso : U_et ≤ U_iso := hle_et_aff.trans hf₁_le
    have hle_et_U'w : U_et ≤ U'_w := hle_et_iso.trans (inf_le_left.trans inf_le_left)
    have hle_et_ΔVw : U_et ≤ (TopologicalSpace.Opens.map Δ.base).obj V_w :=
      hle_et_iso.trans (inf_le_left.trans inf_le_right)
    have hx_et : x_w ∈ U_et := by
      have hxw_from : hU_aff.fromSpec.base p_w = x_w := by
        change (s_spec ≫ hU_aff.fromSpec).base pt₀ = x_w
        rw [hs_spec_from, hs_w_pt]
      rw [← hxw_from]
      change p_w ∈ (TopologicalSpace.Opens.map hU_aff.fromSpec.base).obj U_et
      rw [hU_aff.fromSpec_preimage_basicOpen f_det]
      exact (PrimeSpectrum.mem_basicOpen f_det p_w).mpr hf_det_not_mem
    have hδ_et_range : Set.range (U_et.ι ≫ Δ).base ⊆ Set.range V_w.ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rintro _ ⟨y, rfl⟩
      exact hle_et_ΔVw y.2
    let δ_et : Quiver.Hom U_et.toScheme V_w.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift V_w.ι (U_et.ι ≫ Δ) hδ_et_range
    have hδ_et_ι : CategoryTheory.CategoryStruct.comp δ_et V_w.ι =
        CategoryTheory.CategoryStruct.comp U_et.ι Δ :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac V_w.ι (U_et.ι ≫ Δ) hδ_et_range
    have hδ_et_v_formula := hDiagEq hle₁₂ U_et hle_et_U'w δ_et hδ_et_ι
    let A'' : Type u := ↑(X.left.presheaf.obj (Opposite.op U_et))
    let res_et : A' →+* A'' := (X.left.presheaf.map (CategoryTheory.homOfLE hle_et_aff).op).hom
    let h₀ : MvPolynomial (Fin d) k →+* A' :=
      MvPolynomial.eval₂Hom (ι'.comp f_k)
        (fun j : Fin d => ι' (g₂ (MvPolynomial.X j)) - ψ' (g₂ (MvPolynomial.X j)))
    let ι'' : A₂ →+* A'' :=
      (X.left.presheaf.map (CategoryTheory.homOfLE (hle_et_U'w.trans hle₁₂)).op).hom
    let ψ'' : A₂ →+* A'' :=
      (AlgebraicGeometry.Scheme.Hom.appLE φ U₂ U_et (hle_et_U'w.trans he_φ)).hom
    let h_et : MvPolynomial (Fin d) k →+* A'' :=
      MvPolynomial.eval₂Hom ((ι''.comp g₂).comp MvPolynomial.C)
        (fun j : Fin d => ι'' (g₂ (MvPolynomial.X j)) - ψ'' (g₂ (MvPolynomial.X j)))
    have hι''_eq : ι'' = res_et.comp ι' := by
      have hhom : CategoryTheory.CategoryStruct.comp
            (CategoryTheory.homOfLE hle_aff_U2).op (CategoryTheory.homOfLE hle_et_aff).op =
          (CategoryTheory.homOfLE (hle_et_U'w.trans hle₁₂)).op := rfl
      have hmap := X.left.presheaf.map_comp
        (CategoryTheory.homOfLE hle_aff_U2).op (CategoryTheory.homOfLE hle_et_aff).op
      rw [hhom] at hmap
      ext a
      exact ConcreteCategory.congr_hom hmap a
    have hψ''_eq : ψ'' = res_et.comp ψ' := by
      have happ := AlgebraicGeometry.Scheme.Hom.appLE_map φ he_aff_φ
        (CategoryTheory.homOfLE hle_et_aff).op
      ext a
      exact (ConcreteCategory.congr_hom happ a).symm
    have hh_et_eq : h_et = res_et.comp h₀ := by
      apply MvPolynomial.ringHom_ext
      · intro c
        dsimp [h_et, h₀, f_k]
        rw [hι''_eq]
        simp [RingHom.comp_apply]
      · intro j
        dsimp [h_et, h₀]
        rw [hι''_eq, hψ''_eq]
        simp [RingHom.comp_apply]
    have hh_et_etale : h_et.Etale := by
      let _ : Algebra (MvPolynomial (Fin d) k) A' := h₀.toAlgebra
      let _ : Algebra A' A'' := res_et.toAlgebra
      let _ : Algebra (MvPolynomial (Fin d) k) A'' := h_et.toAlgebra
      have : IsScalarTower (MvPolynomial (Fin d) k) A' A'' :=
        IsScalarTower.of_algebraMap_eq' hh_et_eq
      have : IsScalarTower (MvPolynomial (Fin d) k) A' (Localization.Away f_det) :=
        IsScalarTower.of_algebraMap_eq' rfl
      have hloc_alg_eq : algebraMap (MvPolynomial (Fin d) k) (Localization.Away f_det) =
          (algebraMap A' (Localization.Away f_det)).comp h₀ :=
        IsScalarTower.algebraMap_eq (MvPolynomial (Fin d) k) A' (Localization.Away f_det)
      have : Algebra.Etale (MvPolynomial (Fin d) k) (Localization.Away f_det) := by
        apply RingHom.etale_algebraMap.mp
        rw [hloc_alg_eq]
        exact hf_det_et
      have : IsLocalization.Away f_det A'' := hU_aff.isLocalization_basicOpen f_det
      let e_det : Localization.Away f_det ≃ₐ[A'] A'' :=
        IsLocalization.algEquiv (Submonoid.powers f_det) (Localization.Away f_det) A''
      let e_det_P : Localization.Away f_det ≃ₐ[MvPolynomial (Fin d) k] A'' :=
        e_det.restrictScalars (MvPolynomial (Fin d) k)
      have : Algebra.Etale (MvPolynomial (Fin d) k) A'' := Algebra.Etale.of_equiv e_det_P
      exact RingHom.etale_algebraMap.mpr inferInstance
    have hδv_etale : AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.comp δ_et v_w) := by
      rw [hδ_et_v_formula]
      change AlgebraicGeometry.Etale
        (CategoryTheory.CategoryStruct.comp U_et.toSpecΓ
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom h_et)))
      have : CategoryTheory.IsIso U_et.toSpecΓ := by
        rw [← hU_et.isoSpec_hom]
        infer_instance
      have : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom h_et)) :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
          hh_et_etale
      infer_instance
    have hδv_str : CategoryTheory.CategoryStruct.comp
          (CategoryTheory.CategoryStruct.comp δ_et v_w) (weilGysinAffineStruct k d) =
        CategoryTheory.CategoryStruct.comp U_et.ι X.hom := by
      rw [CategoryTheory.Category.assoc, hTub_w.2.2.2.2.2.2.1, ← CategoryTheory.Category.assoc,
        hδ_et_ι, CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc Δ p₁ X.hom,
        CategoryTheory.Limits.pullback.diagonal_fst X.hom, CategoryTheory.Category.id_comp]
    have hs_et_range : Set.range s_w.base ⊆ Set.range U_et.ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rintro _ ⟨z, rfl⟩
      rw [hS_k_uniq z, hs_w_pt]
      exact hx_et
    let s_et : Quiver.Hom S_k U_et.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift U_et.ι s_w hs_et_range
    have hs_et_ι : CategoryTheory.CategoryStruct.comp s_et U_et.ι = s_w :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac U_et.ι s_w hs_et_range
    have hs_U'w_range : Set.range s_w.base ⊆ Set.range U'_w.ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rintro _ ⟨z, rfl⟩
      rw [hS_k_uniq z, hs_w_pt]
      exact hx_U'w
    let s_U'w : Quiver.Hom S_k U'_w.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift U'_w.ι s_w hs_U'w_range
    have hs_U'w_ι : CategoryTheory.CategoryStruct.comp s_U'w U'_w.ι = s_w :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac U'_w.ι s_w hs_U'w_range
    have hs_δ_γ : CategoryTheory.CategoryStruct.comp s_et δ_et =
        CategoryTheory.CategoryStruct.comp s_U'w γ'_w := by
      apply (cancel_mono V_w.ι).mp
      calc
        (s_et ≫ δ_et) ≫ V_w.ι = s_et ≫ (δ_et ≫ V_w.ι) := CategoryTheory.Category.assoc _ _ _
        _ = (s_et ≫ U_et.ι) ≫ Δ := by rw [hδ_et_ι, CategoryTheory.Category.assoc]
        _ = (s'_W w ≫ i_W) ≫ Δ := by rw [hs_et_ι]
        _ = (s'_W w ≫ i_W) ≫ Γ_φ := by
          rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hiW_Δ_Γ]
        _ = (s_U'w ≫ U'_w.ι) ≫ Γ_φ := by rw [hs_U'w_ι]
        _ = s_U'w ≫ (γ'_w ≫ V_w.ι) := by rw [CategoryTheory.Category.assoc, hTub_w.2.1]
        _ = (s_U'w ≫ γ'_w) ≫ V_w.ι := (CategoryTheory.Category.assoc _ _ _).symm
    have hs_δv_orig : CategoryTheory.CategoryStruct.comp s_et
          (CategoryTheory.CategoryStruct.comp δ_et v_w) =
        weilGysinAffineOrigin k d := by
      rw [← CategoryTheory.Category.assoc, hs_δ_γ, CategoryTheory.Category.assoc,
        hTub_w.2.2.2.2.2.2.2.2.2.1.w, ← CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc, hs_U'w_ι, hs_w_hom, CategoryTheory.Category.id_comp]
    obtain ⟨U_w, hle_w, s_Uw, hChart_Uw⟩ :=
      hShrink d X.left X.hom s_w hs_w_hom U_et s_et hs_et_ι
        (CategoryTheory.CategoryStruct.comp δ_et v_w) hδv_etale hδv_str hs_δv_orig
    let δ_w : Quiver.Hom U_w.toScheme V_w.toScheme :=
      CategoryTheory.CategoryStruct.comp (X.left.homOfLE hle_w) δ_et
    have hδ_w_ι : CategoryTheory.CategoryStruct.comp δ_w V_w.ι =
        CategoryTheory.CategoryStruct.comp U_w.ι Δ := by
      change (X.left.homOfLE hle_w ≫ δ_et) ≫ V_w.ι = U_w.ι ≫ Δ
      rw [CategoryTheory.Category.assoc, hδ_et_ι, ← CategoryTheory.Category.assoc,
        X.left.homOfLE_ι hle_w]
    have hChart_Uw' : WeilGysinIsEtaleOriginChart d X.hom s_w U_w s_Uw
        (CategoryTheory.CategoryStruct.comp δ_w v_w) := by
      have hassoc : CategoryTheory.CategoryStruct.comp (X.left.homOfLE hle_w)
            (CategoryTheory.CategoryStruct.comp δ_et v_w) =
          CategoryTheory.CategoryStruct.comp δ_w v_w :=
        (CategoryTheory.Category.assoc _ _ _).symm
      rw [← hassoc]
      exact hChart_Uw
    have hx_Uw : x_w ∈ U_w := by
      have hpt_eq : (CategoryTheory.CategoryStruct.comp s_Uw U_w.ι).base pt₀ = x_w := by
        rw [hChart_Uw.2.2.1, hs_w_pt]
      rw [← hpt_eq]
      exact (s_Uw.base pt₀).2
    have hUw_inter : (U_w : Set X.left) ∩ Set.range i_W.base = {x_w} := by
      ext y
      simp only [Set.mem_inter_iff, Set.mem_singleton_iff]
      constructor
      · rintro ⟨hy_Uw, w', rfl⟩
        have hy_iso : i_W.base w' ∈ U_iso := (hle_w.trans hle_et_iso) hy_Uw
        have hy_not_other : i_W.base w' ∉ S_other := hy_iso.2
        by_contra hne
        have hw'_ne : w' ≠ w := fun h => hne (congrArg i_W.base h)
        exact hy_not_other ⟨w', hw'_ne, rfl⟩
      · rintro rfl
        exact ⟨hx_Uw, ⟨w, rfl⟩⟩
    exact ⟨U'_w, U_w, V_w, γ'_w, p₁_Vw, u'_w, v_w, Ψ'_w, δ_w, s_Uw,
      hTub_w, hUw_inter, hδ_w_ι, hChart_Uw'⟩

theorem weil_gysin_product_integral_and_overlap_origin_chart (k : Type u) [Field k] [IsAlgClosed k]
    (d : ℕ) (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hInt : AlgebraicGeometry.IsIntegral X.left)
    [AlgebraicGeometry.IsProper X.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension d X.hom]
    (φ : Quiver.Hom X.left X.left)
    (hφ : CategoryTheory.CategoryStruct.comp φ X.hom = X.hom)
    (hΓ_cl : AlgebraicGeometry.IsClosedImmersion
      (CategoryTheory.Limits.pullback.lift (CategoryTheory.CategoryStruct.id X.left) φ
        ((CategoryTheory.Category.id_comp X.hom).trans hφ.symm))) :
    let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
    let P := CategoryTheory.Limits.pullback X.hom X.hom
    let p₁ := CategoryTheory.Limits.pullback.fst X.hom X.hom
    let Γ_φ := CategoryTheory.Limits.pullback.lift (CategoryTheory.CategoryStruct.id X.left) φ
      ((CategoryTheory.Category.id_comp X.hom).trans hφ.symm)
    (AlgebraicGeometry.IsIntegral P ∧
      ConnectedSpace ↥S_k ∧
      (∀ c : ℕ, AlgebraicGeometry.IsClosedImmersion (weilGysinAffineOrigin k c)) ∧
      (∀ (a b ab : ℕ) (hab : a + b = ab),
        AlgebraicGeometry.IsClosedImmersion (weilGysinAffineLeftAxis k a b ab hab)) ∧
      (∀ {Y : AlgebraicGeometry.Scheme.{u}} (p_Y : Quiver.Hom Y S_k)
        [AlgebraicGeometry.IsSeparated p_Y] (s : Quiver.Hom S_k Y),
        CategoryTheory.CategoryStruct.comp s p_Y = CategoryTheory.CategoryStruct.id S_k →
        AlgebraicGeometry.IsClosedImmersion s) ∧
      (∀ c : ℕ,
        CategoryTheory.IsPullback (weilGysinAffineOrigin k c) (weilGysinAffineOrigin k 0)
          (CategoryTheory.CategoryStruct.id (weilGysinAffineSpace k c))
          (weilGysinAffineLeftAxis k 0 c c (Nat.zero_add c)) ∧
        CategoryTheory.CategoryStruct.comp
          (CategoryTheory.CategoryStruct.id (weilGysinAffineSpace k c))
          (weilGysinAffineProjRight k 0 c c (Nat.zero_add c)) =
          CategoryTheory.CategoryStruct.id (weilGysinAffineSpace k c)) ∧
      (∀ (c : ℕ) {Y : AlgebraicGeometry.Scheme.{u}} (p_Y : Quiver.Hom Y S_k)
        (s : Quiver.Hom S_k Y) (U W_sub : Y.Opens)
        (s_U : Quiver.Hom S_k U.toScheme)
        (u : Quiver.Hom U.toScheme (weilGysinAffineSpace k c)),
        WeilGysinIsEtaleOriginChart c p_Y s U s_U u →
        ∀ (hW_le : W_sub ≤ U),
          let U_Sk : S_k.Opens := (TopologicalSpace.Opens.map s.base).obj W_sub
          Nonempty ↥U_Sk.toScheme →
          ∃ u_sub0 : Quiver.Hom U_Sk.toScheme (weilGysinAffineSpace k 0),
            AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.comp (Y.homOfLE hW_le) u) ∧
            ConnectedSpace ↥U_Sk.toScheme ∧
            CategoryTheory.IsPullback (s.resLE W_sub U_Sk (le_refl _)) u_sub0
              (CategoryTheory.CategoryStruct.comp (Y.homOfLE hW_le) u)
              (weilGysinAffineLeftAxis k 0 c c (Nat.zero_add c)) ∧
            CategoryTheory.CategoryStruct.comp
              (CategoryTheory.CategoryStruct.comp (Y.homOfLE hW_le) u)
              (weilGysinAffineProjRight k 0 c c (Nat.zero_add c)) =
              CategoryTheory.CategoryStruct.comp (Y.homOfLE hW_le) u)) ∧
    (∀ (U_x : X.left.Opens) (V_x : P.Opens)
      (γ_x : Quiver.Hom U_x.toScheme V_x.toScheme)
      (p₁_Vx : Quiver.Hom V_x.toScheme U_x.toScheme)
      (u_x : Quiver.Hom U_x.toScheme (weilGysinAffineSpace k d))
      (v_x : Quiver.Hom V_x.toScheme (weilGysinAffineSpace k d))
      (Ψ_x : Quiver.Hom V_x.toScheme (weilGysinAffineSpace k (2 * d))),
      WeilGysinIsTubularGraphChart d X Γ_φ U_x V_x γ_x p₁_Vx u_x v_x Ψ_x →
      CategoryTheory.IsPullback γ_x U_x.ι V_x.ι Γ_φ ∧
      CategoryTheory.IsPullback γ_x u_x Ψ_x
        (weilGysinAffineLeftAxis k d d (2 * d) (Nat.two_mul d).symm) ∧
      ∀ (W_sub : P.Opens) (hW_sub : W_sub ≤ V_x),
        let U_sub : X.left.Opens := (TopologicalSpace.Opens.map Γ_φ.base).obj W_sub
        let γ_sub := Γ_φ.resLE W_sub U_sub (le_refl _)
        let ψ_sub := CategoryTheory.CategoryStruct.comp (P.homOfLE hW_sub) Ψ_x
        ∃ u_sub : Quiver.Hom U_sub.toScheme (weilGysinAffineSpace k d),
          AlgebraicGeometry.Etale ψ_sub ∧
          CategoryTheory.IsPullback γ_sub u_sub ψ_sub
            (weilGysinAffineLeftAxis k d d (2 * d) (Nat.two_mul d).symm) ∧
          CategoryTheory.IsPullback γ_sub
            (CategoryTheory.CategoryStruct.comp U_sub.ι X.hom)
            (CategoryTheory.CategoryStruct.comp (P.homOfLE hW_sub) v_x)
            (weilGysinAffineOrigin k d) ∧
          CategoryTheory.CategoryStruct.comp ψ_sub
            (weilGysinAffineProjRight k d d (2 * d) (Nat.two_mul d).symm) =
            CategoryTheory.CategoryStruct.comp (P.homOfLE hW_sub) v_x) ∧
    ((∀ x : ↥X.left,
      ∃ (U_x : X.left.Opens) (V_x : P.Opens)
        (γ_x : Quiver.Hom U_x.toScheme V_x.toScheme)
        (p₁_Vx : Quiver.Hom V_x.toScheme U_x.toScheme)
        (u_x : Quiver.Hom U_x.toScheme (weilGysinAffineSpace k d))
        (v_x : Quiver.Hom V_x.toScheme (weilGysinAffineSpace k d))
        (Ψ_x : Quiver.Hom V_x.toScheme (weilGysinAffineSpace k (2 * d))),
        x ∈ U_x ∧
        WeilGysinIsTubularGraphChart d X Γ_φ U_x V_x γ_x p₁_Vx u_x v_x Ψ_x) →
      ∃ (m : ℕ)
        (V_ext : P.Opens)
        (U_c : Fin m → X.left.Opens)
        (V_c : Fin m → P.Opens)
        (γ_c : ∀ j : Fin m, Quiver.Hom (U_c j).toScheme (V_c j).toScheme)
        (p₁_Vc : ∀ j : Fin m, Quiver.Hom (V_c j).toScheme (U_c j).toScheme)
        (u_c : ∀ j : Fin m, Quiver.Hom (U_c j).toScheme (weilGysinAffineSpace k d))
        (v_c : ∀ j : Fin m, Quiver.Hom (V_c j).toScheme (weilGysinAffineSpace k d))
        (Ψ_c : ∀ j : Fin m, Quiver.Hom (V_c j).toScheme (weilGysinAffineSpace k (2 * d))),
        IsEmpty ↥(AlgebraicGeometry.Scheme.Opens.toScheme
          ((TopologicalSpace.Opens.map Γ_φ.base).obj V_ext)) ∧
        (∀ j : Fin m,
          WeilGysinIsTubularGraphChart d X Γ_φ
            (U_c j) (V_c j) (γ_c j) (p₁_Vc j) (u_c j) (v_c j) (Ψ_c j)) ∧
        (V_ext : Set P) ∪ (⋃ j : Fin m, (V_c j : Set P)) = Set.univ) ∧
    (∀ (U₁ : X.left.Opens) (V₁ : P.Opens)
      (γ₁ : Quiver.Hom U₁.toScheme V₁.toScheme)
      (p₁_V₁ : Quiver.Hom V₁.toScheme U₁.toScheme)
      (u₁ : Quiver.Hom U₁.toScheme (weilGysinAffineSpace k d))
      (v₁ : Quiver.Hom V₁.toScheme (weilGysinAffineSpace k d))
      (Ψ₁ : Quiver.Hom V₁.toScheme (weilGysinAffineSpace k (2 * d)))
      (U₂ : X.left.Opens) (V₂ : P.Opens)
      (γ₂ : Quiver.Hom U₂.toScheme V₂.toScheme)
      (p₁_V₂ : Quiver.Hom V₂.toScheme U₂.toScheme)
      (u₂ : Quiver.Hom U₂.toScheme (weilGysinAffineSpace k d))
      (v₂ : Quiver.Hom V₂.toScheme (weilGysinAffineSpace k d))
      (Ψ₂ : Quiver.Hom V₂.toScheme (weilGysinAffineSpace k (2 * d))),
      WeilGysinIsTubularGraphChart d X Γ_φ U₁ V₁ γ₁ p₁_V₁ u₁ v₁ Ψ₁ →
      WeilGysinIsTubularGraphChart d X Γ_φ U₂ V₂ γ₂ p₁_V₂ u₂ v₂ Ψ₂ →
      let V₁₂ : P.Opens := V₁ ⊓ V₂
      let U₁₂ : X.left.Opens := (TopologicalSpace.Opens.map Γ_φ.base).obj V₁₂
      Nonempty ↥U₁₂.toScheme →
      ConnectedSpace ↥U₁₂.toScheme ∧
      ∃ (s_z : Quiver.Hom S_k X.left)
        (U_star : X.left.Opens) (V_star : P.Opens) (hV_star : V_star ≤ V₁₂)
        (s_Ustar : Quiver.Hom S_k U_star.toScheme)
        (γ_star : Quiver.Hom U_star.toScheme V_star.toScheme)
        (g_Ustar : Quiver.Hom U_star.toScheme U₁₂.toScheme)
        (u'₁ u'₂ : Quiver.Hom U_star.toScheme (weilGysinAffineSpace k d))
        (Ψ'₁ Ψ'₂ : Quiver.Hom V_star.toScheme (weilGysinAffineSpace k (2 * d))),
        CategoryTheory.CategoryStruct.comp s_z X.hom = CategoryTheory.CategoryStruct.id S_k ∧
        CategoryTheory.IsPullback γ_star g_Ustar (P.homOfLE hV_star)
          (Γ_φ.resLE V₁₂ U₁₂ (le_refl _)) ∧
        WeilGysinIsEtaleOriginChart d X.hom s_z U_star s_Ustar u'₁ ∧
        WeilGysinIsEtaleOriginChart d X.hom s_z U_star s_Ustar u'₂ ∧
        WeilGysinIsEtaleOriginChart (2 * d)
          (CategoryTheory.CategoryStruct.comp p₁ X.hom)
          (CategoryTheory.CategoryStruct.comp s_z Γ_φ)
          V_star (CategoryTheory.CategoryStruct.comp s_Ustar γ_star) Ψ'₁ ∧
        WeilGysinIsEtaleOriginChart (2 * d)
          (CategoryTheory.CategoryStruct.comp p₁ X.hom)
          (CategoryTheory.CategoryStruct.comp s_z Γ_φ)
          V_star (CategoryTheory.CategoryStruct.comp s_Ustar γ_star) Ψ'₂ ∧
        CategoryTheory.IsPullback γ_star u'₁ Ψ'₁
          (weilGysinAffineLeftAxis k d d (2 * d) (Nat.two_mul d).symm) ∧
        CategoryTheory.IsPullback γ_star u'₂ Ψ'₂
          (weilGysinAffineLeftAxis k d d (2 * d) (Nat.two_mul d).symm) ∧
        CategoryTheory.CategoryStruct.comp Ψ'₁
          (weilGysinAffineProjRight k d d (2 * d) (Nat.two_mul d).symm) =
          CategoryTheory.CategoryStruct.comp (P.homOfLE (le_trans hV_star inf_le_left)) v₁ ∧
        CategoryTheory.CategoryStruct.comp Ψ'₂
          (weilGysinAffineProjRight k d d (2 * d) (Nat.two_mul d).symm) =
          CategoryTheory.CategoryStruct.comp (P.homOfLE (le_trans hV_star inf_le_right)) v₂) :=
by
  classical
  let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
  let P := CategoryTheory.Limits.pullback X.hom X.hom
  let p₁ := CategoryTheory.Limits.pullback.fst X.hom X.hom
  let Γ_φ := CategoryTheory.Limits.pullback.lift (CategoryTheory.CategoryStruct.id X.left) φ
    ((CategoryTheory.Category.id_comp X.hom).trans hφ.symm)

  have hFinCastCancel : ∀ {m n : ℕ} (h : m = n) (x : Fin m),
      Fin.cast h.symm (Fin.cast h x) = x :=
    fun _ _ => by ext; rfl

  have hPb_of_bot : ∀ {X₁ X₂ X₃ Y₁ Y₂ Y₃ : AlgebraicGeometry.Scheme.{u}}
      {t : Quiver.Hom X₁ Y₁} {l₁ : Quiver.Hom X₁ X₂} {r₁ : Quiver.Hom Y₁ Y₂}
      {m : Quiver.Hom X₂ Y₂} {l₂ : Quiver.Hom X₂ X₃} {r₂ : Y₂ ⟶ Y₃}
      {b : Quiver.Hom X₃ Y₃},
      CategoryTheory.IsPullback t (l₁ ≫ l₂) (r₁ ≫ r₂) b →
      t ≫ r₁ = l₁ ≫ m →
      CategoryTheory.IsPullback m l₂ r₂ b →
      CategoryTheory.IsPullback t l₁ r₁ m :=
    fun h_tot h_comm h_bot =>
      (CategoryTheory.IsPullback.of_right h_tot.flip h_comm.symm h_bot.flip).flip

  have hResLE_pb : ∀ {Z Y : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z Y) (W_sub : Y.Opens),
      let U_sub : Z.Opens := (TopologicalSpace.Opens.map f.base).obj W_sub
      CategoryTheory.IsPullback (f.resLE W_sub U_sub (le_refl _)) U_sub.ι W_sub.ι f := by
    intro Z Y f W_sub U_sub
    apply AlgebraicGeometry.IsOpenImmersion.isPullback (f.resLE W_sub U_sub (le_refl _))
      U_sub.ι W_sub.ι f
    · exact (AlgebraicGeometry.Scheme.Hom.resLE_comp_ι f (le_refl _)).symm
    · simp [AlgebraicGeometry.Scheme.Opens.opensRange_ι, U_sub]

  have hHomOfLE_comp : ∀ {Y : AlgebraicGeometry.Scheme.{u}} {U₁ U₂ U₃ : Y.Opens}
      (h₁ : U₁ ≤ U₂) (h₂ : U₂ ≤ U₃),
      Y.homOfLE h₁ ≫ Y.homOfLE h₂ = Y.homOfLE (le_trans h₁ h₂) := by
    intro Y U₁ U₂ U₃ h₁ h₂
    apply (inferInstance : CategoryTheory.Mono U₃.ι).right_cancellation
    rw [CategoryTheory.Category.assoc, Y.homOfLE_ι, Y.homOfLE_ι, Y.homOfLE_ι]

  have hSecOpen_pb : ∀ {Y : AlgebraicGeometry.Scheme.{u}}
      (s : Quiver.Hom S_k Y) (U : Y.Opens) (s_U : Quiver.Hom S_k U.toScheme),
      s_U ≫ U.ι = s →
      CategoryTheory.IsPullback s_U (𝟙 S_k) U.ι s := by
    intro Y s U s_U hs_U
    apply AlgebraicGeometry.IsOpenImmersion.isPullback s_U (𝟙 S_k) U.ι s
    · exact (CategoryTheory.Category.id_comp s).trans hs_U.symm
    · ext pt
      simp only [TopologicalSpace.Opens.map_obj, SetLike.mem_coe,
        AlgebraicGeometry.Scheme.Opens.opensRange_ι]
      change s.base pt ∈ U ↔ pt ∈ Set.range (CategoryTheory.CategoryStruct.id S_k).base
      have hmem : s.base pt ∈ U := by
        rw [← hs_U]
        exact (s_U.base pt).2
      exact ⟨fun _ => ⟨pt, rfl⟩, fun _ => hmem⟩

  have hMemHomOfLE : ∀ {Z : AlgebraicGeometry.Scheme.{u}} {U₁ U₂ : Z.Opens}
      (h : U₁ ≤ U₂) (z : ↥U₂.toScheme),
      z ∈ Set.range (Z.homOfLE h).base ↔ U₂.ι.base z ∈ (U₁ : Set ↥Z) := by
    intro Z U₁ U₂ h z
    constructor
    · rintro ⟨w, rfl⟩
      rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, Z.homOfLE_ι h, ← U₁.range_ι]
      exact ⟨w, rfl⟩
    · intro hz
      rw [← U₁.range_ι] at hz
      rcases hz with ⟨w, hw⟩
      refine ⟨w, U₂.ι.isOpenEmbedding.injective ?_⟩
      rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, Z.homOfLE_ι h, hw]

  have h0_cl : ∀ c : ℕ, AlgebraicGeometry.IsClosedImmersion (weilGysinAffineOrigin k c) := by
    intro c
    apply AlgebraicGeometry.IsClosedImmersion.spec_of_surjective
    intro r
    exact ⟨MvPolynomial.C r, MvPolynomial.eval_C r⟩

  have hAxis_cl : ∀ (a b ab : ℕ) (hab : a + b = ab),
      AlgebraicGeometry.IsClosedImmersion (weilGysinAffineLeftAxis k a b ab hab) := by
    intro a b ab hab
    apply AlgebraicGeometry.IsClosedImmersion.spec_of_surjective
    intro p
    refine ⟨MvPolynomial.rename (fun i : Fin a => Fin.cast hab (Fin.castAdd b i)) p, ?_⟩
    change ((MvPolynomial.eval₂Hom MvPolynomial.C
      (fun m : Fin ab => Fin.addCases (fun i : Fin a => MvPolynomial.X i)
        (fun _ : Fin b => 0) (Fin.cast hab.symm m))).comp
      (MvPolynomial.rename (fun i : Fin a => Fin.cast hab (Fin.castAdd b i))).toRingHom) p =
      RingHom.id (MvPolynomial (Fin a) k) p
    congr 1
    apply MvPolynomial.ringHom_ext
    · intro r
      simp
    · intro i
      simp only [RingHom.coe_comp, Function.comp_apply, AlgHom.toRingHom_eq_coe,
        RingHom.coe_coe, MvPolynomial.rename_X, MvPolynomial.eval₂Hom_X', RingHom.id_apply]
      rw [hFinCastCancel hab, Fin.addCases_left]

  have hpb_aff_axis : ∀ (a b ab : ℕ) (hab : a + b = ab),
      CategoryTheory.IsPullback (weilGysinAffineLeftAxis k a b ab hab)
        (weilGysinAffineStruct k a)
        (weilGysinAffineProjRight k a b ab hab)
        (weilGysinAffineOrigin k b) := by
    intro a b ab hab
    let f_ax_fn : MvPolynomial (Fin ab) k →+* MvPolynomial (Fin a) k :=
      MvPolynomial.eval₂Hom MvPolynomial.C
        (fun m : Fin ab => Fin.addCases (fun i : Fin a => MvPolynomial.X i)
          (fun _ : Fin b => 0) (Fin.cast hab.symm m))
    have hf_ax_X : ∀ m : Fin ab,
        f_ax_fn (MvPolynomial.X m) =
          Fin.addCases (fun i : Fin a => MvPolynomial.X i) (fun _ : Fin b => 0)
            (Fin.cast hab.symm m) :=
      MvPolynomial.eval₂Hom_X' _ _
    let f_ev0 : CommRingCat.of (MvPolynomial (Fin b) k) ⟶ CommRingCat.of k :=
      CommRingCat.ofHom (MvPolynomial.eval (0 : Fin b → k))
    let g_prR : CommRingCat.of (MvPolynomial (Fin b) k) ⟶
        CommRingCat.of (MvPolynomial (Fin ab) k) :=
      CommRingCat.ofHom
        (MvPolynomial.rename (fun j : Fin b => Fin.cast hab (Fin.natAdd a j))).toRingHom
    let inl_C : CommRingCat.of k ⟶ CommRingCat.of (MvPolynomial (Fin a) k) :=
      CommRingCat.ofHom MvPolynomial.C
    let inr_ax : CommRingCat.of (MvPolynomial (Fin ab) k) ⟶
        CommRingCat.of (MvPolynomial (Fin a) k) :=
      CommRingCat.ofHom f_ax_fn
    have h_ring_sq : f_ev0 ≫ inl_C = g_prR ≫ inr_ax := by
      dsimp [f_ev0, g_prR, inl_C, inr_ax]
      rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
      congr 1
      apply MvPolynomial.ringHom_ext
      · intro r
        simp [f_ax_fn]
      · intro j
        simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
          MvPolynomial.rename_X, MvPolynomial.eval_X, Pi.zero_apply, map_zero]
        rw [hf_ax_X, hFinCastCancel hab, Fin.addCases_right]
    let desc_fn (s : CategoryTheory.Limits.PushoutCocone f_ev0 g_prR) :
        MvPolynomial (Fin a) k →+* ↑s.pt :=
      MvPolynomial.eval₂Hom s.inl.hom
        (fun i : Fin a => s.inr.hom (MvPolynomial.X (Fin.cast hab (Fin.castAdd b i))))
    have hdesc_X : ∀ (s : CategoryTheory.Limits.PushoutCocone f_ev0 g_prR) (i : Fin a),
        desc_fn s (MvPolynomial.X i) =
          s.inr.hom (MvPolynomial.X (Fin.cast hab (Fin.castAdd b i))) :=
      fun _ => MvPolynomial.eval₂Hom_X' _ _
    have h_push : CategoryTheory.IsPushout f_ev0 g_prR inl_C inr_ax := by
      refine CategoryTheory.IsPushout.of_isColimit
        (CategoryTheory.Limits.PushoutCocone.IsColimit.mk h_ring_sq
          (fun s => CommRingCat.ofHom (desc_fn s)) ?_ ?_ ?_)
      · intro s
        apply CommRingCat.hom_ext
        ext r
        simp [inl_C, desc_fn]
      · intro s
        dsimp [inr_ax]
        rw [← CommRingCat.ofHom_comp]
        apply CommRingCat.hom_ext
        apply MvPolynomial.ringHom_ext
        · intro r
          have hcond := congrArg (fun φ => φ.hom (MvPolynomial.C r)) s.condition
          simpa [f_ev0, g_prR, f_ax_fn, desc_fn] using hcond
        · intro m
          let m' : Fin (a + b) := Fin.cast hab.symm m
          have hm : m = Fin.cast hab m' := by ext; simp [m']
          rw [hm]
          refine Fin.addCases (fun i => ?_) (fun j => ?_) m'
          · simp only [CommRingCat.hom_ofHom, RingHom.comp_apply]
            rw [hf_ax_X, hFinCastCancel hab, Fin.addCases_left, hdesc_X]
          · have hcond := congrArg (fun φ => φ.hom (MvPolynomial.X j)) s.condition
            have h0 : s.inr.hom (MvPolynomial.X (Fin.cast hab (Fin.natAdd a j))) = 0 := by
              simpa [f_ev0, g_prR] using hcond.symm
            simp only [CommRingCat.hom_ofHom, RingHom.comp_apply]
            rw [hf_ax_X, hFinCastCancel hab, Fin.addCases_right, map_zero, h0]
      · intro s m_hom hm₁ hm₂
        apply CommRingCat.hom_ext
        apply MvPolynomial.ringHom_ext
        · intro r
          have h1 := congrArg (fun φ => φ.hom r) hm₁
          simpa [inl_C, desc_fn] using h1
        · intro i
          have h2 := congrArg
            (fun φ => φ.hom (MvPolynomial.X (Fin.cast hab (Fin.castAdd b i)))) hm₂
          simp only [inr_ax, CommRingCat.hom_comp, CommRingCat.hom_ofHom,
            RingHom.comp_apply] at h2
          rw [hf_ax_X, hFinCastCancel hab, Fin.addCases_left] at h2
          exact h2.trans (hdesc_X s i).symm
    exact CategoryTheory.Functor.map_isPullback AlgebraicGeometry.Scheme.Spec h_push.op

  have horig_axis : ∀ (a b ab : ℕ) (hab : a + b = ab),
      weilGysinAffineOrigin k a ≫ weilGysinAffineLeftAxis k a b ab hab =
        weilGysinAffineOrigin k ab := by
    intro a b ab hab
    let f_ax_fn : MvPolynomial (Fin ab) k →+* MvPolynomial (Fin a) k :=
      MvPolynomial.eval₂Hom MvPolynomial.C
        (fun m : Fin ab => Fin.addCases (fun i : Fin a => MvPolynomial.X i)
          (fun _ : Fin b => 0) (Fin.cast hab.symm m))
    have hf_ax_X : ∀ m : Fin ab,
        f_ax_fn (MvPolynomial.X m) =
          Fin.addCases (fun i : Fin a => MvPolynomial.X i) (fun _ : Fin b => 0)
            (Fin.cast hab.symm m) :=
      MvPolynomial.eval₂Hom_X' _ _
    refine (AlgebraicGeometry.Spec.map_comp _ _).symm.trans (congrArg AlgebraicGeometry.Spec.map ?_)
    change CommRingCat.ofHom f_ax_fn ≫ CommRingCat.ofHom (MvPolynomial.eval 0) =
      CommRingCat.ofHom (MvPolynomial.eval 0)
    rw [← CommRingCat.ofHom_comp]
    congr 1
    apply MvPolynomial.ringHom_ext
    · intro r
      simp [f_ax_fn]
    · intro m
      let m' : Fin (a + b) := Fin.cast hab.symm m
      have hm : m = Fin.cast hab m' := by ext; simp [m']
      rw [hm]
      refine Fin.addCases (fun i => ?_) (fun j => ?_) m'
      · simp only [RingHom.comp_apply, MvPolynomial.eval_X, Pi.zero_apply]
        rw [hf_ax_X, hFinCastCancel hab, Fin.addCases_left]
        simp
      · simp only [RingHom.comp_apply, MvPolynomial.eval_X, Pi.zero_apply]
        rw [hf_ax_X, hFinCastCancel hab, Fin.addCases_right]
        simp

  have hShrink : ∀ (c : ℕ) {Y : AlgebraicGeometry.Scheme.{u}}
      (p_Y : Quiver.Hom Y S_k) (s : Quiver.Hom S_k Y)
      (V₀ : Y.Opens) (s_V₀ : Quiver.Hom S_k V₀.toScheme),
      s_V₀ ≫ V₀.ι = s →
      ∀ (u₀ : Quiver.Hom V₀.toScheme (weilGysinAffineSpace k c)),
        AlgebraicGeometry.Etale u₀ →
        u₀ ≫ weilGysinAffineStruct k c = V₀.ι ≫ p_Y →
        s_V₀ ≫ u₀ = weilGysinAffineOrigin k c →
        ∃ (U : Y.Opens) (hle : U ≤ V₀) (s_U : Quiver.Hom S_k U.toScheme),
          WeilGysinIsEtaleOriginChart c p_Y s U s_U (Y.homOfLE hle ≫ u₀) := by
    intro c Y p_Y s V₀ s_V₀ hs_V₀ u₀ hu₀_et hu₀_str hs_u₀
    let orig := weilGysinAffineOrigin k c
    haveI : AlgebraicGeometry.Etale u₀ := hu₀_et
    haveI : AlgebraicGeometry.IsClosedImmersion orig := h0_cl c
    let F₀ := CategoryTheory.Limits.pullback u₀ orig
    let π₁ := CategoryTheory.Limits.pullback.fst u₀ orig
    let π₂ := CategoryTheory.Limits.pullback.snd u₀ orig
    let σ₀ : S_k ⟶ F₀ :=
      CategoryTheory.Limits.pullback.lift s_V₀ (𝟙 S_k)
        (hs_u₀.trans (CategoryTheory.Category.id_comp orig).symm)
    have hσ₀_π₁ : σ₀ ≫ π₁ = s_V₀ := CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hσ₀_π₂ : σ₀ ≫ π₂ = 𝟙 S_k := CategoryTheory.Limits.pullback.lift_snd _ _ _
    let Δ_F := CategoryTheory.Limits.pullback.diagonal π₂
    have h_gF_cond : 𝟙 F₀ ≫ π₂ = (π₂ ≫ σ₀) ≫ π₂ := by
      rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc, hσ₀_π₂,
        CategoryTheory.Category.comp_id]
    let g_F := CategoryTheory.Limits.pullback.lift (𝟙 F₀) (π₂ ≫ σ₀) h_gF_cond
    have h_σ0_sq : σ₀ ≫ Δ_F = σ₀ ≫ g_F := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · dsimp [Δ_F, g_F]
        rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.diagonal_fst,
          CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst]
      · dsimp [Δ_F, g_F]
        rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.diagonal_snd,
          CategoryTheory.Category.comp_id, CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.lift_snd, ← CategoryTheory.Category.assoc,
          hσ₀_π₂, CategoryTheory.Category.id_comp]
    have hpb_σ : CategoryTheory.IsPullback σ₀ σ₀ Δ_F g_F := by
      refine CategoryTheory.IsPullback.of_isLimit
        (CategoryTheory.Limits.PullbackCone.IsLimit.mk h_σ0_sq (fun cone => cone.snd ≫ π₂)
          ?_ ?_ ?_)
      · intro cone
        have hq₂ := congrArg (fun h => h ≫ CategoryTheory.Limits.pullback.snd π₂ π₂) cone.condition
        simp only [CategoryTheory.Category.assoc, Δ_F, g_F,
          CategoryTheory.Limits.pullback.diagonal_snd,
          CategoryTheory.Limits.pullback.lift_snd,
          CategoryTheory.Category.comp_id] at hq₂
        exact hq₂.symm
      · intro cone
        have hq₁ := congrArg (fun h => h ≫ CategoryTheory.Limits.pullback.fst π₂ π₂) cone.condition
        have hq₂ := congrArg (fun h => h ≫ CategoryTheory.Limits.pullback.snd π₂ π₂) cone.condition
        simp only [CategoryTheory.Category.assoc, Δ_F, g_F,
          CategoryTheory.Limits.pullback.diagonal_fst,
          CategoryTheory.Limits.pullback.diagonal_snd,
          CategoryTheory.Limits.pullback.lift_fst,
          CategoryTheory.Limits.pullback.lift_snd,
          CategoryTheory.Category.comp_id] at hq₁ hq₂
        exact hq₂.symm.trans hq₁
      · intro cone m _ hm₂
        calc
          m = m ≫ 𝟙 S_k := (CategoryTheory.Category.comp_id m).symm
          _ = m ≫ (σ₀ ≫ π₂) := by rw [hσ₀_π₂]
          _ = (m ≫ σ₀) ≫ π₂ := (CategoryTheory.Category.assoc m σ₀ π₂).symm
          _ = cone.snd ≫ π₂ := by rw [hm₂]
    haveI : AlgebraicGeometry.IsOpenImmersion σ₀ :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_σ
        (AlgebraicGeometry.FormallyUnramified.isOpenImmersion_diagonal π₂)
    let K_spur : Set ↥F₀ := (Set.range σ₀.base)ᶜ
    have hK_closed : IsClosed K_spur := σ₀.isOpenEmbedding.isOpen_range.isClosed_compl
    let C_spur : Set ↥V₀.toScheme := π₁.base '' K_spur
    have hC_closed : IsClosed C_spur := π₁.isClosedEmbedding.isClosedMap K_spur hK_closed
    let W_set : Set ↥V₀.toScheme := C_spurᶜ
    have hW_open : IsOpen W_set := hC_closed.isOpen_compl
    let U : Y.Opens := ⟨V₀.ι.base '' W_set, V₀.ι.isOpenEmbedding.isOpenMap W_set hW_open⟩
    have hle : U ≤ V₀ := by
      rintro y ⟨z, _, rfl⟩
      change V₀.ι.base z ∈ (V₀ : Set ↥Y)
      rw [← V₀.range_ι]
      exact ⟨z, rfl⟩
    let j : U.toScheme ⟶ V₀.toScheme := Y.homOfLE hle
    have hz_j : ∀ z : ↥V₀.toScheme, z ∈ j.opensRange ↔ z ∈ W_set := by
      intro z
      change z ∈ Set.range j.base ↔ z ∈ W_set
      rw [hMemHomOfLE hle z]
      exact V₀.ι.isOpenEmbedding.injective.mem_set_image
    have hs_range : Set.range s.base ⊆ Set.range U.ι.base := by
      rw [U.range_ι]
      rintro _ ⟨pt, rfl⟩
      have h_eq : s.base pt = V₀.ι.base (π₁.base (σ₀.base pt)) := by
        rw [← hs_V₀, ← hσ₀_π₁]
        rfl
      rw [h_eq]
      refine ⟨π₁.base (σ₀.base pt), ?_, rfl⟩
      intro hmem_C
      have hmem_K : σ₀.base pt ∈ K_spur :=
        (π₁.isClosedEmbedding.injective.mem_set_image).mp hmem_C
      exact hmem_K ⟨pt, rfl⟩
    let s_U : S_k ⟶ U.toScheme := AlgebraicGeometry.IsOpenImmersion.lift U.ι s hs_range
    have hs_U_ι : s_U ≫ U.ι = s := AlgebraicGeometry.IsOpenImmersion.lift_fac U.ι s hs_range
    have h_comm_top : σ₀ ≫ π₁ = s_U ≫ j := by
      apply (inferInstance : CategoryTheory.Mono V₀.ι).right_cancellation
      rw [hσ₀_π₁, hs_V₀, CategoryTheory.Category.assoc, Y.homOfLE_ι hle, hs_U_ι]
    have h_opens : (TopologicalSpace.Opens.map π₁.base).obj j.opensRange = σ₀.opensRange := by
      ext q
      change π₁.base q ∈ j.opensRange ↔ q ∈ Set.range σ₀.base
      rw [hz_j]
      change ¬ (π₁.base q ∈ π₁.base '' (Set.range σ₀.base)ᶜ) ↔ q ∈ Set.range σ₀.base
      rw [π₁.isClosedEmbedding.injective.mem_set_image, Set.mem_compl_iff, not_not]
    have hpb_top : CategoryTheory.IsPullback s_U σ₀ j π₁ :=
      AlgebraicGeometry.IsOpenImmersion.isPullback s_U σ₀ j π₁ h_comm_top h_opens
    have hpb_u : CategoryTheory.IsPullback s_U (𝟙 S_k) (j ≫ u₀) orig := by
      have hp := CategoryTheory.IsPullback.paste_vert hpb_top
        (CategoryTheory.IsPullback.of_hasPullback u₀ orig)
      rwa [hσ₀_π₂] at hp
    refine ⟨U, hle, s_U, ⟨inferInstance, ?_, hs_U_ι, hpb_u⟩⟩
    rw [CategoryTheory.Category.assoc, hu₀_str, ← CategoryTheory.Category.assoc, Y.homOfLE_ι hle]

  have hP_int : AlgebraicGeometry.IsIntegral P := by
    haveI : AlgebraicGeometry.IsIntegral X.left := hInt
    have hTensorDom : ∀ (A B : Type u) [CommRing A] [IsDomain A] [Algebra k A]
        [CommRing B] [IsDomain B] [Algebra k B],
        IsDomain (TensorProduct k A B) := by
      intro A B _ _ _ _ _ _
      let b_B := Module.Basis.ofVectorSpace k B
      let ι := ↥(Module.Basis.ofVectorSpaceIndex k B)
      let b_AB : Module.Basis ι A (TensorProduct k A B) := Algebra.TensorProduct.basis A b_B
      have hNontriv : Nontrivial (TensorProduct k A B) := by
        obtain ⟨i_star⟩ : Nonempty ι := b_B.index_nonempty
        refine ⟨⟨b_AB i_star, 0, fun h0 => ?_⟩⟩
        have h1 : (b_AB.repr (b_AB i_star)) i_star = (b_AB.repr 0) i_star := by rw [h0]
        simp only [Module.Basis.repr_self, Finsupp.single_eq_same, map_zero,
          Finsupp.coe_zero, Pi.zero_apply, one_ne_zero] at h1
      letI : Nontrivial (TensorProduct k A B) := hNontriv
      suffices hNoZero : NoZeroDivisors (TensorProduct k A B) by
        exact @NoZeroDivisors.to_isDomain (TensorProduct k A B) _ hNontriv hNoZero
      refine ⟨fun {x y} hxy => ?_⟩
      by_contra h_not
      push_neg at h_not
      rcases h_not with ⟨hx, hy⟩
      let cx : ι →₀ A := b_AB.repr x
      let cy : ι →₀ A := b_AB.repr y
      have hcx_ne : cx ≠ 0 := fun h => hx (b_AB.repr.injective (h.trans (map_zero _).symm))
      have hcy_ne : cy ≠ 0 := fun h => hy (b_AB.repr.injective (h.trans (map_zero _).symm))
      obtain ⟨i₀, hi₀⟩ := Finsupp.support_nonempty_iff.mpr hcx_ne
      obtain ⟨j₀, hj₀⟩ := Finsupp.support_nonempty_iff.mpr hcy_ne
      have hx_sum : x = ∑ i ∈ cx.support, TensorProduct.tmul k (cx i) (b_B i) := by
        conv_lhs => rw [← b_AB.linearCombination_repr x]
        rw [Finsupp.linearCombination_apply]
        change (∑ i ∈ cx.support, cx i • b_AB i) = _
        apply Finset.sum_congr rfl
        intro i _
        rw [Algebra.TensorProduct.basis_apply, Algebra.smul_def]
        change TensorProduct.tmul k (cx i) (1 : B) * TensorProduct.tmul k (1 : A) (b_B i) = _
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      have hy_sum : y = ∑ j ∈ cy.support, TensorProduct.tmul k (cy j) (b_B j) := by
        conv_lhs => rw [← b_AB.linearCombination_repr y]
        rw [Finsupp.linearCombination_apply]
        change (∑ j ∈ cy.support, cy j • b_AB j) = _
        apply Finset.sum_congr rfl
        intro j _
        rw [Algebra.TensorProduct.basis_apply, Algebra.smul_def]
        change TensorProduct.tmul k (cy j) (1 : B) * TensorProduct.tmul k (1 : A) (b_B j) = _
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      let S : Finset A := cx.support.image cx ∪ cy.support.image cy
      let A₀ : Subalgebra k A := Algebra.adjoin k (↑S : Set A)
      have hA₀_ft : Algebra.FiniteType k ↥A₀ := Algebra.FiniteType.adjoin_of_finite S.finite_toSet
      have hcx_mem : ∀ i ∈ cx.support, cx i ∈ A₀ := fun i hi =>
        Algebra.subset_adjoin
          (Finset.mem_coe.mpr (Finset.mem_union_left _ (Finset.mem_image_of_mem cx hi)))
      have hcy_mem : ∀ j ∈ cy.support, cy j ∈ A₀ := fun j hj =>
        Algebra.subset_adjoin
          (Finset.mem_coe.mpr (Finset.mem_union_right _ (Finset.mem_image_of_mem cy hj)))
      let x₀ : TensorProduct k ↥A₀ B :=
        ∑ i ∈ cx.support.attach, TensorProduct.tmul k (⟨cx i.1, hcx_mem i.1 i.2⟩ : ↥A₀) (b_B i.1)
      let y₀ : TensorProduct k ↥A₀ B :=
        ∑ j ∈ cy.support.attach, TensorProduct.tmul k (⟨cy j.1, hcy_mem j.1 j.2⟩ : ↥A₀) (b_B j.1)
      let Φ : TensorProduct k ↥A₀ B →ₐ[k] TensorProduct k A B :=
        Algebra.TensorProduct.map A₀.val (AlgHom.id k B)
      have hΦ_x : Φ x₀ = x := by
        dsimp [x₀, Φ]
        rw [map_sum, hx_sum, ← Finset.sum_attach cx.support]
        exact Finset.sum_congr rfl (fun _ _ => rfl)
      have hΦ_y : Φ y₀ = y := by
        dsimp [y₀, Φ]
        rw [map_sum, hy_sum, ← Finset.sum_attach cy.support]
        exact Finset.sum_congr rfl (fun _ _ => rfl)
      have hΦ_eq_rTensor : Φ.toLinearMap = LinearMap.rTensor B A₀.val.toLinearMap := by
        apply TensorProduct.ext'
        intro a b
        rfl
      have hΦ_inj : Function.Injective Φ := by
        change Function.Injective Φ.toLinearMap
        rw [hΦ_eq_rTensor]
        exact Module.Flat.rTensor_preserves_injective_linearMap A₀.val.toLinearMap
          Subtype.val_injective
      have hx₀y₀ : x₀ * y₀ = 0 := hΦ_inj (by rw [map_mul, hΦ_x, hΦ_y, hxy, map_zero])
      let ax : ↥A₀ := ⟨cx i₀, hcx_mem i₀ hi₀⟩
      let ay : ↥A₀ := ⟨cy j₀, hcy_mem j₀ hj₀⟩
      have hax_ne : ax ≠ 0 := fun h => (Finsupp.mem_support_iff.mp hi₀) (congrArg Subtype.val h)
      have hay_ne : ay ≠ 0 := fun h => (Finsupp.mem_support_iff.mp hj₀) (congrArg Subtype.val h)
      let g : ↥A₀ := ax * ay
      have hg_ne : g ≠ 0 := mul_ne_zero hax_ne hay_ne
      haveI : IsJacobsonRing ↥A₀ := isJacobsonRing_of_finiteType (A := k) (B := ↥A₀)
      have h_jac : (⊥ : Ideal ↥A₀).jacobson = ⊥ :=
        IsJacobsonRing.out' (I := (⊥ : Ideal ↥A₀)) Ideal.isRadical_bot_of_noZeroDivisors
      have hex_M : ∃ M : Ideal ↥A₀, M.IsMaximal ∧ g ∉ M := by
        by_contra h_no
        push_neg at h_no
        apply hg_ne
        rw [← Ideal.mem_bot, ← h_jac, Ideal.mem_jacobson_iff]
        intro y
        have h_unit : IsUnit (1 + y * g) := by
          by_contra hnu
          have hne_top : Ideal.span ({1 + y * g} : Set ↥A₀) ≠ ⊤ :=
            mt Ideal.span_singleton_eq_top.mp hnu
          obtain ⟨M, hM_max, hle_M⟩ := Ideal.exists_le_maximal _ hne_top
          have h1_mem : (1 : ↥A₀) + y * g ∈ M := hle_M (Ideal.subset_span rfl)
          have hg_mem : g ∈ M := h_no M hM_max
          have h_one : (1 : ↥A₀) ∈ M := by
            have hsub := M.sub_mem h1_mem (M.mul_mem_left y hg_mem)
            rwa [add_sub_cancel_right] at hsub
          exact hM_max.ne_top (M.eq_top_of_isUnit_mem h_one isUnit_one)
        rcases h_unit.exists_left_inv with ⟨z, hz⟩
        refine ⟨z, ?_⟩
        rw [Ideal.mem_bot]
        calc
          z * y * g + z - 1 = z * (1 + y * g) - 1 := by ring
          _ = 1 - 1 := by rw [hz]
          _ = 0 := sub_self 1
      rcases hex_M with ⟨M, hM_max, hg_M⟩
      haveI : M.IsMaximal := hM_max
      letI : Field (↥A₀ ⧸ M) := Ideal.Quotient.field M
      let π_M : ↥A₀ →+* (↥A₀ ⧸ M) := Ideal.Quotient.mk M
      let f₀ : k →+* ↥A₀ := algebraMap k ↥A₀
      have hf₀_ft : f₀.FiniteType := RingHom.finiteType_algebraMap.mpr hA₀_ft
      have hcomp_ft : (π_M.comp f₀).FiniteType :=
        (RingHom.FiniteType.of_surjective π_M Ideal.Quotient.mk_surjective).comp hf₀_ft
      have hcomp_fin : (π_M.comp f₀).Finite :=
        RingHom.finite_iff_finiteType_of_isJacobsonRing.mpr hcomp_ft
      have hcomp_int : (π_M.comp f₀).IsIntegral := RingHom.IsIntegral.of_finite hcomp_fin
      have hcomp_bij : Function.Bijective (π_M.comp f₀) :=
        IsAlgClosed.ringHom_bijective_of_isIntegral (π_M.comp f₀) hcomp_int
      let e_M : k ≃+* (↥A₀ ⧸ M) := RingEquiv.ofBijective (π_M.comp f₀) hcomp_bij
      let χ : ↥A₀ →ₐ[k] k :=
        { toRingHom := e_M.symm.toRingHom.comp π_M
          commutes' := fun r => e_M.symm_apply_apply r }
      have hχ_g : χ g ≠ 0 := by
        intro h0
        have hπ0 : π_M g = 0 := e_M.symm.injective (h0.trans (map_zero _).symm)
        exact hg_M (Ideal.Quotient.eq_zero_iff_mem.mp hπ0)
      have hχ_ax : χ ax ≠ 0 := left_ne_zero_of_mul (by rwa [← map_mul])
      have hχ_ay : χ ay ≠ 0 := right_ne_zero_of_mul (by rwa [← map_mul])
      let Ψ : TensorProduct k ↥A₀ B →ₐ[k] B :=
        (Algebra.TensorProduct.lid k B).toAlgHom.comp (Algebra.TensorProduct.map χ (AlgHom.id k B))
      have hΨ_x₀_val : Ψ x₀ =
          ∑ i ∈ cx.support.attach, χ ⟨cx i.1, hcx_mem i.1 i.2⟩ • b_B i.1 := by
        dsimp [x₀, Ψ]
        rw [map_sum, map_sum]
        apply Finset.sum_congr rfl
        intro i _
        simp
      have hΨ_y₀_val : Ψ y₀ =
          ∑ j ∈ cy.support.attach, χ ⟨cy j.1, hcy_mem j.1 j.2⟩ • b_B j.1 := by
        dsimp [y₀, Ψ]
        rw [map_sum, map_sum]
        apply Finset.sum_congr rfl
        intro j _
        simp
      have hΨ_x₀ : (b_B.repr (Ψ x₀)) i₀ = χ ax := by
        rw [hΨ_x₀_val, map_sum, Finsupp.finset_sum_apply, Finset.sum_eq_single ⟨i₀, hi₀⟩]
        · simp [ax]
        · rintro ⟨i, hi⟩ _ hne
          have hi_ne : i ≠ i₀ := fun heq => hne (Subtype.ext heq)
          simp [Finsupp.single_apply, hi_ne]
        · intro h_abs
          exact absurd (Finset.mem_attach _ ⟨i₀, hi₀⟩) h_abs
      have hΨ_y₀ : (b_B.repr (Ψ y₀)) j₀ = χ ay := by
        rw [hΨ_y₀_val, map_sum, Finsupp.finset_sum_apply, Finset.sum_eq_single ⟨j₀, hj₀⟩]
        · simp [ay]
        · rintro ⟨j, hj⟩ _ hne
          have hj_ne : j ≠ j₀ := fun heq => hne (Subtype.ext heq)
          simp [Finsupp.single_apply, hj_ne]
        · intro h_abs
          exact absurd (Finset.mem_attach _ ⟨j₀, hj₀⟩) h_abs
      have hΨx_ne : Ψ x₀ ≠ 0 :=
        fun h => hχ_ax (by rw [← hΨ_x₀, h, map_zero, Finsupp.coe_zero, Pi.zero_apply])
      have hΨy_ne : Ψ y₀ ≠ 0 :=
        fun h => hχ_ay (by rw [← hΨ_y₀, h, map_zero, Finsupp.coe_zero, Pi.zero_apply])
      exact mul_ne_zero hΨx_ne hΨy_ne (by rw [← map_mul, hx₀y₀, map_zero])
    let 𝒰 := X.left.affineCover
    let 𝒰_P := AlgebraicGeometry.Scheme.Pullback.openCoverOfLeftRight 𝒰 𝒰 X.hom X.hom
    have hChartInt : ∀ (i j : 𝒰.I₀), Nonempty ↥(𝒰.X i) → Nonempty ↥(𝒰.X j) →
        AlgebraicGeometry.IsIntegral (𝒰_P.X (i, j)) := by
      intro i j hi hj
      haveI : Nonempty ↥(𝒰.X i) := hi
      haveI : Nonempty ↥(𝒰.X j) := hj
      haveI : AlgebraicGeometry.IsIntegral (𝒰.X i) :=
        AlgebraicGeometry.isIntegral_of_isOpenImmersion (𝒰.f i)
      haveI : AlgebraicGeometry.IsIntegral (𝒰.X j) :=
        AlgebraicGeometry.isIntegral_of_isOpenImmersion (𝒰.f j)
      let R₁ : CommRingCat.{u} := (𝒰.X i).presheaf.obj (Opposite.op ⊤)
      let R₂ : CommRingCat.{u} := (𝒰.X j).presheaf.obj (Opposite.op ⊤)
      let e₁ := (𝒰.X i).isoSpec
      let e₂ := (𝒰.X j).isoSpec
      haveI : Nonempty ↥(AlgebraicGeometry.Spec R₁) := ⟨e₁.hom.base (Classical.choice hi)⟩
      haveI : Nonempty ↥(AlgebraicGeometry.Spec R₂) := ⟨e₂.hom.base (Classical.choice hj)⟩
      haveI : AlgebraicGeometry.IsIntegral (AlgebraicGeometry.Spec R₁) :=
        AlgebraicGeometry.isIntegral_of_isOpenImmersion e₁.inv
      haveI : AlgebraicGeometry.IsIntegral (AlgebraicGeometry.Spec R₂) :=
        AlgebraicGeometry.isIntegral_of_isOpenImmersion e₂.inv
      haveI : IsDomain ↑R₁ := (AlgebraicGeometry.affine_isIntegral_iff R₁).mp inferInstance
      haveI : IsDomain ↑R₂ := (AlgebraicGeometry.affine_isIntegral_iff R₂).mp inferInstance
      let φ₁ : CommRingCat.of k ⟶ R₁ :=
        AlgebraicGeometry.Spec.preimage (e₁.inv ≫ (𝒰.f i) ≫ X.hom)
      let φ₂ : CommRingCat.of k ⟶ R₂ :=
        AlgebraicGeometry.Spec.preimage (e₂.inv ≫ (𝒰.f j) ≫ X.hom)
      have hφ₁ : AlgebraicGeometry.Spec.map φ₁ = e₁.inv ≫ (𝒰.f i) ≫ X.hom :=
        AlgebraicGeometry.Spec.map_preimage _
      have hφ₂ : AlgebraicGeometry.Spec.map φ₂ = e₂.inv ≫ (𝒰.f j) ≫ X.hom :=
        AlgebraicGeometry.Spec.map_preimage _
      letI : Algebra k ↑R₁ := φ₁.hom.toAlgebra
      letI : Algebra k ↑R₂ := φ₂.hom.toAlgebra
      haveI : IsDomain (TensorProduct k ↑R₁ ↑R₂) := hTensorDom ↑R₁ ↑R₂
      haveI : AlgebraicGeometry.IsIntegral
          (AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct k ↑R₁ ↑R₂))) :=
        (AlgebraicGeometry.affine_isIntegral_iff
          (CommRingCat.of (TensorProduct k ↑R₁ ↑R₂))).mpr inferInstance
      let Q_ij := CategoryTheory.Limits.pullback ((𝒰.f i) ≫ X.hom) ((𝒰.f j) ≫ X.hom)
      let e_pull : Q_ij ≅ CategoryTheory.Limits.pullback
          (AlgebraicGeometry.Spec.map φ₁) (AlgebraicGeometry.Spec.map φ₂) :=
        { hom := CategoryTheory.Limits.pullback.lift
            (CategoryTheory.Limits.pullback.fst _ _ ≫ e₁.hom)
            (CategoryTheory.Limits.pullback.snd _ _ ≫ e₂.hom)
            (by rw [CategoryTheory.Category.assoc, hφ₁, ← CategoryTheory.Category.assoc e₁.hom,
                  e₁.hom_inv_id, CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc,
                  hφ₂, ← CategoryTheory.Category.assoc e₂.hom, e₂.hom_inv_id,
                  CategoryTheory.Category.id_comp, CategoryTheory.Limits.pullback.condition])
          inv := CategoryTheory.Limits.pullback.lift
            (CategoryTheory.Limits.pullback.fst _ _ ≫ e₁.inv)
            (CategoryTheory.Limits.pullback.snd _ _ ≫ e₂.inv)
            (by rw [CategoryTheory.Category.assoc, ← hφ₁, CategoryTheory.Category.assoc, ← hφ₂,
                  CategoryTheory.Limits.pullback.condition])
          hom_inv_id := by
            apply CategoryTheory.Limits.pullback.hom_ext
            · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
                ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
                CategoryTheory.Category.assoc, e₁.hom_inv_id, CategoryTheory.Category.comp_id,
                CategoryTheory.Category.id_comp]
            · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
                ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
                CategoryTheory.Category.assoc, e₂.hom_inv_id, CategoryTheory.Category.comp_id,
                CategoryTheory.Category.id_comp]
          inv_hom_id := by
            apply CategoryTheory.Limits.pullback.hom_ext
            · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
                ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
                CategoryTheory.Category.assoc, e₁.inv_hom_id, CategoryTheory.Category.comp_id,
                CategoryTheory.Category.id_comp]
            · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
                ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
                CategoryTheory.Category.assoc, e₂.inv_hom_id, CategoryTheory.Category.comp_id,
                CategoryTheory.Category.id_comp] }
      let e_ij : Q_ij ≅ AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct k ↑R₁ ↑R₂)) :=
        e_pull ≪≫ AlgebraicGeometry.pullbackSpecIso k ↑R₁ ↑R₂
      haveI : Nonempty ↥Q_ij :=
        ⟨e_ij.inv.base (Classical.choice (AlgebraicGeometry.IsIntegral.nonempty))⟩
      have hQ_int : AlgebraicGeometry.IsIntegral Q_ij :=
        AlgebraicGeometry.isIntegral_of_isOpenImmersion e_ij.hom
      exact hQ_int
    haveI : ∀ ij : 𝒰_P.I₀, AlgebraicGeometry.IsReduced (𝒰_P.X ij) := by
      rintro ⟨i, j⟩
      by_cases hne : Nonempty ↥(𝒰.X i) ∧ Nonempty ↥(𝒰.X j)
      · haveI : AlgebraicGeometry.IsIntegral (𝒰_P.X (i, j)) :=
          hChartInt i j hne.1 hne.2
        infer_instance
      · have hEmp : IsEmpty ↥(𝒰_P.X (i, j)) := by
          refine ⟨fun u => hne ?_⟩
          let q : ↥(CategoryTheory.Limits.pullback ((𝒰.f i) ≫ X.hom) ((𝒰.f j) ≫ X.hom)) := u
          exact ⟨⟨(CategoryTheory.Limits.pullback.fst ((𝒰.f i) ≫ X.hom) ((𝒰.f j) ≫ X.hom)).base q⟩,
            ⟨(CategoryTheory.Limits.pullback.snd ((𝒰.f i) ≫ X.hom) ((𝒰.f j) ≫ X.hom)).base q⟩⟩
        haveI : ∀ x : ↥(𝒰_P.X (i, j)), _root_.IsReduced ↑((𝒰_P.X (i, j)).presheaf.stalk x) :=
          fun x => hEmp.elim x
        exact AlgebraicGeometry.isReduced_of_isReduced_stalk (𝒰_P.X (i, j))
    haveI : AlgebraicGeometry.IsReduced P := AlgebraicGeometry.IsReduced.of_openCover P 𝒰_P
    let p₂ := CategoryTheory.Limits.pullback.snd X.hom X.hom
    have hMemRange : ∀ (i j : 𝒰.I₀) (q : ↥P),
        p₁.base q ∈ Set.range (𝒰.f i).base →
        p₂.base q ∈ Set.range (𝒰.f j).base →
        q ∈ Set.range (𝒰_P.f (i, j)).base := by
      intro i j q hq₁ hq₂
      let κ_q := P.fromSpecResidueField q
      have hκ_r₁ : Set.range (κ_q ≫ p₁).base ⊆ Set.range (𝒰.f i).base := by
        rintro _ ⟨s, rfl⟩
        change p₁.base (κ_q.base s) ∈ Set.range (𝒰.f i).base
        rw [AlgebraicGeometry.Scheme.fromSpecResidueField_apply q s]
        exact hq₁
      have hκ_r₂ : Set.range (κ_q ≫ p₂).base ⊆ Set.range (𝒰.f j).base := by
        rintro _ ⟨s, rfl⟩
        change p₂.base (κ_q.base s) ∈ Set.range (𝒰.f j).base
        rw [AlgebraicGeometry.Scheme.fromSpecResidueField_apply q s]
        exact hq₂
      let g₁ := AlgebraicGeometry.IsOpenImmersion.lift (𝒰.f i) (κ_q ≫ p₁) hκ_r₁
      let g₂ := AlgebraicGeometry.IsOpenImmersion.lift (𝒰.f j) (κ_q ≫ p₂) hκ_r₂
      have hg₁ : g₁ ≫ 𝒰.f i = κ_q ≫ p₁ :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac (𝒰.f i) (κ_q ≫ p₁) hκ_r₁
      have hg₂ : g₂ ≫ 𝒰.f j = κ_q ≫ p₂ :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac (𝒰.f j) (κ_q ≫ p₂) hκ_r₂
      have hcomm_ij : g₁ ≫ ((𝒰.f i) ≫ X.hom) = g₂ ≫ ((𝒰.f j) ≫ X.hom) := by
        rw [← CategoryTheory.Category.assoc, hg₁, CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.condition, ← CategoryTheory.Category.assoc, ← hg₂,
          CategoryTheory.Category.assoc]
      let g_ij : AlgebraicGeometry.Spec (P.residueField q) ⟶
          CategoryTheory.Limits.pullback ((𝒰.f i) ≫ X.hom) ((𝒰.f j) ≫ X.hom) :=
        CategoryTheory.Limits.pullback.lift g₁ g₂ hcomm_ij
      let map_ij : CategoryTheory.Limits.pullback ((𝒰.f i) ≫ X.hom) ((𝒰.f j) ≫ X.hom) ⟶ P :=
        CategoryTheory.Limits.pullback.map ((𝒰.f i) ≫ X.hom) ((𝒰.f j) ≫ X.hom) X.hom X.hom
          (𝒰.f i) (𝒰.f j) (𝟙 S_k) (CategoryTheory.Category.comp_id _).symm
          (CategoryTheory.Category.comp_id _).symm
      have hmap_eq : g_ij ≫ map_ij = κ_q := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · dsimp [map_ij, CategoryTheory.Limits.pullback.map]
          rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
            ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst, hg₁]
        · dsimp [map_ij, CategoryTheory.Limits.pullback.map]
          rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
            ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd, hg₂]
      have hf_eq : 𝒰_P.f (i, j) = map_ij :=
        AlgebraicGeometry.Scheme.Pullback.openCoverOfLeftRight_f 𝒰 𝒰 X.hom X.hom (i, j)
      let pt_q : ↥(AlgebraicGeometry.Spec (P.residueField q)) := default
      refine ⟨g_ij.base pt_q, ?_⟩
      have h_app : (g_ij ≫ 𝒰_P.f (i, j)).base pt_q = κ_q.base pt_q :=
        congrArg (fun h => h.base pt_q) (congrArg (g_ij ≫ ·) hf_eq |>.trans hmap_eq)
      exact h_app.trans (AlgebraicGeometry.Scheme.fromSpecResidueField_apply q pt_q)
    haveI : Nonempty ↥P := ⟨Γ_φ.base (Classical.choice AlgebraicGeometry.IsIntegral.nonempty)⟩
    have hPre : PreirreducibleSpace ↥P := by
      refine ⟨fun O₁ O₂ hO₁ hO₂ ⟨q₁, _, hq₁⟩ ⟨q₂, _, hq₂⟩ => ?_⟩
      have hcov₁ := 𝒰_P.covers q₁
      generalize 𝒰_P.idx q₁ = α₁ at hcov₁
      rcases α₁ with ⟨i₁, j₁⟩
      obtain ⟨u₁, hu₁⟩ := hcov₁
      have hcov₂ := 𝒰_P.covers q₂
      generalize 𝒰_P.idx q₂ = α₂ at hcov₂
      rcases α₂ with ⟨i₂, j₂⟩
      obtain ⟨u₂, hu₂⟩ := hcov₂
      let u₁' : ↥(CategoryTheory.Limits.pullback ((𝒰.f i₁) ≫ X.hom) ((𝒰.f j₁) ≫ X.hom)) := u₁
      let u₂' : ↥(CategoryTheory.Limits.pullback ((𝒰.f i₂) ≫ X.hom) ((𝒰.f j₂) ≫ X.hom)) := u₂
      let a₁ :=
        (CategoryTheory.Limits.pullback.fst ((𝒰.f i₁) ≫ X.hom) ((𝒰.f j₁) ≫ X.hom)).base u₁'
      let b₁ :=
        (CategoryTheory.Limits.pullback.snd ((𝒰.f i₁) ≫ X.hom) ((𝒰.f j₁) ≫ X.hom)).base u₁'
      let a₂ :=
        (CategoryTheory.Limits.pullback.fst ((𝒰.f i₂) ≫ X.hom) ((𝒰.f j₂) ≫ X.hom)).base u₂'
      let b₂ :=
        (CategoryTheory.Limits.pullback.snd ((𝒰.f i₂) ≫ X.hom) ((𝒰.f j₂) ≫ X.hom)).base u₂'
      have hChart₁ : AlgebraicGeometry.IsIntegral (𝒰_P.X (i₁, j₁)) :=
        hChartInt i₁ j₁ ⟨a₁⟩ ⟨b₁⟩
      have hChart₂ : AlgebraicGeometry.IsIntegral (𝒰_P.X (i₂, j₂)) :=
        hChartInt i₂ j₂ ⟨a₂⟩ ⟨b₂⟩
      haveI : IrreducibleSpace ↥(𝒰_P.X (i₁, j₁)) :=
        @AlgebraicGeometry.irreducibleSpace_of_isIntegral _ hChart₁
      haveI : IrreducibleSpace ↥(𝒰_P.X (i₂, j₂)) :=
        @AlgebraicGeometry.irreducibleSpace_of_isIntegral _ hChart₂
      let idx₁ : 𝒰_P.I₀ := (i₁, j₁)
      let idx₂ : 𝒰_P.I₀ := (i₂, j₂)
      let W₁ : Set ↥P := Set.range (𝒰_P.f idx₁).base
      let W₂ : Set ↥P := Set.range (𝒰_P.f idx₂).base
      have hW₁_open : IsOpen W₁ := (𝒰_P.f idx₁).isOpenEmbedding.isOpen_range
      have hW₂_open : IsOpen W₂ := (𝒰_P.f idx₂).isOpenEmbedding.isOpen_range
      have hW₁_irr : IsIrreducible W₁ := by
        dsimp only [W₁]
        rw [← Set.image_univ]
        exact (IrreducibleSpace.isIrreducible_univ (X := ↥(𝒰_P.X (i₁, j₁)))).image _
          (𝒰_P.f idx₁).continuous.continuousOn
      have hW₂_irr : IsIrreducible W₂ := by
        dsimp only [W₂]
        rw [← Set.image_univ]
        exact (IrreducibleSpace.isIrreducible_univ (X := ↥(𝒰_P.X (i₂, j₂)))).image _
          (𝒰_P.f idx₂).continuous.continuousOn
      obtain ⟨z₁, _, hz₁_1, hz₁_2⟩ :=
        (IrreducibleSpace.isIrreducible_univ (X := ↥X.left)).isPreirreducible
          (Set.range (𝒰.f i₁).base) (Set.range (𝒰.f i₂).base)
          (𝒰.f i₁).isOpenEmbedding.isOpen_range (𝒰.f i₂).isOpenEmbedding.isOpen_range
          ⟨(𝒰.f i₁).base a₁, trivial, ⟨a₁, rfl⟩⟩ ⟨(𝒰.f i₂).base a₂, trivial, ⟨a₂, rfl⟩⟩
      obtain ⟨z₂, _, hz₂_1, hz₂_2⟩ :=
        (IrreducibleSpace.isIrreducible_univ (X := ↥X.left)).isPreirreducible
          (Set.range (𝒰.f j₁).base) (Set.range (𝒰.f j₂).base)
          (𝒰.f j₁).isOpenEmbedding.isOpen_range (𝒰.f j₂).isOpenEmbedding.isOpen_range
          ⟨(𝒰.f j₁).base b₁, trivial, ⟨b₁, rfl⟩⟩ ⟨(𝒰.f j₂).base b₂, trivial, ⟨b₂, rfl⟩⟩
      obtain ⟨q, hq_p₁, hq_p₂⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback (f := X.hom) (g := X.hom)
          z₁ z₂ (Subsingleton.elim _ _)
      have hq_W₁ : q ∈ W₁ := hMemRange i₁ j₁ q (hq_p₁.symm ▸ hz₁_1) (hq_p₂.symm ▸ hz₂_1)
      have hq_W₂ : q ∈ W₂ := hMemRange i₂ j₂ q (hq_p₁.symm ▸ hz₁_2) (hq_p₂.symm ▸ hz₂_2)
      obtain ⟨r, _, hr_O₁, hr_W₂⟩ :=
        hW₁_irr.isPreirreducible O₁ W₂ hO₁ hW₂_open ⟨q₁, ⟨u₁, hu₁⟩, hq₁⟩ ⟨q, hq_W₁, hq_W₂⟩
      obtain ⟨p, _, hp_O₁, hp_O₂⟩ :=
        hW₂_irr.isPreirreducible O₁ O₂ hO₁ hO₂ ⟨r, hr_W₂, hr_O₁⟩ ⟨q₂, ⟨u₂, hu₂⟩, hq₂⟩
      exact ⟨p, trivial, hp_O₁, hp_O₂⟩
    haveI : IrreducibleSpace ↥P := { toPreirreducibleSpace := hPre, toNonempty := inferInstance }
    exact AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced P

  have hSec_cl : ∀ {Y : AlgebraicGeometry.Scheme.{u}} (p_Y : Quiver.Hom Y S_k)
      [AlgebraicGeometry.IsSeparated p_Y] (s : Quiver.Hom S_k Y),
      s ≫ p_Y = 𝟙 S_k → AlgebraicGeometry.IsClosedImmersion s := by
    intro Y p_Y _ s hs
    let Δ_Y := CategoryTheory.Limits.pullback.diagonal p_Y
    have h_cond : 𝟙 Y ≫ p_Y = (p_Y ≫ s) ≫ p_Y := by
      rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc, hs,
        CategoryTheory.Category.comp_id]
    let g_Y := CategoryTheory.Limits.pullback.lift (𝟙 Y) (p_Y ≫ s) h_cond
    have h_sq : s ≫ Δ_Y = s ≫ g_Y := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · dsimp [Δ_Y, g_Y]
        rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.diagonal_fst,
          CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst]
      · dsimp [Δ_Y, g_Y]
        rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.diagonal_snd,
          CategoryTheory.Category.comp_id, CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.lift_snd, ← CategoryTheory.Category.assoc,
          hs, CategoryTheory.Category.id_comp]
    have hpb_s : CategoryTheory.IsPullback s s Δ_Y g_Y := by
      refine CategoryTheory.IsPullback.of_isLimit
        (CategoryTheory.Limits.PullbackCone.IsLimit.mk h_sq (fun cone => cone.snd ≫ p_Y)
          ?_ ?_ ?_)
      · intro cone
        have hq₂ := congrArg
          (fun h => h ≫ CategoryTheory.Limits.pullback.snd p_Y p_Y) cone.condition
        simp only [CategoryTheory.Category.assoc, Δ_Y, g_Y,
          CategoryTheory.Limits.pullback.diagonal_snd,
          CategoryTheory.Limits.pullback.lift_snd,
          CategoryTheory.Category.comp_id] at hq₂
        exact hq₂.symm
      · intro cone
        have hq₁ := congrArg
          (fun h => h ≫ CategoryTheory.Limits.pullback.fst p_Y p_Y) cone.condition
        have hq₂ := congrArg
          (fun h => h ≫ CategoryTheory.Limits.pullback.snd p_Y p_Y) cone.condition
        simp only [CategoryTheory.Category.assoc, Δ_Y, g_Y,
          CategoryTheory.Limits.pullback.diagonal_fst,
          CategoryTheory.Limits.pullback.diagonal_snd,
          CategoryTheory.Limits.pullback.lift_fst,
          CategoryTheory.Limits.pullback.lift_snd,
          CategoryTheory.Category.comp_id] at hq₁ hq₂
        exact hq₂.symm.trans hq₁
      · intro cone m _ hm₂
        calc
          m = m ≫ 𝟙 S_k := (CategoryTheory.Category.comp_id m).symm
          _ = m ≫ (s ≫ p_Y) := by rw [hs]
          _ = (m ≫ s) ≫ p_Y := (CategoryTheory.Category.assoc m s p_Y).symm
          _ = cone.snd ≫ p_Y := by rw [hm₂]
    exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_s
      (AlgebraicGeometry.IsSeparated.isClosedImmersion_diagonal (f := p_Y))

  have hProjRight0_eq : ∀ c : ℕ,
      weilGysinAffineProjRight k 0 c c (Nat.zero_add c) = 𝟙 (weilGysinAffineSpace k c) := by
    intro c
    refine (congrArg AlgebraicGeometry.Spec.map ?_).trans (AlgebraicGeometry.Spec.map_id _)
    apply CommRingCat.hom_ext
    apply MvPolynomial.ringHom_ext
    · intro r
      simp
    · intro j
      have hj : Fin.cast (Nat.zero_add c) (Fin.natAdd 0 j) = j := by
        ext
        simp
      simp [hj]

  have hOrigAxis0 : ∀ c : ℕ,
      CategoryTheory.IsPullback (weilGysinAffineOrigin k c) (weilGysinAffineOrigin k 0)
        (𝟙 (weilGysinAffineSpace k c))
        (weilGysinAffineLeftAxis k 0 c c (Nat.zero_add c)) ∧
      𝟙 (weilGysinAffineSpace k c) ≫ weilGysinAffineProjRight k 0 c c (Nat.zero_add c) =
        𝟙 (weilGysinAffineSpace k c) := by
    intro c
    let orig₀ := weilGysinAffineOrigin k 0
    let str₀ := weilGysinAffineStruct k 0
    have horig_str : orig₀ ≫ str₀ = 𝟙 S_k := by
      refine (AlgebraicGeometry.Spec.map_comp _ _).symm.trans
        ((congrArg AlgebraicGeometry.Spec.map ?_).trans (AlgebraicGeometry.Spec.map_id _))
      apply CommRingCat.hom_ext
      ext r
      simp
    have hstr_orig : str₀ ≫ orig₀ = 𝟙 (weilGysinAffineSpace k 0) := by
      refine (AlgebraicGeometry.Spec.map_comp _ _).symm.trans
        ((congrArg AlgebraicGeometry.Spec.map ?_).trans (AlgebraicGeometry.Spec.map_id _))
      apply CommRingCat.hom_ext
      apply MvPolynomial.ringHom_ext
      · intro r
        simp
      · intro i
        exact Fin.elim0 i
    have h_sq0 : weilGysinAffineOrigin k c ≫ 𝟙 (weilGysinAffineSpace k c) =
        orig₀ ≫ weilGysinAffineLeftAxis k 0 c c (Nat.zero_add c) := by
      rw [CategoryTheory.Category.comp_id]
      exact (horig_axis 0 c c (Nat.zero_add c)).symm
    refine ⟨?_, ?_⟩
    · refine CategoryTheory.IsPullback.of_isLimit
        (CategoryTheory.Limits.PullbackCone.IsLimit.mk h_sq0 (fun cone => cone.snd ≫ str₀)
          ?_ ?_ ?_)
      · intro cone
        calc
          (cone.snd ≫ str₀) ≫ weilGysinAffineOrigin k c =
              (cone.snd ≫ str₀) ≫ (orig₀ ≫ weilGysinAffineLeftAxis k 0 c c (Nat.zero_add c)) := by
            rw [horig_axis 0 c c (Nat.zero_add c)]
          _ = cone.snd ≫ (str₀ ≫ orig₀) ≫ weilGysinAffineLeftAxis k 0 c c (Nat.zero_add c) := by
            simp only [CategoryTheory.Category.assoc]
          _ = cone.snd ≫ weilGysinAffineLeftAxis k 0 c c (Nat.zero_add c) := by
            rw [hstr_orig, CategoryTheory.Category.id_comp]
          _ = cone.fst ≫ 𝟙 _ := cone.condition.symm
          _ = cone.fst := CategoryTheory.Category.comp_id cone.fst
      · intro cone
        rw [CategoryTheory.Category.assoc, hstr_orig, CategoryTheory.Category.comp_id]
      · intro cone m _ hm₂
        calc
          m = m ≫ 𝟙 S_k := (CategoryTheory.Category.comp_id m).symm
          _ = m ≫ (orig₀ ≫ str₀) := by rw [horig_str]
          _ = (m ≫ orig₀) ≫ str₀ := (CategoryTheory.Category.assoc m orig₀ str₀).symm
          _ = cone.snd ≫ str₀ := by rw [hm₂]
    · rw [CategoryTheory.Category.id_comp, hProjRight0_eq c]

  have hOrigSub : ∀ (c : ℕ) {Y : AlgebraicGeometry.Scheme.{u}} (p_Y : Quiver.Hom Y S_k)
      (s : Quiver.Hom S_k Y) (U W_sub : Y.Opens)
      (s_U : Quiver.Hom S_k U.toScheme)
      (u : Quiver.Hom U.toScheme (weilGysinAffineSpace k c)),
      WeilGysinIsEtaleOriginChart c p_Y s U s_U u →
      ∀ (hW_le : W_sub ≤ U),
        let U_Sk : S_k.Opens := (TopologicalSpace.Opens.map s.base).obj W_sub
        Nonempty ↥U_Sk.toScheme →
        ∃ u_sub0 : Quiver.Hom U_Sk.toScheme (weilGysinAffineSpace k 0),
          AlgebraicGeometry.Etale (Y.homOfLE hW_le ≫ u) ∧
          ConnectedSpace ↥U_Sk.toScheme ∧
          CategoryTheory.IsPullback (s.resLE W_sub U_Sk (le_refl _)) u_sub0
            (Y.homOfLE hW_le ≫ u)
            (weilGysinAffineLeftAxis k 0 c c (Nat.zero_add c)) ∧
          (Y.homOfLE hW_le ≫ u) ≫ weilGysinAffineProjRight k 0 c c (Nat.zero_add c) =
            Y.homOfLE hW_le ≫ u := by
    intro c Y p_Y s U W_sub s_U u hChart hW_le U_Sk hne
    haveI : AlgebraicGeometry.Etale u := hChart.1
    haveI : Nonempty ↥U_Sk.toScheme := hne
    haveI : AlgebraicGeometry.IsIntegral S_k :=
      (AlgebraicGeometry.affine_isIntegral_iff (CommRingCat.of k)).mpr inferInstance
    haveI : AlgebraicGeometry.IsIntegral U_Sk.toScheme :=
      AlgebraicGeometry.isIntegral_of_isOpenImmersion U_Sk.ι
    haveI : IrreducibleSpace ↥U_Sk.toScheme :=
      AlgebraicGeometry.irreducibleSpace_of_isIntegral U_Sk.toScheme
    have hpb_A : CategoryTheory.IsPullback (s.resLE W_sub U_Sk (le_refl _)) U_Sk.ι
        (Y.homOfLE hW_le) s_U := by
      apply hPb_of_bot _ _ (hSecOpen_pb s U s_U hChart.2.2.1)
      · rw [CategoryTheory.Category.comp_id, Y.homOfLE_ι hW_le]
        exact hResLE_pb s W_sub
      · apply (inferInstance : CategoryTheory.Mono U.ι).right_cancellation
        rw [CategoryTheory.Category.assoc, Y.homOfLE_ι hW_le,
          AlgebraicGeometry.Scheme.Hom.resLE_comp_ι, CategoryTheory.Category.assoc, hChart.2.2.1]
    have hpb_tot : CategoryTheory.IsPullback (s.resLE W_sub U_Sk (le_refl _))
        (U_Sk.ι ≫ weilGysinAffineOrigin k 0)
        (Y.homOfLE hW_le ≫ u)
        (weilGysinAffineLeftAxis k 0 c c (Nat.zero_add c)) := by
      have hp1 := hpb_A.paste_vert hChart.2.2.2
      rw [CategoryTheory.Category.comp_id] at hp1
      have hp2 := hp1.paste_vert (hOrigAxis0 c).1
      rwa [CategoryTheory.Category.comp_id] at hp2
    refine ⟨U_Sk.ι ≫ weilGysinAffineOrigin k 0, inferInstance, inferInstance, hpb_tot, ?_⟩
    rw [hProjRight0_eq c, CategoryTheory.Category.comp_id]

  have hTubSub : ∀ (U_x : X.left.Opens) (V_x : P.Opens)
      (γ_x : Quiver.Hom U_x.toScheme V_x.toScheme)
      (p₁_Vx : Quiver.Hom V_x.toScheme U_x.toScheme)
      (u_x : Quiver.Hom U_x.toScheme (weilGysinAffineSpace k d))
      (v_x : Quiver.Hom V_x.toScheme (weilGysinAffineSpace k d))
      (Ψ_x : Quiver.Hom V_x.toScheme (weilGysinAffineSpace k (2 * d))),
      WeilGysinIsTubularGraphChart d X Γ_φ U_x V_x γ_x p₁_Vx u_x v_x Ψ_x →
      CategoryTheory.IsPullback γ_x U_x.ι V_x.ι Γ_φ ∧
      CategoryTheory.IsPullback γ_x u_x Ψ_x
        (weilGysinAffineLeftAxis k d d (2 * d) (Nat.two_mul d).symm) ∧
      ∀ (W_sub : P.Opens) (hW_sub : W_sub ≤ V_x),
        let U_sub : X.left.Opens := (TopologicalSpace.Opens.map Γ_φ.base).obj W_sub
        let γ_sub := Γ_φ.resLE W_sub U_sub (le_refl _)
        let ψ_sub := P.homOfLE hW_sub ≫ Ψ_x
        ∃ u_sub : Quiver.Hom U_sub.toScheme (weilGysinAffineSpace k d),
          AlgebraicGeometry.Etale ψ_sub ∧
          CategoryTheory.IsPullback γ_sub u_sub ψ_sub
            (weilGysinAffineLeftAxis k d d (2 * d) (Nat.two_mul d).symm) ∧
          CategoryTheory.IsPullback γ_sub (U_sub.ι ≫ X.hom) (P.homOfLE hW_sub ≫ v_x)
            (weilGysinAffineOrigin k d) ∧
          ψ_sub ≫ weilGysinAffineProjRight k d d (2 * d) (Nat.two_mul d).symm =
            P.homOfLE hW_sub ≫ v_x := by
    intro U_x V_x γ_x p₁_Vx u_x v_x Ψ_x hTub
    rcases hTub with ⟨hpre, hγ_ι, _, _, hu_str, _, _, hΨ_et, _, hpb_v, _, hΨ_right, hγ_Ψ⟩
    have hpb_γ : CategoryTheory.IsPullback γ_x U_x.ι V_x.ι Γ_φ := by
      apply AlgebraicGeometry.IsOpenImmersion.isPullback γ_x U_x.ι V_x.ι Γ_φ hγ_ι.symm
      ext y
      simp only [TopologicalSpace.Opens.map_obj, SetLike.mem_coe,
        AlgebraicGeometry.Scheme.Opens.opensRange_ι]
      change y ∈ Γ_φ.base ⁻¹' (V_x : Set P) ↔ y ∈ (U_x : Set X.left)
      rw [hpre]
    have hpb_Ψ : CategoryTheory.IsPullback γ_x u_x Ψ_x
        (weilGysinAffineLeftAxis k d d (2 * d) (Nat.two_mul d).symm) := by
      apply hPb_of_bot _ hγ_Ψ (hpb_aff_axis d d (2 * d) (Nat.two_mul d).symm)
      rw [hu_str, hΨ_right]
      exact hpb_v
    refine ⟨hpb_γ, hpb_Ψ, fun W_sub hW_sub => ?_⟩
    let U_sub : X.left.Opens := (TopologicalSpace.Opens.map Γ_φ.base).obj W_sub
    let γ_sub := Γ_φ.resLE W_sub U_sub (le_refl _)
    let ψ_sub := P.homOfLE hW_sub ≫ Ψ_x
    have hU_sub : U_sub ≤ U_x := by
      intro y hy
      rw [← SetLike.mem_coe, ← hpre]
      exact hW_sub hy
    haveI : AlgebraicGeometry.Etale Ψ_x := hΨ_et
    have hpb_sub : CategoryTheory.IsPullback γ_sub (X.left.homOfLE hU_sub)
        (P.homOfLE hW_sub) γ_x := by
      apply hPb_of_bot _ _ hpb_γ
      · rw [X.left.homOfLE_ι hU_sub, P.homOfLE_ι hW_sub]
