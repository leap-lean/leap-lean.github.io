    (U_P : P.Opens)
    (s_UP : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) U_P.toScheme)
    (e_UP : CategoryTheory.Iso (weilGysinAffineSpace k c) U_P.toScheme)
    (_ : CategoryTheory.CategoryStruct.comp e_UP.hom U_P.ι = ι_aff_P)
    (_ : s_UP = CategoryTheory.CategoryStruct.comp (weilGysinAffineOrigin k c) e_UP.hom)
