            let u₂ : d₃ ⟶ d₂ := CategoryTheory.InducedCategory.homMk
              (CategoryTheory.MorphismProperty.Over.homMk (v.left ≫ π₂)
                ((CategoryTheory.Category.assoc v.left π₂ _).trans
                  (CategoryTheory.MorphismProperty.Over.w v)))
            let j₃ : J_idx := Opposite.op (CategoryTheory.Functor.elementsMk LiftF d₃ δ₃)
            have hm₁ : LiftF.map u₁ δ₃ = δ₁ := Subtype.ext
              ((CategoryTheory.Category.assoc δ₃.1 v.left π₁).symm.trans
                ((congrArg (· ≫ π₁) hδ₃).trans (CategoryTheory.Limits.pullback.lift_fst _ _ _)))
            have hm₂ : LiftF.map u₂ δ₃ = δ₂ := Subtype.ext
              ((CategoryTheory.Category.assoc δ₃.1 v.left π₂).symm.trans
                ((congrArg (· ≫ π₂) hδ₃).trans (CategoryTheory.Limits.pullback.lift_snd _ _ _)))
            exact ⟨j₃, Opposite.op ⟨u₁, hm₁⟩, Opposite.op ⟨u₂, hm₂⟩, trivial⟩
          · intro j₁ j₂ f₁ f₂
            let d₁ : AffCat := j₁.unop.1
            let d₂ : AffCat := j₂.unop.1
            let δ₁ := j₁.unop.2
            let δ₂ := j₂.unop.2
            let u₁ : d₂ ⟶ d₁ := f₁.unop.1
            let u₂ : d₂ ⟶ d₁ := f₂.unop.1
            have hu₁_δ : δ₂.1 ≫ (G_aff.map u₁).left = δ₁.1 := congrArg Subtype.val f₁.unop.2
            have hu₂_δ : δ₂.1 ≫ (G_aff.map u₂).left = δ₁.1 := congrArg Subtype.val f₂.unop.2
            have _ : AlgebraicGeometry.Etale (G_aff.obj d₁).hom := (G_aff.obj d₁).prop
            have _ : AlgebraicGeometry.Etale (G_aff.obj d₂).hom := (G_aff.obj d₂).prop
            have _ : AlgebraicGeometry.FormallyUnramified (G_aff.obj d₁).hom := inferInstance
            have _ : AlgebraicGeometry.LocallyOfFiniteType (G_aff.obj d₁).hom := inferInstance
            let Δ₁ := CategoryTheory.Limits.pullback.diagonal (G_aff.obj d₁).hom
            have _ : AlgebraicGeometry.IsOpenImmersion Δ₁ :=
              AlgebraicGeometry.FormallyUnramified.isOpenImmersion_diagonal (G_aff.obj d₁).hom
            let ell := CategoryTheory.Limits.pullback.lift (G_aff.map u₁).left (G_aff.map u₂).left
              ((CategoryTheory.MorphismProperty.Over.w (G_aff.map u₁)).trans
                (CategoryTheory.MorphismProperty.Over.w (G_aff.map u₂)).symm)
            let O_eq : (G_aff.obj d₂).left.Opens :=
              (TopologicalSpace.Opens.map ell.base).obj Δ₁.opensRange
            have hδ₂_ell : δ₂.1 ≫ ell = δ₁.1 ≫ Δ₁ := by
              apply CategoryTheory.Limits.pullback.hom_ext
              · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
                  CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.diagonal_fst,
                  CategoryTheory.Category.comp_id, hu₁_δ]
              · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
                  CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.diagonal_snd,
                  CategoryTheory.Category.comp_id, hu₂_δ]
            have hRange_δ₂ : Set.range δ₂.1.base ⊆ Set.range O_eq.ι.base := by
              rintro _ ⟨pt, rfl⟩
              rw [AlgebraicGeometry.Scheme.Opens.range_ι]
