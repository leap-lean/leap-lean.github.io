          ((hS.map_of_exact F).map_of_exact G).extClass := rfl
      rw [ih S.X₃ x₃, hExtEq]
  let instModCoext : ∀ (m : ℕ) (A : AddCommGrpCat.{u}),
      Module (ULift.{u, 0} (ZMod m)) (ULift.{u, 0} (ZMod m) →+ ↑A) :=
    fun m A =>
      let R := ULift.{u, 0} (ZMod m)
      { smul := fun r φ =>
          { toFun := fun t => φ (t * r)
            map_zero' := by rw [zero_mul, map_zero]
            map_add' := fun x y => by rw [add_mul, map_add] }
        one_smul := fun φ => by ext t; change φ (t * 1) = φ t; rw [mul_one]
        mul_smul := fun r s φ => by ext t; change φ (t * (r * s)) = φ ((t * r) * s); rw [mul_assoc]
        smul_zero := fun r => by ext t; rfl
        smul_add := fun r φ ψ => by ext t; rfl
        add_smul := fun r s φ => by ext t; change φ (t * (r + s)) = φ (t * r) + φ (t * s); rw [mul_add, map_add]
        zero_smul := fun φ => by ext t; change φ (t * 0) = 0; rw [mul_zero, map_zero] }
  let coextModFn : ∀ (m : ℕ), AddCommGrpCat.{u} ⥤ ModuleCat.{u, u} (ULift.{u, 0} (ZMod m)) :=
    fun m =>
      let R := ULift.{u, 0} (ZMod m)
      letI : ∀ A : AddCommGrpCat.{u}, Module R (R →+ ↑A) := instModCoext m
      { obj := fun A => ModuleCat.of R (R →+ ↑A)
        map := fun {A B} f => ModuleCat.ofHom
          ({ toFun := fun (φ : R →+ ↑A) => f.hom.comp φ
             map_add' := fun φ ψ => by ext t; exact map_add f.hom (φ t) (ψ t)
             map_smul' := fun r φ => by ext t; rfl } : (R →+ ↑A) →ₗ[R] (R →+ ↑B))
        map_id := fun A => by
          apply ModuleCat.hom_ext
          apply LinearMap.ext
          intro φ
          exact DFunLike.ext _ _ (fun _ => rfl)
        map_comp := fun f g => by
          apply ModuleCat.hom_ext
          apply LinearMap.ext
          intro φ
          exact DFunLike.ext _ _ (fun _ => rfl) }
  have hAlgAdj : ∀ (m : ℕ),
      let R := ULift.{u, 0} (ZMod m)
