    obtain ⟨eq_cod1⟩ := hIsoH0 (pb_s.mapIso e_R0.symm ≪≫ e_pbc0)
    obtain ⟨eq_cod2⟩ := hSk_H0_equiv P1.left P1.hom (weilEtaleTorsionSheaf P1.left (ℓ ^ 1)) 0
    have hCard_cod : Nat.card ((pb_s.obj (pf_pbar.obj (weilEtaleTorsionSheaf P (ℓ ^ 1)))).H 0) = ℓ := by
      rw [Nat.card_congr (eq_cod1.trans eq_cod2).toEquiv]; exact hP1_H0
    have : Finite ((pb_s.obj (weilEtaleTorsionSheaf B.left (ℓ ^ 1))).H 0) :=
      Nat.finite_of_card_ne_zero (by rw [hCard_dom]; exact hℓ_ne)
    have : Finite ((pb_s.obj (pf_pbar.obj (weilEtaleTorsionSheaf P (ℓ ^ 1)))).H 0) :=
