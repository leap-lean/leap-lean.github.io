      _ = ((CategoryTheory.Abelian.Ext.mapExactFunctor F₁ x).comp
            (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app Y)) (Nat.add_zero q₀)).comp
            (CategoryTheory.Abelian.Ext.mk₀ (η.inv.app Y)) (Nat.add_zero q₀) :=
          (CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ (Nat.add_zero q₀)).symm
      _ = ((CategoryTheory.Abelian.Ext.mk₀ (η.hom.app X)).comp
            (CategoryTheory.Abelian.Ext.mapExactFunctor F₂ x) (Nat.zero_add q₀)).comp
            (CategoryTheory.Abelian.Ext.mk₀ (η.inv.app Y)) (Nat.add_zero q₀) := by
          rw [hNat q₀ X Y x]
      _ = (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app X)).comp
            ((CategoryTheory.Abelian.Ext.mapExactFunctor F₂ x).comp
              (CategoryTheory.Abelian.Ext.mk₀ (η.inv.app Y)) (Nat.add_zero q₀))
            (Nat.zero_add q₀) :=
          CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ (Nat.zero_add q₀)

  
  have hCompExt : ∀ {C_ab D_ab E_ab : Type (u + 1)}
      [CategoryTheory.Category.{u + 1, u + 1} C_ab] [CategoryTheory.Abelian C_ab]
      [CategoryTheory.HasExt.{u} C_ab] [CategoryTheory.EnoughInjectives C_ab]
      [CategoryTheory.Category.{u + 1, u + 1} D_ab] [CategoryTheory.Abelian D_ab]
      [CategoryTheory.HasExt.{u} D_ab]
      [CategoryTheory.Category.{u + 1, u + 1} E_ab] [CategoryTheory.Abelian E_ab]
      [CategoryTheory.HasExt.{u} E_ab]
      (F₁ : CategoryTheory.Functor C_ab D_ab) (F₂ : CategoryTheory.Functor D_ab E_ab)
      [F₁.Additive] [CategoryTheory.Limits.PreservesFiniteLimits F₁]
      [CategoryTheory.Limits.PreservesFiniteColimits F₁]
      [F₂.Additive] [CategoryTheory.Limits.PreservesFiniteLimits F₂]
      [CategoryTheory.Limits.PreservesFiniteColimits F₂]
      (q₀ : ℕ) (X Y : C_ab) (x : CategoryTheory.Abelian.Ext.{u} X Y q₀),
      ((F₁.comp F₂).mapExtAddHom X Y q₀) x =
        (F₂.mapExtAddHom (F₁.obj X) (F₁.obj Y) q₀) ((F₁.mapExtAddHom X Y q₀) x) := by
    intro C_ab D_ab E_ab _ _ _ _ _ _ _ _ _ _ F₁ F₂ _ _ _ _ _ _ q₀ X Y x
    rw [CategoryTheory.Functor.mapExtAddHom_apply, CategoryTheory.Functor.mapExtAddHom_apply,
      CategoryTheory.Functor.mapExtAddHom_apply]
    induction q₀ generalizing X Y with
    | zero =>
      let f : X ⟶ Y := CategoryTheory.Abelian.Ext.addEquiv₀ x
      have hf : CategoryTheory.Abelian.Ext.mk₀ f = x :=
        CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply x
      rw [← hf, CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀]
      rfl
    | succ k ih =>
      let I : C_ab := CategoryTheory.Injective.under Y
      let ι : Y ⟶ I := CategoryTheory.Injective.ι Y
      let Q : C_ab := CategoryTheory.Limits.cokernel ι
      let π_c : I ⟶ Q := CategoryTheory.Limits.cokernel.π ι
      let S_c : CategoryTheory.ShortComplex C_ab :=
        CategoryTheory.ShortComplex.mk ι π_c (CategoryTheory.Limits.cokernel.condition ι)
      have hExact : S_c.Exact :=
        CategoryTheory.ShortComplex.exact_of_g_is_cokernel S_c
          (CategoryTheory.Limits.cokernelIsCokernel ι)
      have hMono : CategoryTheory.Mono S_c.f := by dsimp [S_c]; infer_instance
      have hEpi : CategoryTheory.Epi S_c.g := by dsimp [S_c]; infer_instance
      have hS : S_c.ShortExact :=
        CategoryTheory.ShortComplex.ShortExact.mk' hExact hMono hEpi
      have hInj : CategoryTheory.Injective S_c.X₂ := by dsimp [S_c, I]; infer_instance
      have hZero : x.comp (CategoryTheory.Abelian.Ext.mk₀ S_c.f) (Nat.add_zero (k + 1)) = 0 :=
        @CategoryTheory.Abelian.Ext.eq_zero_of_injective _ _ _ _ X S_c.X₂ k hInj _
      obtain ⟨z, rfl⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ X hS x hZero (rfl : k + 1 = k + 1)
      have hS₁₂ : (S_c.map (F₁.comp F₂)).ShortExact := hS.map_of_exact (F₁.comp F₂)
      have hS₁_₂ : ((S_c.map F₁).map F₂).ShortExact := (hS.map_of_exact F₁).map_of_exact F₂
      have hExtEq : hS₁₂.extClass = hS₁_₂.extClass := rfl
      rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass,
        ih X Q z, hExtEq]

  
  have hLeftUniqEquiv : ∀ {𝒞 𝒟 : Type (u + 1)}
      [CategoryTheory.Category.{u + 1, u + 1} 𝒞] [CategoryTheory.Category.{u + 1, u + 1} 𝒟]
      {F₁ F₂ : 𝒞 ⥤ 𝒟} {G : 𝒟 ⥤ 𝒞} (adj₁ : F₁ ⊣ G) (adj₂ : F₂ ⊣ G)
      (X : 𝒞) (Y : 𝒟) (k : F₂.obj X ⟶ Y),
      adj₁.homEquiv X Y ((CategoryTheory.Adjunction.leftAdjointUniq adj₁ adj₂).hom.app X ≫ k) =
        adj₂.homEquiv X Y k := by
    intro 𝒞 𝒟 _ _ F₁ F₂ G adj₁ adj₂ X Y k
    rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Adjunction.homEquiv_unit,
      CategoryTheory.Functor.map_comp,
      CategoryTheory.Adjunction.unit_leftAdjointUniq_hom_app_assoc]

  
  have hConstAlign : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂)
      (P_pull : CategoryTheory.Sheaf X₂.smallEtaleTopology AddCommGrpCat.{u} ⥤
        CategoryTheory.Sheaf X₁.smallEtaleTopology AddCommGrpCat.{u})
      (adj_h : P_pull ⊣
        @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _ (weilEtaleSitePullback h)
          AddCommGrpCat.{u} _ X₂.smallEtaleTopology X₁.smallEtaleTopology (hc_all h))
      {T₁ : X₁.Etale} (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
      {T₂ : X₂.Etale} (hT₂ : CategoryTheory.Limits.IsTerminal T₂)
      (A : AddCommGrpCat.{u}),
      letI := hc_all h; letI := hr_all h
      let B := weilEtaleSitePullback h
      let J₁ := X₁.smallEtaleTopology
      let J₂ := X₂.smallEtaleTopology
      let C₁ := CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}
      let C₂ := CategoryTheory.constantSheaf J₂ AddCommGrpCat.{u}
      let pf_h := B.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
      let adj_std := B.sheafAdjunctionContinuous AddCommGrpCat.{u} J₂ J₁
      let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
      let adj₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
      let τ := hT₁.from (B.obj T₂)
      let η := CategoryTheory.Adjunction.leftAdjointUniq adj_h adj_std
      (adj_h.homEquiv (C₂.obj A) (C₁.obj A)).symm
        ((adj₂.homEquiv A (pf_h.obj (C₁.obj A))).symm
          (adj₁.unit.app A ≫ (C₁.obj A).obj.map (Opposite.op τ))) =
      η.hom.app (C₂.obj A) ≫
        weilEtaleConstPullbackHom h (weilEtaleIdTerminalIsTerminal.{u} X₁)
          (weilEtaleIdTerminalIsTerminal.{u} X₂) A := by
    intro X₁ X₂ h P_pull adj_h T₁ hT₁ T₂ hT₂ A
    letI := hc_all h; letI := hr_all h
    let B := weilEtaleSitePullback h
    let J₁ := X₁.smallEtaleTopology
    let J₂ := X₂.smallEtaleTopology
    let C₁ := CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}
    let C₂ := CategoryTheory.constantSheaf J₂ AddCommGrpCat.{u}
    let pf_h := B.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
    let adj_std := B.sheafAdjunctionContinuous AddCommGrpCat.{u} J₂ J₁
    let shAdj₁ := CategoryTheory.sheafificationAdjunction J₁ AddCommGrpCat.{u}
    let shAdj₂ := CategoryTheory.sheafificationAdjunction J₂ AddCommGrpCat.{u}
    let P_A₁ := (CategoryTheory.Functor.const X₁.Etaleᵒᵖ).obj A
    let P_A₂ := (CategoryTheory.Functor.const X₂.Etaleᵒᵖ).obj A
    let η_pre : P_A₂ ⟶ (pf_h.obj (C₁.obj A)).obj :=
      { app := fun opU =>
          (shAdj₁.unit.app P_A₁).app (Opposite.op (B.obj (Opposite.unop opU)))
        naturality := fun {opU₁ opU₂} g =>
          (shAdj₁.unit.app P_A₁).naturality (B.op.map g) }
    let u_canon : C₂.obj A ⟶ pf_h.obj (C₁.obj A) :=
      (shAdj₂.homEquiv P_A₂ (pf_h.obj (C₁.obj A))).symm η_pre
    have hInner : ∀ {S₁' : X₁.Etale} (hS₁' : CategoryTheory.Limits.IsTerminal S₁')
        {S₂' : X₂.Etale} (hS₂' : CategoryTheory.Limits.IsTerminal S₂'),
        ((CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hS₂').homEquiv
          A (pf_h.obj (C₁.obj A))).symm
          ((CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hS₁').unit.app A ≫
            (C₁.obj A).obj.map (Opposite.op (hS₁'.from (B.obj S₂')))) = u_canon := by
      intro S₁' hS₁' S₂' hS₂'
      let a₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hS₁'
      let a₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hS₂'
      let τ' := hS₁'.from (B.obj S₂')
      apply (a₂.homEquiv A (pf_h.obj (C₁.obj A))).injective
      have hlhs := Equiv.apply_symm_apply (a₂.homEquiv A (pf_h.obj (C₁.obj A)))
        (a₁.unit.app A ≫ (C₁.obj A).obj.map (Opposite.op τ'))
      have ha₁ : a₁.unit.app A = (shAdj₁.unit.app P_A₁).app (Opposite.op S₁') :=
        CategoryTheory.Category.id_comp _
      have ha₂ : a₂.homEquiv A (pf_h.obj (C₁.obj A)) u_canon =
          (shAdj₂.unit.app P_A₂).app (Opposite.op S₂') ≫
            u_canon.hom.app (Opposite.op S₂') :=
        (CategoryTheory.Adjunction.homEquiv_unit a₂ A (pf_h.obj (C₁.obj A)) u_canon).trans
          (congrArg (· ≫ u_canon.hom.app (Opposite.op S₂')) (CategoryTheory.Category.id_comp _))
      have hsh₂_app : (shAdj₂.unit.app P_A₂).app (Opposite.op S₂') ≫
          u_canon.hom.app (Opposite.op S₂') =
          (shAdj₁.unit.app P_A₁).app (Opposite.op (B.obj S₂')) := by
        have h1 := congrArg (fun ν => ν.app (Opposite.op S₂'))
          (Equiv.apply_symm_apply (shAdj₂.homEquiv P_A₂ (pf_h.obj (C₁.obj A))) η_pre)
        rw [CategoryTheory.Adjunction.homEquiv_unit] at h1
        exact h1
      have hnat₁ : 𝟙 A ≫ (shAdj₁.unit.app P_A₁).app (Opposite.op (B.obj S₂')) =
          (shAdj₁.unit.app P_A₁).app (Opposite.op S₁') ≫ (C₁.obj A).obj.map (Opposite.op τ') :=
        (shAdj₁.unit.app P_A₁).naturality (Opposite.op τ')
      exact hlhs.trans
        ((congrArg (· ≫ (C₁.obj A).obj.map (Opposite.op τ')) ha₁).trans
          (hnat₁.symm.trans
            ((CategoryTheory.Category.id_comp _).trans (hsh₂_app.symm.trans ha₂.symm))))
    apply (adj_h.homEquiv (C₂.obj A) (C₁.obj A)).injective
    have h1 := congrArg (adj_h.homEquiv (C₂.obj A) (C₁.obj A)).symm (hInner hT₁ hT₂)
    have h2 := congrArg (adj_std.homEquiv (C₂.obj A) (C₁.obj A)).symm
      (hInner (weilEtaleIdTerminalIsTerminal.{u} X₁) (weilEtaleIdTerminalIsTerminal.{u} X₂))
    exact (congrArg (adj_h.homEquiv (C₂.obj A) (C₁.obj A)) h1).trans
      ((Equiv.apply_symm_apply _ u_canon).trans
        ((Equiv.apply_symm_apply (adj_std.homEquiv (C₂.obj A) (C₁.obj A)) u_canon).symm.trans
          ((congrArg (adj_std.homEquiv (C₂.obj A) (C₁.obj A)) h2.symm).trans
            (hLeftUniqEquiv adj_h adj_std (C₂.obj A) (C₁.obj A) _).symm)))

  
  have hFY_comp : ∀ {X : AlgebraicGeometry.Scheme.{u}} {U : X.Etale} {M : AddCommGrpCat.{u}}
      {F G : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
      (α : CategoryTheory.Sheaf.freeYoneda X.smallEtaleTopology U M ⟶ F) (f : F ⟶ G),
      CategoryTheory.Sheaf.freeYonedaHomEquiv (α ≫ f) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ f.hom.app (Opposite.op U) := by
    intro X U M F G α f
    let shAdj := CategoryTheory.sheafificationAdjunction X.smallEtaleTopology AddCommGrpCat.{u}
    let P_f := CategoryTheory.Presheaf.freeYoneda U M
    let α' : (CategoryTheory.presheafToSheaf X.smallEtaleTopology AddCommGrpCat.{u}).obj P_f ⟶ F := α
    exact (congrArg CategoryTheory.Presheaf.freeYonedaHomEquiv
      (shAdj.homEquiv_naturality_right α' f)).trans
      (CategoryTheory.Presheaf.freeYonedaHomEquiv_comp (shAdj.homEquiv P_f F α')
        ((CategoryTheory.sheafToPresheaf X.smallEtaleTopology AddCommGrpCat.{u}).map f))

  have hLocalMap_comp : ∀ {S : AlgebraicGeometry.Scheme.{u}} {n₀ : ℕ}
      {V₁ V₂ : S.Etale} (v : V₁ ⟶ V₂)
      {𝒢 : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
      (f : weilGysinLocalTorsionSheaf S n₀ V₂ ⟶ 𝒢),
      CategoryTheory.Sheaf.freeYonedaHomEquiv (weilEtaleLocalTorsionMap S n₀ v ≫ f) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv f ≫ 𝒢.obj.map (Opposite.op v) := by
    intro S n₀ V₁ V₂ v 𝒢 f
    have hmap : CategoryTheory.Sheaf.freeYonedaHomEquiv (weilEtaleLocalTorsionMap S n₀ v) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv
          (CategoryTheory.CategoryStruct.id (weilGysinLocalTorsionSheaf S n₀ V₂)) ≫
          (weilEtaleLocalTorsionSheaf S n₀ V₂).obj.map (Opposite.op v) :=
      Equiv.apply_symm_apply _ _
    exact (hFY_comp _ f).trans
      ((congrArg (· ≫ f.hom.app (Opposite.op V₁)) hmap).trans
        ((CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg _ (f.hom.naturality (Opposite.op v))).trans
            ((CategoryTheory.Category.assoc _ _ _).symm.trans
              (congrArg (· ≫ 𝒢.obj.map (Opposite.op v))
                ((hFY_comp _ f).symm.trans
                  (congrArg CategoryTheory.Sheaf.freeYonedaHomEquiv
                    (CategoryTheory.Category.id_comp f))))))))

  have hLocalMap_counit : ∀ {S : AlgebraicGeometry.Scheme.{u}} {n₀ : ℕ}
      {V₁ V₂ : S.Etale} (v : V₁ ⟶ V₂),
      weilEtaleLocalTorsionMap S n₀ v ≫ weilGysinLocalTorsionCounit S n₀ V₂ =
        weilGysinLocalTorsionCounit S n₀ V₁ := by
    intro S n₀ V₁ V₂ v
    apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod n₀))
    let shAdj := CategoryTheory.sheafificationAdjunction S.smallEtaleTopology AddCommGrpCat.{u}
    let P_AM := (CategoryTheory.Functor.const (Opposite S.Etale)).obj AM
    have hc₁ : CategoryTheory.Sheaf.freeYonedaHomEquiv (weilGysinLocalTorsionCounit S n₀ V₁) =
        (shAdj.unit.app P_AM).app (Opposite.op V₁) :=
      Equiv.apply_symm_apply _ _
    have hc₂ : CategoryTheory.Sheaf.freeYonedaHomEquiv (weilGysinLocalTorsionCounit S n₀ V₂) =
        (shAdj.unit.app P_AM).app (Opposite.op V₂) :=
      Equiv.apply_symm_apply _ _
    have hnat : 𝟙 AM ≫ (shAdj.unit.app P_AM).app (Opposite.op V₁) =
        (shAdj.unit.app P_AM).app (Opposite.op V₂) ≫
          (weilEtaleTorsionSheaf S n₀).obj.map (Opposite.op v) :=
      (shAdj.unit.app P_AM).naturality (Opposite.op v)
    exact (hLocalMap_comp v (weilGysinLocalTorsionCounit S n₀ V₂)).trans
      ((congrArg (· ≫ (weilEtaleTorsionSheaf S n₀).obj.map (Opposite.op v)) hc₂).trans
        (hnat.symm.trans ((CategoryTheory.Category.id_comp _).trans hc₁.symm)))

  
  have hChartPull : ∀ {S S' U₀ U'₀ : AlgebraicGeometry.Scheme.{u}}
      (e_S : S ≅ S') (e_U : U₀ ≅ U'₀)
      (u : U₀ ⟶ S) (hu : AlgebraicGeometry.Etale u)
      (u' : U'₀ ⟶ S') (hu' : AlgebraicGeometry.Etale u'),
      e_U.hom ≫ u' = u ≫ e_S.hom →
      ∀ (n₀ : ℕ),
        letI := hc_all e_S.inv; letI := hr_all e_S.inv
        let V := weilGysinEtaleObj u hu
        let V' := weilGysinEtaleObj u' hu'
        let pb := (weilEtaleSitePullback e_S.inv).sheafPullback AddCommGrpCat.{u}
          S.smallEtaleTopology S'.smallEtaleTopology
        let adj := (weilEtaleSitePullback e_S.inv).sheafAdjunctionContinuous AddCommGrpCat.{u}
          S.smallEtaleTopology S'.smallEtaleTopology
        let π_M := weilEtaleConstPullbackHom e_S.inv
          (weilEtaleIdTerminalIsTerminal.{u} S') (weilEtaleIdTerminalIsTerminal.{u} S)
          (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod n₀)))
        let L_S := weilGysinLocalTorsionSheaf S n₀ V
        let L'_S := weilGysinLocalTorsionSheaf S' n₀ V'
        ∃ (ψ_hat : V' ≅ (weilEtaleSitePullback e_S.inv).obj V)
          (Ψ : pb.obj L_S ≅ L'_S),
          (((AlgebraicGeometry.Scheme.Etale.forget S').map ψ_hat.hom).left ≫
            CategoryTheory.Limits.pullback.fst u e_S.inv = e_U.inv) ∧
          (∀ (𝒢 : CategoryTheory.Sheaf S'.smallEtaleTopology AddCommGrpCat.{u})
             (f : L'_S ⟶ 𝒢),
            CategoryTheory.Sheaf.freeYonedaHomEquiv (adj.homEquiv L_S 𝒢 (Ψ.hom ≫ f)) =
              CategoryTheory.Sheaf.freeYonedaHomEquiv f ≫ 𝒢.obj.map (Opposite.op ψ_hat.inv)) ∧
          (Ψ.hom ≫ weilGysinLocalTorsionCounit S' n₀ V' =
            pb.map (weilGysinLocalTorsionCounit S n₀ V) ≫ π_M) := by
    intro S S' U₀ U'₀ e_S e_U u hu u' hu' hcomm n₀
    letI := hc_all e_S.inv; letI := hr_all e_S.inv
    let V := weilGysinEtaleObj u hu
    let V' := weilGysinEtaleObj u' hu'
    let pb := (weilEtaleSitePullback e_S.inv).sheafPullback AddCommGrpCat.{u}
      S.smallEtaleTopology S'.smallEtaleTopology
    let adj := (weilEtaleSitePullback e_S.inv).sheafAdjunctionContinuous AddCommGrpCat.{u}
      S.smallEtaleTopology S'.smallEtaleTopology
    let π_M := weilEtaleConstPullbackHom e_S.inv
      (weilEtaleIdTerminalIsTerminal.{u} S') (weilEtaleIdTerminalIsTerminal.{u} S)
      (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod n₀)))
    let L_S := weilGysinLocalTorsionSheaf S n₀ V
    let L'_S := weilGysinLocalTorsionSheaf S' n₀ V'
    have h_inv : e_U.inv ≫ u = u' ≫ e_S.inv := by
      calc e_U.inv ≫ u
          = e_U.inv ≫ (u ≫ 𝟙 S) := by rw [CategoryTheory.Category.comp_id]
        _ = e_U.inv ≫ (u ≫ (e_S.hom ≫ e_S.inv)) := by rw [e_S.hom_inv_id]
        _ = e_U.inv ≫ ((u ≫ e_S.hom) ≫ e_S.inv) := by rw [CategoryTheory.Category.assoc]
        _ = e_U.inv ≫ ((e_U.hom ≫ u') ≫ e_S.inv) := by rw [← hcomm]
        _ = (e_U.inv ≫ e_U.hom) ≫ (u' ≫ e_S.inv) := by simp only [CategoryTheory.Category.assoc]
        _ = u' ≫ e_S.inv := by rw [e_U.inv_hom_id, CategoryTheory.Category.id_comp]
    have hpb : CategoryTheory.IsPullback e_U.inv u' u e_S.inv :=
      CategoryTheory.IsPullback.of_horiz_isIso ⟨h_inv⟩
    let ψ_hat : V' ≅ (weilEtaleSitePullback e_S.inv).obj V :=
      CategoryTheory.MorphismProperty.Over.isoMk hpb.isoPullback hpb.isoPullback_hom_snd
    have hψ_fst : ((AlgebraicGeometry.Scheme.Etale.forget S').map ψ_hat.hom).left ≫
        CategoryTheory.Limits.pullback.fst u e_S.inv = e_U.inv :=
      hpb.isoPullback_hom_fst
    let L_mid := weilGysinLocalTorsionSheaf S' n₀ ((weilEtaleSitePullback e_S.inv).obj V)
    let θ_hom : L_mid ⟶ L'_S := weilEtaleLocalTorsionMap S' n₀ ψ_hat.inv
    let θ_inv : L'_S ⟶ L_mid := weilEtaleLocalTorsionMap S' n₀ ψ_hat.hom
    have hθ_hom_inv : θ_hom ≫ θ_inv = 𝟙 L_mid := by
      apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
      have h1 : CategoryTheory.Sheaf.freeYonedaHomEquiv θ_inv =
          CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 L_mid) ≫
            L_mid.obj.map (Opposite.op ψ_hat.hom) :=
        Equiv.apply_symm_apply _ _
      have hop : L_mid.obj.map (Opposite.op ψ_hat.hom) ≫
          L_mid.obj.map (Opposite.op ψ_hat.inv) = 𝟙 _ :=
        (L_mid.obj.map_comp _ _).symm.trans
          ((congrArg L_mid.obj.map (congrArg Opposite.op ψ_hat.inv_hom_id)).trans
            (L_mid.obj.map_id _))
      exact (hLocalMap_comp ψ_hat.inv θ_inv).trans
        ((congrArg (· ≫ L_mid.obj.map (Opposite.op ψ_hat.inv)) h1).trans
          ((CategoryTheory.Category.assoc _ _ _).trans
            ((congrArg _ hop).trans (CategoryTheory.Category.comp_id _))))
    have hθ_inv_hom : θ_inv ≫ θ_hom = 𝟙 L'_S := by
      apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
      have h1 : CategoryTheory.Sheaf.freeYonedaHomEquiv θ_hom =
          CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 L'_S) ≫
            L'_S.obj.map (Opposite.op ψ_hat.inv) :=
        Equiv.apply_symm_apply _ _
      have hop : L'_S.obj.map (Opposite.op ψ_hat.inv) ≫
          L'_S.obj.map (Opposite.op ψ_hat.hom) = 𝟙 _ :=
        (L'_S.obj.map_comp _ _).symm.trans
          ((congrArg L'_S.obj.map (congrArg Opposite.op ψ_hat.hom_inv_id)).trans
            (L'_S.obj.map_id _))
      exact (hLocalMap_comp ψ_hat.hom θ_hom).trans
        ((congrArg (· ≫ L'_S.obj.map (Opposite.op ψ_hat.hom)) h1).trans
          ((CategoryTheory.Category.assoc _ _ _).trans
            ((congrArg _ hop).trans (CategoryTheory.Category.comp_id _))))
    let θ : L_mid ≅ L'_S :=
      { hom := θ_hom, inv := θ_inv, hom_inv_id := hθ_hom_inv, inv_hom_id := hθ_inv_hom }
    obtain ⟨ϕ_S, hϕ_char, hϕ_counit⟩ := hFreePull e_S.inv V n₀
    let Ψ : pb.obj L_S ≅ L'_S := ϕ_S ≪≫ θ
    refine ⟨ψ_hat, Ψ, hψ_fst, ?_, ?_⟩
    · intro 𝒢 f
      exact (congrArg (fun m => CategoryTheory.Sheaf.freeYonedaHomEquiv (adj.homEquiv L_S 𝒢 m))
        (CategoryTheory.Category.assoc ϕ_S.hom θ_hom f)).trans
        ((hϕ_char 𝒢 (θ_hom ≫ f)).trans (hLocalMap_comp ψ_hat.inv f))
    · exact (CategoryTheory.Category.assoc ϕ_S.hom θ_hom
        (weilGysinLocalTorsionCounit S' n₀ V')).trans
        ((congrArg (ϕ_S.hom ≫ ·) (hLocalMap_counit ψ_hat.inv)).trans
          ((congrArg (ϕ_S.hom ≫ ·) hϕ_counit.symm).trans
            (CategoryTheory.Iso.hom_inv_id_assoc ϕ_S _)))

  
  have hSiteMap_fst : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Y₁ ⟶ Y₂)
      {A₁ A₂ : Y₂.Etale} (g : A₁ ⟶ A₂),
      ((AlgebraicGeometry.Scheme.Etale.forget Y₁).map ((weilEtaleSitePullback h).map g)).left ≫
        CategoryTheory.Limits.pullback.fst
          ((AlgebraicGeometry.Scheme.Etale.forget Y₂).obj A₂).hom h =
      CategoryTheory.Limits.pullback.fst
        ((AlgebraicGeometry.Scheme.Etale.forget Y₂).obj A₁).hom h ≫
        ((AlgebraicGeometry.Scheme.Etale.forget Y₂).map g).left := by
    intro Y₁ Y₂ h A₁ A₂ g
    exact (congrArg (· ≫ _)
      (CategoryTheory.MorphismProperty.Over.pullback_map_left
        (@AlgebraicGeometry.Etale) ⊤ h g)).trans
      (CategoryTheory.Limits.pullback.lift_fst _ _ _)

  have hSiteComp_fst : ∀ {Y₁ Y₂ Y₃ : AlgebraicGeometry.Scheme.{u}}
