      have hρ₄₅_et : ρ₄₅.Etale := by
        letI : Algebra (MvPolynomial (Fin d) k) (MvPolynomial (Fin d) A₁) :=
          (MvPolynomial.map (algebraMap k A₁)).toAlgebra
        letI : Algebra (MvPolynomial (Fin d) k) A₂ := g₂.toAlgebra
        have : Algebra.Etale (MvPolynomial (Fin d) k) A₂ := RingHom.etale_algebraMap.mp hg₂_et
