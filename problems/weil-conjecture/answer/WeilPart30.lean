            (v₂ : G_aff.obj d₂ ⟶ W) (δ₂ : LiftF.obj d₂),
            δ₁.1 ≫ v₁.left = δ → δ₂.1 ≫ v₂.left = δ →
            (ℱ₂.obj.map v₁.op ≫ CategoryTheory.Limits.colimit.ι D_stalk
