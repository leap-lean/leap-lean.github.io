        _ = e_W.inv ≫ ((π ≫ e_P.hom) ≫ e_P.inv) := by rw [CategoryTheory.Category.assoc]
        _ = e_W.inv ≫ ((e_W.hom ≫ π') ≫ e_P.inv) := by rw [hcomm_P]
