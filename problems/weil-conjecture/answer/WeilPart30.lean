            rw [hm]
            refine Fin.addCases (fun i => ?_) (fun j => ?_) m'
            · simp only [RingHom.comp_apply, RingHom.id_apply]
              rw [htr2d_X, hFinCastCancel h2d, Fin.addCases_left, map_sub,
                htr2d_inv_X, htr2d_inv_C, hFinCastCancel h2d, Fin.addCases_left,
                add_sub_cancel_right]
            · simp only [RingHom.comp_apply, RingHom.id_apply]
              rw [htr2d_X, hFinCastCancel h2d, Fin.addCases_right,
                htr2d_inv_X, hFinCastCancel h2d, Fin.addCases_right]
      haveI : CategoryTheory.IsIso T_d := hTd_iso
      have hTd_str : T_d ≫ weilGysinAffineStruct k d = weilGysinAffineStruct k d := by
        refine (AlgebraicGeometry.Spec.map_comp _ _).symm.trans
          (congrArg AlgebraicGeometry.Spec.map ?_)
        apply CommRingCat.hom_ext; ext r; simp [tr_d]
      have hT2d_str : T_2d ≫ weilGysinAffineStruct k (2 * d) =
          weilGysinAffineStruct k (2 * d) := by
        refine (AlgebraicGeometry.Spec.map_comp _ _).symm.trans
          (congrArg AlgebraicGeometry.Spec.map ?_)
        apply CommRingCat.hom_ext; ext r; simp [htr2d_C]
      have hT2d_prR : T_2d ≫ weilGysinAffineProjRight k d d (2 * d) h2d =
          weilGysinAffineProjRight k d d (2 * d) h2d := by
        refine (AlgebraicGeometry.Spec.map_comp _ _).symm.trans
          (congrArg AlgebraicGeometry.Spec.map ?_)
        change CommRingCat.ofHom
            (MvPolynomial.rename (fun j : Fin d => Fin.cast h2d (Fin.natAdd d j))).toRingHom ≫
          CommRingCat.ofHom tr_2d =
          CommRingCat.ofHom
            (MvPolynomial.rename (fun j : Fin d => Fin.cast h2d (Fin.natAdd d j))).toRingHom
        rw [← CommRingCat.ofHom_comp]
        congr 1; apply MvPolynomial.ringHom_ext
        · intro r; simp [htr2d_C]
        · intro j
          simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
            MvPolynomial.rename_X]
          rw [htr2d_X, hFinCastCancel h2d, Fin.addCases_right]
      have hAx_T : weilGysinAffineLeftAxis k d d (2 * d) h2d ≫ T_2d =
          T_d ≫ weilGysinAffineLeftAxis k d d (2 * d) h2d := by
        let f_ax : MvPolynomial (Fin (2 * d)) k →+* MvPolynomial (Fin d) k :=
          MvPolynomial.eval₂Hom MvPolynomial.C
            (fun m : Fin (2 * d) => Fin.addCases (fun i : Fin d => MvPolynomial.X i)
              (fun _ : Fin d => 0) (Fin.cast h2d.symm m))
        have hf_ax_X : ∀ m : Fin (2 * d),
            f_ax (MvPolynomial.X m) =
              Fin.addCases (fun i : Fin d => MvPolynomial.X i) (fun _ : Fin d => 0)
                (Fin.cast h2d.symm m) :=
          MvPolynomial.eval₂Hom_X' _ _
        have hf_ax_C : ∀ r : k, f_ax (MvPolynomial.C r) = MvPolynomial.C r :=
          MvPolynomial.eval₂Hom_C _ _
        have htrd_X : ∀ i : Fin d,
            tr_d (MvPolynomial.X i) = MvPolynomial.X i - MvPolynomial.C (a i) :=
          MvPolynomial.eval₂Hom_X' _ _
        have htrd_C : ∀ r : k, tr_d (MvPolynomial.C r) = MvPolynomial.C r :=
          MvPolynomial.eval₂Hom_C _ _
        refine (AlgebraicGeometry.Spec.map_comp _ _).symm.trans
          ((congrArg AlgebraicGeometry.Spec.map ?_).trans (AlgebraicGeometry.Spec.map_comp _ _))
        change CommRingCat.ofHom tr_2d ≫ CommRingCat.ofHom f_ax =
          CommRingCat.ofHom f_ax ≫ CommRingCat.ofHom tr_d
        rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
        congr 1; apply MvPolynomial.ringHom_ext
        · intro r; simp [htr2d_C, hf_ax_C, htrd_C]
        · intro m
          let m' : Fin (d + d) := Fin.cast h2d.symm m
          have hm : m = Fin.cast h2d m' := by ext; simp [m']
          rw [hm]
          refine Fin.addCases (fun i => ?_) (fun j => ?_) m'
          · simp only [RingHom.comp_apply]
            rw [htr2d_X, hFinCastCancel h2d, Fin.addCases_left, map_sub,
              hf_ax_X, hf_ax_C, hFinCastCancel h2d, Fin.addCases_left, htrd_X]
          · simp only [RingHom.comp_apply]
            rw [htr2d_X, hFinCastCancel h2d, Fin.addCases_right,
              hf_ax_X, hFinCastCancel h2d, Fin.addCases_right, map_zero]
      have hu_sh_str : (u₁₂_ν ≫ T_d) ≫ weilGysinAffineStruct k d = U₁₂.ι ≫ X.hom := by
        rw [CategoryTheory.Category.assoc, hTd_str]
        dsimp [u₁₂_ν]
        rw [CategoryTheory.Category.assoc, hu_str, ← CategoryTheory.Category.assoc,
          X.left.homOfLE_ι hU₁₂_le_ν]
      have hu_sh_orig : s_U₁₂ ≫ (u₁₂_ν ≫ T_d) = weilGysinAffineOrigin k d := by
        have htrd_X : ∀ i : Fin d,
            tr_d (MvPolynomial.X i) = MvPolynomial.X i - MvPolynomial.C (a i) :=
          MvPolynomial.eval₂Hom_X' _ _
        have htrd_C : ∀ r : k, tr_d (MvPolynomial.C r) = MvPolynomial.C r :=
          MvPolynomial.eval₂Hom_C _ _
        rw [← CategoryTheory.Category.assoc]
        refine (congrArg (· ≫ T_d) hev_spec.symm).trans ?_
        refine (AlgebraicGeometry.Spec.map_comp _ _).symm.trans
          (congrArg AlgebraicGeometry.Spec.map ?_)
        change CommRingCat.ofHom tr_d ≫ ev_ν_mor =
          CommRingCat.ofHom (MvPolynomial.eval (0 : Fin d → k))
        apply CommRingCat.hom_ext; apply MvPolynomial.ringHom_ext
        · intro r
          simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply,
            MvPolynomial.eval_C]
          rw [htrd_C, hev_C r]
        · intro i
          simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply,
            MvPolynomial.eval_X, Pi.zero_apply]
          rw [htrd_X, map_sub, hev_C (a i)]
          exact sub_self (a i)
      exact ⟨T_d, T_2d, hTd_iso, hT2d_iso, hTd_str, hT2d_str, hT2d_prR, hAx_T,
        inferInstance, hu_sh_str, hu_sh_orig⟩

    obtain ⟨T_d1, T_2d1, hTd1_iso, hT2d1_iso, hTd1_str, hT2d1_str, hT2d1_prR, hAx_T1,
      hu_sh1_et, hu_sh1_str, hu_sh1_orig⟩ :=
      hShiftPkg U₁ hU₁₂_le₁ u₁ hTub₁.2.2.2.1 hTub₁.2.2.2.2.1
    obtain ⟨T_d2, T_2d2, hTd2_iso, hT2d2_iso, hTd2_str, hT2d2_str, hT2d2_prR, hAx_T2,
      hu_sh2_et, hu_sh2_str, hu_sh2_orig⟩ :=
      hShiftPkg U₂ hU₁₂_le₂ u₂ hTub₂.2.2.2.1 hTub₂.2.2.2.2.1
    let u_sh_1 := (X.left.homOfLE hU₁₂_le₁ ≫ u₁) ≫ T_d1
    let u_sh_2 := (X.left.homOfLE hU₁₂_le₂ ≫ u₂) ≫ T_d2
    haveI : AlgebraicGeometry.Etale u_sh_1 := hu_sh1_et
    haveI : AlgebraicGeometry.Etale u_sh_2 := hu_sh2_et
    obtain ⟨U_a, hUa_le, s_Ua, hChart_Ua_1⟩ :=
      hShrink d X.hom s_z U₁₂ s_U₁₂ hs_U₁₂ u_sh_1 hu_sh1_et hu_sh1_str hu_sh1_orig
    have hs_Ua_comp : s_Ua ≫ X.left.homOfLE hUa_le = s_U₁₂ := by
      apply (inferInstance : CategoryTheory.Mono U₁₂.ι).right_cancellation
      rw [CategoryTheory.Category.assoc, X.left.homOfLE_ι hUa_le, hChart_Ua_1.2.2.1, hs_U₁₂]
    have hu_a2_str : (X.left.homOfLE hUa_le ≫ u_sh_2) ≫ weilGysinAffineStruct k d =
        U_a.ι ≫ X.hom := by
      rw [CategoryTheory.Category.assoc, hu_sh2_str, ← CategoryTheory.Category.assoc,
        X.left.homOfLE_ι hUa_le]
    have hu_a2_orig : s_Ua ≫ (X.left.homOfLE hUa_le ≫ u_sh_2) = weilGysinAffineOrigin k d := by
      rw [← CategoryTheory.Category.assoc, hs_Ua_comp, hu_sh2_orig]
    obtain ⟨U_star, hUstar_le_Ua, s_Ustar, hOrig_u2_raw⟩ :=
      hShrink d X.hom s_z U_a s_Ua hChart_Ua_1.2.2.1 (X.left.homOfLE hUa_le ≫ u_sh_2)
        inferInstance hu_a2_str hu_a2_orig
    let hU_star : U_star ≤ U₁₂ := le_trans hUstar_le_Ua hUa_le
    let u'₁ := X.left.homOfLE hU_star ≫ u_sh_1
    let u'₂ := X.left.homOfLE hU_star ≫ u_sh_2
    have hu'₂_eq : X.left.homOfLE hUstar_le_Ua ≫ (X.left.homOfLE hUa_le ≫ u_sh_2) = u'₂ := by
      rw [← CategoryTheory.Category.assoc, hHomOfLE_comp]
    have hOrig_u2 : WeilGysinIsEtaleOriginChart d X.hom s_z U_star s_Ustar u'₂ := by
      rwa [hu'₂_eq] at hOrig_u2_raw
    have hu'₁_eq : X.left.homOfLE hUstar_le_Ua ≫ (X.left.homOfLE hUa_le ≫ u_sh_1) = u'₁ := by
      rw [← CategoryTheory.Category.assoc, hHomOfLE_comp]
    have hOrig_u1 : WeilGysinIsEtaleOriginChart d X.hom s_z U_star s_Ustar u'₁ := by
      have hs_j : 𝟙 S_k ≫ s_Ua = s_Ustar ≫ X.left.homOfLE hUstar_le_Ua := by
        apply (inferInstance : CategoryTheory.Mono U_a.ι).right_cancellation
        rw [CategoryTheory.Category.id_comp, hChart_Ua_1.2.2.1, CategoryTheory.Category.assoc,
          X.left.homOfLE_ι hUstar_le_Ua, hOrig_u2.2.2.1]
      have hpb_j : CategoryTheory.IsPullback s_Ustar (𝟙 S_k)
          (X.left.homOfLE hUstar_le_Ua) s_Ua := by
        apply AlgebraicGeometry.IsOpenImmersion.isPullback s_Ustar (𝟙 S_k)
          (X.left.homOfLE hUstar_le_Ua) s_Ua hs_j
        ext pt
        change s_Ua.base pt ∈ Set.range (X.left.homOfLE hUstar_le_Ua).base ↔
          pt ∈ Set.range (CategoryTheory.CategoryStruct.id S_k).base
        have hmem : s_Ua.base pt ∈ Set.range (X.left.homOfLE hUstar_le_Ua).base := by
          have hpt := congrArg (fun φ => φ.base pt) hs_j
          exact ⟨s_Ustar.base pt, hpt.symm⟩
        exact ⟨fun _ => ⟨pt, rfl⟩, fun _ => hmem⟩
      have hpb_u1 : CategoryTheory.IsPullback s_Ustar (𝟙 S_k) u'₁ (weilGysinAffineOrigin k d) := by
        have hp := hpb_j.paste_vert hChart_Ua_1.2.2.2
        rwa [CategoryTheory.Category.id_comp, hu'₁_eq] at hp
      refine ⟨inferInstance, ?_, hOrig_u2.2.2.1, hpb_u1⟩
      dsimp [u'₁]
      rw [CategoryTheory.Category.assoc, hu_sh1_str, ← CategoryTheory.Category.assoc,
        X.left.homOfLE_ι hU_star]
    let V_star : P.Opens := V₁₂ ⊓ (TopologicalSpace.Opens.map p₁.base).obj U_star
    let hV_star : V_star ≤ V₁₂ := inf_le_left
    let g_Ustar : U_star.toScheme ⟶ U₁₂.toScheme := X.left.homOfLE hU_star
    have hpre_star : Γ_φ.base ⁻¹' (V_star : Set P) = (U_star : Set X.left) := by
      ext y
      have hΓ_p₁ : p₁.base (Γ_φ.base y) = y := by
        have hc : Γ_φ ≫ p₁ = 𝟙 X.left := CategoryTheory.Limits.pullback.lift_fst _ _ _
        exact congrArg (fun h => h.base y) hc
      change Γ_φ.base y ∈ V₁₂ ∧ p₁.base (Γ_φ.base y) ∈ U_star ↔ y ∈ U_star
      rw [hΓ_p₁]
      exact ⟨fun h => h.2, fun hy => ⟨hU_star hy, hy⟩⟩
    have hγ_star_range : Set.range (U_star.ι ≫ Γ_φ).base ⊆ Set.range V_star.ι.base := by
      rw [V_star.range_ι]
      rintro _ ⟨w, rfl⟩
      change Γ_φ.base (U_star.ι.base w) ∈ (V_star : Set P)
      rw [← Set.mem_preimage, hpre_star, ← U_star.range_ι]
      exact ⟨w, rfl⟩
    let γ_star : U_star.toScheme ⟶ V_star.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift V_star.ι (U_star.ι ≫ Γ_φ) hγ_star_range
    have hγ_star_ι : γ_star ≫ V_star.ι = U_star.ι ≫ Γ_φ :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac V_star.ι (U_star.ι ≫ Γ_φ) hγ_star_range
    let γ₁₂ := Γ_φ.resLE V₁₂ U₁₂ (le_refl _)
    have hpb_star : CategoryTheory.IsPullback γ_star g_Ustar (P.homOfLE hV_star) γ₁₂ := by
      have hcomm_star : g_Ustar ≫ γ₁₂ = γ_star ≫ P.homOfLE hV_star := by
        apply (inferInstance : CategoryTheory.Mono V₁₂.ι).right_cancellation
        rw [CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.Hom.resLE_comp_ι,
          ← CategoryTheory.Category.assoc, X.left.homOfLE_ι hU_star, CategoryTheory.Category.assoc,
          P.homOfLE_ι hV_star, hγ_star_ι]
      apply AlgebraicGeometry.IsOpenImmersion.isPullback γ_star g_Ustar (P.homOfLE hV_star)
        γ₁₂ hcomm_star
      ext y
      change γ₁₂.base y ∈ Set.range (P.homOfLE hV_star).base ↔ y ∈ Set.range g_Ustar.base
      rw [hMemHomOfLE hV_star, hMemHomOfLE hU_star]
      have hy_eq : V₁₂.ι.base (γ₁₂.base y) = Γ_φ.base (U₁₂.ι.base y) :=
        congrArg (fun h => h.base y) (AlgebraicGeometry.Scheme.Hom.resLE_comp_ι Γ_φ (le_refl _))
      rw [hy_eq, ← Set.mem_preimage, hpre_star]
    have hBuild2d : ∀ (U_ν : X.left.Opens) (V_ν : P.Opens)
        (γ_ν : U_ν.toScheme ⟶ V_ν.toScheme)
        (p₁_Vν : V_ν.toScheme ⟶ U_ν.toScheme)
        (u_ν : U_ν.toScheme ⟶ weilGysinAffineSpace k d)
        (v_ν : V_ν.toScheme ⟶ weilGysinAffineSpace k d)
        (Ψ_ν : V_ν.toScheme ⟶ weilGysinAffineSpace k (2 * d)),
        WeilGysinIsTubularGraphChart d X Γ_φ U_ν V_ν γ_ν p₁_Vν u_ν v_ν Ψ_ν →
        ∀ (hU₁₂_le_ν : U₁₂ ≤ U_ν) (hV_star_ν : V_star ≤ V_ν)
          (T_dν : weilGysinAffineSpace k d ⟶ weilGysinAffineSpace k d)
          (T_2dν : weilGysinAffineSpace k (2 * d) ⟶ weilGysinAffineSpace k (2 * d)),
          CategoryTheory.IsIso T_2dν →
          T_2dν ≫ weilGysinAffineStruct k (2 * d) = weilGysinAffineStruct k (2 * d) →
          T_2dν ≫ weilGysinAffineProjRight k d d (2 * d) h2d =
            weilGysinAffineProjRight k d d (2 * d) h2d →
          weilGysinAffineLeftAxis k d d (2 * d) h2d ≫ T_2dν =
            T_dν ≫ weilGysinAffineLeftAxis k d d (2 * d) h2d →
          let u'_ν := X.left.homOfLE hU_star ≫ ((X.left.homOfLE hU₁₂_le_ν ≫ u_ν) ≫ T_dν)
          let Ψ'_ν := P.homOfLE hV_star_ν ≫ (Ψ_ν ≫ T_2dν)
          WeilGysinIsEtaleOriginChart d X.hom s_z U_star s_Ustar u'_ν →
          WeilGysinIsEtaleOriginChart (2 * d) (p₁ ≫ X.hom) (s_z ≫ Γ_φ)
            V_star (s_Ustar ≫ γ_star) Ψ'_ν ∧
          CategoryTheory.IsPullback γ_star u'_ν Ψ'_ν
            (weilGysinAffineLeftAxis k d d (2 * d) h2d) ∧
          Ψ'_ν ≫ weilGysinAffineProjRight k d d (2 * d) h2d =
            P.homOfLE hV_star_ν ≫ v_ν := by
      intro U_ν V_ν γ_ν p₁_Vν u_ν v_ν Ψ_ν hTub_ν hU₁₂_le_ν hV_star_ν T_dν T_2dν
        hT2d_iso hT2d_str hT2d_prR hAx_T u'_ν Ψ'_ν hOrig_uν
      rcases hTub_ν with ⟨hpre_ν, hγ_ν_ι, _, _, _, _, _, hΨ_ν_et, hΨ_ν_str,
        hpb_v_ν, _, hΨ_ν_right, hγ_ν_Ψ⟩
      haveI : AlgebraicGeometry.Etale Ψ_ν := hΨ_ν_et
      haveI : CategoryTheory.IsIso T_2dν := hT2d_iso
      let hU_star_ν : U_star ≤ U_ν := le_trans hU_star hU₁₂_le_ν
      have hcomm_γν : X.left.homOfLE hU_star_ν ≫ γ_ν = γ_star ≫ P.homOfLE hV_star_ν := by
        apply (inferInstance : CategoryTheory.Mono V_ν.ι).right_cancellation
        rw [CategoryTheory.Category.assoc, hγ_ν_ι, ← CategoryTheory.Category.assoc,
          X.left.homOfLE_ι hU_star_ν, CategoryTheory.Category.assoc, P.homOfLE_ι hV_star_ν,
          hγ_star_ι]
      have hpb_γν_star : CategoryTheory.IsPullback γ_star (X.left.homOfLE hU_star_ν)
          (P.homOfLE hV_star_ν) γ_ν := by
        apply AlgebraicGeometry.IsOpenImmersion.isPullback γ_star (X.left.homOfLE hU_star_ν)
          (P.homOfLE hV_star_ν) γ_ν hcomm_γν
        ext y
        change γ_ν.base y ∈ Set.range (P.homOfLE hV_star_ν).base ↔
          y ∈ Set.range (X.left.homOfLE hU_star_ν).base
        rw [hMemHomOfLE hV_star_ν, hMemHomOfLE hU_star_ν]
        have hy_eq : V_ν.ι.base (γ_ν.base y) = Γ_φ.base (U_ν.ι.base y) :=
          congrArg (fun h => h.base y) hγ_ν_ι
        rw [hy_eq, ← Set.mem_preimage, hpre_star]
      have hpb_v_star : CategoryTheory.IsPullback γ_star (U_star.ι ≫ X.hom)
          (P.homOfLE hV_star_ν ≫ v_ν) (weilGysinAffineOrigin k d) := by
        have hp := hpb_γν_star.paste_vert hpb_v_ν
        rwa [← CategoryTheory.Category.assoc, X.left.homOfLE_ι hU_star_ν] at hp
      have hproj_Ψν : Ψ'_ν ≫ weilGysinAffineProjRight k d d (2 * d) h2d =
          P.homOfLE hV_star_ν ≫ v_ν := by
        dsimp [Ψ'_ν]
        rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hT2d_prR, hΨ_ν_right]
      have hcomm_Ψν : γ_star ≫ Ψ'_ν = u'_ν ≫ weilGysinAffineLeftAxis k d d (2 * d) h2d := by
        dsimp [Ψ'_ν, u'_ν]
        calc
          γ_star ≫ (P.homOfLE hV_star_ν ≫ (Ψ_ν ≫ T_2dν)) =
              (γ_star ≫ P.homOfLE hV_star_ν) ≫ Ψ_ν ≫ T_2dν := by
            simp only [CategoryTheory.Category.assoc]
          _ = (X.left.homOfLE hU_star_ν ≫ γ_ν) ≫ Ψ_ν ≫ T_2dν := by rw [← hcomm_γν]
          _ = X.left.homOfLE hU_star_ν ≫ (γ_ν ≫ Ψ_ν) ≫ T_2dν := by
            simp only [CategoryTheory.Category.assoc]
          _ = X.left.homOfLE hU_star_ν ≫ u_ν ≫
              (weilGysinAffineLeftAxis k d d (2 * d) h2d ≫ T_2dν) := by
            rw [hγ_ν_Ψ]; simp only [CategoryTheory.Category.assoc]
          _ = X.left.homOfLE hU_star_ν ≫ u_ν ≫
              (T_dν ≫ weilGysinAffineLeftAxis k d d (2 * d) h2d) := by
            rw [hAx_T]
          _ = (X.left.homOfLE hU_star ≫ ((X.left.homOfLE hU₁₂_le_ν ≫ u_ν) ≫ T_dν)) ≫
              weilGysinAffineLeftAxis k d d (2 * d) h2d := by
            rw [← hHomOfLE_comp hU_star hU₁₂_le_ν]
            simp only [CategoryTheory.Category.assoc]
      have hpb_Ψν : CategoryTheory.IsPullback γ_star u'_ν Ψ'_ν
          (weilGysinAffineLeftAxis k d d (2 * d) h2d) := by
        apply hPb_of_bot _ hcomm_Ψν (hpb_aff_axis d d (2 * d) h2d)
        rw [hOrig_uν.2.1, hproj_Ψν]
        exact hpb_v_star
      have hOrig_Ψν : WeilGysinIsEtaleOriginChart (2 * d) (p₁ ≫ X.hom) (s_z ≫ Γ_φ)
          V_star (s_Ustar ≫ γ_star) Ψ'_ν := by
        refine ⟨inferInstance, ?_, ?_, ?_⟩
        · dsimp [Ψ'_ν]
          rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hT2d_str, hΨ_ν_str,
            ← CategoryTheory.Category.assoc, P.homOfLE_ι hV_star_ν]
        · rw [CategoryTheory.Category.assoc, hγ_star_ι, ← CategoryTheory.Category.assoc,
            hOrig_uν.2.2.1]
        · have hp := CategoryTheory.IsPullback.paste_horiz hOrig_uν.2.2.2 hpb_Ψν
          rwa [horig_axis d d (2 * d) h2d] at hp
      exact ⟨hOrig_Ψν, hpb_Ψν, hproj_Ψν⟩

    obtain ⟨hOrig_Ψ1, hpb_Ψ1, hproj_Ψ1⟩ :=
      hBuild2d U₁ V₁ γ₁ p₁_V₁ u₁ v₁ Ψ₁ hTub₁ hU₁₂_le₁ (le_trans hV_star inf_le_left)
        T_d1 T_2d1 hT2d1_iso hT2d1_str hT2d1_prR hAx_T1 hOrig_u1
    obtain ⟨hOrig_Ψ2, hpb_Ψ2, hproj_Ψ2⟩ :=
      hBuild2d U₂ V₂ γ₂ p₁_V₂ u₂ v₂ Ψ₂ hTub₂ hU₁₂_le₂ (le_trans hV_star inf_le_right)
        T_d2 T_2d2 hT2d2_iso hT2d2_str hT2d2_prR hAx_T2 hOrig_u2
    exact ⟨hU₁₂_conn, s_z, U_star, V_star, hV_star, s_Ustar, γ_star, g_Ustar, u'₁, u'₂,
      P.homOfLE (le_trans hV_star inf_le_left) ≫ (Ψ₁ ≫ T_2d1),
      P.homOfLE (le_trans hV_star inf_le_right) ≫ (Ψ₂ ≫ T_2d2),
      hs_z, hpb_star, hOrig_u1, hOrig_u2, hOrig_Ψ1, hOrig_Ψ2,
      hpb_Ψ1, hpb_Ψ2, hproj_Ψ1, hproj_Ψ2⟩

  exact ⟨⟨hP_int, inferInstance, h0_cl, hAxis_cl, hSec_cl, hOrigAxis0, hOrigSub⟩,
