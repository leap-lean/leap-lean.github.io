            let δ₁₂ := CategoryTheory.Limits.pullback.lift δ₁.1 δ₂.1 (δ₁.2.trans δ₂.2.symm)
            have hδ₁₂ : δ₁₂ ≫ W₁₂.hom = ξ :=
