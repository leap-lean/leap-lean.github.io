  have hCardSE : ∀ {G₁ G₂ G₃ : Type u} [AddCommGroup G₁] [AddCommGroup G₂] [AddCommGroup G₃]
      (α : G₁ →+ G₂) (β : G₂ →+ G₃),
      Function.Injective α → Function.Surjective β →
      (∀ y : G₂, β y = 0 → ∃ x : G₁, α x = y) →
      (∀ x : G₁, β (α x) = 0) →
      Finite G₁ → Finite G₃ →
      Finite G₂ ∧ Nat.card G₂ = Nat.card G₃ * Nat.card G₁ := by
    intro G₁ G₂ G₃ _ _ _ α β hInj hSurj hEx hComp hFin₁ hFin₃
    have _ := hFin₁; have _ := hFin₃
    let e_ker : G₁ ≃ ↥β.ker :=
      { toFun := fun x => ⟨α x, β.mem_ker.mpr (hComp x)⟩
        invFun := fun y => Classical.choose (hEx y.1 (β.mem_ker.mp y.2))
        left_inv := fun x => hInj (Classical.choose_spec (hEx (α x) (hComp x)))
        right_inv := fun y => Subtype.ext (Classical.choose_spec (hEx y.1 (β.mem_ker.mp y.2))) }
    let s_sec : G₃ → G₂ := fun z => Classical.choose (hSurj z)
    have hs_sec : ∀ z : G₃, β (s_sec z) = z := fun z => Classical.choose_spec (hSurj z)
    have hsub_ker : ∀ y : G₂, β (y - s_sec (β y)) = 0 := by
      intro y; rw [map_sub, hs_sec, sub_self]
    let k_of : G₂ → G₁ := fun y => Classical.choose (hEx (y - s_sec (β y)) (hsub_ker y))
    have hk_of : ∀ y : G₂, α (k_of y) = y - s_sec (β y) :=
      fun y => Classical.choose_spec (hEx (y - s_sec (β y)) (hsub_ker y))
    let e_prod : G₂ ≃ G₃ × G₁ :=
      { toFun := fun y => (β y, k_of y)
        invFun := fun p => s_sec p.1 + α p.2
        left_inv := fun y => by dsimp only; rw [hk_of y]; abel
        right_inv := fun ⟨z, x⟩ => by
          dsimp only
          have hβ : β (s_sec z + α x) = z := by rw [map_add, hs_sec z, hComp x, add_zero]
          refine Prod.ext hβ (hInj ?_)
          rw [hk_of (s_sec z + α x), hβ]; abel }
    have hFin₂ : Finite G₂ := Finite.of_equiv (G₃ × G₁) e_prod.symm
    let e_quot : G₂ ⧸ β.ker ≃+ G₃ := QuotientAddGroup.quotientKerEquivOfSurjective β hSurj
    refine ⟨hFin₂, ?_⟩
    rw [AddSubgroup.card_eq_card_quotient_mul_card_addSubgroup β.ker,
      Nat.card_congr e_quot.toEquiv, Nat.card_congr e_ker.symm]

  
