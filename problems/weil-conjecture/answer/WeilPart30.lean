            (ℱ₂.obj.map v₂.op ≫ CategoryTheory.Limits.colimit.ι D_stalk
              (Opposite.op (CategoryTheory.Functor.elementsMk LiftF d₂ δ₂))) := by
          intro W δ d₁ d₂ v₁ δ₁ v₂ δ₂ h₁ h₂
          have _ : AlgebraicGeometry.Etale v₁.left :=
            CategoryTheory.MorphismProperty.of_postcomp (W := etaleProp) (W' := etaleProp)
              v₁.left W.hom W.prop ((CategoryTheory.MorphismProperty.Over.w v₁).symm ▸ (G_aff.obj d₁).prop)
          have _ : AlgebraicGeometry.Etale (G_aff.obj d₂).hom := (G_aff.obj d₂).prop
          let π₁ := CategoryTheory.Limits.pullback.fst v₁.left v₂.left
          let π₂ := CategoryTheory.Limits.pullback.snd v₁.left v₂.left
          have _ : AlgebraicGeometry.Etale π₂ := inferInstance
          let W₁₂ : S.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤
            (π₂ ≫ (G_aff.obj d₂).hom) inferInstance
          let δ₁₂ := CategoryTheory.Limits.pullback.lift δ₁.1 δ₂.1 (h₁.trans h₂.symm)
          have hδ₁₂ : δ₁₂ ≫ W₁₂.hom = ξ :=
            (CategoryTheory.Category.assoc δ₁₂ π₂ _).symm.trans
              ((congrArg (· ≫ _) (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans δ₂.2)
          obtain ⟨d₃, v₃, δ₃, hδ₃⟩ := hShrink W₁₂ δ₁₂ hδ₁₂
          let u₁ : d₃ ⟶ d₁ := CategoryTheory.InducedCategory.homMk
            (CategoryTheory.MorphismProperty.Over.homMk (v₃.left ≫ π₁)
              ((CategoryTheory.Category.assoc v₃.left π₁ _).trans
                ((congrArg (v₃.left ≫ ·)
                  ((congrArg (π₁ ≫ ·) (CategoryTheory.MorphismProperty.Over.w v₁).symm).trans
                    ((CategoryTheory.Category.assoc π₁ v₁.left W.hom).symm.trans
                      ((congrArg (· ≫ W.hom) CategoryTheory.Limits.pullback.condition).trans
                        ((CategoryTheory.Category.assoc π₂ v₂.left W.hom).trans
