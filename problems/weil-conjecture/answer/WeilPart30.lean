      {Y' Y : AlgebraicGeometry.Scheme.{u}}
      [CategoryTheory.Abelian (CategoryTheory.Sheaf Y'.smallEtaleTopology 𝒟)]
      [CategoryTheory.Abelian (CategoryTheory.Sheaf Y.smallEtaleTopology 𝒟)]
      [CategoryTheory.Limits.ReflectsFiniteLimits
        (CategoryTheory.sheafToPresheaf Y'.smallEtaleTopology 𝒟)]
      [CategoryTheory.HasWeakSheafify Y'.smallEtaleTopology 𝒟]
      [CategoryTheory.HasWeakSheafify Y.smallEtaleTopology 𝒟]
      (M_g : CategoryTheory.Functor Y'.Etale Y.Etale)
      (B_g : CategoryTheory.Functor Y.Etale Y'.Etale)
      [M_g.IsContinuous Y'.smallEtaleTopology Y.smallEtaleTopology]
      [B_g.IsContinuous Y.smallEtaleTopology Y'.smallEtaleTopology]
      (adj_MB : CategoryTheory.Adjunction M_g B_g),
      let g_res := M_g.sheafPushforwardContinuous 𝒟 Y'.smallEtaleTopology Y.smallEtaleTopology
      let g_push := B_g.sheafPushforwardContinuous 𝒟 Y.smallEtaleTopology Y'.smallEtaleTopology
      ∃ (adj_rp : CategoryTheory.Adjunction g_res g_push)
        (_ : g_res.Additive)
        (_ : CategoryTheory.Limits.PreservesFiniteLimits g_res)
        (_ : CategoryTheory.Limits.PreservesFiniteColimits g_res),
        ∀ (A : 𝒟),
          let C_Y' := CategoryTheory.constantSheaf Y'.smallEtaleTopology 𝒟
          let C_Y := CategoryTheory.constantSheaf Y.smallEtaleTopology 𝒟
          let T_Y' := weilEtaleIdTerminal.{u} Y'
          let hT_Y' := weilEtaleIdTerminalIsTerminal.{u} Y'
          let T_Y := weilEtaleIdTerminal.{u} Y
          let hT_Y := weilEtaleIdTerminalIsTerminal.{u} Y
          let adj_Y' := CategoryTheory.constantSheafAdj Y'.smallEtaleTopology 𝒟 hT_Y'
          let adj_Y := CategoryTheory.constantSheafAdj Y.smallEtaleTopology 𝒟 hT_Y
          let ι_A : Quiver.Hom (C_Y'.obj A) (g_res.obj (C_Y.obj A)) :=
            (adj_Y'.homEquiv A (g_res.obj (C_Y.obj A))).symm
              (adj_Y.unit.app A ≫ (C_Y.obj A).obj.map (Opposite.op (hT_Y.from (M_g.obj T_Y'))))
          let π_A : Quiver.Hom (g_res.obj (C_Y.obj A)) (C_Y'.obj A) :=
            (adj_rp.homEquiv (C_Y.obj A) (C_Y'.obj A)).symm
              ((adj_Y.homEquiv A (g_push.obj (C_Y'.obj A))).symm
                (adj_Y'.unit.app A ≫ (C_Y'.obj A).obj.map (Opposite.op (hT_Y'.from (B_g.obj T_Y)))))
          ι_A ≫ π_A = 𝟙 (C_Y'.obj A) ∧ π_A ≫ ι_A = 𝟙 (g_res.obj (C_Y.obj A)) := by
    intro 𝒟 _ _ _ Y' Y _ _ _ _ _ M_g B_g _ _ adj_MB
    let J_Y' := Y'.smallEtaleTopology
    let J_Y := Y.smallEtaleTopology
    let g_res := M_g.sheafPushforwardContinuous 𝒟 J_Y' J_Y
    let g_push := B_g.sheafPushforwardContinuous 𝒟 J_Y J_Y'
    let η_sp : CategoryTheory.Functor.id (CategoryTheory.Sheaf J_Y 𝒟) ⟶
        CategoryTheory.Functor.comp g_res g_push :=
      { app := fun Fsh => CategoryTheory.ObjectProperty.homMk
          { app := fun W => Fsh.obj.map (adj_MB.counit.app W.unop).op
            naturality := fun {W₁ W₂} α => by
              change (Fsh.obj.map α) ≫ (Fsh.obj.map (adj_MB.counit.app W₂.unop).op) =
                (Fsh.obj.map (adj_MB.counit.app W₁.unop).op) ≫
                  (Fsh.obj.map (M_g.map (B_g.map α.unop)).op)
              rw [← Fsh.obj.map_comp, ← Fsh.obj.map_comp, ← Quiver.Hom.op_unop α,
                ← op_comp, ← op_comp]
              exact congrArg (fun k => Fsh.obj.map k.op) (adj_MB.counit.naturality α.unop).symm }
        naturality := fun {F₁ F₂} φ =>
          (CategoryTheory.sheafToPresheaf J_Y 𝒟).map_injective
            (CategoryTheory.NatTrans.ext (funext fun W =>
              (φ.hom.naturality (adj_MB.counit.app W.unop).op).symm)) }
    let ε_sp : CategoryTheory.Functor.comp g_push g_res ⟶
        CategoryTheory.Functor.id (CategoryTheory.Sheaf J_Y' 𝒟) :=
      { app := fun Gsh => CategoryTheory.ObjectProperty.homMk
          { app := fun U => Gsh.obj.map (adj_MB.unit.app U.unop).op
            naturality := fun {U₁ U₂} β => by
              change (Gsh.obj.map (B_g.map (M_g.map β.unop)).op) ≫
                  (Gsh.obj.map (adj_MB.unit.app U₂.unop).op) =
                (Gsh.obj.map (adj_MB.unit.app U₁.unop).op) ≫ (Gsh.obj.map β)
              rw [← Gsh.obj.map_comp, ← Gsh.obj.map_comp, ← Quiver.Hom.op_unop β,
                ← op_comp, ← op_comp]
              exact congrArg (fun k => Gsh.obj.map k.op) (adj_MB.unit.naturality β.unop).symm }
        naturality := fun {G₁ G₂} ψ =>
          (CategoryTheory.sheafToPresheaf J_Y' 𝒟).map_injective
            (CategoryTheory.NatTrans.ext (funext fun U =>
              (ψ.hom.naturality (adj_MB.unit.app U.unop).op).symm)) }
    let adj_rp : CategoryTheory.Adjunction g_res g_push :=
      CategoryTheory.Adjunction.mkOfUnitCounit
        { unit := η_sp
          counit := ε_sp
          left_triangle := CategoryTheory.NatTrans.ext (funext fun Fsh =>
            (CategoryTheory.sheafToPresheaf J_Y' 𝒟).map_injective
              (CategoryTheory.NatTrans.ext (funext fun U =>
                (congrArg (Fsh.obj.map (adj_MB.counit.app (M_g.obj U.unop)).op ≫ ·)
                    (CategoryTheory.Category.id_comp
                      (Fsh.obj.map (M_g.map (adj_MB.unit.app U.unop)).op))).trans
                  ((Fsh.obj.map_comp _ _).symm.trans
                    ((congrArg Fsh.obj.map
                        (op_comp (f := M_g.map (adj_MB.unit.app U.unop))
                          (g := adj_MB.counit.app (M_g.obj U.unop))).symm).trans
                      ((congrArg (fun k => Fsh.obj.map k.op)
                          (adj_MB.left_triangle_components U.unop)).trans
                        (Fsh.obj.map_id _)))))))
          right_triangle := CategoryTheory.NatTrans.ext (funext fun Gsh =>
            (CategoryTheory.sheafToPresheaf J_Y 𝒟).map_injective
              (CategoryTheory.NatTrans.ext (funext fun W =>
                (congrArg (Gsh.obj.map (B_g.map (adj_MB.counit.app W.unop)).op ≫ ·)
                    (CategoryTheory.Category.id_comp
                      (Gsh.obj.map (adj_MB.unit.app (B_g.obj W.unop)).op))).trans
                  ((Gsh.obj.map_comp _ _).symm.trans
                    ((congrArg Gsh.obj.map
                        (op_comp (f := adj_MB.unit.app (B_g.obj W.unop))
                          (g := B_g.map (adj_MB.counit.app W.unop))).symm).trans
                      ((congrArg (fun k => Gsh.obj.map k.op)
                          (adj_MB.right_triangle_components W.unop)).trans
                        (Gsh.obj.map_id _))))))) }
    have hColim_res : CategoryTheory.Limits.PreservesFiniteColimits g_res :=
      (adj_rp.leftAdjoint_preservesColimits.{0, 0}).preservesFiniteColimits
    have hLim_res : CategoryTheory.Limits.PreservesFiniteLimits g_res := by
      have hComp : g_res ⋙ CategoryTheory.sheafToPresheaf J_Y' 𝒟 =
          CategoryTheory.sheafToPresheaf J_Y 𝒟 ⋙
            (CategoryTheory.Functor.whiskeringLeft _ _ 𝒟).obj M_g.op := rfl
      have : CategoryTheory.Limits.PreservesFiniteLimits
          (g_res ⋙ CategoryTheory.sheafToPresheaf J_Y' 𝒟) := by
        rw [hComp]
        exact CategoryTheory.Limits.comp_preservesFiniteLimits _ _
      exact CategoryTheory.Limits.preservesFiniteLimits_of_reflects_of_preserves
        g_res (CategoryTheory.sheafToPresheaf J_Y' 𝒟)
    have hAdd_res : g_res.Additive :=
      { map_add := fun {_ _ _ _} =>
          (CategoryTheory.sheafToPresheaf J_Y' 𝒟).map_injective
            (CategoryTheory.NatTrans.ext (funext fun _ => rfl)) }
    refine ⟨adj_rp, hAdd_res, hLim_res, hColim_res, fun A => ?_⟩
    let C_Y' := CategoryTheory.constantSheaf J_Y' 𝒟
    let C_Y := CategoryTheory.constantSheaf J_Y 𝒟
    let T_Y' := weilEtaleIdTerminal.{u} Y'
    let hT_Y' := weilEtaleIdTerminalIsTerminal.{u} Y'
    let T_Y := weilEtaleIdTerminal.{u} Y
    let hT_Y := weilEtaleIdTerminalIsTerminal.{u} Y
    let adj_Y' := CategoryTheory.constantSheafAdj J_Y' 𝒟 hT_Y'
    let adj_Y := CategoryTheory.constantSheafAdj J_Y 𝒟 hT_Y
    let F_Y' := (C_Y'.obj A).obj
    let F_Y := (C_Y.obj A).obj
    let μ : Quiver.Hom (M_g.obj T_Y') T_Y := hT_Y.from (M_g.obj T_Y')
    let τ : Quiver.Hom (B_g.obj T_Y) T_Y' := hT_Y'.from (B_g.obj T_Y)
    let ι_A : Quiver.Hom (C_Y'.obj A) (g_res.obj (C_Y.obj A)) :=
      (adj_Y'.homEquiv A (g_res.obj (C_Y.obj A))).symm (adj_Y.unit.app A ≫ F_Y.map μ.op)
    let q_A := (adj_Y.homEquiv A (g_push.obj (C_Y'.obj A))).symm (adj_Y'.unit.app A ≫ F_Y'.map τ.op)
    let π_A := (adj_rp.homEquiv (C_Y.obj A) (C_Y'.obj A)).symm q_A
    have hι_eq : adj_Y'.unit.app A ≫ ι_A.hom.app (Opposite.op T_Y') =
        adj_Y.unit.app A ≫ F_Y.map μ.op :=
      (CategoryTheory.Adjunction.homEquiv_unit adj_Y' A _ ι_A).symm.trans
        ((adj_Y'.homEquiv A _).apply_symm_apply _)
    have hq_eq : adj_Y.unit.app A ≫ q_A.hom.app (Opposite.op T_Y) =
        adj_Y'.unit.app A ≫ F_Y'.map τ.op :=
      (CategoryTheory.Adjunction.homEquiv_unit adj_Y A _ q_A).symm.trans
        ((adj_Y.homEquiv A _).apply_symm_apply _)
