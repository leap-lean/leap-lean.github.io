            |> fun h => (CategoryTheory.Category.assoc q_si'₀ (α'₀ ≫ i'_push.map β_s) _).symm.trans h
        have hs2 : (q_i'₀ ≫ i'_push.map (q_s'₀ ≫ β_s)) ≫ Θ_BC.inv.app (s_push.obj One_S) =
