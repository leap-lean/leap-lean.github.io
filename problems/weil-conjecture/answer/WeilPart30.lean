          Nonempty (G_sub.obj d_pb ≅ CategoryTheory.Limits.pullback (G_sub.map p₁) (G_sub.map p₂)) := by
      intro d₁ d₂ d₃ p₁ p₂
      obtain ⟨N, k₁, k₂, k₃, hk₁, hk₂, hk₃⟩ :
          ∃ N k₁ k₂ k₃ : ℕ, d₁.1 + k₁ = N ∧ d₂.1 + k₂ = N ∧ d₃.1 + k₃ = N :=
        ⟨d₁.1 + d₂.1 + d₃.1, d₂.1 + d₃.1, d₁.1 + d₃.1, d₁.1 + d₂.1, by omega, by omega, by omega⟩
      have hLift₁ : { y : Stage N // ev N y = G_sub.obj d₁ } := hk₁ ▸ shiftStage d₁.1 k₁ d₁.2
      have hLift₂ : { y : Stage N // ev N y = G_sub.obj d₂ } := hk₂ ▸ shiftStage d₂.1 k₂ d₂.2
      have hLift₃ : { y : Stage N // ev N y = G_sub.obj d₃ } := hk₃ ▸ shiftStage d₃.1 k₃ d₃.2
      let y₁ : Stage N := hLift₁.1
      let y₂ : Stage N := hLift₂.1
      let y₃ : Stage N := hLift₃.1
      let e₁ : ev N y₁ ≅ G_sub.obj d₁ := CategoryTheory.eqToIso hLift₁.2
      let e₂ : ev N y₂ ≅ G_sub.obj d₂ := CategoryTheory.eqToIso hLift₂.2
      let e₃ : ev N y₃ ≅ G_sub.obj d₃ := CategoryTheory.eqToIso hLift₃.2
      let f₁ : ev N y₁ ⟶ ev N y₃ := e₁.hom ≫ G_sub.map p₁ ≫ e₃.inv
      let f₂ : ev N y₂ ⟶ ev N y₃ := e₂.hom ≫ G_sub.map p₂ ≫ e₃.inv
      let d_pb : D_sub := ⟨N + 1, Sum.inr ⟨y₁, y₂, y₃, f₁, f₂, PUnit.unit⟩⟩
      have hd_pb : G_sub.obj d_pb = CategoryTheory.Limits.pullback f₁ f₂ := rfl
