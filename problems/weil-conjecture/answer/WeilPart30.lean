    let ψ : A₂ →ₐ[k] A₁ := AlgHom.mk ψ_ring (RingHom.congr_fun hψ_k)
    
    let G_v : MvPolynomial (Fin d) k →ₐ[k] TensorProduct k A₁ A₂ :=
