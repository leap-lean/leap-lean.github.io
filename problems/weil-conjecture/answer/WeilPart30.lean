    have hIso_πs : CategoryTheory.IsIso (weilEtaleConstPullbackHom s hT_Sk hT_B (AM_of (ℓ ^ 1))) :=
      hConst_iso s hT_Sk hT_B (AM_of (ℓ ^ 1))
    let e_dom_sh : pb_s.obj (weilEtaleTorsionSheaf B.left (ℓ ^ 1)) ≅
