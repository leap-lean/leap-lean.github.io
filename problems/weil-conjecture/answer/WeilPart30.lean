      CategoryTheory.Presheaf.freeYonedaHomEquiv_comp ((adj.homEquiv P G₁) f') g.hom
    exact (congrArg CategoryTheory.Presheaf.freeYonedaHomEquiv h1).trans h2
  
  have hZeroApp : ∀ (S : AlgebraicGeometry.Scheme.{u})
      (G₁ G₂ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
      (Z : Opposite S.Etale) (z : ↥(G₁.obj.obj Z)),
      (((0 : G₁ ⟶ G₂).hom.app Z).hom z) = 0 := by
    intro S G₁ G₂ Z z
    have h_add : (((0 : G₁ ⟶ G₂) + (0 : G₁ ⟶ G₂)).hom.app Z).hom z =
