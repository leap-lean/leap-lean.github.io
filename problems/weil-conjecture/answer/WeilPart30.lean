import WeilPart29
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem weil_gysin_cartesian_clopen_beck_chevalley_matrix_entry (Ω : Type u) [Field Ω] (m : ℕ) :
    let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
    let T_Ω := weilGysinEtaleObj (CategoryTheory.CategoryStruct.id S_Ω) inferInstance
    ∀ (W₀ P₀ U W_x : AlgebraicGeometry.Scheme.{u})
      (π : Quiver.Hom W₀ P₀)
      (g_x : Quiver.Hom S_Ω P₀)
      (f'_0 : Quiver.Hom W_x S_Ω)
      (g'_0 : Quiver.Hom W_x W₀),
      CategoryTheory.IsPullback g'_0 f'_0 π g_x →
      ∀ (j_W : Quiver.Hom U W₀) [AlgebraicGeometry.IsOpenImmersion j_W]
        (u_P : Quiver.Hom U P₀) (hu_P : AlgebraicGeometry.Etale u_P),
        CategoryTheory.CategoryStruct.comp j_W π = u_P →
        ∀ (hCont_π : (weilAltCdSitePullback π).IsContinuous
            P₀.smallEtaleTopology W₀.smallEtaleTopology)
          (hCont_f' : (weilAltCdSitePullback f'_0).IsContinuous
            S_Ω.smallEtaleTopology W_x.smallEtaleTopology)
          (hCont_gx : (weilAltCdSitePullback g_x).IsContinuous
            P₀.smallEtaleTopology S_Ω.smallEtaleTopology)
          (hc_g' : (weilAltCdSitePullback g'_0).IsContinuous
            W₀.smallEtaleTopology W_x.smallEtaleTopology)
          (σ₀ : Quiver.Hom (weilGysinEtaleObj j_W inferInstance)
            ((weilAltCdSitePullback π).obj (weilGysinEtaleObj u_P hu_P))),
          CategoryTheory.CategoryStruct.comp
            (((AlgebraicGeometry.Scheme.Etale.forget W₀).map σ₀).left)
            (CategoryTheory.Limits.pullback.fst u_P π) =
            CategoryTheory.CategoryStruct.id U →
          AlgebraicGeometry.IsOpenImmersion
            (((AlgebraicGeometry.Scheme.Etale.forget W₀).map σ₀).left) →
          AlgebraicGeometry.IsClosedImmersion
            (((AlgebraicGeometry.Scheme.Etale.forget W₀).map σ₀).left) →
          let U_W := weilGysinEtaleObj j_W inferInstance
          let U_P := weilGysinEtaleObj u_P hu_P
          let pf_π := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
            (weilAltCdSitePullback π) AddCommGrpCat.{u} _
            P₀.smallEtaleTopology W₀.smallEtaleTopology hCont_π
          let pf_f' := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
            (weilAltCdSitePullback f'_0) AddCommGrpCat.{u} _
            S_Ω.smallEtaleTopology W_x.smallEtaleTopology hCont_f'
          let pf_gx := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
            (weilAltCdSitePullback g_x) AddCommGrpCat.{u} _
            P₀.smallEtaleTopology S_Ω.smallEtaleTopology hCont_gx
          let L_P := weilGysinLocalTorsionSheaf P₀ m U_P
          let L_W := weilGysinLocalTorsionSheaf W₀ m U_W
          let F_Wx := weilGysinLocalTorsionSheaf W_x m ((weilAltCdSitePullback g'_0).obj U_W)
          ∃ (β_tilde : Quiver.Hom (pf_π.obj L_W) (pf_gx.obj (pf_f'.obj F_Wx))),
            ∀ (α_π : Quiver.Hom L_P (pf_π.obj L_W)),
              CategoryTheory.CategoryStruct.comp
                (CategoryTheory.Sheaf.freeYonedaHomEquiv α_π)
                (L_W.obj.map (Opposite.op σ₀)) =
                CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id L_W) →
              (∀ (V : W₀.Etale)
                  (w : Quiver.Hom V ((weilAltCdSitePullback π).obj U_P)),
                Disjoint
                  (Set.range (((AlgebraicGeometry.Scheme.Etale.forget W₀).map w).left).base)
                  (Set.range (((AlgebraicGeometry.Scheme.Etale.forget W₀).map σ₀).left).base) →
                CategoryTheory.CategoryStruct.comp
                  (CategoryTheory.Sheaf.freeYonedaHomEquiv α_π)
                  (L_W.obj.map (Opposite.op w)) = 0) →
              ∀ (τ_i τ_j : Quiver.Hom S_Ω (CategoryTheory.Limits.pullback u_P g_x))
                (hτ_i : CategoryTheory.CategoryStruct.comp τ_i
                  (CategoryTheory.Limits.pullback.snd u_P g_x) =
                  CategoryTheory.CategoryStruct.id S_Ω)
                (_ : CategoryTheory.CategoryStruct.comp τ_j
                  (CategoryTheory.Limits.pullback.snd u_P g_x) =
                  CategoryTheory.CategoryStruct.id S_Ω)
                (σ_j : Quiver.Hom S_Ω W_x)
                (hσ_j_et : AlgebraicGeometry.Etale σ_j)
                (hσ_j_sec : CategoryTheory.CategoryStruct.comp σ_j f'_0 =
                  CategoryTheory.CategoryStruct.id S_Ω)
                (ι_Wj : Quiver.Hom (weilGysinEtaleObj σ_j hσ_j_et)
                  ((weilAltCdSitePullback g'_0).obj U_W)),
                CategoryTheory.CategoryStruct.comp
                  (((AlgebraicGeometry.Scheme.Etale.forget W_x).map ι_Wj).left)
                  (CategoryTheory.Limits.pullback.fst j_W g'_0) =
                  CategoryTheory.CategoryStruct.comp τ_j
                    (CategoryTheory.Limits.pullback.fst u_P g_x) →
                let U_σj := weilGysinEtaleObj σ_j hσ_j_et
                let τ_et_i : Quiver.Hom T_Ω ((weilAltCdSitePullback g_x).obj U_P) :=
                  CategoryTheory.MorphismProperty.Over.homMk τ_i hτ_i trivial
                let σ_et_j : Quiver.Hom U_σj ((weilAltCdSitePullback f'_0).obj T_Ω) :=
                  CategoryTheory.MorphismProperty.Over.homMk
                    (CategoryTheory.Limits.pullback.lift
                      (CategoryTheory.CategoryStruct.id S_Ω) σ_j
                      ((CategoryTheory.Category.comp_id _).trans hσ_j_sec.symm))
                    (CategoryTheory.Limits.pullback.lift_snd _ _ _) trivial
                let η_ij := CategoryTheory.CategoryStruct.comp
                  (CategoryTheory.Sheaf.freeYonedaHomEquiv
                    (CategoryTheory.CategoryStruct.comp α_π β_tilde))
                  (CategoryTheory.CategoryStruct.comp
                    ((pf_f'.obj F_Wx).obj.map (Opposite.op τ_et_i))
                    (F_Wx.obj.map (Opposite.op σ_et_j)))
                (τ_i = τ_j →
                  η_ij = CategoryTheory.CategoryStruct.comp
                    (CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id F_Wx))
                    (F_Wx.obj.map (Opposite.op ι_Wj))) ∧
                (Disjoint (Set.range τ_i.base) (Set.range τ_j.base) → η_ij = 0) :=
by
  intro S_Ω T_Ω W₀ P₀ U W_x π g_x f'_0 g'_0 hpb j_W hj_W_open u_P hu_P _hjπ
    hCont_π hCont_f' hCont_gx hc_g' σ₀ hσ_fst hσ_open hσ_closed
    U_W U_P pf_π pf_f' pf_gx L_P L_W F_Wx
  have : AlgebraicGeometry.IsOpenImmersion j_W := hj_W_open
  have wL : ∀ {𝒞 : Type _} [CategoryTheory.Category 𝒞] {X Y Z : 𝒞}
      {g₁ g₂ : Y ⟶ Z} (f : X ⟶ Y), g₁ = g₂ → f ≫ g₁ = f ≫ g₂ :=
    fun f h => congrArg (f ≫ ·) h
  have wR : ∀ {𝒞 : Type _} [CategoryTheory.Category 𝒞] {X Y Z : 𝒞}
      {f₁ f₂ : X ⟶ Y} (h : f₁ = f₂) (g : Y ⟶ Z), f₁ ≫ g = f₂ ≫ g :=
    fun h g => congrArg (· ≫ g) h
  
  have hFreeComp : ∀ {S : AlgebraicGeometry.Scheme.{u}} {V : S.Etale}
      {G₁ G₂ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
      (f : Quiver.Hom (weilGysinLocalTorsionSheaf S m V) G₁) (g : Quiver.Hom G₁ G₂),
      CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.comp f g) =
        CategoryTheory.CategoryStruct.comp
          (CategoryTheory.Sheaf.freeYonedaHomEquiv f)
          (g.hom.app (Opposite.op V)) := by
    intro S V G₁ G₂ f g
    let P := CategoryTheory.Presheaf.freeYoneda V
      (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m)))
    let adj := CategoryTheory.sheafificationAdjunction S.smallEtaleTopology AddCommGrpCat.{u}
    let f' : (CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj P ⟶ G₁ := f
    have h1 : (adj.homEquiv P G₂) (f' ≫ g) = (adj.homEquiv P G₁) f' ≫ g.hom :=
      adj.homEquiv_naturality_right f' g
    have h2 : CategoryTheory.Presheaf.freeYonedaHomEquiv ((adj.homEquiv P G₁) f' ≫ g.hom) =
        CategoryTheory.Presheaf.freeYonedaHomEquiv ((adj.homEquiv P G₁) f') ≫
          g.hom.app (Opposite.op V) :=
      CategoryTheory.Presheaf.freeYonedaHomEquiv_comp ((adj.homEquiv P G₁) f') g.hom
    exact (congrArg CategoryTheory.Presheaf.freeYonedaHomEquiv h1).trans h2
  have hPull_fst : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom S₁ S₂)
      {A B : S₂.Etale} (g : Quiver.Hom A B),
      CategoryTheory.CategoryStruct.comp
        (((weilAltCdSitePullback h).map g).left)
        (CategoryTheory.Limits.pullback.fst B.hom h) =
        CategoryTheory.CategoryStruct.comp
          (CategoryTheory.Limits.pullback.fst A.hom h) g.left := by
    intro S₁ S₂ h A B g
    have : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    have : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
        (@AlgebraicGeometry.Etale) h :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    exact (wR (CategoryTheory.MorphismProperty.Over.pullback_map_left
        (@AlgebraicGeometry.Etale) ⊤ h g)
      (CategoryTheory.Limits.pullback.fst B.hom h)).trans
      (CategoryTheory.Limits.pullback.lift_fst _ _ _)
  have hPull_snd : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom S₁ S₂)
      {A B : S₂.Etale} (g : Quiver.Hom A B),
      CategoryTheory.CategoryStruct.comp
        (((weilAltCdSitePullback h).map g).left)
        (CategoryTheory.Limits.pullback.snd B.hom h) =
        CategoryTheory.Limits.pullback.snd A.hom h := by
    intro S₁ S₂ h A B g
    have : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    have : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
        (@AlgebraicGeometry.Etale) h :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    exact (wR (CategoryTheory.MorphismProperty.Over.pullback_map_left
        (@AlgebraicGeometry.Etale) ⊤ h g)
      (CategoryTheory.Limits.pullback.snd B.hom h)).trans
      (CategoryTheory.Limits.pullback.lift_snd _ _ _)
  
  let B_π := weilAltCdSitePullback π
  let B_f' := weilAltCdSitePullback f'_0
  let B_gx := weilAltCdSitePullback g_x
  let B_g' := weilAltCdSitePullback g'_0
  let pf_g' := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
    B_g' AddCommGrpCat.{u} _ W₀.smallEtaleTopology W_x.smallEtaleTopology hc_g'
  let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
  let ι_FWx₀ : Quiver.Hom AM (F_Wx.obj.obj (Opposite.op (B_g'.obj U_W))) :=
    CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id F_Wx)
  let ι_FWx : Quiver.Hom AM ((pf_g'.obj F_Wx).obj.obj (Opposite.op U_W)) := ι_FWx₀
  let equiv_UW : (L_W ⟶ pf_g'.obj F_Wx) ≃
      (AM ⟶ (pf_g'.obj F_Wx).obj.obj (Opposite.op U_W)) :=
    CategoryTheory.Sheaf.freeYonedaHomEquiv
  let γ₀ : Quiver.Hom L_W (pf_g'.obj F_Wx) := equiv_UW.symm ι_FWx
  have hγ₀_eval :
      CategoryTheory.CategoryStruct.comp
        (CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id L_W))
        (γ₀.hom.app (Opposite.op U_W)) =
      CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id F_Wx) :=
    (hFreeComp (CategoryTheory.CategoryStruct.id L_W) γ₀).symm.trans
      ((congrArg equiv_UW (CategoryTheory.Category.id_comp γ₀)).trans
        (equiv_UW.apply_symm_apply ι_FWx))
  let q₁ : ∀ E : P₀.Etale,
      Quiver.Hom ((B_f'.obj (B_gx.obj E)).left) ((B_gx.obj E).left) :=
    fun E => CategoryTheory.Limits.pullback.fst (CategoryTheory.Limits.pullback.snd E.hom g_x) f'_0
  let q₂ : ∀ E : P₀.Etale,
      Quiver.Hom ((B_f'.obj (B_gx.obj E)).left) W_x :=
    fun E => CategoryTheory.Limits.pullback.snd (CategoryTheory.Limits.pullback.snd E.hom g_x) f'_0
  have hm₁_cond : ∀ E : P₀.Etale,
      (q₁ E ≫ CategoryTheory.Limits.pullback.fst E.hom g_x) ≫ E.hom =
      (q₂ E ≫ g'_0) ≫ π := fun E =>
    (CategoryTheory.Category.assoc _ _ _).trans
      ((wL (q₁ E) (CategoryTheory.Limits.pullback.condition (f := E.hom) (g := g_x))).trans
        ((CategoryTheory.Category.assoc _ _ _).symm.trans
          ((wR (CategoryTheory.Limits.pullback.condition
              (f := CategoryTheory.Limits.pullback.snd E.hom g_x) (g := f'_0)) g_x).trans
            ((CategoryTheory.Category.assoc _ _ _).trans
              ((wL (q₂ E) hpb.w.symm).trans
                (CategoryTheory.Category.assoc _ _ _).symm)))))
  let m₁ : ∀ E : P₀.Etale,
      Quiver.Hom ((B_f'.obj (B_gx.obj E)).left) ((B_π.obj E).left) :=
    fun E => CategoryTheory.Limits.pullback.lift
      (q₁ E ≫ CategoryTheory.Limits.pullback.fst E.hom g_x)
      (q₂ E ≫ g'_0)
      (hm₁_cond E)
  let m_map : ∀ E : P₀.Etale,
      Quiver.Hom ((B_f'.obj (B_gx.obj E)).left) ((B_g'.obj (B_π.obj E)).left) :=
    fun E => CategoryTheory.Limits.pullback.lift
      (m₁ E) (q₂ E)
      (CategoryTheory.Limits.pullback.lift_snd _ _ _)
  let θ : ∀ E : P₀.Etale,
      Quiver.Hom (B_f'.obj (B_gx.obj E)) (B_g'.obj (B_π.obj E)) :=
    fun E => CategoryTheory.MorphismProperty.Over.homMk
      (m_map E)
      (CategoryTheory.Limits.pullback.lift_snd _ _ _)
      trivial
  have hθ_nat : ∀ {E₂ E₁ : P₀.Etale} (ψ : Quiver.Hom E₂ E₁),
      CategoryTheory.CategoryStruct.comp (B_f'.map (B_gx.map ψ)) (θ E₁) =
        CategoryTheory.CategoryStruct.comp (θ E₂) (B_g'.map (B_π.map ψ)) := by
    intro E₂ E₁ ψ
    apply CategoryTheory.MorphismProperty.Comma.Hom.ext _ (Subsingleton.elim _ _)
    let u_map := (B_f'.map (B_gx.map ψ)).left
    let v_map := (B_g'.map (B_π.map ψ)).left
    change u_map ≫ m_map E₁ = m_map E₂ ≫ v_map
    apply CategoryTheory.Limits.pullback.hom_ext
    · have hL₀ : (u_map ≫ m_map E₁) ≫
          CategoryTheory.Limits.pullback.fst (CategoryTheory.Limits.pullback.snd E₁.hom π) g'_0 =
          u_map ≫ m₁ E₁ :=
        (CategoryTheory.Category.assoc _ _ _).trans
          (wL u_map (CategoryTheory.Limits.pullback.lift_fst _ _ _))
      have hR₀ : (m_map E₂ ≫ v_map) ≫
          CategoryTheory.Limits.pullback.fst (CategoryTheory.Limits.pullback.snd E₁.hom π) g'_0 =
          m₁ E₂ ≫ (B_π.map ψ).left :=
        (CategoryTheory.Category.assoc _ _ _).trans
          ((wL (m_map E₂) (hPull_fst g'_0 (B_π.map ψ))).trans
            ((CategoryTheory.Category.assoc _ _ _).symm.trans
              (wR (CategoryTheory.Limits.pullback.lift_fst _ _ _) (B_π.map ψ).left)))
      have h_inner : u_map ≫ m₁ E₁ = m₁ E₂ ≫ (B_π.map ψ).left := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · have h1L : (u_map ≫ m₁ E₁) ≫ CategoryTheory.Limits.pullback.fst E₁.hom π =
              q₁ E₂ ≫ (CategoryTheory.Limits.pullback.fst E₂.hom g_x ≫ ψ.left) :=
            (CategoryTheory.Category.assoc _ _ _).trans
              ((wL u_map (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                ((CategoryTheory.Category.assoc _ _ _).symm.trans
                  ((wR (hPull_fst f'_0 (B_gx.map ψ)) _).trans
                    ((CategoryTheory.Category.assoc _ _ _).trans
                      (wL (q₁ E₂) (hPull_fst g_x ψ))))))
          have h1R : (m₁ E₂ ≫ (B_π.map ψ).left) ≫ CategoryTheory.Limits.pullback.fst E₁.hom π =
              q₁ E₂ ≫ (CategoryTheory.Limits.pullback.fst E₂.hom g_x ≫ ψ.left) :=
            (CategoryTheory.Category.assoc _ _ _).trans
              ((wL (m₁ E₂) (hPull_fst π ψ)).trans
                ((CategoryTheory.Category.assoc _ _ _).symm.trans
                  ((wR (CategoryTheory.Limits.pullback.lift_fst _ _ _) ψ.left).trans
                    (CategoryTheory.Category.assoc _ _ _))))
          exact h1L.trans h1R.symm
        · have h2L : (u_map ≫ m₁ E₁) ≫ CategoryTheory.Limits.pullback.snd E₁.hom π =
              q₂ E₂ ≫ g'_0 :=
            (CategoryTheory.Category.assoc _ _ _).trans
              ((wL u_map (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
                ((CategoryTheory.Category.assoc _ _ _).symm.trans
                  (wR (hPull_snd f'_0 (B_gx.map ψ)) g'_0)))
          have h2R : (m₁ E₂ ≫ (B_π.map ψ).left) ≫ CategoryTheory.Limits.pullback.snd E₁.hom π =
              q₂ E₂ ≫ g'_0 :=
            (CategoryTheory.Category.assoc _ _ _).trans
              ((wL (m₁ E₂) (hPull_snd π ψ)).trans
                (CategoryTheory.Limits.pullback.lift_snd _ _ _))
          exact h2L.trans h2R.symm
      exact hL₀.trans (h_inner.trans hR₀.symm)
    · have hL₂ : (u_map ≫ m_map E₁) ≫
          CategoryTheory.Limits.pullback.snd (CategoryTheory.Limits.pullback.snd E₁.hom π) g'_0 =
          q₂ E₂ :=
        (CategoryTheory.Category.assoc _ _ _).trans
          ((wL u_map (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
            (hPull_snd f'_0 (B_gx.map ψ)))
      have hR₂ : (m_map E₂ ≫ v_map) ≫
          CategoryTheory.Limits.pullback.snd (CategoryTheory.Limits.pullback.snd E₁.hom π) g'_0 =
          q₂ E₂ :=
        (CategoryTheory.Category.assoc _ _ _).trans
          ((wL (m_map E₂) (hPull_snd g'_0 (B_π.map ψ))).trans
            (CategoryTheory.Limits.pullback.lift_snd _ _ _))
      exact hL₂.trans hR₂.symm
  let θ_pre : Quiver.Hom
      (pf_π.obj (pf_g'.obj F_Wx)).obj
      (pf_gx.obj (pf_f'.obj F_Wx)).obj :=
    { app := fun Z => F_Wx.obj.map (Opposite.op (θ (Opposite.unop Z)))
      naturality := fun {Z₁ Z₂} φ =>
        (F_Wx.obj.map_comp
          (Opposite.op (B_g'.map (B_π.map φ.unop)))
          (Opposite.op (θ (Opposite.unop Z₂)))).symm.trans
          ((congrArg (fun u => F_Wx.obj.map (Opposite.op u)) (hθ_nat φ.unop).symm).trans
            (F_Wx.obj.map_comp
              (Opposite.op (θ (Opposite.unop Z₁)))
              (Opposite.op (B_f'.map (B_gx.map φ.unop))))) }
  let θ_star : Quiver.Hom (pf_π.obj (pf_g'.obj F_Wx)) (pf_gx.obj (pf_f'.obj F_Wx)) :=
    CategoryTheory.ObjectProperty.homMk θ_pre
  let β_tilde : Quiver.Hom (pf_π.obj L_W) (pf_gx.obj (pf_f'.obj F_Wx)) :=
    CategoryTheory.CategoryStruct.comp (pf_π.map γ₀) θ_star
  refine ⟨β_tilde, ?_⟩
  
  intro α_π hα_on hα_disj τ_i τ_j hτ_i hτ_j σ_j hσ_j_et hσ_j_sec ι_Wj hι_fst
    U_σj τ_et_i σ_et_j η_ij
  let ξ := CategoryTheory.Sheaf.freeYonedaHomEquiv α_π
  let μ_ij : Quiver.Hom U_σj (B_g'.obj (B_π.obj U_P)) :=
    σ_et_j ≫ B_f'.map τ_et_i ≫ θ U_P
  have hη_unfold :
      η_ij = ξ ≫ γ₀.hom.app (Opposite.op (B_π.obj U_P)) ≫ F_Wx.obj.map (Opposite.op μ_ij) := by
    have h1 : CategoryTheory.Sheaf.freeYonedaHomEquiv (α_π ≫ β_tilde) =
        ξ ≫ (γ₀.hom.app (Opposite.op (B_π.obj U_P)) ≫ F_Wx.obj.map (Opposite.op (θ U_P))) :=
      hFreeComp α_π β_tilde
    have h2 : F_Wx.obj.map (Opposite.op (θ U_P)) ≫
        (((pf_f'.obj F_Wx).obj.map (Opposite.op τ_et_i)) ≫ F_Wx.obj.map (Opposite.op σ_et_j)) =
        F_Wx.obj.map (Opposite.op μ_ij) :=
      (wL (F_Wx.obj.map (Opposite.op (θ U_P)))
        (F_Wx.obj.map_comp (Opposite.op (B_f'.map τ_et_i)) (Opposite.op σ_et_j)).symm).trans
        ((F_Wx.obj.map_comp (Opposite.op (θ U_P))
          (Opposite.op (σ_et_j ≫ B_f'.map τ_et_i))).symm.trans
          (congrArg (fun u => F_Wx.obj.map (Opposite.op u))
            (CategoryTheory.Category.assoc σ_et_j (B_f'.map τ_et_i) (θ U_P))))
    let ev_ij :=
      ((pf_f'.obj F_Wx).obj.map (Opposite.op τ_et_i)) ≫ F_Wx.obj.map (Opposite.op σ_et_j)
    exact (wR h1 ev_ij).trans
      ((CategoryTheory.Category.assoc ξ _ ev_ij).trans
        (wL ξ ((CategoryTheory.Category.assoc _ _ ev_ij).trans
          (wL (γ₀.hom.app (Opposite.op (B_π.obj U_P))) h2))))
  have hFactor : ∀ (V : W₀.Etale) (w : Quiver.Hom V (B_π.obj U_P))
      (ν : Quiver.Hom U_σj (B_g'.obj V)),
      μ_ij = ν ≫ B_g'.map w →
      η_ij = (ξ ≫ L_W.obj.map (Opposite.op w)) ≫
        γ₀.hom.app (Opposite.op V) ≫ F_Wx.obj.map (Opposite.op ν) := fun V w ν hμ =>
    let hmap : F_Wx.obj.map (Opposite.op μ_ij) =
        (pf_g'.obj F_Wx).obj.map (Opposite.op w) ≫ F_Wx.obj.map (Opposite.op ν) :=
      (congrArg (fun u => F_Wx.obj.map (Opposite.op u)) hμ).trans
        (F_Wx.obj.map_comp (Opposite.op (B_g'.map w)) (Opposite.op ν))
    let hnat : γ₀.hom.app (Opposite.op (B_π.obj U_P)) ≫
        (pf_g'.obj F_Wx).obj.map (Opposite.op w) =
        L_W.obj.map (Opposite.op w) ≫ γ₀.hom.app (Opposite.op V) :=
