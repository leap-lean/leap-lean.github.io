              change ℱ₂.obj.map (G_aff.map (g.unop.1 ≫ f.unop.1)).op = _
              rw [G_aff.map_comp, CategoryTheory.op_comp, ℱ₂.obj.map_comp] }
        let M_stalk : ModuleCat.{u, u} R := CategoryTheory.Limits.colimit D_stalk
        have hGermAgree : ∀ {W : S.Etale} (δ : S_Ω ⟶ W.left)
