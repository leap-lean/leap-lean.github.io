        (CategoryTheory.Category.assoc _ _ _).trans
          (congrArg (fun k => adj_Y.unit.app R_mod ≫ k)
            (u_π.hom.naturality ((hIsTerm Y).from U_et).op))
      have hev_c : adj_Y.unit.app R_mod ≫
            (u_π.hom.app (Opposite.op (mkTerm Y)) ≫
              One_Y'.obj.map (B_g.map ((hIsTerm Y).from U_et)).op) =
          (adj_Y'.unit.app R_mod ≫ One_Y'.obj.map τ_g.op) ≫
            One_Y'.obj.map (B_g.map ((hIsTerm Y).from U_et)).op :=
        (CategoryTheory.Category.assoc _ _ _).symm.trans
          (congrArg (fun k => k ≫ One_Y'.obj.map (B_g.map ((hIsTerm Y).from U_et)).op) hu_π)
      have h_ev2 : CategoryTheory.Sheaf.freeYonedaHomEquiv (κ_tilde_Y ≫ u_π) =
          (adj_Y'.unit.app R_mod ≫ One_Y'.obj.map τ_g.op) ≫
            One_Y'.obj.map (B_g.map ((hIsTerm Y).from U_et)).op :=
        hev_a.trans (hev_b.trans hev_c)
      have h_term_hom : (φ_et ≫ B_g.map ((hIsTerm Y).from U_et)) ≫ τ_g =
          (hIsTerm Y').from U'_et :=
        (hIsTerm Y').hom_ext _ _
      have h_term_map : One_Y'.obj.map τ_g.op ≫
          (One_Y'.obj.map (B_g.map ((hIsTerm Y).from U_et)).op ≫ One_Y'.obj.map φ_et.op) =
          One_Y'.obj.map ((hIsTerm Y').from U'_et).op :=
        (congrArg (fun k => One_Y'.obj.map τ_g.op ≫ k) (One_Y'.obj.map_comp _ _).symm).trans
          ((One_Y'.obj.map_comp _ _).symm.trans
            (congrArg (fun k => One_Y'.obj.map k.op) h_term_hom))
      have hγ_1 : CategoryTheory.Sheaf.freeYonedaHomEquiv (γ_L ≫ θ_Y') =
          (η_unit ≫ (P_pull.obj L_Y).obj.map φ_et.op) ≫ θ_Y'.hom.app (Opposite.op U'_et) :=
        (hFreeYonedaComp U'_et γ_L θ_Y').trans
          (congrArg (fun k => k ≫ θ_Y'.hom.app (Opposite.op U'_et)) (Equiv.apply_symm_apply _ _))
      have hγ_2 : (η_unit ≫ (P_pull.obj L_Y).obj.map φ_et.op) ≫ θ_Y'.hom.app (Opposite.op U'_et) =
          (η_unit ≫ θ_Y'.hom.app (Opposite.op (B_g.obj U_et))) ≫ One_Y'.obj.map φ_et.op :=
        (CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg (fun k => η_unit ≫ k) (θ_Y'.hom.naturality φ_et.op)).trans
            (CategoryTheory.Category.assoc _ _ _).symm)
      have hγ_3 : (η_unit ≫ θ_Y'.hom.app (Opposite.op (B_g.obj U_et))) ≫ One_Y'.obj.map φ_et.op =
          ((adj_Y'.unit.app R_mod ≫ One_Y'.obj.map τ_g.op) ≫
            One_Y'.obj.map (B_g.map ((hIsTerm Y).from U_et)).op) ≫ One_Y'.obj.map φ_et.op :=
        congrArg (fun k => k ≫ One_Y'.obj.map φ_et.op) (h_ev1.trans h_ev2)
      have hγ_4 : ((adj_Y'.unit.app R_mod ≫ One_Y'.obj.map τ_g.op) ≫
            One_Y'.obj.map (B_g.map ((hIsTerm Y).from U_et)).op) ≫ One_Y'.obj.map φ_et.op =
          adj_Y'.unit.app R_mod ≫ One_Y'.obj.map ((hIsTerm Y').from U'_et).op :=
        (by simp only [CategoryTheory.Category.assoc] :
          ((adj_Y'.unit.app R_mod ≫ One_Y'.obj.map τ_g.op) ≫
            One_Y'.obj.map (B_g.map ((hIsTerm Y).from U_et)).op) ≫ One_Y'.obj.map φ_et.op =
          adj_Y'.unit.app R_mod ≫
            (One_Y'.obj.map τ_g.op ≫
              (One_Y'.obj.map (B_g.map ((hIsTerm Y).from U_et)).op ≫
                One_Y'.obj.map φ_et.op))).trans
          (congrArg (fun k => adj_Y'.unit.app R_mod ≫ k) h_term_map)
      exact hγ_1.trans (hγ_2.trans (hγ_3.trans (hγ_4.trans (Equiv.apply_symm_apply _ _).symm)))
    have hγ_ι : γ_L ≫ P_pull.map κ_tilde_Y = κ_tilde_Y' ≫ ι_Y := by
      have h1 := congrArg (· ≫ ι_Y) hγ_comm
      simpa [CategoryTheory.Category.assoc, show π_Y ≫ ι_Y = 𝟙 (P_pull.obj One_Y) from hι2] using h1
    have hkill : κ_tilde_Y' ≫ (ι_Y ≫ P_pull.map q_i) = 0 := by
      rw [← CategoryTheory.Category.assoc, ← hγ_ι, CategoryTheory.Category.assoc,
        ← P_pull.map_comp, show κ_tilde_Y ≫ q_i = 0 from hzero_tilde_Y,
        P_pull.map_zero, CategoryTheory.Limits.comp_zero]
    obtain ⟨β, hqβ⟩ := hDesc_Y' (ι_Y ≫ P_pull.map q_i) hkill
    let τ' : WeilGysinSupportClass Z' Y' i' (ℓ ^ r) q :=
      { hCont := hCont_i'
        val := (CategoryTheory.Abelian.Ext.mk₀ π_Y).postcomp (i'_push.obj One_Z') (Nat.add_zero q)
          ((CategoryTheory.Abelian.Ext.mk₀ β).comp
            ((P_pull.mapExtAddHom (i_push.obj One_Z) One_Y q) τ.val) (Nat.zero_add q)) }
    exact ⟨τ', hCont_g, P_pull, adj_pull, hAdd, hLim, hColim,
      mkTerm Y, hIsTerm Y, mkTerm Z, hIsTerm Z,
      mkTerm Y', hIsTerm Y', mkTerm Z', hIsTerm Z',
      ι_Y, β, hι1, hι2, hqβ, rfl⟩
  · 
    intro Z' Y' Z Y g i' i hi' r q τ τ'₁ τ'₂ hpb₁ hpb₂
    obtain ⟨hEpi_qi', _, _⟩ := hClosedCokerAndEpi i' hi' τ'₁.hCont (ℓ ^ r)
    exact hEpiUniq g i' i (ℓ ^ r) q τ τ'₁ τ'₂ hEpi_qi' hpb₁ hpb₂

theorem weil_gysin_support_modulus_reduction_package (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    ∃ SupportRed : ∀ {Z Y : AlgebraicGeometry.Scheme.{u}} {i : Quiver.Hom Z Y} (r q : ℕ),
        WeilGysinSupportClass Z Y i (ℓ ^ (r + 1)) q →
        WeilGysinSupportClass Z Y i (ℓ ^ r) q → Prop,
      ∀ {Z Y : AlgebraicGeometry.Scheme.{u}} (i : Quiver.Hom Z Y),
        AlgebraicGeometry.IsClosedImmersion i →
        (∀ (r q : ℕ) (τ_succ : WeilGysinSupportClass Z Y i (ℓ ^ (r + 1)) q),
          ∃! τ_curr : WeilGysinSupportClass Z Y i (ℓ ^ r) q,
            SupportRed r q τ_succ τ_curr) ∧
        (∀ {Z' Y' : AlgebraicGeometry.Scheme.{u}}
          (g : Quiver.Hom Y' Y) (i' : Quiver.Hom Z' Y') (g_Z : Quiver.Hom Z' Z),
          CategoryTheory.IsPullback i' g_Z g i →
          ∀ (r q : ℕ)
            (τ_succ : WeilGysinSupportClass Z Y i (ℓ ^ (r + 1)) q)
            (τ_curr : WeilGysinSupportClass Z Y i (ℓ ^ r) q)
            (τ'_succ : WeilGysinSupportClass Z' Y' i' (ℓ ^ (r + 1)) q)
            (τ'_curr : WeilGysinSupportClass Z' Y' i' (ℓ ^ r) q),
            WeilGysinSupportPullback g i' i (ℓ ^ (r + 1)) q τ'_succ τ_succ →
            WeilGysinSupportPullback g i' i (ℓ ^ r) q τ'_curr τ_curr →
            SupportRed r q τ_succ τ_curr →
            SupportRed r q τ'_succ τ'_curr) ∧
        (∀ (r q : ℕ)
          (τ_succ : WeilGysinSupportClass Z Y i (ℓ ^ (r + 1)) q)
          (τ_curr : WeilGysinSupportClass Z Y i (ℓ ^ r) q)
          (cl_succ : weilEtaleTorsionH Y (ℓ ^ (r + 1)) q)
          (cl_curr : weilEtaleTorsionH Y (ℓ ^ r) q),
          SupportRed r q τ_succ τ_curr →
          WeilGysinForgetsTo τ_succ cl_succ →
          WeilGysinForgetsTo τ_curr cl_curr →
          weilEtaleTorsionTransition Y ℓ r q cl_succ = cl_curr) :=
by
  
  
  
  have hSuppExt : ∀ {Z Y : AlgebraicGeometry.Scheme.{u}} {i : Quiver.Hom Z Y} {m q : ℕ}
      (τ₁ τ₂ : WeilGysinSupportClass Z Y i m q), τ₁.val = τ₂.val → τ₁ = τ₂ := by
    intro Z Y i m q ⟨hc₁, v₁⟩ ⟨hc₂, v₂⟩ hv
    cases Subsingleton.elim hc₁ hc₂
    cases hv
    rfl

  have hMapExtComp : ∀ {𝒞 𝒟 ℰ : Type (u + 1)}
      [CategoryTheory.Category.{u + 1, u + 1} 𝒞]
      [CategoryTheory.Category.{u + 1, u + 1} 𝒟]
      [CategoryTheory.Category.{u + 1, u + 1} ℰ]
      [CategoryTheory.Abelian 𝒞] [CategoryTheory.Abelian 𝒟] [CategoryTheory.Abelian ℰ]
      [CategoryTheory.EnoughInjectives 𝒞]
      [CategoryTheory.HasExt.{u} 𝒞] [CategoryTheory.HasExt.{u} 𝒟] [CategoryTheory.HasExt.{u} ℰ]
      (F : 𝒞 ⥤ 𝒟) (G : 𝒟 ⥤ ℰ)
      [F.Additive] [CategoryTheory.Limits.PreservesFiniteLimits F]
      [CategoryTheory.Limits.PreservesFiniteColimits F]
      [G.Additive] [CategoryTheory.Limits.PreservesFiniteLimits G]
      [CategoryTheory.Limits.PreservesFiniteColimits G]
      (X Y : 𝒞) (n : ℕ) (e : CategoryTheory.Abelian.Ext.{u} X Y n),
      ((F ⋙ G).mapExtAddHom X Y n) e =
        (G.mapExtAddHom (F.obj X) (F.obj Y) n) ((F.mapExtAddHom X Y n) e) := by
    intro 𝒞 𝒟 ℰ _ _ _ _ _ _ _ _ _ _ F G _ _ _ _ _ _ X Y n
    induction n generalizing Y with
    | zero =>
      intro e
      obtain ⟨f, rfl⟩ : ∃ f : X ⟶ Y, CategoryTheory.Abelian.Ext.mk₀ f = e :=
        ⟨CategoryTheory.Abelian.Ext.addEquiv₀ e,
          CategoryTheory.Abelian.Ext.addEquiv₀.symm_apply_apply e⟩
      simp only [CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀]
      rfl
    | succ m ih =>
      intro e
      let I : 𝒞 := CategoryTheory.Injective.under Y
      let ι : Y ⟶ I := CategoryTheory.Injective.ι Y
      let S : CategoryTheory.ShortComplex 𝒞 :=
        CategoryTheory.ShortComplex.mk ι (CategoryTheory.Limits.cokernel.π ι)
          (CategoryTheory.Limits.cokernel.condition ι)
      have hS : S.ShortExact :=
        CategoryTheory.ShortComplex.ShortExact.mk (CategoryTheory.ShortComplex.exact_cokernel ι)
      have hI0 : e.comp (CategoryTheory.Abelian.Ext.mk₀ ι) (Nat.add_zero (m + 1)) = 0 :=
        CategoryTheory.Abelian.Ext.eq_zero_of_injective _
      obtain ⟨x₃, rfl⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ X hS e hI0 rfl
      simp only [CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass]
      change (((F ⋙ G).mapExtAddHom X S.X₃ m) x₃).comp (hS.map_of_exact (F ⋙ G)).extClass rfl =
        ((G.mapExtAddHom _ _ m) (((F.mapExtAddHom X S.X₃ m) x₃))).comp
          ((hS.map_of_exact F).map_of_exact G).extClass rfl
      have hExtEq : (hS.map_of_exact (F ⋙ G)).extClass =
          ((hS.map_of_exact F).map_of_exact G).extClass := rfl
      rw [ih S.X₃ x₃, hExtEq]

  have hMapExtNatIso : ∀ {𝒞 𝒟 : Type (u + 1)}
      [CategoryTheory.Category.{u + 1, u + 1} 𝒞]
      [CategoryTheory.Category.{u + 1, u + 1} 𝒟]
      [CategoryTheory.Abelian 𝒞] [CategoryTheory.Abelian 𝒟]
      [CategoryTheory.EnoughInjectives 𝒞]
      [CategoryTheory.HasExt.{u} 𝒞] [CategoryTheory.HasExt.{u} 𝒟]
      {F G : 𝒞 ⥤ 𝒟} (η : F ≅ G)
      [F.Additive] [CategoryTheory.Limits.PreservesFiniteLimits F]
      [CategoryTheory.Limits.PreservesFiniteColimits F]
      [G.Additive] [CategoryTheory.Limits.PreservesFiniteLimits G]
      [CategoryTheory.Limits.PreservesFiniteColimits G]
      (X Y : 𝒞) (n : ℕ) (e : CategoryTheory.Abelian.Ext.{u} X Y n),
      ((F.mapExtAddHom X Y n) e).comp (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app Y))
        (Nat.add_zero n) =
        (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app X)).comp ((G.mapExtAddHom X Y n) e)
          (Nat.zero_add n) := by
    intro 𝒞 𝒟 _ _ _ _ _ _ _ F G η _ _ _ _ _ _ X Y n
    induction n generalizing Y with
    | zero =>
      intro e
      obtain ⟨f, rfl⟩ : ∃ f : X ⟶ Y, CategoryTheory.Abelian.Ext.mk₀ f = e :=
        ⟨CategoryTheory.Abelian.Ext.addEquiv₀ e,
          CategoryTheory.Abelian.Ext.addEquiv₀.symm_apply_apply e⟩
      simp only [CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
      exact congrArg CategoryTheory.Abelian.Ext.mk₀ (η.hom.naturality f)
    | succ m ih =>
      intro e
      let I : 𝒞 := CategoryTheory.Injective.under Y
      let ι : Y ⟶ I := CategoryTheory.Injective.ι Y
      let S : CategoryTheory.ShortComplex 𝒞 :=
        CategoryTheory.ShortComplex.mk ι (CategoryTheory.Limits.cokernel.π ι)
          (CategoryTheory.Limits.cokernel.condition ι)
      have hS : S.ShortExact :=
        CategoryTheory.ShortComplex.ShortExact.mk (CategoryTheory.ShortComplex.exact_cokernel ι)
      have hI0 : e.comp (CategoryTheory.Abelian.Ext.mk₀ ι) (Nat.add_zero (m + 1)) = 0 :=
        CategoryTheory.Abelian.Ext.eq_zero_of_injective _
      obtain ⟨x₃, rfl⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ X hS e hI0 rfl
      simp only [CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass]
      let hSF := hS.map_of_exact F
      let hSG := hS.map_of_exact G
      let mor : S.map F ⟶ S.map G :=
        { τ₁ := η.hom.app S.X₁
          τ₂ := η.hom.app S.X₂
          τ₃ := η.hom.app S.X₃
          comm₁₂ := (η.hom.naturality S.f).symm
          comm₂₃ := (η.hom.naturality S.g).symm }
      have hNatExt := CategoryTheory.ShortComplex.ShortExact.extClass_naturality hSF hSG mor
      change hSF.extClass.comp (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app Y)) (Nat.add_zero 1) =
        (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app S.X₃)).comp hSG.extClass (Nat.zero_add 1) at hNatExt
      change (((F.mapExtAddHom X S.X₃ m) x₃).comp hSF.extClass rfl).comp
          (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app Y)) (Nat.add_zero (m + 1)) =
        (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app X)).comp
          (((G.mapExtAddHom X S.X₃ m) x₃).comp hSG.extClass rfl)
          (Nat.zero_add (m + 1))
      rw [CategoryTheory.Abelian.Ext.comp_assoc _ _ _ rfl (Nat.add_zero 1) (by omega),
        hNatExt,
        ← CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero m) (Nat.zero_add 1) (by omega),
        ih S.X₃ x₃,
        CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.zero_add m) rfl (by omega)]

  have hConstUnitMap : ∀ {S : AlgebraicGeometry.Scheme.{u}}
      {𝒜 : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} 𝒜]
      [CategoryTheory.HasWeakSheafify S.smallEtaleTopology 𝒜]
      {T₁ T₂ : S.Etale} (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
      (hT₂ : CategoryTheory.Limits.IsTerminal T₂) (φ : T₂ ⟶ T₁) (X : 𝒜),
      (CategoryTheory.constantSheafAdj S.smallEtaleTopology 𝒜 hT₁).unit.app X ≫
        (((CategoryTheory.constantSheaf S.smallEtaleTopology 𝒜).obj X).obj.map φ.op) =
      (CategoryTheory.constantSheafAdj S.smallEtaleTopology 𝒜 hT₂).unit.app X := by
    intro S 𝒜 _ _ T₁ T₂ hT₁ hT₂ φ X
    let J := S.smallEtaleTopology
    let P_X := (CategoryTheory.Functor.const S.Etaleᵒᵖ).obj X
    let η_X := (CategoryTheory.sheafificationAdjunction J 𝒜).unit.app P_X
    have h_nat := η_X.naturality φ.op
    dsimp [P_X] at h_nat
    rw [CategoryTheory.Category.id_comp] at h_nat
    have h_u₁ : (CategoryTheory.constantSheafAdj J 𝒜 hT₁).unit.app X = η_X.app (Opposite.op T₁) := by
      dsimp only [CategoryTheory.constantSheafAdj]
      rw [CategoryTheory.Adjunction.comp_unit_app,
        CategoryTheory.constantPresheafAdj_unit_app, CategoryTheory.Category.id_comp]
      rfl
    have h_u₂ : (CategoryTheory.constantSheafAdj J 𝒜 hT₂).unit.app X = η_X.app (Opposite.op T₂) := by
      dsimp only [CategoryTheory.constantSheafAdj]
      rw [CategoryTheory.Adjunction.comp_unit_app,
        CategoryTheory.constantPresheafAdj_unit_app, CategoryTheory.Category.id_comp]
      rfl
    rw [h_u₁, h_u₂]
    exact h_nat.symm

  have hConstSymmMap : ∀ {S : AlgebraicGeometry.Scheme.{u}}
      {𝒜 : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} 𝒜]
      [CategoryTheory.HasWeakSheafify S.smallEtaleTopology 𝒜]
      {T₁ T₂ : S.Etale} (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
      (hT₂ : CategoryTheory.Limits.IsTerminal T₂) (X : 𝒜)
      (ℱ : CategoryTheory.Sheaf S.smallEtaleTopology 𝒜)
      (f : X ⟶ ℱ.obj.obj (Opposite.op T₁)),
      ((CategoryTheory.constantSheafAdj S.smallEtaleTopology 𝒜 hT₂).homEquiv X ℱ).symm
        (f ≫ ℱ.obj.map (hT₁.from T₂).op) =
      ((CategoryTheory.constantSheafAdj S.smallEtaleTopology 𝒜 hT₁).homEquiv X ℱ).symm f := by
    intro S 𝒜 _ _ T₁ T₂ hT₁ hT₂ X ℱ f
    let J := S.smallEtaleTopology
    set rhs := ((CategoryTheory.constantSheafAdj J 𝒜 hT₁).homEquiv X ℱ).symm f
    apply ((CategoryTheory.constantSheafAdj J 𝒜 hT₂).homEquiv X ℱ).injective
    rw [Equiv.apply_symm_apply]
    have h₁ : ((CategoryTheory.constantSheafAdj J 𝒜 hT₁).homEquiv X ℱ) rhs = f :=
      Equiv.apply_symm_apply _ _
    rw [CategoryTheory.Adjunction.homEquiv_unit] at h₁ ⊢
    change (CategoryTheory.constantSheafAdj J 𝒜 hT₁).unit.app X ≫
        rhs.hom.app (Opposite.op T₁) = f at h₁
    change f ≫ ℱ.obj.map (hT₁.from T₂).op =
      (CategoryTheory.constantSheafAdj J 𝒜 hT₂).unit.app X ≫
        rhs.hom.app (Opposite.op T₂)
    rw [← hConstUnitMap hT₁ hT₂ (hT₁.from T₂) X, CategoryTheory.Category.assoc,
      rhs.hom.naturality (hT₁.from T₂).op, ← CategoryTheory.Category.assoc, h₁]

  let sheafComposeAdj : ∀ {𝒞 : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} 𝒞]
      (J : CategoryTheory.GrothendieckTopology 𝒞)
      {𝒟 ℰ : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} 𝒟]
      [CategoryTheory.Category.{u, u + 1} ℰ]
      {F : 𝒟 ⥤ ℰ} {G : ℰ ⥤ 𝒟} (adj : F ⊣ G)
      [J.HasSheafCompose F] [J.HasSheafCompose G],
      CategoryTheory.sheafCompose J F ⊣ CategoryTheory.sheafCompose J G :=
    fun {_} [_] J {_ _} [_] [_] {_ _} adj [_] [_] =>
      CategoryTheory.Adjunction.mkOfHomEquiv
        { homEquiv := fun X Y =>
            { toFun := fun f =>
                CategoryTheory.ObjectProperty.homMk
                  (((adj.whiskerRight _).homEquiv X.obj Y.obj) f.hom)
              invFun := fun g =>
                CategoryTheory.ObjectProperty.homMk
                  (((adj.whiskerRight _).homEquiv X.obj Y.obj).symm g.hom)
              left_inv := fun f =>
                CategoryTheory.Sheaf.hom_ext
                  (((adj.whiskerRight _).homEquiv X.obj Y.obj).left_inv f.hom)
              right_inv := fun g =>
                CategoryTheory.Sheaf.hom_ext
                  (((adj.whiskerRight _).homEquiv X.obj Y.obj).right_inv g.hom) }
          homEquiv_naturality_left_symm := fun f g =>
            CategoryTheory.Sheaf.hom_ext
              ((adj.whiskerRight _).homEquiv_naturality_left_symm f.hom g.hom)
          homEquiv_naturality_right := fun f g =>
            CategoryTheory.Sheaf.hom_ext
              ((adj.whiskerRight _).homEquiv_naturality_right f.hom g.hom) }

  
  
  
  let instModCoext : ∀ (R : Type u) [CommRing R] (A : AddCommGrpCat.{u}),
      Module R (R →+ ↥A) := fun R _ A =>
    { smul := fun r φ =>
        { toFun := fun t => φ (t * r)
          map_zero' := by rw [zero_mul, map_zero]
          map_add' := fun t₁ t₂ => by rw [add_mul, map_add] }
      one_smul := fun φ => AddMonoidHom.ext fun t => by change φ (t * 1) = φ t; rw [mul_one]
      mul_smul := fun r₁ r₂ φ => AddMonoidHom.ext fun t => by
        change φ (t * (r₁ * r₂)) = φ ((t * r₁) * r₂)
        rw [mul_assoc]
      smul_zero := fun _ => AddMonoidHom.ext fun _ => rfl
      smul_add := fun _ _ _ => AddMonoidHom.ext fun _ => rfl
      add_smul := fun r₁ r₂ φ => AddMonoidHom.ext fun t => by
        change φ (t * (r₁ + r₂)) = φ (t * r₁) + φ (t * r₂)
        rw [mul_add, map_add]
      zero_smul := fun φ => AddMonoidHom.ext fun t => by
        change φ (t * 0) = 0
        rw [mul_zero, map_zero] }

  let coextModFunctor : ∀ (R : Type u) [CommRing R],
      AddCommGrpCat.{u} ⥤ ModuleCat.{u, u} R := fun R _ =>
    { obj := fun A => @ModuleCat.of R _ (R →+ ↥A) _ (instModCoext R A)
      map := fun {A B} f =>
        @ModuleCat.ofHom R _ _ _ _ (instModCoext R A) _ (instModCoext R B)
          { toFun := fun φ => f.hom.comp φ
            map_add' := fun φ₁ φ₂ => AddMonoidHom.ext fun t => map_add f.hom (φ₁ t) (φ₂ t)
            map_smul' := fun _ _ => AddMonoidHom.ext fun _ => rfl }
      map_id := fun _ => ModuleCat.hom_ext (LinearMap.ext fun _ => AddMonoidHom.ext fun _ => rfl)
      map_comp := fun _ _ => ModuleCat.hom_ext (LinearMap.ext fun _ => AddMonoidHom.ext fun _ => rfl) }

  let forgetCoextAdj : ∀ (R : Type u) [CommRing R],
      CategoryTheory.forget₂ (ModuleCat.{u, u} R) AddCommGrpCat.{u} ⊣ coextModFunctor R :=
    fun R _ =>
      CategoryTheory.Adjunction.mkOfHomEquiv
        { homEquiv := fun M A =>
            { toFun := fun h =>
                @ModuleCat.ofHom R _ M (R →+ ↥A) _ _ _ (instModCoext R A)
                  { toFun := fun m =>
                      { toFun := fun r => h.hom (r • m)
                        map_zero' := by rw [zero_smul, map_zero]
                        map_add' := fun r₁ r₂ => by rw [add_smul, map_add] }
                    map_add' := fun m₁ m₂ =>
                      AddMonoidHom.ext fun r =>
                        (congrArg h.hom (smul_add r m₁ m₂)).trans (h.hom.map_add (r • m₁) (r • m₂))
                    map_smul' := fun s m => AddMonoidHom.ext fun r => by
                      change h.hom (r • (s • m)) = h.hom ((r * s) • m)
                      rw [mul_smul] }
              invFun := fun g => AddCommGrpCat.ofHom
                { toFun := fun m => (show R →+ ↥A from g.hom m) 1
                  map_zero' := by
                    change (show R →+ ↥A from g.hom 0) 1 = 0
                    rw [map_zero]
                    rfl
                  map_add' := fun m₁ m₂ => by
                    change (show R →+ ↥A from g.hom (m₁ + m₂)) 1 =
                      (show R →+ ↥A from g.hom m₁) 1 + (show R →+ ↥A from g.hom m₂) 1
                    rw [map_add]
                    rfl }
              left_inv := fun h => AddCommGrpCat.ext fun m => by
                change h.hom ((1 : R) • m) = h.hom m
                rw [one_smul]
              right_inv := fun g => ModuleCat.hom_ext (LinearMap.ext fun m =>
                AddMonoidHom.ext fun r => by
                  change (show R →+ ↥A from g.hom (r • m)) 1 =
                    (show R →+ ↥A from g.hom m) r
                  rw [g.hom.map_smul]
                  change (show R →+ ↥A from g.hom m) (1 * r) =
                    (show R →+ ↥A from g.hom m) r
                  rw [one_mul]) }
          homEquiv_naturality_left_symm := fun _ _ => AddCommGrpCat.ext fun _ => rfl
          homEquiv_naturality_right := fun _ _ =>
            ModuleCat.hom_ext (LinearMap.ext fun _ => AddMonoidHom.ext fun _ => rfl) }

  have hForgetIsRightAdj : ∀ (R : Type u) [CommRing R],
      (CategoryTheory.forget₂ (ModuleCat.{u, u} R) AddCommGrpCat.{u}).IsRightAdjoint := by
    intro R _
    exact ((CategoryTheory.forget₂ (ModuleCat.{u, 0} ℤ)
      AddCommGrpCat.{u}).asEquivalence.symm.toAdjunction.comp
      (ModuleCat.extendRestrictScalarsAdj (Int.castRingHom R))).isRightAdjoint

  have hCoextIsRightAdj : ∀ (R : Type u) [CommRing R],
      (coextModFunctor R).IsRightAdjoint := by
    intro R _
    exact (forgetCoextAdj R).isRightAdjoint

  have hSheafComposeAdditive : ∀ {S : AlgebraicGeometry.Scheme.{u}}
      {𝒟 ℰ : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} 𝒟]
      [CategoryTheory.Category.{u, u + 1} ℰ]
      [CategoryTheory.Preadditive 𝒟] [CategoryTheory.Preadditive ℰ]
      (F : 𝒟 ⥤ ℰ) [F.Additive] [S.smallEtaleTopology.HasSheafCompose F],
      (CategoryTheory.sheafCompose S.smallEtaleTopology F).Additive := by
    intro S 𝒟 ℰ _ _ _ _ F _ _
    exact { map_add := fun {_ _} {f g} =>
      CategoryTheory.Sheaf.hom_ext (CategoryTheory.NatTrans.ext (funext fun V =>
        F.map_add)) }

  
  have hCanonicalForgetUnit : ∀ (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ),
      let R := ULift.{u, 0} (ZMod m)
      let R_mod := ModuleCat.of R R
      let J := S.smallEtaleTopology
      let F_fg := CategoryTheory.forget₂ (ModuleCat.{u, u} R) AddCommGrpCat.{u}
      letI : F_fg.IsRightAdjoint := hForgetIsRightAdj R
      let U_S := CategoryTheory.sheafCompose J F_fg
      let T₀ := weilEtaleIdTerminal.{u} S
      let hT₀ := weilEtaleIdTerminalIsTerminal.{u} S
      let One_S := (CategoryTheory.constantSheaf J (ModuleCat.{u, u} R)).obj R_mod
      let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
      let FM_S := (CategoryTheory.constantSheaf J AddCommGrpCat.{u}).obj AM
      let ιM : AM ⟶ F_fg.obj R_mod := AddCommGrpCat.ofHom (AddMonoidHom.id R)
      let adj_ab := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT₀
      let adj_mod := CategoryTheory.constantSheafAdj J (ModuleCat.{u, u} R) hT₀
      let αM₀ : FM_S ⟶ U_S.obj One_S :=
        (adj_ab.homEquiv AM (U_S.obj One_S)).symm
          (ιM ≫ F_fg.map (adj_mod.unit.app R_mod))
      ∃ πM₀ : U_S.obj One_S ⟶ FM_S,
        αM₀ ≫ πM₀ = 𝟙 FM_S ∧ πM₀ ≫ αM₀ = 𝟙 (U_S.obj One_S) := by
    intro S m R R_mod J F_fg U_S T₀ hT₀ One_S AM FM_S ιM adj_ab adj_mod αM₀
    letI : F_fg.IsRightAdjoint := hForgetIsRightAdj R
    letI : (coextModFunctor R).IsRightAdjoint := hCoextIsRightAdj R
    let C_S := CategoryTheory.sheafCompose J (coextModFunctor R)
    let adj_UC : U_S ⊣ C_S := sheafComposeAdj J (forgetCoextAdj R)
    let u_ab : AM ⟶ FM_S.obj.obj (Opposite.op T₀) := adj_ab.unit.app AM
    let u_R : R →+ ↥(FM_S.obj.obj (Opposite.op T₀)) :=
      { toFun := fun x : R => u_ab.hom (show ↥AM from x)
        map_zero' := u_ab.hom.map_zero
        map_add' := fun x y => u_ab.hom.map_add x y }
    let σ₀ : R_mod ⟶ (C_S.obj FM_S).obj.obj (Opposite.op T₀) :=
      @ModuleCat.ofHom R _ R_mod (R →+ ↥(FM_S.obj.obj (Opposite.op T₀))) _ _ _
        (instModCoext R (FM_S.obj.obj (Opposite.op T₀)))
        { toFun := fun r =>
            { toFun := fun t => u_R (t * r)
              map_zero' := by rw [zero_mul, map_zero]
              map_add' := fun t₁ t₂ => by rw [add_mul, map_add] }
          map_add' := fun r₁ r₂ => AddMonoidHom.ext fun t => by
            change u_R (t * (r₁ + r₂)) = u_R (t * r₁) + u_R (t * r₂)
            rw [mul_add, map_add]
          map_smul' := fun s r => AddMonoidHom.ext fun t => by
            change u_R (t * (s * r)) = u_R ((t * s) * r)
            rw [mul_assoc] }
    let π_adj : One_S ⟶ C_S.obj FM_S := (adj_mod.homEquiv R_mod (C_S.obj FM_S)).symm σ₀
    let πM₀ : U_S.obj One_S ⟶ FM_S := (adj_UC.homEquiv One_S FM_S).symm π_adj
    have hπ_T₀ : F_fg.map (adj_mod.unit.app R_mod) ≫ πM₀.hom.app (Opposite.op T₀) =
        AddCommGrpCat.ofHom u_R := by
      have h1 : adj_mod.unit.app R_mod ≫ π_adj.hom.app (Opposite.op T₀) = σ₀ :=
        (CategoryTheory.Adjunction.homEquiv_unit adj_mod R_mod (C_S.obj FM_S) π_adj).symm.trans
          (Equiv.apply_symm_apply _ _)
      apply AddCommGrpCat.ext
      intro r
      let r₀ : R := r
      have h1_r := congrArg (fun (k : R_mod ⟶ (C_S.obj FM_S).obj.obj (Opposite.op T₀)) =>
        (show R →+ ↥(FM_S.obj.obj (Opposite.op T₀)) from k.hom r₀) 1) h1
      refine h1_r.trans ?_
      change u_R (1 * r₀) = u_R r₀
      rw [one_mul]
    refine ⟨πM₀, ?_, ?_⟩
    · apply (adj_ab.homEquiv AM FM_S).injective
      have hα_eq : adj_ab.homEquiv AM (U_S.obj One_S) αM₀ =
          ιM ≫ F_fg.map (adj_mod.unit.app R_mod) :=
        Equiv.apply_symm_apply _ _
      have hLHS : (adj_ab.homEquiv AM FM_S (αM₀ ≫ πM₀) : AM ⟶ FM_S.obj.obj (Opposite.op T₀)) =
          (ιM ≫ F_fg.map (adj_mod.unit.app R_mod)) ≫ πM₀.hom.app (Opposite.op T₀) :=
        (CategoryTheory.Adjunction.homEquiv_naturality_right adj_ab αM₀ πM₀).trans
          (congrArg (· ≫ _) hα_eq)
      have hRHS : (adj_ab.homEquiv AM FM_S (𝟙 FM_S) : AM ⟶ FM_S.obj.obj (Opposite.op T₀)) =
          u_ab :=
        (CategoryTheory.Adjunction.homEquiv_unit adj_ab AM FM_S (𝟙 FM_S)).trans
          (CategoryTheory.Category.comp_id u_ab)
      refine hLHS.trans (Eq.trans ?_ hRHS.symm)
      apply AddCommGrpCat.ext
      intro a
      exact congrArg (fun k => k.hom (show R from a)) hπ_T₀
    · apply (adj_UC.homEquiv One_S (U_S.obj One_S)).injective
      apply (adj_mod.homEquiv R_mod (C_S.obj (U_S.obj One_S))).injective
      have hLHS1 : adj_UC.homEquiv One_S (U_S.obj One_S) (πM₀ ≫ αM₀) =
          π_adj ≫ C_S.map αM₀ :=
        (CategoryTheory.Adjunction.homEquiv_naturality_right adj_UC πM₀ αM₀).trans
          (congrArg (· ≫ C_S.map αM₀) (Equiv.apply_symm_apply _ _))
      have hLHS2 : (adj_mod.homEquiv R_mod (C_S.obj (U_S.obj One_S)) (π_adj ≫ C_S.map αM₀) :
          R_mod ⟶ (C_S.obj (U_S.obj One_S)).obj.obj (Opposite.op T₀)) =
          σ₀ ≫ (C_S.map αM₀).hom.app (Opposite.op T₀) :=
        (CategoryTheory.Adjunction.homEquiv_naturality_right adj_mod π_adj (C_S.map αM₀)).trans
          (congrArg (· ≫ _) (Equiv.apply_symm_apply _ _))
      have hRHS : (adj_mod.homEquiv R_mod (C_S.obj (U_S.obj One_S))
          (adj_UC.homEquiv One_S (U_S.obj One_S) (𝟙 (U_S.obj One_S))) :
          R_mod ⟶ (C_S.obj (U_S.obj One_S)).obj.obj (Opposite.op T₀)) =
          adj_mod.unit.app R_mod ≫
            ((forgetCoextAdj R).homEquiv (One_S.obj.obj (Opposite.op T₀))
              ((U_S.obj One_S).obj.obj (Opposite.op T₀))) (𝟙 _) :=
        CategoryTheory.Adjunction.homEquiv_unit adj_mod R_mod _ _
      refine ((congrArg (adj_mod.homEquiv R_mod _) hLHS1).trans hLHS2).trans (Eq.trans ?_ hRHS.symm)
      have hα_unit : u_ab ≫ αM₀.hom.app (Opposite.op T₀) =
          ιM ≫ F_fg.map (adj_mod.unit.app R_mod) :=
        (CategoryTheory.Adjunction.homEquiv_unit adj_ab AM (U_S.obj One_S) αM₀).symm.trans
          (Equiv.apply_symm_apply _ _)
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      intro r
      apply AddMonoidHom.ext
      intro t
      have hα_tr := congrArg (fun (k : AM ⟶ (U_S.obj One_S).obj.obj (Opposite.op T₀)) =>
        k.hom (show ↥AM from t * r)) hα_unit
      exact hα_tr.trans ((adj_mod.unit.app R_mod).hom.map_smul t r)

  
  
  
  have hLocConstGlue : ∀ (S : AlgebraicGeometry.Scheme.{u}) (A : Type u) (W : S.Etale)
      (S_cov : CategoryTheory.Sieve W), S_cov ∈ S.smallEtaleTopology W →
      (∀ g₁ g₂ : LocallyConstant ↥W.left A,
        (∀ ⦃V : S.Etale⦄ (f : V ⟶ W), S_cov.arrows f →
          ∀ y : ↥V.left, g₁ (f.left.base y) = g₂ (f.left.base y)) →
        g₁ = g₂) ∧
      (∀ s : ∀ ⦃V : S.Etale⦄ (f : V ⟶ W), S_cov.arrows f → LocallyConstant ↥V.left A,
        (∀ ⦃V₁ V₂ Z : S.Etale⦄ (g₁ : Z ⟶ V₁) (g₂ : Z ⟶ V₂) (f₁ : V₁ ⟶ W) (f₂ : V₂ ⟶ W)
          (hf₁ : S_cov.arrows f₁) (hf₂ : S_cov.arrows f₂),
          g₁ ≫ f₁ = g₂ ≫ f₂ →
          ∀ z : ↥Z.left, s f₁ hf₁ (g₁.left.base z) = s f₂ hf₂ (g₂.left.base z)) →
        ∃ g : LocallyConstant ↥W.left A,
          ∀ ⦃V : S.Etale⦄ (f : V ⟶ W) (hf : S_cov.arrows f) (y : ↥V.left),
            g (f.left.base y) = s f hf y) := by
    intro S A W S_cov hS
    let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
      @AlgebraicGeometry.Etale
    let _ : CategoryTheory.MorphismProperty.IsStableUnderComposition P_et :=
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    have hEq := AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      (P := P_et) (Q := P_et) S le_rfl
    have hCov := (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
      (P := P_et) (Q := P_et) (S := S) W S_cov).mp
      (by erw [← hEq]; exact hS)
    refine ⟨?_, ?_⟩
    · intro g₁ g₂ hEqOn
      ext x
      obtain ⟨V, f, y, hfS, _, hy⟩ := hCov x
      rw [← hy]
      exact hEqOn f hfS y
    · intro s hCompat
      have hAgree : ∀ {V₁ V₂ : S.Etale} (f₁ : V₁ ⟶ W) (f₂ : V₂ ⟶ W)
          (hf₁ : S_cov.arrows f₁) (hf₂ : S_cov.arrows f₂)
          (y₁ : ↥V₁.left) (y₂ : ↥V₂.left),
          f₁.left.base y₁ = f₂.left.base y₂ → s f₁ hf₁ y₁ = s f₂ hf₂ y₂ := by
        intro V₁ V₂ f₁ f₂ hf₁ hf₂ y₁ y₂ hy
        obtain ⟨z, hz₁, hz₂⟩ :=
          AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y₁ y₂ hy
        have hf₂_comp : P_et (f₂.left ≫ W.hom) :=
          Eq.mp (@congrArg _ Prop V₂.hom (f₂.left ≫ W.hom) (fun m => P_et m)
            (CategoryTheory.MorphismProperty.Over.w f₂).symm) V₂.prop
        have hf₂_et : P_et f₂.left :=
          CategoryTheory.MorphismProperty.of_postcomp P_et (W' := P_et) f₂.left W.hom W.prop hf₂_comp
        have hEt_fst : P_et (CategoryTheory.Limits.pullback.fst f₁.left f₂.left) :=
          CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
            (P := P_et) (CategoryTheory.IsPullback.of_hasPullback f₁.left f₂.left).flip hf₂_et
        have hEt_Z : P_et (CategoryTheory.Limits.pullback.fst f₁.left f₂.left ≫ V₁.hom) :=
          CategoryTheory.MorphismProperty.comp_mem _ _ _ hEt_fst V₁.prop
        let Z : S.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤
          (CategoryTheory.Limits.pullback.fst f₁.left f₂.left ≫ V₁.hom) hEt_Z
        let g₁ : Z ⟶ V₁ := CategoryTheory.MorphismProperty.Over.homMk
          (CategoryTheory.Limits.pullback.fst f₁.left f₂.left) rfl trivial
        let g₂ : Z ⟶ V₂ := CategoryTheory.MorphismProperty.Over.homMk
          (CategoryTheory.Limits.pullback.snd f₁.left f₂.left)
          (by
            have hw1 : f₁.left ≫ W.hom = V₁.hom := CategoryTheory.MorphismProperty.Over.w f₁
            have hw2 : f₂.left ≫ W.hom = V₂.hom := CategoryTheory.MorphismProperty.Over.w f₂
            calc
              CategoryTheory.Limits.pullback.snd f₁.left f₂.left ≫ V₂.hom =
                  CategoryTheory.Limits.pullback.snd f₁.left f₂.left ≫ (f₂.left ≫ W.hom) :=
                congrArg _ hw2.symm
              _ = (CategoryTheory.Limits.pullback.snd f₁.left f₂.left ≫ f₂.left) ≫ W.hom :=
                (CategoryTheory.Category.assoc _ _ _).symm
              _ = (CategoryTheory.Limits.pullback.fst f₁.left f₂.left ≫ f₁.left) ≫ W.hom :=
                congrArg (· ≫ W.hom) CategoryTheory.Limits.pullback.condition.symm
              _ = CategoryTheory.Limits.pullback.fst f₁.left f₂.left ≫ (f₁.left ≫ W.hom) :=
                CategoryTheory.Category.assoc _ _ _
              _ = CategoryTheory.Limits.pullback.fst f₁.left f₂.left ≫ V₁.hom := congrArg _ hw1)
          trivial
        have hcomm : g₁ ≫ f₁ = g₂ ≫ f₂ := by
          apply CategoryTheory.MorphismProperty.Over.Hom.ext
          exact CategoryTheory.Limits.pullback.condition
        rw [← hz₁, ← hz₂]
        exact hCompat g₁ g₂ f₁ f₂ hf₁ hf₂ hcomm z
      let g_fun : ↥W.left → A := fun x =>
        s (hCov x).choose_spec.choose (hCov x).choose_spec.choose_spec.choose_spec.1
          (hCov x).choose_spec.choose_spec.choose
      have hg_spec : ∀ ⦃V : S.Etale⦄ (f : V ⟶ W) (hf : S_cov.arrows f) (y : ↥V.left),
          g_fun (f.left.base y) = s f hf y := by
        intro V f hf y
        exact hAgree _ f _ hf _ y
          (hCov (f.left.base y)).choose_spec.choose_spec.choose_spec.2.2
      have hg_lc : IsLocallyConstant g_fun := by
        intro t
        rw [isOpen_iff_forall_mem_open]
        intro x hx
        obtain ⟨V, f, y, hfS, hfEt, hy⟩ := hCov x
        have _ : AlgebraicGeometry.Etale f.left := hfEt
        have hy_t : y ∈ (s f hfS) ⁻¹' t := by
          change s f hfS y ∈ t
          rw [← hg_spec f hfS y, hy]
          exact hx
        have hOpen_pre : IsOpen ((s f hfS) ⁻¹' t) := (s f hfS).isLocallyConstant t
        have hOpen_img : IsOpen (f.left.base '' ((s f hfS) ⁻¹' t)) :=
          AlgebraicGeometry.Scheme.Hom.isOpenMap f.left _ hOpen_pre
        refine ⟨f.left.base '' ((s f hfS) ⁻¹' t), ?_, hOpen_img, ⟨y, hy_t, hy⟩⟩
        rintro x' ⟨y', hy', rfl⟩
        change g_fun (f.left.base y') ∈ t
        rw [hg_spec f hfS y']
        exact hy'
      exact ⟨⟨g_fun, hg_lc⟩, hg_spec⟩

  let locConstModPresheaf : ∀ (S : AlgebraicGeometry.Scheme.{u}) (R : Type u) [CommRing R],
      S.Etaleᵒᵖ ⥤ ModuleCat.{u, u} R := fun S R _ =>
    { obj := fun U => ModuleCat.of R (LocallyConstant ↥U.unop.left R)
      map := fun f => ModuleCat.ofHom
        { toFun := fun g =>
            { toFun := fun x => g (f.unop.left.base x)
              isLocallyConstant := fun t =>
                f.unop.left.continuous.isOpen_preimage _ (g.isLocallyConstant t) }
          map_add' := fun _ _ => LocallyConstant.ext fun _ => rfl
          map_smul' := fun _ _ => LocallyConstant.ext fun _ => rfl }
      map_id := fun _ => ModuleCat.hom_ext (LinearMap.ext fun _ => LocallyConstant.ext fun _ => rfl)
      map_comp := fun _ _ => ModuleCat.hom_ext (LinearMap.ext fun _ => LocallyConstant.ext fun _ => rfl) }

  have hIsSheafLocConstMod : ∀ (S : AlgebraicGeometry.Scheme.{u}) (R : Type u) [CommRing R],
      CategoryTheory.Presheaf.IsSheaf S.smallEtaleTopology (locConstModPresheaf S R) := by
    intro S R _ E W S_cov hS
    obtain ⟨hSep, hGlue⟩ := hLocConstGlue S R W S_cov hS
    intro x hx
    have hLinGlue : ∀ e : E,
        ∃ g : LocallyConstant ↥W.left R,
          ∀ ⦃V : S.Etale⦄ (f : V ⟶ W) (hf : S_cov.arrows f) (y : ↥V.left),
            g (f.left.base y) =
              (show LocallyConstant ↥V.left R from (x f hf).hom e) y := by
      intro e
      refine hGlue (fun V f hf => show LocallyConstant ↥V.left R from (x f hf).hom e) ?_
      intro V₁ V₂ Z g₁ g₂ f₁ f₂ hf₁ hf₂ hcomm z
      have hcomp := hx g₁ g₂ hf₁ hf₂ hcomm
      exact congrArg
        (fun φ : E ⟶ (locConstModPresheaf S R).obj (Opposite.op Z) =>
          (show LocallyConstant ↥Z.left R from φ.hom e) z) hcomp
    choose g_of hg_of using hLinGlue
    let amalg : E ⟶ (locConstModPresheaf S R).obj (Opposite.op W) :=
      ModuleCat.ofHom
        { toFun := g_of
          map_add' := fun e₁ e₂ => hSep _ _ fun V f hf y =>
            (hg_of (e₁ + e₂) f hf y).trans
              ((congrArg (fun (q : LocallyConstant ↥V.left R) => q y)
                ((x f hf).hom.map_add e₁ e₂)).trans
                ((LocallyConstant.add_apply _ _ y).trans
                  (congrArg₂ (· + ·) (hg_of e₁ f hf y).symm (hg_of e₂ f hf y).symm)))
          map_smul' := fun r e => hSep _ _ fun V f hf y =>
            (hg_of (r • e) f hf y).trans
              ((congrArg (fun (q : LocallyConstant ↥V.left R) => q y)
                ((x f hf).hom.map_smul r e)).trans
                ((LocallyConstant.smul_apply _ _ y).trans
                  (congrArg (r • ·) (hg_of e f hf y).symm))) }
    refine ⟨amalg, ?_, ?_⟩
    · intro V f hf
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      intro e
      apply LocallyConstant.ext
      intro y
      exact hg_of e f hf y
    · intro m hm
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      intro e
      apply hSep
      intro V f hf y
      have hm_f := hm f hf
      have hm_y := congrArg
        (fun φ : E ⟶ (locConstModPresheaf S R).obj (Opposite.op V) =>
          (show LocallyConstant ↥V.left R from φ.hom e) y) hm_f
      exact hm_y.trans (hg_of e f hf y).symm

  let locConstModSheaf : ∀ (S : AlgebraicGeometry.Scheme.{u}) (R : Type u) [CommRing R],
      CategoryTheory.Sheaf S.smallEtaleTopology (ModuleCat.{u, u} R) :=
    fun S R _ => ⟨locConstModPresheaf S R, hIsSheafLocConstMod S R⟩

  
  have hLocConstModIso : ∀ (S : AlgebraicGeometry.Scheme.{u}) (R : Type u) [CommRing R],
      let J := S.smallEtaleTopology
      let R_mod := ModuleCat.of R R
      let T₀ := weilEtaleIdTerminal.{u} S
      let hT₀ := weilEtaleIdTerminalIsTerminal.{u} S
      let One_S := (CategoryTheory.constantSheaf J (ModuleCat.{u, u} R)).obj R_mod
      let LSh := locConstModSheaf S R
      let adj_mod := CategoryTheory.constantSheafAdj J (ModuleCat.{u, u} R) hT₀
      let c₀ : R_mod ⟶ LSh.obj.obj (Opposite.op T₀) :=
        ModuleCat.ofHom
          { toFun := fun r => LocallyConstant.const ↥T₀.left r
            map_add' := fun _ _ => LocallyConstant.ext fun _ => rfl
            map_smul' := fun _ _ => LocallyConstant.ext fun _ => rfl }
      ∃ Φ : One_S ≅ LSh,
        adj_mod.unit.app R_mod ≫ Φ.hom.hom.app (Opposite.op T₀) = c₀ := by
    intro S R _ J R_mod T₀ hT₀ One_S LSh adj_mod c₀
    let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
      @AlgebraicGeometry.Etale
    let _ : CategoryTheory.MorphismProperty.IsStableUnderComposition P_et :=
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    have hEq_J := AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      (P := P_et) (Q := P_et) S le_rfl
    have hSecExt : ∀ (G : CategoryTheory.Sheaf J (ModuleCat.{u, u} R))
        {I : Type u} {W : S.Etale} {X : I → S.Etale} (f : ∀ i, X i ⟶ W),
        CategoryTheory.Sieve.ofArrows X f ∈ J W →
        ∀ s₁ s₂ : G.obj.obj (Opposite.op W),
          (∀ i : I, (G.obj.map (f i).op).hom s₁ = (G.obj.map (f i).op).hom s₂) →
          s₁ = s₂ := by
      intro G I W X f hf s₁ s₂ h_eq
      let φ₁ : R_mod ⟶ G.obj.obj (Opposite.op W) :=
        ModuleCat.ofHom (LinearMap.toSpanSingleton R _ s₁)
      let φ₂ : R_mod ⟶ G.obj.obj (Opposite.op W) :=
        ModuleCat.ofHom (LinearMap.toSpanSingleton R _ s₂)
      have hφ : φ₁ = φ₂ := G.property.hom_ext_ofArrows f hf fun i => by
        apply ModuleCat.hom_ext
        apply LinearMap.ext
        intro r
        change (G.obj.map (f i).op).hom (r • s₁) = (G.obj.map (f i).op).hom (r • s₂)
        exact ((G.obj.map (f i).op).hom.map_smul r s₁).trans
          ((congrArg (r • ·) (h_eq i)).trans ((G.obj.map (f i).op).hom.map_smul r s₂).symm)
      have h1 := congrArg (fun φ : R_mod ⟶ G.obj.obj (Opposite.op W) => φ.hom (1 : R)) hφ
      change (1 : R) • s₁ = (1 : R) • s₂ at h1
      exact (one_smul R s₁).symm.trans (h1.trans (one_smul R s₂))
    have hEmptyHomExt : ∀ (G : CategoryTheory.Sheaf J (ModuleCat.{u, u} R)) (Z : S.Etale),
        IsEmpty ↥Z.left →
        ∀ {E : ModuleCat.{u, u} R} (m₁ m₂ : E ⟶ G.obj.obj (Opposite.op Z)), m₁ = m₂ := by
      intro G Z hEmpty E m₁ m₂
      let empX : PEmpty.{u + 1} → S.Etale := PEmpty.elim
      let empF : ∀ i : PEmpty.{u + 1}, empX i ⟶ Z := fun i => i.elim
      have hEmpCov : CategoryTheory.Sieve.ofArrows empX empF ∈ J Z := by
        refine Eq.mp (congrArg (fun K => _ ∈ K Z) hEq_J.symm) ?_
        refine (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
          (P := P_et) (Q := P_et) (S := S) Z _).mpr ?_
        intro x
        exact (hEmpty.false x).elim
      exact G.property.hom_ext_ofArrows empF hEmpCov fun i => i.elim
    let openEt : ∀ (W : S.Etale) (O : W.left.Opens), S.Etale := fun W O =>
      CategoryTheory.MorphismProperty.Over.mk ⊤ (AlgebraicGeometry.Scheme.Opens.ι O ≫ W.hom)
        (CategoryTheory.MorphismProperty.comp_mem P_et _ _
          (inferInstance : P_et (AlgebraicGeometry.Scheme.Opens.ι O)) (W.prop : P_et W.hom))
    let openHom : ∀ (W : S.Etale) (O : W.left.Opens), openEt W O ⟶ W := fun W O =>
      CategoryTheory.MorphismProperty.Over.homMk (AlgebraicGeometry.Scheme.Opens.ι O) rfl trivial
    let fiberOpens : ∀ (W : S.Etale), LocallyConstant ↥W.left R → R → W.left.Opens :=
      fun W φ r => ⟨φ ⁻¹' {r}, φ.isLocallyConstant {r}⟩
    let fiberEt : ∀ (W : S.Etale), LocallyConstant ↥W.left R → R → S.Etale :=
      fun W φ r => openEt W (fiberOpens W φ r)
    let fiberHom : ∀ (W : S.Etale) (φ : LocallyConstant ↥W.left R) (r : R),
        fiberEt W φ r ⟶ W :=
      fun W φ r => openHom W (fiberOpens W φ r)
    have hFiberCov : ∀ (W : S.Etale) (φ : LocallyConstant ↥W.left R),
        CategoryTheory.Sieve.ofArrows (fiberEt W φ) (fiberHom W φ) ∈ J W := by
      intro W φ
      refine Eq.mp (congrArg (fun K => _ ∈ K W) hEq_J.symm) ?_
      refine (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) (S := S) W _).mpr ?_
      intro x
      exact ⟨fiberEt W φ (φ x), fiberHom W φ (φ x), (⟨x, rfl⟩ : ↥(fiberOpens W φ (φ x))),
        CategoryTheory.Sieve.ofArrows_mk _ _ (φ x),
        (inferInstance : P_et (AlgebraicGeometry.Scheme.Opens.ι (fiberOpens W φ (φ x)))), rfl⟩
    have hUniv : ∀ (G : CategoryTheory.Sheaf J (ModuleCat.{u, u} R))
        (α₀ : R_mod ⟶ G.obj.obj (Opposite.op T₀)),
        ∃! α : LSh ⟶ G, c₀ ≫ α.hom.app (Opposite.op T₀) = α₀ := by
      intro G α₀
      have hCompat : ∀ (W : S.Etale) (φ : LocallyConstant ↥W.left R),
          ∀ ⦃Z : S.Etale⦄ ⦃r₁ r₂ : R⦄ (a : Z ⟶ fiberEt W φ r₁) (b : Z ⟶ fiberEt W φ r₂),
            a ≫ fiberHom W φ r₁ = b ≫ fiberHom W φ r₂ →
            ModuleCat.ofHom (LinearMap.toSpanSingleton R _
              ((G.obj.map (hT₀.from (fiberEt W φ r₁)).op).hom (α₀.hom r₁))) ≫ G.obj.map a.op =
            ModuleCat.ofHom (LinearMap.toSpanSingleton R _
              ((G.obj.map (hT₀.from (fiberEt W φ r₂)).op).hom (α₀.hom r₂))) ≫ G.obj.map b.op := by
        intro W φ Z r₁ r₂ a b hab
        by_cases hr : r₁ = r₂
        · subst hr
          apply ModuleCat.hom_ext
          apply LinearMap.ext
          intro t
          change (G.obj.map a.op).hom
              (t • (G.obj.map (hT₀.from (fiberEt W φ r₁)).op).hom (α₀.hom r₁)) =
            (G.obj.map b.op).hom
              (t • (G.obj.map (hT₀.from (fiberEt W φ r₁)).op).hom (α₀.hom r₁))
          have ha_from : a ≫ hT₀.from (fiberEt W φ r₁) = hT₀.from Z := hT₀.hom_ext _ _
          have hb_from : b ≫ hT₀.from (fiberEt W φ r₁) = hT₀.from Z := hT₀.hom_ext _ _
          refine ((G.obj.map a.op).hom.map_smul _ _).trans ?_
          refine (congrArg (t • ·) ?_).trans ((G.obj.map b.op).hom.map_smul _ _).symm
          change ((G.obj.map (hT₀.from (fiberEt W φ r₁)).op ≫ G.obj.map a.op).hom (α₀.hom r₁)) =
            ((G.obj.map (hT₀.from (fiberEt W φ r₁)).op ≫ G.obj.map b.op).hom (α₀.hom r₁))
          rw [← G.obj.map_comp, ← G.obj.map_comp, ← CategoryTheory.op_comp,
            ← CategoryTheory.op_comp, ha_from, hb_from]
        · have hZ_empty : IsEmpty ↥Z.left := ⟨fun z => hr (by
            have h1 : φ ((a ≫ fiberHom W φ r₁).left.base z) = r₁ :=
              (a.left.base z).2
            have h2 : φ ((b ≫ fiberHom W φ r₂).left.base z) = r₂ :=
              (b.left.base z).2
            exact h1.symm.trans ((congrArg (fun k => φ (k.left.base z)) hab).trans h2))⟩
          exact hEmptyHomExt G Z hZ_empty _ _
      let evalSec : ∀ (W : S.Etale), LocallyConstant ↥W.left R → G.obj.obj (Opposite.op W) :=
        fun W φ =>
          (G.property.amalgamateOfArrows (fiberHom W φ) (hFiberCov W φ)
            (fun r => ModuleCat.ofHom (LinearMap.toSpanSingleton R _
              ((G.obj.map (hT₀.from (fiberEt W φ r)).op).hom (α₀.hom r))))
            (hCompat W φ)).hom (1 : R)
      have hEvalSpec : ∀ (W : S.Etale) (φ : LocallyConstant ↥W.left R) (r : R),
          (G.obj.map (fiberHom W φ r).op).hom (evalSec W φ) =
            (G.obj.map (hT₀.from (fiberEt W φ r)).op).hom (α₀.hom r) := by
        intro W φ r
        have hmap := G.property.amalgamateOfArrows_map (fiberHom W φ) (hFiberCov W φ)
          (fun r => ModuleCat.ofHom (LinearMap.toSpanSingleton R _
            ((G.obj.map (hT₀.from (fiberEt W φ r)).op).hom (α₀.hom r))))
          (hCompat W φ) r
        have h1 := congrArg
          (fun k : R_mod ⟶ G.obj.obj (Opposite.op (fiberEt W φ r)) => k.hom (1 : R)) hmap
        exact h1.trans (one_smul R _)
      
      have hEvalOnConstOpen : ∀ (W : S.Etale) (φ : LocallyConstant ↥W.left R)
          (O : W.left.Opens) (r : R) (hle : O ≤ fiberOpens W φ r),
          (G.obj.map (openHom W O).op).hom (evalSec W φ) =
            (G.obj.map (hT₀.from (openEt W O)).op).hom (α₀.hom r) := by
        intro W φ O r hle
        let inc : openEt W O ⟶ fiberEt W φ r :=
          CategoryTheory.MorphismProperty.Over.homMk (W.left.homOfLE hle)
            (by
              change W.left.homOfLE hle ≫
                  (AlgebraicGeometry.Scheme.Opens.ι (fiberOpens W φ r) ≫ W.hom) =
                AlgebraicGeometry.Scheme.Opens.ι O ≫ W.hom
              rw [← CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.homOfLE_ι])
            trivial
        have hfac : inc ≫ fiberHom W φ r = openHom W O := by
          apply CategoryTheory.MorphismProperty.Over.Hom.ext
          exact AlgebraicGeometry.Scheme.homOfLE_ι _ hle
        have hfrom : inc ≫ hT₀.from (fiberEt W φ r) = hT₀.from (openEt W O) :=
          hT₀.hom_ext _ _
        calc
          (G.obj.map (openHom W O).op).hom (evalSec W φ) =
              (G.obj.map (inc ≫ fiberHom W φ r).op).hom (evalSec W φ) := by rw [hfac]
          _ = (G.obj.map inc.op).hom ((G.obj.map (fiberHom W φ r).op).hom (evalSec W φ)) := by
            rw [CategoryTheory.op_comp, G.obj.map_comp]
            rfl
          _ = (G.obj.map inc.op).hom
              ((G.obj.map (hT₀.from (fiberEt W φ r)).op).hom (α₀.hom r)) :=
            congrArg _ (hEvalSpec W φ r)
          _ = (G.obj.map (hT₀.from (openEt W O)).op).hom (α₀.hom r) := by
            change ((G.obj.map (hT₀.from (fiberEt W φ r)).op ≫ G.obj.map inc.op).hom (α₀.hom r)) = _
            rw [← G.obj.map_comp, ← CategoryTheory.op_comp, hfrom]
      let α_mor : LSh ⟶ G :=
        CategoryTheory.ObjectProperty.homMk
          { app := fun W_op =>
              let W := W_op.unop
              ModuleCat.ofHom
                { toFun := evalSec W
                  map_add' := fun φ₁ φ₂ => by
                    let pairOpens : R × R → W.left.Opens :=
                      fun p => fiberOpens W φ₁ p.1 ⊓ fiberOpens W φ₂ p.2
                    have hPairCov : CategoryTheory.Sieve.ofArrows
                        (fun p : R × R => openEt W (pairOpens p))
                        (fun p : R × R => openHom W (pairOpens p)) ∈ J W := by
                      refine Eq.mp (congrArg (fun K => _ ∈ K W) hEq_J.symm) ?_
                      refine (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
                        (P := P_et) (Q := P_et) (S := S) W _).mpr ?_
                      intro x
                      let p₀ : R × R := (φ₁ x, φ₂ x)
                      exact ⟨openEt W (pairOpens p₀), openHom W (pairOpens p₀),
                        (⟨x, ⟨rfl, rfl⟩⟩ : ↥(pairOpens p₀)),
                        CategoryTheory.Sieve.ofArrows_mk _ _ p₀,
                        (inferInstance : P_et
                          (AlgebraicGeometry.Scheme.Opens.ι (pairOpens p₀))), rfl⟩
                    refine hSecExt G (fun p : R × R => openHom W (pairOpens p)) hPairCov _ _ ?_
                    intro p
                    have hle_sum : pairOpens p ≤ fiberOpens W (φ₁ + φ₂) (p.1 + p.2) := by
                      rintro x ⟨hx₁, hx₂⟩
                      change φ₁ x + φ₂ x = p.1 + p.2
                      rw [hx₁, hx₂]
                    have hL := hEvalOnConstOpen W (φ₁ + φ₂) (pairOpens p) (p.1 + p.2) hle_sum
                    have hR₁ := hEvalOnConstOpen W φ₁ (pairOpens p) p.1 inf_le_left
                    have hR₂ := hEvalOnConstOpen W φ₂ (pairOpens p) p.2 inf_le_right
                    refine hL.trans ?_
                    rw [map_add, map_add]
                    exact (congrArg₂ (· + ·) hR₁.symm hR₂.symm).trans
                      ((G.obj.map (openHom W (pairOpens p)).op).hom.map_add _ _).symm
                  map_smul' := fun c φ => by
                    refine hSecExt G (fiberHom W φ) (hFiberCov W φ) _ _ ?_
                    intro r
                    have hle_sm : fiberOpens W φ r ≤ fiberOpens W (c • φ) (c * r) := by
                      intro x hx
                      change c * φ x = c * r
                      rw [hx]
                    have hL := hEvalOnConstOpen W (c • φ) (fiberOpens W φ r) (c * r) hle_sm
                    have hR := hEvalSpec W φ r
                    refine hL.trans ?_
                    change (G.obj.map _).hom (α₀.hom (c • r)) = _
                    rw [map_smul, map_smul]
                    exact (congrArg (c • ·) hR.symm).trans
                      ((G.obj.map (fiberHom W φ r).op).hom.map_smul c (evalSec W φ)).symm }
            naturality := fun {W₁_op W₂_op} u_op => by
              let W₁ := W₁_op.unop
              let W₂ := W₂_op.unop
              let u : W₂ ⟶ W₁ := u_op.unop
              apply ModuleCat.hom_ext
              apply LinearMap.ext
              intro φ
              let φ_u : LocallyConstant ↥W₂.left R :=
                (LSh.obj.map u.op).hom φ
              refine hSecExt G (fiberHom W₂ φ_u) (hFiberCov W₂ φ_u) _ _ ?_
              intro r
              have hR := hEvalSpec W₂ φ_u r
              have hsub_r : Set.range
                    (AlgebraicGeometry.Scheme.Opens.ι (fiberOpens W₂ φ_u r) ≫ u.left).base ⊆
                  Set.range (AlgebraicGeometry.Scheme.Opens.ι (fiberOpens W₁ φ r)).base := by
                rintro _ ⟨y, rfl⟩
                exact ⟨⟨(AlgebraicGeometry.Scheme.Opens.ι (fiberOpens W₂ φ_u r) ≫
                  u.left).base y, y.2⟩, rfl⟩
              let l_mor : (fiberOpens W₂ φ_u r).toScheme ⟶ (fiberOpens W₁ φ r).toScheme :=
                AlgebraicGeometry.IsOpenImmersion.lift
                  (AlgebraicGeometry.Scheme.Opens.ι (fiberOpens W₁ φ r))
                  (AlgebraicGeometry.Scheme.Opens.ι (fiberOpens W₂ φ_u r) ≫ u.left) hsub_r
              have hl_fac : l_mor ≫ AlgebraicGeometry.Scheme.Opens.ι (fiberOpens W₁ φ r) =
                  AlgebraicGeometry.Scheme.Opens.ι (fiberOpens W₂ φ_u r) ≫ u.left :=
                AlgebraicGeometry.IsOpenImmersion.lift_fac
                  (AlgebraicGeometry.Scheme.Opens.ι (fiberOpens W₁ φ r))
                  (AlgebraicGeometry.Scheme.Opens.ι (fiberOpens W₂ φ_u r) ≫ u.left) hsub_r
              let lift_r : fiberEt W₂ φ_u r ⟶ fiberEt W₁ φ r :=
                CategoryTheory.MorphismProperty.Over.homMk l_mor
                  ((CategoryTheory.Category.assoc l_mor
                    (AlgebraicGeometry.Scheme.Opens.ι (fiberOpens W₁ φ r)) W₁.hom).symm.trans
                    ((congrArg (· ≫ W₁.hom) hl_fac).trans
                      ((CategoryTheory.Category.assoc
                        (AlgebraicGeometry.Scheme.Opens.ι (fiberOpens W₂ φ_u r))
                        u.left W₁.hom).trans
                        (congrArg (AlgebraicGeometry.Scheme.Opens.ι (fiberOpens W₂ φ_u r) ≫ ·)
                          (CategoryTheory.MorphismProperty.Over.w u)))))
                  trivial
              have hlift_fac : lift_r ≫ fiberHom W₁ φ r = fiberHom W₂ φ_u r ≫ u := by
                apply CategoryTheory.MorphismProperty.Over.Hom.ext
                exact hl_fac
              have hlift_from : lift_r ≫ hT₀.from (fiberEt W₁ φ r) =
                  hT₀.from (fiberEt W₂ φ_u r) := hT₀.hom_ext _ _
              have hL : (G.obj.map (fiberHom W₂ φ_u r).op).hom
                  ((G.obj.map u.op).hom (evalSec W₁ φ)) =
                  (G.obj.map (hT₀.from (fiberEt W₂ φ_u r)).op).hom (α₀.hom r) := by
                calc
                  (G.obj.map (fiberHom W₂ φ_u r).op).hom
                      ((G.obj.map u.op).hom (evalSec W₁ φ)) =
                      (G.obj.map (fiberHom W₂ φ_u r ≫ u).op).hom (evalSec W₁ φ) := by
                    rw [CategoryTheory.op_comp, G.obj.map_comp]
                    rfl
                  _ = (G.obj.map (lift_r ≫ fiberHom W₁ φ r).op).hom (evalSec W₁ φ) := by
                    rw [hlift_fac]
                  _ = (G.obj.map lift_r.op).hom
                      ((G.obj.map (fiberHom W₁ φ r).op).hom (evalSec W₁ φ)) := by
                    rw [CategoryTheory.op_comp, G.obj.map_comp]
                    rfl
                  _ = (G.obj.map lift_r.op).hom
                      ((G.obj.map (hT₀.from (fiberEt W₁ φ r)).op).hom (α₀.hom r)) :=
                    congrArg _ (hEvalSpec W₁ φ r)
                  _ = (G.obj.map (hT₀.from (fiberEt W₂ φ_u r)).op).hom (α₀.hom r) := by
                    change ((G.obj.map (hT₀.from (fiberEt W₁ φ r)).op ≫
                      G.obj.map lift_r.op).hom (α₀.hom r)) = _
                    rw [← G.obj.map_comp, ← CategoryTheory.op_comp, hlift_from]
              exact hR.trans hL.symm }
      refine ⟨α_mor, ?_, ?_⟩
      · apply ModuleCat.hom_ext
        apply LinearMap.ext
        intro r₀
        let cst_r₀ : LocallyConstant ↥T₀.left R := LocallyConstant.const ↥T₀.left r₀
        refine hSecExt G (fiberHom T₀ cst_r₀) (hFiberCov T₀ cst_r₀)
          (evalSec T₀ cst_r₀) (α₀.hom r₀) ?_
        intro r
        by_cases hrr : r = r₀
        · subst hrr
          have hfrom_eq : hT₀.from (fiberEt T₀ cst_r₀ r) = fiberHom T₀ cst_r₀ r :=
            hT₀.hom_ext _ _
          exact (hEvalSpec T₀ cst_r₀ r).trans (by rw [hfrom_eq])
        · have hEmp : IsEmpty ↥(fiberEt T₀ cst_r₀ r).left := ⟨fun z => hrr z.2.symm⟩
          have h_hom_eq :
              ModuleCat.ofHom (LinearMap.toSpanSingleton R _
                ((G.obj.map (fiberHom T₀ cst_r₀ r).op).hom (evalSec T₀ cst_r₀))) =
              ModuleCat.ofHom (LinearMap.toSpanSingleton R _
                ((G.obj.map (fiberHom T₀ cst_r₀ r).op).hom (α₀.hom r₀))) :=
            hEmptyHomExt G (fiberEt T₀ cst_r₀ r) hEmp _ _
          have h1 := congrArg
            (fun k : R_mod ⟶ G.obj.obj (Opposite.op (fiberEt T₀ cst_r₀ r)) => k.hom (1 : R))
            h_hom_eq
          exact (one_smul R _).symm.trans (h1.trans (one_smul R _))
      · intro β hβ
        apply CategoryTheory.Sheaf.hom_ext
        apply CategoryTheory.NatTrans.ext
        funext W_op
        let W := W_op.unop
        apply ModuleCat.hom_ext
        apply LinearMap.ext
        intro φ
        refine hSecExt G (fiberHom W φ) (hFiberCov W φ)
          ((β.hom.app (Opposite.op W)).hom φ) (evalSec W φ) ?_
        intro r
        have hφ_res : (LSh.obj.map (fiberHom W φ r).op).hom φ =
            (LSh.obj.map (hT₀.from (fiberEt W φ r)).op).hom (c₀.hom r) := by
          apply LocallyConstant.ext
          intro y
          exact y.2
        have hβ_nat1 := congrArg (fun k => k.hom φ)
          (β.hom.naturality (fiberHom W φ r).op)
        have hβ_nat2 := congrArg (fun k => k.hom (c₀.hom r))
          (β.hom.naturality (hT₀.from (fiberEt W φ r)).op)
        change (LSh.obj.map (fiberHom W φ r).op ≫ β.hom.app _).hom φ =
          (β.hom.app (Opposite.op W) ≫ G.obj.map (fiberHom W φ r).op).hom φ at hβ_nat1
        change (LSh.obj.map (hT₀.from (fiberEt W φ r)).op ≫ β.hom.app _).hom (c₀.hom r) =
