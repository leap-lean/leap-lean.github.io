          ((F₂.mapExtAddHom X Y n) e) (Nat.zero_add n)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (σ.inv.app Y)) (Nat.add_zero n) := by
    intro 𝒞 𝒟 _ _ _ _ _ _ _ F₁ F₂ _ _ _ _ _ _ σ X Y n
    induction n generalizing Y with
    | zero =>
      intro e
      obtain ⟨f, rfl⟩ : ∃ f : X ⟶ Y, CategoryTheory.Abelian.Ext.mk₀ f = e :=
        ⟨CategoryTheory.Abelian.Ext.addEquiv₀ e,
          CategoryTheory.Abelian.Ext.addEquiv₀.symm_apply_apply e⟩
      simp only [CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
      congr 1
      rw [← σ.hom.naturality f, CategoryTheory.Category.assoc, σ.hom_inv_id_app,
        CategoryTheory.Category.comp_id]
    | succ m ih =>
      intro e
      let I : 𝒞 := CategoryTheory.Injective.under Y
      let ι : Y ⟶ I := CategoryTheory.Injective.ι Y
      let S : CategoryTheory.ShortComplex 𝒞 :=
        CategoryTheory.ShortComplex.mk ι (CategoryTheory.Limits.cokernel.π ι)
          (CategoryTheory.Limits.cokernel.condition ι)
      have hS : S.ShortExact :=
        CategoryTheory.ShortComplex.ShortExact.mk (CategoryTheory.ShortComplex.exact_cokernel ι)
      have hI0 : e.comp (CategoryTheory.Abelian.Ext.mk₀ ι) (Nat.add_zero (m + 1)) = 0 :=
        CategoryTheory.Abelian.Ext.eq_zero_of_injective _
      obtain ⟨x₃, rfl⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ X hS e hI0 rfl
      simp only [CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass]
      change (((F₁.mapExtAddHom X S.X₃ m) x₃).comp (hS.map_of_exact F₁).extClass rfl) =
        ((CategoryTheory.Abelian.Ext.mk₀ (σ.hom.app X)).comp
          (((F₂.mapExtAddHom X S.X₃ m) x₃).comp (hS.map_of_exact F₂).extClass rfl)
          (Nat.zero_add (m + 1))).comp
          (CategoryTheory.Abelian.Ext.mk₀ (σ.inv.app Y)) (Nat.add_zero (m + 1))
      rw [ih S.X₃ x₃]
      have hNat : (CategoryTheory.Abelian.Ext.mk₀ (σ.inv.app S.X₃)).comp
          (hS.map_of_exact F₁).extClass (Nat.zero_add 1) =
          (hS.map_of_exact F₂).extClass.comp
            (CategoryTheory.Abelian.Ext.mk₀ (σ.inv.app S.X₁)) (Nat.add_zero 1) :=
        (CategoryTheory.ShortComplex.ShortExact.extClass_naturality
          (hS.map_of_exact F₂) (hS.map_of_exact F₁) (S.mapNatTrans σ.inv)).symm
      rw [CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero _
          (CategoryTheory.Abelian.Ext.mk₀ (σ.inv.app S.X₃)) (hS.map_of_exact F₁).extClass rfl,
        hNat,
        ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _
          (hS.map_of_exact F₂).extClass (CategoryTheory.Abelian.Ext.mk₀ (σ.inv.app S.X₁)) rfl,
        CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ (σ.hom.app X))
          ((F₂.mapExtAddHom X S.X₃ m) x₃) (hS.map_of_exact F₂).extClass
          (Nat.zero_add m) rfl (Nat.zero_add (m + 1))]
  have hMapExtComp : ∀ {𝒞 𝒟 ℰ : Type (u + 1)}
      [CategoryTheory.Category.{u + 1, u + 1} 𝒞]
      [CategoryTheory.Category.{u + 1, u + 1} 𝒟]
      [CategoryTheory.Category.{u + 1, u + 1} ℰ]
      [CategoryTheory.Abelian 𝒞] [CategoryTheory.Abelian 𝒟] [CategoryTheory.Abelian ℰ]
      [CategoryTheory.EnoughInjectives 𝒞]
      [CategoryTheory.HasExt.{u} 𝒞] [CategoryTheory.HasExt.{u} 𝒟] [CategoryTheory.HasExt.{u} ℰ]
      (F : 𝒞 ⥤ 𝒟) (G : 𝒟 ⥤ ℰ)
      [F.Additive] [CategoryTheory.Limits.PreservesFiniteLimits F]
      [CategoryTheory.Limits.PreservesFiniteColimits F]
      [G.Additive] [CategoryTheory.Limits.PreservesFiniteLimits G]
      [CategoryTheory.Limits.PreservesFiniteColimits G]
      (X Y : 𝒞) (n : ℕ) (e : CategoryTheory.Abelian.Ext.{u} X Y n),
      ((F ⋙ G).mapExtAddHom X Y n) e =
        (G.mapExtAddHom (F.obj X) (F.obj Y) n) ((F.mapExtAddHom X Y n) e) := by
    intro 𝒞 𝒟 ℰ _ _ _ _ _ _ _ _ _ _ F G _ _ _ _ _ _ X Y n
    induction n generalizing Y with
    | zero =>
      intro e
      obtain ⟨f, rfl⟩ : ∃ f : X ⟶ Y, CategoryTheory.Abelian.Ext.mk₀ f = e :=
        ⟨CategoryTheory.Abelian.Ext.addEquiv₀ e,
          CategoryTheory.Abelian.Ext.addEquiv₀.symm_apply_apply e⟩
      simp only [CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀]
      rfl
    | succ m ih =>
      intro e
      let I : 𝒞 := CategoryTheory.Injective.under Y
      let ι : Y ⟶ I := CategoryTheory.Injective.ι Y
      let S : CategoryTheory.ShortComplex 𝒞 :=
        CategoryTheory.ShortComplex.mk ι (CategoryTheory.Limits.cokernel.π ι)
          (CategoryTheory.Limits.cokernel.condition ι)
      have hS : S.ShortExact :=
        CategoryTheory.ShortComplex.ShortExact.mk (CategoryTheory.ShortComplex.exact_cokernel ι)
      have hI0 : e.comp (CategoryTheory.Abelian.Ext.mk₀ ι) (Nat.add_zero (m + 1)) = 0 :=
        CategoryTheory.Abelian.Ext.eq_zero_of_injective _
      obtain ⟨x₃, rfl⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ X hS e hI0 rfl
      simp only [CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass]
      change (((F ⋙ G).mapExtAddHom X S.X₃ m) x₃).comp (hS.map_of_exact (F ⋙ G)).extClass rfl =
        ((G.mapExtAddHom _ _ m) (((F.mapExtAddHom X S.X₃ m) x₃))).comp
          ((hS.map_of_exact F).map_of_exact G).extClass rfl
