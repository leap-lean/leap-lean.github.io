              (CategoryTheory.Category.comp_id _))))
    have h_cg_hom :
        (e_cg.hom.app Z).left ≫ CategoryTheory.Limits.pullback.fst Z.hom (g₀ ≫ s₀) =
          CategoryTheory.Limits.pullback.fst Z.hom (i₀ ≫ f) :=
      (congrArg (· ≫ CategoryTheory.Limits.pullback.fst Z.hom (g₀ ≫ s₀))
        (CategoryTheory.Limits.pullback.congrHom_hom (rfl : Z.hom = Z.hom) hcomm)).trans
        ((CategoryTheory.Limits.pullback.lift_fst _ _ _).trans
          (CategoryTheory.Category.comp_id _))
    have h_cg_id : (e_cg.inv.app Z).left ≫ (e_cg.hom.app Z).left = 𝟙 _ :=
      congrArg (fun m => m.left) (e_cg.inv_hom_id_app Z)
    have h_cg_inv :
