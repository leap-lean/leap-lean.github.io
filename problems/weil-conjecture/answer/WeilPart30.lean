  have hP1_comp_inv : ∀ {Y₁ Y₂ Y₃ : AlgebraicGeometry.Scheme.{u}}
      (f : Y₁ ⟶ Y₂) (g : Y₂ ⟶ Y₃) (fg : Y₁ ⟶ Y₃) (hfg : f ≫ g = fg) (Z : Y₃.Etale),
      let e : weilEtaleSitePullback fg ≅ weilEtaleSitePullback g ⋙ weilEtaleSitePullback f :=
        (CategoryTheory.MorphismProperty.Over.pullbackCongr hfg).symm ≪≫
          CategoryTheory.MorphismProperty.Over.pullbackComp f g
      (e.inv.app Z).left ≫ CategoryTheory.Limits.pullback.fst Z.hom fg =
        CategoryTheory.Limits.pullback.fst ((weilEtaleSitePullback g).obj Z).hom f ≫
          CategoryTheory.Limits.pullback.fst Z.hom g := by
    intro Y₁ Y₂ Y₃ f g fg hfg Z e
    let e_fg : weilEtaleSitePullback (f ≫ g) ≅
        weilEtaleSitePullback g ⋙ weilEtaleSitePullback f :=
      CategoryTheory.MorphismProperty.Over.pullbackComp f g
    let e_cg : weilEtaleSitePullback (f ≫ g) ≅ weilEtaleSitePullback fg :=
      CategoryTheory.MorphismProperty.Over.pullbackCongr hfg
    have he : (e.inv.app Z).left = (e_fg.inv.app Z).left ≫ (e_cg.hom.app Z).left := rfl
    have h_cg_hom : (e_cg.hom.app Z).left ≫ CategoryTheory.Limits.pullback.fst Z.hom fg =
        CategoryTheory.Limits.pullback.fst Z.hom (f ≫ g) :=
      (congrArg (· ≫ CategoryTheory.Limits.pullback.fst Z.hom fg)
        (CategoryTheory.Limits.pullback.congrHom_hom (rfl : Z.hom = Z.hom) hfg)).trans
        ((CategoryTheory.Limits.pullback.lift_fst _ _ _).trans
          (CategoryTheory.Category.comp_id _))
    have hinv := CategoryTheory.MorphismProperty.Over.pullbackComp_inv_app_left f g (f ≫ g) rfl Z
    have hinv' : (e_fg.inv.app Z).left ≫ CategoryTheory.Limits.pullback.fst Z.hom (f ≫ g) =
        CategoryTheory.Limits.pullback.fst ((weilEtaleSitePullback g).obj Z).hom f ≫
          CategoryTheory.Limits.pullback.fst Z.hom g :=
      (congrArg (· ≫ CategoryTheory.Limits.pullback.fst Z.hom (f ≫ g)) hinv).trans
        ((CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg ((CategoryTheory.Limits.pullbackLeftPullbackSndIso Z.hom g f).hom ≫ ·)
            ((CategoryTheory.Limits.pullback.lift_fst _ _ _).trans
              (CategoryTheory.Category.comp_id _))).trans
            (CategoryTheory.Limits.pullbackLeftPullbackSndIso_hom_fst Z.hom g f)))
    exact (congrArg (· ≫ CategoryTheory.Limits.pullback.fst Z.hom fg) he).trans
      ((CategoryTheory.Category.assoc _ _ _).trans
        ((congrArg ((e_fg.inv.app Z).left ≫ ·) h_cg_hom).trans hinv'))

  have hP1_sq_inv : ∀ {P₀ E B_base S_base : AlgebraicGeometry.Scheme.{u}}
