      exact (CategoryTheory.Category.comp_id (Fgt_P'.map ψ_hat_P.inv).left).symm.trans
        ((congrArg ((Fgt_P'.map ψ_hat_P.inv).left ≫ ·) e_U.inv_hom_id.symm).trans
