    let F_fg := CategoryTheory.forget₂ (ModuleCat.{u, u} R) AddCommGrpCat.{u}
    let B_g : CategoryTheory.Functor Y.Etale Y'.Etale := weilAltCdSitePullback g
    let J_Y := Y.smallEtaleTopology
    let J_Y' := Y'.smallEtaleTopology
    let Fgt_Y := AlgebraicGeometry.Scheme.Etale.forget Y
