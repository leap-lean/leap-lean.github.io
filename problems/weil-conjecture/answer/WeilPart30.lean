    let _ft_d := Fintype.ofFinite ((pb_s.obj (weilEtaleTorsionSheaf B.left (ℓ ^ 1))).H 0)
    let _ft_c := Fintype.ofFinite ((pb_s.obj (pf_pbar.obj (weilEtaleTorsionSheaf P (ℓ ^ 1)))).H 0)
    let eG : (pb_s.obj (pf_pbar.obj (weilEtaleTorsionSheaf P (ℓ ^ 1)))).H 0 ≃
        (pb_s.obj (weilEtaleTorsionSheaf B.left (ℓ ^ 1))).H 0 :=
