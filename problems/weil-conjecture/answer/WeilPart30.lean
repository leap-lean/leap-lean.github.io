      (CategoryTheory.Limits.pullback.fst u_P π) =
      CategoryTheory.CategoryStruct.id U)
    (hσ_open : AlgebraicGeometry.IsOpenImmersion
      (((AlgebraicGeometry.Scheme.Etale.forget W₀).map σ₀).left))
    (hσ_closed : AlgebraicGeometry.IsClosedImmersion
