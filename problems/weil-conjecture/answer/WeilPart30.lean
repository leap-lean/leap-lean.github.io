        (AddCommGrpCat.of (ULift.{u} ℤ)))) :
    let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
    let T_Ω := weilGysinEtaleObj (CategoryTheory.CategoryStruct.id S_Ω) inferInstance
    let U_W := weilGysinEtaleObj j_W inferInstance
    let U_P := weilGysinEtaleObj u_P hu_P
    let pf_π := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
