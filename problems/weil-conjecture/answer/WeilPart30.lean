          (CategoryTheory.MorphismProperty.Over.pullback_map_left P_et ⊤ σ_inf (B_f.map g))).trans
          (CategoryTheory.Limits.pullback.lift_snd _ _ _)
      have hmap_f1 : (B_f.map g).left ≫ CategoryTheory.Limits.pullback.fst U₂.hom p_bar =
