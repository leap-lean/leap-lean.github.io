                FM₁.obj.map (B_ν.map (hT₀.from U₀)).op) ≫ FM₁.obj.map σ_e.op =
              ((adj_c₁.unit.app AM ≫ FM₁.obj.map (hT₁.from (B_ν.obj T₀)).op) ≫
                FM₁.obj.map (B_ν.map (hT₀.from U₀)).op) ≫ FM₁.obj.map σ_e.op :=
            congrArg (fun x => (x ≫ FM₁.obj.map (B_ν.map (hT₀.from U₀)).op) ≫ FM₁.obj.map σ_e.op)
              ((hConstAdj_homEquiv _ hT₀ AM _ uM_ν).symm.trans (Equiv.apply_symm_apply _ _))
          have s7 : ((adj_c₁.unit.app AM ≫ FM₁.obj.map (hT₁.from (B_ν.obj T₀)).op) ≫
                FM₁.obj.map (B_ν.map (hT₀.from U₀)).op) ≫ FM₁.obj.map σ_e.op =
              adj_c₁.unit.app AM ≫
                (FM₁.obj.map (hT₁.from (B_ν.obj T₀)).op ≫
                  (FM₁.obj.map (B_ν.map (hT₀.from U₀)).op ≫ FM₁.obj.map σ_e.op)) :=
            (Category.assoc _ _ _).trans (Category.assoc _ _ _)
          have s8 : adj_c₁.unit.app AM ≫
                (FM₁.obj.map (hT₁.from (B_ν.obj T₀)).op ≫
                  (FM₁.obj.map (B_ν.map (hT₀.from U₀)).op ≫ FM₁.obj.map σ_e.op)) =
              adj_c₁.unit.app AM ≫ FM₁.obj.map (hT₁.from U₁).op :=
            congrArg (adj_c₁.unit.app AM ≫ ·) hterm_map
          have s9 : adj_c₁.unit.app AM ≫ FM₁.obj.map (hT₁.from U₁).op =
              (((sheafificationAdjunction J₁ AddCommGrpCat.{u}).unit.app
                ((Functor.const (Opposite W₁.Etale)).obj AM)).app (Opposite.op U₁)) :=
            (congrArg (· ≫ FM₁.obj.map (hT₁.from U₁).op)
              (hConstAdj_unit _ hT₁ AM)).trans (hUnit_const_nat W₁ AM (hT₁.from U₁))
          exact s1.trans (s2.trans (s3.trans (s4.trans
            (s5.trans (s6.trans (s7.trans (s8.trans s9)))))))
        exact hLHS_post.trans hRHS_post.symm
      have h_cancel := congrArg (· ≫ FM₁.obj.map σ_inv.op) h_post
      have h_id_map : FM₁.obj.map σ_e.op ≫ FM₁.obj.map σ_inv.op =
          𝟙 (FM₁.obj.obj (Opposite.op (B_ν.obj U₀))) := by
        erw [← FM₁.obj.map_comp, ← op_comp, hσ_inv_hom, op_id, FM₁.obj.map_id]
      exact (Category.comp_id _).symm.trans
        ((congrArg (_ ≫ ·) h_id_map.symm).trans
          ((Category.assoc _ _ _).symm.trans
            (h_cancel.trans
              ((Category.assoc _ _ _).trans
                ((congrArg (_ ≫ ·) h_id_map).trans (Category.comp_id _))))))
    have hsq_counit_pull : (adj_ν.homEquiv L₀ L₁).symm α_ν ≫
        weilGysinLocalTorsionCounit W₁ m U₁ =
        P_pull.map (weilGysinLocalTorsionCounit W₀ m U₀) ≫ πM := by
      erw [← adj_ν.homEquiv_naturality_right_symm, ← adj_ν.homEquiv_naturality_left_symm,
        hsq_counit_sheaf]
    
    let η : P_pull ≅ P_pull' := Adjunction.leftAdjointUniq adj_ν adj_pull'
    have hmate_symm : ∀ (A : AddCommGrpCat.{u}) (u : C₀.obj A ⟶ pf_ν.obj (C₁.obj A)),
        (adj_ν.homEquiv (C₀.obj A) (C₁.obj A)).symm u =
          η.hom.app (C₀.obj A) ≫ (adj_pull'.homEquiv (C₀.obj A) (C₁.obj A)).symm u := by
      intro A u
      apply (adj_ν.homEquiv (C₀.obj A) (C₁.obj A)).injective
      erw [Equiv.apply_symm_apply, Adjunction.homEquiv_unit, pf_ν.map_comp,
        ← Category.assoc, Adjunction.unit_leftAdjointUniq_hom_app,
        ← Adjunction.homEquiv_unit, Equiv.apply_symm_apply]
    let adj_c'₁ := constantSheafAdj J₁ AddCommGrpCat.{u} hT'₁
    let adj_c'₀ := constantSheafAdj J₀ AddCommGrpCat.{u} hT'₀
    let uℤ_ν : Fℤ₀ ⟶ pf_ν.obj Fℤ₁ :=
      (adj_c₀.homEquiv Aℤ (pf_ν.obj Fℤ₁)).symm
        (adj_c₁.unit.app Aℤ ≫ Fℤ₁.obj.map (Opposite.op (hT₁.from (B_ν.obj T₀))))
    let uℤ'_ν : Fℤ₀ ⟶ pf_ν.obj Fℤ₁ :=
      (adj_c'₀.homEquiv Aℤ (pf_ν.obj Fℤ₁)).symm
        (adj_c'₁.unit.app Aℤ ≫ Fℤ₁.obj.map (Opposite.op (hT'₁.from (B_ν.obj T'₀))))
    let uM'_ν : FM₀ ⟶ pf_ν.obj FM₁ :=
      (adj_c'₀.homEquiv AM (pf_ν.obj FM₁)).symm
        (adj_c'₁.unit.app AM ≫ FM₁.obj.map (Opposite.op (hT'₁.from (B_ν.obj T'₀))))
    have huℤ_eq : uℤ_ν = uℤ'_ν := hConstUnit_indep ν hCont' T₁ T'₁ hT₁ hT'₁ T₀ T'₀ hT₀ hT'₀ Aℤ
    have huM_eq : uM_ν = uM'_ν := hConstUnit_indep ν hCont' T₁ T'₁ hT₁ hT'₁ T₀ T'₀ hT₀ hT'₀ AM
    let πℤ : P_pull.obj Fℤ₀ ⟶ Fℤ₁ := (adj_ν.homEquiv Fℤ₀ Fℤ₁).symm uℤ_ν
    let πℤ' : P_pull'.obj Fℤ₀ ⟶ Fℤ₁ := (adj_pull'.homEquiv Fℤ₀ Fℤ₁).symm uℤ'_ν
    let πM' : P_pull'.obj FM₀ ⟶ FM₁ := (adj_pull'.homEquiv FM₀ FM₁).symm uM'_ν
    have hιπ'_let : ιℤ' ≫ πℤ' = 𝟙 Fℤ₁ := hιπ'
    have hπι_let : πℤ ≫ ιℤ = 𝟙 (P_pull.obj Fℤ₀) := hπι
    have hπℤ_align : πℤ = η.hom.app Fℤ₀ ≫ πℤ' := by
      dsimp only [πℤ, πℤ']; erw [huℤ_eq]; exact hmate_symm Aℤ uℤ'_ν
    have hπM_align : πM = η.hom.app FM₀ ≫ πM' := by
      dsimp only [πM, πM']; erw [huM_eq]; exact hmate_symm AM uM'_ν
    have hιℤ_align : ιℤ = ιℤ' ≫ η.inv.app Fℤ₀ := by
      calc
        ιℤ = (ιℤ' ≫ πℤ') ≫ ιℤ := by rw [hιπ'_let, Category.id_comp]
        _ = (ιℤ' ≫ η.inv.app Fℤ₀) ≫ (η.hom.app Fℤ₀ ≫ πℤ') ≫ ιℤ := by
          simp only [Category.assoc, Iso.inv_hom_id_app_assoc]
        _ = (ιℤ' ≫ η.inv.app Fℤ₀) ≫ (πℤ ≫ ιℤ) := by rw [← hπℤ_align]
        _ = ιℤ' ≫ η.inv.app Fℤ₀ := by rw [hπι_let, Category.comp_id]
    
    have hp_val : p_ν (weilGysinLocalTorsionCounitH W₀ m U₀ q z₀) =
        ((Abelian.Ext.mk₀ ιℤ').comp
          ((P_pull'.mapExtAddHom Fℤ₀ FM₀ q)
            (z₀.comp (Abelian.Ext.mk₀ (weilGysinLocalTorsionCounit W₀ m U₀)) (Nat.add_zero q)))
          (Nat.zero_add q)).comp (Abelian.Ext.mk₀ πM') (Nat.add_zero q) :=
      hp_formula (weilGysinLocalTorsionCounitH W₀ m U₀ q z₀)
    rw [hp_val, hz₁]
    dsimp only [weilGysinLocalTorsionCounitH]
    rw [hPostcomp_eq, hPostcomp_eq,
      Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
      hsq_counit_pull, hπM_align, ← Category.assoc, η.hom.naturality, Category.assoc,
      ← Abelian.Ext.mk₀_comp_mk₀, ← Abelian.Ext.comp_assoc_of_third_deg_zero,
      Abelian.Ext.comp_assoc_of_third_deg_zero (Abelian.Ext.mk₀ ιℤ),
      hExt_nat P_pull P_pull' η.hom q Fℤ₀ L₀ z₀,
      hιℤ_align,
      ← Abelian.Ext.comp_assoc _ _ _ (Nat.zero_add 0) (Nat.zero_add q) (Nat.zero_add q),
      Abelian.Ext.mk₀_comp_mk₀, Category.assoc, η.inv_hom_id_app, Category.comp_id,
      Abelian.Ext.comp_assoc_of_third_deg_zero,
      ← Abelian.Ext.mk₀_comp_mk₀,
      ← Abelian.Ext.comp_assoc_of_third_deg_zero,
      Abelian.Ext.comp_assoc_of_third_deg_zero (Abelian.Ext.mk₀ ιℤ')]
    simp only [Functor.mapExtAddHom_apply, Abelian.Ext.mapExactFunctor_comp,
      Abelian.Ext.mapExactFunctor_mk₀]
    rw [← Abelian.Ext.comp_assoc_of_third_deg_zero (Abelian.Ext.mapExactFunctor P_pull' z₀),
      ← Abelian.Ext.comp_assoc_of_third_deg_zero (Abelian.Ext.mk₀ ιℤ')]

theorem weil_gysin_zero_bdry_counit_and_clopen_pullback_calculus (k : Type u) [Field k]
    [IsAlgClosed k] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (_ : IsUnit (ℓ : k))
    (_ : WeilProperModPrimeBaseChangeHolds k ℓ) :
    let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
    (∀ (Γ W₀ : AlgebraicGeometry.Scheme.{u}) (j : Quiver.Hom W₀ Γ)
        (hOpen : AlgebraicGeometry.IsOpenImmersion j)
        (hj_et : AlgebraicGeometry.Etale j),
      let I_Z := weilAltClosedComplIdeal Γ
        (@AlgebraicGeometry.Scheme.Hom.opensRange _ _ j hOpen)
      ∀ (r q₀ q : ℕ), q₀ + 1 = q →
        Subsingleton (weilEtaleTorsionH I_Z.subscheme (ℓ ^ r) q₀) →
        Subsingleton (weilEtaleTorsionH I_Z.subscheme (ℓ ^ r) q) →
        Function.Bijective
          (weilGysinLocalTorsionCounitH Γ (ℓ ^ r) (weilGysinEtaleObj j hj_et) q)) ∧
    (∀ (W₀ P₀ : CategoryTheory.Over S_k)
        [AlgebraicGeometry.IsProper W₀.hom] [AlgebraicGeometry.IsProper P₀.hom]
        (π : Quiver.Hom W₀.left P₀.left),
      CategoryTheory.CategoryStruct.comp π P₀.hom = W₀.hom →
      ∀ (U : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine U]
        (j_W : Quiver.Hom U W₀.left) [AlgebraicGeometry.IsOpenImmersion j_W]
        (u_P : Quiver.Hom U P₀.left) (hu_P : AlgebraicGeometry.Etale u_P),
        CategoryTheory.CategoryStruct.comp j_W π = u_P →
        ∀ (r q : ℕ),
          ∃ e : weilGysinLocalTorsionH P₀.left (ℓ ^ r) (weilGysinEtaleObj u_P hu_P) q ≃+
              weilGysinLocalTorsionH W₀.left (ℓ ^ r) (weilGysinEtaleObj j_W inferInstance) q,
            ∀ (z_P : weilGysinLocalTorsionH P₀.left (ℓ ^ r) (weilGysinEtaleObj u_P hu_P) q)
              (z_W : weilGysinLocalTorsionH W₀.left (ℓ ^ r)
                (weilGysinEtaleObj j_W inferInstance) q),
              WeilGysinIsClopenPullbackOnLocalH π
                (weilGysinEtaleObj j_W inferInstance) (weilGysinEtaleObj u_P hu_P)
                (CategoryTheory.Iso.refl U) (ℓ ^ r) q z_P z_W ↔ e z_P = z_W) ∧
    (∀ (W₁ W₀ P₀ : CategoryTheory.Over S_k)
        [AlgebraicGeometry.IsProper W₁.hom]
        [AlgebraicGeometry.IsProper W₀.hom]
        [AlgebraicGeometry.IsProper P₀.hom]
        (ν : Quiver.Hom W₁.left W₀.left) (π : Quiver.Hom W₀.left P₀.left),
      CategoryTheory.CategoryStruct.comp ν W₀.hom = W₁.hom →
      CategoryTheory.CategoryStruct.comp π P₀.hom = W₀.hom →
      ∀ (U : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine U]
        (j₁ : Quiver.Hom U W₁.left) [AlgebraicGeometry.IsOpenImmersion j₁]
        (j₀ : Quiver.Hom U W₀.left) [AlgebraicGeometry.IsOpenImmersion j₀]
        (u_P : Quiver.Hom U P₀.left) (hu_P : AlgebraicGeometry.Etale u_P),
        CategoryTheory.CategoryStruct.comp j₁ ν = j₀ →
        CategoryTheory.CategoryStruct.comp j₀ π = u_P →
        ∀ (r q : ℕ)
          (z_P : weilGysinLocalTorsionH P₀.left (ℓ ^ r) (weilGysinEtaleObj u_P hu_P) q)
          (z₀ : weilGysinLocalTorsionH W₀.left (ℓ ^ r) (weilGysinEtaleObj j₀ inferInstance) q)
          (z₁ : weilGysinLocalTorsionH W₁.left (ℓ ^ r) (weilGysinEtaleObj j₁ inferInstance) q),
          WeilGysinIsClopenPullbackOnLocalH π
            (weilGysinEtaleObj j₀ inferInstance) (weilGysinEtaleObj u_P hu_P)
            (CategoryTheory.Iso.refl U) (ℓ ^ r) q z_P z₀ →
          WeilGysinIsClopenPullbackOnLocalH ν
            (weilGysinEtaleObj j₁ inferInstance) (weilGysinEtaleObj j₀ inferInstance)
            (CategoryTheory.Iso.refl U) (ℓ ^ r) q z₀ z₁ →
          WeilGysinIsClopenPullbackOnLocalH (CategoryTheory.CategoryStruct.comp ν π)
            (weilGysinEtaleObj j₁ inferInstance) (weilGysinEtaleObj u_P hu_P)
            (CategoryTheory.Iso.refl U) (ℓ ^ r) q z_P z₁) ∧
    ((∀ (S : AlgebraicGeometry.Scheme.{u}) {V₁ V₂ : S.Etale} (v : Quiver.Hom V₁ V₂)
        (m q : ℕ) (z : weilGysinLocalTorsionH S m V₁ q),
        weilGysinLocalTorsionCounitH S m V₂ q (weilEtaleLocalTorsionMapH S m v q z) =
          weilGysinLocalTorsionCounitH S m V₁ q z) ∧
      (∀ (W₀ P₀ : CategoryTheory.Over S_k)
        [AlgebraicGeometry.IsProper W₀.hom] [AlgebraicGeometry.IsProper P₀.hom]
        (π : Quiver.Hom W₀.left P₀.left),
        CategoryTheory.CategoryStruct.comp π P₀.hom = W₀.hom →
        ∀ (U' U : AlgebraicGeometry.Scheme.{u})
          [AlgebraicGeometry.IsAffine U'] [AlgebraicGeometry.IsAffine U]
          (ι : Quiver.Hom U' U) [AlgebraicGeometry.IsOpenImmersion ι]
          (j_W : Quiver.Hom U W₀.left) [AlgebraicGeometry.IsOpenImmersion j_W]
          (j'_W : Quiver.Hom U' W₀.left) [AlgebraicGeometry.IsOpenImmersion j'_W]
          (hj' : CategoryTheory.CategoryStruct.comp ι j_W = j'_W)
          (u_P : Quiver.Hom U P₀.left) (hu_P : AlgebraicGeometry.Etale u_P)
          (u'_P : Quiver.Hom U' P₀.left) (hu'_P : AlgebraicGeometry.Etale u'_P)
          (hu' : CategoryTheory.CategoryStruct.comp ι u_P = u'_P),
          CategoryTheory.CategoryStruct.comp j_W π = u_P →
          let v_W : Quiver.Hom (weilGysinEtaleObj j'_W inferInstance)
              (weilGysinEtaleObj j_W inferInstance) :=
            CategoryTheory.MorphismProperty.Over.homMk ι hj' trivial
          let v_P : Quiver.Hom (weilGysinEtaleObj u'_P hu'_P)
              (weilGysinEtaleObj u_P hu_P) :=
            CategoryTheory.MorphismProperty.Over.homMk ι hu' trivial
          ∀ (r q : ℕ)
            (z'_P : weilGysinLocalTorsionH P₀.left (ℓ ^ r) (weilGysinEtaleObj u'_P hu'_P) q)
            (z'_W : weilGysinLocalTorsionH W₀.left (ℓ ^ r)
              (weilGysinEtaleObj j'_W inferInstance) q),
            WeilGysinIsClopenPullbackOnLocalH π
              (weilGysinEtaleObj j'_W inferInstance) (weilGysinEtaleObj u'_P hu'_P)
              (CategoryTheory.Iso.refl U') (ℓ ^ r) q z'_P z'_W →
            WeilGysinIsClopenPullbackOnLocalH π
              (weilGysinEtaleObj j_W inferInstance) (weilGysinEtaleObj u_P hu_P)
              (CategoryTheory.Iso.refl U) (ℓ ^ r) q
              (weilEtaleLocalTorsionMapH P₀.left (ℓ ^ r) v_P q z'_P)
              (weilEtaleLocalTorsionMapH W₀.left (ℓ ^ r) v_W q z'_W))) ∧
    ((∀ (S : AlgebraicGeometry.Scheme.{u}) (U : S.Etale) (r q : ℕ)
        (z : weilGysinLocalTorsionH S (ℓ ^ (r + 1)) U q),
        weilEtaleTorsionTransition S ℓ r q
          (weilGysinLocalTorsionCounitH S (ℓ ^ (r + 1)) U q z) =
        weilGysinLocalTorsionCounitH S (ℓ ^ r) U q
          (weilEtaleLocalTorsionTransition S ℓ r U q z)) ∧
      (∀ (W₀ P₀ : CategoryTheory.Over S_k)
        [AlgebraicGeometry.IsProper W₀.hom] [AlgebraicGeometry.IsProper P₀.hom]
        (π : Quiver.Hom W₀.left P₀.left),
        CategoryTheory.CategoryStruct.comp π P₀.hom = W₀.hom →
        ∀ (U : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine U]
          (j_W : Quiver.Hom U W₀.left) [AlgebraicGeometry.IsOpenImmersion j_W]
          (u_P : Quiver.Hom U P₀.left) (hu_P : AlgebraicGeometry.Etale u_P),
          CategoryTheory.CategoryStruct.comp j_W π = u_P →
          ∀ (r q : ℕ)
            (z_P : weilGysinLocalTorsionH P₀.left (ℓ ^ (r + 1)) (weilGysinEtaleObj u_P hu_P) q)
            (z_W : weilGysinLocalTorsionH W₀.left (ℓ ^ (r + 1))
              (weilGysinEtaleObj j_W inferInstance) q),
            WeilGysinIsClopenPullbackOnLocalH π
              (weilGysinEtaleObj j_W inferInstance) (weilGysinEtaleObj u_P hu_P)
              (CategoryTheory.Iso.refl U) (ℓ ^ (r + 1)) q z_P z_W →
            WeilGysinIsClopenPullbackOnLocalH π
              (weilGysinEtaleObj j_W inferInstance) (weilGysinEtaleObj u_P hu_P)
              (CategoryTheory.Iso.refl U) (ℓ ^ r) q
              (weilEtaleLocalTorsionTransition P₀.left ℓ r (weilGysinEtaleObj u_P hu_P) q z_P)
              (weilEtaleLocalTorsionTransition W₀.left ℓ r
                (weilGysinEtaleObj j_W inferInstance) q z_W))) ∧
    (∀ (W₀ W'₀ P₀ P'₀ : CategoryTheory.Over S_k)
        [AlgebraicGeometry.IsProper W₀.hom] [AlgebraicGeometry.IsProper W'₀.hom]
        [AlgebraicGeometry.IsProper P₀.hom] [AlgebraicGeometry.IsProper P'₀.hom]
        (π : Quiver.Hom W₀.left P₀.left) (π' : Quiver.Hom W'₀.left P'₀.left)
        (e_W : CategoryTheory.Iso W₀.left W'₀.left)
        (e_P : CategoryTheory.Iso P₀.left P'₀.left),
      CategoryTheory.CategoryStruct.comp π P₀.hom = W₀.hom →
      CategoryTheory.CategoryStruct.comp π' P'₀.hom = W'₀.hom →
      CategoryTheory.CategoryStruct.comp e_W.hom W'₀.hom = W₀.hom →
      CategoryTheory.CategoryStruct.comp e_P.hom P'₀.hom = P₀.hom →
      CategoryTheory.CategoryStruct.comp π e_P.hom =
        CategoryTheory.CategoryStruct.comp e_W.hom π' →
      ∀ (U : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine U]
        (j_W : Quiver.Hom U W₀.left) [AlgebraicGeometry.IsOpenImmersion j_W]
        (j'_W : Quiver.Hom U W'₀.left) [AlgebraicGeometry.IsOpenImmersion j'_W]
        (u_P : Quiver.Hom U P₀.left) (hu_P : AlgebraicGeometry.Etale u_P)
        (u'_P : Quiver.Hom U P'₀.left) (hu'_P : AlgebraicGeometry.Etale u'_P),
        CategoryTheory.CategoryStruct.comp j_W e_W.hom = j'_W →
        CategoryTheory.CategoryStruct.comp j_W π = u_P →
        CategoryTheory.CategoryStruct.comp j'_W π' = u'_P →
        ∀ (r q : ℕ)
          (p_W : weilEtaleTorsionH W₀.left (ℓ ^ r) q →+ weilEtaleTorsionH W'₀.left (ℓ ^ r) q)
          (p_P : weilEtaleTorsionH P₀.left (ℓ ^ r) q →+ weilEtaleTorsionH P'₀.left (ℓ ^ r) q),
          WeilIsTorsionEtalePullback e_W.inv (ℓ ^ r) q p_W →
          WeilIsTorsionEtalePullback e_P.inv (ℓ ^ r) q p_P →
          ∀ (z_P : weilGysinLocalTorsionH P₀.left (ℓ ^ r) (weilGysinEtaleObj u_P hu_P) q)
            (z_W : weilGysinLocalTorsionH W₀.left (ℓ ^ r)
              (weilGysinEtaleObj j_W inferInstance) q),
            WeilGysinIsClopenPullbackOnLocalH π
              (weilGysinEtaleObj j_W inferInstance) (weilGysinEtaleObj u_P hu_P)
              (CategoryTheory.Iso.refl U) (ℓ ^ r) q z_P z_W →
            ∃ (z'_P : weilGysinLocalTorsionH P'₀.left (ℓ ^ r) (weilGysinEtaleObj u'_P hu'_P) q)
              (z'_W : weilGysinLocalTorsionH W'₀.left (ℓ ^ r)
                (weilGysinEtaleObj j'_W inferInstance) q),
              weilGysinLocalTorsionCounitH W'₀.left (ℓ ^ r)
                  (weilGysinEtaleObj j'_W inferInstance) q z'_W =
                p_W (weilGysinLocalTorsionCounitH W₀.left (ℓ ^ r)
                  (weilGysinEtaleObj j_W inferInstance) q z_W) ∧
              WeilGysinIsClopenPullbackOnLocalH π'
                (weilGysinEtaleObj j'_W inferInstance) (weilGysinEtaleObj u'_P hu'_P)
                (CategoryTheory.Iso.refl U) (ℓ ^ r) q z'_P z'_W ∧
              weilGysinLocalTorsionCounitH P'₀.left (ℓ ^ r)
                  (weilGysinEtaleObj u'_P hu'_P) q z'_P =
                p_P (weilGysinLocalTorsionCounitH P₀.left (ℓ ^ r)
                  (weilGysinEtaleObj u_P hu_P) q z_P)) ∧
    (∀ (W₁ W₀ : CategoryTheory.Over S_k)
        [AlgebraicGeometry.IsProper W₁.hom] [AlgebraicGeometry.IsProper W₀.hom]
