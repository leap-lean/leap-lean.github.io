  have hBCNat : ∀ {P₀ E B_base S_base : AlgebraicGeometry.Scheme.{u}}
      (i₀ : P₀ ⟶ E) (f : E ⟶ B_base) (g₀ : P₀ ⟶ S_base) (s₀ : S_base ⟶ B_base)
      (hcomm : i₀ ≫ f = g₀ ≫ s₀),
      let B_f := weilEtaleSitePullback f
      let B_s := weilEtaleSitePullback s₀
      let B_i := weilEtaleSitePullback i₀
      let B_g := weilEtaleSitePullback g₀
      let pf_f := B_f.sheafPushforwardContinuous AddCommGrpCat.{u}
        B_base.smallEtaleTopology E.smallEtaleTopology
      let pb_s := B_s.sheafPullback AddCommGrpCat.{u}
        B_base.smallEtaleTopology S_base.smallEtaleTopology
      let adj_s := B_s.sheafAdjunctionContinuous AddCommGrpCat.{u}
        B_base.smallEtaleTopology S_base.smallEtaleTopology
      let pb_i := B_i.sheafPullback AddCommGrpCat.{u}
        E.smallEtaleTopology P₀.smallEtaleTopology
      let adj_i := B_i.sheafAdjunctionContinuous AddCommGrpCat.{u}
        E.smallEtaleTopology P₀.smallEtaleTopology
      let pf_g := B_g.sheafPushforwardContinuous AddCommGrpCat.{u}
        S_base.smallEtaleTopology P₀.smallEtaleTopology
      let e_fun : (B_f ⋙ B_i) ≅ (B_s ⋙ B_g) :=
        (CategoryTheory.MorphismProperty.Over.pullbackComp i₀ f).symm ≪≫
          CategoryTheory.MorphismProperty.Over.pullbackCongr hcomm ≪≫
          CategoryTheory.MorphismProperty.Over.pullbackComp g₀ s₀
      letI : (B_f ⋙ B_i).IsContinuous B_base.smallEtaleTopology P₀.smallEtaleTopology :=
        CategoryTheory.Functor.isContinuous_comp B_f B_i
          B_base.smallEtaleTopology E.smallEtaleTopology P₀.smallEtaleTopology
      letI : (B_s ⋙ B_g).IsContinuous B_base.smallEtaleTopology P₀.smallEtaleTopology :=
        CategoryTheory.Functor.isContinuous_comp B_s B_g
          B_base.smallEtaleTopology S_base.smallEtaleTopology P₀.smallEtaleTopology
      let e_pf := CategoryTheory.Functor.sheafPushforwardContinuousIso e_fun
        AddCommGrpCat.{u} B_base.smallEtaleTopology P₀.smallEtaleTopology
      let bc₀ : ∀ M : CategoryTheory.Sheaf E.smallEtaleTopology AddCommGrpCat.{u},
          pb_s.obj (pf_f.obj M) ⟶ pf_g.obj (pb_i.obj M) :=
        fun M => (adj_s.homEquiv (pf_f.obj M) (pf_g.obj (pb_i.obj M))).symm
          (pf_f.map (adj_i.unit.app M) ≫ e_pf.hom.app (pb_i.obj M))
      ∀ {M₁ M₂ : CategoryTheory.Sheaf E.smallEtaleTopology AddCommGrpCat.{u}} (φ : M₁ ⟶ M₂),
        pb_s.map (pf_f.map φ) ≫ bc₀ M₂ = bc₀ M₁ ≫ pf_g.map (pb_i.map φ) := by
    intro P₀ E B_base S_base i₀ f g₀ s₀ hcomm B_f B_s B_i B_g pf_f pb_s adj_s pb_i adj_i pf_g
      e_fun e_pf bc₀ M₁ M₂ φ
    let pf_s := B_s.sheafPushforwardContinuous AddCommGrpCat.{u}
      B_base.smallEtaleTopology S_base.smallEtaleTopology
    let pf_i := B_i.sheafPushforwardContinuous AddCommGrpCat.{u}
      E.smallEtaleTopology P₀.smallEtaleTopology
    let e_hom : ∀ (K : CategoryTheory.Sheaf P₀.smallEtaleTopology AddCommGrpCat.{u}),
        pf_f.obj (pf_i.obj K) ⟶ pf_s.obj (pf_g.obj K) :=
      fun K => e_pf.hom.app K
    apply (adj_s.homEquiv (pf_f.obj M₁) (pf_g.obj (pb_i.obj M₂))).injective
    have hNat_unit : φ ≫ adj_i.unit.app M₂ = adj_i.unit.app M₁ ≫ pf_i.map (pb_i.map φ) :=
      adj_i.unit.naturality φ
    have he_nat : pf_f.map (pf_i.map (pb_i.map φ)) ≫ e_hom (pb_i.obj M₂) =
        e_hom (pb_i.obj M₁) ≫ pf_s.map (pf_g.map (pb_i.map φ)) :=
      e_pf.hom.naturality (pb_i.map φ)
    calc
      adj_s.homEquiv (pf_f.obj M₁) (pf_g.obj (pb_i.obj M₂)) (pb_s.map (pf_f.map φ) ≫ bc₀ M₂)
          = pf_f.map φ ≫ adj_s.homEquiv (pf_f.obj M₂) (pf_g.obj (pb_i.obj M₂)) (bc₀ M₂) :=
            adj_s.homEquiv_naturality_left (pf_f.map φ) (bc₀ M₂)
      _ = pf_f.map φ ≫ (pf_f.map (adj_i.unit.app M₂) ≫ e_hom (pb_i.obj M₂)) :=
            congrArg (pf_f.map φ ≫ ·)
              (Equiv.apply_symm_apply
                (adj_s.homEquiv (pf_f.obj M₂) (pf_g.obj (pb_i.obj M₂)))
                (pf_f.map (adj_i.unit.app M₂) ≫ e_hom (pb_i.obj M₂)))
      _ = (pf_f.map φ ≫ pf_f.map (adj_i.unit.app M₂)) ≫ e_hom (pb_i.obj M₂) :=
            (CategoryTheory.Category.assoc _ _ _).symm
      _ = pf_f.map (φ ≫ adj_i.unit.app M₂) ≫ e_hom (pb_i.obj M₂) :=
            congrArg (· ≫ e_hom (pb_i.obj M₂)) (pf_f.map_comp _ _).symm
      _ = pf_f.map (adj_i.unit.app M₁ ≫ pf_i.map (pb_i.map φ)) ≫ e_hom (pb_i.obj M₂) :=
            congrArg (fun k => pf_f.map k ≫ e_hom (pb_i.obj M₂)) hNat_unit
      _ = (pf_f.map (adj_i.unit.app M₁) ≫ pf_f.map (pf_i.map (pb_i.map φ))) ≫
            e_hom (pb_i.obj M₂) :=
            congrArg (· ≫ e_hom (pb_i.obj M₂)) (pf_f.map_comp _ _)
      _ = pf_f.map (adj_i.unit.app M₁) ≫
            (pf_f.map (pf_i.map (pb_i.map φ)) ≫ e_hom (pb_i.obj M₂)) :=
            CategoryTheory.Category.assoc _ _ _
      _ = pf_f.map (adj_i.unit.app M₁) ≫
            (e_hom (pb_i.obj M₁) ≫ pf_s.map (pf_g.map (pb_i.map φ))) :=
            congrArg (pf_f.map (adj_i.unit.app M₁) ≫ ·) he_nat
      _ = (pf_f.map (adj_i.unit.app M₁) ≫ e_hom (pb_i.obj M₁)) ≫
            pf_s.map (pf_g.map (pb_i.map φ)) :=
            (CategoryTheory.Category.assoc _ _ _).symm
      _ = adj_s.homEquiv (pf_f.obj M₁) (pf_g.obj (pb_i.obj M₁)) (bc₀ M₁) ≫
            pf_s.map (pf_g.map (pb_i.map φ)) :=
            congrArg (· ≫ pf_s.map (pf_g.map (pb_i.map φ)))
              (Equiv.apply_symm_apply
                (adj_s.homEquiv (pf_f.obj M₁) (pf_g.obj (pb_i.obj M₁)))
                (pf_f.map (adj_i.unit.app M₁) ≫ e_hom (pb_i.obj M₁))).symm
      _ = adj_s.homEquiv (pf_f.obj M₁) (pf_g.obj (pb_i.obj M₂))
            (bc₀ M₁ ≫ pf_g.map (pb_i.map φ)) :=
            (adj_s.homEquiv_naturality_right (bc₀ M₁) (pf_g.map (pb_i.map φ))).symm

