              AlgebraicGeometry.IsOpenImmersion.lift_fac O_eq.ι δ₂.1 hRange_δ₂
            let W_O : S.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤
              (O_eq.ι ≫ (G_aff.obj d₂).hom) inferInstance
            have hδ_O_xi : δ_O ≫ W_O.hom = ξ :=
              (CategoryTheory.Category.assoc δ_O O_eq.ι _).symm.trans
