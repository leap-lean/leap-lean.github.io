      rw [hd_pb]
      have hf₁ : e₁.hom ≫ G_sub.map p₁ = f₁ ≫ e₃.hom := by
        dsimp [f₁]
        rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, e₃.inv_hom_id,
          CategoryTheory.Category.comp_id]
      have hf₂ : e₂.hom ≫ G_sub.map p₂ = f₂ ≫ e₃.hom := by
        dsimp [f₂]
        rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, e₃.inv_hom_id,
          CategoryTheory.Category.comp_id]
      let φ_hom : CategoryTheory.Limits.pullback f₁ f₂ ⟶
          CategoryTheory.Limits.pullback (G_sub.map p₁) (G_sub.map p₂) :=
        CategoryTheory.Limits.pullback.lift
          (CategoryTheory.Limits.pullback.fst f₁ f₂ ≫ e₁.hom)
          (CategoryTheory.Limits.pullback.snd f₁ f₂ ≫ e₂.hom)
          (by
            rw [CategoryTheory.Category.assoc, hf₁, ← CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc,
              CategoryTheory.Category.assoc (CategoryTheory.Limits.pullback.snd f₁ f₂), hf₂,
              CategoryTheory.Category.assoc])
