      cl_curr
    exact (congrArg (·.comp (CategoryTheory.Abelian.Ext.mk₀ (C_ab_Y.map φ_cast)) (Nat.add_zero q))
        hcl₁).trans
      ((hExtForgetComm (i_push_1.obj One_Z1) (i_push_0.obj One_Z0)
          q_i1 q_i0 cZ_1 τ_succ.val τ_curr.val hqi_red hRed).trans
        hcl₀.symm)

theorem weil_gysin_closed_recollement_and_gysin_comp (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    (∀ {S Z Y : AlgebraicGeometry.Scheme.{u}}
      {s : Quiver.Hom S Z} {i : Quiver.Hom Z Y} {si : Quiver.Hom S Y}
      (hsi : CategoryTheory.CategoryStruct.comp s i = si),
      AlgebraicGeometry.IsClosedImmersion s →
      AlgebraicGeometry.IsClosedImmersion i →
      AlgebraicGeometry.IsClosedImmersion si →
      ∀ {r a b c : ℕ} (hab : a + b = c)
        (τ_Z : WeilGysinSupportClass S Z s (ℓ ^ r) a)
        (τ_Y : WeilGysinSupportClass Z Y i (ℓ ^ r) b),
        ∃! τ_SY : WeilGysinSupportClass S Y si (ℓ ^ r) c,
          WeilGysinSupportGysinComp hsi hab τ_Z τ_Y τ_SY) ∧
    (∀ {S' Z' Y' S Z Y : AlgebraicGeometry.Scheme.{u}}
      {s' : Quiver.Hom S' Z'} {i' : Quiver.Hom Z' Y'} {si' : Quiver.Hom S' Y'}
      {s : Quiver.Hom S Z} {i : Quiver.Hom Z Y} {si : Quiver.Hom S Y}
      (hsi' : CategoryTheory.CategoryStruct.comp s' i' = si')
      (hsi : CategoryTheory.CategoryStruct.comp s i = si)
      (g_S : Quiver.Hom S' S) (g_Z : Quiver.Hom Z' Z) (g : Quiver.Hom Y' Y),
      AlgebraicGeometry.IsClosedImmersion s →
      AlgebraicGeometry.IsClosedImmersion i →
      CategoryTheory.IsPullback i' g_Z g i →
      CategoryTheory.IsPullback s' g_S g_Z s →
      ∀ {r a b c : ℕ} (hab : a + b = c)
        (τ'_Z : WeilGysinSupportClass S' Z' s' (ℓ ^ r) a)
        (τ'_Y : WeilGysinSupportClass Z' Y' i' (ℓ ^ r) b)
        (τ'_SY : WeilGysinSupportClass S' Y' si' (ℓ ^ r) c)
        (τ_Z : WeilGysinSupportClass S Z s (ℓ ^ r) a)
        (τ_Y : WeilGysinSupportClass Z Y i (ℓ ^ r) b)
        (τ_SY : WeilGysinSupportClass S Y si (ℓ ^ r) c),
        WeilGysinSupportGysinComp hsi hab τ_Z τ_Y τ_SY →
        WeilGysinSupportPullback g_Z s' s (ℓ ^ r) a τ'_Z τ_Z →
        WeilGysinSupportPullback g i' i (ℓ ^ r) b τ'_Y τ_Y →
        WeilGysinSupportPullback g si' si (ℓ ^ r) c τ'_SY τ_SY →
        WeilGysinSupportGysinComp hsi' hab τ'_Z τ'_Y τ'_SY) :=
by
  
  have hExtIntertwine : ∀ {𝒞 𝒟 : Type (u + 1)}
      [CategoryTheory.Category.{u + 1, u + 1} 𝒞]
      [CategoryTheory.Category.{u + 1, u + 1} 𝒟]
      [CategoryTheory.Abelian 𝒞] [CategoryTheory.Abelian 𝒟]
      [CategoryTheory.EnoughInjectives 𝒞]
      [CategoryTheory.HasExt.{u} 𝒞] [CategoryTheory.HasExt.{u} 𝒟]
      {F₁ F₂ : 𝒞 ⥤ 𝒟}
      [F₁.Additive] [CategoryTheory.Limits.PreservesFiniteLimits F₁]
      [CategoryTheory.Limits.PreservesFiniteColimits F₁]
      [F₂.Additive] [CategoryTheory.Limits.PreservesFiniteLimits F₂]
      [CategoryTheory.Limits.PreservesFiniteColimits F₂]
      (θ : F₁ ⟶ F₂) (X Y : 𝒞) (n : ℕ) (e : CategoryTheory.Abelian.Ext.{u} X Y n),
      ((F₁.mapExtAddHom X Y n) e).comp (CategoryTheory.Abelian.Ext.mk₀ (θ.app Y))
          (Nat.add_zero n) =
        (CategoryTheory.Abelian.Ext.mk₀ (θ.app X)).comp ((F₂.mapExtAddHom X Y n) e)
          (Nat.zero_add n) :=
    fun {𝒞 𝒟} _ _ _ _ _ _ _ {F₁ F₂} _ _ _ _ _ _ θ X Y n e => by
      induction n generalizing Y with
      | zero =>
        obtain ⟨f, rfl⟩ : ∃ f : X ⟶ Y, CategoryTheory.Abelian.Ext.mk₀ f = e :=
          ⟨CategoryTheory.Abelian.Ext.addEquiv₀ e,
            CategoryTheory.Abelian.Ext.addEquiv₀.symm_apply_apply e⟩
        simp only [CategoryTheory.Functor.mapExtAddHom_apply,
          CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, θ.naturality f]
      | succ m ih =>
        let I : 𝒞 := CategoryTheory.Injective.under Y
        let ι : Y ⟶ I := CategoryTheory.Injective.ι Y
        let S : CategoryTheory.ShortComplex 𝒞 :=
          CategoryTheory.ShortComplex.mk ι (CategoryTheory.Limits.cokernel.π ι)
            (CategoryTheory.Limits.cokernel.condition ι)
        have hS : S.ShortExact :=
          CategoryTheory.ShortComplex.ShortExact.mk (CategoryTheory.ShortComplex.exact_cokernel ι)
        have hI0 : e.comp (CategoryTheory.Abelian.Ext.mk₀ ι) (Nat.add_zero (m + 1)) = 0 :=
          CategoryTheory.Abelian.Ext.eq_zero_of_injective _
        obtain ⟨x₃, rfl⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ X hS e hI0 rfl
        rw [CategoryTheory.Functor.mapExtAddHom_apply,
          CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
          CategoryTheory.Abelian.Ext.mapExactFunctor_extClass,
          CategoryTheory.Functor.mapExtAddHom_apply,
          CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
          CategoryTheory.Abelian.Ext.mapExactFunctor_extClass]
        change (((F₁.mapExtAddHom X S.X₃ m) x₃).comp (hS.map_of_exact F₁).extClass rfl).comp
            (CategoryTheory.Abelian.Ext.mk₀ (θ.app Y)) (Nat.add_zero (m + 1)) =
          (CategoryTheory.Abelian.Ext.mk₀ (θ.app X)).comp
            (((F₂.mapExtAddHom X S.X₃ m) x₃).comp (hS.map_of_exact F₂).extClass rfl)
            (Nat.zero_add (m + 1))
