    cases Subsingleton.elim hCont_π (hc_all π)
    letI : P_pull_π.Additive := hAdd_π
    letI : CategoryTheory.Limits.PreservesFiniteLimits P_pull_π := hLim_π
    letI : CategoryTheory.Limits.PreservesFiniteColimits P_pull_π := hColim_π
    let Fgt_W := AlgebraicGeometry.Scheme.Etale.forget W₀
    let Fgt_W' := AlgebraicGeometry.Scheme.Etale.forget W'₀
    let Fgt_P := AlgebraicGeometry.Scheme.Etale.forget P₀
    let Fgt_P' := AlgebraicGeometry.Scheme.Etale.forget P'₀
    have h_sq : g' ≫ π = π' ≫ i := by
