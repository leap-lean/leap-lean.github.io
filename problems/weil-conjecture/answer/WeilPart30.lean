    intro m R F_fg coextMod
    letI : ∀ A : AddCommGrpCat.{u}, Module R (R →+ ↑A) := instModCoext m
    let extMod : AddCommGrpCat.{u} ⥤ ModuleCat.{u, u} R :=
      { obj := fun A => ModuleCat.of R (TensorProduct ℤ R ↑A)
        map := fun {A B} f => ModuleCat.ofHom
          (LinearMap.baseChange R f.hom.toIntLinearMap)
        map_id := fun A => by
          apply ModuleCat.hom_ext
          apply LinearMap.ext
          intro x
          induction x using TensorProduct.induction_on with
          | zero => simp
          | tmul r a => rfl
          | add x₁ x₂ ih₁ ih₂ => rw [map_add, map_add, ih₁, ih₂]
        map_comp := fun f g => by
          apply ModuleCat.hom_ext
          apply LinearMap.ext
          intro x
          induction x using TensorProduct.induction_on with
          | zero => simp
          | tmul r a => rfl
          | add x₁ x₂ ih₁ ih₂ => rw [map_add, map_add, ih₁, ih₂] }
    let mkExtInv : ∀ {A : AddCommGrpCat.{u}} {M : ModuleCat.{u, u} R},
        (A ⟶ F_fg.obj M) → (extMod.obj A ⟶ M) :=
      fun {A M} g =>
        let g_to_M : ↑A →+ ↑M := g.hom
        let bil : R →ₗ[ℤ] ↑A →ₗ[ℤ] ↑M :=
          LinearMap.mk₂ ℤ (fun (r : R) (a : ↑A) => r • g_to_M a)
            (fun r₁ r₂ a => add_smul r₁ r₂ (g_to_M a))
            (fun z r a => by
              rw [← Int.cast_smul_eq_zsmul R z r,
                ← Int.cast_smul_eq_zsmul R z (r • g_to_M a),
                smul_eq_mul, mul_smul])
            (fun r a₁ a₂ => by
              rw [map_add g_to_M a₁ a₂, smul_add])
            (fun z r a => by
              rw [map_zsmul g_to_M z a,
                ← Int.cast_smul_eq_zsmul R z (g_to_M a),
                ← Int.cast_smul_eq_zsmul R z (r • g_to_M a),
