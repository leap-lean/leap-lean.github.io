      _ = C_open_s.ι ≫ C_ov.hom := congrArg (C_open_s.ι ≫ ·) hfs₂
  obtain ⟨p_idP1, hp_idP1⟩ := hPull_ex (𝟙 P1.left) (ℓ ^ r) 2
  have hp_idP1_eq : p_idP1 = AddMonoidHom.id _ := hPull_id _ _ p_idP1 hp_idP1
  obtain ⟨z''_Cs, hz''_Cs_spec⟩ := hTransportClopen (CategoryTheory.Iso.refl C_s) e_Us
    j_s hj_s_et C_open_s.ι (hEt_of_open C_open_s.ι)
    (he_Us_ι.trans (Category.comp_id j_s).symm) (ℓ ^ r) 2 z'_Cs
  obtain ⟨z''_P1_1, hz''_cl1, hz''_counit1⟩ := hz''_Cs_spec (CategoryTheory.Iso.refl P1.left)
    π_s1 π_s1 (j_s ≫ π_s1) hu_s1 (v_s1 ≫ ι_P1_k) hv_s1_P1_et p_idP1 z'_P1_1
    ((Category.comp_id _).trans (Category.id_comp _).symm) rfl hv_s1_proj hp_idP1 hz'_cl1
  obtain ⟨z''_P1_2, hz''_cl2, hz''_counit2⟩ := hz''_Cs_spec (CategoryTheory.Iso.refl P1.left)
    π_s2 π_s2 (j_s ≫ π_s2) hu_s2 (v_s2 ≫ ι_P1_k) hv_s2_P1_et p_idP1 z'_P1_2
    ((Category.comp_id _).trans (Category.id_comp _).symm) rfl hv_s2_proj hp_idP1 hz'_cl2
  have hCurve_fib := hCurveInv k hℓ ι_P1_k s_inf_k hP1_int hP1_prop hP1_sm hOpen_P1k
    hιP1k_comm hs_inf_k hcompl_P1k C_ov C_open_s hAff_Copens π_s1 π_s2 hfs₁ hfs₂
    v_s1 v_s2 hv_s1_et hv_s2_et hv_s1_struct hv_s2_struct hv_s1_proj hv_s2_proj
    hv_s1_P1_et hv_s2_P1_et r z''_Cs z''_P1_1 z''_P1_2 hz''_cl1 hz''_cl2
  have hRes_eq :
      res_P ((CategoryTheory.Abelian.Ext.mk₀ (pb_s₀.map (θ₁ ≫ δ_BP))).postcomp Fℤ_Sk (Nat.add_zero 0) x) =
      res_P ((CategoryTheory.Abelian.Ext.mk₀ (pb_s₀.map (θ₂ ≫ δ_BP))).postcomp Fℤ_Sk (Nat.add_zero 0) x) := by
    let w₁ := (CategoryTheory.Abelian.Ext.mk₀ (pb_s₀.map θ₁)).postcomp Fℤ_Sk (Nat.add_zero 0) x
    let w₂ := (CategoryTheory.Abelian.Ext.mk₀ (pb_s₀.map θ₂)).postcomp Fℤ_Sk (Nat.add_zero 0) x
    have hw₁_comp : (CategoryTheory.Abelian.Ext.mk₀ (pb_s₀.map (θ₁ ≫ δ_BP))).postcomp Fℤ_Sk (Nat.add_zero 0) x =
        (CategoryTheory.Abelian.Ext.mk₀ (pb_s₀.map δ_BP)).postcomp Fℤ_Sk (Nat.add_zero 0) w₁ := by
      change x.comp (CategoryTheory.Abelian.Ext.mk₀ (pb_s₀.map (θ₁ ≫ δ_BP))) (Nat.add_zero 0) =
        (x.comp (CategoryTheory.Abelian.Ext.mk₀ (pb_s₀.map θ₁)) (Nat.add_zero 0)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (pb_s₀.map δ_BP)) (Nat.add_zero 0)
      rw [CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero 0) (Nat.zero_add 0) (Nat.add_zero 0),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, pb_s₀.map_comp]
    have hw₂_comp : (CategoryTheory.Abelian.Ext.mk₀ (pb_s₀.map (θ₂ ≫ δ_BP))).postcomp Fℤ_Sk (Nat.add_zero 0) x =
        (CategoryTheory.Abelian.Ext.mk₀ (pb_s₀.map δ_BP)).postcomp Fℤ_Sk (Nat.add_zero 0) w₂ := by
      change x.comp (CategoryTheory.Abelian.Ext.mk₀ (pb_s₀.map (θ₂ ≫ δ_BP))) (Nat.add_zero 0) =
        (x.comp (CategoryTheory.Abelian.Ext.mk₀ (pb_s₀.map θ₂)) (Nat.add_zero 0)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (pb_s₀.map δ_BP)) (Nat.add_zero 0)
      rw [CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero 0) (Nat.zero_add 0) (Nat.add_zero 0),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, pb_s₀.map_comp]
    rw [hw₁_comp, hw₂_comp, hRes_spec w₁, hRes_spec w₂]
    have h1 : weilGysinLocalTorsionCounitH P1.left (ℓ ^ r) _ 2 z_P1_1 =
        weilGysinLocalTorsionCounitH P1.left (ℓ ^ r) _ 2 z''_P1_1 := by
      rw [← hz'_counit1, hz''_counit1, hp_idP1_eq]
      rfl
    have h2 : weilGysinLocalTorsionCounitH P1.left (ℓ ^ r) _ 2 z_P1_2 =
        weilGysinLocalTorsionCounitH P1.left (ℓ ^ r) _ 2 z''_P1_2 := by
      rw [← hz'_counit2, hz''_counit2, hp_idP1_eq]
      rfl
    exact heval₁.trans (h1.trans (hCurve_fib.trans (h2.symm.trans heval₂.symm)))
  have hElem_eq :
      (CategoryTheory.Abelian.Ext.mk₀ (pb_s₀.map (θ₁ ≫ δ_BP))).postcomp Fℤ_Sk (Nat.add_zero 0) x =
      (CategoryTheory.Abelian.Ext.mk₀ (pb_s₀.map (θ₂ ≫ δ_BP))).postcomp Fℤ_Sk (Nat.add_zero 0) x :=
    hRes_bij.injective hRes_eq
  have hSum :
      (CategoryTheory.Abelian.Ext.mk₀ (pb_s₀.map δ_diff)).postcomp Fℤ_Sk (Nat.add_zero 0) x +
      (CategoryTheory.Abelian.Ext.mk₀ (pb_s₀.map (θ₂ ≫ δ_BP))).postcomp Fℤ_Sk (Nat.add_zero 0) x =
      0 + (CategoryTheory.Abelian.Ext.mk₀ (pb_s₀.map (θ₂ ≫ δ_BP))).postcomp Fℤ_Sk (Nat.add_zero 0) x := by
    rw [zero_add]
    change x.comp (CategoryTheory.Abelian.Ext.mk₀ (pb_s₀.map δ_diff)) (Nat.add_zero 0) +
        x.comp (CategoryTheory.Abelian.Ext.mk₀ (pb_s₀.map (θ₂ ≫ δ_BP))) (Nat.add_zero 0) =
      (CategoryTheory.Abelian.Ext.mk₀ (pb_s₀.map (θ₂ ≫ δ_BP))).postcomp Fℤ_Sk (Nat.add_zero 0) x
    rw [← CategoryTheory.Abelian.Ext.comp_add, ← CategoryTheory.Abelian.Ext.mk₀_add,
      ← pb_s₀.map_add]
    have h_add_cancel : δ_diff + (θ₂ ≫ δ_BP) = θ₁ ≫ δ_BP := sub_add_cancel _ _
    rw [h_add_cancel]
    exact hElem_eq
  exact add_right_cancel hSum

theorem weil_gysin_etale_chart_polyP1_pushforward (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : IsUnit (ℓ : k))
    (τ : ∀ (c r : ℕ), WeilGysinSupportClass
      (AlgebraicGeometry.Spec (CommRingCat.of k))
      (weilGysinAffineSpace k c) (weilGysinAffineOrigin k c) (ℓ ^ r) (2 * c))
    (hτ : WeilGysinIsAffineOriginThomTower k ℓ τ)
    (hCD_all : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (m n q : ℕ),
      1 ≤ n → IsUnit (n : Ω) →
      ∀ (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
        [AlgebraicGeometry.IsProper Z.hom],
        topologicalKrullDim Z.left ≤ (m : WithBot ℕ∞) →
        2 * m < q →
        Subsingleton (weilEtaleTorsionH Z.left n q))
    (hPBC_all : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω],
      (ℓ : Ω) ≠ 0 → WeilProperModPrimeBaseChangeHolds Ω ℓ)
    (ι_P1 : ∀ (Ω : Type u) [Field Ω],
      Quiver.Hom (weilGysinAffineSpace Ω 1) (weilProjectiveSpaceOver Ω 1).left)
    (s_inf : ∀ (Ω : Type u) [Field Ω],
      Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) (weilProjectiveSpaceOver Ω 1).left)
    (V_zero_compl : ∀ (Ω : Type u) [Field Ω], (weilProjectiveSpaceOver Ω 1).left.Opens)
    (ι_aff : ∀ δ : ℕ,
      Quiver.Hom (weilGysinAffineSpace k δ) (weilGysinPolyP1Over k δ).left)
    (hComp : WeilGysinIsPolyP1Compactification k ι_P1 s_inf V_zero_compl ι_aff)
    (hCurveInv : WeilGysinCurveEtaleCounitInvarianceHolds.{u} ℓ)
    (c : ℕ) (hc : 1 ≤ c)
    (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hIntY : AlgebraicGeometry.IsIntegral Y.left)
    [AlgebraicGeometry.IsProper Y.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension c Y.hom] :
    ∃ E_Y : ∀ (W : Y.left.Opens),
        AlgebraicGeometry.IsAffineOpen W →
        Nonempty ↥W →
        ∀ (u : Quiver.Hom W.toScheme (weilGysinAffineSpace k c)),
          AlgebraicGeometry.Etale u →
          CategoryTheory.CategoryStruct.comp u (weilGysinAffineStruct k c) =
            CategoryTheory.CategoryStruct.comp W.ι Y.hom →
          ∀ r : ℕ,
            weilEtaleTorsionH Y.left (ℓ ^ r) (2 * c) →+
              weilEtaleTorsionH (weilGysinPolyP1Over k c).left (ℓ ^ r) (2 * c),
      (∀ (W' W : Y.left.Opens) (hle : W' ≤ W)
          (hW' : AlgebraicGeometry.IsAffineOpen W') (hNe' : Nonempty ↥W')
          (hW : AlgebraicGeometry.IsAffineOpen W) (hNe : Nonempty ↥W)
          (u : Quiver.Hom W.toScheme (weilGysinAffineSpace k c))
          (hu_et : AlgebraicGeometry.Etale u)
          (hu_comm : CategoryTheory.CategoryStruct.comp u (weilGysinAffineStruct k c) =
            CategoryTheory.CategoryStruct.comp W.ι Y.hom)
          (hu'_et : AlgebraicGeometry.Etale
            (CategoryTheory.CategoryStruct.comp (Y.left.homOfLE hle) u))
          (hu'_comm : CategoryTheory.CategoryStruct.comp
            (CategoryTheory.CategoryStruct.comp (Y.left.homOfLE hle) u)
            (weilGysinAffineStruct k c) =
            CategoryTheory.CategoryStruct.comp W'.ι Y.hom)
          (r : ℕ),
        E_Y W' hW' hNe' (CategoryTheory.CategoryStruct.comp (Y.left.homOfLE hle) u)
          hu'_et hu'_comm r =
        E_Y W hW hNe u hu_et hu_comm r) ∧
      (∀ (W : Y.left.Opens) (hW : AlgebraicGeometry.IsAffineOpen W) (hNe : Nonempty ↥W)
          (u₁ u₂ : Quiver.Hom W.toScheme (weilGysinAffineSpace k c))
          (hu₁_et : AlgebraicGeometry.Etale u₁)
          (hu₁_comm : CategoryTheory.CategoryStruct.comp u₁ (weilGysinAffineStruct k c) =
            CategoryTheory.CategoryStruct.comp W.ι Y.hom)
          (hu₂_et : AlgebraicGeometry.Etale u₂)
          (hu₂_comm : CategoryTheory.CategoryStruct.comp u₂ (weilGysinAffineStruct k c) =
            CategoryTheory.CategoryStruct.comp W.ι Y.hom)
          (i₀ : Fin c),
        (∀ j : Fin c, j ≠ i₀ →
          CategoryTheory.CategoryStruct.comp u₁
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (Polynomial.aeval (R := k) (MvPolynomial.X j : MvPolynomial (Fin c) k)).toRingHom)) =
          CategoryTheory.CategoryStruct.comp u₂
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (Polynomial.aeval (R := k) (MvPolynomial.X j : MvPolynomial (Fin c) k)).toRingHom))) →
        ∀ r : ℕ, E_Y W hW hNe u₁ hu₁_et hu₁_comm r = E_Y W hW hNe u₂ hu₂_et hu₂_comm r) ∧
      (∀ (W : Y.left.Opens) (hW : AlgebraicGeometry.IsAffineOpen W) (hNe : Nonempty ↥W)
          (u : Quiver.Hom W.toScheme (weilGysinAffineSpace k c))
          (hu_et : AlgebraicGeometry.Etale u)
          (hu_comm : CategoryTheory.CategoryStruct.comp u (weilGysinAffineStruct k c) =
            CategoryTheory.CategoryStruct.comp W.ι Y.hom)
          (r : ℕ) (x : weilEtaleTorsionH Y.left (ℓ ^ (r + 1)) (2 * c)),
        weilEtaleTorsionTransition (weilGysinPolyP1Over k c).left ℓ r (2 * c)
          (E_Y W hW hNe u hu_et hu_comm (r + 1) x) =
        E_Y W hW hNe u hu_et hu_comm r
          (weilEtaleTorsionTransition Y.left ℓ r (2 * c) x)) ∧
      (∀ (W : Y.left.Opens) (hW : AlgebraicGeometry.IsAffineOpen W) (hNe : Nonempty ↥W)
          (s : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) Y.left)
          (s_W : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) W.toScheme)
          (u : Quiver.Hom W.toScheme (weilGysinAffineSpace k c))
          (hu_et : AlgebraicGeometry.Etale u)
          (hu_comm : CategoryTheory.CategoryStruct.comp u (weilGysinAffineStruct k c) =
            CategoryTheory.CategoryStruct.comp W.ι Y.hom),
        CategoryTheory.CategoryStruct.comp s Y.hom =
          CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)) →
        WeilGysinIsEtaleOriginChart c Y.hom s W s_W u →
        ∀ (r : ℕ)
          (cl_Y : weilEtaleTorsionH Y.left (ℓ ^ r) (2 * c))
          (cl_Pc : weilEtaleTorsionH (weilGysinPolyP1Over k c).left (ℓ ^ r) (2 * c)),
          WeilGysinIsPointClass (τ c r) Y.left Y.hom s cl_Y →
          WeilGysinIsPointClass (τ c r) (weilGysinPolyP1Over k c).left
            (weilGysinPolyP1Over k c).hom
            (CategoryTheory.CategoryStruct.comp (weilGysinAffineOrigin k c) (ι_aff c)) cl_Pc →
          E_Y W hW hNe u hu_et hu_comm r cl_Y = cl_Pc) :=
by
  classical
  obtain ⟨m, rfl⟩ : ∃ m : ℕ, c = m + 1 := ⟨c - 1, (Nat.sub_add_cancel hc).symm⟩
  let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
  let P1 := weilProjectiveSpaceOver k 1
  let P_c := weilGysinPolyP1Over k (m + 1)
  have hPrime : Nat.Prime ℓ := Fact.out
  have hℓ_ne : (ℓ : k) ≠ 0 := hℓ.ne_zero
  have hPBC_k : WeilProperModPrimeBaseChangeHolds k ℓ := hPBC_all k hℓ_ne
  have hpow_ge : ∀ r : ℕ, 1 ≤ ℓ ^ r := fun r => Nat.one_le_pow r ℓ hPrime.pos
  have hpow_unit : ∀ r : ℕ, IsUnit ((ℓ ^ r : ℕ) : k) := fun r => by
    rw [Nat.cast_pow]
    exact hℓ.pow r
  have hDimY : topologicalKrullDim Y.left = ((m + 1 : ℕ) : WithBot ℕ∞) :=
    weil_smooth_integral_krullDim_over_field k (m + 1) Y hIntY
  obtain ⟨hPull_ex, hPull_id, hPull_comp, hPull_trans, -⟩ :=
    weil_etale_torsion_pullback_functoriality
  have hPull_uniq : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (h : S₁ ⟶ S₂) (n i : ℕ)
      (p₁ p₂ : weilEtaleTorsionH S₂ n i →+ weilEtaleTorsionH S₁ n i),
      WeilIsTorsionEtalePullback h n i p₁ →
      WeilIsTorsionEtalePullback h n i p₂ →
      p₁ = p₂ := by
    intro S₁ S₂ h n i p₁ p₂ hp₁ hp₂
    obtain ⟨p_id, hp_id⟩ := hPull_ex (𝟙 S₁) n i
    have hid : p_id = AddMonoidHom.id _ := hPull_id n i p_id hp_id
    have hp₁' : WeilIsTorsionEtalePullback (𝟙 S₁ ≫ h) n i p₁ := by
      rwa [Category.id_comp]
    have hcomp := hPull_comp (𝟙 S₁) h n i p_id p₂ p₁ hp_id hp₂ hp₁'
    rw [hcomp, hid, AddMonoidHom.id_comp]
  obtain ⟨hZeroBdry, hClopenPBC, hClopenComp, ⟨hMapCounit, hMapClopen⟩,
      ⟨hTransCounit, hTransClopen⟩, hIsoClopen, hCartCounit⟩ :=
    weil_gysin_zero_bdry_counit_and_clopen_pullback_calculus k ℓ hℓ hPBC_k
  obtain ⟨hPc_int, hPc_prop, hPc_sm, hOpen_aff, hι_comm⟩ := hComp.2.1 (m + 1)
  have : AlgebraicGeometry.IsProper P_c.hom := hPc_prop
  have : AlgebraicGeometry.SmoothOfRelativeDimension (m + 1) P_c.hom := hPc_sm
  have : AlgebraicGeometry.IsOpenImmersion (ι_aff (m + 1)) := hOpen_aff
  
  
  
  have hDom : ∀ (W : Y.left.Opens)
      (P₁ P₂ : CategoryTheory.Over S_k)
      (g₁ : W.toScheme ⟶ P₁.left) (g₂ : W.toScheme ⟶ P₂.left)
      (hg₁ : W.ι ≫ Y.hom = g₁ ≫ P₁.hom) (hg₂ : W.ι ≫ Y.hom = g₂ ≫ P₂.hom)
      (q_P : P₁.left ⟶ P₂.left) (hq : q_P ≫ P₂.hom = P₁.hom)
      (hg₁₂ : g₁ ≫ q_P = g₂),
      let γ₁ : W.toScheme ⟶ Limits.pullback Y.hom P₁.hom := Limits.pullback.lift W.ι g₁ hg₁
      let γ₂ : W.toScheme ⟶ Limits.pullback Y.hom P₂.hom := Limits.pullback.lift W.ι g₂ hg₂
      let hM_cond : Limits.pullback.fst Y.hom P₁.hom ≫ Y.hom =
          (Limits.pullback.snd Y.hom P₁.hom ≫ q_P) ≫ P₂.hom :=
        Limits.pullback.condition.trans (by rw [Category.assoc, hq])
      let M : Limits.pullback Y.hom P₁.hom ⟶ Limits.pullback Y.hom P₂.hom :=
        Limits.pullback.lift (Limits.pullback.fst Y.hom P₁.hom)
          (Limits.pullback.snd Y.hom P₁.hom ≫ q_P) hM_cond
      ∃ ν : γ₁.image ⟶ γ₂.image,
        ν ≫ γ₂.imageι = γ₁.imageι ≫ M ∧
        γ₁.toImage ≫ ν = γ₂.toImage := by
    intro W P₁ P₂ g₁ g₂ hg₁ hg₂ q_P hq hg₁₂ γ₁ γ₂ hM_cond M
    have hγM : γ₁ ≫ M = γ₂ := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Limits.pullback.lift_fst, Limits.pullback.lift_fst,
          Limits.pullback.lift_fst]
      · rw [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd_assoc,
          hg₁₂, Limits.pullback.lift_snd]
    have hker : Scheme.Hom.ker γ₂.imageι ≤ Scheme.Hom.ker (γ₁.imageι ≫ M) := by
      apply le_of_eq
      calc
        Scheme.Hom.ker γ₂.imageι = Scheme.Hom.ker γ₂ :=
          Scheme.IdealSheafData.ker_subschemeι (Scheme.Hom.ker γ₂)
        _ = Scheme.Hom.ker (γ₁ ≫ M) := by rw [hγM]
        _ = (Scheme.Hom.ker γ₁).map M := Scheme.Hom.ker_comp γ₁ M
        _ = (Scheme.Hom.ker γ₁.imageι).map M := by
          rw [Scheme.IdealSheafData.ker_subschemeι (Scheme.Hom.ker γ₁)]
        _ = Scheme.Hom.ker (γ₁.imageι ≫ M) := (Scheme.Hom.ker_comp γ₁.imageι M).symm
    let ν : γ₁.image ⟶ γ₂.image := IsClosedImmersion.lift γ₂.imageι (γ₁.imageι ≫ M) hker
    have hν_fac : ν ≫ γ₂.imageι = γ₁.imageι ≫ M :=
      IsClosedImmersion.lift_fac γ₂.imageι (γ₁.imageι ≫ M) hker
    refine ⟨ν, hν_fac, ?_⟩
    rw [← cancel_mono γ₂.imageι, Category.assoc, hν_fac, ← Category.assoc,
      Scheme.Hom.toImage_imageι, hγM, Scheme.Hom.toImage_imageι]
  have hGraphProj : ∀ (W : Y.left.Opens)
      (P₁ P₂ : CategoryTheory.Over S_k)
      (g₁ : W.toScheme ⟶ P₁.left) (g₂ : W.toScheme ⟶ P₂.left)
      (hg₁ : W.ι ≫ Y.hom = g₁ ≫ P₁.hom) (hg₂ : W.ι ≫ Y.hom = g₂ ≫ P₂.hom)
      (q_P : P₁.left ⟶ P₂.left),
      q_P ≫ P₂.hom = P₁.hom →
      g₁ ≫ q_P = g₂ →
      let γ₁ : W.toScheme ⟶ Limits.pullback Y.hom P₁.hom := Limits.pullback.lift W.ι g₁ hg₁
      let γ₂ : W.toScheme ⟶ Limits.pullback Y.hom P₂.hom := Limits.pullback.lift W.ι g₂ hg₂
      ∃ ν : γ₁.image ⟶ γ₂.image,
        γ₁.toImage ≫ ν = γ₂.toImage ∧
        ν ≫ (γ₂.imageι ≫ Limits.pullback.fst Y.hom P₂.hom) =
          γ₁.imageι ≫ Limits.pullback.fst Y.hom P₁.hom ∧
        ν ≫ (γ₂.imageι ≫ Limits.pullback.snd Y.hom P₂.hom) =
          (γ₁.imageι ≫ Limits.pullback.snd Y.hom P₁.hom) ≫ q_P := by
    intro W P₁ P₂ g₁ g₂ hg₁ hg₂ q_P hq hg₁₂ γ₁ γ₂
    obtain ⟨ν, hν_fac, hν_to⟩ := hDom W P₁ P₂ g₁ g₂ hg₁ hg₂ q_P hq hg₁₂
    refine ⟨ν, hν_to, ?_, ?_⟩
    · rw [← Category.assoc, hν_fac, Category.assoc, Limits.pullback.lift_fst]
    · rw [← Category.assoc, hν_fac, Category.assoc, Limits.pullback.lift_snd, ← Category.assoc]
  have hGraphIso : ∀ (W : Y.left.Opens)
      (P₁ P₂ : CategoryTheory.Over S_k)
      (g₁ : W.toScheme ⟶ P₁.left) (g₂ : W.toScheme ⟶ P₂.left)
      (hg₁ : W.ι ≫ Y.hom = g₁ ≫ P₁.hom) (hg₂ : W.ι ≫ Y.hom = g₂ ≫ P₂.hom)
      (eP : P₁.left ≅ P₂.left),
      eP.hom ≫ P₂.hom = P₁.hom →
      g₁ ≫ eP.hom = g₂ →
      let γ₁ : W.toScheme ⟶ Limits.pullback Y.hom P₁.hom := Limits.pullback.lift W.ι g₁ hg₁
      let γ₂ : W.toScheme ⟶ Limits.pullback Y.hom P₂.hom := Limits.pullback.lift W.ι g₂ hg₂
