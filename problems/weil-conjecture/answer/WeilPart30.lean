theorem weil_gysin_etale_shriek_point_support_excision {Z W₀ S : AlgebraicGeometry.Scheme.{u}}
    (h : Quiver.Hom W₀ S) (hh : AlgebraicGeometry.Etale h)
    (s_W : Quiver.Hom Z W₀) [AlgebraicGeometry.IsClosedImmersion s_W]
    (s_S : Quiver.Hom Z S) [AlgebraicGeometry.IsClosedImmersion s_S]
    (_ : CategoryTheory.CategoryStruct.comp s_W h = s_S)
    (_ : CategoryTheory.IsPullback s_W (CategoryTheory.CategoryStruct.id Z) h s_S)
    (m q : ℕ)
    (α_W : WeilGysinAbSupportClass Z W₀ s_W m q) :
    (∃ z_S : weilGysinLocalTorsionH S m (weilGysinEtaleObj h hh) q,
