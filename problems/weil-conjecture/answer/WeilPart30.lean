  have hNatCastSmulEqNsmul : ∀ {R : Type u} [CommRing R] {M : Type u} [AddCommGroup M]
      [Module R M] (n : ℕ) (x : M), (n : R) • x = n • x := by
    intro R _ M _ _ n x
    induction n with
    | zero => rw [Nat.cast_zero, zero_smul, zero_nsmul]
    | succ k ih => rw [Nat.cast_succ, add_smul, one_smul, succ_nsmul, ih]

  have hFreeYonedaComp : ∀ {𝒟 : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} 𝒟]
      {J : CategoryTheory.GrothendieckTopology 𝒟}
      [CategoryTheory.HasWeakSheafify J AddCommGrpCat.{u}]
      {X : 𝒟} {M : AddCommGrpCat.{u}}
      {F G : CategoryTheory.Sheaf J AddCommGrpCat.{u}}
      (φ : CategoryTheory.Sheaf.freeYoneda J X M ⟶ F) (u : F ⟶ G),
      CategoryTheory.Sheaf.freeYonedaHomEquiv (φ ≫ u) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv φ ≫ u.hom.app (Opposite.op X) := by
    intro 𝒟 _ J _ X M F G φ u
    let adj := CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}
    let P := CategoryTheory.Presheaf.freeYoneda X M
    have h1 : (adj.homEquiv P G) (φ ≫ u) = (adj.homEquiv P F) φ ≫ u.hom :=
      adj.homEquiv_naturality_right φ u
    change CategoryTheory.Presheaf.freeYonedaHomEquiv ((adj.homEquiv P G) (φ ≫ u)) =
      CategoryTheory.Presheaf.freeYonedaHomEquiv ((adj.homEquiv P F) φ) ≫
        u.hom.app (Opposite.op X)
    rw [h1]
    dsimp only [CategoryTheory.Presheaf.freeYonedaHomEquiv]
    symm
    apply CategoryTheory.Category.assoc

  have hMonoNsmulCoprodAb : ∀ {ι : Type u} (X : ι → AddCommGrpCat.{u}) (N : ℕ),
      (∀ i, CategoryTheory.Mono (N • 𝟙 (X i))) →
      CategoryTheory.Mono (N • 𝟙 (∐ X)) := by
    intro ι X N hX
    have _ : ∀ i, CategoryTheory.Mono (N • 𝟙 (X i)) := hX
    have heq : N • 𝟙 (∐ X) = CategoryTheory.Limits.Sigma.map (fun i => N • 𝟙 (X i)) := by
      apply CategoryTheory.Limits.Sigma.hom_ext
      intro i
      rw [CategoryTheory.Preadditive.comp_nsmul, CategoryTheory.Category.comp_id]
      dsimp [CategoryTheory.Limits.Sigma.map]
      rw [CategoryTheory.Limits.ι_colimMap]
      dsimp
      rw [CategoryTheory.Preadditive.nsmul_comp, CategoryTheory.Category.id_comp]
    rw [heq]
    infer_instance

  have hMonoNsmulCoprod : ∀ {C : Type (u + 1)}
      [CategoryTheory.Category.{u + 1, u + 1} C] [CategoryTheory.Abelian C]
      [CategoryTheory.IsGrothendieckAbelian.{u} C] {ι : Type u} (X : ι → C)
      [CategoryTheory.Limits.HasCoproduct X] (N : ℕ),
      (∀ i, CategoryTheory.Mono (N • 𝟙 (X i))) →
      CategoryTheory.Mono (N • 𝟙 (∐ X)) := by
    intro C _ _ _ ι X _ N hX
    have _ : ∀ i, CategoryTheory.Mono (N • 𝟙 (X i)) := hX
    have heq : N • 𝟙 (∐ X) = CategoryTheory.Limits.Sigma.map (fun i => N • 𝟙 (X i)) := by
      apply CategoryTheory.Limits.Sigma.hom_ext
      intro i
      rw [CategoryTheory.Preadditive.comp_nsmul, CategoryTheory.Category.comp_id]
      dsimp [CategoryTheory.Limits.Sigma.map]
      rw [CategoryTheory.Limits.ι_colimMap]
      dsimp
      rw [CategoryTheory.Preadditive.nsmul_comp, CategoryTheory.Category.id_comp]
    rw [heq]
    infer_instance

  have hAbstractSigmaNsmul : ∀ {C : Type (u + 1)}
      [CategoryTheory.Category.{u + 1, u + 1} C] [CategoryTheory.Abelian C]
      [CategoryTheory.IsGrothendieckAbelian.{u} C] {ι : Type u} (X : ι → C) (N : ℕ),
      (∀ i, CategoryTheory.Mono (N • 𝟙 (X i))) →
      ∃ (S : C) (in_i : ∀ i, X i ⟶ S),
        (∀ {W : C} (f : ∀ i, X i ⟶ W), ∃ d : S ⟶ W, ∀ i, in_i i ≫ d = f i) ∧
        CategoryTheory.Mono (N • 𝟙 S) :=
    fun X N hX =>
      ⟨∐ X, CategoryTheory.Limits.Sigma.ι X,
        fun f => ⟨CategoryTheory.Limits.Sigma.desc f,
          fun i => CategoryTheory.Limits.Sigma.ι_comp_desc f i⟩,
        hMonoNsmulCoprod X N hX⟩

  have hTorsionFreeEpiSheaf : ∀ (Y : AlgebraicGeometry.Scheme.{u}) (N : ℕ) [NeZero N]
      (E_sh : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}),
      ∃ (P_cov : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u})
        (p : P_cov ⟶ E_sh),
        CategoryTheory.Epi p ∧ CategoryTheory.Mono (N • 𝟙 P_cov) := by
    intro Y N _ E_sh
    let J_aff := AlgebraicGeometry.Scheme.AffineEtale.topology Y
    let E_aff := AlgebraicGeometry.Scheme.AffineEtale.sheafEquiv Y AddCommGrpCat.{u}
    have _ : E_aff.functor.Additive := E_aff.functor.additive_of_preserves_binary_products
    let Aℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
    have hMonoAℤ : CategoryTheory.Mono (N • 𝟙 Aℤ) := by
      rw [AddCommGrpCat.mono_iff_injective]
      have h1 : ∀ (m : ℕ) (z : Aℤ), ((m • 𝟙 Aℤ) z).down = (m : ℤ) * z.down := by
        intro m z
        induction m with
        | zero => simp
        | succ k ih =>
          rw [succ_nsmul, AddCommGrpCat.hom_add_apply]
          change ((k • 𝟙 Aℤ) z).down + z.down = _
          rw [ih]
          push_cast
          ring
      intro x y hxy
      have hN : (N : ℤ) ≠ 0 := Nat.cast_ne_zero.mpr (NeZero.ne N)
      exact ULift.ext _ _ (mul_left_cancel₀ hN
        ((h1 N x).symm.trans ((congrArg ULift.down hxy).trans (h1 N y))))
    let eqvSm := CategoryTheory.equivSmallModel.{u} Y.AffineEtale
    let E_aff_sh : CategoryTheory.Sheaf J_aff AddCommGrpCat.{u} := E_aff.inverse.obj E_sh
    let idx : Type u :=
      Σ s : CategoryTheory.SmallModel.{u} Y.AffineEtale,
        ↥(E_aff_sh.obj.obj (Opposite.op (eqvSm.inverse.obj s)))
    let fam_aff : idx → CategoryTheory.Sheaf J_aff AddCommGrpCat.{u} :=
      fun q => CategoryTheory.Sheaf.freeYoneda J_aff (eqvSm.inverse.obj q.1) Aℤ
    have hMonoFam : ∀ q : idx, CategoryTheory.Mono (N • 𝟙 (fam_aff q)) := by
      intro q
      let W := eqvSm.inverse.obj q.1
      let P_pre := CategoryTheory.Presheaf.freeYoneda W Aℤ
      have hMonoApp : ∀ V : Y.AffineEtaleᵒᵖ, CategoryTheory.Mono ((N • 𝟙 P_pre).app V) := by
        intro V
        change CategoryTheory.Mono (N • 𝟙 (∐ fun _ : V.unop ⟶ W => Aℤ))
        exact hMonoNsmulCoprodAb
          (fun _ : V.unop ⟶ W => Aℤ) N (fun _ => hMonoAℤ)
      have hMonoPre : CategoryTheory.Mono (N • 𝟙 P_pre) :=
        @CategoryTheory.NatTrans.mono_of_mono_app _ _ _ _ _ _ _ hMonoApp
      let L_sh := CategoryTheory.presheafToSheaf J_aff AddCommGrpCat.{u}
      change CategoryTheory.Mono (N • 𝟙 (L_sh.obj P_pre))
      have heq1 : N • 𝟙 (L_sh.obj P_pre) = L_sh.map (N • 𝟙 P_pre) := by
        rw [L_sh.map_nsmul, L_sh.map_id]
      rw [heq1]
      exact L_sh.map_mono (N • 𝟙 P_pre)
    obtain ⟨P_aff, _, hP_desc, hMonoP_aff⟩ := hAbstractSigmaNsmul fam_aff N hMonoFam
    let α_of : ∀ q : idx, Aℤ ⟶ E_aff_sh.obj.obj (Opposite.op (eqvSm.inverse.obj q.1)) :=
      fun q => AddCommGrpCat.ofHom
        { toFun := fun z => z.down • q.2
          map_zero' := zero_zsmul q.2
          map_add' := fun a b => add_zsmul q.2 a.down b.down }
    let φ_q : ∀ q : idx, fam_aff q ⟶ E_aff_sh := fun q =>
      CategoryTheory.Sheaf.freeYonedaHomEquiv.symm (α_of q)
    obtain ⟨p_aff, hp_aff⟩ := hP_desc φ_q
    have hEpi_aff : CategoryTheory.Epi p_aff := by
      refine ⟨fun {H_aff} u₁ u₂ hu => ?_⟩
      apply CategoryTheory.Sheaf.hom_ext
      apply CategoryTheory.NatTrans.ext
      funext U_op
      let U := U_op.unop
      apply AddCommGrpCat.ext
      intro x
      let s₀ : CategoryTheory.SmallModel.{u} Y.AffineEtale := eqvSm.functor.obj U
      let isoU : U ≅ eqvSm.inverse.obj s₀ := eqvSm.unitIso.app U
      let x' : ↥(E_aff_sh.obj.obj (Opposite.op (eqvSm.inverse.obj s₀))) :=
        (E_aff_sh.obj.map isoU.inv.op).hom x
      let q₀ : idx := ⟨s₀, x'⟩
      have hq₀ : φ_q q₀ ≫ u₁ = φ_q q₀ ≫ u₂ := by
        rw [← hp_aff q₀, CategoryTheory.Category.assoc, hu, CategoryTheory.Category.assoc]
      have h_ev := congrArg (fun (k : fam_aff q₀ ⟶ H_aff) =>
        (CategoryTheory.Sheaf.freeYonedaHomEquiv k).hom (ULift.up 1)) hq₀
      have h_ev_u : ∀ u : E_aff_sh ⟶ H_aff,
          (CategoryTheory.Sheaf.freeYonedaHomEquiv (φ_q q₀ ≫ u)).hom (ULift.up 1) =
            (u.hom.app (Opposite.op (eqvSm.inverse.obj s₀))).hom x' := by
        intro u
        have h1 := hFreeYonedaComp (φ_q q₀) u
        have h2 : CategoryTheory.Sheaf.freeYonedaHomEquiv (φ_q q₀) = α_of q₀ :=
          CategoryTheory.Sheaf.freeYonedaHomEquiv.apply_symm_apply (α_of q₀)
        have h3 : CategoryTheory.Sheaf.freeYonedaHomEquiv (φ_q q₀ ≫ u) =
            α_of q₀ ≫ u.hom.app (Opposite.op (eqvSm.inverse.obj s₀)) :=
          h1.trans (congrArg (· ≫ u.hom.app _) h2)
        exact (congrArg
          (fun (m : Aℤ ⟶ H_aff.obj.obj (Opposite.op (eqvSm.inverse.obj s₀))) =>
            m.hom (ULift.up 1)) h3).trans
          (by
            change (u.hom.app _).hom ((1 : ℤ) • x') = _
            rw [one_zsmul])
      rw [h_ev_u u₁, h_ev_u u₂] at h_ev
      have h_iso := congrArg (H_aff.obj.map isoU.hom.op).hom h_ev
      have h_comm : ∀ u : E_aff_sh ⟶ H_aff,
          (H_aff.obj.map isoU.hom.op).hom
              ((u.hom.app (Opposite.op (eqvSm.inverse.obj s₀))).hom x') =
            (u.hom.app (Opposite.op U)).hom x := by
        intro u
        dsimp only [x']
        rw [← AddCommGrpCat.comp_apply, ← u.hom.naturality isoU.hom.op]
        change ((E_aff_sh.obj.map isoU.inv.op ≫ E_aff_sh.obj.map isoU.hom.op) ≫
          u.hom.app (Opposite.op U)).hom x = _
        rw [← E_aff_sh.obj.map_comp, ← CategoryTheory.op_comp, CategoryTheory.Iso.hom_inv_id,
          CategoryTheory.op_id, E_aff_sh.obj.map_id, CategoryTheory.Category.id_comp]
      exact (h_comm u₁).symm.trans (h_iso.trans (h_comm u₂))
    let P_cov := E_aff.functor.obj P_aff
    let p : P_cov ⟶ E_sh := E_aff.functor.map p_aff ≫ E_aff.counitIso.hom.app E_sh
    have _ : CategoryTheory.Epi p_aff := hEpi_aff
    have _ : CategoryTheory.Epi (E_aff.functor.map p_aff) := inferInstance
    refine ⟨P_cov, p, CategoryTheory.epi_comp _ _, ?_⟩
    have heqP : N • 𝟙 P_cov = E_aff.functor.map (N • 𝟙 P_aff) := by
      rw [E_aff.functor.map_nsmul, E_aff.functor.map_id]
    rw [heqP]
    exact E_aff.functor.map_mono _

  have hExistsShortExactExt1 : ∀ {C : Type (u + 1)}
      [CategoryTheory.Category.{u + 1, u + 1} C] [CategoryTheory.Abelian C]
      [CategoryTheory.EnoughInjectives C] [CategoryTheory.HasExt.{u} C]
      {G A : C} (e : CategoryTheory.Abelian.Ext.{u} G A 1),
      ∃ (E : C) (f : A ⟶ E) (g : E ⟶ G) (hfg : f ≫ g = 0)
        (hS : (CategoryTheory.ShortComplex.mk f g hfg).ShortExact),
        e = hS.extClass := by
    intro C _ _ _ _ G A e
    let J : C := CategoryTheory.Injective.under A
    let ι : A ⟶ J := CategoryTheory.Injective.ι A
    let p : J ⟶ CategoryTheory.Limits.cokernel ι := CategoryTheory.Limits.cokernel.π ι
    let S₀ : CategoryTheory.ShortComplex C :=
      CategoryTheory.ShortComplex.mk ι p (CategoryTheory.Limits.cokernel.condition ι)
    have hS₀ : S₀.ShortExact :=
      CategoryTheory.ShortComplex.ShortExact.mk (CategoryTheory.ShortComplex.exact_cokernel ι)
    have he0 : e.comp (CategoryTheory.Abelian.Ext.mk₀ ι) (Nat.add_zero 1) = 0 :=
      CategoryTheory.Abelian.Ext.eq_zero_of_injective _
    obtain ⟨x₀, hx₀⟩ :=
      CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ G hS₀ e he0 (Nat.zero_add 1)
    let φ : G ⟶ CategoryTheory.Limits.cokernel ι := CategoryTheory.Abelian.Ext.addEquiv₀ x₀
    have hx₀_eq : x₀ = CategoryTheory.Abelian.Ext.mk₀ φ :=
      (CategoryTheory.Abelian.Ext.addEquiv₀.symm_apply_apply x₀).symm
    let E : C := CategoryTheory.Limits.pullback p φ
    let g : E ⟶ G := CategoryTheory.Limits.pullback.snd p φ
    let f : A ⟶ E := CategoryTheory.Limits.pullback.lift ι 0
      ((CategoryTheory.Limits.cokernel.condition ι).trans CategoryTheory.Limits.zero_comp.symm)
    have hfg : f ≫ g = 0 := CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hf_fst : f ≫ CategoryTheory.Limits.pullback.fst p φ = ι :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hzero_k : ∀ {W : C} (k : W ⟶ E), k ≫ g = 0 →
        (k ≫ CategoryTheory.Limits.pullback.fst p φ) ≫ S₀.g = 0 := by
      intro W k hk
      change (k ≫ CategoryTheory.Limits.pullback.fst p φ) ≫ p = 0
      rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
        ← CategoryTheory.Category.assoc, hk, CategoryTheory.Limits.zero_comp]
    have hf_ker : CategoryTheory.Limits.IsLimit (CategoryTheory.Limits.KernelFork.ofι f hfg) :=
      CategoryTheory.Limits.KernelFork.IsLimit.ofι f hfg
        (fun {W} k hk => hS₀.fIsKernel.lift
          (CategoryTheory.Limits.KernelFork.ofι
            (k ≫ CategoryTheory.Limits.pullback.fst p φ) (hzero_k k hk)))
        (fun {W} k hk => by
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [CategoryTheory.Category.assoc, hf_fst]
            exact hS₀.fIsKernel.fac
              (CategoryTheory.Limits.KernelFork.ofι
                (k ≫ CategoryTheory.Limits.pullback.fst p φ) (hzero_k k hk))
              CategoryTheory.Limits.WalkingParallelPair.zero
          · rw [CategoryTheory.Category.assoc, hfg, CategoryTheory.Limits.comp_zero, hk])
        (fun {W} k hk m hm => by
          apply (CategoryTheory.cancel_mono ι).mp
          have hfac : hS₀.fIsKernel.lift
              (CategoryTheory.Limits.KernelFork.ofι
                (k ≫ CategoryTheory.Limits.pullback.fst p φ) (hzero_k k hk)) ≫ ι =
              k ≫ CategoryTheory.Limits.pullback.fst p φ :=
            hS₀.fIsKernel.fac
              (CategoryTheory.Limits.KernelFork.ofι
                (k ≫ CategoryTheory.Limits.pullback.fst p φ) (hzero_k k hk))
              CategoryTheory.Limits.WalkingParallelPair.zero
          rw [hfac, ← hm, CategoryTheory.Category.assoc, hf_fst])
    have _ : CategoryTheory.Mono f := CategoryTheory.mono_of_mono_fac hf_fst
    have _ : CategoryTheory.Epi g := CategoryTheory.Abelian.epi_pullback_of_epi_f p φ
    have hS₁ : (CategoryTheory.ShortComplex.mk f g hfg).ShortExact :=
      { exact := CategoryTheory.ShortComplex.exact_of_f_is_kernel _ hf_ker }
    let mor : CategoryTheory.ShortComplex.mk f g hfg ⟶ S₀ :=
      { τ₁ := 𝟙 A
        τ₂ := CategoryTheory.Limits.pullback.fst p φ
        τ₃ := φ
        comm₁₂ := (CategoryTheory.Category.id_comp ι).trans hf_fst.symm
        comm₂₃ := CategoryTheory.Limits.pullback.condition }
    have hnat := CategoryTheory.ShortComplex.ShortExact.extClass_naturality hS₁ hS₀ mor
    change hS₁.extClass.comp (CategoryTheory.Abelian.Ext.mk₀ (𝟙 A)) (Nat.add_zero 1) =
      (CategoryTheory.Abelian.Ext.mk₀ φ).comp hS₀.extClass (Nat.zero_add 1) at hnat
    rw [CategoryTheory.Abelian.Ext.comp_mk₀_id] at hnat
    exact ⟨E, f, g, hfg, hS₁, hx₀.symm.trans (by rw [hx₀_eq, ← hnat])⟩

  have hMonoCompCokernelNsmul : ∀ {C : Type (u + 1)}
      [CategoryTheory.Category.{u + 1, u + 1} C] [CategoryTheory.Abelian C]
      {A E G : C} (f : A ⟶ E) (g : E ⟶ G) (hfg : f ≫ g = 0),
      (CategoryTheory.ShortComplex.mk f g hfg).ShortExact →
      ∀ (N : ℕ), N • 𝟙 A = 0 → CategoryTheory.Mono (N • 𝟙 G) →
      CategoryTheory.Mono (f ≫ CategoryTheory.Limits.cokernel.π (N • 𝟙 E)) := by
    intro C _ _ A E G f g hfg hS N hA hG
    letI := @CategoryTheory.Abelian.Pseudoelement.homToFun C _ _
    letI := @CategoryTheory.Abelian.Pseudoelement.objectToSort C _ _
    letI := @CategoryTheory.Abelian.Pseudoelement.hasZero C _ _
    have _ : CategoryTheory.Mono f := hS.mono_f
    apply CategoryTheory.Abelian.Pseudoelement.mono_of_zero_of_map_zero
    intro a ha
    rw [CategoryTheory.Abelian.Pseudoelement.comp_apply] at ha
    have hex_cok := CategoryTheory.Abelian.Pseudoelement.pseudo_exact_of_exact
      (CategoryTheory.ShortComplex.exact_cokernel (N • 𝟙 E))
    obtain ⟨y, hy⟩ := hex_cok (f a) ha
    have hgy : (N • 𝟙 G) (g y) = 0 := by
      have hcomm : (N • 𝟙 E) ≫ g = g ≫ (N • 𝟙 G) := by
        rw [CategoryTheory.Preadditive.nsmul_comp, CategoryTheory.Category.id_comp,
          CategoryTheory.Preadditive.comp_nsmul, CategoryTheory.Category.comp_id]
      calc
        (N • 𝟙 G) (g y) = (g ≫ (N • 𝟙 G)) y :=
          (CategoryTheory.Abelian.Pseudoelement.comp_apply _ _ _).symm
        _ = ((N • 𝟙 E) ≫ g) y := by rw [hcomm]
        _ = g ((N • 𝟙 E) y) := CategoryTheory.Abelian.Pseudoelement.comp_apply _ _ _
        _ = g (f a) := by rw [hy]
        _ = (f ≫ g) a := (CategoryTheory.Abelian.Pseudoelement.comp_apply _ _ _).symm
        _ = 0 := by rw [hfg, CategoryTheory.Abelian.Pseudoelement.zero_apply]
    have hy0 : g y = 0 := CategoryTheory.Abelian.Pseudoelement.zero_of_map_zero _
      (CategoryTheory.Abelian.Pseudoelement.pseudo_injective_of_mono (N • 𝟙 G)) _ hgy
    obtain ⟨a', ha'⟩ :=
      (CategoryTheory.Abelian.Pseudoelement.pseudo_exact_of_exact hS.exact) y hy0
    have hfa0 : f a = 0 := by
      have hcommA : f ≫ (N • 𝟙 E) = (N • 𝟙 A) ≫ f := by
        rw [CategoryTheory.Preadditive.comp_nsmul, CategoryTheory.Category.comp_id,
          CategoryTheory.Preadditive.nsmul_comp, CategoryTheory.Category.id_comp]
      calc
        f a = (N • 𝟙 E) y := hy.symm
        _ = (N • 𝟙 E) (f a') := by rw [← ha']
        _ = (f ≫ (N • 𝟙 E)) a' :=
          (CategoryTheory.Abelian.Pseudoelement.comp_apply _ _ _).symm
        _ = ((N • 𝟙 A) ≫ f) a' := by rw [hcommA]
        _ = (0 ≫ f) a' := by rw [hA]
        _ = 0 := by rw [CategoryTheory.Limits.zero_comp,
          CategoryTheory.Abelian.Pseudoelement.zero_apply]
    exact CategoryTheory.Abelian.Pseudoelement.zero_of_map_zero _
      (CategoryTheory.Abelian.Pseudoelement.pseudo_injective_of_mono f) _ hfa0

  have hEffaceLeft : ∀ (Y : AlgebraicGeometry.Scheme.{u}) (N : ℕ) [NeZero N] (n : ℕ)
      {X_sh Y_sh : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}}
      (e : CategoryTheory.Abelian.Ext.{u} X_sh Y_sh (n + 1)),
      ∃ (P_cov : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u})
        (p : P_cov ⟶ X_sh),
        CategoryTheory.Epi p ∧ CategoryTheory.Mono (N • 𝟙 P_cov) ∧
        (CategoryTheory.Abelian.Ext.mk₀ p).comp e (Nat.zero_add (n + 1)) = 0 := by
    intro Y N _ n
    induction n with
    | zero =>
      intro X_sh Y_sh e
      obtain ⟨E, f, g, hfg, hS, rfl⟩ := hExistsShortExactExt1 e
      have _ : CategoryTheory.Epi g := hS.epi_g
      obtain ⟨P_cov, q_E, hEpi_q, hMono_P⟩ := hTorsionFreeEpiSheaf Y N E
      refine ⟨P_cov, q_E ≫ g, CategoryTheory.epi_comp _ _, hMono_P, ?_⟩
      rw [← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ q_E g,
        CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.zero_add 0) (Nat.zero_add 1) (by omega),
        hS.comp_extClass, CategoryTheory.Abelian.Ext.comp_zero]
    | succ m ih =>
      intro X_sh Y_sh e
      let J_inj := CategoryTheory.Injective.under Y_sh
      let ι := CategoryTheory.Injective.ι Y_sh
      let S₀ := CategoryTheory.ShortComplex.mk ι (CategoryTheory.Limits.cokernel.π ι)
        (CategoryTheory.Limits.cokernel.condition ι)
      have hS₀ : S₀.ShortExact :=
        CategoryTheory.ShortComplex.ShortExact.mk (CategoryTheory.ShortComplex.exact_cokernel ι)
      have he0 : e.comp (CategoryTheory.Abelian.Ext.mk₀ ι) (Nat.add_zero (m + 2)) = 0 :=
        CategoryTheory.Abelian.Ext.eq_zero_of_injective _
      obtain ⟨e', rfl⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ X_sh hS₀ e he0
          (rfl : (m + 1) + 1 = m + 2)
      obtain ⟨P_cov, p, hEpi_p, hMono_P, hp0⟩ := ih e'
      refine ⟨P_cov, p, hEpi_p, hMono_P, ?_⟩
      rw [← CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.zero_add (m + 1))
        (rfl : (m + 1) + 1 = m + 2) (Nat.zero_add (m + 2)), hp0,
        CategoryTheory.Abelian.Ext.zero_comp]

  have hAbstractDimShift : ∀ {𝒞 𝒟 : Type (u + 1)}
      [CategoryTheory.Category.{u + 1, u + 1} 𝒞]
      [CategoryTheory.Category.{u + 1, u + 1} 𝒟]
      [CategoryTheory.Abelian 𝒞] [CategoryTheory.Abelian 𝒟]
      [CategoryTheory.EnoughInjectives 𝒞]
      [CategoryTheory.HasExt.{u} 𝒞] [CategoryTheory.HasExt.{u} 𝒟]
      (U : 𝒞 ⥤ 𝒟)
      [U.Additive] [CategoryTheory.Limits.PreservesFiniteLimits U]
      [CategoryTheory.Limits.PreservesFiniteColimits U]
      (X_mod : 𝒞) (X_ab : 𝒟) (ζ : X_ab ⟶ U.obj X_mod),
      (∀ ℱ : 𝒞, Function.Bijective (fun ψ : X_mod ⟶ ℱ => ζ ≫ U.map ψ)) →
      (∀ (m : ℕ) (ℐ : 𝒞) [CategoryTheory.Injective ℐ]
        (e : CategoryTheory.Abelian.Ext.{u} X_ab (U.obj ℐ) (m + 1)), e = 0) →
      ∀ (q : ℕ) (ℱ : 𝒞),
        Function.Bijective
          (fun γ : CategoryTheory.Abelian.Ext.{u} X_mod ℱ q =>
            (CategoryTheory.Abelian.Ext.mk₀ ζ).comp
              ((U.mapExtAddHom X_mod ℱ q) γ) (Nat.zero_add q)) := by
    intro 𝒞 𝒟 _ _ _ _ _ _ _ U _ _ _ X_mod X_ab ζ hBase0 hVanish
    let Θ_hom : ∀ (q : ℕ) (ℱ : 𝒞),
        CategoryTheory.Abelian.Ext.{u} X_mod ℱ q →+
          CategoryTheory.Abelian.Ext.{u} X_ab (U.obj ℱ) q :=
      fun q ℱ =>
        ((CategoryTheory.Abelian.Ext.mk₀ ζ).precomp (U.obj ℱ) (Nat.zero_add q)).comp
