    induction m with
    | zero =>
      obtain ⟨hc_s2, hr_s2, ⟨e_pbc2⟩⟩ := hPBC_sec s₀ hs₀ 2
      obtain rfl : hc_s2 = hc_all s₀ := Subsingleton.elim _ _
      obtain rfl : hr_s2 = hr_all s₀ := Subsingleton.elim _ _
      obtain ⟨eq1⟩ := hIsoH0 e_pbc2
      obtain ⟨eq2⟩ := hSk_H0_equiv P1.left P1.hom (weilEtaleTorsionSheaf P1.left (ℓ ^ 1)) 2
      have hCard1 : Nat.card ((pb_s₀.obj (weilEtaleHigherDirectImage p_bar 2
          (weilEtaleTorsionSheaf P (ℓ ^ 1)))).H 0) = ℓ := by
        rw [Nat.card_congr (eq1.trans eq2).toEquiv]; exact hP1_H2
      exact ⟨Nat.finite_of_card_ne_zero (by rw [hCard1]; exact hℓ_ne),
        hCard1.trans (pow_one ℓ).symm⟩
    | succ m ih =>
      obtain ⟨hFin_m, hCard_m⟩ := ih
      obtain ⟨ι_m, π_m, hzero_m, _, hSE_scheme⟩ := hBock_pkg (m + 1)
      let SC_P := (CategoryTheory.ShortComplex.mk ι_m π_m hzero_m).map C_P
      have hSE_P : SC_P.ShortExact := hSE_scheme P hT_P
      obtain ⟨_, hFlank⟩ := hHDI_pkg SC_P hSE_P
      obtain ⟨u_R2, v_R2, huv_R2, hSE_R2⟩ :=
        hFlank 1 (hInd_B m).2.1 (hRge3_base 3 (by omega))
      let SC_Sk := (CategoryTheory.ShortComplex.mk u_R2 v_R2 huv_R2).map pb_s₀
      have hSE_Sk : SC_Sk.ShortExact := hSE_R2.map_of_exact pb_s₀
      let α_s := (CategoryTheory.Abelian.Ext.mk₀ SC_Sk.f).postcomp Fℤ_Sk (Nat.add_zero 0)
      let β_s := (CategoryTheory.Abelian.Ext.mk₀ SC_Sk.g).postcomp Fℤ_Sk (Nat.add_zero 0)
      have hInj_α : Function.Injective α_s := by
        rw [injective_iff_map_eq_zero]
        intro x hx
        have hEx_mono : (CategoryTheory.ShortComplex.mk (0 : Fℤ_Sk ⟶ SC_Sk.X₁)
            SC_Sk.f CategoryTheory.Limits.zero_comp).Exact :=
          (CategoryTheory.ShortComplex.exact_iff_mono _ rfl).mpr hSE_Sk.mono_f
        obtain ⟨w₀, hw₀⟩ := hSk_exact (0 : Fℤ_Sk ⟶ SC_Sk.X₁) SC_Sk.f
          CategoryTheory.Limits.zero_comp hEx_mono x hx
        rw [← hw₀, CategoryTheory.Abelian.Ext.mk₀_zero, CategoryTheory.Abelian.Ext.comp_zero]
      have hSurj_β : Function.Surjective β_s := by
        intro z
        have hEx_epi : (CategoryTheory.ShortComplex.mk SC_Sk.g
            (0 : SC_Sk.X₃ ⟶ Fℤ_Sk) CategoryTheory.Limits.comp_zero).Exact :=
          (CategoryTheory.ShortComplex.exact_iff_epi _ rfl).mpr hSE_Sk.epi_g
        exact hSk_exact SC_Sk.g (0 : SC_Sk.X₃ ⟶ Fℤ_Sk)
          CategoryTheory.Limits.comp_zero hEx_epi z
          (by rw [CategoryTheory.Abelian.Ext.mk₀_zero, CategoryTheory.Abelian.Ext.comp_zero])
      have hEx_s : ∀ y, β_s y = 0 → ∃ x, α_s x = y :=
        fun y hy => hSk_exact SC_Sk.f SC_Sk.g SC_Sk.zero hSE_Sk.exact y hy
      have hComp_s : ∀ x, β_s (α_s x) = 0 := by
        intro x
        change (x.comp (CategoryTheory.Abelian.Ext.mk₀ SC_Sk.f) (Nat.add_zero 0)).comp
          (CategoryTheory.Abelian.Ext.mk₀ SC_Sk.g) (Nat.add_zero 0) = 0
        rw [CategoryTheory.Abelian.Ext.comp_assoc x _ _ (Nat.add_zero 0) (Nat.add_zero 0) (Nat.add_zero 0),
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, SC_Sk.zero,
          CategoryTheory.Abelian.Ext.mk₀_zero, CategoryTheory.Abelian.Ext.comp_zero]
      obtain ⟨hc_s2, hr_s2, ⟨e_pbc2⟩⟩ := hPBC_sec s₀ hs₀ 2
      obtain rfl : hc_s2 = hc_all s₀ := Subsingleton.elim _ _
      obtain rfl : hr_s2 = hr_all s₀ := Subsingleton.elim _ _
      obtain ⟨eq1⟩ := hIsoH0 e_pbc2
      obtain ⟨eq2⟩ := hSk_H0_equiv P1.left P1.hom (weilEtaleTorsionSheaf P1.left (ℓ ^ 1)) 2
      have hCard1 : Nat.card ((pb_s₀.obj (weilEtaleHigherDirectImage p_bar 2
          (weilEtaleTorsionSheaf P (ℓ ^ 1)))).H 0) = ℓ := by
        rw [Nat.card_congr (eq1.trans eq2).toEquiv]; exact hP1_H2
      have hFin1 : Finite ((pb_s₀.obj (weilEtaleHigherDirectImage p_bar 2
          (weilEtaleTorsionSheaf P (ℓ ^ 1)))).H 0) :=
        Nat.finite_of_card_ne_zero (by rw [hCard1]; exact hℓ_ne)
      obtain ⟨hFin_next, hCard_next⟩ := hCardSE α_s β_s hInj_α hSurj_β hEx_s hComp_s hFin1 hFin_m
      have hCard_next' : Nat.card ((pb_s₀.obj (weilEtaleHigherDirectImage p_bar 2
          (weilEtaleTorsionSheaf P (ℓ ^ (m + 1 + 1))))).H 0) =
        Nat.card ((pb_s₀.obj (weilEtaleHigherDirectImage p_bar 2
          (weilEtaleTorsionSheaf P (ℓ ^ (m + 1))))).H 0) *
        Nat.card ((pb_s₀.obj (weilEtaleHigherDirectImage p_bar 2
          (weilEtaleTorsionSheaf P (ℓ ^ 1)))).H 0) := hCard_next
      refine ⟨hFin_next, ?_⟩
      rw [hCard_next', hCard_m, hCard1, ← pow_succ]

  have hI0_acyc : ∀ p : ℕ, 1 ≤ p →
      CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage p_bar p I0_P) :=
    fun p hp => @hInj_Rvanish P B.left p_bar I0_P hInj0 p hp
  obtain ⟨e_R2_R1⟩ :=
    (hCalc3 (CategoryTheory.ShortComplex.mk j0_P p0_P h0_P) hS0_P hI0_acyc).2.1 1 le_rfl
  obtain ⟨eq_shift⟩ := hIsoH0 (pb_s₀.mapIso e_R2_R1)
  obtain ⟨hFin_R2, hCard_R2⟩ := hR2_card r₀
  have hFin_dom : Finite ((pb_s₀.obj (weilEtaleHigherDirectImage p_bar 1 Q1_P)).H 0) :=
    Finite.of_equiv _ eq_shift.toEquiv
  have hCard_dom : Nat.card ((pb_s₀.obj (weilEtaleHigherDirectImage p_bar 1 Q1_P)).H 0) = ℓ ^ (r₀ + 1) := by
    rw [← Nat.card_congr eq_shift.toEquiv]; exact hCard_R2
  obtain ⟨hFin_cod, hCard_cod⟩ := hP1_H2_card r₀

  
  have _ : (CategoryTheory.Functor.comp (weilEtaleSitePullback p_bar) (weilEtaleSitePullback i_s₀)).IsContinuous
      B.left.smallEtaleTopology P1.left.smallEtaleTopology :=
    CategoryTheory.Functor.isContinuous_comp _ _
      B.left.smallEtaleTopology P.smallEtaleTopology P1.left.smallEtaleTopology
  have _ : (CategoryTheory.Functor.comp (weilEtaleSitePullback s₀) (weilEtaleSitePullback P1.hom)).IsContinuous
      B.left.smallEtaleTopology P1.left.smallEtaleTopology :=
    CategoryTheory.Functor.isContinuous_comp _ _
      B.left.smallEtaleTopology S_k.smallEtaleTopology P1.left.smallEtaleTopology
  let bc₀_gen : ∀ M : CategoryTheory.Sheaf P.smallEtaleTopology AddCommGrpCat.{u},
      pb_s₀.obj (pf_pbar.obj M) ⟶ pf_P1.obj (pb_is₀.obj M) := fun M =>
    (adj_s₀.homEquiv (pf_pbar.obj M) (pf_P1.obj (pb_is₀.obj M))).symm
      (pf_pbar.map (adj_is₀.unit.app M) ≫ e_pf_bot.hom.app (pb_is₀.obj M))
  have hbc_nat : ∀ {M₁ M₂ : CategoryTheory.Sheaf P.smallEtaleTopology AddCommGrpCat.{u}} (φ : M₁ ⟶ M₂),
      pb_s₀.map (pf_pbar.map φ) ≫ bc₀_gen M₂ = bc₀_gen M₁ ≫ pf_P1.map (pb_is₀.map φ) := by
    intro M₁ M₂ φ
    dsimp only [bc₀_gen]
    rw [← adj_s₀.homEquiv_naturality_left_symm, ← adj_s₀.homEquiv_naturality_right_symm]
    congr 1
    have h1 : pf_pbar.map φ ≫ pf_pbar.map (adj_is₀.unit.app M₂) =
        pf_pbar.map (adj_is₀.unit.app M₁) ≫ pf_pbar.map (pf_is₀.map (pb_is₀.map φ)) := by
      have hu : φ ≫ adj_is₀.unit.app M₂ = adj_is₀.unit.app M₁ ≫ pf_is₀.map (pb_is₀.map φ) :=
        adj_is₀.unit.naturality φ
      rw [← pf_pbar.map_comp, hu, pf_pbar.map_comp]
    have h2 : pf_pbar.map (pf_is₀.map (pb_is₀.map φ)) ≫ e_pf_bot.hom.app (pb_is₀.obj M₂) =
        e_pf_bot.hom.app (pb_is₀.obj M₁) ≫ pf_s₀.map (pf_P1.map (pb_is₀.map φ)) :=
      e_pf_bot.hom.naturality (pb_is₀.map φ)
    exact (CategoryTheory.Category.assoc _ _ _).symm.trans
      ((congrArg (· ≫ e_pf_bot.hom.app (pb_is₀.obj M₂)) h1).trans
        ((CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg (pf_pbar.map (adj_is₀.unit.app M₁) ≫ ·) h2).trans
            (CategoryTheory.Category.assoc _ _ _).symm)))
  let leray₀ : ∀ N : CategoryTheory.Sheaf P1.left.smallEtaleTopology AddCommGrpCat.{u},
      (pf_P1.obj N).H 0 →+ N.H 0 := fun N =>
    ((CategoryTheory.Abelian.Ext.mk₀ (adj_P1.counit.app N)).postcomp Fℤ_P1 (Nat.add_zero 0)).comp
      (((CategoryTheory.Abelian.Ext.mk₀ ιℤ_P1).precomp (pb_P1.obj (pf_P1.obj N)) (Nat.zero_add 0)).comp
        (pb_P1.mapExtAddHom Fℤ_Sk (pf_P1.obj N) 0))
  have hleray_mk₀ : ∀ (N : CategoryTheory.Sheaf P1.left.smallEtaleTopology AddCommGrpCat.{u})
      (g : Fℤ_Sk ⟶ pf_P1.obj N),
      leray₀ N (CategoryTheory.Abelian.Ext.mk₀ g) =
        CategoryTheory.Abelian.Ext.mk₀ (ιℤ_P1 ≫ (adj_P1.homEquiv Fℤ_Sk N).symm g) := by
    intro N g
    change ((CategoryTheory.Abelian.Ext.mk₀ ιℤ_P1).comp
        (CategoryTheory.Abelian.Ext.mapExactFunctor pb_P1 (CategoryTheory.Abelian.Ext.mk₀ g))
        (Nat.zero_add 0)).comp
        (CategoryTheory.Abelian.Ext.mk₀ (adj_P1.counit.app N)) (Nat.add_zero 0) = _
    rw [CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀ pb_P1 g,
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
      CategoryTheory.Category.assoc, ← adj_P1.homEquiv_counit Fℤ_Sk N g]
  have hleray_nat : ∀ {N₁ N₂ : CategoryTheory.Sheaf P1.left.smallEtaleTopology AddCommGrpCat.{u}}
      (ψ : N₁ ⟶ N₂) (z : (pf_P1.obj N₁).H 0),
      leray₀ N₂ (z.comp (CategoryTheory.Abelian.Ext.mk₀ (pf_P1.map ψ)) (Nat.add_zero 0)) =
        (leray₀ N₁ z).comp (CategoryTheory.Abelian.Ext.mk₀ ψ) (Nat.add_zero 0) := by
    intro N₁ N₂ ψ z
    have hz := (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply z).symm
    rw [hz, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hleray_mk₀, hleray_mk₀,
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
      adj_P1.homEquiv_naturality_right_symm, CategoryTheory.Category.assoc]

  let πℤ_s₀ := weilEtaleConstPullbackHom s₀ hT_Sk hT_B Aℤ
  let πℤ_is₀ := weilEtaleConstPullbackHom i_s₀ hT_P1 hT_P Aℤ
  let πℤ_P1 := weilEtaleConstPullbackHom P1.hom hT_P1 hT_Sk Aℤ
  have : CategoryTheory.IsIso πℤ_s₀ := hConst_iso s₀ hT_Sk hT_B Aℤ
  have : CategoryTheory.IsIso πℤ_is₀ := hConst_iso i_s₀ hT_P1 hT_P Aℤ
  have : CategoryTheory.IsIso πℤ_P1 := hConst_iso P1.hom hT_P1 hT_Sk Aℤ
  let ιℤ_s₀ : Fℤ_Sk ⟶ pb_s₀.obj Fℤ_B := CategoryTheory.inv πℤ_s₀
  let ιℤ_is₀ : Fℤ_P1 ⟶ pb_is₀.obj Fℤ_P := CategoryTheory.inv πℤ_is₀
  let adj_P1_c := CategoryTheory.constantSheafAdj P1.left.smallEtaleTopology AddCommGrpCat.{u} hT_P1
  let adj_Sk_c := CategoryTheory.constantSheafAdj S_k.smallEtaleTopology AddCommGrpCat.{u} hT_Sk
  let ηℤ_pbar : Fℤ_B ⟶ pf_pbar.obj Fℤ_P := η_of Aℤ
  let g₀ : Fℤ_Sk ⟶ pf_P1.obj (pb_is₀.obj Fℤ_P) := ιℤ_s₀ ≫ pb_s₀.map ηℤ_pbar ≫ bc₀_gen Fℤ_P

  have hMate : ιℤ_P1 ≫ (adj_P1.homEquiv Fℤ_Sk (pb_is₀.obj Fℤ_P)).symm g₀ = ιℤ_is₀ := by
    suffices hmain : (adj_P1.homEquiv Fℤ_Sk (pb_is₀.obj Fℤ_P)).symm g₀ ≫ πℤ_is₀ = πℤ_P1 by
      calc ιℤ_P1 ≫ (adj_P1.homEquiv Fℤ_Sk (pb_is₀.obj Fℤ_P)).symm g₀
          = ιℤ_P1 ≫ (adj_P1.homEquiv Fℤ_Sk (pb_is₀.obj Fℤ_P)).symm g₀ ≫ (πℤ_is₀ ≫ ιℤ_is₀) := by
            rw [CategoryTheory.IsIso.hom_inv_id πℤ_is₀, CategoryTheory.Category.comp_id]
        _ = ιℤ_P1 ≫ (((adj_P1.homEquiv Fℤ_Sk (pb_is₀.obj Fℤ_P)).symm g₀ ≫ πℤ_is₀) ≫ ιℤ_is₀) := by
            rw [CategoryTheory.Category.assoc]
        _ = (ιℤ_P1 ≫ πℤ_P1) ≫ ιℤ_is₀ := by rw [hmain, CategoryTheory.Category.assoc]
        _ = ιℤ_is₀ := by rw [hιℤ_P1, CategoryTheory.Category.id_comp]
    apply (adj_P1.homEquiv Fℤ_Sk Fℤ_P1).injective
    rw [← adj_P1.homEquiv_naturality_right_symm, (adj_P1.homEquiv Fℤ_Sk Fℤ_P1).apply_symm_apply]
    suffices hB : pb_s₀.map ηℤ_pbar ≫ bc₀_gen Fℤ_P ≫ pf_P1.map πℤ_is₀ =
        πℤ_s₀ ≫ (adj_P1.homEquiv Fℤ_Sk Fℤ_P1) πℤ_P1 by
      dsimp only [g₀]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hB,
        ← CategoryTheory.Category.assoc, CategoryTheory.IsIso.inv_hom_id πℤ_s₀,
        CategoryTheory.Category.id_comp]
    apply (adj_s₀.homEquiv Fℤ_B (pf_P1.obj Fℤ_P1)).injective
    rw [adj_s₀.homEquiv_naturality_left, adj_s₀.homEquiv_naturality_right,
      adj_s₀.homEquiv_naturality_right]
    have hbc_ev : adj_s₀.homEquiv (pf_pbar.obj Fℤ_P) (pf_P1.obj (pb_is₀.obj Fℤ_P)) (bc₀_gen Fℤ_P) =
        pf_pbar.map (adj_is₀.unit.app Fℤ_P) ≫ e_pf_bot.hom.app (pb_is₀.obj Fℤ_P) :=
      (adj_s₀.homEquiv _ _).apply_symm_apply _
    have hbot_nat : pf_pbar.map (pf_is₀.map πℤ_is₀) ≫ e_pf_bot.hom.app Fℤ_P1 =
        e_pf_bot.hom.app (pb_is₀.obj Fℤ_P) ≫ pf_s₀.map (pf_P1.map πℤ_is₀) :=
      e_pf_bot.hom.naturality πℤ_is₀
    have hunit_comp : pf_pbar.map (adj_is₀.unit.app Fℤ_P) ≫ pf_pbar.map (pf_is₀.map πℤ_is₀) =
        pf_pbar.map (adj_is₀.homEquiv Fℤ_P Fℤ_P1 πℤ_is₀) :=
      (pf_pbar.map_comp _ _).symm.trans
        (congrArg pf_pbar.map (adj_is₀.homEquiv_unit Fℤ_P Fℤ_P1 πℤ_is₀).symm)
    have h_lhs_mid : adj_s₀.homEquiv (pf_pbar.obj Fℤ_P) (pf_P1.obj (pb_is₀.obj Fℤ_P)) (bc₀_gen Fℤ_P) ≫
        pf_s₀.map (pf_P1.map πℤ_is₀) =
        pf_pbar.map (adj_is₀.homEquiv Fℤ_P Fℤ_P1 πℤ_is₀) ≫ e_pf_bot.hom.app Fℤ_P1 :=
      (congrArg (· ≫ pf_s₀.map (pf_P1.map πℤ_is₀)) hbc_ev).trans
        ((CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg (pf_pbar.map (adj_is₀.unit.app Fℤ_P) ≫ ·) hbot_nat.symm).trans
            ((CategoryTheory.Category.assoc _ _ _).symm.trans
              (congrArg (· ≫ e_pf_bot.hom.app Fℤ_P1) hunit_comp))))
    rw [h_lhs_mid]
    apply (adj_B_c.homEquiv Aℤ (pf_s₀.obj (pf_P1.obj Fℤ_P1))).injective
    let u_is₀ := adj_is₀.homEquiv Fℤ_P Fℤ_P1 πℤ_is₀
    let u_P1 := adj_P1.homEquiv Fℤ_Sk Fℤ_P1 πℤ_P1
    let τ_is₀ := hT_P1.from ((weilEtaleSitePullback i_s₀).obj T_P)
    let τ_P1 := hT_P1.from ((weilEtaleSitePullback P1.hom).obj T_Sk)
    let τ_s₀ := hT_Sk.from ((weilEtaleSitePullback s₀).obj T_B)
    have hL_hom : adj_B_c.homEquiv Aℤ (pf_s₀.obj (pf_P1.obj Fℤ_P1))
        (ηℤ_pbar ≫ (pf_pbar.map u_is₀ ≫ e_pf_bot.hom.app Fℤ_P1)) =
        (adj_P_c.unit.app Aℤ ≫ Fℤ_P.obj.map τ_pbar.op) ≫
          (u_is₀.hom.app (Opposite.op ((weilEtaleSitePullback p_bar).obj T_B)) ≫
            (e_pf_bot.hom.app Fℤ_P1).hom.app (Opposite.op T_B)) :=
      (adj_B_c.homEquiv_naturality_right ηℤ_pbar (pf_pbar.map u_is₀ ≫ e_pf_bot.hom.app Fℤ_P1)).trans
        (congrArg₂ CategoryTheory.CategoryStruct.comp
          ((adj_B_c.homEquiv Aℤ (pf_pbar.obj Fℤ_P)).apply_symm_apply _)
          rfl)
    have hu_s₀_ev : adj_B_c.homEquiv Aℤ (pf_s₀.obj Fℤ_Sk) (adj_s₀.homEquiv Fℤ_B Fℤ_Sk πℤ_s₀) =
        adj_Sk_c.unit.app Aℤ ≫ Fℤ_Sk.obj.map τ_s₀.op := by
      dsimp only [πℤ_s₀, weilEtaleConstPullbackHom]
      rw [(adj_s₀.homEquiv Fℤ_B Fℤ_Sk).apply_symm_apply]
      exact (adj_B_c.homEquiv Aℤ (pf_s₀.obj Fℤ_Sk)).apply_symm_apply _
    have hR_hom : adj_B_c.homEquiv Aℤ (pf_s₀.obj (pf_P1.obj Fℤ_P1))
        (adj_s₀.homEquiv Fℤ_B Fℤ_Sk πℤ_s₀ ≫ pf_s₀.map u_P1) =
        (adj_Sk_c.unit.app Aℤ ≫ Fℤ_Sk.obj.map τ_s₀.op) ≫
          u_P1.hom.app (Opposite.op ((weilEtaleSitePullback s₀).obj T_B)) :=
      (adj_B_c.homEquiv_naturality_right (adj_s₀.homEquiv Fℤ_B Fℤ_Sk πℤ_s₀) (pf_s₀.map u_P1)).trans
        (congrArg (· ≫ u_P1.hom.app (Opposite.op ((weilEtaleSitePullback s₀).obj T_B))) hu_s₀_ev)
    have hu_is₀_ev : adj_P_c.unit.app Aℤ ≫ u_is₀.hom.app (Opposite.op T_P) =
        adj_P1_c.unit.app Aℤ ≫ Fℤ_P1.obj.map τ_is₀.op := by
      dsimp only [u_is₀, πℤ_is₀, weilEtaleConstPullbackHom]
      rw [(adj_is₀.homEquiv Fℤ_P Fℤ_P1).apply_symm_apply]
      exact (adj_P_c.homEquiv Aℤ (pf_is₀.obj Fℤ_P1)).apply_symm_apply _
    have hu_P1_ev : adj_Sk_c.unit.app Aℤ ≫ u_P1.hom.app (Opposite.op T_Sk) =
        adj_P1_c.unit.app Aℤ ≫ Fℤ_P1.obj.map τ_P1.op := by
      dsimp only [u_P1, πℤ_P1, weilEtaleConstPullbackHom]
      rw [(adj_P1.homEquiv Fℤ_Sk Fℤ_P1).apply_symm_apply]
      exact (adj_Sk_c.homEquiv Aℤ (pf_P1.obj Fℤ_P1)).apply_symm_apply _
    have h_nat1 : Fℤ_P.obj.map τ_pbar.op ≫ u_is₀.hom.app (Opposite.op ((weilEtaleSitePullback p_bar).obj T_B)) =
        u_is₀.hom.app (Opposite.op T_P) ≫ (pf_is₀.obj Fℤ_P1).obj.map τ_pbar.op :=
      u_is₀.hom.naturality τ_pbar.op
    have h_nat2 : Fℤ_Sk.obj.map τ_s₀.op ≫ u_P1.hom.app (Opposite.op ((weilEtaleSitePullback s₀).obj T_B)) =
        u_P1.hom.app (Opposite.op T_Sk) ≫ (pf_P1.obj Fℤ_P1).obj.map τ_s₀.op :=
      u_P1.hom.naturality τ_s₀.op
    have h_ebot : (e_pf_bot.hom.app Fℤ_P1).hom.app (Opposite.op T_B) =
        Fℤ_P1.obj.map (e_bot.inv.app T_B).op := rfl
    have hL : (adj_P_c.unit.app Aℤ ≫ Fℤ_P.obj.map τ_pbar.op) ≫
        (u_is₀.hom.app (Opposite.op ((weilEtaleSitePullback p_bar).obj T_B)) ≫
          (e_pf_bot.hom.app Fℤ_P1).hom.app (Opposite.op T_B)) =
        adj_P1_c.unit.app Aℤ ≫ Fℤ_P1.obj.map
          ((e_bot.inv.app T_B ≫ (weilEtaleSitePullback i_s₀).map τ_pbar) ≫ τ_is₀).op := by
      have hL1 : (adj_P_c.unit.app Aℤ ≫ Fℤ_P.obj.map τ_pbar.op) ≫
          (u_is₀.hom.app (Opposite.op ((weilEtaleSitePullback p_bar).obj T_B)) ≫
            Fℤ_P1.obj.map (e_bot.inv.app T_B).op) =
          (adj_P1_c.unit.app Aℤ ≫ Fℤ_P1.obj.map τ_is₀.op) ≫
            (Fℤ_P1.obj.map ((weilEtaleSitePullback i_s₀).map τ_pbar).op ≫
              Fℤ_P1.obj.map (e_bot.inv.app T_B).op) :=
        (CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg (adj_P_c.unit.app Aℤ ≫ ·)
            ((CategoryTheory.Category.assoc _ _ _).symm.trans
              ((congrArg (· ≫ Fℤ_P1.obj.map (e_bot.inv.app T_B).op) h_nat1).trans
                (CategoryTheory.Category.assoc _ _ _)))).trans
            ((CategoryTheory.Category.assoc _ _ _).symm.trans
              (congrArg (· ≫ (Fℤ_P1.obj.map ((weilEtaleSitePullback i_s₀).map τ_pbar).op ≫
                Fℤ_P1.obj.map (e_bot.inv.app T_B).op)) hu_is₀_ev)))
      exact (congrArg (fun k => (adj_P_c.unit.app Aℤ ≫ Fℤ_P.obj.map τ_pbar.op) ≫
          (u_is₀.hom.app (Opposite.op ((weilEtaleSitePullback p_bar).obj T_B)) ≫ k)) h_ebot).trans
        (hL1.trans (by
          rw [CategoryTheory.Category.assoc, ← Fℤ_P1.obj.map_comp, ← Fℤ_P1.obj.map_comp,
            ← op_comp, ← op_comp]))
    have hR : (adj_Sk_c.unit.app Aℤ ≫ Fℤ_Sk.obj.map τ_s₀.op) ≫
        u_P1.hom.app (Opposite.op ((weilEtaleSitePullback s₀).obj T_B)) =
        adj_P1_c.unit.app Aℤ ≫ Fℤ_P1.obj.map
          ((weilEtaleSitePullback P1.hom).map τ_s₀ ≫ τ_P1).op :=
      (CategoryTheory.Category.assoc _ _ _).trans
        ((congrArg (adj_Sk_c.unit.app Aℤ ≫ ·) h_nat2).trans
          ((CategoryTheory.Category.assoc _ _ _).symm.trans
            ((congrArg (· ≫ Fℤ_P1.obj.map ((weilEtaleSitePullback P1.hom).map τ_s₀).op) hu_P1_ev).trans
              (by rw [CategoryTheory.Category.assoc, ← Fℤ_P1.obj.map_comp, ← op_comp]))))
    have hterm : (e_bot.inv.app T_B ≫ (weilEtaleSitePullback i_s₀).map τ_pbar) ≫ τ_is₀ =
        (weilEtaleSitePullback P1.hom).map τ_s₀ ≫ τ_P1 := hT_P1.hom_ext _ _
    exact hL_hom.trans (hL.trans ((by rw [hterm] : _ = _).trans (hR.symm.trans hR_hom.symm)))

  
  let hS0_i := hS0_P.map_of_exact pb_is₀
  let hS1_i := hS1_P.map_of_exact pb_is₀
  let R1_Q1 := weilEtaleHigherDirectImage p_bar 1 Q1_P
  let Φ : (pb_s₀.obj (pf_pbar.obj Q2_P)).H 0 →+ weilEtaleTorsionH P1.left (ℓ ^ (r₀ + 1)) 2 :=
    ((CategoryTheory.Abelian.Ext.mk₀ πM_is₀).postcomp Fℤ_P1 (Nat.add_zero 2)).comp
      ((hS0_i.extClass.postcomp Fℤ_P1 (Nat.one_add 1)).comp
        ((hS1_i.extClass.postcomp Fℤ_P1 (Nat.zero_add 1)).comp
          ((leray₀ (pb_is₀.obj Q2_P)).comp
            ((CategoryTheory.Abelian.Ext.mk₀ bc₀_bot).postcomp Fℤ_Sk (Nat.add_zero 0)))))
  let D_s₀ : (pb_s₀.obj (pf_pbar.obj Q2_P)).H 0 →+ (pb_s₀.obj R1_Q1).H 0 :=
    (CategoryTheory.Abelian.Ext.mk₀ (pb_s₀.map δ_BP)).postcomp Fℤ_Sk (Nat.add_zero 0)
  have hEpi_pbδ : CategoryTheory.Epi (pb_s₀.map δ_BP) := inferInstance
  have hSurj_D : Function.Surjective D_s₀ := by
    intro y
    have hEx_epi : (CategoryTheory.ShortComplex.mk (pb_s₀.map δ_BP)
        (0 : pb_s₀.obj R1_Q1 ⟶ Fℤ_Sk) CategoryTheory.Limits.comp_zero).Exact :=
      (CategoryTheory.ShortComplex.exact_iff_epi _ rfl).mpr hEpi_pbδ
    exact hSk_exact (pb_s₀.map δ_BP) (0 : pb_s₀.obj R1_Q1 ⟶ Fℤ_Sk)
      CategoryTheory.Limits.comp_zero hEx_epi y
      (by rw [CategoryTheory.Abelian.Ext.mk₀_zero, CategoryTheory.Abelian.Ext.comp_zero])
  have hker : D_s₀.ker ≤ Φ.ker := by
    intro w hw
    change D_s₀ w = 0 at hw
    let SC_δ_s := (CategoryTheory.ShortComplex.mk (pf_pbar.map p1_P) δ_BP hδ_comp).map pb_s₀
    have hEx_δ_s : SC_δ_s.Exact := hEx_δ.map pb_s₀
    obtain ⟨u, rfl⟩ := hSk_exact SC_δ_s.f SC_δ_s.g SC_δ_s.zero hEx_δ_s w hw
    change Φ (u.comp (CategoryTheory.Abelian.Ext.mk₀ (pb_s₀.map (pf_pbar.map p1_P))) (Nat.add_zero 0)) = 0
    have hstep_bc : ((u.comp (CategoryTheory.Abelian.Ext.mk₀ (pb_s₀.map (pf_pbar.map p1_P))) (Nat.add_zero 0)).comp
        (CategoryTheory.Abelian.Ext.mk₀ bc₀_bot) (Nat.add_zero 0)) =
        (u.comp (CategoryTheory.Abelian.Ext.mk₀ (bc₀_gen I1_P)) (Nat.add_zero 0)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (pf_P1.map (pb_is₀.map p1_P))) (Nat.add_zero 0) := by
      change ((u.comp (CategoryTheory.Abelian.Ext.mk₀ (pb_s₀.map (pf_pbar.map p1_P))) (Nat.add_zero 0)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (bc₀_gen Q2_P)) (Nat.add_zero 0)) = _
      rw [CategoryTheory.Abelian.Ext.comp_assoc u _ _ (Nat.add_zero 0) (Nat.add_zero 0) (Nat.add_zero 0),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hbc_nat p1_P,
        ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        ← CategoryTheory.Abelian.Ext.comp_assoc u _ _ (Nat.add_zero 0) (Nat.add_zero 0) (Nat.add_zero 0)]
    have hstep_leray : leray₀ (pb_is₀.obj Q2_P)
        ((u.comp (CategoryTheory.Abelian.Ext.mk₀ (pb_s₀.map (pf_pbar.map p1_P))) (Nat.add_zero 0)).comp
          (CategoryTheory.Abelian.Ext.mk₀ bc₀_bot) (Nat.add_zero 0)) =
        (leray₀ (pb_is₀.obj I1_P) (u.comp (CategoryTheory.Abelian.Ext.mk₀ (bc₀_gen I1_P)) (Nat.add_zero 0))).comp
          (CategoryTheory.Abelian.Ext.mk₀ (pb_is₀.map p1_P)) (Nat.add_zero 0) := by
      rw [hstep_bc, hleray_nat (pb_is₀.map p1_P)]
    change (((leray₀ (pb_is₀.obj Q2_P)
        ((u.comp (CategoryTheory.Abelian.Ext.mk₀ (pb_s₀.map (pf_pbar.map p1_P))) (Nat.add_zero 0)).comp
          (CategoryTheory.Abelian.Ext.mk₀ bc₀_bot) (Nat.add_zero 0))).comp
        hS1_i.extClass (Nat.zero_add 1)).comp hS0_i.extClass (Nat.one_add 1)).comp
        (CategoryTheory.Abelian.Ext.mk₀ πM_is₀) (Nat.add_zero 2) = 0
    rw [hstep_leray,
      CategoryTheory.Abelian.Ext.comp_assoc _ (CategoryTheory.Abelian.Ext.mk₀ (pb_is₀.map p1_P))
        hS1_i.extClass (Nat.add_zero 0) (Nat.zero_add 1) (Nat.zero_add 1)]
    have hkill : (CategoryTheory.Abelian.Ext.mk₀ (pb_is₀.map p1_P)).comp hS1_i.extClass (Nat.zero_add 1) = 0 :=
      hS1_i.comp_extClass
    rw [hkill, CategoryTheory.Abelian.Ext.comp_zero,
      CategoryTheory.Abelian.Ext.zero_comp, CategoryTheory.Abelian.Ext.zero_comp]

  let e_quot := QuotientAddGroup.quotientKerEquivOfSurjective D_s₀ hSurj_D
  let res_P : (pb_s₀.obj R1_Q1).H 0 →+ weilEtaleTorsionH P1.left (ℓ ^ (r₀ + 1)) 2 :=
    (QuotientAddGroup.lift D_s₀.ker Φ hker).comp e_quot.symm.toAddMonoidHom
  have hres_spec : ∀ w : (pb_s₀.obj (pf_pbar.obj Q2_P)).H 0, res_P (D_s₀ w) = Φ w := by
    intro w
    have hsymm : e_quot.symm (D_s₀ w) = QuotientAddGroup.mk w :=
      e_quot.symm_apply_eq.mpr rfl
    change QuotientAddGroup.lift D_s₀.ker Φ hker (e_quot.symm (D_s₀ w)) = Φ w
    rw [hsymm]
    rfl

  
  have hSurj_res : Function.Surjective res_P := by
    intro ξ
    let p_is₀ : weilEtaleTorsionH P (ℓ ^ (r₀ + 1)) 2 →+ weilEtaleTorsionH P1.left (ℓ ^ (r₀ + 1)) 2 :=
      ((CategoryTheory.Abelian.Ext.mk₀ πM_is₀).postcomp Fℤ_P1 (Nat.add_zero 2)).comp
        (((CategoryTheory.Abelian.Ext.mk₀ ιℤ_is₀).precomp (pb_is₀.obj F_P_top) (Nat.zero_add 2)).comp
          (pb_is₀.mapExtAddHom Fℤ_P F_P_top 2))
    have hp_is₀ : WeilIsTorsionEtalePullback i_s₀ (ℓ ^ (r₀ + 1)) 2 p_is₀ :=
      ⟨hc_all i_s₀, hr_all i_s₀, (hSitePkg i_s₀).1, (hSitePkg i_s₀).2.2.1, (hSitePkg i_s₀).2.2.2,
        T_P1, hT_P1, T_P, hT_P, ιℤ_is₀, CategoryTheory.IsIso.inv_hom_id πℤ_is₀,
        CategoryTheory.IsIso.hom_inv_id πℤ_is₀, fun _ => rfl⟩
    obtain ⟨p_pr₂, hp_pr₂⟩ := hPullPkg.1 pr₂ (ℓ ^ (r₀ + 1)) 2
    obtain ⟨p_comp_pr, hp_comp_pr⟩ :=
      hPullPkg.1 (CategoryTheory.CategoryStruct.comp i_s₀ pr₂) (ℓ ^ (r₀ + 1)) 2
    have hp_comp_eq : p_comp_pr = p_is₀.comp p_pr₂ :=
      hPullPkg.2.2 i_s₀ pr₂ (ℓ ^ (r₀ + 1)) 2 p_is₀ p_pr₂ p_comp_pr hp_is₀ hp_pr₂ hp_comp_pr
    have hp_idP1 : WeilIsTorsionEtalePullback (CategoryTheory.CategoryStruct.id P1.left)
        (ℓ ^ (r₀ + 1)) 2 p_comp_pr := by
      rw [← his₀_pr]; exact hp_comp_pr
    have hp_idP1_eq : p_comp_pr = AddMonoidHom.id _ :=
      hPullPkg.2.1 (ℓ ^ (r₀ + 1)) 2 p_comp_pr hp_idP1
    have hp_retract_ξ : p_is₀ (p_pr₂ ξ) = ξ :=
      DFunLike.congr_fun (hp_comp_eq.symm.trans hp_idP1_eq) ξ

    let Ξ : F_P_top.H 2 := p_pr₂ ξ
    have _ : CategoryTheory.Injective I0_P := hInj0
    have _ : CategoryTheory.Injective I1_P := hInj1
    have hI0_sub : Subsingleton (CategoryTheory.Abelian.Ext Fℤ_P I0_P 2) :=
      CategoryTheory.Abelian.Ext.subsingleton_of_injective Fℤ_P I0_P 1
    have hΞ_j0 : Ξ.comp (CategoryTheory.Abelian.Ext.mk₀ j0_P) (Nat.add_zero 2) = 0 :=
      Subsingleton.elim _ _
    obtain ⟨y₁, hy₁⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁
      Fℤ_P hS0_P Ξ hΞ_j0 (Nat.one_add 1)
    have hI1_sub : Subsingleton (CategoryTheory.Abelian.Ext Fℤ_P I1_P 1) :=
      CategoryTheory.Abelian.Ext.subsingleton_of_injective Fℤ_P I1_P 0
    have hy₁_j1 : y₁.comp (CategoryTheory.Abelian.Ext.mk₀ j1_P) (Nat.add_zero 1) = 0 :=
      Subsingleton.elim _ _
    obtain ⟨y₀, hy₀⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁
      Fℤ_P hS1_P y₁ hy₁_j1 (Nat.zero_add 1)
    let f_ξ : Fℤ_P ⟶ Q2_P := CategoryTheory.Abelian.Ext.addEquiv₀ y₀
    have hf_ξ_eq : ((CategoryTheory.Abelian.Ext.mk₀ f_ξ).comp hS1_P.extClass (Nat.zero_add 1)).comp
        hS0_P.extClass (Nat.one_add 1) = Ξ := by
      rw [CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply y₀, hy₀, hy₁]
    let w_ξ : (pb_s₀.obj (pf_pbar.obj Q2_P)).H 0 :=
      CategoryTheory.Abelian.Ext.mk₀ (ιℤ_s₀ ≫ pb_s₀.map (ηℤ_pbar ≫ pf_pbar.map f_ξ))
    refine ⟨D_s₀ w_ξ, ?_⟩
    rw [hres_spec w_ξ]
    have hbc_wξ : (CategoryTheory.Abelian.Ext.mk₀ bc₀_bot).postcomp Fℤ_Sk (Nat.add_zero 0) w_ξ =
        (CategoryTheory.Abelian.Ext.mk₀ g₀).comp
          (CategoryTheory.Abelian.Ext.mk₀ (pf_P1.map (pb_is₀.map f_ξ))) (Nat.add_zero 0) := by
      change (CategoryTheory.Abelian.Ext.mk₀ (ιℤ_s₀ ≫ pb_s₀.map (ηℤ_pbar ≫ pf_pbar.map f_ξ))).comp
          (CategoryTheory.Abelian.Ext.mk₀ (bc₀_gen Q2_P)) (Nat.add_zero 0) = _
      rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        pb_s₀.map_comp, CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hbc_nat f_ξ]
      dsimp only [g₀]
      simp only [CategoryTheory.Category.assoc]
    have hz_wξ : leray₀ (pb_is₀.obj Q2_P)
        ((CategoryTheory.Abelian.Ext.mk₀ bc₀_bot).postcomp Fℤ_Sk (Nat.add_zero 0) w_ξ) =
        CategoryTheory.Abelian.Ext.mk₀ (ιℤ_is₀ ≫ pb_is₀.map f_ξ) := by
      rw [hbc_wξ, hleray_nat (pb_is₀.map f_ξ), hleray_mk₀ (pb_is₀.obj Fℤ_P) g₀, hMate,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
    have hmap_Ξ : ((CategoryTheory.Abelian.Ext.mk₀ (ιℤ_is₀ ≫ pb_is₀.map f_ξ)).comp
        hS1_i.extClass (Nat.zero_add 1)).comp hS0_i.extClass (Nat.one_add 1) =
        (CategoryTheory.Abelian.Ext.mk₀ ιℤ_is₀).comp
          (pb_is₀.mapExtAddHom Fℤ_P F_P_top 2 Ξ) (Nat.zero_add 2) := by
      rw [← hf_ξ_eq]
      change ((CategoryTheory.Abelian.Ext.mk₀ (ιℤ_is₀ ≫ pb_is₀.map f_ξ)).comp
          hS1_i.extClass (Nat.zero_add 1)).comp hS0_i.extClass (Nat.one_add 1) =
        (CategoryTheory.Abelian.Ext.mk₀ ιℤ_is₀).comp
          (CategoryTheory.Abelian.Ext.mapExactFunctor pb_is₀
            (((CategoryTheory.Abelian.Ext.mk₀ f_ξ).comp hS1_P.extClass (Nat.zero_add 1)).comp
              hS0_P.extClass (Nat.one_add 1)))
          (Nat.zero_add 2)
      rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp pb_is₀ _ hS0_P.extClass (Nat.one_add 1),
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp pb_is₀ _ hS1_P.extClass (Nat.zero_add 1),
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀ pb_is₀ f_ξ,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass pb_is₀ hS1_P,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass pb_is₀ hS0_P,
        ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ ιℤ_is₀ (pb_is₀.map f_ξ),
        CategoryTheory.Abelian.Ext.comp_assoc
          (CategoryTheory.Abelian.Ext.mk₀ ιℤ_is₀)
          (CategoryTheory.Abelian.Ext.mk₀ (pb_is₀.map f_ξ))
          hS1_i.extClass (Nat.zero_add 0) (Nat.zero_add 1) (Nat.zero_add 1),
        CategoryTheory.Abelian.Ext.comp_assoc
          (CategoryTheory.Abelian.Ext.mk₀ ιℤ_is₀) _
          hS0_i.extClass (Nat.zero_add 1) (Nat.one_add 1) (Nat.zero_add 2)]
    change (CategoryTheory.Abelian.Ext.mk₀ πM_is₀).postcomp Fℤ_P1 (Nat.add_zero 2)
        (((leray₀ (pb_is₀.obj Q2_P)
          ((CategoryTheory.Abelian.Ext.mk₀ bc₀_bot).postcomp Fℤ_Sk (Nat.add_zero 0) w_ξ)).comp
          hS1_i.extClass (Nat.zero_add 1)).comp hS0_i.extClass (Nat.one_add 1)) = ξ
    rw [hz_wξ, hmap_Ξ]
    exact hp_retract_ξ

  
  have _ := hFin_dom
  have _ := hFin_cod
  let _ft_dom := Fintype.ofFinite ((pb_s₀.obj R1_Q1).H 0)
  let _ft_cod := Fintype.ofFinite (weilEtaleTorsionH P1.left (ℓ ^ (r₀ + 1)) 2)
  let e_card : weilEtaleTorsionH P1.left (ℓ ^ (r₀ + 1)) 2 ≃ (pb_s₀.obj R1_Q1).H 0 :=
    Fintype.equivOfCardEq (by
      rw [Fintype.card_eq_nat_card, Fintype.card_eq_nat_card, hCard_cod, hCard_dom])
  have hbij_comp : Function.Bijective (e_card ∘ res_P) :=
    Finite.surjective_iff_bijective.mp (e_card.surjective.comp hSurj_res)
  have hBij_res : Function.Bijective res_P := by
    have hfn_eq : (res_P : _ → _) = e_card.symm ∘ (e_card ∘ res_P) := by funext a; simp
    rw [hfn_eq]
    exact e_card.symm.bijective.comp hbij_comp

  exact ⟨res_P, hBij_res, fun w => hres_spec w⟩

theorem weil_gysin_relP1_two_step_leray_edge_and_fiber_mate_diagram (hc_all : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Y₁ ⟶ Y₂),
      (weilEtaleSitePullback h).IsContinuous Y₂.smallEtaleTopology Y₁.smallEtaleTopology)
    (hr_all : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Y₁ ⟶ Y₂),
      (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _ (weilEtaleSitePullback h)
        AddCommGrpCat.{u} _ Y₂.smallEtaleTopology Y₁.smallEtaleTopology (hc_all h)).IsRightAdjoint)
    (hSitePkg : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Y₁ ⟶ Y₂),
      letI := hc_all h; letI := hr_all h
      let pb_h := (weilEtaleSitePullback h).sheafPullback AddCommGrpCat.{u}
        Y₂.smallEtaleTopology Y₁.smallEtaleTopology
      let pf_h := (weilEtaleSitePullback h).sheafPushforwardContinuous AddCommGrpCat.{u}
        Y₂.smallEtaleTopology Y₁.smallEtaleTopology
      pb_h.Additive ∧ pf_h.Additive ∧
      CategoryTheory.Limits.PreservesFiniteLimits pb_h ∧
      CategoryTheory.Limits.PreservesFiniteColimits pb_h ∧
      (∀ (I : CategoryTheory.Sheaf Y₁.smallEtaleTopology AddCommGrpCat.{u}),
        CategoryTheory.Injective I → CategoryTheory.Injective (pf_h.obj I)))
    (hCalc : ∀ {X S : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ S),
      letI := hc_all f; letI := hr_all f
      let pf_f := (weilEtaleSitePullback f).sheafPushforwardContinuous AddCommGrpCat.{u}
        S.smallEtaleTopology X.smallEtaleTopology
      (∀ (F₁ F₂ : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ),
        Nonempty (F₁ ≅ F₂) →
        Nonempty (weilEtaleHigherDirectImage f q F₁ ≅ weilEtaleHigherDirectImage f q F₂)) ∧
      (∀ (SC : CategoryTheory.ShortComplex
            (CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u})),
        SC.ShortExact →
        (∀ (p : ℕ), 1 ≤ p → CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f p SC.X₂)) →
        ((∃ (δ₀ : pf_f.obj SC.X₃ ⟶ weilEtaleHigherDirectImage f 1 SC.X₁)
            (hcomp : pf_f.map SC.g ≫ δ₀ = 0),
          CategoryTheory.Epi δ₀ ∧
          (CategoryTheory.ShortComplex.mk (pf_f.map SC.g) δ₀ hcomp).Exact) ∧
        (CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f 1 SC.X₁) →
          (SC.map pf_f).ShortExact)) ∧
        (∀ (q : ℕ), 1 ≤ q →
          Nonempty (weilEtaleHigherDirectImage f (q + 1) SC.X₁ ≅
            weilEtaleHigherDirectImage f q SC.X₃)) ∧
        (∀ (p : ℕ), 1 ≤ p →
          CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f (p + 1) SC.X₁) →
          CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f p SC.X₃))))
    (hConstIso : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂)
        {T₁ : X₁.Etale} (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
        {T₂ : X₂.Etale} (hT₂ : CategoryTheory.Limits.IsTerminal T₂)
        (A : AddCommGrpCat.{u}),
      letI := hc_all h; letI := hr_all h
      CategoryTheory.IsIso (weilEtaleConstPullbackHom h hT₁ hT₂ A))
    (hFreePull : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂)
        (U : X₂.Etale) (n : ℕ),
      letI := hc_all h; letI := hr_all h
      let B_h := weilEtaleSitePullback h
      let pb_h := B_h.sheafPullback AddCommGrpCat.{u}
        X₂.smallEtaleTopology X₁.smallEtaleTopology
      let adj_h := B_h.sheafAdjunctionContinuous AddCommGrpCat.{u}
        X₂.smallEtaleTopology X₁.smallEtaleTopology
      let π_M := weilEtaleConstPullbackHom h (weilEtaleIdTerminalIsTerminal.{u} X₁)
        (weilEtaleIdTerminalIsTerminal.{u} X₂)
