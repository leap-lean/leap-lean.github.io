theorem weil_gysin_clopen_and_cartesian_shriek_local_pullback {Z W₀ Γ₀ P₀ : AlgebraicGeometry.Scheme.{u}}
    (π : Quiver.Hom Γ₀ P₀)
    (j : Quiver.Hom W₀ Γ₀) [AlgebraicGeometry.IsOpenImmersion j]
    (h : Quiver.Hom W₀ P₀) (hh : AlgebraicGeometry.Etale h)
    (s_W : Quiver.Hom Z W₀) [AlgebraicGeometry.IsClosedImmersion s_W]
    (s_Γ : Quiver.Hom Z Γ₀) [AlgebraicGeometry.IsClosedImmersion s_Γ]
    (s_P : Quiver.Hom Z P₀) [AlgebraicGeometry.IsClosedImmersion s_P]
    (_ : CategoryTheory.CategoryStruct.comp j π = h)
    (_ : CategoryTheory.CategoryStruct.comp s_W j = s_Γ)
    (_ : CategoryTheory.CategoryStruct.comp s_W h = s_P)
    (m q : ℕ)
    (α_W : WeilGysinAbSupportClass Z W₀ s_W m q)
    (z_Γ : weilGysinLocalTorsionH Γ₀ m (weilGysinEtaleObj j inferInstance) q)
    (z_P : weilGysinLocalTorsionH P₀ m (weilGysinEtaleObj h hh) q)
    (_ : WeilGysinIsShriekLocalSupportPush j inferInstance s_W s_Γ m q α_W z_Γ)
    (_ : WeilGysinIsShriekLocalSupportPush h hh s_W s_P m q α_W z_P) :
    (AlgebraicGeometry.IsProper π →
      WeilGysinIsClopenPullbackOnLocalH π
        (weilGysinEtaleObj j inferInstance)
        (weilGysinEtaleObj h hh)
        (CategoryTheory.Iso.refl W₀) m q z_P z_Γ) ∧
    (CategoryTheory.IsPullback j (CategoryTheory.CategoryStruct.id W₀) π h →
      ∀ (p_π : weilEtaleTorsionH P₀ m q →+ weilEtaleTorsionH Γ₀ m q),
        WeilIsTorsionEtalePullback π m q p_π →
        weilGysinLocalTorsionCounitH Γ₀ m (weilGysinEtaleObj j inferInstance) q z_Γ =
          p_π (weilGysinLocalTorsionCounitH P₀ m (weilGysinEtaleObj h hh) q z_P)) :=
by
  have hjπ : CategoryTheory.CategoryStruct.comp j π = h := ‹_›
  have hsΓ : CategoryTheory.CategoryStruct.comp s_W j = s_Γ := ‹_›
  have hsP : CategoryTheory.CategoryStruct.comp s_W h = s_P := ‹_›
  have hsh_Γ : WeilGysinIsShriekLocalSupportPush j inferInstance s_W s_Γ m q α_W z_Γ := ‹_›
  have hsh_P : WeilGysinIsShriekLocalSupportPush h hh s_W s_P m q α_W z_P := ‹_›
  have hj_et : AlgebraicGeometry.Etale j := inferInstance
  
  have hExtPkg : ∀ {C_ab D_ab E_ab : Type (u + 1)}
      [Category.{u + 1, u + 1} C_ab] [Abelian C_ab] [HasExt.{u} C_ab] [EnoughInjectives C_ab]
      [Category.{u + 1, u + 1} D_ab] [Abelian D_ab] [HasExt.{u} D_ab] [EnoughInjectives D_ab]
