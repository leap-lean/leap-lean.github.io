      have he_app : (Fgt_W'.map (e_sq.hom.app V_P)).left =
          ((Fgt_W'.map (e_sq₁.inv.app V_P)).left ≫
            (Fgt_W'.map (e_sq₂.hom.app V_P)).left) ≫
            (Fgt_W'.map (e_sq₃.hom.app V_P)).left := rfl
      exact (congrArg (· ≫ _) he_app).trans
        ((CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg _ h3).trans
            ((CategoryTheory.Category.assoc _ _ _).trans
              ((congrArg _ h2).trans h1_inv))))
    have hτ_pb_fst : (Fgt_W'.map τ_pb).left ≫
        CategoryTheory.Limits.pullback.fst (Fgt_P'.obj V'_P).hom π' =
        CategoryTheory.Limits.pullback.fst (Fgt_W.obj (B_π.obj V_P)).hom g' ≫
        CategoryTheory.Limits.pullback.fst (Fgt_P.obj V_P).hom π ≫ e_U.hom := by
      have hτ_app : (Fgt_W'.map τ_pb).left =
          (Fgt_W'.map (e_sq.hom.app V_P)).left ≫
            (Fgt_W'.map (B_π'.map ψ_hat_P.inv)).left := rfl
      exact (congrArg (· ≫ _) hτ_app).trans
        ((CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg ((Fgt_W'.map (e_sq.hom.app V_P)).left ≫ ·)
            ((hSiteMap_fst π' ψ_hat_P.inv).trans
              ((congrArg (CategoryTheory.Limits.pullback.fst _ π' ≫ ·) hψ_P_inv_fst).trans
                (CategoryTheory.Category.assoc _ _ e_U.hom).symm))).trans
            ((CategoryTheory.Category.assoc _ _ e_U.hom).symm.trans
              ((congrArg (· ≫ e_U.hom) he_sq_fst).trans
                (CategoryTheory.Category.assoc _ _ e_U.hom)))))
    have hσ'_fst : (Fgt_W'.map σ'_e).left ≫
        CategoryTheory.Limits.pullback.fst (Fgt_P'.obj V'_P).hom π' =
        (CategoryTheory.Iso.refl U').hom := by
      have hσ'_app : (Fgt_W'.map σ'_e).left =
          ((Fgt_W'.map ψ_hat_W.hom).left ≫
            (Fgt_W'.map (B_g'.map σ_e)).left) ≫ (Fgt_W'.map τ_pb).left := rfl
      have hfst_W : (Fgt_W'.map ψ_hat_W.hom).left ≫
          CategoryTheory.Limits.pullback.fst (Fgt_W.obj V_W).hom g' = e_U.inv := hψ_W_fst
      have hσ_fst' : (Fgt_W.map σ_e).left ≫
          CategoryTheory.Limits.pullback.fst (Fgt_P.obj V_P).hom π = 𝟙 U := hσ_fst
      have hmid_σ : (Fgt_W'.map (B_g'.map σ_e)).left ≫
          (CategoryTheory.Limits.pullback.fst (Fgt_W.obj (B_π.obj V_P)).hom g' ≫
            (CategoryTheory.Limits.pullback.fst (Fgt_P.obj V_P).hom π ≫ e_U.hom)) =
          CategoryTheory.Limits.pullback.fst (Fgt_W.obj V_W).hom g' ≫ e_U.hom :=
        (CategoryTheory.Category.assoc _ _ _).symm.trans
          ((congrArg (· ≫ _) (hSiteMap_fst g' σ_e)).trans
            ((CategoryTheory.Category.assoc _ _ _).trans
              (congrArg _
                ((CategoryTheory.Category.assoc _ _ e_U.hom).symm.trans
                  ((congrArg (· ≫ e_U.hom) hσ_fst').trans
                    (CategoryTheory.Category.id_comp e_U.hom))))))
      exact (congrArg (· ≫ _) hσ'_app).trans
        ((CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg _ hτ_pb_fst).trans
            ((CategoryTheory.Category.assoc _ _ _).trans
              ((congrArg _ hmid_σ).trans
                ((CategoryTheory.Category.assoc _ _ e_U.hom).symm.trans
                  ((congrArg (· ≫ e_U.hom) hfst_W).trans e_U.inv_hom_id))))))

    
    let u_Ψ : L_W ⟶ pf_g'.obj L'_W := adj_g'.homEquiv L_W L'_W Ψ_W.hom
    have hu_Ψ_fy : CategoryTheory.Sheaf.freeYonedaHomEquiv u_Ψ =
        CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 L'_W) ≫
          L'_W.obj.map (Opposite.op ψ_hat_W.inv) :=
      (congrArg (fun m => CategoryTheory.Sheaf.freeYonedaHomEquiv (adj_g'.homEquiv L_W L'_W m))
        (CategoryTheory.Category.comp_id Ψ_W.hom).symm).trans
        (hΨ_W_char L'_W (𝟙 L'_W))
    have hξ' : CategoryTheory.Sheaf.freeYonedaHomEquiv α'_π' =
        CategoryTheory.Sheaf.freeYonedaHomEquiv α_π ≫
          u_Ψ.hom.app (Opposite.op (B_π.obj V_P)) ≫
          L'_W.obj.map (Opposite.op τ_pb_inv) := by
      have hchar := hΨ_P_char (pf_π'.obj L'_W) α'_π'
      have hcancel : Ψ_P.hom ≫ α'_π' =
          pb_i.map α_π ≫ bc₀ ≫ pf_π'.map Ψ_W.hom :=
        CategoryTheory.Iso.hom_inv_id_assoc Ψ_P _
      have hadj_simp : adj_i.homEquiv L_P (pf_π'.obj L'_W)
          (pb_i.map α_π ≫ bc₀ ≫ pf_π'.map Ψ_W.hom) =
          α_π ≫ pf_π.map u_Ψ ≫ e_pf.hom.app L'_W := by
        have hbc : adj_i.homEquiv (pf_π.obj L_W) (pf_π'.obj (pb_g'.obj L_W)) bc₀ =
            pf_π.map (adj_g'.unit.app L_W) ≫ e_pf.hom.app (pb_g'.obj L_W) :=
          Equiv.apply_symm_apply _ _
        have hnat : e_pf.hom.app (pb_g'.obj L_W) ≫ pf_i.map (pf_π'.map Ψ_W.hom) =
            pf_π.map (pf_g'.map Ψ_W.hom) ≫ e_pf.hom.app L'_W :=
          (e_pf.hom.naturality Ψ_W.hom).symm
        have hu_def : adj_g'.unit.app L_W ≫ pf_g'.map Ψ_W.hom = u_Ψ :=
          (CategoryTheory.Adjunction.homEquiv_unit adj_g' L_W L'_W Ψ_W.hom).symm
        exact (CategoryTheory.Adjunction.homEquiv_naturality_left adj_i α_π _).trans
          ((congrArg (α_π ≫ ·)
            ((CategoryTheory.Adjunction.homEquiv_naturality_right adj_i bc₀ _).trans
              ((congrArg (· ≫ pf_i.map (pf_π'.map Ψ_W.hom)) hbc).trans
                ((CategoryTheory.Category.assoc _ _ _).trans
                  ((congrArg _ hnat).trans
                    ((CategoryTheory.Category.assoc _ _ _).symm.trans
                      (congrArg (· ≫ e_pf.hom.app L'_W)
                        ((pf_π.map_comp _ _).symm.trans (congrArg pf_π.map hu_def))))))))))
      have hfy_lhs : CategoryTheory.Sheaf.freeYonedaHomEquiv
          (α_π ≫ pf_π.map u_Ψ ≫ e_pf.hom.app L'_W) =
          (CategoryTheory.Sheaf.freeYonedaHomEquiv α_π ≫
            u_Ψ.hom.app (Opposite.op (B_π.obj V_P))) ≫
            L'_W.obj.map (Opposite.op (e_sq.inv.app V_P)) :=
        (congrArg CategoryTheory.Sheaf.freeYonedaHomEquiv
          (CategoryTheory.Category.assoc α_π _ _).symm).trans
          ((hFY_comp _ (e_pf.hom.app L'_W)).trans
            (congrArg (· ≫ L'_W.obj.map (Opposite.op (e_sq.inv.app V_P)))
              (hFY_comp α_π (pf_π.map u_Ψ))))
      have hchar' : (CategoryTheory.Sheaf.freeYonedaHomEquiv α_π ≫
            u_Ψ.hom.app (Opposite.op (B_π.obj V_P))) ≫
            L'_W.obj.map (Opposite.op (e_sq.inv.app V_P)) =
          CategoryTheory.Sheaf.freeYonedaHomEquiv α'_π' ≫
            (pf_π'.obj L'_W).obj.map (Opposite.op ψ_hat_P.inv) :=
        hfy_lhs.symm.trans
          ((congrArg CategoryTheory.Sheaf.freeYonedaHomEquiv
            ((congrArg (adj_i.homEquiv L_P (pf_π'.obj L'_W)) hcancel).trans
              hadj_simp).symm).trans hchar)
      have hop : (pf_π'.obj L'_W).obj.map (Opposite.op ψ_hat_P.inv) ≫
          (pf_π'.obj L'_W).obj.map (Opposite.op ψ_hat_P.hom) = 𝟙 _ :=
        ((pf_π'.obj L'_W).obj.map_comp _ _).symm.trans
          ((congrArg (pf_π'.obj L'_W).obj.map (congrArg Opposite.op ψ_hat_P.hom_inv_id)).trans
            ((pf_π'.obj L'_W).obj.map_id _))
      have htau_map : L'_W.obj.map (Opposite.op (e_sq.inv.app V_P)) ≫
          (pf_π'.obj L'_W).obj.map (Opposite.op ψ_hat_P.hom) =
          L'_W.obj.map (Opposite.op τ_pb_inv) :=
        (L'_W.obj.map_comp (Opposite.op (e_sq.inv.app V_P))
          (Opposite.op (B_π'.map ψ_hat_P.hom))).symm
      exact (CategoryTheory.Category.comp_id
          (CategoryTheory.Sheaf.freeYonedaHomEquiv α'_π')).symm.trans
        ((congrArg (CategoryTheory.Sheaf.freeYonedaHomEquiv α'_π' ≫ ·) hop.symm).trans
          ((CategoryTheory.Category.assoc _ _ _).symm.trans
            ((congrArg (· ≫ (pf_π'.obj L'_W).obj.map (Opposite.op ψ_hat_P.hom))
              hchar'.symm).trans
              ((CategoryTheory.Category.assoc _ _ _).trans
                ((congrArg _ htau_map).trans (CategoryTheory.Category.assoc _ _ _))))))

    
    have hα'_on : CategoryTheory.Sheaf.freeYonedaHomEquiv α'_π' ≫
        L'_W.obj.map (Opposite.op σ'_e) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 L'_W) := by
      have hσ_cancel : σ'_e ≫ τ_pb_inv = ψ_hat_W.hom ≫ B_g'.map σ_e :=
        (CategoryTheory.Category.assoc ψ_hat_W.hom (B_g'.map σ_e ≫ τ_pb) τ_pb_inv).trans
          (congrArg (ψ_hat_W.hom ≫ ·)
            ((CategoryTheory.Category.assoc (B_g'.map σ_e) τ_pb τ_pb_inv).trans
              ((congrArg (B_g'.map σ_e ≫ ·) hτ_hom_inv).trans
                (CategoryTheory.Category.comp_id _))))
      have hmap_σ : L'_W.obj.map (Opposite.op τ_pb_inv) ≫ L'_W.obj.map (Opposite.op σ'_e) =
          L'_W.obj.map (Opposite.op (B_g'.map σ_e)) ≫ L'_W.obj.map (Opposite.op ψ_hat_W.hom) :=
        (L'_W.obj.map_comp (Opposite.op τ_pb_inv) (Opposite.op σ'_e)).symm.trans
          ((congrArg L'_W.obj.map (congrArg Opposite.op hσ_cancel)).trans
            (L'_W.obj.map_comp (Opposite.op (B_g'.map σ_e)) (Opposite.op ψ_hat_W.hom)))
      have hnat_u : u_Ψ.hom.app (Opposite.op (B_π.obj V_P)) ≫
          L'_W.obj.map (Opposite.op (B_g'.map σ_e)) =
          L_W.obj.map (Opposite.op σ_e) ≫ u_Ψ.hom.app (Opposite.op V_W) :=
        (u_Ψ.hom.naturality (Opposite.op σ_e)).symm
      have hop_W : L'_W.obj.map (Opposite.op ψ_hat_W.inv) ≫
          L'_W.obj.map (Opposite.op ψ_hat_W.hom) = 𝟙 _ :=
        (L'_W.obj.map_comp _ _).symm.trans
          ((congrArg L'_W.obj.map (congrArg Opposite.op ψ_hat_W.hom_inv_id)).trans
            (L'_W.obj.map_id _))
      have hmid_u : (CategoryTheory.Sheaf.freeYonedaHomEquiv α_π ≫
          L_W.obj.map (Opposite.op σ_e)) ≫ u_Ψ.hom.app (Opposite.op V_W) =
          CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 L'_W) ≫
            L'_W.obj.map (Opposite.op ψ_hat_W.inv) :=
        (congrArg (· ≫ u_Ψ.hom.app (Opposite.op V_W)) hα_on).trans
          ((hFY_comp (𝟙 L_W) u_Ψ).symm.trans
            ((congrArg CategoryTheory.Sheaf.freeYonedaHomEquiv
              (CategoryTheory.Category.id_comp u_Ψ)).trans hu_Ψ_fy))
      exact (congrArg (· ≫ L'_W.obj.map (Opposite.op σ'_e)) hξ').trans
        ((CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg _ ((CategoryTheory.Category.assoc _ _ _).trans
            ((congrArg _ hmap_σ).trans
              ((CategoryTheory.Category.assoc _ _ _).symm.trans
                (congrArg (· ≫ L'_W.obj.map (Opposite.op ψ_hat_W.hom)) hnat_u))))).trans
            ((CategoryTheory.Category.assoc _ _ _).symm.trans
              ((congrArg (· ≫ L'_W.obj.map (Opposite.op ψ_hat_W.hom))
                ((CategoryTheory.Category.assoc _ _ _).symm.trans hmid_u)).trans
                ((CategoryTheory.Category.assoc _ _ _).trans
                  ((congrArg _ hop_W).trans (CategoryTheory.Category.comp_id _)))))))

    
    have hα'_off : ∀ (V' : W'₀.Etale) (w' : V' ⟶ B_π'.obj V'_P),
        Disjoint (Set.range ((Fgt_W'.map w').left).base)
          (Set.range ((Fgt_W'.map σ'_e).left).base) →
        CategoryTheory.Sheaf.freeYonedaHomEquiv α'_π' ≫
          L'_W.obj.map (Opposite.op w') = 0 := by
      intro V' w' h_disj'
      let Q : W₀.Etale := B_π.obj V_P
      let w₁ : V' ⟶ B_g'.obj Q := w' ≫ τ_pb_inv
      have hw'_eq : w' = w₁ ≫ τ_pb :=
        (CategoryTheory.Category.comp_id w').symm.trans
          ((congrArg (w' ≫ ·) hτ_inv_hom.symm).trans
            (CategoryTheory.Category.assoc w' τ_pb_inv τ_pb).symm)
      let r₁ : (Fgt_W'.obj (B_g'.obj Q)).left ⟶ (Fgt_W.obj Q).left :=
        CategoryTheory.Limits.pullback.fst (Fgt_W.obj Q).hom g'
      haveI : CategoryTheory.IsIso g' := e_W.isIso_inv
      haveI : CategoryTheory.IsIso r₁ :=
        CategoryTheory.Limits.pullback_fst_iso_of_right_iso (Fgt_W.obj Q).hom g'
      have hEt_V₀ : AlgebraicGeometry.Etale ((Fgt_W'.obj V').hom ≫ g') := by
        haveI : AlgebraicGeometry.Etale (Fgt_W'.obj V').hom := V'.prop
        infer_instance
      let V₀ : W₀.Etale := weilGysinEtaleObj ((Fgt_W'.obj V').hom ≫ g') hEt_V₀
      let q_V : (Fgt_W.obj V₀).left ⟶ (Fgt_W.obj Q).left := (Fgt_W'.map w₁).left ≫ r₁
      have hq_V : q_V ≫ (Fgt_W.obj Q).hom = (Fgt_W.obj V₀).hom :=
        (CategoryTheory.Category.assoc (Fgt_W'.map w₁).left r₁ (Fgt_W.obj Q).hom).trans
          ((congrArg ((Fgt_W'.map w₁).left ≫ ·)
            (CategoryTheory.Limits.pullback.condition (f := (Fgt_W.obj Q).hom) (g := g'))).trans
            ((CategoryTheory.Category.assoc _ _ g').symm.trans
              (congrArg (· ≫ g') (CategoryTheory.Over.w (Fgt_W'.map w₁)))))
      let w : V₀ ⟶ Q := CategoryTheory.MorphismProperty.Over.homMk q_V hq_V trivial
      let γ_left : (Fgt_W'.obj V').left ⟶ (Fgt_W'.obj (B_g'.obj V₀)).left :=
        CategoryTheory.Limits.pullback.lift (𝟙 (Fgt_W'.obj V').left) (Fgt_W'.obj V').hom
          (CategoryTheory.Category.id_comp _)
      let γ_hom : V' ⟶ B_g'.obj V₀ :=
        CategoryTheory.MorphismProperty.Over.homMk γ_left
          (CategoryTheory.Limits.pullback.lift_snd _ _ _) trivial
      have hw₁_fac : γ_hom ≫ B_g'.map w = w₁ := by
        refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
        apply CategoryTheory.Limits.pullback.hom_ext
        · have hγ_fst : γ_left ≫ CategoryTheory.Limits.pullback.fst (Fgt_W.obj V₀).hom g' =
              𝟙 (Fgt_W'.obj V').left :=
            CategoryTheory.Limits.pullback.lift_fst _ _ _
          exact (CategoryTheory.Category.assoc γ_left
            (Fgt_W'.map (B_g'.map w)).left r₁).trans
            ((congrArg (γ_left ≫ ·) (hSiteMap_fst g' w)).trans
              ((CategoryTheory.Category.assoc γ_left _ _).symm.trans
                ((congrArg (· ≫ (Fgt_W.map w).left) hγ_fst).trans
                  (CategoryTheory.Category.id_comp q_V))))
        · change (Fgt_W'.map (γ_hom ≫ B_g'.map w)).left ≫ (Fgt_W'.obj (B_g'.obj Q)).hom =
            (Fgt_W'.map w₁).left ≫ (Fgt_W'.obj (B_g'.obj Q)).hom
          exact (CategoryTheory.Over.w (Fgt_W'.map (γ_hom ≫ B_g'.map w))).trans
            (CategoryTheory.Over.w (Fgt_W'.map w₁)).symm
      have h_disj : Disjoint
          (Set.range ((Fgt_W.map w).left).base)
          (Set.range ((Fgt_W.map σ_e).left).base) := by
        rw [Set.disjoint_left]
        rintro x ⟨v', hv'⟩ ⟨u, hu⟩
        let u' : ↥(Fgt_W'.obj V'_W).left := e_U.hom.base u
        let σ₁ : V'_W ⟶ B_g'.obj Q := ψ_hat_W.hom ≫ B_g'.map σ_e
        have hσ₁_r₁ : (Fgt_W'.map σ₁).left ≫ r₁ = e_U.inv ≫ (Fgt_W.map σ_e).left :=
          (CategoryTheory.Category.assoc (Fgt_W'.map ψ_hat_W.hom).left
            (Fgt_W'.map (B_g'.map σ_e)).left r₁).trans
            ((congrArg ((Fgt_W'.map ψ_hat_W.hom).left ≫ ·) (hSiteMap_fst g' σ_e)).trans
              ((CategoryTheory.Category.assoc _ _ _).symm.trans
                (congrArg (· ≫ (Fgt_W.map σ_e).left) hψ_W_fst)))
        have hL : r₁.base (((Fgt_W'.map w₁).left).base v') = x :=
          (AlgebraicGeometry.Scheme.Hom.comp_apply (Fgt_W'.map w₁).left r₁ v').symm.trans hv'
        have hR : r₁.base (((Fgt_W'.map σ₁).left).base u') = x :=
          (AlgebraicGeometry.Scheme.Hom.comp_apply (Fgt_W'.map σ₁).left r₁ u').symm.trans
            ((congrArg (fun k : (Fgt_W'.obj V'_W).left ⟶ (Fgt_W.obj Q).left => k.base u')
              hσ₁_r₁).trans
              ((AlgebraicGeometry.Scheme.Hom.comp_apply e_U.inv (Fgt_W.map σ_e).left u').trans
                ((congrArg ((Fgt_W.map σ_e).left).base
                  ((AlgebraicGeometry.Scheme.Hom.comp_apply e_U.hom e_U.inv u).symm.trans
                    (congrArg (fun k : U ⟶ U => k.base u) e_U.hom_inv_id))).trans hu)))
        have hr₁_eq : r₁.base (((Fgt_W'.map w₁).left).base v') =
            r₁.base (((Fgt_W'.map σ₁).left).base u') :=
          hL.trans hR.symm
        have hw₁_eq : ((Fgt_W'.map w₁).left).base v' = ((Fgt_W'.map σ₁).left).base u' :=
          (congrArg (fun k : (Fgt_W'.obj (B_g'.obj Q)).left ⟶ (Fgt_W'.obj (B_g'.obj Q)).left =>
              k.base (((Fgt_W'.map w₁).left).base v'))
            (CategoryTheory.IsIso.hom_inv_id r₁).symm).trans
            ((AlgebraicGeometry.Scheme.Hom.comp_apply r₁ (CategoryTheory.inv r₁) _).trans
              ((congrArg (CategoryTheory.inv r₁).base hr₁_eq).trans
                ((AlgebraicGeometry.Scheme.Hom.comp_apply r₁ (CategoryTheory.inv r₁) _).symm.trans
                  (congrArg (fun k : (Fgt_W'.obj (B_g'.obj Q)).left ⟶
                      (Fgt_W'.obj (B_g'.obj Q)).left =>
                    k.base (((Fgt_W'.map σ₁).left).base u'))
                    (CategoryTheory.IsIso.hom_inv_id r₁)))))
        have hw'_pt : ((Fgt_W'.map w').left).base v' = ((Fgt_W'.map σ'_e).left).base u' :=
          (congrArg (fun k => ((Fgt_W'.map k).left).base v') hw'_eq).trans
            ((AlgebraicGeometry.Scheme.Hom.comp_apply
              (Fgt_W'.map w₁).left (Fgt_W'.map τ_pb).left v').trans
              ((congrArg ((Fgt_W'.map τ_pb).left).base hw₁_eq).trans
                (AlgebraicGeometry.Scheme.Hom.comp_apply
                  (Fgt_W'.map σ₁).left (Fgt_W'.map τ_pb).left u').symm))
        exact Set.disjoint_left.mp h_disj' ⟨v', rfl⟩ ⟨u', hw'_pt.symm⟩
      have hzero := hα_off V₀ w h_disj
      have hw'_cancel : w' ≫ τ_pb_inv = γ_hom ≫ B_g'.map w :=
        (congrArg (· ≫ τ_pb_inv) hw'_eq).trans
          ((CategoryTheory.Category.assoc w₁ τ_pb τ_pb_inv).trans
            ((congrArg (w₁ ≫ ·) hτ_hom_inv).trans
              ((CategoryTheory.Category.comp_id w₁).trans hw₁_fac.symm)))
      have hmap_w' : L'_W.obj.map (Opposite.op τ_pb_inv) ≫ L'_W.obj.map (Opposite.op w') =
          L'_W.obj.map (Opposite.op (B_g'.map w)) ≫ L'_W.obj.map (Opposite.op γ_hom) :=
        (L'_W.obj.map_comp (Opposite.op τ_pb_inv) (Opposite.op w')).symm.trans
          ((congrArg L'_W.obj.map (congrArg Opposite.op hw'_cancel)).trans
            (L'_W.obj.map_comp (Opposite.op (B_g'.map w)) (Opposite.op γ_hom)))
      have hnat_w : u_Ψ.hom.app (Opposite.op Q) ≫
          L'_W.obj.map (Opposite.op (B_g'.map w)) =
          L_W.obj.map (Opposite.op w) ≫ u_Ψ.hom.app (Opposite.op V₀) :=
        (u_Ψ.hom.naturality (Opposite.op w)).symm
      exact (congrArg (· ≫ L'_W.obj.map (Opposite.op w')) hξ').trans
        ((CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg _ ((CategoryTheory.Category.assoc _ _ _).trans
            ((congrArg _ hmap_w').trans
              ((CategoryTheory.Category.assoc _ _ _).symm.trans
                (congrArg (· ≫ L'_W.obj.map (Opposite.op γ_hom)) hnat_w))))).trans
            ((CategoryTheory.Category.assoc _ _ _).symm.trans
              ((congrArg (· ≫ L'_W.obj.map (Opposite.op γ_hom))
                ((CategoryTheory.Category.assoc _ _ _).symm.trans
                  ((congrArg (· ≫ u_Ψ.hom.app (Opposite.op V₀)) hzero).trans
                    CategoryTheory.Limits.zero_comp))).trans
                CategoryTheory.Limits.zero_comp))))

    
    let adj_top := adj_π.comp adj_g'
    let adj_bot := (adj_i.comp adj_π').ofNatIsoRight e_pf.symm
    let η_sq := CategoryTheory.Adjunction.leftAdjointUniq adj_top adj_bot
    have hCompEquiv_top : ∀ (X : CategoryTheory.Sheaf P₀.smallEtaleTopology AddCommGrpCat.{u})
        (Y : CategoryTheory.Sheaf W'₀.smallEtaleTopology AddCommGrpCat.{u})
        (k : pb_g'.obj (P_pull_π.obj X) ⟶ Y),
        adj_top.homEquiv X Y k =
          adj_π.homEquiv X (pf_g'.obj Y) (adj_g'.homEquiv (P_pull_π.obj X) Y k) :=
      fun X Y k => congrArg (fun e => e X Y k)
