  have hNullstellensatz : ∀ {Ω B : Type u} [Field Ω] [IsAlgClosed Ω]
      [CommRing B] [Nontrivial B] [Algebra Ω B] [Algebra.FiniteType Ω B],
      Nonempty (B →ₐ[Ω] Ω) :=
    fun {Ω B} _ _ _ _ _ _ => by
      classical
      obtain ⟨n, f, hf_surj⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp ‹_›
      let I : Ideal (MvPolynomial (Fin n) Ω) := RingHom.ker f.toRingHom
      have hI_ne_top : I ≠ ⊤ := by
        intro htop
        apply one_ne_zero (α := B)
        have h1 : (1 : MvPolynomial (Fin n) Ω) ∈ I := htop ▸ Submodule.mem_top
        have hmap1 : f 1 = 0 := h1
        rw [map_one] at hmap1
        exact hmap1
      have hZ_ne : (MvPolynomial.zeroLocus Ω I).Nonempty := by
        rw [Set.nonempty_iff_ne_empty]
        intro hemp
        have hrad := MvPolynomial.vanishingIdeal_zeroLocus_eq_radical (K := Ω) I
        rw [hemp, MvPolynomial.vanishingIdeal_empty] at hrad
        have h1_rad : (1 : MvPolynomial (Fin n) Ω) ∈ I.radical := hrad ▸ Submodule.mem_top
        obtain ⟨k, hk⟩ := h1_rad
        rw [one_pow] at hk
        exact hI_ne_top (Ideal.eq_top_of_isUnit_mem I hk isUnit_one)
      obtain ⟨v, hv⟩ := hZ_ne
      let ev_v : MvPolynomial (Fin n) Ω →ₐ[Ω] Ω := MvPolynomial.aeval v
      have hker_le : ∀ p : MvPolynomial (Fin n) Ω, f p = 0 → ev_v p = 0 :=
        fun p hp => hv p hp
      refine ⟨{ toFun := fun b => ev_v (Function.surjInv hf_surj b)
                map_one' := by
                  have h : f (Function.surjInv hf_surj 1 - 1) = 0 := by
                    rw [map_sub, Function.surjInv_eq hf_surj, map_one, sub_self]
                  have hev : ev_v (Function.surjInv hf_surj 1 - 1) = 0 := hker_le _ h
                  rwa [map_sub, map_one, sub_eq_zero] at hev
                map_mul' := fun x y => by
                  have h : f (Function.surjInv hf_surj (x * y) -
                      Function.surjInv hf_surj x * Function.surjInv hf_surj y) = 0 := by
                    rw [map_sub, map_mul, Function.surjInv_eq hf_surj,
                      Function.surjInv_eq hf_surj, Function.surjInv_eq hf_surj, sub_self]
                  have hev := hker_le _ h
                  rwa [map_sub, map_mul, sub_eq_zero] at hev
                map_zero' := hker_le _ (Function.surjInv_eq hf_surj 0)
                map_add' := fun x y => by
                  have h : f (Function.surjInv hf_surj (x + y) -
                      (Function.surjInv hf_surj x + Function.surjInv hf_surj y)) = 0 := by
                    rw [map_sub, map_add, Function.surjInv_eq hf_surj,
                      Function.surjInv_eq hf_surj, Function.surjInv_eq hf_surj, sub_self]
                  have hev := hker_le _ h
                  rwa [map_sub, map_add, sub_eq_zero] at hev
                commutes' := fun c => by
                  have h : f (Function.surjInv hf_surj (algebraMap Ω B c) - MvPolynomial.C c) = 0 := by
                    rw [map_sub, Function.surjInv_eq hf_surj, ← MvPolynomial.algebraMap_eq,
                      f.commutes c, sub_self]
                  have hev := hker_le _ h
                  rwa [map_sub, MvPolynomial.aeval_C, sub_eq_zero] at hev }⟩
  have hLiftGeomPointEtale : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} {Ω : Type u}
      [Field Ω] [IsAlgClosed Ω]
      (u : X ⟶ Y) [AlgebraicGeometry.Etale u]
      (δ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ Y)
      (_hsurj_pt : ∃ x : ↥X, u.base x = δ.base (⊥ : PrimeSpectrum Ω)),
      ∃ δ' : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ X, δ' ≫ u = δ :=
    fun {X Y Ω} _ _ u _ δ hsurj_pt => by
      let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
      obtain ⟨x, hx⟩ := hsurj_pt
      let P := CategoryTheory.Limits.pullback u δ
      let π₁ := CategoryTheory.Limits.pullback.fst u δ
      let π₂ := CategoryTheory.Limits.pullback.snd u δ
      have _ : AlgebraicGeometry.Etale π₂ := inferInstance
      have _ : AlgebraicGeometry.LocallyOfFiniteType π₂ := inferInstance
      obtain ⟨p₀, _, _⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback (f := u) (g := δ)
          x (⊥ : PrimeSpectrum Ω) hx
      obtain ⟨V, hV_aff, hp₀V, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := p₀) (U := (⊤ : P.Opens)) trivial
      let B_cat : CommRingCat.{u} := P.presheaf.obj (Opposite.op V)
      have hSpec_nonempty : Nonempty ↥(AlgebraicGeometry.Spec B_cat) :=
        ⟨hV_aff.isoSpec.hom.base ⟨p₀, hp₀V⟩⟩
      have _ : Nontrivial ↑B_cat :=
        (PrimeSpectrum.nonempty_iff_nontrivial (R := ↑B_cat)).mp hSpec_nonempty
      let g_V : AlgebraicGeometry.Spec B_cat ⟶ S_Ω := hV_aff.fromSpec ≫ π₂
      have _ : AlgebraicGeometry.LocallyOfFiniteType g_V := by
        dsimp [g_V]
        have _ : AlgebraicGeometry.IsOpenImmersion hV_aff.fromSpec := inferInstance
        infer_instance
      let φ_cat : CommRingCat.of Ω ⟶ B_cat := AlgebraicGeometry.Spec.preimage g_V
      have hSpec_φ : AlgebraicGeometry.Spec.map φ_cat = g_V :=
        AlgebraicGeometry.Spec.map_preimage g_V
      have hFT_φ : φ_cat.hom.FiniteType :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff
          (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp (hSpec_φ.symm ▸ inferInstance)
      let _ : Algebra Ω ↑B_cat := φ_cat.hom.toAlgebra
      have _ : Algebra.FiniteType Ω ↑B_cat := hFT_φ
      obtain ⟨ψ⟩ := @hNullstellensatz Ω ↑B_cat _ _ _ _ _ _
      let s_B : S_Ω ⟶ AlgebraicGeometry.Spec B_cat :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ.toRingHom)
      have hs_π₂ : s_B ≫ hV_aff.fromSpec ≫ π₂ = 𝟙 S_Ω := by
        change s_B ≫ g_V = 𝟙 S_Ω
        rw [← hSpec_φ, ← AlgebraicGeometry.Spec.map_comp]
        have hcomp_id : φ_cat ≫ CommRingCat.ofHom ψ.toRingHom = 𝟙 (CommRingCat.of Ω) := by
          apply CommRingCat.hom_ext
          apply RingHom.ext
          intro c
          exact ψ.commutes c
        rw [hcomp_id, AlgebraicGeometry.Spec.map_id]
      refine ⟨s_B ≫ hV_aff.fromSpec ≫ π₁, ?_⟩
      exact (CategoryTheory.Category.assoc _ _ _).trans
        ((congrArg (s_B ≫ ·)
          ((CategoryTheory.Category.assoc _ _ _).trans
            ((congrArg (hV_aff.fromSpec ≫ ·) CategoryTheory.Limits.pullback.condition).trans
              (CategoryTheory.Category.assoc _ _ _).symm))).trans
          ((CategoryTheory.Category.assoc _ _ _).symm.trans
            ((congrArg (· ≫ δ) hs_π₂).trans (CategoryTheory.Category.id_comp δ))))
  let mkSkyPre : ∀ {S : AlgebraicGeometry.Scheme.{u}} {m : ℕ}
      {Ω : Type u} [Field Ω] [IsAlgClosed Ω]
      (_ξ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ S)
      (_M : ModuleCat.{u, u} (ULift.{u, 0} (ZMod m))),
      (S.Etale)ᵒᵖ ⥤ ModuleCat.{u, u} (ULift.{u, 0} (ZMod m)) :=
    fun {S m Ω} _ _ ξ M =>
      { obj := fun opW =>
          ModuleCat.of (ULift.{u, 0} (ZMod m))
            ({ δ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ (Opposite.unop opW).left //
                 δ ≫ (Opposite.unop opW).hom = ξ } → ↥M)
        map := fun f_op => ModuleCat.ofHom
          { toFun := fun sec δ₁ =>
              sec ⟨δ₁.1 ≫ f_op.unop.left,
                (CategoryTheory.Category.assoc δ₁.1 f_op.unop.left _).trans
                  ((congrArg (fun k => δ₁.1 ≫ k)
                    (CategoryTheory.MorphismProperty.Over.w f_op.unop)).trans δ₁.2)⟩
            map_add' := fun _ _ => rfl
            map_smul' := fun _ _ => rfl }
        map_id := fun _ => by
          apply ModuleCat.hom_ext
          apply LinearMap.ext
          intro sec
          funext δ
          exact congrArg sec (Subtype.ext (CategoryTheory.Category.comp_id δ.1))
        map_comp := fun _ _ => by
          apply ModuleCat.hom_ext
          apply LinearMap.ext
          intro sec
          funext δ
          exact congrArg sec (Subtype.ext (CategoryTheory.Category.assoc δ.1 _ _).symm) }
