        ζ₁ ≫ G.obj.map (Opposite.op σ₀) = ζ₂ ≫ G.obj.map (Opposite.op σ₀) →
        (∀ (V : W₀.Etale) (w : V ⟶ Q_et),
          Disjoint (Set.range ((Fgt_W.map w).left).base) (Set.range s₀.base) →
          ζ₁ ≫ G.obj.map (Opposite.op w) = ζ₂ ≫ G.obj.map (Opposite.op w)) →
