        map_add' := fun a₁ a₂ => (hQ S_cov hS_cov).isSeparatedFor.ext fun Y' f hf => by
          change (Q.map f.op).hom (hglue (a₁ + a₂)) = (Q.map f.op).hom (hglue a₁ + hglue a₂)
          rw [hglue_valid (a₁ + a₂) f hf, map_add, map_add,
            hglue_valid a₁ f hf, hglue_valid a₂ f hf] }
    refine ⟨gluedHom, ?_, ?_⟩
    · intro Y' f hf
      apply AddCommGrpCat.ext
      intro a
      exact hglue_valid a f hf
    · intro other hother
      apply AddCommGrpCat.ext
      intro a
      refine (hQ S_cov hS_cov).isSeparatedFor.ext fun Y' f hf => ?_
      have h1 := ConcreteCategory.congr_hom (hother f hf) a
      exact h1.trans (hglue_valid a f hf).symm
  have hSheafModOfType : ∀ {S : AlgebraicGeometry.Scheme.{u}} {m : ℕ}
