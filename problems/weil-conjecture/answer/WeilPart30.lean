        CategoryTheory.Limits.pullback.lift
          (CategoryTheory.Limits.pullback.fst (G_sub.map p₁) (G_sub.map p₂) ≫ e₁.inv)
          (CategoryTheory.Limits.pullback.snd (G_sub.map p₁) (G_sub.map p₂) ≫ e₂.inv)
          (by
            dsimp [f₁, f₂]
            rw [CategoryTheory.Category.assoc, e₁.inv_hom_id_assoc,
              CategoryTheory.Category.assoc, e₂.inv_hom_id_assoc,
              ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
              CategoryTheory.Category.assoc])
