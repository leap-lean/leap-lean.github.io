by
  have hs_comp : CategoryTheory.CategoryStruct.comp s_W h = s_S := ‹_›
  have hpb : CategoryTheory.IsPullback s_W (CategoryTheory.CategoryStruct.id Z) h s_S := ‹_›
  
  have hPillarEpi : ∀ {Z Y : AlgebraicGeometry.Scheme.{u}}
