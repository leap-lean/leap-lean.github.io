    let fam_pt : ∀ e : ↥E, CategoryTheory.Presieve.FamilyOfElements
        (P ⋙ CategoryTheory.forget (ModuleCat.{u, u} R)) S_cov.arrows :=
      fun e _ f hf => (fam f hf).hom e
