      σ₀.isOpenEmbedding.isOpen_range.isClosed_compl
    let C₀ : Set ↥V₀.toScheme := π₁.base '' ((Set.range σ₀.base)ᶜ)
    have hC₀_closed : IsClosed C₀ := π₁.isClosedEmbedding.isClosedMap _ hK_closed
    let W₀_set : Set ↥V₀.toScheme := C₀ᶜ
    have hW₀_open : IsOpen W₀_set := hC₀_closed.isOpen_compl
    let U_set : Set ↥Y.left := V₀.ι.base '' W₀_set
    have hU_open : IsOpen U_set := V₀.ι.isOpenEmbedding.isOpenMap _ hW₀_open
    let U : Y.left.Opens := ⟨U_set, hU_open⟩
    have hU_le : U ≤ V₀ := by
      rintro _ ⟨w, _, rfl⟩
      change V₀.ι.base w ∈ (V₀ : Set ↥Y.left)
      rw [← AlgebraicGeometry.Scheme.Opens.range_ι V₀]
      exact ⟨w, rfl⟩
    let j : U.toScheme ⟶ V₀.toScheme := Y.left.homOfLE hU_le
    have hj_ι : j ≫ V₀.ι = U.ι := Y.left.homOfLE_ι hU_le
    have : AlgebraicGeometry.IsOpenImmersion j := inferInstance
    have : AlgebraicGeometry.Etale j := inferInstance
    have hj_range : Set.range j.base = W₀_set := by
      ext w
      constructor
      · rintro ⟨u_pt, rfl⟩
        have hmem : V₀.ι.base (j.base u_pt) ∈ U_set := by
          have hcomp : V₀.ι.base (j.base u_pt) = U.ι.base u_pt := by
            rw [← Scheme.Hom.comp_apply, hj_ι]
          rw [hcomp]
          exact u_pt.2
        rcases hmem with ⟨w', hw', heq⟩
        have hw_eq : w' = j.base u_pt := V₀.ι.isOpenEmbedding.injective heq
        exact hw_eq ▸ hw'
      · intro hw
        have hmem : V₀.ι.base w ∈ (U : Set ↥Y.left) := ⟨w, hw, rfl⟩
        have hu_range : V₀.ι.base w ∈ Set.range U.ι.base := by
          rwa [AlgebraicGeometry.Scheme.Opens.range_ι U]
        rcases hu_range with ⟨u_pt, hu_pt⟩
        refine ⟨u_pt, V₀.ι.isOpenEmbedding.injective ?_⟩
        rw [← Scheme.Hom.comp_apply, hj_ι, hu_pt]
    have hsV₀_mem : s_V₀.base pt₀ ∈ W₀_set := by
      intro hmem
      rcases hmem with ⟨z, hz_not, hz_eq⟩
      have hπ₁_σ₀ : π₁.base (σ₀.base pt₀) = s_V₀.base pt₀ := by
        rw [← Scheme.Hom.comp_apply, hσ₀_π₁]
      have hzeq : z = σ₀.base pt₀ := π₁.isClosedEmbedding.injective (hz_eq.trans hπ₁_σ₀.symm)
      exact hz_not ⟨pt₀, hzeq.symm⟩
    have hs_U_range : Set.range s_hom.base ⊆ Set.range U.ι.base := by
      rintro _ ⟨z, rfl⟩
      rw [Subsingleton.elim z pt₀, AlgebraicGeometry.Scheme.Opens.range_ι U]
      have hcomp : s_hom.base pt₀ = V₀.ι.base (s_V₀.base pt₀) := by
        rw [← hs_V₀, Scheme.Hom.comp_apply]
      rw [hcomp]
      exact ⟨s_V₀.base pt₀, hsV₀_mem, rfl⟩
    obtain ⟨s_U, hs_U⟩ : ∃ s_U : S_k ⟶ U.toScheme, s_U ≫ U.ι = s_hom :=
      ⟨AlgebraicGeometry.IsOpenImmersion.lift U.ι s_hom hs_U_range,
       AlgebraicGeometry.IsOpenImmersion.lift_fac U.ι s_hom hs_U_range⟩
    have hsU_j : s_U ≫ j = s_V₀ := by
      rw [← CategoryTheory.cancel_mono V₀.ι, CategoryTheory.Category.assoc, hj_ι, hs_U, hs_V₀]
    have h_opensRange : (TopologicalSpace.Opens.map π₁.base).obj j.opensRange = σ₀.opensRange := by
      ext z
      change π₁.base z ∈ Set.range j.base ↔ z ∈ Set.range σ₀.base
      rw [hj_range]
      constructor
      · intro hnot
        by_contra hz
        exact hnot ⟨z, hz, rfl⟩
      · rintro ⟨pt, rfl⟩ ⟨z', hz'_not, hz'_eq⟩
        exact hz'_not ⟨pt, (π₁.isClosedEmbedding.injective hz'_eq).symm⟩
    have hpb_left : CategoryTheory.IsPullback σ₀ s_U π₁ j :=
      (AlgebraicGeometry.IsOpenImmersion.isPullback s_U σ₀ j π₁
        (by rw [hσ₀_π₁, hsU_j]) h_opensRange).flip
    have hpb_right : CategoryTheory.IsPullback π₂ π₁ zero_c u₀ :=
      (CategoryTheory.IsPullback.of_hasPullback u₀ zero_c).flip
    have hpb_pasted : CategoryTheory.IsPullback (σ₀ ≫ π₂) s_U zero_c (j ≫ u₀) :=
      hpb_left.paste_horiz hpb_right
    rw [hσ₀_π₂] at hpb_pasted
    let u : U.toScheme ⟶ weilGysinAffineSpace k c := j ≫ u₀
    have hu_et : AlgebraicGeometry.Etale u := by
      dsimp [u]; infer_instance
    have hu_struct : u ≫ weilGysinAffineStruct k c = U.ι ≫ Y.hom := by
      dsimp [u]
      rw [CategoryTheory.Category.assoc, hu₀_struct, ← CategoryTheory.Category.assoc, hj_ι]
    exact ⟨U, s_U, u, hu_et, hu_struct, hs_U, hpb_pasted.flip⟩
  obtain ⟨hP_int, hP_prop, hP_sm, ⟨s₀, hs₀⟩⟩ := h_s1
  let p_P := CategoryTheory.CategoryStruct.comp p₁ X.hom
  have : AlgebraicGeometry.IsProper p_P := hP_prop
  have : AlgebraicGeometry.SmoothOfRelativeDimension (2 * d) p_P := hP_sm
  let P_over : CategoryTheory.Over S_k := CategoryTheory.Over.mk p_P
  have hP_over_int : AlgebraicGeometry.IsIntegral P_over.left := hP_int
  have : AlgebraicGeometry.IsProper P_over.hom := hP_prop
  have : AlgebraicGeometry.SmoothOfRelativeDimension (2 * d) P_over.hom := hP_sm
  have hs₀_Δ : CategoryTheory.CategoryStruct.comp
      (CategoryTheory.CategoryStruct.comp s₀ Δ) P_over.hom =
      CategoryTheory.CategoryStruct.id S_k := by
    change (s₀ ≫ Δ) ≫ (p₁ ≫ X.hom) = 𝟙 S_k
    rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc Δ p₁ X.hom,
      CategoryTheory.Limits.pullback.diagonal_fst X.hom, CategoryTheory.Category.id_comp]
    exact hs₀
  obtain ⟨τ, hτ⟩ := weil_gysin_affine_origin_thom_tower k ℓ hℓ
  obtain ⟨tr_X, htr_X_bij, htr_X_compat, htr_X_pt⟩ :=
    weil_gysin_smooth_proper_point_normalized_torsion_trace k ℓ hℓ τ hτ d X hInt
  obtain ⟨tr_P, _, htr_P_compat, htr_P_pt⟩ :=
    weil_gysin_smooth_proper_point_normalized_torsion_trace k ℓ hℓ τ hτ (2 * d) P_over hP_over_int
  obtain ⟨U_X, s_UX, u_X, hChart_X⟩ := h_s2 d X s₀ hs₀
  have hcl_X0_ex : ∀ r : ℕ, ∃ cl : weilEtaleTorsionH X.left (ℓ ^ r) (2 * d),
      WeilGysinIsPointClass (τ d r) X.left X.hom s₀ cl := by
    intro r
    obtain ⟨τ_YX, τ_UX, cl, hp1, hp2, hfg⟩ :=
      (hτ.1 d X.left X.hom s₀ hs₀).1 U_X s_UX u_X hChart_X r
    exact ⟨cl, U_X, s_UX, u_X, hChart_X, τ_YX, τ_UX, hp1, hp2, hfg⟩
  choose cl_X0 hcl_X0 using hcl_X0_ex
  have htr_X0 : ∀ r : ℕ, tr_X r (cl_X0 r) = 1 :=
    fun r => htr_X_pt r s₀ (cl_X0 r) hs₀ (hcl_X0 r)
  obtain ⟨U_P, s_UP, u_P, hChart_P⟩ :=
    h_s2 (2 * d) P_over (CategoryTheory.CategoryStruct.comp s₀ Δ) hs₀_Δ
  have hcl_P_ex : ∀ r : ℕ, ∃ cl : weilEtaleTorsionH P (ℓ ^ r) (2 * (2 * d)),
      WeilGysinIsPointClass (τ (2 * d) r) P p_P
        (CategoryTheory.CategoryStruct.comp s₀ Δ) cl := by
    intro r
    obtain ⟨τ_YP, τ_UP, cl, hp1, hp2, hfg⟩ :=
      (hτ.1 (2 * d) P p_P (CategoryTheory.CategoryStruct.comp s₀ Δ) hs₀_Δ).1
        U_P s_UP u_P hChart_P r
    exact ⟨cl, U_P, s_UP, u_P, hChart_P, τ_YP, τ_UP, hp1, hp2, hfg⟩
  choose cl_P_diag hcl_P_diag using hcl_P_ex
  have htr_P_diag : ∀ r : ℕ, tr_P r (cl_P_diag r) = 1 :=
    fun r => htr_P_pt r (CategoryTheory.CategoryStruct.comp s₀ Δ)
      (cl_P_diag r) hs₀_Δ (hcl_P_diag r)
  have hu_gen : ∀ (r : ℕ) (u : weilEtaleTorsionH X.left (ℓ ^ r) (2 * d)),
      u = (tr_X r u).val • cl_X0 r := by
    intro r u
    apply (htr_X_bij r).injective
    rw [map_nsmul, htr_X0 r, nsmul_one, ZMod.natCast_zmod_val]
  refine ⟨tr_X, tr_P, htr_X_bij, htr_X_compat, htr_P_compat, ?_⟩
  intro r p₁_r p₂_r c_P_r hp₁ hp₂ hc_P u w
  have h_prod_cl : c_P_r (p₁_r (cl_X0 r)) (p₂_r (cl_X0 r)) = cl_P_diag r :=
    hτ.2.2.1 d r X s₀ hs₀ h4d (cl_X0 r) (cl_P_diag r)
      p₁_r p₂_r c_P_r (hcl_X0 r) (hcl_P_diag r) hp₁ hp₂ hc_P
  conv_lhs => rw [hu_gen r u, hu_gen r w]
  rw [map_nsmul p₁_r, map_nsmul p₂_r, map_nsmul c_P_r, AddMonoidHom.nsmul_apply,
    map_nsmul (c_P_r (p₁_r (cl_X0 r))), h_prod_cl, map_nsmul (tr_P r),
    map_nsmul (tr_P r), htr_P_diag r, nsmul_one, nsmul_eq_mul,
    ZMod.natCast_zmod_val, ZMod.natCast_zmod_val]

theorem weil_lefschetz_torsion_cup_left_nondegenerate (k : Type u) [Field k] [IsAlgClosed k]
    (d : ℕ) (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hInt : AlgebraicGeometry.IsIntegral X.left)
    [AlgebraicGeometry.IsProper X.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : IsUnit (ℓ : k))
    (r i j : ℕ) (hij : i + j = 2 * d)
    (c_X : weilEtaleTorsionH X.left (ℓ ^ r) i →+
      weilEtaleTorsionH X.left (ℓ ^ r) j →+ weilEtaleTorsionH X.left (ℓ ^ r) (2 * d))
    (hc_X : WeilLefschetzIsTorsionCup X.left (ℓ ^ r) i j (2 * d) hij c_X)
    (a : weilEtaleTorsionH X.left (ℓ ^ r) i)
    (ha : ∀ b : weilEtaleTorsionH X.left (ℓ ^ r) j, c_X a b = 0) :
    a = 0 :=
by
  classical
  
  have hUnitNat : ∀ {C_site : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C_site]
      (J : CategoryTheory.GrothendieckTopology C_site)
      (D : Type (u + 1)) [CategoryTheory.Category.{u, u + 1} D]
      [CategoryTheory.HasWeakSheafify J D]
      {T T₀ : C_site} (hT : CategoryTheory.Limits.IsTerminal T)
      (hT₀ : CategoryTheory.Limits.IsTerminal T₀)
      (τ : Quiver.Hom T T₀) (A : D),
      CategoryTheory.CategoryStruct.comp
        ((CategoryTheory.constantSheafAdj J D hT₀).unit.app A)
        ((((CategoryTheory.constantSheaf J D).obj A).obj).map (Opposite.op τ)) =
        (CategoryTheory.constantSheafAdj J D hT).unit.app A := by
    intro C_site _ J D _ _ T T₀ hT hT₀ τ A
    change CategoryTheory.CategoryStruct.comp
        (((CategoryTheory.constantPresheafAdj D hT₀).comp
          (CategoryTheory.sheafificationAdjunction J D)).unit.app A)
        ((((CategoryTheory.constantSheaf J D).obj A).obj).map (Opposite.op τ)) =
        (((CategoryTheory.constantPresheafAdj D hT).comp
          (CategoryTheory.sheafificationAdjunction J D)).unit.app A)
    rw [CategoryTheory.Adjunction.comp_unit_app, CategoryTheory.Adjunction.comp_unit_app,
      CategoryTheory.constantPresheafAdj_unit_app, CategoryTheory.constantPresheafAdj_unit_app]
    change CategoryTheory.CategoryStruct.comp
        (CategoryTheory.CategoryStruct.comp (CategoryTheory.CategoryStruct.id A)
          (((CategoryTheory.sheafificationAdjunction J D).unit.app
            ((CategoryTheory.Functor.const C_siteᵒᵖ).obj A)).app (Opposite.op T₀)))
        ((((CategoryTheory.constantSheaf J D).obj A).obj).map (Opposite.op τ)) =
      CategoryTheory.CategoryStruct.comp (CategoryTheory.CategoryStruct.id A)
        (((CategoryTheory.sheafificationAdjunction J D).unit.app
          ((CategoryTheory.Functor.const C_siteᵒᵖ).obj A)).app (Opposite.op T))
    rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.id_comp]
    have hnat := (((CategoryTheory.sheafificationAdjunction J D).unit.app
      ((CategoryTheory.Functor.const C_siteᵒᵖ).obj A)).naturality (Opposite.op τ)).symm
    change CategoryTheory.CategoryStruct.comp
        (((CategoryTheory.sheafificationAdjunction J D).unit.app
          ((CategoryTheory.Functor.const C_siteᵒᵖ).obj A)).app (Opposite.op T₀))
        ((((CategoryTheory.constantSheaf J D).obj A).obj).map (Opposite.op τ)) =
      CategoryTheory.CategoryStruct.comp (CategoryTheory.CategoryStruct.id A)
        (((CategoryTheory.sheafificationAdjunction J D).unit.app
          ((CategoryTheory.Functor.const C_siteᵒᵖ).obj A)).app (Opposite.op T)) at hnat
    rwa [CategoryTheory.Category.id_comp] at hnat
  have hCupMod : ∀ (W : AlgebraicGeometry.Scheme.{u}) (m deg₁ deg₂ deg₃ : ℕ)
      (hdeg : deg₁ + deg₂ = deg₃)
      (cup : weilEtaleTorsionH W m deg₁ →+
        weilEtaleTorsionH W m deg₂ →+ weilEtaleTorsionH W m deg₃),
      WeilLefschetzIsTorsionCup W m deg₁ deg₂ deg₃ hdeg cup →
      ∃ (θ₁ : weilEtaleModuleH W m deg₁ →+ weilEtaleTorsionH W m deg₁)
        (θ₂ : weilEtaleModuleH W m deg₂ →+ weilEtaleTorsionH W m deg₂)
        (θ₃ : weilEtaleModuleH W m deg₃ →+ weilEtaleTorsionH W m deg₃),
        WeilIsModuleToTorsionComparison W m deg₁ θ₁ ∧
        WeilIsModuleToTorsionComparison W m deg₂ θ₂ ∧
        WeilIsModuleToTorsionComparison W m deg₃ θ₃ ∧
        ∀ (α : weilEtaleModuleH W m deg₁) (β : weilEtaleModuleH W m deg₂),
          cup (θ₁ α) (θ₂ β) = θ₃ (CategoryTheory.Abelian.Ext.comp α β hdeg) := by
    intro W m deg₁ deg₂ deg₃ hdeg cup hcup
    let R := ULift.{u, 0} (ZMod m)
    let J := W.smallEtaleTopology
    let R_mod := ModuleCat.of R R
    let One_mod := weilEtaleModuleUnit W m
    let F_fg := CategoryTheory.forget₂ (ModuleCat.{u, u} R) AddCommGrpCat.{u}
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
    let C_ab := CategoryTheory.constantSheaf J AddCommGrpCat.{u}
    let Fℤ := C_ab.obj Aℤ
    let FM := weilEtaleTorsionSheaf W m
    let ιM : Quiver.Hom AM (F_fg.obj R_mod) := AddCommGrpCat.ofHom (AddMonoidHom.id R)
    let z_to_m : Quiver.Hom Aℤ AM :=
      AddCommGrpCat.ofHom
        { toFun := fun z => ULift.up ((z.down : ℤ) : ZMod m)
          map_zero' := congrArg ULift.up Int.cast_zero
          map_add' := fun x y => congrArg ULift.up (Int.cast_add x.down y.down) }
    rcases hcup with
      ⟨U, hU_obj, hU_map, hAdd, hLim, hColim, T, hT, u_unit, hu_unit, πM, hαπ, hπα, hcup_eq⟩
    have := hAdd
    have := hLim
    have := hColim
    let adj_ab := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT
    let adj_mod := CategoryTheory.constantSheafAdj J (ModuleCat.{u, u} R) hT
    let αM : Quiver.Hom FM (U.obj One_mod) :=
      (adj_ab.homEquiv AM (U.obj One_mod)).symm (CategoryTheory.CategoryStruct.comp ιM u_unit)
    let ιℤ : Quiver.Hom Fℤ (U.obj One_mod) :=
      CategoryTheory.CategoryStruct.comp (C_ab.map z_to_m) αM
    let θ_hom : ∀ deg : ℕ, weilEtaleModuleH W m deg →+ weilEtaleTorsionH W m deg := fun deg =>
      { toFun := fun γ =>
          (CategoryTheory.Abelian.Ext.mk₀ πM).postcomp Fℤ (Nat.add_zero deg)
            ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
              ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ U _ _ _ _ _ One_mod One_mod deg) γ)
              (Nat.zero_add deg))
        map_zero' := by
          rw [map_zero, CategoryTheory.Abelian.Ext.comp_zero, map_zero]
        map_add' := fun x y => by
          rw [map_add, CategoryTheory.Abelian.Ext.comp_add, map_add] }
    have hθ_comp : ∀ deg : ℕ, WeilIsModuleToTorsionComparison W m deg (θ_hom deg) := by
      intro deg
      let T₀ : W.Etale := weilEtaleIdTerminal.{u} W
      let hT₀ : CategoryTheory.Limits.IsTerminal T₀ := weilEtaleIdTerminalIsTerminal.{u} W
      let τ : Quiver.Hom T T₀ := hT₀.from T
      let adjℤ₀ := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT₀
      let adjR₀ := CategoryTheory.constantSheafAdj J (ModuleCat.{u, u} R) hT₀
      have h_T₀ : ((U.obj One_mod).obj).obj (Opposite.op T₀) =
          F_fg.obj ((One_mod.obj).obj (Opposite.op T₀)) :=
        congrArg (fun P => P.obj (Opposite.op T₀)) (hU_obj One_mod)
      have h_T : ((U.obj One_mod).obj).obj (Opposite.op T) =
          F_fg.obj ((One_mod.obj).obj (Opposite.op T)) :=
        congrArg (fun P => P.obj (Opposite.op T)) (hU_obj One_mod)
      let u_unit₀ : Quiver.Hom (F_fg.obj R_mod) (((U.obj One_mod).obj).obj (Opposite.op T₀)) :=
        CategoryTheory.CategoryStruct.comp
          (F_fg.map (adjR₀.unit.app R_mod))
          (CategoryTheory.eqToHom h_T₀.symm)
      have hu_unit₀ : HEq u_unit₀ (F_fg.map (adjR₀.unit.app R_mod)) :=
        CategoryTheory.comp_eqToHom_heq _ _
      have hu_unit_eq : u_unit =
          CategoryTheory.CategoryStruct.comp
            (F_fg.map (adj_mod.unit.app R_mod))
            (CategoryTheory.eqToHom h_T.symm) :=
        eq_of_heq (hu_unit.trans (CategoryTheory.comp_eqToHom_heq _ _).symm)
      have hu_compat : CategoryTheory.CategoryStruct.comp u_unit₀
          (((U.obj One_mod).obj).map (Opposite.op τ)) = u_unit := by
        have h_map_τ : ((U.obj One_mod).obj).map (Opposite.op τ) =
            CategoryTheory.CategoryStruct.comp (CategoryTheory.eqToHom h_T₀)
              (CategoryTheory.CategoryStruct.comp
                (F_fg.map ((One_mod.obj).map (Opposite.op τ)))
                (CategoryTheory.eqToHom h_T.symm)) :=
          CategoryTheory.Functor.congr_hom (hU_obj One_mod) (Opposite.op τ)
        calc
          CategoryTheory.CategoryStruct.comp u_unit₀ (((U.obj One_mod).obj).map (Opposite.op τ))
            = CategoryTheory.CategoryStruct.comp
                (CategoryTheory.CategoryStruct.comp (F_fg.map (adjR₀.unit.app R_mod))
                  (CategoryTheory.eqToHom h_T₀.symm))
                (CategoryTheory.CategoryStruct.comp (CategoryTheory.eqToHom h_T₀)
                  (CategoryTheory.CategoryStruct.comp
                    (F_fg.map ((One_mod.obj).map (Opposite.op τ)))
                    (CategoryTheory.eqToHom h_T.symm))) :=
              congrArg (CategoryTheory.CategoryStruct.comp u_unit₀) h_map_τ
          _ = CategoryTheory.CategoryStruct.comp
                (F_fg.map (CategoryTheory.CategoryStruct.comp (adjR₀.unit.app R_mod)
                  ((One_mod.obj).map (Opposite.op τ))))
                (CategoryTheory.eqToHom h_T.symm) := by
              rw [CategoryTheory.Category.assoc,
                ← CategoryTheory.Category.assoc (CategoryTheory.eqToHom h_T₀.symm),
                CategoryTheory.eqToHom_trans, CategoryTheory.eqToHom_refl,
                CategoryTheory.Category.id_comp, ← CategoryTheory.Category.assoc,
                ← F_fg.map_comp]
          _ = CategoryTheory.CategoryStruct.comp
                (F_fg.map (adj_mod.unit.app R_mod))
                (CategoryTheory.eqToHom h_T.symm) := by
              congr 1
              congr 1
              exact hUnitNat J (ModuleCat.{u, u} R) hT hT₀ τ R_mod
          _ = u_unit := hu_unit_eq.symm
      have h_homEquiv_nat : ∀ (A : AddCommGrpCat.{u})
          (𝒢 : CategoryTheory.Sheaf J AddCommGrpCat.{u})
          (f : Quiver.Hom (C_ab.obj A) 𝒢),
          CategoryTheory.CategoryStruct.comp (adjℤ₀.homEquiv A 𝒢 f) ((𝒢.obj).map (Opposite.op τ)) =
            adj_ab.homEquiv A 𝒢 f := by
        intro A 𝒢 f
        have h_nat : CategoryTheory.CategoryStruct.comp
            (f.hom.app (Opposite.op T₀)) ((𝒢.obj).map (Opposite.op τ)) =
            CategoryTheory.CategoryStruct.comp
              (((C_ab.obj A).obj).map (Opposite.op τ)) (f.hom.app (Opposite.op T)) :=
          (f.hom.naturality (Opposite.op τ)).symm
        have h_uA : CategoryTheory.CategoryStruct.comp
            (adjℤ₀.unit.app A) (((C_ab.obj A).obj).map (Opposite.op τ)) =
            adj_ab.unit.app A :=
          hUnitNat J AddCommGrpCat.{u} hT hT₀ τ A
        calc
          CategoryTheory.CategoryStruct.comp (adjℤ₀.homEquiv A 𝒢 f) ((𝒢.obj).map (Opposite.op τ))
            = CategoryTheory.CategoryStruct.comp
                (CategoryTheory.CategoryStruct.comp (adjℤ₀.unit.app A)
                  (f.hom.app (Opposite.op T₀)))
                ((𝒢.obj).map (Opposite.op τ)) := by
              rw [CategoryTheory.Adjunction.homEquiv_unit]
              rfl
