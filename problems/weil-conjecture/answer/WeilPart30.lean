  have hPBC_sec : ∀ (s : S_k ⟶ B.left)
      (hs : CategoryTheory.CategoryStruct.comp s B.hom = CategoryTheory.CategoryStruct.id S_k)
      (q : ℕ),
      WeilIsEtaleSheafPullback s
        (weilEtaleHigherDirectImage p_bar q (weilEtaleTorsionSheaf P (ℓ ^ 1)))
        (weilEtaleHigherDirectImage P1.hom q (weilEtaleTorsionSheaf P1.left (ℓ ^ 1))) := by
    intro s hs q
    have hf_cond : p_bar ≫ B.hom = pr₂ ≫ P1.hom := CategoryTheory.Limits.pullback.condition
    let h_is_comm : CategoryTheory.CategoryStruct.comp (P1.hom ≫ s) B.hom =
        CategoryTheory.CategoryStruct.comp (𝟙 P1.left) P1.hom :=
      (CategoryTheory.Category.assoc _ _ _).trans
        ((congrArg (CategoryTheory.CategoryStruct.comp P1.hom) hs).trans
          ((CategoryTheory.Category.comp_id _).trans (CategoryTheory.Category.id_comp _).symm))
    let i_s : P1.left ⟶ P :=
      CategoryTheory.Limits.pullback.lift (P1.hom ≫ s) (𝟙 P1.left) h_is_comm
    have hi_fst : i_s ≫ p_bar = P1.hom ≫ s := CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hi_snd : i_s ≫ pr₂ = 𝟙 P1.left := CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hpb_is : CategoryTheory.IsPullback i_s P1.hom p_bar s := by
      refine { toCommSq := ⟨hi_fst⟩, isLimit' := ⟨?_⟩ }
      refine CategoryTheory.Limits.PullbackCone.IsLimit.mk hi_fst
        (fun cone => cone.fst ≫ pr₂) (fun cone => ?_) (fun cone => ?_) (fun cone m hm₁ _ => ?_)
      · apply CategoryTheory.Limits.pullback.hom_ext
        · change (cone.fst ≫ pr₂) ≫ i_s ≫ p_bar = cone.fst ≫ p_bar
          calc
            (cone.fst ≫ pr₂) ≫ i_s ≫ p_bar
                = (cone.fst ≫ pr₂) ≫ (P1.hom ≫ s) := congrArg ((cone.fst ≫ pr₂) ≫ ·) hi_fst
            _ = cone.fst ≫ (pr₂ ≫ P1.hom) ≫ s := by simp only [CategoryTheory.Category.assoc]
            _ = (cone.fst ≫ p_bar) ≫ B.hom ≫ s := by
                  rw [← hf_cond]; simp only [CategoryTheory.Category.assoc]
            _ = cone.snd ≫ (s ≫ B.hom) ≫ s := by
                  rw [cone.condition]; simp only [CategoryTheory.Category.assoc]
            _ = cone.snd ≫ s := by rw [hs, CategoryTheory.Category.id_comp]
            _ = cone.fst ≫ p_bar := cone.condition.symm
        · change (cone.fst ≫ pr₂) ≫ i_s ≫ pr₂ = cone.fst ≫ pr₂
          rw [hi_snd, CategoryTheory.Category.comp_id]
      · calc
          (cone.fst ≫ pr₂) ≫ P1.hom
              = cone.fst ≫ (pr₂ ≫ P1.hom) := CategoryTheory.Category.assoc _ _ _
          _ = (cone.fst ≫ p_bar) ≫ B.hom := by rw [← hf_cond, CategoryTheory.Category.assoc]
          _ = cone.snd ≫ (s ≫ B.hom) := by rw [cone.condition, CategoryTheory.Category.assoc]
          _ = cone.snd := by rw [hs, CategoryTheory.Category.comp_id]
      · calc
          m = m ≫ 𝟙 P1.left := (CategoryTheory.Category.comp_id m).symm
          _ = m ≫ (i_s ≫ pr₂) := by rw [hi_snd]
          _ = (m ≫ i_s) ≫ pr₂ := (CategoryTheory.Category.assoc m i_s pr₂).symm
          _ = cone.fst ≫ pr₂ := by rw [hm₁]
    let P_ov : CategoryTheory.Over S_k := CategoryTheory.Over.mk (p_bar ≫ B.hom)
    let Sk_ov : CategoryTheory.Over S_k := CategoryTheory.Over.mk (𝟙 S_k)
    let f_ov : P_ov ⟶ B := CategoryTheory.Over.homMk p_bar rfl
    let g_ov : Sk_ov ⟶ B := CategoryTheory.Over.homMk s hs
    let f'_ov : P1 ⟶ Sk_ov := CategoryTheory.Over.homMk P1.hom (CategoryTheory.Category.comp_id _)
    let g'_ov : P1 ⟶ P_ov := CategoryTheory.Over.homMk i_s (by
      change i_s ≫ (p_bar ≫ B.hom) = P1.hom
      rw [← CategoryTheory.Category.assoc, hi_fst, CategoryTheory.Category.assoc, hs,
        CategoryTheory.Category.comp_id])
    exact hPBC_k P_ov B Sk_ov P1 f_ov g_ov f'_ov g'_ov hProp_pbar hpb_is
      (weilEtaleTorsionSheaf P (ℓ ^ 1)) (weilEtaleTorsionSheaf P1.left (ℓ ^ 1))
      hℓ_FP1 (hConst_pb i_s (AM_of (ℓ ^ 1))) q

