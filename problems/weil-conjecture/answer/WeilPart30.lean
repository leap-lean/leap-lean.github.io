  have hMapExt_nat : ∀ {𝒞 𝒟 : Type (u + 1)}
      [CategoryTheory.Category.{u + 1, u + 1} 𝒞] [CategoryTheory.Abelian 𝒞]
      [CategoryTheory.EnoughInjectives 𝒞] [CategoryTheory.HasExt.{u} 𝒞]
      [CategoryTheory.Category.{u + 1, u + 1} 𝒟] [CategoryTheory.Abelian 𝒟]
      [CategoryTheory.HasExt.{u} 𝒟]
      (F G : 𝒞 ⥤ 𝒟) [F.Additive] [CategoryTheory.Limits.PreservesFiniteLimits F]
      [CategoryTheory.Limits.PreservesFiniteColimits F]
      [G.Additive] [CategoryTheory.Limits.PreservesFiniteLimits G]
      [CategoryTheory.Limits.PreservesFiniteColimits G]
      (τ : F ⟶ G) (d : ℕ) {X Y : 𝒞} (z : CategoryTheory.Abelian.Ext.{u} X Y d),
      (CategoryTheory.Abelian.Ext.mapExactFunctor F z).comp
          (CategoryTheory.Abelian.Ext.mk₀ (τ.app Y)) (Nat.add_zero d) =
        (CategoryTheory.Abelian.Ext.mk₀ (τ.app X)).comp
          (CategoryTheory.Abelian.Ext.mapExactFunctor G z) (Nat.zero_add d) := by
    intro 𝒞 𝒟 _ _ _ _ _ _ _ F G _ _ _ _ _ _ τ d
    induction d with
    | zero =>
      intro X Y z
      let f : X ⟶ Y := CategoryTheory.Abelian.Ext.addEquiv₀ z
      have hz : z = CategoryTheory.Abelian.Ext.mk₀ f :=
        (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply z).symm
      rw [hz, CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, τ.naturality f]
    | succ d ih =>
      intro X Y z
      let I₀ : 𝒞 := CategoryTheory.Injective.under Y
      let j₀ : Y ⟶ I₀ := CategoryTheory.Injective.ι Y
      let Q₁ : 𝒞 := CategoryTheory.Limits.cokernel j₀
      let p₀ : I₀ ⟶ Q₁ := CategoryTheory.Limits.cokernel.π j₀
      have h₀ : j₀ ≫ p₀ = 0 := CategoryTheory.Limits.cokernel.condition j₀
      let S := CategoryTheory.ShortComplex.mk j₀ p₀ h₀
      have hS : S.ShortExact :=
        CategoryTheory.ShortComplex.ShortExact.mk'
          (CategoryTheory.ShortComplex.exact_cokernel j₀) inferInstance inferInstance
      have hz_j : z.comp (CategoryTheory.Abelian.Ext.mk₀ S.f) (Nat.add_zero (d + 1)) = 0 :=
        CategoryTheory.Abelian.Ext.eq_zero_of_injective _
      obtain ⟨w, rfl⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ X hS z hz_j rfl
      let hS_F := hS.map_of_exact F
      let hS_G := hS.map_of_exact G
      let τ_S : S.map F ⟶ S.map G :=
        { τ₁ := τ.app Y
          τ₂ := τ.app I₀
          τ₃ := τ.app Q₁
          comm₁₂ := (τ.naturality j₀).symm
          comm₂₃ := (τ.naturality p₀).symm }
      have h_nat : hS_F.extClass.comp (CategoryTheory.Abelian.Ext.mk₀ (τ.app Y))
            (Nat.add_zero 1) =
          (CategoryTheory.Abelian.Ext.mk₀ (τ.app Q₁)).comp hS_G.extClass (Nat.zero_add 1) :=
        CategoryTheory.ShortComplex.ShortExact.extClass_naturality hS_F hS_G τ_S
      rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp F w hS.extClass rfl,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp G w hS.extClass rfl,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass F hS,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass G hS,
        CategoryTheory.Abelian.Ext.comp_assoc _ hS_F.extClass
          (CategoryTheory.Abelian.Ext.mk₀ (τ.app Y)) rfl (Nat.add_zero 1) rfl,
        h_nat,
        ← CategoryTheory.Abelian.Ext.comp_assoc _ (CategoryTheory.Abelian.Ext.mk₀ (τ.app Q₁))
