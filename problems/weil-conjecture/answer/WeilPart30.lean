theorem weil_gysin_relative_p1_fiberwise_counit_invariance (k : Type u) [Field k]
    [IsAlgClosed k] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (_ : IsUnit (ℓ : k))
    (_ : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (m n q : ℕ),
      1 ≤ n → IsUnit (n : Ω) →
      ∀ (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
        [AlgebraicGeometry.IsProper Z.hom],
        topologicalKrullDim Z.left ≤ (m : WithBot ℕ∞) →
        2 * m < q →
        Subsingleton (weilEtaleTorsionH Z.left n q))
    (_ : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω],
      (ℓ : Ω) ≠ 0 → WeilProperModPrimeBaseChangeHolds Ω ℓ)
    (ι_P1_k : Quiver.Hom (weilGysinAffineSpace k 1) (weilProjectiveSpaceOver k 1).left)
    (s_inf_k : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k))
