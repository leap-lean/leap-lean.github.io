      (_ξ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ S)
      (_M : ModuleCat.{u, u} (ULift.{u, 0} (ZMod m))),
      CategoryTheory.Sheaf S.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m))) :=
    fun ξ M => ⟨mkSkyPre ξ M, hSkyIsSheaf ξ M⟩
  let mkSkyMap : ∀ {S : AlgebraicGeometry.Scheme.{u}} {m : ℕ}
      {Ω : Type u} [Field Ω] [IsAlgClosed Ω]
      (ξ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ S)
      {M₁ M₂ : ModuleCat.{u, u} (ULift.{u, 0} (ZMod m))} (_f : M₁ ⟶ M₂),
      mkSkySheaf ξ M₁ ⟶ mkSkySheaf ξ M₂ :=
    fun {S m Ω} _ _ ξ {M₁ M₂} f =>
      ⟨{ app := fun opW =>
           let LiftW :=
             { δ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ (Opposite.unop opW).left //
                 δ ≫ (Opposite.unop opW).hom = ξ }
           ModuleCat.ofHom
             (show (LiftW → ↥M₁) →ₗ[ULift.{u, 0} (ZMod m)] (LiftW → ↥M₂) from
               { toFun := fun sec δ => f.hom (sec δ)
                 map_add' := fun a b => funext fun δ => map_add f.hom (a δ) (b δ)
                 map_smul' := fun r a => funext fun δ => map_smul f.hom r (a δ) })
         naturality := fun _ _ _ => by
           apply ModuleCat.hom_ext
           apply LinearMap.ext
           intro _
           rfl }⟩
  have mkSkyHom_eq_zero : ∀ {S : AlgebraicGeometry.Scheme.{u}} {m : ℕ}
      {Ω : Type u} [Field Ω] [IsAlgClosed Ω]
      {ξ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ S}
      {M : ModuleCat.{u, u} (ULift.{u, 0} (ZMod m))}
      {ℱ : CategoryTheory.Sheaf S.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m)))}
      (p : ℱ ⟶ mkSkySheaf ξ M)
      (_h : ∀ (W : S.Etale) (s : ↥(ℱ.obj.obj (Opposite.op W)))
        (δ : { d : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ W.left // d ≫ W.hom = ξ }),
        (show ({ d : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ W.left // d ≫ W.hom = ξ } → ↥M)
          from (p.hom.app (Opposite.op W)).hom s) δ = 0),
      p = 0 :=
    fun {S m Ω} _ _ {ξ M ℱ} p h => by
      apply CategoryTheory.Sheaf.hom_ext
      apply CategoryTheory.NatTrans.ext
      funext opW
      let W := Opposite.unop opW
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      intro s
      change (show ({ d : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ W.left // d ≫ W.hom = ξ } → ↥M)
        from (p.hom.app (Opposite.op W)).hom s) = 0
      exact funext (h W s)
  have hZeroOfHomSkyZero : ∀ {S : AlgebraicGeometry.Scheme.{u}} {m : ℕ}
      {ℱ₁ ℱ₂ : CategoryTheory.Sheaf S.smallEtaleTopology (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m)))}
      (u : ℱ₁ ⟶ ℱ₂)
      (_hZero : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (ξ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ S)
        (M : ModuleCat.{u, u} (ULift.{u, 0} (ZMod m)))
        (k : ℱ₂ ⟶ mkSkySheaf ξ M), u ≫ k = 0),
      u = 0 :=
    fun {S m ℱ₁ ℱ₂} u hZero => by
      classical
      let R := ULift.{u, 0} (ZMod m)
      let R_mod := ModuleCat.of R R
      let etaleProp : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
        @AlgebraicGeometry.Etale
      have _ : CategoryTheory.MorphismProperty.IsStableUnderComposition etaleProp :=
        CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
      apply CategoryTheory.Sheaf.hom_ext
      apply CategoryTheory.NatTrans.ext
      funext opW₀
      let W₀ : S.Etale := Opposite.unop opW₀
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      intro s₀
      set x₂ : ↥(ℱ₂.obj.obj (Opposite.op W₀)) := (u.hom.app (Opposite.op W₀)).hom s₀
      change x₂ = 0
      have hLocZero : ∀ x₀ : ↥W₀.left, ∃ (W' : S.Etale) (v : W' ⟶ W₀) (w' : ↥W'.left),
          AlgebraicGeometry.Etale v.left ∧ v.left.base w' = x₀ ∧
          (ℱ₂.obj.map v.op).hom x₂ = 0 := by
        intro x₀
        let κ : Type u := ↥(W₀.left.residueField x₀)
        let Ω : Type u := AlgebraicClosure κ
        let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
        let δ₀ : S_Ω ⟶ W₀.left :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap κ Ω)) ≫
            W₀.left.fromSpecResidueField x₀
        have hδ₀_pt : δ₀.base (⊥ : PrimeSpectrum Ω) = x₀ :=
          AlgebraicGeometry.Scheme.fromSpecResidueField_apply x₀ _
        let ξ : S_Ω ⟶ S := δ₀ ≫ W₀.hom
        let M_aff : Type u := CategoryTheory.SmallModel S.AffineEtale
        let eq_aff := CategoryTheory.equivSmallModel S.AffineEtale
        let embS : M_aff → S.Etale := fun m₀ =>
          let X := eq_aff.inverse.obj m₀
          CategoryTheory.MorphismProperty.Over.mk ⊤ X.hom X.prop
        let AffCat : Type u := CategoryTheory.InducedCategory S.Etale embS
        let G_aff : AffCat ⥤ S.Etale := CategoryTheory.inducedFunctor embS
        let LiftF : AffCat ⥤ Type u :=
          { obj := fun d =>
              { δ : S_Ω ⟶ (G_aff.obj d).left // δ ≫ (G_aff.obj d).hom = ξ }
            map := fun {_ _} f => TypeCat.ofHom fun δ₁ =>
              ⟨δ₁.1 ≫ (G_aff.map f).left,
                (CategoryTheory.Category.assoc δ₁.1 (G_aff.map f).left _).trans
                  ((congrArg (δ₁.1 ≫ ·)
                    (CategoryTheory.MorphismProperty.Over.w (G_aff.map f))).trans δ₁.2)⟩
            map_id := fun _ => by
              ext δ
              exact CategoryTheory.Category.comp_id δ.1
            map_comp := fun _ _ => by
              ext δ
              exact (CategoryTheory.Category.assoc δ.1 _ _).symm }
        have hShrink : ∀ (W : S.Etale) (δ : S_Ω ⟶ W.left), δ ≫ W.hom = ξ →
            ∃ (d : AffCat) (v : G_aff.obj d ⟶ W) (δ_d : LiftF.obj d),
              δ_d.1 ≫ v.left = δ := by
          intro W δ hδ
          let y := δ.base (⊥ : PrimeSpectrum Ω)
          obtain ⟨V, hV, hyV, _⟩ :=
            AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := y) (U := (⊤ : W.left.Opens)) trivial
          let R_V : CommRingCat.{u} := W.left.presheaf.obj (Opposite.op V)
          let φ_V : AlgebraicGeometry.Spec R_V ⟶ W.left := hV.fromSpec
          have _ : AlgebraicGeometry.IsOpenImmersion φ_V := inferInstance
          have _ : AlgebraicGeometry.Etale W.hom := W.prop
          have hRange_δ : Set.range δ.base ⊆ Set.range φ_V.base := by
            rintro _ ⟨pt, rfl⟩
            have hpt : pt = (⊥ : PrimeSpectrum Ω) := Subsingleton.elim _ _
            rw [hpt, hV.range_fromSpec]
            exact hyV
          let δ_spec : S_Ω ⟶ AlgebraicGeometry.Spec R_V :=
            AlgebraicGeometry.IsOpenImmersion.lift φ_V δ hRange_δ
          have hδ_spec : δ_spec ≫ φ_V = δ :=
            AlgebraicGeometry.IsOpenImmersion.lift_fac φ_V δ hRange_δ
          let g_aff : AlgebraicGeometry.Scheme.Spec.obj (Opposite.op R_V) ⟶ S := φ_V ≫ W.hom
          have hEt_comp : AlgebraicGeometry.Etale g_aff :=
            inferInstanceAs (AlgebraicGeometry.Etale (φ_V ≫ W.hom))
          let A_y : S.AffineEtale :=
            CategoryTheory.MorphismProperty.CostructuredArrow.mk
              (P := @AlgebraicGeometry.Etale) (F := AlgebraicGeometry.Scheme.Spec) ⊤ g_aff hEt_comp
          let d : AffCat := eq_aff.functor.obj A_y
          let e_aff : A_y ≅ eq_aff.inverse.obj d := eq_aff.unitIso.app A_y
          let e_op : Opposite.op R_V ≅ (eq_aff.inverse.obj d).left :=
            { hom := e_aff.hom.left
              inv := e_aff.inv.left
              hom_inv_id := congrArg (fun k => k.left) e_aff.hom_inv_id
              inv_hom_id := congrArg (fun k => k.left) e_aff.inv_hom_id }
          let e_sch : AlgebraicGeometry.Scheme.Spec.obj (Opposite.op R_V) ≅
              (G_aff.obj d).left :=
            AlgebraicGeometry.Scheme.Spec.mapIso e_op
          let v_left : (G_aff.obj d).left ⟶ W.left := e_sch.inv ≫ φ_V
          have hv_w : v_left ≫ W.hom = (G_aff.obj d).hom :=
            (CategoryTheory.Category.assoc e_sch.inv φ_V W.hom).trans
              (e_aff.inv.w.trans (CategoryTheory.Category.comp_id _))
          let v : G_aff.obj d ⟶ W := CategoryTheory.MorphismProperty.Over.homMk v_left hv_w
          let δ_raw : S_Ω ⟶ (G_aff.obj d).left := δ_spec ≫ e_sch.hom
          have hδ_v : δ_raw ≫ v_left = δ :=
            (CategoryTheory.Category.assoc δ_spec e_sch.hom v_left).trans
              ((congrArg (δ_spec ≫ ·) (e_sch.hom_inv_id_assoc φ_V)).trans hδ_spec)
          refine ⟨d, v, ⟨δ_raw, ?_⟩, hδ_v⟩
          exact (congrArg (δ_raw ≫ ·) hv_w.symm).trans
            ((CategoryTheory.Category.assoc δ_raw v_left W.hom).symm.trans
              ((congrArg (· ≫ W.hom) hδ_v).trans hδ))
        let J_idx := (LiftF.Elements)ᵒᵖ
        have _ : CategoryTheory.IsFiltered J_idx := by
          refine { cocone_objs := ?_, cocone_maps := ?_, nonempty := ?_ }
          · intro j₁ j₂
            let d₁ : AffCat := j₁.unop.1
            let d₂ : AffCat := j₂.unop.1
            let δ₁ := j₁.unop.2
            let δ₂ := j₂.unop.2
            have _ : AlgebraicGeometry.Etale (G_aff.obj d₁).hom := (G_aff.obj d₁).prop
            have _ : AlgebraicGeometry.Etale (G_aff.obj d₂).hom := (G_aff.obj d₂).prop
            let π₁ := CategoryTheory.Limits.pullback.fst (G_aff.obj d₁).hom (G_aff.obj d₂).hom
            let π₂ := CategoryTheory.Limits.pullback.snd (G_aff.obj d₁).hom (G_aff.obj d₂).hom
            have _ : AlgebraicGeometry.Etale π₂ := inferInstance
            let W₁₂ : S.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤
