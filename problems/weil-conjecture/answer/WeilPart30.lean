    let π₂ : Quiver.Hom F_box S_k := CategoryTheory.Limits.pullback.snd v_box orig
    have : AlgebraicGeometry.IsClosedImmersion π₁ := inferInstance
    let σ_box : Quiver.Hom U₁.toScheme F_box :=
      CategoryTheory.Limits.pullback.lift γ_box (U₁.ι ≫ X.hom) hγ_v_box
    have hσ_π₁ : σ_box ≫ π₁ = γ_box :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hσ_π₂ : σ_box ≫ π₂ = U₁.ι ≫ X.hom :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    let q₁ : Quiver.Hom F_box U₁.toScheme := π₁ ≫ p₁_box
    have hσ_q₁ : σ_box ≫ q₁ = 𝟙 U₁.toScheme := by
      change σ_box ≫ (π₁ ≫ p₁_box) = 𝟙 U₁.toScheme
      rw [← CategoryTheory.Category.assoc, hσ_π₁, hγ_p₁_box]
    have hEt_q₁_u₁ : AlgebraicGeometry.Etale (q₁ ≫ u₁) := by
      have hpb_F : CategoryTheory.IsPullback π₁ π₂
          (Ψ_box ≫ weilGysinAffineProjRight k d d (2 * d) (Nat.two_mul d).symm) orig := by
        rw [hΨ_box_right]
        exact CategoryTheory.IsPullback.of_hasPullback v_box orig
      have sq_top := CategoryTheory.IsPullback.of_bot' hpb_F hPb_axis
      let r_axis := hPb_axis.lift (π₁ ≫ Ψ_box) π₂ hpb_F.w
      have hr_et : AlgebraicGeometry.Etale r_axis :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback sq_top hΨ_box_et
      have hr_eq : r_axis = q₁ ≫ u₁ := by
        have hlft : r_axis ≫ weilGysinAffineLeftAxis k d d (2 * d) (Nat.two_mul d).symm =
            π₁ ≫ Ψ_box := hPb_axis.lift_fst (π₁ ≫ Ψ_box) π₂ hpb_F.w
        have h1 : r_axis = (π₁ ≫ Ψ_box) ≫
            weilGysinAffineProjLeft k d d (2 * d) (Nat.two_mul d).symm := by
          rw [← hlft, CategoryTheory.Category.assoc, hAxis_projLeft,
            CategoryTheory.Category.comp_id]
        have h2 : (π₁ ≫ Ψ_box) ≫
            weilGysinAffineProjLeft k d d (2 * d) (Nat.two_mul d).symm = q₁ ≫ u₁ := by
          dsimp only [q₁]
          rw [CategoryTheory.Category.assoc, hΨ_box_left, CategoryTheory.Category.assoc]
          rfl
        exact h1.trans h2
      rwa [← hr_eq]
    have : AlgebraicGeometry.Etale (q₁ ≫ u₁) := hEt_q₁_u₁
    have : AlgebraicGeometry.FormallyUnramified q₁ :=
      AlgebraicGeometry.FormallyUnramified.of_comp q₁ u₁
    have : AlgebraicGeometry.LocallyOfFiniteType q₁ :=
      AlgebraicGeometry.locallyOfFiniteType_of_comp q₁ u₁
    have : AlgebraicGeometry.IsOpenImmersion (CategoryTheory.Limits.pullback.diagonal q₁) :=
      AlgebraicGeometry.FormallyUnramified.isOpenImmersion_diagonal q₁
    let g_ret : Quiver.Hom F_box (CategoryTheory.Limits.pullback q₁ q₁) :=
      CategoryTheory.Limits.pullback.lift (𝟙 F_box) (q₁ ≫ σ_box) (by
        rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc, hσ_q₁,
          CategoryTheory.Category.comp_id])
    have hσ_diag_comm : σ_box ≫ CategoryTheory.Limits.pullback.diagonal q₁ = σ_box ≫ g_ret := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.diagonal_fst,
          CategoryTheory.Category.comp_id, CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.comp_id]
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.diagonal_snd,
          CategoryTheory.Category.comp_id, CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.lift_snd, ← CategoryTheory.Category.assoc, hσ_q₁,
          CategoryTheory.Category.id_comp]
    have hpb_σ : CategoryTheory.IsPullback σ_box σ_box
        (CategoryTheory.Limits.pullback.diagonal q₁) g_ret := by
      refine CategoryTheory.IsPullback.of_isLimit
        (CategoryTheory.Limits.PullbackCone.IsLimit.mk hσ_diag_comm
          (fun cone => cone.snd ≫ q₁)
          (fun cone => by
            have h₂ : cone.fst ≫ (CategoryTheory.Limits.pullback.diagonal q₁ ≫
                CategoryTheory.Limits.pullback.snd q₁ q₁) =
              cone.snd ≫ (g_ret ≫ CategoryTheory.Limits.pullback.snd q₁ q₁) := by
              rw [← CategoryTheory.Category.assoc, cone.condition, CategoryTheory.Category.assoc]
            rw [CategoryTheory.Limits.pullback.diagonal_snd, CategoryTheory.Category.comp_id,
              CategoryTheory.Limits.pullback.lift_snd, ← CategoryTheory.Category.assoc] at h₂
            exact h₂.symm)
          (fun cone => by
            have h₁ : cone.fst ≫ (CategoryTheory.Limits.pullback.diagonal q₁ ≫
                CategoryTheory.Limits.pullback.fst q₁ q₁) =
              cone.snd ≫ (g_ret ≫ CategoryTheory.Limits.pullback.fst q₁ q₁) := by
              rw [← CategoryTheory.Category.assoc, cone.condition, CategoryTheory.Category.assoc]
            rw [CategoryTheory.Limits.pullback.diagonal_fst, CategoryTheory.Category.comp_id,
              CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.comp_id] at h₁
            have h₂ : cone.fst ≫ (CategoryTheory.Limits.pullback.diagonal q₁ ≫
                CategoryTheory.Limits.pullback.snd q₁ q₁) =
              cone.snd ≫ (g_ret ≫ CategoryTheory.Limits.pullback.snd q₁ q₁) := by
              rw [← CategoryTheory.Category.assoc, cone.condition, CategoryTheory.Category.assoc]
            rw [CategoryTheory.Limits.pullback.diagonal_snd, CategoryTheory.Category.comp_id,
              CategoryTheory.Limits.pullback.lift_snd, ← CategoryTheory.Category.assoc] at h₂
            exact h₂.symm.trans h₁)
          (fun cone m _ hm₂ => by
            calc
              m = m ≫ 𝟙 U₁.toScheme := (CategoryTheory.Category.comp_id m).symm
              _ = m ≫ (σ_box ≫ q₁) := by rw [hσ_q₁]
              _ = (m ≫ σ_box) ≫ q₁ := (CategoryTheory.Category.assoc _ _ _).symm
              _ = cone.snd ≫ q₁ := by rw [hm₂]))
    have : AlgebraicGeometry.IsOpenImmersion σ_box :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_σ
        (inferInstance : AlgebraicGeometry.IsOpenImmersion (CategoryTheory.Limits.pullback.diagonal q₁))
    let K_spur : Set ↥F_box := (Set.range σ_box.base)ᶜ
    have hK_closed : IsClosed K_spur := σ_box.isOpenEmbedding.isOpen_range.isClosed_compl
    let C_spur : Set ↥W_box := π₁.base '' K_spur
    have hC_closed : IsClosed C_spur := π₁.isClosedEmbedding.isClosedMap K_spur hK_closed
    let V_set : Set ↥P := W_box.ι.base '' C_spurᶜ
    have hV_open : IsOpen V_set :=
      W_box.ι.isOpenEmbedding.isOpenMap C_spurᶜ hC_closed.isOpen_compl
    let V : P.Opens := ⟨V_set, hV_open⟩
    have hle_V : V ≤ W_box := by
      rintro _ ⟨z, _, rfl⟩
      exact z.2
    let j_V : Quiver.Hom V.toScheme W_box.toScheme := P.homOfLE hle_V
    have hjV_mem : ∀ z : ↥W_box, z ∈ j_V.opensRange ↔ z ∉ C_spur := by
      intro z
      change z ∈ Set.range j_V.base ↔ z ∉ C_spur
      constructor
      · rintro ⟨w, rfl⟩
        have hw : (j_V ≫ W_box.ι).base w = V.ι.base w := by rw [P.homOfLE_ι hle_V]
        have hmem : W_box.ι.base (j_V.base w) ∈ V_set := by
          change (j_V ≫ W_box.ι).base w ∈ V_set
          rw [hw]
          exact w.2
        rcases hmem with ⟨z', hz', heq⟩
        have hzz' : z' = j_V.base w := W_box.ι.isOpenEmbedding.injective heq
        rwa [← hzz']
      · intro hz
        have hmem : W_box.ι.base z ∈ V := ⟨z, hz, rfl⟩
        refine ⟨⟨z.1, hmem⟩, ?_⟩
        apply W_box.ι.isOpenEmbedding.injective
        change (j_V ≫ W_box.ι).base ⟨z.1, hmem⟩ = W_box.ι.base z
        rw [P.homOfLE_ι hle_V]
        rfl
    have hpre_V : Γ_φ.base ⁻¹' (V : Set P) = (U₁ : Set X.left) := by
      ext y
      constructor
      · intro hy
        have hy_box : y ∈ Γ_φ.base ⁻¹' (W_box : Set P) := hle_V hy
        rwa [hpre_box] at hy_box
      · intro hy
        let y' : ↥U₁ := ⟨y, hy⟩
        have hΓy : Γ_φ.base y = W_box.ι.base (γ_box.base y') := by
          change (U₁.ι ≫ Γ_φ).base y' = (γ_box ≫ W_box.ι).base y'
          rw [hγ_box_ι]
        change Γ_φ.base y ∈ V_set
        rw [hΓy]
        refine ⟨γ_box.base y', ?_, rfl⟩
        rintro ⟨f, hf_not, hf_eq⟩
        have hπ_σ : π₁.base (σ_box.base y') = γ_box.base y' :=
          congrArg (fun h => h.base y') hσ_π₁
        rw [← hπ_σ] at hf_eq
        have hf_σ : f = σ_box.base y' := π₁.isClosedEmbedding.injective hf_eq
        exact hf_not ⟨y', hf_σ.symm⟩
    have hγ_range : Set.range (U₁.ι ≫ Γ_φ).base ⊆ Set.range V.ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rintro _ ⟨y, rfl⟩
      have hy : U₁.ι.base y ∈ Γ_φ.base ⁻¹' (V : Set P) := by
        rw [hpre_V]; exact y.2
      exact hy
    let γ : Quiver.Hom U₁.toScheme V.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift V.ι (U₁.ι ≫ Γ_φ) hγ_range
    have hγ_ι : γ ≫ V.ι = U₁.ι ≫ Γ_φ :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac V.ι (U₁.ι ≫ Γ_φ) hγ_range
    have hγ_jV : γ ≫ j_V = γ_box := by
      apply (cancel_mono W_box.ι).mp
      rw [CategoryTheory.Category.assoc, P.homOfLE_ι hle_V, hγ_ι, hγ_box_ι]
    have hpb_γ_σ : CategoryTheory.IsPullback γ σ_box j_V π₁ := by
      refine AlgebraicGeometry.IsOpenImmersion.isPullback γ σ_box j_V π₁
        (by rw [hσ_π₁, hγ_jV]) ?_
      ext f
      change π₁.base f ∈ j_V.opensRange ↔ f ∈ σ_box.opensRange
      refine (hjV_mem (π₁.base f)).trans ?_
      change π₁.base f ∉ π₁.base '' (Set.range σ_box.base)ᶜ ↔ f ∈ Set.range σ_box.base
      rw [π₁.isClosedEmbedding.injective.mem_set_image]
      exact not_not
    let p₁_V : Quiver.Hom V.toScheme U₁.toScheme := j_V ≫ p₁_box
    let v : Quiver.Hom V.toScheme (weilGysinAffineSpace k d) := j_V ≫ v_box
    let Ψ : Quiver.Hom V.toScheme (weilGysinAffineSpace k (2 * d)) := j_V ≫ Ψ_box
    have hpb_v : CategoryTheory.IsPullback γ (U₁.ι ≫ X.hom) v orig := by
      have hpasted := CategoryTheory.IsPullback.paste_vert hpb_γ_σ
        (CategoryTheory.IsPullback.of_hasPullback v_box orig)
      rw [hσ_π₂] at hpasted
      exact hpasted
    have hp₁_V_ι : p₁_V ≫ U₁.ι = V.ι ≫ p₁ := by
      dsimp [p₁_V]
      rw [CategoryTheory.Category.assoc, hp₁_box_ι, ← CategoryTheory.Category.assoc,
        P.homOfLE_ι hle_V]
    have : AlgebraicGeometry.Etale Ψ_box := hΨ_box_et
    have hΨ_et : AlgebraicGeometry.Etale Ψ := inferInstance
    have hΨ_left :
        Ψ ≫ weilGysinAffineProjLeft k d d (2 * d) (Nat.two_mul d).symm = p₁_V ≫ u₁ := by
      dsimp only [Ψ, p₁_V]
      rw [CategoryTheory.Category.assoc, hΨ_box_left, CategoryTheory.Category.assoc]
      rfl
    have hΨ_right :
        Ψ ≫ weilGysinAffineProjRight k d d (2 * d) (Nat.two_mul d).symm = v := by
      dsimp [Ψ, v]
      rw [CategoryTheory.Category.assoc, hΨ_box_right]
    have hv_sm : AlgebraicGeometry.SmoothOfRelativeDimension d v := by
      have : AlgebraicGeometry.Etale Ψ := hΨ_et
      have : AlgebraicGeometry.SmoothOfRelativeDimension 0 Ψ := inferInstance
      have : AlgebraicGeometry.SmoothOfRelativeDimension d
          (weilGysinAffineProjRight k d d (2 * d) (Nat.two_mul d).symm) := hProjRight_sm
      have hcomp : AlgebraicGeometry.SmoothOfRelativeDimension (0 + d)
          (Ψ ≫ weilGysinAffineProjRight k d d (2 * d) (Nat.two_mul d).symm) := inferInstance
      rwa [Nat.zero_add, hΨ_right] at hcomp
    have hv_str : v ≫ weilGysinAffineStruct k d = V.ι ≫ (p₁ ≫ X.hom) := by
      dsimp [v]
      rw [CategoryTheory.Category.assoc, hv_box_str, ← CategoryTheory.Category.assoc,
        P.homOfLE_ι hle_V]
    have hΨ_str : Ψ ≫ weilGysinAffineStruct k (2 * d) = V.ι ≫ (p₁ ≫ X.hom) := by
      dsimp [Ψ]
      rw [CategoryTheory.Category.assoc, hΨ_box_str, ← CategoryTheory.Category.assoc,
        P.homOfLE_ι hle_V]
    have hγ_Ψ :
        γ ≫ Ψ = u₁ ≫ weilGysinAffineLeftAxis k d d (2 * d) (Nat.two_mul d).symm := by
      dsimp only [Ψ]
      rw [← CategoryTheory.Category.assoc, hγ_jV, hγ_Ψ_box]
    have hTub : WeilGysinIsTubularGraphChart d X Γ_φ U₁ V γ p₁_V u₁ v Ψ :=
      ⟨hpre_V, hγ_ι, hp₁_V_ι, hu₁_et, hg₁_str, hv_sm, hv_str,
        hΨ_et, hΨ_str, hpb_v, hΨ_left, hΨ_right, hγ_Ψ⟩
    refine ⟨V, γ, p₁_V, v, Ψ, hTub, ?_⟩
    
    intro hle₁₂ U' hle' δ hδ_ι
    let ι' := (X.left.presheaf.map (CategoryTheory.homOfLE (hle'.trans hle₁₂)).op).hom
    let ψ' := (AlgebraicGeometry.Scheme.Hom.appLE φ U₂ U' (hle'.trans he_φ)).hom
    let A' : Type u := ↑(X.left.presheaf.obj (Opposite.op U'))
    let r₁ : A₁ →+* A' := (X.left.presheaf.map (CategoryTheory.homOfLE hle').op).hom
    let ρ₁₂ : A₂ →+* A₁ := (X.left.presheaf.map (CategoryTheory.homOfLE hle₁₂).op).hom
    have hδ_p₁ : (δ ≫ j_V) ≫ p₁_box = X.left.homOfLE hle' := by
      apply (cancel_mono U₁.ι).mp
      rw [CategoryTheory.Category.assoc, hp₁_box_ι, ← CategoryTheory.Category.assoc,
        CategoryTheory.Category.assoc δ j_V W_box.ι, P.homOfLE_ι hle_V,
        hδ_ι, CategoryTheory.Category.assoc,
        CategoryTheory.Limits.pullback.diagonal_fst, CategoryTheory.Category.comp_id,
        X.left.homOfLE_ι hle']
    have hδ_p₂ : (δ ≫ j_V) ≫ p₂_box = X.left.homOfLE (hle'.trans hle₁₂) := by
      apply (cancel_mono U₂.ι).mp
      rw [CategoryTheory.Category.assoc, hp₂_box_ι, ← CategoryTheory.Category.assoc,
        CategoryTheory.Category.assoc δ j_V W_box.ι, P.homOfLE_ι hle_V,
        hδ_ι, CategoryTheory.Category.assoc,
        CategoryTheory.Limits.pullback.diagonal_snd, CategoryTheory.Category.comp_id,
        X.left.homOfLE_ι (hle'.trans hle₁₂)]
    have hδ_spec₁ : ((δ ≫ j_V) ≫ p₁_box) ≫ U₁.toSpecΓ =
        U'.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom r₁) := by
      rw [hδ_p₁]
      exact (AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_presheaf_map U' U₁ hle').symm
    have hδ_spec₂ : ((δ ≫ j_V) ≫ p₂_box) ≫ U₂.toSpecΓ =
        U'.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι') := by
      rw [hδ_p₂]
      exact (AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_presheaf_map U' U₂
        (hle'.trans hle₁₂)).symm
    have hι'_eq : ι' = r₁.comp ρ₁₂ := by
      have hmap := X.left.presheaf.map_comp
        (CategoryTheory.homOfLE hle₁₂).op (CategoryTheory.homOfLE hle').op
      have hhom : (CategoryTheory.homOfLE hle₁₂).op ≫ (CategoryTheory.homOfLE hle').op =
          (CategoryTheory.homOfLE (hle'.trans hle₁₂)).op := rfl
      rw [hhom] at hmap
      ext a₂
      exact congrArg (fun f => f.hom a₂) hmap
    have hρ₁₂_k : ρ₁₂.comp (algebraMap k A₂) = algebraMap k A₁ := by
      have hspec : U₁.toSpecΓ ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ρ₁₂.comp (algebraMap k A₂))) =
        U₁.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A₁)) := by
        rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp,
          ← CategoryTheory.Category.assoc]
        change (U₁.toSpecΓ ≫
            AlgebraicGeometry.Spec.map (X.left.presheaf.map (CategoryTheory.homOfLE hle₁₂).op)) ≫ _ = _
        rw [AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_presheaf_map U₁ U₂ hle₁₂,
          CategoryTheory.Category.assoc, hA₂, ← CategoryTheory.Category.assoc,
          X.left.homOfLE_ι hle₁₂, hA₁]
      have hmono := (cancel_epi U₁.toSpecΓ).mp hspec
      have hcat := AlgebraicGeometry.Spec.map_injective hmono
      ext c
      exact congrArg (fun f => f.hom c) hcat
    have hr₁_k : r₁.comp (algebraMap k A₁) = ι'.comp (algebraMap k A₂) := by
      rw [hι'_eq, RingHom.comp_assoc, hρ₁₂_k]
    letI : Algebra k A' := (ι'.comp (algebraMap k A₂)).toAlgebra
    let r₁_alg : A₁ →ₐ[k] A' :=
      { r₁ with commutes' := fun c => RingHom.congr_fun hr₁_k c }
    let ι'_alg : A₂ →ₐ[k] A' :=
      { ι' with commutes' := fun _ => rfl }
    let μ_Δ : TensorProduct k A₁ A₂ →+* A' :=
      (Algebra.TensorProduct.lift r₁_alg ι'_alg (fun _ _ => mul_comm _ _)).toRingHom
    have hμ_Δ_tmul : ∀ (a₁ : A₁) (a₂ : A₂), μ_Δ (a₁ ⊗ₜ[k] a₂) = r₁ a₁ * ι' a₂ :=
      fun _ _ => rfl
    have hδ_e_box : (δ ≫ j_V) ≫ e_box.hom =
        U'.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom μ_Δ) := by
      refine he_box_eval U'.toSpecΓ (δ ≫ j_V) r₁ ι' μ_Δ hδ_spec₁ hδ_spec₂ ?_ ?_
      · ext a₁; rw [RingHom.comp_apply, Algebra.TensorProduct.includeLeftRingHom_apply,
          hμ_Δ_tmul, map_one, mul_one]
      · ext a₂; change μ_Δ ((1 : A₁) ⊗ₜ[k] a₂) = ι' a₂
        rw [hμ_Δ_tmul, map_one, one_mul]
    have hr₁_ψ : r₁.comp ψ_ring = ψ' := by
      have happ := AlgebraicGeometry.Scheme.Hom.appLE_map φ he_φ (CategoryTheory.homOfLE hle').op
      ext a₂
      exact congrArg (fun f => f.hom a₂) happ
    have hδ_v : δ ≫ v =
        U'.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (μ_Δ.comp G_v.toRingHom)) := by
      dsimp [v, v_box, weilGysinAffineSpace]
      rw [← CategoryTheory.Category.assoc δ j_V _, ← CategoryTheory.Category.assoc (δ ≫ j_V) _ _,
        hδ_e_box, CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
    rw [hδ_v]
    congr 3
    apply MvPolynomial.ringHom_ext
    · intro c
      simp only [RingHom.comp_apply, G_v, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
        MvPolynomial.aeval_C, MvPolynomial.eval₂Hom_C]
      have halg : algebraMap k (TensorProduct k A₁ A₂) c =
          (1 : A₁) ⊗ₜ[k] (algebraMap k A₂ c) :=
        (Algebra.TensorProduct.includeRight.commutes c).symm
      rw [halg, hμ_Δ_tmul, map_one, one_mul]
      rfl
    · intro j
      simp only [RingHom.comp_apply, G_v, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
        MvPolynomial.aeval_X, map_sub, hμ_Δ_tmul, map_one, one_mul, mul_one,
        MvPolynomial.eval₂Hom_X']
      have hψ_j : r₁ (ψ (g₂ (MvPolynomial.X j))) = ψ' (g₂ (MvPolynomial.X j)) :=
        RingHom.congr_fun hr₁_ψ (g₂ (MvPolynomial.X j))
      rw [hψ_j]

theorem weil_gysin_kaehler_jacobi_zariski_transversal_etale (k : Type u) [Field k]
    (d : ℕ) (A A' : Type u) [CommRing A] [CommRing A']
    (f_k : k →+* A)
    (g : MvPolynomial (Fin d) k →+* A)
    (ι ψ : A →+* A')
    (p : PrimeSpectrum A')
    (hg_k : g.comp MvPolynomial.C = f_k)
    (hg_et : g.Etale)
    (hι_et : ι.Etale)
    (hψ_k : ψ.comp f_k = ι.comp f_k)
    (hB_et : ((Ideal.Quotient.mk (Ideal.span (Set.range (fun a : A => ι a - ψ a)))).comp
      (ι.comp f_k)).Etale)
    (hp : Ideal.span (Set.range (fun a : A => ι a - ψ a)) ≤ p.asIdeal) :
    ∃ f_det : A',
      f_det ∉ p.asIdeal ∧
      ((algebraMap A' (Localization.Away f_det)).comp
        (MvPolynomial.eval₂Hom (ι.comp f_k)
          (fun j : Fin d => ι (g (MvPolynomial.X j)) - ψ (g (MvPolynomial.X j))))).Etale :=
by
  classical
  let P_d := MvPolynomial (Fin d) k
  let b_P : Module.Basis (Fin d) P_d Ω[P_d⁄k] := KaehlerDifferential.mvPolynomialBasis k (Fin d)
  let _ : Algebra k A := f_k.toAlgebra
  let _ : Algebra P_d A := g.toAlgebra
  have h_tower_A : (algebraMap P_d A).comp (algebraMap k P_d) = algebraMap k A := by
    change g.comp (algebraMap k (MvPolynomial (Fin d) k)) = f_k
    rw [MvPolynomial.algebraMap_eq, hg_k]
  have : IsScalarTower k P_d A := IsScalarTower.of_algebraMap_eq' h_tower_A.symm
  have : Algebra.Etale P_d A := RingHom.etale_algebraMap.mp hg_et
  let e_A : TensorProduct P_d A Ω[P_d⁄k] ≃ₗ[A] Ω[A⁄k] :=
    KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale k P_d A
  let b_A : Module.Basis (Fin d) A Ω[A⁄k] := (b_P.baseChange A).map e_A
  have hb_A : ∀ s : Fin d, b_A s = KaehlerDifferential.D k A (g (MvPolynomial.X s)) := by
    intro s
    dsimp only [b_A, e_A, b_P]
    rw [Module.Basis.map_apply, Module.Basis.baseChange_apply,
      KaehlerDifferential.mvPolynomialBasis_apply,
      KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale_apply,
      KaehlerDifferential.mapBaseChange_tmul, one_smul,
      KaehlerDifferential.map_D]
    rfl
  let _ : Algebra k A' := (ι.comp f_k).toAlgebra
  obtain ⟨b_A', _, hSm_A', hFP_A'⟩ :
      ∃ b_A' : Module.Basis (Fin d) A' Ω[A'⁄k],
        (∀ r : Fin d, b_A' r = KaehlerDifferential.D k A' (ι (g (MvPolynomial.X r)))) ∧
        Algebra.FormallySmooth k A' ∧
        Algebra.FinitePresentation k A' := by
    have hιg_et : (ι.comp g).Etale := RingHom.Etale.stableUnderComposition g ι hg_et hι_et
    let _ : Algebra P_d A' := (ι.comp g).toAlgebra
    have h_tower_A' : (algebraMap P_d A').comp (algebraMap k P_d) = algebraMap k A' := by
      change (ι.comp g).comp (algebraMap k (MvPolynomial (Fin d) k)) = ι.comp f_k
      rw [MvPolynomial.algebraMap_eq, RingHom.comp_assoc, hg_k]
    have : IsScalarTower k P_d A' := IsScalarTower.of_algebraMap_eq' h_tower_A'.symm
    have : Algebra.Etale P_d A' := RingHom.etale_algebraMap.mp hιg_et
    let e_A' : TensorProduct P_d A' Ω[P_d⁄k] ≃ₗ[A'] Ω[A'⁄k] :=
      KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale k P_d A'
    let b_A' : Module.Basis (Fin d) A' Ω[A'⁄k] := (b_P.baseChange A').map e_A'
    refine ⟨b_A', ?_, Algebra.FormallySmooth.comp k P_d A',
      Algebra.FinitePresentation.trans k P_d A'⟩
    intro r
    dsimp only [b_A', e_A', b_P]
    rw [Module.Basis.map_apply, Module.Basis.baseChange_apply,
      KaehlerDifferential.mvPolynomialBasis_apply,
      KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale_apply,
      KaehlerDifferential.mapBaseChange_tmul, one_smul,
      KaehlerDifferential.map_D]
    rfl
  have h_push : ∀ (φ : A →+* A'), φ.comp f_k = algebraMap k A' → ∀ a : A,
      KaehlerDifferential.D k A' (φ a) =
        ∑ s : Fin d, φ (b_A.repr (KaehlerDifferential.D k A a) s) •
          KaehlerDifferential.D k A' (φ (g (MvPolynomial.X s))) := by
    intro φ hφ a
    let _ : Algebra A A' := φ.toAlgebra
    have : IsScalarTower k A A' := IsScalarTower.of_algebraMap_eq' hφ.symm
    have h_repr := (b_A.sum_repr (KaehlerDifferential.D k A a)).symm
    have h_map := congrArg (KaehlerDifferential.map k k A A') h_repr
    rw [KaehlerDifferential.map_D, map_sum] at h_map
    refine h_map.trans (Finset.sum_congr rfl fun s _ => ?_)
    rw [map_smul, hb_A s, KaehlerDifferential.map_D, ← algebraMap_smul A']
    rfl
  let S : Set A' := Set.range (fun a : A => ι a - ψ a)
  let I_W : Ideal A' := Ideal.span S
  let B' := A' ⧸ I_W
  let π : A' →+* B' := Ideal.Quotient.mk I_W
  let y : Fin d → A' := fun j => ι (g (MvPolynomial.X j)) - ψ (g (MvPolynomial.X j))
  let V : Submodule B' (TensorProduct A' B' Ω[A'⁄k]) :=
    Submodule.span B' (Set.range (fun s : Fin d =>
      (1 : B') ⊗ₜ[A'] KaehlerDifferential.D k A' (y s)))
  have h_gen : ∀ z_el ∈ S, ((1 : B') ⊗ₜ[A'] KaehlerDifferential.D k A' z_el) ∈ V := by
    rintro _ ⟨a, rfl⟩
    let c : Fin d → A := fun s => b_A.repr (KaehlerDifferential.D k A a) s
    have hD_diff : KaehlerDifferential.D k A' (ι a - ψ a) =
        ∑ s : Fin d,
          (ι (c s) • KaehlerDifferential.D k A' (ι (g (MvPolynomial.X s))) -
            ψ (c s) • KaehlerDifferential.D k A' (ψ (g (MvPolynomial.X s)))) := by
      rw [map_sub, h_push ι rfl a, h_push ψ hψ_k a, ← Finset.sum_sub_distrib]
    have h_tmul_sum :
        ((1 : B') ⊗ₜ[A'] KaehlerDifferential.D k A' (ι a - ψ a)) =
          ∑ s : Fin d, (1 : B') ⊗ₜ[A']
            (ι (c s) • KaehlerDifferential.D k A' (ι (g (MvPolynomial.X s))) -
              ψ (c s) • KaehlerDifferential.D k A' (ψ (g (MvPolynomial.X s)))) := by
      rw [hD_diff]
      exact map_sum (TensorProduct.mk A' B' Ω[A'⁄k] 1) _ _
    rw [h_tmul_sum]
    refine Submodule.sum_mem V fun s _ => ?_
    have h_eq_π : π (ι (c s)) = π (ψ (c s)) := by
      apply sub_eq_zero.mp
      rw [← map_sub]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨c s, rfl⟩)
    have h_term :
        (1 : B') ⊗ₜ[A']
          (ι (c s) • KaehlerDifferential.D k A' (ι (g (MvPolynomial.X s))) -
            ψ (c s) • KaehlerDifferential.D k A' (ψ (g (MvPolynomial.X s)))) =
        π (ι (c s)) • ((1 : B') ⊗ₜ[A'] KaehlerDifferential.D k A' (y s)) := by
      rw [TensorProduct.tmul_sub, ← TensorProduct.smul_tmul, ← TensorProduct.smul_tmul]
      have h1 : ι (c s) • (1 : B') = π (ι (c s)) := by
        rw [Algebra.smul_def, mul_one]; rfl
      have h2 : ψ (c s) • (1 : B') = π (ι (c s)) := by
        rw [Algebra.smul_def, mul_one]; exact h_eq_π.symm
      rw [h1, h2, ← TensorProduct.tmul_sub, ← map_sub, TensorProduct.smul_tmul',
        smul_eq_mul, mul_one]
    rw [h_term]
    exact V.smul_mem (π (ι (c s))) (Submodule.subset_span ⟨s, rfl⟩)
  have h_span_I : ∀ x ∈ I_W, ((1 : B') ⊗ₜ[A'] KaehlerDifferential.D k A' x) ∈ V := by
    intro x hx
    refine Submodule.span_induction
      (p := fun x _ => ((1 : B') ⊗ₜ[A'] KaehlerDifferential.D k A' x) ∈ V)
      h_gen ?_ ?_ ?_ hx
    · rw [map_zero, TensorProduct.tmul_zero]
      exact V.zero_mem
    · intro x₁ x₂ _ _ ih₁ ih₂
      rw [map_add, TensorProduct.tmul_add]
      exact V.add_mem ih₁ ih₂
    · intro r x₀ hx₀ ih
      rw [smul_eq_mul, (KaehlerDifferential.D k A').leibniz r x₀,
        TensorProduct.tmul_add, ← TensorProduct.smul_tmul, ← TensorProduct.smul_tmul]
      have hr : (r • (1 : B')) ⊗ₜ[A'] KaehlerDifferential.D k A' x₀ =
          π r • ((1 : B') ⊗ₜ[A'] KaehlerDifferential.D k A' x₀) := by
        rw [TensorProduct.smul_tmul', smul_eq_mul, Algebra.smul_def]
        rfl
      have hx_zero : x₀ • (1 : B') = 0 := by
        rw [Algebra.smul_def, mul_one]
        exact Ideal.Quotient.eq_zero_iff_mem.mpr hx₀
      rw [hr, hx_zero, TensorProduct.zero_tmul, add_zero]
      exact V.smul_mem (π r) ih
  have : Algebra.Etale k B' := RingHom.etale_algebraMap.mp hB_et
  have hV_all : ∀ ω : TensorProduct A' B' Ω[A'⁄k], ω ∈ V := by
    intro ω
    have h_zero : KaehlerDifferential.mapBaseChange k A' B' ω = 0 := Subsingleton.elim _ _
    obtain ⟨c_cot, rfl⟩ :=
      (KaehlerDifferential.exact_kerCotangentToTensor_mapBaseChange k A' B'
        Ideal.Quotient.mk_surjective ω).mp h_zero
    obtain ⟨x_ker, rfl⟩ := Ideal.toCotangent_surjective (RingHom.ker (algebraMap A' B')) c_cot
    rw [KaehlerDifferential.kerCotangentToTensor_toCotangent]
    have hx_mem : (x_ker : A') ∈ I_W := by
      have hx_k : (x_ker : A') ∈ RingHom.ker (Ideal.Quotient.mk I_W) := x_ker.2
      rwa [Ideal.mk_ker] at hx_k
    exact h_span_I x_ker.1 hx_mem
  let J : Matrix (Fin d) (Fin d) A' :=
    fun r s => b_A'.repr (KaehlerDifferential.D k A' (y s)) r
  let f_det : A' := J.det
  let b_B' : Module.Basis (Fin d) B' (TensorProduct A' B' Ω[A'⁄k]) := b_A'.baseChange B'
  have hex_M : ∀ m : Fin d, ∃ c_m : Fin d → B',
      ∑ s : Fin d, c_m s • ((1 : B') ⊗ₜ[A'] KaehlerDifferential.D k A' (y s)) = b_B' m :=
    fun m => (Submodule.mem_span_range_iff_exists_fun B').mp (hV_all (b_B' m))
  choose c_fn hc_fn using hex_M
  let M : Matrix (Fin d) (Fin d) B' := fun s m => c_fn m s
  have hJM : (π.mapMatrix J) * M = 1 := by
    ext r m
    have h_eq := congrArg (fun ω => b_B'.repr ω r) (hc_fn m)
    rw [map_sum, Finsupp.finsetSum_apply] at h_eq
    have hLHS : (∑ s : Fin d, (b_B'.repr (M s m •
          ((1 : B') ⊗ₜ[A'] KaehlerDifferential.D k A' (y s)))) r) =
        ((π.mapMatrix J) * M) r m := by
      rw [Matrix.mul_apply]
      refine Finset.sum_congr rfl fun s _ => ?_
      rw [map_smul, Finsupp.smul_apply, smul_eq_mul,
        Module.Basis.baseChange_repr_tmul, Algebra.smul_def, mul_one,
        RingHom.mapMatrix_apply, mul_comm]
      rfl
    have hRHS : (b_B'.repr (b_B' m)) r = (1 : Matrix (Fin d) (Fin d) B') r m := by
      rw [Module.Basis.repr_self, Finsupp.single_apply, Matrix.one_apply]
      by_cases hrm : r = m
      · subst hrm; simp
      · simp [hrm, Ne.symm hrm]
    exact hLHS.symm.trans (h_eq.trans hRHS)
  have hdet_B' : π f_det * M.det = 1 := by
    dsimp only [f_det]
    rw [RingHom.map_det π J, ← Matrix.det_mul, hJM, Matrix.det_one]
  obtain ⟨m_lift, hm_lift⟩ := Ideal.Quotient.mk_surjective M.det
  have h_mem_p : f_det * m_lift - 1 ∈ p.asIdeal := by
    apply hp
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    change π (f_det * m_lift - 1) = 0
    rw [map_sub, map_mul, map_one, hm_lift, hdet_B', sub_self]
  have hf_det_not_mem : f_det ∉ p.asIdeal := by
    intro hf_in
    have h1_in : (1 : A') ∈ p.asIdeal := by
      have hmul_in : f_det * m_lift ∈ p.asIdeal := Ideal.mul_mem_right m_lift p.asIdeal hf_in
      have hsub := p.asIdeal.sub_mem hmul_in h_mem_p
      simpa using hsub
    exact p.isPrime.ne_top ((Ideal.eq_top_iff_one p.asIdeal).mpr h1_in)
  let A'' := Localization.Away f_det
  let lam : A' →+* A'' := algebraMap A' A''
  have : Algebra.FormallySmooth k A' := hSm_A'
  have : Algebra.FinitePresentation k A' := hFP_A'
  have : Algebra.FormallySmooth k A'' := Algebra.FormallySmooth.comp k A' A''
  have : Algebra.FinitePresentation k A'' := Algebra.FinitePresentation.trans k A' A''
  let e_A'' : TensorProduct A' A'' Ω[A'⁄k] ≃ₗ[A''] Ω[A''⁄k] :=
    KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale k A' A''
  let b_A'' : Module.Basis (Fin d) A'' Ω[A''⁄k] := (b_A'.baseChange A'').map e_A''
  let z : Fin d → A'' := fun j => lam (y j)
  have hb_A''_repr : ∀ r s : Fin d,
      b_A''.repr (KaehlerDifferential.D k A'' (z s)) r = lam (J r s) := by
    intro r s
    have hD_eq : KaehlerDifferential.D k A'' (z s) =
        e_A'' ((1 : A'') ⊗ₜ[A'] KaehlerDifferential.D k A' (y s)) := by
      dsimp only [z, lam, e_A'']
      rw [KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale_apply,
        KaehlerDifferential.mapBaseChange_tmul, one_smul, KaehlerDifferential.map_D]
    rw [hD_eq]
    dsimp only [b_A'']
    rw [Module.Basis.map_repr, LinearEquiv.trans_apply, LinearEquiv.symm_apply_apply,
      Module.Basis.baseChange_repr_tmul, Algebra.smul_def, mul_one]
  let h : P_d →+* A'' := MvPolynomial.eval₂Hom (algebraMap k A'') z
  let _ : Algebra P_d A'' := h.toAlgebra
  have h_tower_A'' : (algebraMap P_d A'').comp (algebraMap k P_d) = algebraMap k A'' := by
    ext c
    change h (algebraMap k (MvPolynomial (Fin d) k) c) = algebraMap k A'' c
    rw [MvPolynomial.algebraMap_eq]
    exact MvPolynomial.eval₂Hom_C (algebraMap k A'') z c
  have : IsScalarTower k P_d A'' := IsScalarTower.of_algebraMap_eq' h_tower_A''.symm
  let b_src : Module.Basis (Fin d) A'' (TensorProduct P_d A'' Ω[P_d⁄k]) := b_P.baseChange A''
  let φ_diff : TensorProduct P_d A'' Ω[P_d⁄k] →ₗ[A''] Ω[A''⁄k] :=
    KaehlerDifferential.mapBaseChange k P_d A''
  have hM_φ : LinearMap.toMatrix b_src b_A'' φ_diff = lam.mapMatrix J := by
    ext r s
    rw [LinearMap.toMatrix_apply, RingHom.mapMatrix_apply]
    have hφ_b : φ_diff (b_src s) = KaehlerDifferential.D k A'' (z s) := by
      dsimp only [b_src, b_P, φ_diff]
      rw [Module.Basis.baseChange_apply, KaehlerDifferential.mvPolynomialBasis_apply,
        KaehlerDifferential.mapBaseChange_tmul, one_smul, KaehlerDifferential.map_D]
      change KaehlerDifferential.D k A'' (h (MvPolynomial.X s)) = _
      rw [MvPolynomial.eval₂Hom_X']
    rw [hφ_b, hb_A''_repr r s]
    rfl
  have hdet_unit : IsUnit (LinearMap.toMatrix b_src b_A'' φ_diff).det := by
    rw [hM_φ, ← RingHom.map_det lam J]
    exact IsLocalization.Away.algebraMap_isUnit f_det
  have hM_unit : IsUnit (LinearMap.toMatrix b_src b_A'' φ_diff) :=
    (Matrix.isUnit_iff_isUnit_det _).mpr hdet_unit
  obtain ⟨u_mat, hu_mat⟩ := hM_unit
  let ψ_inv : Ω[A''⁄k] →ₗ[A''] TensorProduct P_d A'' Ω[P_d⁄k] :=
    Matrix.toLin b_A'' b_src (↑u_mat⁻¹ : Matrix (Fin d) (Fin d) A'')
  have h_left_inv : ψ_inv ∘ₗ φ_diff = LinearMap.id := by
    apply (LinearMap.toMatrix b_src b_src).injective
    rw [LinearMap.toMatrix_comp b_src b_A'' b_src, LinearMap.toMatrix_toLin,
      ← hu_mat, Units.inv_mul, LinearMap.toMatrix_id]
  have h_right_inv : φ_diff ∘ₗ ψ_inv = LinearMap.id := by
    apply (LinearMap.toMatrix b_A'' b_A'').injective
    rw [LinearMap.toMatrix_comp b_A'' b_src b_A'', LinearMap.toMatrix_toLin,
      ← hu_mat, Units.mul_inv, LinearMap.toMatrix_id]
  have hφ_inj : Function.Injective φ_diff := by
    intro x₁ x₂ hx
    have h_congr := congrArg ψ_inv hx
    simpa [LinearMap.comp_apply] using
      (LinearMap.congr_fun h_left_inv x₁).symm.trans
        (h_congr.trans (LinearMap.congr_fun h_left_inv x₂))
  have hφ_surj : Function.Surjective φ_diff := by
    intro ω
    exact ⟨ψ_inv ω, LinearMap.congr_fun h_right_inv ω⟩
  have hSub_Ω : Subsingleton Ω[A''⁄P_d] := by
    refine (subsingleton_iff_forall_eq (0 : Ω[A''⁄P_d])).mpr fun ω => ?_
    obtain ⟨x, rfl⟩ := KaehlerDifferential.map_surjective k P_d A'' ω
    obtain ⟨t, rfl⟩ := hφ_surj x
    exact (KaehlerDifferential.exact_mapBaseChange_map k P_d A'' (φ_diff t)).mpr ⟨t, rfl⟩
  have hSub_H1 : Subsingleton (Algebra.H1Cotangent P_d A'') := by
    refine (subsingleton_iff_forall_eq (0 : Algebra.H1Cotangent P_d A'')).mpr fun c => ?_
    have hδ0 : φ_diff (Algebra.H1Cotangent.δ k P_d A'' c) = 0 :=
      (Algebra.H1Cotangent.exact_δ_mapBaseChange k P_d A'' _).mpr ⟨c, rfl⟩
    have hc_δ : Algebra.H1Cotangent.δ k P_d A'' c = 0 :=
      hφ_inj (hδ0.trans (map_zero φ_diff).symm)
    obtain ⟨x₀, rfl⟩ := (Algebra.H1Cotangent.exact_map_δ k P_d A'' c).mp hc_δ
    rw [Subsingleton.elim x₀ 0, map_zero]
  have : Algebra.FormallyEtale P_d A'' :=
    (Algebra.formallyEtale_iff P_d A'').mpr ⟨hSub_Ω, hSub_H1⟩
  have : Algebra.FinitePresentation P_d A'' :=
    Algebra.FinitePresentation.of_restrict_scalars_finitePresentation k P_d A''
  have : Algebra.Etale P_d A'' := {}
  have hh_et : h.Etale := RingHom.etale_algebraMap.mpr inferInstance
  have hh_eq :
      lam.comp (MvPolynomial.eval₂Hom (ι.comp f_k) y) = h := by
    apply MvPolynomial.ringHom_ext
    · intro c
      dsimp only [h]
      rw [RingHom.comp_apply, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_C]
      rfl
    · intro j
      dsimp only [h, z]
      rw [RingHom.comp_apply, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X']
  refine ⟨f_det, hf_det_not_mem, ?_⟩
  change (lam.comp (MvPolynomial.eval₂Hom (ι.comp f_k) y)).Etale
  rw [hh_eq]
  exact hh_et

theorem weil_gysin_transversal_fixed_point_and_graph_charts (k : Type u) [Field k] [IsAlgClosed k]
    (d : ℕ) (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hInt : AlgebraicGeometry.IsIntegral X.left)
    [AlgebraicGeometry.IsProper X.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension d X.hom]
    (φ : Quiver.Hom X.left X.left)
    (hφ : CategoryTheory.CategoryStruct.comp φ X.hom = X.hom)
    (hW_fin : AlgebraicGeometry.IsFinite
      (CategoryTheory.CategoryStruct.comp
        (CategoryTheory.Limits.pullback.fst
          (CategoryTheory.Limits.pullback.diagonal X.hom)
          (CategoryTheory.Limits.pullback.lift (CategoryTheory.CategoryStruct.id X.left) φ
            ((CategoryTheory.Category.id_comp X.hom).trans hφ.symm)))
        X.hom))
    (hW_et : AlgebraicGeometry.Etale
      (CategoryTheory.CategoryStruct.comp
        (CategoryTheory.Limits.pullback.fst
          (CategoryTheory.Limits.pullback.diagonal X.hom)
          (CategoryTheory.Limits.pullback.lift (CategoryTheory.CategoryStruct.id X.left) φ
            ((CategoryTheory.Category.id_comp X.hom).trans hφ.symm)))
        X.hom)) :
    let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
    let P := CategoryTheory.Limits.pullback X.hom X.hom
    let p₁ := CategoryTheory.Limits.pullback.fst X.hom X.hom
    let Δ := CategoryTheory.Limits.pullback.diagonal X.hom
    let Γ_φ := CategoryTheory.Limits.pullback.lift (CategoryTheory.CategoryStruct.id X.left) φ
      ((CategoryTheory.Category.id_comp X.hom).trans hφ.symm)
    let W := CategoryTheory.Limits.pullback Δ Γ_φ
    let i_W := CategoryTheory.Limits.pullback.fst Δ Γ_φ
    (AlgebraicGeometry.IsIntegral P ∧
      AlgebraicGeometry.IsProper (CategoryTheory.CategoryStruct.comp p₁ X.hom) ∧
      AlgebraicGeometry.SmoothOfRelativeDimension (2 * d)
        (CategoryTheory.CategoryStruct.comp p₁ X.hom)) ∧
    (Finite ↥W ∧
      DiscreteTopology ↥W ∧
      AlgebraicGeometry.IsClosedImmersion Δ ∧
      AlgebraicGeometry.IsClosedImmersion Γ_φ ∧
      AlgebraicGeometry.IsClosedImmersion i_W ∧
      i_W = CategoryTheory.Limits.pullback.snd Δ Γ_φ ∧
      CategoryTheory.CategoryStruct.comp i_W φ = i_W) ∧
    (∀ (c : ℕ) (Y : CategoryTheory.Over S_k)
        [AlgebraicGeometry.SmoothOfRelativeDimension c Y.hom]
        (s : Quiver.Hom S_k Y.left),
      CategoryTheory.CategoryStruct.comp s Y.hom = CategoryTheory.CategoryStruct.id S_k →
      ∃ (U : Y.left.Opens) (s_U : Quiver.Hom S_k U.toScheme)
        (u : Quiver.Hom U.toScheme (weilGysinAffineSpace k c)),
        WeilGysinIsEtaleOriginChart c Y.hom s U s_U u) ∧
    (∃ (s₀ : Quiver.Hom S_k X.left)
        (s'_W : ∀ _ : ↥W, Quiver.Hom S_k W),
      CategoryTheory.CategoryStruct.comp s₀ X.hom = CategoryTheory.CategoryStruct.id S_k ∧
      (∀ w : ↥W,
        AlgebraicGeometry.IsOpenImmersion (s'_W w) ∧
        Set.range (s'_W w).base = {w} ∧
        CategoryTheory.CategoryStruct.comp
          (CategoryTheory.CategoryStruct.comp (s'_W w) i_W) X.hom =
          CategoryTheory.CategoryStruct.id S_k) ∧
      (∀ x : ↥X.left,
        ∃ (U_x : X.left.Opens) (V_x : P.Opens)
