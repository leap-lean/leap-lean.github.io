    have hu_nat : ∀ {U₁ U₂ : B.left.Etale} (g : U₁ ⟶ U₂),
        g ≫ u_site U₂ = u_site U₁ ≫ B_σ.map (B_f.map g) := by
      intro U₁ U₂ g
      let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} := @AlgebraicGeometry.Etale
      have : CategoryTheory.MorphismProperty.HasPullbacksAlong P_et p_bar :=
