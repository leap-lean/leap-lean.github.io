    have hφ₀_0 : φ₀ (t_A 0 0) = 1 := hφ₀_t 0
    have hφ₀_1 : φ₀ (t_A 0 1) = s₀ := hφ₀_t 1
    obtain ⟨φ₁, hφ₁_c, hφ₁_t⟩ := hEval_P1 1 C₁ p₁ ![t₁, 1] rfl
    have hφ₁_0 : φ₁ (t_A 1 0) = t₁ := hφ₁_t 0
    have hφ₁_1 : φ₁ (t_A 1 1) = 1 := hφ₁_t 1
    have hSurj₀ : Function.Surjective φ₀ := by
      rw [← RingHom.range_eq_top, eq_top_iff, ← hgen₀, Subring.closure_le]
      rintro x (⟨r, rfl⟩ | hx)
      · exact ⟨c_A 0 r, RingHom.congr_fun hφ₀_c r⟩
      · rw [Set.mem_singleton_iff.mp hx]
        exact ⟨t_A 0 1, hφ₀_1⟩
    have hSurj₁ : Function.Surjective φ₁ := by
      rw [← RingHom.range_eq_top, eq_top_iff, ← hgen₁, Subring.closure_le]
      rintro x (⟨r, rfl⟩ | hx)
      · exact ⟨c_A 1 r, RingHom.congr_fun hφ₁_c r⟩
      · rw [Set.mem_singleton_iff.mp hx]
        exact ⟨t_A 1 0, hφ₁_0⟩
    let φ₀_spec := AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀)
    let φ₁_spec := AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁)
    let m₀ : AlgebraicGeometry.Spec (CommRingCat.of C₀) ⟶ P₁ := φ₀_spec ≫ (hAff_A 0).fromSpec
    let m₁ : AlgebraicGeometry.Spec (CommRingCat.of C₁) ⟶ P₁ := φ₁_spec ≫ (hAff_A 1).fromSpec
    let f₁₀ : C₁ →+* C₀₁ := algebraMap C₁ C₀₁
    let D₀₁ : P₁.Opens := D₀ ⊓ D₁
    let i_D0 : D₀₁ ⟶ D₀ := CategoryTheory.homOfLE inf_le_left
    let i_D1 : D₀₁ ⟶ D₁ := CategoryTheory.homOfLE inf_le_right
    let res₀ := (P₁.presheaf.map i_D0.op).hom
    let res₁ := (P₁.presheaf.map i_D1.op).hom
    have hBasic01 : D₀₁ = P₁.basicOpen (t_A 0 1) := (hBasic_P1 0 1).symm
    have hBasic10 : D₀₁ = P₁.basicOpen (t_A 1 0) := (inf_comm _ _).trans (hBasic_P1 1 0).symm
    have hAff₀₁ : AlgebraicGeometry.IsAffineOpen D₀₁ :=
      hBasic01 ▸ (hAff_A 0).basicOpen (t_A 0 1)
    have hUnit_0 : IsUnit ((f₀₁.comp φ₀) (t_A 0 1)) :=
      ⟨⟨(f₀₁.comp φ₀) (t_A 0 1), f₁₀ t₁,
        by change f₀₁ (φ₀ (t_A 0 1)) * f₁₀ t₁ = 1; rw [hφ₀_1, mul_comm, hinv],
        by change f₁₀ t₁ * f₀₁ (φ₀ (t_A 0 1)) = 1; rw [hφ₀_1, hinv]⟩, rfl⟩
    have hUnit_1 : IsUnit ((f₁₀.comp φ₁) (t_A 1 0)) :=
      ⟨⟨(f₁₀.comp φ₁) (t_A 1 0), f₀₁ s₀,
        by change f₁₀ (φ₁ (t_A 1 0)) * f₀₁ s₀ = 1; rw [hφ₁_0, hinv],
        by change f₀₁ s₀ * f₁₀ (φ₁ (t_A 1 0)) = 1; rw [hφ₁_0, mul_comm, hinv]⟩, rfl⟩
    have hLiftAux : ∀ {R S : Type u} [CommRing R] [CommRing S] {alg : Algebra R S}
        (x : R) (_ : @IsLocalization.Away R _ x S _ alg)
        (g : R →+* C₀₁) (_ : IsUnit (g x)),
        ∃ lam : S →+* C₀₁, lam.comp (@algebraMap R S _ _ alg) = g := by
      intro R S _ _ alg x hloc g hg
      let _ : Algebra R S := alg
      have _ : IsLocalization.Away x S := hloc
      exact ⟨IsLocalization.Away.lift x hg,
        RingHom.ext fun a => IsLocalization.Away.lift_eq x hg a⟩
    obtain ⟨lam₀, hlam₀_comp⟩ :
        ∃ lam₀ : ↑(P₁.presheaf.obj (Opposite.op D₀₁)) →+* C₀₁,
          lam₀.comp res₀ = f₀₁.comp φ₀ :=
      hLiftAux (t_A 0 1) ((hAff_A 0).isLocalization_of_eq_basicOpen (t_A 0 1) i_D0 hBasic01)
        (f₀₁.comp φ₀) hUnit_0
    obtain ⟨lam₁, hlam₁_comp⟩ :
        ∃ lam₁ : ↑(P₁.presheaf.obj (Opposite.op D₀₁)) →+* C₀₁,
          lam₁.comp res₁ = f₁₀.comp φ₁ :=
      hLiftAux (t_A 1 0) ((hAff_A 1).isLocalization_of_eq_basicOpen (t_A 1 0) i_D1 hBasic10)
        (f₁₀.comp φ₁) hUnit_1
    have hExtAux : ∀ {R S : Type u} [CommRing R] [CommRing S] {alg : Algebra R S}
        (x : R) (_ : @IsLocalization.Away R _ x S _ alg)
        (j k : S →+* C₀₁),
        j.comp (@algebraMap R S _ _ alg) = k.comp (@algebraMap R S _ _ alg) → j = k := by
      intro R S _ _ alg x hloc j k hjk
      let _ : Algebra R S := alg
      have _ : IsLocalization.Away x S := hloc
      exact IsLocalization.ringHom_ext (Submonoid.powers x) hjk
    have hlam_eq : lam₀ = lam₁ := by
      apply hExtAux (t_A 0 1) ((hAff_A 0).isLocalization_of_eq_basicOpen (t_A 0 1) i_D0 hBasic01)
      change lam₀.comp res₀ = lam₁.comp res₀
      suffices hLocus : RingHom.eqLocus (lam₀.comp res₀) (lam₁.comp res₀) = ⊤ by
        ext x
        have hx : x ∈ RingHom.eqLocus (lam₀.comp res₀) (lam₁.comp res₀) := by
          rw [hLocus]; trivial
        exact hx
      rw [eq_top_iff, ← hGen_P1 0, Subring.closure_le]
      rintro x (⟨r, rfl⟩ | ⟨b, rfl⟩)
      · change (lam₀.comp res₀) (c_A 0 r) = lam₁ (res₀ (c_A 0 r))
        rw [hlam₀_comp]
        change f₀₁ (φ₀ (c_A 0 r)) = lam₁ (res₀ (c_A 0 r))
        have hr0 : φ₀ (c_A 0 r) = p₀ r := RingHom.congr_fun hφ₀_c r
        have hr1 : φ₁ (c_A 1 r) = p₁ r := RingHom.congr_fun hφ₁_c r
        have hcomp_r : f₀₁ (p₀ r) = f₁₀ (p₁ r) := RingHom.congr_fun hcomp r
        have hres_r : res₀ (c_A 0 r) = res₁ (c_A 1 r) := (hRes_c 0 1 r).symm
        rw [hr0, hcomp_r, ← hr1, hres_r]
        exact (RingHom.congr_fun hlam₁_comp (c_A 1 r)).symm
      · fin_cases b
        · change (lam₀.comp res₀) (t_A 0 0) = (lam₁.comp res₀) (t_A 0 0)
          rw [ht_diag 0, map_one, map_one]
        · change (lam₀.comp res₀) (t_A 0 1) = lam₁ (res₀ (t_A 0 1))
          have hlhs : (lam₀.comp res₀) (t_A 0 1) = f₀₁ s₀ := by
            rw [hlam₀_comp]
            change f₀₁ (φ₀ (t_A 0 1)) = f₀₁ s₀
            rw [hφ₀_1]
          have hrec_R : res₁ (t_A 1 0) * res₀ (t_A 0 1) = 1 := by
            change ((P₁.presheaf.map i_D1.op).hom (t_A 1 0)) *
              ((P₁.presheaf.map i_D0.op).hom (t_A 0 1)) = 1
            rw [hRes_t 0 1 0, ht_diag 0, map_one]
          have hrec_C : f₁₀ t₁ * lam₁ (res₀ (t_A 0 1)) = 1 := by
            have h1 := congrArg lam₁ hrec_R
            rw [map_mul, map_one] at h1
            have h2 : lam₁ (res₁ (t_A 1 0)) = f₁₀ t₁ := by
              change (lam₁.comp res₁) (t_A 1 0) = f₁₀ t₁
              rw [hlam₁_comp]
              change f₁₀ (φ₁ (t_A 1 0)) = f₁₀ t₁
              rw [hφ₁_0]
            rwa [h2] at h1
          rw [hlhs]
          calc
            f₀₁ s₀ = f₀₁ s₀ * 1 := (mul_one _).symm
            _ = f₀₁ s₀ * (f₁₀ t₁ * lam₁ (res₀ (t_A 0 1))) := by rw [hrec_C]
            _ = (f₀₁ s₀ * f₁₀ t₁) * lam₁ (res₀ (t_A 0 1)) := (mul_assoc _ _ _).symm
            _ = (f₁₀ t₁ * f₀₁ s₀) * lam₁ (res₀ (t_A 0 1)) := by rw [mul_comm (f₀₁ s₀) (f₁₀ t₁)]
            _ = 1 * lam₁ (res₀ (t_A 0 1)) := by rw [hinv]
            _ = lam₁ (res₀ (t_A 0 1)) := one_mul _
    let lam_cat : P₁.presheaf.obj (Opposite.op D₀₁) ⟶ CommRingCat.of C₀₁ :=
      CommRingCat.ofHom lam₀
    have hm_ov : AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₀₁) ≫ m₀ =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₁₀) ≫ m₁ := by
      have hcat0 : CommRingCat.ofHom φ₀ ≫ CommRingCat.ofHom f₀₁ =
          P₁.presheaf.map i_D0.op ≫ lam_cat := by
        apply CommRingCat.hom_ext
        exact hlam₀_comp.symm
      have hcat1 : CommRingCat.ofHom φ₁ ≫ CommRingCat.ofHom f₁₀ =
          P₁.presheaf.map i_D1.op ≫ lam_cat := by
        apply CommRingCat.hom_ext
        dsimp only [lam_cat]
        rw [hlam_eq]
        exact hlam₁_comp.symm
      have h0 : AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₀₁) ≫ m₀ =
          AlgebraicGeometry.Spec.map lam_cat ≫ hAff₀₁.fromSpec := by
        dsimp only [m₀, φ₀_spec]
        rw [← Category.assoc, ← AlgebraicGeometry.Spec.map_comp, hcat0,
          AlgebraicGeometry.Spec.map_comp, Category.assoc,
          (hAff_A 0).map_fromSpec hAff₀₁ i_D0.op]
      have h1 : AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₁₀) ≫ m₁ =
          AlgebraicGeometry.Spec.map lam_cat ≫ hAff₀₁.fromSpec := by
        dsimp only [m₁, φ₁_spec]
        rw [← Category.assoc, ← AlgebraicGeometry.Spec.map_comp, hcat1,
          AlgebraicGeometry.Spec.map_comp, Category.assoc,
          (hAff_A 1).map_fromSpec hAff₀₁ i_D1.op]
      exact h0.trans h1.symm
    obtain ⟨ι_M, hι₀_M, hι₁_M⟩ := hDesc P₁ m₀ m₁ hm_ov
    have hιM_p : ι_M ≫ π_P1 = p_M := by
      apply hExt (AlgebraicGeometry.Spec (CommRingCat.of A)) (ι_M ≫ π_P1) p_M
      · rw [← Category.assoc, hι₀_M]
        dsimp only [m₀, φ₀_spec]
        rw [Category.assoc, ← hBase_c 0, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp, hφ₀_c, hι₀_p]
      · rw [← Category.assoc, hι₁_M]
        dsimp only [m₁, φ₁_spec]
        rw [Category.assoc, ← hBase_c 1, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp, hφ₁_c, hι₁_p]
    have hPre₀ : (TopologicalSpace.Opens.map ι_M.base).obj D₀ = ι₀.opensRange := by
      ext y
      constructor
      · intro hyD0
        have hy_top : y ∈ (ι₀.opensRange ⊔ ι₁.opensRange : M.Opens) := by
          rw [hSup]; trivial
        rcases hy_top with hy0 | hy1
        · exact hy0
        · rw [ι₁.coe_opensRange] at hy1
          rcases hy1 with ⟨x₁, rfl⟩
          have hx₁_D0 : m₁.base x₁ ∈ D₀ := by
            have h1 : (ι₁ ≫ ι_M).base x₁ ∈ D₀ := hyD0
            rwa [hι₁_M] at h1
          have hx₁_D1 : m₁.base x₁ ∈ D₁ := by
            have hmem : (hAff_A 1).fromSpec.base (φ₁_spec.base x₁) ∈
                Set.range (hAff_A 1).fromSpec.base := ⟨φ₁_spec.base x₁, rfl⟩
            rwa [(hAff_A 1).range_fromSpec] at hmem
          have hx₁_bo : (hAff_A 1).fromSpec.base (φ₁_spec.base x₁) ∈ P₁.basicOpen (t_A 1 0) := by
            rw [hBasic_P1 1 0]
            exact ⟨hx₁_D1, hx₁_D0⟩
          have hq₁_bo : φ₁_spec.base x₁ ∈
              (TopologicalSpace.Opens.map (hAff_A 1).fromSpec.base).obj (P₁.basicOpen (t_A 1 0)) :=
            hx₁_bo
          rw [(hAff_A 1).fromSpec_preimage_basicOpen (t_A 1 0)] at hq₁_bo
          have ht₁_not_mem : t₁ ∉ x₁.asIdeal := by
            have h1 : t_A 1 0 ∉ (φ₁_spec.base x₁).asIdeal := hq₁_bo
            dsimp only [φ₁_spec] at h1
            rw [AlgebraicGeometry.Spec.map_base] at h1
            change φ₁ (t_A 1 0) ∉ x₁.asIdeal at h1
            rwa [hφ₁_0] at h1
          have hx₁_range : x₁ ∈ Set.range
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₁₀)).base := by
            rw [AlgebraicGeometry.Spec.map_base]
            change x₁ ∈ Set.range (PrimeSpectrum.comap (algebraMap C₁ C₀₁))
            rw [PrimeSpectrum.localization_away_comap_range C₀₁ t₁]
            exact ht₁_not_mem
          rcases hx₁_range with ⟨z, hz⟩
          rw [ι₀.coe_opensRange]
          refine ⟨(AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₀₁)).base z, ?_⟩
          calc
            ι₀.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₀₁)).base z)
              = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₀₁) ≫ ι₀).base z := rfl
            _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₁₀) ≫ ι₁).base z := by rw [hOv]
            _ = ι₁.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₁₀)).base z) := rfl
            _ = ι₁.base x₁ := by rw [hz]
      · intro hy0
        rw [ι₀.coe_opensRange] at hy0
        rcases hy0 with ⟨x₀, rfl⟩
        change (ι₀ ≫ ι_M).base x₀ ∈ D₀
        rw [hι₀_M]
        have hmem : (hAff_A 0).fromSpec.base (φ₀_spec.base x₀) ∈
            Set.range (hAff_A 0).fromSpec.base := ⟨φ₀_spec.base x₀, rfl⟩
        rwa [(hAff_A 0).range_fromSpec] at hmem
    have hPre₁ : (TopologicalSpace.Opens.map ι_M.base).obj D₁ = ι₁.opensRange := by
      ext y
      constructor
      · intro hyD1
        have hy_top : y ∈ (ι₀.opensRange ⊔ ι₁.opensRange : M.Opens) := by
          rw [hSup]; trivial
        rcases hy_top with hy0 | hy1
        · rw [ι₀.coe_opensRange] at hy0
          rcases hy0 with ⟨x₀, rfl⟩
          have hx₀_D1 : m₀.base x₀ ∈ D₁ := by
            have h1 : (ι₀ ≫ ι_M).base x₀ ∈ D₁ := hyD1
            rwa [hι₀_M] at h1
          have hx₀_D0 : m₀.base x₀ ∈ D₀ := by
            have hmem : (hAff_A 0).fromSpec.base (φ₀_spec.base x₀) ∈
                Set.range (hAff_A 0).fromSpec.base := ⟨φ₀_spec.base x₀, rfl⟩
            rwa [(hAff_A 0).range_fromSpec] at hmem
          have hx₀_bo : (hAff_A 0).fromSpec.base (φ₀_spec.base x₀) ∈ P₁.basicOpen (t_A 0 1) := by
            rw [hBasic_P1 0 1]
            exact ⟨hx₀_D0, hx₀_D1⟩
          have hq₀_bo : φ₀_spec.base x₀ ∈
              (TopologicalSpace.Opens.map (hAff_A 0).fromSpec.base).obj (P₁.basicOpen (t_A 0 1)) :=
            hx₀_bo
          rw [(hAff_A 0).fromSpec_preimage_basicOpen (t_A 0 1)] at hq₀_bo
          have hs₀_not_mem : s₀ ∉ x₀.asIdeal := by
            have h1 : t_A 0 1 ∉ (φ₀_spec.base x₀).asIdeal := hq₀_bo
            dsimp only [φ₀_spec] at h1
            rw [AlgebraicGeometry.Spec.map_base] at h1
            change φ₀ (t_A 0 1) ∉ x₀.asIdeal at h1
            rwa [hφ₀_1] at h1
          have hx₀_range : x₀ ∈ Set.range
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₀₁)).base := by
            rw [AlgebraicGeometry.Spec.map_base]
            let _ : Algebra C₀ C₀₁ := f₀₁.toAlgebra
            have _ : IsLocalization.Away s₀ C₀₁ := hloc₀
            change x₀ ∈ Set.range (PrimeSpectrum.comap (algebraMap C₀ C₀₁))
            rw [PrimeSpectrum.localization_away_comap_range C₀₁ s₀]
            exact hs₀_not_mem
          rcases hx₀_range with ⟨z, hz⟩
          rw [ι₁.coe_opensRange]
          refine ⟨(AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₁₀)).base z, ?_⟩
          calc
            ι₁.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₁₀)).base z)
              = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₁₀) ≫ ι₁).base z := rfl
            _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₀₁) ≫ ι₀).base z := by rw [← hOv]
            _ = ι₀.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₀₁)).base z) := rfl
            _ = ι₀.base x₀ := by rw [hz]
        · exact hy1
      · intro hy1
        rw [ι₁.coe_opensRange] at hy1
        rcases hy1 with ⟨x₁, rfl⟩
        change (ι₁ ≫ ι_M).base x₁ ∈ D₁
        rw [hι₁_M]
        have hmem : (hAff_A 1).fromSpec.base (φ₁_spec.base x₁) ∈
            Set.range (hAff_A 1).fromSpec.base := ⟨φ₁_spec.base x₁, rfl⟩
        rwa [(hAff_A 1).range_fromSpec] at hmem
    have hCl_chart : ∀ (a : Fin (1 + 1)) (C_a : Type u) [CommRing C_a]
        (ι_a : AlgebraicGeometry.Spec (CommRingCat.of C_a) ⟶ M)
        [AlgebraicGeometry.IsOpenImmersion ι_a]
        (φ_a : ↑(P₁.presheaf.obj (Opposite.op (D_P1 a))) →+* C_a),
        Function.Surjective φ_a →
        (TopologicalSpace.Opens.map ι_M.base).obj (D_P1 a) = ι_a.opensRange →
        ι_a ≫ ι_M = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_a) ≫ (hAff_A a).fromSpec →
        AlgebraicGeometry.IsClosedImmersion (ι_M ∣_ D_P1 a) := by
      intro a C_a _ ι_a _ φ_a hSurj_a hPre_a hι_a_M
      let φ_a_spec := AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_a)
      have hCl_spec : AlgebraicGeometry.IsClosedImmersion φ_a_spec :=
        AlgebraicGeometry.IsClosedImmersion.spec_of_surjective (CommRingCat.ofHom φ_a) hSurj_a
      let U_pre : M.Opens := (TopologicalSpace.Opens.map ι_M.base).obj (D_P1 a)
      let e_top := M.isoOfEq (hPre_a : U_pre = ι_a.opensRange) ≪≫ ι_a.isoOpensRange.symm
      let e_bot := (hAff_A a).isoSpec
      have h_sq : e_top.hom ≫ φ_a_spec = (ι_M ∣_ D_P1 a) ≫ e_bot.hom := by
        rw [← cancel_epi e_top.inv, Iso.inv_hom_id_assoc]
        rw [← cancel_mono (e_bot.inv ≫ (D_P1 a).ι)]
        calc
          φ_a_spec ≫ (e_bot.inv ≫ (D_P1 a).ι)
            = φ_a_spec ≫ (hAff_A a).fromSpec := by rw [(hAff_A a).isoSpec_inv_ι]
          _ = ι_a ≫ ι_M := hι_a_M.symm
          _ = (ι_a.isoOpensRange.hom ≫ ι_a.opensRange.ι) ≫ ι_M := by rw [ι_a.isoOpensRange_hom_ι]
          _ = ι_a.isoOpensRange.hom ≫
                ((M.isoOfEq (hPre_a : U_pre = ι_a.opensRange)).inv ≫ U_pre.ι) ≫ ι_M := by
            rw [AlgebraicGeometry.Scheme.isoOfEq_inv_ι, Category.assoc]
          _ = e_top.inv ≫ (U_pre.ι ≫ ι_M) := by
            dsimp only [e_top, Iso.trans, Iso.symm]
            simp only [Category.assoc]
          _ = e_top.inv ≫ ((ι_M ∣_ D_P1 a) ≫ (D_P1 a).ι) := by
            rw [AlgebraicGeometry.morphismRestrict_ι]
          _ = (e_top.inv ≫ (ι_M ∣_ D_P1 a) ≫ e_bot.hom) ≫
                (e_bot.inv ≫ (D_P1 a).ι) := by
            simp only [Category.assoc, Iso.hom_inv_id_assoc]
      let e_arr : CategoryTheory.Arrow.mk (ι_M ∣_ D_P1 a) ≅
          CategoryTheory.Arrow.mk φ_a_spec :=
        CategoryTheory.Arrow.isoMk e_top e_bot h_sq
      exact (CategoryTheory.MorphismProperty.arrow_mk_iso_iff
        (@AlgebraicGeometry.IsClosedImmersion) e_arr).mpr hCl_spec
    have hCl_M : AlgebraicGeometry.IsClosedImmersion ι_M := by
      rw [AlgebraicGeometry.IsZariskiLocalAtTarget.iff_of_iSup_eq_top
        (P := @AlgebraicGeometry.IsClosedImmersion) D_P1 hCov_P1]
      intro a
      fin_cases a
      · exact hCl_chart 0 C₀ ι₀ φ₀ hSurj₀ hPre₀ hι₀_M
      · exact hCl_chart 1 C₁ ι₁ φ₁ hSurj₁ hPre₁ hι₁_M
    have _ : AlgebraicGeometry.IsClosedImmersion ι_M := hCl_M
    have hProp_M : AlgebraicGeometry.IsProper p_M := by
      rw [← hιM_p]
      exact @AlgebraicGeometry.IsProper.instCompScheme _ _ _ ι_M π_P1 inferInstance hProp_P1
    exact ⟨ι_M, φ₀, φ₁, hCl_M, hιM_p, hProp_M, hPre₀, hPre₁,
      ⟨hφ₀_c, hφ₀_0, hφ₀_1⟩, ⟨hφ₁_c, hφ₁_0, hφ₁_1⟩, hι₀_M, hι₁_M⟩
  obtain ⟨ι_M, φ₀, φ₁, hCl_M, hιM_p, hProp_M, hPre₀, hPre₁, hφ₀, hφ₁, hι₀_M, hι₁_M⟩ := hProjPkg
  
  have hIso_compl :
      CategoryTheory.IsIso
        (p_M ∣_ ⟨(PrimeSpectrum.zeroLocus ((Ideal.span {g₀} ⊔ Ideal.span {g₁} : Ideal A) : Set A))ᶜ,
          (PrimeSpectrum.isClosed_zeroLocus
            ((Ideal.span {g₀} ⊔ Ideal.span {g₁} : Ideal A) : Set A)).isOpen_compl⟩) := by
    let S_A : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of A)
    let U_compl : S_A.Opens :=
      ⟨(PrimeSpectrum.zeroLocus ((Ideal.span {g₀} ⊔ Ideal.span {g₁} : Ideal A) : Set A))ᶜ,
        (PrimeSpectrum.isClosed_zeroLocus
          ((Ideal.span {g₀} ⊔ Ideal.span {g₁} : Ideal A) : Set A)).isOpen_compl⟩
    have hU_compl_iff : ∀ x : PrimeSpectrum A, x ∈ U_compl ↔ g₀ ∉ x.asIdeal ∨ g₁ ∉ x.asIdeal := by
      intro x
      change x ∈ (PrimeSpectrum.zeroLocus ((Ideal.span {g₀} ⊔ Ideal.span {g₁} : Ideal A) : Set A))ᶜ ↔ _
      rw [Set.mem_compl_iff, PrimeSpectrum.mem_zeroLocus, SetLike.coe_subset_coe, sup_le_iff,
        Ideal.span_singleton_le_iff_mem, Ideal.span_singleton_le_iff_mem, not_and_or]
    have hg₀_le : (PrimeSpectrum.basicOpen g₀ : S_A.Opens) ≤ U_compl := by
      intro x hx
      exact (hU_compl_iff x).mpr (Or.inl hx)
    have hg₁_le : (PrimeSpectrum.basicOpen g₁ : S_A.Opens) ≤ U_compl := by
      intro x hx
      exact (hU_compl_iff x).mpr (Or.inr hx)
    let W₀ : U_compl.toScheme.Opens :=
      (TopologicalSpace.Opens.map U_compl.ι.base).obj (PrimeSpectrum.basicOpen g₀)
    let W₁ : U_compl.toScheme.Opens :=
      (TopologicalSpace.Opens.map U_compl.ι.base).obj (PrimeSpectrum.basicOpen g₁)
    let W_fam : Bool → U_compl.toScheme.Opens := fun b => if b then W₁ else W₀
    have hW_cov : iSup W_fam = ⊤ := by
      rw [eq_top_iff]
      intro w _
      rw [TopologicalSpace.Opens.mem_iSup]
      have hw_mem : U_compl.ι.base w ∈ U_compl := by
        have h1 : U_compl.ι.base w ∈ (U_compl.ι.opensRange : Set S_A) := by
          rw [U_compl.ι.coe_opensRange]
          exact ⟨w, rfl⟩
        rwa [AlgebraicGeometry.Scheme.Opens.opensRange_ι] at h1
      rcases (hU_compl_iff (U_compl.ι.base w)).mp hw_mem with h0 | h1
      · exact ⟨false, h0⟩
      · exact ⟨true, h1⟩
    have hSingleIso : ∀ (C_a C_b : Type u) [CommRing C_a] [CommRing C_b]
        (p_a : A →+* C_a) (p_b : A →+* C_b) (t_b : C_b)
        (f_ab : C_a →+* C₀₁) (f_ba : C_b →+* C₀₁)
        (_ : @IsLocalization.Away C_b _ t_b C₀₁ _ f_ba.toAlgebra)
        (ι_a : AlgebraicGeometry.Spec (CommRingCat.of C_a) ⟶ M)
        (ι_b : AlgebraicGeometry.Spec (CommRingCat.of C_b) ⟶ M)
        [AlgebraicGeometry.IsOpenImmersion ι_a]
        [AlgebraicGeometry.IsOpenImmersion ι_b],
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_ab) ≫ ι_a =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_ba) ≫ ι_b →
        ι_a.opensRange ⊔ ι_b.opensRange = ⊤ →
        ι_a ≫ p_M = AlgebraicGeometry.Spec.map (CommRingCat.ofHom p_a) →
        ι_b ≫ p_M = AlgebraicGeometry.Spec.map (CommRingCat.ofHom p_b) →
        ∀ (g : A),
          (PrimeSpectrum.basicOpen g : S_A.Opens) ≤ U_compl →
          (∀ q : PrimeSpectrum C_b, p_b g ∉ q.asIdeal → t_b ∉ q.asIdeal) →
          @IsLocalization.Away A _ g (Localization.Away (p_a g)) _
            ((algebraMap C_a (Localization.Away (p_a g))).comp p_a).toAlgebra →
          CategoryTheory.IsIso
            ((p_M ∣_ U_compl) ∣_
              (TopologicalSpace.Opens.map U_compl.ι.base).obj (PrimeSpectrum.basicOpen g)) := by
      intro C_a C_b _ _ p_a p_b t_b f_ab f_ba hloc_b ι_a ι_b _ _
        hOv' hSup' hι_a_p hι_b_p g hg_le hg_mem hg_loc
      let B_g : S_A.Opens := PrimeSpectrum.basicOpen g
      let W_g : U_compl.toScheme.Opens := (TopologicalSpace.Opens.map U_compl.ι.base).obj B_g
      let U_M : M.Opens := (TopologicalSpace.Opens.map p_M.base).obj U_compl
      let V_g : U_M.toScheme.Opens := (TopologicalSpace.Opens.map (p_M ∣_ U_compl).base).obj W_g
      let u_tgt : W_g.toScheme ⟶ S_A := W_g.ι ≫ U_compl.ι
      let j_Ag : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away g)) ⟶ S_A :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A (Localization.Away g)))
      have _ : AlgebraicGeometry.IsOpenImmersion j_Ag :=
        AlgebraicGeometry.IsOpenImmersion.of_isLocalization g
      have hRange_tgt : Set.range u_tgt.base = Set.range j_Ag.base := by
        have h1 : Set.range j_Ag.base = (B_g : Set S_A) := by
          dsimp only [j_Ag]
          rw [AlgebraicGeometry.Spec.map_base]
          change Set.range (PrimeSpectrum.comap (algebraMap A (Localization.Away g))) = _
          exact PrimeSpectrum.localization_away_comap_range (Localization.Away g) g
        rw [h1]
        ext x
        constructor
        · rintro ⟨v, rfl⟩
          have hv : W_g.ι.base v ∈ (W_g.ι.opensRange : Set U_compl.toScheme) := by
            rw [W_g.ι.coe_opensRange]; exact ⟨v, rfl⟩
          rw [AlgebraicGeometry.Scheme.Opens.opensRange_ι] at hv
          exact hv
        · intro hx
          have hxU : x ∈ (U_compl.ι.opensRange : Set S_A) := by
            rw [AlgebraicGeometry.Scheme.Opens.opensRange_ι]
            exact hg_le hx
          rw [U_compl.ι.coe_opensRange] at hxU
          rcases hxU with ⟨w, hw⟩
          have hwW : w ∈ (W_g.ι.opensRange : Set U_compl.toScheme) := by
            rw [AlgebraicGeometry.Scheme.Opens.opensRange_ι]
            change U_compl.ι.base w ∈ B_g
            rwa [hw]
          rw [W_g.ι.coe_opensRange] at hwW
          rcases hwW with ⟨v, hv⟩
          refine ⟨v, ?_⟩
          change U_compl.ι.base (W_g.ι.base v) = x
          rw [hv, hw]
      let e_tgt : W_g.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away g)) :=
        AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq u_tgt j_Ag hRange_tgt
      have he_tgt : e_tgt.hom ≫ j_Ag = u_tgt :=
        AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac u_tgt j_Ag hRange_tgt
      let u_src : V_g.toScheme ⟶ M := V_g.ι ≫ U_M.ι
      let j_ag_loc : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (p_a g))) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of C_a) :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap C_a (Localization.Away (p_a g))))
      have _ : AlgebraicGeometry.IsOpenImmersion j_ag_loc :=
        AlgebraicGeometry.IsOpenImmersion.of_isLocalization (p_a g)
      let j_ag : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (p_a g))) ⟶ M :=
        j_ag_loc ≫ ι_a
      have hRange_src : Set.range u_src.base = Set.range j_ag.base := by
        have h_usrc : Set.range u_src.base = {y : M | g ∉ (p_M.base y).asIdeal} := by
          ext y
          constructor
          · rintro ⟨v, rfl⟩
            have hv : V_g.ι.base v ∈ (V_g.ι.opensRange : Set U_M.toScheme) := by
              rw [V_g.ι.coe_opensRange]; exact ⟨v, rfl⟩
            rw [AlgebraicGeometry.Scheme.Opens.opensRange_ι] at hv
            have hv' : U_compl.ι.base ((p_M ∣_ U_compl).base (V_g.ι.base v)) ∈ B_g := hv
            have h_comm : U_compl.ι.base ((p_M ∣_ U_compl).base (V_g.ι.base v)) =
                p_M.base (U_M.ι.base (V_g.ι.base v)) := by
              change ((p_M ∣_ U_compl) ≫ U_compl.ι).base (V_g.ι.base v) =
                (U_M.ι ≫ p_M).base (V_g.ι.base v)
              rw [AlgebraicGeometry.morphismRestrict_ι]
            rw [h_comm] at hv'
            exact hv'
          · intro hy
            have hyB : p_M.base y ∈ B_g := hy
            have hyUM : y ∈ (U_M.ι.opensRange : Set M) := by
              rw [AlgebraicGeometry.Scheme.Opens.opensRange_ι]
              exact hg_le hyB
            rw [U_M.ι.coe_opensRange] at hyUM
            rcases hyUM with ⟨u, hu⟩
            have huV : u ∈ (V_g.ι.opensRange : Set U_M.toScheme) := by
              rw [AlgebraicGeometry.Scheme.Opens.opensRange_ι]
              change ((p_M ∣_ U_compl) ≫ U_compl.ι).base u ∈ B_g
              rw [AlgebraicGeometry.morphismRestrict_ι]
              change p_M.base (U_M.ι.base u) ∈ B_g
              rwa [hu]
            rw [V_g.ι.coe_opensRange] at huV
            rcases huV with ⟨v, hv⟩
            refine ⟨v, ?_⟩
            change U_M.ι.base (V_g.ι.base v) = y
            rw [hv, hu]
        rw [h_usrc]
        ext y
        constructor
        · intro hy
          have hy_top : y ∈ (ι_a.opensRange ⊔ ι_b.opensRange : M.Opens) := by
            rw [hSup']; trivial
          have hy_a : y ∈ (ι_a.opensRange : Set M) := by
            rcases hy_top with hya | hyb
            · exact hya
            · rw [ι_b.coe_opensRange] at hyb
              rcases hyb with ⟨qb, rfl⟩
              have hpbg : p_b g ∉ qb.asIdeal := by
                have h1 : g ∉ ((ι_b ≫ p_M).base qb).asIdeal := hy
                rw [hι_b_p, AlgebraicGeometry.Spec.map_base] at h1
                exact h1
              have htb : t_b ∉ qb.asIdeal := hg_mem qb hpbg
              have hqb_range : qb ∈ Set.range
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_ba)).base := by
                rw [AlgebraicGeometry.Spec.map_base]
                let _ : Algebra C_b C₀₁ := f_ba.toAlgebra
                have _ : IsLocalization.Away t_b C₀₁ := hloc_b
                change qb ∈ Set.range (PrimeSpectrum.comap (algebraMap C_b C₀₁))
                rw [PrimeSpectrum.localization_away_comap_range C₀₁ t_b]
                exact htb
              rcases hqb_range with ⟨z01, hz01⟩
              rw [ι_a.coe_opensRange]
              refine ⟨(AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_ab)).base z01, ?_⟩
              calc
                ι_a.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_ab)).base z01)
                  = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_ab) ≫ ι_a).base z01 := rfl
                _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_ba) ≫ ι_b).base z01 := by
                  rw [hOv']
                _ = ι_b.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_ba)).base z01) := rfl
                _ = ι_b.base qb := by rw [hz01]
          rw [ι_a.coe_opensRange] at hy_a
          rcases hy_a with ⟨qa, rfl⟩
          have hpag : p_a g ∉ qa.asIdeal := by
            have h1 : g ∉ ((ι_a ≫ p_M).base qa).asIdeal := hy
            rw [hι_a_p, AlgebraicGeometry.Spec.map_base] at h1
            exact h1
          have hqa_range : qa ∈ Set.range j_ag_loc.base := by
            dsimp only [j_ag_loc]
            rw [AlgebraicGeometry.Spec.map_base]
            change qa ∈ Set.range (PrimeSpectrum.comap (algebraMap C_a (Localization.Away (p_a g))))
            rw [PrimeSpectrum.localization_away_comap_range (Localization.Away (p_a g)) (p_a g)]
            exact hpag
          rcases hqa_range with ⟨z, hz⟩
          refine ⟨z, ?_⟩
          change ι_a.base (j_ag_loc.base z) = ι_a.base qa
          rw [hz]
        · rintro ⟨z, rfl⟩
          have hz_mem : j_ag_loc.base z ∈ Set.range j_ag_loc.base := ⟨z, rfl⟩
          dsimp only [j_ag_loc] at hz_mem
          rw [AlgebraicGeometry.Spec.map_base] at hz_mem
          change j_ag_loc.base z ∈
            Set.range (PrimeSpectrum.comap (algebraMap C_a (Localization.Away (p_a g)))) at hz_mem
          rw [PrimeSpectrum.localization_away_comap_range (Localization.Away (p_a g)) (p_a g)] at hz_mem
          have hpag : p_a g ∉ (j_ag_loc.base z).asIdeal := hz_mem
          change g ∉ ((ι_a ≫ p_M).base (j_ag_loc.base z)).asIdeal
          rw [hι_a_p, AlgebraicGeometry.Spec.map_base]
          exact hpag
      let e_src : V_g.toScheme ≅
          AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (p_a g))) :=
        AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq u_src j_ag hRange_src
      have he_src : e_src.hom ≫ j_ag = u_src :=
        AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac u_src j_ag hRange_src
      let _ : Algebra A (Localization.Away (p_a g)) :=
        ((algebraMap C_a (Localization.Away (p_a g))).comp p_a).toAlgebra
      have _ : IsLocalization.Away g (Localization.Away (p_a g)) := hg_loc
      let e_alg : Localization.Away g ≃ₐ[A] Localization.Away (p_a g) :=
        IsLocalization.algEquiv (Submonoid.powers g)
          (Localization.Away g) (Localization.Away (p_a g))
      let e_spec : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (p_a g))) ≅
          AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away g)) :=
        { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_alg.toRingHom)
          inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_alg.symm.toRingHom)
          hom_inv_id := by
            rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
            have h1 : e_alg.toRingHom.comp e_alg.symm.toRingHom = RingHom.id _ :=
              RingHom.ext e_alg.right_inv
            rw [h1]
            exact AlgebraicGeometry.Spec.map_id _
          inv_hom_id := by
            rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
            have h1 : e_alg.symm.toRingHom.comp e_alg.toRingHom = RingHom.id _ :=
              RingHom.ext e_alg.left_inv
            rw [h1]
            exact AlgebraicGeometry.Spec.map_id _ }
      have he_spec_comm : e_spec.hom ≫ j_Ag = j_ag ≫ p_M := by
        dsimp only [e_spec, j_Ag, j_ag, j_ag_loc]
        rw [Category.assoc, hι_a_p, ← AlgebraicGeometry.Spec.map_comp,
          ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
        congr 1
        exact congrArg CommRingCat.ofHom (RingHom.ext fun r => e_alg.commutes r)
      have h_eq_iso : ((p_M ∣_ U_compl) ∣_ W_g) =
          (e_src ≪≫ e_spec ≪≫ e_tgt.symm).hom := by
        apply (cancel_mono u_tgt).mp
        have lhs_eq : ((p_M ∣_ U_compl) ∣_ W_g) ≫ u_tgt = u_src ≫ p_M := by
          dsimp only [u_tgt, u_src]
          rw [← Category.assoc, AlgebraicGeometry.morphismRestrict_ι, Category.assoc,
            AlgebraicGeometry.morphismRestrict_ι, ← Category.assoc]
        have rhs_eq : (e_src ≪≫ e_spec ≪≫ e_tgt.symm).hom ≫ u_tgt = u_src ≫ p_M := by
          change (e_src.hom ≫ e_spec.hom ≫ e_tgt.inv) ≫ u_tgt = u_src ≫ p_M
          rw [← he_tgt, Category.assoc, Category.assoc, Iso.inv_hom_id_assoc,
            he_spec_comm, ← Category.assoc, he_src]
        exact lhs_eq.trans rhs_eq.symm
      rw [h_eq_iso]
      infer_instance
    have hloc₁ : @IsLocalization.Away C₁ _ t₁ C₀₁ _ (algebraMap C₁ C₀₁).toAlgebra := by
      convert (inferInstance : IsLocalization.Away t₁ C₀₁)
      exact Algebra.algebra_ext _ _ fun _ => rfl
    rw [← CategoryTheory.MorphismProperty.isomorphisms.iff]
    rw [AlgebraicGeometry.IsZariskiLocalAtTarget.iff_of_iSup_eq_top
      (P := CategoryTheory.MorphismProperty.isomorphisms AlgebraicGeometry.Scheme.{u})
      W_fam hW_cov]
    rintro (_ | _)
    · rw [CategoryTheory.MorphismProperty.isomorphisms.iff]
      exact hSingleIso C₀ C₁ p₀ p₁ t₁ f₀₁ (algebraMap C₁ C₀₁) hloc₁ ι₀ ι₁
        hOv hSup hι₀_p hι₁_p g₀ hg₀_le hg₀_mem hg₀_loc
    · rw [CategoryTheory.MorphismProperty.isomorphisms.iff]
      exact hSingleIso C₁ C₀ p₁ p₀ s₀ (algebraMap C₁ C₀₁) f₀₁ hloc₀ ι₁ ι₀
        hOv.symm ((sup_comm _ _).trans hSup) hι₁_p hι₀_p g₁ hg₁_le hg₁_mem hg₁_loc
  exact ⟨M, p_M, ι₀, ι₁, hOpen₀, hOpen₁, ι_M, φ₀, φ₁,
    hCl_M, hιM_p, hProp_M, hIso_compl, hι₀_p, hι₁_p, hOv, hSup,
    hPre₀, hPre₁, hφ₀, hφ₁, hι₀_M, hι₁_M⟩

theorem weil_p1_closedSubscheme_fiber_pullback_and_infinity_point (A C₀ C₁ : Type u) [CommRing A] [CommRing C₀] [CommRing C₁]
    (hAff_A : ∀ a : Fin (1 + 1), AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen A 1 a))
    (c_A : ∀ a : Fin (1 + 1),
      A →+* ↑((weilProjectiveSpaceOver A 1).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen A 1 a))))
    (t_A : ∀ a : Fin (1 + 1), Fin (1 + 1) →
      ↑((weilProjectiveSpaceOver A 1).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen A 1 a))))
    (M : AlgebraicGeometry.Scheme.{u})
    (p_M : M ⟶ AlgebraicGeometry.Spec (CommRingCat.of A))
    (ι₀ : AlgebraicGeometry.Spec (CommRingCat.of C₀) ⟶ M)
    (ι₁ : AlgebraicGeometry.Spec (CommRingCat.of C₁) ⟶ M)
    [hOpen₁ : AlgebraicGeometry.IsOpenImmersion ι₁]
    (ι_M : M ⟶ (weilProjectiveSpaceOver A 1).left)
    [hCl_M : AlgebraicGeometry.IsClosedImmersion ι_M]
    (hιM_p : ι_M ≫ (weilProjectiveSpaceOver A 1).hom = p_M)
    (hPre₁ : (TopologicalSpace.Opens.map ι_M.base).obj (weilProjBasicOpen A 1 1) = ι₁.opensRange)
    (p₀ : A →+* C₀) (p₁ : A →+* C₁) (s₀ : C₀) (t₁ : C₁)
    (φ₀ : ↑((weilProjectiveSpaceOver A 1).left.presheaf.obj
      (Opposite.op (weilProjBasicOpen A 1 0))) →+* C₀)
    (φ₁ : ↑((weilProjectiveSpaceOver A 1).left.presheaf.obj
      (Opposite.op (weilProjBasicOpen A 1 1))) →+* C₁)
    (hCoord_A : IsCommRingProjCoordSystem A 1 hAff_A c_A t_A)
    (hφ₀ : φ₀.comp (c_A 0) = p₀ ∧ φ₀ (t_A 0 0) = 1 ∧ φ₀ (t_A 0 1) = s₀)
    (hφ₁ : φ₁.comp (c_A 1) = p₁ ∧ φ₁ (t_A 1 0) = t₁ ∧ φ₁ (t_A 1 1) = 1)
    (hι₀_M : ι₀ ≫ ι_M = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀) ≫ (hAff_A 0).fromSpec)
    (hι₁_M : ι₁ ≫ ι_M = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁) ≫ (hAff_A 1).fromSpec)
    (κ : Type u) [Field κ] (ε_A : A →+* κ)
    (hAff_κ : ∀ a : Fin (1 + 1), AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen κ 1 a))
    (c_κ : ∀ a : Fin (1 + 1),
      κ →+* ↑((weilProjectiveSpaceOver κ 1).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen κ 1 a))))
    (t_κ : ∀ a : Fin (1 + 1), Fin (1 + 1) →
      ↑((weilProjectiveSpaceOver κ 1).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen κ 1 a))))
    (hCoord_κ : IsCommRingProjCoordSystem κ 1 hAff_κ c_κ t_κ)
    (Φ : (weilProjectiveSpaceOver κ 1).left ⟶ (weilProjectiveSpaceOver A 1).left)
    (hBC : IsCommRingProjBaseChange A κ ε_A 1 c_A t_A c_κ t_κ Φ)
    (α₀ : C₀ →+* ↑((weilProjectiveSpaceOver κ 1).left.presheaf.obj
      (Opposite.op (weilProjBasicOpen κ 1 0))))
    (α₁ : C₁ →+* ↑((weilProjectiveSpaceOver κ 1).left.presheaf.obj
      (Opposite.op (weilProjBasicOpen κ 1 1))))
    (hα₀ : α₀.comp p₀ = (c_κ 0).comp ε_A ∧ α₀ s₀ = t_κ 0 1)
    (hα₁ : α₁.comp p₁ = (c_κ 1).comp ε_A ∧ α₁ t₁ = t_κ 1 0) :
    ∃ (γ_M : (weilProjectiveSpaceOver κ 1).left ⟶ M)
      (s_e1 : AlgebraicGeometry.Spec (CommRingCat.of κ) ⟶ (weilProjectiveSpaceOver κ 1).left)
      (ψ_e1 : ↑((weilProjectiveSpaceOver κ 1).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen κ 1 0))) →+* κ),
      CategoryTheory.IsPullback γ_M (weilProjectiveSpaceOver κ 1).hom
        p_M (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ε_A)) ∧
      Nonempty ↥((TopologicalSpace.Opens.map γ_M.base).obj ι₁.opensRange) ∧
      s_e1 ≫ (weilProjectiveSpaceOver κ 1).hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of κ)) ∧
      ψ_e1.comp (c_κ 0) = RingHom.id κ ∧
      ψ_e1 (t_κ 0 1) = 0 ∧
      s_e1 ≫ γ_M = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_e1.comp α₀)) ≫ ι₀ ∧
      ∀ e : ↥(weilProjectiveSpaceOver κ 1).left,
        γ_M.base e ∉ ι₁.opensRange ↔ e ∈ Set.range s_e1.base :=
by
  let P_A := (weilProjectiveSpaceOver A 1).left
  let π_A := (weilProjectiveSpaceOver A 1).hom
  let P_κ := (weilProjectiveSpaceOver κ 1).left
  let π_κ := (weilProjectiveSpaceOver κ 1).hom
  have hCov_κ : (⨆ a : Fin (1 + 1), weilProjBasicOpen κ 1 a) = ⊤ := hCoord_κ.2.1
  have hc_κ_spec : ∀ a : Fin (1 + 1),
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (c_κ a)) = (hAff_κ a).fromSpec ≫ π_κ :=
    hCoord_κ.2.2.1
  have ht_κ_diag : ∀ a : Fin (1 + 1), t_κ a a = 1 := hCoord_κ.2.2.2.2.1
  have hGen_A : ∀ a : Fin (1 + 1),
      Subring.closure (Set.range (c_A a) ∪ Set.range (t_A a)) = ⊤ := hCoord_A.2.2.2.2.2.1
  have hGen_κ : ∀ a : Fin (1 + 1),
      Subring.closure (Set.range (c_κ a) ∪ Set.range (t_κ a)) = ⊤ := hCoord_κ.2.2.2.2.2.1
  have hEval_κ := hCoord_κ.2.2.2.2.2.2.1
  have hInter_κ : ∀ a a' : Fin (1 + 1),
      P_κ.basicOpen (t_κ a a') = weilProjBasicOpen κ 1 a ⊓ weilProjBasicOpen κ 1 a' :=
    hCoord_κ.2.2.2.2.2.2.2.1
  have hBC_comm := hBC.1
  have hBC_pb := hBC.2.1
  obtain ⟨heq₀, hBC_c₀, hBC_t₀⟩ := hBC.2.2 0
  obtain ⟨heq₁, hBC_c₁, hBC_t₁⟩ := hBC.2.2 1
  let θ₀ := Φ.appLE (weilProjBasicOpen A 1 0) (weilProjBasicOpen κ 1 0) heq₀.symm.le
  let θ₁ := Φ.appLE (weilProjBasicOpen A 1 1) (weilProjBasicOpen κ 1 1) heq₁.symm.le
  have hθ₀_eq : Φ.app (weilProjBasicOpen A 1 0) ≫
      P_κ.presheaf.map (CategoryTheory.eqToHom heq₀.symm).op = θ₀ := by
    rw [← Φ.appLE_eq_app, Φ.appLE_map']
  have hθ₁_eq : Φ.app (weilProjBasicOpen A 1 1) ≫
      P_κ.presheaf.map (CategoryTheory.eqToHom heq₁.symm).op = θ₁ := by
    rw [← Φ.appLE_eq_app, Φ.appLE_map']
  have hθ₀_c : ∀ r : A, θ₀.hom (c_A 0 r) = c_κ 0 (ε_A r) := by
    intro r; rw [← hθ₀_eq]; exact hBC_c₀ r
  have hθ₀_t : ∀ b : Fin (1 + 1), θ₀.hom (t_A 0 b) = t_κ 0 b := by
    intro b; rw [← hθ₀_eq]; exact hBC_t₀ b
  have hθ₁_c : ∀ r : A, θ₁.hom (c_A 1 r) = c_κ 1 (ε_A r) := by
    intro r; rw [← hθ₁_eq]; exact hBC_c₁ r
  have hθ₁_t : ∀ b : Fin (1 + 1), θ₁.hom (t_A 1 b) = t_κ 1 b := by
    intro b; rw [← hθ₁_eq]; exact hBC_t₁ b
  have hαφ₀ : CommRingCat.ofHom (α₀.comp φ₀) = θ₀ := by
    have hsub : (⊤ : Subring ↑(P_A.presheaf.obj (Opposite.op (weilProjBasicOpen A 1 0)))) ≤
        RingHom.eqLocus (α₀.comp φ₀) θ₀.hom := by
      rw [← hGen_A 0, Subring.closure_le]
      rintro y (⟨r, rfl⟩ | ⟨b, rfl⟩)
      · show α₀ (φ₀ (c_A 0 r)) = θ₀.hom (c_A 0 r)
        have h1 : φ₀ (c_A 0 r) = p₀ r := RingHom.congr_fun hφ₀.1 r
        have h2 : α₀ (p₀ r) = c_κ 0 (ε_A r) := RingHom.congr_fun hα₀.1 r
        rw [h1, h2, hθ₀_c]
      · fin_cases b
        · show α₀ (φ₀ (t_A 0 0)) = θ₀.hom (t_A 0 0)
          rw [hφ₀.2.1, map_one, hθ₀_t, ht_κ_diag 0]
        · show α₀ (φ₀ (t_A 0 1)) = θ₀.hom (t_A 0 1)
          rw [hφ₀.2.2, hα₀.2, hθ₀_t]
    ext x
    exact hsub trivial
  have hαφ₁ : CommRingCat.ofHom (α₁.comp φ₁) = θ₁ := by
    have hsub : (⊤ : Subring ↑(P_A.presheaf.obj (Opposite.op (weilProjBasicOpen A 1 1)))) ≤
        RingHom.eqLocus (α₁.comp φ₁) θ₁.hom := by
      rw [← hGen_A 1, Subring.closure_le]
      rintro y (⟨r, rfl⟩ | ⟨b, rfl⟩)
      · show α₁ (φ₁ (c_A 1 r)) = θ₁.hom (c_A 1 r)
        have h1 : φ₁ (c_A 1 r) = p₁ r := RingHom.congr_fun hφ₁.1 r
        have h2 : α₁ (p₁ r) = c_κ 1 (ε_A r) := RingHom.congr_fun hα₁.1 r
        rw [h1, h2, hθ₁_c]
      · fin_cases b
        · show α₁ (φ₁ (t_A 1 0)) = θ₁.hom (t_A 1 0)
          rw [hφ₁.2.1, hα₁.2, hθ₁_t]
        · show α₁ (φ₁ (t_A 1 1)) = θ₁.hom (t_A 1 1)
          rw [hφ₁.2.2, map_one, hθ₁_t, ht_κ_diag 1]
    ext x
    exact hsub trivial
  let α₀_spec := AlgebraicGeometry.Spec.map (CommRingCat.ofHom α₀)
  let α₁_spec := AlgebraicGeometry.Spec.map (CommRingCat.ofHom α₁)
  let g₀_chart : (weilProjBasicOpen κ 1 0).toScheme ⟶ M :=
    (hAff_κ 0).isoSpec.hom ≫ α₀_spec ≫ ι₀
  let g₁_chart : (weilProjBasicOpen κ 1 1).toScheme ⟶ M :=
    (hAff_κ 1).isoSpec.hom ≫ α₁_spec ≫ ι₁
  let 𝒰 := P_κ.openCoverOfIsOpenCover (weilProjBasicOpen κ 1)
    (TopologicalSpace.IsOpenCover.mk hCov_κ)
  let g : ∀ a : 𝒰.I₀, 𝒰.X a ⟶ M := fun a =>
    match (a : Fin (1 + 1)) with
    | ⟨0, _⟩ => g₀_chart
    | ⟨1, _⟩ => g₁_chart
  have hg_ιM : ∀ a : 𝒰.I₀, g a ≫ ι_M = 𝒰.f a ≫ Φ := by
    change ∀ a : Fin (1 + 1), g a ≫ ι_M = (weilProjBasicOpen κ 1 a).ι ≫ Φ
    intro a
    fin_cases a
    · change g₀_chart ≫ ι_M = (weilProjBasicOpen κ 1 0).ι ≫ Φ
      dsimp only [g₀_chart, α₀_spec]
      rw [Category.assoc, Category.assoc, hι₀_M,
        ← Category.assoc (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α₀)),
        ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hαφ₀,
        AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec Φ (hAff_A 0) (hAff_κ 0) heq₀.symm.le,
        (hAff_κ 0).isoSpec_hom, ← Category.assoc, (hAff_κ 0).toSpecΓ_fromSpec]
    · change g₁_chart ≫ ι_M = (weilProjBasicOpen κ 1 1).ι ≫ Φ
      dsimp only [g₁_chart, α₁_spec]
      rw [Category.assoc, Category.assoc, hι₁_M,
        ← Category.assoc (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α₁)),
        ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hαφ₁,
        AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec Φ (hAff_A 1) (hAff_κ 1) heq₁.symm.le,
        (hAff_κ 1).isoSpec_hom, ← Category.assoc, (hAff_κ 1).toSpecΓ_fromSpec]
  have hglue : ∀ x y : 𝒰.I₀,
      CategoryTheory.Limits.pullback.fst (𝒰.f x) (𝒰.f y) ≫ g x =
        CategoryTheory.Limits.pullback.snd (𝒰.f x) (𝒰.f y) ≫ g y := by
    intro x y
    apply (CategoryTheory.cancel_mono ι_M).mp
    rw [Category.assoc, Category.assoc, hg_ιM x, hg_ιM y,
      ← Category.assoc, CategoryTheory.Limits.pullback.condition, Category.assoc]
  let γ_M : P_κ ⟶ M := 𝒰.glueMorphisms g hglue
  have hγ_ιM : γ_M ≫ ι_M = Φ := by
    apply 𝒰.hom_ext
    intro a
    rw [← Category.assoc, 𝒰.ι_glueMorphisms, hg_ιM]
  have hfrom0_γ :
      (hAff_κ 0).fromSpec ≫ γ_M =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom α₀) ≫ ι₀ := by
    have h0_glue : (weilProjBasicOpen κ 1 0).ι ≫ γ_M = g₀_chart :=
      𝒰.ι_glueMorphisms g hglue (0 : Fin (1 + 1))
    rw [← (hAff_κ 0).isoSpec_inv_ι, Category.assoc, h0_glue]
    dsimp only [g₀_chart, α₀_spec]
    rw [Iso.inv_hom_id_assoc]
  let s_ε := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ε_A)
  have hcomm_γ : γ_M ≫ p_M = π_κ ≫ s_ε := by
    rw [← hιM_p, ← Category.assoc, hγ_ιM, hBC_comm]
  have hcone : ∀ c : CategoryTheory.Limits.PullbackCone p_M s_ε,
      (c.fst ≫ ι_M) ≫ π_A = c.snd ≫ s_ε := by
    intro c
    rw [Category.assoc, hιM_p, c.condition]
  have hPb_γ : CategoryTheory.IsPullback γ_M π_κ p_M s_ε := by
    refine CategoryTheory.IsPullback.of_isLimit
      (CategoryTheory.Limits.PullbackCone.IsLimit.mk hcomm_γ
        (fun c => hBC_pb.lift (c.fst ≫ ι_M) c.snd (hcone c)) ?_ ?_ ?_)
    · intro c
      apply (CategoryTheory.cancel_mono ι_M).mp
      rw [Category.assoc, hγ_ιM, hBC_pb.lift_fst]
    · intro c
      exact hBC_pb.lift_snd _ _ _
    · intro c m hm₁ hm₂
      apply hBC_pb.hom_ext
      · calc
          m ≫ Φ = m ≫ (γ_M ≫ ι_M) := by rw [hγ_ιM]
          _ = (m ≫ γ_M) ≫ ι_M := (Category.assoc _ _ _).symm
          _ = c.fst ≫ ι_M := by rw [hm₁]
          _ = hBC_pb.lift (c.fst ≫ ι_M) c.snd (hcone c) ≫ Φ := (hBC_pb.lift_fst _ _ _).symm
      · rw [hm₂, hBC_pb.lift_snd]
  have hPre_γ1 :
      (TopologicalSpace.Opens.map γ_M.base).obj ι₁.opensRange = weilProjBasicOpen κ 1 1 := by
    rw [← hPre₁, ← TopologicalSpace.Opens.map_comp_obj,
      ← AlgebraicGeometry.Scheme.Hom.comp_base, hγ_ιM, heq₁]
  let pt₀ : PrimeSpectrum κ := ⟨⊥, Ideal.isPrime_bot⟩
  have hNonempty_1 : Nonempty ↥((TopologicalSpace.Opens.map γ_M.base).obj ι₁.opensRange) := by
    rw [hPre_γ1]
    obtain ⟨ψ_e2, _, _⟩ :=
      hEval_κ 1 κ (RingHom.id κ) (fun b => if b = 1 then 1 else 0) (by simp)
    let x₁ := (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_e2)).base pt₀
    have hx₁_mem : (hAff_κ 1).fromSpec.base x₁ ∈ weilProjBasicOpen κ 1 1 := by
      change (hAff_κ 1).fromSpec.base x₁ ∈ (weilProjBasicOpen κ 1 1 : Set ↥P_κ)
      rw [← (hAff_κ 1).range_fromSpec]
      exact ⟨x₁, rfl⟩
    exact ⟨⟨(hAff_κ 1).fromSpec.base x₁, hx₁_mem⟩⟩
  obtain ⟨ψ_e1, hψ_c, hψ_v⟩ :=
    hEval_κ 0 κ (RingHom.id κ) (fun b => if b = 0 then 1 else 0) (by simp)
  have hψ_t : ψ_e1 (t_κ 0 1) = 0 := by
    rw [hψ_v 1]
    simp
  let s_e1 : AlgebraicGeometry.Spec (CommRingCat.of κ) ⟶ P_κ :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_e1) ≫ (hAff_κ 0).fromSpec
  have hs_sec : s_e1 ≫ π_κ = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of κ)) := by
    dsimp only [s_e1]
    rw [Category.assoc, ← hc_κ_spec 0, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp, hψ_c, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
  have hs_γ :
      s_e1 ≫ γ_M = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_e1.comp α₀)) ≫ ι₀ := by
    dsimp only [s_e1]
    rw [Category.assoc, hfrom0_γ, ← Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp]
  have hSurj_ψ : Function.Surjective ψ_e1 := fun x =>
    ⟨c_κ 0 x, RingHom.congr_fun hψ_c x⟩
  have hMax_ker : (RingHom.ker ψ_e1).IsMaximal :=
    RingHom.ker_isMaximal_of_surjective ψ_e1 hSurj_ψ
  have hker_le_span : RingHom.ker ψ_e1 ≤ Ideal.span {t_κ 0 1} := by
    let J := Ideal.span {t_κ 0 1}
    let μ₁ := Ideal.Quotient.mk J
    let μ₂ := (Ideal.Quotient.mk J).comp ((c_κ 0).comp ψ_e1)
    have hμ_sub : (⊤ : Subring ↑(P_κ.presheaf.obj (Opposite.op (weilProjBasicOpen κ 1 0)))) ≤
        RingHom.eqLocus μ₁ μ₂ := by
      rw [← hGen_κ 0, Subring.closure_le]
      rintro y (⟨x, rfl⟩ | ⟨b, rfl⟩)
      · show μ₁ (c_κ 0 x) = μ₂ (c_κ 0 x)
        change Ideal.Quotient.mk J (c_κ 0 x) = Ideal.Quotient.mk J (c_κ 0 (ψ_e1 (c_κ 0 x)))
        rw [show ψ_e1 (c_κ 0 x) = x from RingHom.congr_fun hψ_c x]
      · fin_cases b
        · show μ₁ (t_κ 0 0) = μ₂ (t_κ 0 0)
          rw [ht_κ_diag 0, map_one, map_one]
        · show μ₁ (t_κ 0 1) = μ₂ (t_κ 0 1)
          have h1 : μ₁ (t_κ 0 1) = 0 :=
            Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)
          have h2 : μ₂ (t_κ 0 1) = 0 := by
            change Ideal.Quotient.mk J (c_κ 0 (ψ_e1 (t_κ 0 1))) = 0
            rw [hψ_t, map_zero, map_zero]
          rw [h1, h2]
    intro f hf
    have hμ_eq : μ₁ f = μ₂ f := hμ_sub trivial
    have hμ₂_0 : μ₂ f = 0 := by
      change Ideal.Quotient.mk J (c_κ 0 (ψ_e1 f)) = 0
      have hf0 : ψ_e1 f = 0 := hf
      rw [hf0, map_zero, map_zero]
    rw [hμ₂_0] at hμ_eq
    exact Ideal.Quotient.eq_zero_iff_mem.mp hμ_eq
  refine ⟨γ_M, s_e1, ψ_e1, hPb_γ, hNonempty_1, hs_sec, hψ_c, hψ_t, hs_γ, ?_⟩
  intro e
  have hmem_iff : γ_M.base e ∈ ι₁.opensRange ↔ e ∈ weilProjBasicOpen κ 1 1 := by
    change e ∈ (TopologicalSpace.Opens.map γ_M.base).obj ι₁.opensRange ↔ _
    rw [hPre_γ1]
  rw [not_iff_not.mpr hmem_iff]
  constructor
  · intro he₁
    have he_top : e ∈ (⨆ a : Fin (1 + 1), weilProjBasicOpen κ 1 a) := by
      rw [hCov_κ]; trivial
    rw [TopologicalSpace.Opens.mem_iSup] at he_top
    obtain ⟨a, ha⟩ := he_top
    have he₀ : e ∈ weilProjBasicOpen κ 1 0 := by
      fin_cases a
      · exact ha
      · exact absurd ha he₁
    have he₀_range : e ∈ Set.range ⇑(hAff_κ 0).fromSpec := by
      rw [(hAff_κ 0).range_fromSpec]
      exact he₀
    obtain ⟨q, hq⟩ := he₀_range
    have ht_q : t_κ 0 1 ∈ q.asIdeal := by
      by_contra ht_not
      have hq_bo : q ∈ PrimeSpectrum.basicOpen (t_κ 0 1) :=
        (PrimeSpectrum.mem_basicOpen _ q).mpr ht_not
      rw [← (hAff_κ 0).fromSpec_preimage_basicOpen (t_κ 0 1)] at hq_bo
      have he_bo : (hAff_κ 0).fromSpec.base q ∈ P_κ.basicOpen (t_κ 0 1) := hq_bo
      rw [hq, hInter_κ 0 1] at he_bo
      exact he₁ he_bo.2
    have hker_le_q : RingHom.ker ψ_e1 ≤ q.asIdeal :=
      hker_le_span.trans (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr ht_q))
    have hker_eq_q : RingHom.ker ψ_e1 = q.asIdeal :=
      hMax_ker.eq_of_le q.isPrime.ne_top hker_le_q
    have hSpec_pt₀ :
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_e1)).base pt₀ = q := by
      apply PrimeSpectrum.ext
      change Ideal.comap ψ_e1 (⊥ : Ideal κ) = q.asIdeal
      exact hker_eq_q
    refine ⟨pt₀, ?_⟩
    dsimp only [s_e1]
    rw [AlgebraicGeometry.Scheme.Hom.comp_base]
    change (hAff_κ 0).fromSpec.base
      ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_e1)).base pt₀) = e
    rw [hSpec_pt₀]
    exact hq
  · rintro ⟨pt, hpt⟩ he₁
    let q₀ := (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_e1)).base pt
    have hq₀_e : (hAff_κ 0).fromSpec.base q₀ = e := by
      rw [← hpt]
      dsimp only [s_e1]
      rw [AlgebraicGeometry.Scheme.Hom.comp_base]
      rfl
    have he₀ : e ∈ weilProjBasicOpen κ 1 0 := by
      change e ∈ (weilProjBasicOpen κ 1 0 : Set ↥P_κ)
      rw [← (hAff_κ 0).range_fromSpec]
      exact ⟨q₀, hq₀_e⟩
    have he_bo : (hAff_κ 0).fromSpec.base q₀ ∈ P_κ.basicOpen (t_κ 0 1) := by
      rw [hq₀_e, hInter_κ 0 1]
      exact ⟨he₀, he₁⟩
    have hq₀_bo : q₀ ∈ PrimeSpectrum.basicOpen (t_κ 0 1) := by
      rw [← (hAff_κ 0).fromSpec_preimage_basicOpen (t_κ 0 1)]
      exact he_bo
    have ht_not : t_κ 0 1 ∉ q₀.asIdeal := (PrimeSpectrum.mem_basicOpen _ q₀).mp hq₀_bo
    have ht_mem : t_κ 0 1 ∈ q₀.asIdeal := by
      change ψ_e1 (t_κ 0 1) ∈ pt.asIdeal
      rw [hψ_t]
      exact pt.asIdeal.zero_mem
    exact ht_not ht_mem

theorem weil_overlap_smooth_linear_p1_blowup_model (K : Type u) [Field K]
    (V : ValuationSubring K)
    (P_z : Ideal ↥V) [P_z.IsPrime]
    (t_z s₁ c₁ π₁ : ↥V)
    (ht_z : t_z ∉ P_z)
    (R_z : Type u) [CommRing R_z] [Algebra ↥V R_z]
    [IsLocalization.Away t_z R_z] [IsLocalization.AtPrime R_z P_z]
    (hs₁ : s₁ ∉ P_z)
    (hπ₁_mem : π₁ ∈ P_z)
    (hπ₁_ne : π₁ ≠ 0) :
    (AlgebraicGeometry.SmoothOfRelativeDimension 1
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (Polynomial.C : ↥V →+* Polynomial ↥V))) ∧
      (⊥ : Ideal R_z) ≠ ⊤ ∧
      AlgebraicGeometry.IsOpenImmersion
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (Polynomial.mapRingHom (algebraMap ↥V R_z)))) ∧
      Set.range
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (Polynomial.mapRingHom (algebraMap ↥V R_z)))).base =
        {q : PrimeSpectrum (Polynomial ↥V) | Polynomial.C t_z ∉ q.asIdeal} ∧
      Function.Surjective
        ((Ideal.Quotient.mk
          (Ideal.span
            {(Polynomial.mapRingHom (algebraMap ↥V R_z))
              (Polynomial.C s₁ * Polynomial.X - Polynomial.C c₁)})).comp
          (Polynomial.C : R_z →+* Polynomial R_z)) ∧
      RingHom.ker
        ((Ideal.Quotient.mk
          (Ideal.span
            {(Polynomial.mapRingHom (algebraMap ↥V R_z))
              (Polynomial.C s₁ * Polynomial.X - Polynomial.C c₁)})).comp
          (Polynomial.C : R_z →+* Polynomial R_z)) = ⊥) ∧
    ∃ (M_sm : AlgebraicGeometry.Scheme.{u})
      (p_sm : M_sm ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial R_z)))
      (U_sm1 : M_sm.Opens)
      (e_sm1 : U_sm1.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial ↥V))),
      IsLocalOverlapBlowupModel V P_z π₁
        (CommRingCat.ofHom (Polynomial.C : R_z →+* Polynomial R_z))
        (Ideal.span
          {(Polynomial.mapRingHom (algebraMap ↥V R_z))
            (Polynomial.C s₁ * Polynomial.X - Polynomial.C c₁)})
        false p_sm ∧
      AlgebraicGeometry.Etale e_sm1 ∧
      U_sm1.ι ≫ p_sm ≫
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap ↥V R_z) ≫ CommRingCat.ofHom Polynomial.C) =
        e_sm1 ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) ∧
      AlgebraicGeometry.SmoothOfRelativeDimension 1
        (U_sm1.ι ≫ p_sm ≫
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap ↥V R_z) ≫ CommRingCat.ofHom Polynomial.C)) ∧
      (∀ (R : Type u) [CommRing R] [IsDomain R] [IsLocalRing R]
          (ψ_M : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ M_sm)
          (q : R),
        (AlgebraicGeometry.Spec.preimage
          (ψ_M ≫ p_sm ≫
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap ↥V R_z) ≫
                CommRingCat.ofHom Polynomial.C))).hom π₁ ≠ 0 →
        (AlgebraicGeometry.Spec.preimage
          (ψ_M ≫ p_sm ≫
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom
                (Polynomial.mapRingHom (algebraMap ↥V R_z))))).hom
            (Polynomial.C s₁ * Polynomial.X - Polynomial.C c₁) =
          (AlgebraicGeometry.Spec.preimage
            (ψ_M ≫ p_sm ≫
              AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (algebraMap ↥V R_z) ≫
                  CommRingCat.ofHom Polynomial.C))).hom π₁ * q →
        ∃ (ψ_U : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ U_sm1.toScheme),
          ψ_U ≫ U_sm1.ι = ψ_M ∧
          (AlgebraicGeometry.Spec.preimage
            (ψ_M ≫ p_sm ≫
              AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (algebraMap ↥V R_z) ≫
                  CommRingCat.ofHom Polynomial.C))).hom π₁ *
              (AlgebraicGeometry.Spec.preimage (ψ_U ≫ e_sm1)).hom Polynomial.X =
            (AlgebraicGeometry.Spec.preimage
              (ψ_M ≫ p_sm ≫
                AlgebraicGeometry.Spec.map
                  (CommRingCat.ofHom (algebraMap ↥V R_z) ≫
