        (eqToHom p ≫ 𝟙 S₀₁ ≫ eqToHom q.symm) ≫ (eqToHom q ≫ g) = eqToHom p ≫ g := by
      intro V₀₁ V₁₀ U₁ p q g
      subst p; subst q
      simp
    have htf_01 : D_cat.t i₀ i₁ ≫ D_cat.f i₁ i₀ = eqToHom p₀₁ ≫ j₁₀ :=
      (congrArg₂ CategoryStruct.comp ht_01 hf_10).trans (h_eq_clean p₀₁ p₁₀ j₁₀)
    have htf_10 : D_cat.t i₁ i₀ ≫ D_cat.f i₀ i₁ = eqToHom p₁₀ ≫ j₀₁ :=
      (congrArg₂ CategoryStruct.comp ht_10 hf_01).trans (h_eq_clean p₁₀ p₀₁ j₀₁)
    have ht_00 : D_cat.t i₀ i₀ = 𝟙 (D_cat.V (i₀, i₀)) :=
      @dif_pos (i₀ = i₀) (Classical.propDecidable _) rfl _ _ _
    have ht_11 : D_cat.t i₁ i₁ = 𝟙 (D_cat.V (i₁, i₁)) :=
      @dif_pos (i₁ = i₁) (Classical.propDecidable _) rfl _ _ _
    let M : AlgebraicGeometry.Scheme.{u} := D.glued
    let ι₀ : S₀ ⟶ M := D.ι i₀
    let ι₁ : S₁ ⟶ M := D.ι i₁
    let hOpen₀ : AlgebraicGeometry.IsOpenImmersion ι₀ := D.ι_isOpenImmersion i₀
    let hOpen₁ : AlgebraicGeometry.IsOpenImmersion ι₁ := D.ι_isOpenImmersion i₁
    let _ : AlgebraicGeometry.IsOpenImmersion ι₀ := hOpen₀
    let _ : AlgebraicGeometry.IsOpenImmersion ι₁ := hOpen₁
    have hOv : j₀₁ ≫ ι₀ = j₁₀ ≫ ι₁ := by
      have hgc : (D_cat.t i₀ i₁ ≫ D_cat.f i₁ i₀) ≫ ι₁ = D_cat.f i₀ i₁ ≫ ι₀ :=
        (Category.assoc _ _ _).trans (D.glue_condition i₀ i₁)
      have hgc' : eqToHom p₀₁ ≫ (j₁₀ ≫ ι₁) = eqToHom p₀₁ ≫ (j₀₁ ≫ ι₀) :=
        (Category.assoc _ _ _).symm.trans
          (((congrArg (· ≫ ι₁) htf_01).symm.trans hgc).trans
