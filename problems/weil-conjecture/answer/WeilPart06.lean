      refine ⟨hVal, ?_⟩
      letI : ValuationRing D_u := hVal
      let ι_D := AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (Ideal.Quotient.mk p_u) :
          Z.presheaf.obj (Opposite.op U₀) ⟶ CommRingCat.of D_u) ≫ hU0.fromSpec
      let γ_Du : ↥V →+* D_u :=
        (Ideal.Quotient.mk p_u).comp
          (AlgebraicGeometry.Spec.preimage (hU0.fromSpec ≫ g_Z)).hom
