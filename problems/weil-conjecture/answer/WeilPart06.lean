        t_inv := fun _ _ _ => Category.id_comp (𝟙 S₀₁)
        t' := by
          rintro ⟨_ | _⟩ ⟨_ | _⟩ ⟨_ | _⟩ hij hik hjk <;>
            first | exact False.elim (hij rfl) | exact False.elim (hik rfl) | exact False.elim (hjk rfl)
        t_fac := by
          rintro ⟨_ | _⟩ ⟨_ | _⟩ ⟨_ | _⟩ hij hik hjk <;>
            first | exact False.elim (hij rfl) | exact False.elim (hik rfl) | exact False.elim (hjk rfl)
        cocycle := by
          rintro ⟨_ | _⟩ ⟨_ | _⟩ ⟨_ | _⟩ hij hik hjk <;>
