  let Φbar₁ : R₀ →+* Polynomial k₀ := Ideal.Quotient.lift I₀ Φ₁ (fun _ hx => hI₀_Φ₁ hx)
  have hX₀_Φ₁ : Ideal.span {Xbar₀} ≤ RingHom.ker Φbar₁ := by
