        AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec (U_K.ι ≫ p_K) hU_sp hV_sm he_sm
      have h_comp_spec : AlgebraicGeometry.Spec.map (iso_K_RU.hom ≫ ((U_K.ι ≫ p_K).appLE U_sp V_sm he_sm) ≫ ψ_K) =
          η_UK ≫ U_K.ι ≫ p_K := by
        calc AlgebraicGeometry.Spec.map (iso_K_RU.hom ≫ ((U_K.ι ≫ p_K).appLE U_sp V_sm he_sm) ≫ ψ_K)
