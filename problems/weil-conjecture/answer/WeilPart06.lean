        dsimp only [x₀_im, x_br]
        rw [map_mul β_br, map_add β_br, hβ_C s_inv, hβ_u, hβ_C c]
        rfl
    refine ⟨τ_br, ε_A, β_br, hτ_C, hτ_u, rfl, hε_C, hε_u, hε_π, hτ_univ, hβ_p₀, ?_⟩
    intro R_κ0 R_κ1 _ _ c_κ0 t_κ01 c_κ1 t_κ10
    have hα₀_rel : (0 : R_κ0) * t_κ01 = (c_κ0.comp ρ) π := by
      rw [zero_mul, RingHom.comp_apply, hρ_π, map_zero]
    obtain ⟨α₀, _, hα₀_C, hα₀_u, hα₀_s⟩ :=
