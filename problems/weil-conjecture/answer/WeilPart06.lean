      _ = ⊥ := Y.basicOpen_zero B_s

theorem weil_reduced_smooth_partition_gluing_and_pullback_injective (Y : AlgebraicGeometry.Scheme.{u})
    (hRedY : AlgebraicGeometry.IsReduced Y)
    (U_sm : Y.Opens)
    (L_comp : ℕ)
    (U_part : Fin (L_comp + 1) → Y.Opens)
    (hPartSup : (⨆ a : Fin (L_comp + 1), U_part a) = U_sm)
    (hPartDisj : _root_.Pairwise fun a b : Fin (L_comp + 1) => Disjoint (U_part a) (U_part b))
    (Y_tilde : Fin (L_comp + 1) → AlgebraicGeometry.Scheme.{u})
    (ι_tilde : ∀ a : Fin (L_comp + 1), Y_tilde a ⟶ Y)
    (hSurjAll : (⋃ a : Fin (L_comp + 1), Set.range (ι_tilde a).base) = Set.univ)
    (hComp : ∀ a : Fin (L_comp + 1),
      AlgebraicGeometry.IsIntegral (Y_tilde a) ∧
      Set.range (ι_tilde a).base ∈ irreducibleComponents ↥Y ∧
      (U_part a : Set ↥Y) = Set.range (ι_tilde a).base ∩ (U_sm : Set ↥Y) ∧
      Nonempty ↥(U_part a) ∧
      CategoryTheory.IsIso (ι_tilde a ∣_ U_part a))
    (U_Y0 : Y.Opens)
    (hSingIn0 : (U_sm : Set ↥Y)ᶜ ⊆ (U_Y0 : Set ↥Y)) :
    Function.Injective
      (fun (f : ↑(Y.presheaf.obj (Opposite.op U_Y0))) (a : Fin (L_comp + 1)) =>
        ((ι_tilde a).app U_Y0).hom f) ∧
    ∀ (h : ∀ a : Fin (L_comp + 1),
        ↑((Y_tilde a).presheaf.obj (Opposite.op ((TopologicalSpace.Opens.map (ι_tilde a).base).obj U_Y0)))),
      ∃ (h_sm : ↑(Y.presheaf.obj (Opposite.op (U_Y0 ⊓ U_sm)))),
        (∀ (a : Fin (L_comp + 1)) (O : Y.Opens)
          (hO_sm : O ≤ U_Y0 ⊓ U_sm) (hO_part : O ≤ U_part a) (hO_0 : O ≤ U_Y0),
          ((ι_tilde a).app O).hom ((Y.presheaf.map (CategoryTheory.homOfLE hO_sm).op).hom h_sm) =
            ((Y_tilde a).presheaf.map
              (CategoryTheory.homOfLE ((TopologicalSpace.Opens.map (ι_tilde a).base).monotone hO_0)).op).hom (h a)) ∧
        ((∀ (y₀ : ↥Y), y₀ ∉ U_sm →
          ∃ (W₁ : Y.Opens) (hW₁_le : W₁ ≤ U_Y0) (hy₀ : y₀ ∈ W₁)
            (a₁ : ↑(Y.presheaf.obj (Opposite.op W₁))),
            (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W₁ ⊓ U_sm ≤ W₁)).op).hom a₁ =
              (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_inf_right U_sm hW₁_le)).op).hom h_sm) →
        ∃ (h_bar : ↑(Y.presheaf.obj (Opposite.op U_Y0))),
          ∀ a : Fin (L_comp + 1), ((ι_tilde a).app U_Y0).hom h_bar = h a) :=
by
  let _ := hSingIn0
  have : AlgebraicGeometry.IsReduced Y := hRedY
  have res_comp : ∀ (Z : AlgebraicGeometry.Scheme.{u}) {U₁ U₂ U₃ : Z.Opens}
      (h₁₂ : U₂ ≤ U₁) (h₂₃ : U₃ ≤ U₂) (h₁₃ : U₃ ≤ U₁)
      (s : ↑(Z.presheaf.obj (Opposite.op U₁))),
      (Z.presheaf.map (CategoryTheory.homOfLE h₂₃).op).hom
        ((Z.presheaf.map (CategoryTheory.homOfLE h₁₂).op).hom s) =
        (Z.presheaf.map (CategoryTheory.homOfLE h₁₃).op).hom s := by
    intro Z U₁ U₂ U₃ h₁₂ h₂₃ h₁₃ s
    have hm : (CategoryTheory.homOfLE h₁₃).op =
        (CategoryTheory.homOfLE h₁₂).op ≫ (CategoryTheory.homOfLE h₂₃).op :=
      Subsingleton.elim _ _
    rw [hm, Z.presheaf.map_comp]
    rfl
  have app_res : ∀ {X Z : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Z) {U O : Z.Opens}
      (hOU : O ≤ U) (s : ↑(Z.presheaf.obj (Opposite.op U))),
      (f.app O).hom ((Z.presheaf.map (CategoryTheory.homOfLE hOU).op).hom s) =
        (X.presheaf.map
          (CategoryTheory.homOfLE ((TopologicalSpace.Opens.map f.base).monotone hOU)).op).hom
          ((f.app U).hom s) := by
    intro X Z f U O hOU s
    have hm : ((TopologicalSpace.Opens.map f.base).map ((CategoryTheory.homOfLE hOU).op.unop)).op =
        (CategoryTheory.homOfLE ((TopologicalSpace.Opens.map f.base).monotone hOU)).op :=
      Subsingleton.elim _ _
    change (Z.presheaf.map (CategoryTheory.homOfLE hOU).op ≫ f.app O).hom s =
      (f.app U ≫ X.presheaf.map
        (CategoryTheory.homOfLE ((TopologicalSpace.Opens.map f.base).monotone hOU)).op).hom s
    rw [f.naturality (CategoryTheory.homOfLE hOU).op, hm]
  have hDense_inj : ∀ (X : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsReduced X]
      (D : X.Opens), Dense (D : Set ↥X) → ∀ (W : X.Opens),
      Function.Injective
        ((X.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W ⊓ D ≤ W)).op).hom) := by
    intro X _ D hD W s₁ s₂ hs
    let d : ↑(X.presheaf.obj (Opposite.op W)) := s₁ - s₂
    have hd_res : (X.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W ⊓ D ≤ W)).op).hom d = 0 := by
      dsimp [d]
      rw [map_sub, hs, sub_self]
    have hBasicRes : (W ⊓ D) ⊓ X.basicOpen d = ⊥ := by
      have h1 := X.basicOpen_res d (CategoryTheory.homOfLE (inf_le_left : W ⊓ D ≤ W)).op
      change X.basicOpen ((X.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W ⊓ D ≤ W)).op).hom d) =
        (W ⊓ D) ⊓ X.basicOpen d at h1
      rw [hd_res, AlgebraicGeometry.Scheme.basicOpen_zero] at h1
      exact h1.symm
    have hBasicBot : X.basicOpen d = ⊥ := by
      rw [eq_bot_iff]
      intro x hx
      obtain ⟨z, hzB, hzD⟩ :=
        hD.inter_open_nonempty (X.basicOpen d : Set ↥X) (X.basicOpen d).isOpen ⟨x, hx⟩
      have hzW : z ∈ W := X.basicOpen_le d hzB
      have hzBot : z ∈ ((W ⊓ D) ⊓ X.basicOpen d : X.Opens) := ⟨⟨hzW, hzD⟩, hzB⟩
      rw [hBasicRes] at hzBot
      exact False.elim hzBot
    have hd0 : d = 0 := (AlgebraicGeometry.basicOpen_eq_bot_iff d).mp hBasicBot
    exact sub_eq_zero.mp hd0
  have hDenseUsm : Dense (U_sm : Set ↥Y) := by
    intro y
    have hyUniv : y ∈ (⋃ a : Fin (L_comp + 1), Set.range (ι_tilde a).base) := by
      rw [hSurjAll]
      exact Set.mem_univ y
    obtain ⟨a, hya⟩ := Set.mem_iUnion.mp hyUniv
    have hPre : IsPreirreducible (Set.range (ι_tilde a).base) :=
      (hComp a).2.1.prop.isPreirreducible
    obtain ⟨⟨p, hp⟩⟩ := (hComp a).2.2.2.1
    have hp_inter : p ∈ Set.range (ι_tilde a).base ∩ (U_sm : Set ↥Y) := by
      rw [← (hComp a).2.2.1]
      exact hp
    have hy_cl : y ∈ closure (Set.range (ι_tilde a).base ∩ (U_sm : Set ↥Y)) :=
      subset_closure_inter_of_isPreirreducible_of_isOpen hPre U_sm.isOpen ⟨p, hp_inter⟩ hya
    exact closure_mono Set.inter_subset_right hy_cl
  have hAppBij : ∀ (a : Fin (L_comp + 1)) (O : Y.Opens),
      O ≤ U_part a → Function.Bijective (((ι_tilde a).app O).hom) := by
    intro a O hO
    let U : Y.Opens := U_part a
    let f : Y_tilde a ⟶ Y := ι_tilde a
    have : CategoryTheory.IsIso (f ∣_ U) := (hComp a).2.2.2.2
    let V : U.toScheme.Opens := (TopologicalSpace.Opens.map U.ι.base).obj O
    have hUV : (U.ι.opensFunctor).obj V = O := by
      apply SetLike.coe_injective
      change ((U.ι.isOpenEmbedding.isOpenMap.functor).obj V : Set ↥Y) = (O : Set ↥Y)
      rw [IsOpenMap.coe_functor_obj]
      change U.ι.base '' (U.ι.base ⁻¹' (O : Set ↥Y)) = (O : Set ↥Y)
      rw [Set.image_preimage_eq_inter_range]
      have hRange : Set.range U.ι.base = (U : Set ↥Y) := by
        change (U.ι.opensRange : Set ↥Y) = (U : Set ↥Y)
        rw [AlgebraicGeometry.Scheme.Opens.opensRange_ι]
      rw [hRange]
      exact Set.inter_eq_left.mpr hO
    have hIsoEq : ∀ {W₁ W₂ : (Y_tilde a).Opens} (heq : W₁ = W₂),
        CategoryTheory.IsIso ((Y_tilde a).presheaf.map (CategoryTheory.eqToHom heq).op) := by
      intro W₁ W₂ heq
      subst heq
      change CategoryTheory.IsIso ((Y_tilde a).presheaf.map (𝟙 (Opposite.op W₁)))
      rw [CategoryTheory.Functor.map_id]
      infer_instance
    have hIsoRestr : CategoryTheory.IsIso ((f ∣_ U).app V) := inferInstance
    rw [AlgebraicGeometry.morphismRestrict_app f U V] at hIsoRestr
    have hIsoAppV : CategoryTheory.IsIso (f.app ((U.ι.opensFunctor).obj V)) :=
      @CategoryTheory.IsIso.of_isIso_comp_right _ _ _ _ _
        (f.app ((U.ι.opensFunctor).obj V)) _ (hIsoEq _) hIsoRestr
    have : CategoryTheory.IsIso (f.app O) := by rwa [← hUV]
    exact CategoryTheory.ConcreteCategory.bijective_of_isIso (f.app O)
  let O_a : Fin (L_comp + 1) → Y.Opens := fun a => U_Y0 ⊓ U_part a
  have hPartLeSm : ∀ a : Fin (L_comp + 1), U_part a ≤ U_sm := by
    intro a
    rw [← hPartSup]
    exact le_iSup U_part a
  have hOa_le_sm : ∀ a : Fin (L_comp + 1), O_a a ≤ U_Y0 ⊓ U_sm :=
    fun a => inf_le_inf_left U_Y0 (hPartLeSm a)
  let i_O : ∀ a : Fin (L_comp + 1), O_a a ⟶ U_Y0 ⊓ U_sm :=
    fun a => CategoryTheory.homOfLE (hOa_le_sm a)
  have hSupO : (⨆ a : Fin (L_comp + 1), O_a a) = U_Y0 ⊓ U_sm := by
    dsimp [O_a]
    rw [← inf_iSup_eq, hPartSup]
  have hDisjO : ∀ {a b : Fin (L_comp + 1)}, a ≠ b → O_a a ⊓ O_a b = ⊥ := by
    intro a b hab
    exact (Disjoint.mono inf_le_right inf_le_right (hPartDisj hab)).eq_bot
  have hCompatO : ∀ (sf : ∀ a : Fin (L_comp + 1), ↑(Y.presheaf.obj (Opposite.op (O_a a)))),
      TopCat.Presheaf.IsCompatible Y.sheaf.obj O_a sf := by
    intro sf a b
    by_cases hab : a = b
    · subst hab
      have hm : (TopologicalSpace.Opens.infLELeft (O_a a) (O_a a)).op =
          (TopologicalSpace.Opens.infLERight (O_a a) (O_a a)).op :=
        Subsingleton.elim _ _
      change (Y.presheaf.map (TopologicalSpace.Opens.infLELeft (O_a a) (O_a a)).op).hom (sf a) =
        (Y.presheaf.map (TopologicalSpace.Opens.infLERight (O_a a) (O_a a)).op).hom (sf a)
      rw [hm]
    · let e : Opposite.op (O_a a ⊓ O_a b) ⟶ Opposite.op (⊥ : Y.Opens) :=
        CategoryTheory.eqToHom (congrArg Opposite.op (hDisjO hab))
      have hBijBot : Function.Bijective ((Y.presheaf.map e).hom) :=
        CategoryTheory.ConcreteCategory.bijective_of_isIso (Y.presheaf.map e)
      apply hBijBot.1
      exact Subsingleton.elim _ _
  refine ⟨?_, ?_⟩
  · intro f₁ f₂ hf
    have hf_Oa : ∀ a : Fin (L_comp + 1),
        (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : O_a a ≤ U_Y0)).op).hom f₁ =
        (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : O_a a ≤ U_Y0)).op).hom f₂ := by
      intro a
      have hfa : ((ι_tilde a).app U_Y0).hom f₁ = ((ι_tilde a).app U_Y0).hom f₂ :=
        congrFun hf a
      apply (hAppBij a (O_a a) inf_le_right).1
      rw [app_res (ι_tilde a) (inf_le_left : O_a a ≤ U_Y0) f₁,
        app_res (ι_tilde a) (inf_le_left : O_a a ≤ U_Y0) f₂,
        hfa]
    let s₁ : ↑(Y.presheaf.obj (Opposite.op (U_Y0 ⊓ U_sm))) :=
      (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U_Y0 ⊓ U_sm ≤ U_Y0)).op).hom f₁
    let s₂ : ↑(Y.presheaf.obj (Opposite.op (U_Y0 ⊓ U_sm))) :=
      (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U_Y0 ⊓ U_sm ≤ U_Y0)).op).hom f₂
    let sf₁ : ∀ a : Fin (L_comp + 1), ↑(Y.presheaf.obj (Opposite.op (O_a a))) :=
      fun a => (Y.presheaf.map (i_O a).op).hom s₁
    have hs₁s₂ : s₁ = s₂ := by
      refine (Y.sheaf.existsUnique_gluing' O_a (U_Y0 ⊓ U_sm) i_O (le_of_eq hSupO.symm)
        sf₁ (hCompatO sf₁)).unique (fun _ => rfl) ?_
      intro a
      change (Y.presheaf.map (i_O a).op).hom s₂ = (Y.presheaf.map (i_O a).op).hom s₁
      dsimp [s₁, s₂, i_O]
      rw [res_comp Y (inf_le_left : U_Y0 ⊓ U_sm ≤ U_Y0) (hOa_le_sm a) (inf_le_left : O_a a ≤ U_Y0) f₂,
        res_comp Y (inf_le_left : U_Y0 ⊓ U_sm ≤ U_Y0) (hOa_le_sm a) (inf_le_left : O_a a ≤ U_Y0) f₁,
        hf_Oa a]
    exact hDense_inj Y U_sm hDenseUsm U_Y0 hs₁s₂
  · intro h
    let h_tilde : ∀ a : Fin (L_comp + 1),
        ↑((Y_tilde a).presheaf.obj
          (Opposite.op ((TopologicalSpace.Opens.map (ι_tilde a).base).obj (O_a a)))) :=
      fun a =>
        ((Y_tilde a).presheaf.map
          (CategoryTheory.homOfLE
            ((TopologicalSpace.Opens.map (ι_tilde a).base).monotone
              (inf_le_left : O_a a ≤ U_Y0))).op).hom (h a)
    choose h_part hh_part using fun a : Fin (L_comp + 1) =>
      (hAppBij a (O_a a) inf_le_right).2 (h_tilde a)
    obtain ⟨h_sm, hh_glued, _⟩ :=
      Y.sheaf.existsUnique_gluing' O_a (U_Y0 ⊓ U_sm) i_O (le_of_eq hSupO.symm)
        h_part (hCompatO h_part)
    have hh_sm : ∀ (a : Fin (L_comp + 1)) (O : Y.Opens)
        (hO_sm : O ≤ U_Y0 ⊓ U_sm) (hO_part : O ≤ U_part a) (hO_0 : O ≤ U_Y0),
        ((ι_tilde a).app O).hom ((Y.presheaf.map (CategoryTheory.homOfLE hO_sm).op).hom h_sm) =
          ((Y_tilde a).presheaf.map
            (CategoryTheory.homOfLE ((TopologicalSpace.Opens.map (ι_tilde a).base).monotone hO_0)).op).hom (h a) := by
      intro a O hO_sm hO_part hO_0
      have hO_Oa : O ≤ O_a a := le_inf hO_0 hO_part
      have h_res_Y : (Y.presheaf.map (CategoryTheory.homOfLE hO_sm).op).hom h_sm =
          (Y.presheaf.map (CategoryTheory.homOfLE hO_Oa).op).hom (h_part a) := by
        rw [← res_comp Y (hOa_le_sm a) hO_Oa hO_sm h_sm]
        change (Y.presheaf.map (CategoryTheory.homOfLE hO_Oa).op).hom
          ((Y.sheaf.obj.map (i_O a).op).hom h_sm) = _
        rw [hh_glued a]
      rw [h_res_Y, app_res (ι_tilde a) hO_Oa (h_part a), hh_part a]
      dsimp [h_tilde]
      exact res_comp (Y_tilde a)
        ((TopologicalSpace.Opens.map (ι_tilde a).base).monotone (inf_le_left : O_a a ≤ U_Y0))
        ((TopologicalSpace.Opens.map (ι_tilde a).base).monotone hO_Oa)
        ((TopologicalSpace.Opens.map (ι_tilde a).base).monotone hO_0)
        (h a)
    refine ⟨h_sm, hh_sm, ?_⟩
    intro hExt
    let S_sing : Type u := {y : ↥Y // y ∉ U_sm}
    choose W₁ hW₁_le hy₀ a₁ ha₁ using fun p : S_sing => hExt p.1 p.2
    let cov : Option S_sing → Y.Opens := fun
      | none => U_Y0 ⊓ U_sm
      | some p => W₁ p
    let iUV : ∀ i : Option S_sing, cov i ⟶ U_Y0 := fun
      | none => CategoryTheory.homOfLE inf_le_left
      | some p => CategoryTheory.homOfLE (hW₁_le p)
    let sec : ∀ i : Option S_sing, ↑(Y.presheaf.obj (Opposite.op (cov i))) := fun
      | none => h_sm
      | some p => a₁ p
    have hCov : U_Y0 ≤ ⨆ i : Option S_sing, cov i := by
      intro y hy0
      by_cases hy : y ∈ U_sm
      · exact TopologicalSpace.Opens.mem_iSup.mpr ⟨none, ⟨hy0, hy⟩⟩
      · exact TopologicalSpace.Opens.mem_iSup.mpr ⟨some ⟨y, hy⟩, hy₀ ⟨y, hy⟩⟩
    have hCompat_cov : TopCat.Presheaf.IsCompatible Y.sheaf.obj cov sec := by
      rintro (_ | p) (_ | q)
      · have hm : (TopologicalSpace.Opens.infLELeft (cov none) (cov none)).op =
            (TopologicalSpace.Opens.infLERight (cov none) (cov none)).op :=
          Subsingleton.elim _ _
        change (Y.presheaf.map (TopologicalSpace.Opens.infLELeft (cov none) (cov none)).op).hom h_sm =
          (Y.presheaf.map (TopologicalSpace.Opens.infLERight (cov none) (cov none)).op).hom h_sm
        rw [hm]
      · let Ω : Y.Opens := (U_Y0 ⊓ U_sm) ⊓ W₁ q
        have hΩ_Wqsm : Ω ≤ W₁ q ⊓ U_sm := le_inf inf_le_right (inf_le_left.trans inf_le_right)
        have hmL : (TopologicalSpace.Opens.infLELeft (cov none) (cov (some q))).op =
            (CategoryTheory.homOfLE (inf_le_left : Ω ≤ U_Y0 ⊓ U_sm)).op :=
          Subsingleton.elim _ _
        have hmR : (TopologicalSpace.Opens.infLERight (cov none) (cov (some q))).op =
            (CategoryTheory.homOfLE (inf_le_right : Ω ≤ W₁ q)).op :=
          Subsingleton.elim _ _
        change (Y.presheaf.map (TopologicalSpace.Opens.infLELeft (cov none) (cov (some q))).op).hom h_sm =
          (Y.presheaf.map (TopologicalSpace.Opens.infLERight (cov none) (cov (some q))).op).hom (a₁ q)
        rw [hmL, hmR,
          ← res_comp Y (inf_le_inf_right U_sm (hW₁_le q)) hΩ_Wqsm (inf_le_left : Ω ≤ U_Y0 ⊓ U_sm) h_sm,
          ← ha₁ q,
          res_comp Y (inf_le_left : W₁ q ⊓ U_sm ≤ W₁ q) hΩ_Wqsm (inf_le_right : Ω ≤ W₁ q) (a₁ q)]
      · let Ω : Y.Opens := W₁ p ⊓ (U_Y0 ⊓ U_sm)
        have hΩ_Wpsm : Ω ≤ W₁ p ⊓ U_sm := le_inf inf_le_left (inf_le_right.trans inf_le_right)
        have hmL : (TopologicalSpace.Opens.infLELeft (cov (some p)) (cov none)).op =
            (CategoryTheory.homOfLE (inf_le_left : Ω ≤ W₁ p)).op :=
          Subsingleton.elim _ _
        have hmR : (TopologicalSpace.Opens.infLERight (cov (some p)) (cov none)).op =
            (CategoryTheory.homOfLE (inf_le_right : Ω ≤ U_Y0 ⊓ U_sm)).op :=
          Subsingleton.elim _ _
        change (Y.presheaf.map (TopologicalSpace.Opens.infLELeft (cov (some p)) (cov none)).op).hom (a₁ p) =
          (Y.presheaf.map (TopologicalSpace.Opens.infLERight (cov (some p)) (cov none)).op).hom h_sm
        rw [hmL, hmR,
          ← res_comp Y (inf_le_left : W₁ p ⊓ U_sm ≤ W₁ p) hΩ_Wpsm (inf_le_left : Ω ≤ W₁ p) (a₁ p),
          ha₁ p,
          res_comp Y (inf_le_inf_right U_sm (hW₁_le p)) hΩ_Wpsm (inf_le_right : Ω ≤ U_Y0 ⊓ U_sm) h_sm]
      · let W_pq : Y.Opens := W₁ p ⊓ W₁ q
        apply hDense_inj Y U_sm hDenseUsm W_pq
        have hmL : (TopologicalSpace.Opens.infLELeft (cov (some p)) (cov (some q))).op =
            (CategoryTheory.homOfLE (inf_le_left : W_pq ≤ W₁ p)).op :=
          Subsingleton.elim _ _
        have hmR : (TopologicalSpace.Opens.infLERight (cov (some p)) (cov (some q))).op =
            (CategoryTheory.homOfLE (inf_le_right : W_pq ≤ W₁ q)).op :=
          Subsingleton.elim _ _
        change (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W_pq ⊓ U_sm ≤ W_pq)).op).hom
          ((Y.presheaf.map (TopologicalSpace.Opens.infLELeft (cov (some p)) (cov (some q))).op).hom (a₁ p)) =
          (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W_pq ⊓ U_sm ≤ W_pq)).op).hom
          ((Y.presheaf.map (TopologicalSpace.Opens.infLERight (cov (some p)) (cov (some q))).op).hom (a₁ q))
        rw [hmL, hmR,
          res_comp Y (inf_le_left : W_pq ≤ W₁ p) (inf_le_left : W_pq ⊓ U_sm ≤ W_pq)
            (inf_le_left.trans inf_le_left) (a₁ p),
          res_comp Y (inf_le_right : W_pq ≤ W₁ q) (inf_le_left : W_pq ⊓ U_sm ≤ W_pq)
            (inf_le_left.trans inf_le_right) (a₁ q),
          ← res_comp Y (inf_le_left : W₁ p ⊓ U_sm ≤ W₁ p)
            (inf_le_inf_right U_sm (inf_le_left : W_pq ≤ W₁ p))
            (inf_le_left.trans inf_le_left) (a₁ p),
          ← res_comp Y (inf_le_left : W₁ q ⊓ U_sm ≤ W₁ q)
            (inf_le_inf_right U_sm (inf_le_right : W_pq ≤ W₁ q))
            (inf_le_left.trans inf_le_right) (a₁ q),
          ha₁ p, ha₁ q,
          res_comp Y (inf_le_inf_right U_sm (hW₁_le p))
            (inf_le_inf_right U_sm (inf_le_left : W_pq ≤ W₁ p))
            (inf_le_inf_right U_sm ((inf_le_left : W_pq ≤ W₁ p).trans (hW₁_le p))) h_sm,
          res_comp Y (inf_le_inf_right U_sm (hW₁_le q))
            (inf_le_inf_right U_sm (inf_le_right : W_pq ≤ W₁ q))
            (inf_le_inf_right U_sm ((inf_le_right : W_pq ≤ W₁ q).trans (hW₁_le q))) h_sm]
    obtain ⟨h_bar, hh_bar, _⟩ :=
      Y.sheaf.existsUnique_gluing' cov U_Y0 iUV hCov sec hCompat_cov
    have hh_bar_none :
        (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U_Y0 ⊓ U_sm ≤ U_Y0)).op).hom h_bar = h_sm :=
      hh_bar none
    refine ⟨h_bar, fun a => ?_⟩
    have : AlgebraicGeometry.IsIntegral (Y_tilde a) := (hComp a).1
    have : AlgebraicGeometry.IsReduced (Y_tilde a) :=
      AlgebraicGeometry.isReduced_of_isIntegral (Y_tilde a)
    have : IrreducibleSpace ↥(Y_tilde a) :=
      AlgebraicGeometry.irreducibleSpace_of_isIntegral (Y_tilde a)
    let D_a : (Y_tilde a).Opens :=
      (TopologicalSpace.Opens.map (ι_tilde a).base).obj (U_part a)
    have hDenseDa : Dense (D_a : Set ↥(Y_tilde a)) := by
      obtain ⟨⟨y_a, hy_a⟩⟩ := (hComp a).2.2.2.1
      have hy_range : y_a ∈ Set.range (ι_tilde a).base := by
        have hmem : y_a ∈ (U_part a : Set ↥Y) := hy_a
        rw [(hComp a).2.2.1] at hmem
        exact hmem.1
      obtain ⟨z_a, hz_a_eq⟩ := hy_range
      have hz_a_mem : z_a ∈ (D_a : Set ↥(Y_tilde a)) := by
        change (ι_tilde a).base z_a ∈ U_part a
        rw [hz_a_eq]
        exact hy_a
      intro z
      rw [mem_closure_iff]
      intro V hV hzV
      exact nonempty_preirreducible_inter hV D_a.isOpen ⟨z, hzV⟩ ⟨z_a, hz_a_mem⟩
    let U_tilde_0 : (Y_tilde a).Opens :=
      (TopologicalSpace.Opens.map (ι_tilde a).base).obj U_Y0
    apply hDense_inj (Y_tilde a) D_a hDenseDa U_tilde_0
    have h_eq :
        ((Y_tilde a).presheaf.map
          (CategoryTheory.homOfLE
            ((TopologicalSpace.Opens.map (ι_tilde a).base).monotone
              (inf_le_left : O_a a ≤ U_Y0))).op).hom
          (((ι_tilde a).app U_Y0).hom h_bar) =
        ((Y_tilde a).presheaf.map
          (CategoryTheory.homOfLE
            ((TopologicalSpace.Opens.map (ι_tilde a).base).monotone
              (inf_le_left : O_a a ≤ U_Y0))).op).hom (h a) :=
      ((app_res (ι_tilde a) (inf_le_left : O_a a ≤ U_Y0) h_bar).symm.trans
        (congrArg (((ι_tilde a).app (O_a a)).hom)
          ((res_comp Y (inf_le_left : U_Y0 ⊓ U_sm ≤ U_Y0) (hOa_le_sm a)
            (inf_le_left : O_a a ≤ U_Y0) h_bar).symm.trans
            (congrArg ((Y.presheaf.map (i_O a).op).hom) hh_bar_none)))).trans
        (hh_sm a (O_a a) (hOa_le_sm a) inf_le_right inf_le_left)
    exact h_eq

theorem weil_open_affineness_and_k0T_finiteness_of_nodeConstant_descent (k₀ : Type u) [Field k₀] [IsAlgClosed k₀]
    (Y : AlgebraicGeometry.Scheme.{u})
    (p_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of k₀))
    (hPropY : AlgebraicGeometry.IsProper p_Y)
    (U_sm : Y.Opens)
    (hSingFin : ((U_sm : Set ↥Y)ᶜ).Finite)
    (hSingClosed : ∀ y : ↥Y, y ∉ U_sm → IsClosed ({y} : Set ↥Y))
    (L_comp : ℕ)
    (U_part : Fin (L_comp + 1) → Y.Opens)
    (hPartSubSm : ∀ a : Fin (L_comp + 1), U_part a ≤ U_sm)
    (Y_tilde : Fin (L_comp + 1) → AlgebraicGeometry.Scheme.{u})
    (ι_tilde : ∀ a : Fin (L_comp + 1), Y_tilde a ⟶ Y)
    (hSurjAll : (⋃ a : Fin (L_comp + 1), Set.range (ι_tilde a).base) = Set.univ)
    (hFinMap : ∀ a : Fin (L_comp + 1), AlgebraicGeometry.IsFinite (ι_tilde a))
    (U_Y0 : Y.Opens)
    (hSingIn0 : (U_sm : Set ↥Y)ᶜ ⊆ (U_Y0 : Set ↥Y))
    (hAffTilde0 : ∀ a : Fin (L_comp + 1),
      AlgebraicGeometry.IsAffineOpen ((TopologicalSpace.Opens.map (ι_tilde a).base).obj U_Y0))
    (hInj0 : Function.Injective
      (fun (f : ↑(Y.presheaf.obj (Opposite.op U_Y0))) (a : Fin (L_comp + 1)) =>
        ((ι_tilde a).app U_Y0).hom f))
    (hDescend : ∀ (h : ∀ a : Fin (L_comp + 1),
        ↑((Y_tilde a).presheaf.obj (Opposite.op ((TopologicalSpace.Opens.map (ι_tilde a).base).obj U_Y0)))),
      (∀ y₀ : ↥Y, y₀ ∉ U_sm → ∃ c : k₀, ∀ (a : Fin (L_comp + 1)) (z : ↥(Y_tilde a)),
        (ι_tilde a).base z = y₀ →
        z ∉ (Y_tilde a).basicOpen (h a -
          (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
            (ι_tilde a ≫ p_Y).appLE ⊤
              ((TopologicalSpace.Opens.map (ι_tilde a).base).obj U_Y0) le_top).hom c))) →
      ∃ (h_bar : ↑(Y.presheaf.obj (Opposite.op U_Y0))),
        ∀ a : Fin (L_comp + 1), ((ι_tilde a).app U_Y0).hom h_bar = h a)
    (f_tilde : ∀ a : Fin (L_comp + 1),
      ↑((Y_tilde a).presheaf.obj (Opposite.op ((TopologicalSpace.Opens.map (ι_tilde a).base).obj U_Y0))))
    (hVanish : ∀ (a : Fin (L_comp + 1)) (z : ↥(Y_tilde a)),
      (ι_tilde a).base z ∉ U_part a → z ∉ (Y_tilde a).basicOpen (f_tilde a))
    (hFinTilde0 : ∀ a : Fin (L_comp + 1),
      (Polynomial.eval₂RingHom
        (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
          (ι_tilde a ≫ p_Y).appLE ⊤
            ((TopologicalSpace.Opens.map (ι_tilde a).base).obj U_Y0) le_top).hom)
        (f_tilde a)).Finite) :
    AlgebraicGeometry.IsAffineOpen U_Y0 ∧
    ∃ (f_bar : ↑(Y.presheaf.obj (Opposite.op U_Y0))),
      (∀ a : Fin (L_comp + 1), ((ι_tilde a).app U_Y0).hom f_bar = f_tilde a) ∧
      Y.basicOpen f_bar ≤ U_sm ∧
      (Polynomial.eval₂RingHom
        (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
          p_Y.appLE ⊤ U_Y0 le_top).hom) f_bar).Finite :=
by
  have hMemBasic : ∀ {X : AlgebraicGeometry.Scheme.{u}} {U : X.Opens}
      (hU : AlgebraicGeometry.IsAffineOpen U) (x : ↥U)
      (f : ↑(X.presheaf.obj (Opposite.op U))),
      (x : ↥X) ∈ X.basicOpen f ↔ f ∉ (hU.primeIdealOf x).asIdeal := by
    intro X U hU x f
    rw [← hU.fromSpec_primeIdealOf x]
    change hU.primeIdealOf x ∈
      (TopologicalSpace.Opens.map hU.fromSpec.base).obj (X.basicOpen f) ↔ _
    rw [hU.fromSpec_preimage_basicOpen f]
    exact PrimeSpectrum.mem_basicOpen f (hU.primeIdealOf x)
  have hComapPrime : ∀ {X Z : AlgebraicGeometry.Scheme.{u}} (g_hom : X ⟶ Z)
      (U : Z.Opens) (hU : AlgebraicGeometry.IsAffineOpen U)
      (V : X.Opens) (hV : AlgebraicGeometry.IsAffineOpen V)
      (hVU : V ≤ (TopologicalSpace.Opens.map g_hom.base).obj U)
      (v : ↥V) (z : ↥U),
      g_hom.base v = z →
      Ideal.comap ((g_hom.appLE U V hVU).hom) (hV.primeIdealOf v).asIdeal =
        (hU.primeIdealOf z).asIdeal := by
    intro X Z g_hom U hU V hV hVU v z hvz
    ext r
    rw [Ideal.mem_comap, ← not_iff_not, ← hMemBasic hV v _, ← hMemBasic hU z r]
    have happ : (g_hom.appLE U V hVU).hom r =
        (X.presheaf.map (CategoryTheory.homOfLE hVU).op).hom ((g_hom.app U).hom r) := by
      rw [AlgebraicGeometry.Scheme.Hom.appLE]
      rfl
    rw [happ, X.basicOpen_res, ← g_hom.preimage_basicOpen r]
    change (v : ↥X) ∈ (V : Set ↥X) ∩ g_hom.base ⁻¹' (Z.basicOpen r : Set ↥Z) ↔
      (z : ↥Z) ∈ Z.basicOpen r
    simp only [Set.mem_inter_iff, Set.mem_preimage, SetLike.mem_coe, v.2, true_and, hvz]

  let U_tilde0 : ∀ a : Fin (L_comp + 1), (Y_tilde a).Opens :=
    fun a => (TopologicalSpace.Opens.map (ι_tilde a).base).obj U_Y0
  let A₀ : Type u := ↑(Y.presheaf.obj (Opposite.op U_Y0))
  let R : Fin (L_comp + 1) → Type u :=
    fun a => ↑((Y_tilde a).presheaf.obj (Opposite.op (U_tilde0 a)))
  let α : ∀ a : Fin (L_comp + 1), A₀ →+* R a :=
    fun a => ((ι_tilde a).app U_Y0).hom
  let κ₀ : k₀ →+* A₀ :=
    (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
      p_Y.appLE ⊤ U_Y0 le_top).hom)
  let κ_tilde : ∀ a : Fin (L_comp + 1), k₀ →+* R a :=
    fun a => (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
      (ι_tilde a ≫ p_Y).appLE ⊤ (U_tilde0 a) le_top).hom)

  
  have hκ_compat : ∀ a : Fin (L_comp + 1), (α a).comp κ₀ = κ_tilde a := by
    intro a
    have happ_eq : (ι_tilde a).appLE U_Y0 (U_tilde0 a) (le_refl _) = (ι_tilde a).app U_Y0 := by
      rw [AlgebraicGeometry.Scheme.Hom.appLE]
      have hid : (CategoryTheory.homOfLE (le_refl (U_tilde0 a))).op = 𝟙 (Opposite.op (U_tilde0 a)) :=
        Subsingleton.elim _ _
      rw [hid, CategoryTheory.Functor.map_id, CategoryTheory.Category.comp_id]
    have hcat : ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
        p_Y.appLE ⊤ U_Y0 le_top) ≫ (ι_tilde a).app U_Y0 =
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
          (ι_tilde a ≫ p_Y).appLE ⊤ (U_tilde0 a) le_top := by
      rw [CategoryTheory.Category.assoc, ← happ_eq,
        AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE (ι_tilde a) p_Y ⊤ U_Y0 (U_tilde0 a)
          le_top (le_refl _)]
    exact congrArg CommRingCat.Hom.hom hcat

  obtain ⟨f_bar, hf_pull⟩ : ∃ f_bar : A₀, ∀ a : Fin (L_comp + 1), α a f_bar = f_tilde a := by
    apply hDescend f_tilde
    intro y₀ hy₀
    refine ⟨0, fun a z hz => ?_⟩
    have hz_not_part : (ι_tilde a).base z ∉ U_part a := by
      intro hmem
      have hsm : (ι_tilde a).base z ∈ U_sm := hPartSubSm a hmem
      rw [hz] at hsm
      exact hy₀ hsm
    have hvan := hVanish a z hz_not_part
    simpa only [map_zero, sub_zero] using hvan

  have hf_le_sm : Y.basicOpen f_bar ≤ U_sm := by
    intro y hy
    have hy_univ : y ∈ (Set.univ : Set ↥Y) := Set.mem_univ y
    rw [← hSurjAll, Set.mem_iUnion] at hy_univ
    obtain ⟨a, z, hzy⟩ := hy_univ
    have hz_pre : z ∈ ((TopologicalSpace.Opens.map (ι_tilde a).base).obj (Y.basicOpen f_bar) :
        Set ↥(Y_tilde a)) := by
      change (ι_tilde a).base z ∈ Y.basicOpen f_bar
      rwa [hzy]
    rw [(ι_tilde a).preimage_basicOpen f_bar, hf_pull a] at hz_pre
    have hy_part : (ι_tilde a).base z ∈ U_part a := by
      by_contra hnot
      exact hVanish a z hnot hz_pre
    rw [hzy] at hy_part
    exact hPartSubSm a hy_part

  
  have hAlgPkg : (Polynomial.eval₂RingHom κ₀ f_bar).Finite ∧
      ∀ (M : Ideal A₀), M.IsMaximal →
        ∃ (a₀ : Fin (L_comp + 1)) (m₀ : Ideal (R a₀)),
          m₀.IsMaximal ∧
          Function.Bijective ((Ideal.Quotient.mk m₀).comp (κ_tilde a₀)) ∧
          ∀ x : A₀, x ∈ M ↔ α a₀ x ∈ m₀ := by
    let ψ₀ : Polynomial k₀ →+* A₀ := Polynomial.eval₂RingHom κ₀ f_bar
    let ψ : ∀ a : Fin (L_comp + 1), Polynomial k₀ →+* R a :=
      fun a => Polynomial.eval₂RingHom (κ_tilde a) (f_tilde a)
    let A_tilde : Type u := ∀ a : Fin (L_comp + 1), R a
    let Φ₀ : A₀ →+* A_tilde := RingHom.pi α
    let ψ_tilde : Polynomial k₀ →+* A_tilde := RingHom.pi ψ
    have hψ_comp : ∀ a : Fin (L_comp + 1), (α a).comp ψ₀ = ψ a := by
      intro a
      apply Polynomial.ringHom_ext'
      · ext c
        simp only [ψ₀, ψ, RingHom.comp_apply, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
        exact RingHom.congr_fun (hκ_compat a) c
      · simp only [ψ₀, ψ, RingHom.comp_apply, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X,
          hf_pull a]
    have hΦ_ψ : Φ₀.comp ψ₀ = ψ_tilde := by
      apply RingHom.ext
      intro P
      funext a
      exact RingHom.congr_fun (hψ_comp a) P
    have hStep1 : ψ₀.Finite ∧ Φ₀.IsIntegral := by
      letI : Algebra (Polynomial k₀) A₀ := ψ₀.toAlgebra
      letI : ∀ a : Fin (L_comp + 1), Algebra (Polynomial k₀) (R a) := fun a => (ψ a).toAlgebra
      have : ∀ a : Fin (L_comp + 1), Module.Finite (Polynomial k₀) (R a) := hFinTilde0
      have hFinPi : Module.Finite (Polynomial k₀) A_tilde := Module.Finite.pi
      have : IsNoetherianRing (Polynomial k₀) := Polynomial.isNoetherianRing
      have : IsNoetherian (Polynomial k₀) A_tilde :=
        isNoetherian_of_isNoetherianRing_of_finite (Polynomial k₀) A_tilde
      let Φ₀_lin : A₀ →ₗ[Polynomial k₀] A_tilde :=
        { toFun := Φ₀
          map_add' := Φ₀.map_add
          map_smul' := fun P x => by
            ext a
            change α a (ψ₀ P * x) = ψ a P * α a x
            rw [map_mul, ← RingHom.comp_apply, hψ_comp a] }
      have hFin₀ : ψ₀.Finite := Module.Finite.of_injective Φ₀_lin hInj0
      have hFin_tilde : ψ_tilde.Finite := hFinPi
      have hCompInt : (Φ₀.comp ψ₀).IsIntegral := by
        rw [hΦ_ψ]
        exact RingHom.Finite.to_isIntegral hFin_tilde
      exact ⟨hFin₀, RingHom.IsIntegral.tower_top ψ₀ Φ₀ hCompInt⟩
    refine ⟨hStep1.1, fun M hM => ?_⟩
    have : M.IsMaximal := hM
    obtain ⟨P_tilde, hP_max, hP_under⟩ :
        ∃ P : Ideal A_tilde, P.IsMaximal ∧ Ideal.comap Φ₀ P = M := by
      letI : Algebra A₀ A_tilde := Φ₀.toAlgebra
      have : Algebra.IsIntegral A₀ A_tilde := ⟨hStep1.2⟩
      have hker : RingHom.ker (algebraMap A₀ A_tilde) ≤ M := by
        intro x hx
        rw [RingHom.mem_ker] at hx
        have hx_fn : (fun a => α a x) = (fun a => α a 0) := by
          funext a
          rw [map_zero]
          exact congrFun hx a
        have hx0 : x = 0 := hInj0 hx_fn
        rw [hx0]
        exact M.zero_mem
      exact Ideal.exists_ideal_over_maximal_of_isIntegral M hker
    have : P_tilde.IsPrime := hP_max.isPrime
    classical
    let e : Fin (L_comp + 1) → A_tilde := fun a b => if b = a then 1 else 0
    have he_sum : (∑ a : Fin (L_comp + 1), e a) = 1 := by
      ext b
      rw [Finset.sum_apply]
      simp [e]
      rfl
    have hex_e : ∃ a₀ : Fin (L_comp + 1), e a₀ ∉ P_tilde := by
      by_contra h_all
      push Not at h_all
      have h1_mem : (1 : A_tilde) ∈ P_tilde := by
        rw [← he_sum]
        exact P_tilde.sum_mem fun a _ => h_all a
      exact hP_max.ne_top (P_tilde.eq_top_of_isUnit_mem h1_mem isUnit_one)
    obtain ⟨a₀, he₀⟩ := hex_e
    let π₀ : A_tilde →+* R a₀ := Pi.evalRingHom R a₀
    have hSurj_π : Function.Surjective π₀ :=
      fun r => ⟨fun b => if h : b = a₀ then h ▸ r else 0, by
        change (if h : a₀ = a₀ then h ▸ r else 0) = r
        simp⟩
    let m₀ : Ideal (R a₀) := Ideal.map π₀ P_tilde
    have hComap_m₀ : Ideal.comap π₀ m₀ = P_tilde := by
      apply le_antisymm _ Ideal.le_comap_map
      intro g hg
      rw [Ideal.mem_comap, Ideal.mem_map_iff_of_surjective π₀ hSurj_π] at hg
      obtain ⟨p, hpP, hpg⟩ := hg
      have hmul : (g - p) * e a₀ = 0 := by
        ext b
        by_cases hb : b = a₀
        · subst hb
          change (g b - p b) * (if b = b then 1 else 0) = 0
          simp only [↓reduceIte, mul_one]
          exact sub_eq_zero.mpr hpg.symm
        · change (g b - p b) * (if b = a₀ then 1 else 0) = 0
          simp [hb]
      have hmem0 : (g - p) * e a₀ ∈ P_tilde := by
        rw [hmul]
        exact P_tilde.zero_mem
      have hgp : g - p ∈ P_tilde := (hP_max.isPrime.mem_or_mem hmem0).resolve_right he₀
      simpa only [sub_add_cancel] using P_tilde.add_mem hgp hpP
    have hm₀_max : m₀.IsMaximal := by
      let θ : A_tilde →+* (R a₀ ⧸ m₀) := (Ideal.Quotient.mk m₀).comp π₀
      have hθ_surj : Function.Surjective θ := Ideal.Quotient.mk_surjective.comp hSurj_π
      have hθ_ker : RingHom.ker θ = P_tilde := by
        ext g
        rw [RingHom.mem_ker, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem,
          ← Ideal.mem_comap, hComap_m₀]
      have : (RingHom.ker θ).IsMaximal := hθ_ker.symm ▸ hP_max
      letI : Field (A_tilde ⧸ RingHom.ker θ) := Ideal.Quotient.field (RingHom.ker θ)
      let eQ : (A_tilde ⧸ RingHom.ker θ) ≃+* (R a₀ ⧸ m₀) :=
        RingHom.quotientKerEquivOfSurjective hθ_surj
      have hFieldQ : IsField (R a₀ ⧸ m₀) :=
        { exists_pair_ne := ⟨eQ 0, eQ 1, fun h => zero_ne_one (eQ.injective h)⟩
          mul_comm := mul_comm
          mul_inv_cancel := fun {x} hx => by
            let y := eQ.symm x
            have hy : y ≠ 0 := fun h => hx (by
              rw [← eQ.apply_symm_apply x]
              change eQ y = 0
              rw [h, map_zero])
            refine ⟨eQ y⁻¹, ?_⟩
            calc
              x * eQ y⁻¹ = eQ y * eQ y⁻¹ := by rw [eQ.apply_symm_apply]
              _ = eQ (y * y⁻¹) := (map_mul eQ y y⁻¹).symm
              _ = eQ 1 := by rw [mul_inv_cancel₀ hy]
              _ = 1 := map_one eQ }
      exact Ideal.Quotient.maximal_of_isField m₀ hFieldQ
    have hMem_M : ∀ x : A₀, x ∈ M ↔ α a₀ x ∈ m₀ := by
      intro x
      rw [← hP_under, ← hComap_m₀]
      rfl
    have hBij_m₀ : Function.Bijective ((Ideal.Quotient.mk m₀).comp (κ_tilde a₀)) := by
      have : m₀.IsMaximal := hm₀_max
      let F_res : Type u := R a₀ ⧸ m₀
      letI : Field F_res := Ideal.Quotient.field m₀
      let bar_ψ : Polynomial k₀ →+* F_res := (Ideal.Quotient.mk m₀).comp (ψ a₀)
      let bar_κ : k₀ →+* F_res := (Ideal.Quotient.mk m₀).comp (κ_tilde a₀)
      have hbar_int : bar_ψ.IsIntegral :=
        RingHom.IsIntegral.trans _ _ (RingHom.Finite.to_isIntegral (hFinTilde0 a₀))
          (RingHom.isIntegral_of_surjective _ Ideal.Quotient.mk_surjective)
      have : (⊥ : Ideal F_res).IsMaximal := (Ideal.bot_quotient_isMaximal_iff m₀).mpr hm₀_max
      have hq_max : (Ideal.comap bar_ψ ⊥).IsMaximal :=
        Ideal.isMaximal_comap_of_isIntegral_of_isMaximal bar_ψ hbar_int ⊥
      have hq_ne : Ideal.comap bar_ψ ⊥ ≠ ⊥ :=
        Ring.ne_bot_of_isMaximal_of_not_isField hq_max (Polynomial.not_isField k₀)
      have hex_Q : ∃ Q : Polynomial k₀, Q ∈ Ideal.comap bar_ψ ⊥ ∧ Q ≠ 0 := by
        by_contra h_all
        push Not at h_all
        exact hq_ne (le_antisymm (fun x hx => by
          rw [Submodule.mem_bot]
          exact h_all x hx) bot_le)
      obtain ⟨Q, hQ_mem, hQ_ne⟩ := hex_Q
      letI : Algebra k₀ F_res := bar_κ.toAlgebra
      have hbar_aeval : bar_ψ = (Polynomial.aeval (bar_ψ Polynomial.X)).toRingHom := by
        apply Polynomial.ringHom_ext'
        · ext c
          simp only [bar_ψ, ψ, RingHom.comp_apply, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C,
            AlgHom.toRingHom_eq_coe, RingHom.coe_coe, Polynomial.aeval_C]
          rfl
        · simp
      have hQ_eval : Polynomial.aeval (bar_ψ Polynomial.X) Q = 0 := by
        have h0 : bar_ψ Q = 0 := by
          rwa [Ideal.mem_comap, Submodule.mem_bot] at hQ_mem
        exact (RingHom.congr_fun hbar_aeval Q).symm.trans h0
      have hy_alg : IsAlgebraic k₀ (bar_ψ Polynomial.X) := ⟨Q, hQ_ne, hQ_eval⟩
      have hy_int : IsIntegral k₀ (bar_ψ Polynomial.X) := hy_alg.isIntegral
      let S_sub : Subalgebra k₀ F_res := Algebra.adjoin k₀ {bar_ψ Polynomial.X}
      have : Algebra.IsIntegral k₀ ↥S_sub :=
        Algebra.IsIntegral.adjoin (by
          intro z hz
          rw [Set.mem_singleton_iff] at hz
          rwa [hz])
      have hmem_S : ∀ p : Polynomial k₀, bar_ψ p ∈ S_sub := by
        intro p
        have hp_eq : bar_ψ p = Polynomial.aeval (bar_ψ Polynomial.X) p :=
          RingHom.congr_fun hbar_aeval p
        rw [hp_eq]
        exact Polynomial.aeval_mem_adjoin_singleton k₀ (bar_ψ Polynomial.X)
      let bar_ψ_S : Polynomial k₀ →+* ↥S_sub := bar_ψ.codRestrict S_sub.toSubring hmem_S
      have hcomp_S : (algebraMap ↥S_sub F_res).comp bar_ψ_S = bar_ψ := by
        apply RingHom.ext
        intro p
        rfl
      have : Algebra.IsIntegral k₀ F_res := by
        refine ⟨fun z => ?_⟩
        obtain ⟨P, hP_monic, hP_eval⟩ := hbar_int z
        have hz_S : IsIntegral ↥S_sub z := by
          refine ⟨P.map bar_ψ_S, hP_monic.map bar_ψ_S, ?_⟩
          rw [Polynomial.eval₂_map, hcomp_S]
          exact hP_eval
        exact isIntegral_trans z hz_S
      exact IsAlgClosed.algebraMap_bijective_of_isIntegral
    exact ⟨a₀, m₀, hm₀_max, hBij_m₀, hMem_M⟩

  obtain ⟨hFin_fbar, hGoingUp⟩ := hAlgPkg

  
  have hAff_UY0 : AlgebraicGeometry.IsAffineOpen U_Y0 := by
    let S : Set A₀ := { a : A₀ | AlgebraicGeometry.IsAffineOpen (Y.basicOpen a) }
    refine AlgebraicGeometry.isAffineOpen_of_isAffineOpen_basicOpen U_Y0 S ?_ (fun _ ha => ha)
    by_contra h_ne
    obtain ⟨M, hM_max, hS_le_M⟩ := Ideal.exists_le_maximal (Ideal.span S) h_ne
    obtain ⟨a₀, m₀, hm₀_max, hBij_m₀, hMem_M⟩ := hGoingUp M hM_max
    have : m₀.IsMaximal := hm₀_max
    have : m₀.IsPrime := hm₀_max.isPrime
    let q₀ : PrimeSpectrum (R a₀) := ⟨m₀, inferInstance⟩
    let z₀ : ↥(Y_tilde a₀) := (hAffTilde0 a₀).fromSpec.base q₀
    let x : ↥Y := (ι_tilde a₀).base z₀

    
    have hx_0 : x ∈ U_Y0 := by
      have hz₀_mem : z₀ ∈ Set.range (hAffTilde0 a₀).fromSpec.base := Set.mem_range_self q₀
      rw [(hAffTilde0 a₀).range_fromSpec] at hz₀_mem
      exact hz₀_mem
    have hx_closed : IsClosed ({x} : Set ↥Y) := by
      have : AlgebraicGeometry.IsProper p_Y := hPropY
      let e_k : k₀ ≃+* (R a₀ ⧸ m₀) := RingEquiv.ofBijective _ hBij_m₀
      let ρ : R a₀ →+* k₀ := e_k.symm.toRingHom.comp (Ideal.Quotient.mk m₀)
      have hρ_sec : ρ.comp (κ_tilde a₀) = RingHom.id k₀ := by
        ext c
        exact e_k.symm_apply_apply c
      let φ_ρ : (Y_tilde a₀).presheaf.obj (Opposite.op (U_tilde0 a₀)) ⟶ CommRingCat.of k₀ :=
        CommRingCat.ofHom ρ
      let σ_x : AlgebraicGeometry.Spec (CommRingCat.of k₀) ⟶ Y :=
        AlgebraicGeometry.Spec.map φ_ρ ≫ (hAffTilde0 a₀).fromSpec ≫ ι_tilde a₀
      have hle_spec :
          (⊤ : (AlgebraicGeometry.Spec ((Y_tilde a₀).presheaf.obj
            (Opposite.op (U_tilde0 a₀)))).Opens) ≤
            (TopologicalSpace.Opens.map (hAffTilde0 a₀).fromSpec.base).obj (U_tilde0 a₀) :=
        le_of_eq (hAffTilde0 a₀).fromSpec_preimage_self.symm
      have h1 : (hAffTilde0 a₀).fromSpec.appLE (U_tilde0 a₀) ⊤ hle_spec =
          (AlgebraicGeometry.Scheme.ΓSpecIso
            ((Y_tilde a₀).presheaf.obj (Opposite.op (U_tilde0 a₀)))).inv := by
        rw [AlgebraicGeometry.Scheme.Hom.appLE, (hAffTilde0 a₀).fromSpec_app_self,
          CategoryTheory.Category.assoc, ← CategoryTheory.Functor.map_comp]
        trans ((AlgebraicGeometry.Scheme.ΓSpecIso
          ((Y_tilde a₀).presheaf.obj (Opposite.op (U_tilde0 a₀)))).inv ≫ 𝟙 _)
        · congr 1
        · exact CategoryTheory.Category.comp_id _
      have h2 : AlgebraicGeometry.Scheme.Hom.appTop
          ((hAffTilde0 a₀).fromSpec ≫ (ι_tilde a₀ ≫ p_Y)) =
          (ι_tilde a₀ ≫ p_Y).appLE ⊤ (U_tilde0 a₀) le_top ≫
            (AlgebraicGeometry.Scheme.ΓSpecIso
              ((Y_tilde a₀).presheaf.obj (Opposite.op (U_tilde0 a₀)))).inv := by
        change ((hAffTilde0 a₀).fromSpec ≫ (ι_tilde a₀ ≫ p_Y)).appLE ⊤ ⊤ le_top = _
        rw [← h1]
        exact (AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE (hAffTilde0 a₀).fromSpec
          (ι_tilde a₀ ≫ p_Y) ⊤ (U_tilde0 a₀) ⊤ le_top hle_spec).symm
      have h4 := AlgebraicGeometry.Scheme.ΓSpecIso_naturality φ_ρ
      have h5 : (AlgebraicGeometry.Scheme.ΓSpecIso
          ((Y_tilde a₀).presheaf.obj (Opposite.op (U_tilde0 a₀)))).inv ≫
          AlgebraicGeometry.Scheme.Hom.appTop (AlgebraicGeometry.Spec.map φ_ρ) =
          φ_ρ ≫ (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv := by
        rw [← CategoryTheory.Iso.eq_comp_inv] at h4
        rw [CategoryTheory.Iso.inv_comp_eq]
        simp only [h4, CategoryTheory.Category.assoc]
      have hSec_x : σ_x ≫ p_Y = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k₀)) := by
        apply AlgebraicGeometry.ext_of_isAffine
        have h3 : AlgebraicGeometry.Scheme.Hom.appTop (σ_x ≫ p_Y) =
            (ι_tilde a₀ ≫ p_Y).appLE ⊤ (U_tilde0 a₀) le_top ≫ φ_ρ ≫
              (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv := by
          change AlgebraicGeometry.Scheme.Hom.appTop
            (AlgebraicGeometry.Spec.map φ_ρ ≫
              ((hAffTilde0 a₀).fromSpec ≫ (ι_tilde a₀ ≫ p_Y))) = _
          rw [AlgebraicGeometry.Scheme.Hom.comp_appTop, h2, CategoryTheory.Category.assoc, h5]
        have h6 : ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
            (ι_tilde a₀ ≫ p_Y).appLE ⊤ (U_tilde0 a₀) le_top) ≫ φ_ρ =
            𝟙 (CommRingCat.of k₀) := by
          ext c
          exact DFunLike.congr_fun hρ_sec c
        change AlgebraicGeometry.Scheme.Hom.appTop (σ_x ≫ p_Y) =
          AlgebraicGeometry.Scheme.Hom.appTop (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k₀)))
        rw [h3]
        calc
          (ι_tilde a₀ ≫ p_Y).appLE ⊤ (U_tilde0 a₀) le_top ≫ φ_ρ ≫
              (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv =
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).hom ≫
              (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
                (ι_tilde a₀ ≫ p_Y).appLE ⊤ (U_tilde0 a₀) le_top) ≫ φ_ρ) ≫
              (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv := by
            simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id_assoc]
          _ = AlgebraicGeometry.Scheme.Hom.appTop
              (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k₀))) := by
            rw [h6, CategoryTheory.Category.id_comp, CategoryTheory.Iso.hom_inv_id]
            rfl
      have : AlgebraicGeometry.IsProper (σ_x ≫ p_Y) := by
        rw [hSec_x]
        infer_instance
      have : AlgebraicGeometry.IsProper σ_x :=
        AlgebraicGeometry.IsProper.of_comp σ_x p_Y
      let pt₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of k₀)) := (⊥ : PrimeSpectrum k₀)
      have hq_spec : (AlgebraicGeometry.Spec.map φ_ρ).base pt₀ = q₀ := by
        apply PrimeSpectrum.ext
        ext r
        rw [← not_iff_not]
        have h_lhs1 : r ∉ ((AlgebraicGeometry.Spec.map φ_ρ).base pt₀).asIdeal ↔
            (AlgebraicGeometry.Spec.map φ_ρ).base pt₀ ∈
              (AlgebraicGeometry.Spec
                ((Y_tilde a₀).presheaf.obj (Opposite.op (U_tilde0 a₀)))).basicOpen
                ((AlgebraicGeometry.Scheme.ΓSpecIso
                  ((Y_tilde a₀).presheaf.obj (Opposite.op (U_tilde0 a₀)))).inv.hom r) := by
          rw [AlgebraicGeometry.basicOpen_eq_of_affine r]
          exact (PrimeSpectrum.mem_basicOpen r ((AlgebraicGeometry.Spec.map φ_ρ).base pt₀)).symm
        rw [h_lhs1]
        change pt₀ ∈ (TopologicalSpace.Opens.map (AlgebraicGeometry.Spec.map φ_ρ).base).obj
            ((AlgebraicGeometry.Spec
              ((Y_tilde a₀).presheaf.obj (Opposite.op (U_tilde0 a₀)))).basicOpen _) ↔ r ∉ m₀
        rw [(AlgebraicGeometry.Spec.map φ_ρ).preimage_basicOpen]
        have h_app_r : ((AlgebraicGeometry.Spec.map φ_ρ).app ⊤).hom
            ((AlgebraicGeometry.Scheme.ΓSpecIso
              ((Y_tilde a₀).presheaf.obj (Opposite.op (U_tilde0 a₀)))).inv.hom r) =
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv.hom (ρ r) :=
          congrArg (fun m => m.hom r) h5
        change pt₀ ∈ (AlgebraicGeometry.Spec (CommRingCat.of k₀)).basicOpen (U := ⊤)
          (((AlgebraicGeometry.Spec.map φ_ρ).app ⊤).hom
            ((AlgebraicGeometry.Scheme.ΓSpecIso
              ((Y_tilde a₀).presheaf.obj (Opposite.op (U_tilde0 a₀)))).inv.hom r)) ↔ r ∉ m₀
        rw [h_app_r, AlgebraicGeometry.basicOpen_eq_of_affine (R := CommRingCat.of k₀) (ρ r)]
        refine (PrimeSpectrum.mem_basicOpen (ρ r) pt₀).trans ?_
        change ρ r ∉ (⊥ : Ideal k₀) ↔ r ∉ m₀
        rw [Submodule.mem_bot, not_iff_not]
        change e_k.symm (Ideal.Quotient.mk m₀ r) = 0 ↔ r ∈ m₀
        rw [map_eq_zero_iff e_k.symm e_k.symm.injective, Ideal.Quotient.eq_zero_iff_mem]
      have hσ_pt : σ_x.base pt₀ = x := by
        change (ι_tilde a₀).base ((hAffTilde0 a₀).fromSpec.base
          ((AlgebraicGeometry.Spec.map φ_ρ).base pt₀)) = x
        rw [hq_spec]
      have hIm : σ_x.base '' Set.univ = ({x} : Set ↥Y) := by
        ext y
        simp only [Set.mem_image, Set.mem_univ, true_and, Set.mem_singleton_iff]
        refine ⟨?_, fun hy => ⟨pt₀, hy ▸ hσ_pt⟩⟩
        rintro ⟨q, rfl⟩
        have hq : q = pt₀ := Subsingleton.elim q pt₀
        rw [hq, hσ_pt]
      rw [← hIm]
      exact AlgebraicGeometry.Scheme.Hom.isClosedMap σ_x Set.univ isClosed_univ

    
    obtain ⟨V_x, hVx_aff, hx_Vx, hVx_sub⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hx_0
    have hVx_le : V_x ≤ U_Y0 := hVx_sub
    have hp_x_max : (hVx_aff.primeIdealOf ⟨x, hx_Vx⟩).asIdeal.IsMaximal :=
      hVx_aff.primeIdealOf_isMaximal_of_isClosed ⟨x, hx_Vx⟩ hx_closed

    
    have hFib : ∀ b : Fin (L_comp + 1),
        { q : PrimeSpectrum (R b) |
            (ι_tilde b).base ((hAffTilde0 b).fromSpec.base q) = x }.Finite ∧
        ∀ (q : PrimeSpectrum (R b)),
          (ι_tilde b).base ((hAffTilde0 b).fromSpec.base q) = x → q.asIdeal.IsMaximal := by
      intro b
      have : AlgebraicGeometry.IsFinite (ι_tilde b) := hFinMap b
      have hFb_fin : ((ι_tilde b).base ⁻¹' ({x} : Set ↥Y)).Finite :=
        AlgebraicGeometry.Scheme.Hom.finite_preimage (ι_tilde b) (Set.finite_singleton x)
      have hTb_fin : { q : PrimeSpectrum (R b) |
          (ι_tilde b).base ((hAffTilde0 b).fromSpec.base q) = x }.Finite :=
        hFb_fin.preimage ((hAffTilde0 b).fromSpec.isOpenEmbedding.injective.injOn)
      refine ⟨hTb_fin, fun q hq => ?_⟩
      let W_b : (Y_tilde b).Opens := (TopologicalSpace.Opens.map (ι_tilde b).base).obj V_x
      have hWb_aff : AlgebraicGeometry.IsAffineOpen W_b := hVx_aff.preimage (ι_tilde b)
      have happ_Wb : (ι_tilde b).appLE V_x W_b (le_refl W_b) = (ι_tilde b).app V_x := by
        rw [AlgebraicGeometry.Scheme.Hom.appLE]
        have hid : (CategoryTheory.homOfLE (le_refl W_b)).op = 𝟙 (Opposite.op W_b) :=
          Subsingleton.elim _ _
        rw [hid, CategoryTheory.Functor.map_id, CategoryTheory.Category.comp_id]
      have hβ_int : ((ι_tilde b).appLE V_x W_b (le_refl W_b)).hom.IsIntegral := by
        rw [happ_Wb]
        exact ((AlgebraicGeometry.isIntegralHom_iff (ι_tilde b)).mp inferInstance).2 V_x hVx_aff
      let z : ↥(Y_tilde b) := (hAffTilde0 b).fromSpec.base q
      have hz_Wb : z ∈ W_b := by
        change (ι_tilde b).base z ∈ V_x
        rwa [hq]
      let q_W : ↥(AlgebraicGeometry.Spec ((Y_tilde b).presheaf.obj (Opposite.op W_b))) :=
        hWb_aff.primeIdealOf ⟨z, hz_Wb⟩
      have hComap_qW :
          Ideal.comap ((ι_tilde b).appLE V_x W_b (le_refl W_b)).hom q_W.asIdeal =
            (hVx_aff.primeIdealOf ⟨x, hx_Vx⟩).asIdeal :=
        hComapPrime (ι_tilde b) V_x hVx_aff W_b hWb_aff (le_refl W_b)
          ⟨z, hz_Wb⟩ ⟨x, hx_Vx⟩ hq
      have hComap_max :
          (Ideal.comap ((ι_tilde b).appLE V_x W_b (le_refl W_b)).hom q_W.asIdeal).IsMaximal :=
        hComap_qW.symm ▸ hp_x_max
      have hqW_max : q_W.asIdeal.IsMaximal :=
        Ideal.isMaximal_of_isIntegral_of_isMaximal_comap
          ((ι_tilde b).appLE V_x W_b (le_refl W_b)).hom hβ_int q_W.asIdeal hComap_max
      have hqW_cl : IsClosed ({q_W} :
          Set ↥(AlgebraicGeometry.Spec ((Y_tilde b).presheaf.obj (Opposite.op W_b)))) :=
        (PrimeSpectrum.isClosed_singleton_iff_isMaximal q_W).mpr hqW_max
      obtain ⟨K, hK_closed, hK_pre⟩ :=
        hWb_aff.fromSpec.isOpenEmbedding.isInducing.isClosed_iff.mp hqW_cl
      have hz_eq_inter : ({z} : Set ↥(Y_tilde b)) =
          ((ι_tilde b).base ⁻¹' ({x} : Set ↥Y)) ∩ K := by
        ext w
        simp only [Set.mem_singleton_iff, Set.mem_inter_iff, Set.mem_preimage]
        refine ⟨?_, ?_⟩
        · rintro rfl
          refine ⟨hq, ?_⟩
          have hqW_mem : q_W ∈ hWb_aff.fromSpec.base ⁻¹' K := by
            rw [hK_pre]
            exact Set.mem_singleton q_W
          change hWb_aff.fromSpec.base q_W ∈ K at hqW_mem
          rwa [hWb_aff.fromSpec_primeIdealOf ⟨z, hz_Wb⟩] at hqW_mem
        · rintro ⟨hw_x, hw_K⟩
          have hw_Wb : w ∈ W_b := by
            change (ι_tilde b).base w ∈ V_x
            rwa [hw_x]
          let q_w : ↥(AlgebraicGeometry.Spec ((Y_tilde b).presheaf.obj (Opposite.op W_b))) :=
            hWb_aff.primeIdealOf ⟨w, hw_Wb⟩
          have hqw_mem : q_w ∈ hWb_aff.fromSpec.base ⁻¹' K := by
            change hWb_aff.fromSpec.base q_w ∈ K
            rwa [hWb_aff.fromSpec_primeIdealOf ⟨w, hw_Wb⟩]
          rw [hK_pre, Set.mem_singleton_iff] at hqw_mem
          calc
            w = hWb_aff.fromSpec.base q_w := (hWb_aff.fromSpec_primeIdealOf ⟨w, hw_Wb⟩).symm
            _ = hWb_aff.fromSpec.base q_W := by rw [hqw_mem]
            _ = z := hWb_aff.fromSpec_primeIdealOf ⟨z, hz_Wb⟩
      have hz_closed : IsClosed ({z} : Set ↥(Y_tilde b)) := by
        rw [hz_eq_inter]
        exact (hx_closed.preimage (ι_tilde b).continuous).inter hK_closed
      have hz_U0 : z ∈ U_tilde0 b := by
        change (ι_tilde b).base z ∈ U_Y0
        rwa [hq]
      have hq_eq : (hAffTilde0 b).primeIdealOf ⟨z, hz_U0⟩ = q :=
        (hAffTilde0 b).fromSpec.isOpenEmbedding.injective
          ((hAffTilde0 b).fromSpec_primeIdealOf ⟨z, hz_U0⟩)
      have hz_max : ((hAffTilde0 b).primeIdealOf ⟨z, hz_U0⟩).asIdeal.IsMaximal :=
        (hAffTilde0 b).primeIdealOf_isMaximal_of_isClosed ⟨z, hz_U0⟩ hz_closed
      rwa [hq_eq] at hz_max

    
    let K_sing : Set ↥Y := (U_sm : Set ↥Y)ᶜ \ {x}
    have hKsing_closed : IsClosed K_sing := by
      have hK_eq : K_sing = ⋃ y ∈ K_sing, ({y} : Set ↥Y) := by
        ext y
        simp
      rw [hK_eq]
      exact (hSingFin.sdiff).isClosed_biUnion (fun y hy => hSingClosed y hy.1)
    let K_x : Set ↥Y := (V_x : Set ↥Y)ᶜ ∪ K_sing
    have hKx_closed : IsClosed K_x := V_x.isOpen.isClosed_compl.union hKsing_closed
    have hx_not_Kx : x ∉ K_x := by
      rintro (hx_compl | hx_ksing)
      · exact hx_compl hx_Vx
      · exact hx_ksing.2 rfl
    classical
    let φ : ∀ b : Fin (L_comp + 1), PrimeSpectrum (R b) → ↥Y :=
      fun b q => (ι_tilde b).base ((hAffTilde0 b).fromSpec.base q)
    let K_tilde : ∀ b : Fin (L_comp + 1), Set (PrimeSpectrum (R b)) :=
      fun b => φ b ⁻¹' K_x
    let J : ∀ b : Fin (L_comp + 1), Ideal (R b) :=
      fun b => PrimeSpectrum.vanishingIdeal (K_tilde b)
    have hZero_J : ∀ b : Fin (L_comp + 1),
        PrimeSpectrum.zeroLocus (J b : Set (R b)) = K_tilde b := by
      intro b
      have hφ_cont : Continuous (φ b) :=
        ((hAffTilde0 b).fromSpec ≫ ι_tilde b).continuous
      rw [PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure,
        (hKx_closed.preimage hφ_cont).closure_eq]
    let F_fin : ∀ b : Fin (L_comp + 1), Finset (PrimeSpectrum (R b)) :=
      fun b => (hFib b).1.toFinset
    have hCopr_all : ∀ b : Fin (L_comp + 1),
        ∃ (h_b m_b : R b),
          h_b ∈ J b ∧ m_b ∈ (∏ q ∈ F_fin b, q.asIdeal) ∧ h_b + m_b = 1 := by
      intro b
      have hcopr : IsCoprime (J b) (∏ q ∈ F_fin b, q.asIdeal) := by
        apply IsCoprime.prod_right
        intro q hq_mem
        have hq_x : φ b q = x := ((hFib b).1.mem_toFinset.mp hq_mem)
        have hq_max : q.asIdeal.IsMaximal := (hFib b).2 q hq_x
        have hJ_not_le : ¬ (J b ≤ q.asIdeal) := by
          intro hle
          have hq_zero : q ∈ PrimeSpectrum.zeroLocus (J b : Set (R b)) := by
            rwa [PrimeSpectrum.mem_zeroLocus]
          rw [hZero_J b] at hq_zero
          exact hx_not_Kx (hq_x ▸ hq_zero)
        rw [Ideal.isCoprime_iff_sup_eq]
        by_contra hsup_ne
        have hq_eq_sup : q.asIdeal = J b ⊔ q.asIdeal :=
          hq_max.eq_of_le hsup_ne le_sup_right
        exact hJ_not_le (le_sup_left.trans hq_eq_sup.symm.le)
      obtain ⟨h_b, hh_b, m_b, hm_b, hsum⟩ := Ideal.isCoprime_iff_exists.mp hcopr
      exact ⟨h_b, m_b, hh_b, hm_b, hsum⟩
    choose h_tup m_tup hh_J hm_prod hhm_one using hCopr_all

    obtain ⟨a_x, ha_x⟩ : ∃ a_x : A₀, ∀ b : Fin (L_comp + 1), α b a_x = h_tup b := by
      apply hDescend h_tup
      intro y₀ hy₀
      have hy₀_0 : y₀ ∈ U_Y0 := hSingIn0 hy₀
      by_cases hyx : y₀ = x
      · refine ⟨1, fun b z hz => ?_⟩
        rw [hyx] at hz
        have hz_U0 : z ∈ U_tilde0 b := by
          change (ι_tilde b).base z ∈ U_Y0
          rwa [hz]
        rw [hMemBasic (hAffTilde0 b) ⟨z, hz_U0⟩, not_not]
        let q : PrimeSpectrum (R b) := (hAffTilde0 b).primeIdealOf ⟨z, hz_U0⟩
        have hq_x : φ b q = x := by
          dsimp [φ, q]
          rw [(hAffTilde0 b).fromSpec_primeIdealOf ⟨z, hz_U0⟩, hz]
        have hq_mem : q ∈ F_fin b := (hFib b).1.mem_toFinset.mpr hq_x
        have hm_q : m_tup b ∈ q.asIdeal :=
          (Ideal.prod_le_inf.trans (Finset.inf_le hq_mem)) (hm_prod b)
        have hsub : h_tup b - κ_tilde b 1 = -m_tup b := by
          rw [map_one, ← hhm_one b]
          ring
        change h_tup b - κ_tilde b 1 ∈ q.asIdeal
        rw [hsub]
        exact q.asIdeal.neg_mem hm_q
      · refine ⟨0, fun b z hz => ?_⟩
        have hz_U0 : z ∈ U_tilde0 b := by
          change (ι_tilde b).base z ∈ U_Y0
          rwa [hz]
        rw [hMemBasic (hAffTilde0 b) ⟨z, hz_U0⟩, not_not]
        let q : PrimeSpectrum (R b) := (hAffTilde0 b).primeIdealOf ⟨z, hz_U0⟩
        have hq_K : q ∈ K_tilde b := by
          change φ b q ∈ K_x
          dsimp [φ, q]
          rw [(hAffTilde0 b).fromSpec_primeIdealOf ⟨z, hz_U0⟩, hz]
          exact Or.inr ⟨hy₀, hyx⟩
        rw [← hZero_J b, PrimeSpectrum.mem_zeroLocus] at hq_K
        have hsub : h_tup b - κ_tilde b 0 = h_tup b := by
          rw [map_zero, sub_zero]
        change h_tup b - κ_tilde b 0 ∈ q.asIdeal
        rw [hsub]
        exact hq_K (hh_J b)

    have hB_le_Vx : Y.basicOpen a_x ≤ V_x := by
      intro y hy
      have hy_univ : y ∈ (Set.univ : Set ↥Y) := Set.mem_univ y
      rw [← hSurjAll, Set.mem_iUnion] at hy_univ
      obtain ⟨b, z, hzy⟩ := hy_univ
      have hz_pre : z ∈ ((TopologicalSpace.Opens.map (ι_tilde b).base).obj (Y.basicOpen a_x) :
          Set ↥(Y_tilde b)) := by
        change (ι_tilde b).base z ∈ Y.basicOpen a_x
        rwa [hzy]
      rw [(ι_tilde b).preimage_basicOpen a_x, ha_x b] at hz_pre
      have hz_U0 : z ∈ U_tilde0 b := (Y_tilde b).basicOpen_le (h_tup b) hz_pre
      have hh_not_q : h_tup b ∉ ((hAffTilde0 b).primeIdealOf ⟨z, hz_U0⟩).asIdeal :=
        (hMemBasic (hAffTilde0 b) ⟨z, hz_U0⟩ (h_tup b)).mp hz_pre
      by_contra hy_not_Vx
      have hq_K : (hAffTilde0 b).primeIdealOf ⟨z, hz_U0⟩ ∈ K_tilde b := by
        change φ b ((hAffTilde0 b).primeIdealOf ⟨z, hz_U0⟩) ∈ K_x
        dsimp [φ]
        rw [(hAffTilde0 b).fromSpec_primeIdealOf ⟨z, hz_U0⟩, hzy]
        exact Or.inl hy_not_Vx
      rw [← hZero_J b, PrimeSpectrum.mem_zeroLocus] at hq_K
      exact hh_not_q (hq_K (hh_J b))

    have hAff_ax : AlgebraicGeometry.IsAffineOpen (Y.basicOpen a_x) := by
      let a_Vx := (Y.presheaf.map (CategoryTheory.homOfLE hVx_le).op).hom a_x
      have hEq : Y.basicOpen a_Vx = Y.basicOpen a_x := by
        rw [Y.basicOpen_res, inf_eq_right.mpr hB_le_Vx]
      rw [← hEq]
      exact hVx_aff.basicOpen a_Vx

    have hax_not_m₀ : α a₀ a_x ∉ m₀ := by
      rw [ha_x a₀]
      intro hh_m₀
      have hq₀_mem : q₀ ∈ F_fin a₀ := (hFib a₀).1.mem_toFinset.mpr rfl
      have hm_m₀ : m_tup a₀ ∈ m₀ :=
        (Ideal.prod_le_inf.trans (Finset.inf_le hq₀_mem)) (hm_prod a₀)
      have h1_m₀ : (1 : R a₀) ∈ m₀ := by
        rw [← hhm_one a₀]
        exact m₀.add_mem hh_m₀ hm_m₀
      exact hm₀_max.ne_top (m₀.eq_top_of_isUnit_mem h1_m₀ isUnit_one)

    have ha_x_M : a_x ∈ M := hS_le_M (Ideal.subset_span hAff_ax)
    exact hax_not_m₀ ((hMem_M a_x).mp ha_x_M)

  exact ⟨hAff_UY0, f_bar, hf_pull, hf_le_sm, hFin_fbar⟩

theorem weil_nodal_curve_section_descent_and_open_affineness (k₀ : Type u) [Field k₀] [IsAlgClosed k₀]
    (Y : AlgebraicGeometry.Scheme.{u})
    (hRedY : AlgebraicGeometry.IsReduced Y)
    (p_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of k₀))
    (hPropY : AlgebraicGeometry.IsProper p_Y)
    (U_sm : Y.Opens)
    (hSingFin : ((U_sm : Set ↥Y)ᶜ).Finite)
    (hNodalOut : ∀ y : ↥Y, y ∉ U_sm →
      ∃ (U' : AlgebraicGeometry.Scheme.{u}) (u₀ : U')
        (e₁ : U' ⟶ Y)
        (e₂ : U' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
          (MvPolynomial (Fin 2) k₀ ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}))),
        AlgebraicGeometry.Etale e₁ ∧
        AlgebraicGeometry.Etale e₂ ∧
        e₁.base u₀ = y ∧
        (∀ i : Fin 2, Ideal.Quotient.mk _ (MvPolynomial.X i) ∈ (e₂.base u₀).asIdeal) ∧
        e₁ ≫ p_Y =
          e₂ ≫ AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)))
    (L_comp : ℕ)
    (U_part : Fin (L_comp + 1) → Y.Opens)
    (hPartSup : (⨆ a : Fin (L_comp + 1), U_part a) = U_sm)
    (hPartDisj : _root_.Pairwise fun a b : Fin (L_comp + 1) => Disjoint (U_part a) (U_part b))
    (Y_tilde : Fin (L_comp + 1) → AlgebraicGeometry.Scheme.{u})
    (ι_tilde : ∀ a : Fin (L_comp + 1), Y_tilde a ⟶ Y)
    (hSurjAll : (⋃ a : Fin (L_comp + 1), Set.range (ι_tilde a).base) = Set.univ)
    (hComp : ∀ a : Fin (L_comp + 1),
      AlgebraicGeometry.IsIntegral (Y_tilde a) ∧
      (∀ (U : (Y_tilde a).Opens), AlgebraicGeometry.IsAffineOpen U → Nonempty U →
        IsDomain ↑((Y_tilde a).presheaf.obj (Opposite.op U)) ∧
        IsIntegrallyClosed ↑((Y_tilde a).presheaf.obj (Opposite.op U))) ∧
      AlgebraicGeometry.IsFinite (ι_tilde a) ∧
      Set.range (ι_tilde a).base ∈ irreducibleComponents ↥Y ∧
      (U_part a : Set ↥Y) = Set.range (ι_tilde a).base ∩ (U_sm : Set ↥Y) ∧
      Nonempty ↥(U_part a) ∧
      CategoryTheory.IsIso (ι_tilde a ∣_ U_part a))
    (U_Y0 : Y.Opens)
    (hSingIn0 : (U_sm : Set ↥Y)ᶜ ⊆ (U_Y0 : Set ↥Y))
    (hAffTilde0 : ∀ a : Fin (L_comp + 1),
      AlgebraicGeometry.IsAffineOpen ((TopologicalSpace.Opens.map (ι_tilde a).base).obj U_Y0))
    (f_tilde : ∀ a : Fin (L_comp + 1),
      ↑((Y_tilde a).presheaf.obj (Opposite.op ((TopologicalSpace.Opens.map (ι_tilde a).base).obj U_Y0))))
    (hVanish : ∀ (a : Fin (L_comp + 1)) (z : ↥(Y_tilde a)),
      (ι_tilde a).base z ∉ U_part a → z ∉ (Y_tilde a).basicOpen (f_tilde a))
    (hFinTilde0 : ∀ a : Fin (L_comp + 1),
      (Polynomial.eval₂RingHom
        (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
          (ι_tilde a ≫ p_Y).appLE ⊤
            ((TopologicalSpace.Opens.map (ι_tilde a).base).obj U_Y0) le_top).hom)
        (f_tilde a)).Finite) :
    AlgebraicGeometry.IsAffineOpen U_Y0 ∧
    ∃ (f_bar : ↑(Y.presheaf.obj (Opposite.op U_Y0))),
      (∀ a : Fin (L_comp + 1), ((ι_tilde a).app U_Y0).hom f_bar = f_tilde a) ∧
      Y.basicOpen f_bar ≤ U_sm ∧
      (Polynomial.eval₂RingHom
        (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
          p_Y.appLE ⊤ U_Y0 le_top).hom) f_bar).Finite :=
by
  
  have hMemBasic : ∀ {X : AlgebraicGeometry.Scheme.{u}} {U : X.Opens}
      (hU : AlgebraicGeometry.IsAffineOpen U) (x : ↥U)
      (f : ↑(X.presheaf.obj (Opposite.op U))),
      (x : ↥X) ∈ X.basicOpen f ↔ f ∉ (hU.primeIdealOf x).asIdeal := by
    intro X U hU x f
    rw [← hU.fromSpec_primeIdealOf x]
    change hU.primeIdealOf x ∈
      (TopologicalSpace.Opens.map hU.fromSpec.base).obj (X.basicOpen f) ↔ _
    rw [hU.fromSpec_preimage_basicOpen f]
    exact PrimeSpectrum.mem_basicOpen f (hU.primeIdealOf x)
  have hComapPrime : ∀ {X Z : AlgebraicGeometry.Scheme.{u}} (g_hom : X ⟶ Z)
      (U : Z.Opens) (hU : AlgebraicGeometry.IsAffineOpen U)
      (V : X.Opens) (hV : AlgebraicGeometry.IsAffineOpen V)
      (hVU : V ≤ (TopologicalSpace.Opens.map g_hom.base).obj U)
      (v : ↥V) (z : ↥U),
      g_hom.base v = z →
      Ideal.comap ((g_hom.appLE U V hVU).hom) (hV.primeIdealOf v).asIdeal =
        (hU.primeIdealOf z).asIdeal := by
    intro X Z g_hom U hU V hV hVU v z hvz
    ext r
    rw [Ideal.mem_comap, ← not_iff_not, ← hMemBasic hV v _, ← hMemBasic hU z r]
    have happ : (g_hom.appLE U V hVU).hom r =
        (X.presheaf.map (CategoryTheory.homOfLE hVU).op).hom ((g_hom.app U).hom r) := by
      rw [AlgebraicGeometry.Scheme.Hom.appLE]
      rfl
    rw [happ, X.basicOpen_res, ← g_hom.preimage_basicOpen r]
    change (v : ↥X) ∈ (V : Set ↥X) ∩ g_hom.base ⁻¹' (Z.basicOpen r : Set ↥Z) ↔
      (z : ↥Z) ∈ Z.basicOpen r
    simp only [Set.mem_inter_iff, Set.mem_preimage, SetLike.mem_coe, v.2, true_and, hvz]
  
  let R₀_nodal : Type u :=
    MvPolynomial (Fin 2) k₀ ⧸
      Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} : Set (MvPolynomial (Fin 2) k₀))
  have hBijΓR₀ : Function.Bijective
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀_nodal)).inv.hom) := by
    refine ⟨fun x₁ x₂ hx => ?_, fun z =>
      ⟨(AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀_nodal)).hom.hom z, ?_⟩⟩
    · have h := congrArg ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀_nodal)).hom.hom) hx
      change ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀_nodal)).inv ≫
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀_nodal)).hom).hom x₁ =
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀_nodal)).inv ≫
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀_nodal)).hom).hom x₂ at h
      simpa using h
    · change ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀_nodal)).hom ≫
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀_nodal)).inv).hom z = z
      simp
  have hRoofHyp : ∀ (y : ↥Y) (W : Y.Opens) (hW : AlgebraicGeometry.IsAffineOpen W) (hyW : y ∈ W)
      (U' : AlgebraicGeometry.Scheme.{u}) (u₀ : ↥U')
      (e₁ : U' ⟶ Y) (e₂ : U' ⟶ AlgebraicGeometry.Spec (CommRingCat.of R₀_nodal))
      (_hEt₁ : AlgebraicGeometry.Etale e₁) (_hEt₂ : AlgebraicGeometry.Etale e₂)
      (_hu₀_y : e₁.base u₀ = y)
      (_hNode_u₀ : ∀ i : Fin 2, Ideal.Quotient.mk _ (MvPolynomial.X i) ∈ (e₂.base u₀).asIdeal)
      (_he_comm : e₁ ≫ p_Y =
        e₂ ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)))
      (V' : U'.Opens) (hV' : AlgebraicGeometry.IsAffineOpen V') (hu₀V' : u₀ ∈ V')
      (hV'_le : V' ≤ (TopologicalSpace.Opens.map e₁.base).obj W),
      let c_A := (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
        p_Y.appLE ⊤ W le_top).hom)
      let φ₀ := (e₁.appLE W V' hV'_le).hom
      let ψ₀ := (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀_nodal)).inv ≫
        e₂.appLE ⊤ V' le_top).hom)
      let p_y := (hW.primeIdealOf ⟨y, hyW⟩).asIdeal
      let q₀ := (hV'.primeIdealOf ⟨u₀, hu₀V'⟩).asIdeal
      φ₀.Etale ∧ ψ₀.Etale ∧
      φ₀.comp c_A = ψ₀.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) ∧
      Ideal.comap φ₀ q₀ = p_y ∧
      (∀ i : Fin 2, ψ₀ (Ideal.Quotient.mk _ (MvPolynomial.X i)) ∈ q₀) := by
    intro y W hW hyW U' u₀ e₁ e₂ hEt₁ hEt₂ hu₀_y hNode_u₀ he_comm V' hV' hu₀V' hV'_le
    dsimp only
    have hEtφ₀ : (e₁.appLE W V' hV'_le).hom.Etale := by
      first
      | exact AlgebraicGeometry.HasRingHomProperty.appLE @AlgebraicGeometry.Etale hEt₁ hW hV' hV'_le
      | exact AlgebraicGeometry.HasRingHomProperty.appLE @AlgebraicGeometry.Etale e₁ hEt₁
          ⟨W, hW⟩ ⟨V', hV'⟩ hV'_le
    have hEt_e₂_app : (e₂.appLE ⊤ V' le_top).hom.Etale := by
      first
      | exact AlgebraicGeometry.HasRingHomProperty.appLE @AlgebraicGeometry.Etale hEt₂
          (AlgebraicGeometry.isAffineOpen_top _) hV' le_top
      | exact AlgebraicGeometry.HasRingHomProperty.appLE @AlgebraicGeometry.Etale e₂ hEt₂
          ⟨⊤, AlgebraicGeometry.isAffineOpen_top _⟩ ⟨V', hV'⟩ le_top
    have hEtψ₀ : (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀_nodal)).inv ≫
        e₂.appLE ⊤ V' le_top).hom).Etale := by
      first
      | exact RingHom.Etale.comp hEt_e₂_app (RingHom.Etale.of_bijective hBijΓR₀)
      | exact RingHom.Etale.stableUnderComposition _ _
          (RingHom.Etale.of_bijective hBijΓR₀) hEt_e₂_app
    let α : k₀ →+* R₀_nodal := (Ideal.Quotient.mk _).comp MvPolynomial.C
    have hCompatCat :
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
          p_Y.appLE ⊤ W le_top) ≫ e₁.appLE W V' hV'_le =
        CommRingCat.ofHom α ≫
          ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀_nodal)).inv ≫
            e₂.appLE ⊤ V' le_top) := by
      rw [CategoryTheory.Category.assoc,
        AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE e₁ p_Y ⊤ W V' le_top hV'_le, he_comm]
      have hcomp_e₂ :
          (e₂ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom α)).appLE ⊤ V' le_top =
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α)).appTop ≫ e₂.appLE ⊤ V' le_top :=
        AlgebraicGeometry.Scheme.Hom.comp_appLE e₂
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α)) ⊤ V' le_top
      rw [hcomp_e₂]
      have hnat := AlgebraicGeometry.Scheme.ΓSpecIso_naturality (CommRingCat.ofHom α)
      have hnat' :
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α)).appTop =
            CommRingCat.ofHom α ≫
              (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀_nodal)).inv := by
        rw [← CategoryTheory.Iso.eq_comp_inv] at hnat
        rw [CategoryTheory.Iso.inv_comp_eq]
        simp only [hnat, CategoryTheory.Category.assoc]
      rw [← CategoryTheory.Category.assoc, hnat', CategoryTheory.Category.assoc]
    have hCompat : (e₁.appLE W V' hV'_le).hom.comp
        (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
          p_Y.appLE ⊤ W le_top).hom) =
        (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀_nodal)).inv ≫
          e₂.appLE ⊤ V' le_top).hom).comp α :=
      congrArg CommRingCat.Hom.hom hCompatCat
    have hComap := hComapPrime e₁ W hW V' hV' hV'_le ⟨u₀, hu₀V'⟩ ⟨y, hyW⟩ hu₀_y
    have hNode : ∀ i : Fin 2,
        (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀_nodal)).inv ≫
          e₂.appLE ⊤ V' le_top).hom) (Ideal.Quotient.mk _ (MvPolynomial.X i)) ∈
          (hV'.primeIdealOf ⟨u₀, hu₀V'⟩).asIdeal := by
      intro i
      let r : R₀_nodal := Ideal.Quotient.mk _ (MvPolynomial.X i)
      let ψ₀ := (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀_nodal)).inv ≫
        e₂.appLE ⊤ V' le_top).hom)
      by_contra hnot
      have hu₀_basic : u₀ ∈ U'.basicOpen (ψ₀ r) :=
        (hMemBasic hV' ⟨u₀, hu₀V'⟩ (ψ₀ r)).mpr hnot
      have hV'_top : V' ≤ (TopologicalSpace.Opens.map e₂.base).obj ⊤ := le_top
      have hψ_eq : ψ₀ r =
          (U'.presheaf.map (CategoryTheory.homOfLE hV'_top).op).hom
            ((e₂.app ⊤).hom
              ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀_nodal)).inv.hom r)) := by
        change ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀_nodal)).inv ≫
          e₂.appLE ⊤ V' hV'_top).hom r = _
        rw [AlgebraicGeometry.Scheme.Hom.appLE]
        rfl
      rw [hψ_eq, U'.basicOpen_res, ← e₂.preimage_basicOpen] at hu₀_basic
      have he₂_basic : e₂.base u₀ ∈
          (AlgebraicGeometry.Spec (CommRingCat.of R₀_nodal)).basicOpen
            ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀_nodal)).inv.hom r) := hu₀_basic.2
      rw [AlgebraicGeometry.basicOpen_eq_of_affine (R := CommRingCat.of R₀_nodal) r] at he₂_basic
      exact (PrimeSpectrum.mem_basicOpen r (e₂.base u₀)).mp he₂_basic (hNode_u₀ i)
    exact ⟨hEtφ₀, hEtψ₀, hCompat, hComap, hNode⟩
  
  haveI : AlgebraicGeometry.IsProper p_Y := hPropY
  have hSingClosed : ∀ y : ↥Y, y ∉ U_sm → IsClosed ({y} : Set ↥Y) := by
    intro y hy
    obtain ⟨W₀, hW₀, hyW₀, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := (⊤ : Y.Opens)) (Set.mem_univ y)
    obtain ⟨U', u₀, e₁, e₂, hEt₁, hEt₂, hu₀_y, hNode_u₀, he_comm⟩ := hNodalOut y hy
    have hu₀_pre : u₀ ∈ (TopologicalSpace.Opens.map e₁.base).obj W₀ := by
      change e₁.base u₀ ∈ W₀
      rwa [hu₀_y]
    obtain ⟨V'₀, hV'₀, hu₀V'₀, hV'₀_sub⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hu₀_pre
    have hV'₀_le : V'₀ ≤ (TopologicalSpace.Opens.map e₁.base).obj W₀ := hV'₀_sub
    obtain ⟨hEtφ₀, hEtψ₀, hCompat, hComap, hNode⟩ :=
      hRoofHyp y W₀ hW₀ hyW₀ U' u₀ e₁ e₂ hEt₁ hEt₂ hu₀_y hNode_u₀ he_comm V'₀ hV'₀ hu₀V'₀ hV'₀_le
    let A : Type u := ↑(Y.presheaf.obj (Opposite.op W₀))
    let B' : Type u := ↑(U'.presheaf.obj (Opposite.op V'₀))
    let c_A : k₀ →+* A := (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
      p_Y.appLE ⊤ W₀ le_top).hom)
    let φ₀ : A →+* B' := (e₁.appLE W₀ V'₀ hV'₀_le).hom
    let ψ₀ : R₀_nodal →+* B' := (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀_nodal)).inv ≫
      e₂.appLE ⊤ V'₀ le_top).hom)
    let p_y : Ideal A := (hW₀.primeIdealOf ⟨y, hyW₀⟩).asIdeal
    let q₀ : Ideal B' := (hV'₀.primeIdealOf ⟨u₀, hu₀V'₀⟩).asIdeal
    haveI : p_y.IsPrime := (hW₀.primeIdealOf ⟨y, hyW₀⟩).isPrime
    haveI : q₀.IsPrime := (hV'₀.primeIdealOf ⟨u₀, hu₀V'₀⟩).isPrime
    have hBij : Function.Bijective ((Ideal.Quotient.mk p_y).comp c_A) :=
      (weil_etale_nodal_roof_branch_domains_and_colon_descent k₀ A B' c_A φ₀ ψ₀
        hEtφ₀ hEtψ₀ hCompat p_y q₀ hComap hNode).1.2
    let e_k : k₀ ≃+* (A ⧸ p_y) := RingEquiv.ofBijective _ hBij
    let ρ_y : A →+* k₀ := e_k.symm.toRingHom.comp (Ideal.Quotient.mk p_y)
    have hρ_sec : ρ_y.comp c_A = RingHom.id k₀ := by
      ext c
      exact e_k.symm_apply_apply c
    let φ_ρ : Y.presheaf.obj (Opposite.op W₀) ⟶ CommRingCat.of k₀ := CommRingCat.ofHom ρ_y
    let σ_y : AlgebraicGeometry.Spec (CommRingCat.of k₀) ⟶ Y :=
      AlgebraicGeometry.Spec.map φ_ρ ≫ hW₀.fromSpec
    have hle_spec : (⊤ : (AlgebraicGeometry.Spec (Y.presheaf.obj (Opposite.op W₀))).Opens) ≤
        (TopologicalSpace.Opens.map hW₀.fromSpec.base).obj W₀ :=
      le_of_eq hW₀.fromSpec_preimage_self.symm
    have h1 : hW₀.fromSpec.appLE W₀ ⊤ hle_spec =
        (AlgebraicGeometry.Scheme.ΓSpecIso (Y.presheaf.obj (Opposite.op W₀))).inv := by
      rw [AlgebraicGeometry.Scheme.Hom.appLE, hW₀.fromSpec_app_self, CategoryTheory.Category.assoc,
        ← CategoryTheory.Functor.map_comp]
      trans ((AlgebraicGeometry.Scheme.ΓSpecIso (Y.presheaf.obj (Opposite.op W₀))).inv ≫ 𝟙 _)
