    let τ_br : A →+* Polynomial κ := Polynomial.eval₂RingHom (Polynomial.C.comp ρ) x_br
    have hτ_C_app : ∀ b : B, τ_br (Polynomial.C b) = Polynomial.C (ρ b) :=
      fun b => Polynomial.eval₂_C (Polynomial.C.comp ρ) x_br
    have hτ_X : τ_br Polynomial.X = x_br :=
      Polynomial.eval₂_X (Polynomial.C.comp ρ) x_br
    have hτ_C : τ_br.comp Polynomial.C = Polynomial.C.comp ρ :=
      RingHom.ext hτ_C_app
    have hτ_u : τ_br u = Polynomial.X := by
      dsimp only [u]
      rw [map_sub, map_mul, hτ_C_app s, hτ_C_app c, hτ_X]
      dsimp only [x_br]
      rw [← mul_assoc, ← map_mul Polynomial.C, ← map_mul ρ, hss_inv, map_one, map_one,
