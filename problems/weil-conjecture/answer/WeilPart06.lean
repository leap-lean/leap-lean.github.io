        Set (PrimeSpectrum ↑(Y₀.presheaf.obj (Opposite.op (U α₁))))).Nonempty := by
      rw [Set.nonempty_iff_ne_empty]
      intro hemp
      have hbot : PrimeSpectrum.basicOpen (e₀ α₁) = ⊥ := by
        ext q; change q ∈ (PrimeSpectrum.basicOpen (e₀ α₁) : Set _) ↔ False
