        (η_A3 (ι_a s₁' * u₀)) (η_A3 (ι_a t_s * u₁) * d₃_inv) hψ₃_rel
    refine comp_away_isLocalization p₀_hom d₃ ψ₃ ?_ ?_
    · apply nodalHom_ext a_Rz
      · intro r
        rw [RingHom.comp_apply, hp₀_C r, hψ₃_C r, RingHom.comp_apply]
      · rw [RingHom.comp_apply, hp₀_X0, map_mul ψ₃, hψ₃_C t_s, hψ₃_X0, RingHom.comp_apply,
          ← map_mul η_A3, ← mul_assoc, ← map_mul ι_a, hts, map_one, one_mul]
      · rw [RingHom.comp_apply, hp₀_X1, map_mul ψ₃, hψ₃_C b₁', hψ₃_X1, RingHom.comp_apply]
        have hb_u1 : ι_a b₁' * (ι_a t_s * u₁) = u₁ * d₃ := by
