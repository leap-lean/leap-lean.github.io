  have hProp_π : AlgebraicGeometry.IsProper π := AlgebraicGeometry.IsProper.of_comp π p_P
  let isoSpecE0 : AlgebraicGeometry.Spec (CommRingCat.of ↑(P.presheaf.obj (Opposite.op (D 0)))) ≅
