      let W_K : U_K.Opens := (TopologicalSpace.Opens.map ι₁.base).obj U₁
      let S_open_set : Set ↥Y := ι_Y.base '' (W_K : Set ↥U_K)
      have hS_open : IsOpen S_open_set :=
        ι_Y.isOpenEmbedding.isOpenMap (W_K : Set ↥U_K) W_K.2
      have hu₀_UY : ι_Y.base u₀ ∈ U_Y := by
        have h1 : ι_Y.base u₀ = q₂.base (ι₁.base u₀) := by rw [← hι₁_q₂]; rfl
        rw [h1]
        exact hU₁_le hz_in_U1
      have hu₀_mem : ι_Y.base u₀ ∈ (⟨S_open_set, hS_open⟩ : Y.Opens) := ⟨u₀, hz_in_U1, rfl⟩
      obtain ⟨s₀, hs₀_le, hu₀_s₀⟩ :=
        hUY.exists_basicOpen_le ⟨ι_Y.base u₀, hu₀_mem⟩ hu₀_UY
      have hs₀_ne : s₀ ≠ 0 := by
        intro h0
        rw [h0, Scheme.basicOpen_zero] at hu₀_s₀
        exact hu₀_s₀
      let D_Y : Y.Opens := Y.basicOpen s₀
      let D_1 : C₁.Opens := C₁.basicOpen (φ s₀)
      have hDY_pre_le : (TopologicalSpace.Opens.map q₂.base).obj D_Y ≤ U₁ := by
        intro z' hz'
        obtain ⟨u, huW, hu_eq⟩ := hs₀_le hz'
        rw [← hLift_gen z' u hu_eq.symm]
        exact huW
      have hD1_eq : D_1 = (TopologicalSpace.Opens.map q₂.base).obj D_Y := by
        change C₁.basicOpen (φ s₀) = _
        rw [AlgebraicGeometry.Scheme.basicOpen_appLE q₂ U₁ U_Y hU₁_le s₀]
        exact inf_eq_right.mpr hDY_pre_le
      have hD1_le : D_1 ≤ (TopologicalSpace.Opens.map q₂.base).obj D_Y := hD1_eq.le
      have hIso_D : CategoryTheory.IsIso (q₂.resLE D_Y D_1 hD1_le) := by
        have hRange_DY : Set.range D_Y.ι.base ⊆ Set.range ι_Y.base := by
          rw [AlgebraicGeometry.Scheme.Opens.range_ι]
          intro y' hy'
          obtain ⟨u, _, hu_eq⟩ := hs₀_le hy'
          exact ⟨u, hu_eq⟩
        let α_K : D_Y.toScheme ⟶ U_K := AlgebraicGeometry.IsOpenImmersion.lift ι_Y D_Y.ι hRange_DY
        have hα_comm : α_K ≫ ι_Y = D_Y.ι := AlgebraicGeometry.IsOpenImmersion.lift_fac ι_Y D_Y.ι hRange_DY
        have hRange_α1 : Set.range (α_K ≫ ι₁).base ⊆ Set.range D_1.ι.base := by
          rw [AlgebraicGeometry.Scheme.Opens.range_ι, hD1_eq]
          rintro _ ⟨w, rfl⟩
          change (α_K ≫ ι₁ ≫ q₂).base w ∈ D_Y
          rw [hι₁_q₂, hα_comm]
          exact w.2
        let inv_D : D_Y.toScheme ⟶ D_1.toScheme :=
          AlgebraicGeometry.IsOpenImmersion.lift D_1.ι (α_K ≫ ι₁) hRange_α1
        have hinv_fac : inv_D ≫ D_1.ι = α_K ≫ ι₁ :=
          AlgebraicGeometry.IsOpenImmersion.lift_fac D_1.ι (α_K ≫ ι₁) hRange_α1
        have hRange_D1 : Set.range D_1.ι.base ⊆ Set.range ι₁.base := by
          rw [AlgebraicGeometry.Scheme.Opens.range_ι, hD1_eq]
          intro z' hz'
          obtain ⟨u, _, hu_eq⟩ := hs₀_le hz'
          exact ⟨u, hLift_gen z' u hu_eq.symm⟩
        let β_K : D_1.toScheme ⟶ U_K := AlgebraicGeometry.IsOpenImmersion.lift ι₁ D_1.ι hRange_D1
        have hβ_fac : β_K ≫ ι₁ = D_1.ι := AlgebraicGeometry.IsOpenImmersion.lift_fac ι₁ D_1.ι hRange_D1
        have hβ_eq : β_K = q₂.resLE D_Y D_1 hD1_le ≫ α_K := by
          apply (cancel_mono ι_Y).mp
          rw [Category.assoc, hα_comm, q₂.resLE_comp_ι hD1_le, ← hι₁_q₂, ← Category.assoc, hβ_fac]
        refine ⟨⟨inv_D, ?_, ?_⟩⟩
        · apply (cancel_mono D_1.ι).mp
          rw [Category.assoc, hinv_fac, ← Category.assoc, ← hβ_eq, hβ_fac, Category.id_comp]
        · apply (cancel_mono D_Y.ι).mp
          rw [Category.assoc, q₂.resLE_comp_ι hD1_le, ← Category.assoc,
            hinv_fac, Category.assoc, hι₁_q₂, hα_comm, Category.id_comp]
      have hAff_DY : AlgebraicGeometry.IsAffineOpen D_Y := hUY.basicOpen s₀
      have hAff_D1 : AlgebraicGeometry.IsAffineOpen D_1 := hU₁.basicOpen (φ s₀)
      have hBij_D : Function.Bijective (q₂.appLE D_Y D_1 hD1_le).hom :=
        (hResIso_iff q₂ hAff_DY hAff_D1 hD1_le).mp hIso_D
      let R_DY := ↑(Y.presheaf.obj (Opposite.op D_Y))
      let R_D1 := ↑(C₁.presheaf.obj (Opposite.op D_1))
      let i_Y : R_Y →+* R_DY := (Y.presheaf.map (CategoryTheory.homOfLE (Y.basicOpen_le s₀)).op).hom
      let i_1 : R₁ →+* R_D1 := (C₁.presheaf.map (CategoryTheory.homOfLE (C₁.basicOpen_le (φ s₀))).op).hom
      let _ : Algebra R_Y R_DY := i_Y.toAlgebra
      let _ : Algebra R₁ R_D1 := i_1.toAlgebra
      have hLoc_DY : IsLocalization.Away s₀ R_DY := hUY.isLocalization_basicOpen s₀
      have hLoc_D1 : IsLocalization.Away (φ s₀) R_D1 := hU₁.isLocalization_basicOpen (φ s₀)
      let ψ_D : R_DY →+* R_D1 := (q₂.appLE D_Y D_1 hD1_le).hom
      have hcomm_D : ψ_D.comp i_Y = i_1.comp φ := by
        have h1 : Y.presheaf.map (CategoryTheory.homOfLE (Y.basicOpen_le s₀)).op ≫
            q₂.appLE D_Y D_1 hD1_le =
            q₂.appLE U_Y U₁ hU₁_le ≫
              C₁.presheaf.map (CategoryTheory.homOfLE (C₁.basicOpen_le (φ s₀))).op := by
          rw [AlgebraicGeometry.Scheme.Hom.map_appLE, AlgebraicGeometry.Scheme.Hom.appLE_map]
        exact congrArg CommRingCat.Hom.hom h1
      have hφs₀_ne : φ s₀ ≠ 0 := by
        intro h0
        have hD1_bot : D_1 = ⊥ := by
          change C₁.basicOpen (φ s₀) = ⊥
          rw [h0, Scheme.basicOpen_zero]
        have hu₀_D1 : ι₁.base u₀ ∈ D_1 := by
          rw [hD1_eq]
          change q₂.base (ι₁.base u₀) ∈ D_Y
          have h1 : q₂.base (ι₁.base u₀) = ι_Y.base u₀ := by rw [← hι₁_q₂]; rfl
          rw [h1]; exact hu₀_s₀
        rw [hD1_bot] at hu₀_D1
        exact hu₀_D1
      have hi_Y_inj : Function.Injective i_Y :=
        IsLocalization.injective R_DY (Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hs₀_ne))
      have hi_1_inj : Function.Injective i_1 :=
        IsLocalization.injective R_D1 (Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hφs₀_ne))
      have hInj : Function.Injective φ := by
        intro x y hxy
        apply hi_Y_inj
        apply hBij_D.1
        change (ψ_D.comp i_Y) x = (ψ_D.comp i_Y) y
        rw [hcomm_D]
        exact congrArg i_1 hxy
      have hBirat : ∀ x : R₁, ∃ (k : ℕ) (a : R_Y), φ (s₀ ^ k) * x = φ a := by
        intro x
        obtain ⟨y_loc, hy_loc⟩ := hBij_D.2 (i_1 x)
        obtain ⟨k, a, hay⟩ := IsLocalization.Away.surj s₀ y_loc
        have hay' : y_loc * i_Y (s₀ ^ k) = i_Y a := by rw [map_pow]; exact hay
        have h1 : ψ_D (y_loc * i_Y (s₀ ^ k)) = ψ_D (i_Y a) := congrArg ψ_D hay'
        rw [map_mul, hy_loc] at h1
        have h2 : ψ_D (i_Y (s₀ ^ k)) = i_1 (φ (s₀ ^ k)) := congrFun (congrArg DFunLike.coe hcomm_D) (s₀ ^ k)
        have h3 : ψ_D (i_Y a) = i_1 (φ a) := congrFun (congrArg DFunLike.coe hcomm_D) a
        rw [h2, h3, ← map_mul] at h1
        exact ⟨k, a, mul_comm x _ ▸ hi_1_inj h1⟩
      let _ : Algebra R_Y R₁ := φ.toAlgebra
      have hAlgFT : Algebra.FiniteType R_Y R₁ := hFT
      have hQF : Algebra.QuasiFiniteAt R_Y p_z := by
        refine ⟨fun Q hQ_prime => ?_⟩
        by_cases hQ_le : Q ≤ Ideal.comap φ p_z
        · have hFinQ : (Q.primesOver R₁).Finite := hFinOver Q hQ_le
          have hFinSub : Finite ↥(Q.primesOver R₁) := hFinQ.to_subtype
          have hFinSpec : Finite (PrimeSpectrum (Q.Fiber R₁)) :=
            Finite.of_equiv ↥(Q.primesOver R₁) (PrimeSpectrum.primesOverOrderIsoFiber R_Y R₁ Q).toEquiv
          have hQFFib : Algebra.QuasiFinite Q.ResidueField (Q.Fiber R₁) := by
            rw [Algebra.QuasiFinite.iff_finite_comap_preimage_singleton]
            intro x
            exact Set.toFinite _
          let M : Submonoid (Q.Fiber R₁) :=
            Submonoid.map Algebra.TensorProduct.includeRight.toRingHom.toMonoidHom p_z.primeCompl
          have hQFLoc : Algebra.QuasiFinite Q.ResidueField (Localization M) :=
            Algebra.QuasiFinite.instLocalization M
          have hModFinLoc : Module.Finite Q.ResidueField (Localization M) :=
            @Module.Finite.of_quasiFinite Q.ResidueField (Localization M) _ _ _ _ hQFLoc
          let f_base : Q.Fiber R₁ →ₐ[Q.ResidueField] Q.Fiber (Localization.AtPrime p_z) :=
            Algebra.TensorProduct.map (AlgHom.id Q.ResidueField Q.ResidueField)
              (IsScalarTower.toAlgHom R_Y R₁ (Localization.AtPrime p_z))
          have hM_unit : ∀ y : M, IsUnit (f_base.toRingHom y) := by
            rintro ⟨_, ⟨s, hs, rfl⟩⟩
            change IsUnit ((1 : Q.ResidueField) ⊗ₜ[R_Y] (algebraMap R₁ (Localization.AtPrime p_z) s))
            have hu : IsUnit (algebraMap R₁ (Localization.AtPrime p_z) s) :=
              IsLocalization.map_units (Localization.AtPrime p_z) (⟨s, hs⟩ : p_z.primeCompl)
            obtain ⟨u, hu_eq⟩ := hu
            rw [← hu_eq]
            refine ⟨⟨1 ⊗ₜ[R_Y] (u : Localization.AtPrime p_z),
              1 ⊗ₜ[R_Y] (↑u⁻¹ : Localization.AtPrime p_z), ?_, ?_⟩, rfl⟩
            · rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, Units.mul_inv]; rfl
            · rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, Units.inv_mul]; rfl
          let g_ring : Localization M →+* Q.Fiber (Localization.AtPrime p_z) :=
            IsLocalization.lift (S := Localization M) hM_unit
          let g_lin : Localization M →ₗ[Q.ResidueField] Q.Fiber (Localization.AtPrime p_z) :=
            { toFun := g_ring
              map_add' := g_ring.map_add
              map_smul' := fun c w => by
                simp only [RingHom.id_apply]
                rw [Algebra.smul_def, g_ring.map_mul]
                have hcomm : g_ring (algebraMap Q.ResidueField (Localization M) c) =
                    algebraMap Q.ResidueField (Q.Fiber (Localization.AtPrime p_z)) c := by
                  change g_ring (algebraMap (Q.Fiber R₁) (Localization M)
                    (algebraMap Q.ResidueField (Q.Fiber R₁) c)) = _
                  rw [IsLocalization.lift_eq (S := Localization M) hM_unit]
                  exact f_base.commutes c
                rw [hcomm, ← Algebra.smul_def] }
          have hSurj_g : Function.Surjective g_lin := by
            intro z_t
            refine TensorProduct.induction_on (motive := fun z_t => ∃ a, g_lin a = z_t) z_t ?_ ?_ ?_
            · exact ⟨0, map_zero g_lin⟩
            · intro c loc_x
              obtain ⟨⟨r_el, s_el⟩, hrs⟩ := IsLocalization.surj p_z.primeCompl loc_x
              have hsM : Algebra.TensorProduct.includeRight (R := R_Y) (A := Q.ResidueField) s_el.1 ∈ M :=
                ⟨s_el.1, s_el.2, rfl⟩
              refine ⟨IsLocalization.mk' (Localization M) (c ⊗ₜ[R_Y] r_el) ⟨_, hsM⟩, ?_⟩
              change g_ring (IsLocalization.mk' (Localization M) (c ⊗ₜ[R_Y] r_el) ⟨_, hsM⟩) = c ⊗ₜ[R_Y] loc_x
              rw [IsLocalization.lift_mk'_spec (S := Localization M)]
              change f_base (c ⊗ₜ[R_Y] r_el) = f_base (1 ⊗ₜ[R_Y] s_el.1) * (c ⊗ₜ[R_Y] loc_x)
              simp only [f_base, Algebra.TensorProduct.map_tmul, AlgHom.id_apply,
                IsScalarTower.coe_toAlgHom', Algebra.TensorProduct.tmul_mul_tmul, one_mul]
              rw [mul_comm, ← hrs]
            · intro x y ⟨x₀, hx₀⟩ ⟨y₀, hy₀⟩
              exact ⟨x₀ + y₀, by rw [map_add, hx₀, hy₀]⟩
          exact Module.Finite.of_surjective g_lin hSurj_g
        · obtain ⟨a, haQ, haNotP⟩ := Set.not_subset.mp hQ_le
          have ha_not_pz : φ a ∉ p_z := haNotP
