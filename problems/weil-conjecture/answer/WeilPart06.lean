      have hιDL_γ : ι_DL.comp γ_Du = γ_bar := by
        ext v
        change (IsLocalRing.residue ↥W)
          ((φ_0.hom.comp (AlgebraicGeometry.Spec.preimage (hU0.fromSpec ≫ g_Z)).hom) v) =
