          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl fun i hi => ?_
          have hsplit : S_prod = s_i i * ∏ j ∈ (Finset.range (N + 1)).erase i, s_i j :=
            (Finset.mul_prod_erase (Finset.range (N + 1)) s_i hi).symm
          rw [hsplit]
          simp only [map_mul, ← has_i i]
          ring
        rw [hsum_eq]
        have hM_sum : (∑ i ∈ Finset.range (N + 1), (M.coeff i).1 * (res_W y) ^ i) = 0 := by
          rw [Polynomial.eval₂_eq_sum_range] at hM_ev
          exact hM_ev
        rw [hM_sum, mul_zero]
      · intro hNotInt P ⟨i₀, hi₀⟩ hP_mem
        apply hNotInt
        let P_k0 : Polynomial ↥k₀ := P.map ρ_k0
        have hPk0_ne : P_k0 ≠ 0 := by
          intro h0
          have hc := congrArg (fun q => (q.coeff i₀).1) h0
          simp only [P_k0, Polynomial.coeff_map, Polynomial.coeff_zero, ZeroMemClass.coe_zero] at hc
          change res_W (θ_V (P.coeff i₀)) = 0 at hc
          rw [IsLocalRing.residue_eq_zero_iff, ← Ideal.mem_comap, hComap] at hc
          exact hi₀ hc
        apply IsAlgebraic.isIntegral
        refine ⟨P_k0, hPk0_ne, ?_⟩
        rw [Polynomial.aeval_def, Polynomial.eval₂_map]
        have hcomp : (algebraMap ↥k₀ (IsLocalRing.ResidueField ↥W)).comp ρ_k0 = res_W.comp θ_V := by
          ext c; rfl
        rw [hcomp, ← Polynomial.hom_eval₂]
        exact (IsLocalRing.residue_eq_zero_iff _).mpr hP_mem

    have ht_div_notInt : ¬ IsIntegral ↥k₀ (res_W t_div) :=
      (hResTrans_iff t_div).mp ht_div

    have hCoreAbhyankar : ∀ (ξ : ↥W),
        (∀ P : Polynomial ↥V, P ≠ 0 → Polynomial.eval₂ α_V (W.subtype ξ) P ≠ 0) →
        (∃ Q : Polynomial (Polynomial ↥V),
          Q ≠ 0 ∧
          Polynomial.eval₂ (Polynomial.eval₂RingHom α_V (W.subtype ξ)) (W.subtype t_div) Q = 0) →
        ∃ (ι_K : K →+* F),
          (∀ c : ↥V, ι_K (V.subtype c) = W.subtype (θ_V c)) ∧
          (∀ (x : K) (hxW : ι_K x ∈ W),
            (⟨ι_K x, hxW⟩ : ↥W) ∈ IsLocalRing.maximalIdeal ↥W → x ≠ 0 →
            ∃ π₁ : ↥V, π₁ ∈ P_z ∧ π₁ ≠ 0 ∧ V.subtype π₁ = x ∧ θ_V π₁ = ⟨ι_K x, hxW⟩) ∧
          (∀ (x : K) (hxW : ι_K x ∈ W),
            ∃ c₁ s₁ : ↥V, s₁ ∉ P_z ∧ ⟨ι_K x, hxW⟩ * θ_V s₁ = θ_V c₁ ∧
              res_W ⟨ι_K x, hxW⟩ ∈ k₀) ∧
          (∀ P : Polynomial K, P ≠ 0 →
            Polynomial.eval₂ ι_K (W.subtype ξ) P ≠ 0) ∧
          (∃ g_W : ↥W,
            (∃ A_g B_g : Polynomial K, B_g ≠ 0 ∧
              W.subtype g_W * Polynomial.eval₂ ι_K (W.subtype ξ) B_g =
                Polynomial.eval₂ ι_K (W.subtype ξ) A_g) ∧
            ¬ IsIntegral ↥k₀ (res_W g_W)) ∧
          (∀ A B : Polynomial K, A ≠ 0 → B ≠ 0 →
            ∃ (b : K) (u : ↥W), b ≠ 0 ∧ IsUnit u ∧
              Polynomial.eval₂ ι_K (W.subtype ξ) A *
                (Polynomial.eval₂ ι_K (W.subtype ξ) B)⁻¹ = ι_K b * W.subtype u) := by
      intro ξ hTrans_ξ ⟨Q, hQ_ne, hQ_ev⟩
      have hInj_αV : Function.Injective α_V := by
        rw [RingHom.injective_iff_ker_eq_bot, RingHom.ker_eq_comap_bot]
        ext c
        simp only [Ideal.mem_comap, Ideal.mem_bot]
        refine ⟨fun h0 => Classical.byContradiction fun hc => ?_, fun h0 => by rw [h0, map_zero]⟩
        have hC_ne : (Polynomial.C c : Polynomial ↥V) ≠ 0 := by
          intro hC0
          exact hc (by simpa using congrArg (fun p => p.coeff 0) hC0)
        apply hTrans_ξ (Polynomial.C c) hC_ne
        simpa using h0
      have hUnit_nzd : ∀ y : nonZeroDivisors ↥V, IsUnit (α_V y.1) := by
        intro y
        refine IsUnit.mk0 (α_V y.1) ?_
        intro h0
        exact mem_nonZeroDivisors_iff_ne_zero.mp y.2 (hInj_αV (h0.trans (map_zero α_V).symm))
      let ι_K : K →+* F := IsLocalization.lift (M := nonZeroDivisors ↥V) (S := K) hUnit_nzd
      have hιK_ne : ∀ {x : K}, x ≠ 0 → ι_K x ≠ 0 :=
        fun {x} hx h0 => hx (RingHom.injective ι_K (h0.trans (map_zero ι_K).symm))
      have hιK_V : ∀ c : ↥V, ι_K (V.subtype c) = W.subtype (θ_V c) :=
        IsLocalization.lift_eq (M := nonZeroDivisors ↥V) hUnit_nzd
      have hK_mem_mW : ∀ (x : K) (hxW : ι_K x ∈ W),
          (⟨ι_K x, hxW⟩ : ↥W) ∈ IsLocalRing.maximalIdeal ↥W → x ≠ 0 →
          ∃ π₁ : ↥V, π₁ ∈ P_z ∧ π₁ ≠ 0 ∧ V.subtype π₁ = x ∧ θ_V π₁ = ⟨ι_K x, hxW⟩ := by
        intro x hxW hxm hx_ne
        rcases V.mem_or_inv_mem x with hxV | hxinv
        · let π₁ : ↥V := ⟨x, hxV⟩
          have hπ_eq : θ_V π₁ = ⟨ι_K x, hxW⟩ := by
            apply Subtype.ext
            change W.subtype (θ_V π₁) = ι_K x
            rw [← hιK_V π₁]
            rfl
          have hπ_Pz : π₁ ∈ P_z := by
            rw [← hComap, Ideal.mem_comap, hπ_eq]
            exact hxm
          have hπ_ne : π₁ ≠ 0 := fun h0 => hx_ne (congrArg V.subtype h0)
          exact ⟨π₁, hπ_Pz, hπ_ne, rfl, hπ_eq⟩
        · exfalso
          let v : ↥V := ⟨x⁻¹, hxinv⟩
          have h1_eq : (⟨ι_K x, hxW⟩ : ↥W) * θ_V v = 1 := by
            apply Subtype.ext
            change ι_K x * W.subtype (θ_V v) = 1
            rw [← hιK_V v]
            change ι_K x * ι_K x⁻¹ = 1
            rw [← map_mul, mul_inv_cancel₀ hx_ne, map_one]
          have h1_mem : (1 : ↥W) ∈ IsLocalRing.maximalIdeal ↥W := by
            rw [← h1_eq]
            exact Ideal.mul_mem_right _ _ hxm
          exact (IsLocalRing.maximalIdeal.isMaximal ↥W).ne_top
            (Ideal.eq_top_of_isUnit_mem _ h1_mem isUnit_one)
      have hK_mem_W : ∀ (x : K) (hxW : ι_K x ∈ W),
          ∃ c₁ s₁ : ↥V, s₁ ∉ P_z ∧ ⟨ι_K x, hxW⟩ * θ_V s₁ = θ_V c₁ ∧
            res_W ⟨ι_K x, hxW⟩ ∈ k₀ := by
        intro x hxW
        by_cases hx0 : x = 0
        · subst hx0
          have hw0 : (⟨ι_K 0, hxW⟩ : ↥W) = 0 := Subtype.ext (map_zero ι_K)
          refine ⟨0, 1, hPz_prime.one_notMem, ?_, ?_⟩
          · rw [hw0, map_one, map_zero, zero_mul]
          · rw [hw0, map_zero]; exact k₀.zero_mem
        · rcases V.mem_or_inv_mem x with hxV | hxinv
          · let c₁ : ↥V := ⟨x, hxV⟩
            have hc_eq : (⟨ι_K x, hxW⟩ : ↥W) = θ_V c₁ := by
              apply Subtype.ext
              change ι_K (V.subtype c₁) = W.subtype (θ_V c₁)
              exact hιK_V c₁
            refine ⟨c₁, 1, hPz_prime.one_notMem, by rw [hc_eq, map_one, mul_one], ?_⟩
            exact ⟨c₁, 1, hPz_prime.one_notMem, by rw [hc_eq, map_one, map_one, mul_one]⟩
          · let s₁ : ↥V := ⟨x⁻¹, hxinv⟩
            have hmul1 : (⟨ι_K x, hxW⟩ : ↥W) * θ_V s₁ = θ_V 1 := by
              apply Subtype.ext
              change ι_K x * W.subtype (θ_V s₁) = W.subtype (θ_V 1)
              rw [← hιK_V s₁, map_one, map_one]
              change ι_K x * ι_K x⁻¹ = 1
              rw [← map_mul, mul_inv_cancel₀ hx0, map_one]
            have hs₁_not : s₁ ∉ P_z := by
              intro hs_in
              have hθs : θ_V s₁ ∈ IsLocalRing.maximalIdeal ↥W := by
                rwa [← hComap] at hs_in
              have h1_mem : (1 : ↥W) ∈ IsLocalRing.maximalIdeal ↥W := by
                have h := Ideal.mul_mem_left (IsLocalRing.maximalIdeal ↥W) ⟨ι_K x, hxW⟩ hθs
                rwa [hmul1, map_one] at h
              exact (IsLocalRing.maximalIdeal.isMaximal ↥W).ne_top
                (Ideal.eq_top_of_isUnit_mem _ h1_mem isUnit_one)
            refine ⟨1, s₁, hs₁_not, hmul1, ⟨1, s₁, hs₁_not, ?_⟩⟩
            rw [← map_mul, hmul1]
      let φ_ξ : Polynomial K →+* F := Polynomial.eval₂RingHom ι_K (W.subtype ξ)
      have hTrans_K : ∀ P : Polynomial K, P ≠ 0 → φ_ξ P ≠ 0 := by
        intro R hR_ne hR_zero
        have hden_K : ∀ i : ℕ, ∃ n_i d_i : ↥V, d_i ≠ 0 ∧ R.coeff i * V.subtype d_i = V.subtype n_i := by
          intro i
          by_cases hci : R.coeff i = 0
          · exact ⟨0, 1, one_ne_zero, by rw [hci, zero_mul, map_zero]⟩
          · rcases V.mem_or_inv_mem (R.coeff i) with hin | hinv
            · exact ⟨⟨R.coeff i, hin⟩, 1, one_ne_zero, by simp⟩
            · refine ⟨1, ⟨(R.coeff i)⁻¹, hinv⟩, ?_, ?_⟩
              · intro h0
                exact inv_ne_zero hci (congrArg V.subtype h0)
              · change R.coeff i * (R.coeff i)⁻¹ = 1
                exact mul_inv_cancel₀ hci
        choose n_i d_i hd_i hnd_i using hden_K
        let N := R.natDegree
        let D_prod : ↥V := ∏ j ∈ Finset.range (N + 1), d_i j
        have hD_ne : D_prod ≠ 0 := Finset.prod_ne_zero_iff.mpr (fun j _ => hd_i j)
        let P_V : Polynomial ↥V :=
          ∑ i ∈ Finset.range (N + 1),
            Polynomial.C (n_i i * ∏ j ∈ (Finset.range (N + 1)).erase i, d_i j) * Polynomial.X ^ i
        have hPV_ne : P_V ≠ 0 := by
          intro h0
          have hN_mem : N ∈ Finset.range (N + 1) := Finset.mem_range.mpr (Nat.lt_succ_self N)
          have hcN : P_V.coeff N = n_i N * ∏ j ∈ (Finset.range (N + 1)).erase N, d_i j := by
            simp only [P_V, Polynomial.finsetSum_coeff, Polynomial.coeff_C_mul, Polynomial.coeff_X_pow]
            rw [Finset.sum_eq_single N]
            · simp
            · intro b _ hb; simp [hb.symm]
            · intro habs; exact False.elim (habs hN_mem)
          rw [h0, Polynomial.coeff_zero] at hcN
          have hRN_ne : R.coeff N ≠ 0 := Polynomial.leadingCoeff_ne_zero.mpr hR_ne
          have hnN_ne : n_i N ≠ 0 := by
            intro hn0
            have h := hnd_i N
            rw [hn0, map_zero] at h
            exact mul_ne_zero hRN_ne (fun hd0 => hd_i N (Subtype.ext hd0)) h
          have hprod_ne : (∏ j ∈ (Finset.range (N + 1)).erase N, d_i j) ≠ 0 :=
            Finset.prod_ne_zero_iff.mpr (fun j _ => hd_i j)
          exact mul_ne_zero hnN_ne hprod_ne hcN.symm
        apply hTrans_ξ P_V hPV_ne
        simp only [P_V, Polynomial.eval₂_finsetSum, Polynomial.eval₂_mul, Polynomial.eval₂_C,
          Polynomial.eval₂_X_pow]
        have hsum_eq :
            (∑ i ∈ Finset.range (N + 1),
              α_V (n_i i * ∏ j ∈ (Finset.range (N + 1)).erase i, d_i j) * (W.subtype ξ) ^ i) =
            α_V D_prod * φ_ξ R := by
          have hR_sum : φ_ξ R = ∑ i ∈ Finset.range (N + 1), ι_K (R.coeff i) * (W.subtype ξ) ^ i := by
            simp only [φ_ξ, Polynomial.coe_eval₂RingHom]
            exact Polynomial.eval₂_eq_sum_range ι_K (W.subtype ξ)
          rw [hR_sum, Finset.mul_sum]
          refine Finset.sum_congr rfl fun i hi => ?_
          have hsplit : D_prod = d_i i * ∏ j ∈ (Finset.range (N + 1)).erase i, d_i j :=
            (Finset.mul_prod_erase (Finset.range (N + 1)) d_i hi).symm
          have hα_eq : ∀ v : ↥V, α_V v = ι_K (V.subtype v) := fun v => (hιK_V v).symm
          rw [hsplit, map_mul, map_mul, hα_eq (n_i i), hα_eq (d_i i), ← hnd_i i, map_mul]
          ring
        rw [hsum_eq, hR_zero, mul_zero]
      let K₀ : Subfield F :=
        { carrier := {z | ∃ A B : Polynomial K, B ≠ 0 ∧ z * φ_ξ B = φ_ξ A}
          mul_mem' := by
            rintro z₁ z₂ ⟨A₁, B₁, hB₁, h₁⟩ ⟨A₂, B₂, hB₂, h₂⟩
            refine ⟨A₁ * A₂, B₁ * B₂, mul_ne_zero hB₁ hB₂, ?_⟩
            rw [map_mul, map_mul]
            calc (z₁ * z₂) * (φ_ξ B₁ * φ_ξ B₂) = (z₁ * φ_ξ B₁) * (z₂ * φ_ξ B₂) := by ring
              _ = φ_ξ A₁ * φ_ξ A₂ := by rw [h₁, h₂]
          one_mem' := ⟨1, 1, one_ne_zero, by simp⟩
          add_mem' := by
            rintro z₁ z₂ ⟨A₁, B₁, hB₁, h₁⟩ ⟨A₂, B₂, hB₂, h₂⟩
            refine ⟨A₁ * B₂ + A₂ * B₁, B₁ * B₂, mul_ne_zero hB₁ hB₂, ?_⟩
            rw [map_add, map_mul, map_mul, map_mul]
            calc (z₁ + z₂) * (φ_ξ B₁ * φ_ξ B₂)
                = (z₁ * φ_ξ B₁) * φ_ξ B₂ + (z₂ * φ_ξ B₂) * φ_ξ B₁ := by ring
              _ = φ_ξ A₁ * φ_ξ B₂ + φ_ξ A₂ * φ_ξ B₁ := by rw [h₁, h₂]
          zero_mem' := ⟨0, 1, one_ne_zero, by simp⟩
          neg_mem' := by
            rintro z₁ ⟨A₁, B₁, hB₁, h₁⟩
            exact ⟨-A₁, B₁, hB₁, by rw [map_neg, neg_mul, h₁]⟩
          inv_mem' := by
            rintro z ⟨A₁, B₁, hB₁, h₁⟩
            by_cases hz : z = 0
            · rw [hz, inv_zero]; exact ⟨0, 1, one_ne_zero, by simp⟩
            · have hφB₁ : φ_ξ B₁ ≠ 0 := hTrans_K B₁ hB₁
              have hφA₁ : φ_ξ A₁ ≠ 0 := by rw [← h₁]; exact mul_ne_zero hz hφB₁
              have hA₁ : A₁ ≠ 0 := fun h0 => hφA₁ (by rw [h0, map_zero])
              refine ⟨B₁, A₁, hA₁, ?_⟩
              apply mul_left_cancel₀ hz
              calc z * (z⁻¹ * φ_ξ A₁) = (z * z⁻¹) * (z * φ_ξ B₁) := by rw [h₁]; ring
                _ = z * φ_ξ B₁ := by rw [mul_inv_cancel₀ hz, one_mul] }
      let k_W0 : Subfield (IsLocalRing.ResidueField ↥W) :=
        { carrier := {z | ∃ w : ↥W, W.subtype w ∈ K₀ ∧ res_W w = z}
          mul_mem' := by
            rintro _ _ ⟨w₁, hw₁, rfl⟩ ⟨w₂, hw₂, rfl⟩
            exact ⟨w₁ * w₂, K₀.mul_mem hw₁ hw₂, map_mul res_W w₁ w₂⟩
          one_mem' := ⟨1, K₀.one_mem, map_one res_W⟩
          add_mem' := by
            rintro _ _ ⟨w₁, hw₁, rfl⟩ ⟨w₂, hw₂, rfl⟩
            exact ⟨w₁ + w₂, K₀.add_mem hw₁ hw₂, map_add res_W w₁ w₂⟩
          zero_mem' := ⟨0, K₀.zero_mem, map_zero res_W⟩
          neg_mem' := by
            rintro _ ⟨w₁, hw₁, rfl⟩
            exact ⟨-w₁, K₀.neg_mem hw₁, map_neg res_W w₁⟩
          inv_mem' := by
            rintro _ ⟨w₁, hw₁, rfl⟩
            by_cases hr0 : res_W w₁ = 0
            · rw [hr0, inv_zero]; exact ⟨0, K₀.zero_mem, map_zero res_W⟩
            · have hw₁_not : w₁ ∉ IsLocalRing.maximalIdeal ↥W := by
                rwa [← IsLocalRing.residue_eq_zero_iff]
              obtain ⟨u, hu⟩ := IsLocalRing.notMem_maximalIdeal.mp hw₁_not
              refine ⟨↑u⁻¹, ?_, ?_⟩
              · rw [← hu] at hw₁
                have hu_ne_F : W.subtype (u : ↥W) ≠ 0 := by
                  intro h0
                  have hu0 : (u : ↥W) = 0 := Subtype.ext h0
                  exact hr0 (by rw [← hu, hu0, map_zero])
                have hinv_eq : W.subtype (↑u⁻¹ : ↥W) = (W.subtype (u : ↥W))⁻¹ := by
                  apply mul_right_cancel₀ hu_ne_F
                  change W.subtype (↑u⁻¹ : ↥W) * W.subtype (u : ↥W) =
                    (W.subtype (u : ↥W))⁻¹ * W.subtype (u : ↥W)
                  rw [← map_mul, Units.inv_mul, map_one, inv_mul_cancel₀ hu_ne_F]
                rw [hinv_eq]
                exact K₀.inv_mem hw₁
              · apply mul_right_cancel₀ hr0
                have hr_u : res_W (u : ↥W) ≠ 0 := by rwa [hu]
                rw [← hu, ← map_mul, Units.inv_mul, map_one, inv_mul_cancel₀ hr_u] }
      have hk0_le_kW0 : k₀ ≤ k_W0 := by
        rintro z ⟨a, s, hs, hzs⟩
        have hθs_not : θ_V s ∉ IsLocalRing.maximalIdeal ↥W := by
          rwa [← Ideal.mem_comap, hComap]
        obtain ⟨u_s, hus⟩ := IsLocalRing.notMem_maximalIdeal.mp hθs_not
        let w : ↥W := θ_V a * ↑u_s⁻¹
        refine ⟨w, ?_, ?_⟩
        · have hw_eq : W.subtype w =
              φ_ξ (Polynomial.C (V.subtype a)) * (φ_ξ (Polynomial.C (V.subtype s)))⁻¹ := by
            simp only [w, φ_ξ, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C, hιK_V, map_mul]
            congr 1
            have h_us_ne : W.subtype (θ_V s) ≠ 0 := by
              intro h0
              have hs0 : θ_V s = 0 := Subtype.ext h0
              exact hθs_not (hs0 ▸ Ideal.zero_mem _)
            apply mul_right_cancel₀ h_us_ne
            rw [inv_mul_cancel₀ h_us_ne, ← hus, ← map_mul, Units.inv_mul, map_one]
          rw [hw_eq]
          refine K₀.mul_mem ⟨Polynomial.C (V.subtype a), 1, one_ne_zero, by simp⟩
            (K₀.inv_mem ⟨Polynomial.C (V.subtype s), 1, one_ne_zero, by simp⟩)
        · have hrs_ne : res_W (θ_V s) ≠ 0 := by
            rwa [Ne, IsLocalRing.residue_eq_zero_iff]
          apply mul_right_cancel₀ hrs_ne
          calc res_W w * res_W (θ_V s)
              = res_W (θ_V a * (↑u_s⁻¹ * ↑u_s)) := by rw [← hus, ← map_mul, mul_assoc]
            _ = res_W (θ_V a) := by rw [Units.inv_mul, mul_one]
            _ = z * res_W (θ_V s) := hzs.symm
      have hex_gW : ∃ g_W : ↥W, W.subtype g_W ∈ K₀ ∧ ¬ IsIntegral ↥k₀ (res_W g_W) := by
        by_contra hAllAlg
        push Not at hAllAlg
        let c_Q : ℕ → F := fun j => Polynomial.eval₂ α_V (W.subtype ξ) (Q.coeff j)
        have hcQ_K0 : ∀ j : ℕ, c_Q j ∈ K₀ := by
          intro j
          refine ⟨(Q.coeff j).map V.subtype, 1, one_ne_zero, ?_⟩
          rw [map_one, mul_one]
          simp only [c_Q, φ_ξ, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_map]
          have hcomp : ι_K.comp V.subtype = α_V := by ext v; exact hιK_V v
          rw [hcomp]
        have hcQ_ne : ∀ j ∈ Q.support, c_Q j ≠ 0 := by
          intro j hj
          exact hTrans_ξ (Q.coeff j) (Polynomial.mem_support_iff.mp hj)
        obtain ⟨j₀, hj₀_supp, hj₀_max⟩ :=
          Finset.exists_max_image Q.support (fun j => W.valuation (c_Q j))
            (Polynomial.support_nonempty.mpr hQ_ne)
        have hcj0_ne : c_Q j₀ ≠ 0 := hcQ_ne j₀ hj₀_supp
        have hvj0_pos : 0 < W.valuation (c_Q j₀) :=
          zero_lt_iff.mpr ((Valuation.ne_zero_iff W.valuation).mpr hcj0_ne)
        have h_mem_W : ∀ j ∈ Q.support, c_Q j * (c_Q j₀)⁻¹ ∈ W := by
          intro j hj
          rw [← ValuationSubring.valuation_le_one_iff, Valuation.map_mul, map_inv₀]
