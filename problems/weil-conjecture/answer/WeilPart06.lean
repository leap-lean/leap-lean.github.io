      dsimp only at heq
      by_contra hne
      have h1 : (σ_comp j₁).base (⊥ : PrimeSpectrum k₀) ∈ Y.basicOpen (e_idem j₁) := by
        rw [hσBasic j₁, hev_diag j₁]
        exact one_ne_zero
      have h2 : (σ_comp j₂).base (⊥ : PrimeSpectrum k₀) ∈ Y.basicOpen (e_idem j₁) := heq ▸ h1
      rw [hσBasic j₂, hev_off j₁ j₂ (Ne.symm hne)] at h2
      exact h2 rfl
    have hFibEq : (V_0 : Set ↥Y) \ (Y.basicOpen τ_0 : Set ↥Y) =
        (⋃ j : Fin (m_pts + 1), Set.range (σ_comp j).base) := by
      have hRangeσ : ∀ j : Fin (m_pts + 1),
          Set.range (σ_comp j).base = {(σ_comp j).base (⊥ : PrimeSpectrum k₀)} := by
        intro j
        ext y
        simp only [Set.mem_range, Set.mem_singleton_iff]
        refine ⟨?_, fun hy => ⟨(⊥ : PrimeSpectrum k₀), hy.symm⟩⟩
        rintro ⟨q, rfl⟩
        rw [Subsingleton.elim q (⊥ : PrimeSpectrum k₀)]
      ext y
      simp only [Set.mem_diff, Set.mem_iUnion, hRangeσ, Set.mem_singleton_iff]
      change (y ∈ (V_0 : Set ↥Y) ∧ y ∉ Y.basicOpen τ_0) ↔ _
      refine ⟨?_, ?_⟩
      · rintro ⟨hyV, hynot⟩
        rw [← hV0.range_fromSpec] at hyV
        obtain ⟨p, rfl⟩ := hyV
        rw [hFromBasic τ_0 p, not_not] at hynot
        obtain ⟨j, rfl⟩ := (hZeroLocus p).mp hynot
        exact ⟨j, (hp_j j).symm⟩
      · rintro ⟨j, rfl⟩
        refine ⟨hInV0 j, ?_⟩
        rw [hp_j j, hFromBasic τ_0, not_not]
        exact (hZeroLocus _).mpr ⟨j, rfl⟩
    refine ⟨σ_comp, hSec, hInj, hInV0, hFibEq, ?_⟩
    intro w hw j
    obtain ⟨hg_diag, hg_off, hLoc⟩ := hAway w hw j
    let g_j : B_0 := e_idem j * w
    let W_j : Y.Opens := Y.basicOpen g_j
    have hWj_le : W_j ≤ V_0 := Y.basicOpen_le g_j
    have hAffWj : AlgebraicGeometry.IsAffineOpen W_j := hV0.basicOpen g_j
    have hMemWj : (σ_comp j).base (⊥ : PrimeSpectrum k₀) ∈ W_j := by
      rw [hσBasic j g_j, hg_diag]
      exact one_ne_zero
    have hDisjWj : ∀ j' : Fin (m_pts + 1), j' ≠ j → (σ_comp j').base (⊥ : PrimeSpectrum k₀) ∉ W_j := by
      intro j' hj'
      rw [hσBasic j' g_j, hg_off j' hj']
      exact not_not.mpr rfl
    have hσ_le : (⊤ : S_k.Opens) ≤ (TopologicalSpace.Opens.map (σ_comp j).base).obj W_j := by
      intro q _
      change (σ_comp j).base q ∈ W_j
      rw [Subsingleton.elim q (⊥ : PrimeSpectrum k₀)]
      exact hMemWj
    let R_j : Type u := ↑(Y.presheaf.obj (Opposite.op W_j))
    haveI : IsLocalization.Away g_j R_j := hV0.isLocalization_basicOpen g_j
    let φ_mor : Y.presheaf.obj (Opposite.op W_j) ⟶ CommRingCat.of k₀ :=
      (σ_comp j).appLE W_j ⊤ hσ_le ≫
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).hom
    let φ_j : R_j →+* k₀ := φ_mor.hom
    have hφ_ext : φ_j.comp (algebraMap B_0 R_j) = ev j := by
      have h_from_pre : (⊤ : (AlgebraicGeometry.Spec R_0).Opens) ≤
          (TopologicalSpace.Opens.map hV0.fromSpec.base).obj V_0 :=
        le_of_eq hV0.fromSpec_preimage_self.symm
      have hσ_V0 : (⊤ : S_k.Opens) ≤ (TopologicalSpace.Opens.map (σ_comp j).base).obj V_0 :=
        hσ_le.trans ((TopologicalSpace.Opens.map (σ_comp j).base).monotone hWj_le)
      have h_nat : Y.presheaf.map (CategoryTheory.homOfLE hWj_le).op ≫
          (σ_comp j).appLE W_j ⊤ hσ_le = (σ_comp j).appLE V_0 ⊤ hσ_V0 := by
        dsimp [AlgebraicGeometry.Scheme.Hom.appLE]
        rw [← CategoryTheory.Category.assoc, (σ_comp j).naturality (CategoryTheory.homOfLE hWj_le).op,
          CategoryTheory.Category.assoc, ← CategoryTheory.Functor.map_comp]
        have h_op_eq :
            ((TopologicalSpace.Opens.map (σ_comp j).base).map
              (CategoryTheory.homOfLE hWj_le).op.unop).op ≫
              (CategoryTheory.homOfLE hσ_le).op =
            (CategoryTheory.homOfLE hσ_V0).op := Subsingleton.elim _ _
        rw [h_op_eq]
      have h_comp_app : (σ_comp j).appLE V_0 ⊤ hσ_V0 =
          hV0.fromSpec.appLE V_0 ⊤ h_from_pre ≫
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ev j))).appLE ⊤ ⊤ le_top :=
        (AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ev j))) hV0.fromSpec V_0 ⊤ ⊤
          h_from_pre le_top).symm
      have h_from_app : hV0.fromSpec.appLE V_0 ⊤ h_from_pre =
          (AlgebraicGeometry.Scheme.ΓSpecIso R_0).inv := by
        dsimp [AlgebraicGeometry.Scheme.Hom.appLE]
        rw [hV0.fromSpec_app_self, CategoryTheory.Category.assoc, ← CategoryTheory.Functor.map_comp]
        have h_id : (CategoryTheory.eqToHom hV0.fromSpec_preimage_self).op ≫
            (CategoryTheory.homOfLE h_from_pre).op =
            𝟙 (Opposite.op (⊤ : (AlgebraicGeometry.Spec R_0).Opens)) := Subsingleton.elim _ _
        rw [h_id, CategoryTheory.Functor.map_id, CategoryTheory.Category.comp_id]
      have h_spec_app : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ev j))).appLE ⊤ ⊤ le_top =
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ev j))).appTop := by
        dsimp [AlgebraicGeometry.Scheme.Hom.appLE, AlgebraicGeometry.Scheme.Hom.appTop]
        rw [CategoryTheory.Functor.map_id]
        ext x
        rfl
      have h_mor_eq : Y.presheaf.map (CategoryTheory.homOfLE hWj_le).op ≫ φ_mor =
          CommRingCat.ofHom (ev j) := by
        dsimp [φ_mor]
        rw [← CategoryTheory.Category.assoc, h_nat, h_comp_app, h_from_app, h_spec_app,
          CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.ΓSpecIso_naturality,
          ← CategoryTheory.Category.assoc]
        change ((AlgebraicGeometry.Scheme.ΓSpecIso R_0).inv ≫
          (AlgebraicGeometry.Scheme.ΓSpecIso R_0).hom) ≫ CommRingCat.ofHom (ev j) =
          CommRingCat.ofHom (ev j)
        rw [CategoryTheory.Iso.inv_hom_id, CategoryTheory.Category.id_comp]
      ext b
      exact congrArg (fun m => m.hom b) h_mor_eq
    obtain ⟨⟨u_j, hu_unit, hu_mul⟩, hker_φ⟩ := hLoc R_j φ_j hφ_ext
    have hker_app : RingHom.ker (((σ_comp j).appLE W_j ⊤ hσ_le).hom) = RingHom.ker φ_j := by
      ext r
      simp only [RingHom.mem_ker]
      refine ⟨fun hr => ?_, fun hr => ?_⟩
      · change (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).hom.hom
          (((σ_comp j).appLE W_j ⊤ hσ_le).hom r) = 0
        rw [hr, map_zero]
      · have hinj : Function.Injective
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).hom.hom :=
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).commRingCatIsoToRingEquiv.injective
        apply hinj
        rw [map_zero]
        exact hr
    rw [← hker_app] at hker_φ
    exact ⟨hWj_le, u_j, hAffWj, hMemWj, hDisjWj, hu_unit, hu_mul, ⟨hσ_le, hker_φ⟩⟩
  obtain ⟨V_0, ψ_0, hV0_le, hAffV0, hV0_ne, hψ_C, hψ_et, ht0_ne⟩ := hs1
  refine ⟨V_0, ψ_0 Polynomial.X, hV0_le, hAffV0, hV0_ne, ht0_ne, ?_⟩
  intro c₀ τ_0 hZero
  have hC_c₀ : (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
      p_Y.appLE ⊤ V_0 le_top).hom c₀) = (ψ_0.comp Polynomial.C) c₀ :=
    (congrArg (fun φ => φ c₀) hψ_C).symm
  have hτ_eq : τ_0 = ψ_0 Polynomial.X - (ψ_0.comp Polynomial.C) c₀ :=
    congrArg (ψ_0 Polynomial.X - ·) hC_c₀
  have hNotUnit : ¬ IsUnit (ψ_0 Polynomial.X - (ψ_0.comp Polynomial.C) c₀) := by
    rw [← hτ_eq]
    intro hUnit
    obtain ⟨y, hy_in, hy_not⟩ := hZero
    have hbo_eq : Y.basicOpen τ_0 = V_0 :=
      Y.basicOpen_of_isUnit hUnit
    rw [hbo_eq] at hy_not
    exact hy_not hy_in
  obtain ⟨m_pts, ev, e_idem, hev_c, hev_diag, hev_off, hZeroLocus, hAway⟩ :=
    hs2 ↑(Y.presheaf.obj (Opposite.op V_0)) ψ_0 hψ_et c₀ hNotUnit
  rw [← hτ_eq] at hZeroLocus hAway
  have hev_c' : ∀ j : Fin (m_pts + 1),
      (ev j).comp
        (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
          p_Y.appLE ⊤ V_0 le_top).hom) = RingHom.id k₀ := by
    rw [← hψ_C]
    exact hev_c
  obtain ⟨σ_comp, hSec, hInj, hInV0, hFibEq, hPoleCharts⟩ :=
    hs3 V_0 hAffV0 τ_0 m_pts ev e_idem hev_c' hev_diag hev_off hZeroLocus hAway
  exact ⟨m_pts, σ_comp, e_idem, hSec, hInj, hInV0, hFibEq, hPoleCharts⟩

theorem weil_affine_curve_crt_uniform_polar_family (k₀ : Type u) [Field k₀] [IsAlgClosed k₀]
    (Y X_tilde : AlgebraicGeometry.Scheme.{u})
    (p_tilde : X_tilde ⟶ AlgebraicGeometry.Spec (CommRingCat.of k₀))
    (ι_tilde : X_tilde ⟶ Y)
    (hInt : AlgebraicGeometry.IsIntegral X_tilde)
    (hProp : AlgebraicGeometry.IsProper p_tilde)
    (U_part V_0 : Y.Opens)
    (hV0_le : V_0 ≤ U_part)
    (hAffV0 : AlgebraicGeometry.IsAffineOpen V_0)
    (hPartNe : Nonempty U_part)
    (hIsoPart : CategoryTheory.IsIso (ι_tilde ∣_ U_part))
    (Ω_0 : X_tilde.Opens)
    (hAff0 : AlgebraicGeometry.IsAffineOpen Ω_0)
    (hDim0 : Ring.DimensionLEOne ↑(X_tilde.presheaf.obj (Opposite.op Ω_0)))
    (hFinCl : ∀ (Z : Set ↥X_tilde), IsClosed Z → Z ≠ Set.univ → Z.Finite)
    (hOutIn0 : ∀ z : ↥X_tilde, ι_tilde.base z ∉ U_part → z ∈ Ω_0)
    (τ_0 : ↑(Y.presheaf.obj (Opposite.op V_0)))
    (u_0 : ↑(X_tilde.presheaf.obj (Opposite.op Ω_0)))
    (hD_le : (TopologicalSpace.Opens.map ι_tilde.base).obj (Y.basicOpen τ_0) ≤ Ω_0)
    (hInv0 : ((ι_tilde.appLE V_0
        ((TopologicalSpace.Opens.map ι_tilde.base).obj (Y.basicOpen τ_0))
        ((TopologicalSpace.Opens.map ι_tilde.base).monotone (Y.basicOpen_le τ_0))).hom τ_0) *
      (X_tilde.presheaf.map (CategoryTheory.homOfLE hD_le).op).hom u_0 = 1) :
    ∃ (K_bound : ℕ),
      1 ≤ K_bound ∧
      ∀ (k₁ : ℕ), K_bound ≤ k₁ →
        ∃ (f_tilde : ↑(X_tilde.presheaf.obj (Opposite.op Ω_0)))
          (w : ↑(Y.presheaf.obj (Opposite.op V_0))),
          (∀ z : ↥X_tilde, ι_tilde.base z ∉ U_part → z ∉ X_tilde.basicOpen f_tilde) ∧
          w - 1 ∈ Ideal.span {τ_0} ∧
          (((ι_tilde.appLE V_0
              ((TopologicalSpace.Opens.map ι_tilde.base).obj (Y.basicOpen τ_0))
              ((TopologicalSpace.Opens.map ι_tilde.base).monotone (Y.basicOpen_le τ_0))).hom τ_0) ^ k₁ *
            (X_tilde.presheaf.map (CategoryTheory.homOfLE hD_le).op).hom f_tilde =
          ((ι_tilde.appLE V_0
              ((TopologicalSpace.Opens.map ι_tilde.base).obj (Y.basicOpen τ_0))
              ((TopologicalSpace.Opens.map ι_tilde.base).monotone (Y.basicOpen_le τ_0))).hom w)) :=
by
  let A_0 := ↑(X_tilde.presheaf.obj (Opposite.op Ω_0))
  let B_0 := ↑(Y.presheaf.obj (Opposite.op V_0))
  let D_Y : Y.Opens := Y.basicOpen τ_0
  let V_tilde : X_tilde.Opens := (TopologicalSpace.Opens.map ι_tilde.base).obj V_0
  let D_tilde : X_tilde.Opens := (TopologicalSpace.Opens.map ι_tilde.base).obj D_Y
  let D_0 := ↑(X_tilde.presheaf.obj (Opposite.op D_tilde))
  let hD_V : D_tilde ≤ V_tilde :=
    (TopologicalSpace.Opens.map ι_tilde.base).monotone (Y.basicOpen_le τ_0)
  let res_A : A_0 →+* D_0 := (X_tilde.presheaf.map (CategoryTheory.homOfLE hD_le).op).hom
  let res_B : B_0 →+* D_0 := (ι_tilde.appLE V_0 D_tilde hD_V).hom
  have hHomComp : ∀ {R₁ R₂ R₃ : CommRingCat.{u}} (f : R₁ ⟶ R₂) (g : R₂ ⟶ R₃) (x : R₁),
      (f ≫ g).hom x = g.hom (f.hom x) := fun _ _ _ => rfl
  have hResX : ∀ {U₁ U₂ U₃ : X_tilde.Opens} (h₁₂ : U₁ ≤ U₂) (h₂₃ : U₂ ≤ U₃)
      (x : ↑(X_tilde.presheaf.obj (Opposite.op U₃))),
      (X_tilde.presheaf.map (CategoryTheory.homOfLE h₁₂).op).hom
        ((X_tilde.presheaf.map (CategoryTheory.homOfLE h₂₃).op).hom x) =
      (X_tilde.presheaf.map (CategoryTheory.homOfLE (h₁₂.trans h₂₃)).op).hom x := by
    intro U₁ U₂ U₃ h₁₂ h₂₃ x
    have hOpComp : (CategoryTheory.homOfLE (h₁₂.trans h₂₃)).op =
        (CategoryTheory.homOfLE h₂₃).op ≫ (CategoryTheory.homOfLE h₁₂).op := by
      rw [← CategoryTheory.homOfLE_comp]; rfl
    rw [hOpComp, CategoryTheory.Functor.map_comp, hHomComp]
  
  have hAppIso : ∀ (W : Y.Opens), W ≤ U_part → CategoryTheory.IsIso (ι_tilde.app W) := by
    intro W hW
    let V : U_part.toScheme.Opens :=
      ⟨U_part.ι.base ⁻¹' (W : Set ↥Y), W.isOpen.preimage U_part.ι.base.hom.continuous⟩
    have hUV : U_part.ι ''ᵁ V = W := by
      ext y
      change y ∈ U_part.ι.base '' (U_part.ι.base ⁻¹' (W : Set ↥Y)) ↔ y ∈ W
      refine ⟨?_, fun hy => ⟨⟨y, hW hy⟩, hy, rfl⟩⟩
      rintro ⟨z, hzW, rfl⟩
      exact hzW
    have hApp := AlgebraicGeometry.morphismRestrict_app ι_tilde U_part V
    have h1 : CategoryTheory.IsIso ((ι_tilde ∣_ U_part).app V) := inferInstance
    rw [hApp] at h1
    have hMapEqIso : ∀ {U₁ U₂ : X_tilde.Opens} (heq : U₁ = U₂),
        CategoryTheory.IsIso (X_tilde.presheaf.map (CategoryTheory.eqToHom heq).op) := by
      rintro U₁ U₂ rfl
      have hId : (CategoryTheory.eqToHom (rfl : U₁ = U₁)).op = 𝟙 (Opposite.op U₁) := rfl
      rw [hId, CategoryTheory.Functor.map_id]
      infer_instance
    have hOfComp : ∀ {A B C : CommRingCat.{u}} (f : A ⟶ B) (g : B ⟶ C)
        (_ : CategoryTheory.IsIso g), CategoryTheory.IsIso (f ≫ g) → CategoryTheory.IsIso f :=
      fun f g _ hfg => @CategoryTheory.IsIso.of_isIso_comp_right _ _ _ _ _ f g _ hfg
    have h2 : CategoryTheory.IsIso (ι_tilde.app (U_part.ι ''ᵁ V)) :=
      hOfComp _ _ (hMapEqIso _) h1
    rwa [hUV] at h2
  have hIsoV0 : CategoryTheory.IsIso (ι_tilde.app V_0) := hAppIso V_0 hV0_le
  have hIsoDY : CategoryTheory.IsIso (ι_tilde.app D_Y) :=
    hAppIso D_Y ((Y.basicOpen_le τ_0).trans hV0_le)
  let c_A : k₀ →+* A_0 :=
    ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
      p_tilde.appLE ⊤ Ω_0 le_top).hom
  let c_B : k₀ →+* B_0 :=
    ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
      p_tilde.appLE ⊤ V_tilde le_top ≫ CategoryTheory.inv (ι_tilde.app V_0)).hom
  have hComm_pt : ∀ c : k₀, res_A (c_A c) = res_B (c_B c) := by
    intro c
    let s_top := (p_tilde.app ⊤).hom
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv.hom c)
    have hL : res_A (c_A c) =
        (X_tilde.presheaf.map (CategoryTheory.homOfLE
          (hD_le.trans (le_top : Ω_0 ≤ _))).op).hom s_top := by
      change (X_tilde.presheaf.map (CategoryTheory.homOfLE hD_le).op).hom
        ((X_tilde.presheaf.map (CategoryTheory.homOfLE le_top).op).hom s_top) = _
      exact hResX hD_le le_top s_top
    have hApp_cB : (ι_tilde.app V_0).hom (c_B c) =
        (X_tilde.presheaf.map (CategoryTheory.homOfLE (le_top : V_tilde ≤ _)).op).hom s_top := by
      change (CategoryTheory.inv (ι_tilde.app V_0) ≫ ι_tilde.app V_0).hom
        ((X_tilde.presheaf.map (CategoryTheory.homOfLE le_top).op).hom s_top) = _
      rw [CategoryTheory.IsIso.inv_hom_id]
      rfl
    have hR : res_B (c_B c) =
        (X_tilde.presheaf.map (CategoryTheory.homOfLE
          (hD_V.trans (le_top : V_tilde ≤ _))).op).hom s_top := by
      change (X_tilde.presheaf.map (CategoryTheory.homOfLE hD_V).op).hom
        ((ι_tilde.app V_0).hom (c_B c)) = _
      rw [hApp_cB]
      exact hResX hD_V le_top s_top
    rw [hL, hR]
  have : AlgebraicGeometry.IsProper p_tilde := hProp
  have hft_app : (p_tilde.appLE ⊤ Ω_0 le_top).hom.FiniteType :=
    p_tilde.finiteType_appLE (AlgebraicGeometry.isAffineOpen_top _) hAff0 le_top
  have hSurj_iso : Function.Surjective
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv.hom) := by
    intro y
    refine ⟨(AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).hom.hom y, ?_⟩
    change ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).hom ≫
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv).hom y = y
    rw [CategoryTheory.Iso.hom_inv_id]
    rfl
  have hft_iso : ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv.hom).FiniteType :=
    RingHom.FiniteType.of_surjective _ hSurj_iso
  have hcA_ft : c_A.FiniteType := by
    change ((p_tilde.appLE ⊤ Ω_0 le_top).hom.comp
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv.hom)).FiniteType
    exact RingHom.FiniteType.comp hft_app hft_iso
  have hAway : ∀ x : D_0, ∃ (n : ℕ) (b : B_0), x * (res_B τ_0) ^ n = res_B b := by
    intro x
    let ρ_Y : B_0 →+* ↑(Y.presheaf.obj (Opposite.op D_Y)) :=
      (Y.presheaf.map (CategoryTheory.homOfLE (Y.basicOpen_le τ_0)).op).hom
    let _ : Algebra B_0 ↑(Y.presheaf.obj (Opposite.op D_Y)) := ρ_Y.toAlgebra
    have : IsLocalization.Away τ_0 ↑(Y.presheaf.obj (Opposite.op D_Y)) :=
      hAffV0.isLocalization_basicOpen τ_0
    let y_D : ↑(Y.presheaf.obj (Opposite.op D_Y)) :=
      (CategoryTheory.inv (ι_tilde.app D_Y)).hom x
    have hy_D : (ι_tilde.app D_Y).hom y_D = x := by
      change (CategoryTheory.inv (ι_tilde.app D_Y) ≫ ι_tilde.app D_Y).hom x = x
      rw [CategoryTheory.IsIso.inv_hom_id]
      rfl
    obtain ⟨n, b, hnb⟩ := IsLocalization.Away.surj τ_0 y_D
    have hNatD : ∀ s : B_0, (ι_tilde.app D_Y).hom (ρ_Y s) = res_B s := by
      intro s
      have hNat := congrArg (fun g => g.hom s)
        (ι_tilde.naturality (CategoryTheory.homOfLE (Y.basicOpen_le τ_0)).op)
      have hMapEq : ((TopologicalSpace.Opens.map ι_tilde.base).map
          (CategoryTheory.homOfLE (Y.basicOpen_le τ_0)).op.unop) =
          CategoryTheory.homOfLE hD_V := Subsingleton.elim _ _
      rw [hMapEq] at hNat
      exact hNat
    refine ⟨n, b, ?_⟩
    have hMap := congrArg (ι_tilde.app D_Y).hom hnb
    change (ι_tilde.app D_Y).hom (y_D * (ρ_Y τ_0) ^ n) = (ι_tilde.app D_Y).hom (ρ_Y b) at hMap
    rw [map_mul, map_pow, hy_D, hNatD τ_0, hNatD b] at hMap
    exact hMap
  
  let U_tilde_part : X_tilde.Opens := (TopologicalSpace.Opens.map ι_tilde.base).obj U_part
  let S_out : Set ↥X_tilde := {z : ↥X_tilde | ι_tilde.base z ∉ U_part}
  have hS_compl : S_out = (U_tilde_part : Set ↥X_tilde)ᶜ := rfl
  have hBoundary : ∃ (r : ℕ) (𝔪 : Fin r → Ideal A_0),
      (∀ i : Fin r, (𝔪 i).IsMaximal) ∧
      Function.Injective 𝔪 ∧
      ∀ (f_tilde : A_0), (∀ i : Fin r, f_tilde ∈ 𝔪 i) →
        ∀ z : ↥X_tilde, ι_tilde.base z ∉ U_part → z ∉ X_tilde.basicOpen f_tilde := by
    by_cases hSne : S_out.Nonempty
    · obtain ⟨z₀, hz₀⟩ := hSne
      have hz₀_Ω : z₀ ∈ Ω_0 := hOutIn0 z₀ hz₀
      have : Nonempty Ω_0 := ⟨⟨z₀, hz₀_Ω⟩⟩
      have : AlgebraicGeometry.IsIntegral X_tilde := hInt
      have : Ring.DimensionLEOne A_0 := hDim0
      have : IrreducibleSpace ↥X_tilde := AlgebraicGeometry.irreducibleSpace_of_isIntegral X_tilde
      have : IsDomain A_0 := inferInstance
      obtain ⟨y₀⟩ := hPartNe
      let g_inv := CategoryTheory.inv (ι_tilde ∣_ U_part)
      let x_u := g_inv.base ⟨y₀.1, y₀.2⟩
      have hx_u_mem : x_u.1 ∈ U_tilde_part := x_u.2
      have hS_ne_univ : S_out ≠ Set.univ := by
        intro hUniv
        have hx_in : x_u.1 ∈ S_out := hUniv ▸ Set.mem_univ x_u.1
        exact hx_in hx_u_mem
      have hS_closed : IsClosed S_out := by
        rw [hS_compl]
        exact U_tilde_part.isOpen.isClosed_compl
      have hS_fin : S_out.Finite := hFinCl S_out hS_closed hS_ne_univ
      let _ : Fintype ↥S_out := hS_fin.fintype
      let r : ℕ := Fintype.card ↥S_out
      let e_S : Fin r ≃ ↥S_out := (Fintype.equivFin ↥S_out).symm
      let pt_Ω : Fin r → ↥(Ω_0.toScheme) := fun i => ⟨(e_S i).1, hOutIn0 (e_S i).1 (e_S i).2⟩
      let q : Fin r → PrimeSpectrum A_0 := fun i => hAff0.isoSpec.hom.base (pt_Ω i)
      let 𝔪 : Fin r → Ideal A_0 := fun i => (q i).asIdeal
      have hFrom_pt : ∀ p : ↥(Ω_0.toScheme),
          hAff0.fromSpec.base (hAff0.isoSpec.hom.base p) = p.1 := by
        intro p
        have hEqMor : hAff0.isoSpec.hom ≫ hAff0.fromSpec = Ω_0.ι := by
          change hAff0.isoSpec.hom ≫ hAff0.isoSpec.inv ≫ Ω_0.ι = Ω_0.ι
          exact CategoryTheory.Iso.hom_inv_id_assoc hAff0.isoSpec Ω_0.ι
        exact congrArg (fun φ => φ.base p) hEqMor
      have hFrom_q : ∀ i : Fin r, hAff0.fromSpec.base (q i) = (e_S i).1 :=
        fun i => hFrom_pt (pt_Ω i)
      have hInj : Function.Injective 𝔪 := by
        intro i j hij
        have hq : q i = q j := PrimeSpectrum.ext hij
        have heval : (e_S i).1 = (e_S j).1 := by
          rw [← hFrom_q i, hq, hFrom_q j]
        exact e_S.injective (Subtype.ext heval)
      obtain ⟨w₀, hw_Ω, hw_U⟩ :=
        nonempty_preirreducible_inter Ω_0.isOpen U_tilde_part.isOpen
          ⟨z₀, hz₀_Ω⟩ ⟨x_u.1, hx_u_mem⟩
      let q_w : PrimeSpectrum A_0 := hAff0.isoSpec.hom.base ⟨w₀, hw_Ω⟩
      have hFrom_qw : hAff0.fromSpec.base q_w = w₀ := hFrom_pt ⟨w₀, hw_Ω⟩
      have hSpec_bot : (⊥ : PrimeSpectrum A_0) ⤳ q_w :=
        (PrimeSpectrum.le_iff_specializes (⊥ : PrimeSpectrum A_0) q_w).mp bot_le
      have hSpec_map : hAff0.fromSpec.base (⊥ : PrimeSpectrum A_0) ⤳ w₀ := by
        rw [← hFrom_qw]
        exact hSpec_bot.map hAff0.fromSpec.base.hom.continuous
      have hBot_in_U : hAff0.fromSpec.base (⊥ : PrimeSpectrum A_0) ∈ U_tilde_part :=
        hSpec_map.mem_open U_tilde_part.isOpen hw_U
      have hMax : ∀ i : Fin r, (𝔪 i).IsMaximal := by
        intro i
        have h_ne_bot : 𝔪 i ≠ ⊥ := by
          intro hbot
          have hqi_bot : q i = (⊥ : PrimeSpectrum A_0) := PrimeSpectrum.ext hbot
          have h_in_U : (e_S i).1 ∈ U_tilde_part := by
            rw [← hFrom_q i, hqi_bot]
            exact hBot_in_U
          exact (e_S i).2 h_in_U
        exact Ring.DimensionLEOne.maximalOfPrime h_ne_bot (q i).isPrime
      refine ⟨r, 𝔪, hMax, hInj, ?_⟩
      intro f_tilde hf_mem z hz
      let i : Fin r := e_S.symm ⟨z, hz⟩
      have hzi : hAff0.fromSpec.base (q i) = z := by
        rw [hFrom_q i]
        change (e_S (e_S.symm ⟨z, hz⟩)).1 = z
        rw [e_S.apply_symm_apply]
      intro hz_bo
      rw [← hzi] at hz_bo
      have hqi_pre : q i ∈ hAff0.fromSpec ⁻¹ᵁ X_tilde.basicOpen f_tilde := hz_bo
      rw [hAff0.fromSpec_preimage_basicOpen] at hqi_pre
      change f_tilde ∉ 𝔪 i at hqi_pre
      exact hqi_pre (hf_mem i)
    · refine ⟨0, Fin.elim0, fun i => Fin.elim0 i, fun i => Fin.elim0 i, ?_⟩
      intro _ _ z hz
      exact (hSne ⟨z, hz⟩).elim
  
  obtain ⟨r, 𝔪, hMax, hInj, hVanish⟩ := hBoundary
  let _ : Algebra k₀ A_0 := c_A.toAlgebra
  have : Algebra.FiniteType k₀ A_0 := hcA_ft
  have hu_ex : ∀ i : Fin r, ∃ c : k₀,
      Ideal.Quotient.mk (𝔪 i) (c_A c) = Ideal.Quotient.mk (𝔪 i) u_0 := by
    intro i
    have : (𝔪 i).IsMaximal := hMax i
    let _ : Field (A_0 ⧸ 𝔪 i) := Ideal.Quotient.field (𝔪 i)
    have : Algebra.FiniteType k₀ (A_0 ⧸ 𝔪 i) :=
      Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ k₀ (𝔪 i))
        (Ideal.Quotient.mkₐ_surjective k₀ (𝔪 i))
    have : Module.Finite k₀ (A_0 ⧸ 𝔪 i) :=
      finite_of_finite_type_of_isJacobsonRing k₀ (A_0 ⧸ 𝔪 i)
    have : Algebra.IsIntegral k₀ (A_0 ⧸ 𝔪 i) :=
      Algebra.IsIntegral.of_finite k₀ (A_0 ⧸ 𝔪 i)
    have hSurj : Function.Surjective (algebraMap k₀ (A_0 ⧸ 𝔪 i)) :=
      (IsAlgClosed.algebraMap_bijective_of_isIntegral (k := k₀) (K := A_0 ⧸ 𝔪 i)).2
    obtain ⟨c, hc⟩ := hSurj (Ideal.Quotient.mk (𝔪 i) u_0)
    exact ⟨c, hc⟩
  choose u_bar hu_bar using hu_ex
  have h_pow : ∀ (k₁ : ℕ) (i : Fin r), u_0 ^ k₁ - c_A ((u_bar i) ^ k₁) ∈ 𝔪 i := by
    intro k₁ i
    apply Ideal.Quotient.eq.mp
    rw [map_pow, map_pow c_A, map_pow, hu_bar i]
  have hCop : _root_.Pairwise (Function.onFun IsCoprime 𝔪) := by
    intro i j hij
    have := hMax i
    have := hMax j
    exact Ideal.isCoprime_of_isMaximal (hInj.ne hij)
  have he_ex : ∀ i : Fin r, ∃ e_i : A_0,
      ∀ j : Fin r, Ideal.Quotient.mk (𝔪 j) e_i = if j = i then 1 else 0 := by
    intro i
    obtain ⟨q_e, hq_e⟩ :=
      Ideal.quotientInfToPiQuotient_surj hCop
        (fun j : Fin r => if j = i then (1 : A_0 ⧸ 𝔪 j) else 0)
    obtain ⟨e_i, rfl⟩ := Ideal.Quotient.mk_surjective q_e
    refine ⟨e_i, fun j => ?_⟩
    have hj := congrFun hq_e j
    rwa [Ideal.quotientInfToPiQuotient_mk] at hj
  choose e he using he_ex
  have he_diag : ∀ i : Fin r, e i - 1 ∈ 𝔪 i := by
    intro i
    apply Ideal.Quotient.eq.mp
    rw [he i i]
    simp
  have he_off : ∀ i j : Fin r, i ≠ j → e i ∈ 𝔪 j := by
    intro i j hij
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    rw [he i j]
    simp [hij.symm]
  choose k_exp b_num hClear using fun i : Fin r => hAway (res_A (e i))
  let K_bound : ℕ := 1 + Finset.univ.sup k_exp
  refine ⟨K_bound, Nat.le_add_right 1 _, ?_⟩
  intro k₁ hk₁
  let f_tilde : A_0 := u_0 ^ k₁ - ∑ i : Fin r, c_A ((u_bar i) ^ k₁) * e i
  let w : B_0 := 1 - τ_0 * ∑ i : Fin r, c_B ((u_bar i) ^ k₁) * τ_0 ^ (k₁ - 1 - k_exp i) * b_num i
  have hf_mem : ∀ j : Fin r, f_tilde ∈ 𝔪 j := by
    intro j
    have hf_split : f_tilde =
        (u_0 ^ k₁ - c_A ((u_bar j) ^ k₁)) -
        c_A ((u_bar j) ^ k₁) * (e j - 1) -
        ∑ i ∈ Finset.univ.erase j, c_A ((u_bar i) ^ k₁) * e i := by
      dsimp [f_tilde]
      rw [← Finset.add_sum_erase _ _ (Finset.mem_univ j)]
      ring
    rw [hf_split]
    refine (𝔪 j).sub_mem ((𝔪 j).sub_mem (h_pow k₁ j) ((𝔪 j).mul_mem_left _ (he_diag j))) ?_
    refine Submodule.sum_mem (𝔪 j) fun i hi => ?_
    exact (𝔪 j).mul_mem_left _ (he_off i j (Finset.ne_of_mem_erase hi))
  have hw_span : w - 1 ∈ Ideal.span {τ_0} := by
    rw [Ideal.mem_span_singleton]
    refine ⟨- ∑ i : Fin r, c_B ((u_bar i) ^ k₁) * τ_0 ^ (k₁ - 1 - k_exp i) * b_num i, ?_⟩
    dsimp [w]
    ring
  have hEq : (res_B τ_0) ^ k₁ * res_A f_tilde = res_B w := by
    have h_u0 : (res_B τ_0) ^ k₁ * res_A (u_0 ^ k₁) = 1 := by
      rw [map_pow, ← mul_pow, hInv0, one_pow]
    have h_term : ∀ i : Fin r,
        (res_B τ_0) ^ k₁ * res_A (c_A ((u_bar i) ^ k₁) * e i) =
        res_B τ_0 * res_B (c_B ((u_bar i) ^ k₁) * τ_0 ^ (k₁ - 1 - k_exp i) * b_num i) := by
      intro i
      have hi_le : k_exp i ≤ Finset.univ.sup k_exp := Finset.le_sup (Finset.mem_univ i)
      have hk_split : k₁ = (1 + (k₁ - 1 - k_exp i)) + k_exp i := by
        dsimp [K_bound] at hk₁
        omega
      have hc_eq : res_A (c_A ((u_bar i) ^ k₁)) = res_B (c_B ((u_bar i) ^ k₁)) :=
        hComm_pt ((u_bar i) ^ k₁)
      calc
        (res_B τ_0) ^ k₁ * res_A (c_A ((u_bar i) ^ k₁) * e i)
            = ((res_B τ_0) ^ (1 + (k₁ - 1 - k_exp i)) * (res_B τ_0) ^ (k_exp i)) *
                (res_B (c_B ((u_bar i) ^ k₁)) * res_A (e i)) := by
              rw [map_mul, hc_eq]
              congr 1
              rw [← pow_add, ← hk_split]
        _ = res_B τ_0 * res_B (c_B ((u_bar i) ^ k₁)) *
              (res_B τ_0) ^ (k₁ - 1 - k_exp i) *
              (res_A (e i) * (res_B τ_0) ^ (k_exp i)) := by
              rw [pow_add, pow_one]
              ring
        _ = res_B τ_0 * res_B (c_B ((u_bar i) ^ k₁) * τ_0 ^ (k₁ - 1 - k_exp i) * b_num i) := by
              rw [hClear i]
              simp only [map_mul, map_pow]
              ring
    dsimp [f_tilde, w]
    rw [map_sub, mul_sub, h_u0, map_sum, Finset.mul_sum]
    have h_sum : (∑ i : Fin r, (res_B τ_0) ^ k₁ * res_A (c_A ((u_bar i) ^ k₁) * e i)) =
        ∑ i : Fin r, res_B τ_0 * res_B (c_B ((u_bar i) ^ k₁) * τ_0 ^ (k₁ - 1 - k_exp i) * b_num i) :=
      Finset.sum_congr rfl fun i _ => h_term i
    rw [h_sum, ← Finset.mul_sum, map_sub, map_one, map_mul, map_sum]
  exact ⟨f_tilde, w, hVanish f_tilde hf_mem, hw_span, hEq⟩

theorem weil_curve_open_iso_chart_transport_and_fbar_compat (k₀ : Type u) [Field k₀]
    (Y X_tilde : AlgebraicGeometry.Scheme.{u})
    (p_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of k₀))
    (ι_tilde : X_tilde ⟶ Y)
    (U_part : Y.Opens)
    (hSub : (U_part : Set ↥Y) ⊆ Set.range ι_tilde.base)
    (hIsoPart : CategoryTheory.IsIso (ι_tilde ∣_ U_part))
    (m_pts k₁ : ℕ)
    (σ_comp : Fin (m_pts + 1) → (AlgebraicGeometry.Spec (CommRingCat.of k₀) ⟶ Y))
    (hSec : ∀ j : Fin (m_pts + 1), σ_comp j ≫ p_Y = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k₀)))
    (U_Y0 : Y.Opens)
    (hUY0 : (U_Y0 : Set ↥Y) ∩ Set.range ι_tilde.base =
      Set.range ι_tilde.base \ (⋃ j : Fin (m_pts + 1), Set.range (σ_comp j).base))
    (Ω_0 : X_tilde.Opens)
    (hΩ0_eq : Ω_0 = (TopologicalSpace.Opens.map ι_tilde.base).obj U_Y0)
    (f_0 : ↑(X_tilde.presheaf.obj (Opposite.op Ω_0)))
    (hVanish : ∀ z : ↥X_tilde, ι_tilde.base z ∉ U_part → z ∈ Ω_0 ∧ z ∉ X_tilde.basicOpen f_0)
    (hFin0 : (Polynomial.eval₂RingHom
      (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
        (ι_tilde ≫ p_Y).appLE ⊤ Ω_0 le_top).hom) f_0).Finite)
    (W_comp : Fin (m_pts + 1) → Y.Opens)
    (t_comp u_comp : ∀ j : Fin (m_pts + 1), ↑(Y.presheaf.obj (Opposite.op (W_comp j))))
    (hW_props : ∀ j : Fin (m_pts + 1),
      W_comp j ≤ U_part ∧
      AlgebraicGeometry.IsAffineOpen (W_comp j) ∧
      (σ_comp j).base (⊥ : PrimeSpectrum k₀) ∈ W_comp j ∧
      (∀ j' : Fin (m_pts + 1), j' ≠ j → (σ_comp j').base (⊥ : PrimeSpectrum k₀) ∉ W_comp j) ∧
      IsUnit (u_comp j) ∧
      (∃ hσ_le : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of k₀)).Opens) ≤
          (TopologicalSpace.Opens.map (σ_comp j).base).obj (W_comp j),
        RingHom.ker (((σ_comp j).appLE (W_comp j) ⊤ hσ_le).hom) =
          Ideal.span {t_comp j}))
    (Ω_1 : X_tilde.Opens)
    (hAff1 : AlgebraicGeometry.IsAffineOpen Ω_1)
    (hΩ1_eq : Ω_1 = X_tilde.basicOpen f_0 ⊔
      ⨆ j : Fin (m_pts + 1), (TopologicalSpace.Opens.map ι_tilde.base).obj (W_comp j))
    (hInter_eq : Ω_0 ⊓ Ω_1 = X_tilde.basicOpen f_0)
    (s_1 : ↑(X_tilde.presheaf.obj (Opposite.op Ω_1)))
    (hFin1 : (Polynomial.eval₂RingHom
      (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
        (ι_tilde ≫ p_Y).appLE ⊤ Ω_1 le_top).hom) s_1).Finite)
    (hRecip_ov : ∀ (h0 : X_tilde.basicOpen f_0 ≤ Ω_0) (h1 : X_tilde.basicOpen f_0 ≤ Ω_1),
      (X_tilde.presheaf.map (CategoryTheory.homOfLE h0).op).hom f_0 *
        (X_tilde.presheaf.map (CategoryTheory.homOfLE h1).op).hom s_1 = 1)
    (hPole_ov : ∀ (j : Fin (m_pts + 1))
        (hWj_1 : (TopologicalSpace.Opens.map ι_tilde.base).obj (W_comp j) ≤ Ω_1),
      (X_tilde.presheaf.map (CategoryTheory.homOfLE hWj_1).op).hom s_1 =
        (ι_tilde.app (W_comp j)).hom (u_comp j * (t_comp j) ^ k₁)) :
    let U_tilde_0 : X_tilde.Opens := (TopologicalSpace.Opens.map ι_tilde.base).obj U_Y0
    ∃ (f_tilde : ↑(X_tilde.presheaf.obj (Opposite.op U_tilde_0)))
      (U_1_comp : Y.Opens)
      (s_1_comp : ↑(Y.presheaf.obj (Opposite.op U_1_comp))),
      (∀ z : ↥X_tilde, ι_tilde.base z ∉ U_part →
        z ∈ U_tilde_0 ∧ z ∉ X_tilde.basicOpen f_tilde) ∧
      (Polynomial.eval₂RingHom
        (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
          (ι_tilde ≫ p_Y).appLE ⊤ U_tilde_0 le_top).hom) f_tilde).Finite ∧
      U_1_comp ≤ U_part ∧
      AlgebraicGeometry.IsAffineOpen U_1_comp ∧
      (Polynomial.eval₂RingHom
        (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
          p_Y.appLE ⊤ U_1_comp le_top).hom) s_1_comp).Finite ∧
      (∀ (f_bar : ↑(Y.presheaf.obj (Opposite.op U_Y0))),
        (ι_tilde.app U_Y0).hom f_bar = f_tilde →
        (U_1_comp : Set ↥Y) =
          ((U_part : Set ↥Y) ∩ (Y.basicOpen f_bar : Set ↥Y)) ∪
          (⋃ j : Fin (m_pts + 1), (W_comp j : Set ↥Y)) ∧
        (∀ h_inter : Y.basicOpen f_bar ⊓ U_1_comp ≤ U_Y0,
          (Y.presheaf.map (CategoryTheory.homOfLE h_inter).op).hom f_bar *
            (Y.presheaf.map (CategoryTheory.homOfLE
              (inf_le_right : Y.basicOpen f_bar ⊓ U_1_comp ≤ U_1_comp)).op).hom s_1_comp = 1) ∧
        ∀ j : Fin (m_pts + 1),
          W_comp j ≤ U_1_comp ∧
          AlgebraicGeometry.IsAffineOpen (W_comp j) ∧
          (σ_comp j).base (⊥ : PrimeSpectrum k₀) ∈ W_comp j ∧
          IsUnit (u_comp j) ∧
          W_comp j ⊓ U_Y0 = Y.basicOpen (t_comp j) ∧
          (∃ hσ_le : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of k₀)).Opens) ≤
              (TopologicalSpace.Opens.map (σ_comp j).base).obj (W_comp j),
            RingHom.ker (((σ_comp j).appLE (W_comp j) ⊤ hσ_le).hom) =
              Ideal.span {t_comp j}) ∧
          (∀ hW_le1 : W_comp j ≤ U_1_comp,
            (Y.presheaf.map (CategoryTheory.homOfLE hW_le1).op).hom s_1_comp =
              u_comp j * (t_comp j) ^ k₁) ∧
          (∀ hB_le0 : Y.basicOpen (t_comp j) ≤ U_Y0,
            (Y.presheaf.map (CategoryTheory.homOfLE hB_le0).op).hom f_bar *
              (Y.presheaf.map (CategoryTheory.homOfLE
                (Y.basicOpen_le (t_comp j))).op).hom (u_comp j * (t_comp j) ^ k₁) = 1)) :=
by
  subst hΩ0_eq
  have hCompBase : ∀ {A B C : AlgebraicGeometry.Scheme.{u}} (f : A ⟶ B) (g : B ⟶ C) (x : ↥A),
      (f ≫ g).base x = g.base (f.base x) := fun _ _ _ => rfl
  have hHomComp : ∀ {R₁ R₂ R₃ : CommRingCat.{u}} (f : R₁ ⟶ R₂) (g : R₂ ⟶ R₃) (x : R₁),
      (f ≫ g).hom x = g.hom (f.hom x) := fun _ _ _ => rfl
  have hResX : ∀ {U₁ U₂ U₃ : X_tilde.Opens} (h₁₂ : U₁ ≤ U₂) (h₂₃ : U₂ ≤ U₃)
      (x : ↑(X_tilde.presheaf.obj (Opposite.op U₃))),
      (X_tilde.presheaf.map (CategoryTheory.homOfLE h₁₂).op).hom
        ((X_tilde.presheaf.map (CategoryTheory.homOfLE h₂₃).op).hom x) =
      (X_tilde.presheaf.map (CategoryTheory.homOfLE (h₁₂.trans h₂₃)).op).hom x := by
    intro U₁ U₂ U₃ h₁₂ h₂₃ x
    have hOpComp : (CategoryTheory.homOfLE (h₁₂.trans h₂₃)).op =
        (CategoryTheory.homOfLE h₂₃).op ≫ (CategoryTheory.homOfLE h₁₂).op := by
      rw [← CategoryTheory.homOfLE_comp]; rfl
    rw [hOpComp, CategoryTheory.Functor.map_comp, hHomComp]
  have hNatApp : ∀ {W V : Y.Opens} (hWV : W ≤ V)
      (s : ↑(Y.presheaf.obj (Opposite.op V))),
      (ι_tilde.app W).hom ((Y.presheaf.map (CategoryTheory.homOfLE hWV).op).hom s) =
      (X_tilde.presheaf.map
        (CategoryTheory.homOfLE ((TopologicalSpace.Opens.map ι_tilde.base).monotone hWV)).op).hom
        ((ι_tilde.app V).hom s) := by
    intro W V hWV s
    have hNat := congrArg (fun g => g.hom s) (ι_tilde.naturality (CategoryTheory.homOfLE hWV).op)
    exact hNat
  
  have : CategoryTheory.IsIso (ι_tilde ∣_ U_part) := hIsoPart
  have hAppIso : ∀ (W : Y.Opens), W ≤ U_part → CategoryTheory.IsIso (ι_tilde.app W) := by
    intro W hW
    let V : U_part.toScheme.Opens :=
      ⟨U_part.ι.base ⁻¹' (W : Set ↥Y), W.isOpen.preimage U_part.ι.base.hom.continuous⟩
    have hUV : U_part.ι ''ᵁ V = W := by
      ext y
      change y ∈ U_part.ι.base '' (U_part.ι.base ⁻¹' (W : Set ↥Y)) ↔ y ∈ W
      refine ⟨?_, fun hy => ⟨⟨y, hW hy⟩, hy, rfl⟩⟩
      rintro ⟨z, hzW, rfl⟩
      exact hzW
    have hApp := AlgebraicGeometry.morphismRestrict_app ι_tilde U_part V
    have h1 : CategoryTheory.IsIso ((ι_tilde ∣_ U_part).app V) := inferInstance
    rw [hApp] at h1
    have hMapEqIso : ∀ {U₁ U₂ : X_tilde.Opens} (heq : U₁ = U₂),
