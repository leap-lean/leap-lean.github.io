theorem weil_noetherian_segre_bridge_and_gammaZero_finiteness (K : Type u) [Field K]
    (m : ℕ) (V : ValuationSubring K) (hPkg : IsValuationRingAlgPackage m V)
    (hOpenη : AlgebraicGeometry.IsOpenImmersion
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (hIntCK : AlgebraicGeometry.IsIntegral C_K)
    (hSmCK : AlgebraicGeometry.SmoothOfRelativeDimension 1 p_K)
    (U_K : C_K.Opens) (hUK : Nonempty ↥U_K)
    (Z : AlgebraicGeometry.Scheme.{u})
    (g_Z : Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (ι_Z : U_K.toScheme ⟶ Z)
    (M : AlgebraicGeometry.Scheme.{u})
    (π : M ⟶ Z)
    (ι_M : U_K.toScheme ⟶ M)
    (hSS_Z : IsStrictlySemistableCurveOverValuation V g_Z)
    (hNoeth_Z : TopologicalSpace.NoetherianSpace ↥Z)
    (hPb_Z : CategoryTheory.IsPullback ι_Z (U_K.ι ≫ p_K) g_Z
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (hInt_M : AlgebraicGeometry.IsIntegral M)
    (hProp_π : AlgebraicGeometry.IsProper π)
    (hιM_π : ι_M ≫ π = ι_Z)
    (hPb_M : CategoryTheory.IsPullback ι_M (U_K.ι ≫ p_K) (π ≫ g_Z)
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (F : Type u) [Field F]
    (η_Z : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ Z)
    (hFunc_Z : IsSchemeFunctionField Z F η_Z)
    (hAff_proj : ∀ (R : Type u) [CommRing R] (N : ℕ) (a : Fin (N + 1)),
      AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen R N a))
    (c_proj : ∀ (R : Type u) [CommRing R] (N : ℕ) (a : Fin (N + 1)),
      R →+* ↑((weilProjectiveSpaceOver R N).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen R N a))))
    (t_proj : ∀ (R : Type u) [CommRing R] (N : ℕ) (a : Fin (N + 1)), Fin (N + 1) →
      ↑((weilProjectiveSpaceOver R N).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen R N a))))
    (hCoord_proj : ∀ (R : Type u) [CommRing R] (N : ℕ),
      IsCommRingProjCoordSystem R N (hAff_proj R N) (c_proj R N) (t_proj R N))
    (hGaussFin : ∀ (φ_KF : K →+* F),
      (letI : Algebra K F := φ_KF.toAlgebra
       Algebra.EssFiniteType K F ∧ Algebra.trdeg K F ≤ 1) →
      ∀ (P : Ideal ↥V) [P.IsPrime] (t : F),
        let S_Pt : Set (ValuationSubring F) :=
          {W : ValuationSubring F |
            ∃ (hV : ∀ c : ↥V, φ_KF (V.subtype c) ∈ W) (ht : t ∈ W),
              (∀ c : ↥V,
                ((⟨φ_KF (V.subtype c), hV c⟩ : ↥W) ∈ IsLocalRing.maximalIdeal ↥W ↔ c ∈ P)) ∧
              (∀ Q : Polynomial ↥V,
                (∃ i : ℕ, Q.coeff i ∉ P) →
                Polynomial.eval₂ ((φ_KF.comp V.subtype).codRestrict W.toSubring hV) ⟨t, ht⟩ Q ∉
                  IsLocalRing.maximalIdeal ↥W)}
        S_Pt.Finite ∧ (∀ W₁ ∈ S_Pt, ∀ W₂ ∈ S_Pt, W₁ ≤ W₂ → W₁ = W₂)) :
    (∀ (X : AlgebraicGeometry.Scheme.{u}) (p_X : X ⟶ Z),
      AlgebraicGeometry.IsProper p_X → TopologicalSpace.NoetherianSpace ↥X) ∧
    ∃ (η_UK : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ U_K.toScheme)
      (φ_KF : K →+* F)
      (M_proj : ℕ)
      (M_tilde : AlgebraicGeometry.Scheme.{u})
      (π_tilde : M_tilde ⟶ Z)
      (ι_proj : M_tilde ⟶ (weilProjectiveSpaceOver ↥V M_proj).left)
      (η_tilde : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ M_tilde)
      (hComm_proj : ι_proj ≫ (weilProjectiveSpaceOver ↥V M_proj).hom = π_tilde ≫ g_Z)
      (r_val : ℕ)
      (W_list : Fin r_val → ValuationSubring F),
      η_UK ≫ ι_Z = η_Z ∧
      IsSchemeFunctionField U_K.toScheme F η_UK ∧
      IsSchemeFunctionField M F (η_UK ≫ ι_M) ∧
      (∀ c : ↥V, φ_KF (V.subtype c) = (AlgebraicGeometry.Spec.preimage (η_Z ≫ g_Z)).hom c) ∧
      (letI : Algebra K F := φ_KF.toAlgebra
       Algebra.EssFiniteType K F ∧ Algebra.trdeg K F ≤ 1) ∧
      AlgebraicGeometry.IsIntegral M_tilde ∧
      AlgebraicGeometry.IsProper π_tilde ∧
      η_tilde ≫ π_tilde = η_Z ∧
      IsSchemeFunctionField M_tilde F η_tilde ∧
      AlgebraicGeometry.IsClosedImmersion
        (CategoryTheory.Limits.pullback.lift ι_proj π_tilde hComm_proj) ∧
      (∀ (W : ValuationSubring F),
        IsValResolvedOnMod V g_Z π (η_UK ≫ ι_M) W →
        (∀ (ψ_Z : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ Z)
            (mW : AlgebraicGeometry.Spec (CommRingCat.of ↥W)),
          mW.asIdeal = IsLocalRing.maximalIdeal ↥W →
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype) ≫ ψ_Z = η_Z →
          (g_Z.base (ψ_Z.base mW)).asIdeal ≠ ⊥) →
        IsValResolvedOnMod V g_Z π_tilde η_tilde W) ∧
      (∀ i : Fin r_val, IsDivisorialClosedVal V g_Z η_Z (W_list i)) ∧
      (∀ W : ValuationSubring F,
        IsDivisorialClosedVal V g_Z η_Z W →
        IsValResolvedOnMod V g_Z π_tilde η_tilde W →
        ∃ i : Fin r_val, W = W_list i) :=
by
  have hFinV : Set.Finite (Set.univ : Set (PrimeSpectrum ↥V)) := hPkg.1
  have hAlgClosedRes : ∀ (P : Ideal ↥V) [P.IsPrime], P ≠ ⊥ → IsAlgClosed P.ResidueField :=
    hPkg.2.2.2.2.1
  have hComp_Z : CompactSpace ↥Z :=
    @TopologicalSpace.NoetherianSpace.compactSpace ↥Z _ hNoeth_Z
  have hLFP_gZ : AlgebraicGeometry.LocallyOfFinitePresentation g_Z := hSS_Z.2.2.2.1
  have hLFT_gZ : AlgebraicGeometry.LocallyOfFiniteType g_Z :=
    AlgebraicGeometry.instLocallyOfFiniteTypeOfLocallyOfFinitePresentation g_Z

  
  
  
  have hNoethOverV : ∀ (X₀ : AlgebraicGeometry.Scheme.{u}) (_ : CompactSpace ↥X₀)
      (g_X₀ : X₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
      (_ : AlgebraicGeometry.LocallyOfFiniteType g_X₀),
      TopologicalSpace.NoetherianSpace ↥X₀ := by
    intro X₀ _ g_X₀ _
    have _ : Finite (PrimeSpectrum ↥V) := Set.finite_univ_iff.mp hFinV
    have hAffNoeth : ∀ (B : Type u) [CommRing B] [Algebra ↥V B] [Algebra.FiniteType ↥V B],
        TopologicalSpace.NoetherianSpace (PrimeSpectrum B) := by
      intro B _ _ _
      let F_P : PrimeSpectrum ↥V → Set (PrimeSpectrum B) := fun P =>
        Set.range (PrimeSpectrum.comap
          (Algebra.TensorProduct.includeRight (R := ↥V) (A := P.asIdeal.ResidueField) (B := B)).toRingHom)
      have _ : ∀ P : PrimeSpectrum ↥V, TopologicalSpace.NoetherianSpace ↥(F_P P) := by
        intro P
        have _ : IsNoetherianRing (TensorProduct ↥V P.asIdeal.ResidueField B) :=
          Algebra.FiniteType.isNoetherianRing P.asIdeal.ResidueField
            (TensorProduct ↥V P.asIdeal.ResidueField B)
        exact TopologicalSpace.NoetherianSpace.range _ (PrimeSpectrum.continuous_comap _)
      have hUnion : (⋃ P : PrimeSpectrum ↥V, F_P P) = Set.univ := by
        ext q
        simp only [Set.mem_iUnion, Set.mem_univ, iff_true]
        let P : PrimeSpectrum ↥V := PrimeSpectrum.comap (algebraMap ↥V B) q
        refine ⟨P, ?_⟩
        let α : P.asIdeal.ResidueField →ₐ[↥V] q.asIdeal.ResidueField :=
          Ideal.ResidueField.mapₐ P.asIdeal q.asIdeal (Algebra.ofId ↥V B) rfl
        let β : B →ₐ[↥V] q.asIdeal.ResidueField :=
          IsScalarTower.toAlgHom ↥V B q.asIdeal.ResidueField
        have hcomm : ∀ x y, Commute (α x) (β y) := fun _ _ => mul_comm _ _
        let Φ : TensorProduct ↥V P.asIdeal.ResidueField B →ₐ[↥V] q.asIdeal.ResidueField :=
          Algebra.TensorProduct.lift α β hcomm
        refine ⟨PrimeSpectrum.comap Φ.toRingHom ⊥, ?_⟩
        ext x
        change x ∈ Ideal.comap (Φ.toRingHom.comp
          (Algebra.TensorProduct.includeRight (R := ↥V) (A := P.asIdeal.ResidueField) (B := B)).toRingHom)
          (⊥ : Ideal q.asIdeal.ResidueField) ↔ x ∈ q.asIdeal
        have hcomp : Φ.toRingHom.comp
            (Algebra.TensorProduct.includeRight (R := ↥V) (A := P.asIdeal.ResidueField) (B := B)).toRingHom =
            algebraMap B q.asIdeal.ResidueField := by
          ext b
          change Φ ((1 : P.asIdeal.ResidueField) ⊗ₜ[↥V] b) = algebraMap B q.asIdeal.ResidueField b
          rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
          rfl
        rw [hcomp]
        change algebraMap B q.asIdeal.ResidueField x = 0 ↔ x ∈ q.asIdeal
        rw [← RingHom.mem_ker, Ideal.ker_algebraMap_residueField]
      have hUnivNoeth : TopologicalSpace.NoetherianSpace ↥(⋃ P : PrimeSpectrum ↥V, F_P P) :=
        TopologicalSpace.NoetherianSpace.iUnion F_P
      rw [hUnion] at hUnivNoeth
      exact TopologicalSpace.noetherian_univ_iff.mp hUnivNoeth
    have hCover : ∀ z : ↥X₀, ∃ U : X₀.Opens, AlgebraicGeometry.IsAffineOpen U ∧ z ∈ U := by
      intro z
      obtain ⟨U, hU, hzU, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := ⊤) (x := z) trivial
      exact ⟨U, hU, hzU⟩
    choose U_z hAff_z hz_mem using hCover
    obtain ⟨I, hICov⟩ := isCompact_univ.elim_finite_subcover (fun z => (U_z z : Set ↥X₀))
      (fun z => (U_z z).2) (fun z _ => Set.mem_iUnion.mpr ⟨z, hz_mem z⟩)
    let G : ↥I → Set ↥X₀ := fun i => (U_z i.1 : Set ↥X₀)
    have _ : ∀ i : ↥I, TopologicalSpace.NoetherianSpace ↥(G i) := by
      intro i
      let U := U_z i.1
      have hU : AlgebraicGeometry.IsAffineOpen U := hAff_z i.1
      have hle : U ≤ (TopologicalSpace.Opens.map g_X₀.base).obj ⊤ := fun _ _ => trivial
      let ψ := g_X₀.appLE ⊤ U hle
      have hFT_ψ : ψ.hom.FiniteType :=
        AlgebraicGeometry.Scheme.Hom.finiteType_appLE g_X₀
          (AlgebraicGeometry.isAffineOpen_top _) hU hle
      let eR := AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)
      let φ : ↥V →+* ↑(X₀.presheaf.obj (Opposite.op U)) := (eR.inv ≫ ψ).hom
      have hFT_eR : eR.inv.hom.FiniteType := by
        apply RingHom.FiniteType.of_surjective
        intro y
        refine ⟨eR.hom.hom y, ?_⟩
        change (eR.hom ≫ eR.inv).hom y = y
        rw [eR.hom_inv_id]
        rfl
      have hFT_φ : φ.FiniteType := by
        change (ψ.hom.comp eR.inv.hom).FiniteType
        exact hFT_ψ.comp hFT_eR
      let _ : Algebra ↥V ↑(X₀.presheaf.obj (Opposite.op U)) := φ.toAlgebra
      have _ : Algebra.FiniteType ↥V ↑(X₀.presheaf.obj (Opposite.op U)) := hFT_φ
      have _ : TopologicalSpace.NoetherianSpace
          (PrimeSpectrum ↑(X₀.presheaf.obj (Opposite.op U))) :=
        hAffNoeth ↑(X₀.presheaf.obj (Opposite.op U))
      have _ : TopologicalSpace.NoetherianSpace
          ↥(AlgebraicGeometry.Spec (X₀.presheaf.obj (Opposite.op U))) := ‹_›
      have hRange : Set.range hU.fromSpec.base = (U : Set ↥X₀) := hU.range_fromSpec
      have hNoethRange : TopologicalSpace.NoetherianSpace ↥(Set.range hU.fromSpec.base) :=
        TopologicalSpace.NoetherianSpace.range hU.fromSpec.base hU.fromSpec.continuous
      rwa [hRange] at hNoethRange
    have hUnionI : (⋃ i : ↥I, G i) = Set.univ := by
      ext z
      simp only [Set.mem_iUnion, Set.mem_univ, iff_true]
      obtain ⟨_, ⟨x, rfl⟩, _, ⟨hxI, rfl⟩, hzx⟩ := hICov (Set.mem_univ z)
      exact ⟨⟨x, hxI⟩, hzx⟩
    have hNoethUniv : TopologicalSpace.NoetherianSpace ↥(⋃ i : ↥I, G i) :=
      TopologicalSpace.NoetherianSpace.iUnion G
    rw [hUnionI] at hNoethUniv
    exact TopologicalSpace.noetherian_univ_iff.mp hNoethUniv

  have hPartA : ∀ (X : AlgebraicGeometry.Scheme.{u}) (p_X : X ⟶ Z),
      AlgebraicGeometry.IsProper p_X → TopologicalSpace.NoetherianSpace ↥X := by
    intro X p_X hProp_pX
    have _ : AlgebraicGeometry.IsProper p_X := hProp_pX
    have hComp_X : CompactSpace ↥X :=
      @AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace _ _ p_X inferInstance hComp_Z
    have _ : AlgebraicGeometry.LocallyOfFiniteType g_Z := hLFT_gZ
    have hLFT_X : AlgebraicGeometry.LocallyOfFiniteType (p_X ≫ g_Z) := inferInstance
    exact hNoethOverV X hComp_X (p_X ≫ g_Z) hLFT_X

  
  
  
  have hFrac_equiv : ∀ {A B E : Type u} [CommRing A] [CommRing B] [Field E]
      (e : A ≃+* B) (φ_B : B →+* E),
      @IsFractionRing B _ E _ φ_B.toAlgebra →
      @IsFractionRing A _ E _ (φ_B.comp e.toRingHom).toAlgebra := by
    intro A B E _ _ _ e φ_B hFrac
    let _ : Algebra B E := φ_B.toAlgebra
    let _ : Algebra A E := (φ_B.comp e.toRingHom).toAlgebra
    have hφB_inj : Function.Injective φ_B :=
      @IsLocalization.injective B _ (nonZeroDivisors B) E _ φ_B.toAlgebra hFrac le_rfl
    have _ : Nontrivial B := ⟨⟨0, 1, fun h01 => zero_ne_one (α := E) (by simpa using congrArg φ_B h01)⟩⟩
    have _ : Nontrivial A := ⟨⟨0, 1, fun h01 => zero_ne_one (α := B) (by simpa using congrArg e h01)⟩⟩
    refine { map_units := ?_, surj := ?_, exists_of_eq := ?_ }
    · intro y
      have hy0 : y.1 ≠ 0 := nonZeroDivisors.ne_zero y.2
      have hey0 : e y.1 ≠ 0 := fun h => hy0 (e.injective (by simpa using h))
      have hφ0 : φ_B (e y.1) ≠ 0 := fun h => hey0 (hφB_inj (by simpa using h))
      exact isUnit_iff_ne_zero.mpr hφ0
    · intro z
      obtain ⟨⟨b, s⟩, hzs⟩ :=
        @IsLocalization.surj B _ (nonZeroDivisors B) E _ φ_B.toAlgebra hFrac z
      have hs_mem : e.symm s.1 ∈ nonZeroDivisors A := by
        rw [mem_nonZeroDivisors_iff]
        have hs_iff := mem_nonZeroDivisors_iff.mp s.2
        refine ⟨fun x hx => ?_, fun x hx => ?_⟩
        · have hex : s.1 * e x = 0 := by
            calc s.1 * e x = e (e.symm s.1) * e x := by rw [e.apply_symm_apply]
              _ = e (e.symm s.1 * x) := (map_mul e _ x).symm
              _ = 0 := by rw [hx, map_zero]
          exact e.injective (by simpa using hs_iff.1 (e x) hex)
        · have hex : e x * s.1 = 0 := by
            calc e x * s.1 = e x * e (e.symm s.1) := by rw [e.apply_symm_apply]
              _ = e (x * e.symm s.1) := (map_mul e x _).symm
              _ = 0 := by rw [hx, map_zero]
          exact e.injective (by simpa using hs_iff.2 (e x) hex)
      refine ⟨⟨e.symm b, ⟨e.symm s.1, hs_mem⟩⟩, ?_⟩
      change z * φ_B (e (e.symm s.1)) = φ_B (e (e.symm b))
      rw [e.apply_symm_apply, e.apply_symm_apply]
      exact hzs
    · intro x y hxy
      have hxy' : x = y := e.injective (hφB_inj hxy)
      exact ⟨⟨1, Submonoid.one_mem _⟩, by simp [hxy']⟩

  have hFrac_away : ∀ {R S E : Type u} [CommRing R] [IsDomain R]
      (r : R), r ≠ 0 → ∀ [CommRing S] (res : R →+* S),
      @IsLocalization.Away R _ r S _ res.toAlgebra →
      ∀ [Field E] (φ_S : S →+* E),
      @IsFractionRing S _ E _ φ_S.toAlgebra →
      @IsFractionRing R _ E _ (φ_S.comp res).toAlgebra := by
    intro R S E _ _ r hr _ res hLoc _ φ_S hFrac
    let _ : Algebra R S := res.toAlgebra
    let _ : Algebra S E := φ_S.toAlgebra
    let _ : Algebra R E := (φ_S.comp res).toAlgebra
    have hφS_inj : Function.Injective φ_S :=
      @IsLocalization.injective S _ (nonZeroDivisors S) E _ φ_S.toAlgebra hFrac le_rfl
    have _ : Nontrivial S := by
      refine ⟨⟨0, 1, fun h01 => zero_ne_one (α := E) ?_⟩⟩
      simpa using congrArg φ_S h01
    have hres_inj : Function.Injective res := by
      intro x y hxy
      obtain ⟨⟨_, k, rfl⟩, hk⟩ :=
        (@IsLocalization.eq_iff_exists R _ (Submonoid.powers r) S _ res.toAlgebra hLoc).mp hxy
      exact mul_left_cancel₀ (pow_ne_zero k hr) hk
    have hφR_inj : Function.Injective (φ_S.comp res) := hφS_inj.comp hres_inj
    refine { map_units := ?_, surj := ?_, exists_of_eq := ?_ }
    · intro y
      have hy0 : y.1 ≠ 0 := nonZeroDivisors.ne_zero y.2
      exact isUnit_iff_ne_zero.mpr (fun h => hy0 (hφR_inj (h.trans (map_zero _).symm)))
    · intro z
      obtain ⟨⟨b, s⟩, hzs⟩ :=
        @IsLocalization.surj S _ (nonZeroDivisors S) E _ φ_S.toAlgebra hFrac z
      obtain ⟨⟨a₀, ⟨_, k, rfl⟩⟩, ha₀⟩ :=
        @IsLocalization.surj R _ (Submonoid.powers r) S _ res.toAlgebra hLoc b
      obtain ⟨⟨b₀, ⟨_, l, rfl⟩⟩, hb₀⟩ :=
        @IsLocalization.surj R _ (Submonoid.powers r) S _ res.toAlgebra hLoc s.1
      have hs0 : s.1 ≠ 0 := nonZeroDivisors.ne_zero s.2
      have hur : IsUnit (res r) :=
        @IsLocalization.map_units R _ (Submonoid.powers r) S _ res.toAlgebra hLoc
          ⟨r, Submonoid.mem_powers r⟩
      have hb₀_ne : b₀ ≠ 0 := by
        intro h0
        have hb₀_zero : s.1 * (res r) ^ l = 0 := by
          calc s.1 * (res r) ^ l = s.1 * res (r ^ l) := by rw [map_pow]
            _ = res b₀ := hb₀
            _ = 0 := by rw [h0, map_zero]
        exact hs0 ((hur.pow l).mul_left_eq_zero.mp hb₀_zero)
      have hd_mem : b₀ * r ^ k ∈ nonZeroDivisors R :=
        mem_nonZeroDivisors_of_ne_zero (mul_ne_zero hb₀_ne (pow_ne_zero k hr))
      refine ⟨⟨a₀ * r ^ l, ⟨b₀ * r ^ k, hd_mem⟩⟩, ?_⟩
      change z * φ_S (res (b₀ * r ^ k)) = φ_S (res (a₀ * r ^ l))
      have hzs' : z * φ_S s.1 = φ_S b := hzs
      have ha₀' : φ_S (res a₀) = φ_S b * φ_S (res r) ^ k := by
        have h1 : res a₀ = b * res (r ^ k) := ha₀.symm
        rw [h1, map_mul, map_pow, map_pow]
      have hb₀' : φ_S (res b₀) = φ_S s.1 * φ_S (res r) ^ l := by
        have h1 : res b₀ = s.1 * res (r ^ l) := hb₀.symm
        rw [h1, map_mul, map_pow, map_pow]
      simp only [map_mul, map_pow, ha₀', hb₀']
      calc z * (φ_S s.1 * φ_S (res r) ^ l * φ_S (res r) ^ k)
          = (z * φ_S s.1) * φ_S (res r) ^ l * φ_S (res r) ^ k := by ring
        _ = φ_S b * φ_S (res r) ^ l * φ_S (res r) ^ k := by rw [hzs']
        _ = φ_S b * φ_S (res r) ^ k * φ_S (res r) ^ l := by ring
    · intro x y hxy
      exact ⟨⟨1, Submonoid.one_mem _⟩, by simp [hφR_inj hxy]⟩

  have hPillar2 : ∃ (η_UK : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ U_K.toScheme)
      (φ_KF : K →+* F),
      η_UK ≫ ι_Z = η_Z ∧
      IsSchemeFunctionField U_K.toScheme F η_UK ∧
      IsSchemeFunctionField M F (η_UK ≫ ι_M) ∧
      (∀ c : ↥V, φ_KF (V.subtype c) = (AlgebraicGeometry.Spec.preimage (η_Z ≫ g_Z)).hom c) ∧
      (letI : Algebra K F := φ_KF.toAlgebra
       Algebra.EssFiniteType K F ∧ Algebra.trdeg K F ≤ 1) := by
    have _ : AlgebraicGeometry.IsOpenImmersion ι_Z :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (P := @AlgebraicGeometry.IsOpenImmersion) hPb_Z.flip hOpenη
    have _ : AlgebraicGeometry.IsOpenImmersion ι_M :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (P := @AlgebraicGeometry.IsOpenImmersion) hPb_M.flip hOpenη
    have hUK_sch_ne : Nonempty ↥U_K.toScheme := hUK
    obtain ⟨x₀_UK⟩ := hUK_sch_ne
    obtain ⟨W₀, hW₀, hx₀_W₀, hW₀_sub⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := ι_Z.opensRange)
        (x := ι_Z.base x₀_UK) ⟨x₀_UK, rfl⟩
    obtain ⟨φ₀, _, hSpec₀⟩ := hFunc_Z W₀ hW₀ ⟨⟨ι_Z.base x₀_UK, hx₀_W₀⟩⟩
    have hRange_ηZ : Set.range η_Z.base ⊆ Set.range ι_Z.base := by
      rintro _ ⟨pt, rfl⟩
      have hmem : η_Z.base pt ∈ (W₀ : Set ↥Z) := by
        rw [← hSpec₀]
        have h_eq : Set.range hW₀.fromSpec.base = (W₀ : Set ↥Z) := hW₀.range_fromSpec
        rw [← h_eq]
        exact ⟨(AlgebraicGeometry.Spec.map φ₀).base pt, rfl⟩
      exact hW₀_sub hmem
    let η_UK : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ U_K.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift ι_Z η_Z hRange_ηZ
    have hηUK_Z : η_UK ≫ ι_Z = η_Z :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac ι_Z η_Z hRange_ηZ
    have hFunc_UK : IsSchemeFunctionField U_K.toScheme F η_UK := by
      intro U hU hUne
      let W : Z.Opens := ι_Z.opensFunctor.obj U
      have hW : AlgebraicGeometry.IsAffineOpen W := hU.image_of_isOpenImmersion ι_Z
      obtain ⟨u₀⟩ := hUne
      have hWne : Nonempty ↥W := ⟨⟨ι_Z.base u₀.1, ⟨u₀.1, u₀.2, rfl⟩⟩⟩
      obtain ⟨φ_W, hFrac_W, hSpec_W⟩ := hFunc_Z W hW hWne
      have h_le : U ≤ (TopologicalSpace.Opens.map ι_Z.base).obj W := fun z hz => ⟨z, hz, rfl⟩
      have hW_sub : W ≤ ι_Z.opensRange := by
        rintro _ ⟨z, _, rfl⟩
        exact ⟨z, rfl⟩
      have h_pre_eq : U = (TopologicalSpace.Opens.map ι_Z.base).obj W := by
        ext z
        exact ⟨fun hz => ⟨z, hz, rfl⟩, fun ⟨w, hw, hwz⟩ => ι_Z.isOpenEmbedding.injective hwz ▸ hw⟩
      have _ : IsIso (ι_Z.app W) := ι_Z.isIso_app W hW_sub
      have h_appLE_eq : ι_Z.appLE W U h_le =
          ι_Z.app W ≫ U_K.toScheme.presheaf.map (CategoryTheory.eqToHom h_pre_eq).op := by
        change ι_Z.app W ≫ U_K.toScheme.presheaf.map (CategoryTheory.homOfLE h_le).op = _
        rw [Subsingleton.elim (CategoryTheory.homOfLE h_le) (CategoryTheory.eqToHom h_pre_eq)]
      have _ : IsIso (ι_Z.appLE W U h_le) := by
        rw [h_appLE_eq]
        infer_instance
      let e := asIso (ι_Z.appLE W U h_le)
      let φ_U : U_K.toScheme.presheaf.obj (Opposite.op U) ⟶ CommRingCat.of F := e.inv ≫ φ_W
      have hSpec_e : AlgebraicGeometry.Spec.map e.hom ≫ hW.fromSpec = hU.fromSpec ≫ ι_Z :=
        AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec ι_Z hW hU h_le
      have hSpec_U : AlgebraicGeometry.Spec.map φ_U ≫ hU.fromSpec = η_UK := by
        apply (cancel_mono ι_Z).mp
        have h_inv_hom : AlgebraicGeometry.Spec.map e.inv ≫ AlgebraicGeometry.Spec.map e.hom = 𝟙 _ := by
          rw [← AlgebraicGeometry.Spec.map_comp, e.hom_inv_id, AlgebraicGeometry.Spec.map_id]
        calc (AlgebraicGeometry.Spec.map φ_U ≫ hU.fromSpec) ≫ ι_Z
            = AlgebraicGeometry.Spec.map φ_W ≫ AlgebraicGeometry.Spec.map e.inv ≫ (hU.fromSpec ≫ ι_Z) := by
              simp [φ_U, AlgebraicGeometry.Spec.map_comp, Category.assoc]
          _ = AlgebraicGeometry.Spec.map φ_W ≫
                (AlgebraicGeometry.Spec.map e.inv ≫ AlgebraicGeometry.Spec.map e.hom) ≫ hW.fromSpec := by
              rw [← hSpec_e]
              simp [Category.assoc]
          _ = AlgebraicGeometry.Spec.map φ_W ≫ hW.fromSpec := by
              rw [h_inv_hom, Category.id_comp]
          _ = η_UK ≫ ι_Z := by rw [hSpec_W, hηUK_Z]
      have hFrac_U : @IsFractionRing ↑(U_K.toScheme.presheaf.obj (Opposite.op U)) _ F _
          φ_U.hom.toAlgebra := by
        have hφU_eq : φ_U.hom = φ_W.hom.comp e.symm.commRingCatIsoToRingEquiv.toRingHom := rfl
        rw [hφU_eq]
        exact hFrac_equiv e.symm.commRingCatIsoToRingEquiv φ_W.hom hFrac_W
      exact ⟨φ_U, hFrac_U, hSpec_U⟩
    have hFunc_M : IsSchemeFunctionField M F (η_UK ≫ ι_M) := by
      intro U hU hUne
      have hIrredM : IrreducibleSpace ↥M :=
        @AlgebraicGeometry.irreducibleSpace_of_isIntegral M hInt_M
      have _ : PreirreducibleSpace ↥M := hIrredM.toPreirreducibleSpace
      have hU_set_ne : (U : Set ↥M).Nonempty := by
        obtain ⟨u₀⟩ := hUne; exact ⟨u₀.1, u₀.2⟩
      have hRange_ne : (ι_M.opensRange : Set ↥M).Nonempty :=
        ⟨ι_M.base x₀_UK, ⟨x₀_UK, rfl⟩⟩
      obtain ⟨y₀, hy₀U, hy₀R⟩ :=
        nonempty_preirreducible_inter U.isOpen ι_M.opensRange.isOpen hU_set_ne hRange_ne
      obtain ⟨r, hBr_le, hy₀Br⟩ :=
        hU.exists_basicOpen_le (V := U ⊓ ι_M.opensRange) ⟨y₀, ⟨hy₀U, hy₀R⟩⟩ hy₀U
      have _ : IsDomain ↑(M.presheaf.obj (Opposite.op U)) :=
        @AlgebraicGeometry.IsIntegral.component_integral M hInt_M U hUne
      have hr_ne : r ≠ 0 := by
        intro hr0
        rw [hr0, AlgebraicGeometry.Scheme.basicOpen_zero] at hy₀Br
        exact hy₀Br
      let B_r : M.Opens := M.basicOpen r
      have hBr : AlgebraicGeometry.IsAffineOpen B_r := hU.basicOpen r
      let V_K : U_K.toScheme.Opens := (TopologicalSpace.Opens.map ι_M.base).obj B_r
      have hBr_sub : (B_r : Set ↥M) ⊆ Set.range ι_M.base :=
        hBr_le.trans inf_le_right
      have h_img : ι_M.opensFunctor.obj V_K = B_r := by
        ext z
        exact ⟨fun ⟨w, hw, hwz⟩ => hwz ▸ hw,
          fun hz => let ⟨w, hw⟩ := hBr_sub hz; ⟨w, show ι_M.base w ∈ B_r by rwa [hw], hw⟩⟩
      have hVK : AlgebraicGeometry.IsAffineOpen V_K :=
        (ι_M.isAffineOpen_iff_of_isOpenImmersion (U := V_K)).mp (h_img.symm ▸ hBr)
      obtain ⟨x_y₀, hx_y₀⟩ := hBr_sub hy₀Br
      have hVK_ne : Nonempty ↥V_K :=
