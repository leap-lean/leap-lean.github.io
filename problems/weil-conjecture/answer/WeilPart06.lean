      have himg : (⋃ i ∈ ℰ, j_L.base '' i) = Set.range j_L.base := by
        ext z
        simp only [Set.mem_iUnion, Set.mem_image, Set.mem_range]
        constructor
        · rintro ⟨_, _, y, _, rfl⟩
          exact ⟨y, rfl⟩
        · rintro ⟨y, rfl⟩
          exact ⟨irreducibleComponent y, irreducibleComponent_mem_irreducibleComponents y,
            y, mem_irreducibleComponent, rfl⟩
      rw [himg, hDense.closure_range]
    have hCov_Xk : (⋃ E ∈ ℰ, B E) = Set.univ := by
      ext q
      simp only [Set.mem_iUnion, Set.mem_univ, iff_true, B, Set.mem_preimage]
      have hq : i_k.base q ∈ (Set.univ : Set ↥X) := trivial
      rw [← hCov_X, Set.mem_iUnion₂] at hq
      exact hq
    obtain ⟨E₀_ne, hE₀_ne⟩ := hℰ_ne
    obtain ⟨q_init, _⟩ := (hComp E₀_ne hE₀_ne).nonempty
    have hInter_spec : ∀ E₁ ∈ ℰ, ∀ E₂ ∈ ℰ, (E₁ ∩ E₂).Nonempty → (B E₁ ∩ B E₂).Nonempty := by
      intro E₁ _ E₂ _ ⟨y₀, hy₁, hy₂⟩
      let Z₁₂ : Set ↥X := closure (j_L.base '' E₁) ∩ closure (j_L.base '' E₂)
      have hZ₁₂_cl : IsClosed Z₁₂ := isClosed_closure.inter isClosed_closure
      have hz₀_mem : j_L.base y₀ ∈ Z₁₂ :=
        ⟨subset_closure ⟨y₀, hy₁, rfl⟩, subset_closure ⟨y₀, hy₂, rfl⟩⟩
      have hClosedImg : IsClosed (p.base '' Z₁₂) :=
        p.isProperMap.isClosedMap Z₁₂ hZ₁₂_cl
      have hFieldBot : (p_L.base y₀).asIdeal = ⊥ := by
        rw [Submodule.eq_bot_iff]
        intro c hc
        by_contra hc_ne
        exact (p_L.base y₀).isPrime.ne_top
          (Ideal.eq_top_of_isUnit_mem _ hc (isUnit_iff_ne_zero.mpr hc_ne))
      have hBot_in_img : (⟨⊥, inferInstance⟩ : PrimeSpectrum R) ∈ p.base '' Z₁₂ := by
        refine ⟨j_L.base y₀, hz₀_mem, ?_⟩
        have hcomm_pt : p.base (j_L.base y₀) = η_R.base (p_L.base y₀) := by
          change (j_L ≫ p).base y₀ = (p_L ≫ η_R).base y₀
          rw [CategoryTheory.Limits.pullback.condition]
        rw [hcomm_pt]
        apply PrimeSpectrum.ext
        change Ideal.comap (algebraMap R L) (p_L.base y₀).asIdeal = ⊥
        rw [hFieldBot]
        exact Ideal.comap_bot_of_injective (algebraMap R L) (IsFractionRing.injective R L)
      obtain ⟨s_zl, hs_zl⟩ :=
        (PrimeSpectrum.isClosed_iff_zeroLocus (p.base '' Z₁₂ : Set (PrimeSpectrum R))).mp hClosedImg
      have hs_zero : ∀ r ∈ s_zl, r = 0 := by
        intro r hr
        have hbot_zl : (⟨⊥, inferInstance⟩ : PrimeSpectrum R) ∈ PrimeSpectrum.zeroLocus s_zl :=
          hs_zl ▸ hBot_in_img
        exact hbot_zl hr
      let pt_k : ↥(AlgebraicGeometry.Spec (CommRingCat.of k_res)) :=
        (⟨⊥, inferInstance⟩ : PrimeSpectrum k_res)
      have hsk_mem : s_k.base pt_k ∈ p.base '' Z₁₂ := by
        change (s_k.base pt_k : PrimeSpectrum R) ∈ (p.base '' Z₁₂ : Set (PrimeSpectrum R))
        rw [hs_zl]
        intro r hr
        rw [hs_zero r hr]
        exact (s_k.base pt_k).asIdeal.zero_mem
      obtain ⟨w, hw_Z₁₂, hw_eq⟩ := hsk_mem
      have hw_range : w ∈ Set.range i_k.base := by
        rw [AlgebraicGeometry.Scheme.Pullback.range_fst]
        exact ⟨pt_k, hw_eq.symm⟩
      obtain ⟨q, rfl⟩ := hw_range
      exact ⟨q, hw_Z₁₂.1, hw_Z₁₂.2⟩
    rw [connectedSpace_iff_clopen]
    refine ⟨⟨q_init⟩, ?_⟩
    intro U hU_clopen
    by_cases hU_ne : U.Nonempty
    · right
      obtain ⟨q₀, hq₀U⟩ := hU_ne
      have hq₀_cov : q₀ ∈ ⋃ E ∈ ℰ, B E := hCov_Xk.symm ▸ Set.mem_univ q₀
      rw [Set.mem_iUnion₂] at hq₀_cov
      obtain ⟨E₀, hE₀_ℰ, hq₀B₀⟩ := hq₀_cov
      have hDichot : ∀ E ∈ ℰ, B E ⊆ U ∨ B E ⊆ Uᶜ := by
        intro E hE
        by_cases hEU : (B E ∩ U).Nonempty
        · exact Or.inl ((hComp E hE).isPreconnected.subset_isClopen hU_clopen hEU)
        · exact Or.inr (fun q hqB hqU => hEU ⟨q, hqB, hqU⟩)
      let ℐ₁ : Set (Set ↥X_L) := {E ∈ ℰ | B E ⊆ U}
      let ℐ₂ : Set (Set ↥X_L) := {E ∈ ℰ | B E ⊆ Uᶜ}
      have hE₀_ℐ₁ : E₀ ∈ ℐ₁ :=
        ⟨hE₀_ℰ, (hComp E₀ hE₀_ℰ).isPreconnected.subset_isClopen hU_clopen ⟨q₀, hq₀B₀, hq₀U⟩⟩
      by_cases hℐ₂_ne : ℐ₂.Nonempty
      · exfalso
        obtain ⟨E₂₀, hE₂₀_ℰ, hE₂₀_sub⟩ := hℐ₂_ne
        let F₁ : Set ↥X_L := ⋃ E ∈ ℐ₁, E
        let F₂ : Set ↥X_L := ⋃ E ∈ ℐ₂, E
        have hF₁_cl : IsClosed F₁ :=
          (hℰ_fin.subset (fun _ h => h.1)).isClosed_biUnion
            (fun E h => isClosed_of_mem_irreducibleComponents E h.1)
        have hF₂_cl : IsClosed F₂ :=
          (hℰ_fin.subset (fun _ h => h.1)).isClosed_biUnion
            (fun E h => isClosed_of_mem_irreducibleComponents E h.1)
        have hF_union : F₁ ∪ F₂ = Set.univ := by
          ext y
          simp only [Set.mem_union, Set.mem_univ, iff_true]
          have hy : y ∈ ⋃ E ∈ ℰ, E := hℰ_cov.symm ▸ Set.mem_univ y
          rw [Set.mem_iUnion₂] at hy
          obtain ⟨E, hE_ℰ, hyE⟩ := hy
          rcases hDichot E hE_ℰ with hSubU | hSubUc
          · exact Or.inl (Set.mem_biUnion ⟨hE_ℰ, hSubU⟩ hyE)
          · exact Or.inr (Set.mem_biUnion ⟨hE_ℰ, hSubUc⟩ hyE)
        obtain ⟨y₁, hy₁_E₀⟩ := hE₀_ℰ.1.nonempty
        have hF₁_ne : F₁.Nonempty := ⟨y₁, Set.mem_biUnion hE₀_ℐ₁ hy₁_E₀⟩
        obtain ⟨y₂, hy₂_E₂₀⟩ := hE₂₀_ℰ.1.nonempty
        have hF₂_ne : F₂.Nonempty := ⟨y₂, Set.mem_biUnion ⟨hE₂₀_ℰ, hE₂₀_sub⟩ hy₂_E₂₀⟩
        have hF_inter : (F₁ ∩ F₂).Nonempty := by
          by_contra hNotNe
          have hDisj : F₁ ∩ F₂ = ∅ := Set.not_nonempty_iff_eq_empty.mp hNotNe
          have hCompl : F₁ᶜ = F₂ := by
            ext y
            constructor
            · intro hy_nF₁
              have hy_u : y ∈ F₁ ∪ F₂ := hF_union.symm ▸ Set.mem_univ y
              exact hy_u.resolve_left hy_nF₁
            · intro hy_F₂ hy_F₁
              have : y ∈ (∅ : Set ↥X_L) := hDisj ▸ ⟨hy_F₁, hy_F₂⟩
              exact this
          have hF₁_open : IsOpen F₁ := isClosed_compl_iff.mp (hCompl.symm ▸ hF₂_cl)
          rcases (connectedSpace_iff_clopen.mp hConn_L).2 F₁ ⟨hF₁_cl, hF₁_open⟩ with hEmp | hUniv
          · obtain ⟨z, hz⟩ := hF₁_ne
            exact Set.notMem_empty z (hEmp ▸ hz)
          · obtain ⟨z, hz⟩ := hF₂_ne
            have hz₁ : z ∈ F₁ := hUniv.symm ▸ Set.mem_univ z
            have : z ∈ (∅ : Set ↥X_L) := hDisj ▸ ⟨hz₁, hz⟩
            exact this
        obtain ⟨y₀, hy₀₁, hy₀₂⟩ := hF_inter
        rw [Set.mem_iUnion₂] at hy₀₁ hy₀₂
        obtain ⟨E₁, hE₁_ℐ₁, hy₀_E₁⟩ := hy₀₁
        obtain ⟨E₂, hE₂_ℐ₂, hy₀_E₂⟩ := hy₀₂
        obtain ⟨q, hq₁, hq₂⟩ := hInter_spec E₁ hE₁_ℐ₁.1 E₂ hE₂_ℐ₂.1 ⟨y₀, hy₀_E₁, hy₀_E₂⟩
        exact hE₂_ℐ₂.2 hq₂ (hE₁_ℐ₁.2 hq₁)
      · apply Set.eq_univ_of_univ_subset
        rw [← hCov_Xk]
        intro q hq
        rw [Set.mem_iUnion₂] at hq
        obtain ⟨E, hE_ℰ, hqBE⟩ := hq
        rcases hDichot E hE_ℰ with hSubU | hSubUc
        · exact hSubU hqBE
        · exfalso
          exact hℐ₂_ne ⟨E, hE_ℰ, hSubUc⟩
    · left
      exact Set.not_nonempty_iff_eq_empty.mp hU_ne
  have : Finite (PrimeSpectrum ↥V) := Set.finite_univ_iff.mp hPkg.1
  have : WellFoundedLT (PrimeSpectrum ↥V) := Finite.to_wellFoundedLT
  have hInd : ∀ (p : PrimeSpectrum ↥V), p.asIdeal ≠ ⊥ →
      ConnectedSpace
        ↥(CategoryTheory.Limits.pullback g
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap ↥V p.asIdeal.ResidueField)))) := by
    intro p
    induction p using WellFoundedLT.induction with
    | ind p IH =>
      intro hp_ne
      let 𝒯 : Set (PrimeSpectrum ↥V) := {q | q.asIdeal ≠ ⊥ ∧ q < p}
      by_cases h𝒯 : 𝒯.Nonempty
      · have h𝒯_fin : 𝒯.Finite := hPkg.1.subset (Set.subset_univ 𝒯)
        obtain ⟨q₀, hq₀_max⟩ := h𝒯_fin.exists_maximal h𝒯
        have hq₀_ne : q₀.asIdeal ≠ ⊥ := hq₀_max.1.1
        have hq₀_lt : q₀ < p := hq₀_max.1.2
        have hq₀_ge : ∀ q ∈ 𝒯, q ≤ q₀ := by
          intro q hq
          rcases hTot q.asIdeal q₀.asIdeal with hle | hle
          · exact hle
          · exact hq₀_max.2 hq hle
        have hConn_q₀ : ConnectedSpace
            ↥(CategoryTheory.Limits.pullback g
              (AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (algebraMap ↥V q₀.asIdeal.ResidueField)))) :=
          IH q₀ hq₀_lt hq₀_ne
        have hAdj : ∀ (Q : Ideal ↥V) [Q.IsPrime],
            q₀.asIdeal ≤ Q → Q ≤ p.asIdeal → Q = q₀.asIdeal ∨ Q = p.asIdeal := by
          intro Q _ hle₀ hlep
          rcases eq_or_lt_of_le hlep with rfl | hlt_p
          · exact Or.inr rfl
          · left
            have hQ_ne : Q ≠ ⊥ := fun h0 => hq₀_ne (le_bot_iff.mp (h0 ▸ hle₀))
            have hQ_mem : (⟨Q, inferInstance⟩ : PrimeSpectrum ↥V) ∈ 𝒯 := ⟨hQ_ne, hlt_p⟩
            exact le_antisymm (hq₀_ge ⟨Q, inferInstance⟩ hQ_mem) hle₀
        obtain ⟨R_sub, instCR, instDom, instVal, φ_sub, instAlg, instIsFrac, e_sub,
          hMaxNe, hPrimes, hAlgRes, hFrac_comp, he_sub⟩ :=
          hStepSub q₀.asIdeal p.asIdeal hq₀_ne hq₀_lt hAdj
        let _ : CommRing R_sub := instCR
        let _ : IsDomain R_sub := instDom
        let _ : ValuationRing R_sub := instVal
        let L := q₀.asIdeal.ResidueField
        let _ : Algebra R_sub L := instAlg
        have : IsFractionRing R_sub L := instIsFrac
        have : IsAlgClosed L := hPkg.2.2.2.2.1 q₀.asIdeal hq₀_ne
        let u_sub := AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_sub)
        let X_sub := CategoryTheory.Limits.pullback g u_sub
        let p_sub := CategoryTheory.Limits.pullback.snd g u_sub
        obtain ⟨⟨ιP_sub, hCl_sub, hComm_sub⟩, hIso_sub⟩ :=
          hProjBC ↥V R_sub φ_sub Y g ιP hComm
        have : AlgebraicGeometry.IsClosedImmersion ιP_sub := hCl_sub
        obtain ⟨iso_gen⟩ := hIso_sub L L (algebraMap R_sub L) (algebraMap ↥V L)
          (RingEquiv.refl L) (by
            rw [RingEquiv.toRingHom_refl, RingHom.id_comp]
            exact hFrac_comp)
        have hIsoGen_surj : Function.Surjective iso_gen.inv.base :=
          (TopCat.homeoOfIso (AlgebraicGeometry.Scheme.forgetToTop.mapIso iso_gen.symm)).surjective
        have hConn_L : ConnectedSpace
            ↥(CategoryTheory.Limits.pullback p_sub
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_sub L)))) :=
          hIsoGen_surj.connectedSpace iso_gen.inv.continuous
        obtain ⟨iso_sp⟩ := hIso_sub
          (IsLocalRing.maximalIdeal R_sub).ResidueField p.asIdeal.ResidueField
          (algebraMap R_sub (IsLocalRing.maximalIdeal R_sub).ResidueField)
          (algebraMap ↥V p.asIdeal.ResidueField) e_sub he_sub
        have hDim_k : topologicalKrullDim
            ↥(CategoryTheory.Limits.pullback p_sub
              (AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom
                  (algebraMap R_sub (IsLocalRing.maximalIdeal R_sub).ResidueField)))) ≤
            (1 : WithBot ℕ∞) :=
          le_trans
            (TopCat.homeoOfIso
              (AlgebraicGeometry.Scheme.forgetToTop.mapIso iso_sp)).isInducing.topologicalKrullDim_le
            (hDim p.asIdeal)
        obtain ⟨⟨ιP_L, hCl_L, hComm_L⟩, _⟩ :=
          hProjBC R_sub L (algebraMap R_sub L) X_sub p_sub ιP_sub hComm_sub
        have : AlgebraicGeometry.IsClosedImmersion ιP_L := hCl_L
        obtain ⟨hNoeth_PL, hSec_PL⟩ := hProjAlg L
        have hNoeth_XL : TopologicalSpace.NoetherianSpace
            ↥(CategoryTheory.Limits.pullback p_sub
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_sub L)))) :=
          ιP_L.isClosedEmbedding.toIsInducing.noetherianSpace
        have hRatPt_XL : ∀ (Z : AlgebraicGeometry.Scheme.{u}) [Nonempty ↥Z]
            (ιZ : Z ⟶ CategoryTheory.Limits.pullback p_sub
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_sub L))))
            [AlgebraicGeometry.IsClosedImmersion ιZ],
            ∃ (α : AlgebraicGeometry.Spec (CommRingCat.of L) ⟶ Z),
              α ≫ ιZ ≫
                CategoryTheory.Limits.pullback.snd p_sub
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_sub L))) =
                𝟙 (AlgebraicGeometry.Spec (CommRingCat.of L)) := by
          intro Z _ ιZ _
          obtain ⟨α, hα⟩ := hSec_PL Z (ιZ ≫ ιP_L)
          refine ⟨α, ?_⟩
          calc α ≫ ιZ ≫ CategoryTheory.Limits.pullback.snd p_sub
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_sub L)))
              = α ≫ ιZ ≫ (ιP_L ≫ (weilProjectiveSpaceOver L N).hom) := by rw [hComm_L]
            _ = α ≫ (ιZ ≫ ιP_L) ≫ (weilProjectiveSpaceOver L N).hom := by
                simp [Category.assoc]
            _ = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of L)) := hα
        have hDense_XL := hFlatDense R_sub L X_sub p_sub
        have : ConnectedSpace
            ↥(CategoryTheory.Limits.pullback p_sub
              (AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom
                  (algebraMap R_sub (IsLocalRing.maximalIdeal R_sub).ResidueField)))) :=
          hCrux R_sub L hMaxNe hPrimes hAlgRes X_sub p_sub ιP_sub hComm_sub
            hDense_XL hNoeth_XL hRatPt_XL hConn_L hDim_k
        have hIsoSp_surj : Function.Surjective iso_sp.hom.base :=
          (TopCat.homeoOfIso (AlgebraicGeometry.Scheme.forgetToTop.mapIso iso_sp)).surjective
        exact hIsoSp_surj.connectedSpace iso_sp.hom.continuous
      · have hMin : ∀ (Q : Ideal ↥V) [Q.IsPrime], Q < p.asIdeal → Q = ⊥ := by
          intro Q _ hlt
          by_contra hne
          exact h𝒯 ⟨⟨Q, inferInstance⟩, hne, hlt⟩
        obtain ⟨ϖ₁, instDom₁, instVal₁, e₁, hMaxNe₁, hPrimes₁, hAlgRes₁, he₁⟩ :=
          hStepBase p.asIdeal hp_ne hMin
        let R₁ := Localization.Away ϖ₁
        let _ : IsDomain R₁ := instDom₁
        let _ : ValuationRing R₁ := instVal₁
        let u₁ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V R₁))
        have : AlgebraicGeometry.IsOpenImmersion u₁ :=
          AlgebraicGeometry.IsOpenImmersion.of_isLocalization ϖ₁
        let Y₁ := CategoryTheory.Limits.pullback g u₁
        let fst₁ := CategoryTheory.Limits.pullback.fst g u₁
        let p₁ := CategoryTheory.Limits.pullback.snd g u₁
        let σ₁ : AlgebraicGeometry.Spec (CommRingCat.of R₁) ⟶ Y₁ :=
          CategoryTheory.Limits.pullback.lift (u₁ ≫ τ₀)
            (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of R₁)))
            (by rw [Category.assoc, hτ₀, Category.comp_id, Category.id_comp])
        have hσ₁ : σ₁ ≫ p₁ = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of R₁)) :=
          CategoryTheory.Limits.pullback.lift_snd _ _ _
        have : Nonempty ↥Y₁ := ⟨σ₁.base (⟨⊥, inferInstance⟩ : PrimeSpectrum R₁)⟩
        have : AlgebraicGeometry.IsIntegral Y₁ :=
          AlgebraicGeometry.isIntegral_of_isOpenImmersion fst₁
        have : AlgebraicGeometry.Surjective p₁ :=
          ⟨fun y => ⟨σ₁.base y, by change (σ₁ ≫ p₁).base y = y; rw [hσ₁]; rfl⟩⟩
        have hBij₁ : Function.Bijective (p₁.appTop).hom :=
          hAppTop R₁ Y₁ p₁ σ₁ hσ₁
        obtain ⟨⟨ιP₁, hCl₁, hComm₁⟩, hIso₁⟩ :=
          hProjBC ↥V R₁ (algebraMap ↥V R₁) Y g ιP hComm
        have : AlgebraicGeometry.IsClosedImmersion ιP₁ := hCl₁
        obtain ⟨iso₁⟩ := hIso₁
          (IsLocalRing.maximalIdeal R₁).ResidueField p.asIdeal.ResidueField
          (algebraMap R₁ (IsLocalRing.maximalIdeal R₁).ResidueField)
          (algebraMap ↥V p.asIdeal.ResidueField) e₁ he₁
        have hDim₁ : topologicalKrullDim
            ↥(CategoryTheory.Limits.pullback p₁
              (AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom
                  (algebraMap R₁ (IsLocalRing.maximalIdeal R₁).ResidueField)))) ≤
            (1 : WithBot ℕ∞) :=
          le_trans
            (TopCat.homeoOfIso
              (AlgebraicGeometry.Scheme.forgetToTop.mapIso iso₁)).isInducing.topologicalKrullDim_le
            (hDim p.asIdeal)
        have : ConnectedSpace
            ↥(CategoryTheory.Limits.pullback p₁
              (AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom
                  (algebraMap R₁ (IsLocalRing.maximalIdeal R₁).ResidueField)))) :=
          hHtOne R₁ hMaxNe₁ hPrimes₁ hAlgRes₁ N Y₁ p₁ hBij₁ ιP₁ hComm₁ hDim₁
        have hIso₁_surj : Function.Surjective iso₁.hom.base :=
          (TopCat.homeoOfIso (AlgebraicGeometry.Scheme.forgetToTop.mapIso iso₁)).surjective
        exact hIso₁_surj.connectedSpace iso₁.hom.continuous
  exact hInd ⟨P, inferInstance⟩ hP

theorem weil_proper_scheme_connected_baseChange_of_isAlgClosed (k₀ : Type u) [Field k₀] [IsAlgClosed k₀]
    (K' : Type u) [Field K']
    (φ : k₀ →+* K')
    (Y₀ : AlgebraicGeometry.Scheme.{u})
    (p₀ : Y₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of k₀))
    [AlgebraicGeometry.IsProper p₀]
    (hConn₀ : ConnectedSpace ↥Y₀) :
    ConnectedSpace
      ↥(CategoryTheory.Limits.pullback p₀
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ))) :=
by
  
  have hs1 : ∃ (p : ℕ) (U : Fin p → Y₀.Opens),
      (∀ α : Fin p, AlgebraicGeometry.IsAffineOpen (U α)) ∧
      (∀ α β : Fin p, AlgebraicGeometry.IsAffineOpen (U α ⊓ U β)) ∧
      ((⋃ α : Fin p, (U α : Set ↥Y₀)) = Set.univ) ∧
      (∀ (e₀ : ∀ α : Fin p, ↑(Y₀.presheaf.obj (Opposite.op (U α)))),
        (∀ α : Fin p, IsIdempotentElem (e₀ α)) →
        (∀ α β : Fin p,
          (Y₀.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U α ⊓ U β ≤ U α)).op).hom (e₀ α) =
            (Y₀.presheaf.map (CategoryTheory.homOfLE (inf_le_right : U α ⊓ U β ≤ U β)).op).hom (e₀ β)) →
        ∀ α₁ α₂ : Fin p, e₀ α₁ ≠ 0 → 1 - e₀ α₂ ≠ 0 → False) := by
    classical
    have _ : CompactSpace ↥Y₀ := AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace p₀
    have hSep_term : AlgebraicGeometry.IsSeparated (CategoryTheory.Limits.terminal.from Y₀) := by
      have h1 : AlgebraicGeometry.IsSeparated
          (CategoryTheory.Limits.terminal.from (AlgebraicGeometry.Spec (CommRingCat.of k₀))) :=
        AlgebraicGeometry.Scheme.IsSeparated.isSeparated_terminal_from
      have h2 : p₀ ≫ CategoryTheory.Limits.terminal.from
          (AlgebraicGeometry.Spec (CommRingCat.of k₀)) =
          CategoryTheory.Limits.terminal.from Y₀ :=
        CategoryTheory.Limits.terminal.hom_ext _ _
      rw [← h2]
      exact CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.IsSeparated) p₀ _
