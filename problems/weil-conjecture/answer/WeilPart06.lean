            rw [← hSpec_c a]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (c_V a) ≫ ιP'.app U_a) :=
            (AlgebraicGeometry.Spec.map_comp _ _).symm
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V A_a)) := by
            rw [hComp_hom]
    have hDense_η : DenseRange ⇑η_Y := AlgebraicGeometry.IsDominant.denseRange (f := η_Y)
    have hInter_ne : ((Y_a : Set ↥Y) ∩ Set.range ⇑η_Y).Nonempty :=
      hDense_η.inter_open_nonempty (Y_a : Set ↥Y) Y_a.isOpen ⟨fst_Q.base z, hz_a⟩
    obtain ⟨_, hy_Ya, pt₀, rfl⟩ := hInter_ne
    have hRange_η : Set.range ⇑η_Y ⊆ Set.range ⇑hAffYa.fromSpec := by
      rw [hAffYa.range_fromSpec]
      rintro _ ⟨pt, rfl⟩
      have hpt : pt = pt₀ := Subsingleton.elim (α := PrimeSpectrum F) pt pt₀
      rw [hpt]
      exact hy_Ya
    have : AlgebraicGeometry.IsOpenImmersion hAffYa.fromSpec := hAffYa.isOpenImmersion_fromSpec
    let η_tilde : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶
        AlgebraicGeometry.Spec (Y.presheaf.obj (Opposite.op Y_a)) :=
      AlgebraicGeometry.IsOpenImmersion.lift hAffYa.fromSpec η_Y hRange_η
    have hη_fac : η_tilde ≫ hAffYa.fromSpec = η_Y :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac hAffYa.fromSpec η_Y hRange_η
    let φ_cat : Y.presheaf.obj (Opposite.op Y_a) ⟶ CommRingCat.of F :=
      AlgebraicGeometry.Spec.preimage η_tilde
    let φ_a : A_a →+* F := φ_cat.hom
    have hCompat_a : φ_a.comp (algebraMap ↥V A_a) = (algebraMap K F).comp V.subtype := by
      have hHom_eq : CommRingCat.ofHom (φ_a.comp (algebraMap ↥V A_a)) =
          CommRingCat.ofHom (algebraMap ↥V A_a) ≫ φ_cat := by
        ext v
        rfl
      have hSpec_eq : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_a.comp (algebraMap ↥V A_a))) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((algebraMap K F).comp V.subtype)) := by
        rw [hHom_eq, AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
          ← hFromSpec_g, ← Category.assoc, hη_fac, hηY_comm]
      exact CommRingCat.Hom.ext_iff.mp (AlgebraicGeometry.Spec.map_injective hSpec_eq)
    have hInj_a : Function.Injective φ_a := by
      let pt_F : ↥(AlgebraicGeometry.Spec (CommRingCat.of F)) := (⊥ : PrimeSpectrum F)
      let q_η : PrimeSpectrum A_a := η_tilde.base pt_F
      have : AlgebraicGeometry.IsReduced Y := AlgebraicGeometry.isReduced_of_isIntegral Y
      rw [injective_iff_map_eq_zero]
      intro x hx
      have hx_qη : x ∈ q_η.asIdeal := by
        have hpre : (AlgebraicGeometry.Spec.map φ_cat).base pt_F = q_η := by
          rw [AlgebraicGeometry.Spec.map_preimage]
        rw [← hpre]
        exact hx
      have hx_nil : x ∈ nilradical A_a := by
        rw [nilradical_eq_sInf, Ideal.mem_sInf]
        rintro I hI_prime
        let q : PrimeSpectrum A_a := ⟨I, hI_prime⟩
        by_contra hxq
        have hq_basic : q ∈ (PrimeSpectrum.basicOpen x : Set (PrimeSpectrum A_a)) := hxq
        have hO_img_open : IsOpen (⇑hAffYa.fromSpec ''
            (PrimeSpectrum.basicOpen x : Set (PrimeSpectrum A_a))) :=
          hAffYa.fromSpec.isOpenEmbedding.isOpenMap _ (PrimeSpectrum.basicOpen x).isOpen
        have hO_img_ne : ((⇑hAffYa.fromSpec ''
            (PrimeSpectrum.basicOpen x : Set (PrimeSpectrum A_a))) ∩ Set.range ⇑η_Y).Nonempty :=
          hDense_η.inter_open_nonempty _ hO_img_open ⟨hAffYa.fromSpec.base q, ⟨q, hq_basic, rfl⟩⟩
        obtain ⟨_, ⟨q', hq'_basic, hq'_eq⟩, pt, hpt_eq⟩ := hO_img_ne
        have hpt : pt = pt_F := Subsingleton.elim (α := PrimeSpectrum F) pt pt_F
        rw [hpt, ← hη_fac] at hpt_eq
        have hqq' : q' = q_η :=
          hAffYa.fromSpec.isOpenEmbedding.injective (hq'_eq.trans hpt_eq.symm)
        rw [hqq'] at hq'_basic
        exact hq'_basic hx_qη
      obtain ⟨n, hn⟩ := mem_nilradical.mp hx_nil
      exact IsReduced.eq_zero x ⟨n, hn⟩
    have hDim_Aa : ringKrullDim (TensorProduct ↥V A_a Q.ResidueField) ≤ (1 : WithBot ℕ∞) :=
      hFiberDim A_a φ_a hInj_a hCompat_a
    let j_a := CategoryTheory.Limits.pullback.snd hAffYa.fromSpec fst_Q
    have : AlgebraicGeometry.IsOpenImmersion j_a :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (P := @AlgebraicGeometry.IsOpenImmersion)
        (CategoryTheory.IsPullback.of_hasPullback hAffYa.fromSpec fst_Q) inferInstance
    let iso_paste : CategoryTheory.Limits.pullback hAffYa.fromSpec fst_Q ≅
        CategoryTheory.Limits.pullback (hAffYa.fromSpec ≫ g) s_Q :=
      (((CategoryTheory.IsPullback.of_hasPullback hAffYa.fromSpec fst_Q).flip.paste_horiz
        (CategoryTheory.IsPullback.of_hasPullback g s_Q).flip).flip).isoPullback
    let iso_congr : CategoryTheory.Limits.pullback (hAffYa.fromSpec ≫ g) s_Q ≅
        CategoryTheory.Limits.pullback
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V A_a))) s_Q :=
      CategoryTheory.Limits.pullback.congrHom hFromSpec_g rfl
    let e_fib : AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct ↥V A_a Q.ResidueField)) ≅
        CategoryTheory.Limits.pullback hAffYa.fromSpec fst_Q :=
      (AlgebraicGeometry.pullbackSpecIso ↥V A_a Q.ResidueField).symm ≪≫
        iso_congr.symm ≪≫ iso_paste.symm
    let f_a : AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct ↥V A_a Q.ResidueField)) ⟶ Y_Q :=
      e_fib.hom ≫ j_a
    have : AlgebraicGeometry.IsOpenImmersion f_a := inferInstance
    have hz_range : z ∈ Set.range ⇑f_a := by
      have hRange_eq : Set.range ⇑f_a = Set.range ⇑j_a := by
        ext w
        constructor
        · rintro ⟨u, rfl⟩
          exact ⟨e_fib.hom.base u, rfl⟩
        · rintro ⟨v, rfl⟩
          refine ⟨e_fib.inv.base v, ?_⟩
          change (e_fib.inv ≫ e_fib.hom ≫ j_a).base v = j_a.base v
          rw [← Category.assoc, e_fib.inv_hom_id, Category.id_comp]
      rw [hRange_eq, AlgebraicGeometry.Scheme.Pullback.range_snd, hAffYa.range_fromSpec]
      exact hz_a
    exact ⟨A_a, inferInstance, inferInstance, f_a, inferInstance, hz_range, hDim_Aa⟩
  change (⨆ (p : LTSeries (TopologicalSpace.IrreducibleCloseds ↥Y_Q)),
    (p.length : WithBot ℕ∞)) ≤ 1
  refine iSup_le fun p => ?_
  obtain ⟨z, hz₀⟩ := (p 0).isIrreducible.1
  have hz_top : ιP.base (fst_Q.base z) ∈
      (⨆ a : Fin (N + 1), weilProjBasicOpen ↥V N a) := by
    rw [(hCoord_proj ↥V N).2.1]
    trivial
  obtain ⟨a, hz_a⟩ := TopologicalSpace.Opens.mem_iSup.mp hz_top
  obtain ⟨A_a, instCommAa, instAlgAa, f_a, instOpenFa, hz_range, hDim_Aa⟩ :=
    hChart (weilProjectiveSpaceOver ↥V N) (weilProjBasicOpen ↥V N)
      (hAff_proj ↥V N) (c_proj ↥V N)
      (hCoord_proj ↥V N).2.2.1 (hCoord_proj ↥V N).2.2.2.1
      ιP hComm a z hz_a
  let _ : CommRing A_a := instCommAa
  let _ : Algebra ↥V A_a := instAlgAa
  have : AlgebraicGeometry.IsOpenImmersion f_a := instOpenFa
  let S_fib := AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct ↥V A_a Q.ResidueField))
  have hf_emb : Topology.IsOpenEmbedding ⇑f_a := f_a.isOpenEmbedding
  have hz_all : ∀ i : Fin (p.length + 1), z ∈ (p i : Set ↥Y_Q) :=
    fun i => p.monotone (Fin.zero_le i) hz₀
  let q_fun : Fin (p.length + 1) → TopologicalSpace.IrreducibleCloseds ↥S_fib := fun i =>
    { carrier := ⇑f_a ⁻¹' (p i : Set ↥Y_Q)
      isIrreducible' := (p i).isIrreducible.preimage hf_emb ⟨z, hz_all i, hz_range⟩
      isClosed' := (p i).isClosed.preimage f_a.continuous }
  have hq_strict : ∀ j : Fin p.length, q_fun j.castSucc < q_fun j.succ := by
    intro j
    have h_step : p j.castSucc < p j.succ := p.step j
    have h_le : q_fun j.castSucc ≤ q_fun j.succ :=
      fun _ hw => (le_of_lt h_step) hw
    refine lt_of_le_of_ne h_le (fun heq => ?_)
    have h_not_le : ¬ (p j.succ ≤ p j.castSucc) := not_le_of_gt h_step
    have h_diff_ne : ((p j.succ : Set ↥Y_Q) ∩ (p j.castSucc : Set ↥Y_Q)ᶜ).Nonempty := by
      by_contra h_empty
      apply h_not_le
      intro w hw
      by_contra hw_not
      exact h_empty ⟨w, hw, hw_not⟩
    have h_both : ((p j.succ : Set ↥Y_Q) ∩
        ((p j.castSucc : Set ↥Y_Q)ᶜ ∩ Set.range ⇑f_a)).Nonempty :=
      (p j.succ).isIrreducible.2 _ _ (p j.castSucc).isClosed.isOpen_compl hf_emb.isOpen_range
        h_diff_ne ⟨z, hz_all j.succ, hz_range⟩
    obtain ⟨w, hw_succ, hw_not_cast, ⟨w₀, rfl⟩⟩ := h_both
    have hw₀_in : w₀ ∈ (q_fun j.succ : Set ↥S_fib) := hw_succ
    rw [← heq] at hw₀_in
    exact hw_not_cast hw₀_in
  let q_ser : LTSeries (TopologicalSpace.IrreducibleCloseds ↥S_fib) :=
    RelSeries.mk p.length q_fun hq_strict
  have hlen_le : (p.length : WithBot ℕ∞) ≤ topologicalKrullDim ↥S_fib :=
    Order.LTSeries.length_le_krullDim q_ser
  have hSpec_dim : topologicalKrullDim ↥S_fib =
      ringKrullDim (TensorProduct ↥V A_a Q.ResidueField) :=
    PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim _
  exact hlen_le.trans ((le_of_eq hSpec_dim).trans hDim_Aa)

theorem weil_projective_valuation_curve_prime_chain_connected_fibers (K : Type u) [Field K]
    (m : ℕ)
    (V : ValuationSubring K)
    (hPkg : IsValuationRingAlgPackage m V)
    (hAff_proj : ∀ (R : Type u) [CommRing R] (N : ℕ) (a : Fin (N + 1)),
      AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen R N a))
    (c_proj : ∀ (R : Type u) [CommRing R] (N : ℕ) (a : Fin (N + 1)),
      R →+* ↑((weilProjectiveSpaceOver R N).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen R N a))))
    (t_proj : ∀ (R : Type u) [CommRing R] (N : ℕ) (a : Fin (N + 1)), Fin (N + 1) →
      ↑((weilProjectiveSpaceOver R N).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen R N a))))
    (hCoord_proj : ∀ (R : Type u) [CommRing R] (N : ℕ),
      IsCommRingProjCoordSystem R N (hAff_proj R N) (c_proj R N) (t_proj R N))
    (hBase_proj : ∀ (R S : Type u) [CommRing R] [CommRing S] (φ_RS : R →+* S) (N : ℕ),
      ∃ (Φ : (weilProjectiveSpaceOver S N).left ⟶ (weilProjectiveSpaceOver R N).left),
        IsCommRingProjBaseChange R S φ_RS N
          (c_proj R N) (t_proj R N) (c_proj S N) (t_proj S N) Φ)
    (hAppTop : ∀ (R : Type u) [CommRing R] [IsDomain R]
      (Y : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsIntegral Y]
      (p : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of R)) [AlgebraicGeometry.IsProper p]
      (σ : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ Y),
      σ ≫ p = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of R)) →
      Function.Bijective (p.appTop).hom)
    (hHtOne : ∀ (R : Type u) [CommRing R] [IsDomain R] [ValuationRing R],
      IsLocalRing.maximalIdeal R ≠ ⊥ →
      (∀ (P : Ideal R) [P.IsPrime], P = ⊥ ∨ P = IsLocalRing.maximalIdeal R) →
      IsAlgClosed (IsLocalRing.maximalIdeal R).ResidueField →
      ∀ (N : ℕ) (Y : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsIntegral Y]
        (p : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
        [AlgebraicGeometry.IsProper p] [AlgebraicGeometry.Surjective p],
        Function.Bijective (p.appTop).hom →
        ∀ (ιP : Y ⟶ (weilProjectiveSpaceOver R N).left)
          [AlgebraicGeometry.IsClosedImmersion ιP],
          ιP ≫ (weilProjectiveSpaceOver R N).hom = p →
          topologicalKrullDim
            ↥(CategoryTheory.Limits.pullback p
              (AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (algebraMap R (IsLocalRing.maximalIdeal R).ResidueField)))) ≤
            (1 : WithBot ℕ∞) →
          ConnectedSpace
            ↥(CategoryTheory.Limits.pullback p
              (AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (algebraMap R (IsLocalRing.maximalIdeal R).ResidueField)))))
    (N : ℕ)
    (Y : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsIntegral Y]
    (g : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    [AlgebraicGeometry.Flat g] [AlgebraicGeometry.IsProper g]
    (τ₀ : AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ Y)
    (hτ₀ : τ₀ ≫ g = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of ↥V)))
    (ιP : Y ⟶ (weilProjectiveSpaceOver ↥V N).left) [AlgebraicGeometry.IsClosedImmersion ιP]
    (hComm : ιP ≫ (weilProjectiveSpaceOver ↥V N).hom = g)
    (hDim : ∀ (Q : Ideal ↥V) [Q.IsPrime],
      topologicalKrullDim
        ↥(CategoryTheory.Limits.pullback g
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V Q.ResidueField)))) ≤
        (1 : WithBot ℕ∞))
    (P : Ideal ↥V) [P.IsPrime] (hP : P ≠ ⊥) :
    ConnectedSpace
      ↥(CategoryTheory.Limits.pullback g
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V P.ResidueField)))) :=
by
  have hTot : ∀ (I J : Ideal ↥V), I ≤ J ∨ J ≤ I := by
    intro I J
    by_contra! h
    obtain ⟨a, haI, haJ⟩ := SetLike.not_le_iff_exists.mp h.1
    obtain ⟨b, hbJ, hbI⟩ := SetLike.not_le_iff_exists.mp h.2
    rcases (ValuationRing.iff_dvd_total.mp (inferInstance : ValuationRing ↥V)).total a b with
      ⟨c, rfl⟩ | ⟨c, rfl⟩
    · exact hbI (I.mul_mem_right c haI)
    · exact haJ (J.mul_mem_right c hbJ)
  have ⟨hStepBase, hStepSub⟩ :
      (∀ (P₁ : Ideal ↥V) [P₁.IsPrime],
        P₁ ≠ ⊥ →
        (∀ (Q : Ideal ↥V) [Q.IsPrime], Q < P₁ → Q = ⊥) →
        ∃ (ϖ₁ : ↥V)
          (instDom₁ : IsDomain (Localization.Away ϖ₁))
          (instVal₁ : @ValuationRing (Localization.Away ϖ₁) _ instDom₁),
          letI : IsDomain (Localization.Away ϖ₁) := instDom₁
          letI : ValuationRing (Localization.Away ϖ₁) := instVal₁
          ∃ (e₁ : (IsLocalRing.maximalIdeal (Localization.Away ϖ₁)).ResidueField ≃+*
              P₁.ResidueField),
            IsLocalRing.maximalIdeal (Localization.Away ϖ₁) ≠ ⊥ ∧
            (∀ (Q : Ideal (Localization.Away ϖ₁)) [Q.IsPrime],
              Q = ⊥ ∨ Q = IsLocalRing.maximalIdeal (Localization.Away ϖ₁)) ∧
            IsAlgClosed (IsLocalRing.maximalIdeal (Localization.Away ϖ₁)).ResidueField ∧
            (e₁.toRingHom.comp
              (algebraMap (Localization.Away ϖ₁)
                (IsLocalRing.maximalIdeal (Localization.Away ϖ₁)).ResidueField)).comp
              (algebraMap ↥V (Localization.Away ϖ₁)) =
              algebraMap ↥V P₁.ResidueField) ∧
      (∀ (Q₀ Q₁ : Ideal ↥V) [Q₀.IsPrime] [Q₁.IsPrime],
        Q₀ ≠ ⊥ →
        Q₀ < Q₁ →
        (∀ (Q : Ideal ↥V) [Q.IsPrime], Q₀ ≤ Q → Q ≤ Q₁ → Q = Q₀ ∨ Q = Q₁) →
        ∃ (R_sub : Type u) (instCR : CommRing R_sub) (instDom : IsDomain R_sub)
          (instVal : @ValuationRing R_sub instCR instDom),
          letI : CommRing R_sub := instCR
          letI : IsDomain R_sub := instDom
          letI : ValuationRing R_sub := instVal
          ∃ (φ_sub : ↥V →+* R_sub)
            (instAlg : Algebra R_sub Q₀.ResidueField)
            (_ : @IsFractionRing R_sub _ Q₀.ResidueField _ instAlg)
            (e_sub : (IsLocalRing.maximalIdeal R_sub).ResidueField ≃+* Q₁.ResidueField),
            IsLocalRing.maximalIdeal R_sub ≠ ⊥ ∧
            (∀ (Q : Ideal R_sub) [Q.IsPrime], Q = ⊥ ∨ Q = IsLocalRing.maximalIdeal R_sub) ∧
            IsAlgClosed (IsLocalRing.maximalIdeal R_sub).ResidueField ∧
            (@algebraMap R_sub Q₀.ResidueField _ _ instAlg).comp φ_sub =
              algebraMap ↥V Q₀.ResidueField ∧
            (e_sub.toRingHom.comp
              (algebraMap R_sub (IsLocalRing.maximalIdeal R_sub).ResidueField)).comp φ_sub =
              algebraMap ↥V Q₁.ResidueField) := by
    have hFin : Set.Finite (Set.univ : Set (PrimeSpectrum ↥V)) := hPkg.1
    have hAlg : ∀ (Q : Ideal ↥V) [Q.IsPrime], Q ≠ ⊥ → IsAlgClosed Q.ResidueField :=
      hPkg.2.2.2.2.1
    have hResEquiv : ∀ (R E : Type u) [CommRing R] [IsLocalRing R] [Field E] [IsAlgClosed E]
        (α : R →+* E), Function.Surjective α →
        ∃ (e : (IsLocalRing.maximalIdeal R).ResidueField ≃+* E),
          IsAlgClosed (IsLocalRing.maximalIdeal R).ResidueField ∧
          e.toRingHom.comp (algebraMap R (IsLocalRing.maximalIdeal R).ResidueField) = α := by
      intro R E _ _ _ _ α hSurj
      have : (RingHom.ker α).IsMaximal := RingHom.ker_isMaximal_of_surjective α hSurj
      have hker : RingHom.ker α = IsLocalRing.maximalIdeal R :=
        IsLocalRing.eq_maximalIdeal inferInstance
      let e_quot : (R ⧸ RingHom.ker α) ≃+* E := RingHom.quotientKerEquivOfSurjective hSurj
      let e_eq : (R ⧸ IsLocalRing.maximalIdeal R) ≃+* (R ⧸ RingHom.ker α) :=
        Ideal.quotEquivOfEq hker.symm
      let e_res : (R ⧸ IsLocalRing.maximalIdeal R) ≃+* (IsLocalRing.maximalIdeal R).ResidueField :=
        RingEquiv.ofBijective
          (algebraMap (R ⧸ IsLocalRing.maximalIdeal R) (IsLocalRing.maximalIdeal R).ResidueField)
          (Ideal.bijective_algebraMap_quotient_residueField (IsLocalRing.maximalIdeal R))
      let e : (IsLocalRing.maximalIdeal R).ResidueField ≃+* E :=
        (e_res.symm.trans e_eq).trans e_quot
      have hComp : e.toRingHom.comp (algebraMap R (IsLocalRing.maximalIdeal R).ResidueField) = α := by
        ext r
        change e_quot (e_eq (e_res.symm (algebraMap R (IsLocalRing.maximalIdeal R).ResidueField r))) = α r
        rw [IsScalarTower.algebraMap_apply R (R ⧸ IsLocalRing.maximalIdeal R)
          (IsLocalRing.maximalIdeal R).ResidueField r]
        change e_quot (e_eq (e_res.symm (e_res (Ideal.Quotient.mk _ r)))) = α r
        rw [RingEquiv.symm_apply_apply]
        rfl
      have hAlgR : IsAlgClosed (IsLocalRing.maximalIdeal R).ResidueField := by
        apply IsAlgClosed.of_exists_root
        intro p _ hp_irr
        let q : Polynomial E := p.map e.toRingHom
        have hq_deg : q.degree ≠ 0 := by
          rw [Polynomial.degree_map_eq_of_injective e.injective]
          exact ne_of_gt hp_irr.degree_pos
        obtain ⟨y, hy⟩ := IsAlgClosed.exists_root q hq_deg
        refine ⟨e.symm y, ?_⟩
        apply e.injective
        rw [map_zero]
        have hy' : Polynomial.eval (e (e.symm y)) (p.map e.toRingHom) = 0 := by
          rwa [e.apply_symm_apply]
        rw [Polynomial.eval_map] at hy'
        have hhom := Polynomial.hom_eval₂ p (RingHom.id _) e.toRingHom (e.symm y)
        rw [RingHom.comp_id] at hhom
        exact hhom.trans hy'
      exact ⟨e, hAlgR, hComp⟩
    refine ⟨?_, ?_⟩
    · intro P₁ _ hP₁_ne hP₁_min
      have hϖ_ex : ∃ ϖ₁ : ↥V, ϖ₁ ≠ 0 ∧ ϖ₁ ∉ P₁ ∧
          ∀ (Q : Ideal ↥V) [Q.IsPrime], ϖ₁ ∉ Q ↔ Q ≤ P₁ := by
        let S : Set (PrimeSpectrum ↥V) := {q | P₁ < q.asIdeal}
        by_cases hS : S.Nonempty
        · have hS_fin : S.Finite := hFin.subset (Set.subset_univ S)
          obtain ⟨p₂, hp₂⟩ := hS_fin.exists_minimal hS
          have hp₂_mem : P₁ < p₂.asIdeal := hp₂.prop
          have hp₂_le : ∀ q ∈ S, p₂.asIdeal ≤ q.asIdeal := by
            intro q hq
            rcases hTot p₂.asIdeal q.asIdeal with hle | hle
            · exact hle
            · exact hp₂.le_of_le hq hle
          have hnot_le : ¬ p₂.asIdeal ≤ P₁ := not_le_of_gt hp₂_mem
          obtain ⟨ϖ₁, hϖ₁_mem, hϖ₁_nmem⟩ := SetLike.not_le_iff_exists.mp hnot_le
          refine ⟨ϖ₁, fun h0 => hϖ₁_nmem (h0 ▸ P₁.zero_mem), hϖ₁_nmem, ?_⟩
          intro Q _
          constructor
          · intro hnQ
            by_contra hnot
            have hle : P₁ ≤ Q := (hTot P₁ Q).resolve_right hnot
            have hlt : P₁ < Q := lt_of_le_of_ne hle (fun hEq => hnot (hEq ▸ le_rfl))
