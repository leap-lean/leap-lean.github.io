      have : P_bar.IsPrime := Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective
        (by rw [Ideal.mk_ker]; exact hJ₀_le_P)
      have : P_bar.IsMaximal := IsArtinianRing.isMaximal_of_isPrime P_bar
      have hcomap_Pbar : Ideal.comap mk_bar P_bar = P := by
        rw [Ideal.comap_map_of_surjective mk_bar Ideal.Quotient.mk_surjective,
