      AlgebraicGeometry.IsOpenImmersion.lift X_1.ι (P_1.ι ≫ a) hP1_range
    have ha_comm : P_1.ι ≫ a = a_res ≫ X_1.ι :=
      (AlgebraicGeometry.IsOpenImmersion.lift_fac X_1.ι (P_1.ι ≫ a) hP1_range).symm
    have hP1_pre : a ⁻¹ᵁ X_1.ι.opensRange = P_1.ι.opensRange := by
      ext p
      change a.base p ∈ Set.range X_1.ι.base ↔ p ∈ Set.range P_1.ι.base
      simp only [AlgebraicGeometry.Scheme.Opens.range_ι]
      change (a ≫ c).base p ∈ V_1 ↔ (b ≫ d).base p ∈ V_1
