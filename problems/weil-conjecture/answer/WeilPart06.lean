        e₁ ≫ p_Y =
          e₂ ≫ AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) := by
    intro y hy
    rcases hNodalY y with hSm | hNod
    · exact False.elim (hy ((hMemU y).mpr hSm))
    · exact hNod
  have hNodalOut : ∀ y : ↥Y, y ∉ U_sm →
      ∃ (U' : AlgebraicGeometry.Scheme.{u}) (u₀ : U')
        (e₁ : U' ⟶ Y)
        (e₂ : U' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
          (MvPolynomial (Fin 2) k₀ ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}))),
        AlgebraicGeometry.Etale e₁ ∧
        AlgebraicGeometry.Etale e₂ ∧
        e₁.base u₀ = y ∧
        (∀ i : Fin 2, Ideal.Quotient.mk _ (MvPolynomial.X i) ∈ (e₂.base u₀).asIdeal) := by
    intro y hy
    obtain ⟨U', u₀, e₁, e₂, h1, h2, h3, h4, _⟩ := hNodalFull y hy
    exact ⟨U', u₀, e₁, e₂, h1, h2, h3, h4⟩

  have _ : AlgebraicGeometry.IsProper p_Y := hPropY
  have _ : AlgebraicGeometry.IsLocallyNoetherian Y :=
    AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian p_Y
  have _ : CompactSpace ↥Y :=
    AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace p_Y
  have _ : AlgebraicGeometry.IsNoetherian Y := AlgebraicGeometry.IsNoetherian.mk
  have _ : Nonempty ↥Y := hConnY.toNonempty

  
  have hPartC : ((U_sm : Set ↥Y)ᶜ).Finite ∧
      ∀ y : ↥Y, y ∉ U_sm →
        _root_.IsReduced ↑(Y.presheaf.stalk y) ∧
        IsLocalRing.maximalIdeal ↑(Y.presheaf.stalk y) ≠ ⊥ ∧
        ∀ P₂ P₁ P₀ : Ideal ↑(Y.presheaf.stalk y),
          P₂.IsPrime → P₁.IsPrime → P₀.IsPrime → P₂ < P₁ → ¬ (P₁ < P₀) := by
    have h_poly_etale_reduced : ∀ (S : Type u) [CommRing S]
        [Algebra (Polynomial k₀) S] [Algebra.Etale (Polynomial k₀) S],
        _root_.IsReduced S := by
      intro S _ _ _
      refine ⟨fun s ⟨n, hsn⟩ => ?_⟩
      by_contra hs0
      let ann_s : Ideal S :=
        { carrier := {r : S | r * s = 0}
          add_mem' := fun {a b} ha hb => by change (a + b) * s = 0; rw [add_mul, ha, hb, add_zero]
          zero_mem' := zero_mul s
          smul_mem' := fun c {a} ha => by change (c * a) * s = 0; rw [mul_assoc, ha, mul_zero] }
      have hann_ne_top : ann_s ≠ ⊤ := by
        intro htop
        have h1 : (1 : S) ∈ ann_s := htop ▸ Submodule.mem_top
        change 1 * s = 0 at h1
        exact hs0 (one_mul s ▸ h1)
      obtain ⟨M, hM_max, hle_M⟩ := Ideal.exists_le_maximal ann_s hann_ne_top
      have _ : M.IsPrime := hM_max.isPrime
      obtain ⟨hDom_M, _⟩ := h_poly_etale_stalk k₀ S M
      have hpow0 : (algebraMap S (Localization.AtPrime M) s) ^ n = 0 := by
        rw [← map_pow, hsn, map_zero]
      have hmap0 : algebraMap S (Localization.AtPrime M) s = 0 :=
        IsReduced.eq_zero _ ⟨n, hpow0⟩
      obtain ⟨t, hts⟩ := (IsLocalization.map_eq_zero_iff M.primeCompl (Localization.AtPrime M) s).mp hmap0
      exact t.2 (hle_M hts)
    have hAbsTensor_etale : ∀ (R : Type u) [CommRing R]
        (Q₀ Q₁ : Type u) [CommRing Q₀] [Algebra R Q₀] [CommRing Q₁] [Algebra R Q₁]
        (eQ₀ : Q₀ ≃+* Polynomial k₀) (eQ₁ : Q₁ ≃+* Polynomial k₀)
        (δ_lin : R →ₗ[R] Q₀ × Q₁),
        δ_lin 1 = (1, 1) →
        Function.Injective δ_lin →
        ∀ (B' : Type u) [CommRing B'] [Algebra R B'] [Algebra.Etale R B'],
          _root_.IsReduced B' ∧
          (∃ g₀ : Polynomial k₀ →+* TensorProduct R Q₀ B', g₀.Etale) ∧
          (∃ g₁ : Polynomial k₀ →+* TensorProduct R Q₁ B', g₁.Etale) := by
      intro R _ Q₀ Q₁ _ _ _ _ eQ₀ eQ₁ δ_lin hδ1 hInj_δlin B' _ _ _
      have _ : Module.Flat R B' := inferInstance
      have _ : Algebra.Etale Q₀ (TensorProduct R Q₀ B') := Algebra.Etale.baseChange R B' Q₀
      have _ : Algebra.Etale Q₁ (TensorProduct R Q₁ B') := Algebra.Etale.baseChange R B' Q₁
      let g₀ : Polynomial k₀ →+* TensorProduct R Q₀ B' :=
        (algebraMap Q₀ (TensorProduct R Q₀ B')).comp eQ₀.symm.toRingHom
      let g₁ : Polynomial k₀ →+* TensorProduct R Q₁ B' :=
        (algebraMap Q₁ (TensorProduct R Q₁ B')).comp eQ₁.symm.toRingHom
      have hg₀ : g₀.Etale := RingHom.Etale.respectsIso.2
        (algebraMap Q₀ (TensorProduct R Q₀ B')) eQ₀.symm (RingHom.etale_algebraMap.mpr inferInstance)
      have hg₁ : g₁.Etale := RingHom.Etale.respectsIso.2
        (algebraMap Q₁ (TensorProduct R Q₁ B')) eQ₁.symm (RingHom.etale_algebraMap.mpr inferInstance)
      have hRed₀ : _root_.IsReduced (TensorProduct R Q₀ B') := by
        let _ : Algebra (Polynomial k₀) (TensorProduct R Q₀ B') := g₀.toAlgebra
        have _ : Algebra.Etale (Polynomial k₀) (TensorProduct R Q₀ B') := RingHom.etale_algebraMap.mp hg₀
        exact h_poly_etale_reduced (TensorProduct R Q₀ B')
      have hRed₁ : _root_.IsReduced (TensorProduct R Q₁ B') := by
        let _ : Algebra (Polynomial k₀) (TensorProduct R Q₁ B') := g₁.toAlgebra
        have _ : Algebra.Etale (Polynomial k₀) (TensorProduct R Q₁ B') := RingHom.etale_algebraMap.mp hg₁
        exact h_poly_etale_reduced (TensorProduct R Q₁ B')
      let incl_B : B' →+* TensorProduct R Q₀ B' × TensorProduct R Q₁ B' :=
        RingHom.prod
          (Algebra.TensorProduct.includeRight (R := R) (A := Q₀) (B := B')).toRingHom
          (Algebra.TensorProduct.includeRight (R := R) (A := Q₁) (B := B')).toRingHom
      have hInj_incl : Function.Injective incl_B := by
        have hInj_rT := Module.Flat.rTensor_preserves_injective_linearMap (M := B') δ_lin hInj_δlin
        let eProd := TensorProduct.prodLeft R R Q₀ Q₁ B'
        let eLid := TensorProduct.lid R B'
        intro b₁ b₂ hb
        apply eLid.symm.injective
        apply hInj_rT
        apply eProd.injective
        have hEval : ∀ b : B', eProd (LinearMap.rTensor B' δ_lin (eLid.symm b)) = incl_B b := by
          intro b
          dsimp only [eLid, eProd, incl_B]
          simp only [TensorProduct.lid_symm_apply, LinearMap.rTensor_tmul, hδ1,
            TensorProduct.prodLeft_tmul, RingHom.prod_apply,
            AlgHom.toRingHom_eq_coe, RingHom.coe_coe, Algebra.TensorProduct.includeRight_apply]
        rw [hEval b₁, hEval b₂, hb]
      exact ⟨isReduced_of_injective incl_B hInj_incl, ⟨g₀, hg₀⟩, ⟨g₁, hg₁⟩⟩
    have hAbsQuot_etale : ∀ (R : Type u) [CommRing R] (r₀ : R)
        (Q : Type u) [CommRing Q] [Algebra R Q]
        (mk_Q : R →+* Q) (hSurj_Q : Function.Surjective mk_Q)
        (hAlg_Q : ∀ r : R, algebraMap R Q r = mk_Q r)
        (hKer_Q : RingHom.ker mk_Q = Ideal.span {r₀})
        (B' : Type u) [CommRing B'] [Algebra R B']
        (g_T : Polynomial k₀ →+* TensorProduct R Q B') (hg_T : g_T.Etale),
        ∃ g_Qb : Polynomial k₀ →+* (B' ⧸ Ideal.span {algebraMap R B' r₀}), g_Qb.Etale := by
      intro R _ r₀ Q _ _ mk_Q hSurj_Q hAlg_Q hKer_Q B' _ _ g_T hg_T
      let z₀ : B' := algebraMap R B' r₀
      let J₀ : Ideal B' := Ideal.span {z₀}
      let mk_B : B' →+* (B' ⧸ J₀) := Ideal.Quotient.mk J₀
      let inc_R : B' →+* TensorProduct R Q B' :=
        (Algebra.TensorProduct.includeRight (R := R) (A := Q) (B := B')).toRingHom
      have hKill_J₀ : ∀ b ∈ J₀, inc_R b = 0 := by
        intro b hb
        rw [Ideal.mem_span_singleton] at hb
        obtain ⟨c, rfl⟩ := hb
        rw [map_mul]
        have hz0 : inc_R z₀ = 0 := by
          dsimp only [inc_R, z₀]
          simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, Algebra.TensorProduct.includeRight_apply]
          have hsm : algebraMap R B' r₀ = r₀ • (1 : B') := by rw [Algebra.smul_def, mul_one]
          rw [hsm, ← TensorProduct.smul_tmul, Algebra.smul_def, mul_one, hAlg_Q]
          have hr0 : mk_Q r₀ = 0 := by
            rw [← RingHom.mem_ker, hKer_Q]
            exact Ideal.subset_span (Set.mem_singleton r₀)
          rw [hr0, TensorProduct.zero_tmul]
        rw [hz0, zero_mul]
      let fwd : (B' ⧸ J₀) →+* TensorProduct R Q B' := Ideal.Quotient.lift J₀ inc_R hKill_J₀
      let bwd_B : B' →ₐ[R] (B' ⧸ J₀) := IsScalarTower.toAlgHom R B' (B' ⧸ J₀)
      have hKill_Q : ∀ r ∈ RingHom.ker mk_Q, (mk_B.comp (algebraMap R B')) r = 0 := by
        intro r hr
        rw [hKer_Q, Ideal.mem_span_singleton] at hr
        obtain ⟨c, rfl⟩ := hr
        simp only [RingHom.comp_apply, map_mul]
        have h0 : mk_B z₀ = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton z₀))
        change mk_B z₀ * mk_B (algebraMap R B' c) = 0
        rw [h0, zero_mul]
      let bwd_Q_fun : Q → (B' ⧸ J₀) := fun q =>
        mk_B (algebraMap R B' (Function.surjInv hSurj_Q q))
      have hbwd_Q_spec : ∀ r : R, bwd_Q_fun (mk_Q r) = mk_B (algebraMap R B' r) := by
        intro r
        dsimp only [bwd_Q_fun]
        have hdiff : Function.surjInv hSurj_Q (mk_Q r) - r ∈ RingHom.ker mk_Q := by
          rw [RingHom.mem_ker, map_sub, Function.surjInv_eq hSurj_Q (mk_Q r), sub_self]
        have h0 := hKill_Q _ hdiff
        simp only [RingHom.comp_apply, map_sub] at h0
        exact sub_eq_zero.mp h0
      let bwd_Q : Q →ₐ[R] (B' ⧸ J₀) :=
        { toFun := bwd_Q_fun
          map_one' := by rw [← mk_Q.map_one, hbwd_Q_spec, map_one, map_one]
          map_mul' := fun x y => by
            obtain ⟨rx, rfl⟩ := hSurj_Q x; obtain ⟨ry, rfl⟩ := hSurj_Q y
            rw [← map_mul, hbwd_Q_spec, hbwd_Q_spec, hbwd_Q_spec, map_mul, map_mul]
          map_zero' := by rw [← mk_Q.map_zero, hbwd_Q_spec, map_zero, map_zero]
          map_add' := fun x y => by
            obtain ⟨rx, rfl⟩ := hSurj_Q x; obtain ⟨ry, rfl⟩ := hSurj_Q y
            rw [← map_add, hbwd_Q_spec, hbwd_Q_spec, hbwd_Q_spec, map_add, map_add]
          commutes' := fun r => by rw [hAlg_Q, hbwd_Q_spec]; rfl }
      let bwd : TensorProduct R Q B' →ₐ[R] (B' ⧸ J₀) :=
        Algebra.TensorProduct.lift bwd_Q bwd_B (fun _ _ => Commute.all _ _)
      have hbf : ∀ x : (B' ⧸ J₀), bwd.toRingHom (fwd x) = x := by
        intro x
        obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective x
        dsimp only [fwd, inc_R, bwd, bwd_B]
        simp only [Ideal.Quotient.lift_mk, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
          Algebra.TensorProduct.includeRight_apply, Algebra.TensorProduct.lift_tmul, map_one, one_mul]
        rfl
      have hfb : ∀ t : TensorProduct R Q B', fwd (bwd.toRingHom t) = t := by
        have hAlgEq : ({ fwd with
            commutes' := fun r => by
              change inc_R (algebraMap R B' r) = algebraMap R (TensorProduct R Q B') r
              dsimp only [inc_R]
              simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
                Algebra.TensorProduct.includeRight_apply, Algebra.TensorProduct.algebraMap_apply]
              have hsmB : algebraMap R B' r = r • (1 : B') := by rw [Algebra.smul_def, mul_one]
              have hsmQ : algebraMap R Q r = r • (1 : Q) := by rw [Algebra.smul_def, mul_one]
              rw [hsmB, hsmQ, ← TensorProduct.smul_tmul] } : (B' ⧸ J₀) →ₐ[R] TensorProduct R Q B').comp bwd =
            AlgHom.id R (TensorProduct R Q B') := by
          ext q
          · obtain ⟨r, rfl⟩ := hSurj_Q q
            simp only [AlgHom.comp_apply, Algebra.TensorProduct.includeLeft_apply,
              AlgHom.coe_mk, AlgHom.id_apply]
            dsimp only [bwd]
            rw [Algebra.TensorProduct.lift_tmul, map_one, mul_one]
            rw [show bwd_Q (mk_Q r) = mk_B (algebraMap R B' r) from hbwd_Q_spec r]
            change inc_R (algebraMap R B' r) = mk_Q r ⊗ₜ[R] 1
            dsimp only [inc_R]
            simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
              Algebra.TensorProduct.includeRight_apply]
            have hsmB : algebraMap R B' r = r • (1 : B') := by rw [Algebra.smul_def, mul_one]
            rw [hsmB, ← TensorProduct.smul_tmul, Algebra.smul_def, mul_one, hAlg_Q]
          · simp [bwd, bwd_B, fwd, inc_R]
        intro t
        exact DFunLike.congr_fun (congrArg AlgHom.toRingHom hAlgEq) t
      let eQB : (B' ⧸ J₀) ≃+* TensorProduct R Q B' :=
        { fwd with invFun := bwd.toRingHom, left_inv := hbf, right_inv := hfb }
      refine ⟨eQB.symm.toRingHom.comp g_T, ?_⟩
      exact RingHom.Etale.respectsIso.1 g_T eQB.symm hg_T
    let I_nod : Ideal (MvPolynomial (Fin 2) k₀) :=
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}
    let R₀ := MvPolynomial (Fin 2) k₀ ⧸ I_nod
    let mk₀ : MvPolynomial (Fin 2) k₀ →+* R₀ := Ideal.Quotient.mk I_nod
    let xbar : Fin 2 → R₀ := fun i => mk₀ (MvPolynomial.X i)
    have hx01 : xbar 0 * xbar 1 = 0 := by
      change mk₀ (MvPolynomial.X 0) * mk₀ (MvPolynomial.X 1) = 0
      rw [← map_mul]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton _))
    have hx_swap : ∀ i : Fin 2, xbar i * xbar (1 - i) = 0 := by
      intro i
      fin_cases i
      · exact hx01
      · exact (mul_comm _ _).trans hx01
    let m₀ : Ideal R₀ := Ideal.span {xbar 0, xbar 1}
    let ev0_mv : MvPolynomial (Fin 2) k₀ →+* k₀ := MvPolynomial.eval 0
    have hKill_ev0 : ∀ f ∈ I_nod, ev0_mv f = 0 := by
      intro f hf
      rw [Ideal.mem_span_singleton] at hf
      obtain ⟨g, rfl⟩ := hf
      simp [ev0_mv]
    let ε₀ : R₀ →+* k₀ := Ideal.Quotient.lift I_nod ev0_mv hKill_ev0
    have hε_surj : Function.Surjective ε₀ := fun c =>
      ⟨mk₀ (MvPolynomial.C c), MvPolynomial.eval_C c⟩
    have hε_ker : RingHom.ker ε₀ = m₀ := by
      apply le_antisymm
      · intro r hr
        obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective r
        have hDiff : ∀ Q : MvPolynomial (Fin 2) k₀,
            mk₀ Q - mk₀ (MvPolynomial.C (ev0_mv Q)) ∈ m₀ := by
          intro Q
          induction Q using MvPolynomial.induction_on with
          | C a => simp [ev0_mv]
          | add p q hp hq =>
            rw [map_add, map_add, map_add, map_add]
            have hEq : mk₀ p + mk₀ q - (mk₀ (MvPolynomial.C (ev0_mv p)) + mk₀ (MvPolynomial.C (ev0_mv q))) =
                (mk₀ p - mk₀ (MvPolynomial.C (ev0_mv p))) + (mk₀ q - mk₀ (MvPolynomial.C (ev0_mv q))) := by ring
            rw [hEq]
            exact m₀.add_mem hp hq
          | mul_X p i _ =>
            have hev : ev0_mv (p * MvPolynomial.X i) = 0 := by simp [ev0_mv]
            rw [hev, map_zero, map_zero, sub_zero, map_mul]
            have hxi : xbar i ∈ m₀ := Ideal.subset_span (by fin_cases i <;> simp)
            exact m₀.mul_mem_left (mk₀ p) hxi
        have hr0 : ev0_mv P = 0 := hr
        have hMem := hDiff P
        rwa [hr0, map_zero, map_zero, sub_zero] at hMem
      · rw [Ideal.span_le]
        rintro y (rfl | rfl)
        · change ev0_mv (MvPolynomial.X 0) = 0; simp [ev0_mv]
        · change ev0_mv (MvPolynomial.X 1) = 0; simp [ev0_mv]
    have hm₀_max : m₀.IsMaximal :=
      hε_ker ▸ RingHom.ker_isMaximal_of_surjective ε₀ hε_surj
    let p₀ : PrimeSpectrum R₀ := ⟨m₀, hm₀_max.isPrime⟩
    have hp₀_iff : ∀ q : PrimeSpectrum R₀, (∀ i : Fin 2, xbar i ∈ q.asIdeal) ↔ q = p₀ := by
      intro q
      refine ⟨fun h => PrimeSpectrum.ext ?_, fun h i => ?_⟩
      · have hle : m₀ ≤ q.asIdeal := by
          rw [Ideal.span_le]
          rintro y (rfl | rfl)
          · exact h 0
          · exact h 1
        exact (hm₀_max.eq_of_le q.isPrime.ne_top hle).symm
      · rw [h]
        exact Ideal.subset_span (by fin_cases i <;> simp)
    let π_mv : Fin 2 → (MvPolynomial (Fin 2) k₀ →+* Polynomial k₀) :=
      fun i => MvPolynomial.eval₂Hom Polynomial.C (fun j => if j = i then Polynomial.X else 0)
    have hKill_π : ∀ (i : Fin 2) (f : MvPolynomial (Fin 2) k₀), f ∈ I_nod → π_mv i f = 0 := by
      intro i f hf
      rw [Ideal.mem_span_singleton] at hf
      obtain ⟨g, rfl⟩ := hf
      fin_cases i <;> simp [π_mv]
    let π_br : Fin 2 → (R₀ →+* Polynomial k₀) :=
      fun i => Ideal.Quotient.lift I_nod (π_mv i) (hKill_π i)
    have hEval0_π : ∀ (i : Fin 2) (r : R₀), (π_br i r).eval 0 = ε₀ r := by
      intro i r
      obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective r
      change ((Polynomial.evalRingHom 0).comp (π_mv i)) P = ev0_mv P
      congr 1
      apply MvPolynomial.ringHom_ext
      · intro c; simp [π_mv, ev0_mv]
      · intro j; fin_cases i <;> fin_cases j <;> simp [π_mv, ev0_mv]
    have hZeroDiv_m₀ : ∀ (q : Ideal R₀) [q.IsPrime], q = m₀ →
        let ξ : Fin 2 → Localization.AtPrime q :=
          fun i => algebraMap R₀ (Localization.AtPrime q) (xbar i)
        ξ 0 * ξ 1 = 0 ∧ ξ 0 ≠ 0 ∧ ξ 1 ≠ 0 := by
      intro q _ hq_eq ξ
      have hmul : ξ 0 * ξ 1 = 0 := by
        dsimp only [ξ]
        rw [← map_mul, hx01, map_zero]
      have hne : ∀ i : Fin 2, ξ i ≠ 0 := by
        intro i h0
        obtain ⟨s, hs⟩ :=
          (IsLocalization.map_eq_zero_iff q.primeCompl (Localization.AtPrime q) (xbar i)).mp h0
        have hπs : π_br i s.1 * Polynomial.X = 0 := by
          have h1 : π_br i (s.1 * xbar i) = 0 := by rw [hs, map_zero]
          rw [map_mul] at h1
          have hxi : π_br i (xbar i) = Polynomial.X := by
            change π_mv i (MvPolynomial.X i) = Polynomial.X
            simp [π_mv]
          rwa [hxi] at h1
        have hπs0 : π_br i s.1 = 0 :=
          (mul_eq_zero.mp hπs).resolve_right Polynomial.X_ne_zero
        have hεs : ε₀ s.1 = 0 := by
          rw [← hEval0_π i s.1, hπs0, Polynomial.eval_zero]
        have hs_m₀ : (s : R₀) ∈ m₀ := by
          rw [← hε_ker]
          exact hεs
        have hs_q : (s : R₀) ∈ q := hq_eq.symm ▸ hs_m₀
        exact s.2 hs_q
      exact ⟨hmul, hne 0, hne 1⟩
    have hCoeff_π0 : ∀ (P : MvPolynomial (Fin 2) k₀) (n : ℕ),
        (π_mv 0 P).coeff n = P.coeff (Finsupp.single 0 n) := by
      intro P
      induction P using MvPolynomial.induction_on' with
      | monomial d c =>
        intro n
        have hEval : π_mv 0 (MvPolynomial.monomial d c) =
            Polynomial.C c * (Polynomial.X ^ d 0 * 0 ^ d 1) := by
          simp only [π_mv, MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_monomial]
          congr 1
          rw [Finsupp.prod_of_support_subset d (Finset.subset_univ _) _ (fun j _ => pow_zero _),
            Fin.prod_univ_two]
          simp
        rw [hEval, MvPolynomial.coeff_monomial]
        by_cases hd1 : d 1 = 0
        · rw [hd1, pow_zero, mul_one, Polynomial.C_mul_X_pow_eq_monomial, Polynomial.coeff_monomial]
          have hiff : d = Finsupp.single 0 n ↔ d 0 = n := by
            rw [Finsupp.ext_iff, Fin.forall_fin_two]
            simp [hd1, eq_comm]
          by_cases hd0 : d 0 = n
          · have heq : d = Finsupp.single 0 n := hiff.mpr hd0
            simp [heq]
          · have hne : d ≠ Finsupp.single 0 n := mt hiff.mp hd0
            simp [hd0, hne]
        · rw [zero_pow hd1, mul_zero, mul_zero, Polynomial.coeff_zero]
          have hne : d ≠ Finsupp.single 0 n := by
            intro heq
            apply hd1
            rw [heq]
            simp
          simp [hne]
      | add p q hp hq =>
        intro n
        have hAdd : (p + q).coeff (Finsupp.single 0 n) =
            p.coeff (Finsupp.single 0 n) + q.coeff (Finsupp.single 0 n) := rfl
        rw [map_add, Polynomial.coeff_add, hAdd, hp n, hq n]
    have hCoeff_π1 : ∀ (P : MvPolynomial (Fin 2) k₀) (n : ℕ),
        (π_mv 1 P).coeff n = P.coeff (Finsupp.single 1 n) := by
      intro P
      induction P using MvPolynomial.induction_on' with
      | monomial d c =>
        intro n
        have hEval : π_mv 1 (MvPolynomial.monomial d c) =
            Polynomial.C c * (0 ^ d 0 * Polynomial.X ^ d 1) := by
          simp only [π_mv, MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_monomial]
          congr 1
          rw [Finsupp.prod_of_support_subset d (Finset.subset_univ _) _ (fun j _ => pow_zero _),
            Fin.prod_univ_two]
          simp
        rw [hEval, MvPolynomial.coeff_monomial]
        by_cases hd0 : d 0 = 0
        · rw [hd0, pow_zero, one_mul, Polynomial.C_mul_X_pow_eq_monomial, Polynomial.coeff_monomial]
          have hiff : d = Finsupp.single 1 n ↔ d 1 = n := by
            rw [Finsupp.ext_iff, Fin.forall_fin_two]
            simp [hd0, eq_comm]
          by_cases hd1 : d 1 = n
          · have heq : d = Finsupp.single 1 n := hiff.mpr hd1
            simp [heq]
          · have hne : d ≠ Finsupp.single 1 n := mt hiff.mp hd1
            simp [hd1, hne]
        · rw [zero_pow hd0, zero_mul, mul_zero, Polynomial.coeff_zero]
          have hne : d ≠ Finsupp.single 1 n := by
            intro heq
            apply hd0
            rw [heq]
            simp
          simp [hne]
      | add p q hp hq =>
        intro n
        have hAdd : (p + q).coeff (Finsupp.single 1 n) =
            p.coeff (Finsupp.single 1 n) + q.coeff (Finsupp.single 1 n) := rfl
        rw [map_add, Polynomial.coeff_add, hAdd, hp n, hq n]
    have hInj_δ : Function.Injective (RingHom.prod (π_br 0) (π_br 1)) := by
      rw [injective_iff_map_eq_zero]
      intro r hr
      obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective r
      have h0 : π_mv 0 P = 0 := congrArg Prod.fst hr
      have h1 : π_mv 1 P = 0 := congrArg Prod.snd hr
      change mk₀ P = 0
      rw [Ideal.Quotient.eq_zero_iff_mem]
      rw [MvPolynomial.as_sum P]
      refine Submodule.sum_mem I_nod fun d hd => ?_
      have hd_ne : P.coeff d ≠ 0 := MvPolynomial.mem_support_iff.mp hd
      have hd0_ne : d 0 ≠ 0 := by
        intro hd0
        apply hd_ne
        have hd_eq : d = Finsupp.single 1 (d 1) := by
          rw [Finsupp.ext_iff, Fin.forall_fin_two]
          simp [hd0]
        rw [hd_eq, ← hCoeff_π1 P (d 1), h1, Polynomial.coeff_zero]
      have hd1_ne : d 1 ≠ 0 := by
        intro hd1
        apply hd_ne
        have hd_eq : d = Finsupp.single 0 (d 0) := by
          rw [Finsupp.ext_iff, Fin.forall_fin_two]
          simp [hd1]
        rw [hd_eq, ← hCoeff_π0 P (d 0), h0, Polynomial.coeff_zero]
      let e01 : Fin 2 →₀ ℕ := Finsupp.single 0 1 + Finsupp.single 1 1
      have he01_0 : e01 0 = 1 := by simp [e01]
      have he01_1 : e01 1 = 1 := by simp [e01]
      have hd_decomp : e01 + (d - e01) = d := by
        rw [Finsupp.ext_iff, Fin.forall_fin_two]
        simp only [Finsupp.add_apply, Finsupp.tsub_apply, he01_0, he01_1]
        omega
      have hX01 : MvPolynomial.X 0 * MvPolynomial.X 1 = (MvPolynomial.monomial e01 (1 : k₀)) := by
        rw [MvPolynomial.X, MvPolynomial.X, MvPolynomial.monomial_mul_monomial, one_mul]
      have hMonEq : MvPolynomial.monomial d (P.coeff d) =
          (MvPolynomial.X 0 * MvPolynomial.X 1) * MvPolynomial.monomial (d - e01) (P.coeff d) := by
        rw [hX01, MvPolynomial.monomial_mul_monomial, one_mul, hd_decomp]
      rw [hMonEq]
      exact Ideal.mul_mem_right _ I_nod (Ideal.subset_span (Set.mem_singleton _))
    let I_br : Fin 2 → Ideal R₀ := fun i => Ideal.span {xbar (1 - i)}
    let σ_br : Fin 2 → (Polynomial k₀ →+* R₀) :=
      fun i => Polynomial.eval₂RingHom (mk₀.comp MvPolynomial.C) (xbar i)
    have hπσ : ∀ i : Fin 2, (π_br i).comp (σ_br i) = RingHom.id (Polynomial k₀) := by
      intro i
      apply Polynomial.ringHom_ext
      · intro c
        simp only [RingHom.comp_apply, RingHom.id_apply, σ_br,
          Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
        change π_mv i (MvPolynomial.C c) = Polynomial.C c
        simp [π_mv]
      · simp only [RingHom.comp_apply, RingHom.id_apply, σ_br,
          Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
        change π_mv i (MvPolynomial.X i) = Polynomial.X
        simp [π_mv]
    have hKill_Ibr : ∀ (i : Fin 2) (r : R₀), r ∈ I_br i → π_br i r = 0 := by
      intro i r hr
      rw [Ideal.mem_span_singleton] at hr
      obtain ⟨c, rfl⟩ := hr
      rw [map_mul]
      have h0 : π_br i (xbar (1 - i)) = 0 := by
        change π_mv i (MvPolynomial.X (1 - i)) = 0
        fin_cases i <;> simp [π_mv]
      rw [h0, zero_mul]
    let φ_Q : ∀ i : Fin 2, (R₀ ⧸ I_br i) →+* Polynomial k₀ :=
      fun i => Ideal.Quotient.lift (I_br i) (π_br i) (hKill_Ibr i)
    let ψ_Q : ∀ i : Fin 2, Polynomial k₀ →+* (R₀ ⧸ I_br i) :=
      fun i => (Ideal.Quotient.mk (I_br i)).comp (σ_br i)
    have hψφ_Q : ∀ (i : Fin 2) (x : R₀ ⧸ I_br i), ψ_Q i (φ_Q i x) = x := by
      intro i x
      obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective x
      obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective r
      change (((Ideal.Quotient.mk (I_br i)).comp (σ_br i)).comp (π_mv i)) P =
        ((Ideal.Quotient.mk (I_br i)).comp mk₀) P
      congr 1
      apply MvPolynomial.ringHom_ext
      · intro c
        simp only [RingHom.comp_apply, π_mv, MvPolynomial.eval₂Hom_C, σ_br,
          Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
      · intro j
        simp only [RingHom.comp_apply, π_mv, MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_X]
        by_cases hji : j = i
        · subst hji
          simp [σ_br, xbar]
        · have hite : (if j = i then (Polynomial.X : Polynomial k₀) else 0) = 0 := by
            simp [hji]
          rw [hite, map_zero, map_zero]
          have hj_eq : j = 1 - i := by fin_cases i <;> fin_cases j <;> first | contradiction | rfl
          rw [hj_eq]
          exact (Ideal.Quotient.eq_zero_iff_mem.mpr
            (show xbar (1 - i) ∈ I_br i from Ideal.subset_span (Set.mem_singleton _))).symm
    let eQ : ∀ i : Fin 2, (R₀ ⧸ I_br i) ≃+* Polynomial k₀ := fun i =>
      { φ_Q i with
        invFun := ψ_Q i
        left_inv := hψφ_Q i
        right_inv := fun p => DFunLike.congr_fun (hπσ i) p }
    let δ_Q : R₀ →ₗ[R₀] (R₀ ⧸ I_br 0) × (R₀ ⧸ I_br 1) :=
      LinearMap.prod (Submodule.mkQ (I_br 0)) (Submodule.mkQ (I_br 1))
    have hInj_δQ : Function.Injective δ_Q := by
      intro r₁ r₂ hEq
      apply hInj_δ
      apply Prod.ext
      · exact congrArg (φ_Q 0) (congrArg Prod.fst hEq)
      · exact congrArg (φ_Q 1) (congrArg Prod.snd hEq)
    have hEtaleR₀_props : ∀ (B' : Type u) [CommRing B'] [Algebra R₀ B'] [Algebra.Etale R₀ B'],
        _root_.IsReduced B' ∧
        ∀ (q' : Ideal B') [q'.IsPrime],
          _root_.IsReduced (Localization.AtPrime q') ∧
          (∀ Q₂ Q₁ Q₀ : Ideal (Localization.AtPrime q'),
            Q₂.IsPrime → Q₁.IsPrime → Q₀.IsPrime → Q₂ < Q₁ → ¬ (Q₁ < Q₀)) ∧
          (∀ i₀ : Fin 2, algebraMap R₀ B' (xbar i₀) ∉ q' →
            IsDomain (Localization.AtPrime q')) := by
      intro B' _ _ _
      obtain ⟨hRed_B', hT0, hT1⟩ :=
        hAbsTensor_etale R₀ (R₀ ⧸ I_br 0) (R₀ ⧸ I_br 1) (eQ 0) (eQ 1) δ_Q rfl hInj_δQ B'
      have hQuot_etale : ∀ i : Fin 2,
          ∃ g_Qi : Polynomial k₀ →+* (B' ⧸ Ideal.span {algebraMap R₀ B' (xbar (1 - i))}),
            g_Qi.Etale := by
        intro i
        fin_cases i
        · obtain ⟨g₀, hg₀⟩ := hT0
          exact hAbsQuot_etale R₀ (xbar (1 - 0)) (R₀ ⧸ I_br 0) (Ideal.Quotient.mk (I_br 0))
            Ideal.Quotient.mk_surjective (fun _ => rfl) (Ideal.mk_ker) B' g₀ hg₀
        · obtain ⟨g₁, hg₁⟩ := hT1
          exact hAbsQuot_etale R₀ (xbar (1 - 1)) (R₀ ⧸ I_br 1) (Ideal.Quotient.mk (I_br 1))
            Ideal.Quotient.mk_surjective (fun _ => rfl) (Ideal.mk_ker) B' g₁ hg₁
      refine ⟨hRed_B', fun q' _ => ⟨?_, ?_, ?_⟩⟩
      · refine ⟨fun x ⟨n, hxn⟩ => ?_⟩
        rcases Nat.eq_zero_or_pos n with rfl | hn_pos
        · rw [pow_zero] at hxn
          calc
            x = x * 1 := (mul_one x).symm
            _ = x * 0 := by rw [hxn]
            _ = 0 := mul_zero x
        · obtain ⟨m, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hn_pos)
          obtain ⟨⟨b, s⟩, hbs⟩ := IsLocalization.surj q'.primeCompl x
          have hmap_bn : algebraMap B' (Localization.AtPrime q') (b ^ (m + 1)) = 0 := by
            rw [map_pow, ← hbs, mul_pow, hxn, zero_mul]
          obtain ⟨t, htb⟩ :=
            (IsLocalization.map_eq_zero_iff q'.primeCompl (Localization.AtPrime q') (b ^ (m + 1))).mp hmap_bn
          have htb_pow : (t.1 * b) ^ (m + 1) = 0 := by
            have hring : (t.1 * b) ^ (m + 1) = t.1 ^ m * (t.1 * b ^ (m + 1)) := by ring
            rw [hring, htb, mul_zero]
          have _ : _root_.IsReduced B' := hRed_B'
          have htb0 : t.1 * b = 0 := IsReduced.eq_zero (t.1 * b) ⟨m + 1, htb_pow⟩
          have hmap_b0 : algebraMap B' (Localization.AtPrime q') b = 0 :=
            (IsLocalization.map_eq_zero_iff q'.primeCompl (Localization.AtPrime q') b).mpr ⟨t, htb0⟩
          rw [hmap_b0] at hbs
          obtain ⟨us, hus⟩ := IsLocalization.map_units (Localization.AtPrime q') s
          calc
            x = x * (↑us * ↑us⁻¹) := by simp
            _ = (x * algebraMap B' (Localization.AtPrime q') s.1) * ↑us⁻¹ := by rw [hus, mul_assoc]
            _ = 0 := by rw [hbs, zero_mul]
      · intro Q₂ Q₁ Q₀ hQ₂ hQ₁ hQ₀ hQ21 hQ10
        let eOrd := IsLocalization.orderIsoOfPrime q'.primeCompl (Localization.AtPrime q')
        let q₂ := eOrd ⟨Q₂, hQ₂⟩
        let q₁ := eOrd ⟨Q₁, hQ₁⟩
        let q₀ := eOrd ⟨Q₀, hQ₀⟩
        have hq21 : q₂.1 < q₁.1 := eOrd.strictMono hQ21
        have hq10 : q₁.1 < q₀.1 := eOrd.strictMono hQ10
        have hprod_in_q2 : algebraMap R₀ B' (xbar 0) * algebraMap R₀ B' (xbar 1) ∈ q₂.1 := by
          rw [← map_mul, hx01, map_zero]
          exact q₂.1.zero_mem
        let i : Fin 2 := if algebraMap R₀ B' (xbar 1) ∈ q₂.1 then 0 else 1
        have hz_in_q2 : algebraMap R₀ B' (xbar (1 - i)) ∈ q₂.1 := by
          by_cases h1 : algebraMap R₀ B' (xbar 1) ∈ q₂.1
          · simp [i, h1]
          · simp [i, h1]
            exact (q₂.2.1.mem_or_mem hprod_in_q2).resolve_right h1
        let J_j : Ideal B' := Ideal.span {algebraMap R₀ B' (xbar (1 - i))}
        let mk_B : B' →+* (B' ⧸ J_j) := Ideal.Quotient.mk J_j
        have hker_le_q2 : RingHom.ker mk_B ≤ q₂.1 := by
          rw [Ideal.mk_ker]
          exact (Ideal.span_singleton_le_iff_mem q₂.1).mpr hz_in_q2
        have hker_le_q1 : RingHom.ker mk_B ≤ q₁.1 := hker_le_q2.trans hq21.le
        have hker_le_q0 : RingHom.ker mk_B ≤ q₀.1 := hker_le_q1.trans hq10.le
        let pb₂ : Ideal (B' ⧸ J_j) := Ideal.map mk_B q₂.1
        let pb₁ : Ideal (B' ⧸ J_j) := Ideal.map mk_B q₁.1
        let pb₀ : Ideal (B' ⧸ J_j) := Ideal.map mk_B q₀.1
        have _ : pb₂.IsPrime :=
          @Ideal.map_isPrime_of_surjective _ _ _ _ _ _ _ mk_B Ideal.Quotient.mk_surjective _ q₂.2.1 hker_le_q2
        have _ : pb₁.IsPrime :=
          @Ideal.map_isPrime_of_surjective _ _ _ _ _ _ _ mk_B Ideal.Quotient.mk_surjective _ q₁.2.1 hker_le_q1
        have _ : pb₀.IsPrime :=
          @Ideal.map_isPrime_of_surjective _ _ _ _ _ _ _ mk_B Ideal.Quotient.mk_surjective _ q₀.2.1 hker_le_q0
        have hpb21 : pb₂ < pb₁ := by
          refine lt_of_le_of_ne (Ideal.map_mono hq21.le) fun heq => hq21.ne ?_
          have hc2 := Ideal.comap_map_of_surjective' mk_B Ideal.Quotient.mk_surjective q₂.1
          have hc1 := Ideal.comap_map_of_surjective' mk_B Ideal.Quotient.mk_surjective q₁.1
          rw [sup_of_le_left hker_le_q2] at hc2
          rw [sup_of_le_left hker_le_q1] at hc1
          rw [← hc2, ← hc1]
          exact congrArg (Ideal.comap mk_B) heq
        have hpb10 : pb₁ < pb₀ := by
          refine lt_of_le_of_ne (Ideal.map_mono hq10.le) fun heq => hq10.ne ?_
          have hc1 := Ideal.comap_map_of_surjective' mk_B Ideal.Quotient.mk_surjective q₁.1
          have hc0 := Ideal.comap_map_of_surjective' mk_B Ideal.Quotient.mk_surjective q₀.1
          rw [sup_of_le_left hker_le_q1] at hc1
          rw [sup_of_le_left hker_le_q0] at hc0
          rw [← hc1, ← hc0]
          exact congrArg (Ideal.comap mk_B) heq
        obtain ⟨g_Qi, hg_Qi⟩ := hQuot_etale i
        let _ : Algebra (Polynomial k₀) (B' ⧸ J_j) := g_Qi.toAlgebra
        have _ : Algebra.Etale (Polynomial k₀) (B' ⧸ J_j) := RingHom.etale_algebraMap.mp hg_Qi
        obtain ⟨_, hPrimes_pb⟩ := h_poly_etale_stalk k₀ (B' ⧸ J_j) pb₀
        let eOrd_pb := (IsLocalization.orderIsoOfPrime pb₀.primeCompl (Localization.AtPrime pb₀)).symm
        let P_loc₂ := eOrd_pb ⟨pb₂, inferInstance, Set.disjoint_compl_left_iff_subset.mpr (hpb21.le.trans hpb10.le)⟩
        let P_loc₁ := eOrd_pb ⟨pb₁, inferInstance, Set.disjoint_compl_left_iff_subset.mpr hpb10.le⟩
        let P_loc₀ := eOrd_pb ⟨pb₀, inferInstance, Set.disjoint_compl_left_iff_subset.mpr le_rfl⟩
        have hL21 : P_loc₂.1 < P_loc₁.1 := eOrd_pb.strictMono hpb21
        have hL10 : P_loc₁.1 < P_loc₀.1 := eOrd_pb.strictMono hpb10
        rcases hPrimes_pb P_loc₂.1 P_loc₂.2 with h2_bot | h2_max
        · rcases hPrimes_pb P_loc₁.1 P_loc₁.2 with h1_bot | h1_max
          · exact hL21.ne (h2_bot.trans h1_bot.symm)
          · exact not_le_of_gt hL10 (h1_max ▸ IsLocalRing.le_maximalIdeal P_loc₀.2.ne_top)
        · exact not_le_of_gt hL21 (h2_max ▸ IsLocalRing.le_maximalIdeal P_loc₁.2.ne_top)
      · intro i₀ hc₀_not_q'
        let c₀ : B' := algebraMap R₀ B' (xbar i₀)
        let c₁ : B' := algebraMap R₀ B' (xbar (1 - i₀))
        have hc01 : c₀ * c₁ = 0 := by
          dsimp only [c₀, c₁]
          rw [← map_mul, hx_swap i₀, map_zero]
        have hc₁_in_q' : c₁ ∈ q' :=
          (‹q'.IsPrime›.mem_or_mem (hc01 ▸ q'.zero_mem)).resolve_left hc₀_not_q'
        let J₁ : Ideal B' := Ideal.span {c₁}
        let mk_B : B' →+* (B' ⧸ J₁) := Ideal.Quotient.mk J₁
        have hker_le : RingHom.ker mk_B ≤ q' := by
          rw [Ideal.mk_ker]
          exact (Ideal.span_singleton_le_iff_mem q').mpr hc₁_in_q'
        let q_bar : Ideal (B' ⧸ J₁) := Ideal.map mk_B q'
        have _ : q_bar.IsPrime := Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective hker_le
        have hcomap_qbar : Ideal.comap mk_B q_bar = q' := by
          rw [Ideal.comap_map_of_surjective' mk_B Ideal.Quotient.mk_surjective, sup_of_le_left hker_le]
        have hUnits_α : ∀ s : q'.primeCompl,
            IsUnit (((algebraMap (B' ⧸ J₁) (Localization.AtPrime q_bar)).comp mk_B) s.1) := by
          intro s
          have hs_not : mk_B s.1 ∈ q_bar.primeCompl := by
            change mk_B s.1 ∉ q_bar
            rw [← Ideal.mem_comap, hcomap_qbar]
            exact s.2
          exact IsLocalization.map_units (Localization.AtPrime q_bar) ⟨mk_B s.1, hs_not⟩
        let α_loc : Localization.AtPrime q' →+* Localization.AtPrime q_bar :=
          IsLocalization.lift (M := q'.primeCompl) hUnits_α
        have hc₁_loc_zero : algebraMap B' (Localization.AtPrime q') c₁ = 0 := by
          have hc₀_pc : c₀ ∈ q'.primeCompl := hc₀_not_q'
          obtain ⟨uc₀, huc₀⟩ :=
            IsLocalization.map_units (Localization.AtPrime q') ⟨c₀, hc₀_pc⟩
          have hmul0 : algebraMap B' (Localization.AtPrime q') c₀ *
              algebraMap B' (Localization.AtPrime q') c₁ = 0 := by
            rw [← map_mul, hc01, map_zero]
          calc
            algebraMap B' (Localization.AtPrime q') c₁ =
                (↑uc₀⁻¹ * ↑uc₀) * algebraMap B' (Localization.AtPrime q') c₁ := by simp
            _ = ↑uc₀⁻¹ * (algebraMap B' (Localization.AtPrime q') c₀ *
                  algebraMap B' (Localization.AtPrime q') c₁) := by rw [huc₀, mul_assoc]
            _ = 0 := by rw [hmul0, mul_zero]
        have hKill_J₁ : ∀ b ∈ J₁, algebraMap B' (Localization.AtPrime q') b = 0 := by
          intro b hb
          rw [Ideal.mem_span_singleton] at hb
          obtain ⟨r, rfl⟩ := hb
          rw [map_mul, hc₁_loc_zero, zero_mul]
        let ι_quot : (B' ⧸ J₁) →+* Localization.AtPrime q' :=
          Ideal.Quotient.lift J₁ (algebraMap B' (Localization.AtPrime q')) hKill_J₁
        have hUnits_β : ∀ sb : q_bar.primeCompl, IsUnit (ι_quot sb.1) := by
          intro sb
          obtain ⟨s, hs_eq⟩ := Ideal.Quotient.mk_surjective sb.1
          have hs_not : s ∈ q'.primeCompl := by
            change s ∉ q'
            rw [← hcomap_qbar, Ideal.mem_comap, hs_eq]
            exact sb.2
          rw [← hs_eq]
          exact IsLocalization.map_units (Localization.AtPrime q') ⟨s, hs_not⟩
        let β_loc : Localization.AtPrime q_bar →+* Localization.AtPrime q' :=
          IsLocalization.lift (M := q_bar.primeCompl) hUnits_β
        have hβα : β_loc.comp α_loc = RingHom.id (Localization.AtPrime q') := by
          apply IsLocalization.ringHom_ext q'.primeCompl
          ext b
          simp only [RingHom.comp_apply, RingHom.id_apply]
          dsimp only [α_loc, β_loc]
          rw [IsLocalization.lift_eq, RingHom.comp_apply, IsLocalization.lift_eq]
          rfl
        obtain ⟨g_Qi, hg_Qi⟩ := hQuot_etale i₀
        let _ : Algebra (Polynomial k₀) (B' ⧸ J₁) := g_Qi.toAlgebra
        have _ : Algebra.Etale (Polynomial k₀) (B' ⧸ J₁) := RingHom.etale_algebraMap.mp hg_Qi
        obtain ⟨hDom_qbar, _⟩ := h_poly_etale_stalk k₀ (B' ⧸ J₁) q_bar
        have hInj_α : Function.Injective α_loc :=
          Function.LeftInverse.injective (g := β_loc) (fun x => by
            change (β_loc.comp α_loc) x = (RingHom.id _) x
            rw [hβα])
        exact Function.Injective.isDomain α_loc hInj_α
    let S₀ : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of R₀)
    let hTop_S₀ : AlgebraicGeometry.IsAffineOpen (⊤ : S₀.Opens) :=
      AlgebraicGeometry.isAffineOpen_top S₀
    have _ : CategoryTheory.IsIso hTop_S₀.fromSpec := by
      rw [AlgebraicGeometry.IsAffineOpen.fromSpec_top]
      infer_instance
