    (c_A : ∀ a : Fin (1 + 1),
      A →+* ↑((weilProjectiveSpaceOver A 1).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen A 1 a))))
    (t_A : ∀ a : Fin (1 + 1), Fin (1 + 1) →
      ↑((weilProjectiveSpaceOver A 1).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen A 1 a))))
    (hCoord_A : IsCommRingProjCoordSystem A 1 hAff_A c_A t_A) :
    ∃ (M : AlgebraicGeometry.Scheme.{u})
      (p_M : M ⟶ AlgebraicGeometry.Spec (CommRingCat.of A))
      (ι₀ : AlgebraicGeometry.Spec (CommRingCat.of C₀) ⟶ M)
      (ι₁ : AlgebraicGeometry.Spec (CommRingCat.of C₁) ⟶ M)
      (hOpen₀ : AlgebraicGeometry.IsOpenImmersion ι₀)
      (hOpen₁ : AlgebraicGeometry.IsOpenImmersion ι₁)
      (ι_M : M ⟶ (weilProjectiveSpaceOver A 1).left)
