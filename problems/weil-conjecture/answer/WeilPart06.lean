      Z.Finite ∧ ∀ z ∈ Z, IsClosed ({z} : Set ↥F) := by
    intro H hH Z hZ_cl hZH hZne
    have hLocZ : ∀ w : ↥H, ∃ U_w : Set ↥F,
        IsOpen U_w ∧ w.1 ∈ U_w ∧
        (Z ∩ U_w).Finite ∧ ∀ z ∈ Z ∩ U_w, IsClosed ({z} : Set ↥F) := by
      intro w
      rcases hCharts w.1 with
        ⟨D, instRingD, j, q_D, hDomD, hICD, hOpen_j, hj_qD, hTwoD, hFinD⟩ |
        ⟨_hNoSm, B', instRingB', j, q', b, _hRedB', hOpen_j, hj_q', _hσ₀, hCovZ, _hInterZ, hBr⟩
