      have h1 : g_e₀ Polynomial.X = Ideal.Quotient.mk (Ideal.span {Xbar₁}) Xbar₀ :=
        Polynomial.eval₂_X _ _
      rw [h1]
      change Φ₀ (MvPolynomial.X 0) = Polynomial.X
      simp [Φ₀]
  have hgf₀ : g_e₀.comp f_e₀ = RingHom.id (R₀ ⧸ Ideal.span {Xbar₁}) := by
    apply Ideal.Quotient.ringHom_ext
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext
    · intro c
