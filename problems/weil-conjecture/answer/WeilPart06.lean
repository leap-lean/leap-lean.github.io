            (m₂.base ⁻¹' (PrimeSpectrum.basicOpen (e β) : Set (PrimeSpectrum (T β))) :
              Set (PrimeSpectrum ↑R_αβ)) :=
          congrArg (fun W : Set (PrimeSpectrum (T β)) =>
            (m₂.base ⁻¹' W : Set (PrimeSpectrum ↑R_αβ))) (he_set β)
        have hstep₂ :
            (m₂.base ⁻¹' (PrimeSpectrum.basicOpen (e β) : Set (PrimeSpectrum (T β))) :
              Set (PrimeSpectrum ↑R_αβ)) =
            (PrimeSpectrum.basicOpen (Φ₂ (e β)) : Set (PrimeSpectrum ↑R_αβ)) :=
          congrArg (fun U : TopologicalSpace.Opens ↥(AlgebraicGeometry.Spec R_αβ) => U.carrier)
            (AlgebraicGeometry.SpecMap_preimage_basicOpen (CommRingCat.ofHom Φ₂.toRingHom) (e β))
        exact hstep₀.trans (hstep₁.trans hstep₂)
      exact h₁.trans h₂.symm
    obtain ⟨z₁, hz₁⟩ := hS_ne
    obtain ⟨α₁, q₁, hq₁⟩ : ∃ (α₁ : Fin p) (q₁ : PrimeSpectrum (T α₁)), (j α₁).base q₁ = z₁ := by
      have hz₁_cov : z₁ ∈ ⋃ α : Fin p, Set.range (j α).base := by rw [hCovJ]; trivial
      obtain ⟨α₁, q₁, hq₁⟩ := Set.mem_iUnion.mp hz₁_cov
      exact ⟨α₁, q₁, hq₁⟩
    have he₁ : e α₁ ≠ 0 := by
      have hq₁_mem : q₁ ∈ PrimeSpectrum.basicOpen (e α₁) := by
        change q₁ ∈ (PrimeSpectrum.basicOpen (e α₁) : Set _)
        rw [← he_set α₁]
        change (j α₁).base q₁ ∈ S
        rwa [hq₁]
      intro h0
      rw [h0] at hq₁_mem
      exact hq₁_mem (Ideal.zero_mem q₁.asIdeal)
    obtain ⟨z₂, hz₂⟩ := hSc_ne
    obtain ⟨α₂, q₂, hq₂⟩ : ∃ (α₂ : Fin p) (q₂ : PrimeSpectrum (T α₂)), (j α₂).base q₂ = z₂ := by
      have hz₂_cov : z₂ ∈ ⋃ α : Fin p, Set.range (j α).base := by rw [hCovJ]; trivial
      obtain ⟨α₂, q₂, hq₂⟩ := Set.mem_iUnion.mp hz₂_cov
      exact ⟨α₂, q₂, hq₂⟩
    have he₂ : 1 - e α₂ ≠ 0 := by
      have hq₂_notMem : q₂ ∉ PrimeSpectrum.basicOpen (e α₂) := by
        change q₂ ∉ (PrimeSpectrum.basicOpen (e α₂) : Set _)
        rw [← he_set α₂]
        change (j α₂).base q₂ ∉ S
        rwa [hq₂]
      have he_mem_ideal : e α₂ ∈ q₂.asIdeal := by
        by_contra hnot
        exact hq₂_notMem hnot
      intro hsub
      have he_eq_one : e α₂ = 1 := (sub_eq_zero.mp hsub).symm
      rw [he_eq_one] at he_mem_ideal
      exact q₂.isPrime.one_notMem he_mem_ideal
    exact ⟨e, α₁, α₂, hIdem, hCompat, he₁, he₂⟩
  
  have hs3 : ∀ [Algebra k₀ K'] (p : ℕ)
      (A : Fin p → Type u) [∀ α, CommRing (A α)] [∀ α, Algebra k₀ (A α)]
      (C : Fin p → Fin p → Type u) [∀ α β, CommRing (C α β)] [∀ α β, Algebra k₀ (C α β)]
      (res₁ : ∀ α β : Fin p, A α →ₐ[k₀] C α β)
      (res₂ : ∀ α β : Fin p, A β →ₐ[k₀] C α β)
      (e : ∀ α : Fin p, TensorProduct k₀ (A α) K')
      (_hIdem : ∀ α : Fin p, IsIdempotentElem (e α))
      (_hCompat : ∀ α β : Fin p,
        Algebra.TensorProduct.map (res₁ α β) (AlgHom.id k₀ K') (e α) =
          Algebra.TensorProduct.map (res₂ α β) (AlgHom.id k₀ K') (e β))
      (α₁ α₂ : Fin p)
      (_he₁ : e α₁ ≠ 0)
      (_he₂ : 1 - e α₂ ≠ 0),
      ∃ (e₀ : ∀ α : Fin p, A α),
        (∀ α : Fin p, IsIdempotentElem (e₀ α)) ∧
        (∀ α β : Fin p, res₁ α β (e₀ α) = res₂ α β (e₀ β)) ∧
        e₀ α₁ ≠ 0 ∧
        1 - e₀ α₂ ≠ 0 := by
    intro _ p A _ _ C _ _ res₁ res₂ e hIdem hCompat α₁ α₂ he₁ he₂
    classical
    let coordMap : ∀ (M : Type u) [AddCommGroup M] [Module k₀ M]
        (R : Type u) [CommRing R] [Algebra k₀ R]
        (_i : Module.Free.ChooseBasisIndex k₀ M), TensorProduct k₀ M R →ₗ[k₀] R :=
      fun M _ _ R _ _ i =>
        (Algebra.TensorProduct.lid k₀ R).toLinearMap.comp
          (LinearMap.rTensor R ((Module.Free.chooseBasis k₀ M).coord i))
    have hCoord_tmul : ∀ (M : Type u) [AddCommGroup M] [Module k₀ M]
        (R : Type u) [CommRing R] [Algebra k₀ R]
        (i : Module.Free.ChooseBasisIndex k₀ M) (m : M) (r : R),
        coordMap M R i (m ⊗ₜ[k₀] r) = ((Module.Free.chooseBasis k₀ M).repr m i) • r := by
      intro M _ _ R _ _ i m r
      simp [coordMap, Module.Basis.coord_apply]
    have hCoord_sep : ∀ (M : Type u) [AddCommGroup M] [Module k₀ M]
        (x : TensorProduct k₀ M K'),
        x ≠ 0 → ∃ i : Module.Free.ChooseBasisIndex k₀ M, coordMap M K' i x ≠ 0 := by
      intro M _ _ x hx_ne
      by_contra hAllNot
      have hAllZero : ∀ i : Module.Free.ChooseBasisIndex k₀ M, coordMap M K' i x = 0 :=
        fun i => Classical.not_not.mp (fun hne => hAllNot ⟨i, hne⟩)
      apply hx_ne
      let bM := Module.Free.chooseBasis k₀ M
      obtain ⟨F, rfl⟩ := TensorProduct.exists_finset x
      let I_F : Finset (Module.Free.ChooseBasisIndex k₀ M) :=
        F.biUnion (fun s => (bM.repr s.1).support)
      have hs_exp : ∀ s ∈ F, s.1 = ∑ i ∈ I_F, (bM.repr s.1 i) • bM i := by
        intro s hs
        have hlin := (bM.linearCombination_repr s.1).symm
        rw [Finsupp.linearCombination_apply] at hlin
        exact hlin.trans (Finsupp.sum_of_support_subset (bM.repr s.1)
          (Finset.subset_biUnion_of_mem (fun t => (bM.repr t.1).support) hs)
          (fun i c => c • bM i) (fun i _ => zero_smul k₀ (bM i)))
      have hsum_eq : ∑ s ∈ F, s.1 ⊗ₜ[k₀] s.2 =
          ∑ i ∈ I_F, (bM i) ⊗ₜ[k₀] (coordMap M K' i (∑ s ∈ F, s.1 ⊗ₜ[k₀] s.2)) := by
        calc ∑ s ∈ F, s.1 ⊗ₜ[k₀] s.2
            = ∑ s ∈ F, (∑ i ∈ I_F, (bM.repr s.1 i) • bM i) ⊗ₜ[k₀] s.2 := by
                refine Finset.sum_congr rfl (fun s hs => ?_)
                rw [← hs_exp s hs]
          _ = ∑ s ∈ F, ∑ i ∈ I_F, (bM i) ⊗ₜ[k₀] ((bM.repr s.1 i) • s.2) := by
                refine Finset.sum_congr rfl (fun s _ => ?_)
                rw [TensorProduct.sum_tmul]
                refine Finset.sum_congr rfl (fun i _ => ?_)
                rw [TensorProduct.smul_tmul]
          _ = ∑ i ∈ I_F, ∑ s ∈ F, (bM i) ⊗ₜ[k₀] ((bM.repr s.1 i) • s.2) := Finset.sum_comm
          _ = ∑ i ∈ I_F, (bM i) ⊗ₜ[k₀] (∑ s ∈ F, (bM.repr s.1 i) • s.2) := by
                refine Finset.sum_congr rfl (fun i _ => ?_)
                rw [TensorProduct.tmul_sum]
          _ = ∑ i ∈ I_F, (bM i) ⊗ₜ[k₀] (coordMap M K' i (∑ s ∈ F, s.1 ⊗ₜ[k₀] s.2)) := by
                refine Finset.sum_congr rfl (fun i _ => ?_)
                congr 1
                rw [map_sum]
                refine Finset.sum_congr rfl (fun s _ => (hCoord_tmul M K' i s.1 s.2).symm)
      rw [hsum_eq]
      refine Finset.sum_eq_zero (fun i _ => ?_)
      rw [hAllZero i, TensorProduct.tmul_zero]
    obtain ⟨i₁, hi₁⟩ := hCoord_sep (A α₁) (e α₁) he₁
    obtain ⟨i₂, hi₂⟩ := hCoord_sep (A α₂) (1 - e α₂) he₂
    let u₁ : K' := coordMap (A α₁) K' i₁ (e α₁)
    let u₂ : K' := coordMap (A α₂) K' i₂ (1 - e α₂)
    have hu₁₂_ne : u₁ * u₂ ≠ 0 := mul_ne_zero hi₁ hi₂
    let u_inv : K' := (u₁ * u₂)⁻¹
    have hu_inv_eq : u₁ * u₂ * u_inv = 1 := mul_inv_cancel₀ hu₁₂_ne
    choose S_fin hS_fin using fun α : Fin p => TensorProduct.exists_finset (e α)
    let T_coeff : Finset K' :=
      (Finset.univ.biUnion (fun α : Fin p => (S_fin α).image Prod.snd)) ∪ {u₁, u₂, u_inv}
    let ev_K' : MvPolynomial ↥T_coeff k₀ →ₐ[k₀] K' := MvPolynomial.aeval Subtype.val
    let B₀ : Subalgebra k₀ K' := ev_K'.range
    have hT_mem : ∀ x ∈ T_coeff, x ∈ B₀ := fun x hx =>
      ⟨MvPolynomial.X ⟨x, hx⟩, MvPolynomial.aeval_X Subtype.val ⟨x, hx⟩⟩
    have hu₁_mem : u₁ ∈ B₀ := hT_mem u₁ (by simp [T_coeff])
    have hu₂_mem : u₂ ∈ B₀ := hT_mem u₂ (by simp [T_coeff])
    have hu_inv_mem : u_inv ∈ B₀ := hT_mem u_inv (by simp [T_coeff])
    let u₁_B : ↥B₀ := ⟨u₁, hu₁_mem⟩
    let u₂_B : ↥B₀ := ⟨u₂, hu₂_mem⟩
    let u_inv_B : ↥B₀ := ⟨u_inv, hu_inv_mem⟩
    have hu_B_unit : u₁_B * u₂_B * u_inv_B = 1 := Subtype.ext hu_inv_eq
    have hS_mem : ∀ (α : Fin p) (s : A α × K'), s ∈ S_fin α → s.2 ∈ B₀ := by
      intro α s hs
      apply hT_mem
      exact Finset.mem_union_left _
        (Finset.mem_biUnion.mpr ⟨α, Finset.mem_univ α, Finset.mem_image_of_mem Prod.snd hs⟩)
    let e_tilde : ∀ α : Fin p, TensorProduct k₀ (A α) ↥B₀ := fun α =>
      ∑ s ∈ (S_fin α).attach, s.1.1 ⊗ₜ[k₀] ⟨s.1.2, hS_mem α s.1 s.2⟩
    let ι_alg : ∀ (M : Type u) [CommRing M] [Algebra k₀ M],
        TensorProduct k₀ M ↥B₀ →ₐ[k₀] TensorProduct k₀ M K' :=
      fun M _ _ => Algebra.TensorProduct.map (AlgHom.id k₀ M) B₀.val
    have hι_inj : ∀ (M : Type u) [CommRing M] [Algebra k₀ M],
        Function.Injective (ι_alg M) := by
      intro M _ _
      have hlin_eq : (ι_alg M).toLinearMap = LinearMap.lTensor M B₀.val.toLinearMap := by
        apply TensorProduct.ext'
        intro m b
        rfl
      change Function.Injective (ι_alg M).toLinearMap
      rw [hlin_eq]
      exact Module.Flat.lTensor_preserves_injective_linearMap B₀.val.toLinearMap Subtype.val_injective
    have hι_etilde : ∀ α : Fin p, ι_alg (A α) (e_tilde α) = e α := by
      intro α
      dsimp [e_tilde, ι_alg]
      rw [map_sum]
      calc ∑ x ∈ (S_fin α).attach,
            (Algebra.TensorProduct.map (AlgHom.id k₀ (A α)) B₀.val)
              (x.1.1 ⊗ₜ[k₀] ⟨x.1.2, hS_mem α x.1 x.2⟩)
          = ∑ x ∈ (S_fin α).attach, x.1.1 ⊗ₜ[k₀] x.1.2 :=
              Finset.sum_congr rfl (fun x _ => rfl)
        _ = ∑ s ∈ S_fin α, s.1 ⊗ₜ[k₀] s.2 := Finset.sum_attach (S_fin α) (fun s => s.1 ⊗ₜ[k₀] s.2)
        _ = e α := (hS_fin α).symm
    have hIdem_tilde : ∀ α : Fin p, IsIdempotentElem (e_tilde α) := by
      intro α
      apply hι_inj (A α)
      rw [map_mul, hι_etilde α]
      exact hIdem α
    have hCompat_tilde : ∀ α β : Fin p,
        Algebra.TensorProduct.map (res₁ α β) (AlgHom.id k₀ ↥B₀) (e_tilde α) =
          Algebra.TensorProduct.map (res₂ α β) (AlgHom.id k₀ ↥B₀) (e_tilde β) := by
      intro α β
      apply hι_inj (C α β)
      have hnat₁ : (ι_alg (C α β)).toLinearMap.comp
          (Algebra.TensorProduct.map (res₁ α β) (AlgHom.id k₀ ↥B₀)).toLinearMap =
          (Algebra.TensorProduct.map (res₁ α β) (AlgHom.id k₀ K')).toLinearMap.comp
            (ι_alg (A α)).toLinearMap := by
        apply TensorProduct.ext'
        intro a b
        rfl
      have hnat₂ : (ι_alg (C α β)).toLinearMap.comp
          (Algebra.TensorProduct.map (res₂ α β) (AlgHom.id k₀ ↥B₀)).toLinearMap =
          (Algebra.TensorProduct.map (res₂ α β) (AlgHom.id k₀ K')).toLinearMap.comp
            (ι_alg (A β)).toLinearMap := by
        apply TensorProduct.ext'
        intro a b
        rfl
      have h₁ : ι_alg (C α β) (Algebra.TensorProduct.map (res₁ α β) (AlgHom.id k₀ ↥B₀) (e_tilde α)) =
          Algebra.TensorProduct.map (res₁ α β) (AlgHom.id k₀ K') (ι_alg (A α) (e_tilde α)) :=
        LinearMap.congr_fun hnat₁ (e_tilde α)
      have h₂ : ι_alg (C α β) (Algebra.TensorProduct.map (res₂ α β) (AlgHom.id k₀ ↥B₀) (e_tilde β)) =
          Algebra.TensorProduct.map (res₂ α β) (AlgHom.id k₀ K') (ι_alg (A β) (e_tilde β)) :=
        LinearMap.congr_fun hnat₂ (e_tilde β)
      rw [h₁, h₂, hι_etilde α, hι_etilde β]
      exact hCompat α β
    have hCoord_iota : ∀ (M : Type u) [CommRing M] [Algebra k₀ M]
        (i : Module.Free.ChooseBasisIndex k₀ M) (y : TensorProduct k₀ M ↥B₀),
        (coordMap M ↥B₀ i y : K') = coordMap M K' i (ι_alg M y) := by
      intro M _ _ i y
      have hlin : B₀.val.toLinearMap.comp (coordMap M ↥B₀ i) =
          (coordMap M K' i).comp (ι_alg M).toLinearMap := by
        apply TensorProduct.ext'
        intro m b
        simp [ι_alg, hCoord_tmul]
      exact LinearMap.congr_fun hlin y
    have hu₁_tilde : coordMap (A α₁) ↥B₀ i₁ (e_tilde α₁) = u₁_B := by
      apply Subtype.ext
      rw [hCoord_iota (A α₁) i₁ (e_tilde α₁), hι_etilde α₁]
    have hu₂_tilde : coordMap (A α₂) ↥B₀ i₂ (1 - e_tilde α₂) = u₂_B := by
      apply Subtype.ext
      rw [hCoord_iota (A α₂) i₂ (1 - e_tilde α₂), map_sub, map_one, hι_etilde α₂]
    let π_B : MvPolynomial ↥T_coeff k₀ →ₐ[k₀] ↥B₀ := ev_K'.rangeRestrict
    have hπ_surj : Function.Surjective π_B := ev_K'.rangeRestrict_surjective
    have _ : Nontrivial ↥B₀ := ⟨⟨0, 1, fun h => zero_ne_one (congrArg Subtype.val h)⟩⟩
    let J_ker : Ideal (MvPolynomial ↥T_coeff k₀) := RingHom.ker π_B.toRingHom
    have hJ_ne_top : J_ker ≠ ⊤ := by
      rw [Ideal.ne_top_iff_one]
      intro h1
      have h0 : π_B 1 = 0 := h1
      rw [map_one] at h0
      exact one_ne_zero h0
    obtain ⟨𝔪, h𝔪_max, hJ_le_𝔪⟩ := Ideal.exists_le_maximal J_ker hJ_ne_top
    obtain ⟨c_pt, rfl⟩ :=
      (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton (I := 𝔪)).mp h𝔪_max
    have hKer_kill : ∀ P ∈ J_ker, MvPolynomial.aeval c_pt P = 0 := by
      intro P hP
      exact (MvPolynomial.mem_vanishingIdeal_singleton_iff c_pt P).mp (hJ_le_𝔪 hP)
    let ev₀ : ↥B₀ →ₐ[k₀] k₀ :=
      (Ideal.Quotient.liftₐ J_ker (MvPolynomial.aeval c_pt) hKer_kill).comp
        (Ideal.quotientKerAlgEquivOfSurjective hπ_surj).symm.toAlgHom
    let Ψ_alg : ∀ (M : Type u) [CommRing M] [Algebra k₀ M],
        TensorProduct k₀ M ↥B₀ →ₐ[k₀] M :=
      fun M _ _ =>
        (Algebra.TensorProduct.rid k₀ k₀ M).toAlgHom.comp
          (Algebra.TensorProduct.map (AlgHom.id k₀ M) ev₀)
    have hΨ_tmul : ∀ (M : Type u) [CommRing M] [Algebra k₀ M] (m : M) (b : ↥B₀),
        Ψ_alg M (m ⊗ₜ[k₀] b) = ev₀ b • m := by
      intro M _ _ m b
      simp [Ψ_alg]
    let e₀ : ∀ α : Fin p, A α := fun α => Ψ_alg (A α) (e_tilde α)
    have hIdem₀ : ∀ α : Fin p, IsIdempotentElem (e₀ α) :=
      fun α => (hIdem_tilde α).map (Ψ_alg (A α))
    have hCompat₀ : ∀ α β : Fin p, res₁ α β (e₀ α) = res₂ α β (e₀ β) := by
      intro α β
      have hnat₁ : (res₁ α β).toLinearMap.comp (Ψ_alg (A α)).toLinearMap =
          (Ψ_alg (C α β)).toLinearMap.comp
            (Algebra.TensorProduct.map (res₁ α β) (AlgHom.id k₀ ↥B₀)).toLinearMap := by
        apply TensorProduct.ext'
        intro a b
        simp [hΨ_tmul]
      have hnat₂ : (res₂ α β).toLinearMap.comp (Ψ_alg (A β)).toLinearMap =
          (Ψ_alg (C α β)).toLinearMap.comp
            (Algebra.TensorProduct.map (res₂ α β) (AlgHom.id k₀ ↥B₀)).toLinearMap := by
        apply TensorProduct.ext'
        intro a b
        simp [hΨ_tmul]
      have h₁ : res₁ α β (e₀ α) =
          Ψ_alg (C α β) (Algebra.TensorProduct.map (res₁ α β) (AlgHom.id k₀ ↥B₀) (e_tilde α)) :=
        LinearMap.congr_fun hnat₁ (e_tilde α)
      have h₂ : res₂ α β (e₀ β) =
          Ψ_alg (C α β) (Algebra.TensorProduct.map (res₂ α β) (AlgHom.id k₀ ↥B₀) (e_tilde β)) :=
        LinearMap.congr_fun hnat₂ (e_tilde β)
      rw [h₁, h₂, hCompat_tilde α β]
    have hCoord_Ψ : ∀ (M : Type u) [CommRing M] [Algebra k₀ M]
        (i : Module.Free.ChooseBasisIndex k₀ M) (y : TensorProduct k₀ M ↥B₀),
        (Module.Free.chooseBasis k₀ M).coord i (Ψ_alg M y) = ev₀ (coordMap M ↥B₀ i y) := by
      intro M _ _ i y
      have hlin : ((Module.Free.chooseBasis k₀ M).coord i).comp (Ψ_alg M).toLinearMap =
          ev₀.toLinearMap.comp (coordMap M ↥B₀ i) := by
        apply TensorProduct.ext'
        intro m b
        change (Module.Free.chooseBasis k₀ M).coord i (Ψ_alg M (m ⊗ₜ[k₀] b)) =
          ev₀ (coordMap M ↥B₀ i (m ⊗ₜ[k₀] b))
        rw [hΨ_tmul, map_smul, hCoord_tmul, map_smul, Module.Basis.coord_apply,
          smul_eq_mul, smul_eq_mul, mul_comm]
      exact LinearMap.congr_fun hlin y
    have hev₀_unit : ev₀ u₁_B * ev₀ u₂_B * ev₀ u_inv_B = 1 := by
      rw [← map_mul, ← map_mul, hu_B_unit, map_one]
    have hev₀_u₁_ne : ev₀ u₁_B ≠ 0 := by
      intro h0
      rw [h0, zero_mul, zero_mul] at hev₀_unit
      exact zero_ne_one hev₀_unit
    have hev₀_u₂_ne : ev₀ u₂_B ≠ 0 := by
      intro h0
      rw [h0, mul_zero, zero_mul] at hev₀_unit
      exact zero_ne_one hev₀_unit
    have he₀₁ : e₀ α₁ ≠ 0 := by
      intro h0
      have hc := hCoord_Ψ (A α₁) i₁ (e_tilde α₁)
      change (Module.Free.chooseBasis k₀ (A α₁)).coord i₁ (e₀ α₁) =
        ev₀ (coordMap (A α₁) ↥B₀ i₁ (e_tilde α₁)) at hc
      rw [h0, map_zero, hu₁_tilde] at hc
      exact hev₀_u₁_ne hc.symm
    have he₀₂ : 1 - e₀ α₂ ≠ 0 := by
      intro h0
      have hc := hCoord_Ψ (A α₂) i₂ (1 - e_tilde α₂)
      rw [map_sub, map_one] at hc
      change (Module.Free.chooseBasis k₀ (A α₂)).coord i₂ (1 - e₀ α₂) =
        ev₀ (coordMap (A α₂) ↥B₀ i₂ (1 - e_tilde α₂)) at hc
      rw [h0, map_zero, hu₂_tilde] at hc
      exact hev₀_u₂_ne hc.symm
    exact ⟨e₀, hIdem₀, hCompat₀, he₀₁, he₀₂⟩
  
  by_contra hDisconn
  let _ : Algebra k₀ K' := φ.toAlgebra
  obtain ⟨p, U, hAffU, hAffInf, hCovU, hNoIdem⟩ := hs1
  let A : Fin p → Type u := fun α => ↑(Y₀.presheaf.obj (Opposite.op (U α)))
  let C : Fin p → Fin p → Type u := fun α β => ↑(Y₀.presheaf.obj (Opposite.op (U α ⊓ U β)))
  let _ : ∀ α : Fin p, CommRing (A α) := fun _ => inferInstance
  let _ : ∀ α β : Fin p, CommRing (C α β) := fun _ _ => inferInstance
  let f : ∀ α : Fin p, AlgebraicGeometry.Spec (CommRingCat.of (A α)) ⟶ Y₀ :=
    fun α => (hAffU α).fromSpec
  let f_inf : ∀ α β : Fin p, AlgebraicGeometry.Spec (CommRingCat.of (C α β)) ⟶ Y₀ :=
    fun α β => (hAffInf α β).fromSpec
  let _ : ∀ α : Fin p, Algebra k₀ (A α) :=
    fun α => (AlgebraicGeometry.Spec.preimage (f α ≫ p₀)).hom.toAlgebra
  let _ : ∀ α β : Fin p, Algebra k₀ (C α β) :=
    fun α β => (AlgebraicGeometry.Spec.preimage (f_inf α β ≫ p₀)).hom.toAlgebra
  have hf_p₀ : ∀ α : Fin p,
      f α ≫ p₀ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k₀ (A α))) :=
    fun α => (AlgebraicGeometry.Spec.map_preimage (f α ≫ p₀)).symm
  have hCovF : (⋃ α : Fin p, Set.range (f α).base) = Set.univ := by
    have h_eq : ∀ α : Fin p, Set.range (f α).base = (U α : Set ↥Y₀) :=
      fun α => (hAffU α).range_fromSpec
    simpa only [h_eq] using hCovU
  let r₁_cat : ∀ α β : Fin p,
      Y₀.presheaf.obj (Opposite.op (U α)) ⟶ Y₀.presheaf.obj (Opposite.op (U α ⊓ U β)) :=
    fun α β => Y₀.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U α ⊓ U β ≤ U α)).op
  let r₂_cat : ∀ α β : Fin p,
      Y₀.presheaf.obj (Opposite.op (U β)) ⟶ Y₀.presheaf.obj (Opposite.op (U α ⊓ U β)) :=
    fun α β => Y₀.presheaf.map (CategoryTheory.homOfLE (inf_le_right : U α ⊓ U β ≤ U β)).op
  have hr₁_spec : ∀ α β : Fin p, AlgebraicGeometry.Spec.map (r₁_cat α β) ≫ f α = f_inf α β :=
    fun α β => (hAffU α).map_fromSpec (hAffInf α β) (CategoryTheory.homOfLE inf_le_left).op
  have hr₂_spec : ∀ α β : Fin p, AlgebraicGeometry.Spec.map (r₂_cat α β) ≫ f β = f_inf α β :=
    fun α β => (hAffU β).map_fromSpec (hAffInf α β) (CategoryTheory.homOfLE inf_le_right).op
  let res₁ : ∀ α β : Fin p, A α →ₐ[k₀] C α β := fun α β =>
    { toRingHom := (r₁_cat α β).hom
      commutes' := fun c => by
        have hcomp : AlgebraicGeometry.Spec.preimage (f α ≫ p₀) ≫ r₁_cat α β =
            AlgebraicGeometry.Spec.preimage (f_inf α β ≫ p₀) := by
          rw [← hr₁_spec α β, Category.assoc, AlgebraicGeometry.Spec.preimage_comp,
            AlgebraicGeometry.Spec.preimage_map]
        exact ConcreteCategory.congr_hom hcomp c }
  let res₂ : ∀ α β : Fin p, A β →ₐ[k₀] C α β := fun α β =>
    { toRingHom := (r₂_cat α β).hom
      commutes' := fun c => by
        have hcomp : AlgebraicGeometry.Spec.preimage (f β ≫ p₀) ≫ r₂_cat α β =
            AlgebraicGeometry.Spec.preimage (f_inf α β ≫ p₀) := by
          rw [← hr₂_spec α β, Category.assoc, AlgebraicGeometry.Spec.preimage_comp,
            AlgebraicGeometry.Spec.preimage_map]
        exact ConcreteCategory.congr_hom hcomp c }
  have hg_eq : ∀ α β : Fin p,
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (res₁ α β).toRingHom) ≫ f α =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (res₂ α β).toRingHom) ≫ f β :=
    fun α β => (hr₁_spec α β).trans (hr₂_spec α β).symm
  obtain ⟨e, α₁, α₂, hIdem, hCompat, he₁, he₂⟩ :=
    hs2 p A f hf_p₀ hCovF C res₁ res₂ hg_eq hDisconn
  obtain ⟨e₀, hIdem₀, hCompat₀, he₀₁, he₀₂⟩ :=
    hs3 p A C res₁ res₂ e hIdem hCompat α₁ α₂ he₁ he₂
  exact hNoIdem e₀ hIdem₀ hCompat₀ α₁ α₂ he₀₁ he₀₂

theorem weil_valuation_curve_geom_fibers_connected_of_height_one_proj (K : Type u) [Field K] [IsSepClosed K]
    (m : ℕ) (V : ValuationSubring K) (hPkg : IsValuationRingAlgPackage m V)
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (n : ℕ) (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (hIntCK : AlgebraicGeometry.IsIntegral C_K)
    (hPropCK : AlgebraicGeometry.IsProper p_K)
    (hSmCK : AlgebraicGeometry.SmoothOfRelativeDimension 1 p_K)
    (hStabCK : IsGeometricStablePointedCurve p_K n σ_K)
    (C_semi : AlgebraicGeometry.Scheme.{u})
    (g_semi : C_semi ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (τ₀ : AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C_semi)
    (hτ₀ : τ₀ ≫ g_semi = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of ↥V)))
    (ι_semi : C_K ⟶ C_semi)
    (hInt : AlgebraicGeometry.IsIntegral C_semi)
    (hFlat : AlgebraicGeometry.Flat g_semi)
    (hProp : AlgebraicGeometry.IsProper g_semi)
    (hLfp : AlgebraicGeometry.LocallyOfFinitePresentation g_semi)
    (hPb : CategoryTheory.IsPullback ι_semi p_K g_semi
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (hAppTop : ∀ (R : Type u) [CommRing R] [IsDomain R]
      (Y : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsIntegral Y]
      (p : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of R)) [AlgebraicGeometry.IsProper p]
      (σ : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ Y),
      σ ≫ p = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of R)) →
      Function.Bijective (p.appTop).hom)
    (hHtOne : ∀ (R : Type u) [CommRing R] [IsDomain R] [ValuationRing R],
      IsLocalRing.maximalIdeal R ≠ ⊥ →
      (∀ (P : Ideal R) [P.IsPrime], P = ⊥ ∨ P = IsLocalRing.maximalIdeal R) →
      IsAlgClosed (IsLocalRing.maximalIdeal R).ResidueField →
      ∀ (N : ℕ) (Y : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsIntegral Y]
        (p : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
        [AlgebraicGeometry.IsProper p] [AlgebraicGeometry.Surjective p],
        Function.Bijective (p.appTop).hom →
        ∀ (ιP : Y ⟶ (weilProjectiveSpaceOver R N).left)
          [AlgebraicGeometry.IsClosedImmersion ιP],
          ιP ≫ (weilProjectiveSpaceOver R N).hom = p →
          topologicalKrullDim
            ↥(CategoryTheory.Limits.pullback p
              (AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (algebraMap R (IsLocalRing.maximalIdeal R).ResidueField)))) ≤
            (1 : WithBot ℕ∞) →
          ConnectedSpace
            ↥(CategoryTheory.Limits.pullback p
              (AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (algebraMap R (IsLocalRing.maximalIdeal R).ResidueField)))))
    (K' : Type u) [Field K'] [IsAlgClosed K']
    (s : AlgebraicGeometry.Spec (CommRingCat.of K') ⟶
      AlgebraicGeometry.Spec (CommRingCat.of ↥V)) :
    ConnectedSpace ↥(CategoryTheory.Limits.pullback g_semi s) :=
by
  let φ_s : ↥V →+* K' := (AlgebraicGeometry.Spec.preimage s).hom
  have hs : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_s) = s :=
    AlgebraicGeometry.Spec.map_preimage s
  let P : Ideal ↥V := RingHom.ker φ_s
  have hP_prime : P.IsPrime := RingHom.ker_isPrime φ_s
  by_cases hP : P = ⊥
  · 
    have hUnits_V : ∀ y : nonZeroDivisors ↥V, IsUnit (φ_s y.1) := by
      intro y
      have hy_ne : (y : ↥V) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp y.2
      refine isUnit_iff_ne_zero.mpr (fun h0 => hy_ne ?_)
      have hyP : (y : ↥V) ∈ P := h0
      rwa [hP, Submodule.mem_bot] at hyP
    let φ_K : K →+* K' := IsLocalization.lift (M := nonZeroDivisors ↥V) (S := K) hUnits_V
    have hφK_comp : φ_K.comp V.subtype = φ_s := IsLocalization.lift_comp hUnits_V
    let s_K : AlgebraicGeometry.Spec (CommRingCat.of K') ⟶
        AlgebraicGeometry.Spec (CommRingCat.of K) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_K)
    let η_V : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of ↥V) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)
    have hs_fac : s_K ≫ η_V = s := by
      calc s_K ≫ η_V
          = AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom V.subtype ≫ CommRingCat.ofHom φ_K) :=
            (AlgebraicGeometry.Spec.map_comp _ _).symm
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_K.comp V.subtype)) := by
            rw [CommRingCat.ofHom_comp]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_s) := by
            rw [hφK_comp]
        _ = s := hs
    have hPb_paste : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst p_K s_K ≫ ι_semi)
        (CategoryTheory.Limits.pullback.snd p_K s_K) g_semi s := by
      rw [← hs_fac]
      exact (CategoryTheory.IsPullback.of_hasPullback p_K s_K).paste_horiz hPb
    have hConn_K : ConnectedSpace ↥(CategoryTheory.Limits.pullback p_K s_K) :=
      (hStabCK.2.2.2.2.2.2.2.2 K' s_K).1
    let iso_gen := hPb_paste.isoPullback
    exact iso_gen.hom.surjective.connectedSpace iso_gen.hom.continuous
  · 
    obtain ⟨F, instFieldF, instAlgKF, η_F, hηF_comm, hFuncF, _⟩ :=
      weil_integral_scheme_functionField_over_field K C_K hIntCK p_K
    let _ : Field F := instFieldF
    let _ : Algebra K F := instAlgKF
    obtain ⟨⟨s₀, hs₀, hLocV⟩, _, hSmPoles⟩ :=
      weil_valuation_model_functionField_and_smooth_poles K m V hPkg C_K p_K n σ_K
        hIntCK hSmCK hStabCK F η_F hηF_comm hFuncF
    obtain ⟨hAff_proj, c_proj, t_proj, hCoord_proj, hBase_proj⟩ :=
      weil_commRing_projectiveSpace_chart_and_baseChange_pkg
    obtain ⟨N, C_tilde, g_tilde, τ_tilde, ιP_tilde, ρ, η_tilde,
        hInt_tilde, hFlat_tilde, hProp_tilde, hτ_tilde, hCl_tilde, hComm_tilde,
        hSurj_ρ, hρ_comm, hDom_η, hη_tilde_comm⟩ :=
      weil_subset_product_projective_domination_over_valuation K V C_K p_K n σ_K
        hIntCK hStabCK F η_F hηF_comm hFuncF hSmPoles s₀ hs₀ hLocV
        C_semi g_semi ι_semi hInt hProp hLfp hPb
        hAff_proj c_proj t_proj hCoord_proj
    have : AlgebraicGeometry.IsIntegral C_tilde := hInt_tilde
    have : AlgebraicGeometry.Flat g_tilde := hFlat_tilde
    have : AlgebraicGeometry.IsProper g_tilde := hProp_tilde
    have : AlgebraicGeometry.IsClosedImmersion ιP_tilde := hCl_tilde
    have : AlgebraicGeometry.Surjective ρ := hSurj_ρ
    have : AlgebraicGeometry.IsDominant η_tilde := hDom_η
    have hDim_tilde : ∀ (Q : Ideal ↥V) [Q.IsPrime],
        topologicalKrullDim
          ↥(CategoryTheory.Limits.pullback g_tilde
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V Q.ResidueField)))) ≤
          (1 : WithBot ℕ∞) :=
      fun Q _ =>
        weil_projective_valuation_curve_fiber_krullDim_le_one K V C_K p_K hIntCK hSmCK
          F η_F hηF_comm hFuncF hAff_proj c_proj t_proj hCoord_proj
          N C_tilde g_tilde ιP_tilde hComm_tilde η_tilde hη_tilde_comm Q
    let s_P : AlgebraicGeometry.Spec (CommRingCat.of P.ResidueField) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of ↥V) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V P.ResidueField))
    have hConn_tilde_P : ConnectedSpace ↥(CategoryTheory.Limits.pullback g_tilde s_P) :=
      weil_projective_valuation_curve_prime_chain_connected_fibers K m V hPkg
        hAff_proj c_proj t_proj hCoord_proj hBase_proj hAppTop hHtOne
        N C_tilde g_tilde τ_tilde hτ_tilde ιP_tilde hComm_tilde hDim_tilde P hP
    
    let ρ_P : CategoryTheory.Limits.pullback g_tilde s_P ⟶
        CategoryTheory.Limits.pullback g_semi s_P :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst g_tilde s_P ≫ ρ)
        (CategoryTheory.Limits.pullback.snd g_tilde s_P)
        (by rw [Category.assoc, hρ_comm, CategoryTheory.Limits.pullback.condition])
    have hPb_top : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst g_tilde s_P) ρ_P ρ
        (CategoryTheory.Limits.pullback.fst g_semi s_P) := by
      refine CategoryTheory.IsPullback.of_bot ?_ ?_
        (CategoryTheory.IsPullback.of_hasPullback g_semi s_P)
      · rw [CategoryTheory.Limits.pullback.lift_snd, hρ_comm]
        exact CategoryTheory.IsPullback.of_hasPullback g_tilde s_P
      · exact (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm
    have hSurj_ρP : AlgebraicGeometry.Surjective ρ_P :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (P := @AlgebraicGeometry.Surjective) hPb_top hSurj_ρ
    have hConn_semi_P : ConnectedSpace ↥(CategoryTheory.Limits.pullback g_semi s_P) :=
      ρ_P.surjective.connectedSpace ρ_P.continuous
    
    let φ_quot : ↥V ⧸ P →+* K' := RingHom.kerLift φ_s
    have hInj_quot : Function.Injective φ_quot := RingHom.kerLift_injective φ_s
    have hUnits_quot : ∀ y : nonZeroDivisors (↥V ⧸ P), IsUnit (φ_quot y.1) := by
      intro y
      have hy_ne : (y : ↥V ⧸ P) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp y.2
      exact isUnit_iff_ne_zero.mpr (fun h0 =>
        hy_ne (hInj_quot (h0.trans (map_zero φ_quot).symm)))
    let ι_K' : P.ResidueField →+* K' :=
      IsLocalization.lift (M := nonZeroDivisors (↥V ⧸ P)) (S := P.ResidueField) hUnits_quot
    have hι_comp : ι_K'.comp (algebraMap ↥V P.ResidueField) = φ_s := by
      ext x
      change ι_K' (algebraMap ↥V P.ResidueField x) = φ_s x
      rw [IsScalarTower.algebraMap_apply ↥V (↥V ⧸ P) P.ResidueField x,
        IsLocalization.lift_eq hUnits_quot]
      rfl
    let s_ι : AlgebraicGeometry.Spec (CommRingCat.of K') ⟶
        AlgebraicGeometry.Spec (CommRingCat.of P.ResidueField) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_K')
    have hs_P_fac : s_ι ≫ s_P = s := by
      calc s_ι ≫ s_P
          = AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap ↥V P.ResidueField) ≫ CommRingCat.ofHom ι_K') :=
            (AlgebraicGeometry.Spec.map_comp _ _).symm
        _ = AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (ι_K'.comp (algebraMap ↥V P.ResidueField))) := by
            rw [CommRingCat.ofHom_comp]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_s) := by
            rw [hι_comp]
        _ = s := hs
    have hAlgClosed_P : IsAlgClosed P.ResidueField := hPkg.2.2.2.2.1 P hP
    have : AlgebraicGeometry.IsProper g_semi := hProp
    have hConn_bc : ConnectedSpace
        ↥(CategoryTheory.Limits.pullback (CategoryTheory.Limits.pullback.snd g_semi s_P) s_ι) :=
      weil_proper_scheme_connected_baseChange_of_isAlgClosed P.ResidueField K' ι_K'
        (CategoryTheory.Limits.pullback g_semi s_P)
        (CategoryTheory.Limits.pullback.snd g_semi s_P) hConn_semi_P
    have hPb_P_paste : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst
            (CategoryTheory.Limits.pullback.snd g_semi s_P) s_ι ≫
          CategoryTheory.Limits.pullback.fst g_semi s_P)
        (CategoryTheory.Limits.pullback.snd
          (CategoryTheory.Limits.pullback.snd g_semi s_P) s_ι)
        g_semi s := by
      rw [← hs_P_fac]
      exact (CategoryTheory.IsPullback.of_hasPullback
        (CategoryTheory.Limits.pullback.snd g_semi s_P) s_ι).paste_horiz
        (CategoryTheory.IsPullback.of_hasPullback g_semi s_P)
    let iso_P := hPb_P_paste.isoPullback
    exact iso_P.hom.surjective.connectedSpace iso_P.hom.continuous

theorem weil_glue_local_relative_stable_models_over_cover (K : Type u) [Field K] [IsSepClosed K]
    (m : ℕ) (V : ValuationSubring K) (hPkg : IsValuationRingAlgPackage m V)
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (n : ℕ) (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (hIntCK : AlgebraicGeometry.IsIntegral C_K)
    (hPropCK : AlgebraicGeometry.IsProper p_K)
    (hSmCK : AlgebraicGeometry.SmoothOfRelativeDimension 1 p_K)
    (hStabCK : IsGeometricStablePointedCurve p_K n σ_K)
    (C' : AlgebraicGeometry.Scheme.{u})
    (g' : C' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (τ' : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C'))
    (ι' : C_K ⟶ C')
    (hMod' : IsValuationPointedCurveModel V p_K n σ_K C' g' τ' ι')
    (r : ℕ) (U_cov : Fin r → C'.Opens)
    (hCov : (⋃ a : Fin r, (U_cov a : Set C')) = Set.univ)
    (hNonempty : ∀ a : Fin r, Nonempty ↥(U_cov a))
    (ι_Ucov : ∀ a : Fin r,
      AlgebraicGeometry.Scheme.Opens.toScheme
        ((TopologicalSpace.Opens.map ι'.base).obj (U_cov a)) ⟶ (U_cov a).toScheme)
    (hι_comm : ∀ a : Fin r,
      ι_Ucov a ≫ (U_cov a).ι =
        AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj (U_cov a)) ≫ ι')
    (hPb_Ucov : ∀ a : Fin r,
      CategoryTheory.IsPullback (ι_Ucov a)
        (AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj (U_cov a)) ≫ p_K)
        ((U_cov a).ι ≫ g')
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (C_bar : Fin r → AlgebraicGeometry.Scheme.{u})
    (g_bar : ∀ a : Fin r, C_bar a ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (f_bar : ∀ a : Fin r, C_bar a ⟶ (U_cov a).toScheme)
    (τ_bar : ∀ (a : Fin r) (j : Fin n),
      AlgebraicGeometry.Scheme.Opens.toScheme
        ((TopologicalSpace.Opens.map (τ' j).base).obj (U_cov a)) ⟶ C_bar a)
    (ι_bar : ∀ a : Fin r,
      AlgebraicGeometry.Scheme.Opens.toScheme
        ((TopologicalSpace.Opens.map ι'.base).obj (U_cov a)) ⟶ C_bar a)
    (hRelStab : ∀ a : Fin r,
      IsLocalRelativeStableMod V p_K g' n τ' ι' (U_cov a) (ι_Ucov a)
        (C_bar a) (g_bar a) (f_bar a) (τ_bar a) (ι_bar a))
    (hOverlap : ∀ a b : Fin r,
      let U_ab : C'.Opens := U_cov a ⊓ U_cov b
      let V_ab : (C_bar a).Opens :=
        (TopologicalSpace.Opens.map (f_bar a ≫ (U_cov a).ι).base).obj U_ab
      let W_ab : (C_bar b).Opens :=
        (TopologicalSpace.Opens.map (f_bar b ≫ (U_cov b).ι).base).obj U_ab
      ∃ (φ : V_ab.toScheme ≅ W_ab.toScheme),
        φ.hom ≫ W_ab.ι ≫ f_bar b ≫ (U_cov b).ι = V_ab.ι ≫ f_bar a ≫ (U_cov a).ι ∧
        ∀ (ψ : V_ab.toScheme ⟶ W_ab.toScheme),
          ψ ≫ W_ab.ι ≫ f_bar b ≫ (U_cov b).ι = V_ab.ι ≫ f_bar a ≫ (U_cov a).ι →
          ψ = φ.hom) :
    ∃ (C_semi : AlgebraicGeometry.Scheme.{u})
      (g_semi : C_semi ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
      (f_semi : C_semi ⟶ C')
      (τ_semi : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C_semi))
      (ι_semi : C_K ⟶ C_semi),
      IsUnembeddedSemistablePointedModel V p_K n σ_K g' τ' C_semi g_semi f_semi τ_semi ι_semi :=
by
  obtain ⟨C_semi, g_semi, f_semi, τ_semi, ι_semi,
      hSS_semi, hProp_f, hf_g, hProp_g, hSurj_g, hτ_f, hτ_g, hPb_semi, hσ_semi,
      hDisj_semi, hSm_semi⟩ :=
    weil_glue_local_strictlySemistable_models_data K m V hPkg C_K p_K n σ_K
      hIntCK hSmCK hStabCK C' g' τ' ι' hMod' r U_cov hCov hNonempty
      ι_Ucov hι_comm hPb_Ucov C_bar g_bar f_bar τ_bar ι_bar hRelStab hOverlap
  have ⟨hInt_semi, hFlat_semi, _hSep_semi, hLfp_semi, _hCharts_semi⟩ := hSS_semi
  have hn3 : 3 ≤ n := hStabCK.1
  let idx₀ : Fin n := ⟨0, by omega⟩
  refine ⟨C_semi, g_semi, f_semi, τ_semi, ι_semi,
    hSS_semi, hProp_f, hf_g, hProp_g, hSurj_g, hτ_f, hτ_g, hPb_semi, hσ_semi,
    hDisj_semi, hSm_semi, ?_⟩
  intro K' _ _ s
  refine ⟨?_, ?_⟩
  · exact weil_valuation_curve_geom_fibers_connected_of_height_one_proj K m V hPkg
      C_K p_K n σ_K hIntCK hPropCK hSmCK hStabCK
      C_semi g_semi (τ_semi idx₀) (hτ_g idx₀) ι_semi
      hInt_semi hFlat_semi hProp_g hLfp_semi hPb_semi
      (fun R _ _ Y _ p _ σ hSec =>
        weil_integral_proper_section_appTop_bijective R Y p σ hSec)
      (fun R _ _ _ hMaxNeBot hHtOne hAlgClosedRes N Y _ p _ _ hGlob ιP _ hComm hDim =>
        weil_height_one_valuation_projective_curve_connected_special_fiber
          R hMaxNeBot hHtOne hAlgClosedRes N Y p hGlob ιP hComm hDim)
      K' s
  · intro y
    exact weil_strictlySemistable_geom_fiber_smooth_or_nodal_roof K V C_semi g_semi hSS_semi K' s y

theorem weil_nodal_curve_reduced_smooth_open_and_component_decomp (k₀ : Type u) [Field k₀] [IsAlgClosed k₀]
    (Y : AlgebraicGeometry.Scheme.{u})
    (p_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of k₀))
    (hPropY : AlgebraicGeometry.IsProper p_Y)
    (hConnY : ConnectedSpace ↥Y)
    (hNodalY : ∀ y : ↥Y,
      (∃ V_sm : Y.Opens, y ∈ V_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ p_Y)) ∨
      (∃ (U' : AlgebraicGeometry.Scheme.{u}) (u₀ : U')
          (e₁ : U' ⟶ Y)
          (e₂ : U' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
            (MvPolynomial (Fin 2) k₀ ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}))),
        AlgebraicGeometry.Etale e₁ ∧
        AlgebraicGeometry.Etale e₂ ∧
        e₁.base u₀ = y ∧
        (∀ i : Fin 2, Ideal.Quotient.mk _ (MvPolynomial.X i) ∈ (e₂.base u₀).asIdeal) ∧
        e₁ ≫ p_Y =
          e₂ ≫ AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)))) :
    AlgebraicGeometry.IsReduced Y ∧
    ∃ (U_sm : Y.Opens)
      (L_comp : ℕ)
      (Y_comp : Fin (L_comp + 1) → AlgebraicGeometry.Scheme.{u})
      (ι_comp : ∀ a : Fin (L_comp + 1), Y_comp a ⟶ Y)
      (U_part : Fin (L_comp + 1) → Y.Opens),
      AlgebraicGeometry.SmoothOfRelativeDimension 1 (U_sm.ι ≫ p_Y) ∧
      ((U_sm : Set ↥Y)ᶜ).Finite ∧
      (∀ y : ↥Y, y ∉ U_sm →
        ∃ (U' : AlgebraicGeometry.Scheme.{u}) (u₀ : U')
          (e₁ : U' ⟶ Y)
          (e₂ : U' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
            (MvPolynomial (Fin 2) k₀ ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}))),
          AlgebraicGeometry.Etale e₁ ∧
          AlgebraicGeometry.Etale e₂ ∧
          e₁.base u₀ = y ∧
          (∀ i : Fin 2, Ideal.Quotient.mk _ (MvPolynomial.X i) ∈ (e₂.base u₀).asIdeal) ∧
          e₁ ≫ p_Y =
            e₂ ≫ AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C))) ∧
      (∀ E ∈ irreducibleComponents ↥Y, ∃ a : Fin (L_comp + 1), Set.range (ι_comp a).base = E) ∧
      (∀ a : Fin (L_comp + 1), Set.range (ι_comp a).base ∈ irreducibleComponents ↥Y) ∧
      (⨆ a : Fin (L_comp + 1), U_part a) = U_sm ∧
      (_root_.Pairwise fun a b : Fin (L_comp + 1) => Disjoint (U_part a) (U_part b)) ∧
      ∀ a : Fin (L_comp + 1),
        AlgebraicGeometry.IsClosedImmersion (ι_comp a) ∧
        AlgebraicGeometry.IsIntegral (Y_comp a) ∧
        AlgebraicGeometry.IsProper (ι_comp a ≫ p_Y) ∧
        topologicalKrullDim ↥(Y_comp a) = (1 : WithBot ℕ∞) ∧
        U_part a ≤ U_sm ∧
        (U_part a : Set ↥Y) = Set.range (ι_comp a).base ∩ (U_sm : Set ↥Y) ∧
        Nonempty ↥(U_part a) ∧
        AlgebraicGeometry.SmoothOfRelativeDimension 1 ((U_part a).ι ≫ p_Y) ∧
        CategoryTheory.IsIso (ι_comp a ∣_ U_part a) :=
by
  classical
  
  have h_etale_max_zero : ∀ (L B R_loc : Type u) [Field L] [CommRing B] [Algebra L B]
      [Algebra.Etale L B] [CommRing R_loc] [IsLocalRing R_loc] (Φ : B →+* R_loc) (z : B),
      Φ z ∈ IsLocalRing.maximalIdeal R_loc → Φ z = 0 := by
    intro L B R_loc _ _ _ _ _ _ Φ z hz
    obtain ⟨I, _, Ai, hFieldAi, hAlgAi, hEquiv, _⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod L B).mp inferInstance
    let z' : ∀ i : I, Ai i := hEquiv z
    let e' : ∀ i : I, Ai i := fun i => if z' i = 0 then 1 else 0
    let e : B := hEquiv.symm e'
    have hze : z * e = 0 := by
      apply hEquiv.injective
      rw [map_mul, map_zero, hEquiv.apply_symm_apply]
      ext i
      change z' i * (if z' i = 0 then 1 else 0) = 0
      split_ifs with hi <;> simp [hi]
    have hu_prod : IsUnit (hEquiv (z + e)) := by
      rw [map_add, hEquiv.apply_symm_apply, Pi.isUnit_iff]
      intro i
      let _ : Field (Ai i) := hFieldAi i
      apply Ne.isUnit
      change z' i + (if z' i = 0 then 1 else 0) ≠ 0
      split_ifs with hi
      · simp [hi]
      · simpa using hi
    have hu_sum : IsUnit (z + e) := by
      rw [← hEquiv.symm_apply_apply (z + e)]
      exact hu_prod.map hEquiv.symm.toRingHom
    have hu_Φ : IsUnit (Φ z + Φ e) := by
      rw [← map_add]
      exact hu_sum.map Φ
    have he_not_mem : Φ e ∉ IsLocalRing.maximalIdeal R_loc := by
      intro he_mem
      exact IsLocalRing.notMem_maximalIdeal.mpr hu_Φ
        ((IsLocalRing.maximalIdeal R_loc).add_mem hz he_mem)
    obtain ⟨u, hu⟩ := IsLocalRing.notMem_maximalIdeal.mp he_not_mem
    have hmul0 : Φ z * Φ e = 0 := by rw [← map_mul, hze, map_zero]
    calc
      Φ z = Φ z * (↑u * ↑u⁻¹) := by simp
      _ = (Φ z * Φ e) * ↑u⁻¹ := by rw [hu, mul_assoc]
      _ = 0 := by rw [hmul0, zero_mul]

  
  have h_poly_etale_stalk : ∀ (R₀ S : Type u) [Field R₀] [CommRing S]
      [Algebra (Polynomial R₀) S] [Algebra.Etale (Polynomial R₀) S]
      (q : Ideal S) [q.IsPrime],
      IsDomain (Localization.AtPrime q) ∧
      ∀ P : Ideal (Localization.AtPrime q), P.IsPrime →
        P = ⊥ ∨ P = IsLocalRing.maximalIdeal (Localization.AtPrime q) := by
    intro R₀ S _ _ _ _ q _
    let P₀ := Polynomial R₀
    let S_q := Localization.AtPrime q
    have _ : IsNoetherianRing S := Algebra.FiniteType.isNoetherianRing P₀ S
    have _ : IsNoetherianRing S_q := inferInstance
    have _ : Module.Flat P₀ S := inferInstance
    have _ : Module.Flat S S_q := inferInstance
    have _ : Module.Flat P₀ S_q := Module.Flat.trans P₀ S S_q
    have _ : Module.IsTorsionFree P₀ S_q := Module.Flat.isTorsionFree
    let p : Ideal P₀ := Ideal.comap (algebraMap P₀ S) q
    have _ : p.IsPrime := Ideal.IsPrime.comap (algebraMap P₀ S)
    by_cases hp : p = ⊥
    · let K := FractionRing P₀
      have hUnits : ∀ y : nonZeroDivisors P₀, IsUnit (algebraMap P₀ S_q y.1) := by
        intro y
        have hy_ne : (y.1 : P₀) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp y.2
        have hy_not_p : y.1 ∉ p := by rw [hp]; simp [hy_ne]
        have hy_q : algebraMap P₀ S y.1 ∈ q.primeCompl := hy_not_p
        rw [IsScalarTower.algebraMap_apply P₀ S S_q]
        exact IsLocalization.map_units S_q ⟨algebraMap P₀ S y.1, hy_q⟩
      let α_hom : K →+* S_q := IsLocalization.lift (M := nonZeroDivisors P₀) hUnits
      let α_alg : K →ₐ[P₀] S_q :=
        { α_hom with commutes' := fun r => IsLocalization.lift_eq (M := nonZeroDivisors P₀) hUnits r }
      let β_alg : S →ₐ[P₀] S_q := IsScalarTower.toAlgHom P₀ S S_q
      let Φ_alg : TensorProduct P₀ K S →ₐ[P₀] S_q :=
        Algebra.TensorProduct.lift α_alg β_alg (fun _ _ => Commute.all _ _)
      have _ : Algebra.Etale K (TensorProduct P₀ K S) := Algebra.Etale.baseChange P₀ S K
      have hMaxBot : IsLocalRing.maximalIdeal S_q = ⊥ := by
        ext w
        simp only [Submodule.mem_bot]
        refine ⟨fun hw => ?_, fun hw => hw ▸ (IsLocalRing.maximalIdeal S_q).zero_mem⟩
        obtain ⟨⟨s, t⟩, hst⟩ := IsLocalization.surj q.primeCompl w
        have hΦ_eq : Φ_alg.toRingHom (1 ⊗ₜ[P₀] s) = w * algebraMap S S_q t.1 := by
          dsimp only [Φ_alg, β_alg]
          rw [AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
            Algebra.TensorProduct.lift_tmul, map_one, one_mul]
          exact hst.symm
        have hΦ_mem : Φ_alg.toRingHom (1 ⊗ₜ[P₀] s) ∈ IsLocalRing.maximalIdeal S_q := by
          rw [hΦ_eq]
          exact Ideal.mul_mem_right _ _ hw
        have hΦ_zero := h_etale_max_zero K (TensorProduct P₀ K S) S_q Φ_alg.toRingHom (1 ⊗ₜ[P₀] s) hΦ_mem
        rw [hΦ_eq] at hΦ_zero
        obtain ⟨ut, hut⟩ := IsLocalization.map_units S_q t
        calc
          w = w * (↑ut * ↑ut⁻¹) := by simp
          _ = (w * algebraMap S S_q t.1) * ↑ut⁻¹ := by rw [hut, mul_assoc]
          _ = 0 := by rw [hΦ_zero, zero_mul]
      have hField : IsField S_q := IsLocalRing.isField_iff_maximalIdeal_eq.mpr hMaxBot
      let _ : Field S_q := hField.toField
      refine ⟨inferInstance, fun P hP => Or.inl ?_⟩
      exact le_bot_iff.mp (hMaxBot ▸ IsLocalRing.le_maximalIdeal hP.ne_top)
    · have hp_max : p.IsMaximal := Ideal.IsPrime.isMaximal inferInstance hp
      let L := P₀ ⧸ p
      let _ : Field L := Ideal.Quotient.field p
      let π₀ : P₀ := Submodule.IsPrincipal.generator p
      have hπ₀_span : Ideal.span {π₀} = p := Submodule.IsPrincipal.span_singleton_generator p
      have hπ₀_ne : π₀ ≠ 0 := by
        intro h0
        apply hp
        rw [← hπ₀_span, h0, Ideal.span_singleton_eq_bot]
      have hπ₀_mem : π₀ ∈ p := by
        rw [← hπ₀_span]
        exact Ideal.subset_span (Set.mem_singleton π₀)
      let π_bar : S_q := algebraMap P₀ S_q π₀
      have hπ_bar_mem : π_bar ∈ IsLocalRing.maximalIdeal S_q := by
        rw [← IsLocalization.AtPrime.map_eq_maximalIdeal q S_q]
        change algebraMap P₀ S_q π₀ ∈ Ideal.map (algebraMap S S_q) q
        rw [IsScalarTower.algebraMap_apply P₀ S S_q]
        exact Ideal.mem_map_of_mem (algebraMap S S_q) hπ₀_mem
      let I_bar : Ideal S_q := Ideal.span {π_bar}
      have hI_le : I_bar ≤ IsLocalRing.maximalIdeal S_q :=
        (Ideal.span_singleton_le_iff_mem (IsLocalRing.maximalIdeal S_q)).mpr hπ_bar_mem
      have hI_ne_top : I_bar ≠ ⊤ :=
        ne_of_lt (lt_of_le_of_lt hI_le (IsLocalRing.maximalIdeal.isMaximal S_q).lt_top)
      let R_bar := S_q ⧸ I_bar
      have _ : Nontrivial R_bar := Ideal.Quotient.nontrivial_iff.mpr hI_ne_top
      have _ : IsLocalRing R_bar :=
        IsLocalRing.of_surjective' (Ideal.Quotient.mk I_bar) Ideal.Quotient.mk_surjective
      let q_bar : S_q →+* R_bar := Ideal.Quotient.mk I_bar
      have hKill_p : ∀ r ∈ p, (q_bar.comp (algebraMap P₀ S_q)) r = 0 := by
        intro r hr
        rw [← hπ₀_span, Ideal.mem_span_singleton] at hr
        obtain ⟨c, rfl⟩ := hr
        simp only [RingHom.comp_apply, map_mul]
        have h0 : q_bar π_bar = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton π_bar))
        change q_bar π_bar * q_bar (algebraMap P₀ S_q c) = 0
        rw [h0, zero_mul]
      let α_L_hom : L →+* R_bar := Ideal.Quotient.lift p (q_bar.comp (algebraMap P₀ S_q)) hKill_p
      let α_L : L →ₐ[P₀] R_bar :=
        { α_L_hom with commutes' := fun r => rfl }
      let β_L : S →ₐ[P₀] R_bar := IsScalarTower.toAlgHom P₀ S R_bar
      let Ψ_alg : TensorProduct P₀ L S →ₐ[P₀] R_bar :=
        Algebra.TensorProduct.lift α_L β_L (fun _ _ => Commute.all _ _)
      have _ : Algebra.Etale L (TensorProduct P₀ L S) := Algebra.Etale.baseChange P₀ S L
      have hMaxR_bot : IsLocalRing.maximalIdeal R_bar = ⊥ := by
        ext w_bar
        simp only [Submodule.mem_bot]
        refine ⟨fun hw_bar => ?_, fun hw => hw ▸ (IsLocalRing.maximalIdeal R_bar).zero_mem⟩
        obtain ⟨w, rfl⟩ := Ideal.Quotient.mk_surjective w_bar
        obtain ⟨⟨s, t⟩, hst⟩ := IsLocalization.surj q.primeCompl w
        have hΨ_eq : Ψ_alg.toRingHom (1 ⊗ₜ[P₀] s) = q_bar w * q_bar (algebraMap S S_q t.1) := by
          dsimp only [Ψ_alg, β_L]
          rw [AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
            Algebra.TensorProduct.lift_tmul, map_one, one_mul]
          change q_bar (algebraMap S S_q s) = q_bar w * q_bar (algebraMap S S_q t.1)
          rw [← map_mul, hst]
        have hΨ_mem : Ψ_alg.toRingHom (1 ⊗ₜ[P₀] s) ∈ IsLocalRing.maximalIdeal R_bar := by
          rw [hΨ_eq]
          exact Ideal.mul_mem_right _ _ hw_bar
        have hΨ_zero := h_etale_max_zero L (TensorProduct P₀ L S) R_bar Ψ_alg.toRingHom (1 ⊗ₜ[P₀] s) hΨ_mem
        rw [hΨ_eq] at hΨ_zero
        obtain ⟨ut, hut⟩ := (IsLocalization.map_units S_q t).map q_bar
        calc
          q_bar w = q_bar w * (↑ut * ↑ut⁻¹) := by simp
          _ = (q_bar w * q_bar (algebraMap S S_q t.1)) * ↑ut⁻¹ := by rw [hut, mul_assoc]
          _ = 0 := by rw [hΨ_zero, zero_mul]
      have hFieldR : IsField R_bar := IsLocalRing.isField_iff_maximalIdeal_eq.mpr hMaxR_bot
      have hI_isMax : I_bar.IsMaximal := Ideal.Quotient.maximal_of_isField I_bar hFieldR
      have hI_eq_max : I_bar = IsLocalRing.maximalIdeal S_q := IsLocalRing.eq_maximalIdeal hI_isMax
      have hKrull : (⨅ n : ℕ, I_bar ^ n) = ⊥ :=
        Ideal.iInf_pow_eq_bot_of_isLocalRing I_bar hI_ne_top
      have hFactor : ∀ y : S_q, y ≠ 0 → ∃ (b : ℕ) (u : S_q), IsUnit u ∧ y = π_bar ^ b * u := by
        intro y hy
        have hNotAll : ∃ n : ℕ, y ∉ I_bar ^ n := by
          by_contra hall
          have hy_bot : y ∈ (⊥ : Ideal S_q) := by
            rw [← hKrull, Ideal.mem_iInf]
            exact fun n => Classical.not_not.mp fun h => hall ⟨n, h⟩
          exact hy ((Submodule.mem_bot S_q).mp hy_bot)
        let n₀ : ℕ := Nat.find hNotAll
        have hn₀_spec : y ∉ I_bar ^ n₀ := Nat.find_spec hNotAll
        have hn₀_ne : n₀ ≠ 0 := by
          intro h0
          apply hn₀_spec
          rw [h0, pow_zero, Ideal.one_eq_top]
          trivial
        obtain ⟨b, hb_eq⟩ := Nat.exists_eq_succ_of_ne_zero hn₀_ne
        have hb_lt : b < n₀ := by omega
        have hy_in_b : y ∈ I_bar ^ b := by
          by_contra hnot
          exact Nat.find_min hNotAll hb_lt hnot
        have hy_not_succ : y ∉ I_bar ^ (b + 1) := by
          have hEqPow : I_bar ^ n₀ = I_bar ^ (b + 1) := congrArg (I_bar ^ ·) hb_eq
          rwa [← hEqPow]
        rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton] at hy_in_b
        obtain ⟨u, rfl⟩ := hy_in_b
        refine ⟨b, u, ?_, rfl⟩
        apply IsLocalRing.notMem_maximalIdeal.mp
        rw [← hI_eq_max, Ideal.mem_span_singleton]
        rintro ⟨v, rfl⟩
        apply hy_not_succ
        rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton]
        exact ⟨v, by ring⟩
      have _ : NoZeroDivisors S_q := by
        refine ⟨fun {x y} hxy => ?_⟩
        by_cases hx : x = 0
        · exact Or.inl hx
        · by_cases hy : y = 0
          · exact Or.inr hy
          · obtain ⟨b, u, hu_unit, rfl⟩ := hFactor y hy
            obtain ⟨uu, huu⟩ := hu_unit
            have hxπ : π_bar ^ b * x = 0 := by
              have hcomm : x * (π_bar ^ b * ↑uu) = (π_bar ^ b * x) * ↑uu := by ring
              calc
                π_bar ^ b * x = ((π_bar ^ b * x) * ↑uu) * ↑uu⁻¹ := by
                  rw [mul_assoc, Units.mul_inv, mul_one]
                _ = (x * (π_bar ^ b * ↑uu)) * ↑uu⁻¹ := by rw [hcomm]
                _ = 0 := by rw [huu, hxy, zero_mul]
            have hsmul : (π₀ ^ b) • x = 0 := by
              rw [Algebra.smul_def, map_pow]
              exact hxπ
            rcases smul_eq_zero.mp hsmul with hπ_pow | hx0
            · exact False.elim (pow_ne_zero b hπ₀_ne hπ_pow)
            · exact Or.inl hx0
      have _ : IsDomain S_q := NoZeroDivisors.to_isDomain S_q
      refine ⟨inferInstance, fun P hP => ?_⟩
      by_cases hPmax : P = IsLocalRing.maximalIdeal S_q
      · exact Or.inr hPmax
      · refine Or.inl (le_bot_iff.mp fun y hyP => ?_)
        rw [Submodule.mem_bot]
        by_contra hy0
        have hπ_not_P : π_bar ∉ P := by
          intro hπP
          apply hPmax
          apply le_antisymm (IsLocalRing.le_maximalIdeal hP.ne_top)
          rw [← hI_eq_max]
          exact (Ideal.span_singleton_le_iff_mem P).mpr hπP
        obtain ⟨b, u, hu_unit, rfl⟩ := hFactor y hy0
        obtain ⟨uu, huu⟩ := hu_unit
        have hpow_P : π_bar ^ b ∈ P := by
          have hmul := P.mul_mem_right (↑uu⁻¹ : S_q) hyP
          rwa [← huu, mul_assoc, Units.mul_inv, mul_one] at hmul
        rcases Nat.eq_zero_or_pos b with rfl | hb_pos
        · rw [pow_zero] at hpow_P
          exact hP.ne_top (P.eq_top_of_isUnit_mem hpow_P isUnit_one)
        · exact hπ_not_P (hP.mem_of_pow_mem b hpow_P)

  
  have hPartB : ∃ (U_sm : Y.Opens),
      AlgebraicGeometry.SmoothOfRelativeDimension 1 (U_sm.ι ≫ p_Y) ∧
      (∀ y : ↥Y, y ∈ U_sm ↔
        ∃ V_sm : Y.Opens, y ∈ V_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ p_Y)) ∧
      (∀ y : ↥Y, y ∈ U_sm →
        _root_.IsReduced ↑(Y.presheaf.stalk y) ∧
        ∀ P₂ P₁ P₀ : Ideal ↑(Y.presheaf.stalk y),
          P₂.IsPrime → P₁.IsPrime → P₀.IsPrime → P₂ < P₁ → ¬ (P₁ < P₀)) ∧
      (∀ y : ↥Y, y ∈ U_sm →
        ∃ U_y : Set ↥Y, IsOpen U_y ∧ y ∈ U_y ∧ IsIrreducible U_y) ∧
      (∀ V : Y.Opens, V ≤ U_sm → Nonempty ↥V →
        ∃ x₀ x₁ : ↥Y, x₀ ∈ V ∧ x₁ ∈ V ∧
          x₁ ∈ closure ({x₀} : Set ↥Y) ∧ x₀ ∉ closure ({x₁} : Set ↥Y)) := by
    let S_sm : Set Y.Opens :=
      {V : Y.Opens | AlgebraicGeometry.SmoothOfRelativeDimension 1 (V.ι ≫ p_Y)}
    let U_sm : Y.Opens := sSup S_sm
    have hMemU : ∀ y : ↥Y, y ∈ U_sm ↔
        ∃ V_sm : Y.Opens, y ∈ V_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ p_Y) := by
      intro y
      rw [TopologicalSpace.Opens.mem_sSup]
      exact ⟨fun ⟨V, hV, hy⟩ => ⟨V, hy, hV⟩, fun ⟨V, hy, hV⟩ => ⟨V, hV, hy⟩⟩
    have hSmU : AlgebraicGeometry.SmoothOfRelativeDimension 1 (U_sm.ι ≫ p_Y) := by
      rw [AlgebraicGeometry.smoothOfRelativeDimension_iff]
      intro x
      obtain ⟨V_sm, hxV, hSmV⟩ := (hMemU x.1).mp x.2
      have hV_le : V_sm ≤ U_sm := le_sSup hSmV
      let j : V_sm.toScheme ⟶ U_sm.toScheme := Y.homOfLE hV_le
      obtain ⟨U₀, hU₀, V₀, hV₀, hxV₀, hle₀, hStd₀⟩ :=
        (AlgebraicGeometry.smoothOfRelativeDimension_iff 1 (V_sm.ι ≫ p_Y)).mp hSmV ⟨x.1, hxV⟩
      let W₀ : U_sm.toScheme.Opens := j ''ᵁ V₀
      have hW₀ : AlgebraicGeometry.IsAffineOpen W₀ := hV₀.image_of_isOpenImmersion j
      have hxW₀ : x ∈ W₀ := ⟨⟨x.1, hxV⟩, hxV₀, Subtype.ext (by
        change (j ≫ U_sm.ι).base ⟨x.1, hxV⟩ = x.1
        rw [Y.homOfLE_ι hV_le]
        rfl)⟩
      have hj_comp : j ≫ (U_sm.ι ≫ p_Y) = V_sm.ι ≫ p_Y := by
        rw [← Category.assoc, Y.homOfLE_ι hV_le]
      have hj_le : V₀ ≤ j ⁻¹ᵁ W₀ := fun v hv => ⟨v, hv, rfl⟩
      have hW₀_le : W₀ ≤ (U_sm.ι ≫ p_Y) ⁻¹ᵁ U₀ := by
        rintro z ⟨v, hv, rfl⟩
        change (j ≫ (U_sm.ι ≫ p_Y)).base v ∈ U₀
        rw [hj_comp]
        exact hle₀ hv
      refine ⟨U₀, hU₀, W₀, hW₀, hxW₀, hW₀_le, ?_⟩
      have hRangeVW : Set.range (hV₀.fromSpec ≫ j).base = Set.range hW₀.fromSpec.base := by
