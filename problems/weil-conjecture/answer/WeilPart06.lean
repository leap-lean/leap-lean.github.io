        intro P₂ P₁ P₀ hP₂ hP₁ hP₀ h21 h10
        let Q₂ := Ideal.comap eStalk.symm.toRingHom P₂
        let Q₁ := Ideal.comap eStalk.symm.toRingHom P₁
        let Q₀ := Ideal.comap eStalk.symm.toRingHom P₀
        have hQ₂ : Q₂.IsPrime := Ideal.IsPrime.comap eStalk.symm.toRingHom
        have hQ₁ : Q₁.IsPrime := Ideal.IsPrime.comap eStalk.symm.toRingHom
        have hQ₀ : Q₀.IsPrime := Ideal.IsPrime.comap eStalk.symm.toRingHom
        have hMapComap : ∀ P : Ideal ↑(Y.presheaf.stalk y),
            Ideal.comap eStalk.toRingHom (Ideal.comap eStalk.symm.toRingHom P) = P := by
