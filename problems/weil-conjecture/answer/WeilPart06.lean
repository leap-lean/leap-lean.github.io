    have h_sub_eq : (⟨f_gen γ_star, hf_γstar_W⟩ : ↥W) = φ_Ba g_star :=
      Subtype.ext hf_γstar_eq
    refine ⟨ψ_Z, mW, γ_star, hf_γstar_W, hmW, hη_ZW, ?_⟩
    exact (hAlgClosed_crit Q θ_VW hQ_comap ⟨f_gen γ_star, hf_γstar_W⟩).mpr
      (by rw [h_sub_eq]; exact hg_star_not)

  obtain ⟨N_gen, f_gen, hf_ne, hSelectGen⟩ := hExGen_M

  
  have hExSegIdx : ∃ (M_proj : ℕ)
      (eSeg : Fin (M_proj + 1) ≃ Finset (Fin N_gen))
      (a₀ : Fin (M_proj + 1)),
      eSeg a₀ = ∅ := by
    have hCard_pos : 0 < Fintype.card (Finset (Fin N_gen)) := Fintype.card_pos_iff.mpr ⟨∅⟩
    let M_p : ℕ := Fintype.card (Finset (Fin N_gen)) - 1
    have hCard : M_p + 1 = Fintype.card (Finset (Fin N_gen)) := Nat.sub_add_cancel hCard_pos
    let eS : Fin (M_p + 1) ≃ Finset (Fin N_gen) :=
      (Fintype.equivFinOfCardEq hCard.symm).symm
    exact ⟨M_p, eS, eS.symm ∅, eS.apply_symm_apply ∅⟩

  obtain ⟨M_proj, eSeg, a₀, ha₀⟩ := hExSegIdx

  
  have hSegreAbstract :
      ∀ (P_V : AlgebraicGeometry.Scheme.{u})
        (p_PV : P_V ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
        (D : Fin (M_proj + 1) → P_V.Opens)
        (hAff_V : ∀ a : Fin (M_proj + 1), AlgebraicGeometry.IsAffineOpen (D a))
        (c_V : ∀ a : Fin (M_proj + 1),
          ↥V →+* ↑(P_V.presheaf.obj (Opposite.op (D a))))
        (t_V : ∀ a : Fin (M_proj + 1), Fin (M_proj + 1) →
          ↑(P_V.presheaf.obj (Opposite.op (D a)))),
        AlgebraicGeometry.IsProper p_PV →
        (∀ a : Fin (M_proj + 1),
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (c_V a)) =
            (hAff_V a).fromSpec ≫ p_PV) →
        (∀ a : Fin (M_proj + 1), t_V a a = 1) →
        (∀ a : Fin (M_proj + 1),
          Subring.closure (Set.range (c_V a) ∪ Set.range (t_V a)) = ⊤) →
        (∀ (a : Fin (M_proj + 1)) (A : Type u) [CommRing A] (ρ : ↥V →+* A)
            (v : Fin (M_proj + 1) → A),
          v a = 1 →
          ∃ (ψ : ↑(P_V.presheaf.obj (Opposite.op (D a))) →+* A),
            ψ.comp (c_V a) = ρ ∧ ∀ b : Fin (M_proj + 1), ψ (t_V a b) = v b) →
        (∀ a a' : Fin (M_proj + 1), P_V.basicOpen (t_V a a') = D a ⊓ D a') →
        (∀ (a a' : Fin (M_proj + 1)) (r : ↥V),
          (P_V.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom (c_V a' r) =
          (P_V.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (c_V a r)) →
        (∀ (a a' b : Fin (M_proj + 1)),
          (P_V.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom (t_V a' b) *
          (P_V.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (t_V a a') =
          (P_V.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (t_V a b)) →
        ∃ (M_tilde : AlgebraicGeometry.Scheme.{u})
          (π_tilde : M_tilde ⟶ Z)
          (ι_proj : M_tilde ⟶ P_V)
          (η_tilde : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ M_tilde)
          (hComm_proj : ι_proj ≫ p_PV = π_tilde ≫ g_Z),
          AlgebraicGeometry.IsIntegral M_tilde ∧
          AlgebraicGeometry.IsProper π_tilde ∧
          η_tilde ≫ π_tilde = η_Z ∧
          IsSchemeFunctionField M_tilde F η_tilde ∧
          AlgebraicGeometry.IsClosedImmersion
            (CategoryTheory.Limits.pullback.lift ι_proj π_tilde hComm_proj) ∧
          (∀ (W : ValuationSubring F),
            IsValResolvedOnMod V g_Z π (η_UK ≫ ι_M) W →
            (∀ (ψ_Z : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ Z)
                (mW : AlgebraicGeometry.Spec (CommRingCat.of ↥W)),
              mW.asIdeal = IsLocalRing.maximalIdeal ↥W →
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype) ≫ ψ_Z = η_Z →
              (g_Z.base (ψ_Z.base mW)).asIdeal ≠ ⊥) →
            IsValResolvedOnMod V g_Z π_tilde η_tilde W) := by
    intro P_V p_PV D hAff_V c_V t_V hProp_PV hc_from ht_diag h_gen h_univ h_bo h_c_ov h_t_ov
    classical
    let ρ_VF : ↥V →+* F := (AlgebraicGeometry.Spec.preimage (η_Z ≫ g_Z)).hom
    let v_F : Fin (M_proj + 1) → F := fun b => ∏ γ ∈ eSeg b, f_gen γ
    have hv_Fa0 : v_F a₀ = 1 := by
      dsimp only [v_F]
      rw [ha₀, Finset.prod_empty]
    obtain ⟨ψ_F, hψF_c, hψF_t⟩ := h_univ a₀ F ρ_VF v_F hv_Fa0
    let η_Seg : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ P_V :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_F) ≫ (hAff_V a₀).fromSpec
    have hηSeg_p : η_Seg ≫ p_PV = η_Z ≫ g_Z := by
      calc η_Seg ≫ p_PV
          = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_F) ≫ ((hAff_V a₀).fromSpec ≫ p_PV) :=
            Category.assoc _ _ _
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_F) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (c_V a₀)) := by
            rw [← hc_from a₀]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_F.comp (c_V a₀))) := by
            rw [← AlgebraicGeometry.Spec.map_comp, CommRingCat.ofHom_comp]
        _ = AlgebraicGeometry.Spec.map (AlgebraicGeometry.Spec.preimage (η_Z ≫ g_Z)) := by
            rw [hψF_c]; rfl
        _ = η_Z ≫ g_Z := AlgebraicGeometry.Spec.map_preimage _
    let P_Seg := CategoryTheory.Limits.pullback p_PV g_Z
    let fst_Seg := CategoryTheory.Limits.pullback.fst p_PV g_Z
    let snd_Seg := CategoryTheory.Limits.pullback.snd p_PV g_Z
    let Δ_Seg : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ P_Seg :=
      CategoryTheory.Limits.pullback.lift η_Seg η_Z hηSeg_p
    have hImgPkg : ∃ (M_tilde : AlgebraicGeometry.Scheme.{u})
        (j_Seg : M_tilde ⟶ P_Seg)
        (η_tilde : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ M_tilde),
        AlgebraicGeometry.IsClosedImmersion j_Seg ∧
        j_Seg.ker = Δ_Seg.ker ∧
        η_tilde ≫ j_Seg = Δ_Seg ∧
        DenseRange η_tilde.base ∧
        AlgebraicGeometry.IsIntegral M_tilde := by
      have _ : AlgebraicGeometry.QuasiCompact Δ_Seg :=
        AlgebraicGeometry.quasiCompact_of_noetherianSpace_source Δ_Seg
      have hDense : DenseRange Δ_Seg.toImage.base :=
        AlgebraicGeometry.IsDominant.denseRange (f := Δ_Seg.toImage)
      have hInt : AlgebraicGeometry.IsIntegral Δ_Seg.image := by
        have hIrredSF : IrreducibleSpace ↥(AlgebraicGeometry.Spec (CommRingCat.of F)) :=
          AlgebraicGeometry.irreducibleSpace_of_isIntegral _
        obtain ⟨z₀⟩ := hIrredSF.toNonempty
        have hIrredImg : IrreducibleSpace ↥Δ_Seg.image :=
          { isPreirreducible_univ := by
              rw [← hDense.closure_eq, ← Set.image_univ]
              exact (hIrredSF.isPreirreducible_univ.image Δ_Seg.toImage.base
                Δ_Seg.toImage.continuous.continuousOn).closure
            toNonempty := ⟨Δ_Seg.toImage.base z₀⟩ }
        have hStalkRed : ∀ x : ↥Δ_Seg.image, _root_.IsReduced ↑(Δ_Seg.image.presheaf.stalk x) := by
          intro x
          obtain ⟨_, ⟨U, hU, rfl⟩, hxU, -⟩ :=
            P_Seg.isBasis_affineOpens.exists_subset_of_mem_open
              (Set.mem_univ (Δ_Seg.imageι.base x)) isOpen_univ
          let U' : Δ_Seg.image.Opens := Δ_Seg.imageι ⁻¹ᵁ U
          have hxU' : x ∈ U' := hxU
          have hU' : AlgebraicGeometry.IsAffineOpen U' := hU.preimage Δ_Seg.imageι
          let e_sub := Δ_Seg.ker.subschemeObjIso ⟨U, hU⟩
          have h_ker_sub : ∀ a ∈ Δ_Seg.ker.ideal ⟨U, hU⟩, (Δ_Seg.app U).hom a = 0 := by
            intro a ha
            rw [AlgebraicGeometry.Scheme.Hom.ker_apply] at ha
            exact ha
          let φ_inj : (↑Γ(P_Seg, U) ⧸ Δ_Seg.ker.ideal ⟨U, hU⟩) →+*
              ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of F), Δ_Seg ⁻¹ᵁ U) :=
            Ideal.Quotient.lift (Δ_Seg.ker.ideal ⟨U, hU⟩) (Δ_Seg.app U).hom h_ker_sub
          have hφ_inj : Function.Injective φ_inj := by
            rw [RingHom.injective_iff_ker_eq_bot, eq_bot_iff]
            intro q hq
            obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective q
            rw [RingHom.mem_ker] at hq
            have hq' : (Δ_Seg.app U).hom a = 0 := by simpa [φ_inj] using hq
            have ha : a ∈ Δ_Seg.ker.ideal ⟨U, hU⟩ := by
              rw [AlgebraicGeometry.Scheme.Hom.ker_apply]
              exact hq'
            exact (Submodule.mem_bot _).mpr (Ideal.Quotient.eq_zero_iff_mem.mpr ha)
          have hRedΓ : _root_.IsReduced ↑Γ(Δ_Seg.image, U') :=
            isReduced_of_injective (φ_inj.comp e_sub.hom.hom)
              (hφ_inj.comp e_sub.commRingCatIsoToRingEquiv.injective)
          have hRedSpec : AlgebraicGeometry.IsReduced (AlgebraicGeometry.Spec Γ(Δ_Seg.image, U')) :=
            (AlgebraicGeometry.affine_isReduced_iff Γ(Δ_Seg.image, U')).mpr hRedΓ
          have hRedU' : AlgebraicGeometry.IsReduced U'.toScheme :=
            @AlgebraicGeometry.isReduced_of_isOpenImmersion _ _ hU'.isoSpec.hom
              inferInstance hRedSpec
          have hStalkU' : _root_.IsReduced ↑(U'.toScheme.presheaf.stalk ⟨x, hxU'⟩) :=
            @AlgebraicGeometry.isReduced_stalk_of_isReduced U'.toScheme hRedU' ⟨x, hxU'⟩
          let e_stalk := (U'.stalkIso ⟨x, hxU'⟩).symm
          exact isReduced_of_injective e_stalk.hom.hom e_stalk.commRingCatIsoToRingEquiv.injective
        have hRedImg : AlgebraicGeometry.IsReduced Δ_Seg.image :=
          @AlgebraicGeometry.isReduced_of_isReduced_stalk Δ_Seg.image hStalkRed
        exact (AlgebraicGeometry.isIntegral_iff_irreducibleSpace_and_isReduced Δ_Seg.image).mpr
          ⟨hIrredImg, hRedImg⟩
      exact ⟨Δ_Seg.image, Δ_Seg.imageι, Δ_Seg.toImage, inferInstance,
        AlgebraicGeometry.Scheme.IdealSheafData.ker_subschemeι Δ_Seg.ker,
        AlgebraicGeometry.Scheme.Hom.toImage_imageι Δ_Seg, hDense, hInt⟩
    obtain ⟨M_tilde, j_Seg, η_tilde, hCl_j, hKer_j, hToImg_j, hDense_ηtilde, hInt_Mtilde⟩ :=
      hImgPkg
    have _ : AlgebraicGeometry.IsClosedImmersion j_Seg := hCl_j
    let ι_proj : M_tilde ⟶ P_V := j_Seg ≫ fst_Seg
    let π_tilde : M_tilde ⟶ Z := j_Seg ≫ snd_Seg
    have hComm_proj : ι_proj ≫ p_PV = π_tilde ≫ g_Z := by
      dsimp only [ι_proj, π_tilde]
      rw [Category.assoc, Category.assoc, CategoryTheory.Limits.pullback.condition]
    have hLift_eq_j : CategoryTheory.Limits.pullback.lift ι_proj π_tilde hComm_proj = j_Seg := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · exact CategoryTheory.Limits.pullback.lift_fst _ _ _
      · exact CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hCl_proj : AlgebraicGeometry.IsClosedImmersion
        (CategoryTheory.Limits.pullback.lift ι_proj π_tilde hComm_proj) := by
      rw [hLift_eq_j]
      exact hCl_j
    have _ : AlgebraicGeometry.IsProper p_PV := hProp_PV
    have _ : AlgebraicGeometry.IsProper snd_Seg :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (P := @AlgebraicGeometry.IsProper)
        (CategoryTheory.IsPullback.of_hasPullback p_PV g_Z) hProp_PV
    have hProp_πtilde : AlgebraicGeometry.IsProper π_tilde := inferInstance
    have hη_πtilde : η_tilde ≫ π_tilde = η_Z := by
      dsimp only [π_tilde]
      rw [← Category.assoc, hToImg_j, CategoryTheory.Limits.pullback.lift_snd]
    have hFunc_Mtilde : IsSchemeFunctionField M_tilde F η_tilde := by
      intro U hU hUne
      have _ : IsDomain ↑(M_tilde.presheaf.obj (Opposite.op U)) :=
        @AlgebraicGeometry.IsIntegral.component_integral M_tilde hInt_Mtilde U hUne
      let pt₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of F)) := ⟨⊥, inferInstance⟩
      have hSub_pt : ∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of F)), pt = pt₀ :=
        fun pt => PrimeSpectrum.ext (@Ideal.eq_bot_of_prime _ _ pt.asIdeal pt.2)
      have hpt₀_mem : ∀ (O : M_tilde.Opens), Nonempty ↥O → η_tilde.base pt₀ ∈ O := by
        intro O ⟨⟨y₀, hy₀⟩⟩
        obtain ⟨_, hyO, ⟨pt, hpt_eq⟩⟩ :=
          hDense_ηtilde.inter_open_nonempty (O : Set ↥M_tilde) O.isOpen ⟨y₀, hy₀⟩
        rw [← hSub_pt pt, hpt_eq]
        exact hyO
      have hpt₀_U : η_tilde.base pt₀ ∈ U := hpt₀_mem U hUne
      have hRange_U : Set.range η_tilde.base ⊆ Set.range hU.fromSpec.base := by
        rw [hU.range_fromSpec]
        rintro _ ⟨pt, rfl⟩
        rw [hSub_pt pt]
        exact hpt₀_U
      let lift_U := AlgebraicGeometry.IsOpenImmersion.lift hU.fromSpec η_tilde hRange_U
      let φ_U := AlgebraicGeometry.Spec.preimage lift_U
      have hSpec_U : AlgebraicGeometry.Spec.map φ_U ≫ hU.fromSpec = η_tilde := by
        rw [AlgebraicGeometry.Spec.map_preimage,
          AlgebraicGeometry.IsOpenImmersion.lift_fac hU.fromSpec η_tilde hRange_U]
      have hφU_inj : Function.Injective φ_U.hom := by
        rw [RingHom.injective_iff_ker_eq_bot, eq_bot_iff]
        intro x hx
        rw [RingHom.mem_ker] at hx
        by_contra hx0
        let p_bot : ↥(AlgebraicGeometry.Spec (M_tilde.presheaf.obj (Opposite.op U))) :=
          ⟨⊥, inferInstance⟩
        have hp_bo : hU.fromSpec.base p_bot ∈ M_tilde.basicOpen x := by
          change p_bot ∈ (TopologicalSpace.Opens.map hU.fromSpec.base).obj (M_tilde.basicOpen x)
          rw [hU.fromSpec_preimage_basicOpen x]
          change x ∉ (⊥ : Ideal _)
          simpa using hx0
        have hpt_bo : η_tilde.base pt₀ ∈ M_tilde.basicOpen x :=
          hpt₀_mem (M_tilde.basicOpen x) ⟨⟨hU.fromSpec.base p_bot, hp_bo⟩⟩
        rw [← hSpec_U] at hpt_bo
        change (AlgebraicGeometry.Spec.map φ_U).base pt₀ ∈
          (TopologicalSpace.Opens.map hU.fromSpec.base).obj (M_tilde.basicOpen x) at hpt_bo
        rw [hU.fromSpec_preimage_basicOpen x] at hpt_bo
        have hx_not : φ_U.hom x ∉ pt₀.asIdeal := hpt_bo
        exact hx_not (hx ▸ pt₀.asIdeal.zero_mem)
      obtain ⟨U_Z, hUZ, hz₀_UZ, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := (⊤ : Z.Opens))
          (x := η_Z.base pt₀) trivial
      obtain ⟨φ_Z, hFrac_Z, hSpec_Z⟩ := hFunc_Z U_Z hUZ ⟨⟨η_Z.base pt₀, hz₀_UZ⟩⟩
      have hpt₀_preUZ : η_tilde.base pt₀ ∈ (TopologicalSpace.Opens.map π_tilde.base).obj U_Z := by
        change (η_tilde ≫ π_tilde).base pt₀ ∈ U_Z
        rw [hη_πtilde]
        exact hz₀_UZ
      obtain ⟨r, hBr_le, hpt₀_Br⟩ :=
        hU.exists_basicOpen_le (V := U ⊓ (TopologicalSpace.Opens.map π_tilde.base).obj U_Z)
          ⟨η_tilde.base pt₀, ⟨hpt₀_U, hpt₀_preUZ⟩⟩ hpt₀_U
      have hr_ne : r ≠ 0 := by
        intro hr0
        rw [hr0, AlgebraicGeometry.Scheme.basicOpen_zero] at hpt₀_Br
        exact hpt₀_Br
      let B_r : M_tilde.Opens := M_tilde.basicOpen r
      have hBr : AlgebraicGeometry.IsAffineOpen B_r := hU.basicOpen r
      have hRange_Br : Set.range η_tilde.base ⊆ Set.range hBr.fromSpec.base := by
        rw [hBr.range_fromSpec]
        rintro _ ⟨pt, rfl⟩
        rw [hSub_pt pt]
        exact hpt₀_Br
      let φ_Br := AlgebraicGeometry.Spec.preimage
        (AlgebraicGeometry.IsOpenImmersion.lift hBr.fromSpec η_tilde hRange_Br)
      have hSpec_Br : AlgebraicGeometry.Spec.map φ_Br ≫ hBr.fromSpec = η_tilde := by
        rw [AlgebraicGeometry.Spec.map_preimage,
          AlgebraicGeometry.IsOpenImmersion.lift_fac hBr.fromSpec η_tilde hRange_Br]
      let res_r := M_tilde.presheaf.map (CategoryTheory.homOfLE (M_tilde.basicOpen_le r)).op
      have hres_φ : res_r ≫ φ_Br = φ_U := by
        apply AlgebraicGeometry.Spec.map_injective
        apply (cancel_mono hU.fromSpec).mp
        rw [AlgebraicGeometry.Spec.map_comp, Category.assoc,
          hU.map_fromSpec hBr (CategoryTheory.homOfLE (M_tilde.basicOpen_le r)).op,
          hSpec_Br, hSpec_U]
      let α_ZBr := π_tilde.appLE U_Z B_r (hBr_le.trans inf_le_right)
      have hα_φ : α_ZBr ≫ φ_Br = φ_Z := by
        apply AlgebraicGeometry.Spec.map_injective
        apply (cancel_mono hUZ.fromSpec).mp
        rw [AlgebraicGeometry.Spec.map_comp, Category.assoc,
          AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec π_tilde hUZ hBr
            (hBr_le.trans inf_le_right),
          ← Category.assoc, hSpec_Br, hη_πtilde, hSpec_Z]
      let _ : Algebra ↑(M_tilde.presheaf.obj (Opposite.op U))
          ↑(M_tilde.presheaf.obj (Opposite.op B_r)) := res_r.hom.toAlgebra
      have hLoc_r : @IsLocalization.Away ↑(M_tilde.presheaf.obj (Opposite.op U)) _ r
          ↑(M_tilde.presheaf.obj (Opposite.op B_r)) _ res_r.hom.toAlgebra :=
        hU.isLocalization_basicOpen r
      let _ : Algebra ↑(M_tilde.presheaf.obj (Opposite.op U)) F := φ_U.hom.toAlgebra
      refine ⟨φ_U, { map_units := ?_, surj := ?_, exists_of_eq := ?_ }, hSpec_U⟩
      · intro y
        have hy0 : y.1 ≠ 0 := nonZeroDivisors.ne_zero y.2
        exact isUnit_iff_ne_zero.mpr fun h => hy0 (hφU_inj (h.trans (map_zero _).symm))
      · intro z
        obtain ⟨⟨a_Z, s_Z⟩, hzs⟩ :=
          @IsLocalization.surj _ _ (nonZeroDivisors _) F _ φ_Z.hom.toAlgebra hFrac_Z z
        have hu_sZ : IsUnit (φ_Z.hom s_Z.1) :=
          @IsLocalization.map_units _ _ (nonZeroDivisors _) F _ φ_Z.hom.toAlgebra hFrac_Z s_Z
        have hsZ_ne : φ_Z.hom s_Z.1 ≠ 0 := hu_sZ.ne_zero
        obtain ⟨⟨a_num, ⟨_, k, rfl⟩⟩, ha₀_eq⟩ :=
          @IsLocalization.surj _ _ (Submonoid.powers r) _ _ res_r.hom.toAlgebra hLoc_r
            (α_ZBr.hom a_Z)
        obtain ⟨⟨b_den, ⟨_, l, rfl⟩⟩, hb₀_eq⟩ :=
          @IsLocalization.surj _ _ (Submonoid.powers r) _ _ res_r.hom.toAlgebra hLoc_r
            (α_ZBr.hom s_Z.1)
        have hφr_ne : φ_U.hom r ≠ 0 := fun h => hr_ne (hφU_inj (h.trans (map_zero _).symm))
        have ha₀' : φ_U.hom a_num = φ_Z.hom a_Z * (φ_U.hom r) ^ k := by
          have h1 := congrArg φ_Br.hom ha₀_eq.symm
          have h_lhs : φ_Br.hom (res_r.hom a_num) = φ_U.hom a_num :=
            congrArg (fun g => g.hom a_num) hres_φ
          have h_rk : φ_Br.hom (res_r.hom (r ^ k)) = (φ_U.hom r) ^ k := by
            rw [map_pow, map_pow]
            exact congrArg (· ^ k) (congrArg (fun g => g.hom r) hres_φ)
          have h_aZ : φ_Br.hom (α_ZBr.hom a_Z) = φ_Z.hom a_Z :=
            congrArg (fun g => g.hom a_Z) hα_φ
          change φ_Br.hom (res_r.hom a_num) = φ_Br.hom (α_ZBr.hom a_Z * res_r.hom (r ^ k)) at h1
          rw [map_mul, h_lhs, h_aZ, h_rk] at h1
          exact h1
        have hb₀' : φ_U.hom b_den = φ_Z.hom s_Z.1 * (φ_U.hom r) ^ l := by
          have h1 := congrArg φ_Br.hom hb₀_eq.symm
          have h_lhs : φ_Br.hom (res_r.hom b_den) = φ_U.hom b_den :=
            congrArg (fun g => g.hom b_den) hres_φ
          have h_rl : φ_Br.hom (res_r.hom (r ^ l)) = (φ_U.hom r) ^ l := by
            rw [map_pow, map_pow]
            exact congrArg (· ^ l) (congrArg (fun g => g.hom r) hres_φ)
          have h_sZ : φ_Br.hom (α_ZBr.hom s_Z.1) = φ_Z.hom s_Z.1 :=
            congrArg (fun g => g.hom s_Z.1) hα_φ
          change φ_Br.hom (res_r.hom b_den) = φ_Br.hom (α_ZBr.hom s_Z.1 * res_r.hom (r ^ l)) at h1
          rw [map_mul, h_lhs, h_sZ, h_rl] at h1
          exact h1
        have hb₀_ne : b_den ≠ 0 := by
          intro h0
          have h_z0 : φ_Z.hom s_Z.1 * (φ_U.hom r) ^ l = 0 := by
            rw [← hb₀', h0, map_zero]
          exact mul_ne_zero hsZ_ne (pow_ne_zero l hφr_ne) h_z0
        have hd_mem : b_den * r ^ k ∈ nonZeroDivisors ↑(M_tilde.presheaf.obj (Opposite.op U)) :=
          mem_nonZeroDivisors_of_ne_zero (mul_ne_zero hb₀_ne (pow_ne_zero k hr_ne))
        refine ⟨⟨a_num * r ^ l, ⟨b_den * r ^ k, hd_mem⟩⟩, ?_⟩
        change z * φ_U.hom (b_den * r ^ k) = φ_U.hom (a_num * r ^ l)
        have hzs' : z * φ_Z.hom s_Z.1 = φ_Z.hom a_Z := hzs
        rw [map_mul, map_mul, map_pow, map_pow, ha₀', hb₀']
        calc z * (φ_Z.hom s_Z.1 * φ_U.hom r ^ l * φ_U.hom r ^ k)
            = (z * φ_Z.hom s_Z.1) * φ_U.hom r ^ l * φ_U.hom r ^ k := by ring
          _ = φ_Z.hom a_Z * φ_U.hom r ^ l * φ_U.hom r ^ k := by rw [hzs']
          _ = φ_Z.hom a_Z * φ_U.hom r ^ k * φ_U.hom r ^ l := by ring
      · intro x y hxy
        exact ⟨⟨1, Submonoid.one_mem _⟩, by simp [hφU_inj hxy]⟩

    have hValTransfer : ∀ (W : ValuationSubring F),
        IsValResolvedOnMod V g_Z π (η_UK ≫ ι_M) W →
        (∀ (ψ_Z : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ Z)
            (mW : AlgebraicGeometry.Spec (CommRingCat.of ↥W)),
          mW.asIdeal = IsLocalRing.maximalIdeal ↥W →
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype) ≫ ψ_Z = η_Z →
          (g_Z.base (ψ_Z.base mW)).asIdeal ≠ ⊥) →
        IsValResolvedOnMod V g_Z π_tilde η_tilde W := by
      intro W hRes_M hNonzero
      obtain ⟨ψ_Z, mW, γ_star, hf_γstar_W, hmW, hη_ZW, hPoly_γstar⟩ :=
        hSelectGen W hRes_M hNonzero
      let θ_VW : ↥V →+* ↥W := (AlgebraicGeometry.Spec.preimage (ψ_Z ≫ g_Z)).hom
      have hθ_ρ : W.subtype.comp θ_VW = ρ_VF := by
        have hSpec_eq : AlgebraicGeometry.Spec.map
            (AlgebraicGeometry.Spec.preimage (ψ_Z ≫ g_Z) ≫ CommRingCat.ofHom W.subtype) =
            η_Z ≫ g_Z := by
          rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
            ← Category.assoc, hη_ZW]
        have h_pre := congrArg AlgebraicGeometry.Spec.preimage hSpec_eq
        rw [AlgebraicGeometry.Spec.preimage_map] at h_pre
        exact congrArg CommRingCat.Hom.hom h_pre
      let I_W : Finset (Fin N_gen) := Finset.univ.filter fun γ => f_gen γ ∉ W
      have h_in_W : ∀ {γ : Fin N_gen}, γ ∉ I_W → f_gen γ ∈ W := by
        intro γ hnot
        by_contra hnotW
        exact hnot (Finset.mem_filter.mpr ⟨Finset.mem_univ γ, hnotW⟩)
      have h_inv_W : ∀ {γ : Fin N_gen}, γ ∈ I_W → (f_gen γ)⁻¹ ∈ W := by
        intro γ hmem
        rcases ValuationSubring.mem_or_inv_mem W (f_gen γ) with hw | hwi
        · exact False.elim ((Finset.mem_filter.mp hmem).2 hw)
        · exact hwi
      have hγ_not_IW : γ_star ∉ I_W := by
        intro hmem
        exact (Finset.mem_filter.mp hmem).2 hf_γstar_W
      let a_W : Fin (M_proj + 1) := eSeg.symm I_W
      let b_star : Fin (M_proj + 1) := eSeg.symm (insert γ_star I_W)
      have he_aW : eSeg a_W = I_W := eSeg.apply_symm_apply I_W
      have he_bstar : eSeg b_star = insert γ_star I_W := eSeg.apply_symm_apply _
      let v_W : Fin (M_proj + 1) → ↥W := fun b =>
        (∏ x ∈ (eSeg b \ I_W).attach,
          (⟨f_gen x.1, h_in_W (Finset.mem_sdiff.mp x.2).2⟩ : ↥W)) *
        (∏ y ∈ (I_W \ eSeg b).attach,
          (⟨(f_gen y.1)⁻¹, h_inv_W (Finset.mem_sdiff.mp y.2).1⟩ : ↥W))
      have hv_W_coe : ∀ b : Fin (M_proj + 1),
          W.subtype (v_W b) =
            (∏ γ ∈ eSeg b \ I_W, f_gen γ) * (∏ γ ∈ I_W \ eSeg b, (f_gen γ)⁻¹) := by
        intro b
        dsimp only [v_W]
        rw [map_mul, map_prod, map_prod]
        congr 1
        · exact Finset.prod_attach (eSeg b \ I_W) f_gen
        · exact Finset.prod_attach (I_W \ eSeg b) (fun γ => (f_gen γ)⁻¹)
      have hv_W_aW : v_W a_W = 1 := by
        apply Subtype.ext
        change W.subtype (v_W a_W) = 1
        rw [hv_W_coe a_W, he_aW, Finset.sdiff_self, Finset.prod_empty, Finset.prod_empty, mul_one]
      have hv_W_bstar : v_W b_star = ⟨f_gen γ_star, hf_γstar_W⟩ := by
        apply Subtype.ext
        change W.subtype (v_W b_star) = f_gen γ_star
        rw [hv_W_coe b_star, he_bstar]
        have hd1 : insert γ_star I_W \ I_W = {γ_star} := by
          ext u
          simp only [Finset.mem_sdiff, Finset.mem_insert, Finset.mem_singleton]
          exact ⟨fun ⟨h1, h2⟩ => h1.resolve_right h2, fun h => ⟨Or.inl h, h ▸ hγ_not_IW⟩⟩
        have hd2 : I_W \ insert γ_star I_W = ∅ := by
          ext u
          simp only [Finset.mem_sdiff, Finset.mem_insert, Finset.notMem_empty, iff_false, not_and]
          exact fun hu hnu => hnu (Or.inr hu)
        rw [hd1, hd2, Finset.prod_singleton, Finset.prod_empty, mul_one]
      have hv_F_ne : ∀ b : Fin (M_proj + 1), v_F b ≠ 0 :=
        fun b => Finset.prod_ne_zero_iff.mpr fun γ _ => hf_ne γ
      have hv_cocycle : ∀ b : Fin (M_proj + 1), W.subtype (v_W b) * v_F a_W = v_F b := by
        intro b
        let J := eSeg b
        rw [hv_W_coe b]
        change ((∏ γ ∈ J \ I_W, f_gen γ) * (∏ γ ∈ I_W \ J, (f_gen γ)⁻¹)) *
          (∏ γ ∈ eSeg a_W, f_gen γ) = ∏ γ ∈ J, f_gen γ
        rw [he_aW]
        have h_IW_split : (∏ γ ∈ I_W, f_gen γ) =
            (∏ γ ∈ I_W \ J, f_gen γ) * (∏ γ ∈ I_W ∩ J, f_gen γ) := by
          rw [← Finset.prod_union (Finset.disjoint_sdiff_inter I_W J), Finset.sdiff_union_inter]
        have h_J_split : (∏ γ ∈ J, f_gen γ) =
            (∏ γ ∈ J \ I_W, f_gen γ) * (∏ γ ∈ J ∩ I_W, f_gen γ) := by
          rw [← Finset.prod_union (Finset.disjoint_sdiff_inter J I_W), Finset.sdiff_union_inter]
        have h_cancel : (∏ γ ∈ I_W \ J, (f_gen γ)⁻¹) * (∏ γ ∈ I_W \ J, f_gen γ) = 1 := by
          rw [← Finset.prod_mul_distrib]
          exact Finset.prod_eq_one fun γ _ => inv_mul_cancel₀ (hf_ne γ)
        rw [h_IW_split, h_J_split, Finset.inter_comm I_W J]
        calc ((∏ γ ∈ J \ I_W, f_gen γ) * (∏ γ ∈ I_W \ J, (f_gen γ)⁻¹)) *
              ((∏ γ ∈ I_W \ J, f_gen γ) * (∏ γ ∈ J ∩ I_W, f_gen γ))
            = (∏ γ ∈ J \ I_W, f_gen γ) *
                ((∏ γ ∈ I_W \ J, (f_gen γ)⁻¹) * (∏ γ ∈ I_W \ J, f_gen γ)) *
                (∏ γ ∈ J ∩ I_W, f_gen γ) := by ring
          _ = (∏ γ ∈ J \ I_W, f_gen γ) * 1 * (∏ γ ∈ J ∩ I_W, f_gen γ) := by rw [h_cancel]
          _ = (∏ γ ∈ J \ I_W, f_gen γ) * (∏ γ ∈ J ∩ I_W, f_gen γ) := by ring
      obtain ⟨ψ_W_chart, hψW_c, hψW_t⟩ := h_univ a_W ↥W θ_VW v_W hv_W_aW
      let D_0 := D a₀
      let D_W := D a_W
      let ψ_SegW : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ P_V :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_W_chart) ≫ (hAff_V a_W).fromSpec
      let j_W : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of ↥W) :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype)
      have h_seg_eq : j_W ≫ ψ_SegW = η_Seg := by
        let r_0W := t_V a₀ a_W
        let r_W0 := t_V a_W a₀
        let U_0W : P_V.Opens := P_V.basicOpen r_0W
        have hU_0W : AlgebraicGeometry.IsAffineOpen U_0W := (hAff_V a₀).basicOpen r_0W
        have hB_0W : U_0W = D_0 ⊓ D_W := h_bo a₀ a_W
        have hB_W0 : P_V.basicOpen r_W0 = D_W ⊓ D_0 := h_bo a_W a₀
        let η_W := j_W ≫ ψ_SegW
        have hη_W_eq : η_W = AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (W.subtype.comp ψ_W_chart)) ≫ (hAff_V a_W).fromSpec := by
          dsimp only [η_W, j_W, ψ_SegW]
          rw [← Category.assoc, ← AlgebraicGeometry.Spec.map_comp, CommRingCat.ofHom_comp]
        have hRange_1 : Set.range η_Seg.base ⊆ Set.range hU_0W.fromSpec.base := by
          rw [hU_0W.range_fromSpec]
          rintro _ ⟨pt, rfl⟩
          have hpt_bot : pt.asIdeal = ⊥ := @Ideal.eq_bot_of_prime _ _ pt.asIdeal pt.2
          change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_F)).base pt ∈
            (TopologicalSpace.Opens.map (hAff_V a₀).fromSpec.base).obj (P_V.basicOpen r_0W)
          rw [(hAff_V a₀).fromSpec_preimage_basicOpen r_0W]
          change ψ_F r_0W ∉ pt.asIdeal
          rw [hpt_bot, Ideal.mem_bot, hψF_t a_W]
          exact hv_F_ne a_W
        have hv_Wa0_ne : W.subtype (v_W a₀) ≠ 0 := by
          have hmul := hv_cocycle a₀
          rw [hv_Fa0] at hmul
          exact left_ne_zero_of_mul_eq_one hmul
        have hRange_2 : Set.range η_W.base ⊆ Set.range hU_0W.fromSpec.base := by
          rw [hU_0W.range_fromSpec, hB_0W, inf_comm, ← hB_W0, hη_W_eq]
          rintro _ ⟨pt, rfl⟩
          have hpt_bot : pt.asIdeal = ⊥ := @Ideal.eq_bot_of_prime _ _ pt.asIdeal pt.2
          change (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (W.subtype.comp ψ_W_chart))).base pt ∈
            (TopologicalSpace.Opens.map (hAff_V a_W).fromSpec.base).obj (P_V.basicOpen r_W0)
          rw [(hAff_V a_W).fromSpec_preimage_basicOpen r_W0]
          change W.subtype (ψ_W_chart r_W0) ∉ pt.asIdeal
          rw [hpt_bot, Ideal.mem_bot, hψW_t a₀]
          exact hv_Wa0_ne
        let θ₁ := AlgebraicGeometry.Spec.preimage
          (AlgebraicGeometry.IsOpenImmersion.lift hU_0W.fromSpec η_Seg hRange_1)
        let θ₂ := AlgebraicGeometry.Spec.preimage
          (AlgebraicGeometry.IsOpenImmersion.lift hU_0W.fromSpec η_W hRange_2)
        have hSpec_θ₁ : AlgebraicGeometry.Spec.map θ₁ ≫ hU_0W.fromSpec = η_Seg := by
          rw [AlgebraicGeometry.Spec.map_preimage,
            AlgebraicGeometry.IsOpenImmersion.lift_fac hU_0W.fromSpec η_Seg hRange_1]
        have hSpec_θ₂ : AlgebraicGeometry.Spec.map θ₂ ≫ hU_0W.fromSpec = η_W := by
          rw [AlgebraicGeometry.Spec.map_preimage,
            AlgebraicGeometry.IsOpenImmersion.lift_fac hU_0W.fromSpec η_W hRange_2]
        let res_0 := P_V.presheaf.map (CategoryTheory.homOfLE (P_V.basicOpen_le r_0W)).op
        have hle_W : U_0W ≤ D_W := hB_0W.le.trans inf_le_right
        let res_W := P_V.presheaf.map (CategoryTheory.homOfLE hle_W).op
        have hθ₁_res : res_0 ≫ θ₁ = CommRingCat.ofHom ψ_F := by
          apply AlgebraicGeometry.Spec.map_injective
          apply (cancel_mono (hAff_V a₀).fromSpec).mp
          rw [AlgebraicGeometry.Spec.map_comp, Category.assoc,
            (hAff_V a₀).map_fromSpec hU_0W (CategoryTheory.homOfLE (P_V.basicOpen_le r_0W)).op,
            hSpec_θ₁]
        have hθ₂_resW : res_W ≫ θ₂ = CommRingCat.ofHom (W.subtype.comp ψ_W_chart) := by
          apply AlgebraicGeometry.Spec.map_injective
          apply (cancel_mono (hAff_V a_W).fromSpec).mp
          rw [AlgebraicGeometry.Spec.map_comp, Category.assoc,
            (hAff_V a_W).map_fromSpec hU_0W (CategoryTheory.homOfLE hle_W).op,
            hSpec_θ₂, hη_W_eq]
        let map_eq := P_V.presheaf.map (CategoryTheory.homOfLE hB_0W.le).op
        have hres_0_fac : res_0 =
            P_V.presheaf.map (CategoryTheory.homOfLE inf_le_left).op ≫ map_eq := by
          change P_V.presheaf.map _ = _
          rw [← P_V.presheaf.map_comp, ← op_comp]
          congr 2
        have hres_W_fac : res_W =
            P_V.presheaf.map (CategoryTheory.homOfLE inf_le_right).op ≫ map_eq := by
          change P_V.presheaf.map _ = _
          rw [← P_V.presheaf.map_comp, ← op_comp]
          congr 2
        have h_c_compat : ∀ r : ↥V, res_W.hom (c_V a_W r) = res_0.hom (c_V a₀ r) := by
          intro r
          rw [hres_W_fac, hres_0_fac]
          exact congrArg map_eq.hom (h_c_ov a₀ a_W r)
        have h_t_compat : ∀ b : Fin (M_proj + 1),
            res_W.hom (t_V a_W b) * res_0.hom r_0W = res_0.hom (t_V a₀ b) := by
          intro b
          have h10 := congrArg map_eq.hom (h_t_ov a₀ a_W b)
          rw [map_mul] at h10
          rwa [hres_W_fac, hres_0_fac]
        have hθ₂_r0W : θ₂.hom (res_0.hom r_0W) = v_F a_W := by
          have h_mul1 := congrArg θ₂.hom (h_t_compat a₀)
          rw [map_mul, ht_diag a₀, map_one, map_one] at h_mul1
          have h_lhs : θ₂.hom (res_W.hom (t_V a_W a₀)) = W.subtype (v_W a₀) := by
            have h1 := congrArg (fun g => g.hom (t_V a_W a₀)) hθ₂_resW
            change θ₂.hom (res_W.hom (t_V a_W a₀)) = W.subtype (ψ_W_chart (t_V a_W a₀)) at h1
            rwa [hψW_t a₀] at h1
          rw [h_lhs] at h_mul1
          have h_mul2 := hv_cocycle a₀
          rw [hv_Fa0] at h_mul2
          exact mul_left_cancel₀ hv_Wa0_ne (h_mul1.trans h_mul2.symm)
        have h_comp_eq : θ₁.hom.comp res_0.hom = θ₂.hom.comp res_0.hom := by
          let eq_sub := RingHom.eqLocus (θ₁.hom.comp res_0.hom) (θ₂.hom.comp res_0.hom)
          have h_sub_top : eq_sub = ⊤ := by
            rw [eq_top_iff, ← h_gen a₀, Subring.closure_le]
            rintro x (⟨r, rfl⟩ | ⟨b, rfl⟩)
            · change θ₁.hom (res_0.hom (c_V a₀ r)) = θ₂.hom (res_0.hom (c_V a₀ r))
              have h1 : θ₁.hom (res_0.hom (c_V a₀ r)) = ρ_VF r := by
                have ha := congrArg (fun g => g.hom (c_V a₀ r)) hθ₁_res
                change θ₁.hom (res_0.hom (c_V a₀ r)) = ψ_F (c_V a₀ r) at ha
                exact ha.trans (congrFun (congrArg DFunLike.coe hψF_c) r)
              have h2 : θ₂.hom (res_0.hom (c_V a₀ r)) = ρ_VF r := by
                rw [← h_c_compat r]
                have ha := congrArg (fun g => g.hom (c_V a_W r)) hθ₂_resW
                change θ₂.hom (res_W.hom (c_V a_W r)) = W.subtype (ψ_W_chart (c_V a_W r)) at ha
                have hb : ψ_W_chart (c_V a_W r) = θ_VW r :=
                  congrFun (congrArg DFunLike.coe hψW_c) r
                rw [ha, hb]
                exact congrFun (congrArg DFunLike.coe hθ_ρ) r
              exact h1.trans h2.symm
            · change θ₁.hom (res_0.hom (t_V a₀ b)) = θ₂.hom (res_0.hom (t_V a₀ b))
              have h1 : θ₁.hom (res_0.hom (t_V a₀ b)) = v_F b := by
                have ha := congrArg (fun g => g.hom (t_V a₀ b)) hθ₁_res
                change θ₁.hom (res_0.hom (t_V a₀ b)) = ψ_F (t_V a₀ b) at ha
                exact ha.trans (hψF_t b)
              have h2 : θ₂.hom (res_0.hom (t_V a₀ b)) = v_F b := by
                rw [← h_t_compat b, map_mul, hθ₂_r0W]
                have ha := congrArg (fun g => g.hom (t_V a_W b)) hθ₂_resW
                change θ₂.hom (res_W.hom (t_V a_W b)) = W.subtype (ψ_W_chart (t_V a_W b)) at ha
                rw [ha, hψW_t b]
                exact hv_cocycle b
              exact h1.trans h2.symm
          ext x
          have hx : x ∈ eq_sub := by rw [h_sub_top]; trivial
          exact hx
        let _ : Algebra ↑(P_V.presheaf.obj (Opposite.op D_0))
            ↑(P_V.presheaf.obj (Opposite.op U_0W)) := res_0.hom.toAlgebra
        have hLoc_0W : @IsLocalization.Away _ _ r_0W ↑(P_V.presheaf.obj (Opposite.op U_0W)) _
            res_0.hom.toAlgebra := (hAff_V a₀).isLocalization_basicOpen r_0W
        have hθ_hom_eq : θ₁.hom = θ₂.hom :=
          @IsLocalization.ringHom_ext _ _ (Submonoid.powers r_0W) _ _ res_0.hom.toAlgebra hLoc_0W
            F _ θ₁.hom θ₂.hom h_comp_eq
        have hθ_eq : θ₁ = θ₂ := by
          ext x
          exact congrFun (congrArg DFunLike.coe hθ_hom_eq) x
        exact hSpec_θ₂.symm.trans (by rw [← hθ_eq, hSpec_θ₁])
      have hψSegW_p : ψ_SegW ≫ p_PV = ψ_Z ≫ g_Z := by
        calc ψ_SegW ≫ p_PV
            = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_W_chart) ≫
                ((hAff_V a_W).fromSpec ≫ p_PV) := Category.assoc _ _ _
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_W_chart) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom (c_V a_W)) := by
              rw [← hc_from a_W]
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_W_chart.comp (c_V a_W))) := by
              rw [← AlgebraicGeometry.Spec.map_comp, CommRingCat.ofHom_comp]
          _ = AlgebraicGeometry.Spec.map (AlgebraicGeometry.Spec.preimage (ψ_Z ≫ g_Z)) := by
              rw [hψW_c]; rfl
          _ = ψ_Z ≫ g_Z := AlgebraicGeometry.Spec.map_preimage _
      let δ_W : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ P_Seg :=
        CategoryTheory.Limits.pullback.lift ψ_SegW ψ_Z hψSegW_p
      have hjW_δW : j_W ≫ δ_W = Δ_Seg := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
            CategoryTheory.Limits.pullback.lift_fst]
          exact h_seg_eq
        · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
            CategoryTheory.Limits.pullback.lift_snd]
          exact hη_ZW
      have _ : AlgebraicGeometry.QuasiCompact j_W :=
        AlgebraicGeometry.quasiCompact_of_noetherianSpace_source j_W
      have hj_ker : j_W.ker = ⊥ := by
        refine AlgebraicGeometry.Scheme.IdealSheafData.ext_of_iSup_eq_top
          (fun _ : PUnit.{u + 1} =>
            ⟨⊤, AlgebraicGeometry.isAffineOpen_top (AlgebraicGeometry.Spec (CommRingCat.of ↥W))⟩)
          ciSup_const (fun _ => ?_)
        rw [AlgebraicGeometry.Scheme.IdealSheafData.ideal_bot, Pi.bot_apply,
          AlgebraicGeometry.Scheme.Hom.ker_apply, eq_bot_iff]
        intro x hx
        rw [RingHom.mem_ker] at hx
        have h_nat := AlgebraicGeometry.Scheme.ΓSpecIso_naturality (CommRingCat.ofHom W.subtype)
        have h_zero : W.subtype
            ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥W)).hom.hom x) = 0 := by
          have h1 : (j_W.appTop ≫
              (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of F)).hom).hom x = 0 := by
            change (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of F)).hom.hom
              (j_W.appTop.hom x) = 0
            have hx' : j_W.appTop.hom x = 0 := hx
            rw [hx', map_zero]
          rw [h_nat] at h1
          exact h1
        have h_x0 : (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥W)).hom.hom x = 0 :=
          Subtype.val_injective h_zero
        exact (AlgebraicGeometry.Scheme.ΓSpecIso
          (CommRingCat.of ↥W)).commRingCatIsoToRingEquiv.injective (h_x0.trans (map_zero _).symm)
      have h_ker_le : j_Seg.ker ≤ δ_W.ker := by
        rw [hKer_j, ← hjW_δW, AlgebraicGeometry.Scheme.Hom.ker_comp, hj_ker,
          AlgebraicGeometry.Scheme.IdealSheafData.map_bot]
      let ψ_tilde : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ M_tilde :=
        AlgebraicGeometry.IsClosedImmersion.lift j_Seg δ_W h_ker_le
      have hψ_fac : ψ_tilde ≫ j_Seg = δ_W :=
        AlgebraicGeometry.IsClosedImmersion.lift_fac j_Seg δ_W h_ker_le
      have hψ_πtilde : ψ_tilde ≫ π_tilde = ψ_Z := by
        dsimp only [π_tilde]
        rw [← Category.assoc, hψ_fac, CategoryTheory.Limits.pullback.lift_snd]
      have hψ_ιproj : ψ_tilde ≫ ι_proj = ψ_SegW := by
        dsimp only [ι_proj]
        rw [← Category.assoc, hψ_fac, CategoryTheory.Limits.pullback.lift_fst]
      have hjW_ψtilde : j_W ≫ ψ_tilde = η_tilde := by
        apply (cancel_mono j_Seg).mp
        rw [Category.assoc, hψ_fac, hjW_δW, hToImg_j]
      have hy_DW : ψ_tilde.base mW ∈ (TopologicalSpace.Opens.map ι_proj.base).obj D_W := by
        change (ψ_tilde ≫ ι_proj).base mW ∈ (D_W : Set ↥P_V)
        rw [hψ_ιproj, ← (hAff_V a_W).range_fromSpec]
        exact ⟨(AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_W_chart)).base mW, rfl⟩
      obtain ⟨U_tilde, hU_tilde, hy_Utilde, hU_le_DW⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
          (U := (TopologicalSpace.Opens.map ι_proj.base).obj D_W)
          (x := ψ_tilde.base mW) hy_DW
      have hRange_Utilde : Set.range ψ_tilde.base ⊆ Set.range hU_tilde.fromSpec.base := by
        rw [hU_tilde.range_fromSpec]
        rintro _ ⟨z, rfl⟩
        have hz_le : z.asIdeal ≤ mW.asIdeal := by
          rw [hmW]; exact IsLocalRing.le_maximalIdeal z.2.ne_top
        have hz_spec : (z : PrimeSpectrum ↥W) ⤳ (mW : PrimeSpectrum ↥W) :=
          (PrimeSpectrum.le_iff_specializes z mW).mp
            ((PrimeSpectrum.asIdeal_le_asIdeal z mW).mp hz_le)
        exact hz_spec.mem_open (U_tilde.isOpen.preimage ψ_tilde.base.hom.continuous) hy_Utilde
      let φ_Utilde := AlgebraicGeometry.Spec.preimage
        (AlgebraicGeometry.IsOpenImmersion.lift hU_tilde.fromSpec ψ_tilde hRange_Utilde)
      have hSpec_φUtilde : AlgebraicGeometry.Spec.map φ_Utilde ≫ hU_tilde.fromSpec = ψ_tilde := by
        rw [AlgebraicGeometry.Spec.map_preimage,
          AlgebraicGeometry.IsOpenImmersion.lift_fac hU_tilde.fromSpec ψ_tilde hRange_Utilde]
