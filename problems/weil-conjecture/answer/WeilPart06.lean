      exact hCl_Uw ⟨z, hZH hz⟩ z ⟨hz, hw_Uw ⟨z, hZH hz⟩⟩
  have hVanishingSubscheme : ∀ (H : Set ↥F), IsClosed H → IsIrreducible H →
      (∀ w ∈ H,
        ∃ (R_w : Type u) (_ : CommRing R_w)
          (j : AlgebraicGeometry.Spec (CommRingCat.of R_w) ⟶ F)
          (q_w : AlgebraicGeometry.Spec (CommRingCat.of R_w))
          (J : Ideal R_w),
          AlgebraicGeometry.IsOpenImmersion j ∧
          j.base q_w = w ∧
          J.IsPrime ∧
          j.base ⁻¹' H = PrimeSpectrum.zeroLocus (J : Set R_w) ∧
          ∃ (_ : IsDomain (R_w ⧸ J)), IsIntegrallyClosed (R_w ⧸ J)) →
