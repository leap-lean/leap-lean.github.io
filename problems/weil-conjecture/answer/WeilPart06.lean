      · exact False.elim ((hSub2 hu₁).2 rfl)
  · intro H hH
    obtain ⟨w₀, hw₀⟩ := hH.1.1
    have hTwoH : ∃ u₁ u₂ : ↥F, u₁ ≠ u₂ ∧ u₁ ∈ H ∧ u₂ ∈ H := by
      rcases hCharts w₀ with
        ⟨D, instRingD, j, q_D, hDomD, hICD, hOpen_j, hj_qD, hTwoD, hFinD⟩ |
        ⟨_hNoSm, B', instRingB', j, q', b, _hRedB', hOpen_j, hj_q', _hσ₀, hCovZ, _hInterZ, hBr⟩
      · exact (hSmoothComp hH hw₀ D instRingD j q_D hDomD hICD hOpen_j hj_qD hTwoD hFinD).2.1
      · exact (hNodalComp hH hw₀ B' instRingB' j q' b hOpen_j hj_q' hCovZ hBr).2.1
    refine ⟨hTwoH, fun Z hZ_cl hZH hZne => (hProperClosed H hH Z hZ_cl hZH hZne).1, ?_⟩
    refine hVanishingSubscheme H (isClosed_of_mem_irreducibleComponents H hH) hH.1 ?_
    intro w hwH
    rcases hCharts w with
      ⟨D, instRingD, j, q_D, hDomD, hICD, hOpen_j, hj_qD, hTwoD, hFinD⟩ |
      ⟨_hNoSm, B', instRingB', j, q', b, _hRedB', hOpen_j, hj_q', _hσ₀, hCovZ, _hInterZ, hBr⟩
    · exact (hSmoothComp hH hwH D instRingD j q_D hDomD hICD hOpen_j hj_qD hTwoD hFinD).2.2.2
    · exact (hNodalComp hH hwH B' instRingB' j q' b hOpen_j hj_q' hCovZ hBr).2.2.2

theorem weil_normal_component_proper_birational_closedImmersion (hZMT : ∀ (C_bar X : AlgebraicGeometry.Scheme.{u})
      (F_ss : Type u) [Field F_ss]
      (f' : C_bar ⟶ X)
      (η_C : AlgebraicGeometry.Spec (CommRingCat.of F_ss) ⟶ C_bar)
      (η_X : AlgebraicGeometry.Spec (CommRingCat.of F_ss) ⟶ X),
      AlgebraicGeometry.IsIntegral C_bar →
      AlgebraicGeometry.IsIntegral X →
      IsAffineNormalScheme X →
      AlgebraicGeometry.IsProper f' →
      AlgebraicGeometry.IsDominant η_C →
      η_C ≫ f' = η_X →
      IsSchemeFunctionField C_bar F_ss η_C →
      IsSchemeFunctionField X F_ss η_X →
      (∀ z : C_bar,
        ∃ (U_X : X.Opens) (_ : AlgebraicGeometry.IsAffineOpen U_X)
          (V_C : C_bar.Opens) (_ : AlgebraicGeometry.IsAffineOpen V_C)
          (e_X : V_C ≤ (TopologicalSpace.Opens.map f'.base).obj U_X),
          z ∈ V_C ∧
          (f'.appLE U_X V_C e_X).hom.FiniteType ∧
          (f'.appLE U_X V_C e_X).hom.QuasiFinite) →
      CategoryTheory.IsIso f')
    (F : AlgebraicGeometry.Scheme.{u})
    (H : Set ↥F) (hH_cl : IsClosed H)
    (H_sch : AlgebraicGeometry.Scheme.{u}) (ιH : H_sch ⟶ F)
    (hCl_ιH : AlgebraicGeometry.IsClosedImmersion ιH)
    (hInt_H : AlgebraicGeometry.IsIntegral H_sch)
    (hRange_ιH : Set.range ιH.base = H)
    (hNorm_H : IsOverlapAffineNormalScheme H_sch)
    (E_sch : AlgebraicGeometry.Scheme.{u}) (φ : E_sch ⟶ F) (U₀ : F.Opens)
    (hInt_E : AlgebraicGeometry.IsIntegral E_sch)
    (hProp_φ : AlgebraicGeometry.IsProper φ)
    (hRange_φ : Set.range φ.base = H)
    (hNe_inter : (H ∩ (U₀ : Set ↥F)).Nonempty)
    (hFin_compl : (φ.base ⁻¹' ((U₀ : Set ↥F)ᶜ)).Finite)
    (hCl_U₀ : AlgebraicGeometry.IsClosedImmersion (φ ∣_ U₀)) :
    AlgebraicGeometry.IsClosedImmersion φ ∧ Function.Injective φ.base :=
by
  have _ : AlgebraicGeometry.IsClosedImmersion ιH := hCl_ιH
  have _ : AlgebraicGeometry.IsIntegral H_sch := hInt_H
  have _ : AlgebraicGeometry.IsIntegral E_sch := hInt_E
  have _ : AlgebraicGeometry.IsProper φ := hProp_φ
  have _ : AlgebraicGeometry.IsClosedImmersion (φ ∣_ U₀) := hCl_U₀

  
  have hKerEq : ∀ {Z X : AlgebraicGeometry.Scheme.{u}} (f : Z ⟶ X)
      [AlgebraicGeometry.IsReduced Z] [AlgebraicGeometry.QuasiCompact f],
      AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal f.ker.support = f.ker := by
    intro Z X f _ _
    rw [AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal_support]
    apply AlgebraicGeometry.Scheme.IdealSheafData.ext
    funext U
    rw [AlgebraicGeometry.Scheme.IdealSheafData.radical_ideal,
      AlgebraicGeometry.Scheme.Hom.ker_apply]
    have hRad : (RingHom.ker (f.app ↑U).hom).IsRadical := by
      rintro x ⟨n, hn⟩
      rw [RingHom.mem_ker] at hn ⊢
      rw [map_pow] at hn
      exact IsReduced.eq_zero _ ⟨n, hn⟩
    exact hRad.radical

  
  have hSuppEq : ιH.ker.support = φ.ker.support := by
    apply TopologicalSpace.Closeds.ext
    rw [AlgebraicGeometry.Scheme.Hom.support_ker, AlgebraicGeometry.Scheme.Hom.support_ker]
    have h1 : Set.range ⇑ιH = H := hRange_ιH
    have h2 : Set.range ⇑φ = H := hRange_φ
    rw [h1, h2, hH_cl.closure_eq]
  have hKer_ιφ : ιH.ker = φ.ker := by
    rw [← hKerEq ιH, ← hKerEq φ, hSuppEq]
  let ψ : E_sch ⟶ H_sch := AlgebraicGeometry.IsClosedImmersion.lift ιH φ (le_of_eq hKer_ιφ)
  have hψ_fac : ψ ≫ ιH = φ := AlgebraicGeometry.IsClosedImmersion.lift_fac ιH φ (le_of_eq hKer_ιφ)
  have hProp_ψ : AlgebraicGeometry.IsProper ψ := by
    have _ : AlgebraicGeometry.IsProper (ψ ≫ ιH) := hψ_fac.symm ▸ hProp_φ
    exact AlgebraicGeometry.IsProper.of_comp ψ ιH

  
  let U0H : H_sch.Opens := (TopologicalSpace.Opens.map ιH.base).obj U₀
  let U0E : E_sch.Opens := (TopologicalSpace.Opens.map ψ.base).obj U0H
  let U0E' : E_sch.Opens := (TopologicalSpace.Opens.map φ.base).obj U₀
  have hNe_U0H : Nonempty ↥U0H := by
    obtain ⟨y₀, hy₀H, hy₀U₀⟩ := hNe_inter
    rw [← hRange_ιH] at hy₀H
    obtain ⟨x₀, rfl⟩ := hy₀H
    exact ⟨⟨x₀, hy₀U₀⟩⟩
  have hRange_UE : Set.range ⇑U0E.ι = Set.range ⇑U0E'.ι := by
    rw [U0E.range_ι, U0E'.range_ι]
    ext z
    change ιH.base (ψ.base z) ∈ U₀ ↔ φ.base z ∈ U₀
    have hz : ιH.base (ψ.base z) = φ.base z := by
      rw [← hψ_fac]
      rfl
    rw [hz]
  let e_UE : U0E.toScheme ≅ U0E'.toScheme :=
    AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq U0E.ι U0E'.ι hRange_UE
  have he_UE : e_UE.hom ≫ U0E'.ι = U0E.ι :=
    AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac U0E.ι U0E'.ι hRange_UE
  let i₁ : U0E.toScheme ⟶ U₀.toScheme := e_UE.hom ≫ (φ ∣_ U₀)
  let i₂ : U0H.toScheme ⟶ U₀.toScheme := ιH ∣_ U₀
  have _ : CategoryTheory.IsIso e_UE.hom := CategoryTheory.Iso.isIso_hom e_UE
  have _ : AlgebraicGeometry.IsClosedImmersion e_UE.hom :=
    AlgebraicGeometry.IsClosedImmersion.instOfIsIsoScheme e_UE.hom
  have _ : AlgebraicGeometry.IsClosedImmersion i₁ :=
    AlgebraicGeometry.IsClosedImmersion.comp e_UE.hom (φ ∣_ U₀)
  have _ : AlgebraicGeometry.IsClosedImmersion i₂ := inferInstance
  have _ : AlgebraicGeometry.QuasiCompact i₁ := inferInstance
  have _ : AlgebraicGeometry.QuasiCompact i₂ := inferInstance
  have hi₁_ι : i₁ ≫ U₀.ι = U0E.ι ≫ φ := by
    calc
      i₁ ≫ U₀.ι = e_UE.hom ≫ ((φ ∣_ U₀) ≫ U₀.ι) := CategoryTheory.Category.assoc _ _ _
      _ = e_UE.hom ≫ (U0E'.ι ≫ φ) := by rw [AlgebraicGeometry.morphismRestrict_ι φ U₀]
      _ = (e_UE.hom ≫ U0E'.ι) ≫ φ := (CategoryTheory.Category.assoc _ _ _).symm
      _ = U0E.ι ≫ φ := by rw [he_UE]
  have h_fac_U₀ : (ψ ∣_ U0H) ≫ i₂ = i₁ := by
    apply (CategoryTheory.cancel_mono U₀.ι).mp
    calc
      ((ψ ∣_ U0H) ≫ i₂) ≫ U₀.ι
          = (ψ ∣_ U0H) ≫ (i₂ ≫ U₀.ι) := CategoryTheory.Category.assoc _ _ _
      _ = (ψ ∣_ U0H) ≫ (U0H.ι ≫ ιH) := by rw [AlgebraicGeometry.morphismRestrict_ι ιH U₀]
      _ = ((ψ ∣_ U0H) ≫ U0H.ι) ≫ ιH := (CategoryTheory.Category.assoc _ _ _).symm
      _ = (U0E.ι ≫ ψ) ≫ ιH := by rw [AlgebraicGeometry.morphismRestrict_ι ψ U0H]
      _ = U0E.ι ≫ (ψ ≫ ιH) := CategoryTheory.Category.assoc _ _ _
      _ = U0E.ι ≫ φ := by rw [hψ_fac]
      _ = i₁ ≫ U₀.ι := hi₁_ι.symm
  have hRange_i₁ : Set.range ⇑i₁ = U₀.ι.base ⁻¹' H := by
    ext u
    simp only [Set.mem_range, Set.mem_preimage]
    constructor
    · rintro ⟨v, rfl⟩
      change (i₁ ≫ U₀.ι).base v ∈ H
      rw [hi₁_ι, ← hRange_φ]
      exact ⟨U0E.ι.base v, rfl⟩
    · intro hu
      rw [← hRange_φ] at hu
      obtain ⟨z, hz⟩ := hu
      have hzU₀ : z ∈ U0E' := by
        change φ.base z ∈ U₀
        rw [hz]
        exact u.2
      refine ⟨e_UE.inv.base ⟨z, hzU₀⟩, U₀.ι.isOpenEmbedding.injective ?_⟩
      change (i₁ ≫ U₀.ι).base (e_UE.inv.base ⟨z, hzU₀⟩) = U₀.ι.base u
      rw [hi₁_ι, ← he_UE]
      change φ.base (U0E'.ι.base ((e_UE.inv ≫ e_UE.hom).base ⟨z, hzU₀⟩)) = U₀.ι.base u
      rw [e_UE.inv_hom_id]
      exact hz
  have hRange_i₂ : Set.range ⇑i₂ = U₀.ι.base ⁻¹' H := by
    ext u
    simp only [Set.mem_range, Set.mem_preimage]
    constructor
    · rintro ⟨w, rfl⟩
      change (i₂ ≫ U₀.ι).base w ∈ H
      rw [AlgebraicGeometry.morphismRestrict_ι ιH U₀, ← hRange_ιH]
      exact ⟨U0H.ι.base w, rfl⟩
    · intro hu
      rw [← hRange_ιH] at hu
      obtain ⟨x, hx⟩ := hu
      have hxU₀ : x ∈ U0H := by
        change ιH.base x ∈ U₀
        rw [hx]
        exact u.2
      refine ⟨⟨x, hxU₀⟩, U₀.ι.isOpenEmbedding.injective ?_⟩
      change (i₂ ≫ U₀.ι).base ⟨x, hxU₀⟩ = U₀.ι.base u
      rw [AlgebraicGeometry.morphismRestrict_ι ιH U₀]
      exact hx
  have hSupp_U₀ : i₁.ker.support = i₂.ker.support := by
    apply TopologicalSpace.Closeds.ext
    rw [AlgebraicGeometry.Scheme.Hom.support_ker, AlgebraicGeometry.Scheme.Hom.support_ker,
      hRange_i₁, hRange_i₂]
  have h_ker_U₀ : i₁.ker = i₂.ker := by
    rw [← hKerEq i₁, ← hKerEq i₂, hSupp_U₀]
  have hIso_U0H : CategoryTheory.IsIso (ψ ∣_ U0H) :=
    AlgebraicGeometry.IsClosedImmersion.isIso_of_ker_eq i₁ i₂ (ψ ∣_ U0H) h_fac_U₀ h_ker_U₀

  
  have hFinFib : ∀ x : ↥H_sch, (ψ.base ⁻¹' ({x} : Set ↥H_sch)).Finite := by
    intro x
    by_cases hx : x ∈ U0H
    · apply Set.Subsingleton.finite
      intro z₁ hz₁ z₂ hz₂
      have hz₁_eq : ψ.base z₁ = x := hz₁
      have hz₂_eq : ψ.base z₂ = x := hz₂
      have hz₁_U : z₁ ∈ U0E := by
        change ψ.base z₁ ∈ U0H
        rw [hz₁_eq]
        exact hx
      have hz₂_U : z₂ ∈ U0E := by
        change ψ.base z₂ ∈ U0H
        rw [hz₂_eq]
        exact hx
      let v₁ : ↥U0E.toScheme := ⟨z₁, hz₁_U⟩
      let v₂ : ↥U0E.toScheme := ⟨z₂, hz₂_U⟩
      have hv_im : (ψ ∣_ U0H).base v₁ = (ψ ∣_ U0H).base v₂ := by
        apply U0H.ι.isOpenEmbedding.injective
        change ((ψ ∣_ U0H) ≫ U0H.ι).base v₁ = ((ψ ∣_ U0H) ≫ U0H.ι).base v₂
        rw [AlgebraicGeometry.morphismRestrict_ι ψ U0H]
        change ψ.base z₁ = ψ.base z₂
        rw [hz₁_eq, hz₂_eq]
      have hv_eq : v₁ = v₂ := by
        have h := congrArg (CategoryTheory.inv (ψ ∣_ U0H)).base hv_im
        change ((ψ ∣_ U0H) ≫ CategoryTheory.inv (ψ ∣_ U0H)).base v₁ =
          ((ψ ∣_ U0H) ≫ CategoryTheory.inv (ψ ∣_ U0H)).base v₂ at h
        rw [CategoryTheory.IsIso.hom_inv_id] at h
        exact h
      exact congrArg Subtype.val hv_eq
    · refine hFin_compl.subset ?_
      intro z hz
      have hz_eq : ψ.base z = x := hz
      change φ.base z ∉ (U₀ : Set ↥F)
      have hφz : φ.base z = ιH.base x := by
        rw [← hψ_fac]
        change ιH.base (ψ.base z) = ιH.base x
        rw [hz_eq]
      rw [hφz]
      exact hx

  have hLocQF : ∀ z : E_sch,
      ∃ (U_H : H_sch.Opens) (_ : AlgebraicGeometry.IsAffineOpen U_H)
        (V_E : E_sch.Opens) (_ : AlgebraicGeometry.IsAffineOpen V_E)
        (e_H : V_E ≤ (TopologicalSpace.Opens.map ψ.base).obj U_H),
        z ∈ V_E ∧
        (ψ.appLE U_H V_E e_H).hom.FiniteType ∧
        (ψ.appLE U_H V_E e_H).hom.QuasiFinite := by
    intro z
    obtain ⟨U_H, hUH, hz_UH, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
        (U := (⊤ : H_sch.Opens)) (x := ψ.base z) trivial
    obtain ⟨V_E, hVE, hz_VE, e_H_sub⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
        (U := (TopologicalSpace.Opens.map ψ.base).obj U_H) (x := z) hz_UH
    have e_H : V_E ≤ (TopologicalSpace.Opens.map ψ.base).obj U_H := e_H_sub
    have hFT : (ψ.appLE U_H V_E e_H).hom.FiniteType :=
      AlgebraicGeometry.HasRingHomProperty.appLE (@AlgebraicGeometry.LocallyOfFiniteType)
        ψ inferInstance ⟨U_H, hUH⟩ ⟨V_E, hVE⟩ e_H
    refine ⟨U_H, hUH, V_E, hVE, e_H, hz_VE, hFT, ?_⟩
    let R_H : Type u := ↑(H_sch.presheaf.obj (Opposite.op U_H))
    let R_E : Type u := ↑(E_sch.presheaf.obj (Opposite.op V_E))
    let α : R_H →+* R_E := (ψ.appLE U_H V_E e_H).hom
    let _ : Algebra R_H R_E := α.toAlgebra
    have _ : Algebra.FiniteType R_H R_E := hFT
    change Algebra.QuasiFinite R_H R_E
    rw [Algebra.QuasiFinite.iff_finite_comap_preimage_singleton]
    intro p
    let x : ↥H_sch := hUH.fromSpec.base p
    have hSub : PrimeSpectrum.comap α ⁻¹' ({p} : Set (PrimeSpectrum R_H)) ⊆
        hVE.fromSpec.base ⁻¹' (ψ.base ⁻¹' ({x} : Set ↥H_sch)) := by
      intro q hq
      have hq_eq : PrimeSpectrum.comap α q = p := hq
      have h1 := congrArg (fun f => f.base q)
        (AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec ψ hUH hVE e_H).symm
      have h2 : (AlgebraicGeometry.Spec.map (ψ.appLE U_H V_E e_H)).base q =
          PrimeSpectrum.comap α q :=
        AlgebraicGeometry.Spec.map_apply (ψ.appLE U_H V_E e_H) q
      change (hVE.fromSpec ≫ ψ).base q = x
      calc
        (hVE.fromSpec ≫ ψ).base q
            = hUH.fromSpec.base
                ((AlgebraicGeometry.Spec.map (ψ.appLE U_H V_E e_H)).base q) := h1
        _ = hUH.fromSpec.base (PrimeSpectrum.comap α q) := congrArg hUH.fromSpec.base h2
        _ = x := by rw [hq_eq]
    exact ((hFinFib x).preimage hVE.fromSpec.isOpenEmbedding.injective.injOn).subset hSub

  
  have hCanonFF : ∀ (X : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsIntegral X],
      AlgebraicGeometry.IsDominant (X.fromSpecStalk (genericPoint ↥X)) ∧
      IsSchemeFunctionField X (↑X.functionField) (X.fromSpecStalk (genericPoint ↥X)) := by
    intro X _
    refine ⟨?_, ?_⟩
    · apply AlgebraicGeometry.IsDominant.mk
      rw [denseRange_iff_closure_range]
      apply Set.Subset.antisymm (Set.subset_univ _)
      have hSub : ({genericPoint ↥X} : Set ↥X) ⊆ Set.range ⇑(X.fromSpecStalk (genericPoint ↥X)) := by
        intro y hy
        rw [Set.mem_singleton_iff.mp hy]
        exact ⟨IsLocalRing.closedPoint ↑(X.presheaf.stalk (genericPoint ↥X)),
          AlgebraicGeometry.Scheme.fromSpecStalk_closedPoint⟩
      calc
        (Set.univ : Set ↥X) = closure ({genericPoint ↥X} : Set ↥X) :=
          (genericPoint_spec ↥X).def.symm
        _ ⊆ closure (Set.range ⇑(X.fromSpecStalk (genericPoint ↥X))) :=
          closure_mono hSub
    · intro U hU hNe
      have hNe' : Nonempty ↥U.toScheme := hNe
      rcases hNe with ⟨⟨u₀, hu₀⟩⟩
      have hxG : genericPoint ↥X ∈ U :=
        (@IsGenericPoint.mem_open_set_iff ↥X _ (genericPoint ↥X) Set.univ (U : Set ↥X)
          (genericPoint_spec ↥X) U.isOpen).mpr ⟨u₀, trivial, hu₀⟩
      refine ⟨X.germToFunctionField U,
        @AlgebraicGeometry.functionField_isFractionRing_of_isAffineOpen X _ U hU hNe', ?_⟩
      change AlgebraicGeometry.Spec.map (X.presheaf.germ U (genericPoint ↥X) hxG) ≫
        hU.fromSpec = X.fromSpecStalk (genericPoint ↥X)
      rw [← AlgebraicGeometry.Scheme.Opens.fromSpecStalkOfMem_toSpecΓ_assoc U (genericPoint ↥X) hxG,
        hU.toSpecΓ_fromSpec, AlgebraicGeometry.Scheme.Opens.fromSpecStalkOfMem_ι]

  let F_E : Type u := ↑E_sch.functionField
  let η_E : AlgebraicGeometry.Spec (CommRingCat.of F_E) ⟶ E_sch :=
    E_sch.fromSpecStalk (genericPoint ↥E_sch)
  obtain ⟨hDom_E, hFunc_E⟩ := hCanonFF E_sch
  let K_H : Type u := ↑H_sch.functionField
  let ξ_H : AlgebraicGeometry.Spec (CommRingCat.of K_H) ⟶ H_sch :=
    H_sch.fromSpecStalk (genericPoint ↥H_sch)
  obtain ⟨_hDom_H, hFunc_KH⟩ := hCanonFF H_sch

  
  obtain ⟨⟨x₀, hx₀⟩⟩ := hNe_U0H
  obtain ⟨W₀, hW₀, hx₀_W₀, hW₀_sub⟩ :=
    AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hx₀
  have hNe_W₀ : Nonempty ↥W₀ := ⟨⟨x₀, hx₀_W₀⟩⟩
  let V₀ : E_sch.Opens := (TopologicalSpace.Opens.map ψ.base).obj W₀

  have hRange_jW : Set.range ⇑W₀.ι ⊆ Set.range ⇑U0H.ι := by
    rw [W₀.range_ι, U0H.range_ι]
    exact hW₀_sub
  let j_W : W₀.toScheme ⟶ U0H.toScheme :=
    AlgebraicGeometry.IsOpenImmersion.lift U0H.ι W₀.ι hRange_jW
  have hj_W : j_W ≫ U0H.ι = W₀.ι :=
    AlgebraicGeometry.IsOpenImmersion.lift_fac U0H.ι W₀.ι hRange_jW

  have hRange_jV : Set.range ⇑V₀.ι ⊆ Set.range ⇑U0E.ι := by
    rw [V₀.range_ι, U0E.range_ι]
    intro z hz
    exact hW₀_sub hz
  let j_V : V₀.toScheme ⟶ U0E.toScheme :=
    AlgebraicGeometry.IsOpenImmersion.lift U0E.ι V₀.ι hRange_jV
  have hj_V : j_V ≫ U0E.ι = V₀.ι :=
    AlgebraicGeometry.IsOpenImmersion.lift_fac U0E.ι V₀.ι hRange_jV

  have hψ_WV : (ψ ∣_ W₀) ≫ j_W = j_V ≫ (ψ ∣_ U0H) := by
    apply (CategoryTheory.cancel_mono U0H.ι).mp
    calc
      ((ψ ∣_ W₀) ≫ j_W) ≫ U0H.ι
          = (ψ ∣_ W₀) ≫ (j_W ≫ U0H.ι) := CategoryTheory.Category.assoc _ _ _
      _ = (ψ ∣_ W₀) ≫ W₀.ι := by rw [hj_W]
      _ = V₀.ι ≫ ψ := AlgebraicGeometry.morphismRestrict_ι ψ W₀
      _ = (j_V ≫ U0E.ι) ≫ ψ := by rw [hj_V]
      _ = j_V ≫ (U0E.ι ≫ ψ) := CategoryTheory.Category.assoc _ _ _
      _ = j_V ≫ ((ψ ∣_ U0H) ≫ U0H.ι) := by rw [AlgebraicGeometry.morphismRestrict_ι ψ U0H]
      _ = (j_V ≫ (ψ ∣_ U0H)) ≫ U0H.ι := (CategoryTheory.Category.assoc _ _ _).symm

  have hRange_invW :
      Set.range ⇑(j_W ≫ CategoryTheory.inv (ψ ∣_ U0H) ≫ U0E.ι) ⊆ Set.range ⇑V₀.ι := by
    rw [V₀.range_ι]
    rintro _ ⟨w, rfl⟩
    change ψ.base ((j_W ≫ CategoryTheory.inv (ψ ∣_ U0H) ≫ U0E.ι).base w) ∈ W₀
    change (j_W ≫ CategoryTheory.inv (ψ ∣_ U0H) ≫ (U0E.ι ≫ ψ)).base w ∈ W₀
    rw [← AlgebraicGeometry.morphismRestrict_ι ψ U0H,
      ← CategoryTheory.Category.assoc (CategoryTheory.inv (ψ ∣_ U0H)) (ψ ∣_ U0H) U0H.ι,
      CategoryTheory.IsIso.inv_hom_id, CategoryTheory.Category.id_comp, hj_W]
    exact w.2
  let inv_W : W₀.toScheme ⟶ V₀.toScheme :=
    AlgebraicGeometry.IsOpenImmersion.lift V₀.ι
      (j_W ≫ CategoryTheory.inv (ψ ∣_ U0H) ≫ U0E.ι) hRange_invW
  have hinv_W : inv_W ≫ V₀.ι = j_W ≫ CategoryTheory.inv (ψ ∣_ U0H) ≫ U0E.ι :=
    AlgebraicGeometry.IsOpenImmersion.lift_fac V₀.ι
      (j_W ≫ CategoryTheory.inv (ψ ∣_ U0H) ≫ U0E.ι) hRange_invW

  have h_hom_inv_W : (ψ ∣_ W₀) ≫ inv_W = 𝟙 V₀.toScheme := by
    apply (CategoryTheory.cancel_mono V₀.ι).mp
    calc
      ((ψ ∣_ W₀) ≫ inv_W) ≫ V₀.ι
          = (ψ ∣_ W₀) ≫ (inv_W ≫ V₀.ι) := CategoryTheory.Category.assoc _ _ _
      _ = (ψ ∣_ W₀) ≫ (j_W ≫ CategoryTheory.inv (ψ ∣_ U0H) ≫ U0E.ι) := by rw [hinv_W]
      _ = ((ψ ∣_ W₀) ≫ j_W) ≫ CategoryTheory.inv (ψ ∣_ U0H) ≫ U0E.ι := by
            simp only [CategoryTheory.Category.assoc]
      _ = (j_V ≫ (ψ ∣_ U0H)) ≫ CategoryTheory.inv (ψ ∣_ U0H) ≫ U0E.ι := by rw [hψ_WV]
      _ = j_V ≫ ((ψ ∣_ U0H) ≫ CategoryTheory.inv (ψ ∣_ U0H)) ≫ U0E.ι := by
            simp only [CategoryTheory.Category.assoc]
      _ = j_V ≫ U0E.ι := by
            rw [CategoryTheory.IsIso.hom_inv_id, CategoryTheory.Category.id_comp]
      _ = V₀.ι := hj_V
      _ = 𝟙 V₀.toScheme ≫ V₀.ι := (CategoryTheory.Category.id_comp _).symm

  have h_inv_hom_W : inv_W ≫ (ψ ∣_ W₀) = 𝟙 W₀.toScheme := by
    apply (CategoryTheory.cancel_mono W₀.ι).mp
    calc
      (inv_W ≫ (ψ ∣_ W₀)) ≫ W₀.ι
          = inv_W ≫ ((ψ ∣_ W₀) ≫ W₀.ι) := CategoryTheory.Category.assoc _ _ _
      _ = inv_W ≫ (V₀.ι ≫ ψ) := by rw [AlgebraicGeometry.morphismRestrict_ι ψ W₀]
      _ = (inv_W ≫ V₀.ι) ≫ ψ := (CategoryTheory.Category.assoc _ _ _).symm
      _ = (j_W ≫ CategoryTheory.inv (ψ ∣_ U0H) ≫ U0E.ι) ≫ ψ := by rw [hinv_W]
      _ = j_W ≫ CategoryTheory.inv (ψ ∣_ U0H) ≫ (U0E.ι ≫ ψ) := by
            simp only [CategoryTheory.Category.assoc]
      _ = j_W ≫ CategoryTheory.inv (ψ ∣_ U0H) ≫ ((ψ ∣_ U0H) ≫ U0H.ι) := by
            rw [AlgebraicGeometry.morphismRestrict_ι ψ U0H]
      _ = j_W ≫ (CategoryTheory.inv (ψ ∣_ U0H) ≫ (ψ ∣_ U0H)) ≫ U0H.ι := by
            simp only [CategoryTheory.Category.assoc]
      _ = j_W ≫ U0H.ι := by
            rw [CategoryTheory.IsIso.inv_hom_id, CategoryTheory.Category.id_comp]
      _ = W₀.ι := hj_W
      _ = 𝟙 W₀.toScheme ≫ W₀.ι := (CategoryTheory.Category.id_comp _).symm

  have hIso_W₀ : CategoryTheory.IsIso (ψ ∣_ W₀) := ⟨⟨inv_W, h_hom_inv_W, h_inv_hom_W⟩⟩
  have hV₀ : AlgebraicGeometry.IsAffineOpen V₀ :=
    @AlgebraicGeometry.IsAffine.of_isIso _ _ (ψ ∣_ W₀) _ hW₀
  have hNe_V₀ : Nonempty ↥V₀ := ⟨inv_W.base ⟨x₀, hx₀_W₀⟩⟩

  let α₀ := ψ.appLE W₀ V₀ le_rfl
  have hW₀_inv : hW₀.isoSpec.inv ≫ W₀.ι = hW₀.fromSpec := by
    rw [← hW₀.isoSpec_hom_fromSpec, ← CategoryTheory.Category.assoc,
      hW₀.isoSpec.inv_hom_id, CategoryTheory.Category.id_comp]
  have hV₀_inv : hV₀.isoSpec.inv ≫ V₀.ι = hV₀.fromSpec := by
    rw [← hV₀.isoSpec_hom_fromSpec, ← CategoryTheory.Category.assoc,
      hV₀.isoSpec.inv_hom_id, CategoryTheory.Category.id_comp]
  have hSpec_α₀ : AlgebraicGeometry.Spec.map α₀ =
      hV₀.isoSpec.inv ≫ ((ψ ∣_ W₀) ≫ hW₀.isoSpec.hom) := by
    apply (CategoryTheory.cancel_mono hW₀.fromSpec).mp
    calc
      AlgebraicGeometry.Spec.map α₀ ≫ hW₀.fromSpec
          = hV₀.fromSpec ≫ ψ :=
            AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec ψ hW₀ hV₀ le_rfl
      _ = (hV₀.isoSpec.inv ≫ V₀.ι) ≫ ψ := by rw [hV₀_inv]
      _ = hV₀.isoSpec.inv ≫ (V₀.ι ≫ ψ) := CategoryTheory.Category.assoc _ _ _
      _ = hV₀.isoSpec.inv ≫ ((ψ ∣_ W₀) ≫ W₀.ι) := by
            rw [AlgebraicGeometry.morphismRestrict_ι ψ W₀]
      _ = hV₀.isoSpec.inv ≫ (ψ ∣_ W₀) ≫ (hW₀.isoSpec.hom ≫ hW₀.fromSpec) := by
            rw [hW₀.isoSpec_hom_fromSpec]
      _ = (hV₀.isoSpec.inv ≫ ((ψ ∣_ W₀) ≫ hW₀.isoSpec.hom)) ≫ hW₀.fromSpec := by
            simp only [CategoryTheory.Category.assoc]
  have _ : CategoryTheory.IsIso hW₀.isoSpec.hom := CategoryTheory.Iso.isIso_hom hW₀.isoSpec
  have _ : CategoryTheory.IsIso hV₀.isoSpec.inv := CategoryTheory.Iso.isIso_inv hV₀.isoSpec
  have _ : CategoryTheory.IsIso ((ψ ∣_ W₀) ≫ hW₀.isoSpec.hom) := CategoryTheory.IsIso.comp_isIso
  have hIso_rhs : CategoryTheory.IsIso (hV₀.isoSpec.inv ≫ ((ψ ∣_ W₀) ≫ hW₀.isoSpec.hom)) :=
    CategoryTheory.IsIso.comp_isIso
  have hIso_Spec_α₀ : CategoryTheory.IsIso (AlgebraicGeometry.Scheme.Spec.map α₀.op) := by
    change CategoryTheory.IsIso (AlgebraicGeometry.Spec.map α₀)
    exact hSpec_α₀.symm ▸ hIso_rhs
  have _ : CategoryTheory.IsIso α₀.op :=
    AlgebraicGeometry.Spec.fullyFaithful.isIso_of_isIso_map α₀.op
  have _ : CategoryTheory.IsIso α₀ := CategoryTheory.isIso_of_op α₀

  let R_W₀ : Type u := ↑(H_sch.presheaf.obj (Opposite.op W₀))
  let R_V₀ : Type u := ↑(E_sch.presheaf.obj (Opposite.op V₀))
  let e_α₀ : R_W₀ ≃+* R_V₀ := (CategoryTheory.asIso α₀).commRingCatIsoToRingEquiv
  have he_α₀ : ∀ r : R_W₀, e_α₀ r = α₀.hom r := fun _ => rfl

  obtain ⟨φ_W₀, hFrac_W₀, hEq_W₀⟩ := hFunc_KH W₀ hW₀ hNe_W₀
  obtain ⟨φ_V₀, hFrac_V₀, hEq_V₀⟩ := hFunc_E V₀ hV₀ hNe_V₀
  have _ : Nonempty ↥W₀.toScheme := hNe_W₀
  have _ : Nonempty ↥V₀.toScheme := hNe_V₀
  have _ : IsDomain R_W₀ :=
    AlgebraicGeometry.IsIntegral.component_integral (X := H_sch) W₀
  have _ : IsDomain R_V₀ :=
    AlgebraicGeometry.IsIntegral.component_integral (X := E_sch) V₀

  have hFrac_W₀_FE :
      @IsFractionRing R_W₀ _ F_E _ (φ_V₀.hom.comp α₀.hom).toAlgebra := by
    let _ : Algebra R_W₀ F_E := (φ_V₀.hom.comp α₀.hom).toAlgebra
    let _ : Algebra R_V₀ F_E := φ_V₀.hom.toAlgebra
    have _ : IsFractionRing R_V₀ F_E := hFrac_V₀
    refine
      { map_units := ?_
        surj := ?_
        exists_of_eq := ?_ }
    · intro y
      have hy0 : (y : R_W₀) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp y.2
      have hαy0 : α₀.hom (y : R_W₀) ≠ 0 := by
        rw [← he_α₀]
        exact fun h => hy0 (e_α₀.injective (h.trans (map_zero e_α₀).symm))
      change IsUnit (φ_V₀.hom (α₀.hom (y : R_W₀)))
      exact IsLocalization.map_units F_E
        (⟨α₀.hom (y : R_W₀), mem_nonZeroDivisors_iff_ne_zero.mpr hαy0⟩ : nonZeroDivisors R_V₀)
    · intro z
      obtain ⟨⟨x', s'⟩, hz⟩ := IsLocalization.surj (nonZeroDivisors R_V₀) z
      have hs'0 : (s' : R_V₀) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s'.2
      have hs0 : e_α₀.symm (s' : R_V₀) ≠ 0 :=
        fun h => hs'0 (e_α₀.symm.injective (h.trans (map_zero e_α₀.symm).symm))
      refine ⟨⟨e_α₀.symm x', ⟨e_α₀.symm (s' : R_V₀), mem_nonZeroDivisors_iff_ne_zero.mpr hs0⟩⟩, ?_⟩
      change z * φ_V₀.hom (α₀.hom (e_α₀.symm (s' : R_V₀))) = φ_V₀.hom (α₀.hom (e_α₀.symm x'))
      simp only [← he_α₀, RingEquiv.apply_symm_apply]
      exact hz
    · intro x₁ x₂ h
      change φ_V₀.hom (α₀.hom x₁) = φ_V₀.hom (α₀.hom x₂) at h
      have h' : α₀.hom x₁ = α₀.hom x₂ :=
        IsFractionRing.injective R_V₀ F_E h
      rw [← he_α₀, ← he_α₀] at h'
      exact ⟨1, by simp [e_α₀.injective h']⟩

  let e_alg : @AlgEquiv R_W₀ K_H F_E _ _ _ φ_W₀.hom.toAlgebra (φ_V₀.hom.comp α₀.hom).toAlgebra :=
    @IsLocalization.algEquiv R_W₀ _ (nonZeroDivisors R_W₀)
      K_H _ φ_W₀.hom.toAlgebra hFrac_W₀
      F_E _ (φ_V₀.hom.comp α₀.hom).toAlgebra hFrac_W₀_FE
  let e_field : K_H ≃+* F_E :=
    @AlgEquiv.toRingEquiv R_W₀ K_H F_E _ _ _
      φ_W₀.hom.toAlgebra (φ_V₀.hom.comp α₀.hom).toAlgebra e_alg
  let e_hom : CommRingCat.of K_H ⟶ CommRingCat.of F_E :=
    CommRingCat.ofHom e_field.toRingHom
  have he_comm : φ_W₀ ≫ e_hom = α₀ ≫ φ_V₀ := by
    ext r
    exact @AlgEquiv.commutes' R_W₀ K_H F_E _ _ _
      φ_W₀.hom.toAlgebra (φ_V₀.hom.comp α₀.hom).toAlgebra e_alg r

  have hξ_η : AlgebraicGeometry.Spec.map e_hom ≫ ξ_H = η_E ≫ ψ := by
    calc
      AlgebraicGeometry.Spec.map e_hom ≫ ξ_H
          = AlgebraicGeometry.Spec.map e_hom ≫
              (AlgebraicGeometry.Spec.map φ_W₀ ≫ hW₀.fromSpec) := by rw [hEq_W₀]
      _ = (AlgebraicGeometry.Spec.map e_hom ≫ AlgebraicGeometry.Spec.map φ_W₀) ≫
            hW₀.fromSpec := (CategoryTheory.Category.assoc _ _ _).symm
      _ = AlgebraicGeometry.Spec.map (φ_W₀ ≫ e_hom) ≫ hW₀.fromSpec := by
            rw [AlgebraicGeometry.Spec.map_comp]
      _ = AlgebraicGeometry.Spec.map (α₀ ≫ φ_V₀) ≫ hW₀.fromSpec := by rw [he_comm]
      _ = (AlgebraicGeometry.Spec.map φ_V₀ ≫ AlgebraicGeometry.Spec.map α₀) ≫
            hW₀.fromSpec := by rw [AlgebraicGeometry.Spec.map_comp]
      _ = AlgebraicGeometry.Spec.map φ_V₀ ≫
            (AlgebraicGeometry.Spec.map α₀ ≫ hW₀.fromSpec) :=
            CategoryTheory.Category.assoc _ _ _
      _ = AlgebraicGeometry.Spec.map φ_V₀ ≫ (hV₀.fromSpec ≫ ψ) := by
            rw [AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec ψ hW₀ hV₀ le_rfl]
      _ = (AlgebraicGeometry.Spec.map φ_V₀ ≫ hV₀.fromSpec) ≫ ψ :=
            (CategoryTheory.Category.assoc _ _ _).symm
      _ = η_E ≫ ψ := by rw [hEq_V₀]

  have hFunc_H_FE : IsSchemeFunctionField H_sch F_E (η_E ≫ ψ) := by
    intro U hU hNeU
    obtain ⟨φ_U, hFrac_U, hEq_U⟩ := hFunc_KH U hU hNeU
    refine ⟨φ_U ≫ e_hom, ?_, ?_⟩
    · exact (@IsLocalization.isLocalization_iff_of_ringEquiv
        ↑(H_sch.presheaf.obj (Opposite.op U)) _
        (nonZeroDivisors ↑(H_sch.presheaf.obj (Opposite.op U)))
        K_H _ φ_U.hom.toAlgebra F_E _ e_field).mp hFrac_U
    · calc
        AlgebraicGeometry.Spec.map (φ_U ≫ e_hom) ≫ hU.fromSpec
            = (AlgebraicGeometry.Spec.map e_hom ≫ AlgebraicGeometry.Spec.map φ_U) ≫
                hU.fromSpec := by rw [AlgebraicGeometry.Spec.map_comp]
        _ = AlgebraicGeometry.Spec.map e_hom ≫
              (AlgebraicGeometry.Spec.map φ_U ≫ hU.fromSpec) :=
              CategoryTheory.Category.assoc _ _ _
        _ = AlgebraicGeometry.Spec.map e_hom ≫ ξ_H := by rw [hEq_U]
        _ = η_E ≫ ψ := hξ_η

  
  have hNorm_H' : IsAffineNormalScheme H_sch := by
    intro U hU hNe
    obtain ⟨hDom, hIC⟩ := hNorm_H U hU hNe
    exact ⟨hDom, hIC⟩

  have hIso_ψ : CategoryTheory.IsIso ψ :=
    hZMT E_sch H_sch F_E ψ η_E (η_E ≫ ψ) hInt_E hInt_H hNorm_H' hProp_ψ hDom_E rfl
      hFunc_E hFunc_H_FE hLocQF
  have hCl_φ : AlgebraicGeometry.IsClosedImmersion φ := by
    have _ : AlgebraicGeometry.IsClosedImmersion ψ :=
      AlgebraicGeometry.IsClosedImmersion.instOfIsIsoScheme ψ
    have _ : AlgebraicGeometry.IsClosedImmersion (ψ ≫ ιH) :=
      AlgebraicGeometry.IsClosedImmersion.comp ψ ιH
    exact hψ_fac ▸ inferInstance
  exact ⟨hCl_φ, φ.isClosedEmbedding.injective⟩

theorem weil_strictlySemistable_residueFiber_geometry (K : Type u) [Field K]
    (m : ℕ) (V : ValuationSubring K) (hPkg : IsValuationRingAlgPackage m V) :
    ∀ (Q : Ideal ↥V) [Q.IsPrime], Q ≠ ⊥ → HasStrictlySemistableResidueFiberGeom V Q :=
by
  intro Q instPrimeQ hQ
  let κ := Q.ResidueField
  let s_Q : AlgebraicGeometry.Spec (CommRingCat.of κ) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of ↥V) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V κ))
  have : IsAlgClosed κ := hPkg.2.2.2.2.1 Q hQ
  intro W g_W hSS hComp
  let F_W := CategoryTheory.Limits.pullback g_W s_Q
  let fst_W := CategoryTheory.Limits.pullback.fst g_W s_Q
  let snd_W := CategoryTheory.Limits.pullback.snd g_W s_Q
  have hSecRange : ∀ {R : Type u} [CommRing R]
      (g : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ F_W)
      (p : ↥(AlgebraicGeometry.Spec (CommRingCat.of R)))
      (ev : R →+* κ),
      RingHom.ker ev = p.asIdeal →
      Set.range (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev) ≫ g).base = {g.base p} := by
    intro R _ g p ev hker
    let pt₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of κ)) := default
    have hpt₀_bot : pt₀.asIdeal = ⊥ := by
      rw [eq_bot_iff]
      intro c hc
      by_contra hc0
      exact pt₀.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem pt₀.asIdeal hc (IsUnit.mk0 c hc0))
    have hmap_pt₀ : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev)).base pt₀ = p := by
      rw [AlgebraicGeometry.Spec.map_apply]
      apply PrimeSpectrum.ext
      change Ideal.comap ev pt₀.asIdeal = p.asIdeal
      rw [hpt₀_bot, ← RingHom.ker_eq_comap_bot, hker]
    ext z
    simp only [Set.mem_range, Set.mem_singleton_iff]
    constructor
    · rintro ⟨pt, rfl⟩
      have hpt : pt = pt₀ := Subsingleton.elim pt pt₀
      rw [hpt]
      exact congrArg g.base hmap_pt₀
    · rintro rfl
      exact ⟨pt₀, congrArg g.base hmap_pt₀⟩
  obtain ⟨hPre, hRange, hCompF, hNoethF, hFinIrred, hSepSnd, hSm_fwd, hDich⟩ :=
    weil_strictlySemistable_residueFiber_baseChange_and_chart_dichotomy K V Q W g_W hSS hComp
  obtain ⟨hAlgSm, hAlgNod⟩ :=
    weil_algClosed_smooth_and_nodal_etale_ring_branch_algebra κ
      (@weil_etale_domain_over_integrallyClosed_isIntegrallyClosed)
  have hLocal : ∀ w : ↥F_W,
      ((∃ U_sm : F_W.Opens,
          w ∈ U_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (U_sm.ι ≫ snd_W)) →
        (∃ V_sm : W.Opens,
          fst_W.base w ∈ V_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ g_W))) ∧
      HasLocalSemistableCurveBranchChart κ snd_W w := by
    intro w
    rcases hDich w with ⟨hVsm, U₀, e_κ, hw, hEt, hComm⟩ | ⟨U₀, hw, e_κ, hEt, hComm, hOrigin⟩
    · refine ⟨fun _ => hVsm, Or.inl ?_⟩
      let x₀ : ↥U₀.toScheme := ⟨w, hw⟩
      obtain ⟨V_aff, hAff, hx₀_V, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := (⊤ : U₀.toScheme.Opens))
          (x := x₀) trivial
      have : AlgebraicGeometry.Etale e_κ := hEt
      let B_obj : CommRingCat.{u} := U₀.toScheme.presheaf.obj (Opposite.op V_aff)
      let φ_T_hom := AlgebraicGeometry.Spec.preimage (hAff.fromSpec ≫ e_κ)
      have hSpec_φT : AlgebraicGeometry.Spec.map φ_T_hom = hAff.fromSpec ≫ e_κ :=
        AlgebraicGeometry.Spec.map_preimage _
      have hEt_spec : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map φ_T_hom) := by
        rw [hSpec_φT]; infer_instance
      have hEt_T : φ_T_hom.hom.Etale :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hEt_spec
      let q_pt : ↥(AlgebraicGeometry.Spec B_obj) := hAff.isoSpec.hom.base ⟨x₀, hx₀_V⟩
      have : q_pt.asIdeal.IsPrime := q_pt.isPrime
      have hfrom_q : hAff.fromSpec.base q_pt = x₀ := by
        change (hAff.isoSpec.hom ≫ hAff.fromSpec).base ⟨x₀, hx₀_V⟩ = x₀
        rw [AlgebraicGeometry.IsAffineOpen.isoSpec_hom_fromSpec]
        rfl
      obtain ⟨D, instRingD, ψ, q_D, hDomD, hICD, hOpenΨ, hqD, hTwoD, hFinD⟩ :=
        hAlgSm (↑B_obj) φ_T_hom.hom hEt_T q_pt.asIdeal
      let _ : CommRing D := instRingD
      have : AlgebraicGeometry.IsOpenImmersion (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) :=
        hOpenΨ
      let j : AlgebraicGeometry.Spec (CommRingCat.of D) ⟶ F_W :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫ hAff.fromSpec ≫ U₀.ι
      have hOpen_j : AlgebraicGeometry.IsOpenImmersion j := inferInstance
      have hj_qD : j.base q_D = w := by
        change U₀.ι.base (hAff.fromSpec.base
          ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)).base q_D)) = w
        have hqD' : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)).base q_D = q_pt :=
          hqD.trans (PrimeSpectrum.ext rfl)
        rw [hqD', hfrom_q]
        rfl
      refine ⟨D, instRingD, j, q_D, hDomD, hICD, hOpen_j, hj_qD, hTwoD, ?_⟩
      intro Z hZ_cl hZ_ne
      obtain ⟨hZ_fin, hZ_sec⟩ := hFinD Z hZ_cl hZ_ne
      refine ⟨hZ_fin, fun p hp => ?_⟩
      obtain ⟨ev, hev_id, hev_ker⟩ := hZ_sec p hp
      refine ⟨AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev) ≫ j, ?_,
        hSecRange j p ev hev_ker⟩
      calc
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev) ≫ j) ≫ snd_W
            = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫
                hAff.fromSpec ≫ (U₀.ι ≫ snd_W) := by
              simp only [j, CategoryTheory.Category.assoc]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫
              (hAff.fromSpec ≫ e_κ) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) := by
              rw [hComm, CategoryTheory.Category.assoc]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫
              AlgebraicGeometry.Spec.map φ_T_hom ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) := by
              rw [← hSpec_φT]
        _ = AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (ev.comp (ψ.comp (φ_T_hom.hom.comp Polynomial.C)))) := by
              simp only [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp,
                CategoryTheory.Category.assoc]
              rfl
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (RingHom.id κ)) := by
              rw [hev_id]
        _ = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of κ)) := by
              rw [CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
    · let I_nod : Ideal (MvPolynomial (Fin 2) κ) :=
        Ideal.span {MvPolynomial.X (0 : Fin 2) * MvPolynomial.X (1 : Fin 2)}
      let c_nod : κ →+* (MvPolynomial (Fin 2) κ ⧸ I_nod) :=
        (Ideal.Quotient.mk I_nod).comp MvPolynomial.C
      have : AlgebraicGeometry.Etale e_κ := hEt
      have hNoSm : ∀ U_sm : F_W.Opens, w ∈ U_sm →
          ¬ AlgebraicGeometry.SmoothOfRelativeDimension 1 (U_sm.ι ≫ snd_W) := by
        intro U_sm hw_sm hSm
        let x₀ : ↥U₀.toScheme := ⟨w, hw⟩
        let W_inter : U₀.toScheme.Opens := (TopologicalSpace.Opens.map U₀.ι.base).obj U_sm
        have hx₀_W : x₀ ∈ W_inter := hw_sm
        obtain ⟨V_aff, hAff, hx₀_V, hV_sub⟩ :=
          AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hx₀_W
        have : AlgebraicGeometry.SmoothOfRelativeDimension 1 (U_sm.ι ≫ snd_W) := hSm
        let B_obj : CommRingCat.{u} := U₀.toScheme.presheaf.obj (Opposite.op V_aff)
        let φ_N_hom := AlgebraicGeometry.Spec.preimage (hAff.fromSpec ≫ e_κ)
        have hSpec_φN : AlgebraicGeometry.Spec.map φ_N_hom = hAff.fromSpec ≫ e_κ :=
          AlgebraicGeometry.Spec.map_preimage _
        have hEt_spec : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map φ_N_hom) := by
          rw [hSpec_φN]; infer_instance
        have hEt_N : φ_N_hom.hom.Etale :=
          (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hEt_spec
        let q_pt : ↥(AlgebraicGeometry.Spec B_obj) := hAff.isoSpec.hom.base ⟨x₀, hx₀_V⟩
        have : q_pt.asIdeal.IsPrime := q_pt.isPrime
        have hfrom_q : hAff.fromSpec.base q_pt = x₀ := by
          change (hAff.isoSpec.hom ≫ hAff.fromSpec).base ⟨x₀, hx₀_V⟩ = x₀
          rw [AlgebraicGeometry.IsAffineOpen.isoSpec_hom_fromSpec]
          rfl
        have hOrig_q : ∀ i : Fin 2,
            φ_N_hom.hom (Ideal.Quotient.mk I_nod (MvPolynomial.X i)) ∈ q_pt.asIdeal := by
          intro i
          have hmap_q : (AlgebraicGeometry.Spec.map φ_N_hom).base q_pt = e_κ.base x₀ := by
            rw [hSpec_φN]
            change e_κ.base (hAff.fromSpec.base q_pt) = e_κ.base x₀
            rw [hfrom_q]
          have hi := hOrigin i
          rw [← hmap_q, AlgebraicGeometry.Spec.map_apply] at hi
          exact hi
        have hRange_sub : Set.range (hAff.fromSpec ≫ U₀.ι).base ⊆ Set.range U_sm.ι.base := by
          rintro _ ⟨pt, rfl⟩
          have hmem_V : hAff.fromSpec.base pt ∈ V_aff := by
            change (hAff.isoSpec.inv ≫ V_aff.ι).base pt ∈ V_aff
            exact (hAff.isoSpec.inv.base pt).2
          have hmem_W : hAff.fromSpec.base pt ∈ W_inter := hV_sub hmem_V
          have hmem_Usm : U₀.ι.base (hAff.fromSpec.base pt) ∈ U_sm := hmem_W
          exact ⟨⟨_, hmem_Usm⟩, rfl⟩
        let g_lift := AlgebraicGeometry.IsOpenImmersion.lift U_sm.ι (hAff.fromSpec ≫ U₀.ι) hRange_sub
        have hg_fac : g_lift ≫ U_sm.ι = hAff.fromSpec ≫ U₀.ι :=
          AlgebraicGeometry.IsOpenImmersion.lift_fac U_sm.ι (hAff.fromSpec ≫ U₀.ι) hRange_sub
        have : AlgebraicGeometry.IsOpenImmersion (hAff.fromSpec ≫ U₀.ι) := inferInstance
        have : AlgebraicGeometry.IsOpenImmersion g_lift := by
          have : AlgebraicGeometry.IsOpenImmersion (g_lift ≫ U_sm.ι) := by
            rw [hg_fac]; infer_instance
          exact AlgebraicGeometry.IsOpenImmersion.of_comp g_lift U_sm.ι
        have : AlgebraicGeometry.SmoothOfRelativeDimension 0 g_lift :=
          (AlgebraicGeometry.Etale.iff_smoothOfRelativeDimension_zero g_lift).mp inferInstance
        have hSm_comp : AlgebraicGeometry.SmoothOfRelativeDimension 1
            (g_lift ≫ (U_sm.ι ≫ snd_W)) := by
          simpa using (inferInstance :
            AlgebraicGeometry.SmoothOfRelativeDimension (0 + 1) (g_lift ≫ (U_sm.ι ≫ snd_W)))
        have hEq_spec : g_lift ≫ (U_sm.ι ≫ snd_W) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_N_hom.hom.comp c_nod)) := by
          calc
            g_lift ≫ (U_sm.ι ≫ snd_W)
                = (g_lift ≫ U_sm.ι) ≫ snd_W := (CategoryTheory.Category.assoc _ _ _).symm
            _ = (hAff.fromSpec ≫ U₀.ι) ≫ snd_W := by rw [hg_fac]
            _ = hAff.fromSpec ≫ (U₀.ι ≫ snd_W) := CategoryTheory.Category.assoc _ _ _
            _ = hAff.fromSpec ≫ (e_κ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_nod)) := by
              rw [hComm]
            _ = (hAff.fromSpec ≫ e_κ) ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_nod) :=
              (CategoryTheory.Category.assoc _ _ _).symm
            _ = AlgebraicGeometry.Spec.map φ_N_hom ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_nod) := by
              rw [← hSpec_φN]
            _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_nod ≫ φ_N_hom) :=
              (AlgebraicGeometry.Spec.map_comp _ _).symm
            _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_N_hom.hom.comp c_nod)) := rfl
        rw [hEq_spec] at hSm_comp
        obtain ⟨s, hspan, hs⟩ :=
          (AlgebraicGeometry.HasRingHomProperty.Spec_iff
            (P := @AlgebraicGeometry.SmoothOfRelativeDimension 1)).mp hSm_comp
        have hnot_sub : ¬ ((s : Set ↑B_obj) ⊆ q_pt.asIdeal) := by
          intro hsub
          have htop : (⊤ : Ideal ↑B_obj) ≤ q_pt.asIdeal := hspan ▸ Ideal.span_le.mpr hsub
          exact q_pt.isPrime.ne_top (top_unique htop)
        obtain ⟨r, hrs, hrq⟩ := Set.not_subset.mp hnot_sub
        exact (hAlgNod (↑B_obj) φ_N_hom.hom hEt_N q_pt.asIdeal hOrig_q).1 r hrq (hs r hrs)
      refine ⟨?_, Or.inr ⟨hNoSm, ?_⟩⟩
      · rintro ⟨U_sm, hw_sm, hSm⟩
        exact False.elim (hNoSm U_sm hw_sm hSm)
      · let x₀ : ↥U₀.toScheme := ⟨w, hw⟩
        obtain ⟨V_aff, hAff, hx₀_V, _⟩ :=
          AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := (⊤ : U₀.toScheme.Opens))
            (x := x₀) trivial
        let B_obj : CommRingCat.{u} := U₀.toScheme.presheaf.obj (Opposite.op V_aff)
        let φ_N_hom := AlgebraicGeometry.Spec.preimage (hAff.fromSpec ≫ e_κ)
        have hSpec_φN : AlgebraicGeometry.Spec.map φ_N_hom = hAff.fromSpec ≫ e_κ :=
          AlgebraicGeometry.Spec.map_preimage _
        have hEt_spec : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map φ_N_hom) := by
          rw [hSpec_φN]; infer_instance
        have hEt_N : φ_N_hom.hom.Etale :=
          (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hEt_spec
        let q_pt : ↥(AlgebraicGeometry.Spec B_obj) := hAff.isoSpec.hom.base ⟨x₀, hx₀_V⟩
        have : q_pt.asIdeal.IsPrime := q_pt.isPrime
        have hfrom_q : hAff.fromSpec.base q_pt = x₀ := by
          change (hAff.isoSpec.hom ≫ hAff.fromSpec).base ⟨x₀, hx₀_V⟩ = x₀
          rw [AlgebraicGeometry.IsAffineOpen.isoSpec_hom_fromSpec]
          rfl
        have hOrig_q : ∀ i : Fin 2,
            φ_N_hom.hom (Ideal.Quotient.mk I_nod (MvPolynomial.X i)) ∈ q_pt.asIdeal := by
          intro i
          have hmap_q : (AlgebraicGeometry.Spec.map φ_N_hom).base q_pt = e_κ.base x₀ := by
            rw [hSpec_φN]
            change e_κ.base (hAff.fromSpec.base q_pt) = e_κ.base x₀
            rw [hfrom_q]
          have hi := hOrigin i
          rw [← hmap_q, AlgebraicGeometry.Spec.map_apply] at hi
          exact hi
        obtain ⟨B', instRingB', ψ, q', b, hRedB', hOpenΨ, hq', ⟨ev₀, hev₀_id, hev₀_ker⟩,
            hCovZ, hInterZ, hBranches⟩ :=
          (hAlgNod (↑B_obj) φ_N_hom.hom hEt_N q_pt.asIdeal hOrig_q).2
        let _ : CommRing B' := instRingB'
        have : AlgebraicGeometry.IsOpenImmersion (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) :=
          hOpenΨ
        let j : AlgebraicGeometry.Spec (CommRingCat.of B') ⟶ F_W :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫ hAff.fromSpec ≫ U₀.ι
        have hOpen_j : AlgebraicGeometry.IsOpenImmersion j := inferInstance
        have hj_q' : j.base q' = w := by
          change U₀.ι.base (hAff.fromSpec.base
            ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)).base q')) = w
          have hq'' : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)).base q' = q_pt :=
            hq'.trans (PrimeSpectrum.ext rfl)
          rw [hq'', hfrom_q]
          rfl
        have hσ₀_comm :
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev₀) ≫ j) ≫ snd_W =
              𝟙 (AlgebraicGeometry.Spec (CommRingCat.of κ)) := by
          calc
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev₀) ≫ j) ≫ snd_W
                = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev₀) ≫
                    AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫
                    hAff.fromSpec ≫ (U₀.ι ≫ snd_W) := by
                  simp only [j, CategoryTheory.Category.assoc]
            _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev₀) ≫
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫
                  (hAff.fromSpec ≫ e_κ) ≫
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_nod) := by
                  rw [hComm, CategoryTheory.Category.assoc]
            _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev₀) ≫
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫
                  AlgebraicGeometry.Spec.map φ_N_hom ≫
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_nod) := by
                  rw [← hSpec_φN]
            _ = AlgebraicGeometry.Spec.map
                  (CommRingCat.ofHom (ev₀.comp (ψ.comp (φ_N_hom.hom.comp c_nod)))) := by
                  simp only [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp,
                    CategoryTheory.Category.assoc]
                  rfl
            _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (RingHom.id κ)) := by
                  rw [hev₀_id]
            _ = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of κ)) := by
                  rw [CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
        have hσ₀_range :
            Set.range (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev₀) ≫ j).base = {w} := by
          rw [hSecRange j q' ev₀ hev₀_ker, hj_q']
        refine ⟨B', instRingB', j, q', b, hRedB', hOpen_j, hj_q',
          ⟨AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev₀) ≫ j, hσ₀_comm, hσ₀_range⟩,
          hCovZ, hInterZ, ?_⟩
        intro i
        obtain ⟨hPrime_i, hDom_i, hIC_i, hTwo_i, hFin_i⟩ := hBranches i
        refine ⟨hPrime_i, hDom_i, hIC_i, hTwo_i, ?_⟩
        intro Z hZ_cl hZ_ne
        obtain ⟨hZ_fin, hZ_sec⟩ := hFin_i Z hZ_cl hZ_ne
        refine ⟨hZ_fin, fun p hp => ?_⟩
        obtain ⟨ev, hev_id, hev_ker⟩ := hZ_sec p hp
        let mk_i := Ideal.Quotient.mk (Ideal.span {b i})
        let j_i : AlgebraicGeometry.Spec (CommRingCat.of (B' ⧸ Ideal.span {b i})) ⟶ F_W :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom mk_i) ≫ j
        refine ⟨AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev) ≫ j_i, ?_,
          hSecRange j_i p ev hev_ker⟩
        calc
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev) ≫ j_i) ≫ snd_W
              = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev) ≫
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom mk_i) ≫
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫
                  hAff.fromSpec ≫ (U₀.ι ≫ snd_W) := by
                simp only [j_i, j, CategoryTheory.Category.assoc]
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom mk_i) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫
                (hAff.fromSpec ≫ e_κ) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_nod) := by
                rw [hComm, CategoryTheory.Category.assoc]
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom mk_i) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫
                AlgebraicGeometry.Spec.map φ_N_hom ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_nod) := by
                rw [← hSpec_φN]
          _ = AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (ev.comp (mk_i.comp (ψ.comp (φ_N_hom.hom.comp c_nod))))) := by
                simp only [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp,
                  CategoryTheory.Category.assoc]
                rfl
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (RingHom.id κ)) := by
                rw [hev_id]
          _ = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of κ)) := by
                rw [CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
  obtain ⟨hRedF, hC7, hC8, hC9, hC10, hC11⟩ :=
    weil_algClosed_semistable_curve_fiber_branches_and_subschemes κ F_W snd_W hCompF hSepSnd
      (fun w => (hLocal w).2)
  refine ⟨hPre, hRange, hNoethF, hFinIrred, hRedF,
    fun w => ⟨hSm_fwd w, (hLocal w).1⟩,
    hC7, hC8, hC9, hC10, fun H hH => ?_⟩
  obtain ⟨hTwoH, hFinH, H_sch, ιH, hCl_ιH, hInt_H, hRange_ιH, hNorm_H⟩ := hC11 H hH
  have hH_cl : IsClosed H := isClosed_of_mem_irreducibleComponents H hH
  refine ⟨hTwoH, hFinH, ⟨H_sch, ιH, hCl_ιH, hInt_H, hRange_ιH, hNorm_H⟩,
    fun E_sch φ U₀ hInt_E hProp_φ hRange_φ hNe_inter hFin_compl hCl_U₀ =>
      weil_normal_component_proper_birational_closedImmersion
        (@weil_birational_proper_iso_of_locallyQuasiFinite_normal)
        F_W H hH_cl H_sch ιH hCl_ιH hInt_H hRange_ιH hNorm_H
        E_sch φ U₀ hInt_E hProp_φ hRange_φ hNe_inter hFin_compl hCl_U₀⟩

theorem weil_blowup_tower_fiber_p1_tree_invariant (K : Type u) [Field K]
    (V : ValuationSubring K) (P : Ideal ↥V) [P.IsPrime] (hP : P ≠ ⊥)
    (hAlgP : IsAlgClosed P.ResidueField)
    (hFibGeom : HasStrictlySemistableResidueFiberGeom V P)
    (n : ℕ) (S : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V)).Opens)
    (X C₁ : AlgebraicGeometry.Scheme.{u})
    (g_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (g₁ : C₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (q₁ : C₁ ⟶ X)
    (τ_X : ∀ j : Fin n, (S j).toScheme ⟶ X)
    (τ₁ : ∀ j : Fin n, (S j).toScheme ⟶ C₁)
    (x₀ : X)
    (hSS_X : IsStrictlySemistableCurveOverValuation V g_X)
    (hNoeth_X : TopologicalSpace.NoetherianSpace ↥X)
    (hTow₁ : IsElementaryBlowupTower V g_X g₁ q₁)
    (hτX_g : ∀ j : Fin n, τ_X j ≫ g_X = (S j).ι)
    (hτ₁_g : ∀ j : Fin n, τ₁ j ≫ g₁ = (S j).ι)
    (hτ₁_q₁ : ∀ j : Fin n, τ₁ j ≫ q₁ = τ_X j)
    (hDisj_X : _root_.Pairwise fun i j : Fin n =>
      Disjoint (Set.range (τ_X i).base) (Set.range (τ_X j).base))
    (hDisj₁ : _root_.Pairwise fun i j : Fin n =>
      Disjoint (Set.range (τ₁ i).base) (Set.range (τ₁ j).base))
    (hSm_X : ∀ (j : Fin n) (b : (S j).toScheme),
      ∃ V_sm : X.Opens,
        (τ_X j).base b ∈ V_sm ∧
        AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ g_X))
    (hClosed_x₀ : IsClosed ({x₀} : Set X))
    (hx₀_P : (g_X.base x₀).asIdeal = P) :
    let s_P := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V P.ResidueField))
    let F₁ := CategoryTheory.Limits.pullback g₁ s_P
    let fst₁ := CategoryTheory.Limits.pullback.fst g₁ s_P
    let snd₁ := CategoryTheory.Limits.pullback.snd g₁ s_P
    let T : Set ↥F₁ := {w : ↥F₁ | q₁.base (fst₁.base w) = x₀}
    let D₁ : Set ↥F₁ := {w : ↥F₁ | ∃ j : Fin n, fst₁.base w ∈ Set.range (τ₁ j).base}
    T.Subsingleton ∨
      ∃ (m : ℕ) (_ : 1 ≤ m)
        (E : Fin m → Set ↥F₁)
        (E_sch : Fin m → AlgebraicGeometry.Scheme.{u})
        (ιE : ∀ a : Fin m, E_sch a ⟶ F₁)
        (Γ_T : SimpleGraph (Fin m)),
        T = (⋃ a : Fin m, E a) ∧
        Function.Injective E ∧
        (∀ a : Fin m,
          E a ∈ irreducibleComponents ↥F₁ ∧
          AlgebraicGeometry.IsClosedImmersion (ιE a) ∧
          AlgebraicGeometry.IsIntegral (E_sch a) ∧
          Set.range (ιE a).base = E a ∧
          ∃ isoP1 : E_sch a ≅ (weilProjectiveSpaceOver P.ResidueField 1).left,
            ιE a ≫ snd₁ = isoP1.hom ≫ (weilProjectiveSpaceOver P.ResidueField 1).hom) ∧
        (∀ a b : Fin m, a ≠ b → (E a ∩ E b).Subsingleton) ∧
        (∀ a b : Fin m, Γ_T.Adj a b ↔ a ≠ b ∧ (E a ∩ E b).Nonempty) ∧
        Γ_T.IsTree ∧
        let R_ext : Set ↥F₁ := ⋃ H ∈ (irreducibleComponents ↥F₁) \ Set.range E, H
        ((T ∩ R_ext) ∪ (D₁ ∩ T)).Finite ∧
        Nat.card ↥((T ∩ R_ext) ∪ (D₁ ∩ T)) ≤ 2 :=
by
  classical
  intro s_P F₁ fst₁ snd₁ T D₁
  let IsUnpointedFiberP1Tree :
      ∀ {W : AlgebraicGeometry.Scheme.{u}}
        (g_W : W ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V)),
        Set ↥(CategoryTheory.Limits.pullback g_W s_P) → ℕ → Prop :=
    fun {_W} g_W T_W b_W =>
      let F := CategoryTheory.Limits.pullback g_W s_P
      let snd := CategoryTheory.Limits.pullback.snd g_W s_P
      ∃ (m : ℕ) (_ : 1 ≤ m)
        (E : Fin m → Set ↥F)
        (E_sch : Fin m → AlgebraicGeometry.Scheme.{u})
        (ιE : ∀ a : Fin m, E_sch a ⟶ F)
        (Γ_T : SimpleGraph (Fin m)),
        T_W = (⋃ a : Fin m, E a) ∧
        Function.Injective E ∧
        (∀ a : Fin m,
          E a ∈ irreducibleComponents ↥F ∧
          AlgebraicGeometry.IsClosedImmersion (ιE a) ∧
          AlgebraicGeometry.IsIntegral (E_sch a) ∧
          Set.range (ιE a).base = E a ∧
          ∃ isoP1 : E_sch a ≅ (weilProjectiveSpaceOver P.ResidueField 1).left,
            ιE a ≫ snd = isoP1.hom ≫ (weilProjectiveSpaceOver P.ResidueField 1).hom) ∧
        (∀ a b : Fin m, a ≠ b → (E a ∩ E b).Subsingleton) ∧
        (∀ a b : Fin m, Γ_T.Adj a b ↔ a ≠ b ∧ (E a ∩ E b).Nonempty) ∧
        Γ_T.IsTree ∧
        let R_ext : Set ↥F := ⋃ H ∈ (irreducibleComponents ↥F) \ Set.range E, H
        (T_W ∩ R_ext).Finite ∧
        Nat.card ↥(T_W ∩ R_ext) ≤ b_W
  
  have hTree_leaf : ∀ (m : ℕ), 1 ≤ m →
      ∀ (G : SimpleGraph (Fin m)), G.IsTree →
      ∀ (G' : SimpleGraph (Fin (m + 1))) (a₀ : Fin m),
        (∀ a b : Fin m, G'.Adj a.castSucc b.castSucc ↔ G.Adj a b) →
        (∀ a : Fin m, G'.Adj a.castSucc (Fin.last m) ↔ a = a₀) →
        G'.IsTree := by
    clear hAlgP hFibGeom S X C₁ g_X g₁ q₁ τ_X τ₁ x₀ hSS_X hNoeth_X hTow₁
      hτX_g hτ₁_g hτ₁_q₁ hDisj_X hDisj₁ hSm_X hClosed_x₀ hx₀_P
      F₁ fst₁ snd₁ T D₁ IsUnpointedFiberP1Tree
    intro m hm G hTree G' a₀ hCC hLast
    have hne_m : Nonempty (Fin m) := ⟨⟨0, by omega⟩⟩
    have hne_m1 : Nonempty (Fin (m + 1)) := ⟨Fin.last m⟩
    obtain ⟨hConn, hCard⟩ := SimpleGraph.isTree_iff_connected_and_card.mp hTree
    rw [Nat.card_fin] at hCard
    rw [SimpleGraph.isTree_iff_connected_and_card, Nat.card_fin]
    have hReach : ∀ a b : Fin m, G.Reachable a b → G'.Reachable a.castSucc b.castSucc := by
      rintro a b ⟨p⟩
      induction p with
      | nil => exact SimpleGraph.Reachable.refl _
      | @cons u v w hadj _ ih =>
        exact (((hCC u v).mpr hadj).reachable).trans ih
    have hFromA0 : ∀ u : Fin (m + 1), G'.Reachable a₀.castSucc u := by
      intro u
      refine Fin.lastCases ?_ ?_ u
      · exact ((hLast a₀).mpr rfl).reachable
      · intro a
        exact hReach a₀ a (hConn.preconnected a₀ a)
    refine ⟨⟨fun u v => (hFromA0 u).symm.trans (hFromA0 v)⟩, ?_⟩
    have hMapMem : ∀ e : Sym2 (Fin m), e ∈ G.edgeSet → Sym2.map Fin.castSucc e ∈ G'.edgeSet := by
      intro e
      refine Sym2.ind (fun u v he => ?_) e
      change s(u.castSucc, v.castSucc) ∈ G'.edgeSet
      rw [G'.mem_edgeSet, hCC]
      exact (G.mem_edgeSet).mp he
    have hNotLast : ∀ e : Sym2 (Fin m), Fin.last m ∉ Sym2.map Fin.castSucc e := by
      intro e
      refine Sym2.ind (fun u v hmem => ?_) e
      change Fin.last m ∈ s(u.castSucc, v.castSucc) at hmem
      rw [Sym2.mem_iff] at hmem
      rcases hmem with h | h
      · exact Fin.castSucc_ne_last u h.symm
      · exact Fin.castSucc_ne_last v h.symm
    let Φ : Option ↥G.edgeSet → ↥G'.edgeSet := fun o =>
      match o with
      | none => ⟨s(a₀.castSucc, Fin.last m), (G'.mem_edgeSet).mpr ((hLast a₀).mpr rfl)⟩
      | some e => ⟨Sym2.map Fin.castSucc e.1, hMapMem e.1 e.2⟩
    have hBij : Function.Bijective Φ := by
      refine ⟨?_, ?_⟩
      · intro x y hxy
        have hval : (Φ x).1 = (Φ y).1 := congrArg Subtype.val hxy
        cases x with
        | none =>
          cases y with
          | none => rfl
          | some ey =>
            exfalso
            have hm1 : Fin.last m ∈ (Φ none).1 := Sym2.mem_iff.mpr (Or.inr rfl)
            rw [hval] at hm1
            exact hNotLast ey.1 hm1
        | some ex =>
          cases y with
          | none =>
            exfalso
            have hm1 : Fin.last m ∈ (Φ none).1 := Sym2.mem_iff.mpr (Or.inr rfl)
            rw [← hval] at hm1
            exact hNotLast ex.1 hm1
          | some ey =>
            congr 1
            apply Subtype.ext
            exact Sym2.map.injective (Fin.castSucc_injective m) hval
      · rintro ⟨e', he'⟩
        suffices ∃ o : Option ↥G.edgeSet, (Φ o).1 = e' by
          obtain ⟨o, ho⟩ := this
          exact ⟨o, Subtype.ext ho⟩
        revert he'
        refine Sym2.ind (fun x y => ?_) e'
        refine Fin.lastCases ?_ (fun a => ?_) x
        · refine Fin.lastCases ?_ (fun b => ?_) y
          · intro he'
            rw [G'.mem_edgeSet] at he'
            exact False.elim (he'.ne rfl)
          · intro he'
            rw [G'.mem_edgeSet] at he'
            have hb : b = a₀ := (hLast b).mp he'.symm
            subst hb
            exact ⟨none, Sym2.eq_swap⟩
        · refine Fin.lastCases ?_ (fun b => ?_) y
          · intro he'
            rw [G'.mem_edgeSet] at he'
            have ha : a = a₀ := (hLast a).mp he'
            subst ha
            exact ⟨none, rfl⟩
          · intro he'
            rw [G'.mem_edgeSet] at he'
            have hab : G.Adj a b := (hCC a b).mp he'
            exact ⟨some ⟨s(a, b), (G.mem_edgeSet).mpr hab⟩, rfl⟩
    have hCardEq : Nat.card ↥G'.edgeSet = Nat.card (Option ↥G.edgeSet) :=
      (Nat.card_congr (Equiv.ofBijective Φ hBij)).symm
    rw [hCardEq, Finite.card_option]
    omega
  have hTree_subdiv : ∀ (m : ℕ), 1 ≤ m →
      ∀ (G : SimpleGraph (Fin m)), G.IsTree →
      ∀ (G' : SimpleGraph (Fin (m + 1))) (a₀ b₀ : Fin m),
        a₀ ≠ b₀ → G.Adj a₀ b₀ →
        (∀ a b : Fin m, G'.Adj a.castSucc b.castSucc ↔ G.Adj a b ∧ s(a, b) ≠ s(a₀, b₀)) →
        (∀ a : Fin m, G'.Adj a.castSucc (Fin.last m) ↔ a = a₀ ∨ a = b₀) →
        G'.IsTree := by
    clear hTree_leaf hAlgP hFibGeom S X C₁ g_X g₁ q₁ τ_X τ₁ x₀ hSS_X hNoeth_X hTow₁
      hτX_g hτ₁_g hτ₁_q₁ hDisj_X hDisj₁ hSm_X hClosed_x₀ hx₀_P
      F₁ fst₁ snd₁ T D₁ IsUnpointedFiberP1Tree
    intro m hm G hTree G' a₀ b₀ hne₀ hadj₀ hCC hLast
    have hne_m : Nonempty (Fin m) := ⟨⟨0, by omega⟩⟩
    have hne_m1 : Nonempty (Fin (m + 1)) := ⟨Fin.last m⟩
    obtain ⟨hConn, hCard⟩ := SimpleGraph.isTree_iff_connected_and_card.mp hTree
    rw [Nat.card_fin] at hCard
    rw [SimpleGraph.isTree_iff_connected_and_card, Nat.card_fin]
    have ha₀_last : G'.Adj a₀.castSucc (Fin.last m) := (hLast a₀).mpr (Or.inl rfl)
    have hb₀_last : G'.Adj b₀.castSucc (Fin.last m) := (hLast b₀).mpr (Or.inr rfl)
    have hStep : ∀ a b : Fin m, G.Adj a b → G'.Reachable a.castSucc b.castSucc := by
      intro a b hadj
      by_cases h_eq : s(a, b) = s(a₀, b₀)
      · rcases Sym2.eq_iff.mp h_eq with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
        · exact ha₀_last.reachable.trans hb₀_last.symm.reachable
        · exact hb₀_last.reachable.trans ha₀_last.symm.reachable
      · exact ((hCC a b).mpr ⟨hadj, h_eq⟩).reachable
    have hReach : ∀ a b : Fin m, G.Reachable a b → G'.Reachable a.castSucc b.castSucc := by
      rintro a b ⟨p⟩
      induction p with
      | nil => exact SimpleGraph.Reachable.refl _
      | @cons u v w hadj _ ih => exact (hStep u v hadj).trans ih
    have hFromA0 : ∀ u : Fin (m + 1), G'.Reachable a₀.castSucc u := by
      intro u
      refine Fin.lastCases ?_ ?_ u
      · exact ha₀_last.reachable
      · intro a
        exact hReach a₀ a (hConn.preconnected a₀ a)
    refine ⟨⟨fun u v => (hFromA0 u).symm.trans (hFromA0 v)⟩, ?_⟩
    have hMapMem : ∀ e : Sym2 (Fin m),
        e ∈ G.edgeSet → e ≠ s(a₀, b₀) → Sym2.map Fin.castSucc e ∈ G'.edgeSet := by
      intro e
      refine Sym2.ind (fun u v he hne => ?_) e
      change s(u.castSucc, v.castSucc) ∈ G'.edgeSet
      rw [G'.mem_edgeSet, hCC]
      exact ⟨(G.mem_edgeSet).mp he, hne⟩
    have hNotLast : ∀ e : Sym2 (Fin m), Fin.last m ∉ Sym2.map Fin.castSucc e := by
      intro e
      refine Sym2.ind (fun u v hmem => ?_) e
      change Fin.last m ∈ s(u.castSucc, v.castSucc) at hmem
      rw [Sym2.mem_iff] at hmem
      rcases hmem with h | h
      · exact Fin.castSucc_ne_last u h.symm
      · exact Fin.castSucc_ne_last v h.symm
    have hEdgeNe : s(a₀.castSucc, Fin.last m) ≠ s(b₀.castSucc, Fin.last m) := by
      intro heq
      rcases Sym2.eq_iff.mp heq with ⟨hab, _⟩ | ⟨hal, _⟩
      · exact hne₀ (Fin.castSucc_injective m hab)
      · exact Fin.castSucc_ne_last a₀ hal
    let Ψ : Option ↥G.edgeSet → ↥G'.edgeSet := fun o =>
      match o with
      | none => ⟨s(b₀.castSucc, Fin.last m), (G'.mem_edgeSet).mpr hb₀_last⟩
      | some e =>
        if h : e.1 = s(a₀, b₀) then
          ⟨s(a₀.castSucc, Fin.last m), (G'.mem_edgeSet).mpr ha₀_last⟩
        else
          ⟨Sym2.map Fin.castSucc e.1, hMapMem e.1 e.2 h⟩
    have hBij : Function.Bijective Ψ := by
      refine ⟨?_, ?_⟩
      · intro x y hxy
        have hval : (Ψ x).1 = (Ψ y).1 := congrArg Subtype.val hxy
        cases x with
        | none =>
          cases y with
          | none => rfl
          | some ey =>
            exfalso
            dsimp only [Ψ] at hval
            split_ifs at hval with hey
            · exact hEdgeNe (by simpa using hval.symm)
            · have hm1 : Fin.last m ∈ s(b₀.castSucc, Fin.last m) := Sym2.mem_iff.mpr (Or.inr rfl)
              have hval' : s(b₀.castSucc, Fin.last m) = Sym2.map Fin.castSucc ey.1 := hval
              rw [hval'] at hm1
              exact hNotLast ey.1 hm1
        | some ex =>
          cases y with
          | none =>
            exfalso
            dsimp only [Ψ] at hval
            split_ifs at hval with hex
            · exact hEdgeNe (by simpa using hval)
            · have hm1 : Fin.last m ∈ s(b₀.castSucc, Fin.last m) := Sym2.mem_iff.mpr (Or.inr rfl)
              have hval' : Sym2.map Fin.castSucc ex.1 = s(b₀.castSucc, Fin.last m) := hval
              rw [← hval'] at hm1
              exact hNotLast ex.1 hm1
          | some ey =>
            dsimp only [Ψ] at hval
            split_ifs at hval with hex hey hey
            · congr 1
              exact Subtype.ext (hex.trans hey.symm)
            · exfalso
              have hm1 : Fin.last m ∈ s(a₀.castSucc, Fin.last m) := Sym2.mem_iff.mpr (Or.inr rfl)
              have hval' : s(a₀.castSucc, Fin.last m) = Sym2.map Fin.castSucc ey.1 := hval
              rw [hval'] at hm1
              exact hNotLast ey.1 hm1
            · exfalso
              have hm1 : Fin.last m ∈ s(a₀.castSucc, Fin.last m) := Sym2.mem_iff.mpr (Or.inr rfl)
              have hval' : Sym2.map Fin.castSucc ex.1 = s(a₀.castSucc, Fin.last m) := hval
              rw [← hval'] at hm1
              exact hNotLast ex.1 hm1
            · congr 1
              apply Subtype.ext
              exact Sym2.map.injective (Fin.castSucc_injective m) hval
      · rintro ⟨e', he'⟩
        suffices ∃ o : Option ↥G.edgeSet, (Ψ o).1 = e' by
          obtain ⟨o, ho⟩ := this
          exact ⟨o, Subtype.ext ho⟩
        revert he'
        refine Sym2.ind (fun x y => ?_) e'
        refine Fin.lastCases ?_ (fun a => ?_) x
        · refine Fin.lastCases ?_ (fun b => ?_) y
          · intro he'
            rw [G'.mem_edgeSet] at he'
            exact False.elim (he'.ne rfl)
          · intro he'
            rw [G'.mem_edgeSet] at he'
            rcases (hLast b).mp he'.symm with h | h
            · rw [h]
              refine ⟨some ⟨s(a₀, b₀), (G.mem_edgeSet).mpr hadj₀⟩, ?_⟩
              dsimp only [Ψ]
              simp only [↓reduceDIte]
              exact Sym2.eq_swap
            · rw [h]
              exact ⟨none, Sym2.eq_swap⟩
        · refine Fin.lastCases ?_ (fun b => ?_) y
          · intro he'
            rw [G'.mem_edgeSet] at he'
            rcases (hLast a).mp he' with h | h
            · rw [h]
              refine ⟨some ⟨s(a₀, b₀), (G.mem_edgeSet).mpr hadj₀⟩, ?_⟩
              dsimp only [Ψ]
              simp only [↓reduceDIte]
            · rw [h]
              exact ⟨none, rfl⟩
          · intro he'
            rw [G'.mem_edgeSet] at he'
            obtain ⟨hab, hne⟩ := (hCC a b).mp he'
            refine ⟨some ⟨s(a, b), (G.mem_edgeSet).mpr hab⟩, ?_⟩
            dsimp only [Ψ]
            rw [dif_neg hne]
            rfl
    have hCardEq : Nat.card ↥G'.edgeSet = Nat.card (Option ↥G.edgeSet) :=
      (Nat.card_congr (Equiv.ofBijective Ψ hBij)).symm
    rw [hCardEq, Finite.card_option]
    omega
  
