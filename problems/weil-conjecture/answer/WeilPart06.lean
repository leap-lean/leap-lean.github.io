        have h1 : φ_a Polynomial.X = HomogeneousLocalization.Away.isLocalizationElem ha hb := by
          simp [φ_a]
        rw [h1, HomogeneousLocalization.Away.isLocalizationElem, HomogeneousLocalization.Away.val_mk]
        simp only [pow_one]
      have hval_sum : ∀ {ι : Type} (s_fin : Finset ι)
          (g_fn : ι → HomogeneousLocalization.Away 𝒜_1 (MvPolynomial.X a)),
          HomogeneousLocalization.val (∑ x ∈ s_fin, g_fn x) =
            ∑ x ∈ s_fin, HomogeneousLocalization.val (g_fn x) := by
        intro ι s_fin g_fn
        classical
        induction s_fin using Finset.induction with
        | empty => simp [HomogeneousLocalization.val_zero]
        | insert x s hxs ih =>
          rw [Finset.sum_insert hxs, Finset.sum_insert hxs, HomogeneousLocalization.val_add, ih]
