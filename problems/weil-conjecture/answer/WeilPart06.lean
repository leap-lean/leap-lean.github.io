      let : CommRing R_w := instRingRw
      have : AlgebraicGeometry.IsOpenImmersion j := hOpen_j
      have : J.IsPrime := hPrime_J
      let V_w : F.Opens := j.opensRange
      let W_H : H_sch.Opens := (TopologicalSpace.Opens.map ιH.base).obj V_w
