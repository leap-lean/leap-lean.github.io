        have hUnitDecomp : ∀ x : B_P, x ≠ 0 → ∃ (k : ℕ) (u : B_P), IsUnit u ∧ x = t ^ k * u := by
          intro x hx0
          have hx_not_inf : x ∉ (⨅ i : ℕ, m_P ^ i) := by
            rw [hKrull]; exact hx0
          rw [Ideal.mem_iInf] at hx_not_inf
          obtain ⟨n, hxn⟩ := not_forall.mp hx_not_inf
          obtain ⟨k, _, u, hu, hxu⟩ := hDecomp n x hxn
          exact ⟨k, u, hu, hxu⟩
        have : NoZeroDivisors B_P := ⟨fun {x y} hxy => by
          by_cases hx : x = 0
          · exact Or.inl hx
          · by_cases hy : y = 0
            · exact Or.inr hy
            · exfalso
              obtain ⟨k, u, hu, rfl⟩ := hUnitDecomp x hx
              obtain ⟨l, v, hv, rfl⟩ := hUnitDecomp y hy
              have hprod : t ^ (k + l) * (u * v) = 0 := by
                calc
                  t ^ (k + l) * (u * v) = (t ^ k * u) * (t ^ l * v) := by rw [pow_add]; ring
                  _ = 0 := hxy
              have huv0 : u * v = 0 := ht_pow_reg (k + l) (u * v) hprod
              exact (hu.mul hv).ne_zero huv0⟩
        exact NoZeroDivisors.to_isDomain B_P
    have hRedB : IsReduced B := ⟨fun x ⟨n, hxn⟩ => by
      by_contra hx0
      let ann : Ideal B := { carrier := {s : B | s * x = 0}
                             add_mem' := fun {a b} ha hb => by dsimp at *; rw [add_mul, ha, hb, add_zero]
                             zero_mem' := by dsimp; rw [zero_mul]
                             smul_mem' := fun c {a} ha => by dsimp at *; rw [mul_assoc, ha, mul_zero] }
