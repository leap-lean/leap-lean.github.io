  have hI₀_Φ₀ : I₀ ≤ RingHom.ker Φ₀ := by
    rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker, map_mul]
    simp [Φ₀]
  let Φbar₀ : R₀ →+* Polynomial k₀ := Ideal.Quotient.lift I₀ Φ₀ (fun _ hx => hI₀_Φ₀ hx)
  have hX₁_Φ₀ : Ideal.span {Xbar₁} ≤ RingHom.ker Φbar₀ := by
    rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
    change Φ₀ (MvPolynomial.X 1) = 0
    simp [Φ₀]
  let f_e₀ : (R₀ ⧸ Ideal.span {Xbar₁}) →+* Polynomial k₀ :=
