          (by
            apply AlgHom.ext
            intro x
            obtain ⟨d, rfl⟩ := Ideal.Quotient.mk_surjective x
            change fwd ((1 : L₀) ⊗ₜ[Polynomial κ] d) = Ideal.Quotient.mk J₀ d
            dsimp only [fwd]
            rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
            rfl)
          (by
            apply Algebra.TensorProduct.ext
            · ext
            · apply AlgHom.ext
              intro d
              change bwd_D (fwd ((1 : L₀) ⊗ₜ[Polynomial κ] d)) = (1 : L₀) ⊗ₜ[Polynomial κ] d
              dsimp only [fwd]
              rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
