      have hΓ_fst : Γ_σ ≫ CategoryTheory.Limits.pullback.fst p p = 𝟙 F_Z :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hΓ_snd : Γ_σ ≫ CategoryTheory.Limits.pullback.snd p p = p ≫ σ :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      have hcomm : σ ≫ Γ_σ = σ ≫ CategoryTheory.Limits.pullback.diagonal p := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · rw [CategoryTheory.Category.assoc, hΓ_fst, CategoryTheory.Category.comp_id,
            CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.diagonal_fst,
            CategoryTheory.Category.comp_id]
        · rw [CategoryTheory.Category.assoc, hΓ_snd, ← CategoryTheory.Category.assoc, hσ,
            CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc,
            CategoryTheory.Limits.pullback.diagonal_snd, CategoryTheory.Category.comp_id]
      have hLim : CategoryTheory.Limits.IsLimit
          (CategoryTheory.Limits.PullbackCone.mk σ σ hcomm) :=
        CategoryTheory.Limits.PullbackCone.IsLimit.mk hcomm
          (fun s => s.fst ≫ p)
          (fun s => by
            have h1 : s.fst = s.snd := by
              have h := s.condition =≫ CategoryTheory.Limits.pullback.fst p p
              rwa [CategoryTheory.Category.assoc, hΓ_fst, CategoryTheory.Category.comp_id,
                CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.diagonal_fst,
                CategoryTheory.Category.comp_id] at h
            have h2 : s.fst ≫ p ≫ σ = s.snd := by
              have h := s.condition =≫ CategoryTheory.Limits.pullback.snd p p
              rwa [CategoryTheory.Category.assoc, hΓ_snd,
                CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.diagonal_snd,
                CategoryTheory.Category.comp_id] at h
            rw [CategoryTheory.Category.assoc, h2, h1])
          (fun s => by
            have h := s.condition =≫ CategoryTheory.Limits.pullback.snd p p
            rw [CategoryTheory.Category.assoc, hΓ_snd,
              CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.diagonal_snd,
              CategoryTheory.Category.comp_id] at h
            simpa only [CategoryTheory.Category.assoc] using h)
          (fun s m hm _ => by
            calc m = m ≫ 𝟙 _ := (CategoryTheory.Category.comp_id m).symm
              _ = m ≫ (σ ≫ p) := by rw [hσ]
              _ = (m ≫ σ) ≫ p := (CategoryTheory.Category.assoc m σ p).symm
              _ = s.fst ≫ p := by rw [hm])
      have hPb_σ : CategoryTheory.IsPullback σ σ Γ_σ
          (CategoryTheory.Limits.pullback.diagonal p) :=
        CategoryTheory.IsPullback.of_isLimit hLim
      have hCl_σ : AlgebraicGeometry.IsClosedImmersion σ :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (P := @AlgebraicGeometry.IsClosedImmersion) hPb_σ.flip inferInstance
      have hRange_σ : Set.range σ.base = {σ.base (⊥ : PrimeSpectrum P.ResidueField)} := by
        ext w
        simp only [Set.mem_range, Set.mem_singleton_iff]
        refine ⟨fun ⟨u, hu⟩ => ?_, fun hw => ⟨(⊥ : PrimeSpectrum P.ResidueField), hw.symm⟩⟩
        rw [hSpecFieldEqBot P.ResidueField u] at hu
        exact hu.symm
      refine ⟨hCl_σ, ?_⟩
      rw [← hRange_σ]
      exact σ.isClosedEmbedding.isClosed_range
  
  
  
  have hPbIsoRes : ∀ {P_s X_s Y_s Z_s : AlgebraicGeometry.Scheme.{u}}
      {a : P_s ⟶ X_s} {b : P_s ⟶ Y_s} {c : X_s ⟶ Z_s} {d : Y_s ⟶ Z_s},
      CategoryTheory.IsPullback a b c d →
      ∀ (V_1 : Z_s.Opens), CategoryTheory.IsIso (c ∣_ V_1) →
        CategoryTheory.IsIso (b ∣_ (TopologicalSpace.Opens.map d.base).obj V_1) := by
    intro P_s X_s Y_s Z_s a b c d hPb V_1 hIso_c
