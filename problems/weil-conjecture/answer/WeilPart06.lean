        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V P.ResidueField))
      have hπ_g : π₁ ≫ g_X = π₂ ≫ g_Y := by
        calc
          π₁ ≫ g_X = π₁ ≫ (f_X ≫ U_ab.ι ≫ g') := by rw [hfX_g]
          _ = (π₁ ≫ f_X) ≫ (U_ab.ι ≫ g') := by rw [← CategoryTheory.Category.assoc]
          _ = (π₂ ≫ f_Y) ≫ (U_ab.ι ≫ g') := by rw [hπ_comm]
          _ = π₂ ≫ (f_Y ≫ U_ab.ι ≫ g') := by rw [CategoryTheory.Category.assoc]
          _ = π₂ ≫ g_Y := by rw [hfY_g]
      let π₂_P : CategoryTheory.Limits.pullback (π₁ ≫ g_X) s_P ⟶
          CategoryTheory.Limits.pullback g_Y s_P :=
        CategoryTheory.Limits.pullback.lift
          (CategoryTheory.Limits.pullback.fst (π₁ ≫ g_X) s_P ≫ π₂)
          (CategoryTheory.Limits.pullback.snd (π₁ ≫ g_X) s_P)
          (by rw [CategoryTheory.Category.assoc, ← hπ_g, CategoryTheory.Limits.pullback.condition])
      have hπ₂P_im : π₂_P.base '' E_tilde = F_target :=
        hE_im π₂_P (CategoryTheory.Limits.pullback.lift_fst _ _ _)
          (CategoryTheory.Limits.pullback.lift_snd _ _ _)
      have hqP_g : q_P ≫ (π₁ ≫ g_X) = g₁ := by
        rw [← CategoryTheory.Category.assoc, hqP_π₁, hq₁_gX]
      let q_P_fib : CategoryTheory.Limits.pullback g₁ s_P ⟶
          CategoryTheory.Limits.pullback (π₁ ≫ g_X) s_P :=
        CategoryTheory.Limits.pullback.lift
          (CategoryTheory.Limits.pullback.fst g₁ s_P ≫ q_P)
          (CategoryTheory.Limits.pullback.snd g₁ s_P)
          (by rw [CategoryTheory.Category.assoc, hqP_g, CategoryTheory.Limits.pullback.condition])
      have hPb_qP_fib : CategoryTheory.IsPullback
          (CategoryTheory.Limits.pullback.fst g₁ s_P)
          q_P_fib q_P
          (CategoryTheory.Limits.pullback.fst (π₁ ≫ g_X) s_P) := by
        refine (CategoryTheory.IsPullback.paste_vert_iff
          (CategoryTheory.IsPullback.of_hasPullback (π₁ ≫ g_X) s_P)
          (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm).mp ?_
        rw [CategoryTheory.Limits.pullback.lift_snd, hqP_g]
        exact CategoryTheory.IsPullback.of_hasPullback g₁ s_P
      have : AlgebraicGeometry.Surjective q_P_fib :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (P := @AlgebraicGeometry.Surjective) hPb_qP_fib hSurj_qP
      let q₂_P : CategoryTheory.Limits.pullback g₁ s_P ⟶
          CategoryTheory.Limits.pullback g_Y s_P :=
        q_P_fib ≫ π₂_P
      have hq₂P_fst : q₂_P ≫ CategoryTheory.Limits.pullback.fst g_Y s_P =
          CategoryTheory.Limits.pullback.fst g₁ s_P ≫ q₂ := by
        change (q_P_fib ≫ π₂_P) ≫ _ = _
        rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          CategoryTheory.Category.assoc]
      have hq₂P_snd : q₂_P ≫ CategoryTheory.Limits.pullback.snd g_Y s_P =
          CategoryTheory.Limits.pullback.snd g₁ s_P := by
        change (q_P_fib ≫ π₂_P) ≫ _ = _
        rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          CategoryTheory.Limits.pullback.lift_snd]
      have hF_sub : F_target ⊆ q₂_P.base ''
          {w : ↥(CategoryTheory.Limits.pullback g₁ s_P) |
            q₁.base ((CategoryTheory.Limits.pullback.fst g₁ s_P).base w) = x₀} := by
        intro y hy
        rw [← hπ₂P_im] at hy
        rcases hy with ⟨u, huE, rfl⟩
        obtain ⟨w, hw⟩ := q_P_fib.surjective u
        refine ⟨w, ?_, ?_⟩
        · change q₁.base ((CategoryTheory.Limits.pullback.fst g₁ s_P).base w) = x₀
          have h1 : q₁.base ((CategoryTheory.Limits.pullback.fst g₁ s_P).base w) =
              π₁.base ((CategoryTheory.Limits.pullback.fst g₁ s_P ≫ q_P).base w) := by
            rw [← hqP_π₁]; rfl
          have h2 : (CategoryTheory.Limits.pullback.fst g₁ s_P ≫ q_P).base w =
              (q_P_fib ≫ CategoryTheory.Limits.pullback.fst (π₁ ≫ g_X) s_P).base w := by
            rw [CategoryTheory.Limits.pullback.lift_fst]
          rw [h1, h2]
          change π₁.base ((CategoryTheory.Limits.pullback.fst (π₁ ≫ g_X) s_P).base (q_P_fib.base w)) = x₀
          have hwu : q_P_fib.base w = u := hw
          rw [hwu]
          exact hE_x₀ u huE
        · change π₂_P.base (q_P_fib.base w) = π₂_P.base u
          have hwu : q_P_fib.base w = u := hw
          rw [hwu]
      exact weil_blowup_tower_exceptional_tree_exclusion K m V hPkg hNorm hOpenη
        C_K C' p_K g' n σ_K τ' ι' hIntCK hSmCK hStabCK hMod'
        U_ab hU_ab hUK ι_Uab hPb_Uab
        X Y C₁ C₂ g_X g_Y g₁ g₂ f_X f_Y q₁ q₂ p₂ r
        τ_X τ_Y τ₁ τ₂ ι_X ι_Y ι₁ P hP_ne x₀
        ⟨hSS_X, hProp_fX, hfX_g, hιX_fX, hPb_X, hτX_comm, hDisj_X, _hSm_X, _hRel_X⟩
        ⟨hSS_Y, hProp_fY, hfY_g, hιY_fY, hPb_Y, hτY_comm, hDisj_Y, _hSm_Y, _hRel_Y⟩
        hSS₁ hSS₂ hNoeth_X hNoeth_Y hNoeth₁ hNoeth₂ hTow₁ hTow₂
        hProp_q₂ hq₂_gY hq₁_fX hι₁_q₂ hPb₁ hr_q₂ hr_g₁ hProp_r hSurj_r hConn_r
        (fun j => ⟨hτX_g j, hτY_g j, hτ₁_g₁ j, hτ₂_g₂ j⟩)
        (fun j => ⟨hCl_X j, hCl_Y j, hCl₁ j, hCl₂ j⟩)
        (fun j => ⟨hτ₁_q₁ j, hτ₁_q₂ j, hτ₂_r j⟩)
        hDisj₁ hDisj₂ hSm₁ hSm₂ hClosed_x₀ hx₀_P
        F_target q₂_P hq₂P_fst hq₂P_snd hF_comp hF_two hF_sub
  
  obtain ⟨α, hα⟩ := exists_dom V_ab.toScheme W_ab.toScheme
    (V_ab.ι ≫ g_bar_a) (W_ab.ι ≫ g_bar_b) f_Va f_Wb τ_Va τ_Wb ι_Va ι_Wb
    hNoeth_Va hNoeth_Wb hCl_Va hCl_Wb hStab_Va hStab_Wb
  obtain ⟨β, hβ⟩ := exists_dom W_ab.toScheme V_ab.toScheme
    (W_ab.ι ≫ g_bar_b) (V_ab.ι ≫ g_bar_a) f_Wb f_Va τ_Wb τ_Va ι_Wb ι_Va
    hNoeth_Wb hNoeth_Va hCl_Wb hCl_Va hStab_Wb hStab_Va
  have hExtVV := (hExt U_ab hU_ab ι_Uab hPb_Uab
    V_ab.toScheme V_ab.toScheme (V_ab.ι ≫ g_bar_a) (V_ab.ι ≫ g_bar_a)
    f_Va f_Va ι_Va ι_Va
    hStab_Va.1.1 hStab_Va.1.2.2.1 hStab_Va.2.2.1 hStab_Va.2.2.1
    hStab_Va.2.2.2.1 hStab_Va.2.2.2.1 hStab_Va.2.2.2.2.1 hStab_Va.2.2.2.2.1).1
  have hExtWW := (hExt U_ab hU_ab ι_Uab hPb_Uab
    W_ab.toScheme W_ab.toScheme (W_ab.ι ≫ g_bar_b) (W_ab.ι ≫ g_bar_b)
    f_Wb f_Wb ι_Wb ι_Wb
    hStab_Wb.1.1 hStab_Wb.1.2.2.1 hStab_Wb.2.2.1 hStab_Wb.2.2.1
    hStab_Wb.2.2.2.1 hStab_Wb.2.2.2.1 hStab_Wb.2.2.2.2.1 hStab_Wb.2.2.2.2.1).1
  have hExtVW := (hExt U_ab hU_ab ι_Uab hPb_Uab
    V_ab.toScheme W_ab.toScheme (V_ab.ι ≫ g_bar_a) (W_ab.ι ≫ g_bar_b)
    f_Va f_Wb ι_Va ι_Wb
    hStab_Va.1.1 hStab_Wb.1.2.2.1 hStab_Va.2.2.1 hStab_Wb.2.2.1
    hStab_Va.2.2.2.1 hStab_Wb.2.2.2.1 hStab_Va.2.2.2.2.1 hStab_Wb.2.2.2.2.1).1
  have hαβ : α ≫ β = 𝟙 V_ab.toScheme := by
    apply hExtVV (α ≫ β) (𝟙 V_ab.toScheme)
    · rw [CategoryTheory.Category.assoc, hβ, hα]
    · exact CategoryTheory.Category.id_comp f_Va
  have hβα : β ≫ α = 𝟙 W_ab.toScheme := by
    apply hExtWW (β ≫ α) (𝟙 W_ab.toScheme)
    · rw [CategoryTheory.Category.assoc, hα, hβ]
    · exact CategoryTheory.Category.id_comp f_Wb
  refine ⟨⟨α, β, hαβ, hβα⟩, ?_, ?_⟩
  · calc
      α ≫ W_ab.ι ≫ f_bar_b ≫ U_b.ι = α ≫ (f_Wb ≫ U_ab.ι) := by rw [← hf_Wb]
      _ = (α ≫ f_Wb) ≫ U_ab.ι := by rw [← CategoryTheory.Category.assoc]
      _ = f_Va ≫ U_ab.ι := by rw [hα]
      _ = V_ab.ι ≫ f_bar_a ≫ U_a.ι := hf_Va
  · intro ψ hψ
    have hψ_fWb : ψ ≫ f_Wb = f_Va := by
      apply (cancel_mono U_ab.ι).mp
      calc
        (ψ ≫ f_Wb) ≫ U_ab.ι = ψ ≫ (f_Wb ≫ U_ab.ι) := by rw [CategoryTheory.Category.assoc]
        _ = ψ ≫ W_ab.ι ≫ f_bar_b ≫ U_b.ι := by rw [hf_Wb]
        _ = V_ab.ι ≫ f_bar_a ≫ U_a.ι := hψ
        _ = f_Va ≫ U_ab.ι := hf_Va.symm
    exact hExtVW ψ α hψ_fWb hα

theorem weil_glue_local_strictlySemistable_models_data (K : Type u) [Field K]
    (m : ℕ) (V : ValuationSubring K) (hPkg : IsValuationRingAlgPackage m V)
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (n : ℕ) (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (hIntCK : AlgebraicGeometry.IsIntegral C_K)
    (hSmCK : AlgebraicGeometry.SmoothOfRelativeDimension 1 p_K)
    (hStabCK : IsGeometricStablePointedCurve p_K n σ_K)
    (C' : AlgebraicGeometry.Scheme.{u})
    (g' : C' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (τ' : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C'))
    (ι' : C_K ⟶ C')
    (hMod' : IsValuationPointedCurveModel V p_K n σ_K C' g' τ' ι')
    (r : ℕ) (U_cov : Fin r → C'.Opens)
    (hCov : (⋃ a : Fin r, (U_cov a : Set C')) = Set.univ)
    (hNonempty : ∀ a : Fin r, Nonempty ↥(U_cov a))
    (ι_Ucov : ∀ a : Fin r,
      AlgebraicGeometry.Scheme.Opens.toScheme
        ((TopologicalSpace.Opens.map ι'.base).obj (U_cov a)) ⟶ (U_cov a).toScheme)
    (hι_comm : ∀ a : Fin r,
      ι_Ucov a ≫ (U_cov a).ι =
        AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj (U_cov a)) ≫ ι')
    (hPb_Ucov : ∀ a : Fin r,
      CategoryTheory.IsPullback (ι_Ucov a)
        (AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj (U_cov a)) ≫ p_K)
        ((U_cov a).ι ≫ g')
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (C_bar : Fin r → AlgebraicGeometry.Scheme.{u})
    (g_bar : ∀ a : Fin r, C_bar a ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (f_bar : ∀ a : Fin r, C_bar a ⟶ (U_cov a).toScheme)
    (τ_bar : ∀ (a : Fin r) (j : Fin n),
      AlgebraicGeometry.Scheme.Opens.toScheme
        ((TopologicalSpace.Opens.map (τ' j).base).obj (U_cov a)) ⟶ C_bar a)
    (ι_bar : ∀ a : Fin r,
      AlgebraicGeometry.Scheme.Opens.toScheme
        ((TopologicalSpace.Opens.map ι'.base).obj (U_cov a)) ⟶ C_bar a)
    (hRelStab : ∀ a : Fin r,
      IsLocalRelativeStableMod V p_K g' n τ' ι' (U_cov a) (ι_Ucov a)
        (C_bar a) (g_bar a) (f_bar a) (τ_bar a) (ι_bar a))
    (hOverlap : ∀ a b : Fin r,
      let U_ab : C'.Opens := U_cov a ⊓ U_cov b
      let V_ab : (C_bar a).Opens :=
        (TopologicalSpace.Opens.map (f_bar a ≫ (U_cov a).ι).base).obj U_ab
      let W_ab : (C_bar b).Opens :=
        (TopologicalSpace.Opens.map (f_bar b ≫ (U_cov b).ι).base).obj U_ab
      ∃ (φ : V_ab.toScheme ≅ W_ab.toScheme),
        φ.hom ≫ W_ab.ι ≫ f_bar b ≫ (U_cov b).ι = V_ab.ι ≫ f_bar a ≫ (U_cov a).ι ∧
        ∀ (ψ : V_ab.toScheme ⟶ W_ab.toScheme),
          ψ ≫ W_ab.ι ≫ f_bar b ≫ (U_cov b).ι = V_ab.ι ≫ f_bar a ≫ (U_cov a).ι →
          ψ = φ.hom) :
    ∃ (C_semi : AlgebraicGeometry.Scheme.{u})
      (g_semi : C_semi ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
      (f_semi : C_semi ⟶ C')
      (τ_semi : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C_semi))
      (ι_semi : C_K ⟶ C_semi),
      IsStrictlySemistableCurveOverValuation V g_semi ∧
      AlgebraicGeometry.IsProper f_semi ∧
      f_semi ≫ g' = g_semi ∧
      AlgebraicGeometry.IsProper g_semi ∧
      AlgebraicGeometry.Surjective g_semi ∧
      (∀ j : Fin n, τ_semi j ≫ f_semi = τ' j) ∧
      (∀ j : Fin n, τ_semi j ≫ g_semi = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of ↥V))) ∧
      CategoryTheory.IsPullback ι_semi p_K g_semi
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)) ∧
      (∀ j : Fin n, σ_K j ≫ ι_semi =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype) ≫ τ_semi j) ∧
      (_root_.Pairwise fun i j : Fin n =>
        Disjoint (Set.range (τ_semi i).base) (Set.range (τ_semi j).base)) ∧
      (∀ (j : Fin n) (b : AlgebraicGeometry.Spec (CommRingCat.of ↥V)),
        ∃ V_sm : C_semi.Opens,
          (τ_semi j).base b ∈ V_sm ∧
          AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ g_semi)) :=
by
  let S_V : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of ↥V)
  let η_V : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ S_V :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)
  have hIntC' : AlgebraicGeometry.IsIntegral C' := hMod'.1
  have hProp_g' : AlgebraicGeometry.IsProper g' := hMod'.2.2.1
  have hτ'_g' : ∀ j : Fin n, τ' j ≫ g' = 𝟙 S_V := hMod'.2.2.2.2.2.2.1
  have hPb' : CategoryTheory.IsPullback ι' p_K g' η_V := hMod'.2.2.2.2.2.2.2.1
  have hσ_τ' : ∀ j : Fin n, σ_K j ≫ ι' = η_V ≫ τ' j := hMod'.2.2.2.2.2.2.2.2
  have hn3 : 3 ≤ n := hStabCK.1
  have hσ_pK : ∀ j : Fin n, σ_K j ≫ p_K = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of K)) :=
    hStabCK.2.2.2.2.2.1
  have hSS_bar : ∀ a : Fin r, IsStrictlySemistableCurveOverValuation V (g_bar a) :=
    fun a => (hRelStab a).1
  have hInt_bar : ∀ a : Fin r, AlgebraicGeometry.IsIntegral (C_bar a) :=
    fun a => (hSS_bar a).1
  have hSep_bar : ∀ a : Fin r, AlgebraicGeometry.IsSeparated (g_bar a) :=
    fun a => (hSS_bar a).2.2.1
  have hProp_bar : ∀ a : Fin r, AlgebraicGeometry.IsProper (f_bar a) :=
    fun a => (hRelStab a).2.1
  have hf_g_bar : ∀ a : Fin r, f_bar a ≫ (U_cov a).ι ≫ g' = g_bar a :=
    fun a => (hRelStab a).2.2.1
  have hι_bar : ∀ a : Fin r, ι_bar a ≫ f_bar a = ι_Ucov a :=
    fun a => (hRelStab a).2.2.2.1
  have hPb_bar : ∀ a : Fin r,
      CategoryTheory.IsPullback (ι_bar a)
        (AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj (U_cov a)) ≫ p_K)
        (g_bar a) η_V :=
    fun a => (hRelStab a).2.2.2.2.1
  have hτ_bar : ∀ (a : Fin r) (j : Fin n),
      let S_j : S_V.Opens := (TopologicalSpace.Opens.map (τ' j).base).obj (U_cov a)
      (τ_bar a j ≫ f_bar a) ≫ (U_cov a).ι = S_j.ι ≫ τ' j :=
    fun a => (hRelStab a).2.2.2.2.2.1
  have hDisj_bar : ∀ a : Fin r,
      _root_.Pairwise fun i j : Fin n =>
        Disjoint (Set.range (τ_bar a i).base) (Set.range (τ_bar a j).base) :=
    fun a => (hRelStab a).2.2.2.2.2.2.1
  have hSm_bar : ∀ (a : Fin r) (j : Fin n)
      (b : AlgebraicGeometry.Scheme.Opens.toScheme
        ((TopologicalSpace.Opens.map (τ' j).base).obj (U_cov a))),
      ∃ V_sm : (C_bar a).Opens,
        (τ_bar a j).base b ∈ V_sm ∧
        AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ g_bar a) :=
    fun a => (hRelStab a).2.2.2.2.2.2.2.1
  
  have hIrredC' : IrreducibleSpace ↥C' :=
    @AlgebraicGeometry.irreducibleSpace_of_isIntegral C' hIntC'
  have hr : 0 < r := by
    obtain ⟨x₀⟩ := hIrredC'.toNonempty
    have hx₀ : x₀ ∈ (⋃ a : Fin r, (U_cov a : Set C')) := by
      rw [hCov]; trivial
    obtain ⟨a₀, _⟩ := Set.mem_iUnion.mp hx₀
    exact a₀.pos
  have hOpenη : AlgebraicGeometry.IsOpenImmersion η_V := by
    have hFinSpec : Finite (PrimeSpectrum ↥V) := Set.finite_univ_iff.mp hPkg.1
    let _ : Fintype (PrimeSpectrum ↥V) := Fintype.ofFinite (PrimeSpectrum ↥V)
    have hx_ex : ∀ P : PrimeSpectrum ↥V, ∃ x : ↥V, x ≠ 0 ∧ (P.asIdeal ≠ ⊥ → x ∈ P.asIdeal) := by
      intro P
      by_cases hP : P.asIdeal = ⊥
      · exact ⟨1, one_ne_zero, fun h => False.elim (h hP)⟩
      · obtain ⟨x, hxP, hx0⟩ := (Submodule.ne_bot_iff P.asIdeal).mp hP
        exact ⟨x, hx0, fun _ => hxP⟩
    choose xP hxP_ne hxP_mem using hx_ex
    let s₀ : ↥V := ∏ P : PrimeSpectrum ↥V, xP P
    have hs₀_ne : s₀ ≠ 0 := Finset.prod_ne_zero_iff.mpr (fun P _ => hxP_ne P)
    have hs₀_mem : ∀ P : PrimeSpectrum ↥V, P.asIdeal ≠ ⊥ → s₀ ∈ P.asIdeal := by
      intro P hP
      obtain ⟨c, hc⟩ := Finset.dvd_prod_of_mem xP (Finset.mem_univ P)
      dsimp only [s₀]
      rw [hc]
      exact P.asIdeal.mul_mem_right c (hxP_mem P hP)
    let _ : Algebra ↥V K := V.subtype.toAlgebra
    have hLocV : @IsLocalization.Away ↥V _ s₀ K _ V.subtype.toAlgebra := by
      refine { map_units := ?_, surj := ?_, exists_of_eq := ?_ }
      · rintro ⟨_, k, rfl⟩
        refine IsUnit.mk0 _ ?_
        change V.subtype (s₀ ^ k) ≠ 0
        rw [map_ne_zero_iff V.subtype Subtype.val_injective]
        exact pow_ne_zero k hs₀_ne
      · intro z
        by_cases hz0 : z = 0
        · refine ⟨(0, ⟨1, 0, pow_zero s₀⟩), ?_⟩
          simp [hz0]
        · rcases ValuationSubring.mem_or_inv_mem V z with hz | hinv
          · refine ⟨(⟨z, hz⟩, ⟨1, 0, pow_zero s₀⟩), ?_⟩
            change z * V.subtype 1 = V.subtype ⟨z, hz⟩
            simp
          · let b : ↥V := ⟨z⁻¹, hinv⟩
            have hb_ne : b ≠ 0 := by
              intro hb0
              exact inv_ne_zero hz0 (congrArg Subtype.val hb0)
            have hs₀_rad : s₀ ∈ (Ideal.span ({b} : Set ↥V)).radical := by
              rw [Ideal.radical_eq_sInf]
              refine Ideal.mem_sInf.mpr ?_
              rintro I ⟨hIb, hIprime⟩
              have hIne : I ≠ ⊥ := by
                intro hI0
                apply hb_ne
                have hbI : b ∈ I := hIb (Ideal.subset_span (Set.mem_singleton b))
                rwa [hI0, Submodule.mem_bot] at hbI
              exact hs₀_mem ⟨I, hIprime⟩ hIne
            obtain ⟨k, hk⟩ := hs₀_rad
            obtain ⟨r₀, hr₀⟩ := Ideal.mem_span_singleton.mp hk
            refine ⟨(r₀, ⟨s₀ ^ k, k, rfl⟩), ?_⟩
            change z * V.subtype (s₀ ^ k) = V.subtype r₀
            have hr₀K : V.subtype (s₀ ^ k) = z⁻¹ * V.subtype r₀ := by
              simpa [b] using congrArg V.subtype hr₀
            rw [hr₀K, ← mul_assoc, mul_inv_cancel₀ hz0, one_mul]
      · intro a₁ a₂ ha
        exact ⟨⟨1, 0, pow_zero s₀⟩, by simpa using Subtype.val_injective ha⟩
    exact @AlgebraicGeometry.IsOpenImmersion.of_isLocalization ↥V K _ _ V.subtype.toAlgebra s₀ hLocV
  have hOpen_ι' : AlgebraicGeometry.IsOpenImmersion ι' :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb'.flip hOpenη
  have hOpen_ιbar : ∀ a : Fin r, AlgebraicGeometry.IsOpenImmersion (ι_bar a) :=
    fun a => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback (hPb_bar a).flip hOpenη
  
  have hDomUniq : ∀ (a : Fin r) {Y W : AlgebraicGeometry.Scheme.{u}}
      [AlgebraicGeometry.IsReduced Y] (δ : W ⟶ Y) [AlgebraicGeometry.IsDominant δ]
      (p_W : W ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
      (h₁ h₂ : Y ⟶ C_bar a),
      h₁ ≫ f_bar a ≫ (U_cov a).ι = h₂ ≫ f_bar a ≫ (U_cov a).ι →
      (δ ≫ h₁) ≫ g_bar a = p_W ≫ η_V →
      h₁ = h₂ := by
    intro a Y W _ δ _ p_W h₁ h₂ hC' hK₁
    have hg12 : h₁ ≫ g_bar a = h₂ ≫ g_bar a := by
      rw [← hf_g_bar a, ← Category.assoc h₁, ← Category.assoc h₂]
      exact congrArg (· ≫ g') hC'
    have hK₂ : (δ ≫ h₂) ≫ g_bar a = p_W ≫ η_V := by
      rw [Category.assoc, ← hg12, ← Category.assoc, hK₁]
    let U_Ka : C_K.Opens := (TopologicalSpace.Opens.map ι'.base).obj (U_cov a)
    let α₁ : W ⟶ U_Ka.toScheme := (hPb_bar a).lift (δ ≫ h₁) p_W hK₁
    let α₂ : W ⟶ U_Ka.toScheme := (hPb_bar a).lift (δ ≫ h₂) p_W hK₂
    have hα_eq : α₁ ≫ U_Ka.ι = α₂ ≫ U_Ka.ι := by
      refine hPb'.hom_ext ?_ ?_
      · have hcomm_a : U_Ka.ι ≫ ι' = ι_bar a ≫ f_bar a ≫ (U_cov a).ι := by
          rw [← Category.assoc, hι_bar a, hι_comm a]
        calc (α₁ ≫ U_Ka.ι) ≫ ι'
            = α₁ ≫ U_Ka.ι ≫ ι' := Category.assoc _ _ _
          _ = α₁ ≫ ι_bar a ≫ f_bar a ≫ (U_cov a).ι := by rw [hcomm_a]
          _ = (α₁ ≫ ι_bar a) ≫ f_bar a ≫ (U_cov a).ι := (Category.assoc _ _ _).symm
          _ = (δ ≫ h₁) ≫ f_bar a ≫ (U_cov a).ι := by rw [(hPb_bar a).lift_fst]
          _ = δ ≫ h₁ ≫ f_bar a ≫ (U_cov a).ι := Category.assoc _ _ _
          _ = δ ≫ h₂ ≫ f_bar a ≫ (U_cov a).ι := by rw [hC']
          _ = (δ ≫ h₂) ≫ f_bar a ≫ (U_cov a).ι := (Category.assoc _ _ _).symm
          _ = (α₂ ≫ ι_bar a) ≫ f_bar a ≫ (U_cov a).ι := by rw [(hPb_bar a).lift_fst]
          _ = α₂ ≫ ι_bar a ≫ f_bar a ≫ (U_cov a).ι := Category.assoc _ _ _
