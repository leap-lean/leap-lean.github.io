    let y₂ : ↥Y₀ := (hAffU α₂).fromSpec.base q₂'
    have hy₂_O₂ : y₂ ∈ (O₂ : Set ↥Y₀) := by
      change y₂ ∈ O₂
      refine TopologicalSpace.Opens.mem_iSup.mpr ⟨α₂, ?_⟩
      change q₂' ∈ (hAffU α₂).fromSpec ⁻¹ᵁ Y₀.basicOpen (1 - e₀ α₂)
      rw [(hAffU α₂).fromSpec_preimage_basicOpen]
