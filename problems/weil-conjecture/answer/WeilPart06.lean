        CategoryTheory.Limits.pullback.lift (s_Pj ≫ τ_Y j) (𝟙 _)
          (by rw [Category.assoc, (hτ_g j).1, hsPj_fac, Category.id_comp])
      let σ_1j : AlgebraicGeometry.Spec (CommRingCat.of P.ResidueField) ⟶ F₁ :=
        CategoryTheory.Limits.pullback.lift (s_Pj ≫ τ₁ j) (𝟙 _)
          (by rw [Category.assoc, (hτ_g j).2, hsPj_fac, Category.id_comp])
      have hσYj_pt : σ_Yj.base pt_P = q := by
        apply fst_Y.isEmbedding.injective
        change (σ_Yj ≫ fst_Y).base pt_P = fst_Y.base q
        rw [CategoryTheory.Limits.pullback.lift_fst]
        change (τ_Y j).base (s_Pj.base pt_P) = fst_Y.base q
        rw [hsPj_pt, hb_eq]
      have _ : AlgebraicGeometry.IsSeparated g_Y := hStab_Y.1.2.2.1
      have _ : AlgebraicGeometry.IsSeparated snd_Y :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (P := @AlgebraicGeometry.IsSeparated)
          (CategoryTheory.IsPullback.of_hasPullback g_Y s_P) inferInstance
      have hσYj_snd : σ_Yj ≫ snd_Y = 𝟙 _ := CategoryTheory.Limits.pullback.lift_snd _ _ _
      have _ : AlgebraicGeometry.IsProper (σ_Yj ≫ snd_Y) := by rw [hσYj_snd]; infer_instance
      have _ : AlgebraicGeometry.IsProper σ_Yj := AlgebraicGeometry.IsProper.of_comp σ_Yj snd_Y
      have hRange_σYj : Set.range σ_Yj.base = {q} := by
        ext y'
        simp only [Set.mem_range, Set.mem_singleton_iff]
        refine ⟨?_, fun hy' => ⟨pt_P, hy' ▸ hσYj_pt⟩⟩
        rintro ⟨x_pt, rfl⟩
        rw [Subsingleton.elim x_pt pt_P, hσYj_pt]
      have hCl_q : IsClosed ({q} : Set ↥F_Y) := by
        rw [← hRange_σYj, ← Set.image_univ]
        exact σ_Yj.isClosedMap Set.univ isClosed_univ
      have hσ_comm : σ_1j ≫ q₂_P = σ_Yj := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · rw [Category.assoc, hq₂P_fst, ← Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
            Category.assoc, hτ_q₂ j, CategoryTheory.Limits.pullback.lift_fst]
        · rw [Category.assoc, hq₂P_snd, CategoryTheory.Limits.pullback.lift_snd,
            CategoryTheory.Limits.pullback.lift_snd]
      let d : ↥F₁ := σ_1j.base pt_P
      have hd_D₁ : d ∈ D₁ := by
        refine ⟨j, s_Pj.base pt_P, ?_⟩
        change (τ₁ j).base (s_Pj.base pt_P) = (σ_1j ≫ fst₁).base pt_P
        rw [CategoryTheory.Limits.pullback.lift_fst]; rfl
      have hqd : q₂_P.base d = q := by
        change (σ_1j ≫ q₂_P).base pt_P = q
        rw [hσ_comm, hσYj_pt]
      exact ⟨hCl_q.preimage q₂_P.continuous, Or.inl ⟨d, hd_D₁, hqd⟩⟩
  
  intro s_P F₁ F_Y fst₁ fst_Y snd₁ snd_Y D₁ q₂_P hq₂P_fst hq₂P_snd
  obtain ⟨hSurj_q₂P, hConn_q₂P⟩ := hPillar1 q₂_P hq₂P_fst hq₂P_snd
  refine ⟨hSurj_q₂P, hConn_q₂P, ?_⟩
  intro E_set E_sch ιE x₀_U hE_comp hCl_E hInt_E hRange_E hP1_E hx₀_U hTwo_E
  have hPb_q₂P : CategoryTheory.IsPullback fst₁ q₂_P q₂ fst_Y := by
    refine (CategoryTheory.IsPullback.paste_vert_iff
      (CategoryTheory.IsPullback.of_hasPullback g_Y s_P) hq₂P_fst.symm).mp ?_
    rw [hq₂P_snd, hq₂_gY]
    exact CategoryTheory.IsPullback.of_hasPullback g₁ s_P
  have hProp_q₂P : AlgebraicGeometry.IsProper q₂_P :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (P := @AlgebraicGeometry.IsProper) hPb_q₂P hProp_q₂
  have _ : TopologicalSpace.NoetherianSpace ↥Y := hNoeth_Y
  have hFibY := hFibAll P hP Y g_Y hStab_Y.1 inferInstance
  let F_E : Set ↥F_Y := q₂_P.base '' E_set
  have hFE_closed : IsClosed F_E :=
    q₂_P.isClosedMap E_set (isClosed_of_mem_irreducibleComponents E_set hE_comp)
  have hFE_irred : IsIrreducible F_E :=
    hE_comp.1.image q₂_P.base q₂_P.continuous.continuousOn
  have hFE_comp : F_E ∈ irreducibleComponents ↥F_Y :=
    hFibY.2.2.2.2.2.2.2.2.2.1 F_E hFE_closed hFE_irred hTwo_E
  have hFinGen : ∀ y_Q : ↥Y, y_Q ⤳ fst_Y.base hFE_comp.1.genericPoint →
      (q₂.base ⁻¹' ({y_Q} : Set ↥Y)).Finite :=
    hPillar2 F_E hFE_comp.1 hFE_closed hTwo_E
  obtain ⟨V_iso, hy_gen_Viso, hIso_Viso⟩ :=
    hPillar3 (fst_Y.base hFE_comp.1.genericPoint) hFinGen
  let U₀_fib : F_Y.Opens := (TopologicalSpace.Opens.map fst_Y.base).obj V_iso
  have hη_U₀ : hFE_comp.1.genericPoint ∈ U₀_fib := hy_gen_Viso
  have hIso_U₀ : CategoryTheory.IsIso (q₂_P ∣_ U₀_fib) := by
    let V₁_fib : F₁.Opens := (TopologicalSpace.Opens.map q₂_P.base).obj U₀_fib
    let V₁_C : C₁.Opens := (TopologicalSpace.Opens.map q₂.base).obj V_iso
    let e_V := asIso (q₂ ∣_ V_iso)
    have hp1 : CategoryTheory.IsPullback (q₂_P ∣_ U₀_fib) V₁_fib.ι U₀_fib.ι q₂_P :=
      AlgebraicGeometry.isPullback_morphismRestrict q₂_P U₀_fib
    let u_top : U₀_fib.toScheme ⟶ C₁ := (fst_Y ∣_ V_iso) ≫ e_V.inv ≫ V₁_C.ι
    have hu_comm : u_top ≫ q₂ = U₀_fib.ι ≫ fst_Y := by
      calc
        u_top ≫ q₂ = (fst_Y ∣_ V_iso) ≫ e_V.inv ≫ (V₁_C.ι ≫ q₂) := by
              simp only [u_top, Category.assoc]
        _ = (fst_Y ∣_ V_iso) ≫ e_V.inv ≫ (e_V.hom ≫ V_iso.ι) := by
              rw [← AlgebraicGeometry.morphismRestrict_ι q₂ V_iso]; rfl
        _ = (fst_Y ∣_ V_iso) ≫ (e_V.inv ≫ e_V.hom) ≫ V_iso.ι := by simp only [Category.assoc]
        _ = U₀_fib.ι ≫ fst_Y := by
              rw [e_V.inv_hom_id, Category.id_comp, AlgebraicGeometry.morphismRestrict_ι]
    let u_F₁ : U₀_fib.toScheme ⟶ F₁ := hPb_q₂P.lift u_top U₀_fib.ι hu_comm
    have hu_fst : u_F₁ ≫ fst₁ = u_top := hPb_q₂P.lift_fst u_top U₀_fib.ι hu_comm
    have hu_q₂P : u_F₁ ≫ q₂_P = U₀_fib.ι := hPb_q₂P.lift_snd u_top U₀_fib.ι hu_comm
    let inv_fib : U₀_fib.toScheme ⟶ V₁_fib.toScheme :=
      hp1.lift (𝟙 U₀_fib.toScheme) u_F₁ (by rw [Category.id_comp, hu_q₂P])
    have hinv_hom : inv_fib ≫ (q₂_P ∣_ U₀_fib) = 𝟙 U₀_fib.toScheme :=
      hp1.lift_fst _ _ _
    have hinv_ι : inv_fib ≫ V₁_fib.ι = u_F₁ :=
      hp1.lift_snd _ _ _
    have hV1_le : V₁_fib ≤ (TopologicalSpace.Opens.map fst₁.base).obj V₁_C := by
      intro w hw
      change q₂.base (fst₁.base w) ∈ V_iso
      have h1 : (fst₁ ≫ q₂).base w = (q₂_P ≫ fst_Y).base w := by rw [hPb_q₂P.w]
      exact h1 ▸ hw
    refine ⟨⟨inv_fib, ?_, hinv_hom⟩⟩
    apply hp1.hom_ext
    · rw [Category.assoc, hinv_hom, Category.comp_id, Category.id_comp]
    · rw [Category.assoc, hinv_ι, Category.id_comp]
      apply hPb_q₂P.hom_ext
      · rw [Category.assoc, hu_fst]
        have h_into_V1C : (q₂_P ∣_ U₀_fib) ≫ (fst_Y ∣_ V_iso) ≫ e_V.inv =
            fst₁.resLE V₁_C V₁_fib hV1_le := by
          apply (cancel_mono (e_V.hom ≫ V_iso.ι)).mp
          calc
            ((q₂_P ∣_ U₀_fib) ≫ (fst_Y ∣_ V_iso) ≫ e_V.inv) ≫ (e_V.hom ≫ V_iso.ι)
                = (q₂_P ∣_ U₀_fib) ≫ (fst_Y ∣_ V_iso) ≫ (e_V.inv ≫ e_V.hom) ≫ V_iso.ι := by
                    simp only [Category.assoc]
            _ = (q₂_P ∣_ U₀_fib) ≫ ((fst_Y ∣_ V_iso) ≫ V_iso.ι) := by
                    rw [e_V.inv_hom_id, Category.id_comp]
            _ = ((q₂_P ∣_ U₀_fib) ≫ U₀_fib.ι) ≫ fst_Y := by
                    rw [AlgebraicGeometry.morphismRestrict_ι, ← Category.assoc]
            _ = V₁_fib.ι ≫ (q₂_P ≫ fst_Y) := by
                    rw [AlgebraicGeometry.morphismRestrict_ι, Category.assoc]
            _ = (V₁_fib.ι ≫ fst₁) ≫ q₂ := by rw [← hPb_q₂P.w, ← Category.assoc]
            _ = (fst₁.resLE V₁_C V₁_fib hV1_le ≫ V₁_C.ι) ≫ q₂ := by rw [fst₁.resLE_comp_ι hV1_le]
            _ = fst₁.resLE V₁_C V₁_fib hV1_le ≫ (e_V.hom ≫ V_iso.ι) := by
                    rw [Category.assoc, ← AlgebraicGeometry.morphismRestrict_ι q₂ V_iso]; rfl
        calc
          (q₂_P ∣_ U₀_fib) ≫ u_top
              = ((q₂_P ∣_ U₀_fib) ≫ (fst_Y ∣_ V_iso) ≫ e_V.inv) ≫ V₁_C.ι := by
                  simp only [u_top, Category.assoc]
          _ = fst₁.resLE V₁_C V₁_fib hV1_le ≫ V₁_C.ι := by rw [h_into_V1C]
          _ = V₁_fib.ι ≫ fst₁ := fst₁.resLE_comp_ι hV1_le
      · rw [Category.assoc, hu_q₂P, AlgebraicGeometry.morphismRestrict_ι]
  obtain ⟨hInjOn_E, hUniq_comp, hThreePts⟩ :=
    hPillar4 q₂_P hProp_q₂P hSurj_q₂P hq₂P_fst hq₂P_snd
      E_set E_sch ιE x₀_U hFE_comp U₀_fib hE_comp hCl_E hInt_E hRange_E hP1_E hx₀_U hη_U₀ hIso_U₀
  exact ⟨hFE_comp, hInjOn_E, hUniq_comp, hThreePts⟩

theorem weil_p1_tree_connected_fiber_forest_contradiction (α β : Type u) [TopologicalSpace α]
    (π : α → β)
    (H_fin : Set (Set α))
    (m : ℕ) (hm : 1 ≤ m)
    (E : Fin m → Set α)
    (D : Set α)
    (Γ_T : SimpleGraph (Fin m))
    (hH_fin : H_fin.Finite)
    (hInjE : Function.Injective E)
    (hE_mem : ∀ a : Fin m, E a ∈ H_fin)
    (hH_closed : ∀ H ∈ H_fin, IsClosed H)
    (hH_cov : (⋃ H ∈ H_fin, H) = Set.univ)
    (hPairSub : ∀ a b : Fin m, a ≠ b → (E a ∩ E b).Subsingleton)
    (hAdj : ∀ a b : Fin m, Γ_T.Adj a b ↔ a ≠ b ∧ (E a ∩ E b).Nonempty)
    (hTree : Γ_T.IsTree)
    (hBdryFin :
      let T : Set α := ⋃ a : Fin m, E a
      let R_ext : Set α := ⋃ H ∈ H_fin \ Set.range E, H
      ((T ∩ R_ext) ∪ (D ∩ T)).Finite)
    (hBdryCard :
      let T : Set α := ⋃ a : Fin m, E a
      let R_ext : Set α := ⋃ H ∈ H_fin \ Set.range E, H
      Nat.card ↥((T ∩ R_ext) ∪ (D ∩ T)) ≤ 2)
    (V_surv : Set (Fin m))
    (hV_nonempty : V_surv.Nonempty)
    (hV_iff : ∀ a : Fin m,
      a ∈ V_surv ↔ ∃ u₁ u₂ : β, u₁ ≠ u₂ ∧ u₁ ∈ π '' (E a) ∧ u₂ ∈ π '' (E a))
    (hInjOn : ∀ i ∈ V_surv, Set.InjOn π (E i))
    (hImgInj : ∀ i ∈ V_surv, ∀ j ∈ V_surv, π '' (E i) = π '' (E j) → i = j)
    (hStab : ∀ i ∈ V_surv,
      ∃ q₁ q₂ q₃ : β,
        q₁ ≠ q₂ ∧ q₁ ≠ q₃ ∧ q₂ ≠ q₃ ∧
        q₁ ∈ π '' (E i) ∧ q₂ ∈ π '' (E i) ∧ q₃ ∈ π '' (E i) ∧
        ∀ q ∈ ({q₁, q₂, q₃} : Set β),
          IsClosed (π ⁻¹' ({q} : Set β)) ∧
          _root_.IsConnected (π ⁻¹' ({q} : Set β)) ∧
          Nat.card {j : Fin m // j ∈ V_surv ∧ q ∈ π '' (E j)} ≤ 2 ∧
          ((∃ d ∈ D, π d = q) ∨
            (∃ H' ∈ H_fin,
              π '' H' ≠ π '' (E i) ∧
              (∃ u₁ u₂ : β, u₁ ≠ u₂ ∧ u₁ ∈ π '' H' ∧ u₂ ∈ π '' H') ∧
              q ∈ π '' H'))) :
    False :=
by
  classical
  let T : Set α := ⋃ a : Fin m, E a
  let R_ext : Set α := ⋃ H ∈ H_fin \ Set.range E, H
  let B_tot : Set α := (T ∩ R_ext) ∪ (D ∩ T)
  have hB_fin_set : B_tot.Finite := hBdryFin
  let B_fin : Finset α := hB_fin_set.toFinset
  have hB_mem : ∀ x : α, x ∈ B_fin ↔ x ∈ B_tot := fun x => hB_fin_set.mem_toFinset
  have hB_card : B_fin.card ≤ 2 := by
    let instB : Fintype ↥B_tot := Fintype.ofFinset B_fin hB_mem
    have heq1 : Nat.card ↥B_tot = @Fintype.card ↥B_tot instB :=
      @Nat.card_eq_fintype_card ↥B_tot instB
    have heq2 : @Fintype.card ↥B_tot instB = B_fin.card :=
      Fintype.card_ofFinset B_fin hB_mem
    have hle : Nat.card ↥B_tot ≤ 2 := hBdryCard
    omega
  have hE_closed : ∀ a : Fin m, IsClosed (E a) := fun a => hH_closed (E a) (hE_mem a)
  have hT_closed : IsClosed T := isClosed_iUnion_of_finite hE_closed
  have hR_closed : IsClosed R_ext :=
    (hH_fin.subset Set.sdiff_subset).isClosed_biUnion (fun H hH => hH_closed H hH.1)
  have hCov_TR : T ∪ R_ext = Set.univ := by
    ext x
    simp only [Set.mem_union, Set.mem_univ, iff_true]
    have hx : x ∈ ⋃ H ∈ H_fin, H := by rw [hH_cov]; trivial
    rcases Set.mem_iUnion₂.mp hx with ⟨H, hH_mem, hxH⟩
    by_cases hRange : H ∈ Set.range E
    · rcases hRange with ⟨a, rfl⟩
      exact Or.inl (Set.mem_iUnion.mpr ⟨a, hxH⟩)
    · exact Or.inr (Set.mem_biUnion ⟨hH_mem, hRange⟩ hxH)
  have hContr : ∀ a : Fin m, a ∉ V_surv → ∀ x ∈ E a, ∀ x' ∈ E a, π x = π x' := by
    intro a ha x hx x' hx'
    by_contra hne
    exact ha ((hV_iff a).mpr ⟨π x, π x', hne, ⟨x, hx, rfl⟩, ⟨x', hx', rfl⟩⟩)

  let V_fin : Finset (Fin m) := Finset.univ.filter (fun a => a ∈ V_surv)
  let k : ℕ := V_fin.card
  have hV_mem : ∀ a : Fin m, a ∈ V_fin ↔ a ∈ V_surv := by
    intro a
    simp [V_fin]
  have hV_fin_ne : V_fin.Nonempty := by
    obtain ⟨a₀, ha₀⟩ := hV_nonempty
    exact ⟨a₀, (hV_mem a₀).mpr ha₀⟩
  have hk_pos : 1 ≤ k := Finset.card_pos.mpr hV_fin_ne

  choose q₁ q₂ q₃ hq₁₂ hq₁₃ hq₂₃ hq₁_mem hq₂_mem hq₃_mem hq_props using hStab
  let Q : Fin m → Finset β := fun i =>
    if hi : i ∈ V_surv then {q₁ i hi, q₂ i hi, q₃ i hi} else ∅
  have hQ_card : ∀ i ∈ V_fin, (Q i).card = 3 := by
    intro i hiV
    have hi : i ∈ V_surv := (hV_mem i).mp hiV
    have h12 := hq₁₂ i hi
    have h13 := hq₁₃ i hi
    have h23 := hq₂₃ i hi
    simp [Q, hi, h12, h13, h23]
  have hQ_sub_img : ∀ i (hi : i ∈ V_surv) (y : β), y ∈ Q i → y ∈ π '' (E i) := by
    intro i hi y hy
    simp only [Q, hi, ↓reduceDIte, Finset.mem_insert, Finset.mem_singleton] at hy
    rcases hy with rfl | rfl | rfl
    · exact hq₁_mem i hi
    · exact hq₂_mem i hi
    · exact hq₃_mem i hi

  let Y_spec : Finset β := V_fin.biUnion Q
  let S_fin : β → Finset (Fin m) := fun y => V_fin.filter (fun j => y ∈ π '' (E j))

  have hDouble : 3 * k ≤ ∑ y ∈ Y_spec, (S_fin y).card := by
    have h1 : 3 * k = ∑ i ∈ V_fin, (Q i).card := by
      have hsum : ∑ i ∈ V_fin, (Q i).card = ∑ _i ∈ V_fin, 3 :=
        Finset.sum_congr rfl (fun i hi => hQ_card i hi)
      rw [hsum, Finset.sum_const, smul_eq_mul]
      change 3 * k = k * 3
      omega
    have h2 : ∀ i ∈ V_fin, (Q i).card = ∑ y ∈ Y_spec, (if y ∈ Q i then 1 else 0) := by
      intro i hi
      rw [Finset.sum_boole]
      simp only [Nat.cast_id]
      congr 1
      ext y
      simp only [Finset.mem_filter]
      exact ⟨fun hyQ => ⟨Finset.mem_biUnion.mpr ⟨i, hi, hyQ⟩, hyQ⟩, fun h => h.2⟩
    rw [h1, Finset.sum_congr rfl h2, Finset.sum_comm]
    apply Finset.sum_le_sum
    intro y _hy
    rw [Finset.sum_boole]
    simp only [Nat.cast_id]
    apply Finset.card_le_card
    intro i hi
    rw [Finset.mem_filter] at hi
    exact Finset.mem_filter.mpr ⟨hi.1, hQ_sub_img i ((hV_mem i).mp hi.1) y hi.2⟩

  have hY_props : ∀ y ∈ Y_spec,
      1 ≤ (S_fin y).card ∧
      (S_fin y).card ≤ 2 ∧
      IsClosed (π ⁻¹' ({y} : Set β)) ∧
      _root_.IsConnected (π ⁻¹' ({y} : Set β)) ∧
      ∃ i₀ ∈ V_surv, y ∈ π '' (E i₀) ∧
        ((∃ d ∈ D, π d = y) ∨
          (∃ H' ∈ H_fin,
            π '' H' ≠ π '' (E i₀) ∧
            (∃ u₁ u₂ : β, u₁ ≠ u₂ ∧ u₁ ∈ π '' H' ∧ u₂ ∈ π '' H') ∧
            y ∈ π '' H')) := by
    intro y hy
    obtain ⟨i₀, hi₀V, hyQ⟩ := Finset.mem_biUnion.mp hy
    have hi₀ : i₀ ∈ V_surv := (hV_mem i₀).mp hi₀V
    have hy_set : y ∈ ({q₁ i₀ hi₀, q₂ i₀ hi₀, q₃ i₀ hi₀} : Set β) := by
      simp only [Q, hi₀, ↓reduceDIte, Finset.mem_insert, Finset.mem_singleton] at hyQ
      simpa using hyQ
    obtain ⟨hCl_y, hConn_y, hCard_y, hSpec_y⟩ := hq_props i₀ hi₀ y hy_set
    have hy_img : y ∈ π '' (E i₀) := hQ_sub_img i₀ hi₀ y hyQ
    have hi₀_S : i₀ ∈ S_fin y := Finset.mem_filter.mpr ⟨hi₀V, hy_img⟩
    have hpos : 1 ≤ (S_fin y).card := Finset.card_pos.mpr ⟨i₀, hi₀_S⟩
    have hle2 : (S_fin y).card ≤ 2 := by
      let p_y : Set (Fin m) := {j : Fin m | j ∈ V_surv ∧ y ∈ π '' (E j)}
      have hp_mem : ∀ j : Fin m, j ∈ S_fin y ↔ j ∈ p_y := by
        intro j
        simp [S_fin, p_y, hV_mem]
      let instS : Fintype ↥p_y := Fintype.ofFinset (S_fin y) hp_mem
      have hc1 : Nat.card ↥p_y = @Fintype.card ↥p_y instS :=
        @Nat.card_eq_fintype_card ↥p_y instS
      have hc2 : @Fintype.card ↥p_y instS = (S_fin y).card :=
        Fintype.card_ofFinset (S_fin y) hp_mem
      have hCard_p : Nat.card ↥p_y ≤ 2 := hCard_y
      omega
    exact ⟨hpos, hle2, hCl_y, hConn_y, i₀, hi₀, hy_img, hSpec_y⟩

  let H_fib : β → SimpleGraph (Fin m) := fun y =>
    SimpleGraph.fromRel (fun a b : Fin m => (E a ∩ E b ∩ π ⁻¹' ({y} : Set β)).Nonempty)
  let P_reach : β → Prop := fun y =>
    ∃ i ∈ S_fin y, ∃ i' ∈ S_fin y, i ≠ i' ∧ (H_fib y).Reachable i i'
  let Y_one : Finset β := Y_spec.filter (fun y => (S_fin y).card = 1)
  let Y_two_all : Finset β := Y_spec.filter (fun y => ¬ (S_fin y).card = 1)
  let Y_int : Finset β := Y_two_all.filter P_reach
  let Y_two : Finset β := Y_two_all.filter (fun y => ¬ P_reach y)

  have hY_two_card_eq : ∀ y ∈ Y_two_all, (S_fin y).card = 2 := by
    intro y hy
    obtain ⟨hy_spec, hne1⟩ := Finset.mem_filter.mp hy
    have h1 := (hY_props y hy_spec).1
    have h2 := (hY_props y hy_spec).2.1
    omega

  have hSum_split : ∑ y ∈ Y_spec, (S_fin y).card =
      Y_one.card + 2 * (Y_int.card + Y_two.card) := by
    have hsplit := (Finset.sum_filter_add_sum_filter_not Y_spec
      (fun y => (S_fin y).card = 1) (fun y => (S_fin y).card)).symm
    have hs1 : ∑ y ∈ Y_one, (S_fin y).card = Y_one.card := by
      have hc : ∑ y ∈ Y_one, (S_fin y).card = ∑ _y ∈ Y_one, 1 :=
        Finset.sum_congr rfl (fun y hy => (Finset.mem_filter.mp hy).2)
      rw [hc, Finset.sum_const, smul_eq_mul, Nat.mul_one]
    have hs2 : ∑ y ∈ Y_two_all, (S_fin y).card = 2 * Y_two_all.card := by
      have hc : ∑ y ∈ Y_two_all, (S_fin y).card = ∑ _y ∈ Y_two_all, 2 :=
        Finset.sum_congr rfl (fun y hy => hY_two_card_eq y hy)
      rw [hc, Finset.sum_const, smul_eq_mul]
      omega
    have hcard2 : Y_int.card + Y_two.card = Y_two_all.card :=
      Finset.card_filter_add_card_filter_not (s := Y_two_all) P_reach
    rw [hsplit]
    change ∑ y ∈ Y_one, (S_fin y).card + ∑ y ∈ Y_two_all, (S_fin y).card = _
    rw [hs1, hs2, ← hcard2]

  have hHfib_le : ∀ y : β, H_fib y ≤ Γ_T := by
    intro y a b hadj
    rcases (SimpleGraph.fromRel_adj _ a b).mp hadj with ⟨hab, ⟨w, hw, _⟩ | ⟨w, hw, _⟩⟩
    · exact (hAdj a b).mpr ⟨hab, ⟨w, hw.1, hw.2⟩⟩
    · exact (hAdj a b).mpr ⟨hab, ⟨w, hw.2, hw.1⟩⟩

  have hHfib_disj : ∀ y₁ y₂ : β, y₁ ≠ y₂ →
      ∀ a b : Fin m, ¬ ((H_fib y₁).Adj a b ∧ (H_fib y₂).Adj a b) := by
    intro y₁ y₂ hy_ne a b ⟨h1, h2⟩
    rcases (SimpleGraph.fromRel_adj _ a b).mp h1 with ⟨hab, ⟨w₁, hw₁ab, hw₁y⟩ | ⟨w₁, hw₁ba, hw₁y⟩⟩
    · have hw₁ : w₁ ∈ E a ∩ E b := hw₁ab
      rcases (SimpleGraph.fromRel_adj _ a b).mp h2 with ⟨_, ⟨w₂, hw₂ab, hw₂y⟩ | ⟨w₂, hw₂ba, hw₂y⟩⟩
      · have hw_eq : w₁ = w₂ := hPairSub a b hab hw₁ hw₂ab
        have hy₁ : π w₁ = y₁ := hw₁y
        have hy₂ : π w₂ = y₂ := hw₂y
        rw [hw_eq, hy₂] at hy₁
        exact hy_ne hy₁.symm
      · have hw_eq : w₁ = w₂ := hPairSub a b hab hw₁ ⟨hw₂ba.2, hw₂ba.1⟩
        have hy₁ : π w₁ = y₁ := hw₁y
        have hy₂ : π w₂ = y₂ := hw₂y
        rw [hw_eq, hy₂] at hy₁
        exact hy_ne hy₁.symm
    · have hw₁ : w₁ ∈ E a ∩ E b := ⟨hw₁ba.2, hw₁ba.1⟩
      rcases (SimpleGraph.fromRel_adj _ a b).mp h2 with ⟨_, ⟨w₂, hw₂ab, hw₂y⟩ | ⟨w₂, hw₂ba, hw₂y⟩⟩
      · have hw_eq : w₁ = w₂ := hPairSub a b hab hw₁ hw₂ab
        have hy₁ : π w₁ = y₁ := hw₁y
        have hy₂ : π w₂ = y₂ := hw₂y
        rw [hw_eq, hy₂] at hy₁
        exact hy_ne hy₁.symm
      · have hw_eq : w₁ = w₂ := hPairSub a b hab hw₁ ⟨hw₂ba.2, hw₂ba.1⟩
        have hy₁ : π w₁ = y₁ := hw₁y
        have hy₂ : π w₂ = y₂ := hw₂y
        rw [hw_eq, hy₂] at hy₁
        exact hy_ne hy₁.symm

  have hInt_witness : ∀ y : β,
      ∃ u v : Fin m, y ∈ Y_int →
        u ∈ V_fin ∧ v ∈ V_fin ∧ u ≠ v ∧ (H_fib y).Reachable u v := by
    intro y
    by_cases hy : y ∈ Y_int
    · obtain ⟨u, huS, v, hvS, hne_uv, hR_uv⟩ := (Finset.mem_filter.mp hy).2
      exact ⟨u, v, fun _ =>
        ⟨(Finset.mem_filter.mp huS).1, (Finset.mem_filter.mp hvS).1, hne_uv, hR_uv⟩⟩
    · exact ⟨⟨0, by omega⟩, ⟨0, by omega⟩, fun h => False.elim (hy h)⟩
  choose u_fn v_fn huv_spec using hInt_witness

  let G_sub : Finset β → SimpleGraph ↥V_fin := fun J =>
    SimpleGraph.fromRel (fun x x' : ↥V_fin => ∃ y ∈ J, x.1 = u_fn y ∧ x'.1 = v_fn y)

  have hInv : ∀ J : Finset β, J ⊆ Y_int →
      J.card + Fintype.card (G_sub J).ConnectedComponent ≤ k := by
    intro J
    induction J using Finset.induction_on with
    | empty =>
      intro _
      let f₀ : ↥V_fin → (G_sub ∅).ConnectedComponent := (G_sub ∅).connectedComponentMk
      have hBij₀ : Function.Bijective f₀ := by
        refine ⟨?_, ?_⟩
        · intro x x' hEq
          have hR := SimpleGraph.ConnectedComponent.exact hEq
          obtain ⟨w⟩ := hR
          induction w with
          | nil => rfl
          | cons hadj _ _ =>
            rcases (SimpleGraph.fromRel_adj _ _ _).mp hadj with ⟨_, ⟨y, hy, _⟩ | ⟨y, hy, _⟩⟩ <;>
              simp at hy
        · intro c
          induction c using SimpleGraph.ConnectedComponent.ind with
          | h x => exact ⟨x, rfl⟩
      have hCard₀ : Fintype.card ↥V_fin = Fintype.card (G_sub ∅).ConnectedComponent :=
        Fintype.card_of_bijective hBij₀
      have hCoe : Fintype.card ↥V_fin = k := Fintype.card_coe V_fin
      simp only [Finset.card_empty]
      omega
    | @insert y₀ J hy₀ ih =>
      intro hJ_ins
      have hy₀_int : y₀ ∈ Y_int := hJ_ins (Finset.mem_insert_self y₀ J)
      have hJ_sub : J ⊆ Y_int :=
        fun y hy => hJ_ins (Finset.mem_insert_of_mem hy)
      have h_ih := ih hJ_sub
      obtain ⟨hu₀, hv₀, hne₀, hReach₀⟩ := huv_spec y₀ hy₀_int
      let x₀ : ↥V_fin := ⟨u_fn y₀, hu₀⟩
      let x'₀ : ↥V_fin := ⟨v_fn y₀, hv₀⟩
      have hx_ne : x₀ ≠ x'₀ := fun h => hne₀ (congrArg Subtype.val h)

      let Γ_J : SimpleGraph (Fin m) :=
        SimpleGraph.fromRel (fun a b : Fin m => ∃ y ∈ J, (H_fib y).Adj a b)
      have hΓJ_adj : ∀ a b : Fin m, Γ_J.Adj a b ↔ ∃ y ∈ J, (H_fib y).Adj a b := by
        intro a b
        rw [SimpleGraph.fromRel_adj]
        constructor
        · rintro ⟨_, ⟨y, hyJ, hadj⟩ | ⟨y, hyJ, hadj⟩⟩
          · exact ⟨y, hyJ, hadj⟩
          · exact ⟨y, hyJ, hadj.symm⟩
        · rintro ⟨y, hyJ, hadj⟩
          exact ⟨(H_fib y).ne_of_adj hadj, Or.inl ⟨y, hyJ, hadj⟩⟩
      have hΓJ_le : Γ_J ≤ Γ_T := by
        intro a b hadj
        obtain ⟨y, _, hy_adj⟩ := (hΓJ_adj a b).mp hadj
        exact hHfib_le y hy_adj
      have hLift : ∀ x x' : ↥V_fin, (G_sub J).Reachable x x' → Γ_J.Reachable x.1 x'.1 := by
        intro x x' hR
        obtain ⟨w⟩ := hR
        induction w with
        | nil => exact SimpleGraph.Reachable.refl _
        | @cons a b c hadj _ ih_w =>
          have hstep : Γ_J.Reachable a.1 b.1 := by
            rcases (SimpleGraph.fromRel_adj _ a b).mp hadj with
              ⟨_, ⟨y, hyJ, ha_eq, hb_eq⟩ | ⟨y, hyJ, hb_eq, ha_eq⟩⟩
            · obtain ⟨_, _, _, hRy⟩ := huv_spec y (hJ_sub hyJ)
              have hHy_le : H_fib y ≤ Γ_J := fun p q hpq => (hΓJ_adj p q).mpr ⟨y, hyJ, hpq⟩
              rw [ha_eq, hb_eq]
              exact hRy.mono hHy_le
            · obtain ⟨_, _, _, hRy⟩ := huv_spec y (hJ_sub hyJ)
              have hHy_le : H_fib y ≤ Γ_J := fun p q hpq => (hΓJ_adj p q).mpr ⟨y, hyJ, hpq⟩
              rw [ha_eq, hb_eq]
              exact (hRy.mono hHy_le).symm
          exact hstep.trans ih_w

      have hFirstEdge : ∀ {u v : Fin m} (hne : u ≠ v)
          (p₁ : Γ_J.Walk u v) (p₂ : (H_fib y₀).Walk u v),
          p₁.mapLe hΓJ_le = p₂.mapLe (hHfib_le y₀) →
          ∃ w : Fin m, Γ_J.Adj u w ∧ (H_fib y₀).Adj u w := by
        intro u v hne p₁ p₂ hw_eq
        cases p₁ with
        | nil => exact absurd rfl hne
        | @cons _ w₁ _ hadj₁ q₁_walk =>
          cases p₂ with
          | nil => exact absurd rfl hne
          | @cons _ w₂ _ hadj₂ q₂_walk =>
            have hw₁₂ : w₁ = w₂ := by
              have h := congrArg (fun w => w.getVert 1) hw_eq
              simpa [SimpleGraph.Walk.mapLe] using h
            subst hw₁₂
            exact ⟨w₁, hadj₁, hadj₂⟩

      have hNotReach : ¬ (G_sub J).Reachable x₀ x'₀ := by
        intro hR_J
        have hR_ΓJ : Γ_J.Reachable (u_fn y₀) (v_fn y₀) := hLift x₀ x'₀ hR_J
        obtain ⟨p₁, hp₁⟩ := hR_ΓJ.exists_isPath
        obtain ⟨p₂, hp₂⟩ := hReach₀.exists_isPath
        let P₁ : Γ_T.Path (u_fn y₀) (v_fn y₀) := ⟨p₁.mapLe hΓJ_le, hp₁.mapLe hΓJ_le⟩
        let P₂ : Γ_T.Path (u_fn y₀) (v_fn y₀) := ⟨p₂.mapLe (hHfib_le y₀), hp₂.mapLe (hHfib_le y₀)⟩
        have hP_eq : P₁ = P₂ :=
          (SimpleGraph.isAcyclic_iff_subsingleton_path.mp hTree.isAcyclic (u_fn y₀) (v_fn y₀)).elim
            P₁ P₂
        have hw_eq : p₁.mapLe hΓJ_le = p₂.mapLe (hHfib_le y₀) := congrArg Subtype.val hP_eq
        obtain ⟨w₁, hadj₁, hadj₂⟩ := hFirstEdge hne₀ p₁ p₂ hw_eq
        obtain ⟨y₁, hy₁J, hadj_y₁⟩ := (hΓJ_adj (u_fn y₀) w₁).mp hadj₁
        have hy₁_ne : y₁ ≠ y₀ := fun hEq => hy₀ (hEq ▸ hy₁J)
        exact hHfib_disj y₁ y₀ hy₁_ne (u_fn y₀) w₁ ⟨hadj_y₁, hadj₂⟩

      have hG_le : G_sub J ≤ G_sub (insert y₀ J) := by
        intro a b hadj
        rcases (SimpleGraph.fromRel_adj _ a b).mp hadj with ⟨hab, ⟨y, hyJ, hxy⟩ | ⟨y, hyJ, hxy⟩⟩
        · exact (SimpleGraph.fromRel_adj _ a b).mpr
            ⟨hab, Or.inl ⟨y, Finset.mem_insert_of_mem hyJ, hxy⟩⟩
        · exact (SimpleGraph.fromRel_adj _ a b).mpr
            ⟨hab, Or.inr ⟨y, Finset.mem_insert_of_mem hyJ, hxy⟩⟩
      let f_cc := SimpleGraph.ConnectedComponent.map (SimpleGraph.Hom.ofLE hG_le)
      have hSurj : Function.Surjective f_cc := by
        intro c
        induction c using SimpleGraph.ConnectedComponent.ind with
        | h x =>
          refine ⟨(G_sub J).connectedComponentMk x, ?_⟩
          exact SimpleGraph.ConnectedComponent.map_mk (SimpleGraph.Hom.ofLE hG_le) x
      have hNotInj : ¬ Function.Injective f_cc := by
        intro hInj
        have hadj_ins : (G_sub (insert y₀ J)).Adj x₀ x'₀ :=
          (SimpleGraph.fromRel_adj _ x₀ x'₀).mpr
            ⟨hx_ne, Or.inl ⟨y₀, Finset.mem_insert_self y₀ J, rfl, rfl⟩⟩
        have hEq_ins : f_cc ((G_sub J).connectedComponentMk x₀) =
            f_cc ((G_sub J).connectedComponentMk x'₀) := by
          simp only [f_cc, SimpleGraph.ConnectedComponent.map_mk, SimpleGraph.Hom.ofLE_apply]
          exact SimpleGraph.ConnectedComponent.sound hadj_ins.reachable
        exact hNotReach (SimpleGraph.ConnectedComponent.exact (hInj hEq_ins))
      have hCard_lt : Fintype.card (G_sub (insert y₀ J)).ConnectedComponent <
          Fintype.card (G_sub J).ConnectedComponent :=
        Fintype.card_lt_of_surjective_not_injective f_cc hSurj hNotInj
      rw [Finset.card_insert_of_notMem hy₀]
      omega

  have hInt_le : Y_int.card + 1 ≤ k := by
    have hInv_top := hInv Y_int (fun _ h => h)
    obtain ⟨a₀, ha₀⟩ := hV_fin_ne
    have : Nonempty (G_sub Y_int).ConnectedComponent :=
      ⟨(G_sub Y_int).connectedComponentMk ⟨a₀, ha₀⟩⟩
    have hPos_cc : 0 < Fintype.card (G_sub Y_int).ConnectedComponent := Fintype.card_pos
    omega

  let F_bdry : β → Finset α := fun y => B_fin.filter (fun b => π b = y)

  have hTwo_bdry : ∀ y ∈ Y_two, 2 ≤ (F_bdry y).card := by
    intro y hy_two
    obtain ⟨hy_two_all, hNotP⟩ := Finset.mem_filter.mp hy_two
    have hy_spec : y ∈ Y_spec := (Finset.mem_filter.mp hy_two_all).1
    have hCard_S : (S_fin y).card = 2 := hY_two_card_eq y hy_two_all
    obtain ⟨_, _, hKy_closed, hKy_conn, _⟩ := hY_props y hy_spec
    obtain ⟨i, i', hne_ii', hS_eq⟩ := Finset.card_eq_two.mp hCard_S
    have hi_S : i ∈ S_fin y := by rw [hS_eq]; simp
    have hi'_S : i' ∈ S_fin y := by rw [hS_eq]; simp
    have hi_V : i ∈ V_surv := (hV_mem i).mp (Finset.mem_filter.mp hi_S).1
    have hi'_V : i' ∈ V_surv := (hV_mem i').mp (Finset.mem_filter.mp hi'_S).1
    have hy_i : y ∈ π '' (E i) := (Finset.mem_filter.mp hi_S).2
    have hy_i' : y ∈ π '' (E i') := (Finset.mem_filter.mp hi'_S).2
    have hNotReach_ii' : ¬ (H_fib y).Reachable i i' :=
      fun hR => hNotP ⟨i, hi_S, i', hi'_S, hne_ii', hR⟩

    let K_y : Set α := π ⁻¹' ({y} : Set β)
    let A_y : Set α := K_y ∩ T
    let B_y : Set α := K_y ∩ R_ext
    have hBy_closed : IsClosed B_y := hKy_closed.inter hR_closed

    obtain ⟨z, hz_Ei, hz_π⟩ := hy_i
    obtain ⟨z', hz'_Ei', hz'_π⟩ := hy_i'
    have hz_Ky : z ∈ K_y := hz_π
    have hz'_Ky : z' ∈ K_y := hz'_π
    have hEi_Ky : E i ∩ K_y = ({z} : Set α) := by
      ext w
      simp only [Set.mem_inter_iff, Set.mem_singleton_iff]
      constructor
      · rintro ⟨hwE, hwK⟩
        have hwπ : π w = π z := by
          have h1 : π w = y := hwK
          rw [h1, hz_π]
        exact hInjOn i hi_V hwE hz_Ei hwπ
      · rintro rfl
        exact ⟨hz_Ei, hz_Ky⟩
    have hEi'_Ky : E i' ∩ K_y = ({z'} : Set α) := by
      ext w
      simp only [Set.mem_inter_iff, Set.mem_singleton_iff]
      constructor
      · rintro ⟨hwE, hwK⟩
        have hwπ : π w = π z' := by
          have h1 : π w = y := hwK
          rw [h1, hz'_π]
        exact hInjOn i' hi'_V hwE hz'_Ei' hwπ
      · rintro rfl
        exact ⟨hz'_Ei', hz'_Ky⟩
    have hz_closed : IsClosed ({z} : Set α) := by
      rw [← hEi_Ky]
      exact (hE_closed i).inter hKy_closed
    have hz'_closed : IsClosed ({z'} : Set α) := by
      rw [← hEi'_Ky]
      exact (hE_closed i').inter hKy_closed

    let C_y : Set (Fin m) := {a : Fin m | a ∉ V_surv ∧ (E a ∩ K_y).Nonempty}
    have hCy_sub_Ky : ∀ a ∈ C_y, E a ⊆ K_y := by
      intro a ⟨ha_notV, w₀, hw₀E, hw₀K⟩ w hwE
      have hπ_eq := hContr a ha_notV w hwE w₀ hw₀E
      change π w = y
      have hw₀π : π w₀ = y := hw₀K
      rw [hπ_eq, hw₀π]

    have hAy_decomp : A_y = ({z, z'} : Set α) ∪ ⋃ (a : Fin m) (_ : a ∈ C_y), E a := by
      ext w
      simp only [A_y, T, Set.mem_inter_iff, Set.mem_union, Set.mem_insert_iff,
        Set.mem_singleton_iff, Set.mem_iUnion]
      constructor
      · rintro ⟨hwK, a, hwE⟩
        by_cases haV : a ∈ V_surv
        · have ha_S : a ∈ S_fin y := by
            refine Finset.mem_filter.mpr ⟨(hV_mem a).mpr haV, ⟨w, hwE, hwK⟩⟩
          rw [hS_eq] at ha_S
          simp only [Finset.mem_insert, Finset.mem_singleton] at ha_S
          rcases ha_S with rfl | rfl
          · have hmem : w ∈ E a ∩ K_y := ⟨hwE, hwK⟩
            rw [hEi_Ky] at hmem
            exact Or.inl (Or.inl hmem)
          · have hmem : w ∈ E a ∩ K_y := ⟨hwE, hwK⟩
            rw [hEi'_Ky] at hmem
            exact Or.inl (Or.inr hmem)
        · exact Or.inr ⟨a, ⟨haV, ⟨w, hwE, hwK⟩⟩, hwE⟩
      · rintro ((rfl | rfl) | ⟨a, haC, hwE⟩)
        · exact ⟨hz_Ky, i, hz_Ei⟩
        · exact ⟨hz'_Ky, i', hz'_Ei'⟩
        · exact ⟨hCy_sub_Ky a haC hwE, a, hwE⟩

    have hSep : ∃ A₁ A₂ : Set α,
        IsClosed A₁ ∧ IsClosed A₂ ∧ A_y = A₁ ∪ A₂ ∧ Disjoint A₁ A₂ ∧ z ∈ A₁ ∧ z' ∈ A₂ := by
      by_contra hNotSep
      have hzz'_ne : z ≠ z' := by
        intro hEq
        subst hEq
        have hadj : (H_fib y).Adj i i' :=
          (SimpleGraph.fromRel_adj _ i i').mpr ⟨hne_ii', Or.inl ⟨z, ⟨hz_Ei, hz'_Ei'⟩, hz_Ky⟩⟩
        exact hNotReach_ii' hadj.reachable
      have h_ex_a1 : ∃ a₁ ∈ C_y, z ∈ E a₁ := by
        by_contra hNo_a1
        have hNo : ∀ a ∈ C_y, z ∉ E a := fun a ha hzE => hNo_a1 ⟨a, ha, hzE⟩
        let A₁ : Set α := {z}
        let A₂ : Set α := ({z'} : Set α) ∪ ⋃ (a : Fin m) (_ : a ∈ C_y), E a
        have hCl₁ : IsClosed A₁ := hz_closed
        have hCl₂ : IsClosed A₂ :=
          hz'_closed.union (isClosed_iUnion_of_finite (fun a =>
            isClosed_iUnion_of_finite (fun _ => hE_closed a)))
        have hUnion : A_y = A₁ ∪ A₂ := by
          rw [hAy_decomp]
          ext w
          simp only [A₁, A₂, Set.mem_union, Set.mem_insert_iff, Set.mem_singleton_iff]
          tauto
        have hDisj12 : Disjoint A₁ A₂ := by
          rw [Set.disjoint_left]
          intro w hw1 hw2
          have hwz : w = z := hw1
          rcases hw2 with h_eq_z' | h_in_U
          · have hwz' : w = z' := h_eq_z'
            exact hzz'_ne (hwz.symm.trans hwz')
          · rcases Set.mem_iUnion₂.mp h_in_U with ⟨a, haC, hwEa⟩
            rw [hwz] at hwEa
            exact hNo a haC hwEa
        exact hNotSep ⟨A₁, A₂, hCl₁, hCl₂, hUnion, hDisj12, rfl, Or.inl rfl⟩

      obtain ⟨a₁, ha₁C, hz_Ea₁⟩ := h_ex_a1
      have hi_ne_a₁ : i ≠ a₁ := fun h => ha₁C.1 (h ▸ hi_V)
      have hadj_i_a₁ : (H_fib y).Adj i a₁ :=
        (SimpleGraph.fromRel_adj _ i a₁).mpr ⟨hi_ne_a₁, Or.inl ⟨z, ⟨hz_Ei, hz_Ea₁⟩, hz_Ky⟩⟩

      let H_C : SimpleGraph (Fin m) :=
        SimpleGraph.fromRel (fun a b : Fin m => a ∈ C_y ∧ b ∈ C_y ∧ (E a ∩ E b).Nonempty)
      have hHC_le : H_C ≤ H_fib y := by
        intro a b hadj
        rcases (SimpleGraph.fromRel_adj _ a b).mp hadj with
          ⟨hab, ⟨haC, _, w, hwab⟩ | ⟨hbC, _, w, hwba⟩⟩
        · exact (SimpleGraph.fromRel_adj _ a b).mpr
            ⟨hab, Or.inl ⟨w, hwab, hCy_sub_Ky a haC hwab.1⟩⟩
        · exact (SimpleGraph.fromRel_adj _ a b).mpr
            ⟨hab, Or.inr ⟨w, hwba, hCy_sub_Ky b hbC hwba.1⟩⟩

      let R₁ : Set (Fin m) := {a : Fin m | a ∈ C_y ∧ H_C.Reachable a₁ a}
      have ha₁_R₁ : a₁ ∈ R₁ := ⟨ha₁C, SimpleGraph.Reachable.refl a₁⟩
      let A₁ : Set α := ⋃ (a : Fin m) (_ : a ∈ R₁), E a
      let A₂ : Set α := ({z'} : Set α) ∪ ⋃ (b : Fin m) (_ : b ∈ C_y ∧ b ∉ R₁), E b
      have hCl₁ : IsClosed A₁ :=
        isClosed_iUnion_of_finite (fun a => isClosed_iUnion_of_finite (fun _ => hE_closed a))
      have hCl₂ : IsClosed A₂ :=
        hz'_closed.union (isClosed_iUnion_of_finite (fun b =>
          isClosed_iUnion_of_finite (fun _ => hE_closed b)))
      have hz_A₁ : z ∈ A₁ := Set.mem_iUnion₂.mpr ⟨a₁, ha₁_R₁, hz_Ea₁⟩
      have hz'_A₂ : z' ∈ A₂ := Or.inl rfl
      have hUnion : A_y = A₁ ∪ A₂ := by
        rw [hAy_decomp]
        ext w
        simp only [A₁, A₂, Set.mem_union, Set.mem_insert_iff, Set.mem_singleton_iff,
          Set.mem_iUnion]
        constructor
        · rintro ((rfl | rfl) | ⟨a, haC, hwE⟩)
          · exact Or.inl ⟨a₁, ha₁_R₁, hz_Ea₁⟩
          · exact Or.inr (Or.inl rfl)
          · by_cases haR : a ∈ R₁
            · exact Or.inl ⟨a, haR, hwE⟩
            · exact Or.inr (Or.inr ⟨a, ⟨haC, haR⟩, hwE⟩)
        · rintro (⟨a, haR, hwE⟩ | (rfl | ⟨b, ⟨hbC, _⟩, hwE⟩))
          · exact Or.inr ⟨a, haR.1, hwE⟩
          · exact Or.inl (Or.inr rfl)
          · exact Or.inr ⟨b, hbC, hwE⟩

      have hNotDisj : ¬ Disjoint A₁ A₂ :=
        fun hDisj => hNotSep ⟨A₁, A₂, hCl₁, hCl₂, hUnion, hDisj, hz_A₁, hz'_A₂⟩
      obtain ⟨w, hwA₁, hwA₂⟩ := Set.not_disjoint_iff.mp hNotDisj
      obtain ⟨a_star, ha_starR, hw_Eastar⟩ := Set.mem_iUnion₂.mp hwA₁
      rcases hwA₂ with h_eq_z' | h_in_rem
      · have hz'_Eastar : z' ∈ E a_star := by
          have hwz' : w = z' := h_eq_z'
          rwa [← hwz']
        have hastar_ne_i' : a_star ≠ i' := fun h => ha_starR.1.1 (h ▸ hi'_V)
        have hadj_astar_i' : (H_fib y).Adj a_star i' :=
          (SimpleGraph.fromRel_adj _ a_star i').mpr
            ⟨hastar_ne_i', Or.inl ⟨z', ⟨hz'_Eastar, hz'_Ei'⟩, hz'_Ky⟩⟩
        have hR_mid : (H_fib y).Reachable a₁ a_star := ha_starR.2.mono hHC_le
        exact hNotReach_ii' (hadj_i_a₁.reachable.trans (hR_mid.trans hadj_astar_i'.reachable))
      · obtain ⟨b, ⟨hbC, hbNotR⟩, hw_Eb⟩ := Set.mem_iUnion₂.mp h_in_rem
        have hab_ne : a_star ≠ b := fun h => hbNotR (h ▸ ha_starR)
        have hadj_C : H_C.Adj a_star b :=
          (SimpleGraph.fromRel_adj _ a_star b).mpr
            ⟨hab_ne, Or.inl ⟨ha_starR.1, hbC, ⟨w, hw_Eastar, hw_Eb⟩⟩⟩
        exact hbNotR ⟨hbC, ha_starR.2.trans hadj_C.reachable⟩

    obtain ⟨A₁, A₂, hCl₁, hCl₂, hAy_eq, hDisj12, hz_A₁, hz'_A₂⟩ := hSep
    have hA₁_sub_Ay : A₁ ⊆ A_y := by rw [hAy_eq]; exact Set.subset_union_left
    have hA₂_sub_Ay : A₂ ⊆ A_y := by rw [hAy_eq]; exact Set.subset_union_right
    have hKy_cov : K_y = A_y ∪ B_y := by
      ext w
      simp only [A_y, B_y, Set.mem_inter_iff, Set.mem_union]
      constructor
      · intro hwK
        rcases (Set.eq_univ_iff_forall.mp hCov_TR w) with hwT | hwR
        · exact Or.inl ⟨hwK, hwT⟩
        · exact Or.inr ⟨hwK, hwR⟩
      · rintro (⟨hwK, _⟩ | ⟨hwK, _⟩) <;> exact hwK

    have hSub₁ : K_y ⊆ A₁ ∪ (A₂ ∪ B_y) := by
      rw [hKy_cov, hAy_eq, Set.union_assoc]
    have hSub₂ : K_y ⊆ A₂ ∪ (A₁ ∪ B_y) := by
      intro w hw
      rw [hKy_cov, hAy_eq] at hw
      rcases hw with (hw1 | hw2) | hwb
      · exact Or.inr (Or.inl hw1)
      · exact Or.inl hw2
      · exact Or.inr (Or.inr hwb)

    obtain ⟨b₁, hb₁K, hb₁A₁, hb₁_or⟩ :=
      isPreconnected_closed_iff.mp hKy_conn.isPreconnected A₁ (A₂ ∪ B_y)
        hCl₁ (hCl₂.union hBy_closed) hSub₁
        ⟨z, hz_Ky, hz_A₁⟩ ⟨z', hz'_Ky, Or.inl hz'_A₂⟩
    have hb₁_By : b₁ ∈ B_y := by
      rcases hb₁_or with hb₁A₂ | hb₁B
      · exact False.elim (Set.disjoint_left.mp hDisj12 hb₁A₁ hb₁A₂)
      · exact hb₁B
    obtain ⟨b₂, hb₂K, hb₂A₂, hb₂_or⟩ :=
      isPreconnected_closed_iff.mp hKy_conn.isPreconnected A₂ (A₁ ∪ B_y)
        hCl₂ (hCl₁.union hBy_closed) hSub₂
        ⟨z', hz'_Ky, hz'_A₂⟩ ⟨z, hz_Ky, Or.inl hz_A₁⟩
    have hb₂_By : b₂ ∈ B_y := by
      rcases hb₂_or with hb₂A₁ | hb₂B
      · exact False.elim (Set.disjoint_left.mp hDisj12 hb₂A₁ hb₂A₂)
      · exact hb₂B

    have hb₁_ne_b₂ : b₁ ≠ b₂ :=
      fun hEq => Set.disjoint_left.mp hDisj12 hb₁A₁ (hEq ▸ hb₂A₂)
    have hb₁_F : b₁ ∈ F_bdry y := by
      refine Finset.mem_filter.mpr ⟨?_, hb₁K⟩
      exact (hB_mem b₁).mpr (Or.inl ⟨(hA₁_sub_Ay hb₁A₁).2, hb₁_By.2⟩)
    have hb₂_F : b₂ ∈ F_bdry y := by
      refine Finset.mem_filter.mpr ⟨?_, hb₂K⟩
      exact (hB_mem b₂).mpr (Or.inl ⟨(hA₂_sub_Ay hb₂A₂).2, hb₂_By.2⟩)
    have hPair_sub : ({b₁, b₂} : Finset α) ⊆ F_bdry y := by
      intro x hx
      simp only [Finset.mem_insert, Finset.mem_singleton] at hx
      rcases hx with rfl | rfl
      · exact hb₁_F
      · exact hb₂_F
    have hPair_card : ({b₁, b₂} : Finset α).card = 2 := Finset.card_pair hb₁_ne_b₂
    have hle_card := Finset.card_le_card hPair_sub
    omega

  have hOne_bdry : ∀ y ∈ Y_one, 1 ≤ (F_bdry y).card := by
    intro y hy_one
    obtain ⟨hy_spec, hCard_S⟩ := Finset.mem_filter.mp hy_one
    obtain ⟨_, _, hKy_closed, hKy_conn, i₀, hi₀_V, hy_i₀, hSpec_y⟩ := hY_props y hy_spec
    have hi₀_S : i₀ ∈ S_fin y := Finset.mem_filter.mpr ⟨(hV_mem i₀).mpr hi₀_V, hy_i₀⟩
    have hUnique : ∀ j ∈ V_surv, y ∈ π '' (E j) → j = i₀ := by
      intro j hjV hy_j
      have hj_S : j ∈ S_fin y := Finset.mem_filter.mpr ⟨(hV_mem j).mpr hjV, hy_j⟩
      exact Finset.card_le_one.mp hCard_S.le j hj_S i₀ hi₀_S

    let K_y : Set α := π ⁻¹' ({y} : Set β)
    let A_y : Set α := K_y ∩ T
    let B_y : Set α := K_y ∩ R_ext
    have hAy_closed : IsClosed A_y := hKy_closed.inter hT_closed
    have hBy_closed : IsClosed B_y := hKy_closed.inter hR_closed
    have hKy_sub : K_y ⊆ A_y ∪ B_y := by
      intro w hwK
      rcases (Set.eq_univ_iff_forall.mp hCov_TR w) with hwT | hwR
      · exact Or.inl ⟨hwK, hwT⟩
      · exact Or.inr ⟨hwK, hwR⟩
    obtain ⟨z₀, hz₀E, hz₀π⟩ := hy_i₀
    have hz₀_Ay : z₀ ∈ K_y ∩ A_y := ⟨hz₀π, hz₀π, Set.mem_iUnion.mpr ⟨i₀, hz₀E⟩⟩

    have hFrom_By : B_y.Nonempty → 1 ≤ (F_bdry y).card := by
      rintro ⟨w₀, hw₀B⟩
      obtain ⟨b, hbK, hbA, hbB⟩ :=
        isPreconnected_closed_iff.mp hKy_conn.isPreconnected A_y B_y
          hAy_closed hBy_closed hKy_sub ⟨z₀, hz₀_Ay⟩ ⟨w₀, hw₀B.1, hw₀B⟩
      refine Finset.card_pos.mpr ⟨b, Finset.mem_filter.mpr ⟨?_, hbK⟩⟩
      exact (hB_mem b).mpr (Or.inl ⟨hbA.2, hbB.2⟩)

    rcases hSpec_y with ⟨d, hdD, hπd⟩ | ⟨H', hH'_mem, hImg_ne, hTwo_H', hy_H'⟩
    · rcases (Set.eq_univ_iff_forall.mp hCov_TR d) with hdT | hdR
      · refine Finset.card_pos.mpr ⟨d, Finset.mem_filter.mpr ⟨?_, hπd⟩⟩
        exact (hB_mem d).mpr (Or.inr ⟨hdD, hdT⟩)
      · exact hFrom_By ⟨d, hπd, hdR⟩
    · have hNotRange : H' ∉ Set.range E := by
        rintro ⟨a, ha_eq⟩
        subst ha_eq
        have ha_V : a ∈ V_surv := (hV_iff a).mpr hTwo_H'
        have ha_eq_i₀ : a = i₀ := hUnique a ha_V hy_H'
        subst ha_eq_i₀
        exact hImg_ne rfl
      obtain ⟨w, hwH', hwπ⟩ := hy_H'
      exact hFrom_By ⟨w, hwπ, Set.mem_biUnion ⟨hH'_mem, hNotRange⟩ hwH'⟩

  have hDisj_12 : Disjoint Y_one Y_two := by
    rw [Finset.disjoint_left]
    intro y hy1 hy2
    have h1 : (S_fin y).card = 1 := (Finset.mem_filter.mp hy1).2
    have h2 : ¬ (S_fin y).card = 1 := (Finset.mem_filter.mp (Finset.mem_filter.mp hy2).1).2
    exact h2 h1

  have hPairDisj_bdry : (↑(Y_one ∪ Y_two) : Set β).PairwiseDisjoint F_bdry := by
    intro y₁ _ y₂ _ hy_ne
    rw [Function.onFun, Finset.disjoint_left]
    intro b hb₁ hb₂
    have hπ₁ : π b = y₁ := (Finset.mem_filter.mp hb₁).2
    have hπ₂ : π b = y₂ := (Finset.mem_filter.mp hb₂).2
    exact hy_ne (hπ₁.symm.trans hπ₂)

  have hBdry_sum : Y_one.card + 2 * Y_two.card ≤ 2 := by
    have h1 : Y_one.card ≤ ∑ y ∈ Y_one, (F_bdry y).card := by
      have hc : Y_one.card = ∑ _y ∈ Y_one, 1 := by
        rw [Finset.sum_const, smul_eq_mul, Nat.mul_one]
      rw [hc]
      exact Finset.sum_le_sum (fun y hy => hOne_bdry y hy)
    have h2 : 2 * Y_two.card ≤ ∑ y ∈ Y_two, (F_bdry y).card := by
      have hc : 2 * Y_two.card = ∑ _y ∈ Y_two, 2 := by
        rw [Finset.sum_const, smul_eq_mul]
        omega
      rw [hc]
      exact Finset.sum_le_sum (fun y hy => hTwo_bdry y hy)
    have h3 : ∑ y ∈ Y_one, (F_bdry y).card + ∑ y ∈ Y_two, (F_bdry y).card =
        ((Y_one ∪ Y_two).biUnion F_bdry).card := by
      rw [← Finset.sum_union hDisj_12, ← Finset.card_biUnion hPairDisj_bdry]
    have h4 : ((Y_one ∪ Y_two).biUnion F_bdry).card ≤ B_fin.card := by
      apply Finset.card_le_card
      intro b hb
      obtain ⟨y, _, hbF⟩ := Finset.mem_biUnion.mp hb
      exact (Finset.mem_filter.mp hbF).1
    omega

  omega

theorem weil_blowup_tower_exceptional_tree_exclusion (K : Type u) [Field K] [IsSepClosed K]
    (m : ℕ) (V : ValuationSubring K) (hPkg : IsValuationRingAlgPackage m V)
    (hNorm : ∀ (W : AlgebraicGeometry.Scheme.{u})
        (g_W : W ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V)),
      IsStrictlySemistableCurveOverValuation V g_W →
      IsOverlapAffineNormalScheme W)
    (hOpenη : AlgebraicGeometry.IsOpenImmersion
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (C_K C' : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (g' : C' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (n : ℕ) (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (τ' : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C'))
    (ι' : C_K ⟶ C')
    (hIntCK : AlgebraicGeometry.IsIntegral C_K)
    (hSmCK : AlgebraicGeometry.SmoothOfRelativeDimension 1 p_K)
    (hStabCK : IsGeometricStablePointedCurve p_K n σ_K)
    (hMod' : IsValuationPointedCurveModel V p_K n σ_K C' g' τ' ι')
    (U_0 : C'.Opens) (hU_0 : Nonempty ↥U_0)
    (hUK : Nonempty ↥((TopologicalSpace.Opens.map ι'.base).obj U_0))
    (ι_U0 : AlgebraicGeometry.Scheme.Opens.toScheme
      ((TopologicalSpace.Opens.map ι'.base).obj U_0) ⟶ U_0.toScheme)
    (hPb_U0 : CategoryTheory.IsPullback ι_U0
      (AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj U_0) ≫ p_K)
      (U_0.ι ≫ g')
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (X Y C₁ C₂ : AlgebraicGeometry.Scheme.{u})
    (g_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (g_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (g₁ : C₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (g₂ : C₂ ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (f_X : X ⟶ U_0.toScheme)
    (f_Y : Y ⟶ U_0.toScheme)
    (q₁ : C₁ ⟶ X)
    (q₂ : C₁ ⟶ Y)
    (p₂ : C₂ ⟶ Y)
    (r : C₂ ⟶ C₁)
    (τ_X : ∀ j : Fin n,
      AlgebraicGeometry.Scheme.Opens.toScheme
        ((TopologicalSpace.Opens.map (τ' j).base).obj U_0) ⟶ X)
    (τ_Y : ∀ j : Fin n,
      AlgebraicGeometry.Scheme.Opens.toScheme
        ((TopologicalSpace.Opens.map (τ' j).base).obj U_0) ⟶ Y)
    (τ₁ : ∀ j : Fin n,
      AlgebraicGeometry.Scheme.Opens.toScheme
        ((TopologicalSpace.Opens.map (τ' j).base).obj U_0) ⟶ C₁)
    (τ₂ : ∀ j : Fin n,
      AlgebraicGeometry.Scheme.Opens.toScheme
        ((TopologicalSpace.Opens.map (τ' j).base).obj U_0) ⟶ C₂)
    (ι_X : AlgebraicGeometry.Scheme.Opens.toScheme
      ((TopologicalSpace.Opens.map ι'.base).obj U_0) ⟶ X)
    (ι_Y : AlgebraicGeometry.Scheme.Opens.toScheme
      ((TopologicalSpace.Opens.map ι'.base).obj U_0) ⟶ Y)
    (ι₁ : AlgebraicGeometry.Scheme.Opens.toScheme
      ((TopologicalSpace.Opens.map ι'.base).obj U_0) ⟶ C₁)
    (P : Ideal ↥V) [P.IsPrime] (hP : P ≠ ⊥) (x₀ : X)
    (hStab_X : IsLocalRelativeStableMod V p_K g' n τ' ι' U_0 ι_U0 X g_X f_X τ_X ι_X)
    (hStab_Y : IsLocalRelativeStableMod V p_K g' n τ' ι' U_0 ι_U0 Y g_Y f_Y τ_Y ι_Y)
    (hSS₁ : IsStrictlySemistableCurveOverValuation V g₁)
    (hSS₂ : IsStrictlySemistableCurveOverValuation V g₂)
    (hNoeth_X : TopologicalSpace.NoetherianSpace ↥X)
    (hNoeth_Y : TopologicalSpace.NoetherianSpace ↥Y)
    (hNoeth₁ : TopologicalSpace.NoetherianSpace ↥C₁)
    (hNoeth₂ : TopologicalSpace.NoetherianSpace ↥C₂)
    (hTow₁ : IsElementaryBlowupTower V g_X g₁ q₁)
    (hTow₂ : IsElementaryBlowupTower V g_Y g₂ p₂)
    (hProp_q₂ : AlgebraicGeometry.IsProper q₂)
    (hq₂_gY : q₂ ≫ g_Y = g₁)
    (hq₁_fX : q₁ ≫ f_X = q₂ ≫ f_Y)
    (hι₁_q₂ : ι₁ ≫ q₂ = ι_Y)
    (hPb₁ : CategoryTheory.IsPullback ι₁
      (AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj U_0) ≫ p_K)
      g₁
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (hr_q₂ : r ≫ q₂ = p₂)
    (hr_g₁ : r ≫ g₁ = g₂)
    (hProp_r : AlgebraicGeometry.IsProper r)
    (hSurj_r : AlgebraicGeometry.Surjective r)
    (hConn_r : ∀ z : C₁, _root_.IsConnected (r.base ⁻¹' ({z} : Set C₁)))
    (hτ_g : ∀ j : Fin n,
      let S_j : (AlgebraicGeometry.Spec (CommRingCat.of ↥V)).Opens :=
        (TopologicalSpace.Opens.map (τ' j).base).obj U_0
      τ_X j ≫ g_X = S_j.ι ∧ τ_Y j ≫ g_Y = S_j.ι ∧
        τ₁ j ≫ g₁ = S_j.ι ∧ τ₂ j ≫ g₂ = S_j.ι)
    (hCl_τ : ∀ j : Fin n,
      AlgebraicGeometry.IsClosedImmersion (τ_X j) ∧
      AlgebraicGeometry.IsClosedImmersion (τ_Y j) ∧
      AlgebraicGeometry.IsClosedImmersion (τ₁ j) ∧
      AlgebraicGeometry.IsClosedImmersion (τ₂ j))
    (hτ_comm : ∀ j : Fin n,
      τ₁ j ≫ q₁ = τ_X j ∧ τ₁ j ≫ q₂ = τ_Y j ∧ τ₂ j ≫ r = τ₁ j)
    (hDisj₁ : _root_.Pairwise fun i j : Fin n =>
      Disjoint (Set.range (τ₁ i).base) (Set.range (τ₁ j).base))
    (hDisj₂ : _root_.Pairwise fun i j : Fin n =>
      Disjoint (Set.range (τ₂ i).base) (Set.range (τ₂ j).base))
    (hSm₁ : ∀ (j : Fin n)
        (b : AlgebraicGeometry.Scheme.Opens.toScheme
          ((TopologicalSpace.Opens.map (τ' j).base).obj U_0)),
      ∃ V_sm : C₁.Opens,
        (τ₁ j).base b ∈ V_sm ∧
        AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ g₁))
    (hSm₂ : ∀ (j : Fin n)
        (b : AlgebraicGeometry.Scheme.Opens.toScheme
          ((TopologicalSpace.Opens.map (τ' j).base).obj U_0)),
      ∃ V_sm : C₂.Opens,
        (τ₂ j).base b ∈ V_sm ∧
        AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ g₂))
    (hClosed_x₀ : IsClosed ({x₀} : Set X))
    (hx₀_P : (g_X.base x₀).asIdeal = P) :
    let s_P := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V P.ResidueField))
    ∀ (F_target : Set ↥(CategoryTheory.Limits.pullback g_Y s_P))
      (q₂_P : CategoryTheory.Limits.pullback g₁ s_P ⟶ CategoryTheory.Limits.pullback g_Y s_P),
      q₂_P ≫ CategoryTheory.Limits.pullback.fst g_Y s_P =
        CategoryTheory.Limits.pullback.fst g₁ s_P ≫ q₂ →
      q₂_P ≫ CategoryTheory.Limits.pullback.snd g_Y s_P =
        CategoryTheory.Limits.pullback.snd g₁ s_P →
      F_target ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_Y s_P) →
      (∃ y₁ y₂, y₁ ≠ y₂ ∧ y₁ ∈ F_target ∧ y₂ ∈ F_target) →
      F_target ⊆ q₂_P.base ''
        {w : ↥(CategoryTheory.Limits.pullback g₁ s_P) |
          q₁.base ((CategoryTheory.Limits.pullback.fst g₁ s_P).base w) = x₀} →
      False :=
by
  intro s_P F_target q₂_P hq₂P_fst hq₂P_snd hF_comp hF_two hF_sub
  have hFibAll := weil_strictlySemistable_residueFiber_geometry K m V hPkg
  have hFibP : HasStrictlySemistableResidueFiberGeom V P := hFibAll P hP
  have hAlgP : IsAlgClosed P.ResidueField := hPkg.2.2.2.2.1 P hP
  let S : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V)).Opens :=
    fun j => (TopologicalSpace.Opens.map (τ' j).base).obj U_0
  rcases weil_blowup_tower_fiber_p1_tree_invariant K V P hP hAlgP hFibP n S
      X C₁ g_X g₁ q₁ τ_X τ₁ x₀
      hStab_X.1 hNoeth_X hTow₁
      (fun j => (hτ_g j).1) (fun j => (hτ_g j).2.2.1) (fun j => (hτ_comm j).1)
      hStab_X.2.2.2.2.2.2.1 hDisj₁ hStab_X.2.2.2.2.2.2.2.1
      hClosed_x₀ hx₀_P with
    hSub | ⟨m_T, hm_T, E, E_sch, ιE, Γ_T, hT_eq, hInjE, hE_props, hPairSub, hAdj, hTree,
      hBdryFin, hBdryCard⟩
  · obtain ⟨y₁, y₂, hne, hy₁, hy₂⟩ := hF_two
    obtain ⟨w₁, hw₁, rfl⟩ := hF_sub hy₁
    obtain ⟨w₂, hw₂, rfl⟩ := hF_sub hy₂
    exact hne (congrArg q₂_P.base (hSub hw₁ hw₂))
  · obtain ⟨_hSurj_q₂P, hConn_q₂P, hSurv⟩ :=
      weil_birational_roof_surviving_p1_stabilization_and_fibers K m V hPkg hNorm hOpenη
        P hP hFibAll C_K C' p_K g' n τ' ι' U_0 hUK ι_U0
        Y C₁ C₂ g_Y g₁ g₂ f_Y q₂ p₂ r τ_Y τ₁ ι_Y ι₁
        hStab_Y hSS₁ hSS₂ hNoeth_Y hNoeth₁ hNoeth₂ hTow₂
        hProp_q₂ hq₂_gY hι₁_q₂ hPb₁ hr_q₂ hr_g₁ hSurj_r
        (fun j => ⟨(hτ_g j).2.1, (hτ_g j).2.2.1⟩)
        (fun j => (hτ_comm j).2.1)
        q₂_P hq₂P_fst hq₂P_snd
    let F₁ := CategoryTheory.Limits.pullback g₁ s_P
    let F_Y := CategoryTheory.Limits.pullback g_Y s_P
    let fst₁ := CategoryTheory.Limits.pullback.fst g₁ s_P
    let fst_Y := CategoryTheory.Limits.pullback.fst g_Y s_P
    let D₁ : Set ↥F₁ := {w : ↥F₁ | ∃ j : Fin n, fst₁.base w ∈ Set.range (τ₁ j).base}
    let V_surv : Set (Fin m_T) :=
      {a : Fin m_T | ∃ u₁ u₂ : ↥F_Y,
        u₁ ≠ u₂ ∧ u₁ ∈ q₂_P.base '' (E a) ∧ u₂ ∈ q₂_P.base '' (E a)}
    have : TopologicalSpace.NoetherianSpace ↥C₁ := hNoeth₁
    have : TopologicalSpace.NoetherianSpace ↥Y := hNoeth_Y
    have hFibC₁ := hFibP C₁ g₁ hSS₁ inferInstance
    have hFibY := hFibP Y g_Y hStab_Y.1 inferInstance
    have hPb_q₂P : CategoryTheory.IsPullback fst₁ q₂_P q₂ fst_Y := by
      refine (CategoryTheory.IsPullback.paste_vert_iff
        (CategoryTheory.IsPullback.of_hasPullback g_Y s_P) hq₂P_fst.symm).mp ?_
      rw [hq₂P_snd, hq₂_gY]
      exact CategoryTheory.IsPullback.of_hasPullback g₁ s_P
    have : AlgebraicGeometry.IsProper q₂_P :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (P := @AlgebraicGeometry.IsProper) hPb_q₂P hProp_q₂
    have hImClosed : ∀ a : Fin m_T, IsClosed (q₂_P.base '' (E a)) :=
      fun a => q₂_P.isClosedMap (E a) (isClosed_of_mem_irreducibleComponents (E a) (hE_props a).1)
    have hF_irred : IsIrreducible F_target := hF_comp.1
    have hFinSub : ∀ (S_fin : Finset (Fin m_T)),
        F_target ⊆ (⋃ a ∈ S_fin, q₂_P.base '' (E a)) →
        ∃ a ∈ S_fin, F_target ⊆ q₂_P.base '' (E a) := by
      intro S_fin
      induction S_fin using Finset.cons_induction with
      | empty =>
        intro hsub
        obtain ⟨y₀, hy₀⟩ := hF_irred.1
        have hmem := hsub hy₀
        simp at hmem
      | cons a s ha ih =>
        intro hsub
        have hsub' : F_target ⊆ q₂_P.base '' (E a) ∪ ⋃ b ∈ s, q₂_P.base '' (E b) := by
          intro y hy
          have hm := hsub hy
          simpa [Finset.mem_cons] using hm
        have hClRest : IsClosed (⋃ b ∈ s, q₂_P.base '' (E b)) :=
          s.finite_toSet.isClosed_biUnion (fun b _ => hImClosed b)
        rcases isPreirreducible_iff_isClosed_union_isClosed.mp hF_irred.2
            (q₂_P.base '' (E a)) (⋃ b ∈ s, q₂_P.base '' (E b))
            (hImClosed a) hClRest hsub' with h1 | h2
        · exact ⟨a, Finset.mem_cons_self a s, h1⟩
        · obtain ⟨b, hb, hFb⟩ := ih h2
          exact ⟨b, Finset.mem_cons_of_mem hb, hFb⟩
    have hF_cov : F_target ⊆ ⋃ a ∈ (Finset.univ : Finset (Fin m_T)), q₂_P.base '' (E a) := by
      intro y hy
      obtain ⟨w, hwT, rfl⟩ := hF_sub hy
      have hwU : w ∈ ⋃ a : Fin m_T, E a := by
        rw [← hT_eq]
        exact hwT
      obtain ⟨a, hwa⟩ := Set.mem_iUnion.mp hwU
      exact Set.mem_biUnion (Finset.mem_univ a) ⟨w, hwa, rfl⟩
    obtain ⟨a₀, _ha₀_mem, hF_sub_a₀⟩ := hFinSub Finset.univ hF_cov
    have hV_nonempty : V_surv.Nonempty := by
      obtain ⟨y₁, y₂, hne, hy₁, hy₂⟩ := hF_two
      exact ⟨a₀, y₁, y₂, hne, hF_sub_a₀ hy₁, hF_sub_a₀ hy₂⟩
    have hx₀_U : ∀ (a : Fin m_T), ∀ w ∈ E a,
        f_Y.base (fst_Y.base (q₂_P.base w)) = f_X.base x₀ := by
      intro a w hw
      have hwT : w ∈ {w : ↥F₁ | q₁.base (fst₁.base w) = x₀} := by
        rw [hT_eq]
        exact Set.mem_iUnion.mpr ⟨a, hw⟩
      have hqw : q₁.base (fst₁.base w) = x₀ := hwT
      have h1 : f_Y.base (fst_Y.base (q₂_P.base w)) =
          ((q₂_P ≫ fst_Y) ≫ f_Y).base w := rfl
      rw [h1, hq₂P_fst, CategoryTheory.Category.assoc, ← hq₁_fX]
      change f_X.base (q₁.base (fst₁.base w)) = f_X.base x₀
      rw [hqw]
    have hSurv_i : ∀ i ∈ V_surv,
        q₂_P.base '' (E i) ∈ irreducibleComponents ↥F_Y ∧
        Set.InjOn q₂_P.base (E i) ∧
        (∀ E₂ ∈ irreducibleComponents ↥F₁,
          q₂_P.base '' E₂ = q₂_P.base '' (E i) → E₂ = E i) ∧
        ∃ q₁' q₂' q₃' : ↥F_Y,
          q₁' ≠ q₂' ∧ q₁' ≠ q₃' ∧ q₂' ≠ q₃' ∧
          q₁' ∈ q₂_P.base '' (E i) ∧ q₂' ∈ q₂_P.base '' (E i) ∧ q₃' ∈ q₂_P.base '' (E i) ∧
          ∀ q ∈ ({q₁', q₂', q₃'} : Set ↥F_Y),
            IsClosed (q₂_P.base ⁻¹' ({q} : Set ↥F_Y)) ∧
            ((∃ d ∈ D₁, q₂_P.base d = q) ∨
              (∃ H' ∈ irreducibleComponents ↥F₁,
                q₂_P.base '' H' ≠ q₂_P.base '' (E i) ∧
                (∃ u₁ u₂ : ↥F_Y, u₁ ≠ u₂ ∧ u₁ ∈ q₂_P.base '' H' ∧ u₂ ∈ q₂_P.base '' H') ∧
                q ∈ q₂_P.base '' H')) := by
      intro i hi
      obtain ⟨hEi_comp, hCl_i, hInt_i, hRange_i, hP1_i⟩ := hE_props i
      exact hSurv (E i) (E_sch i) (ιE i) (f_X.base x₀)
        hEi_comp hCl_i hInt_i hRange_i hP1_i (hx₀_U i) hi
    have hCard_le_two : ∀ q : ↥F_Y,
        Nat.card {j : Fin m_T // j ∈ V_surv ∧ q ∈ q₂_P.base '' (E j)} ≤ 2 := by
      intro q
      let S_q := {j : Fin m_T // j ∈ V_surv ∧ q ∈ q₂_P.base '' (E j)}
      letI : Fintype S_q := Fintype.ofFinite S_q
      rw [Nat.card_eq_fintype_card]
      by_contra hlt
      have hgt : 2 < Fintype.card S_q := Nat.lt_of_not_ge hlt
      let e_q : S_q ≃ Fin (Fintype.card S_q) := Fintype.equivFin S_q
      let u₁ : S_q := e_q.symm ⟨0, by omega⟩
      let u₂ : S_q := e_q.symm ⟨1, by omega⟩
      let u₃ : S_q := e_q.symm ⟨2, by omega⟩
      have h3 := hFibY.2.2.2.2.2.2.2.1 q
        (q₂_P.base '' (E u₁.1)) (q₂_P.base '' (E u₂.1)) (q₂_P.base '' (E u₃.1))
        (hSurv_i u₁.1 u₁.2.1).1 (hSurv_i u₂.1 u₂.2.1).1 (hSurv_i u₃.1 u₃.2.1).1
        u₁.2.2 u₂.2.2 u₃.2.2
      have hEqIdx : ∀ x y : S_q, q₂_P.base '' (E x.1) = q₂_P.base '' (E y.1) → x = y := by
        intro x y hEq
        apply Subtype.ext
        apply hInjE
        exact (hSurv_i y.1 y.2.1).2.2.1 (E x.1) (hE_props x.1).1 hEq
      rcases h3 with h12 | h13 | h23
      · have heq := congrArg (fun z => (e_q z).1) (hEqIdx u₁ u₂ h12)
        simp only [u₁, u₂, Equiv.apply_symm_apply] at heq
        omega
      · have heq := congrArg (fun z => (e_q z).1) (hEqIdx u₁ u₃ h13)
        simp only [u₁, u₃, Equiv.apply_symm_apply] at heq
        omega
      · have heq := congrArg (fun z => (e_q z).1) (hEqIdx u₂ u₃ h23)
        simp only [u₂, u₃, Equiv.apply_symm_apply] at heq
        omega
    exact weil_p1_tree_connected_fiber_forest_contradiction
      ↥F₁ ↥F_Y q₂_P.base (irreducibleComponents ↥F₁) m_T hm_T E D₁ Γ_T
      hFibC₁.2.2.2.1
      hInjE
      (fun a => (hE_props a).1)
      (fun H hH => isClosed_of_mem_irreducibleComponents H hH)
      (by
        ext w
        simp only [Set.mem_iUnion, Set.mem_univ, iff_true]
        exact ⟨irreducibleComponent w, irreducibleComponent_mem_irreducibleComponents w,
          (irreducibleComponent_property w).2.1 rfl⟩)
      hPairSub
      hAdj
      hTree
      (by
        dsimp only
        rw [← hT_eq]
        exact hBdryFin)
      (by
        dsimp only
        rw [← hT_eq]
        exact hBdryCard)
      V_surv
      hV_nonempty
      (fun _ => Iff.rfl)
      (fun i hi => (hSurv_i i hi).2.1)
      (fun i hi j hj hEq => hInjE ((hSurv_i j hj).2.2.1 (E i) (hE_props i).1 hEq))
      (fun i hi => by
        obtain ⟨q₁', q₂', q₃', hne12, hne13, hne23, hq1, hq2, hq3, hqs⟩ :=
          (hSurv_i i hi).2.2.2
        exact ⟨q₁', q₂', q₃', hne12, hne13, hne23, hq1, hq2, hq3, fun q hq =>
          ⟨(hqs q hq).1, hConn_q₂P q, hCard_le_two q, (hqs q hq).2⟩⟩)

theorem weil_local_relative_stable_overlap_uniqueness (K : Type u) [Field K] [IsSepClosed K]
    (m : ℕ) (V : ValuationSubring K) (hPkg : IsValuationRingAlgPackage m V)
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (n : ℕ) (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (hIntCK : AlgebraicGeometry.IsIntegral C_K)
    (hSmCK : AlgebraicGeometry.SmoothOfRelativeDimension 1 p_K)
    (hStabCK : IsGeometricStablePointedCurve p_K n σ_K)
    (C' : AlgebraicGeometry.Scheme.{u})
    (g' : C' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (τ' : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C'))
    (ι' : C_K ⟶ C')
    (hMod' : IsValuationPointedCurveModel V p_K n σ_K C' g' τ' ι')
    (U_a U_b : C'.Opens) (hU_a : Nonempty ↥U_a) (hU_b : Nonempty ↥U_b)
    (ι_Ua : AlgebraicGeometry.Scheme.Opens.toScheme
      ((TopologicalSpace.Opens.map ι'.base).obj U_a) ⟶ U_a.toScheme)
    (ι_Ub : AlgebraicGeometry.Scheme.Opens.toScheme
      ((TopologicalSpace.Opens.map ι'.base).obj U_b) ⟶ U_b.toScheme)
    (hι_a : ι_Ua ≫ U_a.ι =
      AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj U_a) ≫ ι')
    (hι_b : ι_Ub ≫ U_b.ι =
      AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj U_b) ≫ ι')
    (hPb_Ua : CategoryTheory.IsPullback ι_Ua
      (AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj U_a) ≫ p_K)
      (U_a.ι ≫ g')
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (hPb_Ub : CategoryTheory.IsPullback ι_Ub
      (AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj U_b) ≫ p_K)
      (U_b.ι ≫ g')
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (C_bar_a C_bar_b : AlgebraicGeometry.Scheme.{u})
    (g_bar_a : C_bar_a ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (g_bar_b : C_bar_b ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (f_bar_a : C_bar_a ⟶ U_a.toScheme)
    (f_bar_b : C_bar_b ⟶ U_b.toScheme)
    (τ_bar_a : ∀ j : Fin n,
      AlgebraicGeometry.Scheme.Opens.toScheme
        ((TopologicalSpace.Opens.map (τ' j).base).obj U_a) ⟶ C_bar_a)
    (τ_bar_b : ∀ j : Fin n,
      AlgebraicGeometry.Scheme.Opens.toScheme
        ((TopologicalSpace.Opens.map (τ' j).base).obj U_b) ⟶ C_bar_b)
    (ι_bar_a : AlgebraicGeometry.Scheme.Opens.toScheme
      ((TopologicalSpace.Opens.map ι'.base).obj U_a) ⟶ C_bar_a)
    (ι_bar_b : AlgebraicGeometry.Scheme.Opens.toScheme
      ((TopologicalSpace.Opens.map ι'.base).obj U_b) ⟶ C_bar_b)
    (hStab_a : IsLocalRelativeStableMod V p_K g' n τ' ι' U_a ι_Ua
      C_bar_a g_bar_a f_bar_a τ_bar_a ι_bar_a)
    (hStab_b : IsLocalRelativeStableMod V p_K g' n τ' ι' U_b ι_Ub
      C_bar_b g_bar_b f_bar_b τ_bar_b ι_bar_b) :
    let U_ab : C'.Opens := U_a ⊓ U_b
    let V_ab : C_bar_a.Opens := (TopologicalSpace.Opens.map (f_bar_a ≫ U_a.ι).base).obj U_ab
    let W_ab : C_bar_b.Opens := (TopologicalSpace.Opens.map (f_bar_b ≫ U_b.ι).base).obj U_ab
    ∃ (φ : V_ab.toScheme ≅ W_ab.toScheme),
      φ.hom ≫ W_ab.ι ≫ f_bar_b ≫ U_b.ι = V_ab.ι ≫ f_bar_a ≫ U_a.ι ∧
      ∀ (ψ : V_ab.toScheme ⟶ W_ab.toScheme),
        ψ ≫ W_ab.ι ≫ f_bar_b ≫ U_b.ι = V_ab.ι ≫ f_bar_a ≫ U_a.ι → ψ = φ.hom :=
by
  intro U_ab V_ab W_ab
  have hIrredC' : IrreducibleSpace ↥C' :=
    @AlgebraicGeometry.irreducibleSpace_of_isIntegral C' hMod'.1
  have : PreirreducibleSpace ↥C' := hIrredC'.toPreirreducibleSpace
  have hU_ab : Nonempty ↥U_ab := by
    obtain ⟨⟨xa, hxa⟩⟩ := hU_a
    obtain ⟨⟨xb, hxb⟩⟩ := hU_b
    obtain ⟨x, hx⟩ := nonempty_preirreducible_inter U_a.2 U_b.2 ⟨xa, hxa⟩ ⟨xb, hxb⟩
    exact ⟨⟨x, hx⟩⟩
  obtain ⟨hOpenη, hRestrict, hExt⟩ :=
    weil_local_relative_stable_open_restriction_and_hom_ext K m V hPkg C_K p_K n σ_K
      hIntCK hStabCK C' g' τ' ι' hMod'
  obtain ⟨hNorm, hGraph⟩ :=
    weil_strictlySemistable_affineNormal_and_birational_graph K m V hPkg hOpenη C_K p_K n σ_K
      hIntCK hSmCK hStabCK C' g' τ' ι' hMod'
  have hBl : HasOverlapElementaryBlowupOracle V :=
    weil_elementary_strictlySemistable_point_blowup_step K m V hPkg
  have hUK : Nonempty ↥((TopologicalSpace.Opens.map ι'.base).obj U_ab) := by
    have hIrredCK : IrreducibleSpace ↥C_K :=
      @AlgebraicGeometry.irreducibleSpace_of_isIntegral C_K hIntCK
    obtain ⟨xK⟩ := hIrredCK.toNonempty
    obtain ⟨⟨xab, hxab⟩⟩ := hU_ab
    have hPb_ι' : CategoryTheory.IsPullback ι' p_K g'
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)) :=
      hMod'.2.2.2.2.2.2.2.1
    have : AlgebraicGeometry.IsOpenImmersion ι' :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (P := @AlgebraicGeometry.IsOpenImmersion) hPb_ι'.flip hOpenη
    have hOpenRange : IsOpen (Set.range ι'.base) := ι'.isOpenEmbedding.isOpen_range
    obtain ⟨y, hyU, ⟨x0, rfl⟩⟩ :=
      nonempty_preirreducible_inter U_ab.2 hOpenRange ⟨xab, hxab⟩ ⟨ι'.base xK, xK, rfl⟩
    exact ⟨⟨x0, hyU⟩⟩
  obtain ⟨ι_Uab, f_Va, τ_Va, ι_Va, hι_Uab, hPb_Uab, hf_Va, hNoeth_Va, hCl_Va, hStab_Va⟩ :=
    hRestrict U_a U_ab inf_le_left hU_ab ι_Ua hι_a hPb_Ua
      C_bar_a g_bar_a f_bar_a τ_bar_a ι_bar_a hStab_a
  obtain ⟨ι'_Uab, f_Wb, τ_Wb, ι_Wb, hι'_Uab, _hPb'_Uab, hf_Wb, hNoeth_Wb, hCl_Wb, hStab_Wb0⟩ :=
    hRestrict U_b U_ab inf_le_right hU_ab ι_Ub hι_b hPb_Ub
      C_bar_b g_bar_b f_bar_b τ_bar_b ι_bar_b hStab_b
  have hι_eq : ι'_Uab = ι_Uab := by
    apply (cancel_mono U_ab.ι).mp
    exact hι'_Uab.trans hι_Uab.symm
  have hStab_Wb : IsLocalRelativeStableMod V p_K g' n τ' ι' U_ab ι_Uab
      W_ab.toScheme (W_ab.ι ≫ g_bar_b) f_Wb τ_Wb ι_Wb := by
    rw [← hι_eq]
    exact hStab_Wb0
  
  have hConnComp : ∀ {A B C : AlgebraicGeometry.Scheme.{u}}
      (f : A ⟶ B) (g : B ⟶ C),
      IsClosedMap f.base →
      (∀ b : B, _root_.IsConnected (f.base ⁻¹' ({b} : Set B))) →
      (∀ c : C, _root_.IsConnected (g.base ⁻¹' ({c} : Set C))) →
      ∀ c : C, _root_.IsConnected ((f ≫ g).base ⁻¹' ({c} : Set C)) := by
    intro A B C f g hClMap hConn_f hConn_g c
    let T : Set B := g.base ⁻¹' ({c} : Set C)
    let S : Set A := (f ≫ g).base ⁻¹' ({c} : Set C)
    have hS_eq : S = f.base ⁻¹' T := rfl
    refine ⟨?_, ?_⟩
    · obtain ⟨b0, hb0⟩ := (hConn_g c).1
      obtain ⟨a0, ha0⟩ := (hConn_f b0).1
      refine ⟨a0, ?_⟩
      change g.base (f.base a0) = c
      have hfb : f.base a0 = b0 := ha0
      rw [hfb]
      exact hb0
    · intro U W hU hW hSUW ⟨a1, ha1S, ha1U⟩ ⟨a2, ha2S, ha2W⟩
      by_contra hDisj
      let UB : Set B := (f.base '' Uᶜ)ᶜ
      let WB : Set B := (f.base '' Wᶜ)ᶜ
      have hUB_open : IsOpen UB := (hClMap Uᶜ hU.isClosed_compl).isOpen_compl
      have hWB_open : IsOpen WB := (hClMap Wᶜ hW.isClosed_compl).isOpen_compl
      have hMemUB : ∀ b : B, b ∈ UB ↔ f.base ⁻¹' ({b} : Set B) ⊆ U := by
        intro b
        constructor
        · intro hb a ha
          by_contra haU
          exact hb ⟨a, haU, ha⟩
        · rintro hsub ⟨a, haU, rfl⟩
          exact haU (hsub rfl)
      have hMemWB : ∀ b : B, b ∈ WB ↔ f.base ⁻¹' ({b} : Set B) ⊆ W := by
        intro b
        constructor
        · intro hb a ha
          by_contra haW
          exact hb ⟨a, haW, ha⟩
        · rintro hsub ⟨a, haW, rfl⟩
          exact haW (hsub rfl)
      have hT_sub : T ⊆ UB ∪ WB := by
        intro b hbT
        by_contra hNot
        have hbU : ¬ f.base ⁻¹' ({b} : Set B) ⊆ U :=
          fun h => hNot (Or.inl ((hMemUB b).mpr h))
        have hbW : ¬ f.base ⁻¹' ({b} : Set B) ⊆ W :=
          fun h => hNot (Or.inr ((hMemWB b).mpr h))
        obtain ⟨x1, hx1b, hx1notU⟩ := Set.not_subset.mp hbU
        obtain ⟨x2, hx2b, hx2notW⟩ := Set.not_subset.mp hbW
        have hx1S : x1 ∈ S := by
          change g.base (f.base x1) = c
          have hfx1 : f.base x1 = b := hx1b
          rw [hfx1]; exact hbT
        have hx2S : x2 ∈ S := by
          change g.base (f.base x2) = c
          have hfx2 : f.base x2 = b := hx2b
          rw [hfx2]; exact hbT
        have hx1W : x1 ∈ W := by
          rcases hSUW hx1S with h | h
          · exact False.elim (hx1notU h)
          · exact h
        have hx2U : x2 ∈ U := by
          rcases hSUW hx2S with h | h
          · exact h
          · exact False.elim (hx2notW h)
        obtain ⟨x3, hx3b, hx3UW⟩ :=
          (hConn_f b).2 U W hU hW
            (fun x hx => hSUW (by
              change g.base (f.base x) = c
              have hfx : f.base x = b := hx
              rw [hfx]; exact hbT))
            ⟨x2, hx2b, hx2U⟩ ⟨x1, hx1b, hx1W⟩
        have hx3S : x3 ∈ S := by
          change g.base (f.base x3) = c
          have hfx3 : f.base x3 = b := hx3b
          rw [hfx3]; exact hbT
        exact hDisj ⟨x3, hx3S, hx3UW⟩
      have hb1T : f.base a1 ∈ T := ha1S
      have hb1UB : f.base a1 ∈ UB := by
        rcases hT_sub hb1T with h | h
        · exact h
        · exfalso
          have ha1W : a1 ∈ W := (hMemWB (f.base a1)).mp h rfl
          exact hDisj ⟨a1, ha1S, ha1U, ha1W⟩
      have hb2T : f.base a2 ∈ T := ha2S
      have hb2WB : f.base a2 ∈ WB := by
        rcases hT_sub hb2T with h | h
        · exfalso
          have ha2U : a2 ∈ U := (hMemUB (f.base a2)).mp h rfl
          exact hDisj ⟨a2, ha2S, ha2U, ha2W⟩
        · exact h
      obtain ⟨b_star, hb_starT, hb_starUB, hb_starWB⟩ :=
        (hConn_g c).2 UB WB hUB_open hWB_open hT_sub
          ⟨f.base a1, hb1T, hb1UB⟩ ⟨f.base a2, hb2T, hb2WB⟩
      obtain ⟨a_star, ha_star⟩ := (hConn_f b_star).1
      have ha_starS : a_star ∈ S := by
        change g.base (f.base a_star) = c
        have hfa : f.base a_star = b_star := ha_star
        rw [hfa]; exact hb_starT
      exact hDisj ⟨a_star, ha_starS,
        (hMemUB b_star).mp hb_starUB ha_star,
        (hMemWB b_star).mp hb_starWB ha_star⟩
  
  have hIsoFib : ∀ {A B : AlgebraicGeometry.Scheme.{u}} (e : A ≅ B),
      IsClosedMap e.hom.base ∧ ∀ b : B, _root_.IsConnected (e.hom.base ⁻¹' ({b} : Set B)) := by
    intro A B e
    refine ⟨e.hom.isClosedMap, fun b => ?_⟩
    have hEq : e.hom.base ⁻¹' ({b} : Set B) = {e.inv.base b} := by
      ext a
      simp only [Set.mem_preimage, Set.mem_singleton_iff]
      constructor
      · intro h
        rw [← h]
        change a = (e.hom ≫ e.inv).base a
        rw [e.hom_inv_id]
        rfl
      · rintro rfl
        change (e.inv ≫ e.hom).base b = b
        rw [e.inv_hom_id]
        rfl
    rw [hEq]
    exact isConnected_singleton
  
  have hTowerProps : ∀ {Z Z' : AlgebraicGeometry.Scheme.{u}}
      {g_Z : Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V)}
      {g_Z' : Z' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V)}
      {p : Z' ⟶ Z},
      IsElementaryBlowupTower V g_Z g_Z' p →
      p ≫ g_Z = g_Z' ∧ ∀ z : Z, _root_.IsConnected (p.base ⁻¹' ({z} : Set Z)) := by
    intro Z Z' g_Z g_Z' p hTow
    obtain ⟨N, Cseq, gseq, fstep, ptow, e₀, eN, he₀_ptow, he₀_g, hsteps, heN_g, heN_p⟩ := hTow
    have hSeq : ∀ i : Fin (N + 1),
        ptow i ≫ g_Z = gseq i ∧ ∀ z : Z, _root_.IsConnected ((ptow i).base ⁻¹' ({z} : Set Z)) := by
      intro i
      induction i using Fin.induction with
      | zero =>
        rw [← he₀_ptow]
        exact ⟨he₀_g, (hIsoFib e₀).2⟩
      | succ i ih =>
        obtain ⟨hStep_i, hptow_succ⟩ := hsteps i
        rw [hptow_succ]
        refine ⟨?_, ?_⟩
        · rw [CategoryTheory.Category.assoc, ih.1, hStep_i.2.2.1]
        · have : AlgebraicGeometry.IsProper (fstep i) := hStep_i.2.1
          exact hConnComp (fstep i) (ptow i.castSucc) (fstep i).isClosedMap
            hStep_i.2.2.2.1 ih.2
    obtain ⟨hLast_g, hLast_conn⟩ := hSeq (Fin.last N)
    rw [← heN_p]
    refine ⟨?_, ?_⟩
    · rw [CategoryTheory.Category.assoc, hLast_g, heN_g]
    · exact hConnComp eN.hom (ptow (Fin.last N)) (hIsoFib eN).1 (hIsoFib eN).2 hLast_conn
  
  have exists_dom : ∀ (X Y : AlgebraicGeometry.Scheme.{u})
      (g_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
      (g_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
      (f_X : X ⟶ U_ab.toScheme)
      (f_Y : Y ⟶ U_ab.toScheme)
      (τ_X : ∀ j : Fin n,
        AlgebraicGeometry.Scheme.Opens.toScheme
          ((TopologicalSpace.Opens.map (τ' j).base).obj U_ab) ⟶ X)
      (τ_Y : ∀ j : Fin n,
        AlgebraicGeometry.Scheme.Opens.toScheme
          ((TopologicalSpace.Opens.map (τ' j).base).obj U_ab) ⟶ Y)
      (ι_X : AlgebraicGeometry.Scheme.Opens.toScheme
        ((TopologicalSpace.Opens.map ι'.base).obj U_ab) ⟶ X)
      (ι_Y : AlgebraicGeometry.Scheme.Opens.toScheme
        ((TopologicalSpace.Opens.map ι'.base).obj U_ab) ⟶ Y),
      TopologicalSpace.NoetherianSpace ↥X →
      TopologicalSpace.NoetherianSpace ↥Y →
      (∀ j : Fin n, AlgebraicGeometry.IsClosedImmersion (τ_X j)) →
      (∀ j : Fin n, AlgebraicGeometry.IsClosedImmersion (τ_Y j)) →
      IsLocalRelativeStableMod V p_K g' n τ' ι' U_ab ι_Uab X g_X f_X τ_X ι_X →
      IsLocalRelativeStableMod V p_K g' n τ' ι' U_ab ι_Uab Y g_Y f_Y τ_Y ι_Y →
      ∃ α : X ⟶ Y, α ≫ f_Y = f_X := by
    intro X Y g_X g_Y f_X f_Y τ_X τ_Y ι_X ι_Y hNoeth_X hNoeth_Y hCl_X hCl_Y hStab_X hStab_Y
    obtain ⟨hSS_X, hProp_fX, hfX_g, hιX_fX, hPb_X, hτX_comm, hDisj_X, _hSm_X, _hRel_X⟩ := hStab_X
    obtain ⟨hSS_Y, hProp_fY, hfY_g, hιY_fY, hPb_Y, hτY_comm, hDisj_Y, _hSm_Y, _hRel_Y⟩ := hStab_Y
    let S_ab : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V)).Opens :=
      fun j => (TopologicalSpace.Opens.map (τ' j).base).obj U_ab
    have hτX_g : ∀ j : Fin n, τ_X j ≫ g_X = (S_ab j).ι := by
      intro j
      calc
        τ_X j ≫ g_X = τ_X j ≫ (f_X ≫ U_ab.ι ≫ g') := by rw [hfX_g]
        _ = ((τ_X j ≫ f_X) ≫ U_ab.ι) ≫ g' := by simp only [CategoryTheory.Category.assoc]
        _ = ((S_ab j).ι ≫ τ' j) ≫ g' := by rw [hτX_comm j]
        _ = (S_ab j).ι ≫ (τ' j ≫ g') := by rw [CategoryTheory.Category.assoc]
        _ = (S_ab j).ι := by rw [hMod'.2.2.2.2.2.2.1 j, CategoryTheory.Category.comp_id]
    have hτY_g : ∀ j : Fin n, τ_Y j ≫ g_Y = (S_ab j).ι := by
      intro j
      calc
        τ_Y j ≫ g_Y = τ_Y j ≫ (f_Y ≫ U_ab.ι ≫ g') := by rw [hfY_g]
        _ = ((τ_Y j ≫ f_Y) ≫ U_ab.ι) ≫ g' := by simp only [CategoryTheory.Category.assoc]
        _ = ((S_ab j).ι ≫ τ' j) ≫ g' := by rw [hτY_comm j]
        _ = (S_ab j).ι ≫ (τ' j ≫ g') := by rw [CategoryTheory.Category.assoc]
        _ = (S_ab j).ι := by rw [hMod'.2.2.2.2.2.2.1 j, CategoryTheory.Category.comp_id]
    have hτXY_f : ∀ j : Fin n, τ_X j ≫ f_X = τ_Y j ≫ f_Y := by
      intro j
      apply (cancel_mono U_ab.ι).mp
      exact (hτX_comm j).trans (hτY_comm j).symm
    rcases hGraph U_ab hU_ab ι_Uab hPb_Uab X Y g_X g_Y f_X f_Y ι_X ι_Y
        hSS_X hSS_Y hNoeth_X hNoeth_Y hProp_fX hProp_fY
        hfX_g hfY_g hιX_fX hιY_fY hPb_X hPb_Y with
      ⟨α, hα⟩ |
      ⟨P_tilde, π₁, π₂, ι_P, P, instPrimeP, hP_ne, x₀, E_tilde, F_target,
        hInt_P, _hNoeth_P, hProp_π₁, hProp_π₂, hπ_comm, hιP_π₁, hιP_π₂, hPb_P,
        hClosed_x₀, hx₀_P, _hE_comp, hF_comp, hF_two, hE_x₀, hE_im⟩
    · exact ⟨α, hα⟩
    · exfalso
      have : P.IsPrime := instPrimeP
      
      obtain ⟨C₁, g₁, q₁, q_P, τ₁, ι₁,
          hSS₁, hNoeth₁, hTow₁, hProp_qP, hSurj_qP, hqP_π₁, hι₁_qP, hPb₁,
          hτ₁_q₁, hτ₁_g₁, hCl₁, hDisj₁, hSm₁⟩ :=
        weil_pointed_blowup_tower_domination K m V hPkg hBl hNorm hOpenη C_K p_K
          hIntCK hSmCK ((TopologicalSpace.Opens.map ι'.base).obj U_ab) hUK
          n S_ab X g_X τ_X ι_X P_tilde π₁ ι_P
          hSS_X hNoeth_X hPb_X hτX_g hCl_X hDisj_X hInt_P hProp_π₁ hιP_π₁ hPb_P
      have hq₁_gX : q₁ ≫ g_X = g₁ := (hTowerProps hTow₁).1
      let q₂ : C₁ ⟶ Y := q_P ≫ π₂
      have hProp_q₂ : AlgebraicGeometry.IsProper q₂ :=
        @AlgebraicGeometry.IsProper.instCompScheme _ _ _ q_P π₂ hProp_qP hProp_π₂
      have hq₁_fX : q₁ ≫ f_X = q₂ ≫ f_Y := by
        calc
          q₁ ≫ f_X = (q_P ≫ π₁) ≫ f_X := by rw [← hqP_π₁]
          _ = q_P ≫ (π₁ ≫ f_X) := by rw [CategoryTheory.Category.assoc]
          _ = q_P ≫ (π₂ ≫ f_Y) := by rw [hπ_comm]
          _ = q₂ ≫ f_Y := by rw [← CategoryTheory.Category.assoc]
      have hq₂_gY : q₂ ≫ g_Y = g₁ := by
        calc
          q₂ ≫ g_Y = q₂ ≫ (f_Y ≫ U_ab.ι ≫ g') := by rw [hfY_g]
          _ = (q₂ ≫ f_Y) ≫ (U_ab.ι ≫ g') := by rw [← CategoryTheory.Category.assoc]
          _ = (q₁ ≫ f_X) ≫ (U_ab.ι ≫ g') := by rw [← hq₁_fX]
          _ = q₁ ≫ (f_X ≫ U_ab.ι ≫ g') := by rw [CategoryTheory.Category.assoc]
          _ = q₁ ≫ g_X := by rw [hfX_g]
          _ = g₁ := hq₁_gX
      have hι₁_q₂ : ι₁ ≫ q₂ = ι_Y := by
        calc
          ι₁ ≫ q₂ = (ι₁ ≫ q_P) ≫ π₂ := by rw [← CategoryTheory.Category.assoc]
          _ = ι_P ≫ π₂ := by rw [hι₁_qP]
          _ = ι_Y := hιP_π₂
      have hτ₁_q₂ : ∀ j : Fin n, τ₁ j ≫ q₂ = τ_Y j := by
        intro j
        have hExtXY := (hExt U_ab hU_ab ι_Uab hPb_Uab X Y g_X g_Y f_X f_Y ι_X ι_Y
          hSS_X.1 hSS_Y.2.2.1 hfX_g hfY_g hιX_fX hιY_fY hPb_X hPb_Y).2
        apply hExtXY (S_ab j) (τ₁ j ≫ q₂) (τ_Y j)
        · rw [CategoryTheory.Category.assoc, hq₂_gY, hτ₁_g₁ j]
        · exact hτY_g j
        · calc
            (τ₁ j ≫ q₂) ≫ f_Y = τ₁ j ≫ (q₂ ≫ f_Y) := by rw [CategoryTheory.Category.assoc]
            _ = τ₁ j ≫ (q₁ ≫ f_X) := by rw [← hq₁_fX]
            _ = (τ₁ j ≫ q₁) ≫ f_X := by rw [← CategoryTheory.Category.assoc]
            _ = τ_X j ≫ f_X := by rw [hτ₁_q₁ j]
            _ = τ_Y j ≫ f_Y := hτXY_f j
      
      have hPb₁_q₂ : CategoryTheory.IsPullback ι₁
          (AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj U_ab) ≫ p_K)
          (q₂ ≫ g_Y)
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)) := by
        rw [hq₂_gY]; exact hPb₁
      obtain ⟨C₂, g₂, p₂, r, τ₂, ι₂,
          hSS₂, hNoeth₂, hTow₂, hProp_r, hSurj_r, hr_q₂, hι₂_r, hPb₂,
          hτ₂_p₂, hτ₂_g₂, hCl₂, hDisj₂, hSm₂⟩ :=
        weil_pointed_blowup_tower_domination K m V hPkg hBl hNorm hOpenη C_K p_K
          hIntCK hSmCK ((TopologicalSpace.Opens.map ι'.base).obj U_ab) hUK
          n S_ab Y g_Y τ_Y ι_Y C₁ q₂ ι₁
          hSS_Y hNoeth_Y hPb_Y hτY_g hCl_Y hDisj_Y hSS₁.1 hProp_q₂ hι₁_q₂ hPb₁_q₂
      have hp₂_gY : p₂ ≫ g_Y = g₂ := (hTowerProps hTow₂).1
      have hr_g₁ : r ≫ g₁ = g₂ := by
        calc
          r ≫ g₁ = r ≫ (q₂ ≫ g_Y) := by rw [← hq₂_gY]
          _ = (r ≫ q₂) ≫ g_Y := by rw [← CategoryTheory.Category.assoc]
          _ = p₂ ≫ g_Y := by rw [hr_q₂]
          _ = g₂ := hp₂_gY
      have hι₁_fC₁ : ι₁ ≫ (q₁ ≫ f_X) = ι_Uab := by
        calc
          ι₁ ≫ (q₁ ≫ f_X) = ι₁ ≫ ((q_P ≫ π₁) ≫ f_X) := by rw [← hqP_π₁]
          _ = (ι₁ ≫ q_P) ≫ π₁ ≫ f_X := by simp only [CategoryTheory.Category.assoc]
          _ = ι_P ≫ π₁ ≫ f_X := by rw [hι₁_qP]
          _ = (ι_P ≫ π₁) ≫ f_X := by rw [← CategoryTheory.Category.assoc]
          _ = ι_X ≫ f_X := by rw [hιP_π₁]
          _ = ι_Uab := hιX_fX
      have hfC₁_g : (q₁ ≫ f_X) ≫ U_ab.ι ≫ g' = g₁ := by
        rw [CategoryTheory.Category.assoc, hfX_g, hq₁_gX]
      have hτ₂_r : ∀ j : Fin n, τ₂ j ≫ r = τ₁ j := by
        intro j
        have hExtC₁ := (hExt U_ab hU_ab ι_Uab hPb_Uab C₁ C₁ g₁ g₁ (q₁ ≫ f_X) (q₁ ≫ f_X) ι₁ ι₁
          hSS₁.1 hSS₁.2.2.1 hfC₁_g hfC₁_g hι₁_fC₁ hι₁_fC₁ hPb₁ hPb₁).2
        apply hExtC₁ (S_ab j) (τ₂ j ≫ r) (τ₁ j)
        · rw [CategoryTheory.Category.assoc, hr_g₁, hτ₂_g₂ j]
        · exact hτ₁_g₁ j
        · calc
            (τ₂ j ≫ r) ≫ (q₁ ≫ f_X) = τ₂ j ≫ r ≫ (q₂ ≫ f_Y) := by
              rw [hq₁_fX, CategoryTheory.Category.assoc]
            _ = τ₂ j ≫ (r ≫ q₂) ≫ f_Y := by simp only [CategoryTheory.Category.assoc]
            _ = (τ₂ j ≫ p₂) ≫ f_Y := by rw [hr_q₂, ← CategoryTheory.Category.assoc]
            _ = τ_Y j ≫ f_Y := by rw [hτ₂_p₂ j]
