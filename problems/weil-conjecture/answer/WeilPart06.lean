        rw [hhom_eq, AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc, hφ0_spec]
      have hRange_DL : ∀ x : L_W, x ∈ Set.range ι_DL ↔
          (∃ q : ↥V, x = γ_bar q) ∨
          (∃ q : ↥V, q ∉ (g_Z.base z₀).asIdeal ∧ γ_bar q * x = 1) := by
        rw [hgZ_z0]
        intro x
        constructor
        · rintro ⟨d, rfl⟩
          rcases hLin d with ⟨q, rfl⟩ | ⟨q, hq, hqd⟩
          · left; refine ⟨q, ?_⟩; rw [← hιDL_γ]; rfl
          · right
            refine ⟨q, hq, ?_⟩
            have h1 := congrArg ι_DL hqd
            rw [map_mul, map_one] at h1
            have hγ : ι_DL (γ_Du q) = γ_bar q := by rw [← hιDL_γ]; rfl
            rwa [hγ] at h1
        · rintro (⟨q, rfl⟩ | ⟨q, hq, hqx⟩)
          · refine ⟨γ_Du q, ?_⟩; rw [← hιDL_γ]; rfl
          · have hnot_m : γ_Du q ∉ IsLocalRing.maximalIdeal D_u := hq
            obtain ⟨u, hu⟩ := IsLocalRing.notMem_maximalIdeal.mp hnot_m
            refine ⟨↑u⁻¹, ?_⟩
            have hu_inv : ι_DL ↑u⁻¹ * γ_bar q = 1 := by
              have hγ : γ_bar q = ι_DL (γ_Du q) := by rw [← hιDL_γ]; rfl
              rw [hγ, ← hu, ← map_mul, Units.inv_mul, map_one]
            calc
              ι_DL ↑u⁻¹ = ι_DL ↑u⁻¹ * 1 := (mul_one _).symm
              _ = ι_DL ↑u⁻¹ * (γ_bar q * x) := by rw [hqx]
              _ = (ι_DL ↑u⁻¹ * γ_bar q) * x := (mul_assoc _ _ _).symm
              _ = 1 * x := by rw [hu_inv]
              _ = x := one_mul x
      have hMemRange : ∀ w : ↥Z, w ∈ U₀ → w ∈ closure ({z_Q} : Set ↥Z) →
          w ∈ Set.range ι_D.base := by
        intro w hwU hw_cl
        let pw := hU0.primeIdealOf ⟨w, hwU⟩
        have hpu_pw : p_u ≤ pw.asIdeal := hp_le_of_cl w hwU hw_cl
        let π_w : D_u →+* B_0 ⧸ pw.asIdeal := Ideal.Quotient.factor hpu_pw
        haveI : IsDomain (B_0 ⧸ pw.asIdeal) := Ideal.Quotient.isDomain pw.asIdeal
        let q_w : AlgebraicGeometry.Spec (CommRingCat.of D_u) :=
          ⟨RingHom.ker π_w, RingHom.ker_isPrime π_w⟩
        refine ⟨q_w, ?_⟩
        have hpt_eq : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk p_u) :
            Z.presheaf.obj (Opposite.op U₀) ⟶ CommRingCat.of D_u)).base q_w = pw := by
          apply PrimeSpectrum.ext
          ext b
          change Ideal.Quotient.mk p_u b ∈ RingHom.ker π_w ↔ b ∈ pw.asIdeal
          rw [RingHom.mem_ker, Ideal.Quotient.factor_mk, Ideal.Quotient.eq_zero_iff_mem]
        change hU0.fromSpec.base
          ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk p_u))).base q_w) = w
        rw [hpt_eq, hU0.fromSpec_primeIdealOf ⟨w, hwU⟩]
      refine ⟨m_D, ι_DL, hPre_ιD, rfl, hmD_z0, ?_, hker_γDu, ?_,
        hιDL_inj, hιDL_γ, hComm_D, hιD_gZ, hRange_DL, hMemRange⟩
      · rw [hgZ_z0]; exact hPs_le_P0
      · rw [hgZ_z0]; exact hLin

    have hDomSub : ∀ {D₁ D₂ : Type u} [CommRing D₁] [IsDomain D₁] [CommRing D₂] [IsDomain D₂]
        (ι₁ : AlgebraicGeometry.Spec (CommRingCat.of D₁) ⟶ Z)
        (ι₂ : AlgebraicGeometry.Spec (CommRingCat.of D₂) ⟶ Z)
        (γ₁ : ↥V →+* D₁) (γ₂ : ↥V →+* D₂)
        (ι₁L : D₁ →+* L_W) (ι₂L : D₂ →+* L_W)
        (P₁ P₂ : Ideal ↥V),
        Function.Injective ι₂L →
        ι₁L.comp γ₁ = γ_bar →
        ι₂L.comp γ₂ = γ_bar →
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₁L) ≫ ι₁ =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue ↥W)) ≫ ψ_Z →
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₂L) ≫ ι₂ =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue ↥W)) ≫ ψ_Z →
        ι₁ ≫ g_Z = AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ₁) →
        ι₂ ≫ g_Z = AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ₂) →
        (∀ x : L_W, x ∈ Set.range ι₁L ↔
          (∃ q : ↥V, x = γ_bar q) ∨ (∃ q : ↥V, q ∉ P₁ ∧ γ_bar q * x = 1)) →
        (∀ x : L_W, x ∈ Set.range ι₂L ↔
          (∃ q : ↥V, x = γ_bar q) ∨ (∃ q : ↥V, q ∉ P₂ ∧ γ_bar q * x = 1)) →
        P₂ ≤ P₁ →
        ∃ α : D₁ →+* D₂,
          α.comp γ₁ = γ₂ ∧
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom α) ≫ ι₁ = ι₂ := by
      intro D₁ D₂ _ _ _ _ ι₁ ι₂ γ₁ γ₂ ι₁L ι₂L P₁ P₂
        hInj₂ hγ₁ hγ₂ hComm₁ hComm₂ hg₁ hg₂ hR₁ hR₂ hP₂_le_P₁
      have hSub : ∀ d : D₁, ∃ d' : D₂, ι₂L d' = ι₁L d := by
        intro d
        apply (hR₂ (ι₁L d)).mpr
        rcases (hR₁ (ι₁L d)).mp ⟨d, rfl⟩ with ⟨q, hq⟩ | ⟨q, hqP₁, hq⟩
        · exact Or.inl ⟨q, hq⟩
        · exact Or.inr ⟨q, fun hqP₂ => hqP₁ (hP₂_le_P₁ hqP₂), hq⟩
      let α : D₁ →+* D₂ :=
        { toFun := fun d => Classical.choose (hSub d)
          map_one' := hInj₂ (by rw [Classical.choose_spec (hSub 1), map_one, map_one])
          map_mul' := fun x y => hInj₂ (by
            rw [Classical.choose_spec (hSub (x * y)), map_mul, map_mul,
              Classical.choose_spec (hSub x), Classical.choose_spec (hSub y)])
          map_zero' := hInj₂ (by rw [Classical.choose_spec (hSub 0), map_zero, map_zero])
          map_add' := fun x y => hInj₂ (by
            rw [Classical.choose_spec (hSub (x + y)), map_add, map_add,
              Classical.choose_spec (hSub x), Classical.choose_spec (hSub y)]) }
      have hα_comp : ι₂L.comp α = ι₁L :=
        RingHom.ext fun d => Classical.choose_spec (hSub d)
      have hα_γ : α.comp γ₁ = γ₂ := by
        ext v
        apply hInj₂
        change (ι₂L.comp α) (γ₁ v) = (ι₂L.comp γ₂) v
        rw [hα_comp, hγ₂, ← hγ₁]
        rfl
      refine ⟨α, hα_γ, ?_⟩
      let j₂ : AlgebraicGeometry.Spec (CommRingCat.of L_W) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of D₂) :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₂L)
      have hDom_j₂ : AlgebraicGeometry.IsDominant j₂ := by
        rw [AlgebraicGeometry.isDominant_iff, denseRange_iff_closure_range]
        ext q
        simp only [Set.mem_univ, iff_true]
        let ptL : AlgebraicGeometry.Spec (CommRingCat.of L_W) := ⟨⊥, inferInstance⟩
        let botD : PrimeSpectrum D₂ := ⟨⊥, inferInstance⟩
        have hpt : (j₂.base ptL : PrimeSpectrum D₂) = botD := by
          apply PrimeSpectrum.ext
          ext x
          change ι₂L x ∈ (⊥ : Ideal L_W) ↔ x ∈ (⊥ : Ideal D₂)
          simp only [Ideal.mem_bot]
          exact map_eq_zero_iff ι₂L hInj₂
        let q_ps : PrimeSpectrum D₂ := q
        have hcl_bot : q_ps ∈ closure ({botD} : Set (PrimeSpectrum D₂)) := by
          rw [PrimeSpectrum.closure_singleton]
          intro x hx
          exact (bot_le : (⊥ : Ideal D₂) ≤ q_ps.asIdeal) hx
        have hsub_range : ({botD} : Set (PrimeSpectrum D₂)) ⊆ Set.range j₂.base := by
          rintro _ rfl
          exact ⟨ptL, hpt⟩
        exact closure_mono hsub_range hcl_bot
      haveI : AlgebraicGeometry.IsDominant j₂ := hDom_j₂
      haveI : AlgebraicGeometry.IsSeparated g_Z := hSep_Z
      apply AlgebraicGeometry.ext_of_isDominant_of_isSeparated g_Z ?_ j₂ ?_
      · rw [CategoryTheory.Category.assoc, hg₁, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp, hα_γ, hg₂]
      · rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp, hα_comp, hComm₁, hComm₂]

    obtain ⟨z₀, hz0_in, hz0_cl⟩ :=
      hMinClosed (closure ({z_Q} : Set ↥Z)) isClosed_closure
        ⟨z_Q, subset_closure (Set.mem_singleton z_Q)⟩
    obtain ⟨U_0, hU0, hz0_U, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := z₀) (U := ⊤) trivial
    obtain ⟨hzQ, hVal, m_D, ι_DL, hPre_ιD, hm_D, hmD_z0, hPs_le_P0,
        hker_γDu, hLin, hιDL_inj, hιDL_γ, hComm_D, hιD_gZ, hRange_DL, hMemRange⟩ :=
      hChartPkg z₀ hz0_cl hz0_in U_0 hU0 hz0_U
    let B_0 := ↑(Z.presheaf.obj (Opposite.op U_0))
    let p_u : Ideal B_0 := (hU0.primeIdealOf ⟨z_Q, hzQ⟩).asIdeal
    haveI : p_u.IsPrime := (hU0.primeIdealOf ⟨z_Q, hzQ⟩).isPrime
    let D_u := B_0 ⧸ p_u
    letI : ValuationRing D_u := hVal
    let ι_D := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk p_u) :
      Z.presheaf.obj (Opposite.op U_0) ⟶ CommRingCat.of D_u) ≫ hU0.fromSpec
    let γ_Du : ↥V →+* D_u :=
      (Ideal.Quotient.mk p_u).comp (AlgebraicGeometry.Spec.preimage (hU0.fromSpec ≫ g_Z)).hom
    let P₀ : Ideal ↥V := (g_Z.base z₀).asIdeal

    have hRangeEq : Set.range ι_D.base = closure ({z_Q} : Set ↥Z) := by
      apply Set.Subset.antisymm
      · rintro _ ⟨q, rfl⟩
        let botD : AlgebraicGeometry.Spec (CommRingCat.of D_u) := ⟨⊥, inferInstance⟩
        have hbot_zQ : ι_D.base botD = z_Q := by
          have hpt : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk p_u) :
              Z.presheaf.obj (Opposite.op U_0) ⟶ CommRingCat.of D_u)).base botD =
              hU0.primeIdealOf ⟨z_Q, hzQ⟩ := by
            apply PrimeSpectrum.ext
            change Ideal.comap (Ideal.Quotient.mk p_u) ⊥ = p_u
            rw [← RingHom.ker_eq_comap_bot, Ideal.mk_ker]
          change hU0.fromSpec.base
            ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk p_u))).base botD) =
            z_Q
          rw [hpt, hU0.fromSpec_primeIdealOf ⟨z_Q, hzQ⟩]
        let q_ps : PrimeSpectrum D_u := q
        let bot_ps : PrimeSpectrum D_u := botD
        have hq_cl : q_ps ∈ closure ({bot_ps} : Set (PrimeSpectrum D_u)) := by
          rw [PrimeSpectrum.closure_singleton]
          intro x hx
          exact (bot_le : (⊥ : Ideal D_u) ≤ q_ps.asIdeal) hx
        have hbot_mem : botD ∈ ι_D.base ⁻¹' closure ({z_Q} : Set ↥Z) := by
          change ι_D.base botD ∈ closure ({z_Q} : Set ↥Z)
          rw [hbot_zQ]
          exact subset_closure (Set.mem_singleton z_Q)
        exact closure_minimal (Set.singleton_subset_iff.mpr hbot_mem)
          (isClosed_closure.preimage ι_D.continuous) hq_cl
      · intro w hw_cl
        obtain ⟨z'₀, hz'0_w, hz'0_cl⟩ :=
          hMinClosed (closure ({w} : Set ↥Z)) isClosed_closure
            ⟨w, subset_closure (Set.mem_singleton w)⟩
        have hz'0_in : z'₀ ∈ closure ({z_Q} : Set ↥Z) :=
          closure_minimal (Set.singleton_subset_iff.mpr hw_cl) isClosed_closure hz'0_w
        obtain ⟨U'_0, hU'0, hz'0_U, _⟩ :=
          AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := z'₀) (U := ⊤) trivial
        have hw_U' : w ∈ U'_0 := by
          by_contra hnot
          exact closure_minimal (Set.singleton_subset_iff.mpr hnot)
            U'_0.isOpen.isClosed_compl hz'0_w hz'0_U
        obtain ⟨hz'Q, hVal', m_D', ι'_DL, _hPre_ιD', hm_D', hmD'_z'0, _hPs_le_P'0,
            _hker_γD'u, _hLin', hι'DL_inj, hι'DL_γ, hComm_D', hιD'_gZ, hRange_D'L, hMemRange'⟩ :=
          hChartPkg z'₀ hz'0_cl hz'0_in U'_0 hU'0 hz'0_U
        let B'_0 := ↑(Z.presheaf.obj (Opposite.op U'_0))
        let p'_u : Ideal B'_0 := (hU'0.primeIdealOf ⟨z_Q, hz'Q⟩).asIdeal
        haveI : p'_u.IsPrime := (hU'0.primeIdealOf ⟨z_Q, hz'Q⟩).isPrime
        let D'_u := B'_0 ⧸ p'_u
        letI : ValuationRing D'_u := hVal'
        let ι_D' := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk p'_u) :
          Z.presheaf.obj (Opposite.op U'_0) ⟶ CommRingCat.of D'_u) ≫ hU'0.fromSpec
        let γ_D'u : ↥V →+* D'_u :=
          (Ideal.Quotient.mk p'_u).comp
            (AlgebraicGeometry.Spec.preimage (hU'0.fromSpec ≫ g_Z)).hom
        let P'₀ : Ideal ↥V := (g_Z.base z'₀).asIdeal
        obtain ⟨q_w', hqw'⟩ := hMemRange' w hw_U' hw_cl
        have hP'0_le_P0 : P'₀ ≤ P₀ := by
          rcases (ValuationRing.iff_ideal_total.mp (inferInstance : ValuationRing ↥V)).total P'₀ P₀
            with hle | hge
          · exact hle
          · obtain ⟨β, _, hβ_ι⟩ :=
              hDomSub ι_D' ι_D γ_D'u γ_Du ι'_DL ι_DL P'₀ P₀
                hιDL_inj hι'DL_γ hιDL_γ hComm_D' hComm_D hιD'_gZ hιD_gZ hRange_D'L hRange_DL hge
            let q'_1 : AlgebraicGeometry.Spec (CommRingCat.of D'_u) :=
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom β)).base m_D
            have hq'1_mem : q'_1 ∈ ι_D'.base ⁻¹' ({z₀} : Set ↥Z) := by
              change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom β) ≫ ι_D').base m_D = z₀
              rw [hβ_ι, hmD_z0]
            let q'1_ps : PrimeSpectrum D'_u := q'_1
            let mD'_ps : PrimeSpectrum D'_u := m_D'
            have hmD'_cl : mD'_ps ∈ closure ({q'1_ps} : Set (PrimeSpectrum D'_u)) := by
              rw [PrimeSpectrum.closure_singleton]
              change q'_1.asIdeal ≤ m_D'.asIdeal
              rw [hm_D']
              exact IsLocalRing.le_maximalIdeal q'_1.isPrime.ne_top
            have hz'0_eq_z0 : ι_D'.base m_D' = z₀ :=
              closure_minimal (Set.singleton_subset_iff.mpr hq'1_mem)
                (hz0_cl.preimage ι_D'.continuous) hmD'_cl
            have hz_eq : z'₀ = z₀ := hmD'_z'0.symm.trans hz'0_eq_z0
            change (g_Z.base z'₀).asIdeal ≤ (g_Z.base z₀).asIdeal
            rw [hz_eq]
        obtain ⟨α, _, hα_ι⟩ :=
          hDomSub ι_D ι_D' γ_Du γ_D'u ι_DL ι'_DL P₀ P'₀
            hι'DL_inj hιDL_γ hι'DL_γ hComm_D hComm_D' hιD_gZ hιD'_gZ
            hRange_DL hRange_D'L hP'0_le_P0
        refine ⟨(AlgebraicGeometry.Spec.map (CommRingCat.ofHom α)).base q_w', ?_⟩
        change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α) ≫ ι_D).base q_w' = w
        rw [hα_ι, hqw']

    haveI : AlgebraicGeometry.IsPreimmersion ι_D := hPre_ιD
    have hCl_ιD : AlgebraicGeometry.IsClosedImmersion ι_D := by
      apply AlgebraicGeometry.IsClosedImmersion.of_isPreimmersion ι_D
      rw [hRangeEq]
      exact isClosed_closure

    
    let Γ := CategoryTheory.Limits.pullback.lift ι_proj π_tilde hComm_proj
    have hΓ_snd : Γ ≫
        CategoryTheory.Limits.pullback.snd (weilProjectiveSpaceOver ↥V M_proj).hom g_Z =
        π_tilde :=
      CategoryTheory.Limits.pullback.lift_snd ι_proj π_tilde hComm_proj
    let y : ↥M_tilde := ψ_M.base mW
    let φ_UL : ↑(M_tilde.presheaf.obj (Opposite.op U_M)) →+* L_W :=
      (IsLocalRing.residue ↥W).comp φ_UM.hom
    have hker_φUL : RingHom.ker φ_UL = (hUM.primeIdealOf ⟨y, hyUM⟩).asIdeal := by
      have hp_M : (AlgebraicGeometry.Spec.map φ_UM).base mW = hUM.primeIdealOf ⟨y, hyUM⟩ := by
        apply hUM.fromSpec.isOpenEmbedding.injective
        rw [hUM.fromSpec_primeIdealOf ⟨y, hyUM⟩]
        change (AlgebraicGeometry.Spec.map φ_UM ≫ hUM.fromSpec).base mW = y
        rw [hφUM_spec]
      ext x_m
      change (IsLocalRing.residue ↥W) (φ_UM.hom x_m) = 0 ↔
        x_m ∈ (hUM.primeIdealOf ⟨y, hyUM⟩).asIdeal
      rw [← RingHom.mem_ker, IsLocalRing.ker_residue, ← hp_M, ← hmW]
      rfl
    have hComm_L : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_DL) ≫ ι_D =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_UL) ≫ hUM.fromSpec ≫ π_tilde := by
      rw [hComm_D]
      have hhom_eq : CommRingCat.ofHom φ_UL =
          φ_UM ≫ CommRingCat.ofHom (IsLocalRing.residue ↥W) := CommRingCat.Hom.ext rfl
      rw [hhom_eq, AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map φ_UM), hφUM_spec]
    have hLin_Ps : ∀ d : D_u, (∃ q : ↥V, d = γ_Du q) ∨
        (∃ q : ↥V, q ∉ P_s ∧ γ_Du q * d = 1) := by
      intro d
      rcases hLin d with ⟨q, hq⟩ | ⟨q, hqP0, hqd⟩
      · exact Or.inl ⟨q, hq⟩
      · exact Or.inr ⟨q, fun hqPs => hqP0 (hPs_le_P0 hqPs), hqd⟩
    have hTrans_D : ∀ Q_D : Polynomial D_u, Q_D ≠ 0 →
        Polynomial.eval₂ ι_DL (φ_UL f_M) Q_D ≠ 0 := by
      apply hClear P_s D_u γ_Du hker_γDu hLin_Ps L_W ι_DL (φ_UL f_M)
      intro Q hQ hev
      rw [hιDL_γ] at hev
      dsimp only [γ_bar] at hev
      have hψ_assoc : ψ_Z ≫ g_Z = ψ_M ≫ π_tilde ≫ g_Z :=
        CategoryTheory.Category.assoc ψ_M π_tilde g_Z
      rw [hψ_assoc] at hev
      change Polynomial.eval₂
        ((IsLocalRing.residue ↥W).comp
          (AlgebraicGeometry.Spec.preimage (ψ_M ≫ π_tilde ≫ g_Z)).hom)
        ((IsLocalRing.residue ↥W) (φ_UM.hom f_M)) Q = 0 at hev
      rw [← Polynomial.hom_eval₂, ← RingHom.mem_ker, IsLocalRing.ker_residue] at hev
      exact hfM_poly Q hQ hev
    have hP0_ne : (g_Z.base (ι_D.base m_D)).asIdeal ≠ ⊥ := by
      rw [hmD_z0]
      exact ne_bot_of_le_ne_bot hPs_ne hPs_le_P0
    haveI : (g_Z.base (ι_D.base m_D)).asIdeal.IsPrime := (g_Z.base (ι_D.base m_D)).isPrime
    have hVand_mD :=
      hVand (g_Z.base (ι_D.base m_D)).asIdeal (hAlgClosed _ hP0_ne) M_proj

    obtain ⟨y₀, V₀, hV₀, hy₀V₀, hy₀_cl, hy₀_z0, hNotLin⟩ :=
      weil_projective_closure_divisorial_point_specialization
        K V M_proj M_tilde Z g_Z π_tilde Γ y U_M hUM hyUM f_M
        D_u ι_D m_D L_W φ_UL ι_DL
        hProp_π hCl_proj hΓ_snd hCl_ιD hm_D hker_φUL hComm_L hTrans_D hVand_mD

    
    let P_y0 : Ideal ↥V := (g_Z.base (π_tilde.base y₀)).asIdeal
    haveI : P_y0.IsPrime := (g_Z.base (π_tilde.base y₀)).isPrime
    have hPy0_ne : P_y0 ≠ ⊥ := by
      change (g_Z.base (π_tilde.base y₀)).asIdeal ≠ ⊥
      rw [hy₀_z0]
      exact hP0_ne
    have hz₀_cl' : IsClosed ({π_tilde.base y₀} : Set Z) := by
      rw [hy₀_z0, hmD_z0]
      exact hz0_cl
    let B_V0 := ↑(M_tilde.presheaf.obj (Opposite.op V₀))
    let p_y0 : Ideal B_V0 := (hV₀.primeIdealOf ⟨y₀, hy₀V₀⟩).asIdeal
    haveI : p_y0.IsPrime := (hV₀.primeIdealOf ⟨y₀, hy₀V₀⟩).isPrime
    let γ_V0 : ↥V →+* B_V0 :=
      (AlgebraicGeometry.Spec.preimage (hV₀.fromSpec ≫ π_tilde ≫ g_Z)).hom
    have hcomap_V0 : Ideal.comap γ_V0 p_y0 = P_y0 := by
      let p' := hV₀.primeIdealOf ⟨y₀, hy₀V₀⟩
      have hbase : (AlgebraicGeometry.Spec.map
          (AlgebraicGeometry.Spec.preimage (hV₀.fromSpec ≫ π_tilde ≫ g_Z))).base p' =
          g_Z.base (π_tilde.base y₀) := by
        rw [AlgebraicGeometry.Spec.map_preimage]
        change g_Z.base (π_tilde.base (hV₀.fromSpec.base p')) = g_Z.base (π_tilde.base y₀)
        rw [hV₀.fromSpec_primeIdealOf ⟨y₀, hy₀V₀⟩]
      exact congrArg PrimeSpectrum.asIdeal hbase
    have hBr1_y0 : ∃ (b₁ b₂ : B_V0),
        b₂ ∉ p_y0 ∧
        ∀ (R : Type u) [CommRing R] [IsLocalRing R] (ρ_B : B_V0 →+* R),
          Ideal.comap ρ_B (IsLocalRing.maximalIdeal R) = p_y0 →
          ∀ (t : R),
            ρ_B b₂ * t = ρ_B b₁ →
            ∀ (Q : Polynomial ↥V),
              (∃ i : ℕ, Q.coeff i ∉ P_y0) →
              Polynomial.eval₂ (ρ_B.comp γ_V0) t Q ∉ IsLocalRing.maximalIdeal R := by
      rcases hDicho P_y0 (hAlgClosed P_y0 hPy0_ne) B_V0 p_y0 γ_V0 hcomap_V0
        with h1 | ⟨hVal_y0, hle_y0, hlin_y0, _⟩
      · exact h1
      · exfalso
        apply hNotLin
        intro d
        rcases hlin_y0 d with ⟨q, hq⟩ | ⟨q, hq_not, hqd⟩
        · exact Or.inl ⟨q, hq⟩
        · refine Or.inr ⟨q, ?_, hqd⟩
          rw [← hy₀_z0]
          exact fun hq_in => hq_not (hle_y0 hq_in)
    obtain ⟨b₁_y0, b₂_y0, hb₂_y0, hb_poly_y0⟩ := hBr1_y0

    obtain ⟨W₀, hW₀_le, hmW_le, hDiv_W₀, hResM_W₀⟩ :=
      weil_composed_valuation_divisorial_specialization
        K V M_tilde Z g_Z π_tilde F η_Z η_tilde W ψ_M mW
        y₀ V₀ hV₀ hy₀V₀ b₁_y0 b₂_y0
        hη_π hmW hη_ψM hy₀_cl hz₀_cl' hPy0_ne hb₂_y0
        (fun R _ _ ρ_B hρ t ht Q hQ => by
          have hpre_eq : (AlgebraicGeometry.Spec.preimage
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_B) ≫
                hV₀.fromSpec ≫ π_tilde ≫ g_Z)).hom = ρ_B.comp γ_V0 := by
            have hmap_eq : AlgebraicGeometry.Spec.map
                (AlgebraicGeometry.Spec.preimage
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_B) ≫
                    hV₀.fromSpec ≫ π_tilde ≫ g_Z)) =
                AlgebraicGeometry.Spec.map
                  (AlgebraicGeometry.Spec.preimage (hV₀.fromSpec ≫ π_tilde ≫ g_Z) ≫
                    CommRingCat.ofHom ρ_B) := by
              rw [AlgebraicGeometry.Spec.map_preimage, AlgebraicGeometry.Spec.map_comp,
                AlgebraicGeometry.Spec.map_preimage]
            exact congrArg CommRingCat.Hom.hom (AlgebraicGeometry.Spec.map_injective hmap_eq)
          rw [hpre_eq]
          exact hb_poly_y0 R ρ_B hρ t ht Q hQ)

    
    have hResX_W₀ : IsValResolvedOnMod V g_Z p_X η_X W₀ :=
      hRes_div W₀ hDiv_W₀ hResM_W₀
    obtain ⟨ψ_X0, mW₀, U_X0, hUX0, φ_X0, f_X0, hmW₀, hη_ψX0, hx0_mem, hφX0_spec, hfX0_poly⟩ :=
      hResX_W₀
    let i_W : ↥W₀ →+* ↥W := Subring.inclusion hW₀_le
    let ψ_X : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ X :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom i_W) ≫ ψ_X0
    have hη_ψX : AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype) ≫ ψ_X = η_X := by
      change AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype) ≫
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom i_W) ≫ ψ_X0) = η_X
      rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp]
      have hsub_eq : W.subtype.comp i_W = W₀.subtype := RingHom.ext fun _ => rfl
      rw [hsub_eq, hη_ψX0]
    have hmW_comap : Ideal.comap i_W (IsLocalRing.maximalIdeal ↥W) ≤
        IsLocalRing.maximalIdeal ↥W₀ := by
      intro x₀ hx₀_in
      obtain ⟨_, hx₀_m⟩ := hmW_le (i_W x₀) hx₀_in
      exact hx₀_m
    have hx_mem : ψ_X.base mW ∈ U_X0 := by
      by_contra hnot
      let q_W : PrimeSpectrum ↥W₀ := (AlgebraicGeometry.Spec.map (CommRingCat.ofHom i_W)).base mW
      let mW₀_ps : PrimeSpectrum ↥W₀ := mW₀
      have hle : q_W.asIdeal ≤ mW₀_ps.asIdeal := by
        change Ideal.comap i_W mW.asIdeal ≤ mW₀.asIdeal
        rw [hmW, hmW₀]
        exact hmW_comap
      have hmW₀_cl : mW₀_ps ∈ closure ({q_W} : Set (PrimeSpectrum ↥W₀)) := by
        rw [PrimeSpectrum.closure_singleton]; exact hle
      exact closure_minimal (Set.singleton_subset_iff.mpr hnot)
        (U_X0.isOpen.isClosed_compl.preimage ψ_X0.continuous) hmW₀_cl hx0_mem
    let φ_X : X.presheaf.obj (Opposite.op U_X0) ⟶ CommRingCat.of ↥W :=
      φ_X0 ≫ CommRingCat.ofHom i_W
    have hφX_spec : AlgebraicGeometry.Spec.map φ_X ≫ hUX0.fromSpec = ψ_X := by
      change AlgebraicGeometry.Spec.map (φ_X0 ≫ CommRingCat.ofHom i_W) ≫ hUX0.fromSpec = _
      rw [AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc, hφX0_spec]
    have hη_ψXpX : AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype) ≫ (ψ_X ≫ p_X) =
        η_Z := by
      rw [← CategoryTheory.Category.assoc, hη_ψX, hη_pX]
    let P'_s : Ideal ↥V := (g_Z.base ((ψ_X ≫ p_X).base mW)).asIdeal
    haveI : P'_s.IsPrime := (g_Z.base ((ψ_X ≫ p_X).base mW)).isPrime
    have hP's_ne : P'_s ≠ ⊥ := hNonzero (ψ_X ≫ p_X) mW hmW hη_ψXpX

    let B_X := ↑(X.presheaf.obj (Opposite.op U_X0))
    let γ_X : ↥V →+* B_X :=
      (AlgebraicGeometry.Spec.preimage (hUX0.fromSpec ≫ p_X ≫ g_Z)).hom
    let q_0 : Ideal B_X := Ideal.comap φ_X0.hom (IsLocalRing.maximalIdeal ↥W₀)
    let q_1 : Ideal B_X := Ideal.comap φ_X.hom (IsLocalRing.maximalIdeal ↥W)
    haveI : q_0.IsPrime := Ideal.IsPrime.comap φ_X0.hom
    haveI : q_1.IsPrime := Ideal.IsPrime.comap φ_X.hom
    have hq1_le_q0 : q_1 ≤ q_0 := fun b hb => hmW_comap hb
    have hcomp_γX : φ_X.hom.comp γ_X =
        (AlgebraicGeometry.Spec.preimage (ψ_X ≫ p_X ≫ g_Z)).hom := by
      have hmap_eq : AlgebraicGeometry.Spec.map
          (AlgebraicGeometry.Spec.preimage (hUX0.fromSpec ≫ p_X ≫ g_Z) ≫ φ_X) =
          AlgebraicGeometry.Spec.map
            (AlgebraicGeometry.Spec.preimage (ψ_X ≫ p_X ≫ g_Z)) := by
        rw [AlgebraicGeometry.Spec.map_comp,
          AlgebraicGeometry.Spec.map_preimage (hUX0.fromSpec ≫ p_X ≫ g_Z),
          ← CategoryTheory.Category.assoc, hφX_spec, AlgebraicGeometry.Spec.map_preimage]
      exact congrArg CommRingCat.Hom.hom (AlgebraicGeometry.Spec.map_injective hmap_eq)
    have hcomp_γX0 : φ_X0.hom.comp γ_X =
        (AlgebraicGeometry.Spec.preimage (ψ_X0 ≫ p_X ≫ g_Z)).hom := by
      have hmap_eq : AlgebraicGeometry.Spec.map
          (AlgebraicGeometry.Spec.preimage (hUX0.fromSpec ≫ p_X ≫ g_Z) ≫ φ_X0) =
          AlgebraicGeometry.Spec.map
            (AlgebraicGeometry.Spec.preimage (ψ_X0 ≫ p_X ≫ g_Z)) := by
        rw [AlgebraicGeometry.Spec.map_comp,
          AlgebraicGeometry.Spec.map_preimage (hUX0.fromSpec ≫ p_X ≫ g_Z),
          ← CategoryTheory.Category.assoc, hφX0_spec, AlgebraicGeometry.Spec.map_preimage]
      exact congrArg CommRingCat.Hom.hom (AlgebraicGeometry.Spec.map_injective hmap_eq)
    have hcomap_q1 : Ideal.comap γ_X q_1 = P'_s := by
      change Ideal.comap (φ_X.hom.comp γ_X) (IsLocalRing.maximalIdeal ↥W) = P'_s
      rw [hcomp_γX, ← hmW]
      have hbase : (AlgebraicGeometry.Spec.map
          (AlgebraicGeometry.Spec.preimage (ψ_X ≫ p_X ≫ g_Z))).base mW =
          g_Z.base ((ψ_X ≫ p_X).base mW) := by
        rw [AlgebraicGeometry.Spec.map_preimage]; rfl
      exact congrArg PrimeSpectrum.asIdeal hbase
    let P'_00 : Ideal ↥V := (g_Z.base ((ψ_X0 ≫ p_X).base mW₀)).asIdeal
    haveI : P'_00.IsPrime := (g_Z.base ((ψ_X0 ≫ p_X).base mW₀)).isPrime
    have hcomap_q0 : Ideal.comap γ_X q_0 = P'_00 := by
      change Ideal.comap (φ_X0.hom.comp γ_X) (IsLocalRing.maximalIdeal ↥W₀) = P'_00
      rw [hcomp_γX0, ← hmW₀]
      have hbase : (AlgebraicGeometry.Spec.map
          (AlgebraicGeometry.Spec.preimage (ψ_X0 ≫ p_X ≫ g_Z))).base mW₀ =
          g_Z.base ((ψ_X0 ≫ p_X).base mW₀) := by
        rw [AlgebraicGeometry.Spec.map_preimage]; rfl
      exact congrArg PrimeSpectrum.asIdeal hbase

    rcases hDicho P'_s (hAlgClosed P'_s hP's_ne) B_X q_1 γ_X hcomap_q1
      with ⟨b₁_X, b₂_X, hb₂_X, hb_poly_X⟩ | ⟨_hVal_X, _hle_X, hlin_X, _⟩
    · refine hBasicResX ψ_X hη_ψX U_X0 hUX0 hx_mem φ_X hφX_spec b₁_X b₂_X hb₂_X ?_
      intro t ht Q hQ
      rw [← hcomp_γX]
      exact hb_poly_X ↥W φ_X.hom rfl t ht Q hQ
    · exfalso
      rcases hlin_X (Ideal.Quotient.mk q_1 f_X0) with ⟨q, hq_eq⟩ | ⟨q, _, hq_mul⟩
      · have hsub_mem : f_X0 - γ_X q ∈ q_0 :=
          hq1_le_q0 (Ideal.Quotient.eq.mp hq_eq)
        let P_lin : Polynomial ↥V := Polynomial.X - Polynomial.C q
        have hcoeff1 : ∃ i : ℕ, P_lin.coeff i ∉ P'_00 := by
          refine ⟨1, ?_⟩
          have hc1 : P_lin.coeff 1 = 1 := by
            simp only [P_lin, Polynomial.coeff_sub, Polynomial.coeff_X_one,
              Polynomial.coeff_C_succ, sub_zero]
          rw [hc1]
          exact Ideal.IsPrime.one_notMem inferInstance
        have hev_mem : Polynomial.eval₂
            (AlgebraicGeometry.Spec.preimage (ψ_X0 ≫ p_X ≫ g_Z)).hom
            (φ_X0.hom f_X0) P_lin ∈ IsLocalRing.maximalIdeal ↥W₀ := by
          rw [← hcomp_γX0]
          simp only [P_lin, Polynomial.eval₂_sub, Polynomial.eval₂_X, Polynomial.eval₂_C,
            RingHom.comp_apply, ← map_sub]
          exact hsub_mem
        exact hfX0_poly P_lin hcoeff1 hev_mem
      · have hmul_mem : γ_X q * f_X0 - 1 ∈ q_0 := by
          have hmk : Ideal.Quotient.mk q_1 (γ_X q * f_X0) = Ideal.Quotient.mk q_1 1 := by
            rw [map_mul, map_one]; exact hq_mul
          exact hq1_le_q0 (Ideal.Quotient.eq.mp hmk)
        have hq_not_P00 : q ∉ P'_00 := by
          intro hq_in
          rw [← hcomap_q0] at hq_in
          have hqf : γ_X q * f_X0 ∈ q_0 := q_0.mul_mem_right f_X0 hq_in
          have hone : (1 : B_X) ∈ q_0 := by
            have hdiff := q_0.sub_mem hqf hmul_mem
            have h1_eq : γ_X q * f_X0 - (γ_X q * f_X0 - 1) = 1 := by ring
            rwa [h1_eq] at hdiff
          exact Ideal.IsPrime.one_notMem inferInstance hone
        let P_lin2 : Polynomial ↥V := Polynomial.C q * Polynomial.X - Polynomial.C 1
        have hcoeff1 : ∃ i : ℕ, P_lin2.coeff i ∉ P'_00 := by
          refine ⟨1, ?_⟩
          have hc1 : P_lin2.coeff 1 = q := by
            simp only [P_lin2, Polynomial.coeff_sub, Polynomial.coeff_C_mul,
              Polynomial.coeff_X_one, Polynomial.coeff_C_succ, mul_one, sub_zero]
          rw [hc1]
          exact hq_not_P00
        have hev_mem : Polynomial.eval₂
            (AlgebraicGeometry.Spec.preimage (ψ_X0 ≫ p_X ≫ g_Z)).hom
            (φ_X0.hom f_X0) P_lin2 ∈ IsLocalRing.maximalIdeal ↥W₀ := by
          rw [← hcomp_γX0]
          have hev_eq : Polynomial.eval₂ (φ_X0.hom.comp γ_X) (φ_X0.hom f_X0) P_lin2 =
              φ_X0.hom (γ_X q * f_X0 - 1) := by
            simp only [P_lin2, Polynomial.eval₂_sub, Polynomial.eval₂_mul, Polynomial.eval₂_C,
              Polynomial.eval₂_X, Polynomial.eval₂_one, RingHom.comp_apply, map_one, map_sub,
              map_mul]
          rw [hev_eq]
          exact hmul_mem
        exact hfX0_poly P_lin2 hcoeff1 hev_mem

theorem weil_noetherian_normal_curve_domination_of_val_resolved (K : Type u) [Field K]
    (m : ℕ) (V : ValuationSubring K) (hPkg : IsValuationRingAlgPackage m V)
    (hOpenη : AlgebraicGeometry.IsOpenImmersion
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (hIntCK : AlgebraicGeometry.IsIntegral C_K)
    (U_K : C_K.Opens) (hUK : Nonempty ↥U_K)
    (Z : AlgebraicGeometry.Scheme.{u})
    (g_Z : Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (ι_Z : U_K.toScheme ⟶ Z)
    (M : AlgebraicGeometry.Scheme.{u})
    (π : M ⟶ Z)
    (ι_M : U_K.toScheme ⟶ M)
    (hSS_Z : IsStrictlySemistableCurveOverValuation V g_Z)
    (hPb_Z : CategoryTheory.IsPullback ι_Z (U_K.ι ≫ p_K) g_Z
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (hInt_M : AlgebraicGeometry.IsIntegral M)
    (hProp_π : AlgebraicGeometry.IsProper π)
    (hιM_π : ι_M ≫ π = ι_Z)
    (hPb_M : CategoryTheory.IsPullback ι_M (U_K.ι ≫ p_K) (π ≫ g_Z)
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (F : Type u) [Field F]
    (η_Z : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ Z)
    (hFunc_Z : IsSchemeFunctionField Z F η_Z)
    (η_UK : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ U_K.toScheme)
    (hηUK_Z : η_UK ≫ ι_Z = η_Z)
    (hFunc_UK : IsSchemeFunctionField U_K.toScheme F η_UK)
    (φ_KF : K →+* F)
    (hφ_V : ∀ c : ↥V, φ_KF (V.subtype c) = (AlgebraicGeometry.Spec.preimage (η_Z ≫ g_Z)).hom c)
    (hTwoVar : ∀ (W : ValuationSubring F)
        (hV : ∀ c : ↥V, φ_KF (V.subtype c) ∈ W)
        (P : Ideal ↥V) [P.IsPrime],
      (∀ c : ↥V,
        ((⟨φ_KF (V.subtype c), hV c⟩ : ↥W) ∈ IsLocalRing.maximalIdeal ↥W ↔ c ∈ P)) →
      ¬ ∃ (t₁ t₂ : ↥W),
        ∀ (Q : MvPolynomial (Fin 2) ↥V),
          (∃ d : Fin 2 →₀ ℕ, Q.coeff d ∉ P) →
          MvPolynomial.eval₂ ((φ_KF.comp V.subtype).codRestrict W.toSubring hV) ![t₁, t₂] Q ∉
            IsLocalRing.maximalIdeal ↥W)
    (X : AlgebraicGeometry.Scheme.{u})
    (g_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (p_X : X ⟶ Z)
    (η_X : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ X)
    (ι_X : U_K.toScheme ⟶ X)
    (hSS_X : IsStrictlySemistableCurveOverValuation V g_X)
    (hNorm_X : IsAffineNormalScheme X)
    (hProp_pX : AlgebraicGeometry.IsProper p_X)
    (hComm_pX : p_X ≫ g_Z = g_X)
    (hη_pX : η_X ≫ p_X = η_Z)
    (hι_pX : ι_X ≫ p_X = ι_Z)
    (hPb_X : CategoryTheory.IsPullback ι_X (U_K.ι ≫ p_K) g_X
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (hTransfer : ∀ W : ValuationSubring F,
      IsValResolvedOnMod V g_Z π (η_UK ≫ ι_M) W →
      (∀ (ψ_Z : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ Z)
          (mW : AlgebraicGeometry.Spec (CommRingCat.of ↥W)),
        mW.asIdeal = IsLocalRing.maximalIdeal ↥W →
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype) ≫ ψ_Z = η_Z →
        (g_Z.base (ψ_Z.base mW)).asIdeal ≠ ⊥) →
      IsValResolvedOnMod V g_Z p_X η_X W) :
    ∃ (r_0 : X ⟶ M),
      AlgebraicGeometry.IsProper r_0 ∧
      AlgebraicGeometry.Surjective r_0 ∧
      r_0 ≫ π = p_X ∧
      ι_X ≫ r_0 = ι_M :=
by
  let U₀ : AlgebraicGeometry.Scheme.{u} := U_K.toScheme
  let η_V := AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)
  have hUK_sch_ne : Nonempty ↥U₀ := by
    obtain ⟨x, hx⟩ := hUK
    exact ⟨⟨x, hx⟩⟩
  have hIntU₀ : AlgebraicGeometry.IsIntegral U₀ :=
    @AlgebraicGeometry.isIntegral_of_isOpenImmersion U₀ C_K U_K.ι inferInstance hIntCK hUK_sch_ne
  have hOpen_ιM : AlgebraicGeometry.IsOpenImmersion ι_M :=
    CategoryTheory.MorphismProperty.of_isPullback
      (P := @AlgebraicGeometry.IsOpenImmersion.{u}) hPb_M.flip hOpenη
  have hOpen_ιX : AlgebraicGeometry.IsOpenImmersion ι_X :=
    CategoryTheory.MorphismProperty.of_isPullback
      (P := @AlgebraicGeometry.IsOpenImmersion.{u}) hPb_X.flip hOpenη
  
  have hηUK_X : η_UK ≫ ι_X = η_X := by
    have hηX_gX : η_X ≫ g_X = (η_UK ≫ U_K.ι ≫ p_K) ≫ η_V := by
      calc η_X ≫ g_X = η_X ≫ (p_X ≫ g_Z) := by rw [hComm_pX]
        _ = (η_X ≫ p_X) ≫ g_Z := by rw [CategoryTheory.Category.assoc]
        _ = η_Z ≫ g_Z := by rw [hη_pX]
        _ = (η_UK ≫ ι_Z) ≫ g_Z := by rw [hηUK_Z]
        _ = η_UK ≫ (ι_Z ≫ g_Z) := by rw [CategoryTheory.Category.assoc]
        _ = η_UK ≫ ((U_K.ι ≫ p_K) ≫ η_V) := by rw [hPb_Z.w]
        _ = (η_UK ≫ U_K.ι ≫ p_K) ≫ η_V := by simp only [CategoryTheory.Category.assoc]
    let l := hPb_X.lift η_X (η_UK ≫ U_K.ι ≫ p_K) hηX_gX
    have hl_eq : l = η_UK := by
      apply hPb_Z.hom_ext
      · calc l ≫ ι_Z = l ≫ (ι_X ≫ p_X) := by rw [hι_pX]
          _ = (l ≫ ι_X) ≫ p_X := by rw [CategoryTheory.Category.assoc]
          _ = η_X ≫ p_X := by rw [hPb_X.lift_fst]
          _ = η_Z := hη_pX
          _ = η_UK ≫ ι_Z := hηUK_Z.symm
      · exact hPb_X.lift_snd _ _ _
    calc η_UK ≫ ι_X = l ≫ ι_X := by rw [hl_eq]
      _ = η_X := hPb_X.lift_fst _ _ _
  
  have : AlgebraicGeometry.QuasiCompact η_UK :=
    AlgebraicGeometry.QuasiCompact.mk
      (fun _ _ _ => Set.Subsingleton.isCompact fun _ _ _ _ => Subsingleton.elim _ _)
  have hKer_UK : AlgebraicGeometry.Scheme.Hom.ker η_UK = ⊥ := by
    apply AlgebraicGeometry.Scheme.IdealSheafData.ext
    funext U
    rw [AlgebraicGeometry.Scheme.IdealSheafData.ideal_bot, Pi.bot_apply,
      AlgebraicGeometry.Scheme.Hom.ker_apply η_UK U, eq_bot_iff]
    intro a ha
    change (η_UK.app U.1).hom a = 0 at ha
    rw [Ideal.mem_bot]
    by_cases hUne : Nonempty ↥U.1
    · have hU2 : AlgebraicGeometry.IsAffineOpen U.1 := U.2
      have : IsDomain ↑(U₀.presheaf.obj (Opposite.op U.1)) :=
        @AlgebraicGeometry.IsIntegral.component_integral U₀ hIntU₀ U.1 hUne
      obtain ⟨φ_U, hFrac_U, hSpec_U⟩ := hFunc_UK U.1 hU2 hUne
      have hInj_φ : Function.Injective φ_U.hom := by
        letI : Algebra ↑(U₀.presheaf.obj (Opposite.op U.1)) F := φ_U.hom.toAlgebra
        exact @IsFractionRing.injective ↑(U₀.presheaf.obj (Opposite.op U.1)) _ F _ _ hFrac_U
      let S_F := AlgebraicGeometry.Spec (CommRingCat.of F)
      have h_top : AlgebraicGeometry.IsAffineOpen (⊤ : S_F.Opens) :=
        AlgebraicGeometry.isAffineOpen_top S_F
      have i_top : (⊤ : S_F.Opens) ≤ (TopologicalSpace.Opens.map η_UK.base).obj U.1 := by
        intro pt _
        change η_UK.base pt ∈ U.1
        rw [← hSpec_U]
