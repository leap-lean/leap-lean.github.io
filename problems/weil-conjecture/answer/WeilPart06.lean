    have hθ_comap : Ideal.comap θ_e m_P.asIdeal = (e.base ⟨z, hz⟩).asIdeal := by
      have hmap : AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ_e) = ψ_W ≫ e :=
        AlgebraicGeometry.Spec.map_preimage (ψ_W ≫ e)
      have hpt : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ_e)).base m_P =
          e.base ⟨z, hz⟩ := by
        rw [hmap]
        change e.base (ψ_W.base m_P) = e.base ⟨z, hz⟩
        rw [hψW_mP]
      calc
        Ideal.comap θ_e m_P.asIdeal =
            (PrimeSpectrum.comap (CommRingCat.ofHom θ_e).hom m_P).asIdeal := rfl
        _ = ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ_e)).base m_P).asIdeal := by
          rw [← AlgebraicGeometry.Spec.map_apply (CommRingCat.ofHom θ_e) m_P]
        _ = (e.base ⟨z, hz⟩).asIdeal := by rw [hpt]
    have hθ_C : ∀ c : ↥V,
        θ_e (Ideal.Quotient.mk _ (MvPolynomial.C c)) = algebraMap ↥V ↥R_P c := by
      intro c
      have hcomp_eq : (ψ_W ≫ e) ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V ↥R_P)) := by
        rw [CategoryTheory.Category.assoc, ← he_comm, ← CategoryTheory.Category.assoc,
          hψW_fac, hψ_g]
      have hpre := congrArg AlgebraicGeometry.Spec.preimage hcomp_eq
      rw [AlgebraicGeometry.Spec.preimage_comp, AlgebraicGeometry.Spec.preimage_map,
        AlgebraicGeometry.Spec.preimage_map] at hpre
      exact congrFun (congrArg DFunLike.coe (congrArg CommRingCat.Hom.hom hpre)) c
    let π_u : ↥R_P := θ_e (Ideal.Quotient.mk _ (MvPolynomial.X 0))
    let π_v : ↥R_P := θ_e (Ideal.Quotient.mk _ (MvPolynomial.X 1))
    have hπu_mem : π_u ∈ IsLocalRing.maximalIdeal ↥R_P := by
      rw [← hm_P]
      change Ideal.Quotient.mk _ (MvPolynomial.X 0) ∈ Ideal.comap θ_e m_P.asIdeal
      rw [hθ_comap]
      exact hOrigin 0
    have hπv_mem : π_v ∈ IsLocalRing.maximalIdeal ↥R_P := by
      rw [← hm_P]
      change Ideal.Quotient.mk _ (MvPolynomial.X 1) ∈ Ideal.comap θ_e m_P.asIdeal
      rw [hθ_comap]
      exact hOrigin 1
    have hπ_prod : π_u * π_v = algebraMap ↥V ↥R_P a := by
      have hsub_zero : θ_e (Ideal.Quotient.mk _
          (MvPolynomial.X (0 : Fin 2) * MvPolynomial.X 1 - MvPolynomial.C a)) = 0 := by
        have hmk0 : Ideal.Quotient.mk
            (Ideal.span {MvPolynomial.X (0 : Fin 2) * MvPolynomial.X 1 - MvPolynomial.C a})
            (MvPolynomial.X (0 : Fin 2) * MvPolynomial.X 1 - MvPolynomial.C a) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
        exact (congrArg θ_e hmk0).trans (map_zero θ_e)
      rw [map_sub, map_mul, map_sub, map_mul, hθ_C a] at hsub_zero
      exact sub_eq_zero.mp hsub_zero
    have ha_RP_ne : algebraMap ↥V ↥R_P a ≠ 0 := by
      intro h0
      apply ha_ne
      apply Subtype.ext
      have hK := congrArg (fun w : ↥R_P => (w : K)) h0
      rwa [hcoe_VP a] at hK
    have hπu_ne : π_u ≠ 0 := left_ne_zero_of_mul (hπ_prod.trans_ne ha_RP_ne)
    have ha_in_P : a ∈ P := by
      have hmem : algebraMap ↥V ↥R_P a ∈ IsLocalRing.maximalIdeal ↥R_P := by
        rw [← hπ_prod]
        exact Ideal.mul_mem_right π_v _ hπu_mem
      rw [← IsLocalization.AtPrime.under_maximalIdeal ↥R_P P]
      exact hmem
    have hP_ne_bot : (g_X.base z).asIdeal ≠ ⊥ := by
      rw [hgz_P]
      intro hbot
      rw [hbot, Ideal.mem_bot] at ha_in_P
      exact ha_ne ha_in_P
    obtain ⟨⟨π₁, s₁_sub⟩, h_surj⟩ := IsLocalization.surj P.primeCompl π_u
    let s₁ : ↥V := s₁_sub.1
    have hs₁_not_P : s₁ ∉ P := s₁_sub.2
    have h_surj' : π_u * algebraMap ↥V ↥R_P s₁ = algebraMap ↥V ↥R_P π₁ := h_surj
    let u_s : (↥R_P)ˣ := (IsLocalization.map_units ↥R_P s₁_sub).unit
    have hus_val : (u_s : ↥R_P) = algebraMap ↥V ↥R_P s₁ := rfl
    have hπ₁_RP_mem : algebraMap ↥V ↥R_P π₁ ∈ IsLocalRing.maximalIdeal ↥R_P := by
      rw [← h_surj']
      exact Ideal.mul_mem_right _ _ hπu_mem
    have hπ₁_in_P : π₁ ∈ P := by
      rw [← IsLocalization.AtPrime.under_maximalIdeal ↥R_P P]
      exact hπ₁_RP_mem
    have hπ₁_RP_ne : algebraMap ↥V ↥R_P π₁ ≠ 0 := by
      rw [← h_surj']
      exact mul_ne_zero hπu_ne u_s.ne_zero
    let q_v : ↥R_P := π_v * ↑(u_s⁻¹)
    have hqv_mem : q_v ∈ IsLocalRing.maximalIdeal ↥R_P :=
      Ideal.mul_mem_right _ _ hπv_mem
    have hπ₁_qv : algebraMap ↥V ↥R_P π₁ * q_v = algebraMap ↥V ↥R_P a := by
      calc
        algebraMap ↥V ↥R_P π₁ * q_v =
            (π_u * ↑u_s) * (π_v * ↑(u_s⁻¹)) := by rw [← h_surj', ← hus_val]
        _ = (π_u * π_v) * (↑u_s * ↑(u_s⁻¹)) := by ring
        _ = algebraMap ↥V ↥R_P a := by rw [hπ_prod, Units.mul_inv, mul_one]
    have hx'_mem_V : R_P.subtype q_v ∈ V := by
      by_contra hx_not
      rcases ValuationSubring.mem_or_inv_mem V (R_P.subtype q_v) with hx_in | hx_inv
      · exact hx_not hx_in
      · have hqv_K_ne : R_P.subtype q_v ≠ 0 := by
          intro h0
          apply hx_not
          rw [h0]
          exact V.zero_mem
        let w_RP : ↥R_P := ⟨(R_P.subtype q_v)⁻¹, ValuationSubring.le_ofPrime V P hx_inv⟩
        have hmul_one : q_v * w_RP = 1 := by
          apply Subtype.ext
          change R_P.subtype q_v * (R_P.subtype q_v)⁻¹ = 1
          exact mul_inv_cancel₀ hqv_K_ne
        have h1_mem : (1 : ↥R_P) ∈ IsLocalRing.maximalIdeal ↥R_P := by
          rw [← hmul_one]
          exact Ideal.mul_mem_right w_RP _ hqv_mem
        exact (IsLocalRing.maximalIdeal.isMaximal ↥R_P).ne_top
          ((Ideal.eq_top_iff_one _).mpr h1_mem)
    let a' : ↥V := ⟨R_P.subtype q_v, hx'_mem_V⟩
    have ha_fac : a = π₁ * a' := by
      apply Subtype.ext
      have hK := congrArg R_P.subtype hπ₁_qv
      rw [map_mul] at hK
      exact hK.symm
    obtain ⟨X', g_X', f_bl, U_iso, V_sm', _e_sm, hStep, hIso_U, hGen_U, hSm_to_U,
        _hEt_sm, _he_sm, hSm_V', hLift_nod⟩ :=
      hBl.2 X g_X z W hz a e s₁ π₁ a'
        hSS hCl_z hP_ne_bot ha_ne hEt he_comm ha_fac
        (by rwa [hgz_P]) (by rwa [hgz_P]) hOrigin
    refine ⟨X', g_X', f_bl, U_iso, V_sm', hStep, hIso_U, hGen_U, hSm_to_U, hSm_V', ?_⟩
    intro ψ' hψ'
    have hψ'_gX' : ψ' ≫ g_X' =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V ↥R_P)) := by
      rw [← hStep.2.2.1, ← CategoryTheory.Category.assoc, hψ', hψ_g]
    have hpre_gX' : (AlgebraicGeometry.Spec.preimage (ψ' ≫ g_X')).hom = algebraMap ↥V ↥R_P := by
      rw [hψ'_gX', AlgebraicGeometry.Spec.preimage_map]
      rfl
    apply hLift_nod ↥R_P ψ' m_P ψ_W (1 : ↥R_P) hm_P
    · rw [hψ']
    · rw [hψ', hψW_fac]
    · exact isUnit_one
    · rw [hpre_gX']
      exact hπ₁_RP_ne
    · rw [hpre_gX', mul_one]
      change θ_e (Ideal.Quotient.mk _ (MvPolynomial.C s₁ * MvPolynomial.X 0)) =
        algebraMap ↥V ↥R_P π₁
      rw [map_mul, map_mul, hθ_C s₁, mul_comm]
      exact h_surj'

  
  have hDisjLift : ∀ {A B : AlgebraicGeometry.Scheme.{u}} (f : A ⟶ B)
      (τ_A : ∀ j : Fin n, (S j).toScheme ⟶ A)
      (τ_B : ∀ j : Fin n, (S j).toScheme ⟶ B),
      (∀ j : Fin n, τ_A j ≫ f = τ_B j) →
      (_root_.Pairwise fun i j : Fin n =>
        Disjoint (Set.range (τ_B i).base) (Set.range (τ_B j).base)) →
      (_root_.Pairwise fun i j : Fin n =>
        Disjoint (Set.range (τ_A i).base) (Set.range (τ_A j).base)) := by
    intro A B f τ_A τ_B hfac hDisj i j hij
    refine Set.disjoint_left.mpr ?_
    rintro x ⟨bi, rfl⟩ ⟨bj, hbj⟩
    have hmem_i : f.base ((τ_A i).base bi) ∈ Set.range (τ_B i).base := by
      refine ⟨bi, ?_⟩
      change (τ_B i).base bi = (τ_A i ≫ f).base bi
      rw [hfac i]
    have hmem_j : f.base ((τ_A i).base bi) ∈ Set.range (τ_B j).base := by
      refine ⟨bj, ?_⟩
      have hfx : f.base ((τ_A j).base bj) = f.base ((τ_A i).base bi) := congrArg f.base hbj
      calc
        (τ_B j).base bj = (τ_A j ≫ f).base bj := by rw [hfac j]
        _ = f.base ((τ_A j).base bj) := rfl
        _ = f.base ((τ_A i).base bi) := hfx
    exact Set.disjoint_left.mp (hDisj hij) hmem_i hmem_j

  
  refine ⟨?_, ?_⟩
  · intro Z X g_Z g_X p_X ι_Z ι_X τ_Z hProp_pX hp_g hι_p hPb_Z _hPb_X hτZ_g hCl_Z hDisj_Z
    have hLiftEach : ∀ j : Fin n,
        ∃ (τ' : (S j).toScheme ⟶ X),
          τ' ≫ p_X = τ_Z j ∧
          τ' ≫ g_X = (S j).ι ∧
          AlgebraicGeometry.IsClosedImmersion τ' :=
      fun j => hS1_lift (S j) U_K.toScheme Z X (U_K.ι ≫ p_K) g_Z g_X p_X ι_Z ι_X (τ_Z j)
        hProp_pX hp_g hι_p hPb_Z (hτZ_g j) (hCl_Z j)
    choose τ_X hτ_p hτ_g hCl_X using hLiftEach
    exact ⟨τ_X, hτ_p, hτ_g, hCl_X, hDisjLift p_X τ_X τ_Z hτ_p hDisj_Z⟩
  · intro X g_X τ_X ι_X j₀ hSS_X hPb_X hτX_g hCl_X hDisj_X hNotSm
    have hne_j0 : Nonempty ↥(S j₀) := by
      by_contra hEmp
      apply hNotSm
      intro b
      have hEmptySch : IsEmpty ↥(S j₀).toScheme := by
        change IsEmpty ↥(S j₀)
        exact not_nonempty_iff.mp hEmp
      exact IsEmpty.elim hEmptySch b
    obtain ⟨P, instPrimeP, α, m_P, hm_P, hCl_bm, hSpec_mP, hα_g⟩ := hS1_iso (S j₀) hne_j0
    let _ : P.IsPrime := instPrimeP
    let _ : Algebra ↥V ↥(V.ofPrime P) := ValuationSubring.ofPrimeAlgebra V P
    let ψ : AlgebraicGeometry.Spec (CommRingCat.of ↥(V.ofPrime P)) ⟶ X := α.hom ≫ τ_X j₀
    let d₀ : X := ψ.base m_P
    have hCl_d0 : IsClosed ({d₀} : Set X) := by
      have _ : AlgebraicGeometry.IsClosedImmersion (τ_X j₀) := hCl_X j₀
      have hd0_eq : ({d₀} : Set X) = (τ_X j₀).base '' ({α.hom.base m_P} : Set ↥(S j₀).toScheme) := by
        simp [d₀, ψ]
      rw [hd0_eq]
      exact (τ_X j₀).isClosedMap _ hCl_bm
    have hψ_g : ψ ≫ g_X =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V ↥(V.ofPrime P))) := by
      change (α.hom ≫ τ_X j₀) ≫ g_X = _
      rw [CategoryTheory.Category.assoc, hτX_g j₀, hα_g]
    have hNotSm_d0 : ¬ ∃ V_sm : X.Opens,
        d₀ ∈ V_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ g_X) := by
      rintro ⟨V_sm, hd0_V, hSm_V⟩
      apply hNotSm
      intro b
      let q := α.inv.base b
      have hspec : ψ.base q ⤳ d₀ := (hSpec_mP q).map ψ.continuous
      have hq_mem : ψ.base q ∈ V_sm := hspec.mem_open V_sm.isOpen hd0_V
      have hqb : ψ.base q = (τ_X j₀).base b := by
        change (α.inv ≫ α.hom ≫ τ_X j₀).base b = (τ_X j₀).base b
        rw [α.inv_hom_id_assoc]
      rw [hqb] at hq_mem
      exact ⟨V_sm, hq_mem, hSm_V⟩
    rcases hSS_X.2.2.2.2 d₀ with
      ⟨W, e, hz, hEt, he_comm⟩ | ⟨W, a, e, hz, ha_ne, hEt, he_comm⟩
    · exfalso
      exact hNotSm_d0 ⟨W, hz, hS3_poly X g_X W e hEt he_comm⟩
    · have hOrigin : ∀ i : Fin 2,
          Ideal.Quotient.mk _ (MvPolynomial.X i) ∈ (e.base ⟨d₀, hz⟩).asIdeal := by
        by_contra hNotOrig
        obtain ⟨V_sm, hd0_V, hSm_V⟩ := hS3_nod X g_X W d₀ hz a e hEt he_comm hNotOrig
        exact hNotSm_d0 ⟨V_sm, hd0_V, hSm_V⟩
      obtain ⟨X', g_X', f_bl, U_iso, V_sm', hStep, hIso_U, hGen_U, hSm_to_U, hSm_V', hRange_V'⟩ :=
        hS4 X g_X hSS_X P ψ m_P W hz a e hm_P hψ_g hCl_d0 ha_ne hEt he_comm hOrigin
      have hProp_fbl : AlgebraicGeometry.IsProper f_bl := hStep.2.1
      have hf_g : f_bl ≫ g_X = g_X' := hStep.2.2.1
      obtain ⟨hPb_trans, hSm_trans⟩ := hS2 X X' g_X g_X' f_bl U_iso hf_g hIso_U
      obtain ⟨ι_X', hι_fbl, hPb_X'⟩ :=
        hPb_trans hGen_U U_K.toScheme (U_K.ι ≫ p_K) ι_X hPb_X
      have hLiftEach' : ∀ j : Fin n,
          ∃ (τ' : (S j).toScheme ⟶ X'),
            τ' ≫ f_bl = τ_X j ∧
            τ' ≫ g_X' = (S j).ι ∧
            AlgebraicGeometry.IsClosedImmersion τ' :=
        fun j => hS1_lift (S j) U_K.toScheme X X' (U_K.ι ≫ p_K) g_X g_X' f_bl ι_X ι_X' (τ_X j)
          hProp_fbl hf_g hι_fbl hPb_X (hτX_g j) (hCl_X j)
      choose τ_X' hτ_fbl hτ_gX' hCl_X' using hLiftEach'
      refine ⟨X', g_X', f_bl, τ_X', ι_X', hStep, hι_fbl, hPb_X', hτ_fbl, hτ_gX', hCl_X',
        hDisjLift f_bl τ_X' τ_X hτ_fbl hDisj_X, ?_, ?_⟩
      · intro b
        have hψ'_fac : (α.hom ≫ τ_X' j₀) ≫ f_bl = ψ := by
          rw [CategoryTheory.Category.assoc, hτ_fbl j₀]
        have hsub := hRange_V' (α.hom ≫ τ_X' j₀) hψ'_fac
        have hb_mem : (τ_X' j₀).base b ∈ V_sm' := by
          apply hsub
          refine ⟨α.inv.base b, ?_⟩
          change (α.inv ≫ α.hom ≫ τ_X' j₀).base b = (τ_X' j₀).base b
          rw [α.inv_hom_id_assoc]
        exact ⟨V_sm', hb_mem, hSm_V'⟩
      · intro j hSm_j b
        obtain ⟨V_sm, hb_V, hSm_V⟩ := hSm_j b
        have hfb_eq : f_bl.base ((τ_X' j).base b) = (τ_X j).base b := by
          change (τ_X' j ≫ f_bl).base b = (τ_X j).base b
          rw [hτ_fbl j]
        have hfb_V : f_bl.base ((τ_X' j).base b) ∈ V_sm := by
          rw [hfb_eq]; exact hb_V
        have hfb_U : f_bl.base ((τ_X' j).base b) ∈ U_iso :=
          hSm_to_U _ V_sm hfb_V hSm_V
        exact hSm_trans ((τ_X' j).base b) V_sm hfb_V hfb_U hSm_V

theorem weil_pointed_blowup_tower_domination (K : Type u) [Field K] [IsSepClosed K]
    (m : ℕ) (V : ValuationSubring K) (hPkg : IsValuationRingAlgPackage m V)
    (hBl : HasOverlapElementaryBlowupOracle V)
    (hNorm : ∀ (W : AlgebraicGeometry.Scheme.{u})
        (g_W : W ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V)),
      IsStrictlySemistableCurveOverValuation V g_W →
      IsOverlapAffineNormalScheme W)
    (hOpenη : AlgebraicGeometry.IsOpenImmersion
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (hIntCK : AlgebraicGeometry.IsIntegral C_K)
    (hSmCK : AlgebraicGeometry.SmoothOfRelativeDimension 1 p_K)
    (U_K : C_K.Opens) (hUK : Nonempty ↥U_K)
    (n : ℕ) (S : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V)).Opens)
    (Z : AlgebraicGeometry.Scheme.{u})
    (g_Z : Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (τ_Z : ∀ j : Fin n, (S j).toScheme ⟶ Z)
    (ι_Z : U_K.toScheme ⟶ Z)
    (M : AlgebraicGeometry.Scheme.{u})
    (π : M ⟶ Z)
    (ι_M : U_K.toScheme ⟶ M)
    (hSS_Z : IsStrictlySemistableCurveOverValuation V g_Z)
    (hNoeth_Z : TopologicalSpace.NoetherianSpace ↥Z)
    (hPb_Z : CategoryTheory.IsPullback ι_Z (U_K.ι ≫ p_K) g_Z
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (hτZ_g : ∀ j : Fin n, τ_Z j ≫ g_Z = (S j).ι)
    (hCl_Z : ∀ j : Fin n, AlgebraicGeometry.IsClosedImmersion (τ_Z j))
    (hDisj_Z : _root_.Pairwise fun i j : Fin n =>
      Disjoint (Set.range (τ_Z i).base) (Set.range (τ_Z j).base))
    (hInt_M : AlgebraicGeometry.IsIntegral M)
    (hProp_π : AlgebraicGeometry.IsProper π)
    (hιM_π : ι_M ≫ π = ι_Z)
    (hPb_M : CategoryTheory.IsPullback ι_M (U_K.ι ≫ p_K) (π ≫ g_Z)
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype))) :
    ∃ (Z' : AlgebraicGeometry.Scheme.{u})
      (g_Z' : Z' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
      (p : Z' ⟶ Z)
      (r : Z' ⟶ M)
      (τ_Z' : ∀ j : Fin n, (S j).toScheme ⟶ Z')
      (ι_Z' : U_K.toScheme ⟶ Z'),
      IsStrictlySemistableCurveOverValuation V g_Z' ∧
      TopologicalSpace.NoetherianSpace ↥Z' ∧
      IsElementaryBlowupTower V g_Z g_Z' p ∧
      AlgebraicGeometry.IsProper r ∧
      AlgebraicGeometry.Surjective r ∧
      r ≫ π = p ∧
      ι_Z' ≫ r = ι_M ∧
      CategoryTheory.IsPullback ι_Z' (U_K.ι ≫ p_K) g_Z'
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)) ∧
      (∀ j : Fin n, τ_Z' j ≫ p = τ_Z j) ∧
      (∀ j : Fin n, τ_Z' j ≫ g_Z' = (S j).ι) ∧
      (∀ j : Fin n, AlgebraicGeometry.IsClosedImmersion (τ_Z' j)) ∧
      (_root_.Pairwise fun i j : Fin n =>
        Disjoint (Set.range (τ_Z' i).base) (Set.range (τ_Z' j).base)) ∧
      (∀ (j : Fin n) (b : (S j).toScheme),
        ∃ V_sm : Z'.Opens,
          (τ_Z' j).base b ∈ V_sm ∧
          AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ g_Z')) :=
by
  
  obtain ⟨_hOpenη', _hAffNorm, hFuncEx⟩ :=
    weil_strictlySemistable_isAffineNormal_and_funcField K m V hPkg
  obtain ⟨F, instFieldF, η_Z, hFunc_Z⟩ := hFuncEx Z g_Z hSS_Z
  let _ : Field F := instFieldF
  obtain ⟨hAff_proj, c_proj, t_proj, hCoord_proj, hBase_proj⟩ :=
    weil_commRing_projectiveSpace_chart_and_baseChange_pkg
  obtain ⟨hNoethOfProper,
      ⟨η_UK, φ_KF, M_proj, M_tilde, π_tilde, ι_proj, η_tilde, hComm_proj, r_val, W_list,
        hηUK_Z, hFunc_UK, _hFunc_M, hφ_V, ⟨hEssFT, hTrdeg⟩,
        hInt_Mtilde, hProp_πtilde, hη_πtilde, hFunc_Mtilde, hCl_proj,
        hValM_to_Mtilde, hW_div, hW_exhaust⟩⟩ :=
    weil_noetherian_segre_bridge_and_gammaZero_finiteness
      K m V hPkg hOpenη C_K p_K hIntCK hSmCK U_K hUK
      Z g_Z ι_Z M π ι_M hSS_Z hNoeth_Z hPb_Z hInt_M hProp_π hιM_π hPb_M
      F η_Z hFunc_Z hAff_proj c_proj t_proj hCoord_proj
      (fun φ hAlg =>
        (weil_gauss_divisorial_valuation_finiteness_and_trdeg_bound
          K V F φ hAlg.1 hAlg.2).1)
  have hTwoVar :=
    (weil_gauss_divisorial_valuation_finiteness_and_trdeg_bound
      K V F φ_KF hEssFT hTrdeg).2

  
  let S_V : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of ↥V)
  let HasStrictBlowupTower :
      ∀ {X : AlgebraicGeometry.Scheme.{u}}
        (g_X : X ⟶ S_V)
        (p_X : X ⟶ Z), Prop :=
    fun {X} g_X p_X =>
      ∃ (N : ℕ)
        (Cseq : Fin (N + 1) → AlgebraicGeometry.Scheme.{u})
        (gseq : ∀ i : Fin (N + 1), Cseq i ⟶ S_V)
        (fstep : ∀ i : Fin N, Cseq i.succ ⟶ Cseq i.castSucc)
        (ptow : ∀ i : Fin (N + 1), Cseq i ⟶ Z)
        (h0 : Cseq 0 = Z)
        (hN : X = Cseq (Fin.last N)),
        CategoryTheory.eqToHom h0 = ptow 0 ∧
        CategoryTheory.eqToHom h0 ≫ g_Z = gseq 0 ∧
        (∀ i : Fin N,
          IsSingleElementaryBlowupStep V (gseq i.castSucc) (gseq i.succ) (fstep i) ∧
          ptow i.succ = fstep i ≫ ptow i.castSucc) ∧
        CategoryTheory.eqToHom hN ≫ gseq (Fin.last N) = g_X ∧
        CategoryTheory.eqToHom hN ≫ ptow (Fin.last N) = p_X

  have hTowerZero : HasStrictBlowupTower g_Z (𝟙 Z) :=
    ⟨0, fun _ => Z, fun _ => g_Z, fun i => Fin.elim0 i, fun _ => 𝟙 Z,
      rfl, rfl, rfl, CategoryTheory.Category.id_comp g_Z,
      fun i => Fin.elim0 i,
      CategoryTheory.Category.id_comp g_Z,
      CategoryTheory.Category.id_comp (𝟙 Z)⟩

  have hTowerToElem : ∀ {X : AlgebraicGeometry.Scheme.{u}}
      {g_X : X ⟶ S_V} {p_X : X ⟶ Z},
      HasStrictBlowupTower g_X p_X →
      IsElementaryBlowupTower V g_Z g_X p_X := by
    intro X g_X p_X ⟨N, Cseq, gseq, fstep, ptow, h0, hN, hptow0, hgseq0, hsteps, hgseqN, hptowN⟩
    exact ⟨N, Cseq, gseq, fstep, ptow,
      CategoryTheory.eqToIso h0, CategoryTheory.eqToIso hN,
      hptow0, hgseq0, hsteps, hgseqN, hptowN⟩

  have hStepCast : ∀ {A₁ B₁ A₂ B₂ : AlgebraicGeometry.Scheme.{u}}
      (hA : A₁ = A₂) (hB : B₁ = B₂)
      (gA : A₂ ⟶ S_V) (gB : B₂ ⟶ S_V) (f : B₂ ⟶ A₂),
      IsSingleElementaryBlowupStep V gA gB f →
      IsSingleElementaryBlowupStep V
        (CategoryTheory.eqToHom hA ≫ gA)
        (CategoryTheory.eqToHom hB ≫ gB)
        (CategoryTheory.eqToHom hB ≫ f ≫ CategoryTheory.eqToHom hA.symm) := by
    rintro A₁ B₁ _ _ rfl rfl gA gB f h
    simpa using h

  have hTowerStep : ∀ {X X' : AlgebraicGeometry.Scheme.{u}}
      {g_X : X ⟶ S_V} {g_X' : X' ⟶ S_V}
      {p_X : X ⟶ Z} {f_bl : X' ⟶ X},
      HasStrictBlowupTower g_X p_X →
      IsSingleElementaryBlowupStep V g_X g_X' f_bl →
      HasStrictBlowupTower g_X' (f_bl ≫ p_X) := by
    intro X X' g_X g_X' p_X f_bl hTow hStep
    obtain ⟨N, Cseq, gseq, fstep, ptow, h0, hN, hptow0, hgseq0, hsteps, hgseqN, hptowN⟩ := hTow
    subst hN
    simp only [CategoryTheory.eqToHom_refl, CategoryTheory.Category.id_comp] at hgseqN hptowN
    let Cseq' : Fin (N + 2) → AlgebraicGeometry.Scheme.{u} :=
      @Fin.snoc (N + 1) (fun _ => AlgebraicGeometry.Scheme.{u}) Cseq X'
    have hC_cast : ∀ j : Fin (N + 1), Cseq' j.castSucc = Cseq j :=
      fun j => @Fin.snoc_castSucc (N + 1) (fun _ => AlgebraicGeometry.Scheme.{u}) X' Cseq j
    have hC_last : Cseq' (Fin.last (N + 1)) = X' :=
      @Fin.snoc_last (N + 1) (fun _ => AlgebraicGeometry.Scheme.{u}) X' Cseq
    let gseq' : ∀ j : Fin (N + 2), Cseq' j ⟶ S_V :=
      @Fin.snoc (N + 1) (fun j => Cseq' j ⟶ S_V)
        (fun j => CategoryTheory.eqToHom (hC_cast j) ≫ gseq j)
        (CategoryTheory.eqToHom hC_last ≫ g_X')
    let ptow' : ∀ j : Fin (N + 2), Cseq' j ⟶ Z :=
      @Fin.snoc (N + 1) (fun j => Cseq' j ⟶ Z)
        (fun j => CategoryTheory.eqToHom (hC_cast j) ≫ ptow j)
        (CategoryTheory.eqToHom hC_last ≫ (f_bl ≫ p_X))
    let fstep' : ∀ i : Fin (N + 1), Cseq' i.succ ⟶ Cseq' i.castSucc :=
      @Fin.snoc N (fun i => Cseq' i.succ ⟶ Cseq' i.castSucc)
        (fun k =>
          CategoryTheory.eqToHom (hC_cast k.succ) ≫ fstep k ≫
            CategoryTheory.eqToHom (hC_cast k.castSucc).symm)
        (CategoryTheory.eqToHom hC_last ≫ f_bl ≫
          CategoryTheory.eqToHom (hC_cast (Fin.last N)).symm)
    have h0' : Cseq' 0 = Z := (hC_cast 0).trans h0
    have hN' : X' = Cseq' (Fin.last (N + 1)) := hC_last.symm
    refine ⟨N + 1, Cseq', gseq', fstep', ptow', h0', hN', ?_, ?_, ?_, ?_, ?_⟩
    · change CategoryTheory.eqToHom h0' = ptow' (0 : Fin (N + 1)).castSucc
      rw [show ptow' (0 : Fin (N + 1)).castSucc =
          CategoryTheory.eqToHom (hC_cast 0) ≫ ptow 0 from
        @Fin.snoc_castSucc (N + 1) (fun j => Cseq' j ⟶ Z) _ _ 0]
      rw [← hptow0, CategoryTheory.eqToHom_trans]
      rfl
    · change CategoryTheory.eqToHom h0' ≫ g_Z = gseq' (0 : Fin (N + 1)).castSucc
      rw [show gseq' (0 : Fin (N + 1)).castSucc =
          CategoryTheory.eqToHom (hC_cast 0) ≫ gseq 0 from
        @Fin.snoc_castSucc (N + 1) (fun j => Cseq' j ⟶ S_V) _ _ 0]
      rw [← hgseq0, CategoryTheory.eqToHom_trans_assoc]
      rfl
    · intro i
      induction i using Fin.lastCases with
      | last =>
        have hf_last : fstep' (Fin.last N) =
            CategoryTheory.eqToHom hC_last ≫ f_bl ≫
              CategoryTheory.eqToHom (hC_cast (Fin.last N)).symm :=
          @Fin.snoc_last N (fun i => Cseq' i.succ ⟶ Cseq' i.castSucc) _ _
        have hg_cast : gseq' (Fin.last N).castSucc =
            CategoryTheory.eqToHom (hC_cast (Fin.last N)) ≫ g_X := by
          rw [show gseq' (Fin.last N).castSucc =
              CategoryTheory.eqToHom (hC_cast (Fin.last N)) ≫ gseq (Fin.last N) from
            @Fin.snoc_castSucc (N + 1) (fun j => Cseq' j ⟶ S_V) _ _ (Fin.last N), hgseqN]
        have hg_last : gseq' (Fin.last N).succ =
            CategoryTheory.eqToHom hC_last ≫ g_X' :=
          @Fin.snoc_last (N + 1) (fun j => Cseq' j ⟶ S_V) _ _
        have hp_cast : ptow' (Fin.last N).castSucc =
            CategoryTheory.eqToHom (hC_cast (Fin.last N)) ≫ p_X := by
          rw [show ptow' (Fin.last N).castSucc =
              CategoryTheory.eqToHom (hC_cast (Fin.last N)) ≫ ptow (Fin.last N) from
            @Fin.snoc_castSucc (N + 1) (fun j => Cseq' j ⟶ Z) _ _ (Fin.last N), hptowN]
        have hp_last : ptow' (Fin.last N).succ =
            CategoryTheory.eqToHom hC_last ≫ (f_bl ≫ p_X) :=
          @Fin.snoc_last (N + 1) (fun j => Cseq' j ⟶ Z) _ _
        refine ⟨?_, ?_⟩
        · rw [hg_cast, hg_last, hf_last]
          exact hStepCast (hC_cast (Fin.last N)) hC_last g_X g_X' f_bl hStep
        · rw [hp_last, hf_last, hp_cast]
          simp only [CategoryTheory.Category.assoc, CategoryTheory.eqToHom_trans_assoc,
            CategoryTheory.eqToHom_refl, CategoryTheory.Category.id_comp]
      | cast k =>
        have hf_k : fstep' k.castSucc =
            CategoryTheory.eqToHom (hC_cast k.succ) ≫ fstep k ≫
              CategoryTheory.eqToHom (hC_cast k.castSucc).symm :=
          @Fin.snoc_castSucc N (fun i => Cseq' i.succ ⟶ Cseq' i.castSucc) _ _ k
        have hg_k1 : gseq' k.castSucc.castSucc =
            CategoryTheory.eqToHom (hC_cast k.castSucc) ≫ gseq k.castSucc :=
          @Fin.snoc_castSucc (N + 1) (fun j => Cseq' j ⟶ S_V) _ _ k.castSucc
        have hg_k2 : gseq' k.castSucc.succ =
            CategoryTheory.eqToHom (hC_cast k.succ) ≫ gseq k.succ :=
          @Fin.snoc_castSucc (N + 1) (fun j => Cseq' j ⟶ S_V) _ _ k.succ
        have hp_k1 : ptow' k.castSucc.castSucc =
            CategoryTheory.eqToHom (hC_cast k.castSucc) ≫ ptow k.castSucc :=
          @Fin.snoc_castSucc (N + 1) (fun j => Cseq' j ⟶ Z) _ _ k.castSucc
        have hp_k2 : ptow' k.castSucc.succ =
            CategoryTheory.eqToHom (hC_cast k.succ) ≫ ptow k.succ :=
          @Fin.snoc_castSucc (N + 1) (fun j => Cseq' j ⟶ Z) _ _ k.succ
        refine ⟨?_, ?_⟩
        · rw [hg_k1, hg_k2, hf_k]
          exact hStepCast (hC_cast k.castSucc) (hC_cast k.succ)
            (gseq k.castSucc) (gseq k.succ) (fstep k) (hsteps k).1
        · rw [hp_k2, (hsteps k).2, hf_k, hp_k1]
          simp only [CategoryTheory.Category.assoc, CategoryTheory.eqToHom_trans_assoc,
            CategoryTheory.eqToHom_refl, CategoryTheory.Category.id_comp]
    · rw [show gseq' (Fin.last (N + 1)) = CategoryTheory.eqToHom hC_last ≫ g_X' from
        @Fin.snoc_last (N + 1) (fun j => Cseq' j ⟶ S_V) _ _]
      simp only [CategoryTheory.eqToHom_trans_assoc, CategoryTheory.eqToHom_refl,
        CategoryTheory.Category.id_comp]
    · rw [show ptow' (Fin.last (N + 1)) = CategoryTheory.eqToHom hC_last ≫ (f_bl ≫ p_X) from
        @Fin.snoc_last (N + 1) (fun j => Cseq' j ⟶ Z) _ _]
      simp only [CategoryTheory.eqToHom_trans_assoc, CategoryTheory.eqToHom_refl,
        CategoryTheory.Category.id_comp]

  
  have hResolveLoop : ∀ k : ℕ, k ≤ r_val →
      ∃ (X : AlgebraicGeometry.Scheme.{u})
        (g_X : X ⟶ S_V)
        (p_X : X ⟶ Z)
        (η_X : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ X)
        (ι_X : U_K.toScheme ⟶ X),
        IsStrictlySemistableCurveOverValuation V g_X ∧
        HasStrictBlowupTower g_X p_X ∧
        AlgebraicGeometry.IsProper p_X ∧
        p_X ≫ g_Z = g_X ∧
        η_X ≫ p_X = η_Z ∧
        ι_X ≫ p_X = ι_Z ∧
        CategoryTheory.IsPullback ι_X (U_K.ι ≫ p_K) g_X
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)) ∧
        (∀ i : Fin r_val, i.1 < k → IsValResolvedOnMod V g_Z p_X η_X (W_list i)) := by
    intro k
    induction k with
    | zero =>
      intro _
      refine ⟨Z, g_Z, 𝟙 Z, η_Z, ι_Z, hSS_Z, hTowerZero, inferInstance,
        CategoryTheory.Category.id_comp g_Z,
        CategoryTheory.Category.comp_id η_Z,
        CategoryTheory.Category.comp_id ι_Z,
        hPb_Z, ?_⟩
      intro i hi
      omega
    | succ k ih =>
      intro hk
      obtain ⟨X, g_X, p_X, η_X, ι_X, hSS_X, hTow_X, hProp_pX, hComm_pX,
          hη_pX, hι_pX, hPb_X, hRes_prev⟩ :=
        ih (Nat.le_of_succ_le hk)
      by_cases hAlready : IsValResolvedOnMod V g_Z p_X η_X (W_list ⟨k, hk⟩)
      · refine ⟨X, g_X, p_X, η_X, ι_X, hSS_X, hTow_X, hProp_pX, hComm_pX,
            hη_pX, hι_pX, hPb_X, ?_⟩
        intro i hi
        rcases Nat.lt_succ_iff_lt_or_eq.mp hi with hlt | heq
        · exact hRes_prev i hlt
        · have hi_eq : i = ⟨k, hk⟩ := Fin.ext heq
          rwa [hi_eq]
      · obtain ⟨X', g_X', f_step, η_X', ι_X', hSS_X', hProp_step, hComm_step,
            hη_step, hι_step, hPb_X', hRes_k, hRes_pres, hStepDecomp⟩ :=
          weil_overlap_single_valuation_blowup_tower_step
            K m V hPkg hBl hOpenη C_K p_K U_K Z g_Z hSS_Z F η_Z hFunc_Z
            X g_X p_X η_X ι_X (W_list ⟨k, hk⟩)
            hSS_X hProp_pX hComm_pX hη_pX hPb_X (hW_div ⟨k, hk⟩) hAlready
        have hTow_X' : HasStrictBlowupTower g_X' (f_step ≫ p_X) := by
          rcases hStepDecomp with hOne | ⟨X₁, g₁, f₁, f₂, hf_eq, hStep₁, hStep₂⟩
          · exact hTowerStep hTow_X hOne
          · rw [hf_eq, CategoryTheory.Category.assoc]
            exact hTowerStep (hTowerStep hTow_X hStep₁) hStep₂
        have hProp_comp : AlgebraicGeometry.IsProper (f_step ≫ p_X) :=
          @AlgebraicGeometry.IsProper.instCompScheme _ _ _ f_step p_X hProp_step hProp_pX
        refine ⟨X', g_X', f_step ≫ p_X, η_X', ι_X', hSS_X', hTow_X', hProp_comp,
            ?_, ?_, ?_, hPb_X', ?_⟩
        · rw [CategoryTheory.Category.assoc, hComm_pX, hComm_step]
        · rw [← CategoryTheory.Category.assoc, hη_step, hη_pX]
        · rw [← CategoryTheory.Category.assoc, hι_step, hι_pX]
        · intro i hi
          rcases Nat.lt_succ_iff_lt_or_eq.mp hi with hlt | heq
          · exact hRes_pres (W_list i) (hRes_prev i hlt)
          · have hi_eq : i = ⟨k, hk⟩ := Fin.ext heq
            rwa [hi_eq]

  obtain ⟨Z_0, g_0, p_0, η_0, ι_0, hSS_0, hTow_0, hProp_0, hComm_0, hη_0, hι_0, hPb_0, hRes_all⟩ :=
    hResolveLoop r_val (le_refl r_val)

  
  have hRes_div0 : ∀ W₀ : ValuationSubring F,
      IsDivisorialClosedVal V g_Z η_Z W₀ →
      IsValResolvedOnMod V g_Z π_tilde η_tilde W₀ →
      IsValResolvedOnMod V g_Z p_0 η_0 W₀ := by
    intro W₀ hDiv₀ hResM₀
    obtain ⟨i, rfl⟩ := hW_exhaust W₀ hDiv₀ hResM₀
    exact hRes_all i i.isLt

  have hTransfer_0 : ∀ W : ValuationSubring F,
      IsValResolvedOnMod V g_Z π (η_UK ≫ ι_M) W →
      (∀ (ψ_Z : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ Z)
          (mW : AlgebraicGeometry.Spec (CommRingCat.of ↥W)),
        mW.asIdeal = IsLocalRing.maximalIdeal ↥W →
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype) ≫ ψ_Z = η_Z →
        (g_Z.base (ψ_Z.base mW)).asIdeal ≠ ⊥) →
      IsValResolvedOnMod V g_Z p_0 η_0 W := by
    intro W hRes_M hNonzero
    have hRes_Mtilde : IsValResolvedOnMod V g_Z π_tilde η_tilde W :=
      hValM_to_Mtilde W hRes_M hNonzero
    exact weil_noetherian_projective_specialization_and_propagation
      K m V hPkg Z g_Z hSS_Z hNoeth_Z F η_Z hFunc_Z
      M_proj M_tilde π_tilde ι_proj η_tilde
      hInt_Mtilde hProp_πtilde hη_πtilde hFunc_Mtilde hComm_proj hCl_proj
      hAff_proj c_proj t_proj hCoord_proj hBase_proj
      Z_0 g_0 p_0 η_0 hSS_0 hProp_0 hComm_0 hη_0 hRes_div0 W hRes_Mtilde hNonzero

  have hNorm_0 : IsAffineNormalScheme Z_0 := by
    intro U hU hne
    obtain ⟨hDom, hIC⟩ := hNorm Z_0 g_0 hSS_0 U hU hne
    exact ⟨hDom, hIC⟩

  obtain ⟨r_0, hProp_r0, hSurj_r0, hr0_π, hι0_r0⟩ :=
    weil_noetherian_normal_curve_domination_of_val_resolved
      K m V hPkg hOpenη C_K p_K hIntCK U_K hUK Z g_Z ι_Z M π ι_M
      hSS_Z hPb_Z hInt_M hProp_π hιM_π hPb_M
      F η_Z hFunc_Z η_UK hηUK_Z hFunc_UK φ_KF hφ_V hTwoVar
      Z_0 g_0 p_0 η_0 ι_0 hSS_0 hNorm_0
      hProp_0 hComm_0 hη_0 hι_0 hPb_0 hTransfer_0

  
  obtain ⟨hSecLift, hSecSmoothStep⟩ :=
    weil_overlap_open_section_lifting_and_nodal_smoothing
      K m V hPkg hBl hOpenη C_K p_K hSmCK U_K n S

  obtain ⟨τ_0, hτ0_p0, hτ0_g0, hCl_0, hDisj_0⟩ :=
    hSecLift Z Z_0 g_Z g_0 p_0 ι_Z ι_0 τ_Z
      hProp_0 hComm_0 hι_0 hPb_Z hPb_0 hτZ_g hCl_Z hDisj_Z

  have hSmoothLoop : ∀ k : ℕ, k ≤ n →
      ∃ (X : AlgebraicGeometry.Scheme.{u})
        (g_X : X ⟶ S_V)
        (p_X : X ⟶ Z)
        (r_X : X ⟶ M)
        (τ_X : ∀ j : Fin n, (S j).toScheme ⟶ X)
        (ι_X : U_K.toScheme ⟶ X),
        IsStrictlySemistableCurveOverValuation V g_X ∧
        HasStrictBlowupTower g_X p_X ∧
        AlgebraicGeometry.IsProper p_X ∧
        p_X ≫ g_Z = g_X ∧
        AlgebraicGeometry.IsProper r_X ∧
        AlgebraicGeometry.Surjective r_X ∧
        r_X ≫ π = p_X ∧
        ι_X ≫ r_X = ι_M ∧
        CategoryTheory.IsPullback ι_X (U_K.ι ≫ p_K) g_X
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)) ∧
        (∀ j : Fin n, τ_X j ≫ p_X = τ_Z j) ∧
        (∀ j : Fin n, τ_X j ≫ g_X = (S j).ι) ∧
        (∀ j : Fin n, AlgebraicGeometry.IsClosedImmersion (τ_X j)) ∧
        (_root_.Pairwise fun i j : Fin n =>
          Disjoint (Set.range (τ_X i).base) (Set.range (τ_X j).base)) ∧
        (∀ j : Fin n, j.1 < k →
          ∀ b : (S j).toScheme,
            ∃ V_sm : X.Opens,
              (τ_X j).base b ∈ V_sm ∧
              AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ g_X)) := by
    intro k
    induction k with
    | zero =>
      intro _
      refine ⟨Z_0, g_0, p_0, r_0, τ_0, ι_0,
        hSS_0, hTow_0, hProp_0, hComm_0, hProp_r0, hSurj_r0, hr0_π, hι0_r0,
        hPb_0, hτ0_p0, hτ0_g0, hCl_0, hDisj_0, ?_⟩
      intro j hj
      omega
    | succ k ih =>
      intro hk
      obtain ⟨X, g_X, p_X, r_X, τ_X, ι_X,
          hSS_X, hTow_X, hProp_pX, hComm_pX, hProp_rX, hSurj_rX, hrX_π, hιX_rX,
          hPb_X, hτX_pX, hτX_gX, hCl_X, hDisj_X, hSm_prev⟩ :=
        ih (Nat.le_of_succ_le hk)
      let j₀ : Fin n := ⟨k, hk⟩
      by_cases hSm_j0 :
          ∀ b : (S j₀).toScheme,
            ∃ V_sm : X.Opens,
              (τ_X j₀).base b ∈ V_sm ∧
              AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ g_X)
      · refine ⟨X, g_X, p_X, r_X, τ_X, ι_X,
            hSS_X, hTow_X, hProp_pX, hComm_pX, hProp_rX, hSurj_rX, hrX_π, hιX_rX,
            hPb_X, hτX_pX, hτX_gX, hCl_X, hDisj_X, ?_⟩
        intro j hj
        rcases Nat.lt_succ_iff_lt_or_eq.mp hj with hlt | heq
        · exact hSm_prev j hlt
        · have hj_eq : j = j₀ := Fin.ext heq
          rwa [hj_eq]
      · obtain ⟨X', g_X', f_bl, τ_X', ι_X',
            hStep_bl, hι_fbl, hPb_X', hτ_fbl, hτ_gX', hCl_X', hDisj_X', hSm_new, hSm_pres⟩ :=
          hSecSmoothStep X g_X τ_X ι_X j₀
            hSS_X hPb_X hτX_gX hCl_X hDisj_X hSm_j0
        have hSS_X' : IsStrictlySemistableCurveOverValuation V g_X' := hStep_bl.1
        have hProp_fbl : AlgebraicGeometry.IsProper f_bl := hStep_bl.2.1
        have hfbl_g : f_bl ≫ g_X = g_X' := hStep_bl.2.2.1
        have hSurj_fbl : AlgebraicGeometry.Surjective f_bl :=
          ⟨fun x => (hStep_bl.2.2.2.1 x).1⟩
        have hTow_X' : HasStrictBlowupTower g_X' (f_bl ≫ p_X) :=
          hTowerStep hTow_X hStep_bl
        have hProp_pX' : AlgebraicGeometry.IsProper (f_bl ≫ p_X) :=
          @AlgebraicGeometry.IsProper.instCompScheme _ _ _ f_bl p_X hProp_fbl hProp_pX
        have hProp_rX' : AlgebraicGeometry.IsProper (f_bl ≫ r_X) :=
          @AlgebraicGeometry.IsProper.instCompScheme _ _ _ f_bl r_X hProp_fbl hProp_rX
        have hSurj_rX' : AlgebraicGeometry.Surjective (f_bl ≫ r_X) :=
          @AlgebraicGeometry.instSurjectiveCompScheme _ _ _ f_bl r_X hSurj_fbl hSurj_rX
        refine ⟨X', g_X', f_bl ≫ p_X, f_bl ≫ r_X, τ_X', ι_X',
            hSS_X', hTow_X', hProp_pX', ?_, hProp_rX', hSurj_rX', ?_, ?_,
            hPb_X', ?_, hτ_gX', hCl_X', hDisj_X', ?_⟩
        · rw [CategoryTheory.Category.assoc, hComm_pX, hfbl_g]
        · rw [CategoryTheory.Category.assoc, hrX_π]
        · rw [← CategoryTheory.Category.assoc, hι_fbl, hιX_rX]
        · intro j
          rw [← CategoryTheory.Category.assoc, hτ_fbl j, hτX_pX j]
        · intro j hj
          rcases Nat.lt_succ_iff_lt_or_eq.mp hj with hlt | heq
          · exact hSm_pres j (hSm_prev j hlt)
          · have hj_eq : j = j₀ := Fin.ext heq
            rwa [hj_eq]

  obtain ⟨Z', g_Z', p, r, τ_Z', ι_Z',
      hSS_Z', hTow_Z', hProp_p, _hp_gZ, hProp_r, hSurj_r, hr_π, hι_r,
      hPb_Z', hτ_p, hτ_g, hCl_Z', hDisj_Z', hSm_all⟩ :=
    hSmoothLoop n (le_refl n)

  refine ⟨Z', g_Z', p, r, τ_Z', ι_Z',
    hSS_Z',
    hNoethOfProper Z' p hProp_p,
    hTowerToElem hTow_Z',
    hProp_r, hSurj_r, hr_π, hι_r, hPb_Z',
    hτ_p, hτ_g, hCl_Z', hDisj_Z',
    fun j b => hSm_all j j.isLt b⟩

theorem weil_strictlySemistable_residueFiber_baseChange_and_chart_dichotomy (K : Type u) [Field K] (V : ValuationSubring K)
    (Q : Ideal ↥V) [Q.IsPrime]
    (W : AlgebraicGeometry.Scheme.{u})
    (g_W : W ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (hSS : IsStrictlySemistableCurveOverValuation V g_W)
    (hComp : CompactSpace ↥W) :
    let κ := Q.ResidueField
    let s_Q : AlgebraicGeometry.Spec (CommRingCat.of κ) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of ↥V) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V κ))
    let F_W := CategoryTheory.Limits.pullback g_W s_Q
    let fst_W := CategoryTheory.Limits.pullback.fst g_W s_Q
    let snd_W := CategoryTheory.Limits.pullback.snd g_W s_Q
    AlgebraicGeometry.IsPreimmersion fst_W ∧
    Set.range fst_W.base = {z : W | (g_W.base z).asIdeal = Q} ∧
    CompactSpace ↥F_W ∧
    TopologicalSpace.NoetherianSpace ↥F_W ∧
    (irreducibleComponents ↥F_W).Finite ∧
    AlgebraicGeometry.IsSeparated snd_W ∧
    (∀ w : ↥F_W,
      (∃ V_sm : W.Opens,
        fst_W.base w ∈ V_sm ∧
        AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ g_W)) →
      (∃ U_sm : F_W.Opens,
        w ∈ U_sm ∧
        AlgebraicGeometry.SmoothOfRelativeDimension 1 (U_sm.ι ≫ snd_W))) ∧
    (∀ w : ↥F_W,
      ((∃ V_sm : W.Opens,
          fst_W.base w ∈ V_sm ∧
          AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ g_W)) ∧
        ∃ (U₀ : F_W.Opens)
          (e_κ : U₀.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial κ))),
          w ∈ U₀ ∧
          AlgebraicGeometry.Etale e_κ ∧
          U₀.ι ≫ snd_W = e_κ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C)) ∨
      (∃ (U₀ : F_W.Opens) (hw : w ∈ U₀)
          (e_κ : U₀.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of
            (MvPolynomial (Fin 2) κ ⧸
              Ideal.span {MvPolynomial.X (0 : Fin 2) * MvPolynomial.X (1 : Fin 2)}))),
        AlgebraicGeometry.Etale e_κ ∧
        U₀.ι ≫ snd_W = e_κ ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) ∧
        ∀ i : Fin 2, Ideal.Quotient.mk _ (MvPolynomial.X i) ∈ (e_κ.base ⟨w, hw⟩).asIdeal)) :=
by
  intro κ s_Q F_W fst_W snd_W
  obtain ⟨_hIntW, _hFlatW, hSepW, hLfpW, hChartsW⟩ := hSS
  have : AlgebraicGeometry.IsSeparated g_W := hSepW
  have : AlgebraicGeometry.LocallyOfFinitePresentation g_W := hLfpW
  have : CompactSpace ↥W := hComp

  
  have hPre_sQ : AlgebraicGeometry.IsPreimmersion s_Q := by
    let s_loc : AlgebraicGeometry.Spec (CommRingCat.of (Localization.AtPrime Q)) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of ↥V) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V (Localization.AtPrime Q)))
    let s_res : AlgebraicGeometry.Spec (CommRingCat.of κ) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of (Localization.AtPrime Q)) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue (Localization.AtPrime Q)))
    have : AlgebraicGeometry.IsPreimmersion s_loc :=
      AlgebraicGeometry.IsPreimmersion.of_isLocalization Q.primeCompl
    have : AlgebraicGeometry.IsClosedImmersion s_res :=
      AlgebraicGeometry.IsClosedImmersion.spec_of_surjective
        (CommRingCat.ofHom (IsLocalRing.residue (Localization.AtPrime Q)))
        IsLocalRing.residue_surjective
    have hs_eq : s_Q = s_res ≫ s_loc := by
      have hhom : CommRingCat.ofHom (algebraMap ↥V κ) =
          CommRingCat.ofHom (algebraMap ↥V (Localization.AtPrime Q)) ≫
            CommRingCat.ofHom (IsLocalRing.residue (Localization.AtPrime Q)) := rfl
      change AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V κ)) = s_res ≫ s_loc
      rw [hhom, AlgebraicGeometry.Spec.map_comp]
    rw [hs_eq]
    infer_instance
  have : AlgebraicGeometry.IsPreimmersion s_Q := hPre_sQ
  have hPre_fst : AlgebraicGeometry.IsPreimmersion fst_W := inferInstance

  
  have hRange_fst : Set.range fst_W.base = {z : W | (g_W.base z).asIdeal = Q} := by
    let pt₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of κ)) := default
    have : pt₀.asIdeal.IsPrime := pt₀.isPrime
    have hpt₀_bot : pt₀.asIdeal = ⊥ := Ideal.eq_bot_of_prime pt₀.asIdeal
    have hsQ_pt₀ : (s_Q.base pt₀).asIdeal = Q := by
      rw [AlgebraicGeometry.Spec.map_apply]
      change Ideal.comap (algebraMap ↥V κ) pt₀.asIdeal = Q
      rw [hpt₀_bot, ← RingHom.ker_eq_comap_bot, Ideal.ker_algebraMap_residueField Q]
    have hRange_sQ : Set.range s_Q.base = {s_Q.base pt₀} := by
      ext y
      simp only [Set.mem_range, Set.mem_singleton_iff]
      constructor
      · rintro ⟨u, rfl⟩
        exact congrArg s_Q.base (Subsingleton.elim u pt₀)
      · rintro rfl
        exact ⟨pt₀, rfl⟩
    have hPbRange : Set.range fst_W.base = g_W.base ⁻¹' Set.range s_Q.base :=
      AlgebraicGeometry.Scheme.Pullback.range_fst g_W s_Q
    rw [hPbRange, hRange_sQ]
    ext z
    simp only [Set.mem_preimage, Set.mem_singleton_iff]
    change g_W.base z = s_Q.base pt₀ ↔ (g_W.base z).asIdeal = Q
    constructor
    · intro hz
      rw [hz, hsQ_pt₀]
    · intro hz
      exact PrimeSpectrum.ext (hz.trans hsQ_pt₀.symm)

  
  have hCompF : CompactSpace ↥F_W :=
    AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace fst_W
  have : AlgebraicGeometry.IsLocallyNoetherian F_W :=
    AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian snd_W
  have : AlgebraicGeometry.IsNoetherian F_W :=
    @AlgebraicGeometry.IsNoetherian.mk F_W ‹_› hCompF
  have hNoethF : TopologicalSpace.NoetherianSpace ↥F_W := inferInstance
  have hFinIrred : (irreducibleComponents ↥F_W).Finite :=
    TopologicalSpace.NoetherianSpace.finite_irreducibleComponents
  have hSepSnd : AlgebraicGeometry.IsSeparated snd_W := inferInstance

  
  have hSm_fwd : ∀ w : ↥F_W,
      (∃ V_sm : W.Opens,
        fst_W.base w ∈ V_sm ∧
        AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ g_W)) →
      (∃ U_sm : F_W.Opens,
        w ∈ U_sm ∧
        AlgebraicGeometry.SmoothOfRelativeDimension 1 (U_sm.ι ≫ snd_W)) := by
    intro w ⟨V_sm, hw_V, hSm_V⟩
    let U_sm : F_W.Opens := (TopologicalSpace.Opens.map fst_W.base).obj V_sm
    have hPb_sm : CategoryTheory.IsPullback (fst_W ∣_ V_sm) (U_sm.ι ≫ snd_W)
        (V_sm.ι ≫ g_W) s_Q :=
      CategoryTheory.IsPullback.paste_vert
        (AlgebraicGeometry.isPullback_morphismRestrict fst_W V_sm)
        (CategoryTheory.IsPullback.of_hasPullback g_W s_Q)
    exact ⟨U_sm, hw_V,
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (P := @AlgebraicGeometry.SmoothOfRelativeDimension 1) hPb_sm hSm_V⟩

  
  have poly_baseChange_and_smooth_of_commRing :
      ∀ (R L : Type u) [CommRing R] [CommRing L] [Algebra R L]
        (C₀ : AlgebraicGeometry.Scheme.{u})
        (g₀ : C₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
        (W₀ : C₀.Opens)
        (e₀ : W₀.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial R)))
        (_ : AlgebraicGeometry.Etale e₀)
        (_ : W₀.ι ≫ g₀ = e₀ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C))
        (wL : ↥(CategoryTheory.Limits.pullback g₀
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R L))))),
        (CategoryTheory.Limits.pullback.fst g₀
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R L)))).base wL ∈ W₀ →
        (∃ V_sm : C₀.Opens,
          (CategoryTheory.Limits.pullback.fst g₀
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R L)))).base wL ∈ V_sm ∧
          AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ g₀)) ∧
        (∃ (U₀ : (CategoryTheory.Limits.pullback g₀
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R L)))).Opens)
            (e_L : U₀.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial L))),
          wL ∈ U₀ ∧
          AlgebraicGeometry.Etale e_L ∧
          U₀.ι ≫ CategoryTheory.Limits.pullback.snd g₀
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R L))) =
            e_L ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C)) := by
    intro R L _ _ _ C₀ g₀ W₀ e₀ hEt_e₀ hcomm₀ wL hw₀
    have hCard1 : Nat.card (Fin 1) = 1 := by simp
    have hStdMv : Algebra.IsStandardSmoothOfRelativeDimension 1 R (MvPolynomial (Fin 1) R) := by
      have h := Algebra.IsStandardSmoothOfRelativeDimension.mvPolynomial R (Fin 1)
      rwa [hCard1] at h
    have hStdPoly : Algebra.IsStandardSmoothOfRelativeDimension 1 R (Polynomial R) :=
      Algebra.IsStandardSmoothOfRelativeDimension.of_algEquiv 1
        (MvPolynomial.uniqueAlgEquiv R (Fin 1))
    have hHomStd : (algebraMap R (Polynomial R)).IsStandardSmoothOfRelativeDimension 1 :=
      (RingHom.isStandardSmoothOfRelativeDimension_algebraMap 1).mpr hStdPoly
    have hHomLoc : RingHom.Locally (RingHom.IsStandardSmoothOfRelativeDimension 1)
        (Polynomial.C : R →+* Polynomial R) :=
      RingHom.locally_of (@RingHom.isStandardSmoothOfRelativeDimension_respectsIso 1)
        (algebraMap R (Polynomial R)) hHomStd
    have hSmSpecC : AlgebraicGeometry.SmoothOfRelativeDimension 1
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : R →+* Polynomial R))) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.SmoothOfRelativeDimension 1)).mpr hHomLoc
    have hSm0_e₀ : AlgebraicGeometry.SmoothOfRelativeDimension 0 e₀ :=
      (AlgebraicGeometry.Etale.iff_smoothOfRelativeDimension_zero e₀).mp hEt_e₀
    have hSm_comp : AlgebraicGeometry.SmoothOfRelativeDimension (0 + 1)
        (e₀ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : R →+* Polynomial R))) :=
      AlgebraicGeometry.smoothOfRelativeDimension_comp 0 1 e₀ _
    have hSm_W₀ : AlgebraicGeometry.SmoothOfRelativeDimension 1 (W₀.ι ≫ g₀) := by
      simpa [← hcomm₀] using hSm_comp
    refine ⟨⟨W₀, hw₀, hSm_W₀⟩, ?_⟩

    let α_poly : Polynomial R →ₐ[R] Polynomial L := Polynomial.aeval (Polynomial.X : Polynomial L)
    let α_L : L →ₐ[R] Polynomial L := IsScalarTower.toAlgHom R L (Polynomial L)
    let F_fwd : TensorProduct R (Polynomial R) L →ₐ[R] Polynomial L :=
      Algebra.TensorProduct.productMap α_poly α_L
    let β_poly : Polynomial L →+* TensorProduct R (Polynomial R) L :=
      Polynomial.eval₂RingHom
        ((Algebra.TensorProduct.includeRight : L →ₐ[R] TensorProduct R (Polynomial R) L) :
          L →+* TensorProduct R (Polynomial R) L)
        ((Polynomial.X : Polynomial R) ⊗ₜ[R] (1 : L))
    let F_inv : Polynomial L →ₐ[R] TensorProduct R (Polynomial R) L :=
      { β_poly with
        commutes' := fun r => by
          change β_poly (Polynomial.C (algebraMap R L r)) = _
          simp only [β_poly, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
          exact Algebra.TensorProduct.includeRight.commutes r }
    have h_fwd_inv : F_fwd.comp F_inv = AlgHom.id R (Polynomial L) := by
      apply AlgHom.coe_ringHom_injective
      apply Polynomial.ringHom_ext'
      · apply RingHom.ext
        intro c
        change F_fwd (β_poly (Polynomial.C c)) = Polynomial.C c
        simp only [β_poly, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
        change (Algebra.TensorProduct.productMap α_poly α_L)
          (Algebra.TensorProduct.includeRight c) = Polynomial.C c
        rw [Algebra.TensorProduct.includeRight_apply,
          Algebra.TensorProduct.productMap_apply_tmul, map_one, one_mul]
        rfl
      · change F_fwd (β_poly Polynomial.X) = Polynomial.X
        simp only [β_poly, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
        simp [F_fwd, α_poly]
    have h_inv_fwd : F_inv.comp F_fwd = AlgHom.id R (TensorProduct R (Polynomial R) L) := by
      apply Algebra.TensorProduct.ext
      · apply Polynomial.algHom_ext
        change F_inv (F_fwd ((Polynomial.X : Polynomial R) ⊗ₜ[R] (1 : L))) =
          (Polynomial.X : Polynomial R) ⊗ₜ[R] (1 : L)
        have h1 : F_fwd ((Polynomial.X : Polynomial R) ⊗ₜ[R] (1 : L)) = Polynomial.X := by
          simp [F_fwd, α_poly]
        rw [h1]
        change β_poly Polynomial.X = _
        simp only [β_poly, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
      · ext c
        change F_inv (F_fwd ((1 : Polynomial R) ⊗ₜ[R] c)) = (1 : Polynomial R) ⊗ₜ[R] c
        have h1 : F_fwd ((1 : Polynomial R) ⊗ₜ[R] c) = Polynomial.C c := by
          change (Algebra.TensorProduct.productMap α_poly α_L)
            ((1 : Polynomial R) ⊗ₜ[R] c) = Polynomial.C c
          rw [Algebra.TensorProduct.productMap_apply_tmul, map_one, one_mul]
          rfl
        rw [h1]
        change β_poly (Polynomial.C c) = _
        simp only [β_poly, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
        rfl
    let θ_poly : TensorProduct R (Polynomial R) L ≃ₐ[R] Polynomial L :=
      AlgEquiv.ofAlgHom F_fwd F_inv h_fwd_inv h_inv_fwd

    let s_alg := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R L))
    let fst₀ := CategoryTheory.Limits.pullback.fst g₀ s_alg
    let snd₀ := CategoryTheory.Limits.pullback.snd g₀ s_alg
    let U₀ : (CategoryTheory.Limits.pullback g₀ s_alg).Opens :=
      (TopologicalSpace.Opens.map fst₀.base).obj W₀
    let π_poly := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R (Polynomial R)))
    have hcomm₀' : W₀.ι ≫ g₀ = e₀ ≫ π_poly := hcomm₀
    have hPb_res : CategoryTheory.IsPullback (fst₀ ∣_ W₀) (U₀.ι ≫ snd₀) (W₀.ι ≫ g₀) s_alg :=
      CategoryTheory.IsPullback.paste_vert
        (AlgebraicGeometry.isPullback_morphismRestrict fst₀ W₀)
        (CategoryTheory.IsPullback.of_hasPullback g₀ s_alg)
    let e_pb : U₀.toScheme ⟶ CategoryTheory.Limits.pullback π_poly s_alg :=
      CategoryTheory.Limits.pullback.lift ((fst₀ ∣_ W₀) ≫ e₀) (U₀.ι ≫ snd₀)
        (by rw [CategoryTheory.Category.assoc, ← hcomm₀']; exact hPb_res.w)
    have hPb_top : CategoryTheory.IsPullback (fst₀ ∣_ W₀) e_pb e₀
        (CategoryTheory.Limits.pullback.fst π_poly s_alg) := by
      refine CategoryTheory.IsPullback.of_bot ?_
        (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm
        (CategoryTheory.IsPullback.of_hasPullback π_poly s_alg)
      rw [CategoryTheory.Limits.pullback.lift_snd, ← hcomm₀']
      exact hPb_res
    have : AlgebraicGeometry.Etale e_pb :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (P := @AlgebraicGeometry.Etale) hPb_top hEt_e₀
    let iso_θ := θ_poly.symm.toRingEquiv.toCommRingCatIso
    have : AlgebraicGeometry.IsOpenImmersion
        (AlgebraicGeometry.pullbackSpecIso R (Polynomial R) L).hom :=
      AlgebraicGeometry.IsOpenImmersion.of_isIso _
    have : AlgebraicGeometry.IsOpenImmersion (AlgebraicGeometry.Spec.map iso_θ.hom) :=
      AlgebraicGeometry.IsOpenImmersion.of_isIso _
    let e_L : U₀.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial L)) :=
      e_pb ≫ (AlgebraicGeometry.pullbackSpecIso R (Polynomial R) L).hom ≫
        AlgebraicGeometry.Spec.map iso_θ.hom
    have hEt_eL : AlgebraicGeometry.Etale e_L := inferInstance
    let incR_poly : L →+* TensorProduct R (Polynomial R) L :=
      (Algebra.TensorProduct.includeRight : L →ₐ[R] TensorProduct R (Polynomial R) L)
    have hRingC : CommRingCat.ofHom (Polynomial.C : L →+* Polynomial L) ≫ iso_θ.hom =
        CommRingCat.ofHom incR_poly := by
      ext c
      change β_poly (Polynomial.C c) = Algebra.TensorProduct.includeRight c
      simp only [β_poly, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
      rfl
    refine ⟨U₀, e_L, hw₀, hEt_eL, ?_⟩
    calc
      U₀.ι ≫ snd₀ = e_pb ≫ CategoryTheory.Limits.pullback.snd π_poly s_alg :=
        (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm
      _ = e_pb ≫ ((AlgebraicGeometry.pullbackSpecIso R (Polynomial R) L).hom ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom incR_poly)) := by
        rw [← AlgebraicGeometry.pullbackSpecIso_hom_snd R (Polynomial R) L]
      _ = e_pb ≫ (AlgebraicGeometry.pullbackSpecIso R (Polynomial R) L).hom ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C ≫ iso_θ.hom) := by
        rw [hRingC]
      _ = e_L ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) := by
        simp only [e_L, AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc]

  
  have laurent_poly_chart_of_commRing :
      ∀ (R : Type u) [CommRing R] (a₀ : R) (i₀ : Fin 2)
        (C₀ : AlgebraicGeometry.Scheme.{u})
        (g₀ : C₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
        (W₀ : C₀.Opens) (z₀ : C₀) (hz₀ : z₀ ∈ W₀)
        (e₀ : W₀.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of
          (MvPolynomial (Fin 2) R ⧸ Ideal.span
            {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a₀}))),
        AlgebraicGeometry.Etale e₀ →
        W₀.ι ≫ g₀ = e₀ ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) →
        Ideal.Quotient.mk _ (MvPolynomial.X i₀) ∉ (e₀.base ⟨z₀, hz₀⟩).asIdeal →
        ∃ (V_sm : C₀.Opens)
          (e_sm : V_sm.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial R))),
          z₀ ∈ V_sm ∧
          AlgebraicGeometry.Etale e_sm ∧
          V_sm.ι ≫ g₀ = e_sm ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) := by
    intro R _ a₀ i₀ C₀ g₀ W₀ z₀ hz₀ e₀ hEt_e₀ hcomm₀ hx_not_mem
    let I_R : Ideal (MvPolynomial (Fin 2) R) :=
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a₀}
    let A_R := MvPolynomial (Fin 2) R ⧸ I_R
    let xbar : Fin 2 → A_R := fun k => Ideal.Quotient.mk I_R (MvPolynomial.X k)
    have hxbar_mul : xbar 0 * xbar 1 = algebraMap R A_R a₀ := by
      have hmem : MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a₀ ∈ I_R :=
        Ideal.subset_span rfl
      have hzero : Ideal.Quotient.mk I_R
          (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a₀) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr hmem
      rw [map_sub, map_mul, sub_eq_zero] at hzero
      exact hzero
    let L_i := Localization.Away (xbar i₀)
    let L_T := Localization.Away (Polynomial.X : Polynomial R)
    let t : L_T := algebraMap (Polynomial R) L_T Polynomial.X
    let t_inv : L_T := IsLocalization.Away.invSelf (S := L_T) (Polynomial.X : Polynomial R)
    have ht_mul : t * t_inv = 1 :=
      IsLocalization.Away.mul_invSelf (S := L_T) (Polynomial.X : Polynomial R)
    have ht_unit : IsUnit t := ⟨⟨t, t_inv, ht_mul, by rw [mul_comm, ht_mul]⟩, rfl⟩
    let u : L_i := algebraMap A_R L_i (xbar i₀)
    let u_inv : L_i := IsLocalization.Away.invSelf (S := L_i) (xbar i₀)
    have hu_mul : u * u_inv = 1 := IsLocalization.Away.mul_invSelf (xbar i₀)
    have hu_unit : IsUnit u := ⟨⟨u, u_inv, hu_mul, by rw [mul_comm, hu_mul]⟩, rfl⟩

    let α_tilde : MvPolynomial (Fin 2) R →ₐ[R] L_T :=
      MvPolynomial.aeval (fun k : Fin 2 =>
        if k = i₀ then t else algebraMap R L_T a₀ * t_inv)
    have hα_rel : α_tilde (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a₀) = 0 := by
      rw [map_sub, map_mul, MvPolynomial.aeval_X, MvPolynomial.aeval_X, MvPolynomial.aeval_C]
      fin_cases i₀
      · simp only [Fin.isValue, ↓reduceIte, Fin.zero_eta]
        have h10 : (1 : Fin 2) ≠ 0 := by decide
        simp only [h10, ↓reduceIte]
        calc
          t * (algebraMap R L_T a₀ * t_inv) - algebraMap R L_T a₀
              = algebraMap R L_T a₀ * (t * t_inv) - algebraMap R L_T a₀ := by ring
          _ = 0 := by rw [ht_mul, mul_one, sub_self]
      · simp only [Fin.isValue, ↓reduceIte, Fin.mk_one]
        have h01 : (0 : Fin 2) ≠ 1 := by decide
        simp only [h01, ↓reduceIte]
        calc
          algebraMap R L_T a₀ * t_inv * t - algebraMap R L_T a₀
              = algebraMap R L_T a₀ * (t * t_inv) - algebraMap R L_T a₀ := by ring
          _ = 0 := by rw [ht_mul, mul_one, sub_self]
    have hα_ker : ∀ p ∈ I_R, α_tilde p = 0 := by
      intro p hp
      have hle : I_R ≤ RingHom.ker α_tilde.toRingHom :=
        (Ideal.span_singleton_le_iff_mem _).mpr hα_rel
      exact hle hp
    let α_bar : A_R →ₐ[R] L_T := Ideal.Quotient.liftₐ I_R α_tilde hα_ker
    have hα_xbar_i₀ : α_bar (xbar i₀) = t := by
      change α_tilde (MvPolynomial.X i₀) = t
      rw [MvPolynomial.aeval_X]
      simp only [↓reduceIte]
    have hα_units : ∀ y : Submonoid.powers (xbar i₀), IsUnit (α_bar y.1) := by
      rintro ⟨_, n, rfl⟩
      simp only [map_pow, hα_xbar_i₀]
      exact ht_unit.pow n
    let Φ : L_i →ₐ[R] L_T :=
      IsLocalization.liftAlgHom (M := Submonoid.powers (xbar i₀)) (S := L_i) hα_units
    have hΦ_u : Φ u = t := by
      change (IsLocalization.lift (M := Submonoid.powers (xbar i₀)) hα_units)
        (algebraMap A_R L_i (xbar i₀)) = t
      rw [IsLocalization.lift_eq]
      exact hα_xbar_i₀

    let β_bar : Polynomial R →ₐ[R] L_i := Polynomial.aeval u
    have hβ_X : β_bar Polynomial.X = u := Polynomial.aeval_X u
    have hβ_units : ∀ y : Submonoid.powers (Polynomial.X : Polynomial R), IsUnit (β_bar y.1) := by
      rintro ⟨_, n, rfl⟩
      simp only [map_pow, hβ_X]
      exact hu_unit.pow n
    let Ψ : L_T →ₐ[R] L_i :=
      IsLocalization.liftAlgHom (M := Submonoid.powers (Polynomial.X : Polynomial R))
        (S := L_T) hβ_units
    have hΨ_t : Ψ t = u := by
      change (IsLocalization.lift (M := Submonoid.powers (Polynomial.X : Polynomial R)) hβ_units)
        (algebraMap (Polynomial R) L_T Polynomial.X) = u
      rw [IsLocalization.lift_eq]
      exact hβ_X
    have hΨ_t_inv : Ψ t_inv = u_inv := by
      have h1 : u * Ψ t_inv = 1 := by
        rw [← hΨ_t, ← map_mul, ht_mul, map_one]
      calc
        Ψ t_inv = (u_inv * u) * Ψ t_inv := by rw [mul_comm u_inv u, hu_mul, one_mul]
        _ = u_inv * (u * Ψ t_inv) := mul_assoc _ _ _
        _ = u_inv := by rw [h1, mul_one]

    have hΦΨ : Φ.comp Ψ = AlgHom.id R L_T := by
      apply IsLocalization.algHom_ext (Submonoid.powers (Polynomial.X : Polynomial R))
      apply Polynomial.algHom_ext
      change Φ (Ψ t) = t
      rw [hΨ_t, hΦ_u]
    have hΨΦ : Ψ.comp Φ = AlgHom.id R L_i := by
      apply IsLocalization.algHom_ext (Submonoid.powers (xbar i₀))
      apply Ideal.Quotient.algHom_ext R
      apply MvPolynomial.algHom_ext
      intro k
      change Ψ (Φ (algebraMap A_R L_i (xbar k))) = algebraMap A_R L_i (xbar k)
      have hΦ_xk : Φ (algebraMap A_R L_i (xbar k)) = α_bar (xbar k) := by
        change (IsLocalization.lift (M := Submonoid.powers (xbar i₀)) hα_units)
          (algebraMap A_R L_i (xbar k)) = α_bar (xbar k)
        exact IsLocalization.lift_eq hα_units (xbar k)
      rw [hΦ_xk]
      by_cases hk : k = i₀
      · subst hk
        rw [hα_xbar_i₀, hΨ_t]
      · have hα_xk : α_bar (xbar k) = algebraMap R L_T a₀ * t_inv := by
          change α_tilde (MvPolynomial.X k) = _
          rw [MvPolynomial.aeval_X]
          simp only [hk, ↓reduceIte]
        rw [hα_xk, map_mul, AlgHom.commutes, hΨ_t_inv]
        have hprod_k : xbar i₀ * xbar k = algebraMap R A_R a₀ := by
          fin_cases i₀ <;> fin_cases k
          · exact False.elim (hk rfl)
          · exact hxbar_mul
          · rw [mul_comm]; exact hxbar_mul
          · exact False.elim (hk rfl)
        have hprod_Li : u * algebraMap A_R L_i (xbar k) = algebraMap R L_i a₀ := by
          change algebraMap A_R L_i (xbar i₀) * algebraMap A_R L_i (xbar k) = _
          rw [← map_mul, hprod_k, ← IsScalarTower.algebraMap_apply]
        calc
          algebraMap R L_i a₀ * u_inv
              = (u * algebraMap A_R L_i (xbar k)) * u_inv := by rw [hprod_Li]
          _ = algebraMap A_R L_i (xbar k) * (u * u_inv) := by ring
          _ = algebraMap A_R L_i (xbar k) := by rw [hu_mul, mul_one]
    let e_loc : L_i ≃ₐ[R] L_T := AlgEquiv.ofAlgHom Φ Ψ hΦΨ hΨΦ

    let ι_loc : AlgebraicGeometry.Spec (CommRingCat.of L_i) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of A_R) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A_R L_i))
    let ι_X : AlgebraicGeometry.Spec (CommRingCat.of L_T) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of (Polynomial R)) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial R) L_T))
    have : AlgebraicGeometry.IsOpenImmersion ι_loc :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization (xbar i₀)
    have : AlgebraicGeometry.IsOpenImmersion ι_X :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization (Polynomial.X : Polynomial R)
    let w₀ : ↥W₀.toScheme := ⟨z₀, hz₀⟩
    have hq_mem : e₀.base w₀ ∈ (PrimeSpectrum.basicOpen (xbar i₀) : Set (PrimeSpectrum A_R)) :=
      hx_not_mem
    rw [← PrimeSpectrum.localization_away_comap_range L_i (xbar i₀)] at hq_mem
    obtain ⟨z_loc, hz_loc⟩ := hq_mem
    let z_loc' : ↥(AlgebraicGeometry.Spec (CommRingCat.of L_i)) := z_loc
    have hz_loc' : e₀ w₀ = ι_loc z_loc' := hz_loc.symm
    obtain ⟨p₀, hp₀_fst, _hp₀_snd⟩ :=
      @AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback _ _ _ e₀ ι_loc w₀ z_loc' hz_loc'
    let j_V : CategoryTheory.Limits.pullback e₀ ι_loc ⟶ C₀ :=
      CategoryTheory.Limits.pullback.fst e₀ ι_loc ≫ W₀.ι
    have : AlgebraicGeometry.IsOpenImmersion j_V := inferInstance
    let V_sm : C₀.Opens := j_V.opensRange
    have hz₀_Vsm : z₀ ∈ V_sm := by
      refine ⟨p₀, ?_⟩
      change W₀.ι.base ((CategoryTheory.Limits.pullback.fst e₀ ι_loc).base p₀) = z₀
      have hp₀_fst' : (CategoryTheory.Limits.pullback.fst e₀ ι_loc).base p₀ = w₀ := hp₀_fst
      rw [hp₀_fst']
      rfl
    have hRange_Vsm : Set.range ⇑j_V = Set.range ⇑V_sm.ι := by
      ext x
      simp only [Set.mem_range]
      constructor
      · rintro ⟨p, rfl⟩
        exact ⟨⟨j_V p, ⟨p, rfl⟩⟩, rfl⟩
      · rintro ⟨⟨_, ⟨p, rfl⟩⟩, rfl⟩
        exact ⟨p, rfl⟩
    let iso_W : CategoryTheory.Limits.pullback e₀ ι_loc ≅ V_sm.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq j_V V_sm.ι hRange_Vsm
    let iso_loc := e_loc.symm.toRingEquiv.toCommRingCatIso
    have : AlgebraicGeometry.IsOpenImmersion iso_W.inv :=
      AlgebraicGeometry.IsOpenImmersion.of_isIso _
    have : AlgebraicGeometry.IsOpenImmersion (AlgebraicGeometry.Spec.map iso_loc.hom) :=
      AlgebraicGeometry.IsOpenImmersion.of_isIso _
    have : AlgebraicGeometry.Etale (CategoryTheory.Limits.pullback.snd e₀ ι_loc) :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (P := @AlgebraicGeometry.Etale)
        (CategoryTheory.IsPullback.of_hasPullback e₀ ι_loc) hEt_e₀
    let e_sm : V_sm.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial R)) :=
      iso_W.inv ≫ CategoryTheory.Limits.pullback.snd e₀ ι_loc ≫
        AlgebraicGeometry.Spec.map iso_loc.hom ≫ ι_X
    have hEt_sm : AlgebraicGeometry.Etale e_sm := inferInstance
    have hRing_sm :
        (CommRingCat.ofHom (Polynomial.C : R →+* Polynomial R) ≫
          CommRingCat.ofHom (algebraMap (Polynomial R) L_T)) ≫ iso_loc.hom =
        CommRingCat.ofHom ((Ideal.Quotient.mk I_R).comp MvPolynomial.C) ≫
          CommRingCat.ofHom (algebraMap A_R L_i) := by
      ext r
      change e_loc.symm (algebraMap (Polynomial R) L_T (Polynomial.C r)) =
        algebraMap A_R L_i (algebraMap R A_R r)
      have h1 : algebraMap (Polynomial R) L_T (Polynomial.C r) = algebraMap R L_T r :=
        (IsScalarTower.algebraMap_apply R (Polynomial R) L_T r).symm
      rw [h1, e_loc.symm.commutes r, IsScalarTower.algebraMap_apply R A_R L_i r]
    have hSpec_sm :
        AlgebraicGeometry.Spec.map iso_loc.hom ≫ ι_X ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) =
        ι_loc ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk I_R).comp MvPolynomial.C)) := by
      calc
        AlgebraicGeometry.Spec.map iso_loc.hom ≫ ι_X ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C)
            = AlgebraicGeometry.Spec.map
                ((CommRingCat.ofHom Polynomial.C ≫
                  CommRingCat.ofHom (algebraMap (Polynomial R) L_T)) ≫ iso_loc.hom) := by
              simp only [ι_X, AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc]
        _ = AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom ((Ideal.Quotient.mk I_R).comp MvPolynomial.C) ≫
                CommRingCat.ofHom (algebraMap A_R L_i)) := by
              rw [hRing_sm]
        _ = ι_loc ≫ AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom ((Ideal.Quotient.mk I_R).comp MvPolynomial.C)) := by
              rw [AlgebraicGeometry.Spec.map_comp]
    refine ⟨V_sm, e_sm, hz₀_Vsm, hEt_sm, ?_⟩
    calc
      V_sm.ι ≫ g₀ = (iso_W.inv ≫ j_V) ≫ g₀ := by
        rw [AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_inv_fac j_V V_sm.ι hRange_Vsm]
      _ = iso_W.inv ≫ CategoryTheory.Limits.pullback.fst e₀ ι_loc ≫ (W₀.ι ≫ g₀) := by
        simp only [j_V, CategoryTheory.Category.assoc]
      _ = iso_W.inv ≫ (CategoryTheory.Limits.pullback.fst e₀ ι_loc ≫ e₀) ≫
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom ((Ideal.Quotient.mk I_R).comp MvPolynomial.C)) := by
        rw [hcomm₀, CategoryTheory.Category.assoc]
      _ = iso_W.inv ≫ (CategoryTheory.Limits.pullback.snd e₀ ι_loc ≫ ι_loc) ≫
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom ((Ideal.Quotient.mk I_R).comp MvPolynomial.C)) := by
        rw [CategoryTheory.Limits.pullback.condition]
      _ = iso_W.inv ≫ CategoryTheory.Limits.pullback.snd e₀ ι_loc ≫
            (ι_loc ≫ AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom ((Ideal.Quotient.mk I_R).comp MvPolynomial.C))) := by
        simp only [CategoryTheory.Category.assoc]
      _ = e_sm ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) := by
        rw [← hSpec_sm]
        simp only [e_sm, CategoryTheory.Category.assoc]

  
  have nodal_bridge_of_abstract_A :
      ∀ (R L A : Type u) [CommRing R] [CommRing L] [Algebra R L]
        [CommRing A] [Algebra R A] (a₀ : R),
        algebraMap R L a₀ = 0 →
        ∀ (x : Fin 2 → A),
          x 0 * x 1 = algebraMap R A a₀ →
          let I_L : Ideal (MvPolynomial (Fin 2) L) :=
            Ideal.span {MvPolynomial.X (0 : Fin 2) * MvPolynomial.X (1 : Fin 2)}
          ∀ (α₁ : A →ₐ[R] MvPolynomial (Fin 2) L ⧸ I_L),
            (∀ i : Fin 2, α₁ (x i) = Ideal.Quotient.mk I_L (MvPolynomial.X i)) →
            (∀ (M : Type u) [CommRing M] [Algebra R M] (f g : A →ₐ[R] M),
              (∀ i : Fin 2, f (x i) = g (x i)) → f = g) →
            ∃ (φ_iso : CategoryTheory.Limits.pullback
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R A)))
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R L))) ⟶
                AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 2) L ⧸ I_L))),
              AlgebraicGeometry.IsOpenImmersion φ_iso ∧
              φ_iso ≫ AlgebraicGeometry.Spec.map
                  (CommRingCat.ofHom ((Ideal.Quotient.mk I_L).comp MvPolynomial.C)) =
                CategoryTheory.Limits.pullback.snd _ _ ∧
              φ_iso ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom α₁.toRingHom) =
                CategoryTheory.Limits.pullback.fst _ _ := by
    intro R L A _ _ _ _ _ a₀ hφa x hx I_L α₁ hα₁_x hA_ext
    let B_L := MvPolynomial (Fin 2) L ⧸ I_L
    let α₂ : L →ₐ[R] B_L := IsScalarTower.toAlgHom R L B_L
    let F_fwd : TensorProduct R A L →ₐ[R] B_L :=
      Algebra.TensorProduct.productMap α₁ α₂
    let β_tilde : MvPolynomial (Fin 2) L →+* TensorProduct R A L :=
      MvPolynomial.eval₂Hom
        ((Algebra.TensorProduct.includeRight : L →ₐ[R] TensorProduct R A L) :
          L →+* TensorProduct R A L)
        (fun i : Fin 2 => x i ⊗ₜ[R] (1 : L))
    have hβ_rel : β_tilde (MvPolynomial.X 0 * MvPolynomial.X 1) = 0 := by
      rw [map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X',
        Algebra.TensorProduct.tmul_mul_tmul, hx, mul_one,
        Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul,
        ← Algebra.algebraMap_eq_smul_one, hφa, TensorProduct.tmul_zero]
    have hβ_ker : ∀ p ∈ I_L, β_tilde p = 0 := by
      intro p hp
      have hle : I_L ≤ RingHom.ker β_tilde :=
        (Ideal.span_singleton_le_iff_mem _).mpr hβ_rel
      exact hle hp
    let β₁ : B_L →+* TensorProduct R A L :=
      Ideal.Quotient.lift I_L β_tilde hβ_ker
    let F_inv : B_L →ₐ[R] TensorProduct R A L :=
      { β₁ with
        commutes' := fun r => by
          change β₁ (Ideal.Quotient.mk I_L (MvPolynomial.C (algebraMap R L r))) = _
          rw [Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_C]
          exact Algebra.TensorProduct.includeRight.commutes r }
    have hFinv_C : ∀ c : L,
        F_inv (Ideal.Quotient.mk I_L (MvPolynomial.C c)) =
          Algebra.TensorProduct.includeRight c := by
      intro c
      change β₁ (Ideal.Quotient.mk I_L (MvPolynomial.C c)) = _
      rw [Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_C]
      rfl
    have hFinv_X : ∀ i : Fin 2,
        F_inv (Ideal.Quotient.mk I_L (MvPolynomial.X i)) = x i ⊗ₜ[R] (1 : L) := by
      intro i
      change β₁ (Ideal.Quotient.mk I_L (MvPolynomial.X i)) = _
      rw [Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_X']
    have h_fwd_inv : F_fwd.comp F_inv = AlgHom.id R B_L := by
      apply AlgHom.coe_ringHom_injective
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext'
      · ext c
        change F_fwd (F_inv (Ideal.Quotient.mk I_L (MvPolynomial.C c))) =
          Ideal.Quotient.mk I_L (MvPolynomial.C c)
        rw [hFinv_C c, Algebra.TensorProduct.includeRight_apply,
          Algebra.TensorProduct.productMap_apply_tmul, map_one, one_mul]
        rfl
      · intro i
        change F_fwd (F_inv (Ideal.Quotient.mk I_L (MvPolynomial.X i))) =
          Ideal.Quotient.mk I_L (MvPolynomial.X i)
        rw [hFinv_X i, Algebra.TensorProduct.productMap_apply_tmul, map_one, mul_one, hα₁_x i]
    have h_inv_fwd : F_inv.comp F_fwd = AlgHom.id R (TensorProduct R A L) := by
      apply Algebra.TensorProduct.ext
      · apply hA_ext (TensorProduct R A L)
        intro i
        change F_inv (F_fwd (x i ⊗ₜ[R] (1 : L))) = x i ⊗ₜ[R] (1 : L)
        have h1 : F_fwd (x i ⊗ₜ[R] (1 : L)) = Ideal.Quotient.mk I_L (MvPolynomial.X i) := by
          rw [Algebra.TensorProduct.productMap_apply_tmul, map_one, mul_one, hα₁_x i]
        rw [h1, hFinv_X i]
      · ext c
        change F_inv (F_fwd ((1 : A) ⊗ₜ[R] c)) = (1 : A) ⊗ₜ[R] c
        have h1 : F_fwd ((1 : A) ⊗ₜ[R] c) = Ideal.Quotient.mk I_L (MvPolynomial.C c) := by
          rw [Algebra.TensorProduct.productMap_apply_tmul, map_one, one_mul]
          rfl
        rw [h1, hFinv_C c, Algebra.TensorProduct.includeRight_apply]
    let θ_nod : TensorProduct R A L ≃ₐ[R] B_L :=
      AlgEquiv.ofAlgHom F_fwd F_inv h_fwd_inv h_inv_fwd
    let iso_θ := θ_nod.symm.toRingEquiv.toCommRingCatIso
    have : AlgebraicGeometry.IsOpenImmersion (AlgebraicGeometry.pullbackSpecIso R A L).hom :=
      AlgebraicGeometry.IsOpenImmersion.of_isIso _
    have : AlgebraicGeometry.IsOpenImmersion (AlgebraicGeometry.Spec.map iso_θ.hom) :=
      AlgebraicGeometry.IsOpenImmersion.of_isIso _
    let φ_iso := (AlgebraicGeometry.pullbackSpecIso R A L).hom ≫
      AlgebraicGeometry.Spec.map iso_θ.hom
    have hOpen_φ : AlgebraicGeometry.IsOpenImmersion φ_iso := inferInstance
    let incR_nod : L →+* TensorProduct R A L :=
      (Algebra.TensorProduct.includeRight : L →ₐ[R] TensorProduct R A L)
    have hRing_snd :
        CommRingCat.ofHom ((Ideal.Quotient.mk I_L).comp MvPolynomial.C) ≫ iso_θ.hom =
          CommRingCat.ofHom incR_nod := by
      ext c
      exact hFinv_C c
    have hRing_fst :
        CommRingCat.ofHom α₁.toRingHom ≫ iso_θ.hom =
          CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom := by
      ext y
      change θ_nod.symm (α₁ y) = Algebra.TensorProduct.includeLeftRingHom y
      apply θ_nod.injective
      rw [AlgEquiv.apply_symm_apply]
      change α₁ y = (Algebra.TensorProduct.productMap α₁ α₂) (y ⊗ₜ[R] (1 : L))
      rw [Algebra.TensorProduct.productMap_apply_tmul, map_one, mul_one]
    refine ⟨φ_iso, hOpen_φ, ?_, ?_⟩
    · calc
        φ_iso ≫ AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((Ideal.Quotient.mk I_L).comp MvPolynomial.C))
            = (AlgebraicGeometry.pullbackSpecIso R A L).hom ≫
                AlgebraicGeometry.Spec.map
                  (CommRingCat.ofHom ((Ideal.Quotient.mk I_L).comp MvPolynomial.C) ≫
                    iso_θ.hom) := by
              simp only [φ_iso, AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc]
        _ = (AlgebraicGeometry.pullbackSpecIso R A L).hom ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom incR_nod) := by
              rw [hRing_snd]
        _ = CategoryTheory.Limits.pullback.snd _ _ :=
              AlgebraicGeometry.pullbackSpecIso_hom_snd R A L
    · calc
        φ_iso ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom α₁.toRingHom)
            = (AlgebraicGeometry.pullbackSpecIso R A L).hom ≫
                AlgebraicGeometry.Spec.map
                  (CommRingCat.ofHom α₁.toRingHom ≫ iso_θ.hom) := by
              simp only [φ_iso, AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc]
        _ = (AlgebraicGeometry.pullbackSpecIso R A L).hom ≫
              AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom) := by
              rw [hRing_fst]
        _ = CategoryTheory.Limits.pullback.fst _ _ :=
              AlgebraicGeometry.pullbackSpecIso_hom_fst R A L

  have nodal_baseChange_of_commRing :
      ∀ (R L : Type u) [CommRing R] [CommRing L] [Algebra R L] (a₀ : R),
        algebraMap R L a₀ = 0 →
        ∀ (C₀ : AlgebraicGeometry.Scheme.{u})
          (g₀ : C₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
          (W₀ : C₀.Opens)
          (e₀ : W₀.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of
            (MvPolynomial (Fin 2) R ⧸ Ideal.span
              {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a₀})))
          (_ : AlgebraicGeometry.Etale e₀)
          (_ : W₀.ι ≫ g₀ = e₀ ≫ AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)))
          (wL : ↥(CategoryTheory.Limits.pullback g₀
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R L)))))
          (hw₀ : (CategoryTheory.Limits.pullback.fst g₀
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R L)))).base wL ∈ W₀),
          (∀ i : Fin 2, Ideal.Quotient.mk _ (MvPolynomial.X i) ∈
            (e₀.base ⟨(CategoryTheory.Limits.pullback.fst g₀
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R L)))).base wL,
              hw₀⟩).asIdeal) →
          ∃ (U₀ : (CategoryTheory.Limits.pullback g₀
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R L)))).Opens)
            (hw : wL ∈ U₀)
            (e_L : U₀.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of
              (MvPolynomial (Fin 2) L ⧸
                Ideal.span {MvPolynomial.X (0 : Fin 2) * MvPolynomial.X (1 : Fin 2)}))),
            AlgebraicGeometry.Etale e_L ∧
            U₀.ι ≫ CategoryTheory.Limits.pullback.snd g₀
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R L))) =
              e_L ≫ AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) ∧
            ∀ i : Fin 2, Ideal.Quotient.mk _ (MvPolynomial.X i) ∈ (e_L.base ⟨wL, hw⟩).asIdeal := by
    intro R L _ _ _ a₀ hφa C₀ g₀ W₀ e₀ hEt_e₀ hcomm₀ wL hw₀ hAll
    let I_R : Ideal (MvPolynomial (Fin 2) R) :=
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a₀}
    let A_R := MvPolynomial (Fin 2) R ⧸ I_R
    let xbar : Fin 2 → A_R := fun k => Ideal.Quotient.mk I_R (MvPolynomial.X k)
    have hxbar_mul : xbar 0 * xbar 1 = algebraMap R A_R a₀ := by
      have hmem : MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a₀ ∈ I_R :=
        Ideal.subset_span rfl
      have hzero : Ideal.Quotient.mk I_R
          (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a₀) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr hmem
      rw [map_sub, map_mul, sub_eq_zero] at hzero
      exact hzero
    let I_L : Ideal (MvPolynomial (Fin 2) L) :=
      Ideal.span {MvPolynomial.X (0 : Fin 2) * MvPolynomial.X (1 : Fin 2)}
    let B_L := MvPolynomial (Fin 2) L ⧸ I_L

    let α_tilde : MvPolynomial (Fin 2) R →ₐ[R] B_L :=
      MvPolynomial.aeval (fun i : Fin 2 => Ideal.Quotient.mk I_L (MvPolynomial.X i))
    have hα_rel : α_tilde (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a₀) = 0 := by
      rw [map_sub, map_mul, MvPolynomial.aeval_X, MvPolynomial.aeval_X, MvPolynomial.aeval_C]
      have hX01 : Ideal.Quotient.mk I_L (MvPolynomial.X 0) *
          Ideal.Quotient.mk I_L (MvPolynomial.X 1) = 0 := by
        rw [← map_mul]
        exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
      have ha0 : algebraMap R B_L a₀ = 0 := by
        rw [IsScalarTower.algebraMap_apply R L B_L a₀, hφa, map_zero]
      rw [hX01, ha0, sub_self]
    have hα_ker : ∀ p ∈ I_R, α_tilde p = 0 := by
      intro p hp
      have hle : I_R ≤ RingHom.ker α_tilde.toRingHom :=
        (Ideal.span_singleton_le_iff_mem _).mpr hα_rel
      exact hle hp
    let α₁ : A_R →ₐ[R] B_L := Ideal.Quotient.liftₐ I_R α_tilde hα_ker
    have hα₁_xbar : ∀ i : Fin 2, α₁ (xbar i) = Ideal.Quotient.mk I_L (MvPolynomial.X i) := by
      intro i
      change α_tilde (MvPolynomial.X i) = _
      exact MvPolynomial.aeval_X _ i
    have hA_ext : ∀ (M : Type u) [CommRing M] [Algebra R M] (f g : A_R →ₐ[R] M),
        (∀ i : Fin 2, f (xbar i) = g (xbar i)) → f = g := by
      intro M _ _ f g hfg
      apply Ideal.Quotient.algHom_ext R
      apply MvPolynomial.algHom_ext
      exact hfg
    obtain ⟨φ_iso, hOpen_φ, hφ_snd, hφ_fst⟩ :=
      nodal_bridge_of_abstract_A R L A_R a₀ hφa xbar hxbar_mul α₁ hα₁_xbar hA_ext

    let s_alg := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R L))
    let fst₀ := CategoryTheory.Limits.pullback.fst g₀ s_alg
    let snd₀ := CategoryTheory.Limits.pullback.snd g₀ s_alg
    let U₀ : (CategoryTheory.Limits.pullback g₀ s_alg).Opens :=
      (TopologicalSpace.Opens.map fst₀.base).obj W₀
    let π_R := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R A_R))
    have hcomm₀' : W₀.ι ≫ g₀ = e₀ ≫ π_R := hcomm₀
    have hPb_res : CategoryTheory.IsPullback (fst₀ ∣_ W₀) (U₀.ι ≫ snd₀) (W₀.ι ≫ g₀) s_alg :=
      CategoryTheory.IsPullback.paste_vert
        (AlgebraicGeometry.isPullback_morphismRestrict fst₀ W₀)
        (CategoryTheory.IsPullback.of_hasPullback g₀ s_alg)
    let e_pb : U₀.toScheme ⟶ CategoryTheory.Limits.pullback π_R s_alg :=
      CategoryTheory.Limits.pullback.lift ((fst₀ ∣_ W₀) ≫ e₀) (U₀.ι ≫ snd₀)
        (by rw [CategoryTheory.Category.assoc, ← hcomm₀']; exact hPb_res.w)
    have hPb_top : CategoryTheory.IsPullback (fst₀ ∣_ W₀) e_pb e₀
        (CategoryTheory.Limits.pullback.fst π_R s_alg) := by
      refine CategoryTheory.IsPullback.of_bot ?_
        (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm
        (CategoryTheory.IsPullback.of_hasPullback π_R s_alg)
      rw [CategoryTheory.Limits.pullback.lift_snd, ← hcomm₀']
      exact hPb_res
    have : AlgebraicGeometry.Etale e_pb :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (P := @AlgebraicGeometry.Etale) hPb_top hEt_e₀
    let e_L : U₀.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of B_L) :=
      e_pb ≫ φ_iso
    have hEt_eL : AlgebraicGeometry.Etale e_L := inferInstance
    have hSpec_fst :
        e_L ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom α₁.toRingHom) =
          (fst₀ ∣_ W₀) ≫ e₀ := by
      calc
        e_L ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom α₁.toRingHom)
            = e_pb ≫ (φ_iso ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom α₁.toRingHom)) := by
              simp only [e_L, CategoryTheory.Category.assoc]
        _ = e_pb ≫ CategoryTheory.Limits.pullback.fst π_R s_alg := by
              rw [hφ_fst]
        _ = (fst₀ ∣_ W₀) ≫ e₀ := CategoryTheory.Limits.pullback.lift_fst _ _ _
    refine ⟨U₀, hw₀, e_L, hEt_eL, ?_, ?_⟩
    · calc
        U₀.ι ≫ snd₀ = e_pb ≫ CategoryTheory.Limits.pullback.snd π_R s_alg :=
          (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm
        _ = e_pb ≫ (φ_iso ≫ AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom ((Ideal.Quotient.mk I_L).comp MvPolynomial.C))) := by
          rw [hφ_snd]
        _ = e_L ≫ AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom ((Ideal.Quotient.mk I_L).comp MvPolynomial.C)) := by
          simp only [e_L, CategoryTheory.Category.assoc]
    · intro i
      let u₀ : ↥U₀.toScheme := ⟨wL, hw₀⟩
      have hres_u₀ : (fst₀ ∣_ W₀).base u₀ = ⟨fst₀.base wL, hw₀⟩ :=
        Subtype.ext (AlgebraicGeometry.morphismRestrict_base_coe fst₀ W₀ u₀)
      have hmap_u₀ :
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α₁.toRingHom)).base (e_L.base u₀) =
            e₀.base ⟨fst₀.base wL, hw₀⟩ := by
        calc
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α₁.toRingHom)).base (e_L.base u₀)
              = (e_L ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom α₁.toRingHom)).base u₀ := rfl
          _ = ((fst₀ ∣_ W₀) ≫ e₀).base u₀ := by rw [hSpec_fst]
          _ = e₀.base ((fst₀ ∣_ W₀).base u₀) := rfl
          _ = e₀.base ⟨fst₀.base wL, hw₀⟩ := by rw [hres_u₀]
      have hmem_xbar : xbar i ∈ (e₀.base ⟨fst₀.base wL, hw₀⟩).asIdeal := hAll i
      rw [← hmap_u₀, AlgebraicGeometry.Spec.map_apply] at hmem_xbar
      exact hα₁_xbar i ▸ hmem_xbar

  
  refine ⟨hPre_fst, hRange_fst, hCompF, hNoethF, hFinIrred, hSepSnd, hSm_fwd, ?_⟩
  intro w
  rcases hChartsW (fst_W.base w) with ⟨W₀, e, hz, hEt, he_comm⟩ | ⟨W₀, a, e, hz, _ha, hEt, he_comm⟩
  · exact Or.inl (poly_baseChange_and_smooth_of_commRing ↥V κ W g_W W₀ e hEt he_comm w hz)
  · let I_V : Ideal (MvPolynomial (Fin 2) ↥V) :=
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}
    let w₀ : ↥W₀.toScheme := ⟨fst_W.base w, hz⟩
    let q_V := e.base w₀
    by_cases hAll : ∀ i : Fin 2, Ideal.Quotient.mk I_V (MvPolynomial.X i) ∈ q_V.asIdeal
    · 
      have hCa_mem : Ideal.Quotient.mk I_V (MvPolynomial.C a) ∈ q_V.asIdeal := by
        have hzero : Ideal.Quotient.mk I_V
            (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
        rw [map_sub, map_mul, sub_eq_zero] at hzero
        rw [← hzero]
        exact q_V.asIdeal.mul_mem_right _ (hAll 0)
      have hz_Q : (g_W.base (fst_W.base w)).asIdeal = Q := by
        have hmem : fst_W.base w ∈ Set.range fst_W.base := ⟨w, rfl⟩
        rw [hRange_fst] at hmem
        exact hmem
      have hgw_eq : g_W.base (fst_W.base w) =
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((Ideal.Quotient.mk I_V).comp MvPolynomial.C))).base q_V := by
        calc
          g_W.base (fst_W.base w) = (W₀.ι ≫ g_W).base w₀ := rfl
          _ = (e ≫ AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom ((Ideal.Quotient.mk I_V).comp MvPolynomial.C))).base w₀ := by
            rw [he_comm]
          _ = _ := rfl
      have haQ : a ∈ Q := by
        rw [← hz_Q, hgw_eq, AlgebraicGeometry.Spec.map_apply]
        exact hCa_mem
      have hφa : algebraMap ↥V κ a = 0 :=
        (Ideal.algebraMap_residueField_eq_zero).mpr haQ
      exact Or.inr (nodal_baseChange_of_commRing ↥V κ a hφa W g_W W₀ e hEt he_comm w hz hAll)
    · 
      obtain ⟨i₀, hi₀⟩ := not_forall.mp hAll
      obtain ⟨V_sm, e_sm, hz_sm, hEt_sm, hcomm_sm⟩ :=
        laurent_poly_chart_of_commRing ↥V a i₀ W g_W W₀ (fst_W.base w) hz e hEt he_comm hi₀
      exact Or.inl
        (poly_baseChange_and_smooth_of_commRing ↥V κ W g_W V_sm e_sm hEt_sm hcomm_sm w hz_sm)

theorem weil_algClosed_smooth_and_nodal_etale_ring_branch_algebra (κ : Type u) [Field κ] [IsAlgClosed κ]
    (hEtIC : ∀ (A₀ B : Type u) [CommRing A₀] [IsDomain A₀] [IsIntegrallyClosed A₀]
      [CommRing B] [IsDomain B] [Algebra A₀ B] [Algebra.Etale A₀ B], IsIntegrallyClosed B) :
    (∀ (B : Type u) [CommRing B] (φ_T : Polynomial κ →+* B),
      φ_T.Etale →
      ∀ (q : Ideal B) [q.IsPrime],
        ∃ (D : Type u) (_ : CommRing D) (ψ : B →+* D) (q_D : PrimeSpectrum D),
          IsDomain D ∧
          IsIntegrallyClosed D ∧
          AlgebraicGeometry.IsOpenImmersion (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) ∧
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)).base q_D = ⟨q, inferInstance⟩ ∧
          (∃ p₁ p₂ : PrimeSpectrum D, p₁ ≠ p₂) ∧
          (∀ Z : Set (PrimeSpectrum D),
            IsClosed Z → Z ≠ Set.univ →
            Z.Finite ∧
            ∀ p ∈ Z, ∃ ev : D →+* κ,
              ev.comp (ψ.comp (φ_T.comp Polynomial.C)) = RingHom.id κ ∧
              RingHom.ker ev = p.asIdeal)) ∧
    (let A_nod := MvPolynomial (Fin 2) κ ⧸
        (Ideal.span {MvPolynomial.X (0 : Fin 2) * MvPolynomial.X (1 : Fin 2)} :
          Ideal (MvPolynomial (Fin 2) κ))
     ∀ (B : Type u) [CommRing B] (φ_N : A_nod →+* B),
       φ_N.Etale →
       ∀ (q : Ideal B) [q.IsPrime],
         (∀ i : Fin 2, φ_N (Ideal.Quotient.mk _ (MvPolynomial.X i)) ∈ q) →
         (∀ r : B, r ∉ q →
           ¬ ((algebraMap B (Localization.Away r)).comp
             (φ_N.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C))).IsStandardSmoothOfRelativeDimension 1) ∧
         ∃ (B' : Type u) (_ : CommRing B') (ψ : B →+* B') (q' : PrimeSpectrum B') (b : Fin 2 → B'),
           IsReduced B' ∧
           AlgebraicGeometry.IsOpenImmersion (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) ∧
           (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)).base q' = ⟨q, inferInstance⟩ ∧
           (∃ ev₀ : B' →+* κ,
             ev₀.comp (ψ.comp (φ_N.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C))) = RingHom.id κ ∧
             RingHom.ker ev₀ = q'.asIdeal) ∧
           PrimeSpectrum.zeroLocus ({b 0} : Set B') ∪
             PrimeSpectrum.zeroLocus ({b 1} : Set B') = Set.univ ∧
           PrimeSpectrum.zeroLocus ({b 0} : Set B') ∩
             PrimeSpectrum.zeroLocus ({b 1} : Set B') = {q'} ∧
           (∀ i : Fin 2,
             (Ideal.span {b i} : Ideal B').IsPrime ∧
             let D_i := B' ⧸ Ideal.span {b i}
             ∃ (_ : IsDomain D_i),
               IsIntegrallyClosed D_i ∧
               (∃ p₁ p₂ : PrimeSpectrum D_i, p₁ ≠ p₂) ∧
               (∀ Z : Set (PrimeSpectrum D_i),
                 IsClosed Z → Z ≠ Set.univ →
                 Z.Finite ∧
                 ∀ p ∈ Z, ∃ ev : D_i →+* κ,
                   ev.comp ((Ideal.Quotient.mk (Ideal.span {b i})).comp
                     (ψ.comp (φ_N.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)))) = RingHom.id κ ∧
                   RingHom.ker ev = p.asIdeal))) :=
by
  have h_map_max : ∀ (B : Type u) [CommRing B] (φ_T : Polynomial κ →+* B),
      φ_T.Etale →
      ∀ (P : Ideal B) [P.IsPrime],
        Ideal.map ((algebraMap B (Localization.AtPrime P)).comp φ_T) (Ideal.comap φ_T P) =
          IsLocalRing.maximalIdeal (Localization.AtPrime P) := by
    intro B _ φ_T hEt P _
    let p₀ : Ideal (Polynomial κ) := Ideal.comap φ_T P
    have : p₀.IsPrime := Ideal.IsPrime.comap φ_T
    let A₁ := Localization.AtPrime p₀
    let B_P := Localization.AtPrime P
    let f_loc : A₁ →+* B_P := Localization.localRingHom p₀ P φ_T rfl
    letI : Algebra (Polynomial κ) B := φ_T.toAlgebra
    have : Algebra.Etale (Polynomial κ) B := hEt
    letI : Algebra A₁ B_P := f_loc.toAlgebra
    have : IsScalarTower (Polynomial κ) A₁ B_P := ⟨fun r a b => by
      simp only [Algebra.smul_def, map_mul, ← mul_assoc]
      congr 2
      change f_loc (algebraMap (Polynomial κ) A₁ r) = algebraMap (Polynomial κ) B_P r
      rw [Localization.localRingHom_to_map p₀ P φ_T rfl r,
        IsScalarTower.algebraMap_apply (Polynomial κ) B B_P]
      rfl⟩
    have : IsLocalHom (algebraMap A₁ B_P) := Localization.isLocalHom_localRingHom p₀ P φ_T rfl
    have : Algebra.EssFiniteType B B_P := Algebra.EssFiniteType.of_isLocalization B_P P.primeCompl
    have : Algebra.EssFiniteType (Polynomial κ) B_P := Algebra.EssFiniteType.comp (Polynomial κ) B B_P
    have : Algebra.EssFiniteType A₁ B_P := Algebra.EssFiniteType.of_comp (Polynomial κ) A₁ B_P
    have : Algebra.FormallyUnramified B B_P := Algebra.FormallyUnramified.instLocalization P.primeCompl
    have : Algebra.FormallyUnramified (Polynomial κ) B_P :=
      Algebra.FormallyUnramified.comp (Polynomial κ) B B_P
    have : Algebra.FormallyUnramified A₁ B_P := by
      rw [Algebra.FormallyUnramified.iff_comp_injective]
      refine fun {C} _ _ I hI2 g₁ g₂ hEq => ?_
      letI : Algebra (Polynomial κ) C :=
        ((algebraMap A₁ C).comp (algebraMap (Polynomial κ) A₁)).toAlgebra
      have : IsScalarTower (Polynomial κ) A₁ C := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
      have hg : (Ideal.Quotient.mkₐ (Polynomial κ) I).comp (g₁.restrictScalars (Polynomial κ)) =
          (Ideal.Quotient.mkₐ (Polynomial κ) I).comp (g₂.restrictScalars (Polynomial κ)) := by
        apply AlgHom.ext
        intro x
        exact AlgHom.congr_fun hEq x
      have hg' := Algebra.FormallyUnramified.iff_comp_injective.mp
        ‹Algebra.FormallyUnramified (Polynomial κ) B_P› I hI2 hg
      apply AlgHom.ext
      intro x
      exact AlgHom.congr_fun hg' x
    have hmap := Algebra.FormallyUnramified.map_maximalIdeal (R := A₁) (S := B_P)
    rw [← IsLocalization.AtPrime.map_eq_maximalIdeal p₀ A₁, Ideal.map_map] at hmap
    have hcomp : (algebraMap A₁ B_P).comp (algebraMap (Polynomial κ) A₁) =
        (algebraMap B B_P).comp φ_T := by
      apply RingHom.ext
      intro x
      exact Localization.localRingHom_to_map p₀ P φ_T rfl x
    rw [hcomp] at hmap
    exact hmap

  have h_s1 : ∀ (B : Type u) [CommRing B] (φ_T : Polynomial κ →+* B),
      φ_T.Etale →
      IsReduced B ∧
      ∀ (q : Ideal B) [q.IsPrime],
        ∃ h : B, h ∉ q ∧ IsDomain (Localization.Away h) := by
    intro B _ φ_T hEt
    letI : Algebra (Polynomial κ) B := φ_T.toAlgebra
    have : Algebra.Etale (Polynomial κ) B := hEt
    have : Algebra.FiniteType (Polynomial κ) B := inferInstance
    have : IsNoetherianRing B := Algebra.FiniteType.isNoetherianRing (Polynomial κ) B
    have hStalkDomain : ∀ (P : Ideal B) [P.IsPrime], IsDomain (Localization.AtPrime P) := by
      intro P _
      let B_P := Localization.AtPrime P
      have hMax := h_map_max B φ_T hEt P
      let p₀ : Ideal (Polynomial κ) := Ideal.comap φ_T P
      by_cases hp₀ : p₀ = ⊥
      · have hMaxBot : IsLocalRing.maximalIdeal B_P = ⊥ := by
          rw [← hMax]
          change Ideal.map _ p₀ = ⊥
          rw [hp₀, Ideal.map_bot]
        have hNoZero : NoZeroDivisors B_P := ⟨fun {x y} hxy => by
          by_cases hx : x = 0
          · exact Or.inl hx
          · have hx_not_max : x ∉ IsLocalRing.maximalIdeal B_P := by
              rw [hMaxBot]; exact hx
            have hUnit : IsUnit x := IsLocalRing.notMem_maximalIdeal.mp hx_not_max
            exact Or.inr (hUnit.mul_left_cancel (hxy.trans (mul_zero x).symm))⟩
        have : NoZeroDivisors B_P := hNoZero
        exact NoZeroDivisors.to_isDomain B_P
      · have : p₀.IsPrime := Ideal.IsPrime.comap φ_T
        let π : Polynomial κ := Submodule.IsPrincipal.generator p₀
        have hp₀_span : p₀ = Ideal.span {π} := (Submodule.IsPrincipal.span_singleton_generator p₀).symm
        have hπ_ne : π ≠ 0 := by
          intro h0
          apply hp₀
          rw [hp₀_span, h0, Ideal.span_singleton_eq_bot]
        let t : B_P := algebraMap B B_P (φ_T π)
        have hMaxSpan : IsLocalRing.maximalIdeal B_P = Ideal.span {t} := by
          rw [← hMax]
          change Ideal.map ((algebraMap B B_P).comp φ_T) p₀ = Ideal.span {t}
          rw [hp₀_span, Ideal.map_span, Set.image_singleton]
          rfl
        have : Module.Flat (Polynomial κ) B_P := Module.Flat.trans (Polynomial κ) B B_P
        have : Module.IsTorsionFree (Polynomial κ) B_P := Module.Flat.isTorsionFree
        have ht_reg : ∀ y : B_P, t * y = 0 → y = 0 := by
          intro y hty
          have hsmul : π • y = 0 := by
            rw [Algebra.smul_def, IsScalarTower.algebraMap_apply (Polynomial κ) B B_P]
            exact hty
          rcases smul_eq_zero.mp hsmul with h1 | h2
          · exact absurd h1 hπ_ne
          · exact h2
        have ht_pow_reg : ∀ (k : ℕ) (y : B_P), t ^ k * y = 0 → y = 0 := by
          intro k
          induction k with
          | zero => intro y hy; simpa using hy
          | succ k ih =>
            intro y hy
            rw [pow_succ', mul_assoc] at hy
            exact ih y (ht_reg _ hy)
        have : IsNoetherianRing B_P := IsLocalization.isNoetherianRing P.primeCompl B_P inferInstance
        let m_P := IsLocalRing.maximalIdeal B_P
        have hKrull : (⨅ i : ℕ, m_P ^ i) = ⊥ :=
