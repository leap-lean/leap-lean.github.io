    hSegreAbstract
      (weilProjectiveSpaceOver ↥V M_proj).left
      (weilProjectiveSpaceOver ↥V M_proj).hom
      (weilProjBasicOpen ↥V M_proj)
      (hAff_proj ↥V M_proj)
      (c_proj ↥V M_proj)
      (t_proj ↥V M_proj)
      hCoord_Mproj.1
      hCoord_Mproj.2.2.1
      hCoord_Mproj.2.2.2.2.1
