    let D_cat := CategoryTheory.GlueData.ofGlueData' D'
    have hEq_open : ∀ {X₀ Y₀ : AlgebraicGeometry.Scheme.{u}} (p : X₀ = Y₀),
        AlgebraicGeometry.IsOpenImmersion (eqToHom p) := by
      intro X₀ Y₀ p; subst p; rw [eqToHom_refl]; infer_instance
    have hOpen_f : ∀ i j : J, AlgebraicGeometry.IsOpenImmersion (D_cat.f i j) := by
      intro i j
      by_cases h : i = j
      · subst h
        have p_ii : D_cat.V (i, i) = D'.U i :=
          @dif_pos (i = i) (Classical.propDecidable _) rfl _ (fun _ => D'.U i) (fun h' => D'.V i i h')
        have hf_eq : D_cat.f i i = eqToHom p_ii :=
          @dif_pos (i = i) (Classical.propDecidable _) rfl _ _ _
        rw [hf_eq]
        exact hEq_open p_ii
      · have p_ij : D_cat.V (i, j) = S₀₁ :=
          @dif_neg (i = j) (Classical.propDecidable _) h _ (fun _ => D'.U i) (fun h' => D'.V i j h')
        have hf_eq : D_cat.f i j = eqToHom p_ij ≫ D'.f i j h :=
          @dif_neg (i = j) (Classical.propDecidable _) h _ _ _
        rw [hf_eq]
        have _ : AlgebraicGeometry.IsOpenImmersion (eqToHom p_ij) := hEq_open p_ij
        rcases i with ⟨_ | _⟩ <;> rcases j with ⟨_ | _⟩
        · exact False.elim (h rfl)
        · change AlgebraicGeometry.IsOpenImmersion (eqToHom p_ij ≫ j₀₁)
          exact AlgebraicGeometry.IsOpenImmersion.comp (eqToHom p_ij) j₀₁
        · change AlgebraicGeometry.IsOpenImmersion (eqToHom p_ij ≫ j₁₀)
          exact AlgebraicGeometry.IsOpenImmersion.comp (eqToHom p_ij) j₁₀
        · exact False.elim (h rfl)
    let D : AlgebraicGeometry.Scheme.GlueData.{u} :=
      { toGlueData := D_cat
        f_open := hOpen_f }
    have p₀₁ : D_cat.V (i₀, i₁) = S₀₁ :=
      @dif_neg (i₀ = i₁) (Classical.propDecidable _) h₀₁ _ (fun _ => D'.U i₀) (fun h => D'.V i₀ i₁ h)
    have p₁₀ : D_cat.V (i₁, i₀) = S₀₁ :=
      @dif_neg (i₁ = i₀) (Classical.propDecidable _) h₁₀ _ (fun _ => D'.U i₁) (fun h => D'.V i₁ i₀ h)
    have hf_01 : D_cat.f i₀ i₁ = eqToHom p₀₁ ≫ j₀₁ :=
      @dif_neg (i₀ = i₁) (Classical.propDecidable _) h₀₁ _ _ _
    have hf_10 : D_cat.f i₁ i₀ = eqToHom p₁₀ ≫ j₁₀ :=
      @dif_neg (i₁ = i₀) (Classical.propDecidable _) h₁₀ _ _ _
    have ht_01 : D_cat.t i₀ i₁ = eqToHom p₀₁ ≫ 𝟙 S₀₁ ≫ eqToHom p₁₀.symm :=
      @dif_neg (i₀ = i₁) (Classical.propDecidable _) h₀₁ _ _ _
    have ht_10 : D_cat.t i₁ i₀ = eqToHom p₁₀ ≫ 𝟙 S₀₁ ≫ eqToHom p₀₁.symm :=
      @dif_neg (i₁ = i₀) (Classical.propDecidable _) h₁₀ _ _ _
    have h_eq_clean : ∀ {V₀₁ V₁₀ U₁ : AlgebraicGeometry.Scheme.{u}}
