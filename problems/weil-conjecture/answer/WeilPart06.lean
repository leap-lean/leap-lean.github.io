              Fin.sum_univ_two] at hw
            simp only [Pi.one_apply, smul_eq_mul, mul_one] at hw
            fin_cases a <;> fin_cases b
            · exact absurd rfl hab
            · exact hw
            · rw [add_comm]; exact hw
            · exact absurd rfl hab
