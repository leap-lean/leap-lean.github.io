    let φ_KF : K →+* F := (AlgebraicGeometry.Spec.preimage (η_UK ≫ U_K.ι ≫ p_K)).hom
    have hφ_V : ∀ c : ↥V,
        φ_KF (V.subtype c) = (AlgebraicGeometry.Spec.preimage (η_Z ≫ g_Z)).hom c := by
      intro c
