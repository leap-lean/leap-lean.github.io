        intro htop
        have h1 : (1 : B) ∈ ann := htop ▸ Submodule.mem_top
        have h1' : (1 : B) * x = 0 := h1
        rw [one_mul] at h1'
        exact hx0 h1'
      obtain ⟨m, hm_max, hann_le⟩ := Ideal.exists_le_maximal ann hann_ne
      have : m.IsPrime := hm_max.isPrime
      have : IsDomain (Localization.AtPrime m) := hStalkDomain m
      have hloc0 : (algebraMap B (Localization.AtPrime m) x) ^ n = 0 := by
        rw [← map_pow, hxn, map_zero]
      have hlocx : algebraMap B (Localization.AtPrime m) x = 0 := IsNilpotent.eq_zero ⟨n, hloc0⟩
      obtain ⟨s, hs⟩ := (IsLocalization.map_eq_zero_iff m.primeCompl (Localization.AtPrime m) x).mp hlocx
      exact s.2 (hann_le hs)⟩
    refine ⟨hRedB, fun q _ => ?_⟩
    let B_q := Localization.AtPrime q
    have : IsDomain B_q := hStalkDomain q
    let p_bot : Ideal B := Ideal.comap (algebraMap B B_q) ⊥
    have : p_bot.IsPrime := Ideal.IsPrime.comap (algebraMap B B_q)
    have hp_bot_le_q : p_bot ≤ q := by
      intro x hx
      have hx_max : algebraMap B B_q x ∈ IsLocalRing.maximalIdeal B_q := by
        have h0 : algebraMap B B_q x = 0 := hx
        rw [h0]; exact zero_mem _
      have hunder := IsLocalization.AtPrime.under_maximalIdeal B_q q
      rw [← hunder]
      exact hx_max
    have hp_bot_min : ∀ (m : Ideal B), m.IsPrime → m ≤ q → p_bot ≤ m := by
      intro m hm hmq x hx
      obtain ⟨s, hs⟩ := (IsLocalization.map_eq_zero_iff q.primeCompl B_q x).mp hx
      have hs_not_m : (s : B) ∉ m := fun hsm => s.2 (hmq hsm)
      have hsm_mem : (s : B) * x ∈ m := by rw [hs]; exact zero_mem m
      exact (hm.mem_or_mem hsm_mem).resolve_left hs_not_m
    let S : Set (Ideal B) := {m ∈ minimalPrimes B | ¬ (m ≤ q)}
    have hS_fin : S.Finite :=
      (minimalPrimes.finite_of_isNoetherianRing B).subset (fun _ hm => hm.1)
    letI : Fintype S := hS_fin.fintype
    have hPick : ∀ m : S, ∃ x : B, x ∈ m.1 ∧ x ∉ q := fun m => Set.not_subset.mp m.2.2
    choose x_m hx_mem hx_not_q using hPick
    let h : B := ∏ m : S, x_m m
    have hh_not_q : h ∉ q := q.primeCompl.prod_mem (fun m _ => hx_not_q m)
    refine ⟨h, hh_not_q, ?_⟩
    let D := Localization.Away h
    let ψ := algebraMap B D
    have hh_not_pbot : h ∉ p_bot := fun hh => hh_not_q (hp_bot_le_q hh)
    have hDisj_pbot : Disjoint (Submonoid.powers h : Set B) (p_bot : Set B) := by
      rw [Set.disjoint_left]
      rintro _ ⟨n, rfl⟩ hmem
