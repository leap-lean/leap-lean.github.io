      intro m_e
      rcases m_e.2 with ⟨a, _, hm_eq⟩
      refine ⟨Ideal.Quotient.mk J_L (Polynomial.C (algebraMap A₁ L₁ a)), ?_⟩
      change ev_L (Polynomial.C (algebraMap A₁ L₁ a)) = ι_E m_e.1
      rw [Polynomial.aeval_C, ← IsScalarTower.algebraMap_apply A₁ L₁ E_m,
        IsScalarTower.algebraMap_apply A₁ B_m E_m, hm_eq]
    have hevbar_surj : Function.Surjective evbar_L := by
      intro z
      obtain ⟨⟨b_z, m_e⟩, hzm⟩ := IsLocalization.surj M_E z
      have hzm' : z * ι_E m_e.1 = ι_E b_z := hzm
      obtain ⟨⟨x_z, s_z⟩, hbs⟩ := IsLocalization.surj p_θ.primeCompl b_z
      have hbs' : b_z * s_z.1.1 = x_z.1 := hbs
      obtain ⟨u_num, hu_num⟩ := hSθ_range x_z
      obtain ⟨u_m, hu_m⟩ := hME_range m_e
      obtain ⟨u_s, hu_s⟩ := hSθ_range s_z.1
      let u_den : F_θ := u_m * u_s
      have hu_den_eq : evbar_L u_den = ι_E m_e.1 * ι_E s_z.1.1 := by
        rw [map_mul, hu_m, hu_s]
      have hunit_den : IsUnit (evbar_L u_den) := by
        rw [hu_den_eq]
        have hm_u : IsUnit (ι_E m_e.1) := IsLocalization.map_units E_m m_e
        have hs_u : IsUnit (ι_E s_z.1.1) :=
          (IsLocalRing.notMem_maximalIdeal.mp s_z.2).map ι_E
        exact hm_u.mul hs_u
      have hu_den_ne : u_den ≠ 0 := by
        intro h0
        rw [h0, map_zero] at hunit_den
        exact not_isUnit_zero hunit_den
      refine ⟨u_num * u_den⁻¹, ?_⟩
      apply hunit_den.mul_left_inj.mp
      calc
        evbar_L (u_num * u_den⁻¹) * evbar_L u_den = evbar_L (u_num * (u_den⁻¹ * u_den)) := by
          rw [← map_mul, mul_assoc]
        _ = evbar_L u_num := by rw [inv_mul_cancel₀ hu_den_ne, mul_one]
        _ = ι_E x_z.1 := hu_num
        _ = ι_E (b_z * s_z.1.1) := by rw [hbs']
        _ = (z * ι_E m_e.1) * ι_E s_z.1.1 := by rw [map_mul, hzm']
        _ = z * evbar_L u_den := by rw [mul_assoc, hu_den_eq]
    let e_field : F_θ ≃+* E_m :=
      RingEquiv.ofBijective evbar_L ⟨RingHom.kerLift_injective ev_L.toRingHom, hevbar_surj⟩
    haveI : IsDomain E_m :=
      Function.Injective.isDomain e_field.symm.toRingHom e_field.symm.injective
    exact Function.Injective.isDomain ι_E hinj_E
  have h_step5 : ∀ (B : Type u) [CommRing B], _root_.IsReduced B → (minimalPrimes B).Finite →
      ∀ (m : Ideal B) [m.IsPrime], IsDomain (Localization.AtPrime m) →
      ∃ s : B, s ∉ m ∧ IsDomain (Localization.Away s) := by
    clear! A₀ B m
    intro B _ hRed hFinMin m _ hDom_m
    haveI : _root_.IsReduced B := hRed
    let B_m : Type u := Localization.AtPrime m
    haveI : IsDomain B_m := hDom_m
    let q_bot : Ideal B := Ideal.comap (algebraMap B B_m) (⊥ : Ideal B_m)
    have hq_bot_prime : q_bot.IsPrime := by
      rw [Ideal.isPrime_iff]
      refine ⟨fun htop => ?_, fun {x y} hxy => ?_⟩
      · have h1 : (1 : B) ∈ q_bot := htop ▸ Submodule.mem_top
        have h10 : algebraMap B B_m 1 = 0 := h1
        rw [map_one] at h10
        obtain ⟨u_ne, v_ne, huv_ne⟩ := hDom_m.exists_pair_ne
        apply huv_ne
        calc
          u_ne = u_ne * 1 := (mul_one u_ne).symm
          _ = u_ne * 0 := by rw [h10]
          _ = 0 := mul_zero u_ne
          _ = v_ne * 0 := (mul_zero v_ne).symm
          _ = v_ne * 1 := by rw [← h10]
          _ = v_ne := mul_one v_ne
      · have hmul0 : algebraMap B B_m x * algebraMap B B_m y = 0 := by
          rw [← map_mul]; exact hxy
        by_cases hx0 : algebraMap B B_m x = 0
        · exact Or.inl hx0
        · have hreg : algebraMap B B_m x * algebraMap B B_m y =
              algebraMap B B_m x * 0 := by
            rw [mul_zero]; exact hmul0
          exact Or.inr (hDom_m.mul_left_cancel_of_ne_zero hx0 hreg)
    haveI : q_bot.IsPrime := hq_bot_prime
    have hq_bot_le : ∀ (p : Ideal B) [p.IsPrime], p ≤ m → q_bot ≤ p := by
      intro p _ hpm x hx
      have hx_zero : algebraMap B B_m x = 0 := hx
      have hx0 : algebraMap B B_m x = algebraMap B B_m 0 := by rw [hx_zero, map_zero]
      obtain ⟨c, hcx⟩ := (IsLocalization.eq_iff_exists m.primeCompl B_m).mp hx0
      have hcx0 : c.1 * x = 0 := by
        change c.1 * x = c.1 * 0 at hcx
        rwa [mul_zero] at hcx
      have hc_not_p : c.1 ∉ p := fun hcp => c.2 (hpm hcp)
      exact (‹p.IsPrime›.mem_or_mem (hcx0 ▸ p.zero_mem)).resolve_left hc_not_p
    have hq_bot_le_m : q_bot ≤ m := hq_bot_le m le_rfl
    have hmin_unique : ∀ p ∈ minimalPrimes B, p ≤ m → p = q_bot := by
      intro p hp hpm
      haveI : p.IsPrime := hp.1.1
      have hle : q_bot ≤ p := hq_bot_le p hpm
      exact le_antisymm (hp.2 ⟨hq_bot_prime, bot_le⟩ hle) hle
    let S_other : Set (Ideal B) := minimalPrimes B \ {q_bot}
    have hFin_other : S_other.Finite := hFinMin.sdiff
    let F : Finset (Ideal B) := hFin_other.toFinset
    classical
    let f : Ideal B → B := fun p =>
      if hp : ∃ b ∈ p, b ∉ m then Classical.choose hp else 1
    have hf_spec : ∀ p ∈ F, f p ∈ p ∧ f p ∉ m := by
      intro p hpF
      have hpS : p ∈ S_other := hFin_other.mem_toFinset.mp hpF
      have hp_not_le : ¬ (p ≤ m) := fun hpm => hpS.2 (hmin_unique p hpS.1 hpm)
      have hex : ∃ b ∈ p, b ∉ m := SetLike.not_le_iff_exists.mp hp_not_le
      simp only [f, hex, ↓reduceDIte]
      exact Classical.choose_spec hex
    let s : B := ∏ p ∈ F, f p
    have hs_not_m : s ∉ m := by
      suffices ∀ (G : Finset (Ideal B)), (∀ p ∈ G, f p ∉ m) → (∏ p ∈ G, f p) ∉ m from
        this F (fun p hp => (hf_spec p hp).2)
      intro G
      refine Finset.induction_on G ?_ ?_
      · intro _ h1m
        exact ‹m.IsPrime›.ne_top (m.eq_top_iff_one.mpr (by simpa only [Finset.prod_empty] using h1m))
      · intro p G' hpG' ih hG
        rw [Finset.prod_insert hpG']
        exact ‹m.IsPrime›.mul_notMem (hG p (Finset.mem_insert_self p G'))
          (ih fun q hq => hG q (Finset.mem_insert_of_mem hq))
    have hs_mem_other : ∀ p ∈ F, s ∈ p := by
      intro p hpF
      obtain ⟨w, hw⟩ := Finset.dvd_prod_of_mem f hpF
      change (∏ i ∈ F, f i) ∈ p
      rw [hw]
      exact p.mul_mem_right w (hf_spec p hpF).1
    have hsa_zero : ∀ a ∈ q_bot, s * a = 0 := by
      intro a ha
      have hmem_sInf : s * a ∈ sInf {Q : Ideal B | Q.IsPrime} := by
        rw [Ideal.mem_sInf]
        intro Q hQ
        haveI : Q.IsPrime := hQ
        obtain ⟨p, hp_min, hp_le_Q⟩ := @Ideal.exists_minimalPrimes_le B _ ⊥ Q _ bot_le
        by_cases hp_eq : p = q_bot
        · subst hp_eq
          exact Q.mul_mem_left s (hp_le_Q ha)
        · have hpF : p ∈ F := hFin_other.mem_toFinset.mpr ⟨hp_min, hp_eq⟩
          exact Q.mul_mem_right a (hp_le_Q (hs_mem_other p hpF))
      rw [← nilradical_eq_sInf B, mem_nilradical] at hmem_sInf
      exact hmem_sInf.eq_zero
    let B_s : Type u := Localization.Away s
    let ι_s : B →+* B_s := algebraMap B B_s
    have hbot_prime : (⊥ : Ideal B_s).IsPrime := by
      rw [Ideal.isPrime_iff]
      refine ⟨?_, ?_⟩
      · intro htop
        have h1_bot : (1 : B_s) ∈ (⊥ : Ideal B_s) := htop ▸ Submodule.mem_top
        have h1_eq_0 : (1 : B_s) = 0 := Ideal.mem_bot.mp h1_bot
        have h10 : ι_s 1 = ι_s 0 := by rw [map_one, map_zero, h1_eq_0]
        obtain ⟨⟨_, k, rfl⟩, hsk⟩ := (IsLocalization.eq_iff_exists (Submonoid.powers s) B_s).mp h10
        have hsk0 : s ^ k = 0 := by
          change s ^ k * 1 = s ^ k * 0 at hsk
          rwa [mul_one, mul_zero] at hsk
        have hsk_m : s ^ k ∈ m := hsk0 ▸ m.zero_mem
        exact hs_not_m (‹m.IsPrime›.mem_of_pow_mem k hsk_m)
      · intro x y hxy
        rw [Ideal.mem_bot] at hxy ⊢
        rw [Ideal.mem_bot]
        obtain ⟨⟨a, c_x⟩, hax⟩ := IsLocalization.surj (Submonoid.powers s) x
        obtain ⟨⟨b, c_y⟩, hby⟩ := IsLocalization.surj (Submonoid.powers s) y
        have hab0 : ι_s (a * b) = ι_s 0 := by
          rw [map_mul, map_zero, ← hax, ← hby]
          calc
            (x * ι_s c_x.1) * (y * ι_s c_y.1) = (x * y) * (ι_s c_x.1 * ι_s c_y.1) := by ring
            _ = 0 := by rw [hxy, zero_mul]
        obtain ⟨⟨_, k, rfl⟩, hsk_ab⟩ := (IsLocalization.eq_iff_exists (Submonoid.powers s) B_s).mp hab0
        have hsk_ab0 : s ^ k * (a * b) = 0 := by
          change s ^ k * (a * b) = s ^ k * 0 at hsk_ab
          rwa [mul_zero] at hsk_ab
        have hsk_not_q : s ^ k ∉ q_bot :=
          fun hmem => hs_not_m (hq_bot_le_m (hq_bot_prime.mem_of_pow_mem k hmem))
        have hab_q : a * b ∈ q_bot :=
          (hq_bot_prime.mem_or_mem (hsk_ab0 ▸ q_bot.zero_mem)).resolve_left hsk_not_q
        rcases hq_bot_prime.mem_or_mem hab_q with ha_q | hb_q
        · left
          have hsa : s * a = 0 := hsa_zero a ha_q
          have hunit_cx : IsUnit (ι_s c_x.1 * ι_s s) :=
            (IsLocalization.map_units B_s c_x).mul
              (IsLocalization.map_units B_s ⟨s, Submonoid.mem_powers s⟩)
          apply hunit_cx.mul_left_eq_zero.mp
          calc
            x * (ι_s c_x.1 * ι_s s) = (x * ι_s c_x.1) * ι_s s := by ring
            _ = ι_s a * ι_s s := by rw [hax]
            _ = ι_s (s * a) := by rw [← map_mul, mul_comm]
            _ = 0 := by rw [hsa, map_zero]
        · right
          have hsb : s * b = 0 := hsa_zero b hb_q
          have hunit_cy : IsUnit (ι_s c_y.1 * ι_s s) :=
            (IsLocalization.map_units B_s c_y).mul
              (IsLocalization.map_units B_s ⟨s, Submonoid.mem_powers s⟩)
          apply hunit_cy.mul_left_eq_zero.mp
          calc
            y * (ι_s c_y.1 * ι_s s) = (y * ι_s c_y.1) * ι_s s := by ring
            _ = ι_s b * ι_s s := by rw [hby]
            _ = ι_s (s * b) := by rw [← map_mul, mul_comm]
            _ = 0 := by rw [hsb, map_zero]
    exact ⟨s, hs_not_m, @IsDomain.of_bot_isPrime B_s _ hbot_prime⟩
  obtain ⟨hRed, hFinMin⟩ :=
    @h_step1 A₀ B instCommA₀ instDomA₀ instCommB instAlgA₀B instEtA₀B
  have hn_le_nzd : n.primeCompl ≤ nonZeroDivisors A₀ := by
    intro a ha
    rw [mem_nonZeroDivisors_iff_right]
    intro x hxa
    have ha0 : a ≠ 0 := fun h0 => ha (h0 ▸ n.zero_mem)
    have hreg : x * a = 0 * a := by rw [zero_mul]; exact hxa
    exact instDomA₀.mul_right_cancel_of_ne_zero ha0 hreg
  have hDomA₁ : IsDomain A₁ :=
    @IsLocalization.isDomain_localization A₀ _ instDomA₀ n.primeCompl hn_le_nzd
  have hICA₁ : IsIntegrallyClosed A₁ :=
    @isIntegrallyClosed_of_isLocalization A₀ A₁ instCommA₀ _ _ hICA₀
      instDomA₀ n.primeCompl hn_le_nzd _
  obtain ⟨hUnram, hLocHom, hTF₁, hSep, hMax, R₁, hFinR₁, hIntR₁, hLocR₁⟩ := h_step2
  obtain ⟨θ, hIntθ, hLocθ⟩ :=
    @h_step3 A₁ B_m _ _ _ _ _ hLocHom hSep hMax R₁ hFinR₁ hIntR₁ hLocR₁
  have hDom_m : IsDomain B_m :=
    @h_step4 A₁ B_m _ hDomA₁ hICA₁ _ _ _ hTF₁ hUnram θ hIntθ hLocθ
  exact @h_step5 B instCommB hRed hFinMin m instPrimeM hDom_m

