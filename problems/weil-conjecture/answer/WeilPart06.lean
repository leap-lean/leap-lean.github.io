        let q_mD := (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk p_u) :
          Z.presheaf.obj (Opposite.op U₀) ⟶ CommRingCat.of D_u)).base m_D
        have hqmD_eq : pz0.asIdeal = q_mD.asIdeal :=
          hpz0_max.eq_of_le q_mD.isPrime.ne_top hpz0_le
        have hpt_eq : q_mD = pz0 := PrimeSpectrum.ext hqmD_eq.symm
        change hU0.fromSpec.base q_mD = z₀
        rw [hpt_eq, hU0.fromSpec_primeIdealOf ⟨z₀, hz0_U⟩]
      have hιD_gZ : ι_D ≫ g_Z = AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ_Du) := by
        change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk p_u)) ≫
          hU0.fromSpec) ≫ g_Z = _
        rw [CategoryTheory.Category.assoc,
          ← AlgebraicGeometry.Spec.map_preimage (hU0.fromSpec ≫ g_Z),
          ← AlgebraicGeometry.Spec.map_comp]
        rfl
