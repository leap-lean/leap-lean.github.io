    obtain ⟨β_br, _, hβ_C, hβ_u, hβ_s⟩ :=
      C₀_lift_pkg (Polynomial.C.comp ρ) Polynomial.X 0 hβ_rel
    have hβ_p₀ : β_br.comp p₀ = τ_br := by
      apply Polynomial.ringHom_ext
      · intro b
        change β_br (p₀ (Polynomial.C b)) = τ_br (Polynomial.C b)
