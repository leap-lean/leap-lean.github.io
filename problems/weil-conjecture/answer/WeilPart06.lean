import WeilPart05
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem weil_overlap_linear_blowup_ring_and_branch_algebra (B : Type u) [CommRing B] (s c π : B) (hs : IsUnit s) :
    let A := Polynomial B
    let u : A := Polynomial.C s * Polynomial.X - Polynomial.C c
    let C₀ := MvPolynomial (Fin 2) B ⧸
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C π}
    let u_tilde : C₀ := Ideal.Quotient.mk _ (MvPolynomial.X 0)
    let s₀ : C₀ := Ideal.Quotient.mk _ (MvPolynomial.X 1)
    let C₁ := Polynomial B
    let t₁ : C₁ := Polynomial.X
    let C₀₁ := Localization.Away t₁
    let f₁₀ : C₁ →+* C₀₁ := algebraMap C₁ C₀₁
    ∃ (p₀ : A →+* C₀) (p₁ : A →+* C₁) (f₀₁ : C₀ →+* C₀₁),
      p₀.comp Polynomial.C = (Ideal.Quotient.mk _).comp MvPolynomial.C ∧
      p₁.comp Polynomial.C = Polynomial.C ∧
      p₀ u = u_tilde ∧
      p₁ u = Polynomial.C π * t₁ ∧
      @IsLocalization.Away C₀ _ s₀ C₀₁ _ f₀₁.toAlgebra ∧
      f₀₁.comp p₀ = f₁₀.comp p₁ ∧
      f₁₀ t₁ * f₀₁ s₀ = 1 ∧
      Subring.closure (Set.range p₀ ∪ {s₀}) = ⊤ ∧
      Subring.closure (Set.range p₁ ∪ {t₁}) = ⊤ ∧
      (∀ q : PrimeSpectrum C₁, p₁ u ∉ q.asIdeal → t₁ ∉ q.asIdeal) ∧
      @IsLocalization.Away A _ u (Localization.Away (p₀ u)) _
        ((algebraMap C₀ (Localization.Away (p₀ u))).comp p₀).toAlgebra ∧
      (∀ q : PrimeSpectrum C₀, p₀ (Polynomial.C π) ∉ q.asIdeal → s₀ ∉ q.asIdeal) ∧
      @IsLocalization.Away A _ (Polynomial.C π) (Localization.Away (p₁ (Polynomial.C π))) _
        ((algebraMap C₁ (Localization.Away (p₁ (Polynomial.C π)))).comp p₁).toAlgebra ∧
      ∀ (κ : Type u) [CommRing κ] (ρ : B →+* κ),
        ρ π = 0 →
        ∃ (τ_br : A →+* Polynomial κ) (ε_A : A →+* κ) (β_br : C₀ →+* Polynomial κ),
          τ_br.comp Polynomial.C = Polynomial.C.comp ρ ∧
          τ_br u = Polynomial.X ∧
          (Polynomial.evalRingHom 0).comp τ_br = ε_A ∧
          ε_A.comp Polynomial.C = ρ ∧
          ε_A u = 0 ∧
          ε_A (Polynomial.C π) = 0 ∧
          (∀ (D : Type u) [CommRing D] (ι_κ : κ →+* D) (φ_D : A →+* D),
            φ_D.comp Polynomial.C = ι_κ.comp ρ →
            (Polynomial.eval₂RingHom ι_κ (φ_D u)).comp τ_br = φ_D) ∧
          β_br.comp p₀ = τ_br ∧
          ∀ (R_κ0 R_κ1 : Type u) [CommRing R_κ0] [CommRing R_κ1]
            (c_κ0 : κ →+* R_κ0) (t_κ01 : R_κ0)
            (c_κ1 : κ →+* R_κ1) (t_κ10 : R_κ1),
            ∃ (α₀ : C₀ →+* R_κ0) (α₁ : C₁ →+* R_κ1),
              α₀.comp p₀ = c_κ0.comp ε_A ∧
              α₀ s₀ = t_κ01 ∧
              α₁.comp p₁ = c_κ1.comp ε_A ∧
              α₁ t₁ = t_κ10 ∧
              ∀ (ψ : R_κ0 →+* κ),
                ψ.comp c_κ0 = RingHom.id κ →
                ψ t_κ01 = 0 →
                (Polynomial.evalRingHom 0).comp β_br = ψ.comp α₀ :=
by
  intro A u C₀ u_tilde s₀ C₁ t₁ C₀₁ f₁₀
  
  obtain ⟨u_s, hu_s⟩ := hs
  let s_inv : B := ↑(u_s⁻¹)
  have hss_inv : s * s_inv = 1 := by
    rw [← hu_s, ← Units.val_mul, mul_inv_cancel, Units.val_one]
  have hs_invs : s_inv * s = 1 := by
    rw [mul_comm, hss_inv]
  have hX_from_u : Polynomial.C s_inv * (u + Polynomial.C c) = Polynomial.X := by
    dsimp only [u]
    rw [sub_add_cancel, ← mul_assoc, ← map_mul Polynomial.C, hs_invs, map_one, one_mul]
  have poly_subring_eq_top : ∀ (S : Subring (Polynomial B)),
      (∀ b : B, Polynomial.C b ∈ S) →
      Polynomial.X ∈ S →
      S = ⊤ := by
    intro S hC hX
    have hP : ∀ P : Polynomial B, P ∈ S := by
      intro P
      induction P using Polynomial.induction_on with
      | C b => exact hC b
      | add p q hp hq => exact S.add_mem hp hq
      | monomial n b _ => exact S.mul_mem (hC b) (S.pow_mem hX (n + 1))
    exact eq_top_iff.mpr fun P _ => hP P
  
  let I₀ : Ideal (MvPolynomial (Fin 2) B) :=
    Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C π}
  let mk₀ : MvPolynomial (Fin 2) B →+* C₀ := Ideal.Quotient.mk I₀
  let ι₀ : B →+* C₀ := mk₀.comp MvPolynomial.C
  have hC₀_rel : u_tilde * s₀ = ι₀ π := by
    have hmem : MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C π ∈ I₀ :=
      Ideal.mem_span_singleton_self _
    have hzero : mk₀ (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C π) = 0 :=
      (Ideal.Quotient.eq_zero_iff_mem).mpr hmem
    rw [map_sub, map_mul] at hzero
    exact sub_eq_zero.mp hzero
  have C₀_lift_pkg : ∀ {R : Type u} [CommRing R] (φ₀ : B →+* R) (x₀ x₁ : R),
      x₀ * x₁ = φ₀ π →
      ∃ (g : C₀ →+* R),
        g.comp ι₀ = φ₀ ∧
        (∀ b : B, g (ι₀ b) = φ₀ b) ∧
        g u_tilde = x₀ ∧
        g s₀ = x₁ := by
    intro R _ φ₀ x₀ x₁ hrel
    let ev : MvPolynomial (Fin 2) B →+* R := MvPolynomial.eval₂Hom φ₀ ![x₀, x₁]
    have hker : ∀ f ∈ I₀, ev f = 0 := by
      intro f hf
      obtain ⟨q, rfl⟩ := Ideal.mem_span_singleton.mp hf
      have hgen : ev (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C π) = 0 := by
        dsimp only [ev]
        rw [map_sub, map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X',
          MvPolynomial.eval₂Hom_C, Matrix.cons_val_zero, Matrix.cons_val_one,
          Matrix.cons_val_zero, hrel, sub_self]
      rw [map_mul, hgen, zero_mul]
    let g : C₀ →+* R := Ideal.Quotient.lift I₀ ev hker
    have hg_C : ∀ b : B, g (ι₀ b) = φ₀ b := by
      intro b
      change Ideal.Quotient.lift I₀ ev hker (Ideal.Quotient.mk I₀ (MvPolynomial.C b)) = φ₀ b
      rw [Ideal.Quotient.lift_mk]
      exact MvPolynomial.eval₂Hom_C φ₀ ![x₀, x₁] b
    have hg_X0 : g u_tilde = x₀ := by
      change Ideal.Quotient.lift I₀ ev hker (Ideal.Quotient.mk I₀ (MvPolynomial.X 0)) = x₀
      rw [Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_X', Matrix.cons_val_zero]
    have hg_X1 : g s₀ = x₁ := by
      change Ideal.Quotient.lift I₀ ev hker (Ideal.Quotient.mk I₀ (MvPolynomial.X 1)) = x₁
      rw [Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_X', Matrix.cons_val_one, Matrix.cons_val_zero]
    exact ⟨g, RingHom.ext hg_C, hg_C, hg_X0, hg_X1⟩
  have C₀_hom_ext : ∀ {R : Type u} [CommRing R] {g₁ g₂ : C₀ →+* R},
      (∀ b : B, g₁ (ι₀ b) = g₂ (ι₀ b)) →
      g₁ u_tilde = g₂ u_tilde →
      g₁ s₀ = g₂ s₀ →
      g₁ = g₂ := by
    intro R _ g₁ g₂ hC hX0 hX1
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext
    · intro b
      exact hC b
    · intro i
      fin_cases i
      · exact hX0
      · exact hX1
  have C₀_subring_eq_top : ∀ (S : Subring C₀),
      (∀ b : B, ι₀ b ∈ S) →
      u_tilde ∈ S →
      s₀ ∈ S →
      S = ⊤ := by
    intro S hC hX0 hX1
    rw [eq_top_iff]
    intro z _
    obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective z
    refine @MvPolynomial.induction_on B (Fin 2) _ (fun P => mk₀ P ∈ S) F ?_ ?_ ?_
    · intro b
      exact hC b
    · intro p q hp hq
      rw [map_add]
      exact S.add_mem hp hq
    · intro p i hp
      rw [map_mul]
      refine S.mul_mem hp ?_
      fin_cases i
      · exact hX0
      · exact hX1
  
  have away_lift_pkg : ∀ {R₀ R₁ : Type u} [CommRing R₀] [CommRing R₁]
      (f : R₀ →+* R₁) (x : R₀) (v : R₁),
      f x * v = 1 →
      ∃ (α : Localization.Away x →+* R₁),
        (∀ a : R₀, α (algebraMap R₀ (Localization.Away x) a) = f a) ∧
        α (IsLocalization.Away.invSelf (S := Localization.Away x) x) = v := by
    intro R₀ R₁ _ _ f x v hfv
    letI : Algebra R₀ R₁ := f.toAlgebra
    have hfx : IsUnit (algebraMap R₀ R₁ x) :=
      isUnit_iff_exists.mpr ⟨v, hfv, by rw [mul_comm]; exact hfv⟩
    let α : Localization.Away x →+* R₁ :=
      IsLocalization.Away.lift (S := Localization.Away x) x hfx
    have hα_alg : ∀ a : R₀, α (algebraMap R₀ (Localization.Away x) a) = f a := by
      intro a
      exact IsLocalization.Away.lift_eq (S := Localization.Away x) x hfx a
    have hα_inv : α (IsLocalization.Away.invSelf (S := Localization.Away x) x) = v := by
      have h1 : f x * α (IsLocalization.Away.invSelf (S := Localization.Away x) x) = 1 := by
        rw [← hα_alg x, ← map_mul, IsLocalization.Away.mul_invSelf, map_one]
      calc α (IsLocalization.Away.invSelf (S := Localization.Away x) x)
          = 1 * α (IsLocalization.Away.invSelf (S := Localization.Away x) x) := (one_mul _).symm
        _ = (v * f x) * α (IsLocalization.Away.invSelf (S := Localization.Away x) x) := by
            rw [mul_comm v (f x), hfv]
        _ = v * (f x * α (IsLocalization.Away.invSelf (S := Localization.Away x) x)) :=
            mul_assoc _ _ _
        _ = v * 1 := by rw [h1]
        _ = v := mul_one v
    exact ⟨α, hα_alg, hα_inv⟩
  have isLoc_of_ret : ∀ {R₀ R₁ : Type u} [CommRing R₀] [CommRing R₁]
      (x : R₀) (f : R₀ →+* R₁)
      (α : Localization.Away x →+* R₁)
      (β : R₁ →+* Localization.Away x),
      (∀ a : R₀, α (algebraMap R₀ (Localization.Away x) a) = f a) →
      (∀ a : R₀, β (f a) = algebraMap R₀ (Localization.Away x) a) →
      α.comp β = RingHom.id R₁ →
      @IsLocalization.Away R₀ _ x R₁ _ f.toAlgebra := by
    intro R₀ R₁ _ _ x f α β hα_alg hβ_f hαβ
    have hβα : β.comp α = RingHom.id (Localization.Away x) := by
      apply IsLocalization.ringHom_ext (Submonoid.powers x)
      exact RingHom.ext fun a => by
        simp only [RingHom.comp_apply, RingHom.id_apply, hα_alg, hβ_f]
    letI : Algebra R₀ R₁ := f.toAlgebra
    let e_ring : Localization.Away x ≃+* R₁ := RingEquiv.ofRingHom α β hαβ hβα
    let e_alg : Localization.Away x ≃ₐ[R₀] R₁ :=
      AlgEquiv.ofRingEquiv (f := e_ring) (fun a => hα_alg a)
    exact (IsLocalization.isLocalization_iff_of_algEquiv (Submonoid.powers x) e_alg).mp
      inferInstance
  
  let x₀_im : C₀ := ι₀ s_inv * (u_tilde + ι₀ c)
  let p₀ : A →+* C₀ := Polynomial.eval₂RingHom ι₀ x₀_im
  have hp₀_C_app : ∀ b : B, p₀ (Polynomial.C b) = ι₀ b := fun b => Polynomial.eval₂_C ι₀ x₀_im
  have hp₀_X : p₀ Polynomial.X = x₀_im := Polynomial.eval₂_X ι₀ x₀_im
  have hp₀_C : p₀.comp Polynomial.C = (Ideal.Quotient.mk _).comp MvPolynomial.C :=
    RingHom.ext hp₀_C_app
  have hp₀_u : p₀ u = u_tilde := by
    dsimp only [u]
    rw [map_sub, map_mul, hp₀_C_app s, hp₀_C_app c, hp₀_X]
    dsimp only [x₀_im]
    rw [← mul_assoc, ← map_mul ι₀, hss_inv, map_one, one_mul, add_sub_cancel_right]
  let x₁_im : C₁ := Polynomial.C s_inv * (Polynomial.C π * t₁ + Polynomial.C c)
  let p₁ : A →+* C₁ := Polynomial.eval₂RingHom Polynomial.C x₁_im
  have hp₁_C_app : ∀ b : B, p₁ (Polynomial.C b) = Polynomial.C b :=
    fun b => Polynomial.eval₂_C Polynomial.C x₁_im
  have hp₁_X : p₁ Polynomial.X = x₁_im := Polynomial.eval₂_X Polynomial.C x₁_im
  have hp₁_C : p₁.comp Polynomial.C = Polynomial.C :=
    RingHom.ext hp₁_C_app
  have hp₁_u : p₁ u = Polynomial.C π * t₁ := by
    dsimp only [u]
    rw [map_sub, map_mul, hp₁_C_app s, hp₁_C_app c, hp₁_X]
    dsimp only [x₁_im]
    rw [← mul_assoc, ← map_mul Polynomial.C, hss_inv, map_one, one_mul, add_sub_cancel_right]
  let κ₀₁ : B →+* C₀₁ := f₁₀.comp Polynomial.C
  let T : C₀₁ := f₁₀ t₁
  let T_inv : C₀₁ := IsLocalization.Away.invSelf (S := C₀₁) t₁
  have hTT_inv : T * T_inv = 1 :=
    IsLocalization.Away.mul_invSelf (S := C₀₁) t₁
  have hT_invT : T_inv * T = 1 := by
    rw [mul_comm, hTT_inv]
  have hf₀₁_rel : (κ₀₁ π * T) * T_inv = κ₀₁ π := by
    rw [mul_assoc, hTT_inv, mul_one]
  obtain ⟨f₀₁, _, hf₀₁_C, hf₀₁_u, hf₀₁_s⟩ :=
    C₀_lift_pkg κ₀₁ (κ₀₁ π * T) T_inv hf₀₁_rel
  have hinv : f₁₀ t₁ * f₀₁ s₀ = 1 := by
    change T * f₀₁ s₀ = 1
    rw [hf₀₁_s, hTT_inv]
  have hcomp : f₀₁.comp p₀ = f₁₀.comp p₁ := by
    apply Polynomial.ringHom_ext
    · intro b
      change f₀₁ (p₀ (Polynomial.C b)) = f₁₀ (p₁ (Polynomial.C b))
      rw [hp₀_C_app b, hf₀₁_C b, hp₁_C_app b]
      rfl
    · change f₀₁ (p₀ Polynomial.X) = f₁₀ (p₁ Polynomial.X)
      rw [hp₀_X, hp₁_X]
      dsimp only [x₀_im, x₁_im]
      rw [map_mul f₀₁, map_add f₀₁, hf₀₁_C s_inv, hf₀₁_u, hf₀₁_C c,
        map_mul f₁₀, map_add f₁₀, map_mul f₁₀]
      rfl
  have hgen₀ : Subring.closure (Set.range p₀ ∪ {s₀}) = ⊤ := by
    apply C₀_subring_eq_top
    · intro b
      exact Subring.subset_closure (Or.inl ⟨Polynomial.C b, hp₀_C_app b⟩)
    · exact Subring.subset_closure (Or.inl ⟨u, hp₀_u⟩)
    · exact Subring.subset_closure (Or.inr rfl)
  have hgen₁ : Subring.closure (Set.range p₁ ∪ {t₁}) = ⊤ := by
    apply poly_subring_eq_top
    · intro b
      exact Subring.subset_closure (Or.inl ⟨Polynomial.C b, hp₁_C_app b⟩)
    · exact Subring.subset_closure (Or.inr rfl)
  
  have hloc₀ : @IsLocalization.Away C₀ _ s₀ C₀₁ _ f₀₁.toAlgebra := by
    have hf₀₁_inv : f₀₁ s₀ * T = 1 := by
      rw [hf₀₁_s, hT_invT]
    obtain ⟨α₀, hα₀_alg, hα₀_inv⟩ := away_lift_pkg f₀₁ s₀ T hf₀₁_inv
    let L₀ := Localization.Away s₀
    let η₀ : C₀ →+* L₀ := algebraMap C₀ L₀
    let inv_s₀ : L₀ := IsLocalization.Away.invSelf (S := L₀) s₀
    have hη₀_inv : η₀ s₀ * inv_s₀ = 1 :=
      IsLocalization.Away.mul_invSelf (S := L₀) s₀
    have hinv_η₀ : inv_s₀ * η₀ s₀ = 1 := by
      rw [mul_comm, hη₀_inv]
    let φ_poly : C₁ →+* L₀ := Polynomial.eval₂RingHom (η₀.comp ι₀) inv_s₀
    have hφ_C : ∀ b : B, φ_poly (Polynomial.C b) = η₀ (ι₀ b) :=
      fun b => Polynomial.eval₂_C (η₀.comp ι₀) inv_s₀
    have hφ_X : φ_poly t₁ = inv_s₀ := Polynomial.eval₂_X (η₀.comp ι₀) inv_s₀
    have hφ_unit : φ_poly t₁ * η₀ s₀ = 1 := by
      rw [hφ_X, hinv_η₀]
    obtain ⟨β₀, hβ₀_alg, hβ₀_inv⟩ := away_lift_pkg φ_poly t₁ (η₀ s₀) hφ_unit
    have hβ₀_C : ∀ b : B, β₀ (κ₀₁ b) = η₀ (ι₀ b) := by
      intro b
      change β₀ (algebraMap C₁ C₀₁ (Polynomial.C b)) = η₀ (ι₀ b)
      rw [hβ₀_alg, hφ_C]
    have hβ₀_T : β₀ T = inv_s₀ := by
      change β₀ (algebraMap C₁ C₀₁ t₁) = inv_s₀
      rw [hβ₀_alg, hφ_X]
    have hβ₀_f₀₁ : β₀.comp f₀₁ = η₀ := by
      apply C₀_hom_ext
      · intro b
        rw [RingHom.comp_apply, hf₀₁_C b, hβ₀_C b]
      · rw [RingHom.comp_apply, hf₀₁_u, map_mul β₀, hβ₀_C π, hβ₀_T,
          ← hC₀_rel, map_mul η₀, mul_assoc, hη₀_inv, mul_one]
      · rw [RingHom.comp_apply, hf₀₁_s, hβ₀_inv]
    have hα₀β₀ : α₀.comp β₀ = RingHom.id C₀₁ := by
      apply IsLocalization.ringHom_ext (Submonoid.powers t₁)
      apply Polynomial.ringHom_ext
      · intro b
        change α₀ (β₀ (κ₀₁ b)) = κ₀₁ b
        rw [hβ₀_C b, hα₀_alg (ι₀ b), hf₀₁_C b]
      · change α₀ (β₀ T) = T
        rw [hβ₀_T, hα₀_inv]
    exact isLoc_of_ret s₀ f₀₁ α₀ β₀ hα₀_alg (fun z => RingHom.congr_fun hβ₀_f₀₁ z) hα₀β₀
  
  have hprime_u : ∀ q : PrimeSpectrum C₁, p₁ u ∉ q.asIdeal → t₁ ∉ q.asIdeal := by
    intro q hnot ht₁
    apply hnot
    rw [hp₁_u]
    exact q.asIdeal.mul_mem_left (Polynomial.C π) ht₁
  have hprime_π : ∀ q : PrimeSpectrum C₀, p₀ (Polynomial.C π) ∉ q.asIdeal → s₀ ∉ q.asIdeal := by
    intro q hnot hs₀
    apply hnot
    rw [hp₀_C_app π, ← hC₀_rel]
    exact q.asIdeal.mul_mem_left u_tilde hs₀
  have hloc_u :
      @IsLocalization.Away A _ u (Localization.Away (p₀ u)) _
        ((algebraMap C₀ (Localization.Away (p₀ u))).comp p₀).toAlgebra := by
    let M₀ := Localization.Away (p₀ u)
    let η_C₀ : C₀ →+* M₀ := algebraMap C₀ M₀
    let w₀_inv : M₀ := IsLocalization.Away.invSelf (S := M₀) (p₀ u)
    let f_u : A →+* M₀ := η_C₀.comp p₀
    have hf_u_inv : f_u u * w₀_inv = 1 :=
      IsLocalization.Away.mul_invSelf (S := M₀) (p₀ u)
    obtain ⟨α_u, hα_u_alg, hα_u_inv⟩ := away_lift_pkg f_u u w₀_inv hf_u_inv
    let L_u := Localization.Away u
    let η_u : A →+* L_u := algebraMap A L_u
    let u_inv : L_u := IsLocalization.Away.invSelf (S := L_u) u
    have hu_inv : η_u u * u_inv = 1 :=
      IsLocalization.Away.mul_invSelf (S := L_u) u
    have hψ_u_rel : η_u u * (η_u (Polynomial.C π) * u_inv) = (η_u.comp Polynomial.C) π := by
      calc η_u u * (η_u (Polynomial.C π) * u_inv)
          = η_u (Polynomial.C π) * (η_u u * u_inv) := by ring
        _ = η_u (Polynomial.C π) := by rw [hu_inv, mul_one]
    obtain ⟨ψ_u, _, hψ_u_C, hψ_u_u, hψ_u_s⟩ :=
      C₀_lift_pkg (η_u.comp Polynomial.C) (η_u u) (η_u (Polynomial.C π) * u_inv) hψ_u_rel
