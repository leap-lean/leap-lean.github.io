      rw [mem_closure_iff]
      intro o ho_open hxo
      let U_op : X.Opens := ⟨o, ho_open⟩
      have hxU : x ∈ U_op := hxo
      obtain ⟨U_aff, hU_aff_mem, hxU_aff, hU_aff_le⟩ :=
        (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
          (AlgebraicGeometry.Scheme.isBasis_affineOpens X)) hxU
      have hU_aff : AlgebraicGeometry.IsAffineOpen U_aff := hU_aff_mem
      obtain ⟨φ₀, _, hφ₀⟩ := hFuncX U_aff hU_aff ⟨⟨x, hxU_aff⟩⟩
      let pt₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of F)) := default
      have hfx_eq : f'.base (η_C.base pt₀) =
          hU_aff.fromSpec.base ((AlgebraicGeometry.Spec.map φ₀).base pt₀) := by
        change (η_C ≫ f').base pt₀ = (AlgebraicGeometry.Spec.map φ₀ ≫ hU_aff.fromSpec).base pt₀
        rw [hηC_f', hφ₀]
      have hfx_mem_U₀ : f'.base (η_C.base pt₀) ∈ (U_aff : Set ↥X) := by
        rw [hfx_eq, ← hU_aff.range_fromSpec]
        exact ⟨(AlgebraicGeometry.Spec.map φ₀).base pt₀, rfl⟩
      exact ⟨f'.base (η_C.base pt₀), hU_aff_le hfx_mem_U₀, ⟨η_C.base pt₀, rfl⟩⟩
    have : AlgebraicGeometry.Surjective f' :=
      AlgebraicGeometry.Surjective.of_universallyClosed_of_isDominant f'
    exact (AlgebraicGeometry.isIso_iff_isOpenImmersion_and_surjective f').mpr
      ⟨inferInstance, inferInstance⟩
  let r_0 : X ⟶ M := CategoryTheory.inv f' ≫ π_1
  have hr0_π : r_0 ≫ π = p_X := by
    dsimp only [r_0]
    rw [CategoryTheory.Category.assoc, hSq, CategoryTheory.IsIso.inv_hom_id_assoc]
  have hProp_r0 : AlgebraicGeometry.IsProper r_0 := by
    have : AlgebraicGeometry.IsProper (r_0 ≫ π) := by
      rw [hr0_π]
      exact hProp_pX
    have : AlgebraicGeometry.IsProper π := hProp_π
    exact AlgebraicGeometry.IsProper.of_comp r_0 π
  have hSurj_r0 : AlgebraicGeometry.Surjective r_0 := by
    have : AlgebraicGeometry.IsProper r_0 := hProp_r0
    have : AlgebraicGeometry.IsDominant π_1 := hDom_π1
    have : AlgebraicGeometry.IsDominant r_0 := inferInstance
    exact AlgebraicGeometry.Surjective.of_universallyClosed_of_isDominant r_0
  have hιX_r0 : ι_X ≫ r_0 = ι_M := by
    dsimp only [r_0]
    rw [← hqK_f', CategoryTheory.Category.assoc, CategoryTheory.IsIso.hom_inv_id_assoc, hqK_π1]
  exact ⟨r_0, hProp_r0, hSurj_r0, hr0_π, hιX_r0⟩

theorem weil_overlap_single_valuation_blowup_tower_step (K : Type u) [Field K] [IsSepClosed K]
    (m : ℕ) (V : ValuationSubring K) (hPkg : IsValuationRingAlgPackage m V)
    (hBl : HasOverlapElementaryBlowupOracle V)
    (hOpenη : AlgebraicGeometry.IsOpenImmersion
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (U_K : C_K.Opens)
    (Z : AlgebraicGeometry.Scheme.{u})
    (g_Z : Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (hSS_Z : IsStrictlySemistableCurveOverValuation V g_Z)
    (F : Type u) [Field F]
    (η_Z : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ Z)
    (hFunc_Z : IsSchemeFunctionField Z F η_Z)
    (X : AlgebraicGeometry.Scheme.{u})
    (g_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (p_X : X ⟶ Z)
    (η_X : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ X)
    (ι_X : U_K.toScheme ⟶ X)
    (W_target : ValuationSubring F)
    (hSS_X : IsStrictlySemistableCurveOverValuation V g_X)
    (hProp_pX : AlgebraicGeometry.IsProper p_X)
    (hComm_pX : p_X ≫ g_Z = g_X)
    (hη_pX : η_X ≫ p_X = η_Z)
    (hPb_X : CategoryTheory.IsPullback ι_X (U_K.ι ≫ p_K) g_X
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (hDiv : IsDivisorialClosedVal V g_Z η_Z W_target)
    (hUnres : ¬ IsValResolvedOnMod V g_Z p_X η_X W_target) :
    ∃ (X' : AlgebraicGeometry.Scheme.{u})
      (g_X' : X' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
      (f_step : X' ⟶ X)
      (η_X' : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ X')
      (ι_X' : U_K.toScheme ⟶ X'),
      IsStrictlySemistableCurveOverValuation V g_X' ∧
      AlgebraicGeometry.IsProper f_step ∧
      f_step ≫ g_X = g_X' ∧
      η_X' ≫ f_step = η_X ∧
      ι_X' ≫ f_step = ι_X ∧
      CategoryTheory.IsPullback ι_X' (U_K.ι ≫ p_K) g_X'
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)) ∧
      IsValResolvedOnMod V g_Z (f_step ≫ p_X) η_X' W_target ∧
      (∀ W : ValuationSubring F,
        IsValResolvedOnMod V g_Z p_X η_X W →
        IsValResolvedOnMod V g_Z (f_step ≫ p_X) η_X' W) ∧
      (IsSingleElementaryBlowupStep V g_X g_X' f_step ∨
        ∃ (X₁ : AlgebraicGeometry.Scheme.{u})
          (g₁ : X₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
          (f₁ : X₁ ⟶ X)
          (f₂ : X' ⟶ X₁),
          f_step = f₂ ≫ f₁ ∧
          IsSingleElementaryBlowupStep V g_X g₁ f₁ ∧
          IsSingleElementaryBlowupStep V g₁ g_X' f₂) :=
by
  
  have h_s2 :
      (∀ pt : AlgebraicGeometry.Spec (CommRingCat.of F),
        (g_Z.base (η_Z.base pt)).asIdeal = ⊥) ∧
      (∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Y₁ ⟶ Y₂)
          [AlgebraicGeometry.IsProper h]
          (W : ValuationSubring F)
          (η₁ : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ Y₁)
          (ψ₂ : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ Y₂),
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype) ≫ ψ₂ = η₁ ≫ h →
        ∃ ψ₁ : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ Y₁,
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype) ≫ ψ₁ = η₁ ∧
          ψ₁ ≫ h = ψ₂) ∧
      (∀ (X_c X' : AlgebraicGeometry.Scheme.{u})
          (g_c : X_c ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
          (g_X' : X' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
          (p_c : X_c ⟶ Z) (f : X' ⟶ X_c)
          (η_c : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ X_c)
          (ι_c : U_K.toScheme ⟶ X_c) (U_iso : X_c.Opens),
        AlgebraicGeometry.IsProper f →
        f ≫ g_c = g_X' →
        p_c ≫ g_Z = g_c →
        η_c ≫ p_c = η_Z →
        CategoryTheory.IsPullback ι_c (U_K.ι ≫ p_K) g_c
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)) →
        CategoryTheory.IsIso (f ∣_ U_iso) →
        (∀ x : X_c, (g_c.base x).asIdeal = ⊥ → x ∈ U_iso) →
        ∃ (η_X' : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ X')
          (ι_X' : U_K.toScheme ⟶ X'),
          η_X' ≫ f = η_c ∧
          ι_X' ≫ f = ι_c ∧
          CategoryTheory.IsPullback ι_X' (U_K.ι ≫ p_K) g_X'
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)) ∧
          (∀ W : ValuationSubring F,
            IsValResolvedOnMod V g_Z p_c η_c W →
            IsValResolvedOnMod V g_Z (f ≫ p_c) η_X' W) ∧
          (∀ (W : ValuationSubring F)
              (ψ_c : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ X_c),
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype) ≫ ψ_c = η_c →
            ∃ ψ_X' : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ X',
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype) ≫ ψ_X' = η_X' ∧
              ψ_X' ≫ f = ψ_c)) ∧
      (∀ (X' : AlgebraicGeometry.Scheme.{u}) (p_X' : X' ⟶ Z)
          (η_X' : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ X')
          (W : ValuationSubring F)
          (ψ_X' : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ X')
          (mW : AlgebraicGeometry.Spec (CommRingCat.of ↥W))
          (V_sm' : X'.Opens)
          (e' : V_sm'.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial ↥V)))
          (ψ_V : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ V_sm'.toScheme)
          (q : ↥W),
        mW.asIdeal = IsLocalRing.maximalIdeal ↥W →
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype) ≫ ψ_X' = η_X' →
        ψ_V ≫ V_sm'.ι = ψ_X' →
        (AlgebraicGeometry.Spec.preimage (ψ_V ≫ e')).hom Polynomial.X = q →
        (∀ P : Polynomial ↥V,
          (∃ i : ℕ, P.coeff i ∉ (g_Z.base ((ψ_X' ≫ p_X').base mW)).asIdeal) →
          Polynomial.eval₂ (AlgebraicGeometry.Spec.preimage (ψ_X' ≫ p_X' ≫ g_Z)).hom q P ∉
            IsLocalRing.maximalIdeal ↥W) →
        IsValResolvedOnMod V g_Z p_X' η_X' W) := by
    have hFieldPrimeBot : ∀ {L : Type u} [Field L] (q : PrimeSpectrum L), q.asIdeal = ⊥ := by
      intro L _ q
      ext x
      simp only [Ideal.mem_bot]
      exact ⟨fun hx => Classical.byContradiction fun hne =>
        q.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ hx (isUnit_iff_ne_zero.mpr hne)),
        fun h => h.symm ▸ q.asIdeal.zero_mem⟩
    have hgZ_gen_bot : ∀ pt : AlgebraicGeometry.Spec (CommRingCat.of F),
        (g_Z.base (η_Z.base pt)).asIdeal = ⊥ := by
      intro pt
      have hIntZ : AlgebraicGeometry.IsIntegral Z := hSS_Z.1
      have hFlatZ : AlgebraicGeometry.Flat g_Z := hSS_Z.2.1
      have hIrredZ : IrreducibleSpace ↥Z :=
        @AlgebraicGeometry.irreducibleSpace_of_isIntegral Z hIntZ
      obtain ⟨z₀⟩ := hIrredZ.toNonempty
      obtain ⟨U₀, hU₀, hz₀U₀, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := z₀) (U := ⊤) trivial
      have hneU₀ : Nonempty U₀ := ⟨⟨z₀, hz₀U₀⟩⟩
      obtain ⟨φ₀, hFrac₀, hη₀⟩ := hFunc_Z U₀ hU₀ ⟨⟨z₀, hz₀U₀⟩⟩
      have hDom₀ : IsDomain ↑(Z.presheaf.obj (Opposite.op U₀)) := inferInstance
      let _ : Algebra ↑(Z.presheaf.obj (Opposite.op U₀)) F := φ₀.hom.toAlgebra
      have hInj₀ : Function.Injective φ₀.hom :=
        @IsFractionRing.injective ↑(Z.presheaf.obj (Opposite.op U₀)) _ F _ _ hFrac₀
      let q₀ : AlgebraicGeometry.Spec (Z.presheaf.obj (Opposite.op U₀)) :=
        (AlgebraicGeometry.Spec.map φ₀).base pt
      have hq₀_bot : q₀.asIdeal = ⊥ := by
        have hpt_bot : pt.asIdeal = ⊥ := hFieldPrimeBot pt
        change Ideal.comap φ₀.hom pt.asIdeal = ⊥
        rw [hpt_bot, ← RingHom.ker_eq_comap_bot]
        exact (RingHom.injective_iff_ker_eq_bot φ₀.hom).mp hInj₀
      have hη_eq : η_Z.base pt = hU₀.fromSpec.base q₀ := by
        rw [← hη₀]; rfl
      let p_bot : PrimeSpectrum ↥V := ⟨⊥, ⟨bot_ne_top, fun hab => mul_eq_zero.mp hab⟩⟩
      have hp_spec : p_bot ⤳ g_Z.base (η_Z.base pt) :=
        (PrimeSpectrum.le_iff_specializes p_bot (g_Z.base (η_Z.base pt))).mp bot_le
      have hGenMap : GeneralizingMap g_Z.base :=
        @AlgebraicGeometry.Flat.generalizingMap _ _ g_Z hFlatZ
      obtain ⟨y, hy_spec, hy_eq⟩ := hGenMap hp_spec
      have hη_in_U₀ : η_Z.base pt ∈ (U₀ : Set Z) := by
        rw [hη_eq, ← AlgebraicGeometry.IsAffineOpen.range_fromSpec hU₀]
        exact ⟨q₀, rfl⟩
      have hy_in_U₀ : y ∈ (U₀ : Set Z) := hy_spec.mem_open U₀.isOpen hη_in_U₀
      rw [← AlgebraicGeometry.IsAffineOpen.range_fromSpec hU₀] at hy_in_U₀
      obtain ⟨q_y, rfl⟩ := hy_in_U₀
      have hqy_spec : q_y ⤳ q₀ := by
        rw [hη_eq] at hy_spec
        exact hU₀.fromSpec.isOpenEmbedding.isInducing.specializes_iff.mp hy_spec
      have hqy_le : q_y.asIdeal ≤ q₀.asIdeal :=
        (PrimeSpectrum.le_iff_specializes q_y q₀).mpr hqy_spec
      rw [hq₀_bot] at hqy_le
      have hqy_eq : q_y = q₀ := PrimeSpectrum.ext ((le_bot_iff.mp hqy_le).trans hq₀_bot.symm)
      rw [hη_eq, ← hqy_eq, hy_eq]
    have hValLift : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Y₁ ⟶ Y₂)
        [AlgebraicGeometry.IsProper h]
        (W : ValuationSubring F)
        (η₁ : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ Y₁)
        (ψ₂ : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ Y₂),
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype) ≫ ψ₂ = η₁ ≫ h →
        ∃ ψ₁ : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ Y₁,
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype) ≫ ψ₁ = η₁ ∧
          ψ₁ ≫ h = ψ₂ := by
      intro Y₁ Y₂ h hProp W η₁ ψ₂ hcomm
      have hEx : AlgebraicGeometry.ValuativeCriterion.Existence h := by
        apply AlgebraicGeometry.ValuativeCriterion.Existence.of_specializingMap
        have hUC : AlgebraicGeometry.UniversallyClosed h := inferInstance
        rw [AlgebraicGeometry.universallyClosed_eq] at hUC
        refine CategoryTheory.MorphismProperty.universally_mono ?_ h hUC
        intro A B g hg
        exact IsClosedMap.specializingMap hg
      let _ : Algebra ↥W F := W.subtype.toAlgebra
      have _ : IsFractionRing ↥W F := ValuationSubring.instIsFractionRingSubtypeMem W
      let sq : AlgebraicGeometry.ValuativeCommSq h :=
        ⟨↥W, F, η₁, ψ₂, ⟨hcomm.symm⟩⟩
      obtain ⟨l, hl1, hl2⟩ := (hEx sq).exists_lift
      exact ⟨l, hl1, hl2⟩
    have hFactorValOpen : ∀ {Y : AlgebraicGeometry.Scheme.{u}}
        {W : ValuationSubring F}
        (ψ : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ Y)
        (mW : AlgebraicGeometry.Spec (CommRingCat.of ↥W))
        (U : Y.Opens) (hU : AlgebraicGeometry.IsAffineOpen U),
        mW.asIdeal = IsLocalRing.maximalIdeal ↥W →
        ψ.base mW ∈ U →
        ∃ φ_U : Y.presheaf.obj (Opposite.op U) ⟶ CommRingCat.of ↥W,
          AlgebraicGeometry.Spec.map φ_U ≫ hU.fromSpec = ψ := by
      intro Y W ψ mW U hU hmW hmem
      have hmW_eq : mW = IsLocalRing.closedPoint ↥W := PrimeSpectrum.ext hmW
      have hRange : Set.range ψ.base ⊆ Set.range hU.fromSpec.base := by
        rw [AlgebraicGeometry.IsAffineOpen.range_fromSpec hU]
        rintro _ ⟨q, rfl⟩
        have hspec : q ⤳ mW := by
          rw [hmW_eq]
          exact IsLocalRing.specializes_closedPoint q
        exact (hspec.map ψ.continuous).mem_open U.isOpen hmem
      let l := AlgebraicGeometry.IsOpenImmersion.lift hU.fromSpec ψ hRange
      refine ⟨AlgebraicGeometry.Spec.preimage l, ?_⟩
      rw [AlgebraicGeometry.Spec.map_preimage]
      exact AlgebraicGeometry.IsOpenImmersion.lift_fac hU.fromSpec ψ hRange
    refine ⟨hgZ_gen_bot, hValLift, ?_, ?_⟩
    · intro X X' g_X g_X' p_X f η_X ι_X U_iso
        hProp_f hf_gX hpX_gZ hη_pX hPb_X hIso_U hGen_U
      let U'_iso : X'.Opens := (TopologicalSpace.Opens.map f.base).obj U_iso
      have hPb_res : CategoryTheory.IsPullback (f ∣_ U_iso) U'_iso.ι U_iso.ι f :=
        AlgebraicGeometry.isPullback_morphismRestrict f U_iso
      have hη_range : Set.range η_X.base ⊆ Set.range U_iso.ι.base := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        rintro _ ⟨pt, rfl⟩
        apply hGen_U
        have h1 : g_X.base (η_X.base pt) = g_Z.base (η_Z.base pt) := by
          rw [← hpX_gZ, ← hη_pX]; rfl
        rw [h1]
        exact hgZ_gen_bot pt
      let η_U := AlgebraicGeometry.IsOpenImmersion.lift U_iso.ι η_X hη_range
      let η_X' : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ X' :=
        η_U ≫ inv (f ∣_ U_iso) ≫ U'_iso.ι
      have hη_f : η_X' ≫ f = η_X := by
        change (η_U ≫ inv (f ∣_ U_iso) ≫ U'_iso.ι) ≫ f = η_X
        rw [Category.assoc, Category.assoc, ← hPb_res.w,
          ← Category.assoc (inv (f ∣_ U_iso)), IsIso.inv_hom_id, Category.id_comp]
        exact AlgebraicGeometry.IsOpenImmersion.lift_fac U_iso.ι η_X hη_range
      have hι_range : Set.range ι_X.base ⊆ Set.range U_iso.ι.base := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        rintro _ ⟨u, rfl⟩
        apply hGen_U
        have hcomm_u : (ι_X ≫ g_X).base u =
            ((U_K.ι ≫ p_K) ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)).base u := by
          rw [hPb_X.w]
        have hIdeal : (g_X.base (ι_X.base u)).asIdeal =
            Ideal.comap V.subtype (((U_K.ι ≫ p_K).base u).asIdeal) :=
          congrArg PrimeSpectrum.asIdeal hcomm_u
        rw [hIdeal]
        have hK_bot : ((U_K.ι ≫ p_K).base u).asIdeal = ⊥ :=
          hFieldPrimeBot ((U_K.ι ≫ p_K).base u)
        rw [hK_bot, ← RingHom.ker_eq_comap_bot]
        exact (RingHom.injective_iff_ker_eq_bot V.subtype).mp Subtype.val_injective
      let j_X := AlgebraicGeometry.IsOpenImmersion.lift U_iso.ι ι_X hι_range
      have hj_X : j_X ≫ U_iso.ι = ι_X :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac U_iso.ι ι_X hι_range
      let ι_X' : U_K.toScheme ⟶ X' := j_X ≫ inv (f ∣_ U_iso) ≫ U'_iso.ι
      have hι_f : ι_X' ≫ f = ι_X := by
        change (j_X ≫ inv (f ∣_ U_iso) ≫ U'_iso.ι) ≫ f = ι_X
        rw [Category.assoc, Category.assoc, ← hPb_res.w,
          ← Category.assoc (inv (f ∣_ U_iso)), IsIso.inv_hom_id, Category.id_comp, hj_X]
      have hPb_left : CategoryTheory.IsPullback
          (j_X ≫ inv (f ∣_ U_iso)) (𝟙 U_K.toScheme) (f ∣_ U_iso) j_X := by
        refine CategoryTheory.IsPullback.of_vert_isIso ⟨?_⟩
        rw [Category.assoc, IsIso.inv_hom_id, Category.comp_id, Category.id_comp]
      have hPb_top : CategoryTheory.IsPullback ι_X' (𝟙 U_K.toScheme) f ι_X := by
        have h1 := CategoryTheory.IsPullback.paste_horiz hPb_left hPb_res.flip
        simpa only [Category.assoc, hj_X] using h1
      have hPb_X' : CategoryTheory.IsPullback ι_X' (U_K.ι ≫ p_K) g_X'
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)) := by
        have h2 := CategoryTheory.IsPullback.paste_vert hPb_top hPb_X
        simpa only [Category.id_comp, hf_gX] using h2
      have hLift_ψ : ∀ (W : ValuationSubring F)
          (ψ_X : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ X),
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype) ≫ ψ_X = η_X →
          ∃ ψ_X' : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ X',
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype) ≫ ψ_X' = η_X' ∧
            ψ_X' ≫ f = ψ_X := by
        intro W ψ_X hη_ψ
        exact @hValLift X' X f hProp_f W η_X' ψ_X (hη_ψ.trans hη_f.symm)
      refine ⟨η_X', ι_X', hη_f, hι_f, hPb_X', ?_, hLift_ψ⟩
      intro W ⟨ψ_W, mW, U, hU, φ_U, f_sec, hmW, hη_ψW, hmW_U, hφU_spec, hPoly⟩
      obtain ⟨ψ_W', hη'_ψW', hψW'_f⟩ := hLift_ψ W ψ_W hη_ψW
      have hmW_fU : ψ_W'.base mW ∈ (TopologicalSpace.Opens.map f.base).obj U := by
        change f.base (ψ_W'.base mW) ∈ U
        have hpt : f.base (ψ_W'.base mW) = ψ_W.base mW := by
          rw [← hψW'_f]; rfl
        rw [hpt]; exact hmW_U
      obtain ⟨U', hU', hmW_U', hU'_sub⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
          (x := ψ_W'.base mW) (U := (TopologicalSpace.Opens.map f.base).obj U) hmW_fU
      have hU'_le : U' ≤ (TopologicalSpace.Opens.map f.base).obj U := hU'_sub
