            ∑ d ∈ F.support,
              HomogeneousLocalization.val (φ_a (dehomog (MvPolynomial.monomial d (F.coeff d)))) := by
          conv_lhs => rw [hF_sum, map_sum, map_sum]
          exact hval_sum F.support (fun d => φ_a (dehomog (MvPolynomial.monomial d (F.coeff d))))
        rw [hlhs]
        conv_rhs => rw [hF_sum]
        have hmon_eq : ∀ d ∈ F.support,
            HomogeneousLocalization.val (φ_a (dehomog (MvPolynomial.monomial d (F.coeff d)))) =
            Localization.mk (MvPolynomial.monomial d (F.coeff d))
              (⟨MvPolynomial.X a ^ m,
                (Submonoid.powers (MvPolynomial.X a)).pow_mem (Submonoid.mem_powers (MvPolynomial.X a)) m⟩ :
                Submonoid.powers (MvPolynomial.X a)) := by
