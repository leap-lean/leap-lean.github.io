  obtain ⟨η_UK, φ_KF, hηUK_Z, hFunc_UK, hFunc_M, hφ_V, hAlg⟩ := hPillar2

  
  
  
  have hFT_gen : ∀ {R B : Type u} [CommRing R] [CommRing B] (α : R →+* B),
      α.FiniteType →
      ∃ G : Finset B, ∀ (S : Subring B),
        (∀ r : R, α r ∈ S) → (∀ g ∈ G, g ∈ S) → ∀ b : B, b ∈ S := by
    intro R B _ _ α hFT
    let _ : Algebra R B := α.toAlgebra
    have _ : Algebra.FiniteType R B := hFT
    obtain ⟨G, hG⟩ := Algebra.FiniteType.out (R := R) (A := B)
    refine ⟨G, fun S hα hGS b => ?_⟩
    let A_S : Subalgebra R B :=
      { S with algebraMap_mem' := hα }
    have hle : Algebra.adjoin R (G : Set B) ≤ A_S :=
      Algebra.adjoin_le fun g hg => hGS g hg
    rw [hG] at hle
    exact hle Algebra.mem_top

  have hAlgClosed_crit : ∀ {V_ring W_ring : Type u} [CommRing V_ring] [CommRing W_ring]
      [IsLocalRing W_ring] (Q : Ideal V_ring) [Q.IsPrime] [IsAlgClosed Q.ResidueField]
      (θ : V_ring →+* W_ring)
      (hQ : Q = Ideal.comap θ (IsLocalRing.maximalIdeal W_ring)) (w : W_ring),
      (∀ P : Polynomial V_ring, (∃ i : ℕ, P.coeff i ∉ Q) →
        Polynomial.eval₂ θ w P ∉ IsLocalRing.maximalIdeal W_ring) ↔
      algebraMap W_ring (IsLocalRing.maximalIdeal W_ring).ResidueField w ∉
        (Ideal.ResidueField.map Q (IsLocalRing.maximalIdeal W_ring) θ hQ).fieldRange := by
    intro V_ring W_ring _ _ _ Q _ _ θ hQ w
    let mW : Ideal W_ring := IsLocalRing.maximalIdeal W_ring
    let κW := mW.ResidueField
    let resW : W_ring →+* κW := algebraMap W_ring κW
    let ιQ : Q.ResidueField →+* κW := Ideal.ResidueField.map Q mW θ hQ
    have h_comm : ιQ.comp (algebraMap V_ring Q.ResidueField) = resW.comp θ := by
      ext c
      exact Ideal.ResidueField.map_algebraMap Q mW θ hQ c
    constructor
    · intro hPoly ⟨z, hz⟩
      obtain ⟨⟨q₁, s₂⟩, hzs⟩ :=
        @IsLocalization.surj (V_ring ⧸ Q) _ (nonZeroDivisors (V_ring ⧸ Q)) Q.ResidueField _ _
          inferInstance z
      obtain ⟨c₁, rfl⟩ := Ideal.Quotient.mk_surjective q₁
      obtain ⟨c₂, hc₂_eq⟩ := Ideal.Quotient.mk_surjective s₂.1
      have hs₂_ne : s₂.1 ≠ 0 := nonZeroDivisors.ne_zero s₂.2
      have hc₂_not : c₂ ∉ Q := by
        intro hc₂Q
        apply hs₂_ne
        rw [← hc₂_eq, Ideal.Quotient.eq_zero_iff_mem]
        exact hc₂Q
      have hzs' : z * algebraMap V_ring Q.ResidueField c₂ = algebraMap V_ring Q.ResidueField c₁ := by
        have h0 : z * algebraMap (V_ring ⧸ Q) Q.ResidueField s₂.1 =
            algebraMap (V_ring ⧸ Q) Q.ResidueField (Ideal.Quotient.mk Q c₁) := hzs
        rw [← hc₂_eq] at h0
        exact h0
      let P₀ : Polynomial V_ring := Polynomial.C c₂ * Polynomial.X - Polynomial.C c₁
      have hP₀_coeff : P₀.coeff 1 ∉ Q := by
        have hc1 : P₀.coeff 1 = c₂ := by simp [P₀]
        rwa [hc1]
      apply hPoly P₀ ⟨1, hP₀_coeff⟩
      rw [← Ideal.algebraMap_residueField_eq_zero]
      change resW (Polynomial.eval₂ θ w P₀) = 0
      have hev : resW (Polynomial.eval₂ θ w P₀) =
          ιQ (algebraMap V_ring Q.ResidueField c₂) * resW w -
            ιQ (algebraMap V_ring Q.ResidueField c₁) := by
        have h_c2 : resW (θ c₂) = ιQ (algebraMap V_ring Q.ResidueField c₂) :=
          (congrFun (congrArg DFunLike.coe h_comm) c₂).symm
        have h_c1 : resW (θ c₁) = ιQ (algebraMap V_ring Q.ResidueField c₁) :=
          (congrFun (congrArg DFunLike.coe h_comm) c₁).symm
        simp [P₀, h_c2, h_c1]
      rw [hev, ← hz, ← map_mul, mul_comm, hzs', sub_self]
    · intro hw_not P ⟨i₀, hi₀⟩ h_in
      let P_bar : Polynomial Q.ResidueField := Polynomial.map (algebraMap V_ring Q.ResidueField) P
      have hPbar_ne : P_bar ≠ 0 := by
        intro h0
        have hc0 : P_bar.coeff i₀ = 0 := by rw [h0, Polynomial.coeff_zero]
        rw [Polynomial.coeff_map, Ideal.algebraMap_residueField_eq_zero] at hc0
        exact hi₀ hc0
      obtain ⟨m_roots, hm⟩ := Polynomial.splits_iff_exists_multiset.mp (IsAlgClosed.splits P_bar)
      have h_ev0 : Polynomial.eval₂ ιQ (resW w) P_bar = 0 := by
        rw [Polynomial.eval₂_map, h_comm, ← Polynomial.hom_eval₂]
        exact Ideal.algebraMap_residueField_eq_zero.mpr h_in
