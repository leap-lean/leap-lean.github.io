    · exact hx0
    · exact False.elim (hx_zero_not1 hx1)
  have hy_zero_0 : π.base x_zero ∈ D 0 := by
    change x_zero ∈ (TopologicalSpace.Opens.map π.base).obj (D 0)
    rwa [hPre0]
  have hy_zero_not1 : π.base x_zero ∉ D 1 := by
    intro hy1
