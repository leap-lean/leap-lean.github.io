        (Ideal.primeCompl_le_nonZeroDivisors (hAffWH.primeIdealOf ⟨z, hz_WH⟩).asIdeal)
    refine ⟨H_sch, ιH, hCl_ιH, hInt_Hsch, hRange_ιH, ?_⟩
    intro U hAffU hNeU
    let : Nonempty ↥(U : AlgebraicGeometry.Scheme.{u}) := hNeU
