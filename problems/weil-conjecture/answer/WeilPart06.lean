          (hAff_A : ∀ a : Fin (1 + 1), AlgebraicGeometry.IsAffineOpen (D_P1 a))
          (c_A : ∀ a : Fin (1 + 1), A →+* ↑(P₁.presheaf.obj (Opposite.op (D_P1 a))))
          (t_A : ∀ a : Fin (1 + 1), Fin (1 + 1) → ↑(P₁.presheaf.obj (Opposite.op (D_P1 a)))),
