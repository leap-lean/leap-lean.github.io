    refine ⟨Ω_0, Ω_1, hΩ0_ne, hΩ1_ne, f_0, s_1,
      hCov, hInter0, hInter1, hGerm0, hGerm1, hExt0, hExt1, hRecip, ?_⟩
    intro hPole
    have hZero : ∃ x_zero : ↥X_tilde, x_zero ∉ Ω_1 := by
      by_contra hNoZero
      have hTop1 : (⊤ : X_tilde.Opens) ≤ Ω_1 := by
        intro x _
        by_contra hx1
        exact hNoZero ⟨x, hx1⟩
      let s_top1 : ↑(X_tilde.presheaf.obj (Opposite.op ⊤)) :=
        (X_tilde.presheaf.map (CategoryTheory.homOfLE hTop1).op).hom s_1
      obtain ⟨c, hc_eq⟩ := hc_top_bij.2 s_top1
      let c_Ω1 : k₀ →+* ↑(X_tilde.presheaf.obj (Opposite.op Ω_1)) :=
        (isoSpec.inv ≫ p_tilde.appLE ⊤ Ω_1 le_top).hom
      have hc_res : c_Ω1 c = s_1 := by
        have hAppTop : p_tilde.appTop = p_tilde.appLE ⊤ (p_tilde ⁻¹ᵁ ⊤) le_rfl :=
          (AlgebraicGeometry.Scheme.Hom.appLE_eq_app p_tilde (U := ⊤)).symm
        have hStep : p_tilde.appTop ≫
            X_tilde.presheaf.map (CategoryTheory.homOfLE (le_top : Ω_1 ≤ ⊤)).op =
            p_tilde.appLE ⊤ Ω_1 le_top :=
          (congrArg (· ≫ X_tilde.presheaf.map (CategoryTheory.homOfLE (le_top : Ω_1 ≤ ⊤)).op)
            hAppTop).trans
            (AlgebraicGeometry.Scheme.Hom.appLE_map p_tilde (U := ⊤) le_rfl
              (CategoryTheory.homOfLE (le_top : Ω_1 ≤ ⊤)).op)
        have h1 : (X_tilde.presheaf.map (CategoryTheory.homOfLE (le_top : Ω_1 ≤ ⊤)).op).hom (c_top c) =
            c_Ω1 c :=
          congrArg (fun g => (isoSpec.inv ≫ g).hom c) hStep
        rw [← h1, hc_eq]
        dsimp [s_top1]
        rw [hResX]
        have hId : (CategoryTheory.homOfLE ((le_top : Ω_1 ≤ ⊤).trans hTop1)).op =
            𝟙 (Opposite.op Ω_1) := by
          have hHom : CategoryTheory.homOfLE ((le_top : Ω_1 ≤ ⊤).trans hTop1) = 𝟙 Ω_1 :=
            Subsingleton.elim _ _
          rw [hHom]; rfl
        rw [hId, CategoryTheory.Functor.map_id]
        rfl
      have hc_ne : c ≠ 0 := by
        intro hc0
        rw [hc0, map_zero] at hc_res
        rw [← hc_res, map_zero] at hGerm1
        exact inv_ne_zero hh hGerm1.symm
      have hs1_unit : IsUnit s_1 := by
        rw [← hc_res]
        exact (IsUnit.mk0 c hc_ne).map c_Ω1
      have hbo1 : X_tilde.basicOpen s_1 = Ω_1 := X_tilde.basicOpen_of_isUnit hs1_unit
      have hΩ1_le0 : Ω_1 ≤ Ω_0 := by
        intro x hx1
        have hx_inter : x ∈ Ω_0 ⊓ Ω_1 := by
          rw [hInter1, hbo1]
          exact hx1
        exact hx_inter.1
      obtain ⟨x_pole, hx_pole⟩ := hPole
      exact hx_pole (hΩ1_le0 (hTop1 trivial))
    have hInj0 := hInjCrit Ω_0 f_0 hPole
      (fun W _ s hs => (hExt0 W s (hs.trans hGerm0)).choose)
    have hInj1 := hInjCrit Ω_1 s_1 hZero
      (fun W _ r hr => (hExt1 W r (hr.trans hGerm1)).choose)
    obtain ⟨hAff0, hFin0⟩ :=
      weil_normal_curve_proper_chart_over_poly_isAffine_and_finite k₀ X_tilde p_tilde
        hProp hNorm hFinIntClosure Ω_0 f_0 hInj0 hPropQ0
    obtain ⟨hAff1, hFin1⟩ :=
      weil_normal_curve_proper_chart_over_poly_isAffine_and_finite k₀ X_tilde p_tilde
        hProp hNorm hFinIntClosure Ω_1 s_1 hInj1 hPropQ1
    exact ⟨hAff0, hAff1, hFin0, hFin1, hSurjQ0 hPole hZero⟩
  
  refine ⟨?_, ?_⟩
  · intro h hh
    obtain ⟨Ω_0, Ω_1, hΩ0_ne, hΩ1_ne, f_0, s_1,
      hCov, hInter0, hInter1, hGerm0, hGerm1, hExt0, hExt1, hRecip, hPoleImp⟩ := hMeroFull h hh
    refine ⟨Ω_0, Ω_1, hΩ0_ne, hΩ1_ne, f_0, s_1,
      hCov, hInter0, hInter1, hGerm0, hGerm1, hExt0, hExt1, hRecip, ?_⟩
    intro hPole
    obtain ⟨hAff0, hAff1, hFin0, hFin1, _⟩ := hPoleImp hPole
    exact ⟨hAff0, hAff1, hFin0, hFin1⟩
  · intro V_tilde hAffV hV_ne t_tilde ht_ne
    refine weil_normal_proper_curve_shifted_pole_chart_of_meromorphic
      k₀ X_tilde p_tilde hAppTopBij hFinCl ?_ V_tilde hAffV t_tilde ht_ne
    intro h hh
    obtain ⟨Ω_0, Ω_1, hΩ0_ne, hΩ1_ne, f_0, s_1,
      hCov, hInter0, hInter1, hGerm0, hGerm1, hExt0, hExt1, hRecip, hPoleImp⟩ := hMeroFull h hh
    refine ⟨Ω_0, Ω_1, hΩ0_ne, hΩ1_ne, f_0, s_1,
      hCov, hInter0, hInter1, hGerm0, hGerm1, hExt0, hExt1, hRecip, ?_⟩
    intro hPole
    obtain ⟨hAff0, _, _, _, hSurj0⟩ := hPoleImp hPole
    exact ⟨hAff0, hSurj0⟩

theorem weil_smooth_curve_open_etale_coord_and_pole_charts (k₀ : Type u) [Field k₀] [IsAlgClosed k₀]
    (Y : AlgebraicGeometry.Scheme.{u})
    (p_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of k₀))
    (U_part : Y.Opens)
    (hPartNe : Nonempty U_part)
    (hSmPart : AlgebraicGeometry.SmoothOfRelativeDimension 1 (U_part.ι ≫ p_Y)) :
    ∃ (V_0 : Y.Opens)
      (t_0 : ↑(Y.presheaf.obj (Opposite.op V_0))),
      V_0 ≤ U_part ∧
      AlgebraicGeometry.IsAffineOpen V_0 ∧
      Nonempty V_0 ∧
      (∀ c : k₀,
        t_0 - (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
          p_Y.appLE ⊤ V_0 le_top).hom c) ≠ 0) ∧
      (∀ c₀ : k₀,
        let τ_0 := t_0 -
          (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
            p_Y.appLE ⊤ V_0 le_top).hom c₀)
        (∃ y ∈ V_0, y ∉ Y.basicOpen τ_0) →
        ∃ (m_pts : ℕ)
          (σ_comp : Fin (m_pts + 1) → (AlgebraicGeometry.Spec (CommRingCat.of k₀) ⟶ Y))
          (e_idem : Fin (m_pts + 1) → ↑(Y.presheaf.obj (Opposite.op V_0))),
          (∀ j : Fin (m_pts + 1), σ_comp j ≫ p_Y = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k₀))) ∧
          Function.Injective (fun j : Fin (m_pts + 1) => (σ_comp j).base (⊥ : PrimeSpectrum k₀)) ∧
          (∀ j : Fin (m_pts + 1), (σ_comp j).base (⊥ : PrimeSpectrum k₀) ∈ V_0) ∧
          (V_0 : Set ↥Y) \ (Y.basicOpen τ_0 : Set ↥Y) =
            (⋃ j : Fin (m_pts + 1), Set.range (σ_comp j).base) ∧
          (∀ (w : ↑(Y.presheaf.obj (Opposite.op V_0))),
            w - 1 ∈ Ideal.span {τ_0} →
            ∀ j : Fin (m_pts + 1),
              let W_j : Y.Opens := Y.basicOpen (e_idem j * w)
              ∃ (hWj_le : W_j ≤ V_0)
                (u_j : ↑(Y.presheaf.obj (Opposite.op W_j))),
                AlgebraicGeometry.IsAffineOpen W_j ∧
                (σ_comp j).base (⊥ : PrimeSpectrum k₀) ∈ W_j ∧
                (∀ j' : Fin (m_pts + 1), j' ≠ j → (σ_comp j').base (⊥ : PrimeSpectrum k₀) ∉ W_j) ∧
                IsUnit u_j ∧
                u_j * (Y.presheaf.map (CategoryTheory.homOfLE hWj_le).op).hom w = 1 ∧
                (∃ hσ_le : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of k₀)).Opens) ≤
                    (TopologicalSpace.Opens.map (σ_comp j).base).obj W_j,
                  RingHom.ker (((σ_comp j).appLE W_j ⊤ hσ_le).hom) =
                    Ideal.span {(Y.presheaf.map (CategoryTheory.homOfLE hWj_le).op).hom τ_0}))) :=
by
  have hs1 :
      ∃ (V_0 : Y.Opens)
        (ψ_0 : Polynomial k₀ →+* ↑(Y.presheaf.obj (Opposite.op V_0))),
        V_0 ≤ U_part ∧
        AlgebraicGeometry.IsAffineOpen V_0 ∧
        Nonempty V_0 ∧
        ψ_0.comp Polynomial.C =
          (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
            p_Y.appLE ⊤ V_0 le_top).hom) ∧
        ψ_0.Etale ∧
        (∀ c : k₀,
          ψ_0 Polynomial.X -
            (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
              p_Y.appLE ⊤ V_0 le_top).hom c) ≠ 0) := by
    let S_k := AlgebraicGeometry.Spec (CommRingCat.of k₀)
    let f : U_part.toScheme ⟶ S_k := U_part.ι ≫ p_Y
    obtain ⟨x₀⟩ := hPartNe
    obtain ⟨U_op, hU_aff, V_op, hV_aff, hx₀, e, hStd⟩ :=
      (AlgebraicGeometry.smoothOfRelativeDimension_iff 1 f).mp hSmPart x₀
    have hU_top : U_op = ⊤ := top_unique fun q _ => by
      have hfx₀ : f.base x₀ ∈ U_op := e hx₀
      rwa [Subsingleton.elim q (f.base x₀)]
    subst hU_top
    let V_0 : Y.Opens := U_part.ι ''ᵁ V_op
    have hV0_le : V_0 ≤ U_part := by
      intro y hy
      rcases hy with ⟨z, _, rfl⟩
      exact z.2
    have hAffV0 : AlgebraicGeometry.IsAffineOpen V_0 :=
      hV_aff.image_of_isOpenImmersion U_part.ι
    have hV0_ne : Nonempty V_0 := ⟨⟨U_part.ι.base x₀, ⟨x₀, hx₀, rfl⟩⟩⟩
    have h_pre : V_op ≤ (TopologicalSpace.Opens.map U_part.ι.base).obj V_0 := by
      intro z hz
      exact ⟨z, hz, rfl⟩
    have h_app_eq : f.appLE ⊤ V_op e =
        p_Y.appLE ⊤ V_0 le_top ≫ U_part.ι.appLE V_0 V_op h_pre :=
      (AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE U_part.ι p_Y ⊤ V_0 V_op le_top h_pre).symm
    obtain ⟨g, hg_C, hg_et⟩ := hStd.exists_etale_mvPolynomial
    let Γ_k := ↑(S_k.presheaf.obj (Opposite.op (⊤ : S_k.Opens)))
    let e_k : k₀ ≃+* Γ_k :=
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).symm.commRingCatIsoToRingEquiv
    let e_mv : Polynomial k₀ ≃+* MvPolynomial (Fin 1) k₀ :=
      (((MvPolynomial.renameEquiv k₀ (Equiv.equivPUnit.{1, 1} (Fin 1))).trans
        (MvPolynomial.pUnitAlgEquiv.{u, 0} k₀)).symm).toRingEquiv
    let e_dom : Polynomial k₀ ≃+* MvPolynomial (Fin 1) Γ_k :=
      e_mv.trans (MvPolynomial.mapEquiv (Fin 1) e_k)
    have h_ι_apply : ∀ x : ↑(Y.presheaf.obj (Opposite.op V_0)),
        (U_part.ι.appLE V_0 V_op h_pre).hom x = x := by
      intro x
      rw [AlgebraicGeometry.Scheme.Opens.ι_appLE]
      have h_map : Y.presheaf.map (CategoryTheory.homOfLE (le_rfl : U_part.ι ''ᵁ V_op ≤ V_0)).op =
          𝟙 (Y.presheaf.obj (Opposite.op V_0)) := by
        have h1 : (CategoryTheory.homOfLE (le_rfl : U_part.ι ''ᵁ V_op ≤ V_0)).op =
            𝟙 (Opposite.op V_0) := Subsingleton.elim _ _
        rw [h1, CategoryTheory.Functor.map_id]
      exact congrArg (fun m => m.hom x) h_map
    let B_0 := ↑(Y.presheaf.obj (Opposite.op V_0))
    let g_B0 : MvPolynomial (Fin 1) Γ_k →+* B_0 := g
    let ψ_0 : Polynomial k₀ →+* B_0 := g_B0.comp e_dom.toRingHom
    have hψ_C : ψ_0.comp Polynomial.C =
        (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
          p_Y.appLE ⊤ V_0 le_top).hom) := by
      ext c
      have he_mv : e_mv (Polynomial.C c) = MvPolynomial.C c :=
        (((MvPolynomial.renameEquiv k₀ (Equiv.equivPUnit.{1, 1} (Fin 1))).trans
          (MvPolynomial.pUnitAlgEquiv.{u, 0} k₀)).symm).commutes c
      have he_dom : e_dom (Polynomial.C c) = MvPolynomial.C (e_k c) := by
        change (MvPolynomial.mapEquiv (Fin 1) e_k) (e_mv (Polynomial.C c)) = _
        rw [he_mv]
        exact MvPolynomial.map_C e_k.toRingHom c
      have hg_apply : g (MvPolynomial.C (e_k c)) = (f.appLE ⊤ V_op e).hom (e_k c) :=
        congrArg (fun φ => φ (e_k c)) hg_C
      change g (e_dom (Polynomial.C c)) = _
      rw [he_dom, hg_apply, h_app_eq]
      exact h_ι_apply ((p_Y.appLE ⊤ V_0 le_top).hom (e_k c))
    have hψ_et : ψ_0.Etale := by
      have het1 : e_dom.toRingHom.Etale := RingHom.Etale.of_bijective e_dom.bijective
      exact RingHom.Etale.stableUnderComposition _ _ het1 hg_et
    have ht0_ne : ∀ c : k₀,
        ψ_0 Polynomial.X -
          (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
            p_Y.appLE ⊤ V_0 le_top).hom c) ≠ 0 := by
      intro c hzero
      letI : Algebra (Polynomial k₀) B_0 := ψ_0.toAlgebra
      have hFlat : Module.Flat (Polynomial k₀) B_0 :=
        (RingHom.flat_algebraMap_iff).mp ((RingHom.etale_iff_formallyUnramified_and_smooth ψ_0).mp hψ_et).2.flat
      have hSpecNe : Nonempty (PrimeSpectrum B_0) := by
        obtain ⟨⟨y₀, hy₀⟩⟩ := hV0_ne
        have hy_range : y₀ ∈ Set.range hAffV0.fromSpec.base := by
          rw [hAffV0.range_fromSpec]
          exact hy₀
        obtain ⟨p₀, _⟩ := hy_range
        exact ⟨p₀⟩
      haveI : Nontrivial B_0 := (PrimeSpectrum.nonempty_iff_nontrivial).mp hSpecNe
      let P_c : Polynomial k₀ := Polynomial.X - Polynomial.C c
      have hPc_ne : P_c ≠ 0 := Polynomial.X_sub_C_ne_zero c
      let μ_c : Polynomial k₀ →ₗ[Polynomial k₀] Polynomial k₀ :=
        LinearMap.mulLeft (Polynomial k₀) P_c
      have hμ_inj : Function.Injective μ_c := fun a b hab => mul_right_injective₀ hPc_ne hab
      have hlT_inj : Function.Injective (LinearMap.lTensor B_0 μ_c) :=
        Module.Flat.lTensor_preserves_injective_linearMap μ_c hμ_inj
      have hψ_Pc : ψ_0 P_c = 0 := by
        change ψ_0 (Polynomial.X - Polynomial.C c) = 0
        rw [map_sub]
        have hC_eq : ψ_0 (Polynomial.C c) =
            (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
              p_Y.appLE ⊤ V_0 le_top).hom c) := by
          rw [← hψ_C]; rfl
        rwa [hC_eq]
      have h_tmul_zero : LinearMap.lTensor B_0 μ_c ((1 : B_0) ⊗ₜ[Polynomial k₀] (1 : Polynomial k₀)) = 0 := by
        rw [LinearMap.lTensor_tmul]
        change (1 : B_0) ⊗ₜ[Polynomial k₀] (P_c • (1 : Polynomial k₀)) = 0
        rw [← TensorProduct.smul_tmul]
        have hsmul : P_c • (1 : B_0) = 0 := by
          rw [Algebra.smul_def, mul_one]
          exact hψ_Pc
        rw [hsmul, TensorProduct.zero_tmul]
      have h_one_tmul : ((1 : B_0) ⊗ₜ[Polynomial k₀] (1 : Polynomial k₀)) = 0 :=
        hlT_inj (by rw [h_tmul_zero, map_zero])
      have h_one_zero : (1 : B_0) = 0 := by
        have hrid := congrArg (TensorProduct.rid (Polynomial k₀) B_0) h_one_tmul
        simpa using hrid
      exact one_ne_zero h_one_zero
    exact ⟨V_0, ψ_0, hV0_le, hAffV0, hV0_ne, hψ_C, hψ_et, ht0_ne⟩
  have hs2 :
      ∀ (B_0 : Type u) [CommRing B_0]
        (ψ_0 : Polynomial k₀ →+* B_0),
        ψ_0.Etale →
        ∀ (c₀ : k₀),
          let c_B : k₀ →+* B_0 := ψ_0.comp Polynomial.C
          let τ_0 : B_0 := ψ_0 Polynomial.X - c_B c₀
          ¬ IsUnit τ_0 →
          ∃ (m_pts : ℕ)
            (ev : Fin (m_pts + 1) → (B_0 →+* k₀))
            (e_idem : Fin (m_pts + 1) → B_0),
            (∀ j : Fin (m_pts + 1), (ev j).comp c_B = RingHom.id k₀) ∧
            (∀ j : Fin (m_pts + 1), ev j (e_idem j) = 1) ∧
            (∀ j j' : Fin (m_pts + 1), j' ≠ j → ev j' (e_idem j) = 0) ∧
            (∀ p : PrimeSpectrum B_0,
              τ_0 ∈ p.asIdeal ↔
                ∃ j : Fin (m_pts + 1), p = PrimeSpectrum.comap (ev j) (⊥ : PrimeSpectrum k₀)) ∧
            (∀ (w : B_0),
              w - 1 ∈ Ideal.span {τ_0} →
              ∀ j : Fin (m_pts + 1),
                ev j (e_idem j * w) = 1 ∧
                (∀ j' : Fin (m_pts + 1), j' ≠ j → ev j' (e_idem j * w) = 0) ∧
                ∀ (R_j : Type u) [CommRing R_j] [Algebra B_0 R_j]
                  [IsLocalization.Away (e_idem j * w) R_j]
                  (φ_j : R_j →+* k₀),
                  φ_j.comp (algebraMap B_0 R_j) = ev j →
                  (∃ u_j : R_j, IsUnit u_j ∧ u_j * algebraMap B_0 R_j w = 1) ∧
                  RingHom.ker φ_j = Ideal.span {algebraMap B_0 R_j τ_0}) := by
    intro B_0 _ ψ_0 hEt c₀ c_B τ_0 hNotUnit
    let I_0 : Ideal B_0 := Ideal.span {τ_0}
    let Q : Type u := B_0 ⧸ I_0
    let π_Q : B_0 →+* Q := Ideal.Quotient.mk I_0
    letI : Algebra k₀ B_0 := c_B.toAlgebra
    letI : Algebra (Polynomial k₀) B_0 := ψ_0.toAlgebra
    haveI : IsScalarTower k₀ (Polynomial k₀) B_0 := IsScalarTower.of_algebraMap_eq' rfl
    haveI hEtPB : Algebra.Etale (Polynomial k₀) B_0 := RingHom.etale_algebraMap.mp hEt
    letI : Algebra (Polynomial k₀) k₀ := (Polynomial.evalRingHom c₀).toAlgebra
    haveI : IsScalarTower (Polynomial k₀) k₀ k₀ := by
      refine ⟨fun P a b => ?_⟩
      change (Polynomial.eval c₀ P * a) * b = Polynomial.eval c₀ P * (a * b)
      exact mul_assoc _ _ _
    haveI : IsScalarTower k₀ (Polynomial k₀) k₀ := by
      refine ⟨fun c P a => ?_⟩
      simp only [Algebra.smul_def, Polynomial.smul_eq_C_mul]
      change Polynomial.eval c₀ (Polynomial.C c * P) * a = c * (Polynomial.eval c₀ P * a)
      rw [Polynomial.eval_mul, Polynomial.eval_C, mul_assoc]
    haveI hEtTensor : Algebra.Etale k₀ (TensorProduct (Polynomial k₀) k₀ B_0) :=
      Algebra.Etale.baseChange (Polynomial k₀) B_0 k₀
    letI : Algebra k₀ Q := Ideal.Quotient.algebra k₀
    letI : Algebra (Polynomial k₀) Q := Ideal.Quotient.algebra (Polynomial k₀)
    have hπ_τ : π_Q τ_0 = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton τ_0))
    have hπ_ψ : ∀ P : Polynomial k₀, π_Q (ψ_0 P) = π_Q (c_B (Polynomial.eval c₀ P)) := by
      intro P
      have hroot : Polynomial.IsRoot (P - Polynomial.C (Polynomial.eval c₀ P)) c₀ := by
        simp [Polynomial.IsRoot]
      obtain ⟨H, hH⟩ := Polynomial.dvd_iff_isRoot.mpr hroot
      have hmap := congrArg (fun q => π_Q (ψ_0 q)) hH
      rw [map_sub, map_sub, map_mul, map_mul] at hmap
      have hXC : π_Q (ψ_0 (Polynomial.X - Polynomial.C c₀)) = 0 := by
        rw [map_sub]
        exact hπ_τ
      rw [hXC, zero_mul, sub_eq_zero] at hmap
      exact hmap
    haveI : IsScalarTower (Polynomial k₀) k₀ Q := by
      refine ⟨fun P c q => Quotient.inductionOn' q fun b => ?_⟩
      change π_Q (((Polynomial.eval c₀ P) * c) • b) = π_Q (P • (c • b))
      rw [Algebra.smul_def, Algebra.smul_def, Algebra.smul_def,
        map_mul, map_mul, map_mul, map_mul]
      change π_Q (c_B (Polynomial.eval c₀ P)) * π_Q (c_B c) * π_Q b =
        π_Q (ψ_0 P) * (π_Q (c_B c) * π_Q b)
      rw [hπ_ψ P, mul_assoc]
    let g_alg : B_0 →ₐ[Polynomial k₀] Q := Ideal.Quotient.mkₐ (Polynomial k₀) I_0
    let f_alg : k₀ →ₐ[k₀] Q := Algebra.ofId k₀ Q
    let F : TensorProduct (Polynomial k₀) k₀ B_0 →ₐ[k₀] Q :=
      Algebra.TensorProduct.lift f_alg g_alg (fun _ _ => Commute.all _ _)
