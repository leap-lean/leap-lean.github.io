          · change Φ_inv (Φ_hom (algebraMap A_nod L_nod u₀)) = algebraMap A_nod L_nod u₀
            rw [hΦ_hom_eq u₀, show φ_quot u₀ = T from hφ_u0, hΦ_inv_eq pX,
