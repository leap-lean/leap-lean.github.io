      have hr_max : r.1.asIdeal.IsMaximal := IsArtinianRing.isMaximal_of_isPrime r.1.asIdeal
      have hnot_le : ¬ (r.1.asIdeal ≤ q₀₁) :=
        fun hle => r.2 (hr_max.eq_of_le ‹q₀₁.IsPrime›.ne_top hle)
      obtain ⟨y, hy_r, hy_not⟩ := Set.not_subset.mp hnot_le
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
      exact ⟨x, hy_r, fun hxq => hy_not (Ideal.mem_map_of_mem mk₀₁ hxq)⟩
    choose x_r hx_r_mem hx_r_not using hPick01
    let h₂ : B := ∏ r : S₀₁, x_r r
    have hh₂_not_q : h₂ ∉ q := q.primeCompl.prod_mem (fun r _ => hx_r_not r)
    have : IsDomain (B₀₁ ⧸ q₀₁) := (Ideal.Quotient.isDomain_iff_prime q₀₁).mpr inferInstance
    have : Module.Finite κ (B₀₁ ⧸ q₀₁) :=
      Module.Finite.of_surjective (Ideal.Quotient.mkₐ κ q₀₁).toLinearMap Ideal.Quotient.mk_surjective
    have : Algebra.IsIntegral κ (B₀₁ ⧸ q₀₁) := Algebra.IsIntegral.of_finite κ (B₀₁ ⧸ q₀₁)
    have hBij₀₁ : Function.Bijective (algebraMap κ (B₀₁ ⧸ q₀₁)) :=
      IsAlgClosed.algebraMap_bijective_of_isIntegral
    let h : B := h_fl 0 * h_fl 1 * h₂
    have hh_not_q : h ∉ q :=
      q.primeCompl.mul_mem (q.primeCompl.mul_mem (hh_fl_not 0) (hh_fl_not 1)) hh₂_not_q
    let B' := Localization.Away h
    let ψ : B →+* B' := algebraMap B B'
    let b : Fin 2 → B' := fun i => ψ (a i)
    have hDisj_q : Disjoint (Submonoid.powers h : Set B) (q : Set B) := by
      rw [Set.disjoint_left]
      rintro _ ⟨n, rfl⟩ hmem
      exact hh_not_q (‹q.IsPrime›.mem_of_pow_mem n hmem)
    let q' : PrimeSpectrum B' :=
      ⟨Ideal.map ψ q, IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers h) B' q inferInstance hDisj_q⟩
    have hRedB' : IsReduced B' := instIsReducedLocalization (Submonoid.powers h)
    have hOpenΨ : AlgebraicGeometry.IsOpenImmersion (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization h
    have hq'_base : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)).base q' = ⟨q, inferInstance⟩ := by
      apply PrimeSpectrum.ext
      exact IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers h) B' inferInstance hDisj_q
    let e₀_equiv : κ ≃+* (B₀₁ ⧸ q₀₁) := RingEquiv.ofBijective (algebraMap κ (B₀₁ ⧸ q₀₁)) hBij₀₁
    let e₀ : B →+* κ := e₀_equiv.symm.toRingHom.comp ((Ideal.Quotient.mk q₀₁).comp mk₀₁)
    have he₀_ker : RingHom.ker e₀ = q := by
      ext x
      simp only [e₀, RingHom.mem_ker, RingHom.comp_apply, RingEquiv.toRingHom_eq_coe,
        RingHom.coe_coe, RingEquiv.map_eq_zero_iff, Ideal.Quotient.eq_zero_iff_mem]
      change x ∈ Ideal.comap mk₀₁ q₀₁ ↔ x ∈ q
      rw [hcomap_q01]
    have he₀_h_ne : e₀ h ≠ 0 := fun h0 => hh_not_q (he₀_ker ▸ h0)
    have hUnit_e₀h : IsUnit (e₀ h) := IsUnit.mk0 (e₀ h) he₀_h_ne
    let ev₀ : B' →+* κ := IsLocalization.Away.lift h hUnit_e₀h
    have hev₀_id : ev₀.comp (ψ.comp c_B) = RingHom.id κ := by
      ext c
      change ev₀ (ψ (c_B c)) = c
      rw [IsLocalization.Away.lift_eq h hUnit_e₀h]
      exact e₀_equiv.symm_apply_apply c
    have hev₀_ker : RingHom.ker ev₀ = q'.asIdeal := by
      apply le_antisymm
      · intro y hy
        obtain ⟨n, x, hyx⟩ := IsLocalization.Away.surj h y
        have hev_x : e₀ x = 0 := by
          have h1 := congrArg ev₀ hyx
          rw [map_mul, (RingHom.mem_ker.mp hy), zero_mul, IsLocalization.Away.lift_eq h hUnit_e₀h] at h1
          exact h1.symm
        have hxq : x ∈ q := he₀_ker ▸ hev_x
        have hUnit_hn : IsUnit (ψ h ^ n) := (IsLocalization.Away.algebraMap_isUnit h).pow n
        obtain ⟨u_n, hu_n⟩ := hUnit_hn
        have hy_eq : y = ψ x * ↑(u_n⁻¹) := by
          calc
            y = y * (↑u_n * ↑(u_n⁻¹)) := by rw [Units.mul_inv, mul_one]
            _ = (y * ↑u_n) * ↑(u_n⁻¹) := (mul_assoc _ _ _).symm
            _ = ψ x * ↑(u_n⁻¹) := by rw [hu_n, hyx]
        rw [hy_eq]
        exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem ψ hxq)
      · rw [Ideal.map_le_iff_le_comap]
        intro x hxq
        change ev₀ (ψ x) = 0
        rw [IsLocalization.Away.lift_eq h hUnit_e₀h]
        exact RingHom.mem_ker.mp (he₀_ker.symm ▸ hxq)
    have hUnion : PrimeSpectrum.zeroLocus ({b 0} : Set B') ∪
        PrimeSpectrum.zeroLocus ({b 1} : Set B') = Set.univ := by
      ext P
      simp only [Set.mem_union, PrimeSpectrum.mem_zeroLocus, Set.singleton_subset_iff,
        Set.mem_univ, iff_true]
      have hmul0 : b 0 * b 1 = 0 := by
        change ψ (a 0) * ψ (a 1) = 0
        rw [← map_mul, ha_mul, map_zero]
      exact P.isPrime.mul_mem_iff_mem_or_mem.mp (hmul0 ▸ zero_mem P.asIdeal)
    have hInter : PrimeSpectrum.zeroLocus ({b 0} : Set B') ∩
        PrimeSpectrum.zeroLocus ({b 1} : Set B') = {q'} := by
      ext P
      simp only [Set.mem_inter_iff, PrimeSpectrum.mem_zeroLocus, Set.singleton_subset_iff,
        Set.mem_singleton_iff]
      constructor
      · rintro ⟨hb0, hb1⟩
        let P_B : Ideal B := Ideal.comap ψ P.asIdeal
        have : P_B.IsPrime := Ideal.IsPrime.comap ψ
        have hh_not_PB : h ∉ P_B := by
          intro hhP
          have hUnit : IsUnit (ψ h) := IsLocalization.Away.algebraMap_isUnit h
          exact P.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem P.asIdeal hhP hUnit)
        have hI01_le_PB : I₀₁ ≤ P_B := by
          rw [Ideal.span_le]
          rintro x (rfl | rfl)
          · exact hb0
          · exact hb1
        let r_P : Ideal B₀₁ := Ideal.map mk₀₁ P_B
        have : r_P.IsPrime := Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective
          (by rw [Ideal.mk_ker]; exact hI01_le_PB)
        have hcomap_rP : Ideal.comap mk₀₁ r_P = P_B := by
          rw [Ideal.comap_map_of_surjective mk₀₁ Ideal.Quotient.mk_surjective,
            ← RingHom.ker_eq_comap_bot, Ideal.mk_ker]
          exact sup_eq_left.mpr hI01_le_PB
        have hrP_eq : r_P = q₀₁ := by
          by_contra hne
          let pt : S₀₁ := ⟨⟨r_P, inferInstance⟩, hne⟩
          have hdvd_h2 : x_r pt ∣ h₂ := Finset.dvd_prod_of_mem x_r (Finset.mem_univ pt)
          have hdvd_h : x_r pt ∣ h := dvd_mul_of_dvd_right hdvd_h2 (h_fl 0 * h_fl 1)
          have hx_PB : x_r pt ∈ P_B := by
            rw [← hcomap_rP]
            exact hx_r_mem pt
          exact hh_not_PB (Ideal.mem_of_dvd P_B hdvd_h hx_PB)
        have hPB_eq_q : P_B = q := by
          rw [← hcomap_rP, hrP_eq, hcomap_q01]
        apply PrimeSpectrum.ext
        calc
          P.asIdeal = Ideal.map ψ P_B := (IsLocalization.map_under (Submonoid.powers h) B' P.asIdeal).symm
          _ = Ideal.map ψ q := by rw [hPB_eq_q]
      · rintro rfl
        exact ⟨Ideal.mem_map_of_mem ψ (hOrig 0), Ideal.mem_map_of_mem ψ (hOrig 1)⟩
    refine ⟨B', inferInstance, ψ, q', b, hRedB', hOpenΨ, hq'_base, ⟨ev₀, hev₀_id, hev₀_ker⟩,
      hUnion, hInter, fun i => ?_⟩
    intro D_i
    let B_i := B ⧸ Ideal.span {a i}
    let mk_i : B →+* B_i := Ideal.Quotient.mk (Ideal.span {a i})
    let q_i : Ideal B_i := Ideal.map mk_i q
    have hker_i_le_q : Ideal.span {a i} ≤ q := by
      rw [Ideal.span_le, Set.singleton_subset_iff]
      exact hOrig i
    have : q_i.IsPrime := Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective
      (by rw [Ideal.mk_ker]; exact hker_i_le_q)
    have hcomap_qi : Ideal.comap mk_i q_i = q := by
      rw [Ideal.comap_map_of_surjective mk_i Ideal.Quotient.mk_surjective,
        ← RingHom.ker_eq_comap_bot, Ideal.mk_ker]
      exact sup_eq_left.mpr hker_i_le_q
    have hmki_h_not : mk_i h ∉ q_i := fun hmem => hh_not_q (hcomap_qi ▸ hmem)
    have hc_fac : ∃ c_i : B, h = h_fl i * c_i := by
      fin_cases i
      · exact ⟨h_fl 1 * h₂, mul_assoc (h_fl 0) (h_fl 1) h₂⟩
      · exact ⟨h_fl 0 * h₂, by change h_fl 0 * h_fl 1 * h₂ = h_fl 1 * (h_fl 0 * h₂); ring⟩
    obtain ⟨c_i, hc_i⟩ := hc_fac
    let R_i1 := Localization.Away (h_bar i)
    have : IsDomain R_i1 := hh_bar_dom i
    let R_i2 := Localization.Away (mk_i h)
    let ρ₁ : B_i →+* R_i1 := algebraMap B_i R_i1
    let ρ₂ : B_i →+* R_i2 := algebraMap B_i R_i2
    have hDisj_qi : Disjoint (Submonoid.powers (mk_i h) : Set B_i) (q_i : Set B_i) := by
      rw [Set.disjoint_left]
      rintro _ ⟨n, rfl⟩ hmem
      exact hmki_h_not (‹q_i.IsPrime›.mem_of_pow_mem n hmem)
    have hPrime_Ri2 : (Ideal.map ρ₂ q_i).IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers (mk_i h)) R_i2 q_i inferInstance hDisj_qi
    have : Nontrivial R_i2 := ⟨⟨0, 1, fun h01 => hPrime_Ri2.ne_top
      (Submodule.eq_top_iff'.mpr fun y => by
        have h1 : (1 : R_i2) ∈ Ideal.map ρ₂ q_i := h01 ▸ (Ideal.map ρ₂ q_i).zero_mem
        simpa using (Ideal.map ρ₂ q_i).mul_mem_left y h1)⟩⟩
    have hmki_h_eq : mk_i h = h_bar i * mk_i c_i := by
      rw [hc_i, map_mul, hh_fl i]
    have hρ₁_ci_ne : ρ₁ (mk_i c_i) ≠ 0 := by
      intro h0
      obtain ⟨⟨_, ⟨l, rfl⟩⟩, hl0⟩ := (IsLocalization.map_eq_zero_iff (Submonoid.powers (h_bar i)) R_i1 _).mp h0
      have hl0' : h_bar i ^ l * mk_i c_i = 0 := hl0
      have hpow0 : (mk_i h) ^ (l + 1) = 0 := by
        calc
          (mk_i h) ^ (l + 1) = (h_bar i * mk_i c_i) ^ (l + 1) := by rw [hmki_h_eq]
          _ = (h_bar i ^ l * mk_i c_i) * (h_bar i * mk_i c_i ^ l) := by ring
          _ = 0 := by rw [hl0', zero_mul]
      exact hmki_h_not (‹q_i.IsPrime›.mem_of_pow_mem (l + 1) (hpow0 ▸ q_i.zero_mem))
    have hρ₁_hbar_ne : ρ₁ (h_bar i) ≠ 0 :=
      (IsLocalization.Away.algebraMap_isUnit (S := R_i1) (h_bar i)).ne_zero
    have hKerEquiv : ∀ x : B_i, ρ₂ x = 0 ↔ ρ₁ x = 0 := by
      intro x
      constructor
      · intro h2
        obtain ⟨⟨_, ⟨k, rfl⟩⟩, hk0⟩ :=
          (IsLocalization.map_eq_zero_iff (Submonoid.powers (mk_i h)) R_i2 x).mp h2
        have hk0' : (mk_i h) ^ k * x = 0 := hk0
        have h1 := congrArg ρ₁ hk0'
        rw [hmki_h_eq, mul_pow, map_mul, map_mul, map_pow, map_pow, map_zero] at h1
        have hfac_ne : ρ₁ (h_bar i) ^ k * ρ₁ (mk_i c_i) ^ k ≠ 0 :=
          mul_ne_zero (pow_ne_zero k hρ₁_hbar_ne) (pow_ne_zero k hρ₁_ci_ne)
        exact (mul_eq_zero.mp h1).resolve_left hfac_ne
      · intro h1
        obtain ⟨⟨_, ⟨k, rfl⟩⟩, hk0⟩ :=
          (IsLocalization.map_eq_zero_iff (Submonoid.powers (h_bar i)) R_i1 x).mp h1
        have hk0' : h_bar i ^ k * x = 0 := hk0
        have hmk_pow : (mk_i h) ^ k * x = 0 := by
          calc
            (mk_i h) ^ k * x = (mk_i c_i) ^ k * (h_bar i ^ k * x) := by rw [hmki_h_eq]; ring
            _ = 0 := by rw [hk0', mul_zero]
        exact (IsLocalization.map_eq_zero_iff (Submonoid.powers (mk_i h)) R_i2 x).mpr
          ⟨⟨(mk_i h) ^ k, k, rfl⟩, hmk_pow⟩
    have : NoZeroDivisors R_i2 := ⟨fun {u v} huv => by
      obtain ⟨m, x, hux⟩ := IsLocalization.Away.surj (mk_i h) u
      obtain ⟨n, y, hvy⟩ := IsLocalization.Away.surj (mk_i h) v
      have hxy2 : ρ₂ (x * y) = 0 := by
        rw [map_mul, ← hux, ← hvy]
        calc
          (u * ρ₂ (mk_i h) ^ m) * (v * ρ₂ (mk_i h) ^ n)
              = (u * v) * (ρ₂ (mk_i h) ^ m * ρ₂ (mk_i h) ^ n) := by ring
          _ = 0 := by rw [huv, zero_mul]
      have hxy1 : ρ₁ x * ρ₁ y = 0 := by
        rw [← map_mul]
        exact (hKerEquiv (x * y)).mp hxy2
      rcases mul_eq_zero.mp hxy1 with hx1 | hy1
      · have hx2 : ρ₂ x = 0 := (hKerEquiv x).mpr hx1
        rw [hx2] at hux
        have hUnit_m : IsUnit (ρ₂ (mk_i h) ^ m) :=
          (IsLocalization.Away.algebraMap_isUnit (mk_i h)).pow m
        exact Or.inl (hUnit_m.mul_right_cancel (hux.trans (zero_mul _).symm))
      · have hy2 : ρ₂ y = 0 := (hKerEquiv y).mpr hy1
        rw [hy2] at hvy
        have hUnit_n : IsUnit (ρ₂ (mk_i h) ^ n) :=
          (IsLocalization.Away.algebraMap_isUnit (mk_i h)).pow n
        exact Or.inr (hUnit_n.mul_right_cancel (hvy.trans (zero_mul _).symm))⟩
    have : IsDomain R_i2 := NoZeroDivisors.to_isDomain R_i2
    let g_fwd : B →+* R_i2 := ρ₂.comp mk_i
    have hg_fwd_h : IsUnit (g_fwd h) := IsLocalization.Away.algebraMap_isUnit (mk_i h)
    let g'_fwd : B' →+* R_i2 := IsLocalization.Away.lift h hg_fwd_h
    have hker_fwd : ∀ z ∈ Ideal.span {b i}, g'_fwd z = 0 := by
      intro z hz
      obtain ⟨w, rfl⟩ := Ideal.mem_span_singleton.mp hz
      rw [map_mul]
      have hbi0 : g'_fwd (b i) = 0 := by
        change g'_fwd (ψ (a i)) = 0
        rw [IsLocalization.Away.lift_eq h hg_fwd_h]
        change ρ₂ (mk_i (a i)) = 0
        rw [Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self (a i)), map_zero]
      rw [hbi0, zero_mul]
    let φ_fwd : D_i →+* R_i2 := Ideal.Quotient.lift (Ideal.span {b i}) g'_fwd hker_fwd
    let mk_Di : B' →+* D_i := Ideal.Quotient.mk (Ideal.span {b i})
    let g_bwd : B →+* D_i := mk_Di.comp ψ
    have hker_bwd : ∀ z ∈ Ideal.span {a i}, g_bwd z = 0 := by
      intro z hz
      obtain ⟨w, rfl⟩ := Ideal.mem_span_singleton.mp hz
      rw [map_mul]
      have hai0 : g_bwd (a i) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self (b i))
      rw [hai0, zero_mul]
    let g'_bwd : B_i →+* D_i := Ideal.Quotient.lift (Ideal.span {a i}) g_bwd hker_bwd
    have hg'_bwd_h : IsUnit (g'_bwd (mk_i h)) :=
      (IsLocalization.Away.algebraMap_isUnit h).map mk_Di
    let φ_bwd : R_i2 →+* D_i := IsLocalization.Away.lift (mk_i h) hg'_bwd_h
    let Φ_i : D_i ≃+* R_i2 :=
      { toFun := φ_fwd
        invFun := φ_bwd
        left_inv := fun z => by
          have hcomp : φ_bwd.comp φ_fwd = RingHom.id D_i := by
            apply Ideal.Quotient.ringHom_ext
            apply IsLocalization.ringHom_ext (Submonoid.powers h)
            ext x
            change φ_bwd (g'_fwd (ψ x)) = mk_Di (ψ x)
            rw [IsLocalization.Away.lift_eq h hg_fwd_h]
            change φ_bwd (ρ₂ (mk_i x)) = mk_Di (ψ x)
            exact IsLocalization.Away.lift_eq (mk_i h) hg'_bwd_h (mk_i x)
          exact RingHom.congr_fun hcomp z
        right_inv := fun z => by
          have hcomp : φ_fwd.comp φ_bwd = RingHom.id R_i2 := by
            apply IsLocalization.ringHom_ext (Submonoid.powers (mk_i h))
            apply Ideal.Quotient.ringHom_ext
            ext x
            change φ_fwd (φ_bwd (ρ₂ (mk_i x))) = ρ₂ (mk_i x)
            rw [IsLocalization.Away.lift_eq (mk_i h) hg'_bwd_h (mk_i x)]
            change g'_fwd (ψ x) = ρ₂ (mk_i x)
            exact IsLocalization.Away.lift_eq h hg_fwd_h x
          exact RingHom.congr_fun hcomp z
        map_mul' := φ_fwd.map_mul
        map_add' := φ_fwd.map_add }
    have : Nontrivial D_i := ⟨⟨0, 1, fun h01 => one_ne_zero (α := R_i2) (by
      rw [← map_one Φ_i, ← h01, map_zero])⟩⟩
    have : NoZeroDivisors D_i := ⟨fun {x y} hxy => by
      have h0 : Φ_i x * Φ_i y = 0 := by rw [← map_mul, hxy, map_zero]
      rcases mul_eq_zero.mp h0 with h1 | h2
      · exact Or.inl (Φ_i.injective (h1.trans (map_zero _).symm))
      · exact Or.inr (Φ_i.injective (h2.trans (map_zero _).symm))⟩
    have hDom_Di : IsDomain D_i := NoZeroDivisors.to_isDomain D_i
    obtain ⟨β_i, hEt_βi, hβi_C⟩ := hβ i
    letI : Algebra (Polynomial κ) B_i := β_i.toAlgebra
    have : Algebra.Etale (Polynomial κ) B_i := hEt_βi
    have : Algebra.Etale B_i R_i2 := Algebra.Etale.of_isLocalizationAway (mk_i h)
    have : Algebra.Etale (Polynomial κ) R_i2 := Algebra.Etale.comp (Polynomial κ) B_i R_i2
    let θ_i : Polynomial κ →+* D_i :=
      @RingHom.comp (Polynomial κ) R_i2 D_i _ _ _ Φ_i.symm.toRingHom (ρ₂.comp β_i)
    letI : Algebra (Polynomial κ) D_i := θ_i.toAlgebra
    let e_alg_Di : R_i2 ≃ₐ[Polynomial κ] D_i :=
      AlgEquiv.ofRingEquiv (f := Φ_i.symm) (fun P => by
        change Φ_i.symm (algebraMap (Polynomial κ) R_i2 P) = Φ_i.symm (ρ₂ (β_i P))
        rw [IsScalarTower.algebraMap_apply (Polynomial κ) B_i R_i2 P]
        rfl)
    have hEt_θi : θ_i.Etale := Algebra.Etale.of_equiv e_alg_Di
    have hθi_C : θ_i.comp Polynomial.C = mk_Di.comp (ψ.comp c_B) := by
      ext c
      change φ_bwd (ρ₂ ((β_i.comp Polynomial.C) c)) = mk_Di (ψ (c_B c))
      rw [hβi_C]
      exact IsLocalization.Away.lift_eq (mk_i h) hg'_bwd_h (mk_i (c_B c))
    exact ⟨hDom_Di, θ_i, hEt_θi, hθi_C⟩

  have : IsIntegrallyClosed (Polynomial κ) := UniqueFactorizationMonoid.instIsIntegrallyClosed
  refine ⟨?_, ?_⟩
  · intro B _ φ_T hEt_T q _
    obtain ⟨_, hAway⟩ := h_s1 B φ_T hEt_T
    obtain ⟨h, hh_not_q, hDomD⟩ := hAway q
    let D := Localization.Away h
    let ψ : B →+* D := algebraMap B D
    have hDisj_q : Disjoint (Submonoid.powers h : Set B) (q : Set B) := by
      rw [Set.disjoint_left]
      rintro _ ⟨n, rfl⟩ hmem
      exact hh_not_q (‹q.IsPrime›.mem_of_pow_mem n hmem)
    let q_D : PrimeSpectrum D :=
      ⟨Ideal.map ψ q, IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers h) D q inferInstance hDisj_q⟩
    have : IsDomain D := hDomD
    letI : Algebra (Polynomial κ) B := φ_T.toAlgebra
    have : Algebra.Etale (Polynomial κ) B := hEt_T
    have : Algebra.Etale B D := Algebra.Etale.of_isLocalizationAway h
    have hEt_alg_D : Algebra.Etale (Polynomial κ) D := Algebra.Etale.comp (Polynomial κ) B D
    have hIC_D : IsIntegrallyClosed D := hEtIC (Polynomial κ) D
    let algLoc : Algebra (Polynomial κ) D := inferInstance
    let φ_D : Polynomial κ →+* D := ψ.comp φ_T
    have hAlgEq : ∀ P : Polynomial κ, @algebraMap (Polynomial κ) D _ _ algLoc P = φ_D P :=
      fun P => IsScalarTower.algebraMap_apply (Polynomial κ) B D P
    have hEt_φD : φ_D.Etale := by
      let e_D : @AlgEquiv (Polynomial κ) D D _ _ _ algLoc φ_D.toAlgebra :=
        @AlgEquiv.ofRingEquiv (Polynomial κ) D D _ _ _ algLoc φ_D.toAlgebra
          (RingEquiv.refl D) hAlgEq
      exact @Algebra.Etale.of_equiv (Polynomial κ) D D _ _ algLoc _ φ_D.toAlgebra
        hEt_alg_D e_D
    obtain ⟨hTwo, hSpec⟩ := h_s2 D φ_D hEt_φD
    refine ⟨D, inferInstance, ψ, q_D, hDomD, hIC_D,
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization h,
      PrimeSpectrum.ext (IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers h) D inferInstance hDisj_q),
      hTwo, hSpec⟩
  · intro _ B _ φ_N hEt_N q _ hOrig
    refine ⟨h_s3 B φ_N hEt_N q hOrig, ?_⟩
    let c_B : κ →+* B := φ_N.comp ((Ideal.Quotient.mk I_nod).comp MvPolynomial.C)
    let a : Fin 2 → B := fun i => φ_N (Ideal.Quotient.mk I_nod (MvPolynomial.X i))
    obtain ⟨ha_mul, ha_inter, hβ, hEt_01⟩ := h_s4 B φ_N hEt_N
    have hRed_i : ∀ i : Fin 2, IsReduced (B ⧸ Ideal.span {a i}) := by
      intro i
      obtain ⟨β_i, hEt_βi, _⟩ := hβ i
      exact (h_s1 (B ⧸ Ideal.span {a i}) β_i hEt_βi).1
    have hAway_i : ∀ i : Fin 2,
        ∃ h_bar : B ⧸ Ideal.span {a i},
          h_bar ∉ Ideal.map (Ideal.Quotient.mk (Ideal.span {a i})) q ∧
          IsDomain (Localization.Away h_bar) := by
      intro i
      obtain ⟨β_i, hEt_βi, _⟩ := hβ i
      have hqi_prime : (Ideal.map (Ideal.Quotient.mk (Ideal.span {a i})) q).IsPrime :=
        Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective
          (by rw [Ideal.mk_ker, Ideal.span_singleton_le_iff_mem]; exact hOrig i)
      exact @(h_s1 (B ⧸ Ideal.span {a i}) β_i hEt_βi).2
        (Ideal.map (Ideal.Quotient.mk (Ideal.span {a i})) q) hqi_prime
    obtain ⟨B', instRingB', ψ, q', b, hRedB', hOpenΨ, hq'_base, hev₀, hUnion, hInter, hBr⟩ :=
      h_s5 B c_B a q ha_mul hOrig ha_inter hRed_i hβ hAway_i hEt_01
    letI : CommRing B' := instRingB'
    refine ⟨B', instRingB', ψ, q', b, hRedB', hOpenΨ, hq'_base, hev₀, hUnion, hInter, fun i => ?_⟩
    obtain ⟨hDom_Di, θ_i, hEt_θi, hθi_C⟩ := hBr i
    let D_i := B' ⧸ Ideal.span {b i}
    have : IsDomain D_i := hDom_Di
    have hPrime_bi : (Ideal.span {b i} : Ideal B').IsPrime :=
      (Ideal.Quotient.isDomain_iff_prime (Ideal.span {b i})).mp hDom_Di
    letI : Algebra (Polynomial κ) D_i := θ_i.toAlgebra
    have : Algebra.Etale (Polynomial κ) D_i := hEt_θi
    have hIC_Di : IsIntegrallyClosed D_i := hEtIC (Polynomial κ) D_i
    obtain ⟨hTwo_i, hSpec_i⟩ := h_s2 D_i θ_i hEt_θi
    refine ⟨hPrime_bi, hDom_Di, hIC_Di, hTwo_i, ?_⟩
    intro Z hZ_cl hZ_ne
    obtain ⟨hZ_fin, hZ_ev⟩ := hSpec_i Z hZ_cl hZ_ne
    refine ⟨hZ_fin, fun p hpZ => ?_⟩
    obtain ⟨ev, hev_id, hev_ker⟩ := hZ_ev p hpZ
    rw [hθi_C] at hev_id
    exact ⟨ev, hev_id, hev_ker⟩

theorem weil_algClosed_semistable_curve_fiber_branches_and_subschemes (κ : Type u) [Field κ]
    (F : AlgebraicGeometry.Scheme.{u})
    (snd : F ⟶ AlgebraicGeometry.Spec (CommRingCat.of κ))
    (hComp : CompactSpace ↥F)
    (hSep : AlgebraicGeometry.IsSeparated snd)
    (hCharts : ∀ w : ↥F, HasLocalSemistableCurveBranchChart κ snd w) :
    AlgebraicGeometry.IsReduced F ∧
    (∀ (w : ↥F) (U_sm : F.Opens),
      w ∈ U_sm →
      AlgebraicGeometry.SmoothOfRelativeDimension 1 (U_sm.ι ≫ snd) →
      ∀ H₁ ∈ irreducibleComponents ↥F, ∀ H₂ ∈ irreducibleComponents ↥F,
        w ∈ H₁ → w ∈ H₂ → H₁ = H₂) ∧
    (∀ (w : ↥F) (H₁ H₂ H₃ : Set ↥F),
      H₁ ∈ irreducibleComponents ↥F →
      H₂ ∈ irreducibleComponents ↥F →
      H₃ ∈ irreducibleComponents ↥F →
      w ∈ H₁ → w ∈ H₂ → w ∈ H₃ →
      H₁ = H₂ ∨ H₁ = H₃ ∨ H₂ = H₃) ∧
    (∀ (w : ↥F) (H₁ H₂ : Set ↥F),
      H₁ ∈ irreducibleComponents ↥F →
      H₂ ∈ irreducibleComponents ↥F →
      H₁ ≠ H₂ → w ∈ H₁ → w ∈ H₂ →
      IsClosed ({w} : Set ↥F)) ∧
    (∀ Z : Set ↥F,
      IsClosed Z → IsIrreducible Z →
      (∃ u₁ u₂ : ↥F, u₁ ≠ u₂ ∧ u₁ ∈ Z ∧ u₂ ∈ Z) →
      Z ∈ irreducibleComponents ↥F) ∧
    (∀ H ∈ irreducibleComponents ↥F,
      (∃ u₁ u₂ : ↥F, u₁ ≠ u₂ ∧ u₁ ∈ H ∧ u₂ ∈ H) ∧
      (∀ Z : Set ↥F, IsClosed Z → Z ⊆ H → Z ≠ H → Z.Finite) ∧
      ∃ (H_sch : AlgebraicGeometry.Scheme.{u}) (ιH : H_sch ⟶ F),
        AlgebraicGeometry.IsClosedImmersion ιH ∧
        AlgebraicGeometry.IsIntegral H_sch ∧
        Set.range ιH.base = H ∧
        IsOverlapAffineNormalScheme H_sch) :=
by
  have : CompactSpace ↥F := hComp
  have : AlgebraicGeometry.IsSeparated snd := hSep
  have hSecClosed : ∀ (z : ↥F) (σ : AlgebraicGeometry.Spec (CommRingCat.of κ) ⟶ F),
      σ ≫ snd = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of κ)) →
      Set.range σ.base = {z} →
      IsClosed ({z} : Set ↥F) := by
    intro z σ hσ hrange
    have : AlgebraicGeometry.IsClosedImmersion (σ ≫ snd) := by
      rw [hσ]
      infer_instance
    have : AlgebraicGeometry.IsClosedImmersion σ :=
      AlgebraicGeometry.IsClosedImmersion.of_comp σ snd
    rw [← hrange]
    exact σ.isClosedEmbedding.isClosed_range
  have hRedF : AlgebraicGeometry.IsReduced F := by
    refine @AlgebraicGeometry.isReduced_of_isReduced_stalk F (fun w => ?_)
    rcases hCharts w with
      ⟨D, instRingD, j, q_D, hDomD, _hICD, hOpen_j, hj_qD, _hTwoD, _hFinD⟩ |
      ⟨_hNoSm, B', instRingB', j, q', _b, hRedB', hOpen_j, hj_q', _hσ₀, _hCovZ, _hInterZ, _hBr⟩
    · let : CommRing D := instRingD
      have : IsDomain D := hDomD
      have : AlgebraicGeometry.IsOpenImmersion j := hOpen_j
      let e := (CategoryTheory.asIso (j.stalkMap q_D)).commRingCatIsoToRingEquiv
      have hStalk : IsReduced ↑(F.presheaf.stalk (j.base q_D)) :=
        isReduced_of_injective e e.injective
      rwa [hj_qD] at hStalk
    · let : CommRing B' := instRingB'
      have : IsReduced B' := hRedB'
      have : AlgebraicGeometry.IsOpenImmersion j := hOpen_j
      let e := (CategoryTheory.asIso (j.stalkMap q')).commRingCatIsoToRingEquiv
      have hStalk : IsReduced ↑(F.presheaf.stalk (j.base q')) :=
        isReduced_of_injective e e.injective
      rwa [hj_q'] at hStalk
  have hSmoothComp : ∀ {H : Set ↥F} (hH : H ∈ irreducibleComponents ↥F) {w : ↥F} (hwH : w ∈ H)
      (D : Type u) (instRingD : CommRing D)
      (j : AlgebraicGeometry.Spec (CommRingCat.of D) ⟶ F)
      (q_D : AlgebraicGeometry.Spec (CommRingCat.of D))
      (hDomD : IsDomain D) (hICD : IsIntegrallyClosed D)
      (hOpen_j : AlgebraicGeometry.IsOpenImmersion j) (hj_qD : j.base q_D = w)
      (hTwoD : ∃ p₁ p₂ : AlgebraicGeometry.Spec (CommRingCat.of D), p₁ ≠ p₂)
      (hFinD : ∀ Z : Set ↥(AlgebraicGeometry.Spec (CommRingCat.of D)),
        IsClosed Z → Z ≠ Set.univ →
        Z.Finite ∧
        ∀ p ∈ Z, ∃ σ : AlgebraicGeometry.Spec (CommRingCat.of κ) ⟶ F,
          σ ≫ snd = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of κ)) ∧
          Set.range σ.base = {j.base p}),
      H = closure (Set.range j.base) ∧
      (∃ u₁ u₂ : ↥F, u₁ ≠ u₂ ∧ u₁ ∈ H ∧ u₂ ∈ H) ∧
      (∀ Z : Set ↥F, IsClosed Z → Z ⊆ H → Z ≠ H →
        (Z ∩ Set.range j.base).Finite ∧ ∀ z ∈ Z ∩ Set.range j.base, IsClosed ({z} : Set ↥F)) ∧
      (∃ (R_w : Type u) (_ : CommRing R_w)
        (j' : AlgebraicGeometry.Spec (CommRingCat.of R_w) ⟶ F)
        (q_w : AlgebraicGeometry.Spec (CommRingCat.of R_w))
        (J : Ideal R_w),
        AlgebraicGeometry.IsOpenImmersion j' ∧
        j'.base q_w = w ∧
        J.IsPrime ∧
        j'.base ⁻¹' H = PrimeSpectrum.zeroLocus (J : Set R_w) ∧
        ∃ (_ : IsDomain (R_w ⧸ J)), IsIntegrallyClosed (R_w ⧸ J)) := by
    intro H hH w hwH D instRingD j q_D hDomD hICD hOpen_j hj_qD hTwoD hFinD
    let : CommRing D := instRingD
    have : IsDomain D := hDomD
    have : IsIntegrallyClosed D := hICD
    have : AlgebraicGeometry.IsOpenImmersion j := hOpen_j
    have : IrreducibleSpace ↥(AlgebraicGeometry.Spec (CommRingCat.of D)) :=
      PrimeSpectrum.irreducibleSpace
    have hU_irred : IsIrreducible (Set.range j.base) := by
      rw [← Set.image_univ]
      exact (IrreducibleSpace.isIrreducible_univ
        (X := ↥(AlgebraicGeometry.Spec (CommRingCat.of D)))).image
        j.base j.continuous.continuousOn
    have hH_sub : H ⊆ closure (Set.range j.base) :=
      (subset_closure_inter_of_isPreirreducible_of_isOpen hH.1.2 j.isOpenEmbedding.isOpen_range
        ⟨w, hwH, q_D, hj_qD⟩).trans (closure_mono Set.inter_subset_right)
    have hH_eq : H = closure (Set.range j.base) :=
      Set.Subset.antisymm hH_sub (hH.2 hU_irred.closure hH_sub)
    have hRange_sub : Set.range j.base ⊆ H := hH_eq ▸ subset_closure
    refine ⟨hH_eq, ?_, ?_, ?_⟩
    · obtain ⟨p₁, p₂, hp12⟩ := hTwoD
      exact ⟨j.base p₁, j.base p₂, fun h => hp12 (j.isOpenEmbedding.injective h),
        hRange_sub ⟨p₁, rfl⟩, hRange_sub ⟨p₂, rfl⟩⟩
    · intro Z hZ_cl hZH hZne
      let Z_D : Set ↥(AlgebraicGeometry.Spec (CommRingCat.of D)) := j.base ⁻¹' Z
      have hZD_cl : IsClosed Z_D := hZ_cl.preimage j.continuous
      have hZD_ne : Z_D ≠ Set.univ := by
        intro hEq
        apply hZne
        apply Set.Subset.antisymm hZH
        rw [hH_eq, hZ_cl.closure_subset_iff]
        rintro _ ⟨p, rfl⟩
        change p ∈ Z_D
        rw [hEq]
        trivial
      obtain ⟨hZD_fin, hZD_sec⟩ := hFinD Z_D hZD_cl hZD_ne
      rw [← Set.image_preimage_eq_inter_range]
      refine ⟨hZD_fin.image j.base, ?_⟩
      rintro _ ⟨p, hp, rfl⟩
      obtain ⟨σ, hσ_id, hσ_r⟩ := hZD_sec p hp
      exact hSecClosed (j.base p) σ hσ_id hσ_r
    · let e_bot : D ≃+* (D ⧸ (⊥ : Ideal D)) := (RingEquiv.quotientBot D).symm
      have hDomBot : IsDomain (D ⧸ (⊥ : Ideal D)) :=
        Function.Injective.isDomain e_bot.symm.toRingHom e_bot.symm.injective
      let : IsDomain (D ⧸ (⊥ : Ideal D)) := hDomBot
      have hPreim : j.base ⁻¹' H = PrimeSpectrum.zeroLocus ((⊥ : Ideal D) : Set D) := by
        ext p
        simp only [Set.mem_preimage]
        constructor
        · intro _ f hf
          rw [SetLike.mem_coe, Submodule.mem_bot] at hf
          rw [hf]
          exact p.asIdeal.zero_mem
        · intro _
          exact hRange_sub ⟨p, rfl⟩
      exact ⟨D, instRingD, j, q_D, ⊥, hOpen_j, hj_qD, inferInstance, hPreim,
        hDomBot, IsIntegrallyClosed.of_equiv e_bot⟩
  have hNodalComp : ∀ {H : Set ↥F} (hH : H ∈ irreducibleComponents ↥F) {w : ↥F} (hwH : w ∈ H)
      (B' : Type u) (instRingB' : CommRing B')
      (j : AlgebraicGeometry.Spec (CommRingCat.of B') ⟶ F)
      (q' : AlgebraicGeometry.Spec (CommRingCat.of B'))
      (b : Fin 2 → B')
      (hOpen_j : AlgebraicGeometry.IsOpenImmersion j) (hj_q' : j.base q' = w)
      (hCovZ : PrimeSpectrum.zeroLocus ({b 0} : Set B') ∪
        PrimeSpectrum.zeroLocus ({b 1} : Set B') = Set.univ)
      (hBr : ∀ i : Fin 2,
        (Ideal.span {b i} : Ideal B').IsPrime ∧
        let D_i := B' ⧸ Ideal.span {b i}
        ∃ (_ : IsDomain D_i),
          IsIntegrallyClosed D_i ∧
          (∃ p₁ p₂ : AlgebraicGeometry.Spec (CommRingCat.of D_i), p₁ ≠ p₂) ∧
          (∀ Z : Set ↥(AlgebraicGeometry.Spec (CommRingCat.of D_i)),
            IsClosed Z → Z ≠ Set.univ →
            Z.Finite ∧
            ∀ p ∈ Z, ∃ σ : AlgebraicGeometry.Spec (CommRingCat.of κ) ⟶ F,
              σ ≫ snd = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of κ)) ∧
              Set.range σ.base =
                {j.base ((AlgebraicGeometry.Spec.map
                  (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {b i})))).base p)})),
      (∃ i : Fin 2, H = closure (j.base '' PrimeSpectrum.zeroLocus ({b i} : Set B'))) ∧
      (∃ u₁ u₂ : ↥F, u₁ ≠ u₂ ∧ u₁ ∈ H ∧ u₂ ∈ H) ∧
      (∀ Z : Set ↥F, IsClosed Z → Z ⊆ H → Z ≠ H →
        (Z ∩ Set.range j.base).Finite ∧ ∀ z ∈ Z ∩ Set.range j.base, IsClosed ({z} : Set ↥F)) ∧
      (∃ (R_w : Type u) (_ : CommRing R_w)
        (j' : AlgebraicGeometry.Spec (CommRingCat.of R_w) ⟶ F)
        (q_w : AlgebraicGeometry.Spec (CommRingCat.of R_w))
        (J : Ideal R_w),
        AlgebraicGeometry.IsOpenImmersion j' ∧
        j'.base q_w = w ∧
        J.IsPrime ∧
        j'.base ⁻¹' H = PrimeSpectrum.zeroLocus (J : Set R_w) ∧
        ∃ (_ : IsDomain (R_w ⧸ J)), IsIntegrallyClosed (R_w ⧸ J)) := by
    intro H hH w hwH B' instRingB' j q' b hOpen_j hj_q' hCovZ hBr
    let : CommRing B' := instRingB'
    have : AlgebraicGeometry.IsOpenImmersion j := hOpen_j
    let Z_loc : Fin 2 → Set ↥(AlgebraicGeometry.Spec (CommRingCat.of B')) :=
      fun i => PrimeSpectrum.zeroLocus ({b i} : Set B')
    have hZ_span : ∀ i : Fin 2,
        Z_loc i = PrimeSpectrum.zeroLocus ((Ideal.span {b i} : Ideal B') : Set B') :=
      fun i => (PrimeSpectrum.zeroLocus_span ({b i} : Set B')).symm
    have hZ_irred : ∀ i : Fin 2, IsIrreducible (Z_loc i) := by
      intro i
      rw [hZ_span i]
      exact (PrimeSpectrum.isIrreducible_zeroLocus_iff_of_radical
        (Ideal.span {b i}) (hBr i).1.isRadical).mpr (hBr i).1
    have hB_irred : ∀ i : Fin 2, IsIrreducible (j.base '' Z_loc i) :=
      fun i => (hZ_irred i).image j.base j.continuous.continuousOn
    have hT_ex : ∀ i : Fin 2, ∃ T : Set ↥F, IsClosed T ∧ j.base ⁻¹' T = Z_loc i :=
      fun i => j.isOpenEmbedding.isInducing.isClosed_iff.mp
        (PrimeSpectrum.isClosed_zeroLocus ({b i} : Set B'))
    obtain ⟨T₀, hT₀_cl, hT₀_pre⟩ := hT_ex 0
    obtain ⟨T₁, hT₁_cl, hT₁_pre⟩ := hT_ex 1
    have hH_inter_Range : H ⊆ closure (H ∩ Set.range j.base) :=
      subset_closure_inter_of_isPreirreducible_of_isOpen hH.1.2 j.isOpenEmbedding.isOpen_range
        ⟨w, hwH, q', hj_q'⟩
    have hH_sub_union : H ⊆ T₀ ∪ T₁ := by
      refine hH_inter_Range.trans ((hT₀_cl.union hT₁_cl).closure_subset_iff.mpr ?_)
      rintro _ ⟨_, p, rfl⟩
      have hp : p ∈ Z_loc 0 ∪ Z_loc 1 := hCovZ.symm ▸ Set.mem_univ p
      rcases hp with hp0 | hp1
      · left; change p ∈ j.base ⁻¹' T₀; rwa [hT₀_pre]
      · right; change p ∈ j.base ⁻¹' T₁; rwa [hT₁_pre]
    have hH_sub_Ti : ∃ i : Fin 2, ∃ T : Set ↥F, IsClosed T ∧ j.base ⁻¹' T = Z_loc i ∧ H ⊆ T := by
      rcases isPreirreducible_iff_isClosed_union_isClosed.mp hH.1.2
          T₀ T₁ hT₀_cl hT₁_cl hH_sub_union with h0 | h1
      · exact ⟨0, T₀, hT₀_cl, hT₀_pre, h0⟩
      · exact ⟨1, T₁, hT₁_cl, hT₁_pre, h1⟩
    obtain ⟨i, T, _hT_cl, hT_pre, hH_sub_T⟩ := hH_sub_Ti
    have hInter_sub : H ∩ Set.range j.base ⊆ j.base '' Z_loc i := by
      rintro _ ⟨hxH, p, rfl⟩
      exact ⟨p, hT_pre ▸ hH_sub_T hxH, rfl⟩
    have hH_sub_clB : H ⊆ closure (j.base '' Z_loc i) :=
      hH_inter_Range.trans (closure_mono hInter_sub)
    have hH_eq : H = closure (j.base '' Z_loc i) :=
      Set.Subset.antisymm hH_sub_clB (hH.2 (hB_irred i).closure hH_sub_clB)
    have hB_sub_H : j.base '' Z_loc i ⊆ H := hH_eq ▸ subset_closure
    have hPreim_H : j.base ⁻¹' H =
        PrimeSpectrum.zeroLocus ((Ideal.span {b i} : Ideal B') : Set B') := by
      rw [← hZ_span i]
      apply Set.Subset.antisymm
      · intro p hp
        rw [← hT_pre]
        exact hH_sub_T hp
      · intro p hp
        exact hB_sub_H ⟨p, hp, rfl⟩
    obtain ⟨hPrime_i, instDom_i, hIC_i, ⟨p₁, p₂, hp12⟩, hFin_i⟩ := hBr i
    let mk_i := Ideal.Quotient.mk (Ideal.span ({b i} : Set B'))
    let ι_i := AlgebraicGeometry.Spec.map (CommRingCat.ofHom mk_i)
    have hBase_ιi : (ι_i.base :
        ↥(AlgebraicGeometry.Spec (CommRingCat.of (B' ⧸ Ideal.span ({b i} : Set B')))) →
        ↥(AlgebraicGeometry.Spec (CommRingCat.of B'))) = PrimeSpectrum.comap mk_i :=
      funext (AlgebraicGeometry.Spec.map_apply (CommRingCat.ofHom mk_i))
    have hInj_ιi : Function.Injective ι_i.base := by
      rw [hBase_ιi]
      exact (PrimeSpectrum.isClosedEmbedding_comap_of_surjective _ mk_i
        Ideal.Quotient.mk_surjective).injective
    have hRange_ιi : Set.range ι_i.base = Z_loc i := by
      have hRangeComap : Set.range (PrimeSpectrum.comap mk_i) = Z_loc i := by
        rw [range_comap_of_surjective _ mk_i Ideal.Quotient.mk_surjective,
          Ideal.mk_ker, PrimeSpectrum.zeroLocus_span]
      ext p
      simp only [Set.mem_range]
      exact Set.ext_iff.mp hRangeComap p
    refine ⟨⟨i, hH_eq⟩, ?_, ?_, ?_⟩
    · refine ⟨j.base (ι_i.base p₁), j.base (ι_i.base p₂),
        fun h => hp12 (hInj_ιi (j.isOpenEmbedding.injective h)),
        hB_sub_H ⟨ι_i.base p₁, hRange_ιi ▸ ⟨p₁, rfl⟩, rfl⟩,
        hB_sub_H ⟨ι_i.base p₂, hRange_ιi ▸ ⟨p₂, rfl⟩, rfl⟩⟩
    · intro Z hZ_cl hZH hZne
      let Z_Di : Set ↥(AlgebraicGeometry.Spec
        (CommRingCat.of (B' ⧸ Ideal.span ({b i} : Set B')))) := (ι_i ≫ j).base ⁻¹' Z
      have hZDi_cl : IsClosed Z_Di := hZ_cl.preimage (ι_i ≫ j).continuous
      have hZDi_ne : Z_Di ≠ Set.univ := by
        intro hEq
        apply hZne
        apply Set.Subset.antisymm hZH
        rw [hH_eq, hZ_cl.closure_subset_iff]
        rintro _ ⟨q, hq, rfl⟩
        rw [← hRange_ιi] at hq
        obtain ⟨p, rfl⟩ := hq
        have hp : p ∈ Z_Di := hEq.symm ▸ Set.mem_univ p
        exact hp
      obtain ⟨hZDi_fin, hZDi_sec⟩ := hFin_i Z_Di hZDi_cl hZDi_ne
      have hZ_inter_eq : Z ∩ Set.range j.base = (ι_i ≫ j).base '' Z_Di := by
        ext z
        simp only [Set.mem_inter_iff, Set.mem_range, Set.mem_image]
        constructor
        · rintro ⟨hzZ, q, rfl⟩
          have hqZ : q ∈ Z_loc i := by
            rw [← hT_pre]
            exact hH_sub_T (hZH hzZ)
          rw [← hRange_ιi] at hqZ
          obtain ⟨p, rfl⟩ := hqZ
          exact ⟨p, hzZ, rfl⟩
        · rintro ⟨p, hpZ, rfl⟩
          exact ⟨hpZ, ι_i.base p, rfl⟩
      rw [hZ_inter_eq]
      refine ⟨hZDi_fin.image (ι_i ≫ j).base, ?_⟩
      rintro _ ⟨p, hp, rfl⟩
      obtain ⟨σ, hσ_id, hσ_r⟩ := hZDi_sec p hp
