    exact (isIntegrallyClosed_iff F_ss).mp hIC_z hb_Az
  choose s_loc hs_loc using hs_loc_ex

  have hGlue_ex : ∀ b : B, ∃ s : ↑(X_tilde.presheaf.obj (Opposite.op Ω)),
