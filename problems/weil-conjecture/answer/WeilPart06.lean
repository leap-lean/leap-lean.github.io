      change (Y.presheaf.map (eqToHom hu_bo).op ≫ Y.presheaf.map (eqToHom hu_bo.symm).op).hom z = z
      rw [← Functor.map_comp, eqToHom_op, eqToHom_op, eqToHom_trans, eqToHom_refl,
        CategoryTheory.Functor.map_id]; rfl
    have h_res : ∀ x : ↑(Y.presheaf.obj (Opposite.op U₀)),
        τ_from ((algebraMap ↑(Y.presheaf.obj (Opposite.op U₀))
          ↑(Y.presheaf.obj (Opposite.op (Y.basicOpen u)))) x) = res₀ x := by
      intro x
      change (Y.presheaf.map (homOfLE (Y.basicOpen_le u)).op ≫
        Y.presheaf.map (eqToHom hu_bo.symm).op).hom x =
        (Y.presheaf.map (homOfLE (inf_le_left : U₀ ⊓ U₁ ≤ U₀)).op).hom x
      rw [← Functor.map_comp]; congr 2
    rw [h_id, h_res (u ^ m), map_pow, h_res b₀] at hm'
    exact hm'
  have hLoc₁ : ∀ z : ↑(Y.presheaf.obj (Opposite.op (U₀ ⊓ U₁))),
      ∃ (m : ℕ) (b₁ : ↑(Y.presheaf.obj (Opposite.op U₁))), z * (res₁ v) ^ m = res₁ b₁ := by
    intro z
    have hLoc_bo := hAff₁.isLocalization_basicOpen v
    let τ_to := (Y.presheaf.map (eqToHom hv_bo).op).hom
    let τ_from := (Y.presheaf.map (eqToHom hv_bo.symm).op).hom
    obtain ⟨⟨b₁, _, m, rfl⟩, hm⟩ :=
      @IsLocalization.surj _ _ (Submonoid.powers v) _ _ _ hLoc_bo (τ_to z)
    refine ⟨m, b₁, ?_⟩
    have hm' := congrArg τ_from hm
    rw [map_mul] at hm'
    have h_id : τ_from (τ_to z) = z := by
      change (Y.presheaf.map (eqToHom hv_bo).op ≫ Y.presheaf.map (eqToHom hv_bo.symm).op).hom z = z
      rw [← Functor.map_comp, eqToHom_op, eqToHom_op, eqToHom_trans, eqToHom_refl,
        CategoryTheory.Functor.map_id]; rfl
    have h_res : ∀ x : ↑(Y.presheaf.obj (Opposite.op U₁)),
        τ_from ((algebraMap ↑(Y.presheaf.obj (Opposite.op U₁))
          ↑(Y.presheaf.obj (Opposite.op (Y.basicOpen v)))) x) = res₁ x := by
      intro x
      change (Y.presheaf.map (homOfLE (Y.basicOpen_le v)).op ≫
        Y.presheaf.map (eqToHom hv_bo.symm).op).hom x =
        (Y.presheaf.map (homOfLE (inf_le_right : U₀ ⊓ U₁ ≤ U₁)).op).hom x
      rw [← Functor.map_comp]; congr 2
    rw [h_id, h_res (v ^ m), map_pow, h_res b₁] at hm'
    exact hm'
  have hGlued : ∀ (a₀ : ↑(Y.presheaf.obj (Opposite.op U₀)))
      (a₁ : ↑(Y.presheaf.obj (Opposite.op U₁))),
      res₀ a₀ = res₁ a₁ → ∃ r : R, r₀ r = a₀ ∧ r₁ r = a₁ := by
    intro a₀ a₁ ha₀₁
    let f₀_cone : CommRingCat.of (Polynomial R) ⟶ Y.presheaf.obj (Opposite.op U₀) :=
      CommRingCat.ofHom (Polynomial.eval₂RingHom r₀ a₀)
    let f₁_cone : CommRingCat.of (Polynomial R) ⟶ Y.presheaf.obj (Opposite.op U₁) :=
      CommRingCat.ofHom (Polynomial.eval₂RingHom r₁ a₁)
    have hcone_eq : f₀_cone ≫ Y.sheaf.obj.map (homOfLE (inf_le_left : U₀ ⊓ U₁ ≤ U₀)).op =
        f₁_cone ≫ Y.sheaf.obj.map (homOfLE (inf_le_right : U₀ ⊓ U₁ ≤ U₁)).op := by
      ext1
      apply Polynomial.ringHom_ext'
      · ext c
        have h0 := RingHom.congr_fun hr₀_comp c
        have h1 := RingHom.congr_fun hr₁_comp c
        change res₀ ((Polynomial.eval₂RingHom r₀ a₀) (Polynomial.C c)) =
          res₁ ((Polynomial.eval₂RingHom r₁ a₁) (Polynomial.C c))
        simpa using h0.trans h1.symm
      · change res₀ ((Polynomial.eval₂RingHom r₀ a₀) Polynomial.X) =
          res₁ ((Polynomial.eval₂RingHom r₁ a₁) Polynomial.X)
        simpa using ha₀₁
    let cone := Limits.PullbackCone.mk f₀_cone f₁_cone hcone_eq
    let lift_hom := Y.sheaf.interUnionPullbackConeLift U₀ U₁ cone
    have hlift_left := Y.sheaf.interUnionPullbackConeLift_left U₀ U₁ cone
    have hlift_right := Y.sheaf.interUnionPullbackConeLift_right U₀ U₁ cone
    let s_union : ↑(Y.presheaf.obj (Opposite.op (U₀ ⊔ U₁))) := lift_hom.hom Polynomial.X
    let s_top : ↑(Y.presheaf.obj (Opposite.op ⊤)) :=
      (Y.presheaf.map (eqToHom hCovY.symm).op).hom s_union
    have hs_top₀ : (Y.presheaf.map (homOfLE (le_top : U₀ ≤ ⊤)).op).hom s_top = a₀ := by
      have hcomp : Y.presheaf.map (eqToHom hCovY.symm).op ≫
          Y.presheaf.map (homOfLE (le_top : U₀ ≤ ⊤)).op =
          Y.sheaf.obj.map (homOfLE (le_sup_left : U₀ ≤ U₀ ⊔ U₁)).op := by
        change Y.presheaf.map (eqToHom hCovY.symm).op ≫
            Y.presheaf.map (homOfLE (le_top : U₀ ≤ ⊤)).op =
          Y.presheaf.map (homOfLE (le_sup_left : U₀ ≤ U₀ ⊔ U₁)).op
        rw [← Functor.map_comp]; congr 1
      have h1 := ConcreteCategory.congr_hom hcomp s_union
      have h2 := ConcreteCategory.congr_hom hlift_left Polynomial.X
      have h3 : (ConcreteCategory.hom cone.fst) Polynomial.X = a₀ := by
        rw [show cone.fst = f₀_cone from Limits.PullbackCone.mk_fst _ _ _]
        exact Polynomial.eval₂_X r₀ a₀
      exact Eq.trans h1 (Eq.trans h2 h3)
    have hs_top₁ : (Y.presheaf.map (homOfLE (le_top : U₁ ≤ ⊤)).op).hom s_top = a₁ := by
      have hcomp : Y.presheaf.map (eqToHom hCovY.symm).op ≫
          Y.presheaf.map (homOfLE (le_top : U₁ ≤ ⊤)).op =
          Y.sheaf.obj.map (homOfLE (le_sup_right : U₁ ≤ U₀ ⊔ U₁)).op := by
        change Y.presheaf.map (eqToHom hCovY.symm).op ≫
            Y.presheaf.map (homOfLE (le_top : U₁ ≤ ⊤)).op =
          Y.presheaf.map (homOfLE (le_sup_right : U₁ ≤ U₀ ⊔ U₁)).op
        rw [← Functor.map_comp]; congr 1
      have h1 := ConcreteCategory.congr_hom hcomp s_union
      have h2 := ConcreteCategory.congr_hom hlift_right Polynomial.X
      have h3 : (ConcreteCategory.hom cone.snd) Polynomial.X = a₁ := by
        rw [show cone.snd = f₁_cone from Limits.PullbackCone.mk_snd _ _ _]
        exact Polynomial.eval₂_X r₁ a₁
      exact Eq.trans h1 (Eq.trans h2 h3)
    have hr_top_surj : Function.Surjective r_top.hom := by
      change Function.Surjective (p.appTop.hom ∘ (Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom)
      exact hGlob.surjective.comp
        (Scheme.ΓSpecIso (CommRingCat.of R)).symm.commRingCatIsoToRingEquiv.surjective
    obtain ⟨r, hr⟩ := hr_top_surj s_top
    refine ⟨r, ?_, ?_⟩
    · change (Y.presheaf.map (homOfLE (le_top : U₀ ≤ ⊤)).op).hom (r_top.hom r) = a₀
      rw [hr, hs_top₀]
    · change (Y.presheaf.map (homOfLE (le_top : U₁ ≤ ⊤)).op).hom (r_top.hom r) = a₁
      rw [hr, hs_top₁]
  exact h_s4 U₀ U₁ hAff₀ hAff₁ hAff₀₁ hCovY
    (fun x₀ x₁ hx₀ hx₁ hx₀₁ =>
      h_s3
        ↑(Y.presheaf.obj (Opposite.op U₀))
        ↑(Y.presheaf.obj (Opposite.op U₁))
        ↑(Y.presheaf.obj (Opposite.op (U₀ ⊓ U₁)))
        r₀ r₁ r₀₁ res₀ res₁ hr₀_comp hr₁_comp hGlued u v huv hFin₀ hLoc₀ hLoc₁
        x₀ x₁ hx₀ hx₁ hx₀₁)

theorem weil_subset_product_projective_domination_over_valuation (K : Type u) [Field K]
    (V : ValuationSubring K)
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (n : ℕ)
    (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (hIntCK : AlgebraicGeometry.IsIntegral C_K)
    (hStabCK : IsGeometricStablePointedCurve p_K n σ_K)
    (F : Type u) [Field F] [Algebra K F]
    (η_F : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ C_K)
    (hηF_comm : η_F ≫ p_K = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K F)))
    (hFuncF : IsSchemeFunctionField C_K F η_F)
    (hSmPoles : HasSmoothCurveLocalRegularityAndOverringOpen C_K F η_F)
    (s₀ : ↥V) (hs₀ : s₀ ≠ 0)
    (hLocV : @IsLocalization.Away _ _ s₀ K _ V.subtype.toAlgebra)
    (C_semi : AlgebraicGeometry.Scheme.{u})
    (g_semi : C_semi ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (ι_semi : C_K ⟶ C_semi)
    (hInt : AlgebraicGeometry.IsIntegral C_semi)
    (hProp : AlgebraicGeometry.IsProper g_semi)
    (hLfp : AlgebraicGeometry.LocallyOfFinitePresentation g_semi)
    (hPb : CategoryTheory.IsPullback ι_semi p_K g_semi
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (hAff_proj : ∀ (R : Type u) [CommRing R] (N : ℕ) (a : Fin (N + 1)),
      AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen R N a))
    (c_proj : ∀ (R : Type u) [CommRing R] (N : ℕ) (a : Fin (N + 1)),
      R →+* ↑((weilProjectiveSpaceOver R N).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen R N a))))
    (t_proj : ∀ (R : Type u) [CommRing R] (N : ℕ) (a : Fin (N + 1)), Fin (N + 1) →
      ↑((weilProjectiveSpaceOver R N).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen R N a))))
    (hCoord_proj : ∀ (R : Type u) [CommRing R] (N : ℕ),
      IsCommRingProjCoordSystem R N (hAff_proj R N) (c_proj R N) (t_proj R N)) :
    ∃ (N : ℕ)
      (C_tilde : AlgebraicGeometry.Scheme.{u})
      (g_tilde : C_tilde ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
      (τ_tilde : AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C_tilde)
      (ιP_tilde : C_tilde ⟶ (weilProjectiveSpaceOver ↥V N).left)
      (ρ : C_tilde ⟶ C_semi)
      (η_tilde : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ C_tilde),
      AlgebraicGeometry.IsIntegral C_tilde ∧
      AlgebraicGeometry.Flat g_tilde ∧
      AlgebraicGeometry.IsProper g_tilde ∧
      τ_tilde ≫ g_tilde = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of ↥V)) ∧
      AlgebraicGeometry.IsClosedImmersion ιP_tilde ∧
      ιP_tilde ≫ (weilProjectiveSpaceOver ↥V N).hom = g_tilde ∧
      AlgebraicGeometry.Surjective ρ ∧
      ρ ≫ g_semi = g_tilde ∧
      AlgebraicGeometry.IsDominant η_tilde ∧
      η_tilde ≫ g_tilde =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((algebraMap K F).comp V.subtype)) :=
by
  classical
  let _ := hs₀
  let _ := hLfp
  let vMap : ↥V →+* F := (algebraMap K F).comp V.subtype
  have hvMap_inj : Function.Injective vMap :=
    (RingHom.injective (algebraMap K F)).comp Subtype.val_injective
  let η_V : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of ↥V) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)
  let η_semi : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ C_semi := η_F ≫ ι_semi
  have hη_semi_comm : η_semi ≫ g_semi =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom vMap) := by
    calc (η_F ≫ ι_semi) ≫ g_semi
        = η_F ≫ (ι_semi ≫ g_semi) := Category.assoc _ _ _
      _ = η_F ≫ (p_K ≫ η_V) := by rw [hPb.w]
      _ = (η_F ≫ p_K) ≫ η_V := (Category.assoc _ _ _).symm
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K F)) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype) := by rw [hηF_comm]
      _ = AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom V.subtype ≫ CommRingCat.ofHom (algebraMap K F)) :=
          (AlgebraicGeometry.Spec.map_comp _ _).symm
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom vMap) := by
          rw [CommRingCat.ofHom_comp]

  
  have h_finset_ratio : ∀ {L : ℕ} (f : Fin L → F), (∀ ℓ : Fin L, f ℓ ≠ 0) →
      ∀ A B : Finset (Fin L),
        (∏ ℓ ∈ B, f ℓ) / (∏ ℓ ∈ A, f ℓ) =
          (∏ ℓ ∈ B \ A, f ℓ) * (∏ ℓ ∈ A \ B, (f ℓ)⁻¹) := by
    intro L f hf_ne A B
    have hdisj_B : Disjoint (B ∩ A) (B \ A) :=
      Finset.disjoint_left.mpr (fun _ h1 h2 =>
        (Finset.mem_sdiff.mp h2).2 (Finset.mem_inter.mp h1).2)
    have hdisj_A : Disjoint (B ∩ A) (A \ B) :=
      Finset.disjoint_left.mpr (fun _ h1 h2 =>
        (Finset.mem_sdiff.mp h2).2 (Finset.mem_inter.mp h1).1)
    have hB_eq : B = B ∩ A ∪ (B \ A) := by
      ext x; simp only [Finset.mem_union, Finset.mem_inter, Finset.mem_sdiff]; tauto
    have hA_eq : A = B ∩ A ∪ (A \ B) := by
      ext x; simp only [Finset.mem_union, Finset.mem_inter, Finset.mem_sdiff]; tauto
    have hB_prod : ∏ ℓ ∈ B, f ℓ = (∏ ℓ ∈ B ∩ A, f ℓ) * (∏ ℓ ∈ B \ A, f ℓ) := by
      conv_lhs => rw [hB_eq]
      exact Finset.prod_union hdisj_B
    have hA_prod : ∏ ℓ ∈ A, f ℓ = (∏ ℓ ∈ B ∩ A, f ℓ) * (∏ ℓ ∈ A \ B, f ℓ) := by
      conv_lhs => rw [hA_eq]
      exact Finset.prod_union hdisj_A
    have hInt_ne : (∏ ℓ ∈ B ∩ A, f ℓ) ≠ 0 :=
      Finset.prod_ne_zero_iff.mpr (fun ℓ _ => hf_ne ℓ)
    rw [hB_prod, hA_prod, mul_div_mul_left _ _ hInt_ne, div_eq_mul_inv, Finset.prod_inv_distrib]

  
  have h_val_lift : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Y)
      [AlgebraicGeometry.IsProper f]
      {R₀ K₀ : Type u} [CommRing R₀] [IsDomain R₀] [ValuationRing R₀]
      [Field K₀] [Algebra R₀ K₀] [IsFractionRing R₀ K₀]
      (i₁ : AlgebraicGeometry.Spec (CommRingCat.of K₀) ⟶ X)
      (i₂ : AlgebraicGeometry.Spec (CommRingCat.of R₀) ⟶ Y),
      i₁ ≫ f = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ K₀)) ≫ i₂ →
      ∃ (ψ : AlgebraicGeometry.Spec (CommRingCat.of R₀) ⟶ X),
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ K₀)) ≫ ψ = i₁ ∧
        ψ ≫ f = i₂ := by
    intro X Y f _ R₀ K₀ _ _ _ _ _ _ i₁ i₂ hcomm
    have hUC : AlgebraicGeometry.UniversallyClosed f := inferInstance
    have hEx : AlgebraicGeometry.ValuativeCriterion.Existence f := by
      rw [AlgebraicGeometry.ValuativeCriterion.Existence.eq]
      rw [AlgebraicGeometry.universallyClosed_eq] at hUC
      exact CategoryTheory.MorphismProperty.universally_mono
        (fun _ _ g hg => IsClosedMap.specializingMap hg) f hUC
    let sq : AlgebraicGeometry.ValuativeCommSq f :=
      AlgebraicGeometry.ValuativeCommSq.mk R₀ K₀ i₁ i₂ ⟨hcomm⟩
    obtain ⟨⟨l⟩⟩ := hEx sq
    exact ⟨l.l, l.fac_left, l.fac_right⟩

  
  have h_bezout_flat : ∀ (R A : Type u) [CommRing R] [IsDomain R] [ValuationRing R]
      [CommRing A] (β : R →+* A) (φ : A →+* F),
      Function.Injective φ → Function.Injective (φ.comp β) → RingHom.Flat β := by
    intro R A _ _ _ _ β φ hφ hφβ
    let _ : Algebra R A := β.toAlgebra
    have h_alg : algebraMap R A = β := rfl
    rw [← h_alg, RingHom.flat_algebraMap_iff]
    rw [Module.Flat.flat_iff_torsion_eq_bot_of_isBezout, eq_bot_iff]
    intro x hx
    rw [Submodule.mem_torsion_iff] at hx
    obtain ⟨r, hr⟩ := hx
    have hr_ne : (r : R) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp r.2
    have hmul : β r.1 * x = 0 := hr
    have hmulF : φ (β r.1) * φ x = 0 := by rw [← map_mul, hmul, map_zero]
    have hβr_ne : φ (β r.1) ≠ 0 :=
      fun h0 => hr_ne (hφβ (h0.trans (map_zero (φ.comp β)).symm))
    have hφx : φ x = 0 := (mul_eq_zero.mp hmulF).resolve_left hβr_ne
    have hx0 : x = 0 := hφ (hφx.trans (map_zero φ).symm)
    subst hx0
    exact zero_mem ⊥

  
  
  
  have h_s1 : AlgebraicGeometry.IsDominant η_semi ∧
      ∃ (q L : ℕ)
        (U_cov : Fin q → C_semi.Opens)
        (hAff_cov : ∀ γ : Fin q, AlgebraicGeometry.IsAffineOpen (U_cov γ))
        (φ_cov : ∀ γ : Fin q, C_semi.presheaf.obj (Opposite.op (U_cov γ)) ⟶ CommRingCat.of F)
        (f : Fin L → F)
        (I_cov : Fin q → Finset (Fin L)),
        1 ≤ L ∧
        (∀ ℓ : Fin L, f ℓ ≠ 0) ∧
        (⋃ γ : Fin q, (U_cov γ : Set C_semi)) = Set.univ ∧
        (∀ γ : Fin q,
          Nonempty ↥(U_cov γ) ∧
          Function.Injective (φ_cov γ).hom ∧
          AlgebraicGeometry.Spec.map (φ_cov γ) ≫ (hAff_cov γ).fromSpec = η_semi ∧
          (∀ ℓ ∈ I_cov γ, f ℓ ∈ Set.range (φ_cov γ).hom) ∧
          Set.range (φ_cov γ).hom =
            (Subring.closure
              (Set.range vMap ∪ f '' (I_cov γ : Set (Fin L))) : Set F)) := by
    have hOpen_ηV : AlgebraicGeometry.IsOpenImmersion η_V := by
      let _ : Algebra ↥V K := V.subtype.toAlgebra
      exact @AlgebraicGeometry.IsOpenImmersion.of_isLocalization ↥V K _ _
        V.subtype.toAlgebra s₀ hLocV
    have hRange_ηV : Set.range η_V.base =
        (PrimeSpectrum.basicOpen s₀ : Set (PrimeSpectrum ↥V)) := by
      let _ : Algebra ↥V K := V.subtype.toAlgebra
      have h1 := @PrimeSpectrum.localization_away_comap_range ↥V _ K _
        V.subtype.toAlgebra s₀ hLocV
      exact h1
    have hOpen_ι : AlgebraicGeometry.IsOpenImmersion ι_semi :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (P := @AlgebraicGeometry.IsOpenImmersion) hPb.flip hOpen_ηV
    have hRange_ι : Set.range ι_semi.base =
        g_semi.base ⁻¹' (PrimeSpectrum.basicOpen s₀ : Set (PrimeSpectrum ↥V)) := by
      have h_fst_range : Set.range ι_semi.base =
          Set.range (CategoryTheory.Limits.pullback.fst g_semi η_V).base := by
        ext y
        constructor
        · rintro ⟨x, rfl⟩
          refine ⟨hPb.isoPullback.hom.base x, ?_⟩
          exact congrArg (fun h => h.base x) hPb.isoPullback_hom_fst
        · rintro ⟨z, rfl⟩
          refine ⟨hPb.isoPullback.inv.base z, ?_⟩
          have h1 := congrArg (fun h => h.base (hPb.isoPullback.inv.base z))
            hPb.isoPullback_hom_fst
          have h2 := congrArg (fun h => h.base z) hPb.isoPullback.inv_hom_id
          exact h1.symm.trans (congrArg (CategoryTheory.Limits.pullback.fst g_semi η_V).base h2)
      rw [h_fst_range, AlgebraicGeometry.Scheme.Pullback.range_fst, hRange_ηV]
    have hIrred_CK : IrreducibleSpace ↥C_K :=
      @AlgebraicGeometry.irreducibleSpace_of_isIntegral C_K hIntCK
    have hIrred_semi : IrreducibleSpace ↥C_semi :=
      @AlgebraicGeometry.irreducibleSpace_of_isIntegral C_semi hInt
    obtain ⟨x_CK⟩ := hIrred_CK.toNonempty
    have hRange_ι_ne : (Set.range ι_semi.base).Nonempty := ⟨ι_semi.base x_CK, x_CK, rfl⟩

    
    have hFunc_semi : ∀ (U : C_semi.Opens) (hU : AlgebraicGeometry.IsAffineOpen U),
        Nonempty ↥U →
        ∃ (φ : C_semi.presheaf.obj (Opposite.op U) ⟶ CommRingCat.of F),
          Function.Injective φ.hom ∧
          AlgebraicGeometry.Spec.map φ ≫ hU.fromSpec = η_semi := by
      intro U hU hUne
      have hDomB : IsDomain ↑(C_semi.presheaf.obj (Opposite.op U)) :=
        @AlgebraicGeometry.IsIntegral.component_integral C_semi hInt U hUne
      let α_U : ↥V →+* ↑(C_semi.presheaf.obj (Opposite.op U)) :=
        (AlgebraicGeometry.Spec.preimage (hU.fromSpec ≫ g_semi)).hom
      have hα_U : AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_U) = hU.fromSpec ≫ g_semi :=
        AlgebraicGeometry.Spec.map_preimage _
      let s_U : ↑(C_semi.presheaf.obj (Opposite.op U)) := α_U s₀
      let U₀ : C_semi.Opens := C_semi.basicOpen s_U
      have hU₀_aff : AlgebraicGeometry.IsAffineOpen U₀ := hU.basicOpen s_U
      have hU₀_set : (U₀ : Set C_semi) = (U : Set C_semi) ∩ Set.range ι_semi.base := by
        ext y
        constructor
        · intro hy
          have hyU : y ∈ U := C_semi.basicOpen_le s_U hy
          have hy_range : y ∈ Set.range hU.fromSpec.base := by
            rw [hU.range_fromSpec]; exact hyU
          obtain ⟨q, rfl⟩ := hy_range
          refine ⟨hyU, ?_⟩
          rw [hRange_ι]
          have hq_pre : q ∈ (TopologicalSpace.Opens.map hU.fromSpec.base).obj U₀ := hy
          rw [hU.fromSpec_preimage_basicOpen s_U] at hq_pre
          have hq_not : α_U s₀ ∉ q.asIdeal := hq_pre
          change s₀ ∉ (g_semi.base (hU.fromSpec.base q)).asIdeal
          have hgq : g_semi.base (hU.fromSpec.base q) =
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_U)).base q := by
            rw [hα_U]; rfl
          rw [hgq]
          exact hq_not
        · rintro ⟨hyU, hy_ι⟩
          have hy_range : y ∈ Set.range hU.fromSpec.base := by
            rw [hU.range_fromSpec]; exact hyU
          obtain ⟨q, rfl⟩ := hy_range
          rw [hRange_ι] at hy_ι
          have hgq : g_semi.base (hU.fromSpec.base q) =
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_U)).base q := by
            rw [hα_U]; rfl
          have hq_not : α_U s₀ ∉ q.asIdeal := by
            change s₀ ∉ ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_U)).base q).asIdeal
            rw [← hgq]
            exact hy_ι
          have hq_bo : q ∈ PrimeSpectrum.basicOpen s_U := hq_not
          have hq_pre : q ∈ (TopologicalSpace.Opens.map hU.fromSpec.base).obj U₀ := by
            rwa [hU.fromSpec_preimage_basicOpen s_U]
          exact hq_pre
      have hU_set_ne : (U : Set C_semi).Nonempty := by
        obtain ⟨x, hx⟩ := hUne; exact ⟨x, hx⟩
      have hU₀_set_ne : (U₀ : Set C_semi).Nonempty := by
        rw [hU₀_set]
        exact nonempty_preirreducible_inter U.isOpen ι_semi.isOpenEmbedding.isOpen_range
          hU_set_ne hRange_ι_ne
      have hU₀_ne : Nonempty ↥U₀ := hU₀_set_ne.to_subtype
      have hs_U_ne : s_U ≠ 0 := by
        intro h0
        obtain ⟨z, hz⟩ := hU₀_set_ne
        have hz_bot : z ∈ (⊥ : C_semi.Opens) := by
          have : U₀ = ⊥ := by simp [U₀, h0]
          rwa [this] at hz
        exact False.elim hz_bot
      have hU₀_le_range : U₀ ≤ ι_semi.opensRange := by
        intro z hz
        have hz' : z ∈ (U : Set C_semi) ∩ Set.range ι_semi.base := by
          rwa [← hU₀_set]
        exact hz'.2
      let U_K : C_K.Opens := (TopologicalSpace.Opens.map ι_semi.base).obj U₀
      have hUK_aff : AlgebraicGeometry.IsAffineOpen U_K :=
        hU₀_aff.preimage_of_isOpenImmersion ι_semi hU₀_le_range
      have hUK_ne : Nonempty ↥U_K := by
        obtain ⟨z, hz⟩ := hU₀_set_ne
        obtain ⟨x, rfl⟩ := hU₀_le_range hz
        exact ⟨⟨x, hz⟩⟩
      have h_img_UK : ι_semi ''ᵁ U_K = U₀ := by
        ext z
        constructor
        · rintro ⟨x, hx, rfl⟩; exact hx
        · intro hz
          obtain ⟨x, rfl⟩ := hU₀_le_range hz
          exact ⟨x, hz, rfl⟩
      obtain ⟨φ_UK, hFrac_UK, hη_UK⟩ := hFuncF U_K hUK_aff hUK_ne
      let θ₀ := ι_semi.appLE U₀ U_K le_rfl
      have hθ₀_inj : Function.Injective θ₀.hom := by
        have h_comp : C_semi.presheaf.map (CategoryTheory.eqToHom h_img_UK.symm).op ≫ θ₀ =
            (ι_semi.appIso U_K).hom := by
          rw [AlgebraicGeometry.Scheme.Hom.map_appLE, AlgebraicGeometry.Scheme.Hom.appIso_hom']
        let inv_θ₀ := (ι_semi.appIso U_K).inv ≫
          C_semi.presheaf.map (CategoryTheory.eqToHom h_img_UK.symm).op
        have h_id : θ₀ ≫ inv_θ₀ = 𝟙 _ := by
          have h1 : C_semi.presheaf.map (CategoryTheory.eqToHom h_img_UK).op ≫
              C_semi.presheaf.map (CategoryTheory.eqToHom h_img_UK.symm).op = 𝟙 _ := by
            rw [← Functor.map_comp, ← op_comp, CategoryTheory.eqToHom_trans,
              CategoryTheory.eqToHom_refl, op_id, CategoryTheory.Functor.map_id]
          calc θ₀ ≫ inv_θ₀
              = (𝟙 _ ≫ θ₀) ≫ inv_θ₀ := by rw [Category.id_comp]
            _ = ((C_semi.presheaf.map (CategoryTheory.eqToHom h_img_UK).op ≫
                  C_semi.presheaf.map (CategoryTheory.eqToHom h_img_UK.symm).op) ≫ θ₀) ≫
                  inv_θ₀ := by rw [h1]
            _ = C_semi.presheaf.map (CategoryTheory.eqToHom h_img_UK).op ≫
                  (C_semi.presheaf.map (CategoryTheory.eqToHom h_img_UK.symm).op ≫ θ₀) ≫
                  (ι_semi.appIso U_K).inv ≫
                  C_semi.presheaf.map (CategoryTheory.eqToHom h_img_UK.symm).op := by
                  simp only [inv_θ₀, Category.assoc]
            _ = C_semi.presheaf.map (CategoryTheory.eqToHom h_img_UK).op ≫
                  ((ι_semi.appIso U_K).hom ≫ (ι_semi.appIso U_K).inv) ≫
                  C_semi.presheaf.map (CategoryTheory.eqToHom h_img_UK.symm).op := by
                  rw [h_comp]; simp only [Category.assoc]
            _ = 𝟙 _ := by rw [Iso.hom_inv_id, Category.id_comp, h1]
        intro a b hab
        have h2 := congrArg inv_θ₀.hom hab
        change (θ₀ ≫ inv_θ₀).hom a = (θ₀ ≫ inv_θ₀).hom b at h2
        simpa [h_id] using h2
      let res_U := C_semi.presheaf.map (CategoryTheory.homOfLE (C_semi.basicOpen_le s_U)).op
      let φ_U := res_U ≫ θ₀ ≫ φ_UK
      have hres_inj : Function.Injective res_U.hom := by
        have hLoc_sU : @IsLocalization.Away _ _ s_U
            ↑(C_semi.presheaf.obj (Opposite.op U₀)) _ res_U.hom.toAlgebra :=
          hU.isLocalization_basicOpen s_U
        let _ : Algebra ↑(C_semi.presheaf.obj (Opposite.op U))
            ↑(C_semi.presheaf.obj (Opposite.op U₀)) := res_U.hom.toAlgebra
        intro a b hab
        obtain ⟨⟨c, k, rfl⟩, hc⟩ :=
          (@IsLocalization.eq_iff_exists _ _ (Submonoid.powers s_U) _ _
            res_U.hom.toAlgebra hLoc_sU a b).mp hab
        exact mul_left_cancel₀ (pow_ne_zero k hs_U_ne) hc
      have hφUK_inj : Function.Injective φ_UK.hom :=
        @IsFractionRing.injective _ _ F _ φ_UK.hom.toAlgebra hFrac_UK
      have hφU_inj : Function.Injective φ_U.hom :=
        hφUK_inj.comp (hθ₀_inj.comp hres_inj)
      have hφU_spec : AlgebraicGeometry.Spec.map φ_U ≫ hU.fromSpec = η_semi := by
        calc AlgebraicGeometry.Spec.map (res_U ≫ θ₀ ≫ φ_UK) ≫ hU.fromSpec
            = AlgebraicGeometry.Spec.map φ_UK ≫ AlgebraicGeometry.Spec.map θ₀ ≫
                (AlgebraicGeometry.Spec.map res_U ≫ hU.fromSpec) := by
                simp only [AlgebraicGeometry.Spec.map_comp, Category.assoc]
          _ = AlgebraicGeometry.Spec.map φ_UK ≫
                (AlgebraicGeometry.Spec.map θ₀ ≫ hU₀_aff.fromSpec) := by
                rw [hU.map_fromSpec hU₀_aff]
          _ = (AlgebraicGeometry.Spec.map φ_UK ≫ hUK_aff.fromSpec) ≫ ι_semi := by
                rw [AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec
                  ι_semi hU₀_aff hUK_aff le_rfl, Category.assoc]
          _ = η_semi := by rw [hη_UK]
      exact ⟨φ_U, hφU_inj, hφU_spec⟩

    have hDom_semi : AlgebraicGeometry.IsDominant η_semi := by
      rw [AlgebraicGeometry.isDominant_iff, denseRange_iff_closure_range]
      ext x
      simp only [Set.mem_univ, iff_true, mem_closure_iff]
      intro W hW hxW
      obtain ⟨U, hU_aff, hxU, hU_le⟩ :=
        TopologicalSpace.Opens.isBasis_iff_nbhd.mp
          (AlgebraicGeometry.Scheme.isBasis_affineOpens C_semi) (U := ⟨W, hW⟩) hxW
      obtain ⟨φ_U, _, hφU_spec⟩ := hFunc_semi U hU_aff ⟨⟨x, hxU⟩⟩
      obtain ⟨pt_F⟩ :=
        (inferInstance : IrreducibleSpace ↥(AlgebraicGeometry.Spec (CommRingCat.of F))).toNonempty
      refine ⟨η_semi.base pt_F, ?_, pt_F, rfl⟩
      have hmemU : η_semi.base pt_F ∈ (U : Set C_semi) := by
        rw [← hU_aff.range_fromSpec, ← hφU_spec]
        exact ⟨(AlgebraicGeometry.Spec.map φ_U).base pt_F, rfl⟩
      exact hU_le hmemU

    
    have hUniv_compact : IsCompact (Set.univ : Set ↥C_semi) := by
      have h_pre : (Set.univ : Set ↥C_semi) =
          g_semi.base ⁻¹' (Set.univ : Set ↥(AlgebraicGeometry.Spec (CommRingCat.of ↥V))) := rfl
      rw [h_pre]
      exact AlgebraicGeometry.QuasiCompact.isCompact_preimage Set.univ isOpen_univ isCompact_univ
    have hBasis_pt : ∀ x : ↥C_semi, ∃ (U : C_semi.Opens),
        AlgebraicGeometry.IsAffineOpen U ∧ x ∈ U := by
      intro x
      obtain ⟨U, hU_aff, hxU, _⟩ :=
        TopologicalSpace.Opens.isBasis_iff_nbhd.mp
          (AlgebraicGeometry.Scheme.isBasis_affineOpens C_semi) (U := ⊤) trivial
      exact ⟨U, hU_aff, hxU⟩
    choose U_pt hAff_pt hx_pt using hBasis_pt
    obtain ⟨s_pts, hs_cov⟩ := hUniv_compact.elim_finite_subcover
      (fun x => (U_pt x : Set ↥C_semi)) (fun x => (U_pt x).isOpen)
      (fun x _ => Set.mem_iUnion.mpr ⟨x, hx_pt x⟩)
    let q : ℕ := s_pts.card
    let e_q : Fin q ≃ ↥s_pts := (Fintype.equivFinOfCardEq (Fintype.card_coe s_pts)).symm
    let U_cov (γ : Fin q) : C_semi.Opens := U_pt (e_q γ).1
    let hAff_cov (γ : Fin q) : AlgebraicGeometry.IsAffineOpen (U_cov γ) := hAff_pt (e_q γ).1
    have hCov_univ : (⋃ γ : Fin q, (U_cov γ : Set ↥C_semi)) = Set.univ := by
      ext x
      simp only [Set.mem_univ, iff_true, Set.mem_iUnion]
      have hx_union := hs_cov (Set.mem_univ x)
      simp only [Set.mem_iUnion] at hx_union
      obtain ⟨y, hy_mem, hxy⟩ := hx_union
      exact ⟨e_q.symm ⟨y, hy_mem⟩, by simpa [U_cov] using hxy⟩
    have hNe_cov : ∀ γ : Fin q, Nonempty ↥(U_cov γ) :=
      fun γ => ⟨⟨(e_q γ).1, hx_pt (e_q γ).1⟩⟩
    have hChart_φ : ∀ γ : Fin q,
        ∃ (φ : C_semi.presheaf.obj (Opposite.op (U_cov γ)) ⟶ CommRingCat.of F),
          Function.Injective φ.hom ∧
          AlgebraicGeometry.Spec.map φ ≫ (hAff_cov γ).fromSpec = η_semi :=
      fun γ => hFunc_semi (U_cov γ) (hAff_cov γ) (hNe_cov γ)
    choose φ_cov hInj_cov hSpec_cov using hChart_φ

    
    have hFinGen_chart : ∀ γ : Fin q,
        ∃ T : Finset F,
          (∀ z ∈ T, z ≠ 0 ∧ z ∈ Set.range (φ_cov γ).hom) ∧
          Set.range (φ_cov γ).hom =
            (Subring.closure (Set.range vMap ∪ (T : Set F)) : Set F) := by
      intro γ
      let B_γ := C_semi.presheaf.obj (Opposite.op (U_cov γ))
      let α_γ : ↥V →+* ↑B_γ :=
        (AlgebraicGeometry.Spec.preimage ((hAff_cov γ).fromSpec ≫ g_semi)).hom
      have hα_γ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_γ) =
          (hAff_cov γ).fromSpec ≫ g_semi :=
        AlgebraicGeometry.Spec.map_preimage _
      have h_comp_vMap : (φ_cov γ).hom.comp α_γ = vMap := by
        have h_spec : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((φ_cov γ).hom.comp α_γ)) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom vMap) := by
          calc AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((φ_cov γ).hom.comp α_γ))
              = AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_γ ≫ φ_cov γ) := rfl
            _ = AlgebraicGeometry.Spec.map (φ_cov γ) ≫
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_γ) :=
                AlgebraicGeometry.Spec.map_comp _ _
            _ = (AlgebraicGeometry.Spec.map (φ_cov γ) ≫ (hAff_cov γ).fromSpec) ≫ g_semi := by
                rw [hα_γ, Category.assoc]
            _ = η_semi ≫ g_semi := by rw [hSpec_cov γ]
            _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom vMap) := hη_semi_comm
        exact CommRingCat.Hom.ext_iff.mp (AlgebraicGeometry.Spec.map_injective h_spec)
      have hLft_g : AlgebraicGeometry.LocallyOfFiniteType g_semi := inferInstance
      have hLft_comp : AlgebraicGeometry.LocallyOfFiniteType
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_γ)) := by
        rw [hα_γ]
        exact CategoryTheory.MorphismProperty.comp_mem _ _ _ inferInstance hLft_g
      have hFT_α : RingHom.FiniteType α_γ :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff
          (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp hLft_comp
      let _ : Algebra ↥V ↑B_γ := α_γ.toAlgebra
      have _ : Algebra.FiniteType ↥V ↑B_γ := hFT_α
      obtain ⟨S_γ, hS_γ⟩ := Algebra.FiniteType.out (R := ↥V) (A := ↑B_γ)
      have h_top : Subring.closure (Set.range α_γ ∪ (S_γ : Set ↑B_γ)) = ⊤ := by
        have h_adj := Algebra.adjoin_eq_ring_closure (R := ↥V) (S_γ : Set ↑B_γ)
        have h_alg : algebraMap ↥V ↑B_γ = α_γ := rfl
        rw [hS_γ, h_alg] at h_adj
        exact h_adj.symm
      let T_γ : Finset F := (S_γ.image (φ_cov γ).hom).filter (· ≠ 0)
      refine ⟨T_γ, ?_, ?_⟩
      · intro z hz
        rw [Finset.mem_filter, Finset.mem_image] at hz
        obtain ⟨⟨b, _, rfl⟩, hne⟩ := hz
        exact ⟨hne, ⟨b, rfl⟩⟩
      · have h_map := congrArg (Subring.map (φ_cov γ).hom) h_top
        rw [RingHom.map_closure, Set.image_union, ← Set.range_comp, ← RingHom.coe_comp,
          h_comp_vMap] at h_map
        have h_range_eq : ((⊤ : Subring ↑B_γ).map (φ_cov γ).hom : Set F) =
            Set.range (φ_cov γ).hom := by
          ext z; simp
        have h_clos_eq : Subring.closure
            (Set.range vMap ∪ (φ_cov γ).hom '' (S_γ : Set ↑B_γ)) =
            Subring.closure (Set.range vMap ∪ (T_γ : Set F)) := by
          apply le_antisymm
          · rw [Subring.closure_le]
            rintro z (hz | ⟨b, hb, rfl⟩)
            · exact Subring.subset_closure (Or.inl hz)
            · by_cases h0 : (φ_cov γ).hom b = 0
              · rw [h0]; exact zero_mem _
              · refine Subring.subset_closure (Or.inr ?_)
                exact Finset.mem_coe.mpr (Finset.mem_filter.mpr
                  ⟨Finset.mem_image_of_mem _ hb, h0⟩)
          · rw [Subring.closure_le]
            rintro z (hz | hz)
            · exact Subring.subset_closure (Or.inl hz)
            · have hz' := (Finset.mem_filter.mp (Finset.mem_coe.mp hz)).1
              obtain ⟨b, hb, rfl⟩ := Finset.mem_image.mp hz'
              exact Subring.subset_closure (Or.inr ⟨b, hb, rfl⟩)
        rw [h_clos_eq] at h_map
        exact h_range_eq.symm.trans (congrArg SetLike.coe h_map).symm

    choose T_cov hT_mem hT_clos using hFinGen_chart
    let T_all : Finset F := insert (1 : F) (Finset.univ.biUnion T_cov)
    let L : ℕ := T_all.card
    have hL1 : 1 ≤ L := Finset.card_pos.mpr ⟨1, Finset.mem_insert_self _ _⟩
    let e_L : Fin L ≃ ↥T_all := (Fintype.equivFinOfCardEq (Fintype.card_coe T_all)).symm
    let f (ℓ : Fin L) : F := (e_L ℓ).1
    have hf_ne : ∀ ℓ : Fin L, f ℓ ≠ 0 := by
      intro ℓ
      have hmem := (e_L ℓ).2
      rcases Finset.mem_insert.mp hmem with h1 | hbi
      · rw [show f ℓ = 1 from h1]; exact one_ne_zero
      · obtain ⟨γ, _, hγ⟩ := Finset.mem_biUnion.mp hbi
        exact (hT_mem γ (f ℓ) hγ).1
    let I_cov (γ : Fin q) : Finset (Fin L) :=
      Finset.univ.filter (fun ℓ : Fin L => f ℓ ∈ T_cov γ)
    have hI_img : ∀ γ : Fin q, f '' (I_cov γ : Set (Fin L)) = (T_cov γ : Set F) := by
      intro γ
      ext z
      constructor
      · rintro ⟨ℓ, hℓ, rfl⟩
        exact (Finset.mem_filter.mp (Finset.mem_coe.mp hℓ)).2
      · intro hz
        have hz_all : z ∈ T_all :=
          Finset.mem_insert_of_mem (Finset.mem_biUnion.mpr ⟨γ, Finset.mem_univ γ, hz⟩)
        let ℓ : Fin L := e_L.symm ⟨z, hz_all⟩
        have hfℓ : f ℓ = z := by simp [f, ℓ]
        refine ⟨ℓ, ?_, hfℓ⟩
        exact Finset.mem_coe.mpr (Finset.mem_filter.mpr ⟨Finset.mem_univ ℓ, by rwa [hfℓ]⟩)
    refine ⟨hDom_semi, q, L, U_cov, hAff_cov, φ_cov, f, I_cov, hL1, hf_ne, hCov_univ, ?_⟩
    intro γ
    refine ⟨hNe_cov γ, hInj_cov γ, hSpec_cov γ, ?_, ?_⟩
    · intro ℓ hℓ
      have hfT : f ℓ ∈ T_cov γ := (Finset.mem_filter.mp hℓ).2
      exact (hT_mem γ (f ℓ) hfT).2
    · rw [hI_img γ]
      exact hT_clos γ

  obtain ⟨hDom_semi, q, L, U_cov, hAff_cov, φ_cov, f, I_cov, hL1, hf_ne, hCov, hCharts_semi⟩ :=
    h_s1

  
  let N : ℕ := 2 ^ L - 1
  have hN1 : N + 1 = 2 ^ L := Nat.sub_add_cancel Nat.one_le_two_pow
  have hCard_sub : Fintype.card (Fin (N + 1)) = Fintype.card (Finset (Fin L)) := by
    rw [Fintype.card_fin, Fintype.card_finset, Fintype.card_fin, hN1]
  let e_sub : Fin (N + 1) ≃ Finset (Fin L) := Fintype.equivOfCardEq hCard_sub
  let g_prod (a : Fin (N + 1)) : F := ∏ ℓ ∈ e_sub a, f ℓ
  have hg_ne : ∀ a : Fin (N + 1), g_prod a ≠ 0 :=
    fun a => Finset.prod_ne_zero_iff.mpr (fun ℓ _ => hf_ne ℓ)

  
  
  
  have h_s2 : ∀ (P_V : AlgebraicGeometry.Scheme.{u})
      (π_V : P_V ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
      (U_PV : Fin (N + 1) → P_V.Opens)
      (hAff_V : ∀ a : Fin (N + 1), AlgebraicGeometry.IsAffineOpen (U_PV a))
      (c_V : ∀ a : Fin (N + 1), ↥V →+* ↑(P_V.presheaf.obj (Opposite.op (U_PV a))))
      (t_V : ∀ a : Fin (N + 1), Fin (N + 1) → ↑(P_V.presheaf.obj (Opposite.op (U_PV a)))),
      AlgebraicGeometry.IsProper π_V →
      (⨆ a : Fin (N + 1), U_PV a) = ⊤ →
      (∀ a : Fin (N + 1),
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (c_V a)) = (hAff_V a).fromSpec ≫ π_V) →
      (∀ a : Fin (N + 1), Subring.closure (Set.range (c_V a) ∪ Set.range (t_V a)) = ⊤) →
      (∀ (a : Fin (N + 1)) (A : Type u) [CommRing A] (ρ : ↥V →+* A) (v : Fin (N + 1) → A),
        v a = 1 →
        ∃ (ψ : ↑(P_V.presheaf.obj (Opposite.op (U_PV a))) →+* A),
          ψ.comp (c_V a) = ρ ∧ ∀ b : Fin (N + 1), ψ (t_V a b) = v b) →
      (∀ a a' : Fin (N + 1), P_V.basicOpen (t_V a a') = U_PV a ⊓ U_PV a') →
      (∀ (a a' : Fin (N + 1)) (r : ↥V),
        (P_V.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom (c_V a' r) =
        (P_V.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (c_V a r)) →
      (∀ (a a' b : Fin (N + 1)),
        (P_V.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom (t_V a' b) *
        (P_V.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (t_V a a') =
        (P_V.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (t_V a b)) →
      ∃ (C_tilde : AlgebraicGeometry.Scheme.{u})
        (g_tilde : C_tilde ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
        (ιP_tilde : C_tilde ⟶ P_V)
        (η_tilde : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ C_tilde)
        (U_tilde : Fin (N + 1) → C_tilde.Opens)
        (hAff_tilde : ∀ a : Fin (N + 1), AlgebraicGeometry.IsAffineOpen (U_tilde a))
        (φ_tilde : ∀ a : Fin (N + 1),
          C_tilde.presheaf.obj (Opposite.op (U_tilde a)) ⟶ CommRingCat.of F)
        (β_tilde : ∀ a : Fin (N + 1),
          ↥V →+* ↑(C_tilde.presheaf.obj (Opposite.op (U_tilde a))))
        (u_tilde : ∀ a : Fin (N + 1), Fin (N + 1) →
          ↑(C_tilde.presheaf.obj (Opposite.op (U_tilde a)))),
        AlgebraicGeometry.IsIntegral C_tilde ∧
        AlgebraicGeometry.Flat g_tilde ∧
        AlgebraicGeometry.IsProper g_tilde ∧
        AlgebraicGeometry.IsClosedImmersion ιP_tilde ∧
        ιP_tilde ≫ π_V = g_tilde ∧
        AlgebraicGeometry.IsDominant η_tilde ∧
        η_tilde ≫ g_tilde = AlgebraicGeometry.Spec.map (CommRingCat.ofHom vMap) ∧
        (⨆ a : Fin (N + 1), U_tilde a) = ⊤ ∧
        (∀ a : Fin (N + 1),
          (∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of F)), η_tilde.base pt ∈ U_tilde a) ∧
          Function.Injective (φ_tilde a).hom ∧
          AlgebraicGeometry.Spec.map (φ_tilde a) ≫ (hAff_tilde a).fromSpec = η_tilde ∧
          (hAff_tilde a).fromSpec ≫ g_tilde =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (β_tilde a)) ∧
          (φ_tilde a).hom.comp (β_tilde a) = vMap ∧
          (∀ a' : Fin (N + 1), C_tilde.basicOpen (u_tilde a a') = U_tilde a ⊓ U_tilde a') ∧
          (∀ b : Fin (N + 1), (φ_tilde a).hom (u_tilde a b) = g_prod b / g_prod a) ∧
          Set.range (φ_tilde a).hom =
            (Subring.closure
              (Set.range vMap ∪
                Set.range (fun b : Fin (N + 1) => g_prod b / g_prod a)) : Set F)) := by
    intro P_V π_V U_PV hAff_V c_V t_V hC1 hC2 hC3 hC6 hC7 hC8 hC9 hC10
    have h_ev : ∀ a : Fin (N + 1),
        ∃ (ev : ↑(P_V.presheaf.obj (Opposite.op (U_PV a))) →+* F),
          ev.comp (c_V a) = vMap ∧ ∀ b : Fin (N + 1), ev (t_V a b) = g_prod b / g_prod a :=
      fun a => hC7 a F vMap (fun b => g_prod b / g_prod a) (div_self (hg_ne a))
    choose ev hev_c hev_t using h_ev
    let a₀ : Fin (N + 1) := 0
    let ψ_F : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ P_V :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ev a₀)) ≫ (hAff_V a₀).fromSpec

    
    have hψ_chart : ∀ a : Fin (N + 1),
        ψ_F = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ev a)) ≫ (hAff_V a).fromSpec := by
      intro a
      let w₀ := t_V a₀ a
      let W₀ : P_V.Opens := P_V.basicOpen w₀
      have hAff_W₀ : AlgebraicGeometry.IsAffineOpen W₀ := (hAff_V a₀).basicOpen w₀
      have h_bo : W₀ = U_PV a₀ ⊓ U_PV a := hC8 a₀ a
      have hle_L : W₀ ≤ U_PV a₀ := P_V.basicOpen_le w₀
      have hle_R : W₀ ≤ U_PV a := h_bo.le.trans inf_le_right
      let res_L := P_V.presheaf.map (CategoryTheory.homOfLE hle_L).op
      let res_R := P_V.presheaf.map (CategoryTheory.homOfLE hle_R).op
      have hLoc_W₀ : @IsLocalization.Away _ _ w₀
          ↑(P_V.presheaf.obj (Opposite.op W₀)) _ res_L.hom.toAlgebra :=
        (hAff_V a₀).isLocalization_basicOpen w₀
      let _ : Algebra ↑(P_V.presheaf.obj (Opposite.op (U_PV a₀)))
          ↑(P_V.presheaf.obj (Opposite.op W₀)) := res_L.hom.toAlgebra
      have hw₀_ne : ev a₀ w₀ ≠ 0 := by
        rw [hev_t a₀ a]
        exact div_ne_zero (hg_ne a) (hg_ne a₀)
      have hw₀_unit : IsUnit (ev a₀ w₀) := isUnit_iff_ne_zero.mpr hw₀_ne
      let ev_W : ↑(P_V.presheaf.obj (Opposite.op W₀)) →+* F :=
        IsLocalization.Away.lift w₀ hw₀_unit
      have hev_WL : ev_W.comp res_L.hom = ev a₀ := by
        ext x
        exact IsLocalization.Away.lift_eq w₀ hw₀_unit x
      have hev_WR : ev_W.comp res_R.hom = ev a := by
        let eq_hom : W₀ ⟶ U_PV a₀ ⊓ U_PV a := CategoryTheory.homOfLE h_bo.le
        have h_L_fac : CategoryTheory.homOfLE hle_L =
            eq_hom ≫ CategoryTheory.homOfLE inf_le_left := Subsingleton.elim _ _
        have h_R_fac : CategoryTheory.homOfLE hle_R =
            eq_hom ≫ CategoryTheory.homOfLE inf_le_right := Subsingleton.elim _ _
        have h_eqLocus : (⊤ : Subring ↑(P_V.presheaf.obj (Opposite.op (U_PV a)))) ≤
            RingHom.eqLocus (ev_W.comp res_R.hom) (ev a) := by
          rw [← hC6 a, Subring.closure_le]
          rintro z (⟨r, rfl⟩ | ⟨b, rfl⟩)
          · change ev_W (res_R.hom (c_V a r)) = ev a (c_V a r)
            have hc_res : res_R.hom (c_V a r) = res_L.hom (c_V a₀ r) := by
              change (P_V.presheaf.map (CategoryTheory.homOfLE hle_R).op).hom (c_V a r) =
                (P_V.presheaf.map (CategoryTheory.homOfLE hle_L).op).hom (c_V a₀ r)
              rw [h_R_fac, h_L_fac, op_comp, Functor.map_comp, op_comp, Functor.map_comp]
              exact congrArg (P_V.presheaf.map eq_hom.op).hom (hC9 a₀ a r)
            rw [hc_res]
            calc ev_W (res_L.hom (c_V a₀ r))
                = (ev_W.comp res_L.hom) (c_V a₀ r) := rfl
              _ = ev a₀ (c_V a₀ r) := by rw [hev_WL]
              _ = vMap r := by rw [← RingHom.comp_apply, hev_c a₀]
              _ = ev a (c_V a r) := by rw [← RingHom.comp_apply, hev_c a]
          · change ev_W (res_R.hom (t_V a b)) = ev a (t_V a b)
            have ht_res : res_R.hom (t_V a b) * res_L.hom w₀ = res_L.hom (t_V a₀ b) := by
              change (P_V.presheaf.map (CategoryTheory.homOfLE hle_R).op).hom (t_V a b) *
                (P_V.presheaf.map (CategoryTheory.homOfLE hle_L).op).hom w₀ =
                (P_V.presheaf.map (CategoryTheory.homOfLE hle_L).op).hom (t_V a₀ b)
              rw [h_R_fac, h_L_fac, op_comp, Functor.map_comp, op_comp, Functor.map_comp]
              have h10 := congrArg (P_V.presheaf.map eq_hom.op).hom (hC10 a₀ a b)
              simpa [map_mul] using h10
            have hw₀_app : ev_W (res_L.hom w₀) = ev a₀ w₀ :=
              congrFun (congrArg DFunLike.coe hev_WL) w₀
            apply mul_right_cancel₀ hw₀_ne
            calc ev_W (res_R.hom (t_V a b)) * ev a₀ w₀
                = ev_W (res_R.hom (t_V a b)) * ev_W (res_L.hom w₀) := by rw [hw₀_app]
              _ = ev_W (res_R.hom (t_V a b) * res_L.hom w₀) := (map_mul _ _ _).symm
              _ = ev_W (res_L.hom (t_V a₀ b)) := by rw [ht_res]
              _ = (ev_W.comp res_L.hom) (t_V a₀ b) := rfl
              _ = ev a₀ (t_V a₀ b) := by rw [hev_WL]
              _ = g_prod b / g_prod a₀ := hev_t a₀ b
              _ = (g_prod b / g_prod a) * (g_prod a / g_prod a₀) :=
                  (div_mul_div_cancel₀ (hg_ne a)).symm
              _ = ev a (t_V a b) * ev a₀ w₀ := by rw [hev_t a b, hev_t a₀ a]
        ext z
        exact h_eqLocus (Subring.mem_top z)
      have h_hom_L : CommRingCat.ofHom (ev_W.comp res_L.hom) =
          res_L ≫ CommRingCat.ofHom ev_W := rfl
      have h_hom_R : CommRingCat.ofHom (ev_W.comp res_R.hom) =
          res_R ≫ CommRingCat.ofHom ev_W := rfl
      calc ψ_F
          = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ev_W.comp res_L.hom)) ≫
              (hAff_V a₀).fromSpec := by rw [hev_WL]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev_W) ≫
              (AlgebraicGeometry.Spec.map res_L ≫ (hAff_V a₀).fromSpec) := by
              rw [h_hom_L, AlgebraicGeometry.Spec.map_comp, Category.assoc]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev_W) ≫ hAff_W₀.fromSpec := by
              rw [(hAff_V a₀).map_fromSpec hAff_W₀]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev_W) ≫
              (AlgebraicGeometry.Spec.map res_R ≫ (hAff_V a).fromSpec) := by
              rw [(hAff_V a).map_fromSpec hAff_W₀]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ev_W.comp res_R.hom)) ≫
              (hAff_V a).fromSpec := by
              rw [← Category.assoc, ← AlgebraicGeometry.Spec.map_comp, ← h_hom_R]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ev a)) ≫ (hAff_V a).fromSpec := by
              rw [hev_WR]

    
    let C_tilde : AlgebraicGeometry.Scheme.{u} := ψ_F.image
    let ιP_tilde : C_tilde ⟶ P_V := ψ_F.imageι
    let g_tilde : C_tilde ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V) := ιP_tilde ≫ π_V
    let η_tilde : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ C_tilde := ψ_F.toImage
    have hη_ιP : η_tilde ≫ ιP_tilde = ψ_F := AlgebraicGeometry.Scheme.Hom.toImage_imageι ψ_F
    have hCl_tilde : AlgebraicGeometry.IsClosedImmersion ιP_tilde := inferInstance
    have _ : AlgebraicGeometry.IsProper π_V := hC1
    have hProp_tilde : AlgebraicGeometry.IsProper g_tilde :=
      CategoryTheory.MorphismProperty.comp_mem _ _ _ inferInstance hC1
    have hQC_ψ : AlgebraicGeometry.QuasiCompact ψ_F := by
      have h_bot_F : ∀ (I : Ideal F), I.IsPrime → I = ⊥ := by
        intro I hI
        ext x
        rw [Submodule.mem_bot]
        constructor
        · intro hx
          by_contra hx0
          exact hI.ne_top (Ideal.eq_top_of_isUnit_mem I hx (isUnit_iff_ne_zero.mpr hx0))
        · rintro rfl; exact I.zero_mem
      exact ⟨fun _ _ _ => Set.Subsingleton.isCompact (fun p _ q _ =>
        PrimeSpectrum.ext ((h_bot_F p.asIdeal p.isPrime).trans
          (h_bot_F q.asIdeal q.isPrime).symm))⟩
    have hDom_tilde : AlgebraicGeometry.IsDominant η_tilde :=
      @AlgebraicGeometry.Scheme.instIsDominantToImageOfQuasiCompact _ _ ψ_F hQC_ψ
    have hη_tilde_comm : η_tilde ≫ g_tilde =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom vMap) := by
      calc η_tilde ≫ (ιP_tilde ≫ π_V)
          = (η_tilde ≫ ιP_tilde) ≫ π_V := (Category.assoc _ _ _).symm
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ev a₀)) ≫
              ((hAff_V a₀).fromSpec ≫ π_V) := by rw [hη_ιP, Category.assoc]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ev a₀)) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (c_V a₀)) := by rw [← hC3 a₀]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((ev a₀).comp (c_V a₀))) := by
              rw [← AlgebraicGeometry.Spec.map_comp, CommRingCat.ofHom_comp]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom vMap) := by rw [hev_c a₀]

    
    let U_tilde (a : Fin (N + 1)) : C_tilde.Opens :=
      (TopologicalSpace.Opens.map ιP_tilde.base).obj (U_PV a)
    let hAff_tilde (a : Fin (N + 1)) : AlgebraicGeometry.IsAffineOpen (U_tilde a) :=
      (hAff_V a).preimage ιP_tilde
    have hTop_tilde : (⨆ a : Fin (N + 1), U_tilde a) = ⊤ := by
      rw [eq_top_iff]
      intro x _
      rw [TopologicalSpace.Opens.mem_iSup]
      have hx_top : ιP_tilde.base x ∈ (⊤ : P_V.Opens) := trivial
      rw [← hC2, TopologicalSpace.Opens.mem_iSup] at hx_top
      exact hx_top
    have hη_mem_tilde : ∀ (a : Fin (N + 1))
        (pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of F))), η_tilde.base pt ∈ U_tilde a := by
      intro a pt
      change ιP_tilde.base (η_tilde.base pt) ∈ (U_PV a : Set ↥P_V)
      have h_pt : ιP_tilde.base (η_tilde.base pt) =
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ev a)) ≫
            (hAff_V a).fromSpec).base pt :=
        congrArg (fun h => h.base pt) (hη_ιP.trans (hψ_chart a))
      rw [h_pt, ← (hAff_V a).range_fromSpec]
      exact ⟨(AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ev a))).base pt, rfl⟩
    let φ_tilde (a : Fin (N + 1)) :
        C_tilde.presheaf.obj (Opposite.op (U_tilde a)) ⟶ CommRingCat.of F :=
      AlgebraicGeometry.Spec.preimage
        (AlgebraicGeometry.IsOpenImmersion.lift (hAff_tilde a).fromSpec η_tilde
          (by
            rw [(hAff_tilde a).range_fromSpec]
            rintro _ ⟨pt, rfl⟩
            exact hη_mem_tilde a pt))
    have hφ_tilde_spec : ∀ a : Fin (N + 1),
        AlgebraicGeometry.Spec.map (φ_tilde a) ≫ (hAff_tilde a).fromSpec = η_tilde := by
      intro a
      rw [AlgebraicGeometry.Spec.map_preimage]
      exact AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ _
    have hφ_comp_app : ∀ a : Fin (N + 1),
        (φ_tilde a).hom.comp (ιP_tilde.app (U_PV a)).hom = ev a := by
      intro a
      have h_eq_spec :
          AlgebraicGeometry.Spec.map (ιP_tilde.app (U_PV a) ≫ φ_tilde a) ≫ (hAff_V a).fromSpec =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ev a)) ≫ (hAff_V a).fromSpec := by
        calc AlgebraicGeometry.Spec.map (ιP_tilde.app (U_PV a) ≫ φ_tilde a) ≫
                (hAff_V a).fromSpec
            = AlgebraicGeometry.Spec.map (φ_tilde a) ≫
                (AlgebraicGeometry.Spec.map (ιP_tilde.app (U_PV a)) ≫ (hAff_V a).fromSpec) := by
              rw [AlgebraicGeometry.Spec.map_comp, Category.assoc]
          _ = AlgebraicGeometry.Spec.map (φ_tilde a) ≫ ((hAff_tilde a).fromSpec ≫ ιP_tilde) := by
              rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE,
                AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec
                  ιP_tilde (hAff_V a) (hAff_tilde a) le_rfl]
          _ = (AlgebraicGeometry.Spec.map (φ_tilde a) ≫ (hAff_tilde a).fromSpec) ≫ ιP_tilde :=
              (Category.assoc _ _ _).symm
          _ = η_tilde ≫ ιP_tilde := by rw [hφ_tilde_spec a]
          _ = ψ_F := hη_ιP
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ev a)) ≫ (hAff_V a).fromSpec :=
              hψ_chart a
      have h_eq_hom := AlgebraicGeometry.Spec.map_injective
        ((cancel_mono (hAff_V a).fromSpec).mp h_eq_spec)
      exact CommRingCat.Hom.ext_iff.mp h_eq_hom

    let β_tilde (a : Fin (N + 1)) :
        ↥V →+* ↑(C_tilde.presheaf.obj (Opposite.op (U_tilde a))) :=
      ((ιP_tilde.app (U_PV a)).hom).comp (c_V a)
    let u_tilde (a : Fin (N + 1)) (b : Fin (N + 1)) :
        ↑(C_tilde.presheaf.obj (Opposite.op (U_tilde a))) :=
      (ιP_tilde.app (U_PV a)).hom (t_V a b)

    
    have hSurj_ιP : ∀ a : Fin (N + 1), Function.Surjective (ιP_tilde.app (U_PV a)).hom := by
      intro a
      let U_aff : P_V.affineOpens := ⟨U_PV a, hAff_V a⟩
      have h_sub := AlgebraicGeometry.Scheme.IdealSheafData.subschemeι_app ψ_F.ker U_aff
      change Function.Surjective (ψ_F.ker.subschemeι.app U_aff.1).hom
      rw [h_sub]
      intro x
      obtain ⟨y, hy⟩ := Ideal.Quotient.mk_surjective ((ψ_F.ker.subschemeObjIso U_aff).hom.hom x)
      refine ⟨y, ?_⟩
      change (ψ_F.ker.subschemeObjIso U_aff).inv.hom (Ideal.Quotient.mk _ y) = x
      rw [hy]
      change ((ψ_F.ker.subschemeObjIso U_aff).hom ≫ (ψ_F.ker.subschemeObjIso U_aff).inv).hom x = x
      rw [Iso.hom_inv_id]; rfl

    have hInj_φ : ∀ a : Fin (N + 1), Function.Injective (φ_tilde a).hom := by
      intro a
      rw [injective_iff_map_eq_zero]
      intro x hx
      obtain ⟨y, rfl⟩ := hSurj_ιP a x
      have hev_y : ev a y = 0 := by
        rw [← hφ_comp_app a]; exact hx
      let U_aff : P_V.affineOpens := ⟨U_PV a, hAff_V a⟩
      have h_ker_eq : RingHom.ker (ιP_tilde.app (U_PV a)).hom =
          RingHom.ker (ψ_F.app (U_PV a)).hom := by
        have h1 : RingHom.ker (ιP_tilde.app U_aff.1).hom = ιP_tilde.ker.ideal U_aff :=
          (AlgebraicGeometry.Scheme.Hom.ker_apply ιP_tilde U_aff).symm
        have h2 : ιP_tilde.ker = ψ_F.ker :=
          AlgebraicGeometry.Scheme.IdealSheafData.ker_subschemeι ψ_F.ker
        have h3 : ψ_F.ker.ideal U_aff = RingHom.ker (ψ_F.app U_aff.1).hom :=
          @AlgebraicGeometry.Scheme.Hom.ker_apply _ _ ψ_F hQC_ψ U_aff
        exact h1.trans ((congrArg (fun I => I.ideal U_aff) h2).trans h3)
      suffices hy_ker : y ∈ RingHom.ker (ψ_F.app (U_PV a)).hom by
        rw [← h_ker_eq] at hy_ker
        exact hy_ker
      have h_pre_top : (TopologicalSpace.Opens.map ψ_F.base).obj (U_PV a) = ⊤ := by
        ext pt
        constructor
        · intro _; trivial
        · intro _
          change ψ_F.base pt ∈ U_PV a
          rw [← hη_ιP]
          exact hη_mem_tilde a pt
      have h_top_le : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of F)).Opens) ≤
          (TopologicalSpace.Opens.map ψ_F.base).obj (U_PV a) := h_pre_top.ge
      let hAff_F_top : AlgebraicGeometry.IsAffineOpen
          (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of F)).Opens) :=
        AlgebraicGeometry.isAffineOpen_top (AlgebraicGeometry.Spec (CommRingCat.of F))
      have h_spec_appLE :
          AlgebraicGeometry.Spec.map (ψ_F.appLE (U_PV a) ⊤ h_top_le) ≫ (hAff_V a).fromSpec =
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (ev a) ≫
              AlgebraicGeometry.Spec.preimage hAff_F_top.fromSpec) ≫
            (hAff_V a).fromSpec := by
        rw [AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec
          ψ_F (hAff_V a) hAff_F_top h_top_le]
        rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
          Category.assoc, ← hψ_chart a]
      have h_appLE_eq := AlgebraicGeometry.Spec.map_injective
        ((cancel_mono (hAff_V a).fromSpec).mp h_spec_appLE)
      have hy_appLE : (ψ_F.appLE (U_PV a) ⊤ h_top_le).hom y = 0 := by
        rw [h_appLE_eq]
        change (AlgebraicGeometry.Spec.preimage hAff_F_top.fromSpec).hom (ev a y) = 0
        rw [hev_y, map_zero]
      have h_app_fac : ψ_F.app (U_PV a) =
          ψ_F.appLE (U_PV a) ⊤ h_top_le ≫
            (AlgebraicGeometry.Spec (CommRingCat.of F)).presheaf.map
              (CategoryTheory.eqToHom h_pre_top).op := by
        rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE]
        simp [AlgebraicGeometry.Scheme.Hom.appLE, ← Functor.map_comp]
      change (ψ_F.app (U_PV a)).hom y = 0
      rw [h_app_fac]
      change ((AlgebraicGeometry.Spec (CommRingCat.of F)).presheaf.map
        (CategoryTheory.eqToHom h_pre_top).op).hom
        ((ψ_F.appLE (U_PV a) ⊤ h_top_le).hom y) = 0
      rw [hy_appLE, map_zero]

    have hFromSpec_g : ∀ a : Fin (N + 1),
        (hAff_tilde a).fromSpec ≫ g_tilde =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (β_tilde a)) := by
      intro a
      calc (hAff_tilde a).fromSpec ≫ (ιP_tilde ≫ π_V)
          = ((hAff_tilde a).fromSpec ≫ ιP_tilde) ≫ π_V := (Category.assoc _ _ _).symm
        _ = AlgebraicGeometry.Spec.map (ιP_tilde.app (U_PV a)) ≫
              ((hAff_V a).fromSpec ≫ π_V) := by
              rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE,
                ← AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec
                  ιP_tilde (hAff_V a) (hAff_tilde a) le_rfl, Category.assoc]
        _ = AlgebraicGeometry.Spec.map (ιP_tilde.app (U_PV a)) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (c_V a)) := by rw [← hC3 a]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (β_tilde a)) := by
              rw [← AlgebraicGeometry.Spec.map_comp]; rfl

    
    have hIrred_tilde : IrreducibleSpace ↥C_tilde := by
      have hIrred_F : IrreducibleSpace ↥(AlgebraicGeometry.Spec (CommRingCat.of F)) := inferInstance
      have hIrred_univ : IsIrreducible (Set.univ : Set ↥C_tilde) := by
        rw [← hDom_tilde.denseRange.closure_eq, ← Set.image_univ]
        exact (IsIrreducible.image
          (IrreducibleSpace.isIrreducible_univ ↥(AlgebraicGeometry.Spec (CommRingCat.of F)))
          η_tilde.base η_tilde.continuous.continuousOn).closure
      obtain ⟨x_ne, _⟩ := hIrred_univ.nonempty
      exact { isPreirreducible_univ := hIrred_univ.isPreirreducible
              toNonempty := ⟨x_ne⟩ }
    have hRed_stalk : ∀ x : ↥C_tilde, IsReduced ↑(C_tilde.presheaf.stalk x) := by
      intro x
      have hx_top : x ∈ (⊤ : C_tilde.Opens) := trivial
      rw [← hTop_tilde, TopologicalSpace.Opens.mem_iSup] at hx_top
      obtain ⟨a, hx_a⟩ := hx_top
      have hRed_ring : IsReduced ↑(C_tilde.presheaf.obj (Opposite.op (U_tilde a))) := by
        refine ⟨fun r ⟨k, hr⟩ => hInj_φ a ?_⟩
        rw [map_zero]
        have hrF : ((φ_tilde a).hom r) ^ k = 0 := by rw [← map_pow, hr, map_zero]
        exact IsNilpotent.eq_zero ⟨k, hrF⟩
      have _ : AlgebraicGeometry.IsReduced
          (AlgebraicGeometry.Spec (C_tilde.presheaf.obj (Opposite.op (U_tilde a)))) :=
        (AlgebraicGeometry.affine_isReduced_iff _).mpr hRed_ring
      have _ : AlgebraicGeometry.IsReduced (U_tilde a).toScheme :=
        AlgebraicGeometry.isReduced_of_isOpenImmersion (hAff_tilde a).isoSpec.hom
      have _ : IsReduced ↑((U_tilde a).toScheme.presheaf.stalk ⟨x, hx_a⟩) :=
        AlgebraicGeometry.isReduced_stalk_of_isReduced (U_tilde a).toScheme ⟨x, hx_a⟩
      let e_stalk := (U_tilde a).stalkIso ⟨x, hx_a⟩
      refine ⟨fun s ⟨k, hs⟩ => ?_⟩
      have hs' : (e_stalk.inv.hom s) ^ k = 0 := by rw [← map_pow, hs, map_zero]
      have h0 : e_stalk.inv.hom s = 0 := IsNilpotent.eq_zero ⟨k, hs'⟩
      have h_id := congrArg e_stalk.hom.hom h0
      rw [map_zero] at h_id
      change (e_stalk.inv ≫ e_stalk.hom).hom s = 0 at h_id
      simpa [Iso.inv_hom_id] using h_id
    have _ : AlgebraicGeometry.IsReduced C_tilde :=
      AlgebraicGeometry.isReduced_of_isReduced_stalk C_tilde
    have hInt_tilde : AlgebraicGeometry.IsIntegral C_tilde :=
      AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced C_tilde

    
    have hFlat_tilde : AlgebraicGeometry.Flat g_tilde := by
      have _ : AlgebraicGeometry.IsZariskiLocalAtSource (@AlgebraicGeometry.Flat) :=
        @AlgebraicGeometry.HasRingHomProperty.instIsZariskiLocalAtSource
          (@AlgebraicGeometry.Flat) (@RingHom.Flat) inferInstance
      rw [AlgebraicGeometry.IsZariskiLocalAtSource.iff_of_iSup_eq_top
        (P := @AlgebraicGeometry.Flat) U_tilde hTop_tilde]
      intro a
      have h_comp_β : (φ_tilde a).hom.comp (β_tilde a) = vMap := by
        change ((φ_tilde a).hom.comp (ιP_tilde.app (U_PV a)).hom).comp (c_V a) = vMap
        rw [hφ_comp_app a, hev_c a]
      have hFlat_β : RingHom.Flat (β_tilde a) :=
        h_bezout_flat ↥V ↑(C_tilde.presheaf.obj (Opposite.op (U_tilde a)))
          (β_tilde a) (φ_tilde a).hom (hInj_φ a) (by rwa [h_comp_β])
      have hFlat_spec : AlgebraicGeometry.Flat
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (β_tilde a))) :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Flat)).mpr hFlat_β
      have h_fac_a : (U_tilde a).ι ≫ g_tilde =
          (hAff_tilde a).isoSpec.hom ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (β_tilde a)) := by
        have h_iso_ι : (hAff_tilde a).isoSpec.hom ≫ (hAff_tilde a).fromSpec = (U_tilde a).ι := by
          rw [← (hAff_tilde a).isoSpec_inv_ι, ← Category.assoc, Iso.hom_inv_id, Category.id_comp]
        calc (U_tilde a).ι ≫ g_tilde
            = ((hAff_tilde a).isoSpec.hom ≫ (hAff_tilde a).fromSpec) ≫ g_tilde := by
              rw [h_iso_ι]
          _ = (hAff_tilde a).isoSpec.hom ≫ ((hAff_tilde a).fromSpec ≫ g_tilde) :=
              Category.assoc _ _ _
          _ = (hAff_tilde a).isoSpec.hom ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom (β_tilde a)) :=
              congrArg ((hAff_tilde a).isoSpec.hom ≫ ·) (hFromSpec_g a)
      rw [h_fac_a]
      exact CategoryTheory.MorphismProperty.comp_mem _ _ _ inferInstance hFlat_spec

    refine ⟨C_tilde, g_tilde, ιP_tilde, η_tilde, U_tilde, hAff_tilde, φ_tilde, β_tilde, u_tilde,
      hInt_tilde, hFlat_tilde, hProp_tilde, hCl_tilde, rfl, hDom_tilde, hη_tilde_comm,
      hTop_tilde, ?_⟩
    intro a
    refine ⟨hη_mem_tilde a, hInj_φ a, hφ_tilde_spec a, hFromSpec_g a, ?_, ?_, ?_, ?_⟩
    · change ((φ_tilde a).hom.comp (ιP_tilde.app (U_PV a)).hom).comp (c_V a) = vMap
      rw [hφ_comp_app a, hev_c a]
    · intro a'
      rw [← AlgebraicGeometry.Scheme.Hom.preimage_basicOpen, hC8 a a']
      rfl
    · intro b
      change ((φ_tilde a).hom.comp (ιP_tilde.app (U_PV a)).hom) (t_V a b) = g_prod b / g_prod a
      rw [hφ_comp_app a, hev_t a b]
    · have h_range_ev : Set.range (φ_tilde a).hom = Set.range (ev a) := by
        rw [← hφ_comp_app a, RingHom.coe_comp, Set.range_comp,
          (hSurj_ιP a).range_eq, Set.image_univ]
      rw [h_range_ev]
      have h_map := congrArg (Subring.map (ev a)) (hC6 a)
      rw [RingHom.map_closure, Set.image_union, ← Set.range_comp, ← RingHom.coe_comp,
        hev_c a, ← Set.range_comp] at h_map
      have h_fun_t : ev a ∘ t_V a = fun b : Fin (N + 1) => g_prod b / g_prod a := by
        funext b; exact hev_t a b
      rw [h_fun_t] at h_map
      have h_top_map : ((⊤ : Subring _).map (ev a) : Set F) = Set.range (ev a) := by
        ext z; simp
      exact h_top_map.symm.trans (congrArg SetLike.coe h_map).symm

  have hCoord_V := hCoord_proj ↥V N
  obtain ⟨C_tilde, g_tilde, ιP_tilde, η_tilde, U_tilde, hAff_tilde, φ_tilde, β_tilde, u_tilde,
      hInt_tilde, hFlat_tilde, hProp_tilde, hCl_tilde, hComm_tilde, hDom_tilde, hη_tilde_comm,
      hTop_tilde, hCharts_tilde⟩ :=
    h_s2 (weilProjectiveSpaceOver ↥V N).left (weilProjectiveSpaceOver ↥V N).hom
      (weilProjBasicOpen ↥V N) (hAff_proj ↥V N) (c_proj ↥V N) (t_proj ↥V N)
      hCoord_V.1 hCoord_V.2.1 hCoord_V.2.2.1 hCoord_V.2.2.2.2.2.1
      hCoord_V.2.2.2.2.2.2.1 hCoord_V.2.2.2.2.2.2.2.1 hCoord_V.2.2.2.2.2.2.2.2.1
      hCoord_V.2.2.2.2.2.2.2.2.2

  
  
  
  have h_s3 : ∃ (ρ : C_tilde ⟶ C_semi),
      AlgebraicGeometry.Surjective ρ ∧ ρ ≫ g_semi = g_tilde := by
    let IdxP : Type := {p : Fin (N + 1) × Fin q // Disjoint (e_sub p.1) (I_cov p.2)}

    
    have h_loc_map : ∀ p : IdxP,
        let a := p.1.1
        let η_a : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (U_tilde a).toScheme :=
          AlgebraicGeometry.Spec.map (φ_tilde a) ≫ (hAff_tilde a).isoSpec.inv
        ∃ (ρ_p : (U_tilde a).toScheme ⟶ C_semi),
          ρ_p ≫ g_semi = (U_tilde a).ι ≫ g_tilde ∧
          η_a ≫ ρ_p = η_semi := by
      intro p
      let a := p.1.1
      let γ := p.1.2
      have h_disj : Disjoint (e_sub a) (I_cov γ) := p.2
      obtain ⟨_, hInj_φa, hSpec_φa, hFrom_ga, hComp_βa, _, hu_a, hRange_φa⟩ := hCharts_tilde a
      obtain ⟨_, hInj_covγ, hSpec_covγ, hI_memγ, hRange_covγ⟩ := hCharts_semi γ
      have hSub_range : Set.range (φ_cov γ).hom ⊆ Set.range (φ_tilde a).hom := by
        rw [hRange_covγ]
        change (Subring.closure (Set.range vMap ∪ f '' (I_cov γ : Set (Fin L))) : Set F) ⊆
          ((φ_tilde a).hom.range : Set F)
        rw [SetLike.coe_subset_coe, Subring.closure_le]
        rintro z (⟨r, rfl⟩ | ⟨ℓ, hℓ, rfl⟩)
        · exact ⟨β_tilde a r, by rw [← RingHom.comp_apply, hComp_βa]⟩
        · have hℓ_not : ℓ ∉ e_sub a :=
            Finset.disjoint_right.mp h_disj (Finset.mem_coe.mp hℓ)
          let b_ℓ : Fin (N + 1) := e_sub.symm (insert ℓ (e_sub a))
          have hb_eq : e_sub b_ℓ = insert ℓ (e_sub a) := e_sub.apply_symm_apply _
          refine ⟨u_tilde a b_ℓ, ?_⟩
          rw [hu_a b_ℓ]
          have h_ins : g_prod b_ℓ = f ℓ * g_prod a := by
            dsimp [g_prod]
            rw [hb_eq, Finset.prod_insert hℓ_not]
          rw [h_ins, mul_div_cancel_right₀ _ (hg_ne a)]
      let e_inj := RingEquiv.ofBijective (φ_tilde a).hom.rangeRestrict
        ⟨fun x y h => hInj_φa (congrArg Subtype.val h),
         (φ_tilde a).hom.rangeRestrict_surjective⟩
      let χ_p : ↑(C_semi.presheaf.obj (Opposite.op (U_cov γ))) →+*
          ↑(C_tilde.presheaf.obj (Opposite.op (U_tilde a))) :=
        e_inj.symm.toRingHom.comp
          ((φ_cov γ).hom.codRestrict (φ_tilde a).hom.range (fun z => hSub_range ⟨z, rfl⟩))
      have hχ_comp : (φ_tilde a).hom.comp χ_p = (φ_cov γ).hom := by
        ext z
        change (φ_tilde a).hom (e_inj.symm ⟨(φ_cov γ).hom z, _⟩) = (φ_cov γ).hom z
        have h_app := e_inj.apply_symm_apply ⟨(φ_cov γ).hom z, hSub_range ⟨z, rfl⟩⟩
        exact congrArg Subtype.val h_app
      let ρ_p : (U_tilde a).toScheme ⟶ C_semi :=
        (hAff_tilde a).isoSpec.hom ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ_p) ≫
          (hAff_cov γ).fromSpec
      let α_γ : ↥V →+* ↑(C_semi.presheaf.obj (Opposite.op (U_cov γ))) :=
        (AlgebraicGeometry.Spec.preimage ((hAff_cov γ).fromSpec ≫ g_semi)).hom
      have hα_γ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_γ) =
          (hAff_cov γ).fromSpec ≫ g_semi :=
        AlgebraicGeometry.Spec.map_preimage _
      have h_cov_α : (φ_cov γ).hom.comp α_γ = vMap := by
        have h_spec : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((φ_cov γ).hom.comp α_γ)) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom vMap) := by
          calc AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((φ_cov γ).hom.comp α_γ))
              = AlgebraicGeometry.Spec.map (φ_cov γ) ≫
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_γ) :=
                AlgebraicGeometry.Spec.map_comp _ _
            _ = (AlgebraicGeometry.Spec.map (φ_cov γ) ≫ (hAff_cov γ).fromSpec) ≫ g_semi := by
                rw [hα_γ, Category.assoc]
            _ = η_semi ≫ g_semi := by rw [hSpec_covγ]
            _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom vMap) := hη_semi_comm
        exact CommRingCat.Hom.ext_iff.mp (AlgebraicGeometry.Spec.map_injective h_spec)
      have hχ_α : χ_p.comp α_γ = β_tilde a := by
        ext r
        apply hInj_φa
        calc (φ_tilde a).hom (χ_p (α_γ r))
            = ((φ_tilde a).hom.comp χ_p) (α_γ r) := rfl
          _ = (φ_cov γ).hom (α_γ r) := by rw [hχ_comp]
          _ = vMap r := by rw [← RingHom.comp_apply, h_cov_α]
          _ = (φ_tilde a).hom (β_tilde a r) := by rw [← RingHom.comp_apply, hComp_βa]
      refine ⟨ρ_p, ?_, ?_⟩
      · have h_hom_χ : CommRingCat.ofHom α_γ ≫ CommRingCat.ofHom χ_p =
            CommRingCat.ofHom (β_tilde a) :=
          CommRingCat.Hom.ext hχ_α
        have h_iso_ι : (hAff_tilde a).isoSpec.hom ≫ (hAff_tilde a).fromSpec = (U_tilde a).ι := by
          rw [← (hAff_tilde a).isoSpec_inv_ι, ← Category.assoc, Iso.hom_inv_id, Category.id_comp]
        calc ((hAff_tilde a).isoSpec.hom ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ_p) ≫
                (hAff_cov γ).fromSpec) ≫ g_semi
            = (hAff_tilde a).isoSpec.hom ≫
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ_p) ≫
                  ((hAff_cov γ).fromSpec ≫ g_semi)) := by
              simp only [Category.assoc]
          _ = (hAff_tilde a).isoSpec.hom ≫
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ_p) ≫
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_γ)) := by
              rw [← hα_γ]
          _ = (hAff_tilde a).isoSpec.hom ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom (β_tilde a)) := by
              rw [← AlgebraicGeometry.Spec.map_comp, h_hom_χ]
          _ = ((hAff_tilde a).isoSpec.hom ≫ (hAff_tilde a).fromSpec) ≫ g_tilde := by
              rw [← hFrom_ga, Category.assoc]
          _ = (U_tilde a).ι ≫ g_tilde := by rw [h_iso_ι]
      · calc (AlgebraicGeometry.Spec.map (φ_tilde a) ≫ (hAff_tilde a).isoSpec.inv) ≫
                ((hAff_tilde a).isoSpec.hom ≫
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ_p) ≫
                  (hAff_cov γ).fromSpec)
            = AlgebraicGeometry.Spec.map (φ_tilde a) ≫
                ((hAff_tilde a).isoSpec.inv ≫ (hAff_tilde a).isoSpec.hom) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ_p) ≫
                (hAff_cov γ).fromSpec := by simp only [Category.assoc]
          _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ_p ≫ φ_tilde a)) ≫
                (hAff_cov γ).fromSpec := by
              rw [Iso.inv_hom_id, Category.id_comp, ← Category.assoc,
                ← AlgebraicGeometry.Spec.map_comp]
          _ = AlgebraicGeometry.Spec.map (φ_cov γ) ≫ (hAff_cov γ).fromSpec := by
              have h_eq : CommRingCat.ofHom χ_p ≫ φ_tilde a = φ_cov γ :=
                CommRingCat.Hom.ext hχ_comp
              rw [h_eq]
          _ = η_semi := hSpec_covγ

    choose ρ_p hρ_base hρ_η using h_loc_map

    
    let U_P (p : IdxP) : C_tilde.Opens := U_tilde p.1.1
    have hTop_P : (⨆ p : IdxP, U_P p) = ⊤ := by
      rw [eq_top_iff]
      intro x _
      rw [TopologicalSpace.Opens.mem_iSup]
      have hx_top : x ∈ (⊤ : C_tilde.Opens) := trivial
      rw [← hTop_tilde, TopologicalSpace.Opens.mem_iSup] at hx_top
      obtain ⟨a₀, hx_a₀⟩ := hx_top
      obtain ⟨_, hInj_a₀, _, _, hComp_βa₀, hbo_a₀, hu_a₀, _⟩ := hCharts_tilde a₀
      let A₀ := ↑(C_tilde.presheaf.obj (Opposite.op (U_tilde a₀)))
      let q_x : ↥(AlgebraicGeometry.Spec (CommRingCat.of A₀)) :=
        (hAff_tilde a₀).isoSpec.hom.base ⟨x, hx_a₀⟩
      have hqx_from : (hAff_tilde a₀).fromSpec.base q_x = x := by
        have h1 := congrArg (fun h => h.base q_x) (hAff_tilde a₀).isoSpec_inv_ι
        have h2 := congrArg (fun h => h.base ⟨x, hx_a₀⟩) (hAff_tilde a₀).isoSpec.hom_inv_id
        exact h1.symm.trans (congrArg (U_tilde a₀).ι.base h2)
      let P_x : Ideal A₀ := q_x.asIdeal
      have _ : P_x.IsPrime := q_x.isPrime
      have hUnits_Px : ∀ y : P_x.primeCompl, IsUnit ((φ_tilde a₀).hom y.1) := by
        intro y
        have hy_ne : y.1 ≠ 0 := fun h0 => y.2 (by rw [h0]; exact P_x.zero_mem)
        exact isUnit_iff_ne_zero.mpr (fun h0 =>
          hy_ne (hInj_a₀ (h0.trans (map_zero (φ_tilde a₀).hom).symm)))
      let ψ_loc : Localization.AtPrime P_x →+* F :=
        IsLocalization.lift (M := P_x.primeCompl) (S := Localization.AtPrime P_x) hUnits_Px
      have hψ_loc_comp : ψ_loc.comp (algebraMap A₀ (Localization.AtPrime P_x)) =
          (φ_tilde a₀).hom :=
        IsLocalization.lift_comp hUnits_Px
      obtain ⟨W, hW_mem, hLocHom_ω⟩ := IsLocalRing.exists_factor_valuationRing ψ_loc
      let ω_loc : Localization.AtPrime P_x →+* ↥W := ψ_loc.codRestrict W.toSubring hW_mem
      have _ : IsLocalHom ω_loc := hLocHom_ω
      have hvW : ∀ r : ↥V, vMap r ∈ W := by
        intro r
        have hr : vMap r = ψ_loc (algebraMap A₀ (Localization.AtPrime P_x) (β_tilde a₀ r)) := by
          rw [← RingHom.comp_apply, hψ_loc_comp, ← RingHom.comp_apply, hComp_βa₀]
        rw [hr]
        exact hW_mem _
      let j_VW : ↥V →+* ↥W := vMap.codRestrict W.toSubring hvW
      have hj_VW : W.subtype.comp j_VW = vMap := by ext r; rfl
      have _ : AlgebraicGeometry.IsProper g_semi := hProp
      have h_sq_W : η_semi ≫ g_semi =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥W F)) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom j_VW) := by
        rw [hη_semi_comm, ← AlgebraicGeometry.Spec.map_comp]
        congr 1
      obtain ⟨ψ_W, hψW_left, _⟩ := h_val_lift g_semi η_semi
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom j_VW)) h_sq_W
      let m_W : PrimeSpectrum ↥W := ⟨IsLocalRing.maximalIdeal ↥W, inferInstance⟩
      have hmW_univ : ψ_W.base m_W ∈ (⋃ γ : Fin q, (U_cov γ : Set ↥C_semi)) := by
        rw [hCov]; trivial
      obtain ⟨γ, hmW_γ⟩ := Set.mem_iUnion.mp hmW_univ
      have hRange_ψW : Set.range ψ_W.base ⊆ Set.range (hAff_cov γ).fromSpec.base := by
        rw [(hAff_cov γ).range_fromSpec]
        rintro _ ⟨q_W, rfl⟩
        have h_le : q_W.asIdeal ≤ m_W.asIdeal :=
          IsLocalRing.le_maximalIdeal q_W.isPrime.ne_top
        have h_spec_W : (q_W : ↥(AlgebraicGeometry.Spec (CommRingCat.of ↥W))) ⤳ m_W :=
          (@PrimeSpectrum.le_iff_specializes ↥W _ q_W m_W).mp h_le
        exact (h_spec_W.map ψ_W.continuous).mem_open (U_cov γ).isOpen hmW_γ
      let e_W := AlgebraicGeometry.IsOpenImmersion.lift (hAff_cov γ).fromSpec ψ_W hRange_ψW
      let θ_W := AlgebraicGeometry.Spec.preimage e_W
      have hθW_eq : (φ_cov γ).hom = W.subtype.comp θ_W.hom := by
        obtain ⟨_, _, hSpec_covγ, _, _⟩ := hCharts_semi γ
        have h_spec_eq :
            AlgebraicGeometry.Spec.map (φ_cov γ) ≫ (hAff_cov γ).fromSpec =
            AlgebraicGeometry.Spec.map (θ_W ≫ CommRingCat.ofHom W.subtype) ≫
              (hAff_cov γ).fromSpec := by
          rw [hSpec_covγ, AlgebraicGeometry.Spec.map_comp, Category.assoc,
            AlgebraicGeometry.Spec.map_preimage, AlgebraicGeometry.IsOpenImmersion.lift_fac]
          exact hψW_left.symm
        have h_hom := AlgebraicGeometry.Spec.map_injective
          ((cancel_mono (hAff_cov γ).fromSpec).mp h_spec_eq)
        exact CommRingCat.Hom.ext_iff.mp h_hom
      have hRange_cov_W : Set.range (φ_cov γ).hom ⊆ (W : Set F) := by
        rintro _ ⟨b, rfl⟩
        rw [hθW_eq]
        exact (θ_W.hom b).2

      
      let S_W : Finset (Fin L) := Finset.univ.filter (fun ℓ : Fin L => f ℓ ∉ W)
      let a_W : Fin (N + 1) := e_sub.symm S_W
      have ha_W_eq : e_sub a_W = S_W := e_sub.apply_symm_apply S_W
      have h_disj_W : Disjoint (e_sub a_W) (I_cov γ) := by
        rw [ha_W_eq, Finset.disjoint_left]
        intro ℓ hℓ_SW hℓ_I
        have hf_not : f ℓ ∉ W := (Finset.mem_filter.mp hℓ_SW).2
        have hf_mem_range : f ℓ ∈ Set.range (φ_cov γ).hom :=
          (hCharts_semi γ).2.2.2.1 ℓ hℓ_I
        exact hf_not (hRange_cov_W hf_mem_range)
      let p_W : IdxP := ⟨(a_W, γ), h_disj_W⟩
      refine ⟨p_W, ?_⟩
      
      let u₀ : A₀ := u_tilde a₀ a_W
      have hu₀_val : (φ_tilde a₀).hom u₀ = g_prod a_W / g_prod a₀ := hu_a₀ a_W
      have h_inv_W : g_prod a₀ / g_prod a_W ∈ W := by
        dsimp [g_prod]
        rw [h_finset_ratio f hf_ne (e_sub a_W) (e_sub a₀), ha_W_eq]
        refine W.toSubring.mul_mem ?_ ?_
        · refine W.toSubring.prod_mem (fun ℓ hℓ => ?_)
          have hℓ_not : ℓ ∉ S_W := (Finset.mem_sdiff.mp hℓ).2
          by_contra hf_not
          exact hℓ_not (Finset.mem_filter.mpr ⟨Finset.mem_univ ℓ, hf_not⟩)
        · refine W.toSubring.prod_mem (fun ℓ hℓ => ?_)
          have hℓ_in : ℓ ∈ S_W := (Finset.mem_sdiff.mp hℓ).1
          have hf_not : f ℓ ∉ W := (Finset.mem_filter.mp hℓ_in).2
          exact (ValuationSubring.mem_or_inv_mem W (f ℓ)).resolve_left hf_not
      let w_u₀ : ↥W := ω_loc (algebraMap A₀ (Localization.AtPrime P_x) u₀)
      let w_inv : ↥W := ⟨g_prod a₀ / g_prod a_W, h_inv_W⟩
      have hw_mul : w_u₀ * w_inv = 1 := by
        apply Subtype.ext
        change ψ_loc (algebraMap A₀ (Localization.AtPrime P_x) u₀) *
          (g_prod a₀ / g_prod a_W) = 1
        rw [← RingHom.comp_apply, hψ_loc_comp, hu₀_val,
          div_mul_div_cancel₀ (hg_ne a₀), div_self (hg_ne a_W)]
      have hw_unit : IsUnit w_u₀ :=
        ⟨⟨w_u₀, w_inv, hw_mul, mul_comm w_inv w_u₀ ▸ hw_mul⟩, rfl⟩
      have hloc_unit : IsUnit (algebraMap A₀ (Localization.AtPrime P_x) u₀) :=
        isUnit_of_map_unit ω_loc _ hw_unit
      have hu₀_not_Px : u₀ ∉ P_x :=
        (IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime P_x) P_x u₀).mp
          hloc_unit
      have hqx_bo : q_x ∈ PrimeSpectrum.basicOpen u₀ := hu₀_not_Px
      have hqx_pre : q_x ∈ (TopologicalSpace.Opens.map (hAff_tilde a₀).fromSpec.base).obj
          (C_tilde.basicOpen u₀) := by
        rwa [(hAff_tilde a₀).fromSpec_preimage_basicOpen u₀]
      have hx_bo : x ∈ C_tilde.basicOpen u₀ := by
        rw [← hqx_from]
        exact hqx_pre
      rw [hbo_a₀ a_W] at hx_bo
      exact hx_bo.2

    
    have _ : AlgebraicGeometry.IsIntegral C_tilde := hInt_tilde
    have _ : AlgebraicGeometry.IsProper g_semi := hProp
    have _ : AlgebraicGeometry.IsProper g_tilde := hProp_tilde
    have _ : AlgebraicGeometry.IsDominant η_tilde := hDom_tilde
    have h_overlap : ∀ p₁ p₂ : IdxP,
        C_tilde.homOfLE (inf_le_left : U_P p₁ ⊓ U_P p₂ ≤ U_P p₁) ≫ ρ_p p₁ =
        C_tilde.homOfLE (inf_le_right : U_P p₁ ⊓ U_P p₂ ≤ U_P p₂) ≫ ρ_p p₂ := by
      intro p₁ p₂
      let W₁₂ : C_tilde.Opens := U_P p₁ ⊓ U_P p₂
      let f₁ : W₁₂.toScheme ⟶ C_semi := C_tilde.homOfLE inf_le_left ≫ ρ_p p₁
      let f₂ : W₁₂.toScheme ⟶ C_semi := C_tilde.homOfLE inf_le_right ≫ ρ_p p₂
      have _ : AlgebraicGeometry.IsReduced W₁₂.toScheme :=
        AlgebraicGeometry.isReduced_of_isOpenImmersion W₁₂.ι
      have hRange_η₁₂ : Set.range η_tilde.base ⊆ Set.range W₁₂.ι.base := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        rintro _ ⟨pt, rfl⟩
        exact ⟨(hCharts_tilde p₁.1.1).1 pt, (hCharts_tilde p₂.1.1).1 pt⟩
      let η₁₂ : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ W₁₂.toScheme :=
        AlgebraicGeometry.IsOpenImmersion.lift W₁₂.ι η_tilde hRange_η₁₂
      have hη₁₂_ι : η₁₂ ≫ W₁₂.ι = η_tilde :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ _
      have _ : AlgebraicGeometry.IsDominant η₁₂ := by
        rw [AlgebraicGeometry.isDominant_iff, denseRange_iff_closure_range]
        ext y
        simp only [Set.mem_univ, iff_true, mem_closure_iff]
        intro O hO hyO
        have hO_img_open : IsOpen (W₁₂.ι.base '' O) :=
          W₁₂.ι.isOpenEmbedding.isOpenMap O hO
        have h_dense := mem_closure_iff.mp
          (by rw [hDom_tilde.denseRange.closure_eq]; trivial :
            W₁₂.ι.base y ∈ closure (Set.range η_tilde.base))
          (W₁₂.ι.base '' O) hO_img_open ⟨y, hyO, rfl⟩
        obtain ⟨_, ⟨y', hy'O, hy'_eq⟩, pt, hpt_eq⟩ := h_dense
        have hy'_η : W₁₂.ι.base y' = W₁₂.ι.base (η₁₂.base pt) := by
          rw [hy'_eq, ← hpt_eq, ← hη₁₂_ι]; rfl
        have hy_eq : y' = η₁₂.base pt := W₁₂.ι.isOpenEmbedding.injective hy'_η
        exact ⟨y', hy'O, pt, hy_eq.symm⟩
      have hf_base : f₁ ≫ g_semi = f₂ ≫ g_semi := by
        have h1 : f₁ ≫ g_semi = W₁₂.ι ≫ g_tilde := by
          dsimp [f₁]
          rw [Category.assoc, hρ_base p₁, ← Category.assoc,
            AlgebraicGeometry.Scheme.homOfLE_ι]
        have h2 : f₂ ≫ g_semi = W₁₂.ι ≫ g_tilde := by
          dsimp [f₂]
          rw [Category.assoc, hρ_base p₂, ← Category.assoc,
            AlgebraicGeometry.Scheme.homOfLE_ι]
        rw [h1, h2]
      have hf_η : η₁₂ ≫ f₁ = η₁₂ ≫ f₂ := by
        have h_η_left : ∀ (p : IdxP) (hle : W₁₂ ≤ U_P p),
            (η₁₂ ≫ C_tilde.homOfLE hle) ≫ ρ_p p = η_semi := by
          intro p hle
          let η_a := AlgebraicGeometry.Spec.map (φ_tilde p.1.1) ≫
            (hAff_tilde p.1.1).isoSpec.inv
          have h_eq_ηa : η₁₂ ≫ C_tilde.homOfLE hle = η_a := by
            apply (cancel_mono (U_P p).ι).mp
            calc (η₁₂ ≫ C_tilde.homOfLE hle) ≫ (U_P p).ι
                = η₁₂ ≫ (C_tilde.homOfLE hle ≫ (U_P p).ι) := Category.assoc _ _ _
              _ = η₁₂ ≫ W₁₂.ι := by rw [AlgebraicGeometry.Scheme.homOfLE_ι]
              _ = η_tilde := hη₁₂_ι
              _ = AlgebraicGeometry.Spec.map (φ_tilde p.1.1) ≫ (hAff_tilde p.1.1).fromSpec :=
                  (hCharts_tilde p.1.1).2.2.1.symm
              _ = η_a ≫ (U_P p).ι := by
                  rw [← (hAff_tilde p.1.1).isoSpec_inv_ι, Category.assoc]
          rw [h_eq_ηa, hρ_η p]
        calc η₁₂ ≫ f₁
            = (η₁₂ ≫ C_tilde.homOfLE inf_le_left) ≫ ρ_p p₁ := (Category.assoc _ _ _).symm
          _ = η_semi := h_η_left p₁ inf_le_left
          _ = (η₁₂ ≫ C_tilde.homOfLE inf_le_right) ≫ ρ_p p₂ := (h_η_left p₂ inf_le_right).symm
          _ = η₁₂ ≫ f₂ := Category.assoc _ _ _
      exact AlgebraicGeometry.ext_of_isDominant_of_isSeparated g_semi hf_base η₁₂ hf_η

    let 𝒰 := C_tilde.openCoverOfIsOpenCover U_P hTop_P
    have h_glue_pb : ∀ p₁ p₂ : 𝒰.I₀,
        CategoryTheory.Limits.pullback.fst (𝒰.f p₁) (𝒰.f p₂) ≫ ρ_p p₁ =
        CategoryTheory.Limits.pullback.snd (𝒰.f p₁) (𝒰.f p₂) ≫ ρ_p p₂ := by
      intro p₁ p₂
      have hpb := AlgebraicGeometry.isPullback_opens_inf (U_P p₁) (U_P p₂)
      refine (cancel_epi hpb.isoPullback.hom).mp ?_
      change hpb.isoPullback.hom ≫ CategoryTheory.Limits.pullback.fst (U_P p₁).ι (U_P p₂).ι ≫
          ρ_p p₁ =
        hpb.isoPullback.hom ≫ CategoryTheory.Limits.pullback.snd (U_P p₁).ι (U_P p₂).ι ≫
          ρ_p p₂
      rw [← Category.assoc, hpb.isoPullback_hom_fst, ← Category.assoc, hpb.isoPullback_hom_snd]
      exact h_overlap p₁ p₂
    let ρ : C_tilde ⟶ C_semi := 𝒰.glueMorphisms ρ_p h_glue_pb
    have hρ_ι : ∀ p : IdxP, (U_P p).ι ≫ ρ = ρ_p p :=
      fun p => 𝒰.ι_glueMorphisms ρ_p h_glue_pb p
    have hρ_comm : ρ ≫ g_semi = g_tilde := by
      refine 𝒰.hom_ext (ρ ≫ g_semi) g_tilde (fun p => ?_)
      change (U_P p).ι ≫ ρ ≫ g_semi = (U_P p).ι ≫ g_tilde
      rw [← Category.assoc, hρ_ι p, hρ_base p]
    have hIrred_tilde : IrreducibleSpace ↥C_tilde :=
      @AlgebraicGeometry.irreducibleSpace_of_isIntegral C_tilde hInt_tilde
    obtain ⟨x₀⟩ := hIrred_tilde.toNonempty
    have hx₀_top : x₀ ∈ (⊤ : C_tilde.Opens) := trivial
    rw [← hTop_P, TopologicalSpace.Opens.mem_iSup] at hx₀_top
    obtain ⟨p₀, _⟩ := hx₀_top
    have hη_ρ : η_tilde ≫ ρ = η_semi := by
      let η_a₀ := AlgebraicGeometry.Spec.map (φ_tilde p₀.1.1) ≫
        (hAff_tilde p₀.1.1).isoSpec.inv
      have hη_fac : η_a₀ ≫ (U_P p₀).ι = η_tilde := by
        calc AlgebraicGeometry.Spec.map (φ_tilde p₀.1.1) ≫
              ((hAff_tilde p₀.1.1).isoSpec.inv ≫ (U_P p₀).ι)
            = AlgebraicGeometry.Spec.map (φ_tilde p₀.1.1) ≫ (hAff_tilde p₀.1.1).fromSpec := by
              rw [(hAff_tilde p₀.1.1).isoSpec_inv_ι]
          _ = η_tilde := (hCharts_tilde p₀.1.1).2.2.1
      rw [← hη_fac, Category.assoc, hρ_ι p₀, hρ_η p₀]
    have _ : AlgebraicGeometry.IsDominant ρ := by
      rw [AlgebraicGeometry.isDominant_iff]
      have h_dense : DenseRange (ρ.base ∘ η_tilde.base) := by
        have h_comp_base : (η_tilde ≫ ρ).base = ρ.base ∘ η_tilde.base := rfl
        rw [← h_comp_base, hη_ρ]
        exact hDom_semi.denseRange
      exact Dense.mono (Set.range_comp_subset_range _ _) h_dense
    have _ : AlgebraicGeometry.IsProper (ρ ≫ g_semi) := by
      rwa [hρ_comm]
    have _ : AlgebraicGeometry.IsProper ρ :=
      AlgebraicGeometry.IsProper.of_comp ρ g_semi
    have hSurj_ρ : AlgebraicGeometry.Surjective ρ :=
      AlgebraicGeometry.Surjective.of_universallyClosed_of_isDominant ρ
    exact ⟨ρ, hSurj_ρ, hρ_comm⟩

  obtain ⟨ρ, hSurj_ρ, hρ_comm⟩ := h_s3

  
  
  
  have h_s4 : ∃ (τ_tilde : AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C_tilde),
      τ_tilde ≫ g_tilde = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of ↥V)) := by
    have hn3 : 3 ≤ n := hStabCK.1
    let σ₀ : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K := σ_K ⟨0, by omega⟩
    have hσ₀ : σ₀ ≫ p_K = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of K)) :=
      hStabCK.2.2.2.2.2.1 ⟨0, by omega⟩
    have h_bot_K : ∀ (I : Ideal K), I.IsPrime → I = ⊥ := by
      intro I hI
      ext x
      rw [Submodule.mem_bot]
      constructor
      · intro hx
        by_contra hx0
        exact hI.ne_top (Ideal.eq_top_of_isUnit_mem I hx (isUnit_iff_ne_zero.mpr hx0))
      · rintro rfl; exact I.zero_mem
    obtain ⟨pt_K⟩ :=
      (inferInstance : IrreducibleSpace ↥(AlgebraicGeometry.Spec (CommRingCat.of K))).toNonempty
    let z₀ : ↥C_K := σ₀.base pt_K
    let IsRegAtZ₀ (h : F) : Prop :=
      ∃ (W : C_K.Opens) (hW : AlgebraicGeometry.IsAffineOpen W)
        (φ : C_K.presheaf.obj (Opposite.op W) ⟶ CommRingCat.of F),
        z₀ ∈ W ∧
        AlgebraicGeometry.Spec.map φ ≫ hW.fromSpec = η_F ∧
        h ∈ Set.range φ.hom
    let S₀ : Finset (Fin L) := Finset.univ.filter (fun ℓ : Fin L => ¬ IsRegAtZ₀ (f ℓ))
    let a_z₀ : Fin (N + 1) := e_sub.symm S₀
    have ha_z₀_eq : e_sub a_z₀ = S₀ := e_sub.apply_symm_apply S₀
    let G₀ : Finset F :=
      (Finset.univ \ S₀).image f ∪ S₀.image (fun ℓ : Fin L => (f ℓ)⁻¹)
    have hG₀_reg : ∀ h ∈ G₀, IsRegAtZ₀ h := by
      intro h hh
      rcases Finset.mem_union.mp hh with hh_reg | hh_pole
      · obtain ⟨ℓ, hℓ, rfl⟩ := Finset.mem_image.mp hh_reg
        have hℓ_not : ℓ ∉ S₀ := (Finset.mem_sdiff.mp hℓ).2
        by_contra hnot
        exact hℓ_not (Finset.mem_filter.mpr ⟨Finset.mem_univ ℓ, hnot⟩)
      · obtain ⟨ℓ, hℓ, rfl⟩ := Finset.mem_image.mp hh_pole
        have hnot_reg : ¬ IsRegAtZ₀ (f ℓ) := (Finset.mem_filter.mp hℓ).2
        obtain ⟨W, hW, φ, hz₀W, _, hηW, hOr⟩ := hSmPoles.1 (f ℓ) z₀
        rcases hOr with hf_in | hinv_in
        · exact False.elim (hnot_reg ⟨W, hW, φ, hz₀W, hηW, hf_in⟩)
        · exact ⟨W, hW, φ, hz₀W, hηW, hinv_in⟩
    obtain ⟨V_K, hVK, φ_K, hz₀VK, hFracVK, hηVK, _⟩ := hSmPoles.1 (1 : F) z₀
    have hVK_ne : Nonempty ↥V_K.toScheme := ⟨⟨z₀, hz₀VK⟩⟩
    obtain ⟨hOpen_ιBK, hRange_ιBK⟩ :=
      hSmPoles.2 V_K hVK φ_K G₀ hVK_ne hFracVK hηVK
    let B_K : Subring F := Subring.closure (Set.range φ_K.hom ∪ (G₀ : Set F))
    let ψ_BK : C_K.presheaf.obj (Opposite.op V_K) ⟶ CommRingCat.of ↥B_K :=
      CommRingCat.ofHom (RingHom.codRestrict φ_K.hom B_K (fun a =>
        Subring.subset_closure (Or.inl ⟨a, rfl⟩)))
    let ι_BK : AlgebraicGeometry.Spec (CommRingCat.of ↥B_K) ⟶ V_K.toScheme :=
      AlgebraicGeometry.Spec.map ψ_BK ≫ hVK.isoSpec.inv
    have _ : AlgebraicGeometry.IsOpenImmersion ι_BK := hOpen_ιBK
    let j_BK : AlgebraicGeometry.Spec (CommRingCat.of ↥B_K) ⟶ C_K := ι_BK ≫ V_K.ι
    have hj_BK_eq : j_BK = AlgebraicGeometry.Spec.map ψ_BK ≫ hVK.fromSpec := by
      dsimp [j_BK, ι_BK]
      rw [Category.assoc, hVK.isoSpec_inv_ι]
    have hz₀_in_BK : (⟨z₀, hz₀VK⟩ : ↥V_K.toScheme) ∈ Set.range ι_BK.base := by
      rw [hRange_ιBK]
      intro h hh
      exact hG₀_reg h hh
    obtain ⟨q₀_BK, hq₀_BK⟩ := hz₀_in_BK
    have hRange_σ₀ : Set.range σ₀.base ⊆ Set.range j_BK.base := by
      rintro _ ⟨q, rfl⟩
      have hq : q = pt_K := PrimeSpectrum.ext
        ((h_bot_K q.asIdeal q.isPrime).trans (h_bot_K pt_K.asIdeal pt_K.isPrime).symm)
      rw [hq]
      refine ⟨q₀_BK, ?_⟩
      change V_K.ι.base (ι_BK.base q₀_BK) = z₀
      rw [hq₀_BK]; rfl
    let s_BK : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of ↥B_K) :=
      AlgebraicGeometry.IsOpenImmersion.lift j_BK σ₀ hRange_σ₀
    have hs_BK : s_BK ≫ j_BK = σ₀ :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ _

    
    let κ_VK : K →+* ↑(C_K.presheaf.obj (Opposite.op V_K)) :=
      (AlgebraicGeometry.Spec.preimage (hVK.fromSpec ≫ p_K)).hom
    have hκ_VK : AlgebraicGeometry.Spec.map (CommRingCat.ofHom κ_VK) = hVK.fromSpec ≫ p_K :=
      AlgebraicGeometry.Spec.map_preimage _
    have hφK_κ : φ_K.hom.comp κ_VK = algebraMap K F := by
      have h_spec : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_K.hom.comp κ_VK)) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K F)) := by
        calc AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_K.hom.comp κ_VK))
            = AlgebraicGeometry.Spec.map φ_K ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom κ_VK) :=
              AlgebraicGeometry.Spec.map_comp _ _
          _ = (AlgebraicGeometry.Spec.map φ_K ≫ hVK.fromSpec) ≫ p_K := by
              rw [hκ_VK, Category.assoc]
          _ = η_F ≫ p_K := by rw [hηVK]
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K F)) := hηF_comm
      exact CommRingCat.Hom.ext_iff.mp (AlgebraicGeometry.Spec.map_injective h_spec)

    obtain ⟨_, _, _, hFrom_gz₀, hComp_βz₀, _, _, hRange_φz₀⟩ := hCharts_tilde a_z₀
    have hSub_BK : Set.range (φ_tilde a_z₀).hom ⊆ (B_K : Set F) := by
      rw [hRange_φz₀, SetLike.coe_subset_coe, Subring.closure_le]
      rintro z (⟨r, rfl⟩ | ⟨b, rfl⟩)
      · refine Subring.subset_closure (Or.inl ⟨κ_VK (V.subtype r), ?_⟩)
        change (φ_K.hom.comp κ_VK) (V.subtype r) = (algebraMap K F) (V.subtype r)
        rw [hφK_κ]
      · dsimp [g_prod]
        rw [h_finset_ratio f hf_ne (e_sub a_z₀) (e_sub b), ha_z₀_eq]
        refine B_K.mul_mem ?_ ?_
        · refine B_K.prod_mem (fun ℓ hℓ => Subring.subset_closure (Or.inr ?_))
          have hℓ_not : ℓ ∉ S₀ := (Finset.mem_sdiff.mp hℓ).2
          exact Finset.mem_coe.mpr (Finset.mem_union_left _
            (Finset.mem_image_of_mem f (Finset.mem_sdiff.mpr ⟨Finset.mem_univ ℓ, hℓ_not⟩)))
        · refine B_K.prod_mem (fun ℓ hℓ => Subring.subset_closure (Or.inr ?_))
          have hℓ_in : ℓ ∈ S₀ := (Finset.mem_sdiff.mp hℓ).1
          exact Finset.mem_coe.mpr (Finset.mem_union_right _
            (Finset.mem_image_of_mem _ hℓ_in))
    let δ₀ : ↑(C_tilde.presheaf.obj (Opposite.op (U_tilde a_z₀))) →+* ↥B_K :=
      (φ_tilde a_z₀).hom.codRestrict B_K (fun z => hSub_BK ⟨z, rfl⟩)
    let σ_tilde₀ : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_tilde :=
      s_BK ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom δ₀) ≫ (hAff_tilde a_z₀).fromSpec
    let θ_K : ↥B_K →+* K := (AlgebraicGeometry.Spec.preimage s_BK).hom
    have hθ_K : AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ_K) = s_BK :=
      AlgebraicGeometry.Spec.map_preimage _
    have hθK_κ : (θ_K.comp ψ_BK.hom).comp κ_VK = RingHom.id K := by
      have h_hom_comp : CommRingCat.ofHom ((θ_K.comp ψ_BK.hom).comp κ_VK) =
          CommRingCat.ofHom κ_VK ≫ ψ_BK ≫ CommRingCat.ofHom θ_K := rfl
      have h_spec : AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((θ_K.comp ψ_BK.hom).comp κ_VK)) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (RingHom.id K)) := by
        calc AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((θ_K.comp ψ_BK.hom).comp κ_VK))
            = AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ_K) ≫
                AlgebraicGeometry.Spec.map ψ_BK ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom κ_VK) := by
              rw [h_hom_comp, AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp,
                Category.assoc]
          _ = s_BK ≫ ((AlgebraicGeometry.Spec.map ψ_BK ≫ hVK.fromSpec) ≫ p_K) := by
              rw [hθ_K, hκ_VK, Category.assoc]
          _ = (s_BK ≫ j_BK) ≫ p_K := by
              rw [← hj_BK_eq]; simp only [Category.assoc]
          _ = σ₀ ≫ p_K := by rw [hs_BK]
          _ = 𝟙 _ := hσ₀
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (RingHom.id K)) :=
              (AlgebraicGeometry.Spec.map_id _).symm
      exact CommRingCat.Hom.ext_iff.mp (AlgebraicGeometry.Spec.map_injective h_spec)
    have hδ₀_β : ∀ r : ↥V, δ₀ (β_tilde a_z₀ r) = ψ_BK.hom (κ_VK (V.subtype r)) := by
      intro r
      apply Subtype.ext
      calc (φ_tilde a_z₀).hom (β_tilde a_z₀ r)
          = ((φ_tilde a_z₀).hom.comp (β_tilde a_z₀)) r := rfl
        _ = vMap r := by rw [hComp_βz₀]
        _ = (algebraMap K F) (V.subtype r) := rfl
        _ = (φ_K.hom.comp κ_VK) (V.subtype r) := by rw [hφK_κ]
        _ = φ_K.hom (κ_VK (V.subtype r)) := rfl
    have hθ_δ_β : (θ_K.comp δ₀).comp (β_tilde a_z₀) = V.subtype := by
      ext r
      calc θ_K (δ₀ (β_tilde a_z₀ r))
          = θ_K (ψ_BK.hom (κ_VK (V.subtype r))) := by rw [hδ₀_β r]
        _ = ((θ_K.comp ψ_BK.hom).comp κ_VK) (V.subtype r) := rfl
        _ = V.subtype r := by rw [hθK_κ]; rfl
    have hσ_tilde₀_comm : σ_tilde₀ ≫ g_tilde =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V K)) ≫
          𝟙 (AlgebraicGeometry.Spec (CommRingCat.of ↥V)) := by
      have h_hom_3 : CommRingCat.ofHom (β_tilde a_z₀) ≫ CommRingCat.ofHom δ₀ ≫
          CommRingCat.ofHom θ_K =
          CommRingCat.ofHom ((θ_K.comp δ₀).comp (β_tilde a_z₀)) := rfl
      rw [Category.comp_id]
      calc (s_BK ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom δ₀) ≫
              (hAff_tilde a_z₀).fromSpec) ≫ g_tilde
          = AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ_K) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom δ₀) ≫
              ((hAff_tilde a_z₀).fromSpec ≫ g_tilde) := by
            rw [← hθ_K]; simp only [Category.assoc]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ_K) ≫
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom δ₀) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom (β_tilde a_z₀))) := by
            rw [hFrom_gz₀]
        _ = AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom ((θ_K.comp δ₀).comp (β_tilde a_z₀))) := by
            rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
              Category.assoc, h_hom_3]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V K)) := by
            rw [hθ_δ_β]; rfl
    have _ : AlgebraicGeometry.IsProper g_tilde := hProp_tilde
    obtain ⟨τ_tilde, _, hτ_tilde⟩ :=
      h_val_lift g_tilde σ_tilde₀ (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of ↥V))) hσ_tilde₀_comm
    exact ⟨τ_tilde, hτ_tilde⟩

  obtain ⟨τ_tilde, hτ_tilde⟩ := h_s4
  exact ⟨N, C_tilde, g_tilde, τ_tilde, ιP_tilde, ρ, η_tilde,
    hInt_tilde, hFlat_tilde, hProp_tilde, hτ_tilde, hCl_tilde, hComm_tilde,
    hSurj_ρ, hρ_comm, hDom_tilde, hη_tilde_comm⟩

theorem weil_projective_valuation_curve_fiber_krullDim_le_one (K : Type u) [Field K]
    (V : ValuationSubring K)
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (hIntCK : AlgebraicGeometry.IsIntegral C_K)
    (hSmCK : AlgebraicGeometry.SmoothOfRelativeDimension 1 p_K)
    (F : Type u) [Field F] [Algebra K F]
    (η_F : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ C_K)
    (hηF_comm : η_F ≫ p_K = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K F)))
    (hFuncF : IsSchemeFunctionField C_K F η_F)
    (hAff_proj : ∀ (R : Type u) [CommRing R] (N : ℕ) (a : Fin (N + 1)),
      AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen R N a))
    (c_proj : ∀ (R : Type u) [CommRing R] (N : ℕ) (a : Fin (N + 1)),
      R →+* ↑((weilProjectiveSpaceOver R N).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen R N a))))
    (t_proj : ∀ (R : Type u) [CommRing R] (N : ℕ) (a : Fin (N + 1)), Fin (N + 1) →
      ↑((weilProjectiveSpaceOver R N).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen R N a))))
    (hCoord_proj : ∀ (R : Type u) [CommRing R] (N : ℕ),
      IsCommRingProjCoordSystem R N (hAff_proj R N) (c_proj R N) (t_proj R N))
    (N : ℕ)
    (Y : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsIntegral Y]
    (g : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (ιP : Y ⟶ (weilProjectiveSpaceOver ↥V N).left) [AlgebraicGeometry.IsClosedImmersion ιP]
    (hComm : ιP ≫ (weilProjectiveSpaceOver ↥V N).hom = g)
    (η_Y : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ Y) [AlgebraicGeometry.IsDominant η_Y]
    (hηY_comm : η_Y ≫ g =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((algebraMap K F).comp V.subtype)))
    (Q : Ideal ↥V) [Q.IsPrime] :
    topologicalKrullDim
      ↥(CategoryTheory.Limits.pullback g
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V Q.ResidueField)))) ≤
      (1 : WithBot ℕ∞) :=
by
  
  have hTr : Algebra.trdeg K F ≤ 1 := by
    have hIrredCK : IrreducibleSpace ↥C_K :=
      @AlgebraicGeometry.irreducibleSpace_of_isIntegral C_K hIntCK
    obtain ⟨x₀⟩ := hIrredCK.toNonempty
    obtain ⟨U_base, hU_base, W, hW, hx₀, e_W, hStd⟩ :=
      (AlgebraicGeometry.smoothOfRelativeDimension_iff 1 p_K).mp hSmCK x₀
    have hW_ne : Nonempty ↥W := ⟨⟨x₀, hx₀⟩⟩
    let Γ_cat : CommRingCat.{u} :=
      (AlgebraicGeometry.Spec (CommRingCat.of K)).presheaf.obj (Opposite.op U_base)
    have hSurj_U : AlgebraicGeometry.Surjective hU_base.fromSpec := by
      refine ⟨fun y => ?_⟩
      have hy_eq : y = p_K.base x₀ :=
        Subsingleton.elim (α := PrimeSpectrum K) y (p_K.base x₀)
      rw [hy_eq, ← Set.mem_range, hU_base.range_fromSpec]
      exact e_W hx₀
    have : AlgebraicGeometry.IsOpenImmersion hU_base.fromSpec := hU_base.isOpenImmersion_fromSpec
    have : CategoryTheory.IsIso hU_base.fromSpec := by
      change CategoryTheory.MorphismProperty.isomorphisms AlgebraicGeometry.Scheme hU_base.fromSpec
      rw [AlgebraicGeometry.isomorphisms_eq_isOpenImmersion_inf_surjective]
      exact ⟨inferInstance, hSurj_U⟩
    let k_to_Γ_cat : CommRingCat.of K ⟶ Γ_cat :=
      AlgebraicGeometry.Spec.preimage hU_base.fromSpec
    let Γ_to_k_cat : Γ_cat ⟶ CommRingCat.of K :=
      AlgebraicGeometry.Spec.preimage (inv hU_base.fromSpec)
    have hkΓ : k_to_Γ_cat ≫ Γ_to_k_cat = 𝟙 (CommRingCat.of K) := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        AlgebraicGeometry.Spec.map_preimage, CategoryTheory.IsIso.inv_hom_id,
        AlgebraicGeometry.Spec.map_id]
    have hΓk : Γ_to_k_cat ≫ k_to_Γ_cat = 𝟙 Γ_cat := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        AlgebraicGeometry.Spec.map_preimage, CategoryTheory.IsIso.hom_inv_id,
        AlgebraicGeometry.Spec.map_id]
    let e_K : K ≃+* ↑Γ_cat :=
      (CategoryTheory.Iso.mk k_to_Γ_cat Γ_to_k_cat hkΓ hΓk).commRingCatIsoToRingEquiv
    let A_K : Type u := ↑(C_K.presheaf.obj (Opposite.op W))
    obtain ⟨ψ₀, hψ₀_C, hψ₀_et⟩ := hStd.exists_etale_mvPolynomial
    let P₁ : Type u := MvPolynomial (Fin 1) K
    let e_P₁ : P₁ ≃+* MvPolynomial (Fin 1) ↑Γ_cat := MvPolynomial.mapEquiv (Fin 1) e_K
    let ψ : P₁ →+* A_K := ψ₀.comp e_P₁.toRingHom
    let f_KW : K →+* A_K := (p_K.appLE U_base W e_W).hom.comp k_to_Γ_cat.hom
    have hψ_C : ψ.comp MvPolynomial.C = f_KW := by
      ext c
      change ψ₀ (MvPolynomial.map e_K.toRingHom (MvPolynomial.C c)) =
        (p_K.appLE U_base W e_W).hom (k_to_Γ_cat.hom c)
      rw [MvPolynomial.map_C]
      exact RingHom.congr_fun hψ₀_C (k_to_Γ_cat.hom c)
    have hψ_et : ψ.Etale :=
      RingHom.Etale.stableUnderComposition e_P₁.toRingHom ψ₀
        (RingHom.Etale.of_bijective e_P₁.bijective) hψ₀_et
    obtain ⟨φ_cat, hFrac_W, hφ_Spec⟩ := hFuncF W hW hW_ne
    let φ_W : A_K →+* F := φ_cat.hom
    have hTower_KF : φ_W.comp f_KW = algebraMap K F := by
      have hHom_eq : CommRingCat.ofHom (φ_W.comp f_KW) =
          k_to_Γ_cat ≫ p_K.appLE U_base W e_W ≫ φ_cat := by
        ext c
        rfl
      have hSpec_eq : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_W.comp f_KW)) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K F)) := by
        rw [hHom_eq, AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp,
          AlgebraicGeometry.Spec.map_preimage, Category.assoc,
          AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec p_K hU_base hW e_W,
          ← Category.assoc, hφ_Spec, hηF_comm]
      exact CommRingCat.Hom.ext_iff.mp (AlgebraicGeometry.Spec.map_injective hSpec_eq)
    let _ : Algebra A_K F := φ_W.toAlgebra
    have : IsFractionRing A_K F := hFrac_W
    have hφW_inj : Function.Injective φ_W := IsFractionRing.injective A_K F
    have : Nontrivial A_K := RingHom.domain_nontrivial φ_W
    have : IsDomain A_K := Function.Injective.isDomain φ_W hφW_inj
    let _ : Algebra P₁ A_K := ψ.toAlgebra
    have : Algebra.Etale P₁ A_K := hψ_et
    have hψ_flat : ψ.Flat := (inferInstance : Module.Flat P₁ A_K)
    have hψ_inj : Function.Injective ψ := by
      have h_spec : (⊥ : PrimeSpectrum P₁) ⤳ PrimeSpectrum.comap ψ (⊥ : PrimeSpectrum A_K) :=
        (PrimeSpectrum.le_iff_specializes _ _).mp bot_le
      obtain ⟨p', hp'_spec, hp'_eq⟩ := hψ_flat.generalizingMap_comap h_spec
      have hp'_bot : p' = (⊥ : PrimeSpectrum A_K) :=
        le_bot_iff.mp ((PrimeSpectrum.le_iff_specializes _ _).mpr hp'_spec)
      subst hp'_bot
      rw [injective_iff_map_eq_zero]
      intro x hx
      have hx_mem : x ∈ (PrimeSpectrum.comap ψ (⊥ : PrimeSpectrum A_K)).asIdeal := hx
      rw [hp'_eq] at hx_mem
      exact hx_mem
    let K_t : Type u := FractionRing P₁
    have hUnits_P₁ : ∀ y : nonZeroDivisors P₁, IsUnit ((φ_W.comp ψ) y.1) := by
      intro y
      have hy_ne : (y : P₁) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp y.2
      refine isUnit_iff_ne_zero.mpr (fun h0 => hy_ne ?_)
      have hψy0 : ψ y.1 = 0 := hφW_inj (h0.trans (map_zero φ_W).symm)
      exact hψ_inj (hψy0.trans (map_zero ψ).symm)
    let _ : Algebra P₁ F := (φ_W.comp ψ).toAlgebra
    let ι_Kt : K_t →+* F :=
      IsLocalization.lift (M := nonZeroDivisors P₁) (S := K_t) hUnits_P₁
    let _ : Algebra K_t F := ι_Kt.toAlgebra
    have : IsScalarTower P₁ K_t F :=
      IsScalarTower.of_algebraMap_eq' (IsLocalization.lift_comp hUnits_P₁).symm
    have : IsScalarTower P₁ A_K F := IsScalarTower.of_algebraMap_eq' rfl
    have : Algebra.Etale K_t (TensorProduct P₁ K_t A_K) := Algebra.Etale.baseChange P₁ A_K K_t
    have : Module.Finite K_t (TensorProduct P₁ K_t A_K) := by
      obtain ⟨I_et, hFin_I, Ai, hField_Ai, hAlg_Ai, e_prod, hFin_Ai⟩ :=
        (Algebra.Etale.iff_exists_algEquiv_prod K_t (TensorProduct P₁ K_t A_K)).mp inferInstance
      let _ : Finite I_et := hFin_I
      let _ : ∀ i, CommRing (Ai i) := fun i => (hField_Ai i).toCommRing
      let _ : ∀ i, Algebra K_t (Ai i) := hAlg_Ai
      have : ∀ i, Module.Finite K_t (Ai i) := fun i => (hFin_Ai i).1
      exact Module.Finite.equiv e_prod.symm.toLinearEquiv
    let μ : TensorProduct P₁ K_t A_K →ₐ[K_t] F :=
      Algebra.TensorProduct.lift (Algebra.ofId K_t F) ⟨φ_W, fun _ => rfl⟩
        (fun _ _ => Commute.all _ _)
    have hμ_one : ∀ x : A_K, μ (1 ⊗ₜ[P₁] x) = φ_W x := by
      intro x
      dsimp only [μ]
      rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
      rfl
    let R_img : Subalgebra K_t F := μ.range
    have : Module.Finite K_t ↥R_img :=
      Module.Finite.of_surjective μ.rangeRestrict.toLinearMap μ.rangeRestrict_surjective
    have hμ_surj : Function.Surjective μ := by
      intro z
      obtain ⟨⟨a, s⟩, hzs⟩ := IsLocalization.surj (nonZeroDivisors A_K) z
      have hzs' : z * φ_W s.1 = φ_W a := hzs
      let s_R : ↥R_img := ⟨φ_W s.1, ⟨1 ⊗ₜ[P₁] s.1, hμ_one s.1⟩⟩
      have hs_ne : s_R ≠ 0 := by
        intro h0
        have hs0 : φ_W s.1 = 0 := congrArg Subtype.val h0
        exact mem_nonZeroDivisors_iff_ne_zero.mp s.2
          (hφW_inj (hs0.trans (map_zero φ_W).symm))
      obtain ⟨inv_s, h_inv⟩ := FiniteDimensional.exists_mul_eq_one K_t hs_ne
      have h_inv_val : φ_W s.1 * inv_s.1 = 1 := congrArg Subtype.val h_inv
      have hz_eq : z = φ_W a * inv_s.1 := by
        calc z = z * (φ_W s.1 * inv_s.1) := by rw [h_inv_val, mul_one]
          _ = (z * φ_W s.1) * inv_s.1 := by ring
          _ = φ_W a * inv_s.1 := by rw [hzs']
      have ha_mem : φ_W a ∈ R_img := ⟨1 ⊗ₜ[P₁] a, hμ_one a⟩
      rw [hz_eq]
      exact R_img.mul_mem ha_mem inv_s.2
    have : Module.Finite K_t F := Module.Finite.of_surjective μ.toLinearMap hμ_surj
    have : Algebra.IsAlgebraic K_t F := Algebra.IsAlgebraic.of_finite K_t F
    have : Algebra.IsAlgebraic P₁ K_t := IsLocalization.isAlgebraic K_t (nonZeroDivisors P₁)
    have : IsScalarTower K K_t F := by
      refine IsScalarTower.of_algebraMap_eq fun c => ?_
      calc algebraMap K F c
          = φ_W (f_KW c) := (RingHom.congr_fun hTower_KF c).symm
        _ = φ_W (ψ (MvPolynomial.C c)) := by
            change φ_W (f_KW c) = φ_W ((ψ.comp MvPolynomial.C) c)
            rw [hψ_C]
        _ = ι_Kt (algebraMap P₁ K_t (MvPolynomial.C c)) := by
            simpa using
              (RingHom.congr_fun (IsLocalization.lift_comp hUnits_P₁) (MvPolynomial.C c)).symm
        _ = algebraMap K_t F (algebraMap K K_t c) := rfl
    have : FaithfulSMul K P₁ :=
      (faithfulSMul_iff_algebraMap_injective K P₁).mpr (MvPolynomial.C_injective (Fin 1) K)
    have : FaithfulSMul P₁ K_t :=
      (faithfulSMul_iff_algebraMap_injective P₁ K_t).mpr (IsFractionRing.injective P₁ K_t)
    have htr1 : Algebra.trdeg K P₁ + Algebra.trdeg P₁ K_t = Algebra.trdeg K K_t :=
      trdeg_add_eq K P₁ (A := K_t)
    have htr2 : Algebra.trdeg K K_t + Algebra.trdeg K_t F = Algebra.trdeg K F :=
      trdeg_add_eq K K_t (A := F)
    rw [MvPolynomial.trdeg_of_isDomain, Cardinal.mk_fintype, Fintype.card_fin, Nat.cast_one,
      Cardinal.lift_one, trdeg_eq_zero (R := P₁) (A := K_t), add_zero] at htr1
    rw [← htr1, trdeg_eq_zero (R := K_t) (A := F), add_zero] at htr2
    exact le_of_eq htr2.symm
  
  have hFiberDim : ∀ (A : Type u) [CommRing A] [Algebra ↥V A] [Algebra.FiniteType ↥V A]
      (φ_AF : A →+* F),
      Function.Injective φ_AF →
      φ_AF.comp (algebraMap ↥V A) = (algebraMap K F).comp V.subtype →
      ringKrullDim (TensorProduct ↥V A Q.ResidueField) ≤ (1 : WithBot ℕ∞) := by
    intro A _ _ _ φ_AF hInj hCompat
    let κ : Type u := Q.ResidueField
    let A_Q : Type u := TensorProduct ↥V A κ
    let _ : Algebra κ A_Q := Algebra.TensorProduct.rightAlgebra
    have : Algebra.FiniteType κ (TensorProduct ↥V κ A) := Algebra.FiniteType.baseChange κ
    let e_comm : TensorProduct ↥V κ A →ₐ[κ] A_Q :=
      AlgHom.mk (Algebra.TensorProduct.comm ↥V κ A).toRingHom (fun _ => rfl)
    have : Algebra.FiniteType κ A_Q :=
      Algebra.FiniteType.of_surjective e_comm (Algebra.TensorProduct.comm ↥V κ A).surjective
    change (⨆ (q_ser : LTSeries (PrimeSpectrum A_Q)), (q_ser.length : WithBot ℕ∞)) ≤ 1
    refine iSup_le fun q_ser => ?_
    by_contra h_gt
    have hlen2 : 2 ≤ q_ser.length := by
      have h_lt : (1 : WithBot ℕ∞) < (q_ser.length : WithBot ℕ∞) := not_le.mp h_gt
      have h_enat : (1 : ℕ∞) < (q_ser.length : ℕ∞) := WithBot.coe_lt_coe.mp h_lt
      exact Nat.succ_le_of_lt (Nat.cast_lt.mp h_enat)
    let q₀ : PrimeSpectrum A_Q := q_ser ⟨0, by omega⟩
    let q₁ : PrimeSpectrum A_Q := q_ser ⟨1, by omega⟩
    let q₂ : PrimeSpectrum A_Q := q_ser ⟨2, by omega⟩
    have hq01 : q₀ < q₁ := q_ser.step ⟨0, by omega⟩
    have hq12 : q₁ < q₂ := q_ser.step ⟨1, by omega⟩
    let B : Type u := A_Q ⧸ q₀.asIdeal
    have : IsDomain B := Ideal.Quotient.isDomain q₀.asIdeal
    have : Algebra.FiniteType κ B :=
      Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ κ q₀.asIdeal)
        Ideal.Quotient.mk_surjective
    let mk_B : A_Q →+* B := Ideal.Quotient.mk q₀.asIdeal
    have hker_mk : RingHom.ker mk_B = q₀.asIdeal := Ideal.mk_ker
    have hb_prime : ∀ (q : PrimeSpectrum A_Q), q₀ ≤ q → (Ideal.map mk_B q.asIdeal).IsPrime := by
      intro q hle
      exact Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective (by rwa [hker_mk])
    let b₀' : PrimeSpectrum B := ⟨Ideal.map mk_B q₀.asIdeal, hb_prime q₀ le_rfl⟩
    let b₁' : PrimeSpectrum B := ⟨Ideal.map mk_B q₁.asIdeal, hb_prime q₁ (le_of_lt hq01)⟩
    let b₂' : PrimeSpectrum B :=
      ⟨Ideal.map mk_B q₂.asIdeal, hb_prime q₂ (le_of_lt (hq01.trans hq12))⟩
    have h_comap_map : ∀ (q : PrimeSpectrum A_Q), q₀ ≤ q →
        Ideal.comap mk_B (Ideal.map mk_B q.asIdeal) = q.asIdeal := by
      intro q hle
      rw [Ideal.comap_map_of_surjective mk_B Ideal.Quotient.mk_surjective]
      have hcomap_bot : Ideal.comap mk_B ⊥ = q₀.asIdeal := hker_mk
      rw [hcomap_bot]
      exact sup_eq_left.mpr hle
    have hb01 : b₀' < b₁' := by
      refine lt_of_le_of_ne (Ideal.map_mono (le_of_lt hq01)) (fun heq => hq01.ne ?_)
      apply PrimeSpectrum.ext
      have hcongr := congrArg (Ideal.comap mk_B) (congrArg PrimeSpectrum.asIdeal heq)
      rwa [h_comap_map q₀ le_rfl, h_comap_map q₁ (le_of_lt hq01)] at hcongr
    have hb12 : b₁' < b₂' := by
      refine lt_of_le_of_ne (Ideal.map_mono (le_of_lt hq12)) (fun heq => hq12.ne ?_)
      apply PrimeSpectrum.ext
      have hcongr := congrArg (Ideal.comap mk_B) (congrArg PrimeSpectrum.asIdeal heq)
      rwa [h_comap_map q₁ (le_of_lt hq01),
        h_comap_map q₂ (le_of_lt (hq01.trans hq12))] at hcongr
    let b_ser : LTSeries (PrimeSpectrum B) :=
      RelSeries.mk 2 ![b₀', b₁', b₂'] (by
        intro i
        fin_cases i
        · exact hb01
        · exact hb12)
    have hDimB_ge : ((2 : ℕ) : WithBot ℕ∞) ≤ ringKrullDim B :=
      Order.LTSeries.length_le_krullDim b_ser
    obtain ⟨s_dim, g_N, hg_inj, hg_int⟩ := exists_integral_inj_algHom_of_fg κ B
    have hs2 : 2 ≤ s_dim := by
      let P_s : Type u := MvPolynomial (Fin s_dim) κ
      let _ : Algebra P_s B := g_N.toRingHom.toAlgebra
      have : Algebra.IsIntegral P_s B := ⟨hg_int⟩
      have hStrict : StrictMono (PrimeSpectrum.comap g_N.toRingHom) := by
        intro p₁ p₂ hp
        have hp_id : p₁.asIdeal < p₂.asIdeal := hp
        obtain ⟨x, hx₂, hx₁⟩ := SetLike.exists_of_lt hp_id
        exact Ideal.under_lt_under_of_integral_mem_sdiff (R := P_s)
          (le_of_lt hp_id) ⟨hx₂, hx₁⟩ (Algebra.IsIntegral.isIntegral x)
      have hle_Ps : ringKrullDim B ≤ ringKrullDim P_s :=
        Order.krullDim_le_of_strictMono (PrimeSpectrum.comap g_N.toRingHom) hStrict
      have hDim_Ps : ringKrullDim P_s = ((s_dim : ℕ) : WithBot ℕ∞) := by
        rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field κ,
          zero_add, ENat.card_eq_coe_fintype_card, Fintype.card_fin]
        rfl
      have h2_le : ((2 : ℕ) : WithBot ℕ∞) ≤ ((s_dim : ℕ) : WithBot ℕ∞) :=
        hDimB_ge.trans (hle_Ps.trans (le_of_eq hDim_Ps))
      exact Nat.cast_le.mp (WithBot.coe_le_coe.mp h2_le)
    have hClear : ∀ z : A_Q, ∃ (s : ↥V), s ∉ Q ∧
        ∃ (y : A), ((1 : A) ⊗ₜ[↥V] (algebraMap ↥V κ s)) * z = y ⊗ₜ[↥V] (1 : κ) := by
      intro z
      induction z using TensorProduct.inductionOn with
      | tmul x c =>
        have : IsFractionRing (↥V ⧸ Q) κ := instIsFractionRingQuotientIdealResidueField Q
        obtain ⟨⟨q_num, m_den⟩, hcm⟩ := IsLocalization.surj (nonZeroDivisors (↥V ⧸ Q)) c
        obtain ⟨v, rfl⟩ := Ideal.Quotient.mk_surjective q_num
        obtain ⟨s, hs_mk⟩ := Ideal.Quotient.mk_surjective m_den.1
        have hs_notMem : s ∉ Q := by
          intro hsQ
          have h0 : (Ideal.Quotient.mk Q) s = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hsQ
          rw [hs_mk] at h0
          exact mem_nonZeroDivisors_iff_ne_zero.mp m_den.2 h0
        refine ⟨s, hs_notMem, v • x, ?_⟩
        have h_sc : algebraMap ↥V κ s * c = algebraMap ↥V κ v := by
          rw [← Ideal.algebraMap_quotient_residueField_mk Q s, hs_mk, mul_comm, hcm,
            Ideal.algebraMap_quotient_residueField_mk Q v]
        calc ((1 : A) ⊗ₜ[↥V] (algebraMap ↥V κ s)) * (x ⊗ₜ[↥V] c)
            = (1 * x) ⊗ₜ[↥V] (algebraMap ↥V κ s * c) :=
              Algebra.TensorProduct.tmul_mul_tmul _ _ _ _
          _ = x ⊗ₜ[↥V] (algebraMap ↥V κ v) := by rw [one_mul, h_sc]
          _ = x ⊗ₜ[↥V] (v • (1 : κ)) := by rw [Algebra.smul_def, mul_one]
          _ = (v • x) ⊗ₜ[↥V] (1 : κ) := (TensorProduct.smul_tmul v x (1 : κ)).symm
      | add z₁ z₂ ih₁ ih₂ =>
