    have hψ₃_rel :
        η_A3 (ι_a s₁' * u₀) * (η_A3 (ι_a t_s * u₁) * d₃_inv) = η_A3 (ι_a π₁') := by
      have hprod : (ι_a s₁' * u₀) * (ι_a t_s * u₁) = ι_a π₁' * d₃ := by
        calc (ι_a s₁' * u₀) * (ι_a t_s * u₁)
            = (ι_a s₁' * ι_a t_s) * (u₀ * u₁) := by ring
          _ = ι_a (s₁' * t_s) * ι_a a_Rz := by rw [← map_mul ι_a, hu₀u₁]
          _ = ι_a a_Rz := by rw [hst, map_one, one_mul]
          _ = ι_a (π₁' * a'_Rz) := congrArg ι_a ha_Rz
          _ = ι_a π₁' * d₃ := map_mul ι_a π₁' a'_Rz
      calc η_A3 (ι_a s₁' * u₀) * (η_A3 (ι_a t_s * u₁) * d₃_inv)
          = η_A3 ((ι_a s₁' * u₀) * (ι_a t_s * u₁)) * d₃_inv := by
              rw [← mul_assoc, ← map_mul η_A3]
        _ = η_A3 (ι_a π₁' * d₃) * d₃_inv := by rw [hprod]
        _ = η_A3 (ι_a π₁') * (η_A3 d₃ * d₃_inv) := by rw [map_mul η_A3, mul_assoc]
        _ = η_A3 (ι_a π₁') := by rw [hd₃_inv, mul_one]
    obtain ⟨ψ₃, _, hψ₃_C, hψ₃_X0, hψ₃_X1⟩ :=
