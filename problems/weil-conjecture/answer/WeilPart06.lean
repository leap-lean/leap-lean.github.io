          ← Y₀.basicOpen_res (e₀ α) (CategoryTheory.homOfLE (inf_le_left : U α ⊓ U β ≤ U α)).op,
          ← Y₀.basicOpen_res (1 - e₀ β) (CategoryTheory.homOfLE (inf_le_right : U α ⊓ U β ≤ U β)).op,
