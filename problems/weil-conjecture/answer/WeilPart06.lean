      let ev_hom : Polynomial Q.ResidueField →+* κW := Polynomial.eval₂RingHom ιQ (resW w)
      change ev_hom (Polynomial.C P_bar.leadingCoeff *
        (Multiset.map (fun x => Polynomial.X - Polynomial.C x) m_roots).prod) = 0 at h_ev0
      rw [map_mul, map_multiset_prod] at h_ev0
      have h_lc_ne : ev_hom (Polynomial.C P_bar.leadingCoeff) ≠ 0 := by
        have h1 : ev_hom (Polynomial.C P_bar.leadingCoeff) = ιQ P_bar.leadingCoeff :=
          Polynomial.eval₂_C _ _
        rw [h1]
        exact map_ne_zero_of_mem_nonZeroDivisors ιQ ιQ.injective
          (mem_nonZeroDivisors_of_ne_zero (Polynomial.leadingCoeff_ne_zero.mpr hPbar_ne))
      rcases mul_eq_zero.mp h_ev0 with h_abs | h_prod0
      · exact h_lc_ne h_abs
      · rw [Multiset.prod_eq_zero_iff, Multiset.mem_map] at h_prod0
        obtain ⟨_, h_mem_m, h_fac0⟩ := h_prod0
        rw [Multiset.mem_map] at h_mem_m
        obtain ⟨r, _, rfl⟩ := h_mem_m
        have hr : resW w - ιQ r = 0 := by
          simpa [ev_hom] using h_fac0
        exact hw_not ⟨r, (sub_eq_zero.mp hr).symm⟩

  
  have hExGen_M : ∃ (N_gen : ℕ) (f_gen : Fin N_gen → F),
