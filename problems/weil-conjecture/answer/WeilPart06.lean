              ψ_M ≫ p_sm ≫ j_loc =
                AlgebraicGeometry.Spec.map
                  (CommRingCat.ofHom (θ₀.comp (p₀.comp φ_poly))) := by
            rw [← hψ₀, hψ₀_eq, Category.assoc, ← Category.assoc ι₀ p_sm j_loc, hι₀_p]
            dsimp only [j_loc]
            rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
            congr 1
          rw [hcomp0, AlgebraicGeometry.Spec.preimage_map]
          change θ₀ (p₀ L_sec) = _
          rw [hu_eq, hp₀_u]
        have hθ₀_π_ne : θ₀ (((Ideal.Quotient.mk _).comp MvPolynomial.C) π₁') ≠ 0 := by
          rwa [← hgloc_0]
        have hθ₀_u :
            θ₀ (Ideal.Quotient.mk _ (MvPolynomial.X 0)) =
              θ₀ (((Ideal.Quotient.mk _).comp MvPolynomial.C) π₁') * q := by
          rw [← hjloc_0, ← hgloc_0]
          exact hlin_R
        have hrel_C₀ :
            (Ideal.Quotient.mk _ (MvPolynomial.X 0) : C₀) * s₀ =
              ((Ideal.Quotient.mk _).comp MvPolynomial.C) π₁' := by
          change Ideal.Quotient.mk _ (MvPolynomial.X 0 * MvPolynomial.X 1) =
            Ideal.Quotient.mk _ (MvPolynomial.C π₁')
          exact Ideal.Quotient.eq.mpr (Ideal.subset_span rfl)
        have hmul_eq :
            θ₀ (((Ideal.Quotient.mk _).comp MvPolynomial.C) π₁') * (q * θ₀ s₀) =
              θ₀ (((Ideal.Quotient.mk _).comp MvPolynomial.C) π₁') * 1 := by
          calc
            θ₀ (((Ideal.Quotient.mk _).comp MvPolynomial.C) π₁') * (q * θ₀ s₀)
              = (θ₀ (((Ideal.Quotient.mk _).comp MvPolynomial.C) π₁') * q) * θ₀ s₀ :=
                (mul_assoc _ _ _).symm
            _ = θ₀ (Ideal.Quotient.mk _ (MvPolynomial.X 0)) * θ₀ s₀ := by rw [← hθ₀_u]
            _ = θ₀ ((Ideal.Quotient.mk _ (MvPolynomial.X 0) : C₀) * s₀) := (map_mul _ _ _).symm
            _ = θ₀ (((Ideal.Quotient.mk _).comp MvPolynomial.C) π₁') * 1 := by
                rw [hrel_C₀, mul_one]
        have hqs₀ : q * θ₀ s₀ = 1 := mul_left_cancel₀ hθ₀_π_ne hmul_eq
        have hUnit_s₀ : IsUnit (θ₀ s₀) :=
          ⟨⟨θ₀ s₀, q, by rw [mul_comm, hqs₀], hqs₀⟩, rfl⟩
        let θ₀₁_pair : { φ : C₀₁ →+* R // φ.comp f₀₁ = θ₀ } := by
          letI : Algebra C₀ C₀₁ := f₀₁.toAlgebra
          have : IsLocalization.Away s₀ C₀₁ := hloc₀
          exact ⟨IsLocalization.Away.lift s₀ hUnit_s₀,
            RingHom.ext fun x => IsLocalization.Away.lift_eq s₀ hUnit_s₀ x⟩
        let θ₀₁ : C₀₁ →+* R := θ₀₁_pair.1
        have hθ₀₁_comp : θ₀₁.comp f₀₁ = θ₀ := θ₀₁_pair.2
        have hψM_1 :
            ψ_M =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₀₁) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₁₀) ≫ ι₁ := by
          calc
            ψ_M = ψ₀ ≫ ι₀ := hψ₀.symm
            _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ₀₁.comp f₀₁)) ≫ ι₀ := by
              rw [hψ₀_eq, hθ₀₁_comp]
            _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₀₁) ≫
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₀₁) ≫ ι₀) := by
              rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, Category.assoc]
            _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₀₁) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₁₀) ≫ ι₁ := by
              rw [hOv_ι]
        change ψ_M.base m₀ ∈ (ι₁.opensRange : Set M_sm)
        rw [ι₁.coe_opensRange, hψM_1]
        exact ⟨(AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₀₁) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₁₀)).base m₀, rfl⟩
      · exact hm₀_1
    have hsub1 : Set.range ψ_M.base ⊆ Set.range ι₁.base := by
      rw [← ι₁.coe_opensRange]
      exact hRange_of_mem U_sm1 hm₀_in1
    let ψ₁ := AlgebraicGeometry.IsOpenImmersion.lift ι₁ ψ_M hsub1
    have hψ₁ : ψ₁ ≫ ι₁ = ψ_M := AlgebraicGeometry.IsOpenImmersion.lift_fac ι₁ ψ_M hsub1
    let θ₁ : C₁ →+* R := (AlgebraicGeometry.Spec.preimage ψ₁).hom
    have hψ₁_eq : ψ₁ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₁) :=
      (AlgebraicGeometry.Spec.map_preimage ψ₁).symm
    let ψ_U : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ U_sm1.toScheme :=
      ψ₁ ≫ ι₁.isoOpensRange.hom
    have hψU_ι : ψ_U ≫ U_sm1.ι = ψ_M := by
      dsimp only [ψ_U]
      rw [Category.assoc, ι₁.isoOpensRange_hom_ι, hψ₁]
    refine ⟨ψ_U, hψU_ι, ?_⟩
    have hgloc_1 :
        (AlgebraicGeometry.Spec.preimage (ψ_M ≫ p_sm ≫ g_loc)).hom π₁ =
          θ₁ (Polynomial.C π₁') := by
      have hcomp1 :
          ψ_M ≫ p_sm ≫ g_loc =
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (θ₁.comp (Polynomial.C.comp (algebraMap ↥V R_z)))) := by
        rw [← hψ₁, hψ₁_eq, Category.assoc, ← Category.assoc ι₁ p_sm g_loc, hι₁_p]
        dsimp only [g_loc]
        rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
        congr 1
        ext x
        change θ₁ (p₁ (Polynomial.C (algebraMap ↥V R_z x))) =
          θ₁ (Polynomial.C (algebraMap ↥V R_z x))
        rw [← RingHom.comp_apply p₁ Polynomial.C, hp₁_C]
      rw [hcomp1, AlgebraicGeometry.Spec.preimage_map]
      rfl
    have hjloc_1 :
        (AlgebraicGeometry.Spec.preimage (ψ_M ≫ p_sm ≫ j_loc)).hom
            (Polynomial.C s₁ * Polynomial.X - Polynomial.C c₁) =
          θ₁ (Polynomial.C π₁') * θ₁ t₁ := by
      have hcomp1 :
          ψ_M ≫ p_sm ≫ j_loc =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ₁.comp (p₁.comp φ_poly))) := by
        rw [← hψ₁, hψ₁_eq, Category.assoc, ← Category.assoc ι₁ p_sm j_loc, hι₁_p]
        dsimp only [j_loc]
        rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
        congr 1
      rw [hcomp1, AlgebraicGeometry.Spec.preimage_map]
      change θ₁ (p₁ L_sec) = _
      rw [hu_eq, hp₁_u, map_mul]
    have hesm1_X :
        (AlgebraicGeometry.Spec.preimage (ψ_U ≫ e_sm1)).hom Polynomial.X = θ₁ t₁ := by
      have hcomp_e :
          ψ_U ≫ e_sm1 = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ₁.comp φ_poly)) := by
        dsimp only [ψ_U, e_sm1, j_loc]
        rw [Category.assoc, Iso.hom_inv_id_assoc, hψ₁_eq, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp]
      rw [hcomp_e, AlgebraicGeometry.Spec.preimage_map]
      change θ₁ (φ_poly Polynomial.X) = θ₁ t₁
      simp [φ_poly, t₁]
    calc
      (AlgebraicGeometry.Spec.preimage (ψ_M ≫ p_sm ≫ g_loc)).hom π₁ *
          (AlgebraicGeometry.Spec.preimage (ψ_U ≫ e_sm1)).hom Polynomial.X
        = θ₁ (Polynomial.C π₁') * θ₁ t₁ := by rw [hgloc_1, hesm1_X]
      _ = (AlgebraicGeometry.Spec.preimage (ψ_M ≫ p_sm ≫ j_loc)).hom
            (Polynomial.C s₁ * Polynomial.X - Polynomial.C c₁) := hjloc_1.symm
      _ = (AlgebraicGeometry.Spec.preimage (ψ_M ≫ p_sm ≫ g_loc)).hom π₁ * q := hlin_R

theorem weil_overlap_nodal_chart_and_branch_ring_algebra (R_z : Type u) [CommRing R_z]
    (s₁' π₁' a'_Rz b₁' a_Rz : R_z)
    (hs₁' : IsUnit s₁')
    (hb₁' : b₁' = s₁' * a'_Rz)
    (ha_Rz : a_Rz = π₁' * a'_Rz) :
    let A_loc := MvPolynomial (Fin 2) R_z ⧸ Ideal.span
      {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a_Rz}
    let C₀ := MvPolynomial (Fin 2) R_z ⧸ Ideal.span
      {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C π₁'}
    let C₁ := MvPolynomial (Fin 2) R_z ⧸ Ideal.span
      {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C b₁'}
    let C₀₁ := Localization.Away (Polynomial.X : Polynomial R_z)
    ∃ (p₀_hom : A_loc →+* C₀)
      (p₁_hom : A_loc →+* C₁)
      (f₀₁_hom : C₀ →+* C₀₁)
      (f₁₀_hom : C₁ →+* C₀₁),
      (p₀_hom.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) =
          (Ideal.Quotient.mk _).comp MvPolynomial.C ∧
        p₁_hom.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) =
          (Ideal.Quotient.mk _).comp MvPolynomial.C ∧
        f₀₁_hom.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) =
          (algebraMap (Polynomial R_z) C₀₁).comp Polynomial.C ∧
        f₁₀_hom.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) =
          (algebraMap (Polynomial R_z) C₀₁).comp Polynomial.C) ∧
      (p₀_hom (Ideal.Quotient.mk _ (MvPolynomial.C s₁' * MvPolynomial.X 0)) =
          Ideal.Quotient.mk _ (MvPolynomial.X 0) ∧
        p₀_hom (Ideal.Quotient.mk _ (MvPolynomial.X 1)) =
          Ideal.Quotient.mk _ (MvPolynomial.C b₁' * MvPolynomial.X 1) ∧
        p₁_hom (Ideal.Quotient.mk _ (MvPolynomial.C s₁' * MvPolynomial.X 0)) =
          Ideal.Quotient.mk _ (MvPolynomial.C π₁' * MvPolynomial.X 1) ∧
        p₁_hom (Ideal.Quotient.mk _ (MvPolynomial.X 1)) =
          Ideal.Quotient.mk _ (MvPolynomial.X 0) ∧
        f₁₀_hom (Ideal.Quotient.mk _ (MvPolynomial.X 0)) =
          algebraMap (Polynomial R_z) C₀₁ (Polynomial.C b₁') *
            IsLocalization.Away.invSelf (S := C₀₁) (Polynomial.X : Polynomial R_z) ∧
        f₁₀_hom (Ideal.Quotient.mk _ (MvPolynomial.X 1)) =
          algebraMap (Polynomial R_z) C₀₁ Polynomial.X) ∧
      (@IsLocalization.Away C₀ _ (Ideal.Quotient.mk _ (MvPolynomial.X 1)) C₀₁ _
          f₀₁_hom.toAlgebra ∧
        @IsLocalization.Away C₁ _ (Ideal.Quotient.mk _ (MvPolynomial.X 1)) C₀₁ _
          f₁₀_hom.toAlgebra ∧
        f₀₁_hom.comp p₀_hom = f₁₀_hom.comp p₁_hom ∧
        Subring.closure (Set.range p₀_hom ∪ {Ideal.Quotient.mk _ (MvPolynomial.X 1)}) = ⊤ ∧
        Subring.closure (Set.range p₁_hom ∪ {Ideal.Quotient.mk _ (MvPolynomial.X 1)}) = ⊤ ∧
        f₁₀_hom (Ideal.Quotient.mk _ (MvPolynomial.X 1)) *
          f₀₁_hom (Ideal.Quotient.mk _ (MvPolynomial.X 1)) = 1) ∧
      (((∀ q : PrimeSpectrum C₁,
          p₁_hom (Ideal.Quotient.mk _ (MvPolynomial.X 0)) ∉ q.asIdeal →
            Ideal.Quotient.mk _ (MvPolynomial.X 1) ∉ q.asIdeal) ∧
        @IsLocalization.Away A_loc _ (Ideal.Quotient.mk _ (MvPolynomial.X 0))
          (Localization.Away (p₀_hom (Ideal.Quotient.mk _ (MvPolynomial.X 0)))) _
          ((algebraMap C₀ _).comp p₀_hom).toAlgebra) ∧
       ((∀ q : PrimeSpectrum C₀,
          p₀_hom (Ideal.Quotient.mk _ (MvPolynomial.X 1)) ∉ q.asIdeal →
            Ideal.Quotient.mk _ (MvPolynomial.X 1) ∉ q.asIdeal) ∧
        @IsLocalization.Away A_loc _ (Ideal.Quotient.mk _ (MvPolynomial.X 1))
          (Localization.Away (p₁_hom (Ideal.Quotient.mk _ (MvPolynomial.X 1)))) _
          ((algebraMap C₁ _).comp p₁_hom).toAlgebra) ∧
       ((∀ q : PrimeSpectrum C₀,
          p₀_hom (Ideal.Quotient.mk _ (MvPolynomial.C π₁')) ∉ q.asIdeal →
            Ideal.Quotient.mk _ (MvPolynomial.X 1) ∉ q.asIdeal) ∧
        @IsLocalization.Away A_loc _ (Ideal.Quotient.mk _ (MvPolynomial.C π₁'))
          (Localization.Away (p₁_hom (Ideal.Quotient.mk _ (MvPolynomial.C π₁')))) _
          ((algebraMap C₁ _).comp p₁_hom).toAlgebra) ∧
       ((∀ q : PrimeSpectrum C₁,
          p₁_hom (Ideal.Quotient.mk _ (MvPolynomial.C a'_Rz)) ∉ q.asIdeal →
            Ideal.Quotient.mk _ (MvPolynomial.X 1) ∉ q.asIdeal) ∧
        @IsLocalization.Away A_loc _ (Ideal.Quotient.mk _ (MvPolynomial.C a'_Rz))
          (Localization.Away (p₀_hom (Ideal.Quotient.mk _ (MvPolynomial.C a'_Rz)))) _
          ((algebraMap C₀ _).comp p₀_hom).toAlgebra)) ∧
      (∀ (κ : Type u) [CommRing κ] (ρ_P : R_z →+* κ),
        ρ_P π₁' = 0 →
        ρ_P a'_Rz = 0 →
        ∃ (ε_A : A_loc →+* κ)
          (ν₀ σ₀_hom : C₀ →+* Polynomial κ)
          (ν₁ σ₁_hom : C₁ →+* Polynomial κ)
          (τ_br1 τ_br2 : A_loc →+* Polynomial κ),
          ε_A.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) = ρ_P ∧
          ε_A (Ideal.Quotient.mk _ (MvPolynomial.X 0)) = 0 ∧
          ε_A (Ideal.Quotient.mk _ (MvPolynomial.X 1)) = 0 ∧
          ν₀.comp p₀_hom = Polynomial.C.comp ε_A ∧
          ν₀ (Ideal.Quotient.mk _ (MvPolynomial.X 1)) = Polynomial.X ∧
          ν₁.comp p₁_hom = Polynomial.C.comp ε_A ∧
          ν₁ (Ideal.Quotient.mk _ (MvPolynomial.X 1)) = Polynomial.X ∧
          τ_br1.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) = Polynomial.C.comp ρ_P ∧
          τ_br1 (Ideal.Quotient.mk _ (MvPolynomial.X 0)) = Polynomial.X ∧
          (Polynomial.evalRingHom 0).comp τ_br1 = ε_A ∧
          (∀ (D : Type u) [CommRing D] (ι_κ : κ →+* D) (φ_D : A_loc →+* D),
            φ_D.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) = ι_κ.comp ρ_P →
            RingHom.ker τ_br1 ≤ RingHom.ker φ_D →
            (Polynomial.eval₂RingHom ι_κ (φ_D (Ideal.Quotient.mk _ (MvPolynomial.X 0)))).comp
              τ_br1 = φ_D) ∧
          σ₀_hom.comp p₀_hom = τ_br1 ∧
          (Polynomial.evalRingHom 0).comp σ₀_hom = (Polynomial.evalRingHom 0).comp ν₀ ∧
          τ_br2.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) = Polynomial.C.comp ρ_P ∧
          τ_br2 (Ideal.Quotient.mk _ (MvPolynomial.X 1)) = Polynomial.X ∧
          (Polynomial.evalRingHom 0).comp τ_br2 = ε_A ∧
          (∀ (D : Type u) [CommRing D] (ι_κ : κ →+* D) (φ_D : A_loc →+* D),
            φ_D.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) = ι_κ.comp ρ_P →
            RingHom.ker τ_br2 ≤ RingHom.ker φ_D →
            (Polynomial.eval₂RingHom ι_κ (φ_D (Ideal.Quotient.mk _ (MvPolynomial.X 1)))).comp
              τ_br2 = φ_D) ∧
          σ₁_hom.comp p₁_hom = τ_br2 ∧
          (Polynomial.evalRingHom 0).comp σ₁_hom = (Polynomial.evalRingHom 0).comp ν₁) :=
by
  intro A_loc C₀ C₁ C₀₁
  
  obtain ⟨u_s, hu_s⟩ := hs₁'
  let t_s : R_z := ↑(u_s⁻¹)
  have hst : s₁' * t_s = 1 := by
    rw [← hu_s, ← Units.val_mul, mul_inv_cancel, Units.val_one]
  have hts : t_s * s₁' = 1 := by
    rw [mul_comm, hst]
  have htb₁ : t_s * b₁' = a'_Rz := by
    rw [hb₁', ← mul_assoc, hts, one_mul]
  have htb₁π₁ : t_s * b₁' * π₁' = a_Rz := by
    rw [htb₁, ha_Rz, mul_comm]
  have hs₁a : s₁' * a_Rz = b₁' * π₁' := by
    rw [ha_Rz, hb₁']
    ring
  have hs₁tπ₁ : s₁' * (t_s * π₁') = π₁' := by
    rw [← mul_assoc, hst, one_mul]
  
  let I_nod (c : R_z) : Ideal (MvPolynomial (Fin 2) R_z) :=
    Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c}
  let mk_nod (c : R_z) : MvPolynomial (Fin 2) R_z →+* (MvPolynomial (Fin 2) R_z ⧸ I_nod c) :=
    Ideal.Quotient.mk (I_nod c)
  let ι_nod (c : R_z) : R_z →+* (MvPolynomial (Fin 2) R_z ⧸ I_nod c) :=
    (mk_nod c).comp MvPolynomial.C
  have nodal_rel : ∀ c : R_z,
      mk_nod c (MvPolynomial.X 0) * mk_nod c (MvPolynomial.X 1) = ι_nod c c := by
    intro c
    have hmem : MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c ∈ I_nod c :=
      Ideal.mem_span_singleton_self _
    have hzero : mk_nod c (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c) = 0 :=
      (Ideal.Quotient.eq_zero_iff_mem).mpr hmem
    rw [map_sub, map_mul] at hzero
    exact sub_eq_zero.mp hzero
  have nodal_lift_pkg : ∀ {B : Type u} [CommRing B] (c : R_z) (φ₀ : R_z →+* B) (x₀ x₁ : B),
      x₀ * x₁ = φ₀ c →
      ∃ (g : (MvPolynomial (Fin 2) R_z ⧸ I_nod c) →+* B),
        g.comp (ι_nod c) = φ₀ ∧
        (∀ r : R_z, g (ι_nod c r) = φ₀ r) ∧
        g (mk_nod c (MvPolynomial.X 0)) = x₀ ∧
        g (mk_nod c (MvPolynomial.X 1)) = x₁ := by
    intro B _ c φ₀ x₀ x₁ hrel
    let ev : MvPolynomial (Fin 2) R_z →+* B := MvPolynomial.eval₂Hom φ₀ ![x₀, x₁]
    have hker : ∀ f ∈ I_nod c, ev f = 0 := by
      intro f hf
      obtain ⟨q, rfl⟩ := Ideal.mem_span_singleton.mp hf
      have hgen : ev (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c) = 0 := by
        dsimp only [ev]
        rw [map_sub, map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X',
          MvPolynomial.eval₂Hom_C, Matrix.cons_val_zero, Matrix.cons_val_one,
          Matrix.cons_val_zero, hrel, sub_self]
      rw [map_mul, hgen, zero_mul]
    let g : (MvPolynomial (Fin 2) R_z ⧸ I_nod c) →+* B := Ideal.Quotient.lift (I_nod c) ev hker
    have hg_C : ∀ r : R_z, g (ι_nod c r) = φ₀ r := by
      intro r
      change Ideal.Quotient.lift (I_nod c) ev hker
        (Ideal.Quotient.mk (I_nod c) (MvPolynomial.C r)) = φ₀ r
      rw [Ideal.Quotient.lift_mk]
      exact MvPolynomial.eval₂Hom_C φ₀ ![x₀, x₁] r
    have hg_X0 : g (mk_nod c (MvPolynomial.X 0)) = x₀ := by
      change Ideal.Quotient.lift (I_nod c) ev hker
        (Ideal.Quotient.mk (I_nod c) (MvPolynomial.X 0)) = x₀
      rw [Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_X', Matrix.cons_val_zero]
    have hg_X1 : g (mk_nod c (MvPolynomial.X 1)) = x₁ := by
      change Ideal.Quotient.lift (I_nod c) ev hker
        (Ideal.Quotient.mk (I_nod c) (MvPolynomial.X 1)) = x₁
      rw [Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_X', Matrix.cons_val_one,
        Matrix.cons_val_zero]
    refine ⟨g, ?_, hg_C, hg_X0, hg_X1⟩
    exact RingHom.ext hg_C
  have nodalHom_ext : ∀ {B : Type u} [CommRing B] (c : R_z)
      {g₁ g₂ : (MvPolynomial (Fin 2) R_z ⧸ I_nod c) →+* B},
      (∀ r : R_z, g₁ (ι_nod c r) = g₂ (ι_nod c r)) →
      g₁ (mk_nod c (MvPolynomial.X 0)) = g₂ (mk_nod c (MvPolynomial.X 0)) →
      g₁ (mk_nod c (MvPolynomial.X 1)) = g₂ (mk_nod c (MvPolynomial.X 1)) →
      g₁ = g₂ := by
    intro B _ c g₁ g₂ hC hX0 hX1
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext
    · intro r
      exact hC r
    · intro i
      fin_cases i
      · exact hX0
      · exact hX1
  have nodal_subring_eq_top : ∀ (c : R_z)
      (S : Subring (MvPolynomial (Fin 2) R_z ⧸ I_nod c)),
      (∀ r : R_z, ι_nod c r ∈ S) →
      mk_nod c (MvPolynomial.X 0) ∈ S →
      mk_nod c (MvPolynomial.X 1) ∈ S →
      S = ⊤ := by
    intro c S hC hX0 hX1
    rw [eq_top_iff]
    intro z _
    obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective z
    refine @MvPolynomial.induction_on R_z (Fin 2) _ (fun P => mk_nod c P ∈ S) F ?_ ?_ ?_
    · intro r
      exact hC r
    · intro p q hp hq
      rw [map_add]
      exact S.add_mem hp hq
    · intro p i hp
      rw [map_mul]
      refine S.mul_mem hp ?_
      fin_cases i
      · exact hX0
      · exact hX1
  
  have away_lift_pkg : ∀ {A B : Type u} [CommRing A] [CommRing B]
      (f : A →+* B) (x : A) (v : B),
      f x * v = 1 →
      ∃ (α : Localization.Away x →+* B),
        (∀ a : A, α (algebraMap A (Localization.Away x) a) = f a) ∧
        α (IsLocalization.Away.invSelf (S := Localization.Away x) x) = v := by
    intro A B _ _ f x v hfv
    letI : Algebra A B := f.toAlgebra
    have hfx : IsUnit (algebraMap A B x) :=
      isUnit_iff_exists.mpr ⟨v, hfv, by rw [mul_comm]; exact hfv⟩
    let α : Localization.Away x →+* B :=
      IsLocalization.Away.lift (S := Localization.Away x) x hfx
    have hα_alg : ∀ a : A, α (algebraMap A (Localization.Away x) a) = f a :=
      fun a => IsLocalization.Away.lift_eq (S := Localization.Away x) x hfx a
    have hα_inv : α (IsLocalization.Away.invSelf (S := Localization.Away x) x) = v := by
      have h1 : f x * α (IsLocalization.Away.invSelf (S := Localization.Away x) x) = 1 := by
        rw [← hα_alg x, ← map_mul, IsLocalization.Away.mul_invSelf, map_one]
      calc α (IsLocalization.Away.invSelf (S := Localization.Away x) x)
          = 1 * α (IsLocalization.Away.invSelf (S := Localization.Away x) x) := (one_mul _).symm
        _ = (v * f x) * α (IsLocalization.Away.invSelf (S := Localization.Away x) x) := by
            rw [mul_comm v (f x), hfv]
        _ = v * (f x * α (IsLocalization.Away.invSelf (S := Localization.Away x) x)) :=
            mul_assoc _ _ _
        _ = v * 1 := by rw [h1]
        _ = v := mul_one v
    exact ⟨α, hα_alg, hα_inv⟩
  have isLoc_of_ret : ∀ {A B : Type u} [CommRing A] [CommRing B]
      (x : A) (f : A →+* B)
      (α : Localization.Away x →+* B)
      (β : B →+* Localization.Away x),
      (∀ a : A, α (algebraMap A (Localization.Away x) a) = f a) →
      (∀ a : A, β (f a) = algebraMap A (Localization.Away x) a) →
      α.comp β = RingHom.id B →
      @IsLocalization.Away A _ x B _ f.toAlgebra := by
    intro A B _ _ x f α β hα_alg hβ_f hαβ
    have hβα : β.comp α = RingHom.id (Localization.Away x) := by
      apply IsLocalization.ringHom_ext (Submonoid.powers x)
      exact RingHom.ext fun a => by
        simp only [RingHom.comp_apply, RingHom.id_apply, hα_alg, hβ_f]
    letI : Algebra A B := f.toAlgebra
    let e_ring : Localization.Away x ≃+* B := RingEquiv.ofRingHom α β hαβ hβα
    let e_alg : Localization.Away x ≃ₐ[A] B :=
      AlgEquiv.ofRingEquiv (f := e_ring) (fun a => hα_alg a)
    exact (IsLocalization.isLocalization_iff_of_algEquiv (Submonoid.powers x) e_alg).mp
      inferInstance
  have comp_away_isLocalization : ∀ {A C : Type u} [CommRing A] [CommRing C]
      (p : A →+* C) (d : A) (ψ : C →+* Localization.Away d),
      ψ.comp p = algebraMap A (Localization.Away d) →
      (∀ (α : Localization.Away d →+* Localization.Away (p d)),
        (∀ a : A, α (algebraMap A (Localization.Away d) a) =
          algebraMap C (Localization.Away (p d)) (p a)) →
        α (IsLocalization.Away.invSelf (S := Localization.Away d) d) =
          IsLocalization.Away.invSelf (S := Localization.Away (p d)) (p d) →
        α.comp ψ = algebraMap C (Localization.Away (p d))) →
      @IsLocalization.Away A _ d (Localization.Away (p d)) _
        ((algebraMap C (Localization.Away (p d))).comp p).toAlgebra := by
    intro A C _ _ p d ψ hψ_p hα_ψ
    let L_A := Localization.Away d
    let η_A : A →+* L_A := algebraMap A L_A
    let d_inv : L_A := IsLocalization.Away.invSelf (S := L_A) d
    let M_C := Localization.Away (p d)
    let η_C : C →+* M_C := algebraMap C M_C
    let w_inv : M_C := IsLocalization.Away.invSelf (S := M_C) (p d)
    let f : A →+* M_C := η_C.comp p
    have hf_inv : f d * w_inv = 1 :=
      IsLocalization.Away.mul_invSelf (S := M_C) (p d)
    obtain ⟨α, hα_alg, hα_inv⟩ := away_lift_pkg f d w_inv hf_inv
    have hψ_pd : ψ (p d) = η_A d := RingHom.congr_fun hψ_p d
    have hψ_inv : ψ (p d) * d_inv = 1 := by
      rw [hψ_pd]
      exact IsLocalization.Away.mul_invSelf (S := L_A) d
    obtain ⟨β, hβ_alg, _⟩ := away_lift_pkg ψ (p d) d_inv hψ_inv
    have hα_ψ_eq : α.comp ψ = η_C := hα_ψ α hα_alg hα_inv
    have hαβ : α.comp β = RingHom.id M_C := by
      apply IsLocalization.ringHom_ext (Submonoid.powers (p d))
      exact RingHom.ext fun c => by
        have hc : β (η_C c) = ψ c := hβ_alg c
        change α (β (η_C c)) = η_C c
        rw [hc]
        exact RingHom.congr_fun hα_ψ_eq c
    refine isLoc_of_ret d f α β hα_alg ?_ hαβ
    intro a
    change β (η_C (p a)) = η_A a
    rw [hβ_alg]
    exact RingHom.congr_fun hψ_p a
  
  let ι_a : R_z →+* A_loc := ι_nod a_Rz
  let ι_0 : R_z →+* C₀ := ι_nod π₁'
  let ι_1 : R_z →+* C₁ := ι_nod b₁'
  let κ₀₁ : R_z →+* C₀₁ := (algebraMap (Polynomial R_z) C₀₁).comp Polynomial.C
  let u₀ : A_loc := mk_nod a_Rz (MvPolynomial.X 0)
  let u₁ : A_loc := mk_nod a_Rz (MvPolynomial.X 1)
  let u_tilde : C₀ := mk_nod π₁' (MvPolynomial.X 0)
  let π' : C₀ := mk_nod π₁' (MvPolynomial.X 1)
  let v₁ : C₁ := mk_nod b₁' (MvPolynomial.X 0)
  let u' : C₁ := mk_nod b₁' (MvPolynomial.X 1)
  let T : C₀₁ := algebraMap (Polynomial R_z) C₀₁ Polynomial.X
  let T_inv : C₀₁ := IsLocalization.Away.invSelf (S := C₀₁) (Polynomial.X : Polynomial R_z)
  have hTT_inv : T * T_inv = 1 :=
    IsLocalization.Away.mul_invSelf (S := C₀₁) (Polynomial.X : Polynomial R_z)
  have hT_invT : T_inv * T = 1 := by
    rw [mul_comm, hTT_inv]
  have hu₀u₁ : u₀ * u₁ = ι_a a_Rz := nodal_rel a_Rz
  have hu_tilde_π' : u_tilde * π' = ι_0 π₁' := nodal_rel π₁'
  have hv₁u' : v₁ * u' = ι_1 b₁' := nodal_rel b₁'
  
  have hp₀_rel : (ι_0 t_s * u_tilde) * (ι_0 b₁' * π') = ι_0 a_Rz := by
    calc (ι_0 t_s * u_tilde) * (ι_0 b₁' * π')
        = (ι_0 t_s * ι_0 b₁') * (u_tilde * π') := by ring
      _ = (ι_0 t_s * ι_0 b₁') * ι_0 π₁' := by rw [hu_tilde_π']
      _ = ι_0 (t_s * b₁' * π₁') := by rw [← map_mul, ← map_mul]
      _ = ι_0 a_Rz := by rw [htb₁π₁]
  obtain ⟨p₀_hom, hp₀_comp, hp₀_C, hp₀_X0, hp₀_X1⟩ :=
    nodal_lift_pkg a_Rz ι_0 (ι_0 t_s * u_tilde) (ι_0 b₁' * π') hp₀_rel
  
  have hp₁_rel : (ι_1 (t_s * π₁') * u') * v₁ = ι_1 a_Rz := by
    calc (ι_1 (t_s * π₁') * u') * v₁
        = ι_1 (t_s * π₁') * (v₁ * u') := by ring
      _ = ι_1 (t_s * π₁') * ι_1 b₁' := by rw [hv₁u']
      _ = ι_1 (t_s * π₁' * b₁') := by rw [← map_mul]
      _ = ι_1 (t_s * b₁' * π₁') := by congr 1; ring
      _ = ι_1 a_Rz := by rw [htb₁π₁]
  obtain ⟨p₁_hom, hp₁_comp, hp₁_C, hp₁_X0, hp₁_X1⟩ :=
    nodal_lift_pkg a_Rz ι_1 (ι_1 (t_s * π₁') * u') v₁ hp₁_rel
  
  have hf₀₁_rel : (κ₀₁ π₁' * T) * T_inv = κ₀₁ π₁' := by
    rw [mul_assoc, hTT_inv, mul_one]
  obtain ⟨f₀₁_hom, hf₀₁_comp, hf₀₁_C, hf₀₁_X0, hf₀₁_X1⟩ :=
    nodal_lift_pkg π₁' κ₀₁ (κ₀₁ π₁' * T) T_inv hf₀₁_rel
  
  have hf₁₀_rel : (κ₀₁ b₁' * T_inv) * T = κ₀₁ b₁' := by
    rw [mul_assoc, hT_invT, mul_one]
  obtain ⟨f₁₀_hom, hf₁₀_comp, hf₁₀_C, hf₁₀_X0, hf₁₀_X1⟩ :=
    nodal_lift_pkg b₁' κ₀₁ (κ₀₁ b₁' * T_inv) T hf₁₀_rel
  
  have hp₀_sX0 :
      p₀_hom (mk_nod a_Rz (MvPolynomial.C s₁' * MvPolynomial.X 0)) = u_tilde := by
    change p₀_hom (ι_a s₁' * u₀) = u_tilde
    rw [map_mul p₀_hom, hp₀_C s₁', hp₀_X0]
    calc ι_0 s₁' * (ι_0 t_s * u_tilde)
        = (ι_0 s₁' * ι_0 t_s) * u_tilde := (mul_assoc _ _ _).symm
      _ = ι_0 (s₁' * t_s) * u_tilde := by rw [← map_mul]
      _ = ι_0 1 * u_tilde := by rw [hst]
      _ = u_tilde := by rw [map_one, one_mul]
  have hp₀_X1_eq :
      p₀_hom u₁ = mk_nod π₁' (MvPolynomial.C b₁' * MvPolynomial.X 1) := by
    rw [map_mul]
    exact hp₀_X1
  have hp₁_sX0 :
      p₁_hom (mk_nod a_Rz (MvPolynomial.C s₁' * MvPolynomial.X 0)) =
        mk_nod b₁' (MvPolynomial.C π₁' * MvPolynomial.X 1) := by
    change p₁_hom (ι_a s₁' * u₀) = ι_1 π₁' * u'
    rw [map_mul p₁_hom, hp₁_C s₁', hp₁_X0]
    calc ι_1 s₁' * (ι_1 (t_s * π₁') * u')
        = (ι_1 s₁' * ι_1 (t_s * π₁')) * u' := (mul_assoc _ _ _).symm
      _ = ι_1 (s₁' * (t_s * π₁')) * u' := by rw [← map_mul]
      _ = ι_1 π₁' * u' := by rw [hs₁tπ₁]
  
  have hcomp₀₁ : f₀₁_hom.comp p₀_hom = f₁₀_hom.comp p₁_hom := by
    apply nodalHom_ext a_Rz
    · intro r
      change f₀₁_hom (p₀_hom (ι_a r)) = f₁₀_hom (p₁_hom (ι_a r))
      rw [hp₀_C r, hp₁_C r, hf₀₁_C r, hf₁₀_C r]
    · rw [RingHom.comp_apply, RingHom.comp_apply, hp₀_X0, hp₁_X0,
        map_mul f₀₁_hom, map_mul f₁₀_hom,
        hf₀₁_C t_s, hf₀₁_X0, hf₁₀_C (t_s * π₁'), hf₁₀_X1,
        ← mul_assoc, ← map_mul κ₀₁]
    · rw [RingHom.comp_apply, RingHom.comp_apply, hp₀_X1, hp₁_X1,
        map_mul f₀₁_hom, hf₀₁_C b₁', hf₀₁_X1, hf₁₀_X0]
  have hgen₀ : Subring.closure (Set.range p₀_hom ∪ {π'}) = ⊤ := by
    apply nodal_subring_eq_top π₁'
    · intro r
      exact Subring.subset_closure (Or.inl ⟨ι_a r, hp₀_C r⟩)
    · exact Subring.subset_closure
        (Or.inl ⟨mk_nod a_Rz (MvPolynomial.C s₁' * MvPolynomial.X 0), hp₀_sX0⟩)
    · exact Subring.subset_closure (Or.inr rfl)
  have hgen₁ : Subring.closure (Set.range p₁_hom ∪ {u'}) = ⊤ := by
    apply nodal_subring_eq_top b₁'
    · intro r
      exact Subring.subset_closure (Or.inl ⟨ι_a r, hp₁_C r⟩)
    · exact Subring.subset_closure (Or.inl ⟨u₁, hp₁_X1⟩)
    · exact Subring.subset_closure (Or.inr rfl)
  have hinv₀₁ : f₁₀_hom u' * f₀₁_hom π' = 1 := by
    rw [hf₁₀_X1, hf₀₁_X1, hTT_inv]
  
  have laurent_lift_pkg : ∀ {L : Type u} [CommRing L] (φ₀ : R_z →+* L) (w w_inv : L),
      w * w_inv = 1 →
      ∃ (β : C₀₁ →+* L),
        (∀ r : R_z, β (κ₀₁ r) = φ₀ r) ∧
        β T = w ∧
        β T_inv = w_inv := by
    intro L _ φ₀ w w_inv hww
    let φ_poly : Polynomial R_z →+* L := Polynomial.eval₂RingHom φ₀ w
    have hφ_C : ∀ r : R_z, φ_poly (Polynomial.C r) = φ₀ r := fun r => Polynomial.eval₂_C φ₀ w
    have hφ_X : φ_poly Polynomial.X = w := Polynomial.eval₂_X φ₀ w
    have hφ_unit : φ_poly Polynomial.X * w_inv = 1 := by
      rw [hφ_X, hww]
    obtain ⟨β, hβ_alg, hβ_inv⟩ := away_lift_pkg φ_poly Polynomial.X w_inv hφ_unit
    refine ⟨β, ?_, ?_, hβ_inv⟩
    · intro r
      change β (algebraMap (Polynomial R_z) C₀₁ (Polynomial.C r)) = φ₀ r
      rw [hβ_alg, hφ_C]
    · change β (algebraMap (Polynomial R_z) C₀₁ Polynomial.X) = w
      rw [hβ_alg, hφ_X]
  have laurent_hom_ext : ∀ {g₁ g₂ : C₀₁ →+* C₀₁},
      (∀ r : R_z, g₁ (κ₀₁ r) = g₂ (κ₀₁ r)) →
      g₁ T = g₂ T →
      g₁ = g₂ := by
    intro g₁ g₂ hC hT
    apply IsLocalization.ringHom_ext (Submonoid.powers (Polynomial.X : Polynomial R_z))
    apply Polynomial.ringHom_ext
    · intro r
      exact hC r
    · exact hT
  have hloc₀₁ : @IsLocalization.Away C₀ _ π' C₀₁ _ f₀₁_hom.toAlgebra := by
    have hf₀₁_inv : f₀₁_hom π' * T = 1 := by
      rw [hf₀₁_X1, hT_invT]
    obtain ⟨α₀, hα₀_alg, hα₀_inv⟩ := away_lift_pkg f₀₁_hom π' T hf₀₁_inv
    let L₀ := Localization.Away π'
    let η₀ : C₀ →+* L₀ := algebraMap C₀ L₀
    let inv_π' : L₀ := IsLocalization.Away.invSelf (S := L₀) π'
    have hη₀_inv : inv_π' * η₀ π' = 1 := by
      rw [mul_comm]
      exact IsLocalization.Away.mul_invSelf (S := L₀) π'
    obtain ⟨β₀, hβ₀_C, hβ₀_T, hβ₀_Tinv⟩ :=
      laurent_lift_pkg (η₀.comp ι_0) inv_π' (η₀ π') hη₀_inv
    have hβ₀_f₀₁ : β₀.comp f₀₁_hom = η₀ := by
      apply nodalHom_ext π₁'
      · intro r
        rw [RingHom.comp_apply, hf₀₁_C r, hβ₀_C r, RingHom.comp_apply]
      · rw [RingHom.comp_apply, hf₀₁_X0, map_mul β₀, hβ₀_C π₁', hβ₀_T, RingHom.comp_apply]
        rw [← hu_tilde_π', map_mul η₀, mul_assoc,
          IsLocalization.Away.mul_invSelf (S := L₀) π', mul_one]
      · rw [RingHom.comp_apply, hf₀₁_X1, hβ₀_Tinv]
    have hα₀β₀ : α₀.comp β₀ = RingHom.id C₀₁ := by
      apply laurent_hom_ext
      · intro r
        rw [RingHom.comp_apply, RingHom.id_apply, hβ₀_C r, RingHom.comp_apply,
          hα₀_alg (ι_0 r), hf₀₁_C r]
      · rw [RingHom.comp_apply, RingHom.id_apply, hβ₀_T, hα₀_inv]
    exact isLoc_of_ret π' f₀₁_hom α₀ β₀ hα₀_alg
      (fun x => RingHom.congr_fun hβ₀_f₀₁ x) hα₀β₀
  have hloc₁₀ : @IsLocalization.Away C₁ _ u' C₀₁ _ f₁₀_hom.toAlgebra := by
    have hf₁₀_inv : f₁₀_hom u' * T_inv = 1 := by
      rw [hf₁₀_X1, hTT_inv]
    obtain ⟨α₁, hα₁_alg, hα₁_inv⟩ := away_lift_pkg f₁₀_hom u' T_inv hf₁₀_inv
    let L₁ := Localization.Away u'
    let η₁ : C₁ →+* L₁ := algebraMap C₁ L₁
    let inv_u' : L₁ := IsLocalization.Away.invSelf (S := L₁) u'
    have hη₁_inv : η₁ u' * inv_u' = 1 :=
      IsLocalization.Away.mul_invSelf (S := L₁) u'
    obtain ⟨β₁, hβ₁_C, hβ₁_T, hβ₁_Tinv⟩ :=
      laurent_lift_pkg (η₁.comp ι_1) (η₁ u') inv_u' hη₁_inv
    have hβ₁_f₁₀ : β₁.comp f₁₀_hom = η₁ := by
      apply nodalHom_ext b₁'
      · intro r
        rw [RingHom.comp_apply, hf₁₀_C r, hβ₁_C r, RingHom.comp_apply]
      · rw [RingHom.comp_apply, hf₁₀_X0, map_mul β₁, hβ₁_C b₁', hβ₁_Tinv, RingHom.comp_apply]
        rw [← hv₁u', map_mul η₁, mul_assoc, hη₁_inv, mul_one]
      · rw [RingHom.comp_apply, hf₁₀_X1, hβ₁_T]
    have hα₁β₁ : α₁.comp β₁ = RingHom.id C₀₁ := by
      apply laurent_hom_ext
      · intro r
        rw [RingHom.comp_apply, RingHom.id_apply, hβ₁_C r, RingHom.comp_apply,
          hα₁_alg (ι_1 r), hf₁₀_C r]
      · rw [RingHom.comp_apply, RingHom.id_apply, hβ₁_T, hα₁_alg u', hf₁₀_X1]
    exact isLoc_of_ret u' f₁₀_hom α₁ β₁ hα₁_alg
      (fun x => RingHom.congr_fun hβ₁_f₁₀ x) hα₁β₁
  
  let d₂ : A_loc := ι_a π₁'
  let d₃ : A_loc := ι_a a'_Rz
  have hd₀_mem : ∀ q : PrimeSpectrum C₁, p₁_hom u₀ ∉ q.asIdeal → u' ∉ q.asIdeal := by
    intro q hnot hu'
    apply hnot
    rw [hp₁_X0]
    exact q.asIdeal.mul_mem_left _ hu'
  have hd₁_mem : ∀ q : PrimeSpectrum C₀, p₀_hom u₁ ∉ q.asIdeal → π' ∉ q.asIdeal := by
    intro q hnot hπ'
    apply hnot
    rw [hp₀_X1]
    exact q.asIdeal.mul_mem_left _ hπ'
  have hd₂_mem : ∀ q : PrimeSpectrum C₀, p₀_hom d₂ ∉ q.asIdeal → π' ∉ q.asIdeal := by
    intro q hnot hπ'
    apply hnot
    change p₀_hom ((ι_nod a_Rz) π₁') ∈ q.asIdeal
    rw [hp₀_C π₁', ← hu_tilde_π']
    exact q.asIdeal.mul_mem_left _ hπ'
  have hd₃_mem : ∀ q : PrimeSpectrum C₁, p₁_hom d₃ ∉ q.asIdeal → u' ∉ q.asIdeal := by
    intro q hnot hu'
    apply hnot
    have hp₁_d₃ : p₁_hom d₃ = (ι_1 t_s * v₁) * u' := by
      calc p₁_hom d₃
          = ι_1 a'_Rz := hp₁_C a'_Rz
        _ = ι_1 (t_s * b₁') := by rw [htb₁]
        _ = ι_1 t_s * ι_1 b₁' := map_mul ι_1 t_s b₁'
        _ = ι_1 t_s * (v₁ * u') := by rw [← hv₁u']
        _ = (ι_1 t_s * v₁) * u' := (mul_assoc _ _ _).symm
    rw [hp₁_d₃]
    exact q.asIdeal.mul_mem_left _ hu'
  
  have hd₀_loc :
      @IsLocalization.Away A_loc _ u₀ (Localization.Away (p₀_hom u₀)) _
        ((algebraMap C₀ _).comp p₀_hom).toAlgebra := by
    let L_u₀ := Localization.Away u₀
    let η_A0 : A_loc →+* L_u₀ := algebraMap A_loc L_u₀
    let u₀_inv : L_u₀ := IsLocalization.Away.invSelf (S := L_u₀) u₀
    have hu₀_inv : η_A0 u₀ * u₀_inv = 1 :=
      IsLocalization.Away.mul_invSelf (S := L_u₀) u₀
    have hψ₀_rel :
        η_A0 (ι_a s₁' * u₀) * (η_A0 (ι_a (t_s * π₁')) * u₀_inv) = η_A0 (ι_a π₁') := by
      calc η_A0 (ι_a s₁' * u₀) * (η_A0 (ι_a (t_s * π₁')) * u₀_inv)
          = (η_A0 (ι_a s₁') * η_A0 (ι_a (t_s * π₁'))) * (η_A0 u₀ * u₀_inv) := by
              rw [map_mul η_A0]; ring
        _ = η_A0 (ι_a (s₁' * (t_s * π₁'))) * 1 := by
              rw [← map_mul η_A0, ← map_mul ι_a, hu₀_inv]
