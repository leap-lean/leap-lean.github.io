      AlgebraicGeometry.IsOpenImmersion.isPullback a_res P_1.ι X_1.ι a ha_comm hP1_pre
    have hOuter : CategoryTheory.IsPullback a_res ((b ∣_ W_1) ≫ W_1.ι)
        ((c ∣_ V_1) ≫ V_1.ι) d := by
      rw [AlgebraicGeometry.morphismRestrict_ι b W_1,
        AlgebraicGeometry.morphismRestrict_ι c V_1]
      exact hPb_top.paste_vert hPb
    have hcomm_res : a_res ≫ (c ∣_ V_1) = (b ∣_ W_1) ≫ (d ∣_ V_1) := by
      apply (cancel_mono V_1.ι).mp
      rw [CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι c V_1,
        ← CategoryTheory.Category.assoc, ← ha_comm, CategoryTheory.Category.assoc, hPb.w,
        ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.morphismRestrict_ι b W_1,
        CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        AlgebraicGeometry.morphismRestrict_ι d V_1]
    have hPb_res : CategoryTheory.IsPullback a_res (b ∣_ W_1) (c ∣_ V_1) (d ∣_ V_1) :=
      (CategoryTheory.IsPullback.paste_vert_iff
        (AlgebraicGeometry.isPullback_morphismRestrict d V_1) hcomm_res).mp hOuter
    exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (P := CategoryTheory.MorphismProperty.isomorphisms AlgebraicGeometry.Scheme) hPb_res hIso_c
