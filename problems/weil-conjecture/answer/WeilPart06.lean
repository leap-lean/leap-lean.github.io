    have hα₀_p₀ : α₀.comp p₀ = c_κ0.comp ε_A := by
      apply Polynomial.ringHom_ext
      · intro b
        change α₀ (p₀ (Polynomial.C b)) = c_κ0 (ε_A (Polynomial.C b))
        rw [hp₀_C_app b, hα₀_C b, hε_C_app b]
        rfl
      · change α₀ (p₀ Polynomial.X) = c_κ0 (ε_A Polynomial.X)
        rw [hp₀_X, hε_X]
        dsimp only [x₀_im]
        rw [map_mul α₀, map_add α₀, hα₀_C s_inv, hα₀_u, hα₀_C c, zero_add]
        exact (map_mul c_κ0 (ρ s_inv) (ρ c)).symm
    have hα₁_p₁ : α₁.comp p₁ = c_κ1.comp ε_A := by
      apply Polynomial.ringHom_ext
      · intro b
        change α₁ (p₁ (Polynomial.C b)) = c_κ1 (ε_A (Polynomial.C b))
        rw [hp₁_C_app b, hα₁_C b, hε_C_app b]
      · change α₁ (p₁ Polynomial.X) = c_κ1 (ε_A Polynomial.X)
        rw [hp₁_X, hε_X]
        dsimp only [x₁_im]
        rw [map_mul α₁, map_add α₁, map_mul α₁, hα₁_C s_inv, hα₁_C π, hα₁_t, hα₁_C c,
          hρ_π, map_zero, zero_mul, zero_add]
        exact (map_mul c_κ1 (ρ s_inv) (ρ c)).symm
    refine ⟨α₀, α₁, hα₀_p₀, hα₀_s, hα₁_p₁, hα₁_t, ?_⟩
    intro ψ hψ_c hψ_t
    apply C₀_hom_ext
    · intro b
      change Polynomial.eval 0 (β_br (ι₀ b)) = ψ (α₀ (ι₀ b))
