    · exact ⟨B', instRingB', j, q', Ideal.span {b i}, hOpen_j, hj_q', hPrime_i, hPreim_H,
        instDom_i, hIC_i⟩
  have hProperClosed : ∀ H ∈ irreducibleComponents ↥F, ∀ Z : Set ↥F,
