  have hq0_eq : q_0 = (X_tilde.isoOfEq hPre0.symm).hom ≫ (π ∣_ D 0) ≫
      (hAff 0).isoSpec.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_0.toRingHom) := by
