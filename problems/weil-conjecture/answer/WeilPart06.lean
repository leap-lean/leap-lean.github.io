            have h1 : (1 : Q.Fiber (Localization.AtPrime p_z)) =
                (1 : Q.ResidueField) ⊗ₜ[R_Y] ((u : Localization.AtPrime p_z) * ↑u⁻¹) := by
              rw [Units.mul_inv]; rfl
            rw [h1, hu_eq]
            have h2 : (algebraMap R₁ (Localization.AtPrime p_z) (φ a)) * ↑u⁻¹ =
                a • (↑u⁻¹ : Localization.AtPrime p_z) := by
              rw [Algebra.smul_def]; rfl
            rw [h2, ← TensorProduct.smul_tmul]
            have ha_res : (algebraMap R_Y Q.ResidueField a) = 0 := by
              change algebraMap (R_Y ⧸ Q) Q.ResidueField (Ideal.Quotient.mk Q a) = 0
              rw [Ideal.Quotient.eq_zero_iff_mem.mpr haQ, map_zero]
            have ha_smul : a • (1 : Q.ResidueField) = 0 := by
              rw [Algebra.smul_def, ha_res, zero_mul]
            rw [ha_smul, zero_tmul]
          have hSub : Subsingleton (Q.Fiber (Localization.AtPrime p_z)) :=
            subsingleton_of_zero_eq_one hzero.symm
          exact inferInstance
      have hZMP : Algebra.ZariskisMainProperty R_Y p_z :=
        Algebra.ZariskisMainProperty.of_finiteType p_z
      obtain ⟨r_z, hr_not_pz, hr_int, hr_mul⟩ := Algebra.zariskisMainProperty_iff.mp hZMP
      have hInt_mem : ∀ w : R₁, IsIntegral R_Y w → ∃ c : R_Y, φ c = w := by
        intro w ⟨P_pol, hP_monic, hP_eval⟩
        obtain ⟨k, a, hka⟩ := hBirat w
        let sk : R_Y := s₀ ^ k
        have hsk_eq : φ sk * w = φ a := hka
        have hs_ne : sk ≠ 0 := pow_ne_zero k hs₀_ne
        have hs_mem : sk ∈ nonZeroDivisors R_Y := mem_nonZeroDivisors_of_ne_zero hs_ne
        let K_Y := FractionRing R_Y
        let ξ : K_Y := IsLocalization.mk' K_Y a ⟨sk, hs_mem⟩
        have hξ_mul : algebraMap R_Y K_Y sk * ξ = algebraMap R_Y K_Y a := by
          rw [mul_comm, IsLocalization.mk'_spec]
        let d := P_pol.natDegree
        let num : R_Y := ∑ i ∈ Finset.range (d + 1), P_pol.coeff i * a ^ i * sk ^ (d - i)
        have hφ_num : φ num = φ sk ^ d * Polynomial.eval₂ φ w P_pol := by
          rw [Polynomial.eval₂_eq_sum_range, Finset.mul_sum]
          simp only [num, map_sum, map_mul, map_pow]
          refine Finset.sum_congr rfl fun i hi => ?_
          have hi_le : i ≤ d := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
          have hpow : φ a ^ i = φ sk ^ i * w ^ i := by rw [← mul_pow, hsk_eq]
          calc
            φ (P_pol.coeff i) * φ a ^ i * φ sk ^ (d - i)
                = φ (P_pol.coeff i) * (φ sk ^ i * w ^ i) * φ sk ^ (d - i) := by rw [hpow]
            _ = (φ sk ^ i * φ sk ^ (d - i)) * (φ (P_pol.coeff i) * w ^ i) := by ring
            _ = φ sk ^ d * (φ (P_pol.coeff i) * w ^ i) := by rw [← pow_add, Nat.add_sub_of_le hi_le]
        have hP_eval' : Polynomial.eval₂ φ w P_pol = 0 := hP_eval
        rw [hP_eval', mul_zero] at hφ_num
        have hnum_zero : num = 0 := hInj (hφ_num.trans (map_zero φ).symm)
        have hξ_int : IsIntegral R_Y ξ := by
          refine ⟨P_pol, hP_monic, ?_⟩
          have hscale : algebraMap R_Y K_Y sk ^ d *
              Polynomial.eval₂ (algebraMap R_Y K_Y) ξ P_pol = algebraMap R_Y K_Y num := by
            rw [Polynomial.eval₂_eq_sum_range, Finset.mul_sum]
            simp only [num, map_sum, map_mul, map_pow]
            refine Finset.sum_congr rfl fun i hi => ?_
            have hi_le : i ≤ d := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
            have hpow : algebraMap R_Y K_Y a ^ i = algebraMap R_Y K_Y sk ^ i * ξ ^ i := by
