      · rw [RingHom.comp_apply, hψ₃_X0, hα_alg (ι_a s₁' * u₀)]
        exact congrArg η_C₀' hp₀_sX0
      · rw [RingHom.comp_apply, hψ₃_X1, map_mul α, hα_alg (ι_a t_s * u₁), hα_inv]
        have hp₀_tsu1 : p₀_hom (ι_a t_s * u₁) = p₀_hom d₃ * π' := by
          calc p₀_hom (ι_a t_s * u₁)
              = p₀_hom (ι_a t_s) * p₀_hom u₁ := map_mul p₀_hom _ _
            _ = ι_0 t_s * (ι_0 b₁' * π') := by rw [hp₀_C t_s, hp₀_X1]
            _ = (ι_0 t_s * ι_0 b₁') * π' := (mul_assoc _ _ _).symm
            _ = ι_0 (t_s * b₁') * π' := by rw [← map_mul ι_0]
            _ = ι_0 a'_Rz * π' := by rw [htb₁]
            _ = p₀_hom d₃ * π' := congrArg (· * π') (hp₀_C a'_Rz).symm
        rw [hp₀_tsu1, map_mul η_C₀',
          mul_comm (η_C₀' (p₀_hom d₃)) (η_C₀' π'), mul_assoc,
          IsLocalization.Away.mul_invSelf (S := M₃) (p₀_hom d₃), mul_one]
  
  have hBranch : ∀ (κ : Type u) [CommRing κ] (ρ_P : R_z →+* κ),
      ρ_P π₁' = 0 →
      ρ_P a'_Rz = 0 →
      ∃ (ε_A : A_loc →+* κ)
        (ν₀ σ₀_hom : C₀ →+* Polynomial κ)
        (ν₁ σ₁_hom : C₁ →+* Polynomial κ)
        (τ_br1 τ_br2 : A_loc →+* Polynomial κ),
        ε_A.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) = ρ_P ∧
        ε_A (Ideal.Quotient.mk _ (MvPolynomial.X 0)) = 0 ∧
        ε_A (Ideal.Quotient.mk _ (MvPolynomial.X 1)) = 0 ∧
        ν₀.comp p₀_hom = Polynomial.C.comp ε_A ∧
        ν₀ (Ideal.Quotient.mk _ (MvPolynomial.X 1)) = Polynomial.X ∧
        ν₁.comp p₁_hom = Polynomial.C.comp ε_A ∧
        ν₁ (Ideal.Quotient.mk _ (MvPolynomial.X 1)) = Polynomial.X ∧
        τ_br1.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) = Polynomial.C.comp ρ_P ∧
        τ_br1 (Ideal.Quotient.mk _ (MvPolynomial.X 0)) = Polynomial.X ∧
        (Polynomial.evalRingHom 0).comp τ_br1 = ε_A ∧
        (∀ (D : Type u) [CommRing D] (ι_κ : κ →+* D) (φ_D : A_loc →+* D),
          φ_D.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) = ι_κ.comp ρ_P →
          RingHom.ker τ_br1 ≤ RingHom.ker φ_D →
          (Polynomial.eval₂RingHom ι_κ (φ_D (Ideal.Quotient.mk _ (MvPolynomial.X 0)))).comp
            τ_br1 = φ_D) ∧
        σ₀_hom.comp p₀_hom = τ_br1 ∧
        (Polynomial.evalRingHom 0).comp σ₀_hom = (Polynomial.evalRingHom 0).comp ν₀ ∧
        τ_br2.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) = Polynomial.C.comp ρ_P ∧
        τ_br2 (Ideal.Quotient.mk _ (MvPolynomial.X 1)) = Polynomial.X ∧
        (Polynomial.evalRingHom 0).comp τ_br2 = ε_A ∧
        (∀ (D : Type u) [CommRing D] (ι_κ : κ →+* D) (φ_D : A_loc →+* D),
          φ_D.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) = ι_κ.comp ρ_P →
          RingHom.ker τ_br2 ≤ RingHom.ker φ_D →
          (Polynomial.eval₂RingHom ι_κ (φ_D (Ideal.Quotient.mk _ (MvPolynomial.X 1)))).comp
            τ_br2 = φ_D) ∧
