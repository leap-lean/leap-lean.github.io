        exact not_le_of_gt hP₀_lt hPre
      exact ⟨x₀, x₁, hx₀_V, hx₁_V, hx₁_cl, hx₀_not_cl⟩
    exact ⟨U_sm, hSmU, hMemU, fun y hy => (hSmStalkAndIrred y hy).1,
      fun y hy => (hSmStalkAndIrred y hy).2, hSmSpec⟩

  obtain ⟨U_sm, hSmU, hMemU, hSmStalk, hSmIrred, hSmSpec⟩ := hPartB
  have hNodalFull : ∀ y : ↥Y, y ∉ U_sm →
      ∃ (U' : AlgebraicGeometry.Scheme.{u}) (u₀ : U')
        (e₁ : U' ⟶ Y)
        (e₂ : U' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
