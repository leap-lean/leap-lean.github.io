                (∃ q : ↥V, q ∉ (g_Z.base z₀).asIdeal ∧ γ_bar q * x = 1)) ∧
              (∀ w : ↥Z, w ∈ U₀ → w ∈ closure ({z_Q} : Set ↥Z) → w ∈ Set.range ι_D.base) := by
      intro z₀ hz0_cl hz0_in U₀ hU0 hz0_U
