        (Proj.awayMap_awayToSection 𝒜_N hL₁ (rfl : L₀ * L₁ = L₀ * L₁)) u₀_loc
      have hc₁ := ConcreteCategory.congr_hom
        (Proj.awayMap_awayToSection 𝒜_N hL₀ (mul_comm L₀ L₁ : L₀ * L₁ = L₁ * L₀)) v₀_loc
