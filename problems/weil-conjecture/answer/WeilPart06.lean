        rw [← hmD_z0]
        change ((ι_D ≫ g_Z).base m_D).asIdeal = P₀
        rw [hιD_gZ]
        rfl
      have hker_γDu : RingHom.ker γ_Du = P_s := by
        ext v
        change Ideal.Quotient.mk p_u
          ((AlgebraicGeometry.Spec.preimage (hU0.fromSpec ≫ g_Z)).hom v) = 0 ↔ v ∈ P_s
