        (ι_proj.appLE D_W U_tilde hU_le_DW).hom (t_V a_W b_star)
      have hφ_ftilde : φ_Utilde.hom f_tilde = ⟨f_gen γ_star, hf_γstar_W⟩ := by
        have h_app_eq : ι_proj.appLE D_W U_tilde hU_le_DW ≫ φ_Utilde =
            CommRingCat.ofHom ψ_W_chart := by
          apply AlgebraicGeometry.Spec.map_injective
          apply (cancel_mono (hAff_V a_W).fromSpec).mp
          rw [AlgebraicGeometry.Spec.map_comp, Category.assoc,
            AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec ι_proj (hAff_V a_W) hU_tilde
              hU_le_DW,
            ← Category.assoc, hSpec_φUtilde, hψ_ιproj]
        have h1 := congrArg (fun g => g.hom (t_V a_W b_star)) h_app_eq
        change φ_Utilde.hom f_tilde = ψ_W_chart (t_V a_W b_star) at h1
        rw [h1, hψW_t b_star, hv_W_bstar]
      refine ⟨ψ_tilde, mW, U_tilde, hU_tilde, φ_Utilde, f_tilde, hmW, hjW_ψtilde, hy_Utilde,
        hSpec_φUtilde, ?_⟩
      intro P hP
      have h_pt_eq : (g_Z.base ((ψ_tilde ≫ π_tilde).base mW)).asIdeal =
          (g_Z.base (ψ_Z.base mW)).asIdeal := by
        rw [hψ_πtilde]
      rw [h_pt_eq] at hP
      have h_pre_tilde : (AlgebraicGeometry.Spec.preimage (ψ_tilde ≫ π_tilde ≫ g_Z)).hom = θ_VW := by
        have h_assoc : ψ_tilde ≫ π_tilde ≫ g_Z = ψ_Z ≫ g_Z := by
          rw [← Category.assoc, hψ_πtilde]
        rw [h_assoc]
      rw [h_pre_tilde, hφ_ftilde]
      exact hPoly_γstar P hP

    exact ⟨M_tilde, π_tilde, ι_proj, η_tilde, hComm_proj,
      hInt_Mtilde, hProp_πtilde, hη_πtilde, hFunc_Mtilde, hCl_proj, hValTransfer⟩

  
  have hCoord_Mproj := hCoord_proj ↥V M_proj
  obtain ⟨M_tilde, π_tilde, ι_proj, η_tilde, hComm_proj,
