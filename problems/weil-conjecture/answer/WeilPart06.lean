          RingHom.ker ev = p.asIdeal := by
      intro p hpZ
      have hfp : f ∈ p.asIdeal := hpZ hfI
      have hp_ne : p.asIdeal ≠ ⊥ := fun hbot => hf_ne ((Submodule.mem_bot D).mp (hbot ▸ hfp))
      have : p.asIdeal.IsMaximal := hPrimeMax p.asIdeal hp_ne
      let e_p : κ ≃+* (D ⧸ p.asIdeal) :=
        RingEquiv.ofBijective (algebraMap κ (D ⧸ p.asIdeal)) (hNull p.asIdeal)
      let ev : D →+* κ := e_p.symm.toRingHom.comp (Ideal.Quotient.mk p.asIdeal)
      refine ⟨ev, ?_, ?_⟩
      · ext c
        exact e_p.symm_apply_apply c
      · ext x
        simp only [ev, RingHom.mem_ker, RingHom.comp_apply, RingEquiv.toRingHom_eq_coe,
          RingHom.coe_coe, RingEquiv.map_eq_zero_iff, Ideal.Quotient.eq_zero_iff_mem]
    let J_f : Ideal D := Ideal.span ({f} : Set D)
    let Q_f := D ⧸ J_f
    let mk_f : D →+* Q_f := Ideal.Quotient.mk J_f
    have : IsNoetherianRing Q_f := Ideal.Quotient.isNoetherianRing J_f
    have hAllMin : ∀ q : PrimeSpectrum Q_f, q.asIdeal ∈ minimalPrimes Q_f := by
      intro q
      refine ⟨⟨q.isPrime, bot_le⟩, fun r ⟨hr_prime, _⟩ hr_le => ?_⟩
      have : r.IsPrime := hr_prime
      let P_r : Ideal D := Ideal.comap mk_f r
      let P_q : Ideal D := Ideal.comap mk_f q.asIdeal
      have : P_r.IsPrime := Ideal.IsPrime.comap mk_f
      have : P_q.IsPrime := Ideal.IsPrime.comap mk_f
      have hf_Pr : f ∈ P_r := by
        change mk_f f ∈ r
        rw [Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self f)]
        exact zero_mem r
      have hPr_ne : P_r ≠ ⊥ := fun hbot => hf_ne ((Submodule.mem_bot D).mp (hbot ▸ hf_Pr))
      have : P_r.IsMaximal := hPrimeMax P_r hPr_ne
      have hPr_eq : P_r = P_q := ‹P_r.IsMaximal›.eq_of_le ‹P_q.IsPrime›.ne_top (Ideal.comap_mono hr_le)
      have hmap := congrArg (Ideal.map mk_f) hPr_eq
      rw [Ideal.map_comap_of_surjective mk_f Ideal.Quotient.mk_surjective,
        Ideal.map_comap_of_surjective mk_f Ideal.Quotient.mk_surjective] at hmap
      exact hmap.ge
    have hUniv_fin : (Set.univ : Set (PrimeSpectrum Q_f)).Finite :=
      Set.Finite.of_injOn (f := PrimeSpectrum.asIdeal) (fun q _ => hAllMin q)
        (fun a _ b _ h => PrimeSpectrum.ext h) (minimalPrimes.finite_of_isNoetherianRing Q_f)
    have hRange := range_comap_of_surjective Q_f mk_f Ideal.Quotient.mk_surjective
    rw [Ideal.mk_ker] at hRange
    have hZf_fin : (PrimeSpectrum.zeroLocus ({f} : Set D)).Finite := by
      rw [← PrimeSpectrum.zeroLocus_span, ← hRange, ← Set.image_univ]
      exact hUniv_fin.image _
    exact ⟨hZf_fin.subset (PrimeSpectrum.zeroLocus_anti_mono (Set.singleton_subset_iff.mpr hfI)),
      hev⟩

  let I_nod : Ideal (MvPolynomial (Fin 2) κ) :=
    Ideal.span {MvPolynomial.X (0 : Fin 2) * MvPolynomial.X (1 : Fin 2)}
  let A_nod := MvPolynomial (Fin 2) κ ⧸ I_nod

  have h_s3 : ∀ (B : Type u) [CommRing B] (φ_N : A_nod →+* B),
      φ_N.Etale →
      ∀ (q : Ideal B) [q.IsPrime],
        (∀ i : Fin 2, φ_N (Ideal.Quotient.mk I_nod (MvPolynomial.X i)) ∈ q) →
        ∀ r : B, r ∉ q →
          ¬ ((algebraMap B (Localization.Away r)).comp
            (φ_N.comp ((Ideal.Quotient.mk I_nod).comp MvPolynomial.C))).IsStandardSmoothOfRelativeDimension 1 := by
    intro B _ φ_N hEt_N q _ hOrig r hr hSm
    let C := Localization.Away r
    let θ : κ →+* C :=
      (algebraMap B C).comp (φ_N.comp ((Ideal.Quotient.mk I_nod).comp MvPolynomial.C))
    letI : Algebra κ C := θ.toAlgebra
    have : Algebra.IsStandardSmoothOfRelativeDimension 1 κ C := hSm
    letI : Algebra A_nod B := φ_N.toAlgebra
    have : Algebra.Etale A_nod B := hEt_N
    have : IsScalarTower κ A_nod C := ⟨fun c a x => by
      have hca : c • a = algebraMap κ A_nod c * a := Algebra.smul_def c a
      rw [hca, Algebra.smul_def ((algebraMap κ A_nod) c * a) x, Algebra.smul_def a x, map_mul, mul_assoc]
      congr 1⟩
    have : Algebra.Etale B C := Algebra.Etale.of_isLocalizationAway r
    have : Algebra.Etale A_nod C := Algebra.Etale.comp A_nod B C
    have hDisj : Disjoint (Submonoid.powers r : Set B) (q : Set B) := by
      rw [Set.disjoint_left]
      rintro _ ⟨n, rfl⟩ hmem
      exact hr (‹q.IsPrime›.mem_of_pow_mem n hmem)
    let q_C : Ideal C := Ideal.map (algebraMap B C) q
    have : q_C.IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers r) C q inferInstance hDisj
    have : Nontrivial C := ⟨⟨0, 1, fun h01 => ‹q_C.IsPrime›.ne_top
      (Submodule.eq_top_iff'.mpr fun y => by
        have h1 : (1 : C) ∈ q_C := h01 ▸ q_C.zero_mem
        simpa using q_C.mul_mem_left y h1)⟩⟩
    obtain ⟨m_C, _, hq_le_m⟩ := Ideal.exists_le_maximal q_C ‹q_C.IsPrime›.ne_top
    have : m_C.IsMaximal := ‹_›
    let L := C ⧸ m_C
    letI : Field L := Ideal.Quotient.field m_C
    let π_L : C →+* L := Ideal.Quotient.mk m_C
    letI : Algebra (MvPolynomial (Fin 2) κ) L :=
      (π_L.comp ((algebraMap A_nod C).comp (Ideal.Quotient.mk I_nod))).toAlgebra
    have : IsScalarTower (MvPolynomial (Fin 2) κ) A_nod L := ⟨fun P a y => by
      obtain ⟨c0, rfl⟩ := Ideal.Quotient.mk_surjective y
      have hPa : P • a = Ideal.Quotient.mk I_nod P * a := Algebra.smul_def P a
      rw [hPa]
      change π_L ((Ideal.Quotient.mk I_nod P * a) • c0) =
        π_L (algebraMap A_nod C (Ideal.Quotient.mk I_nod P)) * π_L (a • c0)
      rw [Algebra.smul_def (Ideal.Quotient.mk I_nod P * a) c0, Algebra.smul_def a c0,
        ← map_mul π_L, map_mul (algebraMap A_nod C), mul_assoc]⟩
    have : IsScalarTower κ (MvPolynomial (Fin 2) κ) L := ⟨fun c P y => by
      obtain ⟨c0, rfl⟩ := Ideal.Quotient.mk_surjective y
      have hcP : c • P = MvPolynomial.C c * P := by rw [Algebra.smul_def, MvPolynomial.algebraMap_eq]
      rw [hcP]
      change π_L (algebraMap A_nod C (Ideal.Quotient.mk I_nod (MvPolynomial.C c * P))) * π_L c0 =
        π_L (c • (algebraMap A_nod C (Ideal.Quotient.mk I_nod P) * c0))
      rw [Algebra.smul_def c _, ← map_mul π_L, map_mul (Ideal.Quotient.mk I_nod),
        map_mul (algebraMap A_nod C), mul_assoc]
      congr 2⟩
    have hXi_zero : ∀ i : Fin 2, algebraMap (MvPolynomial (Fin 2) κ) L (MvPolynomial.X i) = 0 := by
      intro i
      have hmem_mC : algebraMap B C (φ_N (Ideal.Quotient.mk I_nod (MvPolynomial.X i))) ∈ m_C :=
        hq_le_m (Ideal.mem_map_of_mem (algebraMap B C) (hOrig i))
      change π_L (algebraMap A_nod C (Ideal.Quotient.mk I_nod (MvPolynomial.X i))) = 0
      rw [IsScalarTower.algebraMap_apply A_nod B C]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr hmem_mC
    have hXi_smul : ∀ (i : Fin 2) (v : L × L), (MvPolynomial.X i : MvPolynomial (Fin 2) κ) • v = 0 := by
      intro i v
      ext <;> simp [Algebra.smul_def, hXi_zero i]
    let D_mv : Derivation κ (MvPolynomial (Fin 2) κ) (L × L) :=
      MvPolynomial.mkDerivation κ ![(1, 0), (0, 1)]
    have hDmv_ker : I_nod.restrictScalars κ ≤ LinearMap.ker D_mv.toLinearMap := by
      intro g hg
      rw [Submodule.restrictScalars_mem] at hg
      obtain ⟨P, rfl⟩ := Ideal.mem_span_singleton'.mp hg
      rw [LinearMap.mem_ker]
      change D_mv (P * (MvPolynomial.X 0 * MvPolynomial.X 1)) = 0
      rw [Derivation.leibniz, Derivation.leibniz]
      have h1 : ((MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) κ)) • D_mv P = 0 := by
        rw [mul_smul, hXi_smul 1, smul_zero]
      rw [hXi_smul 0, hXi_smul 1, add_zero, smul_zero, h1, add_zero]
    have hSmul_mk : ∀ (P : MvPolynomial (Fin 2) κ) (v : L × L),
        Ideal.Quotient.mk I_nod P • v = P • v := by
      intro P ⟨y₁, y₂⟩
      obtain ⟨c₁, rfl⟩ := Ideal.Quotient.mk_surjective y₁
      obtain ⟨c₂, rfl⟩ := Ideal.Quotient.mk_surjective y₂
      ext
      · change π_L (Ideal.Quotient.mk I_nod P • c₁) =
          π_L (algebraMap A_nod C (Ideal.Quotient.mk I_nod P)) * π_L c₁
        rw [Algebra.smul_def (Ideal.Quotient.mk I_nod P) c₁, map_mul]
      · change π_L (Ideal.Quotient.mk I_nod P • c₂) =
          π_L (algebraMap A_nod C (Ideal.Quotient.mk I_nod P)) * π_L c₂
        rw [Algebra.smul_def (Ideal.Quotient.mk I_nod P) c₂, map_mul]
    let f_nod : A_nod →ₗ[κ] (L × L) := Submodule.liftQ (I_nod.restrictScalars κ) D_mv.toLinearMap hDmv_ker
    let D_nod : Derivation κ A_nod (L × L) :=
      { toLinearMap := f_nod
        map_one_eq_zero' := D_mv.map_one_eq_zero
        leibniz' := fun u v => by
          obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective u
          obtain ⟨Q, rfl⟩ := Ideal.Quotient.mk_surjective v
          change D_mv (P * Q) = Ideal.Quotient.mk I_nod P • D_mv Q + Ideal.Quotient.mk I_nod Q • D_mv P
          rw [hSmul_mk P, hSmul_mk Q]
          exact D_mv.leibniz P Q }
    let lam0 : Ω[A_nod⁄κ] →ₗ[A_nod] (L × L) :=
      (KaehlerDifferential.linearMapEquivDerivation κ A_nod).symm D_nod
    let e_et := KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale κ A_nod C
    let Lam : Ω[C⁄κ] →ₗ[C] (L × L) := (LinearMap.liftBaseChange C lam0).comp e_et.symm.toLinearMap
    have hLam_D : ∀ u : A_nod, Lam (KaehlerDifferential.D κ C (algebraMap A_nod C u)) = D_nod u := by
      intro u
      have he : e_et ((1 : C) ⊗ₜ[A_nod] KaehlerDifferential.D κ A_nod u) =
          KaehlerDifferential.D κ C (algebraMap A_nod C u) := by
        rw [KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale_apply,
          KaehlerDifferential.mapBaseChange_tmul, KaehlerDifferential.map_D, one_smul]
      rw [← he]
      simp [Lam, lam0]
    let ω₀ : Ω[C⁄κ] := KaehlerDifferential.D κ C (algebraMap A_nod C (Ideal.Quotient.mk I_nod (MvPolynomial.X 0)))
    let ω₁ : Ω[C⁄κ] := KaehlerDifferential.D κ C (algebraMap A_nod C (Ideal.Quotient.mk I_nod (MvPolynomial.X 1)))
    have hLam0 : Lam ω₀ = (1, 0) := by
      rw [hLam_D]
      exact MvPolynomial.mkDerivation_X κ ![(1, 0), (0, 1)] 0
    have hLam1 : Lam ω₁ = (0, 1) := by
      rw [hLam_D]
      exact MvPolynomial.mkDerivation_X κ ![(1, 0), (0, 1)] 1
    have : Algebra.IsStandardSmooth κ C := Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth 1
    have : Module.Free C Ω[C⁄κ] := Algebra.IsStandardSmooth.free_kaehlerDifferential
    have hRank : Module.rank C Ω[C⁄κ] = 1 :=
      Algebra.IsStandardSmoothOfRelativeDimension.rank_kaehlerDifferential 1
    let b := Module.Free.chooseBasis C Ω[C⁄κ]
    let ι := Module.Free.ChooseBasisIndex C Ω[C⁄κ]
    have hCard : Cardinal.mk ι = 1 := by
      rw [b.mk_eq_rank'', hRank]
    have : Subsingleton ι := Cardinal.le_one_iff_subsingleton.mp (le_of_eq hCard)
    by_cases hne_ι : Nonempty ι
    · obtain ⟨i₀⟩ := hne_ι
      letI : Unique ι := uniqueOfSubsingleton i₀
      have hω0_eq : ω₀ = b.repr ω₀ default • b default := by
        simpa using (b.sum_repr ω₀).symm
      have hω1_eq : ω₁ = b.repr ω₁ default • b default := by
        simpa using (b.sum_repr ω₁).symm
      let c₀ := b.repr ω₀ default
      let c₁ := b.repr ω₁ default
      have h0_smul : c₀ • Lam (b default) = (1, 0) := by rw [← map_smul, ← hω0_eq, hLam0]
      have h1_smul : c₁ • Lam (b default) = (0, 1) := by rw [← map_smul, ← hω1_eq, hLam1]
      have h0_fst : π_L c₀ * (Lam (b default)).1 = 1 := congrArg Prod.fst h0_smul
      have h0_snd : π_L c₀ * (Lam (b default)).2 = 0 := congrArg Prod.snd h0_smul
      have h1_snd : π_L c₁ * (Lam (b default)).2 = 1 := congrArg Prod.snd h1_smul
      have hc₀_ne : π_L c₀ ≠ 0 := fun h0 => by rw [h0, zero_mul] at h0_fst; exact zero_ne_one h0_fst
      have hv2_zero : (Lam (b default)).2 = 0 := (mul_eq_zero.mp h0_snd).resolve_left hc₀_ne
      rw [hv2_zero, mul_zero] at h1_snd
      exact zero_ne_one h1_snd
    · have : IsEmpty ι := not_nonempty_iff.mp hne_ι
      have hω0_zero : ω₀ = 0 := by
        simpa using (b.sum_repr ω₀).symm
      rw [hω0_zero, map_zero] at hLam0
      exact zero_ne_one (congrArg Prod.fst hLam0)

  have h_s4 : ∀ (B : Type u) [CommRing B] (φ_N : A_nod →+* B),
      φ_N.Etale →
      let c_B : κ →+* B := φ_N.comp ((Ideal.Quotient.mk I_nod).comp MvPolynomial.C)
      let a : Fin 2 → B := fun i => φ_N (Ideal.Quotient.mk I_nod (MvPolynomial.X i))
      a 0 * a 1 = 0 ∧
      (Ideal.span {a 0} : Ideal B) ⊓ Ideal.span {a 1} = ⊥ ∧
      (∀ i : Fin 2,
        ∃ β_i : Polynomial κ →+* (B ⧸ Ideal.span {a i}),
          β_i.Etale ∧
          β_i.comp Polynomial.C = (Ideal.Quotient.mk (Ideal.span {a i})).comp c_B) ∧
      ((Ideal.Quotient.mk (Ideal.span ({a 0, a 1} : Set B))).comp c_B).Etale := by
    intro B _ φ_N hEt_N c_B a
    let u : Fin 2 → A_nod := fun i => Ideal.Quotient.mk I_nod (MvPolynomial.X i)
    have hu_mul : u 0 * u 1 = 0 := by
      change Ideal.Quotient.mk I_nod (MvPolynomial.X 0 * MvPolynomial.X 1) = 0
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
    have ha_mul : a 0 * a 1 = 0 := by
      change φ_N (u 0) * φ_N (u 1) = 0
      rw [← map_mul, hu_mul, map_zero]
    let ρ₀_mv : MvPolynomial (Fin 2) κ →ₐ[κ] Polynomial κ :=
      MvPolynomial.aeval (![0, Polynomial.X] : Fin 2 → Polynomial κ)
    have hρ₀_ker : I_nod ≤ RingHom.ker ρ₀_mv.toRingHom := by
      rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
      change ρ₀_mv (MvPolynomial.X 0 * MvPolynomial.X 1) = 0
      simp [ρ₀_mv]
    let ρ₀ : A_nod →ₐ[κ] Polynomial κ := Ideal.Quotient.liftₐ I_nod ρ₀_mv (fun _ hx => hρ₀_ker hx)
    let ρ₁_mv : MvPolynomial (Fin 2) κ →ₐ[κ] Polynomial κ :=
      MvPolynomial.aeval (![Polynomial.X, 0] : Fin 2 → Polynomial κ)
    have hρ₁_ker : I_nod ≤ RingHom.ker ρ₁_mv.toRingHom := by
      rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
      change ρ₁_mv (MvPolynomial.X 0 * MvPolynomial.X 1) = 0
      simp [ρ₁_mv]
    let ρ₁ : A_nod →ₐ[κ] Polynomial κ := Ideal.Quotient.liftₐ I_nod ρ₁_mv (fun _ hx => hρ₁_ker hx)
    let ev₀ : MvPolynomial (Fin 2) κ →ₐ[κ] MvPolynomial (Fin 2) κ :=
      MvPolynomial.aeval (![MvPolynomial.X 0, 0] : Fin 2 → MvPolynomial (Fin 2) κ)
    have hMod : ∀ P : MvPolynomial (Fin 2) κ, MvPolynomial.X 0 * (P - ev₀ P) ∈ I_nod := by
      intro P
      induction P using MvPolynomial.induction_on with
      | C c =>
        have h0 : ev₀ (MvPolynomial.C c) = MvPolynomial.C c := MvPolynomial.aeval_C _ c
        rw [h0, sub_self, mul_zero]
        exact I_nod.zero_mem
      | add p q hp hq =>
        have hEq : MvPolynomial.X 0 * (p + q - ev₀ (p + q)) =
            MvPolynomial.X 0 * (p - ev₀ p) + MvPolynomial.X 0 * (q - ev₀ q) := by
          rw [map_add]; ring
        rw [hEq]
        exact add_mem hp hq
      | mul_X p i hp =>
        fin_cases i
        · change MvPolynomial.X 0 * (p * MvPolynomial.X 0 - ev₀ (p * MvPolynomial.X 0)) ∈ I_nod
          have hEq : MvPolynomial.X 0 * (p * MvPolynomial.X 0 - ev₀ (p * MvPolynomial.X 0)) =
              MvPolynomial.X 0 * (p - ev₀ p) * MvPolynomial.X 0 := by
            simp only [ev₀, map_mul, MvPolynomial.aeval_X, Matrix.cons_val_zero]
            ring
          rw [hEq]
          exact Ideal.mul_mem_right _ _ hp
        · change MvPolynomial.X 0 * (p * MvPolynomial.X 1 - ev₀ (p * MvPolynomial.X 1)) ∈ I_nod
          have hEq : MvPolynomial.X 0 * (p * MvPolynomial.X 1 - ev₀ (p * MvPolynomial.X 1)) =
              p * (MvPolynomial.X 0 * MvPolynomial.X 1) := by
            simp only [ev₀, map_mul, MvPolynomial.aeval_X, Matrix.cons_val_one, Matrix.cons_val_zero, mul_zero, sub_zero]
            ring
          rw [hEq]
          exact Ideal.mul_mem_left _ p (Ideal.subset_span rfl)
    have hInter_nod : (Ideal.span {u 0} : Ideal A_nod) ⊓ Ideal.span {u 1} = ⊥ := by
      rw [eq_bot_iff]
      intro z ⟨hz0, hz1⟩
      obtain ⟨w, rfl⟩ := Ideal.mem_span_singleton.mp hz0
      obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective w
      obtain ⟨w₁, hw₁⟩ := Ideal.mem_span_singleton.mp hz1
      have hρ₁_z : ρ₁ (u 0 * Ideal.Quotient.mk I_nod P) = 0 := by
        rw [hw₁, map_mul]
        have hρ₁_u1 : ρ₁ (u 1) = 0 := by
          change ρ₁_mv (MvPolynomial.X 1) = 0
          simp [ρ₁_mv]
        rw [hρ₁_u1, zero_mul]
      have hρ₁_calc : ρ₁ (u 0 * Ideal.Quotient.mk I_nod P) = Polynomial.X * ρ₁_mv P := by
        rw [map_mul]
        have hρ₁_u0 : ρ₁ (u 0) = Polynomial.X := by
          change ρ₁_mv (MvPolynomial.X 0) = Polynomial.X
          simp [ρ₁_mv]
        rw [hρ₁_u0]
        rfl
      rw [hρ₁_calc] at hρ₁_z
      let ι₀ : Polynomial κ →ₐ[κ] MvPolynomial (Fin 2) κ := Polynomial.aeval (MvPolynomial.X 0)
      have hι₀_comp : ι₀.comp ρ₁_mv = ev₀ := by
        apply MvPolynomial.algHom_ext
        intro i
        fin_cases i <;> simp [ι₀, ρ₁_mv, ev₀]
      have hX0_ev0 : MvPolynomial.X 0 * ev₀ P = 0 := by
        have h1 := congrArg ι₀ hρ₁_z
        rw [map_zero, map_mul, Polynomial.aeval_X] at h1
        change MvPolynomial.X 0 * (ι₀.comp ρ₁_mv) P = 0 at h1
        rw [hι₀_comp] at h1
        exact h1
      have hmem : MvPolynomial.X 0 * P ∈ I_nod := by
        have hm := hMod P
        rw [mul_sub, hX0_ev0, sub_zero] at hm
        exact hm
      change Ideal.Quotient.mk I_nod (MvPolynomial.X 0 * P) ∈ (⊥ : Ideal A_nod)
      rw [Ideal.Quotient.eq_zero_iff_mem.mpr hmem]
      exact zero_mem _
    letI : Algebra A_nod B := φ_N.toAlgebra
    have : Algebra.Etale A_nod B := hEt_N
    let Q₀ := A_nod ⧸ Ideal.span {u 0}
    let Q₁ := A_nod ⧸ Ideal.span {u 1}
    let δ : A_nod →ₗ[A_nod] Q₀ × Q₁ :=
      LinearMap.prod (Submodule.mkQ (Ideal.span {u 0})) (Submodule.mkQ (Ideal.span {u 1}))
    have hδ_inj : Function.Injective δ := by
      rw [← LinearMap.ker_eq_bot, LinearMap.ker_prod, Submodule.ker_mkQ, Submodule.ker_mkQ]
      exact hInter_nod
    have hlt_inj : Function.Injective (LinearMap.lTensor B δ) :=
      Module.Flat.lTensor_preserves_injective_linearMap δ hδ_inj
    have ha_inter : (Ideal.span {a 0} : Ideal B) ⊓ Ideal.span {a 1} = ⊥ := by
      rw [eq_bot_iff]
      intro x ⟨hx0, hx1⟩
      obtain ⟨y₀, hy₀⟩ := Ideal.mem_span_singleton.mp hx0
      obtain ⟨y₁, hy₁⟩ := Ideal.mem_span_singleton.mp hx1
