          _ = η_A2 (u₀ * d₂) * d₂_inv := by rw [ht_s_eq]
          _ = η_A2 u₀ * (η_A2 d₂ * d₂_inv) := by rw [map_mul η_A2, mul_assoc]
          _ = η_A2 u₀ := by rw [hd₂_inv, mul_one]
      · rw [RingHom.comp_apply, hp₁_X1, hψ₂_X0]
    · intro α hα_alg hα_inv
      let M₂ := Localization.Away (p₁_hom d₂)
      let η_C₁' : C₁ →+* M₂ := algebraMap C₁ M₂
      apply nodalHom_ext b₁'
      · intro r
        rw [RingHom.comp_apply, hψ₂_C r, RingHom.comp_apply, hα_alg (ι_a r)]
        exact congrArg η_C₁' (hp₁_C r)
      · rw [RingHom.comp_apply, hψ₂_X0, hα_alg u₁]
        exact congrArg η_C₁' hp₁_X1
      · rw [RingHom.comp_apply, hψ₂_X1, map_mul α, hα_alg (ι_a s₁' * u₀), hα_inv]
        have hp₁_sX0' : η_C₁' (p₁_hom (ι_a s₁' * u₀)) = η_C₁' (p₁_hom d₂ * u') := by
          have h1 : p₁_hom (ι_a s₁' * u₀) = ι_1 π₁' * u' := by
