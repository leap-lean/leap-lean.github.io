      have hU₁_le : U₁ ≤ (TopologicalSpace.Opens.map q₂.base).obj U_Y := hU₁_sub
      let R₁ := ↑(C₁.presheaf.obj (Opposite.op U₁))
      obtain ⟨hDom_R₁, _⟩ := hNorm₁ U₁ hU₁ ⟨⟨z, hz_U₁⟩⟩
      let φ_cat := q₂.appLE U_Y U₁ hU₁_le
      let φ : R_Y →+* R₁ := φ_cat.hom
      have hLFT_q₂ : AlgebraicGeometry.LocallyOfFiniteType q₂ := inferInstance
      have hFT : φ.FiniteType := hLFT_q₂.finiteType_appLE hUY hU₁ hU₁_le
      let p_z_spec : PrimeSpectrum R₁ := hU₁.primeIdealOf ⟨z, hz_U₁⟩
      let p_z : Ideal R₁ := p_z_spec.asIdeal
      have hpz_prime : p_z.IsPrime := p_z_spec.isPrime
      have hcomap_pz : Ideal.comap φ p_z = p_Y := by
        have hspec_eq : PrimeSpectrum.comap φ p_z_spec = p_Y_spec := by
          apply hUY.fromSpec.isOpenEmbedding.injective
          have h1 : hUY.fromSpec.base (PrimeSpectrum.comap φ p_z_spec) =
              (AlgebraicGeometry.Spec.map φ_cat ≫ hUY.fromSpec).base p_z_spec := rfl
          rw [h1, hUY.SpecMap_appLE_fromSpec q₂ hU₁ hU₁_le]
          change q₂.base (hU₁.fromSpec.base p_z_spec) = hUY.fromSpec.base p_Y_spec
          rw [hU₁.fromSpec_primeIdealOf, hUY.fromSpec_primeIdealOf]
          exact hz_eq
        exact congrArg PrimeSpectrum.asIdeal hspec_eq
      have hFinOver : ∀ (Q : Ideal R_Y) [Q.IsPrime], Q ≤ Ideal.comap φ p_z →
          let _ : Algebra R_Y R₁ := φ.toAlgebra
          (Q.primesOver R₁).Finite := by
        intro Q hQ_pr hQ_le
        let _ : Algebra R_Y R₁ := φ.toAlgebra
        rw [hcomap_pz] at hQ_le
        let q_spec : PrimeSpectrum R_Y := ⟨Q, hQ_pr⟩
        have hspec_RY : q_spec ⤳ p_Y_spec := (PrimeSpectrum.le_iff_specializes q_spec p_Y_spec).mp hQ_le
        have hyQ_spec : hUY.fromSpec.base q_spec ⤳ y_gen := by
          have h1 := hspec_RY.map hUY.fromSpec.continuous
          rwa [hUY.fromSpec_primeIdealOf] at h1
        have hFin_yQ := hFinGen (hUY.fromSpec.base q_spec) hyQ_spec
        let f_inj : ↥(Q.primesOver R₁) → ↥(q₂.base ⁻¹' {hUY.fromSpec.base q_spec}) :=
          fun ⟨P₁, hP₁_pr, hP₁_over⟩ =>
            ⟨hU₁.fromSpec.base ⟨P₁, hP₁_pr⟩, by
              change q₂.base (hU₁.fromSpec.base ⟨P₁, hP₁_pr⟩) = hUY.fromSpec.base q_spec
              have h1 : q₂.base (hU₁.fromSpec.base ⟨P₁, hP₁_pr⟩) =
                  (hU₁.fromSpec ≫ q₂).base ⟨P₁, hP₁_pr⟩ := rfl
              rw [h1, ← hUY.SpecMap_appLE_fromSpec q₂ hU₁ hU₁_le]
              change hUY.fromSpec.base (PrimeSpectrum.comap φ ⟨P₁, hP₁_pr⟩) = hUY.fromSpec.base q_spec
