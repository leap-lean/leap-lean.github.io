      intro e _
      rfl
    obtain ⟨E, hE_gen⟩ := hGenB₀
    let _ : Algebra R B₀ := r₀.toAlgebra
    let _ : Algebra R B₁ := r₁.toAlgebra
    let _ : Algebra R B₀₁ := r₀₁.toAlgebra
    have hsmul₀ : ∀ (c : R) (x : B₀), c • x = r₀ c * x := fun _ _ => rfl
    have hsmul₁ : ∀ (c : R) (x : B₁), c • x = r₁ c * x := fun _ _ => rfl
    have hsmul₀₁ : ∀ (c : R) (x : B₀₁), c • x = r₀₁ c * x := fun _ _ => rfl
    have hr₀_app : ∀ c : R, res₀ (r₀ c) = r₀₁ c := fun c => RingHom.congr_fun hr₀ c
    have hr₁_app : ∀ c : R, res₁ (r₁ c) = r₀₁ c := fun c => RingHom.congr_fun hr₁ c
    let δ : (B₀ × B₁) →ₗ[R] B₀₁ :=
      { toFun := fun pair => res₀ pair.1 - res₁ pair.2
        map_add' := fun p₁ p₂ => by simp only [Prod.fst_add, Prod.snd_add, map_add]; ring
        map_smul' := fun c pair => by
          simp only [Prod.smul_fst, Prod.smul_snd, hsmul₀, hsmul₁, hsmul₀₁,
            map_mul, hr₀_app, hr₁_app, RingHom.id_apply]
          ring }
    let I_δ : Submodule R B₀₁ := LinearMap.range δ
    let H1 := B₀₁ ⧸ I_δ
    let q_H1 : B₀₁ →ₗ[R] H1 := Submodule.mkQ I_δ
    choose d_pole g_pole hg_pole using fun e : B₀ => hLoc₁ (res₀ e)
    classical
    let D : ℕ := E.sup d_pole + 1
    let G : Finset H1 :=
      E.biUnion fun e => (Finset.range D).image fun k => q_H1 ((res₁ v) ^ k * res₀ e)
    have hpow_uv : ∀ n : ℕ, (res₀ u) ^ n * (res₁ v) ^ n = 1 := by
      intro n
      rw [← mul_pow, huv, one_pow]
    have hMon_span : ∀ (e : B₀), e ∈ E → ∀ (c : R) (j M : ℕ),
        q_H1 (r₀₁ c * (res₀ u) ^ j * res₀ e * (res₁ v) ^ M) ∈
          Submodule.span R (G : Set H1) := by
      intro e he c j M
      by_cases hMj : M ≤ j
      · have h_eq : r₀₁ c * (res₀ u) ^ j * res₀ e * (res₁ v) ^ M =
            δ (r₀ c * u ^ (j - M) * e, 0) := by
          have hj : (res₀ u) ^ j * (res₁ v) ^ M = (res₀ u) ^ (j - M) := by
            calc
              (res₀ u) ^ j * (res₁ v) ^ M
              _ = (res₀ u) ^ (j - M) * ((res₀ u) ^ M * (res₁ v) ^ M) := by
                  rw [← mul_assoc, ← pow_add, Nat.sub_add_cancel hMj]
              _ = (res₀ u) ^ (j - M) := by rw [hpow_uv M, mul_one]
          calc
            r₀₁ c * (res₀ u) ^ j * res₀ e * (res₁ v) ^ M
            _ = r₀₁ c * ((res₀ u) ^ j * (res₁ v) ^ M) * res₀ e := by ring
            _ = r₀₁ c * (res₀ u) ^ (j - M) * res₀ e := by rw [hj]
            _ = res₀ (r₀ c * u ^ (j - M) * e) - res₁ 0 := by
                simp [map_mul, map_pow, hr₀_app]
            _ = δ (r₀ c * u ^ (j - M) * e, 0) := rfl
        rw [h_eq]
        have hmem_ker : δ (r₀ c * u ^ (j - M) * e, 0) ∈ I_δ := ⟨_, rfl⟩
        have hzero : q_H1 (δ (r₀ c * u ^ (j - M) * e, 0)) = 0 :=
          (Submodule.Quotient.mk_eq_zero I_δ).mpr hmem_ker
        rw [hzero]
        exact Submodule.zero_mem _
      · push Not at hMj
        let k := M - j
        have h_cancel : (res₀ u) ^ j * (res₁ v) ^ M = (res₁ v) ^ k := by
          calc
            (res₀ u) ^ j * (res₁ v) ^ M
            _ = ((res₀ u) ^ j * (res₁ v) ^ j) * (res₁ v) ^ k := by
                rw [mul_assoc, ← pow_add, Nat.add_sub_of_le (Nat.le_of_lt hMj)]
            _ = (res₁ v) ^ k := by rw [hpow_uv j, one_mul]
        have h_term : r₀₁ c * (res₀ u) ^ j * res₀ e * (res₁ v) ^ M =
            c • ((res₁ v) ^ k * res₀ e) := by
          rw [hsmul₀₁]
          calc
            r₀₁ c * (res₀ u) ^ j * res₀ e * (res₁ v) ^ M
            _ = r₀₁ c * (((res₀ u) ^ j * (res₁ v) ^ M) * res₀ e) := by ring
            _ = r₀₁ c * ((res₁ v) ^ k * res₀ e) := by rw [h_cancel]
        by_cases hkD : k < D
        · rw [h_term, map_smul]
          apply Submodule.smul_mem
          apply Submodule.subset_span
          exact Finset.mem_biUnion.mpr ⟨e, he, Finset.mem_image_of_mem _ (Finset.mem_range.mpr hkD)⟩
        · push Not at hkD
          have hde_le : d_pole e ≤ k := by
            have h1 : d_pole e ≤ E.sup d_pole := Finset.le_sup he
            omega
          have h_eq1 : r₀₁ c * (res₀ u) ^ j * res₀ e * (res₁ v) ^ M =
              δ (0, -(r₁ c * v ^ (k - d_pole e) * g_pole e)) := by
            rw [h_term, hsmul₀₁]
            have hv_split : (res₁ v) ^ k * res₀ e =
                (res₁ v) ^ (k - d_pole e) * (res₀ e * (res₁ v) ^ (d_pole e)) := by
              calc
                (res₁ v) ^ k * res₀ e
                _ = ((res₁ v) ^ (k - d_pole e) * (res₁ v) ^ (d_pole e)) * res₀ e := by
                    rw [← pow_add, Nat.sub_add_cancel hde_le]
                _ = (res₁ v) ^ (k - d_pole e) * (res₀ e * (res₁ v) ^ (d_pole e)) := by ring
            rw [hv_split, hg_pole e]
            change r₀₁ c * ((res₁ v) ^ (k - d_pole e) * res₁ (g_pole e)) =
              res₀ 0 - res₁ (-(r₁ c * v ^ (k - d_pole e) * g_pole e))
            simp only [map_zero, map_neg, map_mul, map_pow, hr₁_app, zero_sub, neg_neg]
            ring
          rw [h_eq1]
          have hmem_ker : δ (0, -(r₁ c * v ^ (k - d_pole e) * g_pole e)) ∈ I_δ := ⟨_, rfl⟩
          have hzero : q_H1 (δ (0, -(r₁ c * v ^ (k - d_pole e) * g_pole e))) = 0 :=
            (Submodule.Quotient.mk_eq_zero I_δ).mpr hmem_ker
          rw [hzero]
          exact Submodule.zero_mem _
    have hSpan_H1 : ∀ h : H1, h ∈ Submodule.span R (G : Set H1) := by
      intro h
      obtain ⟨z, rfl⟩ := Submodule.mkQ_surjective I_δ h
      obtain ⟨M, b₀, hb₀⟩ := hLoc₀ z
      have hz_eq : z = res₀ b₀ * (res₁ v) ^ M := by
        calc
          z = z * ((res₀ u) ^ M * (res₁ v) ^ M) := by rw [hpow_uv M, mul_one]
          _ = (z * (res₀ u) ^ M) * (res₁ v) ^ M := by ring
          _ = res₀ b₀ * (res₁ v) ^ M := by rw [hb₀]
      obtain ⟨poly_fn, hp⟩ := hE_gen b₀
      rw [hz_eq, hp, map_sum, Finset.sum_mul, map_sum]
      apply Submodule.sum_mem
      intro e he
      have hterm_sum : res₀ (Polynomial.eval₂ r₀ u (poly_fn e) * e) * (res₁ v) ^ M =
          ∑ j ∈ (poly_fn e).support, r₀₁ ((poly_fn e).coeff j) * (res₀ u) ^ j * res₀ e * (res₁ v) ^ M := by
        rw [Polynomial.eval₂_eq_sum, Polynomial.sum_def, Finset.sum_mul, map_sum, Finset.sum_mul]
        apply Finset.sum_congr rfl
        intro j _
        simp only [map_mul, map_pow, hr₀_app]
      rw [hterm_sum, map_sum]
      apply Submodule.sum_mem
      intro j _
      exact hMon_span e he ((poly_fn e).coeff j) j M
    have hTors_finset : ∀ (S : Finset H1),
        ∃ d : R, d ≠ 0 ∧ ∀ h ∈ Submodule.span R (S : Set H1),
          ∀ c : R, c ≠ 0 → c • h = 0 → d • h = 0 := by
      intro S
      induction S using Finset.induction with
      | empty =>
        refine ⟨1, one_ne_zero, fun h hh _ _ _ => ?_⟩
        simp only [Finset.coe_empty, Submodule.span_empty, Submodule.mem_bot] at hh
        rw [hh, smul_zero]
      | insert x S' _ ih =>
        obtain ⟨d', hd'_ne, hd'⟩ := ih
        let N' : Submodule R H1 := Submodule.span R (S' : Set H1)
        by_cases hdep : ∃ s : R, s ≠ 0 ∧ s • x ∈ N'
        · obtain ⟨s, hs_ne, hsx⟩ := hdep
          refine ⟨d' * s, mul_ne_zero hd'_ne hs_ne, fun h hh c hc hch => ?_⟩
          rw [Finset.coe_insert, Submodule.mem_span_insert] at hh
          obtain ⟨r, h', hh', rfl⟩ := hh
          have hsh_mem : s • (r • x + h') ∈ N' := by
            rw [smul_add, smul_comm s r x]
            exact N'.add_mem (N'.smul_mem r hsx) (N'.smul_mem s hh')
          have hc_sh : c • (s • (r • x + h')) = 0 := by
            rw [smul_comm c s, hch, smul_zero]
          rw [mul_smul]
          exact hd' _ hsh_mem c hc hc_sh
        · refine ⟨d', hd'_ne, fun h hh c hc hch => ?_⟩
          rw [Finset.coe_insert, Submodule.mem_span_insert] at hh
          obtain ⟨r, h', hh', rfl⟩ := hh
          have hr0 : r = 0 := by
            by_contra hr_ne
            apply hdep
            refine ⟨c * r, mul_ne_zero hc hr_ne, ?_⟩
            rw [smul_add, ← mul_smul] at hch
            have hcrx : (c * r) • x = -(c • h') := eq_neg_of_add_eq_zero_left hch
            rw [hcrx]
            exact N'.neg_mem (N'.smul_mem c hh')
          rw [hr0, zero_smul, zero_add]
          exact hd' h' hh' c hc (by simpa [hr0] using hch)
    obtain ⟨d₀, hd₀_ne, hd₀_ann⟩ := hTors_finset G
    have hd₀_H1 : ∀ (h : H1) (c : R), c ≠ 0 → c • h = 0 → d₀ • h = 0 :=
      fun h c hc hch => hd₀_ann h (hSpan_H1 h) c hc hch
    have hMap_mem : ∀ {B : Type u} [CommRing B] (ρ : R →+* B) {y : B},
        y ∈ Ideal.map ρ 𝔪_R → ∃ m ∈ 𝔪_R, ∃ b : B, y = ρ m * b := by
      intro B _ ρ y hy
      refine Submodule.span_induction ?_ ?_ ?_ ?_ hy
      · rintro _ ⟨m, hm, rfl⟩
        exact ⟨m, hm, 1, (mul_one _).symm⟩
      · exact ⟨0, 𝔪_R.zero_mem, 0, by simp⟩
      · rintro _ _ _ _ ⟨m₁, hm₁, b₁, rfl⟩ ⟨m₂, hm₂, b₂, rfl⟩
        rcases ValuationRing.dvd_total m₁ m₂ with ⟨q, rfl⟩ | ⟨q, rfl⟩
        · exact ⟨m₁, hm₁, b₁ + ρ q * b₂, by rw [map_mul]; ring⟩
        · exact ⟨m₂, hm₂, ρ q * b₁ + b₂, by rw [map_mul]; ring⟩
      · rintro a _ _ ⟨m, hm, b, rfl⟩
        exact ⟨m, hm, a * b, by simp only [smul_eq_mul]; ring⟩
    obtain ⟨m₀, hm₀, b₀_def, hx₀_eq⟩ := hMap_mem r₀ hx₀
    obtain ⟨m₁, hm₁, b₁_def, hx₁_eq⟩ := hMap_mem r₁ hx₁
    obtain ⟨m₀₁, hm₀₁, b₀₁_def, hx₀₁_eq⟩ := hMap_mem r₀₁ hx₀₁
    obtain ⟨m_star, hm_star, hm_star_ne⟩ := (Submodule.ne_bot_iff 𝔪_R).mp hMaxNeBot
    have hdvd_pair : ∀ (a b : R), a ∈ 𝔪_R → a ≠ 0 → b ∈ 𝔪_R →
        ∃ w ∈ 𝔪_R, w ≠ 0 ∧ w ∣ a ∧ w ∣ b := by
      intro a b ha ha_ne hb
      rcases ValuationRing.dvd_total a b with hab | hba
      · exact ⟨a, ha, ha_ne, dvd_refl a, hab⟩
      · refine ⟨b, hb, ?_, hba, dvd_refl b⟩
        rintro rfl
        exact ha_ne (zero_dvd_iff.mp hba)
    obtain ⟨w₁, hw₁, hw₁_ne, _, hw₁_m₀⟩ := hdvd_pair m_star m₀ hm_star hm_star_ne hm₀
    obtain ⟨w₂, hw₂, hw₂_ne, hw₂_w₁, hw₂_m₁⟩ := hdvd_pair w₁ m₁ hw₁ hw₁_ne hm₁
    obtain ⟨ϖ₀, hϖ₀_mem, hϖ₀_ne, hϖ₀_w₂, hϖ₀_m₀₁⟩ := hdvd_pair w₂ m₀₁ hw₂ hw₂_ne hm₀₁
    obtain ⟨q₀, rfl⟩ := dvd_trans hϖ₀_w₂ (dvd_trans hw₂_w₁ hw₁_m₀)
    obtain ⟨q₁, rfl⟩ := dvd_trans hϖ₀_w₂ hw₂_m₁
    obtain ⟨q₀₁, rfl⟩ := hϖ₀_m₀₁
    let c₀ : B₀ := r₀ q₀ * b₀_def
    let c₁ : B₁ := r₁ q₁ * b₁_def
    let z₀ : B₀₁ := r₀₁ q₀₁ * b₀₁_def
    have hc₀ : x₀ ^ 2 - x₀ = r₀ ϖ₀ * c₀ := by rw [hx₀_eq, map_mul]; ring
    have hc₁ : x₁ ^ 2 - x₁ = r₁ ϖ₀ * c₁ := by rw [hx₁_eq, map_mul]; ring
    have hz₀ : res₀ x₀ - res₁ x₁ = r₀₁ ϖ₀ * z₀ := by rw [hx₀₁_eq, map_mul]; ring
    have hϖd_ne : ϖ₀ * d₀ ≠ 0 := mul_ne_zero hϖ₀_ne hd₀_ne
    let I_star : Ideal R := Ideal.span {ϖ₀ * d₀}
    have hϖ₀_rad : ϖ₀ ∈ I_star.radical := by
      rw [Ideal.radical_eq_sInf, Ideal.mem_sInf]
      rintro P ⟨hI_le, hP_prime⟩
      rcases @hHtOne P hP_prime with rfl | rfl
      · exfalso
        have hmem : ϖ₀ * d₀ ∈ (⊥ : Ideal R) := hI_le (Ideal.subset_span (Set.mem_singleton _))
        exact hϖd_ne hmem
      · exact hϖ₀_mem
    obtain ⟨k, hk_mem⟩ := Ideal.mem_radical_iff.mp hϖ₀_rad
    have hk_pow : ϖ₀ ^ (2 ^ k) ∈ I_star := by
      have hle : k ≤ 2 ^ k := Nat.le_of_lt Nat.lt_two_pow_self
      have hsplit : ϖ₀ ^ (2 ^ k) = ϖ₀ ^ k * ϖ₀ ^ (2 ^ k - k) := by
        rw [← pow_add, Nat.add_sub_of_le hle]
      rw [hsplit]
      exact I_star.mul_mem_right _ hk_mem
    obtain ⟨s₀, hs₀⟩ := Ideal.mem_span_singleton.mp hk_pow
    have hNewton : ∀ t : ℕ, ∃ (e₀ : B₀) (e₁ : B₁) (u₀' c₀' : B₀) (u₁' c₁' : B₁) (z_t : B₀₁),
        e₀ - x₀ = r₀ ϖ₀ * u₀' ∧
        e₁ - x₁ = r₁ ϖ₀ * u₁' ∧
        e₀ ^ 2 - e₀ = r₀ (ϖ₀ ^ (2 ^ t)) * c₀' ∧
        e₁ ^ 2 - e₁ = r₁ (ϖ₀ ^ (2 ^ t)) * c₁' ∧
        res₀ e₀ - res₁ e₁ = r₀₁ (ϖ₀ ^ (2 ^ t)) * z_t := by
      intro t
      induction t with
      | zero =>
        refine ⟨x₀, x₁, 0, c₀, 0, c₁, z₀, ?_, ?_, ?_, ?_, ?_⟩
        · simp
        · simp
        · simpa using hc₀
        · simpa using hc₁
        · simpa using hz₀
      | succ t ih =>
        obtain ⟨e₀, e₁, u₀', c₀', u₁', c₁', z_t, hu₀', hu₁', hc₀', hc₁', hz_t⟩ := ih
        let e₀_next : B₀ := 3 * e₀ ^ 2 - 2 * e₀ ^ 3
        let e₁_next : B₁ := 3 * e₁ ^ 2 - 2 * e₁ ^ 3
        have hpow_ge1 : 1 ≤ 2 ^ t := Nat.one_le_two_pow
        have hϖ_split : ϖ₀ ^ (2 ^ t) = ϖ₀ * ϖ₀ ^ (2 ^ t - 1) := by
          conv_lhs => rw [← Nat.add_sub_of_le hpow_ge1, pow_add, pow_one]
        have hϖ_sq : ϖ₀ ^ (2 ^ (t + 1)) = (ϖ₀ ^ (2 ^ t)) ^ 2 := by
          rw [pow_succ, mul_two, pow_add, sq]
        refine ⟨e₀_next, e₁_next,
          r₀ (ϖ₀ ^ (2 ^ t - 1)) * c₀' * (1 - 2 * e₀) + u₀',
          c₀' ^ 2 * (4 * e₀ ^ 2 - 4 * e₀ - 3),
          r₁ (ϖ₀ ^ (2 ^ t - 1)) * c₁' * (1 - 2 * e₁) + u₁',
          c₁' ^ 2 * (4 * e₁ ^ 2 - 4 * e₁ - 3),
          -6 * z_t * res₀ c₀' + z_t ^ 2 * (6 * res₀ e₀ - 3 - 2 * (res₀ e₀ - res₁ e₁)),
          ?_, ?_, ?_, ?_, ?_⟩
        · have hid : e₀_next - x₀ = (e₀ ^ 2 - e₀) * (1 - 2 * e₀) + (e₀ - x₀) := by
            dsimp only [e₀_next]; ring
          rw [hid, hc₀', hu₀', hϖ_split, map_mul]
          ring
        · have hid : e₁_next - x₁ = (e₁ ^ 2 - e₁) * (1 - 2 * e₁) + (e₁ - x₁) := by
            dsimp only [e₁_next]; ring
          rw [hid, hc₁', hu₁', hϖ_split, map_mul]
          ring
        · have hid : e₀_next ^ 2 - e₀_next = (e₀ ^ 2 - e₀) ^ 2 * (4 * e₀ ^ 2 - 4 * e₀ - 3) := by
            dsimp only [e₀_next]; ring
          rw [hid, hc₀', hϖ_sq]
          simp only [map_pow]
          ring
        · have hid : e₁_next ^ 2 - e₁_next = (e₁ ^ 2 - e₁) ^ 2 * (4 * e₁ ^ 2 - 4 * e₁ - 3) := by
            dsimp only [e₁_next]; ring
          rw [hid, hc₁', hϖ_sq]
          simp only [map_pow]
          ring
        · have hid : res₀ e₀_next - res₁ e₁_next =
              -6 * (res₀ e₀ - res₁ e₁) * res₀ (e₀ ^ 2 - e₀) +
              (res₀ e₀ - res₁ e₁) ^ 2 * (6 * res₀ e₀ - 3 - 2 * (res₀ e₀ - res₁ e₁)) := by
            dsimp only [e₀_next, e₁_next]
            simp only [map_sub, map_mul, map_pow, map_ofNat]
            ring
          have hres_c₀ : res₀ (e₀ ^ 2 - e₀) = r₀₁ (ϖ₀ ^ (2 ^ t)) * res₀ c₀' := by
            rw [hc₀', map_mul]
            simp only [map_pow, hr₀_app]
          rw [hid, hres_c₀, hz_t, hϖ_sq]
          simp only [map_pow]
          ring
    obtain ⟨e₀, e₁, u₀', _, u₁', _, z_k, hu₀', hu₁', _, _, hz_k⟩ := hNewton k
    have h_ann_z : (ϖ₀ * d₀) • q_H1 (r₀₁ s₀ * z_k) = 0 := by
      rw [← map_smul, hsmul₀₁, ← mul_assoc, ← map_mul, ← hs₀, ← hz_k]
      have hmem : res₀ e₀ - res₁ e₁ ∈ I_δ := ⟨(e₀, e₁), rfl⟩
      exact (Submodule.Quotient.mk_eq_zero I_δ).mpr hmem
    have hd₀_z : d₀ • q_H1 (r₀₁ s₀ * z_k) = 0 :=
      hd₀_H1 (q_H1 (r₀₁ s₀ * z_k)) (ϖ₀ * d₀) hϖd_ne h_ann_z
    rw [← map_smul] at hd₀_z
    obtain ⟨⟨a₀, a₁⟩, ha₀₁⟩ := (Submodule.Quotient.mk_eq_zero I_δ).mp hd₀_z
    have hcocycle_zero : res₀ (e₀ - r₀ ϖ₀ * a₀) = res₁ (e₁ - r₁ ϖ₀ * a₁) := by
      have hmul := congrArg (r₀₁ ϖ₀ * ·) ha₀₁
      dsimp only [δ, LinearMap.coe_mk, AddHom.coe_mk] at hmul
      rw [hsmul₀₁] at hmul
      have hrhs : r₀₁ ϖ₀ * (r₀₁ d₀ * (r₀₁ s₀ * z_k)) = res₀ e₀ - res₁ e₁ := by
        rw [hz_k, hs₀, map_mul, map_mul]
        ring
      rw [hrhs] at hmul
      have hlhs : r₀₁ ϖ₀ * (res₀ a₀ - res₁ a₁) = res₀ (r₀ ϖ₀ * a₀) - res₁ (r₁ ϖ₀ * a₁) := by
        simp only [map_mul, hr₀_app, hr₁_app]; ring
      rw [hlhs] at hmul
      rw [map_sub, map_sub]
      linear_combination -hmul
    obtain ⟨r, hr_a₀, hr_a₁⟩ := hGlued (e₀ - r₀ ϖ₀ * a₀) (e₁ - r₁ ϖ₀ * a₁) hcocycle_zero
    have hx₀_mod : x₀ - r₀ r ∈ Ideal.map r₀ 𝔪_R := by
      have heq : x₀ - r₀ r = r₀ ϖ₀ * (a₀ - u₀') := by
        linear_combination -hu₀' - hr_a₀
      rw [heq]
      exact (Ideal.map r₀ 𝔪_R).mul_mem_right _ (Ideal.mem_map_of_mem r₀ hϖ₀_mem)
