    refine comp_away_isLocalization p₁_hom d₂ ψ₂ ?_ ?_
    · apply nodalHom_ext a_Rz
      · intro r
        rw [RingHom.comp_apply, hp₁_C r, hψ₂_C r, RingHom.comp_apply]
      · rw [RingHom.comp_apply, hp₁_X0, map_mul ψ₂, hψ₂_C (t_s * π₁'), hψ₂_X1,
          RingHom.comp_apply]
        have ht_s_eq : ι_a (t_s * π₁') * (ι_a s₁' * u₀) = u₀ * d₂ := by
          calc ι_a (t_s * π₁') * (ι_a s₁' * u₀)
              = (ι_a t_s * ι_a π₁') * (ι_a s₁' * u₀) := by rw [map_mul ι_a]
            _ = (ι_a t_s * ι_a s₁') * u₀ * ι_a π₁' := by ring
            _ = ι_a (t_s * s₁') * u₀ * d₂ := by rw [← map_mul ι_a]
            _ = u₀ * d₂ := by rw [hts, map_one, one_mul]
        calc η_A2 (ι_a (t_s * π₁')) * (η_A2 (ι_a s₁' * u₀) * d₂_inv)
