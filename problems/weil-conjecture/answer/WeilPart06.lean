  let Φ₀ : MvPolynomial (Fin 2) k₀ →+* Polynomial k₀ :=
    MvPolynomial.eval₂Hom Polynomial.C (fun i : Fin 2 => if i = 0 then Polynomial.X else 0)
  let Φ₁ : MvPolynomial (Fin 2) k₀ →+* Polynomial k₀ :=
    MvPolynomial.eval₂Hom Polynomial.C (fun i : Fin 2 => if i = 0 then 0 else Polynomial.X)
  let Φ_nd : MvPolynomial (Fin 2) k₀ →+* k₀ :=
    MvPolynomial.eval₂Hom (RingHom.id k₀) (fun _ : Fin 2 => 0)
  have hR₀_inf : (Ideal.span {Xbar₁} : Ideal R₀) ⊓ Ideal.span {Xbar₀} = ⊥ := by
    rw [eq_bot_iff]
    intro r hr
    obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective r
    rcases hr with ⟨hr₁, hr₀⟩
    change Ideal.Quotient.mk I₀ P ∈ Ideal.span {Xbar₁} at hr₁
    change Ideal.Quotient.mk I₀ P ∈ Ideal.span {Xbar₀} at hr₀
    rw [Ideal.mem_span_singleton] at hr₁ hr₀
    obtain ⟨u₁, hu₁⟩ := hr₁
    obtain ⟨A₁_p, rfl⟩ := Ideal.Quotient.mk_surjective u₁
    obtain ⟨u₀, hu₀⟩ := hr₀
    obtain ⟨A₀_p, rfl⟩ := Ideal.Quotient.mk_surjective u₀
    have hP₁ : P - MvPolynomial.X 1 * A₁_p ∈ I₀ :=
      Ideal.Quotient.eq.mp hu₁
    have hP₀ : P - MvPolynomial.X 0 * A₀_p ∈ I₀ :=
