            · change MvPolynomial.C (F.coeff d) * (MvPolynomial.X 0 ^ d 0 * MvPolynomial.X 1 ^ d 1) =
                MvPolynomial.C (F.coeff d) * MvPolynomial.X 1 ^ d 1 * MvPolynomial.X 0 ^ d 0
              ring
            · exact absurd rfl hab
          have hφ_mon : φ_a (dehomog (MvPolynomial.monomial d (F.coeff d))) =
