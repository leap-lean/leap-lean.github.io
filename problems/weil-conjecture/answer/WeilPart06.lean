    have : P_bot.IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers h) D p_bot inferInstance hDisj_pbot
    have : IsReduced D := instIsReducedLocalization (Submonoid.powers h)
    have hPbot_le_all : ∀ (Q : Ideal D), Q.IsPrime → P_bot ≤ Q := by
      intro Q hQ
      let Q_B : Ideal B := Ideal.comap ψ Q
      have : Q_B.IsPrime := Ideal.IsPrime.comap ψ
      have hh_not_QB : h ∉ Q_B := by
        intro hhQ
        have hUnit : IsUnit (ψ h) := IsLocalization.Away.algebraMap_isUnit h
