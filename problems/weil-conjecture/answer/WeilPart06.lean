        (fun m => ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫ m).hom c)
        h_app_map
    rw [← hc_loc] at hd₀_q hd₁_q
    obtain ⟨a₁, ha₁⟩ := hColon c d₀ d₁ a₀ N hd₀_q hd₁_q hd₀_eq hd₁_eq
    exact ⟨W₁, hW₁_le0, hy₀W₁, a₁, hS2_pkg.2 a₁ ha₁⟩
  
  have hPartSubSm : ∀ a : Fin (L_comp + 1), U_part a ≤ U_sm := by
    intro a z hz
    change z ∈ (U_sm : Set ↥Y)
    have hmem : z ∈ (U_part a : Set ↥Y) := hz
    rw [(hComp a).2.2.2.2.1] at hmem
    exact hmem.2
  exact weil_open_affineness_and_k0T_finiteness_of_nodeConstant_descent k₀ Y p_Y hPropY
    U_sm hSingFin hSingClosed L_comp U_part hPartSubSm Y_tilde ι_tilde hSurjAll
    (fun a => (hComp a).2.2.1) U_Y0 hSingIn0 hAffTilde0 hInj0 hDescend
    f_tilde hVanish hFinTilde0

theorem weil_projLine_polar_gluing_and_twoChart_isFinite (k₀ : Type u) [Field k₀]
    (Y : AlgebraicGeometry.Scheme.{u})
    (p_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of k₀))
    (r_pts k₁ L_comp : ℕ)
    (hk₁ : 1 ≤ k₁)
    (σ_bar : Fin (r_pts + 1) → (AlgebraicGeometry.Spec (CommRingCat.of k₀) ⟶ Y))
    (hSec : ∀ i : Fin (r_pts + 1), σ_bar i ≫ p_Y = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k₀)))
    (hInj : Function.Injective (fun i : Fin (r_pts + 1) => (σ_bar i).base (⊥ : PrimeSpectrum k₀)))
    (hSm : ∀ i : Fin (r_pts + 1), ∃ V_sm : Y.Opens,
      (σ_bar i).base (⊥ : PrimeSpectrum k₀) ∈ V_sm ∧
      AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ p_Y))
    (hHit : ∀ E ∈ irreducibleComponents ↥Y,
      ∃ i : Fin (r_pts + 1), (σ_bar i).base (⊥ : PrimeSpectrum k₀) ∈ E)
    (U_Y0 : Y.Opens)
    (hUY0_set : (U_Y0 : Set ↥Y) = (⋃ i : Fin (r_pts + 1), Set.range (σ_bar i).base)ᶜ)
    (hAff0 : AlgebraicGeometry.IsAffineOpen U_Y0)
    (f_bar : ↑(Y.presheaf.obj (Opposite.op U_Y0)))
    (hFin0 : (Polynomial.eval₂RingHom
      (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
        p_Y.appLE ⊤ U_Y0 le_top).hom) f_bar).Finite)
    (W_bar : Fin (r_pts + 1) → Y.Opens)
    (t_bar u_bar : ∀ i : Fin (r_pts + 1), ↑(Y.presheaf.obj (Opposite.op (W_bar i))))
    (hW : ∀ i : Fin (r_pts + 1),
      AlgebraicGeometry.IsAffineOpen (W_bar i) ∧
      (σ_bar i).base (⊥ : PrimeSpectrum k₀) ∈ W_bar i ∧
      IsUnit (u_bar i) ∧
      W_bar i ⊓ U_Y0 = Y.basicOpen (t_bar i) ∧
      (∃ hσ_le : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of k₀)).Opens) ≤
          (TopologicalSpace.Opens.map (σ_bar i).base).obj (W_bar i),
        RingHom.ker (((σ_bar i).appLE (W_bar i) ⊤ hσ_le).hom) = Ideal.span {t_bar i}) ∧
      (∀ hB_le0 : Y.basicOpen (t_bar i) ≤ U_Y0,
        (Y.presheaf.map (CategoryTheory.homOfLE hB_le0).op).hom f_bar *
          (Y.presheaf.map (CategoryTheory.homOfLE
            (Y.basicOpen_le (t_bar i))).op).hom (u_bar i * (t_bar i) ^ k₁) = 1))
    (U_1_comp : Fin (L_comp + 1) → Y.Opens)
    (s_1_comp : ∀ a : Fin (L_comp + 1), ↑(Y.presheaf.obj (Opposite.op (U_1_comp a))))
    (hDisj1 : _root_.Pairwise fun a b : Fin (L_comp + 1) => Disjoint (U_1_comp a) (U_1_comp b))
    (hCov1 : (⨆ a : Fin (L_comp + 1), U_1_comp a) =
      Y.basicOpen f_bar ⊔ ⨆ i : Fin (r_pts + 1), W_bar i)
    (hAffFin1 : ∀ a : Fin (L_comp + 1),
      AlgebraicGeometry.IsAffineOpen (U_1_comp a) ∧
      (Polynomial.eval₂RingHom
        (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
          p_Y.appLE ⊤ (U_1_comp a) le_top).hom) (s_1_comp a)).Finite ∧
      (∀ h_inter : Y.basicOpen f_bar ⊓ U_1_comp a ≤ U_Y0,
        (Y.presheaf.map (CategoryTheory.homOfLE h_inter).op).hom f_bar *
          (Y.presheaf.map (CategoryTheory.homOfLE
            (inf_le_right : Y.basicOpen f_bar ⊓ U_1_comp a ≤ U_1_comp a)).op).hom (s_1_comp a) = 1))
    (hW_in1 : ∀ i : Fin (r_pts + 1), ∃ (a : Fin (L_comp + 1)) (hW_le1 : W_bar i ≤ U_1_comp a),
      (Y.presheaf.map (CategoryTheory.homOfLE hW_le1).op).hom (s_1_comp a) =
        u_bar i * (t_bar i) ^ k₁) :
    ∃ (π_bar : Y ⟶ (weilProjectiveSpaceOver k₀ 1).left),
      IsClosedFiberPolarProjLineMap k₀ p_Y r_pts k₁ σ_bar π_bar :=
by
  
  
  
  let U_Y1 : Y.Opens := ⨆ a : Fin (L_comp + 1), U_1_comp a
  let res1 : ∀ a : Fin (L_comp + 1),
      ↑(Y.presheaf.obj (Opposite.op U_Y1)) →+* ↑(Y.presheaf.obj (Opposite.op (U_1_comp a))) :=
    fun a => (Y.presheaf.map (CategoryTheory.homOfLE (le_iSup U_1_comp a)).op).hom
  let Φ₁ : ↑(Y.presheaf.obj (Opposite.op U_Y1)) →+*
      (∀ a : Fin (L_comp + 1), ↑(Y.presheaf.obj (Opposite.op (U_1_comp a)))) :=
    RingHom.pi res1
  have hGlue1 : ∀ x : (∀ a : Fin (L_comp + 1), ↑(Y.presheaf.obj (Opposite.op (U_1_comp a)))),
      ∃! s : ↑(Y.presheaf.obj (Opposite.op U_Y1)), ∀ a : Fin (L_comp + 1), res1 a s = x a := by
    intro x
    have hCompat : TopCat.Presheaf.IsCompatible Y.presheaf U_1_comp x := by
      intro a b
      by_cases hab : a = b
      · subst hab; rfl
      · have hbot : U_1_comp a ⊓ U_1_comp b = ⊥ := (hDisj1 hab).eq_bot
        have : Subsingleton ↑(Y.presheaf.obj (Opposite.op (U_1_comp a ⊓ U_1_comp b))) := by
          rw [hbot]; infer_instance
        exact Subsingleton.elim _ _
    exact Y.sheaf.existsUnique_gluing' U_1_comp U_Y1
      (fun a => CategoryTheory.homOfLE (le_iSup U_1_comp a)) le_rfl x hCompat
  have hBijΦ₁ : Function.Bijective Φ₁ := by
    refine ⟨?_, ?_⟩
    · intro s₁ s₂ hs
      obtain ⟨s₀, _, huniq⟩ := hGlue1 (Φ₁ s₂)
      exact (huniq s₁ (fun a => congrFun hs a)).trans (huniq s₂ (fun _ => rfl)).symm
    · intro x
      obtain ⟨s, hs, _⟩ := hGlue1 x
      exact ⟨s, funext hs⟩
  let e_prod : ↑(Y.presheaf.obj (Opposite.op U_Y1)) ≃+*
      (∀ a : Fin (L_comp + 1), ↑(Y.presheaf.obj (Opposite.op (U_1_comp a)))) :=
    RingEquiv.ofBijective Φ₁ hBijΦ₁
  have he_symm : ∀ (x : ∀ a : Fin (L_comp + 1), ↑(Y.presheaf.obj (Opposite.op (U_1_comp a))))
      (a : Fin (L_comp + 1)), res1 a (e_prod.symm x) = x a :=
    fun x a => congrFun (e_prod.apply_symm_apply x) a
  have hBasicU1 : ∀ g : ↑(Y.presheaf.obj (Opposite.op U_Y1)),
      Y.basicOpen g = ⨆ a : Fin (L_comp + 1), Y.basicOpen (res1 a g) := by
    intro g
    calc Y.basicOpen g
        = U_Y1 ⊓ Y.basicOpen g := (inf_eq_right.mpr (Y.basicOpen_le g)).symm
      _ = (⨆ a : Fin (L_comp + 1), U_1_comp a) ⊓ Y.basicOpen g := rfl
      _ = ⨆ a : Fin (L_comp + 1), (U_1_comp a ⊓ Y.basicOpen g) := iSup_inf_eq _ _
      _ = ⨆ a : Fin (L_comp + 1), Y.basicOpen (res1 a g) := by
          congr 1; ext1 a
          exact (Y.basicOpen_res g (CategoryTheory.homOfLE (le_iSup U_1_comp a)).op).symm
  let e_idemp : Fin (L_comp + 1) → ↑(Y.presheaf.obj (Opposite.op U_Y1)) :=
    fun a => e_prod.symm (fun b => if b = a then 1 else 0)
  have hBasic_e : ∀ a : Fin (L_comp + 1), Y.basicOpen (e_idemp a) = U_1_comp a := by
    intro a
    rw [hBasicU1 (e_idemp a)]
    apply le_antisymm
    · refine iSup_le (fun b => ?_)
      rw [he_symm]
      by_cases hba : b = a
      · subst hba
        simp only [↓reduceIte]
        rw [Y.basicOpen_of_isUnit isUnit_one]
      · simp only [hba, ↓reduceIte]
        rw [Y.basicOpen_zero]
        exact bot_le
    · refine le_iSup_of_le a ?_
      rw [he_symm]
      simp only [↓reduceIte]
      rw [Y.basicOpen_of_isUnit isUnit_one]
  have hsum_e : (∑ a : Fin (L_comp + 1), e_idemp a) = 1 := by
    apply e_prod.injective
    rw [map_sum, map_one]
    ext b
    rw [Finset.sum_apply, Pi.one_apply]
    have hterm : ∀ a : Fin (L_comp + 1), e_prod (e_idemp a) b = (if b = a then 1 else 0) :=
      fun a => he_symm _ b
    simp only [hterm, Finset.sum_ite_eq, Finset.mem_univ, ↓reduceIte]
  have hspan_e : Ideal.span (Set.range e_idemp) = ⊤ := by
    rw [Ideal.eq_top_iff_one, ← hsum_e]
    exact Submodule.sum_mem _ (fun a _ => Ideal.subset_span ⟨a, rfl⟩)
  have hAff1 : AlgebraicGeometry.IsAffineOpen U_Y1 :=
    AlgebraicGeometry.isAffineOpen_of_isAffineOpen_basicOpen U_Y1 (Set.range e_idemp) hspan_e
      (by rintro _ ⟨a, rfl⟩; rw [hBasic_e a]; exact (hAffFin1 a).1)
  let s_bar : ↑(Y.presheaf.obj (Opposite.op U_Y1)) := e_prod.symm s_1_comp
  have hs_res : ∀ a : Fin (L_comp + 1), res1 a s_bar = s_1_comp a := he_symm s_1_comp
  have hs_basic_iSup : Y.basicOpen s_bar = ⨆ a : Fin (L_comp + 1), Y.basicOpen (s_1_comp a) := by
    rw [hBasicU1 s_bar]
    congr 1; ext1 a; rw [hs_res a]
  let c₀ : k₀ →+* ↑(Y.presheaf.obj (Opposite.op U_Y0)) :=
    ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫ p_Y.appLE ⊤ U_Y0 le_top).hom
  let c₁ : k₀ →+* ↑(Y.presheaf.obj (Opposite.op U_Y1)) :=
    ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫ p_Y.appLE ⊤ U_Y1 le_top).hom
  let c₁_a : ∀ a : Fin (L_comp + 1), k₀ →+* ↑(Y.presheaf.obj (Opposite.op (U_1_comp a))) :=
    fun a => ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
      p_Y.appLE ⊤ (U_1_comp a) le_top).hom
  have hc₁_res : ∀ a : Fin (L_comp + 1), (res1 a).comp c₁ = c₁_a a := by
    intro a
    ext r
    have hm : p_Y.appLE ⊤ U_Y1 le_top ≫
        Y.presheaf.map (CategoryTheory.homOfLE (le_iSup U_1_comp a)).op =
        p_Y.appLE ⊤ (U_1_comp a) le_top :=
      AlgebraicGeometry.Scheme.Hom.appLE_map p_Y le_top
        (CategoryTheory.homOfLE (le_iSup U_1_comp a)).op
    change ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
      (p_Y.appLE ⊤ U_Y1 le_top ≫
        Y.presheaf.map (CategoryTheory.homOfLE (le_iSup U_1_comp a)).op)).hom r = c₁_a a r
    rw [hm]
  have hFin1 : (Polynomial.eval₂RingHom c₁ s_bar).Finite := by
    letI : Algebra (Polynomial k₀) ↑(Y.presheaf.obj (Opposite.op U_Y1)) :=
      (Polynomial.eval₂RingHom c₁ s_bar).toAlgebra
    letI : ∀ a : Fin (L_comp + 1),
        Algebra (Polynomial k₀) ↑(Y.presheaf.obj (Opposite.op (U_1_comp a))) :=
      fun a => (Polynomial.eval₂RingHom (c₁_a a) (s_1_comp a)).toAlgebra
    have : ∀ a : Fin (L_comp + 1),
        Module.Finite (Polynomial k₀) ↑(Y.presheaf.obj (Opposite.op (U_1_comp a))) :=
      fun a => (hAffFin1 a).2.1
    let e_lin : ↑(Y.presheaf.obj (Opposite.op U_Y1)) ≃ₗ[Polynomial k₀]
        (∀ a : Fin (L_comp + 1), ↑(Y.presheaf.obj (Opposite.op (U_1_comp a)))) :=
      { e_prod with
        map_smul' := fun P z => by
          ext a
          change res1 a (Polynomial.eval₂ c₁ s_bar P * z) =
            Polynomial.eval₂ (c₁_a a) (s_1_comp a) P * res1 a z
          rw [map_mul, Polynomial.hom_eval₂, hc₁_res a, hs_res a] }
    change Module.Finite (Polynomial k₀) ↑(Y.presheaf.obj (Opposite.op U_Y1))
    exact Module.Finite.equiv e_lin.symm

  
  
  
  let 𝒜₁ := MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) k₀
  letI : GradedAlgebra 𝒜₁ := MvPolynomial.gradedAlgebra
  have hX0 : (MvPolynomial.X 0 : MvPolynomial (Fin (1 + 1)) k₀) ∈ 𝒜₁ 1 :=
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X k₀ 0)
  have hX1 : (MvPolynomial.X 1 : MvPolynomial (Fin (1 + 1)) k₀) ∈ 𝒜₁ 1 :=
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X k₀ 1)
  have halg0 : ∀ c : k₀,
      (algebraMap k₀ ↥(𝒜₁ 0) c : MvPolynomial (Fin (1 + 1)) k₀) = MvPolynomial.C c := by
    intro c
    rw [Algebra.algebraMap_eq_smul_one, Submodule.coe_smul_of_tower]
    change c • (1 : MvPolynomial (Fin (1 + 1)) k₀) = MvPolynomial.C c
    rw [Algebra.smul_def, mul_one, MvPolynomial.algebraMap_eq]
  have hIrrel : (HomogeneousIdeal.irrelevant 𝒜₁).toIdeal ≤
      Ideal.span (Set.range (MvPolynomial.X : Fin (1 + 1) → MvPolynomial (Fin (1 + 1)) k₀)) := by
    classical
    intro p hp
    have hp0 : GradedRing.proj 𝒜₁ 0 p = 0 := (HomogeneousIdeal.mem_irrelevant_iff 𝒜₁ p).mp hp
    have hcoeff0 : p.coeff 0 = 0 := by
      conv_lhs => rw [← DirectSum.sum_support_decompose 𝒜₁ p]
      rw [MvPolynomial.coeff_sum]
      apply Finset.sum_eq_zero
      intro i _
      by_cases hi : i = 0
      · subst hi
        have h0 : (DirectSum.decompose 𝒜₁ p 0 : MvPolynomial (Fin (1 + 1)) k₀) = 0 := by
          rw [← GradedRing.proj_apply]; exact hp0
        rw [h0]
        rfl
      · have hmem : (DirectSum.decompose 𝒜₁ p i : MvPolynomial (Fin (1 + 1)) k₀) ∈ 𝒜₁ i :=
          (DirectSum.decompose 𝒜₁ p i).2
        rw [MvPolynomial.mem_homogeneousSubmodule] at hmem
        by_contra hne
        have hdeg := hmem hne
        simp at hdeg
        exact hi hdeg.symm
    have hrange : Set.range (MvPolynomial.X : Fin (1 + 1) → MvPolynomial (Fin (1 + 1)) k₀) =
        MvPolynomial.X '' (Set.univ : Set (Fin (1 + 1))) := (Set.image_univ).symm
    rw [hrange, MvPolynomial.mem_ideal_span_X_image]
    intro m hm
    have hm_ne : m ≠ 0 := by
      intro hmz
      subst hmz
      exact (MvPolynomial.mem_support_iff.mp hm) hcoeff0
    have hex : ∃ j : Fin (1 + 1), m j ≠ 0 := by
      by_contra hall
      exact hm_ne (Finsupp.ext (fun j => not_not.mp (fun h => hall ⟨j, h⟩)))
    obtain ⟨j, hj⟩ := hex
    exact ⟨j, Set.mem_univ j, hj⟩

  have hDehom : ∀ (a a' : Fin (1 + 1)) (ha_ne : a ≠ a')
      (hXa : (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) k₀) ∈ 𝒜₁ 1)
      (hXa' : (MvPolynomial.X a' : MvPolynomial (Fin (1 + 1)) k₀) ∈ 𝒜₁ 1),
      ∃ (θ : Polynomial k₀ ≃+* HomogeneousLocalization.Away 𝒜₁ (MvPolynomial.X a)),
        (∀ c : k₀, θ (Polynomial.C c) =
          HomogeneousLocalization.fromZeroRingHom 𝒜₁ (Submonoid.powers (MvPolynomial.X a))
            (algebraMap k₀ ↥(𝒜₁ 0) c)) ∧
        θ Polynomial.X = HomogeneousLocalization.Away.mk 𝒜₁ hXa 1 (MvPolynomial.X a') hXa' ∧
        HomogeneousLocalization.Away.isLocalizationElem hXa hXa' = θ Polynomial.X ∧
        HomogeneousLocalization.Away.isLocalizationElem hXa hXa = 1 := by
    intro a a' ha_ne hXa hXa'
    have hFin2 : ∀ j : Fin (1 + 1), j = a ∨ j = a' := by
      intro j
      fin_cases j <;> fin_cases a <;> fin_cases a' <;> simp_all
    let S_a := Submonoid.powers (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) k₀)
    let ι_a : k₀ →+* HomogeneousLocalization.Away 𝒜₁ (MvPolynomial.X a) :=
      (HomogeneousLocalization.fromZeroRingHom 𝒜₁ S_a).comp (algebraMap k₀ ↥(𝒜₁ 0))
    let τ_a : HomogeneousLocalization.Away 𝒜₁ (MvPolynomial.X a) :=
      HomogeneousLocalization.Away.mk 𝒜₁ hXa 1 (MvPolynomial.X a') hXa'
    let α : Polynomial k₀ →+* HomogeneousLocalization.Away 𝒜₁ (MvPolynomial.X a) :=
      Polynomial.eval₂RingHom ι_a τ_a
    let w : Fin (1 + 1) → Polynomial k₀ := fun j => if j = a then 1 else Polynomial.X
    let dehom : MvPolynomial (Fin (1 + 1)) k₀ →+* Polynomial k₀ :=
      MvPolynomial.eval₂Hom Polynomial.C w
    have hdehom_S : ∀ y : S_a, dehom y.1 = 1 := by
      rintro ⟨_, n, rfl⟩
      simp [dehom, w]
    have hunit_S : ∀ y : S_a, IsUnit (dehom y.1) := fun y => by
      rw [hdehom_S y]; exact isUnit_one
    let β_loc : Localization S_a →+* Polynomial k₀ := IsLocalization.lift hunit_S
    have hβ_mk : ∀ (q : MvPolynomial (Fin (1 + 1)) k₀) (y : S_a),
        β_loc (Localization.mk q y) = dehom q := by
      intro q y
      rw [Localization.mk_eq_mk']
      exact (IsLocalization.lift_mk'_spec hunit_S q (dehom q) y).mpr (by rw [hdehom_S y, one_mul])
    let β : HomogeneousLocalization.Away 𝒜₁ (MvPolynomial.X a) →+* Polynomial k₀ :=
      { toFun := fun z => β_loc z.val
        map_one' := by rw [HomogeneousLocalization.val_one, map_one]
        map_mul' := fun x y => by rw [HomogeneousLocalization.val_mul, map_mul]
        map_zero' := by rw [HomogeneousLocalization.val_zero, map_zero]
        map_add' := fun x y => by rw [HomogeneousLocalization.val_add, map_add] }
    have hβ_α : β.comp α = RingHom.id (Polynomial k₀) := by
      apply Polynomial.ringHom_ext'
      · apply RingHom.ext
        intro c
        change β_loc (α (Polynomial.C c)).val = Polynomial.C c
        rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
        change β_loc (Localization.mk (algebraMap k₀ ↥(𝒜₁ 0) c : MvPolynomial (Fin (1 + 1)) k₀) 1) =
          Polynomial.C c
        rw [hβ_mk, halg0 c, MvPolynomial.eval₂Hom_C]
      · change β_loc (α Polynomial.X).val = Polynomial.X
        rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X,
          HomogeneousLocalization.Away.val_mk, hβ_mk]
        simp [dehom, w, ha_ne.symm]
    let φ : MvPolynomial (Fin (1 + 1)) k₀ →+* Localization S_a :=
      { toFun := fun q => (α (dehom q)).val
        map_one' := by rw [map_one, map_one, HomogeneousLocalization.val_one]
        map_mul' := fun x y => by rw [map_mul, map_mul, HomogeneousLocalization.val_mul]
        map_zero' := by rw [map_zero, map_zero, HomogeneousLocalization.val_zero]
        map_add' := fun x y => by rw [map_add, map_add, HomogeneousLocalization.val_add] }
    have hφ_C : ∀ c : k₀, φ (MvPolynomial.C c) = Localization.mk (MvPolynomial.C c) 1 := by
      intro c
      change (α (dehom (MvPolynomial.C c))).val = _
      rw [MvPolynomial.eval₂Hom_C, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
      change Localization.mk (algebraMap k₀ ↥(𝒜₁ 0) c : MvPolynomial (Fin (1 + 1)) k₀) 1 = _
      rw [halg0 c]
    have hφ_X : ∀ j : Fin (1 + 1),
        φ (MvPolynomial.X j) =
          Localization.mk (MvPolynomial.X j) ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩ := by
      intro j
      rcases hFin2 j with hj | hj
      · rw [hj]
        change (α (dehom (MvPolynomial.X a))).val = _
        simp only [dehom, MvPolynomial.eval₂Hom_X', w, ↓reduceIte, map_one,
          HomogeneousLocalization.val_one]
        exact (Localization.mk_self ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩).symm
      · rw [hj]
        change (α (dehom (MvPolynomial.X a'))).val = _
        simp only [α, dehom, MvPolynomial.eval₂Hom_X', w, ha_ne.symm, ↓reduceIte,
          Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
        rw [HomogeneousLocalization.Away.val_mk]
        simp only [pow_one]
    have hφ_prod : ∀ m : Fin (1 + 1) →₀ ℕ,
        φ (m.prod fun j k => (MvPolynomial.X j) ^ k) =
          Localization.mk (m.prod fun j k => (MvPolynomial.X j) ^ k)
            ⟨(MvPolynomial.X a) ^ (m.sum fun _ k => k),
              S_a.pow_mem (Submonoid.mem_powers _) _⟩ := by
      intro m
      refine Finsupp.induction m ?_ ?_
      · simp only [Finsupp.prod_zero_index, Finsupp.sum_zero_index, map_one, pow_zero]
        exact (Localization.mk_self (1 : S_a)).symm
      · intro j k m' hj hk ih
        have hs1 : ((Finsupp.single j k).prod
            fun x e => (MvPolynomial.X x : MvPolynomial (Fin (1 + 1)) k₀) ^ e) =
            (MvPolynomial.X j) ^ k :=
          Finsupp.prod_single_index (pow_zero _)
        rw [Finsupp.prod_add_index' (fun _ => pow_zero _) (fun _ _ _ => pow_add _ _ _),
          hs1,
          Finsupp.sum_add_index' (fun _ => rfl) (fun _ _ _ => rfl),
          Finsupp.sum_single_index rfl,
          map_mul, map_pow, hφ_X j, ih, Localization.mk_pow, Localization.mk_mul]
        congr 1; ext; dsimp; rw [pow_add]
    have hφ_monom : ∀ (m : Fin (1 + 1) →₀ ℕ) (c : k₀),
        φ (MvPolynomial.monomial m c) =
          Localization.mk (MvPolynomial.monomial m c)
            ⟨(MvPolynomial.X a) ^ (m.sum fun _ k => k),
              S_a.pow_mem (Submonoid.mem_powers _) _⟩ := by
      intro m c
      rw [MvPolynomial.monomial_eq, map_mul, hφ_C c, hφ_prod m, Localization.mk_mul]
      congr 1; ext; simp
    have hφ_hom : ∀ (n : ℕ) (p : MvPolynomial (Fin (1 + 1)) k₀),
        p.IsHomogeneous n →
        φ p = Localization.mk p
          ⟨(MvPolynomial.X a) ^ n, S_a.pow_mem (Submonoid.mem_powers _) n⟩ := by
      intro n p hp
      let s_n : S_a := ⟨(MvPolynomial.X a) ^ n, S_a.pow_mem (Submonoid.mem_powers _) n⟩
      have hsum_S : ∀ (S : Finset (Fin (1 + 1) →₀ ℕ)),
          (∀ m ∈ S, (m.sum fun _ k => k) = n) →
          (∑ m ∈ S, φ (MvPolynomial.monomial m (p.coeff m))) =
            Localization.mk (∑ m ∈ S, MvPolynomial.monomial m (p.coeff m)) s_n := by
        intro S
        refine Finset.induction_on S ?_ ?_
        · intro _
          simp only [Finset.sum_empty, Localization.mk_zero]
        · intro m S' hm ih hS
          rw [Finset.sum_insert hm, Finset.sum_insert hm, hφ_monom m (p.coeff m),
            ih (fun x hx => hS x (Finset.mem_insert_of_mem hx))]
          have hmn : (m.sum fun _ k => k) = n := hS m (Finset.mem_insert_self m S')
          have hden : (⟨(MvPolynomial.X a) ^ (m.sum fun _ k => k),
              S_a.pow_mem (Submonoid.mem_powers _) _⟩ : S_a) = s_n := by
            ext; dsimp [s_n]; rw [hmn]
          rw [hden, Localization.add_mk_self]
      conv_lhs => rw [MvPolynomial.as_sum p]
      rw [map_sum, hsum_S p.support]
      · rw [← MvPolynomial.as_sum p]
      · intro m hm
        have hwm := hp (MvPolynomial.mem_support_iff.mp hm)
        simpa [Finsupp.weight_apply, Finsupp.sum] using hwm
    have hα_β : α.comp β = RingHom.id (HomogeneousLocalization.Away 𝒜₁ (MvPolynomial.X a)) := by
      apply RingHom.ext
      intro z
      refine Quotient.inductionOn' z (fun nd => ?_)
      apply HomogeneousLocalization.val_injective S_a
      change (α (β (HomogeneousLocalization.mk nd))).val = (HomogeneousLocalization.mk nd).val
      obtain ⟨n, hn⟩ := nd.den_mem
      dsimp only at hn
      have hy_ne : nd.den.1 ≠ 0 := by
        intro h0
        have hev := congrArg (MvPolynomial.eval (fun _ => (1 : k₀))) (hn.trans h0)
        simp at hev
      obtain ⟨m, hm⟩ : ∃ m, nd.den.1.coeff m ≠ 0 := by
        by_contra hall
        exact hy_ne (MvPolynomial.ext _ _
          (fun m => by simp [not_not.mp (fun h => hall ⟨m, h⟩)]))
      have hd1 := (MvPolynomial.mem_homogeneousSubmodule nd.deg nd.den.1).mp nd.den.2 hm
      have hd2 : MvPolynomial.IsHomogeneous
          ((MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) k₀) ^ n) n := by
        simpa only [one_mul] using (MvPolynomial.isHomogeneous_X k₀ a).pow n
      rw [hn] at hd2
      have hdeg : nd.deg = n := hd1.symm.trans (hd2 hm)
      have hp_hom : nd.num.1.IsHomogeneous n :=
        hdeg ▸ (MvPolynomial.mem_homogeneousSubmodule nd.deg nd.num.1).mp nd.num.2
      rw [HomogeneousLocalization.val_mk]
      change (α (β_loc (Localization.mk nd.num.1 ⟨nd.den.1, nd.den_mem⟩))).val =
        Localization.mk nd.num.1 ⟨nd.den.1, nd.den_mem⟩
      rw [hβ_mk]
      change φ nd.num.1 = _
      rw [hφ_hom n nd.num.1 hp_hom]
      congr 1
      exact Subtype.ext hn
    let θ : Polynomial k₀ ≃+* HomogeneousLocalization.Away 𝒜₁ (MvPolynomial.X a) :=
      { α with
        invFun := β
        left_inv := fun P => RingHom.congr_fun hβ_α P
        right_inv := fun z => RingHom.congr_fun hα_β z }
    have hθ_C : ∀ c : k₀, θ (Polynomial.C c) =
        HomogeneousLocalization.fromZeroRingHom 𝒜₁ S_a (algebraMap k₀ ↥(𝒜₁ 0) c) := by
      intro c
      change Polynomial.eval₂ ι_a τ_a (Polynomial.C c) = ι_a c
      exact Polynomial.eval₂_C ι_a τ_a
    have hθ_X : θ Polynomial.X = τ_a := by
      change Polynomial.eval₂ ι_a τ_a Polynomial.X = τ_a
      exact Polynomial.eval₂_X ι_a τ_a
    refine ⟨θ, hθ_C, hθ_X, ?_, ?_⟩
    · rw [hθ_X]
      apply HomogeneousLocalization.val_injective S_a
      dsimp [HomogeneousLocalization.Away.isLocalizationElem, τ_a]
      simp only [pow_one]
    · apply HomogeneousLocalization.val_injective S_a
      dsimp [HomogeneousLocalization.Away.isLocalizationElem]
      rw [HomogeneousLocalization.val_one]
      simp only [pow_one]
      exact Localization.mk_self ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩

  obtain ⟨θ₀, hθ₀_C, hθ₀_X, hLoc₀₁, hLoc₀₀⟩ := hDehom 0 1 (by decide) hX0 hX1
  obtain ⟨θ₁, hθ₁_C, hθ₁_X, hLoc₁₀, hLoc₁₁⟩ := hDehom 1 0 (by decide) hX1 hX0

  have hLaurent : ∀ (B : Type u) [CommRing B] (c_B : k₀ →+* B) (f_B s_B : B),
      f_B * s_B = 1 →
      ∃ (ψ₀₁ : HomogeneousLocalization.Away 𝒜₁ (MvPolynomial.X 0 * MvPolynomial.X 1) →+* B),
        ψ₀₁.comp (HomogeneousLocalization.awayMap 𝒜₁ hX1 rfl) =
          (Polynomial.eval₂RingHom c_B f_B).comp θ₀.symm.toRingHom ∧
        ψ₀₁.comp (HomogeneousLocalization.awayMap 𝒜₁ hX0
            (mul_comm (MvPolynomial.X 0) (MvPolynomial.X 1))) =
          (Polynomial.eval₂RingHom c_B s_B).comp θ₁.symm.toRingHom := by
    intro B _ c_B f_B s_B hfs
    let ev_B : MvPolynomial (Fin (1 + 1)) k₀ →+* B := MvPolynomial.eval₂Hom c_B ![1, f_B]
    have hu_f : IsUnit f_B := ⟨⟨f_B, s_B, hfs, mul_comm s_B f_B ▸ hfs⟩, rfl⟩
    let S₀₁ := Submonoid.powers
      (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin (1 + 1)) k₀)
    have hunit₀₁ : ∀ y : S₀₁, IsUnit (ev_B y.1) := by
      rintro ⟨_, n, rfl⟩
      simp only [ev_B, map_pow, map_mul, MvPolynomial.eval₂Hom_X', Matrix.cons_val_zero,
        Matrix.cons_val_one, one_mul]
      exact hu_f.pow n
    let ψ_loc : Localization S₀₁ →+* B := IsLocalization.lift hunit₀₁
    let ψ₀₁ : HomogeneousLocalization.Away 𝒜₁ (MvPolynomial.X 0 * MvPolynomial.X 1) →+* B :=
      { toFun := fun z => ψ_loc z.val
        map_one' := by rw [HomogeneousLocalization.val_one, map_one]
        map_mul' := fun x y => by rw [HomogeneousLocalization.val_mul, map_mul]
        map_zero' := by rw [HomogeneousLocalization.val_zero, map_zero]
        map_add' := fun x y => by rw [HomogeneousLocalization.val_add, map_add] }
    refine ⟨ψ₀₁, ?_, ?_⟩
    · have hcomp0 : (ψ₀₁.comp (HomogeneousLocalization.awayMap 𝒜₁ hX1 rfl)).comp θ₀.toRingHom =
          Polynomial.eval₂RingHom c_B f_B := by
        apply Polynomial.ringHom_ext'
        · apply RingHom.ext
          intro c
          simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom,
            hθ₀_C c, HomogeneousLocalization.awayMap_fromZeroRingHom,
            Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
          change ψ_loc (Localization.mk (algebraMap k₀ ↥(𝒜₁ 0) c : MvPolynomial (Fin (1 + 1)) k₀) 1) =
            c_B c
          rw [Localization.mk_eq_mk']
          refine (IsLocalization.lift_mk'_spec hunit₀₁ _ (c_B c) 1).mpr ?_
          rw [halg0 c, Submonoid.coe_one, map_one, one_mul, MvPolynomial.eval₂Hom_C]
        · simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom,
            hθ₀_X, HomogeneousLocalization.awayMap_mk,
            Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
          change ψ_loc (HomogeneousLocalization.Away.mk 𝒜₁ _ 1 _ _).val = f_B
          rw [HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk']
          refine (IsLocalization.lift_mk'_spec hunit₀₁ _ f_B _).mpr ?_
          simp only [ev_B, pow_one, map_mul, MvPolynomial.eval₂Hom_X', Matrix.cons_val_zero,
            Matrix.cons_val_one, one_mul]
      apply RingHom.ext
      intro z
      have hz := RingHom.congr_fun hcomp0 (θ₀.symm z)
      simpa only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom,
        RingEquiv.apply_symm_apply] using hz
    · have hcomp1 : (ψ₀₁.comp (HomogeneousLocalization.awayMap 𝒜₁ hX0
          (mul_comm (MvPolynomial.X 0) (MvPolynomial.X 1)))).comp θ₁.toRingHom =
          Polynomial.eval₂RingHom c_B s_B := by
        apply Polynomial.ringHom_ext'
        · apply RingHom.ext
          intro c
          simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom,
            hθ₁_C c, HomogeneousLocalization.awayMap_fromZeroRingHom,
            Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
          change ψ_loc (Localization.mk (algebraMap k₀ ↥(𝒜₁ 0) c : MvPolynomial (Fin (1 + 1)) k₀) 1) =
            c_B c
          rw [Localization.mk_eq_mk']
          refine (IsLocalization.lift_mk'_spec hunit₀₁ _ (c_B c) 1).mpr ?_
          rw [halg0 c, Submonoid.coe_one, map_one, one_mul, MvPolynomial.eval₂Hom_C]
        · simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom,
            hθ₁_X, HomogeneousLocalization.awayMap_mk,
            Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
          change ψ_loc (HomogeneousLocalization.Away.mk 𝒜₁ _ 1 _ _).val = s_B
          rw [HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk']
          refine (IsLocalization.lift_mk'_spec hunit₀₁ _ s_B _).mpr ?_
          simp only [ev_B, pow_one, map_mul, MvPolynomial.eval₂Hom_X', Matrix.cons_val_zero,
            Matrix.cons_val_one, one_mul]
          exact hfs.symm
      apply RingHom.ext
      intro z
      have hz := RingHom.congr_fun hcomp1 (θ₁.symm z)
      simpa only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom,
        RingEquiv.apply_symm_apply] using hz

  
  
  
  let pt₀ : PrimeSpectrum k₀ := ⊥
  have hCovY : U_Y0 ⊔ U_Y1 = ⊤ := by
    apply SetLike.coe_injective
    ext y
    simp only [TopologicalSpace.Opens.coe_sup, TopologicalSpace.Opens.coe_top,
      Set.mem_union, Set.mem_univ, iff_true]
    by_cases hy0 : y ∈ U_Y0
    · exact Or.inl hy0
    · refine Or.inr ?_
      have hy_not : y ∉ (U_Y0 : Set ↥Y) := hy0
      rw [hUY0_set, Set.mem_compl_iff, not_not, Set.mem_iUnion] at hy_not
      obtain ⟨i, q, rfl⟩ := hy_not
      have hq : q = pt₀ := Subsingleton.elim q pt₀
      rw [hq]
      have hyW : (σ_bar i).base pt₀ ∈ W_bar i := (hW i).2.1
      have hW_le : W_bar i ≤ U_Y1 := by
        change W_bar i ≤ ⨆ a : Fin (L_comp + 1), U_1_comp a
        rw [hCov1]
        exact le_sup_of_le_right (le_iSup W_bar i)
      exact hW_le hyW

  have hf_basic : Y.basicOpen f_bar = U_Y0 ⊓ U_Y1 := by
    apply le_antisymm
    · refine le_inf (Y.basicOpen_le f_bar) ?_
      change Y.basicOpen f_bar ≤ ⨆ a : Fin (L_comp + 1), U_1_comp a
      rw [hCov1]
      exact le_sup_left
    · change U_Y0 ⊓ (⨆ a : Fin (L_comp + 1), U_1_comp a) ≤ Y.basicOpen f_bar
      rw [hCov1, inf_sup_left]
      refine sup_le inf_le_right ?_
      rw [inf_iSup_eq]
      refine iSup_le (fun i => ?_)
      have hWi_eq : U_Y0 ⊓ W_bar i = Y.basicOpen (t_bar i) := by
        rw [inf_comm, (hW i).2.2.2.1]
      rw [hWi_eq]
      have hB_le0 : Y.basicOpen (t_bar i) ≤ U_Y0 := hWi_eq.symm.trans_le inf_le_left
      have hmul := (hW i).2.2.2.2.2 hB_le0
      have hu : IsUnit ((Y.presheaf.map (CategoryTheory.homOfLE hB_le0).op).hom f_bar) :=
        IsUnit.of_mul_eq_one _ hmul
      calc Y.basicOpen (t_bar i)
          = Y.basicOpen ((Y.presheaf.map (CategoryTheory.homOfLE hB_le0).op).hom f_bar) :=
            (Y.basicOpen_of_isUnit hu).symm
        _ = Y.basicOpen (t_bar i) ⊓ Y.basicOpen f_bar :=
            Y.basicOpen_res f_bar (CategoryTheory.homOfLE hB_le0).op
        _ ≤ Y.basicOpen f_bar := inf_le_right

  have hs_basic : Y.basicOpen s_bar = U_Y0 ⊓ U_Y1 := by
    rw [hs_basic_iSup]
    change (⨆ a : Fin (L_comp + 1), Y.basicOpen (s_1_comp a)) =
      U_Y0 ⊓ (⨆ a : Fin (L_comp + 1), U_1_comp a)
    rw [inf_iSup_eq]
    congr 1; ext1 a
    apply le_antisymm
    · refine le_inf ?_ (Y.basicOpen_le (s_1_comp a))
      intro y hy
      have hya : y ∈ U_1_comp a := Y.basicOpen_le (s_1_comp a) hy
      by_contra hy0
      have hy_not : y ∉ (U_Y0 : Set ↥Y) := hy0
      rw [hUY0_set, Set.mem_compl_iff, not_not, Set.mem_iUnion] at hy_not
      obtain ⟨i, q, hyq⟩ := hy_not
      have hq : q = pt₀ := Subsingleton.elim q pt₀
      rw [hq] at hyq
      have hyW : y ∈ W_bar i := hyq ▸ (hW i).2.1
      obtain ⟨b, hW_le1, hs_eq⟩ := hW_in1 i
      have hyb : y ∈ U_1_comp b := hW_le1 hyW
      have hba : b = a := by
        by_contra hne
        exact (hDisj1 hne).le_bot ⟨hyb, hya⟩
      subst hba
      have hy_res : y ∈ W_bar i ⊓ Y.basicOpen (s_1_comp b) := ⟨hyW, hy⟩
      rw [← Y.basicOpen_res (s_1_comp b) (CategoryTheory.homOfLE hW_le1).op, hs_eq,
        Y.basicOpen_mul] at hy_res
      have hy_t : y ∈ Y.basicOpen (t_bar i) := by
        have hpow : Y.basicOpen ((t_bar i) ^ k₁) = Y.basicOpen (t_bar i) :=
          Y.basicOpen_pow (t_bar i) hk₁
        exact hpow ▸ hy_res.2
      have hy_W0 : y ∈ W_bar i ⊓ U_Y0 := ((hW i).2.2.2.1).symm ▸ hy_t
      exact hy0 hy_W0.2
    · have heq_inter : U_Y0 ⊓ U_1_comp a = Y.basicOpen f_bar ⊓ U_1_comp a := by
        calc U_Y0 ⊓ U_1_comp a
            = U_Y0 ⊓ (U_Y1 ⊓ U_1_comp a) := by rw [inf_eq_right.mpr (le_iSup U_1_comp a)]
          _ = (U_Y0 ⊓ U_Y1) ⊓ U_1_comp a := (inf_assoc _ _ _).symm
          _ = Y.basicOpen f_bar ⊓ U_1_comp a := by rw [hf_basic]
      rw [heq_inter]
      have h_inter : Y.basicOpen f_bar ⊓ U_1_comp a ≤ U_Y0 :=
        inf_le_left.trans (Y.basicOpen_le f_bar)
      have hmul := (hAffFin1 a).2.2 h_inter
      have hu : IsUnit ((Y.presheaf.map (CategoryTheory.homOfLE
          (inf_le_right : Y.basicOpen f_bar ⊓ U_1_comp a ≤ U_1_comp a)).op).hom (s_1_comp a)) := by
        rw [mul_comm] at hmul
        exact IsUnit.of_mul_eq_one _ hmul
      calc Y.basicOpen f_bar ⊓ U_1_comp a
          = Y.basicOpen ((Y.presheaf.map (CategoryTheory.homOfLE
              (inf_le_right : Y.basicOpen f_bar ⊓ U_1_comp a ≤ U_1_comp a)).op).hom (s_1_comp a)) :=
            (Y.basicOpen_of_isUnit hu).symm
        _ = (Y.basicOpen f_bar ⊓ U_1_comp a) ⊓ Y.basicOpen (s_1_comp a) :=
            Y.basicOpen_res (s_1_comp a) _
        _ ≤ Y.basicOpen (s_1_comp a) := inf_le_right

  let U_01 : Y.Opens := U_Y0 ⊓ U_Y1
  have hAff01 : AlgebraicGeometry.IsAffineOpen U_01 := by
    change AlgebraicGeometry.IsAffineOpen (U_Y0 ⊓ U_Y1)
    rw [← hf_basic]
    exact hAff0.basicOpen f_bar
  let res01_0 : ↑(Y.presheaf.obj (Opposite.op U_Y0)) →+* ↑(Y.presheaf.obj (Opposite.op U_01)) :=
    (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U_01 ≤ U_Y0)).op).hom
  let res01_1 : ↑(Y.presheaf.obj (Opposite.op U_Y1)) →+* ↑(Y.presheaf.obj (Opposite.op U_01)) :=
    (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_right : U_01 ≤ U_Y1)).op).hom
  have hRecip : res01_0 f_bar * res01_1 s_bar = 1 := by
    let V_comp : Fin (L_comp + 1) → Y.Opens := fun a => Y.basicOpen f_bar ⊓ U_1_comp a
    have hVa_le : ∀ a : Fin (L_comp + 1), V_comp a ≤ U_01 :=
      fun a => inf_le_inf (Y.basicOpen_le f_bar) (le_iSup U_1_comp a)
    have hV_sup : U_01 ≤ ⨆ a : Fin (L_comp + 1), V_comp a := by
      have heq : U_01 = ⨆ a : Fin (L_comp + 1), V_comp a := by
        calc U_01
            = Y.basicOpen f_bar := hf_basic.symm
          _ = Y.basicOpen f_bar ⊓ U_Y1 :=
              (inf_eq_left.mpr (hf_basic.trans_le inf_le_right)).symm
          _ = Y.basicOpen f_bar ⊓ (⨆ a : Fin (L_comp + 1), U_1_comp a) := rfl
          _ = ⨆ a : Fin (L_comp + 1), V_comp a := inf_iSup_eq _ _
      exact le_of_eq heq
    have hCompat1 : TopCat.Presheaf.IsCompatible Y.presheaf V_comp
        (fun a => (1 : ↑(Y.presheaf.obj (Opposite.op (V_comp a))))) := by
      intro a b
      simp only [map_one]
    obtain ⟨s₀, _, huniq⟩ := Y.sheaf.existsUnique_gluing' V_comp U_01
      (fun a => CategoryTheory.homOfLE (hVa_le a)) hV_sup (fun _ => 1) hCompat1
    have hlhs : ∀ a : Fin (L_comp + 1),
        (Y.presheaf.map (CategoryTheory.homOfLE (hVa_le a)).op).hom
          (res01_0 f_bar * res01_1 s_bar) = 1 := by
      intro a
      rw [map_mul]
      have hf_eq : (Y.presheaf.map (CategoryTheory.homOfLE (hVa_le a)).op).hom (res01_0 f_bar) =
          (Y.presheaf.map (CategoryTheory.homOfLE ((hVa_le a).trans inf_le_left)).op).hom f_bar := by
        change (Y.presheaf.map (CategoryTheory.homOfLE inf_le_left).op ≫
          Y.presheaf.map (CategoryTheory.homOfLE (hVa_le a)).op).hom f_bar = _
        rw [← Y.presheaf.map_comp]; rfl
      have hs_eq : (Y.presheaf.map (CategoryTheory.homOfLE (hVa_le a)).op).hom (res01_1 s_bar) =
          (Y.presheaf.map (CategoryTheory.homOfLE
            (inf_le_right : V_comp a ≤ U_1_comp a)).op).hom (s_1_comp a) := by
        rw [← hs_res a]
        change (Y.presheaf.map (CategoryTheory.homOfLE inf_le_right).op ≫
          Y.presheaf.map (CategoryTheory.homOfLE (hVa_le a)).op).hom s_bar =
          (Y.presheaf.map (CategoryTheory.homOfLE (le_iSup U_1_comp a)).op ≫
            Y.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom s_bar
        rw [← Y.presheaf.map_comp, ← Y.presheaf.map_comp]; rfl
      rw [hf_eq, hs_eq]
      exact (hAffFin1 a).2.2 ((hVa_le a).trans inf_le_left)
    have hrhs : ∀ a : Fin (L_comp + 1),
        (Y.presheaf.map (CategoryTheory.homOfLE (hVa_le a)).op).hom (1 : _) = 1 :=
      fun _ => map_one _
    exact (huniq _ hlhs).trans (huniq 1 hrhs).symm

  
  let ψ₀ : HomogeneousLocalization.Away 𝒜₁ (MvPolynomial.X 0) →+*
      ↑(Y.presheaf.obj (Opposite.op U_Y0)) :=
    (Polynomial.eval₂RingHom c₀ f_bar).comp θ₀.symm.toRingHom
  let ψ₁ : HomogeneousLocalization.Away 𝒜₁ (MvPolynomial.X 1) →+*
      ↑(Y.presheaf.obj (Opposite.op U_Y1)) :=
    (Polynomial.eval₂RingHom c₁ s_bar).comp θ₁.symm.toRingHom
  let π₀ : U_Y0.toScheme ⟶ AlgebraicGeometry.Proj 𝒜₁ :=
    U_Y0.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀) ≫
      AlgebraicGeometry.Proj.awayι 𝒜₁ (MvPolynomial.X 0) hX0 zero_lt_one
  let π₁ : U_Y1.toScheme ⟶ AlgebraicGeometry.Proj 𝒜₁ :=
    U_Y1.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁) ≫
      AlgebraicGeometry.Proj.awayι 𝒜₁ (MvPolynomial.X 1) hX1 zero_lt_one

  have htoSpecΓ_res : ∀ {V U : Y.Opens} (hV : AlgebraicGeometry.IsAffineOpen V)
      (hU : AlgebraicGeometry.IsAffineOpen U) (hle : V ≤ U),
      Y.homOfLE hle ≫ U.toSpecΓ =
        V.toSpecΓ ≫ AlgebraicGeometry.Spec.map (Y.presheaf.map (CategoryTheory.homOfLE hle).op) := by
    intro V U hV hU hle
    rw [← cancel_mono hU.fromSpec, Category.assoc, hU.toSpecΓ_fromSpec, Y.homOfLE_ι,
      Category.assoc, hU.map_fromSpec hV (CategoryTheory.homOfLE hle).op, hV.toSpecΓ_fromSpec]

  let c₀₁ : k₀ →+* ↑(Y.presheaf.obj (Opposite.op U_01)) :=
    ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫ p_Y.appLE ⊤ U_01 le_top).hom
  have hc₀₁_0 : res01_0.comp c₀ = c₀₁ := by
    ext r
    have hm := AlgebraicGeometry.Scheme.Hom.appLE_map p_Y (U := ⊤) (V := U_Y0) (V' := U_01) le_top
      (CategoryTheory.homOfLE (inf_le_left : U_01 ≤ U_Y0)).op
    change ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
      (p_Y.appLE ⊤ U_Y0 le_top ≫
        Y.presheaf.map (CategoryTheory.homOfLE inf_le_left).op)).hom r = c₀₁ r
    rw [hm]
  have hc₀₁_1 : res01_1.comp c₁ = c₀₁ := by
    ext r
    have hm := AlgebraicGeometry.Scheme.Hom.appLE_map p_Y (U := ⊤) (V := U_Y1) (V' := U_01) le_top
      (CategoryTheory.homOfLE (inf_le_right : U_01 ≤ U_Y1)).op
    change ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
      (p_Y.appLE ⊤ U_Y1 le_top ≫
        Y.presheaf.map (CategoryTheory.homOfLE inf_le_right).op)).hom r = c₀₁ r
    rw [hm]

  obtain ⟨ψ₀₁, hψ₀₁_0, hψ₀₁_1⟩ :=
    hLaurent ↑(Y.presheaf.obj (Opposite.op U_01)) c₀₁ (res01_0 f_bar) (res01_1 s_bar) hRecip
  have hres_ψ₀ : res01_0.comp ψ₀ = ψ₀₁.comp (HomogeneousLocalization.awayMap 𝒜₁ hX1 rfl) := by
    rw [hψ₀₁_0]
    apply RingHom.ext
    intro z
    simp only [ψ₀, RingHom.comp_apply, Polynomial.coe_eval₂RingHom, Polynomial.hom_eval₂, hc₀₁_0]
  have hres_ψ₁ : res01_1.comp ψ₁ =
      ψ₀₁.comp (HomogeneousLocalization.awayMap 𝒜₁ hX0
        (mul_comm (MvPolynomial.X 0) (MvPolynomial.X 1))) := by
    rw [hψ₀₁_1]
    apply RingHom.ext
    intro z
    simp only [ψ₁, RingHom.comp_apply, Polynomial.coe_eval₂RingHom, Polynomial.hom_eval₂, hc₀₁_1]

  have h01_eq : Y.homOfLE (inf_le_left : U_Y0 ⊓ U_Y1 ≤ U_Y0) ≫ π₀ =
      Y.homOfLE (inf_le_right : U_Y0 ⊓ U_Y1 ≤ U_Y1) ≫ π₁ := by
    have hL : Y.homOfLE (inf_le_left : U_01 ≤ U_Y0) ≫ π₀ =
        U_01.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀₁) ≫
          AlgebraicGeometry.Proj.awayι 𝒜₁ (MvPolynomial.X 0 * MvPolynomial.X 1)
            (SetLike.mul_mem_graded hX0 hX1) (by omega) := by
      dsimp only [π₀]
      rw [← Category.assoc, ← Category.assoc, htoSpecΓ_res hAff01 hAff0 inf_le_left,
        Category.assoc, Category.assoc]
      have hmap : Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U_01 ≤ U_Y0)).op =
          CommRingCat.ofHom res01_0 := rfl
      rw [hmap, ← Category.assoc (AlgebraicGeometry.Spec.map _),
        ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hres_ψ₀,
        CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, Category.assoc,
        AlgebraicGeometry.Proj.SpecMap_awayMap_awayι 𝒜₁ hX0 zero_lt_one hX1 rfl]
    have hR : Y.homOfLE (inf_le_right : U_01 ≤ U_Y1) ≫ π₁ =
        U_01.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀₁) ≫
          AlgebraicGeometry.Proj.awayι 𝒜₁ (MvPolynomial.X 0 * MvPolynomial.X 1)
            (SetLike.mul_mem_graded hX0 hX1) (by omega) := by
      dsimp only [π₁]
      rw [← Category.assoc, ← Category.assoc, htoSpecΓ_res hAff01 hAff1 inf_le_right,
        Category.assoc, Category.assoc]
      have hmap : Y.presheaf.map (CategoryTheory.homOfLE (inf_le_right : U_01 ≤ U_Y1)).op =
          CommRingCat.ofHom res01_1 := rfl
      rw [hmap, ← Category.assoc (AlgebraicGeometry.Spec.map _),
        ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hres_ψ₁,
        CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, Category.assoc,
        AlgebraicGeometry.Proj.SpecMap_awayMap_awayι 𝒜₁ hX1 zero_lt_one hX0
          (mul_comm (MvPolynomial.X 0) (MvPolynomial.X 1))]
    exact hL.trans hR.symm

  
  let U_cov : Bool → Y.Opens := fun b => cond b U_Y1 U_Y0
  have hTop_cov : TopologicalSpace.IsOpenCover U_cov := by
    apply TopologicalSpace.IsOpenCover.mk
    change (⨆ b : Bool, U_cov b) = ⊤
    rw [iSup_bool_eq]
    simpa only [U_cov, Bool.cond_true, Bool.cond_false, sup_comm] using hCovY
  let 𝒰 := Y.openCoverOfIsOpenCover U_cov hTop_cov
  let g_cov : ∀ b : Bool, (U_cov b).toScheme ⟶ AlgebraicGeometry.Proj 𝒜₁ :=
    fun b => Bool.rec π₀ π₁ b
  have h_glue : ∀ b₁ b₂ : 𝒰.I₀,
      CategoryTheory.Limits.pullback.fst (𝒰.f b₁) (𝒰.f b₂) ≫ g_cov b₁ =
        CategoryTheory.Limits.pullback.snd (𝒰.f b₁) (𝒰.f b₂) ≫ g_cov b₂ := by
    change ∀ b₁ b₂ : Bool,
      CategoryTheory.Limits.pullback.fst (U_cov b₁).ι (U_cov b₂).ι ≫ g_cov b₁ =
        CategoryTheory.Limits.pullback.snd (U_cov b₁).ι (U_cov b₂).ι ≫ g_cov b₂
    intro b₁ b₂
    let pb := AlgebraicGeometry.isPullback_opens_inf (U_cov b₁) (U_cov b₂)
    rw [← cancel_epi pb.isoPullback.hom, ← Category.assoc, pb.isoPullback_hom_fst,
      ← Category.assoc, pb.isoPullback_hom_snd]
    cases b₁ <;> cases b₂
    · rfl
    · exact h01_eq
    · have hswap1 : (Y.isoOfEq (inf_comm U_Y0 U_Y1)).hom ≫
          Y.homOfLE (inf_le_left : U_Y1 ⊓ U_Y0 ≤ U_Y1) =
          Y.homOfLE (inf_le_right : U_Y0 ⊓ U_Y1 ≤ U_Y1) := by
        rw [← cancel_mono U_Y1.ι, Category.assoc, Y.homOfLE_ι, Y.isoOfEq_hom_ι, Y.homOfLE_ι]
      have hswap2 : (Y.isoOfEq (inf_comm U_Y0 U_Y1)).hom ≫
          Y.homOfLE (inf_le_right : U_Y1 ⊓ U_Y0 ≤ U_Y0) =
          Y.homOfLE (inf_le_left : U_Y0 ⊓ U_Y1 ≤ U_Y0) := by
        rw [← cancel_mono U_Y0.ι, Category.assoc, Y.homOfLE_ι, Y.isoOfEq_hom_ι, Y.homOfLE_ι]
      rw [← cancel_epi (Y.isoOfEq (inf_comm U_Y0 U_Y1)).hom]
      change ((Y.isoOfEq (inf_comm U_Y0 U_Y1)).hom ≫
          Y.homOfLE (inf_le_left : U_Y1 ⊓ U_Y0 ≤ U_Y1)) ≫ π₁ =
        ((Y.isoOfEq (inf_comm U_Y0 U_Y1)).hom ≫
          Y.homOfLE (inf_le_right : U_Y1 ⊓ U_Y0 ≤ U_Y0)) ≫ π₀
      rw [hswap1, hswap2]
      exact h01_eq.symm
    · rfl

  let π_bar : Y ⟶ AlgebraicGeometry.Proj 𝒜₁ :=
    𝒰.glueMorphisms g_cov h_glue
  have hπ0 : U_Y0.ι ≫ π_bar = π₀ := 𝒰.ι_glueMorphisms g_cov h_glue false
  have hπ1 : U_Y1.ι ≫ π_bar = π₁ := 𝒰.ι_glueMorphisms g_cov h_glue true

  
  let P1_hom : AlgebraicGeometry.Proj 𝒜₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of k₀) :=
    AlgebraicGeometry.Proj.toSpecZero 𝒜₁ ≫
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k₀ ↥(𝒜₁ 0)))
  have hChartComm : ∀ (U : Y.Opens) (hAff : AlgebraicGeometry.IsAffineOpen U)
      (s_U : ↑(Y.presheaf.obj (Opposite.op U)))
      (a : Fin (1 + 1)) (hXa : (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) k₀) ∈ 𝒜₁ 1)
      (θ : Polynomial k₀ ≃+* HomogeneousLocalization.Away 𝒜₁ (MvPolynomial.X a))
      (hθ_C : ∀ c : k₀, θ (Polynomial.C c) =
        HomogeneousLocalization.fromZeroRingHom 𝒜₁ (Submonoid.powers (MvPolynomial.X a))
          (algebraMap k₀ ↥(𝒜₁ 0) c)),
      let c_U := ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
        p_Y.appLE ⊤ U le_top).hom
      let ψ := (Polynomial.eval₂RingHom c_U s_U).comp θ.symm.toRingHom
      (U.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫
        AlgebraicGeometry.Proj.awayι 𝒜₁ (MvPolynomial.X a) hXa zero_lt_one) ≫
        P1_hom = U.ι ≫ p_Y := by
    intro U hAff s_U a hXa θ hθ_C c_U ψ
    let hU_top : U ≤ (TopologicalSpace.Opens.map p_Y.base).obj ⊤ := le_top
    dsimp only [P1_hom]
    rw [Category.assoc, Category.assoc, ← Category.assoc (AlgebraicGeometry.Proj.awayι _ _ _ _),
      AlgebraicGeometry.Proj.awayι_toSpecZero 𝒜₁ (MvPolynomial.X a) hXa zero_lt_one,
      ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
      ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    have hhom_eq : CommRingCat.ofHom
        (ψ.comp ((HomogeneousLocalization.fromZeroRingHom 𝒜₁
          (Submonoid.powers (MvPolynomial.X a))).comp (algebraMap k₀ ↥(𝒜₁ 0)))) =
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫ p_Y.appLE ⊤ U hU_top := by
      ext c
      change ψ (HomogeneousLocalization.fromZeroRingHom 𝒜₁
        (Submonoid.powers (MvPolynomial.X a)) (algebraMap k₀ ↥(𝒜₁ 0) c)) = c_U c
      rw [← hθ_C c]
      simp [ψ]
    rw [hhom_eq, AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Scheme.isoSpec_Spec_inv,
      ← AlgebraicGeometry.IsAffineOpen.fromSpec_top,
      AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec p_Y
        (AlgebraicGeometry.isAffineOpen_top _) hAff hU_top,
      ← Category.assoc, hAff.toSpecΓ_fromSpec]

  have hπ_comm : π_bar ≫ P1_hom = p_Y := by
    apply 𝒰.hom_ext
    intro b
    cases b
    · change U_Y0.ι ≫ π_bar ≫ P1_hom = U_Y0.ι ≫ p_Y
      rw [← Category.assoc, hπ0]
      exact hChartComm U_Y0 hAff0 f_bar 0 hX0 θ₀ hθ₀_C
    · change U_Y1.ι ≫ π_bar ≫ P1_hom = U_Y1.ι ≫ p_Y
      rw [← Category.assoc, hπ1]
      exact hChartComm U_Y1 hAff1 s_bar 1 hX1 θ₁ hθ₁_C

  
  let D_0 : (AlgebraicGeometry.Proj 𝒜₁).Opens :=
    AlgebraicGeometry.Proj.basicOpen 𝒜₁ (MvPolynomial.X 0)
  let D_1 : (AlgebraicGeometry.Proj 𝒜₁).Opens :=
    AlgebraicGeometry.Proj.basicOpen 𝒜₁ (MvPolynomial.X 1)
  let V_0 : Y.Opens := (TopologicalSpace.Opens.map π_bar.base).obj D_0
  let V_1 : Y.Opens := (TopologicalSpace.Opens.map π_bar.base).obj D_1

  have hInterPre : ∀ (U : Y.Opens) (hAff : AlgebraicGeometry.IsAffineOpen U)
      (a b : Fin (1 + 1))
      (ψ : HomogeneousLocalization.Away 𝒜₁ (MvPolynomial.X a) →+*
        ↑(Y.presheaf.obj (Opposite.op U)))
      (hXa : (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) k₀) ∈ 𝒜₁ 1)
      (hXb : (MvPolynomial.X b : MvPolynomial (Fin (1 + 1)) k₀) ∈ 𝒜₁ 1),
      U.ι ≫ π_bar = U.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫
        AlgebraicGeometry.Proj.awayι 𝒜₁ (MvPolynomial.X a) hXa zero_lt_one →
      U ⊓ (TopologicalSpace.Opens.map π_bar.base).obj
          (AlgebraicGeometry.Proj.basicOpen 𝒜₁ (MvPolynomial.X b)) =
        Y.basicOpen (ψ (HomogeneousLocalization.Away.isLocalizationElem hXa hXb)) := by
    intro U hAff a b ψ hXa hXb hUπ
    have hpre_away : (TopologicalSpace.Opens.map
        (AlgebraicGeometry.Proj.awayι 𝒜₁ (MvPolynomial.X a) hXa zero_lt_one).base).obj
        (AlgebraicGeometry.Proj.basicOpen 𝒜₁ (MvPolynomial.X b)) =
        PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.isLocalizationElem hXa hXb) :=
      AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜₁ hXa zero_lt_one hXb zero_lt_one
    have hpre_spec : (TopologicalSpace.Opens.map
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)).base).obj
        (PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.isLocalizationElem hXa hXb)) =
        PrimeSpectrum.basicOpen (ψ (HomogeneousLocalization.Away.isLocalizationElem hXa hXb)) :=
      PrimeSpectrum.comap_basicOpen ψ _
    have himg : hAff.fromSpec ''ᵁ PrimeSpectrum.basicOpen
        (ψ (HomogeneousLocalization.Away.isLocalizationElem hXa hXb)) =
        Y.basicOpen (ψ (HomogeneousLocalization.Away.isLocalizationElem hXa hXb)) :=
      hAff.fromSpec_image_basicOpen _
    rw [← himg]
    apply SetLike.coe_injective
    ext y
    simp only [TopologicalSpace.Opens.coe_inf, Set.mem_inter_iff]
    let B_open : (AlgebraicGeometry.Spec (Y.presheaf.obj (Opposite.op U))).Opens :=
      PrimeSpectrum.basicOpen (ψ (HomogeneousLocalization.Away.isLocalizationElem hXa hXb))
    change (y ∈ U ∧ π_bar.base y ∈ AlgebraicGeometry.Proj.basicOpen 𝒜₁ (MvPolynomial.X b)) ↔
      y ∈ hAff.fromSpec.base '' (B_open : Set _)
    refine ⟨?_, ?_⟩
    · rintro ⟨hyU, hyD⟩
      let x : ↥U.toScheme := ⟨y, hyU⟩
      refine ⟨U.toSpecΓ.base x, ?_, ?_⟩
      · have hxD : (U.ι ≫ π_bar).base x ∈ AlgebraicGeometry.Proj.basicOpen 𝒜₁ (MvPolynomial.X b) :=
          hyD
        rw [hUπ] at hxD
        change x ∈ (TopologicalSpace.Opens.map U.toSpecΓ.base).obj
          ((TopologicalSpace.Opens.map (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)).base).obj
            ((TopologicalSpace.Opens.map
              (AlgebraicGeometry.Proj.awayι 𝒜₁ (MvPolynomial.X a) hXa zero_lt_one).base).obj
              (AlgebraicGeometry.Proj.basicOpen 𝒜₁ (MvPolynomial.X b)))) at hxD
        rw [hpre_away, hpre_spec] at hxD
        exact hxD
      · change (U.toSpecΓ ≫ hAff.fromSpec).base x = y
        rw [hAff.toSpecΓ_fromSpec]
        rfl
    · rintro ⟨p, hp, rfl⟩
      let x : ↥U.toScheme := hAff.isoSpec.inv.base p
      have hx_p : U.toSpecΓ.base x = p := by
        change (hAff.isoSpec.inv ≫ U.toSpecΓ).base p = p
        rw [← hAff.isoSpec_hom, Iso.inv_hom_id]
        rfl
      have hy_x : hAff.fromSpec.base p = U.ι.base x := by
        rw [← hx_p]
        change (U.toSpecΓ ≫ hAff.fromSpec).base x = U.ι.base x
        rw [hAff.toSpecΓ_fromSpec]
      rw [hy_x]
      refine ⟨x.2, ?_⟩
      change (U.ι ≫ π_bar).base x ∈ AlgebraicGeometry.Proj.basicOpen 𝒜₁ (MvPolynomial.X b)
      rw [hUπ]
      change x ∈ (TopologicalSpace.Opens.map U.toSpecΓ.base).obj
        ((TopologicalSpace.Opens.map (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)).base).obj
          ((TopologicalSpace.Opens.map
            (AlgebraicGeometry.Proj.awayι 𝒜₁ (MvPolynomial.X a) hXa zero_lt_one).base).obj
            (AlgebraicGeometry.Proj.basicOpen 𝒜₁ (MvPolynomial.X b))))
      rw [hpre_away, hpre_spec]
      show U.toSpecΓ.base x ∈ PrimeSpectrum.basicOpen
        (ψ (HomogeneousLocalization.Away.isLocalizationElem hXa hXb))
      rwa [hx_p]

  have hU0_V0 : U_Y0 ⊓ V_0 = U_Y0 := by
    have h := hInterPre U_Y0 hAff0 0 0 ψ₀ hX0 hX0 hπ0
    rw [hLoc₀₀, map_one] at h
    rw [h, Y.basicOpen_of_isUnit isUnit_one]
  have hU0_V1 : U_Y0 ⊓ V_1 = U_Y0 ⊓ U_Y1 := by
    have h := hInterPre U_Y0 hAff0 0 1 ψ₀ hX0 hX1 hπ0
    rw [hLoc₀₁] at h
    have hψX : ψ₀ (θ₀ Polynomial.X) = f_bar := by simp [ψ₀]
    rw [h, hψX, hf_basic]
  have hU1_V0 : U_Y1 ⊓ V_0 = U_Y0 ⊓ U_Y1 := by
    have h := hInterPre U_Y1 hAff1 1 0 ψ₁ hX1 hX0 hπ1
    rw [hLoc₁₀] at h
    have hψX : ψ₁ (θ₁ Polynomial.X) = s_bar := by simp [ψ₁]
    rw [h, hψX, hs_basic]
  have hU1_V1 : U_Y1 ⊓ V_1 = U_Y1 := by
    have h := hInterPre U_Y1 hAff1 1 1 ψ₁ hX1 hX1 hπ1
    rw [hLoc₁₁, map_one] at h
    rw [h, Y.basicOpen_of_isUnit isUnit_one]

  have hpre0 : V_0 = U_Y0 := by
    calc V_0 = ⊤ ⊓ V_0 := (top_inf_eq V_0).symm
      _ = (U_Y0 ⊔ U_Y1) ⊓ V_0 := by rw [hCovY]
      _ = (U_Y0 ⊓ V_0) ⊔ (U_Y1 ⊓ V_0) := inf_sup_right _ _ _
      _ = U_Y0 ⊔ (U_Y0 ⊓ U_Y1) := by rw [hU0_V0, hU1_V0]
      _ = U_Y0 := sup_inf_self
  have hpre1 : V_1 = U_Y1 := by
    calc V_1 = ⊤ ⊓ V_1 := (top_inf_eq V_1).symm
      _ = (U_Y0 ⊔ U_Y1) ⊓ V_1 := by rw [hCovY]
      _ = (U_Y0 ⊓ V_1) ⊔ (U_Y1 ⊓ V_1) := inf_sup_right _ _ _
      _ = (U_Y0 ⊓ U_Y1) ⊔ U_Y1 := by rw [hU0_V1, hU1_V1]
      _ = U_Y1 := by rw [sup_comm, inf_comm]; exact sup_inf_self

  
  have hD_top : (⨆ a : Fin (1 + 1),
      AlgebraicGeometry.Proj.basicOpen 𝒜₁ (MvPolynomial.X a)) = ⊤ :=
    AlgebraicGeometry.Proj.iSup_basicOpen_eq_top 𝒜₁ MvPolynomial.X hIrrel
  have hChartFin : ∀ (a : Fin (1 + 1))
      (hXa : (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) k₀) ∈ 𝒜₁ 1)
      (U : Y.Opens) (hAff : AlgebraicGeometry.IsAffineOpen U)
      (ψ : HomogeneousLocalization.Away 𝒜₁ (MvPolynomial.X a) →+*
        ↑(Y.presheaf.obj (Opposite.op U)))
      (hψ_fin : ψ.Finite)
      (hpre : (TopologicalSpace.Opens.map π_bar.base).obj
        (AlgebraicGeometry.Proj.basicOpen 𝒜₁ (MvPolynomial.X a)) = U)
      (hUπ : U.ι ≫ π_bar = U.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫
        AlgebraicGeometry.Proj.awayι 𝒜₁ (MvPolynomial.X a) hXa zero_lt_one),
      AlgebraicGeometry.IsFinite
        (π_bar ∣_ AlgebraicGeometry.Proj.basicOpen 𝒜₁ (MvPolynomial.X a)) := by
    intro a hXa U hAff ψ hψ_fin hpre hUπ
    let D_a : (AlgebraicGeometry.Proj 𝒜₁).Opens :=
      AlgebraicGeometry.Proj.basicOpen 𝒜₁ (MvPolynomial.X a)
    let V_a : Y.Opens := (TopologicalSpace.Opens.map π_bar.base).obj D_a
    have : AlgebraicGeometry.IsFinite (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) := by
      rw [AlgebraicGeometry.IsFinite.SpecMap_iff]
      exact hψ_fin
    let g_a : V_a.toScheme ⟶ D_a.toScheme :=
      (Y.isoOfEq hpre).hom ≫ hAff.isoSpec.hom ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫
        (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜₁ (MvPolynomial.X a) hXa zero_lt_one).inv
    have hg_eq : (π_bar ∣_ D_a) = g_a := by
      rw [← cancel_mono D_a.ι, AlgebraicGeometry.morphismRestrict_ι]
      dsimp only [g_a]
      rw [Category.assoc, Category.assoc, Category.assoc,
        AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜₁ (MvPolynomial.X a) hXa zero_lt_one,
        hAff.isoSpec_hom, ← hUπ, ← Category.assoc, Y.isoOfEq_hom_ι]
    rw [hg_eq]
    dsimp only [g_a]
    infer_instance
  have hπ_fin : AlgebraicGeometry.IsFinite π_bar := by
    have hZar := @AlgebraicGeometry.IsZariskiLocalAtTarget.iff_of_iSup_eq_top
      (@AlgebraicGeometry.IsFinite.{u})
      (@AlgebraicGeometry.HasAffineProperty.instIsZariskiLocalAtTarget
        (@AlgebraicGeometry.IsFinite.{u}) _
        AlgebraicGeometry.IsFinite.instHasAffinePropertyAndIsAffineFiniteCarrierObjOppositeOpensCarrierCarrierCommRingCatPresheafOpOpensTopHomAppTop)
      Y (AlgebraicGeometry.Proj 𝒜₁) π_bar (Fin (1 + 1))
      (fun a => AlgebraicGeometry.Proj.basicOpen 𝒜₁ (MvPolynomial.X a)) hD_top
    rw [hZar]
    intro a
    fin_cases a
    · exact hChartFin 0 hX0 U_Y0 hAff0 ψ₀
        (hFin0.comp (RingEquiv.finite θ₀.symm)) hpre0 hπ0
    · exact hChartFin 1 hX1 U_Y1 hAff1 ψ₁
        (hFin1.comp (RingEquiv.finite θ₁.symm)) hpre1 hπ1

  
  let hD1 : AlgebraicGeometry.IsAffineOpen D_1 :=
    AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜₁ (MvPolynomial.X 1) hX1 zero_lt_one
  have hBridge1 : AlgebraicGeometry.Spec.map (AlgebraicGeometry.Proj.awayToSection 𝒜₁ (MvPolynomial.X 1)) ≫
      AlgebraicGeometry.Proj.awayι 𝒜₁ (MvPolynomial.X 1) hX1 zero_lt_one = hD1.fromSpec := by
    let R1 := CommRingCat.of (HomogeneousLocalization.Away 𝒜₁ (MvPolynomial.X 1))
    have h1 : AlgebraicGeometry.Proj.basicOpenToSpec 𝒜₁ (MvPolynomial.X 1) ≫
        (AlgebraicGeometry.Spec R1).toSpecΓ =
        D_1.toScheme.toSpecΓ ≫ AlgebraicGeometry.Spec.map
          ((AlgebraicGeometry.Proj.basicOpenToSpec 𝒜₁ (MvPolynomial.X 1)).appTop) :=
      AlgebraicGeometry.Scheme.toSpecΓ_naturality
        (AlgebraicGeometry.Proj.basicOpenToSpec 𝒜₁ (MvPolynomial.X 1))
    have htop : (AlgebraicGeometry.Proj.basicOpenToSpec 𝒜₁ (MvPolynomial.X 1)).appTop =
        (AlgebraicGeometry.Scheme.ΓSpecIso R1).hom ≫
          AlgebraicGeometry.Proj.awayToSection 𝒜₁ (MvPolynomial.X 1) ≫ D_1.topIso.inv :=
      AlgebraicGeometry.Proj.basicOpenToSpec_app_top 𝒜₁ (MvPolynomial.X 1)
    have h2 : hD1.isoSpec.hom ≫
        AlgebraicGeometry.Spec.map (AlgebraicGeometry.Proj.awayToSection 𝒜₁ (MvPolynomial.X 1)) =
        AlgebraicGeometry.Proj.basicOpenToSpec 𝒜₁ (MvPolynomial.X 1) := by
      have h1' := (h1 =≫ (AlgebraicGeometry.Spec R1).isoSpec.inv).symm
      have hSpec_id : (AlgebraicGeometry.Spec R1).toSpecΓ ≫
          (AlgebraicGeometry.Spec R1).isoSpec.inv = 𝟙 _ := by
        rw [← AlgebraicGeometry.Scheme.isoSpec_hom, Iso.hom_inv_id]
      rw [Category.assoc (AlgebraicGeometry.Proj.basicOpenToSpec _ _), hSpec_id, Category.comp_id,
        AlgebraicGeometry.Scheme.isoSpec_Spec_inv R1, htop,
        AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp,
        Category.assoc, Category.assoc, Category.assoc,
        ← AlgebraicGeometry.Spec.map_comp, Iso.inv_hom_id,
        AlgebraicGeometry.Spec.map_id, Category.comp_id] at h1'
      rw [hD1.isoSpec_hom]
      exact (Category.assoc D_1.toScheme.toSpecΓ _ _).trans h1'
    rw [← AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜₁ (MvPolynomial.X 1) hX1 zero_lt_one,
      ← Category.assoc]
    have h3 : AlgebraicGeometry.Spec.map (AlgebraicGeometry.Proj.awayToSection 𝒜₁ (MvPolynomial.X 1)) ≫
        (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜₁ (MvPolynomial.X 1) hX1 zero_lt_one).inv =
        hD1.isoSpec.inv := by
      rw [← cancel_epi hD1.isoSpec.hom, ← Category.assoc, h2,
        ← AlgebraicGeometry.Proj.basicOpenIsoSpec_hom 𝒜₁ (MvPolynomial.X 1) hX1 zero_lt_one,
        Iso.hom_inv_id, Iso.hom_inv_id]
    rw [h3, ← cancel_epi hD1.isoSpec.hom, Iso.hom_inv_id_assoc, hD1.isoSpec_hom,
      hD1.toSpecΓ_fromSpec]

  have hSecPull1 : ∀ (hU1_le : U_Y1 ≤ V_1),
      (π_bar.appLE D_1 U_Y1 hU1_le).hom
        ((AlgebraicGeometry.Proj.awayToSection 𝒜₁ (MvPolynomial.X 1)).hom
          (HomogeneousLocalization.Away.mk 𝒜₁ hX1 1 (MvPolynomial.X 0) hX0)) = s_bar := by
    intro hU1_le
    have happ : AlgebraicGeometry.Spec.map (π_bar.appLE D_1 U_Y1 hU1_le) ≫ hD1.fromSpec =
        hAff1.fromSpec ≫ π_bar :=
      AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec π_bar hD1 hAff1 hU1_le
    have hfrom_U1 : hAff1.fromSpec = hAff1.isoSpec.inv ≫ U_Y1.ι := by
      rw [← cancel_epi hAff1.isoSpec.hom, Iso.hom_inv_id_assoc, hAff1.isoSpec_hom,
        hAff1.toSpecΓ_fromSpec]
    rw [← hBridge1, hfrom_U1, Category.assoc hAff1.isoSpec.inv, hπ1] at happ
    dsimp only [π₁] at happ
    rw [← Category.assoc hAff1.isoSpec.inv, ← hAff1.isoSpec_hom, Iso.inv_hom_id,
      Category.id_comp, ← Category.assoc] at happ
    have hspec_eq : AlgebraicGeometry.Spec.map
        (AlgebraicGeometry.Proj.awayToSection 𝒜₁ (MvPolynomial.X 1) ≫
          π_bar.appLE D_1 U_Y1 hU1_le) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁) := by
      rw [AlgebraicGeometry.Spec.map_comp]
      exact (cancel_mono (AlgebraicGeometry.Proj.awayι 𝒜₁ (MvPolynomial.X 1) hX1 zero_lt_one)).mp happ
    have hhom_eq := AlgebraicGeometry.Spec.map_injective hspec_eq
    have heval := congrArg (fun φ => φ.hom
      (HomogeneousLocalization.Away.mk 𝒜₁ hX1 1 (MvPolynomial.X 0) hX0)) hhom_eq
    dsimp only [CommRingCat.hom_comp, RingHom.coe_comp, Function.comp_apply,
      CommRingCat.hom_ofHom] at heval
    rw [heval, ← hθ₁_X]
    simp [ψ₁]

  
  let π_bar_out : Y ⟶ (weilProjectiveSpaceOver k₀ 1).left := π_bar
  refine ⟨π_bar_out, hk₁, hπ_comm, hSec, hInj, hSm, hHit, hπ_fin, ?_, W_bar, t_bar, u_bar, ?_⟩
  · change (V_0 : Set ↥Y) = (⋃ i : Fin (r_pts + 1), Set.range (σ_bar i).base)ᶜ
    rw [hpre0]
    exact hUY0_set
  · intro i
    obtain ⟨a, hW_le1, hs_eq⟩ := hW_in1 i
    have hW_U1 : W_bar i ≤ U_Y1 := hW_le1.trans (le_iSup U_1_comp a)
    have hW_le : W_bar i ≤ V_1 := hW_U1.trans_eq hpre1.symm
    obtain ⟨hW_aff, hW_mem, hu_unit, hW_inf, ⟨hσ_le, hker⟩, _⟩ := hW i
    refine ⟨hW_le, hσ_le, hX1, hX0, hW_aff, hW_mem, hu_unit, ?_, hker, ?_⟩
    · change W_bar i ⊓ V_0 = Y.basicOpen (t_bar i)
      rw [hpre0]
      exact hW_inf
    · have happ_res : π_bar.appLE D_1 U_Y1 (le_of_eq hpre1.symm) ≫
          Y.presheaf.map (CategoryTheory.homOfLE hW_U1).op =
          π_bar.appLE D_1 (W_bar i) hW_le :=
        AlgebraicGeometry.Scheme.Hom.appLE_map π_bar (le_of_eq hpre1.symm)
          (CategoryTheory.homOfLE hW_U1).op
      change (π_bar.appLE D_1 (W_bar i) hW_le).hom _ = _
      rw [← happ_res]
      change (Y.presheaf.map (CategoryTheory.homOfLE hW_U1).op).hom
        ((π_bar.appLE D_1 U_Y1 (le_of_eq hpre1.symm)).hom
          ((AlgebraicGeometry.Proj.awayToSection 𝒜₁ (MvPolynomial.X 1)).hom
            (HomogeneousLocalization.Away.mk 𝒜₁ hX1 1 (MvPolynomial.X 0) hX0))) = _
      rw [hSecPull1 (le_of_eq hpre1.symm)]
      have hres_comp : Y.presheaf.map (CategoryTheory.homOfLE hW_U1).op =
          Y.presheaf.map (CategoryTheory.homOfLE (le_iSup U_1_comp a)).op ≫
            Y.presheaf.map (CategoryTheory.homOfLE hW_le1).op := by
        rw [← Y.presheaf.map_comp]; rfl
      rw [hres_comp]
      change (Y.presheaf.map (CategoryTheory.homOfLE hW_le1).op).hom (res1 a s_bar) = _
      rw [hs_res a, hs_eq]

theorem weil_nodal_closed_fiber_finite_polar_projLine_map (k₀ : Type u) [Field k₀] [IsAlgClosed k₀]
    (Y : AlgebraicGeometry.Scheme.{u})
    (p_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of k₀))
    (hPropY : AlgebraicGeometry.IsProper p_Y)
    (hConnY : ConnectedSpace ↥Y)
    (hNodalY : ∀ y : ↥Y,
      (∃ V_sm : Y.Opens, y ∈ V_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ p_Y)) ∨
      (∃ (U' : AlgebraicGeometry.Scheme.{u}) (u₀ : U')
          (e₁ : U' ⟶ Y)
          (e₂ : U' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
            (MvPolynomial (Fin 2) k₀ ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}))),
        AlgebraicGeometry.Etale e₁ ∧
        AlgebraicGeometry.Etale e₂ ∧
        e₁.base u₀ = y ∧
        (∀ i : Fin 2, Ideal.Quotient.mk _ (MvPolynomial.X i) ∈ (e₂.base u₀).asIdeal) ∧
        e₁ ≫ p_Y =
          e₂ ≫ AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)))) :
    ∃ (r_pts k₁ : ℕ)
      (σ_bar : Fin (r_pts + 1) → (AlgebraicGeometry.Spec (CommRingCat.of k₀) ⟶ Y))
      (π_bar : Y ⟶ (weilProjectiveSpaceOver k₀ 1).left),
      IsClosedFiberPolarProjLineMap k₀ p_Y r_pts k₁ σ_bar π_bar :=
by
  obtain ⟨hRedY, U_sm, L_comp, Y_comp, ι_comp, U_part,
      _hSmU, hSingFin, hNodalOut, hCompCover, hCompMem, hPartSup, hPartDisj, hCompProps⟩ :=
    weil_nodal_curve_reduced_smooth_open_and_component_decomp k₀ Y p_Y hPropY hConnY hNodalY
  have hPartSub : ∀ a : Fin (L_comp + 1), (U_part a : Set ↥Y) ⊆ Set.range (ι_comp a).base := by
    intro a
    rw [(hCompProps a).2.2.2.2.2.1]
    exact Set.inter_subset_left
  have hS2_all := fun a : Fin (L_comp + 1) =>
    weil_integral_proper_curve_normalization_crt_polar_family k₀ Y (Y_comp a) p_Y (ι_comp a)
      (hCompProps a).1 (hCompProps a).2.1 (hCompProps a).2.2.1 (hCompProps a).2.2.2.1
      (U_part a) (hPartSub a) (hCompProps a).2.2.2.2.2.2.1
      (hCompProps a).2.2.2.2.2.2.2.1 (hCompProps a).2.2.2.2.2.2.2.2
  choose Y_tilde ι_tilde m_pts K_bound σ_comp hS2 using hS2_all
  let pt₀ : PrimeSpectrum k₀ := ⊥
  have hSpecSub : ∀ q : ↥(AlgebraicGeometry.Spec (CommRingCat.of k₀)), q = pt₀ :=
    fun q => Subsingleton.elim q pt₀
  have hRangeEq : ∀ (s : AlgebraicGeometry.Spec (CommRingCat.of k₀) ⟶ Y),
      Set.range s.base = {s.base pt₀} := by
    intro s
    ext y
    simp only [Set.mem_range, Set.mem_singleton_iff]
    refine ⟨?_, fun hy => ⟨pt₀, hy.symm⟩⟩
    rintro ⟨q, rfl⟩
    rw [hSpecSub q]
  let Idx := Σ a : Fin (L_comp + 1), Fin (m_pts a + 1)
  have : Nonempty Idx := ⟨⟨0, 0⟩⟩
  have hCardPos : 0 < Fintype.card Idx := Fintype.card_pos
  let r_pts : ℕ := Fintype.card Idx - 1
  have hr_card : Fintype.card Idx = r_pts + 1 := (Nat.sub_add_cancel hCardPos).symm
  let eIdx : Fin (r_pts + 1) ≃ Idx := (Fintype.equivFinOfCardEq hr_card).symm
  let σ_bar : Fin (r_pts + 1) → (AlgebraicGeometry.Spec (CommRingCat.of k₀) ⟶ Y) :=
    fun i => σ_comp (eIdx i).1 (eIdx i).2
  have hσ_bar_eq : ∀ (i : Fin (r_pts + 1)) (a : Fin (L_comp + 1)) (j : Fin (m_pts a + 1)),
      eIdx i = ⟨a, j⟩ → σ_bar i = σ_comp a j := by
    intro i a j hij
    change (fun p : Idx => σ_comp p.1 p.2) (eIdx i) = σ_comp a j
    rw [hij]
  have hSec : ∀ i : Fin (r_pts + 1),
      σ_bar i ≫ p_Y = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k₀)) :=
    fun i => (hS2 (eIdx i).1).2.2.2.2.2.2.1 (eIdx i).2
  have hInj : Function.Injective (fun i : Fin (r_pts + 1) => (σ_bar i).base pt₀) := by
    intro i₁ i₂ heq
    apply eIdx.injective
    rcases h₁ : eIdx i₁ with ⟨a₁, j₁⟩
    rcases h₂ : eIdx i₂ with ⟨a₂, j₂⟩
    have heq' : (σ_comp a₁ j₁).base pt₀ = (σ_comp a₂ j₂).base pt₀ := by
      dsimp only at heq
      rwa [hσ_bar_eq i₁ a₁ j₁ h₁, hσ_bar_eq i₂ a₂ j₂ h₂] at heq
    have hy₁ : (σ_comp a₁ j₁).base pt₀ ∈ U_part a₁ :=
      (hS2 a₁).2.2.2.2.2.2.2.2.1 j₁
    have hy₂ : (σ_comp a₁ j₁).base pt₀ ∈ U_part a₂ := by
      rw [heq']
      exact (hS2 a₂).2.2.2.2.2.2.2.2.1 j₂
    have ha : a₁ = a₂ := by
      by_contra hne
      exact (hPartDisj hne).le_bot ⟨hy₁, hy₂⟩
    subst ha
    have hj : j₁ = j₂ := (hS2 a₁).2.2.2.2.2.2.2.1 heq'
    subst hj
    rfl
  have hSm : ∀ i : Fin (r_pts + 1), ∃ V_sm : Y.Opens,
      (σ_bar i).base pt₀ ∈ V_sm ∧
      AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ p_Y) := by
    intro i
    exact ⟨U_part (eIdx i).1, (hS2 (eIdx i).1).2.2.2.2.2.2.2.2.1 (eIdx i).2,
      (hCompProps (eIdx i).1).2.2.2.2.2.2.2.1⟩
  have hHit : ∀ E ∈ irreducibleComponents ↥Y,
      ∃ i : Fin (r_pts + 1), (σ_bar i).base pt₀ ∈ E := by
    intro E hE
    obtain ⟨a, haE⟩ := hCompCover E hE
    refine ⟨eIdx.symm ⟨a, 0⟩, ?_⟩
    rw [← haE, hσ_bar_eq (eIdx.symm ⟨a, 0⟩) a 0 (eIdx.apply_symm_apply ⟨a, 0⟩)]
    exact hPartSub a ((hS2 a).2.2.2.2.2.2.2.2.1 0)
  have : AlgebraicGeometry.IsProper p_Y := hPropY
  have hClosedRange : ∀ i : Fin (r_pts + 1), IsClosed (Set.range (σ_bar i).base) := by
    intro i
    have : AlgebraicGeometry.IsProper (σ_bar i ≫ p_Y) := by
      rw [hSec i]
      infer_instance
    have : AlgebraicGeometry.IsProper (σ_bar i) :=
      AlgebraicGeometry.IsProper.of_comp (σ_bar i) p_Y
    rw [← Set.image_univ]
    exact AlgebraicGeometry.Scheme.Hom.isClosedMap (σ_bar i) _ isClosed_univ
  let U_Y0 : Y.Opens :=
    ⟨(⋃ i : Fin (r_pts + 1), Set.range (σ_bar i).base)ᶜ,
      (isClosed_iUnion_of_finite hClosedRange).isOpen_compl⟩
  have hUY0_set : (U_Y0 : Set ↥Y) = (⋃ i : Fin (r_pts + 1), Set.range (σ_bar i).base)ᶜ := rfl
  have hSingIn0 : (U_sm : Set ↥Y)ᶜ ⊆ (U_Y0 : Set ↥Y) := by
    rw [hUY0_set]
    apply Set.compl_subset_compl.mpr
    intro y hy
    rw [Set.mem_iUnion] at hy
    obtain ⟨i, hy⟩ := hy
    rw [hRangeEq, Set.mem_singleton_iff] at hy
    rw [hy]
    exact (hCompProps (eIdx i).1).2.2.2.2.1 ((hS2 (eIdx i).1).2.2.2.2.2.2.2.2.1 (eIdx i).2)
  have hUY0_inter : ∀ a : Fin (L_comp + 1),
      (U_Y0 : Set ↥Y) ∩ Set.range (ι_comp a).base =
        Set.range (ι_comp a).base \ (⋃ j : Fin (m_pts a + 1), Set.range (σ_comp a j).base) := by
    intro a
    ext y
    simp only [hUY0_set, Set.mem_inter_iff, Set.mem_compl_iff, Set.mem_iUnion, Set.mem_diff]
    refine ⟨fun ⟨hy0, hya⟩ => ⟨hya, ?_⟩, fun ⟨hya, hynot⟩ => ⟨?_, hya⟩⟩
    · rintro ⟨j, hyj⟩
      refine hy0 ⟨eIdx.symm ⟨a, j⟩, ?_⟩
      rwa [hσ_bar_eq (eIdx.symm ⟨a, j⟩) a j (eIdx.apply_symm_apply ⟨a, j⟩)]
    · rintro ⟨i, hyi⟩
      rcases h : eIdx i with ⟨b, j⟩
      have hyi' : y ∈ Set.range (σ_comp b j).base := by
        rwa [hσ_bar_eq i b j h] at hyi
      have hy_pt : y = (σ_comp b j).base pt₀ := by
        rwa [hRangeEq, Set.mem_singleton_iff] at hyi'
      have hy_part_b : y ∈ U_part b := by
        rw [hy_pt]
        exact (hS2 b).2.2.2.2.2.2.2.2.1 j
      have hy_sm : y ∈ (U_sm : Set ↥Y) := (hCompProps b).2.2.2.2.1 hy_part_b
      have hy_part_a : y ∈ U_part a := by
        change y ∈ (U_part a : Set ↥Y)
        rw [(hCompProps a).2.2.2.2.2.1]
        exact ⟨hya, hy_sm⟩
      have hba : b = a := by
        by_contra hne
        exact (hPartDisj hne).le_bot ⟨hy_part_b, hy_part_a⟩
      subst hba
      exact hynot ⟨j, hyi'⟩
  let k₁ : ℕ := max 1 (Finset.univ.sup K_bound)
  have hk₁ : 1 ≤ k₁ := le_max_left _ _
  have hk₁_ge : ∀ a : Fin (L_comp + 1), K_bound a ≤ k₁ := fun a =>
    le_trans (Finset.le_sup (Finset.mem_univ a)) (le_max_right _ _)
  have hAffTilde0 : ∀ a : Fin (L_comp + 1),
      AlgebraicGeometry.IsAffineOpen ((TopologicalSpace.Opens.map (ι_tilde a).base).obj U_Y0) :=
    fun a => ((hS2 a).2.2.2.2.2.2.2.2.2 U_Y0 (hUY0_inter a)).1
  have hPolarComp := fun a : Fin (L_comp + 1) =>
    ((hS2 a).2.2.2.2.2.2.2.2.2 U_Y0 (hUY0_inter a)).2 k₁ (hk₁_ge a)
  choose f_tilde W_comp t_comp u_comp U_1_comp s_1_comp hPolarProps using hPolarComp
  have hSurjAll : (⋃ a : Fin (L_comp + 1), Set.range (ι_tilde a).base) = Set.univ := by
    ext y
    simp only [Set.mem_iUnion, Set.mem_univ, iff_true]
    obtain ⟨a, ha⟩ := hCompCover (irreducibleComponent y) (irreducibleComponent_mem_irreducibleComponents y)
    refine ⟨a, ?_⟩
    rw [(hS2 a).2.2.2.2.1, ha]
    exact mem_irreducibleComponent
  have hCompS3 : ∀ a : Fin (L_comp + 1),
      AlgebraicGeometry.IsIntegral (Y_tilde a) ∧
      (∀ (U : (Y_tilde a).Opens), AlgebraicGeometry.IsAffineOpen U → Nonempty U →
        IsDomain ↑((Y_tilde a).presheaf.obj (Opposite.op U)) ∧
        IsIntegrallyClosed ↑((Y_tilde a).presheaf.obj (Opposite.op U))) ∧
      AlgebraicGeometry.IsFinite (ι_tilde a) ∧
      Set.range (ι_tilde a).base ∈ irreducibleComponents ↥Y ∧
      (U_part a : Set ↥Y) = Set.range (ι_tilde a).base ∩ (U_sm : Set ↥Y) ∧
      Nonempty ↥(U_part a) ∧
      CategoryTheory.IsIso (ι_tilde a ∣_ U_part a) := by
    intro a
    refine ⟨(hS2 a).2.1, (hS2 a).2.2.1, (hS2 a).2.2.2.1, ?_, ?_,
      (hCompProps a).2.2.2.2.2.2.1, (hS2 a).2.2.2.2.2.1⟩
    · rw [(hS2 a).2.2.2.2.1]
      exact hCompMem a
    · rw [(hS2 a).2.2.2.2.1]
      exact (hCompProps a).2.2.2.2.2.1
  obtain ⟨hAff0, f_bar, hf_pull, hf_le_sm, hFin0⟩ :=
    weil_nodal_curve_section_descent_and_open_affineness k₀ Y hRedY p_Y hPropY U_sm hSingFin
      hNodalOut L_comp U_part hPartSup hPartDisj Y_tilde ι_tilde hSurjAll hCompS3 U_Y0 hSingIn0
      hAffTilde0 f_tilde (fun a z hz => ((hPolarProps a).1 z hz).2)
      (fun a => (hPolarProps a).2.1)
  let W_bar : Fin (r_pts + 1) → Y.Opens := fun i => W_comp (eIdx i).1 (eIdx i).2
  have hW_bar_eq : ∀ (i : Fin (r_pts + 1)) (a : Fin (L_comp + 1)) (j : Fin (m_pts a + 1)),
      eIdx i = ⟨a, j⟩ → W_bar i = W_comp a j := by
    intro i a j hij
    change (fun p : Idx => W_comp p.1 p.2) (eIdx i) = W_comp a j
    rw [hij]
  let t_bar : ∀ i : Fin (r_pts + 1), ↑(Y.presheaf.obj (Opposite.op (W_bar i))) :=
    fun i => t_comp (eIdx i).1 (eIdx i).2
  let u_bar : ∀ i : Fin (r_pts + 1), ↑(Y.presheaf.obj (Opposite.op (W_bar i))) :=
    fun i => u_comp (eIdx i).1 (eIdx i).2
  have hf_compat := fun a : Fin (L_comp + 1) =>
    (hPolarProps a).2.2.2.2.2 f_bar (hf_pull a)
  have hW : ∀ i : Fin (r_pts + 1),
      AlgebraicGeometry.IsAffineOpen (W_bar i) ∧
      (σ_bar i).base pt₀ ∈ W_bar i ∧
      IsUnit (u_bar i) ∧
      W_bar i ⊓ U_Y0 = Y.basicOpen (t_bar i) ∧
      (∃ hσ_le : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of k₀)).Opens) ≤
          (TopologicalSpace.Opens.map (σ_bar i).base).obj (W_bar i),
        RingHom.ker (((σ_bar i).appLE (W_bar i) ⊤ hσ_le).hom) = Ideal.span {t_bar i}) ∧
      (∀ hB_le0 : Y.basicOpen (t_bar i) ≤ U_Y0,
        (Y.presheaf.map (CategoryTheory.homOfLE hB_le0).op).hom f_bar *
          (Y.presheaf.map (CategoryTheory.homOfLE
            (Y.basicOpen_le (t_bar i))).op).hom (u_bar i * (t_bar i) ^ k₁) = 1) := by
    intro i
    obtain ⟨_hW_le1, hW_aff, hW_mem, hu_unit, hW_inf, hker, _hs1_eq, hf_inv⟩ :=
      (hf_compat (eIdx i).1).2.2 (eIdx i).2
    exact ⟨hW_aff, hW_mem, hu_unit, hW_inf, hker, hf_inv⟩
  have hDisj1 : _root_.Pairwise fun a b : Fin (L_comp + 1) => Disjoint (U_1_comp a) (U_1_comp b) := by
    intro a b hab
    exact Disjoint.mono (hPolarProps a).2.2.1 (hPolarProps b).2.2.1 (hPartDisj hab)
  have hCov1 : (⨆ a : Fin (L_comp + 1), U_1_comp a) =
      Y.basicOpen f_bar ⊔ ⨆ i : Fin (r_pts + 1), W_bar i := by
    apply SetLike.coe_injective
    ext y
    simp only [TopologicalSpace.Opens.coe_iSup, TopologicalSpace.Opens.coe_sup,
      Set.mem_iUnion, Set.mem_union]
    refine ⟨?_, ?_⟩
    · rintro ⟨a, hya⟩
      rw [(hf_compat a).1] at hya
      rcases hya with ⟨_, hyf⟩ | hW_mem
      · exact Or.inl hyf
      · rw [Set.mem_iUnion] at hW_mem
        obtain ⟨j, hyj⟩ := hW_mem
        refine Or.inr ⟨eIdx.symm ⟨a, j⟩, ?_⟩
        rwa [hW_bar_eq (eIdx.symm ⟨a, j⟩) a j (eIdx.apply_symm_apply ⟨a, j⟩)]
    · rintro (hyf | ⟨i, hyi⟩)
      · have hysm : y ∈ U_sm := hf_le_sm hyf
        rw [← hPartSup] at hysm
        change y ∈ ((⨆ a : Fin (L_comp + 1), U_part a : Y.Opens) : Set ↥Y) at hysm
        rw [TopologicalSpace.Opens.coe_iSup, Set.mem_iUnion] at hysm
        obtain ⟨a, hya⟩ := hysm
        refine ⟨a, ?_⟩
        rw [(hf_compat a).1]
        exact Or.inl ⟨hya, hyf⟩
      · refine ⟨(eIdx i).1, ?_⟩
        rw [(hf_compat (eIdx i).1).1]
        exact Or.inr (Set.mem_iUnion.mpr ⟨(eIdx i).2, hyi⟩)
  have hAffFin1 : ∀ a : Fin (L_comp + 1),
      AlgebraicGeometry.IsAffineOpen (U_1_comp a) ∧
      (Polynomial.eval₂RingHom
        (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
          p_Y.appLE ⊤ (U_1_comp a) le_top).hom) (s_1_comp a)).Finite ∧
      (∀ h_inter : Y.basicOpen f_bar ⊓ U_1_comp a ≤ U_Y0,
        (Y.presheaf.map (CategoryTheory.homOfLE h_inter).op).hom f_bar *
          (Y.presheaf.map (CategoryTheory.homOfLE
            (inf_le_right : Y.basicOpen f_bar ⊓ U_1_comp a ≤ U_1_comp a)).op).hom (s_1_comp a) = 1) :=
    fun a => ⟨(hPolarProps a).2.2.2.1, (hPolarProps a).2.2.2.2.1, (hf_compat a).2.1⟩
  have hW_in1 : ∀ i : Fin (r_pts + 1), ∃ (a : Fin (L_comp + 1)) (hW_le1 : W_bar i ≤ U_1_comp a),
      (Y.presheaf.map (CategoryTheory.homOfLE hW_le1).op).hom (s_1_comp a) =
        u_bar i * (t_bar i) ^ k₁ := by
    intro i
    have hWi := (hf_compat (eIdx i).1).2.2 (eIdx i).2
    exact ⟨(eIdx i).1, hWi.1, hWi.2.2.2.2.2.2.1 hWi.1⟩
  obtain ⟨π_bar, hPolar⟩ :=
    weil_projLine_polar_gluing_and_twoChart_isFinite k₀ Y p_Y r_pts k₁ L_comp hk₁ σ_bar
      hSec hInj hSm hHit U_Y0 hUY0_set hAff0 f_bar hFin0 W_bar t_bar u_bar hW
      U_1_comp s_1_comp hDisj1 hCov1 hAffFin1 hW_in1
  exact ⟨r_pts, k₁, σ_bar, π_bar, hPolar⟩

theorem weil_henselian_etale_algebra_section_isolation (R A k₀ : Type u) [CommRing R] [HenselianLocalRing R]
    [CommRing A] [Algebra R A] [Algebra.Etale R A] [Field k₀]
    (π_R : R →+* k₀)
    (hSurj : Function.Surjective π_R)
    (hKer : RingHom.ker π_R = IsLocalRing.maximalIdeal R)
    (ω : A →+* k₀)
    (hω : ω.comp (algebraMap R A) = π_R) :
    ∃ h : A, ω h ≠ 0 ∧ Function.Bijective (algebraMap R (Localization.Away h)) :=
by
  
  let q : Ideal A := RingHom.ker ω
  have hqPrime : q.IsPrime := RingHom.ker_isPrime ω
  have hq_comap : Ideal.comap (algebraMap R A) q = IsLocalRing.maximalIdeal R := by
    rw [← hKer]
    ext r
    simp only [q, Ideal.mem_comap, RingHom.mem_ker]
    have hcomp : (ω.comp (algebraMap R A)) r = π_R r := by rw [hω]
    exact ⟨fun hr => hcomp.symm.trans hr, fun hr => hcomp.trans hr⟩
  have hStep1 : ∃ (r₀ : A) (R₀ : Subalgebra R A),
      r₀ ∉ q ∧ r₀ ∈ R₀ ∧ Module.Finite R ↥R₀ ∧ ∀ x : A, ∃ m : ℕ, r₀ ^ m * x ∈ R₀ := by
    have hZMT : Algebra.ZariskisMainProperty R q :=
      Algebra.ZariskisMainProperty.of_finiteType q
    rw [Algebra.zariskisMainProperty_iff] at hZMT
    obtain ⟨r₀, hr₀_not_q, hr₀_int, h_int_pow⟩ := hZMT
    obtain ⟨S_gen, hS_gen⟩ : (⊤ : Subalgebra R A).FG := Algebra.FiniteType.out
    classical
    let m_fn : A → ℕ := fun y => Classical.choose (h_int_pow y)
    have hm_fn : ∀ y : A, IsIntegral R (r₀ ^ m_fn y * y) :=
      fun y => Classical.choose_spec (h_int_pow y)
    let G_set : Finset A := insert r₀ (S_gen.image (fun y => r₀ ^ m_fn y * y))
    let R₀ : Subalgebra R A := Algebra.adjoin R (G_set : Set A)
    have hr₀_mem : r₀ ∈ R₀ :=
      Algebra.subset_adjoin (Finset.mem_insert_self r₀ _)
    have hFT_R₀ : Algebra.FiniteType R ↥R₀ :=
      Algebra.FiniteType.adjoin_of_finite G_set.finite_toSet
    have hR₀_le_int : R₀ ≤ integralClosure R A := by
      rw [Algebra.adjoin_le_iff]
      intro x hx
      rcases Finset.mem_insert.mp hx with rfl | hx_img
      · exact hr₀_int
      · rcases Finset.mem_image.mp hx_img with ⟨y, _, rfl⟩
        exact hm_fn y
    have hInt_R₀ : Algebra.IsIntegral R ↥R₀ := by
      refine ⟨fun z => ?_⟩
      obtain ⟨p, hp_monic, hp_eval⟩ := hR₀_le_int z.2
      have hcomp : R₀.val.comp (Polynomial.aeval z) = Polynomial.aeval z.1 := by
        ext
        simp
      refine ⟨p, hp_monic, Subtype.ext ?_⟩
      change (R₀.val.comp (Polynomial.aeval z)) p = 0
      rw [hcomp]
      exact hp_eval
    have hFin_R₀ : Module.Finite R ↥R₀ := Algebra.IsIntegral.finite
    let S_sat : Subalgebra R A :=
      { carrier := {x : A | ∃ m : ℕ, r₀ ^ m * x ∈ R₀}
        mul_mem' := by
          rintro a b ⟨m₁, hm₁⟩ ⟨m₂, hm₂⟩
          refine ⟨m₁ + m₂, ?_⟩
          have h_eq : r₀ ^ (m₁ + m₂) * (a * b) = (r₀ ^ m₁ * a) * (r₀ ^ m₂ * b) := by ring
          rw [h_eq]
          exact R₀.mul_mem hm₁ hm₂
        one_mem' := ⟨0, by simp [R₀.one_mem]⟩
        add_mem' := by
          rintro a b ⟨m₁, hm₁⟩ ⟨m₂, hm₂⟩
          refine ⟨m₁ + m₂, ?_⟩
          have h_eq : r₀ ^ (m₁ + m₂) * (a + b) =
              r₀ ^ m₂ * (r₀ ^ m₁ * a) + r₀ ^ m₁ * (r₀ ^ m₂ * b) := by ring
          rw [h_eq]
          exact R₀.add_mem (R₀.mul_mem (R₀.pow_mem hr₀_mem m₂) hm₁)
            (R₀.mul_mem (R₀.pow_mem hr₀_mem m₁) hm₂)
        zero_mem' := ⟨0, by simp [R₀.zero_mem]⟩
        algebraMap_mem' := fun r => ⟨0, by simp [R₀.algebraMap_mem r]⟩ }
    have hTop_le : (⊤ : Subalgebra R A) ≤ S_sat := by
      rw [← hS_gen, Algebra.adjoin_le_iff]
      intro y hy
      refine ⟨m_fn y, Algebra.subset_adjoin ?_⟩
      exact Finset.mem_insert_of_mem (Finset.mem_image_of_mem _ hy)
    exact ⟨r₀, R₀, hr₀_not_q, hr₀_mem, hFin_R₀, fun x => hTop_le Algebra.mem_top⟩
  obtain ⟨r₀, R₀, hr₀_not_q, hr₀_mem, hFinR₀, hsat⟩ := hStep1
  have : Module.Finite R ↥R₀ := hFinR₀
  have hr₀_ω : ω r₀ ≠ 0 := hr₀_not_q

  
  let J_m : Ideal ↥R₀ := Ideal.map (algebraMap R ↥R₀) (RingHom.ker π_R)
  have hStep2 : ∃ e₀ : ↥R₀,
      ω e₀.1 = 1 ∧
      e₀ * e₀ - e₀ ∈ J_m ∧
      ∀ y : ↥R₀, ∃ c : R, e₀ * y - algebraMap R ↥R₀ c * e₀ ∈ J_m := by
    
    have hAbar_pkg : ∃ (A_bar : Type u) (_ : CommRing A_bar) (_ : IsArtinianRing A_bar)
        (π_bar : ↥R₀ →+* A_bar) (ι_k₀ : k₀ →+* A_bar) (ω_bar : A_bar →+* k₀),
        Function.Surjective π_bar ∧
        RingHom.ker π_bar = J_m ∧
        (∀ r : R, ι_k₀ (π_R r) = π_bar (algebraMap R ↥R₀ r)) ∧
        (∀ y : ↥R₀, ω_bar (π_bar y) = ω y.1) ∧
        (∀ c : k₀, ω_bar (ι_k₀ c) = c) := by
      let I_R : Ideal R := RingHom.ker π_R
      let A_bar₀ : Type u := ↥R₀ ⧸ J_m
      let π_bar₀ : ↥R₀ →+* A_bar₀ := Ideal.Quotient.mk J_m
      have hf_R_ker : I_R ≤ RingHom.ker (π_bar₀.comp (algebraMap R ↥R₀)) := by
        intro r hr
        rw [RingHom.mem_ker, RingHom.comp_apply]
        exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem _ hr)
      let ι_k₀ : k₀ →+* A_bar₀ :=
        (Ideal.Quotient.lift I_R (π_bar₀.comp (algebraMap R ↥R₀)) hf_R_ker).comp
          (RingHom.quotientKerEquivOfSurjective hSurj).symm.toRingHom
      have hι_k₀_apply : ∀ r : R, ι_k₀ (π_R r) = π_bar₀ (algebraMap R ↥R₀ r) := by
        intro r
        dsimp [ι_k₀]
        rw [RingHom.quotientKerEquivOfSurjective_symm_apply hSurj r]
        rfl
      have hArt : IsArtinianRing A_bar₀ := by
        letI : Algebra R k₀ := π_R.toAlgebra
        letI : Algebra k₀ A_bar₀ := ι_k₀.toAlgebra
        have : IsScalarTower R k₀ A_bar₀ :=
          IsScalarTower.of_algebraMap_eq' (RingHom.ext fun r => (hι_k₀_apply r).symm)
        have : Module.Finite R A_bar₀ :=
          Module.Finite.of_surjective (Ideal.Quotient.mkₐ R J_m).toLinearMap
            Ideal.Quotient.mk_surjective
        have : Module.Finite k₀ A_bar₀ :=
          Module.Finite.of_restrictScalars_finite R k₀ A_bar₀
        exact isArtinian_of_tower k₀ inferInstance
      let ω₀ : ↥R₀ →+* k₀ := ω.comp R₀.val.toRingHom
      have hJ_le_ω₀ : J_m ≤ RingHom.ker ω₀ := by
        rw [Ideal.map_le_iff_le_comap]
        intro r hr
        change ω (algebraMap R A r) = 0
        have h1 : (ω.comp (algebraMap R A)) r = π_R r := by rw [hω]
        exact h1.trans hr
      let ω_bar₀ : A_bar₀ →+* k₀ := Ideal.Quotient.lift J_m ω₀ hJ_le_ω₀
      have hω_bar_mk : ∀ y : ↥R₀, ω_bar₀ (π_bar₀ y) = ω y.1 := fun _ => rfl
      have hω_bar_ι : ∀ c : k₀, ω_bar₀ (ι_k₀ c) = c := by
        intro c
        obtain ⟨r, rfl⟩ := hSurj c
        rw [hι_k₀_apply, hω_bar_mk]
        change (ω.comp (algebraMap R A)) r = π_R r
        rw [hω]
      exact ⟨A_bar₀, inferInstance, hArt, π_bar₀, ι_k₀, ω_bar₀,
        Ideal.Quotient.mk_surjective, Ideal.mk_ker, hι_k₀_apply, hω_bar_mk, hω_bar_ι⟩
    obtain ⟨A_bar, instCRAbar, instArtAbar, π_bar, ι_k₀, ω_bar,
      hSurj_πbar, hKer_πbar, hι_k₀_apply, hω_bar_mk, hω_bar_ι⟩ := hAbar_pkg
    letI := instCRAbar
    haveI := instArtAbar
    have hSurj_ωbar : Function.Surjective ω_bar := fun c => ⟨ι_k₀ c, hω_bar_ι c⟩
    let p_bar : Ideal A_bar := RingHom.ker ω_bar
    have hp_bar_max : p_bar.IsMaximal := RingHom.ker_isMaximal_of_surjective ω_bar hSurj_ωbar
    have hp_bar_prime : p_bar.IsPrime := RingHom.ker_isPrime ω_bar
    
    let I₀ : MaximalSpectrum A_bar := ⟨p_bar, hp_bar_max⟩
    let v_ind : ∀ I : MaximalSpectrum A_bar, A_bar ⧸ I.asIdeal :=
      fun I => @ite _ (I = I₀) (Classical.propDecidable _) 1 0
    have hv_ind_idem : IsIdempotentElem v_ind := by
      funext I
      change v_ind I * v_ind I = v_ind I
      dsimp only [v_ind]
      split_ifs <;> simp
    let e_art := IsArtinianRing.quotNilradicalEquivPi A_bar
    let u_red : A_bar ⧸ nilradical A_bar := e_art.symm v_ind
    have hu_red_idem : IsIdempotentElem u_red := by
      change e_art.symm v_ind * e_art.symm v_ind = e_art.symm v_ind
      rw [← map_mul, hv_ind_idem.eq]
    let q_nil : A_bar →+* A_bar ⧸ nilradical A_bar := Ideal.Quotient.mk (nilradical A_bar)
    have hker_nil : ∀ x ∈ RingHom.ker q_nil, IsNilpotent x := by
      intro x hx
      rw [Ideal.mk_ker] at hx
      exact mem_nilradical.mp hx
    have hu_in_range : u_red ∈ q_nil.range := Ideal.Quotient.mk_surjective u_red
    obtain ⟨ebar, hebar_idem, hebar_qnil⟩ :=
      exists_isIdempotentElem_eq_of_ker_isNilpotent q_nil hker_nil u_red hu_in_range hu_red_idem
    have hebar_at : ∀ I : MaximalSpectrum A_bar,
        Ideal.Quotient.mk I.asIdeal ebar = v_ind I := by
      intro I
      have h_comm : e_art (q_nil ebar) =
          algebraMap A_bar (∀ J : MaximalSpectrum A_bar, A_bar ⧸ J.asIdeal) ebar :=
        e_art.commutes ebar
      have h_eq : algebraMap A_bar (∀ J : MaximalSpectrum A_bar, A_bar ⧸ J.asIdeal) ebar =
          v_ind := by
        rw [← h_comm, hebar_qnil]
        exact e_art.apply_symm_apply v_ind
      exact congrFun h_eq I
    have hebar_ω : ω_bar ebar = 1 := by
      have h_at_I₀ := hebar_at I₀
      dsimp only [v_ind] at h_at_I₀
      simp only [↓reduceIte] at h_at_I₀
      change Ideal.Quotient.mk p_bar ebar = Ideal.Quotient.mk p_bar 1 at h_at_I₀
      have hsub : ebar - 1 ∈ p_bar := Ideal.Quotient.eq.mp h_at_I₀
      have h0 : ω_bar (ebar - 1) = 0 := hsub
      rw [map_sub, map_one, sub_eq_zero] at h0
      exact h0
    have hebar_iso_prime : ∀ (Q : Ideal A_bar) [Q.IsPrime], ebar ∉ Q → Q = p_bar := by
      intro Q hQPrime hnotMem
      have hQMax : Q.IsMaximal := IsArtinianRing.isMaximal_of_isPrime Q
      let I_Q : MaximalSpectrum A_bar := ⟨Q, hQMax⟩
      by_contra hne
      have hIQ_ne : I_Q ≠ I₀ := fun h => hne (congrArg MaximalSpectrum.asIdeal h)
      have h_at_IQ := hebar_at I_Q
      dsimp only [v_ind] at h_at_IQ
      simp only [hIQ_ne, ↓reduceIte] at h_at_IQ
      exact hnotMem (Ideal.Quotient.eq_zero_iff_mem.mp h_at_IQ)
    have hebar_pow_succ : ∀ n : ℕ, ebar ^ (n + 1) = ebar := by
      intro n
      induction n with
      | zero => simp
      | succ n ih => rw [pow_succ, ih, hebar_idem.eq]
    
    obtain ⟨B_e, instCRBe, instAlgAbarBe, instLocBe⟩ :
        ∃ (B_e : Type u) (_ : CommRing B_e) (_ : Algebra A_bar B_e),
          IsLocalization.Away ebar B_e :=
      ⟨Localization.Away ebar, inferInstance, inferInstance, inferInstance⟩
    letI := instCRBe
    letI := instAlgAbarBe
    haveI := instLocBe
    let j_e : A_bar →+* B_e := algebraMap A_bar B_e
    have hje_ebar : j_e ebar = 1 := by
      have hu : IsUnit (j_e ebar) := IsLocalization.Away.algebraMap_isUnit ebar
      apply hu.mul_left_cancel
      rw [← map_mul, hebar_idem.eq, mul_one]
    have hSurj_je : Function.Surjective j_e := by
      intro z
      obtain ⟨⟨x, s⟩, hzs⟩ := IsLocalization.surj (Submonoid.powers ebar) z
      obtain ⟨n, hn⟩ := s.2
      refine ⟨x, ?_⟩
      have hs1 : j_e s.1 = 1 := by
        rw [← hn, map_pow, hje_ebar, one_pow]
      rw [hs1, mul_one] at hzs
      exact hzs.symm
    have hje_eq_zero : ∀ u : A_bar, j_e u = 0 ↔ ebar * u = 0 := by
      intro u
      constructor
      · intro hu0
        obtain ⟨⟨s, n, rfl⟩, hsu⟩ :=
          (IsLocalization.map_eq_zero_iff (Submonoid.powers ebar) B_e u).mp hu0
        cases n with
        | zero =>
          simp only [pow_zero, one_mul] at hsu
          rw [hsu, mul_zero]
        | succ n =>
          simpa [hebar_pow_succ n] using hsu
      · intro heu
        calc
          j_e u = 1 * j_e u := (one_mul _).symm
          _ = j_e ebar * j_e u := by rw [hje_ebar]
          _ = j_e (ebar * u) := (map_mul j_e ebar u).symm
          _ = 0 := by rw [heu, map_zero]
    have : IsNoetherianRing B_e := isNoetherianRing_of_surjective A_bar B_e j_e hSurj_je
    have hu_ωbar_ebar : IsUnit (ω_bar ebar) := by
      rw [hebar_ω]
      exact isUnit_one
    let ω_Be : B_e →+* k₀ := IsLocalization.Away.lift ebar hu_ωbar_ebar
    have hω_Be_je : ∀ u : A_bar, ω_Be (j_e u) = ω_bar u :=
      IsLocalization.Away.lift_eq ebar hu_ωbar_ebar
    have hSurj_ωBe : Function.Surjective ω_Be := by
      intro c
      exact ⟨j_e (ι_k₀ c), by rw [hω_Be_je, hω_bar_ι]⟩
    let M₀ : Ideal B_e := RingHom.ker ω_Be
    have hM₀_max : M₀.IsMaximal := RingHom.ker_isMaximal_of_surjective ω_Be hSurj_ωBe
    have : Nontrivial B_e := by
      refine ⟨⟨1, 0, fun h10 => ?_⟩⟩
      have : (1 : k₀) = 0 := by
        simpa using congrArg ω_Be h10
      exact one_ne_zero this
    have hnotUnit_iff : ∀ z : B_e, ¬ IsUnit z ↔ z ∈ M₀ := by
      intro z
      constructor
      · intro hz
        obtain ⟨Q_B, hQB_max, hz_QB⟩ :=
          Ideal.exists_le_maximal (Ideal.span {z}) (Ideal.span_singleton_ne_top hz)
        have : Q_B.IsPrime := hQB_max.isPrime
        let Q_A : Ideal A_bar := Ideal.comap j_e Q_B
        have : Q_A.IsPrime := Ideal.IsPrime.comap j_e
        have hebar_not_QA : ebar ∉ Q_A := by
          intro hmem
          have h1_mem : (1 : B_e) ∈ Q_B := by
            rw [← hje_ebar]
            exact hmem
          exact hQB_max.ne_top (Ideal.eq_top_of_isUnit_mem Q_B h1_mem isUnit_one)
        have hQA_eq : Q_A = p_bar := hebar_iso_prime Q_A hebar_not_QA
        obtain ⟨x, rfl⟩ := hSurj_je z
        have hx_QA : x ∈ Q_A := hz_QB (Ideal.subset_span rfl)
        rw [hQA_eq] at hx_QA
        change ω_Be (j_e x) = 0
        rw [hω_Be_je]
        exact hx_QA
      · intro hz hu
        have hu_k : IsUnit (ω_Be z) := hu.map ω_Be
        have hz0 : ω_Be z = 0 := hz
        rw [hz0] at hu_k
        exact not_isUnit_zero hu_k
    have : IsLocalRing B_e := by
      refine IsLocalRing.of_isUnit_or_isUnit_one_sub_self (fun z => ?_)
      by_cases hz : IsUnit z
      · exact Or.inl hz
      · right
        have hz_M₀ : z ∈ M₀ := (hnotUnit_iff z).mp hz
        by_contra h1z
        have h1z_M₀ : 1 - z ∈ M₀ := (hnotUnit_iff (1 - z)).mp h1z
        have h0 : ω_Be (1 - z) = 0 := h1z_M₀
        have hz0 : ω_Be z = 0 := hz_M₀
        rw [map_sub, map_one, hz0, sub_zero] at h0
        exact one_ne_zero h0
    have hMax_Be : IsLocalRing.maximalIdeal B_e = M₀ := by
      ext z
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, hnotUnit_iff]
    let r0_sub : ↥R₀ := ⟨r₀, hr₀_mem⟩
    have hr0_unit_Be : IsUnit (j_e (π_bar r0_sub)) := by
      by_contra hnot
      have hmem : j_e (π_bar r0_sub) ∈ M₀ := (hnotUnit_iff _).mp hnot
      have h0 : ω_Be (j_e (π_bar r0_sub)) = 0 := hmem
      rw [hω_Be_je, hω_bar_mk] at h0
      exact hr₀_ω h0
    
    have hD_pkg : ∃ (D : Type u) (_ : CommRing D) (q_D : B_e →+* D) (ω_D : D →+* k₀),
        Function.Surjective q_D ∧
        RingHom.ker q_D = M₀ ^ 2 ∧
        (∀ z : B_e, ω_D (q_D z) = ω_Be z) := by
      let D₀ : Type u := B_e ⧸ (M₀ ^ 2)
      let q_D₀ : B_e →+* D₀ := Ideal.Quotient.mk (M₀ ^ 2)
      have hM₀_sq_le : M₀ ^ 2 ≤ RingHom.ker ω_Be := Ideal.pow_le_self (by norm_num)
      let ω_D₀ : D₀ →+* k₀ := Ideal.Quotient.lift (M₀ ^ 2) ω_Be hM₀_sq_le
      exact ⟨D₀, inferInstance, q_D₀, ω_D₀,
        Ideal.Quotient.mk_surjective, Ideal.mk_ker, fun _ => rfl⟩
    obtain ⟨D, instCRD, q_D, ω_D, hSurj_qD, hKer_qD, hω_D_q⟩ := hD_pkg
    letI := instCRD
    let I_D : Ideal D := RingHom.ker ω_D
    have hID_sq : I_D ^ 2 = ⊥ := by
      rw [pow_two, eq_bot_iff, Submodule.mul_le]
      intro u hu v hv
      obtain ⟨z₁, rfl⟩ := hSurj_qD u
      obtain ⟨z₂, rfl⟩ := hSurj_qD v
      have hz₁ : z₁ ∈ M₀ := by
        change ω_Be z₁ = 0
        rw [← hω_D_q]
        exact hu
      have hz₂ : z₂ ∈ M₀ := by
        change ω_Be z₂ = 0
        rw [← hω_D_q]
        exact hv
      have hprod : z₁ * z₂ ∈ M₀ ^ 2 := by
        rw [pow_two]
        exact Ideal.mul_mem_mul hz₁ hz₂
      rw [Submodule.mem_bot, ← map_mul, ← RingHom.mem_ker, hKer_qD]
      exact hprod
    let α₀ : ↥R₀ →+* D := q_D.comp (j_e.comp π_bar)
    letI : Algebra R D := (α₀.comp (algebraMap R ↥R₀)).toAlgebra
    have hu_α₀_r0 : IsUnit (α₀ r0_sub) := hr0_unit_Be.map q_D
    obtain ⟨v_r, hv_r⟩ := hu_α₀_r0
    
    classical
    let μ_sat : A → ℕ := fun x => Classical.choose (hsat x)
    have hμ_sat : ∀ x : A, r₀ ^ μ_sat x * x ∈ R₀ :=
      fun x => Classical.choose_spec (hsat x)
    let ψ₁_fn : A → D :=
      fun x => (↑v_r⁻¹ : D) ^ μ_sat x * α₀ ⟨r₀ ^ μ_sat x * x, hμ_sat x⟩
    have hψ₁_indep : ∀ (x : A) (m₁ m₂ : ℕ) (hm₁ : r₀ ^ m₁ * x ∈ R₀) (hm₂ : r₀ ^ m₂ * x ∈ R₀),
        (↑v_r⁻¹ : D) ^ m₁ * α₀ ⟨r₀ ^ m₁ * x, hm₁⟩ =
          (↑v_r⁻¹ : D) ^ m₂ * α₀ ⟨r₀ ^ m₂ * x, hm₂⟩ := by
      intro x m₁ m₂ hm₁ hm₂
      have h_R₀ : r0_sub ^ m₂ * ⟨r₀ ^ m₁ * x, hm₁⟩ = r0_sub ^ m₁ * ⟨r₀ ^ m₂ * x, hm₂⟩ := by
        apply Subtype.ext
        change r₀ ^ m₂ * (r₀ ^ m₁ * x) = r₀ ^ m₁ * (r₀ ^ m₂ * x)
        ring
      have h_D := congrArg α₀ h_R₀
      simp only [map_mul, map_pow, ← hv_r] at h_D
      calc
        (↑v_r⁻¹ : D) ^ m₁ * α₀ ⟨r₀ ^ m₁ * x, hm₁⟩
            = (↑v_r⁻¹ : D) ^ m₁ * (((↑v_r⁻¹ : D) ^ m₂ * (v_r : D) ^ m₂) *
                α₀ ⟨r₀ ^ m₁ * x, hm₁⟩) := by
              rw [← mul_pow, Units.inv_mul, one_pow, one_mul]
        _ = (↑v_r⁻¹ : D) ^ m₁ * ((↑v_r⁻¹ : D) ^ m₂ *
              ((v_r : D) ^ m₂ * α₀ ⟨r₀ ^ m₁ * x, hm₁⟩)) := by ring
        _ = (↑v_r⁻¹ : D) ^ m₁ * ((↑v_r⁻¹ : D) ^ m₂ *
              ((v_r : D) ^ m₁ * α₀ ⟨r₀ ^ m₂ * x, hm₂⟩)) := by rw [h_D]
        _ = ((↑v_r⁻¹ : D) ^ m₁ * (v_r : D) ^ m₁) *
              ((↑v_r⁻¹ : D) ^ m₂ * α₀ ⟨r₀ ^ m₂ * x, hm₂⟩) := by ring
        _ = (↑v_r⁻¹ : D) ^ m₂ * α₀ ⟨r₀ ^ m₂ * x, hm₂⟩ := by
              rw [← mul_pow, Units.inv_mul, one_pow, one_mul]
    have hψ₁_spec : ∀ (x : A) (m : ℕ) (hm : r₀ ^ m * x ∈ R₀),
        ψ₁_fn x = (↑v_r⁻¹ : D) ^ m * α₀ ⟨r₀ ^ m * x, hm⟩ :=
      fun x m hm => hψ₁_indep x (μ_sat x) m (hμ_sat x) hm
    have hψ₁_R₀ : ∀ y : ↥R₀, ψ₁_fn y.1 = α₀ y := by
      intro y
      have hm0 : r₀ ^ 0 * y.1 ∈ R₀ := by simpa using y.2
      rw [hψ₁_spec y.1 0 hm0, pow_zero, one_mul]
      congr 1
      apply Subtype.ext
      simp
    let ψ₁ : A →ₐ[R] D :=
      { toFun := ψ₁_fn
        map_one' := by
          simpa using hψ₁_R₀ 1
        map_mul' := by
          intro x y
          have hm : r₀ ^ (μ_sat x + μ_sat y) * (x * y) ∈ R₀ := by
            have h_eq : r₀ ^ (μ_sat x + μ_sat y) * (x * y) =
                (r₀ ^ μ_sat x * x) * (r₀ ^ μ_sat y * y) := by ring
            rw [h_eq]
            exact R₀.mul_mem (hμ_sat x) (hμ_sat y)
          rw [hψ₁_spec (x * y) (μ_sat x + μ_sat y) hm]
          have h_sub : (⟨r₀ ^ (μ_sat x + μ_sat y) * (x * y), hm⟩ : ↥R₀) =
              ⟨r₀ ^ μ_sat x * x, hμ_sat x⟩ * ⟨r₀ ^ μ_sat y * y, hμ_sat y⟩ := by
            apply Subtype.ext
            change r₀ ^ (μ_sat x + μ_sat y) * (x * y) =
              (r₀ ^ μ_sat x * x) * (r₀ ^ μ_sat y * y)
            ring
          rw [h_sub, map_mul, pow_add]
          dsimp [ψ₁_fn]
          ring
        map_zero' := by
          simpa using hψ₁_R₀ 0
        map_add' := by
          intro x y
          have hm : r₀ ^ (μ_sat x + μ_sat y) * (x + y) ∈ R₀ := by
            have h_eq : r₀ ^ (μ_sat x + μ_sat y) * (x + y) =
                r₀ ^ μ_sat y * (r₀ ^ μ_sat x * x) + r₀ ^ μ_sat x * (r₀ ^ μ_sat y * y) := by ring
            rw [h_eq]
            exact R₀.add_mem (R₀.mul_mem (R₀.pow_mem hr₀_mem _) (hμ_sat x))
              (R₀.mul_mem (R₀.pow_mem hr₀_mem _) (hμ_sat y))
          rw [hψ₁_spec (x + y) (μ_sat x + μ_sat y) hm]
          have h_sub : (⟨r₀ ^ (μ_sat x + μ_sat y) * (x + y), hm⟩ : ↥R₀) =
              r0_sub ^ μ_sat y * ⟨r₀ ^ μ_sat x * x, hμ_sat x⟩ +
              r0_sub ^ μ_sat x * ⟨r₀ ^ μ_sat y * y, hμ_sat y⟩ := by
            apply Subtype.ext
            change r₀ ^ (μ_sat x + μ_sat y) * (x + y) =
              r₀ ^ μ_sat y * (r₀ ^ μ_sat x * x) + r₀ ^ μ_sat x * (r₀ ^ μ_sat y * y)
            ring
          rw [h_sub, map_add, map_mul, map_mul, map_pow, map_pow, ← hv_r]
          calc
            (↑v_r⁻¹ : D) ^ (μ_sat x + μ_sat y) *
                ((v_r : D) ^ μ_sat y * α₀ ⟨r₀ ^ μ_sat x * x, hμ_sat x⟩ +
                  (v_r : D) ^ μ_sat x * α₀ ⟨r₀ ^ μ_sat y * y, hμ_sat y⟩)
                = ((↑v_r⁻¹ : D) ^ μ_sat y * (v_r : D) ^ μ_sat y) *
                    ((↑v_r⁻¹ : D) ^ μ_sat x * α₀ ⟨r₀ ^ μ_sat x * x, hμ_sat x⟩) +
                  ((↑v_r⁻¹ : D) ^ μ_sat x * (v_r : D) ^ μ_sat x) *
                    ((↑v_r⁻¹ : D) ^ μ_sat y * α₀ ⟨r₀ ^ μ_sat y * y, hμ_sat y⟩) := by
                  rw [pow_add]
                  ring
            _ = ψ₁_fn x + ψ₁_fn y := by
                  simp only [← mul_pow, Units.inv_mul, one_pow, one_mul, ψ₁_fn]
        commutes' := by
          intro r
          exact hψ₁_R₀ (algebraMap R ↥R₀ r) }
    let ψ₂ : A →ₐ[R] D :=
      { (q_D.comp (j_e.comp ι_k₀)).comp ω with
        commutes' := by
          intro r
          change q_D (j_e (ι_k₀ ((ω.comp (algebraMap R A)) r))) =
            q_D (j_e (π_bar (algebraMap R ↥R₀ r)))
          rw [hω, hι_k₀_apply] }
    have hψ_mod_ID : (Ideal.Quotient.mkₐ R I_D).comp ψ₁ =
        (Ideal.Quotient.mkₐ R I_D).comp ψ₂ := by
      ext x
      apply Ideal.Quotient.eq.mpr
      change ω_D (ψ₁ x - ψ₂ x) = 0
      rw [map_sub, sub_eq_zero]
      have h₂ : ω_D (ψ₂ x) = ω x := by
        change ω_D (q_D (j_e (ι_k₀ (ω x)))) = ω x
        rw [hω_D_q, hω_Be_je, hω_bar_ι]
      rw [h₂]
      obtain ⟨m, hm⟩ := hsat x
      have h_mul : (ω r₀) ^ m * ω_D (ψ₁ x) = (ω r₀) ^ m * ω x := by
        have hr₀_eval : ω_D (ψ₁ r₀) = ω r₀ := by
          have := hψ₁_R₀ r0_sub
          change ψ₁ r₀ = α₀ r0_sub at this
          rw [this]
          change ω_D (q_D (j_e (π_bar r0_sub))) = ω r₀
          rw [hω_D_q, hω_Be_je, hω_bar_mk]
        calc
          (ω r₀) ^ m * ω_D (ψ₁ x)
              = (ω_D (ψ₁ r₀)) ^ m * ω_D (ψ₁ x) := by rw [hr₀_eval]
          _ = ω_D (ψ₁ (r₀ ^ m * x)) := by rw [← map_pow, ← map_mul, ← map_pow, ← map_mul]
          _ = ω_D (α₀ ⟨r₀ ^ m * x, hm⟩) := by
                have := hψ₁_R₀ ⟨r₀ ^ m * x, hm⟩
                change ψ₁ (r₀ ^ m * x) = α₀ ⟨r₀ ^ m * x, hm⟩ at this
                rw [this]
          _ = ω (r₀ ^ m * x) := by
                change ω_D (q_D (j_e (π_bar ⟨r₀ ^ m * x, hm⟩))) = ω (r₀ ^ m * x)
                rw [hω_D_q, hω_Be_je, hω_bar_mk]
          _ = (ω r₀) ^ m * ω x := by rw [map_mul, map_pow]
      exact mul_left_cancel₀ (pow_ne_zero m hr₀_ω) h_mul
    have hψ_eq : ψ₁ = ψ₂ :=
      Algebra.FormallyUnramified.comp_injective I_D hID_sq hψ_mod_ID
    have hM₀_le_sq : M₀ ≤ M₀ ^ 2 := by
      intro z hz
      obtain ⟨x_bar, rfl⟩ := hSurj_je z
      obtain ⟨y, rfl⟩ := hSurj_πbar x_bar
      have hy_ω : ω y.1 = 0 := by
        have hz0 : ω_Be (j_e (π_bar y)) = 0 := hz
        rwa [hω_Be_je, hω_bar_mk] at hz0
      have h_eval := congrArg (fun φ : A →ₐ[R] D => φ y.1) hψ_eq
      have hL : ψ₁ y.1 = q_D (j_e (π_bar y)) := hψ₁_R₀ y
      have hR : ψ₂ y.1 = 0 := by
        change q_D (j_e (ι_k₀ (ω y.1))) = 0
        rw [hy_ω, map_zero, map_zero, map_zero]
      rw [hL, hR] at h_eval
      rwa [← hKer_qD, RingHom.mem_ker]
    have hM₀_fg : M₀.FG := IsNoetherian.noetherian M₀
    have hM₀_jac : M₀ ≤ (⊥ : Ideal B_e).jacobson := by
      rw [IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top, hMax_Be]
    have hM₀_smul : M₀ ≤ (⊥ : Submodule B_e B_e) ⊔ M₀ • M₀ := by
      rw [bot_sup_eq, Ideal.smul_eq_mul, ← pow_two]
      exact hM₀_le_sq
    have hM₀_bot : M₀ = ⊥ :=
      le_bot_iff.mp (Submodule.le_of_le_smul_of_le_jacobson_bot hM₀_fg hM₀_jac hM₀_smul)
    obtain ⟨e₀, he₀_mk⟩ := hSurj_πbar ebar
    refine ⟨e₀, ?_, ?_, ?_⟩
    · rw [← hω_bar_mk, he₀_mk, hebar_ω]
    · rw [← hKer_πbar, RingHom.mem_ker, map_sub, map_mul, he₀_mk, hebar_idem.eq, sub_self]
    · intro y
      obtain ⟨c, hc⟩ := hSurj (ω y.1)
      refine ⟨c, ?_⟩
      let d : ↥R₀ := y - algebraMap R ↥R₀ c
      have hd_M₀ : j_e (π_bar d) ∈ M₀ := by
        change ω_Be (j_e (π_bar (y - algebraMap R ↥R₀ c))) = 0
        rw [hω_Be_je, map_sub, map_sub, hω_bar_mk, ← hι_k₀_apply, hω_bar_ι, hc, sub_self]
      rw [hM₀_bot, Submodule.mem_bot] at hd_M₀
      have he_d : ebar * π_bar d = 0 := (hje_eq_zero (π_bar d)).mp hd_M₀
      rw [← hKer_πbar, RingHom.mem_ker]
      have h_bar_eq : π_bar (e₀ * y - algebraMap R ↥R₀ c * e₀) = ebar * π_bar d := by
        dsimp [d]
        rw [map_sub, map_sub, map_mul, map_mul, he₀_mk]
        ring
      rw [h_bar_eq, he_d]
  obtain ⟨e₀, he₀_ω, he₀_idem_ker, he₀_span_ker⟩ := hStep2

  
  let S : Type u := ↥R₀
  let m_R : Ideal R := IsLocalRing.maximalIdeal R
  let J_S : Ideal S := Ideal.map (algebraMap R S) m_R
  have hJm_eq_JS : J_m = J_S := by
    dsimp [J_m, J_S, m_R]
    rw [hKer]
  have he₀_idem : e₀ * e₀ - e₀ ∈ J_S := hJm_eq_JS ▸ he₀_idem_ker
  have he₀_span : ∀ y : S, ∃ c : R, e₀ * y - algebraMap R S c * e₀ ∈ J_S := by
    intro y
    obtain ⟨c, hc⟩ := he₀_span_ker y
    exact ⟨c, hJm_eq_JS ▸ hc⟩
  have hStep3 : ∃ e : S,
      e * e = e ∧
      e - e₀ ∈ J_S ∧
      ∀ y : S, ∃ c : R, e * y = algebraMap R S c * e := by
    have hJS_le_smul : ∀ x ∈ J_S, x ∈ m_R • (⊤ : Submodule R S) := by
      intro x hx
      refine Submodule.span_induction ?_ ?_ ?_ ?_ hx
      · rintro _ ⟨r, hr, rfl⟩
        have h1 : algebraMap R S r = r • (1 : S) := by simp [Algebra.smul_def]
        rw [h1]
        exact Submodule.smul_mem_smul hr Submodule.mem_top
      · exact Submodule.zero_mem _
      · intro a b _ _ ha hb
        exact Submodule.add_mem _ ha hb
      · intro a y _ hy
        change a * y ∈ m_R • (⊤ : Submodule R S)
        refine Submodule.smul_induction_on hy ?_ ?_
        · intro r hr z _
          rw [mul_smul_comm]
          exact Submodule.smul_mem_smul hr Submodule.mem_top
        · intro z₁ z₂ hz₁ hz₂
          rw [mul_add]
          exact Submodule.add_mem _ hz₁ hz₂
    let κ : Type u := IsLocalRing.ResidueField R
    let res : R →+* κ := IsLocalRing.residue R
    have hSurj_res : Function.Surjective res := IsLocalRing.residue_surjective
    have hKer_res : RingHom.ker res = m_R := IsLocalRing.ker_residue
    
    have hSbar_pkg : ∃ (S_bar : Type u) (_ : CommRing S_bar) (_ : Algebra κ S_bar),
        (by letI := ‹CommRing S_bar›; letI := ‹Algebra κ S_bar›; exact IsNoetherian κ S_bar) ∧
        ∃ (π_S : S →+* S_bar),
          Function.Surjective π_S ∧
          RingHom.ker π_S = J_S ∧
          (∀ r : R, algebraMap κ S_bar (res r) = π_S (algebraMap R S r)) := by
      let S_bar₀ : Type u := S ⧸ J_S
      let π_S₀ : S →+* S_bar₀ := Ideal.Quotient.mk J_S
      have hf_S_ker : RingHom.ker res ≤ RingHom.ker (π_S₀.comp (algebraMap R S)) := by
        rw [hKer_res]
        intro r hr
        rw [RingHom.mem_ker, RingHom.comp_apply]
        exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem _ hr)
      let ι_κ : κ →+* S_bar₀ :=
        (Ideal.Quotient.lift (RingHom.ker res) (π_S₀.comp (algebraMap R S)) hf_S_ker).comp
          (RingHom.quotientKerEquivOfSurjective hSurj_res).symm.toRingHom
      have hι_κ_apply : ∀ r : R, ι_κ (res r) = π_S₀ (algebraMap R S r) := by
        intro r
        dsimp [ι_κ]
        rw [RingHom.quotientKerEquivOfSurjective_symm_apply hSurj_res r]
        rfl
      let instAlg : Algebra κ S_bar₀ := ι_κ.toAlgebra
      have hNoeth : @IsNoetherian κ S_bar₀ _ _ instAlg.toModule := by
        letI : Algebra κ S_bar₀ := instAlg
        have : IsScalarTower R κ S_bar₀ :=
          IsScalarTower.of_algebraMap_eq' (RingHom.ext fun r => (hι_κ_apply r).symm)
        have : Module.Finite R S_bar₀ :=
          Module.Finite.of_surjective (Ideal.Quotient.mkₐ R J_S).toLinearMap
            Ideal.Quotient.mk_surjective
        have : Module.Finite κ S_bar₀ :=
          Module.Finite.of_restrictScalars_finite R κ S_bar₀
        exact inferInstance
      exact ⟨S_bar₀, inferInstance, instAlg, hNoeth, π_S₀,
        Ideal.Quotient.mk_surjective, Ideal.mk_ker, hι_κ_apply⟩
    obtain ⟨S_bar, instCRSbar, instAlgκSbar, hNoethSbar,
      π_S, hSurj_πS, hKer_πS, hι_κ_apply⟩ := hSbar_pkg
    letI := instCRSbar
    letI := instAlgκSbar
    haveI : IsNoetherian κ S_bar := hNoethSbar
    let ebar0 : S_bar := π_S e₀
    have hebar0_idem : ebar0 * ebar0 = ebar0 := by
      apply sub_eq_zero.mp
      rw [← map_mul, ← map_sub, ← RingHom.mem_ker, hKer_πS]
      exact he₀_idem
    let W_sub : Submodule κ S_bar := LinearMap.range (LinearMap.mulLeft κ (1 - ebar0))
    obtain ⟨k, w_bar, hw_span⟩ :=
      Submodule.fg_iff_exists_fin_generating_family.mp (IsNoetherian.noetherian W_sub)
    have hebar0_w : ∀ j : Fin k, ebar0 * w_bar j = 0 := by
      intro j
      have hj_mem : w_bar j ∈ W_sub := by
        rw [← hw_span]
        exact Submodule.subset_span ⟨j, rfl⟩
      obtain ⟨z_j, hzj⟩ := hj_mem
      change (1 - ebar0) * z_j = w_bar j at hzj
      rw [← hzj]
      calc
        ebar0 * ((1 - ebar0) * z_j) = (ebar0 - ebar0 * ebar0) * z_j := by ring
        _ = 0 := by rw [hebar0_idem, sub_self, zero_mul]
    classical
    choose w_lift hw_lift using fun j : Fin k => hSurj_πS (w_bar j)
    let m_gen : Fin (k + 1) → S := Fin.cons e₀ w_lift
    let N_span : Submodule R S := Submodule.span R (Set.range m_gen)
    have hw_lift_N : ∀ u ∈ W_sub, ∃ s ∈ N_span, π_S s = u := by
      intro u hu
      rw [← hw_span] at hu
      refine Submodule.span_induction ?_ ?_ ?_ ?_ hu
      · rintro _ ⟨j, rfl⟩
        refine ⟨m_gen j.succ, Submodule.subset_span ⟨j.succ, rfl⟩, ?_⟩
        simpa [m_gen] using hw_lift j
      · exact ⟨0, N_span.zero_mem, map_zero π_S⟩
      · rintro u₁ u₂ _ _ ⟨s₁, hs₁, hπ₁⟩ ⟨s₂, hs₂, hπ₂⟩
        exact ⟨s₁ + s₂, N_span.add_mem hs₁ hs₂, by rw [map_add, hπ₁, hπ₂]⟩
      · rintro a u₀ _ ⟨s₀, hs₀, hπ₀⟩
        obtain ⟨r, rfl⟩ := hSurj_res a
        refine ⟨r • s₀, N_span.smul_mem r hs₀, ?_⟩
        rw [Algebra.smul_def, map_mul, ← hι_κ_apply, hπ₀, ← Algebra.smul_def]
    have hmR_jac : m_R ≤ (⊥ : Ideal R).jacobson := by
      rw [IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top]
    have hTop_le_N : (⊤ : Submodule R S) ≤ N_span := by
      apply Submodule.le_of_le_smul_of_le_jacobson_bot Module.Finite.fg_top hmR_jac
      intro y _
      obtain ⟨c, hc⟩ := he₀_span y
      obtain ⟨s₂, hs₂_N, hs₂_π⟩ :=
        hw_lift_N ((1 - ebar0) * π_S y) ⟨π_S y, rfl⟩
      let s : S := c • m_gen 0 + s₂
      have hs_N : s ∈ N_span :=
        N_span.add_mem (N_span.smul_mem c (Submodule.subset_span ⟨0, rfl⟩)) hs₂_N
      have hy_sub_JS : y - s ∈ J_S := by
        rw [← hKer_πS, RingHom.mem_ker]
        have h1 : π_S (e₀ * y - algebraMap R S c * e₀) = 0 := by
          rw [← RingHom.mem_ker, hKer_πS]
          exact hc
        rw [map_sub, sub_eq_zero] at h1
        change π_S (y - (c • m_gen 0 + s₂)) = 0
        rw [map_sub, map_add, hs₂_π]
        simp only [m_gen, Fin.cons_zero, Algebra.smul_def]
        rw [← h1, map_mul]
        change π_S y - (ebar0 * π_S y + (1 - ebar0) * π_S y) = 0
        ring
      have hy_smul : y - s ∈ m_R • (⊤ : Submodule R S) := hJS_le_smul (y - s) hy_sub_JS
      exact Submodule.mem_sup.mpr ⟨s, hs_N, y - s, hy_smul, by abel⟩
    have hN_eq_top : N_span = ⊤ := top_unique hTop_le_N
    have hN_coords : ∀ v ∈ N_span, ∃ c : Fin (k + 1) → R, v = ∑ j : Fin (k + 1), c j • m_gen j := by
      intro v hv
      refine Submodule.span_induction ?_ ?_ ?_ ?_ hv
      · rintro _ ⟨i, rfl⟩
        refine ⟨Pi.single i 1, ?_⟩
        simp
      · exact ⟨0, by simp⟩
      · rintro v₁ v₂ _ _ ⟨c₁, rfl⟩ ⟨c₂, rfl⟩
        exact ⟨c₁ + c₂, by simp [add_smul, Finset.sum_add_distrib]⟩
      · rintro r v₀ _ ⟨c₀, rfl⟩
        exact ⟨r • c₀, by simp [Finset.smul_sum, mul_smul]⟩
    have hJS_coords : ∀ z ∈ J_S,
        ∃ d : Fin (k + 1) → R, (∀ j, d j ∈ m_R) ∧ z = ∑ j : Fin (k + 1), d j • m_gen j := by
      intro z hz
      have hz_smul : z ∈ m_R • N_span := by
        rw [hN_eq_top]
        exact hJS_le_smul z hz
      refine Submodule.smul_induction_on hz_smul ?_ ?_
      · intro r hr v hv
        obtain ⟨c, rfl⟩ := hN_coords v hv
        refine ⟨fun j => r * c j, fun j => m_R.mul_mem_right (c j) hr, ?_⟩
        rw [Finset.smul_sum]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [mul_smul]
      · rintro z₁ z₂ ⟨d₁, hd₁, rfl⟩ ⟨d₂, hd₂, rfl⟩
        refine ⟨fun j => d₁ j + d₂ j, fun j => m_R.add_mem (hd₁ j) (hd₂ j), ?_⟩
        simp [add_smul, Finset.sum_add_distrib]
    have hm_mult_JS : ∀ i : Fin (k + 1),
        e₀ * m_gen i - (if i = 0 then e₀ else 0) ∈ J_S := by
      intro i
      refine Fin.cases ?_ ?_ i
      · simpa [m_gen] using he₀_idem
      · intro j
        simp only [Fin.succ_ne_zero, ↓reduceIte, sub_zero, m_gen, Fin.cons_succ]
        rw [← hKer_πS, RingHom.mem_ker, map_mul, hw_lift j]
        exact hebar0_w j
    choose d_mat hd_mat_mem hd_mat_eq using fun i => hJS_coords _ (hm_mult_JS i)
    let M : Matrix (Fin (k + 1)) (Fin (k + 1)) R :=
      fun i j => (if i = 0 ∧ j = 0 then 1 else 0) + d_mat i j
    have hM_act : ∀ i : Fin (k + 1),
        e₀ * m_gen i = ∑ j : Fin (k + 1), algebraMap R S (M i j) * m_gen j := by
      intro i
      have h_sum : ∑ j : Fin (k + 1), M i j • m_gen j =
          (if i = 0 then e₀ else 0) + ∑ j : Fin (k + 1), d_mat i j • m_gen j := by
        simp only [M, add_smul, Finset.sum_add_distrib]
        congr 1
        by_cases hi : i = 0
        · subst hi
          simp [m_gen]
        · simp [hi]
      simp only [← Algebra.smul_def]
      rw [h_sum, ← hd_mat_eq i]
      abel
    let f : Polynomial R := M.charpoly
    
    have hae_f : Polynomial.aeval e₀ f = 0 := by
      let ev_e₀ : Polynomial R →+* S := (Polynomial.aeval e₀).toRingHom
      let B : Matrix (Fin (k + 1)) (Fin (k + 1)) S := ev_e₀.mapMatrix M.charmatrix
      have hdet_eq : Polynomial.aeval e₀ f = B.det := by
        change ev_e₀ M.charmatrix.det = B.det
        exact RingHom.map_det ev_e₀ M.charmatrix
      rw [hdet_eq]
      have hB_mulVec : B.mulVec m_gen = 0 := by
        ext i
        simp only [Matrix.mulVec, dotProduct, Pi.zero_apply]
        have hB_entry : ∀ j : Fin (k + 1),
            B i j * m_gen j =
              (if i = j then e₀ * m_gen j else 0) - algebraMap R S (M i j) * m_gen j := by
          intro j
          change ev_e₀ (M.charmatrix i j) * m_gen j = _
          rw [Matrix.charmatrix_apply]
          by_cases hij : i = j
          · subst hij
            simp only [Matrix.diagonal_apply_eq, map_sub, ev_e₀, AlgHom.toRingHom_eq_coe,
              RingHom.coe_coe, Polynomial.aeval_X, Polynomial.aeval_C, ↓reduceIte]
            change (e₀ - algebraMap R S (M i i)) * m_gen i =
              e₀ * m_gen i - algebraMap R S (M i i) * m_gen i
            ring
          · simp only [Matrix.diagonal_apply_ne _ hij, zero_sub, map_neg, ev_e₀,
              AlgHom.toRingHom_eq_coe, RingHom.coe_coe, Polynomial.aeval_C, hij, ↓reduceIte]
            exact neg_mul (algebraMap R S (M i j)) (m_gen j)
        simp_rw [hB_entry]
        simp only [Finset.sum_sub_distrib, Finset.sum_ite_eq, Finset.mem_univ, ↓reduceIte,
          hM_act i, sub_self]
      have hadj : (B.adjugate * B).mulVec m_gen = 0 := by
        rw [← Matrix.mulVec_mulVec, hB_mulVec, Matrix.mulVec_zero]
      rw [Matrix.adjugate_mul] at hadj
      have hdet_m : ∀ j : Fin (k + 1), B.det * m_gen j = 0 := by
        intro j
        have hj := congrFun hadj j
        simpa [Matrix.mulVec, dotProduct, Matrix.one_apply] using hj
      obtain ⟨c_one, hc_one⟩ := hN_coords 1 (by rw [hN_eq_top]; exact Submodule.mem_top)
      calc
        B.det = B.det * 1 := (mul_one _).symm
        _ = B.det * ∑ j : Fin (k + 1), c_one j • m_gen j := by rw [← hc_one]
        _ = ∑ j : Fin (k + 1), algebraMap R S (c_one j) * (B.det * m_gen j) := by
              rw [Finset.mul_sum]
              refine Finset.sum_congr rfl fun j _ => ?_
              rw [Algebra.smul_def]
              ring
        _ = 0 := by simp [hdet_m]
    
    let d_diag : Fin (k + 1) → κ := Fin.cons 1 (fun _ => 0)
    have hM_map : M.map res = Matrix.diagonal d_diag := by
      ext i j
      have hd0 : res (d_mat i j) = 0 := by
        rw [← RingHom.mem_ker, hKer_res]
        exact hd_mat_mem i j
      change res (M i j) = Matrix.diagonal d_diag i j
      simp only [M, map_add, hd0, add_zero]
      by_cases hij : i = j
      · subst hij
        refine Fin.cases ?_ ?_ i
        · simp [d_diag]
        · intro j'
          simp [d_diag]
      · have hnot0 : ¬ (i = 0 ∧ j = 0) := by
          rintro ⟨rfl, rfl⟩
          exact hij rfl
        simp only [hnot0, ↓reduceIte, map_zero, Matrix.diagonal_apply_ne _ hij]
    have hf_map : Polynomial.map res f = (Polynomial.X - 1) * Polynomial.X ^ k := by
      dsimp [f]
      rw [← Matrix.charpoly_map, hM_map, Matrix.charpoly_diagonal, Fin.prod_univ_succ]
      simp [d_diag]
    have hf_eval_mem : Polynomial.eval 1 f ∈ m_R := by
      rw [← hKer_res, RingHom.mem_ker]
      have h1 := Polynomial.eval_map_apply res (1 : R) (p := f)
      rw [map_one, hf_map] at h1
      rw [← h1]
      simp
    have hf_deriv_unit : IsUnit (Polynomial.eval 1 (Polynomial.derivative f)) := by
      apply IsLocalRing.notMem_maximalIdeal.mp
      change Polynomial.eval 1 (Polynomial.derivative f) ∉ m_R
      rw [← hKer_res, RingHom.mem_ker]
      intro h0
      have h1 := Polynomial.eval_map_apply res (1 : R) (p := Polynomial.derivative f)
      rw [map_one, ← Polynomial.derivative_map, hf_map, h0] at h1
      simp [Polynomial.derivative_mul] at h1
    obtain ⟨a_rt, ha_rt_root, ha_rt_mem⟩ :=
      HenselianLocalRing.is_henselian f M.charpoly_monic 1 hf_eval_mem hf_deriv_unit
    have hres_art : res a_rt = 1 := by
      have h0 : res (a_rt - 1) = 0 := by
        rw [← RingHom.mem_ker, hKer_res]
        exact ha_rt_mem
      rwa [map_sub, map_one, sub_eq_zero] at h0
    obtain ⟨g, hf_fac⟩ := Polynomial.dvd_iff_isRoot.mpr ha_rt_root
    have hg_map : Polynomial.map res g = Polynomial.X ^ k := by
      have hmap_fac := congrArg (Polynomial.map res) hf_fac
      rw [hf_map, Polynomial.map_mul, Polynomial.map_sub, Polynomial.map_X,
        Polynomial.map_C, hres_art, Polynomial.C_1] at hmap_fac
      have hne : (Polynomial.X - 1 : Polynomial κ) ≠ 0 := by
        simpa using Polynomial.X_sub_C_ne_zero (1 : κ)
      exact mul_left_cancel₀ hne hmap_fac.symm
    have hres_g_art : res (Polynomial.eval a_rt g) = 1 := by
      rw [← Polynomial.eval_map_apply res a_rt, hg_map, hres_art]
      simp
    have hu_g_unit : IsUnit (Polynomial.eval a_rt g) := by
      apply IsLocalRing.notMem_maximalIdeal.mp
      change Polynomial.eval a_rt g ∉ m_R
      rw [← hKer_res, RingHom.mem_ker, hres_g_art]
      exact one_ne_zero
    obtain ⟨u_g, hu_g⟩ := hu_g_unit
    have hres_ug_inv : res (↑u_g⁻¹ : R) = 1 := by
      have hmul : res (↑u_g * ↑u_g⁻¹) = 1 := by
        rw [Units.mul_inv, map_one]
      rw [map_mul, hu_g, hres_g_art, one_mul] at hmul
      exact hmul
    let e : S := algebraMap R S (↑u_g⁻¹ : R) * Polynomial.aeval e₀ g
    
    have he₀_mul_e : e₀ * e = algebraMap R S a_rt * e := by
      apply sub_eq_zero.mp
      calc
        e₀ * e - algebraMap R S a_rt * e
            = (e₀ - algebraMap R S a_rt) * (algebraMap R S (↑u_g⁻¹ : R) * Polynomial.aeval e₀ g) := by
              dsimp [e]
              ring
        _ = algebraMap R S (↑u_g⁻¹ : R) *
              ((e₀ - algebraMap R S a_rt) * Polynomial.aeval e₀ g) := by ring
        _ = algebraMap R S (↑u_g⁻¹ : R) *
              Polynomial.aeval e₀ ((Polynomial.X - Polynomial.C a_rt) * g) := by
              rw [map_mul, map_sub, Polynomial.aeval_X, Polynomial.aeval_C]
        _ = algebraMap R S (↑u_g⁻¹ : R) * Polynomial.aeval e₀ f := by rw [← hf_fac]
        _ = 0 := by rw [hae_f, mul_zero]
    have he₀_pow_mul_e : ∀ n : ℕ, e₀ ^ n * e = algebraMap R S (a_rt ^ n) * e := by
      intro n
      induction n with
      | zero => simp
      | succ n ih =>
        calc
          e₀ ^ (n + 1) * e = e₀ ^ n * (e₀ * e) := by rw [pow_succ, mul_assoc]
          _ = e₀ ^ n * (algebraMap R S a_rt * e) := by rw [he₀_mul_e]
          _ = algebraMap R S a_rt * (e₀ ^ n * e) := by ring
          _ = algebraMap R S a_rt * (algebraMap R S (a_rt ^ n) * e) := by rw [ih]
          _ = algebraMap R S (a_rt ^ (n + 1)) * e := by
                rw [pow_succ, map_mul]
                ring
    have hae_mul_e : ∀ P : Polynomial R,
        Polynomial.aeval e₀ P * e = algebraMap R S (Polynomial.eval a_rt P) * e := by
      intro P
      refine Polynomial.induction_on' P ?_ ?_
      · intro P₁ P₂ h₁ h₂
        rw [map_add, add_mul, h₁, h₂, Polynomial.eval_add, map_add, add_mul]
      · intro n r
        rw [Polynomial.aeval_monomial, Polynomial.eval_monomial, mul_assoc,
          he₀_pow_mul_e n, ← mul_assoc, ← map_mul]
    have he_idem : e * e = e := by
      calc
        e * e = algebraMap R S (↑u_g⁻¹ : R) * (Polynomial.aeval e₀ g * e) := by
              dsimp [e]
              ring
        _ = algebraMap R S (↑u_g⁻¹ : R) *
              (algebraMap R S (Polynomial.eval a_rt g) * e) := by rw [hae_mul_e g]
        _ = algebraMap R S ((↑u_g⁻¹ : R) * (u_g : R)) * e := by
              rw [← hu_g, map_mul, mul_assoc]
        _ = e := by rw [Units.inv_mul, map_one, one_mul]
    
    have hπ_e : π_S e = ebar0 := by
      have h_ae : π_S (Polynomial.aeval e₀ g) = ebar0 ^ k := by
        change π_S (Polynomial.eval₂ (algebraMap R S) e₀ g) = ebar0 ^ k
        rw [Polynomial.hom_eval₂]
        have hcomp : π_S.comp (algebraMap R S) = (algebraMap κ S_bar).comp res :=
          RingHom.ext fun r => (hι_κ_apply r).symm
        rw [hcomp, ← Polynomial.eval₂_map, hg_map]
        simp [ebar0]
      have h_ug : π_S (algebraMap R S (↑u_g⁻¹ : R)) = 1 := by
        rw [← hι_κ_apply, hres_ug_inv, map_one]
      have hπ_pow : π_S e = ebar0 ^ k := by
        dsimp [e]
        rw [map_mul, h_ug, h_ae, one_mul]
      have hebar0_pow_succ : ∀ n : ℕ, ebar0 ^ (n + 1) = ebar0 := by
        intro n
        induction n with
        | zero => simp
        | succ n ih => rw [pow_succ, ih, hebar0_idem]
      rw [hπ_pow]
      cases k with
      | zero =>
        have hW_bot : W_sub = ⊥ := by
          rw [← hw_span, Set.range_eq_empty, Submodule.span_empty]
        have h1_mem : (1 - ebar0) * 1 ∈ W_sub := ⟨1, rfl⟩
        rw [hW_bot, Submodule.mem_bot, mul_one, sub_eq_zero] at h1_mem
        rw [← h1_mem, pow_zero]
      | succ k' =>
        exact hebar0_pow_succ k'
    have he_diff : e - e₀ ∈ J_S := by
      rw [← hKer_πS, RingHom.mem_ker, map_sub, hπ_e, sub_self]
    
    let M_e : Submodule R S := LinearMap.range (LinearMap.mulLeft R e)
    have hMe_fg : M_e.FG := by
      have hmap : (⊤ : Submodule R S).map (LinearMap.mulLeft R e) = M_e :=
        Submodule.map_top _
      rw [← hmap]
      exact Module.Finite.fg_top.map _
    let N_e : Submodule R S := Submodule.span R ({e} : Set S)
    have hMe_le : M_e ≤ N_e ⊔ m_R • M_e := by
      rintro _ ⟨y, rfl⟩
      change e * y ∈ N_e ⊔ m_R • M_e
      obtain ⟨c, hc⟩ := he₀_span y
      let δ : S := e * y - algebraMap R S c * e
      have hδ_JS : δ ∈ J_S := by
        have h_eq : δ = (e - e₀) * y + (e₀ * y - algebraMap R S c * e₀) -
            algebraMap R S c * (e - e₀) := by
          dsimp [δ]
          ring
        rw [h_eq]
        exact J_S.sub_mem (J_S.add_mem (J_S.mul_mem_right y he_diff) hc)
          (J_S.mul_mem_left _ he_diff)
      have hδ_smul_top : δ ∈ m_R • (⊤ : Submodule R S) := hJS_le_smul δ hδ_JS
      have he_δ : e * δ = δ := by
        calc
          e * δ = (e * e) * y - algebraMap R S c * (e * e) := by
                dsimp [δ]
                ring
          _ = δ := by rw [he_idem]
      have he_smul_Me : ∀ u ∈ m_R • (⊤ : Submodule R S), e * u ∈ m_R • M_e := by
        intro u hu
        refine Submodule.smul_induction_on hu ?_ ?_
        · intro r hr v _
          rw [mul_smul_comm]
          exact Submodule.smul_mem_smul hr ⟨v, rfl⟩
        · intro u₁ u₂ hu₁ hu₂
          rw [mul_add]
          exact Submodule.add_mem _ hu₁ hu₂
      have hδ_Me : δ ∈ m_R • M_e := by
        rw [← he_δ]
        exact he_smul_Me δ hδ_smul_top
      have hce_Ne : c • e ∈ N_e :=
        N_e.smul_mem c (Submodule.subset_span rfl)
      refine Submodule.mem_sup.mpr ⟨c • e, hce_Ne, δ, hδ_Me, ?_⟩
      dsimp [δ]
      rw [Algebra.smul_def]
      abel
    have hMe_sub_Ne : M_e ≤ N_e :=
      Submodule.le_of_le_smul_of_le_jacobson_bot hMe_fg hmR_jac hMe_le
    refine ⟨e, he_idem, he_diff, fun y => ?_⟩
    have hey_Ne : e * y ∈ N_e := hMe_sub_Ne ⟨y, rfl⟩
    obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp hey_Ne
    exact ⟨c, by rw [← hc, Algebra.smul_def]⟩
  obtain ⟨e_sub, he_sub_idem, he_sub_diff, he_sub_span⟩ := hStep3

  
  let e_A : A := e_sub.1
  have he_ω : ω e_A = 1 := by
    let ω₀ : ↥R₀ →+* k₀ := ω.comp R₀.val.toRingHom
    have hJS_le_ω₀ : J_S ≤ RingHom.ker ω₀ := by
      rw [Ideal.map_le_iff_le_comap]
      intro r hr
      change r ∈ IsLocalRing.maximalIdeal R at hr
      rw [← hKer] at hr
      change ω (algebraMap R A r) = 0
      have h1 : (ω.comp (algebraMap R A)) r = π_R r := by rw [hω]
      exact h1.trans hr
    have h0 : ω₀ (e_sub - e₀) = 0 := hJS_le_ω₀ he_sub_diff
    rw [map_sub] at h0
    change ω e_A - ω e₀.1 = 0 at h0
    rw [he₀_ω, sub_eq_zero] at h0
    exact h0
  have he_not_q : e_A ∉ q := by
    change ω e_A ≠ 0
    rw [he_ω]
    exact one_ne_zero
  have he_idem_A : e_A * e_A = e_A := congrArg Subtype.val he_sub_idem
  let h : A := r₀ * e_A
  have hh_ω : ω h ≠ 0 := by
    dsimp [h]
    rw [map_mul, he_ω, mul_one]
    exact hr₀_ω
  have hh_not_q : h ∉ q := hh_ω
  obtain ⟨u₀, hu₀_sub⟩ := he_sub_span ⟨r₀, hr₀_mem⟩
  have hu₀_eq : e_A * r₀ = algebraMap R A u₀ * e_A := congrArg Subtype.val hu₀_sub
  have hh_u₀ : h = algebraMap R A u₀ * e_A := by
    dsimp [h]
    rw [mul_comm, hu₀_eq]
  have hu₀_unit : IsUnit u₀ := by
    apply IsLocalRing.notMem_maximalIdeal.mp
    rw [← hq_comap, Ideal.mem_comap]
    intro hu_q
    exact hh_not_q (hh_u₀ ▸ q.mul_mem_right e_A hu_q)
  obtain ⟨v₀, hv₀⟩ := hu₀_unit
  let L_h : Type u := Localization.Away h
  let j_h : A →+* L_h := algebraMap A L_h
  let φ_R : R →+* L_h := algebraMap R L_h
  have hjh_hh : j_h h = φ_R u₀ * j_h e_A := by
    rw [congrArg j_h hh_u₀, map_mul, IsScalarTower.algebraMap_apply R A L_h u₀]
  have hjh_e : j_h e_A = 1 := by
    have hu_h : IsUnit (j_h h) := IsLocalization.Away.algebraMap_isUnit h
    rw [hjh_hh] at hu_h
    have hu_e : IsUnit (j_h e_A) := isUnit_of_mul_isUnit_right hu_h
    apply hu_e.mul_left_cancel
    rw [← map_mul, he_idem_A, mul_one]
  have hjh_h : j_h h = φ_R u₀ := by
    rw [hjh_hh, hjh_e, mul_one]
  have hh_pow_e : ∀ m : ℕ, h ^ m * e_A = e_A * r₀ ^ m := by
    intro m
    induction m with
    | zero => simp
    | succ m ih =>
      calc
        h ^ (m + 1) * e_A = (h ^ m * e_A) * r₀ * e_A := by
              dsimp [h]
              ring_nf
        _ = (e_A * r₀ ^ m) * r₀ * e_A := by rw [ih]
        _ = r₀ ^ (m + 1) * (e_A * e_A) := by ring
        _ = e_A * r₀ ^ (m + 1) := by
              rw [he_idem_A]
              ring
  have hSurj_φR : Function.Surjective φ_R := by
    intro ξ
    obtain ⟨⟨x, s⟩, hξs⟩ := IsLocalization.surj (Submonoid.powers h) ξ
    obtain ⟨n, hn⟩ := s.2
    obtain ⟨m, hm⟩ := hsat x
    obtain ⟨c, hc_sub⟩ := he_sub_span ⟨r₀ ^ m * x, hm⟩
    have hc_A : (h ^ m * e_A) * x = algebraMap R A c * e_A := by
      rw [hh_pow_e m, mul_assoc]
      exact congrArg Subtype.val hc_sub
    have hc_Lh : φ_R (u₀ ^ m) * j_h x = φ_R c := by
      have hmap := congrArg j_h hc_A
      simp only [map_mul, map_pow, hjh_e, hjh_h, mul_one] at hmap
      rwa [← map_pow, ← IsScalarTower.algebraMap_apply R A L_h c] at hmap
    have hs_Lh : j_h s.1 = φ_R (u₀ ^ n) := by
      rw [← hn, map_pow, hjh_h, ← map_pow]
    rw [hs_Lh] at hξs
    refine ⟨c * (↑v₀⁻¹ : R) ^ (m + n), ?_⟩
    have hu_pow : IsUnit (φ_R (u₀ ^ (m + n))) := by
      rw [← hv₀]
      exact (v₀.isUnit.pow (m + n)).map φ_R
    apply hu_pow.mul_right_cancel
    calc
      φ_R (c * (↑v₀⁻¹ : R) ^ (m + n)) * φ_R (u₀ ^ (m + n))
          = φ_R (c * ((↑v₀⁻¹ : R) * (v₀ : R)) ^ (m + n)) := by
            rw [← hv₀, ← map_mul, mul_assoc, ← mul_pow]
      _ = φ_R c := by rw [Units.inv_mul, one_pow, mul_one]
      _ = φ_R (u₀ ^ m) * (ξ * φ_R (u₀ ^ n)) := by rw [hξs, hc_Lh]
      _ = ξ * φ_R (u₀ ^ (m + n)) := by
            rw [pow_add, map_mul]
            ring
  have : Nontrivial L_h := by
    refine ⟨⟨1, 0, fun h10 => ?_⟩⟩
    have hj10 : j_h 1 = 0 := by simpa using h10
    obtain ⟨⟨s, n, rfl⟩, hs0⟩ :=
      (IsLocalization.map_eq_zero_iff (Submonoid.powers h) L_h 1).mp hj10
    simp only [mul_one] at hs0
    have hpow_q : h ^ n ∈ q := by
      rw [hs0]
      exact q.zero_mem
    exact hh_not_q (hqPrime.mem_of_pow_mem n hpow_q)
  have : IsLocalRing L_h := IsLocalRing.of_surjective' φ_R hSurj_φR
  have : IsLocalHom φ_R := by
    refine ⟨fun r hr_unit => ?_⟩
    by_contra hr_not
    have hr_mem : r ∈ IsLocalRing.maximalIdeal R := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      exact hr_not
    obtain ⟨u, hu⟩ := hr_unit
    obtain ⟨s, hs⟩ := hSurj_φR (↑u⁻¹ : L_h)
    have hrs_mem : r * s ∈ IsLocalRing.maximalIdeal R :=
      Ideal.mul_mem_right s _ hr_mem
    have h1rs_unit : IsUnit (1 - r * s) := by
      apply IsLocalRing.notMem_maximalIdeal.mp
      intro hmem
      have h1_mem : (1 : R) ∈ IsLocalRing.maximalIdeal R := by
        have hsum := (IsLocalRing.maximalIdeal R).add_mem hmem hrs_mem
        rwa [sub_add_cancel] at hsum
      exact (IsLocalRing.maximalIdeal.isMaximal R).ne_top
        (Ideal.eq_top_of_isUnit_mem _ h1_mem isUnit_one)
    have h0_unit : IsUnit (φ_R (1 - r * s)) := h1rs_unit.map φ_R
    have h0_eq : φ_R (1 - r * s) = 0 := by
      rw [map_sub, map_one, map_mul, ← hu, hs, Units.mul_inv, sub_self]
    rw [h0_eq] at h0_unit
    exact not_isUnit_zero h0_unit
  have : Module.Flat R L_h := Localization.flat A (Submonoid.powers h)
  have : Module.FaithfullyFlat R L_h := Module.FaithfullyFlat.of_flat_of_isLocalHom
  have hFaith : φ_R.FaithfullyFlat := by
    rwa [RingHom.faithfullyFlat_algebraMap_iff]
  have hInj_φR : Function.Injective φ_R := hFaith.injective
  exact ⟨h, hh_ω, hInj_φR, hSurj_φR⟩

theorem weil_etale_over_integrallyClosed_domain_exists_away_isDomain (A₀ B : Type u) [CommRing A₀] [IsDomain A₀] [IsIntegrallyClosed A₀]
    [CommRing B] [Algebra A₀ B] [Algebra.Etale A₀ B]
    (m : Ideal B) [m.IsPrime] :
    ∃ s : B, s ∉ m ∧ IsDomain (Localization.Away s) :=
by
  rename_i instCommA₀ instDomA₀ instICA₀ instCommB instAlgA₀B instEtA₀B instPrimeM
  have hICA₀ : IsIntegrallyClosed A₀ := instICA₀
  clear instICA₀
  have h_step1 : ∀ (A₀ B : Type u) [CommRing A₀] [IsDomain A₀]
      [CommRing B] [Algebra A₀ B] [Algebra.Etale A₀ B],
      _root_.IsReduced B ∧ (minimalPrimes B).Finite := by
    clear! A₀ B m
    intro A₀ B _ _ _ _ _
    let N₀ : Submonoid A₀ := nonZeroDivisors A₀
    let M₀ : Submonoid B := Algebra.algebraMapSubmonoid B N₀
    let L : Type u := FractionRing A₀
    let B_L : Type u := Localization M₀
    have hM₀_le : M₀ ≤ nonZeroDivisors B := by
      intro m hm
      rcases hm with ⟨a, ha, rfl⟩
      rw [mem_nonZeroDivisors_iff_right]
      intro x hxm
      have ha0 : a ≠ 0 := nonZeroDivisors.ne_zero ha
      have hsmul : a • x = 0 := by
        rw [Algebra.smul_def, mul_comm, hxm]
      exact (smul_eq_zero.mp hsmul).resolve_left ha0
    have hinj : Function.Injective (algebraMap B B_L) :=
      IsLocalization.injective B_L hM₀_le
    have hN₀_units : ∀ y : N₀, IsUnit (algebraMap A₀ B_L y.1) := by
      intro y
      rw [IsScalarTower.algebraMap_apply A₀ B B_L]
      let m_y : M₀ := ⟨algebraMap A₀ B y.1, ⟨y.1, y.2, rfl⟩⟩
      exact IsLocalization.map_units B_L m_y
    let φ_LB : L →+* B_L := IsLocalization.lift (M := N₀) (S := L) hN₀_units
    letI : Algebra L B_L := φ_LB.toAlgebra
    haveI : IsScalarTower A₀ L B_L := IsScalarTower.of_algebraMap_eq fun a =>
      show algebraMap A₀ B_L a = φ_LB (algebraMap A₀ L a) from
        (IsLocalization.lift_eq (M := N₀) (S := L) hN₀_units a).symm
    haveI : Algebra.FormallyEtale B B_L := Algebra.FormallyEtale.of_isLocalization M₀
    haveI : Algebra.FormallyEtale A₀ B_L := Algebra.FormallyEtale.comp A₀ B B_L
    haveI : Algebra.FormallyEtale L B_L := Algebra.FormallyEtale.localization_base N₀
    haveI : Algebra.EssFiniteType A₀ B := Algebra.EssFiniteType.of_finiteType A₀ B
    haveI : Algebra.EssFiniteType B B_L := Algebra.EssFiniteType.of_isLocalization B_L M₀
    haveI : Algebra.EssFiniteType A₀ B_L := Algebra.EssFiniteType.comp A₀ B B_L
    haveI : Algebra.EssFiniteType L B_L := by
      obtain ⟨σ, hσ⟩ := (Algebra.essFiniteType_iff A₀ B_L).mp inferInstance
      have hsub : ∀ z : B_L, z ∈ Algebra.adjoin A₀ (σ : Set B_L) →
          z ∈ Algebra.adjoin L (σ : Set B_L) := by
        intro z hz
        refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hz
        · exact fun b hb => Algebra.subset_adjoin hb
        · intro a
          rw [IsScalarTower.algebraMap_apply A₀ L B_L]
          exact Subalgebra.algebraMap_mem _ _
        · exact fun _ _ _ _ h₁ h₂ => Subalgebra.add_mem _ h₁ h₂
        · exact fun _ _ _ _ h₁ h₂ => Subalgebra.mul_mem _ h₁ h₂
      exact (Algebra.essFiniteType_iff L B_L).mpr ⟨σ, fun s => by
        obtain ⟨t, ht, hu, hst⟩ := hσ s
        exact ⟨t, hsub t ht, hu, hsub (s * t) hst⟩⟩
    obtain ⟨I, hFinI, Ai, hFieldAi, hAlgAi, ⟨e_prod⟩⟩ :=
      (Algebra.FormallyEtale.iff_exists_algEquiv_prod L B_L).mp inferInstance
    haveI : _root_.IsReduced B_L := isReduced_of_injective e_prod e_prod.injective
    have hRedB : _root_.IsReduced B := isReduced_of_injective (algebraMap B B_L) hinj
    letI : Fintype I := Fintype.ofFinite I
    letI : DecidableEq I := Classical.decEq I
    have hPrimesProd : {P : Ideal (∀ i : I, Ai i) | P.IsPrime} ⊆
        Set.range (fun i : I => RingHom.ker (Pi.evalRingHom Ai i)) := by
      intro P hP
      haveI : P.IsPrime := hP
      let u : I → (∀ j : I, Ai j) := fun i => Pi.single i 1
      have hsum : ∑ i : I, u i = 1 := by
        ext j
        simp [u, Finset.sum_apply]
      have hex : ∃ i₀ : I, u i₀ ∉ P := by
        by_contra hall
        have h1 : (1 : ∀ j : I, Ai j) ∈ P := by
          rw [← hsum]
          exact P.sum_mem fun i _ => by_contra fun hi => hall ⟨i, hi⟩
        exact hP.ne_top (P.eq_top_iff_one.mpr h1)
      obtain ⟨i₀, hi₀⟩ := hex
      refine ⟨i₀, le_antisymm ?_ ?_⟩
      · intro v hv
        have hv0 : v i₀ = 0 := hv
        have hv_mul : v * u i₀ = 0 := by
          ext j
          by_cases hj : j = i₀
          · subst hj; simp [u, Pi.single_eq_same, hv0]
          · simp [u, Pi.single_eq_of_ne hj]
        have hmem : v * u i₀ ∈ P := by rw [hv_mul]; exact P.zero_mem
        exact (hP.mem_or_mem hmem).resolve_right hi₀
      · intro v hv
        change v i₀ = 0
        by_contra hvi₀
        have hv_mul : v * Pi.single i₀ (v i₀)⁻¹ = u i₀ := by
          ext j
          by_cases hj : j = i₀
          · subst hj; simp [u, Pi.single_eq_same, mul_inv_cancel₀ hvi₀]
          · simp [u, Pi.single_eq_of_ne hj]
        exact hi₀ (hv_mul ▸ P.mul_mem_right _ hv)
    have hFinProd : {P : Ideal (∀ i : I, Ai i) | P.IsPrime}.Finite :=
      (Set.finite_range _).subset hPrimesProd
    have hSubBL : minimalPrimes B_L ⊆
        Ideal.comap e_prod.toRingHom '' {P : Ideal (∀ i : I, Ai i) | P.IsPrime} := by
      intro Q hQ
      haveI : Q.IsPrime := hQ.1.1
      refine ⟨Ideal.map e_prod.toRingHom Q, Ideal.map_isPrime_of_equiv e_prod.toRingEquiv, ?_⟩
      exact Ideal.comap_map_of_bijective e_prod.toRingHom e_prod.bijective
    have hFinBL : (minimalPrimes B_L).Finite := (hFinProd.image _).subset hSubBL
    have hcomap_bot : Ideal.comap (algebraMap B B_L) (⊥ : Ideal B_L) = (⊥ : Ideal B) := by
      ext x
      simp only [Ideal.mem_comap, Ideal.mem_bot]
      exact ⟨fun h => hinj (by simpa using h), fun h => by simp [h]⟩
    have hMinEq : minimalPrimes B = Ideal.comap (algebraMap B B_L) '' minimalPrimes B_L := by
      change (⊥ : Ideal B).minimalPrimes =
        Ideal.comap (algebraMap B B_L) '' (⊥ : Ideal B_L).minimalPrimes
      rw [← hcomap_bot]
      exact IsLocalization.minimalPrimes_comap M₀ B_L (⊥ : Ideal B_L)
    exact ⟨hRedB, hMinEq ▸ hFinBL.image _⟩
  let n : Ideal A₀ := m.under A₀
  haveI hn_prime : n.IsPrime := Ideal.comap_isPrime (algebraMap A₀ B) m
  let A₁ : Type u := Localization.AtPrime n
  let B_m : Type u := Localization.AtPrime m
  letI : m.LiesOver n := ⟨rfl⟩
  letI : Algebra A₁ B_m := Localization.AtPrime.algebraOfLiesOver n m
  have h_step2 :
      Algebra.FormallyUnramified A₁ B_m ∧
      IsLocalHom (algebraMap A₁ B_m) ∧
      Module.IsTorsionFree A₁ B_m ∧
      Algebra.IsSeparable (IsLocalRing.ResidueField A₁) (IsLocalRing.ResidueField B_m) ∧
      Ideal.map (algebraMap A₁ B_m) (IsLocalRing.maximalIdeal A₁) = IsLocalRing.maximalIdeal B_m ∧
      ∃ (R₁ : Subalgebra A₁ B_m),
        Module.Finite A₁ ↥R₁ ∧
        Algebra.IsIntegral A₁ ↥R₁ ∧
        IsLocalization (Ideal.comap (algebraMap ↥R₁ B_m) (IsLocalRing.maximalIdeal B_m)).primeCompl B_m := by
    haveI : IsScalarTower A₀ A₁ B_m := inferInstance
    have hLocHom : IsLocalHom (algebraMap A₁ B_m) := inferInstance
    haveI : Module.IsTorsionFree A₀ B_m := inferInstance
    have hTF₁ : Module.IsTorsionFree A₁ B_m := by
      rw [Module.isTorsionFree_iff_smul_eq_zero]
      intro z x hzx
      by_cases hz : z = 0
      · exact Or.inl hz
      · right
        obtain ⟨⟨a, s⟩, has⟩ := IsLocalization.surj n.primeCompl z
        have ha0 : a ≠ 0 := by
          intro ha
          have hzs : z * algebraMap A₀ A₁ s.1 = 0 := by simpa [ha] using has
          have hunit : IsUnit (algebraMap A₀ A₁ s.1) := IsLocalization.map_units A₁ s
          exact hz (hunit.mul_left_eq_zero.mp hzs)
        have hasmul : a • x = 0 := by
          rw [← IsScalarTower.algebraMap_smul A₁ a x, ← has, mul_comm, mul_smul, hzx, smul_zero]
        exact (smul_eq_zero.mp hasmul).resolve_left ha0
    haveI : Algebra.FormallyUnramified B B_m := Algebra.FormallyUnramified.of_isLocalization m.primeCompl
    haveI : Algebra.FormallyUnramified A₀ B_m := Algebra.FormallyUnramified.comp A₀ B B_m
    have hUnram : Algebra.FormallyUnramified A₁ B_m := Algebra.FormallyUnramified.localization_base n.primeCompl
    haveI : Algebra.EssFiniteType A₀ B := Algebra.EssFiniteType.of_finiteType A₀ B
    haveI : Algebra.EssFiniteType B B_m := Algebra.EssFiniteType.of_isLocalization B_m m.primeCompl
    haveI : Algebra.EssFiniteType A₀ B_m := Algebra.EssFiniteType.comp A₀ B B_m
    haveI : Algebra.EssFiniteType A₁ B_m := by
      obtain ⟨σ, hσ⟩ := (Algebra.essFiniteType_iff A₀ B_m).mp inferInstance
      have hsub : ∀ z : B_m, z ∈ Algebra.adjoin A₀ (σ : Set B_m) →
          z ∈ Algebra.adjoin A₁ (σ : Set B_m) := by
        intro z hz
        refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hz
        · exact fun b hb => Algebra.subset_adjoin hb
        · intro a
          rw [IsScalarTower.algebraMap_apply A₀ A₁ B_m]
          exact Subalgebra.algebraMap_mem _ _
        · exact fun _ _ _ _ h₁ h₂ => Subalgebra.add_mem _ h₁ h₂
        · exact fun _ _ _ _ h₁ h₂ => Subalgebra.mul_mem _ h₁ h₂
      exact (Algebra.essFiniteType_iff A₁ B_m).mpr ⟨σ, fun s => by
        obtain ⟨t, ht, hu, hst⟩ := hσ s
        exact ⟨t, hsub t ht, hu, hsub (s * t) hst⟩⟩
    have hUnramIff := (Algebra.FormallyUnramified.iff_map_maximalIdeal_eq (R := A₁) (S := B_m)).mp hUnram
    have hSep : Algebra.IsSeparable (IsLocalRing.ResidueField A₁) (IsLocalRing.ResidueField B_m) :=
      hUnramIff.1
    have hMax : Ideal.map (algebraMap A₁ B_m) (IsLocalRing.maximalIdeal A₁) = IsLocalRing.maximalIdeal B_m :=
      hUnramIff.2
    have hZMT := Algebra.ZariskisMainProperty.of_finiteType (R := A₀) m
    rw [Algebra.zariskisMainProperty_iff] at hZMT
    obtain ⟨r, hr_not_m, hr_int, hr_pow⟩ := hZMT
    obtain ⟨G, hG⟩ := (inferInstance : Algebra.FiniteType A₀ B).out
    choose k hk using hr_pow
    classical
    let ι_B : B →ₐ[A₀] B_m := IsScalarTower.toAlgHom A₀ B B_m
    let S_gen : Finset B_m := insert (ι_B r) (G.image fun b => ι_B (r ^ k b * b))
    let R₁ : Subalgebra A₁ B_m := Algebra.adjoin A₁ (S_gen : Set B_m)
    have hS_int : (S_gen : Set B_m) ⊆ integralClosure A₁ B_m := by
      intro y hy
      simp only [S_gen, Finset.coe_insert, Finset.coe_image, Set.mem_insert_iff, Set.mem_image] at hy
      rcases hy with rfl | ⟨b, _, rfl⟩
      · exact _root_.IsIntegral.tower_top (hr_int.map ι_B)
      · exact _root_.IsIntegral.tower_top ((hk b).map ι_B)
    have hR₁_le_ic : R₁ ≤ integralClosure A₁ B_m := Algebra.adjoin_le hS_int
    have hIntR₁ : Algebra.IsIntegral A₁ ↥R₁ := by
      refine ⟨fun x => ?_⟩
      have hx_bm : _root_.IsIntegral A₁ (x : B_m) := hR₁_le_ic x.2
      exact (isIntegral_algHom_iff R₁.val Subtype.val_injective).mp hx_bm
    haveI : Algebra.IsIntegral A₁ ↥R₁ := hIntR₁
    haveI : Algebra.FiniteType A₁ ↥R₁ := Algebra.FiniteType.adjoin_of_finite S_gen.finite_toSet
    have hFinR₁ : Module.Finite A₁ ↥R₁ := Algebra.IsIntegral.finite
    have hr_mem : ι_B r ∈ R₁ :=
      Algebra.subset_adjoin (Finset.mem_coe.mpr (Finset.mem_insert_self _ _))
    have hB_pow : ∀ x : B, ∃ M : ℕ, (ι_B r) ^ M * ι_B x ∈ R₁ := by
      intro x
      have hxG : x ∈ Algebra.adjoin A₀ (G : Set B) := by rw [hG]; trivial
      refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hxG
      · intro b hb
        refine ⟨k b, ?_⟩
        have hmem : ι_B (r ^ k b * b) ∈ (S_gen : Set B_m) :=
          Finset.mem_coe.mpr (Finset.mem_insert_of_mem (Finset.mem_image_of_mem _ hb))
        simpa [map_mul, map_pow] using Algebra.subset_adjoin hmem
      · intro a
        refine ⟨0, ?_⟩
        simp only [pow_zero, one_mul]
        change algebraMap A₀ B_m a ∈ R₁
        rw [IsScalarTower.algebraMap_apply A₀ A₁ B_m]
        exact R₁.algebraMap_mem (algebraMap A₀ A₁ a)
      · rintro y₁ y₂ _ _ ⟨M₁, hM₁⟩ ⟨M₂, hM₂⟩
        refine ⟨M₁ + M₂, ?_⟩
        have heq : (ι_B r) ^ (M₁ + M₂) * ι_B (y₁ + y₂) =
            (ι_B r) ^ M₂ * ((ι_B r) ^ M₁ * ι_B y₁) +
            (ι_B r) ^ M₁ * ((ι_B r) ^ M₂ * ι_B y₂) := by
          rw [map_add, pow_add]; ring
        rw [heq]
        exact R₁.add_mem (R₁.mul_mem (R₁.pow_mem hr_mem M₂) hM₁)
          (R₁.mul_mem (R₁.pow_mem hr_mem M₁) hM₂)
      · rintro y₁ y₂ _ _ ⟨M₁, hM₁⟩ ⟨M₂, hM₂⟩
        refine ⟨M₁ + M₂, ?_⟩
        have heq : (ι_B r) ^ (M₁ + M₂) * ι_B (y₁ * y₂) =
            ((ι_B r) ^ M₁ * ι_B y₁) * ((ι_B r) ^ M₂ * ι_B y₂) := by
          rw [map_mul, pow_add]; ring
        rw [heq]
        exact R₁.mul_mem hM₁ hM₂
    let q₀ : Ideal ↥R₁ := Ideal.comap (algebraMap ↥R₁ B_m) (IsLocalRing.maximalIdeal B_m)
    have hLocR₁ : IsLocalization q₀.primeCompl B_m := by
      refine ⟨?_, ?_, ?_⟩
      · intro t
        exact IsLocalRing.notMem_maximalIdeal.mp t.2
      · intro z
        obtain ⟨⟨u, v⟩, huv⟩ := IsLocalization.surj m.primeCompl z
        obtain ⟨M₁, hM₁⟩ := hB_pow u
        obtain ⟨M₂, hM₂⟩ := hB_pow v.1
        let x₀ : ↥R₁ := ⟨(ι_B r) ^ M₂ * ((ι_B r) ^ M₁ * ι_B u),
          R₁.mul_mem (R₁.pow_mem hr_mem M₂) hM₁⟩
        have ht₀_mem : (ι_B r) ^ M₁ * ((ι_B r) ^ M₂ * ι_B v.1) ∈ R₁ :=
          R₁.mul_mem (R₁.pow_mem hr_mem M₁) hM₂
