            rw [← hd_ab, pow_add]
          rw [hpow, hmon_prod]
          ring
        have hmk_sum : ∀ (S_fin : Finset (Fin 2 →₀ ℕ))
            (g_fn : (Fin 2 →₀ ℕ) → MvPolynomial (Fin 2) R),
            (∑ d ∈ S_fin, Localization.mk (g_fn d)
