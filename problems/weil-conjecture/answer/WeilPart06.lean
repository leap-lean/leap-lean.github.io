  have hGauss_all := hGaussFin φ_KF hAlg
  have hChartValFin : ∀ (P : Ideal ↥V) [P.IsPrime]
      (B : Type u) [CommRing B] (α_B : ↥V →+* B), α_B.FiniteType →
      ∀ (ψ_B : B →+* F), @IsFractionRing B _ F _ ψ_B.toAlgebra →
      ψ_B.comp α_B = φ_KF.comp V.subtype →
      {W : ValuationSubring F |
        ∃ (φ_B : B →+* ↥W) (b₁ b₂ : B),
          W.subtype.comp φ_B = ψ_B ∧
          (∀ c : ↥V, φ_B (α_B c) ∈ IsLocalRing.maximalIdeal ↥W ↔ c ∈ P) ∧
          φ_B b₂ ∉ IsLocalRing.maximalIdeal ↥W ∧
          (∀ Q : Polynomial ↥V,
            (∃ i : ℕ, Q.coeff i ∉ P) →
            (∑ i ∈ Finset.range (Q.natDegree + 1),
              φ_B (α_B (Q.coeff i) * b₁ ^ i * b₂ ^ (Q.natDegree - i))) ∉
                IsLocalRing.maximalIdeal ↥W)}.Finite := by
    intro P _ B _ α_B hFT ψ_B hFrac hComm
    have hGauss_P := hGauss_all P
    let _ : Algebra ↥V B := α_B.toAlgebra
    have _ : Algebra.FiniteType ↥V B := hFT
    let _ : Algebra B F := ψ_B.toAlgebra
    have hψB_inj : Function.Injective ψ_B :=
      @IsLocalization.injective B _ (nonZeroDivisors B) F _ _ hFrac le_rfl
    have _ : IsDomain B := Function.Injective.isDomain ψ_B hψB_inj
    let F_P := TensorProduct ↥V P.ResidueField B
    let ι_B : B →+* F_P := (Algebra.TensorProduct.includeRight : B →ₐ[↥V] F_P).toRingHom
    let ι_κ : P.ResidueField →+* F_P :=
      (Algebra.TensorProduct.includeLeft : P.ResidueField →ₐ[↥V] F_P).toRingHom
    have _ : Algebra.FiniteType P.ResidueField F_P := Algebra.FiniteType.baseChange P.ResidueField
    have _ : IsNoetherianRing F_P := Algebra.FiniteType.isNoetherianRing P.ResidueField F_P
    let ℳ_P : Set (Ideal B) := (Ideal.comap ι_B) '' (minimalPrimes F_P)
    have hℳ_fin : ℳ_P.Finite := (minimalPrimes.finite_of_isNoetherianRing F_P).image _
    have h_comap_P : ∀ Q : Ideal F_P, Q.IsPrime → ∀ c : ↥V, α_B c ∈ Ideal.comap ι_B Q ↔ c ∈ P := by
      intro Q hQ c
      have h_eq : ι_B (α_B c) = ι_κ (algebraMap ↥V P.ResidueField c) := by
        change (1 : P.ResidueField) ⊗ₜ[↥V] (α_B c) = (algebraMap ↥V P.ResidueField c) ⊗ₜ[↥V] (1 : B)
        have hc_smul : α_B c = c • (1 : B) := by
          rw [Algebra.smul_def, mul_one]; rfl
        rw [hc_smul, ← TensorProduct.smul_tmul, Algebra.smul_def, mul_one]
      change ι_B (α_B c) ∈ Q ↔ c ∈ P
      rw [h_eq]
      constructor
      · intro hmem
        by_contra hcP
        have hne : algebraMap ↥V P.ResidueField c ≠ 0 :=
          mt Ideal.algebraMap_residueField_eq_zero.mp hcP
        have hu : IsUnit (ι_κ (algebraMap ↥V P.ResidueField c)) :=
          (isUnit_iff_ne_zero.mpr hne).map ι_κ
        exact hQ.ne_top (Ideal.eq_top_of_isUnit_mem Q hmem hu)
      · intro hcP
        rw [Ideal.algebraMap_residueField_eq_zero.mpr hcP, map_zero]
        exact Q.zero_mem
    have h_min_le : ∀ q_y : Ideal B, q_y.IsPrime → (∀ c : ↥V, α_B c ∈ q_y ↔ c ∈ P) →
        ∃ q_0 ∈ ℳ_P, q_0.IsPrime ∧ q_0 ≤ q_y ∧ (∀ c : ↥V, α_B c ∈ q_0 ↔ c ∈ P) := by
      intro q_y hqy hP_qy
      have _ : q_y.IsPrime := hqy
      have hP_eq : P = Ideal.comap α_B q_y := Ideal.ext fun c => (hP_qy c).symm
      let κ_map : P.ResidueField →+* q_y.ResidueField := Ideal.ResidueField.map P q_y α_B hP_eq
      let _ : Algebra ↥V q_y.ResidueField := ((algebraMap B q_y.ResidueField).comp α_B).toAlgebra
      have _ : IsScalarTower ↥V ↥V q_y.ResidueField := IsScalarTower.of_algebraMap_eq' rfl
      let f₁ : P.ResidueField →ₐ[↥V] q_y.ResidueField :=
        { κ_map with
          commutes' := fun c => Ideal.ResidueField.map_algebraMap P q_y α_B hP_eq c }
      let f₂ : B →ₐ[↥V] q_y.ResidueField :=
        { algebraMap B q_y.ResidueField with commutes' := fun _ => rfl }
      let ev : F_P →ₐ[↥V] q_y.ResidueField :=
        Algebra.TensorProduct.lift f₁ f₂ (fun _ _ => Commute.all _ _)
      let Q_y : Ideal F_P := RingHom.ker ev.toRingHom
      have _ : Q_y.IsPrime := RingHom.ker_isPrime ev.toRingHom
      have hQy_comap : Ideal.comap ι_B Q_y = q_y := by
        ext b
        change ev (1 ⊗ₜ[↥V] b) = 0 ↔ b ∈ q_y
        have hev_b : ev (1 ⊗ₜ[↥V] b) = algebraMap B q_y.ResidueField b := by
          dsimp [ev]
          rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
          rfl
        rw [hev_b, Ideal.algebraMap_residueField_eq_zero]
      obtain ⟨Q_0, hQ0_min, hQ0_le⟩ :=
        Ideal.exists_minimalPrimes_le (bot_le : (⊥ : Ideal F_P) ≤ Q_y)
      have hQ0_prime : Q_0.IsPrime := hQ0_min.1.1
      refine ⟨Ideal.comap ι_B Q_0, ⟨Q_0, hQ0_min, rfl⟩, hQ0_prime.comap ι_B, ?_,
        h_comap_P Q_0 hQ0_prime⟩
      rw [← hQy_comap]
      exact Ideal.comap_mono hQ0_le
    let S_Pt_fn : F → Set (ValuationSubring F) := fun t =>
      {W : ValuationSubring F |
        ∃ (hV : ∀ c : ↥V, φ_KF (V.subtype c) ∈ W) (ht : t ∈ W),
          (∀ c : ↥V,
            ((⟨φ_KF (V.subtype c), hV c⟩ : ↥W) ∈ IsLocalRing.maximalIdeal ↥W ↔ c ∈ P)) ∧
          (∀ Q : Polynomial ↥V,
            (∃ i : ℕ, Q.coeff i ∉ P) →
            Polynomial.eval₂ ((φ_KF.comp V.subtype).codRestrict W.toSubring hV) ⟨t, ht⟩ Q ∉
              IsLocalRing.maximalIdeal ↥W)}
    let 𝒯 : Ideal B → Set (B × B) := fun q =>
      {p : B × B | p.2 ∉ q ∧
        ∀ Q : Polynomial ↥V, (∃ i : ℕ, Q.coeff i ∉ P) →
          (∑ i ∈ Finset.range (Q.natDegree + 1),
            α_B (Q.coeff i) * p.1 ^ i * p.2 ^ (Q.natDegree - i)) ∉ q}
    have hBridge : ∀ (W : ValuationSubring F) (φ : B →+* ↥W) (b₁ b₂ : B),
        W.subtype.comp φ = ψ_B →
        (∀ c : ↥V, φ (α_B c) ∈ IsLocalRing.maximalIdeal ↥W ↔ c ∈ P) →
        (b₁, b₂) ∈ 𝒯 (Ideal.comap φ (IsLocalRing.maximalIdeal ↥W)) →
        W ∈ S_Pt_fn (ψ_B b₁ * (ψ_B b₂)⁻¹) := by
      intro W φ b₁ b₂ hφ hP_φ ⟨hb₂, hHomog⟩
      have hV_W : ∀ c : ↥V, φ_KF (V.subtype c) ∈ W := by
        intro c
        have hc1 : φ_KF (V.subtype c) = ψ_B (α_B c) :=
          congrFun (congrArg DFunLike.coe hComm.symm) c
        have hc2 : ψ_B (α_B c) = (φ (α_B c)).1 :=
          (congrFun (congrArg DFunLike.coe hφ) (α_B c)).symm
        rw [hc1, hc2]
        exact (φ (α_B c)).2
      have h_cod_eq : ∀ c : ↥V,
          ((φ_KF.comp V.subtype).codRestrict W.toSubring hV_W) c = φ (α_B c) := by
        intro c
        apply Subtype.ext
        have hc1 : φ_KF (V.subtype c) = ψ_B (α_B c) :=
          congrFun (congrArg DFunLike.coe hComm.symm) c
        have hc2 : ψ_B (α_B c) = (φ (α_B c)).1 :=
          (congrFun (congrArg DFunLike.coe hφ) (α_B c)).symm
        exact hc1.trans hc2
      have hu₂ : IsUnit (φ b₂) := IsLocalRing.notMem_maximalIdeal.mp hb₂
      let u₂ : ↥W := ↑(hu₂.unit⁻¹)
      have hu₂_mul : φ b₂ * u₂ = 1 := hu₂.mul_val_inv
      have hψb₂_mul : ψ_B b₂ * (u₂ : F) = 1 := by
        have h1 : W.subtype (φ b₂ * u₂) = 1 := by rw [hu₂_mul, map_one]
        have h2 : W.subtype (φ b₂) = ψ_B b₂ := congrFun (congrArg DFunLike.coe hφ) b₂
        simpa [map_mul, h2] using h1
      have hψb₂_inv : (ψ_B b₂)⁻¹ = (u₂ : F) := inv_eq_of_mul_eq_one_right hψb₂_mul
      have ht_W : ψ_B b₁ * (ψ_B b₂)⁻¹ ∈ W := by
        rw [hψb₂_inv]
        have h1 : ψ_B b₁ = (φ b₁).1 := (congrFun (congrArg DFunLike.coe hφ) b₁).symm
        rw [h1]
        exact (φ b₁ * u₂).2
      have ht_mul : (⟨ψ_B b₁ * (ψ_B b₂)⁻¹, ht_W⟩ : ↥W) * φ b₂ = φ b₁ := by
        apply Subtype.ext
        change (ψ_B b₁ * (ψ_B b₂)⁻¹) * (φ b₂).1 = (φ b₁).1
        have h1 : (φ b₁).1 = ψ_B b₁ := congrFun (congrArg DFunLike.coe hφ) b₁
        have h2 : (φ b₂).1 = ψ_B b₂ := congrFun (congrArg DFunLike.coe hφ) b₂
        have hne : ψ_B b₂ ≠ 0 := left_ne_zero_of_mul_eq_one hψb₂_mul
        rw [h1, h2, inv_mul_cancel_right₀ hne]
      refine ⟨hV_W, ht_W, ?_, ?_⟩
      · intro c
        have hc_sub : (⟨φ_KF (V.subtype c), hV_W c⟩ : ↥W) = φ (α_B c) := h_cod_eq c
        rw [hc_sub]
        exact hP_φ c
      · intro Q hQ
        let d := Q.natDegree
        let ρ := (φ_KF.comp V.subtype).codRestrict W.toSubring hV_W
        let t_el : ↥W := ⟨ψ_B b₁ * (ψ_B b₂)⁻¹, ht_W⟩
        have h_sum_eq : φ (∑ i ∈ Finset.range (d + 1), α_B (Q.coeff i) * b₁ ^ i * b₂ ^ (d - i)) =
            (φ b₂) ^ d * Polynomial.eval₂ ρ t_el Q := by
          rw [Polynomial.eval₂_eq_sum_range, Finset.mul_sum, map_sum]
          refine Finset.sum_congr rfl fun i hi => ?_
          have hi_le : i ≤ d := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
          have h_pow : (φ b₂) ^ d = (φ b₂) ^ i * (φ b₂) ^ (d - i) := by
            rw [← pow_add, Nat.add_sub_of_le hi_le]
          rw [h_cod_eq (Q.coeff i), map_mul, map_mul, map_pow, map_pow, ← ht_mul, mul_pow, h_pow]
          ring
        intro h_mem_max
        have h_lhs_mem : φ (∑ i ∈ Finset.range (d + 1), α_B (Q.coeff i) * b₁ ^ i * b₂ ^ (d - i)) ∈
            IsLocalRing.maximalIdeal ↥W := by
          rw [h_sum_eq]
          exact Ideal.mul_mem_left _ ((φ b₂) ^ d) h_mem_max
        exact hHomog Q hQ h_lhs_mem
    have hIsUnit_val : ∀ (W : ValuationSubring F) (x : ↥W),
        IsUnit x ↔ (x : F) ≠ 0 ∧ (x : F)⁻¹ ∈ W := by
      intro W x
      constructor
      · rintro ⟨u, rfl⟩
        have hmul : (u.1 : F) * (u.inv : F) = 1 :=
          calc (u.1 : F) * (u.inv : F) = ((u.1 * u.inv : ↥W) : F) := rfl
