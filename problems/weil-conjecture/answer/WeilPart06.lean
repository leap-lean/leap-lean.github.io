          _ = η_A0 (ι_a (b₁' * (t_s * π₁'))) * u₀_inv := by
                rw [← map_mul η_A0, ← map_mul ι_a]
          _ = η_A0 (ι_a a_Rz) * u₀_inv := by rw [hb_eq]
          _ = η_A0 (u₀ * u₁) * u₀_inv := by rw [← hu₀u₁]
          _ = η_A0 u₁ * (η_A0 u₀ * u₀_inv) := by rw [map_mul η_A0]; ring
          _ = η_A0 u₁ := by rw [hu₀_inv, mul_one]
    · intro α hα_alg hα_inv
      let M₀ := Localization.Away (p₀_hom u₀)
      let η_C₀ : C₀ →+* M₀ := algebraMap C₀ M₀
      apply nodalHom_ext π₁'
      · intro r
        rw [RingHom.comp_apply, hψ₀_C r, RingHom.comp_apply, hα_alg (ι_a r)]
        exact congrArg η_C₀ (hp₀_C r)
      · rw [RingHom.comp_apply, hψ₀_X0, hα_alg (ι_a s₁' * u₀)]
        exact congrArg η_C₀ hp₀_sX0
      · rw [RingHom.comp_apply, hψ₀_X1, map_mul α, hα_alg (ι_a (t_s * π₁')), hα_inv]
        have hp₀_tsπ : η_C₀ (p₀_hom (ι_a (t_s * π₁'))) = η_C₀ (ι_0 (t_s * π₁')) :=
