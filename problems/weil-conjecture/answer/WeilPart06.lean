theorem weil_normal_curve_proper_chart_over_poly_isAffine_and_finite (k₀ : Type u) [Field k₀] [IsAlgClosed k₀]
    (X_tilde : AlgebraicGeometry.Scheme.{u})
    [AlgebraicGeometry.IsIntegral X_tilde]
    (p_tilde : X_tilde ⟶ AlgebraicGeometry.Spec (CommRingCat.of k₀))
    (hPropTilde : AlgebraicGeometry.IsProper p_tilde)
    (hNorm : ∀ (U : X_tilde.Opens), AlgebraicGeometry.IsAffineOpen U → Nonempty U →
      IsDomain ↑(X_tilde.presheaf.obj (Opposite.op U)) ∧
      IsIntegrallyClosed ↑(X_tilde.presheaf.obj (Opposite.op U)) ∧
      Ring.DimensionLEOne ↑(X_tilde.presheaf.obj (Opposite.op U)))
    (hFinIntClosure : ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra k₀ A] [Algebra.FiniteType k₀ A]
      (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K],
      Module.Finite A ↥(integralClosure A K) ∧ IsIntegrallyClosed ↥(integralClosure A K))
    (Ω : X_tilde.Opens) [Nonempty Ω]
    (f : ↑(X_tilde.presheaf.obj (Opposite.op Ω)))
    (hInj : Function.Injective
      (Polynomial.eval₂RingHom
        (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
          p_tilde.appLE ⊤ Ω le_top).hom) f))
    (hPropChart : AlgebraicGeometry.IsProper
      (Ω.toScheme.toSpecΓ ≫
        AlgebraicGeometry.Spec.map Ω.topIso.inv ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (Polynomial.eval₂RingHom
            (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
              p_tilde.appLE ⊤ Ω le_top).hom) f)))) :
    AlgebraicGeometry.IsAffineOpen Ω ∧
      (Polynomial.eval₂RingHom
        (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
          p_tilde.appLE ⊤ Ω le_top).hom) f).Finite :=
by
  
  have h_cV_ft : ∀ (V : X_tilde.Opens), AlgebraicGeometry.IsAffineOpen V →
      (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
        p_tilde.appLE ⊤ V le_top).hom).FiniteType := by
    intro V hV
    have : AlgebraicGeometry.IsProper p_tilde := hPropTilde
    have h1 : (p_tilde.appLE ⊤ V le_top).hom.FiniteType :=
      p_tilde.finiteType_appLE (isAffineOpen_top _) hV le_top
    have hSurjInv : Function.Surjective
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv.hom) := fun y =>
      ⟨(AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).hom.hom y,
        congrArg (fun g => g.hom y)
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).hom_inv_id⟩
    exact RingHom.FiniteType.comp h1 (RingHom.FiniteType.of_surjective _ hSurjInv)

  have h_cV_res : ∀ (V : X_tilde.Opens) (hV_Ω : V ≤ Ω) (c : k₀),
      (X_tilde.presheaf.map (CategoryTheory.homOfLE hV_Ω).op).hom
        (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
          p_tilde.appLE ⊤ Ω le_top).hom c) =
      (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
        p_tilde.appLE ⊤ V le_top).hom c) := by
    intro V hV_Ω c
    have hMap := p_tilde.appLE_map (U := ⊤) (V := Ω) (V' := V) le_top
      (CategoryTheory.homOfLE hV_Ω).op
    exact congrArg
      (fun g => ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫ g).hom c) hMap

  have hGenericMem : ∀ (W : X_tilde.Opens) [Nonempty W], genericPoint ↥X_tilde ∈ W := by
    intro W hW
    obtain ⟨x, hx⟩ := hW
    exact ((genericPoint_spec ↥X_tilde).mem_open_set_iff W.isOpen).mpr ⟨x, trivial, hx⟩

  
  have h_s1 : ∀ (A_V : Type u) [CommRing A_V] [IsDomain A_V] [Ring.DimensionLEOne A_V]
      (F_ss : Type u) [Field F_ss]
      (c_V : k₀ →+* A_V), c_V.FiniteType →
      ∀ (t_V : A_V) (ι_V : A_V →+* F_ss),
      @IsFractionRing A_V _ F_ss _ ι_V.toAlgebra →
      ∀ (α_0 : Polynomial k₀ →+* F_ss),
      Function.Injective α_0 →
      (∀ c : k₀, α_0 (Polynomial.C c) = ι_V (c_V c)) →
      α_0 Polynomial.X = ι_V t_V →
      letI : Algebra (Polynomial k₀) F_ss := α_0.toAlgebra
      Module.Finite (Polynomial k₀) ↥(integralClosure (Polynomial k₀) F_ss) ∧
        IsIntegrallyClosed ↥(integralClosure (Polynomial k₀) F_ss) ∧
        IsFractionRing ↥(integralClosure (Polynomial k₀) F_ss) F_ss := by
    intro A_V _ _ _ F_ss _ c_V hc_ft t_V ι_V hFracV α_0 hInjα hCompat_C hCompat_X
    let A_0 : Type u := Polynomial k₀
    let : Algebra A_0 F_ss := α_0.toAlgebra
    have hAlgA0 : ∀ p : A_0, algebraMap A_0 F_ss p = α_0 p := fun _ => rfl
    have : FaithfulSMul A_0 F_ss := ⟨fun {p₁ p₂} h => by
      have h1 := h (1 : F_ss)
      rw [Algebra.smul_def, Algebra.smul_def, mul_one, mul_one] at h1
      exact hInjα h1⟩
    let K_0 : Type u := FractionRing A_0
    let : Algebra K_0 F_ss := FractionRing.liftAlgebra A_0 F_ss
    have : IsScalarTower A_0 K_0 F_ss := FractionRing.isScalarTower_liftAlgebra A_0 F_ss
    let ψ_V : A_0 →+* A_V := Polynomial.eval₂RingHom c_V t_V
    have hψ_eq : ∀ p : A_0, α_0 p = ι_V (ψ_V p) := by
      have hExt : α_0 = ι_V.comp ψ_V := by
        apply Polynomial.ringHom_ext'
        · ext c
          simp [ψ_V, hCompat_C c]
        · simp [ψ_V, hCompat_X]
      intro p
      exact congrArg (fun g : A_0 →+* F_ss => g p) hExt
    have hFinK0 : Module.Finite K_0 F_ss := by
      let : Algebra k₀ A_V := c_V.toAlgebra
      have : Algebra.FiniteType k₀ A_V := hc_ft
      obtain ⟨G, hG_top⟩ := Algebra.FiniteType.out (R := k₀) (A := A_V)
      let R_sub : Subalgebra K_0 F_ss := Algebra.adjoin K_0 (ι_V '' (G : Set A_V))
      have hFT_R : Algebra.FiniteType K_0 ↥R_sub :=
        Algebra.FiniteType.adjoin_of_finite (G.finite_toSet.image ι_V)
      have hι_mem : ∀ a : A_V, ι_V a ∈ R_sub := by
        let S_av : Subalgebra k₀ A_V :=
          { carrier := { a : A_V | ι_V a ∈ R_sub }
            mul_mem' := fun {x y} hx hy => by
              change ι_V (x * y) ∈ R_sub; rw [map_mul]; exact R_sub.mul_mem hx hy
            one_mem' := by change ι_V 1 ∈ R_sub; rw [map_one]; exact R_sub.one_mem
            add_mem' := fun {x y} hx hy => by
              change ι_V (x + y) ∈ R_sub; rw [map_add]; exact R_sub.add_mem hx hy
            zero_mem' := by change ι_V 0 ∈ R_sub; rw [map_zero]; exact R_sub.zero_mem
            algebraMap_mem' := fun c => by
              change ι_V (c_V c) ∈ R_sub
              rw [← hCompat_C c, ← hAlgA0, IsScalarTower.algebraMap_apply A_0 K_0 F_ss]
              exact R_sub.algebraMap_mem _ }
        have hle : Algebra.adjoin k₀ (G : Set A_V) ≤ S_av :=
          Algebra.adjoin_le fun g hg => Algebra.subset_adjoin ⟨g, hg, rfl⟩
        rw [hG_top] at hle
        intro a
        exact hle trivial
      let γ : A_V →+* ↥R_sub := ι_V.codRestrict R_sub.toSubring hι_mem
      have hClear : ∀ {z : F_ss}, z ∈ R_sub →
          ∃ (d : A_0) (a : A_V), d ≠ 0 ∧ α_0 d * z = ι_V a := by
        intro z hz
        refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hz
        · rintro _ ⟨g, _, rfl⟩
          exact ⟨1, g, one_ne_zero, by rw [map_one, one_mul]⟩
        · intro x
          obtain ⟨p, q, hq_mem, hpq⟩ := IsFractionRing.div_surjective (A := A_0) x
          have hq_ne : q ≠ 0 := nonZeroDivisors.ne_zero hq_mem
          have hqK_ne : algebraMap A_0 K_0 q ≠ 0 :=
            fun h => hq_ne (IsFractionRing.injective A_0 K_0 (h.trans (map_zero _).symm))
          have hqx : algebraMap A_0 K_0 q * x = algebraMap A_0 K_0 p := by
            rw [← hpq, mul_div_cancel₀ _ hqK_ne]
          refine ⟨q, ψ_V p, hq_ne, ?_⟩
          have h1 := congrArg (algebraMap K_0 F_ss) hqx
          rw [map_mul, ← IsScalarTower.algebraMap_apply A_0 K_0 F_ss,
            ← IsScalarTower.algebraMap_apply A_0 K_0 F_ss, hAlgA0, hAlgA0, hψ_eq p] at h1
          exact h1
        · rintro x y _ _ ⟨d₁, a₁, hd₁, h₁⟩ ⟨d₂, a₂, hd₂, h₂⟩
          refine ⟨d₁ * d₂, ψ_V d₂ * a₁ + ψ_V d₁ * a₂, mul_ne_zero hd₁ hd₂, ?_⟩
          calc
            α_0 (d₁ * d₂) * (x + y)
              = α_0 d₂ * (α_0 d₁ * x) + α_0 d₁ * (α_0 d₂ * y) := by rw [map_mul]; ring
            _ = ι_V (ψ_V d₂) * ι_V a₁ + ι_V (ψ_V d₁) * ι_V a₂ := by
              rw [h₁, h₂, hψ_eq d₁, hψ_eq d₂]
            _ = ι_V (ψ_V d₂ * a₁ + ψ_V d₁ * a₂) := by rw [← map_mul, ← map_mul, ← map_add]
        · rintro x y _ _ ⟨d₁, a₁, hd₁, h₁⟩ ⟨d₂, a₂, hd₂, h₂⟩
          refine ⟨d₁ * d₂, a₁ * a₂, mul_ne_zero hd₁ hd₂, ?_⟩
          calc
            α_0 (d₁ * d₂) * (x * y) = (α_0 d₁ * x) * (α_0 d₂ * y) := by rw [map_mul]; ring
            _ = ι_V a₁ * ι_V a₂ := by rw [h₁, h₂]
            _ = ι_V (a₁ * a₂) := (map_mul ι_V a₁ a₂).symm
      have hUnitR : ∀ w : ↥R_sub, w ≠ 0 → IsUnit w := by
        intro w hw_ne
        by_contra hnu
        have hSpan_ne : Ideal.span ({w} : Set ↥R_sub) ≠ ⊤ :=
          fun htop => hnu (Ideal.span_singleton_eq_top.mp htop)
        obtain ⟨𝔔, hQ_max, hle_Q⟩ := Ideal.exists_le_maximal _ hSpan_ne
        have hw_Q : w ∈ 𝔔 := hle_Q (Ideal.subset_span (Set.mem_singleton w))
        have : 𝔔.IsPrime := hQ_max.isPrime
        let 𝔓 : Ideal A_V := Ideal.comap γ 𝔔
        have : 𝔓.IsPrime := Ideal.comap_isPrime γ 𝔔
        obtain ⟨d, a, hd_ne, hda⟩ := hClear w.2
        have hw_val_ne : (w : F_ss) ≠ 0 := fun h => hw_ne (Subtype.ext h)
        have hd_val_ne : α_0 d ≠ 0 := fun h => hd_ne (hInjα (h.trans (map_zero α_0).symm))
        have ha_ne : a ≠ 0 := by
          intro ha0
          rw [ha0, map_zero] at hda
          exact mul_ne_zero hd_val_ne hw_val_ne hda
        let d_R : ↥R_sub := ⟨α_0 d, by
          rw [← hAlgA0, IsScalarTower.algebraMap_apply A_0 K_0 F_ss]
          exact R_sub.algebraMap_mem _⟩
        have hγa_eq : γ a = d_R * w := Subtype.ext hda.symm
        have ha_P : a ∈ 𝔓 := by
          change γ a ∈ 𝔔
          rw [hγa_eq]
          exact 𝔔.mul_mem_left d_R hw_Q
        have hP_ne_bot : 𝔓 ≠ ⊥ := fun hbot => ha_ne (Ideal.mem_bot.mp (hbot ▸ ha_P))
        have hP_max : 𝔓.IsMaximal := Ring.DimensionLEOne.maximalOfPrime hP_ne_bot inferInstance
        let L_P := A_V ⧸ 𝔓
        let : Field L_P := Ideal.Quotient.field 𝔓
        have hFT_LP : Algebra.FiniteType A_V L_P :=
          RingHom.FiniteType.of_surjective (Ideal.Quotient.mk 𝔓) Ideal.Quotient.mk_surjective
        have : IsScalarTower k₀ A_V L_P := IsScalarTower.of_algebraMap_eq' rfl
        have : Algebra.FiniteType k₀ L_P := Algebra.FiniteType.trans hc_ft hFT_LP
        have : Module.Finite k₀ L_P := finite_of_finite_type_of_isJacobsonRing k₀ L_P
        have : Algebra.IsIntegral k₀ L_P := Algebra.IsIntegral.of_finite k₀ L_P
        obtain ⟨c, hc⟩ :=
          (IsAlgClosed.algebraMap_bijective_of_isIntegral (k := k₀) (K := L_P)).2
            (Ideal.Quotient.mk 𝔓 t_V)
        have hc_mem : t_V - c_V c ∈ 𝔓 := by
          rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub]
          have hAlgLP : algebraMap k₀ L_P c = Ideal.Quotient.mk 𝔓 (c_V c) := rfl
          rw [← hAlgLP, hc, sub_self]
        let p_c : A_0 := Polynomial.X - Polynomial.C c
        have hpc_ne : p_c ≠ 0 := Polynomial.X_sub_C_ne_zero c
        let u_K : K_0 := algebraMap A_0 K_0 p_c
        have huK_ne : u_K ≠ 0 :=
          fun h => hpc_ne (IsFractionRing.injective A_0 K_0 (h.trans (map_zero _).symm))
        have huR_unit : IsUnit (algebraMap K_0 ↥R_sub u_K) :=
          (IsUnit.mk0 u_K huK_ne).map (algebraMap K_0 ↥R_sub)
        have huR_eq : algebraMap K_0 ↥R_sub u_K = γ (t_V - c_V c) := by
          apply Subtype.ext
          change algebraMap K_0 F_ss (algebraMap A_0 K_0 p_c) = ι_V (t_V - c_V c)
          rw [← IsScalarTower.algebraMap_apply A_0 K_0 F_ss, hAlgA0]
          dsimp [p_c]
          rw [map_sub, hCompat_X, hCompat_C c, map_sub]
        have huR_mem : algebraMap K_0 ↥R_sub u_K ∈ 𝔔 := by
          rw [huR_eq]; exact hc_mem
        exact hQ_max.ne_top (Ideal.eq_top_of_isUnit_mem 𝔔 huR_mem huR_unit)
      have hR_top : R_sub = ⊤ := by
        rw [eq_top_iff]
        intro x _
        let : Algebra A_V F_ss := ι_V.toAlgebra
        have : IsFractionRing A_V F_ss := hFracV
        obtain ⟨a, b, hb_mem, hab⟩ := IsFractionRing.div_surjective (A := A_V) x
        have hb_ne : b ≠ 0 := nonZeroDivisors.ne_zero hb_mem
        have hιb_ne : ι_V b ≠ 0 :=
          fun h => hb_ne (IsFractionRing.injective A_V F_ss (h.trans (map_zero ι_V).symm))
        have hγb_ne : γ b ≠ 0 := fun h => hιb_ne (congrArg Subtype.val h)
        obtain ⟨v, hv⟩ := (hUnitR (γ b) hγb_ne).exists_right_inv
        have hbv_F : ι_V b * (v : F_ss) = 1 := congrArg Subtype.val hv
        have hx_eq : x = (γ a * v : ↥R_sub).1 := by
          change x = ι_V a * (v : F_ss)
          have hab' : ι_V a / ι_V b = x := hab
          calc
            x = (ι_V a / ι_V b) * (ι_V b * (v : F_ss)) := by rw [hab', hbv_F, mul_one]
            _ = ι_V a * (v : F_ss) := by rw [← mul_assoc, div_mul_cancel₀ _ hιb_ne]
        rw [hx_eq]
        exact (γ a * v).2
      have hSurjR : Function.Surjective (algebraMap ↥R_sub F_ss) :=
        fun x => ⟨⟨x, hR_top ▸ trivial⟩, rfl⟩
      have hFT_RF : Algebra.FiniteType ↥R_sub F_ss :=
        RingHom.FiniteType.of_surjective _ hSurjR
      have : IsScalarTower K_0 ↥R_sub F_ss := IsScalarTower.of_algebraMap_eq' rfl
      have : Algebra.FiniteType K_0 F_ss := Algebra.FiniteType.trans hFT_R hFT_RF
      exact finite_of_finite_type_of_isJacobsonRing K_0 F_ss
    have hIC_B0 : IsIntegrallyClosed ↥(integralClosure A_0 F_ss) :=
      integralClosure.isIntegrallyClosedOfFiniteExtension K_0
    obtain ⟨Y_0, hY_0⟩ := Module.Finite.fg_top (R := K_0) (M := F_ss)
    have : Algebra.IsIntegral K_0 F_ss := Algebra.IsIntegral.of_finite K_0 F_ss
    have hm_ex : ∀ y : F_ss, ∃ m : nonZeroDivisors A_0, _root_.IsIntegral A_0 ((m : A_0) • y) :=
      fun y => _root_.IsIntegral.exists_multiple_integral_of_isLocalization
        (nonZeroDivisors A_0) y (Algebra.IsIntegral.isIntegral (R := K_0) y)
    choose m_fn hm_int using hm_ex
    let z_fn : F_ss → F_ss := fun y => (m_fn y : A_0) • y
    let A_mid : Subalgebra A_0 F_ss := Algebra.adjoin A_0 (z_fn '' (Y_0 : Set F_ss))
    have hFin_Amid : Module.Finite A_0 ↥A_mid :=
      Algebra.finite_adjoin_of_finite_of_isIntegral (Y_0.finite_toSet.image z_fn)
        (by rintro _ ⟨y, _, rfl⟩; exact hm_int y)
    have : Algebra.IsIntegral A_0 ↥A_mid := Algebra.IsIntegral.of_finite A_0 ↥A_mid
    have hFT_Amid : Algebra.FiniteType A_0 ↥A_mid :=
      Algebra.FiniteType.adjoin_of_finite (Y_0.finite_toSet.image z_fn)
    have hFrac_Amid : IsFractionRing ↥A_mid F_ss := by
      refine { map_units := ?_, surj := ?_, exists_of_eq := ?_ }
      · intro s
        have hs_ne : (s : ↥A_mid) ≠ 0 := nonZeroDivisors.ne_zero s.2
        exact IsUnit.mk0 _ (fun h => hs_ne (Subtype.ext h))
      · intro x
        have hx_span : x ∈ Submodule.span K_0 (Y_0 : Set F_ss) := by rw [hY_0]; trivial
        obtain ⟨c, _, hc_sum⟩ := Submodule.mem_span_finset.mp hx_span
        let μ : F_ss → K_0 := fun y => algebraMap A_0 K_0 (m_fn y : A_0)
        have hμ_ne : ∀ y : F_ss, μ y ≠ 0 := fun y h =>
          nonZeroDivisors.ne_zero (m_fn y).2
            (IsFractionRing.injective A_0 K_0 (h.trans (map_zero _).symm))
        let c' : F_ss → K_0 := fun y => c y / μ y
        have hx_z : ∑ y ∈ Y_0, c' y • z_fn y = x := by
          rw [← hc_sum]
          refine Finset.sum_congr rfl fun y _ => ?_
          dsimp [c', z_fn, μ]
          rw [← algebraMap_smul K_0 (m_fn y : A_0) y, smul_smul, div_mul_cancel₀ _ (hμ_ne y)]
        obtain ⟨D, hD_int⟩ :=
          IsLocalization.exist_integer_multiples (nonZeroDivisors A_0) Y_0 c'
        have hD_ne : (D : A_0) ≠ 0 := nonZeroDivisors.ne_zero D.2
        have hDF_ne : α_0 (D : A_0) ≠ 0 :=
          fun h => hD_ne (hInjα (h.trans (map_zero α_0).symm))
        let d_mid : ↥A_mid := algebraMap A_0 ↥A_mid (D : A_0)
        have hd_mid_ne : d_mid ≠ 0 := fun h => hDF_ne (congrArg Subtype.val h)
        have h_sum_mem : x * (d_mid : F_ss) ∈ A_mid := by
          have hmul : x * (d_mid : F_ss) = ∑ y ∈ Y_0, ((D : A_0) • c' y) • z_fn y := by
            change x * α_0 (D : A_0) = _
            rw [mul_comm, ← hAlgA0, ← Algebra.smul_def, ← hx_z, Finset.smul_sum]
            refine Finset.sum_congr rfl fun y _ => ?_
            rw [smul_assoc]
          rw [hmul]
          refine A_mid.sum_mem fun y hy => ?_
          obtain ⟨p_y, hp_y⟩ := hD_int y hy
          rw [← hp_y, algebraMap_smul K_0 p_y (z_fn y), Algebra.smul_def]
          exact A_mid.mul_mem (A_mid.algebraMap_mem p_y)
            (Algebra.subset_adjoin ⟨y, hy, rfl⟩)
        exact ⟨⟨⟨x * (d_mid : F_ss), h_sum_mem⟩,
          ⟨d_mid, mem_nonZeroDivisors_of_ne_zero hd_mid_ne⟩⟩, rfl⟩
      · intro x₁ x₂ hx
        exact ⟨1, by simp [Subtype.ext hx]⟩
    have hAmid_le : A_mid ≤ integralClosure A_0 F_ss :=
      Algebra.adjoin_le (by rintro _ ⟨y, _, rfl⟩; exact hm_int y)
    have hFrac_B0 : IsFractionRing ↥(integralClosure A_0 F_ss) F_ss := by
      refine { map_units := ?_, surj := ?_, exists_of_eq := ?_ }
      · intro s
        have hs_ne : (s : ↥(integralClosure A_0 F_ss)) ≠ 0 := nonZeroDivisors.ne_zero s.2
        exact IsUnit.mk0 _ (fun h => hs_ne (Subtype.ext h))
      · intro x
        obtain ⟨⟨a, s⟩, has⟩ :=
          @IsLocalization.surj _ _ (nonZeroDivisors ↥A_mid) F_ss _ _ hFrac_Amid x
        have hs_ne : (s : ↥A_mid) ≠ 0 := nonZeroDivisors.ne_zero s.2
        let s' : ↥(integralClosure A_0 F_ss) := ⟨s.1.1, hAmid_le s.1.2⟩
        have hs'_ne : s' ≠ 0 := fun h =>
          hs_ne (Subtype.ext (congrArg (fun w : ↥(integralClosure A_0 F_ss) => w.1) h))
        exact ⟨⟨⟨a.1, hAmid_le a.2⟩, ⟨s', mem_nonZeroDivisors_of_ne_zero hs'_ne⟩⟩, has⟩
      · intro x₁ x₂ hx
        exact ⟨1, by simp [Subtype.ext hx]⟩
    have hFin_IC_Amid : Module.Finite ↥A_mid ↥(integralClosure ↥A_mid F_ss) := by
      let : Algebra k₀ ↥A_mid := ((algebraMap A_0 ↥A_mid).comp Polynomial.C).toAlgebra
      have : IsScalarTower k₀ A_0 ↥A_mid := IsScalarTower.of_algebraMap_eq' rfl
      have : Algebra.FiniteType k₀ ↥A_mid :=
        Algebra.FiniteType.trans (inferInstance : Algebra.FiniteType k₀ A_0) hFT_Amid
      have : IsFractionRing ↥A_mid F_ss := hFrac_Amid
      exact (hFinIntClosure ↥A_mid F_ss).1
    have hFin_B0 : Module.Finite A_0 ↥(integralClosure A_0 F_ss) := by
      let B'_0 := ↥(integralClosure A_0 F_ss)
      let : Algebra ↥A_mid B'_0 := (Subalgebra.inclusion hAmid_le).toAlgebra
      have : IsScalarTower A_0 ↥A_mid B'_0 := IsScalarTower.of_algebraMap_eq' rfl
      have : IsScalarTower A_0 ↥A_mid F_ss := IsScalarTower.of_algebraMap_eq' rfl
      let e_ic : ↥(integralClosure ↥A_mid F_ss) →ₗ[↥A_mid] B'_0 :=
        { toFun := fun w => ⟨w.1, _root_.isIntegral_trans (R := A_0) (A := ↥A_mid) w.1 w.2⟩
          map_add' := fun _ _ => rfl
          map_smul' := fun _ _ => rfl }
      have he_surj : Function.Surjective e_ic := fun u =>
        ⟨⟨u.1, _root_.IsIntegral.tower_top (R := A_0) (A := ↥A_mid) u.2⟩, Subtype.ext rfl⟩
      have : Module.Finite ↥A_mid ↥(integralClosure ↥A_mid F_ss) := hFin_IC_Amid
      have : Module.Finite ↥A_mid B'_0 := Module.Finite.of_surjective e_ic he_surj
      exact Module.Finite.trans ↥A_mid B'_0
    exact ⟨hFin_B0, hIC_B0, hFrac_B0⟩

  
  let c_Ω : k₀ →+* ↑(X_tilde.presheaf.obj (Opposite.op Ω)) :=
    (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
      p_tilde.appLE ⊤ Ω le_top).hom)
  let Φ : Polynomial k₀ →+* ↑(X_tilde.presheaf.obj (Opposite.op Ω)) :=
    Polynomial.eval₂RingHom c_Ω f
  let F_ss : Type u := ↑X_tilde.functionField
  let α_0 : Polynomial k₀ →+* F_ss := (X_tilde.germToFunctionField Ω).hom.comp Φ
  have hInjα : Function.Injective α_0 :=
    (X_tilde.germToFunctionField_injective Ω).comp hInj

  obtain ⟨⟨x_0, hx_0⟩⟩ := (inferInstance : Nonempty Ω)
  obtain ⟨V_0, hV_0, hx_V0, hV0_le⟩ :=
    AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hx_0
  have hV0_ne : Nonempty V_0 := ⟨⟨x_0, hx_V0⟩⟩
  let A_V0 : Type u := ↑(X_tilde.presheaf.obj (Opposite.op V_0))
  obtain ⟨hDomV0, _, hDimV0⟩ := hNorm V_0 hV_0 hV0_ne
  have : IsDomain A_V0 := hDomV0
  have : Ring.DimensionLEOne A_V0 := hDimV0
  let ι_V0 : A_V0 →+* F_ss := (X_tilde.germToFunctionField V_0).hom
  have hFracV0 : @IsFractionRing A_V0 _ F_ss _ ι_V0.toAlgebra :=
    AlgebraicGeometry.functionField_isFractionRing_of_isAffineOpen X_tilde V_0 hV_0
  let c_V0 : k₀ →+* A_V0 :=
    (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
      p_tilde.appLE ⊤ V_0 le_top).hom)
  let t_V0 : A_V0 := (X_tilde.presheaf.map (CategoryTheory.homOfLE hV0_le).op).hom f
  have hCompat_C0 : ∀ c : k₀, α_0 (Polynomial.C c) = ι_V0 (c_V0 c) := by
    intro c
    change (X_tilde.germToFunctionField Ω).hom (Polynomial.eval₂ c_Ω f (Polynomial.C c)) = _
    rw [Polynomial.eval₂_C,
      ← TopCat.Presheaf.germ_res_apply X_tilde.presheaf
        (CategoryTheory.homOfLE hV0_le) _ _ (c_Ω c)]
    exact congrArg ι_V0 (h_cV_res V_0 hV0_le c)
  have hCompat_X0 : α_0 Polynomial.X = ι_V0 t_V0 := by
    change (X_tilde.germToFunctionField Ω).hom (Polynomial.eval₂ c_Ω f Polynomial.X) = _
    rw [Polynomial.eval₂_X]
    exact (TopCat.Presheaf.germ_res_apply X_tilde.presheaf
      (CategoryTheory.homOfLE hV0_le) _ _ f).symm

  let : Algebra (Polynomial k₀) F_ss := α_0.toAlgebra
  obtain ⟨hFin_B0, hIC_B0, hFrac_B0⟩ :=
    h_s1 A_V0 F_ss c_V0 (h_cV_ft V_0 hV_0) t_V0 ι_V0 hFracV0 α_0 hInjα hCompat_C0 hCompat_X0

  
  let B : Type u := ↥(integralClosure (Polynomial k₀) F_ss)
  have : IsIntegrallyClosed B := hIC_B0
  have : Module.Finite (Polynomial k₀) B := hFin_B0
  have : Algebra.IsIntegral (Polynomial k₀) B := Algebra.IsIntegral.of_finite (Polynomial k₀) B
  let φ_AB : Polynomial k₀ →+* B := algebraMap (Polynomial k₀) B
  let ι_B : B →+* F_ss := (integralClosure (Polynomial k₀) F_ss).val.toRingHom
  have hInjB : Function.Injective ι_B := Subtype.val_injective
  have hCompatB : ι_B.comp φ_AB = (X_tilde.germToFunctionField Ω).hom.comp Φ := rfl
  have hInj_φAB : Function.Injective φ_AB := fun p₁ p₂ hp =>
    hInjα (by change ι_B (φ_AB p₁) = ι_B (φ_AB p₂); rw [hp])

  have hCovEx : ∀ z : Ω, ∃ V_z : X_tilde.Opens,
      AlgebraicGeometry.IsAffineOpen V_z ∧ z.1 ∈ V_z ∧ V_z ≤ Ω :=
    fun z => AlgebraicGeometry.exists_isAffineOpen_mem_and_subset z.2
  choose V_cov hV_cov hz_Vcov hVcov_le using hCovEx
  have hSupV : (⨆ z : Ω, V_cov z) = Ω :=
    le_antisymm (iSup_le hVcov_le)
      (fun x hx => TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨x, hx⟩, hz_Vcov ⟨x, hx⟩⟩)
  have hVcov_ne : ∀ z : Ω, Nonempty (V_cov z) := fun z => ⟨⟨z.1, hz_Vcov z⟩⟩

  have hs_loc_ex : ∀ (b : B) (z : Ω),
      letI : Nonempty (V_cov z) := hVcov_ne z
      ∃ s : ↑(X_tilde.presheaf.obj (Opposite.op (V_cov z))),
        (X_tilde.germToFunctionField (V_cov z)).hom s = ι_B b := by
    intro b z
    have : Nonempty (V_cov z) := hVcov_ne z
    let A_z := ↑(X_tilde.presheaf.obj (Opposite.op (V_cov z)))
    let res_z := (X_tilde.presheaf.map (CategoryTheory.homOfLE (hVcov_le z)).op).hom
    obtain ⟨hDom_z, hIC_z, _⟩ := hNorm (V_cov z) (hV_cov z) (hVcov_ne z)
