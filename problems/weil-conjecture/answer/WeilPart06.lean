    (hg₁_mem : ∀ q : PrimeSpectrum C₀, p₀ g₁ ∉ q.asIdeal → s₀ ∉ q.asIdeal)
    (hg₁_loc : @IsLocalization.Away A _ g₁ (Localization.Away (p₁ g₁)) _
      ((algebraMap C₁ (Localization.Away (p₁ g₁))).comp p₁).toAlgebra)
