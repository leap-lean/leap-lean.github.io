        have hm_le_q : m ≤ q_pt.asIdeal := hq_in_m
        have hp_le_m : p_bot ≤ m := hp_bot_below m hm_min.1.1 hm_le_q
        have hm_le_p : m ≤ p_bot := hm_min.2 ⟨hp_bot_prime, bot_le⟩ hp_le_m
