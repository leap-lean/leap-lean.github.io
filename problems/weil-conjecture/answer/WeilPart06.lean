  have hSubIso :
      ∀ (C_main C_other : Type u) [CommRing C_main] [CommRing C_other]
        (p_main : A →+* C_main) (p_other : A →+* C_other) (g_other : C_other)
        (f_main : C_main →+* C₀₁) (f_other : C_other →+* C₀₁)
        (_ : @IsLocalization.Away C_other _ g_other C₀₁ _ f_other.toAlgebra)
        (ι_main : AlgebraicGeometry.Spec (CommRingCat.of C_main) ⟶ M)
        (ι_other : AlgebraicGeometry.Spec (CommRingCat.of C_other) ⟶ M)
        (_ : AlgebraicGeometry.IsOpenImmersion ι_main)
        (_ : ∀ y : M, y ∈ Set.range ι_main.base ∨ y ∈ Set.range ι_other.base)
        (_ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_main) ≫ ι_main =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_other) ≫ ι_other)
        (_ : ι_main ≫ p_M = AlgebraicGeometry.Spec.map (CommRingCat.ofHom p_main))
        (_ : ι_other ≫ p_M = AlgebraicGeometry.Spec.map (CommRingCat.ofHom p_other))
        (d : A)
        (_ : ∀ q : PrimeSpectrum C_other, p_other d ∉ q.asIdeal → g_other ∉ q.asIdeal)
        (_ : @IsLocalization.Away A _ d (Localization.Away (p_main d)) _
              ((algebraMap C_main (Localization.Away (p_main d))).comp p_main).toAlgebra)
        (U_open : (AlgebraicGeometry.Spec (CommRingCat.of A)).Opens)
        (_ : PrimeSpectrum.basicOpen d ≤ U_open),
        CategoryTheory.IsIso
          ((p_M ∣_ U_open) ∣_
            (TopologicalSpace.Opens.map U_open.ι.base).obj (PrimeSpectrum.basicOpen d)) := by
    intro C_main C_other _ _ p_main p_other g_other f_main f_other hloc_other
      ι_main ι_other hOpen_main hCov_sym hGlue_sym hp_main hp_other
      d hd_mem hd_loc U_open hd_sub
    have _ : AlgebraicGeometry.IsOpenImmersion ι_main := hOpen_main
    let D_d : (AlgebraicGeometry.Spec (CommRingCat.of A)).Opens := PrimeSpectrum.basicOpen d
    let f_res := p_M ∣_ U_open
    let W_d : U_open.toScheme.Opens := (TopologicalSpace.Opens.map U_open.ι.base).obj D_d
    let V_M : M.Opens := (TopologicalSpace.Opens.map p_M.base).obj U_open
    let V'_d : V_M.toScheme.Opens := (TopologicalSpace.Opens.map f_res.base).obj W_d
    let L_A := Localization.Away d
    let L_C := Localization.Away (p_main d)
    let β_A : AlgebraicGeometry.Spec (CommRingCat.of L_A) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of A) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A L_A))
    have _ : AlgebraicGeometry.IsOpenImmersion β_A :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization d
    let γ_tgt : W_d.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of A) :=
      W_d.ι ≫ U_open.ι
    have _ : AlgebraicGeometry.IsOpenImmersion γ_tgt := inferInstance
    have hRange_tgt : Set.range ⇑β_A = Set.range ⇑γ_tgt := by
      have hβ : Set.range ⇑β_A = (D_d : Set _) :=
        PrimeSpectrum.localization_away_comap_range L_A d
      rw [hβ]
      ext q
      constructor
      · intro hq
        exact ⟨⟨⟨q, hd_sub hq⟩, hq⟩, rfl⟩
      · rintro ⟨⟨⟨q', hq'U⟩, hq'D⟩, rfl⟩
        exact hq'D
    let e_tgt : AlgebraicGeometry.Spec (CommRingCat.of L_A) ≅ W_d.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq β_A γ_tgt hRange_tgt
    have he_tgt : e_tgt.hom ≫ γ_tgt = β_A :=
      AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac β_A γ_tgt hRange_tgt

    let j_loc : AlgebraicGeometry.Spec (CommRingCat.of L_C) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of C_main) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap C_main L_C))
    have _ : AlgebraicGeometry.IsOpenImmersion j_loc :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization (p_main d)
    let α_main : AlgebraicGeometry.Spec (CommRingCat.of L_C) ⟶ M := j_loc ≫ ι_main
    have _ : AlgebraicGeometry.IsOpenImmersion α_main := inferInstance
    let γ_src : V'_d.toScheme ⟶ M := V'_d.ι ≫ V_M.ι
    have _ : AlgebraicGeometry.IsOpenImmersion γ_src := inferInstance
    have hRange_γsrc : ∀ y : M, y ∈ Set.range ⇑γ_src ↔ p_M.base y ∈ D_d := by
      intro y
      have hf_ι : f_res ≫ U_open.ι = V_M.ι ≫ p_M :=
        AlgebraicGeometry.morphismRestrict_ι p_M U_open
      constructor
      · rintro ⟨⟨⟨y', hy'U⟩, hy'W⟩, rfl⟩
        have h1 : (f_res ≫ U_open.ι).base ⟨y', hy'U⟩ ∈ D_d := hy'W
        rw [hf_ι] at h1
        exact h1
      · intro hyD
        have hyU : p_M.base y ∈ U_open := hd_sub hyD
        have hyW : f_res.base ⟨y, hyU⟩ ∈ W_d := by
          change (f_res ≫ U_open.ι).base ⟨y, hyU⟩ ∈ D_d
          rw [hf_ι]
          exact hyD
        exact ⟨⟨⟨y, hyU⟩, hyW⟩, rfl⟩
    have hRange_src : Set.range ⇑α_main = Set.range ⇑γ_src := by
      ext y
      rw [hRange_γsrc]
      constructor
      · rintro ⟨z, rfl⟩
        have hz : p_main d ∉ (j_loc.base z).asIdeal := by
          have hmem_ps : (j_loc.base z : PrimeSpectrum C_main) ∈
              Set.range (PrimeSpectrum.comap (algebraMap C_main L_C)) := ⟨z, rfl⟩
          rw [PrimeSpectrum.localization_away_comap_range L_C (p_main d)] at hmem_ps
          exact hmem_ps
        have hpy : p_M.base (α_main.base z) =
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom p_main)).base (j_loc.base z) := by
          change (j_loc ≫ ι_main ≫ p_M).base z = _
          rw [hp_main]
          rfl
        change d ∉ (p_M.base (α_main.base z)).asIdeal
        rw [hpy, AlgebraicGeometry.Spec.map_base]
        exact hz
      · intro hyD
        have hy_main : y ∈ Set.range ι_main.base := by
          rcases hCov_sym y with hm | ⟨x_o, rfl⟩
          · exact hm
          · have hpo : p_other d ∉ x_o.asIdeal := by
              have hd_not : d ∉ (p_M.base (ι_other.base x_o)).asIdeal := hyD
              have hpx : p_M.base (ι_other.base x_o) =
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom p_other)).base x_o := by
                change (ι_other ≫ p_M).base x_o = _
                rw [hp_other]
              rw [hpx, AlgebraicGeometry.Spec.map_base] at hd_not
              exact hd_not
            have hgo : g_other ∉ x_o.asIdeal := hd_mem x_o hpo
            have hxo_range :
                x_o ∈ Set.range (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_other)).base := by
              let _ : Algebra C_other C₀₁ := f_other.toAlgebra
              have _ : IsLocalization.Away g_other C₀₁ := hloc_other
              have hmem_ps : (x_o : PrimeSpectrum C_other) ∈
                  Set.range (PrimeSpectrum.comap (algebraMap C_other C₀₁)) := by
                rw [PrimeSpectrum.localization_away_comap_range C₀₁ g_other]
                exact hgo
              exact hmem_ps
            obtain ⟨w, rfl⟩ := hxo_range
            have hgw :
                ι_other.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_other)).base w) =
                  ι_main.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_main)).base w) := by
              change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_other) ≫ ι_other).base w =
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_main) ≫ ι_main).base w
              rw [hGlue_sym]
            rw [hgw]
            exact ⟨(AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_main)).base w, rfl⟩
        obtain ⟨x_m, rfl⟩ := hy_main
        have hpm : p_main d ∉ x_m.asIdeal := by
          have hd_not : d ∉ (p_M.base (ι_main.base x_m)).asIdeal := hyD
          have hpx : p_M.base (ι_main.base x_m) =
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom p_main)).base x_m := by
            change (ι_main ≫ p_M).base x_m = _
            rw [hp_main]
          rw [hpx, AlgebraicGeometry.Spec.map_base] at hd_not
          exact hd_not
        have hxm_range : x_m ∈ Set.range j_loc.base := by
          have hmem_ps : (x_m : PrimeSpectrum C_main) ∈
              Set.range (PrimeSpectrum.comap (algebraMap C_main L_C)) := by
            rw [PrimeSpectrum.localization_away_comap_range L_C (p_main d)]
            exact hpm
          exact hmem_ps
        obtain ⟨z, rfl⟩ := hxm_range
        exact ⟨z, rfl⟩
    let e_src : AlgebraicGeometry.Spec (CommRingCat.of L_C) ≅ V'_d.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq α_main γ_src hRange_src
    have he_src : e_src.hom ≫ γ_src = α_main :=
      AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac α_main γ_src hRange_src

    let _ : Algebra A L_C := ((algebraMap C_main L_C).comp p_main).toAlgebra
    have _ : IsLocalization.Away d L_C := hd_loc
    let φ_alg : L_A ≃ₐ[A] L_C := IsLocalization.algEquiv (Submonoid.powers d) L_A L_C
    let φ_iso : CommRingCat.of L_A ≅ CommRingCat.of L_C :=
      φ_alg.toRingEquiv.toCommRingCatIso
    have hIntertwine :
        e_src.hom ≫ (f_res ∣_ W_d) =
          AlgebraicGeometry.Spec.map φ_iso.hom ≫ e_tgt.hom := by
      apply (CategoryTheory.cancel_mono γ_tgt).mp
      have h_lhs :
          (e_src.hom ≫ (f_res ∣_ W_d)) ≫ γ_tgt =
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom ((algebraMap C_main L_C).comp p_main)) := by
        dsimp only [γ_tgt]
        rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc (f_res ∣_ W_d),
          AlgebraicGeometry.morphismRestrict_ι, CategoryTheory.Category.assoc V'_d.ι,
          AlgebraicGeometry.morphismRestrict_ι p_M U_open,
          ← CategoryTheory.Category.assoc V'_d.ι, ← CategoryTheory.Category.assoc e_src.hom]
        change (e_src.hom ≫ γ_src) ≫ p_M = _
        rw [he_src]
        dsimp only [α_main, j_loc]
        rw [CategoryTheory.Category.assoc, hp_main, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp]
      have h_rhs :
          (AlgebraicGeometry.Spec.map φ_iso.hom ≫ e_tgt.hom) ≫ γ_tgt =
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom ((algebraMap C_main L_C).comp p_main)) := by
        rw [CategoryTheory.Category.assoc, he_tgt]
        dsimp only [β_A]
        rw [← AlgebraicGeometry.Spec.map_comp]
        congr 1
        ext a
        exact φ_alg.commutes a
      rw [h_lhs, h_rhs]
    have h_eq_comp :
        f_res ∣_ W_d =
          e_src.inv ≫ AlgebraicGeometry.Spec.map φ_iso.hom ≫ e_tgt.hom :=
      (CategoryTheory.Iso.eq_inv_comp e_src).mpr hIntertwine
    rw [h_eq_comp]
    exact inferInstance

  
  refine ⟨M, p_M, ι₀, ι₁, ι_M, ψ₀, ψ₁,
    hOpen₀, hOpen₁, hCov, hGlue, hp₀, hp₁,
    hCl_M, hProp_M, hιM_p,
    hψ₀_c, hψ₀_t1, hψ₁_c, hψ₁_t0,
    hι₀_M, hι₁_M, hOv_range, ?_, ?_⟩
  · 
    intro d hd_mem hd_loc
    let D_d : (AlgebraicGeometry.Spec (CommRingCat.of A)).Opens := PrimeSpectrum.basicOpen d
    have hSub_self :
        CategoryTheory.IsIso
          ((p_M ∣_ D_d) ∣_ (TopologicalSpace.Opens.map D_d.ι.base).obj D_d) :=
      hSubIso C₀ C₁ p₀_hom p₁_hom g₁ f₀₁_hom f₁₀_hom hloc₁
        ι₀ ι₁ hOpen₀ hCov hGlue hp₀ hp₁ d hd_mem hd_loc D_d le_rfl
    let W_unit : PUnit.{1} → D_d.toScheme.Opens :=
      fun _ => (TopologicalSpace.Opens.map D_d.ι.base).obj D_d
    have hW_unit_top : iSup W_unit = ⊤ := by
      rw [eq_top_iff]
      intro u _
      rw [TopologicalSpace.Opens.mem_iSup]
      exact ⟨PUnit.unit, u.2⟩
    exact AlgebraicGeometry.IsZariskiLocalAtTarget.of_iSup_eq_top
      (P := CategoryTheory.MorphismProperty.isomorphisms AlgebraicGeometry.Scheme)
      W_unit hW_unit_top (fun _ => hSub_self)
  · 
    intro I_center d₀ d₁ d₂ hI hd₀_mem hd₀_loc hd₁_mem hd₁_loc hd₂_mem hd₂_loc
    let U_compl : (AlgebraicGeometry.Spec (CommRingCat.of A)).Opens :=
      ⟨(PrimeSpectrum.zeroLocus (I_center : Set A))ᶜ,
        (PrimeSpectrum.isClosed_zeroLocus (I_center : Set A)).isOpen_compl⟩
    let d_vec : Fin 3 → A := ![d₀, d₁, d₂]
    have hd_mem_I : ∀ k : Fin 3, d_vec k ∈ I_center := by
      intro k
      rw [hI]
      fin_cases k
      · exact Ideal.mem_sup_left (Ideal.subset_span (Or.inl rfl))
      · exact Ideal.mem_sup_left (Ideal.subset_span (Or.inr (Set.mem_singleton d₁)))
      · exact Ideal.mem_sup_right (Ideal.mem_span_singleton_self d₂)
    have hd_sub : ∀ k : Fin 3, PrimeSpectrum.basicOpen (d_vec k) ≤ U_compl := by
      intro k q hq hz
      exact hq (hz (hd_mem_I k))
    let W_cov : Fin 3 → U_compl.toScheme.Opens :=
      fun k => (TopologicalSpace.Opens.map U_compl.ι.base).obj
        (PrimeSpectrum.basicOpen (d_vec k))
    have hW_top : iSup W_cov = ⊤ := by
      rw [eq_top_iff]
      intro u _
      by_contra h_none
      have hall : ∀ k : Fin 3, d_vec k ∈ u.1.asIdeal := by
        intro k
        have hnk : u ∉ W_cov k := fun hu =>
          h_none (TopologicalSpace.Opens.mem_iSup.mpr ⟨k, hu⟩)
        change ¬ (d_vec k ∉ u.1.asIdeal) at hnk
        exact Classical.not_not.mp hnk
      have hle_u : I_center ≤ u.1.asIdeal := by
        rw [hI]
        refine sup_le ?_ ?_
        · rw [Ideal.span_le]
          intro x hx
          rcases hx with rfl | hx1
          · exact hall 0
          · rcases Set.mem_singleton_iff.mp hx1 with rfl
            exact hall 1
        · rw [Ideal.span_singleton_le_iff_mem]
          exact hall 2
      exact u.2 hle_u
    refine AlgebraicGeometry.IsZariskiLocalAtTarget.of_iSup_eq_top
      (P := CategoryTheory.MorphismProperty.isomorphisms AlgebraicGeometry.Scheme)
      W_cov hW_top ?_
    intro k
    fin_cases k
    · exact hSubIso C₀ C₁ p₀_hom p₁_hom g₁ f₀₁_hom f₁₀_hom hloc₁
        ι₀ ι₁ hOpen₀ hCov hGlue hp₀ hp₁ d₀ hd₀_mem hd₀_loc U_compl (hd_sub 0)
    · exact hSubIso C₁ C₀ p₁_hom p₀_hom g₀ f₁₀_hom f₀₁_hom hloc₀
        ι₁ ι₀ hOpen₁ (fun y => (hCov y).symm) hGlue.symm hp₁ hp₀
        d₁ hd₁_mem hd₁_loc U_compl (hd_sub 1)
    · exact hSubIso C₁ C₀ p₁_hom p₀_hom g₀ f₁₀_hom f₀₁_hom hloc₀
        ι₁ ι₀ hOpen₁ (fun y => (hCov y).symm) hGlue.symm hp₁ hp₀
        d₂ hd₂_mem hd₂_loc U_compl (hd_sub 2)

theorem weil_twoChart_projLine_special_fiber_pullback_and_axes (A C₀ C₁ : Type u) [CommRing A] [CommRing C₀] [CommRing C₁]
    (p₀_hom : A →+* C₀) (p₁_hom : A →+* C₁)
    (g₀ : C₀) (g₁ : C₁)
    (hAff_A : ∀ a : Fin (1 + 1), AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen A 1 a))
    (c_A : ∀ a : Fin (1 + 1),
      A →+* ↑((weilProjectiveSpaceOver A 1).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen A 1 a))))
    (t_A : ∀ a : Fin (1 + 1), Fin (1 + 1) →
      ↑((weilProjectiveSpaceOver A 1).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen A 1 a))))
    (hSys_A : IsCommRingProjCoordSystem A 1 hAff_A c_A t_A)
    (M : AlgebraicGeometry.Scheme.{u})
    (p_M : M ⟶ AlgebraicGeometry.Spec (CommRingCat.of A))
    (ι₀ : AlgebraicGeometry.Spec (CommRingCat.of C₀) ⟶ M)
    (ι₁ : AlgebraicGeometry.Spec (CommRingCat.of C₁) ⟶ M)
    (U_ov : M.Opens)
    (ι_M : M ⟶ (weilProjectiveSpaceOver A 1).left)
    (ψ₀ : ↑((weilProjectiveSpaceOver A 1).left.presheaf.obj
      (Opposite.op (weilProjBasicOpen A 1 0))) →+* C₀)
    (ψ₁ : ↑((weilProjectiveSpaceOver A 1).left.presheaf.obj
      (Opposite.op (weilProjBasicOpen A 1 1))) →+* C₁)
    (hCl_M : AlgebraicGeometry.IsClosedImmersion ι_M)
    (hιM_p : ι_M ≫ (weilProjectiveSpaceOver A 1).hom = p_M)
    (hψ₀_c : ψ₀.comp (c_A 0) = p₀_hom)
    (hψ₀_t : ψ₀ (t_A 0 1) = g₀)
    (hψ₁_c : ψ₁.comp (c_A 1) = p₁_hom)
    (hψ₁_t : ψ₁ (t_A 1 0) = g₁)
    (hι₀_M : ι₀ ≫ ι_M = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀) ≫ (hAff_A 0).fromSpec)
    (hι₁_M : ι₁ ≫ ι_M = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁) ≫ (hAff_A 1).fromSpec)
    (hU_ov : (TopologicalSpace.Opens.map ι_M.base).obj
      (weilProjBasicOpen A 1 0 ⊓ weilProjBasicOpen A 1 1) = U_ov)
    (κ : Type u) [Field κ]
    (hAff_κ : ∀ a : Fin (1 + 1), AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen κ 1 a))
    (c_κ : ∀ a : Fin (1 + 1),
      κ →+* ↑((weilProjectiveSpaceOver κ 1).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen κ 1 a))))
    (t_κ : ∀ a : Fin (1 + 1), Fin (1 + 1) →
      ↑((weilProjectiveSpaceOver κ 1).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen κ 1 a))))
    (hSys_κ : IsCommRingProjCoordSystem κ 1 hAff_κ c_κ t_κ)
    (ε_A : A →+* κ)
    (Φ : (weilProjectiveSpaceOver κ 1).left ⟶ (weilProjectiveSpaceOver A 1).left)
    (hBC : IsCommRingProjBaseChange A κ ε_A 1 c_A t_A c_κ t_κ Φ)
    (ν₀ : C₀ →+* Polynomial κ) (ν₁ : C₁ →+* Polynomial κ)
    (hν₀_p : ν₀.comp p₀_hom = Polynomial.C.comp ε_A)
    (hν₀_g : ν₀ g₀ = Polynomial.X)
    (hν₁_p : ν₁.comp p₁_hom = Polynomial.C.comp ε_A)
    (hν₁_g : ν₁ g₁ = Polynomial.X) :
    ∃ (γ_M : (weilProjectiveSpaceOver κ 1).left ⟶ M)
      (s_e1 s_e2 : AlgebraicGeometry.Spec (CommRingCat.of κ) ⟶ (weilProjectiveSpaceOver κ 1).left),
      CategoryTheory.IsPullback γ_M (weilProjectiveSpaceOver κ 1).hom
        p_M (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ε_A)) ∧
      Nonempty ↥((TopologicalSpace.Opens.map γ_M.base).obj U_ov) ∧
      s_e1 ≫ (weilProjectiveSpaceOver κ 1).hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of κ)) ∧
      s_e2 ≫ (weilProjectiveSpaceOver κ 1).hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of κ)) ∧
      s_e1 ≫ γ_M =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((Polynomial.evalRingHom 0).comp ν₀)) ≫ ι₀ ∧
      s_e2 ≫ γ_M =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((Polynomial.evalRingHom 0).comp ν₁)) ≫ ι₁ ∧
      Disjoint (Set.range s_e1.base) (Set.range s_e2.base) ∧
      (∀ e : ↥(weilProjectiveSpaceOver κ 1).left,
        γ_M.base e ∉ U_ov ↔ e ∈ Set.range s_e1.base ∪ Set.range s_e2.base) :=
by
  have : AlgebraicGeometry.IsClosedImmersion ι_M := hCl_M
  obtain ⟨_, _, _, _, ht_A_diag, hGen_A, _, _, _, _⟩ := hSys_A
  obtain ⟨_, hCov_κ, hc_κ_spec, _, ht_κ_diag, hGen_κ, hEval_κ, hInter_κ, _, _⟩ := hSys_κ
  obtain ⟨hBC_comm, hBC_pb, hBC_charts⟩ := hBC
  obtain ⟨heq₀, hBC_c₀, hBC_t₀⟩ := hBC_charts 0
  obtain ⟨heq₁, hBC_c₁, hBC_t₁⟩ := hBC_charts 1

  
  let θ₀ := Φ.appLE (weilProjBasicOpen A 1 0) (weilProjBasicOpen κ 1 0) heq₀.symm.le
  let θ₁ := Φ.appLE (weilProjBasicOpen A 1 1) (weilProjBasicOpen κ 1 1) heq₁.symm.le
  have hθ₀_eq :
      Φ.app (weilProjBasicOpen A 1 0) ≫
        (weilProjectiveSpaceOver κ 1).left.presheaf.map (CategoryTheory.eqToHom heq₀.symm).op =
      θ₀ := by
    rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE Φ]
    exact AlgebraicGeometry.Scheme.Hom.appLE_map' Φ heq₀.symm.le heq₀.symm
  have hθ₁_eq :
      Φ.app (weilProjBasicOpen A 1 1) ≫
        (weilProjectiveSpaceOver κ 1).left.presheaf.map (CategoryTheory.eqToHom heq₁.symm).op =
      θ₁ := by
    rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE Φ]
    exact AlgebraicGeometry.Scheme.Hom.appLE_map' Φ heq₁.symm.le heq₁.symm

  let α₀ : C₀ →+* ↑((weilProjectiveSpaceOver κ 1).left.presheaf.obj
      (Opposite.op (weilProjBasicOpen κ 1 0))) :=
    (Polynomial.eval₂RingHom (c_κ 0) (t_κ 0 1)).comp ν₀
  let α₁ : C₁ →+* ↑((weilProjectiveSpaceOver κ 1).left.presheaf.obj
      (Opposite.op (weilProjBasicOpen κ 1 1))) :=
    (Polynomial.eval₂RingHom (c_κ 1) (t_κ 1 0)).comp ν₁

  have hα₀_p : ∀ r : A, α₀ (p₀_hom r) = c_κ 0 (ε_A r) := by
    intro r
    change (Polynomial.eval₂RingHom (c_κ 0) (t_κ 0 1)) ((ν₀.comp p₀_hom) r) = c_κ 0 (ε_A r)
    rw [hν₀_p]
    change Polynomial.eval₂ (c_κ 0) (t_κ 0 1) (Polynomial.C (ε_A r)) = c_κ 0 (ε_A r)
    exact Polynomial.eval₂_C (c_κ 0) (t_κ 0 1)
  have hα₀_g : α₀ g₀ = t_κ 0 1 := by
    change (Polynomial.eval₂RingHom (c_κ 0) (t_κ 0 1)) (ν₀ g₀) = t_κ 0 1
    rw [hν₀_g]
    exact Polynomial.eval₂_X (c_κ 0) (t_κ 0 1)

  have hα₁_p : ∀ r : A, α₁ (p₁_hom r) = c_κ 1 (ε_A r) := by
    intro r
    change (Polynomial.eval₂RingHom (c_κ 1) (t_κ 1 0)) ((ν₁.comp p₁_hom) r) = c_κ 1 (ε_A r)
    rw [hν₁_p]
    change Polynomial.eval₂ (c_κ 1) (t_κ 1 0) (Polynomial.C (ε_A r)) = c_κ 1 (ε_A r)
    exact Polynomial.eval₂_C (c_κ 1) (t_κ 1 0)
  have hα₁_g : α₁ g₁ = t_κ 1 0 := by
    change (Polynomial.eval₂RingHom (c_κ 1) (t_κ 1 0)) (ν₁ g₁) = t_κ 1 0
    rw [hν₁_g]
    exact Polynomial.eval₂_X (c_κ 1) (t_κ 1 0)

  have hαψ₀_hom : α₀.comp ψ₀ = θ₀.hom := by
    have htop : (⊤ : Subring ↑((weilProjectiveSpaceOver A 1).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen A 1 0)))) ≤ RingHom.eqLocus (α₀.comp ψ₀) θ₀.hom := by
      rw [← hGen_A 0, Subring.closure_le]
      rintro x (⟨r, rfl⟩ | ⟨b, rfl⟩)
      · change α₀ ((ψ₀.comp (c_A 0)) r) = θ₀.hom (c_A 0 r)
        rw [hψ₀_c, hα₀_p r, ← hθ₀_eq]
        exact (hBC_c₀ r).symm
      · fin_cases b
        · change α₀ (ψ₀ (t_A 0 0)) = θ₀.hom (t_A 0 0)
          rw [ht_A_diag 0, map_one, map_one, map_one]
        · change α₀ (ψ₀ (t_A 0 1)) = θ₀.hom (t_A 0 1)
          rw [hψ₀_t, hα₀_g, ← hθ₀_eq]
          exact (hBC_t₀ 1).symm
    ext x
    exact htop trivial
  have hαψ₀ : CommRingCat.ofHom (α₀.comp ψ₀) = θ₀ := by
    ext x
    exact RingHom.congr_fun hαψ₀_hom x

  have hαψ₁_hom : α₁.comp ψ₁ = θ₁.hom := by
    have htop : (⊤ : Subring ↑((weilProjectiveSpaceOver A 1).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen A 1 1)))) ≤ RingHom.eqLocus (α₁.comp ψ₁) θ₁.hom := by
      rw [← hGen_A 1, Subring.closure_le]
      rintro x (⟨r, rfl⟩ | ⟨b, rfl⟩)
      · change α₁ ((ψ₁.comp (c_A 1)) r) = θ₁.hom (c_A 1 r)
        rw [hψ₁_c, hα₁_p r, ← hθ₁_eq]
        exact (hBC_c₁ r).symm
      · fin_cases b
        · change α₁ (ψ₁ (t_A 1 0)) = θ₁.hom (t_A 1 0)
          rw [hψ₁_t, hα₁_g, ← hθ₁_eq]
          exact (hBC_t₁ 0).symm
        · change α₁ (ψ₁ (t_A 1 1)) = θ₁.hom (t_A 1 1)
          rw [ht_A_diag 1, map_one, map_one, map_one]
    ext x
    exact htop trivial
  have hαψ₁ : CommRingCat.ofHom (α₁.comp ψ₁) = θ₁ := by
    ext x
    exact RingHom.congr_fun hαψ₁_hom x

  
  let α₀_spec := AlgebraicGeometry.Spec.map (CommRingCat.ofHom α₀)
  let α₁_spec := AlgebraicGeometry.Spec.map (CommRingCat.ofHom α₁)
  let 𝒰 := (weilProjectiveSpaceOver κ 1).left.openCoverOfIsOpenCover
    (weilProjBasicOpen κ 1) (TopologicalSpace.IsOpenCover.mk hCov_κ)
  let g₀_mor : (weilProjBasicOpen κ 1 0).toScheme ⟶ M :=
    (hAff_κ 0).isoSpec.hom ≫ α₀_spec ≫ ι₀
  let g₁_mor : (weilProjBasicOpen κ 1 1).toScheme ⟶ M :=
    (hAff_κ 1).isoSpec.hom ≫ α₁_spec ≫ ι₁
  let g : ∀ a : 𝒰.I₀, 𝒰.X a ⟶ M :=
    @Fin.cases 1 (fun a : Fin (1 + 1) => (weilProjBasicOpen κ 1 a).toScheme ⟶ M) g₀_mor
      (@Fin.cases 0 (fun j : Fin 1 => (weilProjBasicOpen κ 1 j.succ).toScheme ⟶ M) g₁_mor
        (fun i => Fin.elim0 i))

  have hg_ιM : ∀ a : 𝒰.I₀, g a ≫ ι_M = 𝒰.f a ≫ Φ := by
    change ∀ a : Fin (1 + 1), g a ≫ ι_M = (weilProjBasicOpen κ 1 a).ι ≫ Φ
    intro a
    fin_cases a
    · change ((hAff_κ 0).isoSpec.hom ≫ α₀_spec ≫ ι₀) ≫ ι_M = (weilProjBasicOpen κ 1 0).ι ≫ Φ
      calc
        ((hAff_κ 0).isoSpec.hom ≫ α₀_spec ≫ ι₀) ≫ ι_M
          = (hAff_κ 0).isoSpec.hom ≫ α₀_spec ≫ (ι₀ ≫ ι_M) := by
              simp only [CategoryTheory.Category.assoc]
        _ = (hAff_κ 0).isoSpec.hom ≫
              (α₀_spec ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀)) ≫
              (hAff_A 0).fromSpec := by
              rw [hι₀_M, CategoryTheory.Category.assoc]
        _ = (hAff_κ 0).isoSpec.hom ≫ AlgebraicGeometry.Spec.map θ₀ ≫ (hAff_A 0).fromSpec := by
              dsimp only [α₀_spec]
              rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hαψ₀]
        _ = (hAff_κ 0).isoSpec.hom ≫ (hAff_κ 0).fromSpec ≫ Φ := by
              rw [AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec Φ
                (hAff_A 0) (hAff_κ 0) heq₀.symm.le]
        _ = (hAff_κ 0).isoSpec.hom ≫ ((hAff_κ 0).isoSpec.inv ≫ (weilProjBasicOpen κ 1 0).ι) ≫ Φ := by
              rw [← (hAff_κ 0).isoSpec_inv_ι]
        _ = (weilProjBasicOpen κ 1 0).ι ≫ Φ := by
              simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id_assoc]
    · change ((hAff_κ 1).isoSpec.hom ≫ α₁_spec ≫ ι₁) ≫ ι_M = (weilProjBasicOpen κ 1 1).ι ≫ Φ
      calc
        ((hAff_κ 1).isoSpec.hom ≫ α₁_spec ≫ ι₁) ≫ ι_M
          = (hAff_κ 1).isoSpec.hom ≫ α₁_spec ≫ (ι₁ ≫ ι_M) := by
              simp only [CategoryTheory.Category.assoc]
        _ = (hAff_κ 1).isoSpec.hom ≫
              (α₁_spec ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁)) ≫
              (hAff_A 1).fromSpec := by
              rw [hι₁_M, CategoryTheory.Category.assoc]
        _ = (hAff_κ 1).isoSpec.hom ≫ AlgebraicGeometry.Spec.map θ₁ ≫ (hAff_A 1).fromSpec := by
              dsimp only [α₁_spec]
              rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hαψ₁]
        _ = (hAff_κ 1).isoSpec.hom ≫ (hAff_κ 1).fromSpec ≫ Φ := by
              rw [AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec Φ
                (hAff_A 1) (hAff_κ 1) heq₁.symm.le]
        _ = (hAff_κ 1).isoSpec.hom ≫ ((hAff_κ 1).isoSpec.inv ≫ (weilProjBasicOpen κ 1 1).ι) ≫ Φ := by
              rw [← (hAff_κ 1).isoSpec_inv_ι]
        _ = (weilProjBasicOpen κ 1 1).ι ≫ Φ := by
              simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id_assoc]

  have hglue : ∀ x y : 𝒰.I₀,
      CategoryTheory.Limits.pullback.fst (𝒰.f x) (𝒰.f y) ≫ g x =
        CategoryTheory.Limits.pullback.snd (𝒰.f x) (𝒰.f y) ≫ g y := by
    intro x y
    apply (CategoryTheory.cancel_mono ι_M).mp
    rw [CategoryTheory.Category.assoc, hg_ιM x, ← CategoryTheory.Category.assoc,
      CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc, ← hg_ιM y,
      CategoryTheory.Category.assoc]

  let γ_M : (weilProjectiveSpaceOver κ 1).left ⟶ M := 𝒰.glueMorphisms g hglue

  have hγ_ιM : γ_M ≫ ι_M = Φ := by
    apply 𝒰.hom_ext
    intro a
    rw [← CategoryTheory.Category.assoc, 𝒰.ι_glueMorphisms g hglue a, hg_ιM a]

  have hfrom0_γ : (hAff_κ 0).fromSpec ≫ γ_M = α₀_spec ≫ ι₀ := by
    have h_glue0 : (weilProjBasicOpen κ 1 0).ι ≫ γ_M = g₀_mor := 𝒰.ι_glueMorphisms g hglue (0 : Fin (1 + 1))
    rw [← (hAff_κ 0).isoSpec_inv_ι, CategoryTheory.Category.assoc, h_glue0]
    dsimp only [g₀_mor]
    exact CategoryTheory.Iso.inv_hom_id_assoc (hAff_κ 0).isoSpec (α₀_spec ≫ ι₀)

  have hfrom1_γ : (hAff_κ 1).fromSpec ≫ γ_M = α₁_spec ≫ ι₁ := by
    have h_glue1 : (weilProjBasicOpen κ 1 1).ι ≫ γ_M = g₁_mor := 𝒰.ι_glueMorphisms g hglue (1 : Fin (1 + 1))
    rw [← (hAff_κ 1).isoSpec_inv_ι, CategoryTheory.Category.assoc, h_glue1]
    dsimp only [g₁_mor]
    exact CategoryTheory.Iso.inv_hom_id_assoc (hAff_κ 1).isoSpec (α₁_spec ≫ ι₁)

  
  let s_ε := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ε_A)
  have hcomm_γ : γ_M ≫ p_M = (weilProjectiveSpaceOver κ 1).hom ≫ s_ε := by
    rw [← hιM_p, ← CategoryTheory.Category.assoc, hγ_ιM, hBC_comm]

  have hPb_γ : CategoryTheory.IsPullback γ_M (weilProjectiveSpaceOver κ 1).hom p_M s_ε := by
    refine CategoryTheory.IsPullback.of_isLimit
      (CategoryTheory.Limits.PullbackCone.IsLimit.mk hcomm_γ
        (fun c => hBC_pb.lift (c.fst ≫ ι_M) c.snd
          (by rw [CategoryTheory.Category.assoc, hιM_p, c.condition]))
        ?_ ?_ ?_)
    · intro c
      apply (CategoryTheory.cancel_mono ι_M).mp
      rw [CategoryTheory.Category.assoc, hγ_ιM, hBC_pb.lift_fst]
    · intro c
      exact hBC_pb.lift_snd _ _ _
    · intro c m hm_fst hm_snd
      apply hBC_pb.hom_ext
      · rw [hBC_pb.lift_fst, ← hγ_ιM, ← CategoryTheory.Category.assoc, hm_fst]
      · rw [hm_snd, hBC_pb.lift_snd]

  
  have hPre_ov :
      (TopologicalSpace.Opens.map γ_M.base).obj U_ov =
        weilProjBasicOpen κ 1 0 ⊓ weilProjBasicOpen κ 1 1 := by
    have hΦ_inf :
        (TopologicalSpace.Opens.map Φ.base).obj
          (weilProjBasicOpen A 1 0 ⊓ weilProjBasicOpen A 1 1) =
        (TopologicalSpace.Opens.map Φ.base).obj (weilProjBasicOpen A 1 0) ⊓
          (TopologicalSpace.Opens.map Φ.base).obj (weilProjBasicOpen A 1 1) :=
      TopologicalSpace.Opens.ext rfl
    rw [← hU_ov, ← TopologicalSpace.Opens.map_comp_obj, ← AlgebraicGeometry.Scheme.Hom.comp_base,
      hγ_ιM, hΦ_inf, heq₀, heq₁]

  have hNonempty_ov : Nonempty ↥((TopologicalSpace.Opens.map γ_M.base).obj U_ov) := by
    rw [hPre_ov, ← hInter_κ 0 1]
    obtain ⟨ψ₁₁, _, hψ₁₁_t⟩ := hEval_κ 0 κ (RingHom.id κ) ![1, 1] rfl
    let pt₀ : PrimeSpectrum κ := ⟨⊥, Ideal.isPrime_bot⟩
    let ψ₁₁_spec := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁₁)
    let q₁₁ : PrimeSpectrum ↑((weilProjectiveSpaceOver κ 1).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen κ 1 0))) := ψ₁₁_spec.base pt₀
    have hq₁₁_basic : q₁₁ ∈ PrimeSpectrum.basicOpen (t_κ 0 1) := by
      rw [PrimeSpectrum.mem_basicOpen]
      intro hmem
      have hmem' : ψ₁₁ (t_κ 0 1) ∈ (⊥ : Ideal κ) := by
        change t_κ 0 1 ∈ (ψ₁₁_spec.base pt₀).asIdeal at hmem
        rw [AlgebraicGeometry.Spec.map_base] at hmem
        exact hmem
      rw [hψ₁₁_t 1, Ideal.mem_bot] at hmem'
      exact one_ne_zero hmem'
    rw [← (hAff_κ 0).fromSpec_preimage_basicOpen (t_κ 0 1)] at hq₁₁_basic
    exact ⟨⟨(hAff_κ 0).fromSpec.base q₁₁, hq₁₁_basic⟩⟩

  obtain ⟨ψ_e1, hψ1_c, hψ1_t⟩ := hEval_κ 0 κ (RingHom.id κ) ![1, 0] rfl
  obtain ⟨ψ_e2, hψ2_c, hψ2_t⟩ := hEval_κ 1 κ (RingHom.id κ) ![0, 1] rfl
  let ψ1_spec := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_e1)
  let ψ2_spec := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_e2)
  let s_e1 : AlgebraicGeometry.Spec (CommRingCat.of κ) ⟶ (weilProjectiveSpaceOver κ 1).left :=
    ψ1_spec ≫ (hAff_κ 0).fromSpec
  let s_e2 : AlgebraicGeometry.Spec (CommRingCat.of κ) ⟶ (weilProjectiveSpaceOver κ 1).left :=
    ψ2_spec ≫ (hAff_κ 1).fromSpec

  have hs1_sec :
      s_e1 ≫ (weilProjectiveSpaceOver κ 1).hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of κ)) := by
    dsimp only [s_e1, ψ1_spec]
    rw [CategoryTheory.Category.assoc, ← hc_κ_spec 0, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp, hψ1_c, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]

  have hs2_sec :
      s_e2 ≫ (weilProjectiveSpaceOver κ 1).hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of κ)) := by
    dsimp only [s_e2, ψ2_spec]
    rw [CategoryTheory.Category.assoc, ← hc_κ_spec 1, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp, hψ2_c, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]

  have hψ1_eval : ψ_e1.comp α₀ = (Polynomial.evalRingHom 0).comp ν₀ := by
    have hev1 : ψ_e1.comp (Polynomial.eval₂RingHom (c_κ 0) (t_κ 0 1)) = Polynomial.evalRingHom 0 := by
      apply Polynomial.ringHom_ext
      · intro x
        simp only [RingHom.comp_apply, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C,
          Polynomial.coe_evalRingHom, Polynomial.eval_C]
        exact RingHom.congr_fun hψ1_c x
      · simp only [RingHom.comp_apply, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X,
          Polynomial.coe_evalRingHom, Polynomial.eval_X]
        exact hψ1_t 1
    ext x
    change (ψ_e1.comp (Polynomial.eval₂RingHom (c_κ 0) (t_κ 0 1))) (ν₀ x) =
      (Polynomial.evalRingHom 0) (ν₀ x)
    rw [hev1]

  have hψ2_eval : ψ_e2.comp α₁ = (Polynomial.evalRingHom 0).comp ν₁ := by
    have hev2 : ψ_e2.comp (Polynomial.eval₂RingHom (c_κ 1) (t_κ 1 0)) = Polynomial.evalRingHom 0 := by
      apply Polynomial.ringHom_ext
      · intro x
        simp only [RingHom.comp_apply, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C,
          Polynomial.coe_evalRingHom, Polynomial.eval_C]
        exact RingHom.congr_fun hψ2_c x
      · simp only [RingHom.comp_apply, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X,
          Polynomial.coe_evalRingHom, Polynomial.eval_X]
        exact hψ2_t 0
    ext x
    change (ψ_e2.comp (Polynomial.eval₂RingHom (c_κ 1) (t_κ 1 0))) (ν₁ x) =
      (Polynomial.evalRingHom 0) (ν₁ x)
    rw [hev2]

  have hs1_γ :
      s_e1 ≫ γ_M =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((Polynomial.evalRingHom 0).comp ν₀)) ≫ ι₀ := by
    dsimp only [s_e1]
    rw [CategoryTheory.Category.assoc, hfrom0_γ, ← CategoryTheory.Category.assoc]
    dsimp only [ψ1_spec, α₀_spec]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hψ1_eval]

  have hs2_γ :
      s_e2 ≫ γ_M =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((Polynomial.evalRingHom 0).comp ν₁)) ≫ ι₁ := by
    dsimp only [s_e2]
    rw [CategoryTheory.Category.assoc, hfrom1_γ, ← CategoryTheory.Category.assoc]
    dsimp only [ψ2_spec, α₁_spec]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hψ2_eval]

  
  have hAxis : ∀ (a a' : Fin (1 + 1)), a ≠ a' →
      ∀ (ψ : ↑((weilProjectiveSpaceOver κ 1).left.presheaf.obj
          (Opposite.op (weilProjBasicOpen κ 1 a))) →+* κ),
        ψ.comp (c_κ a) = RingHom.id κ →
        ψ (t_κ a a') = 0 →
        let ψ_sp := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)
        let s := ψ_sp ≫ (hAff_κ a).fromSpec
        ∀ e : ↥(weilProjectiveSpaceOver κ 1).left,
          e ∉ weilProjBasicOpen κ 1 a' ↔ e ∈ Set.range s.base := by
    intro a a' hne ψ hψ_c hψ_t ψ_sp s e
    have hDich : ∀ b : Fin (1 + 1), b = a ∨ b = a' := by
      intro b
      fin_cases a <;> fin_cases a' <;> fin_cases b <;> simp_all
    have hSurj : Function.Surjective ψ := fun x => ⟨c_κ a x, RingHom.congr_fun hψ_c x⟩
    have hMax : (RingHom.ker ψ).IsMaximal := RingHom.ker_isMaximal_of_surjective ψ hSurj
    let J := Ideal.span {t_κ a a'}
    have hKer_le : RingHom.ker ψ ≤ J := by
      let μ₁ := Ideal.Quotient.mk J
      let μ₂ := μ₁.comp ((c_κ a).comp ψ)
      have htop : (⊤ : Subring ↑((weilProjectiveSpaceOver κ 1).left.presheaf.obj
          (Opposite.op (weilProjBasicOpen κ 1 a)))) ≤ RingHom.eqLocus μ₁ μ₂ := by
        rw [← hGen_κ a, Subring.closure_le]
        rintro x (⟨r, rfl⟩ | ⟨b, rfl⟩)
        · change μ₁ (c_κ a r) = μ₁ (c_κ a ((ψ.comp (c_κ a)) r))
          rw [hψ_c]
          rfl
        · rcases hDich b with hb | hb
          · rw [hb]
            change μ₁ (t_κ a a) = μ₂ (t_κ a a)
            rw [ht_κ_diag a, map_one, map_one]
          · rw [hb]
            change μ₁ (t_κ a a') = μ₁ (c_κ a (ψ (t_κ a a')))
            rw [Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self (t_κ a a')),
              hψ_t, map_zero, map_zero]
      intro f hf
      rw [RingHom.mem_ker] at hf
      have heq_f : μ₁ f = μ₂ f := htop trivial
      change μ₁ f = μ₁ (c_κ a (ψ f)) at heq_f
      rw [hf, map_zero, map_zero] at heq_f
      exact Ideal.Quotient.eq_zero_iff_mem.mp heq_f
    constructor
    · intro he_not
      have he_top : e ∈ (⊤ : (weilProjectiveSpaceOver κ 1).left.Opens) := trivial
      rw [← hCov_κ, TopologicalSpace.Opens.mem_iSup] at he_top
      obtain ⟨b, hb⟩ := he_top
      have he_a : e ∈ (weilProjBasicOpen κ 1 a : Set ↥(weilProjectiveSpaceOver κ 1).left) := by
        rcases hDich b with rfl | rfl
        · exact hb
        · exact False.elim (he_not hb)
      rw [← (hAff_κ a).range_fromSpec] at he_a
      obtain ⟨q, hq⟩ := he_a
      have ht_mem : t_κ a a' ∈ q.asIdeal := by
        by_contra ht_not
        have hq_basic : q ∈ PrimeSpectrum.basicOpen (t_κ a a') :=
          (PrimeSpectrum.mem_basicOpen _ _).mpr ht_not
        rw [← (hAff_κ a).fromSpec_preimage_basicOpen (t_κ a a')] at hq_basic
        have he_basic : e ∈ (weilProjectiveSpaceOver κ 1).left.basicOpen (t_κ a a') := by
          rw [← hq]
          exact hq_basic
        rw [hInter_κ a a'] at he_basic
        exact he_not he_basic.2
      have hJ_le : J ≤ q.asIdeal := (Ideal.span_singleton_le_iff_mem q.asIdeal).mpr ht_mem
      have hker_eq : RingHom.ker ψ = q.asIdeal :=
        hMax.eq_of_le q.isPrime.ne_top (hKer_le.trans hJ_le)
      let pt₀ : PrimeSpectrum κ := ⟨⊥, Ideal.isPrime_bot⟩
      have hsp_eq : ψ_sp.base pt₀ = q := by
        apply PrimeSpectrum.ext
        dsimp only [ψ_sp]
        rw [AlgebraicGeometry.Spec.map_base]
        change Ideal.comap ψ ⊥ = q.asIdeal
        exact hker_eq
      refine ⟨pt₀, ?_⟩
      dsimp only [s]
      rw [AlgebraicGeometry.Scheme.Hom.comp_base]
      change (hAff_κ a).fromSpec.base (ψ_sp.base pt₀) = e
      rw [hsp_eq]
      exact hq
    · rintro ⟨pt, rfl⟩ he_a'
      let q₀ : PrimeSpectrum ↑((weilProjectiveSpaceOver κ 1).left.presheaf.obj
          (Opposite.op (weilProjBasicOpen κ 1 a))) := ψ_sp.base pt
      have he_eq : s.base pt = (hAff_κ a).fromSpec.base q₀ := by
        dsimp only [s, q₀]
        rw [AlgebraicGeometry.Scheme.Hom.comp_base]
        rfl
      have he_a : s.base pt ∈ weilProjBasicOpen κ 1 a := by
        change s.base pt ∈ (weilProjBasicOpen κ 1 a : Set ↥(weilProjectiveSpaceOver κ 1).left)
        rw [← (hAff_κ a).range_fromSpec, he_eq]
        exact ⟨q₀, rfl⟩
      have he_inter : s.base pt ∈ (weilProjectiveSpaceOver κ 1).left.basicOpen (t_κ a a') := by
        rw [hInter_κ a a']
        exact ⟨he_a, he_a'⟩
      rw [he_eq] at he_inter
      have hq₀_basic : q₀ ∈ PrimeSpectrum.basicOpen (t_κ a a') := by
        rw [← (hAff_κ a).fromSpec_preimage_basicOpen (t_κ a a')]
        exact he_inter
      rw [PrimeSpectrum.mem_basicOpen] at hq₀_basic
      apply hq₀_basic
      dsimp only [q₀, ψ_sp]
      rw [AlgebraicGeometry.Spec.map_base]
      change ψ (t_κ a a') ∈ pt.asIdeal
      rw [hψ_t]
      exact pt.asIdeal.zero_mem

  have he₁ : ∀ e : ↥(weilProjectiveSpaceOver κ 1).left,
      e ∉ weilProjBasicOpen κ 1 1 ↔ e ∈ Set.range s_e1.base :=
    hAxis 0 1 (by decide) ψ_e1 hψ1_c (hψ1_t 1)
  have he₂ : ∀ e : ↥(weilProjectiveSpaceOver κ 1).left,
      e ∉ weilProjBasicOpen κ 1 0 ↔ e ∈ Set.range s_e2.base :=
    hAxis 1 0 (by decide) ψ_e2 hψ2_c (hψ2_t 0)

  have hDisj : Disjoint (Set.range s_e1.base) (Set.range s_e2.base) := by
    rw [Set.disjoint_left]
    intro e h1 h2
    have hn1 : e ∉ weilProjBasicOpen κ 1 1 := (he₁ e).mpr h1
    have hn0 : e ∉ weilProjBasicOpen κ 1 0 := (he₂ e).mpr h2
    have he_top : e ∈ (⊤ : (weilProjectiveSpaceOver κ 1).left.Opens) := trivial
    rw [← hCov_κ, TopologicalSpace.Opens.mem_iSup] at he_top
    obtain ⟨b, hb⟩ := he_top
    fin_cases b
    · exact hn0 hb
    · exact hn1 hb

  have hCompl : ∀ e : ↥(weilProjectiveSpaceOver κ 1).left,
      γ_M.base e ∉ U_ov ↔ e ∈ Set.range s_e1.base ∪ Set.range s_e2.base := by
    intro e
    have hmem_ov : γ_M.base e ∈ U_ov ↔ e ∈ weilProjBasicOpen κ 1 0 ∧ e ∈ weilProjBasicOpen κ 1 1 := by
      change e ∈ (TopologicalSpace.Opens.map γ_M.base).obj U_ov ↔ _
      rw [hPre_ov]
      rfl
    rw [hmem_ov, not_and_or, Or.comm, he₁ e, he₂ e]
    rfl

  exact ⟨γ_M, s_e1, s_e2, hPb_γ, hNonempty_ov, hs1_sec, hs2_sec, hs1_γ, hs2_γ, hDisj, hCompl⟩

theorem weil_overlap_nodal_linear_p1_blowup_model (K : Type u) [Field K]
    (V : ValuationSubring K)
    (P_z : Ideal ↥V) [P_z.IsPrime]
    (t_z a s₁ π₁ a' : ↥V)
    (ht_z : t_z ∉ P_z)
    (R_z : Type u) [CommRing R_z] [Algebra ↥V R_z]
    [IsLocalization.Away t_z R_z] [IsLocalization.AtPrime R_z P_z]
    (ha_ne : a ≠ 0)
    (ha_eq : a = π₁ * a')
    (hs₁ : s₁ ∉ P_z)
    (hπ₁_mem : π₁ ∈ P_z) :
    ∃ (A_loc : CommRingCat.{u})
      (φ_Rz : CommRingCat.of R_z ⟶ A_loc)
      (φ_glob_loc :
        CommRingCat.of
          (MvPolynomial (Fin 2) ↥V ⧸ Ideal.span
            {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}) ⟶
        A_loc)
      (u₀ u₁ : ↑A_loc),
      CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C) ≫ φ_glob_loc =
        CommRingCat.ofHom (algebraMap ↥V R_z) ≫ φ_Rz ∧
      φ_glob_loc.hom (Ideal.Quotient.mk _ (MvPolynomial.X 0)) = u₀ ∧
      φ_glob_loc.hom (Ideal.Quotient.mk _ (MvPolynomial.X 1)) = u₁ ∧
      (Ideal.span {algebraMap ↥V R_z a} : Ideal R_z) ≠ ⊤ ∧
      AlgebraicGeometry.IsOpenImmersion (AlgebraicGeometry.Spec.map φ_glob_loc) ∧
      Set.range (AlgebraicGeometry.Spec.map φ_glob_loc).base =
        {q : ↥(AlgebraicGeometry.Spec (CommRingCat.of
            (MvPolynomial (Fin 2) ↥V ⧸ Ideal.span
              {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}))) |
          Ideal.Quotient.mk _ (MvPolynomial.C t_z) ∉ q.asIdeal} ∧
      Function.Surjective
        ((Ideal.Quotient.mk (Ideal.span {u₀, u₁})).comp φ_Rz.hom) ∧
      RingHom.ker
        ((Ideal.Quotient.mk (Ideal.span {u₀, u₁})).comp φ_Rz.hom) =
        Ideal.span {algebraMap ↥V R_z a} ∧
      ∃ (M_nod : AlgebraicGeometry.Scheme.{u})
        (p_nod : M_nod ⟶ AlgebraicGeometry.Spec A_loc)
        (U_nod_sm : M_nod.Opens)
        (e_nod_sm : U_nod_sm.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial ↥V))),
        IsLocalOverlapBlowupModel V P_z π₁ φ_Rz (Ideal.span {u₀, u₁}) true p_nod ∧
        AlgebraicGeometry.Etale e_nod_sm ∧
        U_nod_sm.ι ≫ p_nod ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V R_z) ≫ φ_Rz) =
          e_nod_sm ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) ∧
        AlgebraicGeometry.SmoothOfRelativeDimension 1
          (U_nod_sm.ι ≫ p_nod ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V R_z) ≫ φ_Rz)) ∧
        (∀ (R : Type u) [CommRing R] [IsDomain R] [IsLocalRing R]
            (ψ_M : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ M_nod)
            (q : R),
          IsUnit q →
          (AlgebraicGeometry.Spec.preimage
            (ψ_M ≫ p_nod ≫
              AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (algebraMap ↥V R_z) ≫ φ_Rz))).hom π₁ ≠ 0 →
          (AlgebraicGeometry.Spec.preimage
            (ψ_M ≫ p_nod ≫ AlgebraicGeometry.Spec.map φ_glob_loc)).hom
              (Ideal.Quotient.mk _ (MvPolynomial.C s₁ * MvPolynomial.X 0)) =
            (AlgebraicGeometry.Spec.preimage
              (ψ_M ≫ p_nod ≫
                AlgebraicGeometry.Spec.map
                  (CommRingCat.ofHom (algebraMap ↥V R_z) ≫ φ_Rz))).hom π₁ * q →
          Set.range ψ_M.base ⊆ (U_nod_sm : Set M_nod)) :=
by
  have _ : t_z ∉ P_z := ht_z
  have hπ₁_ne : π₁ ≠ 0 := by
    intro h0
    apply ha_ne
    rw [ha_eq, h0, zero_mul]
  have ha'_ne : a' ≠ 0 := by
    intro h0
    apply ha_ne
    rw [ha_eq, h0, mul_zero]
  have hs₁_ne : s₁ ≠ 0 := by
    intro h0
    apply hs₁
    rw [h0]
    exact P_z.zero_mem
  let b₁ : ↥V := s₁ * a'
  have hb₁_ne : b₁ ≠ 0 := by
    intro h0
    have hK : V.subtype b₁ = 0 := by rw [h0, map_zero]
    rw [map_mul] at hK
    rcases mul_eq_zero.mp hK with hs | ha'
    · exact hs₁_ne (Subtype.ext hs)
    · exact ha'_ne (Subtype.ext ha')
  let s₁' : R_z := algebraMap ↥V R_z s₁
  let π₁' : R_z := algebraMap ↥V R_z π₁
  let a'_Rz : R_z := algebraMap ↥V R_z a'
  let b₁' : R_z := algebraMap ↥V R_z b₁
  let a_Rz : R_z := algebraMap ↥V R_z a
  have hb₁'_eq : b₁' = s₁' * a'_Rz := map_mul (algebraMap ↥V R_z) s₁ a'
  have ha_Rz_eq : a_Rz = π₁' * a'_Rz := by
    dsimp only [a_Rz, π₁', a'_Rz]
    rw [ha_eq, map_mul]
  have hs₁'_unit : IsUnit s₁' :=
    (IsLocalization.AtPrime.isUnit_to_map_iff R_z P_z s₁).mpr hs₁
  have : IsLocalRing R_z := IsLocalization.AtPrime.isLocalRing R_z P_z
  have ha_mem : a ∈ P_z := by
    rw [ha_eq]
    exact P_z.mul_mem_right a' hπ₁_mem
  have ha_max : a_Rz ∈ IsLocalRing.maximalIdeal R_z :=
    (IsLocalization.AtPrime.to_map_mem_maximal_iff R_z P_z a).mpr ha_mem
  have hIBaseNeTop : (Ideal.span {algebraMap ↥V R_z a} : Ideal R_z) ≠ ⊤ := by
    intro htop
    have hle : Ideal.span {algebraMap ↥V R_z a} ≤ IsLocalRing.maximalIdeal R_z := by
      rw [Ideal.span_singleton_le_iff_mem]
      exact ha_max
    rw [htop] at hle
    exact (IsLocalRing.maximalIdeal.isMaximal R_z).ne_top (top_unique hle)
  obtain ⟨Φ_a, hΦa_C, hΦa_X0, hΦa_X1, hOpen_Φa, hRange_Φa, hSurj_Φa, hKer_Φa⟩ :=
    weil_nodal_mvPolyQuotient_away_openImmersion_and_axesKer ↥V t_z a R_z
  obtain ⟨Φ_c0, hΦc0_C, _, _, hOpen_Φc0, _, _, _⟩ :=
    weil_nodal_mvPolyQuotient_away_openImmersion_and_axesKer ↥V t_z π₁ R_z
  obtain ⟨Φ_c1, hΦc1_C, _, _, hOpen_Φc1, _, _, _⟩ :=
    weil_nodal_mvPolyQuotient_away_openImmersion_and_axesKer ↥V t_z b₁ R_z
  let Q_Rz_a := MvPolynomial (Fin 2) R_z ⧸ Ideal.span
    {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a_Rz}
  let A_loc : CommRingCat.{u} := CommRingCat.of Q_Rz_a
  let φ_Rz : CommRingCat.of R_z ⟶ A_loc :=
    CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)
  have hφRz_hom : φ_Rz.hom = (Ideal.Quotient.mk _).comp MvPolynomial.C := rfl
  let φ_glob_loc :
      CommRingCat.of
        (MvPolynomial (Fin 2) ↥V ⧸ Ideal.span
          {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}) ⟶ A_loc :=
    CommRingCat.ofHom Φ_a
  let u₀ : ↑A_loc := Ideal.Quotient.mk _ (MvPolynomial.X 0)
  let u₁ : ↑A_loc := Ideal.Quotient.mk _ (MvPolynomial.X 1)
  have hj_comm :
      CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C) ≫ φ_glob_loc =
        CommRingCat.ofHom (algebraMap ↥V R_z) ≫ φ_Rz := by
    dsimp only [φ_glob_loc, φ_Rz]
    rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hΦa_C]
  have hΦa_sX0 :
      Φ_a (Ideal.Quotient.mk _ (MvPolynomial.C s₁ * MvPolynomial.X 0)) =
        Ideal.Quotient.mk _ (MvPolynomial.C s₁' * MvPolynomial.X 0) := by
    rw [map_mul, map_mul, hΦa_X0]
    change Φ_a (((Ideal.Quotient.mk _).comp MvPolynomial.C) s₁) * u₀ =
      ((Ideal.Quotient.mk _).comp MvPolynomial.C) s₁' * u₀
    rw [← RingHom.comp_apply Φ_a, hΦa_C]
    rfl
  obtain ⟨hAff_all, c_all, t_all, hSys_all, hBC_all⟩ :=
    weil_commRing_projectiveSpace_chart_and_baseChange_pkg
  obtain ⟨hSm_pkg, hLift_pkg⟩ :=
    weil_polynomial_away_smoothChart_and_localDomain_chartLift
  obtain ⟨hOpen_φsm, hφsm_C, hSm_φsm⟩ := hSm_pkg ↥V t_z R_z
  obtain ⟨p₀_hom, p₁_hom, f₀₁_hom, f₁₀_hom,
      ⟨hp₀_C, hp₁_C, _hf₀₁_C, hf₁₀_C⟩,
