      let p_bot : Ideal S := Ideal.comap (algebraMap S (Localization.AtPrime q_pt.asIdeal)) ⊥
      have hBotPrime : (⊥ : Ideal (Localization.AtPrime q_pt.asIdeal)).IsPrime :=
        ⟨bot_ne_top, fun {a b} hab => by
          rw [Submodule.mem_bot] at hab ⊢
          simpa [Submodule.mem_bot] using mul_eq_zero.mp hab⟩
      have hp_bot_prime : p_bot.IsPrime := Ideal.IsPrime.comap _
      let eOrd := IsLocalization.orderIsoOfPrime q_pt.asIdeal.primeCompl (Localization.AtPrime q_pt.asIdeal)
      have hp_bot_eq : (eOrd ⟨⊥, hBotPrime⟩).1 = p_bot := rfl
      have hp_bot_le_q : p_bot ≤ q_pt.asIdeal :=
        Set.disjoint_compl_left_iff_subset.mp (eOrd ⟨⊥, hBotPrime⟩).2.2
      have hp_bot_below : ∀ (r : Ideal S), r.IsPrime → r ≤ q_pt.asIdeal → p_bot ≤ r := by
        intro r hr hr_le
        have hDisj : Disjoint (q_pt.asIdeal.primeCompl : Set S) (r : Set S) :=
