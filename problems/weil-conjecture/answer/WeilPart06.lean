        (@Localization.AtPrime _ _ (hAffU.primeIdealOf x).asIdeal (hAffU.primeIdealOf x).isPrime) := by
      have hIC_stalk : IsIntegrallyClosed ↑(H_sch.presheaf.stalk (x : ↥H_sch)) :=
