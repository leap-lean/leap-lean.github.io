      have hPb₂_r : CategoryTheory.IsPullback ι₂
          (AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj U_ab) ≫ p_K)
          (r ≫ g₁)
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)) := by
        rw [hr_g₁]; exact hPb₂
      obtain ⟨C₃, g₃, p₃, r', _τ₃, _ι₃,
          _hSS₃, _hNoeth₃, hTow₃, _hProp_r', hSurj_r', hr'_r,
          _hι₃_r', _hPb₃, _hτ₃_p₃, _hτ₃_g₃, _hCl₃, _hDisj₃, _hSm₃⟩ :=
        weil_pointed_blowup_tower_domination K m V hPkg hBl hNorm hOpenη C_K p_K
          hIntCK hSmCK ((TopologicalSpace.Opens.map ι'.base).obj U_ab) hUK
          n S_ab C₁ g₁ τ₁ ι₁ C₂ r ι₂
          hSS₁ hNoeth₁ hPb₁ hτ₁_g₁ hCl₁ hDisj₁ hSS₂.1 hProp_r hι₂_r hPb₂_r
      have hConn_p₃ : ∀ z : C₁, _root_.IsConnected (p₃.base ⁻¹' ({z} : Set C₁)) :=
        (hTowerProps hTow₃).2
      have hConn_r : ∀ z : C₁, _root_.IsConnected (r.base ⁻¹' ({z} : Set C₁)) := by
        intro z
        have : AlgebraicGeometry.Surjective r' := hSurj_r'
        have hImEq : r'.base '' (p₃.base ⁻¹' ({z} : Set C₁)) = r.base ⁻¹' ({z} : Set C₁) := by
          ext y
          simp only [Set.mem_image, Set.mem_preimage, Set.mem_singleton_iff]
          constructor
          · rintro ⟨w, hw, rfl⟩
