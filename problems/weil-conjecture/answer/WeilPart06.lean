      let : Algebra ↑(H_sch.presheaf.obj (Opposite.op U)) ↑(H_sch.presheaf.stalk (x : ↥H_sch)) :=
        (H_sch.presheaf.germ U x.1 x.2).hom.toAlgebra
      have := hAffU.isLocalization_stalk x
      have : (hAffU.primeIdealOf x).asIdeal.IsPrime := (hAffU.primeIdealOf x).isPrime
      let e_loc := IsLocalization.algEquiv (hAffU.primeIdealOf x).asIdeal.primeCompl
        (↑(H_sch.presheaf.stalk (x : ↥H_sch)))
        (Localization.AtPrime (hAffU.primeIdealOf x).asIdeal)
      exact IsIntegrallyClosed.of_equiv e_loc.toRingEquiv
    rw [hpx] at hIC_x
    exact hIC_x
