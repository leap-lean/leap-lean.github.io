                (Polynomial.monic_multiset_prod_of_monic _ _
                  fun x _ => Polynomial.monic_X_sub_C x).ne_zero
              obtain ⟨π_c, q_c, hπc, hqc, hXc_ev⟩ := hScaleElem (Polynomial.X - Polynomial.C c) hXc_ne
              obtain ⟨b', u', hb', hu', hS'_ev⟩ :=
                hScaleElem (S'.map fun x => Polynomial.X - Polynomial.C x).prod hS'_ne
              by_cases hqc_alg : res_W q_c ∈ L_alg0
              · by_cases hu'_alg : res_W u' ∈ L_alg0
                · exfalso
                  exact hu_not_S (hScaleRel hπc hb' hqc hu' hXc_ev hS'_ev hb_S hu_S h_ev hqc_alg hu'_alg)
                · obtain ⟨c', hc'_mem, π_c', q', h1, h2, h3, h4⟩ :=
                    ih b' u' hb' hu' hS'_ev hu'_alg
                  exact ⟨c', Multiset.mem_cons_of_mem hc'_mem, π_c', q', h1, h2, h3, h4⟩
              · refine ⟨c, Multiset.mem_cons_self c S', π_c, q_c, hπc, hqc, ?_, hqc_alg⟩
                simpa [φ_T] using hXc_ev
          obtain ⟨c, _, π_c, q, hπc, hq, hcq_eq, hq_not⟩ :=
            hM_ind M π₀ u_pert hπ₀_ne hupert_unit (hM_prod ▸ hg_ev) hupert_not
          exact ⟨c, π_c, q, hπc, hq, hcq_eq, hq_not⟩
      obtain ⟨c, π_c, q, hπc_ne, hq_unit, hcq_eq, hq_not⟩ := hex_lin
      obtain ⟨q_u, hqu_eq⟩ := hq_unit
      have hq_ne_F : W.subtype q ≠ 0 := by
        intro h0
        exact Units.ne_zero q_u (hqu_eq ▸ Subtype.ext h0)
      have hc_in_W : ι_K c ∈ W := by
        by_contra hc_notW
        have hc_ne : c ≠ 0 := fun h0 => hc_notW (by rw [h0, map_zero]; exact W.zero_mem)
        have hιc_ne : ι_K c ≠ 0 := hιK_inj_ne ι_K hc_ne
        have hcinv_W : (ι_K c)⁻¹ ∈ W := (W.mem_or_inv_mem (ι_K c)).resolve_left hc_notW
        let m_c : ↥W := ⟨(ι_K c)⁻¹, hcinv_W⟩
        have hmc_m : m_c ∈ IsLocalRing.maximalIdeal ↥W := by
          by_contra hnot_m
          obtain ⟨u_mc, hu_mc⟩ := IsLocalRing.notMem_maximalIdeal.mp hnot_m
          apply hc_notW
          have h_eq : ι_K c = W.subtype (↑u_mc⁻¹ : ↥W) := by
            have hmc_ne : W.subtype m_c ≠ 0 := inv_ne_zero hιc_ne
            apply mul_right_cancel₀ hmc_ne
            change ι_K c * (ι_K c)⁻¹ = _
            rw [mul_inv_cancel₀ hιc_ne, ← hu_mc, ← map_mul, Units.inv_mul, map_one]
          rw [h_eq]; exact (↑u_mc⁻¹ : ↥W).2
        have h1_sub : W.subtype (1 - T_W * m_c) = ι_K (- c⁻¹ * π_c) * W.subtype q := by
          push_cast [m_c]
          simp only [map_mul, map_neg, map_inv₀]
          have hmul := congrArg (fun x => - (ι_K c)⁻¹ * x) hcq_eq
          calc 1 - W.subtype T_W * (ι_K c)⁻¹
              = - (ι_K c)⁻¹ * (W.subtype T_W - ι_K c) + (1 - (ι_K c)⁻¹ * ι_K c) := by ring
            _ = - (ι_K c)⁻¹ * (ι_K π_c * W.subtype q) + 0 := by
                rw [inv_mul_cancel₀ hιc_ne, sub_self]
                exact congrArg (· + 0) hmul
            _ = - (ι_K c)⁻¹ * ι_K π_c * W.subtype q := by ring
        have h_coeff_eq : ι_K (- c⁻¹ * π_c) = W.subtype ((1 - T_W * m_c) * ↑q_u⁻¹) := by
          apply mul_right_cancel₀ hq_ne_F
          rw [← h1_sub, map_mul, mul_assoc, ← map_mul, ← hqu_eq, Units.inv_mul, map_one, mul_one]
        have hxW : ι_K (- c⁻¹ * π_c) ∈ W := by
          rw [h_coeff_eq]
          exact ((1 - T_W * m_c) * ↑q_u⁻¹ : ↥W).2
        have hx_k0 : res_W ⟨ι_K (- c⁻¹ * π_c), hxW⟩ ∈ k₀ :=
          (hK_mem_W _ hxW).choose_spec.choose_spec.2.2
        have hres_1sub : res_W (1 - T_W * m_c) = 1 := by
          rw [map_sub, map_one, map_mul, (IsLocalRing.residue_eq_zero_iff _).mpr hmc_m,
            mul_zero, sub_zero]
        have hprod_res : res_W ⟨ι_K (- c⁻¹ * π_c), hxW⟩ * res_W q = 1 := by
          have hw_eq : (1 - T_W * m_c : ↥W) = ⟨ι_K (- c⁻¹ * π_c), hxW⟩ * q :=
            Subtype.ext h1_sub
          rw [← map_mul, ← hw_eq, hres_1sub]
        have hresq_ne : res_W q ≠ 0 := by
          rw [Ne, IsLocalRing.residue_eq_zero_iff]
          exact IsLocalRing.notMem_maximalIdeal.mpr ⟨q_u, hqu_eq⟩
        have hq_k0 : res_W q ∈ k₀ := by
          have hinv_eq : res_W q = (res_W ⟨ι_K (- c⁻¹ * π_c), hxW⟩)⁻¹ := by
            have hx_ne : res_W ⟨ι_K (- c⁻¹ * π_c), hxW⟩ ≠ 0 :=
              fun h0 => one_ne_zero (by rw [h0, zero_mul] at hprod_res; exact hprod_res.symm)
            apply mul_left_cancel₀ hx_ne
            rw [hprod_res, mul_inv_cancel₀ hx_ne]
          rw [hinv_eq]
          exact k₀.inv_mem hx_k0
        exact hq_not (hk0_le_Lalg0 hq_k0)
      obtain ⟨c₁, s₁, hs₁_not, hcs₁_eq, hc_k0⟩ := hK_mem_W c hc_in_W
      let w_diff : ↥W := T_W - ⟨ι_K c, hc_in_W⟩
      have hπc_eq : ι_K π_c = W.subtype (w_diff * ↑q_u⁻¹) := by
        apply mul_right_cancel₀ hq_ne_F
        rw [← hcq_eq, map_mul, mul_assoc, ← map_mul, ← hqu_eq, Units.inv_mul, map_one, mul_one]
        rfl
      have hπc_W : ι_K π_c ∈ W := by rw [hπc_eq]; exact (w_diff * _).2
      have hdiff_prod : w_diff = ⟨ι_K π_c, hπc_W⟩ * q := Subtype.ext hcq_eq
      have hπc_m : (⟨ι_K π_c, hπc_W⟩ : ↥W) ∈ IsLocalRing.maximalIdeal ↥W := by
        by_contra hnot_m
        have hrπ_ne : res_W ⟨ι_K π_c, hπc_W⟩ ≠ 0 := by
          rwa [Ne, IsLocalRing.residue_eq_zero_iff]
        have hrπ_k0 : res_W ⟨ι_K π_c, hπc_W⟩ ∈ k₀ :=
          (hK_mem_W _ hπc_W).choose_spec.choose_spec.2.2
        have hres_q : res_W q =
            (res_W ⟨ι_K π_c, hπc_W⟩)⁻¹ * (res_W T_W - res_W ⟨ι_K c, hc_in_W⟩) := by
          apply mul_left_cancel₀ hrπ_ne
          calc res_W ⟨ι_K π_c, hπc_W⟩ * res_W q
              = res_W w_diff := by rw [← map_mul, ← hdiff_prod]
            _ = res_W T_W - res_W ⟨ι_K c, hc_in_W⟩ := map_sub res_W _ _
            _ = res_W ⟨ι_K π_c, hπc_W⟩ *
                ((res_W ⟨ι_K π_c, hπc_W⟩)⁻¹ * (res_W T_W - res_W ⟨ι_K c, hc_in_W⟩)) := by
              rw [← mul_assoc, mul_inv_cancel₀ hrπ_ne, one_mul]
        apply hq_not
        rw [hres_q]
        exact L_alg0.mul_mem (hk0_le_Lalg0 (k₀.inv_mem hrπ_k0))
          (L_alg0.sub_mem hTW_int_k0 (hk0_le_Lalg0 hc_k0))
      obtain ⟨π₀', hπ₀'_Pz, hπ₀'_ne, _, hθπ₀'⟩ := hK_mem_mW π_c hπc_W hπc_m hπc_ne
      let π₁ : ↥V := s₁ * π₀'
      have hπ₁_Pz : π₁ ∈ P_z := Ideal.mul_mem_left P_z s₁ hπ₀'_Pz
      have hs₁_ne : s₁ ≠ 0 := fun h0 => hs₁_not (h0 ▸ P_z.zero_mem)
      have hπ₁_ne : π₁ ≠ 0 := mul_ne_zero hs₁_ne hπ₀'_ne
      have hlin_rel : θ_V s₁ * T_W - θ_V c₁ = θ_V π₁ * q := by
        calc θ_V s₁ * T_W - θ_V c₁
            = θ_V s₁ * T_W - ⟨ι_K c, hc_in_W⟩ * θ_V s₁ := by rw [hcs₁_eq]
          _ = θ_V s₁ * w_diff := by simp only [w_diff]; ring
          _ = θ_V s₁ * (θ_V π₀' * q) := by rw [hdiff_prod, hθπ₀']
          _ = θ_V π₁ * q := by simp only [π₁, map_mul]; ring
      exact ⟨s₁, c₁, π₁, q, hs₁_not, hπ₁_Pz, hπ₁_ne, hlin_rel, (hResTrans_iff q).mpr hq_not⟩

  
  obtain ⟨_, hValLift, hStepTransfer, hPackSmooth⟩ := h_s2
  obtain ⟨ψ_Z, mW, t_div, hmW, hη_ψZ, hCl_u0, hPz_Z, ht_div_Z⟩ := hDiv
  obtain ⟨ψ_X, hη_ψX, hψX_pX⟩ :=
    @hValLift X Z p_X hProp_pX W_target η_X ψ_Z (hη_ψZ.trans hη_pX.symm)

  have hSmoothStep : ∀ (X_c : AlgebraicGeometry.Scheme.{u})
      (g_c : X_c ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
      (p_c : X_c ⟶ Z)
      (η_c : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ X_c)
      (ι_c : U_K.toScheme ⟶ X_c)
      (ψ_c : AlgebraicGeometry.Spec (CommRingCat.of ↥W_target) ⟶ X_c)
      (W_et : X_c.Opens) (hz : ψ_c.base mW ∈ W_et)
      (e : W_et.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial ↥V))),
      IsStrictlySemistableCurveOverValuation V g_c →
      p_c ≫ g_Z = g_c →
      η_c ≫ p_c = η_Z →
      CategoryTheory.IsPullback ι_c (U_K.ι ≫ p_K) g_c
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)) →
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom W_target.subtype) ≫ ψ_c = η_c →
      ψ_c ≫ p_c = ψ_Z →
      ¬ IsValResolvedOnMod V g_Z p_c η_c W_target →
      IsClosed ({ψ_c.base mW} : Set X_c) →
      AlgebraicGeometry.Etale e →
      W_et.ι ≫ g_c = e ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) →
      ∃ (X' : AlgebraicGeometry.Scheme.{u})
        (g_X' : X' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
        (f_bl : X' ⟶ X_c)
        (η_X' : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ X')
        (ι_X' : U_K.toScheme ⟶ X'),
        IsSingleElementaryBlowupStep V g_c g_X' f_bl ∧
        η_X' ≫ f_bl = η_c ∧
        ι_X' ≫ f_bl = ι_c ∧
        CategoryTheory.IsPullback ι_X' (U_K.ι ≫ p_K) g_X'
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)) ∧
        IsValResolvedOnMod V g_Z (f_bl ≫ p_c) η_X' W_target ∧
        (∀ W : ValuationSubring F,
          IsValResolvedOnMod V g_Z p_c η_c W →
          IsValResolvedOnMod V g_Z (f_bl ≫ p_c) η_X' W) := by
    intro X_c g_c p_c η_c ι_c ψ_c W_et hz e
      hSS_c hp_c hη_c hPb_c hη_ψc hψc_pc hUnres_c hCl_zc hEt_e he_comm
    obtain ⟨⟨hPz_eq, hComap_c, hθ_ne⟩, _, hSmoothExt, _⟩ :=
      h_s3 ψ_Z mW t_div hmW hη_ψZ hCl_u0 X_c g_c p_c η_c ψ_c hSS_c hp_c hη_c hη_ψc hψc_pc
    let z_c := ψ_c.base mW
    let P_z := (g_c.base z_c).asIdeal
    have _ : P_z.IsPrime := (g_c.base z_c).isPrime
    have hPz_ne : P_z ≠ ⊥ := by
      change (g_c.base (ψ_c.base mW)).asIdeal ≠ ⊥
      rw [hPz_eq]; exact hPz_Z
    let θ_V := (AlgebraicGeometry.Spec.preimage (ψ_c ≫ g_c)).hom
    have hθ_eq_Z : θ_V = (AlgebraicGeometry.Spec.preimage (ψ_Z ≫ g_Z)).hom := by
      have h1 : ψ_c ≫ g_c = ψ_Z ≫ g_Z := by rw [← hp_c, ← Category.assoc, hψc_pc]
      exact congrArg CommRingCat.Hom.hom (congrArg AlgebraicGeometry.Spec.preimage h1)
    have ht_div_c : ∀ P : Polynomial ↥V, (∃ i : ℕ, P.coeff i ∉ P_z) →
        Polynomial.eval₂ θ_V t_div P ∉ IsLocalRing.maximalIdeal ↥W_target := by
      intro P ⟨i, hi⟩
      have hi' : P.coeff i ∉ (g_Z.base (ψ_Z.base mW)).asIdeal := by
        rw [← hPz_eq]; exact hi
      rw [hθ_eq_Z]
      exact ht_div_Z P ⟨i, hi'⟩
    obtain ⟨ψ_W, hψW_ι, hIdeal_z, hθ_C, hTW_tr, hTW_alg, hTW_not⟩ :=
      hSmoothExt W_et hz e hEt_e he_comm
    let T_W := (AlgebraicGeometry.Spec.preimage (ψ_W ≫ e)).hom Polynomial.X
    obtain ⟨s₁, c₁, π₁, q, hs₁_not, hπ₁_Pz, hπ₁_ne, hlin_eq, hq_tr⟩ :=
      (h_s1 P_z hPz_ne W_target θ_V t_div hComap_c ht_div_c).2 T_W hTW_tr hTW_alg (hTW_not hUnres_c)
    have hMem_lin : Polynomial.C s₁ * Polynomial.X - Polynomial.C c₁ ∈
        (e.base ⟨z_c, hz⟩).asIdeal := by
      rw [hIdeal_z, Ideal.mem_comap]
      have hev : (AlgebraicGeometry.Spec.preimage (ψ_W ≫ e)).hom
          (Polynomial.C s₁ * Polynomial.X - Polynomial.C c₁) = θ_V π₁ * q := by
        rw [map_sub, map_mul, hθ_C s₁, hθ_C c₁]
        exact hlin_eq
      rw [hev]
      have hθπ₁_m : θ_V π₁ ∈ IsLocalRing.maximalIdeal ↥W_target := by
        rwa [← Ideal.mem_comap, hComap_c]
      exact Ideal.mul_mem_right _ _ hθπ₁_m
    obtain ⟨X', g_X', f_bl, U_iso, V_sm', e',
        hStep, _, hIso_bl, hGen_bl, _, _, _, hUniv_bl⟩ :=
      hBl.1 X_c g_c z_c W_et hz e s₁ c₁ π₁
        hSS_c hCl_zc hPz_ne hEt_e he_comm hs₁_not hπ₁_Pz hπ₁_ne hMem_lin
    have hProp_bl : AlgebraicGeometry.IsProper f_bl := hStep.2.1
    have hComm_bl : f_bl ≫ g_c = g_X' := hStep.2.2.1
    obtain ⟨η_X', ι_X', hη_bl, hι_bl, hPb_X', hPres_bl, hLift_ψ⟩ :=
      hStepTransfer X_c X' g_c g_X' p_c f_bl η_c ι_c U_iso
        hProp_bl hComm_bl hp_c hη_c hPb_c hIso_bl hGen_bl
    obtain ⟨ψ_X', hη'_ψX', hψX'_fbl⟩ := hLift_ψ W_target ψ_c hη_ψc
    have hθ_X' : (AlgebraicGeometry.Spec.preimage (ψ_X' ≫ g_X')).hom = θ_V := by
      have h1 : ψ_X' ≫ g_X' = ψ_c ≫ g_c := by
        rw [← hComm_bl, ← Category.assoc, hψX'_fbl]
      exact congrArg CommRingCat.Hom.hom (congrArg AlgebraicGeometry.Spec.preimage h1)
    have hθπ₁_ne : (AlgebraicGeometry.Spec.preimage (ψ_X' ≫ g_X')).hom π₁ ≠ 0 := by
      rw [hθ_X']
      exact hθ_ne π₁ hπ₁_ne
    have hEq_bl : (AlgebraicGeometry.Spec.preimage (ψ_W ≫ e)).hom
        (Polynomial.C s₁ * Polynomial.X - Polynomial.C c₁) =
        (AlgebraicGeometry.Spec.preimage (ψ_X' ≫ g_X')).hom π₁ * q := by
      rw [hθ_X', map_sub, map_mul, hθ_C s₁, hθ_C c₁]
      exact hlin_eq
    obtain ⟨ψ_V, hψV_ι, hMul_eq⟩ :=
      hUniv_bl ↥W_target ψ_X' mW ψ_W hmW
        (by rw [hψX'_fbl]) (by rw [hψW_ι, hψX'_fbl]) q hθπ₁_ne hEq_bl
    have hX_eq_q : (AlgebraicGeometry.Spec.preimage (ψ_V ≫ e')).hom Polynomial.X = q :=
      mul_left_cancel₀ hθπ₁_ne hMul_eq
    have hRes_new : IsValResolvedOnMod V g_Z (f_bl ≫ p_c) η_X' W_target := by
      apply hPackSmooth X' (f_bl ≫ p_c) η_X' W_target ψ_X' mW V_sm' e' ψ_V q
        hmW hη'_ψX' hψV_ι hX_eq_q
      intro P hP
      have h_zc : (ψ_X' ≫ f_bl ≫ p_c).base mW = ψ_Z.base mW := by
        rw [← Category.assoc, hψX'_fbl, hψc_pc]
      rw [h_zc, ← hPz_eq] at hP
      have h_θ : (AlgebraicGeometry.Spec.preimage (ψ_X' ≫ (f_bl ≫ p_c) ≫ g_Z)).hom = θ_V := by
        rw [Category.assoc f_bl p_c g_Z, hp_c, hComm_bl, hθ_X']
      rw [h_θ]
      exact hq_tr P hP
    exact ⟨X', g_X', f_bl, η_X', ι_X', hStep, hη_bl, hι_bl, hPb_X', hRes_new, hPres_bl⟩

  obtain ⟨⟨hPz0_eq, hComap0, hθ0_ne⟩, hDich0, _, hChart0⟩ :=
    h_s3 ψ_Z mW t_div hmW hη_ψZ hCl_u0 X g_X p_X η_X ψ_X hSS_X hComm_pX hη_pX hη_ψX hψX_pX
  have hCl_z0 : IsClosed ({ψ_X.base mW} : Set X) := hDich0.resolve_left hUnres
  rcases hChart0 with ⟨W_et, hz, e, hEt_e, he_comm⟩ |
      ⟨W_et, hz, a, e, ψ_W, ha_ne, hEt_e, he_comm, hψW_ι, hAll_in,
        huv_eq, hu_m, hv_m, hu_tr, hu_alg⟩
  · obtain ⟨X', g_X', f_bl, η_X', ι_X', hStep, hη_bl, hι_bl, hPb_X', hRes_new, hPres_bl⟩ :=
      hSmoothStep X g_X p_X η_X ι_X ψ_X W_et hz e
        hSS_X hComm_pX hη_pX hPb_X hη_ψX hψX_pX hUnres hCl_z0 hEt_e he_comm
    exact ⟨X', g_X', f_bl, η_X', ι_X', hStep.1, hStep.2.1, hStep.2.2.1,
      hη_bl, hι_bl, hPb_X', hRes_new, hPres_bl, Or.inl hStep⟩
  · let z₀ := ψ_X.base mW
    let P_z0 := (g_X.base z₀).asIdeal
    have _ : P_z0.IsPrime := (g_X.base z₀).isPrime
    have hPz0_ne : P_z0 ≠ ⊥ := by
      change (g_X.base (ψ_X.base mW)).asIdeal ≠ ⊥
      rw [hPz0_eq]; exact hPz_Z
    let θ_V0 := (AlgebraicGeometry.Spec.preimage (ψ_X ≫ g_X)).hom
    have hθ0_eq_Z : θ_V0 = (AlgebraicGeometry.Spec.preimage (ψ_Z ≫ g_Z)).hom := by
      have h1 : ψ_X ≫ g_X = ψ_Z ≫ g_Z := by rw [← hComm_pX, ← Category.assoc, hψX_pX]
      exact congrArg CommRingCat.Hom.hom (congrArg AlgebraicGeometry.Spec.preimage h1)
    have ht_div0 : ∀ P : Polynomial ↥V, (∃ i : ℕ, P.coeff i ∉ P_z0) →
        Polynomial.eval₂ θ_V0 t_div P ∉ IsLocalRing.maximalIdeal ↥W_target := by
      intro P ⟨i, hi⟩
      have hi' : P.coeff i ∉ (g_Z.base (ψ_Z.base mW)).asIdeal := by
        rw [← hPz0_eq]; exact hi
      rw [hθ0_eq_Z]
      exact ht_div_Z P ⟨i, hi'⟩
    obtain ⟨π₁, a', q, hπ₁_Pz, hπ₁_ne, ha_fac, hq_unit, huW_eq⟩ :=
      (h_s1 P_z0 hPz0_ne W_target θ_V0 t_div hComap0 ht_div0).1
        a _ _ ha_ne huv_eq hu_m hv_m hu_tr hu_alg
    have hs₁_1 : (1 : ↥V) ∉ P_z0 := (g_X.base z₀).isPrime.one_notMem
    obtain ⟨X₁, g₁, f₁, U_iso₁, V_sm'₁, e_sm₁,
        hStep₁, hIso₁, hGen₁, _, hEt_esm₁, hesm₁_comm, _, hUniv₁⟩ :=
      hBl.2 X g_X z₀ W_et hz a e 1 π₁ a'
        hSS_X hCl_z0 hPz0_ne ha_ne hEt_e he_comm ha_fac hs₁_1 hπ₁_Pz hAll_in
    have hSS₁ : IsStrictlySemistableCurveOverValuation V g₁ := hStep₁.1
    have hProp₁ : AlgebraicGeometry.IsProper f₁ := hStep₁.2.1
    have hComm₁ : f₁ ≫ g_X = g₁ := hStep₁.2.2.1
    obtain ⟨η_X₁, ι_X₁, hη₁, hι₁, hPb₁, hPres₁, hLift₁⟩ :=
      hStepTransfer X X₁ g_X g₁ p_X f₁ η_X ι_X U_iso₁
        hProp₁ hComm₁ hComm_pX hη_pX hPb_X hIso₁ hGen₁
    obtain ⟨ψ_X₁, hη₁_ψX₁, hψX₁_f₁⟩ := hLift₁ W_target ψ_X hη_ψX
    have hθ_X₁ : (AlgebraicGeometry.Spec.preimage (ψ_X₁ ≫ g₁)).hom = θ_V0 := by
      have h1 : ψ_X₁ ≫ g₁ = ψ_X ≫ g_X := by rw [← hComm₁, ← Category.assoc, hψX₁_f₁]
      exact congrArg CommRingCat.Hom.hom (congrArg AlgebraicGeometry.Spec.preimage h1)
    have hθπ₁_ne1 : (AlgebraicGeometry.Spec.preimage (ψ_X₁ ≫ g₁)).hom π₁ ≠ 0 := by
      rw [hθ_X₁]
      exact hθ0_ne π₁ hπ₁_ne
    have hEq_nod : (AlgebraicGeometry.Spec.preimage (ψ_W ≫ e)).hom
        (Ideal.Quotient.mk _ (MvPolynomial.C 1 * MvPolynomial.X 0)) =
        (AlgebraicGeometry.Spec.preimage (ψ_X₁ ≫ g₁)).hom π₁ * q := by
      rw [map_one, one_mul, hθ_X₁]
      exact huW_eq
    have hRange₁ : Set.range ψ_X₁.base ⊆ (V_sm'₁ : Set X₁) :=
      hUniv₁ ↥W_target ψ_X₁ mW ψ_W q hmW
        (by rw [hψX₁_f₁]) (by rw [hψW_ι, hψX₁_f₁]) hq_unit hθπ₁_ne1 hEq_nod
    have hz₁ : ψ_X₁.base mW ∈ V_sm'₁ := hRange₁ ⟨mW, rfl⟩
    by_cases hRes₁ : IsValResolvedOnMod V g_Z (f₁ ≫ p_X) η_X₁ W_target
    · exact ⟨X₁, g₁, f₁, η_X₁, ι_X₁, hSS₁, hProp₁, hComm₁, hη₁, hι₁, hPb₁,
        hRes₁, hPres₁, Or.inl hStep₁⟩
    · have hp₁_gZ : (f₁ ≫ p_X) ≫ g_Z = g₁ := by rw [Category.assoc, hComm_pX, hComm₁]
      have hη₁_p₁ : η_X₁ ≫ (f₁ ≫ p_X) = η_Z := by rw [← Category.assoc, hη₁, hη_pX]
      have hψ₁_p₁ : ψ_X₁ ≫ (f₁ ≫ p_X) = ψ_Z := by rw [← Category.assoc, hψX₁_f₁, hψX_pX]
      obtain ⟨_, hDich₁, _, _⟩ :=
        h_s3 ψ_Z mW t_div hmW hη_ψZ hCl_u0 X₁ g₁ (f₁ ≫ p_X) η_X₁ ψ_X₁
          hSS₁ hp₁_gZ hη₁_p₁ hη₁_ψX₁ hψ₁_p₁
      have hCl_z₁ : IsClosed ({ψ_X₁.base mW} : Set X₁) := hDich₁.resolve_left hRes₁
      obtain ⟨X₂, g₂, f₂, η_X₂, ι_X₂, hStep₂, hη₂, hι₂, hPb₂, hRes₂, hPres₂⟩ :=
        hSmoothStep X₁ g₁ (f₁ ≫ p_X) η_X₁ ι_X₁ ψ_X₁ V_sm'₁ hz₁ e_sm₁
          hSS₁ hp₁_gZ hη₁_p₁ hPb₁ hη₁_ψX₁ hψ₁_p₁ hRes₁ hCl_z₁ hEt_esm₁ hesm₁_comm
      have hProp₂ : AlgebraicGeometry.IsProper f₂ := hStep₂.2.1
      have hProp_step : AlgebraicGeometry.IsProper (f₂ ≫ f₁) :=
        @AlgebraicGeometry.IsProper.instCompScheme _ _ _ f₂ f₁ hProp₂ hProp₁
      refine ⟨X₂, g₂, f₂ ≫ f₁, η_X₂, ι_X₂, hStep₂.1, hProp_step, ?_, ?_, ?_, hPb₂, ?_, ?_, ?_⟩
      · rw [Category.assoc, hComm₁, hStep₂.2.2.1]
      · rw [← Category.assoc, hη₂, hη₁]
      · rw [← Category.assoc, hι₂, hι₁]
      · rwa [Category.assoc]
      · intro W hW
        rw [Category.assoc]
        exact hPres₂ W (hPres₁ W hW)
      · exact Or.inr ⟨X₁, g₁, f₁, f₂, rfl, hStep₁, hStep₂⟩

theorem weil_overlap_open_section_lifting_and_nodal_smoothing (K : Type u) [Field K]
    (m : ℕ) (V : ValuationSubring K) (hPkg : IsValuationRingAlgPackage m V)
    (hBl : HasOverlapElementaryBlowupOracle V)
    (hOpenη : AlgebraicGeometry.IsOpenImmersion
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (hSmCK : AlgebraicGeometry.SmoothOfRelativeDimension 1 p_K)
    (U_K : C_K.Opens)
    (n : ℕ) (S : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V)).Opens) :
    (∀ (Z X : AlgebraicGeometry.Scheme.{u})
        (g_Z : Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
        (g_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
        (p_X : X ⟶ Z)
        (ι_Z : U_K.toScheme ⟶ Z)
        (ι_X : U_K.toScheme ⟶ X)
        (τ_Z : ∀ j : Fin n, (S j).toScheme ⟶ Z),
      AlgebraicGeometry.IsProper p_X →
      p_X ≫ g_Z = g_X →
      ι_X ≫ p_X = ι_Z →
      CategoryTheory.IsPullback ι_Z (U_K.ι ≫ p_K) g_Z
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)) →
      CategoryTheory.IsPullback ι_X (U_K.ι ≫ p_K) g_X
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)) →
      (∀ j : Fin n, τ_Z j ≫ g_Z = (S j).ι) →
      (∀ j : Fin n, AlgebraicGeometry.IsClosedImmersion (τ_Z j)) →
      (_root_.Pairwise fun i j : Fin n =>
        Disjoint (Set.range (τ_Z i).base) (Set.range (τ_Z j).base)) →
      ∃ (τ_X : ∀ j : Fin n, (S j).toScheme ⟶ X),
        (∀ j : Fin n, τ_X j ≫ p_X = τ_Z j) ∧
        (∀ j : Fin n, τ_X j ≫ g_X = (S j).ι) ∧
        (∀ j : Fin n, AlgebraicGeometry.IsClosedImmersion (τ_X j)) ∧
        (_root_.Pairwise fun i j : Fin n =>
          Disjoint (Set.range (τ_X i).base) (Set.range (τ_X j).base))) ∧
    (∀ (X : AlgebraicGeometry.Scheme.{u})
        (g_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
        (τ_X : ∀ j : Fin n, (S j).toScheme ⟶ X)
        (ι_X : U_K.toScheme ⟶ X)
        (j₀ : Fin n),
      IsStrictlySemistableCurveOverValuation V g_X →
      CategoryTheory.IsPullback ι_X (U_K.ι ≫ p_K) g_X
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)) →
      (∀ j : Fin n, τ_X j ≫ g_X = (S j).ι) →
      (∀ j : Fin n, AlgebraicGeometry.IsClosedImmersion (τ_X j)) →
      (_root_.Pairwise fun i j : Fin n =>
        Disjoint (Set.range (τ_X i).base) (Set.range (τ_X j).base)) →
      ¬ (∀ b : (S j₀).toScheme,
          ∃ V_sm : X.Opens,
            (τ_X j₀).base b ∈ V_sm ∧
            AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ g_X)) →
      ∃ (X' : AlgebraicGeometry.Scheme.{u})
        (g_X' : X' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
        (f_bl : X' ⟶ X)
        (τ_X' : ∀ j : Fin n, (S j).toScheme ⟶ X')
        (ι_X' : U_K.toScheme ⟶ X'),
        IsSingleElementaryBlowupStep V g_X g_X' f_bl ∧
        ι_X' ≫ f_bl = ι_X ∧
        CategoryTheory.IsPullback ι_X' (U_K.ι ≫ p_K) g_X'
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)) ∧
        (∀ j : Fin n, τ_X' j ≫ f_bl = τ_X j) ∧
        (∀ j : Fin n, τ_X' j ≫ g_X' = (S j).ι) ∧
        (∀ j : Fin n, AlgebraicGeometry.IsClosedImmersion (τ_X' j)) ∧
        (_root_.Pairwise fun i j : Fin n =>
          Disjoint (Set.range (τ_X' i).base) (Set.range (τ_X' j).base)) ∧
        (∀ b : (S j₀).toScheme,
          ∃ V_sm : X'.Opens,
            (τ_X' j₀).base b ∈ V_sm ∧
            AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ g_X')) ∧
        (∀ j : Fin n,
          (∀ b : (S j).toScheme,
            ∃ V_sm : X.Opens,
              (τ_X j).base b ∈ V_sm ∧
              AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ g_X)) →
          (∀ b : (S j).toScheme,
            ∃ V_sm : X'.Opens,
              (τ_X' j).base b ∈ V_sm ∧
              AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ g_X')))) :=
by
  have h_unused : _ ∧ _ := ⟨hOpenη, hSmCK⟩
  clear h_unused hOpenη hSmCK
  
  have hFinMax : ∀ {α : Type u} (r : α → α → Prop),
      (∀ x, r x x) →
      (∀ x y z, r x y → r y z → r x z) →
      (∀ x y, r x y ∨ r y x) →
      ∀ (F : Set α), F.Finite → F.Nonempty →
      ∃ x_max ∈ F, ∀ y ∈ F, r y x_max := by
    intro α r hrefl htrans htot F hFin hNe
    classical
    have hs : hFin.toFinset.Nonempty := (Set.Finite.toFinset_nonempty hFin).mpr hNe
    suffices h : ∀ (s : Finset α), s.Nonempty → ∃ x_max ∈ s, ∀ y ∈ s, r y x_max by
      obtain ⟨x_max, hx_mem, hx_max⟩ := h hFin.toFinset hs
      exact ⟨x_max, (Set.Finite.mem_toFinset hFin).mp hx_mem,
        fun y hy => hx_max y ((Set.Finite.mem_toFinset hFin).mpr hy)⟩
    intro s
    induction s using Finset.induction_on with
    | empty =>
      intro h
      exact False.elim (Finset.not_nonempty_empty h)
    | @insert a s' _ ih =>
      intro _
      by_cases hs' : s'.Nonempty
      · obtain ⟨m_el, hm_mem, hm_max⟩ := ih hs'
        rcases htot a m_el with ham | hma
        · refine ⟨m_el, Finset.mem_insert_of_mem hm_mem, fun y hy => ?_⟩
          rcases Finset.mem_insert.mp hy with rfl | hy'
          · exact ham
          · exact hm_max y hy'
        · refine ⟨a, Finset.mem_insert_self a s', fun y hy => ?_⟩
          rcases Finset.mem_insert.mp hy with rfl | hy'
          · exact hrefl _
          · exact htrans y m_el a (hm_max y hy') hma
      · rw [Finset.not_nonempty_iff_eq_empty.mp hs']
        refine ⟨a, Finset.mem_singleton_self a, fun y hy => ?_⟩
        rw [Finset.mem_singleton.mp hy]
        exact hrefl _

  
  have hS1_iso : ∀ (S₀ : (AlgebraicGeometry.Spec (CommRingCat.of ↥V)).Opens),
      Nonempty ↥S₀ →
      ∃ (P : Ideal ↥V) (_ : P.IsPrime)
        (α : AlgebraicGeometry.Spec (CommRingCat.of ↥(V.ofPrime P)) ≅ S₀.toScheme)
        (m_P : AlgebraicGeometry.Spec (CommRingCat.of ↥(V.ofPrime P))),
        m_P.asIdeal = IsLocalRing.maximalIdeal ↥(V.ofPrime P) ∧
        IsClosed ({α.hom.base m_P} : Set ↥S₀.toScheme) ∧
        (∀ q : AlgebraicGeometry.Spec (CommRingCat.of ↥(V.ofPrime P)), q ⤳ m_P) ∧
        (letI : Algebra ↥V ↥(V.ofPrime P) := ValuationSubring.ofPrimeAlgebra V P
         α.hom ≫ S₀.ι =
           AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V ↥(V.ofPrime P)))) := by
    clear hBl C_K p_K U_K n S
    intro S₀ hne
    let SpecV := AlgebraicGeometry.Spec (CommRingCat.of ↥V)
    have hFinUniv : Set.Finite (Set.univ : Set ↥SpecV) := hPkg.1
    obtain ⟨⟨q₀, hq₀⟩⟩ := hne
    have hF0_ne : (S₀ : Set ↥SpecV).Nonempty := ⟨q₀, hq₀⟩
    have hF0_fin : (S₀ : Set ↥SpecV).Finite := hFinUniv.subset (Set.subset_univ _)
    have hTot : ∀ Q₁ Q₂ : ↥SpecV, Q₁.asIdeal ≤ Q₂.asIdeal ∨ Q₂.asIdeal ≤ Q₁.asIdeal :=
      fun Q₁ Q₂ => (ValuationRing.le_total_ideal ↥V).total
        (Q₁.asIdeal : Ideal ↥V) (Q₂.asIdeal : Ideal ↥V)
    obtain ⟨q_max, hq_max_mem, hq_max_le⟩ :=
      hFinMax (fun Q₁ Q₂ : ↥SpecV => Q₁.asIdeal ≤ Q₂.asIdeal)
        (fun _ => le_rfl) (fun _ _ _ => le_trans) hTot
        (S₀ : Set ↥SpecV) hF0_fin hF0_ne
    let P : Ideal ↥V := q_max.asIdeal
    have instPrimeP : P.IsPrime := q_max.isPrime
    have hS0_iff_le : ∀ Q : ↥SpecV, Q ∈ S₀ ↔ Q.asIdeal ≤ P := by
      intro Q
      refine ⟨fun hQ => hq_max_le Q hQ, fun hle => ?_⟩
      have hspec : Q ⤳ q_max :=
        (@PrimeSpectrum.le_iff_specializes ↥V _ Q q_max).mp hle
      exact hspec.mem_open S₀.isOpen hq_max_mem
    have ht₀_ex : ∃ t₀ : ↥V, t₀ ∉ P ∧ ∀ Q : ↥SpecV, Q ∈ S₀ ↔ t₀ ∉ Q.asIdeal := by
      by_cases hAll : ∀ Q : ↥SpecV, Q ∈ S₀
      · refine ⟨1, fun h1 => instPrimeP.ne_top ((Ideal.eq_top_iff_one P).mpr h1), fun Q => ?_⟩
        refine ⟨fun _ h1 => Q.isPrime.ne_top ((Ideal.eq_top_iff_one Q.asIdeal).mpr h1),
          fun _ => hAll Q⟩
      · push Not at hAll
        obtain ⟨q_out, hq_out⟩ := hAll
        let F_c : Set ↥SpecV := {Q : ↥SpecV | Q ∉ S₀}
        have hFc_ne : F_c.Nonempty := ⟨q_out, hq_out⟩
        have hFc_fin : F_c.Finite := hFinUniv.subset (Set.subset_univ _)
        obtain ⟨q_min, hq_min_out, hq_min_le⟩ :=
          hFinMax (fun Q₁ Q₂ : ↥SpecV => Q₂.asIdeal ≤ Q₁.asIdeal)
            (fun _ => le_rfl) (fun _ _ _ h1 h2 => le_trans h2 h1)
            (fun Q₁ Q₂ => (hTot Q₁ Q₂).symm) F_c hFc_fin hFc_ne
        have hnot_le : ¬ ((q_min.asIdeal : Set ↥V) ⊆ (P : Set ↥V)) := by
          intro hsub
          exact hq_min_out ((hS0_iff_le q_min).mpr hsub)
        obtain ⟨t₀, ht₀_min, ht₀_not_P⟩ := Set.not_subset.mp hnot_le
        refine ⟨t₀, ht₀_not_P, fun Q => ?_⟩
        refine ⟨fun hQ ht₀Q => ht₀_not_P ((hS0_iff_le Q).mp hQ ht₀Q), fun ht₀Q => ?_⟩
        by_contra hQ_not
        exact ht₀Q (hq_min_le Q hQ_not ht₀_min)
    obtain ⟨t₀, ht₀_not_P, ht₀_iff⟩ := ht₀_ex
    let _ : Algebra ↥V ↥(V.ofPrime P) := ValuationSubring.ofPrimeAlgebra V P
    have _ : IsLocalization.AtPrime ↥(V.ofPrime P) P := ValuationSubring.ofPrime_localization V P
    have hcoe_VP : ∀ v : ↥V, ((algebraMap ↥V ↥(V.ofPrime P) v : ↥(V.ofPrime P)) : K) = (v : K) :=
      fun _ => rfl
    have _ : IsLocalization.Away t₀ ↥(V.ofPrime P) := by
      refine ⟨?_, ?_, ?_⟩
      · rintro ⟨_, k, rfl⟩
        exact IsLocalization.map_units ↥(V.ofPrime P)
          (⟨t₀ ^ k, fun hmem => ht₀_not_P (instPrimeP.mem_of_pow_mem k hmem)⟩ : P.primeCompl)
      · intro z
        obtain ⟨⟨a, s⟩, hzs⟩ := IsLocalization.surj P.primeCompl z
        have hs_not_P : (s : ↥V) ∉ P := s.2
        have ht₀_rad : t₀ ∈ (Ideal.span {(s : ↥V)}).radical := by
          rw [Ideal.radical_eq_sInf]
          refine Ideal.mem_sInf.mpr ?_
          rintro J ⟨hsJ, hJprime⟩
          have hs_mem_J : (s : ↥V) ∈ J := hsJ (Ideal.subset_span rfl)
          let Q_J : ↥SpecV := ⟨J, hJprime⟩
          have hQJ_not : Q_J ∉ S₀ :=
            fun hmem => hs_not_P ((hS0_iff_le Q_J).mp hmem hs_mem_J)
          by_contra ht₀_not_J
          exact hQJ_not ((ht₀_iff Q_J).mpr ht₀_not_J)
        rw [Ideal.mem_radical_iff] at ht₀_rad
        obtain ⟨k, hk⟩ := ht₀_rad
        rw [Ideal.mem_span_singleton] at hk
        obtain ⟨r, hr⟩ := hk
        refine ⟨(a * r, ⟨t₀ ^ k, k, rfl⟩), ?_⟩
        dsimp only
        rw [hr, map_mul, map_mul, ← mul_assoc, hzs]
      · intro x y hxy
        refine ⟨⟨1, 0, pow_zero t₀⟩, ?_⟩
        dsimp only
        rw [one_mul, one_mul]
        apply Subtype.ext
        have hK := congrArg (fun w : ↥(V.ofPrime P) => (w : K)) hxy
        rwa [hcoe_VP x, hcoe_VP y] at hK
    let f_P : AlgebraicGeometry.Spec (CommRingCat.of ↥(V.ofPrime P)) ⟶ SpecV :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V ↥(V.ofPrime P)))
    have _ : AlgebraicGeometry.IsOpenImmersion f_P :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization t₀
    have hRange : Set.range f_P.base = Set.range S₀.ι.base := by
      ext Q
      have h1 : Q ∈ Set.range f_P.base ↔
          (Q : PrimeSpectrum ↥V) ∈
            Set.range (PrimeSpectrum.comap (algebraMap ↥V ↥(V.ofPrime P))) := by
        constructor
        · rintro ⟨q, rfl⟩
          exact ⟨q, (AlgebraicGeometry.Spec.map_apply
            (CommRingCat.ofHom (algebraMap ↥V ↥(V.ofPrime P))) q).symm⟩
        · rintro ⟨q, hq⟩
          refine ⟨q, ?_⟩
          exact (AlgebraicGeometry.Spec.map_apply
            (CommRingCat.ofHom (algebraMap ↥V ↥(V.ofPrime P))) q).trans hq
      have h2 : Set.range (PrimeSpectrum.comap (algebraMap ↥V ↥(V.ofPrime P))) =
          (PrimeSpectrum.basicOpen t₀ : Set (PrimeSpectrum ↥V)) :=
        PrimeSpectrum.localization_away_comap_range ↥(V.ofPrime P) t₀
      have h3 : (Q : PrimeSpectrum ↥V) ∈ (PrimeSpectrum.basicOpen t₀ : Set (PrimeSpectrum ↥V)) ↔
          t₀ ∉ Q.asIdeal :=
        SetLike.mem_coe.trans (PrimeSpectrum.mem_basicOpen t₀ (Q : PrimeSpectrum ↥V))
      have h4 : Q ∈ Set.range S₀.ι.base ↔ Q ∈ S₀ := by simp
      rw [h1, h2, h3, ← ht₀_iff Q, h4]
    let α : AlgebraicGeometry.Spec (CommRingCat.of ↥(V.ofPrime P)) ≅ S₀.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq f_P S₀.ι hRange
    let m_P : AlgebraicGeometry.Spec (CommRingCat.of ↥(V.ofPrime P)) :=
      ⟨IsLocalRing.maximalIdeal ↥(V.ofPrime P), inferInstance⟩
    refine ⟨P, instPrimeP, α, m_P, rfl, ?_, ?_,
      AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac f_P S₀.ι hRange⟩
    · have hcl0 : IsClosed ({m_P} : Set ↥(AlgebraicGeometry.Spec (CommRingCat.of ↥(V.ofPrime P)))) :=
        (@PrimeSpectrum.isClosed_singleton_iff_isMaximal ↥(V.ofPrime P) _ m_P).mpr
          (IsLocalRing.maximalIdeal.isMaximal ↥(V.ofPrime P))
      simpa [Set.image_singleton] using α.hom.isClosedMap {m_P} hcl0
    · intro q
      exact (@PrimeSpectrum.le_iff_specializes ↥(V.ofPrime P) _ q m_P).mp
        (IsLocalRing.le_maximalIdeal q.isPrime.ne_top)

  
  have hS1_lift : ∀ (S₀ : (AlgebraicGeometry.Spec (CommRingCat.of ↥V)).Opens)
      (U_K_sch Z X : AlgebraicGeometry.Scheme.{u})
      (p_UK : U_K_sch ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
      (g_Z : Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
      (g_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
      (p_X : X ⟶ Z)
      (ι_Z : U_K_sch ⟶ Z)
      (ι_X : U_K_sch ⟶ X)
      (τ₀ : S₀.toScheme ⟶ Z),
      AlgebraicGeometry.IsProper p_X →
      p_X ≫ g_Z = g_X →
      ι_X ≫ p_X = ι_Z →
      CategoryTheory.IsPullback ι_Z p_UK g_Z
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)) →
      τ₀ ≫ g_Z = S₀.ι →
      AlgebraicGeometry.IsClosedImmersion τ₀ →
      ∃ (τ' : S₀.toScheme ⟶ X),
        τ' ≫ p_X = τ₀ ∧
        τ' ≫ g_X = S₀.ι ∧
        AlgebraicGeometry.IsClosedImmersion τ' := by
    clear hFinMax hPkg hBl C_K p_K U_K n S
    intro S₀ U_K_sch Z X p_UK g_Z g_X p_X ι_Z ι_X τ₀ hProp_pX hp_g hι_p hPb_Z hτ₀_g hCl_τ₀
    by_cases hne : Nonempty ↥S₀
    · obtain ⟨P, instPrimeP, α, _m_P, _hm_P, _hCl_bm, _hSpec_mP, hα_g⟩ := hS1_iso S₀ hne
      let _ : P.IsPrime := instPrimeP
      let _ : Algebra ↥V ↥(V.ofPrime P) := ValuationSubring.ofPrimeAlgebra V P
      let R := V.ofPrime P
      let η_R : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of ↥R) :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom R.subtype)
      have hηR_fP : η_R ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V ↥R)) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype) := by
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        rfl
      have h_cone : (η_R ≫ α.hom ≫ τ₀) ≫ g_Z =
          𝟙 (AlgebraicGeometry.Spec (CommRingCat.of K)) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype) := by
        calc
          (η_R ≫ α.hom ≫ τ₀) ≫ g_Z = η_R ≫ α.hom ≫ (τ₀ ≫ g_Z) := by
            simp only [CategoryTheory.Category.assoc]
          _ = η_R ≫ (α.hom ≫ S₀.ι) := by rw [hτ₀_g]
          _ = η_R ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V ↥R)) := by
            rw [hα_g]
          _ = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of K)) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype) := by
            rw [hηR_fP, CategoryTheory.Category.id_comp]
      let σ_UK : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ U_K_sch :=
        hPb_Z.lift (η_R ≫ α.hom ≫ τ₀) (𝟙 _) h_cone
      have h_val_sq : (σ_UK ≫ ι_X) ≫ p_X = η_R ≫ (α.hom ≫ τ₀) := by
        rw [CategoryTheory.Category.assoc, hι_p, hPb_Z.lift_fst]
      have hUniv : (AlgebraicGeometry.topologically @SpecializingMap).universally p_X := by
        apply CategoryTheory.MorphismProperty.universally_mono
          (a := AlgebraicGeometry.topologically @IsClosedMap)
        · intro A B g hg
          exact IsClosedMap.specializingMap hg
        · exact (AlgebraicGeometry.universallyClosed_iff p_X).mp inferInstance
      have hEx : AlgebraicGeometry.ValuativeCriterion.Existence p_X :=
        AlgebraicGeometry.ValuativeCriterion.Existence.of_specializingMap p_X hUniv
      let sq : AlgebraicGeometry.ValuativeCommSq p_X :=
        AlgebraicGeometry.ValuativeCommSq.mk ↥R K (σ_UK ≫ ι_X) (α.hom ≫ τ₀) ⟨h_val_sq⟩
      obtain ⟨l⟩ := (hEx sq).exists_lift
      let τ' : S₀.toScheme ⟶ X := α.inv ≫ l.l
      have hτ'_pX : τ' ≫ p_X = τ₀ := by
        change (α.inv ≫ l.l) ≫ p_X = τ₀
        rw [CategoryTheory.Category.assoc, l.fac_right, α.inv_hom_id_assoc]
      have hτ'_gX : τ' ≫ g_X = S₀.ι := by
        rw [← hp_g, ← CategoryTheory.Category.assoc, hτ'_pX, hτ₀_g]
      have _ : AlgebraicGeometry.IsClosedImmersion (τ' ≫ p_X) := by
        rw [hτ'_pX]; exact hCl_τ₀
      exact ⟨τ', hτ'_pX, hτ'_gX, AlgebraicGeometry.IsClosedImmersion.of_comp τ' p_X⟩
    · have _ : IsEmpty ↥S₀.toScheme := by
        change IsEmpty ↥S₀
        exact not_nonempty_iff.mp hne
      let hInit := @AlgebraicGeometry.isInitialOfIsEmpty S₀.toScheme inferInstance
      let τ' : S₀.toScheme ⟶ X := hInit.to X
      have hτ'_pX : τ' ≫ p_X = τ₀ := hInit.hom_ext _ _
      have hτ'_gX : τ' ≫ g_X = S₀.ι := hInit.hom_ext _ _
      have _ : AlgebraicGeometry.IsClosedImmersion (τ' ≫ p_X) := by
        rw [hτ'_pX]; exact hCl_τ₀
      exact ⟨τ', hτ'_pX, hτ'_gX, AlgebraicGeometry.IsClosedImmersion.of_comp τ' p_X⟩

  
  have hS2 : ∀ (X X' : AlgebraicGeometry.Scheme.{u})
      (g_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
      (g_X' : X' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
      (f_bl : X' ⟶ X)
      (U_iso : X.Opens),
      f_bl ≫ g_X = g_X' →
      CategoryTheory.IsIso (f_bl ∣_ U_iso) →
      ((∀ x : X, (g_X.base x).asIdeal = ⊥ → x ∈ U_iso) →
        ∀ (U_K_sch : AlgebraicGeometry.Scheme.{u})
          (p_UK : U_K_sch ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
          (ι_X : U_K_sch ⟶ X),
          CategoryTheory.IsPullback ι_X p_UK g_X
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)) →
          ∃ (ι_X' : U_K_sch ⟶ X'),
            ι_X' ≫ f_bl = ι_X ∧
            CategoryTheory.IsPullback ι_X' p_UK g_X'
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype))) ∧
      (∀ (x' : X') (V_sm : X.Opens),
        f_bl.base x' ∈ V_sm →
        f_bl.base x' ∈ U_iso →
        AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ g_X) →
        ∃ (V_sm' : X'.Opens),
          x' ∈ V_sm' ∧
          AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm'.ι ≫ g_X')) := by
    clear hFinMax hS1_iso hS1_lift hPkg hBl C_K p_K U_K n S
    intro X X' g_X g_X' f_bl U_iso hf_comm hIso
    let η_V := AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)
    let U'_iso : X'.Opens := f_bl ⁻¹ᵁ U_iso
    refine ⟨?_, ?_⟩
    · intro hGen_U U_K_sch p_UK ι_X hPb
      have hηV_bot : ∀ q : ↥(AlgebraicGeometry.Spec (CommRingCat.of K)),
          (η_V.base q).asIdeal = ⊥ := by
        intro q
        have hq_bot : q.asIdeal = ⊥ := by
          by_contra hne_bot
          obtain ⟨c, hc_mem, hc_ne⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hne_bot
          exact q.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem q.asIdeal hc_mem (IsUnit.mk0 c hc_ne))
        have hcomap : (η_V.base q).asIdeal = Ideal.comap V.subtype q.asIdeal := by
          rw [AlgebraicGeometry.Spec.map_apply (CommRingCat.ofHom V.subtype) q]
          rfl
        rw [hcomap, hq_bot]
        ext v
        simp only [Ideal.mem_comap, Ideal.mem_bot]
        exact ⟨fun hv => Subtype.ext hv, fun hv => by rw [hv]; rfl⟩
      have hRange_in_U : ∀ {T : AlgebraicGeometry.Scheme.{u}}
          (m_X : T ⟶ X) (m_K : T ⟶ AlgebraicGeometry.Spec (CommRingCat.of K)),
          m_X ≫ g_X = m_K ≫ η_V →
          Set.range m_X.base ⊆ Set.range U_iso.ι.base := by
        intro T m_X m_K hm_comm
        rw [show Set.range U_iso.ι.base = (U_iso : Set X) by simp]
        rintro _ ⟨t, rfl⟩
        apply hGen_U
        have hpt : g_X.base (m_X.base t) = η_V.base (m_K.base t) := by
          change (m_X ≫ g_X).base t = (m_K ≫ η_V).base t
          rw [hm_comm]
        rw [hpt]
        exact hηV_bot (m_K.base t)
      let ι_U : U_K_sch ⟶ U_iso.toScheme :=
        AlgebraicGeometry.IsOpenImmersion.lift U_iso.ι ι_X (hRange_in_U ι_X p_UK hPb.w)
      have hιU_fac : ι_U ≫ U_iso.ι = ι_X :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac U_iso.ι ι_X _
      let ι_X' : U_K_sch ⟶ X' :=
        ι_U ≫ CategoryTheory.inv (f_bl ∣_ U_iso) ≫ U'_iso.ι
      have hιX'_fbl : ι_X' ≫ f_bl = ι_X := by
        calc
          (ι_U ≫ CategoryTheory.inv (f_bl ∣_ U_iso) ≫ U'_iso.ι) ≫ f_bl =
              ι_U ≫ CategoryTheory.inv (f_bl ∣_ U_iso) ≫ ((f_bl ⁻¹ᵁ U_iso).ι ≫ f_bl) := by
            simp only [U'_iso, CategoryTheory.Category.assoc]
          _ = ι_U ≫ CategoryTheory.inv (f_bl ∣_ U_iso) ≫ ((f_bl ∣_ U_iso) ≫ U_iso.ι) := by
            rw [AlgebraicGeometry.morphismRestrict_ι]
          _ = ι_U ≫ U_iso.ι := by
            rw [CategoryTheory.IsIso.inv_hom_id_assoc]
          _ = ι_X := hιU_fac
      have hιX'_w : ι_X' ≫ g_X' = p_UK ≫ η_V := by
        rw [← hf_comm, ← CategoryTheory.Category.assoc, hιX'_fbl, hPb.w]
      refine ⟨ι_X', hιX'_fbl, CategoryTheory.IsPullback.of_isLimit
        (CategoryTheory.Limits.PullbackCone.IsLimit.mk hιX'_w ?_ ?_ ?_ ?_)⟩
      · intro s
        exact hPb.lift (s.fst ≫ f_bl) s.snd
          (by rw [CategoryTheory.Category.assoc, hf_comm, s.condition])
      · intro s
        let w := hPb.lift (s.fst ≫ f_bl) s.snd
          (by rw [CategoryTheory.Category.assoc, hf_comm, s.condition])
        have hw_fst : w ≫ ι_X = s.fst ≫ f_bl := hPb.lift_fst _ _ _
        have hs_range : Set.range s.fst.base ⊆ Set.range U'_iso.ι.base := by
          rw [show Set.range U'_iso.ι.base = (U'_iso : Set X') by simp]
          rintro _ ⟨t, rfl⟩
          have hmem := hRange_in_U (s.fst ≫ f_bl) s.snd
            (by rw [CategoryTheory.Category.assoc, hf_comm, s.condition]) ⟨t, rfl⟩
          rw [show Set.range U_iso.ι.base = (U_iso : Set X) by simp] at hmem
          exact hmem
        let a' : s.pt ⟶ U'_iso.toScheme :=
          AlgebraicGeometry.IsOpenImmersion.lift U'_iso.ι s.fst hs_range
        have ha'_fac : a' ≫ U'_iso.ι = s.fst :=
          AlgebraicGeometry.IsOpenImmersion.lift_fac U'_iso.ι s.fst hs_range
        have heq_sub : w ≫ ι_U ≫ CategoryTheory.inv (f_bl ∣_ U_iso) = a' := by
          apply (cancel_mono (f_bl ∣_ U_iso)).mp
          apply (cancel_mono U_iso.ι).mp
          calc
            ((w ≫ ι_U ≫ CategoryTheory.inv (f_bl ∣_ U_iso)) ≫ (f_bl ∣_ U_iso)) ≫ U_iso.ι =
                w ≫ (ι_U ≫ U_iso.ι) := by
              simp only [CategoryTheory.Category.assoc, CategoryTheory.IsIso.inv_hom_id_assoc]
            _ = w ≫ ι_X := by rw [hιU_fac]
            _ = s.fst ≫ f_bl := hw_fst
            _ = (a' ≫ U'_iso.ι) ≫ f_bl := by rw [ha'_fac]
            _ = a' ≫ ((f_bl ⁻¹ᵁ U_iso).ι ≫ f_bl) := by
              simp only [U'_iso, CategoryTheory.Category.assoc]
            _ = (a' ≫ (f_bl ∣_ U_iso)) ≫ U_iso.ι := by
              rw [← AlgebraicGeometry.morphismRestrict_ι, CategoryTheory.Category.assoc]
        calc
          w ≫ ι_X' = (w ≫ ι_U ≫ CategoryTheory.inv (f_bl ∣_ U_iso)) ≫ U'_iso.ι := by
            simp only [ι_X', CategoryTheory.Category.assoc]
          _ = a' ≫ U'_iso.ι := by rw [heq_sub]
          _ = s.fst := ha'_fac
      · intro s
        exact hPb.lift_snd _ _ _
      · intro s m₀ hm_fst hm_snd
        apply hPb.hom_ext
        · rw [hPb.lift_fst, ← hιX'_fbl, ← CategoryTheory.Category.assoc, hm_fst]
        · rw [hPb.lift_snd, hm_snd]
    · intro x' V_sm hx_V hx_U hSm_V
      let V₀ : X.Opens := V_sm ⊓ U_iso
      let V'_sm : X'.Opens := f_bl ⁻¹ᵁ V₀
      have hx'_mem : x' ∈ V'_sm := ⟨hx_V, hx_U⟩
      let j_X : V₀.toScheme ⟶ U_iso.toScheme := X.homOfLE inf_le_right
      let j_X' : V'_sm.toScheme ⟶ U'_iso.toScheme :=
        X'.homOfLE ((TopologicalSpace.Opens.map f_bl.base).monotone inf_le_right)
      have h_res_comm : (f_bl ∣_ V₀) ≫ j_X = j_X' ≫ (f_bl ∣_ U_iso) := by
        apply (cancel_mono U_iso.ι).mp
        calc
          ((f_bl ∣_ V₀) ≫ j_X) ≫ U_iso.ι = (f_bl ∣_ V₀) ≫ V₀.ι := by
            rw [CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.homOfLE_ι]
          _ = V'_sm.ι ≫ f_bl := AlgebraicGeometry.morphismRestrict_ι f_bl V₀
          _ = (j_X' ≫ U'_iso.ι) ≫ f_bl := by rw [AlgebraicGeometry.Scheme.homOfLE_ι]
          _ = j_X' ≫ ((f_bl ⁻¹ᵁ U_iso).ι ≫ f_bl) := by
            simp only [U'_iso, CategoryTheory.Category.assoc]
          _ = (j_X' ≫ (f_bl ∣_ U_iso)) ≫ U_iso.ι := by
            rw [← AlgebraicGeometry.morphismRestrict_ι, CategoryTheory.Category.assoc]
      have _ : AlgebraicGeometry.IsOpenImmersion ((f_bl ∣_ V₀) ≫ j_X) := by
        rw [h_res_comm]
        exact inferInstance
      have _ : AlgebraicGeometry.IsOpenImmersion (f_bl ∣_ V₀) :=
        AlgebraicGeometry.IsOpenImmersion.of_comp (f_bl ∣_ V₀) j_X
      let u_open : V'_sm.toScheme ⟶ V_sm.toScheme := (f_bl ∣_ V₀) ≫ X.homOfLE inf_le_left
      have _ : AlgebraicGeometry.IsOpenImmersion u_open := inferInstance
      have _ : AlgebraicGeometry.SmoothOfRelativeDimension 0 u_open := inferInstance
      have hv_eq : V'_sm.ι ≫ g_X' = u_open ≫ (V_sm.ι ≫ g_X) := by
        calc
          V'_sm.ι ≫ g_X' = ((f_bl ⁻¹ᵁ V₀).ι ≫ f_bl) ≫ g_X := by
            rw [← hf_comm, CategoryTheory.Category.assoc]
          _ = ((f_bl ∣_ V₀) ≫ V₀.ι) ≫ g_X := by
            rw [← AlgebraicGeometry.morphismRestrict_ι]
          _ = ((f_bl ∣_ V₀) ≫ X.homOfLE inf_le_left ≫ V_sm.ι) ≫ g_X := by
            rw [AlgebraicGeometry.Scheme.homOfLE_ι]
          _ = u_open ≫ (V_sm.ι ≫ g_X) := by
            simp only [u_open, CategoryTheory.Category.assoc]
      refine ⟨V'_sm, hx'_mem, ?_⟩
      rw [hv_eq]
      exact AlgebraicGeometry.smoothOfRelativeDimension_comp 0 1 u_open (V_sm.ι ≫ g_X)

  
  have hS3_poly : ∀ {R : Type u} [CommRing R] (X : AlgebraicGeometry.Scheme.{u})
      (g_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
      (W : X.Opens)
      (e : W.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial R))),
      AlgebraicGeometry.Etale e →
      W.ι ≫ g_X = e ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) →
      AlgebraicGeometry.SmoothOfRelativeDimension 1 (W.ι ≫ g_X) := by
    clear hFinMax hS1_iso hS1_lift hS2 hPkg hBl C_K p_K U_K n S V m
    intro R _ X g_X W e hEt he_comm
    let v_rel : PEmpty.{u + 1} → MvPolynomial PUnit.{u + 1} R := PEmpty.elim
    let P0 : Algebra.PreSubmersivePresentation R
        (MvPolynomial PUnit.{u + 1} R ⧸ Ideal.span (Set.range v_rel))
        PUnit.{u + 1} PEmpty.{u + 1} :=
      Algebra.PreSubmersivePresentation.naive PEmpty.elim (fun x => PEmpty.elim x)
    have hJac : IsUnit P0.jacobian := by
      rw [Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det]
      simp
    let P1 : Algebra.SubmersivePresentation R
        (MvPolynomial PUnit.{u + 1} R ⧸ Ideal.span (Set.range v_rel))
        PUnit.{u + 1} PEmpty.{u + 1} :=
      { P0 with jacobian_isUnit := hJac }
    have hDim : P1.dimension = 1 := by simp [Algebra.Presentation.dimension]
    have _ : Algebra.IsStandardSmoothOfRelativeDimension 1 R
        (MvPolynomial PUnit.{u + 1} R ⧸ Ideal.span (Set.range v_rel)) :=
      P1.isStandardSmoothOfRelativeDimension hDim
    have hBot : Ideal.span (Set.range v_rel) = ⊥ := by simp [v_rel]
    let eqvPoly := MvPolynomial.uniqueAlgEquiv R PUnit.{u + 1}
    let f_to : (MvPolynomial PUnit.{u + 1} R ⧸ Ideal.span (Set.range v_rel)) →ₐ[R] Polynomial R :=
      Ideal.Quotient.liftₐ (Ideal.span (Set.range v_rel)) eqvPoly.toAlgHom (by
        intro x hx
        rw [hBot, Ideal.mem_bot] at hx
        rw [hx, map_zero])
    let f_inv : Polynomial R →ₐ[R] (MvPolynomial PUnit.{u + 1} R ⧸ Ideal.span (Set.range v_rel)) :=
      (Ideal.Quotient.mkₐ R (Ideal.span (Set.range v_rel))).comp eqvPoly.symm.toAlgHom
    let e_alg : (MvPolynomial PUnit.{u + 1} R ⧸ Ideal.span (Set.range v_rel)) ≃ₐ[R] Polynomial R :=
      AlgEquiv.ofAlgHom f_to f_inv
        (by ext; simp [f_to, f_inv])
        (by
          apply Ideal.Quotient.algHom_ext
          ext i
          change f_inv (f_to (Ideal.Quotient.mk _ (MvPolynomial.X i))) =
            Ideal.Quotient.mk _ (MvPolynomial.X i)
          simp [f_to, f_inv])
    have hSmAlg : Algebra.IsStandardSmoothOfRelativeDimension 1 R (Polynomial R) :=
      Algebra.IsStandardSmoothOfRelativeDimension.of_algEquiv 1 e_alg
    have hSmHom : RingHom.IsStandardSmoothOfRelativeDimension 1
        (Polynomial.C : R →+* Polynomial R) :=
      (RingHom.isStandardSmoothOfRelativeDimension_algebraMap 1).mpr hSmAlg
    have _ : AlgebraicGeometry.SmoothOfRelativeDimension 1
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : R →+* Polynomial R))) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.SmoothOfRelativeDimension 1)).mpr
        (RingHom.locally_of RingHom.isStandardSmoothOfRelativeDimension_respectsIso
          (Polynomial.C : R →+* Polynomial R) hSmHom)
    have _ : AlgebraicGeometry.SmoothOfRelativeDimension 0 e := inferInstance
    rw [he_comm]
    exact AlgebraicGeometry.smoothOfRelativeDimension_comp 0 1 e
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : R →+* Polynomial R)))

  have hS3_nod : ∀ {R : Type u} [CommRing R] (X : AlgebraicGeometry.Scheme.{u})
      (g_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
      (W : X.Opens) (z : X) (hz : z ∈ W) (a : R)
      (e : W.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of
        (MvPolynomial (Fin 2) R ⧸ Ideal.span
          {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}))),
      AlgebraicGeometry.Etale e →
      W.ι ≫ g_X = e ≫ AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) →
      ¬ (∀ i : Fin 2, Ideal.Quotient.mk _ (MvPolynomial.X i) ∈ (e.base ⟨z, hz⟩).asIdeal) →
      ∃ (V_sm : X.Opens),
        z ∈ V_sm ∧
        AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ g_X) := by
    clear hFinMax hS1_iso hS1_lift hS2 hPkg hBl C_K p_K U_K n S V m
    intro R _ X g_X W z hz a e hEt he_comm hNotOrig
    let I_nod : @Ideal (MvPolynomial (Fin 2) R) CommRing.toCommSemiring.toSemiring :=
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}
    let A_nod := MvPolynomial (Fin 2) R ⧸ I_nod
    have hX0_case : ∀ (e₀ : W.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of A_nod)),
        AlgebraicGeometry.Etale e₀ →
        W.ι ≫ g_X = e₀ ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk I_nod).comp MvPolynomial.C)) →
        Ideal.Quotient.mk I_nod (MvPolynomial.X 0) ∉ (e₀.base ⟨z, hz⟩).asIdeal →
        ∃ (V_sm : X.Opens),
          z ∈ V_sm ∧
          AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ g_X) := by
      intro e₀ hEt₀ he₀_comm hu₀_not
      let u₀ : A_nod := Ideal.Quotient.mk I_nod (MvPolynomial.X 0)
      let L_nod := Localization.Away u₀
      let pX : Polynomial R := Polynomial.X
      let L_poly := Localization.Away pX
      let T : L_poly := algebraMap (Polynomial R) L_poly pX
      let T_inv : L_poly := IsLocalization.Away.invSelf (S := L_poly) pX
      have hTT : T * T_inv = 1 := IsLocalization.Away.mul_invSelf pX
      let U₀ : L_nod := algebraMap A_nod L_nod u₀
      let U₀_inv : L_nod := IsLocalization.Away.invSelf (S := L_nod) u₀
      have hUU : U₀ * U₀_inv = 1 := IsLocalization.Away.mul_invSelf u₀
      let φ_quot : A_nod →ₐ[R] L_poly :=
        Ideal.Quotient.liftₐ I_nod
          (MvPolynomial.aeval ![T, algebraMap R L_poly a * T_inv])
          (by
            intro p hp
            rw [Ideal.mem_span_singleton] at hp
            rcases hp with ⟨q, rfl⟩
            simp only [map_mul, map_sub, MvPolynomial.aeval_X, MvPolynomial.aeval_C,
              Matrix.cons_val_zero, Matrix.cons_val_one]
            have h0 : T * (algebraMap R L_poly a * T_inv) - algebraMap R L_poly a = 0 := by
              calc
                T * (algebraMap R L_poly a * T_inv) - algebraMap R L_poly a =
                    algebraMap R L_poly a * (T * T_inv) - algebraMap R L_poly a := by ring
                _ = 0 := by rw [hTT, mul_one, sub_self]
            rw [h0, zero_mul])
      have hφ_mk : ∀ p : MvPolynomial (Fin 2) R,
          φ_quot (Ideal.Quotient.mk I_nod p) =
            MvPolynomial.aeval ![T, algebraMap R L_poly a * T_inv] p :=
        fun p => Ideal.Quotient.lift_mk I_nod _ _
      have hφ_u0 : φ_quot.toRingHom u₀ = T := by
        change φ_quot (Ideal.Quotient.mk I_nod (MvPolynomial.X 0)) = T
        rw [hφ_mk, MvPolynomial.aeval_X, Matrix.cons_val_zero]
      have hUnit_T : IsUnit (φ_quot.toRingHom u₀) := by
        rw [hφ_u0]
        exact ⟨⟨T, T_inv, hTT, mul_comm T_inv T ▸ hTT⟩, rfl⟩
      let Φ_hom : L_nod →+* L_poly := IsLocalization.Away.lift u₀ hUnit_T
      have hΦ_hom_eq : ∀ x : A_nod, Φ_hom (algebraMap A_nod L_nod x) = φ_quot x :=
        IsLocalization.Away.lift_eq u₀ hUnit_T
      let ψ_poly : Polynomial R →ₐ[R] L_nod := Polynomial.aeval U₀
      have hψ_pX : ψ_poly.toRingHom pX = U₀ := by
        change Polynomial.aeval U₀ Polynomial.X = U₀
        exact Polynomial.aeval_X U₀
      have hUnit_U : IsUnit (ψ_poly.toRingHom pX) := by
        rw [hψ_pX]
        exact ⟨⟨U₀, U₀_inv, hUU, mul_comm U₀_inv U₀ ▸ hUU⟩, rfl⟩
      let Φ_inv : L_poly →+* L_nod :=
        IsLocalization.Away.lift pX hUnit_U
