      have _ : Algebra.EssFiniteType B_K F :=
        @Algebra.EssFiniteType.of_isLocalization B_K F _ _ _ (nonZeroDivisors B_K) hFrac_K
      have hEssFT : Algebra.EssFiniteType K F := Algebra.EssFiniteType.comp K B_K F
      let x₀_F : F := ψ_K.hom (g_K (MvPolynomial.X 0))
      let R₀_sub : Subalgebra K F := Algebra.adjoin K ({x₀_F} : Set F)
