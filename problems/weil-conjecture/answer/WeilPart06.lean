        _ = η_A2 (ι_a (s₁' * a_Rz)) * d₂_inv := by rw [← map_mul ι_a]
        _ = η_A2 (ι_a (b₁' * π₁')) * d₂_inv := by rw [hs₁a]
        _ = η_A2 (ι_a b₁' * d₂) * d₂_inv := by rw [map_mul ι_a]
        _ = η_A2 (ι_a b₁') * (η_A2 d₂ * d₂_inv) := by rw [map_mul η_A2, mul_assoc]
        _ = η_A2 (ι_a b₁') := by rw [hd₂_inv, mul_one]
    obtain ⟨ψ₂, _, hψ₂_C, hψ₂_X0, hψ₂_X1⟩ :=
