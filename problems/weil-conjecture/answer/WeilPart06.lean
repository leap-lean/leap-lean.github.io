            simp only [hmon_prod, map_mul, map_pow, hdeh_C, hdeh_Xa, hdeh_Xb, one_pow, mul_one]
          rw [hφ_mon, HomogeneousLocalization.val_mul, HomogeneousLocalization.val_pow,
            hφ_C, hφ_X, Localization.mk_pow, Localization.mk_mul,
            Localization.mk_eq_mk_iff, Localization.r_iff_exists]
          refine ⟨1, ?_⟩
          simp only [Submonoid.coe_one, SubmonoidClass.coe_pow, one_mul]
          have hpow : (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) R) ^ m =
