    have _ : Y₀.IsSeparated := AlgebraicGeometry.Scheme.IsSeparated.mk hSep_term
    have hBasis : ∀ x : ↥Y₀, ∃ V : Y₀.Opens, AlgebraicGeometry.IsAffineOpen V ∧ x ∈ V := by
      intro x
