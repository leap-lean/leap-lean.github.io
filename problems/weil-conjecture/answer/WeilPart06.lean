    intro H hH_cl hH_irred hLoc
    let H_closed : TopologicalSpace.Closeds ↥F := ⟨H, hH_cl⟩
    let I_H : F.IdealSheafData := AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal H_closed
    let H_sch : AlgebraicGeometry.Scheme.{u} := I_H.subscheme
    let ιH : H_sch ⟶ F := I_H.subschemeι
