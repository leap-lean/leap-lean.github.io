      exact Ideal.map_le_iff_le_comap.mpr ((hp_bot_min m hm_min.1.1 hmq).trans hm_le_QB)
    have hPbot_bot : P_bot = ⊥ := by
      apply le_antisymm _ bot_le
      have h1 : P_bot ≤ sInf {Q : Ideal D | Q.IsPrime} := le_sInf (fun Q hQ => hPbot_le_all Q hQ)
      rw [← nilradical_eq_sInf D, nilradical_eq_zero D] at h1
      exact h1
    have : (⊥ : Ideal D).IsPrime := hPbot_bot ▸ ‹P_bot.IsPrime›
    exact IsDomain.of_bot_isPrime D

  have h_s2 : ∀ (D : Type u) [CommRing D] [IsDomain D] (φ_D : Polynomial κ →+* D),
