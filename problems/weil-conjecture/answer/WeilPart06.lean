        (Polynomial.evalRingHom 0).comp σ₁_hom = (Polynomial.evalRingHom 0).comp ν₁ := by
    intro κ _ ρ_P hρ_π hρ_a'
    have hρ_a : ρ_P a_Rz = 0 := by
      rw [ha_Rz, map_mul, hρ_π, zero_mul]
    have hρ_b : ρ_P b₁' = 0 := by
      rw [hb₁', map_mul, hρ_a', mul_zero]
    have hρ_ts : ρ_P t_s * ρ_P s₁' = 1 := by
      rw [← map_mul, hts, map_one]
    let ρ_poly : R_z →+* Polynomial κ := Polynomial.C.comp ρ_P
    have hρp_a : ρ_poly a_Rz = 0 := by
      change Polynomial.C (ρ_P a_Rz) = 0
      rw [hρ_a, map_zero]
    have hρp_π : ρ_poly π₁' = 0 := by
      change Polynomial.C (ρ_P π₁') = 0
      rw [hρ_π, map_zero]
    have hρp_b : ρ_poly b₁' = 0 := by
      change Polynomial.C (ρ_P b₁') = 0
      rw [hρ_b, map_zero]
    obtain ⟨ε_A, hε_comp, hε_C, hε_X0, hε_X1⟩ :=
      nodal_lift_pkg a_Rz ρ_P 0 0 (by rw [zero_mul, hρ_a])
    obtain ⟨ν₀, _, hν₀_C, hν₀_X0, hν₀_X1⟩ :=
      nodal_lift_pkg π₁' ρ_poly 0 Polynomial.X (by rw [zero_mul, hρp_π])
    obtain ⟨σ₀_hom, _, hσ₀_C, hσ₀_X0, hσ₀_X1⟩ :=
      nodal_lift_pkg π₁' ρ_poly (Polynomial.C (ρ_P s₁') * Polynomial.X) 0
        (by rw [mul_zero, hρp_π])
    obtain ⟨ν₁, _, hν₁_C, hν₁_X0, hν₁_X1⟩ :=
      nodal_lift_pkg b₁' ρ_poly 0 Polynomial.X (by rw [zero_mul, hρp_b])
    obtain ⟨σ₁_hom, _, hσ₁_C, hσ₁_X0, hσ₁_X1⟩ :=
      nodal_lift_pkg b₁' ρ_poly Polynomial.X 0 (by rw [mul_zero, hρp_b])
    obtain ⟨τ_br1, hτ1_comp, hτ1_C, hτ1_X0, hτ1_X1⟩ :=
      nodal_lift_pkg a_Rz ρ_poly Polynomial.X 0 (by rw [mul_zero, hρp_a])
    obtain ⟨τ_br2, hτ2_comp, hτ2_C, hτ2_X0, hτ2_X1⟩ :=
      nodal_lift_pkg a_Rz ρ_poly 0 Polynomial.X (by rw [zero_mul, hρp_a])
    have hν₀_p : ν₀.comp p₀_hom = Polynomial.C.comp ε_A := by
      apply nodalHom_ext a_Rz
      · intro r
        change ν₀ (p₀_hom ((ι_nod a_Rz) r)) = Polynomial.C (ε_A ((ι_nod a_Rz) r))
        rw [hp₀_C r, hε_C r]
        exact hν₀_C r
      · rw [RingHom.comp_apply, RingHom.comp_apply, hp₀_X0, map_mul ν₀, hν₀_X0, mul_zero,
          hε_X0, map_zero]
      · rw [RingHom.comp_apply, RingHom.comp_apply, hp₀_X1, map_mul ν₀, hν₀_C b₁', hν₀_X1,
          hε_X1, map_zero]
        change Polynomial.C (ρ_P b₁') * Polynomial.X = 0
        rw [hρ_b, map_zero, zero_mul]
    have hν₁_p : ν₁.comp p₁_hom = Polynomial.C.comp ε_A := by
      apply nodalHom_ext a_Rz
      · intro r
        change ν₁ (p₁_hom ((ι_nod a_Rz) r)) = Polynomial.C (ε_A ((ι_nod a_Rz) r))
        rw [hp₁_C r, hε_C r]
        exact hν₁_C r
      · rw [RingHom.comp_apply, RingHom.comp_apply, hp₁_X0, map_mul ν₁,
          hν₁_C (t_s * π₁'), hν₁_X1, hε_X0, map_zero]
        change Polynomial.C (ρ_P (t_s * π₁')) * Polynomial.X = 0
        rw [map_mul ρ_P, hρ_π, mul_zero, map_zero, zero_mul]
      · rw [RingHom.comp_apply, RingHom.comp_apply, hp₁_X1, hν₁_X0, hε_X1, map_zero]
    have hτ1_ev : (Polynomial.evalRingHom 0).comp τ_br1 = ε_A := by
      apply nodalHom_ext a_Rz
      · intro r
        rw [RingHom.comp_apply, hτ1_C r, hε_C r]
        change (Polynomial.evalRingHom (0 : κ)) (Polynomial.C (ρ_P r)) = ρ_P r
        simp
      · rw [RingHom.comp_apply, hτ1_X0, hε_X0]
        simp
      · rw [RingHom.comp_apply, hτ1_X1, hε_X1, map_zero]
    have hτ1_univ : ∀ (D : Type u) [CommRing D] (ι_κ : κ →+* D) (φ_D : A_loc →+* D),
        φ_D.comp ι_a = ι_κ.comp ρ_P →
        RingHom.ker τ_br1 ≤ RingHom.ker φ_D →
        (Polynomial.eval₂RingHom ι_κ (φ_D u₀)).comp τ_br1 = φ_D := by
      intro D _ ι_κ φ_D hφ_C hker
      have hu₁_ker : φ_D u₁ = 0 :=
        RingHom.mem_ker.mp (hker (RingHom.mem_ker.mpr hτ1_X1))
      apply nodalHom_ext a_Rz
      · intro r
        rw [RingHom.comp_apply, hτ1_C r]
        change (Polynomial.eval₂RingHom ι_κ (φ_D u₀)) (Polynomial.C (ρ_P r)) = φ_D (ι_a r)
        rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
        exact (RingHom.congr_fun hφ_C r).symm
      · change (Polynomial.eval₂RingHom ι_κ (φ_D u₀))
          (τ_br1 ((mk_nod a_Rz) (MvPolynomial.X 0))) = φ_D u₀
        rw [hτ1_X0, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
      · rw [RingHom.comp_apply, hτ1_X1, map_zero, hu₁_ker]
    have hσ0_p : σ₀_hom.comp p₀_hom = τ_br1 := by
      apply nodalHom_ext a_Rz
      · intro r
        rw [RingHom.comp_apply, hp₀_C r, hσ₀_C r, hτ1_C r]
      · rw [RingHom.comp_apply, hp₀_X0, map_mul σ₀_hom, hσ₀_C t_s, hσ₀_X0, hτ1_X0]
        change Polynomial.C (ρ_P t_s) * (Polynomial.C (ρ_P s₁') * Polynomial.X) = Polynomial.X
        rw [← mul_assoc, ← Polynomial.C.map_mul, hρ_ts, Polynomial.C.map_one, one_mul]
      · rw [RingHom.comp_apply, hp₀_X1, map_mul σ₀_hom, hσ₀_X1, mul_zero, hτ1_X1]
    have hσ0_ev : (Polynomial.evalRingHom 0).comp σ₀_hom = (Polynomial.evalRingHom 0).comp ν₀ := by
      apply nodalHom_ext π₁'
      · intro r
        change (Polynomial.evalRingHom 0) (σ₀_hom ((ι_nod π₁') r)) =
          (Polynomial.evalRingHom 0) (ν₀ ((ι_nod π₁') r))
        rw [hσ₀_C r, hν₀_C r]
      · rw [RingHom.comp_apply, RingHom.comp_apply, hσ₀_X0, hν₀_X0, map_zero]
        simp
      · rw [RingHom.comp_apply, RingHom.comp_apply, hσ₀_X1, hν₀_X1, map_zero]
        simp
    have hτ2_ev : (Polynomial.evalRingHom 0).comp τ_br2 = ε_A := by
      apply nodalHom_ext a_Rz
      · intro r
        rw [RingHom.comp_apply, hτ2_C r, hε_C r]
        change (Polynomial.evalRingHom (0 : κ)) (Polynomial.C (ρ_P r)) = ρ_P r
        simp
      · rw [RingHom.comp_apply, hτ2_X0, hε_X0, map_zero]
      · rw [RingHom.comp_apply, hτ2_X1, hε_X1]
        simp
    have hτ2_univ : ∀ (D : Type u) [CommRing D] (ι_κ : κ →+* D) (φ_D : A_loc →+* D),
        φ_D.comp ι_a = ι_κ.comp ρ_P →
        RingHom.ker τ_br2 ≤ RingHom.ker φ_D →
        (Polynomial.eval₂RingHom ι_κ (φ_D u₁)).comp τ_br2 = φ_D := by
      intro D _ ι_κ φ_D hφ_C hker
      have hu₀_ker : φ_D u₀ = 0 :=
        RingHom.mem_ker.mp (hker (RingHom.mem_ker.mpr hτ2_X0))
      apply nodalHom_ext a_Rz
      · intro r
        rw [RingHom.comp_apply, hτ2_C r]
        change (Polynomial.eval₂RingHom ι_κ (φ_D u₁)) (Polynomial.C (ρ_P r)) = φ_D (ι_a r)
        rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
        exact (RingHom.congr_fun hφ_C r).symm
      · rw [RingHom.comp_apply, hτ2_X0, map_zero, hu₀_ker]
      · change (Polynomial.eval₂RingHom ι_κ (φ_D u₁))
          (τ_br2 ((mk_nod a_Rz) (MvPolynomial.X 1))) = φ_D u₁
        rw [hτ2_X1, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
    have hσ1_p : σ₁_hom.comp p₁_hom = τ_br2 := by
      apply nodalHom_ext a_Rz
      · intro r
        rw [RingHom.comp_apply, hp₁_C r, hσ₁_C r, hτ2_C r]
      · rw [RingHom.comp_apply, hp₁_X0, map_mul σ₁_hom, hσ₁_X1, mul_zero, hτ2_X0]
      · rw [RingHom.comp_apply, hp₁_X1, hσ₁_X0, hτ2_X1]
    have hσ1_ev : (Polynomial.evalRingHom 0).comp σ₁_hom = (Polynomial.evalRingHom 0).comp ν₁ := by
      apply nodalHom_ext b₁'
      · intro r
        change (Polynomial.evalRingHom 0) (σ₁_hom ((ι_nod b₁') r)) =
          (Polynomial.evalRingHom 0) (ν₁ ((ι_nod b₁') r))
        rw [hσ₁_C r, hν₁_C r]
      · rw [RingHom.comp_apply, RingHom.comp_apply, hσ₁_X0, hν₁_X0, map_zero]
        simp
      · rw [RingHom.comp_apply, RingHom.comp_apply, hσ₁_X1, hν₁_X1, map_zero]
        simp
    exact ⟨ε_A, ν₀, σ₀_hom, ν₁, σ₁_hom, τ_br1, τ_br2,
      hε_comp, hε_X0, hε_X1,
      hν₀_p, hν₀_X1, hν₁_p, hν₁_X1,
      hτ1_comp, hτ1_X0, hτ1_ev, hτ1_univ, hσ0_p, hσ0_ev,
      hτ2_comp, hτ2_X1, hτ2_ev, hτ2_univ, hσ1_p, hσ1_ev⟩
  exact ⟨p₀_hom, p₁_hom, f₀₁_hom, f₁₀_hom,
    ⟨hp₀_comp, hp₁_comp, hf₀₁_comp, hf₁₀_comp⟩,
    ⟨hp₀_sX0, hp₀_X1_eq, hp₁_sX0, hp₁_X1, hf₁₀_X0, hf₁₀_X1⟩,
    ⟨hloc₀₁, hloc₁₀, hcomp₀₁, hgen₀, hgen₁, hinv₀₁⟩,
    ⟨⟨hd₀_mem, hd₀_loc⟩, ⟨hd₁_mem, hd₁_loc⟩, ⟨hd₂_mem, hd₂_loc⟩, ⟨hd₃_mem, hd₃_loc⟩⟩,
    hBranch⟩

theorem weil_twoChart_glued_projLine_closedImmersion_and_basicOpen_iso (A C₀ C₁ C₀₁ : Type u) [CommRing A] [CommRing C₀] [CommRing C₁] [CommRing C₀₁]
    (p₀_hom : A →+* C₀) (p₁_hom : A →+* C₁)
    (g₀ : C₀) (g₁ : C₁)
    (f₀₁_hom : C₀ →+* C₀₁) (f₁₀_hom : C₁ →+* C₀₁)
    (hloc₀ : @IsLocalization.Away C₀ _ g₀ C₀₁ _ f₀₁_hom.toAlgebra)
    (hloc₁ : @IsLocalization.Away C₁ _ g₁ C₀₁ _ f₁₀_hom.toAlgebra)
    (hcomp : f₀₁_hom.comp p₀_hom = f₁₀_hom.comp p₁_hom)
    (hgen₀ : Subring.closure (Set.range p₀_hom ∪ {g₀}) = ⊤)
    (hgen₁ : Subring.closure (Set.range p₁_hom ∪ {g₁}) = ⊤)
    (hinv : f₁₀_hom g₁ * f₀₁_hom g₀ = 1)
    (hAff_A : ∀ a : Fin (1 + 1), AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen A 1 a))
    (c_A : ∀ a : Fin (1 + 1),
      A →+* ↑((weilProjectiveSpaceOver A 1).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen A 1 a))))
    (t_A : ∀ a : Fin (1 + 1), Fin (1 + 1) →
      ↑((weilProjectiveSpaceOver A 1).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen A 1 a))))
    (hSys_A : IsCommRingProjCoordSystem A 1 hAff_A c_A t_A) :
    ∃ (M : AlgebraicGeometry.Scheme.{u})
      (p_M : M ⟶ AlgebraicGeometry.Spec (CommRingCat.of A))
      (ι₀ : AlgebraicGeometry.Spec (CommRingCat.of C₀) ⟶ M)
      (ι₁ : AlgebraicGeometry.Spec (CommRingCat.of C₁) ⟶ M)
      (ι_M : M ⟶ (weilProjectiveSpaceOver A 1).left)
      (ψ₀ : ↑((weilProjectiveSpaceOver A 1).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen A 1 0))) →+* C₀)
      (ψ₁ : ↑((weilProjectiveSpaceOver A 1).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen A 1 1))) →+* C₁),
      AlgebraicGeometry.IsOpenImmersion ι₀ ∧
      AlgebraicGeometry.IsOpenImmersion ι₁ ∧
      (∀ y : M, y ∈ Set.range ι₀.base ∨ y ∈ Set.range ι₁.base) ∧
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₀₁_hom) ≫ ι₀ =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₁₀_hom) ≫ ι₁ ∧
      ι₀ ≫ p_M = AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₀_hom) ∧
      ι₁ ≫ p_M = AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₁_hom) ∧
      AlgebraicGeometry.IsClosedImmersion ι_M ∧
      AlgebraicGeometry.IsProper p_M ∧
      ι_M ≫ (weilProjectiveSpaceOver A 1).hom = p_M ∧
      ψ₀.comp (c_A 0) = p₀_hom ∧
      ψ₀ (t_A 0 1) = g₀ ∧
      ψ₁.comp (c_A 1) = p₁_hom ∧
      ψ₁ (t_A 1 0) = g₁ ∧
      ι₀ ≫ ι_M = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀) ≫ (hAff_A 0).fromSpec ∧
      ι₁ ≫ ι_M = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁) ≫ (hAff_A 1).fromSpec ∧
      (((TopologicalSpace.Opens.map ι_M.base).obj
          (weilProjBasicOpen A 1 0 ⊓ weilProjBasicOpen A 1 1) : M.Opens) : Set M) =
        Set.range (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₁₀_hom) ≫ ι₁).base ∧
      (∀ (d : A),
        (∀ q : PrimeSpectrum C₁, p₁_hom d ∉ q.asIdeal → g₁ ∉ q.asIdeal) →
        @IsLocalization.Away A _ d (Localization.Away (p₀_hom d)) _
          ((algebraMap C₀ _).comp p₀_hom).toAlgebra →
        CategoryTheory.IsIso (p_M ∣_ PrimeSpectrum.basicOpen d)) ∧
      (∀ (I_center : Ideal A) (d₀ d₁ d₂ : A),
        I_center = Ideal.span {d₀, d₁} ⊔ Ideal.span {d₂} →
        (∀ q : PrimeSpectrum C₁, p₁_hom d₀ ∉ q.asIdeal → g₁ ∉ q.asIdeal) →
        @IsLocalization.Away A _ d₀ (Localization.Away (p₀_hom d₀)) _
          ((algebraMap C₀ _).comp p₀_hom).toAlgebra →
        (∀ q : PrimeSpectrum C₀, p₀_hom d₁ ∉ q.asIdeal → g₀ ∉ q.asIdeal) →
        @IsLocalization.Away A _ d₁ (Localization.Away (p₁_hom d₁)) _
          ((algebraMap C₁ _).comp p₁_hom).toAlgebra →
        (∀ q : PrimeSpectrum C₀, p₀_hom d₂ ∉ q.asIdeal → g₀ ∉ q.asIdeal) →
        @IsLocalization.Away A _ d₂ (Localization.Away (p₁_hom d₂)) _
          ((algebraMap C₁ _).comp p₁_hom).toAlgebra →
        CategoryTheory.IsIso
          (p_M ∣_ ⟨(PrimeSpectrum.zeroLocus (I_center : Set A))ᶜ,
            (PrimeSpectrum.isClosed_zeroLocus (I_center : Set A)).isOpen_compl⟩)) :=
by
  
  
  
  let U₀ : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of C₀)
  let U₁ : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of C₁)
  let W : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of C₀₁)
  let f₀₁ : W ⟶ U₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₀₁_hom)
  let f₁₀ : W ⟶ U₁ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₁₀_hom)
  have hOpen_f₀₁ : AlgebraicGeometry.IsOpenImmersion f₀₁ := by
    let _ : Algebra C₀ C₀₁ := f₀₁_hom.toAlgebra
    have _ : IsLocalization.Away g₀ C₀₁ := hloc₀
    exact AlgebraicGeometry.IsOpenImmersion.of_isLocalization g₀
  have hOpen_f₁₀ : AlgebraicGeometry.IsOpenImmersion f₁₀ := by
    let _ : Algebra C₁ C₀₁ := f₁₀_hom.toAlgebra
    have _ : IsLocalization.Away g₁ C₀₁ := hloc₁
    exact AlgebraicGeometry.IsOpenImmersion.of_isLocalization g₁
  have hMono_f₀₁ : CategoryTheory.Mono f₀₁ := inferInstance
  have hMono_f₁₀ : CategoryTheory.Mono f₁₀ := inferInstance
  have hHasPb : ∀ {X Y Z : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Z) (g : Y ⟶ Z),
      CategoryTheory.Limits.HasPullback f g := fun _ _ => inferInstance
  have hHasMC : ∀ (D_gen : AlgebraicGeometry.Scheme.GlueData.{u}),
      CategoryTheory.Limits.HasMulticoequalizer D_gen.diagram := fun _ => inferInstance
  have hOpenEqToHom : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (e : X = Y),
      AlgebraicGeometry.IsOpenImmersion (CategoryTheory.eqToHom e) := by
    rintro X _ rfl
    rw [CategoryTheory.eqToHom_refl]
    exact inferInstance
  have hGluePkg :
      ∃ (M : AlgebraicGeometry.Scheme.{u})
        (ι₀ : U₀ ⟶ M) (ι₁ : U₁ ⟶ M),
        AlgebraicGeometry.IsOpenImmersion ι₀ ∧
        AlgebraicGeometry.IsOpenImmersion ι₁ ∧
        (∀ y : M, y ∈ Set.range ι₀.base ∨ y ∈ Set.range ι₁.base) ∧
        f₀₁ ≫ ι₀ = f₁₀ ≫ ι₁ ∧
        (∀ (Z : AlgebraicGeometry.Scheme.{u}) (h₀ : U₀ ⟶ Z) (h₁ : U₁ ⟶ Z),
          f₀₁ ≫ h₀ = f₁₀ ≫ h₁ → ∃ h : M ⟶ Z, ι₀ ≫ h = h₀ ∧ ι₁ ≫ h = h₁) ∧
        (∀ (Z : AlgebraicGeometry.Scheme.{u}) (h h' : M ⟶ Z),
          ι₀ ≫ h = ι₀ ≫ h' → ι₁ ≫ h = ι₁ ≫ h' → h = h') := by
    let J := ULift.{u} Bool
    let i₀ : J := ⟨false⟩
    let i₁ : J := ⟨true⟩
    have h₀₁ : i₀ ≠ i₁ := by decide
    have h₁₀ : i₁ ≠ i₀ := by decide
    let U_chart : J → AlgebraicGeometry.Scheme.{u} := fun i => Bool.rec U₀ U₁ i.down
    let V_chart : ∀ i j : J, i ≠ j → AlgebraicGeometry.Scheme.{u} := fun _ _ _ => W
    let f_chart : ∀ i j : J, (hij : i ≠ j) → V_chart i j hij ⟶ U_chart i :=
      ULift.rec (fun b₁ => Bool.rec
        (ULift.rec (fun b₂ => Bool.rec (fun h => absurd rfl h) (fun _ => f₀₁) b₂))
        (ULift.rec (fun b₂ => Bool.rec (fun _ => f₁₀) (fun h => absurd rfl h) b₂))
        b₁)
    let t_chart : ∀ i j : J, (hij : i ≠ j) → V_chart i j hij ⟶ V_chart j i hij.symm :=
      fun _ _ _ => 𝟙 W
    let D' : CategoryTheory.GlueData' AlgebraicGeometry.Scheme.{u} :=
      { J := J
        U := U_chart
        V := V_chart
        f := f_chart
        f_mono := by
          rintro ⟨_ | _⟩ ⟨_ | _⟩ hij
          · exact absurd rfl hij
          · exact hMono_f₀₁
          · exact hMono_f₁₀
          · exact absurd rfl hij
        f_hasPullback := fun _ _ _ _ _ => hHasPb _ _
        t := t_chart
        t' := by rintro ⟨_ | _⟩ ⟨_ | _⟩ ⟨_ | _⟩ hij hik hjk <;> contradiction
        t_fac := by rintro ⟨_ | _⟩ ⟨_ | _⟩ ⟨_ | _⟩ hij hik hjk <;> contradiction
        t_inv := fun _ _ _ => CategoryTheory.Category.id_comp (𝟙 W)
        cocycle := by rintro ⟨_ | _⟩ ⟨_ | _⟩ ⟨_ | _⟩ hij hik hjk <;> contradiction }
    let D₀ : CategoryTheory.GlueData AlgebraicGeometry.Scheme.{u} :=
      CategoryTheory.GlueData.ofGlueData' D'
    have hOpen_all : ∀ i j : J, AlgebraicGeometry.IsOpenImmersion (D₀.f i j) := by
      intro i j
      by_cases h : i = j
      · subst h
        have _ : CategoryTheory.IsIso (D₀.f i i) := D₀.f_id i
        exact inferInstance
      · have e_ij : D₀.V (i, j) = W := @dite_eq_right _ (Classical.propDecidable _) h _ _ _
        have hf_raw : D₀.f i j = CategoryTheory.eqToHom e_ij ≫ D'.f i j h :=
          @dite_eq_right _ (Classical.propDecidable _) h _ _ _
        rw [hf_raw]
        have hOpen_fij : AlgebraicGeometry.IsOpenImmersion (D'.f i j h) := by
          rcases i with ⟨_ | _⟩ <;> rcases j with ⟨_ | _⟩
          · exact absurd rfl h
          · exact hOpen_f₀₁
          · exact hOpen_f₁₀
          · exact absurd rfl h
        exact CategoryTheory.MorphismProperty.comp_mem
          (@AlgebraicGeometry.IsOpenImmersion) _ _ (hOpenEqToHom e_ij) hOpen_fij
    let D : AlgebraicGeometry.Scheme.GlueData.{u} :=
      AlgebraicGeometry.Scheme.GlueData.mk D₀ hOpen_all
    have _ : CategoryTheory.Limits.HasMulticoequalizer D.diagram := hHasMC D
    let M : AlgebraicGeometry.Scheme.{u} := D.glued
    let ι₀ : U₀ ⟶ M := D.ι i₀
    let ι₁ : U₁ ⟶ M := D.ι i₁
    have e₀₁_symm : D.V (i₀, i₁) = W :=
      @dite_eq_right _ (Classical.propDecidable _) h₀₁ _ _ _
    have e₁₀_symm : D.V (i₁, i₀) = W :=
      @dite_eq_right _ (Classical.propDecidable _) h₁₀ _ _ _
    have e₀₁ : W = D.V (i₀, i₁) := e₀₁_symm.symm
    have e₁₀ : W = D.V (i₁, i₀) := e₁₀_symm.symm
    have hf₀₁_raw : D.f i₀ i₁ = CategoryTheory.eqToHom e₀₁.symm ≫ f₀₁ :=
      @dite_eq_right _ (Classical.propDecidable _) h₀₁ _ _ _
    have hf₁₀_raw : D.f i₁ i₀ = CategoryTheory.eqToHom e₁₀.symm ≫ f₁₀ :=
      @dite_eq_right _ (Classical.propDecidable _) h₁₀ _ _ _
    have ht₀₁_raw :
        D.t i₀ i₁ = CategoryTheory.eqToHom e₀₁.symm ≫ 𝟙 W ≫ CategoryTheory.eqToHom e₁₀ :=
      @dite_eq_right _ (Classical.propDecidable _) h₀₁ _ _ _
    have ht₁₀_raw :
        D.t i₁ i₀ = CategoryTheory.eqToHom e₁₀.symm ≫ 𝟙 W ≫ CategoryTheory.eqToHom e₀₁ :=
      @dite_eq_right _ (Classical.propDecidable _) h₁₀ _ _ _
    have hf₀₁_eq : CategoryTheory.eqToHom e₀₁ ≫ D.f i₀ i₁ = f₀₁ := by
      erw [hf₀₁_raw, CategoryTheory.eqToHom_trans_assoc, CategoryTheory.eqToHom_refl,
        CategoryTheory.Category.id_comp]
    have hf₁₀_eq : CategoryTheory.eqToHom e₁₀ ≫ D.f i₁ i₀ = f₁₀ := by
      erw [hf₁₀_raw, CategoryTheory.eqToHom_trans_assoc, CategoryTheory.eqToHom_refl,
        CategoryTheory.Category.id_comp]
    have ht₀₁_eq : CategoryTheory.eqToHom e₀₁ ≫ D.t i₀ i₁ = CategoryTheory.eqToHom e₁₀ := by
      erw [ht₀₁_raw, CategoryTheory.eqToHom_trans_assoc, CategoryTheory.eqToHom_refl,
        CategoryTheory.Category.id_comp, CategoryTheory.Category.id_comp]
    have ht₁₀_eq : CategoryTheory.eqToHom e₁₀ ≫ D.t i₁ i₀ = CategoryTheory.eqToHom e₀₁ := by
      erw [ht₁₀_raw, CategoryTheory.eqToHom_trans_assoc, CategoryTheory.eqToHom_refl,
        CategoryTheory.Category.id_comp, CategoryTheory.Category.id_comp]
    refine ⟨M, ι₀, ι₁, D.ι_isOpenImmersion i₀, D.ι_isOpenImmersion i₁, ?_, ?_, ?_, ?_⟩
    · intro y
      have hy := D.openCover.covers y
      rcases idx : D.openCover.idx y with ⟨_ | _⟩
      · rw [idx] at hy
        exact Or.inl hy
      · rw [idx] at hy
        exact Or.inr hy
    · have hgc := CategoryTheory.eqToHom e₀₁ ≫= D.glue_condition i₀ i₁
      erw [← CategoryTheory.Category.assoc, ht₀₁_eq, ← CategoryTheory.Category.assoc, hf₁₀_eq,
        ← CategoryTheory.Category.assoc, hf₀₁_eq] at hgc
      exact hgc.symm
    · intro Z h₀ h₁ hh
      let k : ∀ i : D.J, D.U i ⟶ Z := ULift.rec (fun b => Bool.rec h₀ h₁ b)
      have hk : ∀ p : D.J × D.J,
          D.diagram.fst p ≫ k p.1 = D.diagram.snd p ≫ k p.2 := by
        rintro ⟨i, j⟩
        rw [D.toGlueData.diagram_fst, D.toGlueData.diagram_snd]
        by_cases hij : i = j
        · subst hij
          rw [D.toGlueData.t_id, CategoryTheory.Category.id_comp]
          rfl
        · rcases i with ⟨_ | _⟩ <;> rcases j with ⟨_ | _⟩
          · exact absurd rfl hij
          · apply (CategoryTheory.cancel_epi (CategoryTheory.eqToHom e₀₁)).mp
            have hL : CategoryTheory.eqToHom e₀₁ ≫ D.f i₀ i₁ ≫ k i₀ = f₀₁ ≫ h₀ := by
              erw [← CategoryTheory.Category.assoc, hf₀₁_eq]
              rfl
            have hR : CategoryTheory.eqToHom e₀₁ ≫ (D.t i₀ i₁ ≫ D.f i₁ i₀) ≫ k i₁ =
                f₁₀ ≫ h₁ := by
              erw [← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc, ht₀₁_eq,
                CategoryTheory.Category.assoc,
                ← CategoryTheory.Category.assoc (CategoryTheory.eqToHom e₁₀), hf₁₀_eq]
              rfl
            exact hL.trans (hh.trans hR.symm)
          · apply (CategoryTheory.cancel_epi (CategoryTheory.eqToHom e₁₀)).mp
            have hL : CategoryTheory.eqToHom e₁₀ ≫ D.f i₁ i₀ ≫ k i₁ = f₁₀ ≫ h₁ := by
              erw [← CategoryTheory.Category.assoc, hf₁₀_eq]
              rfl
            have hR : CategoryTheory.eqToHom e₁₀ ≫ (D.t i₁ i₀ ≫ D.f i₀ i₁) ≫ k i₀ =
                f₀₁ ≫ h₀ := by
              erw [← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc, ht₁₀_eq,
                CategoryTheory.Category.assoc,
                ← CategoryTheory.Category.assoc (CategoryTheory.eqToHom e₀₁), hf₀₁_eq]
              rfl
            exact hL.trans (hh.symm.trans hR.symm)
          · exact absurd rfl hij
      refine ⟨CategoryTheory.Limits.Multicoequalizer.desc D.diagram Z k hk, ?_, ?_⟩
      · exact CategoryTheory.Limits.Multicoequalizer.π_desc D.diagram Z k hk i₀
      · exact CategoryTheory.Limits.Multicoequalizer.π_desc D.diagram Z k hk i₁
    · intro Z h h' hh₀ hh₁
      apply CategoryTheory.Limits.Multicoequalizer.hom_ext D.diagram h h'
      rintro ⟨_ | _⟩
      · exact hh₀
      · exact hh₁
  obtain ⟨M, ι₀, ι₁, hOpen₀, hOpen₁, hCov, hGlue, hDesc, hExt⟩ := hGluePkg
  have _ : AlgebraicGeometry.IsOpenImmersion ι₀ := hOpen₀
  have _ : AlgebraicGeometry.IsOpenImmersion ι₁ := hOpen₁
  let p₀ : U₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of A) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₀_hom)
  let p₁ : U₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of A) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₁_hom)
  have hp_compat : f₀₁ ≫ p₀ = f₁₀ ≫ p₁ := by
    dsimp only [f₀₁, f₁₀, p₀, p₁]
    rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hcomp]
  obtain ⟨p_M, hp₀, hp₁⟩ := hDesc (AlgebraicGeometry.Spec (CommRingCat.of A)) p₀ p₁ hp_compat

  
  
  
  obtain ⟨hProp_P₁, hCov_P₁, hc_comm, _hθ, ht_diag, ht_gen, ht_eval, ht_basic,
    hc_ov, ht_cocycle⟩ := hSys_A
  let P₁ : AlgebraicGeometry.Scheme.{u} := (weilProjectiveSpaceOver A 1).left
  let p_P₁ : P₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of A) :=
    (weilProjectiveSpaceOver A 1).hom
  let D : Fin (1 + 1) → P₁.Opens := weilProjBasicOpen A 1
  let R₀ := ↑(P₁.presheaf.obj (Opposite.op (D 0)))
  let R₁ := ↑(P₁.presheaf.obj (Opposite.op (D 1)))
  obtain ⟨ψ₀, hψ₀_c, hψ₀_t⟩ := ht_eval 0 C₀ p₀_hom ![1, g₀] rfl
  obtain ⟨ψ₁, hψ₁_c, hψ₁_t⟩ := ht_eval 1 C₁ p₁_hom ![g₁, 1] rfl
  have hψ₀_t1 : ψ₀ (t_A 0 1) = g₀ := hψ₀_t 1
  have hψ₁_t0 : ψ₁ (t_A 1 0) = g₁ := hψ₁_t 0
  have hSurj₀ : Function.Surjective ψ₀ := by
    have hle : (⊤ : Subring C₀) ≤ ψ₀.range := by
      rw [← hgen₀]
      refine Subring.closure_le.mpr ?_
      rintro x (⟨a, rfl⟩ | hx)
      · refine ⟨c_A 0 a, ?_⟩
        change (ψ₀.comp (c_A 0)) a = p₀_hom a
        rw [hψ₀_c]
      · rcases Set.mem_singleton_iff.mp hx with rfl
        exact ⟨t_A 0 1, hψ₀_t1⟩
    intro x
    exact hle trivial
  have hSurj₁ : Function.Surjective ψ₁ := by
    have hle : (⊤ : Subring C₁) ≤ ψ₁.range := by
      rw [← hgen₁]
      refine Subring.closure_le.mpr ?_
      rintro x (⟨a, rfl⟩ | hx)
      · refine ⟨c_A 1 a, ?_⟩
        change (ψ₁.comp (c_A 1)) a = p₁_hom a
        rw [hψ₁_c]
      · rcases Set.mem_singleton_iff.mp hx with rfl
        exact ⟨t_A 1 0, hψ₁_t0⟩
    intro x
    exact hle trivial

  let j₀ : U₀ ⟶ P₁ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀) ≫ (hAff_A 0).fromSpec
  let j₁ : U₁ ⟶ P₁ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁) ≫ (hAff_A 1).fromSpec
  have hj_compat : f₀₁ ≫ j₀ = f₁₀ ≫ j₁ := by
    let D₀₁ : P₁.Opens := D 0 ⊓ D 1
    let R₀₁ := ↑(P₁.presheaf.obj (Opposite.op D₀₁))
    let i_le₀ : D₀₁ ⟶ D 0 := CategoryTheory.homOfLE inf_le_left
    let i_le₁ : D₀₁ ⟶ D 1 := CategoryTheory.homOfLE inf_le_right
    let res₀_cat := P₁.presheaf.map i_le₀.op
    let res₁_cat := P₁.presheaf.map i_le₁.op
    let res₀ : R₀ →+* R₀₁ := res₀_cat.hom
    let res₁ : R₁ →+* R₀₁ := res₁_cat.hom
    have hD₀₁_0 : D₀₁ = P₁.basicOpen (t_A 0 1) := (ht_basic 0 1).symm
    have hD₀₁_1 : D₀₁ = P₁.basicOpen (t_A 1 0) := by
      change D 0 ⊓ D 1 = P₁.basicOpen (t_A 1 0)
      rw [inf_comm, ← ht_basic 1 0]
    have hAff₀₁ : AlgebraicGeometry.IsAffineOpen D₀₁ :=
      hD₀₁_0 ▸ (hAff_A 0).basicOpen (t_A 0 1)
    have hUnit₀ : IsUnit ((f₀₁_hom.comp ψ₀) (t_A 0 1)) := by
      change IsUnit (f₀₁_hom (ψ₀ (t_A 0 1)))
      rw [hψ₀_t1]
      exact IsUnit.of_mul_eq_one_right (f₁₀_hom g₁) hinv
    have hUnit₁ : IsUnit ((f₁₀_hom.comp ψ₁) (t_A 1 0)) := by
      change IsUnit (f₁₀_hom (ψ₁ (t_A 1 0)))
      rw [hψ₁_t0]
      exact IsUnit.of_mul_eq_one (f₀₁_hom g₀) hinv
    have hLam₀ : ∃ lam₀ : R₀₁ →+* C₀₁, lam₀.comp res₀ = f₀₁_hom.comp ψ₀ := by
      let _ : Algebra R₀ R₀₁ := res₀.toAlgebra
      have _ : IsLocalization.Away (t_A 0 1) R₀₁ :=
        (hAff_A 0).isLocalization_of_eq_basicOpen (t_A 0 1) i_le₀ hD₀₁_0
      exact ⟨IsLocalization.Away.lift (t_A 0 1) hUnit₀,
        RingHom.ext fun x => IsLocalization.Away.lift_eq (t_A 0 1) hUnit₀ x⟩
    have hLam₁ : ∃ lam₁ : R₀₁ →+* C₀₁, lam₁.comp res₁ = f₁₀_hom.comp ψ₁ := by
      let _ : Algebra R₁ R₀₁ := res₁.toAlgebra
      have _ : IsLocalization.Away (t_A 1 0) R₀₁ :=
        (hAff_A 1).isLocalization_of_eq_basicOpen (t_A 1 0) i_le₁ hD₀₁_1
      exact ⟨IsLocalization.Away.lift (t_A 1 0) hUnit₁,
        RingHom.ext fun x => IsLocalization.Away.lift_eq (t_A 1 0) hUnit₁ x⟩
    obtain ⟨lam₀, hlam₀⟩ := hLam₀
    obtain ⟨lam₁, hlam₁⟩ := hLam₁
    have hlam_eq : lam₀ = lam₁ := by
      let _ : Algebra R₀ R₀₁ := res₀.toAlgebra
      have _ : IsLocalization.Away (t_A 0 1) R₀₁ :=
        (hAff_A 0).isLocalization_of_eq_basicOpen (t_A 0 1) i_le₀ hD₀₁_0
      apply IsLocalization.ringHom_ext (Submonoid.powers (t_A 0 1))
      change lam₀.comp res₀ = lam₁.comp res₀
      have hLocus : (⊤ : Subring R₀) ≤ RingHom.eqLocus (lam₀.comp res₀) (lam₁.comp res₀) := by
        rw [← ht_gen 0]
        refine Subring.closure_le.mpr ?_
        rintro x (⟨a, rfl⟩ | ⟨b, rfl⟩)
        · show (lam₀.comp res₀) (c_A 0 a) = (lam₁.comp res₀) (c_A 0 a)
          have h1 : (lam₀.comp res₀) (c_A 0 a) = (f₀₁_hom.comp p₀_hom) a := by
            rw [hlam₀]
            change f₀₁_hom ((ψ₀.comp (c_A 0)) a) = f₀₁_hom (p₀_hom a)
            rw [hψ₀_c]
          have h2 : (lam₁.comp res₀) (c_A 0 a) = (f₁₀_hom.comp p₁_hom) a := by
            change lam₁ (res₀ (c_A 0 a)) = _
            have hov : res₀ (c_A 0 a) = res₁ (c_A 1 a) := (hc_ov 0 1 a).symm
            rw [hov]
            change (lam₁.comp res₁) (c_A 1 a) = _
            rw [hlam₁]
            change f₁₀_hom ((ψ₁.comp (c_A 1)) a) = f₁₀_hom (p₁_hom a)
            rw [hψ₁_c]
          rw [h1, h2, hcomp]
        · show (lam₀.comp res₀) (t_A 0 b) = (lam₁.comp res₀) (t_A 0 b)
          fin_cases b
          · change (lam₀.comp res₀) (t_A 0 0) = (lam₁.comp res₀) (t_A 0 0)
            rw [ht_diag 0, map_one, map_one]
          · change (lam₀.comp res₀) (t_A 0 1) = (lam₁.comp res₀) (t_A 0 1)
            have h_lhs : (lam₀.comp res₀) (t_A 0 1) = f₀₁_hom g₀ := by
              rw [hlam₀]
              change f₀₁_hom (ψ₀ (t_A 0 1)) = f₀₁_hom g₀
              rw [hψ₀_t1]
            have h_coc : res₁ (t_A 1 0) * res₀ (t_A 0 1) = 1 := by
              have hc := ht_cocycle 0 1 0
              rw [ht_diag 0, map_one] at hc
              exact hc
            have h_prod : f₁₀_hom g₁ * lam₁ (res₀ (t_A 0 1)) = 1 := by
              have hm := congrArg lam₁ h_coc
              rw [map_mul, map_one] at hm
              have hl1 : lam₁ (res₁ (t_A 1 0)) = f₁₀_hom g₁ := by
                change (lam₁.comp res₁) (t_A 1 0) = f₁₀_hom g₁
                rw [hlam₁]
                change f₁₀_hom (ψ₁ (t_A 1 0)) = f₁₀_hom g₁
                rw [hψ₁_t0]
              rwa [hl1] at hm
            rw [h_lhs]
            change f₀₁_hom g₀ = lam₁ (res₀ (t_A 0 1))
            calc
              f₀₁_hom g₀ = f₀₁_hom g₀ * 1 := (mul_one _).symm
              _ = f₀₁_hom g₀ * (f₁₀_hom g₁ * lam₁ (res₀ (t_A 0 1))) := by rw [h_prod]
              _ = (f₁₀_hom g₁ * f₀₁_hom g₀) * lam₁ (res₀ (t_A 0 1)) := by ring
              _ = 1 * lam₁ (res₀ (t_A 0 1)) := by rw [hinv]
              _ = lam₁ (res₀ (t_A 0 1)) := one_mul _
      ext x
      exact hLocus trivial
    let lam₀_cat := CommRingCat.ofHom lam₀
    let lam₁_cat := CommRingCat.ofHom lam₁
    have hcat0 : res₀_cat ≫ lam₀_cat = CommRingCat.ofHom ψ₀ ≫ CommRingCat.ofHom f₀₁_hom := by
      ext x
      exact RingHom.congr_fun hlam₀ x
    have hcat1 : res₁_cat ≫ lam₁_cat = CommRingCat.ofHom ψ₁ ≫ CommRingCat.ofHom f₁₀_hom := by
      ext x
      exact RingHom.congr_fun hlam₁ x
    have hmap0 : f₀₁ ≫ j₀ = AlgebraicGeometry.Spec.map lam₀_cat ≫ hAff₀₁.fromSpec := by
      dsimp only [f₀₁, j₀]
      rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp, ← hcat0,
        AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc,
        (hAff_A 0).map_fromSpec hAff₀₁ i_le₀.op]
    have hmap1 : f₁₀ ≫ j₁ = AlgebraicGeometry.Spec.map lam₁_cat ≫ hAff₀₁.fromSpec := by
      dsimp only [f₁₀, j₁]
      rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp, ← hcat1,
        AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc,
        (hAff_A 1).map_fromSpec hAff₀₁ i_le₁.op]
    have hlam_cat_eq : lam₀_cat = lam₁_cat := congrArg CommRingCat.ofHom hlam_eq
    rw [hmap0, hmap1, hlam_cat_eq]

  obtain ⟨ι_M, hι₀_M, hι₁_M⟩ := hDesc P₁ j₀ j₁ hj_compat
  have hιM_p : ι_M ≫ p_P₁ = p_M := by
    apply hExt (AlgebraicGeometry.Spec (CommRingCat.of A)) (ι_M ≫ p_P₁) p_M
    · rw [← CategoryTheory.Category.assoc, hι₀_M]
      dsimp only [j₀, p_P₁, p₀] at *
      rw [CategoryTheory.Category.assoc, ← hc_comm 0, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, hψ₀_c, hp₀]
    · rw [← CategoryTheory.Category.assoc, hι₁_M]
      dsimp only [j₁, p_P₁, p₁] at *
      rw [CategoryTheory.Category.assoc, ← hc_comm 1, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, hψ₁_c, hp₁]

  let U_M : Fin (1 + 1) → M.Opens :=
    fun a => (TopologicalSpace.Opens.map ι_M.base).obj (D a)
  have hEq₀ : ι₀.opensRange = U_M 0 := by
    ext y
    change y ∈ (ι₀.opensRange : Set M) ↔ ι_M.base y ∈ D 0
    rw [ι₀.coe_opensRange]
    constructor
    · rintro ⟨x₀, rfl⟩
      have hjx : ι_M.base (ι₀.base x₀) = j₀.base x₀ := by
        change (ι₀ ≫ ι_M).base x₀ = j₀.base x₀
        rw [hι₀_M]
      rw [hjx]
      have hmem : j₀.base x₀ ∈ Set.range (hAff_A 0).fromSpec.base :=
        ⟨(AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀)).base x₀, rfl⟩
      rwa [(hAff_A 0).range_fromSpec] at hmem
    · intro hy0
      rcases hCov y with hy | ⟨x₁, rfl⟩
      · exact hy
      · have hjx₁ : j₁.base x₁ = ι_M.base (ι₁.base x₁) := by
          change j₁.base x₁ = (ι₁ ≫ ι_M).base x₁
          rw [hι₁_M]
        have hmem1 : j₁.base x₁ ∈ (D 1 : Set P₁) := by
          rw [← (hAff_A 1).range_fromSpec]
          exact ⟨(AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁)).base x₁, rfl⟩
        have hmem10 : j₁.base x₁ ∈ P₁.basicOpen (t_A 1 0) := by
          rw [ht_basic 1 0]
          exact ⟨hmem1, hjx₁.symm ▸ hy0⟩
        have hpre10 :
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁)).base x₁ ∈
              (TopologicalSpace.Opens.map (hAff_A 1).fromSpec.base).obj
                (P₁.basicOpen (t_A 1 0)) := hmem10
        rw [(hAff_A 1).fromSpec_preimage_basicOpen (t_A 1 0)] at hpre10
        have hg₁_not : g₁ ∉ x₁.asIdeal := by
          have ht_not : t_A 1 0 ∉
              ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁)).base x₁).asIdeal := hpre10
          rw [AlgebraicGeometry.Spec.map_base] at ht_not
          change ψ₁ (t_A 1 0) ∉ x₁.asIdeal at ht_not
          rwa [hψ₁_t0] at ht_not
        have hx₁_range : x₁ ∈ Set.range f₁₀.base := by
          let _ : Algebra C₁ C₀₁ := f₁₀_hom.toAlgebra
          have _ : IsLocalization.Away g₁ C₀₁ := hloc₁
          have hmem_ps : (x₁ : PrimeSpectrum C₁) ∈
              Set.range (PrimeSpectrum.comap (algebraMap C₁ C₀₁)) := by
            rw [PrimeSpectrum.localization_away_comap_range C₀₁ g₁]
            exact hg₁_not
          exact hmem_ps
        obtain ⟨w, rfl⟩ := hx₁_range
        have hgw : ι₁.base (f₁₀.base w) = ι₀.base (f₀₁.base w) := by
          change (f₁₀ ≫ ι₁).base w = (f₀₁ ≫ ι₀).base w
          rw [hGlue]
        rw [hgw]
        exact ⟨f₀₁.base w, rfl⟩

  have hEq₁ : ι₁.opensRange = U_M 1 := by
    ext y
    change y ∈ (ι₁.opensRange : Set M) ↔ ι_M.base y ∈ D 1
    rw [ι₁.coe_opensRange]
    constructor
    · rintro ⟨x₁, rfl⟩
