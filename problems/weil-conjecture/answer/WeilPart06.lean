      exact Ideal.comap_isMaximal_of_surjective mk_bar Ideal.Quotient.mk_surjective
    refine ⟨hTwo, fun Z hZ_cl hZ_ne => ?_⟩
    obtain ⟨I, rfl⟩ := (PrimeSpectrum.isClosed_iff_zeroLocus_ideal Z).mp hZ_cl
    have hI_ne : I ≠ ⊥ := by
      intro hI_bot
