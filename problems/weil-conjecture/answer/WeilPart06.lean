        let R_loc := eOrd.symm ⟨r, hr, hDisj⟩
        have hBotLe : (⟨⊥, hBotPrime⟩ : {Q : Ideal (Localization.AtPrime q_pt.asIdeal) // Q.IsPrime}) ≤ R_loc :=
