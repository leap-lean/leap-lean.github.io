        calc η_Z ≫ g_Z = (η_UK ≫ ι_Z) ≫ g_Z := by rw [hηUK_Z]
          _ = η_UK ≫ (ι_Z ≫ g_Z) := Category.assoc _ _ _
          _ = η_UK ≫ ((U_K.ι ≫ p_K) ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)) := by
              rw [hPb_Z.w]
          _ = (η_UK ≫ U_K.ι ≫ p_K) ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype) := by
              simp [Category.assoc]
      have h_pre : AlgebraicGeometry.Spec.preimage (η_Z ≫ g_Z) =
          CommRingCat.ofHom V.subtype ≫ AlgebraicGeometry.Spec.preimage (η_UK ≫ U_K.ι ≫ p_K) := by
        rw [h_comm_η, AlgebraicGeometry.Spec.preimage_comp, AlgebraicGeometry.Spec.preimage_map]
      exact (congrArg (fun f => f.hom c) h_pre).symm
    have hSm_UK : AlgebraicGeometry.SmoothOfRelativeDimension 1 (U_K.ι ≫ p_K) := by
      have _ : AlgebraicGeometry.SmoothOfRelativeDimension 0 U_K.ι := inferInstance
      have _ : AlgebraicGeometry.SmoothOfRelativeDimension 1 p_K := hSmCK
      have h01 : AlgebraicGeometry.SmoothOfRelativeDimension (0 + 1) (U_K.ι ≫ p_K) := inferInstance
      simpa using h01
    obtain ⟨U_sp, hU_sp, V_sm, hV_sm, hx₀_Vsm, he_sm, hStdSm⟩ :=
      (AlgebraicGeometry.smoothOfRelativeDimension_iff 1 (U_K.ι ≫ p_K)).mp hSm_UK x₀_UK
    have hU_sp_top : U_sp = ⊤ := by
      ext z
      simp only [TopologicalSpace.Opens.coe_top, Set.mem_univ, iff_true]
      have hz_eq : z = (U_K.ι ≫ p_K).base x₀_UK := by
        apply PrimeSpectrum.ext
        rw [@Ideal.eq_bot_of_prime _ _ z.asIdeal z.2,
          @Ideal.eq_bot_of_prime _ _ ((U_K.ι ≫ p_K).base x₀_UK).asIdeal
