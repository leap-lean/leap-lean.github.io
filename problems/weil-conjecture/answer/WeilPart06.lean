      have hw_id : IsIdempotentElem w := by
        change w * w = w
        have h1 : u₁ * u₁ = u₁ := hu₁
        have h2 : u₂ * u₂ = u₂ := hu₂
        calc
          (u₁ * (1 - u₂)) * (u₁ * (1 - u₂))
          _ = (u₁ * u₁) * (1 - 2 * u₂ + u₂ * u₂) := by ring
          _ = u₁ * (1 - 2 * u₂ + u₂) := by rw [h1, h2]
          _ = u₁ * (1 - u₂) := by ring
      have hw_nil : w ∈ nilradical Bbar₀₁ := by
        rw [PrimeSpectrum.nilradical_eq_iInf, Ideal.mem_iInf]
        intro q
        by_contra hw_not
        have hu₁_not : u₁ ∉ q.asIdeal := fun h => hw_not (q.asIdeal.mul_mem_right _ h)
        have h1u₂_not : 1 - u₂ ∉ q.asIdeal := fun h => hw_not (q.asIdeal.mul_mem_left _ h)
        have hu₂_not : u₂ ∉ q.asIdeal := hsub q hu₁_not
        have hprod0 : u₂ * (1 - u₂) ∈ q.asIdeal := by
          have h2 : u₂ * u₂ = u₂ := hu₂
          have heq : u₂ * (1 - u₂) = 0 := by
            calc
              u₂ * (1 - u₂) = u₂ - u₂ * u₂ := by ring
              _ = u₂ - u₂ := by rw [h2]
              _ = 0 := sub_self _
          rw [heq]; exact q.asIdeal.zero_mem
        rcases q.isPrime.mul_mem_iff_mem_or_mem.mp hprod0 with h | h
        · exact hu₂_not h
        · exact h1u₂_not h
      obtain ⟨n, hn⟩ := hw_nil
      cases n with
      | zero =>
        rw [pow_zero] at hn
        calc
          w = w * 1 := (mul_one w).symm
          _ = w * 0 := by rw [hn]
          _ = 0 := mul_zero w
      | succ m =>
        rw [hw_id.pow_succ_eq m] at hn
        exact hn
