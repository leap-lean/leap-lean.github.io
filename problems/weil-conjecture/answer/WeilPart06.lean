        rw [hp₀_tsπ, ← hp₀u₀_π', map_mul η_C₀,
          mul_comm (η_C₀ (p₀_hom u₀)) (η_C₀ π'), mul_assoc,
          IsLocalization.Away.mul_invSelf (S := M₀) (p₀_hom u₀), mul_one]
  
  have hd₁_loc :
      @IsLocalization.Away A_loc _ u₁ (Localization.Away (p₁_hom u₁)) _
        ((algebraMap C₁ _).comp p₁_hom).toAlgebra := by
    let L_u₁ := Localization.Away u₁
    let η_A1 : A_loc →+* L_u₁ := algebraMap A_loc L_u₁
    let u₁_inv : L_u₁ := IsLocalization.Away.invSelf (S := L_u₁) u₁
    have hu₁_inv : η_A1 u₁ * u₁_inv = 1 :=
      IsLocalization.Away.mul_invSelf (S := L_u₁) u₁
