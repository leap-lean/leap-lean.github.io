    intro D _ _ φ_D hEt
    letI : Algebra (Polynomial κ) D := φ_D.toAlgebra
    have : Algebra.Etale (Polynomial κ) D := hEt
    letI : Algebra κ D := (φ_D.comp Polynomial.C).toAlgebra
    have : IsScalarTower κ (Polynomial κ) D := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    have : Algebra.FiniteType (Polynomial κ) D := inferInstance
    have : IsNoetherianRing D := Algebra.FiniteType.isNoetherianRing (Polynomial κ) D
    have : Algebra.FiniteType κ (Polynomial κ) :=
      ⟨{Polynomial.X}, by
        rw [Finset.coe_singleton, Algebra.adjoin_singleton_eq_range_aeval, AlgHom.range_eq_top]
        intro P
        exact ⟨P, Polynomial.aeval_X_left_apply P⟩⟩
    have : Algebra.FiniteType κ D := Algebra.FiniteType.trans ‹_› ‹_›
    have hNull : ∀ (M : Ideal D) [M.IsMaximal], Function.Bijective (algebraMap κ (D ⧸ M)) := by
      intro M _
      obtain ⟨n, f_mv, hf_surj⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp ‹Algebra.FiniteType κ D›
      let π_M : MvPolynomial (Fin n) κ →ₐ[κ] (D ⧸ M) := (Ideal.Quotient.mkₐ κ M).comp f_mv
      have hπ_surj : Function.Surjective π_M := Ideal.Quotient.mk_surjective.comp hf_surj
      letI : Field (D ⧸ M) := Ideal.Quotient.field M
      let I_M : Ideal (MvPolynomial (Fin n) κ) := RingHom.ker π_M.toRingHom
      have : I_M.IsMaximal := by
        refine ⟨⟨fun h1 => ?_, fun J hJ => ?_⟩⟩
        · have hmem : (1 : MvPolynomial (Fin n) κ) ∈ I_M := h1 ▸ Submodule.mem_top
          have hmem' : π_M 1 = 0 := hmem
          rw [map_one] at hmem'
