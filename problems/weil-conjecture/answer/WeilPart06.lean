        let L_i := Localization.Away (xbR i)
        let L_T := Localization.Away (Polynomial.X : Polynomial R)
        let t : L_T := algebraMap (Polynomial R) L_T Polynomial.X
        let t_inv : L_T := IsLocalization.Away.invSelf (S := L_T) (Polynomial.X : Polynomial R)
        have ht_mul : t * t_inv = 1 :=
          IsLocalization.Away.mul_invSelf (S := L_T) (Polynomial.X : Polynomial R)
        let u : L_i := algebraMap A_R L_i (xbR i)
        let u_inv : L_i := IsLocalization.Away.invSelf (S := L_i) (xbR i)
        have hu_mul : u * u_inv = 1 :=
          IsLocalization.Away.mul_invSelf (S := L_i) (xbR i)
        let α_tilde : MvPolynomial (Fin 2) R →ₐ[R] L_T :=
          MvPolynomial.aeval (fun k : Fin 2 => if k = i then t else algebraMap R L_T a₀ * t_inv)
        have h_ker : ∀ p ∈ I_R, α_tilde p = 0 := by
          intro p hp
          have hle : I_R ≤ RingHom.ker α_tilde.toRingHom := by
            rw [Ideal.span_singleton_le_iff_mem]
            change α_tilde (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a₀) = 0
            fin_cases i <;> simp [α_tilde]
            · calc
                t * (algebraMap R L_T a₀ * t_inv) - algebraMap R L_T a₀
                  = algebraMap R L_T a₀ * (t * t_inv) - algebraMap R L_T a₀ := by ring
                _ = 0 := by rw [ht_mul, mul_one, sub_self]
            · calc
                algebraMap R L_T a₀ * t_inv * t - algebraMap R L_T a₀
                  = algebraMap R L_T a₀ * (t * t_inv) - algebraMap R L_T a₀ := by ring
                _ = 0 := by rw [ht_mul, mul_one, sub_self]
          exact hle hp
        let α_bar : A_R →ₐ[R] L_T := Ideal.Quotient.liftₐ I_R α_tilde h_ker
        have hα_bar_x : ∀ k : Fin 2,
            α_bar (xbR k) = (if k = i then t else algebraMap R L_T a₀ * t_inv) := by
          intro k
          change α_tilde (MvPolynomial.X k) = _
          simp [α_tilde]
        have ht_unit : IsUnit t := IsUnit.of_mul_eq_one t_inv ht_mul
        have h_units_i : ∀ z : Submonoid.powers (xbR i), IsUnit (α_bar.toRingHom z) := by
          rintro ⟨_, n, rfl⟩
          simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, map_pow, hα_bar_x, ↓reduceIte]
          exact ht_unit.pow n
        let Φ : L_i →ₐ[R] L_T :=
          IsLocalization.liftAlgHom (M := Submonoid.powers (xbR i)) (S := L_i) (f := α_bar)
            h_units_i
        let β_bar : Polynomial R →ₐ[R] L_i := Polynomial.aeval u
        have hu_unit : IsUnit u := IsUnit.of_mul_eq_one u_inv hu_mul
        have h_units_T : ∀ z : Submonoid.powers (Polynomial.X : Polynomial R),
            IsUnit (β_bar.toRingHom z) := by
          rintro ⟨_, n, rfl⟩
          simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, map_pow, β_bar, Polynomial.aeval_X]
          exact hu_unit.pow n
        let Ψ : L_T →ₐ[R] L_i :=
          IsLocalization.liftAlgHom
            (M := Submonoid.powers (Polynomial.X : Polynomial R)) (S := L_T) (f := β_bar)
            h_units_T
        have hΦ_u : Φ u = t := by
          change IsLocalization.lift h_units_i (algebraMap A_R L_i (xbR i)) = t
          rw [IsLocalization.lift_eq]
          simpa using hα_bar_x i
        have hΨ_t : Ψ t = u := by
          change IsLocalization.lift h_units_T (algebraMap (Polynomial R) L_T Polynomial.X) = u
          rw [IsLocalization.lift_eq]
          simp [β_bar]
        have hΨ_tinv : Ψ t_inv = u_inv := by
          have h1 : u * Ψ t_inv = 1 := by
            rw [← hΨ_t, ← map_mul, ht_mul, map_one]
          calc
            Ψ t_inv = (u_inv * u) * Ψ t_inv := by rw [mul_comm u_inv u, hu_mul, one_mul]
            _ = u_inv * (u * Ψ t_inv) := by ring
            _ = u_inv := by rw [h1, mul_one]
        have h_comp1 : Φ.comp Ψ = AlgHom.id R L_T := by
          apply IsLocalization.algHom_ext (Submonoid.powers (Polynomial.X : Polynomial R))
          apply Polynomial.algHom_ext
          change Φ (Ψ t) = t
          rw [hΨ_t, hΦ_u]
        have h_comp2 : Ψ.comp Φ = AlgHom.id R L_i := by
          apply IsLocalization.algHom_ext (Submonoid.powers (xbR i))
          ext z
          obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective z
          revert p
          suffices ((Ψ.comp Φ).comp (IsScalarTower.toAlgHom R A_R L_i)).comp
              (Ideal.Quotient.mkₐ R I_R) =
              ((AlgHom.id R L_i).comp (IsScalarTower.toAlgHom R A_R L_i)).comp
              (Ideal.Quotient.mkₐ R I_R) by
            intro p
            exact AlgHom.congr_fun this p
          apply MvPolynomial.algHom_ext
          intro k
          simp only [AlgHom.comp_apply, IsScalarTower.toAlgHom_apply, AlgHom.id_apply]
          change Ψ (IsLocalization.lift h_units_i (algebraMap A_R L_i (xbR k))) =
            algebraMap A_R L_i (xbR k)
          rw [IsLocalization.lift_eq]
          change Ψ (α_bar (xbR k)) = algebraMap A_R L_i (xbR k)
          rw [hα_bar_x]
          by_cases hk : k = i
          · subst hk
            simpa using hΨ_t
          · simp only [hk, ↓reduceIte, map_mul, AlgHom.commutes, hΨ_tinv]
            have h_prod : u * algebraMap A_R L_i (xbR k) = algebraMap R L_i a₀ := by
              change algebraMap A_R L_i (xbR i) * algebraMap A_R L_i (xbR k) =
                algebraMap R L_i a₀
              rw [← map_mul, IsScalarTower.algebraMap_apply R A_R L_i]
              congr 1
              fin_cases i <;> fin_cases k
              · exact absurd rfl hk
              · exact hxb01
              · rw [mul_comm]; exact hxb01
              · exact absurd rfl hk
            calc
              algebraMap R L_i a₀ * u_inv = (u * algebraMap A_R L_i (xbR k)) * u_inv := by
                rw [h_prod]
              _ = algebraMap A_R L_i (xbR k) * (u * u_inv) := by ring
              _ = algebraMap A_R L_i (xbR k) := by rw [hu_mul, mul_one]
        let e_loc : L_i ≃ₐ[R] L_T := AlgEquiv.ofAlgHom Φ Ψ h_comp1 h_comp2
        have hStd_LT : Algebra.IsStandardSmoothOfRelativeDimension 1 R L_T := by
          have : Algebra.IsStandardSmoothOfRelativeDimension 1 R (Polynomial R) :=
            poly_stdSmooth1 R
          have : Algebra.IsStandardSmoothOfRelativeDimension 0 (Polynomial R) L_T :=
            Algebra.IsStandardSmoothOfRelativeDimension.localization_away Polynomial.X
          have h := Algebra.IsStandardSmoothOfRelativeDimension.trans 1 0 R (Polynomial R) L_T
          simpa using h
        have hStd_Li : Algebra.IsStandardSmoothOfRelativeDimension 1 R L_i :=
          Algebra.IsStandardSmoothOfRelativeDimension.of_algEquiv 1 e_loc.symm
        have hSm_Li : AlgebraicGeometry.SmoothOfRelativeDimension 1
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R L_i))) :=
          smooth_spec_of_stdSmooth1 R L_i hStd_Li
        let ι_loc : AlgebraicGeometry.Spec (CommRingCat.of L_i) ⟶
            AlgebraicGeometry.Spec (CommRingCat.of A_R) :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A_R L_i))
        have : AlgebraicGeometry.IsOpenImmersion ι_loc :=
          AlgebraicGeometry.IsOpenImmersion.of_isLocalization (xbR i)
        have : AlgebraicGeometry.IsOpenImmersion (CategoryTheory.Limits.pullback.fst e₀ ι_loc) :=
          CategoryTheory.MorphismProperty.pullback_fst e₀ ι_loc inferInstance
        let j_V := CategoryTheory.Limits.pullback.fst e₀ ι_loc ≫ W₀.ι
        have : AlgebraicGeometry.IsOpenImmersion j_V := inferInstance
        have hq : qR ∈ Set.range ι_loc.base := by
          rw [AlgebraicGeometry.Spec.map_base]
          change qR ∈ Set.range (PrimeSpectrum.comap (algebraMap A_R L_i))
          rw [PrimeSpectrum.localization_away_comap_range L_i (xbR i)]
          exact hx_not
        obtain ⟨z_loc, hz_loc⟩ := hq
        obtain ⟨p₀, hp₀, _⟩ :=
          AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback wR z_loc hz_loc.symm
        let W_sm : C₀.Opens := j_V.opensRange
        have hx_mem : x₀ ∈ W_sm := by
          change W₀.ι.base wR ∈ Set.range j_V.base
          refine ⟨p₀, ?_⟩
          simp [j_V, hp₀]
        have hrange : Set.range j_V.base = Set.range W_sm.ι.base := by
          simp [W_sm]
        let iso_W : CategoryTheory.Limits.pullback e₀ ι_loc ≅ W_sm.toScheme :=
          AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq j_V W_sm.ι hrange
        have hfac_W : iso_W.inv ≫ j_V = W_sm.ι :=
          AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_inv_fac j_V W_sm.ι hrange
        have hfac_g : W_sm.ι ≫ g₀ =
            iso_W.inv ≫ CategoryTheory.Limits.pullback.snd e₀ ι_loc ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R L_i)) := by
          have hloc_comp : ι_loc ≫ AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap R A_R)) =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R L_i)) := by
            rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
              ← IsScalarTower.algebraMap_eq R A_R L_i]
          calc
            W_sm.ι ≫ g₀ = (iso_W.inv ≫ j_V) ≫ g₀ := by rw [hfac_W]
            _ = iso_W.inv ≫ CategoryTheory.Limits.pullback.fst e₀ ι_loc ≫ (W₀.ι ≫ g₀) := by
              simp [j_V, Category.assoc]
            _ = iso_W.inv ≫ (CategoryTheory.Limits.pullback.fst e₀ ι_loc ≫ e₀) ≫
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R A_R)) := by
              rw [hcomm₀']
              simp [Category.assoc]
            _ = iso_W.inv ≫ (CategoryTheory.Limits.pullback.snd e₀ ι_loc ≫ ι_loc) ≫
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R A_R)) := by
              rw [CategoryTheory.Limits.pullback.condition]
            _ = iso_W.inv ≫ CategoryTheory.Limits.pullback.snd e₀ ι_loc ≫
                  (ι_loc ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R A_R))) := by
              simp [Category.assoc]
            _ = iso_W.inv ≫ CategoryTheory.Limits.pullback.snd e₀ ι_loc ≫
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R L_i)) := by
              rw [hloc_comp]
        have : AlgebraicGeometry.Etale e₀ := he₀
        have : AlgebraicGeometry.Etale (CategoryTheory.Limits.pullback.snd e₀ ι_loc) :=
          CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
            (CategoryTheory.IsPullback.of_hasPullback e₀ ι_loc) inferInstance
        have : AlgebraicGeometry.SmoothOfRelativeDimension 0
            (CategoryTheory.Limits.pullback.snd e₀ ι_loc) := inferInstance
        have : AlgebraicGeometry.IsOpenImmersion iso_W.inv :=
          AlgebraicGeometry.IsOpenImmersion.of_isIso _
        have : AlgebraicGeometry.SmoothOfRelativeDimension 0 iso_W.inv := inferInstance
        have hSm_snd_Li : AlgebraicGeometry.SmoothOfRelativeDimension 1
            (CategoryTheory.Limits.pullback.snd e₀ ι_loc ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R L_i))) := by
          have h := AlgebraicGeometry.smoothOfRelativeDimension_comp 0 1
            (CategoryTheory.Limits.pullback.snd e₀ ι_loc)
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R L_i)))
          simpa using h
        have hSm_Wsm : AlgebraicGeometry.SmoothOfRelativeDimension 1 (W_sm.ι ≫ g₀) := by
          rw [hfac_g]
          have h := AlgebraicGeometry.smoothOfRelativeDimension_comp 0 1 iso_W.inv
            (CategoryTheory.Limits.pullback.snd e₀ ι_loc ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R L_i)))
          simpa using h
        exact ⟨W_sm, hx_mem, hSm_Wsm⟩
      obtain ⟨W_sm, hx_mem, hSm_Wsm⟩ :=
        smooth_branch_of_commRing ↥V C_semi g_semi W a x hx e i₀ he hcomm hx_not_mem
      exact Or.inl (pullback_smooth_open W_sm hx_mem hSm_Wsm)

theorem weil_height_one_valuation_projective_curve_connected_special_fiber (R : Type u) [CommRing R] [IsDomain R] [ValuationRing R]
    (hMaxNeBot : IsLocalRing.maximalIdeal R ≠ ⊥)
    (hHtOne : ∀ (P : Ideal R) [P.IsPrime], P = ⊥ ∨ P = IsLocalRing.maximalIdeal R)
    (hAlgClosedRes : IsAlgClosed (IsLocalRing.maximalIdeal R).ResidueField)
    (N : ℕ)
    (Y : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsIntegral Y]
    (p : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
    [AlgebraicGeometry.IsProper p] [AlgebraicGeometry.Surjective p]
    (hGlob : Function.Bijective (p.appTop).hom)
    (ιP : Y ⟶ (weilProjectiveSpaceOver R N).left)
    [AlgebraicGeometry.IsClosedImmersion ιP]
    (hComm : ιP ≫ (weilProjectiveSpaceOver R N).hom = p)
    (hDim : topologicalKrullDim
      ↥(CategoryTheory.Limits.pullback p
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap R (IsLocalRing.maximalIdeal R).ResidueField)))) ≤
      (1 : WithBot ℕ∞)) :
    ConnectedSpace
      ↥(CategoryTheory.Limits.pullback p
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap R (IsLocalRing.maximalIdeal R).ResidueField)))) :=
by
  
  have h_s1 : ∀ (k₀ : Type u) [Field k₀] [Infinite k₀]
      (π : R →+* k₀) (_ : Function.Surjective π)
      (S_R : Set ↥(letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) :=
        MvPolynomial.gradedAlgebra
        AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)))
      (_ : IsClosed S_R)
      (_ : topologicalKrullDim ↥S_R ≤ (1 : WithBot ℕ∞))
      (_ : letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) :=
        MvPolynomial.gradedAlgebra
        ∀ P ∈ S_R, ∀ r ∈ RingHom.ker π, MvPolynomial.C r ∈ P.asHomogeneousIdeal.toIdeal),
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) :=
        MvPolynomial.gradedAlgebra
      ∃ (L₀ L₁ : MvPolynomial (Fin (N + 1)) R),
        L₀ ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R 1 ∧
        L₁ ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R 1 ∧
        S_R ⊆ (AlgebraicGeometry.Proj.basicOpen
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) L₀ :
            Set ↥(AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R))) ∪
          (AlgebraicGeometry.Proj.basicOpen
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) L₁ :
            Set ↥(AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R))) := by
    intro k₀ _ _ π hSurj S_R hClosed hDim_S hKer
    let 𝒜_R := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R
    let 𝒜_k := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k₀
    let _ : GradedAlgebra 𝒜_R := MvPolynomial.gradedAlgebra
    let _ : GradedAlgebra 𝒜_k := MvPolynomial.gradedAlgebra
    have hProj_eq : ∀ {A : Type u} [CommRing A] (n : ℕ) (f_mv : MvPolynomial (Fin (N + 1)) A),
        (letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A) :=
          MvPolynomial.gradedAlgebra
         GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A) n f_mv) =
        MvPolynomial.homogeneousComponent n f_mv := by
      intro A _ n f_mv
      let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A
      let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
      change ↑((DirectSum.decompose 𝒜 f_mv) n) = MvPolynomial.homogeneousComponent n f_mv
      change ↑((MvPolynomial.decomposition.decompose' f_mv) n) = MvPolynomial.homogeneousComponent n f_mv
      rw [MvPolynomial.decomposition.decompose'_eq]
      by_cases hn : n ∈ Finset.image (⇑Finsupp.degree) f_mv.support
      · simp [DirectSum.mk_apply_of_mem hn]
      · simp only [DirectSum.mk_apply_of_notMem hn, ZeroMemClass.coe_zero]
        symm
        ext d
        rw [MvPolynomial.coeff_homogeneousComponent]
        change (if Finsupp.degree d = n then f_mv.coeff d else 0) = 0
        split_ifs with hd
        · by_contra hne
          exact hn (Finset.mem_image.mpr ⟨d, MvPolynomial.mem_support_iff.mpr hne, hd⟩)
        · rfl
    have hNotIrrel : ∀ {A : Type u} [CommRing A]
        (I : letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A) :=
          MvPolynomial.gradedAlgebra
          HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A)),
        letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A) :=
          MvPolynomial.gradedAlgebra
        (¬ HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A) ≤ I) ↔
          ∃ j : Fin (N + 1), MvPolynomial.X j ∉ I.toIdeal := by
      intro A _ I
      let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A
      let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
      constructor
      · intro hni
        by_contra hAll
        push Not at hAll
        apply hni
        intro f_mv hp
        rw [HomogeneousIdeal.mem_irrelevant_iff, hProj_eq] at hp
        have hp0 : f_mv.coeff 0 = 0 := by
          have h1 := congrArg (fun q : MvPolynomial (Fin (N + 1)) A => q.coeff 0) hp
          simpa [MvPolynomial.coeff_homogeneousComponent] using h1
        have hspan : f_mv ∈ Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin (N + 1)))) := by
          rw [MvPolynomial.mem_ideal_span_X_image]
          intro m hm
          by_contra hm0
          push Not at hm0
          have hm_eq : m = 0 := by
            ext i
            exact hm0 i (Set.mem_univ i)
          rw [hm_eq] at hm
          exact (MvPolynomial.mem_support_iff.mp hm) hp0
        exact Ideal.span_le.mpr (by rintro _ ⟨j, _, rfl⟩; exact hAll j) hspan
      · rintro ⟨j, hj⟩ hle
        apply hj
        apply hle
        rw [HomogeneousIdeal.mem_irrelevant_iff, hProj_eq]
        ext m
        rw [MvPolynomial.coeff_homogeneousComponent]
        change (if Finsupp.degree m = 0 then (MvPolynomial.X j : MvPolynomial (Fin (N + 1)) A).coeff m else 0) = 0
        split_ifs with hm
        · have hm0 : m = 0 := by
            ext i
            rw [Finsupp.coe_zero, Pi.zero_apply]
            by_contra hi
            have hle_sum := Finset.single_le_sum (f := fun k => m k) (fun _ _ => Nat.zero_le _)
              (Finsupp.mem_support_iff.mpr hi)
            have hsum : ∑ x ∈ m.support, m x = 0 := hm
            omega
          subst hm0
          rw [MvPolynomial.coeff_X]
          split_ifs with h0
          · exfalso
            have := Finsupp.ext_iff.mp h0.symm j
            simp at this
          · rfl
        · rfl
    let f_gr : MvPolynomial (Fin (N + 1)) R →+* MvPolynomial (Fin (N + 1)) k₀ :=
      MvPolynomial.map π
    have hf_surj : Function.Surjective f_gr := MvPolynomial.map_surjective π hSurj
    have hf_hom : ∀ (n : ℕ) (f_mv : MvPolynomial (Fin (N + 1)) R),
        f_gr (MvPolynomial.homogeneousComponent n f_mv) =
          MvPolynomial.homogeneousComponent n (f_gr f_mv) := by
      intro n f_mv
      ext d
      simp only [f_gr, MvPolynomial.coeff_map, MvPolynomial.coeff_homogeneousComponent]
      split_ifs <;> simp
    let Φ : ProjectiveSpectrum 𝒜_k → ProjectiveSpectrum 𝒜_R := fun q =>
      { asHomogeneousIdeal :=
          ⟨q.asHomogeneousIdeal.toIdeal.comap f_gr, by
            intro i r hr
            change GradedRing.proj 𝒜_R i r ∈ q.asHomogeneousIdeal.toIdeal.comap f_gr
            simp only [Ideal.mem_comap] at hr ⊢
            rw [hProj_eq, hf_hom, ← hProj_eq]
            exact q.asHomogeneousIdeal.is_homogeneous' i hr⟩
        isPrime := q.isPrime.comap f_gr
        not_irrelevant_le := by
          rw [hNotIrrel]
          obtain ⟨j, hj⟩ := (hNotIrrel q.asHomogeneousIdeal).mp q.not_irrelevant_le
          refine ⟨j, fun hmem => hj ?_⟩
          change f_gr (MvPolynomial.X j) ∈ q.asHomogeneousIdeal.toIdeal at hmem
          simpa [f_gr] using hmem }
    have hΦ_inj : Function.Injective Φ := by
      intro q₁ q₂ hq
      ext x
      obtain ⟨y, rfl⟩ := hf_surj x
      have h1 : y ∈ (Φ q₁).asHomogeneousIdeal.toIdeal ↔ y ∈ (Φ q₂).asHomogeneousIdeal.toIdeal := by
        rw [hq]
      exact h1
    have hΦ_zero : ∀ (s : Set (MvPolynomial (Fin (N + 1)) R)),
        Φ ⁻¹' (ProjectiveSpectrum.zeroLocus 𝒜_R s) =
          ProjectiveSpectrum.zeroLocus 𝒜_k (f_gr '' s) := by
      intro s
      ext q
      simp only [Set.mem_preimage, ProjectiveSpectrum.mem_zeroLocus, Set.image_subset_iff]
      rfl
    have hΦ_ind : Topology.IsInducing Φ := by
      refine ⟨TopologicalSpace.ext_iff.mpr fun U => ?_⟩
      rw [isOpen_induced_iff]
      constructor
      · intro hU
        obtain ⟨s, hs⟩ := (ProjectiveSpectrum.isOpen_iff 𝒜_k U).mp hU
        refine ⟨(ProjectiveSpectrum.zeroLocus 𝒜_R (f_gr ⁻¹' s))ᶜ,
          (ProjectiveSpectrum.isClosed_zeroLocus 𝒜_R _).isOpen_compl, ?_⟩
        rw [Set.preimage_compl, hΦ_zero, Set.image_preimage_eq s hf_surj, ← hs, compl_compl]
