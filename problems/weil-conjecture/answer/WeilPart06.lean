      exact ((cancel_epi (eqToHom p₀₁)).mp hgc').symm
    have hSup : ι₀.opensRange ⊔ ι₁.opensRange = ⊤ := by
      have hcov := TopologicalSpace.IsOpenCover.iSup_eq_top
        (AlgebraicGeometry.Scheme.OpenCover.isOpenCover_opensRange D.openCover)
      rw [eq_top_iff]
      intro y _
      let U_cov := fun i : D.openCover.I₀ => (D.openCover.f i).opensRange
      have hy : y ∈ iSup U_cov := by
        rw [hcov]; trivial
      rw [TopologicalSpace.Opens.mem_iSup] at hy
      rcases hy with ⟨⟨_ | _⟩, hyi⟩
      · exact Or.inl hyi
      · exact Or.inr hyi
    have _ : CategoryTheory.Limits.HasMulticoequalizer D.diagram :=
      (fun (D_gen : AlgebraicGeometry.Scheme.GlueData.{u}) =>
        (inferInstance : CategoryTheory.Limits.HasMulticoequalizer D_gen.diagram)) D
    refine ⟨M, ι₀, ι₁, hOpen₀, hOpen₁, hOv, hSup, ?_, ?_⟩
    · intro X m₀ m₁ hm
      let m_fam : ∀ b : J, D.U b ⟶ X := ULift.rec (Bool.rec m₀ m₁)
      have h_cond : ∀ p : J × J, D.diagram.fst p ≫ m_fam p.1 = D.diagram.snd p ≫ m_fam p.2 := by
        rintro ⟨a, b⟩
        change D.f a b ≫ m_fam a = D.t a b ≫ D.f b a ≫ m_fam b
        rcases a with ⟨_ | _⟩ <;> rcases b with ⟨_ | _⟩
        · change D_cat.f i₀ i₀ ≫ m₀ = D_cat.t i₀ i₀ ≫ D_cat.f i₀ i₀ ≫ m₀
          exact ((Category.id_comp _).symm.trans (congrArg (· ≫ _) ht_00.symm))
        · change D_cat.f i₀ i₁ ≫ m₀ = D_cat.t i₀ i₁ ≫ D_cat.f i₁ i₀ ≫ m₁
          calc
            D_cat.f i₀ i₁ ≫ m₀ = (eqToHom p₀₁ ≫ j₀₁) ≫ m₀ := congrArg (· ≫ m₀) hf_01
            _ = eqToHom p₀₁ ≫ (j₀₁ ≫ m₀) := Category.assoc _ _ _
            _ = eqToHom p₀₁ ≫ (j₁₀ ≫ m₁) := congrArg (eqToHom p₀₁ ≫ ·) hm
            _ = (eqToHom p₀₁ ≫ j₁₀) ≫ m₁ := (Category.assoc _ _ _).symm
            _ = (D_cat.t i₀ i₁ ≫ D_cat.f i₁ i₀) ≫ m₁ := congrArg (· ≫ m₁) htf_01.symm
            _ = D_cat.t i₀ i₁ ≫ D_cat.f i₁ i₀ ≫ m₁ := Category.assoc _ _ _
        · change D_cat.f i₁ i₀ ≫ m₁ = D_cat.t i₁ i₀ ≫ D_cat.f i₀ i₁ ≫ m₀
          calc
            D_cat.f i₁ i₀ ≫ m₁ = (eqToHom p₁₀ ≫ j₁₀) ≫ m₁ := congrArg (· ≫ m₁) hf_10
            _ = eqToHom p₁₀ ≫ (j₁₀ ≫ m₁) := Category.assoc _ _ _
            _ = eqToHom p₁₀ ≫ (j₀₁ ≫ m₀) := congrArg (eqToHom p₁₀ ≫ ·) hm.symm
            _ = (eqToHom p₁₀ ≫ j₀₁) ≫ m₀ := (Category.assoc _ _ _).symm
            _ = (D_cat.t i₁ i₀ ≫ D_cat.f i₀ i₁) ≫ m₀ := congrArg (· ≫ m₀) htf_10.symm
            _ = D_cat.t i₁ i₀ ≫ D_cat.f i₀ i₁ ≫ m₀ := Category.assoc _ _ _
        · change D_cat.f i₁ i₁ ≫ m₁ = D_cat.t i₁ i₁ ≫ D_cat.f i₁ i₁ ≫ m₁
          exact ((Category.id_comp _).symm.trans (congrArg (· ≫ _) ht_11.symm))
      let g : M ⟶ X := CategoryTheory.Limits.Multicoequalizer.desc D.diagram X m_fam h_cond
      refine ⟨g, ?_, ?_⟩
      · exact CategoryTheory.Limits.Multicoequalizer.π_desc D.diagram X m_fam h_cond i₀
      · exact CategoryTheory.Limits.Multicoequalizer.π_desc D.diagram X m_fam h_cond i₁
    · intro X g₁ g₂ hg₀ hg₁
      apply CategoryTheory.Limits.Multicoequalizer.hom_ext D.diagram g₁ g₂
      rintro ⟨_ | _⟩
      · exact hg₀
      · exact hg₁
  obtain ⟨M, ι₀, ι₁, hOpen₀, hOpen₁, hOv, hSup, hDesc, hExt⟩ := hGluePkg
  letI : AlgebraicGeometry.IsOpenImmersion ι₀ := hOpen₀
  letI : AlgebraicGeometry.IsOpenImmersion ι₁ := hOpen₁
  have hp_ov :
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₀₁) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₀) =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap C₁ C₀₁)) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₁) := by
    rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hcomp]
  obtain ⟨p_M, hι₀_p, hι₁_p⟩ := hDesc (AlgebraicGeometry.Spec (CommRingCat.of A))
    (AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₀))
    (AlgebraicGeometry.Spec.map (CommRingCat.ofHom p₁)) hp_ov
  
  have hProjPkg :
      ∃ (ι_M : M ⟶ (weilProjectiveSpaceOver A 1).left)
        (φ₀ : ↑((weilProjectiveSpaceOver A 1).left.presheaf.obj
          (Opposite.op (weilProjBasicOpen A 1 0))) →+* C₀)
        (φ₁ : ↑((weilProjectiveSpaceOver A 1).left.presheaf.obj
          (Opposite.op (weilProjBasicOpen A 1 1))) →+* C₁),
        AlgebraicGeometry.IsClosedImmersion ι_M ∧
        ι_M ≫ (weilProjectiveSpaceOver A 1).hom = p_M ∧
        AlgebraicGeometry.IsProper p_M ∧
        (TopologicalSpace.Opens.map ι_M.base).obj (weilProjBasicOpen A 1 0) = ι₀.opensRange ∧
        (TopologicalSpace.Opens.map ι_M.base).obj (weilProjBasicOpen A 1 1) = ι₁.opensRange ∧
        (φ₀.comp (c_A 0) = p₀ ∧ φ₀ (t_A 0 0) = 1 ∧ φ₀ (t_A 0 1) = s₀) ∧
        (φ₁.comp (c_A 1) = p₁ ∧ φ₁ (t_A 1 0) = t₁ ∧ φ₁ (t_A 1 1) = 1) ∧
        ι₀ ≫ ι_M = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀) ≫ (hAff_A 0).fromSpec ∧
        ι₁ ≫ ι_M = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁) ≫ (hAff_A 1).fromSpec := by
    obtain ⟨hProp_P1, hCov_P1, hBase_c, _hPoly_P1, ht_diag, hGen_P1,
        hEval_P1, hBasic_P1, hRes_c, hRes_t⟩ := hCoord_A
    clear _hPoly_P1
    suffices hGenScheme :
        ∀ (P₁ : AlgebraicGeometry.Scheme.{u})
