          (c_κ1 : κ →+* R_κ1) (t_κ10 : R_κ1),
          ∃ (α₀ : C₀ →+* R_κ0) (α₁ : C₁ →+* R_κ1),
            α₀.comp p₀ = c_κ0.comp ε_A ∧
            α₀ s₀ = t_κ01 ∧
            α₁.comp p₁ = c_κ1.comp ε_A ∧
