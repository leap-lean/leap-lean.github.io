      rw [map_sub, sq, map_mul, hx₀_mk, hebar₀_id.eq, sub_self]
    have hx₁_id : x₁ ^ 2 - x₁ ∈ I₁ := by
      rw [← Ideal.Quotient.eq_zero_iff_mem]
