  let S_j (a : Fin r) (j : Fin n) : S_V.Opens :=
    (TopologicalSpace.Opens.map (τ' j).base).obj (U_cov a)
  let 𝒰_S (j : Fin n) : S_V.OpenCover :=
    S_V.openCoverOfIsOpenCover (fun i : J => S_j i.down j)
      (TopologicalSpace.IsOpenCover.mk (by
        ext b
        simp only [TopologicalSpace.Opens.coe_iSup, Set.mem_iUnion,
          TopologicalSpace.Opens.coe_top, Set.mem_univ, iff_true]
        have hb : (τ' j).base b ∈ (⋃ a : Fin r, (U_cov a : Set C')) := by rw [hCov]; trivial
        obtain ⟨a, ha⟩ := Set.mem_iUnion.mp hb
        exact ⟨⟨a⟩, ha⟩))
  have hτ_glue : ∀ (j : Fin n) (x y : (𝒰_S j).I₀),
      Limits.pullback.fst ((𝒰_S j).f x) ((𝒰_S j).f y) ≫ (τ_bar x.down j ≫ ι_chart x.down) =
        Limits.pullback.snd ((𝒰_S j).f x) ((𝒰_S j).f y) ≫ (τ_bar y.down j ≫ ι_chart y.down) := by
    intro j ⟨a⟩ ⟨b⟩
    let P_S := Limits.pullback (S_j a j).ι (S_j b j).ι
    change Limits.pullback.fst (S_j a j).ι (S_j b j).ι ≫ (τ_bar a j ≫ ι_chart a) =
      Limits.pullback.snd (S_j a j).ι (S_j b j).ι ≫ (τ_bar b j ≫ ι_chart b)
    let s₁ : P_S ⟶ C_semi :=
      Limits.pullback.fst (S_j a j).ι (S_j b j).ι ≫ (τ_bar a j ≫ ι_chart a)
    let s₂ : P_S ⟶ C_semi :=
      Limits.pullback.snd (S_j a j).ι (S_j b j).ι ≫ (τ_bar b j ≫ ι_chart b)
    change s₁ = s₂
    by_cases hEmp : IsEmpty ↥P_S
    · exact (AlgebraicGeometry.isInitialOfIsEmpty (X := P_S)).hom_ext s₁ s₂
    · have hNe_PS : Nonempty ↥P_S := not_isEmpty_iff.mp hEmp
      have hs₁_f : s₁ ≫ f_semi =
          Limits.pullback.snd (S_j a j).ι (S_j b j).ι ≫ (S_j b j).ι ≫ τ' j := by
        dsimp only [s₁]
        rw [Category.assoc, Category.assoc, hf_chart a, ← Category.assoc (τ_bar a j),
          hτ_bar a j, ← Category.assoc, Limits.pullback.condition, Category.assoc]
      have hs₁_range : Set.range ⇑s₁ ⊆ Set.range ⇑(ι_chart b) := by
        rw [hPre_chart b]
        rintro _ ⟨p, rfl⟩
        show f_semi.base (s₁.base p) ∈ U_cov b
        change ((s₁ ≫ f_semi).base p) ∈ U_cov b
        rw [hs₁_f]
        exact ((Limits.pullback.snd (S_j a j).ι (S_j b j).ι).base p).2
      let s_lift₁ : P_S ⟶ C_bar b := AlgebraicGeometry.IsOpenImmersion.lift (ι_chart b) s₁ hs₁_range
      have hs_lift₁_fac : s_lift₁ ≫ ι_chart b = s₁ := AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ _
      let s_lift₂ : P_S ⟶ C_bar b := Limits.pullback.snd (S_j a j).ι (S_j b j).ι ≫ τ_bar b j
      suffices hs_eq : s_lift₂ = s_lift₁ by
        calc s₁
            = s_lift₁ ≫ ι_chart b := hs_lift₁_fac.symm
          _ = s_lift₂ ≫ ι_chart b := by rw [← hs_eq]
          _ = s₂ := Category.assoc _ _ _
      let π_S : P_S ⟶ S_V := Limits.pullback.snd (S_j a j).ι (S_j b j).ι ≫ (S_j b j).ι
      have : AlgebraicGeometry.IsOpenImmersion π_S := inferInstance
      have : AlgebraicGeometry.IsIntegral S_V := inferInstance
      have : AlgebraicGeometry.IsReduced P_S :=
        AlgebraicGeometry.isReduced_of_isOpenImmersion π_S
      have : IrreducibleSpace ↥S_V :=
        AlgebraicGeometry.irreducibleSpace_of_isIntegral S_V
      have hPrePS : PreirreducibleSpace ↥P_S := by
        rw [preirreducibleSpace_iff]
        intro U₁ U₂ hU₁ hU₂ hp₁ hp₂
        obtain ⟨p₁, _, hp₁⟩ := hp₁
        obtain ⟨p₂, _, hp₂⟩ := hp₂
        have hEmb := π_S.isOpenEmbedding
        have hIntSV := nonempty_preirreducible_inter
          (hEmb.isOpenMap U₁ hU₁) (hEmb.isOpenMap U₂ hU₂)
          ⟨π_S.base p₁, p₁, hp₁, rfl⟩ ⟨π_S.base p₂, p₂, hp₂, rfl⟩
        obtain ⟨_, ⟨q₁, hq₁, rfl⟩, ⟨q₂, hq₂, hEq⟩⟩ := hIntSV
        cases hEmb.injective hEq
        exact ⟨q₁, trivial, ⟨hq₁, hq₂⟩⟩
      let W_K := Limits.pullback π_S η_V
      let δ_S : W_K ⟶ P_S := Limits.pullback.fst π_S η_V
      let p_WS : W_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K) := Limits.pullback.snd π_S η_V
      have : AlgebraicGeometry.IsOpenImmersion δ_S := inferInstance
      have hNe_δS : (Set.range ⇑δ_S).Nonempty := by
        rw [AlgebraicGeometry.IsOpenImmersion.range_pullbackFst]
        obtain ⟨p₀⟩ := hNe_PS
        have : AlgebraicGeometry.IsIntegral (AlgebraicGeometry.Spec (CommRingCat.of K)) := inferInstance
        have hIrredSK : IrreducibleSpace ↥(AlgebraicGeometry.Spec (CommRingCat.of K)) :=
          AlgebraicGeometry.irreducibleSpace_of_isIntegral _
        obtain ⟨q₀⟩ := hIrredSK.toNonempty
        obtain ⟨_, ⟨p₁, rfl⟩, hη_mem⟩ :=
          nonempty_preirreducible_inter
            π_S.isOpenEmbedding.isOpen_range η_V.isOpenEmbedding.isOpen_range
            ⟨π_S.base p₀, p₀, rfl⟩ ⟨η_V.base q₀, q₀, rfl⟩
        exact ⟨p₁, hη_mem⟩
      have : AlgebraicGeometry.IsDominant δ_S := by
        rw [AlgebraicGeometry.isDominant_iff]
        intro p
        rw [mem_closure_iff]
        intro O hO hpO
        exact nonempty_preirreducible_inter
          hO δ_S.isOpenEmbedding.isOpen_range ⟨p, hpO⟩ hNe_δS
      refine hDomUniq b δ_S p_WS s_lift₂ s_lift₁ ?_ ?_
      · have hs_lift₁_C' : s_lift₁ ≫ f_bar b ≫ (U_cov b).ι = π_S ≫ τ' j := by
          rw [← hf_chart b, ← Category.assoc, hs_lift₁_fac, hs₁_f]
          rfl
        have hs_lift₂_C' : s_lift₂ ≫ f_bar b ≫ (U_cov b).ι = π_S ≫ τ' j := by
          dsimp only [s_lift₂, π_S]
          rw [Category.assoc, ← Category.assoc (τ_bar b j), hτ_bar b j, Category.assoc]
        rw [hs_lift₂_C', hs_lift₁_C']
      · calc (δ_S ≫ s_lift₂) ≫ g_bar b
            = δ_S ≫ s_lift₂ ≫ f_bar b ≫ (U_cov b).ι ≫ g' := by
              rw [Category.assoc, ← hf_g_bar b]
          _ = δ_S ≫ (Limits.pullback.snd (S_j a j).ι (S_j b j).ι ≫
                ((τ_bar b j ≫ f_bar b) ≫ (U_cov b).ι) ≫ g') := by
              dsimp only [s_lift₂]; simp only [Category.assoc]
          _ = δ_S ≫ (Limits.pullback.snd (S_j a j).ι (S_j b j).ι ≫
                ((S_j b j).ι ≫ τ' j) ≫ g') := by
              rw [hτ_bar b j]
          _ = δ_S ≫ π_S := by
              dsimp only [π_S]
              rw [Category.assoc ((S_j b j).ι), hτ'_g' j, Category.comp_id]
          _ = p_WS ≫ η_V := Limits.pullback.condition
  let τ_semi (j : Fin n) : S_V ⟶ C_semi :=
    (𝒰_S j).glueMorphisms (fun i => τ_bar i.down j ≫ ι_chart i.down) (hτ_glue j)
  have hτ_semi_loc : ∀ (a : Fin r) (j : Fin n),
      (S_j a j).ι ≫ τ_semi j = τ_bar a j ≫ ι_chart a :=
    fun a j => (𝒰_S j).ι_glueMorphisms _ _ ⟨a⟩
  have hτ_f : ∀ j : Fin n, τ_semi j ≫ f_semi = τ' j := by
    intro j
    refine (𝒰_S j).hom_ext _ _ (fun ⟨a⟩ => ?_)
    change (S_j a j).ι ≫ (τ_semi j ≫ f_semi) = (S_j a j).ι ≫ τ' j
    rw [← Category.assoc, hτ_semi_loc a j, Category.assoc, hf_chart a,
      ← Category.assoc, hτ_bar a j]
  have hτ_g : ∀ j : Fin n, τ_semi j ≫ g_semi = 𝟙 S_V := by
    intro j
    rw [← hf_g, ← Category.assoc, hτ_f j, hτ'_g' j]
  have hSurj_g : AlgebraicGeometry.Surjective g_semi := by
    let j₀ : Fin n := ⟨0, by omega⟩
    refine AlgebraicGeometry.Surjective.mk (fun b => ⟨(τ_semi j₀).base b, ?_⟩)
    change (τ_semi j₀ ≫ g_semi).base b = b
    rw [hτ_g j₀]
    rfl
  have hσ_semi : ∀ j : Fin n, σ_K j ≫ ι_semi = η_V ≫ τ_semi j := by
    intro j
    have hcomm_j : (η_V ≫ τ_semi j) ≫ g_semi =
        𝟙 (AlgebraicGeometry.Spec (CommRingCat.of K)) ≫ η_V := by
      rw [Category.assoc, hτ_g j, Category.comp_id, Category.id_comp]
    let σ_lift_j := hPb_semi.lift (η_V ≫ τ_semi j) (𝟙 _) hcomm_j
    have hσ_lift_eq : σ_lift_j = σ_K j := by
      refine hPb'.hom_ext ?_ ?_
      · calc σ_lift_j ≫ ι'
            = (σ_lift_j ≫ ι_semi) ≫ f_semi := by rw [Category.assoc, hι_f]
          _ = (η_V ≫ τ_semi j) ≫ f_semi := by rw [hPb_semi.lift_fst]
          _ = η_V ≫ τ' j := by rw [Category.assoc, hτ_f j]
          _ = σ_K j ≫ ι' := (hσ_τ' j).symm
      · rw [hPb_semi.lift_snd, hσ_pK j]
    rw [← hσ_lift_eq]
    exact hPb_semi.lift_fst _ _ _
  have hDisj_semi : _root_.Pairwise fun i j : Fin n =>
      Disjoint (Set.range (τ_semi i).base) (Set.range (τ_semi j).base) := by
    intro i j hij
    rw [Set.disjoint_left]
    rintro z ⟨b₁, hb₁⟩ ⟨b₂, hb₂⟩
    have hb12 : b₁ = b₂ := by
      have h1 : g_semi.base z = b₁ := by
        rw [← hb₁]; change (τ_semi i ≫ g_semi).base b₁ = b₁; rw [hτ_g i]; rfl
      have h2 : g_semi.base z = b₂ := by
        rw [← hb₂]; change (τ_semi j ≫ g_semi).base b₂ = b₂; rw [hτ_g j]; rfl
      exact h1.symm.trans h2
    subst hb12
    have hfz : f_semi.base z ∈ (⋃ a : Fin r, (U_cov a : Set C')) := by rw [hCov]; trivial
    obtain ⟨a, ha⟩ := Set.mem_iUnion.mp hfz
    have hbi : b₁ ∈ S_j a i := by
      show (τ' i).base b₁ ∈ U_cov a
      rw [← hτ_f i]
      change f_semi.base ((τ_semi i).base b₁) ∈ U_cov a
      rwa [hb₁]
    have hbj : b₁ ∈ S_j a j := by
      show (τ' j).base b₁ ∈ U_cov a
      rw [← hτ_f j]
      change f_semi.base ((τ_semi j).base b₁) ∈ U_cov a
      rwa [hb₂]
    have h_eq_i : (ι_chart a).base ((τ_bar a i).base ⟨b₁, hbi⟩) = z := by
      have := congrArg (fun m => m.base ⟨b₁, hbi⟩) (hτ_semi_loc a i)
      exact this.symm.trans hb₁
    have h_eq_j : (ι_chart a).base ((τ_bar a j).base ⟨b₁, hbj⟩) = z := by
      have := congrArg (fun m => m.base ⟨b₁, hbj⟩) (hτ_semi_loc a j)
      exact this.symm.trans hb₂
    have h_bar_eq : (τ_bar a i).base ⟨b₁, hbi⟩ = (τ_bar a j).base ⟨b₁, hbj⟩ :=
      (ι_chart a).isOpenEmbedding.injective (h_eq_i.trans h_eq_j.symm)
    exact Set.disjoint_left.mp (hDisj_bar a hij)
      ⟨⟨b₁, hbi⟩, rfl⟩ ⟨⟨b₁, hbj⟩, h_bar_eq.symm⟩
  have hSm_semi : ∀ (j : Fin n) (b : S_V),
      ∃ V_sm : C_semi.Opens,
        (τ_semi j).base b ∈ V_sm ∧
        AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ g_semi) := by
    intro j b
    have hb_cov : (τ' j).base b ∈ (⋃ a : Fin r, (U_cov a : Set C')) := by rw [hCov]; trivial
    obtain ⟨a, ha⟩ := Set.mem_iUnion.mp hb_cov
    obtain ⟨V_sm_a, hmem_a, hSm_a⟩ := hSm_bar a j ⟨b, ha⟩
    let V_sm : C_semi.Opens :=
      ⟨(ι_chart a).base '' (V_sm_a : Set (C_bar a)),
        (ι_chart a).isOpenEmbedding.isOpenMap _ V_sm_a.isOpen⟩
    have hRangeV : Set.range ⇑V_sm.ι = Set.range ⇑(V_sm_a.ι ≫ ι_chart a) := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      ext w
      simp only [Set.mem_range]
      constructor
      · rintro ⟨u, hu, rfl⟩
        exact ⟨⟨u, hu⟩, rfl⟩
      · rintro ⟨u, rfl⟩
        exact ⟨u.1, u.2, rfl⟩
    let iso_V := AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq V_sm.ι (V_sm_a.ι ≫ ι_chart a) hRangeV
    refine ⟨V_sm, ?_, ?_⟩
    · have h_loc := congrArg (fun m => m.base ⟨b, ha⟩) (hτ_semi_loc a j)
      change (τ_semi j).base b = (ι_chart a).base ((τ_bar a j).base ⟨b, ha⟩) at h_loc
      rw [h_loc]
      exact ⟨(τ_bar a j).base ⟨b, ha⟩, hmem_a, rfl⟩
    · have hV_eq : V_sm.ι ≫ g_semi = iso_V.hom ≫ (V_sm_a.ι ≫ g_bar a) := by
        calc V_sm.ι ≫ g_semi
            = (iso_V.hom ≫ V_sm_a.ι ≫ ι_chart a) ≫ g_semi := by
              rw [AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac]
          _ = iso_V.hom ≫ V_sm_a.ι ≫ (ι_chart a ≫ g_semi) := by simp only [Category.assoc]
          _ = iso_V.hom ≫ (V_sm_a.ι ≫ g_bar a) := by rw [hg_chart a]
      have : AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm_a.ι ≫ g_bar a) := hSm_a
      have h01 : AlgebraicGeometry.SmoothOfRelativeDimension (0 + 1)
          (iso_V.hom ≫ (V_sm_a.ι ≫ g_bar a)) := inferInstance
      rw [Nat.zero_add] at h01
      rwa [hV_eq]
  exact ⟨C_semi, g_semi, f_semi, τ_semi, ι_semi,
    hSS_semi, hProp_f, hf_g, hProp_g, hSurj_g,
    hτ_f, hτ_g, hPb_semi, hσ_semi, hDisj_semi, hSm_semi⟩

theorem weil_strictlySemistable_geom_fiber_smooth_or_nodal_roof (K : Type u) [Field K] (V : ValuationSubring K)
    (C_semi : AlgebraicGeometry.Scheme.{u})
    (g_semi : C_semi ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (hSS : IsStrictlySemistableCurveOverValuation V g_semi)
    (K' : Type u) [Field K'] [IsAlgClosed K']
    (s : AlgebraicGeometry.Spec (CommRingCat.of K') ⟶
      AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (y : ↥(CategoryTheory.Limits.pullback g_semi s)) :
    (∃ V_sm : (CategoryTheory.Limits.pullback g_semi s).Opens,
      y ∈ V_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1
        (V_sm.ι ≫ CategoryTheory.Limits.pullback.snd g_semi s)) ∨
    (∃ (U' : AlgebraicGeometry.Scheme.{u}) (u₀ : U')
        (e₁ : U' ⟶ CategoryTheory.Limits.pullback g_semi s)
        (e₂ : U' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
          (MvPolynomial (Fin 2) K' ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}))),
      AlgebraicGeometry.Etale e₁ ∧
      AlgebraicGeometry.Etale e₂ ∧
      e₁.base u₀ = y ∧
      (∀ i : Fin 2, Ideal.Quotient.mk _ (MvPolynomial.X i) ∈ (e₂.base u₀).asIdeal) ∧
      e₁ ≫ CategoryTheory.Limits.pullback.snd g_semi s =
        e₂ ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C))) :=
by
  let fst := CategoryTheory.Limits.pullback.fst g_semi s
  let snd := CategoryTheory.Limits.pullback.snd g_semi s
  let x : ↥C_semi := fst.base y
  have smooth_spec_of_stdSmooth1 :
      ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S],
        Algebra.IsStandardSmoothOfRelativeDimension 1 R S →
        AlgebraicGeometry.SmoothOfRelativeDimension 1
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R S))) := by
    intro R S _ _ _ hStd
    rw [AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.SmoothOfRelativeDimension 1)]
    apply RingHom.locally_of (@RingHom.isStandardSmoothOfRelativeDimension_respectsIso 1)
    exact (RingHom.isStandardSmoothOfRelativeDimension_algebraMap 1).mpr hStd
  have poly_stdSmooth1 :
      ∀ (R : Type u) [CommRing R],
        Algebra.IsStandardSmoothOfRelativeDimension 1 R (Polynomial R) := by
    intro R _
    have : Algebra.IsStandardSmoothOfRelativeDimension 1 R (MvPolynomial (Fin 1) R) :=
      inferInstance
    exact Algebra.IsStandardSmoothOfRelativeDimension.of_algEquiv 1
      (MvPolynomial.uniqueAlgEquiv R (Fin 1))
  have pullback_smooth_open :
      ∀ (W_sm : C_semi.Opens), x ∈ W_sm →
        AlgebraicGeometry.SmoothOfRelativeDimension 1 (W_sm.ι ≫ g_semi) →
        ∃ V_sm : (CategoryTheory.Limits.pullback g_semi s).Opens,
          y ∈ V_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ snd) := by
    intro W_sm hx_sm hSm
    let V_sm : (CategoryTheory.Limits.pullback g_semi s).Opens :=
      (TopologicalSpace.Opens.map fst.base).obj W_sm
    have hpb1 : CategoryTheory.IsPullback (fst ∣_ W_sm) V_sm.ι W_sm.ι fst :=
      AlgebraicGeometry.isPullback_morphismRestrict fst W_sm
    have hpb2 : CategoryTheory.IsPullback fst snd g_semi s :=
      CategoryTheory.IsPullback.of_hasPullback g_semi s
    have hpb := hpb1.paste_vert hpb2
    exact ⟨V_sm, hx_sm,
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb hSm⟩
  rcases hSS.2.2.2.2 x with ⟨W, e, hx, he, hcomm⟩ | ⟨W, a, e, hx, _ha, he, hcomm⟩
  · 
    have : AlgebraicGeometry.Etale e := he
    have : AlgebraicGeometry.SmoothOfRelativeDimension 0 e := inferInstance
    have hSm_poly : AlgebraicGeometry.SmoothOfRelativeDimension 1
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : ↥V →+* Polynomial ↥V))) :=
      smooth_spec_of_stdSmooth1 ↥V (Polynomial ↥V) (poly_stdSmooth1 ↥V)
    have hSm_comp : AlgebraicGeometry.SmoothOfRelativeDimension 1
        (e ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C)) := by
      have h := AlgebraicGeometry.smoothOfRelativeDimension_comp 0 1 e
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C))
      simpa using h
    rw [← hcomm] at hSm_comp
    exact Or.inl (pullback_smooth_open W hx hSm_comp)
  · 
    let I_V : Ideal (MvPolynomial (Fin 2) ↥V) :=
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}
    let A_V := MvPolynomial (Fin 2) ↥V ⧸ I_V
    let xbar : Fin 2 → A_V := fun i => Ideal.Quotient.mk I_V (MvPolynomial.X i)
    let w₀ : ↥W.toScheme := ⟨x, hx⟩
    let q_V : ↥(AlgebraicGeometry.Spec (CommRingCat.of A_V)) := e.base w₀
    have halg_AV : ((Ideal.Quotient.mk I_V).comp MvPolynomial.C : ↥V →+* A_V) =
        algebraMap ↥V A_V := by
      ext r; rfl
    have hcomm' : W.ι ≫ g_semi =
        e ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V A_V)) := by
      change W.ι ≫ g_semi =
        e ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk I_V).comp MvPolynomial.C)) at hcomm
      rwa [halg_AV] at hcomm
    have hx01 : xbar 0 * xbar 1 = algebraMap ↥V A_V a := by
      have hzero : Ideal.Quotient.mk I_V
          (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
      rw [map_sub, map_mul, sub_eq_zero] at hzero
      exact hzero
    by_cases hAll : ∀ i : Fin 2, xbar i ∈ q_V.asIdeal
    · 
      let φ_s : ↥V →+* K' := (AlgebraicGeometry.Spec.preimage s).hom
      have hs_pre : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_s) = s :=
        AlgebraicGeometry.Spec.map_preimage s
      have hφa : φ_s a = 0 := by
        have ha_qV : algebraMap ↥V A_V a ∈ q_V.asIdeal := by
          rw [← hx01]
          exact q_V.asIdeal.mul_mem_right (xbar 1) (hAll 0)
        have h_cond_y : (fst ≫ g_semi).base y = (snd ≫ s).base y := by
          rw [CategoryTheory.Limits.pullback.condition]
        have h1 : (fst ≫ g_semi).base y = (W.ι ≫ g_semi).base w₀ := rfl
        have h2 : (fst ≫ g_semi).base y =
