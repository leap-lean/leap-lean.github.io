        have h_sub : ψ_Wu ≫ iso_Wu.hom ≫ U_sub.ι = ψ_Wet := by
          apply (cancel_mono W_et.ι).mp
          rw [Category.assoc, Category.assoc]
          change ψ_Wu ≫ (iso_Wu.hom ≫ j_sub) = ψ_Wet ≫ W_et.ι
          rw [hiso_Wu, hψ_comm]
        let α_loc : AlgebraicGeometry.Spec (CommRingCat.of S) ⟶
            AlgebraicGeometry.Spec (CommRingCat.of L_x0) :=
          ψ_Wu ≫ iso_Wu.hom ≫ e_res ≫ iso_Dx0.hom
        have hα_jx0 : α_loc ≫ j_x0 = ψ_Wet ≫ e := by
          change (ψ_Wu ≫ iso_Wu.hom ≫ e_res ≫ iso_Dx0.hom) ≫ j_x0 = _
          rw [Category.assoc, Category.assoc, Category.assoc, hiso_Dx0,
            (AlgebraicGeometry.isPullback_morphismRestrict e D_x0).w,
            ← Category.assoc, ← Category.assoc, Category.assoc ψ_Wu iso_Wu.hom U_sub.ι, h_sub]
        have hα_esm : ψ_Wu ≫ e_sm =
            α_loc ≫ AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap (Polynomial R_V) L_X) ≫ CommRingCat.ofHom φ) := by
          rw [AlgebraicGeometry.Spec.map_comp]
          simp only [e_sm, α_loc, j_X, Category.assoc]
        rw [hα_esm, AlgebraicGeometry.Spec.preimage_comp,
          AlgebraicGeometry.Spec.preimage_map, ← hα_jx0,
          AlgebraicGeometry.Spec.preimage_comp, AlgebraicGeometry.Spec.preimage_map]
        change (AlgebraicGeometry.Spec.preimage α_loc).hom
            (φ (algebraMap (Polynomial R_V) L_X Polynomial.X)) =
          (AlgebraicGeometry.Spec.preimage α_loc).hom (algebraMap Q_a L_x0 x₀)
        rw [hφ_eq]
        simp [φ₀, x₀]

    have hNodalAwaySmooth : ∀ {R_V : Type u} [CommRing R_V]
        (Y : AlgebraicGeometry.Scheme.{u})
        (g_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of R_V))
        (W_et : Y.Opens) (a : R_V)
        (e : W_et.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of
          (MvPolynomial (Fin 2) R_V ⧸ Ideal.span
            {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a})))
        (i : Fin 2),
        AlgebraicGeometry.Etale e →
        W_et.ι ≫ g_Y = e ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) →
        ∃ (W_u : Y.Opens)
          (e_sm : W_u.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial R_V))),
          (∀ y : Y, y ∈ W_u ↔ ∃ hy : y ∈ W_et,
            Ideal.Quotient.mk _ (MvPolynomial.X i) ∉ (e.base ⟨y, hy⟩).asIdeal) ∧
          AlgebraicGeometry.Etale e_sm ∧
          W_u.ι ≫ g_Y = e_sm ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) ∧
          (∀ {S : Type u} [CommRing S]
              (ψ_Wu : AlgebraicGeometry.Spec (CommRingCat.of S) ⟶ W_u.toScheme)
              (ψ_Wet : AlgebraicGeometry.Spec (CommRingCat.of S) ⟶ W_et.toScheme),
            ψ_Wu ≫ W_u.ι = ψ_Wet ≫ W_et.ι →
            (AlgebraicGeometry.Spec.preimage (ψ_Wu ≫ e_sm)).hom Polynomial.X =
              (AlgebraicGeometry.Spec.preimage (ψ_Wet ≫ e)).hom
                (Ideal.Quotient.mk _ (MvPolynomial.X i))) := by
      intro R_V _ Y g_Y W_et a e i hEt_e he_comm
      fin_cases i
      · exact hNodalAwaySmooth0 Y g_Y W_et a e hEt_e he_comm
      · let I_a : Ideal (MvPolynomial (Fin 2) R_V) :=
          Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}
        let ren : MvPolynomial (Fin 2) R_V →+* MvPolynomial (Fin 2) R_V :=
          MvPolynomial.eval₂Hom MvPolynomial.C ![MvPolynomial.X 1, MvPolynomial.X 0]
        have hker_ren : I_a ≤ RingHom.ker ((Ideal.Quotient.mk I_a).comp ren) := by
          rw [Ideal.span_le]
          rintro _ rfl
          change Ideal.Quotient.mk I_a (ren (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a)) = 0
          have hren_eq : ren (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a) =
              MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a := by
            simp only [ren, map_sub, map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C,
              Matrix.cons_val_zero, Matrix.cons_val_one]
            ring
          rw [hren_eq, Ideal.Quotient.eq_zero_iff_mem]
          exact Ideal.subset_span rfl
        let swap_q : (MvPolynomial (Fin 2) R_V ⧸ I_a) →+* (MvPolynomial (Fin 2) R_V ⧸ I_a) :=
          Ideal.Quotient.lift I_a ((Ideal.Quotient.mk I_a).comp ren) hker_ren
        have hswap_inv : swap_q.comp swap_q = RingHom.id _ := by
          apply Ideal.Quotient.ringHom_ext
          apply MvPolynomial.ringHom_ext
          · intro r
            simp [swap_q, ren]
          · intro j
            fin_cases j <;> simp [swap_q, ren]
        have hIso_swap : CategoryTheory.IsIso (CommRingCat.ofHom swap_q) :=
          ⟨⟨CommRingCat.ofHom swap_q, CommRingCat.hom_ext hswap_inv, CommRingCat.hom_ext hswap_inv⟩⟩
        have _ : CategoryTheory.IsIso (AlgebraicGeometry.Spec.map (CommRingCat.ofHom swap_q)) :=
          inferInstance
        have _ : AlgebraicGeometry.Etale e := hEt_e
        let e_swap := e ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom swap_q)
        have hEt_eswap : AlgebraicGeometry.Etale e_swap := inferInstance
        have heswap_comm : W_et.ι ≫ g_Y = e_swap ≫ AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((Ideal.Quotient.mk I_a).comp MvPolynomial.C)) := by
          rw [he_comm]
          simp only [e_swap, Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
          congr 2
          apply CommRingCat.hom_ext
          ext r
          simp [swap_q, ren, I_a]
        obtain ⟨W_u, e_sm, hWu_mem, hEt_esm, hesm_comm, hPull⟩ :=
          hNodalAwaySmooth0 Y g_Y W_et a e_swap hEt_eswap heswap_comm
        have hswap_X0 : swap_q (Ideal.Quotient.mk I_a (MvPolynomial.X 0)) =
            Ideal.Quotient.mk I_a (MvPolynomial.X 1) := by
          simp [swap_q, ren]
        refine ⟨W_u, e_sm, ?_, hEt_esm, hesm_comm, ?_⟩
        · intro y
          rw [hWu_mem]
          constructor
          · rintro ⟨hy, hnot⟩
            refine ⟨hy, fun hin => hnot ?_⟩
            change swap_q (Ideal.Quotient.mk I_a (MvPolynomial.X 0)) ∈
              (e.base ⟨y, hy⟩).asIdeal
            rwa [hswap_X0]
          · rintro ⟨hy, hnot⟩
            refine ⟨hy, fun hin => hnot ?_⟩
            have h1 : swap_q (Ideal.Quotient.mk I_a (MvPolynomial.X 0)) ∈
                (e.base ⟨y, hy⟩).asIdeal := hin
            rwa [hswap_X0] at h1
        · intro S _ ψ_Wu ψ_Wet hψ_comm
          rw [hPull ψ_Wu ψ_Wet hψ_comm]
          change (AlgebraicGeometry.Spec.preimage ((ψ_Wet ≫ e) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom swap_q))).hom _ = _
          rw [AlgebraicGeometry.Spec.preimage_comp, AlgebraicGeometry.Spec.preimage_map]
          exact congrArg (AlgebraicGeometry.Spec.preimage (ψ_Wet ≫ e)).hom hswap_X0

    have hFieldPrimeBot : ∀ {L : Type u} [Field L] (q : PrimeSpectrum L), q.asIdeal = ⊥ := by
      intro L _ q
      ext x
      simp only [Ideal.mem_bot]
      exact ⟨fun hx => Classical.byContradiction fun hne =>
        q.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ hx (isUnit_iff_ne_zero.mpr hne)),
        fun h => h.symm ▸ q.asIdeal.zero_mem⟩
    have hFlatDomInj : ∀ {R₀ S₀ : Type u} [CommRing R₀] [CommRing S₀] [IsDomain R₀] [IsDomain S₀]
        (ψ : R₀ →+* S₀),
        AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) →
        Function.Injective ψ := by
      intro R₀ S₀ _ _ _ _ ψ hEt
      have hFlat : AlgebraicGeometry.Flat (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) :=
        inferInstance
      have hGen : GeneralizingMap (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)).base :=
        @AlgebraicGeometry.Flat.generalizingMap _ _ _ hFlat
      let p_bot : PrimeSpectrum R₀ := ⟨⊥, ⟨bot_ne_top, fun hab => mul_eq_zero.mp hab⟩⟩
      let q_bot : PrimeSpectrum S₀ := ⟨⊥, ⟨bot_ne_top, fun hab => mul_eq_zero.mp hab⟩⟩
      have h_spec : p_bot ⤳ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)).base q_bot :=
        (PrimeSpectrum.le_iff_specializes p_bot _).mp bot_le
      obtain ⟨q', hq'_spec, hq'_eq⟩ := hGen h_spec
      have hq'_le : q'.asIdeal ≤ q_bot.asIdeal :=
        (PrimeSpectrum.le_iff_specializes q' q_bot).mpr hq'_spec
      have hq'_eq_bot : q' = q_bot := PrimeSpectrum.ext (le_bot_iff.mp hq'_le)
      rw [hq'_eq_bot] at hq'_eq
      rw [RingHom.injective_iff_ker_eq_bot, RingHom.ker_eq_comap_bot]
      exact congrArg PrimeSpectrum.asIdeal hq'_eq

    have hEtaleImgIntegral : ∀ {R₀ B₀ : Type u} [CommRing R₀] [CommRing B₀]
        (ψ₀ : R₀ →+* B₀) (hEt₀ : ψ₀.Etale)
        (f_B : B₀ →+* F) (E : Subfield F)
        (hImg : ∀ r : R₀, f_B (ψ₀ r) ∈ E) (b : B₀),
        IsIntegral ↥E (f_B b) := by
      intro R₀ B₀ _ _ ψ₀ hEt₀ f_B E hImg b
      let _ : Algebra R₀ B₀ := ψ₀.toAlgebra
      have _ : Algebra.Etale R₀ B₀ := RingHom.Etale.toAlgebra hEt₀
      let ρ_E : R₀ →+* ↥E := (f_B.comp ψ₀).codRestrict E.toSubring hImg
      let _ : Algebra R₀ ↥E := ρ_E.toAlgebra
      let _ : Algebra R₀ F := (f_B.comp ψ₀).toAlgebra
      have _ : IsScalarTower R₀ ↥E F := IsScalarTower.of_algebraMap_eq' rfl
      have _ : Algebra.Etale ↥E (TensorProduct R₀ ↥E B₀) := Algebra.Etale.baseChange R₀ B₀ ↥E
      have hFinT : Module.Finite ↥E (TensorProduct R₀ ↥E B₀) := by
        obtain ⟨I, hFinI, Ai, instCR, instAlg, ev, hFinAi⟩ :=
          (Algebra.Etale.iff_exists_algEquiv_prod ↥E (TensorProduct R₀ ↥E B₀)).mp inferInstance
        let _ := hFinI
        let _ := instCR
        let _ := instAlg
        have _ : ∀ i : I, Module.Finite ↥E (Ai i) := fun i => (hFinAi i).1
        exact Module.Finite.equiv ev.symm.toLinearEquiv
      have _ : Algebra.IsIntegral ↥E (TensorProduct R₀ ↥E B₀) :=
        Algebra.IsIntegral.of_finite ↥E (TensorProduct R₀ ↥E B₀)
      let f_alg : B₀ →ₐ[R₀] F := { toRingHom := f_B, commutes' := fun _ => rfl }
      let μ : TensorProduct R₀ ↥E B₀ →ₐ[↥E] F :=
        Algebra.TensorProduct.lift (Algebra.ofId ↥E F) f_alg (fun _ _ => Commute.all _ _)
      have hb_eq : f_B b = μ ((1 : ↥E) ⊗ₜ[R₀] b) := by
        dsimp only [μ]
        rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
        rfl
      rw [hb_eq]
      exact IsIntegral.map μ (Algebra.IsIntegral.isIntegral ((1 : ↥E) ⊗ₜ[R₀] b))

    let pt_F : AlgebraicGeometry.Spec (CommRingCat.of F) :=
      ⟨⊥, ⟨bot_ne_top, fun hab => mul_eq_zero.mp hab⟩⟩
    have hPz_eq : P_z = (g_Z.base (ψ_Z.base mW)).asIdeal := by
      change (g_X.base (ψ_X.base mW)).asIdeal = _
      rw [← hpX_gZ]
      have h1 : (ψ_X ≫ p_X ≫ g_Z).base mW = (ψ_Z ≫ g_Z).base mW := by
        rw [← Category.assoc, hψX_pX]
      exact congrArg PrimeSpectrum.asIdeal h1
    have hComap_θ : Ideal.comap θ_V (IsLocalRing.maximalIdeal ↥W_target) = P_z := by
      rw [← hmW]
      change ((AlgebraicGeometry.Spec.map (AlgebraicGeometry.Spec.preimage (ψ_X ≫ g_X))).base mW).asIdeal =
        ((ψ_X ≫ g_X).base mW).asIdeal
      rw [AlgebraicGeometry.Spec.map_preimage]
    let α_V : ↥V →+* F := W_target.subtype.comp θ_V
    have hαV_eq : α_V = (AlgebraicGeometry.Spec.preimage (η_Z ≫ g_Z)).hom := by
      have h1 : AlgebraicGeometry.Spec.map (CommRingCat.ofHom W_target.subtype) ≫ (ψ_X ≫ g_X) =
          η_Z ≫ g_Z := by
        rw [← Category.assoc, hη_ψX, ← hpX_gZ, ← Category.assoc, hη_pX]
      change (AlgebraicGeometry.Spec.preimage (ψ_X ≫ g_X) ≫ CommRingCat.ofHom W_target.subtype).hom = _
      rw [← AlgebraicGeometry.Spec.preimage_map (CommRingCat.ofHom W_target.subtype),
        ← AlgebraicGeometry.Spec.preimage_comp, h1]
    have hInj_αV : Function.Injective α_V := by
      rw [RingHom.injective_iff_ker_eq_bot, RingHom.ker_eq_comap_bot]
      have hbot : pt_F.asIdeal = ⊥ := rfl
      rw [← hbot, hαV_eq]
      change ((AlgebraicGeometry.Spec.map (AlgebraicGeometry.Spec.preimage (η_Z ≫ g_Z))).base pt_F).asIdeal = ⊥
      rw [AlgebraicGeometry.Spec.map_preimage]
      exact hgZ_gen_bot pt_F
    have hθ_ne : ∀ c : ↥V, c ≠ 0 → θ_V c ≠ 0 := by
      intro c hc h0
      apply hc
      apply hInj_αV
      change W_target.subtype (θ_V c) = α_V 0
      rw [h0, map_zero, map_zero]

    have hZ_gen_param : ∃ (V_Z : Z.Opens) (hVZ : AlgebraicGeometry.IsAffineOpen V_Z)
        (φ_Z : Z.presheaf.obj (Opposite.op V_Z) ⟶ CommRingCat.of F)
        (t₀ : F),
        η_Z.base pt_F ∈ V_Z ∧
        @IsFractionRing ↑(Z.presheaf.obj (Opposite.op V_Z)) _ F _ φ_Z.hom.toAlgebra ∧
        AlgebraicGeometry.Spec.map φ_Z ≫ hVZ.fromSpec = η_Z ∧
        t₀ ∈ Set.range φ_Z.hom ∧
        (∀ P : Polynomial ↥V, P ≠ 0 → Polynomial.eval₂ α_V t₀ P ≠ 0) := by
      have hSmoothZ_at_η : ∃ (W_Z : Z.Opens)
          (e_Z : W_Z.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial ↥V))),
          η_Z.base pt_F ∈ W_Z ∧
          AlgebraicGeometry.Etale e_Z ∧
          W_Z.ι ≫ g_Z = e_Z ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) := by
        rcases hSS_Z.2.2.2.2 (η_Z.base pt_F) with ⟨W_Z, e_Z, hmem, hEt, hcomm⟩ |
            ⟨W_Z0, a_Z, e_Z0, hmem0, ha_ne, hEt0, hcomm0⟩
        · exact ⟨W_Z, e_Z, hmem, hEt, hcomm⟩
        · obtain ⟨W_u, e_sm, hWu_mem, hEt_sm, hcomm_sm, _⟩ :=
            hNodalAwaySmooth0 Z g_Z W_Z0 a_Z e_Z0 hEt0 hcomm0
          refine ⟨W_u, e_sm, (hWu_mem (η_Z.base pt_F)).mpr ⟨hmem0, ?_⟩, hEt_sm, hcomm_sm⟩
          intro hx0_mem
          let pt_WZ0 : ↥W_Z0.toScheme := ⟨η_Z.base pt_F, hmem0⟩
          have h_id : ((W_Z0.ι ≫ g_Z).base pt_WZ0).asIdeal = ⊥ :=
            hgZ_gen_bot pt_F
          rw [hcomm0] at h_id
          have ha_mem : a_Z ∈ (⊥ : Ideal ↥V) := by
            rw [← h_id]
            change Ideal.Quotient.mk _ (MvPolynomial.C a_Z) ∈ (e_Z0.base pt_WZ0).asIdeal
            have hrel : Ideal.Quotient.mk
                (Ideal.span {MvPolynomial.X (0 : Fin 2) * MvPolynomial.X 1 - MvPolynomial.C a_Z})
                (MvPolynomial.C a_Z) =
                Ideal.Quotient.mk _ (MvPolynomial.X 0) *
                  Ideal.Quotient.mk _ (MvPolynomial.X 1) := by
              rw [← map_mul, eq_comm, Ideal.Quotient.eq]
              exact Ideal.subset_span rfl
            rw [hrel]
            exact Ideal.mul_mem_right _ (e_Z0.base pt_WZ0).asIdeal hx0_mem
          exact ha_ne ha_mem
      obtain ⟨W_Z, e_Z, hη_WZ, hEt_eZ, heZ_comm⟩ := hSmoothZ_at_η
      obtain ⟨V_Z, hVZ, hη_VZ, hVZ_sub⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := η_Z.base pt_F) (U := W_Z) hη_WZ
      have hVZ_le : V_Z ≤ W_Z := hVZ_sub
      have _ : AlgebraicGeometry.IsIntegral Z := hSS_Z.1
      have _ : Nonempty V_Z := ⟨⟨η_Z.base pt_F, hη_VZ⟩⟩
      obtain ⟨φ_Z, hFrac_Z, hφZ_spec⟩ := hFunc_Z V_Z hVZ ⟨⟨η_Z.base pt_F, hη_VZ⟩⟩
      let A_Z := ↑(Z.presheaf.obj (Opposite.op V_Z))
      have _ : IsDomain A_Z := inferInstance
      let _ : Algebra A_Z F := φ_Z.hom.toAlgebra
      have hInj_φZ : Function.Injective φ_Z.hom :=
        @IsFractionRing.injective A_Z _ F _ _ hFrac_Z
      have _ : AlgebraicGeometry.Etale e_Z := hEt_eZ
      let e_VZ : AlgebraicGeometry.Spec (Z.presheaf.obj (Opposite.op V_Z)) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of (Polynomial ↥V)) :=
        hVZ.isoSpec.inv ≫ Z.homOfLE hVZ_le ≫ e_Z
      have hEt_eVZ : AlgebraicGeometry.Etale e_VZ := inferInstance
      let ψ_Z_ring : Polynomial ↥V →+* A_Z := (AlgebraicGeometry.Spec.preimage e_VZ).hom
      have hEt_ψZ : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_Z_ring)) := by
        change AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (AlgebraicGeometry.Spec.preimage e_VZ))
        rw [AlgebraicGeometry.Spec.map_preimage]
        exact hEt_eVZ
      have hInj_ψZ : Function.Injective ψ_Z_ring := hFlatDomInj ψ_Z_ring hEt_ψZ
      have hC_ψZ : ∀ c : ↥V, φ_Z.hom (ψ_Z_ring (Polynomial.C c)) = α_V c := by
        intro c
        have h_comp : AlgebraicGeometry.Spec.map φ_Z ≫ e_VZ ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) = η_Z ≫ g_Z := by
          change AlgebraicGeometry.Spec.map φ_Z ≫ (hVZ.isoSpec.inv ≫ Z.homOfLE hVZ_le ≫ e_Z) ≫ _ = _
          rw [Category.assoc, Category.assoc, ← heZ_comm,
            ← Category.assoc (Z.homOfLE hVZ_le), AlgebraicGeometry.Scheme.homOfLE_ι,
            ← Category.assoc hVZ.isoSpec.inv, AlgebraicGeometry.IsAffineOpen.isoSpec_inv_ι,
            ← Category.assoc, hφZ_spec]
        rw [hαV_eq, ← h_comp, AlgebraicGeometry.Spec.preimage_comp,
          AlgebraicGeometry.Spec.preimage_comp, AlgebraicGeometry.Spec.preimage_map,
          AlgebraicGeometry.Spec.preimage_map]
        rfl
      let t₀ : F := φ_Z.hom (ψ_Z_ring Polynomial.X)
      have heval_eq : Polynomial.eval₂RingHom α_V t₀ = φ_Z.hom.comp ψ_Z_ring := by
        apply Polynomial.ringHom_ext'
        · ext c
          simp only [RingHom.comp_apply, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
          exact (hC_ψZ c).symm
        · simp [t₀]
      refine ⟨V_Z, hVZ, φ_Z, t₀, hη_VZ, hFrac_Z, hφZ_spec, ⟨ψ_Z_ring Polynomial.X, rfl⟩, ?_⟩
      intro P hP_ne h0
      apply hP_ne
      apply hInj_ψZ
      apply hInj_φZ
      change (φ_Z.hom.comp ψ_Z_ring) P = (φ_Z.hom.comp ψ_Z_ring) 0
      rw [← heval_eq, Polynomial.coe_eval₂RingHom, h0, Polynomial.eval₂_zero]

    have hSmoothGenExtract : ∀ (W_sm : X.Opens)
        (e_sm : W_sm.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial ↥V)))
        (j_η : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ W_sm.toScheme),
        AlgebraicGeometry.Etale e_sm →
        W_sm.ι ≫ g_X = e_sm ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) →
        j_η ≫ W_sm.ι = η_X →
        let ξ_F := (AlgebraicGeometry.Spec.preimage (j_η ≫ e_sm)).hom Polynomial.X
        (∀ P : Polynomial ↥V, P ≠ 0 → Polynomial.eval₂ α_V ξ_F P ≠ 0) ∧
        (∃ Q : Polynomial (Polynomial ↥V),
          Q ≠ 0 ∧
          Polynomial.eval₂ (Polynomial.eval₂RingHom α_V ξ_F) (W_target.subtype t_div) Q = 0) := by
      intro W_sm e_sm j_η hEt_esm hesm_comm hjη_ι ξ_F
      obtain ⟨V_Z, hVZ, φ_Z, t₀, hη_VZ, hFrac_Z, hφZ_spec, ⟨a_t0, ha_t0⟩, ht0_trans⟩ := hZ_gen_param
      have hxη_Wsm : η_X.base pt_F ∈ W_sm := by
        rw [← hjη_ι]; exact (j_η.base pt_F).2
      have hxη_VZ : η_X.base pt_F ∈ (TopologicalSpace.Opens.map p_X.base).obj V_Z := by
        change p_X.base (η_X.base pt_F) ∈ V_Z
        have h1 : p_X.base (η_X.base pt_F) = η_Z.base pt_F := by rw [← hη_pX]; rfl
        rw [h1]; exact hη_VZ
      obtain ⟨W_0, hW0, hxη_W0, hW0_sub⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
