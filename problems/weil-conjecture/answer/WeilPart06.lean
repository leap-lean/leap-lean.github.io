      have hcomap_Qbar'' : Ideal.comap q_F Qbar'' = Q'' := by
        rw [Ideal.comap_map_of_surjective q_F Ideal.Quotient.mk_surjective Q'']
        have hker : Ideal.comap q_F ⊥ = I₁ := Ideal.mk_ker
        rw [hker, sup_eq_left.mpr hI₁_le_Q'']
      have hQbar''_prime : Qbar''.IsPrime := by
        refine Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective ?_
        simpa [q_F, Ideal.mk_ker] using hI₁_le_Q''
      haveI : Qbar''.IsPrime := hQbar''_prime
      have hqbar₀_le_Qbar'' : qbar₀ ≤ Qbar'' := by
        by_contra hnot
        rw [SetLike.not_le_iff_exists] at hnot
        obtain ⟨z, hz_q₀, hz_not⟩ := hnot
        have he_mem : e_idem ∈ Qbar'' := by
          have hmul : e_idem * z ∈ Qbar'' := by rw [he_ann z hz_q₀]; exact Qbar''.zero_mem
          exact (hQbar''_prime.mem_or_mem hmul).resolve_right hz_not
        have hθ₀_F : q_F θ₀ ∈ Qbar'' := by
          change q_F (r_α * r_e) ∈ Qbar''
          rw [map_mul, hr_e]
          exact Qbar''.mul_mem_left _ he_mem
        have hθ₀_Q'' : θ₀ ∈ Q'' := by rwa [← hcomap_Qbar'']
        have hθS_pθ : θ_S ∈ p_θ := by
          rw [← hQ''_under]
          exact hθ₀_Q''
        exact hθS_not_pθ hθS_pθ
      have hqbar₀_eq : qbar₀ = Qbar'' := hqbar₀_max.eq_of_le hQbar''_prime.ne_top hqbar₀_le_Qbar''
      have hq₀_eq : q₀ = Q'' := by
        rw [← hcomap_qbar₀, hqbar₀_eq, hcomap_Qbar'']
      exact hQ'_le_Q''.trans_eq hq₀_eq.symm
    let M_θ : Submonoid ↥R₁ := p_θ.primeCompl.map (algebraMap ↥S_θ ↥R₁)
    let T₀ : Type u := Localization M_θ
    have hClearDenom : ∀ t : q₀.primeCompl,
        ∃ (u₀ : ↥R₁) (s_θ : p_θ.primeCompl), t.1.1 * u₀.1 = s_θ.1.1 := by
      intro t
      have hunit : IsUnit (algebraMap ↥R₁ T₀ t.1) := by
        by_contra hnot
        have hne_top : Ideal.span {algebraMap ↥R₁ T₀ t.1} ≠ ⊤ :=
          mt Ideal.span_singleton_eq_top.mp hnot
        obtain ⟨M_max, hM_max, hle_M⟩ := Ideal.exists_le_maximal _ hne_top
        haveI : M_max.IsPrime := hM_max.isPrime
        let Q' : Ideal ↥R₁ := Ideal.comap (algebraMap ↥R₁ T₀) M_max
        haveI : Q'.IsPrime := Ideal.comap_isPrime _ M_max
        have ht_Q' : t.1 ∈ Q' :=
          hle_M (Ideal.mem_span_singleton_self _)
        have hQ'_under : Ideal.under ↥S_θ Q' ≤ p_θ := by
          intro s hs
          by_contra hs_not
          have hm_mem : algebraMap ↥S_θ ↥R₁ s ∈ M_θ := ⟨s, hs_not, rfl⟩
          have hs_unit : IsUnit (algebraMap ↥R₁ T₀ (algebraMap ↥S_θ ↥R₁ s)) :=
            IsLocalization.map_units T₀ ⟨_, hm_mem⟩
          exact hM_max.ne_top (M_max.eq_top_of_isUnit_mem hs hs_unit)
        exact t.2 (hGoingUpUnique Q' hQ'_under ht_Q')
      obtain ⟨u_inv, hu_inv⟩ := hunit
      let w : T₀ := ↑(u_inv⁻¹)
      have htw : algebraMap ↥R₁ T₀ t.1 * w = 1 := by
        dsimp [w]; rw [← hu_inv, Units.mul_inv]
      obtain ⟨⟨u₁, m₁_t⟩, hwm⟩ := IsLocalization.surj M_θ w
      have heq_T₀ : algebraMap ↥R₁ T₀ (t.1 * u₁) = algebraMap ↥R₁ T₀ m₁_t.1 := by
        rw [map_mul, ← hwm, ← mul_assoc, htw, one_mul]
      obtain ⟨m₂_t, hm₂_eq⟩ := (IsLocalization.eq_iff_exists M_θ T₀).mp heq_T₀
      have hm_prod : (m₂_t * m₁_t).1 ∈ M_θ := (m₂_t * m₁_t).2
      rcases hm_prod with ⟨s_θ, hs_θ, hms_eq⟩
      refine ⟨m₂_t.1 * u₁, ⟨s_θ, hs_θ⟩, ?_⟩
      have hR₁_eq : t.1 * (m₂_t.1 * u₁) = algebraMap ↥S_θ ↥R₁ s_θ := by
        calc
          t.1 * (m₂_t.1 * u₁) = m₂_t.1 * (t.1 * u₁) := by ring
          _ = m₂_t.1 * m₁_t.1 := hm₂_eq
          _ = (m₂_t * m₁_t).1 := rfl
          _ = algebraMap ↥S_θ ↥R₁ s_θ := hms_eq.symm
      exact congrArg Subtype.val hR₁_eq
    let C : Type u := Localization.AtPrime p_θ
    have hpθ_units : ∀ y : p_θ.primeCompl, IsUnit (algebraMap ↥S_θ B_m y.1) :=
      fun y => IsLocalRing.notMem_maximalIdeal.mp y.2
    let ψ : C →+* B_m := IsLocalization.lift (M := p_θ.primeCompl) (S := C) hpθ_units
    have hψ_eq : ∀ x : ↥S_θ, ψ (algebraMap ↥S_θ C x) = x.1 :=
      fun x => IsLocalization.lift_eq (M := p_θ.primeCompl) (S := C) hpθ_units x
    have hψ_surj : Function.Surjective ψ := by
      letI : Algebra C B_m := ψ.toAlgebra
      obtain ⟨G_R, hG_R⟩ := Module.Finite.fg_top (R := A₁) (M := ↥R₁)
      classical
      let G_B : Finset B_m := G_R.image Subtype.val
      have hR₁_in_span : ∀ w : ↥R₁, (w : B_m) ∈ Submodule.span C (G_B : Set B_m) := by
        intro w
        have hw : w ∈ Submodule.span A₁ (G_R : Set ↥R₁) := by rw [hG_R]; trivial
        refine Submodule.span_induction ?_ ?_ ?_ ?_ hw
        · intro g hg
          exact Submodule.subset_span (Finset.mem_coe.mpr (Finset.mem_image_of_mem _ hg))
        · exact Submodule.zero_mem _
        · intro w₁ w₂ _ _ hw₁ hw₂
          exact Submodule.add_mem _ hw₁ hw₂
        · intro a w₁ _ hw₁
          let c_a : C := algebraMap ↥S_θ C (algebraMap A₁ ↥S_θ a)
          have hca : c_a • (w₁ : B_m) = ((a • w₁ : ↥R₁) : B_m) := by
            change ψ c_a * w₁.1 = a • w₁.1
            rw [hψ_eq, Algebra.smul_def]
            rfl
          rw [← hca]
          exact Submodule.smul_mem _ c_a hw₁
      have hTop_FG : (⊤ : Submodule C B_m).FG := by
        refine ⟨G_B, le_antisymm le_top ?_⟩
        intro z _
        obtain ⟨⟨x, t⟩, hzt⟩ := IsLocalization.surj q₀.primeCompl z
        have hzt' : z * t.1.1 = x.1 := hzt
        obtain ⟨u₀, s_θ, htu⟩ := hClearDenom t
        have hzs : z * s_θ.1.1 = (x * u₀).1 := by
          calc
            z * s_θ.1.1 = z * (t.1.1 * u₀.1) := by rw [htu]
            _ = (z * t.1.1) * u₀.1 := by ring
            _ = x.1 * u₀.1 := by rw [hzt']
        have hsC_unit : IsUnit (algebraMap ↥S_θ C s_θ.1) := IsLocalization.map_units C s_θ
        obtain ⟨u_C, hu_C⟩ := hsC_unit
        have hψ_uC : ψ ↑u_C = s_θ.1.1 := by rw [hu_C, hψ_eq]
        have hz_eq : z = (↑(u_C⁻¹) : C) • ((x * u₀ : ↥R₁) : B_m) := by
          change z = ψ ↑(u_C⁻¹) * (x * u₀).1
          rw [← hzs, ← hψ_uC]
          calc
            z = z * (ψ ↑u_C * ψ ↑(u_C⁻¹)) := by
              rw [← map_mul, Units.mul_inv, map_one, mul_one]
            _ = ψ ↑(u_C⁻¹) * (z * ψ ↑u_C) := by ring
        rw [hz_eq]
        exact Submodule.smul_mem _ _ (hR₁_in_span (x * u₀))
      let m_C : Ideal C := IsLocalRing.maximalIdeal C
      let J_smul : Ideal B_m :=
        { carrier := {y : B_m | y ∈ (m_C • (⊤ : Submodule C B_m) : Submodule C B_m)}
          add_mem' := fun hx hy => Submodule.add_mem (m_C • (⊤ : Submodule C B_m)) hx hy
          zero_mem' := Submodule.zero_mem (m_C • (⊤ : Submodule C B_m))
          smul_mem' := fun b {y} hy => by
            change b * y ∈ m_C • (⊤ : Submodule C B_m)
            refine Submodule.smul_induction_on hy ?_ ?_
            · intro c hc v _
              change b * (ψ c * v) ∈ m_C • (⊤ : Submodule C B_m)
              have heq : b * (ψ c * v) = c • (b * v) := by
                change b * (ψ c * v) = ψ c * (b * v); ring
              rw [heq]
              exact Submodule.smul_mem_smul hc trivial
            · intro v₁ v₂ hv₁ hv₂
              rw [mul_add]
              exact Submodule.add_mem _ hv₁ hv₂ }
      have hmB_le_smul : m_B ≤ J_smul := by
        dsimp only [m_B]
        rw [← hMax, Ideal.map_le_iff_le_comap]
        intro a ha
        change algebraMap A₁ B_m a ∈ m_C • (⊤ : Submodule C B_m)
        let c_a : C := algebraMap ↥S_θ C (algebraMap A₁ ↥S_θ a)
        have hca_mem : c_a ∈ m_C := by
          rw [IsLocalRing.mem_maximalIdeal]
          intro hu
          have hu_B : IsUnit (algebraMap A₁ B_m a) := by
            have : ψ c_a = algebraMap A₁ B_m a := hψ_eq (algebraMap A₁ ↥S_θ a)
            rw [← this]
            exact hu.map ψ
          exact (IsLocalRing.notMem_maximalIdeal.mpr hu_B) (hm₁_le ha)
        have heq : algebraMap A₁ B_m a = c_a • (1 : B_m) := by
          change algebraMap A₁ B_m a = ψ c_a * 1
          rw [mul_one, hψ_eq]
          rfl
        rw [heq]
        exact Submodule.smul_mem_smul hca_mem trivial
      have hπψ_surj : Function.Surjective (π.comp ψ) := by
        intro y
        have hy_top : y ∈ Algebra.adjoin κ ({abar} : Set κ') := by rw [habar_adjoin]; trivial
        refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hy_top
        · intro x hx
          rw [Set.mem_singleton_iff] at hx
          rw [hx]
          refine ⟨algebraMap ↥S_θ C θ_S, ?_⟩
          change π (ψ (algebraMap ↥S_θ C θ_S)) = abar
          rw [hψ_eq, hπ_θ]
        · intro u
          obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective u
          refine ⟨algebraMap ↥S_θ C (algebraMap A₁ ↥S_θ a), ?_⟩
          change π (ψ (algebraMap ↥S_θ C (algebraMap A₁ ↥S_θ a))) =
            algebraMap κ κ' (IsLocalRing.residue A₁ a)
          rw [hψ_eq]
          exact (IsLocalRing.ResidueField.map_residue (algebraMap A₁ B_m) a).symm
        · rintro y₁ y₂ _ _ ⟨c₁, hc₁⟩ ⟨c₂, hc₂⟩
          refine ⟨c₁ + c₂, ?_⟩
          change π (ψ (c₁ + c₂)) = y₁ + y₂
          rw [map_add, map_add]
          exact congrArg₂ (· + ·) hc₁ hc₂
        · rintro y₁ y₂ _ _ ⟨c₁, hc₁⟩ ⟨c₂, hc₂⟩
          refine ⟨c₁ * c₂, ?_⟩
          change π (ψ (c₁ * c₂)) = y₁ * y₂
          rw [map_mul, map_mul]
          exact congrArg₂ (· * ·) hc₁ hc₂
      let N_one : Submodule C B_m := Submodule.span C ({1} : Set B_m)
      have hle_sup : (⊤ : Submodule C B_m) ≤ N_one ⊔ m_C • (⊤ : Submodule C B_m) := by
        intro z _
        obtain ⟨c, hc⟩ := hπψ_surj (π z)
        have hdiff_mB : z - ψ c ∈ m_B := by
          rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub]
          exact sub_eq_zero.mpr hc.symm
        have hψc_N : ψ c ∈ N_one := by
          have : ψ c = c • (1 : B_m) := (mul_one (ψ c)).symm
          rw [this]
          exact Submodule.smul_mem N_one c (Submodule.subset_span (Set.mem_singleton 1))
        have hz_split : z = ψ c + (z - ψ c) := by abel
        rw [hz_split]
        exact Submodule.add_mem_sup hψc_N (hmB_le_smul hdiff_mB)
      have hjac : m_C ≤ (⊥ : Ideal C).jacobson :=
        (IsLocalRing.jacobson_eq_maximalIdeal (⊥ : Ideal C) bot_ne_top).symm.le
      have htop_le : (⊤ : Submodule C B_m) ≤ N_one :=
        Submodule.le_of_le_smul_of_le_jacobson_bot hTop_FG hjac hle_sup
      intro z
      have hz_N : z ∈ N_one := htop_le trivial
      rw [Submodule.mem_span_singleton] at hz_N
      obtain ⟨c, rfl⟩ := hz_N
      exact ⟨c, (mul_one (ψ c)).symm⟩
    refine ⟨θ, hIntθ, ⟨hpθ_units, ?_, ?_⟩⟩
    · intro z
      obtain ⟨c, rfl⟩ := hψ_surj z
      obtain ⟨⟨x, s⟩, hcs⟩ := IsLocalization.surj p_θ.primeCompl c
      refine ⟨⟨x, s⟩, ?_⟩
      have hval := congrArg ψ hcs
      simpa [map_mul, hψ_eq] using hval
    · intro x y hxy
      exact ⟨1, by simp [Subtype.ext hxy]⟩
  have h_step4 : ∀ (A₁ B_m : Type u) [CommRing A₁] [IsDomain A₁]
      (hICA₁ : IsIntegrallyClosed A₁)
      [CommRing B_m] [IsLocalRing B_m] [Algebra A₁ B_m]
      [Module.IsTorsionFree A₁ B_m] [Algebra.FormallyUnramified A₁ B_m]
      (θ : B_m), _root_.IsIntegral A₁ θ →
      IsLocalization
        (Ideal.comap (algebraMap ↥(Algebra.adjoin A₁ ({θ} : Set B_m)) B_m)
          (IsLocalRing.maximalIdeal B_m)).primeCompl B_m →
      IsDomain B_m := by
    clear! A₀ B m
    intro A₁ B_m _ _ hICA₁ _ _ _ _ _ θ hIntθ hLocθ
    let N₁ : Submonoid A₁ := nonZeroDivisors A₁
    let L₁ : Type u := FractionRing A₁
    let M_E : Submonoid B_m := Algebra.algebraMapSubmonoid B_m N₁
    let E_m : Type u := Localization M_E
    let ι_E : B_m →+* E_m := algebraMap B_m E_m
    have hinj_A₁L₁ : Function.Injective (algebraMap A₁ L₁) := IsFractionRing.injective A₁ L₁
    have hME_le : M_E ≤ nonZeroDivisors B_m := by
      intro m hm
      rcases hm with ⟨a, ha, rfl⟩
      rw [mem_nonZeroDivisors_iff_right]
      intro x hxm
      have ha0 : a ≠ 0 := nonZeroDivisors.ne_zero ha
      have hsmul : a • x = 0 := by rw [Algebra.smul_def, mul_comm, hxm]
      exact (smul_eq_zero.mp hsmul).resolve_left ha0
    have hinj_E : Function.Injective ι_E := IsLocalization.injective E_m hME_le
    haveI : Nontrivial E_m := ⟨⟨0, 1, fun h => zero_ne_one (hinj_E (by simpa using h))⟩⟩
    have hN₁_units : ∀ y : N₁, IsUnit (algebraMap A₁ E_m y.1) := by
      intro y
      rw [IsScalarTower.algebraMap_apply A₁ B_m E_m]
      let m_y : M_E := ⟨algebraMap A₁ B_m y.1, ⟨y.1, y.2, rfl⟩⟩
      exact IsLocalization.map_units E_m m_y
    let φ_LE : L₁ →+* E_m := IsLocalization.lift (M := N₁) (S := L₁) hN₁_units
    letI : Algebra L₁ E_m := φ_LE.toAlgebra
    haveI : IsScalarTower A₁ L₁ E_m := IsScalarTower.of_algebraMap_eq fun a =>
      show algebraMap A₁ E_m a = φ_LE (algebraMap A₁ L₁ a) from
        (IsLocalization.lift_eq (M := N₁) (S := L₁) hN₁_units a).symm
    let θ_E : E_m := ι_E θ
    let ev_L : Polynomial L₁ →ₐ[L₁] E_m := Polynomial.aeval θ_E
    let J_L : Ideal (Polynomial L₁) := RingHom.ker ev_L.toRingHom
    obtain ⟨f₀, hf₀_monic, hf₀_eval⟩ := hIntθ
    have hf₀_aeval : Polynomial.aeval θ f₀ = 0 := by
      rw [Polynomial.aeval_def]; exact hf₀_eval
    let fbar₀ : Polynomial L₁ := Polynomial.map (algebraMap A₁ L₁) f₀
    have hfbar₀_monic : fbar₀.Monic := hf₀_monic.map (algebraMap A₁ L₁)
    have hfbar₀_JL : fbar₀ ∈ J_L := by
      change ev_L (Polynomial.map (algebraMap A₁ L₁) f₀) = 0
      rw [Polynomial.aeval_map_algebraMap L₁ θ_E f₀]
      have : Polynomial.aeval θ_E f₀ = ι_E (Polynomial.aeval θ f₀) :=
        Polynomial.aeval_algHom_apply (IsScalarTower.toAlgHom A₁ B_m E_m) θ f₀
      rw [this, hf₀_aeval, map_zero]
    let g₀ : Polynomial L₁ := Submodule.IsPrincipal.generator J_L
    have hJL_gen : J_L = Ideal.span {g₀} := (Submodule.IsPrincipal.span_singleton_generator J_L).symm
    have hg₀_dvd_fbar₀ : g₀ ∣ fbar₀ := Ideal.mem_span_singleton.mp (hJL_gen ▸ hfbar₀_JL)
    have hg₀_ne : g₀ ≠ 0 := by
      intro hg0
      rw [hg0, zero_dvd_iff] at hg₀_dvd_fbar₀
      exact hfbar₀_monic.ne_zero hg₀_dvd_fbar₀
    have hc₀_ne : g₀.leadingCoeff ≠ 0 := Polynomial.leadingCoeff_ne_zero.mpr hg₀_ne
    let P₀ : Polynomial L₁ := Polynomial.C g₀.leadingCoeff⁻¹ * g₀
    have hP₀_monic : P₀.Monic := by
      rw [Polynomial.Monic, Polynomial.leadingCoeff_mul, Polynomial.leadingCoeff_C,
        inv_mul_cancel₀ hc₀_ne]
    have hJL_P₀ : J_L = Ideal.span {P₀} := by
      rw [hJL_gen]
      apply le_antisymm
      · rw [Ideal.span_singleton_le_iff_mem, Ideal.mem_span_singleton]
        refine ⟨Polynomial.C g₀.leadingCoeff, ?_⟩
        dsimp [P₀]
        rw [mul_comm, ← mul_assoc, ← Polynomial.C_mul, mul_inv_cancel₀ hc₀_ne,
          Polynomial.C_1, one_mul]
      · rw [Ideal.span_singleton_le_iff_mem, Ideal.mem_span_singleton]
        exact ⟨Polynomial.C g₀.leadingCoeff⁻¹, mul_comm _ _⟩
    have hP₀_mem_JL : P₀ ∈ J_L := by
      rw [hJL_P₀]; exact Ideal.mem_span_singleton_self P₀
    have hP₀_eval : ev_L P₀ = 0 := hP₀_mem_JL
    have hP₀_dvd_fbar₀ : P₀ ∣ fbar₀ := Ideal.mem_span_singleton.mp (hJL_P₀ ▸ hfbar₀_JL)
    have hGaussLift : ∀ G : Polynomial L₁, G.Monic → G ∣ fbar₀ →
        ∃ Q : Polynomial A₁, Polynomial.map (algebraMap A₁ L₁) Q = G ∧ Q.Monic := by
      intro G hG_monic hG_dvd
      have hmem_ic : G ∈ Polynomial.lifts (algebraMap ↥(integralClosure A₁ L₁) L₁) :=
        integralClosure.mem_lifts_of_monic_of_dvd_map L₁ hf₀_monic hG_monic hG_dvd
      have hmem_A₁ : G ∈ Polynomial.lifts (algebraMap A₁ L₁) := by
        rw [Polynomial.lifts_iff_coeff_lifts] at hmem_ic ⊢
        intro n
        obtain ⟨z, hz⟩ := hmem_ic n
        have hz_int : _root_.IsIntegral A₁ (G.coeff n) := by
          rw [← hz]; exact z.2
        exact (isIntegrallyClosed_iff L₁).mp hICA₁ hz_int
      obtain ⟨Q, hQ_map, _, hQ_monic⟩ := Polynomial.lifts_and_degree_eq_and_monic hmem_A₁ hG_monic
      exact ⟨Q, hQ_map, hQ_monic⟩
    obtain ⟨P₁, hP₁_map, hP₁_monic⟩ := hGaussLift P₀ hP₀_monic hP₀_dvd_fbar₀
    have haeval_P₁ : Polynomial.aeval θ P₁ = 0 := by
      apply hinj_E
      rw [map_zero]
      have : ι_E (Polynomial.aeval θ P₁) = Polynomial.aeval θ_E P₁ :=
        (Polynomial.aeval_algHom_apply (IsScalarTower.toAlgHom A₁ B_m E_m) θ P₁).symm
      rw [this, ← Polynomial.aeval_map_algebraMap L₁ θ_E P₁, hP₁_map]
      exact hP₀_eval
    have hP₁_dvd : ∀ q : Polynomial A₁, Polynomial.aeval θ q = 0 → P₁ ∣ q := by
      intro q hq
      have hq_JL : Polynomial.map (algebraMap A₁ L₁) q ∈ J_L := by
        change ev_L (Polynomial.map (algebraMap A₁ L₁) q) = 0
        rw [Polynomial.aeval_map_algebraMap L₁ θ_E q]
        have : Polynomial.aeval θ_E q = ι_E (Polynomial.aeval θ q) :=
          Polynomial.aeval_algHom_apply (IsScalarTower.toAlgHom A₁ B_m E_m) θ q
        rw [this, hq, map_zero]
      have hP₀_dvd_q : P₀ ∣ Polynomial.map (algebraMap A₁ L₁) q :=
        Ideal.mem_span_singleton.mp (hJL_P₀ ▸ hq_JL)
      have hmod_L : Polynomial.map (algebraMap A₁ L₁) q %ₘ P₀ = 0 :=
        (Polynomial.modByMonic_eq_zero_iff_dvd hP₀_monic).mpr hP₀_dvd_q
      have hmap_mod : Polynomial.map (algebraMap A₁ L₁) (q %ₘ P₁) = 0 := by
