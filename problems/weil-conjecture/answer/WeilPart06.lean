      rw [hτ_C_app b, Polynomial.eval_C]
    have hε_C : ε_A.comp Polynomial.C = ρ :=
      RingHom.ext hε_C_app
    have hε_u : ε_A u = 0 := by
      change Polynomial.eval 0 (τ_br u) = 0
      rw [hτ_u, Polynomial.eval_X]
    have hε_π : ε_A (Polynomial.C π) = 0 := by
      rw [hε_C_app π, hρ_π]
    have hε_X : ε_A Polynomial.X = ρ s_inv * ρ c := by
      change Polynomial.eval 0 (τ_br Polynomial.X) = ρ s_inv * ρ c
