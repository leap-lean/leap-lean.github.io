        have hMono : (eOrd ⟨⊥, hBotPrime⟩).1 ≤ (eOrd R_loc).1 := eOrd.monotone hBotLe
        have hEval : (eOrd R_loc).1 = r := congrArg Subtype.val (eOrd.apply_symm_apply ⟨r, hr, hDisj⟩)
        rwa [hp_bot_eq, hEval] at hMono
      have hp_bot_min : p_bot ∈ minimalPrimes S := by
