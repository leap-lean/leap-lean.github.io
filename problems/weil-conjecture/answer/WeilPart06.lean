      let : IsDomain ↑(H_sch.presheaf.obj (Opposite.op W_H)) :=
        AlgebraicGeometry.IsIntegral.component_integral W_H
      have hIC_WH : IsIntegrallyClosed ↑(H_sch.presheaf.obj (Opposite.op W_H)) :=
        IsIntegrallyClosed.of_equiv isoRing.commRingCatIsoToRingEquiv
      let : Algebra ↑(H_sch.presheaf.obj (Opposite.op W_H)) ↑(H_sch.presheaf.stalk z) :=
