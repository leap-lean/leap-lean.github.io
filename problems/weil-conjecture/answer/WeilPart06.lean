        change (IsLocalRing.residue ↥W) (φ_0.hom b) = 0 at hd
        rw [← RingHom.mem_ker, IsLocalRing.ker_residue] at hd
        have hb_pu : b ∈ p_u := by
          change b ∈ (hU0.primeIdealOf ⟨z_Q, hzQ⟩).asIdeal
