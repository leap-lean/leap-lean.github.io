      have h_pre := congrArg AlgebraicGeometry.Spec.preimage h_comp_spec
      rw [AlgebraicGeometry.Spec.preimage_map] at h_pre
      ext c
      have hc := congrArg (fun f => f.hom c) h_pre
      have h_lhs : (iso_K_RU.hom ≫ (U_K.ι ≫ p_K).appLE U_sp V_sm he_sm ≫ ψ_K).hom c =
