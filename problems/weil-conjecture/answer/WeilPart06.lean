        · exact Subtype.ext (inv_mul_cancel₀ hx0)
    classical
    let t_wit : Ideal B → F := fun q =>
      if h : (𝒯 q).Nonempty then ψ_B h.choose.1 * (ψ_B h.choose.2)⁻¹ else 0
    refine Set.Finite.subset (hℳ_fin.biUnion fun q _ => (hGauss_P (t_wit q)).1) ?_
    rintro W ⟨φ_B, b₁', b₂', hφB_sub, hP_φB, hb₂'_nm, hHomog'⟩
    let q_y : Ideal B := Ideal.comap φ_B (IsLocalRing.maximalIdeal ↥W)
    have _ : q_y.IsPrime := Ideal.IsPrime.comap φ_B
    have hb'_mem : (b₁', b₂') ∈ 𝒯 q_y := by
