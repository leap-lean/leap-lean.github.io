    have hCompact_Z : IsCompact Z_sing := hClosed_Z.isCompact
    have hEtale_comp : ∀ {X₁ X₂ X₃ : AlgebraicGeometry.Scheme.{u}} (f : X₁ ⟶ X₂) (g : X₂ ⟶ X₃),
        AlgebraicGeometry.Etale f → AlgebraicGeometry.Etale g → AlgebraicGeometry.Etale (f ≫ g) := by
      intro X₁ X₂ X₃ f g hf hg
      have _ : AlgebraicGeometry.SmoothOfRelativeDimension 0 f :=
        (AlgebraicGeometry.Etale.iff_smoothOfRelativeDimension_zero f).mp hf
      have _ : AlgebraicGeometry.SmoothOfRelativeDimension 0 g :=
        (AlgebraicGeometry.Etale.iff_smoothOfRelativeDimension_zero g).mp hg
      exact (AlgebraicGeometry.Etale.iff_smoothOfRelativeDimension_zero (f ≫ g)).mpr
        (by simpa using AlgebraicGeometry.smoothOfRelativeDimension_comp 0 0 f g)
    have hLocFin : ∀ y ∈ Z_sing, ∃ W_y : Set ↥Y, IsOpen W_y ∧ y ∈ W_y ∧ (W_y ∩ Z_sing).Finite := by
      intro y hy
      obtain ⟨U', u₀, e₁, e₂, hEt₁, hEt₂, hy_eq, _⟩ := hNodalOut y hy
      obtain ⟨V', hV', hu₀_V', _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := u₀) (U := ⊤) trivial
      let W_y : Set ↥Y := e₁.base '' (V' : Set ↥U')
      have hOpen_Wy : IsOpen W_y := e₁.isOpenMap (V' : Set ↥U') V'.isOpen
      have hy_Wy : y ∈ W_y := ⟨u₀, hu₀_V', hy_eq⟩
      have hV'_le : V' ≤ e₂ ⁻¹ᵁ ⊤ := fun _ _ => trivial
      obtain ⟨hEt_φV', hSpec_V'⟩ := hChart_S₀ e₂ hV' hV'_le
      let B' := ↑Γ(U', V')
      let φ_V' : CommRingCat.of R₀ ⟶ Γ(U', V') := ψ_S₀ ≫ e₂.appLE ⊤ V' hV'_le
      let _ : Algebra R₀ B' := φ_V'.hom.toAlgebra
      have _ : Algebra.Etale R₀ B' := RingHom.etale_algebraMap.mp hEt_φV'
      have hFin_fiber : (PrimeSpectrum.comap (algebraMap R₀ B') ⁻¹' {p₀}).Finite :=
        Algebra.QuasiFinite.finite_comap_preimage_singleton p₀
      let F_node : Set ↥Y :=
        e₁.base '' (hV'.fromSpec.base '' (PrimeSpectrum.comap (algebraMap R₀ B') ⁻¹' {p₀}))
      have hFin_F : F_node.Finite := (hFin_fiber.image hV'.fromSpec.base).image e₁.base
      refine ⟨W_y, hOpen_Wy, hy_Wy, hFin_F.subset ?_⟩
      rintro y₂ ⟨⟨u₂, hu₂_V', rfl⟩, hy₂_sing⟩
      have hu₂_node : e₂.base u₂ = p₀ := by
        by_contra hne_p₀
        have hNotAll : ¬ ∀ i : Fin 2, xbar i ∈ (e₂.base u₂).asIdeal :=
          mt (hp₀_iff (e₂.base u₂)).mp hne_p₀
        have hEx_i₀ : ∃ i₀ : Fin 2, xbar i₀ ∉ (e₂.base u₂).asIdeal := by
          by_contra hall_neg
          exact hNotAll fun i => Classical.not_not.mp fun hi => hall_neg ⟨i, hi⟩
        obtain ⟨i₀, hi₀_not⟩ := hEx_i₀
        obtain ⟨U_tilde, u_tilde, e₁_tilde, e₂_tilde, hEt₁_tilde, hEt₂_tilde, hu_tilde_eq, hm₀_tilde⟩ :=
          hNodalOut (e₁.base u₂) hy₂_sing
        obtain ⟨w, hw_fst, hw_snd⟩ :=
          AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback u₂ u_tilde hu_tilde_eq.symm
        let P_pb := CategoryTheory.Limits.pullback e₁ e₁_tilde
        let fst_P : P_pb ⟶ U' := CategoryTheory.Limits.pullback.fst e₁ e₁_tilde
        let snd_P : P_pb ⟶ U_tilde := CategoryTheory.Limits.pullback.snd e₁ e₁_tilde
        have hEt_fst : AlgebraicGeometry.Etale fst_P :=
          CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
            (P := @AlgebraicGeometry.Etale) (CategoryTheory.IsPullback.of_hasPullback e₁ e₁_tilde).flip hEt₁_tilde
        have hEt_snd : AlgebraicGeometry.Etale snd_P :=
          CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
            (P := @AlgebraicGeometry.Etale) (CategoryTheory.IsPullback.of_hasPullback e₁ e₁_tilde) hEt₁
        let g₁ : P_pb ⟶ S₀ := fst_P ≫ e₂
        let g₂ : P_pb ⟶ S₀ := snd_P ≫ e₂_tilde
        have _ : AlgebraicGeometry.Etale g₁ := hEtale_comp fst_P e₂ hEt_fst hEt₂
        have _ : AlgebraicGeometry.Etale g₂ := hEtale_comp snd_P e₂_tilde hEt_snd hEt₂_tilde
        obtain ⟨W_P, hWP, hw_WP, _⟩ :=
          AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := w) (U := ⊤) trivial
        have hWP_le : W_P ≤ g₁ ⁻¹ᵁ ⊤ := fun _ _ => trivial
        obtain ⟨hEt_φWP, hSpec_WP⟩ := hChart_S₀ g₁ hWP hWP_le
        let C' := ↑Γ(P_pb, W_P)
        let φ_WP : CommRingCat.of R₀ ⟶ Γ(P_pb, W_P) := ψ_S₀ ≫ g₁.appLE ⊤ W_P hWP_le
        let _ : Algebra R₀ C' := φ_WP.hom.toAlgebra
        have _ : Algebra.Etale R₀ C' := RingHom.etale_algebraMap.mp hEt_φWP
        let q_w : ↥(Spec Γ(P_pb, W_P)) := hWP.primeIdealOf ⟨w, hw_WP⟩
        have hq_w_img : (Spec.map φ_WP).base q_w = e₂.base u₂ := by
          have hPt : (Spec.map φ_WP).base q_w = g₁.base (hWP.fromSpec.base q_w) :=
            congrArg (fun f => f.base q_w) hSpec_WP
          rw [hWP.fromSpec_primeIdealOf ⟨w, hw_WP⟩] at hPt
          exact hPt.trans (by change e₂.base (fst_P.base w) = e₂.base u₂; rw [hw_fst])
        have hc₀_not_qw : algebraMap R₀ C' (xbar i₀) ∉ q_w.asIdeal := by
          have hEqIdeal : Ideal.comap (algebraMap R₀ C') q_w.asIdeal = (e₂.base u₂).asIdeal :=
            congrArg PrimeSpectrum.asIdeal hq_w_img
          intro hmem
          have hmem' : xbar i₀ ∈ Ideal.comap (algebraMap R₀ C') q_w.asIdeal := hmem
          rw [hEqIdeal] at hmem'
          exact hi₀_not hmem'
        have hDom_Cw : IsDomain (Localization.AtPrime q_w.asIdeal) :=
          ((hEtaleR₀_props C').2 q_w.asIdeal).2.2 i₀ hc₀_not_qw
        let _instAlgP : Algebra C' ↑(P_pb.presheaf.stalk w) :=
          (P_pb.presheaf.germ W_P w hw_WP).hom.toAlgebra
        have _instLocP : IsLocalization.AtPrime ↑(P_pb.presheaf.stalk w) q_w.asIdeal :=
          hWP.isLocalization_stalk ⟨w, hw_WP⟩
        let eStalkP : ↑(P_pb.presheaf.stalk w) ≃+* Localization.AtPrime q_w.asIdeal :=
          (IsLocalization.algEquiv q_w.asIdeal.primeCompl
            ↑(P_pb.presheaf.stalk w) (Localization.AtPrime q_w.asIdeal)).toRingEquiv
        have hDom_Pw : IsDomain ↑(P_pb.presheaf.stalk w) :=
          Function.Injective.isDomain eStalkP.toRingHom eStalkP.injective
        have hm₀_w : ∀ i : Fin 2, xbar i ∈ (g₂.base w).asIdeal := by
          intro i
          change xbar i ∈ (e₂_tilde.base (snd_P.base w)).asIdeal
          rw [hw_snd]
          exact hm₀_tilde i
        exact hZeroDiv_stalk w g₂ hm₀_w hDom_Pw
      let q₂ : ↥(Spec Γ(U', V')) := hV'.primeIdealOf ⟨u₂, hu₂_V'⟩
      let q₂_ps : PrimeSpectrum B' := q₂
      have hq₂_in : q₂_ps ∈ PrimeSpectrum.comap (algebraMap R₀ B') ⁻¹' {p₀} := by
        rw [Set.mem_preimage, Set.mem_singleton_iff]
        have hPt : (Spec.map φ_V').base q₂ = e₂.base (hV'.fromSpec.base q₂) :=
          congrArg (fun f => f.base q₂) hSpec_V'
        rw [hV'.fromSpec_primeIdealOf ⟨u₂, hu₂_V'⟩, hu₂_node] at hPt
        exact hPt
      refine ⟨u₂, ⟨q₂_ps, hq₂_in, hV'.fromSpec_primeIdealOf ⟨u₂, hu₂_V'⟩⟩, rfl⟩
    choose W_cov hOpen_Wcov hy_Wcov hFin_Wcov using hLocFin
    let W_tot : ↥Z_sing → Set ↥Y := fun y => W_cov y.1 y.2
    obtain ⟨F_sub, hCov_sub⟩ := hCompact_Z.elim_finite_subcover W_tot
      (fun y => hOpen_Wcov y.1 y.2)
      (fun z hz => Set.mem_iUnion.mpr ⟨⟨z, hz⟩, hy_Wcov z hz⟩)
    have hFin_Z : Z_sing.Finite := by
      refine (F_sub.finite_toSet.biUnion fun y _ => hFin_Wcov y.1 y.2).subset ?_
      intro z hz
      obtain ⟨y, hyF, hzW⟩ := Set.mem_iUnion₂.mp (hCov_sub hz)
      exact Set.mem_iUnion₂.mpr ⟨y, hyF, hzW, hz⟩
    exact ⟨hFin_Z, hNodalStalkProps⟩

  obtain ⟨hSingFin, hNodStalk⟩ := hPartC
  have _ : ∀ y : ↥Y, _root_.IsReduced ↑(Y.presheaf.stalk y) := fun y =>
    if hy : y ∈ U_sm then (hSmStalk y hy).1 else (hNodStalk y hy).1
  have hRedY : AlgebraicGeometry.IsReduced Y :=
    AlgebraicGeometry.isReduced_of_isReduced_stalk Y
  have hStalkDim : ∀ y : ↥Y, ∀ P₂ P₁ P₀ : Ideal ↑(Y.presheaf.stalk y),
      P₂.IsPrime → P₁.IsPrime → P₀.IsPrime → P₂ < P₁ → ¬ (P₁ < P₀) := fun y =>
    if hy : y ∈ U_sm then (hSmStalk y hy).2 else (hNodStalk y hy).2.2
  have hOutMax : ∀ y : ↥Y, y ∉ U_sm → IsLocalRing.maximalIdeal ↑(Y.presheaf.stalk y) ≠ ⊥ :=
    fun y hy => (hNodStalk y hy).2.1

  
  have hPartD : ∃ (L_comp : ℕ)
      (Y_comp : Fin (L_comp + 1) → AlgebraicGeometry.Scheme.{u})
      (ι_comp : ∀ a : Fin (L_comp + 1), Y_comp a ⟶ Y)
      (U_part : Fin (L_comp + 1) → Y.Opens),
      (∀ E ∈ irreducibleComponents ↥Y, ∃ a : Fin (L_comp + 1), Set.range (ι_comp a).base = E) ∧
      (∀ a : Fin (L_comp + 1), Set.range (ι_comp a).base ∈ irreducibleComponents ↥Y) ∧
      (⨆ a : Fin (L_comp + 1), U_part a) = U_sm ∧
      (_root_.Pairwise fun a b : Fin (L_comp + 1) => Disjoint (U_part a) (U_part b)) ∧
      ∀ a : Fin (L_comp + 1),
        AlgebraicGeometry.IsClosedImmersion (ι_comp a) ∧
        AlgebraicGeometry.IsIntegral (Y_comp a) ∧
        topologicalKrullDim ↥(Y_comp a) = (1 : WithBot ℕ∞) ∧
        U_part a ≤ U_sm ∧
        (U_part a : Set ↥Y) = Set.range (ι_comp a).base ∩ (U_sm : Set ↥Y) ∧
        Nonempty ↥(U_part a) ∧
        CategoryTheory.IsIso (ι_comp a ∣_ U_part a) := by
    have hFinComp : (irreducibleComponents ↥Y).Finite :=
      AlgebraicGeometry.finite_irreducibleComponents_of_isNoetherian
    let _instFinComp : Fintype ↥(irreducibleComponents ↥Y) := hFinComp.fintype
    obtain ⟨y_init⟩ := (inferInstance : Nonempty ↥Y)
    have _instNeComp : Nonempty ↥(irreducibleComponents ↥Y) :=
      ⟨⟨irreducibleComponent y_init, irreducibleComponent_mem_irreducibleComponents y_init⟩⟩
    have hCardPos : 0 < Fintype.card ↥(irreducibleComponents ↥Y) := Fintype.card_pos
    let L_comp : ℕ := Fintype.card ↥(irreducibleComponents ↥Y) - 1
    have hCardEq : Fintype.card ↥(irreducibleComponents ↥Y) = L_comp + 1 :=
      (Nat.sub_add_cancel hCardPos).symm
    let eComp : Fin (L_comp + 1) ≃ ↥(irreducibleComponents ↥Y) :=
      (Fintype.equivFinOfCardEq hCardEq).symm
    let Z_comp : Fin (L_comp + 1) → TopologicalSpace.Closeds ↥Y := fun a =>
      ⟨(eComp a).1, isClosed_of_mem_irreducibleComponents (eComp a).1 (eComp a).2⟩
    let I_comp : Fin (L_comp + 1) → Y.IdealSheafData := fun a =>
      AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal (Z_comp a)
    let Y_comp : Fin (L_comp + 1) → AlgebraicGeometry.Scheme.{u} := fun a =>
      (I_comp a).subscheme
    let ι_comp : ∀ a : Fin (L_comp + 1), Y_comp a ⟶ Y := fun a =>
      (I_comp a).subschemeι
    have hRange_comp : ∀ a : Fin (L_comp + 1), Set.range (ι_comp a).base = (eComp a).1 := by
      intro a
      exact (I_comp a).range_subschemeι.trans
        (AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal (Z_comp a))
    have hCover : ∀ E ∈ irreducibleComponents ↥Y, ∃ a : Fin (L_comp + 1), Set.range (ι_comp a).base = E := by
      intro E hE
      refine ⟨eComp.symm ⟨E, hE⟩, ?_⟩
      rw [hRange_comp, eComp.apply_symm_apply]
    have hMem : ∀ a : Fin (L_comp + 1), Set.range (ι_comp a).base ∈ irreducibleComponents ↥Y := by
      intro a
      rw [hRange_comp a]
      exact (eComp a).2
    have hHomeo : ∀ a : Fin (L_comp + 1), ↥(Y_comp a) ≃ₜ ↥(Set.range (ι_comp a).base) :=
      fun a => (ι_comp a).isClosedEmbedding.isEmbedding.toHomeomorph
    have hIrredSpace : ∀ a : Fin (L_comp + 1), IrreducibleSpace ↥(Y_comp a) := by
      intro a
      have hIrredSet : IsIrreducible (Set.range (ι_comp a).base) := by
        rw [hRange_comp a]
        exact (eComp a).2.1
      have _ : IrreducibleSpace ↥(Set.range (ι_comp a).base) :=
        isIrreducible_iff_irreducibleSpace.mp hIrredSet
      exact (hHomeo a).irreducibleSpace_iff.mpr inferInstance
    have hRed_comp : ∀ a : Fin (L_comp + 1), AlgebraicGeometry.IsReduced (Y_comp a) := by
      intro a
      have _ : ∀ (U : (I_comp a).subschemeCover.openCover.I₀),
          AlgebraicGeometry.IsReduced ((I_comp a).subschemeCover.openCover.X U) := by
        intro U
        let U_aff : Y.affineOpens := U
        have hRad : ((I_comp a).ideal U_aff).IsRadical := by
          dsimp only [I_comp]
          rw [AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal_ideal]
          exact PrimeSpectrum.isRadical_vanishingIdeal _
        have _ : _root_.IsReduced (↑Γ(Y, U_aff.1) ⧸ (I_comp a).ideal U_aff) :=
          (Ideal.isRadical_iff_quotient_reduced _).mp hRad
        change AlgebraicGeometry.IsReduced (Spec (CommRingCat.of (↑Γ(Y, U_aff.1) ⧸ (I_comp a).ideal U_aff)))
        infer_instance
      exact AlgebraicGeometry.IsReduced.of_openCover (Y_comp a) (I_comp a).subschemeCover.openCover
    have hInt_comp : ∀ a : Fin (L_comp + 1), AlgebraicGeometry.IsIntegral (Y_comp a) := by
      intro a
      have _ := hIrredSpace a
      have _ := hRed_comp a
      exact AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced (Y_comp a)
    have hUniqueComp : ∀ (y : ↥Y), y ∈ U_sm →
        ∀ E₁ ∈ irreducibleComponents ↥Y, ∀ E₂ ∈ irreducibleComponents ↥Y,
          y ∈ E₁ → y ∈ E₂ → E₁ = E₂ := by
      intro y hy E₁ hE₁ E₂ hE₂ hy₁ hy₂
      obtain ⟨U_y, hOpen_Uy, hy_Uy, hIrred_Uy⟩ := hSmIrred y hy
      have hEqClosure : ∀ E ∈ irreducibleComponents ↥Y, y ∈ E → E = closure U_y := by
        intro E hE hyE
        have hSub : E ⊆ closure U_y := by
          intro z hz
          by_contra hz_not
          have hOpenCompl : IsOpen (closure U_y)ᶜ := isClosed_closure.isOpen_compl
          obtain ⟨w, _, hw_Uy, hw_not⟩ :=
            hE.1.isPreirreducible U_y (closure U_y)ᶜ hOpen_Uy hOpenCompl ⟨y, hyE, hy_Uy⟩ ⟨z, hz, hz_not⟩
          exact hw_not (subset_closure hw_Uy)
        exact Set.Subset.antisymm hSub (hE.2 hIrred_Uy.closure hSub)
      exact (hEqClosure E₁ hE₁ hy₁).trans (hEqClosure E₂ hE₂ hy₂).symm
    have hOpen_part : ∀ a : Fin (L_comp + 1),
        IsOpen (Set.range (ι_comp a).base ∩ (U_sm : Set ↥Y)) := by
      intro a
      have hEq : Set.range (ι_comp a).base ∩ (U_sm : Set ↥Y) =
          (U_sm : Set ↥Y) ∩ (⋃ b ∈ Finset.univ.erase a, (eComp b).1)ᶜ := by
        ext y
        rw [hRange_comp a]
        simp only [Set.mem_inter_iff, Set.mem_compl_iff, Set.mem_iUnion, Finset.mem_erase,
          Finset.mem_univ, and_true]
        refine ⟨fun ⟨hya, hysm⟩ => ⟨hysm, ?_⟩, fun ⟨hysm, hynot⟩ => ⟨?_, hysm⟩⟩
        · rintro ⟨b, hba, hyb⟩
          have hEqE := hUniqueComp y hysm (eComp a).1 (eComp a).2 (eComp b).1 (eComp b).2 hya hyb
          exact hba (eComp.injective (Subtype.ext hEqE)).symm
        · obtain ⟨c, hc⟩ := hCover (irreducibleComponent y) (irreducibleComponent_mem_irreducibleComponents y)
          rw [hRange_comp c] at hc
          have hyc : y ∈ (eComp c).1 := by
            rw [hc]
            exact mem_irreducibleComponent
          by_cases hca : c = a
          · rwa [← hca]
          · exact False.elim (hynot ⟨c, hca, hyc⟩)
      rw [hEq]
      have hClUnion : IsClosed (⋃ b ∈ Finset.univ.erase a, (eComp b).1) :=
        (Finset.univ.erase a).finite_toSet.isClosed_biUnion fun b _ =>
          isClosed_of_mem_irreducibleComponents (eComp b).1 (eComp b).2
      exact U_sm.isOpen.inter hClUnion.isOpen_compl
    let U_part : Fin (L_comp + 1) → Y.Opens := fun a =>
      ⟨Set.range (ι_comp a).base ∩ (U_sm : Set ↥Y), hOpen_part a⟩
    have hPartLe : ∀ a : Fin (L_comp + 1), U_part a ≤ U_sm :=
      fun a => Set.inter_subset_right
    have hPartSup : (⨆ a : Fin (L_comp + 1), U_part a) = U_sm := by
      apply SetLike.coe_injective
      ext y
      simp only [TopologicalSpace.Opens.coe_iSup, Set.mem_iUnion]
      refine ⟨fun ⟨a, hya⟩ => hPartLe a hya, fun hysm => ?_⟩
      obtain ⟨a, ha⟩ := hCover (irreducibleComponent y) (irreducibleComponent_mem_irreducibleComponents y)
      refine ⟨a, ?_⟩
      change y ∈ Set.range (ι_comp a).base ∩ (U_sm : Set ↥Y)
      rw [ha]
      exact ⟨mem_irreducibleComponent, hysm⟩
    have hPartDisj : _root_.Pairwise fun a b : Fin (L_comp + 1) => Disjoint (U_part a) (U_part b) := by
      intro a b hab
      rw [disjoint_iff_inf_le]
      rintro y ⟨⟨hya, hysm⟩, ⟨hyb, _⟩⟩
      rw [hRange_comp a] at hya
      rw [hRange_comp b] at hyb
      have hEqE := hUniqueComp y hysm (eComp a).1 (eComp a).2 (eComp b).1 (eComp b).2 hya hyb
      exact hab (eComp.injective (Subtype.ext hEqE))
    have hPartIso : ∀ a : Fin (L_comp + 1), CategoryTheory.IsIso (ι_comp a ∣_ U_part a) := by
      intro a
      have _ : AlgebraicGeometry.Surjective (ι_comp a ∣_ U_part a) := by
        refine ⟨fun x => ?_⟩
        have hx : x.1 ∈ Set.range (ι_comp a).base := x.2.1
        obtain ⟨z, hz⟩ := hx
        have hz_mem : z ∈ (TopologicalSpace.Opens.map (ι_comp a).base).obj (U_part a) := by
          change (ι_comp a).base z ∈ U_part a
          rw [hz]
          exact x.2
        let z' : ↥((ι_comp a ⁻¹ᵁ U_part a).toScheme) := ⟨z, hz_mem⟩
        refine ⟨z', Subtype.ext ?_⟩
        exact (AlgebraicGeometry.morphismRestrict_base_coe (ι_comp a) (U_part a) z').trans hz
      exact AlgebraicGeometry.isIso_of_isClosedImmersion_of_surjective (ι_comp a ∣_ U_part a)
    have hPartNe : ∀ a : Fin (L_comp + 1), Nonempty ↥(U_part a) := by
      intro a
      have _ := hIrredSpace a
      let η_a : ↥(Y_comp a) := genericPoint ↥(Y_comp a)
      let y_a : ↥Y := (ι_comp a).base η_a
      have hClosure_ya : closure ({y_a} : Set ↥Y) = (eComp a).1 := by
        apply Set.Subset.antisymm
        · refine closure_minimal ?_ (isClosed_of_mem_irreducibleComponents (eComp a).1 (eComp a).2)
          rw [Set.singleton_subset_iff, ← hRange_comp a]
          exact ⟨η_a, rfl⟩
        · rw [← hRange_comp a]
          rintro y ⟨z, rfl⟩
          have hz_cl : z ∈ closure ({η_a} : Set ↥(Y_comp a)) := by
            rw [(genericPoint_spec ↥(Y_comp a)).def]
            trivial
          have hSubImg := image_closure_subset_closure_image (ι_comp a).continuous (s := ({η_a} : Set ↥(Y_comp a)))
          rw [Set.image_singleton] at hSubImg
          exact hSubImg ⟨z, hz_cl, rfl⟩
      have hya_sm : y_a ∈ U_sm := by
        by_contra hya_not_sm
        obtain ⟨W, hW, hya_W, _⟩ :=
          AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := y_a) (U := ⊤) trivial
        let q_a : PrimeSpectrum ↑Γ(Y, W) := hW.primeIdealOf ⟨y_a, hya_W⟩
        let fW : PrimeSpectrum ↑Γ(Y, W) → ↥Y := hW.fromSpec.base
        have hfW_open : IsOpenMap fW := hW.fromSpec.isOpenEmbedding.isOpenMap
        have hfW_cont : Continuous fW := hW.fromSpec.continuous
        have hfW_inj : Function.Injective fW := hW.fromSpec.isOpenEmbedding.injective
        have hqa_eq : fW q_a = y_a := hW.fromSpec_primeIdealOf ⟨y_a, hya_W⟩
        have hMin_qa : ∀ (P : Ideal ↑Γ(Y, W)), P.IsPrime → P ≤ q_a.asIdeal → P = q_a.asIdeal := by
          intro P hP hPle
          let p_pt : PrimeSpectrum ↑Γ(Y, W) := ⟨P, hP⟩
          let z : ↥Y := fW p_pt
          have hqa_in_cl : q_a ∈ closure ({p_pt} : Set (PrimeSpectrum ↑Γ(Y, W))) := by
            rw [PrimeSpectrum.closure_singleton]
            exact hPle
          have hya_in_cl_z : y_a ∈ closure ({z} : Set ↥Y) := by
            have hSubImg : fW '' closure ({p_pt} : Set (PrimeSpectrum ↑Γ(Y, W))) ⊆
                closure (fW '' ({p_pt} : Set (PrimeSpectrum ↑Γ(Y, W)))) :=
              image_closure_subset_closure_image hfW_cont
            rw [Set.image_singleton] at hSubImg
            rw [← hqa_eq]
            exact hSubImg ⟨q_a, hqa_in_cl, rfl⟩
          have hSubE : (eComp a).1 ⊆ closure ({z} : Set ↥Y) := by
            rw [← hClosure_ya]
            exact closure_minimal (Set.singleton_subset_iff.mpr hya_in_cl_z) isClosed_closure
          have hEqCl : closure ({z} : Set ↥Y) = closure ({y_a} : Set ↥Y) := by
            have hMax := (eComp a).2.2 isIrreducible_singleton.closure hSubE
            exact (Set.Subset.antisymm hMax hSubE).trans hClosure_ya.symm
          have hPreEq : fW ⁻¹' closure ({z} : Set ↥Y) = fW ⁻¹' closure ({y_a} : Set ↥Y) := by
            rw [hEqCl]
          rw [IsOpenMap.preimage_closure_eq_closure_preimage hfW_open hfW_cont,
            IsOpenMap.preimage_closure_eq_closure_preimage hfW_open hfW_cont] at hPreEq
          have hPre_z : fW ⁻¹' ({z} : Set ↥Y) = ({p_pt} : Set (PrimeSpectrum ↑Γ(Y, W))) := by
            ext r
            simp only [Set.mem_preimage, Set.mem_singleton_iff]
            exact hfW_inj.eq_iff
          have hPre_ya : fW ⁻¹' ({y_a} : Set ↥Y) = ({q_a} : Set (PrimeSpectrum ↑Γ(Y, W))) := by
            ext r
            simp only [Set.mem_preimage, Set.mem_singleton_iff]
            rw [← hqa_eq]
            exact hfW_inj.eq_iff
          rw [hPre_z, hPre_ya, PrimeSpectrum.closure_singleton, PrimeSpectrum.closure_singleton] at hPreEq
          have hVan := congrArg PrimeSpectrum.vanishingIdeal hPreEq
          rw [PrimeSpectrum.vanishingIdeal_zeroLocus_eq_radical,
            PrimeSpectrum.vanishingIdeal_zeroLocus_eq_radical,
            hP.radical, q_a.isPrime.radical] at hVan
          exact hVan
        let _instAlg_ya : Algebra ↑Γ(Y, W) ↑(Y.presheaf.stalk y_a) :=
          (Y.presheaf.germ W y_a hya_W).hom.toAlgebra
        have _instLoc_ya : IsLocalization.AtPrime ↑(Y.presheaf.stalk y_a) q_a.asIdeal :=
          hW.isLocalization_stalk ⟨y_a, hya_W⟩
        let eOrd := IsLocalization.orderIsoOfPrime q_a.asIdeal.primeCompl ↑(Y.presheaf.stalk y_a)
        have hDisj_le : ∀ {P : Ideal ↑Γ(Y, W)}, Disjoint (q_a.asIdeal.primeCompl : Set ↑Γ(Y, W)) (P : Set ↑Γ(Y, W)) → P ≤ q_a.asIdeal :=
          fun hd => Set.disjoint_compl_left_iff_subset.mp hd
        have hMaxPrime : (IsLocalRing.maximalIdeal ↑(Y.presheaf.stalk y_a)).IsPrime :=
          (IsLocalRing.maximalIdeal.isMaximal ↑(Y.presheaf.stalk y_a)).isPrime
        have hAllPrimesEqMax : ∀ (Q : Ideal ↑(Y.presheaf.stalk y_a)), Q.IsPrime →
            Q = IsLocalRing.maximalIdeal ↑(Y.presheaf.stalk y_a) := by
          intro Q hQ
          have hEq := hMin_qa (eOrd ⟨Q, hQ⟩).1 (eOrd ⟨Q, hQ⟩).2.1 (hDisj_le (eOrd ⟨Q, hQ⟩).2.2)
          have hEqMax := hMin_qa (eOrd ⟨_, hMaxPrime⟩).1 (eOrd ⟨_, hMaxPrime⟩).2.1 (hDisj_le (eOrd ⟨_, hMaxPrime⟩).2.2)
          have hSubEq : eOrd ⟨Q, hQ⟩ = eOrd ⟨_, hMaxPrime⟩ := Subtype.ext (hEq.trans hEqMax.symm)
          exact congrArg Subtype.val (eOrd.injective hSubEq)
        have hMaxEqBot : IsLocalRing.maximalIdeal ↑(Y.presheaf.stalk y_a) = ⊥ := by
          have hNil : nilradical ↑(Y.presheaf.stalk y_a) = ⊥ := nilradical_eq_zero _
          rw [← hNil, nilradical_eq_sInf]
          apply le_antisymm
          · refine le_sInf ?_
            intro Q hQ
            rw [hAllPrimesEqMax Q hQ]
          · exact sInf_le hMaxPrime
        exact hOutMax y_a hya_not_sm hMaxEqBot
      exact ⟨⟨y_a, ⟨⟨η_a, rfl⟩, hya_sm⟩⟩⟩
    have hDimLtTwo : topologicalKrullDim ↥Y < ((2 : ℕ) : WithBot ℕ∞) := by
      unfold topologicalKrullDim
      refine Order.krullDim_lt_coe_iff.mpr fun p => ?_
      by_contra hp_not_lt
      have hp_ge : 2 ≤ p.length := Nat.le_of_not_lt hp_not_lt
      let Z₀ : TopologicalSpace.IrreducibleCloseds ↥Y := p ⟨0, by omega⟩
      let Z₁ : TopologicalSpace.IrreducibleCloseds ↥Y := p ⟨1, by omega⟩
      let Z₂ : TopologicalSpace.IrreducibleCloseds ↥Y := p ⟨2, by omega⟩
      have hZ01 : Z₀ < Z₁ := p.strictMono (Fin.mk_lt_mk.mpr (by omega))
      have hZ12 : Z₁ < Z₂ := p.strictMono (Fin.mk_lt_mk.mpr (by omega))
      obtain ⟨y₀, hy₀⟩ := Z₀.isIrreducible'.1
      have hy₁ : y₀ ∈ Z₁.carrier := hZ01.le hy₀
      have hy₂ : y₀ ∈ Z₂.carrier := hZ12.le hy₁
      obtain ⟨W, hW, hy₀_W, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := y₀) (U := ⊤) trivial
      let q₀ : PrimeSpectrum ↑Γ(Y, W) := hW.primeIdealOf ⟨y₀, hy₀_W⟩
      have hq₀_img : hW.fromSpec.base q₀ = y₀ := hW.fromSpec_primeIdealOf ⟨y₀, hy₀_W⟩
      let fW : PrimeSpectrum ↑Γ(Y, W) → ↥Y := hW.fromSpec.base
      have hfW_open : IsOpenMap fW := hW.fromSpec.isOpenEmbedding.isOpenMap
      have hfW_cont : Continuous fW := hW.fromSpec.continuous
      have hfW_inj : Function.Injective fW := hW.fromSpec.isOpenEmbedding.injective
      have hTrace : ∀ (T : TopologicalSpace.IrreducibleCloseds ↥Y), y₀ ∈ T.carrier →
          IsIrreducible (fW ⁻¹' T.carrier) ∧
          IsClosed (fW ⁻¹' T.carrier) ∧
          closure (fW '' (fW ⁻¹' T.carrier)) = T.carrier := by
        intro T hyT
        refine ⟨⟨⟨q₀, ?_⟩, ?_⟩, T.isClosed'.preimage hfW_cont, ?_⟩
        · change hW.fromSpec.base q₀ ∈ T.carrier
          rwa [hq₀_img]
        · intro U₁ U₂ hU₁ hU₂ ⟨r₁, hr₁T, hr₁U⟩ ⟨r₂, hr₂T, hr₂U⟩
          have hOpen₁ : IsOpen (fW '' U₁) := hfW_open U₁ hU₁
          have hOpen₂ : IsOpen (fW '' U₂) := hfW_open U₂ hU₂
          obtain ⟨x, hxT, ⟨u₁, hu₁, hxu₁⟩, ⟨u₂, hu₂, hxu₂⟩⟩ :=
            T.isIrreducible'.2 (fW '' U₁) (fW '' U₂) hOpen₁ hOpen₂
              ⟨fW r₁, hr₁T, ⟨r₁, hr₁U, rfl⟩⟩
              ⟨fW r₂, hr₂T, ⟨r₂, hr₂U, rfl⟩⟩
          have hu_eq : u₁ = u₂ := hfW_inj (hxu₁.trans hxu₂.symm)
          subst hu_eq
          refine ⟨u₁, ?_, hu₁, hu₂⟩
          change fW u₁ ∈ T.carrier
          rwa [hxu₁]
        · have hImgEq : fW '' (fW ⁻¹' T.carrier) = T.carrier ∩ (W : Set ↥Y) := by
            rw [Set.image_preimage_eq_inter_range]
            change T.carrier ∩ Set.range hW.fromSpec.base = T.carrier ∩ (W : Set ↥Y)
            rw [hW.range_fromSpec]
          rw [hImgEq]
          apply Set.Subset.antisymm
          · exact closure_minimal Set.inter_subset_left T.isClosed'
          · intro z hz
            by_contra hz_not
            obtain ⟨w, hwT, hwW, hwNot⟩ :=
              T.isIrreducible'.2 (W : Set ↥Y) (closure (T.carrier ∩ (W : Set ↥Y)))ᶜ
                W.isOpen isClosed_closure.isOpen_compl ⟨y₀, hyT, hy₀_W⟩ ⟨z, hz, hz_not⟩
            exact hwNot (subset_closure ⟨hwT, hwW⟩)
      let S₀_Z : Set (PrimeSpectrum ↑Γ(Y, W)) := fW ⁻¹' Z₀.carrier
      let S₁_Z : Set (PrimeSpectrum ↑Γ(Y, W)) := fW ⁻¹' Z₁.carrier
      let S₂_Z : Set (PrimeSpectrum ↑Γ(Y, W)) := fW ⁻¹' Z₂.carrier
      have hT₀ := hTrace Z₀ hy₀
      have hT₁ := hTrace Z₁ hy₁
      have hT₂ := hTrace Z₂ hy₂
      let p₀ := PrimeSpectrum.vanishingIdeal S₀_Z
      let p₁ := PrimeSpectrum.vanishingIdeal S₁_Z
      let p₂ := PrimeSpectrum.vanishingIdeal S₂_Z
      have hp₀ : p₀.IsPrime := PrimeSpectrum.isIrreducible_iff_vanishingIdeal_isPrime.mp hT₀.1
      have hp₁ : p₁.IsPrime := PrimeSpectrum.isIrreducible_iff_vanishingIdeal_isPrime.mp hT₁.1
      have hp₂ : p₂.IsPrime := PrimeSpectrum.isIrreducible_iff_vanishingIdeal_isPrime.mp hT₂.1
      have hp₀_le : p₀ ≤ q₀.asIdeal := by
        intro f hf
        rw [PrimeSpectrum.mem_vanishingIdeal] at hf
        exact hf q₀ (by change hW.fromSpec.base q₀ ∈ Z₀.carrier; rwa [hq₀_img])
      have hp₁₀ : p₁ < p₀ := by
        refine lt_of_le_of_ne (PrimeSpectrum.vanishingIdeal_anti_mono (Set.preimage_mono hZ01.le)) ?_
        intro heq
        have hS : fW ⁻¹' Z₁.carrier = fW ⁻¹' Z₀.carrier := by
          rw [← hT₁.2.1.closure_eq, ← hT₀.2.1.closure_eq,
            ← PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure,
            ← PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure]
          exact congrArg (fun I : Ideal ↑Γ(Y, W) => PrimeSpectrum.zeroLocus (I : Set ↑Γ(Y, W))) heq
        have hZeq : Z₁ = Z₀ := SetLike.coe_injective (by
          change Z₁.carrier = Z₀.carrier
          rw [← hT₁.2.2, ← hT₀.2.2, hS])
        exact hZ01.ne hZeq.symm
      have hp₂₁ : p₂ < p₁ := by
        refine lt_of_le_of_ne (PrimeSpectrum.vanishingIdeal_anti_mono (Set.preimage_mono hZ12.le)) ?_
        intro heq
        have hS : fW ⁻¹' Z₂.carrier = fW ⁻¹' Z₁.carrier := by
          rw [← hT₂.2.1.closure_eq, ← hT₁.2.1.closure_eq,
            ← PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure,
            ← PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure]
          exact congrArg (fun I : Ideal ↑Γ(Y, W) => PrimeSpectrum.zeroLocus (I : Set ↑Γ(Y, W))) heq
        have hZeq : Z₂ = Z₁ := SetLike.coe_injective (by
          change Z₂.carrier = Z₁.carrier
          rw [← hT₂.2.2, ← hT₁.2.2, hS])
        exact hZ12.ne hZeq.symm
      let _instAlg_y₀ : Algebra ↑Γ(Y, W) ↑(Y.presheaf.stalk y₀) :=
        (Y.presheaf.germ W y₀ hy₀_W).hom.toAlgebra
      have _instLoc_y₀ : IsLocalization.AtPrime ↑(Y.presheaf.stalk y₀) q₀.asIdeal :=
        hW.isLocalization_stalk ⟨y₀, hy₀_W⟩
      let eOrd := (IsLocalization.orderIsoOfPrime q₀.asIdeal.primeCompl ↑(Y.presheaf.stalk y₀)).symm
      have hDisj₀ : ∀ {P : Ideal ↑Γ(Y, W)}, P ≤ q₀.asIdeal →
          Disjoint (q₀.asIdeal.primeCompl : Set ↑Γ(Y, W)) (P : Set ↑Γ(Y, W)) :=
        fun hle => Set.disjoint_compl_left_iff_subset.mpr hle
      let Q₀ := eOrd ⟨p₀, hp₀, hDisj₀ hp₀_le⟩
      let Q₁ := eOrd ⟨p₁, hp₁, hDisj₀ (hp₁₀.le.trans hp₀_le)⟩
      let Q₂ := eOrd ⟨p₂, hp₂, hDisj₀ (hp₂₁.le.trans (hp₁₀.le.trans hp₀_le))⟩
      have hQ21 : Q₂.1 < Q₁.1 := eOrd.strictMono hp₂₁
      have hQ10 : Q₁.1 < Q₀.1 := eOrd.strictMono hp₁₀
      exact hStalkDim y₀ Q₂.1 Q₁.1 Q₀.1 Q₂.2 Q₁.2 Q₀.2 hQ21 hQ10
    have hDim_comp : ∀ a : Fin (L_comp + 1), topologicalKrullDim ↥(Y_comp a) = (1 : WithBot ℕ∞) := by
      intro a
      rw [(hHomeo a).isHomeomorph.topologicalKrullDim_eq]
      have hGe1 : (1 : WithBot ℕ∞) ≤ topologicalKrullDim ↥(Set.range (ι_comp a).base) := by
        unfold topologicalKrullDim
        refine Order.le_krullDim_iff.mpr ?_
        obtain ⟨x₀, x₁, hx₀_part, hx₁_part, hx₁_cl, hx₀_not_cl⟩ :=
          hSmSpec (U_part a) (hPartLe a) (hPartNe a)
        let x0_sub : ↥(Set.range (ι_comp a).base) := ⟨x₀, hx₀_part.1⟩
        let x1_sub : ↥(Set.range (ι_comp a).base) := ⟨x₁, hx₁_part.1⟩
        have hClSub : ∀ z w : ↥(Set.range (ι_comp a).base),
            z ∈ closure ({w} : Set ↥(Set.range (ι_comp a).base)) ↔
              (z : ↥Y) ∈ closure ({(w : ↥Y)} : Set ↥Y) := by
          intro z w
          rw [Topology.IsInducing.subtypeVal.closure_eq_preimage_closure_image, Set.image_singleton]
          rfl
        let C₀ : TopologicalSpace.IrreducibleCloseds ↥(Set.range (ι_comp a).base) :=
          ⟨closure {x0_sub}, isIrreducible_singleton.closure, isClosed_closure⟩
        let C₁ : TopologicalSpace.IrreducibleCloseds ↥(Set.range (ι_comp a).base) :=
          ⟨closure {x1_sub}, isIrreducible_singleton.closure, isClosed_closure⟩
        have hC10 : C₁ < C₀ := by
          refine lt_of_le_of_ne ?_ ?_
          · exact closure_minimal (Set.singleton_subset_iff.mpr ((hClSub x1_sub x0_sub).mpr hx₁_cl)) isClosed_closure
          · intro heq
            have hx₀_in : x0_sub ∈ C₁.carrier := by
              rw [heq]
              exact subset_closure (Set.mem_singleton x0_sub)
            exact hx₀_not_cl ((hClSub x0_sub x1_sub).mp hx₀_in)
        refine ⟨RelSeries.mk 1 ![C₁, C₀] (fun i => by fin_cases i; exact hC10), rfl⟩
      have hLt2 : topologicalKrullDim ↥(Set.range (ι_comp a).base) < ((2 : ℕ) : WithBot ℕ∞) :=
        lt_of_le_of_lt (topologicalKrullDim_subspace_le ↥Y (Set.range (ι_comp a).base)) hDimLtTwo
      rcases hd : topologicalKrullDim ↥(Set.range (ι_comp a).base) with _ | d
      · rw [hd] at hGe1
        exact absurd (le_bot_iff.mp hGe1) WithBot.coe_ne_bot
      · rw [hd] at hGe1 hLt2
        have h1_le : (1 : ℕ∞) ≤ d := WithBot.coe_le_coe.mp hGe1
        have hd_lt : d < ((1 : ℕ) + 1 : ℕ∞) := WithBot.coe_lt_coe.mp hLt2
        have hd_le : d ≤ (1 : ℕ∞) := ENat.lt_natCast_add_one_iff.mp hd_lt
        exact congrArg WithBot.some (le_antisymm hd_le h1_le)
    refine ⟨L_comp, Y_comp, ι_comp, U_part, hCover, hMem, hPartSup, hPartDisj, fun a => ?_⟩
    exact ⟨inferInstance, hInt_comp a, hDim_comp a, hPartLe a, rfl, hPartNe a, hPartIso a⟩

  
  obtain ⟨L_comp, Y_comp, ι_comp, U_part, hCompCover, hCompMem, hPartSup, hPartDisj, hCompProps⟩ :=
    hPartD
  refine ⟨hRedY, U_sm, L_comp, Y_comp, ι_comp, U_part, hSmU, hSingFin, hNodalFull,
    hCompCover, hCompMem, hPartSup, hPartDisj, fun a => ?_⟩
  obtain ⟨hCl_a, hInt_a, hDim_a, hLe_a, hSet_a, hNe_a, hIso_a⟩ := hCompProps a
  have _ : AlgebraicGeometry.IsClosedImmersion (ι_comp a) := hCl_a
  have hProp_a : AlgebraicGeometry.IsProper (ι_comp a ≫ p_Y) := inferInstance
  have hSm_a : AlgebraicGeometry.SmoothOfRelativeDimension 1 ((U_part a).ι ≫ p_Y) := by
    have hComp : (U_part a).ι ≫ p_Y = Y.homOfLE hLe_a ≫ (U_sm.ι ≫ p_Y) := by
      rw [← Category.assoc, Y.homOfLE_ι hLe_a]
    rw [hComp]
    simpa using AlgebraicGeometry.smoothOfRelativeDimension_comp 0 1 (Y.homOfLE hLe_a) (U_sm.ι ≫ p_Y)
  exact ⟨hCl_a, hInt_a, hProp_a, hDim_a, hLe_a, hSet_a, hNe_a, hSm_a, hIso_a⟩

theorem weil_integral_proper_curve_normalization_and_dvr_regularity (k₀ : Type u) [Field k₀] [IsAlgClosed k₀]
    (Y X : AlgebraicGeometry.Scheme.{u})
    (p_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of k₀))
    (ι_X : X ⟶ Y)
    (hClX : AlgebraicGeometry.IsClosedImmersion ι_X)
    (hIntX : AlgebraicGeometry.IsIntegral X)
    (hPropX : AlgebraicGeometry.IsProper (ι_X ≫ p_Y))
    (hDimX : topologicalKrullDim ↥X = (1 : WithBot ℕ∞))
    (U_part : Y.Opens)
    (hPartSub : (U_part : Set ↥Y) ⊆ Set.range ι_X.base)
    (hPartNe : Nonempty ↥U_part)
    (hSmPart : AlgebraicGeometry.SmoothOfRelativeDimension 1 (U_part.ι ≫ p_Y))
    (hIsoPart : CategoryTheory.IsIso (ι_X ∣_ U_part))
    (hFinIntClosure : ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra k₀ A] [Algebra.FiniteType k₀ A]
      (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K],
      Module.Finite A ↥(integralClosure A K) ∧ IsIntegrallyClosed ↥(integralClosure A K)) :
    ∃ (X_tilde : AlgebraicGeometry.Scheme.{u})
      (ι_tilde : X_tilde ⟶ Y)
      (hInt : AlgebraicGeometry.IsIntegral X_tilde),
      letI : AlgebraicGeometry.IsIntegral X_tilde := hInt
      (∀ (U : X_tilde.Opens), AlgebraicGeometry.IsAffineOpen U → Nonempty U →
        IsDomain ↑(X_tilde.presheaf.obj (Opposite.op U)) ∧
        IsIntegrallyClosed ↑(X_tilde.presheaf.obj (Opposite.op U)) ∧
        Ring.DimensionLEOne ↑(X_tilde.presheaf.obj (Opposite.op U))) ∧
      AlgebraicGeometry.IsFinite ι_tilde ∧
      AlgebraicGeometry.IsProper (ι_tilde ≫ p_Y) ∧
      Set.range ι_tilde.base = Set.range ι_X.base ∧
      CategoryTheory.IsIso (ι_tilde ∣_ U_part) ∧
      (∃ σ₀ : AlgebraicGeometry.Spec (CommRingCat.of k₀) ⟶ X_tilde,
        σ₀ ≫ (ι_tilde ≫ p_Y) = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k₀))) ∧
      (∀ (Z : Set ↥X_tilde), IsClosed Z → Z ≠ Set.univ → Z.Finite) ∧
      (∀ (h : ↑X_tilde.functionField), h ≠ 0 → ∀ (x : ↥X_tilde),
        ∃ (W : X_tilde.Opens) (_ : AlgebraicGeometry.IsAffineOpen W) (hW_ne : Nonempty W)
          (s : ↑(X_tilde.presheaf.obj (Opposite.op W))),
          letI : Nonempty W := hW_ne
          x ∈ W ∧
          ((X_tilde.germToFunctionField W).hom s = h ∨
            (X_tilde.germToFunctionField W).hom s = h⁻¹)) :=
by
  
  have h_etIC : ∀ (B : Type u) [CommRing B] [IsDomain B]
      (ψ : MvPolynomial (Fin 1) k₀ →+* B), ψ.Etale → IsIntegrallyClosed B := by
    intro B _ _ ψ hψ
    let A₀ := Polynomial k₀
    let toMv : A₀ →+* MvPolynomial (Fin 1) k₀ :=
      Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.X 0)
    let fromMv : MvPolynomial (Fin 1) k₀ →+* A₀ :=
      MvPolynomial.eval₂Hom Polynomial.C (fun _ => Polynomial.X)
    have hLeft : fromMv.comp toMv = RingHom.id A₀ := by
      apply Polynomial.ringHom_ext
      · intro c
        change fromMv (Polynomial.eval₂ MvPolynomial.C (MvPolynomial.X 0) (Polynomial.C c)) = Polynomial.C c
        rw [Polynomial.eval₂_C, MvPolynomial.eval₂Hom_C]
      · change fromMv (Polynomial.eval₂ MvPolynomial.C (MvPolynomial.X 0) Polynomial.X) = Polynomial.X
        rw [Polynomial.eval₂_X, MvPolynomial.eval₂Hom_X']
    have hRight : toMv.comp fromMv = RingHom.id (MvPolynomial (Fin 1) k₀) := by
      apply MvPolynomial.ringHom_ext
      · intro c
        change Polynomial.eval₂ MvPolynomial.C (MvPolynomial.X 0) (fromMv (MvPolynomial.C c)) = MvPolynomial.C c
        rw [MvPolynomial.eval₂Hom_C, Polynomial.eval₂_C]
      · intro i
        fin_cases i
        change Polynomial.eval₂ MvPolynomial.C (MvPolynomial.X 0) (fromMv (MvPolynomial.X 0)) = MvPolynomial.X 0
        rw [MvPolynomial.eval₂Hom_X', Polynomial.eval₂_X]
    let ePoly : A₀ ≃+* MvPolynomial (Fin 1) k₀ :=
      { toFun := toMv
        invFun := fromMv
        left_inv := fun x => RingHom.congr_fun hLeft x
        right_inv := fun x => RingHom.congr_fun hRight x
        map_mul' := toMv.map_mul'
        map_add' := toMv.map_add' }
    let φ : A₀ →+* B := ψ.comp ePoly.toRingHom
    letI : Algebra A₀ (MvPolynomial (Fin 1) k₀) := ePoly.toRingHom.toAlgebra
    letI : Algebra (MvPolynomial (Fin 1) k₀) B := ψ.toAlgebra
    letI : Algebra A₀ B := φ.toAlgebra
    have : IsScalarTower A₀ (MvPolynomial (Fin 1) k₀) B := IsScalarTower.of_algebraMap_eq' rfl
