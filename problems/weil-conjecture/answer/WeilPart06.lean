      refine ⟨hzQ, ?_⟩
      let B_0 := ↑(Z.presheaf.obj (Opposite.op U₀))
      let p_u : Ideal B_0 := (hU0.primeIdealOf ⟨z_Q, hzQ⟩).asIdeal
      haveI : p_u.IsPrime := (hU0.primeIdealOf ⟨z_Q, hzQ⟩).isPrime
      let D_u := B_0 ⧸ p_u
      obtain ⟨φ_0, hφ0_spec, hcomap_φ0, hcomap_γ0, hcomp_γ0⟩ := hLocFacZ U₀ hU0 hzQ
