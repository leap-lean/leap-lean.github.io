      calc η_A1 u₁ * (η_A1 (ι_a b₁') * u₁_inv)
          = η_A1 (ι_a b₁') * (η_A1 u₁ * u₁_inv) := by ring
        _ = η_A1 (ι_a b₁') := by rw [hu₁_inv, mul_one]
    obtain ⟨ψ₁, _, hψ₁_C, hψ₁_X0, hψ₁_X1⟩ :=
      nodal_lift_pkg b₁' (η_A1.comp ι_a) (η_A1 u₁) (η_A1 (ι_a b₁') * u₁_inv) hψ₁_rel
    refine comp_away_isLocalization p₁_hom u₁ ψ₁ ?_ ?_
    · apply nodalHom_ext a_Rz
      · intro r
        rw [RingHom.comp_apply, hp₁_C r, hψ₁_C r, RingHom.comp_apply]
      · rw [RingHom.comp_apply, hp₁_X0, map_mul ψ₁, hψ₁_C (t_s * π₁'), hψ₁_X1,
          RingHom.comp_apply]
        have ht_eq : (t_s * π₁') * b₁' = a_Rz := by
          calc (t_s * π₁') * b₁' = t_s * b₁' * π₁' := by ring
            _ = a_Rz := htb₁π₁
        calc η_A1 (ι_a (t_s * π₁')) * (η_A1 (ι_a b₁') * u₁_inv)
            = (η_A1 (ι_a (t_s * π₁')) * η_A1 (ι_a b₁')) * u₁_inv := (mul_assoc _ _ _).symm
          _ = η_A1 (ι_a ((t_s * π₁') * b₁')) * u₁_inv := by
                rw [← map_mul η_A1, ← map_mul ι_a]
          _ = η_A1 (ι_a a_Rz) * u₁_inv := by rw [ht_eq]
          _ = η_A1 (u₀ * u₁) * u₁_inv := by rw [← hu₀u₁]
          _ = η_A1 u₀ * (η_A1 u₁ * u₁_inv) := by rw [map_mul η_A1, mul_assoc]
          _ = η_A1 u₀ := by rw [hu₁_inv, mul_one]
      · rw [RingHom.comp_apply, hp₁_X1, hψ₁_X0]
    · intro α hα_alg hα_inv
      let M₁ := Localization.Away (p₁_hom u₁)
      let η_C₁ : C₁ →+* M₁ := algebraMap C₁ M₁
      apply nodalHom_ext b₁'
      · intro r
        rw [RingHom.comp_apply, hψ₁_C r, RingHom.comp_apply, hα_alg (ι_a r)]
        exact congrArg η_C₁ (hp₁_C r)
      · rw [RingHom.comp_apply, hψ₁_X0, hα_alg u₁]
        exact congrArg η_C₁ hp₁_X1
      · rw [RingHom.comp_apply, hψ₁_X1, map_mul α, hα_alg (ι_a b₁'), hα_inv]
        have hp₁_b1 : η_C₁ (p₁_hom (ι_a b₁')) = η_C₁ (ι_1 b₁') :=
          congrArg η_C₁ (hp₁_C b₁')
        have hp₁u₁_u' : p₁_hom u₁ * u' = ι_1 b₁' := by
          rw [hp₁_X1, hv₁u']
        rw [hp₁_b1, ← hp₁u₁_u', map_mul η_C₁,
          mul_comm (η_C₁ (p₁_hom u₁)) (η_C₁ u'), mul_assoc,
          IsLocalization.Away.mul_invSelf (S := M₁) (p₁_hom u₁), mul_one]
  
  have hd₂_loc :
      @IsLocalization.Away A_loc _ d₂ (Localization.Away (p₁_hom d₂)) _
        ((algebraMap C₁ _).comp p₁_hom).toAlgebra := by
    let L_d₂ := Localization.Away d₂
    let η_A2 : A_loc →+* L_d₂ := algebraMap A_loc L_d₂
    let d₂_inv : L_d₂ := IsLocalization.Away.invSelf (S := L_d₂) d₂
    have hd₂_inv : η_A2 d₂ * d₂_inv = 1 :=
      IsLocalization.Away.mul_invSelf (S := L_d₂) d₂
