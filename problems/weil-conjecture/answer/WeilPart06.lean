        have hf_inj : Function.Injective f_inj := by
          rintro ⟨P₁, h1, o1⟩ ⟨P₂, h2, o2⟩ heq
          have hbase := congrArg Subtype.val heq
          have hps := hU₁.fromSpec.isOpenEmbedding.injective hbase
          cases hps
          rfl
        have hFinSub : Finite ↥(Q.primesOver R₁) :=
          @Finite.of_injective _ _ hFin_yQ.to_subtype f_inj hf_inj
        exact Set.toFinite _
      obtain ⟨u_K0⟩ := hUK
      obtain ⟨_, hz_in_U1, ⟨u₀, rfl⟩⟩ :=
        nonempty_preirreducible_inter U₁.2 ι₁.isOpenEmbedding.isOpen_range
