  intro _hPole hZero
  have : IrreducibleSpace ↥X_tilde := AlgebraicGeometry.irreducibleSpace_of_isIntegral X_tilde
  let η : ↥X_tilde := genericPoint ↥X_tilde
  have hη_gen : IsGenericPoint η Set.univ := genericPoint_spec ↥X_tilde
  obtain ⟨x_zero, hx_zero_not1⟩ := hZero
  have hx_zero_0 : x_zero ∈ Ω_0 := by
    have hx_top : x_zero ∈ (⊤ : X_tilde.Opens) := trivial
    rw [← hCov] at hx_top
