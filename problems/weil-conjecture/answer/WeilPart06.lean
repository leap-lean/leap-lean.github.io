    rw [AlgebraicGeometry.Scheme.preimage_basicOpen, hf_bar]
  have hU1_fbar_set : (U_1_comp : Set ↥Y) =
      ((U_part : Set ↥Y) ∩ (Y.basicOpen f_bar : Set ↥Y)) ∪
      (⋃ j : Fin (m_pts + 1), (W_comp j : Set ↥Y)) := by
    ext y
    rw [hU1_set]
    simp only [Set.mem_image, Set.mem_union, Set.mem_inter_iff, Set.mem_iUnion]
    refine ⟨?_, ?_⟩
    · rintro ⟨z, hz1, rfl⟩
      change z ∈ (Ω_1 : Set ↥X_tilde) at hz1
      rw [hΩ1_eq, TopologicalSpace.Opens.coe_sup, TopologicalSpace.Opens.coe_iSup,
        Set.mem_union, Set.mem_iUnion] at hz1
      rcases hz1 with hzf | ⟨j, hzj⟩
      · refine Or.inl ⟨hBf_le_part hzf, ?_⟩
        have hzf' : z ∈ (TopologicalSpace.Opens.map ι_tilde.base).obj (Y.basicOpen f_bar) := by
          rwa [hPre_fbar]
        exact hzf'
      · exact Or.inr ⟨j, hzj⟩
    · rintro (⟨hy_part, hy_bf⟩ | ⟨j, hyWj⟩)
      · obtain ⟨z, rfl⟩ := hSub hy_part
        have hzf : z ∈ X_tilde.basicOpen f_0 := by
          rw [← hPre_fbar]
          exact hy_bf
        exact ⟨z, hBf_le_1 hzf, rfl⟩
      · obtain ⟨z, rfl⟩ := hSub ((hW_props j).1 hyWj)
        exact ⟨z, hWj_le_1 j hyWj, rfl⟩
  have hWj_le_U1 : ∀ j : Fin (m_pts + 1), W_comp j ≤ U_1_comp := by
    intro j y hy
    change y ∈ (U_1_comp : Set ↥Y)
    rw [hU1_fbar_set]
    exact Or.inr (Set.mem_iUnion.mpr ⟨j, hy⟩)
  refine ⟨hU1_fbar_set, ?_, ?_⟩
  · 
    intro h_inter
    let W_ov : Y.Opens := Y.basicOpen f_bar ⊓ U_1_comp
    have hWov_part : W_ov ≤ U_part := inf_le_right.trans hU1_le
    have hWov_Bf0 : (TopologicalSpace.Opens.map ι_tilde.base).obj W_ov ≤ X_tilde.basicOpen f_0 := by
      rw [← hPre_fbar]
      exact (TopologicalSpace.Opens.map ι_tilde.base).monotone inf_le_left
    have hWov_1 : (TopologicalSpace.Opens.map ι_tilde.base).obj W_ov ≤ Ω_1 := by
      rw [← hPreU1]
      exact (TopologicalSpace.Opens.map ι_tilde.base).monotone inf_le_right
    apply hAppInj W_ov hWov_part
    rw [map_mul, map_one, hNatApp h_inter f_bar, hf_bar, hs1_compat W_ov inf_le_right hWov_1]
    have hEq0 : ((TopologicalSpace.Opens.map ι_tilde.base).monotone h_inter) =
        hWov_Bf0.trans hBf_le_0 := rfl
    have hEq1 : hWov_1 = hWov_Bf0.trans hBf_le_1 := rfl
    rw [hEq0, hEq1, ← hResX hWov_Bf0 hBf_le_0 f_0, ← hResX hWov_Bf0 hBf_le_1 s_1,
      ← map_mul, hRecip_ov hBf_le_0 hBf_le_1, map_one]
  · 
    intro j
    obtain ⟨hWj_part, hAffW, hMemW, _hDisjW, hUnitU, hKerW⟩ := hW_props j
    refine ⟨hWj_le_U1 j, hAffW, hMemW, hUnitU, hW_punct j, hKerW, ?_, ?_⟩
    · intro hW_le1
      apply hAppInj (W_comp j) hWj_part
      rw [hs1_compat (W_comp j) hW_le1 (hWj_le_1 j), hPole_ov j (hWj_le_1 j)]
    · intro hB_le0
      let B_j : Y.Opens := Y.basicOpen (t_comp j)
      have hBj_part : B_j ≤ U_part := (Y.basicOpen_le (t_comp j)).trans hWj_part
      have hBj_0 : (TopologicalSpace.Opens.map ι_tilde.base).obj B_j ≤
          (TopologicalSpace.Opens.map ι_tilde.base).obj U_Y0 :=
        (TopologicalSpace.Opens.map ι_tilde.base).monotone hB_le0
      have hBj_1 : (TopologicalSpace.Opens.map ι_tilde.base).obj B_j ≤ Ω_1 :=
        ((TopologicalSpace.Opens.map ι_tilde.base).monotone (Y.basicOpen_le (t_comp j))).trans
          (hWj_le_1 j)
      have hBj_Bf0 : (TopologicalSpace.Opens.map ι_tilde.base).obj B_j ≤ X_tilde.basicOpen f_0 := by
        rw [← hInter_eq]
        exact le_inf hBj_0 hBj_1
      apply hAppInj B_j hBj_part
      rw [map_mul, map_one, hNatApp hB_le0 f_bar, hf_bar,
        hNatApp (Y.basicOpen_le (t_comp j)) (u_comp j * (t_comp j) ^ k₁),
        ← hPole_ov j (hWj_le_1 j), hResX]
      have hEq0 : ((TopologicalSpace.Opens.map ι_tilde.base).monotone hB_le0) =
          hBj_Bf0.trans hBf_le_0 := rfl
      have hEq1 : (((TopologicalSpace.Opens.map ι_tilde.base).monotone (Y.basicOpen_le (t_comp j))).trans
          (hWj_le_1 j)) = hBj_Bf0.trans hBf_le_1 := rfl
      rw [hEq0, hEq1, ← hResX hBj_Bf0 hBf_le_0 f_0, ← hResX hBj_Bf0 hBf_le_1 s_1,
        ← map_mul, hRecip_ov hBf_le_0 hBf_le_1, map_one]

theorem weil_integral_proper_curve_normalization_crt_polar_family (k₀ : Type u) [Field k₀] [IsAlgClosed k₀]
    (Y X : AlgebraicGeometry.Scheme.{u})
    (p_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of k₀))
    (ι_X : X ⟶ Y)
    (hClX : AlgebraicGeometry.IsClosedImmersion ι_X)
    (hIntX : AlgebraicGeometry.IsIntegral X)
    (hPropX : AlgebraicGeometry.IsProper (ι_X ≫ p_Y))
    (hDimX : topologicalKrullDim ↥X = (1 : WithBot ℕ∞))
    (U_part : Y.Opens)
    (hPartSub : (U_part : Set ↥Y) ⊆ Set.range ι_X.base)
    (hPartNe : Nonempty ↥U_part)
    (hSmPart : AlgebraicGeometry.SmoothOfRelativeDimension 1 (U_part.ι ≫ p_Y))
    (hIsoPart : CategoryTheory.IsIso (ι_X ∣_ U_part)) :
    ∃ (X_tilde : AlgebraicGeometry.Scheme.{u})
      (ι_tilde : X_tilde ⟶ Y)
      (m_pts K_bound : ℕ)
      (σ_comp : Fin (m_pts + 1) → (AlgebraicGeometry.Spec (CommRingCat.of k₀) ⟶ Y)),
      1 ≤ K_bound ∧
      AlgebraicGeometry.IsIntegral X_tilde ∧
      (∀ (U : X_tilde.Opens), AlgebraicGeometry.IsAffineOpen U → Nonempty U →
        IsDomain ↑(X_tilde.presheaf.obj (Opposite.op U)) ∧
        IsIntegrallyClosed ↑(X_tilde.presheaf.obj (Opposite.op U))) ∧
      AlgebraicGeometry.IsFinite ι_tilde ∧
      Set.range ι_tilde.base = Set.range ι_X.base ∧
      CategoryTheory.IsIso (ι_tilde ∣_ U_part) ∧
      (∀ j : Fin (m_pts + 1), σ_comp j ≫ p_Y = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k₀))) ∧
      Function.Injective (fun j : Fin (m_pts + 1) => (σ_comp j).base (⊥ : PrimeSpectrum k₀)) ∧
      (∀ j : Fin (m_pts + 1), (σ_comp j).base (⊥ : PrimeSpectrum k₀) ∈ U_part) ∧
      (∀ (U_Y0 : Y.Opens),
        (U_Y0 : Set ↥Y) ∩ Set.range ι_X.base =
          Set.range ι_X.base \ (⋃ j : Fin (m_pts + 1), Set.range (σ_comp j).base) →
        let U_tilde_0 : X_tilde.Opens := (TopologicalSpace.Opens.map ι_tilde.base).obj U_Y0
        AlgebraicGeometry.IsAffineOpen U_tilde_0 ∧
        ∀ (k₁ : ℕ), K_bound ≤ k₁ →
          ∃ (f_tilde : ↑(X_tilde.presheaf.obj (Opposite.op U_tilde_0)))
            (W_comp : Fin (m_pts + 1) → Y.Opens)
            (t_comp u_comp : ∀ j : Fin (m_pts + 1), ↑(Y.presheaf.obj (Opposite.op (W_comp j))))
            (U_1_comp : Y.Opens)
            (s_1_comp : ↑(Y.presheaf.obj (Opposite.op U_1_comp))),
            (∀ z : ↥X_tilde, ι_tilde.base z ∉ U_part →
              z ∈ U_tilde_0 ∧ z ∉ X_tilde.basicOpen f_tilde) ∧
            (Polynomial.eval₂RingHom
              (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
                (ι_tilde ≫ p_Y).appLE ⊤ U_tilde_0 le_top).hom) f_tilde).Finite ∧
            U_1_comp ≤ U_part ∧
            AlgebraicGeometry.IsAffineOpen U_1_comp ∧
            (Polynomial.eval₂RingHom
              (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
                p_Y.appLE ⊤ U_1_comp le_top).hom) s_1_comp).Finite ∧
            (∀ (f_bar : ↑(Y.presheaf.obj (Opposite.op U_Y0))),
              (ι_tilde.app U_Y0).hom f_bar = f_tilde →
              (U_1_comp : Set ↥Y) =
                ((U_part : Set ↥Y) ∩ (Y.basicOpen f_bar : Set ↥Y)) ∪
                (⋃ j : Fin (m_pts + 1), (W_comp j : Set ↥Y)) ∧
              (∀ h_inter : Y.basicOpen f_bar ⊓ U_1_comp ≤ U_Y0,
                (Y.presheaf.map (CategoryTheory.homOfLE h_inter).op).hom f_bar *
                  (Y.presheaf.map (CategoryTheory.homOfLE
                    (inf_le_right : Y.basicOpen f_bar ⊓ U_1_comp ≤ U_1_comp)).op).hom s_1_comp = 1) ∧
              ∀ j : Fin (m_pts + 1),
                W_comp j ≤ U_1_comp ∧
                AlgebraicGeometry.IsAffineOpen (W_comp j) ∧
                (σ_comp j).base (⊥ : PrimeSpectrum k₀) ∈ W_comp j ∧
                IsUnit (u_comp j) ∧
                W_comp j ⊓ U_Y0 = Y.basicOpen (t_comp j) ∧
                (∃ hσ_le : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of k₀)).Opens) ≤
                    (TopologicalSpace.Opens.map (σ_comp j).base).obj (W_comp j),
                  RingHom.ker (((σ_comp j).appLE (W_comp j) ⊤ hσ_le).hom) =
                    Ideal.span {t_comp j}) ∧
                (∀ hW_le1 : W_comp j ≤ U_1_comp,
                  (Y.presheaf.map (CategoryTheory.homOfLE hW_le1).op).hom s_1_comp =
                    u_comp j * (t_comp j) ^ k₁) ∧
                (∀ hB_le0 : Y.basicOpen (t_comp j) ≤ U_Y0,
                  (Y.presheaf.map (CategoryTheory.homOfLE hB_le0).op).hom f_bar *
                    (Y.presheaf.map (CategoryTheory.homOfLE
                      (Y.basicOpen_le (t_comp j))).op).hom (u_comp j * (t_comp j) ^ k₁) = 1))) :=
by
  have hFinIC := fun (A : Type u) [CommRing A] [IsDomain A] [Algebra k₀ A] [Algebra.FiniteType k₀ A]
      (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] =>
    weil_algClosed_finiteType_domain_integralClosure_finite k₀ A K
  obtain ⟨X_tilde, ι_tilde, hInt, hNorm, hFin_ι, hProp_tilde, hRange, hIsoTildePart,
      hSec₀, hFinCl, hValReg⟩ :=
    weil_integral_proper_curve_normalization_and_dvr_regularity k₀ Y X p_Y ι_X
      hClX hIntX hPropX hDimX U_part hPartSub hPartNe hSmPart hIsoPart hFinIC
  have : AlgebraicGeometry.IsIntegral X_tilde := hInt
  have : AlgebraicGeometry.IsFinite ι_tilde := hFin_ι
  have : CategoryTheory.IsIso (ι_tilde ∣_ U_part) := hIsoTildePart
  have hPartSubTilde : (U_part : Set ↥Y) ⊆ Set.range ι_tilde.base := by
    rwa [hRange]
  have hHomComp : ∀ {R₁ R₂ R₃ : CommRingCat.{u}} (f : R₁ ⟶ R₂) (g : R₂ ⟶ R₃) (x : R₁),
      (f ≫ g).hom x = g.hom (f.hom x) := fun _ _ _ => rfl
  have hResX : ∀ {U₁ U₂ U₃ : X_tilde.Opens} (h₁₂ : U₁ ≤ U₂) (h₂₃ : U₂ ≤ U₃)
      (x : ↑(X_tilde.presheaf.obj (Opposite.op U₃))),
      (X_tilde.presheaf.map (CategoryTheory.homOfLE h₁₂).op).hom
        ((X_tilde.presheaf.map (CategoryTheory.homOfLE h₂₃).op).hom x) =
      (X_tilde.presheaf.map (CategoryTheory.homOfLE (h₁₂.trans h₂₃)).op).hom x := by
    intro U₁ U₂ U₃ h₁₂ h₂₃ x
    have hOpComp : (CategoryTheory.homOfLE (h₁₂.trans h₂₃)).op =
        (CategoryTheory.homOfLE h₂₃).op ≫ (CategoryTheory.homOfLE h₁₂).op := by
      rw [← CategoryTheory.homOfLE_comp]; rfl
    rw [hOpComp, CategoryTheory.Functor.map_comp, hHomComp]
  have hAppIso : ∀ (W : Y.Opens), W ≤ U_part → CategoryTheory.IsIso (ι_tilde.app W) := by
    intro W hW
    let V : U_part.toScheme.Opens :=
      ⟨U_part.ι.base ⁻¹' (W : Set ↥Y), W.isOpen.preimage U_part.ι.base.hom.continuous⟩
    have hUV : U_part.ι ''ᵁ V = W := by
      ext y
      change y ∈ U_part.ι.base '' (U_part.ι.base ⁻¹' (W : Set ↥Y)) ↔ y ∈ W
      refine ⟨?_, fun hy => ⟨⟨y, hW hy⟩, hy, rfl⟩⟩
      rintro ⟨z, hzW, rfl⟩
      exact hzW
    have hApp := AlgebraicGeometry.morphismRestrict_app ι_tilde U_part V
    have h1 : CategoryTheory.IsIso ((ι_tilde ∣_ U_part).app V) := inferInstance
    rw [hApp] at h1
    have hMapEqIso : ∀ {U₁ U₂ : X_tilde.Opens} (heq : U₁ = U₂),
        CategoryTheory.IsIso (X_tilde.presheaf.map (CategoryTheory.eqToHom heq).op) := by
      rintro U₁ U₂ rfl
      have hId : (CategoryTheory.eqToHom (rfl : U₁ = U₁)).op = 𝟙 (Opposite.op U₁) := rfl
      rw [hId, CategoryTheory.Functor.map_id]
      infer_instance
    have hOfComp : ∀ {A B C : CommRingCat.{u}} (f : A ⟶ B) (g : B ⟶ C)
        (_ : CategoryTheory.IsIso g), CategoryTheory.IsIso (f ≫ g) → CategoryTheory.IsIso f :=
      fun f g _ hfg => @CategoryTheory.IsIso.of_isIso_comp_right _ _ _ _ _ f g _ hfg
    have h2 : CategoryTheory.IsIso (ι_tilde.app (U_part.ι ''ᵁ V)) :=
      hOfComp _ _ (hMapEqIso _) h1
    rwa [hUV] at h2
  obtain ⟨V_0, t_0, hV0_le, hAffV0, hV0_ne, ht0_ne, hSplit⟩ :=
    weil_smooth_curve_open_etale_coord_and_pole_charts k₀ Y p_Y U_part hPartNe hSmPart
  let V_tilde : X_tilde.Opens := (TopologicalSpace.Opens.map ι_tilde.base).obj V_0
  have hAffVtilde : AlgebraicGeometry.IsAffineOpen V_tilde := hAffV0.preimage ι_tilde
  have hVtilde_ne : Nonempty V_tilde := by
    obtain ⟨y₀, hy₀⟩ := hV0_ne
    obtain ⟨z₀, hz₀⟩ := hPartSubTilde (hV0_le hy₀)
    exact ⟨⟨z₀, by change ι_tilde.base z₀ ∈ V_0; rw [hz₀]; exact hy₀⟩⟩
  let t_tilde : ↑(X_tilde.presheaf.obj (Opposite.op V_tilde)) := (ι_tilde.app V_0).hom t_0
  have hConstMap : ∀ c : k₀,
      (ι_tilde.app V_0).hom
        (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
          p_Y.appLE ⊤ V_0 le_top).hom c) =
      (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
        (ι_tilde ≫ p_Y).appLE ⊤ V_tilde le_top).hom c) := by
    intro c
    have hNat := ι_tilde.naturality
      (CategoryTheory.homOfLE (le_top : V_0 ≤ (TopologicalSpace.Opens.map p_Y.base).obj ⊤)).op
    have hMor : p_Y.appLE ⊤ V_0 le_top ≫ ι_tilde.app V_0 =
        (ι_tilde ≫ p_Y).appLE ⊤ V_tilde le_top :=
      (CategoryTheory.Category.assoc _ _ _).trans
        ((congrArg (p_Y.app ⊤ ≫ ·) hNat).trans (CategoryTheory.Category.assoc _ _ _).symm)
    change (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
      p_Y.appLE ⊤ V_0 le_top ≫ ι_tilde.app V_0).hom c) = _
    rw [hMor]
  have ht_tilde_ne : ∀ c : k₀,
      t_tilde - (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
        (ι_tilde ≫ p_Y).appLE ⊤ V_tilde le_top).hom c) ≠ 0 := by
    intro c hzero
    have : CategoryTheory.IsIso (ι_tilde.app V_0) := hAppIso V_0 hV0_le
    have himg : (ι_tilde.app V_0).hom
        (t_0 - (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
          p_Y.appLE ⊤ V_0 le_top).hom c)) = 0 := by
      rw [map_sub, hConstMap c]
      exact hzero
    have hinj : (ι_tilde.app V_0 ≫ CategoryTheory.inv (ι_tilde.app V_0)).hom
        (t_0 - (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
          p_Y.appLE ⊤ V_0 le_top).hom c)) = 0 := by
      rw [hHomComp, himg, map_zero]
    rw [CategoryTheory.IsIso.hom_inv_id, CommRingCat.hom_id, RingHom.id_apply] at hinj
    exact ht0_ne c hinj
  obtain ⟨hMero, hShift⟩ :=
    weil_normal_proper_curve_meromorphic_projLine_finiteness k₀ X_tilde (ι_tilde ≫ p_Y)
      hNorm hProp_tilde hSec₀ hFinCl hValReg hFinIC
  obtain ⟨c₀, Ω_0, u_0, hZero_tilde, hΩ0_set, hAffΩ0, hΩ0_ne, hInv_tilde⟩ :=
    hShift V_tilde hAffVtilde t_tilde ht_tilde_ne
  let τ_0 : ↑(Y.presheaf.obj (Opposite.op V_0)) :=
    t_0 - (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
      p_Y.appLE ⊤ V_0 le_top).hom c₀)
  let τ_tilde : ↑(X_tilde.presheaf.obj (Opposite.op V_tilde)) :=
    t_tilde - (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
      (ι_tilde ≫ p_Y).appLE ⊤ V_tilde le_top).hom c₀)
  have hτ_map : (ι_tilde.app V_0).hom τ_0 = τ_tilde := by
    change (ι_tilde.app V_0).hom
        (t_0 - (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
          p_Y.appLE ⊤ V_0 le_top).hom c₀)) = τ_tilde
    rw [map_sub, hConstMap c₀]
  let D_τ0 : X_tilde.Opens := (TopologicalSpace.Opens.map ι_tilde.base).obj (Y.basicOpen τ_0)
  have hPre_τ0 : D_τ0 = X_tilde.basicOpen τ_tilde := by
    dsimp [D_τ0]
    rw [AlgebraicGeometry.Scheme.preimage_basicOpen, hτ_map]
  have hZero_Y : ∃ y ∈ V_0, y ∉ Y.basicOpen τ_0 := by
    obtain ⟨x₀, hx₀_V, hx₀_not⟩ := hZero_tilde
    refine ⟨ι_tilde.base x₀, hx₀_V, ?_⟩
    intro hy₀
    have hx₀_in : x₀ ∈ D_τ0 := hy₀
    rw [hPre_τ0] at hx₀_in
    exact hx₀_not hx₀_in
  obtain ⟨m_pts, σ_comp, e_idem, hSec, hInj, hInV0, hFibEq, hPoleCharts⟩ :=
    hSplit c₀ hZero_Y
  have hOutIn0 : ∀ z : ↥X_tilde, ι_tilde.base z ∉ U_part → z ∈ Ω_0 := by
    intro z hz
    change z ∈ (Ω_0 : Set ↥X_tilde)
    rw [hΩ0_set, Set.mem_compl_iff, Set.mem_sdiff, not_and]
    intro hzV
    exact False.elim (hz (hV0_le hzV))
  have hD_le : D_τ0 ≤ Ω_0 := by
    intro z hz
    change z ∈ (Ω_0 : Set ↥X_tilde)
    rw [hPre_τ0] at hz
    rw [hΩ0_set, Set.mem_compl_iff, Set.mem_sdiff, not_and]
    exact fun _ hznot => hznot hz
  have hInv0 : ((ι_tilde.appLE V_0 D_τ0
      ((TopologicalSpace.Opens.map ι_tilde.base).monotone (Y.basicOpen_le τ_0))).hom τ_0) *
      (X_tilde.presheaf.map (CategoryTheory.homOfLE hD_le).op).hom u_0 = 1 := by
    have hB_V : X_tilde.basicOpen τ_tilde ≤ V_tilde := X_tilde.basicOpen_le τ_tilde
    have hB_0 : X_tilde.basicOpen τ_tilde ≤ Ω_0 := hPre_τ0 ▸ hD_le
    have h1 := congrArg
      (X_tilde.presheaf.map (CategoryTheory.homOfLE (le_of_eq hPre_τ0)).op).hom
      (hInv_tilde hB_V hB_0)
    rw [map_mul, map_one, hResX, hResX] at h1
    have hAppLE_eq : (ι_tilde.appLE V_0 D_τ0
        ((TopologicalSpace.Opens.map ι_tilde.base).monotone (Y.basicOpen_le τ_0))).hom τ_0 =
        (X_tilde.presheaf.map (CategoryTheory.homOfLE
          ((le_of_eq hPre_τ0).trans hB_V)).op).hom τ_tilde := by
      change (X_tilde.presheaf.map (CategoryTheory.homOfLE _).op).hom
        ((ι_tilde.app V_0).hom τ_0) = _
      rw [hτ_map]
    rwa [← hAppLE_eq] at h1
  obtain ⟨K_bound, hK1, hCRT⟩ :=
    weil_affine_curve_crt_uniform_polar_family k₀ Y X_tilde (ι_tilde ≫ p_Y) ι_tilde
      hInt hProp_tilde U_part V_0 hV0_le hAffV0 hPartNe hIsoTildePart
      Ω_0 hAffΩ0 (hNorm Ω_0 hAffΩ0 hΩ0_ne).2.2 hFinCl hOutIn0 τ_0 u_0 hD_le hInv0
  have hSpecUnique : ∀ q : PrimeSpectrum k₀, q = (⊥ : PrimeSpectrum k₀) :=
    fun q => Subsingleton.elim q ⊥
  have hRangeσ : ∀ j : Fin (m_pts + 1),
      Set.range (σ_comp j).base = {(σ_comp j).base (⊥ : PrimeSpectrum k₀)} := by
    intro j
    ext y
    simp only [Set.mem_range, Set.mem_singleton_iff]
    refine ⟨?_, fun hy => ⟨(⊥ : PrimeSpectrum k₀), hy.symm⟩⟩
    rintro ⟨q, rfl⟩
    rw [hSpecUnique q]
  refine ⟨X_tilde, ι_tilde, m_pts, K_bound, σ_comp, hK1, hInt,
    fun U hU hUne => ⟨(hNorm U hU hUne).1, (hNorm U hU hUne).2.1⟩,
    hFin_ι, hRange, hIsoTildePart, hSec, hInj, fun j => hV0_le (hInV0 j), ?_⟩
  intro U_Y0 hUY0
  let U_tilde_0 : X_tilde.Opens := (TopologicalSpace.Opens.map ι_tilde.base).obj U_Y0
  have hΩ0_mem_iff : ∀ z : ↥X_tilde,
      z ∈ Ω_0 ↔ ι_tilde.base z ∉ ⋃ j : Fin (m_pts + 1), Set.range (σ_comp j).base := by
    intro z
    change z ∈ (Ω_0 : Set ↥X_tilde) ↔ _
    rw [hΩ0_set, ← hFibEq, Set.mem_compl_iff, Set.mem_sdiff, Set.mem_sdiff]
    change ¬ (ι_tilde.base z ∈ V_0 ∧ z ∉ X_tilde.basicOpen τ_tilde) ↔
      ¬ (ι_tilde.base z ∈ V_0 ∧ ι_tilde.base z ∉ Y.basicOpen τ_0)
    rw [← hPre_τ0]
    rfl
  have hΩ0_eq : Ω_0 = U_tilde_0 := by
    ext z
    change z ∈ Ω_0 ↔ ι_tilde.base z ∈ (U_Y0 : Set ↥Y)
    rw [hΩ0_mem_iff z]
    have hz_in : ι_tilde.base z ∈ Set.range ι_X.base := by
      rw [← hRange]
      exact ⟨z, rfl⟩
    have h_inter : ι_tilde.base z ∈ (U_Y0 : Set ↥Y) ↔
        ι_tilde.base z ∈ (U_Y0 : Set ↥Y) ∩ Set.range ι_X.base :=
      ⟨fun h => ⟨h, hz_in⟩, fun h => h.1⟩
    rw [h_inter, hUY0, Set.mem_sdiff]
    exact ⟨fun h => ⟨hz_in, h⟩, fun h => h.2⟩
  have hAff_U0 : AlgebraicGeometry.IsAffineOpen U_tilde_0 := hΩ0_eq ▸ hAffΩ0
  refine ⟨hAff_U0, ?_⟩
  intro k₁ hk₁
  have hk₁_pos : 1 ≤ k₁ := le_trans hK1 hk₁
  obtain ⟨f_0, w, hVan0, hw_mod, hPowEq⟩ := hCRT k₁ hk₁
  let W_comp : Fin (m_pts + 1) → Y.Opens := fun j => Y.basicOpen (e_idem j * w)
  choose hWj_le u_comp hWj_props using fun j => hPoleCharts w hw_mod j
  let t_comp : ∀ j : Fin (m_pts + 1), ↑(Y.presheaf.obj (Opposite.op (W_comp j))) :=
    fun j => (Y.presheaf.map (CategoryTheory.homOfLE (hWj_le j)).op).hom τ_0
  let W_tilde : Fin (m_pts + 1) → X_tilde.Opens :=
    fun j => (TopologicalSpace.Opens.map ι_tilde.base).obj (W_comp j)
  have hPtPre : ∀ j : Fin (m_pts + 1),
      ∃ p_j : ↥X_tilde, ι_tilde.base p_j = (σ_comp j).base (⊥ : PrimeSpectrum k₀) :=
    fun j => hPartSubTilde (hV0_le (hInV0 j))
  choose p_pole hp_pole using hPtPre
  have hWtilde_ne : ∀ j : Fin (m_pts + 1), Nonempty (W_tilde j) := by
    intro j
    refine ⟨⟨p_pole j, ?_⟩⟩
    change ι_tilde.base (p_pole j) ∈ W_comp j
    rw [hp_pole j]
    exact (hWj_props j).2.1
  have hDτ0_ne : Nonempty D_τ0 := by
    rw [hPre_τ0]
    have : IsDomain ↑(X_tilde.presheaf.obj (Opposite.op V_tilde)) :=
      (hNorm V_tilde hAffVtilde hVtilde_ne).1
    let pt : PrimeSpectrum ↑(X_tilde.presheaf.obj (Opposite.op V_tilde)) := ⊥
    have hτ_ne : τ_tilde ≠ 0 := ht_tilde_ne c₀
    have hpt : pt ∈ PrimeSpectrum.basicOpen τ_tilde := by
      rw [PrimeSpectrum.mem_basicOpen]
      exact hτ_ne
    have hmem : pt ∈ hAffVtilde.fromSpec ⁻¹ᵁ X_tilde.basicOpen τ_tilde := by
      rw [hAffVtilde.fromSpec_preimage_basicOpen]
      exact hpt
    exact ⟨⟨hAffVtilde.fromSpec.base pt, hmem⟩⟩
  let r_pole : ∀ j : Fin (m_pts + 1), ↑(X_tilde.presheaf.obj (Opposite.op (W_tilde j))) :=
    fun j => (ι_tilde.app (W_comp j)).hom (u_comp j * (t_comp j) ^ k₁)
  let h_polar : ↑X_tilde.functionField := (X_tilde.germToFunctionField Ω_0).hom f_0
  have hMulGerm : ∀ j : Fin (m_pts + 1),
      letI : Nonempty (W_tilde j) := hWtilde_ne j
      h_polar * (X_tilde.germToFunctionField (W_tilde j)).hom (r_pole j) = 1 := by
    intro j
    have : Nonempty (W_tilde j) := hWtilde_ne j
    let O_j : X_tilde.Opens := W_tilde j ⊓ D_τ0
    have hW_ne_set : (W_tilde j : Set ↥X_tilde).Nonempty := by
      obtain ⟨⟨x, hx⟩⟩ := hWtilde_ne j; exact ⟨x, hx⟩
    have hD_ne_set : (D_τ0 : Set ↥X_tilde).Nonempty := by
      obtain ⟨⟨x, hx⟩⟩ := hDτ0_ne; exact ⟨x, hx⟩
    have hηW : genericPoint ↥X_tilde ∈ W_tilde j :=
      ((genericPoint_spec ↥X_tilde).mem_open_set_iff (W_tilde j).isOpen).mpr
        (by simpa using hW_ne_set)
    have hηD : genericPoint ↥X_tilde ∈ D_τ0 :=
      ((genericPoint_spec ↥X_tilde).mem_open_set_iff D_τ0.isOpen).mpr
        (by simpa using hD_ne_set)
    have : Nonempty O_j := ⟨⟨genericPoint ↥X_tilde, ⟨hηW, hηD⟩⟩⟩
    have hO_W : O_j ≤ W_tilde j := inf_le_left
    have hO_D : O_j ≤ D_τ0 := inf_le_right
    have hO_0 : O_j ≤ Ω_0 := hO_D.trans hD_le
    have hPow_O := congrArg (X_tilde.presheaf.map (CategoryTheory.homOfLE hO_D).op).hom hPowEq
    rw [map_mul, map_pow, hResX] at hPow_O
    have hAppRes : ∀ (s_Y : ↑(Y.presheaf.obj (Opposite.op V_0))),
        (X_tilde.presheaf.map (CategoryTheory.homOfLE hO_D).op).hom
          ((ι_tilde.appLE V_0 D_τ0
            ((TopologicalSpace.Opens.map ι_tilde.base).monotone (Y.basicOpen_le τ_0))).hom s_Y) =
        (X_tilde.presheaf.map (CategoryTheory.homOfLE hO_W).op).hom
          ((ι_tilde.app (W_comp j)).hom
            ((Y.presheaf.map (CategoryTheory.homOfLE (hWj_le j)).op).hom s_Y)) := by
      intro s_Y
      have hLHS : (X_tilde.presheaf.map (CategoryTheory.homOfLE hO_D).op).hom
          ((ι_tilde.appLE V_0 D_τ0
            ((TopologicalSpace.Opens.map ι_tilde.base).monotone (Y.basicOpen_le τ_0))).hom s_Y) =
          (X_tilde.presheaf.map (CategoryTheory.homOfLE
            (hO_D.trans ((TopologicalSpace.Opens.map ι_tilde.base).monotone (Y.basicOpen_le τ_0)))).op).hom
            ((ι_tilde.app V_0).hom s_Y) := by
        change (X_tilde.presheaf.map (CategoryTheory.homOfLE hO_D).op).hom
          ((X_tilde.presheaf.map (CategoryTheory.homOfLE _).op).hom ((ι_tilde.app V_0).hom s_Y)) = _
        rw [hResX]
      have hNat := congrArg (fun g => g.hom s_Y)
        (ι_tilde.naturality (CategoryTheory.homOfLE (hWj_le j)).op)
      dsimp at hNat
      rw [hLHS, hNat, hResX]
    rw [hAppRes τ_0, hAppRes w] at hPow_O
    have huw : (X_tilde.presheaf.map (CategoryTheory.homOfLE hO_W).op).hom
        ((ι_tilde.app (W_comp j)).hom (u_comp j)) *
        (X_tilde.presheaf.map (CategoryTheory.homOfLE hO_W).op).hom
          ((ι_tilde.app (W_comp j)).hom
            ((Y.presheaf.map (CategoryTheory.homOfLE (hWj_le j)).op).hom w)) = 1 := by
      rw [← map_mul, ← map_mul, (hWj_props j).2.2.2.2.1, map_one, map_one]
    have hProd_O : (X_tilde.presheaf.map (CategoryTheory.homOfLE hO_0).op).hom f_0 *
        (X_tilde.presheaf.map (CategoryTheory.homOfLE hO_W).op).hom (r_pole j) = 1 := by
      dsimp [r_pole]
      rw [map_mul, map_pow, map_mul, map_pow]
      calc
        (X_tilde.presheaf.map (CategoryTheory.homOfLE hO_0).op).hom f_0 *
            ((X_tilde.presheaf.map (CategoryTheory.homOfLE hO_W).op).hom
              ((ι_tilde.app (W_comp j)).hom (u_comp j)) *
              (X_tilde.presheaf.map (CategoryTheory.homOfLE hO_W).op).hom
                ((ι_tilde.app (W_comp j)).hom (t_comp j)) ^ k₁)
          = (X_tilde.presheaf.map (CategoryTheory.homOfLE hO_W).op).hom
              ((ι_tilde.app (W_comp j)).hom (u_comp j)) *
            ((X_tilde.presheaf.map (CategoryTheory.homOfLE hO_W).op).hom
              ((ι_tilde.app (W_comp j)).hom (t_comp j)) ^ k₁ *
              (X_tilde.presheaf.map (CategoryTheory.homOfLE hO_0).op).hom f_0) := by ring
        _ = 1 := by rw [hPow_O, huw]
    have hGerm := congrArg (X_tilde.germToFunctionField O_j).hom hProd_O
    rw [map_mul, map_one,
      TopCat.Presheaf.germ_res_apply X_tilde.presheaf (CategoryTheory.homOfLE hO_0) _ _ f_0,
      TopCat.Presheaf.germ_res_apply X_tilde.presheaf (CategoryTheory.homOfLE hO_W) _ _ (r_pole j)] at hGerm
    exact hGerm
  have h_polar_ne : h_polar ≠ 0 := by
    have : Nonempty (W_tilde 0) := hWtilde_ne 0
    exact left_ne_zero_of_mul_eq_one (hMulGerm 0)
  have hGerm_r : ∀ j : Fin (m_pts + 1),
      letI : Nonempty (W_tilde j) := hWtilde_ne j
      (X_tilde.germToFunctionField (W_tilde j)).hom (r_pole j) = h_polar⁻¹ := by
    intro j
    have : Nonempty (W_tilde j) := hWtilde_ne j
    exact eq_inv_of_mul_eq_one_right (hMulGerm j)
  obtain ⟨Ω_0', Ω_1', hΩ0'_ne, hΩ1'_ne, f_0', s_1',
      hCov', hInter0', hInter1', _hGerm0', _hGerm1',
      hExt0', hExt1', hRecip', hNonConst'⟩ :=
    hMero h_polar h_polar_ne
  obtain ⟨hΩ0_le_0', hf0'_res⟩ := hExt0' Ω_0 f_0 rfl
  have hExt1_W : ∀ j : Fin (m_pts + 1),
      ∃ hWj : W_tilde j ≤ Ω_1',
        (X_tilde.presheaf.map (CategoryTheory.homOfLE hWj).op).hom s_1' = r_pole j := by
    intro j
    have : Nonempty (W_tilde j) := hWtilde_ne j
    exact hExt1' (W_tilde j) (r_pole j) (hGerm_r j)
  have hσ_not_basic : ∀ j : Fin (m_pts + 1),
      (σ_comp j).base (⊥ : PrimeSpectrum k₀) ∉ Y.basicOpen (t_comp j) := by
    intro j hmem
    obtain ⟨hσ_le, hker⟩ := (hWj_props j).2.2.2.2.2
    have ht_zero : (((σ_comp j).appLE (W_comp j) ⊤ hσ_le).hom (t_comp j)) = 0 := by
      rw [← RingHom.mem_ker, hker]
      exact Ideal.subset_span (Set.mem_singleton _)
    have hbo : (AlgebraicGeometry.Spec (CommRingCat.of k₀)).basicOpen
        (((σ_comp j).appLE (W_comp j) ⊤ hσ_le).hom (t_comp j)) = ⊥ := by
      rw [ht_zero, AlgebraicGeometry.Scheme.basicOpen_zero]
    have hbo_eq : (AlgebraicGeometry.Spec (CommRingCat.of k₀)).basicOpen
        (((σ_comp j).appLE (W_comp j) ⊤ hσ_le).hom (t_comp j)) =
        ⊤ ⊓ (TopologicalSpace.Opens.map (σ_comp j).base).obj (Y.basicOpen (t_comp j)) := by
      have hAppUnfold : (((σ_comp j).appLE (W_comp j) ⊤ hσ_le).hom (t_comp j)) =
          ((AlgebraicGeometry.Spec (CommRingCat.of k₀)).presheaf.map
            (CategoryTheory.homOfLE hσ_le).op).hom
            (((σ_comp j).app (W_comp j)).hom (t_comp j)) := rfl
      rw [hAppUnfold, AlgebraicGeometry.Scheme.basicOpen_res]
      exact congrArg (⊤ ⊓ ·)
        (AlgebraicGeometry.Scheme.preimage_basicOpen (σ_comp j) (t_comp j)).symm
    rw [hbo_eq] at hbo
    have hbot_in : (⊥ : PrimeSpectrum k₀) ∈
        (⊤ ⊓ (TopologicalSpace.Opens.map (σ_comp j).base).obj (Y.basicOpen (t_comp j)) :
          (AlgebraicGeometry.Spec (CommRingCat.of k₀)).Opens) :=
      ⟨trivial, hmem⟩
    rw [hbo] at hbot_in
    exact False.elim hbot_in
  have hΩ0'_eq : Ω_0' = Ω_0 := by
    apply le_antisymm _ hΩ0_le_0'
    intro z hz0'
    by_contra hz_not0
    rw [hΩ0_mem_iff z, Set.mem_iUnion, not_exists, Classical.not_forall] at hz_not0
    obtain ⟨j, hzj⟩ := hz_not0
    replace hzj := Classical.not_not.mp hzj
    rw [hRangeσ j, Set.mem_singleton_iff] at hzj
    have hzW : z ∈ W_tilde j := by
      change ι_tilde.base z ∈ W_comp j
      rw [hzj]
      exact (hWj_props j).2.1
    obtain ⟨hWj_1', hs1'_Wj⟩ := hExt1_W j
    have hz_inter : z ∈ Ω_0' ⊓ Ω_1' := ⟨hz0', hWj_1' hzW⟩
    rw [hInter1'] at hz_inter
    have hz_rj : z ∈ X_tilde.basicOpen (r_pole j) := by
      rw [← hs1'_Wj, AlgebraicGeometry.Scheme.basicOpen_res]
      exact ⟨hzW, hz_inter⟩
    have hz_rj_eq : X_tilde.basicOpen (r_pole j) =
        (TopologicalSpace.Opens.map ι_tilde.base).obj
          (Y.basicOpen (u_comp j * (t_comp j) ^ k₁)) :=
      (AlgebraicGeometry.Scheme.preimage_basicOpen ι_tilde
        (u_comp j * (t_comp j) ^ k₁)).symm
    rw [hz_rj_eq] at hz_rj
    change ι_tilde.base z ∈ Y.basicOpen (u_comp j * (t_comp j) ^ k₁) at hz_rj
    rw [hzj, AlgebraicGeometry.Scheme.basicOpen_mul,
      AlgebraicGeometry.Scheme.basicOpen_pow _ _ (Nat.pos_of_ne_zero (by omega))] at hz_rj
    exact hσ_not_basic j hz_rj.2
  subst Ω_0'
  have hf0'_eq : f_0' = f_0 := by
    have hIdOp : (CategoryTheory.homOfLE hΩ0_le_0').op = 𝟙 (Opposite.op Ω_0) := by
      have hId : CategoryTheory.homOfLE hΩ0_le_0' = 𝟙 Ω_0 := Subsingleton.elim _ _
      rw [hId]; rfl
    rw [hIdOp, CategoryTheory.Functor.map_id, CommRingCat.hom_id,
      RingHom.id_apply] at hf0'_res
    exact hf0'_res
  subst f_0'
  have hHasPole : ∃ x_pole : ↥X_tilde, x_pole ∉ Ω_0 := by
    refine ⟨p_pole 0, ?_⟩
    rw [hΩ0_mem_iff]
    intro hnot
    exact hnot (Set.mem_iUnion.mpr ⟨0, by rw [hp_pole 0, hRangeσ 0]; exact Set.mem_singleton _⟩)
  obtain ⟨_hAff0', hAff1', hFin_f0, hFin_s1'⟩ := hNonConst' hHasPole
  have hΩ1'_eq : Ω_1' = X_tilde.basicOpen f_0 ⊔ ⨆ j : Fin (m_pts + 1), W_tilde j := by
    apply le_antisymm
    · intro z hz1'
      by_cases hz0 : z ∈ Ω_0
      · have hz_in : z ∈ Ω_0 ⊓ Ω_1' := ⟨hz0, hz1'⟩
        rw [hInter0'] at hz_in
        exact TopologicalSpace.Opens.mem_sup.mpr (Or.inl hz_in)
      · have hz_ex : ∃ j : Fin (m_pts + 1), ι_tilde.base z ∈ Set.range (σ_comp j).base := by
          by_contra hnone
          exact hz0 ((hΩ0_mem_iff z).mpr (by rwa [Set.mem_iUnion]))
        obtain ⟨j, hzj⟩ := hz_ex
        rw [hRangeσ j, Set.mem_singleton_iff] at hzj
        have hzW : z ∈ W_tilde j := by
          change ι_tilde.base z ∈ W_comp j
          rw [hzj]
          exact (hWj_props j).2.1
        exact TopologicalSpace.Opens.mem_sup.mpr
          (Or.inr (TopologicalSpace.Opens.mem_iSup.mpr ⟨j, hzW⟩))
    · refine sup_le ?_ (iSup_le fun j => (hExt1_W j).choose)
      rw [← hInter0']
      exact inf_le_right
  have hW_props_all : ∀ j : Fin (m_pts + 1),
      W_comp j ≤ U_part ∧
      AlgebraicGeometry.IsAffineOpen (W_comp j) ∧
      (σ_comp j).base (⊥ : PrimeSpectrum k₀) ∈ W_comp j ∧
      (∀ j' : Fin (m_pts + 1), j' ≠ j → (σ_comp j').base (⊥ : PrimeSpectrum k₀) ∉ W_comp j) ∧
      IsUnit (u_comp j) ∧
      (∃ hσ_le : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of k₀)).Opens) ≤
          (TopologicalSpace.Opens.map (σ_comp j).base).obj (W_comp j),
        RingHom.ker (((σ_comp j).appLE (W_comp j) ⊤ hσ_le).hom) =
          Ideal.span {t_comp j}) := by
    intro j
    obtain ⟨hAffWj, hMemWj, hDisjWj, hUnitUj, _huw, hKerWj⟩ := hWj_props j
    exact ⟨(hWj_le j).trans hV0_le, hAffWj, hMemWj, hDisjWj, hUnitUj, hKerWj⟩
  have hRecip_ov : ∀ (h0 : X_tilde.basicOpen f_0 ≤ Ω_0) (h1 : X_tilde.basicOpen f_0 ≤ Ω_1'),
      (X_tilde.presheaf.map (CategoryTheory.homOfLE h0).op).hom f_0 *
        (X_tilde.presheaf.map (CategoryTheory.homOfLE h1).op).hom s_1' = 1 := by
    intro h0 h1
    have hEq_le : X_tilde.basicOpen f_0 ≤ Ω_0 ⊓ Ω_1' := le_of_eq hInter0'.symm
    have h1_prod := congrArg
      (X_tilde.presheaf.map (CategoryTheory.homOfLE hEq_le).op).hom
      (hRecip' inf_le_left inf_le_right)
    rw [map_mul, map_one, hResX, hResX] at h1_prod
    exact h1_prod
  have hPole_ov : ∀ (j : Fin (m_pts + 1)) (hWj_1 : W_tilde j ≤ Ω_1'),
      (X_tilde.presheaf.map (CategoryTheory.homOfLE hWj_1).op).hom s_1' =
        (ι_tilde.app (W_comp j)).hom (u_comp j * (t_comp j) ^ k₁) := by
    intro j hWj_1
    exact (hExt1_W j).choose_spec
  obtain ⟨f_tilde, U_1_comp, s_1_comp, hVan_tilde, hFin_tilde,
      hU1_le, hAff_U1, hFin_U1, hf_bar_compat⟩ :=
    weil_curve_open_iso_chart_transport_and_fbar_compat k₀ Y X_tilde p_Y ι_tilde
      U_part hPartSubTilde hIsoTildePart m_pts k₁ σ_comp hSec U_Y0 (hRange ▸ hUY0)
      Ω_0 hΩ0_eq f_0 (fun z hz => ⟨hOutIn0 z hz, hVan0 z hz⟩) hFin_f0
      W_comp t_comp u_comp hW_props_all Ω_1' hAff1' hΩ1'_eq hInter0'
      s_1' hFin_s1' hRecip_ov hPole_ov
  exact ⟨f_tilde, W_comp, t_comp, u_comp, U_1_comp, s_1_comp,
    hVan_tilde, hFin_tilde, hU1_le, hAff_U1, hFin_U1, hf_bar_compat⟩

theorem weil_etale_nodal_roof_branch_domains_and_colon_descent (k₀ : Type u) [Field k₀] [IsAlgClosed k₀]
    (A B' : Type u) [CommRing A] [CommRing B']
    (c_A : k₀ →+* A)
    (φ₀ : A →+* B')
    (ψ₀ : (MvPolynomial (Fin 2) k₀ ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}) →+* B')
    (hEtφ₀ : φ₀.Etale)
    (hEtψ₀ : ψ₀.Etale)
    (hCompat : φ₀.comp c_A = ψ₀.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C))
    (p_y : Ideal A) [p_y.IsPrime]
    (q₀ : Ideal B') [q₀.IsPrime]
    (hComap : Ideal.comap φ₀ q₀ = p_y)
    (hNode : ∀ i : Fin 2, ψ₀ (Ideal.Quotient.mk _ (MvPolynomial.X i)) ∈ q₀) :
    (p_y.IsMaximal ∧ Function.Bijective ((Ideal.Quotient.mk p_y).comp c_A)) ∧
    ∃ (h : B'), h ∉ q₀ ∧
      ∀ (g : A), g ∉ p_y →
        ∀ (A₁ B'₁ : Type u) [CommRing A₁] [CommRing B'₁]
          (loc_A : A →+* A₁) (loc_B : B' →+* B'₁) (φ₁ : A₁ →+* B'₁),
          φ₁.comp loc_A = loc_B.comp φ₀ →
          φ₁.Etale →
          Function.Surjective (PrimeSpectrum.comap φ₁) →
          @IsLocalization.Away A _ g A₁ _ loc_A.toAlgebra →
          @IsLocalization.Away B' _ (h * φ₀ g) B'₁ _ loc_B.toAlgebra →
          let x₀ : B'₁ := loc_B (ψ₀ (Ideal.Quotient.mk _ (MvPolynomial.X 0)))
          let x₁ : B'₁ := loc_B (ψ₀ (Ideal.Quotient.mk _ (MvPolynomial.X 1)))
          let D₀ := B'₁ ⧸ Ideal.span {x₁}
          let D₁ := B'₁ ⧸ Ideal.span {x₀}
          let π₀ : B'₁ →+* D₀ := Ideal.Quotient.mk (Ideal.span {x₁})
          let π₁ : B'₁ →+* D₁ := Ideal.Quotient.mk (Ideal.span {x₀})
          IsDomain D₀ ∧ IsIntegrallyClosed D₀ ∧
          IsDomain D₁ ∧ IsIntegrallyClosed D₁ ∧
          ∃ (p_y1 : Ideal A₁) (qbar₀ : Ideal D₀) (qbar₁ : Ideal D₁) (s : A₁),
            p_y1.IsPrime ∧ qbar₀.IsPrime ∧ qbar₁.IsPrime ∧
            Ideal.comap loc_A p_y1 = p_y ∧
