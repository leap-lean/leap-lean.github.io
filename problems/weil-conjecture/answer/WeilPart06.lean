    have _ : CategoryTheory.IsIso hU_sp.fromSpec :=
      AlgebraicGeometry.isIso_of_isOpenImmersion_of_opensRange_eq_top hU_sp.fromSpec hRange_sp_top
    let iso_sp_sch : AlgebraicGeometry.Spec ((AlgebraicGeometry.Spec (CommRingCat.of K)).presheaf.obj
        (Opposite.op U_sp)) ≅ AlgebraicGeometry.Spec (CommRingCat.of K) := asIso hU_sp.fromSpec
    let iso_K_RU : CommRingCat.of K ≅
        (AlgebraicGeometry.Spec (CommRingCat.of K)).presheaf.obj (Opposite.op U_sp) :=
      { hom := AlgebraicGeometry.Spec.preimage iso_sp_sch.hom
        inv := AlgebraicGeometry.Spec.preimage iso_sp_sch.inv
        hom_inv_id := by
          rw [← AlgebraicGeometry.Spec.preimage_comp, iso_sp_sch.inv_hom_id,
            AlgebraicGeometry.Spec.preimage_id]
        inv_hom_id := by
          rw [← AlgebraicGeometry.Spec.preimage_comp, iso_sp_sch.hom_inv_id,
            AlgebraicGeometry.Spec.preimage_id] }
    let e_K : K ≃+* ↑((AlgebraicGeometry.Spec (CommRingCat.of K)).presheaf.obj (Opposite.op U_sp)) :=
      iso_K_RU.commRingCatIsoToRingEquiv
    obtain ⟨g₀, hg₀_C, hg₀_et⟩ := hStdSm.exists_etale_mvPolynomial
    let e_poly : MvPolynomial (Fin 1) K ≃+*
        MvPolynomial (Fin 1) ↑((AlgebraicGeometry.Spec (CommRingCat.of K)).presheaf.obj (Opposite.op U_sp)) :=
      MvPolynomial.mapEquiv (Fin 1) e_K
    let B_K := ↑(U_K.toScheme.presheaf.obj (Opposite.op V_sm))
    let g_K : MvPolynomial (Fin 1) K →+* B_K := g₀.comp e_poly.toRingHom
    have hg_K_et : g_K.Etale :=
      RingHom.Etale.stableUnderComposition e_poly.toRingHom g₀
        (RingHom.Etale.of_bijective e_poly.bijective) hg₀_et
    let f_K : K →+* B_K := g_K.comp MvPolynomial.C
    have hf_K_eq : f_K = ((U_K.ι ≫ p_K).appLE U_sp V_sm he_sm).hom.comp e_K.toRingHom := by
      ext c
      change g₀ (e_poly (MvPolynomial.C c)) = ((U_K.ι ≫ p_K).appLE U_sp V_sm he_sm).hom (e_K c)
