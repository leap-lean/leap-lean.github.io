    have hxV : x ∈ V := hxU
    letI : Nonempty V := ⟨⟨x, hxV⟩⟩
    obtain ⟨hFT_A, hDimA, e, he⟩ := hChart U_X hU_X hUne
    let A := ↑(X.presheaf.obj (Opposite.op U_X))
    let K := ↑X.functionField
    have : IsFractionRing A K :=
      AlgebraicGeometry.functionField_isFractionRing_of_isAffineOpen X U_X hU_X
    let φ_A : k₀ →+* A :=
      (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
        p_X.appLE ⊤ U_X le_top).hom)
    letI : Algebra k₀ A := φ_A.toAlgebra
    have : Algebra.FiniteType k₀ A := hFT_A
    obtain ⟨hFin_A, hIC_C⟩ := hFinIntClosure A K
    let B := ↑(X_tilde.presheaf.obj (Opposite.op V))
    let φ_V : k₀ →+* B :=
      (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
        p_tilde.appLE ⊤ V le_top).hom)
    let ψ_AB : A →+* B := (ν.app U_X).hom
    have hComp : ψ_AB.comp φ_A = φ_V := by
      have hAppLE_eq : ∀ {f₁ f₂ : X_tilde ⟶ AlgebraicGeometry.Spec (CommRingCat.of k₀)}
          (_ : f₁ = f₂) (h₁ : V ≤ f₁ ⁻¹ᵁ ⊤) (h₂ : V ≤ f₂ ⁻¹ᵁ ⊤),
          f₁.appLE ⊤ V h₁ = f₂.appLE ⊤ V h₂ := by
        rintro f₁ _ rfl _ _; rfl
      have hNat := ν.naturality
        (CategoryTheory.homOfLE (le_top : U_X ≤ (TopologicalSpace.Opens.map p_X.base).obj ⊤)).op
      have hMor : p_X.appLE ⊤ U_X le_top ≫ ν.app U_X = p_tilde.appLE ⊤ V le_top := by
        have h1 : p_X.appLE ⊤ U_X le_top ≫ ν.app U_X = (ν ≫ p_X).appLE ⊤ V le_top :=
          (CategoryTheory.Category.assoc _ _ _).trans
            ((congrArg (p_X.app ⊤ ≫ ·) hNat).trans (CategoryTheory.Category.assoc _ _ _).symm)
        exact h1.trans (hAppLE_eq (CategoryTheory.Category.assoc ν ι_X p_Y).symm _ _)
      change ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
        (p_X.appLE ⊤ U_X le_top ≫ ν.app U_X)).hom = φ_V
      rw [hMor]
    obtain ⟨_, hIC_B, hDim_B, hEv_B, hFinZ_B, hDVR_B⟩ :=
      h_s2 A hDimA K hFin_A hIC_C B φ_V ψ_AB hComp e he
    have : IsFractionRing B ↑X_tilde.functionField :=
      AlgebraicGeometry.functionField_isFractionRing_of_isAffineOpen X_tilde V hV_aff
    refine ⟨V, hV_aff, hxV, hIC_B, hDim_B, hEv_B, hFinZ_B, ?_⟩
    intro h hh 𝔓 h𝔓
    exact @hDVR_B ↑X_tilde.functionField _ _ _ h hh 𝔓 h𝔓

  have : IrreducibleSpace ↥X_tilde := AlgebraicGeometry.irreducibleSpace_of_isIntegral X_tilde
  have : AlgebraicGeometry.IsProper p_tilde := hProp_tilde
  let η_tilde : ↥X_tilde := genericPoint ↥X_tilde
  let S₀ := AlgebraicGeometry.Spec (CommRingCat.of k₀)
  have hBuildSec : ∀ (V : X_tilde.Opens) (hV : AlgebraicGeometry.IsAffineOpen V)
      (ev : ↑(X_tilde.presheaf.obj (Opposite.op V)) →+* k₀),
      ev.comp (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
        p_tilde.appLE ⊤ V le_top).hom) = RingHom.id k₀ →
      let σ : S₀ ⟶ X_tilde := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev) ≫ hV.fromSpec
      σ ≫ p_tilde = 𝟙 S₀ ∧
      ∀ (q : PrimeSpectrum ↑(X_tilde.presheaf.obj (Opposite.op V))),
        RingHom.ker ev = q.asIdeal →
        σ.base (⊥ : PrimeSpectrum k₀) = hV.fromSpec.base q := by
    intro V hV ev hev
    let φ_V := ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
      p_tilde.appLE ⊤ V le_top).hom
    let σ : S₀ ⟶ X_tilde := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev) ≫ hV.fromSpec
    have hFromComp : hV.fromSpec ≫ p_tilde =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_V) := by
      apply (cancel_mono S₀.toSpecΓ).mp
      rw [AlgebraicGeometry.Scheme.toSpecΓ_naturality (hV.fromSpec ≫ p_tilde),
        AlgebraicGeometry.Scheme.toSpecΓ_naturality
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_V))]
      congr 1
      apply congrArg AlgebraicGeometry.Spec.map
      apply (cancel_epi (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv).mp
      rw [← AlgebraicGeometry.Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom φ_V)]
      change (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
        (p_tilde.app ⊤ ≫ hV.fromSpec.app ⊤) =
        CommRingCat.ofHom φ_V ≫
          (AlgebraicGeometry.Scheme.ΓSpecIso (X_tilde.presheaf.obj (Opposite.op V))).inv
      rw [hV.fromSpec_app_of_le ⊤ le_top]
      have hIdComp : ∀ (hle : hV.fromSpec ⁻¹ᵁ (⊤ : X_tilde.Opens) ≤ ⊤),
          (AlgebraicGeometry.Scheme.ΓSpecIso (X_tilde.presheaf.obj (Opposite.op V))).inv ≫
            (AlgebraicGeometry.Spec (X_tilde.presheaf.obj (Opposite.op V))).presheaf.map
              (CategoryTheory.homOfLE hle).op =
          (AlgebraicGeometry.Scheme.ΓSpecIso (X_tilde.presheaf.obj (Opposite.op V))).inv := by
        intro hle
        have hEq : CategoryTheory.homOfLE hle =
            𝟙 (⊤ : (AlgebraicGeometry.Spec (X_tilde.presheaf.obj (Opposite.op V))).Opens) :=
          Subsingleton.elim _ _
        exact (congrArg
          (fun m => (AlgebraicGeometry.Scheme.ΓSpecIso _).inv ≫
            (AlgebraicGeometry.Spec _).presheaf.map m.op) hEq).trans
          ((congrArg ((AlgebraicGeometry.Scheme.ΓSpecIso _).inv ≫ ·)
            (CategoryTheory.Functor.map_id _ _)).trans
            (CategoryTheory.Category.comp_id _))
      exact (congrArg ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
        p_tilde.app ⊤ ≫ X_tilde.presheaf.map (CategoryTheory.homOfLE le_top).op ≫ ·)
        (hIdComp _)).trans rfl
    have hSec : σ ≫ p_tilde = 𝟙 S₀ := by
      dsimp [σ]
      rw [CategoryTheory.Category.assoc, hFromComp, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, hev, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
    refine ⟨hSec, fun q hker => ?_⟩
    change hV.fromSpec.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev)).base
      (⊥ : PrimeSpectrum k₀)) = hV.fromSpec.base q
    congr 1
    apply PrimeSpectrum.ext
    change Ideal.comap ev (⊥ : Ideal k₀) = q.asIdeal
    exact hker
  have hExSec₀ : ∃ σ₀ : S₀ ⟶ X_tilde, σ₀ ≫ p_tilde = 𝟙 S₀ := by
    obtain ⟨V₀, hV₀, hη₀, _, _, hEv₀, _, _⟩ := hLoc η_tilde
    letI : Nonempty V₀ := ⟨⟨η_tilde, hη₀⟩⟩
    let B₀ := ↑(X_tilde.presheaf.obj (Opposite.op V₀))
    obtain ⟨𝔪₀, h𝔪₀_max, _⟩ := Ideal.exists_le_maximal (⊥ : Ideal B₀) bot_ne_top
    obtain ⟨ev₀, hev₀, _⟩ := @hEv₀ 𝔪₀ h𝔪₀_max
    exact ⟨AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev₀) ≫ hV₀.fromSpec,
      (hBuildSec V₀ hV₀ ev₀ hev₀).1⟩
  have hClosedPt : ∀ x : ↥X_tilde, x ≠ η_tilde → IsClosed ({x} : Set ↥X_tilde) := by
    intro x hx_ne
    obtain ⟨V, hV, hxV, _, hDimB, hEv, _, _⟩ := hLoc x
    letI : Nonempty V := ⟨⟨x, hxV⟩⟩
    let B := ↑(X_tilde.presheaf.obj (Opposite.op V))
    have : Ring.DimensionLEOne B := hDimB
    obtain ⟨p_x_raw, hp_x_map⟩ : x ∈ Set.range hV.fromSpec.base := by
      rwa [AlgebraicGeometry.IsAffineOpen.range_fromSpec]
    let p_x : PrimeSpectrum B := p_x_raw
    have hηV : η_tilde ∈ V :=
      ((genericPoint_spec ↥X_tilde).mem_open_set_iff V.isOpen).mpr ⟨x, Set.mem_univ x, hxV⟩
    obtain ⟨p_η_raw, hp_η_map⟩ : η_tilde ∈ Set.range hV.fromSpec.base := by
      rwa [AlgebraicGeometry.IsAffineOpen.range_fromSpec]
    let p_η : PrimeSpectrum B := p_η_raw
    have hpx_ne_bot : p_x.asIdeal ≠ ⊥ := by
      intro hbot
      have hle : p_x ≤ p_η := by
        change p_x.asIdeal ≤ p_η.asIdeal
        rw [hbot]; exact bot_le
      have hspec_p : p_x ⤳ p_η := (PrimeSpectrum.le_iff_specializes p_x p_η).mp hle
      have hspec_x : x ⤳ η_tilde := by
        rw [← hp_x_map, ← hp_η_map]
        exact hspec_p.map hV.fromSpec.continuous
      have hspec_η : η_tilde ⤳ x := by
        rw [specializes_iff_mem_closure, (genericPoint_spec ↥X_tilde).def]
        exact Set.mem_univ x
      exact hx_ne (hspec_x.antisymm hspec_η).eq
    have hpx_max : p_x.asIdeal.IsMaximal := Ideal.IsPrime.isMaximal p_x.isPrime hpx_ne_bot
    obtain ⟨ev, hev_id, hev_ker⟩ := @hEv p_x.asIdeal hpx_max
    obtain ⟨hSec_x, hPt_x⟩ := hBuildSec V hV ev hev_id
    let σ_x : S₀ ⟶ X_tilde := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev) ≫ hV.fromSpec
    have hProp_comp : AlgebraicGeometry.IsProper (σ_x ≫ p_tilde) := by
      rw [hSec_x]; infer_instance
    have hProp_σx : AlgebraicGeometry.IsProper σ_x :=
      AlgebraicGeometry.IsProper.of_comp σ_x p_tilde
    have hσ_bot : σ_x.base (⊥ : PrimeSpectrum k₀) = x :=
      (hPt_x p_x hev_ker).trans hp_x_map
    have hRange_eq : Set.range σ_x.base = {x} := by
      ext z
      simp only [Set.mem_range, Set.mem_singleton_iff]
      refine ⟨?_, fun hz => ⟨(⊥ : PrimeSpectrum k₀), by rw [hz, hσ_bot]⟩⟩
      rintro ⟨q, rfl⟩
      have hq : q = (⊥ : PrimeSpectrum k₀) := Subsingleton.elim _ _
      rw [hq, hσ_bot]
    rw [← hRange_eq]
    exact (AlgebraicGeometry.Scheme.Hom.isClosedMap σ_x).isClosed_range

  refine ⟨X_tilde, ι_tilde, hInt, ?_, hFin_ι, hProp_tilde, hRange, hIsoTildePart, hExSec₀, ?_, ?_⟩
  · intro U hU hUne
    letI : Nonempty U := hUne
    let R := ↑(X_tilde.presheaf.obj (Opposite.op U))
    let F := ↑X_tilde.functionField
    have hDomR : IsDomain R := inferInstance
    have hDimR : Ring.DimensionLEOne R := by
      refine ⟨fun {𝔭} h𝔭_ne h𝔭 => ?_⟩
      let q : PrimeSpectrum R := ⟨𝔭, h𝔭⟩
      let q₀ : PrimeSpectrum R := ⊥
      let x : ↥X_tilde := hU.fromSpec.base q
      have hx_ne_η : x ≠ η_tilde := by
        intro hx_eq
        have hspec_η : x ⤳ hU.fromSpec.base q₀ := by
          rw [hx_eq, specializes_iff_mem_closure, (genericPoint_spec ↥X_tilde).def]
          exact Set.mem_univ _
        have hspec_q : q ⤳ q₀ :=
          hU.fromSpec.isOpenEmbedding.toIsInducing.specializes_iff.mp hspec_η
        have hle : 𝔭 ≤ ⊥ := (PrimeSpectrum.le_iff_specializes q q₀).mpr hspec_q
        exact h𝔭_ne (le_bot_iff.mp hle)
      have hCl_x : IsClosed ({x} : Set ↥X_tilde) := hClosedPt x hx_ne_η
      have hPre_eq : hU.fromSpec.base ⁻¹' ({x} : Set ↥X_tilde) = ({q} : Set (PrimeSpectrum R)) := by
        ext q'
        simp only [Set.mem_preimage, Set.mem_singleton_iff]
        exact ⟨fun h => hU.fromSpec.isOpenEmbedding.injective h, fun h => h ▸ rfl⟩
      have hCl_q : IsClosed ({q} : Set (PrimeSpectrum R)) := by
        rw [← hPre_eq]
        exact hCl_x.preimage hU.fromSpec.continuous
      exact (PrimeSpectrum.isClosed_singleton_iff_isMaximal q).mp hCl_q
    have hICR : IsIntegrallyClosed R := by
      have : IsFractionRing R F :=
        AlgebraicGeometry.functionField_isFractionRing_of_isAffineOpen X_tilde U hU
      rw [isIntegrallyClosed_iff F]
      intro h h_int
      have hLocalSec : ∀ i : ↥U,
          ∃ (W : X_tilde.Opens), W ≤ U ∧ i.1 ∈ W ∧
            ∃ s_W : ↑(X_tilde.presheaf.obj (Opposite.op W)),
              ∃ hW_ne : Nonempty W,
                letI : Nonempty W := hW_ne
                (X_tilde.germToFunctionField W).hom s_W = h := by
        intro i
        obtain ⟨V_i, hVi, hxi, hIC_i, _, _, _, _⟩ := hLoc i.1
        letI : Nonempty V_i := ⟨⟨i.1, hxi⟩⟩
        let B_i := ↑(X_tilde.presheaf.obj (Opposite.op V_i))
        obtain ⟨g_i, hg_le, hi_bo⟩ := hVi.exists_basicOpen_le i hxi
        let W_i : X_tilde.Opens := X_tilde.basicOpen g_i
        have hWi_aff : AlgebraicGeometry.IsAffineOpen W_i := hVi.basicOpen g_i
        have hWi_ne : Nonempty W_i := ⟨⟨i.1, hi_bo⟩⟩
        letI : Nonempty W_i := hWi_ne
        let R_i := ↑(X_tilde.presheaf.obj (Opposite.op W_i))
        have hg_ne : g_i ≠ 0 := by
          intro hg0
          rw [hg0, AlgebraicGeometry.Scheme.basicOpen_zero] at hi_bo
          exact hi_bo
        have hSub_nzd : Submonoid.powers g_i ≤ nonZeroDivisors B_i := by
          rintro _ ⟨n, rfl⟩
          exact mem_nonZeroDivisors_iff_ne_zero.mpr (pow_ne_zero n hg_ne)
        letI := hVi.isLocalization_basicOpen g_i
        have hIC_Wi : IsIntegrallyClosed R_i :=
          @isIntegrallyClosed_of_isLocalization B_i R_i _ _ _ hIC_i inferInstance
            (Submonoid.powers g_i) hSub_nzd _
        have : IsFractionRing R_i F :=
          AlgebraicGeometry.functionField_isFractionRing_of_isAffineOpen X_tilde W_i hWi_aff
        let res_UW : R →+* R_i := (X_tilde.presheaf.map (CategoryTheory.homOfLE hg_le).op).hom
        letI : Algebra R R_i := res_UW.toAlgebra
        have : IsScalarTower R R_i F := IsScalarTower.of_algebraMap_eq (fun r => by
          change (X_tilde.germToFunctionField U).hom r =
            (X_tilde.germToFunctionField W_i).hom (res_UW r)
          exact (TopCat.Presheaf.germ_res_apply X_tilde.presheaf
            (CategoryTheory.homOfLE hg_le) _ _ r).symm)
        have h_int_Wi : IsIntegral R_i h := IsIntegral.tower_top h_int
        obtain ⟨s_i, hs_i⟩ := (isIntegrallyClosed_iff F).mp hIC_Wi h_int_Wi
        exact ⟨W_i, hg_le, hi_bo, s_i, hWi_ne, hs_i⟩
      choose W_fn hW_le hi_W s_fn hW_ne hs_germ using hLocalSec
      have hSup_W : (⨆ i : ↥U, W_fn i) = U := by
        apply le_antisymm (iSup_le hW_le)
        intro z hz
        exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨z, hz⟩, hi_W ⟨z, hz⟩⟩
      have hCompat : TopCat.Presheaf.IsCompatible X_tilde.presheaf W_fn s_fn := by
        intro i j
        have hOpenCov : ∀ z : ↥(W_fn i ⊓ W_fn j),
            ∃ (O : X_tilde.Opens) (_ : AlgebraicGeometry.IsAffineOpen O),
              z.1 ∈ O ∧ O ≤ W_fn i ⊓ W_fn j := by
          intro z
          obtain ⟨O, hO_aff, hzO, hO_sub⟩ :=
            AlgebraicGeometry.exists_isAffineOpen_mem_and_subset z.2
          exact ⟨O, hO_aff, hzO, hO_sub⟩
        choose O_fn hO_aff hz_O hO_le using hOpenCov
        have hSup_O : (⨆ z : ↥(W_fn i ⊓ W_fn j), O_fn z) = W_fn i ⊓ W_fn j := by
          apply le_antisymm (iSup_le hO_le)
          intro z hz
          exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨z, hz⟩, hz_O ⟨z, hz⟩⟩
        let s₁ := (X_tilde.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W_fn i ⊓ W_fn j ≤ W_fn i)).op).hom (s_fn i)
        let s₂ := (X_tilde.presheaf.map (CategoryTheory.homOfLE (inf_le_right : W_fn i ⊓ W_fn j ≤ W_fn j)).op).hom (s_fn j)
        change s₁ = s₂
        let eqIsoO := X_tilde.presheaf.mapIso (CategoryTheory.eqToIso hSup_O).op
        have heq_sup : eqIsoO.hom.hom s₁ = eqIsoO.hom.hom s₂ := by
          apply TopCat.Sheaf.eq_of_locally_eq X_tilde.sheaf O_fn
          intro z
          letI : Nonempty (O_fn z) := ⟨⟨z.1, hz_O z⟩⟩
          have : IsFractionRing ↑(X_tilde.presheaf.obj (Opposite.op (O_fn z))) F :=
            AlgebraicGeometry.functionField_isFractionRing_of_isAffineOpen X_tilde (O_fn z) (hO_aff z)
          apply IsFractionRing.injective ↑(X_tilde.presheaf.obj (Opposite.op (O_fn z))) F
          change algebraMap ↑(X_tilde.presheaf.obj (Opposite.op (O_fn z))) F
              ((X_tilde.presheaf.map (TopologicalSpace.Opens.leSupr O_fn z).op).hom
                (eqIsoO.hom.hom s₁)) =
            algebraMap ↑(X_tilde.presheaf.obj (Opposite.op (O_fn z))) F
              ((X_tilde.presheaf.map (TopologicalSpace.Opens.leSupr O_fn z).op).hom
                (eqIsoO.hom.hom s₂))
          have hResEq : ∀ (t : ↑(X_tilde.presheaf.obj (Opposite.op (W_fn i ⊓ W_fn j)))),
              (X_tilde.presheaf.map (TopologicalSpace.Opens.leSupr O_fn z).op).hom
                (eqIsoO.hom.hom t) =
              (X_tilde.presheaf.map (CategoryTheory.homOfLE (hO_le z)).op).hom t := by
            intro t
            change ((eqIsoO.hom ≫ X_tilde.presheaf.map (TopologicalSpace.Opens.leSupr O_fn z).op).hom) t = _
            have hMor : eqIsoO.hom ≫ X_tilde.presheaf.map (TopologicalSpace.Opens.leSupr O_fn z).op =
                X_tilde.presheaf.map (CategoryTheory.homOfLE (hO_le z)).op := by
              dsimp [eqIsoO]
              rw [← CategoryTheory.Functor.map_comp]
              congr 1
            rw [hMor]
          rw [hResEq s₁, hResEq s₂]
          have h1 : (X_tilde.presheaf.map (CategoryTheory.homOfLE (hO_le z)).op).hom s₁ =
              (X_tilde.presheaf.map (CategoryTheory.homOfLE ((hO_le z).trans inf_le_left)).op).hom (s_fn i) := by
            change ((X_tilde.presheaf.map (CategoryTheory.homOfLE inf_le_left).op ≫
              X_tilde.presheaf.map (CategoryTheory.homOfLE (hO_le z)).op).hom) (s_fn i) = _
            rw [← CategoryTheory.Functor.map_comp]
            rfl
          have h2 : (X_tilde.presheaf.map (CategoryTheory.homOfLE (hO_le z)).op).hom s₂ =
              (X_tilde.presheaf.map (CategoryTheory.homOfLE ((hO_le z).trans inf_le_right)).op).hom (s_fn j) := by
            change ((X_tilde.presheaf.map (CategoryTheory.homOfLE inf_le_right).op ≫
              X_tilde.presheaf.map (CategoryTheory.homOfLE (hO_le z)).op).hom) (s_fn j) = _
            rw [← CategoryTheory.Functor.map_comp]
            rfl
          rw [h1, h2]
          letI : Nonempty (W_fn i) := hW_ne i
          have hg1 : algebraMap ↑(X_tilde.presheaf.obj (Opposite.op (O_fn z))) F
              ((X_tilde.presheaf.map (CategoryTheory.homOfLE ((hO_le z).trans inf_le_left)).op).hom (s_fn i)) = h := by
            change (X_tilde.germToFunctionField (O_fn z)).hom _ = h
            rw [TopCat.Presheaf.germ_res_apply X_tilde.presheaf
              (CategoryTheory.homOfLE ((hO_le z).trans inf_le_left)) _ _ (s_fn i)]
            exact hs_germ i
          letI : Nonempty (W_fn j) := hW_ne j
          have hg2 : algebraMap ↑(X_tilde.presheaf.obj (Opposite.op (O_fn z))) F
              ((X_tilde.presheaf.map (CategoryTheory.homOfLE ((hO_le z).trans inf_le_right)).op).hom (s_fn j)) = h := by
            change (X_tilde.germToFunctionField (O_fn z)).hom _ = h
            rw [TopCat.Presheaf.germ_res_apply X_tilde.presheaf
              (CategoryTheory.homOfLE ((hO_le z).trans inf_le_right)) _ _ (s_fn j)]
            exact hs_germ j
          rw [hg1, hg2]
        have hHomInv : ∀ t, eqIsoO.inv.hom (eqIsoO.hom.hom t) = t := fun t => by
          change ((eqIsoO.hom ≫ eqIsoO.inv).hom) t = t
          rw [eqIsoO.hom_inv_id]; rfl
        rw [← hHomInv s₁, ← hHomInv s₂, heq_sup]
      obtain ⟨s_sup, hs_gluing, _⟩ := X_tilde.sheaf.existsUnique_gluing W_fn s_fn hCompat
      let s_U : R := (X_tilde.presheaf.map (CategoryTheory.eqToHom hSup_W.symm).op).hom s_sup
      let i₀ : ↥U := ⟨hUne.some.1, hUne.some.2⟩
      refine ⟨s_U, ?_⟩
      have hs_res : (X_tilde.presheaf.map (CategoryTheory.homOfLE (hW_le i₀)).op).hom s_U = s_fn i₀ := by
        change ((X_tilde.presheaf.map (CategoryTheory.eqToHom hSup_W.symm).op ≫
          X_tilde.presheaf.map (CategoryTheory.homOfLE (hW_le i₀)).op).hom) s_sup = s_fn i₀
        rw [← CategoryTheory.Functor.map_comp]
        have hHomEq : (CategoryTheory.eqToHom hSup_W.symm).op ≫
            (CategoryTheory.homOfLE (hW_le i₀)).op =
            (TopologicalSpace.Opens.leSupr W_fn i₀).op := Subsingleton.elim _ _
        rw [hHomEq]
        exact hs_gluing i₀
      letI : Nonempty (W_fn i₀) := hW_ne i₀
      change (X_tilde.germToFunctionField U).hom s_U = h
      rw [← TopCat.Presheaf.germ_res_apply X_tilde.presheaf
        (CategoryTheory.homOfLE (hW_le i₀)) _ _ s_U, hs_res]
      exact hs_germ i₀
    exact ⟨hDomR, hICR, hDimR⟩
  · intro Z hClZ hNeUniv
    have hη_not_Z : η_tilde ∉ Z := by
      intro hηZ
      apply hNeUniv
      rw [← Set.univ_subset_iff, ← (genericPoint_spec ↥X_tilde).def]
      exact hClZ.closure_subset_iff.mpr (Set.singleton_subset_iff.mpr hηZ)
    have : CompactSpace ↥X_tilde :=
      AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace p_tilde
    choose V_fn hV_aff hx_V hLoc_props using hLoc
    obtain ⟨t, ht_cov⟩ := isCompact_univ.elim_finite_subcover (fun x => (V_fn x : Set ↥X_tilde))
      (fun x => (V_fn x).isOpen) (fun x _ => Set.mem_iUnion.mpr ⟨x, hx_V x⟩)
    have hFinPiece : ∀ x ∈ t, (Z ∩ (V_fn x : Set ↥X_tilde)).Finite := by
      intro x _
      letI : Nonempty (V_fn x) := ⟨⟨x, hx_V x⟩⟩
      let B_x := ↑(X_tilde.presheaf.obj (Opposite.op (V_fn x)))
      have hFinZero := (hLoc_props x).2.2.2.1
      let Z_x : Set (PrimeSpectrum B_x) := (hV_aff x).fromSpec.base ⁻¹' Z
      have hCl_Zx : IsClosed Z_x := hClZ.preimage (hV_aff x).fromSpec.continuous
      obtain ⟨I_x, hZx_eq⟩ := (PrimeSpectrum.isClosed_iff_zeroLocus_ideal Z_x).mp hCl_Zx
      have hIx_ne : I_x ≠ ⊥ := by
        intro hbot
        have hbot_in : (⊥ : PrimeSpectrum B_x) ∈ Z_x := by
          rw [hZx_eq]
          change I_x ≤ (⊥ : Ideal B_x)
          rw [hbot]
        have hz0_in : (hV_aff x).fromSpec.base (⊥ : PrimeSpectrum B_x) ∈ Z := hbot_in
        have hηV : η_tilde ∈ V_fn x :=
          ((genericPoint_spec ↥X_tilde).mem_open_set_iff (V_fn x).isOpen).mpr
            ⟨x, Set.mem_univ x, hx_V x⟩
        obtain ⟨p_η, hp_η_map⟩ : η_tilde ∈ Set.range (hV_aff x).fromSpec.base := by
          rwa [AlgebraicGeometry.IsAffineOpen.range_fromSpec]
        have hspec_bot : (⊥ : PrimeSpectrum B_x) ⤳ p_η :=
          (PrimeSpectrum.le_iff_specializes (⊥ : PrimeSpectrum B_x) p_η).mp bot_le
        have hspec_z0 : (hV_aff x).fromSpec.base (⊥ : PrimeSpectrum B_x) ⤳ η_tilde := by
          rw [← hp_η_map]
          exact hspec_bot.map (hV_aff x).fromSpec.continuous
        have hη_cl : η_tilde ∈ closure {(hV_aff x).fromSpec.base (⊥ : PrimeSpectrum B_x)} :=
          specializes_iff_mem_closure.mp hspec_z0
        exact hη_not_Z (hClZ.closure_subset_iff.mpr (Set.singleton_subset_iff.mpr hz0_in) hη_cl)
      have hZx_set : Z_x = {p : PrimeSpectrum B_x | I_x ≤ p.asIdeal} := hZx_eq
      have hZx_fin : Z_x.Finite := by
        rw [hZx_set]
        exact hFinZero I_x hIx_ne
      have hImg_eq : Z ∩ (V_fn x : Set ↥X_tilde) = (hV_aff x).fromSpec.base '' Z_x := by
        ext y
        simp only [Set.mem_inter_iff, Z_x]
        refine ⟨fun ⟨hyZ, hyV⟩ => ?_, ?_⟩
        · have hy_range : y ∈ Set.range (hV_aff x).fromSpec.base := by
            rw [AlgebraicGeometry.IsAffineOpen.range_fromSpec]
            exact hyV
          obtain ⟨q, rfl⟩ := hy_range
          exact ⟨q, hyZ, rfl⟩
        · rintro ⟨q, hqZ, rfl⟩
          refine ⟨hqZ, ?_⟩
          have hq_range : (hV_aff x).fromSpec.base q ∈ Set.range (hV_aff x).fromSpec.base := ⟨q, rfl⟩
          rwa [AlgebraicGeometry.IsAffineOpen.range_fromSpec] at hq_range
      rw [hImg_eq]
      exact hZx_fin.image _
    have hZ_union : Z = ⋃ x ∈ t, (Z ∩ (V_fn x : Set ↥X_tilde)) := by
      ext y
      simp only [Set.mem_iUnion, Set.mem_inter_iff]
      refine ⟨fun hyZ => ?_, fun ⟨x, _, hyZ, _⟩ => hyZ⟩
      have hy_cov : y ∈ ⋃ x ∈ t, (V_fn x : Set ↥X_tilde) := ht_cov (Set.mem_univ y)
      rw [Set.mem_iUnion₂] at hy_cov
      obtain ⟨x, hxt, hyV⟩ := hy_cov
      exact ⟨x, hxt, hyZ, hyV⟩
    rw [hZ_union]
    exact t.finite_toSet.biUnion hFinPiece
  · intro h hh x
    obtain ⟨V, hV, hxV, _, _, _, _, hDVR⟩ := hLoc x
    letI : Nonempty V := ⟨⟨x, hxV⟩⟩
    let B := ↑(X_tilde.presheaf.obj (Opposite.op V))
    let F := ↑X_tilde.functionField
    have : IsFractionRing B F :=
      AlgebraicGeometry.functionField_isFractionRing_of_isAffineOpen X_tilde V hV
    obtain ⟨p_x, hp_x_map⟩ : x ∈ Set.range hV.fromSpec.base := by
      rwa [AlgebraicGeometry.IsAffineOpen.range_fromSpec]
    obtain ⟨a, d, hd_not, hEq⟩ := @hDVR h hh p_x.asIdeal p_x.isPrime
    let W : X_tilde.Opens := X_tilde.basicOpen d
    have hW_aff : AlgebraicGeometry.IsAffineOpen W := hV.basicOpen d
    have hxW : x ∈ W := by
      rw [← hp_x_map]
      change p_x ∈ hV.fromSpec ⁻¹ᵁ X_tilde.basicOpen d
      rw [hV.fromSpec_preimage_basicOpen]
      exact hd_not
    have hW_ne : Nonempty W := ⟨⟨x, hxW⟩⟩
    letI : Nonempty W := hW_ne
    letI := hV.isLocalization_basicOpen d
    obtain ⟨u_d, hu_d⟩ :=
      IsLocalization.Away.algebraMap_isUnit (S := ↑(X_tilde.presheaf.obj (Opposite.op W))) d
    let res_VW := (X_tilde.presheaf.map (CategoryTheory.homOfLE (X_tilde.basicOpen_le d)).op).hom
    change ↑u_d = res_VW d at hu_d
    let s : ↑(X_tilde.presheaf.obj (Opposite.op W)) := res_VW a * ↑u_d⁻¹
    have hs_mul : s * res_VW d = res_VW a := by
      dsimp [s]
      rw [← hu_d, mul_assoc, Units.inv_mul, mul_one]
    have hg_mul : (X_tilde.germToFunctionField W).hom s *
        (X_tilde.germToFunctionField V).hom d =
        (X_tilde.germToFunctionField V).hom a := by
      have h1 := congrArg (X_tilde.germToFunctionField W).hom hs_mul
      rw [map_mul,
        TopCat.Presheaf.germ_res_apply X_tilde.presheaf
          (CategoryTheory.homOfLE (X_tilde.basicOpen_le d)) _ _ d,
        TopCat.Presheaf.germ_res_apply X_tilde.presheaf
          (CategoryTheory.homOfLE (X_tilde.basicOpen_le d)) _ _ a] at h1
      exact h1
    have hd_ne : d ≠ 0 := fun hd0 => hd_not (hd0 ▸ p_x.asIdeal.zero_mem)
    have hgd_ne : (X_tilde.germToFunctionField V).hom d ≠ 0 :=
      fun h0 => hd_ne (IsFractionRing.injective B F (h0.trans (map_zero _).symm))
    refine ⟨W, hW_aff, hW_ne, s, hxW, ?_⟩
    rcases hEq with h1 | h2
    · exact Or.inl (mul_right_cancel₀ hgd_ne (hg_mul.trans h1.symm))
    · exact Or.inr (mul_right_cancel₀ hgd_ne (hg_mul.trans h2.symm))

theorem weil_twoChart_reciprocal_polyChart_proper_and_surjective (k₀ : Type u) [Field k₀]
    (hAffProj : ∀ a : Fin (1 + 1), AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen k₀ 1 a))
    (c_proj : ∀ a : Fin (1 + 1),
      k₀ →+* ↑((weilProjectiveSpaceOver k₀ 1).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen k₀ 1 a))))
    (t_proj : ∀ a : Fin (1 + 1), Fin (1 + 1) →
      ↑((weilProjectiveSpaceOver k₀ 1).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen k₀ 1 a))))
    (hCoord : IsCommRingProjCoordSystem k₀ 1 hAffProj c_proj t_proj)
    (X_tilde : AlgebraicGeometry.Scheme.{u})
    [AlgebraicGeometry.IsIntegral X_tilde]
    (p_tilde : X_tilde ⟶ AlgebraicGeometry.Spec (CommRingCat.of k₀))
    (hProp : AlgebraicGeometry.IsProper p_tilde)
    (Ω_0 Ω_1 : X_tilde.Opens)
    [Nonempty Ω_0] [Nonempty Ω_1]
    (f_0 : ↑(X_tilde.presheaf.obj (Opposite.op Ω_0)))
    (s_1 : ↑(X_tilde.presheaf.obj (Opposite.op Ω_1)))
    (hCov : Ω_0 ⊔ Ω_1 = ⊤)
    (hInter0 : Ω_0 ⊓ Ω_1 = X_tilde.basicOpen f_0)
    (hInter1 : Ω_0 ⊓ Ω_1 = X_tilde.basicOpen s_1)
    (hRecip : (X_tilde.presheaf.map (CategoryTheory.homOfLE (inf_le_left : Ω_0 ⊓ Ω_1 ≤ Ω_0)).op).hom f_0 *
      (X_tilde.presheaf.map (CategoryTheory.homOfLE (inf_le_right : Ω_0 ⊓ Ω_1 ≤ Ω_1)).op).hom s_1 = 1) :
    let Φ_0 : Polynomial k₀ →+* ↑(X_tilde.presheaf.obj (Opposite.op Ω_0)) :=
      Polynomial.eval₂RingHom
        (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
          p_tilde.appLE ⊤ Ω_0 le_top).hom) f_0
    let q_0 : Ω_0.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k₀)) :=
      Ω_0.toScheme.toSpecΓ ≫
        AlgebraicGeometry.Spec.map Ω_0.topIso.inv ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom Φ_0)
    AlgebraicGeometry.IsProper q_0 ∧
      ((∃ x_pole : ↥X_tilde, x_pole ∉ Ω_0) →
       (∃ x_zero : ↥X_tilde, x_zero ∉ Ω_1) →
       Function.Surjective q_0.base) :=
by
  intro Φ_0 q_0
  suffices hGen : ∀ (P : AlgebraicGeometry.Scheme.{u})
      (p_P : P ⟶ AlgebraicGeometry.Spec (CommRingCat.of k₀))
      (D : Fin (1 + 1) → P.Opens)
      (hAff : ∀ a : Fin (1 + 1), AlgebraicGeometry.IsAffineOpen (D a))
      (c_P : ∀ a : Fin (1 + 1), k₀ →+* ↑(P.presheaf.obj (Opposite.op (D a))))
      (t_P : ∀ a : Fin (1 + 1), Fin (1 + 1) → ↑(P.presheaf.obj (Opposite.op (D a)))),
      AlgebraicGeometry.IsProper p_P →
      (∀ a : Fin (1 + 1),
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (c_P a)) = (hAff a).fromSpec ≫ p_P) →
      (∀ a : Fin (1 + 1), t_P a a = 1) →
      (∀ a : Fin (1 + 1), Subring.closure (Set.range (c_P a) ∪ Set.range (t_P a)) = ⊤) →
      (∀ (a : Fin (1 + 1)) (A : Type u) [CommRing A] (ρ : k₀ →+* A) (v : Fin (1 + 1) → A),
        v a = 1 → ∃ ψ : ↑(P.presheaf.obj (Opposite.op (D a))) →+* A,
          ψ.comp (c_P a) = ρ ∧ ∀ b : Fin (1 + 1), ψ (t_P a b) = v b) →
      (∀ a a' : Fin (1 + 1), P.basicOpen (t_P a a') = D a ⊓ D a') →
      (∀ (a a' : Fin (1 + 1)) (r : k₀),
        (P.presheaf.map (CategoryTheory.homOfLE (inf_le_right : D a ⊓ D a' ≤ D a')).op).hom (c_P a' r) =
        (P.presheaf.map (CategoryTheory.homOfLE (inf_le_left : D a ⊓ D a' ≤ D a)).op).hom (c_P a r)) →
      (∀ (a a' b : Fin (1 + 1)),
        (P.presheaf.map (CategoryTheory.homOfLE (inf_le_right : D a ⊓ D a' ≤ D a')).op).hom (t_P a' b) *
        (P.presheaf.map (CategoryTheory.homOfLE (inf_le_left : D a ⊓ D a' ≤ D a)).op).hom (t_P a a') =
        (P.presheaf.map (CategoryTheory.homOfLE (inf_le_left : D a ⊓ D a' ≤ D a)).op).hom (t_P a b)) →
      AlgebraicGeometry.IsProper q_0 ∧
        ((∃ x_pole : ↥X_tilde, x_pole ∉ Ω_0) →
         (∃ x_zero : ↥X_tilde, x_zero ∉ Ω_1) →
         Function.Surjective q_0.base) by
    obtain ⟨hPropP, _hSupD, hFromSpecC, _hMvEquiv, hDiag, hClos, hUniv,
      hBasicInter, hCocycC, hCocycT⟩ := hCoord
    exact hGen _ _ _ hAffProj c_proj t_proj hPropP hFromSpecC hDiag hClos hUniv
      hBasicInter hCocycC hCocycT
  intro P p_P D hAff c_P t_P hPropP hFromSpecC hDiag hClos hUniv hBasicInter hCocycC hCocycT
  have hRes : ∀ (S : AlgebraicGeometry.Scheme.{u}) {U₁ U₂ U₃ : S.Opens}
      (h₁₂ : U₁ ≤ U₂) (h₂₃ : U₂ ≤ U₃) (x : ↑(S.presheaf.obj (Opposite.op U₃))),
      (S.presheaf.map (CategoryTheory.homOfLE h₁₂).op).hom
        ((S.presheaf.map (CategoryTheory.homOfLE h₂₃).op).hom x) =
      (S.presheaf.map (CategoryTheory.homOfLE (h₁₂.trans h₂₃)).op).hom x := by
    intro S U₁ U₂ U₃ h₁₂ h₂₃ x
    have hOp : (CategoryTheory.homOfLE (h₁₂.trans h₂₃)).op =
        (CategoryTheory.homOfLE h₂₃).op ≫ (CategoryTheory.homOfLE h₁₂).op := by
      rw [← CategoryTheory.homOfLE_comp]; rfl
    rw [hOp, S.presheaf.map_comp]
    rfl
  have hBuildEquiv : ∀ (a a' : Fin (1 + 1)), a ≠ a' →
      ∃ e : Polynomial k₀ ≃+* ↑(P.presheaf.obj (Opposite.op (D a))),
        e.toRingHom.comp Polynomial.C = c_P a ∧ e Polynomial.X = t_P a a' := by
    intro a a' hne
    let α : Polynomial k₀ →+* ↑(P.presheaf.obj (Opposite.op (D a))) :=
      Polynomial.eval₂RingHom (c_P a) (t_P a a')
    let v : Fin (1 + 1) → Polynomial k₀ := fun b => if b = a then 1 else Polynomial.X
    obtain ⟨β, hβ_C, hβ_t⟩ := hUniv a (Polynomial k₀) Polynomial.C v (by simp [v])
    have hβ_a' : β (t_P a a') = Polynomial.X := by
      rw [hβ_t a']
      simp [v, hne.symm]
    have h_ba : β.comp α = RingHom.id (Polynomial k₀) := by
      apply Polynomial.ringHom_ext
      · intro r
        change β (Polynomial.eval₂ (c_P a) (t_P a a') (Polynomial.C r)) = Polynomial.C r
        rw [Polynomial.eval₂_C]
        exact RingHom.congr_fun hβ_C r
      · change β (Polynomial.eval₂ (c_P a) (t_P a a') Polynomial.X) = Polynomial.X
        rw [Polynomial.eval₂_X, hβ_a']
    have h_ab : α.comp β = RingHom.id ↑(P.presheaf.obj (Opposite.op (D a))) := by
      ext z
      have hz_top : z ∈ (⊤ : Subring ↑(P.presheaf.obj (Opposite.op (D a)))) := trivial
      rw [← hClos a] at hz_top
      have hle : Subring.closure (Set.range (c_P a) ∪ Set.range (t_P a)) ≤
          (α.comp β).eqLocus (RingHom.id _) := by
        rw [Subring.closure_le]
        rintro x (⟨r, rfl⟩ | ⟨b, rfl⟩)
        · change Polynomial.eval₂ (c_P a) (t_P a a') (β (c_P a r)) = c_P a r
          have h1 : β (c_P a r) = Polynomial.C r := RingHom.congr_fun hβ_C r
          rw [h1, Polynomial.eval₂_C]
        · have hb : b = a ∨ b = a' := by
            fin_cases a <;> fin_cases a' <;> fin_cases b <;> simp_all
          rcases hb with rfl | rfl
          · change α (β (t_P b b)) = t_P b b
            rw [hDiag b, map_one, map_one]
          · change Polynomial.eval₂ (c_P a) (t_P a b) (β (t_P a b)) = t_P a b
            rw [hβ_a', Polynomial.eval₂_X]
      exact hle hz_top
    refine ⟨RingEquiv.ofRingHom α β h_ab h_ba, ?_, ?_⟩
    · ext r
      exact Polynomial.eval₂_C (c_P a) (t_P a a')
    · exact Polynomial.eval₂_X (c_P a) (t_P a a')
  obtain ⟨e_0, he0_C, he0_X⟩ := hBuildEquiv 0 1 (by decide)
  obtain ⟨e_1, he1_C, he1_X⟩ := hBuildEquiv 1 0 (by decide)
  let B_0 : P.Opens := P.basicOpen (t_P 0 1)
  have hB0_inter : B_0 ≤ D 0 ⊓ D 1 := le_of_eq (hBasicInter 0 1)
  have hB0_0 : B_0 ≤ D 0 := P.basicOpen_le (t_P 0 1)
  have hB0_1 : B_0 ≤ D 1 := hB0_inter.trans inf_le_right
  let c_Ω0 : k₀ →+* ↑(X_tilde.presheaf.obj (Opposite.op Ω_0)) :=
    (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫ p_tilde.appLE ⊤ Ω_0 le_top).hom)
  let c_Ω1 : k₀ →+* ↑(X_tilde.presheaf.obj (Opposite.op Ω_1)) :=
    (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫ p_tilde.appLE ⊤ Ω_1 le_top).hom)
  let c_Ω01 : k₀ →+* ↑(X_tilde.presheaf.obj (Opposite.op (Ω_0 ⊓ Ω_1))) :=
    (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
      p_tilde.appLE ⊤ (Ω_0 ⊓ Ω_1) le_top).hom)
  let Φ_1 : Polynomial k₀ →+* ↑(X_tilde.presheaf.obj (Opposite.op Ω_1)) :=
    Polynomial.eval₂RingHom c_Ω1 s_1
  let resX_0 := (X_tilde.presheaf.map (CategoryTheory.homOfLE (inf_le_left : Ω_0 ⊓ Ω_1 ≤ Ω_0)).op).hom
  let resX_1 := (X_tilde.presheaf.map (CategoryTheory.homOfLE (inf_le_right : Ω_0 ⊓ Ω_1 ≤ Ω_1)).op).hom
  let resP_0 := (P.presheaf.map (CategoryTheory.homOfLE hB0_0).op).hom
  let resP_1 := (P.presheaf.map (CategoryTheory.homOfLE hB0_1).op).hom
  have hc_res : ∀ {U V : X_tilde.Opens} (h : U ≤ V),
      ((X_tilde.presheaf.map (CategoryTheory.homOfLE h).op).hom).comp
        (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
          p_tilde.appLE ⊤ V le_top).hom) =
      (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
        p_tilde.appLE ⊤ U le_top).hom) := by
    intro U V h
    have hmap : p_tilde.appLE ⊤ V le_top ≫ X_tilde.presheaf.map (CategoryTheory.homOfLE h).op =
        p_tilde.appLE ⊤ U le_top :=
      AlgebraicGeometry.Scheme.Hom.appLE_map p_tilde le_top (CategoryTheory.homOfLE h).op
    ext r
    exact congrArg
      (fun g => ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫ g).hom r) hmap
  let g0_ring : ↑(P.presheaf.obj (Opposite.op (D 0))) →+*
      ↑(X_tilde.presheaf.obj (Opposite.op (Ω_0 ⊓ Ω_1))) :=
    (Polynomial.eval₂RingHom c_Ω01 (resX_0 f_0)).comp e_0.symm.toRingHom
  have hg0_t01 : g0_ring (t_P 0 1) = resX_0 f_0 := by
    change Polynomial.eval₂ c_Ω01 (resX_0 f_0) (e_0.symm (t_P 0 1)) = resX_0 f_0
    rw [← he0_X, e_0.symm_apply_apply, Polynomial.eval₂_X]
  have hg0_unit : IsUnit (g0_ring (t_P 0 1)) := by
    rw [hg0_t01]
    exact ⟨⟨resX_0 f_0, resX_1 s_1, hRecip, (mul_comm _ _).trans hRecip⟩, rfl⟩
  let _ : IsLocalization.Away (t_P 0 1) ↑(P.presheaf.obj (Opposite.op B_0)) :=
    (hAff 0).isLocalization_basicOpen (t_P 0 1)
  let ψ_ov : ↑(P.presheaf.obj (Opposite.op B_0)) →+*
      ↑(X_tilde.presheaf.obj (Opposite.op (Ω_0 ⊓ Ω_1))) :=
    IsLocalization.Away.lift (t_P 0 1) hg0_unit
  have hψ_ov_res0 : ψ_ov.comp resP_0 = g0_ring := by
    ext z
    exact IsLocalization.Away.lift_eq (t_P 0 1) hg0_unit z
  have hEval0 : Polynomial.eval₂RingHom c_Ω01 (resX_0 f_0) = resX_0.comp Φ_0 := by
    apply Polynomial.ringHom_ext
    · intro r
      change Polynomial.eval₂ c_Ω01 (resX_0 f_0) (Polynomial.C r) =
        resX_0 (Polynomial.eval₂ c_Ω0 f_0 (Polynomial.C r))
      rw [Polynomial.eval₂_C, Polynomial.eval₂_C]
      exact (RingHom.congr_fun (hc_res inf_le_left) r).symm
    · change Polynomial.eval₂ c_Ω01 (resX_0 f_0) Polynomial.X =
        resX_0 (Polynomial.eval₂ c_Ω0 f_0 Polynomial.X)
      rw [Polynomial.eval₂_X, Polynomial.eval₂_X]
  have hEval1 : Polynomial.eval₂RingHom c_Ω01 (resX_1 s_1) = resX_1.comp Φ_1 := by
    apply Polynomial.ringHom_ext
    · intro r
      change Polynomial.eval₂ c_Ω01 (resX_1 s_1) (Polynomial.C r) =
        resX_1 (Polynomial.eval₂ c_Ω1 s_1 (Polynomial.C r))
