    have : Module.IsTorsionFree (Polynomial κ) D := Module.Flat.isTorsionFree
    have hInj_φD : Function.Injective φ_D := by
      rw [RingHom.injective_iff_ker_eq_bot, eq_bot_iff]
      intro P hP
      have hsmul : P • (1 : D) = 0 := by
