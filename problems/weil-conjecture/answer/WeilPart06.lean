    have ⟨f, hfI, hf_ne⟩ : ∃ f ∈ I, f ≠ 0 := by
      by_contra! h
      exact hI_ne (eq_bot_iff.mpr fun x hx => (Submodule.mem_bot D).mpr (h x hx))
    have hev : ∀ p ∈ PrimeSpectrum.zeroLocus (I : Set D),
        ∃ ev : D →+* κ,
