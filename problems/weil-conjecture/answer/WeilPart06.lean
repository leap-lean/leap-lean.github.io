    · apply RingHom.ext
      intro c
      change f_e₀ (g_e₀ (Polynomial.C c)) = Polynomial.C c
      have h1 : g_e₀ (Polynomial.C c) = Ideal.Quotient.mk (Ideal.span {Xbar₁}) (c_R₀ c) :=
