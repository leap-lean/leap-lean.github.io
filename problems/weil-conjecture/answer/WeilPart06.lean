      apply X_tilde.germToFunctionField_injective (V_cov z₁ ⊓ V_cov z₂)
      change (X_tilde.germToFunctionField (V_cov z₁ ⊓ V_cov z₂)).hom
          ((X_tilde.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (s_loc b z₁)) =
        (X_tilde.germToFunctionField (V_cov z₁ ⊓ V_cov z₂)).hom
          ((X_tilde.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom (s_loc b z₂))
      rw [TopCat.Presheaf.germ_res_apply X_tilde.presheaf
          (CategoryTheory.homOfLE inf_le_left) _ _ (s_loc b z₁),
        TopCat.Presheaf.germ_res_apply X_tilde.presheaf
          (CategoryTheory.homOfLE inf_le_right) _ _ (s_loc b z₂),
        hs_loc b z₁, hs_loc b z₂]
    obtain ⟨s, hs_res, _⟩ := X_tilde.sheaf.existsUnique_gluing' V_cov Ω
      (fun z => CategoryTheory.homOfLE (hVcov_le z)) (le_of_eq hSupV.symm) (s_loc b) hCompat
    let s_Ω : ↑(X_tilde.presheaf.obj (Opposite.op Ω)) := s
    let z₀ : Ω := ⟨x_0, hx_0⟩
    have : Nonempty (V_cov z₀) := hVcov_ne z₀
    have h1 : (X_tilde.germToFunctionField Ω).hom s_Ω =
        (X_tilde.germToFunctionField (V_cov z₀)).hom
          ((X_tilde.presheaf.map (CategoryTheory.homOfLE (hVcov_le z₀)).op).hom s_Ω) :=
      (TopCat.Presheaf.germ_res_apply X_tilde.presheaf
        (CategoryTheory.homOfLE (hVcov_le z₀)) _ _ s_Ω).symm
    exact ⟨s_Ω, h1.trans
      ((congrArg (X_tilde.germToFunctionField (V_cov z₀)).hom (hs_res z₀)).trans (hs_loc b z₀))⟩
  choose β_fn hβ_fn using hGlue_ex

  let β_0 : B →+* ↑(X_tilde.presheaf.obj (Opposite.op Ω)) :=
    { toFun := β_fn
      map_one' := X_tilde.germToFunctionField_injective Ω
        (by rw [hβ_fn 1, map_one, map_one])
      map_mul' := fun x y => X_tilde.germToFunctionField_injective Ω
        (by rw [hβ_fn (x * y), map_mul, map_mul, hβ_fn x, hβ_fn y])
      map_zero' := X_tilde.germToFunctionField_injective Ω
        (by rw [hβ_fn 0, map_zero, map_zero])
      map_add' := fun x y => X_tilde.germToFunctionField_injective Ω
        (by rw [hβ_fn (x + y), map_add, map_add, hβ_fn x, hβ_fn y]) }
  have hGermβ : ∀ b : B, (X_tilde.germToFunctionField Ω).hom (β_0 b) = ι_B b := hβ_fn
  have hβ_comp : β_0.comp φ_AB = Φ := by
    apply RingHom.ext
    intro p
    apply X_tilde.germToFunctionField_injective Ω
    change (X_tilde.germToFunctionField Ω).hom (β_0 (φ_AB p)) =
      (X_tilde.germToFunctionField Ω).hom (Φ p)
    rw [hGermβ (φ_AB p)]
    exact congrArg (fun g : Polynomial k₀ →+* F_ss => g p) hCompatB

  have hLocQF : ∀ (V : X_tilde.Opens), AlgebraicGeometry.IsAffineOpen V → Nonempty V →
      ∀ (hV_Ω : V ≤ Ω),
        let ι_V := (X_tilde.presheaf.map (CategoryTheory.homOfLE hV_Ω).op).hom.comp β_0
        ι_V.FiniteType ∧ ι_V.QuasiFinite := by
    intro V hV hV_ne hV_Ω
    have : Nonempty V := hV_ne
    let A_V := ↑(X_tilde.presheaf.obj (Opposite.op V))
    let res_V := (X_tilde.presheaf.map (CategoryTheory.homOfLE hV_Ω).op).hom
    let ι_V : B →+* A_V := res_V.comp β_0
    let c_V : k₀ →+* A_V :=
      (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
        p_tilde.appLE ⊤ V le_top).hom)
    obtain ⟨hDom_V, _, hDim_V⟩ := hNorm V hV hV_ne
    have : IsDomain A_V := hDom_V
    have : Ring.DimensionLEOne A_V := hDim_V
    have hc_V_ft : c_V.FiniteType := h_cV_ft V hV
    have hComp_k0 : ι_V.comp (φ_AB.comp Polynomial.C) = c_V := by
      ext c
      change res_V (β_0 (φ_AB (Polynomial.C c))) = c_V c
      have h1 : β_0 (φ_AB (Polynomial.C c)) = Φ (Polynomial.C c) :=
        congrArg (fun g : Polynomial k₀ →+* _ => g (Polynomial.C c)) hβ_comp
      rw [h1]
      change res_V (Polynomial.eval₂ c_Ω f (Polynomial.C c)) = c_V c
      rw [Polynomial.eval₂_C]
      exact h_cV_res V hV_Ω c
    have hFT_V : ι_V.FiniteType :=
      RingHom.FiniteType.of_comp_finiteType (hComp_k0.symm ▸ hc_V_ft)
    have hGerm_V : ∀ b : B, (X_tilde.germToFunctionField V).hom (ι_V b) = ι_B b := by
      intro b
      change (X_tilde.germToFunctionField V).hom (res_V (β_0 b)) = ι_B b
      rw [TopCat.Presheaf.germ_res_apply X_tilde.presheaf
        (CategoryTheory.homOfLE hV_Ω) _ _ (β_0 b), hGermβ b]
    have hInj_ιV : Function.Injective ι_V := fun b₁ b₂ h =>
      hInjB (by rw [← hGerm_V b₁, ← hGerm_V b₂, h])
    have hNoeth_V : IsNoetherianRing A_V := by
      let : Algebra k₀ A_V := c_V.toAlgebra
      have : Algebra.FiniteType k₀ A_V := hc_V_ft
      exact Algebra.FiniteType.isNoetherianRing k₀ A_V
    have hNull_V : ∀ (q : Ideal A_V) [q.IsMaximal],
        ∃ c : k₀, res_V f - c_V c ∈ q := by
      intro q hq_max
      let : Algebra k₀ A_V := c_V.toAlgebra
      have : Algebra.FiniteType k₀ A_V := hc_V_ft
      let L_q := A_V ⧸ q
      let : Field L_q := Ideal.Quotient.field q
      have hFT_Lq : Algebra.FiniteType A_V L_q :=
        RingHom.FiniteType.of_surjective (Ideal.Quotient.mk q) Ideal.Quotient.mk_surjective
      have : IsScalarTower k₀ A_V L_q := IsScalarTower.of_algebraMap_eq' rfl
      have : Algebra.FiniteType k₀ L_q := Algebra.FiniteType.trans hc_V_ft hFT_Lq
      have : Module.Finite k₀ L_q := finite_of_finite_type_of_isJacobsonRing k₀ L_q
      have : Algebra.IsIntegral k₀ L_q := Algebra.IsIntegral.of_finite k₀ L_q
      obtain ⟨c, hc⟩ :=
        (IsAlgClosed.algebraMap_bijective_of_isIntegral (k := k₀) (K := L_q)).2
          (Ideal.Quotient.mk q (res_V f))
      refine ⟨c, ?_⟩
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub]
      have hAlgLq : algebraMap k₀ L_q c = Ideal.Quotient.mk q (c_V c) := rfl
      rw [← hAlgLq, hc, sub_self]
    have hQF_V : ι_V.QuasiFinite := by
      let : Algebra B A_V := ι_V.toAlgebra
      have : Algebra.FiniteType B A_V := hFT_V
      have : IsNoetherianRing A_V := hNoeth_V
      change Algebra.QuasiFinite B A_V
      rw [Algebra.QuasiFinite.iff_finite_comap_preimage_singleton]
      intro P
      by_cases hP : P.asIdeal = ⊥
      · refine (Set.finite_singleton (⊥ : PrimeSpectrum A_V)).subset ?_
        intro q hq
        rw [Set.mem_preimage, Set.mem_singleton_iff] at hq
        have hq_comap : Ideal.comap ι_V q.asIdeal = ⊥ := by
          have h1 := congrArg PrimeSpectrum.asIdeal hq
          rwa [PrimeSpectrum.comap_asIdeal, hP] at h1
        rw [Set.mem_singleton_iff]
        ext1
        change q.asIdeal = ⊥
        by_contra hq_ne
        have : q.asIdeal.IsMaximal := Ring.DimensionLEOne.maximalOfPrime hq_ne q.isPrime
        obtain ⟨c, hc_mem⟩ := hNull_V q.asIdeal
        have hEval_q : ι_V (φ_AB (Polynomial.X - Polynomial.C c)) ∈ q.asIdeal := by
          have h1 : β_0 (φ_AB (Polynomial.X - Polynomial.C c)) =
              Φ (Polynomial.X - Polynomial.C c) :=
            congrArg (fun g : Polynomial k₀ →+* _ => g (Polynomial.X - Polynomial.C c)) hβ_comp
          change res_V (β_0 (φ_AB (Polynomial.X - Polynomial.C c))) ∈ q.asIdeal
          rw [h1, map_sub]
          change res_V (Polynomial.eval₂ c_Ω f Polynomial.X -
            Polynomial.eval₂ c_Ω f (Polynomial.C c)) ∈ q.asIdeal
          rw [Polynomial.eval₂_X, Polynomial.eval₂_C, map_sub, h_cV_res V hV_Ω c]
          exact hc_mem
        have hInBot : φ_AB (Polynomial.X - Polynomial.C c) ∈ (⊥ : Ideal B) := by
          rw [← hq_comap]; exact hEval_q
        rw [Ideal.mem_bot] at hInBot
        exact Polynomial.X_sub_C_ne_zero c (hInj_φAB (hInBot.trans (map_zero φ_AB).symm))
      · have hb_ex : ∃ b ∈ P.asIdeal, b ≠ 0 := by
          by_contra hAll
          apply hP
          ext x
          simp only [Ideal.mem_bot]
          exact ⟨fun hx => by_contra fun hx0 => hAll ⟨x, hx, hx0⟩,
            fun hx => hx.symm ▸ P.asIdeal.zero_mem⟩
        obtain ⟨b, hb_P, hb_ne⟩ := hb_ex
        have hιb_ne : ι_V b ≠ 0 := fun h => hb_ne (hInj_ιV (h.trans (map_zero ι_V).symm))
        let I : Ideal A_V := Ideal.span {ι_V b}
        have hMinFin : I.minimalPrimes.Finite :=
          Ideal.finite_minimalPrimes_of_isNoetherianRing A_V I
        have hImgSub : PrimeSpectrum.asIdeal '' (PrimeSpectrum.comap ι_V ⁻¹' {P}) ⊆
            I.minimalPrimes := by
          rintro _ ⟨q, hq, rfl⟩
          rw [Set.mem_preimage, Set.mem_singleton_iff] at hq
          have hq_comap : Ideal.comap ι_V q.asIdeal = P.asIdeal := by
            have h1 := congrArg PrimeSpectrum.asIdeal hq
            rwa [PrimeSpectrum.comap_asIdeal] at h1
          have hIq : I ≤ q.asIdeal := by
            rw [Ideal.span_singleton_le_iff_mem]
            change b ∈ Ideal.comap ι_V q.asIdeal
            rwa [hq_comap]
          refine ⟨⟨q.isPrime, hIq⟩, fun J hJ hJq => ?_⟩
          have hJ_ne : J ≠ ⊥ := by
            intro hJ0
            have hbJ : ι_V b ∈ J := hJ.2 (Ideal.subset_span (Set.mem_singleton _))
            rw [hJ0, Ideal.mem_bot] at hbJ
            exact hιb_ne hbJ
          have hJ_max : J.IsMaximal := Ring.DimensionLEOne.maximalOfPrime hJ_ne hJ.1
          exact (hJ_max.eq_of_le q.isPrime.ne_top hJq).ge
        exact Set.Finite.of_finite_image (hMinFin.subset hImgSub)
          (fun q₁ _ q₂ _ h => PrimeSpectrum.ext h)
    exact ⟨hFT_V, hQF_V⟩

  
  let f'_0 : Ω.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of B) :=
    Ω.toScheme.toSpecΓ ≫
      AlgebraicGeometry.Spec.map Ω.topIso.inv ≫
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom β_0)
  have hFacChart : f'_0 ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_AB) =
      Ω.toScheme.toSpecΓ ≫
        AlgebraicGeometry.Spec.map Ω.topIso.inv ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom Φ) := by
    dsimp [f'_0]
    rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
      ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hβ_comp]
  have : AlgebraicGeometry.IsProper
      (f'_0 ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_AB)) := by
    rw [hFacChart]; exact hPropChart
  have hProp_f0 : AlgebraicGeometry.IsProper f'_0 :=
    AlgebraicGeometry.IsProper.of_comp f'_0 (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_AB))
  have : AlgebraicGeometry.IsSeparated f'_0 := hProp_f0.toIsSeparated
  have : AlgebraicGeometry.UniversallyClosed f'_0 := hProp_f0.toUniversallyClosed

  have hLocalOpen : ∀ z : ↥Ω.toScheme,
      ∃ U_z : Ω.toScheme.Opens, z ∈ U_z ∧ AlgebraicGeometry.IsOpenImmersion (U_z.ι ≫ f'_0) := by
    intro z
    obtain ⟨V, hV, hx_V, hV_Ω_sub⟩ := AlgebraicGeometry.exists_isAffineOpen_mem_and_subset z.2
    have hV_Ω : V ≤ Ω := hV_Ω_sub
    have hV_ne : Nonempty V := ⟨⟨z.1, hx_V⟩⟩
    let A_V := ↑(X_tilde.presheaf.obj (Opposite.op V))
    let res_V := (X_tilde.presheaf.map (CategoryTheory.homOfLE hV_Ω).op).hom
    let ι_V : B →+* A_V := res_V.comp β_0
    obtain ⟨hDom_V, _, _⟩ := hNorm V hV hV_ne
    have : IsDomain A_V := hDom_V
    obtain ⟨hFT_V, hQF_V⟩ := hLocQF V hV hV_ne hV_Ω
    have hGerm_V : ∀ b : B, (X_tilde.germToFunctionField V).hom (ι_V b) = ι_B b := by
      intro b
      change (X_tilde.germToFunctionField V).hom (res_V (β_0 b)) = ι_B b
      rw [TopCat.Presheaf.germ_res_apply X_tilde.presheaf
        (CategoryTheory.homOfLE hV_Ω) _ _ (β_0 b), hGermβ b]
    have hInj_ιV : Function.Injective ι_V := fun b₁ b₂ h =>
      hInjB (by rw [← hGerm_V b₁, ← hGerm_V b₂, h])
    have hIntDesc : ∀ y : A_V, ι_V.IsIntegralElem y → ∃ b_0 : B, ι_V b_0 = y := by
      intro y hy
      have hyF : ((X_tilde.germToFunctionField V).hom.comp ι_V).IsIntegralElem
          ((X_tilde.germToFunctionField V).hom y) :=
        hy.map (X_tilde.germToFunctionField V).hom
      have hCompF : (X_tilde.germToFunctionField V).hom.comp ι_V = algebraMap B F_ss := by
        ext b; exact hGerm_V b
      rw [hCompF] at hyF
      have : IsFractionRing B F_ss := hFrac_B0
      obtain ⟨b_0, hb_0⟩ := (isIntegrallyClosed_iff F_ss).mp hIC_B0 hyF
      refine ⟨b_0, X_tilde.germToFunctionField_injective V ?_⟩
      rw [hGerm_V b_0]
      exact hb_0
    let : Algebra B A_V := ι_V.toAlgebra
    have : Algebra.FiniteType B A_V := hFT_V
    have : Algebra.QuasiFinite B A_V := RingHom.QuasiFinite.toAlgebra hQF_V
    let q_z : PrimeSpectrum A_V := hV.primeIdealOf ⟨z.1, hx_V⟩
    have : q_z.asIdeal.IsPrime := q_z.isPrime
    obtain ⟨r, hr_not_q, hr_int, h_pow_int⟩ :=
      (Algebra.zariskisMainProperty_iff (R := B) (p := q_z.asIdeal)).mp
        (Algebra.ZariskisMainProperty.of_finiteType (R := B) q_z.asIdeal)
    have hr_ne : r ≠ 0 := by rintro rfl; exact hr_not_q q_z.asIdeal.zero_mem
    obtain ⟨r_0, hr_0⟩ := hIntDesc r hr_int
    have h_num : ∀ a : A_V, ∃ (m : ℕ) (b_0 : B), ι_V b_0 = r ^ m * a := by
      intro a
      obtain ⟨m, hm⟩ := h_pow_int a
      obtain ⟨b_0, hb_0⟩ := hIntDesc (r ^ m * a) hm
      exact ⟨m, b_0, hb_0⟩
    let W_z : X_tilde.Opens := X_tilde.basicOpen r
    have hWz : AlgebraicGeometry.IsAffineOpen W_z := hV.basicOpen r
    have hWz_Ω : W_z ≤ Ω := (X_tilde.basicOpen_le r).trans hV_Ω
    have hx_Wz : z.1 ∈ W_z := by
      have hxq : hV.fromSpec.base q_z = z.1 := hV.fromSpec_primeIdealOf ⟨z.1, hx_V⟩
      rw [← hxq]
      change q_z ∈ (TopologicalSpace.Opens.map hV.fromSpec.base).obj (X_tilde.basicOpen r)
      rw [hV.fromSpec_preimage_basicOpen r]
      exact hr_not_q
    let A_r := ↑(X_tilde.presheaf.obj (Opposite.op W_z))
    let ι_r : B →+* A_r :=
      (X_tilde.presheaf.map (CategoryTheory.homOfLE hWz_Ω).op).hom.comp β_0
    have hι_r_eq : ∀ b : B, ι_r b = algebraMap A_V A_r (ι_V b) := by
      intro b
      have hMapComp : X_tilde.presheaf.map (CategoryTheory.homOfLE hWz_Ω).op =
          X_tilde.presheaf.map (CategoryTheory.homOfLE hV_Ω).op ≫
            X_tilde.presheaf.map (CategoryTheory.homOfLE (X_tilde.basicOpen_le r)).op :=
        (congrArg X_tilde.presheaf.map (Subsingleton.elim _ _)).trans
          (X_tilde.presheaf.map_comp _ _)
      exact congrArg (fun g => g.hom (β_0 b)) hMapComp
    have hLoc_r : IsLocalization.Away r A_r := hV.isLocalization_basicOpen r
    have hInj_Ar : Function.Injective (algebraMap A_V A_r) := by
      have hSub : Submonoid.powers r ≤ nonZeroDivisors A_V :=
        Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hr_ne)
      exact @IsLocalization.injective A_V _ (Submonoid.powers r) A_r _ _ hLoc_r hSub
    have hLoc_r0 : @IsLocalization.Away B _ r_0 A_r _ ι_r.toAlgebra := by
      let : Algebra B A_r := ι_r.toAlgebra
      refine { map_units := ?_, surj := ?_, exists_of_eq := ?_ }
      · rintro ⟨_, k, rfl⟩
        change IsUnit (ι_r (r_0 ^ k))
        rw [hι_r_eq, map_pow, hr_0]
        exact @IsLocalization.map_units A_V _ (Submonoid.powers r) A_r _ _ hLoc_r ⟨r ^ k, k, rfl⟩
      · intro w
        obtain ⟨k, a, hwa⟩ := @IsLocalization.Away.surj A_V _ A_r _ _ r hLoc_r w
        obtain ⟨m, b_0, hb_0⟩ := h_num a
        refine ⟨⟨b_0, ⟨r_0 ^ (k + m), k + m, rfl⟩⟩, ?_⟩
        change w * ι_r (r_0 ^ (k + m)) = ι_r b_0
        rw [hι_r_eq (r_0 ^ (k + m)), map_pow, hr_0, pow_add, map_mul, map_pow,
          ← mul_assoc, hwa, ← map_mul, mul_comm a (r ^ m), ← hb_0, ← hι_r_eq b_0]
      · intro b₁ b₂ hb
        change ι_r b₁ = ι_r b₂ at hb
        rw [hι_r_eq b₁, hι_r_eq b₂] at hb
        have hb' : b₁ = b₂ := hInj_ιV (hInj_Ar hb)
        exact ⟨⟨1, 0, pow_zero r_0⟩, by simp [hb']⟩
    have hOpenSpec : AlgebraicGeometry.IsOpenImmersion
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_r)) :=
      @AlgebraicGeometry.IsOpenImmersion.of_isLocalization B A_r _ _ ι_r.toAlgebra r_0 hLoc_r0
    let j_z : W_z.toScheme ⟶ Ω.toScheme := X_tilde.homOfLE hWz_Ω
    have hj_toSpecΓ : j_z ≫ Ω.toSpecΓ =
        W_z.toSpecΓ ≫
          AlgebraicGeometry.Spec.map (X_tilde.presheaf.map (CategoryTheory.homOfLE hWz_Ω).op) := by
      have h1 : Ω.topIso.inv ≫ j_z.appTop =
          X_tilde.presheaf.map (CategoryTheory.homOfLE hWz_Ω).op ≫ W_z.topIso.inv := by
        rw [Scheme.homOfLE_appTop, Scheme.Opens.topIso_inv, Scheme.Opens.topIso_inv]
        exact (X_tilde.presheaf.map_comp _ _).symm.trans
          ((congrArg X_tilde.presheaf.map (Subsingleton.elim _ _)).trans
            (X_tilde.presheaf.map_comp _ _))
      change j_z ≫ Ω.toScheme.toSpecΓ ≫ AlgebraicGeometry.Spec.map Ω.topIso.inv =
        (W_z.toScheme.toSpecΓ ≫ AlgebraicGeometry.Spec.map W_z.topIso.inv) ≫
          AlgebraicGeometry.Spec.map (X_tilde.presheaf.map (CategoryTheory.homOfLE hWz_Ω).op)
      rw [← CategoryTheory.Category.assoc, Scheme.toSpecΓ_naturality j_z,
        CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp, h1,
        AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc]
    have hj_f0 : j_z ≫ f'_0 =
        hWz.isoSpec.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_r) := by
      change j_z ≫ (Ω.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom β_0)) = _
      rw [← CategoryTheory.Category.assoc, hj_toSpecΓ, CategoryTheory.Category.assoc,
        ← AlgebraicGeometry.Spec.map_comp, ← hWz.isoSpec_hom]
      rfl
    have hOpen_jz_f0 : AlgebraicGeometry.IsOpenImmersion (j_z ≫ f'_0) := by
      rw [hj_f0]
      exact AlgebraicGeometry.IsOpenImmersion.comp
        hWz.isoSpec.hom (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_r))
    let U_z : Ω.toScheme.Opens := j_z.opensRange
    have hz_Uz : z ∈ U_z := by
      change z ∈ Set.range ⇑j_z.base
      refine ⟨⟨z.1, hx_Wz⟩, Ω.ι.isOpenEmbedding.injective ?_⟩
      change (j_z ≫ Ω.ι).base ⟨z.1, hx_Wz⟩ = Ω.ι.base z
      rw [Scheme.homOfLE_ι]
      rfl
    have hUz_ι : U_z.ι ≫ f'_0 = j_z.isoOpensRange.inv ≫ (j_z ≫ f'_0) := by
      have h2 : j_z.isoOpensRange.inv ≫ j_z = U_z.ι := by
        calc
          j_z.isoOpensRange.inv ≫ j_z
            = j_z.isoOpensRange.inv ≫ (j_z.isoOpensRange.hom ≫ U_z.ι) := by
              rw [j_z.isoOpensRange_hom_ι]
          _ = (j_z.isoOpensRange.inv ≫ j_z.isoOpensRange.hom) ≫ U_z.ι :=
              (CategoryTheory.Category.assoc _ _ _).symm
          _ = U_z.ι := by rw [CategoryTheory.Iso.inv_hom_id, CategoryTheory.Category.id_comp]
      rw [← h2, CategoryTheory.Category.assoc]
    have hOpen_Uz : AlgebraicGeometry.IsOpenImmersion (U_z.ι ≫ f'_0) := by
      rw [hUz_ι]
      exact AlgebraicGeometry.IsOpenImmersion.comp j_z.isoOpensRange.inv (j_z ≫ f'_0)
    exact ⟨U_z, hz_Uz, hOpen_Uz⟩

  choose U_cov hz_U hOpen_U using hLocalOpen

  have hInj_f0 : Function.Injective ⇑f'_0.base := by
    intro z₁ z₂ hfz
    have : AlgebraicGeometry.IsOpenImmersion ((U_cov z₁).ι ≫ f'_0) := hOpen_U z₁
    have : AlgebraicGeometry.IsOpenImmersion ((U_cov z₂).ι ≫ f'_0) := hOpen_U z₂
    let O₁ : Ω.toScheme.Opens :=
      U_cov z₁ ⊓ (TopologicalSpace.Opens.map f'_0.base).obj (((U_cov z₂).ι ≫ f'_0).opensRange)
    have hz₁_O₁ : z₁ ∈ O₁ := by
      refine ⟨hz_U z₁, ?_⟩
      change f'_0.base z₁ ∈ (((U_cov z₂).ι ≫ f'_0).opensRange : Set _)
      rw [((U_cov z₂).ι ≫ f'_0).coe_opensRange]
      exact ⟨⟨z₂, hz_U z₂⟩, hfz.symm⟩
    have hO₁_ne : Nonempty O₁ := ⟨⟨z₁, hz₁_O₁⟩⟩
    have hRange_O₁ : Set.range ⇑(O₁.ι ≫ f'_0).base ⊆
        Set.range ⇑((U_cov z₂).ι ≫ f'_0).base := by
      rintro _ ⟨⟨w, _, hwPre⟩, rfl⟩
      change f'_0.base w ∈ (((U_cov z₂).ι ≫ f'_0).opensRange : Set _) at hwPre
      rwa [((U_cov z₂).ι ≫ f'_0).coe_opensRange] at hwPre
    let τ : O₁.toScheme ⟶ (U_cov z₂).toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift ((U_cov z₂).ι ≫ f'_0) (O₁.ι ≫ f'_0) hRange_O₁
    have hτ_fac : τ ≫ ((U_cov z₂).ι ≫ f'_0) = O₁.ι ≫ f'_0 :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac ((U_cov z₂).ι ≫ f'_0) (O₁.ι ≫ f'_0) hRange_O₁
    have : IrreducibleSpace ↥Ω.toScheme :=
      AlgebraicGeometry.irreducibleSpace_of_isIntegral Ω.toScheme
    obtain ⟨w₀, hw₀_O₁, hw₀_U₂⟩ := nonempty_preirreducible_inter O₁.isOpen (U_cov z₂).isOpen
      ⟨z₁, hz₁_O₁⟩ ⟨z₂, hz_U z₂⟩
    let O₁₂ : Ω.toScheme.Opens := O₁ ⊓ U_cov z₂
    let ι₁ : O₁₂.toScheme ⟶ O₁.toScheme := Ω.toScheme.homOfLE inf_le_left
    let ι₂ : O₁₂.toScheme ⟶ (U_cov z₂).toScheme := Ω.toScheme.homOfLE inf_le_right
    have : IrreducibleSpace ↥O₁.toScheme :=
      AlgebraicGeometry.irreducibleSpace_of_isIntegral O₁.toScheme
    have : AlgebraicGeometry.IsDominant ι₁ := by
      rw [AlgebraicGeometry.isDominant_iff]
      exact ι₁.isOpenEmbedding.isOpen_range.dense
        ⟨ι₁.base ⟨w₀, hw₀_O₁, hw₀_U₂⟩, ⟨w₀, hw₀_O₁, hw₀_U₂⟩, rfl⟩
    have hι_τ : ι₁ ≫ τ = ι₂ := by
      apply (CategoryTheory.cancel_mono ((U_cov z₂).ι ≫ f'_0)).mp
      calc
        (ι₁ ≫ τ) ≫ ((U_cov z₂).ι ≫ f'_0)
          = ι₁ ≫ (τ ≫ ((U_cov z₂).ι ≫ f'_0)) := CategoryTheory.Category.assoc _ _ _
        _ = ι₁ ≫ (O₁.ι ≫ f'_0) := by rw [hτ_fac]
        _ = (ι₁ ≫ O₁.ι) ≫ f'_0 := (CategoryTheory.Category.assoc _ _ _).symm
        _ = O₁₂.ι ≫ f'_0 := by rw [Scheme.homOfLE_ι]
        _ = (ι₂ ≫ (U_cov z₂).ι) ≫ f'_0 := by rw [Scheme.homOfLE_ι]
        _ = ι₂ ≫ ((U_cov z₂).ι ≫ f'_0) := CategoryTheory.Category.assoc _ _ _
    have h_eq_ι : τ ≫ (U_cov z₂).ι = O₁.ι :=
      AlgebraicGeometry.ext_of_isDominant_of_isSeparated f'_0
        (by rw [CategoryTheory.Category.assoc, hτ_fac]) ι₁
        (by rw [← CategoryTheory.Category.assoc, hι_τ, Scheme.homOfLE_ι, Scheme.homOfLE_ι])
    let u₁ : ↥O₁.toScheme := ⟨z₁, hz₁_O₁⟩
    let u₂ : ↥(U_cov z₂).toScheme := ⟨z₂, hz_U z₂⟩
    have hτ_u : τ.base u₁ = u₂ := by
      apply ((U_cov z₂).ι ≫ f'_0).isOpenEmbedding.injective
      calc
        ((U_cov z₂).ι ≫ f'_0).base (τ.base u₁)
          = (τ ≫ ((U_cov z₂).ι ≫ f'_0)).base u₁ := rfl
        _ = (O₁.ι ≫ f'_0).base u₁ := by rw [hτ_fac]
        _ = f'_0.base z₁ := rfl
        _ = f'_0.base z₂ := hfz
        _ = ((U_cov z₂).ι ≫ f'_0).base u₂ := rfl
    have h_eval := congrArg (fun g : O₁.toScheme ⟶ Ω.toScheme => g.base u₁) h_eq_ι
    change (U_cov z₂).ι.base (τ.base u₁) = z₁ at h_eval
    rw [hτ_u] at h_eval
    exact h_eval.symm

  have hSupU : iSup U_cov = (⊤ : Ω.toScheme.Opens) :=
    eq_top_iff.mpr fun z _ => TopologicalSpace.Opens.mem_iSup.mpr ⟨z, hz_U z⟩
  have : AlgebraicGeometry.IsOpenImmersion f'_0 :=
    AlgebraicGeometry.IsOpenImmersion.of_openCover_source f'_0
      (Ω.toScheme.openCoverOfIsOpenCover U_cov (TopologicalSpace.IsOpenCover.mk hSupU))
      hInj_f0 fun i => hOpen_U i
  have : IrreducibleSpace ↥(AlgebraicGeometry.Spec (CommRingCat.of B)) :=
    AlgebraicGeometry.irreducibleSpace_of_isIntegral (AlgebraicGeometry.Spec (CommRingCat.of B))
  have : AlgebraicGeometry.IsDominant f'_0 := by
    rw [AlgebraicGeometry.isDominant_iff]
    exact f'_0.isOpenEmbedding.isOpen_range.dense
      ⟨f'_0.base ⟨x_0, hx_0⟩, ⟨x_0, hx_0⟩, rfl⟩
  have : AlgebraicGeometry.Surjective f'_0 :=
    AlgebraicGeometry.Surjective.of_universallyClosed_of_isDominant f'_0
  have : CategoryTheory.IsIso f'_0 :=
    (AlgebraicGeometry.isIso_iff_isOpenImmersion_and_surjective f'_0).mpr
      ⟨inferInstance, inferInstance⟩

  
  have hAffΩ : AlgebraicGeometry.IsAffineOpen Ω :=
    AlgebraicGeometry.IsAffine.of_isIso f'_0
  have hIsoApp : CategoryTheory.IsIso f'_0.appTop :=
    (inferInstance : CategoryTheory.IsIso (AlgebraicGeometry.Scheme.Γ.map f'_0.op))
  let β_mor : CommRingCat.of B ⟶ X_tilde.presheaf.obj (Opposite.op Ω) :=
    CommRingCat.ofHom β_0
  have hβ_mor_eq :
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of B)).inv ≫
        f'_0.appTop ≫ Ω.topIso.hom = β_mor := by
    change (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of B)).inv ≫
        (Ω.toSpecΓ ≫ AlgebraicGeometry.Spec.map β_mor).appTop ≫ Ω.topIso.hom = β_mor
    rw [AlgebraicGeometry.Scheme.Hom.comp_appTop, AlgebraicGeometry.Scheme.Opens.toSpecΓ_appTop]
    have hnat := AlgebraicGeometry.Scheme.ΓSpecIso_inv_naturality β_mor
    calc
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of B)).inv ≫
          ((AlgebraicGeometry.Spec.map β_mor).appTop ≫
            ((AlgebraicGeometry.Scheme.ΓSpecIso (X_tilde.presheaf.obj (Opposite.op Ω))).hom ≫
              Ω.topIso.inv)) ≫ Ω.topIso.hom
        = ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of B)).inv ≫
            (AlgebraicGeometry.Spec.map β_mor).appTop) ≫
          (AlgebraicGeometry.Scheme.ΓSpecIso (X_tilde.presheaf.obj (Opposite.op Ω))).hom ≫
          (Ω.topIso.inv ≫ Ω.topIso.hom) := by simp only [CategoryTheory.Category.assoc]
      _ = (β_mor ≫
            (AlgebraicGeometry.Scheme.ΓSpecIso (X_tilde.presheaf.obj (Opposite.op Ω))).inv) ≫
          (AlgebraicGeometry.Scheme.ΓSpecIso (X_tilde.presheaf.obj (Opposite.op Ω))).hom ≫
          𝟙 _ := by rw [← hnat, CategoryTheory.Iso.inv_hom_id]
      _ = β_mor := by simp
  have hIsoβ : CategoryTheory.IsIso β_mor := by
    rw [← hβ_mor_eq]
    infer_instance
  have hSurjβ : Function.Surjective β_0 := fun s =>
    ⟨(CategoryTheory.inv β_mor).hom s,
      congrArg (fun g => g.hom s) (CategoryTheory.IsIso.inv_hom_id β_mor)⟩
  have hFin_φ : φ_AB.Finite := RingHom.finite_algebraMap.mpr hFin_B0
  have hFin_β : β_0.Finite := RingHom.Finite.of_surjective β_0 hSurjβ
  have hFinΦ : Φ.Finite := by
    rw [← hβ_comp]
    exact RingHom.Finite.comp hFin_β hFin_φ
  exact ⟨hAffΩ, hFinΦ⟩

theorem weil_normal_proper_curve_shifted_pole_chart_of_meromorphic (k₀ : Type u) [Field k₀] [IsAlgClosed k₀]
    (X_tilde : AlgebraicGeometry.Scheme.{u})
    [AlgebraicGeometry.IsIntegral X_tilde]
    (p_tilde : X_tilde ⟶ AlgebraicGeometry.Spec (CommRingCat.of k₀))
    (hBijTop : Function.Bijective (p_tilde.appTop).hom)
    (hFinCl : ∀ (Z : Set ↥X_tilde), IsClosed Z → Z ≠ Set.univ → Z.Finite)
    (hMeroSurj : ∀ (h : ↑X_tilde.functionField), h ≠ 0 →
      ∃ (Ω_0 Ω_1 : X_tilde.Opens)
        (hΩ0_ne : Nonempty Ω_0) (hΩ1_ne : Nonempty Ω_1)
        (f_0 : ↑(X_tilde.presheaf.obj (Opposite.op Ω_0)))
        (s_1 : ↑(X_tilde.presheaf.obj (Opposite.op Ω_1))),
        letI : Nonempty Ω_0 := hΩ0_ne
        letI : Nonempty Ω_1 := hΩ1_ne
        Ω_0 ⊔ Ω_1 = ⊤ ∧
        Ω_0 ⊓ Ω_1 = X_tilde.basicOpen f_0 ∧
        Ω_0 ⊓ Ω_1 = X_tilde.basicOpen s_1 ∧
        (X_tilde.germToFunctionField Ω_0).hom f_0 = h ∧
        (X_tilde.germToFunctionField Ω_1).hom s_1 = h⁻¹ ∧
        (∀ (W : X_tilde.Opens) [Nonempty W]
            (s : ↑(X_tilde.presheaf.obj (Opposite.op W))),
          (X_tilde.germToFunctionField W).hom s = h →
          ∃ hW : W ≤ Ω_0,
            (X_tilde.presheaf.map (CategoryTheory.homOfLE hW).op).hom f_0 = s) ∧
        (∀ (W : X_tilde.Opens) [Nonempty W]
            (r : ↑(X_tilde.presheaf.obj (Opposite.op W))),
          (X_tilde.germToFunctionField W).hom r = h⁻¹ →
          ∃ hW : W ≤ Ω_1,
            (X_tilde.presheaf.map (CategoryTheory.homOfLE hW).op).hom s_1 = r) ∧
        (∀ (h0 : Ω_0 ⊓ Ω_1 ≤ Ω_0) (h1 : Ω_0 ⊓ Ω_1 ≤ Ω_1),
          (X_tilde.presheaf.map (CategoryTheory.homOfLE h0).op).hom f_0 *
            (X_tilde.presheaf.map (CategoryTheory.homOfLE h1).op).hom s_1 = 1) ∧
        ((∃ x_pole : ↥X_tilde, x_pole ∉ Ω_0) →
          AlgebraicGeometry.IsAffineOpen Ω_0 ∧
          Function.Surjective
            (Ω_0.toScheme.toSpecΓ ≫
              AlgebraicGeometry.Spec.map Ω_0.topIso.inv ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                (Polynomial.eval₂RingHom
                  (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
                    p_tilde.appLE ⊤ Ω_0 le_top).hom) f_0))).base))
    (V_tilde : X_tilde.Opens) (_ : AlgebraicGeometry.IsAffineOpen V_tilde)
    [Nonempty V_tilde]
    (t_tilde : ↑(X_tilde.presheaf.obj (Opposite.op V_tilde)))
    (ht_ne : ∀ c : k₀,
      t_tilde - (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
        p_tilde.appLE ⊤ V_tilde le_top).hom c) ≠ 0) :
    ∃ (c₀ : k₀) (Ω_0 : X_tilde.Opens)
      (u_0 : ↑(X_tilde.presheaf.obj (Opposite.op Ω_0))),
      let τ_tilde := t_tilde -
        (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
          p_tilde.appLE ⊤ V_tilde le_top).hom c₀)
      (∃ x ∈ V_tilde, x ∉ X_tilde.basicOpen τ_tilde) ∧
      (Ω_0 : Set ↥X_tilde) = ((V_tilde : Set ↥X_tilde) \ (X_tilde.basicOpen τ_tilde : Set ↥X_tilde))ᶜ ∧
      AlgebraicGeometry.IsAffineOpen Ω_0 ∧
      Nonempty Ω_0 ∧
      (∀ (hB_V : X_tilde.basicOpen τ_tilde ≤ V_tilde)
          (hB_0 : X_tilde.basicOpen τ_tilde ≤ Ω_0),
        (X_tilde.presheaf.map (CategoryTheory.homOfLE hB_V).op).hom τ_tilde *
          (X_tilde.presheaf.map (CategoryTheory.homOfLE hB_0).op).hom u_0 = 1) :=
by
  have hResX : ∀ {U₁ U₂ U₃ : X_tilde.Opens} (h₁₂ : U₁ ≤ U₂) (h₂₃ : U₂ ≤ U₃)
      (x : ↑(X_tilde.presheaf.obj (Opposite.op U₃))),
      (X_tilde.presheaf.map (CategoryTheory.homOfLE h₁₂).op).hom
        ((X_tilde.presheaf.map (CategoryTheory.homOfLE h₂₃).op).hom x) =
      (X_tilde.presheaf.map (CategoryTheory.homOfLE (h₁₂.trans h₂₃)).op).hom x := by
    intro U₁ U₂ U₃ h₁₂ h₂₃ x
    have hOpComp : (CategoryTheory.homOfLE (h₁₂.trans h₂₃)).op =
        (CategoryTheory.homOfLE h₂₃).op ≫ (CategoryTheory.homOfLE h₁₂).op := by
      rw [← CategoryTheory.homOfLE_comp]; rfl
    rw [hOpComp, CategoryTheory.Functor.map_comp]
    rfl
  let isoSpec := AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)
  let c_top : k₀ →+* ↑(X_tilde.presheaf.obj (Opposite.op ⊤)) :=
    (isoSpec.inv ≫ p_tilde.appTop).hom
  let c_W : ∀ (W : X_tilde.Opens), k₀ →+* ↑(X_tilde.presheaf.obj (Opposite.op W)) :=
    fun W => (isoSpec.inv ≫ p_tilde.appLE ⊤ W le_top).hom
  have hConstTop : ∀ (W : X_tilde.Opens) (c : k₀),
      (X_tilde.presheaf.map (CategoryTheory.homOfLE (le_top : W ≤ ⊤)).op).hom (c_top c) =
        c_W W c := by
    intro W c
    have hAppTop : p_tilde.appTop = p_tilde.appLE ⊤ (p_tilde ⁻¹ᵁ ⊤) le_rfl :=
      (AlgebraicGeometry.Scheme.Hom.appLE_eq_app p_tilde (U := ⊤)).symm
    have hStep : p_tilde.appTop ≫
        X_tilde.presheaf.map (CategoryTheory.homOfLE (le_top : W ≤ ⊤)).op =
        p_tilde.appLE ⊤ W le_top :=
      (congrArg (· ≫ X_tilde.presheaf.map (CategoryTheory.homOfLE (le_top : W ≤ ⊤)).op)
        hAppTop).trans
        (AlgebraicGeometry.Scheme.Hom.appLE_map p_tilde (U := ⊤) le_rfl
          (CategoryTheory.homOfLE (le_top : W ≤ ⊤)).op)
    exact congrArg (fun g => (isoSpec.inv ≫ g).hom c) hStep
  have hConstLE : ∀ {W₁ W₂ : X_tilde.Opens} (h₁₂ : W₁ ≤ W₂) (c : k₀),
      (X_tilde.presheaf.map (CategoryTheory.homOfLE h₁₂).op).hom (c_W W₂ c) = c_W W₁ c := by
    intro W₁ W₂ h₁₂ c
    rw [← hConstTop W₂ c, hResX, hConstTop W₁ c]
  obtain ⟨⟨x_V, hx_V⟩⟩ := (inferInstance : Nonempty V_tilde)
  letI : Nonempty (⊤ : X_tilde.Opens) := ⟨⟨x_V, trivial⟩⟩
  let c_F : k₀ →+* ↑X_tilde.functionField :=
    (X_tilde.germToFunctionField (⊤ : X_tilde.Opens)).hom.comp c_top
  have hConstGerm : ∀ (W : X_tilde.Opens) [Nonempty W] (c : k₀),
      (X_tilde.germToFunctionField W).hom (c_W W c) = c_F c := by
    intro W _ c
    rw [← hConstTop W c]
    exact TopCat.Presheaf.germ_res_apply X_tilde.presheaf
      (CategoryTheory.homOfLE (le_top : W ≤ ⊤)) _ _ (c_top c)
  have ht_ne0 : t_tilde ≠ 0 := by
    have h0 := ht_ne 0
    change t_tilde - c_W V_tilde 0 ≠ 0 at h0
    rwa [map_zero, sub_zero] at h0
  let h_0 : ↑X_tilde.functionField := (X_tilde.germToFunctionField V_tilde).hom t_tilde
  have hh_0 : h_0 ≠ 0 := by
    intro hzero
    apply ht_ne0
    apply X_tilde.germToFunctionField_injective V_tilde
    change h_0 = (X_tilde.germToFunctionField V_tilde).hom 0
    rw [hzero, map_zero]
  obtain ⟨Ω_0, Ω_1, hΩ0_ne, hΩ1_ne, f_0, s_1,
      hCov0, _hInter0_f, hInter0_s, hGerm_f0, hGerm_s1,
      hExt_f0, _hExt_s1, _hRecip0, hPoleImp0⟩ := hMeroSurj h_0 hh_0
  letI : Nonempty Ω_0 := hΩ0_ne
  letI : Nonempty Ω_1 := hΩ1_ne
  obtain ⟨hV_le_Ω0, hf0_res_V⟩ := hExt_f0 V_tilde t_tilde rfl
  have hHasPole0 : ∃ x_pole : ↥X_tilde, x_pole ∉ Ω_0 := by
    by_contra hNoPole
    have hTop_le_Ω0 : (⊤ : X_tilde.Opens) ≤ Ω_0 := by
      intro x _
      by_contra hx0
      exact hNoPole ⟨x, hx0⟩
    let s_top : ↑(X_tilde.presheaf.obj (Opposite.op ⊤)) :=
      (X_tilde.presheaf.map (CategoryTheory.homOfLE hTop_le_Ω0).op).hom f_0
    obtain ⟨y, hy⟩ := hBijTop.2 s_top
    let c : k₀ := isoSpec.hom.hom y
    have hc_inv : isoSpec.inv.hom c = y := by
      change (isoSpec.hom ≫ isoSpec.inv).hom y = y
      rw [isoSpec.hom_inv_id]
      rfl
    have hc_top_eq : c_top c = s_top := by
      change (p_tilde.appTop).hom (isoSpec.inv.hom c) = s_top
      rw [hc_inv, hy]
    have hc_V_eq : c_W V_tilde c = t_tilde := by
      rw [← hConstTop V_tilde c, hc_top_eq]
      dsimp [s_top]
      rw [hResX]
      exact hf0_res_V
    exact ht_ne c (sub_eq_zero.mpr hc_V_eq.symm)
  obtain ⟨_hAff_Ω0, hSurj_q0⟩ := hPoleImp0 hHasPole0
  let Φ_0 : Polynomial k₀ →+* ↑(X_tilde.presheaf.obj (Opposite.op Ω_0)) :=
    Polynomial.eval₂RingHom (c_W Ω_0) f_0
  let q_0 := Ω_0.toScheme.toSpecΓ ≫
    AlgebraicGeometry.Spec.map Ω_0.topIso.inv ≫
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom Φ_0)
  have hSurj_q0' : Function.Surjective q_0.base := hSurj_q0
  let m_c : k₀ → PrimeSpectrum (Polynomial k₀) :=
    fun c => PrimeSpectrum.comap (Polynomial.evalRingHom c) (⊥ : PrimeSpectrum k₀)
  have hm_mem : ∀ (c : k₀) (P : Polynomial k₀),
      P ∈ (m_c c).asIdeal ↔ Polynomial.eval c P = 0 := by
    intro c P
    change Polynomial.evalRingHom c P ∈ (⊥ : Ideal k₀) ↔ Polynomial.eval c P = 0
    rw [Submodule.mem_bot, Polynomial.coe_evalRingHom]
  have hm_ker : ∀ c : k₀, (m_c c).asIdeal = RingHom.ker (Polynomial.evalRingHom c) := by
    intro c
    ext P
    rw [hm_mem, RingHom.mem_ker, Polynomial.coe_evalRingHom]
  have hm_max : ∀ c : k₀, (m_c c).asIdeal.IsMaximal := by
    intro c
    rw [hm_ker c]
    apply RingHom.ker_isMaximal_of_surjective
    intro r
    refine ⟨Polynomial.C r, ?_⟩
    rw [Polynomial.coe_evalRingHom, Polynomial.eval_C]
  have hm_iff : ∀ (c : k₀) (q : PrimeSpectrum (Polynomial k₀)),
      Polynomial.X - Polynomial.C c ∈ q.asIdeal ↔ q = m_c c := by
    intro c q
    refine ⟨?_, ?_⟩
    · intro hpq
      have hle : (m_c c).asIdeal ≤ q.asIdeal := by
        intro P hP
        rw [hm_mem] at hP
        have hRoot : P.IsRoot c := hP
        obtain ⟨Q, hPQ⟩ := Polynomial.dvd_iff_isRoot.mpr hRoot
        rw [hPQ]
        exact Ideal.mul_mem_right Q q.asIdeal hpq
      have heq : (m_c c).asIdeal = q.asIdeal :=
        Ideal.IsMaximal.eq_of_le (hm_max c) q.isPrime.ne_top hle
      exact (PrimeSpectrum.ext heq).symm
    · rintro rfl
      rw [hm_mem, Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C, sub_self]
  have hm_inj : Function.Injective m_c := by
    intro c₁ c₂ heq
    have h1 : Polynomial.X - Polynomial.C c₁ ∈ (m_c c₂).asIdeal :=
      (hm_iff c₁ (m_c c₂)).mpr heq.symm
    rw [hm_mem, Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C] at h1
    exact (sub_eq_zero.mp h1).symm
  let Z_c : Set ↥X_tilde := (V_tilde : Set ↥X_tilde)ᶜ
  have hZc_cl : IsClosed Z_c := V_tilde.isOpen.isClosed_compl
  have hZc_ne : Z_c ≠ Set.univ := by
    intro huniv
    have hx_in : x_V ∈ Z_c := by rw [huniv]; trivial
    exact hx_in hx_V
  have hZc_fin : Z_c.Finite := hFinCl Z_c hZc_cl hZc_ne
  have hInj_ι0 : Function.Injective Ω_0.ι.base :=
    Ω_0.ι.isOpenEmbedding.toIsEmbedding.injective
  let S_out : Set ↥Ω_0.toScheme := Ω_0.ι.base ⁻¹' Z_c
  have hSout_fin : S_out.Finite := hZc_fin.preimage hInj_ι0.injOn
  let I_bad : Set (PrimeSpectrum (Polynomial k₀)) := q_0.base '' S_out
  have hIbad_fin : I_bad.Finite := hSout_fin.image q_0.base
  have hRange_inf : (Set.range m_c).Infinite := Set.infinite_range_of_injective hm_inj
  obtain ⟨_, ⟨c₀, rfl⟩, hm_not_bad⟩ := hRange_inf.exists_notMem_finite hIbad_fin
  let p_0 : Polynomial k₀ := Polynomial.X - Polynomial.C c₀
  let τ_Ω0 : ↑(X_tilde.presheaf.obj (Opposite.op Ω_0)) := f_0 - c_W Ω_0 c₀
  let τ_tilde : ↑(X_tilde.presheaf.obj (Opposite.op V_tilde)) := t_tilde - c_W V_tilde c₀
  have hChart_bo : ∀ z : ↥Ω_0.toScheme,
      p_0 ∉ (q_0.base z).asIdeal ↔ Ω_0.ι.base z ∈ X_tilde.basicOpen τ_Ω0 := by
    intro z
    have hΦ_p0 : Φ_0 p_0 = τ_Ω0 := by
      simp [Φ_0, p_0, τ_Ω0]
    have hStep1 :
        (TopologicalSpace.Opens.map (AlgebraicGeometry.Spec.map (CommRingCat.ofHom Φ_0)).base).obj
          (PrimeSpectrum.basicOpen p_0) = PrimeSpectrum.basicOpen τ_Ω0 := by
      rw [AlgebraicGeometry.SpecMap_preimage_basicOpen (CommRingCat.ofHom Φ_0) p_0]
      exact congrArg PrimeSpectrum.basicOpen hΦ_p0
    have hStep2 :
        (TopologicalSpace.Opens.map (AlgebraicGeometry.Spec.map Ω_0.topIso.inv).base).obj
          (PrimeSpectrum.basicOpen τ_Ω0) = PrimeSpectrum.basicOpen (Ω_0.topIso.inv.hom τ_Ω0) :=
      AlgebraicGeometry.SpecMap_preimage_basicOpen Ω_0.topIso.inv τ_Ω0
    have hStep3 :
        (TopologicalSpace.Opens.map Ω_0.toScheme.toSpecΓ.base).obj
          (PrimeSpectrum.basicOpen (Ω_0.topIso.inv.hom τ_Ω0)) =
          Ω_0.toScheme.basicOpen (Ω_0.topIso.inv.hom τ_Ω0) :=
      AlgebraicGeometry.Scheme.toSpecΓ_preimage_basicOpen Ω_0.toScheme (Ω_0.topIso.inv.hom τ_Ω0)
    have hPre_q0 :
        (TopologicalSpace.Opens.map q_0.base).obj (PrimeSpectrum.basicOpen p_0) =
          Ω_0.toScheme.basicOpen (Ω_0.topIso.inv.hom τ_Ω0) := by
      have hDef : (TopologicalSpace.Opens.map q_0.base).obj (PrimeSpectrum.basicOpen p_0) =
          (TopologicalSpace.Opens.map Ω_0.toScheme.toSpecΓ.base).obj
            ((TopologicalSpace.Opens.map (AlgebraicGeometry.Spec.map Ω_0.topIso.inv).base).obj
              ((TopologicalSpace.Opens.map (AlgebraicGeometry.Spec.map (CommRingCat.ofHom Φ_0)).base).obj
                (PrimeSpectrum.basicOpen p_0))) := rfl
      exact hDef.trans ((congrArg (fun U => (TopologicalSpace.Opens.map Ω_0.toScheme.toSpecΓ.base).obj
        ((TopologicalSpace.Opens.map (AlgebraicGeometry.Spec.map Ω_0.topIso.inv).base).obj U)) hStep1).trans
        ((congrArg (TopologicalSpace.Opens.map Ω_0.toScheme.toSpecΓ.base).obj hStep2).trans hStep3))
    have hImg :
        Ω_0.ι ''ᵁ (Ω_0.toScheme.basicOpen (Ω_0.topIso.inv.hom τ_Ω0)) =
          X_tilde.basicOpen τ_Ω0 :=
      AlgebraicGeometry.Scheme.Opens.ι_image_basicOpen_topIso_inv Ω_0 τ_Ω0
    calc
      p_0 ∉ (q_0.base z).asIdeal
        ↔ q_0.base z ∈ PrimeSpectrum.basicOpen p_0 := (PrimeSpectrum.mem_basicOpen p_0 (q_0.base z)).symm
      _ ↔ z ∈ (TopologicalSpace.Opens.map q_0.base).obj (PrimeSpectrum.basicOpen p_0) := Iff.rfl
      _ ↔ z ∈ Ω_0.toScheme.basicOpen (Ω_0.topIso.inv.hom τ_Ω0) := by rw [hPre_q0]
      _ ↔ Ω_0.ι.base z ∈ Ω_0.ι.base '' (Ω_0.toScheme.basicOpen (Ω_0.topIso.inv.hom τ_Ω0) : Set ↥Ω_0.toScheme) :=
          (hInj_ι0.mem_set_image).symm
      _ ↔ Ω_0.ι.base z ∈ (Ω_0.ι ''ᵁ (Ω_0.toScheme.basicOpen (Ω_0.topIso.inv.hom τ_Ω0)) : Set ↥X_tilde) := by
          rw [AlgebraicGeometry.Scheme.Hom.coe_image]
      _ ↔ Ω_0.ι.base z ∈ X_tilde.basicOpen τ_Ω0 := by
          rw [hImg]; rfl
  have hτ_res_V :
      (X_tilde.presheaf.map (CategoryTheory.homOfLE hV_le_Ω0).op).hom τ_Ω0 = τ_tilde := by
    dsimp [τ_Ω0, τ_tilde]
    rw [map_sub, hf0_res_V, hConstLE hV_le_Ω0 c₀]
  have hbo_τ : X_tilde.basicOpen τ_tilde = V_tilde ⊓ X_tilde.basicOpen τ_Ω0 := by
    rw [← hτ_res_V, AlgebraicGeometry.Scheme.basicOpen_res]
  obtain ⟨z_0, hz_0⟩ := hSurj_q0' (m_c c₀)
  let x_0 : ↥X_tilde := Ω_0.ι.base z_0
  have hx0_V : x_0 ∈ V_tilde := by
    by_contra hx0_notV
    have hz0_out : z_0 ∈ S_out := hx0_notV
    have hm_in : m_c c₀ ∈ I_bad := ⟨z_0, hz0_out, hz_0⟩
    exact hm_not_bad hm_in
  have hx0_not_bo : x_0 ∉ X_tilde.basicOpen τ_tilde := by
    intro hx0_bo
    rw [hbo_τ] at hx0_bo
    have hp0_not : p_0 ∉ (q_0.base z_0).asIdeal := (hChart_bo z_0).mpr hx0_bo.2
    exact hp0_not ((hm_iff c₀ (q_0.base z_0)).mpr hz_0)
  have hOut_bo : ∀ x : ↥X_tilde, x ∈ Ω_0 → x ∉ V_tilde → x ∈ X_tilde.basicOpen τ_Ω0 := by
    intro x hx_Ω0 hx_notV
    let z : ↥Ω_0.toScheme := ⟨x, hx_Ω0⟩
    have hz_eq : Ω_0.ι.base z = x := AlgebraicGeometry.Scheme.Opens.ι_apply Ω_0 z
    have hz_out : z ∈ S_out := by
      change Ω_0.ι.base z ∈ Z_c
      rw [hz_eq]
      exact hx_notV
    have hqz_ne : q_0.base z ≠ m_c c₀ := by
      intro heq
      exact hm_not_bad ⟨z, hz_out, heq⟩
    have hp0_not : p_0 ∉ (q_0.base z).asIdeal := by
      intro hp0_in
      exact hqz_ne ((hm_iff c₀ (q_0.base z)).mp hp0_in)
    rw [← hz_eq]
    exact (hChart_bo z).mp hp0_not
  let g_0 : ↑X_tilde.functionField := (X_tilde.germToFunctionField V_tilde).hom τ_tilde
  have hg_0 : g_0 ≠ 0 := by
    intro hg0_zero
    apply ht_ne c₀
    apply X_tilde.germToFunctionField_injective V_tilde
    change g_0 = (X_tilde.germToFunctionField V_tilde).hom 0
    rw [hg0_zero, map_zero]
  have hg_0_eq : g_0 = h_0 - c_F c₀ := by
    dsimp [g_0, τ_tilde, h_0]
    rw [map_sub, hConstGerm V_tilde c₀]
  let h_1 : ↑X_tilde.functionField := g_0⁻¹
  have hh_1 : h_1 ≠ 0 := inv_ne_zero hg_0
  obtain ⟨Ω'_0, Ω'_1, hΩ'0_ne, hΩ'1_ne, u_0, v_1,
      _hCov', _hInter'_u, hInter'_v, _hGerm_u0, _hGerm_v1,
      hExt_u0, hExt_v1, hRecip', hPoleImp'⟩ := hMeroSurj h_1 hh_1
  letI : Nonempty Ω'_0 := hΩ'0_ne
  letI : Nonempty Ω'_1 := hΩ'1_ne
  obtain ⟨hV_le_Ω'1, hv1_res_V⟩ := hExt_v1 V_tilde τ_tilde (inv_inv g_0).symm
  have hInter_V_Ω'0 : V_tilde ⊓ Ω'_0 = X_tilde.basicOpen τ_tilde := by
    have hEq1 : V_tilde ⊓ Ω'_0 = V_tilde ⊓ (Ω'_0 ⊓ Ω'_1) :=
      le_antisymm (fun x hx => ⟨hx.1, hx.2, hV_le_Ω'1 hx.1⟩)
        (fun x hx => ⟨hx.1, hx.2.1⟩)
    rw [hEq1, hInter'_v, ← hv1_res_V, AlgebraicGeometry.Scheme.basicOpen_res]
  have hCompl_in_Ω'0 : ∀ x : ↥X_tilde, x ∉ V_tilde → x ∈ Ω'_0 := by
    intro x hx_notV
    by_cases hx0 : x ∈ Ω_0
    · let W_a : X_tilde.Opens := X_tilde.basicOpen τ_Ω0
      have hx_Wa : x ∈ W_a := hOut_bo x hx0 hx_notV
      letI : Nonempty W_a := ⟨⟨x, hx_Wa⟩⟩
      have hUnit_a : IsUnit
          ((X_tilde.presheaf.map (CategoryTheory.homOfLE (X_tilde.basicOpen_le τ_Ω0)).op).hom τ_Ω0) :=
        X_tilde.toRingedSpace.isUnit_res_basicOpen τ_Ω0
      obtain ⟨s_a, hsa_mul⟩ := hUnit_a.exists_right_inv
      have hsa_germ : (X_tilde.germToFunctionField W_a).hom s_a = h_1 := by
        have h1 := congrArg (X_tilde.germToFunctionField W_a).hom hsa_mul
        rw [map_mul, map_one,
          TopCat.Presheaf.germ_res_apply X_tilde.presheaf
            (CategoryTheory.homOfLE (X_tilde.basicOpen_le τ_Ω0)) _ _ τ_Ω0] at h1
        have hτ_germ : (X_tilde.germToFunctionField Ω_0).hom τ_Ω0 = g_0 := by
          dsimp [τ_Ω0]
          rw [map_sub, hGerm_f0, hConstGerm Ω_0 c₀, hg_0_eq]
        rw [hτ_germ] at h1
        exact eq_inv_of_mul_eq_one_right h1
      obtain ⟨hWa_le, _⟩ := hExt_u0 W_a s_a hsa_germ
      exact hWa_le hx_Wa
    · have hx_top : x ∈ (Ω_0 ⊔ Ω_1 : X_tilde.Opens) := by
        rw [hCov0]; trivial
      have hx1 : x ∈ Ω_1 := by
        rcases TopologicalSpace.Opens.mem_sup.mp hx_top with hx0' | hx1'
        · exact False.elim (hx0 hx0')
        · exact hx1'
      have hx_not_s1 : x ∉ X_tilde.basicOpen s_1 := by
        intro hxs1
        rw [← hInter0_s] at hxs1
        exact hx0 hxs1.1
      let w_1 : ↑(X_tilde.presheaf.obj (Opposite.op Ω_1)) := 1 - c_W Ω_1 c₀ * s_1
      let W_b : X_tilde.Opens := X_tilde.basicOpen w_1
      have hx_Wb : x ∈ W_b := by
        let γ_x := (X_tilde.presheaf.germ Ω_1 x hx1).hom
        rcases IsLocalRing.isUnit_or_isUnit_one_sub_self (γ_x (c_W Ω_1 c₀ * s_1)) with hu | hu1
        · rw [map_mul] at hu
          have hus1 : IsUnit (γ_x s_1) := isUnit_of_mul_isUnit_right hu
          exact False.elim (hx_not_s1 ((X_tilde.mem_basicOpen s_1 x hx1).mpr hus1))
        · have huw : IsUnit (γ_x w_1) := by
            dsimp [w_1]
            rwa [map_sub, map_one]
          exact (X_tilde.mem_basicOpen w_1 x hx1).mpr huw
      letI : Nonempty W_b := ⟨⟨x, hx_Wb⟩⟩
      have hUnit_b : IsUnit
          ((X_tilde.presheaf.map (CategoryTheory.homOfLE (X_tilde.basicOpen_le w_1)).op).hom w_1) :=
        X_tilde.toRingedSpace.isUnit_res_basicOpen w_1
      obtain ⟨q_b, hqb_mul⟩ := hUnit_b.exists_right_inv
      let r_b : ↑(X_tilde.presheaf.obj (Opposite.op W_b)) :=
        (X_tilde.presheaf.map (CategoryTheory.homOfLE (X_tilde.basicOpen_le w_1)).op).hom s_1 * q_b
      have hrb_germ : (X_tilde.germToFunctionField W_b).hom r_b = h_1 := by
        have hqb_1 := congrArg (X_tilde.germToFunctionField W_b).hom hqb_mul
        rw [map_mul, map_one,
          TopCat.Presheaf.germ_res_apply X_tilde.presheaf
            (CategoryTheory.homOfLE (X_tilde.basicOpen_le w_1)) _ _ w_1] at hqb_1
        have hw1_germ : (X_tilde.germToFunctionField Ω_1).hom w_1 = 1 - c_F c₀ * h_0⁻¹ := by
          dsimp [w_1]
          rw [map_sub, map_one, map_mul, hConstGerm Ω_1 c₀, hGerm_s1]
        rw [hw1_germ] at hqb_1
        have hrb_eq : (X_tilde.germToFunctionField W_b).hom r_b =
            h_0⁻¹ * (X_tilde.germToFunctionField W_b).hom q_b := by
          dsimp [r_b]
          rw [map_mul,
            TopCat.Presheaf.germ_res_apply X_tilde.presheaf
              (CategoryTheory.homOfLE (X_tilde.basicOpen_le w_1)) _ _ s_1,
            hGerm_s1]
        have hProd : g_0 * (X_tilde.germToFunctionField W_b).hom r_b = 1 := by
          rw [hrb_eq, hg_0_eq, ← mul_assoc, sub_mul, mul_inv_cancel₀ hh_0, hqb_1]
        exact eq_inv_of_mul_eq_one_right hProd
      obtain ⟨hWb_le, _⟩ := hExt_u0 W_b r_b hrb_germ
      exact hWb_le hx_Wb
  have hSetEq :
      (Ω'_0 : Set ↥X_tilde) =
        ((V_tilde : Set ↥X_tilde) \ (X_tilde.basicOpen τ_tilde : Set ↥X_tilde))ᶜ := by
    ext x
    change x ∈ Ω'_0 ↔ ¬ (x ∈ V_tilde ∧ x ∉ X_tilde.basicOpen τ_tilde)
    by_cases hxV : x ∈ V_tilde
    · have hiff : x ∈ Ω'_0 ↔ x ∈ X_tilde.basicOpen τ_tilde := by
        calc
          x ∈ Ω'_0 ↔ x ∈ (V_tilde ⊓ Ω'_0 : X_tilde.Opens) :=
            ⟨fun hx0 => ⟨hxV, hx0⟩, fun hx => hx.2⟩
          _ ↔ x ∈ X_tilde.basicOpen τ_tilde := by rw [hInter_V_Ω'0]
      rw [hiff]
      exact ⟨fun hbo ⟨_, hnot⟩ => hnot hbo, fun h => Classical.byContradiction fun hnot => h ⟨hxV, hnot⟩⟩
    · exact ⟨fun _ ⟨hV, _⟩ => hxV hV, fun _ => hCompl_in_Ω'0 x hxV⟩
  have hx0_not_Ω'0 : x_0 ∉ Ω'_0 := by
    intro hx0_in
    have hx0_mem : x_0 ∈ (Ω'_0 : Set ↥X_tilde) := hx0_in
    rw [hSetEq] at hx0_mem
    exact hx0_mem ⟨hx0_V, hx0_not_bo⟩
  have hAff_Ω'0 : AlgebraicGeometry.IsAffineOpen Ω'_0 :=
    (hPoleImp' ⟨x_0, hx0_not_Ω'0⟩).1
  refine ⟨c₀, Ω'_0, u_0, ⟨x_0, hx0_V, hx0_not_bo⟩, hSetEq, hAff_Ω'0, hΩ'0_ne, ?_⟩
  intro hB_V hB_0
  have hB_1 : X_tilde.basicOpen τ_tilde ≤ Ω'_1 := hB_V.trans hV_le_Ω'1
  have hB_01 : X_tilde.basicOpen τ_tilde ≤ Ω'_0 ⊓ Ω'_1 := le_inf hB_0 hB_1
  have hProd := congrArg (X_tilde.presheaf.map (CategoryTheory.homOfLE hB_01).op).hom
    (hRecip' inf_le_left inf_le_right)
  rw [map_mul, map_one, hResX, hResX] at hProd
  have ha_eq :
      (X_tilde.presheaf.map (CategoryTheory.homOfLE hB_V).op).hom τ_tilde =
        (X_tilde.presheaf.map (CategoryTheory.homOfLE (hB_01.trans inf_le_right)).op).hom v_1 :=
    (congrArg (X_tilde.presheaf.map (CategoryTheory.homOfLE hB_V).op).hom hv1_res_V.symm).trans
      (hResX hB_V hV_le_Ω'1 v_1)
  have hb_eq :
      (X_tilde.presheaf.map (CategoryTheory.homOfLE hB_0).op).hom u_0 =
        (X_tilde.presheaf.map (CategoryTheory.homOfLE (hB_01.trans inf_le_left)).op).hom u_0 := rfl
  exact (mul_comm _ _).trans ((congrArg₂ (· * ·) hb_eq ha_eq).trans hProd)

theorem weil_normal_proper_curve_meromorphic_projLine_finiteness (k₀ : Type u) [Field k₀] [IsAlgClosed k₀]
    (X_tilde : AlgebraicGeometry.Scheme.{u})
    [AlgebraicGeometry.IsIntegral X_tilde]
    (p_tilde : X_tilde ⟶ AlgebraicGeometry.Spec (CommRingCat.of k₀))
    (hNorm : ∀ (U : X_tilde.Opens), AlgebraicGeometry.IsAffineOpen U → Nonempty U →
      IsDomain ↑(X_tilde.presheaf.obj (Opposite.op U)) ∧
      IsIntegrallyClosed ↑(X_tilde.presheaf.obj (Opposite.op U)) ∧
      Ring.DimensionLEOne ↑(X_tilde.presheaf.obj (Opposite.op U)))
    (hProp : AlgebraicGeometry.IsProper p_tilde)
    (hSec₀ : ∃ σ₀ : AlgebraicGeometry.Spec (CommRingCat.of k₀) ⟶ X_tilde,
      σ₀ ≫ p_tilde = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k₀)))
    (hFinCl : ∀ (Z : Set ↥X_tilde), IsClosed Z → Z ≠ Set.univ → Z.Finite)
    (hValReg : ∀ (h : ↑X_tilde.functionField), h ≠ 0 → ∀ (x : ↥X_tilde),
      ∃ (W : X_tilde.Opens) (_ : AlgebraicGeometry.IsAffineOpen W) (hW_ne : Nonempty W)
        (s : ↑(X_tilde.presheaf.obj (Opposite.op W))),
        letI : Nonempty W := hW_ne
        x ∈ W ∧
        ((X_tilde.germToFunctionField W).hom s = h ∨
          (X_tilde.germToFunctionField W).hom s = h⁻¹))
    (hFinIntClosure : ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra k₀ A] [Algebra.FiniteType k₀ A]
      (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K],
      Module.Finite A ↥(integralClosure A K) ∧ IsIntegrallyClosed ↥(integralClosure A K)) :
    (∀ (h : ↑X_tilde.functionField), h ≠ 0 →
      ∃ (Ω_0 Ω_1 : X_tilde.Opens)
        (hΩ0_ne : Nonempty Ω_0) (hΩ1_ne : Nonempty Ω_1)
        (f_0 : ↑(X_tilde.presheaf.obj (Opposite.op Ω_0)))
        (s_1 : ↑(X_tilde.presheaf.obj (Opposite.op Ω_1))),
        letI : Nonempty Ω_0 := hΩ0_ne
        letI : Nonempty Ω_1 := hΩ1_ne
        Ω_0 ⊔ Ω_1 = ⊤ ∧
        Ω_0 ⊓ Ω_1 = X_tilde.basicOpen f_0 ∧
        Ω_0 ⊓ Ω_1 = X_tilde.basicOpen s_1 ∧
        (X_tilde.germToFunctionField Ω_0).hom f_0 = h ∧
        (X_tilde.germToFunctionField Ω_1).hom s_1 = h⁻¹ ∧
        (∀ (W : X_tilde.Opens) [Nonempty W]
            (s : ↑(X_tilde.presheaf.obj (Opposite.op W))),
          (X_tilde.germToFunctionField W).hom s = h →
          ∃ hW : W ≤ Ω_0,
            (X_tilde.presheaf.map (CategoryTheory.homOfLE hW).op).hom f_0 = s) ∧
        (∀ (W : X_tilde.Opens) [Nonempty W]
            (r : ↑(X_tilde.presheaf.obj (Opposite.op W))),
          (X_tilde.germToFunctionField W).hom r = h⁻¹ →
          ∃ hW : W ≤ Ω_1,
            (X_tilde.presheaf.map (CategoryTheory.homOfLE hW).op).hom s_1 = r) ∧
        (∀ (h0 : Ω_0 ⊓ Ω_1 ≤ Ω_0) (h1 : Ω_0 ⊓ Ω_1 ≤ Ω_1),
          (X_tilde.presheaf.map (CategoryTheory.homOfLE h0).op).hom f_0 *
            (X_tilde.presheaf.map (CategoryTheory.homOfLE h1).op).hom s_1 = 1) ∧
        ((∃ x_pole : ↥X_tilde, x_pole ∉ Ω_0) →
          AlgebraicGeometry.IsAffineOpen Ω_0 ∧
          AlgebraicGeometry.IsAffineOpen Ω_1 ∧
          (Polynomial.eval₂RingHom
            (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
              p_tilde.appLE ⊤ Ω_0 le_top).hom) f_0).Finite ∧
          (Polynomial.eval₂RingHom
            (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
              p_tilde.appLE ⊤ Ω_1 le_top).hom) s_1).Finite)) ∧
    (∀ (V_tilde : X_tilde.Opens) (_ : AlgebraicGeometry.IsAffineOpen V_tilde)
        [Nonempty V_tilde]
        (t_tilde : ↑(X_tilde.presheaf.obj (Opposite.op V_tilde))),
      (∀ c : k₀,
        t_tilde - (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
          p_tilde.appLE ⊤ V_tilde le_top).hom c) ≠ 0) →
      ∃ (c₀ : k₀) (Ω_0 : X_tilde.Opens)
        (u_0 : ↑(X_tilde.presheaf.obj (Opposite.op Ω_0))),
        let τ_tilde := t_tilde -
          (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
            p_tilde.appLE ⊤ V_tilde le_top).hom c₀)
        (∃ x ∈ V_tilde, x ∉ X_tilde.basicOpen τ_tilde) ∧
        (Ω_0 : Set ↥X_tilde) = ((V_tilde : Set ↥X_tilde) \ (X_tilde.basicOpen τ_tilde : Set ↥X_tilde))ᶜ ∧
        AlgebraicGeometry.IsAffineOpen Ω_0 ∧
        Nonempty Ω_0 ∧
        (∀ (hB_V : X_tilde.basicOpen τ_tilde ≤ V_tilde)
            (hB_0 : X_tilde.basicOpen τ_tilde ≤ Ω_0),
          (X_tilde.presheaf.map (CategoryTheory.homOfLE hB_V).op).hom τ_tilde *
            (X_tilde.presheaf.map (CategoryTheory.homOfLE hB_0).op).hom u_0 = 1)) :=
by
  
  obtain ⟨hAffAll, cProjAll, tProjAll, hCoordAll, _⟩ :=
    weil_commRing_projectiveSpace_chart_and_baseChange_pkg.{u}
  have hCoord1 := hCoordAll k₀ 1
  
  obtain ⟨σ₀, _hσ₀⟩ := hSec₀
  have hTopNe : Nonempty (⊤ : X_tilde.Opens) :=
    ⟨⟨σ₀.base (⊥ : PrimeSpectrum k₀), trivial⟩⟩
  have : AlgebraicGeometry.IsProper p_tilde := hProp
  have hIntApp : (p_tilde.appTop).hom.IsIntegral :=
    AlgebraicGeometry.isIntegral_appTop_of_universallyClosed p_tilde
  let isoSpec := AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)
  have hInvSurj : Function.Surjective isoSpec.inv.hom := by
    intro y
    refine ⟨isoSpec.hom.hom y, ?_⟩
    change (isoSpec.hom ≫ isoSpec.inv).hom y = y
    rw [isoSpec.hom_inv_id]
    rfl
  have hHomBij : Function.Bijective isoSpec.hom.hom := by
    refine ⟨?_, ?_⟩
    · intro a b hab
      have h1 := congrArg isoSpec.inv.hom hab
      change (isoSpec.hom ≫ isoSpec.inv).hom a = (isoSpec.hom ≫ isoSpec.inv).hom b at h1
      simpa [isoSpec.hom_inv_id] using h1
    · intro x
      refine ⟨isoSpec.inv.hom x, ?_⟩
      change (isoSpec.inv ≫ isoSpec.hom).hom x = x
      rw [isoSpec.inv_hom_id]
      rfl
  let c_top : k₀ →+* ↑(X_tilde.presheaf.obj (Opposite.op ⊤)) :=
    (isoSpec.inv ≫ p_tilde.appTop).hom
  have hc_top_eq : c_top = (p_tilde.appTop).hom.comp isoSpec.inv.hom := rfl
  have hc_top_int : c_top.IsIntegral := by
    rw [hc_top_eq]
    exact RingHom.IsIntegral.trans _ _ (RingHom.isIntegral_of_surjective _ hInvSurj) hIntApp
  have hc_top_bij : Function.Bijective c_top :=
    IsAlgClosed.ringHom_bijective_of_isIntegral c_top hc_top_int
  have hAppTopBij : Function.Bijective (p_tilde.appTop).hom := by
    have hcomp : (p_tilde.appTop).hom = c_top.comp isoSpec.hom.hom := by
      ext y
      change (p_tilde.appTop).hom y = (isoSpec.inv ≫ p_tilde.appTop).hom (isoSpec.hom.hom y)
      change (p_tilde.appTop).hom y = ((isoSpec.hom ≫ isoSpec.inv) ≫ p_tilde.appTop).hom y
      rw [isoSpec.hom_inv_id, Category.id_comp]
    rw [hcomp]
    exact hc_top_bij.comp hHomBij
  have hInjCrit : ∀ (Ω : X_tilde.Opens) [Nonempty Ω]
      (f : ↑(X_tilde.presheaf.obj (Opposite.op Ω))),
      (∃ x_out : ↥X_tilde, x_out ∉ Ω) →
      (∀ (W : X_tilde.Opens) [Nonempty W] (s : ↑(X_tilde.presheaf.obj (Opposite.op W))),
        (X_tilde.germToFunctionField W).hom s = (X_tilde.germToFunctionField Ω).hom f →
        W ≤ Ω) →
      Function.Injective
        (Polynomial.eval₂RingHom
          (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
            p_tilde.appLE ⊤ Ω le_top).hom) f) := by
    intro Ω hΩ_ne f hOut hMax
    let c_Ω : k₀ →+* ↑(X_tilde.presheaf.obj (Opposite.op Ω)) :=
      (isoSpec.inv ≫ p_tilde.appLE ⊤ Ω le_top).hom
