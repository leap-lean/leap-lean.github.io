        refine ⟨hFin_ext.union (Set.finite_singleton d₀), ?_⟩
        have : Finite ↥(T ∩ R_ext) := hFin_ext.to_subtype
        let Θ : Option ↥(T ∩ R_ext) → ↥((T ∩ R_ext) ∪ {d₀}) := fun o =>
          match o with
          | none => ⟨d₀, Or.inr rfl⟩
          | some x => ⟨x.1, Or.inl x.2⟩
        have hΘ_surj : Function.Surjective Θ := by
          rintro ⟨z, hz | rfl⟩
          · exact ⟨some ⟨z, hz⟩, rfl⟩
          · exact ⟨none, rfl⟩
        calc
          Nat.card ↥((T ∩ R_ext) ∪ {d₀}) ≤ Nat.card (Option ↥(T ∩ R_ext)) :=
            Nat.card_le_card_of_surjective Θ hΘ_surj
          _ = Nat.card ↥(T ∩ R_ext) + 1 := Finite.card_option
          _ ≤ 2 := by omega
    · have hb2 : b_max = 2 := if_neg hSm
      have hCard_le2 : Nat.card ↥(T ∩ R_ext) ≤ 2 := by
        have hc : Nat.card ↥(T ∩ R_ext) ≤ b_max := hCard_ext
        omega
      have hEmpty : D₁ ∩ T = ∅ := by
        ext w
        exact ⟨fun hw => False.elim (hSm (hDT_sm w hw)), False.elim⟩
      rw [hEmpty, Set.union_empty]
      exact ⟨hFin_ext, hCard_le2⟩

theorem weil_birational_roof_surviving_p1_stabilization_and_fibers (K : Type u) [Field K]
    (m_rk : ℕ) (V : ValuationSubring K) (hPkg : IsValuationRingAlgPackage m_rk V)
    (hNorm : ∀ (W : AlgebraicGeometry.Scheme.{u})
        (g_W : W ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V)),
      IsStrictlySemistableCurveOverValuation V g_W →
      IsOverlapAffineNormalScheme W)
    (hOpenη : AlgebraicGeometry.IsOpenImmersion
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (P : Ideal ↥V) [P.IsPrime] (hP : P ≠ ⊥)
    (hFibAll : ∀ (Q : Ideal ↥V) [Q.IsPrime], Q ≠ ⊥ → HasStrictlySemistableResidueFiberGeom V Q)
    (C_K C' : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (g' : C' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (n : ℕ) (τ' : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C'))
    (ι' : C_K ⟶ C')
    (U_0 : C'.Opens)
    (hUK : Nonempty ↥((TopologicalSpace.Opens.map ι'.base).obj U_0))
    (ι_U0 : AlgebraicGeometry.Scheme.Opens.toScheme
      ((TopologicalSpace.Opens.map ι'.base).obj U_0) ⟶ U_0.toScheme)
    (Y C₁ C₂ : AlgebraicGeometry.Scheme.{u})
    (g_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (g₁ : C₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (g₂ : C₂ ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (f_Y : Y ⟶ U_0.toScheme)
    (q₂ : C₁ ⟶ Y)
    (p₂ : C₂ ⟶ Y)
    (r : C₂ ⟶ C₁)
    (τ_Y : ∀ j : Fin n,
      AlgebraicGeometry.Scheme.Opens.toScheme
        ((TopologicalSpace.Opens.map (τ' j).base).obj U_0) ⟶ Y)
    (τ₁ : ∀ j : Fin n,
      AlgebraicGeometry.Scheme.Opens.toScheme
        ((TopologicalSpace.Opens.map (τ' j).base).obj U_0) ⟶ C₁)
    (ι_Y : AlgebraicGeometry.Scheme.Opens.toScheme
      ((TopologicalSpace.Opens.map ι'.base).obj U_0) ⟶ Y)
    (ι₁ : AlgebraicGeometry.Scheme.Opens.toScheme
      ((TopologicalSpace.Opens.map ι'.base).obj U_0) ⟶ C₁)
    (hStab_Y : IsLocalRelativeStableMod V p_K g' n τ' ι' U_0 ι_U0 Y g_Y f_Y τ_Y ι_Y)
    (hSS₁ : IsStrictlySemistableCurveOverValuation V g₁)
    (hSS₂ : IsStrictlySemistableCurveOverValuation V g₂)
    (hNoeth_Y : TopologicalSpace.NoetherianSpace ↥Y)
    (hNoeth₁ : TopologicalSpace.NoetherianSpace ↥C₁)
    (hNoeth₂ : TopologicalSpace.NoetherianSpace ↥C₂)
    (hTow₂ : IsElementaryBlowupTower V g_Y g₂ p₂)
    (hProp_q₂ : AlgebraicGeometry.IsProper q₂)
    (hq₂_gY : q₂ ≫ g_Y = g₁)
    (hι₁_q₂ : ι₁ ≫ q₂ = ι_Y)
    (hPb₁ : CategoryTheory.IsPullback ι₁
      (AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj U_0) ≫ p_K)
      g₁
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (hr_q₂ : r ≫ q₂ = p₂)
    (hr_g₁ : r ≫ g₁ = g₂)
    (hSurj_r : AlgebraicGeometry.Surjective r)
    (hτ_g : ∀ j : Fin n,
      let S_j : (AlgebraicGeometry.Spec (CommRingCat.of ↥V)).Opens :=
        (TopologicalSpace.Opens.map (τ' j).base).obj U_0
      τ_Y j ≫ g_Y = S_j.ι ∧ τ₁ j ≫ g₁ = S_j.ι)
    (hτ_q₂ : ∀ j : Fin n, τ₁ j ≫ q₂ = τ_Y j) :
    let s_P := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V P.ResidueField))
    let F₁ := CategoryTheory.Limits.pullback g₁ s_P
    let F_Y := CategoryTheory.Limits.pullback g_Y s_P
    let fst₁ := CategoryTheory.Limits.pullback.fst g₁ s_P
    let fst_Y := CategoryTheory.Limits.pullback.fst g_Y s_P
    let snd₁ := CategoryTheory.Limits.pullback.snd g₁ s_P
    let snd_Y := CategoryTheory.Limits.pullback.snd g_Y s_P
    let D₁ : Set ↥F₁ := {w : ↥F₁ | ∃ j : Fin n, fst₁.base w ∈ Set.range (τ₁ j).base}
    ∀ (q₂_P : F₁ ⟶ F_Y),
      q₂_P ≫ fst_Y = fst₁ ≫ q₂ →
      q₂_P ≫ snd_Y = snd₁ →
      AlgebraicGeometry.Surjective q₂_P ∧
      (∀ y : ↥F_Y, _root_.IsConnected (q₂_P.base ⁻¹' ({y} : Set ↥F_Y))) ∧
      (∀ (E_set : Set ↥F₁) (E_sch : AlgebraicGeometry.Scheme.{u})
          (ιE : E_sch ⟶ F₁) (x₀_U : U_0.toScheme),
        E_set ∈ irreducibleComponents ↥F₁ →
        AlgebraicGeometry.IsClosedImmersion ιE →
        AlgebraicGeometry.IsIntegral E_sch →
        Set.range ιE.base = E_set →
        (∃ isoP1 : E_sch ≅ (weilProjectiveSpaceOver P.ResidueField 1).left,
          ιE ≫ snd₁ = isoP1.hom ≫ (weilProjectiveSpaceOver P.ResidueField 1).hom) →
        (∀ w ∈ E_set, f_Y.base (fst_Y.base (q₂_P.base w)) = x₀_U) →
        (∃ u₁ u₂ : ↥F_Y, u₁ ≠ u₂ ∧ u₁ ∈ q₂_P.base '' E_set ∧ u₂ ∈ q₂_P.base '' E_set) →
        q₂_P.base '' E_set ∈ irreducibleComponents ↥F_Y ∧
        Set.InjOn q₂_P.base E_set ∧
        (∀ E₂ ∈ irreducibleComponents ↥F₁,
          q₂_P.base '' E₂ = q₂_P.base '' E_set → E₂ = E_set) ∧
        ∃ q₁ q₂' q₃ : ↥F_Y,
          q₁ ≠ q₂' ∧ q₁ ≠ q₃ ∧ q₂' ≠ q₃ ∧
          q₁ ∈ q₂_P.base '' E_set ∧ q₂' ∈ q₂_P.base '' E_set ∧ q₃ ∈ q₂_P.base '' E_set ∧
          ∀ q ∈ ({q₁, q₂', q₃} : Set ↥F_Y),
            IsClosed (q₂_P.base ⁻¹' ({q} : Set ↥F_Y)) ∧
            ((∃ d ∈ D₁, q₂_P.base d = q) ∨
              (∃ H' ∈ irreducibleComponents ↥F₁,
                q₂_P.base '' H' ≠ q₂_P.base '' E_set ∧
                (∃ u₁ u₂ : ↥F_Y, u₁ ≠ u₂ ∧ u₁ ∈ q₂_P.base '' H' ∧ u₂ ∈ q₂_P.base '' H') ∧
                q ∈ q₂_P.base '' H'))) :=
by
  
  have hPillar1 :
      let s_P := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V P.ResidueField))
      let F₁ := CategoryTheory.Limits.pullback g₁ s_P
      let F_Y := CategoryTheory.Limits.pullback g_Y s_P
      let fst₁ := CategoryTheory.Limits.pullback.fst g₁ s_P
      let fst_Y := CategoryTheory.Limits.pullback.fst g_Y s_P
      let snd₁ := CategoryTheory.Limits.pullback.snd g₁ s_P
      let snd_Y := CategoryTheory.Limits.pullback.snd g_Y s_P
      ∀ (q₂_P : F₁ ⟶ F_Y),
        q₂_P ≫ fst_Y = fst₁ ≫ q₂ →
        q₂_P ≫ snd_Y = snd₁ →
        AlgebraicGeometry.Surjective q₂_P ∧
        ∀ y : ↥F_Y, _root_.IsConnected (q₂_P.base ⁻¹' ({y} : Set ↥F_Y)) := by
    intro s_P F₁ F_Y fst₁ fst_Y snd₁ snd_Y q₂_P hq₂P_fst hq₂P_snd
    have _ : TopologicalSpace.NoetherianSpace ↥Y := hNoeth_Y
    have _ : TopologicalSpace.NoetherianSpace ↥C₂ := hNoeth₂
    have hComp_Y : CompactSpace ↥Y := inferInstance
    have hComp₂ : CompactSpace ↥C₂ := inferInstance
    have hFibP : HasStrictlySemistableResidueFiberGeom V P := hFibAll P hP
    have hSS_Y : IsStrictlySemistableCurveOverValuation V g_Y := hStab_Y.1
    have hConnComp : ∀ {A B C : AlgebraicGeometry.Scheme.{u}}
        (f : A ⟶ B) (g : B ⟶ C),
        IsClosedMap f.base →
        (∀ b : B, _root_.IsConnected (f.base ⁻¹' ({b} : Set B))) →
        (∀ c : C, _root_.IsConnected (g.base ⁻¹' ({c} : Set C))) →
        ∀ c : C, _root_.IsConnected ((f ≫ g).base ⁻¹' ({c} : Set C)) := by
      intro A B C f g hClMap hConn_f hConn_g c
      let T : Set B := g.base ⁻¹' ({c} : Set C)
      let S : Set A := (f ≫ g).base ⁻¹' ({c} : Set C)
      refine ⟨?_, ?_⟩
      · obtain ⟨b0, hb0⟩ := (hConn_g c).1
        obtain ⟨a0, ha0⟩ := (hConn_f b0).1
        refine ⟨a0, ?_⟩
        change g.base (f.base a0) = c
        have hfb : f.base a0 = b0 := ha0
        rw [hfb]; exact hb0
      · intro U W hU hW hSUW ⟨a1, ha1S, ha1U⟩ ⟨a2, ha2S, ha2W⟩
        by_contra hDisj
        let UB : Set B := (f.base '' Uᶜ)ᶜ
        let WB : Set B := (f.base '' Wᶜ)ᶜ
        have hUB_open : IsOpen UB := (hClMap Uᶜ hU.isClosed_compl).isOpen_compl
        have hWB_open : IsOpen WB := (hClMap Wᶜ hW.isClosed_compl).isOpen_compl
        have hMemUB : ∀ b : B, b ∈ UB ↔ f.base ⁻¹' ({b} : Set B) ⊆ U := by
          intro b
          exact ⟨fun hb a ha => by by_contra haU; exact hb ⟨a, haU, ha⟩,
            by rintro hsub ⟨a, haU, rfl⟩; exact haU (hsub rfl)⟩
        have hMemWB : ∀ b : B, b ∈ WB ↔ f.base ⁻¹' ({b} : Set B) ⊆ W := by
          intro b
          exact ⟨fun hb a ha => by by_contra haW; exact hb ⟨a, haW, ha⟩,
            by rintro hsub ⟨a, haW, rfl⟩; exact haW (hsub rfl)⟩
        have hT_sub : T ⊆ UB ∪ WB := by
          intro b hbT
          by_contra hNot
          have hbU : ¬ f.base ⁻¹' ({b} : Set B) ⊆ U := fun h => hNot (Or.inl ((hMemUB b).mpr h))
          have hbW : ¬ f.base ⁻¹' ({b} : Set B) ⊆ W := fun h => hNot (Or.inr ((hMemWB b).mpr h))
          obtain ⟨x1, hx1b, hx1notU⟩ := Set.not_subset.mp hbU
          obtain ⟨x2, hx2b, hx2notW⟩ := Set.not_subset.mp hbW
          have hx1S : x1 ∈ S := by
            change g.base (f.base x1) = c
            have hfx1 : f.base x1 = b := hx1b
            rw [hfx1]; exact hbT
          have hx2S : x2 ∈ S := by
            change g.base (f.base x2) = c
            have hfx2 : f.base x2 = b := hx2b
            rw [hfx2]; exact hbT
          have hx1W : x1 ∈ W := (hSUW hx1S).resolve_left hx1notU
          have hx2U : x2 ∈ U := (hSUW hx2S).resolve_right hx2notW
          obtain ⟨x3, hx3b, hx3UW⟩ :=
            (hConn_f b).2 U W hU hW
              (fun x hx => hSUW (by
                change g.base (f.base x) = c
                have hfx : f.base x = b := hx
                rw [hfx]; exact hbT))
              ⟨x2, hx2b, hx2U⟩ ⟨x1, hx1b, hx1W⟩
          have hx3S : x3 ∈ S := by
            change g.base (f.base x3) = c
            have hfx3 : f.base x3 = b := hx3b
            rw [hfx3]; exact hbT
          exact hDisj ⟨x3, hx3S, hx3UW⟩
        have hb1T : f.base a1 ∈ T := ha1S
        have hb1UB : f.base a1 ∈ UB :=
          (hT_sub hb1T).resolve_right fun h => hDisj ⟨a1, ha1S, ha1U, (hMemWB (f.base a1)).mp h rfl⟩
        have hb2T : f.base a2 ∈ T := ha2S
        have hb2WB : f.base a2 ∈ WB :=
          (hT_sub hb2T).resolve_left fun h => hDisj ⟨a2, ha2S, (hMemUB (f.base a2)).mp h rfl, ha2W⟩
        obtain ⟨b_star, hb_starT, hb_starUB, hb_starWB⟩ :=
          (hConn_g c).2 UB WB hUB_open hWB_open hT_sub
            ⟨f.base a1, hb1T, hb1UB⟩ ⟨f.base a2, hb2T, hb2WB⟩
        obtain ⟨a_star, ha_star⟩ := (hConn_f b_star).1
        have ha_starS : a_star ∈ S := by
          change g.base (f.base a_star) = c
          have hfa : f.base a_star = b_star := ha_star
          rw [hfa]; exact hb_starT
        exact hDisj ⟨a_star, ha_starS,
          (hMemUB b_star).mp hb_starUB ha_star,
          (hMemWB b_star).mp hb_starWB ha_star⟩
    have hIsoFib : ∀ {A B : AlgebraicGeometry.Scheme.{u}} (e : A ≅ B),
        IsClosedMap e.hom.base ∧ ∀ b : B, _root_.IsConnected (e.hom.base ⁻¹' ({b} : Set B)) := by
      intro A B e
      refine ⟨e.hom.isClosedMap, fun b => ?_⟩
      have hEq : e.hom.base ⁻¹' ({b} : Set B) = {e.inv.base b} := by
        ext a
        simp only [Set.mem_preimage, Set.mem_singleton_iff]
        refine ⟨fun h => ?_, ?_⟩
        · rw [← h]; change a = (e.hom ≫ e.inv).base a; rw [e.hom_inv_id]; rfl
        · rintro rfl; change (e.inv ≫ e.hom).base b = b; rw [e.inv_hom_id]; rfl
      rw [hEq]
      exact isConnected_singleton
    obtain ⟨N, Cseq, gseq, fstep, ptow, e₀, eN, he₀_ptow, he₀_g, hsteps, heN_g, heN_p⟩ := hTow₂
    have hSeq : ∀ i : Fin (N + 1),
        ptow i ≫ g_Y = gseq i ∧ ∀ z : Y, _root_.IsConnected ((ptow i).base ⁻¹' ({z} : Set Y)) := by
      intro i
      induction i using Fin.induction with
      | zero =>
        rw [← he₀_ptow]
        exact ⟨he₀_g, (hIsoFib e₀).2⟩
      | succ i ih =>
        obtain ⟨hStep_i, hptow_succ⟩ := hsteps i
        rw [hptow_succ]
        refine ⟨by rw [Category.assoc, ih.1, hStep_i.2.2.1], ?_⟩
        have _ : AlgebraicGeometry.IsProper (fstep i) := hStep_i.2.1
        exact hConnComp (fstep i) (ptow i.castSucc) (fstep i).isClosedMap hStep_i.2.2.2.1 ih.2
    obtain ⟨hLast_g, hLast_conn⟩ := hSeq (Fin.last N)
    have hp₂_gY : p₂ ≫ g_Y = g₂ := by
      rw [← heN_p, Category.assoc, hLast_g, heN_g]
    have hConn_p₂ : ∀ y_Y : ↥Y, _root_.IsConnected (p₂.base ⁻¹' ({y_Y} : Set ↥Y)) := by
      rw [← heN_p]
      exact hConnComp eN.hom (ptow (Fin.last N)) (hIsoFib eN).1 (hIsoFib eN).2 hLast_conn
    let F₂ := CategoryTheory.Limits.pullback g₂ s_P
    let fst₂ := CategoryTheory.Limits.pullback.fst g₂ s_P
    let snd₂ := CategoryTheory.Limits.pullback.snd g₂ s_P
    let p₂_P : F₂ ⟶ F_Y :=
      CategoryTheory.Limits.pullback.lift (fst₂ ≫ p₂) snd₂
        (by rw [Category.assoc, hp₂_gY, CategoryTheory.Limits.pullback.condition])
    let r_P : F₂ ⟶ F₁ :=
      CategoryTheory.Limits.pullback.lift (fst₂ ≫ r) snd₂
        (by rw [Category.assoc, hr_g₁, CategoryTheory.Limits.pullback.condition])
    have hrP_q₂P : r_P ≫ q₂_P = p₂_P := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [Category.assoc, hq₂P_fst, ← Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          Category.assoc, hr_q₂, CategoryTheory.Limits.pullback.lift_fst]
      · rw [Category.assoc, hq₂P_snd, CategoryTheory.Limits.pullback.lift_snd,
          CategoryTheory.Limits.pullback.lift_snd]
    have hPb_rP : CategoryTheory.IsPullback fst₂ r_P r fst₁ := by
      refine (CategoryTheory.IsPullback.paste_vert_iff
        (CategoryTheory.IsPullback.of_hasPullback g₁ s_P)
        (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm).mp ?_
      rw [CategoryTheory.Limits.pullback.lift_snd, hr_g₁]
      exact CategoryTheory.IsPullback.of_hasPullback g₂ s_P
    have _ : AlgebraicGeometry.Surjective r_P :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (P := @AlgebraicGeometry.Surjective) hPb_rP hSurj_r
    have hFibY := hFibP Y g_Y hSS_Y hComp_Y
    have hFib2 := hFibP C₂ g₂ hSS₂ hComp₂
    have _ : AlgebraicGeometry.IsPreimmersion fst_Y := hFibY.1
    have _ : AlgebraicGeometry.IsPreimmersion fst₂ := hFib2.1
    have hConn_q₂P : ∀ y : ↥F_Y, _root_.IsConnected (q₂_P.base ⁻¹' ({y} : Set ↥F_Y)) := by
      intro y
      let y_Y : ↥Y := fst_Y.base y
      have hyY_P : (g_Y.base y_Y).asIdeal = P := by
        have hm : y_Y ∈ Set.range fst_Y.base := ⟨y, rfl⟩
        rw [hFibY.2.1] at hm
        exact hm
      have hEq_p₂ : fst₂.base '' (p₂_P.base ⁻¹' ({y} : Set ↥F_Y)) = p₂.base ⁻¹' ({y_Y} : Set ↥Y) := by
        ext z₂
        simp only [Set.mem_image, Set.mem_preimage, Set.mem_singleton_iff]
        refine ⟨?_, ?_⟩
        · rintro ⟨w₂, hw₂, rfl⟩
          have hp₂P_fst : p₂_P ≫ fst_Y = fst₂ ≫ p₂ :=
            CategoryTheory.Limits.pullback.lift_fst _ _ _
          change (fst₂ ≫ p₂).base w₂ = fst_Y.base y
          rw [← hp₂P_fst]
          change fst_Y.base (p₂_P.base w₂) = fst_Y.base y
          rw [hw₂]
        · intro hz₂
          have hz₂_range : z₂ ∈ Set.range fst₂.base := by
            rw [hFib2.2.1]
            change (g₂.base z₂).asIdeal = P
            have h1 : g₂.base z₂ = g_Y.base (p₂.base z₂) := by rw [← hp₂_gY]; rfl
            rw [h1, hz₂, hyY_P]
          obtain ⟨w₂, rfl⟩ := hz₂_range
          refine ⟨w₂, ?_, rfl⟩
          apply fst_Y.isEmbedding.injective
          change (p₂_P ≫ fst_Y).base w₂ = y_Y
          rw [CategoryTheory.Limits.pullback.lift_fst]
          exact hz₂
      have hConn_im : _root_.IsConnected (fst₂.base '' (p₂_P.base ⁻¹' ({y} : Set ↥F_Y))) := by
        rw [hEq_p₂]; exact hConn_p₂ y_Y
      have hConn_p₂P : _root_.IsConnected (p₂_P.base ⁻¹' ({y} : Set ↥F_Y)) := by
        rw [isConnected_iff_connectedSpace] at hConn_im ⊢
        exact (fst₂.isEmbedding.homeomorphImage (p₂_P.base ⁻¹' ({y} : Set ↥F_Y))).connectedSpace_iff.mpr
          hConn_im
      have hIm_rP : r_P.base '' (p₂_P.base ⁻¹' ({y} : Set ↥F_Y)) = q₂_P.base ⁻¹' ({y} : Set ↥F_Y) := by
        ext w₁
        simp only [Set.mem_image, Set.mem_preimage, Set.mem_singleton_iff]
        refine ⟨?_, ?_⟩
        · rintro ⟨w₂, hw₂, rfl⟩
          rw [← hw₂, ← hrP_q₂P]; rfl
        · intro hw₁
          obtain ⟨w₂, hw₂⟩ := r_P.surjective w₁
          refine ⟨w₂, ?_, hw₂⟩
          have hcomp : p₂_P.base w₂ = q₂_P.base (r_P.base w₂) := by rw [← hrP_q₂P]; rfl
          rw [hcomp, hw₂, hw₁]
      rw [← hIm_rP]
      exact hConn_p₂P.image r_P.base r_P.continuous.continuousOn
    exact ⟨⟨fun y => (hConn_q₂P y).1⟩, hConn_q₂P⟩
  
  have hPillar2 :
