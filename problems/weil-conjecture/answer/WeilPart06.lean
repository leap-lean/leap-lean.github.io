        (ι₀ : AlgebraicGeometry.Spec (CommRingCat.of C₀) ⟶ M)
        (ι₁ : AlgebraicGeometry.Spec (CommRingCat.of C₁) ⟶ M)
        (hOpen₀ : AlgebraicGeometry.IsOpenImmersion ι₀)
        (hOpen₁ : AlgebraicGeometry.IsOpenImmersion ι₁),
        letI : AlgebraicGeometry.IsOpenImmersion ι₀ := hOpen₀
        letI : AlgebraicGeometry.IsOpenImmersion ι₁ := hOpen₁
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₀₁) ≫ ι₀ =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap C₁ C₀₁)) ≫ ι₁ ∧
        ι₀.opensRange ⊔ ι₁.opensRange = ⊤ ∧
        (∀ (X : AlgebraicGeometry.Scheme.{u})
            (m₀ : AlgebraicGeometry.Spec (CommRingCat.of C₀) ⟶ X)
            (m₁ : AlgebraicGeometry.Spec (CommRingCat.of C₁) ⟶ X),
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₀₁) ≫ m₀ =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap C₁ C₀₁)) ≫ m₁ →
          ∃ g : M ⟶ X, ι₀ ≫ g = m₀ ∧ ι₁ ≫ g = m₁) ∧
        (∀ (X : AlgebraicGeometry.Scheme.{u}) (g₁ g₂ : M ⟶ X),
          ι₀ ≫ g₁ = ι₀ ≫ g₂ → ι₁ ≫ g₁ = ι₁ ≫ g₂ → g₁ = g₂) := by
    let S₀ : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of C₀)
    let S₁ : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of C₁)
    let S₀₁ : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of C₀₁)
    let j₀₁ : S₀₁ ⟶ S₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₀₁)
    let j₁₀ : S₀₁ ⟶ S₁ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap C₁ C₀₁))
    have hj₀₁_open : AlgebraicGeometry.IsOpenImmersion j₀₁ := by
      let _ : Algebra C₀ C₀₁ := f₀₁.toAlgebra
      have _ : IsLocalization.Away s₀ C₀₁ := hloc₀
      exact AlgebraicGeometry.IsOpenImmersion.of_isLocalization s₀
    have hj₁₀_open : AlgebraicGeometry.IsOpenImmersion j₁₀ :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization t₁
    let J : Type u := ULift.{u} Bool
    let i₀ : J := ULift.up false
    let i₁ : J := ULift.up true
    have h₀₁ : i₀ ≠ i₁ := fun h => Bool.noConfusion (ULift.up.inj h)
    have h₁₀ : i₁ ≠ i₀ := h₀₁.symm
    let D' : CategoryTheory.GlueData' AlgebraicGeometry.Scheme.{u} :=
      { J := J
        U := ULift.rec (Bool.rec S₀ S₁)
        V := fun _ _ _ => S₀₁
        f := fun i j =>
          ULift.rec
            (Bool.rec
              (ULift.rec (Bool.rec (fun h => False.elim (h rfl)) (fun _ => j₀₁)) j)
              (ULift.rec (Bool.rec (fun _ => j₁₀) (fun h => False.elim (h rfl))) j)) i
        f_mono := by
          rintro ⟨_ | _⟩ ⟨_ | _⟩ h
          · exact False.elim (h rfl)
          · dsimp; infer_instance
          · dsimp; infer_instance
          · exact False.elim (h rfl)
        f_hasPullback := fun _ _ _ _ _ => inferInstance
