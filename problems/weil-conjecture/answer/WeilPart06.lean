          rw [hsplit, map_mul, map_mul, ← hAB_i i]
          ring
        rw [hsum_eq]
        have hM_sum : (∑ i ∈ Finset.range (N + 1), (M.coeff i).1 * (W_target.subtype t_div) ^ i) = 0 := by
          rw [Polynomial.eval₂_eq_sum_range] at hM_ev
          exact hM_ev
        rw [hM_sum, mul_zero]

    have hLiftψ_Open : ∀ (W_et : X.Opens), z ∈ W_et →
        ∃ ψ_W : AlgebraicGeometry.Spec (CommRingCat.of ↥W_target) ⟶ W_et.toScheme,
          ψ_W ≫ W_et.ι = ψ_X := by
      intro W_et hz_Wet
      have hmW_eq : mW = IsLocalRing.closedPoint ↥W_target := PrimeSpectrum.ext hmW
      have hRange : Set.range ψ_X.base ⊆ Set.range W_et.ι.base := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        rintro _ ⟨q, rfl⟩
        have hspec : q ⤳ mW := by rw [hmW_eq]; exact IsLocalRing.specializes_closedPoint q
        exact (hspec.map ψ_X.continuous).mem_open W_et.isOpen hz_Wet
      exact ⟨AlgebraicGeometry.IsOpenImmersion.lift W_et.ι ψ_X hRange,
        AlgebraicGeometry.IsOpenImmersion.lift_fac W_et.ι ψ_X hRange⟩

    refine ⟨⟨hPz_eq, hComap_θ, hθ_ne⟩, ?_, ?_, ?_⟩
    · by_cases hRes : IsValResolvedOnMod V g_Z p_X η_X W_target
      · exact Or.inl hRes
      · right
        let u₀ := ψ_Z.base mW
        have hpz_u0 : p_X.base z = u₀ := by
          change (ψ_X ≫ p_X).base mW = ψ_Z.base mW
          rw [hψX_pX]
        obtain ⟨V_u0, hVu0, hu0_Vu0, _⟩ :=
          AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := u₀) (U := ⊤) trivial
        let A_u0 := ↑(Z.presheaf.obj (Opposite.op V_u0))
        let q_u0 : PrimeSpectrum A_u0 := hVu0.primeIdealOf ⟨u₀, hu0_Vu0⟩
        have hqu0_eq : hVu0.fromSpec.base q_u0 = u₀ :=
          AlgebraicGeometry.IsAffineOpen.fromSpec_primeIdealOf hVu0 ⟨u₀, hu0_Vu0⟩
        have hCl_qu0 : IsClosed ({q_u0} : Set (PrimeSpectrum A_u0)) := by
          have hpre : hVu0.fromSpec.base ⁻¹' ({u₀} : Set Z) = ({q_u0} : Set (PrimeSpectrum A_u0)) := by
            ext q
            simp only [Set.mem_preimage, Set.mem_singleton_iff]
            exact ⟨fun h => hVu0.fromSpec.isOpenEmbedding.injective (h.trans hqu0_eq.symm),
              fun h => by rw [h, hqu0_eq]⟩
          rw [← hpre]
          exact hCl_u0.preimage hVu0.fromSpec.continuous
        have hMax_qu0 : q_u0.asIdeal.IsMaximal :=
          (PrimeSpectrum.isClosed_singleton_iff_isMaximal q_u0).mp hCl_qu0
        let _ : Field (A_u0 ⧸ q_u0.asIdeal) := Ideal.Quotient.field q_u0.asIdeal
        suffices hcl_sub : closure ({z} : Set X) ⊆ {z} by
          have h_eq : closure ({z} : Set X) = {z} :=
            Set.Subset.antisymm hcl_sub subset_closure
          rw [← h_eq]
          exact isClosed_closure
        intro y hy_cl
        have hy_u0 : p_X.base y = u₀ := by
          have h1 : p_X.base y ∈ closure (p_X.base '' ({z} : Set X)) :=
            mem_closure_image p_X.continuous.continuousAt hy_cl
          rw [Set.image_singleton, hpz_u0, hCl_u0.closure_eq] at h1
          exact h1
        have hy_pVu0 : y ∈ (TopologicalSpace.Opens.map p_X.base).obj V_u0 := by
          change p_X.base y ∈ V_u0
          rw [hy_u0]; exact hu0_Vu0
        obtain ⟨U_y, hUy, hy_Uy, hUy_sub⟩ :=
          AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
            (x := y) (U := (TopologicalSpace.Opens.map p_X.base).obj V_u0) hy_pVu0
        have hUy_le : U_y ≤ (TopologicalSpace.Opens.map p_X.base).obj V_u0 := hUy_sub
        have hz_Uy : z ∈ U_y := by
          obtain ⟨_, hw_Uy, hw_z⟩ := mem_closure_iff.mp hy_cl (U_y : Set X) U_y.isOpen hy_Uy
          rw [Set.mem_singleton_iff] at hw_z
          rwa [← hw_z]
        let B_y := ↑(X.presheaf.obj (Opposite.op U_y))
        let q_z : PrimeSpectrum B_y := hUy.primeIdealOf ⟨z, hz_Uy⟩
        let q_y : PrimeSpectrum B_y := hUy.primeIdealOf ⟨y, hy_Uy⟩
        have hqz_eq : hUy.fromSpec.base q_z = z :=
          AlgebraicGeometry.IsAffineOpen.fromSpec_primeIdealOf hUy ⟨z, hz_Uy⟩
        have hqy_eq : hUy.fromSpec.base q_y = y :=
          AlgebraicGeometry.IsAffineOpen.fromSpec_primeIdealOf hUy ⟨y, hy_Uy⟩
        have hqz_le_qy : q_z.asIdeal ≤ q_y.asIdeal := by
          change q_z ≤ q_y
          rw [PrimeSpectrum.le_iff_specializes]
          apply hUy.fromSpec.isOpenEmbedding.isInducing.specializes_iff.mp
          rw [hqz_eq, hqy_eq]
          exact specializes_iff_mem_closure.mpr hy_cl
        have hmW_eq : mW = IsLocalRing.closedPoint ↥W_target := PrimeSpectrum.ext hmW
        have hRange_ψUy : Set.range ψ_X.base ⊆ Set.range hUy.fromSpec.base := by
          rw [AlgebraicGeometry.IsAffineOpen.range_fromSpec hUy]
          rintro _ ⟨q, rfl⟩
          have hspec : q ⤳ mW := by rw [hmW_eq]; exact IsLocalRing.specializes_closedPoint q
          exact (hspec.map ψ_X.continuous).mem_open U_y.isOpen hz_Uy
        let l_Uy := AlgebraicGeometry.IsOpenImmersion.lift hUy.fromSpec ψ_X hRange_ψUy
        let φ_By : X.presheaf.obj (Opposite.op U_y) ⟶ CommRingCat.of ↥W_target :=
          AlgebraicGeometry.Spec.preimage l_Uy
        have hφBy_spec : AlgebraicGeometry.Spec.map φ_By ≫ hUy.fromSpec = ψ_X := by
          rw [AlgebraicGeometry.Spec.map_preimage]
          exact AlgebraicGeometry.IsOpenImmersion.lift_fac hUy.fromSpec ψ_X hRange_ψUy
        have hqz_comap_W : q_z.asIdeal =
            Ideal.comap φ_By.hom (IsLocalRing.maximalIdeal ↥W_target) := by
          rw [← hmW]
          have hpt : (AlgebraicGeometry.Spec.map φ_By).base mW = q_z := by
            apply hUy.fromSpec.isOpenEmbedding.injective
            change (AlgebraicGeometry.Spec.map φ_By ≫ hUy.fromSpec).base mW = _
            rw [hφBy_spec, hqz_eq]
          exact (congrArg PrimeSpectrum.asIdeal hpt).symm
        let res_W := IsLocalRing.residue ↥W_target
        have hker_resBy : RingHom.ker (res_W.comp φ_By.hom) = q_z.asIdeal := by
          ext b
          change res_W (φ_By.hom b) = 0 ↔ b ∈ q_z.asIdeal
          rw [IsLocalRing.residue_eq_zero_iff, hqz_comap_W, Ideal.mem_comap]
        let ι_qz : (B_y ⧸ q_z.asIdeal) →+* IsLocalRing.ResidueField ↥W_target :=
          Ideal.Quotient.lift q_z.asIdeal (res_W.comp φ_By.hom) (le_of_eq hker_resBy.symm)
        have hInj_ιqz : Function.Injective ι_qz := by
          intro x₁ x₂ hx
          obtain ⟨b₁, rfl⟩ := Ideal.Quotient.mk_surjective x₁
          obtain ⟨b₂, rfl⟩ := Ideal.Quotient.mk_surjective x₂
          rw [Ideal.Quotient.eq]
          have hsub : res_W (φ_By.hom (b₁ - b₂)) = 0 := by
            rw [map_sub, map_sub, sub_eq_zero]
            exact hx
          rw [← RingHom.comp_apply res_W φ_By.hom, ← RingHom.mem_ker, hker_resBy] at hsub
          exact hsub
        let p_Au0_By : A_u0 →+* B_y := (p_X.appLE V_u0 U_y hUy_le).hom
        have hcomap_qu0 : Ideal.comap p_Au0_By q_z.asIdeal = q_u0.asIdeal := by
          have hpt : (AlgebraicGeometry.Spec.map (p_X.appLE V_u0 U_y hUy_le)).base q_z = q_u0 := by
            apply hVu0.fromSpec.isOpenEmbedding.injective
            change (AlgebraicGeometry.Spec.map (p_X.appLE V_u0 U_y hUy_le) ≫ hVu0.fromSpec).base q_z = _
            rw [AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec p_X hVu0 hUy hUy_le]
            change p_X.base (hUy.fromSpec.base q_z) = _
            rw [hqz_eq, hpz_u0, hqu0_eq]
          exact congrArg PrimeSpectrum.asIdeal hpt
        let j_Fu0' : (A_u0 ⧸ q_u0.asIdeal) →+* (B_y ⧸ q_z.asIdeal) :=
          Ideal.Quotient.lift q_u0.asIdeal ((Ideal.Quotient.mk q_z.asIdeal).comp p_Au0_By)
            (fun a ha => by
              simp only [RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem]
              rw [← hcomap_qu0] at ha
              exact ha)
        let φ_V_Au0 : ↥V →+* A_u0 := (AlgebraicGeometry.Spec.preimage (hVu0.fromSpec ≫ g_Z)).hom
        have hθ_Au0 : φ_By.hom.comp (p_Au0_By.comp φ_V_Au0) = θ_V := by
          have h1 : AlgebraicGeometry.Spec.map φ_By ≫
              AlgebraicGeometry.Spec.map (p_X.appLE V_u0 U_y hUy_le) ≫
              hVu0.fromSpec ≫ g_Z = ψ_X ≫ g_X := by
            rw [← Category.assoc (AlgebraicGeometry.Spec.map (p_X.appLE V_u0 U_y hUy_le)),
              AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec p_X hVu0 hUy hUy_le,
              Category.assoc hUy.fromSpec p_X g_Z,
              ← Category.assoc (AlgebraicGeometry.Spec.map φ_By), hφBy_spec, hpX_gZ]
          change (AlgebraicGeometry.Spec.preimage (hVu0.fromSpec ≫ g_Z) ≫
              p_X.appLE V_u0 U_y hUy_le ≫ φ_By).hom = _
          rw [← AlgebraicGeometry.Spec.preimage_map φ_By,
            ← AlgebraicGeometry.Spec.preimage_map (p_X.appLE V_u0 U_y hUy_le),
            ← AlgebraicGeometry.Spec.preimage_comp, ← AlgebraicGeometry.Spec.preimage_comp,
            Category.assoc, h1]
        have hComap_VAu0 : Ideal.comap φ_V_Au0 q_u0.asIdeal = P_z := by
          ext v
          change φ_V_Au0 v ∈ q_u0.asIdeal ↔ v ∈ P_z
          rw [← hcomap_qu0, Ideal.mem_comap, hqz_comap_W, Ideal.mem_comap, ← hComap_θ, Ideal.mem_comap]
          have hv : φ_By.hom (p_Au0_By (φ_V_Au0 v)) = θ_V v :=
            congrFun (congrArg DFunLike.coe hθ_Au0) v
          rw [hv]
        let k₀ : Subfield (IsLocalRing.ResidueField ↥W_target) :=
          { carrier := {w | ∃ a s : ↥V, s ∉ P_z ∧ w * res_W (θ_V s) = res_W (θ_V a)}
            mul_mem' := by
              rintro w₁ w₂ ⟨a₁, s₁, hs₁, h₁⟩ ⟨a₂, s₂, hs₂, h₂⟩
              refine ⟨a₁ * a₂, s₁ * s₂,
                fun h => (hPz_prime.mul_mem_iff_mem_or_mem.mp h).elim hs₁ hs₂, ?_⟩
              rw [map_mul, map_mul, map_mul, map_mul]
              calc (w₁ * w₂) * (res_W (θ_V s₁) * res_W (θ_V s₂))
                  = (w₁ * res_W (θ_V s₁)) * (w₂ * res_W (θ_V s₂)) := by ring
                _ = res_W (θ_V a₁) * res_W (θ_V a₂) := by rw [h₁, h₂]
            one_mem' := ⟨1, 1, hPz_prime.one_notMem, by simp⟩
            add_mem' := by
              rintro w₁ w₂ ⟨a₁, s₁, hs₁, h₁⟩ ⟨a₂, s₂, hs₂, h₂⟩
              refine ⟨a₁ * s₂ + a₂ * s₁, s₁ * s₂,
                fun h => (hPz_prime.mul_mem_iff_mem_or_mem.mp h).elim hs₁ hs₂, ?_⟩
              simp only [map_add, map_mul]
              calc (w₁ + w₂) * (res_W (θ_V s₁) * res_W (θ_V s₂))
                  = (w₁ * res_W (θ_V s₁)) * res_W (θ_V s₂) +
                    (w₂ * res_W (θ_V s₂)) * res_W (θ_V s₁) := by ring
                _ = res_W (θ_V a₁) * res_W (θ_V s₂) + res_W (θ_V a₂) * res_W (θ_V s₁) := by
                  rw [h₁, h₂]
            zero_mem' := ⟨0, 1, hPz_prime.one_notMem, by simp⟩
            neg_mem' := by
              rintro w₁ ⟨a₁, s₁, hs₁, h₁⟩
              exact ⟨-a₁, s₁, hs₁, by rw [map_neg, map_neg, neg_mul, h₁]⟩
            inv_mem' := by
              rintro w ⟨a₁, s₁, hs₁, h₁⟩
              by_cases hw : w = 0
              · rw [hw, inv_zero]; exact ⟨0, 1, hPz_prime.one_notMem, by simp⟩
              · have hrs₁ : res_W (θ_V s₁) ≠ 0 := by
                  rw [Ne, IsLocalRing.residue_eq_zero_iff, ← Ideal.mem_comap, hComap_θ]
                  exact hs₁
                have hra₁ : res_W (θ_V a₁) ≠ 0 := by rw [← h₁]; exact mul_ne_zero hw hrs₁
                have ha₁ : a₁ ∉ P_z := by
                  rw [← hComap_θ, Ideal.mem_comap, ← IsLocalRing.residue_eq_zero_iff]
                  exact hra₁
                refine ⟨s₁, a₁, ha₁, ?_⟩
                apply mul_left_cancel₀ hw
                calc w * (w⁻¹ * res_W (θ_V a₁))
                    = (w * w⁻¹) * (w * res_W (θ_V s₁)) := by rw [h₁]; ring
                  _ = w * res_W (θ_V s₁) := by rw [mul_inv_cancel₀ hw, one_mul] }
        have hk0_in_By : ∀ w : ↥k₀, ∃ b : B_y ⧸ q_z.asIdeal, ι_qz b = w.1 := by
          rintro ⟨w, a, s, hs, hw_eq⟩
          let u_s : A_u0 ⧸ q_u0.asIdeal := Ideal.Quotient.mk q_u0.asIdeal (φ_V_Au0 s)
          have hus_ne : u_s ≠ 0 := by
            rw [Ne, Ideal.Quotient.eq_zero_iff_mem, ← Ideal.mem_comap, hComap_VAu0]
            exact hs
          have hrs_ne : res_W (θ_V s) ≠ 0 := by
            rw [Ne, IsLocalRing.residue_eq_zero_iff, ← Ideal.mem_comap, hComap_θ]
            exact hs
          let b : B_y ⧸ q_z.asIdeal :=
            j_Fu0' (Ideal.Quotient.mk q_u0.asIdeal (φ_V_Au0 a) * u_s⁻¹)
          refine ⟨b, ?_⟩
          apply mul_right_cancel₀ hrs_ne
          have h_im : ∀ c : ↥V, ι_qz (j_Fu0' (Ideal.Quotient.mk q_u0.asIdeal (φ_V_Au0 c))) =
              res_W (θ_V c) := by
            intro c
            change res_W (φ_By.hom (p_Au0_By (φ_V_Au0 c))) = res_W (θ_V c)
            exact congrArg res_W (congrFun (congrArg DFunLike.coe hθ_Au0) c)
          calc ι_qz b * res_W (θ_V s)
              = ι_qz (j_Fu0' (Ideal.Quotient.mk q_u0.asIdeal (φ_V_Au0 a) * (u_s⁻¹ * u_s))) := by
                rw [← mul_assoc, map_mul, map_mul, h_im s]
            _ = ι_qz (j_Fu0' (Ideal.Quotient.mk q_u0.asIdeal (φ_V_Au0 a))) := by
                rw [inv_mul_cancel₀ hus_ne, mul_one]
            _ = res_W (θ_V a) := h_im a
            _ = w * res_W (θ_V s) := hw_eq.symm
        choose j_k0_fun hj_k0 using hk0_in_By
        let j_k0 : ↥k₀ →+* (B_y ⧸ q_z.asIdeal) :=
          { toFun := j_k0_fun
            map_one' := hInj_ιqz (by rw [hj_k0, map_one, OneMemClass.coe_one])
            map_mul' := fun x y => hInj_ιqz (by rw [hj_k0, map_mul, hj_k0, hj_k0, MulMemClass.coe_mul])
            map_zero' := hInj_ιqz (by rw [hj_k0, map_zero, ZeroMemClass.coe_zero])
            map_add' := fun x y => hInj_ιqz (by rw [hj_k0, map_add, hj_k0, hj_k0, AddMemClass.coe_add]) }
        let _ : Algebra ↥k₀ (B_y ⧸ q_z.asIdeal) := j_k0.toAlgebra
        have hInj_jk0 : Function.Injective (algebraMap ↥k₀ (B_y ⧸ q_z.asIdeal)) := j_k0.injective
        let ρ_k0 : ↥V →+* ↥k₀ :=
          { toFun := fun c => ⟨res_W (θ_V c), c, 1, hPz_prime.one_notMem, by simp⟩
            map_one' := Subtype.ext (by simp)
            map_mul' := fun a b => Subtype.ext (by simp)
            map_zero' := Subtype.ext (by simp)
            map_add' := fun a b => Subtype.ext (by simp) }
        have _ : Algebra.IsIntegral ↥k₀ (B_y ⧸ q_z.asIdeal) := by
          refine ⟨fun f_bar => ?_⟩
          obtain ⟨f_sec, rfl⟩ := Ideal.Quotient.mk_surjective f_bar
          have hNotTrans : ¬ ∀ P : Polynomial ↥V,
              (∃ i : ℕ, P.coeff i ∉ (g_Z.base ((ψ_X ≫ p_X).base mW)).asIdeal) →
              Polynomial.eval₂ (AlgebraicGeometry.Spec.preimage (ψ_X ≫ p_X ≫ g_Z)).hom
                (φ_By.hom f_sec) P ∉ IsLocalRing.maximalIdeal ↥W_target := by
            intro hAll
            exact hRes ⟨ψ_X, mW, U_y, hUy, φ_By, f_sec, hmW, hη_ψX, hz_Uy, hφBy_spec, hAll⟩
          push Not at hNotTrans
          obtain ⟨P, ⟨i₀, hi₀⟩, hP_mem⟩ := hNotTrans
          have hPz_same : (g_Z.base ((ψ_X ≫ p_X).base mW)).asIdeal = P_z := by
            rw [hψX_pX, hPz_eq]
          rw [hPz_same] at hi₀
          have hθ_same : (AlgebraicGeometry.Spec.preimage (ψ_X ≫ p_X ≫ g_Z)).hom = θ_V := by
            rw [hpX_gZ]
          rw [hθ_same] at hP_mem
          let P_k0 : Polynomial ↥k₀ := P.map ρ_k0
          have hPk0_ne : P_k0 ≠ 0 := by
            intro h0
            have hc := congrArg (fun q => (q.coeff i₀).1) h0
            simp only [P_k0, Polynomial.coeff_map, Polynomial.coeff_zero,
              ZeroMemClass.coe_zero] at hc
            change res_W (θ_V (P.coeff i₀)) = 0 at hc
            rw [IsLocalRing.residue_eq_zero_iff, ← Ideal.mem_comap, hComap_θ] at hc
            exact hi₀ hc
          have hAlg_fbar : IsAlgebraic ↥k₀ (Ideal.Quotient.mk q_z.asIdeal f_sec) := by
            refine ⟨P_k0, hPk0_ne, ?_⟩
            apply hInj_ιqz
            rw [map_zero]
            have h_ev : ι_qz (Polynomial.aeval (Ideal.Quotient.mk q_z.asIdeal f_sec) P_k0) =
                res_W (Polynomial.eval₂ θ_V (φ_By.hom f_sec) P) := by
              rw [Polynomial.aeval_def, Polynomial.hom_eval₂, Polynomial.eval₂_map]
              have hcomp : (ι_qz.comp (algebraMap ↥k₀ (B_y ⧸ q_z.asIdeal))).comp ρ_k0 =
                  res_W.comp θ_V := by
                ext c; exact hj_k0 (ρ_k0 c)
              rw [hcomp, Polynomial.hom_eval₂]
              rfl
            rw [h_ev, IsLocalRing.residue_eq_zero_iff]
            exact hP_mem
          exact IsAlgebraic.isIntegral hAlg_fbar
        have _ : q_z.asIdeal.IsPrime := q_z.isPrime
        have _ : IsDomain (B_y ⧸ q_z.asIdeal) := Ideal.Quotient.isDomain q_z.asIdeal
        have hIsField_By : IsField (B_y ⧸ q_z.asIdeal) :=
          (@Algebra.IsIntegral.isField_iff_isField ↥k₀ (B_y ⧸ q_z.asIdeal) _ _ _ _ _
            hInj_jk0).mp (Field.toIsField ↥k₀)
        have hMax_qz : q_z.asIdeal.IsMaximal :=
          Ideal.Quotient.maximal_of_isField q_z.asIdeal hIsField_By
        have hqz_eq_qy : q_z = q_y :=
          PrimeSpectrum.ext (hMax_qz.eq_of_le q_y.isPrime.ne_top hqz_le_qy)
        rw [Set.mem_singleton_iff, ← hqy_eq, ← hqz_eq_qy, hqz_eq]
    · intro W_et hz_Wet e hEt_e he_comm
      obtain ⟨ψ_W, hψW_ι⟩ := hLiftψ_Open W_et hz_Wet
      have hIdeal_z : (e.base ⟨z, hz_Wet⟩).asIdeal =
          Ideal.comap (AlgebraicGeometry.Spec.preimage (ψ_W ≫ e)).hom
            (IsLocalRing.maximalIdeal ↥W_target) := by
        rw [← hmW]
        have h1 : W_et.ι.base (ψ_W.base mW) = z := by
          change (ψ_W ≫ W_et.ι).base mW = ψ_X.base mW
          rw [hψW_ι]
        have h2 : ψ_W.base mW = (⟨z, hz_Wet⟩ : ↥W_et.toScheme) := Subtype.ext h1
        have h3 : (AlgebraicGeometry.Spec.map (AlgebraicGeometry.Spec.preimage (ψ_W ≫ e))).base mW =
            e.base ⟨z, hz_Wet⟩ := by
          rw [AlgebraicGeometry.Spec.map_preimage, ← h2]; rfl
        exact (congrArg PrimeSpectrum.asIdeal h3).symm
      have hθ_C : ∀ c : ↥V, (AlgebraicGeometry.Spec.preimage (ψ_W ≫ e)).hom (Polynomial.C c) = θ_V c := by
        intro c
        have h1 : (ψ_W ≫ e) ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) =
            ψ_X ≫ g_X := by
