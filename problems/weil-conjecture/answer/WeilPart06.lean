    obtain ⟨ψ₀, _, hψ₀_C, hψ₀_X0, hψ₀_X1⟩ :=
      nodal_lift_pkg π₁' (η_A0.comp ι_a)
        (η_A0 (ι_a s₁' * u₀)) (η_A0 (ι_a (t_s * π₁')) * u₀_inv) hψ₀_rel
    refine comp_away_isLocalization p₀_hom u₀ ψ₀ ?_ ?_
    · apply nodalHom_ext a_Rz
      · intro r
        rw [RingHom.comp_apply, hp₀_C r, hψ₀_C r, RingHom.comp_apply]
      · rw [RingHom.comp_apply, hp₀_X0, map_mul ψ₀, hψ₀_C t_s, hψ₀_X0, RingHom.comp_apply,
          ← map_mul η_A0, ← mul_assoc, ← map_mul ι_a, hts, map_one, one_mul]
      · rw [RingHom.comp_apply, hp₀_X1, map_mul ψ₀, hψ₀_C b₁', hψ₀_X1, RingHom.comp_apply]
        have hb_eq : b₁' * (t_s * π₁') = a_Rz := by
          calc b₁' * (t_s * π₁') = t_s * b₁' * π₁' := by ring
