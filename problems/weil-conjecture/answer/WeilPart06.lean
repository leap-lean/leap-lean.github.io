        have hle₂ : Y₀.basicOpen (1 - e₀ β) ≤ U β := Y₀.basicOpen_le (1 - e₀ β)
        have heq_inf : Y₀.basicOpen (e₀ α) ⊓ Y₀.basicOpen (1 - e₀ β) =
            ((U α ⊓ U β) ⊓ Y₀.basicOpen (e₀ α)) ⊓ ((U α ⊓ U β) ⊓ Y₀.basicOpen (1 - e₀ β)) := by
          apply le_antisymm
          · refine le_inf (le_inf (le_inf (inf_le_left.trans hle₁) (inf_le_right.trans hle₂)) inf_le_left)
              (le_inf (le_inf (inf_le_left.trans hle₁) (inf_le_right.trans hle₂)) inf_le_right)
