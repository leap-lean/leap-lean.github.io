    obtain ⟨q_0, hq0_mem, hq0_prime, hq0_le, hP_q0⟩ := h_min_le q_y inferInstance hP_φB
    have _ : q_0.IsPrime := hq0_prime
    have hb'_mem0 : (b₁', b₂') ∈ 𝒯 q_0 :=
      ⟨fun h => hb'_mem.1 (hq0_le h), fun Q hQ h => hb'_mem.2 Q hQ (hq0_le h)⟩
    let t' : F := ψ_B b₁' * (ψ_B b₂')⁻¹
    let j₂ : Localization.AtPrime q_0 →+* F :=
      IsLocalization.lift (M := q_0.primeCompl) (g := ψ_B) fun s =>
        isUnit_iff_ne_zero.mpr fun hs => by
          have hs0 : s.1 = 0 := hψB_inj (hs.trans (map_zero ψ_B).symm)
          exact s.2 (hs0 ▸ q_0.zero_mem)
    have hj₂_comp : j₂.comp (algebraMap B (Localization.AtPrime q_0)) = ψ_B :=
      IsLocalization.lift_comp _
    obtain ⟨W₂, hW₂_mem, hW₂_loc⟩ := IsLocalRing.exists_factor_valuationRing j₂
    have _ : IsLocalHom (j₂.codRestrict W₂.toSubring hW₂_mem) := hW₂_loc
    let g₂ : Localization.AtPrime q_0 →+* ↥W₂ := j₂.codRestrict W₂.toSubring hW₂_mem
    let φ₂ : B →+* ↥W₂ := g₂.comp (algebraMap B (Localization.AtPrime q_0))
    have hφ₂_sub : W₂.subtype.comp φ₂ = ψ_B := by
      ext b; exact congrFun (congrArg DFunLike.coe hj₂_comp) b
    have hφ₂_max : ∀ b : B, φ₂ b ∈ IsLocalRing.maximalIdeal ↥W₂ ↔ b ∈ q_0 := by
      intro b
      rw [← not_iff_not, IsLocalRing.notMem_maximalIdeal]
      change IsUnit (g₂ (algebraMap B (Localization.AtPrime q_0) b)) ↔ b ∉ q_0
      rw [isUnit_map_iff g₂,
        IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime q_0) q_0 b]
      rfl
    have hW₂_in : W₂ ∈ S_Pt_fn t' := by
      have hP_φ₂ : ∀ c : ↥V, φ₂ (α_B c) ∈ IsLocalRing.maximalIdeal ↥W₂ ↔ c ∈ P :=
        fun c => (hφ₂_max (α_B c)).trans (hP_q0 c)
      have hq0_eq : Ideal.comap φ₂ (IsLocalRing.maximalIdeal ↥W₂) = q_0 := Ideal.ext hφ₂_max
      exact hBridge W₂ φ₂ b₁' b₂' hφ₂_sub hP_φ₂ (hq0_eq.symm ▸ hb'_mem0)
    let κ₂ := IsLocalRing.ResidueField ↥W₂
    let res₂ : ↥W₂ →+* κ₂ := IsLocalRing.residue ↥W₂
    have hker_res₂ : ∀ b : B, b ∈ q_0 → (res₂.comp φ₂) b = 0 := fun b hb => by
      change res₂ (φ₂ b) = 0
      rw [IsLocalRing.residue_eq_zero_iff]
      exact (hφ₂_max b).mpr hb
    let ι₀ : B ⧸ q_0 →+* κ₂ := Ideal.Quotient.lift q_0 (res₂.comp φ₂) hker_res₂
    have hι₀_inj : Function.Injective ι₀ := by
      rw [RingHom.injective_iff_ker_eq_bot]
      ext x
      obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective x
      rw [RingHom.mem_ker, Ideal.mem_bot, Ideal.Quotient.eq_zero_iff_mem]
      change res₂ (φ₂ b) = 0 ↔ b ∈ q_0
      rw [IsLocalRing.residue_eq_zero_iff, hφ₂_max]
    let mk₀ : B →+* B ⧸ q_0 := Ideal.Quotient.mk q_0
    let q_bar : Ideal (B ⧸ q_0) := Ideal.map mk₀ q_y
    have _ : q_bar.IsPrime :=
      Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective
        (by rw [Ideal.mk_ker]; exact hq0_le)
    have hqbar_comap : Ideal.comap mk₀ q_bar = q_y := by
      rw [Ideal.comap_map_of_surjective' mk₀ Ideal.Quotient.mk_surjective q_y, Ideal.mk_ker,
        sup_eq_left.mpr hq0_le]
    let j₁_bar : Localization.AtPrime q_bar →+* κ₂ :=
      IsLocalization.lift (M := q_bar.primeCompl) (g := ι₀) fun s =>
        isUnit_iff_ne_zero.mpr fun hs => by
          have hs0 : s.1 = 0 := hι₀_inj (hs.trans (map_zero ι₀).symm)
          exact s.2 (hs0 ▸ q_bar.zero_mem)
    have hj₁_bar_comp : j₁_bar.comp (algebraMap (B ⧸ q_0) (Localization.AtPrime q_bar)) = ι₀ :=
      IsLocalization.lift_comp _
    obtain ⟨W₁_bar, hW₁_bar_mem, hW₁_bar_loc⟩ := IsLocalRing.exists_factor_valuationRing j₁_bar
    have _ : IsLocalHom (j₁_bar.codRestrict W₁_bar.toSubring hW₁_bar_mem) := hW₁_bar_loc
    let g₁_bar : Localization.AtPrime q_bar →+* ↥W₁_bar :=
      j₁_bar.codRestrict W₁_bar.toSubring hW₁_bar_mem
    let φ₁_bar : B ⧸ q_0 →+* ↥W₁_bar :=
      g₁_bar.comp (algebraMap (B ⧸ q_0) (Localization.AtPrime q_bar))
    have hφ₁_bar_val : ∀ b : B, (φ₁_bar (mk₀ b)).1 = res₂ (φ₂ b) := by
      intro b
      exact congrFun (congrArg DFunLike.coe hj₁_bar_comp) (mk₀ b)
    have hφ₁_bar_unit : ∀ b : B, IsUnit (φ₁_bar (mk₀ b)) ↔ b ∉ q_y := by
      intro b
      change IsUnit (g₁_bar (algebraMap (B ⧸ q_0) (Localization.AtPrime q_bar) (mk₀ b))) ↔ b ∉ q_y
      rw [isUnit_map_iff g₁_bar,
        IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime q_bar) q_bar (mk₀ b)]
      change mk₀ b ∉ q_bar ↔ b ∉ q_y
      rw [← Ideal.mem_comap, hqbar_comap]
    let S₁_sub : Subring ↥W₂ := W₁_bar.toSubring.comap res₂
    let R₁ : Subring F := S₁_sub.map W₂.subtype
    have hR₁_val : ∀ x : F, x ∈ R₁ ∨ x⁻¹ ∈ R₁ := by
      intro x
      by_cases hx0 : x = 0
      · exact Or.inl (hx0 ▸ R₁.zero_mem)
      rcases W₂.mem_or_inv_mem x with hx | hxi
      · by_cases hxi' : x⁻¹ ∈ W₂
        · have hmul_W₂ : (⟨x, hx⟩ : ↥W₂) * (⟨x⁻¹, hxi'⟩ : ↥W₂) = 1 :=
            Subtype.ext (mul_inv_cancel₀ hx0)
          have hmul_κ₂ : res₂ ⟨x, hx⟩ * res₂ ⟨x⁻¹, hxi'⟩ = 1 := by
            rw [← map_mul, hmul_W₂, map_one]
          have hres_inv : (res₂ ⟨x, hx⟩)⁻¹ = res₂ ⟨x⁻¹, hxi'⟩ :=
            inv_eq_of_mul_eq_one_right hmul_κ₂
          rcases W₁_bar.mem_or_inv_mem (res₂ ⟨x, hx⟩) with hr | hri
          · exact Or.inl ⟨⟨x, hx⟩, hr, rfl⟩
          · rw [hres_inv] at hri
            exact Or.inr ⟨⟨x⁻¹, hxi'⟩, hri, rfl⟩
        · have hnot_u : ¬ IsUnit (⟨x, hx⟩ : ↥W₂) := by
            intro hu
            exact hxi' ((hIsUnit_val W₂ ⟨x, hx⟩).mp hu).2
          have hres0 : res₂ ⟨x, hx⟩ = 0 := by
            rw [IsLocalRing.residue_eq_zero_iff]
            by_contra hnm
            exact hnot_u (IsLocalRing.notMem_maximalIdeal.mp hnm)
          refine Or.inl ⟨⟨x, hx⟩, ?_, rfl⟩
          show res₂ ⟨x, hx⟩ ∈ W₁_bar
          rw [hres0]; exact W₁_bar.zero_mem
      · by_cases hx' : x ∈ W₂
        · have hmul_W₂ : (⟨x, hx'⟩ : ↥W₂) * (⟨x⁻¹, hxi⟩ : ↥W₂) = 1 :=
            Subtype.ext (mul_inv_cancel₀ hx0)
          have hmul_κ₂ : res₂ ⟨x, hx'⟩ * res₂ ⟨x⁻¹, hxi⟩ = 1 := by
            rw [← map_mul, hmul_W₂, map_one]
          have hres_inv : (res₂ ⟨x, hx'⟩)⁻¹ = res₂ ⟨x⁻¹, hxi⟩ :=
            inv_eq_of_mul_eq_one_right hmul_κ₂
          rcases W₁_bar.mem_or_inv_mem (res₂ ⟨x, hx'⟩) with hr | hri
          · exact Or.inl ⟨⟨x, hx'⟩, hr, rfl⟩
          · rw [hres_inv] at hri
            exact Or.inr ⟨⟨x⁻¹, hxi⟩, hri, rfl⟩
        · have hnot_u : ¬ IsUnit (⟨x⁻¹, hxi⟩ : ↥W₂) := by
            intro hu
            have hxx : (x⁻¹)⁻¹ ∈ W₂ := ((hIsUnit_val W₂ ⟨x⁻¹, hxi⟩).mp hu).2
            rw [inv_inv] at hxx
            exact hx' hxx
          have hres0 : res₂ ⟨x⁻¹, hxi⟩ = 0 := by
            rw [IsLocalRing.residue_eq_zero_iff]
            by_contra hnm
            exact hnot_u (IsLocalRing.notMem_maximalIdeal.mp hnm)
          refine Or.inr ⟨⟨x⁻¹, hxi⟩, ?_, rfl⟩
          show res₂ ⟨x⁻¹, hxi⟩ ∈ W₁_bar
          rw [hres0]; exact W₁_bar.zero_mem
    let W₁ : ValuationSubring F := ValuationSubring.ofSubring R₁ hR₁_val
    have hW₁_le_W₂ : W₁ ≤ W₂ := by
      rintro x ⟨y, _, rfl⟩
      exact y.2
    have hB_mem_W₁ : ∀ b : B, ψ_B b ∈ W₁.toSubring := by
      intro b
      refine ⟨φ₂ b, ?_, congrFun (congrArg DFunLike.coe hφ₂_sub) b⟩
      change res₂ (φ₂ b) ∈ W₁_bar
      rw [← hφ₁_bar_val b]
      exact (φ₁_bar (mk₀ b)).2
    let φ₁ : B →+* ↥W₁ := ψ_B.codRestrict W₁.toSubring hB_mem_W₁
    have hφ₁_sub : W₁.subtype.comp φ₁ = ψ_B := rfl
    have hφ₁_unit : ∀ b : B, IsUnit (φ₁ b) ↔ b ∉ q_y := by
      intro b
      constructor
      · rintro ⟨u, hu⟩
        rcases u.inv.2 with ⟨w₂, hw₂_res, hw₂_val⟩
        have hmul_F : ψ_B b * (w₂ : F) = 1 := by
          have h1 : (φ₁ b * u.inv : ↥W₁).1 = 1 := by
            rw [← hu, u.val_inv]; rfl
          change ψ_B b * (u.inv : F) = 1 at h1
          rwa [← hw₂_val] at h1
        have hmul_W₂ : φ₂ b * w₂ = 1 := by
          apply Subtype.ext
          have h2 : (φ₂ b : F) = ψ_B b := congrFun (congrArg DFunLike.coe hφ₂_sub) b
          simpa [h2] using hmul_F
        have hmul_κ₂ : (φ₁_bar (mk₀ b)).1 * res₂ w₂ = 1 := by
          rw [hφ₁_bar_val b, ← map_mul, hmul_W₂, map_one]
        have hu_bar : IsUnit (φ₁_bar (mk₀ b)) :=
          ⟨⟨φ₁_bar (mk₀ b), ⟨res₂ w₂, hw₂_res⟩, Subtype.ext hmul_κ₂,
            Subtype.ext (by rw [mul_comm]; exact hmul_κ₂)⟩, rfl⟩
        exact (hφ₁_bar_unit b).mp hu_bar
      · intro hb_ny
        have hb_n0 : b ∉ q_0 := fun h0 => hb_ny (hq0_le h0)
        have hu₂ : IsUnit (φ₂ b) :=
          IsLocalRing.notMem_maximalIdeal.mp (mt (hφ₂_max b).mp hb_n0)
        have hu_bar : IsUnit (φ₁_bar (mk₀ b)) := (hφ₁_bar_unit b).mpr hb_ny
        obtain ⟨u₂, hu₂_eq⟩ := hu₂
        obtain ⟨u_bar, hu_bar_eq⟩ := hu_bar
        have hmul₁ : res₂ (φ₂ b) * res₂ u₂.inv = 1 := by
          rw [← map_mul, ← hu₂_eq, u₂.val_inv, map_one]
        have hmul₂ : (u_bar.inv : κ₂) * res₂ (φ₂ b) = 1 := by
          rw [← hφ₁_bar_val b, ← hu_bar_eq]
          exact congrArg W₁_bar.subtype u_bar.inv_val
        have hres_eq : res₂ u₂.inv = (u_bar.inv : κ₂) :=
          (left_inv_eq_right_inv hmul₂ hmul₁).symm
        have hw₁_mem : (u₂.inv : F) ∈ W₁ := by
          refine ⟨u₂.inv, ?_, rfl⟩
          show res₂ u₂.inv ∈ W₁_bar
          rw [hres_eq]; exact u_bar.inv.2
        have hmul_F : ψ_B b * (u₂.inv : F) = 1 := by
          have h2 : (φ₂ b : F) = ψ_B b := congrFun (congrArg DFunLike.coe hφ₂_sub) b
          calc ψ_B b * (u₂.inv : F) = (φ₂ b : F) * (u₂.inv : F) := by rw [h2]
            _ = ((u₂.1 * u₂.inv : ↥W₂) : F) := by rw [hu₂_eq]; rfl
            _ = 1 := by rw [u₂.val_inv]; rfl
        refine ⟨⟨φ₁ b, ⟨(u₂.inv : F), hw₁_mem⟩, Subtype.ext hmul_F,
          Subtype.ext (by rw [mul_comm]; exact hmul_F)⟩, rfl⟩
    have hφ₁_max : ∀ b : B, φ₁ b ∈ IsLocalRing.maximalIdeal ↥W₁ ↔ b ∈ q_y := by
      intro b
      rw [← not_iff_not, IsLocalRing.notMem_maximalIdeal, hφ₁_unit b]
    have hW₁_in : W₁ ∈ S_Pt_fn t' := by
      have hP_φ₁ : ∀ c : ↥V, φ₁ (α_B c) ∈ IsLocalRing.maximalIdeal ↥W₁ ↔ c ∈ P :=
        fun c => (hφ₁_max (α_B c)).trans (hP_φB c)
      have hqy_eq : Ideal.comap φ₁ (IsLocalRing.maximalIdeal ↥W₁) = q_y := Ideal.ext hφ₁_max
      exact hBridge W₁ φ₁ b₁' b₂' hφ₁_sub hP_φ₁ (hqy_eq.symm ▸ hb'_mem)
    have hW₁_eq_W₂ : W₁ = W₂ := (hGauss_P t').2 W₁ hW₁_in W₂ hW₂_in hW₁_le_W₂
    have hqy_eq_q0 : q_y = q_0 := by
      ext b
      rw [← not_iff_not, ← hφ₁_unit b]
      have hφ₂_unit : IsUnit (φ₂ b) ↔ b ∉ q_0 := by
        rw [← IsLocalRing.notMem_maximalIdeal, hφ₂_max]
      rw [← hφ₂_unit, hIsUnit_val W₁ (φ₁ b), hIsUnit_val W₂ (φ₂ b)]
      have hv1 : (φ₁ b : F) = ψ_B b := rfl
      have hv2 : (φ₂ b : F) = ψ_B b := congrFun (congrArg DFunLike.coe hφ₂_sub) b
      rw [hv1, hv2, hW₁_eq_W₂]
    have hqy_in_ℳ : q_y ∈ ℳ_P := hqy_eq_q0.symm ▸ hq0_mem
    have h𝒯_ne : (𝒯 q_y).Nonempty := ⟨(b₁', b₂'), hb'_mem⟩
    have ht_wit_eq : t_wit q_y = ψ_B h𝒯_ne.choose.1 * (ψ_B h𝒯_ne.choose.2)⁻¹ :=
      dite_cond_eq_true (eq_true h𝒯_ne)
    refine Set.mem_biUnion hqy_in_ℳ ?_
    rw [ht_wit_eq]
    exact hBridge W φ_B h𝒯_ne.choose.1 h𝒯_ne.choose.2 hφB_sub hP_φB h𝒯_ne.choose_spec

  have _ : AlgebraicGeometry.IsProper π_tilde := hProp_πtilde
  have _ : CompactSpace ↥M_tilde :=
    @AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace _ _ π_tilde inferInstance hComp_Z
  have hComp_topMt : IsCompact ((⊤ : M_tilde.Opens) : Set ↥M_tilde) := isCompact_univ
  obtain ⟨s₀, hs₀_fin, hs₀_cov⟩ :=
    (AlgebraicGeometry.isCompact_iff_finite_and_eq_biUnion_affineOpens
      (U := (⊤ : M_tilde.Opens))).mp hComp_topMt
  let s' : Set M_tilde.affineOpens := {i ∈ s₀ | Nonempty ↥i.1}
  have hs'_fin : s'.Finite := hs₀_fin.subset fun _ h => h.1
  classical
  let S_chart_i : M_tilde.affineOpens → PrimeSpectrum ↥V → Set (ValuationSubring F) := fun i s =>
    if hne : Nonempty ↥i.1 then
      let B_i := ↑(M_tilde.presheaf.obj (Opposite.op i.1))
      let α_i : ↥V →+* B_i :=
        (AlgebraicGeometry.Spec.preimage (i.2.fromSpec ≫ π_tilde ≫ g_Z)).hom
      let ψ_i : B_i →+* F := (hFunc_Mtilde i.1 i.2 hne).choose.hom
      {W : ValuationSubring F |
        ∃ (φ_B : B_i →+* ↥W) (b₁ b₂ : B_i),
          W.subtype.comp φ_B = ψ_i ∧
          (∀ c : ↥V, φ_B (α_i c) ∈ IsLocalRing.maximalIdeal ↥W ↔ c ∈ s.asIdeal) ∧
          φ_B b₂ ∉ IsLocalRing.maximalIdeal ↥W ∧
          (∀ Q : Polynomial ↥V,
            (∃ k : ℕ, Q.coeff k ∉ s.asIdeal) →
            (∑ k ∈ Finset.range (Q.natDegree + 1),
              φ_B (α_i (Q.coeff k) * b₁ ^ k * b₂ ^ (Q.natDegree - k))) ∉
                IsLocalRing.maximalIdeal ↥W)}
    else ∅
  have hChart_fin : ∀ (i : M_tilde.affineOpens) (_ : i ∈ s') (s : PrimeSpectrum ↥V),
      (S_chart_i i s).Finite := by
    intro i hi s
    have hne : Nonempty ↥i.1 := hi.2
    have hS_eq : S_chart_i i s =
        (let B_i := ↑(M_tilde.presheaf.obj (Opposite.op i.1))
         let α_i : ↥V →+* B_i :=
           (AlgebraicGeometry.Spec.preimage (i.2.fromSpec ≫ π_tilde ≫ g_Z)).hom
         let ψ_i : B_i →+* F := (hFunc_Mtilde i.1 i.2 hne).choose.hom
         {W : ValuationSubring F |
           ∃ (φ_B : B_i →+* ↥W) (b₁ b₂ : B_i),
             W.subtype.comp φ_B = ψ_i ∧
             (∀ c : ↥V, φ_B (α_i c) ∈ IsLocalRing.maximalIdeal ↥W ↔ c ∈ s.asIdeal) ∧
             φ_B b₂ ∉ IsLocalRing.maximalIdeal ↥W ∧
             (∀ Q : Polynomial ↥V,
               (∃ k : ℕ, Q.coeff k ∉ s.asIdeal) →
               (∑ k ∈ Finset.range (Q.natDegree + 1),
                 φ_B (α_i (Q.coeff k) * b₁ ^ k * b₂ ^ (Q.natDegree - k))) ∉
                   IsLocalRing.maximalIdeal ↥W)}) := dite_cond_eq_true (eq_true hne)
    rw [hS_eq]
    have hUi : AlgebraicGeometry.IsAffineOpen i.1 := i.2
    let B_i := ↑(M_tilde.presheaf.obj (Opposite.op i.1))
    let m_i := hUi.fromSpec ≫ π_tilde ≫ g_Z
    let α_i : ↥V →+* B_i := (AlgebraicGeometry.Spec.preimage m_i).hom
    have _ : AlgebraicGeometry.LocallyOfFiniteType hUi.fromSpec :=
      AlgebraicGeometry.locallyOfFiniteType_of_isOpenImmersion hUi.fromSpec
    have _ : AlgebraicGeometry.LocallyOfFiniteType g_Z := hLFT_gZ
    have hLFT_mi : AlgebraicGeometry.LocallyOfFiniteType (hUi.fromSpec ≫ π_tilde ≫ g_Z) :=
      inferInstance
    have hFT_α : α_i.FiniteType := by
      change AlgebraicGeometry.LocallyOfFiniteType m_i at hLFT_mi
      rw [← AlgebraicGeometry.Spec.map_preimage m_i] at hLFT_mi
      exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp hLFT_mi
    let hSpec_pair := (hFunc_Mtilde i.1 i.2 hne).choose_spec
    let ψ_hom := (hFunc_Mtilde i.1 i.2 hne).choose
    have hComm_i : ψ_hom.hom.comp α_i = φ_KF.comp V.subtype := by
      have hSpec_eq : AlgebraicGeometry.Spec.map (AlgebraicGeometry.Spec.preimage m_i ≫ ψ_hom) =
          η_Z ≫ g_Z := by
        calc AlgebraicGeometry.Spec.map (AlgebraicGeometry.Spec.preimage m_i ≫ ψ_hom)
            = AlgebraicGeometry.Spec.map ψ_hom ≫
                AlgebraicGeometry.Spec.map (AlgebraicGeometry.Spec.preimage m_i) :=
              AlgebraicGeometry.Spec.map_comp _ _
          _ = AlgebraicGeometry.Spec.map ψ_hom ≫ (i.2.fromSpec ≫ π_tilde ≫ g_Z) := by
              rw [AlgebraicGeometry.Spec.map_preimage]
          _ = (AlgebraicGeometry.Spec.map ψ_hom ≫ i.2.fromSpec) ≫ π_tilde ≫ g_Z := by
              simp [Category.assoc]
          _ = (η_tilde ≫ π_tilde) ≫ g_Z := by rw [hSpec_pair.2, Category.assoc]
          _ = η_Z ≫ g_Z := by rw [hη_πtilde]
      have h_pre := congrArg AlgebraicGeometry.Spec.preimage hSpec_eq
      rw [AlgebraicGeometry.Spec.preimage_map] at h_pre
      ext c
      have hc := congrArg (fun f => f.hom c) h_pre
      exact hc.trans (hφ_V c).symm
    exact @hChartValFin s.asIdeal s.2 B_i _ α_i hFT_α ψ_hom.hom hSpec_pair.1 hComm_i

  let S_cand : Set (ValuationSubring F) :=
    {W : ValuationSubring F |
      IsDivisorialClosedVal V g_Z η_Z W ∧ IsValResolvedOnMod V g_Z π_tilde η_tilde W}
  have hCand_fin : S_cand.Finite := by
    refine Set.Finite.subset
      (hs'_fin.biUnion fun i hi => hFinV.biUnion fun s _ => hChart_fin i hi s) ?_
    rintro W ⟨_, ⟨ψ_Mt, mW, U, hU, φ_U, f, hmW, hηW, hyU, hφU, hPoly⟩⟩
    have hy_mem : ψ_Mt.base mW ∈
        (((⨆ i ∈ s₀, (i : M_tilde.Opens)) : M_tilde.Opens) : Set ↥M_tilde) := by
      rw [← hs₀_cov]
      trivial
    simp only [TopologicalSpace.Opens.coe_iSup, Set.mem_iUnion] at hy_mem
    obtain ⟨i, hi_s₀, hyi⟩ := hy_mem
    have hne_i : Nonempty ↥i.1 := ⟨⟨ψ_Mt.base mW, hyi⟩⟩
    have hi_s' : i ∈ s' := ⟨hi_s₀, hne_i⟩
    let s : PrimeSpectrum ↥V := g_Z.base ((ψ_Mt ≫ π_tilde).base mW)
    have hRange_open : ∀ (O : M_tilde.Opens), ψ_Mt.base mW ∈ O →
        Set.range ψ_Mt.base ⊆ (O : Set ↥M_tilde) := by
      rintro O hyO _ ⟨z, rfl⟩
      have hz_le : z.asIdeal ≤ mW.asIdeal := by
        rw [hmW]
        exact IsLocalRing.le_maximalIdeal z.2.ne_top
      have hz_spec : (z : PrimeSpectrum ↥W) ⤳ (mW : PrimeSpectrum ↥W) :=
        (PrimeSpectrum.le_iff_specializes z mW).mp
          ((PrimeSpectrum.asIdeal_le_asIdeal z mW).mp hz_le)
      exact hz_spec.mem_open (O.isOpen.preimage ψ_Mt.base.hom.continuous) hyO
    have hUi : AlgebraicGeometry.IsAffineOpen i.1 := i.2
    have hRange_i : Set.range ψ_Mt.base ⊆ Set.range hUi.fromSpec.base := by
      rw [hUi.range_fromSpec]
      exact hRange_open i.1 hyi
    let lift_i := AlgebraicGeometry.IsOpenImmersion.lift hUi.fromSpec ψ_Mt hRange_i
    let φ_i := AlgebraicGeometry.Spec.preimage lift_i
    let φ_B := φ_i.hom
    have hSpec_φi : AlgebraicGeometry.Spec.map φ_i ≫ hUi.fromSpec = ψ_Mt := by
      rw [AlgebraicGeometry.Spec.map_preimage,
        AlgebraicGeometry.IsOpenImmersion.lift_fac hUi.fromSpec ψ_Mt hRange_i]
    let ψ_hom := (hFunc_Mtilde i.1 i.2 hne_i).choose
    have hSpec_ψ : AlgebraicGeometry.Spec.map ψ_hom ≫ hUi.fromSpec = η_tilde :=
      (hFunc_Mtilde i.1 i.2 hne_i).choose_spec.2
    have hφB_ψ : W.subtype.comp φ_B = ψ_hom.hom := by
      have h_cancel : AlgebraicGeometry.Spec.map (φ_i ≫ CommRingCat.ofHom W.subtype) =
          AlgebraicGeometry.Spec.map ψ_hom := by
        apply (cancel_mono hUi.fromSpec).mp
        rw [AlgebraicGeometry.Spec.map_comp, Category.assoc, hSpec_φi, hηW, hSpec_ψ]
      exact congrArg CommRingCat.Hom.hom (AlgebraicGeometry.Spec.map_injective h_cancel)
    let m_i := hUi.fromSpec ≫ π_tilde ≫ g_Z
    let α_i := (AlgebraicGeometry.Spec.preimage m_i).hom
    have h_pre_ss : AlgebraicGeometry.Spec.preimage (ψ_Mt ≫ π_tilde ≫ g_Z) =
        AlgebraicGeometry.Spec.preimage m_i ≫ φ_i := by
      have h_eq : ψ_Mt ≫ π_tilde ≫ g_Z =
          AlgebraicGeometry.Spec.map (AlgebraicGeometry.Spec.preimage m_i ≫ φ_i) := by
        calc ψ_Mt ≫ π_tilde ≫ g_Z
            = (AlgebraicGeometry.Spec.map φ_i ≫ hUi.fromSpec) ≫ π_tilde ≫ g_Z := by rw [hSpec_φi]
          _ = AlgebraicGeometry.Spec.map φ_i ≫ m_i := by simp [m_i, Category.assoc]
          _ = AlgebraicGeometry.Spec.map φ_i ≫
                AlgebraicGeometry.Spec.map (AlgebraicGeometry.Spec.preimage m_i) :=
              congrArg (AlgebraicGeometry.Spec.map φ_i ≫ ·)
                (AlgebraicGeometry.Spec.map_preimage m_i).symm
          _ = AlgebraicGeometry.Spec.map (AlgebraicGeometry.Spec.preimage m_i ≫ φ_i) :=
              (AlgebraicGeometry.Spec.map_comp _ _).symm
      rw [h_eq, AlgebraicGeometry.Spec.preimage_map]
    have hP_center : ∀ c : ↥V, φ_B (α_i c) ∈ IsLocalRing.maximalIdeal ↥W ↔ c ∈ s.asIdeal := by
      intro c
      rw [← hmW]
      have h_spec_eq : ψ_Mt ≫ π_tilde ≫ g_Z =
          AlgebraicGeometry.Spec.map (AlgebraicGeometry.Spec.preimage m_i ≫ φ_i) := by
        rw [← h_pre_ss, AlgebraicGeometry.Spec.map_preimage]
      have h_pt : ((ψ_Mt ≫ π_tilde ≫ g_Z).base mW).asIdeal = s.asIdeal := rfl
      rw [← h_pt, h_spec_eq]
      rfl
    obtain ⟨b₀, hV₀_le, hy₀⟩ :=
      hUi.exists_basicOpen_le (V := U ⊓ i.1) ⟨ψ_Mt.base mW, ⟨hyU, hyi⟩⟩ hyi
    let V₀ : M_tilde.Opens := M_tilde.basicOpen b₀
    have hV₀ : AlgebraicGeometry.IsAffineOpen V₀ := hUi.basicOpen b₀
    have hRange_V₀ : Set.range ψ_Mt.base ⊆ Set.range hV₀.fromSpec.base := by
      rw [hV₀.range_fromSpec]
      exact hRange_open V₀ hy₀
    let φ_V₀ := AlgebraicGeometry.Spec.preimage
      (AlgebraicGeometry.IsOpenImmersion.lift hV₀.fromSpec ψ_Mt hRange_V₀)
    have hSpec_φV₀ : AlgebraicGeometry.Spec.map φ_V₀ ≫ hV₀.fromSpec = ψ_Mt := by
      rw [AlgebraicGeometry.Spec.map_preimage,
        AlgebraicGeometry.IsOpenImmersion.lift_fac hV₀.fromSpec ψ_Mt hRange_V₀]
    let res_U := M_tilde.presheaf.map (CategoryTheory.homOfLE (hV₀_le.trans inf_le_left)).op
    let res_i := M_tilde.presheaf.map (CategoryTheory.homOfLE (M_tilde.basicOpen_le b₀)).op
    have hφV₀_U : res_U ≫ φ_V₀ = φ_U := by
      apply AlgebraicGeometry.Spec.map_injective
      apply (cancel_mono hU.fromSpec).mp
      rw [AlgebraicGeometry.Spec.map_comp, Category.assoc,
        hU.map_fromSpec hV₀ (CategoryTheory.homOfLE (hV₀_le.trans inf_le_left)).op,
        hSpec_φV₀, hφU]
    have hφV₀_i : res_i ≫ φ_V₀ = φ_i := by
      apply AlgebraicGeometry.Spec.map_injective
      apply (cancel_mono hUi.fromSpec).mp
      rw [AlgebraicGeometry.Spec.map_comp, Category.assoc,
        hUi.map_fromSpec hV₀ (CategoryTheory.homOfLE (M_tilde.basicOpen_le b₀)).op,
        hSpec_φV₀, hSpec_φi]
    let _ : Algebra ↑(M_tilde.presheaf.obj (Opposite.op i.1))
        ↑(M_tilde.presheaf.obj (Opposite.op V₀)) := res_i.hom.toAlgebra
    have hLoc_b₀ : @IsLocalization.Away ↑(M_tilde.presheaf.obj (Opposite.op i.1)) _ b₀
        ↑(M_tilde.presheaf.obj (Opposite.op V₀)) _ res_i.hom.toAlgebra :=
      hUi.isLocalization_basicOpen b₀
    have hu_b₀ : IsUnit (φ_B b₀) := by
      have hu_V₀ : IsUnit (res_i.hom b₀) :=
        @IsLocalization.map_units _ _ (Submonoid.powers b₀) _ _ res_i.hom.toAlgebra hLoc_b₀
          ⟨b₀, Submonoid.mem_powers b₀⟩
      have h_eq : φ_V₀.hom (res_i.hom b₀) = φ_B b₀ := congrArg (fun g => g.hom b₀) hφV₀_i
      exact h_eq ▸ hu_V₀.map φ_V₀.hom
    obtain ⟨⟨b₁, ⟨_, r, rfl⟩⟩, hb₁_eq⟩ :=
      @IsLocalization.surj _ _ (Submonoid.powers b₀) _ _ res_i.hom.toAlgebra hLoc_b₀ (res_U.hom f)
    let b₂ := b₀ ^ r
    have hmul_fb₂ : φ_U.hom f * φ_B b₂ = φ_B b₁ := by
      have h_ap := congrArg φ_V₀.hom hb₁_eq
      have hf_eq : φ_V₀.hom (res_U.hom f) = φ_U.hom f := congrArg (fun g => g.hom f) hφV₀_U
      have hb₂_eq : φ_V₀.hom (res_i.hom b₂) = φ_B b₂ := congrArg (fun g => g.hom b₂) hφV₀_i
      have hb₁_eq' : φ_V₀.hom (res_i.hom b₁) = φ_B b₁ := congrArg (fun g => g.hom b₁) hφV₀_i
      change φ_V₀.hom (res_U.hom f * res_i.hom b₂) = φ_V₀.hom (res_i.hom b₁) at h_ap
      rw [map_mul, hf_eq, hb₂_eq, hb₁_eq'] at h_ap
      exact h_ap
    have hu_b₂ : IsUnit (φ_B b₂) := by
      change IsUnit (φ_B (b₀ ^ r))
      rw [map_pow]
      exact hu_b₀.pow r
    refine Set.mem_biUnion hi_s' (Set.mem_biUnion (Set.mem_univ s) ?_)
    have hS_eq : S_chart_i i s =
        (let B_i := ↑(M_tilde.presheaf.obj (Opposite.op i.1))
         let α_i : ↥V →+* B_i :=
           (AlgebraicGeometry.Spec.preimage (i.2.fromSpec ≫ π_tilde ≫ g_Z)).hom
         let ψ_i : B_i →+* F := (hFunc_Mtilde i.1 i.2 hne_i).choose.hom
         {W : ValuationSubring F |
           ∃ (φ_B : B_i →+* ↥W) (b₁ b₂ : B_i),
             W.subtype.comp φ_B = ψ_i ∧
             (∀ c : ↥V, φ_B (α_i c) ∈ IsLocalRing.maximalIdeal ↥W ↔ c ∈ s.asIdeal) ∧
             φ_B b₂ ∉ IsLocalRing.maximalIdeal ↥W ∧
             (∀ Q : Polynomial ↥V,
               (∃ k : ℕ, Q.coeff k ∉ s.asIdeal) →
               (∑ k ∈ Finset.range (Q.natDegree + 1),
                 φ_B (α_i (Q.coeff k) * b₁ ^ k * b₂ ^ (Q.natDegree - k))) ∉
                   IsLocalRing.maximalIdeal ↥W)}) := dite_cond_eq_true (eq_true hne_i)
    rw [hS_eq]
    refine ⟨φ_B, b₁, b₂, hφB_ψ, hP_center, IsLocalRing.notMem_maximalIdeal.mpr hu_b₂, ?_⟩
    intro Q hQ
    let d := Q.natDegree
    have h_sum_eq : (∑ k ∈ Finset.range (d + 1),
          φ_B (α_i (Q.coeff k) * b₁ ^ k * b₂ ^ (d - k))) =
        (φ_B b₂) ^ d * Polynomial.eval₂
          (AlgebraicGeometry.Spec.preimage (ψ_Mt ≫ π_tilde ≫ g_Z)).hom (φ_U.hom f) Q := by
      rw [Polynomial.eval₂_eq_sum_range, Finset.mul_sum]
      refine Finset.sum_congr rfl fun k hk => ?_
      have hk_le : k ≤ d := Nat.lt_succ_iff.mp (Finset.mem_range.mp hk)
      have h_pow : (φ_B b₂) ^ d = (φ_B b₂) ^ k * (φ_B b₂) ^ (d - k) := by
        rw [← pow_add, Nat.add_sub_of_le hk_le]
      have hc_eq : (AlgebraicGeometry.Spec.preimage (ψ_Mt ≫ π_tilde ≫ g_Z)).hom (Q.coeff k) =
          φ_B (α_i (Q.coeff k)) := congrArg (fun g => g.hom (Q.coeff k)) h_pre_ss
      rw [hc_eq, map_mul, map_mul, map_pow, map_pow, ← hmul_fb₂, mul_pow, h_pow]
      ring
    intro h_mem
    rw [h_sum_eq] at h_mem
    obtain ⟨u_d, hu_d⟩ := hu_b₂.pow d
    have h_eval_mem : Polynomial.eval₂
        (AlgebraicGeometry.Spec.preimage (ψ_Mt ≫ π_tilde ≫ g_Z)).hom (φ_U.hom f) Q ∈
        IsLocalRing.maximalIdeal ↥W := by
      have h1 := Ideal.mul_mem_left _ (u_d.inv) h_mem
      have h2 : u_d.inv * ((φ_B b₂) ^ d * Polynomial.eval₂
          (AlgebraicGeometry.Spec.preimage (ψ_Mt ≫ π_tilde ≫ g_Z)).hom (φ_U.hom f) Q) =
          Polynomial.eval₂
            (AlgebraicGeometry.Spec.preimage (ψ_Mt ≫ π_tilde ≫ g_Z)).hom (φ_U.hom f) Q := by
        rw [← mul_assoc, ← hu_d, u_d.inv_val, one_mul]
      rwa [h2] at h1
    exact hPoly Q hQ h_eval_mem

  let F_cand := hCand_fin.toFinset
  let r_val := F_cand.card
  let e_cand : Fin r_val ≃ ↥F_cand := (Finset.equivFin F_cand).symm
  let W_list : Fin r_val → ValuationSubring F := fun i => (e_cand i).1
  refine ⟨hPartA, η_UK, φ_KF, M_proj, M_tilde, π_tilde, ι_proj, η_tilde, hComm_proj,
    r_val, W_list, hηUK_Z, hFunc_UK, hFunc_M, hφ_V, hAlg,
    hInt_Mtilde, hProp_πtilde, hη_πtilde, hFunc_Mtilde, hCl_proj, hValTransfer, ?_, ?_⟩
  · intro i
    exact (hCand_fin.mem_toFinset.mp (e_cand i).2).1
  · intro W hDiv hRes
    have hw : W ∈ F_cand := hCand_fin.mem_toFinset.mpr ⟨hDiv, hRes⟩
    refine ⟨e_cand.symm ⟨W, hw⟩, ?_⟩
    simp [W_list]

theorem weil_noetherian_projective_specialization_and_propagation (K : Type u) [Field K]
    (m : ℕ) (V : ValuationSubring K) (hPkg : IsValuationRingAlgPackage m V)
    (Z : AlgebraicGeometry.Scheme.{u})
    (g_Z : Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (hSS_Z : IsStrictlySemistableCurveOverValuation V g_Z)
    (hNoeth_Z : TopologicalSpace.NoetherianSpace ↥Z)
    (F : Type u) [Field F]
    (η_Z : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ Z)
    (hFunc_Z : IsSchemeFunctionField Z F η_Z)
    (M_proj : ℕ)
    (M_tilde : AlgebraicGeometry.Scheme.{u})
    (π_tilde : M_tilde ⟶ Z)
    (ι_proj : M_tilde ⟶ (weilProjectiveSpaceOver ↥V M_proj).left)
    (η_tilde : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ M_tilde)
    (hInt_M : AlgebraicGeometry.IsIntegral M_tilde)
    (hProp_π : AlgebraicGeometry.IsProper π_tilde)
    (hη_π : η_tilde ≫ π_tilde = η_Z)
    (hFunc_M : IsSchemeFunctionField M_tilde F η_tilde)
    (hComm_proj : ι_proj ≫ (weilProjectiveSpaceOver ↥V M_proj).hom = π_tilde ≫ g_Z)
    (hCl_proj : AlgebraicGeometry.IsClosedImmersion
      (CategoryTheory.Limits.pullback.lift ι_proj π_tilde hComm_proj))
    (hAff_proj : ∀ (R : Type u) [CommRing R] (N : ℕ) (a : Fin (N + 1)),
      AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen R N a))
    (c_proj : ∀ (R : Type u) [CommRing R] (N : ℕ) (a : Fin (N + 1)),
      R →+* ↑((weilProjectiveSpaceOver R N).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen R N a))))
    (t_proj : ∀ (R : Type u) [CommRing R] (N : ℕ) (a : Fin (N + 1)), Fin (N + 1) →
      ↑((weilProjectiveSpaceOver R N).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen R N a))))
    (hCoord_proj : ∀ (R : Type u) [CommRing R] (N : ℕ),
      IsCommRingProjCoordSystem R N (hAff_proj R N) (c_proj R N) (t_proj R N))
    (hBase_proj : ∀ (R S : Type u) [CommRing R] [CommRing S] (φ_RS : R →+* S) (N : ℕ),
      ∃ (Φ : (weilProjectiveSpaceOver S N).left ⟶ (weilProjectiveSpaceOver R N).left),
        IsCommRingProjBaseChange R S φ_RS N
          (c_proj R N) (t_proj R N) (c_proj S N) (t_proj S N) Φ)
    (X : AlgebraicGeometry.Scheme.{u})
    (g_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (p_X : X ⟶ Z)
    (η_X : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ X)
    (hSS_X : IsStrictlySemistableCurveOverValuation V g_X)
    (hProp_pX : AlgebraicGeometry.IsProper p_X)
    (hComm_pX : p_X ≫ g_Z = g_X)
    (hη_pX : η_X ≫ p_X = η_Z)
    (hRes_div : ∀ W₀ : ValuationSubring F,
      IsDivisorialClosedVal V g_Z η_Z W₀ →
      IsValResolvedOnMod V g_Z π_tilde η_tilde W₀ →
      IsValResolvedOnMod V g_Z p_X η_X W₀)
    (W : ValuationSubring F)
    (hRes_M : IsValResolvedOnMod V g_Z π_tilde η_tilde W)
    (hNonzero : ∀ (ψ_Z : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ Z)
        (mW : AlgebraicGeometry.Spec (CommRingCat.of ↥W)),
      mW.asIdeal = IsLocalRing.maximalIdeal ↥W →
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype) ≫ ψ_Z = η_Z →
      (g_Z.base (ψ_Z.base mW)).asIdeal ≠ ⊥) :
    IsValResolvedOnMod V g_Z p_X η_X W :=
by
  obtain ⟨hDicho, hClear, hVand⟩ :=
    weil_valuation_overring_dichotomy_and_vandermonde_avoidance K V
  have hAlgClosed := hPkg.2.2.2.2.1
  have hSep_Z : AlgebraicGeometry.IsSeparated g_Z := hSS_Z.2.2.1

  obtain ⟨ψ_M, mW, U_M, hUM, φ_UM, f_M, hmW, hη_ψM, hyUM, hφUM_spec, hfM_poly⟩ := hRes_M
  let ψ_Z : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ Z := ψ_M ≫ π_tilde
  have hη_ψZ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype) ≫ ψ_Z = η_Z := by
    change AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype) ≫ (ψ_M ≫ π_tilde) = η_Z
    rw [← CategoryTheory.Category.assoc, hη_ψM, hη_π]
  let z_Q : ↥Z := ψ_Z.base mW
  let P_s : Ideal ↥V := (g_Z.base z_Q).asIdeal
  haveI : P_s.IsPrime := (g_Z.base z_Q).isPrime
  have hPs_ne : P_s ≠ ⊥ := hNonzero ψ_Z mW hmW hη_ψZ

  
  have hLocSchemeFac : ∀ {S : AlgebraicGeometry.Scheme.{u}}
      (ψ : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ S)
      (U : S.Opens) (hU : AlgebraicGeometry.IsAffineOpen U) (hx : ψ.base mW ∈ U),
      ∃ φ_U : S.presheaf.obj (Opposite.op U) ⟶ CommRingCat.of ↥W,
        AlgebraicGeometry.Spec.map φ_U ≫ hU.fromSpec = ψ ∧
        Ideal.comap φ_U.hom (IsLocalRing.maximalIdeal ↥W) =
          (hU.primeIdealOf ⟨ψ.base mW, hx⟩).asIdeal := by
    intro S ψ U hU hx
    have hRange : Set.range ψ.base ⊆ Set.range hU.fromSpec.base := by
      rw [hU.range_fromSpec]
      rintro _ ⟨q, rfl⟩
      by_contra hnot
      let q_ps : PrimeSpectrum ↥W := q
      let mW_ps : PrimeSpectrum ↥W := mW
      have hle : q_ps.asIdeal ≤ mW_ps.asIdeal := by
        change q.asIdeal ≤ mW.asIdeal
        rw [hmW]; exact IsLocalRing.le_maximalIdeal q.isPrime.ne_top
      have hm_cl : mW_ps ∈ closure ({q_ps} : Set (PrimeSpectrum ↥W)) := by
        rw [PrimeSpectrum.closure_singleton]; exact hle
      exact closure_minimal (Set.singleton_subset_iff.mpr hnot)
        (U.isOpen.isClosed_compl.preimage ψ.continuous) hm_cl hx
    let φ_U := AlgebraicGeometry.Spec.preimage
      (AlgebraicGeometry.IsOpenImmersion.lift hU.fromSpec ψ hRange)
    have hφ : AlgebraicGeometry.Spec.map φ_U ≫ hU.fromSpec = ψ := by
      dsimp only [φ_U]
      rw [AlgebraicGeometry.Spec.map_preimage]
      exact AlgebraicGeometry.IsOpenImmersion.lift_fac hU.fromSpec ψ hRange
    have hp_eq : (AlgebraicGeometry.Spec.map φ_U).base mW = hU.primeIdealOf ⟨ψ.base mW, hx⟩ := by
      apply hU.fromSpec.isOpenEmbedding.injective
      rw [hU.fromSpec_primeIdealOf ⟨ψ.base mW, hx⟩]
      change (AlgebraicGeometry.Spec.map φ_U ≫ hU.fromSpec).base mW = ψ.base mW
      rw [hφ]
    refine ⟨φ_U, hφ, ?_⟩
    have hId := congrArg PrimeSpectrum.asIdeal hp_eq
    rw [← hId, ← hmW]; rfl

  
  have hBasicResX : ∀ (ψ_X : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ X)
      (_ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype) ≫ ψ_X = η_X)
      (U_X : X.Opens) (hUX : AlgebraicGeometry.IsAffineOpen U_X) (hxUX : ψ_X.base mW ∈ U_X)
      (φ_UX : X.presheaf.obj (Opposite.op U_X) ⟶ CommRingCat.of ↥W)
      (_ : AlgebraicGeometry.Spec.map φ_UX ≫ hUX.fromSpec = ψ_X)
      (a_X b_X : ↑(X.presheaf.obj (Opposite.op U_X))),
      φ_UX.hom b_X ∉ IsLocalRing.maximalIdeal ↥W →
      (∀ t : ↥W, φ_UX.hom b_X * t = φ_UX.hom a_X →
        ∀ Q : Polynomial ↥V,
          (∃ i : ℕ, Q.coeff i ∉ (g_Z.base ((ψ_X ≫ p_X).base mW)).asIdeal) →
          Polynomial.eval₂ (AlgebraicGeometry.Spec.preimage (ψ_X ≫ p_X ≫ g_Z)).hom t Q ∉
            IsLocalRing.maximalIdeal ↥W) →
      IsValResolvedOnMod V g_Z p_X η_X W := by
    intro ψ_X hη_ψX U_X hUX hxUX φ_UX hφUX a_X b_X hb_notMem hpoly
    let U_1 : X.Opens := X.basicOpen b_X
    have hU1 : AlgebraicGeometry.IsAffineOpen U_1 := hUX.basicOpen b_X
    have hp_eq : (AlgebraicGeometry.Spec.map φ_UX).base mW =
        hUX.primeIdealOf ⟨ψ_X.base mW, hxUX⟩ := by
      apply hUX.fromSpec.isOpenEmbedding.injective
      rw [hUX.fromSpec_primeIdealOf ⟨ψ_X.base mW, hxUX⟩]
      change (AlgebraicGeometry.Spec.map φ_UX ≫ hUX.fromSpec).base mW = ψ_X.base mW
      rw [hφUX]
    have hb_prime : b_X ∉ (hUX.primeIdealOf ⟨ψ_X.base mW, hxUX⟩).asIdeal := by
      rw [← hp_eq]
      change φ_UX.hom b_X ∉ mW.asIdeal
      rwa [hmW]
    have hxU1 : ψ_X.base mW ∈ U_1 := by
      have hmem_ps : hUX.primeIdealOf ⟨ψ_X.base mW, hxUX⟩ ∈ PrimeSpectrum.basicOpen b_X :=
        hb_prime
      rw [← hUX.fromSpec_preimage_basicOpen b_X] at hmem_ps
      change hUX.fromSpec.base (hUX.primeIdealOf ⟨ψ_X.base mW, hxUX⟩) ∈ U_1 at hmem_ps
      rwa [hUX.fromSpec_primeIdealOf ⟨ψ_X.base mW, hxUX⟩] at hmem_ps
    let resMap := X.presheaf.map (CategoryTheory.homOfLE (X.basicOpen_le b_X)).op
    letI : Algebra ↑(X.presheaf.obj (Opposite.op U_X)) ↑(X.presheaf.obj (Opposite.op U_1)) :=
      resMap.hom.toAlgebra
    haveI : IsLocalization.Away b_X ↑(X.presheaf.obj (Opposite.op U_1)) :=
      hUX.isLocalization_basicOpen b_X
    have hu_b : IsUnit (φ_UX.hom b_X) := IsLocalRing.notMem_maximalIdeal.mp hb_notMem
    let φ_1 : X.presheaf.obj (Opposite.op U_1) ⟶ CommRingCat.of ↥W :=
      CommRingCat.ofHom (IsLocalization.Away.lift b_X hu_b)
    have hres_φ1 : resMap ≫ φ_1 = φ_UX :=
      CommRingCat.Hom.ext (RingHom.ext fun x =>
        IsLocalization.Away.lift_eq (S := ↑(X.presheaf.obj (Opposite.op U_1))) b_X hu_b x)
    have hφ1_spec : AlgebraicGeometry.Spec.map φ_1 ≫ hU1.fromSpec = ψ_X := by
      rw [← hUX.map_fromSpec hU1 (CategoryTheory.homOfLE (X.basicOpen_le b_X)).op,
        ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp, hres_φ1, hφUX]
    let f_1 : ↑(X.presheaf.obj (Opposite.op U_1)) :=
      IsLocalization.mk' ↑(X.presheaf.obj (Opposite.op U_1)) a_X ⟨b_X, Submonoid.mem_powers b_X⟩
    have hf1_eq : φ_UX.hom b_X * φ_1.hom f_1 = φ_UX.hom a_X := by
      have hmk : resMap.hom b_X * f_1 = resMap.hom a_X :=
        IsLocalization.mk'_spec' ↑(X.presheaf.obj (Opposite.op U_1)) a_X
          ⟨b_X, Submonoid.mem_powers b_X⟩
      have hmk' := congrArg φ_1.hom hmk
      rw [map_mul] at hmk'
      have hcomp_b : φ_1.hom (resMap.hom b_X) = φ_UX.hom b_X :=
        IsLocalization.Away.lift_eq (S := ↑(X.presheaf.obj (Opposite.op U_1))) b_X hu_b b_X
      have hcomp_a : φ_1.hom (resMap.hom a_X) = φ_UX.hom a_X :=
        IsLocalization.Away.lift_eq (S := ↑(X.presheaf.obj (Opposite.op U_1))) b_X hu_b a_X
      rw [hcomp_b, hcomp_a] at hmk'
      exact hmk'
    exact ⟨ψ_X, mW, U_1, hU1, φ_1, f_1, hmW, hη_ψX, hxU1, hφ1_spec, hpoly (φ_1.hom f_1) hf1_eq⟩

  
  have hMinClosed : ∀ (C : Set ↥Z), IsClosed C → C.Nonempty →
      ∃ z₀ ∈ C, IsClosed ({z₀} : Set ↥Z) := by
    intro C hC_cl hC_ne
    haveI : TopologicalSpace.NoetherianSpace ↥Z := hNoeth_Z
    have hWF : WellFoundedLT (TopologicalSpace.Closeds ↥Z) :=
      TopologicalSpace.instWellFoundedLTClosedsOfNoetherianSpace
    let S_C : Set (TopologicalSpace.Closeds ↥Z) :=
      {K | (K : Set ↥Z).Nonempty ∧ (K : Set ↥Z) ⊆ C}
    have hSC_ne : S_C.Nonempty := ⟨⟨C, hC_cl⟩, hC_ne, Set.Subset.rfl⟩
    obtain ⟨K₀, hK₀_mem, hK₀_min⟩ :=
      (hWF : WellFounded ((· < ·) : TopologicalSpace.Closeds ↥Z → _ → Prop)).has_min S_C hSC_ne
    obtain ⟨z₀, hz₀⟩ := hK₀_mem.1
    obtain ⟨W0, hW0, hz_W, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := z₀) (U := ⊤) trivial
    have hsub_W : (K₀ : Set ↥Z) ⊆ (W0 : Set ↥Z) := by
      intro x hx
      by_contra hxW
      let K' : TopologicalSpace.Closeds ↥Z :=
        ⟨(K₀ : Set ↥Z) ∩ (W0 : Set ↥Z)ᶜ, K₀.isClosed.inter W0.isOpen.isClosed_compl⟩
      have hK'_mem : K' ∈ S_C :=
        ⟨⟨x, hx, hxW⟩, Set.inter_subset_left.trans hK₀_mem.2⟩
      have hK'_lt : K' < K₀ := by
        refine lt_of_le_of_ne (show (K' : Set ↥Z) ⊆ K₀ from Set.inter_subset_left) ?_
        intro heq
        have hz_in : z₀ ∈ (K' : Set ↥Z) := by rw [heq]; exact hz₀
        exact hz_in.2 hz_W
      exact hK₀_min K' hK'_mem hK'_lt
    have hSing : (K₀ : Set ↥Z) = {z₀} := by
      ext w
      simp only [Set.mem_singleton_iff]
      constructor
      · intro hw
        have hcl_eq : ∀ u ∈ (K₀ : Set ↥Z), closure ({u} : Set ↥Z) = (K₀ : Set ↥Z) := by
          intro u hu
          let K_u : TopologicalSpace.Closeds ↥Z := ⟨closure ({u} : Set ↥Z), isClosed_closure⟩
          have hKu_le : K_u ≤ K₀ :=
            closure_minimal (Set.singleton_subset_iff.mpr hu) K₀.isClosed
          have hKu_mem : K_u ∈ S_C :=
            ⟨⟨u, subset_closure (Set.mem_singleton u)⟩,
              (show (K_u : Set ↥Z) ⊆ (K₀ : Set ↥Z) from hKu_le).trans hK₀_mem.2⟩
          have hEq : K_u = K₀ := eq_of_le_of_not_lt hKu_le (hK₀_min K_u hKu_mem)
          exact congrArg SetLike.coe hEq
        have hInsep_Z : Inseparable w z₀ :=
          inseparable_iff_closure_eq.mpr ((hcl_eq w hw).trans (hcl_eq z₀ hz₀).symm)
        let pw := hW0.primeIdealOf ⟨w, hsub_W hw⟩
        let pz := hW0.primeIdealOf ⟨z₀, hz_W⟩
        have hpw : hW0.fromSpec.base pw = w := hW0.fromSpec_primeIdealOf ⟨w, hsub_W hw⟩
        have hpz : hW0.fromSpec.base pz = z₀ := hW0.fromSpec_primeIdealOf ⟨z₀, hz_W⟩
        rw [← hpw, ← hpz] at hInsep_Z
        have hInsep_p : Inseparable pw pz :=
          (hW0.fromSpec.isOpenEmbedding.isInducing.inseparable_iff).mp hInsep_Z
        have hp_eq : pw = pz := hInsep_p.eq
        rw [← hpw, ← hpz, hp_eq]
      · rintro rfl
        exact hz₀
    refine ⟨z₀, hK₀_mem.2 hz₀, ?_⟩
    rw [← hSing]
    exact K₀.isClosed

  
  by_cases hBr1 : ∃ (U_Z : Z.Opens) (hUZ : AlgebraicGeometry.IsAffineOpen U_Z) (hzQ : z_Q ∈ U_Z),
      let B := ↑(Z.presheaf.obj (Opposite.op U_Z))
      let p : Ideal B := (hUZ.primeIdealOf ⟨z_Q, hzQ⟩).asIdeal
      let γ_B : ↥V →+* B := (AlgebraicGeometry.Spec.preimage (hUZ.fromSpec ≫ g_Z)).hom
      ∃ (b₁ b₂ : B),
        b₂ ∉ p ∧
        ∀ (R : Type u) [CommRing R] [IsLocalRing R] (ρ_B : B →+* R),
          Ideal.comap ρ_B (IsLocalRing.maximalIdeal R) = p →
          ∀ (t : R),
            ρ_B b₂ * t = ρ_B b₁ →
            ∀ (Q : Polynomial ↥V),
              (∃ i : ℕ, Q.coeff i ∉ P_s) →
