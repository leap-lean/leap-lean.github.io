  have hInf_gen : ∀ (R₁ B : Type u) [CommRing R₁] [CommRing B] (x₀_r x₁_r : R₁) (ψ : R₁ →+* B),
      ψ.Etale →
      (Ideal.span {x₁_r} : Ideal R₁) ⊓ Ideal.span {x₀_r} = ⊥ →
      (Ideal.span {ψ x₁_r} : Ideal B) ⊓ Ideal.span {ψ x₀_r} = ⊥ := by
    intro R₁ B _ _ x₀_r x₁_r ψ hEt hInfR
    letI : Algebra R₁ B := ψ.toAlgebra
    haveI : Algebra.Etale R₁ B := RingHom.etale_algebraMap.mpr hEt
    let J₁ : Ideal R₁ := Ideal.span {x₁_r}
    let J₀ : Ideal R₁ := Ideal.span {x₀_r}
    have hMap₁ : Ideal.map (algebraMap R₁ B) J₁ = Ideal.span {ψ x₁_r} := by
      rw [Ideal.map_span, Set.image_singleton]
      rfl
    have hMap₀ : Ideal.map (algebraMap R₁ B) J₀ = Ideal.span {ψ x₀_r} := by
      rw [Ideal.map_span, Set.image_singleton]
      rfl
    let δ : R₁ →ₗ[R₁] (R₁ ⧸ J₁) × (R₁ ⧸ J₀) :=
      LinearMap.prod (Submodule.mkQ J₁) (Submodule.mkQ J₀)
    have hδ_inj : Function.Injective δ := by
      intro r₁ r₂ h_eq
      have h_sub : δ (r₁ - r₂) = 0 := by rw [map_sub, h_eq, sub_self]
      have h₁ : r₁ - r₂ ∈ J₁ :=
        (Submodule.Quotient.mk_eq_zero J₁).mp (congrArg Prod.fst h_sub)
      have h₀ : r₁ - r₂ ∈ J₀ :=
        (Submodule.Quotient.mk_eq_zero J₀).mp (congrArg Prod.snd h_sub)
      have h_bot : r₁ - r₂ ∈ (⊥ : Ideal R₁) := hInfR ▸ ⟨h₁, h₀⟩
      exact sub_eq_zero.mp ((Submodule.mem_bot R₁).mp h_bot)
    have hT_inj : Function.Injective (δ.lTensor B) :=
      Module.Flat.lTensor_preserves_injective_linearMap δ hδ_inj
    rw [eq_bot_iff]
    intro b hb
    rcases hb with ⟨hb₁, hb₀⟩
    rw [← hMap₁] at hb₁
    rw [← hMap₀] at hb₀
    have ht₁ : (b ⊗ₜ[R₁] (Ideal.Quotient.mk J₁ 1) : TensorProduct R₁ B (R₁ ⧸ J₁)) = 0 := by
      apply (Algebra.TensorProduct.quotIdealMapEquivTensorQuot B J₁).symm.injective
      rw [map_zero, Algebra.TensorProduct.quotIdealMapEquivTensorQuot_symm_tmul, one_smul]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr hb₁
    have ht₀ : (b ⊗ₜ[R₁] (Ideal.Quotient.mk J₀ 1) : TensorProduct R₁ B (R₁ ⧸ J₀)) = 0 := by
      apply (Algebra.TensorProduct.quotIdealMapEquivTensorQuot B J₀).symm.injective
      rw [map_zero, Algebra.TensorProduct.quotIdealMapEquivTensorQuot_symm_tmul, one_smul]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr hb₀
    have hProd : (TensorProduct.prodRight R₁ R₁ B (R₁ ⧸ J₁) (R₁ ⧸ J₀))
        ((δ.lTensor B) (b ⊗ₜ[R₁] (1 : R₁))) = 0 := by
      rw [LinearMap.lTensor_tmul]
      change (TensorProduct.prodRight R₁ R₁ B (R₁ ⧸ J₁) (R₁ ⧸ J₀))
        (b ⊗ₜ[R₁] (Ideal.Quotient.mk J₁ 1, Ideal.Quotient.mk J₀ 1)) = 0
      rw [TensorProduct.prodRight_tmul, ht₁, ht₀, Prod.mk_zero_zero]
    have h_tmul : (b ⊗ₜ[R₁] (1 : R₁) : TensorProduct R₁ B R₁) = 0 := by
      apply hT_inj
      rw [map_zero]
      exact (TensorProduct.prodRight R₁ R₁ B (R₁ ⧸ J₁) (R₁ ⧸ J₀)).injective
        (hProd.trans (map_zero _).symm)
    have hb_zero : (TensorProduct.rid R₁ B) (b ⊗ₜ[R₁] (1 : R₁)) = 0 := by
      rw [h_tmul, map_zero]
    rw [TensorProduct.rid_tmul, one_smul] at hb_zero
    exact (Submodule.mem_bot B).mpr hb_zero

  have hQuotEt_gen : ∀ (R₁ B : Type u) [CommRing R₁] [CommRing B] (ψ : R₁ →+* B)
      (I : Ideal R₁) (K : Ideal B) (hMap : Ideal.map ψ I = K),
      ψ.Etale →
      (Ideal.quotientMap K ψ (hMap ▸ Ideal.le_comap_map) : (R₁ ⧸ I) →+* (B ⧸ K)).Etale := by
    intro R₁ B _ _ ψ I K hMap hEt
    letI : Algebra R₁ B := ψ.toAlgebra
    haveI : Algebra.Etale R₁ B := RingHom.etale_algebraMap.mpr hEt
    haveI : Algebra.Etale (R₁ ⧸ I) (TensorProduct R₁ (R₁ ⧸ I) B) :=
      Algebra.Etale.baseChange R₁ B (R₁ ⧸ I)
    have hEt_alg : (algebraMap (R₁ ⧸ I) (TensorProduct R₁ (R₁ ⧸ I) B)).Etale :=
      (RingHom.etale_algebraMap (R := R₁ ⧸ I) (S := TensorProduct R₁ (R₁ ⧸ I) B)).mpr inferInstance
    have hMap' : Ideal.map (algebraMap R₁ B) I = K := hMap
    let E : TensorProduct R₁ (R₁ ⧸ I) B ≃+* (B ⧸ K) :=
      ((Algebra.TensorProduct.comm R₁ (R₁ ⧸ I) B).toRingEquiv.trans
        (Algebra.TensorProduct.quotIdealMapEquivTensorQuot B I).symm.toRingEquiv).trans
        (Ideal.quotEquivOfEq hMap')
    have hEt_E : E.toRingHom.Etale := RingHom.Etale.of_bijective E.bijective
    have hComp_eq : E.toRingHom.comp (algebraMap (R₁ ⧸ I) (TensorProduct R₁ (R₁ ⧸ I) B)) =
        (Ideal.quotientMap K ψ (hMap ▸ Ideal.le_comap_map) : (R₁ ⧸ I) →+* (B ⧸ K)) := by
      apply Ideal.Quotient.ringHom_ext
      ext r
      change Ideal.quotEquivOfEq hMap'
        ((Algebra.TensorProduct.quotIdealMapEquivTensorQuot B I).symm
          ((1 : B) ⊗ₜ[R₁] Ideal.Quotient.mk I r)) = Ideal.Quotient.mk K (ψ r)
      rw [Algebra.TensorProduct.quotIdealMapEquivTensorQuot_symm_tmul]
      have hsmul : r • (1 : B) = ψ r := by
        change algebraMap R₁ B r * 1 = ψ r
        rw [mul_one]
        rfl
      change Ideal.quotEquivOfEq hMap' (Ideal.Quotient.mk _ (r • (1 : B))) = _
      rw [hsmul, Ideal.quotEquivOfEq_mk]
    rw [← hComp_eq]
    exact RingHom.Etale.stableUnderComposition _ _ hEt_alg hEt_E

  have h_s1 : ∀ (B : Type u) [CommRing B] (c_B : k₀ →+* B) (ψ : R₀ →+* B),
      ψ.Etale →
      c_B = ψ.comp c_R₀ →
      let y₀ : B := ψ Xbar₀
      let y₁ : B := ψ Xbar₁
      (Ideal.span {y₁} : Ideal B) ⊓ Ideal.span {y₀} = ⊥ ∧
      (∃ (α₀ : Polynomial k₀ →+* (B ⧸ Ideal.span {y₁})),
        α₀.Etale ∧
        α₀.comp Polynomial.C = (Ideal.Quotient.mk (Ideal.span {y₁})).comp c_B ∧
        α₀ Polynomial.X = Ideal.Quotient.mk (Ideal.span {y₁}) y₀) ∧
      (∃ (α₁ : Polynomial k₀ →+* (B ⧸ Ideal.span {y₀})),
        α₁.Etale ∧
        α₁.comp Polynomial.C = (Ideal.Quotient.mk (Ideal.span {y₀})).comp c_B ∧
        α₁ Polynomial.X = Ideal.Quotient.mk (Ideal.span {y₀}) y₁) ∧
      ((Ideal.Quotient.mk (Ideal.span {y₀, y₁})).comp c_B).Etale := by
    intro B _ c_B ψ hEt hc
    dsimp only
    let y₀ : B := ψ Xbar₀
    let y₁ : B := ψ Xbar₁
    have hMap₁ : Ideal.map ψ (Ideal.span {Xbar₁}) = Ideal.span {y₁} := by
      rw [Ideal.map_span, Set.image_singleton]
    have hMap₀ : Ideal.map ψ (Ideal.span {Xbar₀}) = Ideal.span {y₀} := by
      rw [Ideal.map_span, Set.image_singleton]
    have hMap_nd : Ideal.map ψ (Ideal.span {Xbar₀, Xbar₁}) = Ideal.span {y₀, y₁} := by
      rw [Ideal.map_span, Set.image_pair]
    have hInfB : (Ideal.span {y₁} : Ideal B) ⊓ Ideal.span {y₀} = ⊥ :=
      hInf_gen (MvPolynomial (Fin 2) k₀ ⧸ I₀) B Xbar₀ Xbar₁ ψ hEt hR₀_inf
    let qMap₁ : (R₀ ⧸ Ideal.span {Xbar₁}) →+* (B ⧸ Ideal.span {y₁}) :=
      Ideal.quotientMap (Ideal.span {y₁}) ψ (hMap₁ ▸ Ideal.le_comap_map)
    let qMap₀ : (R₀ ⧸ Ideal.span {Xbar₀}) →+* (B ⧸ Ideal.span {y₀}) :=
      Ideal.quotientMap (Ideal.span {y₀}) ψ (hMap₀ ▸ Ideal.le_comap_map)
    let qMap_nd : (R₀ ⧸ Ideal.span {Xbar₀, Xbar₁}) →+* (B ⧸ Ideal.span {y₀, y₁}) :=
      Ideal.quotientMap (Ideal.span {y₀, y₁}) ψ (hMap_nd ▸ Ideal.le_comap_map)
    let α₀ : Polynomial k₀ →+* (B ⧸ Ideal.span {y₁}) := qMap₁.comp g_e₀
    let α₁ : Polynomial k₀ →+* (B ⧸ Ideal.span {y₀}) := qMap₀.comp g_e₁
    have hEt_α₀ : α₀.Etale :=
      RingHom.Etale.stableUnderComposition _ _ (RingHom.Etale.of_bijective hBij_g₀)
        (hQuotEt_gen (MvPolynomial (Fin 2) k₀ ⧸ I₀) B ψ _ _ hMap₁ hEt)
    have hEt_α₁ : α₁.Etale :=
      RingHom.Etale.stableUnderComposition _ _ (RingHom.Etale.of_bijective hBij_g₁)
        (hQuotEt_gen (MvPolynomial (Fin 2) k₀ ⧸ I₀) B ψ _ _ hMap₀ hEt)
    have hEt_nd : ((Ideal.Quotient.mk (Ideal.span {y₀, y₁})).comp c_B).Etale := by
      have h_eq : (Ideal.Quotient.mk (Ideal.span {y₀, y₁})).comp c_B = qMap_nd.comp g_end := by
        ext c
        rw [hc]
        rfl
      rw [h_eq]
      exact RingHom.Etale.stableUnderComposition _ _ (RingHom.Etale.of_bijective hBij_gnd)
        (hQuotEt_gen (MvPolynomial (Fin 2) k₀ ⧸ I₀) B ψ _ _ hMap_nd hEt)
    refine ⟨hInfB, ⟨α₀, hEt_α₀, ?_, ?_⟩, ⟨α₁, hEt_α₁, ?_, ?_⟩, hEt_nd⟩
    · ext c
      change qMap₁ (g_e₀ (Polynomial.C c)) = Ideal.Quotient.mk (Ideal.span {y₁}) (c_B c)
      have h1 : g_e₀ (Polynomial.C c) = Ideal.Quotient.mk (Ideal.span {Xbar₁}) (c_R₀ c) :=
        Polynomial.eval₂_C _ _
      rw [h1, hc]
      rfl
    · change qMap₁ (g_e₀ Polynomial.X) = Ideal.Quotient.mk (Ideal.span {y₁}) y₀
      have h1 : g_e₀ Polynomial.X = Ideal.Quotient.mk (Ideal.span {Xbar₁}) Xbar₀ :=
        Polynomial.eval₂_X _ _
      rw [h1]
      rfl
    · ext c
      change qMap₀ (g_e₁ (Polynomial.C c)) = Ideal.Quotient.mk (Ideal.span {y₀}) (c_B c)
      have h1 : g_e₁ (Polynomial.C c) = Ideal.Quotient.mk (Ideal.span {Xbar₀}) (c_R₀ c) :=
        Polynomial.eval₂_C _ _
      rw [h1, hc]
      rfl
    · change qMap₀ (g_e₁ Polynomial.X) = Ideal.Quotient.mk (Ideal.span {y₀}) y₁
      have h1 : g_e₁ Polynomial.X = Ideal.Quotient.mk (Ideal.span {Xbar₀}) Xbar₁ :=
        Polynomial.eval₂_X _ _
      rw [h1]
      rfl

  
  
  
  have h_s2 : ∀ (Q : Type u) [CommRing Q] (f : k₀ →+* Q),
      f.Etale →
      ∀ (q : Ideal Q) [q.IsPrime],
        (q.IsMaximal ∧ Function.Bijective ((Ideal.Quotient.mk q).comp f)) ∧
        ∃ (u : Q), u ∉ q ∧
          ∀ (w : Q), w ∉ q → u ∣ w →
            ∀ (Q₁ : Type u) [CommRing Q₁] (loc_Q : Q →+* Q₁),
              @IsLocalization.Away Q _ w Q₁ _ loc_Q.toAlgebra →
              Function.Bijective (loc_Q.comp f) := by
    intro Q _ f hf q hqPrime
    letI : Algebra k₀ Q := f.toAlgebra
    haveI : Algebra.Etale k₀ Q := RingHom.etale_algebraMap.mpr hf
    haveI : Algebra.EssFiniteType k₀ Q := Algebra.EssFiniteType.of_finiteType k₀ Q
    haveI : IsNoetherianRing Q := Algebra.FiniteType.isNoetherianRing k₀ Q
    have hPrimeMax : ∀ (P : Ideal Q) [P.IsPrime],
        P.IsMaximal ∧ Function.Bijective ((Ideal.Quotient.mk P).comp f) := by
      intro P hP
      let L := Localization.AtPrime P
      haveI : Algebra.EssFiniteType k₀ L := Algebra.instEssFiniteTypeLocalization k₀ Q P.primeCompl
      haveI : Algebra.FormallyUnramified Q L := Algebra.FormallyUnramified.of_isLocalization P.primeCompl
      haveI : Algebra.FormallyUnramified k₀ L := Algebra.FormallyUnramified.comp k₀ Q L
      have hBijL : Function.Bijective (algebraMap k₀ L) :=
        Algebra.FormallyUnramified.bijective_of_isAlgClosed_of_isLocalRing k₀ L
      have hFieldL : IsField L :=
        Algebra.FormallyUnramified.isField_of_isAlgClosed_of_isLocalRing k₀ L
      have hMaxBot : IsLocalRing.maximalIdeal L = ⊥ :=
        IsLocalRing.isField_iff_maximalIdeal_eq.mp hFieldL
      have hMapP : Ideal.map (algebraMap Q L) P = ⊥ :=
        (IsLocalization.AtPrime.map_eq_maximalIdeal P L).trans hMaxBot
      have hDisjP : Disjoint (P.primeCompl : Set Q) P :=
        Set.disjoint_left.mpr (fun _ hx hxp => hx hxp)
      have hKerL : Ideal.comap (algebraMap Q L) ⊥ = P := by
        rw [← hMapP]
        exact IsLocalization.under_map_of_isPrime_disjoint P.primeCompl L hP hDisjP
      let ι_P : (Q ⧸ P) →+* L :=
        Ideal.Quotient.lift P (algebraMap Q L) (fun x hx => by
          have hx' : x ∈ Ideal.comap (algebraMap Q L) ⊥ := hKerL.symm ▸ hx
          simpa using hx')
      have hInj_ι : Function.Injective ι_P := by
        rw [RingHom.injective_iff_ker_eq_bot, eq_bot_iff]
        intro y hy
        obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
        rw [RingHom.mem_ker] at hy
        have hx0 : algebraMap Q L x = 0 := hy
        have hxP : x ∈ P := by
          rw [← hKerL]
          simpa using hx0
        exact (Submodule.mem_bot _).mpr (Ideal.Quotient.eq_zero_iff_mem.mpr hxP)
      have hComp_ι : ι_P.comp ((Ideal.Quotient.mk P).comp f) = algebraMap k₀ L := by
        ext c
        rfl
      have hBijP : Function.Bijective ((Ideal.Quotient.mk P).comp f) := by
        refine ⟨fun a b hab => hBijL.1 ?_, fun y => ?_⟩
        · rw [← hComp_ι]
          exact congrArg ι_P hab
        · obtain ⟨c, hc⟩ := hBijL.2 (ι_P y)
          rw [← hComp_ι] at hc
          exact ⟨c, hInj_ι hc⟩
      have hFieldQP : IsField (Q ⧸ P) :=
        MulEquiv.isField (Field.toIsField k₀) (RingEquiv.ofBijective _ hBijP).symm.toMulEquiv
      exact ⟨Ideal.Quotient.maximal_of_isField P hFieldQP, hBijP⟩
    refine ⟨hPrimeMax q, ?_⟩
    have hFinMin : (minimalPrimes Q).Finite := minimalPrimes.finite_of_isNoetherianRing Q
    let F : Finset (Ideal Q) := hFinMin.toFinset.filter (· ≠ q)
    have hSep : ∀ P ∈ F, ∃ x : Q, x ∈ P ∧ x ∉ q := by
      intro P hPF
      have hP_mem : P ∈ minimalPrimes Q := hFinMin.mem_toFinset.mp (Finset.mem_of_mem_filter P hPF)
      have hP_ne : P ≠ q := (Finset.mem_filter.mp hPF).2
      haveI : P.IsPrime := hP_mem.1.1
      have hP_max : P.IsMaximal := (hPrimeMax P).1
      have h_not_le : ¬ (P ≤ q) := fun hle => hP_ne (hP_max.eq_of_le hqPrime.ne_top hle)
      exact SetLike.not_le_iff_exists.mp h_not_le
    classical
    let u_fn : Ideal Q → Q := fun P =>
      if h : P ∈ F then Classical.choose (hSep P h) else 1
    have hu_fn_spec : ∀ P ∈ F, u_fn P ∈ P ∧ u_fn P ∉ q := by
      intro P hPF
      simp only [u_fn, hPF, ↓reduceDIte]
      exact Classical.choose_spec (hSep P hPF)
    let u : Q := ∏ P ∈ F, u_fn P
    have hu_not_q : u ∉ q := by
      have h_prod : ∀ S : Finset (Ideal Q), (∀ P ∈ S, u_fn P ∉ q) → (∏ P ∈ S, u_fn P) ∉ q := by
        intro S
        induction S using Finset.induction_on with
        | empty =>
          intro _
          rw [Finset.prod_empty]
          exact hqPrime.one_notMem
        | @insert P S' hPS' ih =>
          intro hS
          rw [Finset.prod_insert hPS']
          intro hmul
          rcases hqPrime.mem_or_mem hmul with huP | hrest
          · exact hS P (Finset.mem_insert_self P S') huP
          · exact ih (fun P' hP' => hS P' (Finset.mem_insert_of_mem hP')) hrest
      exact h_prod F (fun P hPF => (hu_fn_spec P hPF).2)
    refine ⟨u, hu_not_q, ?_⟩
    intro w hwnq hudvd Q₁ _ loc_Q hLocQ
    letI : Algebra Q Q₁ := loc_Q.toAlgebra
    letI : Algebra k₀ Q₁ := (loc_Q.comp f).toAlgebra
    haveI : IsScalarTower k₀ Q Q₁ := IsScalarTower.of_algebraMap_eq' rfl
    haveI : IsLocalization.Away w Q₁ := hLocQ
    have hDisj_wq : Disjoint (Submonoid.powers w : Set Q) q := by
      rw [Set.disjoint_left]
      rintro _ ⟨n, rfl⟩ hnq
      exact hwnq (hqPrime.mem_of_pow_mem n hnq)
    let m₁ : Ideal Q₁ := Ideal.map (algebraMap Q Q₁) q
    have hm₁_prime : m₁.IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers w) Q₁ q hqPrime hDisj_wq
    have hMaxEq : ∀ (M : Ideal Q₁), M.IsMaximal → M = m₁ := by
      intro M hMMax
      haveI : M.IsPrime := hMMax.isPrime
      let P : Ideal Q := Ideal.comap (algebraMap Q Q₁) M
      have hwP : w ∉ P := by
        intro hw
        have hUnit : IsUnit (algebraMap Q Q₁ w) := IsLocalization.Away.algebraMap_isUnit w
        exact hMMax.ne_top (M.eq_top_of_isUnit_mem hw hUnit)
      obtain ⟨P₀, hP₀_min, hP₀_le⟩ := Ideal.exists_minimalPrimes_le (bot_le : (⊥ : Ideal Q) ≤ P)
      have hP₀_eq : P₀ = q := by
        by_contra hne
        have hP₀F : P₀ ∈ F := Finset.mem_filter.mpr ⟨hFinMin.mem_toFinset.mpr hP₀_min, hne⟩
        have hu_P₀ : u_fn P₀ ∈ P₀ := (hu_fn_spec P₀ hP₀F).1
        have hdvd₁ : u_fn P₀ ∣ u := Finset.dvd_prod_of_mem u_fn hP₀F
        have hdvd₂ : u_fn P₀ ∣ w := dvd_trans hdvd₁ hudvd
        obtain ⟨c, rfl⟩ := hdvd₂
        exact hwP (hP₀_le (P₀.mul_mem_right c hu_P₀))
      rw [hP₀_eq] at hP₀_le
      have hP_eq : P = q :=
        ((hPrimeMax q).1.eq_of_le (Ideal.comap_ne_top _ hMMax.ne_top) hP₀_le).symm
      have hMapUnder := IsLocalization.map_under (Submonoid.powers w) Q₁ M
      change Ideal.map (algebraMap Q Q₁) P = M at hMapUnder
      rw [hP_eq] at hMapUnder
      exact hMapUnder.symm
    obtain ⟨M₀, hM₀_max, _⟩ := m₁.exists_le_maximal hm₁_prime.ne_top
    have hm₁_max : m₁.IsMaximal := hMaxEq M₀ hM₀_max ▸ hM₀_max
    haveI : IsLocalRing Q₁ := IsLocalRing.of_unique_max_ideal ⟨m₁, hm₁_max, hMaxEq⟩
    haveI : Algebra.EssFiniteType Q Q₁ :=
      Algebra.EssFiniteType.of_isLocalization Q₁ (Submonoid.powers w)
    haveI : Algebra.EssFiniteType k₀ Q₁ := Algebra.EssFiniteType.comp k₀ Q Q₁
    haveI : Algebra.FormallyUnramified Q Q₁ :=
      Algebra.FormallyUnramified.of_isLocalization (Submonoid.powers w)
    haveI : Algebra.FormallyUnramified k₀ Q₁ := Algebra.FormallyUnramified.comp k₀ Q Q₁
    exact Algebra.FormallyUnramified.bijective_of_isAlgClosed_of_isLocalRing k₀ Q₁

  
  
  
  have hEtalePolyStalk : ∀ (E : Type u) [CommRing E] (β : Polynomial k₀ →+* E),
      β.Etale →
      ∀ (m : Ideal E) [m.IsMaximal],
        IsDomain (Localization.AtPrime m) ∧ IsIntegrallyClosed (Localization.AtPrime m) := by
    intro E _ β hEtE m hmMax
    letI : Algebra (Polynomial k₀) E := β.toAlgebra
    letI : Algebra k₀ E := (β.comp Polynomial.C).toAlgebra
    haveI : IsScalarTower k₀ (Polynomial k₀) E := IsScalarTower.of_algebraMap_eq' rfl
    haveI : Algebra.Etale (Polynomial k₀) E := RingHom.etale_algebraMap.mpr hEtE
    haveI hFT_kE : Algebra.FiniteType k₀ E :=
      Algebra.FiniteType.trans (inferInstance : Algebra.FiniteType k₀ (Polynomial k₀))
        (inferInstance : Algebra.FiniteType (Polynomial k₀) E)
    haveI hNoethE : IsNoetherianRing E := Algebra.FiniteType.isNoetherianRing k₀ E
    haveI : m.IsPrime := hmMax.isPrime
    obtain ⟨n_mv, proj_mv, hproj_surj⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hFT_kE
    let M₀ : Ideal (MvPolynomial (Fin n_mv) k₀) := Ideal.comap proj_mv.toRingHom m
    haveI : M₀.IsMaximal := Ideal.comap_isMaximal_of_surjective proj_mv.toRingHom hproj_surj
    obtain ⟨x_pt, hx_pt⟩ := MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton.mp ‹M₀.IsMaximal›
    obtain ⟨P_X, hP_X⟩ := hproj_surj (β Polynomial.X)
    let a₀ : k₀ := MvPolynomial.aeval x_pt P_X
    have h_diff_M₀ : P_X - MvPolynomial.C a₀ ∈ M₀ := by
      rw [hx_pt, MvPolynomial.mem_vanishingIdeal_singleton_iff]
      simp [a₀]
    let π : Polynomial k₀ := Polynomial.X - Polynomial.C a₀
    let p₀ : Ideal (Polynomial k₀) := Ideal.comap β m
    haveI : p₀.IsPrime := Ideal.comap_isPrime β m
    have hπ_mem : π ∈ p₀ := by
      change β (Polynomial.X - Polynomial.C a₀) ∈ m
      have hproj_diff : proj_mv (P_X - MvPolynomial.C a₀) ∈ m := h_diff_M₀
      rw [map_sub, hP_X, ← MvPolynomial.algebraMap_eq, AlgHom.commutes] at hproj_diff
      rw [map_sub]
      exact hproj_diff
    have hSpanMax : (Ideal.span {π}).IsMaximal :=
      Ideal.Quotient.maximal_of_isField _
        (MulEquiv.isField (Field.toIsField k₀)
          (Polynomial.quotientSpanXSubCAlgEquiv a₀).toRingEquiv.toMulEquiv)
    have hp₀_eq : p₀ = Ideal.span {π} :=
      (hSpanMax.eq_of_le ‹p₀.IsPrime›.ne_top
        (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hπ_mem))).symm
    have hπ_ne : π ≠ 0 := Polynomial.X_sub_C_ne_zero a₀
    let R_loc := Localization.AtPrime p₀
    let S_loc := Localization.AtPrime m
    letI : m.LiesOver p₀ := ⟨rfl⟩
    letI : Algebra R_loc S_loc := Localization.AtPrime.algebraOfLiesOver p₀ m
    haveI : IsNoetherianRing S_loc :=
      IsLocalization.isNoetherianRing m.primeCompl S_loc hNoethE
    haveI : Algebra.FormallyUnramified (Polynomial k₀) S_loc :=
      Algebra.FormallyUnramified.instLocalization (R := Polynomial k₀) (S := E) m.primeCompl
    haveI : Algebra.FormallyUnramified R_loc S_loc :=
      Algebra.FormallyUnramified.localization_base p₀.primeCompl
    haveI : Algebra.EssFiniteType (Polynomial k₀) E :=
      Algebra.EssFiniteType.of_finiteType (Polynomial k₀) E
    haveI : Algebra.EssFiniteType (Polynomial k₀) S_loc :=
      Algebra.instEssFiniteTypeLocalization (Polynomial k₀) E m.primeCompl
    haveI : Algebra.EssFiniteType (Polynomial k₀) R_loc :=
      Algebra.EssFiniteType.of_isLocalization R_loc p₀.primeCompl
    haveI : Algebra.EssFiniteType R_loc S_loc :=
      (Algebra.EssFiniteType.comp_iff (Polynomial k₀) R_loc S_loc).mp inferInstance
    let π_R : R_loc := algebraMap (Polynomial k₀) R_loc π
    let π_S : S_loc := algebraMap R_loc S_loc π_R
    have hπR_ne : π_R ≠ 0 := by
      intro h0
      apply hπ_ne
      exact IsLocalization.injective R_loc p₀.primeCompl_le_nonZeroDivisors
        (h0.trans (map_zero _).symm)
    have hπR_nzd : π_R ∈ nonZeroDivisors R_loc := mem_nonZeroDivisors_of_ne_zero hπR_ne
    have hReg₁ : IsSMulRegular S_loc π_R :=
      Module.Flat.isSMulRegular_of_nonZeroDivisors hπR_nzd
    have hReg : ∀ z : S_loc, π_S * z = 0 → z = 0 := by
      intro z hz
      have hz' : π_R • z = π_R • (0 : S_loc) := by
        rw [smul_zero, Algebra.smul_def]
        exact hz
      exact hReg₁ hz'
    have hRegPow : ∀ (k : ℕ) (z : S_loc), π_S ^ k * z = 0 → z = 0 := by
      intro k
      induction k with
      | zero =>
        intro z hz
        simpa using hz
      | succ k ih =>
        intro z hz
        rw [pow_succ', mul_assoc] at hz
        exact ih z (hReg _ hz)
    have hMaxR : IsLocalRing.maximalIdeal R_loc = Ideal.span {π_R} := by
      rw [← IsLocalization.AtPrime.map_eq_maximalIdeal p₀ R_loc,
        congrArg (Ideal.map (algebraMap (Polynomial k₀) R_loc)) hp₀_eq,
        Ideal.map_span, Set.image_singleton]
    have hMaxS : IsLocalRing.maximalIdeal S_loc = Ideal.span {π_S} := by
      rw [← Algebra.FormallyUnramified.map_maximalIdeal (R := R_loc) (S := S_loc),
        hMaxR, Ideal.map_span, Set.image_singleton]
    let m_S : Ideal S_loc := IsLocalRing.maximalIdeal S_loc
    have hVal : ∀ (n : ℕ) (x : S_loc), x ∉ m_S ^ n →
        ∃ (k : ℕ) (u : S_loc), IsUnit u ∧ x = π_S ^ k * u := by
      intro n
      induction n with
      | zero =>
        intro x hx
        exfalso
        apply hx
        rw [pow_zero, Ideal.one_eq_top]
        trivial
      | succ n ih =>
        intro x hx_succ
        by_cases hxn : x ∈ m_S ^ n
        · have hspan : m_S ^ n = Ideal.span {π_S ^ n} := by
            dsimp [m_S]
            rw [hMaxS, Ideal.span_singleton_pow]
          rw [hspan, Ideal.mem_span_singleton] at hxn
          obtain ⟨u, rfl⟩ := hxn
          have hu_not : u ∉ m_S := by
            intro hu_m
            apply hx_succ
            have hspan_s : m_S ^ (n + 1) = Ideal.span {π_S ^ (n + 1)} := by
              dsimp [m_S]
              rw [hMaxS, Ideal.span_singleton_pow]
            rw [hspan_s, Ideal.mem_span_singleton]
            dsimp [m_S] at hu_m
            rw [hMaxS, Ideal.mem_span_singleton] at hu_m
            obtain ⟨v, rfl⟩ := hu_m
            exact ⟨v, by ring⟩
          exact ⟨n, u, IsLocalRing.notMem_maximalIdeal.mp hu_not, rfl⟩
        · exact ih x hxn
    have hKrull : (⨅ i : ℕ, m_S ^ i) = ⊥ :=
      Ideal.iInf_pow_eq_bot_of_isLocalRing m_S (IsLocalRing.maximalIdeal.isMaximal S_loc).ne_top
    have hVal_ne : ∀ (x : S_loc), x ≠ 0 →
        ∃ (k : ℕ) (u : S_loc), IsUnit u ∧ x = π_S ^ k * u := by
      intro x hx0
      have hx_iInf : x ∉ ⨅ i : ℕ, m_S ^ i := by
        rw [hKrull, Submodule.mem_bot]
        exact hx0
      rw [Ideal.mem_iInf] at hx_iInf
      push Not at hx_iInf
      obtain ⟨nx, hnx⟩ := hx_iInf
      exact hVal nx x hnx
    haveI : NoZeroDivisors S_loc := by
      refine ⟨fun {x y} hxy => ?_⟩
      by_contra h_both
      push Not at h_both
      rcases h_both with ⟨hx0, hy0⟩
      obtain ⟨kx, ux, hux, rfl⟩ := hVal_ne x hx0
      obtain ⟨ky, uy, huy, rfl⟩ := hVal_ne y hy0
      have h_prod : π_S ^ (kx + ky) * (ux * uy) = 0 := by
        calc
          π_S ^ (kx + ky) * (ux * uy) = (π_S ^ kx * ux) * (π_S ^ ky * uy) := by ring
          _ = 0 := hxy
      have hu_zero : ux * uy = 0 := hRegPow (kx + ky) (ux * uy) h_prod
      exact (hux.mul huy).ne_zero hu_zero
    haveI hDomS : IsDomain S_loc := IsDomain.mk
    classical
    haveI : IsPrincipalIdealRing S_loc := ⟨fun I => by
      by_cases hI : I = ⊥
      · rw [hI]
        exact ⟨⟨0, by simp⟩⟩
      · have ⟨x, hxI, hx0⟩ : ∃ x ∈ I, x ≠ 0 := by
          by_contra h_all
          push Not at h_all
          exact hI (eq_bot_iff.mpr fun y hy => (Submodule.mem_bot _).mpr (h_all y hy))
        obtain ⟨kx, ux, hux, rfl⟩ := hVal_ne x hx0
        obtain ⟨ux_u, rfl⟩ := hux
        have hex : ∃ k : ℕ, π_S ^ k ∈ I := ⟨kx, by
          have hmul := I.mul_mem_right (ux_u⁻¹ : S_locˣ).val hxI
          simpa [mul_assoc] using hmul⟩
        let k₀_i : ℕ := Nat.find hex
        have hk₀_mem : π_S ^ k₀_i ∈ I := Nat.find_spec hex
        refine ⟨⟨π_S ^ k₀_i, le_antisymm ?_ (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hk₀_mem))⟩⟩
        intro y hyI
        by_cases hy0 : y = 0
        · rw [hy0]
          exact (Submodule.span S_loc {π_S ^ k₀_i}).zero_mem
        · obtain ⟨ky, uy, huy, rfl⟩ := hVal_ne y hy0
          obtain ⟨uy_u, rfl⟩ := huy
          have hky_mem : π_S ^ ky ∈ I := by
            have hmul := I.mul_mem_right (uy_u⁻¹ : S_locˣ).val hyI
            simpa [mul_assoc] using hmul
          have hk₀_le : k₀_i ≤ ky := Nat.find_min' hex hky_mem
          rw [Ideal.mem_span_singleton]
          refine ⟨π_S ^ (ky - k₀_i) * (uy_u : S_loc), ?_⟩
          calc
            π_S ^ ky * (uy_u : S_loc) =
                (π_S ^ k₀_i * π_S ^ (ky - k₀_i)) * (uy_u : S_loc) := by
              rw [← pow_add, Nat.add_sub_of_le hk₀_le]
            _ = π_S ^ k₀_i * (π_S ^ (ky - k₀_i) * (uy_u : S_loc)) := by ring⟩
    exact ⟨hDomS, inferInstance⟩

  have h_s3 : ∀ (C : Type u) [CommRing C] (α : Polynomial k₀ →+* C),
      α.Etale →
      ∀ (q : Ideal C) [q.IsPrime],
        α Polynomial.X ∈ q →
        ∃ (c₀ : C), c₀ ∉ q ∧
          ∀ (w : C), w ∉ q → c₀ ∣ w →
            ∀ (D : Type u) [CommRing D] (loc_C : C →+* D),
              @IsLocalization.Away C _ w D _ loc_C.toAlgebra →
              IsDomain D ∧ IsIntegrallyClosed D ∧
              (Ideal.map loc_C q).IsPrime ∧
              Ideal.comap loc_C (Ideal.map loc_C q) = q ∧
              Ideal.map loc_C q ≠ ⊥ := by
    intro C _ α hEt q hqPrime hX
    letI : Algebra (Polynomial k₀) C := α.toAlgebra
    letI : Algebra k₀ C := (α.comp Polynomial.C).toAlgebra
    haveI : IsScalarTower k₀ (Polynomial k₀) C := IsScalarTower.of_algebraMap_eq' rfl
    haveI : Algebra.Etale (Polynomial k₀) C := RingHom.etale_algebraMap.mpr hEt
    haveI hFT_kC : Algebra.FiniteType k₀ C :=
      Algebra.FiniteType.trans (inferInstance : Algebra.FiniteType k₀ (Polynomial k₀))
        (inferInstance : Algebra.FiniteType (Polynomial k₀) C)
    haveI hNoethC : IsNoetherianRing C := Algebra.FiniteType.isNoetherianRing k₀ C
    have hStalkDom : ∀ (m : Ideal C) [m.IsMaximal], IsDomain (Localization.AtPrime m) :=
      fun m _ => (hEtalePolyStalk C α hEt m).1
    
    haveI hRedC : IsReduced C :=
      isReduced_ofLocalizationMaximal C (fun m hm => by
        haveI : m.IsMaximal := hm
        haveI : IsDomain (Localization.AtPrime m) := hStalkDom m
        infer_instance)
    obtain ⟨p_star, hp_star_min, hp_star_le⟩ :=
      Ideal.exists_minimalPrimes_le (bot_le : (⊥ : Ideal C) ≤ q)
    obtain ⟨m_q, hm_q_max, hq_le_m⟩ := q.exists_le_maximal hqPrime.ne_top
    have hUniqMin : ∀ p' ∈ minimalPrimes C, p' ≤ q → p' = p_star := by
      intro p' hp'_min hp'_le
      haveI : m_q.IsMaximal := hm_q_max
      haveI : m_q.IsPrime := hm_q_max.isPrime
      let S_m := Localization.AtPrime m_q
      haveI : IsDomain S_m := hStalkDom m_q
      let p_bot : Ideal C := Ideal.comap (algebraMap C S_m) ⊥
      have hp_bot_prime : p_bot.IsPrime := Ideal.comap_isPrime (algebraMap C S_m) ⊥
      have h_eq_bot : ∀ r ∈ minimalPrimes C, r ≤ q → r = p_bot := by
        intro r hr_min hr_le
        have hr_m : r ≤ m_q := hr_le.trans hq_le_m
        have hDisj_r : Disjoint (m_q.primeCompl : Set C) r :=
          Set.disjoint_left.mpr (fun _ hx hxr => hx (hr_m hxr))
        have hUnder :=
          IsLocalization.under_map_of_isPrime_disjoint m_q.primeCompl S_m hr_min.1.1 hDisj_r
        have hbot_le : p_bot ≤ r := by
          rw [← hUnder]
          exact Ideal.comap_mono bot_le
        exact le_antisymm (hr_min.2 ⟨hp_bot_prime, bot_le⟩ hbot_le) hbot_le
      exact (h_eq_bot p' hp'_min hp'_le).trans (h_eq_bot p_star hp_star_min hp_star_le).symm
    have hFinMinC : (minimalPrimes C).Finite := minimalPrimes.finite_of_isNoetherianRing C
    let F_C : Finset (Ideal C) := hFinMinC.toFinset.filter (· ≠ p_star)
    have hSepC : ∀ p ∈ F_C, ∃ c : C, c ∈ p ∧ c ∉ q := by
      intro p hpF
      have hp_min : p ∈ minimalPrimes C := hFinMinC.mem_toFinset.mp (Finset.mem_of_mem_filter p hpF)
      have hp_ne : p ≠ p_star := (Finset.mem_filter.mp hpF).2
      have h_not_le : ¬ (p ≤ q) := fun hle => hp_ne (hUniqMin p hp_min hle)
      exact SetLike.not_le_iff_exists.mp h_not_le
    classical
    let c_fn : Ideal C → C := fun p =>
      if h : p ∈ F_C then Classical.choose (hSepC p h) else 1
    have hc_fn_spec : ∀ p ∈ F_C, c_fn p ∈ p ∧ c_fn p ∉ q := by
      intro p hpF
      simp only [c_fn, hpF, ↓reduceDIte]
      exact Classical.choose_spec (hSepC p hpF)
    let c₀ : C := ∏ p ∈ F_C, c_fn p
    have hc₀_not_q : c₀ ∉ q := by
      have h_prod : ∀ S : Finset (Ideal C), (∀ p ∈ S, c_fn p ∉ q) → (∏ p ∈ S, c_fn p) ∉ q := by
        intro S
        induction S using Finset.induction_on with
        | empty =>
          intro _
          rw [Finset.prod_empty]
          exact hqPrime.one_notMem
        | @insert p S' hpS' ih =>
          intro hS
          rw [Finset.prod_insert hpS']
          intro hmul
          rcases hqPrime.mem_or_mem hmul with hcp | hrest
          · exact hS p (Finset.mem_insert_self p S') hcp
          · exact ih (fun p' hp' => hS p' (Finset.mem_insert_of_mem hp')) hrest
      exact h_prod F_C (fun p hpF => (hc_fn_spec p hpF).2)
    have hKill : ∀ x ∈ p_star, x * c₀ = 0 := by
      intro x hx
      apply IsNilpotent.eq_zero
      rw [← mem_nilradical, nilradical_eq_sInf, Ideal.mem_sInf]
      intro P hPPrime
      haveI : P.IsPrime := hPPrime
      obtain ⟨p₀, hp₀_min, hp₀_le⟩ := Ideal.exists_minimalPrimes_le (bot_le : (⊥ : Ideal C) ≤ P)
      by_cases hp₀_eq : p₀ = p_star
      · rw [hp₀_eq] at hp₀_le
        exact P.mul_mem_right c₀ (hp₀_le hx)
      · have hp₀F : p₀ ∈ F_C := Finset.mem_filter.mpr ⟨hFinMinC.mem_toFinset.mpr hp₀_min, hp₀_eq⟩
        have hc_p₀ : c_fn p₀ ∈ p₀ := (hc_fn_spec p₀ hp₀F).1
        obtain ⟨u_c, hu_c⟩ := Finset.dvd_prod_of_mem c_fn hp₀F
        dsimp [c₀]
        rw [hu_c]
        exact P.mul_mem_left x (P.mul_mem_right u_c (hp₀_le hc_p₀))
    
    refine ⟨c₀, hc₀_not_q, ?_⟩
    intro w hwnq hc₀_dvd D _ loc_C hLocD
    letI : Algebra C D := loc_C.toAlgebra
    haveI : IsLocalization.Away w D := hLocD
    have hw_not_pstar : w ∉ p_star := fun hw => hwnq (hp_star_le hw)
    have hDisj_pstar : Disjoint (Submonoid.powers w : Set C) p_star := by
      rw [Set.disjoint_left]
      rintro _ ⟨n, rfl⟩ hnp
      exact hw_not_pstar (hp_star_min.1.1.mem_of_pow_mem n hnp)
    have hMapPstar_prime : (Ideal.map (algebraMap C D) p_star).IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers w) D p_star
        hp_star_min.1.1 hDisj_pstar
    obtain ⟨v_w, hv_w⟩ := hc₀_dvd
    have hMapPstar_bot : Ideal.map (algebraMap C D) p_star = ⊥ := by
      rw [eq_bot_iff, Ideal.map_le_iff_le_comap]
      intro x hx
      rw [Ideal.mem_comap, Submodule.mem_bot]
      have hxw : x * w = 0 := by
        rw [hv_w, ← mul_assoc, hKill x hx, zero_mul]
      have hloc_xw : algebraMap C D x * algebraMap C D w = 0 := by
        rw [← map_mul, hxw, map_zero]
      obtain ⟨u_w, hu_w⟩ := IsLocalization.Away.algebraMap_isUnit w (S := D)
      rw [← hu_w] at hloc_xw
      have hx0 := congrArg (· * (u_w⁻¹ : Dˣ).val) hloc_xw
      simpa [mul_assoc] using hx0
    have hBotPrime : (⊥ : Ideal D).IsPrime := hMapPstar_bot ▸ hMapPstar_prime
    haveI hDomD : IsDomain D := IsDomain.of_bot_isPrime D
    have hDisj_wq : Disjoint (Submonoid.powers w : Set C) q := by
      rw [Set.disjoint_left]
      rintro _ ⟨n, rfl⟩ hnq
      exact hwnq (hqPrime.mem_of_pow_mem n hnq)
    let qbar : Ideal D := Ideal.map (algebraMap C D) q
    haveI hqbar_prime : qbar.IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers w) D q hqPrime hDisj_wq
    have hqbar_comap : Ideal.comap loc_C qbar = q :=
      IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers w) D hqPrime hDisj_wq
    have hEt_locC : loc_C.Etale :=
      (RingHom.etale_algebraMap (R := C) (S := D)).mpr (Algebra.Etale.of_isLocalizationAway w)
    have hEt_comp : (loc_C.comp α).Etale :=
      RingHom.Etale.stableUnderComposition _ _ hEt hEt_locC
    letI : Algebra (Polynomial k₀) D := (loc_C.comp α).toAlgebra
    haveI hEtPolyD : Algebra.Etale (Polynomial k₀) D := RingHom.etale_algebraMap.mpr hEt_comp
    have hICD : IsIntegrallyClosed D :=
      IsIntegrallyClosed.of_localization_maximal (fun p _ _ =>
        (hEtalePolyStalk D (loc_C.comp α) hEt_comp p).2)
    let p_X : Ideal (Polynomial k₀) := Ideal.comap (loc_C.comp α) qbar
    haveI : p_X.IsPrime := Ideal.comap_isPrime (loc_C.comp α) qbar
    letI : qbar.LiesOver p_X := ⟨rfl⟩
    haveI : (⊥ : Ideal (Polynomial k₀)).IsPrime := inferInstance
    have hp_X_pos : (⊥ : Ideal (Polynomial k₀)) < p_X := by
      rw [bot_lt_iff_ne_bot]
      intro hbot
      have hX_mem : Polynomial.X ∈ p_X := by
        change α Polynomial.X ∈ Ideal.comap loc_C qbar
        rwa [hqbar_comap]
      rw [hbot, Submodule.mem_bot] at hX_mem
      exact Polynomial.X_ne_zero hX_mem
    haveI : Algebra.HasGoingDown (Polynomial k₀) D := Algebra.HasGoingDown.of_flat
    obtain ⟨P_low, hP_lt, _, _⟩ := Ideal.exists_ideal_lt_liesOver_of_lt qbar hp_X_pos
    have hqbar_ne_bot : qbar ≠ ⊥ := ne_bot_of_gt hP_lt
    exact ⟨hDomD, hICD, hqbar_prime, hqbar_comap, hqbar_ne_bot⟩

  
  
  
  have h_s4 : ∀ (A₁ B'₁ : Type u) [CommRing A₁] [CommRing B'₁]
      (φ₁ : A₁ →+* B'₁),
      φ₁.Etale →
      Function.Surjective (PrimeSpectrum.comap φ₁) →
      ∀ (p_y1 : Ideal A₁) [p_y1.IsPrime] (q₁ : Ideal B'₁) [q₁.IsPrime],
        Ideal.comap φ₁ q₁ = p_y1 →
        ∀ (x₀ x₁ : B'₁),
          (Ideal.span {x₁} : Ideal B'₁) ⊓ Ideal.span {x₀} = ⊥ →
          Ideal.span {x₀, x₁} = q₁ →
          IsDomain (B'₁ ⧸ Ideal.span {x₁}) →
          IsDomain (B'₁ ⧸ Ideal.span {x₀}) →
          ∀ (qbar₀ : Ideal (B'₁ ⧸ Ideal.span {x₁})) [qbar₀.IsPrime]
            (qbar₁ : Ideal (B'₁ ⧸ Ideal.span {x₀})) [qbar₁.IsPrime],
            Ideal.comap (Ideal.Quotient.mk (Ideal.span {x₁})) qbar₀ = q₁ →
            Ideal.comap (Ideal.Quotient.mk (Ideal.span {x₀})) qbar₁ = q₁ →
            qbar₀ ≠ ⊥ →
            qbar₁ ≠ ⊥ →
            let π₀ := Ideal.Quotient.mk (Ideal.span {x₁})
            let π₁ := Ideal.Quotient.mk (Ideal.span {x₀})
            Ideal.comap (π₀.comp φ₁) qbar₀ = p_y1 ∧
            Ideal.comap (π₁.comp φ₁) qbar₁ = p_y1 ∧
            Ideal.comap (π₀.comp φ₁) ⊥ ≠ p_y1 ∧
            Ideal.comap (π₁.comp φ₁) ⊥ ≠ p_y1 ∧
            ∃ (s : A₁),
              s ∈ p_y1 ∧
              s ∈ nonZeroDivisors A₁ ∧
              π₀ (φ₁ s) ≠ 0 ∧
              π₁ (φ₁ s) ≠ 0 ∧
              ∀ (r₀ a₀ : A₁) (d₀ : B'₁ ⧸ Ideal.span {x₁}) (d₁ : B'₁ ⧸ Ideal.span {x₀}) (N : ℕ),
                d₀ - π₀ (φ₁ r₀) ∈ qbar₀ →
                d₁ - π₁ (φ₁ r₀) ∈ qbar₁ →
                (π₀ (φ₁ s)) ^ N * d₀ = π₀ (φ₁ a₀) →
                (π₁ (φ₁ s)) ^ N * d₁ = π₁ (φ₁ a₀) →
                ∃ (a₁ : A₁), s ^ N * a₁ = a₀ := by
    intro A₁ B'₁ _ _ φ₁ hEt hSurj p_y1 hp_y1 q₁ hq₁ hComap₁ x₀ x₁ hInf hSup
      hDom₀ hDom₁ qbar₀ hqbar₀ qbar₁ hqbar₁ hq₀ hq₁_c hNe₀ hNe₁
    dsimp only
    let π₀ : B'₁ →+* (B'₁ ⧸ Ideal.span {x₁}) := Ideal.Quotient.mk (Ideal.span {x₁})
    let π₁ : B'₁ →+* (B'₁ ⧸ Ideal.span {x₀}) := Ideal.Quotient.mk (Ideal.span {x₀})
    have hComap_q₀ : Ideal.comap (π₀.comp φ₁) qbar₀ = p_y1 := by
      rw [← Ideal.comap_comap, hq₀, hComap₁]
    have hComap_q₁ : Ideal.comap (π₁.comp φ₁) qbar₁ = p_y1 := by
      rw [← Ideal.comap_comap, hq₁_c, hComap₁]
    letI : Algebra A₁ B'₁ := φ₁.toAlgebra
    haveI : Algebra.Etale A₁ B'₁ := RingHom.etale_algebraMap.mpr hEt
    haveI : Module.FaithfullyFlat A₁ B'₁ := Module.FaithfullyFlat.of_comap_surjective hSurj
    letI : q₁.LiesOver p_y1 := ⟨hComap₁.symm⟩
    let R₁ := Localization.AtPrime p_y1
    let S₁ := Localization.AtPrime q₁
    letI : Algebra R₁ S₁ := Localization.AtPrime.algebraOfLiesOver p_y1 q₁
    haveI : Algebra.FormallyUnramified A₁ S₁ :=
      Algebra.FormallyUnramified.instLocalization (R := A₁) (S := B'₁) q₁.primeCompl
    haveI : Algebra.FormallyUnramified R₁ S₁ :=
      Algebra.FormallyUnramified.localization_base p_y1.primeCompl
    haveI : Algebra.EssFiniteType A₁ B'₁ := Algebra.EssFiniteType.of_finiteType A₁ B'₁
    haveI : Algebra.EssFiniteType A₁ S₁ :=
      Algebra.instEssFiniteTypeLocalization A₁ B'₁ q₁.primeCompl
    haveI : Algebra.EssFiniteType A₁ R₁ :=
      Algebra.EssFiniteType.of_isLocalization R₁ p_y1.primeCompl
    haveI : Algebra.EssFiniteType R₁ S₁ :=
      (Algebra.EssFiniteType.comp_iff A₁ R₁ S₁).mp inferInstance
    have hStalkIncomp : ∀ (P : Ideal B'₁), P.IsPrime → P ≤ q₁ →
        Ideal.comap φ₁ P = p_y1 → P = q₁ := by
      intro P hPPrime hP_le hP_comap
      have hMapMax : Ideal.map (algebraMap B'₁ S₁) (Ideal.map φ₁ p_y1) =
          Ideal.map (algebraMap B'₁ S₁) q₁ := by
        have h1 := Algebra.FormallyUnramified.map_maximalIdeal (R := R₁) (S := S₁)
        rw [← IsLocalization.AtPrime.map_eq_maximalIdeal p_y1 R₁,
          ← IsLocalization.AtPrime.map_eq_maximalIdeal q₁ S₁, Ideal.map_map,
          ← IsScalarTower.algebraMap_eq A₁ R₁ S₁,
          IsScalarTower.algebraMap_eq A₁ B'₁ S₁, ← Ideal.map_map] at h1
        exact h1
      have h_le_P : Ideal.map φ₁ p_y1 ≤ P :=
        Ideal.map_le_iff_le_comap.mpr hP_comap.symm.le
      have hMapEq : Ideal.map (algebraMap B'₁ S₁) P = Ideal.map (algebraMap B'₁ S₁) q₁ :=
        le_antisymm (Ideal.map_mono hP_le) (hMapMax ▸ Ideal.map_mono h_le_P)
      have hDisjP : Disjoint (q₁.primeCompl : Set B'₁) P :=
        Set.disjoint_left.mpr (fun _ hx hxp => hx (hP_le hxp))
      have hDisjQ : Disjoint (q₁.primeCompl : Set B'₁) q₁ :=
        Set.disjoint_left.mpr (fun _ hx hxq => hx hxq)
      calc
        P = Ideal.comap (algebraMap B'₁ S₁) (Ideal.map (algebraMap B'₁ S₁) P) :=
          (IsLocalization.under_map_of_isPrime_disjoint q₁.primeCompl S₁ hPPrime hDisjP).symm
        _ = Ideal.comap (algebraMap B'₁ S₁) (Ideal.map (algebraMap B'₁ S₁) q₁) := by
          rw [hMapEq]
        _ = q₁ :=
          IsLocalization.under_map_of_isPrime_disjoint q₁.primeCompl S₁ hq₁ hDisjQ
    have hNeBot₀ : Ideal.comap (π₀.comp φ₁) ⊥ ≠ p_y1 := by
      intro hEq
      haveI : IsDomain (B'₁ ⧸ Ideal.span {x₁}) := hDom₀
      haveI : (⊥ : Ideal (B'₁ ⧸ Ideal.span {x₁})).IsPrime := inferInstance
      let P₀ : Ideal B'₁ := Ideal.comap π₀ ⊥
      have hP₀_prime : P₀.IsPrime := Ideal.comap_isPrime π₀ ⊥
      have hP₀_le : P₀ ≤ q₁ := by
        rw [← hq₀]
        exact Ideal.comap_mono bot_le
      have hP₀_eq : P₀ = q₁ := hStalkIncomp P₀ hP₀_prime hP₀_le (by rwa [← Ideal.comap_comap] at hEq)
      have ⟨y, hy_mem, hy_ne⟩ : ∃ y ∈ qbar₀, y ≠ 0 := by
        by_contra h_all
        push Not at h_all
        exact hNe₀ (eq_bot_iff.mpr fun y hy => (Submodule.mem_bot _).mpr (h_all y hy))
      obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective y
      have hz_q₁ : z ∈ q₁ := by
        rw [← hq₀]
        exact hy_mem
      rw [← hP₀_eq] at hz_q₁
      exact hy_ne hz_q₁
    have hNeBot₁ : Ideal.comap (π₁.comp φ₁) ⊥ ≠ p_y1 := by
      intro hEq
      haveI : IsDomain (B'₁ ⧸ Ideal.span {x₀}) := hDom₁
      haveI : (⊥ : Ideal (B'₁ ⧸ Ideal.span {x₀})).IsPrime := inferInstance
      let P₁ : Ideal B'₁ := Ideal.comap π₁ ⊥
      have hP₁_prime : P₁.IsPrime := Ideal.comap_isPrime π₁ ⊥
      have hP₁_le : P₁ ≤ q₁ := by
        rw [← hq₁_c]
        exact Ideal.comap_mono bot_le
      have hP₁_eq : P₁ = q₁ := hStalkIncomp P₁ hP₁_prime hP₁_le (by rwa [← Ideal.comap_comap] at hEq)
      have ⟨y, hy_mem, hy_ne⟩ : ∃ y ∈ qbar₁, y ≠ 0 := by
        by_contra h_all
        push Not at h_all
        exact hNe₁ (eq_bot_iff.mpr fun y hy => (Submodule.mem_bot _).mpr (h_all y hy))
      obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective y
      have hz_q₁ : z ∈ q₁ := by
        rw [← hq₁_c]
        exact hy_mem
      rw [← hP₁_eq] at hz_q₁
      exact hy_ne hz_q₁
    have hNotLe₀ : ¬ (p_y1 ≤ Ideal.comap (π₀.comp φ₁) ⊥) := by
      intro hle
      apply hNeBot₀
      refine le_antisymm ?_ hle
      rw [← hComap_q₀]
      exact Ideal.comap_mono bot_le
    have hNotLe₁ : ¬ (p_y1 ≤ Ideal.comap (π₁.comp φ₁) ⊥) := by
      intro hle
      apply hNeBot₁
      refine le_antisymm ?_ hle
      rw [← hComap_q₁]
      exact Ideal.comap_mono bot_le
    obtain ⟨s₀, hs₀_mem, hs₀_not⟩ := SetLike.not_le_iff_exists.mp hNotLe₀
    obtain ⟨s₁, hs₁_mem, hs₁_not⟩ := SetLike.not_le_iff_exists.mp hNotLe₁
    have hs₀_ne : π₀ (φ₁ s₀) ≠ 0 := hs₀_not
    have hs₁_ne : π₁ (φ₁ s₁) ≠ 0 := hs₁_not
    classical
    let s : A₁ :=
      if π₁ (φ₁ s₀) = 0 then (if π₀ (φ₁ s₁) = 0 then s₀ + s₁ else s₁) else s₀
    have hs_mem : s ∈ p_y1 := by
      dsimp [s]
      split_ifs
      · exact p_y1.add_mem hs₀_mem hs₁_mem
      · exact hs₁_mem
      · exact hs₀_mem
    have hs_ne₀ : π₀ (φ₁ s) ≠ 0 := by
      dsimp [s]
      split_ifs with h1 h2
      · rw [map_add, map_add, h2, add_zero]
        exact hs₀_ne
      · exact h2
      · exact hs₀_ne
    have hs_ne₁ : π₁ (φ₁ s) ≠ 0 := by
      dsimp [s]
      split_ifs with h1 h2
      · rw [map_add, map_add, h1, zero_add]
        exact hs₁_ne
      · exact hs₁_ne
      · exact h1
    have hInj_φ₁ : Function.Injective φ₁ := by
      rw [RingHom.injective_iff_ker_eq_bot]
      change Ideal.comap (algebraMap A₁ B'₁) ⊥ = ⊥
      rw [← Ideal.map_bot (f := algebraMap A₁ B'₁)]
      exact Ideal.comap_map_eq_self_of_faithfullyFlat ⊥
    have hs_nzd : s ∈ nonZeroDivisors A₁ := by
      rw [mem_nonZeroDivisors_iff_right]
      intro z hzs
      haveI : IsDomain (B'₁ ⧸ Ideal.span {x₁}) := hDom₀
      haveI : IsDomain (B'₁ ⧸ Ideal.span {x₀}) := hDom₁
      have hz₀ : π₀ (φ₁ z) = 0 := by
        have hmul : π₀ (φ₁ z) * π₀ (φ₁ s) = 0 := by
          rw [← map_mul, ← map_mul, hzs, map_zero, map_zero]
        exact (mul_eq_zero.mp hmul).resolve_right hs_ne₀
      have hz₁ : π₁ (φ₁ z) = 0 := by
        have hmul : π₁ (φ₁ z) * π₁ (φ₁ s) = 0 := by
          rw [← map_mul, ← map_mul, hzs, map_zero, map_zero]
        exact (mul_eq_zero.mp hmul).resolve_right hs_ne₁
      have hφz_inf : φ₁ z ∈ (Ideal.span {x₁} : Ideal B'₁) ⊓ Ideal.span {x₀} :=
        ⟨Ideal.Quotient.eq_zero_iff_mem.mp hz₀, Ideal.Quotient.eq_zero_iff_mem.mp hz₁⟩
      rw [hInf, Submodule.mem_bot] at hφz_inf
      exact hInj_φ₁ (hφz_inf.trans (map_zero φ₁).symm)
    refine ⟨hComap_q₀, hComap_q₁, hNeBot₀, hNeBot₁, s, hs_mem, hs_nzd, hs_ne₀, hs_ne₁, ?_⟩
    intro r₀ a₀ d₀ d₁ N hd₀ hd₁ heq₀ heq₁
    obtain ⟨b₀, rfl⟩ := Ideal.Quotient.mk_surjective d₀
    obtain ⟨b₁, rfl⟩ := Ideal.Quotient.mk_surjective d₁
    have hb₀_q₁ : b₀ - φ₁ r₀ ∈ q₁ := by
      rw [← hq₀, Ideal.mem_comap, map_sub]
      exact hd₀
    have hb₁_q₁ : b₁ - φ₁ r₀ ∈ q₁ := by
      rw [← hq₁_c, Ideal.mem_comap, map_sub]
      exact hd₁
    have hdiff_sup : b₀ - b₁ ∈ (Ideal.span {x₀} : Ideal B'₁) ⊔ Ideal.span {x₁} := by
      rw [← Ideal.span_insert, hSup]
      have hsub : b₀ - b₁ = (b₀ - φ₁ r₀) - (b₁ - φ₁ r₀) := by ring
      rw [hsub]
      exact q₁.sub_mem hb₀_q₁ hb₁_q₁
    obtain ⟨u₀, hu₀_mem, u₁, hu₁_mem, hu_sum⟩ := Submodule.mem_sup.mp hdiff_sup
    let b : B'₁ := b₀ - u₁
    have hb_eq₁ : b = b₁ + u₀ := by
      dsimp [b]
      linear_combination -hu_sum
    have hπ₀_b : π₀ b = π₀ b₀ := by
      dsimp [b]
      rw [map_sub, Ideal.Quotient.eq_zero_iff_mem.mpr hu₁_mem, sub_zero]
    have hπ₁_b : π₁ b = π₁ b₁ := by
      rw [hb_eq₁, map_add, Ideal.Quotient.eq_zero_iff_mem.mpr hu₀_mem, add_zero]
    have hrem₀ : φ₁ (s ^ N) * b - φ₁ a₀ ∈ Ideal.span {x₁} := by
      rw [← Ideal.Quotient.eq_zero_iff_mem]
      change π₀ (φ₁ (s ^ N) * b - φ₁ a₀) = 0
      rw [map_sub, map_mul, map_pow, map_pow, hπ₀_b, heq₀, sub_self]
    have hrem₁ : φ₁ (s ^ N) * b - φ₁ a₀ ∈ Ideal.span {x₀} := by
      rw [← Ideal.Quotient.eq_zero_iff_mem]
      change π₁ (φ₁ (s ^ N) * b - φ₁ a₀) = 0
      rw [map_sub, map_mul, map_pow, map_pow, hπ₁_b, heq₁, sub_self]
    have hrem_bot : φ₁ (s ^ N) * b - φ₁ a₀ ∈ (⊥ : Ideal B'₁) := by
      rw [← hInf]
      exact ⟨hrem₀, hrem₁⟩
    have hφa₀_eq : φ₁ a₀ = φ₁ (s ^ N) * b :=
      (sub_eq_zero.mp ((Submodule.mem_bot B'₁).mp hrem_bot)).symm
    have hφa₀_map : φ₁ a₀ ∈ Ideal.map (algebraMap A₁ B'₁) (Ideal.span {s ^ N}) := by
      rw [hφa₀_eq]
      exact Ideal.mul_mem_right b _
        (Ideal.mem_map_of_mem (algebraMap A₁ B'₁) (Ideal.mem_span_singleton_self (s ^ N)))
    have ha₀_span : a₀ ∈ Ideal.span {s ^ N} := by
      rw [← Ideal.comap_map_eq_self_of_faithfullyFlat (B := B'₁) (Ideal.span {s ^ N})]
      exact hφa₀_map
    obtain ⟨a₁, ha₁⟩ := Ideal.mem_span_singleton.mp ha₀_span
    exact ⟨a₁, ha₁.symm⟩

  
  
  
  have hQuotPrime : ∀ {R : Type u} [CommRing R] (I q : Ideal R) [q.IsPrime],
      I ≤ q →
      (Ideal.map (Ideal.Quotient.mk I) q).IsPrime ∧
      Ideal.comap (Ideal.Quotient.mk I) (Ideal.map (Ideal.Quotient.mk I) q) = q := by
    intro R _ I q hq hIq
    have hker : RingHom.ker (Ideal.Quotient.mk I) = I := Ideal.mk_ker
    refine ⟨Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective (by rwa [hker]), ?_⟩
    rw [Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective,
      ← RingHom.ker_eq_comap_bot, hker, sup_eq_left.mpr hIq]

  let y₀ : B' := ψ₀ Xbar₀
  let y₁ : B' := ψ₀ Xbar₁
  let c_B : k₀ →+* B' := φ₀.comp c_A
  obtain ⟨_, ⟨α₀, hEtα₀, _, hα₀_X⟩, ⟨α₁, hEtα₁, _, hα₁_X⟩, hEt_nd⟩ :=
    h_s1 B' c_B ψ₀ hEtψ₀ hCompat
  let C₀ := B' ⧸ Ideal.span {y₁}
  let C₁ := B' ⧸ Ideal.span {y₀}
  let Q' := B' ⧸ Ideal.span {y₀, y₁}
  let π_C₀ : B' →+* C₀ := Ideal.Quotient.mk (Ideal.span {y₁})
  let π_C₁ : B' →+* C₁ := Ideal.Quotient.mk (Ideal.span {y₀})
  let π_nd : B' →+* Q' := Ideal.Quotient.mk (Ideal.span {y₀, y₁})
  have hy₀_q₀ : y₀ ∈ q₀ := hNode 0
  have hy₁_q₀ : y₁ ∈ q₀ := hNode 1
  have hLe_C₀ : Ideal.span {y₁} ≤ q₀ := Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hy₁_q₀)
  have hLe_C₁ : Ideal.span {y₀} ≤ q₀ := Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hy₀_q₀)
  have hLe_nd : Ideal.span {y₀, y₁} ≤ q₀ := by
    rw [Ideal.span_le]
    rintro _ (rfl | rfl)
    · exact hy₀_q₀
    · exact hy₁_q₀
  let q_C₀ : Ideal C₀ := Ideal.map π_C₀ q₀
  let q_C₁ : Ideal C₁ := Ideal.map π_C₁ q₀
  let q_nd : Ideal Q' := Ideal.map π_nd q₀
  haveI : q_C₀.IsPrime := (hQuotPrime _ q₀ hLe_C₀).1
  have hComap_qC₀ : Ideal.comap π_C₀ q_C₀ = q₀ := (hQuotPrime _ q₀ hLe_C₀).2
  haveI : q_C₁.IsPrime := (hQuotPrime _ q₀ hLe_C₁).1
  have hComap_qC₁ : Ideal.comap π_C₁ q_C₁ = q₀ := (hQuotPrime _ q₀ hLe_C₁).2
  haveI : q_nd.IsPrime := (hQuotPrime _ q₀ hLe_nd).1
  have hComap_qnd : Ideal.comap π_nd q_nd = q₀ := (hQuotPrime _ q₀ hLe_nd).2

  
  obtain ⟨⟨_, hBij_nd⟩, u_nd, hu_nd, hAway_nd⟩ := h_s2 Q' (π_nd.comp c_B) hEt_nd q_nd
  let θ_A : A →+* (Q' ⧸ q_nd) := (Ideal.Quotient.mk q_nd).comp (π_nd.comp φ₀)
  have hKer_θ : Ideal.comap θ_A ⊥ = p_y := by
    change Ideal.comap φ₀ (Ideal.comap π_nd (Ideal.comap (Ideal.Quotient.mk q_nd) ⊥)) = p_y
    rw [← RingHom.ker_eq_comap_bot, Ideal.mk_ker, hComap_qnd, hComap]
  let φ_bar : (A ⧸ p_y) →+* (Q' ⧸ q_nd) :=
    Ideal.Quotient.lift p_y θ_A (fun a ha => by
      have ha' : a ∈ Ideal.comap θ_A ⊥ := hKer_θ.symm ▸ ha
      simpa using ha')
  have hInj_φbar : Function.Injective φ_bar := by
    rw [RingHom.injective_iff_ker_eq_bot, eq_bot_iff]
    intro y hy
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective y
    rw [RingHom.mem_ker] at hy
    have ha0 : θ_A a = 0 := hy
    have ha_py : a ∈ p_y := by
      rw [← hKer_θ]
      simpa using ha0
    exact (Submodule.mem_bot _).mpr (Ideal.Quotient.eq_zero_iff_mem.mpr ha_py)
  have hComp_φbar : φ_bar.comp ((Ideal.Quotient.mk p_y).comp c_A) =
      (Ideal.Quotient.mk q_nd).comp (π_nd.comp c_B) := by
    ext c
    rfl
  have hBij_py : Function.Bijective ((Ideal.Quotient.mk p_y).comp c_A) := by
    refine ⟨fun a b hab => hBij_nd.1 ?_, fun y => ?_⟩
    · rw [← hComp_φbar]
      exact congrArg φ_bar hab
    · obtain ⟨c, hc⟩ := hBij_nd.2 (φ_bar y)
      rw [← hComp_φbar] at hc
      exact ⟨c, hInj_φbar hc⟩
  have hMax_py : p_y.IsMaximal :=
    Ideal.Quotient.maximal_of_isField p_y
      (MulEquiv.isField (Field.toIsField k₀) (RingEquiv.ofBijective _ hBij_py).symm.toMulEquiv)

  
  have hX₀_mem : α₀ Polynomial.X ∈ q_C₀ := by
    rw [hα₀_X]
    exact Ideal.mem_map_of_mem π_C₀ hy₀_q₀
  have hX₁_mem : α₁ Polynomial.X ∈ q_C₁ := by
    rw [hα₁_X]
    exact Ideal.mem_map_of_mem π_C₁ hy₁_q₀
  obtain ⟨c_00, hc_00, hAway₀⟩ := h_s3 C₀ α₀ hEtα₀ q_C₀ hX₀_mem
  obtain ⟨c_01, hc_01, hAway₁⟩ := h_s3 C₁ α₁ hEtα₁ q_C₁ hX₁_mem
  obtain ⟨h₀, hh₀_eq⟩ := Ideal.Quotient.mk_surjective c_00
  obtain ⟨h₁, hh₁_eq⟩ := Ideal.Quotient.mk_surjective c_01
  obtain ⟨h_nd, hh_nd_eq⟩ := Ideal.Quotient.mk_surjective u_nd
  have hh₀_not : h₀ ∉ q₀ := fun hm => hc_00 (hh₀_eq ▸ Ideal.mem_map_of_mem π_C₀ hm)
  have hh₁_not : h₁ ∉ q₀ := fun hm => hc_01 (hh₁_eq ▸ Ideal.mem_map_of_mem π_C₁ hm)
  have hh_nd_not : h_nd ∉ q₀ := fun hm => hu_nd (hh_nd_eq ▸ Ideal.mem_map_of_mem π_nd hm)
  let h : B' := h₀ * h₁ * h_nd
  have hh_not : h ∉ q₀ :=
    ‹q₀.IsPrime›.mul_notMem (‹q₀.IsPrime›.mul_notMem hh₀_not hh₁_not) hh_nd_not

  refine ⟨⟨hMax_py, hBij_py⟩, h, hh_not, ?_⟩
  intro g hg A₁ B'₁ _ _ loc_A loc_B φ₁ hφ₁_comm hEtφ₁ hSurjφ₁ hLocA hLocB
  dsimp only
  let x₀ : B'₁ := loc_B y₀
  let x₁ : B'₁ := loc_B y₁
  let D₀ := B'₁ ⧸ Ideal.span {x₁}
  let D₁ := B'₁ ⧸ Ideal.span {x₀}
  let π₀ : B'₁ →+* D₀ := Ideal.Quotient.mk (Ideal.span {x₁})
  let π₁ : B'₁ →+* D₁ := Ideal.Quotient.mk (Ideal.span {x₀})
  let r_B : B' := h * φ₀ g
  have hφ₀g_not : φ₀ g ∉ q₀ := by
    intro hm
    apply hg
    rw [← hComap]
    exact hm
  have hr_B_not : r_B ∉ q₀ := ‹q₀.IsPrime›.mul_notMem hh_not hφ₀g_not

  
  letI : Algebra B' B'₁ := loc_B.toAlgebra
  haveI : IsLocalization.Away r_B B'₁ := hLocB
  have hQuotLoc : ∀ (I : Ideal B') (J : Ideal B'₁) (hIJ : Ideal.map loc_B I = J),
      @IsLocalization.Away (B' ⧸ I) _ (Ideal.Quotient.mk I r_B) (B'₁ ⧸ J) _
        (Ideal.quotientMap J loc_B (hIJ ▸ Ideal.le_comap_map)).toAlgebra := by
    intro I J hIJ
    let locbar : (B' ⧸ I) →+* (B'₁ ⧸ J) := Ideal.quotientMap J loc_B (hIJ ▸ Ideal.le_comap_map)
    letI : Algebra (B' ⧸ I) (B'₁ ⧸ J) := locbar.toAlgebra
    refine ⟨?_, ?_, ?_⟩
    · rintro ⟨_, n, rfl⟩
      have hUnit : IsUnit ((loc_B r_B) ^ n) :=
        (IsLocalization.Away.algebraMap_isUnit r_B (S := B'₁)).pow n
      have hmap := hUnit.map (Ideal.Quotient.mk J)
      rwa [← map_pow] at hmap
    · intro z
      obtain ⟨z₀, rfl⟩ := Ideal.Quotient.mk_surjective z
      obtain ⟨n, a, ha⟩ := IsLocalization.Away.surj r_B z₀ (S := B'₁)
      change z₀ * loc_B r_B ^ n = loc_B a at ha
      refine ⟨(Ideal.Quotient.mk I a, ⟨Ideal.Quotient.mk I r_B ^ n, n, rfl⟩), ?_⟩
      change Ideal.Quotient.mk J z₀ * Ideal.Quotient.mk J (loc_B (r_B ^ n)) =
        Ideal.Quotient.mk J (loc_B a)
      rw [map_pow, ← map_mul, ha]
    · intro x₁_q x₂_q h_eq
      obtain ⟨b₁, rfl⟩ := Ideal.Quotient.mk_surjective x₁_q
      obtain ⟨b₂, rfl⟩ := Ideal.Quotient.mk_surjective x₂_q
      have h_mem_J : loc_B (b₁ - b₂) ∈ Ideal.map loc_B I := by
        rw [hIJ, ← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_sub, sub_eq_zero]
        exact h_eq
      have hClear : ∀ z ∈ Ideal.map loc_B I,
          ∃ (m : ℕ) (i : B'), i ∈ I ∧ z * loc_B r_B ^ m = loc_B i := by
        intro z hz
        induction hz using Submodule.span_induction with
        | mem w hw =>
          rcases hw with ⟨i, hi, rfl⟩
          exact ⟨0, i, hi, by simp⟩
        | zero =>
          exact ⟨0, 0, I.zero_mem, by simp⟩
        | add w₁ w₂ _ _ ih₁ ih₂ =>
          obtain ⟨m₁, i₁, hi₁, h₁_eq⟩ := ih₁
          obtain ⟨m₂, i₂, hi₂, h₂_eq⟩ := ih₂
          refine ⟨m₁ + m₂, i₁ * r_B ^ m₂ + i₂ * r_B ^ m₁,
            I.add_mem (I.mul_mem_right _ hi₁) (I.mul_mem_right _ hi₂), ?_⟩
          calc
            (w₁ + w₂) * loc_B r_B ^ (m₁ + m₂) =
                (w₁ * loc_B r_B ^ m₁) * loc_B r_B ^ m₂ +
                (w₂ * loc_B r_B ^ m₂) * loc_B r_B ^ m₁ := by ring
            _ = loc_B (i₁ * r_B ^ m₂ + i₂ * r_B ^ m₁) := by
              rw [h₁_eq, h₂_eq]
              simp [map_add, map_mul, map_pow]
        | smul s_b w _ ih =>
          obtain ⟨m₁, i₁, hi₁, h₁_eq⟩ := ih
          obtain ⟨m₂, b_s, hb_s⟩ := IsLocalization.Away.surj r_B s_b (S := B'₁)
          change s_b * loc_B r_B ^ m₂ = loc_B b_s at hb_s
          refine ⟨m₂ + m₁, b_s * i₁, I.mul_mem_left _ hi₁, ?_⟩
          calc
            (s_b • w) * loc_B r_B ^ (m₂ + m₁) =
                (s_b * loc_B r_B ^ m₂) * (w * loc_B r_B ^ m₁) := by
              change (s_b * w) * loc_B r_B ^ (m₂ + m₁) = _
              ring
            _ = loc_B (b_s * i₁) := by
              rw [hb_s, h₁_eq, map_mul]
      obtain ⟨m, i, hi_mem, hi_eq⟩ := hClear _ h_mem_J
      have hloc_eq : algebraMap B' B'₁ ((b₁ - b₂) * r_B ^ m) = algebraMap B' B'₁ i := by
        change loc_B ((b₁ - b₂) * r_B ^ m) = loc_B i
        rw [map_mul, map_pow, hi_eq]
      obtain ⟨⟨_, k, rfl⟩, hk_eq⟩ :=
        (IsLocalization.eq_iff_exists (Submonoid.powers r_B) B'₁).mp hloc_eq
      refine ⟨⟨Ideal.Quotient.mk I r_B ^ (k + m), k + m, rfl⟩, ?_⟩
      change Ideal.Quotient.mk I (r_B ^ (k + m) * b₁) = Ideal.Quotient.mk I (r_B ^ (k + m) * b₂)
      rw [Ideal.Quotient.eq]
      have hsub_eq : r_B ^ (k + m) * b₁ - r_B ^ (k + m) * b₂ = r_B ^ k * i := by
        calc
          r_B ^ (k + m) * b₁ - r_B ^ (k + m) * b₂ = r_B ^ k * ((b₁ - b₂) * r_B ^ m) := by ring
          _ = r_B ^ k * i := hk_eq
      rw [hsub_eq]
      exact I.mul_mem_left _ hi_mem

  have hMap_x₁ : Ideal.map loc_B (Ideal.span {y₁}) = Ideal.span {x₁} := by
    rw [Ideal.map_span, Set.image_singleton]
  have hMap_x₀ : Ideal.map loc_B (Ideal.span {y₀}) = Ideal.span {x₀} := by
    rw [Ideal.map_span, Set.image_singleton]
  have hMap_x01 : Ideal.map loc_B (Ideal.span {y₀, y₁}) = Ideal.span {x₀, x₁} := by
    rw [Ideal.map_span, Set.image_pair]

  
  let loc_C₀ : C₀ →+* D₀ := Ideal.quotientMap (Ideal.span {x₁}) loc_B (hMap_x₁ ▸ Ideal.le_comap_map)
  let loc_C₁ : C₁ →+* D₁ := Ideal.quotientMap (Ideal.span {x₀}) loc_B (hMap_x₀ ▸ Ideal.le_comap_map)
  let Q'₁ := B'₁ ⧸ Ideal.span {x₀, x₁}
  let loc_nd : Q' →+* Q'₁ := Ideal.quotientMap (Ideal.span {x₀, x₁}) loc_B (hMap_x01 ▸ Ideal.le_comap_map)

  have hr_C₀_not : π_C₀ r_B ∉ q_C₀ := by
    rw [← Ideal.mem_comap, hComap_qC₀]
    exact hr_B_not
  have hc_00_dvd : c_00 ∣ π_C₀ r_B :=
    ⟨π_C₀ (h₁ * h_nd * φ₀ g), by
      rw [← hh₀_eq, ← map_mul]
      congr 1
      dsimp [r_B, h]
      ring⟩
  obtain ⟨hDom₀, hIC₀, hqbar₀_prime, _, hqbar₀_ne⟩ :=
    hAway₀ (π_C₀ r_B) hr_C₀_not hc_00_dvd D₀ loc_C₀ (hQuotLoc _ _ hMap_x₁)

  have hr_C₁_not : π_C₁ r_B ∉ q_C₁ := by
    rw [← Ideal.mem_comap, hComap_qC₁]
    exact hr_B_not
  have hc_01_dvd : c_01 ∣ π_C₁ r_B :=
    ⟨π_C₁ (h₀ * h_nd * φ₀ g), by
      rw [← hh₁_eq, ← map_mul]
      congr 1
      dsimp [r_B, h]
      ring⟩
  obtain ⟨hDom₁, hIC₁, hqbar₁_prime, _, hqbar₁_ne⟩ :=
    hAway₁ (π_C₁ r_B) hr_C₁_not hc_01_dvd D₁ loc_C₁ (hQuotLoc _ _ hMap_x₀)

  
  have hEt_locB : loc_B.Etale :=
    (RingHom.etale_algebraMap (R := B') (S := B'₁)).mpr (Algebra.Etale.of_isLocalizationAway r_B)
  have hEt_ψ₁ : (loc_B.comp ψ₀).Etale :=
    RingHom.Etale.stableUnderComposition _ _ hEtψ₀ hEt_locB
  have hInf_B₁ : (Ideal.span {x₁} : Ideal B'₁) ⊓ Ideal.span {x₀} = ⊥ :=
    (h_s1 B'₁ (loc_B.comp c_B) (loc_B.comp ψ₀) hEt_ψ₁ (by
      dsimp [c_B, c_R₀]
      rw [RingHom.comp_assoc, hCompat, ← RingHom.comp_assoc])).1

  
  letI : Algebra A A₁ := loc_A.toAlgebra
  haveI : IsLocalization.Away g A₁ := hLocA
  have hDisj_g : Disjoint (Submonoid.powers g : Set A) p_y := by
    rw [Set.disjoint_left]
    rintro _ ⟨n, rfl⟩ hnp
    exact hg (‹p_y.IsPrime›.mem_of_pow_mem n hnp)
  let p_y1 : Ideal A₁ := Ideal.map (algebraMap A A₁) p_y
  haveI hp_y1_prime : p_y1.IsPrime :=
    IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers g) A₁ p_y ‹_› hDisj_g
  have hp_y1_comap : Ideal.comap loc_A p_y1 = p_y :=
    IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers g) A₁ ‹_› hDisj_g
  have hp_y1_uniq : ∀ (p' : Ideal A₁) [p'.IsPrime], Ideal.comap loc_A p' = p_y → p' = p_y1 := by
    intro p' _ hp'
    have hMapU := IsLocalization.map_under (Submonoid.powers g) A₁ p'
    change Ideal.map (algebraMap A A₁) (Ideal.comap loc_A p') = p' at hMapU
    rw [hp'] at hMapU
    exact hMapU.symm

  have hDisj_rB : Disjoint (Submonoid.powers r_B : Set B') q₀ := by
    rw [Set.disjoint_left]
    rintro _ ⟨n, rfl⟩ hnq
    exact hr_B_not (‹q₀.IsPrime›.mem_of_pow_mem n hnq)
  let q₁ : Ideal B'₁ := Ideal.map (algebraMap B' B'₁) q₀
  haveI hq₁_prime : q₁.IsPrime :=
    IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers r_B) B'₁ q₀ ‹_› hDisj_rB
  have hq₁_comap : Ideal.comap loc_B q₁ = q₀ :=
    IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers r_B) B'₁ ‹_› hDisj_rB
  have hComap_φ₁_q₁ : Ideal.comap φ₁ q₁ = p_y1 := by
    haveI : (Ideal.comap φ₁ q₁).IsPrime := Ideal.comap_isPrime φ₁ q₁
    apply hp_y1_uniq
    rw [Ideal.comap_comap, hφ₁_comm, ← Ideal.comap_comap, hq₁_comap, hComap]

  
  let qbar₀ : Ideal D₀ := Ideal.map loc_C₀ q_C₀
  let qbar₁ : Ideal D₁ := Ideal.map loc_C₁ q_C₁
  have hqbar₀_eq : qbar₀ = Ideal.map π₀ q₁ := by
    dsimp [qbar₀, q_C₀, q₁]
    rw [Ideal.map_map, Ideal.map_map]
    rfl
  have hqbar₁_eq : qbar₁ = Ideal.map π₁ q₁ := by
    dsimp [qbar₁, q_C₁, q₁]
    rw [Ideal.map_map, Ideal.map_map]
    rfl
  have hx₀_q₁ : x₀ ∈ q₁ := Ideal.mem_map_of_mem loc_B hy₀_q₀
  have hx₁_q₁ : x₁ ∈ q₁ := Ideal.mem_map_of_mem loc_B hy₁_q₀
  have hLe_x₁ : Ideal.span {x₁} ≤ q₁ := Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hx₁_q₁)
  have hLe_x₀ : Ideal.span {x₀} ≤ q₁ := Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hx₀_q₁)
  have hLe_x01 : Ideal.span {x₀, x₁} ≤ q₁ := by
    rw [Ideal.span_le]
    rintro _ (rfl | rfl)
    · exact hx₀_q₁
    · exact hx₁_q₁
  have hComap_π₀_qbar₀ : Ideal.comap π₀ qbar₀ = q₁ := by
    rw [hqbar₀_eq]
    exact (hQuotPrime _ q₁ hLe_x₁).2
  have hComap_π₁_qbar₁ : Ideal.comap π₁ qbar₁ = q₁ := by
    rw [hqbar₁_eq]
    exact (hQuotPrime _ q₁ hLe_x₀).2

  have hr_nd_not : π_nd r_B ∉ q_nd := by
    rw [← Ideal.mem_comap, hComap_qnd]
    exact hr_B_not
  have hu_nd_dvd : u_nd ∣ π_nd r_B :=
    ⟨π_nd (h₀ * h₁ * φ₀ g), by
      rw [← hh_nd_eq, ← map_mul]
      congr 1
      dsimp [r_B, h]
      ring⟩
  have hBij_Q'₁ : Function.Bijective (loc_nd.comp (π_nd.comp c_B)) :=
    hAway_nd (π_nd r_B) hr_nd_not hu_nd_dvd Q'₁ loc_nd (hQuotLoc _ _ hMap_x01)
  have hMax_x01 : (Ideal.span {x₀, x₁} : Ideal B'₁).IsMaximal :=
    Ideal.Quotient.maximal_of_isField _
      (MulEquiv.isField (Field.toIsField k₀) (RingEquiv.ofBijective _ hBij_Q'₁).symm.toMulEquiv)
  have hSup_q₁ : Ideal.span {x₀, x₁} = q₁ :=
    hMax_x01.eq_of_le hq₁_prime.ne_top hLe_x01

  haveI : qbar₀.IsPrime := hqbar₀_prime
  haveI : qbar₁.IsPrime := hqbar₁_prime
  obtain ⟨hComap_c₀, hComap_c₁, hNeBot_c₀, hNeBot_c₁, s, hs_mem, hs_nzd, hs_ne₀, hs_ne₁, hColon⟩ :=
    h_s4 A₁ B'₁ φ₁ hEtφ₁ hSurjφ₁ p_y1 q₁ hComap_φ₁_q₁ x₀ x₁ hInf_B₁ hSup_q₁
      hDom₀ hDom₁ qbar₀ qbar₁ hComap_π₀_qbar₀ hComap_π₁_qbar₁ hqbar₀_ne hqbar₁_ne

  refine ⟨hDom₀, hIC₀, hDom₁, hIC₁, p_y1, qbar₀, qbar₁, s,
    hp_y1_prime, hqbar₀_prime, hqbar₁_prime, hp_y1_comap, hp_y1_uniq,
    hComap_c₀, hComap_c₁, hNeBot_c₀, hNeBot_c₁, hs_mem, hs_nzd, hs_ne₀, hs_ne₁, ?_⟩
  intro c d₀ d₁ a₀ N hd₀ hd₁ heq₀ heq₁
  exact hColon (loc_A (c_A c)) a₀ d₀ d₁ N hd₀ hd₁ heq₀ heq₁

theorem weil_finite_birational_branch_lift_to_integrallyClosed_domain (k₀ : Type u) [Field k₀]
    (Y : AlgebraicGeometry.Scheme.{u})
    (hRedY : AlgebraicGeometry.IsReduced Y)
    (p_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of k₀))
    (U_sm : Y.Opens)
    (L_comp : ℕ)
    (U_part : Fin (L_comp + 1) → Y.Opens)
    (hPartSup : (⨆ a : Fin (L_comp + 1), U_part a) = U_sm)
    (Y_tilde : Fin (L_comp + 1) → AlgebraicGeometry.Scheme.{u})
    (ι_tilde : ∀ a : Fin (L_comp + 1), Y_tilde a ⟶ Y)
    (hComp : ∀ a : Fin (L_comp + 1),
      AlgebraicGeometry.IsIntegral (Y_tilde a) ∧
      (∀ (U : (Y_tilde a).Opens), AlgebraicGeometry.IsAffineOpen U → Nonempty U →
        IsDomain ↑((Y_tilde a).presheaf.obj (Opposite.op U)) ∧
        IsIntegrallyClosed ↑((Y_tilde a).presheaf.obj (Opposite.op U))) ∧
      AlgebraicGeometry.IsFinite (ι_tilde a) ∧
      Set.range (ι_tilde a).base ∈ irreducibleComponents ↥Y ∧
      (U_part a : Set ↥Y) = Set.range (ι_tilde a).base ∩ (U_sm : Set ↥Y) ∧
      Nonempty ↥(U_part a) ∧
      CategoryTheory.IsIso (ι_tilde a ∣_ U_part a))
    (U_Y0 : Y.Opens)
    (h : ∀ a : Fin (L_comp + 1),
      ↑((Y_tilde a).presheaf.obj (Opposite.op ((TopologicalSpace.Opens.map (ι_tilde a).base).obj U_Y0))))
    (h_sm : ↑(Y.presheaf.obj (Opposite.op (U_Y0 ⊓ U_sm))))
    (hh_sm : ∀ (a : Fin (L_comp + 1)) (O : Y.Opens)
      (hO_sm : O ≤ U_Y0 ⊓ U_sm) (hO_part : O ≤ U_part a) (hO_0 : O ≤ U_Y0),
      ((ι_tilde a).app O).hom ((Y.presheaf.map (CategoryTheory.homOfLE hO_sm).op).hom h_sm) =
        ((Y_tilde a).presheaf.map
          (CategoryTheory.homOfLE ((TopologicalSpace.Opens.map (ι_tilde a).base).monotone hO_0)).op).hom (h a))
    (y₀ : ↥Y)
    (W₁ : Y.Opens)
    (hW₁_le : W₁ ≤ U_Y0)
    (hW₁_aff : AlgebraicGeometry.IsAffineOpen W₁)
    (hy₀W₁ : y₀ ∈ W₁)
    (hIsoSing : (W₁ : Set ↥Y) ∩ (U_sm : Set ↥Y)ᶜ = {y₀})
    (c : k₀)
    (hc : ∀ (a : Fin (L_comp + 1)) (z : ↥(Y_tilde a)),
      (ι_tilde a).base z = y₀ →
      z ∉ (Y_tilde a).basicOpen (h a -
        (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
          (ι_tilde a ≫ p_Y).appLE ⊤
            ((TopologicalSpace.Opens.map (ι_tilde a).base).obj U_Y0) le_top).hom c)))
    (s a₀ : ↑(Y.presheaf.obj (Opposite.op W₁)))
    (N : ℕ)
    (hs_mem : s ∈ (hW₁_aff.primeIdealOf ⟨y₀, hy₀W₁⟩).asIdeal)
    (hs_reg : s ∈ nonZeroDivisors ↑(Y.presheaf.obj (Opposite.op W₁)))
    (hBs_sm : Y.basicOpen s ≤ U_Y0 ⊓ U_sm)
    (ha₀ : (Y.presheaf.map (CategoryTheory.homOfLE (Y.basicOpen_le s)).op).hom (s ^ N) *
      (Y.presheaf.map (CategoryTheory.homOfLE hBs_sm).op).hom h_sm =
      (Y.presheaf.map (CategoryTheory.homOfLE (Y.basicOpen_le s)).op).hom a₀) :
    (∀ (D : Type u) [CommRing D] [IsDomain D] [IsIntegrallyClosed D]
        (ι_D : ↑(Y.presheaf.obj (Opposite.op W₁)) →+* D)
        (qbar : Ideal D) [qbar.IsPrime],
      Ideal.comap ι_D qbar = (hW₁_aff.primeIdealOf ⟨y₀, hy₀W₁⟩).asIdeal →
      Ideal.comap ι_D ⊥ ≠ (hW₁_aff.primeIdealOf ⟨y₀, hy₀W₁⟩).asIdeal →
      ι_D s ≠ 0 →
      ∃ (d : D),
        d - ι_D (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
          p_Y.appLE ⊤ W₁ le_top).hom c) ∈ qbar ∧
        (ι_D s) ^ N * d = ι_D a₀) ∧
    (∀ (a₁ : ↑(Y.presheaf.obj (Opposite.op W₁))),
      s ^ N * a₁ = a₀ →
      (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W₁ ⊓ U_sm ≤ W₁)).op).hom a₁ =
        (Y.presheaf.map (CategoryTheory.homOfLE (inf_le_inf_right U_sm hW₁_le)).op).hom h_sm) :=
by
  have h_s1 : ∀ (A C D : Type u) [CommRing A] [CommRing C] [CommRing D]
      [IsDomain D] [IsIntegrallyClosed D]
      (α : A →+* C) (_ : α.IsIntegral) (ι_D : A →+* D) (t : A) (_ : ι_D t ≠ 0)
      (A_t C_t : Type u) [CommRing A_t] [CommRing C_t]
      (res_A : A →+* A_t) (res_C : C →+* C_t)
      (_ : @IsLocalization.Away A _ t A_t _ res_A.toAlgebra)
      (e_t : A_t ≃+* C_t)
      (_ : ∀ r : A, e_t (res_A r) = res_C (α r)),
      ∃ (tilde_ι : C →+* D),
        tilde_ι.comp α = ι_D ∧
        ∀ (s' a₀' : A) (N' : ℕ) (h_W : C) (C_st : Type u) [CommRing C_st] (res_st : C →+* C_st),
          ι_D s' ≠ 0 →
          @IsLocalization.Away C _ (α (s' * t)) C_st _ res_st.toAlgebra →
          res_st (α (s' ^ N') * h_W) = res_st (α a₀') →
          (ι_D s') ^ N' * tilde_ι h_W = ι_D a₀' := by
    intro A C D _ _ _ _ _ α hα_int ι_D t ht_ne A_t C_t _ _ res_A res_C hLocA e_t he_t
    let K_D := FractionRing D
    let j_D : D →+* K_D := algebraMap D K_D
    have hinj : Function.Injective j_D := IsFractionRing.injective D K_D
    have hjt_ne : (j_D.comp ι_D) t ≠ 0 := by
      intro h0
      apply ht_ne
      apply hinj
      simpa only [RingHom.comp_apply, map_zero] using h0
    have hu_t : IsUnit ((j_D.comp ι_D) t) := IsUnit.mk0 _ hjt_ne
    let _ : Algebra A A_t := res_A.toAlgebra
    have : IsLocalization.Away t A_t := hLocA
    let lam_t : A_t →+* K_D := IsLocalization.Away.lift t hu_t
    let ψ_frac : C →+* K_D := (lam_t.comp e_t.symm.toRingHom).comp res_C
    have hψ_comp : ψ_frac.comp α = j_D.comp ι_D := by
      ext r
      change lam_t (e_t.symm (res_C (α r))) = (j_D.comp ι_D) r
      rw [← he_t r, e_t.symm_apply_apply]
      exact IsLocalization.Away.lift_eq t hu_t r
    have hex : ∀ x : C, ∃ y : D, j_D y = ψ_frac x := by
      intro x
      obtain ⟨P, hP_mon, hP_ev⟩ := hα_int x
      have hInt_x : IsIntegral D (ψ_frac x) := by
        refine ⟨P.map ι_D, hP_mon.map ι_D, ?_⟩
        rw [Polynomial.eval₂_map, ← hψ_comp, ← Polynomial.hom_eval₂, hP_ev, map_zero]
      exact (@IsIntegrallyClosed.isIntegral_iff D _ K_D _ _ _ ‹IsIntegrallyClosed D›).mp hInt_x
    let f_fun : C → D := fun x => Classical.choose (hex x)
    have hf_spec : ∀ x : C, j_D (f_fun x) = ψ_frac x := fun x => Classical.choose_spec (hex x)
    let tilde_ι : C →+* D :=
      { toFun := f_fun
        map_one' := hinj (by rw [hf_spec, map_one, map_one])
        map_mul' := fun x y => hinj (by rw [hf_spec, map_mul, map_mul, hf_spec, hf_spec])
        map_zero' := hinj (by rw [hf_spec, map_zero, map_zero])
        map_add' := fun x y => hinj (by rw [hf_spec, map_add, map_add, hf_spec, hf_spec]) }
    have htilde_eq : ∀ r : A, tilde_ι (α r) = ι_D r := by
      intro r
      apply hinj
      change j_D (f_fun (α r)) = j_D (ι_D r)
      rw [hf_spec]
      exact DFunLike.congr_fun hψ_comp r
    refine ⟨tilde_ι, RingHom.ext htilde_eq, ?_⟩
    intro s' a₀' N' h_W C_st _ res_st hs_ne hLoc_st h_eq_st
    let _ : Algebra C C_st := res_st.toAlgebra
    have : IsLocalization.Away (α (s' * t)) C_st := hLoc_st
    obtain ⟨⟨c_el, M, hc_pow⟩, hc_eq⟩ :=
      (IsLocalization.eq_iff_exists (Submonoid.powers (α (s' * t))) C_st).mp h_eq_st
    dsimp only at hc_eq
    rw [← hc_pow] at hc_eq
    have h_img := congrArg tilde_ι hc_eq
    simp only [map_mul, map_pow, htilde_eq] at h_img
    have hst_ne : (ι_D s' * ι_D t) ^ M ≠ 0 := pow_ne_zero M (mul_ne_zero hs_ne ht_ne)
    exact mul_left_cancel₀ hst_ne (by linear_combination h_img)
  have h_s2 : ∀ (X Z : AlgebraicGeometry.Scheme.{u}) (f : X ⟶ Z) (W : Z.Opens)
      (hW_aff : AlgebraicGeometry.IsAffineOpen W),
      (∀ (U_p : Z.Opens) (_ : CategoryTheory.IsIso (f ∣_ U_p))
        (t : ↑(Z.presheaf.obj (Opposite.op W))),
        Z.basicOpen t ≤ U_p →
        ∃ (e_t : ↑(Z.presheaf.obj (Opposite.op (Z.basicOpen t))) ≃+*
            ↑(X.presheaf.obj (Opposite.op (X.basicOpen ((f.app W).hom t))))),
          ∀ r : ↑(Z.presheaf.obj (Opposite.op W)),
            e_t ((Z.presheaf.map (CategoryTheory.homOfLE (Z.basicOpen_le t)).op).hom r) =
              (X.presheaf.map (CategoryTheory.homOfLE (X.basicOpen_le ((f.app W).hom t))).op).hom
                ((f.app W).hom r)) ∧
      (∀ (hW_tilde_aff : AlgebraicGeometry.IsAffineOpen ((TopologicalSpace.Opens.map f.base).obj W))
        (z₀ : ↥Z) (hz₀W : z₀ ∈ W)
        (Q_tilde : PrimeSpectrum ↑(X.presheaf.obj (Opposite.op ((TopologicalSpace.Opens.map f.base).obj W)))),
        Ideal.comap ((f.app W).hom) Q_tilde.asIdeal = (hW_aff.primeIdealOf ⟨z₀, hz₀W⟩).asIdeal →
        f.base (hW_tilde_aff.fromSpec.base Q_tilde) = z₀ ∧
        ∀ (U_tilde_0 : X.Opens) (hW_le : (TopologicalSpace.Opens.map f.base).obj W ≤ U_tilde_0)
          (g₀ : ↑(X.presheaf.obj (Opposite.op U_tilde_0))),
          hW_tilde_aff.fromSpec.base Q_tilde ∉ X.basicOpen g₀ →
          (X.presheaf.map (CategoryTheory.homOfLE hW_le).op).hom g₀ ∈ Q_tilde.asIdeal) := by
    intro X Z f W hW_aff
    have hPresheafIso : ∀ {S : AlgebraicGeometry.Scheme.{u}} {P Q : S.Opens}
        (hPQ : P ≤ Q) (hQP : Q ≤ P),
        CategoryTheory.IsIso (S.presheaf.map (CategoryTheory.homOfLE hQP).op) := by
      intro S P Q hPQ hQP
      refine ⟨⟨S.presheaf.map (CategoryTheory.homOfLE hPQ).op, ?_, ?_⟩⟩
      · have h1 : (CategoryTheory.homOfLE hQP).op ≫ (CategoryTheory.homOfLE hPQ).op =
            𝟙 (Opposite.op P) := Subsingleton.elim _ _
        rw [← CategoryTheory.Functor.map_comp, h1, CategoryTheory.Functor.map_id]
      · have h2 : (CategoryTheory.homOfLE hPQ).op ≫ (CategoryTheory.homOfLE hQP).op =
            𝟙 (Opposite.op Q) := Subsingleton.elim _ _
        rw [← CategoryTheory.Functor.map_comp, h2, CategoryTheory.Functor.map_id]
    refine ⟨?_, ?_⟩
    · intro U_p hIso_f t ht_le
      let O_t : Z.Opens := Z.basicOpen t
      let V_t : (↑U_p : AlgebraicGeometry.Scheme.{u}).Opens :=
        (TopologicalSpace.Opens.map U_p.ι.base).obj O_t
      let U₁ : Z.Opens := U_p.ι.opensFunctor.obj V_t
      have hU₁_eq : U₁ = O_t := by
        apply SetLike.coe_injective
        ext y
        change (y ∈ U_p.ι.base '' (U_p.ι.base ⁻¹' (O_t : Set ↥Z))) ↔ y ∈ (O_t : Set ↥Z)
        simp only [Set.mem_image, Set.mem_preimage]
        refine ⟨?_, fun hy => ⟨⟨y, ht_le hy⟩, hy, rfl⟩⟩
        rintro ⟨x, hx, rfl⟩
        exact hx
      have hIsoEq : ∀ {P Q : X.Opens} (h : P = Q),
          CategoryTheory.IsIso (X.presheaf.map (CategoryTheory.eqToHom h).op) := by
        rintro P _ rfl
        have hid : (CategoryTheory.eqToHom (rfl : P = P)).op = 𝟙 (Opposite.op P) := rfl
        rw [hid, CategoryTheory.Functor.map_id]
        infer_instance
      have : CategoryTheory.IsIso (f ∣_ U_p) := hIso_f
      have hIso_res_app : CategoryTheory.IsIso ((f ∣_ U_p).app V_t) :=
        AlgebraicGeometry.Scheme.Hom.instIsIsoCommRingCatApp (f ∣_ U_p) V_t
      rw [AlgebraicGeometry.morphismRestrict_app f U_p V_t] at hIso_res_app
      have : CategoryTheory.IsIso (f.app U₁) :=
        @CategoryTheory.IsIso.of_isIso_comp_right _ _ _ _ _ _ _ (hIsoEq _) hIso_res_app
      have hU₁_O : U₁ ≤ O_t := le_of_eq hU₁_eq
      have hO_U₁ : O_t ≤ U₁ := le_of_eq hU₁_eq.symm
      have : CategoryTheory.IsIso (Z.presheaf.map (CategoryTheory.homOfLE hU₁_O).op) :=
        hPresheafIso hO_U₁ hU₁_O
      have hIso_lhs : CategoryTheory.IsIso
          (Z.presheaf.map (CategoryTheory.homOfLE hU₁_O).op ≫ f.app U₁) := inferInstance
