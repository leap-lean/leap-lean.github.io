      CategoryTheory.MorphismProperty.universally_mono
        (fun _ _ _ hf => hf.specializingMap) _ hUC
    have hValEx : AlgebraicGeometry.ValuativeCriterion.Existence p_X :=
      AlgebraicGeometry.ValuativeCriterion.Existence.of_specializingMap p_X hSpecMap
    let sq : AlgebraicGeometry.ValuativeCommSq p_X :=
      ⟨↥W, F, η_X, ψ_Z, ⟨(hη_pX.trans hη_ψZ.symm)⟩⟩
    obtain ⟨⟨ψ_X, hη_ψX, hψX_pX⟩⟩ := hValEx sq
    have hx_pre : ψ_X.base mW ∈ (TopologicalSpace.Opens.map p_X.base).obj U_Z := by
      change (ψ_X ≫ p_X).base mW ∈ U_Z
      rw [hψX_pX]
      exact hzQ
    obtain ⟨U_X, hUX, hxUX, hUX_sub⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hx_pre
    obtain ⟨φ_UX, hφUX_spec, _⟩ := hLocSchemeFac ψ_X U_X hUX hxUX
    have happ_φ : p_X.appLE U_Z U_X hUX_sub ≫ φ_UX = φ_Z := by
      apply AlgebraicGeometry.Spec.map_injective
      apply (cancel_mono hUZ.fromSpec).mp
      rw [AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc,
        AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec p_X hUZ hUX hUX_sub,
        ← CategoryTheory.Category.assoc, hφUX_spec, hψX_pX, hφZ_spec]
    let a_X := (p_X.appLE U_Z U_X hUX_sub).hom b₁
    let b_X := (p_X.appLE U_Z U_X hUX_sub).hom b₂
    have hφ_bX : φ_UX.hom b_X = φ_Z.hom b₂ := by
      change (p_X.appLE U_Z U_X hUX_sub ≫ φ_UX).hom b₂ = φ_Z.hom b₂
      rw [happ_φ]
    have hφ_aX : φ_UX.hom a_X = φ_Z.hom b₁ := by
      change (p_X.appLE U_Z U_X hUX_sub ≫ φ_UX).hom b₁ = φ_Z.hom b₁
      rw [happ_φ]
    have hbX_notMem : φ_UX.hom b_X ∉ IsLocalRing.maximalIdeal ↥W := by
      rw [hφ_bX]
      intro hmem
      have hb₂_in : b₂ ∈ Ideal.comap φ_Z.hom (IsLocalRing.maximalIdeal ↥W) := hmem
      rw [hcomap_φZ] at hb₂_in
      exact hb₂ hb₂_in
    have hcomp_γZ : φ_Z.hom.comp (AlgebraicGeometry.Spec.preimage (hUZ.fromSpec ≫ g_Z)).hom =
        (AlgebraicGeometry.Spec.preimage (ψ_Z ≫ g_Z)).hom := by
      have hmap_eq : AlgebraicGeometry.Spec.map
          (AlgebraicGeometry.Spec.preimage (hUZ.fromSpec ≫ g_Z) ≫ φ_Z) =
          AlgebraicGeometry.Spec.map (AlgebraicGeometry.Spec.preimage (ψ_Z ≫ g_Z)) := by
        rw [AlgebraicGeometry.Spec.map_comp,
          AlgebraicGeometry.Spec.map_preimage (hUZ.fromSpec ≫ g_Z),
          ← CategoryTheory.Category.assoc, hφZ_spec, AlgebraicGeometry.Spec.map_preimage]
      exact congrArg CommRingCat.Hom.hom (AlgebraicGeometry.Spec.map_injective hmap_eq)
    refine hBasicResX ψ_X hη_ψX U_X hUX hxUX φ_UX hφUX_spec a_X b_X hbX_notMem ?_
    intro t ht Q hQ
    rw [hφ_bX, hφ_aX] at ht
    rw [hψX_pX] at hQ
    have hψ_assoc : ψ_X ≫ p_X ≫ g_Z = ψ_Z ≫ g_Z := by
      rw [← CategoryTheory.Category.assoc, hψX_pX]
    rw [hψ_assoc, ← hcomp_γZ]
    exact hb_poly ↥W φ_Z.hom hcomap_φZ t ht Q hQ

  · 
    have hLocFacZ : ∀ (U : Z.Opens) (hU : AlgebraicGeometry.IsAffineOpen U) (hzQ : z_Q ∈ U),
