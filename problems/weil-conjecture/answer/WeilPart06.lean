  · 
    obtain ⟨U_Z, hUZ, hzQ, b₁, b₂, hb₂, hb_poly⟩ := hBr1
    obtain ⟨φ_Z, hφZ_spec, hcomap_φZ⟩ := hLocSchemeFac ψ_Z U_Z hUZ hzQ
    haveI : AlgebraicGeometry.IsProper p_X := hProp_pX
    have hUC : (AlgebraicGeometry.topologically @IsClosedMap).universally p_X := by
