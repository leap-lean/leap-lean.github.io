      obtain ⟨pt, hI_eq⟩ := (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton).mp ‹I_M.IsMaximal›
      refine ⟨(algebraMap κ (D ⧸ M)).injective, fun y => ?_⟩
      obtain ⟨P, rfl⟩ := hπ_surj y
      let c : κ := MvPolynomial.aeval pt P
      refine ⟨c, ?_⟩
      have hmem : P - MvPolynomial.C c ∈ I_M := by
        rw [hI_eq, MvPolynomial.mem_vanishingIdeal_singleton_iff, map_sub, MvPolynomial.aeval_C]
        exact sub_self _
