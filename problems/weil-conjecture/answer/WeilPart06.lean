  have hd₃_loc :
      @IsLocalization.Away A_loc _ d₃ (Localization.Away (p₀_hom d₃)) _
        ((algebraMap C₀ _).comp p₀_hom).toAlgebra := by
    let L_d₃ := Localization.Away d₃
    let η_A3 : A_loc →+* L_d₃ := algebraMap A_loc L_d₃
    let d₃_inv : L_d₃ := IsLocalization.Away.invSelf (S := L_d₃) d₃
    have hd₃_inv : η_A3 d₃ * d₃_inv = 1 :=
