  have hBridge : WeilPointedEtaleStrictLocalBridgeHolds k ℓ := by
    intro R₀ _ _ _ E _ _ _ ψ₀ τ_E
    obtain ⟨ℐ₀, hCat₀, hFilt₀, D₀, α₀, A₀, hRing₀, hAlg₀, f_A₀, τ₀, c₀, hc₀, e_pt₀, τ_lvl₀,
      hEt₀, hComp₀, hLvl₀, hBase₀, hStrict₀, hUniv₀⟩ :=
      weil_strict_henselization_finiteType_algClosed_noetherian k R₀ (τ_E.comp ψ₀)
    obtain ⟨ℐ₁, hCat₁, hFilt₁, D₁, α₁, A₁, hRing₁, hAlg₁, f_A₁, τ₁, c₁, hc₁, e_pt₁, τ_lvl₁,
      hEt₁, hComp₁, hLvl₁, hBase₁, hStrict₁, _⟩ :=
      weil_strict_henselization_finiteType_algClosed_noetherian k E τ_E
    have hg₀ : τ₁.comp (f_A₁.comp ψ₀) = τ_E.comp ψ₀ :=
      (@AlgHom.comp_assoc k R₀ E A₁ k _ _ _ _ _ _ _ _ _ τ₁ f_A₁ ψ₀).symm.trans
