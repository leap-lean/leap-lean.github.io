    obtain ⟨ψ_A, hψ_τ, hψ_f⟩ := @hUniv₀ A₁ hRing₁ hAlg₁ τ₁ hStrict₁ (f_A₁.comp ψ₀) hg₀
    obtain ⟨hSpecSq, hBaseSq⟩ :=
      @weil_pbc_projLine_strict_local_specialization_square k _ _ ℓ _
        A₀ hRing₀ hAlg₀ τ₀ A₁ hRing₁ hAlg₁ τ₁ ψ_A
        hStrict₀ hStrict₁ hψ_τ
        (@hSpec A₀ hRing₀ hAlg₀ τ₀ hStrict₀)
        (@hSpec A₁ hRing₁ hAlg₁ τ₁ hStrict₁)
    exact ⟨ℐ₀, hCat₀, hFilt₀, D₀, α₀, A₀, hRing₀, hAlg₀, f_A₀, τ₀, c₀, hc₀, e_pt₀, τ_lvl₀,
      ℐ₁, hCat₁, hFilt₁, D₁, α₁, A₁, hRing₁, hAlg₁, f_A₁, τ₁, c₁, hc₁, e_pt₁, τ_lvl₁, ψ_A,
      hEt₀, hComp₀, hLvl₀, hBase₀, hStrict₀,
      hEt₁, hComp₁, hLvl₁, hBase₁, hStrict₁,
