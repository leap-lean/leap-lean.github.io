      have hL : (((a₁ ≫ a₂) ≫ fst₁) ≫ fst₂) ≫ fst₃ = Limits.pullback.fst u₀_hom π := by
        erw [Category.assoc a₁ a₂ fst₁, Category.assoc a₁ (a₂ ≫ fst₁) fst₂,
