    exact h_app.trans ((congrArg (fun k => k (ULift.up (1 : ℤ))) hα_app).trans (one_zsmul m))
  have hNatTrans_eq_of_term : ∀ {Z : AlgebraicGeometry.Scheme.{u}}
      {M_p : CategoryTheory.Functor (Opposite Z.Etale) AddCommGrpCat.{u}}
      (α₁ α₂ : (CategoryTheory.Functor.const (Opposite Z.Etale)).obj Aℤ ⟶ M_p),
      (α₁.app (Opposite.op (weilAffColim0TermEtale Z))) (ULift.up (1 : ℤ)) =
        (α₂.app (Opposite.op (weilAffColim0TermEtale Z))) (ULift.up (1 : ℤ)) →
