    have hθ₃₄ : CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (B.map θ₃₄)) (p_i i₃) = p_i i₄ := by
      dsimp [p_i]
      rw [← AlgebraicGeometry.Spec.map_comp]
      have h := α.naturality θ₃₄
      dsimp at h
      rw [CategoryTheory.Category.id_comp] at h
      rw [← h]
    have hu₄ : CategoryTheory.CategoryStruct.comp (u_i i₄) (p_i i₄) = p_inf := by
      dsimp [u_i, p_i, p_inf]
      rw [← AlgebraicGeometry.Spec.map_comp, hf_inf i₄]
    have hu₂₄ : CategoryTheory.CategoryStruct.comp (u_i i₄)
        (AlgebraicGeometry.Spec.map (B.map θ₂₄)) = u_i i₂ := by
      dsimp [u_i]
      rw [← AlgebraicGeometry.Spec.map_comp, c.w θ₂₄]
    have hu₃₄ : CategoryTheory.CategoryStruct.comp (u_i i₄)
        (AlgebraicGeometry.Spec.map (B.map θ₃₄)) = u_i i₃ := by
      dsimp [u_i]
      rw [← AlgebraicGeometry.Spec.map_comp, c.w θ₃₄]
    let pb₄ := (weilEtaleSitePullback (p_i i₄)).sheafPullback AddCommGrpCat.{u}
      Z₀.smallEtaleTopology (AlgebraicGeometry.Spec (B.obj i₄)).smallEtaleTopology
    let x''_4 := weilEtaleBasePullExt.{u} (@hc_all) (@hr_all) hSite
      (p_i i₄) (p_i i₂) (AlgebraicGeometry.Spec.map (B.map θ₂₄)) hθ₂₄ (K 0) G₀ (r + 1) x'_2
    let z₄ := weilEtaleBasePullExt.{u} (@hc_all) (@hr_all) hSite
