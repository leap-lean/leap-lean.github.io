    obtain ⟨E₀₁, E₀, E₁, f_mv, g_mv, h_mv, hAff₀₁, hAff₀, hAff₁, hSE_mv⟩ := hMV Y hCov_Y
    have hFℤ_all : ∀ (q : ℕ) (Λ : Type u) [CategoryTheory.SmallCategory Λ] [CategoryTheory.IsFiltered Λ]
        (D : CategoryTheory.Functor Λ 𝒞) (c : CategoryTheory.Limits.Cocone D),
