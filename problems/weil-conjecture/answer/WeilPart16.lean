          have hS_fc : S_eff.arrows f_c :=
            ⟨W_ax, e_Wc, @CategoryTheory.CategoryStruct.comp S'.Etale _ _ _ _ m_ax m_x,
              hf_ax_eff, h_fac_fc⟩
