    let hS₀_4 := (hSE 0).map_of_exact pb₄
    let e₄ : CategoryTheory.Abelian.Ext (pb₄.obj (K 0)) (pb₄.obj G₀) (r + 1) :=
      hS₀_4.extClass.comp z₄ (Nat.one_add r)
    let x₄ := x''_4 + e₄
    refine ⟨i₄, hu₄, x₄, ?_⟩
    dsimp [x₄]
    rw [map_add]
    have h_term1 : weilEtaleBasePullExt.{u} (@hc_all) (@hr_all) hSite
        p_inf (p_i i₄) (u_i i₄) hu₄ (K 0) G₀ (r + 1) x''_4 = x'_2_inf :=
      hPullComp (p_i i₄) (p_i i₂) p_inf (AlgebraicGeometry.Spec.map (B.map θ₂₄))
        (u_i i₄) (u_i i₂) hu₂₄ hθ₂₄ hu₄ hu₂ (K 0) G₀ (r + 1) x'_2
    have h_term2 : weilEtaleBasePullExt.{u} (@hc_all) (@hr_all) hSite
        p_inf (p_i i₄) (u_i i₄) hu₄ (K 0) G₀ (r + 1) e₄ = δ_inf :=
      ((hExtNat p_inf (p_i i₄) (u_i i₄) hu₄ S₀ (hSE 0) G₀).1 r (r + 1) (Nat.one_add r) z₄).trans
        ((congrArg (fun z => hS₀_inf.extClass.comp z (Nat.one_add r))
          ((hPullComp (p_i i₄) (p_i i₃) p_inf (AlgebraicGeometry.Spec.map (B.map θ₃₄))
            (u_i i₄) (u_i i₃) hu₃₄ hθ₃₄ hu₄ hu₃ (K 1) G₀ r z₃).trans hz₃)).trans hz_inf)
    rw [h_term1, h_term2]
    exact add_sub_cancel x'_2_inf x_inf
  
  have hJoint : ∀ n : ℕ,
