      refine ⟨fun b => ?_⟩
      by_contra hb
      obtain ⟨a₀⟩ := (inferInstance : Nonempty ↥A)
      obtain ⟨x, _, hx1, hx2⟩ :=
        (IrreducibleSpace.isIrreducible_univ (X := ↥B)).isPreirreducible
          (Set.range h.base) (closure (Set.range h.base))ᶜ
          h.isOpenEmbedding.isOpen_range isClosed_closure.isOpen_compl
          ⟨h.base a₀, trivial, ⟨a₀, rfl⟩⟩ ⟨b, trivial, hb⟩
      exact hx2 (subset_closure hx1)
    let p_P : V ⟶ P.left := ι_S ≫ snd_S
    have hν_pP : ν ≫ p_P = Φ := by
      dsimp only [p_P]
      rw [← Category.assoc, hν_ιS]
      exact CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hSurj_p₁ : AlgebraicGeometry.Surjective p₁ := by
      have hDom_p₁ : AlgebraicGeometry.IsDominant p₁ := by
        refine ⟨fun z => ?_⟩
        by_contra hz
        obtain ⟨⟨u₀, hu₀⟩⟩ := hU₀
        obtain ⟨x, _, hxU, hxC⟩ :=
          (IrreducibleSpace.isIrreducible_univ (X := ↥Z₀)).isPreirreducible
            (U₀ : Set ↥Z₀) (closure (Set.range p₁.base))ᶜ
            U₀.isOpen isClosed_closure.isOpen_compl
            ⟨u₀, trivial, hu₀⟩ ⟨z, trivial, hz⟩
        have hxRange : x ∈ Set.range p₁.base := by
          have hx_ι : x ∈ Set.range U₀.ι.base := ⟨⟨x, hxU⟩, rfl⟩
          rw [← hν_p₁] at hx_ι
          obtain ⟨w, rfl⟩ := hx_ι
          exact ⟨ν.base w, rfl⟩
        exact hxC (subset_closure hxRange)
      exact AlgebraicGeometry.Surjective.of_universallyClosed_of_isDominant p₁
    have hComm_ιS : ι_S ≫ fst_S = p₁ ≫ g_Z := by
      dsimp only [ι_S, p₁]
      rw [Category.assoc, Category.assoc, CategoryTheory.Limits.pullback.condition]
    have hAff_appTop : ∀ {A Y : AlgebraicGeometry.Scheme.{u}} {W : Y.Opens}
        (hAff : AlgebraicGeometry.IsAffineOpen W)
        (v : A ⟶ (W : AlgebraicGeometry.Scheme.{u}))
        (hv : (⊤ : A.Opens) ≤ (v ≫ W.ι) ⁻¹ᵁ W),
        (AlgebraicGeometry.Scheme.ΓSpecIso (Y.presheaf.obj (Opposite.op W))).inv ≫
          (v ≫ hAff.isoSpec.hom).appTop =
        (v ≫ W.ι).appLE W ⊤ hv := by
      intro A Y W hAff v hv
      have h_iso_hom : hAff.isoSpec.hom =
          (W : AlgebraicGeometry.Scheme.{u}).toSpecΓ ≫ AlgebraicGeometry.Spec.map W.topIso.inv := by
        have h1 : W.toSpecΓ ≫ hAff.isoSpec.inv = 𝟙 (W : AlgebraicGeometry.Scheme.{u}) := by
          apply (cancel_mono W.ι).mp
          rw [Category.assoc, AlgebraicGeometry.IsAffineOpen.isoSpec_inv_ι,
            AlgebraicGeometry.IsAffineOpen.toSpecΓ_fromSpec, Category.id_comp]
        rw [← Category.id_comp hAff.isoSpec.hom, ← h1, Category.assoc, Iso.inv_hom_id,
          Category.comp_id]
        rfl
      rw [h_iso_hom, AlgebraicGeometry.Scheme.Hom.comp_appTop v,
        ← Category.assoc, appTop_toSpecΓ_SpecMap W.topIso.inv,
        hComp_ι_appLE W v hv]
    have hInj_open_app : ∀ {A B : AlgebraicGeometry.Scheme.{u}} [AlgebraicGeometry.IsIntegral B]
        (j_hom : A ⟶ B) [AlgebraicGeometry.IsOpenImmersion j_hom]
        (Ω : B.Opens),
        Nonempty ↥(j_hom ⁻¹ᵁ Ω) →
        Function.Injective (j_hom.app Ω).hom := by
      intro A B _ j_hom _ Ω ⟨⟨u₀, hu₀⟩⟩ a b hab
      have h_germ := congrArg (A.presheaf.germ (j_hom ⁻¹ᵁ Ω) u₀ hu₀).hom hab
      rw [← AlgebraicGeometry.Scheme.Hom.germ_stalkMap_apply j_hom Ω u₀ hu₀,
        ← AlgebraicGeometry.Scheme.Hom.germ_stalkMap_apply j_hom Ω u₀ hu₀] at h_germ
      have h_bij := ConcreteCategory.bijective_of_isIso (j_hom.stalkMap u₀)
      exact AlgebraicGeometry.germ_injective_of_isIntegral B (j_hom.base u₀) hu₀ (h_bij.1 h_germ)
    have hCl_ιS : AlgebraicGeometry.IsClosedImmersion ι_S := by
      have hAffHom_S : AlgebraicGeometry.IsAffineHom S.hom :=
        @AlgebraicGeometry.isAffineHom_of_isAffine S.left
          (AlgebraicGeometry.Spec (CommRingCat.of k)) S.hom _ inferInstance
      have : AlgebraicGeometry.IsAffineHom snd_S :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (CategoryTheory.IsPullback.of_hasPullback S.hom P.hom) hAffHom_S
      let D_S : Fin (N + 1) → P_S.Opens := fun γ => snd_S ⁻¹ᵁ D γ
      have hAffD_S : ∀ γ : Fin (N + 1), AlgebraicGeometry.IsAffineOpen (D_S γ) :=
        fun γ => (hAffD γ).preimage snd_S
      let W_bad : P_S.Opens :=
        ⟨(Set.range ι_S.base)ᶜ, ι_S.isClosedMap.isClosed_range.isOpen_compl⟩
      let Wcov : Option { β : Fin (N + 1) // ∃ j : Fin r, IsZeroAt j β } → P_S.Opens
        | none => W_bad
        | some b => D_S b.1
      have hSupW : ⨆ idx, Wcov idx = ⊤ := by
        rw [eq_top_iff]
        intro y _
        by_cases hy : y ∈ Set.range ι_S.base
        · obtain ⟨x, rfl⟩ := hy
          have hxj : p₁.base x ∈ (⊤ : Z₀.Opens) := trivial
          rw [← hCovU, TopologicalSpace.Opens.mem_iSup] at hxj
          obtain ⟨j₀, hxj₀⟩ := hxj
          have hxγ_top : p_P.base x ∈ (⊤ : P.left.Opens) := trivial
          rw [← hCovD, TopologicalSpace.Opens.mem_iSup] at hxγ_top
          obtain ⟨γ, hxγ⟩ := hxγ_top
          obtain ⟨β, u, hZβ, hUnitEq⟩ := hShift j₀ γ
          let Ω_V : V.Opens := p₁ ⁻¹ᵁ U j₀ ⊓ p_P ⁻¹ᵁ D γ
          have hxΩ : x ∈ Ω_V := ⟨hxj₀, hxγ⟩
          obtain ⟨_, hx_in_Ω, ⟨u₀, rfl⟩⟩ :=
            ν.denseRange.inter_open_nonempty (Ω_V : Set ↥V) Ω_V.isOpen ⟨x, hxΩ⟩
          have hNe_νΩ : Nonempty ↥(ν ⁻¹ᵁ Ω_V) := ⟨⟨u₀, hx_in_Ω⟩⟩
          let s₁ := (p_P.appLE (D γ) Ω_V inf_le_right).hom (z β γ)
          let s₂ := (p₁.appLE (U j₀) Ω_V inf_le_left).hom u
          have hs_prod : s₁ * s₂ = 1 := by
            apply hInj_open_app ν Ω_V hNe_νΩ
            rw [map_mul, map_one]
            have h_sub : ν ⁻¹ᵁ Ω_V ≤ Φ ⁻¹ᵁ D γ := by
              intro w hw
              change Φ.base w ∈ D γ
              rw [← hν_pP]
              exact hw.2
            have hs₁_eq : (ν.app Ω_V).hom s₁ =
                ((U₀ : AlgebraicGeometry.Scheme.{u}).presheaf.map (homOfLE h_sub).op).hom
                  ((Φ.app (D γ)).hom (z β γ)) := by
              have h_hom : p_P.appLE (D γ) Ω_V inf_le_right ≫ ν.app Ω_V =
                  Φ.app (D γ) ≫
                    (U₀ : AlgebraicGeometry.Scheme.{u}).presheaf.map (homOfLE h_sub).op := by
                rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE ν,
                  AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE ν p_P (D γ) Ω_V
                    (ν ⁻¹ᵁ Ω_V) inf_le_right le_rfl,
                  appLE_congr hν_pP (D γ) (ν ⁻¹ᵁ Ω_V) _ h_sub,
                  AlgebraicGeometry.Scheme.Hom.app_eq_appLE Φ,
                  appLE_res Φ (D γ) (Φ ⁻¹ᵁ D γ) (ν ⁻¹ᵁ Ω_V) le_rfl h_sub]
              exact congrArg (fun h => h.hom (z β γ)) h_hom
            have hs₂_eq : (ν.app Ω_V).hom s₂ =
                ((U₀ : AlgebraicGeometry.Scheme.{u}).presheaf.map (homOfLE h_sub).op).hom
                  ((U₀.ι.appLE (U j₀) (Φ ⁻¹ᵁ D γ)
                    (fun w _ => hU₀_le j₀ w.2)).hom u) := by
              have h_hom : p₁.appLE (U j₀) Ω_V inf_le_left ≫ ν.app Ω_V =
                  U₀.ι.appLE (U j₀) (Φ ⁻¹ᵁ D γ) (fun w _ => hU₀_le j₀ w.2) ≫
                    (U₀ : AlgebraicGeometry.Scheme.{u}).presheaf.map (homOfLE h_sub).op := by
                rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE ν,
                  AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE ν p₁ (U j₀) Ω_V
                    (ν ⁻¹ᵁ Ω_V) inf_le_left le_rfl,
                  appLE_congr hν_p₁ (U j₀) (ν ⁻¹ᵁ Ω_V) _ (fun w _ => hU₀_le j₀ w.2),
                  appLE_res U₀.ι (U j₀) (Φ ⁻¹ᵁ D γ) (ν ⁻¹ᵁ Ω_V)
                    (fun w _ => hU₀_le j₀ w.2) h_sub]
              exact congrArg (fun h => h.hom u) h_hom
            rw [hs₁_eq, hs₂_eq, ← map_mul, hUnitEq, map_one]
          have h_unit_stalk : IsUnit ((V.presheaf.germ Ω_V x hxΩ).hom s₁) :=
            IsUnit.of_mul_eq_one ((V.presheaf.germ Ω_V x hxΩ).hom s₂)
              (by rw [← map_mul, hs_prod, map_one])
          have h_germ_eq : (V.presheaf.germ Ω_V x hxΩ).hom s₁ =
              (p_P.stalkMap x).hom
                ((P.left.presheaf.germ (D γ) (p_P.base x) hxγ).hom (z β γ)) := by
            dsimp only [s₁]
            unfold AlgebraicGeometry.Scheme.Hom.appLE
            rw [CommRingCat.hom_comp, RingHom.comp_apply,
              TopCat.Presheaf.germ_res_apply V.presheaf (homOfLE inf_le_right) x hxΩ,
              AlgebraicGeometry.Scheme.Hom.germ_stalkMap_apply p_P (D γ) x hxγ]
          rw [h_germ_eq, isUnit_map_iff] at h_unit_stalk
          have hx_bo : p_P.base x ∈ P.left.basicOpen (z β γ) :=
            (P.left.mem_basicOpen (z β γ) (p_P.base x) hxγ).mpr h_unit_stalk
          have hx_Dβ : p_P.base x ∈ D β := hz_basic β γ hx_bo
          exact TopologicalSpace.Opens.mem_iSup.mpr ⟨some ⟨β, ⟨j₀, hZβ⟩⟩, hx_Dβ⟩
        · exact TopologicalSpace.Opens.mem_iSup.mpr ⟨none, hy⟩
      refine (@AlgebraicGeometry.IsZariskiLocalAtTarget.iff_of_iSup_eq_top
        (P := @AlgebraicGeometry.IsClosedImmersion) _ _ _ ι_S _ Wcov hSupW).mpr ?_
      intro idx
      cases idx with
      | none =>
        have : IsEmpty ↥(ι_S ⁻¹ᵁ W_bad : AlgebraicGeometry.Scheme.{u}) :=
          ⟨fun ⟨x, hx⟩ => hx ⟨x, rfl⟩⟩
        exact inferInstance
      | some b =>
        rcases b with ⟨β, j, hZβ⟩
        change AlgebraicGeometry.IsClosedImmersion (ι_S ∣_ D_S β)
        let V_β : V.Opens := ι_S ⁻¹ᵁ D_S β
        rcases isEmpty_or_nonempty ↥V_β with hEmp | hNe_Vβ
        · have : IsEmpty ↥(V_β : AlgebraicGeometry.Scheme.{u}) := hEmp
          exact inferInstance
        · have : Nonempty ↥(V_β : AlgebraicGeometry.Scheme.{u}) := hNe_Vβ
          have : AlgebraicGeometry.IsIntegral (V_β : AlgebraicGeometry.Scheme.{u}) :=
            AlgebraicGeometry.isIntegral_of_isOpenImmersion V_β.ι
          let U_β : (U₀ : AlgebraicGeometry.Scheme.{u}).Opens := ν ⁻¹ᵁ V_β
          obtain ⟨⟨x₀, hx₀⟩⟩ := hNe_Vβ
          obtain ⟨_, hx_in_Vβ, ⟨u₀, rfl⟩⟩ :=
            ν.denseRange.inter_open_nonempty (V_β : Set ↥V) V_β.isOpen ⟨x₀, hx₀⟩
          have : Nonempty ↥(U_β : AlgebraicGeometry.Scheme.{u}) := ⟨⟨u₀, hx_in_Vβ⟩⟩
          let s_β : (U_β : AlgebraicGeometry.Scheme.{u}) ⟶ (V_β : AlgebraicGeometry.Scheme.{u}) :=
            ν ∣_ V_β
          have : AlgebraicGeometry.IsOpenImmersion s_β := inferInstance
          have : IrreducibleSpace ↥(V_β : AlgebraicGeometry.Scheme.{u}) :=
            AlgebraicGeometry.irreducibleSpace_of_isIntegral (V_β : AlgebraicGeometry.Scheme.{u})
          have : AlgebraicGeometry.IsDominant s_β := hDom_open s_β
          have hs_β_inj : Function.Injective s_β.appTop.hom :=
            hInj_open_app s_β ⊤ ⟨⟨⟨u₀, hx_in_Vβ⟩, trivial⟩⟩
          let R_S := ↑(S.left.presheaf.obj (Opposite.op ⊤))
          let A_j := ↑(Z₀.presheaf.obj (Opposite.op (U j)))
          let σ_Sj : R_S →+* A_j := (AlgebraicGeometry.Scheme.Hom.appLE g_Z ⊤ (U j) le_top).hom
          let σ_j : MvPolynomial (Fin (n j)) R_S →+* A_j := MvPolynomial.eval₂Hom σ_Sj (f_gen j)
          let R_Sβ := ↑(P_S.presheaf.obj (Opposite.op (D_S β)))
          let α_Sβ : R_S →+* R_Sβ := (AlgebraicGeometry.Scheme.Hom.appLE fst_S ⊤ (D_S β) le_top).hom
          let α_Pβ : ↑(P.left.presheaf.obj (Opposite.op (D β))) →+* R_Sβ := (snd_S.app (D β)).hom
          let β_m : Fin (n j) → Fin (N + 1) := fun m => (hRecov j β hZβ m).choose
          have hβ_m : ∀ m : Fin (n j),
              (Φ.app (D β)).hom (z (β_m m) β) =
                (U₀.ι.appLE (U j) (Φ ⁻¹ᵁ D β)
                  (fun x _ => hU₀_le j x.2)).hom (f_gen j m) :=
            fun m => (hRecov j β hZβ m).choose_spec
          let z_Svec : Fin (n j) → R_Sβ := fun m => α_Pβ (z (β_m m) β)
          let τ_β : MvPolynomial (Fin (n j)) R_S →+* R_Sβ := MvPolynomial.eval₂Hom α_Sβ z_Svec
          let I_β : Ideal R_Sβ := Ideal.map τ_β (RingHom.ker σ_j)
          let Q_β := R_Sβ ⧸ I_β
          let mk_β : R_Sβ →+* Q_β := Ideal.Quotient.mk I_β
          have h_ker_le : RingHom.ker σ_j ≤ RingHom.ker (mk_β.comp τ_β) := by
            intro P_poly hP
            rw [RingHom.mem_ker, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem]
            exact Ideal.mem_map_of_mem τ_β hP
          let e_quot : (MvPolynomial (Fin (n j)) R_S ⧸ RingHom.ker σ_j) ≃+* A_j :=
            RingHom.quotientKerEquivOfSurjective (hGen j)
          let θ_β : A_j →+* Q_β :=
            (Ideal.Quotient.lift (RingHom.ker σ_j) (mk_β.comp τ_β) h_ker_le).comp
              e_quot.symm.toRingHom
          have hθ_σ : ∀ P_poly : MvPolynomial (Fin (n j)) R_S,
              θ_β (σ_j P_poly) = mk_β (τ_β P_poly) := by
            intro P_poly
            have heq_q : e_quot.symm (σ_j P_poly) = Ideal.Quotient.mk (RingHom.ker σ_j) P_poly :=
              e_quot.injective (by simp [e_quot])
            change Ideal.Quotient.lift (RingHom.ker σ_j) (mk_β.comp τ_β) h_ker_le
              (e_quot.symm (σ_j P_poly)) = mk_β (τ_β P_poly)
            rw [heq_q]
            rfl
          let C_β := AlgebraicGeometry.Spec (CommRingCat.of Q_β)
          let ι_C : C_β ⟶ (D_S β : AlgebraicGeometry.Scheme.{u}) :=
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom mk_β) ≫ (hAffD_S β).isoSpec.inv
          let ψ_β : C_β ⟶ Z₀ :=
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ_β) ≫ (hAffU j).fromSpec
          have : AlgebraicGeometry.IsClosedImmersion
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom mk_β)) :=
            AlgebraicGeometry.IsClosedImmersion.spec_of_surjective _ Ideal.Quotient.mk_surjective
          have : AlgebraicGeometry.IsClosedImmersion ι_C := inferInstance
          have hComm_C : ψ_β ≫ g_Z = (ι_C ≫ (D_S β).ι) ≫ fst_S := by
            apply (cancel_mono S.left.toSpecΓ).mp
            have hL : ψ_β ≫ g_Z ≫ S.left.toSpecΓ =
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ_β.comp σ_Sj)) := by
              dsimp only [ψ_β]
              rw [Category.assoc, AlgebraicGeometry.Scheme.toSpecΓ_naturality g_Z,
                ← Category.assoc (hAffU j).fromSpec,
                AlgebraicGeometry.IsAffineOpen.fromSpec_toSpecΓ,
                ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
              rfl
            have hR : ((ι_C ≫ (D_S β).ι) ≫ fst_S) ≫ S.left.toSpecΓ =
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom (mk_β.comp α_Sβ)) := by
              dsimp only [ι_C]
              rw [Category.assoc (AlgebraicGeometry.Spec.map (CommRingCat.ofHom mk_β)),
                AlgebraicGeometry.IsAffineOpen.isoSpec_inv_ι,
                Category.assoc, Category.assoc, AlgebraicGeometry.Scheme.toSpecΓ_naturality fst_S,
                ← Category.assoc (hAffD_S β).fromSpec,
                AlgebraicGeometry.IsAffineOpen.fromSpec_toSpecΓ,
                ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
              rfl
            rw [Category.assoc, hL, hR]
            congr 1
            ext r₀
            simpa [σ_j, τ_β] using hθ_σ (MvPolynomial.C r₀)
          let Γ_Vβ : CommRingCat.{u} :=
            (V_β : AlgebraicGeometry.Scheme.{u}).presheaf.obj (Opposite.op ⊤)
          let Γ_Uβ : CommRingCat.{u} :=
            (U_β : AlgebraicGeometry.Scheme.{u}).presheaf.obj (Opposite.op ⊤)
          let u_β : (V_β : AlgebraicGeometry.Scheme.{u}) ⟶
              AlgebraicGeometry.Spec (P_S.presheaf.obj (Opposite.op (D_S β))) :=
            (ι_S ∣_ D_S β) ≫ (hAffD_S β).isoSpec.hom
          let ρ_β_hom : P_S.presheaf.obj (Opposite.op (D_S β)) ⟶ Γ_Vβ :=
            (AlgebraicGeometry.Scheme.ΓSpecIso (P_S.presheaf.obj (Opposite.op (D_S β)))).inv ≫
              u_β.appTop
          let ρ_β : R_Sβ →+* ↑Γ_Vβ := ρ_β_hom.hom
          have hu_β_eq : (V_β : AlgebraicGeometry.Scheme.{u}).toSpecΓ ≫
              AlgebraicGeometry.Spec.map ρ_β_hom = u_β :=
            toSpecΓ_SpecMap_of_eq u_β ρ_β_hom rfl
          have h_rng_Uj : Set.range (U_β.ι ≫ U₀.ι).base ⊆ Set.range (U j).ι.base := by
            rintro _ ⟨w, rfl⟩
            exact ⟨⟨w.1.1, hU₀_le j w.1.2⟩, rfl⟩
          let lift_Uj := AlgebraicGeometry.IsOpenImmersion.lift (U j).ι (U_β.ι ≫ U₀.ι) h_rng_Uj
          have hlift_Uj : lift_Uj ≫ (U j).ι = U_β.ι ≫ U₀.ι :=
            AlgebraicGeometry.IsOpenImmersion.lift_fac (U j).ι (U_β.ι ≫ U₀.ι) h_rng_Uj
          let m_Z : (U_β : AlgebraicGeometry.Scheme.{u}) ⟶
              AlgebraicGeometry.Spec (Z₀.presheaf.obj (Opposite.op (U j))) :=
            lift_Uj ≫ (hAffU j).isoSpec.hom
          let φ_Z_hom : Z₀.presheaf.obj (Opposite.op (U j)) ⟶ Γ_Uβ :=
            (AlgebraicGeometry.Scheme.ΓSpecIso (Z₀.presheaf.obj (Opposite.op (U j)))).inv ≫
              m_Z.appTop
          let φ_Z : A_j →+* ↑Γ_Uβ := φ_Z_hom.hom
          have hm_Z_eq : (U_β : AlgebraicGeometry.Scheme.{u}).toSpecΓ ≫
              AlgebraicGeometry.Spec.map φ_Z_hom = m_Z :=
            toSpecΓ_SpecMap_of_eq m_Z φ_Z_hom rfl
          have hv_Uj : (⊤ : (U_β : AlgebraicGeometry.Scheme.{u}).Opens) ≤
              (lift_Uj ≫ (U j).ι) ⁻¹ᵁ U j := by
            intro w _
            rw [hlift_Uj]
            exact hU₀_le j w.1.2
          have hφ_Z_appLE : φ_Z_hom =
              (U_β.ι ≫ U₀.ι).appLE (U j) ⊤ (fun w _ => hU₀_le j w.1.2) := by
            dsimp only [φ_Z_hom, m_Z]
            rw [hAff_appTop (hAffU j) lift_Uj hv_Uj]
            exact appLE_congr hlift_Uj (U j) ⊤ hv_Uj (fun w _ => hU₀_le j w.1.2)
          have h_mor_DS : (s_β ≫ (ι_S ∣_ D_S β)) ≫ (D_S β).ι = U_β.ι ≫ ν ≫ ι_S := by
            rw [Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
              AlgebraicGeometry.morphismRestrict_ι_assoc]
          have hv_DS : (⊤ : (U_β : AlgebraicGeometry.Scheme.{u}).Opens) ≤
              ((s_β ≫ (ι_S ∣_ D_S β)) ≫ (D_S β).ι) ⁻¹ᵁ D_S β := by
            intro w _
            rw [h_mor_DS]
            exact w.2
          have hρ_sβ_appLE : ρ_β_hom ≫ s_β.appTop =
              (U_β.ι ≫ ν ≫ ι_S).appLE (D_S β) ⊤ (fun w _ => w.2) := by
            have h1 : ρ_β_hom ≫ s_β.appTop =
                (AlgebraicGeometry.Scheme.ΓSpecIso _).inv ≫
                  ((s_β ≫ (ι_S ∣_ D_S β)) ≫ (hAffD_S β).isoSpec.hom).appTop := by
              dsimp only [ρ_β_hom, u_β]
              rw [Category.assoc, Category.assoc (s_β),
                AlgebraicGeometry.Scheme.Hom.comp_appTop s_β]
            rw [h1, hAff_appTop (hAffD_S β) (s_β ≫ (ι_S ∣_ D_S β)) hv_DS]
            exact appLE_congr h_mor_DS (D_S β) ⊤ hv_DS (fun w _ => w.2)
          have hPoly_eq : ((s_β.appTop.hom).comp ρ_β).comp τ_β = φ_Z.comp σ_j := by
            apply MvPolynomial.ringHom_ext'
            · ext r₀
              simp only [RingHom.comp_apply]
              dsimp only [τ_β, σ_j]
              rw [MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_C]
              have h_mor : (U_β.ι ≫ ν ≫ ι_S) ≫ fst_S = (U_β.ι ≫ U₀.ι) ≫ g_Z := by
                rw [Category.assoc, Category.assoc, hComm_ιS, ← Category.assoc ν p₁ g_Z, hν_p₁,
                  Category.assoc]
              have h_lhs : s_β.appTop.hom (ρ_β (α_Sβ r₀)) =
                  (((U_β.ι ≫ ν ≫ ι_S) ≫ fst_S).appLE ⊤ ⊤ le_top).hom r₀ := by
                have h_hom := AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE
                  (U_β.ι ≫ ν ≫ ι_S) fst_S ⊤ (D_S β) ⊤ le_top (fun w _ => w.2)
                rw [← hρ_sβ_appLE] at h_hom
                exact congrArg (fun h => h.hom r₀) h_hom
              have h_rhs : φ_Z (σ_Sj r₀) =
                  (((U_β.ι ≫ U₀.ι) ≫ g_Z).appLE ⊤ ⊤ le_top).hom r₀ := by
                have h_hom := AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE
                  (U_β.ι ≫ U₀.ι) g_Z ⊤ (U j) ⊤ le_top (fun w _ => hU₀_le j w.1.2)
                rw [← hφ_Z_appLE] at h_hom
                exact congrArg (fun h => h.hom r₀) h_hom
              rw [h_lhs, h_rhs, appLE_congr h_mor ⊤ ⊤ le_top le_top]
            · intro m
              simp only [RingHom.comp_apply]
              dsimp only [τ_β, σ_j]
              rw [MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X']
              have h_uβ_sub : (⊤ : (U_β : AlgebraicGeometry.Scheme.{u}).Opens) ≤
                  U_β.ι ⁻¹ᵁ (Φ ⁻¹ᵁ D β) := by
                intro w _
                change Φ.base w.1 ∈ D β
                rw [← hν_pP]
                exact w.2
              have h_lhs : s_β.appTop.hom (ρ_β (z_Svec m)) =
                  (U_β.ι.appLE (Φ ⁻¹ᵁ D β) ⊤ h_uβ_sub).hom
                    ((Φ.app (D β)).hom (z (β_m m) β)) := by
                have h_mor : (U_β.ι ≫ ν ≫ ι_S) ≫ snd_S = U_β.ι ≫ Φ := by
                  rw [Category.assoc, Category.assoc, ← hν_pP]
                have h_hom1 : snd_S.app (D β) ≫ (ρ_β_hom ≫ s_β.appTop) =
                    ((U_β.ι ≫ ν ≫ ι_S) ≫ snd_S).appLE (D β) ⊤ (fun w _ => w.2) := by
                  rw [hρ_sβ_appLE,
                    AlgebraicGeometry.Scheme.Hom.comp_appLE (U_β.ι ≫ ν ≫ ι_S) snd_S (D β) ⊤
                      (fun w _ => w.2)]
                rw [appLE_congr h_mor (D β) ⊤ (fun w _ => w.2) h_uβ_sub,
                  AlgebraicGeometry.Scheme.Hom.comp_appLE U_β.ι Φ (D β) ⊤ h_uβ_sub] at h_hom1
                exact congrArg (fun h => h.hom (z (β_m m) β)) h_hom1
              have h_rhs : φ_Z (f_gen j m) =
                  (U_β.ι.appLE (Φ ⁻¹ᵁ D β) ⊤ h_uβ_sub).hom
                    ((U₀.ι.appLE (U j) (Φ ⁻¹ᵁ D β)
                      (fun x _ => hU₀_le j x.2)).hom (f_gen j m)) := by
                have h_hom2 := AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE
                  U_β.ι U₀.ι (U j) (Φ ⁻¹ᵁ D β) ⊤ (fun x _ => hU₀_le j x.2) h_uβ_sub
                rw [← hφ_Z_appLE] at h_hom2
                exact (congrArg (fun h => h.hom (f_gen j m)) h_hom2).symm
              rw [h_lhs, h_rhs, hβ_m m]
          have hI_le_ker : I_β ≤ RingHom.ker ρ_β := by
            rw [Ideal.map_le_iff_le_comap]
            intro P_poly hP
            rw [Ideal.mem_comap, RingHom.mem_ker]
            apply hs_β_inj
            rw [map_zero]
            have h_ap := congrArg (fun h => h P_poly) hPoly_eq
            dsimp only [RingHom.comp_apply] at h_ap
            rw [h_ap, RingHom.mem_ker.mp hP, map_zero]
          let ρ_bar : Q_β →+* ↑Γ_Vβ := Ideal.Quotient.lift I_β ρ_β hI_le_ker
          let ρ_bar_hom : CommRingCat.of Q_β ⟶ Γ_Vβ := CommRingCat.ofHom ρ_bar
          let q_β : (V_β : AlgebraicGeometry.Scheme.{u}) ⟶ C_β :=
            (V_β : AlgebraicGeometry.Scheme.{u}).toSpecΓ ≫
              AlgebraicGeometry.Spec.map ρ_bar_hom
          have hq_ιC : q_β ≫ ι_C = ι_S ∣_ D_S β := by
            have h_mk_bar : CommRingCat.ofHom mk_β ≫ ρ_bar_hom = ρ_β_hom := by
              ext x
              rfl
            dsimp only [q_β, ι_C]
            rw [Category.assoc, ← Category.assoc (AlgebraicGeometry.Spec.map ρ_bar_hom),
              ← AlgebraicGeometry.Spec.map_comp, h_mk_bar, ← Category.assoc, hu_β_eq]
            dsimp only [u_β]
            rw [Category.assoc, Iso.hom_inv_id, Category.comp_id]
          have hq_ψ : q_β ≫ ψ_β = V_β.ι ≫ p₁ := by
            apply AlgebraicGeometry.ext_of_isDominant s_β
            have h_ring : ((s_β.appTop.hom).comp ρ_bar).comp θ_β = φ_Z := by
              ext a
              obtain ⟨P_poly, rfl⟩ := hGen j a
              change s_β.appTop.hom (ρ_bar (θ_β (σ_j P_poly))) = φ_Z (σ_j P_poly)
              rw [hθ_σ]
              exact congrArg (fun h => h P_poly) hPoly_eq
            have h_spec : s_β ≫ q_β ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ_β) = m_Z := by
              have h_hom : CommRingCat.ofHom θ_β ≫ ρ_bar_hom ≫ s_β.appTop = φ_Z_hom := by
                ext a
                exact congrArg (fun h => h a) h_ring
              dsimp only [q_β]
              rw [Category.assoc, ← AlgebraicGeometry.Spec.map_comp (CommRingCat.ofHom θ_β) ρ_bar_hom,
                ← Category.assoc s_β, AlgebraicGeometry.Scheme.toSpecΓ_naturality s_β,
                Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
                Category.assoc (CommRingCat.ofHom θ_β), h_hom, hm_Z_eq]
            dsimp only [ψ_β]
            rw [← Category.assoc q_β, ← Category.assoc s_β, h_spec]
            dsimp only [m_Z]
            rw [Category.assoc, ← AlgebraicGeometry.IsAffineOpen.isoSpec_inv_ι,
              ← Category.assoc (hAffU j).isoSpec.hom, Iso.hom_inv_id, Category.id_comp,
              hlift_Uj, ← hν_p₁]
            dsimp only [s_β]
            rw [AlgebraicGeometry.morphismRestrict_ι_assoc]
          let snd_Q := CategoryTheory.Limits.pullback.snd g_Z fst_S
          let W_Q : Q.Opens := snd_Q ⁻¹ᵁ D_S β
          let lift_CQ : C_β ⟶ Q :=
            CategoryTheory.Limits.pullback.lift ψ_β (ι_C ≫ (D_S β).ι) hComm_C
          have h_rng_WQ : Set.range lift_CQ.base ⊆ Set.range W_Q.ι.base := by
            rintro _ ⟨c, rfl⟩
            have h_mem : (lift_CQ ≫ snd_Q).base c ∈ D_S β := by
              rw [CategoryTheory.Limits.pullback.lift_snd]
              exact (ι_C.base c).2
            exact ⟨⟨lift_CQ.base c, h_mem⟩, rfl⟩
          let Ψ_β : C_β ⟶ (W_Q : AlgebraicGeometry.Scheme.{u}) :=
            AlgebraicGeometry.IsOpenImmersion.lift W_Q.ι lift_CQ h_rng_WQ
          have hΨ_fac : Ψ_β ≫ W_Q.ι = lift_CQ :=
            AlgebraicGeometry.IsOpenImmersion.lift_fac W_Q.ι lift_CQ h_rng_WQ
          have hΨ_ιC : Ψ_β ≫ (snd_Q ∣_ D_S β) = ι_C := by
            apply (cancel_mono (D_S β).ι).mp
            rw [Category.assoc, AlgebraicGeometry.morphismRestrict_ι, ← Category.assoc,
              hΨ_fac, CategoryTheory.Limits.pullback.lift_snd]
          have : AlgebraicGeometry.IsSeparated Ψ_β :=
            @AlgebraicGeometry.IsSeparated.of_comp _ _ _ Ψ_β (snd_Q ∣_ D_S β)
              (by rw [hΨ_ιC]; infer_instance)
          have heq_Vβ : V_β = ι_Q ⁻¹ᵁ W_Q := rfl
          have hq_Ψ : q_β ≫ Ψ_β = (V.isoOfEq heq_Vβ).hom ≫ (ι_Q ∣_ W_Q) := by
            apply (cancel_mono W_Q.ι).mp
            rw [Category.assoc q_β, hΨ_fac, Category.assoc (V.isoOfEq heq_Vβ).hom,
              AlgebraicGeometry.morphismRestrict_ι,
              AlgebraicGeometry.Scheme.isoOfEq_hom_ι_assoc]
            apply CategoryTheory.Limits.pullback.hom_ext
            · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_fst, hq_ψ]
              rfl
            · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_snd, ← Category.assoc,
                hq_ιC, AlgebraicGeometry.morphismRestrict_ι]
              rfl
          have : AlgebraicGeometry.IsClosedImmersion (q_β ≫ Ψ_β) := by
            rw [hq_Ψ]
            infer_instance
          have : AlgebraicGeometry.IsClosedImmersion q_β :=
            AlgebraicGeometry.IsClosedImmersion.of_comp q_β Ψ_β
          rw [← hq_ιC]
          infer_instance
    exact ⟨V, ι_Q, ι_S, inferInstance, hCl_ιS, hSurj_p₁, hComm_ιS⟩
  
  obtain ⟨m, Z, i, hCl_i, hInt_Z, hCov_Z⟩ := step1
  have hProp_gZ : ∀ t : Fin m, AlgebraicGeometry.IsProper (i t ≫ f.left) := by
    intro t
    have := hCl_i t
    infer_instance
  have hPkg2 : ∀ t : Fin m,
      (Z t).IsSeparated ∧
      ∃ (r : ℕ) (_ : 0 < r) (U : Fin r → (Z t).Opens),
        (⨆ j : Fin r, U j = ⊤) ∧
        (∀ j : Fin r, AlgebraicGeometry.IsAffineOpen (U j)) ∧
        (∀ j : Fin r, Nonempty ↥(U j)) ∧
        ∃ (n : Fin r → ℕ)
          (f_gen : ∀ j : Fin r, Fin (n j) → ↑((Z t).presheaf.obj (Opposite.op (U j)))),
          (∀ j : Fin r,
            Function.Surjective
              (MvPolynomial.eval₂Hom
                ((AlgebraicGeometry.Scheme.Hom.appLE (i t ≫ f.left) ⊤ (U j) le_top).hom)
                (f_gen j))) ∧
          ∃ (U₀ : (Z t).Opens),
            (∀ j : Fin r, U₀ ≤ U j) ∧
            Nonempty ↥U₀ ∧
            AlgebraicGeometry.IsAffineOpen U₀ := by
    intro t
    have := hProp_gZ t
    exact step2 (Z t) (hInt_Z t) (i t ≫ f.left)
  have hSep_Z : ∀ t : Fin m, (Z t).IsSeparated := fun t => (hPkg2 t).1
  choose r hr U hCovU hAffU _ n f_gen hGen U₀ hU₀_le hU₀ hAffU₀ using fun t => (hPkg2 t).2
  let N : ℕ := Finset.univ.sup (fun t : Fin m => ∏ j : Fin (r t), (n t j + 1))
  have hN_bound : ∀ t : Fin m, (∏ j : Fin (r t), (n t j + 1)) ≤ N + 1 :=
    fun t => le_trans (Finset.le_sup (f := fun t : Fin m => ∏ j : Fin (r t), (n t j + 1))
      (Finset.mem_univ t)) (Nat.le_succ N)
  let P := weilProjectiveSpaceOver k N
  have : AlgebraicGeometry.IsProper P.hom := hPropProj N
  have hCompMod : ∀ t : Fin m,
      ∃ (V : AlgebraicGeometry.Scheme.{u})
        (ι_Q : V ⟶ CategoryTheory.Limits.pullback (i t ≫ f.left)
          (CategoryTheory.Limits.pullback.fst S.hom P.hom))
        (ι_S_t : V ⟶ CategoryTheory.Limits.pullback S.hom P.hom),
        AlgebraicGeometry.IsClosedImmersion ι_Q ∧
        AlgebraicGeometry.IsClosedImmersion ι_S_t ∧
        AlgebraicGeometry.Surjective
          (ι_Q ≫ CategoryTheory.Limits.pullback.fst (i t ≫ f.left)
            (CategoryTheory.Limits.pullback.fst S.hom P.hom)) ∧
        ι_S_t ≫ CategoryTheory.Limits.pullback.fst S.hom P.hom =
          (ι_Q ≫ CategoryTheory.Limits.pullback.fst (i t ≫ f.left)
            (CategoryTheory.Limits.pullback.fst S.hom P.hom)) ≫ (i t ≫ f.left) := by
    intro t
    have := hProp_gZ t
    obtain ⟨Φ, D, z, IsZeroAt, hΦ, hCovD, hAffD, hz_basic, hShift, hRecov⟩ :=
      step3 (Z t) ((i t ≫ f.left) ≫ S.hom) (r t) (hr t) (U t) (n t) (f_gen t)
        (U₀ t) (hU₀_le t) N (hN_bound t)
    exact step4_5 P (Z t) (hInt_Z t) (hSep_Z t) (i t ≫ f.left)
      (r t) (U t) (hCovU t) (hAffU t) (n t) (f_gen t) (hGen t)
      (U₀ t) (hU₀_le t) (hU₀ t) (hAffU₀ t) N Φ hΦ D hCovD hAffD z hz_basic
      IsZeroAt hShift hRecov
  choose V ι_Q ι_S_t hCl_Q hCl_S hSurj_p₁ hComm_t using hCompMod
  let P_X := CategoryTheory.Limits.pullback X.hom P.hom
  let fst_X := CategoryTheory.Limits.pullback.fst X.hom P.hom
  let snd_X := CategoryTheory.Limits.pullback.snd X.hom P.hom
  let P_S := CategoryTheory.Limits.pullback S.hom P.hom
  let fst_S := CategoryTheory.Limits.pullback.fst S.hom P.hom
  let snd_S := CategoryTheory.Limits.pullback.snd S.hom P.hom
  let map_XPS : P_X ⟶ P_S :=
    CategoryTheory.Limits.pullback.lift (fst_X ≫ f.left) snd_X
      (by rw [Category.assoc, CategoryTheory.Over.w f, CategoryTheory.Limits.pullback.condition])
  have hpb_XPS : CategoryTheory.IsPullback map_XPS fst_X fst_S f.left := by
    refine CategoryTheory.IsPullback.of_right ?_
      (CategoryTheory.Limits.pullback.lift_fst _ _ _)
      (CategoryTheory.IsPullback.of_hasPullback S.hom P.hom).flip
    rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Over.w f]
    exact (CategoryTheory.IsPullback.of_hasPullback X.hom P.hom).flip
  let map_QX : ∀ t : Fin m,
      CategoryTheory.Limits.pullback (i t ≫ f.left) fst_S ⟶ P_X := fun t =>
    CategoryTheory.Limits.pullback.lift
      (CategoryTheory.Limits.pullback.fst (i t ≫ f.left) fst_S ≫ i t)
      (CategoryTheory.Limits.pullback.snd (i t ≫ f.left) fst_S ≫ snd_S)
      (by
        rw [Category.assoc, ← CategoryTheory.Over.w f, ← Category.assoc (i t),
          ← Category.assoc (CategoryTheory.Limits.pullback.fst _ _),
          CategoryTheory.Limits.pullback.condition, Category.assoc,
          CategoryTheory.Limits.pullback.condition, Category.assoc])
  have hCl_mapQX : ∀ t : Fin m, AlgebraicGeometry.IsClosedImmersion (map_QX t) := by
    intro t
    have h_comp : map_QX t ≫ map_XPS =
        CategoryTheory.Limits.pullback.snd (i t ≫ f.left) fst_S := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          ← Category.assoc (map_QX t), CategoryTheory.Limits.pullback.lift_fst,
          Category.assoc, CategoryTheory.Limits.pullback.condition]
      · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          CategoryTheory.Limits.pullback.lift_snd]
    have hpb_QX : CategoryTheory.IsPullback (map_QX t)
        (CategoryTheory.Limits.pullback.fst (i t ≫ f.left) fst_S) fst_X (i t) := by
      refine CategoryTheory.IsPullback.of_right ?_
        (CategoryTheory.Limits.pullback.lift_fst _ _ _) hpb_XPS
      rw [h_comp]
      exact (CategoryTheory.IsPullback.of_hasPullback (i t ≫ f.left) fst_S).flip
    exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      hpb_QX.flip (hCl_i t)
  let ι_X_t : ∀ t : Fin m, V t ⟶ P_X := fun t => ι_Q t ≫ map_QX t
  have hFin_Xt : ∀ t : Fin m, AlgebraicGeometry.IsFinite (ι_X_t t) := by
    intro t
    have := hCl_Q t
    have := hCl_mapQX t
    have : AlgebraicGeometry.IsClosedImmersion (ι_X_t t) := inferInstance
    exact inferInstance
  have hFin_St : ∀ t : Fin m, AlgebraicGeometry.IsFinite (ι_S_t t) := by
    intro t
    have := hCl_S t
    exact inferInstance
  have hComm_Xt : ∀ t : Fin m,
      (ι_X_t t ≫ fst_X) ≫ f.left = ι_S_t t ≫ fst_S := by
    intro t
    dsimp only [ι_X_t, map_QX]
    rw [Category.assoc (ι_Q t), CategoryTheory.Limits.pullback.lift_fst,
      ← Category.assoc, Category.assoc _ (i t) f.left, ← hComm_t t]
  have hRange_Xt : ∀ t : Fin m,
      Set.range (i t).base ⊆ Set.range (ι_X_t t ≫ fst_X).base := by
    rintro t _ ⟨z, rfl⟩
    obtain ⟨v, hv⟩ := (hSurj_p₁ t).surj z
    refine ⟨v, ?_⟩
    dsimp only [ι_X_t, map_QX]
    rw [Category.assoc, CategoryTheory.Limits.pullback.lift_fst, ← Category.assoc]
    change (i t).base ((ι_Q t ≫ CategoryTheory.Limits.pullback.fst _ _).base v) = (i t).base z
    rw [hv]
  have hFold : ∀ k_idx : ℕ, k_idx ≤ m →
      ∃ (W : AlgebraicGeometry.Scheme.{u}) (a : W ⟶ P_X) (b : W ⟶ P_S),
        AlgebraicGeometry.IsFinite a ∧
        AlgebraicGeometry.IsFinite b ∧
        (a ≫ fst_X) ≫ f.left = b ≫ fst_S ∧
        (∀ t : Fin m, t.val < k_idx → Set.range (i t).base ⊆ Set.range (a ≫ fst_X).base) := by
    intro k_idx
    induction k_idx with
    | zero =>
      intro _
      let W : AlgebraicGeometry.Scheme.{u} := ⊥_ AlgebraicGeometry.Scheme.{u}
      let a : W ⟶ P_X := CategoryTheory.Limits.initial.to P_X
      let b : W ⟶ P_S := CategoryTheory.Limits.initial.to P_S
      have : AlgebraicGeometry.IsClosedImmersion a := inferInstance
      have : AlgebraicGeometry.IsClosedImmersion b := inferInstance
      refine ⟨W, a, b, inferInstance, inferInstance,
        CategoryTheory.Limits.initial.hom_ext _ _, fun t ht => (Nat.not_lt_zero _ ht).elim⟩
    | succ k_idx ih =>
      intro hk
      obtain ⟨W₀, a₀, b₀, hFin_a₀, hFin_b₀, hComm₀, hCov₀⟩ := ih (Nat.le_of_succ_le hk)
      let t₀ : Fin m := ⟨k_idx, hk⟩
      let W : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.coprod W₀ (V t₀)
      let a : W ⟶ P_X := CategoryTheory.Limits.coprod.desc a₀ (ι_X_t t₀)
      let b : W ⟶ P_S := CategoryTheory.Limits.coprod.desc b₀ (ι_S_t t₀)
      have : AlgebraicGeometry.IsFinite a₀ := hFin_a₀
      have : AlgebraicGeometry.IsFinite (ι_X_t t₀) := hFin_Xt t₀
      have : AlgebraicGeometry.IsFinite b₀ := hFin_b₀
      have : AlgebraicGeometry.IsFinite (ι_S_t t₀) := hFin_St t₀
      refine ⟨W, a, b, inferInstance, inferInstance, ?_, ?_⟩
      · apply CategoryTheory.Limits.coprod.hom_ext
        · rw [← Category.assoc, ← Category.assoc, CategoryTheory.Limits.coprod.inl_desc,
            hComm₀, ← Category.assoc, CategoryTheory.Limits.coprod.inl_desc]
        · rw [← Category.assoc, ← Category.assoc, CategoryTheory.Limits.coprod.inr_desc,
            hComm_Xt t₀, ← Category.assoc, CategoryTheory.Limits.coprod.inr_desc]
      · intro t ht
        rcases Nat.lt_succ_iff_lt_or_eq.mp ht with hlt | heq
        · intro x hx
          obtain ⟨w₀, rfl⟩ := hCov₀ t hlt hx
          refine ⟨(CategoryTheory.Limits.coprod.inl : W₀ ⟶ W).base w₀, ?_⟩
          change (CategoryTheory.Limits.coprod.inl ≫ a ≫ fst_X).base w₀ = (a₀ ≫ fst_X).base w₀
          rw [← Category.assoc, CategoryTheory.Limits.coprod.inl_desc]
        · have ht_eq : t = t₀ := Fin.ext heq
          subst ht_eq
          intro x hx
          obtain ⟨v₀, rfl⟩ := hRange_Xt t₀ hx
          refine ⟨(CategoryTheory.Limits.coprod.inr : V t₀ ⟶ W).base v₀, ?_⟩
          change (CategoryTheory.Limits.coprod.inr ≫ a ≫ fst_X).base v₀ =
            (ι_X_t t₀ ≫ fst_X).base v₀
          rw [← Category.assoc, CategoryTheory.Limits.coprod.inr_desc]
  obtain ⟨X_tilde, ι_X, ι_S, hFin_X, hFin_S, hComm, hCov_all⟩ := hFold m le_rfl
  refine ⟨N, X_tilde, ι_X, ι_S, hFin_X, hFin_S, ⟨?_⟩, hComm⟩
  intro x
  have hx : x ∈ (Set.univ : Set ↥X.left) := trivial
  rw [← hCov_Z] at hx
  obtain ⟨t, hxt⟩ := Set.mem_iUnion.mp hx
  exact hCov_all t t.isLt hxt

theorem weil_pointed_etale_colimit_local_package (k : Type u) [Field k]
    (R₁ : Type u) [CommRing R₁] [Algebra k R₁]
    (σ : R₁ →ₐ[k] k) :
    ∃ (ℐ : Type u) (_ : CategoryTheory.SmallCategory ℐ) (_ : CategoryTheory.IsFiltered ℐ)
      (D : CategoryTheory.Functor ℐ CommRingCat.{u})
      (α : Quiver.Hom ((CategoryTheory.Functor.const ℐ).obj (CommRingCat.of R₁)) D)
      (A : Type u) (_ : CommRing A) (_ : Algebra k A)
      (f_A : R₁ →ₐ[k] A) (τ_A : A →ₐ[k] k)
      (c : CategoryTheory.Limits.Cocone D) (_ : CategoryTheory.Limits.IsColimit c)
      (e_pt : CategoryTheory.Iso c.pt (CommRingCat.of A))
      (τ_lvl : ∀ i : ℐ, ↑(D.obj i) →+* k),
      (∀ i : ℐ, RingHom.Etale (CommRingCat.Hom.hom (α.app i))) ∧
      (∀ i : ℐ, CategoryTheory.CategoryStruct.comp (α.app i)
        (CategoryTheory.CategoryStruct.comp (c.ι.app i) e_pt.hom) = CommRingCat.ofHom f_A.toRingHom) ∧
      (∀ (i : ℐ) (x : ↑(D.obj i)),
        τ_A (CommRingCat.Hom.hom (CategoryTheory.CategoryStruct.comp (c.ι.app i) e_pt.hom) x) = τ_lvl i x) ∧
      (τ_A.comp f_A = σ) ∧
      IsLocalRing A ∧
      (∀ a : A, τ_A a = 0 ↔ ¬ IsUnit a) ∧
      (∀ (i : ℐ) (C₀ : Type u) [CommRing C₀] (g : ↑(D.obj i) →+* C₀) (τ₀ : C₀ →+* k),
        RingHom.Etale g → τ₀.comp g = τ_lvl i →
        ∃ (j : ℐ) (θ : Quiver.Hom i j) (φ : C₀ →+* ↑(D.obj j)),
          φ.comp g = CommRingCat.Hom.hom (D.map θ) ∧ (τ_lvl j).comp φ = τ₀) :=
by
  classical
  let Q₀ (n : ℕ) (J : Ideal (MvPolynomial (Fin n) R₁)) : Type u :=
    MvPolynomial (Fin n) R₁ ⧸ J
  let ℐ : Type u :=
    Σ (n : ℕ) (J : Ideal (MvPolynomial (Fin n) R₁)),
      { τ : Q₀ n J →+* k //
        Algebra.Etale R₁ (Q₀ n J) ∧ τ.comp (algebraMap R₁ (Q₀ n J)) = σ.toRingHom }
  letI hCat : CategoryTheory.SmallCategory ℐ :=
    { Hom := fun i₁ i₂ =>
        { φ : Q₀ i₁.1 i₁.2.1 →ₐ[R₁] Q₀ i₂.1 i₂.2.1 //
          i₂.2.2.1.comp φ.toRingHom = i₁.2.2.1 }
      id := fun i =>
        ⟨AlgHom.id R₁ (Q₀ i.1 i.2.1), RingHom.ext fun _ => rfl⟩
      comp := fun {i₁ i₂ i₃} φ ψ =>
        ⟨ψ.1.comp φ.1, RingHom.ext fun x =>
          (RingHom.congr_fun ψ.2 (φ.1 x)).trans (RingHom.congr_fun φ.2 x)⟩
      id_comp := fun _ => Subtype.ext (AlgHom.ext fun _ => rfl)
      comp_id := fun _ => Subtype.ext (AlgHom.ext fun _ => rfl)
      assoc := fun _ _ _ => Subtype.ext (AlgHom.ext fun _ => rfl) }
  let D : CategoryTheory.Functor ℐ CommRingCat.{u} :=
    { obj := fun i => CommRingCat.of (Q₀ i.1 i.2.1)
      map := fun φ => CommRingCat.ofHom φ.1.toRingHom
      map_id := fun _ =>
        (congrArg CommRingCat.ofHom (RingHom.ext fun _ => rfl)).trans CommRingCat.ofHom_id
      map_comp := fun φ ψ =>
        (congrArg CommRingCat.ofHom (RingHom.ext fun _ => rfl)).trans
          (CommRingCat.ofHom_comp φ.1.toRingHom ψ.1.toRingHom) }
  let α : Quiver.Hom ((CategoryTheory.Functor.const ℐ).obj (CommRingCat.of R₁)) D :=
    { app := fun i => CommRingCat.ofHom (algebraMap R₁ (Q₀ i.1 i.2.1))
      naturality := fun i₁ i₂ θ => by
        dsimp
        rw [CategoryTheory.Category.id_comp, ← CommRingCat.ofHom_comp]
        exact congrArg CommRingCat.ofHom (RingHom.ext fun r => (θ.1.commutes r).symm) }
  let τ_lvl : ∀ i : ℐ, ↑(D.obj i) →+* k := fun i => i.2.2.1
  have hEt : ∀ i : ℐ, RingHom.Etale (CommRingCat.Hom.hom (α.app i)) :=
    fun i => RingHom.etale_algebraMap.mpr i.2.2.2.1
  have exists_obj_of_etale :
      ∀ (C₀ : Type u) [CommRing C₀] [Algebra R₁ C₀] [Algebra.Etale R₁ C₀]
        (τ₀ : C₀ →+* k),
        τ₀.comp (algebraMap R₁ C₀) = σ.toRingHom →
        ∃ (j : ℐ) (e : C₀ ≃ₐ[R₁] Q₀ j.1 j.2.1),
          (τ_lvl j).comp e.toRingHom = τ₀ := by
    intro C₀ _ _ _ τ₀ hτ₀
    have hFT : Algebra.FiniteType R₁ C₀ := inferInstance
    obtain ⟨n, f_mv, hf_surj⟩ :=
      (Algebra.FiniteType.iff_quotient_mvPolynomial'' (R := R₁) (S := C₀)).mp hFT
    let J : Ideal (MvPolynomial (Fin n) R₁) := RingHom.ker f_mv
    let e_quot : Q₀ n J ≃ₐ[R₁] C₀ := Ideal.quotientKerAlgEquivOfSurjective hf_surj
    have hEt_j : Algebra.Etale R₁ (Q₀ n J) := Algebra.Etale.of_equiv e_quot.symm
    let τ_j : Q₀ n J →+* k := τ₀.comp e_quot.toRingHom
    have hτ_j : τ_j.comp (algebraMap R₁ (Q₀ n J)) = σ.toRingHom :=
      RingHom.ext fun r => by
        change τ₀ (e_quot (algebraMap R₁ (Q₀ n J) r)) = σ r
        rw [e_quot.commutes r]
        exact RingHom.congr_fun hτ₀ r
    let j : ℐ := ⟨n, J, ⟨τ_j, hEt_j, hτ_j⟩⟩
    refine ⟨j, e_quot.symm, RingHom.ext fun c => ?_⟩
    change τ₀ (e_quot (e_quot.symm c)) = τ₀ c
    rw [e_quot.apply_symm_apply]
  have hCofinal :
      ∀ (i : ℐ) (C₀ : Type u) [CommRing C₀] (g : ↑(D.obj i) →+* C₀) (τ₀ : C₀ →+* k),
        RingHom.Etale g → τ₀.comp g = τ_lvl i →
        ∃ (j : ℐ) (θ : Quiver.Hom i j) (φ : C₀ →+* ↑(D.obj j)),
          φ.comp g = CommRingCat.Hom.hom (D.map θ) ∧ (τ_lvl j).comp φ = τ₀ := by
    intro i C₀ _ g τ₀ hg hτ₀
    letI : Algebra R₁ C₀ := (g.comp (algebraMap R₁ (Q₀ i.1 i.2.1))).toAlgebra
    have hg_base : RingHom.Etale (algebraMap R₁ (Q₀ i.1 i.2.1)) :=
      RingHom.etale_algebraMap.mpr i.2.2.2.1
    have hg_comp : RingHom.Etale (algebraMap R₁ C₀) := by
      change RingHom.Etale (g.comp (algebraMap R₁ (Q₀ i.1 i.2.1)))
      apply RingHom.Etale.stableUnderComposition
      · exact hg_base
      · exact hg
    letI : Algebra.Etale R₁ C₀ := RingHom.etale_algebraMap.mp hg_comp
    have hτ₀_base : τ₀.comp (algebraMap R₁ C₀) = σ.toRingHom := by
      change τ₀.comp (g.comp (algebraMap R₁ (Q₀ i.1 i.2.1))) = σ.toRingHom
      rw [← RingHom.comp_assoc, hτ₀]
      exact i.2.2.2.2
    obtain ⟨j, e, he_τ⟩ := exists_obj_of_etale C₀ τ₀ hτ₀_base
    let g_alg : Q₀ i.1 i.2.1 →ₐ[R₁] C₀ :=
      { g with commutes' := fun _ => rfl }
    let θ : Quiver.Hom i j :=
      ⟨e.toAlgHom.comp g_alg, RingHom.ext fun x =>
        (RingHom.congr_fun he_τ (g x)).trans (RingHom.congr_fun hτ₀ x)⟩
    exact ⟨j, θ, e.toRingHom, RingHom.ext fun _ => rfl, he_τ⟩
  obtain ⟨i₀, _, _⟩ := exists_obj_of_etale R₁ σ.toRingHom (RingHom.comp_id σ.toRingHom)
  have cocone_objs :
      ∀ (i₁ i₂ : ℐ), ∃ (i₃ : ℐ) (_ : Quiver.Hom i₁ i₃) (_ : Quiver.Hom i₂ i₃), True := by
    intro i₁ i₂
    letI : Algebra.Etale R₁ (Q₀ i₁.1 i₁.2.1) := i₁.2.2.2.1
    letI : Algebra.Etale R₁ (Q₀ i₂.1 i₂.2.1) := i₂.2.2.2.1
    let C₀ : Type u := TensorProduct R₁ (Q₀ i₁.1 i₁.2.1) (Q₀ i₂.1 i₂.2.1)
    haveI : Algebra.Etale (Q₀ i₁.1 i₁.2.1) C₀ := inferInstance
    letI : Algebra.Etale R₁ C₀ := Algebra.Etale.comp R₁ (Q₀ i₁.1 i₁.2.1) C₀
    letI : Algebra R₁ k := σ.toRingHom.toAlgebra
    let τ₁_alg : Q₀ i₁.1 i₁.2.1 →ₐ[R₁] k :=
      { i₁.2.2.1 with commutes' := fun r => RingHom.congr_fun i₁.2.2.2.2 r }
    let τ₂_alg : Q₀ i₂.1 i₂.2.1 →ₐ[R₁] k :=
      { i₂.2.2.1 with commutes' := fun r => RingHom.congr_fun i₂.2.2.2.2 r }
    let τ₀_alg : C₀ →ₐ[R₁] k :=
      Algebra.TensorProduct.lift τ₁_alg τ₂_alg (fun _ _ => mul_comm _ _)
    have hτ₀_base : τ₀_alg.toRingHom.comp (algebraMap R₁ C₀) = σ.toRingHom :=
      RingHom.ext fun r => τ₀_alg.commutes r
    obtain ⟨i₃, e₃, he₃⟩ := exists_obj_of_etale C₀ τ₀_alg.toRingHom hτ₀_base
    let ι_L : Q₀ i₁.1 i₁.2.1 →ₐ[R₁] C₀ := Algebra.TensorProduct.includeLeft
    let ι_R : Q₀ i₂.1 i₂.2.1 →ₐ[R₁] C₀ := Algebra.TensorProduct.includeRight
    let θ₁ : Quiver.Hom i₁ i₃ :=
      ⟨e₃.toAlgHom.comp ι_L, RingHom.ext fun q₁ => by
        have h1 : τ_lvl i₃ (e₃ (ι_L q₁)) = τ₁_alg q₁ * τ₂_alg 1 :=
          RingHom.congr_fun he₃ (ι_L q₁)
        have h2 : τ₁_alg q₁ * τ₂_alg 1 = i₁.2.2.1 q₁ := by
          rw [map_one τ₂_alg, mul_one]
          rfl
        exact h1.trans h2⟩
    let θ₂ : Quiver.Hom i₂ i₃ :=
      ⟨e₃.toAlgHom.comp ι_R, RingHom.ext fun q₂ => by
        have h1 : τ_lvl i₃ (e₃ (ι_R q₂)) = τ₁_alg 1 * τ₂_alg q₂ :=
          RingHom.congr_fun he₃ (ι_R q₂)
        have h2 : τ₁_alg 1 * τ₂_alg q₂ = i₂.2.2.1 q₂ := by
          rw [map_one τ₁_alg, one_mul]
          rfl
        exact h1.trans h2⟩
    exact ⟨i₃, θ₁, θ₂, trivial⟩
  have cocone_maps :
      ∀ ⦃i₁ i₂ : ℐ⦄ (φ₁ φ₂ : Quiver.Hom i₁ i₂),
        ∃ (i₃ : ℐ) (θ : Quiver.Hom i₂ i₃),
          CategoryTheory.CategoryStruct.comp φ₁ θ = CategoryTheory.CategoryStruct.comp φ₂ θ := by
    intro i₁ i₂ φ₁ φ₂
    letI : Algebra.Etale R₁ (Q₀ i₁.1 i₁.2.1) := i₁.2.2.2.1
    obtain ⟨t, ht_kill, ht_one⟩ :=
      Algebra.FormallyUnramified.iff_exists_tensorProduct.mp
        (inferInstance : Algebra.FormallyUnramified R₁ (Q₀ i₁.1 i₁.2.1))
    let Φ : TensorProduct R₁ (Q₀ i₁.1 i₁.2.1) (Q₀ i₁.1 i₁.2.1) →+* Q₀ i₂.1 i₂.2.1 :=
      (Algebra.TensorProduct.lift φ₁.1 φ₂.1 (fun _ _ => mul_comm _ _)).toRingHom
    let g_eq : Q₀ i₂.1 i₂.2.1 := Φ t
    have hτ_Φ : ∀ z : TensorProduct R₁ (Q₀ i₁.1 i₁.2.1) (Q₀ i₁.1 i₁.2.1),
        i₂.2.2.1 (Φ z) = i₁.2.2.1 ((Algebra.TensorProduct.lmul' R₁ (S := Q₀ i₁.1 i₁.2.1)) z) := by
      intro z
      refine TensorProduct.induction_on
        (motive := fun w =>
          i₂.2.2.1 (Φ w) = i₁.2.2.1 ((Algebra.TensorProduct.lmul' R₁ (S := Q₀ i₁.1 i₁.2.1)) w))
        z ?_ ?_ ?_
      · rw [map_zero, map_zero, map_zero, map_zero]
      · intro x y
        change i₂.2.2.1 (φ₁.1 x * φ₂.1 y) = i₁.2.2.1 (x * y)
        have hx : i₂.2.2.1 (φ₁.1 x) = i₁.2.2.1 x := RingHom.congr_fun φ₁.2 x
        have hy : i₂.2.2.1 (φ₂.1 y) = i₁.2.2.1 y := RingHom.congr_fun φ₂.2 y
        rw [map_mul, map_mul, hx, hy]
      · intro z₁ z₂ ih₁ ih₂
        rw [map_add, map_add, map_add, map_add, ih₁, ih₂]
    have hτ_geq : i₂.2.2.1 g_eq = 1 := by
      change i₂.2.2.1 (Φ t) = 1
      rw [hτ_Φ t, ht_one, map_one]
    have hu_eq : IsUnit (i₂.2.2.1 g_eq) := by
      rw [hτ_geq]
      exact isUnit_one
    let C₀ : Type u := Localization.Away g_eq
    let g_loc : Q₀ i₂.1 i₂.2.1 →+* C₀ := algebraMap (Q₀ i₂.1 i₂.2.1) C₀
    haveI : Algebra.Etale (Q₀ i₂.1 i₂.2.1) C₀ := Algebra.Etale.of_isLocalizationAway g_eq
    have hg_et : RingHom.Etale g_loc := RingHom.etale_algebraMap.mpr inferInstance
    let τ₀ : C₀ →+* k := IsLocalization.Away.lift g_eq hu_eq
    have hτ₀_comp : τ₀.comp g_loc = τ_lvl i₂ :=
      IsLocalization.Away.lift_comp g_eq hu_eq
    obtain ⟨i₃, θ, φ, hφ_g, _⟩ := hCofinal i₂ C₀ g_loc τ₀ hg_et hτ₀_comp
    refine ⟨i₃, θ, ?_⟩
    apply Subtype.ext
    apply AlgHom.ext
    intro s
    have hkill_s : Φ ((TensorProduct.tmul R₁ 1 s - TensorProduct.tmul R₁ s 1) * t) = 0 := by
      rw [ht_kill s, map_zero]
    rw [map_mul, map_sub] at hkill_s
    have hΦ1 : Φ (TensorProduct.tmul R₁ 1 s) = φ₂.1 s := by
      change φ₁.1 1 * φ₂.1 s = φ₂.1 s
      rw [map_one, one_mul]
    have hΦ2 : Φ (TensorProduct.tmul R₁ s 1) = φ₁.1 s := by
      change φ₁.1 s * φ₂.1 1 = φ₁.1 s
      rw [map_one, mul_one]
    rw [hΦ1, hΦ2] at hkill_s
    have hloc_kill : (g_loc (φ₂.1 s) - g_loc (φ₁.1 s)) * g_loc g_eq = 0 := by
      rw [← map_sub, ← map_mul, hkill_s, map_zero]
    have hu_loc : IsUnit (g_loc g_eq) :=
      IsLocalization.Away.algebraMap_isUnit (S := C₀) g_eq
    have hloc_eq : g_loc (φ₁.1 s) = g_loc (φ₂.1 s) :=
      (sub_eq_zero.mp (hu_loc.mul_left_eq_zero.mp hloc_kill)).symm
    have hφ1 := RingHom.congr_fun hφ_g (φ₁.1 s)
    have hφ2 := RingHom.congr_fun hφ_g (φ₂.1 s)
    change θ.1 (φ₁.1 s) = θ.1 (φ₂.1 s)
    exact hφ1.symm.trans ((congrArg φ hloc_eq).trans hφ2)
  letI : CategoryTheory.IsFilteredOrEmpty ℐ :=
    CategoryTheory.IsFilteredOrEmpty.mk cocone_objs cocone_maps
  letI hFilt : CategoryTheory.IsFiltered ℐ :=
    @CategoryTheory.IsFiltered.mk ℐ _ _ ⟨i₀⟩
  let c : CategoryTheory.Limits.Cocone D :=
    CommRingCat.FilteredColimits.colimitCocone D
  have hc : CategoryTheory.Limits.IsColimit c :=
    CommRingCat.FilteredColimits.colimitCoconeIsColimit D
  let A : Type u := ↑c.pt
  let e_pt : CategoryTheory.Iso c.pt (CommRingCat.of A) := CategoryTheory.Iso.refl c.pt
  let f_A_ring : R₁ →+* A :=
    CommRingCat.Hom.hom
      (CategoryTheory.CategoryStruct.comp (α.app i₀)
        (CategoryTheory.CategoryStruct.comp (c.ι.app i₀) e_pt.hom))
  letI hAlgA : Algebra k A := (f_A_ring.comp (algebraMap k R₁)).toAlgebra
  let f_A : R₁ →ₐ[k] A :=
    { f_A_ring with commutes' := fun _ => rfl }
  have hComp :
      ∀ i : ℐ, CategoryTheory.CategoryStruct.comp (α.app i)
        (CategoryTheory.CategoryStruct.comp (c.ι.app i) e_pt.hom) = CommRingCat.ofHom f_A.toRingHom := by
    intro i
    let m := CategoryTheory.IsFiltered.max i₀ i
    let u₀ := CategoryTheory.IsFiltered.leftToMax i₀ i
    let u_i := CategoryTheory.IsFiltered.rightToMax i₀ i
    have hα₀ : CategoryTheory.CategoryStruct.comp (α.app i₀) (D.map u₀) = α.app m := by
      have h := (α.naturality u₀).symm
      dsimp at h
      rwa [CategoryTheory.Category.id_comp] at h
    have hα_i : CategoryTheory.CategoryStruct.comp (α.app i) (D.map u_i) = α.app m := by
      have h := (α.naturality u_i).symm
      dsimp at h
      rwa [CategoryTheory.Category.id_comp] at h
    have h_eq : CategoryTheory.CategoryStruct.comp (α.app i) (c.ι.app i) =
        CategoryTheory.CategoryStruct.comp (α.app i₀) (c.ι.app i₀) := by
      calc CategoryTheory.CategoryStruct.comp (α.app i) (c.ι.app i)
        _ = CategoryTheory.CategoryStruct.comp (α.app i)
              (CategoryTheory.CategoryStruct.comp (D.map u_i) (c.ι.app m)) := by
            rw [c.w u_i]
        _ = CategoryTheory.CategoryStruct.comp
              (CategoryTheory.CategoryStruct.comp (α.app i) (D.map u_i)) (c.ι.app m) := by
            rw [← CategoryTheory.Category.assoc]
        _ = CategoryTheory.CategoryStruct.comp (α.app m) (c.ι.app m) := by
            rw [hα_i]
        _ = CategoryTheory.CategoryStruct.comp
              (CategoryTheory.CategoryStruct.comp (α.app i₀) (D.map u₀)) (c.ι.app m) := by
            rw [← hα₀]
        _ = CategoryTheory.CategoryStruct.comp (α.app i₀)
              (CategoryTheory.CategoryStruct.comp (D.map u₀) (c.ι.app m)) := by
            rw [CategoryTheory.Category.assoc]
        _ = CategoryTheory.CategoryStruct.comp (α.app i₀) (c.ι.app i₀) := by
            rw [c.w u₀]
    rw [← CategoryTheory.Category.assoc, h_eq, CategoryTheory.Category.assoc]
    rfl
  let s_τ : CategoryTheory.Limits.Cocone D :=
    { pt := CommRingCat.of k
      ι :=
        { app := fun i => CommRingCat.ofHom (τ_lvl i)
          naturality := fun i₁ i₂ θ => by
            dsimp
            rw [CategoryTheory.Category.comp_id, ← CommRingCat.ofHom_comp]
            exact congrArg CommRingCat.ofHom θ.2 } }
  let τ_A_ring : A →+* k :=
    CommRingCat.Hom.hom (CategoryTheory.CategoryStruct.comp e_pt.inv (hc.desc s_τ))
  have hLvl_ring :
      ∀ (i : ℐ) (x : ↑(D.obj i)),
        τ_A_ring (CommRingCat.Hom.hom (CategoryTheory.CategoryStruct.comp (c.ι.app i) e_pt.hom) x) =
          τ_lvl i x := by
    intro i x
    have hfac :
        CategoryTheory.CategoryStruct.comp
          (CategoryTheory.CategoryStruct.comp (c.ι.app i) e_pt.hom)
          (CategoryTheory.CategoryStruct.comp e_pt.inv (hc.desc s_τ)) =
        CommRingCat.ofHom (τ_lvl i) := by
      rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc e_pt.hom e_pt.inv _,
        e_pt.hom_inv_id, CategoryTheory.Category.id_comp]
      exact hc.fac s_τ i
    exact congrArg (fun φ => CommRingCat.Hom.hom φ x) hfac
  have hBase_ring : ∀ r : R₁, τ_A_ring (f_A r) = σ r := by
    intro r
    change τ_A_ring (CommRingCat.Hom.hom
      (CategoryTheory.CategoryStruct.comp (c.ι.app i₀) e_pt.hom)
      (algebraMap R₁ (Q₀ i₀.1 i₀.2.1) r)) = σ r
    rw [hLvl_ring i₀]
    exact RingHom.congr_fun i₀.2.2.2.2 r
  let τ_A : A →ₐ[k] k :=
    { τ_A_ring with
      commutes' := fun c_k => by
        change τ_A_ring (f_A (algebraMap k R₁ c_k)) = algebraMap k k c_k
        rw [hBase_ring (algebraMap k R₁ c_k), σ.commutes c_k] }
  have hLvl :
      ∀ (i : ℐ) (x : ↑(D.obj i)),
        τ_A (CommRingCat.Hom.hom (CategoryTheory.CategoryStruct.comp (c.ι.app i) e_pt.hom) x) =
          τ_lvl i x :=
    hLvl_ring
  have hBase : τ_A.comp f_A = σ :=
    AlgHom.ext hBase_ring
  have hUnitA : ∀ a : A, τ_A a = 0 ↔ ¬ IsUnit a := by
    intro a
    constructor
    · intro h0 hu
      have hu_k : IsUnit (τ_A.toRingHom a) := hu.map τ_A.toRingHom
      change IsUnit (τ_A a) at hu_k
      rw [h0] at hu_k
      exact not_isUnit_zero hu_k
    · intro hnu
      by_contra h_ne
      apply hnu
      let F_set := CategoryTheory.forget CommRingCat.{u}
      let hc_set := CategoryTheory.Limits.isColimitOfPreserves F_set hc
      obtain ⟨i, q, hq⟩ :=
        CategoryTheory.Limits.Types.jointly_surjective (D ⋙ F_set) hc_set
          (CommRingCat.Hom.hom e_pt.inv a)
      have ha_eq :
          CommRingCat.Hom.hom (CategoryTheory.CategoryStruct.comp (c.ι.app i) e_pt.hom) q = a := by
        change CommRingCat.Hom.hom e_pt.hom (CommRingCat.Hom.hom (c.ι.app i) q) = a
        have hq' : CommRingCat.Hom.hom (c.ι.app i) q = CommRingCat.Hom.hom e_pt.inv a := hq
        rw [hq']
        have hid := congrArg (fun φ => CommRingCat.Hom.hom φ a) e_pt.inv_hom_id
        simpa [CommRingCat.hom_comp] using hid
      have hτ_q : τ_lvl i q ≠ 0 := by
        rw [← hLvl i q, ha_eq]
        exact h_ne
      have hu_q : IsUnit (τ_lvl i q) := Ne.isUnit hτ_q
      let C₀ : Type u := Localization.Away q
      let g_loc : Q₀ i.1 i.2.1 →+* C₀ := algebraMap (Q₀ i.1 i.2.1) C₀
      haveI : Algebra.Etale (Q₀ i.1 i.2.1) C₀ := Algebra.Etale.of_isLocalizationAway q
      have hg_et : RingHom.Etale g_loc := RingHom.etale_algebraMap.mpr inferInstance
      let τ₀ : C₀ →+* k := IsLocalization.Away.lift q hu_q
      have hτ₀_comp : τ₀.comp g_loc = τ_lvl i :=
        IsLocalization.Away.lift_comp q hu_q
      obtain ⟨j, θ, φ, hφ_g, _⟩ := hCofinal i C₀ g_loc τ₀ hg_et hτ₀_comp
      have hu_loc : IsUnit (g_loc q) :=
        IsLocalization.Away.algebraMap_isUnit (S := C₀) q
      let ι_j : Q₀ j.1 j.2.1 →+* A :=
        CommRingCat.Hom.hom (CategoryTheory.CategoryStruct.comp (c.ι.app j) e_pt.hom)
      have hu_img : IsUnit (ι_j (φ (g_loc q))) :=
        hu_loc.map (ι_j.comp φ)
      have hφ_q : φ (g_loc q) = CommRingCat.Hom.hom (D.map θ) q :=
        RingHom.congr_fun hφ_g q
      have hcw :
          CategoryTheory.CategoryStruct.comp (D.map θ)
            (CategoryTheory.CategoryStruct.comp (c.ι.app j) e_pt.hom) =
          CategoryTheory.CategoryStruct.comp (c.ι.app i) e_pt.hom := by
        rw [← CategoryTheory.Category.assoc, c.w θ]
      have h_img_eq : ι_j (φ (g_loc q)) = a := by
        rw [hφ_q]
        have h1 := congrArg (fun ψ => CommRingCat.Hom.hom ψ q) hcw
        have h2 : ι_j (CommRingCat.Hom.hom (D.map θ) q) =
            CommRingCat.Hom.hom (CategoryTheory.CategoryStruct.comp (c.ι.app i) e_pt.hom) q :=
          h1
        exact h2.trans ha_eq
      rwa [h_img_eq] at hu_img
  haveI : Nontrivial A :=
    ⟨0, 1, fun h01 => zero_ne_one (by
      have h := congrArg τ_A h01
      rwa [map_zero, map_one] at h)⟩
  have hLocA : IsLocalRing A := by
    apply IsLocalRing.of_nonunits_add
    intro a b ha hb
    rw [mem_nonunits_iff, ← hUnitA] at ha hb ⊢
    rw [map_add, ha, hb, add_zero]
  exact ⟨ℐ, hCat, hFilt, D, α, A, inferInstance, hAlgA, f_A, τ_A, c, hc, e_pt, τ_lvl,
    hEt, hComp, hLvl, hBase, hLocA, hUnitA, hCofinal⟩

theorem weil_strict_local_etale_section_and_henselian_of_colimit (k : Type u) [Field k]
    (ℐ : Type u) [CategoryTheory.SmallCategory ℐ] [CategoryTheory.IsFiltered ℐ]
    (D : CategoryTheory.Functor ℐ CommRingCat.{u})
    (A : Type u) [CommRing A] [IsLocalRing A]
    (τ_A : A →+* k)
    (c : CategoryTheory.Limits.Cocone D) (hc : CategoryTheory.Limits.IsColimit c)
    (e_pt : CategoryTheory.Iso c.pt (CommRingCat.of A))
    (τ_lvl : ∀ i : ℐ, ↑(D.obj i) →+* k)
    (hLvl : ∀ (i : ℐ) (x : ↑(D.obj i)),
      τ_A (CommRingCat.Hom.hom (CategoryTheory.CategoryStruct.comp (c.ι.app i) e_pt.hom) x) = τ_lvl i x)
    (hUnit : ∀ a : A, τ_A a = 0 ↔ ¬ IsUnit a)
    (hCofinal : ∀ (i : ℐ) (C₀ : Type u) [CommRing C₀] (g : ↑(D.obj i) →+* C₀) (τ₀ : C₀ →+* k),
      RingHom.Etale g → τ₀.comp g = τ_lvl i →
      ∃ (j : ℐ) (θ : Quiver.Hom i j) (φ : C₀ →+* ↑(D.obj j)),
        φ.comp g = CommRingCat.Hom.hom (D.map θ) ∧ (τ_lvl j).comp φ = τ₀) :
    HenselianLocalRing A ∧
    (∀ (C : Type u) [CommRing C] [Algebra A C] [Algebra.Etale A C] (τ_C : C →+* k),
      (∀ a : A, τ_C (algebraMap A C a) = τ_A a) →
      ∃ σ_C : C →ₐ[A] A, ∀ c : C, τ_A (σ_C c) = τ_C c) :=
by
  classical
  let ι_i : ∀ i : ℐ, ↑(D.obj i) →+* A :=
    fun i => CommRingCat.Hom.hom (CategoryTheory.CategoryStruct.comp (c.ι.app i) e_pt.hom)
  have hι_w : ∀ {i₁ i₂ : ℐ} (θ : Quiver.Hom i₁ i₂),
      (ι_i i₂).comp (CommRingCat.Hom.hom (D.map θ)) = ι_i i₁ := by
    intro i₁ i₂ θ
    have hw : CategoryTheory.CategoryStruct.comp (D.map θ)
        (CategoryTheory.CategoryStruct.comp (c.ι.app i₂) e_pt.hom) =
        CategoryTheory.CategoryStruct.comp (c.ι.app i₁) e_pt.hom := by
      rw [← CategoryTheory.Category.assoc, c.w θ]
    exact congrArg CommRingCat.Hom.hom hw
  have step1 :
      (∀ (m : ℕ) (ι_fam : Type) [Fintype ι_fam] (F : ι_fam → MvPolynomial (Fin m) A),
        ∃ (i₁ : ℐ) (F₁ : ι_fam → MvPolynomial (Fin m) ↑(D.obj i₁)),
          ∀ s : ι_fam, MvPolynomial.map (ι_i i₁) (F₁ s) = F s) ∧
      (∀ (i₁ : ℐ) (m : ℕ) (Δ₁ : MvPolynomial (Fin m) ↑(D.obj i₁)),
        MvPolynomial.map (ι_i i₁) Δ₁ = 0 →
        ∃ (i₂ : ℐ) (θ : Quiver.Hom i₁ i₂),
          MvPolynomial.map (CommRingCat.Hom.hom (D.map θ)) Δ₁ = 0) := by
    let U_ring : CategoryTheory.Functor CommRingCat.{u} (Type u) :=
      CategoryTheory.forget CommRingCat.{u}
    let G : CategoryTheory.Functor ℐ (Type u) := CategoryTheory.Functor.comp D U_ring
    let c_U : CategoryTheory.Limits.Cocone G := U_ring.mapCocone c
    have hc_U : CategoryTheory.Limits.IsColimit c_U :=
      CategoryTheory.Limits.isColimitOfPreserves U_ring hc
    have hLiftElem : ∀ a₀ : A, ∃ (i_a : ℐ) (y_a : ↑(D.obj i_a)), ι_i i_a y_a = a₀ := by
      intro a₀
      let z₀ : c_U.pt := CommRingCat.Hom.hom e_pt.inv a₀
      obtain ⟨i_a, y_a, hy_a⟩ :=
        CategoryTheory.Limits.Types.jointly_surjective_of_isColimit hc_U z₀
      refine ⟨i_a, y_a, ?_⟩
      have hy' : CommRingCat.Hom.hom (c.ι.app i_a) y_a = CommRingCat.Hom.hom e_pt.inv a₀ := by
        have happ : c_U.ι.app i_a y_a = CommRingCat.Hom.hom (c.ι.app i_a) y_a :=
          CommRingCat.forget_map_apply (c.ι.app i_a) y_a
        exact happ.symm.trans hy_a
      have hcomp : ι_i i_a y_a =
          CommRingCat.Hom.hom e_pt.hom (CommRingCat.Hom.hom (c.ι.app i_a) y_a) :=
        rfl
      rw [hcomp, hy']
      have hid : CommRingCat.Hom.hom
          (CategoryTheory.CategoryStruct.comp e_pt.inv e_pt.hom) a₀ = a₀ := by
        rw [e_pt.inv_hom_id]
        rfl
      exact hid
    have hKillElem : ∀ (i' : ℐ) (x₀ : ↑(D.obj i')),
        ι_i i' x₀ = 0 →
        ∃ (i₂ : ℐ) (θ'' : Quiver.Hom i' i₂), CommRingCat.Hom.hom (D.map θ'') x₀ = 0 := by
      intro i' x₀ hx₀
      have hc_eq : c_U.ι.app i' x₀ = c_U.ι.app i' (0 : ↑(D.obj i')) := by
        have hA1 : c_U.ι.app i' x₀ = CommRingCat.Hom.hom (c.ι.app i') x₀ :=
          CommRingCat.forget_map_apply (c.ι.app i') x₀
        have hA2 : c_U.ι.app i' (0 : ↑(D.obj i')) =
            CommRingCat.Hom.hom (c.ι.app i') (0 : ↑(D.obj i')) :=
          CommRingCat.forget_map_apply (c.ι.app i') (0 : ↑(D.obj i'))
        rw [hA1, hA2, map_zero]
        have hinv : CommRingCat.Hom.hom (CategoryTheory.CategoryStruct.comp e_pt.hom e_pt.inv)
            (CommRingCat.Hom.hom (c.ι.app i') x₀) = CommRingCat.Hom.hom (c.ι.app i') x₀ := by
          rw [e_pt.hom_inv_id]
          rfl
        have hinv' : CommRingCat.Hom.hom e_pt.inv (ι_i i' x₀) =
            CommRingCat.Hom.hom (c.ι.app i') x₀ := hinv
        rw [← hinv', hx₀, map_zero]
      obtain ⟨i₂, θ'', g'', hfg''⟩ :=
        (CategoryTheory.Limits.Types.FilteredColimit.isColimit_eq_iff G hc_U).mp hc_eq
      refine ⟨i₂, θ'', ?_⟩
      have hL : G.map θ'' x₀ = CommRingCat.Hom.hom (D.map θ'') x₀ :=
        CommRingCat.forget_map_apply (D.map θ'') x₀
      have hR0 : G.map g'' (0 : ↑(D.obj i')) =
          CommRingCat.Hom.hom (D.map g'') (0 : ↑(D.obj i')) :=
        CommRingCat.forget_map_apply (D.map g'') (0 : ↑(D.obj i'))
      have hR : G.map g'' (0 : ↑(D.obj i')) = 0 := hR0.trans (map_zero _)
      exact hL.symm.trans (hfg''.trans hR)
    have hLiftSet : ∀ (S : Finset A),
        ∃ (i₁ : ℐ) (lift : ∀ a : A, a ∈ S → ↑(D.obj i₁)),
          ∀ (a : A) (ha : a ∈ S), ι_i i₁ (lift a ha) = a := by
      intro S
      refine Finset.induction_on S ?_ ?_
      · obtain ⟨i₀⟩ := CategoryTheory.IsFiltered.nonempty (C := ℐ)
        exact ⟨i₀, fun _ ha => False.elim (Finset.notMem_empty _ ha),
          fun _ ha => False.elim (Finset.notMem_empty _ ha)⟩
      · intro a₀ S₀ _ ih
        obtain ⟨i_S, lift_S, h_S⟩ := ih
        obtain ⟨i_a, y_a, hy_a⟩ := hLiftElem a₀
        let i₁ := CategoryTheory.IsFiltered.max i_S i_a
        let u_S : Quiver.Hom i_S i₁ := CategoryTheory.IsFiltered.leftToMax i_S i_a
        let u_a : Quiver.Hom i_a i₁ := CategoryTheory.IsFiltered.rightToMax i_S i_a
        refine ⟨i₁, fun a ha =>
          if h : a = a₀ then
            CommRingCat.Hom.hom (D.map u_a) y_a
          else
            CommRingCat.Hom.hom (D.map u_S) (lift_S a (Finset.mem_of_mem_insert_of_ne ha h)), ?_⟩
        intro a ha
        dsimp only
        split_ifs with h
        · subst h
          have hw := RingHom.congr_fun (hι_w u_a) y_a
          exact hw.trans hy_a
        · have hw := RingHom.congr_fun (hι_w u_S) (lift_S a (Finset.mem_of_mem_insert_of_ne ha h))
          exact hw.trans (h_S a _)
    constructor
    · intro m ι_fam _ F
      let S : Finset A :=
        Finset.univ.biUnion (fun s => (F s).support.image (fun d => (F s).coeff d))
      have hmem : ∀ (s : ι_fam) (d : Fin m →₀ ℕ), d ∈ (F s).support → (F s).coeff d ∈ S := by
        intro s d hd
        exact Finset.mem_biUnion.mpr ⟨s, Finset.mem_univ s, Finset.mem_image_of_mem _ hd⟩
      obtain ⟨i₁, lift, hlift⟩ := hLiftSet S
      refine ⟨i₁, fun s => ∑ d ∈ (F s).support.attach,
        MvPolynomial.monomial d.1 (lift ((F s).coeff d.1) (hmem s d.1 d.2)), ?_⟩
      intro s
      rw [map_sum]
      have hsum : (∑ d ∈ (F s).support.attach,
          MvPolynomial.map (ι_i i₁)
            (MvPolynomial.monomial d.1 (lift ((F s).coeff d.1) (hmem s d.1 d.2)))) =
          ∑ d ∈ (F s).support.attach, MvPolynomial.monomial d.1 ((F s).coeff d.1) := by
        refine Finset.sum_congr rfl ?_
        intro d _
        rw [MvPolynomial.map_monomial, hlift]
      rw [hsum, Finset.sum_attach (F s).support (fun d => MvPolynomial.monomial d ((F s).coeff d))]
      exact (MvPolynomial.as_sum (F s)).symm
    · intro i₁ m Δ₁ hΔ
      have hcoeff0 : ∀ d : Fin m →₀ ℕ, ι_i i₁ (Δ₁.coeff d) = 0 := by
        intro d
        have hc_d := MvPolynomial.ext_iff.mp hΔ d
        change (MvPolynomial.map (ι_i i₁) Δ₁).coeff d = (0 : MvPolynomial (Fin m) A).coeff d at hc_d
        rwa [MvPolynomial.coeff_map, MvPolynomial.coeff_zero] at hc_d
      have hFinKill : ∀ (M : Finset (Fin m →₀ ℕ)),
          ∃ (i₂ : ℐ) (θ : Quiver.Hom i₁ i₂),
            ∀ d ∈ M, CommRingCat.Hom.hom (D.map θ) (Δ₁.coeff d) = 0 := by
        intro M
        refine Finset.induction_on M ?_ ?_
        · refine ⟨i₁, CategoryTheory.CategoryStruct.id i₁, ?_⟩
          intro d hd
          exact False.elim (Finset.notMem_empty _ hd)
        · intro d₀ M₀ _ ih
          obtain ⟨i', θ', hθ'⟩ := ih
          let x₀ : ↑(D.obj i') := CommRingCat.Hom.hom (D.map θ') (Δ₁.coeff d₀)
          have hx₀_zero : ι_i i' x₀ = 0 := by
            have hw := RingHom.congr_fun (hι_w θ') (Δ₁.coeff d₀)
            exact hw.trans (hcoeff0 d₀)
          obtain ⟨i₂, θ'', hx₀_kill⟩ := hKillElem i' x₀ hx₀_zero
          refine ⟨i₂, CategoryTheory.CategoryStruct.comp θ' θ'', ?_⟩
          intro d hd
          have hcomp : CommRingCat.Hom.hom
              (D.map (CategoryTheory.CategoryStruct.comp θ' θ'')) (Δ₁.coeff d) =
              CommRingCat.Hom.hom (D.map θ'')
                (CommRingCat.Hom.hom (D.map θ') (Δ₁.coeff d)) := by
            rw [D.map_comp]
            rfl
          rw [hcomp]
          rcases Finset.mem_insert.mp hd with rfl | hdM
          · exact hx₀_kill
          · rw [hθ' d hdM, map_zero]
      obtain ⟨i₂, θ, hθ⟩ := hFinKill Δ₁.support
      refine ⟨i₂, θ, ?_⟩
      conv_lhs => rw [MvPolynomial.as_sum Δ₁]
      rw [map_sum]
      refine Finset.sum_eq_zero fun d hd => ?_
      rw [MvPolynomial.map_monomial, hθ d hd, MvPolynomial.monomial_zero]
  have step2 : ∀ (C : Type u) [CommRing C] [Algebra A C] [Algebra.Etale A C] (τ_C : C →+* k),
      (∀ a : A, τ_C (algebraMap A C a) = τ_A a) →
      ∃ (m₁ m₂ : ℕ) (μ : Fin m₂ → Fin m₁)
        (R_A G_A : Fin m₂ → MvPolynomial (Fin m₁) A)
        (H_A : MvPolynomial (Fin m₁) A),
        (∑ b : Fin m₂, G_A b * R_A b =
          (Matrix.of fun (a b : Fin m₂) => MvPolynomial.pderiv (μ a) (R_A b)).det * H_A - 1) ∧
        (∀ (B : Type u) [CommRing B] (ι_B : B →+* A) (τ_B : B →+* k),
          (∀ x : B, τ_A (ι_B x) = τ_B x) →
          ∀ (R_B G_B : Fin m₂ → MvPolynomial (Fin m₁) B) (H_B : MvPolynomial (Fin m₁) B),
          (∀ b : Fin m₂, MvPolynomial.map ι_B (R_B b) = R_A b) →
          (∑ b : Fin m₂, G_B b * R_B b =
            (Matrix.of fun (a b : Fin m₂) => MvPolynomial.pderiv (μ a) (R_B b)).det * H_B - 1) →
          ∃ (C₀ : Type u) (_ : CommRing C₀) (g : B →+* C₀) (τ₀ : C₀ →+* k),
            RingHom.Etale g ∧ τ₀.comp g = τ_B ∧
            (∀ (ψ : C₀ →+* A), ψ.comp g = ι_B → τ_A.comp ψ = τ₀ →
              ∃ σ_C : C →ₐ[A] A, ∀ c : C, τ_A (σ_C c) = τ_C c)) := by
    intro C _ _ _ τ_C hCompat
    have hStd0 : Algebra.IsStandardSmoothOfRelativeDimension 0 A C :=
      Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero.mp inferInstance
    rcases hStd0 with ⟨⟨ι, σ, hFin_σ, hFin_ι, P₀, hdim₀⟩⟩
    obtain ⟨m₁, ⟨e_ι⟩⟩ := @Finite.exists_equiv_fin ι hFin_ι
    obtain ⟨m₂, ⟨e_σ⟩⟩ := @Finite.exists_equiv_fin σ hFin_σ
    let P : Algebra.SubmersivePresentation A C (Fin m₁) (Fin m₂) :=
      @Algebra.SubmersivePresentation.reindex A C ι σ _ _ _ hFin_σ P₀
        (Fin m₁) (Fin m₂) inferInstance e_ι.symm e_σ.symm
    have hdim : P.dimension = 0 := by
      have hd : (P₀.toPresentation.reindex e_ι.symm e_σ.symm).dimension = P₀.dimension :=
        Algebra.Presentation.dimension_reindex P₀.toPresentation e_ι.symm e_σ.symm
      exact hd.trans hdim₀
    let μ : Fin m₂ → Fin m₁ := P.map
    have hμ_inj : Function.Injective μ := P.map_inj
    let R_A : Fin m₂ → MvPolynomial (Fin m₁) A := P.relation
    let G_A : Fin m₂ → MvPolynomial (Fin m₁) A := P.jacobianRelations
    let H_A : MvPolynomial (Fin m₁) A := P.σ ↑(P.jacobian_isUnit.unit⁻¹)
    have hJacMat_A : P.jacobiMatrix =
        Matrix.of (fun a b : Fin m₂ => MvPolynomial.pderiv (μ a) (R_A b)) :=
      Matrix.ext fun a b => P.jacobiMatrix_apply a b
    have hJac_A : ∑ b : Fin m₂, G_A b * R_A b =
        (Matrix.of (fun a b : Fin m₂ => MvPolynomial.pderiv (μ a) (R_A b))).det * H_A - 1 := by
      rw [← hJacMat_A]
      exact P.jacobianRelations_spec
    refine ⟨m₁, m₂, μ, R_A, G_A, H_A, hJac_A, ?_⟩
    intro B _ ι_B τ_B hLvl_B R_B G_B H_B hR_B hJac_B
    let J_B : Ideal (MvPolynomial (Fin m₁) B) := Ideal.span (Set.range R_B)
    let C₀ : Type u := MvPolynomial (Fin m₁) B ⧸ J_B
    let g : B →+* C₀ := algebraMap B C₀
    let P_B_pres : Algebra.Presentation B C₀ (Fin m₁) (Fin m₂) :=
      Algebra.Presentation.naive (v := R_B)
    let P_B_pre : Algebra.PreSubmersivePresentation B C₀ (Fin m₁) (Fin m₂) :=
      { toPresentation := P_B_pres
        map := μ
        map_inj := hμ_inj }
    have hRel_B : P_B_pres.relation = R_B := by
      dsimp [P_B_pres]
      exact Algebra.Presentation.naive_relation _ _
    have hJacMat_B : P_B_pre.jacobiMatrix =
        Matrix.of (fun a b : Fin m₂ => MvPolynomial.pderiv (μ a) (R_B b)) := by
      refine Matrix.ext fun a b => ?_
      rw [P_B_pre.jacobiMatrix_apply a b, Matrix.of_apply]
      change MvPolynomial.pderiv (μ a) (P_B_pres.relation b) = MvPolynomial.pderiv (μ a) (R_B b)
      rw [hRel_B]
    have hUnitJac_B : IsUnit P_B_pre.jacobian := by
      let π_B : MvPolynomial (Fin m₁) B →+* C₀ := algebraMap P_B_pre.Ring C₀
      have hπ_rel : ∀ b : Fin m₂, π_B (R_B b) = 0 := by
        intro b
        dsimp [π_B]
        rw [Algebra.Generators.algebraMap_apply, ← hRel_B]
        exact P_B_pres.aeval_val_relation b
      have h_app := congrArg π_B hJac_B
      rw [map_sum, map_sub, map_mul, map_one] at h_app
      have h_lhs : (∑ b : Fin m₂, π_B (G_B b * R_B b)) = 0 := by
        refine Finset.sum_eq_zero ?_
        intro b _
        rw [map_mul, hπ_rel b, mul_zero]
      rw [h_lhs, ← hJacMat_B] at h_app
      have h_jac_eq : P_B_pre.jacobian = π_B P_B_pre.jacobiMatrix.det :=
        P_B_pre.jacobian_eq_jacobiMatrix_det
      rw [← h_jac_eq] at h_app
      have hmul : P_B_pre.jacobian * π_B H_B = 1 := sub_eq_zero.mp h_app.symm
      exact isUnit_iff_exists.mpr ⟨π_B H_B, hmul, (mul_comm _ _).trans hmul⟩
    let P_B_sub : Algebra.SubmersivePresentation B C₀ (Fin m₁) (Fin m₂) :=
      { toPreSubmersivePresentation := P_B_pre
        jacobian_isUnit := hUnitJac_B }
    have hdim_B : P_B_sub.dimension = 0 := hdim
    have hStd_B : Algebra.IsStandardSmoothOfRelativeDimension 0 B C₀ :=
      P_B_sub.isStandardSmoothOfRelativeDimension hdim_B
    have _ : Algebra.Etale B C₀ :=
      Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero.mpr hStd_B
    have hEt_g : RingHom.Etale g := RingHom.etale_algebraMap.mpr inferInstance
    let τ_poly : MvPolynomial (Fin m₁) B →+* k :=
      MvPolynomial.eval₂Hom τ_B (fun t => τ_C (P.val t))
    have hτ_poly_eq : τ_poly =
        τ_C.comp ((MvPolynomial.aeval P.val).toRingHom.comp (MvPolynomial.map ι_B)) := by
      apply MvPolynomial.ringHom_ext'
      · ext x
        simp only [τ_poly, RingHom.comp_apply, MvPolynomial.eval₂Hom_C, MvPolynomial.map_C,
          AlgHom.toRingHom_eq_coe, RingHom.coe_coe, MvPolynomial.aeval_C]
        rw [hCompat (ι_B x)]
        exact (hLvl_B x).symm
      · intro t
        simp [τ_poly]
    have hJ_ker : ∀ q ∈ J_B, τ_poly q = 0 := by
      intro q hq
      have hle : J_B ≤ RingHom.ker τ_poly := by
        refine Ideal.span_le.mpr ?_
        rintro _ ⟨b, rfl⟩
        change τ_poly (R_B b) = 0
        rw [hτ_poly_eq]
        simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
        rw [hR_B b]
        have hrel0 : MvPolynomial.aeval P.val (P.relation b) = 0 := P.aeval_val_relation b
        rw [hrel0, map_zero]
      exact hle hq
    let τ₀ : C₀ →+* k := Ideal.Quotient.lift J_B τ_poly hJ_ker
    have hτ₀_g : τ₀.comp g = τ_B := by
      ext x
      change Ideal.Quotient.lift J_B τ_poly hJ_ker (Ideal.Quotient.mk J_B (MvPolynomial.C x)) = τ_B x
      simp [τ_poly]
    refine ⟨C₀, inferInstance, g, τ₀, hEt_g, hτ₀_g, ?_⟩
    intro ψ hψ_g hψ_τ
    let y : Fin m₁ → A := fun t => ψ (Ideal.Quotient.mk J_B (MvPolynomial.X t))
    let ev_y : MvPolynomial (Fin m₁) A →ₐ[A] A := MvPolynomial.aeval y
    have hev_map : ev_y.toRingHom.comp (MvPolynomial.map ι_B) =
        ψ.comp (Ideal.Quotient.mk J_B) := by
      apply MvPolynomial.ringHom_ext'
      · ext x
        change ev_y (MvPolynomial.map ι_B (MvPolynomial.C x)) = (ψ.comp g) x
        rw [MvPolynomial.map_C, MvPolynomial.aeval_C, hψ_g]
        rfl
      · intro t
        simp [ev_y, y]
    have hP_ker : ∀ p ∈ P.ker, ev_y.toRingHom p = 0 := by
      intro p hp
      have hle : P.ker ≤ RingHom.ker ev_y.toRingHom := by
        rw [← P.span_range_relation_eq_ker]
        refine Ideal.span_le.mpr ?_
        rintro _ ⟨b, rfl⟩
        change ev_y.toRingHom (R_A b) = 0
        rw [← hR_B b, ← RingHom.comp_apply, hev_map, RingHom.comp_apply]
        have hmk0 : Ideal.Quotient.mk J_B (R_B b) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨b, rfl⟩)
        rw [hmk0, map_zero]
      exact hle hp
    let l_y : (MvPolynomial (Fin m₁) A ⧸ P.ker) →+* A :=
      Ideal.Quotient.lift P.ker ev_y.toRingHom hP_ker
    let σ_ring : C →+* A := l_y.comp P.quotientEquiv.symm.toRingHom
    have hσ_aeval : ∀ p : MvPolynomial (Fin m₁) A,
        σ_ring (MvPolynomial.aeval P.val p) = ev_y p := by
      intro p
      have hq : P.quotientEquiv (Ideal.Quotient.mk P.ker p) = MvPolynomial.aeval P.val p :=
        P.quotientEquiv_mk p
      have hq_symm : P.quotientEquiv.symm (MvPolynomial.aeval P.val p) =
          Ideal.Quotient.mk P.ker p :=
        P.quotientEquiv.symm_apply_eq.mpr hq.symm
      change l_y (P.quotientEquiv.symm (MvPolynomial.aeval P.val p)) = ev_y p
      rw [hq_symm]
      rfl
    let σ_C : C →ₐ[A] A :=
      { σ_ring with
        commutes' := fun a => by
          change σ_ring (algebraMap A C a) = a
          rw [← MvPolynomial.aeval_C P.val a, hσ_aeval]
          simp [ev_y] }
    refine ⟨σ_C, ?_⟩
    have hu_eq : τ_A.comp ev_y.toRingHom =
        τ_C.comp (MvPolynomial.aeval P.val).toRingHom := by
      apply MvPolynomial.ringHom_ext'
      · ext a
        simp [ev_y, hCompat a]
      · intro t
        simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
          MvPolynomial.aeval_X, ev_y]
        change τ_A (ψ (Ideal.Quotient.mk J_B (MvPolynomial.X t))) = τ_C (P.val t)
        have h1 := RingHom.congr_fun hψ_τ (Ideal.Quotient.mk J_B (MvPolynomial.X t))
        change τ_A (ψ (Ideal.Quotient.mk J_B (MvPolynomial.X t))) =
          Ideal.Quotient.lift J_B τ_poly hJ_ker (Ideal.Quotient.mk J_B (MvPolynomial.X t)) at h1
        rw [Ideal.Quotient.lift_mk] at h1
        simpa [τ_poly] using h1
    intro c_el
    obtain ⟨Q, rfl⟩ := P.aeval_val_surjective c_el
    change τ_A (σ_ring (MvPolynomial.aeval P.val Q)) = τ_C (MvPolynomial.aeval P.val Q)
    rw [hσ_aeval Q]
    exact RingHom.congr_fun hu_eq Q
  obtain ⟨hLiftFam, hVanish⟩ := step1
  have hSect : ∀ (C : Type u) [CommRing C] [Algebra A C] [Algebra.Etale A C] (τ_C : C →+* k),
      (∀ a : A, τ_C (algebraMap A C a) = τ_A a) →
      ∃ σ_C : C →ₐ[A] A, ∀ c : C, τ_A (σ_C c) = τ_C c := by
    intro C _ _ _ τ_C hCompat
    obtain ⟨m₁, m₂, μ, R_A, G_A, H_A, hJac_A, hModel⟩ := step2 C τ_C hCompat
    obtain ⟨i₁, F₁, hF₁⟩ := hLiftFam m₁ ((Fin m₂ ⊕ Fin m₂) ⊕ Unit)
      (Sum.elim (Sum.elim R_A G_A) (fun _ => H_A))
    let R₁ : Fin m₂ → MvPolynomial (Fin m₁) ↑(D.obj i₁) := fun b => F₁ (Sum.inl (Sum.inl b))
    let G₁ : Fin m₂ → MvPolynomial (Fin m₁) ↑(D.obj i₁) := fun b => F₁ (Sum.inl (Sum.inr b))
    let H₁ : MvPolynomial (Fin m₁) ↑(D.obj i₁) := F₁ (Sum.inr ())
    have hR₁ : ∀ b : Fin m₂, MvPolynomial.map (ι_i i₁) (R₁ b) = R_A b :=
      fun b => hF₁ (Sum.inl (Sum.inl b))
    have hG₁ : ∀ b : Fin m₂, MvPolynomial.map (ι_i i₁) (G₁ b) = G_A b :=
      fun b => hF₁ (Sum.inl (Sum.inr b))
    have hH₁ : MvPolynomial.map (ι_i i₁) H₁ = H_A := hF₁ (Sum.inr ())
    let M₁ : Matrix (Fin m₂) (Fin m₂) (MvPolynomial (Fin m₁) ↑(D.obj i₁)) :=
      Matrix.of (fun a b : Fin m₂ => MvPolynomial.pderiv (μ a) (R₁ b))
    let Δ₁ : MvPolynomial (Fin m₁) ↑(D.obj i₁) :=
      (∑ b : Fin m₂, G₁ b * R₁ b) - (M₁.det * H₁ - 1)
    have hΔ₁_zero : MvPolynomial.map (ι_i i₁) Δ₁ = 0 := by
      dsimp [Δ₁]
      rw [map_sub, map_sub, map_mul, map_one, map_sum]
      have hsum_eq : (∑ b : Fin m₂, MvPolynomial.map (ι_i i₁) (G₁ b * R₁ b)) =
          ∑ b : Fin m₂, G_A b * R_A b := by
        refine Finset.sum_congr rfl ?_
        intro b _
        rw [map_mul, hG₁ b, hR₁ b]
      have hdet_eq : MvPolynomial.map (ι_i i₁) M₁.det =
          (Matrix.of (fun a b : Fin m₂ => MvPolynomial.pderiv (μ a) (R_A b))).det := by
        rw [RingHom.map_det (MvPolynomial.map (ι_i i₁)) M₁]
        congr 1
        refine Matrix.ext fun a b => ?_
        simp only [RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.of_apply, M₁]
        rw [← MvPolynomial.pderiv_map, hR₁ b]
      rw [hsum_eq, hdet_eq, hH₁, hJac_A, sub_self]
    obtain ⟨i₂, θ₁₂, hΔ₂⟩ := hVanish i₁ m₁ Δ₁ hΔ₁_zero
    let B : Type u := ↑(D.obj i₂)
    let f₁₂ : ↑(D.obj i₁) →+* B := CommRingCat.Hom.hom (D.map θ₁₂)
    let R₂ : Fin m₂ → MvPolynomial (Fin m₁) B := fun b => MvPolynomial.map f₁₂ (R₁ b)
    let G₂ : Fin m₂ → MvPolynomial (Fin m₁) B := fun b => MvPolynomial.map f₁₂ (G₁ b)
    let H₂ : MvPolynomial (Fin m₁) B := MvPolynomial.map f₁₂ H₁
    have hR₂ : ∀ b : Fin m₂, MvPolynomial.map (ι_i i₂) (R₂ b) = R_A b := by
      intro b
      dsimp [R₂]
      rw [MvPolynomial.map_map, hι_w θ₁₂, hR₁ b]
    have hJac_B : ∑ b : Fin m₂, G₂ b * R₂ b =
        (Matrix.of (fun a b : Fin m₂ => MvPolynomial.pderiv (μ a) (R₂ b))).det * H₂ - 1 := by
      have h0 : MvPolynomial.map f₁₂ Δ₁ = 0 := hΔ₂
      dsimp [Δ₁] at h0
      rw [map_sub, map_sub, map_mul, map_one, map_sum] at h0
      have hsum_B : (∑ b : Fin m₂, MvPolynomial.map f₁₂ (G₁ b * R₁ b)) =
          ∑ b : Fin m₂, G₂ b * R₂ b := by
        refine Finset.sum_congr rfl ?_
        intro b _
        rw [map_mul]
      have hdet_B : MvPolynomial.map f₁₂ M₁.det =
          (Matrix.of (fun a b : Fin m₂ => MvPolynomial.pderiv (μ a) (R₂ b))).det := by
        rw [RingHom.map_det (MvPolynomial.map f₁₂) M₁]
        congr 1
        refine Matrix.ext fun a b => ?_
        simp only [RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.of_apply, M₁, R₂]
        rw [← MvPolynomial.pderiv_map]
      rw [hsum_B, hdet_B] at h0
      exact sub_eq_zero.mp h0
    obtain ⟨C₀, hRingC₀, g, τ₀, hEt_g, hτ₀_g, hBuild⟩ :=
      hModel B (ι_i i₂) (τ_lvl i₂) (hLvl i₂) R₂ G₂ H₂ hR₂ hJac_B
    letI : CommRing C₀ := hRingC₀
    obtain ⟨j, θ₂, φ, hφ_g, hφ_τ⟩ := hCofinal i₂ C₀ g τ₀ hEt_g hτ₀_g
    let ψ : C₀ →+* A := (ι_i j).comp φ
    have hψ_g : ψ.comp g = ι_i i₂ := by
      rw [RingHom.comp_assoc, hφ_g]
      exact hι_w θ₂
    have hψ_τ : τ_A.comp ψ = τ₀ := by
      have hτ_j : τ_A.comp (ι_i j) = τ_lvl j := RingHom.ext (hLvl j)
      rw [← RingHom.comp_assoc, hτ_j]
      exact hφ_τ
    exact hBuild ψ hψ_g hψ_τ
  refine ⟨?_, hSect⟩
  refine HenselianLocalRing.mk ?_
  intro f hf a₀ ha₀ hderiv
  have ha₀_nu : ¬ IsUnit (Polynomial.eval a₀ f) := by
    rwa [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at ha₀
  have hτ_f : τ_A (Polynomial.eval a₀ f) = 0 :=
    (hUnit (Polynomial.eval a₀ f)).mpr ha₀_nu
  have hτ_df : IsUnit (τ_A (Polynomial.eval a₀ (Polynomial.derivative f))) :=
    hderiv.map τ_A
  let P_et : StandardEtalePair A :=
    StandardEtalePair.mk f hf (Polynomial.derivative f) ⟨1, 0, 1, by simp⟩
  letI : Algebra A k := τ_A.toAlgebra
  have hHasMap_k : P_et.HasMap (τ_A a₀) := by
    refine ⟨?_, ?_⟩
    · change Polynomial.eval₂ τ_A (τ_A a₀) f = 0
      rw [Polynomial.eval₂_hom]
      exact hτ_f
    · change IsUnit (Polynomial.eval₂ τ_A (τ_A a₀) (Polynomial.derivative f))
      rw [Polynomial.eval₂_hom]
      exact hτ_df
  let φ_k : P_et.Ring →ₐ[A] k := P_et.lift (τ_A a₀) hHasMap_k
  have hφ_compat : ∀ a : A, φ_k.toRingHom (algebraMap A P_et.Ring a) = τ_A a :=
    fun a => φ_k.commutes a
  obtain ⟨σ_C, hσ_C⟩ := hSect P_et.Ring φ_k.toRingHom hφ_compat
  let a : A := σ_C P_et.X
  refine ⟨a, ?_, ?_⟩
  · have hHasMap_a : P_et.HasMap a := P_et.hasMap_X.map σ_C
    have hroot : Polynomial.aeval a f = 0 := hHasMap_a.1
    change Polynomial.eval₂ (RingHom.id A) a f = 0 at hroot
    exact hroot
  · rw [IsLocalRing.mem_maximalIdeal]
    apply (hUnit (a - a₀)).mp
    rw [map_sub, hσ_C P_et.X]
    change φ_k P_et.X - τ_A a₀ = 0
    rw [StandardEtalePair.lift_X, sub_self]

theorem weil_isNoetherianRing_of_local_adic_closed_fg (k : Type u) [Field k]
    (A : Type u) [CommRing A] [Algebra k A] [IsLocalRing A]
    (τ_A : A →ₐ[k] k)
    (hUnit : ∀ a : A, τ_A a = 0 ↔ ¬ IsUnit a)
    (hMaxFG : (IsLocalRing.maximalIdeal A).FG)
    (hAdicClosed : ∀ I : Ideal A, I.FG → (⨅ n : ℕ, (I ⊔ IsLocalRing.maximalIdeal A ^ n)) ≤ I) :
    IsNoetherianRing A :=
by
  classical
  let 𝔪 : Ideal A := IsLocalRing.maximalIdeal A
  have hmem_m : ∀ a : A, a ∈ 𝔪 ↔ τ_A a = 0 := by
    intro a
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, ← hUnit a]
  have hres : ∀ w : A, w - algebraMap k A (τ_A w) ∈ 𝔪 := by
    intro w
    rw [hmem_m, map_sub, τ_A.commutes]
    simp
  obtain ⟨s, x, hx_span⟩ := (Submodule.fg_iff_exists_fin_generating_family (N := 𝔪)).mp hMaxFG
  have hx_mem : ∀ t : Fin s, x t ∈ 𝔪 := by
    intro t
    rw [← hx_span]
    exact Submodule.subset_span (Set.mem_range_self t)
  let ev_x : MvPolynomial (Fin s) k →ₐ[k] A := MvPolynomial.aeval x
  have hev_homog : ∀ (d : ℕ) (Q : MvPolynomial (Fin s) k),
      Q.IsHomogeneous d → ev_x Q ∈ 𝔪 ^ d := by
    intro d Q hQ
    conv in ev_x Q => rw [MvPolynomial.as_sum Q]
    rw [map_sum]
    apply Submodule.sum_mem (𝔪 ^ d)
    intro v hv
    have hv_ne := MvPolynomial.mem_support_iff.mp hv
    have hv_deg : Finsupp.degree v = d := by
      by_contra hne
      exact hv_ne (hQ.coeff_eq_zero hne)
    have hv_sum : (∑ t ∈ v.support, v t) = d := by
      rwa [Finsupp.degree_apply] at hv_deg
    dsimp only [ev_x]
    rw [MvPolynomial.aeval_monomial]
    apply Ideal.mul_mem_left
    change (∏ t ∈ v.support, x t ^ v t) ∈ 𝔪 ^ d
    rw [← hv_sum, ← Finset.prod_pow_eq_pow_sum]
    exact Ideal.prod_mem_prod (fun t _ => Ideal.pow_mem_pow (hx_mem t) (v t))
  have hexists_lead : ∀ (d : ℕ) (w : A), w ∈ 𝔪 ^ d →
      ∃ P : MvPolynomial (Fin s) k, P.IsHomogeneous d ∧ w - ev_x P ∈ 𝔪 ^ (d + 1) := by
    intro d
    induction d with
    | zero =>
      intro w _
      refine ⟨MvPolynomial.C (τ_A w), MvPolynomial.isHomogeneous_C (Fin s) (τ_A w), ?_⟩
      change w - MvPolynomial.aeval x (MvPolynomial.C (τ_A w)) ∈ 𝔪 ^ (0 + 1)
      rw [MvPolynomial.aeval_C, zero_add, pow_one]
      exact hres w
    | succ d ih =>
      intro w hw
      rw [pow_succ'] at hw
      refine Submodule.mul_induction_on hw ?_ ?_
      · intro m hm u hu
        rw [← hx_span, Submodule.mem_span_range_iff_exists_fun A] at hm
        obtain ⟨c, hc⟩ := hm
        have hcu : ∀ t : Fin s,
            ∃ P : MvPolynomial (Fin s) k, P.IsHomogeneous d ∧ c t * u - ev_x P ∈ 𝔪 ^ (d + 1) :=
          fun t => ih (c t * u) (Ideal.mul_mem_left (𝔪 ^ d) (c t) hu)
        choose P_t hPt_hom hPt_rem using hcu
        refine ⟨∑ t : Fin s, MvPolynomial.X t * P_t t, ?_, ?_⟩
        · rw [← MvPolynomial.mem_homogeneousSubmodule]
          apply Submodule.sum_mem
          intro t _
          rw [MvPolynomial.mem_homogeneousSubmodule, Nat.add_comm d 1]
          exact (MvPolynomial.isHomogeneous_X k t).mul (hPt_hom t)
        · have hm_eq : m * u = ∑ t : Fin s, x t * (c t * u) := by
            rw [← hc, Finset.sum_mul]
            refine Finset.sum_congr rfl (fun t _ => ?_)
            simp only [smul_eq_mul]
            ring
          have hev_eq : ev_x (∑ t : Fin s, MvPolynomial.X t * P_t t) =
              ∑ t : Fin s, x t * ev_x (P_t t) := by
            rw [map_sum]
            refine Finset.sum_congr rfl (fun t _ => ?_)
            rw [map_mul]
            change MvPolynomial.aeval x (MvPolynomial.X t) * ev_x (P_t t) = x t * ev_x (P_t t)
            rw [MvPolynomial.aeval_X]
          rw [hm_eq, hev_eq, ← Finset.sum_sub_distrib]
          apply Submodule.sum_mem (𝔪 ^ (d + 1 + 1))
          intro t _
          rw [← mul_sub, pow_succ' 𝔪 (d + 1)]
          exact Ideal.mul_mem_mul (hx_mem t) (hPt_rem t)
      · intro z₁ z₂ ⟨P₁, hP₁_hom, hP₁_rem⟩ ⟨P₂, hP₂_hom, hP₂_rem⟩
        refine ⟨P₁ + P₂, hP₁_hom.add hP₂_hom, ?_⟩
        have hrew : (z₁ + z₂) - ev_x (P₁ + P₂) = (z₁ - ev_x P₁) + (z₂ - ev_x P₂) := by
          rw [map_add]
          ring
        rw [hrew]
        exact Submodule.add_mem (𝔪 ^ (d + 1 + 1)) hP₁_rem hP₂_rem
  have hhomog_mul : ∀ (d₀ d : ℕ) (P₀ H : MvPolynomial (Fin s) k),
      P₀.IsHomogeneous d₀ →
      MvPolynomial.homogeneousComponent d (H * P₀) =
        if d₀ ≤ d then MvPolynomial.homogeneousComponent (d - d₀) H * P₀ else 0 := by
    intro d₀ d P₀ H hP₀
    conv_lhs => rw [← MvPolynomial.sum_homogeneousComponent H]
    rw [Finset.sum_mul, map_sum]
    have hterm : ∀ e : ℕ,
        MvPolynomial.homogeneousComponent d (MvPolynomial.homogeneousComponent e H * P₀) =
          if d = e + d₀ then MvPolynomial.homogeneousComponent e H * P₀ else 0 := by
      intro e
      apply MvPolynomial.homogeneousComponent_of_mem
      rw [MvPolynomial.mem_homogeneousSubmodule]
      exact (MvPolynomial.homogeneousComponent_isHomogeneous e H).mul hP₀
    simp_rw [hterm]
    by_cases hd : d₀ ≤ d
    · rw [if_pos hd]
      have hcond : ∀ e ∈ Finset.range (H.totalDegree + 1),
          (if d = e + d₀ then MvPolynomial.homogeneousComponent e H * P₀ else 0) =
            (if e = d - d₀ then MvPolynomial.homogeneousComponent e H * P₀ else 0) := by
        intro e _
        have heq : (d = e + d₀) ↔ (e = d - d₀) := by omega
        simp [heq]
      rw [Finset.sum_congr rfl hcond, Finset.sum_ite_eq']
      by_cases hmem : d - d₀ ∈ Finset.range (H.totalDegree + 1)
      · rw [if_pos hmem]
      · rw [if_neg hmem]
        have hlt : H.totalDegree < d - d₀ := by
          rw [Finset.mem_range] at hmem
          omega
        rw [MvPolynomial.homogeneousComponent_eq_zero (d - d₀) H hlt, zero_mul]
    · rw [if_neg hd]
      apply Finset.sum_eq_zero
      intro e _
      have hne : d ≠ e + d₀ := by omega
      rw [if_neg hne]
  rw [isNoetherianRing_iff_ideal_fg]
  intro J
  let G_J : Set (MvPolynomial (Fin s) k) :=
    {P | ∃ d : ℕ, P.IsHomogeneous d ∧ ∃ y ∈ J, y ∈ 𝔪 ^ d ∧ y - ev_x P ∈ 𝔪 ^ (d + 1)}
  have _ : IsNoetherianRing (MvPolynomial (Fin s) k) := inferInstance
  have hLJ_fg : (Ideal.span G_J).FG := Ideal.fg_of_isNoetherianRing (Ideal.span G_J)
  obtain ⟨F, hF_sub, hF_span⟩ := (Submodule.fg_span_iff_fg_span_finset_subset G_J).mp hLJ_fg
  let P_gen : ↥F → MvPolynomial (Fin s) k := Subtype.val
  have hgen_mem : ∀ j : ↥F,
      ∃ d : ℕ, (P_gen j).IsHomogeneous d ∧ ∃ y ∈ J, y ∈ 𝔪 ^ d ∧ y - ev_x (P_gen j) ∈ 𝔪 ^ (d + 1) :=
    fun j => hF_sub j.2
  choose d_gen hd_hom y_gen hy_J hy_pow hy_rem using hgen_mem
  let I : Ideal A := Ideal.span (Set.range y_gen)
  have hI_fg : I.FG := Submodule.fg_span (Set.finite_range y_gen)
  have hI_le_J : I ≤ J := Ideal.span_le.mpr (Set.range_subset_iff.mpr hy_J)
  have hy_I : ∀ j : ↥F, y_gen j ∈ I := fun j => Submodule.subset_span (Set.mem_range_self j)
  have hpush : ∀ (d : ℕ) (w : A), w ∈ J → w ∈ 𝔪 ^ d →
      ∃ u ∈ I, w - u ∈ J ∧ w - u ∈ 𝔪 ^ (d + 1) := by
    intro d w hwJ hwm
    obtain ⟨P, hP_hom, hP_rem⟩ := hexists_lead d w hwm
    have hP_in_G : P ∈ G_J := ⟨d, hP_hom, w, hwJ, hwm, hP_rem⟩
    have hP_span : P ∈ Submodule.span (MvPolynomial (Fin s) k) (Set.range P_gen) := by
      have hrng : Set.range P_gen = (↑F : Set (MvPolynomial (Fin s) k)) := Subtype.range_coe
      rw [hrng, ← hF_span]
      exact Submodule.subset_span hP_in_G
    rw [Submodule.mem_span_range_iff_exists_fun (MvPolynomial (Fin s) k)] at hP_span
    obtain ⟨H, hH⟩ := hP_span
    let Q : ↥F → MvPolynomial (Fin s) k := fun j =>
      if d_gen j ≤ d then MvPolynomial.homogeneousComponent (d - d_gen j) (H j) else 0
    have hP_eq : P = ∑ j : ↥F, Q j * P_gen j := by
      have hcompP : MvPolynomial.homogeneousComponent d P = P := by
        rw [MvPolynomial.homogeneousComponent_of_mem
          ((MvPolynomial.mem_homogeneousSubmodule d P).mpr hP_hom), if_pos rfl]
      rw [← hcompP, ← hH, map_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      simp only [smul_eq_mul, Q]
      rw [hhomog_mul (d_gen j) d (P_gen j) (H j) (hd_hom j), ite_mul, zero_mul]
    let u : A := ∑ j : ↥F, ev_x (Q j) * y_gen j
    have hu_I : u ∈ I :=
      Submodule.sum_mem I (fun j _ => Ideal.mul_mem_left I (ev_x (Q j)) (hy_I j))
    have hu_rem : u - ev_x P ∈ 𝔪 ^ (d + 1) := by
      have hevP : ev_x P = ∑ j : ↥F, ev_x (Q j) * ev_x (P_gen j) := by
        conv_lhs => rw [hP_eq]
        rw [map_sum]
        exact Finset.sum_congr rfl (fun j _ => map_mul ev_x (Q j) (P_gen j))
      change (∑ j : ↥F, ev_x (Q j) * y_gen j) - ev_x P ∈ 𝔪 ^ (d + 1)
      rw [hevP, ← Finset.sum_sub_distrib]
      apply Submodule.sum_mem (𝔪 ^ (d + 1))
      intro j _
      rw [← mul_sub]
      dsimp [Q]
      by_cases hdj : d_gen j ≤ d
      · rw [if_pos hdj]
        have hQ_hom :
            (MvPolynomial.homogeneousComponent (d - d_gen j) (H j)).IsHomogeneous (d - d_gen j) :=
          MvPolynomial.homogeneousComponent_isHomogeneous (d - d_gen j) (H j)
        have hevQ :
            ev_x (MvPolynomial.homogeneousComponent (d - d_gen j) (H j)) ∈ 𝔪 ^ (d - d_gen j) :=
          hev_homog (d - d_gen j) _ hQ_hom
        have hmul := Ideal.mul_mem_mul hevQ (hy_rem j)
        rw [← pow_add] at hmul
        have hadd : (d - d_gen j) + (d_gen j + 1) = d + 1 := by omega
        rwa [hadd] at hmul
      · rw [if_neg hdj, map_zero, zero_mul]
        exact Submodule.zero_mem (𝔪 ^ (d + 1))
    refine ⟨u, hu_I, Submodule.sub_mem J hwJ (hI_le_J hu_I), ?_⟩
    have hdiff : w - u = (w - ev_x P) - (u - ev_x P) := by ring
    rw [hdiff]
    exact Submodule.sub_mem (𝔪 ^ (d + 1)) hP_rem hu_rem
  have happrox : ∀ (n : ℕ) (z : A), z ∈ J → ∃ u ∈ I, z - u ∈ J ∧ z - u ∈ 𝔪 ^ n := by
    intro n
    induction n with
    | zero =>
      intro z hz
      refine ⟨0, Submodule.zero_mem I, ?_, ?_⟩
      · simpa using hz
      · rw [pow_zero, Ideal.one_eq_top]
        exact Submodule.mem_top
    | succ n ih =>
      intro z hz
      obtain ⟨u₀, hu₀_I, hrem₀_J, hrem₀_m⟩ := ih z hz
      obtain ⟨u₁, hu₁_I, hrem₁_J, hrem₁_m⟩ := hpush n (z - u₀) hrem₀_J hrem₀_m
      refine ⟨u₀ + u₁, Submodule.add_mem I hu₀_I hu₁_I, ?_, ?_⟩
      · rwa [sub_add_eq_sub_sub]
      · rwa [sub_add_eq_sub_sub]
  have hJ_le_inf : J ≤ ⨅ n : ℕ, (I ⊔ 𝔪 ^ n) := by
    intro z hz
    rw [Ideal.mem_iInf]
    intro n
    obtain ⟨u, hu_I, -, hrem_m⟩ := happrox n z hz
    rw [Submodule.mem_sup]
    exact ⟨u, hu_I, z - u, hrem_m, add_sub_cancel u z⟩
  have hJ_le_I : J ≤ I := le_trans hJ_le_inf (hAdicClosed I hI_fg)
  have hJ_eq_I : J = I := le_antisymm hJ_le_I hI_le_J
  rwa [hJ_eq_I]

theorem weil_etale_colimit_maximalIdeal_fg_and_adic_closed (k : Type u) [Field k]
    (R₁ : Type u) [CommRing R₁] [Algebra k R₁] [Algebra.FiniteType k R₁]
    (σ : R₁ →ₐ[k] k)
    (ℐ : Type u) [CategoryTheory.SmallCategory ℐ] [CategoryTheory.IsFiltered ℐ]
    (D : CategoryTheory.Functor ℐ CommRingCat.{u})
    (α : Quiver.Hom ((CategoryTheory.Functor.const ℐ).obj (CommRingCat.of R₁)) D)
    (A : Type u) [CommRing A] [Algebra k A] [IsLocalRing A]
    (f_A : R₁ →ₐ[k] A) (τ_A : A →ₐ[k] k)
    (c : CategoryTheory.Limits.Cocone D) (hc : CategoryTheory.Limits.IsColimit c)
    (e_pt : CategoryTheory.Iso c.pt (CommRingCat.of A))
    (τ_lvl : ∀ i : ℐ, ↑(D.obj i) →+* k)
    (hEt : ∀ i : ℐ, RingHom.Etale (CommRingCat.Hom.hom (α.app i)))
    (hComp : ∀ i : ℐ, CategoryTheory.CategoryStruct.comp (α.app i)
      (CategoryTheory.CategoryStruct.comp (c.ι.app i) e_pt.hom) = CommRingCat.ofHom f_A.toRingHom)
    (hLvl : ∀ (i : ℐ) (x : ↑(D.obj i)),
      τ_A (CommRingCat.Hom.hom (CategoryTheory.CategoryStruct.comp (c.ι.app i) e_pt.hom) x) = τ_lvl i x)
    (hBase : τ_A.comp f_A = σ)
    (hUnit : ∀ a : A, τ_A a = 0 ↔ ¬ IsUnit a) :
    (IsLocalRing.maximalIdeal A).FG ∧
    (∀ I : Ideal A, I.FG → (⨅ n : ℕ, (I ⊔ IsLocalRing.maximalIdeal A ^ n)) ≤ I) :=
by
  classical
  have hNoethR₁ : IsNoetherianRing R₁ :=
    Algebra.FiniteType.isNoetherianRing k R₁
  let p₀ : Ideal R₁ := RingHom.ker σ.toRingHom
  have hp₀_prime : p₀.IsPrime := RingHom.ker_isPrime σ.toRingHom
  let p_lvl : ∀ i : ℐ, Ideal ↑(D.obj i) := fun i => RingHom.ker (τ_lvl i)
  have hp_lvl_prime : ∀ i : ℐ, (p_lvl i).IsPrime := fun i => RingHom.ker_isPrime (τ_lvl i)
  let ι_lvl : ∀ i : ℐ, ↑(D.obj i) →+* A :=
    fun i => CommRingCat.Hom.hom (CategoryTheory.CategoryStruct.comp (c.ι.app i) e_pt.hom)
  let f_lvl : ∀ i : ℐ, R₁ →+* ↑(D.obj i) :=
    fun i => CommRingCat.Hom.hom (α.app i)
  have h_ιf : ∀ i : ℐ, (ι_lvl i).comp (f_lvl i) = f_A.toRingHom := by
    intro i
    ext r
    have h1 := congrArg (fun φ => CommRingCat.Hom.hom φ r) (hComp i)
    simpa [ι_lvl, f_lvl, CommRingCat.hom_comp, CommRingCat.hom_ofHom] using h1
  have hp₀_i : ∀ i : ℐ, p₀ = Ideal.comap (f_lvl i) (p_lvl i) := by
    intro i
    ext r
    change σ r = 0 ↔ τ_lvl i (f_lvl i r) = 0
    have h1 : τ_lvl i (f_lvl i r) = σ r := by
      rw [← hLvl i (f_lvl i r)]
      have h2 : ι_lvl i (f_lvl i r) = f_A r := RingHom.congr_fun (h_ιf i) r
      change τ_A (ι_lvl i (f_lvl i r)) = σ r
      rw [h2]
      exact AlgHom.congr_fun hBase r
    rw [h1]
  have h_nat_f : ∀ {i₁ i₂ : ℐ} (θ : i₁ ⟶ i₂),
      (CommRingCat.Hom.hom (D.map θ)).comp (f_lvl i₁) = f_lvl i₂ := by
    intro i₁ i₂ θ
    have hnat := α.naturality θ
    dsimp at hnat
    rw [CategoryTheory.Category.id_comp] at hnat
    ext r
    have h1 := congrArg (fun φ => CommRingCat.Hom.hom φ r) hnat.symm
    simpa [f_lvl, CommRingCat.hom_comp] using h1
  have h_nat_ι : ∀ {i₁ i₂ : ℐ} (θ : i₁ ⟶ i₂),
      (ι_lvl i₂).comp (CommRingCat.Hom.hom (D.map θ)) = ι_lvl i₁ := by
    intro i₁ i₂ θ
    ext x
    have hcw : CategoryTheory.CategoryStruct.comp (D.map θ)
        (CategoryTheory.CategoryStruct.comp (c.ι.app i₂) e_pt.hom) =
        CategoryTheory.CategoryStruct.comp (c.ι.app i₁) e_pt.hom := by
      rw [← CategoryTheory.Category.assoc, c.w θ]
    have h1 := congrArg (fun φ => CommRingCat.Hom.hom φ x) hcw
    simp only [ι_lvl, CommRingCat.hom_comp, RingHom.comp_apply] at h1 ⊢
    exact h1
  have hp_comap : ∀ {i₁ i₂ : ℐ} (θ : i₁ ⟶ i₂),
      p_lvl i₁ = Ideal.comap (CommRingCat.Hom.hom (D.map θ)) (p_lvl i₂) := by
    intro i₁ i₂ θ
    ext x
    change τ_lvl i₁ x = 0 ↔ τ_lvl i₂ (CommRingCat.Hom.hom (D.map θ) x) = 0
    have h1 : τ_lvl i₂ (CommRingCat.Hom.hom (D.map θ) x) = τ_lvl i₁ x := by
      rw [← hLvl i₂ (CommRingCat.Hom.hom (D.map θ) x), ← hLvl i₁ x]
      change τ_A (ι_lvl i₂ (CommRingCat.Hom.hom (D.map θ) x)) = τ_A (ι_lvl i₁ x)
      have h_eq : ι_lvl i₂ (CommRingCat.Hom.hom (D.map θ) x) = ι_lvl i₁ x :=
        RingHom.congr_fun (h_nat_ι θ) x
      rw [h_eq]
    rw [h1]
  have hComplUnit : ∀ (i : ℐ) (s : ↑(D.obj i)), s ∉ p_lvl i → IsUnit (ι_lvl i s) := by
    intro i s hs
    by_contra hnu
    have h0 : τ_A (ι_lvl i s) = 0 := (hUnit (ι_lvl i s)).mpr hnu
    rw [hLvl i s] at h0
    exact hs h0
  
  have hStageA_max : ∀ i : ℐ,
      Ideal.map ((algebraMap ↑(D.obj i) (Localization.AtPrime (p_lvl i))).comp (f_lvl i)) p₀ =
        IsLocalRing.maximalIdeal (Localization.AtPrime (p_lvl i)) := by
    intro i
    let Q₁ : Type u := ↑(D.obj i)
    let A₀ : Type u := Localization.AtPrime p₀
    let A₁ : Type u := Localization.AtPrime (p_lvl i)
    let ψ₀₁ : A₀ →+* A₁ := Localization.localRingHom p₀ (p_lvl i) (f_lvl i) (hp₀_i i)
    let _ : Algebra R₁ Q₁ := (f_lvl i).toAlgebra
    have : Algebra.Etale R₁ Q₁ := RingHom.etale_algebraMap.mp (hEt i)
    have : Algebra.FormallyUnramified R₁ A₁ := inferInstance
    have : Algebra.EssFiniteType R₁ A₁ := inferInstance
    let _ : Algebra A₀ A₁ := ψ₀₁.toAlgebra
    have : IsScalarTower R₁ A₀ A₁ := IsScalarTower.of_algebraMap_eq (fun r => by
      change (algebraMap Q₁ A₁) (f_lvl i r) = ψ₀₁ (algebraMap R₁ A₀ r)
      exact (Localization.localRingHom_to_map p₀ (p_lvl i) (f_lvl i) (hp₀_i i) r).symm)
    have : Algebra.FormallyUnramified A₀ A₁ := Algebra.FormallyUnramified.of_restrictScalars R₁ A₀ A₁
    have : Algebra.EssFiniteType A₀ A₁ := Algebra.EssFiniteType.of_comp R₁ A₀ A₁
    have : IsLocalHom (algebraMap A₀ A₁) :=
      Localization.isLocalHom_localRingHom p₀ (p_lvl i) (f_lvl i) (hp₀_i i)
    have hcomp₀₁ : ψ₀₁.comp (algebraMap R₁ A₀) = (algebraMap Q₁ A₁).comp (f_lvl i) := by
      ext r
      exact Localization.localRingHom_to_map p₀ (p_lvl i) (f_lvl i) (hp₀_i i) r
    have hmap₀ : Ideal.map (algebraMap R₁ A₀) p₀ = IsLocalRing.maximalIdeal A₀ :=
      IsLocalization.AtPrime.map_eq_maximalIdeal p₀ A₀
    have hmap₀₁ : Ideal.map (algebraMap A₀ A₁) (IsLocalRing.maximalIdeal A₀) =
        IsLocalRing.maximalIdeal A₁ :=
      Algebra.FormallyUnramified.map_maximalIdeal
    change Ideal.map ((algebraMap Q₁ A₁).comp (f_lvl i)) p₀ = IsLocalRing.maximalIdeal A₁
    rw [← hcomp₀₁, ← Ideal.map_map, hmap₀]
    exact hmap₀₁
  
  have hStageA_comap : ∀ {i₁ i₂ : ℐ} (θ : i₁ ⟶ i₂)
      (J : Ideal (Localization.AtPrime (p_lvl i₁))),
      Ideal.comap
        (Localization.localRingHom (p_lvl i₁) (p_lvl i₂) (CommRingCat.Hom.hom (D.map θ)) (hp_comap θ))
        (Ideal.map
          (Localization.localRingHom (p_lvl i₁) (p_lvl i₂) (CommRingCat.Hom.hom (D.map θ)) (hp_comap θ))
          J) = J := by
    intro i₁ i₂ θ J
    let Q₁ : Type u := ↑(D.obj i₁)
    let Q₂ : Type u := ↑(D.obj i₂)
    let φ : Q₁ →+* Q₂ := CommRingCat.Hom.hom (D.map θ)
    let A₁ : Type u := Localization.AtPrime (p_lvl i₁)
    let A₂ : Type u := Localization.AtPrime (p_lvl i₂)
    let ψ_φ : A₁ →+* A₂ := Localization.localRingHom (p_lvl i₁) (p_lvl i₂) φ (hp_comap θ)
    let _ : Algebra R₁ Q₁ := (f_lvl i₁).toAlgebra
    let _ : Algebra R₁ Q₂ := (f_lvl i₂).toAlgebra
    let _ : Algebra Q₁ Q₂ := φ.toAlgebra
    have : Algebra.Etale R₁ Q₁ := RingHom.etale_algebraMap.mp (hEt i₁)
    have : Algebra.Etale R₁ Q₂ := RingHom.etale_algebraMap.mp (hEt i₂)
    have : IsScalarTower R₁ Q₁ Q₂ := IsScalarTower.of_algebraMap_eq (fun r => by
      change f_lvl i₂ r = φ (f_lvl i₁ r)
      exact (RingHom.congr_fun (h_nat_f θ) r).symm)
    have : Module.Flat Q₁ Q₂ := Algebra.FormallyUnramified.flat_of_restrictScalars R₁ Q₁ Q₂
    have : Module.Flat Q₂ A₂ := IsLocalization.flat A₂ (p_lvl i₂).primeCompl
    have : Module.Flat Q₁ A₂ := Module.Flat.trans Q₁ Q₂ A₂
    let _ : Algebra A₁ A₂ := ψ_φ.toAlgebra
    have : IsScalarTower Q₁ A₁ A₂ := IsScalarTower.of_algebraMap_eq (fun q => by
      change (algebraMap Q₂ A₂) (φ q) = ψ_φ (algebraMap Q₁ A₁ q)
      exact (Localization.localRingHom_to_map (p_lvl i₁) (p_lvl i₂) φ (hp_comap θ) q).symm)
    have : Module.Flat A₁ A₂ :=
      (Module.flat_iff_of_isLocalization A₁ (p_lvl i₁).primeCompl A₂).mpr inferInstance
    have : IsLocalHom (algebraMap A₁ A₂) :=
      Localization.isLocalHom_localRingHom (p_lvl i₁) (p_lvl i₂) φ (hp_comap θ)
    have : Module.FaithfullyFlat A₁ A₂ := Module.FaithfullyFlat.of_flat_of_isLocalHom
    exact Ideal.comap_map_eq_self_of_faithfullyFlat J
  
  have hStageB_krull : ∀ (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B]
      (I₁ : Ideal B),
      (⨅ n : ℕ, (I₁ ⊔ IsLocalRing.maximalIdeal B ^ n)) ≤ I₁ := by
    intro B _ _ _ I₁
    by_cases hI₁ : I₁ = ⊤
    · rw [hI₁]
      exact le_top
    · have : Nontrivial (B ⧸ I₁) := Ideal.Quotient.nontrivial_iff.mpr hI₁
      let π : B →+* B ⧸ I₁ := Ideal.Quotient.mk I₁
      have hπ_surj : Function.Surjective π := Ideal.Quotient.mk_surjective
      have : IsLocalRing (B ⧸ I₁) := IsLocalRing.of_surjective' π hπ_surj
      have : IsNoetherianRing (B ⧸ I₁) := Ideal.Quotient.isNoetherianRing I₁
      let m_bar : Ideal (B ⧸ I₁) := Ideal.map π (IsLocalRing.maximalIdeal B)
      have hm_bar_ne_top : m_bar ≠ ⊤ := by
        intro htop
        have hcomap : Ideal.comap π m_bar = Ideal.comap π ⊤ := congrArg (Ideal.comap π) htop
        rw [Ideal.comap_top, Ideal.comap_map_of_surjective' π hπ_surj, Ideal.mk_ker] at hcomap
        have hle : I₁ ≤ IsLocalRing.maximalIdeal B := IsLocalRing.le_maximalIdeal hI₁
        rw [sup_eq_left.mpr hle] at hcomap
        exact (IsLocalRing.maximalIdeal.isMaximal B).ne_top hcomap
      have h_iInf_bot : (⨅ n : ℕ, m_bar ^ n) = ⊥ :=
        Ideal.iInf_pow_eq_bot_of_isLocalRing m_bar hm_bar_ne_top
      have hmap_I₁ : Ideal.map π I₁ = ⊥ := by
        rw [← le_bot_iff, Ideal.map_le_iff_le_comap]
        intro x hx
        rw [Ideal.mem_comap, Submodule.mem_bot]
        exact Ideal.Quotient.eq_zero_iff_mem.mpr hx
      intro z hz
      have hπz_mem : π z ∈ ⨅ n : ℕ, m_bar ^ n := by
        rw [Ideal.mem_iInf]
        intro n
        have hzn : z ∈ I₁ ⊔ IsLocalRing.maximalIdeal B ^ n := Ideal.mem_iInf.mp hz n
        have hmap_mem : π z ∈ Ideal.map π (I₁ ⊔ IsLocalRing.maximalIdeal B ^ n) :=
          Ideal.mem_map_of_mem π hzn
        rw [Ideal.map_sup, Ideal.map_pow, hmap_I₁, bot_sup_eq] at hmap_mem
        exact hmap_mem
      rw [h_iInf_bot, Submodule.mem_bot] at hπz_mem
      exact Ideal.Quotient.eq_zero_iff_mem.mp hπz_mem
  
  let U_ring := CategoryTheory.forget CommRingCat.{u}
  let hcU : CategoryTheory.Limits.IsColimit (U_ring.mapCocone c) :=
    CategoryTheory.Limits.isColimitOfPreserves U_ring hc
  have h_joint_surj : ∀ a : A, ∃ (i : ℐ) (q : ↑(D.obj i)), ι_lvl i q = a := by
    intro a
    obtain ⟨i, q, hq⟩ :=
      CategoryTheory.Limits.Types.jointly_surjective_of_isColimit hcU (CommRingCat.Hom.hom e_pt.inv a)
    refine ⟨i, q, ?_⟩
    have h1 : CommRingCat.Hom.hom e_pt.hom
        ((CategoryTheory.ConcreteCategory.hom ((U_ring.mapCocone c).ι.app i)) q) =
        CommRingCat.Hom.hom e_pt.hom (CommRingCat.Hom.hom e_pt.inv a) :=
      congrArg (CommRingCat.Hom.hom e_pt.hom) hq
    have h2 : CommRingCat.Hom.hom e_pt.hom (CommRingCat.Hom.hom e_pt.inv a) = a := by
      have h_id := congrArg (fun φ => CommRingCat.Hom.hom φ a) e_pt.inv_hom_id
      simp only [CommRingCat.hom_comp, CommRingCat.hom_id, RingHom.comp_apply, RingHom.id_apply] at h_id
      exact h_id
    simpa [U_ring, ι_lvl, CommRingCat.hom_comp, h2] using h1
  have h_colim_ker : ∀ (i : ℐ) (q : ↑(D.obj i)),
      ι_lvl i q = 0 → ∃ (j : ℐ) (θ : i ⟶ j), CommRingCat.Hom.hom (D.map θ) q = 0 := by
    intro i q hq0
    have h_eq : (CategoryTheory.ConcreteCategory.hom ((U_ring.mapCocone c).ι.app i)) q =
        (CategoryTheory.ConcreteCategory.hom ((U_ring.mapCocone c).ι.app i)) 0 := by
      have h_inv : CommRingCat.Hom.hom e_pt.inv (ι_lvl i q) = CommRingCat.Hom.hom e_pt.inv 0 := by
        rw [hq0]
      have h_lhs : CommRingCat.Hom.hom e_pt.inv (ι_lvl i q) = CommRingCat.Hom.hom (c.ι.app i) q := by
        have h_assoc : CategoryTheory.CategoryStruct.comp
            (CategoryTheory.CategoryStruct.comp (c.ι.app i) e_pt.hom) e_pt.inv = c.ι.app i := by
          rw [CategoryTheory.Category.assoc, e_pt.hom_inv_id]
          exact CategoryTheory.Category.comp_id (c.ι.app i)
        have h1 := congrArg (fun φ => CommRingCat.Hom.hom φ q) h_assoc
        simp only [ι_lvl, CommRingCat.hom_comp, RingHom.comp_apply] at h1 ⊢
        exact h1
      rw [h_lhs, map_zero] at h_inv
      simpa [U_ring] using h_inv
    obtain ⟨j, θ, hθ⟩ :=
      (CategoryTheory.Limits.Types.FilteredColimit.isColimit_eq_iff' hcU q 0).mp h_eq
    refine ⟨j, θ, ?_⟩
    have hθ' : CommRingCat.Hom.hom (D.map θ) q = CommRingCat.Hom.hom (D.map θ) 0 := by
      simpa [U_ring] using hθ
    rw [map_zero] at hθ'
    exact hθ'
  let lam_lvl : ∀ i : ℐ, Localization.AtPrime (p_lvl i) →+* A :=
    fun i => IsLocalization.lift (M := (p_lvl i).primeCompl) (S := Localization.AtPrime (p_lvl i))
      (g := ι_lvl i) (fun y => hComplUnit i y.1 y.2)
  have hlam_alg : ∀ (i : ℐ) (x : ↑(D.obj i)),
      lam_lvl i (algebraMap ↑(D.obj i) (Localization.AtPrime (p_lvl i)) x) = ι_lvl i x := by
    intro i x
    exact IsLocalization.lift_eq (fun y : (p_lvl i).primeCompl => hComplUnit i y.1 y.2) x
  let ψ_hom : ∀ {i₁ i₂ : ℐ} (θ : i₁ ⟶ i₂),
      Localization.AtPrime (p_lvl i₁) →+* Localization.AtPrime (p_lvl i₂) :=
    fun {i₁ i₂} θ =>
      Localization.localRingHom (p_lvl i₁) (p_lvl i₂) (CommRingCat.Hom.hom (D.map θ)) (hp_comap θ)
  have hψ_id : ∀ i : ℐ, ψ_hom (CategoryTheory.CategoryStruct.id i) = RingHom.id _ := by
    intro i
    apply IsLocalization.ringHom_ext (p_lvl i).primeCompl
    ext x
    simp only [ψ_hom, RingHom.comp_apply, RingHom.id_apply, Localization.localRingHom_to_map]
    rw [D.map_id]
    simp
  have hψ_comp : ∀ {i₁ i₂ i₃ : ℐ} (θ₁ : i₁ ⟶ i₂) (θ₂ : i₂ ⟶ i₃),
      ψ_hom (CategoryTheory.CategoryStruct.comp θ₁ θ₂) = (ψ_hom θ₂).comp (ψ_hom θ₁) := by
    intro i₁ i₂ i₃ θ₁ θ₂
    apply IsLocalization.ringHom_ext (p_lvl i₁).primeCompl
    ext x
    simp only [ψ_hom, RingHom.comp_apply, Localization.localRingHom_to_map]
    rw [D.map_comp]
    simp [CommRingCat.hom_comp]
  have hψ_comp_apply : ∀ {i₁ i₂ i₃ : ℐ} (θ₁ : i₁ ⟶ i₂) (θ₂ : i₂ ⟶ i₃)
      (w : Localization.AtPrime (p_lvl i₁)),
      ψ_hom (CategoryTheory.CategoryStruct.comp θ₁ θ₂) w = ψ_hom θ₂ (ψ_hom θ₁ w) :=
    fun θ₁ θ₂ w => RingHom.congr_fun (hψ_comp θ₁ θ₂) w
  have hlam_nat : ∀ {i₁ i₂ : ℐ} (θ : i₁ ⟶ i₂), (lam_lvl i₂).comp (ψ_hom θ) = lam_lvl i₁ := by
    intro i₁ i₂ θ
    apply IsLocalization.ringHom_ext (p_lvl i₁).primeCompl
    ext x
    simp only [RingHom.comp_apply, ψ_hom, Localization.localRingHom_to_map, hlam_alg]
    exact RingHom.congr_fun (h_nat_ι θ) x
  have hlam_nat_apply : ∀ {i₁ i₂ : ℐ} (θ : i₁ ⟶ i₂) (w : Localization.AtPrime (p_lvl i₁)),
      lam_lvl i₂ (ψ_hom θ w) = lam_lvl i₁ w :=
    fun θ w => RingHom.congr_fun (hlam_nat θ) w
  have hlam_ker : ∀ (i : ℐ) (w : Localization.AtPrime (p_lvl i)),
      lam_lvl i w = 0 → ∃ (j : ℐ) (θ : i ⟶ j), ψ_hom θ w = 0 := by
    intro i w hw0
    obtain ⟨⟨q, s⟩, hqs⟩ := IsLocalization.surj (p_lvl i).primeCompl w
    have hιq : ι_lvl i q = 0 := by
      have h1 := congrArg (lam_lvl i) hqs
      rw [map_mul, hw0, zero_mul, hlam_alg i q] at h1
      exact h1.symm
    obtain ⟨j, θ, hθq⟩ := h_colim_ker i q hιq
    refine ⟨j, θ, ?_⟩
    have hmul0 : ψ_hom θ w *
        algebraMap ↑(D.obj j) (Localization.AtPrime (p_lvl j))
          (CommRingCat.Hom.hom (D.map θ) s.1) = 0 := by
      have h2 := congrArg (ψ_hom θ) hqs
      rw [map_mul] at h2
      dsimp [ψ_hom] at h2 ⊢
      rw [Localization.localRingHom_to_map, Localization.localRingHom_to_map, hθq, map_zero] at h2
      exact h2
    have hs_mem : CommRingCat.Hom.hom (D.map θ) s.1 ∈ (p_lvl j).primeCompl := by
      intro hmem
      exact s.2 ((SetLike.ext_iff.mp (hp_comap θ) s.1).mpr hmem)
    rcases IsLocalization.map_units (Localization.AtPrime (p_lvl j)) ⟨_, hs_mem⟩ with ⟨u, hu⟩
    rw [← hu] at hmul0
    have hcancel := congrArg (· * (↑u⁻¹ : Localization.AtPrime (p_lvl j))) hmul0
    rw [zero_mul, mul_assoc, Units.mul_inv, mul_one] at hcancel
    exact hcancel
  have hlam_finset : ∀ (S : Finset A), ∃ i₁ : ℐ, (S : Set A) ⊆ Set.range (lam_lvl i₁) := by
    intro S
    refine Finset.induction_on S ?_ ?_
    · obtain ⟨i₀⟩ := CategoryTheory.IsFiltered.nonempty (C := ℐ)
      exact ⟨i₀, by simp⟩
    · intro a S₀ _ ih
      obtain ⟨i₀, hS₀⟩ := ih
      obtain ⟨j, q, hq⟩ := h_joint_surj a
      let i₁ : ℐ := CategoryTheory.IsFiltered.max i₀ j
      let θ₀ : i₀ ⟶ i₁ := CategoryTheory.IsFiltered.leftToMax i₀ j
      let θ_j : j ⟶ i₁ := CategoryTheory.IsFiltered.rightToMax i₀ j
      refine ⟨i₁, ?_⟩
      intro x hx
      rw [Finset.coe_insert, Set.mem_insert_iff] at hx
      rcases hx with rfl | hx₀
      · refine ⟨ψ_hom θ_j (algebraMap ↑(D.obj j) (Localization.AtPrime (p_lvl j)) q), ?_⟩
        rw [hlam_nat_apply θ_j, hlam_alg j q, hq]
      · obtain ⟨w₀, rfl⟩ := hS₀ hx₀
        exact ⟨ψ_hom θ₀ w₀, hlam_nat_apply θ₀ w₀⟩
  have hlam_witness : ∀ (i₁ : ℐ) (J : Ideal (Localization.AtPrime (p_lvl i₁)))
      (z₁ : Localization.AtPrime (p_lvl i₁)),
      lam_lvl i₁ z₁ ∈ Ideal.map (lam_lvl i₁) J →
      ∃ (i₃ : ℐ) (θ : i₁ ⟶ i₃), ψ_hom θ z₁ ∈ Ideal.map (ψ_hom θ) J := by
    intro i₁ J z₁ hz₁_mem
    have h_span : ∀ {y : A} (hy : y ∈ Ideal.map (lam_lvl i₁) J),
        ∃ (i₂ : ℐ) (θ₁₂ : i₁ ⟶ i₂) (u : Localization.AtPrime (p_lvl i₂)),
          u ∈ Ideal.map (ψ_hom θ₁₂) J ∧ lam_lvl i₂ u = y := by
      intro y hy
      change y ∈ Submodule.span A (lam_lvl i₁ '' (J : Set (Localization.AtPrime (p_lvl i₁)))) at hy
      refine Submodule.span_induction
        (p := fun y _ => ∃ (i₂ : ℐ) (θ₁₂ : i₁ ⟶ i₂) (u : Localization.AtPrime (p_lvl i₂)),
          u ∈ Ideal.map (ψ_hom θ₁₂) J ∧ lam_lvl i₂ u = y)
        ?_ ?_ ?_ ?_ hy
      · rintro y ⟨w, hw, rfl⟩
        refine ⟨i₁, CategoryTheory.CategoryStruct.id i₁, w, ?_, rfl⟩
        rw [hψ_id i₁]
        exact Ideal.mem_map_of_mem _ hw
      · exact ⟨i₁, CategoryTheory.CategoryStruct.id i₁, 0, Submodule.zero_mem _, map_zero _⟩
      · rintro y₁ y₂ _ _ ⟨i₂, θ₁₂, u₁, hu₁_mem, rfl⟩ ⟨i₂', θ₁₂', u₂, hu₂_mem, rfl⟩
        obtain ⟨k₀, α₁, α₂, hcomm, -⟩ :=
          CategoryTheory.IsFiltered.bowtie θ₁₂ θ₁₂' θ₁₂ θ₁₂'
        let θ : i₁ ⟶ k₀ := CategoryTheory.CategoryStruct.comp θ₁₂ α₁
        refine ⟨k₀, θ, ψ_hom α₁ u₁ + ψ_hom α₂ u₂, ?_, ?_⟩
        · refine Submodule.add_mem _ ?_ ?_
          · have h1 : ψ_hom α₁ u₁ ∈ Ideal.map (ψ_hom α₁) (Ideal.map (ψ_hom θ₁₂) J) :=
              Ideal.mem_map_of_mem _ hu₁_mem
            rwa [Ideal.map_map, ← hψ_comp θ₁₂ α₁] at h1
          · have h2 : ψ_hom α₂ u₂ ∈ Ideal.map (ψ_hom α₂) (Ideal.map (ψ_hom θ₁₂') J) :=
              Ideal.mem_map_of_mem _ hu₂_mem
            have hψ_eq : ψ_hom (CategoryTheory.CategoryStruct.comp θ₁₂' α₂) = ψ_hom θ :=
              congrArg ψ_hom hcomm.symm
            rw [Ideal.map_map, ← hψ_comp θ₁₂' α₂, hψ_eq] at h2
            exact h2
        · rw [map_add, hlam_nat_apply α₁ u₁, hlam_nat_apply α₂ u₂]
      · rintro a y₁ _ ⟨i₂, θ₁₂, u₁, hu₁_mem, rfl⟩
        obtain ⟨j, q, hq⟩ := h_joint_surj a
        let w_a : Localization.AtPrime (p_lvl j) :=
          algebraMap ↑(D.obj j) (Localization.AtPrime (p_lvl j)) q
        let k₀ : ℐ := CategoryTheory.IsFiltered.max i₂ j
        let α₁ : i₂ ⟶ k₀ := CategoryTheory.IsFiltered.leftToMax i₂ j
        let α₂ : j ⟶ k₀ := CategoryTheory.IsFiltered.rightToMax i₂ j
        let θ : i₁ ⟶ k₀ := CategoryTheory.CategoryStruct.comp θ₁₂ α₁
        refine ⟨k₀, θ, ψ_hom α₂ w_a * ψ_hom α₁ u₁, ?_, ?_⟩
        · have h1 : ψ_hom α₁ u₁ ∈ Ideal.map (ψ_hom α₁) (Ideal.map (ψ_hom θ₁₂) J) :=
            Ideal.mem_map_of_mem _ hu₁_mem
          rw [Ideal.map_map, ← hψ_comp θ₁₂ α₁] at h1
          exact Ideal.mul_mem_left _ _ h1
        · rw [map_mul, smul_eq_mul, hlam_nat_apply α₂ w_a, hlam_alg j q, hq, hlam_nat_apply α₁ u₁]
    obtain ⟨i₂, θ₁₂, u, hu_mem, hu_eq⟩ := h_span hz₁_mem
    have hdiff_ker : lam_lvl i₂ (ψ_hom θ₁₂ z₁ - u) = 0 := by
      rw [map_sub, hlam_nat_apply θ₁₂ z₁, hu_eq, sub_self]
    obtain ⟨i₃, θ₂₃, hθ₂₃⟩ := hlam_ker i₂ (ψ_hom θ₁₂ z₁ - u) hdiff_ker
    let θ : i₁ ⟶ i₃ := CategoryTheory.CategoryStruct.comp θ₁₂ θ₂₃
    refine ⟨i₃, θ, ?_⟩
    have heq_u : ψ_hom θ z₁ = ψ_hom θ₂₃ u := by
      have hsub0 : ψ_hom θ₂₃ (ψ_hom θ₁₂ z₁) - ψ_hom θ₂₃ u = 0 := by
        rw [← map_sub]
        exact hθ₂₃
      rw [hψ_comp_apply θ₁₂ θ₂₃ z₁, sub_eq_zero.mp hsub0]
    rw [heq_u]
    have hmem3 : ψ_hom θ₂₃ u ∈ Ideal.map (ψ_hom θ₂₃) (Ideal.map (ψ_hom θ₁₂) J) :=
      Ideal.mem_map_of_mem _ hu_mem
    rwa [Ideal.map_map, ← hψ_comp θ₁₂ θ₂₃] at hmem3
  
  have hMax_push : ∀ i : ℐ,
      Ideal.map (lam_lvl i) (IsLocalRing.maximalIdeal (Localization.AtPrime (p_lvl i))) =
        Ideal.map f_A.toRingHom p₀ := by
    intro i
    rw [← hStageA_max i, Ideal.map_map]
    have h_eq_hom : (lam_lvl i).comp
        ((algebraMap ↑(D.obj i) (Localization.AtPrime (p_lvl i))).comp (f_lvl i)) =
        f_A.toRingHom := by
      ext r
      simp only [RingHom.comp_apply, hlam_alg]
      exact RingHom.congr_fun (h_ιf i) r
    rw [h_eq_hom]
  have hMax_A : IsLocalRing.maximalIdeal A = Ideal.map f_A.toRingHom p₀ := by
    apply le_antisymm
    · intro a ha
      have ha_nu : ¬ IsUnit a := (IsLocalRing.mem_maximalIdeal a).mp ha
      obtain ⟨i, q, rfl⟩ := h_joint_surj a
      let w : Localization.AtPrime (p_lvl i) :=
        algebraMap ↑(D.obj i) (Localization.AtPrime (p_lvl i)) q
      have hw_eq : lam_lvl i w = ι_lvl i q := hlam_alg i q
      have hw_mem : w ∈ IsLocalRing.maximalIdeal (Localization.AtPrime (p_lvl i)) := by
        rw [IsLocalRing.mem_maximalIdeal]
        intro hwu
        exact ha_nu (hw_eq ▸ hwu.map (lam_lvl i))
      rw [← hMax_push i, ← hw_eq]
      exact Ideal.mem_map_of_mem (lam_lvl i) hw_mem
    · rw [Ideal.map_le_iff_le_comap]
      intro r hr
      rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal]
      have hσ0 : σ r = 0 := hr
      have hτ0 : τ_A (f_A r) = 0 := by
        calc τ_A (f_A r) = (τ_A.comp f_A) r := rfl
          _ = σ r := AlgHom.congr_fun hBase r
          _ = 0 := hσ0
      exact (hUnit (f_A r)).mp hτ0
  refine ⟨?_, ?_⟩
  · rw [hMax_A]
    exact Ideal.FG.map (IsNoetherian.noetherian p₀) f_A.toRingHom
  · intro I hI z hz
    rcases hI with ⟨S_I, hS_I⟩
    obtain ⟨i₁, hi₁_sub⟩ := hlam_finset (insert z S_I)
    have hz_range : z ∈ Set.range (lam_lvl i₁) := hi₁_sub (by simp)
    obtain ⟨z₁, hz₁_eq⟩ := hz_range
    have hx_range : ∀ x : ↥S_I, (x : A) ∈ Set.range (lam_lvl i₁) :=
      fun x => hi₁_sub (Finset.mem_coe.mpr (Finset.mem_insert_of_mem x.2))
    let w : ↥S_I → Localization.AtPrime (p_lvl i₁) := fun x => (hx_range x).choose
    have hw_spec : ∀ x : ↥S_I, lam_lvl i₁ (w x) = (x : A) := fun x => (hx_range x).choose_spec
    let I₁ : Ideal (Localization.AtPrime (p_lvl i₁)) := Ideal.span (Set.range w)
    have hmap_I₁ : Ideal.map (lam_lvl i₁) I₁ = I := by
      dsimp [I₁]
      rw [Ideal.map_span]
      have himg : lam_lvl i₁ '' Set.range w = (S_I : Set A) := by
        ext y
        simp only [Set.mem_image, Set.mem_range]
        constructor
        · rintro ⟨_, ⟨x, rfl⟩, rfl⟩
          rw [hw_spec x]
          exact x.2
        · intro hy
          exact ⟨w ⟨y, hy⟩, ⟨⟨y, hy⟩, rfl⟩, hw_spec ⟨y, hy⟩⟩
      rw [himg]
      exact hS_I
    have hz₁_iInf : z₁ ∈ ⨅ n : ℕ, (I₁ ⊔ IsLocalRing.maximalIdeal (Localization.AtPrime (p_lvl i₁)) ^ n) := by
      rw [Ideal.mem_iInf]
      intro n
      let J_n : Ideal (Localization.AtPrime (p_lvl i₁)) :=
        I₁ ⊔ IsLocalRing.maximalIdeal (Localization.AtPrime (p_lvl i₁)) ^ n
      have hmap_Jn : Ideal.map (lam_lvl i₁) J_n = I ⊔ IsLocalRing.maximalIdeal A ^ n := by
        dsimp [J_n]
        rw [Ideal.map_sup, Ideal.map_pow, hmap_I₁, hMax_push i₁, ← hMax_A]
      have hz_Jn : lam_lvl i₁ z₁ ∈ Ideal.map (lam_lvl i₁) J_n := by
        rw [hz₁_eq, hmap_Jn]
        exact Ideal.mem_iInf.mp hz n
      obtain ⟨i₃, θ, hθ_mem⟩ := hlam_witness i₁ J_n z₁ hz_Jn
      have hcomap_Jn := hStageA_comap θ J_n
      exact (SetLike.ext_iff.mp hcomap_Jn z₁).mp hθ_mem
    have hNoeth_Ai₁ : IsNoetherianRing (Localization.AtPrime (p_lvl i₁)) := by
      let _ : Algebra R₁ ↑(D.obj i₁) := (f_lvl i₁).toAlgebra
      have : Algebra.Etale R₁ ↑(D.obj i₁) := RingHom.etale_algebraMap.mp (hEt i₁)
      have : IsNoetherianRing ↑(D.obj i₁) := Algebra.FiniteType.isNoetherianRing R₁ ↑(D.obj i₁)
      exact IsLocalization.isNoetherianRing (p_lvl i₁).primeCompl (Localization.AtPrime (p_lvl i₁)) inferInstance
    have hz₁_I₁ : z₁ ∈ I₁ := hStageB_krull (Localization.AtPrime (p_lvl i₁)) I₁ hz₁_iInf
    rw [← hz₁_eq, ← hmap_I₁]
    exact Ideal.mem_map_of_mem (lam_lvl i₁) hz₁_I₁

theorem weil_strict_henselization_finiteType_algClosed_noetherian (k : Type u) [Field k] [IsAlgClosed k]
    (R₁ : Type u) [CommRing R₁] [Algebra k R₁] [Algebra.FiniteType k R₁]
    (σ : R₁ →ₐ[k] k) :
    ∃ (ℐ : Type u) (_ : CategoryTheory.SmallCategory ℐ) (_ : CategoryTheory.IsFiltered ℐ)
      (D : CategoryTheory.Functor ℐ CommRingCat.{u})
      (α : Quiver.Hom ((CategoryTheory.Functor.const ℐ).obj (CommRingCat.of R₁)) D)
      (A : Type u) (_ : CommRing A) (_ : Algebra k A)
      (f_A : R₁ →ₐ[k] A) (τ_A : A →ₐ[k] k)
      (c : CategoryTheory.Limits.Cocone D) (_ : CategoryTheory.Limits.IsColimit c)
      (e_pt : CategoryTheory.Iso c.pt (CommRingCat.of A))
      (τ_lvl : ∀ i : ℐ, ↑(D.obj i) →+* k),
      (∀ i : ℐ, RingHom.Etale (CommRingCat.Hom.hom (α.app i))) ∧
      (∀ i : ℐ, CategoryTheory.CategoryStruct.comp (α.app i)
        (CategoryTheory.CategoryStruct.comp (c.ι.app i) e_pt.hom) = CommRingCat.ofHom f_A.toRingHom) ∧
      (∀ (i : ℐ) (x : ↑(D.obj i)),
        τ_A (CommRingCat.Hom.hom (CategoryTheory.CategoryStruct.comp (c.ι.app i) e_pt.hom) x) = τ_lvl i x) ∧
      (τ_A.comp f_A = σ) ∧
      WeilIsStrictLocalNoetherianAlgClosedRing k A τ_A ∧
      (∀ (A' : Type u) [CommRing A'] [Algebra k A'] (τ_A' : A' →ₐ[k] k),
        WeilIsStrictLocalNoetherianAlgClosedRing k A' τ_A' →
        ∀ (g₀ : R₁ →ₐ[k] A'), τ_A'.comp g₀ = σ →
        ∃ (ψ : A →ₐ[k] A'), τ_A'.comp ψ = τ_A ∧ ψ.comp f_A = g₀) :=
by
  classical
  obtain ⟨ℐ, hCat, hFilt, D, α, A, hRingA, hAlgA, f_A, τ_A, c, hc, e_pt, τ_lvl,
    hEt, hComp, hLvl, hBase, hLocA, hUnitA, hCofinal⟩ :=
    weil_pointed_etale_colimit_local_package k R₁ σ
  let _ : CategoryTheory.SmallCategory ℐ := hCat
  let _ : CategoryTheory.IsFiltered ℐ := hFilt
  let _ : CommRing A := hRingA
  let _ : Algebra k A := hAlgA
  have _ : IsLocalRing A := hLocA
  obtain ⟨hHensA, hSectA⟩ :=
    weil_strict_local_etale_section_and_henselian_of_colimit k ℐ D A τ_A.toRingHom c hc e_pt τ_lvl
      hLvl hUnitA hCofinal
  obtain ⟨hMaxFG, hAdicClosed⟩ :=
    weil_etale_colimit_maximalIdeal_fg_and_adic_closed k R₁ σ ℐ D α A f_A τ_A c hc e_pt τ_lvl
      hEt hComp hLvl hBase hUnitA
  have hNoethA : IsNoetherianRing A :=
    weil_isNoetherianRing_of_local_adic_closed_fg k A τ_A hUnitA hMaxFG hAdicClosed
  have hStrictA : WeilIsStrictLocalNoetherianAlgClosedRing k A τ_A :=
    ⟨hNoethA, hLocA, hUnitA, hHensA, hSectA⟩
  refine ⟨ℐ, hCat, hFilt, D, α, A, hRingA, hAlgA, f_A, τ_A, c, hc, e_pt, τ_lvl,
    hEt, hComp, hLvl, hBase, hStrictA, ?_⟩
  intro A' _ _ τ_A' hStrict' g₀ hg₀
  
  have h_lvl_ex : ∀ i : ℐ, ∃! (h : ↑(D.obj i) →+* A'),
      h.comp (CommRingCat.Hom.hom (α.app i)) = g₀.toRingHom ∧
      τ_A'.toRingHom.comp h = τ_lvl i := by
    intro i
    let Q : Type u := ↑(D.obj i)
    let f_Q : R₁ →+* Q := CommRingCat.Hom.hom (α.app i)
    let τ_Q : Q →+* k := τ_lvl i
    have hEt_Q : RingHom.Etale f_Q := hEt i
    have hτ_Q : τ_Q.comp f_Q = σ.toRingHom := by
      ext r
      change τ_lvl i (CommRingCat.Hom.hom (α.app i) r) = σ r
      rw [← hLvl i (CommRingCat.Hom.hom (α.app i) r)]
      have hcr : CommRingCat.Hom.hom (CategoryTheory.CategoryStruct.comp (c.ι.app i) e_pt.hom)
          (CommRingCat.Hom.hom (α.app i) r) = f_A r := by
        have h1 := congrArg (fun φ => CommRingCat.Hom.hom φ r) (hComp i)
        simpa [CommRingCat.hom_comp] using h1
      rw [hcr]
      exact AlgHom.congr_fun hBase r
    let _ : Algebra R₁ Q := f_Q.toAlgebra
    have _ : Algebra.Etale R₁ Q := RingHom.etale_algebraMap.mp hEt_Q
    let _ : Algebra R₁ A' := g₀.toRingHom.toAlgebra
    let _ : Algebra R₁ k := σ.toRingHom.toAlgebra
    let C := TensorProduct R₁ A' Q
    have _ : Algebra.Etale A' C := inferInstance
    let τ_A'_R : A' →ₐ[R₁] k :=
      { τ_A'.toRingHom with commutes' := fun r => AlgHom.congr_fun hg₀ r }
    let τ_Q_R : Q →ₐ[R₁] k :=
      { τ_Q with commutes' := fun r => RingHom.congr_fun hτ_Q r }
    let τ_C : C →+* k :=
      (Algebra.TensorProduct.lift τ_A'_R τ_Q_R (fun _ _ => mul_comm _ _)).toRingHom
    have hτ_C_base : ∀ a' : A', τ_C (algebraMap A' C a') = τ_A' a' := fun a' => by
      change τ_A'_R a' * τ_Q_R 1 = τ_A' a'
      have h1 : τ_Q_R 1 = 1 := map_one τ_Q_R
      rw [h1, mul_one]
      rfl
    obtain ⟨σ_C, hσ_C⟩ := hStrict'.2.2.2.2 C τ_C hτ_C_base
    let ι_Q : Q →+* C := (Algebra.TensorProduct.includeRight : Q →ₐ[R₁] C).toRingHom
    let h₀ : Q →+* A' := σ_C.toRingHom.comp ι_Q
    have hh₀_f : h₀.comp f_Q = g₀.toRingHom := by
      ext r
      change σ_C (TensorProduct.tmul R₁ (1 : A') (f_Q r)) = g₀ r
      have htmul : TensorProduct.tmul R₁ (1 : A') (f_Q r) = algebraMap A' C (g₀ r) := by
        calc TensorProduct.tmul R₁ (1 : A') (f_Q r)
          _ = TensorProduct.tmul R₁ (1 : A') (r • (1 : Q)) := by
              change TensorProduct.tmul R₁ (1 : A') (f_Q r) =
                TensorProduct.tmul R₁ (1 : A') (f_Q r * 1)
              rw [mul_one]
          _ = r • TensorProduct.tmul R₁ (1 : A') (1 : Q) :=
              TensorProduct.tmul_smul (R := R₁) r (1 : A') (1 : Q)
          _ = TensorProduct.tmul R₁ (r • (1 : A')) (1 : Q) := rfl
          _ = TensorProduct.tmul R₁ (g₀ r) (1 : Q) := by
              change TensorProduct.tmul R₁ (g₀ r * 1) (1 : Q) =
                TensorProduct.tmul R₁ (g₀ r) (1 : Q)
              rw [mul_one]
          _ = algebraMap A' C (g₀ r) := rfl
      rw [htmul, AlgHom.commutes]
      rfl
    have hh₀_τ : τ_A'.toRingHom.comp h₀ = τ_Q := by
      ext q
      change τ_A' (σ_C (TensorProduct.tmul R₁ 1 q)) = τ_Q q
      rw [hσ_C]
      change τ_A'_R 1 * τ_Q_R q = τ_Q q
      have h1 : τ_A'_R 1 = 1 := map_one τ_A'_R
      rw [h1, one_mul]
      rfl
    refine ⟨h₀, ⟨hh₀_f, hh₀_τ⟩, ?_⟩
    intro h₁ ⟨hh₁_f, hh₁_τ⟩
    obtain ⟨t, ht_kill, ht_one⟩ :=
      Algebra.FormallyUnramified.iff_exists_tensorProduct.mp
        (inferInstance : Algebra.FormallyUnramified R₁ Q)
    let h₁_alg : Q →ₐ[R₁] A' :=
      { h₁ with commutes' := fun r => RingHom.congr_fun hh₁_f r }
    let h₀_alg : Q →ₐ[R₁] A' :=
      { h₀ with commutes' := fun r => RingHom.congr_fun hh₀_f r }
    let Φ : TensorProduct R₁ Q Q →+* A' :=
      (Algebra.TensorProduct.lift h₁_alg h₀_alg (fun _ _ => mul_comm _ _)).toRingHom
    let u : A' := Φ t
    have hτ_Φ_elem : ∀ z : TensorProduct R₁ Q Q,
        τ_A' (Φ z) = τ_Q ((Algebra.TensorProduct.lmul' R₁ (S := Q)) z) := by
      intro z
      refine TensorProduct.induction_on
        (motive := fun w => τ_A' (Φ w) = τ_Q ((Algebra.TensorProduct.lmul' R₁ (S := Q)) w))
        z ?_ ?_ ?_
      · simp
      · intro x y
        change τ_A' (h₁ x * h₀ y) = τ_Q (x * y)
        have hx : τ_A' (h₁ x) = τ_Q x := RingHom.congr_fun hh₁_τ x
        have hy : τ_A' (h₀ y) = τ_Q y := RingHom.congr_fun hh₀_τ y
        rw [map_mul, map_mul, hx, hy]
      · intro z₁ z₂ ih₁ ih₂
        rw [map_add, map_add, map_add, map_add, ih₁, ih₂]
    have hτ_u : τ_A' u = 1 := by
      change τ_A' (Φ t) = 1
      rw [hτ_Φ_elem t, ht_one, map_one]
    have hu_unit : IsUnit u := by
      by_contra hnu
      have h0 : τ_A' u = 0 := (hStrict'.2.2.1 u).mpr hnu
      rw [hτ_u] at h0
      exact one_ne_zero h0
    ext q
    have hkill_q : Φ ((TensorProduct.tmul R₁ 1 q - TensorProduct.tmul R₁ q 1) * t) = 0 := by
      rw [ht_kill q, map_zero]
    rw [map_mul, map_sub] at hkill_q
    have hΦ1 : Φ (TensorProduct.tmul R₁ 1 q) = h₀ q := by
      change h₁ 1 * h₀ q = h₀ q
      rw [map_one, one_mul]
    have hΦ2 : Φ (TensorProduct.tmul R₁ q 1) = h₁ q := by
      change h₁ q * h₀ 1 = h₁ q
      rw [map_one, mul_one]
    rw [hΦ1, hΦ2] at hkill_q
    have hsub : h₀ q - h₁ q = 0 := hu_unit.mul_left_eq_zero.mp hkill_q
    exact (sub_eq_zero.mp hsub).symm
  
  let h_lvl : ∀ i : ℐ, ↑(D.obj i) →+* A' := fun i => (h_lvl_ex i).choose
  have hh_f : ∀ i : ℐ, (h_lvl i).comp (CommRingCat.Hom.hom (α.app i)) = g₀.toRingHom :=
    fun i => (h_lvl_ex i).choose_spec.1.1
  have hh_τ : ∀ i : ℐ, τ_A'.toRingHom.comp (h_lvl i) = τ_lvl i :=
    fun i => (h_lvl_ex i).choose_spec.1.2
  have hh_uniq : ∀ (i : ℐ) (h' : ↑(D.obj i) →+* A'),
      h'.comp (CommRingCat.Hom.hom (α.app i)) = g₀.toRingHom ∧
        τ_A'.toRingHom.comp h' = τ_lvl i →
      h' = h_lvl i :=
    fun i h' hh' => (h_lvl_ex i).choose_spec.2 h' hh'
  have hh_nat : ∀ {i₁ i₂ : ℐ} (θ : Quiver.Hom i₁ i₂),
      (h_lvl i₂).comp (CommRingCat.Hom.hom (D.map θ)) = h_lvl i₁ := by
    intro i₁ i₂ θ
    apply hh_uniq i₁
    constructor
    · have hα : (CommRingCat.Hom.hom (D.map θ)).comp (CommRingCat.Hom.hom (α.app i₁)) =
          CommRingCat.Hom.hom (α.app i₂) := by
        have hnat := α.naturality θ
        dsimp at hnat
        rw [CategoryTheory.Category.id_comp] at hnat
        exact congrArg CommRingCat.Hom.hom hnat.symm
      rw [RingHom.comp_assoc, hα]
      exact hh_f i₂
    · rw [← RingHom.comp_assoc, hh_τ i₂]
      ext x
      change τ_lvl i₂ (CommRingCat.Hom.hom (D.map θ) x) = τ_lvl i₁ x
      rw [← hLvl i₂ (CommRingCat.Hom.hom (D.map θ) x), ← hLvl i₁ x]
      congr 1
      have hcw : CategoryTheory.CategoryStruct.comp (D.map θ)
          (CategoryTheory.CategoryStruct.comp (c.ι.app i₂) e_pt.hom) =
          CategoryTheory.CategoryStruct.comp (c.ι.app i₁) e_pt.hom := by
        rw [← CategoryTheory.Category.assoc, c.w θ]
      have h1 := congrArg (fun φ => CommRingCat.Hom.hom φ x) hcw
      simpa [CommRingCat.hom_comp] using h1
  let s_cocone : CategoryTheory.Limits.Cocone D :=
    { pt := CommRingCat.of A'
      ι :=
        { app := fun i => CommRingCat.ofHom (h_lvl i)
          naturality := fun i₁ i₂ θ => by
            dsimp
            ext x
            simpa [CommRingCat.hom_comp] using RingHom.congr_fun (hh_nat θ) x } }
  let ψ_hom : Quiver.Hom (CommRingCat.of A) (CommRingCat.of A') :=
    CategoryTheory.CategoryStruct.comp e_pt.inv (hc.desc s_cocone)
  let ψ_ring : A →+* A' := CommRingCat.Hom.hom ψ_hom
  have hψ_f_elem : ∀ r : R₁, ψ_ring (f_A r) = g₀ r := by
    intro r
    obtain ⟨i₀⟩ := CategoryTheory.IsFiltered.nonempty (C := ℐ)
    have hmor : CategoryTheory.CategoryStruct.comp (CommRingCat.ofHom f_A.toRingHom) ψ_hom =
        CategoryTheory.CategoryStruct.comp (α.app i₀) (CommRingCat.ofHom (h_lvl i₀)) := by
      change CategoryTheory.CategoryStruct.comp (CommRingCat.ofHom f_A.toRingHom)
        (CategoryTheory.CategoryStruct.comp e_pt.inv (hc.desc s_cocone)) =
        CategoryTheory.CategoryStruct.comp (α.app i₀) (CommRingCat.ofHom (h_lvl i₀))
      rw [← hComp i₀, CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc e_pt.hom e_pt.inv (hc.desc s_cocone),
        e_pt.hom_inv_id, CategoryTheory.Category.id_comp, hc.fac s_cocone i₀]
    have h1 := congrArg (fun φ => CommRingCat.Hom.hom φ r) hmor
    simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply] at h1
    exact h1.trans (RingHom.congr_fun (hh_f i₀) r)
  let ψ : A →ₐ[k] A' :=
    { ψ_ring with
      commutes' := fun c_k => by
        change ψ_ring (algebraMap k A c_k) = algebraMap k A' c_k
        rw [← f_A.commutes c_k, hψ_f_elem (algebraMap k R₁ c_k), g₀.commutes c_k] }
  have hψ_f : ψ.comp f_A = g₀ := by
    ext r
    exact hψ_f_elem r
  have hψ_τ : τ_A'.comp ψ = τ_A := by
    let u₁ : Quiver.Hom c.pt (CommRingCat.of k) :=
      CategoryTheory.CategoryStruct.comp e_pt.hom
        (CategoryTheory.CategoryStruct.comp ψ_hom (CommRingCat.ofHom τ_A'.toRingHom))
    let u₂ : Quiver.Hom c.pt (CommRingCat.of k) :=
      CategoryTheory.CategoryStruct.comp e_pt.hom (CommRingCat.ofHom τ_A.toRingHom)
    have hu_eq : u₁ = u₂ := by
      apply hc.hom_ext
      intro i
      have hdesc : CategoryTheory.CategoryStruct.comp e_pt.hom ψ_hom = hc.desc s_cocone := by
        dsimp [ψ_hom]
        rw [← CategoryTheory.Category.assoc, e_pt.hom_inv_id, CategoryTheory.Category.id_comp]
      have hu₁ : CategoryTheory.CategoryStruct.comp (c.ι.app i) u₁ =
          CommRingCat.ofHom (τ_lvl i) := by
        dsimp [u₁]
        rw [← CategoryTheory.Category.assoc e_pt.hom ψ_hom _, hdesc,
          ← CategoryTheory.Category.assoc, hc.fac s_cocone i]
        change CategoryTheory.CategoryStruct.comp (CommRingCat.ofHom (h_lvl i))
          (CommRingCat.ofHom τ_A'.toRingHom) = CommRingCat.ofHom (τ_lvl i)
        rw [← CommRingCat.ofHom_comp, hh_τ i]
      have hu₂ : CategoryTheory.CategoryStruct.comp (c.ι.app i) u₂ =
          CommRingCat.ofHom (τ_lvl i) := by
        dsimp [u₂]
        rw [← CategoryTheory.Category.assoc]
        ext x
        simpa [CommRingCat.hom_comp] using hLvl i x
      exact hu₁.trans hu₂.symm
    have hψ_eq : CategoryTheory.CategoryStruct.comp ψ_hom (CommRingCat.ofHom τ_A'.toRingHom) =
        CommRingCat.ofHom τ_A.toRingHom := by
      calc CategoryTheory.CategoryStruct.comp ψ_hom (CommRingCat.ofHom τ_A'.toRingHom)
        _ = CategoryTheory.CategoryStruct.comp
              (CategoryTheory.CategoryStruct.comp e_pt.inv e_pt.hom)
              (CategoryTheory.CategoryStruct.comp ψ_hom (CommRingCat.ofHom τ_A'.toRingHom)) := by
            rw [e_pt.inv_hom_id, CategoryTheory.Category.id_comp]
        _ = CategoryTheory.CategoryStruct.comp e_pt.inv u₁ := by
            dsimp [u₁]; rw [CategoryTheory.Category.assoc]
        _ = CategoryTheory.CategoryStruct.comp e_pt.inv u₂ := by rw [hu_eq]
        _ = CategoryTheory.CategoryStruct.comp
              (CategoryTheory.CategoryStruct.comp e_pt.inv e_pt.hom)
              (CommRingCat.ofHom τ_A.toRingHom) := by
            dsimp [u₂]; rw [← CategoryTheory.Category.assoc]
        _ = CommRingCat.ofHom τ_A.toRingHom := by
            rw [e_pt.inv_hom_id, CategoryTheory.Category.id_comp]
    ext a
    change τ_A' (CommRingCat.Hom.hom ψ_hom a) = τ_A a
    have h1 := congrArg (fun φ => CommRingCat.Hom.hom φ a) hψ_eq
    simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply] at h1
    exact h1
  exact ⟨ψ, hψ_τ, hψ_f⟩

theorem weil_etale_site_pullback_rightAdjoint_and_exact_package : ∃ (hc_all : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
