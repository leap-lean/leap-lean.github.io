    let Pℤ₂ := (CategoryTheory.Functor.const (Opposite Y₂.Etale)).obj Aℤ
    let Pℤ₁ := (CategoryTheory.Functor.const (Opposite Y₁.Etale)).obj Aℤ
    let Fℤ₂ := (CategoryTheory.constantSheaf Y₂.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
    let Fℤ₁ := (CategoryTheory.constantSheaf Y₁.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
    let η₁ := CategoryTheory.Functor.whiskerLeft B_h.op (shAdj₁.unit.app Pℤ₁)
