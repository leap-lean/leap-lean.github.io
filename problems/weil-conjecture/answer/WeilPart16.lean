          (pb_of g).map (bc₀ p_A f_AX π_A hpb_A F₀) ≫ bc_rel K_A ≫ (pf_of f_BX).map β_g' := by
      apply hMate_bc_paste (adj_of p_A) (adj_of p_B) (adj_of g)
