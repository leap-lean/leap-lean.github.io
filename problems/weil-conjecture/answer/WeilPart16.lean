          rw [Algebra.algebraMap_eq_smul_one, Algebra.algebraMap_eq_smul_one]
          exact (TensorProduct.smul_tmul r (1 : L') (1 : E')).symm
        rw [h_tmul, Φ.commutes]
        exact ⟨algebraMap D₀' B r, ι.commutes r⟩
      · rw [TensorProduct.tmul_add, map_add, Pi.add_apply]
        exact Subalgebra.add_mem _ (hx j) (hy j)
      · have h_mul : (1 : L') ⊗ₜ[D₀'] (x * y) = ((1 : L') ⊗ₜ[D₀'] x) * ((1 : L') ⊗ₜ[D₀'] y) := by
          rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul]
        rw [h_mul, map_mul, Pi.mul_apply]
        exact Subalgebra.mul_mem _ (hx j) (hy j)
    have h_mem_z : ∀ (z : TensorProduct D₀' B E') (j : Fin N), Φ (ι_E z) j ∈ Set.range ι := by
      suffices h_sub : ∀ (z : TensorProduct D₀' B E') (j : Fin N), Φ (ι_E z) j ∈ ι.range from
        fun z j => h_sub z j
      intro z j
      obtain ⟨T_z, rfl⟩ := TensorProduct.exists_finset z
      rw [map_sum, map_sum, Finset.sum_apply]
      refine Subalgebra.sum_mem _ (fun q _ => ?_)
      have h_eq : ι_E (q.1 ⊗ₜ[D₀'] q.2) =
          algebraMap L' (TensorProduct D₀' L' E') (ι q.1) * ((1 : L') ⊗ₜ[D₀'] q.2) := by
        change (ι q.1) ⊗ₜ[D₀'] q.2 = ((ι q.1) ⊗ₜ[D₀'] (1 : E')) * ((1 : L') ⊗ₜ[D₀'] q.2)
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      rw [h_eq, map_mul, Pi.mul_apply, Φ.commutes]
      exact Subalgebra.mul_mem _ ⟨q.1, rfl⟩ (h_mem_e q.2 j)
    let φ_fun : TensorProduct D₀' B E' → Fin N → B :=
      fun z j => (h_mem_z z j).choose
    have hφ_spec : ∀ (z : TensorProduct D₀' B E') (j : Fin N),
        ι (φ_fun z j) = Φ (ι_E z) j :=
      fun z j => (h_mem_z z j).choose_spec
    let Φ_B : TensorProduct D₀' B E' →ₐ[B] (Fin N → B) :=
      { toFun := φ_fun
        map_one' := by
          ext j; apply hι_inj
          rw [hφ_spec, map_one, map_one, Pi.one_apply, Pi.one_apply, map_one]
        map_mul' := fun x y => by
          ext j; apply hι_inj
          rw [hφ_spec, map_mul, map_mul, Pi.mul_apply, Pi.mul_apply, map_mul, hφ_spec, hφ_spec]
        map_zero' := by
          ext j; apply hι_inj
          rw [hφ_spec, map_zero, map_zero, Pi.zero_apply, Pi.zero_apply, map_zero]
        map_add' := fun x y => by
          ext j; apply hι_inj
          rw [hφ_spec, map_add, map_add, Pi.add_apply, Pi.add_apply, map_add, hφ_spec, hφ_spec]
        commutes' := fun b => by
          ext j; apply hι_inj
          have hb : ι_E (algebraMap B (TensorProduct D₀' B E') b) =
              algebraMap L' (TensorProduct D₀' L' E') (ι b) := rfl
          rw [hφ_spec, hb, Φ.commutes]
          rfl }
    have h_bwd_mem : ∀ (j : Fin N) (q : ↥(T_bwd j)), q.1.1 ∈ Set.range ι := by
      intro j q
      have hmem_bwd : q.1.1 ∈ S_bwd :=
        Finset.mem_biUnion.mpr ⟨j, Finset.mem_univ j, Finset.mem_image.mpr ⟨q.1, q.2, rfl⟩⟩
      exact hS_sub (Finset.mem_coe.mpr (Finset.mem_union_right S_fwd hmem_bwd))
    let w_tilde : Fin N → TensorProduct D₀' B E' :=
      fun j => ∑ q ∈ (T_bwd j).attach, (h_bwd_mem j q).choose ⊗ₜ[D₀'] q.1.2
    have hw_tilde : ∀ j : Fin N, ι_E (w_tilde j) = Φ.symm (Pi.single j (1 : L')) := by
      intro j
      simp only [w_tilde, map_sum, ι_E, Algebra.TensorProduct.map_tmul, AlgHom.id_apply,
        (h_bwd_mem j _).choose_spec]
      rw [Finset.sum_attach (T_bwd j) (fun q => q.1 ⊗ₜ[D₀'] q.2), ← hT_bwd j]
    let ψ_fun : (Fin N → B) → TensorProduct D₀' B E' :=
      fun c => ∑ j : Fin N, ((c j) ⊗ₜ[D₀'] (1 : E')) * w_tilde j
    have h_calc : ∀ (c : Fin N → B) (k : Fin N), Φ (ι_E (ψ_fun c)) k = ι (c k) := by
      intro c k
      have h1 : ι_E (ψ_fun c) =
          ∑ j : Fin N, algebraMap L' (TensorProduct D₀' L' E') (ι (c j)) *
            Φ.symm (Pi.single j (1 : L')) := by
        simp only [ψ_fun, map_sum, map_mul, hw_tilde]
        rfl
      rw [h1, map_sum, Finset.sum_apply]
      have h2 : ∀ j : Fin N,
          (Φ (algebraMap L' (TensorProduct D₀' L' E') (ι (c j)) *
            Φ.symm (Pi.single j (1 : L')))) k =
          if j = k then ι (c j) else 0 := by
        intro j
        rw [map_mul, Φ.commutes, Φ.apply_symm_apply, Pi.mul_apply]
        change ι (c j) * (Pi.single j (1 : L') : Fin N → L') k = _
        by_cases hjk : j = k
        · subst hjk; simp [Pi.single_eq_same]
        · simp [hjk]
