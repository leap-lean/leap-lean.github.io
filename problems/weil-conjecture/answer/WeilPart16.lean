                F.obj.map (Opposite.op ((hTerm Z).from U₁.unop)) ≫ F.obj.map f :=
              (congrArg (fun k => F.obj.map (Opposite.op k)) h2).trans (F.obj.map_comp _ _)
            exact h1.trans ((congrArg (g_m ≫ ·) h3).trans (CategoryTheory.Category.assoc _ _ _).symm) }
