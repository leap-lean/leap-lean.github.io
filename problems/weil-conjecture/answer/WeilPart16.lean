      intro s
      have hs_mem : s.1 ∈ (Polynomial.aeval α : Polynomial K →ₐ[K] L').range := by
        rw [h_aeval_top]; trivial
      exact hs_mem
    let R_S : ↥S → Polynomial K := fun s => (h_poly_S s).choose
    have hR_S : ∀ s : ↥S, Polynomial.aeval α (R_S s) = s.1 :=
      fun s => (h_poly_S s).choose_spec
    let surj_K := fun c : K => IsLocalization.surj (nonZeroDivisors D₀') c
    let num : K → D₀' := fun c => (surj_K c).choose.1
    let den : K → D₀' := fun c => (surj_K c).choose.2.1
    have h_num_den : ∀ c : K, c * algebraMap D₀' K (den c) = algebraMap D₀' K (num c) :=
      fun c => (surj_K c).choose_spec
    have h_den_ne : ∀ c : K, den c ≠ 0 :=
      fun c => mem_nonZeroDivisors_iff_ne_zero.mp (surj_K c).choose.2.2
    let denPoly : Polynomial K → D₀' := fun P => ∏ n ∈ P.support, den (P.coeff n)
    have h_denPoly_ne : ∀ P : Polynomial K, denPoly P ≠ 0 :=
      fun P => Finset.prod_ne_zero_iff.mpr (fun n _ => h_den_ne (P.coeff n))
    let f : D₀' :=
      denPoly H * denPoly P₀ * denPoly Q₀ * (∏ s ∈ S.attach, denPoly (R_S s))
    have hf_ne : f ≠ 0 :=
      mul_ne_zero
        (mul_ne_zero (mul_ne_zero (h_denPoly_ne H) (h_denPoly_ne P₀)) (h_denPoly_ne Q₀))
        (Finset.prod_ne_zero_iff.mpr (fun s _ => h_denPoly_ne (R_S s)))
    let R_f : Type u := Localization.Away f
    have hf_K_ne : algebraMap D₀' K f ≠ 0 :=
      fun h0 => hf_ne (IsFractionRing.injective D₀' K (h0.trans (map_zero _).symm))
    have h_units : ∀ y : Submonoid.powers f, IsUnit (algebraMap D₀' K y.1) := by
      rintro ⟨_, k, rfl⟩
      rw [map_pow]
      exact IsUnit.mk0 _ (pow_ne_zero k hf_K_ne)
    let j_f : R_f →+* K := IsLocalization.lift h_units
    have hj_eq : ∀ x : D₀', j_f (algebraMap D₀' R_f x) = algebraMap D₀' K x :=
      IsLocalization.lift_eq h_units
    have hj_inv : j_f (IsLocalization.Away.invSelf f) * algebraMap D₀' K f = 1 := by
      rw [← hj_eq f, ← map_mul, mul_comm, IsLocalization.Away.mul_invSelf, map_one]
    have hj_inj : Function.Injective j_f := by
      rw [injective_iff_map_eq_zero]
      intro r hr
      obtain ⟨⟨a, m⟩, h_rm⟩ := IsLocalization.surj (Submonoid.powers f) r
      dsimp only at h_rm
      have ha0 : algebraMap D₀' K a = 0 := by
        have h1 := congrArg j_f h_rm
        rw [map_mul, hr, zero_mul, hj_eq] at h1
        exact h1.symm
      have ha : a = 0 := IsFractionRing.injective D₀' K (ha0.trans (map_zero _).symm)
      rw [ha, map_zero] at h_rm
      obtain ⟨u, hu⟩ := IsLocalization.map_units R_f m
      rw [← hu] at h_rm
      have h_mul := congrArg (· * (↑u⁻¹ : R_f)) h_rm
      simpa [mul_assoc] using h_mul
    have _ : IsDomain R_f := Function.Injective.isDomain j_f hj_inj
    let liftCoeff : ∀ (P : Polynomial K), denPoly P ∣ f → ℕ → R_f :=
      fun P h_dvd n =>
        if hn : n ∈ P.support then
          let hd : den (P.coeff n) ∣ f :=
            dvd_trans (Finset.dvd_prod_of_mem (fun k => den (P.coeff k)) hn) h_dvd
          algebraMap D₀' R_f (num (P.coeff n) * hd.choose) * IsLocalization.Away.invSelf f
        else 0
    have h_liftCoeff : ∀ (P : Polynomial K) (h_dvd : denPoly P ∣ f) (n : ℕ),
        j_f (liftCoeff P h_dvd n) = P.coeff n := by
      intro P h_dvd n
      dsimp only [liftCoeff]
      split_ifs with hn
      · set hd : den (P.coeff n) ∣ f :=
          dvd_trans (Finset.dvd_prod_of_mem (fun k => den (P.coeff k)) hn) h_dvd
        apply mul_right_cancel₀ hf_K_ne
        rw [map_mul, hj_eq, mul_assoc, hj_inv, mul_one, map_mul, ← h_num_den (P.coeff n),
          mul_assoc, ← map_mul, ← hd.choose_spec]
      · rw [map_zero]
        by_contra hc
        exact hn (Polynomial.mem_support_iff.mpr (Ne.symm hc))
    let liftPoly : ∀ (P : Polynomial K), denPoly P ∣ f → Polynomial R_f :=
      fun P h_dvd => ∑ n ∈ P.support, Polynomial.monomial n (liftCoeff P h_dvd n)
    have h_liftPoly : ∀ (P : Polynomial K) (h_dvd : denPoly P ∣ f),
        (liftPoly P h_dvd).map j_f = P := by
      intro P h_dvd
      ext n
      rw [Polynomial.coeff_map, Polynomial.finsetSum_coeff]
      simp only [Polynomial.coeff_monomial, Finset.sum_ite_eq']
      have h_ite : (if n ∈ P.support then liftCoeff P h_dvd n else 0) = liftCoeff P h_dvd n := by
        dsimp only [liftCoeff]
        split_ifs <;> rfl
      rw [h_ite, h_liftCoeff P h_dvd n]
    have hH_dvd : denPoly H ∣ f :=
      ⟨denPoly P₀ * denPoly Q₀ * (∏ s ∈ S.attach, denPoly (R_S s)), by ring⟩
    have hP₀_dvd : denPoly P₀ ∣ f :=
      ⟨denPoly H * denPoly Q₀ * (∏ s ∈ S.attach, denPoly (R_S s)), by ring⟩
    have hQ₀_dvd : denPoly Q₀ ∣ f :=
      ⟨denPoly H * denPoly P₀ * (∏ s ∈ S.attach, denPoly (R_S s)), by ring⟩
    have hRS_dvd : ∀ s : ↥S, denPoly (R_S s) ∣ f := by
      intro s
      exact dvd_mul_of_dvd_right (Finset.dvd_prod_of_mem _ (Finset.mem_attach S s)) _
    let q_low : Polynomial R_f :=
      ∑ k ∈ Finset.range d, Polynomial.monomial k (liftCoeff H hH_dvd k)
    have hq_low_deg : q_low.degree < ↑d := by
      rw [Polynomial.degree_lt_iff_coeff_zero]
      intro m hm
      rw [Polynomial.finsetSum_coeff]
      apply Finset.sum_eq_zero
      intro k hk
      rw [Polynomial.coeff_monomial]
      have hkn : k ≠ m := Nat.ne_of_lt (Nat.lt_of_lt_of_le (Finset.mem_range.mp hk) hm)
      simp only [hkn, ↓reduceIte]
    let H_tilde : Polynomial R_f := Polynomial.X ^ d + q_low
    have hH_tilde_monic : H_tilde.Monic := Polynomial.monic_X_pow_add hq_low_deg
    have hH_tilde_map : H_tilde.map j_f = H := by
      ext n
      rw [Polynomial.coeff_map, Polynomial.coeff_add, Polynomial.coeff_X_pow,
        Polynomial.finsetSum_coeff]
      simp only [Polynomial.coeff_monomial, Finset.sum_ite_eq', Finset.mem_range]
      rcases lt_trichotomy n d with hlt | rfl | hgt
      · have hne : n ≠ d := Nat.ne_of_lt hlt
        simp only [hne, hlt, ↓reduceIte, zero_add]
        exact h_liftCoeff H hH_dvd n
      · have hnl : ¬ d < d := lt_irrefl d
        simp only [↓reduceIte, hnl, add_zero, map_one]
        exact hH_monic.coeff_natDegree.symm
      · have hne : n ≠ d := Nat.ne_of_gt hgt
        have hnl : ¬ n < d := not_lt.mpr (Nat.le_of_lt hgt)
        simp only [hne, hnl, ↓reduceIte, add_zero, map_zero]
        exact (Polynomial.coeff_eq_zero_of_natDegree_lt hgt).symm
    let P_tilde : Polynomial R_f := liftPoly P₀ hP₀_dvd
    let Q_tilde : Polynomial R_f := liftPoly Q₀ hQ₀_dvd
    have hBez_Rf : H_tilde.derivative * Q_tilde + H_tilde * P_tilde = (1 : Polynomial R_f) ^ 1 := by
      apply Polynomial.map_injective j_f hj_inj
      rw [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_mul,
        ← Polynomial.derivative_map, hH_tilde_map,
        h_liftPoly Q₀ hQ₀_dvd, h_liftPoly P₀ hP₀_dvd, one_pow, Polynomial.map_one]
      calc
        H.derivative * Q₀ + H * P₀ = P₀ * H + Q₀ * H.derivative := by ring
        _ = 1 := hBez₀
    let B : Type u := AdjoinRoot H_tilde
    have hFinB : Module.Finite R_f B := (AdjoinRoot.powerBasis' hH_tilde_monic).finite
    have hEtB : Algebra.Etale R_f B := by
      let P_std : StandardEtalePair R_f :=
        StandardEtalePair.mk H_tilde hH_tilde_monic 1 ⟨Q_tilde, P_tilde, 1, hBez_Rf⟩
      have hx₀ : P_std.HasMap (AdjoinRoot.root H_tilde) := by
        refine ⟨?_, ?_⟩
        · change Polynomial.aeval (AdjoinRoot.root H_tilde) H_tilde = 0
          exact AdjoinRoot.aeval_eq H_tilde ▸ AdjoinRoot.mk_self
        · change IsUnit (Polynomial.aeval (AdjoinRoot.root H_tilde) (1 : Polynomial R_f))
          rw [map_one]
          exact isUnit_one
      let u : P_std.Ring →ₐ[R_f] B := P_std.lift (AdjoinRoot.root H_tilde) hx₀
      let v : B →ₐ[R_f] P_std.Ring :=
        AdjoinRoot.liftAlgHom H_tilde (Algebra.ofId R_f P_std.Ring) P_std.X P_std.hasMap_X.1
      have hv_root : v (AdjoinRoot.root H_tilde) = P_std.X :=
        AdjoinRoot.liftAlgHom_root H_tilde _ _ _
      have hu_X : u P_std.X = AdjoinRoot.root H_tilde :=
        StandardEtalePair.lift_X P_std (AdjoinRoot.root H_tilde) hx₀
      have h_uv : u.comp v = AlgHom.id R_f B := by
        apply AdjoinRoot.algHom_ext
        change u (v (AdjoinRoot.root H_tilde)) = AdjoinRoot.root H_tilde
        rw [hv_root, hu_X]
      have h_vu : v.comp u = AlgHom.id R_f P_std.Ring := by
        apply StandardEtalePair.hom_ext
        change v (u P_std.X) = P_std.X
        rw [hu_X, hv_root]
      let e_std : P_std.Ring ≃ₐ[R_f] B := AlgEquiv.ofAlgHom u v h_uv h_vu
      exact Algebra.Etale.of_equiv e_std
    let σ : R_f →+* L' := (algebraMap K L').comp j_f
    have h_ev0 : Polynomial.eval₂ σ α H_tilde = 0 := by
      rw [← Polynomial.eval₂_map, hH_tilde_map]
      exact minpoly.aeval K α
    let ι_ring : B →+* L' := AdjoinRoot.lift σ α h_ev0
    let _ : Algebra D₀' B :=
      RingHom.toAlgebra ((algebraMap R_f B).comp (algebraMap D₀' R_f))
    let ι : B →ₐ[D₀'] L' :=
      { ι_ring with
        commutes' := fun d₀ => by
          change AdjoinRoot.lift σ α h_ev0 (AdjoinRoot.of H_tilde (algebraMap D₀' R_f d₀)) =
            algebraMap D₀' L' d₀
          rw [AdjoinRoot.lift_of]
          dsimp only [σ]
          rw [RingHom.comp_apply, hj_eq, ← IsScalarTower.algebraMap_apply D₀' K L'] }
    have hι_inj : Function.Injective ι := by
      change Function.Injective ι_ring
      rw [injective_iff_map_eq_zero]
      intro x hx
      induction x using AdjoinRoot.induction_on with
      | ih P =>
        let R : Polynomial R_f := P %ₘ H_tilde
        have h_div : R + H_tilde * (P /ₘ H_tilde) = P :=
          Polynomial.modByMonic_add_div P H_tilde
        have h_mk_eq : AdjoinRoot.mk H_tilde P = AdjoinRoot.mk H_tilde R := by
          rw [← h_div, map_add, map_mul, AdjoinRoot.mk_self, zero_mul, add_zero]
        rw [h_mk_eq] at hx ⊢
        have h_aeval_R : Polynomial.aeval α (R.map j_f) = 0 := by
          have h1 : AdjoinRoot.lift σ α h_ev0 (AdjoinRoot.mk H_tilde R) = 0 := hx
          rw [AdjoinRoot.lift_mk] at h1
          change Polynomial.eval₂ (algebraMap K L') α (R.map j_f) = 0
          rw [Polynomial.eval₂_map]
          exact h1
        have h_dvd_R : H ∣ R.map j_f := minpoly.dvd K α h_aeval_R
        have hR_map_zero : R.map j_f = 0 := by
          by_contra h_ne
          have hdeg1 : H.degree ≤ (R.map j_f).degree :=
            Polynomial.degree_le_of_dvd h_dvd_R h_ne
          have hdeg2 : (R.map j_f).degree ≤ R.degree := Polynomial.degree_map_le
          have hdeg3 : R.degree < H_tilde.degree :=
            Polynomial.degree_modByMonic_lt P hH_tilde_monic
          have hdeg4 : H_tilde.degree = H.degree := by
            rw [← hH_tilde_map, hH_tilde_monic.degree_map]
          exact lt_irrefl H.degree (lt_of_le_of_lt (le_trans hdeg1 hdeg2) (hdeg4 ▸ hdeg3))
        have hR_zero : R = 0 :=
          Polynomial.map_injective j_f hj_inj (hR_map_zero.trans (Polynomial.map_zero j_f).symm)
        rw [hR_zero, map_zero]
    have hDomB : IsDomain B := Function.Injective.isDomain ι_ring hι_inj
    have hInj_alg : Function.Injective (algebraMap R_f B) := by
      intro r₁ r₂ hr
      have h1 : ι_ring (AdjoinRoot.of H_tilde r₁) = ι_ring (AdjoinRoot.of H_tilde r₂) :=
        congrArg ι_ring hr
      rw [AdjoinRoot.lift_of, AdjoinRoot.lift_of] at h1
      exact hj_inj ((algebraMap K L').injective h1)
    have hSub_S : (↑S : Set L') ⊆ Set.range ι := by
      intro z hz
      let s : ↥S := ⟨z, hz⟩
      let R_tilde_s : Polynomial R_f := liftPoly (R_S s) (hRS_dvd s)
      refine ⟨AdjoinRoot.mk H_tilde R_tilde_s, ?_⟩
      change AdjoinRoot.lift σ α h_ev0 (AdjoinRoot.mk H_tilde R_tilde_s) = z
      rw [AdjoinRoot.lift_mk, ← Polynomial.eval₂_map, h_liftPoly (R_S s) (hRS_dvd s)]
      exact hR_S s
    exact ⟨f, hf_ne, B, inferInstance, hDomB, inferInstance, hFinB, hEtB, hInj_alg,
      ι, hι_inj, hSub_S⟩
  let K : Type u := FractionRing D₀
  obtain ⟨N₁, L₁, hField₁, hAlg₁, hFin₁, hSep₁, ⟨ψ₁⟩⟩ :=
    h_s1 K (TensorProduct D₀ K E₁)
  let _ : Field L₁ := hField₁
  let _ : Algebra K L₁ := hAlg₁
  have _ : FiniteDimensional K L₁ := hFin₁
  have _ : Algebra.IsSeparable K L₁ := hSep₁
  let _ : Algebra D₀ L₁ :=
    RingHom.toAlgebra ((algebraMap K L₁).comp (algebraMap D₀ K))
  have _ : IsScalarTower D₀ K L₁ := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  obtain ⟨N₂, L, hFieldL, hAlgL₁, hFin₂, hSep₂, ⟨ψ₂⟩⟩ :=
    h_s1 L₁ (TensorProduct D₀ L₁ E₂)
  let _ : Field L := hFieldL
  let _ : Algebra L₁ L := hAlgL₁
  have _ : FiniteDimensional L₁ L := hFin₂
  have _ : Algebra.IsSeparable L₁ L := hSep₂
  let _ : Algebra K L :=
    RingHom.toAlgebra ((algebraMap L₁ L).comp (algebraMap K L₁))
  have _ : IsScalarTower K L₁ L := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  let _ : Algebra D₀ L :=
    RingHom.toAlgebra ((algebraMap K L).comp (algebraMap D₀ K))
  have _ : IsScalarTower D₀ K L := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  have _ : IsScalarTower D₀ L₁ L := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  have _ : FiniteDimensional K L := Module.Finite.trans L₁ L
  have _ : Algebra.IsSeparable K L := Algebra.IsSeparable.trans K L₁ L
  let ψ₁' : TensorProduct D₀ L₁ E₁ ≃ₐ[L₁] (Fin N₁ → L₁) :=
    (Algebra.TensorProduct.cancelBaseChange D₀ K L₁ L₁ E₁).symm.trans ψ₁
  let Φ₁ : TensorProduct D₀ L E₁ ≃ₐ[L] (Fin N₁ → L) :=
    (Algebra.TensorProduct.cancelBaseChange D₀ L₁ L L E₁).symm.trans
      ((Algebra.TensorProduct.congr (AlgEquiv.refl : L ≃ₐ[L] L) ψ₁').trans
        (Algebra.TensorProduct.piScalarRight L₁ L L (Fin N₁)))
  let Φ₂ : TensorProduct D₀ L E₂ ≃ₐ[L] (Fin N₂ → L) :=
    (Algebra.TensorProduct.cancelBaseChange D₀ L₁ L L E₂).symm.trans ψ₂
  obtain ⟨S₁, hDesc₁⟩ := h_s3 D₀ L E₁ N₁ Φ₁
  obtain ⟨S₂, hDesc₂⟩ := h_s3 D₀ L E₂ N₂ Φ₂
  obtain ⟨f, hf_ne, B, hRingB, hDomB, hAlgRfB, hFinB, hEtB, hInjB, ι, hι_inj, hSub⟩ :=
    h_s2 D₀ L (S₁ ∪ S₂)
  let _ : CommRing B := hRingB
  let _ : Algebra (Localization.Away f) B := hAlgRfB
  refine ⟨f, hf_ne, B, hRingB, hDomB, hAlgRfB, hFinB, hEtB, hInjB, N₁, N₂, ?_⟩
  let _ : Algebra D₀ B :=
    RingHom.toAlgebra ((algebraMap (Localization.Away f) B).comp
      (algebraMap D₀ (Localization.Away f)))
  have hS₁ : (↑S₁ : Set L) ⊆ Set.range ι :=
    Set.Subset.trans (Finset.coe_subset.mpr Finset.subset_union_left) hSub
  have hS₂ : (↑S₂ : Set L) ⊆ Set.range ι :=
    Set.Subset.trans (Finset.coe_subset.mpr Finset.subset_union_right) hSub
  exact ⟨hDesc₁ B ι hι_inj hS₁, hDesc₂ B ι hι_inj hS₂⟩

theorem weil_etale_connected_constant_cokernel_of_sheet_split (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    {Y V_Z : AlgebraicGeometry.Scheme.{u}}
    [ConnectedSpace ↥V_Z] [Nonempty ↥V_Z]
    (g_Z : V_Z ⟶ Y)
    (V U : Y.Etale)
    (θ : CategoryTheory.Sheaf.freeYoneda Y.smallEtaleTopology V
        (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))) ⟶
      CategoryTheory.Sheaf.freeYoneda Y.smallEtaleTopology U
        (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))))
    (hSite_g :
      letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) g_Z :=
        CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
      letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) g_Z :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
          (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
      let B_g : CategoryTheory.Functor Y.Etale V_Z.Etale :=
        CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ g_Z
      ∃ (_ : B_g.IsContinuous Y.smallEtaleTopology V_Z.smallEtaleTopology)
        (_ : (B_g.sheafPushforwardContinuous AddCommGrpCat.{u}
          Y.smallEtaleTopology V_Z.smallEtaleTopology).IsRightAdjoint),
        let pb_g := B_g.sheafPullback AddCommGrpCat.{u} Y.smallEtaleTopology V_Z.smallEtaleTopology
        pb_g.Additive ∧
        CategoryTheory.Limits.PreservesFiniteLimits pb_g ∧
        CategoryTheory.Limits.PreservesFiniteColimits pb_g)
    (N₁ N₂ : ℕ)
    (hSplit_V :
      letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) g_Z :=
        CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
      letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) g_Z :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
          (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
      let B_g : CategoryTheory.Functor Y.Etale V_Z.Etale :=
        CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ g_Z
      let T_VZ : V_Z.Etale := AlgebraicGeometry.Scheme.Etale.mk (CategoryTheory.CategoryStruct.id V_Z)
      ∃ (σ₁ : Fin N₁ → (T_VZ ⟶ B_g.obj V)),
        (∀ j : Fin N₁, AlgebraicGeometry.IsOpenImmersion ((AlgebraicGeometry.Scheme.Etale.forget V_Z).map (σ₁ j)).left) ∧
        (∀ i j : Fin N₁, i ≠ j →
          Disjoint
            (Set.range (((AlgebraicGeometry.Scheme.Etale.forget V_Z).map (σ₁ i)).left).base)
            (Set.range (((AlgebraicGeometry.Scheme.Etale.forget V_Z).map (σ₁ j)).left).base)) ∧
        (⋃ j : Fin N₁, Set.range (((AlgebraicGeometry.Scheme.Etale.forget V_Z).map (σ₁ j)).left).base) = Set.univ)
    (hSplit_U :
      letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) g_Z :=
        CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
      letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) g_Z :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
          (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
      let B_g : CategoryTheory.Functor Y.Etale V_Z.Etale :=
        CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ g_Z
      let T_VZ : V_Z.Etale := AlgebraicGeometry.Scheme.Etale.mk (CategoryTheory.CategoryStruct.id V_Z)
      ∃ (σ₂ : Fin N₂ → (T_VZ ⟶ B_g.obj U)),
        (∀ j : Fin N₂, AlgebraicGeometry.IsOpenImmersion ((AlgebraicGeometry.Scheme.Etale.forget V_Z).map (σ₂ j)).left) ∧
        (∀ i j : Fin N₂, i ≠ j →
          Disjoint
            (Set.range (((AlgebraicGeometry.Scheme.Etale.forget V_Z).map (σ₂ i)).left).base)
            (Set.range (((AlgebraicGeometry.Scheme.Etale.forget V_Z).map (σ₂ j)).left).base)) ∧
        (⋃ j : Fin N₂, Set.range (((AlgebraicGeometry.Scheme.Etale.forget V_Z).map (σ₂ j)).left).base) = Set.univ) :
    ∃ (A : AddCommGrpCat.{u}),
      Finite A ∧
      ℓ • CategoryTheory.CategoryStruct.id A = 0 ∧
      WeilIsEtaleSheafPullback g_Z (CategoryTheory.Limits.cokernel θ)
        ((CategoryTheory.constantSheaf V_Z.smallEtaleTopology AddCommGrpCat.{u}).obj A) :=
by
  classical
  let _ : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) g_Z :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  let _ : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) g_Z :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let B_g : CategoryTheory.Functor Y.Etale V_Z.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ g_Z
  obtain ⟨hc_g, hr_g, hAdd_pb, _, hColim_pb⟩ := hSite_g
  let _ := hc_g
  let _ := hr_g
  let _ := hAdd_pb
  let _ := hColim_pb
  let J_Y := Y.smallEtaleTopology
  let J_V := V_Z.smallEtaleTopology
  let pf_g := B_g.sheafPushforwardContinuous AddCommGrpCat.{u} J_Y J_V
  let pb_g := B_g.sheafPullback AddCommGrpCat.{u} J_Y J_V
  let adj_g := B_g.sheafAdjunctionContinuous AddCommGrpCat.{u} J_Y J_V
  let T_VZ : V_Z.Etale := AlgebraicGeometry.Scheme.Etale.mk (CategoryTheory.CategoryStruct.id V_Z)
  let C_V := CategoryTheory.constantSheaf J_V AddCommGrpCat.{u}
  let A_ℓ := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))
  
  have isoOfPrecompBij : ∀ {X₀ Y₀ : CategoryTheory.Sheaf J_V AddCommGrpCat.{u}}
      (c : X₀ ⟶ Y₀),
      (∀ F : CategoryTheory.Sheaf J_V AddCommGrpCat.{u},
        Function.Bijective (fun φ : Y₀ ⟶ F => c ≫ φ)) →
      Nonempty (X₀ ≅ Y₀) := by
    intro X₀ Y₀ c hBij
    obtain ⟨d, hcd⟩ := (hBij X₀).2 (𝟙 X₀)
    change c ≫ d = 𝟙 X₀ at hcd
    have hdc : d ≫ c = 𝟙 Y₀ := (hBij Y₀).1 (by
      change c ≫ (d ≫ c) = c ≫ 𝟙 Y₀
      rw [← CategoryTheory.Category.assoc, hcd,
        CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id])
    exact ⟨⟨c, d, hcd, hdc⟩⟩
  
  have hFreeNat : ∀ {C : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C]
      (J : CategoryTheory.GrothendieckTopology C)
      [CategoryTheory.HasWeakSheafify J AddCommGrpCat.{u}]
      {X : C} {M : AddCommGrpCat.{u}}
      {F₁ F₂ : CategoryTheory.Sheaf J AddCommGrpCat.{u}}
      (α : CategoryTheory.Sheaf.freeYoneda J X M ⟶ F₁) (φ : F₁ ⟶ F₂),
      CategoryTheory.Sheaf.freeYonedaHomEquiv (α ≫ φ) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ φ.hom.app (Opposite.op X) := by
    intro C _ J _ X M F₁ F₂ α φ
    let adj_sh := CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}
    have h1 := adj_sh.homEquiv_naturality_right α φ
    exact (congrArg CategoryTheory.Presheaf.freeYonedaHomEquiv h1).trans
      (CategoryTheory.Presheaf.freeYonedaHomEquiv_comp _
        ((CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u}).map φ))
  
  have hPullFree : ∀ (E : Y.Etale),
      Nonempty (pb_g.obj (CategoryTheory.Sheaf.freeYoneda J_Y E A_ℓ) ≅
        CategoryTheory.Sheaf.freeYoneda J_V (B_g.obj E) A_ℓ) := by
    intro E
    let L_Y := CategoryTheory.Sheaf.freeYoneda J_Y E A_ℓ
    let L_V := CategoryTheory.Sheaf.freeYoneda J_V (B_g.obj E) A_ℓ
    let ι_V : A_ℓ ⟶ L_V.obj.obj (Opposite.op (B_g.obj E)) :=
      CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 L_V)
    let ι_Y : A_ℓ ⟶ (pf_g.obj L_V).obj.obj (Opposite.op E) := ι_V
    let w_E : L_Y ⟶ pf_g.obj L_V :=
      CategoryTheory.Sheaf.freeYonedaHomEquiv.symm ι_Y
    let c_E : pb_g.obj L_Y ⟶ L_V :=
      (adj_g.homEquiv L_Y L_V).symm w_E
    apply isoOfPrecompBij c_E
    intro F
    let E₁ : (pb_g.obj L_Y ⟶ F) ≃ (A_ℓ ⟶ F.obj.obj (Opposite.op (B_g.obj E))) :=
      (adj_g.homEquiv L_Y F).trans CategoryTheory.Sheaf.freeYonedaHomEquiv
    let E₂ : (L_V ⟶ F) ≃ (A_ℓ ⟶ F.obj.obj (Opposite.op (B_g.obj E))) :=
      CategoryTheory.Sheaf.freeYonedaHomEquiv
    have hEq : (fun φ : L_V ⟶ F => c_E ≫ φ) = E₂.trans E₁.symm := by
      funext φ
      apply E₁.injective
      change E₁ (c_E ≫ φ) = E₁ (E₁.symm (E₂ φ))
      rw [E₁.apply_symm_apply]
      have hwE : CategoryTheory.Sheaf.freeYonedaHomEquiv w_E = ι_Y :=
        CategoryTheory.Sheaf.freeYonedaHomEquiv.apply_symm_apply ι_Y
      have h1 : E₁ (c_E ≫ φ) =
          CategoryTheory.Sheaf.freeYonedaHomEquiv w_E ≫
            (pf_g.map φ).hom.app (Opposite.op E) := by
        change CategoryTheory.Sheaf.freeYonedaHomEquiv (adj_g.homEquiv L_Y F (c_E ≫ φ)) = _
        rw [adj_g.homEquiv_naturality_right c_E φ,
          (adj_g.homEquiv L_Y L_V).apply_symm_apply w_E]
        exact hFreeNat J_Y w_E (pf_g.map φ)
      have h2 : CategoryTheory.Sheaf.freeYonedaHomEquiv w_E ≫
            (pf_g.map φ).hom.app (Opposite.op E) =
          ι_V ≫ φ.hom.app (Opposite.op (B_g.obj E)) := by
        rw [hwE]
        rfl
      have h3 : ι_V ≫ φ.hom.app (Opposite.op (B_g.obj E)) = E₂ φ := by
        dsimp [ι_V, E₂]
        rw [← hFreeNat J_V (𝟙 L_V) φ, CategoryTheory.Category.id_comp]
      exact (h1.trans h2).trans h3
    rw [hEq]
    exact (E₂.trans E₁.symm).bijective
  
  let hT_VZ : CategoryTheory.Limits.IsTerminal T_VZ :=
    CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun Z => CategoryTheory.MorphismProperty.Over.homMk Z.hom
        (CategoryTheory.Category.comp_id Z.hom) trivial)
      (fun Z m => CategoryTheory.MorphismProperty.Comma.Hom.ext
        ((CategoryTheory.Category.comp_id m.left).symm.trans
          (CategoryTheory.MorphismProperty.Over.w m))
        (Subsingleton.elim _ _))
  let adj_V := CategoryTheory.constantSheafAdj J_V AddCommGrpCat.{u} hT_VZ
  let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
    @AlgebraicGeometry.Etale
  let _ : P_et.IsStableUnderComposition :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  have hEtComp : ∀ {X₁ X₂ X₃ : AlgebraicGeometry.Scheme.{u}} (f₁ : X₁ ⟶ X₂) (f₂ : X₂ ⟶ X₃),
      AlgebraicGeometry.Etale f₁ → AlgebraicGeometry.Etale f₂ →
      AlgebraicGeometry.Etale (f₁ ≫ f₂) :=
    fun f₁ f₂ hf₁ hf₂ => P_et.comp_mem f₁ f₂ hf₁ hf₂
  have hMemJV : ∀ {X : V_Z.Etale} (R : CategoryTheory.Sieve X),
      R ∈ J_V X ↔ ∀ x : ↥X.left, ∃ (Y₀ : V_Z.Etale) (u : Y₀ ⟶ X) (y : ↥Y₀.left),
        R.arrows u ∧ AlgebraicGeometry.Etale u.left ∧ u.left.base y = x := by
    intro X R
    have hEqJ : J_V = (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        V_Z (le_refl P_et)
    have h1 : (R ∈ J_V X) =
        (R ∈ (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck X) :=
      congrArg (fun (J₀ : CategoryTheory.GrothendieckTopology V_Z.Etale) => R ∈ J₀ X) hEqJ
    exact (iff_of_eq h1).trans
      (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology X R)
  have hEmptyHomEq : ∀ {Z : V_Z.Etale} [IsEmpty ↥Z.left]
      (F : CategoryTheory.Sheaf J_V AddCommGrpCat.{u})
      {E : AddCommGrpCat.{u}} (f₁ f₂ : E ⟶ F.obj.obj (Opposite.op Z)),
      f₁ = f₂ := by
    intro Z _ F E f₁ f₂
    let f₀ : ∀ i : Fin 0, Fin.elim0 i ⟶ Z := fun i => i.elim0
    have hCov0 : CategoryTheory.Sieve.ofArrows (Fin.elim0 : Fin 0 → V_Z.Etale) f₀ ∈ J_V Z := by
      rw [hMemJV]
      intro z
      exact (IsEmpty.false z).elim
    exact F.property.hom_ext_ofArrows f₀ hCov0 (fun i : Fin 0 => i.elim0)
  
  have hSheetIso : ∀ (W : V_Z.Etale) (N : ℕ),
      (∃ (σ : Fin N → (T_VZ ⟶ W)),
        (∀ j : Fin N, AlgebraicGeometry.IsOpenImmersion
          ((AlgebraicGeometry.Scheme.Etale.forget V_Z).map (σ j)).left) ∧
        (∀ i j : Fin N, i ≠ j →
          Disjoint
            (Set.range (((AlgebraicGeometry.Scheme.Etale.forget V_Z).map (σ i)).left).base)
            (Set.range (((AlgebraicGeometry.Scheme.Etale.forget V_Z).map (σ j)).left).base)) ∧
        (⋃ j : Fin N,
          Set.range (((AlgebraicGeometry.Scheme.Etale.forget V_Z).map (σ j)).left).base) = Set.univ) →
      Nonempty (CategoryTheory.Sheaf.freeYoneda J_V W A_ℓ ≅
        C_V.obj (AddCommGrpCat.of (Fin N → A_ℓ))) := by
    intro W N ⟨σ, hOpen, hDisj, hUniv⟩
    let P_N := AddCommGrpCat.of (Fin N → A_ℓ)
    let L_W := CategoryTheory.Sheaf.freeYoneda J_V W A_ℓ
    have hCov_σ : CategoryTheory.Sieve.ofArrows (fun _ : Fin N => T_VZ) σ ∈ J_V W := by
      rw [hMemJV]
      intro w
      have hw : w ∈ (⋃ j : Fin N,
          Set.range (((AlgebraicGeometry.Scheme.Etale.forget V_Z).map (σ j)).left).base) :=
        hUniv.symm ▸ Set.mem_univ w
      rcases Set.mem_iUnion.mp hw with ⟨j, s, hs⟩
      have : AlgebraicGeometry.IsOpenImmersion (σ j).left := hOpen j
      exact ⟨T_VZ, σ j, s, CategoryTheory.Sieve.ofArrows_mk _ σ j, inferInstance, hs⟩
    have hCompat_σ : ∀ (F : CategoryTheory.Sheaf J_V AddCommGrpCat.{u})
        (x : Fin N → (A_ℓ ⟶ F.obj.obj (Opposite.op T_VZ)))
        ⦃Z : V_Z.Etale⦄ ⦃i j : Fin N⦄ (a b : Z ⟶ T_VZ),
        a ≫ σ i = b ≫ σ j →
        x i ≫ F.obj.map a.op = x j ≫ F.obj.map b.op := by
      intro F x Z i j a b hab
      by_cases hij : i = j
      · subst hij
        rw [hT_VZ.hom_ext a b]
      · have : IsEmpty ↥Z.left := ⟨fun z => by
          have hz : (σ i).left.base (a.left.base z) = (σ j).left.base (b.left.base z) :=
            congrArg (fun k : Z ⟶ W => k.left.base z) hab
          exact Set.disjoint_left.mp (hDisj i j hij) ⟨a.left.base z, rfl⟩ ⟨b.left.base z, hz.symm⟩⟩
        exact hEmptyHomEq F _ _
    let E_sheet : ∀ (F : CategoryTheory.Sheaf J_V AddCommGrpCat.{u}),
        (A_ℓ ⟶ F.obj.obj (Opposite.op W)) ≃
          (Fin N → (A_ℓ ⟶ F.obj.obj (Opposite.op T_VZ))) :=
      fun F =>
        { toFun := fun g j => g ≫ F.obj.map (σ j).op
          invFun := fun x => F.property.amalgamateOfArrows σ hCov_σ x (hCompat_σ F x)
          left_inv := fun g =>
            F.property.hom_ext_ofArrows σ hCov_σ (fun j =>
              F.property.amalgamateOfArrows_map σ hCov_σ
                (fun k => g ≫ F.obj.map (σ k).op) (hCompat_σ F _) j)
          right_inv := fun x => funext fun j =>
            F.property.amalgamateOfArrows_map σ hCov_σ x (hCompat_σ F x) j }
    let E_pi : ∀ (B : AddCommGrpCat.{u}),
        (Fin N → (A_ℓ ⟶ B)) ≃ (P_N ⟶ B) :=
      fun B =>
        { toFun := fun x => AddCommGrpCat.ofHom
            { toFun := fun v => ∑ j : Fin N, (x j) (v j)
              map_zero' := by simp
              map_add' := fun v₁ v₂ => by simp [Finset.sum_add_distrib] }
          invFun := fun u j => AddCommGrpCat.ofHom
            { toFun := fun (m : ↥A_ℓ) => u (Pi.single j m)
              map_zero' := by
                change u (Pi.single j (0 : ↥A_ℓ)) = 0
                rw [Pi.single_zero, map_zero]
              map_add' := fun (m₁ m₂ : ↥A_ℓ) => by
                change u (Pi.single j (m₁ + m₂ : ↥A_ℓ)) =
                  u (Pi.single j m₁) + u (Pi.single j m₂)
                rw [Pi.single_add, map_add] }
          left_inv := fun x => by
            funext j
            apply AddCommGrpCat.ext
            intro (m : ↥A_ℓ)
            change (∑ k : Fin N, (x k) ((Pi.single j m : Fin N → ↥A_ℓ) k)) = (x j) m
            rw [Finset.sum_eq_single j]
            · rw [Pi.single_eq_same]
            · intro k _ hkj
              rw [Pi.single_eq_of_ne hkj, map_zero]
            · intro hj
              exact (hj (Finset.mem_univ j)).elim
          right_inv := fun u => by
            apply AddCommGrpCat.ext
            intro (v : Fin N → ↥A_ℓ)
            change (∑ j : Fin N, u (Pi.single j (v j))) = u v
            rw [← map_sum, Finset.univ_sum_single] }
    let E_L : ∀ (F : CategoryTheory.Sheaf J_V AddCommGrpCat.{u}),
        (L_W ⟶ F) ≃ (P_N ⟶ F.obj.obj (Opposite.op T_VZ)) :=
      fun F => CategoryTheory.Sheaf.freeYonedaHomEquiv.trans
        ((E_sheet F).trans (E_pi (F.obj.obj (Opposite.op T_VZ))))
    let E_R : ∀ (F : CategoryTheory.Sheaf J_V AddCommGrpCat.{u}),
        (C_V.obj P_N ⟶ F) ≃ (P_N ⟶ F.obj.obj (Opposite.op T_VZ)) :=
      fun F => adj_V.homEquiv P_N F
    let c_W : L_W ⟶ C_V.obj P_N := (E_L (C_V.obj P_N)).symm (E_R (C_V.obj P_N) (𝟙 _))
    apply isoOfPrecompBij c_W
    intro F
    have hEq : (fun φ : C_V.obj P_N ⟶ F => c_W ≫ φ) = (E_R F).trans (E_L F).symm := by
      funext φ
      apply (E_L F).injective
      change E_L F (c_W ≫ φ) = E_L F ((E_L F).symm (E_R F φ))
      rw [(E_L F).apply_symm_apply]
      have hcW : E_L (C_V.obj P_N) c_W = E_R (C_V.obj P_N) (𝟙 _) :=
        (E_L (C_V.obj P_N)).apply_symm_apply _
      have hNatR : E_R F φ =
          E_R (C_V.obj P_N) (𝟙 _) ≫ φ.hom.app (Opposite.op T_VZ) := by
        dsimp [E_R]
        have h1 := adj_V.homEquiv_naturality_right (𝟙 (C_V.obj P_N)) φ
        rw [CategoryTheory.Category.id_comp] at h1
        exact h1
      rw [hNatR, ← hcW]
      apply AddCommGrpCat.ext
      intro (v : Fin N → ↥A_ℓ)
      change (∑ j : Fin N,
          ((CategoryTheory.Sheaf.freeYonedaHomEquiv (c_W ≫ φ)) ≫
            F.obj.map (σ j).op) (v j)) =
        φ.hom.app (Opposite.op T_VZ)
          (∑ j : Fin N,
            ((CategoryTheory.Sheaf.freeYonedaHomEquiv c_W) ≫
              (C_V.obj P_N).obj.map (σ j).op) (v j))
      rw [hFreeNat J_V c_W φ, map_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [CategoryTheory.Category.assoc, ← φ.hom.naturality (σ j).op,
        ← CategoryTheory.Category.assoc]
      rfl
    rw [hEq]
    exact ((E_R F).trans (E_L F).symm).bijective
  
  let P_lc : AddCommGrpCat.{u} → CategoryTheory.Functor (Opposite V_Z.Etale) AddCommGrpCat.{u} :=
    fun M =>
      { obj := fun W => AddCommGrpCat.of (LocallyConstant ↥W.unop.left ↥M)
        map := fun f => AddCommGrpCat.ofHom
          { toFun := fun g =>
              ⟨g ∘ f.unop.left.base,
                g.isLocallyConstant.comp_continuous f.unop.left.continuous⟩
            map_zero' := by ext; rfl
            map_add' := fun _ _ => by ext; rfl }
        map_id := by intro W; ext g x; rfl
        map_comp := by intro W₁ W₂ W₃ f₁ f₂; ext g x; rfl }
  have hSh_lc : ∀ M : AddCommGrpCat.{u}, CategoryTheory.Presheaf.IsSheaf J_V (P_lc M) := by
    intro M E W R hR
    rw [← CategoryTheory.Presieve.isSeparatedFor_and_exists_isAmalgamation_iff_isSheafFor]
    have hR_surj := (hMemJV R).mp hR
    refine ⟨?_, ?_⟩
    · intro x t₁ t₂ ht₁ ht₂
      let t₁' : E ⟶ (P_lc M).obj (Opposite.op W) := t₁
      let t₂' : E ⟶ (P_lc M).obj (Opposite.op W) := t₂
      show t₁' = t₂'
      ext e w
      obtain ⟨U_w, u_w, z_w, hu_w, _, hzw⟩ := hR_surj w
      have h12 : t₁' ≫ (P_lc M).map u_w.op = t₂' ≫ (P_lc M).map u_w.op :=
        (ht₁ u_w hu_w).trans (ht₂ u_w hu_w).symm
      have h_pt := congrArg (fun (k : E ⟶ (P_lc M).obj (Opposite.op U_w)) => k e z_w) h12
      change t₁' e (u_w.left.base z_w) = t₂' e (u_w.left.base z_w) at h_pt
      rwa [hzw] at h_pt
    · intro x hx
      let xHom : ∀ {U₀ : V_Z.Etale} (u₀ : U₀ ⟶ W), R.arrows u₀ →
          (E ⟶ (P_lc M).obj (Opposite.op U₀)) := fun u₀ hu₀ => x u₀ hu₀
      have h_agree : ∀ {U₁ U₂ : V_Z.Etale} (u₁ : U₁ ⟶ W) (u₂ : U₂ ⟶ W)
          (hu₁ : R.arrows u₁) (hu₂ : R.arrows u₂)
          (z₁ : ↥U₁.left) (z₂ : ↥U₂.left),
          u₁.left.base z₁ = u₂.left.base z₂ →
          ∀ e : ↥E, (xHom u₁ hu₁) e z₁ = (xHom u₂ hu₂) e z₂ := by
        intro U₁ U₂ u₁ u₂ hu₁ hu₂ z₁ z₂ h_eq e
        have hEt_u₂ : AlgebraicGeometry.Etale u₂.left := by
          have hw : u₂.left ≫ W.hom = U₂.hom := CategoryTheory.MorphismProperty.Over.w u₂
          have hU₂ : P_et (u₂.left ≫ W.hom) := hw.symm ▸ U₂.prop
          exact P_et.of_postcomp u₂.left W.hom W.prop hU₂
        let π₁ := CategoryTheory.Limits.pullback.fst u₁.left u₂.left
        let π₂ := CategoryTheory.Limits.pullback.snd u₁.left u₂.left
        have hEt_π₁ : AlgebraicGeometry.Etale π₁ :=
          CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
            (CategoryTheory.IsPullback.of_hasPullback u₁.left u₂.left).flip hEt_u₂
        let P_et_obj : V_Z.Etale :=
          CategoryTheory.MorphismProperty.Over.mk ⊤ (π₁ ≫ U₁.hom) (hEtComp π₁ U₁.hom hEt_π₁ U₁.prop)
        let p₁ : P_et_obj ⟶ U₁ :=
          CategoryTheory.MorphismProperty.Over.homMk π₁ rfl trivial
        let p₂ : P_et_obj ⟶ U₂ :=
          CategoryTheory.MorphismProperty.Over.homMk π₂
            (by
              change π₂ ≫ U₂.hom = π₁ ≫ U₁.hom
              rw [← CategoryTheory.MorphismProperty.Over.w u₁,
                ← CategoryTheory.MorphismProperty.Over.w u₂,
                ← CategoryTheory.Category.assoc,
                ← CategoryTheory.Category.assoc,
                CategoryTheory.Limits.pullback.condition])
            trivial
        have hp_comm : p₁ ≫ u₁ = p₂ ≫ u₂ :=
          CategoryTheory.MorphismProperty.Comma.Hom.ext
            CategoryTheory.Limits.pullback.condition (Subsingleton.elim _ _)
        obtain ⟨p, hp₁, hp₂⟩ :=
          AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback z₁ z₂ h_eq
        have h_comp : xHom u₁ hu₁ ≫ (P_lc M).map p₁.op = xHom u₂ hu₂ ≫ (P_lc M).map p₂.op :=
          hx p₁ p₂ hu₁ hu₂ hp_comm
        have h_ev := congrArg (fun (k : E ⟶ (P_lc M).obj (Opposite.op P_et_obj)) => k e p) h_comp
        change (xHom u₁ hu₁) e (π₁.base p) = (xHom u₂ hu₂) e (π₂.base p) at h_ev
        rwa [hp₁, hp₂] at h_ev
      let U_w : ↥W.left → V_Z.Etale := fun w => (hR_surj w).choose
      let u_w : ∀ w : ↥W.left, U_w w ⟶ W := fun w => (hR_surj w).choose_spec.choose
      let z_w : ∀ w : ↥W.left, ↥(U_w w).left :=
        fun w => (hR_surj w).choose_spec.choose_spec.choose
      have hu_w : ∀ w : ↥W.left, R.arrows (u_w w) :=
        fun w => (hR_surj w).choose_spec.choose_spec.choose_spec.1
      have hEt_w : ∀ w : ↥W.left, AlgebraicGeometry.Etale (u_w w).left :=
        fun w => (hR_surj w).choose_spec.choose_spec.choose_spec.2.1
      have hzw : ∀ w : ↥W.left, (u_w w).left.base (z_w w) = w :=
        fun w => (hR_surj w).choose_spec.choose_spec.choose_spec.2.2
      let g₀ : ↥E → ↥W.left → ↥M := fun e w => (xHom (u_w w) (hu_w w)) e (z_w w)
      have hg₀_eval : ∀ {U₀ : V_Z.Etale} (u₀ : U₀ ⟶ W) (hu₀ : R.arrows u₀)
          (z₀ : ↥U₀.left) (e : ↥E),
          g₀ e (u₀.left.base z₀) = (xHom u₀ hu₀) e z₀ :=
        fun u₀ hu₀ z₀ e => h_agree (u_w _) u₀ (hu_w _) hu₀ (z_w _) z₀ (hzw _) e
      have hg₀_lc : ∀ e : ↥E, IsLocallyConstant (g₀ e) := by
        intro e
        rw [IsLocallyConstant.iff_exists_open]
        intro w
        let O' : Set ↥(U_w w).left := ((xHom (u_w w) (hu_w w)) e) ⁻¹' {g₀ e w}
        have hO'_open : IsOpen O' :=
          IsLocallyConstant.iff_isOpen_fiber.mp
            ((xHom (u_w w) (hu_w w)) e).isLocallyConstant (g₀ e w)
        let _ : AlgebraicGeometry.Etale (u_w w).left := hEt_w w
        refine ⟨(u_w w).left.base '' O',
          (u_w w).left.isOpenMap O' hO'_open,
          ⟨z_w w, rfl, hzw w⟩, ?_⟩
        rintro _ ⟨z', hz', rfl⟩
        rw [hg₀_eval (u_w w) (hu_w w) z' e]
        exact hz'
      let t : E ⟶ (P_lc M).obj (Opposite.op W) := AddCommGrpCat.ofHom
        { toFun := fun e => ⟨g₀ e, hg₀_lc e⟩
          map_zero' := by
            ext w
            change (xHom (u_w w) (hu_w w)) 0 (z_w w) = 0
            rw [map_zero]
            rfl
          map_add' := fun e₁ e₂ => by
            ext w
            change (xHom (u_w w) (hu_w w)) (e₁ + e₂) (z_w w) =
              (xHom (u_w w) (hu_w w)) e₁ (z_w w) + (xHom (u_w w) (hu_w w)) e₂ (z_w w)
            rw [map_add]
            rfl }
      refine ⟨t, fun U₀ u₀ hu₀ => ?_⟩
      show t ≫ (P_lc M).map u₀.op = xHom u₀ hu₀
      ext e z₀
      exact hg₀_eval u₀ hu₀ z₀ e
  let L_lc : AddCommGrpCat.{u} → CategoryTheory.Sheaf J_V AddCommGrpCat.{u} :=
    fun M => ⟨P_lc M, hSh_lc M⟩
  
  let Z₁ := AddCommGrpCat.of (ULift.{u} ℤ)
  let ev₁ : ∀ (B : AddCommGrpCat.{u}), (Z₁ ⟶ B) ≃ ↥B := fun B =>
    { toFun := fun h => h (ULift.up (1 : ℤ))
      invFun := fun b => AddCommGrpCat.ofHom
        { toFun := fun n => n.down • b
          map_zero' := by simp
          map_add' := fun m n => add_zsmul b m.down n.down }
      left_inv := fun h => by
        ext ⟨n⟩
        change n • h (ULift.up 1) = h (ULift.up n)
        rw [← map_zsmul h.hom]
        congr 1
        exact ULift.ext _ _ (mul_one n)
      right_inv := fun b => one_zsmul b }
  have hSepElem : ∀ (F : CategoryTheory.Sheaf J_V AddCommGrpCat.{u})
      {W : V_Z.Etale} (R : CategoryTheory.Sieve W) (hR : R ∈ J_V W)
      (s₁ s₂ : ↥(F.obj.obj (Opposite.op W))),
      (∀ {Z : V_Z.Etale} (u : Z ⟶ W), R.arrows u →
        (F.obj.map u.op) s₁ = (F.obj.map u.op) s₂) →
      s₁ = s₂ := by
    intro F W R hR s₁ s₂ hEq
    apply (ev₁ _).symm.injective
    let x_R : CategoryTheory.Presieve.FamilyOfElements
        (F.obj.comp (CategoryTheory.coyoneda.obj (Opposite.op Z₁))) R.arrows :=
      fun Z u _ => (ev₁ _).symm ((F.obj.map u.op) s₁)
    refine (F.property Z₁ R hR).isSeparatedFor x_R _ _ (fun Z u _ => ?_) (fun Z u hu => ?_)
    · show ((ev₁ _).symm s₁ ≫ F.obj.map u.op : Z₁ ⟶ F.obj.obj (Opposite.op Z)) =
        (ev₁ _).symm ((F.obj.map u.op) s₁)
      ext ⟨n⟩
      change (F.obj.map u.op) (n • s₁) = n • (F.obj.map u.op) s₁
      exact map_zsmul (F.obj.map u.op).hom n s₁
    · show ((ev₁ _).symm s₂ ≫ F.obj.map u.op : Z₁ ⟶ F.obj.obj (Opposite.op Z)) =
        (ev₁ _).symm ((F.obj.map u.op) s₁)
      ext ⟨n⟩
      change (F.obj.map u.op) (n • s₂) = n • (F.obj.map u.op) s₁
      rw [map_zsmul (F.obj.map u.op).hom n s₂, hEq u hu]
  let S_g : ∀ {M : AddCommGrpCat.{u}} (W : V_Z.Etale)
      (_ : LocallyConstant ↥W.left ↥M), CategoryTheory.Sieve W :=
    fun {M} W g =>
      { arrows := fun {Z} u => ∃ m : ↥M, ∀ z : ↥Z.left, g (u.left.base z) = m
        downward_closed := by
          rintro Z Z' u ⟨m, hm⟩ f
          exact ⟨m, fun z' => hm (f.left.base z')⟩ }
  have hS_g : ∀ {M : AddCommGrpCat.{u}} (W : V_Z.Etale)
      (g : LocallyConstant ↥W.left ↥M), S_g W g ∈ J_V W := by
    intro M W g
    rw [hMemJV]
    intro w
    let U_w : W.left.Opens :=
      ⟨g ⁻¹' {g w}, IsLocallyConstant.iff_isOpen_fiber.mp g.isLocallyConstant (g w)⟩
    have hEt_Uw : AlgebraicGeometry.Etale (U_w.ι ≫ W.hom) := hEtComp U_w.ι W.hom inferInstance W.prop
    let E_w : V_Z.Etale :=
      CategoryTheory.MorphismProperty.Over.mk ⊤ (U_w.ι ≫ W.hom) hEt_Uw
    let j_w : E_w ⟶ W :=
      CategoryTheory.MorphismProperty.Over.homMk U_w.ι rfl trivial
    refine ⟨E_w, j_w, ⟨w, rfl⟩, ⟨g w, fun z => z.2⟩, ?_, rfl⟩
    change AlgebraicGeometry.Etale U_w.ι
    infer_instance
  have hExtUniv : ∀ (M : AddCommGrpCat.{u})
      (F : CategoryTheory.Sheaf J_V AddCommGrpCat.{u})
      (φ : M ⟶ F.obj.obj (Opposite.op T_VZ)),
      ∃! (ξ : L_lc M ⟶ F),
        ∀ m : ↥M, ξ.hom.app (Opposite.op T_VZ) (LocallyConstant.const ↥V_Z m) = φ m := by
    intro M F φ
    let y_fam : ∀ (W : V_Z.Etale) (g : LocallyConstant ↥W.left ↥M),
        CategoryTheory.Presieve.FamilyOfElements
          (F.obj.comp (CategoryTheory.coyoneda.obj (Opposite.op Z₁))) (S_g W g).arrows :=
      fun W g Z u hu => (ev₁ _).symm ((F.obj.map (hT_VZ.from Z).op) (φ hu.choose))
    have hy_val : ∀ {W Z : V_Z.Etale} (g : LocallyConstant ↥W.left ↥M)
        (u : Z ⟶ W) (hu : (S_g W g).arrows u) (m : ↥M),
        (∀ z : ↥Z.left, g (u.left.base z) = m) →
        y_fam W g u hu = (ev₁ _).symm ((F.obj.map (hT_VZ.from Z).op) (φ m)) := by
      intro W Z g u hu m hm
      by_cases hne : Nonempty ↥Z.left
      · rcases hne with ⟨z₀⟩
        have hm_eq : hu.choose = m := (hu.choose_spec z₀).symm.trans (hm z₀)
        dsimp [y_fam]
        rw [hm_eq]
      · have : IsEmpty ↥Z.left := not_nonempty_iff.mp hne
        exact hEmptyHomEq F (y_fam W g u hu) ((ev₁ _).symm ((F.obj.map (hT_VZ.from Z).op) (φ m)))
    have hy_compat : ∀ (W : V_Z.Etale) (g : LocallyConstant ↥W.left ↥M),
        (y_fam W g).Compatible := by
      intro W g
      rw [CategoryTheory.Presieve.compatible_iff_sieveCompatible]
      intro Z Z' u f hu
      have hm' : ∀ z' : ↥Z'.left, g ((f ≫ u).left.base z') = hu.choose :=
        fun z' => hu.choose_spec (f.left.base z')
      rw [hy_val g (f ≫ u) _ hu.choose hm']
      show ((ev₁ _).symm ((F.obj.map (hT_VZ.from Z').op) (φ hu.choose)) :
          Z₁ ⟶ F.obj.obj (Opposite.op Z')) =
        (ev₁ _).symm ((F.obj.map (hT_VZ.from Z).op) (φ hu.choose)) ≫ F.obj.map f.op
      ext ⟨n⟩
      change n • (F.obj.map (hT_VZ.from Z').op) (φ hu.choose) =
        (F.obj.map f.op) (n • (F.obj.map (hT_VZ.from Z).op) (φ hu.choose))
      rw [map_zsmul (F.obj.map f.op).hom]
      congr 1
      have h_from : f ≫ hT_VZ.from Z = hT_VZ.from Z' := hT_VZ.hom_ext _ _
      rw [← h_from, op_comp, F.obj.map_comp]
      rfl
    let Ψ_val : ∀ (W : V_Z.Etale),
        LocallyConstant ↥W.left ↥M → ↥(F.obj.obj (Opposite.op W)) :=
      fun W g => ev₁ _ ((F.property Z₁ (S_g W g) (hS_g W g)).amalgamate
        (y_fam W g) (hy_compat W g))
    have hΨ_spec : ∀ {W Z : V_Z.Etale} (g : LocallyConstant ↥W.left ↥M)
        (u : Z ⟶ W) (m : ↥M),
        (∀ z : ↥Z.left, g (u.left.base z) = m) →
        (F.obj.map u.op) (Ψ_val W g) = (F.obj.map (hT_VZ.from Z).op) (φ m) := by
      intro W Z g u m hm
      have hu : (S_g W g).arrows u := ⟨m, hm⟩
      have hglue := (F.property Z₁ (S_g W g) (hS_g W g)).valid_glue
        (hy_compat W g) u hu
      have hev := congrArg (ev₁ _) hglue
      rw [hy_val g u hu m hm, (ev₁ _).apply_symm_apply] at hev
      exact hev
    let Ψ_hom : L_lc M ⟶ F :=
      { hom :=
          { app := fun W => AddCommGrpCat.ofHom
              { toFun := Ψ_val W.unop
                map_zero' := by
                  have h0 := hΨ_spec (W := W.unop) 0 (𝟙 W.unop) 0 (fun _ => rfl)
                  rw [op_id, F.obj.map_id, map_zero, map_zero] at h0
                  exact h0
                map_add' := fun g₁ g₂ => by
                  refine hSepElem F (S_g W.unop g₁ ⊓ S_g W.unop g₂)
                    (J_V.intersection_covering (hS_g W.unop g₁) (hS_g W.unop g₂)) _ _ ?_
                  rintro Z u ⟨⟨m₁, hm₁⟩, ⟨m₂, hm₂⟩⟩
                  have hm12 : ∀ z : ↥Z.left, (g₁ + g₂) (u.left.base z) = m₁ + m₂ := by
                    intro z
                    change g₁ (u.left.base z) + g₂ (u.left.base z) = m₁ + m₂
                    rw [hm₁ z, hm₂ z]
                  calc
                    (F.obj.map u.op) (Ψ_val W.unop (g₁ + g₂))
                        = (F.obj.map (hT_VZ.from Z).op) (φ (m₁ + m₂)) :=
                      hΨ_spec (g₁ + g₂) u (m₁ + m₂) hm12
                    _ = (F.obj.map (hT_VZ.from Z).op) (φ m₁) +
                          (F.obj.map (hT_VZ.from Z).op) (φ m₂) := by
                      rw [map_add, map_add]
                    _ = (F.obj.map u.op) (Ψ_val W.unop g₁) +
                          (F.obj.map u.op) (Ψ_val W.unop g₂) := by
                      rw [hΨ_spec g₁ u m₁ hm₁, hΨ_spec g₂ u m₂ hm₂]
                    _ = (F.obj.map u.op) (Ψ_val W.unop g₁ + Ψ_val W.unop g₂) :=
                      (map_add (F.obj.map u.op).hom _ _).symm }
            naturality := by
              intro W₁ W₂ f
              ext g
              change Ψ_val W₂.unop ((P_lc M).map f g) =
                (F.obj.map f) (Ψ_val W₁.unop g)
              let gf : LocallyConstant ↥W₂.unop.left ↥M := (P_lc M).map f g
              refine hSepElem F (S_g W₂.unop gf) (hS_g W₂.unop gf) _ _ ?_
              rintro Z u ⟨m, hm⟩
              have huf : ∀ z : ↥Z.left, g ((u ≫ f.unop).left.base z) = m :=
                fun z => hm z
              calc
                (F.obj.map u.op) (Ψ_val W₂.unop gf)
                    = (F.obj.map (hT_VZ.from Z).op) (φ m) :=
                  hΨ_spec gf u m hm
                _ = (F.obj.map (u ≫ f.unop).op) (Ψ_val W₁.unop g) :=
                  (hΨ_spec g (u ≫ f.unop) m huf).symm
                _ = (F.obj.map u.op) ((F.obj.map f) (Ψ_val W₁.unop g)) := by
                  have hf_op : f = f.unop.op := rfl
                  rw [op_comp, F.obj.map_comp, ← hf_op]
                  rfl } }
    refine ⟨Ψ_hom, ?_, ?_⟩
    · intro m
      have hc := hΨ_spec (LocallyConstant.const ↥V_Z m) (𝟙 T_VZ) m (fun _ => rfl)
      have hfrom_id : hT_VZ.from T_VZ = 𝟙 T_VZ := hT_VZ.hom_ext _ _
      rw [hfrom_id, op_id, F.obj.map_id] at hc
      exact hc
    · intro ξ hξ
      ext W g
      refine hSepElem F (S_g W.unop g) (hS_g W.unop g) _ _ ?_
      rintro Z u ⟨m, hm⟩
      let c_m : ↥((L_lc M).obj.obj (Opposite.op T_VZ)) := LocallyConstant.const ↥V_Z m
      have h_lc_eq : ((L_lc M).obj.map u.op) g =
          ((L_lc M).obj.map (hT_VZ.from Z).op) c_m := by
        ext z
        exact hm z
      calc
        (F.obj.map u.op) (ξ.hom.app W g)
            = (ξ.hom.app W ≫ F.obj.map u.op) g := rfl
        _ = ((L_lc M).obj.map u.op ≫ ξ.hom.app (Opposite.op Z)) g := by
          rw [ξ.hom.naturality u.op]
        _ = ξ.hom.app (Opposite.op Z) (((L_lc M).obj.map u.op) g) := rfl
        _ = ξ.hom.app (Opposite.op Z) (((L_lc M).obj.map (hT_VZ.from Z).op) c_m) := by
          rw [h_lc_eq]
        _ = ((L_lc M).obj.map (hT_VZ.from Z).op ≫ ξ.hom.app (Opposite.op Z)) c_m := rfl
        _ = (ξ.hom.app (Opposite.op T_VZ) ≫ F.obj.map (hT_VZ.from Z).op) c_m := by
          rw [← ξ.hom.naturality (hT_VZ.from Z).op]
        _ = (F.obj.map (hT_VZ.from Z).op) (ξ.hom.app (Opposite.op T_VZ) c_m) := rfl
        _ = (F.obj.map (hT_VZ.from Z).op) (φ m) := by
          rw [hξ m]
        _ = (F.obj.map u.op) (Ψ_hom.hom.app W g) :=
          (hΨ_spec g u m hm).symm
  
  obtain ⟨s₀⟩ : Nonempty ↥V_Z := inferInstance
  have hUnitInv : ∀ (M : AddCommGrpCat.{u}),
      ∃ (η_inv : (C_V.obj M).obj.obj (Opposite.op T_VZ) ⟶ M),
        adj_V.unit.app M ≫ η_inv = 𝟙 M ∧
        η_inv ≫ adj_V.unit.app M = 𝟙 _ := by
    intro M
    let constHom : M ⟶ (L_lc M).obj.obj (Opposite.op T_VZ) := AddCommGrpCat.ofHom
      { toFun := fun m => LocallyConstant.const ↥V_Z m
        map_zero' := by ext; rfl
        map_add' := fun _ _ => by ext; rfl }
    let evalHom : (L_lc M).obj.obj (Opposite.op T_VZ) ⟶ M := AddCommGrpCat.ofHom
      { toFun := fun g => g s₀
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    have h_ce : constHom ≫ evalHom = 𝟙 M := by ext; rfl
    have h_ec : evalHom ≫ constHom = 𝟙 _ := by
      ext g x
      let g_VZ : LocallyConstant ↥V_Z ↥M := g
      exact (g_VZ.apply_eq_of_preconnectedSpace x s₀).symm
    let η_M := adj_V.unit.app M
    let p_M : C_V.obj M ⟶ L_lc M := (adj_V.homEquiv M (L_lc M)).symm constHom
    have hp_unit : η_M ≫ p_M.hom.app (Opposite.op T_VZ) = constHom := by
      simpa [adj_V.homEquiv_unit] using (adj_V.homEquiv M (L_lc M)).apply_symm_apply constHom
    obtain ⟨q_M, hq_const, _⟩ := hExtUniv M (C_V.obj M) η_M
    have hq_unit : constHom ≫ q_M.hom.app (Opposite.op T_VZ) = η_M := by
      ext m
      exact hq_const m
    have hpq : p_M ≫ q_M = 𝟙 (C_V.obj M) := by
      apply (adj_V.homEquiv M (C_V.obj M)).injective
      rw [adj_V.homEquiv_unit, adj_V.homEquiv_unit]
      change η_M ≫ (p_M.hom.app (Opposite.op T_VZ) ≫ q_M.hom.app (Opposite.op T_VZ)) =
        η_M ≫ 𝟙 _
      rw [← CategoryTheory.Category.assoc, hp_unit, hq_unit, CategoryTheory.Category.comp_id]
    refine ⟨p_M.hom.app (Opposite.op T_VZ) ≫ evalHom, ?_, ?_⟩
    · rw [← CategoryTheory.Category.assoc, hp_unit, h_ce]
    · calc
        (p_M.hom.app (Opposite.op T_VZ) ≫ evalHom) ≫ η_M
            = p_M.hom.app (Opposite.op T_VZ) ≫ (evalHom ≫ constHom) ≫
                q_M.hom.app (Opposite.op T_VZ) := by
              rw [← hq_unit, CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]
        _ = (p_M ≫ q_M).hom.app (Opposite.op T_VZ) := by
              rw [h_ec, CategoryTheory.Category.id_comp]
              rfl
        _ = 𝟙 _ := by rw [hpq]; rfl
  
  let A₁ := AddCommGrpCat.of (Fin N₁ → A_ℓ)
  let A₂ := AddCommGrpCat.of (Fin N₂ → A_ℓ)
  obtain ⟨e_pb_V⟩ := hPullFree V
  obtain ⟨e_pb_U⟩ := hPullFree U
  obtain ⟨e_sh_V⟩ := hSheetIso (B_g.obj V) N₁ hSplit_V
  obtain ⟨e_sh_U⟩ := hSheetIso (B_g.obj U) N₂ hSplit_U
  let e_V : pb_g.obj (CategoryTheory.Sheaf.freeYoneda J_Y V A_ℓ) ≅ C_V.obj A₁ :=
    e_pb_V ≪≫ e_sh_V
  let e_U : pb_g.obj (CategoryTheory.Sheaf.freeYoneda J_Y U A_ℓ) ≅ C_V.obj A₂ :=
    e_pb_U ≪≫ e_sh_U
  let ψ : C_V.obj A₁ ⟶ C_V.obj A₂ := e_V.inv ≫ pb_g.map θ ≫ e_U.hom
  obtain ⟨η₂_inv, _, hη₂_right⟩ := hUnitInv A₂
  let α : A₁ ⟶ A₂ := adj_V.unit.app A₁ ≫ ψ.hom.app (Opposite.op T_VZ) ≫ η₂_inv
  have hα : C_V.map α = ψ := by
    apply (adj_V.homEquiv A₁ (C_V.obj A₂)).injective
    rw [adj_V.homEquiv_unit, adj_V.homEquiv_unit]
    change adj_V.unit.app A₁ ≫ (C_V.map α).hom.app (Opposite.op T_VZ) =
      adj_V.unit.app A₁ ≫ ψ.hom.app (Opposite.op T_VZ)
    have hnat : α ≫ adj_V.unit.app A₂ =
        adj_V.unit.app A₁ ≫ (C_V.map α).hom.app (Opposite.op T_VZ) :=
      adj_V.unit.naturality α
    rw [← hnat]
    dsimp [α]
    rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hη₂_right,
      CategoryTheory.Category.comp_id]
  let A : AddCommGrpCat.{u} := CategoryTheory.Limits.cokernel α
  let _ : C_V.IsLeftAdjoint := adj_V.isLeftAdjoint
  have hComm : pb_g.map θ ≫ e_U.hom = e_V.hom ≫ C_V.map α := by
    rw [hα]
    dsimp [ψ]
    rw [← CategoryTheory.Category.assoc, e_V.hom_inv_id, CategoryTheory.Category.id_comp]
  let e_tot : pb_g.obj (CategoryTheory.Limits.cokernel θ) ≅ C_V.obj A :=
    CategoryTheory.Limits.PreservesCokernel.iso pb_g θ ≪≫
      CategoryTheory.Limits.cokernel.mapIso (pb_g.map θ) (C_V.map α) e_V e_U hComm ≪≫
      (CategoryTheory.Limits.PreservesCokernel.iso C_V α).symm
  have hFinA : Finite A := by
    let _ : Finite A_ℓ := inferInstanceAs (Finite (ULift.{u, 0} (ZMod ℓ)))
    let _ : Finite A₂ := inferInstanceAs (Finite (Fin N₂ → A_ℓ))
    exact @Finite.of_surjective _ _ ‹Finite A₂› _
      ((AddCommGrpCat.epi_iff_surjective (CategoryTheory.Limits.cokernel.π α)).mp inferInstance)
  have hTor₂ : ℓ • CategoryTheory.CategoryStruct.id A₂ = 0 := by
    apply AddCommGrpCat.ext
    intro v
    funext j
    apply ULift.ext
    change ℓ • (v j).down = 0
    rw [nsmul_eq_mul, CharP.cast_eq_zero, zero_mul]
  have hTorA : ℓ • CategoryTheory.CategoryStruct.id A = 0 := by
    apply (CategoryTheory.cancel_epi (CategoryTheory.Limits.cokernel.π α)).mp
    rw [CategoryTheory.Preadditive.comp_nsmul, CategoryTheory.Category.comp_id,
      CategoryTheory.Limits.comp_zero,
      ← CategoryTheory.Category.id_comp (CategoryTheory.Limits.cokernel.π α),
      ← CategoryTheory.Preadditive.nsmul_comp, hTor₂, CategoryTheory.Limits.zero_comp]
  exact ⟨A, hFinA, hTorA, hc_g, hr_g, ⟨e_tot⟩⟩

theorem weil_etale_constructible_of_affine_freeYoneda_cokernel (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hSite : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (g : X₁ ⟶ X₂),
      letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) g :=
        CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
      letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) g :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
          (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
      let B_g : CategoryTheory.Functor X₂.Etale X₁.Etale :=
        CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ g
      ∃ (_ : B_g.IsContinuous X₂.smallEtaleTopology X₁.smallEtaleTopology)
        (_ : (B_g.sheafPushforwardContinuous AddCommGrpCat.{u}
          X₂.smallEtaleTopology X₁.smallEtaleTopology).IsRightAdjoint),
        let pb_g := B_g.sheafPullback AddCommGrpCat.{u} X₂.smallEtaleTopology X₁.smallEtaleTopology
        pb_g.Additive ∧
        CategoryTheory.Limits.PreservesFiniteLimits pb_g ∧
        CategoryTheory.Limits.PreservesFiniteColimits pb_g)
    {Y S₀ : AlgebraicGeometry.Scheme.{u}} (f_Y : Y ⟶ S₀)
    [AlgebraicGeometry.IsAffine S₀] [AlgebraicGeometry.IsSeparated f_Y]
    (hCov_Y : ∃ (W₀ W₁ : Y.Opens),
      W₀ ⊔ W₁ = ⊤ ∧
      AlgebraicGeometry.IsAffineOpen W₀ ∧
      AlgebraicGeometry.IsAffineOpen W₁ ∧
      AlgebraicGeometry.IsAffineOpen (W₀ ⊓ W₁))
    (V U : Y.Etale)
    [AlgebraicGeometry.IsAffine ((AlgebraicGeometry.Scheme.Etale.forget Y).obj V).left]
    [AlgebraicGeometry.IsAffine ((AlgebraicGeometry.Scheme.Etale.forget Y).obj U).left]
    (θ : CategoryTheory.Sheaf.freeYoneda Y.smallEtaleTopology V
        (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))) ⟶
      CategoryTheory.Sheaf.freeYoneda Y.smallEtaleTopology U
        (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ)))) :
    WeilIsConstructibleModPrimeSheaf ℓ Y (CategoryTheory.Limits.cokernel θ) :=
by
  classical
  let specRingEquivIso : ∀ {R₁ R₂ : Type u} [CommRing R₁] [CommRing R₂] (_ : R₁ ≃+* R₂),
      AlgebraicGeometry.Spec (CommRingCat.of R₁) ≅ AlgebraicGeometry.Spec (CommRingCat.of R₂) :=
    fun e =>
      { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e.symm.toRingHom)
        inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e.toRingHom)
        hom_inv_id := by
          rw [← AlgebraicGeometry.Spec.map_comp]
          have h : CommRingCat.ofHom e.toRingHom ≫ CommRingCat.ofHom e.symm.toRingHom =
              CategoryTheory.CategoryStruct.id _ := by
            ext x; exact e.symm_apply_apply x
          rw [h, AlgebraicGeometry.Spec.map_id]
        inv_hom_id := by
          rw [← AlgebraicGeometry.Spec.map_comp]
          have h : CommRingCat.ofHom e.symm.toRingHom ≫ CommRingCat.ofHom e.toRingHom =
              CategoryTheory.CategoryStruct.id _ := by
            ext x; exact e.apply_symm_apply x
          rw [h, AlgebraicGeometry.Spec.map_id] }
  let A_ℓ := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))
  have hTor_Aℓ : ℓ • CategoryTheory.CategoryStruct.id A_ℓ = 0 := by
    ext ⟨x⟩
    apply ULift.ext
    change ℓ • x = 0
    rw [nsmul_eq_mul, CharP.cast_eq_zero, zero_mul]
  let P_U := CategoryTheory.Presheaf.freeYoneda U A_ℓ
  have hTor_PU : ℓ • CategoryTheory.CategoryStruct.id P_U = 0 := by
    ext W : 2
    change ℓ • CategoryTheory.CategoryStruct.id (∐ fun _ : W.unop ⟶ U => A_ℓ) = 0
    apply CategoryTheory.Limits.Sigma.hom_ext
    intro w
    rw [CategoryTheory.Preadditive.comp_nsmul, CategoryTheory.Category.comp_id,
      CategoryTheory.Limits.comp_zero,
      ← CategoryTheory.Category.id_comp (CategoryTheory.Limits.Sigma.ι _ w),
      ← CategoryTheory.Preadditive.nsmul_comp, hTor_Aℓ, CategoryTheory.Limits.zero_comp]
  let L_U := CategoryTheory.Sheaf.freeYoneda Y.smallEtaleTopology U A_ℓ
  have hTor_LU : ℓ • CategoryTheory.CategoryStruct.id L_U = 0 := by
    let F_sh := CategoryTheory.presheafToSheaf Y.smallEtaleTopology AddCommGrpCat.{u}
    change ℓ • CategoryTheory.CategoryStruct.id (F_sh.obj P_U) = 0
    rw [← F_sh.map_id, ← F_sh.map_nsmul, hTor_PU, F_sh.map_zero]
  have hTor_cok : ℓ • CategoryTheory.CategoryStruct.id (CategoryTheory.Limits.cokernel θ) = 0 := by
    apply (CategoryTheory.cancel_epi (CategoryTheory.Limits.cokernel.π θ)).mp
    rw [CategoryTheory.Preadditive.comp_nsmul, CategoryTheory.Category.comp_id,
      CategoryTheory.Limits.comp_zero,
      ← CategoryTheory.Category.id_comp (CategoryTheory.Limits.cokernel.π θ),
      ← CategoryTheory.Preadditive.nsmul_comp, hTor_LU, CategoryTheory.Limits.zero_comp]
  refine ⟨hTor_cok, ?_⟩
  intro Z iZ hCl hInt
  have : AlgebraicGeometry.IsClosedImmersion iZ := hCl
  have : AlgebraicGeometry.IsIntegral Z := hInt
  obtain ⟨W₀, W₁, hW_top, hAff_W₀, hAff_W₁, _⟩ := hCov_Y
  obtain ⟨z₀⟩ : Nonempty ↥Z := inferInstance
  have hz_top : iZ.base z₀ ∈ (W₀ ⊔ W₁ : Y.Opens) := by
    rw [hW_top]; trivial
  obtain ⟨W_ε, hz_ε, hAff_Wε⟩ :
      ∃ W_ε : Y.Opens, iZ.base z₀ ∈ W_ε ∧ AlgebraicGeometry.IsAffineOpen W_ε := by
    rcases hz_top with h0 | h1
    · exact ⟨W₀, h0, hAff_W₀⟩
    · exact ⟨W₁, h1, hAff_W₁⟩
  let U₀ : Z.Opens := (TopologicalSpace.Opens.map iZ.base).obj W_ε
  have hNe_U₀_sch : Nonempty ↥(U₀ : AlgebraicGeometry.Scheme.{u}) := ⟨⟨z₀, hz_ε⟩⟩
  have hAff_U₀ : AlgebraicGeometry.IsAffineOpen U₀ := hAff_Wε.preimage iZ
  let R₀_cat : CommRingCat.{u} := Z.presheaf.obj (Opposite.op U₀)
  let D₀ : Type u := ↑R₀_cat
  have : IsDomain D₀ := @AlgebraicGeometry.IsIntegral.component_integral Z hInt U₀ hNe_U₀_sch
  let u₀ : AlgebraicGeometry.Spec R₀_cat ⟶ Y := hAff_U₀.fromSpec ≫ iZ
  have hPullEtale : ∀ (E : Y.Etale)
      [AlgebraicGeometry.IsAffine ((AlgebraicGeometry.Scheme.Etale.forget Y).obj E).left],
      ∃ (R_E : Type u) (_ : CommRing R_E) (_ : Algebra D₀ R_E) (_ : Algebra.Etale D₀ R_E)
        (e_E : AlgebraicGeometry.Spec (CommRingCat.of R_E) ≅
          CategoryTheory.Limits.pullback E.hom u₀),
        e_E.hom ≫ CategoryTheory.Limits.pullback.snd E.hom u₀ =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D₀ R_E)) := by
    intro E hAff_E
    let X_E : AlgebraicGeometry.Scheme.{u} := E.left
    let p_E : X_E ⟶ Y := E.hom
    have : AlgebraicGeometry.IsAffine X_E := hAff_E
    have hEt_pE : AlgebraicGeometry.Etale p_E := E.prop
    have : AlgebraicGeometry.IsAffineHom (p_E ≫ f_Y) :=
      AlgebraicGeometry.isAffineHom_of_isAffine (p_E ≫ f_Y)
    have hAffHom_pE : AlgebraicGeometry.IsAffineHom p_E :=
      AlgebraicGeometry.IsAffineHom.of_comp p_E f_Y
    let P_E := CategoryTheory.Limits.pullback p_E u₀
    let q_E : P_E ⟶ AlgebraicGeometry.Spec R₀_cat :=
      CategoryTheory.Limits.pullback.snd p_E u₀
    have hpb_E : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst p_E u₀) q_E p_E u₀ :=
      CategoryTheory.IsPullback.of_hasPullback p_E u₀
    have : AlgebraicGeometry.IsAffineHom q_E :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_E hAffHom_pE
    have : AlgebraicGeometry.Etale q_E :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_E hEt_pE
    have : AlgebraicGeometry.IsAffine P_E := AlgebraicGeometry.isAffine_of_isAffineHom q_E
    let R_E : Type u := ↑(P_E.presheaf.obj (Opposite.op ⊤))
    let φ_E : R₀_cat ⟶ P_E.presheaf.obj (Opposite.op ⊤) :=
      AlgebraicGeometry.Spec.preimage (P_E.isoSpec.inv ≫ q_E)
    let _ : Algebra D₀ R_E := φ_E.hom.toAlgebra
    have hIso_qE : P_E.isoSpec.inv ≫ q_E = AlgebraicGeometry.Spec.map φ_E :=
      (AlgebraicGeometry.Spec.map_preimage (P_E.isoSpec.inv ≫ q_E)).symm
    have hEt_Spec : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map φ_E) := by
      rw [← hIso_qE]
      infer_instance
    have hEt_hom : φ_E.hom.Etale :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hEt_Spec
    have hEt_alg : Algebra.Etale D₀ R_E := RingHom.etale_algebraMap.mp hEt_hom
    have hφ_eq : φ_E = CommRingCat.ofHom (algebraMap D₀ R_E) := by
      ext x; rfl
    exact ⟨R_E, inferInstance, φ_E.hom.toAlgebra, hEt_alg, P_E.isoSpec.symm, hφ_eq ▸ hIso_qE⟩
  obtain ⟨E₁, hRing₁, hAlg₁, hEt₁, e_PV, he_PV⟩ := hPullEtale V
  obtain ⟨E₂, hRing₂, hAlg₂, hEt₂, e_PU, he_PU⟩ := hPullEtale U
  let _ : CommRing E₁ := hRing₁
  let _ : Algebra D₀ E₁ := hAlg₁
  have : Algebra.Etale D₀ E₁ := hEt₁
  let _ : CommRing E₂ := hRing₂
  let _ : Algebra D₀ E₂ := hAlg₂
  have : Algebra.Etale D₀ E₂ := hEt₂
  obtain ⟨f, hf_ne, B, hRingB, hDomB, hAlgRfB, hFinB, hEtB, hInjB, N₁, N₂, hTriv⟩ :=
    weil_ring_domain_etale_pair_pi_trivialization D₀ E₁ E₂
  let _ : CommRing B := hRingB
  have : IsDomain B := hDomB
  let _ : Algebra (Localization.Away f) B := hAlgRfB
  have : Module.Finite (Localization.Away f) B := hFinB
  have : Algebra.Etale (Localization.Away f) B := hEtB
  let _ : Algebra D₀ B :=
    RingHom.toAlgebra ((algebraMap (Localization.Away f) B).comp
      (algebraMap D₀ (Localization.Away f)))
  obtain ⟨⟨Φ₁⟩, ⟨Φ₂⟩⟩ := hTriv
  let U_Z : Z.Opens := Z.basicOpen f
  have hAff_UZ : AlgebraicGeometry.IsAffineOpen U_Z := hAff_U₀.basicOpen f
  have hNe_UZ : Nonempty U_Z := by
    have hbot : (⊥ : PrimeSpectrum D₀) ∈ PrimeSpectrum.basicOpen f := by
      rw [PrimeSpectrum.mem_basicOpen]
      intro hmem
      exact hf_ne hmem
    have hpre : (⊥ : PrimeSpectrum D₀) ∈
        (TopologicalSpace.Opens.map hAff_U₀.fromSpec.base).obj U_Z := by
      dsimp [U_Z]
      rwa [hAff_U₀.fromSpec_preimage_basicOpen f]
    exact ⟨⟨hAff_U₀.fromSpec.base (⊥ : PrimeSpectrum D₀), hpre⟩⟩
  let R_UZ_cat : CommRingCat.{u} := Z.presheaf.obj (Opposite.op U_Z)
  let res_UZ : R₀_cat ⟶ R_UZ_cat :=
    Z.presheaf.map (CategoryTheory.homOfLE (Z.basicOpen_le f)).op
  let _ : Algebra D₀ ↑R_UZ_cat := res_UZ.hom.toAlgebra
  have : IsLocalization.Away f ↑R_UZ_cat := hAff_U₀.isLocalization_basicOpen f
  let e_loc : ↑R_UZ_cat ≃ₐ[D₀] Localization.Away f :=
    IsLocalization.algEquiv (Submonoid.powers f) (↑R_UZ_cat) (Localization.Away f)
  let e_UZ : (U_Z : AlgebraicGeometry.Scheme.{u}) ≅
      AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away f)) :=
    hAff_UZ.isoSpec ≪≫ specRingEquivIso e_loc.toRingEquiv
  have he_UZ_ι : e_UZ.inv ≫ U_Z.ι =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D₀ (Localization.Away f))) ≫
        hAff_U₀.fromSpec := by
    calc
      e_UZ.inv ≫ U_Z.ι
          = AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_loc.toRingHom) ≫
              (hAff_UZ.isoSpec.inv ≫ U_Z.ι) := by
            dsimp [e_UZ, specRingEquivIso]
            rw [CategoryTheory.Category.assoc]
            rfl
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_loc.toRingHom) ≫ hAff_UZ.fromSpec := by
            rw [hAff_UZ.isoSpec_inv_ι]
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_loc.toRingHom) ≫
            AlgebraicGeometry.Spec.map res_UZ ≫ hAff_U₀.fromSpec := by
            rw [← hAff_U₀.map_fromSpec hAff_UZ (CategoryTheory.homOfLE (Z.basicOpen_le f)).op]
      _ = AlgebraicGeometry.Spec.map (res_UZ ≫ CommRingCat.ofHom e_loc.toRingHom) ≫
            hAff_U₀.fromSpec := by
            rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D₀ (Localization.Away f))) ≫
            hAff_U₀.fromSpec := by
            have hcomp2 : res_UZ ≫ CommRingCat.ofHom e_loc.toRingHom =
                CommRingCat.ofHom (algebraMap D₀ (Localization.Away f)) := by
              ext x
              exact e_loc.commutes x
            rw [hcomp2]
  let V_Z : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of B)
  have hInt_VZ : AlgebraicGeometry.IsIntegral V_Z :=
    (AlgebraicGeometry.affine_isIntegral_iff (CommRingCat.of B)).mpr hDomB
  let p₀ : V_Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away f)) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Localization.Away f) B))
  let p : V_Z ⟶ (U_Z : AlgebraicGeometry.Scheme.{u}) := p₀ ≫ e_UZ.inv
  have hFin_p₀ : AlgebraicGeometry.IsFinite p₀ :=
    (AlgebraicGeometry.IsFinite.SpecMap_iff _).mpr (RingHom.finite_algebraMap.mpr hFinB)
  have hFin_p : AlgebraicGeometry.IsFinite p := by
    dsimp [p]; infer_instance
  have hEt_p₀ : AlgebraicGeometry.Etale p₀ :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
      (RingHom.etale_algebraMap.mpr hEtB)
  have hEt_p : AlgebraicGeometry.Etale p := by
    dsimp [p]; infer_instance
  have hSurj_p₀ : AlgebraicGeometry.Surjective p₀ := by
    have : Algebra.IsIntegral (Localization.Away f) B :=
      Algebra.IsIntegral.of_finite (Localization.Away f) B
    have hIntHom : (algebraMap (Localization.Away f) B).IsIntegral :=
      Algebra.isIntegral_def.mp ‹_›
    refine AlgebraicGeometry.Surjective.mk ?_
    rw [AlgebraicGeometry.Spec.map_base]
    exact RingHom.IsIntegral.comap_surjective hIntHom hInjB
  have hSurj_p : AlgebraicGeometry.Surjective p := by
    dsimp [p]; infer_instance
  let g_Z : V_Z ⟶ Y :=
    CategoryTheory.CategoryStruct.comp p (CategoryTheory.CategoryStruct.comp U_Z.ι iZ)
  let β_B : V_Z ⟶ AlgebraicGeometry.Spec R₀_cat :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D₀ B))
  have hg_Z_eq : g_Z = β_B ≫ u₀ := by
    dsimp [g_Z, p, u₀, β_B, p₀]
    calc
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Localization.Away f) B)) ≫
          e_UZ.inv) ≫ U_Z.ι ≫ iZ
          = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Localization.Away f) B)) ≫
              (e_UZ.inv ≫ U_Z.ι) ≫ iZ := by simp only [CategoryTheory.Category.assoc]
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Localization.Away f) B)) ≫
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D₀ (Localization.Away f))) ≫
              hAff_U₀.fromSpec) ≫ iZ := by rw [he_UZ_ι]
      _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Localization.Away f) B)) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D₀ (Localization.Away f)))) ≫
            (hAff_U₀.fromSpec ≫ iZ) := by simp only [CategoryTheory.Category.assoc]
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D₀ B)) ≫
            (hAff_U₀.fromSpec ≫ iZ) := by
            rw [← AlgebraicGeometry.Spec.map_comp]
            rfl
  let _ : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) g_Z :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  let _ : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) g_Z :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let B_g : CategoryTheory.Functor Y.Etale V_Z.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ g_Z
  let T_VZ : V_Z.Etale := AlgebraicGeometry.Scheme.Etale.mk (CategoryTheory.CategoryStruct.id V_Z)
  have hMakeSheets : ∀ (E : Y.Etale) (R_E : Type u) [CommRing R_E] [Algebra D₀ R_E]
      (e_PE : AlgebraicGeometry.Spec (CommRingCat.of R_E) ≅
        CategoryTheory.Limits.pullback E.hom u₀)
      (_ : e_PE.hom ≫ CategoryTheory.Limits.pullback.snd E.hom u₀ =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D₀ R_E)))
      (N : ℕ) (Φ : TensorProduct D₀ B R_E ≃ₐ[B] (Fin N → B)),
      ∃ (σ : Fin N → (T_VZ ⟶ B_g.obj E)),
        (∀ j : Fin N,
          AlgebraicGeometry.IsOpenImmersion ((AlgebraicGeometry.Scheme.Etale.forget V_Z).map (σ j)).left) ∧
        (∀ i j : Fin N, i ≠ j →
          Disjoint
            (Set.range (((AlgebraicGeometry.Scheme.Etale.forget V_Z).map (σ i)).left).base)
            (Set.range (((AlgebraicGeometry.Scheme.Etale.forget V_Z).map (σ j)).left).base)) ∧
        (⋃ j : Fin N,
          Set.range (((AlgebraicGeometry.Scheme.Etale.forget V_Z).map (σ j)).left).base) = Set.univ := by
    intro E R_E _ _ e_PE he_PE N Φ
    let f_RE : AlgebraicGeometry.Spec (CommRingCat.of R_E) ⟶ AlgebraicGeometry.Spec R₀_cat :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D₀ R_E))
    have hpb_spec₀ : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.snd β_B f_RE)
        (CategoryTheory.Limits.pullback.fst β_B f_RE)
        f_RE β_B :=
      (CategoryTheory.IsPullback.of_hasPullback β_B f_RE).flip
    let e_pi : AlgebraicGeometry.Spec (CommRingCat.of (Fin N → B)) ≅
        CategoryTheory.Limits.pullback β_B f_RE :=
      specRingEquivIso Φ.symm.toRingEquiv ≪≫
        (AlgebraicGeometry.pullbackSpecIso D₀ B R_E).symm
    have he_pi_fst : e_pi.hom ≫ CategoryTheory.Limits.pullback.fst β_B f_RE =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B (Fin N → B))) := by
      change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom Φ.toRingHom) ≫
          (AlgebraicGeometry.pullbackSpecIso D₀ B R_E).inv) ≫
          CategoryTheory.Limits.pullback.fst β_B f_RE = _
      rw [CategoryTheory.Category.assoc, AlgebraicGeometry.pullbackSpecIso_inv_fst,
        ← AlgebraicGeometry.Spec.map_comp]
      congr 1
      ext b k
      exact congrFun (Φ.commutes b) k
    have hpb_left : CategoryTheory.IsPullback
        (e_pi.hom ≫ CategoryTheory.Limits.pullback.snd β_B f_RE ≫ e_PE.hom)
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B (Fin N → B))))
        (CategoryTheory.Limits.pullback.snd E.hom u₀) β_B := by
      refine CategoryTheory.IsPullback.of_iso hpb_spec₀ e_pi.symm e_PE
        (CategoryTheory.Iso.refl V_Z) (CategoryTheory.Iso.refl _) ?_ ?_ ?_ ?_
      · simp only [CategoryTheory.Iso.symm_hom, CategoryTheory.Iso.inv_hom_id_assoc]
      · simp only [CategoryTheory.Iso.symm_hom, CategoryTheory.Iso.refl_hom,
          CategoryTheory.Category.comp_id]
        exact (CategoryTheory.Iso.eq_inv_comp e_pi).mpr he_pi_fst
      · simp only [CategoryTheory.Iso.refl_hom, CategoryTheory.Category.comp_id]
        exact he_PE.symm
      · simp only [CategoryTheory.Iso.refl_hom, CategoryTheory.Category.id_comp,
          CategoryTheory.Category.comp_id]
    have hpb_tot : CategoryTheory.IsPullback
        ((e_pi.hom ≫ CategoryTheory.Limits.pullback.snd β_B f_RE ≫ e_PE.hom) ≫
          CategoryTheory.Limits.pullback.fst E.hom u₀)
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B (Fin N → B))))
        E.hom g_Z := by
      rw [hg_Z_eq]
      exact hpb_left.paste_horiz (CategoryTheory.IsPullback.of_hasPullback E.hom u₀)
    let e_sheet : AlgebraicGeometry.Spec (CommRingCat.of (Fin N → B)) ≅
        CategoryTheory.Limits.pullback E.hom g_Z :=
      hpb_tot.isoPullback
    have he_sheet_snd : e_sheet.hom ≫ CategoryTheory.Limits.pullback.snd E.hom g_Z =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B (Fin N → B))) :=
      hpb_tot.isoPullback_hom_snd
    let π_eval : Fin N → ((Fin N → B) →+* B) := fun j => Pi.evalRingHom (fun _ : Fin N => B) j
    let s_mor : Fin N → (V_Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Fin N → B))) :=
      fun j => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (π_eval j))
    let idemp : Fin N → (Fin N → B) := fun j => Pi.single j (1 : B)
    have hs_open_and_range : ∀ j : Fin N,
        AlgebraicGeometry.IsOpenImmersion (s_mor j) ∧
        ∀ q : PrimeSpectrum (Fin N → B),
          (∃ x : V_Z, (s_mor j).base x = q) ↔ idemp j ∉ q.asIdeal := by
      intro j
      let _ : Algebra (Fin N → B) B := (π_eval j).toAlgebra
      have halg : ∀ x : Fin N → B, algebraMap (Fin N → B) B x = x j := fun _ => rfl
      have hLoc : IsLocalization.Away (idemp j) B :=
        { map_units := by
            rintro ⟨_, ⟨k, rfl⟩⟩
            change IsUnit ((idemp j ^ k) j)
            rw [Pi.pow_apply]
            simp [idemp, Pi.single_eq_same]
          surj := fun b => by
            refine ⟨(Pi.single j b, ⟨1, ⟨0, pow_zero _⟩⟩), ?_⟩
            simp [halg, Pi.single_eq_same]
          exists_of_eq := fun {x₁ x₂} hx => by
            rw [halg, halg] at hx
            refine ⟨⟨idemp j, ⟨1, pow_one _⟩⟩, ?_⟩
            ext k
            by_cases hkj : k = j
            · subst hkj
              simp [idemp, Pi.single_eq_same, hx]
            · simp [idemp, Pi.single_eq_of_ne hkj] }
      refine ⟨@AlgebraicGeometry.IsOpenImmersion.of_isLocalization (Fin N → B) B _ _
        (π_eval j).toAlgebra (idemp j) hLoc, ?_⟩
      have hRange : Set.range (PrimeSpectrum.comap (π_eval j)) =
          (PrimeSpectrum.basicOpen (idemp j) : Set (PrimeSpectrum (Fin N → B))) :=
        @PrimeSpectrum.localization_away_comap_range (Fin N → B) _ B _
          (π_eval j).toAlgebra (idemp j) hLoc
      intro q
      have hMem : (∃ x : V_Z, (s_mor j).base x = q) ↔
          q ∈ Set.range (PrimeSpectrum.comap (π_eval j)) := by
        change (∃ x : PrimeSpectrum B, ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom (π_eval j))).base) x = q) ↔ _
        rw [AlgebraicGeometry.Spec.map_base]
        rfl
      rw [hMem, hRange, SetLike.mem_coe, PrimeSpectrum.mem_basicOpen]
    let σ : Fin N → (T_VZ ⟶ B_g.obj E) := fun j =>
      CategoryTheory.MorphismProperty.Over.homMk (s_mor j ≫ e_sheet.hom) (by
        change (s_mor j ≫ e_sheet.hom) ≫ CategoryTheory.Limits.pullback.snd E.hom g_Z =
          CategoryTheory.CategoryStruct.id V_Z
        rw [CategoryTheory.Category.assoc, he_sheet_snd]
        dsimp [s_mor, V_Z]
        rw [← AlgebraicGeometry.Spec.map_comp]
        have hid : CommRingCat.ofHom (algebraMap B (Fin N → B)) ≫
            CommRingCat.ofHom (π_eval j) =
            CategoryTheory.CategoryStruct.id (CommRingCat.of B) := by
          ext b; rfl
        rw [hid, AlgebraicGeometry.Spec.map_id]) trivial
    refine ⟨σ, ?_, ?_, ?_⟩
    · intro j
      change AlgebraicGeometry.IsOpenImmersion (s_mor j ≫ e_sheet.hom)
      have : AlgebraicGeometry.IsOpenImmersion (s_mor j) := (hs_open_and_range j).1
      infer_instance
    · intro i j hij
      change Disjoint (Set.range (s_mor i ≫ e_sheet.hom).base)
        (Set.range (s_mor j ≫ e_sheet.hom).base)
      rw [Set.disjoint_iff]
      rintro y ⟨⟨x₁, rfl⟩, ⟨x₂, h_eq⟩⟩
      have hq_eq : (s_mor i).base x₁ = (s_mor j).base x₂ := by
        have h1 := congrArg e_sheet.inv.base h_eq
        have h_inv : ∀ q, e_sheet.inv.base (e_sheet.hom.base q) = q := fun q => by
          change (e_sheet.hom ≫ e_sheet.inv).base q = q
          rw [e_sheet.hom_inv_id]; rfl
        change e_sheet.inv.base (e_sheet.hom.base ((s_mor j).base x₂)) =
          e_sheet.inv.base (e_sheet.hom.base ((s_mor i).base x₁)) at h1
        rw [h_inv, h_inv] at h1
        exact h1.symm
      let q : PrimeSpectrum (Fin N → B) := (s_mor i).base x₁
      have hqi : idemp i ∉ q.asIdeal := ((hs_open_and_range i).2 q).mp ⟨x₁, rfl⟩
      have hqj : idemp j ∉ q.asIdeal := ((hs_open_and_range j).2 q).mp ⟨x₂, hq_eq.symm⟩
      have hmul_zero : idemp i * idemp j = 0 := by
        ext k
        by_cases hki : k = i
        · subst hki
          simp [idemp, Pi.single_eq_of_ne hij]
        · simp [idemp, Pi.single_eq_of_ne hki]
      have hmem0 : idemp i * idemp j ∈ q.asIdeal := by
        rw [hmul_zero]; exact q.asIdeal.zero_mem
      rcases q.isPrime.mem_or_mem hmem0 with hi | hj
      · exact hqi hi
      · exact hqj hj
    · ext y
      simp only [Set.mem_iUnion, Set.mem_range, Set.mem_univ, iff_true]
      let q : PrimeSpectrum (Fin N → B) := e_sheet.inv.base y
      have hsum_one : (∑ j : Fin N, idemp j) = 1 := by
        ext k
        rw [Finset.sum_apply]
        simp [idemp, Pi.single_apply]
      have hnot_all : ¬ ∀ j : Fin N, idemp j ∈ q.asIdeal := by
        intro hall
        have h1_mem : (1 : Fin N → B) ∈ q.asIdeal := by
          rw [← hsum_one]
          exact Ideal.sum_mem q.asIdeal (fun j _ => hall j)
        exact q.isPrime.ne_top ((Ideal.eq_top_iff_one q.asIdeal).mpr h1_mem)
      obtain ⟨j, hj⟩ := Classical.not_forall.mp hnot_all
      obtain ⟨x, hx⟩ := ((hs_open_and_range j).2 q).mpr hj
      refine ⟨j, x, ?_⟩
      change e_sheet.hom.base ((s_mor j).base x) = y
      rw [hx]
      change (e_sheet.inv ≫ e_sheet.hom).base y = y
      rw [e_sheet.inv_hom_id]; rfl
  have hSplit_V := hMakeSheets V E₁ e_PV he_PV N₁ Φ₁
  have hSplit_U := hMakeSheets U E₂ e_PU he_PU N₂ Φ₂
  obtain ⟨A, hFinA, hTorA, hPbA⟩ :=
    weil_etale_connected_constant_cokernel_of_sheet_split ℓ g_Z V U θ (hSite g_Z)
      N₁ N₂ hSplit_V hSplit_U
  exact ⟨U_Z, hNe_UZ, V_Z, p, A, hFin_p, hEt_p, hSurj_p, hFinA, hTorA, hPbA⟩

theorem weil_pbc_projLine_filtered_colimit_constructible_descent (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (A : Type u) [CommRing A] [Algebra k A] (τ_A : A →ₐ[k] k)
    (hInjZero : ∀ {X S : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ S)
      (I : CategoryTheory.Sheaf X.smallEtaleTopology
        (ModuleCat.{u, u} (ULift.{u, 0} (ZMod ℓ))))
      [CategoryTheory.Injective I] (q : ℕ), 1 ≤ q →
      CategoryTheory.Limits.IsZero
        (weilEtaleHigherDirectImage f q
          ((CategoryTheory.Sheaf.composeAndSheafify X.smallEtaleTopology
            (CategoryTheory.forget₂ (ModuleCat.{u, u} (ULift.{u, 0} (ZMod ℓ)))
              AddCommGrpCat.{u})).obj I))) :
    let s_A := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A))
    let P₁ := weilProjectiveSpaceOver k 1
    let X_A := CategoryTheory.Limits.pullback s_A P₁.hom
    let p₁_A := CategoryTheory.Limits.pullback.fst s_A P₁.hom
    let ι_A := AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_A.toRingHom)
    let i₀ := CategoryTheory.Limits.pullback.snd ι_A p₁_A
    (∀ (q : ℕ),
      (∀ (R : Type u) [CommRing R] [Algebra k R] [Algebra.FiniteType k R]
          (p_R : X_A ⟶ CategoryTheory.Limits.pullback
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k R))) P₁.hom)
          (G : CategoryTheory.Sheaf
            (CategoryTheory.Limits.pullback
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k R))) P₁.hom).smallEtaleTopology
            AddCommGrpCat.{u})
          (F' : CategoryTheory.Sheaf X_A.smallEtaleTopology AddCommGrpCat.{u}),
        ℓ • CategoryTheory.CategoryStruct.id F' = 0 →
        WeilIsConstructibleModPrimeSheaf ℓ
          (CategoryTheory.Limits.pullback
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k R))) P₁.hom) G →
        WeilIsEtaleSheafPullback p_R G F' →
        WeilEtaleCohomologyPullbackBijective i₀ F' q) →
