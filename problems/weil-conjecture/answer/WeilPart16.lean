    have : AlgebraicGeometry.IsIntegral Z₀ := hIntZ
    have : IrreducibleSpace ↥Z₀ := AlgebraicGeometry.irreducibleSpace_of_isIntegral Z₀
    have : CompactSpace ↥Z₀ := AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace g_Z
    have hW : ∀ z : ↥Z₀, ∃ W : Z₀.Opens, AlgebraicGeometry.IsAffineOpen W ∧ z ∈ W := by
      intro z
      obtain ⟨W, hAffW, hzW, -⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := z) (U := ⊤) trivial
      exact ⟨W, hAffW, hzW⟩
    choose W hAffW hzW using hW
    obtain ⟨s, hs⟩ := isCompact_univ.elim_finite_subcover (fun z : ↥Z₀ => (W z : Set ↥Z₀))
      (fun z => (W z).isOpen) (fun z _ => Set.mem_iUnion.mpr ⟨z, hzW z⟩)
    let r : ℕ := s.card
    let e_s : ↥s ≃ Fin r := s.equivFin
    let U : Fin r → Z₀.Opens := fun j => W (e_s.symm j).1
    have hCovU : ⨆ j : Fin r, U j = ⊤ := by
      rw [eq_top_iff]
      intro z _
      obtain ⟨y, hy_mem⟩ := Set.mem_iUnion.mp (hs (Set.mem_univ z))
      obtain ⟨hy_s, hz_Wy⟩ := Set.mem_iUnion.mp hy_mem
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨e_s ⟨y, hy_s⟩, by simpa [U] using hz_Wy⟩
    have hAffU : ∀ j : Fin r, AlgebraicGeometry.IsAffineOpen (U j) :=
      fun j => hAffW (e_s.symm j).1
    have hNeU : ∀ j : Fin r, Nonempty ↥(U j) :=
      fun j => ⟨⟨(e_s.symm j).1, hzW (e_s.symm j).1⟩⟩
    have hr : 0 < r := by
      obtain ⟨z₀⟩ := (inferInstance : Nonempty ↥Z₀)
      have hz₀ : z₀ ∈ (⊤ : Z₀.Opens) := trivial
      rw [← hCovU, TopologicalSpace.Opens.mem_iSup] at hz₀
      obtain ⟨j₀, -⟩ := hz₀
      exact Nat.pos_of_ne_zero (fun h0 => Fin.elim0 (h0 ▸ j₀))
    have hGenEx : ∀ j : Fin r,
        ∃ (nj : ℕ) (fj : Fin nj → ↑(Z₀.presheaf.obj (Opposite.op (U j)))),
          Function.Surjective
            (MvPolynomial.eval₂Hom
              ((AlgebraicGeometry.Scheme.Hom.appLE g_Z ⊤ (U j) le_top).hom) fj) := by
      intro j
      let σ_j := (AlgebraicGeometry.Scheme.Hom.appLE g_Z ⊤ (U j) le_top).hom
      have hFT : σ_j.FiniteType :=
        AlgebraicGeometry.Scheme.Hom.finiteType_appLE g_Z
          (AlgebraicGeometry.isAffineOpen_top S.left) (hAffU j) le_top
      let _ : Algebra ↑(S.left.presheaf.obj (Opposite.op ⊤))
          ↑(Z₀.presheaf.obj (Opposite.op (U j))) := σ_j.toAlgebra
      have hAlgFT : Algebra.FiniteType
          ↑(S.left.presheaf.obj (Opposite.op ⊤))
          ↑(Z₀.presheaf.obj (Opposite.op (U j))) := hFT
      obtain ⟨nj, ψ_j, hSurj_ψ⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hAlgFT
      refine ⟨nj, fun m => ψ_j (MvPolynomial.X m), ?_⟩
      have hEqHom : ψ_j.toRingHom =
          MvPolynomial.eval₂Hom σ_j (fun m => ψ_j (MvPolynomial.X m)) := by
        apply MvPolynomial.ringHom_ext'
        · ext c
          simp only [RingHom.comp_apply, MvPolynomial.eval₂Hom_C]
          exact ψ_j.commutes c
        · intro m
          simp
      rwa [← hEqHom]
    choose n f_gen hGen using hGenEx
    have hInter : ∀ (m' : ℕ) (V : Fin (m' + 1) → Z₀.Opens),
        (∀ j, AlgebraicGeometry.IsAffineOpen (V j)) →
        (∀ j, Nonempty ↥(V j)) →
        Nonempty ↥(⨅ j, V j) ∧ AlgebraicGeometry.IsAffineOpen (⨅ j, V j) := by
      intro m'
      induction m' with
      | zero =>
        intro V hAffV hNeV
        have hEq0 : (⨅ j : Fin 1, V j) = V 0 :=
          le_antisymm (iInf_le V 0) (le_iInf fun j => by rw [Subsingleton.elim j 0])
        rw [hEq0]
        exact ⟨hNeV 0, hAffV 0⟩
      | succ m' ih =>
        intro V hAffV hNeV
        have hSplit : (⨅ j : Fin (m' + 2), V j) = V 0 ⊓ (⨅ j : Fin (m' + 1), V j.succ) :=
          le_antisymm
            (le_inf (iInf_le V 0) (le_iInf fun j => iInf_le V j.succ))
            (le_iInf fun j => Fin.cases inf_le_left (fun k => inf_le_right.trans (iInf_le _ k)) j)
        rw [hSplit]
        obtain ⟨hNeRest, hAffRest⟩ :=
          ih (fun j => V j.succ) (fun j => hAffV j.succ) (fun j => hNeV j.succ)
        obtain ⟨⟨x₁, hx₁⟩⟩ := hNeV 0
        obtain ⟨⟨x₂, hx₂⟩⟩ := hNeRest
        obtain ⟨x, -, hxV0, hxRest⟩ :=
          (IrreducibleSpace.isIrreducible_univ (X := ↥Z₀)).isPreirreducible
            (V 0 : Set ↥Z₀) (↑(⨅ j : Fin (m' + 1), V j.succ) : Set ↥Z₀)
            (V 0).isOpen (⨅ j : Fin (m' + 1), V j.succ).isOpen
            ⟨x₁, trivial, hx₁⟩ ⟨x₂, trivial, hx₂⟩
        exact ⟨⟨⟨x, hxV0, hxRest⟩⟩, (hAffV 0).inf hAffRest⟩
    obtain ⟨m', hm'⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hr)
    let e_r : Fin (m' + 1) ≃ Fin r := finCongr hm'.symm
    let U₀ : Z₀.Opens := ⨅ j : Fin r, U j
    have hU₀_eq : U₀ = ⨅ j : Fin (m' + 1), U (e_r j) :=
      le_antisymm
        (le_iInf fun j => iInf_le U (e_r j))
        (le_iInf fun j => e_r.apply_symm_apply j ▸ iInf_le (fun k => U (e_r k)) (e_r.symm j))
    have hU₀_props : Nonempty ↥U₀ ∧ AlgebraicGeometry.IsAffineOpen U₀ := by
      rw [hU₀_eq]
      exact hInter m' (fun j => U (e_r j)) (fun j => hAffU (e_r j)) (fun j => hNeU (e_r j))
    exact ⟨hSepZ, r, hr, U, hCovU, hAffU, hNeU, n, f_gen, hGen,
      U₀, fun j => iInf_le U j, hU₀_props.1, hU₀_props.2⟩
  
  have step3 : ∀ (Z₀ : AlgebraicGeometry.Scheme.{u})
      (h_Z : Z₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of k))
      (r : ℕ) (_hr : 0 < r)
      (U : Fin r → Z₀.Opens)
      (n : Fin r → ℕ)
      (f_gen : ∀ j : Fin r, Fin (n j) → ↑(Z₀.presheaf.obj (Opposite.op (U j))))
      (U₀ : Z₀.Opens) (hU₀_le : ∀ j : Fin r, U₀ ≤ U j)
      (N : ℕ) (hN : (∏ j : Fin r, (n j + 1)) ≤ N + 1),
      ∃ (Φ : (U₀ : AlgebraicGeometry.Scheme.{u}) ⟶ (weilProjectiveSpaceOver k N).left)
        (D : Fin (N + 1) → (weilProjectiveSpaceOver k N).left.Opens)
        (z : ∀ (β γ : Fin (N + 1)),
          ↑((weilProjectiveSpaceOver k N).left.presheaf.obj (Opposite.op (D γ))))
        (IsZeroAt : Fin r → Fin (N + 1) → Prop),
        (Φ ≫ (weilProjectiveSpaceOver k N).hom = U₀.ι ≫ h_Z) ∧
        (⨆ γ : Fin (N + 1), D γ = ⊤) ∧
        (∀ γ : Fin (N + 1), AlgebraicGeometry.IsAffineOpen (D γ)) ∧
        (∀ β γ : Fin (N + 1),
          (weilProjectiveSpaceOver k N).left.basicOpen (z β γ) ≤ D β) ∧
        (∀ (j₀ : Fin r) (γ : Fin (N + 1)),
          ∃ (β : Fin (N + 1)) (u : ↑(Z₀.presheaf.obj (Opposite.op (U j₀)))),
            IsZeroAt j₀ β ∧
            ((AlgebraicGeometry.Scheme.Hom.app Φ (D γ)).hom (z β γ)) *
              ((AlgebraicGeometry.Scheme.Hom.appLE U₀.ι (U j₀)
                (Φ ⁻¹ᵁ D γ) (fun x _ => hU₀_le j₀ x.2)).hom u) = 1) ∧
        (∀ (j : Fin r) (β : Fin (N + 1)),
          IsZeroAt j β →
          ∀ m : Fin (n j),
