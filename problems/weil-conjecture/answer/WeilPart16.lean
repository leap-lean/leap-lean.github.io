        rw [Multiset.subset_iff]
        intro d hd
        change d ∈ Z at hd
        obtain ⟨s, hs, rfl⟩ := Finset.mem_image.mp hd
        rw [Polynomial.mem_roots hP_ne, Polynomial.IsRoot.def]
        have hs_not_open : y' ∉ AlgebraicGeometry.Proj.basicOpen 𝒜
