  let mkH0 : ∀ (Z : AlgebraicGeometry.Scheme.{u})
      (F : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}),
      ↑(F.obj.obj (Opposite.op (weilAffColim0TermEtale Z))) → F.H 0 :=
    fun Z F m =>
      let Pℤ := (CategoryTheory.Functor.const (Opposite Z.Etale)).obj Aℤ
      let shAdj := CategoryTheory.sheafificationAdjunction Z.smallEtaleTopology AddCommGrpCat.{u}
