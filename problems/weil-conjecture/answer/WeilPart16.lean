    have hα_app : α_m.app (Opposite.op (weilAffColim0TermEtale Z)) = g_m :=
      (congrArg (fun k => g_m ≫ F.obj.map (Opposite.op k)) hid).trans
        ((congrArg (g_m ≫ ·) (F.obj.map_id (Opposite.op (weilAffColim0TermEtale Z)))).trans
