        (epf_23.inv.naturality (adj_f₁.unit.app (pb_f₂.obj (pb_f₃.obj X)))).symm
      have hunit₁ : adj_f₁.unit.app (pb_f₂₃.obj X) ≫ pf_f₁.map (pb_f₁.map α_23) =
          α_23 ≫ adj_f₁.unit.app (pb_f₂.obj (pb_f₃.obj X)) :=
