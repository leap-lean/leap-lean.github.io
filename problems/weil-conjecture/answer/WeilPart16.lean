  have hT_of : ∀ (Y : AlgebraicGeometry.Scheme.{u}), CategoryTheory.Limits.IsTerminal (T_of Y) := by
    intro Y
    refine CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun W => (CategoryTheory.MorphismProperty.Over.homMk W.hom
        (CategoryTheory.Category.comp_id W.hom) : W ⟶ T_of Y)) ?_
    intro W m
    refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
    exact (CategoryTheory.Category.comp_id m.left).symm.trans
      (CategoryTheory.MorphismProperty.Over.w m)

  let Aℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
  let Pℤ : ∀ (Y : AlgebraicGeometry.Scheme.{u}),
      CategoryTheory.Functor (Opposite Y.Etale) AddCommGrpCat.{u} :=
    fun Y => (CategoryTheory.Functor.const (Opposite Y.Etale)).obj Aℤ
  let Fℤ : ∀ (Y : AlgebraicGeometry.Scheme.{u}),
      CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u} :=
    fun Y => (CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ

  let constPresheafHom : ∀ (Y : AlgebraicGeometry.Scheme.{u})
      (Q : CategoryTheory.Functor (Opposite Y.Etale) AddCommGrpCat.{u}),
      (Aℤ ⟶ Q.obj (Opposite.op (T_of Y))) → (Pℤ Y ⟶ Q) :=
    fun Y Q g₀ =>
      { app := fun U => g₀ ≫ Q.map (Opposite.op ((hT_of Y).from U.unop))
        naturality := fun U₁ U₂ f => by
          have hf : f.unop ≫ (hT_of Y).from U₁.unop = (hT_of Y).from U₂.unop :=
            (hT_of Y).hom_ext _ _
          have hop : Opposite.op ((hT_of Y).from U₂.unop) =
              Opposite.op ((hT_of Y).from U₁.unop) ≫ f :=
            congrArg Opposite.op hf.symm
          exact (CategoryTheory.Category.id_comp _).trans
            ((congrArg (g₀ ≫ ·) ((congrArg Q.map hop).trans (Q.map_comp _ _))).trans
              (CategoryTheory.Category.assoc _ _ _).symm) }

  have hConst_app_T : ∀ (Y : AlgebraicGeometry.Scheme.{u})
      (Q : CategoryTheory.Functor (Opposite Y.Etale) AddCommGrpCat.{u})
      (g₀ : Aℤ ⟶ Q.obj (Opposite.op (T_of Y))),
      (constPresheafHom Y Q g₀).app (Opposite.op (T_of Y)) = g₀ := by
    intro Y Q g₀
    have hid : (hT_of Y).from (T_of Y) = CategoryTheory.CategoryStruct.id (T_of Y) :=
      (hT_of Y).hom_ext _ _
    exact (congrArg (g₀ ≫ Q.map ·) (congrArg Opposite.op hid)).trans
      ((congrArg (g₀ ≫ ·) (Q.map_id (Opposite.op (T_of Y)))).trans
        (CategoryTheory.Category.comp_id g₀))

  have hConst_ext : ∀ {Y : AlgebraicGeometry.Scheme.{u}}
      {Q : CategoryTheory.Functor (Opposite Y.Etale) AddCommGrpCat.{u}}
      (α₁ α₂ : Pℤ Y ⟶ Q),
      α₁.app (Opposite.op (T_of Y)) = α₂.app (Opposite.op (T_of Y)) → α₁ = α₂ := by
    intro Y Q α₁ α₂ hT
    apply CategoryTheory.NatTrans.ext
    funext U
    have h₁ := (CategoryTheory.Category.id_comp (α₁.app U)).symm.trans
      (α₁.naturality (Opposite.op ((hT_of Y).from U.unop)))
    have h₂ := (CategoryTheory.Category.id_comp (α₂.app U)).symm.trans
      (α₂.naturality (Opposite.op ((hT_of Y).from U.unop)))
    exact h₁.trans ((congrArg (· ≫ _) hT).trans h₂.symm)

  
  let homOfElem : ∀ {G : AddCommGrpCat.{u}}, ↥G → (Aℤ ⟶ G) :=
    fun {G} m => AddCommGrpCat.ofHom
      { toFun := fun n => n.down • m
        map_zero' := zero_zsmul m
        map_add' := fun a b => add_zsmul m a.down b.down }

  have hHomOfElem_one : ∀ {G : AddCommGrpCat.{u}} (m : ↥G),
      homOfElem m (ULift.up (1 : ℤ)) = m := by
    intro G m
    exact one_zsmul m

  have hHomOfElem_ext : ∀ {G : AddCommGrpCat.{u}} (g₀ : Aℤ ⟶ G),
      homOfElem (g₀ (ULift.up (1 : ℤ))) = g₀ := by
    intro G g₀
    ext ⟨n⟩
    have hn : (ULift.up n : ULift.{u} ℤ) = n • ULift.up (1 : ℤ) :=
      ULift.ext _ _ (mul_one n).symm
    change n • g₀ (ULift.up (1 : ℤ)) = g₀ (ULift.up n)
    rw [hn, map_zsmul]

  let sheafHomEquivSec : ∀ (Y : AlgebraicGeometry.Scheme.{u})
      (M : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}),
      (Fℤ Y ⟶ M) ≃+ ↥(M.obj.obj (Opposite.op (T_of Y))) :=
    fun Y M =>
      let adj_sh := CategoryTheory.sheafificationAdjunction Y.smallEtaleTopology AddCommGrpCat.{u}
      let η_T := (adj_sh.unit.app (Pℤ Y)).app (Opposite.op (T_of Y))
      { toFun := fun φ => (η_T ≫ φ.hom.app (Opposite.op (T_of Y))) (ULift.up (1 : ℤ))
        invFun := fun m =>
          (adj_sh.homEquiv (Pℤ Y) M).symm (constPresheafHom Y M.obj (homOfElem m))
        left_inv := fun φ => by
          apply (adj_sh.homEquiv (Pℤ Y) M).injective
          rw [Equiv.apply_symm_apply]
          apply hConst_ext
          rw [hConst_app_T]
          exact hHomOfElem_ext (η_T ≫ φ.hom.app (Opposite.op (T_of Y)))
        right_inv := fun m => by
          have h_eq := (adj_sh.homEquiv (Pℤ Y) M).apply_symm_apply
            (constPresheafHom Y M.obj (homOfElem m))
          have h_app : η_T ≫
              ((adj_sh.homEquiv (Pℤ Y) M).symm
                (constPresheafHom Y M.obj (homOfElem m))).hom.app (Opposite.op (T_of Y)) =
              homOfElem m := by
            have h_u := congrArg (fun α : Pℤ Y ⟶ M.obj => α.app (Opposite.op (T_of Y)))
              ((adj_sh.homEquiv_unit (Pℤ Y) M _).symm.trans h_eq)
            exact h_u.trans (hConst_app_T Y M.obj (homOfElem m))
          exact (congrArg (fun g : Aℤ ⟶ M.obj.obj (Opposite.op (T_of Y)) =>
            g (ULift.up (1 : ℤ))) h_app).trans (hHomOfElem_one m)
        map_add' := fun φ₁ φ₂ => rfl }

  let eH₀ : ∀ {Y : AlgebraicGeometry.Scheme.{u}}
      (M : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}),
      M.H 0 ≃+ ↥(M.obj.obj (Opposite.op (T_of Y))) :=
    fun {Y} M => CategoryTheory.Abelian.Ext.addEquiv₀.trans (sheafHomEquivSec Y M)

  let τ_of : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (f_Y : Quiver.Hom X Y),
      (weilEtaleSitePullback f_Y).obj (T_of Y) ⟶ T_of X :=
    fun {X Y} f_Y =>
      CategoryTheory.MorphismProperty.Over.homMk
        ((weilEtaleSitePullback f_Y).obj (T_of Y)).hom
        (CategoryTheory.Category.comp_id _)

  let eBaseSec : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (f_Y : Quiver.Hom X Y)
      (K : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}),
      ↥(K.obj.obj (Opposite.op (T_of X))) ≃+
        ↥(((pf_of f_Y).obj K).obj.obj (Opposite.op (T_of Y))) :=
    fun {X Y} f_Y K =>
      let σ_left : X ⟶ CategoryTheory.Limits.pullback (T_of Y).hom f_Y :=
        CategoryTheory.Limits.pullback.lift f_Y (CategoryTheory.CategoryStruct.id X)
          ((CategoryTheory.Category.comp_id f_Y).trans (CategoryTheory.Category.id_comp f_Y).symm)
      let σ_fY : T_of X ⟶ (weilEtaleSitePullback f_Y).obj (T_of Y) :=
        CategoryTheory.MorphismProperty.Over.homMk σ_left
          (CategoryTheory.Limits.pullback.lift_snd _ _ _)
      have hστ : σ_fY ≫ τ_of f_Y = CategoryTheory.CategoryStruct.id (T_of X) :=
        (hT_of X).hom_ext _ _
      have hτσ : τ_of f_Y ≫ σ_fY =
          CategoryTheory.CategoryStruct.id ((weilEtaleSitePullback f_Y).obj (T_of Y)) := by
        refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
        change CategoryTheory.Limits.pullback.snd (T_of Y).hom f_Y ≫ σ_left =
          CategoryTheory.CategoryStruct.id _
        let p_fst := CategoryTheory.Limits.pullback.fst (T_of Y).hom f_Y
        let p_snd := CategoryTheory.Limits.pullback.snd (T_of Y).hom f_Y
        apply CategoryTheory.Limits.pullback.hom_ext
        · exact (CategoryTheory.Category.assoc p_snd σ_left p_fst).trans
            ((congrArg (p_snd ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
              ((CategoryTheory.Limits.pullback.condition (f := (T_of Y).hom) (g := f_Y)).symm.trans
                ((CategoryTheory.Category.comp_id p_fst).trans
                  (CategoryTheory.Category.id_comp p_fst).symm)))
        · exact (CategoryTheory.Category.assoc p_snd σ_left p_snd).trans
            ((congrArg (p_snd ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
              ((CategoryTheory.Category.comp_id p_snd).trans
                (CategoryTheory.Category.id_comp p_snd).symm))
      { toFun := fun x => K.obj.map (Opposite.op (τ_of f_Y)) x
        invFun := fun y => K.obj.map (Opposite.op σ_fY) y
        left_inv := fun x => by
          have h_id : K.obj.map (Opposite.op (τ_of f_Y)) ≫ K.obj.map (Opposite.op σ_fY) =
              CategoryTheory.CategoryStruct.id _ :=
            (K.obj.map_comp (Opposite.op (τ_of f_Y)) (Opposite.op σ_fY)).symm.trans
              ((congrArg K.obj.map (congrArg Opposite.op hστ)).trans (K.obj.map_id _))
          exact congrArg (fun g : K.obj.obj (Opposite.op (T_of X)) ⟶
            K.obj.obj (Opposite.op (T_of X)) => g x) h_id
        right_inv := fun y => by
          have h_id : K.obj.map (Opposite.op σ_fY) ≫ K.obj.map (Opposite.op (τ_of f_Y)) =
              CategoryTheory.CategoryStruct.id _ :=
            (K.obj.map_comp (Opposite.op σ_fY) (Opposite.op (τ_of f_Y))).symm.trans
              ((congrArg K.obj.map (congrArg Opposite.op hτσ)).trans (K.obj.map_id _))
          exact congrArg (fun g : ((pf_of f_Y).obj K).obj.obj (Opposite.op (T_of Y)) ⟶
            ((pf_of f_Y).obj K).obj.obj (Opposite.op (T_of Y)) => g y) h_id
        map_add' := fun x₁ x₂ => map_add (K.obj.map (Opposite.op (τ_of f_Y))).hom x₁ x₂ }

  
  let uℤ_of : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
      Fℤ Y₂ ⟶ (pf_of h).obj (Fℤ Y₁) :=
    fun {Y₁ Y₂} h =>
      ((CategoryTheory.sheafificationAdjunction Y₂.smallEtaleTopology AddCommGrpCat.{u}).homEquiv
        (Pℤ Y₂) ((pf_of h).obj (Fℤ Y₁))).symm
        (CategoryTheory.Functor.whiskerLeft (weilEtaleSitePullback h).op
          ((CategoryTheory.sheafificationAdjunction Y₁.smallEtaleTopology AddCommGrpCat.{u}).unit.app
            (Pℤ Y₁)))

  have huℤ_unit : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂)
      (V : Y₂.Etale),
      ((CategoryTheory.sheafificationAdjunction Y₂.smallEtaleTopology AddCommGrpCat.{u}).unit.app
        (Pℤ Y₂)).app (Opposite.op V) ≫ (uℤ_of h).hom.app (Opposite.op V) =
      ((CategoryTheory.sheafificationAdjunction Y₁.smallEtaleTopology AddCommGrpCat.{u}).unit.app
        (Pℤ Y₁)).app (Opposite.op ((weilEtaleSitePullback h).obj V)) := by
    intro Y₁ Y₂ h V
    let adj_sh₂ := CategoryTheory.sheafificationAdjunction Y₂.smallEtaleTopology AddCommGrpCat.{u}
    have h_eq := (adj_sh₂.homEquiv_unit (Pℤ Y₂) ((pf_of h).obj (Fℤ Y₁)) (uℤ_of h)).symm.trans
      ((adj_sh₂.homEquiv (Pℤ Y₂) ((pf_of h).obj (Fℤ Y₁))).apply_symm_apply _)
    exact congrArg (fun α : Pℤ Y₂ ⟶ ((pf_of h).obj (Fℤ Y₁)).obj => α.app (Opposite.op V)) h_eq

  have hBase_unit : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (f_Y : Quiver.Hom X Y)
      (K : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}) (z : K.H 0),
      sheafHomEquivSec Y ((pf_of f_Y).obj K)
        (uℤ_of f_Y ≫ (pf_of f_Y).map (CategoryTheory.Abelian.Ext.addEquiv₀ z)) =
      evalBaseH₀ f_Y K z := by
    intro X Y f_Y K z
    let w : Fℤ X ⟶ K := CategoryTheory.Abelian.Ext.addEquiv₀ z
    let η_X := (CategoryTheory.sheafificationAdjunction X.smallEtaleTopology
      AddCommGrpCat.{u}).unit.app (Pℤ X)
    have h_comp :
        ((CategoryTheory.sheafificationAdjunction Y.smallEtaleTopology AddCommGrpCat.{u}).unit.app
          (Pℤ Y)).app (Opposite.op (T_of Y)) ≫
          (uℤ_of f_Y ≫ (pf_of f_Y).map w).hom.app (Opposite.op (T_of Y)) =
        (η_X.app (Opposite.op (T_of X)) ≫ w.hom.app (Opposite.op (T_of X))) ≫
          K.obj.map (Opposite.op (τ_of f_Y)) :=
      (CategoryTheory.Category.assoc
        (((CategoryTheory.sheafificationAdjunction Y.smallEtaleTopology AddCommGrpCat.{u}).unit.app
          (Pℤ Y)).app (Opposite.op (T_of Y)))
        ((uℤ_of f_Y).hom.app (Opposite.op (T_of Y)))
        (w.hom.app (Opposite.op ((weilEtaleSitePullback f_Y).obj (T_of Y))))).symm.trans
        ((congrArg (· ≫ w.hom.app (Opposite.op ((weilEtaleSitePullback f_Y).obj (T_of Y))))
          (huℤ_unit f_Y (T_of Y))).trans
          ((CategoryTheory.Category.id_comp _).symm.trans
            ((η_X ≫ w.hom).naturality (Opposite.op (τ_of f_Y)))))
    exact congrArg (fun g : Aℤ ⟶ ((pf_of f_Y).obj K).obj.obj (Opposite.op (T_of Y)) =>
      g (ULift.up (1 : ℤ))) h_comp

  
  have hCongr_inv_fst : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}}
      {f₁ f₂ : Quiver.Hom S₁ S₂} (heq : f₁ = f₂) (A : S₂.Etale),
      let e : @CategoryTheory.Iso (CategoryTheory.Functor S₂.Etale S₁.Etale) _
          (weilEtaleSitePullback f₁) (weilEtaleSitePullback f₂) :=
        CategoryTheory.MorphismProperty.Over.pullbackCongr heq
      (e.inv.app A).left ≫ CategoryTheory.Limits.pullback.fst A.hom f₁ =
        CategoryTheory.Limits.pullback.fst A.hom f₂ := by
    intro S₁ S₂ f₁ f₂ heq A e
    have h_hom := CategoryTheory.MorphismProperty.Over.pullbackCongr_hom_app_left_fst
      (P := @AlgebraicGeometry.Etale) (Q := ⊤) heq A
    have h_inv_hom : (e.inv.app A).left ≫ (e.hom.app A).left =
        CategoryTheory.CategoryStruct.id _ :=
      congrArg (fun m => m.left) (e.inv_hom_id_app A)
    exact (congrArg ((e.inv.app A).left ≫ ·) h_hom.symm).trans
      ((CategoryTheory.Category.assoc (e.inv.app A).left (e.hom.app A).left _).symm.trans
        ((congrArg (· ≫ _) h_inv_hom).trans (CategoryTheory.Category.id_comp _)))

  have hComp_inv_fst : ∀ {S₁ S₂ S₃ : AlgebraicGeometry.Scheme.{u}}
      (f₁ : Quiver.Hom S₁ S₂) (f₂ : Quiver.Hom S₂ S₃) (A : S₃.Etale),
      let e : @CategoryTheory.Iso (CategoryTheory.Functor S₃.Etale S₁.Etale) _
          (weilEtaleSitePullback (f₁ ≫ f₂))
          (CategoryTheory.Functor.comp (weilEtaleSitePullback f₂) (weilEtaleSitePullback f₁)) :=
        CategoryTheory.MorphismProperty.Over.pullbackComp f₁ f₂
      (e.inv.app A).left ≫ CategoryTheory.Limits.pullback.fst A.hom (f₁ ≫ f₂) =
        CategoryTheory.Limits.pullback.fst ((weilEtaleSitePullback f₂).obj A).hom f₁ ≫
          CategoryTheory.Limits.pullback.fst A.hom f₂ := by
    intro S₁ S₂ S₃ f₁ f₂ A e
    have h_hom := CategoryTheory.MorphismProperty.Over.pullbackComp_left_fst_fst
      (P := @AlgebraicGeometry.Etale) (Q := ⊤) f₁ f₂ A
    have h_inv_hom : (e.inv.app A).left ≫ (e.hom.app A).left =
        CategoryTheory.CategoryStruct.id _ :=
      congrArg (fun m => m.left) (e.inv_hom_id_app A)
    exact (congrArg ((e.inv.app A).left ≫ ·) h_hom.symm).trans
      ((CategoryTheory.Category.assoc (e.inv.app A).left (e.hom.app A).left _).symm.trans
        ((congrArg (· ≫ _) h_inv_hom).trans (CategoryTheory.Category.id_comp _)))

  have hPull_map_fst : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}}
      (f : Quiver.Hom S₁ S₂) {A B : S₂.Etale} (u : A ⟶ B),
      ((weilEtaleSitePullback f).map u).left ≫ CategoryTheory.Limits.pullback.fst B.hom f =
        CategoryTheory.Limits.pullback.fst A.hom f ≫ u.left := by
    intro S₁ S₂ f A B u
    have h_map := CategoryTheory.MorphismProperty.Over.pullback_map_left
      (@AlgebraicGeometry.Etale) ⊤ f u
    exact (congrArg (· ≫ CategoryTheory.Limits.pullback.fst B.hom f) h_map).trans
      (CategoryTheory.Limits.pullback.lift_fst _ _ _)

  have hSquare_inv_fst : ∀ {W₁ W₂ S₁ S₂ : AlgebraicGeometry.Scheme.{u}}
      (g₂ : Quiver.Hom W₂ W₁) (f₁ : Quiver.Hom W₁ S₁)
      (f₂ : Quiver.Hom W₂ S₂) (g₁ : Quiver.Hom S₂ S₁)
      (hw : g₂ ≫ f₁ = f₂ ≫ g₁) (A : S₁.Etale),
      let e_sq : @CategoryTheory.Iso (CategoryTheory.Functor S₁.Etale W₂.Etale) _
          (CategoryTheory.Functor.comp (weilEtaleSitePullback f₁) (weilEtaleSitePullback g₂))
          (CategoryTheory.Functor.comp (weilEtaleSitePullback g₁) (weilEtaleSitePullback f₂)) :=
        CategoryTheory.Iso.trans
          (CategoryTheory.Iso.symm (CategoryTheory.MorphismProperty.Over.pullbackComp g₂ f₁))
          (CategoryTheory.Iso.trans
            (CategoryTheory.MorphismProperty.Over.pullbackCongr hw)
            (CategoryTheory.MorphismProperty.Over.pullbackComp f₂ g₁))
      ((e_sq.inv.app A).left ≫
          CategoryTheory.Limits.pullback.fst ((weilEtaleSitePullback f₁).obj A).hom g₂) ≫
        CategoryTheory.Limits.pullback.fst A.hom f₁ =
      CategoryTheory.Limits.pullback.fst ((weilEtaleSitePullback g₁).obj A).hom f₂ ≫
        CategoryTheory.Limits.pullback.fst A.hom g₁ := by
    intro W₁ W₂ S₁ S₂ g₂ f₁ f₂ g₁ hw A e_sq
    have h_hom₁ := CategoryTheory.MorphismProperty.Over.pullbackComp_left_fst_fst
      (P := @AlgebraicGeometry.Etale) (Q := ⊤) g₂ f₁ A
    let i₁ : @CategoryTheory.Iso (CategoryTheory.Functor S₁.Etale W₂.Etale) _
        (weilEtaleSitePullback (g₂ ≫ f₁))
        (CategoryTheory.Functor.comp (weilEtaleSitePullback f₁) (weilEtaleSitePullback g₂)) :=
      CategoryTheory.MorphismProperty.Over.pullbackComp g₂ f₁
    let i₂ : @CategoryTheory.Iso (CategoryTheory.Functor S₁.Etale W₂.Etale) _
        (weilEtaleSitePullback (g₂ ≫ f₁)) (weilEtaleSitePullback (f₂ ≫ g₁)) :=
      CategoryTheory.MorphismProperty.Over.pullbackCongr hw
    let i₃ : @CategoryTheory.Iso (CategoryTheory.Functor S₁.Etale W₂.Etale) _
        (weilEtaleSitePullback (f₂ ≫ g₁))
        (CategoryTheory.Functor.comp (weilEtaleSitePullback g₁) (weilEtaleSitePullback f₂)) :=
      CategoryTheory.MorphismProperty.Over.pullbackComp f₂ g₁
    have s₁ : ((e_sq.inv.app A).left ≫
          CategoryTheory.Limits.pullback.fst ((weilEtaleSitePullback f₁).obj A).hom g₂) ≫
        CategoryTheory.Limits.pullback.fst A.hom f₁ =
        (i₃.inv.app A).left ≫ (i₂.inv.app A).left ≫ ((i₁.hom.app A).left ≫
          CategoryTheory.Limits.pullback.fst ((weilEtaleSitePullback f₁).obj A).hom g₂ ≫
          CategoryTheory.Limits.pullback.fst A.hom f₁) :=
      (CategoryTheory.Category.assoc _ _ _).trans
        ((CategoryTheory.Category.assoc (i₃.inv.app A).left _ _).trans
          (congrArg ((i₃.inv.app A).left ≫ ·)
            (CategoryTheory.Category.assoc (i₂.inv.app A).left (i₁.hom.app A).left _)))
    have s₂ : (i₃.inv.app A).left ≫ (i₂.inv.app A).left ≫
          CategoryTheory.Limits.pullback.fst A.hom (g₂ ≫ f₁) =
        CategoryTheory.Limits.pullback.fst ((weilEtaleSitePullback g₁).obj A).hom f₂ ≫
          CategoryTheory.Limits.pullback.fst A.hom g₁ :=
      (congrArg ((i₃.inv.app A).left ≫ ·) (hCongr_inv_fst hw A)).trans (hComp_inv_fst f₂ g₁ A)
    exact s₁.trans ((congrArg ((i₃.inv.app A).left ≫ (i₂.inv.app A).left ≫ ·) h_hom₁).trans s₂)

  have hTri_inv_fst : ∀ {S₀ S₁ S₂ : AlgebraicGeometry.Scheme.{u}}
      (π₁ : Quiver.Hom S₁ S₀) (π₂ : Quiver.Hom S₂ S₀) (h : Quiver.Hom S₁ S₂)
      (h_eq : h ≫ π₂ = π₁) (A : S₀.Etale),
      let e_tri : @CategoryTheory.Iso (CategoryTheory.Functor S₀.Etale S₁.Etale) _
          (weilEtaleSitePullback π₁)
          (CategoryTheory.Functor.comp (weilEtaleSitePullback π₂) (weilEtaleSitePullback h)) :=
        CategoryTheory.Iso.trans
          (CategoryTheory.MorphismProperty.Over.pullbackCongr h_eq.symm)
