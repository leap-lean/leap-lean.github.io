        Function.Bijective (bc_sec g₁ f₁ π₁ hpb₁ F₀) ↔
          Function.Bijective (bcH₀ g₁ f₁ π₁ hpb₁ F₀) := by
      intro Z₁ X₁ g₁ f₁ π₁ hpb₁ F₀
      let e₁ := eH₀_of (pb_obj g₁ (pf_obj f₀_a F₀))
      let e₂ := eBase_of f₁ (pb_obj π₁ F₀)
      let f_sec := bc_sec g₁ f₁ π₁ hpb₁ F₀
      constructor
      · rintro ⟨h_inj, h_surj⟩
        refine ⟨fun x y hxy => e₁.injective (h_inj (e₂.symm.injective hxy)), fun y => ?_⟩
        obtain ⟨a, ha⟩ := h_surj (e₂ y)
        refine ⟨e₁.symm a, ?_⟩
        change e₂.symm (f_sec (e₁ (e₁.symm a))) = y
        rw [e₁.apply_symm_apply, ha, e₂.symm_apply_apply]
      · rintro ⟨h_inj, h_surj⟩
        refine ⟨fun a₁ a₂ ha => ?_, fun b => ?_⟩
        · have h0 : bcH₀ g₁ f₁ π₁ hpb₁ F₀ (e₁.symm a₁) = bcH₀ g₁ f₁ π₁ hpb₁ F₀ (e₁.symm a₂) := by
            change e₂.symm (f_sec (e₁ (e₁.symm a₁))) = e₂.symm (f_sec (e₁ (e₁.symm a₂)))
            rw [e₁.apply_symm_apply, e₁.apply_symm_apply, ha]
