theorem weil_etale_cech_syzygy_and_local_affine_effacement (Y : AlgebraicGeometry.Scheme.{u}) :
    let 𝒞 := CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}
    let Z_sh := fun (V : Y.Etale) =>
      (CategoryTheory.presheafToSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj
        ((CategoryTheory.yoneda.obj V).comp AddCommGrpCat.free)
    let Z_sh_map := fun {V₁ V₂ : Y.Etale} (u : V₁ ⟶ V₂) =>
      (CategoryTheory.presheafToSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).map
        (CategoryTheory.Functor.whiskerRight (CategoryTheory.yoneda.map u) AddCommGrpCat.free)
    (∀ (U : Y.Etale),
      AlgebraicGeometry.IsAffine ((AlgebraicGeometry.Scheme.Etale.forget Y).obj U).left →
      ∀ (G : 𝒞) (q : ℕ) (ξ : CategoryTheory.Abelian.Ext.{u} (Z_sh U) G (q + 1)),
        ∃ (W : Y.Etale) (w : W ⟶ U),
          AlgebraicGeometry.IsAffine ((AlgebraicGeometry.Scheme.Etale.forget Y).obj W).left ∧
          AlgebraicGeometry.Surjective ((AlgebraicGeometry.Scheme.Etale.forget Y).map w).left ∧
          (CategoryTheory.Abelian.Ext.mk₀ (Z_sh_map w)).comp ξ (Nat.zero_add (q + 1)) = 0) ∧
    (∀ {W U : Y.Etale} (w : W ⟶ U),
      AlgebraicGeometry.IsAffine ((AlgebraicGeometry.Scheme.Etale.forget Y).obj U).left →
      AlgebraicGeometry.IsAffine ((AlgebraicGeometry.Scheme.Etale.forget Y).obj W).left →
      AlgebraicGeometry.Surjective ((AlgebraicGeometry.Scheme.Etale.forget Y).map w).left →
      ∃ (K : ℕ → 𝒞) (f₀ : K 1 ⟶ Z_sh W) (h₀ : f₀ ≫ Z_sh_map w = 0),
        (CategoryTheory.ShortComplex.mk f₀ (Z_sh_map w) h₀).ShortExact ∧
        (∀ p : ℕ, AlgebraicGeometry.IsAffine
          ((AlgebraicGeometry.Scheme.Etale.forget Y).obj (weilEtaleCechObj w p)).left) ∧
        (∀ p : ℕ,
          ∃ (f_p : K (p + 1) ⟶ Z_sh (weilEtaleCechObj w p))
            (g_p : Z_sh (weilEtaleCechObj w p) ⟶ K p)
            (hfg_p : f_p ≫ g_p = 0)
            (e_p : Z_sh (weilEtaleCechObj w (p + 1)) ⟶ K (p + 1)),
            CategoryTheory.Epi e_p ∧
            (CategoryTheory.ShortComplex.mk f_p g_p hfg_p).ShortExact)) :=
by
  intro 𝒞 Z_sh Z_sh_map
  let J := Y.smallEtaleTopology
  let L := CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}
  let adj_sh := CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}
  let Z_psh := fun (V : Y.Etale) => (CategoryTheory.yoneda.obj V).comp AddCommGrpCat.free
  let Z_psh_map := fun {V₁ V₂ : Y.Etale} (u : V₁ ⟶ V₂) =>
    CategoryTheory.Functor.whiskerRight (CategoryTheory.yoneda.map u) AddCommGrpCat.free
  let of_psh : ∀ {V : Y.Etale} {T : (Y.Etale)ᵒᵖ},
      (Opposite.unop T ⟶ V) → (Z_psh V).obj T :=
    fun g => FreeAbelianGroup.of g

  have z_psh_hom_ext : ∀ {V : Y.Etale} {T : (Y.Etale)ᵒᵖ} {B : AddCommGrpCat.{u}}
      (f₁ f₂ : (Z_psh V).obj T ⟶ B),
      (∀ g : Opposite.unop T ⟶ V, f₁ (of_psh g) = f₂ (of_psh g)) →
      f₁ = f₂ :=
    fun f₁ f₂ h => AddCommGrpCat.ext fun x =>
      DFunLike.congr_fun (FreeAbelianGroup.lift_ext f₁.hom f₂.hom h) x

  
  let pshHom : ∀ (V : Y.Etale) (F : 𝒞), F.obj.obj (Opposite.op V) → (Z_psh V ⟶ F.obj) :=
    fun V F s =>
      { app := fun T => AddCommGrpCat.ofHom
          (FreeAbelianGroup.lift (fun g : Opposite.unop T ⟶ V => F.obj.map g.op s))
        naturality := fun {T₁ T₂} φ =>
          z_psh_hom_ext _ _ fun g => by
            change FreeAbelianGroup.lift (fun h : Opposite.unop T₂ ⟶ V => F.obj.map h.op s)
                (FreeAbelianGroup.map (fun h : Opposite.unop T₁ ⟶ V => φ.unop ≫ h)
                  (FreeAbelianGroup.of g)) =
              F.obj.map φ (FreeAbelianGroup.lift (fun h : Opposite.unop T₁ ⟶ V => F.obj.map h.op s)
                (FreeAbelianGroup.of g))
            rw [FreeAbelianGroup.map_of_apply, FreeAbelianGroup.lift_apply_of,
              FreeAbelianGroup.lift_apply_of, CategoryTheory.op_comp, F.obj.map_comp]
            rfl }
  let shHom : ∀ (V : Y.Etale) (F : 𝒞), F.obj.obj (Opposite.op V) → (Z_sh V ⟶ F) :=
    fun V F s => (adj_sh.homEquiv (Z_psh V) F).symm (pshHom V F s)
  let secOf : ∀ (V : Y.Etale) (F : 𝒞), (Z_sh V ⟶ F) → F.obj.obj (Opposite.op V) :=
    fun V F φ => ((adj_sh.homEquiv (Z_psh V) F φ).app (Opposite.op V)) (of_psh (𝟙 V))

  have h_pshHom_secOf : ∀ (V : Y.Etale) (F : 𝒞) (φ : Z_sh V ⟶ F),
      pshHom V F (secOf V F φ) = adj_sh.homEquiv (Z_psh V) F φ := by
    intro V F φ
    ext T : 2
    refine z_psh_hom_ext _ _ fun g => ?_
    let α := adj_sh.homEquiv (Z_psh V) F φ
    have hnat := congrArg (fun m : (Z_psh V).obj (Opposite.op V) ⟶ F.obj.obj T =>
        m (of_psh (𝟙 V))) (α.naturality g.op)
    change FreeAbelianGroup.lift (fun h : Opposite.unop T ⟶ V => F.obj.map h.op (secOf V F φ))
        (FreeAbelianGroup.of g) = α.app T (of_psh g)
    rw [FreeAbelianGroup.lift_apply_of]
    have hnat' : α.app T (FreeAbelianGroup.map (fun h : V ⟶ V => g ≫ h)
        (FreeAbelianGroup.of (𝟙 V))) =
        F.obj.map g.op (α.app (Opposite.op V) (of_psh (𝟙 V))) := hnat
    rw [FreeAbelianGroup.map_of_apply, CategoryTheory.Category.comp_id] at hnat'
    exact hnat'.symm

  have h_shHom_secOf : ∀ (V : Y.Etale) (F : 𝒞) (φ : Z_sh V ⟶ F),
      shHom V F (secOf V F φ) = φ := by
    intro V F φ
    dsimp only [shHom]
    rw [h_pshHom_secOf]
    exact (adj_sh.homEquiv (Z_psh V) F).symm_apply_apply φ

  have h_shHom_comp : ∀ (V : Y.Etale) (I Q : 𝒞) (p : I ⟶ Q) (t : I.obj.obj (Opposite.op V)),
      shHom V I t ≫ p = shHom V Q (p.hom.app (Opposite.op V) t) := by
    intro V I Q p t
    dsimp only [shHom]
    rw [← CategoryTheory.Adjunction.homEquiv_naturality_right_symm adj_sh (pshHom V I t) p]
    congr 1
    ext T : 2
    refine z_psh_hom_ext _ _ fun g => ?_
    change p.hom.app T (FreeAbelianGroup.lift (fun h : Opposite.unop T ⟶ V => I.obj.map h.op t)
        (FreeAbelianGroup.of g)) =
      FreeAbelianGroup.lift (fun h : Opposite.unop T ⟶ V => Q.obj.map h.op (p.hom.app (Opposite.op V) t))
        (FreeAbelianGroup.of g)
    rw [FreeAbelianGroup.lift_apply_of, FreeAbelianGroup.lift_apply_of]
    exact congrArg (fun m : I.obj.obj (Opposite.op V) ⟶ Q.obj.obj T => m t) (p.hom.naturality g.op)

  have h_map_comp_shHom : ∀ {W U : Y.Etale} (w : W ⟶ U) (Q : 𝒞) (s : Q.obj.obj (Opposite.op U)),
      Z_sh_map w ≫ shHom U Q s = shHom W Q (Q.obj.map w.op s) := by
    intro W U w Q s
    dsimp only [shHom, Z_sh_map]
    rw [← CategoryTheory.Adjunction.homEquiv_naturality_left_symm adj_sh (Z_psh_map w) (pshHom U Q s)]
    congr 1
    ext T : 2
    refine z_psh_hom_ext _ _ fun g => ?_
    change FreeAbelianGroup.lift (fun h : Opposite.unop T ⟶ U => Q.obj.map h.op s)
        (FreeAbelianGroup.map (fun h : Opposite.unop T ⟶ W => h ≫ w) (FreeAbelianGroup.of g)) =
      FreeAbelianGroup.lift (fun h : Opposite.unop T ⟶ W => Q.obj.map h.op (Q.obj.map w.op s))
        (FreeAbelianGroup.of g)
    rw [FreeAbelianGroup.map_of_apply, FreeAbelianGroup.lift_apply_of,
      FreeAbelianGroup.lift_apply_of, CategoryTheory.op_comp, Q.obj.map_comp]
    rfl

  
  have : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale.{u}) :=
    ⟨fun f g hf hg => by
      have : AlgebraicGeometry.Etale f := hf
      have : AlgebraicGeometry.Etale g := hg
      infer_instance⟩
  have : AlgebraicGeometry.IsZariskiLocalAtSource (@AlgebraicGeometry.Etale.{u}) :=
    AlgebraicGeometry.HasRingHomProperty.instIsZariskiLocalAtSource
  have heq_top : Y.smallEtaleTopology = Y.smallEtalePretopology.toGrothendieck :=
    AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology Y le_rfl

  have hIsSheafType : ∀ (F : 𝒞),
      CategoryTheory.Presieve.IsSheaf Y.smallEtaleTopology
        (F.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u}) :=
    fun F => (CategoryTheory.isSheaf_iff_isSheaf_of_type Y.smallEtaleTopology
      (F.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u})).mp
      (CategoryTheory.GrothendieckTopology.HasSheafCompose.isSheaf
        (J := Y.smallEtaleTopology) (F := CategoryTheory.forget AddCommGrpCat.{u}) F.obj F.property)

  have hSub_empty : ∀ (F : 𝒞) (T : Y.Etale),
      IsEmpty ↥T.left →
      Subsingleton ((F.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u}).obj (Opposite.op T)) := by
    intro F T hEmp
    let S_emp : CategoryTheory.Sieve T :=
      CategoryTheory.Sieve.generate (fun _ _ => False)
    have hEmp_pre : S_emp ∈ Y.smallEtalePretopology.toGrothendieck T :=
      (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) (S := Y) T S_emp).mpr
        (fun x => IsEmpty.elim hEmp x)
    have hEmp_top : S_emp ∈ Y.smallEtaleTopology T := heq_top ▸ hEmp_pre
    have hSh := hIsSheafType F S_emp hEmp_top
    refine ⟨fun a b => hSh.isSeparatedFor.ext (fun _ _ hf => ?_)⟩
    rcases hf with ⟨_, _, _, hfalse, _⟩
    exact False.elim hfalse

  
  have hLift0 : ∀ (U : Y.Etale),
      AlgebraicGeometry.IsAffine ((AlgebraicGeometry.Scheme.Etale.forget Y).obj U).left →
      ∀ (I Q : 𝒞) (p : I ⟶ Q) [CategoryTheory.Epi p] (φ : Z_sh U ⟶ Q),
        ∃ (W : Y.Etale) (w : W ⟶ U) (ψ : Z_sh W ⟶ I),
          AlgebraicGeometry.IsAffine ((AlgebraicGeometry.Scheme.Etale.forget Y).obj W).left ∧
          AlgebraicGeometry.Surjective ((AlgebraicGeometry.Scheme.Etale.forget Y).map w).left ∧
          ψ ≫ p = Z_sh_map w ≫ φ := by
    intro U hAffU I Q p _ φ
    have : AlgebraicGeometry.IsAffine U.left := hAffU
    let q_sec : Q.obj.obj (Opposite.op U) := secOf U Q φ
    have : CategoryTheory.Sheaf.IsLocallySurjective p :=
      (CategoryTheory.Sheaf.isLocallySurjective_iff_epi' (φ := p)).mpr inferInstance
    have hImg_top : CategoryTheory.Presheaf.imageSieve p.hom q_sec ∈ Y.smallEtaleTopology U :=
      CategoryTheory.Presheaf.imageSieve_mem Y.smallEtaleTopology p.hom q_sec
    have hImg_pre : CategoryTheory.Presheaf.imageSieve p.hom q_sec ∈
        Y.smallEtalePretopology.toGrothendieck U := heq_top ▸ hImg_top
    have hPtCov := (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
      (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) (S := Y) U _).mp hImg_pre
    have hLocAff : ∀ x : ↥U.left,
        ∃ (Z_x : Y.Etale) (z_x : Z_x ⟶ U) (t_x : I.obj.obj (Opposite.op Z_x)),
          AlgebraicGeometry.IsAffine Z_x.left ∧
          AlgebraicGeometry.Etale z_x.left ∧
          x ∈ Set.range z_x.left.base ∧
          p.hom.app (Opposite.op Z_x) t_x = Q.obj.map z_x.op q_sec := by
      intro x
      obtain ⟨V_x, v_x, y_x, hv_mem, hv_et, hy_eq⟩ := hPtCov x
      obtain ⟨O_x, hAff_O, hy_O, -⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
          (show y_x ∈ (⊤ : V_x.left.Opens) from trivial)
      have : AlgebraicGeometry.Etale V_x.hom := V_x.prop
      have : AlgebraicGeometry.Etale v_x.left := hv_et
      let Z_x : Y.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (O_x.ι ≫ V_x.hom) inferInstance
      let j_x : Z_x ⟶ V_x := CategoryTheory.MorphismProperty.Over.homMk O_x.ι rfl
      let z_x : Z_x ⟶ U := j_x ≫ v_x
      have hz_mem : (CategoryTheory.Presheaf.imageSieve p.hom q_sec).arrows z_x :=
        (CategoryTheory.Presheaf.imageSieve p.hom q_sec).downward_closed hv_mem j_x
      obtain ⟨t_x, ht_x⟩ := hz_mem
      refine ⟨Z_x, z_x, t_x, hAff_O, ?_, ?_, ht_x⟩
      · change AlgebraicGeometry.Etale (O_x.ι ≫ v_x.left)
        infer_instance
      · refine ⟨⟨y_x, hy_O⟩, ?_⟩
        change v_x.left.base (O_x.ι.base ⟨y_x, hy_O⟩) = x
        exact hy_eq
    choose Z_x z_x t_x hAff_Z hEt_z hx_mem ht_eq using hLocAff
    have hOpen_z : ∀ x : ↥U.left, IsOpen (Set.range (z_x x).left.base) := by
      intro x
      have : AlgebraicGeometry.Etale (z_x x).left := hEt_z x
      exact (z_x x).left.isOpenMap.isOpen_range
    obtain ⟨F_pts, -, hCov_F⟩ := isCompact_univ.elim_nhds_subcover
      (fun x : ↥U.left => Set.range (z_x x).left.base)
      (fun x _ => IsOpen.mem_nhds (hOpen_z x) (hx_mem x))
    let ι_idx : Type u := ↥F_pts
    let g_sch : ι_idx → AlgebraicGeometry.Scheme.{u} := fun s => (Z_x s.1).left
    have : ∀ s : ι_idx, AlgebraicGeometry.IsAffine (g_sch s) := fun s => hAff_Z s.1
    let W_sch : AlgebraicGeometry.Scheme.{u} := ∐ g_sch
    let W_hom : W_sch ⟶ Y := CategoryTheory.Limits.Sigma.desc (fun s : ι_idx => (Z_x s.1).hom)
    have hW_et : AlgebraicGeometry.Etale W_hom :=
      AlgebraicGeometry.IsZariskiLocalAtSource.sigmaDesc
        (P := @AlgebraicGeometry.Etale.{u}) (fun s : ι_idx => (Z_x s.1).prop)
    let W : Y.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ W_hom hW_et
    let w_left : W_sch ⟶ U.left :=
      CategoryTheory.Limits.Sigma.desc (fun s : ι_idx => (z_x s.1).left)
    have hw_comm : w_left ≫ U.hom = W_hom := by
      apply CategoryTheory.Limits.Sigma.hom_ext
      intro s
      dsimp only [w_left, W_hom]
      rw [CategoryTheory.Limits.Sigma.ι_comp_desc_assoc, CategoryTheory.Limits.Sigma.ι_comp_desc]
      exact (z_x s.1).w
    let w : W ⟶ U := CategoryTheory.MorphismProperty.Over.homMk w_left hw_comm
    have hAffW : AlgebraicGeometry.IsAffine ((AlgebraicGeometry.Scheme.Etale.forget Y).obj W).left := by
      change AlgebraicGeometry.IsAffine W_sch
      infer_instance
    have hSurjW : AlgebraicGeometry.Surjective ((AlgebraicGeometry.Scheme.Etale.forget Y).map w).left := by
      change AlgebraicGeometry.Surjective w_left
      refine ⟨fun x => ?_⟩
      have hx_u : x ∈ ⋃ s ∈ F_pts, Set.range (z_x s).left.base :=
        hCov_F (Set.mem_univ x)
      rw [Set.mem_iUnion₂] at hx_u
      obtain ⟨s₀, hs₀, y, hy⟩ := hx_u
      let s : ι_idx := ⟨s₀, hs₀⟩
      refine ⟨(CategoryTheory.Limits.Sigma.ι g_sch s).base y, ?_⟩
      have hcomp : CategoryTheory.Limits.Sigma.ι g_sch s ≫ w_left = (z_x s.1).left :=
        CategoryTheory.Limits.Sigma.ι_comp_desc _ s
      exact (congrArg (fun k : g_sch s ⟶ U.left => k.base y) hcomp).trans hy
    let in_s : ∀ s : ι_idx, Z_x s.1 ⟶ W := fun s =>
      CategoryTheory.MorphismProperty.Over.homMk
        (CategoryTheory.Limits.Sigma.ι g_sch s)
        (CategoryTheory.Limits.Sigma.ι_comp_desc _ s)
    have hin_w : ∀ s : ι_idx, in_s s ≫ w = z_x s.1 := fun s =>
      CategoryTheory.MorphismProperty.Over.Hom.ext
        (CategoryTheory.Limits.Sigma.ι_comp_desc _ s)
    let R_W : CategoryTheory.Presieve W :=
      CategoryTheory.Presieve.ofArrows (fun s : ι_idx => Z_x s.1) in_s
    let S_W : CategoryTheory.Sieve W := CategoryTheory.Sieve.generate R_W
    have hSW_pre : S_W ∈ Y.smallEtalePretopology.toGrothendieck W := by
      refine (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) (S := Y) W S_W).mpr
        (fun z => ?_)
      let z' : ↥W_sch := z
      let s : ι_idx := (AlgebraicGeometry.sigmaOpenCover g_sch).idx z'
      obtain ⟨y, hy⟩ := (AlgebraicGeometry.sigmaOpenCover g_sch).covers z'
      have hy' : (CategoryTheory.Limits.Sigma.ι g_sch s).base y = z' := by
        rwa [← AlgebraicGeometry.sigmaOpenCover_f g_sch s]
      refine ⟨Z_x s.1, in_s s, y, ?_, ?_, hy'⟩
      · exact ⟨Z_x s.1, 𝟙 (Z_x s.1), in_s s,
          CategoryTheory.Presieve.ofArrows.mk s, CategoryTheory.Category.id_comp _⟩
      · change AlgebraicGeometry.Etale (CategoryTheory.Limits.Sigma.ι g_sch s)
        infer_instance
    have hSW : S_W ∈ Y.smallEtaleTopology W := heq_top ▸ hSW_pre
    let P_I := I.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u}
    let P_Q := Q.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u}
    have hOverlap : ∀ {T : Y.Etale} (s₁ s₂ : ι_idx) (g₁ : T ⟶ Z_x s₁.1) (g₂ : T ⟶ Z_x s₂.1),
        g₁ ≫ in_s s₁ = g₂ ≫ in_s s₂ →
        P_I.map g₁.op (t_x s₁.1) = P_I.map g₂.op (t_x s₂.1) := by
      intro T s₁ s₂ g₁ g₂ hcomm
      by_cases h_eq : s₁ = s₂
      · subst h_eq
        have hleft : g₁.left ≫ CategoryTheory.Limits.Sigma.ι g_sch s₁ =
            g₂.left ≫ CategoryTheory.Limits.Sigma.ι g_sch s₁ :=
          congrArg (fun u => u.left) hcomm
        have hg_eq : g₁ = g₂ := CategoryTheory.MorphismProperty.Over.Hom.ext
          ((CategoryTheory.cancel_mono (CategoryTheory.Limits.Sigma.ι g_sch s₁)).mp hleft)
        rw [hg_eq]
      · have hEmp : IsEmpty ↥T.left := by
          refine ⟨fun u => ?_⟩
          have hleft : g₁.left ≫ CategoryTheory.Limits.Sigma.ι g_sch s₁ =
              g₂.left ≫ CategoryTheory.Limits.Sigma.ι g_sch s₂ :=
            congrArg (fun k => k.left) hcomm
          let pt : ↥W_sch := (CategoryTheory.Limits.Sigma.ι g_sch s₁).base (g₁.left.base u)
          have h₁ : pt ∈ AlgebraicGeometry.Scheme.Hom.opensRange
              (CategoryTheory.Limits.Sigma.ι g_sch s₁) := ⟨g₁.left.base u, rfl⟩
          have h₂ : pt ∈ AlgebraicGeometry.Scheme.Hom.opensRange
              (CategoryTheory.Limits.Sigma.ι g_sch s₂) :=
            ⟨g₂.left.base u, congrArg (fun k : T.left ⟶ W_sch => k.base u) hleft.symm⟩
          exact Disjoint.le_bot
            (AlgebraicGeometry.disjoint_opensRange_sigmaι g_sch s₁ s₂ h_eq) ⟨h₁, h₂⟩
        have : Subsingleton (P_I.obj (Opposite.op T)) := hSub_empty I T hEmp
        exact Subsingleton.elim _ _
    have hFactor : ∀ {T : Y.Etale} {f : T ⟶ W}, S_W.arrows f →
        ∃ (s : ι_idx) (g : T ⟶ Z_x s.1), g ≫ in_s s = f := by
      intro T f ⟨_, g, _, hR, hgf⟩
      rcases hR with ⟨s⟩
      exact ⟨s, g, hgf⟩
    let fam : CategoryTheory.Presieve.FamilyOfElements P_I (S_W : CategoryTheory.Presieve W) :=
      fun T f hf => P_I.map (Classical.choose (Classical.choose_spec (hFactor hf))).op
        (t_x (Classical.choose (hFactor hf)).1)
    have hfam_eval : ∀ {T : Y.Etale} (s : ι_idx) (g : T ⟶ Z_x s.1)
        (hf : S_W.arrows (g ≫ in_s s)),
        fam (g ≫ in_s s) hf = P_I.map g.op (t_x s.1) := by
      intro T s g hf
      dsimp only [fam]
      exact hOverlap _ s _ g (Classical.choose_spec (Classical.choose_spec (hFactor hf)))
    have hfam_compat : fam.Compatible := by
      intro Y₁ Y₂ Z' g₁ g₂ f₁ f₂ hf₁ hf₂ hcomm
      obtain ⟨s₁, u₁, rfl⟩ := hFactor hf₁
      obtain ⟨s₂, u₂, rfl⟩ := hFactor hf₂
      rw [hfam_eval s₁ u₁ hf₁, hfam_eval s₂ u₂ hf₂]
      change (P_I.map u₁.op ≫ P_I.map g₁.op) (t_x s₁.1) =
        (P_I.map u₂.op ≫ P_I.map g₂.op) (t_x s₂.1)
      rw [← P_I.map_comp, ← P_I.map_comp, ← CategoryTheory.op_comp, ← CategoryTheory.op_comp]
      refine hOverlap s₁ s₂ (g₁ ≫ u₁) (g₂ ≫ u₂) ?_
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]
      exact hcomm
    have hSh_I := hIsSheafType I S_W hSW
    let t_W : I.obj.obj (Opposite.op W) := hSh_I.amalgamate fam hfam_compat
    have ht_W_res : ∀ s : ι_idx, I.obj.map (in_s s).op t_W = t_x s.1 := by
      intro s
      have hmem_s : S_W.arrows (in_s s) :=
        ⟨Z_x s.1, 𝟙 (Z_x s.1), in_s s,
          CategoryTheory.Presieve.ofArrows.mk s, CategoryTheory.Category.id_comp _⟩
      have hglue : P_I.map (in_s s).op t_W = fam (in_s s) hmem_s :=
        hSh_I.valid_glue hfam_compat (in_s s) hmem_s
      have hmem_id : S_W.arrows (𝟙 (Z_x s.1) ≫ in_s s) := by
        rwa [CategoryTheory.Category.id_comp]
      have hev := hfam_eval s (𝟙 (Z_x s.1)) hmem_id
      simp only [CategoryTheory.op_id, P_I.map_id] at hev
      exact hglue.trans hev
    have hSh_Q := hIsSheafType Q S_W hSW
    have hp_tW : p.hom.app (Opposite.op W) t_W = Q.obj.map w.op q_sec := by
      refine hSh_Q.isSeparatedFor.ext (fun T f hf => ?_)
      obtain ⟨s, g, rfl⟩ := hFactor hf
      change Q.obj.map (g ≫ in_s s).op (p.hom.app (Opposite.op W) t_W) =
        Q.obj.map (g ≫ in_s s).op (Q.obj.map w.op q_sec)
      rw [CategoryTheory.op_comp, Q.obj.map_comp]
      have hnat_p := congrArg (fun m : I.obj.obj (Opposite.op W) ⟶ Q.obj.obj (Opposite.op (Z_x s.1)) =>
        m t_W) (p.hom.naturality (in_s s).op).symm
      change (p.hom.app (Opposite.op W) ≫ Q.obj.map (in_s s).op) t_W =
        (I.obj.map (in_s s).op ≫ p.hom.app (Opposite.op (Z_x s.1))) t_W at hnat_p
      change Q.obj.map g.op (Q.obj.map (in_s s).op (p.hom.app (Opposite.op W) t_W)) =
        Q.obj.map g.op (Q.obj.map (in_s s).op (Q.obj.map w.op q_sec))
      rw [show Q.obj.map (in_s s).op (p.hom.app (Opposite.op W) t_W) =
          p.hom.app (Opposite.op (Z_x s.1)) (I.obj.map (in_s s).op t_W) from hnat_p,
        ht_W_res s, ht_eq s.1]
      have hw_s : Q.obj.map (in_s s).op (Q.obj.map w.op q_sec) = Q.obj.map (z_x s.1).op q_sec := by
        rw [← hin_w s, CategoryTheory.op_comp, Q.obj.map_comp]
        rfl
      rw [hw_s]
    refine ⟨W, w, shHom W I t_W, hAffW, hSurjW, ?_⟩
    rw [h_shHom_comp W I Q p t_W, hp_tW, ← h_map_comp_shHom w Q q_sec, h_shHom_secOf U Q φ]

  
  have hEff : ∀ (q : ℕ) (U : Y.Etale),
      AlgebraicGeometry.IsAffine ((AlgebraicGeometry.Scheme.Etale.forget Y).obj U).left →
      ∀ (G : 𝒞) (ξ : CategoryTheory.Abelian.Ext.{u} (Z_sh U) G (q + 1)),
        ∃ (W : Y.Etale) (w : W ⟶ U),
          AlgebraicGeometry.IsAffine ((AlgebraicGeometry.Scheme.Etale.forget Y).obj W).left ∧
          AlgebraicGeometry.Surjective ((AlgebraicGeometry.Scheme.Etale.forget Y).map w).left ∧
          (CategoryTheory.Abelian.Ext.mk₀ (Z_sh_map w)).comp ξ (Nat.zero_add (q + 1)) = 0 := by
    intro q
    induction q with
    | zero =>
      intro U hAffU G ξ
      let I : 𝒞 := CategoryTheory.Injective.under G
      let u : G ⟶ I := CategoryTheory.Injective.ι G
      let Q : 𝒞 := CategoryTheory.Limits.cokernel u
      let p : I ⟶ Q := CategoryTheory.Limits.cokernel.π u
      have hSE : (CategoryTheory.ShortComplex.mk u p (CategoryTheory.Limits.cokernel.condition u)).ShortExact :=
        CategoryTheory.ShortComplex.ShortExact.mk'
          (CategoryTheory.ShortComplex.exact_of_g_is_cokernel _ (CategoryTheory.Limits.cokernelIsCokernel u))
          inferInstance inferInstance
      have hξu : ξ.comp (CategoryTheory.Abelian.Ext.mk₀ u) (Nat.add_zero 1) = 0 :=
        CategoryTheory.Abelian.Ext.eq_zero_of_injective _
      obtain ⟨x₃, hx₃⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ (Z_sh U) hSE ξ hξu (Nat.zero_add 1)
      obtain ⟨φ, rfl⟩ := (CategoryTheory.Abelian.Ext.mk₀_bijective (Z_sh U) Q).2 x₃
      obtain ⟨W, w, ψ, hAffW, hSurjW, hcomm⟩ := hLift0 U hAffU I Q p φ
      refine ⟨W, w, hAffW, hSurjW, ?_⟩
      rw [← hx₃,
        ← CategoryTheory.Abelian.Ext.comp_assoc
          (CategoryTheory.Abelian.Ext.mk₀ (Z_sh_map w))
          (CategoryTheory.Abelian.Ext.mk₀ φ) hSE.extClass
          (Nat.zero_add 0) (Nat.zero_add 1) (Nat.zero_add 1),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, ← hcomm,
        ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        CategoryTheory.Abelian.Ext.comp_assoc
          (CategoryTheory.Abelian.Ext.mk₀ ψ)
          (CategoryTheory.Abelian.Ext.mk₀ p) hSE.extClass
          (Nat.zero_add 0) (Nat.zero_add 1) (Nat.zero_add 1),
        hSE.comp_extClass, CategoryTheory.Abelian.Ext.comp_zero]
    | succ m ih =>
      intro U hAffU G ξ
      let I : 𝒞 := CategoryTheory.Injective.under G
      let u : G ⟶ I := CategoryTheory.Injective.ι G
      let Q : 𝒞 := CategoryTheory.Limits.cokernel u
      let p : I ⟶ Q := CategoryTheory.Limits.cokernel.π u
      have hSE : (CategoryTheory.ShortComplex.mk u p (CategoryTheory.Limits.cokernel.condition u)).ShortExact :=
        CategoryTheory.ShortComplex.ShortExact.mk'
          (CategoryTheory.ShortComplex.exact_of_g_is_cokernel _ (CategoryTheory.Limits.cokernelIsCokernel u))
          inferInstance inferInstance
      have hξu : ξ.comp (CategoryTheory.Abelian.Ext.mk₀ u) (Nat.add_zero (m + 2)) = 0 :=
        CategoryTheory.Abelian.Ext.eq_zero_of_injective _
      obtain ⟨x₃, hx₃⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ (Z_sh U) hSE ξ hξu rfl
      obtain ⟨W, w, hAffW, hSurjW, hw0⟩ := ih U hAffU Q x₃
      refine ⟨W, w, hAffW, hSurjW, ?_⟩
      rw [← hx₃,
        ← CategoryTheory.Abelian.Ext.comp_assoc
          (CategoryTheory.Abelian.Ext.mk₀ (Z_sh_map w)) x₃ hSE.extClass
          (Nat.zero_add (m + 1)) rfl (Nat.zero_add (m + 2)),
        hw0, CategoryTheory.Abelian.Ext.zero_comp]

  refine ⟨fun U hAffU G q ξ => hEff q U hAffU G ξ, ?_⟩

  
  intro W U w hAffU hAffW hSurjW

  
  let F_sch : Y.Etale ⥤ AlgebraicGeometry.Scheme.{u} :=
    AlgebraicGeometry.Scheme.Etale.forget Y ⋙ CategoryTheory.Over.forget Y
  have hAffCech : ∀ p : ℕ,
      AlgebraicGeometry.IsAffine ((AlgebraicGeometry.Scheme.Etale.forget Y).obj (weilEtaleCechObj w p)).left := by
    intro p
    induction p with
    | zero => exact hAffW
    | succ p ih =>
      change AlgebraicGeometry.IsAffine
        (F_sch.obj (CategoryTheory.Limits.pullback (weilEtaleCechHom w p) w))
      have : AlgebraicGeometry.IsAffine (F_sch.obj (weilEtaleCechObj w p)) := ih
      have : AlgebraicGeometry.IsAffine (F_sch.obj W) := hAffW
      have : AlgebraicGeometry.IsAffine (F_sch.obj U) := hAffU
      let e_pb := CategoryTheory.Limits.PreservesPullback.iso F_sch (weilEtaleCechHom w p) w
      exact AlgebraicGeometry.IsAffine.of_isIso e_pb.hom

  
  have hEpi_w : CategoryTheory.Epi (Z_sh_map w) := by
    refine ⟨fun {G} h₁ h₂ heq => ?_⟩
    let s₁ := secOf U G h₁
    let s₂ := secOf U G h₂
    have hw_s : G.obj.map w.op s₁ = G.obj.map w.op s₂ := by
      have heq' : Z_sh_map w ≫ shHom U G s₁ = Z_sh_map w ≫ shHom U G s₂ := by
        dsimp only [s₁, s₂]
        rw [h_shHom_secOf, h_shHom_secOf]
        exact heq
      rw [h_map_comp_shHom, h_map_comp_shHom] at heq'
      have hsec := congrArg (secOf W G) heq'
      dsimp only [secOf, shHom] at hsec
      rw [Equiv.apply_symm_apply, Equiv.apply_symm_apply] at hsec
      change FreeAbelianGroup.lift (fun g : W ⟶ W => G.obj.map g.op (G.obj.map w.op s₁))
          (FreeAbelianGroup.of (𝟙 W)) =
        FreeAbelianGroup.lift (fun g : W ⟶ W => G.obj.map g.op (G.obj.map w.op s₂))
          (FreeAbelianGroup.of (𝟙 W)) at hsec
      rw [FreeAbelianGroup.lift_apply_of, FreeAbelianGroup.lift_apply_of,
        CategoryTheory.op_id, G.obj.map_id] at hsec
      exact hsec
    have : AlgebraicGeometry.Etale U.hom := U.prop
    have hw_comp_et : AlgebraicGeometry.Etale (w.left ≫ U.hom) :=
      Eq.mp (congrArg AlgebraicGeometry.Etale (CategoryTheory.MorphismProperty.Over.w w).symm) W.prop
    have hEt_w : AlgebraicGeometry.Etale w.left :=
      CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
        w.left U.hom U.prop hw_comp_et
    let S_w : CategoryTheory.Sieve U :=
      CategoryTheory.Sieve.generate (CategoryTheory.Presieve.singleton w)
    have hSw_pre : S_w ∈ Y.smallEtalePretopology.toGrothendieck U := by
      refine (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) (S := Y) U S_w).mpr
        (fun x => ?_)
      obtain ⟨y, hy⟩ := hSurjW.surj x
      refine ⟨W, w, y, ?_, hEt_w, hy⟩
      exact ⟨W, 𝟙 W, w, CategoryTheory.Presieve.singleton.mk, CategoryTheory.Category.id_comp w⟩
    have hSw : S_w ∈ Y.smallEtaleTopology U := heq_top ▸ hSw_pre
    have hSh_G := hIsSheafType G S_w hSw
    have hs_eq : s₁ = s₂ := by
      refine hSh_G.isSeparatedFor.ext (fun T f hf => ?_)
      obtain ⟨_, g, _, ⟨⟩, rfl⟩ := hf
      change G.obj.map (g ≫ w).op s₁ = G.obj.map (g ≫ w).op s₂
      rw [CategoryTheory.op_comp, G.obj.map_comp]
      exact congrArg (G.obj.map g.op) hw_s
    rw [← h_shHom_secOf U G h₁, ← h_shHom_secOf U G h₂]
    exact congrArg (shHom U G) hs_eq

  
  have hproj_last : ∀ p : ℕ,
      weilEtaleCechProj w (p + 1) (Fin.last (p + 1)) =
        CategoryTheory.Limits.pullback.snd (weilEtaleCechHom w p) w := by
    intro p
    dsimp only [weilEtaleCechProj, weilEtaleCechProjSub]
    rw [Fin.lastCases_last]

  have hproj_cast : ∀ (p : ℕ) (j : Fin (p + 1)),
      weilEtaleCechProj w (p + 1) j.castSucc =
        CategoryTheory.Limits.pullback.fst (weilEtaleCechHom w p) w ≫ weilEtaleCechProj w p j := by
    intro p j
    dsimp only [weilEtaleCechProj, weilEtaleCechProjSub]
    rw [Fin.lastCases_castSucc]
    rfl

  have cechLift_proj : ∀ {Z : Y.Etale} (h : Z ⟶ U) (p : ℕ) (g : Fin (p + 1) → (Z ⟶ W))
      (hg : ∀ i, g i ≫ w = h) (i : Fin (p + 1)),
      (weilEtaleCechLiftSub w h p g hg).1 ≫ weilEtaleCechProj w p i = g i := by
    intro Z h p
    induction p with
    | zero =>
      intro g hg i
      obtain rfl : i = 0 := Fin.eq_zero i
      exact CategoryTheory.Category.comp_id (g 0)
    | succ p ih =>
      intro g hg i
      refine Fin.lastCases ?_ (fun j => ?_) i
      · rw [hproj_last]
        exact CategoryTheory.Limits.pullback.lift_snd _ _ _
      · rw [hproj_cast]
        exact (CategoryTheory.Limits.pullback.lift_fst_assoc _ _ _ _).trans
          (ih (fun k => g k.castSucc) (fun k => hg k.castSucc) j)

  have cechObj_hom_ext : ∀ {Z : Y.Etale} {p : ℕ} {l₁ l₂ : Z ⟶ weilEtaleCechObj w p},
      (∀ i : Fin (p + 1), l₁ ≫ weilEtaleCechProj w p i = l₂ ≫ weilEtaleCechProj w p i) →
      l₁ = l₂ := by
    intro Z p
    induction p with
    | zero =>
      intro l₁ l₂ h
      have h0 : l₁ ≫ 𝟙 (weilEtaleCechObj w 0) = l₂ ≫ 𝟙 (weilEtaleCechObj w 0) := h 0
      rwa [CategoryTheory.Category.comp_id, CategoryTheory.Category.comp_id] at h0
    | succ p ih =>
      intro l₁ l₂ h
      apply CategoryTheory.Limits.pullback.hom_ext
      · refine ih (fun j => ?_)
        have hj := h j.castSucc
        rw [hproj_cast] at hj
        exact (CategoryTheory.Category.assoc l₁ _ _).trans
          (hj.trans (CategoryTheory.Category.assoc l₂ _ _).symm)
      · have hlast := h (Fin.last (p + 1))
        rwa [hproj_last] at hlast

  have cechFace_proj : ∀ (p : ℕ) (j : Fin (p + 2)) (i : Fin (p + 1)),
      weilEtaleCechFace w p j ≫ weilEtaleCechProj w p i =
        weilEtaleCechProj w (p + 1) (j.succAbove i) :=
    fun p j i => cechLift_proj (weilEtaleCechHom w (p + 1)) p _ _ i

  have cechFace_hom : ∀ (p : ℕ) (j : Fin (p + 2)),
      weilEtaleCechFace w p j ≫ weilEtaleCechHom w p = weilEtaleCechHom w (p + 1) :=
    fun p j => (weilEtaleCechLiftSub w (weilEtaleCechHom w (p + 1)) p
      (fun i => weilEtaleCechProj w (p + 1) (j.succAbove i))
      (fun i => (weilEtaleCechProjSub w (p + 1) (j.succAbove i)).2)).2

  have cechFace_comp : ∀ (m : ℕ) (a b : Fin (m + 2)), a ≤ b →
      weilEtaleCechFace w (m + 1) b.succ ≫ weilEtaleCechFace w m a =
        weilEtaleCechFace w (m + 1) a.castSucc ≫ weilEtaleCechFace w m b := by
    intro m a b hab
    have hab' : (a : ℕ) ≤ (b : ℕ) := hab
    apply cechObj_hom_ext
    intro i
    rw [CategoryTheory.Category.assoc, cechFace_proj, cechFace_proj,
      CategoryTheory.Category.assoc, cechFace_proj, cechFace_proj]
    congr 1
    ext
    simp only [Fin.succAbove, Fin.lt_def, Fin.val_succ, Fin.val_castSucc]
    split_ifs <;> simp only [Fin.val_succ, Fin.val_castSucc] at * <;> omega

  
  have hom_sum_apply : ∀ {A B : AddCommGrpCat.{u}} {ι : Type} (s : Finset ι)
      (f : ι → (A ⟶ B)) (x : A),
      (∑ i ∈ s, f i) x = ∑ i ∈ s, (f i) x := by
    intro A B ι s f x
    classical
    induction s using Finset.induction_on with
    | empty => rfl
    | insert a s ha ih =>
      rw [Finset.sum_insert ha, Finset.sum_insert ha]
      exact congrArg ((f a) x + ·) ih

  have hom_zsmul_apply : ∀ {A B : AddCommGrpCat.{u}} (n : ℤ) (f : A ⟶ B) (x : A),
      (n • f) x = n • (f x) := fun _ _ _ => rfl

  let ε_psh : Z_psh (weilEtaleCechObj w 0) ⟶ Z_psh U := Z_psh_map (weilEtaleCechHom w 0)
  let d_psh : ∀ p : ℕ, Z_psh (weilEtaleCechObj w (p + 1)) ⟶ Z_psh (weilEtaleCechObj w p) :=
    fun p => ∑ j : Fin (p + 2), (-1 : ℤ) ^ (j : ℕ) • Z_psh_map (weilEtaleCechFace w p j)

  have d_psh_apply_of : ∀ (p : ℕ) (T : (Y.Etale)ᵒᵖ)
      (g : Opposite.unop T ⟶ weilEtaleCechObj w (p + 1)),
      ((d_psh p).app T) (of_psh g) =
        ∑ j : Fin (p + 2), (-1 : ℤ) ^ (j : ℕ) •
          of_psh (g ≫ weilEtaleCechFace w p j) := by
    intro p T g
    dsimp only [d_psh]
    rw [CategoryTheory.NatTrans.app_sum]
    refine (hom_sum_apply Finset.univ
      (fun j : Fin (p + 2) => ((-1 : ℤ) ^ (j : ℕ) • Z_psh_map (weilEtaleCechFace w p j)).app T)
      (of_psh g)).trans ?_
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [CategoryTheory.NatTrans.app_zsmul, hom_zsmul_apply]
    congr 1

  have hd₀ : d_psh 0 ≫ ε_psh = 0 := by
    ext T : 2
    refine z_psh_hom_ext _ _ fun g => ?_
    change (ε_psh.app T) (((d_psh 0).app T) (of_psh g)) = 0
    rw [d_psh_apply_of 0 T g, Fin.sum_univ_two, Fin.val_zero, Fin.val_one,
      pow_zero, pow_one, one_smul, neg_one_smul]
    change (FreeAbelianGroup.map fun h : Opposite.unop T ⟶ weilEtaleCechObj w 0 =>
        h ≫ weilEtaleCechHom w 0)
      (FreeAbelianGroup.of (g ≫ weilEtaleCechFace w 0 0) +
       -FreeAbelianGroup.of (g ≫ weilEtaleCechFace w 0 1)) = 0
    rw [map_add, map_neg, FreeAbelianGroup.map_of_apply, FreeAbelianGroup.map_of_apply,
      CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
      cechFace_hom 0 0, cechFace_hom 0 1, add_neg_cancel]

  have hd_succ : ∀ m : ℕ, d_psh (m + 1) ≫ d_psh m = 0 := by
    intro m
    ext T : 2
    refine z_psh_hom_ext _ _ fun g => ?_
    change ((d_psh m).app T).hom (((d_psh (m + 1)).app T) (of_psh g)) = 0
    rw [d_psh_apply_of (m + 1) T g, map_sum]
    simp_rw [map_zsmul]
    have h_inner : ∀ j : Fin (m + 3),
        (-1 : ℤ) ^ (j : ℕ) • ((d_psh m).app T).hom
          (of_psh (g ≫ weilEtaleCechFace w (m + 1) j)) =
        ∑ k : Fin (m + 2), ((-1 : ℤ) ^ (j : ℕ) * (-1 : ℤ) ^ (k : ℕ)) •
          of_psh (g ≫ weilEtaleCechFace w (m + 1) j ≫ weilEtaleCechFace w m k) := by
      intro j
      change (-1 : ℤ) ^ (j : ℕ) • (((d_psh m).app T)
        (of_psh (g ≫ weilEtaleCechFace w (m + 1) j))) = _
      rw [d_psh_apply_of m T (g ≫ weilEtaleCechFace w (m + 1) j), Finset.smul_sum]
      refine Finset.sum_congr rfl (fun k _ => ?_)
      rw [smul_smul, CategoryTheory.Category.assoc]
    simp_rw [h_inner]
    let term : Fin (m + 3) × Fin (m + 2) → (Z_psh (weilEtaleCechObj w m)).obj T :=
      fun p => ((-1 : ℤ) ^ (p.1 : ℕ) * (-1 : ℤ) ^ (p.2 : ℕ)) •
        of_psh (g ≫ weilEtaleCechFace w (m + 1) p.1 ≫ weilEtaleCechFace w m p.2)
    change ∑ j : Fin (m + 3), ∑ k : Fin (m + 2), term (j, k) = 0
    rw [← Fintype.sum_prod_type]
    change ∑ p ∈ (Finset.univ : Finset (Fin (m + 3) × Fin (m + 2))), term p = 0
    rw [← Finset.sum_filter_add_sum_filter_not
      (Finset.univ : Finset (Fin (m + 3) × Fin (m + 2)))
      (fun p => (p.2 : ℕ) < (p.1 : ℕ))]
    let S_le : Finset (Fin (m + 2) × Fin (m + 2)) :=
      Finset.univ.filter (fun q => q.1 ≤ q.2)
    have h_lt : ∑ p ∈ Finset.univ.filter (fun p : Fin (m + 3) × Fin (m + 2) => (p.2 : ℕ) < (p.1 : ℕ)),
        term p = ∑ q ∈ S_le, term (q.2.succ, q.1) := by
      symm
      refine Finset.sum_bij (fun q _ => (q.2.succ, q.1)) ?_ ?_ ?_ (fun _ _ => rfl)
      · intro q hq
        rw [Finset.mem_filter] at hq ⊢
        refine ⟨Finset.mem_univ _, ?_⟩
        have hle : (q.1 : ℕ) ≤ (q.2 : ℕ) := hq.2
        simp only [Fin.val_succ]
        omega
      · intro q₁ _ q₂ _ heq
        injection heq with h2 h1
        exact Prod.ext h1 (Fin.succ_injective _ h2)
      · intro p hp
        rw [Finset.mem_filter] at hp
        have hj0 : p.1 ≠ 0 := by
          intro h0
          rw [h0] at hp
          exact Nat.not_lt_zero _ hp.2
        refine ⟨(p.2, p.1.pred hj0), ?_, ?_⟩
        · rw [Finset.mem_filter]
          refine ⟨Finset.mem_univ _, ?_⟩
          rw [Fin.le_def, Fin.val_pred]
          exact Nat.le_pred_of_lt hp.2
        · exact Prod.ext (Fin.succ_pred p.1 hj0) rfl
    have h_ge : ∑ p ∈ Finset.univ.filter (fun p : Fin (m + 3) × Fin (m + 2) => ¬ (p.2 : ℕ) < (p.1 : ℕ)),
        term p = ∑ q ∈ S_le, term (q.1.castSucc, q.2) := by
      symm
      refine Finset.sum_bij (fun q _ => (q.1.castSucc, q.2)) ?_ ?_ ?_ (fun _ _ => rfl)
      · intro q hq
        rw [Finset.mem_filter] at hq ⊢
        refine ⟨Finset.mem_univ _, ?_⟩
        have hle : (q.1 : ℕ) ≤ (q.2 : ℕ) := hq.2
        simp only [Fin.val_castSucc]
        omega
      · intro q₁ _ q₂ _ heq
        injection heq with h1 h2
        exact Prod.ext (Fin.castSucc_injective _ h1) h2
      · intro p hp
        rw [Finset.mem_filter] at hp
        have hj_lt : (p.1 : ℕ) < m + 2 := by
          have hk := p.2.isLt
          omega
        have hj_last : p.1 ≠ Fin.last (m + 2) := by
          intro hl
          rw [hl, Fin.val_last] at hj_lt
          exact Nat.lt_irrefl _ hj_lt
        refine ⟨(p.1.castPred hj_last, p.2), ?_, ?_⟩
        · rw [Finset.mem_filter]
          refine ⟨Finset.mem_univ _, ?_⟩
          dsimp only
          rw [Fin.le_def, Fin.coe_castPred]
          omega
        · exact Prod.ext (Fin.castSucc_castPred p.1 hj_last) rfl
    rw [h_lt, h_ge, ← Finset.sum_add_distrib]
    refine Finset.sum_eq_zero (fun q hq => ?_)
    have hle : q.1 ≤ q.2 := (Finset.mem_filter.mp hq).2
    dsimp only [term]
    rw [cechFace_comp m q.1 q.2 hle, ← add_smul]
    have hsign : (-1 : ℤ) ^ (q.2.succ : ℕ) * (-1 : ℤ) ^ (q.1 : ℕ) +
        (-1 : ℤ) ^ (q.1.castSucc : ℕ) * (-1 : ℤ) ^ (q.2 : ℕ) = 0 := by
      simp only [Fin.val_succ, Fin.val_castSucc, pow_succ]
      ring
    rw [hsign, zero_smul]

  
  have exact_of_app_ker_le_range :
      ∀ (S : CategoryTheory.ShortComplex ((Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u})),
        (∀ (T : (Y.Etale)ᵒᵖ) (z : S.X₂.obj T),
          S.g.app T z = 0 → ∃ x : S.X₁.obj T, S.f.app T x = z) →
        S.Exact := by
    intro S hpt
    rw [CategoryTheory.ShortComplex.exact_iff_kernel_ι_comp_cokernel_π_zero]
    ext T : 2
    let ev := (CategoryTheory.evaluation (Y.Etale)ᵒᵖ AddCommGrpCat.{u}).obj T
    have hEx_T : (S.map ev).Exact := by
      rw [CategoryTheory.ShortComplex.ab_exact_iff_ker_le_range]
      intro z hz
      exact hpt T z hz
    have hkc_T : CategoryTheory.Limits.kernel.ι (S.g.app T) ≫
        CategoryTheory.Limits.cokernel.π (S.f.app T) = 0 :=
      (CategoryTheory.ShortComplex.exact_iff_kernel_ι_comp_cokernel_π_zero (S.map ev)).mp hEx_T
    have hk_cond : (CategoryTheory.Limits.kernel.ι S.g).app T ≫ S.g.app T = 0 := by
      rw [← CategoryTheory.NatTrans.comp_app, CategoryTheory.Limits.kernel.condition,
        CategoryTheory.NatTrans.app_zero]
    have hc_cond : S.f.app T ≫ (CategoryTheory.Limits.cokernel.π S.f).app T = 0 := by
      rw [← CategoryTheory.NatTrans.comp_app, CategoryTheory.Limits.cokernel.condition,
        CategoryTheory.NatTrans.app_zero]
    let l_k := CategoryTheory.Limits.kernel.lift (S.g.app T)
      ((CategoryTheory.Limits.kernel.ι S.g).app T) hk_cond
    let d_c := CategoryTheory.Limits.cokernel.desc (S.f.app T)
      ((CategoryTheory.Limits.cokernel.π S.f).app T) hc_cond
    have hk_fac : (CategoryTheory.Limits.kernel.ι S.g).app T =
        l_k ≫ CategoryTheory.Limits.kernel.ι (S.g.app T) :=
      (CategoryTheory.Limits.kernel.lift_ι _ _ _).symm
    have hc_fac : (CategoryTheory.Limits.cokernel.π S.f).app T =
        CategoryTheory.Limits.cokernel.π (S.f.app T) ≫ d_c :=
      (CategoryTheory.Limits.cokernel.π_desc _ _ _).symm
    change (CategoryTheory.Limits.kernel.ι S.g).app T ≫
      (CategoryTheory.Limits.cokernel.π S.f).app T = 0
    rw [hk_fac, hc_fac, CategoryTheory.Category.assoc,
      ← CategoryTheory.Category.assoc (CategoryTheory.Limits.kernel.ι (S.g.app T)) _ _,
      hkc_T, CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.comp_zero]

  
  let pick : ∀ {T₀ : Y.Etale} (y : T₀ ⟶ U),
      Nonempty { f : T₀ ⟶ W // f ≫ w = y } → (T₀ ⟶ W) :=
    fun _ h => (Classical.choice h).1
  have pick_spec : ∀ {T₀ : Y.Etale} (y : T₀ ⟶ U)
      (h : Nonempty { f : T₀ ⟶ W // f ≫ w = y }), pick y h ≫ w = y :=
    fun _ h => (Classical.choice h).2
  have pick_congr : ∀ {T₀ : Y.Etale} {y₁ y₂ : T₀ ⟶ U} (hy : y₁ = y₂)
      (h₁ : Nonempty { f : T₀ ⟶ W // f ≫ w = y₁ })
      (h₂ : Nonempty { f : T₀ ⟶ W // f ≫ w = y₂ }),
      pick y₁ h₁ = pick y₂ h₂ := by
    intro T₀ y₁ y₂ hy h₁ h₂
    subst hy
    rfl

  let h_fib_ne : ∀ {T₀ : Y.Etale} (p : ℕ) (g : T₀ ⟶ weilEtaleCechObj w p),
      Nonempty { f : T₀ ⟶ W // f ≫ w = g ≫ weilEtaleCechHom w p } :=
    fun p g => ⟨⟨g ≫ weilEtaleCechProj w p 0,
      by rw [CategoryTheory.Category.assoc, (weilEtaleCechProjSub w p 0).2]⟩⟩

  let prepend : ∀ {T₀ : Y.Etale} (p : ℕ) (g : T₀ ⟶ weilEtaleCechObj w p),
      T₀ ⟶ weilEtaleCechObj w (p + 1) :=
    fun p g =>
      (weilEtaleCechLiftSub w (g ≫ weilEtaleCechHom w p) (p + 1)
        (Fin.cases (pick (g ≫ weilEtaleCechHom w p) (h_fib_ne p g))
          (fun i => g ≫ weilEtaleCechProj w p i))
        (fun k => Fin.cases
          (by rw [Fin.cases_zero]; exact pick_spec (g ≫ weilEtaleCechHom w p) (h_fib_ne p g))
          (fun i => by
            rw [Fin.cases_succ, CategoryTheory.Category.assoc, (weilEtaleCechProjSub w p i).2]) k)).1

  have prepend_face_zero : ∀ {T₀ : Y.Etale} (p : ℕ) (g : T₀ ⟶ weilEtaleCechObj w p),
      prepend p g ≫ weilEtaleCechFace w p 0 = g := by
    intro T₀ p g
    apply cechObj_hom_ext
    intro i
    rw [CategoryTheory.Category.assoc, cechFace_proj, Fin.succAbove_zero]
    dsimp only [prepend]
    rw [cechLift_proj, Fin.cases_succ]

  have hEx_psh₀ : (CategoryTheory.ShortComplex.mk (d_psh 0) ε_psh hd₀).Exact := by
    refine exact_of_app_ker_le_range _ (fun T z hz => ?_)
    let T₀ := Opposite.unop T
    let σ : (Z_psh U).obj T ⟶ (Z_psh (weilEtaleCechObj w 0)).obj T :=
      AddCommGrpCat.ofHom (FreeAbelianGroup.lift (fun y : T₀ ⟶ U =>
        @dite _ (Nonempty { f : T₀ ⟶ W // f ≫ w = y }) (Classical.propDecidable _)
          (fun h => of_psh (show T₀ ⟶ weilEtaleCechObj w 0 from pick y h)) (fun _ => 0)))
    let s₀ : (Z_psh (weilEtaleCechObj w 0)).obj T ⟶ (Z_psh (weilEtaleCechObj w 1)).obj T :=
      AddCommGrpCat.ofHom (FreeAbelianGroup.lift
        (fun g : T₀ ⟶ weilEtaleCechObj w 0 => of_psh (prepend 0 g)))
    have h_homotopy₀ :
        s₀ ≫ (d_psh 0).app T + ε_psh.app T ≫ σ = 𝟙 ((Z_psh (weilEtaleCechObj w 0)).obj T) := by
      refine z_psh_hom_ext _ _ (fun g => ?_)
      change ((d_psh 0).app T) (s₀ (of_psh g)) +
        σ ((ε_psh.app T) (of_psh g)) = of_psh g
      have hs₀_of : s₀ (of_psh g) = of_psh (prepend 0 g) :=
        FreeAbelianGroup.lift_apply_of _ g
      rw [hs₀_of, d_psh_apply_of 0 T (prepend 0 g), Fin.sum_univ_two]
      let p₀ : T₀ ⟶ weilEtaleCechObj w 0 := pick (g ≫ weilEtaleCechHom w 0) (h_fib_ne 0 g)
      have hface0 : prepend 0 g ≫ weilEtaleCechFace w 0 0 = g := prepend_face_zero 0 g
      have hface1 : prepend 0 g ≫ weilEtaleCechFace w 0 1 = p₀ := by
        apply cechObj_hom_ext
        intro i
        obtain rfl : i = 0 := Fin.eq_zero i
        rw [CategoryTheory.Category.assoc, cechFace_proj]
        have hsa : (1 : Fin 2).succAbove 0 = 0 := rfl
        rw [hsa]
        dsimp only [prepend, p₀]
        rw [cechLift_proj, Fin.cases_zero]
        exact (CategoryTheory.Category.comp_id _).symm
      have hσ : σ ((ε_psh.app T) (of_psh g)) = of_psh p₀ := by
        have hmap : (ε_psh.app T) (of_psh g) = of_psh (g ≫ weilEtaleCechHom w 0) :=
          FreeAbelianGroup.map_of_apply g
        rw [hmap]
        exact (FreeAbelianGroup.lift_apply_of _ (g ≫ weilEtaleCechHom w 0)).trans
          (dite_cond_eq_true (eq_true (h_fib_ne 0 g)))
      rw [hface0, hface1, hσ, Fin.val_zero, Fin.val_one,
        pow_zero, pow_one, one_smul, neg_one_smul, add_assoc, neg_add_cancel, add_zero]
    refine ⟨s₀ z, ?_⟩
    have hid := congrArg
      (fun m : (Z_psh (weilEtaleCechObj w 0)).obj T ⟶ (Z_psh (weilEtaleCechObj w 0)).obj T => m z)
      h_homotopy₀
    change ((d_psh 0).app T) (s₀ z) + σ ((ε_psh.app T) z) = z at hid
    rw [hz, map_zero, add_zero] at hid
    exact hid

  have hEx_psh_succ : ∀ m : ℕ,
      (CategoryTheory.ShortComplex.mk (d_psh (m + 1)) (d_psh m) (hd_succ m)).Exact := by
    intro m
    refine exact_of_app_ker_le_range _ (fun T z hz => ?_)
    let T₀ := Opposite.unop T
    let s_m : (Z_psh (weilEtaleCechObj w m)).obj T ⟶
        (Z_psh (weilEtaleCechObj w (m + 1))).obj T :=
      AddCommGrpCat.ofHom (FreeAbelianGroup.lift
        (fun f : T₀ ⟶ weilEtaleCechObj w m => of_psh (prepend m f)))
    let s_m1 : (Z_psh (weilEtaleCechObj w (m + 1))).obj T ⟶
        (Z_psh (weilEtaleCechObj w (m + 2))).obj T :=
      AddCommGrpCat.ofHom (FreeAbelianGroup.lift
        (fun g : T₀ ⟶ weilEtaleCechObj w (m + 1) => of_psh (prepend (m + 1) g)))
    have h_homotopy_m :
        s_m1 ≫ (d_psh (m + 1)).app T + (d_psh m).app T ≫ s_m =
          𝟙 ((Z_psh (weilEtaleCechObj w (m + 1))).obj T) := by
      refine z_psh_hom_ext _ _ (fun g => ?_)
      change ((d_psh (m + 1)).app T) (s_m1 (of_psh g)) +
        s_m (((d_psh m).app T) (of_psh g)) = of_psh g
      have hs_m1_of : s_m1 (of_psh g) = of_psh (prepend (m + 1) g) :=
        FreeAbelianGroup.lift_apply_of _ g
      rw [hs_m1_of, d_psh_apply_of (m + 1) T (prepend (m + 1) g),
        Fin.sum_univ_succ, prepend_face_zero (m + 1) g, Fin.val_zero, pow_zero, one_smul]
      have hface_succ : ∀ k : Fin (m + 2),
          prepend (m + 1) g ≫ weilEtaleCechFace w (m + 1) k.succ =
            prepend m (g ≫ weilEtaleCechFace w m k) := by
        intro k
        apply cechObj_hom_ext
        intro i
        rw [CategoryTheory.Category.assoc, cechFace_proj]
        refine Fin.cases ?_ (fun l => ?_) i
        · rw [Fin.succ_succAbove_zero]
          dsimp only [prepend]
          rw [cechLift_proj, cechLift_proj, Fin.cases_zero, Fin.cases_zero]
          refine pick_congr ?_ _ _
          rw [CategoryTheory.Category.assoc, cechFace_hom m k]
        · rw [Fin.succ_succAbove_succ]
          dsimp only [prepend]
          rw [cechLift_proj, cechLift_proj, Fin.cases_succ, Fin.cases_succ,
            CategoryTheory.Category.assoc, cechFace_proj]
      have hsum_succ : (∑ k : Fin (m + 2), (-1 : ℤ) ^ (k.succ : ℕ) •
          of_psh (prepend (m + 1) g ≫ weilEtaleCechFace w (m + 1) k.succ)) =
          - s_m (((d_psh m).app T) (of_psh g)) := by
        change _ = - s_m.hom (((d_psh m).app T) (of_psh g))
        rw [d_psh_apply_of m T g, map_sum, ← Finset.sum_neg_distrib]
        refine Finset.sum_congr rfl (fun k _ => ?_)
        rw [hface_succ k, map_zsmul]
        have hs_m_of : s_m.hom (of_psh (g ≫ weilEtaleCechFace w m k)) =
            of_psh (prepend m (g ≫ weilEtaleCechFace w m k)) :=
          FreeAbelianGroup.lift_apply_of _ _
        rw [hs_m_of, Fin.val_succ, pow_succ, mul_neg_one, neg_smul]
      rw [hsum_succ, add_assoc, neg_add_cancel, add_zero]
    refine ⟨s_m1 z, ?_⟩
    have hid := congrArg
      (fun f : (Z_psh (weilEtaleCechObj w (m + 1))).obj T ⟶
        (Z_psh (weilEtaleCechObj w (m + 1))).obj T => f z) h_homotopy_m
    change ((d_psh (m + 1)).app T) (s_m1 z) + s_m (((d_psh m).app T) z) = z at hid
    rw [hz, map_zero, add_zero] at hid
    exact hid

  
  let C_sh : ℕ → 𝒞 := fun p => Z_sh (weilEtaleCechObj w p)
  let ε_sh : C_sh 0 ⟶ Z_sh U := L.map ε_psh
  let d_sh : ∀ p : ℕ, C_sh (p + 1) ⟶ C_sh p := fun p => L.map (d_psh p)
  have hd_sh₀ : d_sh 0 ≫ ε_sh = 0 := by
    dsimp only [d_sh, ε_sh]
    rw [← L.map_comp, hd₀, L.map_zero]
  have hd_sh_succ : ∀ m : ℕ, d_sh (m + 1) ≫ d_sh m = 0 := by
    intro m
    dsimp only [d_sh]
    rw [← L.map_comp, hd_succ m, L.map_zero]
  have hEx_sh₀ : (CategoryTheory.ShortComplex.mk (d_sh 0) ε_sh hd_sh₀).Exact :=
    hEx_psh₀.map L
  have hEx_sh_succ : ∀ m : ℕ,
      (CategoryTheory.ShortComplex.mk (d_sh (m + 1)) (d_sh m) (hd_sh_succ m)).Exact :=
    fun m => (hEx_psh_succ m).map L

  let K : ℕ → 𝒞 := fun n =>
    match n with
    | 0 => Z_sh U
    | p + 1 => CategoryTheory.Limits.image (d_sh p)
  let f_im : ∀ p : ℕ, K (p + 1) ⟶ C_sh p :=
    fun p => CategoryTheory.Limits.image.ι (d_sh p)
  let e_im : ∀ p : ℕ, C_sh (p + 1) ⟶ K (p + 1) :=
    fun p => CategoryTheory.Limits.factorThruImage (d_sh p)
  have hf_mono : ∀ p : ℕ, CategoryTheory.Mono (f_im p) :=
    fun p => by dsimp only [f_im]; infer_instance
  have he_epi : ∀ p : ℕ, CategoryTheory.Epi (e_im p) :=
    fun p => by dsimp only [e_im]; infer_instance
  have h_im_fac : ∀ p : ℕ, e_im p ≫ f_im p = d_sh p :=
    fun p => CategoryTheory.Limits.image.fac (d_sh p)

  have h₀ : f_im 0 ≫ ε_sh = 0 := by
    have := he_epi 0
    apply (CategoryTheory.cancel_epi (e_im 0)).mp
    rw [CategoryTheory.Limits.comp_zero, ← CategoryTheory.Category.assoc, h_im_fac 0, hd_sh₀]

  have hSE₀ : (CategoryTheory.ShortComplex.mk (f_im 0) ε_sh h₀).ShortExact := by
    have := hf_mono 0
    have := he_epi 0
    let S_raw₀ := CategoryTheory.ShortComplex.mk (d_sh 0) ε_sh hd_sh₀
    let S₀ := CategoryTheory.ShortComplex.mk (f_im 0) ε_sh h₀
    let φ₀ : S_raw₀ ⟶ S₀ :=
      { τ₁ := e_im 0
        τ₂ := 𝟙 (C_sh 0)
        τ₃ := 𝟙 (Z_sh U)
        comm₁₂ := by
          dsimp only [S_raw₀, S₀]
          rw [CategoryTheory.Category.comp_id, h_im_fac 0]
        comm₂₃ := by
          dsimp only [S_raw₀, S₀]
          rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp] }
    have : CategoryTheory.Epi φ₀.τ₁ := he_epi 0
    have hEx₀ : S₀.Exact :=
      (CategoryTheory.ShortComplex.exact_iff_of_epi_of_isIso_of_mono φ₀).mp hEx_sh₀
    have hEpi_ε : CategoryTheory.Epi ε_sh := hEpi_w
    exact CategoryTheory.ShortComplex.ShortExact.mk' hEx₀ (hf_mono 0) hEpi_ε

  refine ⟨K, f_im 0, h₀, hSE₀, hAffCech, fun p => ?_⟩
  cases p with
  | zero =>
    exact ⟨f_im 0, ε_sh, h₀, e_im 0, he_epi 0, hSE₀⟩
  | succ m =>
    have := hf_mono m
    have := hf_mono (m + 1)
    have := he_epi m
    have := he_epi (m + 1)
    have hfg_m : f_im (m + 1) ≫ e_im m = 0 := by
      apply (CategoryTheory.cancel_mono (f_im m)).mp
      apply (CategoryTheory.cancel_epi (e_im (m + 1))).mp
      rw [CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.comp_zero,
        CategoryTheory.Category.assoc, h_im_fac m,
        ← CategoryTheory.Category.assoc, h_im_fac (m + 1), hd_sh_succ m]
    have hdm_zero : f_im (m + 1) ≫ d_sh m = 0 := by
      apply (CategoryTheory.cancel_epi (e_im (m + 1))).mp
      rw [CategoryTheory.Limits.comp_zero, ← CategoryTheory.Category.assoc,
        h_im_fac (m + 1), hd_sh_succ m]
    let S_raw := CategoryTheory.ShortComplex.mk (d_sh (m + 1)) (d_sh m) (hd_sh_succ m)
    let S_mid := CategoryTheory.ShortComplex.mk (f_im (m + 1)) (d_sh m) hdm_zero
    let S_syz := CategoryTheory.ShortComplex.mk (f_im (m + 1)) (e_im m) hfg_m
    let ψ₁ : S_raw ⟶ S_mid :=
      { τ₁ := e_im (m + 1)
        τ₂ := 𝟙 (C_sh (m + 1))
        τ₃ := 𝟙 (C_sh m)
        comm₁₂ := by
          dsimp only [S_raw, S_mid]
          rw [CategoryTheory.Category.comp_id, h_im_fac (m + 1)]
        comm₂₃ := by
          dsimp only [S_raw, S_mid]
          rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp] }
    let ψ₂ : S_syz ⟶ S_mid :=
      { τ₁ := 𝟙 (K (m + 2))
        τ₂ := 𝟙 (C_sh (m + 1))
        τ₃ := f_im m
        comm₁₂ := by
          dsimp only [S_syz, S_mid]
          rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
        comm₂₃ := by
          dsimp only [S_syz, S_mid]
          rw [CategoryTheory.Category.id_comp, h_im_fac m] }
    have : CategoryTheory.Epi ψ₁.τ₁ := he_epi (m + 1)
    have : CategoryTheory.Mono ψ₂.τ₃ := hf_mono m
    have hEx_mid : S_mid.Exact :=
      (CategoryTheory.ShortComplex.exact_iff_of_epi_of_isIso_of_mono ψ₁).mp (hEx_sh_succ m)
    have hEx_syz : S_syz.Exact :=
      (CategoryTheory.ShortComplex.exact_iff_of_epi_of_isIso_of_mono ψ₂).mpr hEx_mid
    exact ⟨f_im (m + 1), e_im m, hfg_m, e_im (m + 1), he_epi (m + 1),
      CategoryTheory.ShortComplex.ShortExact.mk' hEx_syz (hf_mono (m + 1)) (he_epi m)⟩

theorem weil_etale_two_chart_filtered_colimit_cohomology_transfer {Z₀ Z : AlgebraicGeometry.Scheme.{u}} (h : Z₀ ⟶ Z)
    (hCov_Z : ∃ (W₀ W₁ : Z.Opens),
      W₀ ⊔ W₁ = ⊤ ∧
      AlgebraicGeometry.IsAffineOpen W₀ ∧
      AlgebraicGeometry.IsAffineOpen W₁ ∧
      AlgebraicGeometry.IsAffineOpen (W₀ ⊓ W₁))
    (hCov_Z₀ : ∃ (W₀ W₁ : Z₀.Opens),
      W₀ ⊔ W₁ = ⊤ ∧
      AlgebraicGeometry.IsAffineOpen W₀ ∧
      AlgebraicGeometry.IsAffineOpen W₁ ∧
      AlgebraicGeometry.IsAffineOpen (W₀ ⊓ W₁)) :
    (∀ (Λ : Type u) [CategoryTheory.SmallCategory Λ] [CategoryTheory.IsFiltered Λ]
        (D : CategoryTheory.Functor Λ (CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}))
        (c : CategoryTheory.Limits.Cocone D),
      Nonempty (CategoryTheory.Limits.IsColimit c) →
      ∀ (q : ℕ),
        (∀ l : Λ, WeilEtaleCohomologyPullbackBijective h (D.obj l) q) →
        WeilEtaleCohomologyPullbackBijective h c.pt q) ∧
    (∀ (m : ℕ) (P : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u} → Prop),
      (∀ (E : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}),
        m • CategoryTheory.CategoryStruct.id E = 0 →
        ∃ (Λ : Type u) (_ : CategoryTheory.SmallCategory Λ) (_ : CategoryTheory.IsFiltered Λ)
          (D : CategoryTheory.Functor Λ (CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}))
          (c : CategoryTheory.Limits.Cocone D),
          Nonempty (CategoryTheory.Limits.IsColimit c) ∧
          c.pt = E ∧
          ∀ l : Λ, P (D.obj l)) →
      (∀ (F' : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}),
        P F' →
        ∃ (H : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
          (u : F' ⟶ H),
          CategoryTheory.Mono u ∧
          m • CategoryTheory.CategoryStruct.id H = 0 ∧
          WeilEtaleCohomologyPullbackBijective h H 0) →
      ∀ (F : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}),
        m • CategoryTheory.CategoryStruct.id F = 0 →
        WeilEtaleCohomologyPullbackBijective h F 0) :=
by
  
  have hMV : ∀ (Y : AlgebraicGeometry.Scheme.{u}),
      (∃ (W₀ W₁ : Y.Opens),
        W₀ ⊔ W₁ = ⊤ ∧
        AlgebraicGeometry.IsAffineOpen W₀ ∧
        AlgebraicGeometry.IsAffineOpen W₁ ∧
        AlgebraicGeometry.IsAffineOpen (W₀ ⊓ W₁)) →
      let Z_sh := fun (V : Y.Etale) =>
        (CategoryTheory.presheafToSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj
          ((CategoryTheory.yoneda.obj V).comp AddCommGrpCat.free)
      let Fℤ_Y := (CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj
        (AddCommGrpCat.of (ULift.{u} ℤ))
      ∃ (E₀₁ E₀ E₁ : Y.Etale)
        (f_mv : Z_sh E₀₁ ⟶ CategoryTheory.Limits.biprod (Z_sh E₀) (Z_sh E₁))
        (g_mv : CategoryTheory.Limits.biprod (Z_sh E₀) (Z_sh E₁) ⟶ Fℤ_Y)
        (h_mv : f_mv ≫ g_mv = 0),
        AlgebraicGeometry.IsAffine ((AlgebraicGeometry.Scheme.Etale.forget Y).obj E₀₁).left ∧
        AlgebraicGeometry.IsAffine ((AlgebraicGeometry.Scheme.Etale.forget Y).obj E₀).left ∧
        AlgebraicGeometry.IsAffine ((AlgebraicGeometry.Scheme.Etale.forget Y).obj E₁).left ∧
        (CategoryTheory.ShortComplex.mk f_mv g_mv h_mv).ShortExact := by
    intro Y ⟨W₀, W₁, hTop, hAff₀, hAff₁, hAff₀₁⟩
    let Z_sh := fun (V : Y.Etale) =>
      (CategoryTheory.presheafToSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj
        ((CategoryTheory.yoneda.obj V).comp AddCommGrpCat.free)
    let Fℤ_Y := (CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ))
    let E₀₁ : Y.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (W₀ ⊓ W₁).ι
      (inferInstance : AlgebraicGeometry.Etale (W₀ ⊓ W₁).ι)
    let E₀ : Y.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ W₀.ι
      (inferInstance : AlgebraicGeometry.Etale W₀.ι)
    let E₁ : Y.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ W₁.ι
      (inferInstance : AlgebraicGeometry.Etale W₁.ι)
    let T_Y : Y.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (CategoryTheory.CategoryStruct.id Y)
      (inferInstance : AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.id Y))
    let j₀ : E₀₁ ⟶ E₀ :=
      CategoryTheory.MorphismProperty.Over.homMk (Y.homOfLE inf_le_left) (Y.homOfLE_ι inf_le_left)
    let j₁ : E₀₁ ⟶ E₁ :=
      CategoryTheory.MorphismProperty.Over.homMk (Y.homOfLE inf_le_right) (Y.homOfLE_ι inf_le_right)
    let i₀ : E₀ ⟶ T_Y :=
      CategoryTheory.MorphismProperty.Over.homMk W₀.ι (CategoryTheory.Category.comp_id W₀.ι)
    let i₁ : E₁ ⟶ T_Y :=
      CategoryTheory.MorphismProperty.Over.homMk W₁.ι (CategoryTheory.Category.comp_id W₁.ι)
    have hsq_comm : j₀ ≫ i₀ = j₁ ≫ i₁ := by
      apply CategoryTheory.MorphismProperty.Over.Hom.ext
      change Y.homOfLE inf_le_left ≫ W₀.ι = Y.homOfLE inf_le_right ≫ W₁.ι
      rw [Y.homOfLE_ι, Y.homOfLE_ι]
    let sq : CategoryTheory.Square Y.Etale := CategoryTheory.Square.mk j₀ j₁ i₀ i₁ hsq_comm
    have : CategoryTheory.Mono sq.f₂₄ :=
      ⟨fun g₁ g₂ hg => by
        apply CategoryTheory.MorphismProperty.Over.Hom.ext
