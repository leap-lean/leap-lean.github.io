  have heval_mkH0 : ∀ (Z : AlgebraicGeometry.Scheme.{u})
      (F : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
      (m : ↑(F.obj.obj (Opposite.op (weilAffColim0TermEtale Z)))),
      evalH0 Z F (mkH0 Z F m) = m := by
