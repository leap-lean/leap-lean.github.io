            (CategoryTheory.Abelian.Ext.mk₀ (c.ι.app l)) (Nat.add_zero (q + 1)) = ξ
          rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero hSE₀.extClass η_l
