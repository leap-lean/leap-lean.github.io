        ((e_res.hom.app G).hom.app (Opposite.op (T_of Y₁))) =
        ((e_res.hom.app G).hom.app (Opposite.op (B_v.obj V))) ≫
          G.obj.map (j_v.map δ_v).op :=
      (e_res.hom.app G).hom.naturality (Opposite.op δ_v)
    let e_V : j_v.obj (T_of Y₁) ≅ V :=
      { hom := CategoryTheory.MorphismProperty.Over.homMk
          (CategoryTheory.CategoryStruct.id Y₁) rfl trivial
        inv := CategoryTheory.MorphismProperty.Over.homMk
          (CategoryTheory.CategoryStruct.id Y₁)
          ((CategoryTheory.Category.id_comp _).trans (CategoryTheory.Category.id_comp v)) trivial
        hom_inv_id := CategoryTheory.MorphismProperty.Comma.Hom.ext
          (CategoryTheory.Category.id_comp _) (Subsingleton.elim _ _)
        inv_hom_id := CategoryTheory.MorphismProperty.Comma.Hom.ext
          (CategoryTheory.Category.id_comp _) (Subsingleton.elim _ _) }
    have h_δ_counit : j_v.map δ_v ≫ adj_site.counit.app V = e_V.hom := by
      have hcounit_eq := CategoryTheory.MorphismProperty.Over.mapPullbackAdj_counit_app
        (@AlgebraicGeometry.Etale) ⊤ v hv trivial V
      have hcounit_left : (adj_site.counit.app V).left =
          CategoryTheory.Limits.pullback.fst V.hom v :=
        congrArg (fun k => k.left) hcounit_eq
      have h_left : (j_v.map δ_v ≫ adj_site.counit.app V).left = e_V.hom.left := by
        change δ_v.left ≫ (adj_site.counit.app V).left = CategoryTheory.CategoryStruct.id Y₁
        rw [hcounit_left]
        exact CategoryTheory.Limits.pullback.lift_fst _ _ rfl
      exact CategoryTheory.MorphismProperty.Comma.Hom.ext h_left (Subsingleton.elim _ _)
    let e_α : ((pb_of v).obj G).obj.obj (Opposite.op (T_of Y₁)) ≅
        (res_v.obj G).obj.obj (Opposite.op (T_of Y₁)) :=
      ((CategoryTheory.sheafToPresheaf Y₁.smallEtaleTopology AddCommGrpCat.{u}).mapIso
        (e_res.app G)).app (Opposite.op (T_of Y₁))
    let e_β : G.obj.obj (Opposite.op V) ≅
        (res_v.obj G).obj.obj (Opposite.op (T_of Y₁)) :=
      G.obj.mapIso e_V.op
    have h_θ_comp : θ ≫ e_α.hom = e_β.hom :=
      (CategoryTheory.Category.assoc _ _ _).trans
        ((congrArg (_ ≫ ·) h_nat_δ).trans
          ((CategoryTheory.Category.assoc _ _ _).symm.trans
            ((congrArg (· ≫ G.obj.map (j_v.map δ_v).op) h_unit_V).trans
              ((G.obj.map_comp (adj_site.counit.app V).op (j_v.map δ_v).op).symm.trans
                (congrArg (fun k => G.obj.map k.op) h_δ_counit)))))
    have h_θ_eq : θ = (e_β ≪≫ e_α.symm).hom :=
      (CategoryTheory.Category.comp_id θ).symm.trans
        ((congrArg (θ ≫ ·) e_α.hom_inv_id.symm).trans
          ((CategoryTheory.Category.assoc _ _ _).symm.trans
            (congrArg (· ≫ e_α.inv) h_θ_comp)))
    have : CategoryTheory.IsIso θ := by
      rw [h_θ_eq]
      exact CategoryTheory.Iso.isIso_hom (e_β ≪≫ e_α.symm)
    exact (CategoryTheory.ConcreteCategory.isIso_iff_bijective θ).mp inferInstance
  
  have hInj_res : ∀ (J : CategoryTheory.Sheaf Y₂.smallEtaleTopology AddCommGrpCat.{u})
      [CategoryTheory.Injective J],
      CategoryTheory.Injective (res_v.obj J) := by
    classical
    let Λ : Y₂.Etale → Type u :=
      fun W => { w_tilde : Quiver.Hom W.left Y₁ // w_tilde ≫ v = W.hom }
    let U_of : ∀ (W : Y₂.Etale), Λ W → Y₁.Etale :=
      fun W w_tilde => CategoryTheory.MorphismProperty.Over.mk ⊤ w_tilde.1
        (@CategoryTheory.MorphismProperty.of_postcomp _ _
          (@AlgebraicGeometry.Etale) (@AlgebraicGeometry.Etale) inferInstance
          _ _ _ w_tilde.1 v hv (w_tilde.2.symm ▸ W.prop))
    let pullΛ : ∀ {W' W : Y₂.Etale}, (W' ⟶ W) → Λ W → Λ W' :=
      fun f w_tilde => ⟨f.left ≫ w_tilde.1,
        (CategoryTheory.Category.assoc f.left w_tilde.1 v).trans
          ((congrArg (f.left ≫ ·) w_tilde.2).trans (CategoryTheory.MorphismProperty.Over.w f))⟩
    let mapU : ∀ {W' W : Y₂.Etale} (f : W' ⟶ W) (w_tilde : Λ W),
        U_of W' (pullΛ f w_tilde) ⟶ U_of W w_tilde :=
      fun f _ => CategoryTheory.MorphismProperty.Over.homMk f.left rfl trivial
    have h_single_id : ∀ (P : Y₁.Etaleᵒᵖ ⥤ AddCommGrpCat.{u}) {W : Y₂.Etale}
        (w₁ w₂ : Λ W) (hw : w₁ = w₂) (m : U_of W w₁ ⟶ U_of W w₂)
        (hm : m.left = CategoryTheory.CategoryStruct.id W.left)
        (x : ↥(P.obj (Opposite.op (U_of W w₂)))),
        DFinsupp.single (β := fun w => ↥(P.obj (Opposite.op (U_of W w)))) w₁ ((P.map m.op) x) =
          DFinsupp.single (β := fun w => ↥(P.obj (Opposite.op (U_of W w)))) w₂ x := by
      rintro P W w₁ _ rfl m hm x
      have hm_id : m = CategoryTheory.CategoryStruct.id (U_of W w₁) :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext hm (Subsingleton.elim _ _)
      have hx : (P.map m.op) x = x :=
        (congrArg (fun k => (P.map k.op) x) hm_id).trans
          (congrArg (fun k => k x) (P.map_id (Opposite.op (U_of W w₁))))
      rw [hx]
    have h_single_congr : ∀ (P : Y₁.Etaleᵒᵖ ⥤ AddCommGrpCat.{u}) {W' : Y₂.Etale}
        (w₁ w₂ : Λ W') (hw : w₁ = w₂) {U₀ : Y₁.Etale}
        (m₁ : U_of W' w₁ ⟶ U₀) (m₂ : U_of W' w₂ ⟶ U₀)
        (hm : m₁.left = m₂.left)
        (x : ↥(P.obj (Opposite.op U₀))),
        DFinsupp.single (β := fun w => ↥(P.obj (Opposite.op (U_of W' w)))) w₁ ((P.map m₁.op) x) =
          DFinsupp.single (β := fun w => ↥(P.obj (Opposite.op (U_of W' w)))) w₂ ((P.map m₂.op) x) := by
      rintro P W' w₁ _ rfl U₀ m₁ m₂ hm x
      have hm_eq : m₁ = m₂ :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext hm (Subsingleton.elim _ _)
      rw [hm_eq]
    let j_pre_bang : (Y₁.Etaleᵒᵖ ⥤ AddCommGrpCat.{u}) ⥤ (Y₂.Etaleᵒᵖ ⥤ AddCommGrpCat.{u}) :=
      { obj := fun P =>
          { obj := fun W_op =>
              AddCommGrpCat.of (Π₀ (w_tilde : Λ W_op.unop),
                ↥(P.obj (Opposite.op (U_of W_op.unop w_tilde))))
            map := fun {W_op W'_op} f_op =>
              AddCommGrpCat.ofHom (DFinsupp.sumAddHom (fun w_tilde : Λ W_op.unop =>
                (DFinsupp.singleAddHom
                  (fun w' : Λ W'_op.unop => ↥(P.obj (Opposite.op (U_of W'_op.unop w'))))
                  (pullΛ f_op.unop w_tilde)).comp (P.map (mapU f_op.unop w_tilde).op).hom))
            map_id := fun W_op => by
              apply AddCommGrpCat.ext
              have h_ext : DFinsupp.sumAddHom (fun w_tilde : Λ W_op.unop =>
                  (DFinsupp.singleAddHom
                    (fun w' : Λ W_op.unop => ↥(P.obj (Opposite.op (U_of W_op.unop w'))))
                    (pullΛ (CategoryTheory.CategoryStruct.id W_op.unop) w_tilde)).comp
                    (P.map (mapU (CategoryTheory.CategoryStruct.id W_op.unop) w_tilde).op).hom) =
                  AddMonoidHom.id _ := by
                apply DFinsupp.addHom_ext'
                intro w_tilde
                apply AddMonoidHom.ext
                intro x
                simp only [AddMonoidHom.comp_apply, AddMonoidHom.id_apply,
                  DFinsupp.sumAddHom_single, DFinsupp.singleAddHom_apply]
                exact h_single_id P
                  (pullΛ (CategoryTheory.CategoryStruct.id W_op.unop) w_tilde) w_tilde
                  (Subtype.ext (CategoryTheory.Category.id_comp w_tilde.1))
                  (mapU (CategoryTheory.CategoryStruct.id W_op.unop) w_tilde) rfl x
              intro z
              exact DFunLike.congr_fun h_ext z
            map_comp := fun {W_op W'_op W''_op} f_op g_op => by
              apply AddCommGrpCat.ext
              have h_ext : DFinsupp.sumAddHom (fun w_tilde : Λ W_op.unop =>
                  (DFinsupp.singleAddHom
                    (fun w'' : Λ W''_op.unop => ↥(P.obj (Opposite.op (U_of W''_op.unop w''))))
                    (pullΛ (g_op.unop ≫ f_op.unop) w_tilde)).comp
                    (P.map (mapU (g_op.unop ≫ f_op.unop) w_tilde).op).hom) =
                  (DFinsupp.sumAddHom (fun w' : Λ W'_op.unop =>
                    (DFinsupp.singleAddHom
                      (fun w'' : Λ W''_op.unop => ↥(P.obj (Opposite.op (U_of W''_op.unop w''))))
                      (pullΛ g_op.unop w')).comp (P.map (mapU g_op.unop w').op).hom)).comp
                  (DFinsupp.sumAddHom (fun w_tilde : Λ W_op.unop =>
                    (DFinsupp.singleAddHom
                      (fun w' : Λ W'_op.unop => ↥(P.obj (Opposite.op (U_of W'_op.unop w'))))
                      (pullΛ f_op.unop w_tilde)).comp (P.map (mapU f_op.unop w_tilde).op).hom)) := by
                apply DFinsupp.addHom_ext'
                intro w_tilde
                apply AddMonoidHom.ext
                intro x
                simp only [AddMonoidHom.comp_apply, DFinsupp.sumAddHom_single,
                  DFinsupp.singleAddHom_apply]
                have h_comp_x : (P.map (mapU g_op.unop (pullΛ f_op.unop w_tilde)).op).hom
                    ((P.map (mapU f_op.unop w_tilde).op).hom x) =
                    (P.map (mapU g_op.unop (pullΛ f_op.unop w_tilde) ≫
                      mapU f_op.unop w_tilde).op).hom x :=
                  congrArg (fun k => k.hom x)
                    (P.map_comp (mapU f_op.unop w_tilde).op
                      (mapU g_op.unop (pullΛ f_op.unop w_tilde)).op).symm
                rw [h_comp_x]
                exact h_single_congr P
                  (pullΛ (g_op.unop ≫ f_op.unop) w_tilde)
                  (pullΛ g_op.unop (pullΛ f_op.unop w_tilde))
                  (Subtype.ext (CategoryTheory.Category.assoc g_op.unop.left f_op.unop.left w_tilde.1))
                  (mapU (g_op.unop ≫ f_op.unop) w_tilde)
                  (mapU g_op.unop (pullΛ f_op.unop w_tilde) ≫ mapU f_op.unop w_tilde)
                  rfl x
              intro z
              exact DFunLike.congr_fun h_ext z }
        map := fun {P₁ P₂} φ =>
          { app := fun W_op =>
              AddCommGrpCat.ofHom (DFinsupp.mapRange.addMonoidHom
                (fun w_tilde : Λ W_op.unop => (φ.app (Opposite.op (U_of W_op.unop w_tilde))).hom))
            naturality := fun {W_op W'_op} f_op => by
              apply AddCommGrpCat.ext
              have h_ext : (DFinsupp.mapRange.addMonoidHom
                  (fun w' : Λ W'_op.unop => (φ.app (Opposite.op (U_of W'_op.unop w'))).hom)).comp
                  (DFinsupp.sumAddHom (fun w_tilde : Λ W_op.unop =>
                    (DFinsupp.singleAddHom _ (pullΛ f_op.unop w_tilde)).comp
                      (P₁.map (mapU f_op.unop w_tilde).op).hom)) =
                  (DFinsupp.sumAddHom (fun w_tilde : Λ W_op.unop =>
                    (DFinsupp.singleAddHom _ (pullΛ f_op.unop w_tilde)).comp
                      (P₂.map (mapU f_op.unop w_tilde).op).hom)).comp
                  (DFinsupp.mapRange.addMonoidHom
                    (fun w_tilde : Λ W_op.unop =>
                      (φ.app (Opposite.op (U_of W_op.unop w_tilde))).hom)) := by
                apply DFinsupp.addHom_ext'
                intro w_tilde
                apply AddMonoidHom.ext
                intro x
                simp only [AddMonoidHom.comp_apply, DFinsupp.sumAddHom_single,
                  DFinsupp.singleAddHom_apply, DFinsupp.mapRange.addMonoidHom_apply,
                  DFinsupp.mapRange_single]
                exact congrArg (DFinsupp.single (pullΛ f_op.unop w_tilde))
                  (congrArg (fun k => k.hom x)
                    (φ.naturality (mapU f_op.unop w_tilde).op))
              intro z
              exact DFunLike.congr_fun h_ext z }
        map_id := fun P => by
          apply CategoryTheory.NatTrans.ext
          funext W_op
          apply AddCommGrpCat.ext
          intro z
          apply DFinsupp.ext
          intro w_tilde
          simp
        map_comp := fun {P₁ P₂ P₃} φ₁ φ₂ => by
          apply CategoryTheory.NatTrans.ext
          funext W_op
          apply AddCommGrpCat.ext
          intro z
          apply DFinsupp.ext
          intro w_tilde
          simp [DFinsupp.mapRange_apply] }
    let R_pre : (Y₂.Etaleᵒᵖ ⥤ AddCommGrpCat.{u}) ⥤ (Y₁.Etaleᵒᵖ ⥤ AddCommGrpCat.{u}) :=
      (CategoryTheory.Functor.whiskeringLeft Y₁.Etaleᵒᵖ Y₂.Etaleᵒᵖ AddCommGrpCat.{u}).obj j_v.op
    let w_id : ∀ (U : Y₁.Etale), Λ (j_v.obj U) := fun U => ⟨U.hom, rfl⟩
    let i_U : ∀ (U : Y₁.Etale), U_of (j_v.obj U) (w_id U) ⟶ U :=
      fun U => CategoryTheory.MorphismProperty.Over.homMk
        (CategoryTheory.CategoryStruct.id U.left)
        (CategoryTheory.Category.id_comp U.hom) trivial
    let c_W : ∀ (W : Y₂.Etale) (w_tilde : Λ W), W ⟶ j_v.obj (U_of W w_tilde) :=
      fun W w_tilde => CategoryTheory.MorphismProperty.Over.homMk
        (CategoryTheory.CategoryStruct.id W.left)
        ((CategoryTheory.Category.id_comp _).trans w_tilde.2) trivial
    let η_pre : CategoryTheory.Functor.id (Y₁.Etaleᵒᵖ ⥤ AddCommGrpCat.{u}) ⟶
        j_pre_bang ⋙ R_pre :=
      { app := fun P =>
          { app := fun U_op =>
              AddCommGrpCat.ofHom ((DFinsupp.singleAddHom
                (fun w : Λ (j_v.obj U_op.unop) =>
                  ↥(P.obj (Opposite.op (U_of (j_v.obj U_op.unop) w))))
                (w_id U_op.unop)).comp (P.map (i_U U_op.unop).op).hom)
            naturality := fun {U_op U'_op} g_op => by
              apply AddCommGrpCat.ext
              intro x
              dsimp [j_pre_bang, R_pre]
              simp only [AddMonoidHom.comp_apply, DFinsupp.sumAddHom_single,
                DFinsupp.singleAddHom_apply]
              have h_lhs : (P.map (i_U U'_op.unop).op).hom ((P.map g_op).hom x) =
                  (P.map (i_U U'_op.unop ≫ g_op.unop).op).hom x :=
                congrArg (fun k => k.hom x) (P.map_comp g_op (i_U U'_op.unop).op).symm
              have h_rhs : (P.map (mapU (j_v.map g_op.unop) (w_id U_op.unop)).op).hom
                  ((P.map (i_U U_op.unop).op).hom x) =
                  (P.map (mapU (j_v.map g_op.unop) (w_id U_op.unop) ≫
                    i_U U_op.unop).op).hom x :=
                congrArg (fun k => k.hom x)
                  (P.map_comp (i_U U_op.unop).op
                    (mapU (j_v.map g_op.unop) (w_id U_op.unop)).op).symm
              rw [h_lhs, h_rhs]
              exact h_single_congr P
                (w_id U'_op.unop)
                (pullΛ (j_v.map g_op.unop) (w_id U_op.unop))
                (Subtype.ext (CategoryTheory.MorphismProperty.Over.w g_op.unop).symm)
                (i_U U'_op.unop ≫ g_op.unop)
                (mapU (j_v.map g_op.unop) (w_id U_op.unop) ≫ i_U U_op.unop)
                ((CategoryTheory.Category.id_comp _).trans
                  (CategoryTheory.Category.comp_id _).symm) x }
        naturality := fun {P₁ P₂} φ => by
          apply CategoryTheory.NatTrans.ext
          funext U_op
          apply AddCommGrpCat.ext
          intro x
          dsimp [j_pre_bang, R_pre]
          simp only [DFinsupp.singleAddHom_apply,
            DFinsupp.mapRange.addMonoidHom_apply, DFinsupp.mapRange_single]
          exact congrArg (DFinsupp.single (w_id U_op.unop))
            (congrArg (fun k => k.hom x)
              (φ.naturality (i_U U_op.unop).op).symm) }
    let ε_pre : R_pre ⋙ j_pre_bang ⟶
        CategoryTheory.Functor.id (Y₂.Etaleᵒᵖ ⥤ AddCommGrpCat.{u}) :=
      { app := fun Q =>
          { app := fun W_op =>
              AddCommGrpCat.ofHom (DFinsupp.sumAddHom (fun w_tilde : Λ W_op.unop =>
                (Q.map (c_W W_op.unop w_tilde).op).hom))
            naturality := fun {W_op W'_op} f_op => by
              apply AddCommGrpCat.ext
              have h_ext : (DFinsupp.sumAddHom (fun w' : Λ W'_op.unop =>
                  (Q.map (c_W W'_op.unop w').op).hom)).comp
                  (DFinsupp.sumAddHom (fun w_tilde : Λ W_op.unop =>
                    (DFinsupp.singleAddHom _ (pullΛ f_op.unop w_tilde)).comp
                      (Q.map (j_v.map (mapU f_op.unop w_tilde)).op).hom)) =
                  (Q.map f_op).hom.comp
                    (DFinsupp.sumAddHom (fun w_tilde : Λ W_op.unop =>
                      (Q.map (c_W W_op.unop w_tilde).op).hom)) := by
                apply DFinsupp.addHom_ext'
                intro w_tilde
                apply AddMonoidHom.ext
                intro y
                simp only [AddMonoidHom.comp_apply, DFinsupp.sumAddHom_single,
                  DFinsupp.singleAddHom_apply]
                have h_mor : c_W W'_op.unop (pullΛ f_op.unop w_tilde) ≫
                    j_v.map (mapU f_op.unop w_tilde) =
                    f_op.unop ≫ c_W W_op.unop w_tilde :=
                  CategoryTheory.MorphismProperty.Comma.Hom.ext
                    ((CategoryTheory.Category.id_comp _).trans
                      (CategoryTheory.Category.comp_id _).symm)
                    (Subsingleton.elim _ _)
                exact (congrArg (fun k => k.hom y)
                  (Q.map_comp (j_v.map (mapU f_op.unop w_tilde)).op
                    (c_W W'_op.unop (pullΛ f_op.unop w_tilde)).op).symm).trans
                  ((congrArg (fun m => (Q.map m.op).hom y) h_mor).trans
                    (congrArg (fun k => k.hom y)
                      (Q.map_comp (c_W W_op.unop w_tilde).op f_op)))
              intro z
              exact DFunLike.congr_fun h_ext z }
        naturality := fun {Q₁ Q₂} ψ => by
          apply CategoryTheory.NatTrans.ext
          funext W_op
          apply AddCommGrpCat.ext
          have h_ext : (DFinsupp.sumAddHom (fun w_tilde : Λ W_op.unop =>
              (Q₂.map (c_W W_op.unop w_tilde).op).hom)).comp
              (DFinsupp.mapRange.addMonoidHom (fun w_tilde : Λ W_op.unop =>
                (ψ.app (Opposite.op (j_v.obj (U_of W_op.unop w_tilde)))).hom)) =
              (ψ.app W_op).hom.comp
                (DFinsupp.sumAddHom (fun w_tilde : Λ W_op.unop =>
                  (Q₁.map (c_W W_op.unop w_tilde).op).hom)) := by
            apply DFinsupp.addHom_ext'
            intro w_tilde
            apply AddMonoidHom.ext
            intro y
            simp only [AddMonoidHom.comp_apply, DFinsupp.singleAddHom_apply,
              DFinsupp.mapRange.addMonoidHom_apply, DFinsupp.mapRange_single,
              DFinsupp.sumAddHom_single]
            exact congrArg (fun k => k.hom y)
              (ψ.naturality (c_W W_op.unop w_tilde).op).symm
          intro z
          exact DFunLike.congr_fun h_ext z }
    let adj_pre : j_pre_bang ⊣ R_pre :=
      CategoryTheory.Adjunction.mkOfUnitCounit
        { unit := η_pre
          counit := ε_pre
          left_triangle := by
            apply CategoryTheory.NatTrans.ext
            funext P
            apply CategoryTheory.NatTrans.ext
            funext W_op
            apply AddCommGrpCat.ext
            have h_ext : (DFinsupp.sumAddHom (fun w_tilde : Λ W_op.unop =>
                DFinsupp.sumAddHom (fun w' : Λ (j_v.obj (U_of W_op.unop w_tilde)) =>
                  (DFinsupp.singleAddHom
                    (fun w₀ : Λ W_op.unop => ↥(P.obj (Opposite.op (U_of W_op.unop w₀))))
                    (pullΛ (c_W W_op.unop w_tilde) w')).comp
                    (P.map (mapU (c_W W_op.unop w_tilde) w').op).hom))).comp
                (DFinsupp.mapRange.addMonoidHom (fun w_tilde : Λ W_op.unop =>
                  (DFinsupp.singleAddHom
                    (fun w' : Λ (j_v.obj (U_of W_op.unop w_tilde)) =>
                      ↥(P.obj (Opposite.op (U_of (j_v.obj (U_of W_op.unop w_tilde)) w'))))
                    (w_id (U_of W_op.unop w_tilde))).comp
                    (P.map (i_U (U_of W_op.unop w_tilde)).op).hom)) =
                AddMonoidHom.id _ := by
              apply DFinsupp.addHom_ext'
              intro w_tilde
              apply AddMonoidHom.ext
              intro x
              simp only [AddMonoidHom.comp_apply, AddMonoidHom.id_apply,
                DFinsupp.singleAddHom_apply, DFinsupp.mapRange.addMonoidHom_apply,
                DFinsupp.mapRange_single, DFinsupp.sumAddHom_single]
              have h_map_comp : (P.map (mapU (c_W W_op.unop w_tilde)
                  (w_id (U_of W_op.unop w_tilde))).op).hom
                  ((P.map (i_U (U_of W_op.unop w_tilde)).op).hom x) =
                  (P.map (mapU (c_W W_op.unop w_tilde)
                    (w_id (U_of W_op.unop w_tilde)) ≫
                    i_U (U_of W_op.unop w_tilde)).op).hom x :=
                congrArg (fun k => k.hom x)
                  (P.map_comp (i_U (U_of W_op.unop w_tilde)).op
                    (mapU (c_W W_op.unop w_tilde) (w_id (U_of W_op.unop w_tilde))).op).symm
              rw [h_map_comp]
              exact h_single_id P
                (pullΛ (c_W W_op.unop w_tilde) (w_id (U_of W_op.unop w_tilde)))
                w_tilde
