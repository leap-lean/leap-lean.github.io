theorem weil_pbc_projLine_strict_local_specialization_square (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (A₀ : Type u) [CommRing A₀] [Algebra k A₀] (τ₀ : A₀ →ₐ[k] k)
    (A₁ : Type u) [CommRing A₁] [Algebra k A₁] (τ₁ : A₁ →ₐ[k] k)
    (ψ : A₀ →ₐ[k] A₁) :
    WeilIsStrictLocalNoetherianAlgClosedRing k A₀ τ₀ →
    WeilIsStrictLocalNoetherianAlgClosedRing k A₁ τ₁ →
    τ₁.comp ψ = τ₀ →
    (∀ (F₀ : CategoryTheory.Sheaf
        (CategoryTheory.Limits.pullback
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A₀)))
          (weilProjectiveSpaceOver k 1).hom).smallEtaleTopology
        AddCommGrpCat.{u}) (q : ℕ),
      ℓ • CategoryTheory.CategoryStruct.id F₀ = 0 →
      WeilEtaleCohomologyPullbackBijective
        (CategoryTheory.Limits.pullback.snd
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ₀.toRingHom))
          (CategoryTheory.Limits.pullback.fst
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A₀)))
            (weilProjectiveSpaceOver k 1).hom))
        F₀ q) →
    (∀ (F₁ : CategoryTheory.Sheaf
        (CategoryTheory.Limits.pullback
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A₁)))
          (weilProjectiveSpaceOver k 1).hom).smallEtaleTopology
        AddCommGrpCat.{u}) (q : ℕ),
      ℓ • CategoryTheory.CategoryStruct.id F₁ = 0 →
      WeilEtaleCohomologyPullbackBijective
        (CategoryTheory.Limits.pullback.snd
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ₁.toRingHom))
          (CategoryTheory.Limits.pullback.fst
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A₁)))
            (weilProjectiveSpaceOver k 1).hom))
        F₁ q) →
    (∀ (g'_A : Quiver.Hom
        (CategoryTheory.Limits.pullback
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A₁)))
          (weilProjectiveSpaceOver k 1).hom)
        (CategoryTheory.Limits.pullback
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A₀)))
          (weilProjectiveSpaceOver k 1).hom)),
      CategoryTheory.CategoryStruct.comp g'_A
        (CategoryTheory.Limits.pullback.fst
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A₀)))
          (weilProjectiveSpaceOver k 1).hom) =
        CategoryTheory.CategoryStruct.comp
          (CategoryTheory.Limits.pullback.fst
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A₁)))
            (weilProjectiveSpaceOver k 1).hom)
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ.toRingHom)) →
      CategoryTheory.CategoryStruct.comp g'_A
        (CategoryTheory.Limits.pullback.snd
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A₀)))
          (weilProjectiveSpaceOver k 1).hom) =
        CategoryTheory.Limits.pullback.snd
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A₁)))
          (weilProjectiveSpaceOver k 1).hom →
      ∀ (F₀ : CategoryTheory.Sheaf
          (CategoryTheory.Limits.pullback
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A₀)))
            (weilProjectiveSpaceOver k 1).hom).smallEtaleTopology
          AddCommGrpCat.{u}) (q : ℕ),
        ℓ • CategoryTheory.CategoryStruct.id F₀ = 0 →
        WeilEtaleCohomologyPullbackBijective g'_A F₀ q) ∧
    (∀ (M : CategoryTheory.Sheaf
        (AlgebraicGeometry.Spec (CommRingCat.of A₀)).smallEtaleTopology
        AddCommGrpCat.{u}),
      WeilEtaleCohomologyPullbackBijective
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ.toRingHom)) M 0) :=
by
  intro hA₀ hA₁ hψ hSpec₀ hSpec₁
  
  
  
  have partA_pullback_pkg : ∀ {Y₀ Y : AlgebraicGeometry.Scheme.{u}} (h : Y₀ ⟶ Y),
      let B_h := weilEtaleSitePullback h
      CategoryTheory.Limits.PreservesFiniteLimits B_h ∧
      ∃ (_ : B_h.IsContinuous Y.smallEtaleTopology Y₀.smallEtaleTopology),
        let pf_h := B_h.sheafPushforwardContinuous AddCommGrpCat.{u}
          Y.smallEtaleTopology Y₀.smallEtaleTopology
        ∃ (_ : pf_h.IsRightAdjoint),
          let pb_h := B_h.sheafPullback AddCommGrpCat.{u}
            Y.smallEtaleTopology Y₀.smallEtaleTopology
          let adj_h := B_h.sheafAdjunctionContinuous AddCommGrpCat.{u}
            Y.smallEtaleTopology Y₀.smallEtaleTopology
          pb_h.Additive ∧
          CategoryTheory.Limits.PreservesFiniteLimits pb_h ∧
          CategoryTheory.Limits.PreservesFiniteColimits pb_h ∧
          let Pℤ_Y := (CategoryTheory.Functor.const (Opposite Y.Etale)).obj
            (AddCommGrpCat.of (ULift.{u} ℤ))
          let Pℤ_Y₀ := (CategoryTheory.Functor.const (Opposite Y₀.Etale)).obj
            (AddCommGrpCat.of (ULift.{u} ℤ))
          let Fℤ_Y := (CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj
            (AddCommGrpCat.of (ULift.{u} ℤ))
          let Fℤ_Y₀ := (CategoryTheory.constantSheaf Y₀.smallEtaleTopology AddCommGrpCat.{u}).obj
            (AddCommGrpCat.of (ULift.{u} ℤ))
          let η₀ := CategoryTheory.Functor.whiskerLeft B_h.op
            ((CategoryTheory.sheafificationAdjunction Y₀.smallEtaleTopology AddCommGrpCat.{u}).unit.app Pℤ_Y₀)
          let uℤ := ((CategoryTheory.sheafificationAdjunction Y.smallEtaleTopology AddCommGrpCat.{u}).homEquiv
            Pℤ_Y (pf_h.obj Fℤ_Y₀)).symm η₀
          let cℤ := (adj_h.homEquiv Fℤ_Y Fℤ_Y₀).symm uℤ
          CategoryTheory.IsIso cℤ := by
    intro Y₀ Y h
    let stdTermObj : ∀ (W : AlgebraicGeometry.Scheme.{u}), W.Etale :=
      fun W => CategoryTheory.MorphismProperty.Over.mk ⊤ (𝟙 W)
        (show AlgebraicGeometry.Etale (𝟙 W) from inferInstance)
    let stdTermIsTerm : ∀ (W : AlgebraicGeometry.Scheme.{u}),
        CategoryTheory.Limits.IsTerminal (stdTermObj W) :=
      fun W => CategoryTheory.Limits.IsTerminal.ofUniqueHom
        (fun U => CategoryTheory.MorphismProperty.Over.homMk U.hom
          (CategoryTheory.Category.comp_id U.hom))
        (fun U m => by
          apply CategoryTheory.MorphismProperty.Over.Hom.ext_iff.mpr
          have hw : m.left ≫ 𝟙 W = U.hom := CategoryTheory.MorphismProperty.Over.w m
          exact (CategoryTheory.Category.comp_id m.left).symm.trans hw)
    let B_h := weilEtaleSitePullback h
    have hB_lim : CategoryTheory.Limits.PreservesFiniteLimits B_h := by
      have h_inter : B_h ⋙ AlgebraicGeometry.Scheme.Etale.forget Y₀ =
          AlgebraicGeometry.Scheme.Etale.forget Y ⋙ CategoryTheory.Over.pullback h := rfl
      haveI : CategoryTheory.Limits.PreservesLimits (CategoryTheory.Over.pullback h) :=
        (CategoryTheory.Over.mapPullbackAdj h).rightAdjoint_preservesLimits
      haveI : CategoryTheory.Limits.PreservesFiniteLimits
          (AlgebraicGeometry.Scheme.Etale.forget Y ⋙ CategoryTheory.Over.pullback h) :=
        CategoryTheory.Limits.comp_preservesFiniteLimits _ _
      haveI : CategoryTheory.Limits.PreservesFiniteLimits
          (B_h ⋙ AlgebraicGeometry.Scheme.Etale.forget Y₀) := by
        rw [h_inter]; infer_instance
      exact CategoryTheory.Limits.preservesFiniteLimits_of_reflects_of_preserves
        B_h (AlgebraicGeometry.Scheme.Etale.forget Y₀)
    refine ⟨hB_lim, ?_⟩
    have hDenseSubsite : ∃ (D : Type u) (_ : CategoryTheory.SmallCategory D)
        (_ : CategoryTheory.Limits.HasFiniteLimits D)
        (G : D ⥤ Y.Etale),
        CategoryTheory.Limits.PreservesFiniteLimits G ∧
        G.IsDenseSubsite (G.inducedTopology Y.smallEtaleTopology) Y.smallEtaleTopology := by
      let T_Y : Y.Etale := stdTermObj Y
      have hT_Y : CategoryTheory.Limits.IsTerminal T_Y := stdTermIsTerm Y
      let S_aff : Type u := CategoryTheory.SmallModel.{u} Y.AffineEtale
      let e_aff : Y.AffineEtale ≌ S_aff := CategoryTheory.equivSmallModel Y.AffineEtale
      let g_aff : S_aff → Y.Etale :=
        fun s => (AlgebraicGeometry.Scheme.AffineEtale.Spec Y).obj (e_aff.inverse.obj s)
      let StagePkg : ℕ → Σ (S : Type u), S → Y.Etale :=
        Nat.rec
          ⟨ULift.{u} Unit ⊕ S_aff, Sum.elim (fun _ => T_Y) g_aff⟩
          (fun _ prev =>
            ⟨prev.1 ⊕ (Σ (a b c : prev.1) (_ : prev.2 a ⟶ prev.2 c), (prev.2 b ⟶ prev.2 c)),
              Sum.elim prev.2 (fun p => CategoryTheory.Limits.pullback p.2.2.2.1 p.2.2.2.2)⟩)
      have hLiftStage : ∀ {m k : ℕ} (x : (StagePkg m).1),
          ∃ y : (StagePkg (m + k)).1, (StagePkg (m + k)).2 y = (StagePkg m).2 x := by
        intro m k x
        induction k with
        | zero => exact ⟨x, rfl⟩
        | succ k ih =>
          obtain ⟨y, hy⟩ := ih
          exact ⟨Sum.inl y, hy⟩
      have hCastStage : ∀ {a b : ℕ} (hab : a = b) (x : (StagePkg a).1),
          (StagePkg b).2 (hab ▸ x) = (StagePkg a).2 x := by
        rintro a _ rfl x
        rfl
      let Idx : Type u := Σ n : ℕ, (StagePkg n).1
      let eval : Idx → Y.Etale := fun p => (StagePkg p.1).2 p.2
      let D : Type u := CategoryTheory.InducedCategory Y.Etale eval
      let G : D ⥤ Y.Etale := CategoryTheory.inducedFunctor eval
      have hCommon : ∀ (d₁ d₂ d₃ : D),
          ∃ (N : ℕ) (y₁ y₂ y₃ : (StagePkg N).1),
            (StagePkg N).2 y₁ = eval d₁ ∧
            (StagePkg N).2 y₂ = eval d₂ ∧
            (StagePkg N).2 y₃ = eval d₃ := by
        intro d₁ d₂ d₃
        let k₁ := d₂.1 + d₃.1
        let k₂ := d₁.1 + d₃.1
        let k₃ := d₁.1 + d₂.1
        have hk₂ : d₂.1 + k₂ = d₁.1 + k₁ := by omega
        have hk₃ : d₃.1 + k₃ = d₁.1 + k₁ := by omega
        obtain ⟨y₁, hy₁⟩ := hLiftStage (k := k₁) d₁.2
        obtain ⟨y₂, hy₂⟩ := hLiftStage (k := k₂) d₂.2
        obtain ⟨y₃, hy₃⟩ := hLiftStage (k := k₃) d₃.2
        exact ⟨d₁.1 + k₁, y₁, hk₂ ▸ y₂, hk₃ ▸ y₃, hy₁,
          (hCastStage hk₂ y₂).trans hy₂,
          (hCastStage hk₃ y₃).trans hy₃⟩
      let d_T : D := ⟨0, Sum.inl ⟨()⟩⟩
      have hd_T : CategoryTheory.Limits.IsTerminal d_T :=
        CategoryTheory.Limits.IsTerminal.ofUniqueHom
          (fun d => CategoryTheory.InducedCategory.homMk (hT_Y.from (G.obj d)))
          (fun d m => CategoryTheory.InducedCategory.hom_ext (hT_Y.hom_ext _ _))
      haveI : ∀ d : D, Nonempty (d ⟶ d_T) :=
        fun d => ⟨CategoryTheory.InducedCategory.homMk (hT_Y.from (G.obj d))⟩
      haveI : ∀ d : D, Subsingleton (d ⟶ d_T) :=
        fun d => ⟨fun _ _ => CategoryTheory.InducedCategory.hom_ext (hT_Y.hom_ext _ _)⟩
      haveI hHasTermD : CategoryTheory.Limits.HasTerminal D :=
        CategoryTheory.Limits.hasTerminal_of_unique d_T
      haveI hPresTermG : CategoryTheory.Limits.PreservesLimit (CategoryTheory.Functor.empty.{0} D) G :=
        CategoryTheory.Limits.preservesLimit_of_preserves_limit_cone hd_T
          ((CategoryTheory.Limits.isLimitMapConeEmptyConeEquiv G d_T).symm hT_Y)
      haveI hPresPEmptyG : CategoryTheory.Limits.PreservesLimitsOfShape
          (CategoryTheory.Discrete PEmpty.{1}) G :=
        CategoryTheory.Limits.preservesLimitsOfShape_pempty_of_preservesTerminal G
      have hCospan : ∀ {d₁ d₂ d₃ : D} (f₁ : d₁ ⟶ d₃) (f₂ : d₂ ⟶ d₃),
          ∃ (c : CategoryTheory.Limits.PullbackCone f₁ f₂),
            Nonempty (CategoryTheory.Limits.IsLimit c) ∧
            Nonempty (CategoryTheory.Limits.IsLimit (G.mapCone c)) := by
        intro d₁ d₂ d₃ f₁ f₂
        obtain ⟨N, y₁, y₂, y₃, hy₁, hy₂, hy₃⟩ := hCommon d₁ d₂ d₃
        let u₁ : (StagePkg N).2 y₁ ⟶ (StagePkg N).2 y₃ :=
          eqToHom hy₁ ≫ f₁.hom ≫ eqToHom hy₃.symm
        let u₂ : (StagePkg N).2 y₂ ⟶ (StagePkg N).2 y₃ :=
          eqToHom hy₂ ≫ f₂.hom ≫ eqToHom hy₃.symm
        let d_pb : D := ⟨N + 1, Sum.inr ⟨y₁, y₂, y₃, u₁, u₂⟩⟩
        have hd_pb : eval d_pb = CategoryTheory.Limits.pullback u₁ u₂ := rfl
        let π₁ : d_pb ⟶ d₁ :=
          CategoryTheory.InducedCategory.homMk
            (eqToHom hd_pb ≫ CategoryTheory.Limits.pullback.fst u₁ u₂ ≫ eqToHom hy₁)
        let π₂ : d_pb ⟶ d₂ :=
          CategoryTheory.InducedCategory.homMk
            (eqToHom hd_pb ≫ CategoryTheory.Limits.pullback.snd u₁ u₂ ≫ eqToHom hy₂)
        have hcond : π₁ ≫ f₁ = π₂ ≫ f₂ := by
          apply CategoryTheory.InducedCategory.hom_ext
          change (eqToHom hd_pb ≫ CategoryTheory.Limits.pullback.fst u₁ u₂ ≫ eqToHom hy₁) ≫ f₁.hom =
            (eqToHom hd_pb ≫ CategoryTheory.Limits.pullback.snd u₁ u₂ ≫ eqToHom hy₂) ≫ f₂.hom
          calc
            (eqToHom hd_pb ≫ CategoryTheory.Limits.pullback.fst u₁ u₂ ≫ eqToHom hy₁) ≫ f₁.hom
              = eqToHom hd_pb ≫ (CategoryTheory.Limits.pullback.fst u₁ u₂ ≫ u₁) ≫ eqToHom hy₃ := by
                  dsimp [u₁]; simp [CategoryTheory.Category.assoc]
            _ = eqToHom hd_pb ≫ (CategoryTheory.Limits.pullback.snd u₁ u₂ ≫ u₂) ≫ eqToHom hy₃ := by
                  rw [CategoryTheory.Limits.pullback.condition]
            _ = (eqToHom hd_pb ≫ CategoryTheory.Limits.pullback.snd u₁ u₂ ≫ eqToHom hy₂) ≫ f₂.hom := by
                  dsimp [u₂]; simp [CategoryTheory.Category.assoc]
        let c : CategoryTheory.Limits.PullbackCone f₁ f₂ :=
          CategoryTheory.Limits.PullbackCone.mk π₁ π₂ hcond
        have hGc : CategoryTheory.Limits.IsLimit (G.mapCone c) := by
          refine (CategoryTheory.Limits.PullbackCone.isLimitMapConeEquiv c G).symm ?_
          let lift_cone : ∀ (s : CategoryTheory.Limits.PullbackCone (G.map f₁) (G.map f₂)),
              s.pt ⟶ CategoryTheory.Limits.pullback u₁ u₂ :=
            fun s =>
              let s₁ : s.pt ⟶ (StagePkg N).2 y₁ := s.fst ≫ eqToHom hy₁.symm
              let s₂ : s.pt ⟶ (StagePkg N).2 y₂ := s.snd ≫ eqToHom hy₂.symm
              have hs_cond : s₁ ≫ u₁ = s₂ ≫ u₂ := by
                dsimp [s₁, s₂, u₁, u₂]
                simp only [CategoryTheory.Category.assoc, eqToHom_trans_assoc, eqToHom_refl,
                  CategoryTheory.Category.id_comp]
                have hsc := s.condition
                change s.fst ≫ f₁.hom = s.snd ≫ f₂.hom at hsc
