          pf_f₃.map_comp, pf_f₃.map_comp, Category.assoc, Category.assoc]
      have hα₃ : adj_π.unit.app X ≫ pf_π.map (weilEtalePullMateHom.{u} π f₂₃ f₁ hπ₂₃ X) =
          adj_f₂₃.unit.app X ≫ (pf_f₂₃.map (adj_f₁.unit.app (pb_f₂₃.obj X)) ≫
