      congrArg (fun nat => (nat.app (Opposite.op (weilAffColim0TermEtale Z))) (ULift.up (1 : ℤ))) h_eq_α
    have hid : (hTerm Z).from (weilAffColim0TermEtale Z) =
        CategoryTheory.CategoryStruct.id (weilAffColim0TermEtale Z) :=
