      let γ_π := CategoryTheory.CategoryStruct.comp ((adj_of v_X).unit.app K₁) ((pf_of v_X).map β_π)
      have h_unit_bc₁ : CategoryTheory.CategoryStruct.comp ((adj_of v).unit.app G₁)
          ((pf_of v).map ((pb_of v).map bc₁)) =
          CategoryTheory.CategoryStruct.comp bc₁ ((adj_of v).unit.app H₁) :=
        ((adj_of v).unit.naturality bc₁).symm
