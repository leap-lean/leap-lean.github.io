    let d_cov : Q → 𝒢 := fun q => (hPt q).choose
    let h_cov : ∀ q : Q, U_G (d_cov q) ⟶ W := fun q => (hPt q).choose_spec.choose
    have hd_eq : ∀ q : Q, δ_G (d_cov q) = δ₀ :=
      fun q => (hPt q).choose_spec.choose_spec.choose_spec.1
    have h_δ₁ : ∀ q : Q, δ_G g₁ = δ_G (d_cov q) ∨ δ_G (d_cov q) = 2 := by
      intro q; rw [hd_eq q]; exact h_step₁
    have h_δ₂ : ∀ q : Q, δ_G g₂ = δ_G (d_cov q) ∨ δ_G (d_cov q) = 2 := by
      intro q; rw [hd_eq q]; exact h_step₂
    have hφ₁_ex : ∀ q : Q, ∃ φ : R_G g₁ →+* R_G (d_cov q),
        φ.comp (algebraMap (S_ch (δ_G g₁)) (R_G g₁)) =
          (algebraMap (S_ch (δ_G (d_cov q))) (R_G (d_cov q))).comp
            (τ (δ_G g₁) (δ_G (d_cov q)) (h_δ₁ q)) ∧
        ((AlgebraicGeometry.Scheme.Etale.forget X).map (h_cov q ≫ a)).left =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ) :=
      fun q => hLiftRingHom (h_δ₁ q) (h_cov q ≫ a)
    have hφ₂_ex : ∀ q : Q, ∃ φ : R_G g₂ →+* R_G (d_cov q),
        φ.comp (algebraMap (S_ch (δ_G g₂)) (R_G g₂)) =
          (algebraMap (S_ch (δ_G (d_cov q))) (R_G (d_cov q))).comp
            (τ (δ_G g₂) (δ_G (d_cov q)) (h_δ₂ q)) ∧
        ((AlgebraicGeometry.Scheme.Etale.forget X).map (h_cov q ≫ b)).left =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ) :=
      fun q => hLiftRingHom (h_δ₂ q) (h_cov q ≫ b)
    refine ⟨Q, d_cov, h_cov, h_δ₁, h_δ₂,
      fun q => (hφ₁_ex q).choose, fun q => (hφ₂_ex q).choose, ?_,
      fun q => (hφ₁_ex q).choose_spec, fun q => (hφ₂_ex q).choose_spec⟩
    refine hMemOfArrows d_cov h_cov
      (fun q => (hPt q).choose_spec.choose_spec.choose_spec.2.1) (fun q => ?_)
    exact ⟨q, (hPt q).choose_spec.choose_spec.choose,
      (hPt q).choose_spec.choose_spec.choose_spec.2.2⟩

  rcases hPart1 with ⟨𝒢, δ_G, R_G, hRingG, hAlgG, hEtSpecG, hEtAlgG, hCov, hSpan⟩
  let _ : ∀ g : 𝒢, CommRing (R_G g) := hRingG
  let _ : ∀ g : 𝒢, Algebra (S_ch (δ_G g)) (R_G g) := hAlgG
  have : ∀ g : 𝒢, AlgebraicGeometry.Etale
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap (S_ch (δ_G g)) (R_G g)))) := hEtSpecG
  have : ∀ g : 𝒢, Algebra.Etale (S_ch (δ_G g)) (R_G g) := hEtAlgG
  let U_G : 𝒢 → X.Etale := fun g =>
    CategoryTheory.MorphismProperty.Over.mk ⊤
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap (S_ch (δ_G g)) (R_G g))) ≫ j (δ_G g))
      inferInstance

  
  
  
  have hBasis_uniq : ∀ {G : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
      (ψ₁ ψ₂ : F ⟶ G),
      (∀ g : 𝒢, ψ₁.hom.app (Opposite.op (U_G g)) = ψ₂.hom.app (Opposite.op (U_G g))) →
      ψ₁ = ψ₂ := by
    intro G ψ₁ ψ₂ hEq
    apply CategoryTheory.Sheaf.hom_ext
    ext W_op : 2
    obtain ⟨I, g_cov, f_cov, hf⟩ := hCov W_op.unop
    refine G.property.hom_ext_ofArrows f_cov hf (fun i => ?_)
    have hnat₁ := (ψ₁.hom.naturality (f_cov i).op).symm
    have hnat₂ := ψ₂.hom.naturality (f_cov i).op
    exact hnat₁.trans ((congrArg (F.obj.map (f_cov i).op ≫ ·) (hEq (g_cov i))).trans hnat₂)

  have hBasis_ext : ∀ {G : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
      (ψ₀ : ∀ g : 𝒢, F.obj.obj (Opposite.op (U_G g)) ⟶ G.obj.obj (Opposite.op (U_G g))),
      (∀ (g₁ g₂ : 𝒢) (h_δ : δ_G g₁ = δ_G g₂ ∨ δ_G g₂ = 2)
        (φ : R_G g₁ →+* R_G g₂) (u : U_G g₂ ⟶ U_G g₁),
        φ.comp (algebraMap (S_ch (δ_G g₁)) (R_G g₁)) =
          (algebraMap (S_ch (δ_G g₂)) (R_G g₂)).comp (τ (δ_G g₁) (δ_G g₂) h_δ) →
        ((AlgebraicGeometry.Scheme.Etale.forget X).map u).left =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ) →
        ψ₀ g₁ ≫ G.obj.map u.op = F.obj.map u.op ≫ ψ₀ g₂) →
      ∃ ψ : F ⟶ G, ∀ g : 𝒢, ψ.hom.app (Opposite.op (U_G g)) = ψ₀ g := by
    intro G ψ₀ hψ₀
    have hSpanCompat : ∀ {W' : X.Etale} {g₁ g₂ : 𝒢} (a : W' ⟶ U_G g₁) (b : W' ⟶ U_G g₂)
        {E : AddCommGrpCat.{u}}
        (m₁ : E ⟶ F.obj.obj (Opposite.op (U_G g₁)))
        (m₂ : E ⟶ F.obj.obj (Opposite.op (U_G g₂))),
        m₁ ≫ F.obj.map a.op = m₂ ≫ F.obj.map b.op →
        (m₁ ≫ ψ₀ g₁) ≫ G.obj.map a.op =
          (m₂ ≫ ψ₀ g₂) ≫ G.obj.map b.op := by
      intro W' g₁ g₂ a b E m₁ m₂ hm
      obtain ⟨Q, d_cov, h_cov_raw, h_δ₁, h_δ₂, φ₁, φ₂, hh_raw, hφ₁, hφ₂⟩ := hSpan W' g₁ g₂ a b
      let h_cov : ∀ q : Q, U_G (d_cov q) ⟶ W' := h_cov_raw
      have hh : CategoryTheory.Sieve.ofArrows (fun q => U_G (d_cov q)) h_cov ∈
          X.smallEtaleTopology W' := hh_raw
      refine G.property.hom_ext_ofArrows h_cov hh (fun q => ?_)
      have hcomm₁ := hψ₀ g₁ (d_cov q) (h_δ₁ q) (φ₁ q) (h_cov q ≫ a) (hφ₁ q).1 (hφ₁ q).2
      have hcomm₂ := hψ₀ g₂ (d_cov q) (h_δ₂ q) (φ₂ q) (h_cov q ≫ b) (hφ₂ q).1 (hφ₂ q).2
      have hL₁ : ((m₁ ≫ ψ₀ g₁) ≫ G.obj.map a.op) ≫ G.obj.map (h_cov q).op =
          m₁ ≫ (ψ₀ g₁ ≫ G.obj.map (h_cov q ≫ a).op) := by
        rw [op_comp, G.obj.map_comp]
        simp only [CategoryTheory.Category.assoc]
      have hL₂ : m₁ ≫ (ψ₀ g₁ ≫ G.obj.map (h_cov q ≫ a).op) =
          (m₁ ≫ F.obj.map a.op) ≫ (F.obj.map (h_cov q).op ≫ ψ₀ (d_cov q)) := by
        rw [hcomm₁, op_comp, F.obj.map_comp]
        simp only [CategoryTheory.Category.assoc]
      have hR₁ : ((m₂ ≫ ψ₀ g₂) ≫ G.obj.map b.op) ≫ G.obj.map (h_cov q).op =
          m₂ ≫ (ψ₀ g₂ ≫ G.obj.map (h_cov q ≫ b).op) := by
        rw [op_comp, G.obj.map_comp]
        simp only [CategoryTheory.Category.assoc]
      have hR₂ : m₂ ≫ (ψ₀ g₂ ≫ G.obj.map (h_cov q ≫ b).op) =
          (m₂ ≫ F.obj.map b.op) ≫ (F.obj.map (h_cov q).op ≫ ψ₀ (d_cov q)) := by
        rw [hcomm₂, op_comp, F.obj.map_comp]
        simp only [CategoryTheory.Category.assoc]
      rw [hL₁, hL₂, hm, ← hR₂, ← hR₁]
    let I_W : X.Etale → Type u := fun W => (hCov W).choose
    let g_W : ∀ W : X.Etale, I_W W → 𝒢 := fun W => (hCov W).choose_spec.choose
    let f_W : ∀ (W : X.Etale) (i : I_W W), U_G (g_W W i) ⟶ W :=
      fun W => (hCov W).choose_spec.choose_spec.choose
    have hf_W : ∀ W : X.Etale,
        CategoryTheory.Sieve.ofArrows (fun i => U_G (g_W W i)) (f_W W) ∈
          X.smallEtaleTopology W :=
      fun W => (hCov W).choose_spec.choose_spec.choose_spec
    let x_W : ∀ (W : X.Etale) (i : I_W W),
        F.obj.obj (Opposite.op W) ⟶ G.obj.obj (Opposite.op (U_G (g_W W i))) :=
      fun W i => F.obj.map (f_W W i).op ≫ ψ₀ (g_W W i)
    have hx_W : ∀ (W : X.Etale) ⦃W' : X.Etale⦄ ⦃i₁ i₂ : I_W W⦄
        (a : W' ⟶ U_G (g_W W i₁)) (b : W' ⟶ U_G (g_W W i₂)),
        a ≫ f_W W i₁ = b ≫ f_W W i₂ →
        x_W W i₁ ≫ G.obj.map a.op = x_W W i₂ ≫ G.obj.map b.op := by
      intro W W' i₁ i₂ a b hab
      refine hSpanCompat a b (F.obj.map (f_W W i₁).op) (F.obj.map (f_W W i₂).op) ?_
      rw [← F.obj.map_comp, ← op_comp, hab, op_comp, F.obj.map_comp]
    let ψ_W : ∀ W : X.Etale, F.obj.obj (Opposite.op W) ⟶ G.obj.obj (Opposite.op W) :=
      fun W => G.property.amalgamateOfArrows (f_W W) (hf_W W) (x_W W) (hx_W W)
    have hψ_map : ∀ (W : X.Etale) (i : I_W W),
        ψ_W W ≫ G.obj.map (f_W W i).op =
          F.obj.map (f_W W i).op ≫ ψ₀ (g_W W i) :=
      fun W i => G.property.amalgamateOfArrows_map (f_W W) (hf_W W) (x_W W) (hx_W W) i
    have hψ_agree : ∀ g : 𝒢, ψ_W (U_G g) = ψ₀ g := by
      intro g
      refine G.property.hom_ext_ofArrows (f_W (U_G g)) (hf_W (U_G g)) (fun i => ?_)
      rw [hψ_map (U_G g) i]
      have hcomp := hSpanCompat (𝟙 (U_G (g_W (U_G g) i))) (f_W (U_G g) i)
        (F.obj.map (f_W (U_G g) i).op) (𝟙 (F.obj.obj (Opposite.op (U_G g))))
        (by simp)
      simpa using hcomp
    have hψ_nat : ∀ ⦃W₁ W₂ : (X.Etale)ᵒᵖ⦄ (u_op : W₁ ⟶ W₂),
        F.obj.map u_op ≫ ψ_W W₂.unop = ψ_W W₁.unop ≫ G.obj.map u_op := by
      intro W₁ W₂ u_op
      let u : W₂.unop ⟶ W₁.unop := u_op.unop
      have hu_op : u_op = u.op := rfl
      rw [hu_op]
      refine G.property.hom_ext_ofArrows (f_W W₂.unop) (hf_W W₂.unop) (fun i => ?_)
      have hLHS : (F.obj.map u.op ≫ ψ_W W₂.unop) ≫ G.obj.map (f_W W₂.unop i).op =
          F.obj.map (f_W W₂.unop i ≫ u).op ≫ ψ₀ (g_W W₂.unop i) := by
        rw [CategoryTheory.Category.assoc, hψ_map W₂.unop i, op_comp,
          F.obj.map_comp, CategoryTheory.Category.assoc]
      have hRHS : (ψ_W W₁.unop ≫ G.obj.map u.op) ≫ G.obj.map (f_W W₂.unop i).op =
          ψ_W W₁.unop ≫ G.obj.map (f_W W₂.unop i ≫ u).op := by
        rw [CategoryTheory.Category.assoc, ← G.obj.map_comp, ← op_comp]
      rw [hLHS, hRHS]
      let S_pb := (CategoryTheory.Sieve.ofArrows (fun j => U_G (g_W W₁.unop j))
        (f_W W₁.unop)).pullback (f_W W₂.unop i ≫ u)
      have hS_pb : S_pb ∈ X.smallEtaleTopology (U_G (g_W W₂.unop i)) :=
        X.smallEtaleTopology.pullback_stable (f_W W₂.unop i ≫ u) (hf_W W₁.unop)
      refine G.property.hom_ext ⟨S_pb, hS_pb⟩ _ _ (fun I => ?_)
      have hmem : (CategoryTheory.Sieve.ofArrows (fun j => U_G (g_W W₁.unop j))
          (f_W W₁.unop)).arrows (I.f ≫ f_W W₂.unop i ≫ u) := I.hf
      rw [CategoryTheory.Sieve.mem_ofArrows_iff] at hmem
      rcases hmem with ⟨j, b, hfac⟩
      have hR_I : (ψ_W W₁.unop ≫ G.obj.map (f_W W₂.unop i ≫ u).op) ≫ G.obj.map I.f.op =
          (F.obj.map (f_W W₁.unop j).op ≫ ψ₀ (g_W W₁.unop j)) ≫ G.obj.map b.op := by
        calc
          (ψ_W W₁.unop ≫ G.obj.map (f_W W₂.unop i ≫ u).op) ≫ G.obj.map I.f.op
              = ψ_W W₁.unop ≫ G.obj.map (I.f ≫ f_W W₂.unop i ≫ u).op := by
                rw [CategoryTheory.Category.assoc, ← G.obj.map_comp, ← op_comp]
          _ = (ψ_W W₁.unop ≫ G.obj.map (f_W W₁.unop j).op) ≫ G.obj.map b.op := by
                rw [hfac, op_comp, G.obj.map_comp, CategoryTheory.Category.assoc]
          _ = (F.obj.map (f_W W₁.unop j).op ≫ ψ₀ (g_W W₁.unop j)) ≫ G.obj.map b.op := by
                rw [hψ_map W₁.unop j]
      rw [hR_I]
      refine hSpanCompat I.f b (F.obj.map (f_W W₂.unop i ≫ u).op)
        (F.obj.map (f_W W₁.unop j).op) ?_
      rw [← F.obj.map_comp, ← op_comp, hfac, op_comp, F.obj.map_comp]
    refine ⟨⟨{ app := fun W => ψ_W W.unop, naturality := hψ_nat }⟩, fun g => hψ_agree g⟩

  
  
  
  classical
  let L_X : X.Etale → CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u} :=
    fun E => CategoryTheory.Sheaf.freeYoneda X.smallEtaleTopology E A_ℓ
  let map_X : ∀ {E₁ E₂ : X.Etale}, (E₁ ⟶ E₂) → (L_X E₁ ⟶ L_X E₂) :=
    fun {E₁ E₂} u =>
      CategoryTheory.Sheaf.freeYonedaHomEquiv.symm
        (CategoryTheory.CategoryStruct.comp
          (CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id (L_X E₂)))
          ((L_X E₂).obj.map (Opposite.op u)))

  have hFY_comp : ∀ {E : X.Etale}
      {Q H : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
      (α : L_X E ⟶ Q) (ψ : Q ⟶ H),
      CategoryTheory.Sheaf.freeYonedaHomEquiv (α ≫ ψ) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ ψ.hom.app (Opposite.op E) :=
    fun α ψ =>
      (congrArg CategoryTheory.Presheaf.freeYonedaHomEquiv
        (CategoryTheory.Adjunction.homEquiv_naturality_right
          (CategoryTheory.sheafificationAdjunction X.smallEtaleTopology AddCommGrpCat.{u})
          α ψ)).trans
        (CategoryTheory.Presheaf.freeYonedaHomEquiv_comp _ ψ.hom)

  have hFY_map : ∀ {E₁ E₂ : X.Etale} (u : E₁ ⟶ E₂)
      {G : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
      (β : L_X E₂ ⟶ G),
      CategoryTheory.Sheaf.freeYonedaHomEquiv (map_X u ≫ β) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv β ≫ G.obj.map u.op := by
    intro E₁ E₂ u G β
    rw [hFY_comp (map_X u) β]
    dsimp [map_X]
    change (CategoryTheory.Sheaf.freeYonedaHomEquiv
        (CategoryTheory.Sheaf.freeYonedaHomEquiv.symm
          (CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 (L_X E₂)) ≫ (L_X E₂).obj.map u.op))) ≫
        β.hom.app (Opposite.op E₁) = _
    rw [Equiv.apply_symm_apply, CategoryTheory.Category.assoc, β.hom.naturality u.op,
      ← CategoryTheory.Category.assoc, ← hFY_comp (𝟙 (L_X E₂)) β, CategoryTheory.Category.id_comp]

  let one_ℓ : ↑A_ℓ := ULift.up (1 : ZMod ℓ)
  let evHom : ∀ (E : X.Etale)
      (G : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}),
      (L_X E ⟶ G) →+ ↑(G.obj.obj (Opposite.op E)) := fun E G =>
    { toFun := fun α => (CategoryTheory.Sheaf.freeYonedaHomEquiv α) one_ℓ
      map_zero' := by
        have h0 : (0 : L_X E ⟶ G) = 𝟙 (L_X E) ≫ (0 : L_X E ⟶ G) :=
          (CategoryTheory.Category.id_comp _).symm
        rw [h0, hFY_comp]
        rfl
      map_add' := fun α₁ α₂ => by
        have h1 : α₁ + α₂ = 𝟙 (L_X E) ≫ (α₁ + α₂) := (CategoryTheory.Category.id_comp _).symm
        have h2 : α₁ = 𝟙 (L_X E) ≫ α₁ := (CategoryTheory.Category.id_comp _).symm
        have h3 : α₂ = 𝟙 (L_X E) ≫ α₂ := (CategoryTheory.Category.id_comp _).symm
        conv_lhs => rw [h1, hFY_comp]
        conv_rhs => rw [h2, hFY_comp, h3, hFY_comp]
        rfl }

  have evHom_comp : ∀ {E : X.Etale}
      {Q G : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
      (α : L_X E ⟶ Q) (ψ : Q ⟶ G),
      evHom E G (α ≫ ψ) = ψ.hom.app (Opposite.op E) (evHom E Q α) := by
    intro E Q G α ψ
    change (CategoryTheory.Sheaf.freeYonedaHomEquiv (α ≫ ψ)) one_ℓ = _
    rw [hFY_comp]
    rfl

  have evHom_map : ∀ {E₁ E₂ : X.Etale} (u : E₁ ⟶ E₂)
      {G : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
      (β : L_X E₂ ⟶ G),
      evHom E₁ G (map_X u ≫ β) = G.obj.map u.op (evHom E₂ G β) := by
    intro E₁ E₂ u G β
    change (CategoryTheory.Sheaf.freeYonedaHomEquiv (map_X u ≫ β)) one_ℓ = _
    rw [hFY_map]
    rfl

  have evHom_inj : ∀ {E : X.Etale}
      {G : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}},
      Function.Injective (evHom E G) := by
    intro E G α₁ α₂ hEq
    apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
    ext z
    have hz : z.down.val • one_ℓ = z := by
      apply ULift.ext
      change z.down.val • (1 : ZMod ℓ) = z.down
      rw [nsmul_eq_mul, mul_one, ZMod.natCast_zmod_val]
    rw [← hz, map_nsmul, map_nsmul]
    exact congrArg (z.down.val • ·) hEq

  have evHom_tor : ∀ {E : X.Etale}
      {G : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
      (α : L_X E ⟶ G),
      ℓ • evHom E G α = 0 := by
    intro E G α
    change ℓ • (CategoryTheory.Sheaf.freeYonedaHomEquiv α) one_ℓ = 0
    rw [← map_nsmul]
    have h_ell_one : ℓ • one_ℓ = 0 := by
      apply ULift.ext
      change ℓ • (1 : ZMod ℓ) = 0
      rw [nsmul_eq_mul, mul_one, CharP.cast_eq_zero]
    rw [h_ell_one, map_zero]

  let liftGrp : ∀ {E : X.Etale}
      {G : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
      (σ : ↑(G.obj.obj (Opposite.op E))),
      ℓ • σ = 0 → (A_ℓ ⟶ G.obj.obj (Opposite.op E)) := fun {E G} σ hσ =>
    AddCommGrpCat.ofHom
      { toFun := fun z => z.down.val • σ
        map_zero' := by
          change (0 : ZMod ℓ).val • σ = 0
          rw [ZMod.val_zero, zero_nsmul]
        map_add' := fun x y => by
          have : NeZero ℓ := ⟨(Fact.out : Nat.Prime ℓ).ne_zero⟩
          have hmul0 : ∀ k : ℕ, (ℓ * k) • σ = 0 := by
            intro k
            induction k with
            | zero => simp
            | succ k ih => rw [Nat.mul_succ, add_nsmul, ih, hσ, zero_add]
          have hdiv := Nat.div_add_mod (x.down.val + y.down.val) ℓ
          change (x.down + y.down).val • σ = x.down.val • σ + y.down.val • σ
          rw [← add_nsmul, ← hdiv, add_nsmul, hmul0, zero_add, ZMod.val_add] }

  let liftHom : ∀ {E : X.Etale}
      {G : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
      (σ : ↑(G.obj.obj (Opposite.op E))),
      ℓ • σ = 0 → (L_X E ⟶ G) := fun {E G} σ hσ =>
    CategoryTheory.Sheaf.freeYonedaHomEquiv.symm (liftGrp σ hσ)

  have evHom_lift : ∀ {E : X.Etale}
      {G : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
      (σ : ↑(G.obj.obj (Opposite.op E))) (hσ : ℓ • σ = 0),
      evHom E G (liftHom σ hσ) = σ := by
    intro E G σ hσ
    have : Fact (1 < ℓ) := ⟨Nat.Prime.one_lt Fact.out⟩
    have heq := congrArg (fun f : A_ℓ ⟶ G.obj.obj (Opposite.op E) => f one_ℓ)
      (CategoryTheory.Sheaf.freeYonedaHomEquiv.apply_symm_apply (liftGrp σ hσ))
    refine heq.trans ?_
    change (1 : ZMod ℓ).val • σ = σ
    rw [ZMod.val_one, one_nsmul]

  let castU : ∀ (G : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u})
      {g₁ g₂ : 𝒢}, g₁ = g₂ →
      ↑(G.obj.obj (Opposite.op (U_G g₁))) →+ ↑(G.obj.obj (Opposite.op (U_G g₂))) :=
    fun G {g₁ g₂} h =>
      { toFun := fun x => G.obj.map (eqToHom (congrArg U_G h.symm)).op x
        map_zero' := by simp
        map_add' := fun x y => by simp }

  have castU_rfl : ∀ (G : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u})
      {g : 𝒢} (x : ↑(G.obj.obj (Opposite.op (U_G g)))),
      castU G (rfl : g = g) x = x := by
    intro G g x; simp [castU]

  have castU_trans : ∀ (G : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u})
      {g₁ g₂ g₃ : 𝒢} (h₁ : g₁ = g₂) (h₂ : g₂ = g₃)
      (x : ↑(G.obj.obj (Opposite.op (U_G g₁)))),
      castU G h₂ (castU G h₁ x) = castU G (h₁.trans h₂) x := by
    intro G g₁ g₂ g₃ h₁ h₂ x; subst h₁; subst h₂; simp [castU]

  have castU_inj : ∀ (G : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u})
      {g₁ g₂ : 𝒢} (h : g₁ = g₂) {x y : ↑(G.obj.obj (Opposite.op (U_G g₁)))},
      castU G h x = castU G h y → x = y := by
    intro G g₁ g₂ h x y hxy; subst h; simpa [castU] using hxy

  have castU_nat : ∀ {Q G : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
      (ξ : Q ⟶ G) {g₁ g₂ : 𝒢} (h : g₁ = g₂)
      (x : ↑(Q.obj.obj (Opposite.op (U_G g₁)))),
      ξ.hom.app (Opposite.op (U_G g₂)) (castU Q h x) =
        castU G h (ξ.hom.app (Opposite.op (U_G g₁)) x) := by
    intro Q G ξ g₁ g₂ h x; subst h; simp [castU]

  let Sec : 𝒢 → Type u := fun g => ↑(F.obj.obj (Opposite.op (U_G g)))
  let J₀ : Type u := Σ g : 𝒢, Sec g
  let J_add : Type u := Σ g : 𝒢, Sec g × Sec g
  let Hom_G : 𝒢 → 𝒢 → Type u := fun g₁ g₂ =>
    { φ : R_G g₁ →+* R_G g₂ //
      ∃ h_δ : δ_G g₁ = δ_G g₂ ∨ δ_G g₂ = 2,
        φ.comp (algebraMap (S_ch (δ_G g₁)) (R_G g₁)) =
          (algebraMap (S_ch (δ_G g₂)) (R_G g₂)).comp (τ (δ_G g₁) (δ_G g₂) h_δ) }
  let J_res : Type u := Σ (g₁ : 𝒢) (g₂ : 𝒢), Hom_G g₁ g₂ × Sec g₁
  let J₁ : Type u := J_add ⊕ J_res

  let u_can : ∀ {g₁ g₂ : 𝒢}, Hom_G g₁ g₂ → (U_G g₂ ⟶ U_G g₁) := fun {g₁ g₂} φ_sub =>
    CategoryTheory.MorphismProperty.Over.homMk
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_sub.1))
      (by
        obtain ⟨h_δ, hφ⟩ := φ_sub.2
        change AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_sub.1) ≫
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap (S_ch (δ_G g₁)) (R_G g₁))) ≫ j (δ_G g₁)) =
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap (S_ch (δ_G g₂)) (R_G g₂))) ≫ j (δ_G g₂)
        rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp, hφ, CommRingCat.ofHom_comp,
          AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc,
          hτ_comp (δ_G g₁) (δ_G g₂) h_δ])

  have hu_can_eq : ∀ {g₁ g₂ : 𝒢} (φ_sub : Hom_G g₁ g₂) (u : U_G g₂ ⟶ U_G g₁),
      ((AlgebraicGeometry.Scheme.Etale.forget X).map u).left =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_sub.1) →
      u = u_can φ_sub :=
    fun _ _ hu => CategoryTheory.MorphismProperty.Over.Hom.ext hu

  let homOfEq : ∀ {g₁ g₂ : 𝒢}, g₁ = g₂ → Hom_G g₁ g₂ := fun {g₁ g₂} hg =>
    hg ▸ ⟨RingHom.id (R_G g₁),
      ⟨Or.inl rfl, by rw [hτ_id (δ_G g₁), RingHom.id_comp, RingHom.comp_id]⟩⟩

  have u_can_homOfEq_map : ∀ (G : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u})
      {g₁ g₂ : 𝒢} (hg : g₁ = g₂) (x : ↑(G.obj.obj (Opposite.op (U_G g₁)))),
      G.obj.map (u_can (homOfEq hg)).op x = castU G hg x := by
    intro G g₁ g₂ hg x
    subst hg
    have hu : u_can (homOfEq (rfl : g₁ = g₁)) = 𝟙 (U_G g₁) := by
      apply CategoryTheory.MorphismProperty.Over.Hom.ext
      exact AlgebraicGeometry.Spec.map_id (CommRingCat.of (R_G g₁))
    rw [hu]
    simp [castU]

  let transportHom : ∀ {g₁ g₂ g₁' g₂' : 𝒢},
      g₁' = g₁ → g₂' = g₂ → Hom_G g₁ g₂ → Hom_G g₁' g₂' :=
    fun h₁ h₂ φ_sub => h₁ ▸ h₂ ▸ φ_sub

  have u_can_transportHom_map : ∀ (G : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u})
      {g₁ g₂ g₁' g₂' : 𝒢} (h₁ : g₁' = g₁) (h₂ : g₂' = g₂) (φ_sub : Hom_G g₁ g₂)
      (x : ↑(G.obj.obj (Opposite.op (U_G g₁')))),
      castU G h₂ (G.obj.map (u_can (transportHom h₁ h₂ φ_sub)).op x) =
        G.obj.map (u_can φ_sub).op (castU G h₁ x) := by
    intro G g₁ g₂ g₁' g₂' h₁ h₂ φ_sub x
    subst h₁; subst h₂
    simp [transportHom, castU]

  let ClosedAdd : Finset J₀ → Finset J₁ → Prop := fun I₀ I₁ =>
    ∀ {g : 𝒢} {σ₁ σ₂ : Sec g},
      (Sum.inl ⟨g, (σ₁, σ₂)⟩ : J₁) ∈ I₁ →
      (⟨g, σ₁⟩ : J₀) ∈ I₀ ∧ (⟨g, σ₂⟩ : J₀) ∈ I₀ ∧ (⟨g, σ₁ + σ₂⟩ : J₀) ∈ I₀

  let ClosedRes : Finset J₀ → Finset J₁ → Prop := fun I₀ I₁ =>
    ∀ {g₁ g₂ : 𝒢} {φ_sub : Hom_G g₁ g₂} {σ : Sec g₁},
      (Sum.inr ⟨g₁, g₂, (φ_sub, σ)⟩ : J₁) ∈ I₁ →
      (⟨g₁, σ⟩ : J₀) ∈ I₀ ∧ (⟨g₂, F.obj.map (u_can φ_sub).op σ⟩ : J₀) ∈ I₀

  have hStage : ∀ (I₀ : Finset J₀) (I₁ : Finset J₁)
      (ha : ClosedAdd I₀ I₁) (hr : ClosedRes I₀ I₁),
      ∃ (Q : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u})
        (e : ∀ (i : J₀), i ∈ I₀ → ↑(Q.obj.obj (Opposite.op (U_G i.1)))),
        (∃ (N m n r : ℕ) (δ_l : Fin N → Fin 3)
          (C_l : Fin N → Type u) (hRingC : ∀ c, CommRing (C_l c)),
          letI : ∀ c, CommRing (C_l c) := hRingC
          ∃ (hAlgC : ∀ c, Algebra (S_ch (δ_l c)) (C_l c)),
          letI : ∀ c, Algebra (S_ch (δ_l c)) (C_l c) := hAlgC
          ∃ (hEtSpecC : ∀ c, AlgebraicGeometry.Etale
              (AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (algebraMap (S_ch (δ_l c)) (C_l c)))))
            (_ : ∀ c, Algebra.Etale (S_ch (δ_l c)) (C_l c)),
          letI : ∀ c, AlgebraicGeometry.Etale
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap (S_ch (δ_l c)) (C_l c)))) := hEtSpecC
          letI : CategoryTheory.Limits.HasFiniteBiproducts
              (CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}) :=
            CategoryTheory.Abelian.hasFiniteBiproducts
          let E_X : Fin N → X.Etale := fun c =>
            CategoryTheory.MorphismProperty.Over.mk ⊤
              (AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (algebraMap (S_ch (δ_l c)) (C_l c))) ≫ j (δ_l c))
              inferInstance
          let L_X := fun E : X.Etale => CategoryTheory.Sheaf.freeYoneda X.smallEtaleTopology E A_ℓ
          let map_X := fun {E₁ E₂ : X.Etale} (u : E₁ ⟶ E₂) =>
            CategoryTheory.Sheaf.freeYonedaHomEquiv.symm
              (CategoryTheory.CategoryStruct.comp
                (CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id (L_X E₂)))
                ((L_X E₂).obj.map (Opposite.op u)))
          ∃ (v_idx : Fin m → Fin N) (u_idx : Fin n → Fin N)
            (src_rel : Fin r → Fin m) (tgt_gen : Fin r → Fin n) (coeff : Fin r → ℤ)
            (h_step : ∀ t : Fin r,
              δ_l (u_idx (tgt_gen t)) = δ_l (v_idx (src_rel t)) ∨
                δ_l (v_idx (src_rel t)) = 2)
            (φ_l : ∀ t : Fin r, C_l (u_idx (tgt_gen t)) →+* C_l (v_idx (src_rel t)))
            (_ : ∀ t : Fin r,
              (φ_l t).comp (algebraMap (S_ch (δ_l (u_idx (tgt_gen t)))) (C_l (u_idx (tgt_gen t)))) =
                (algebraMap (S_ch (δ_l (v_idx (src_rel t)))) (C_l (v_idx (src_rel t)))).comp
                  (τ _ _ (h_step t))),
            (∀ (u_l : ∀ t : Fin r, E_X (v_idx (src_rel t)) ⟶ E_X (u_idx (tgt_gen t))),
              (∀ t : Fin r,
                ((AlgebraicGeometry.Scheme.Etale.forget X).map (u_l t)).left =
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_l t))) →
              let Θ_l : (⨁ fun a : Fin m => L_X (E_X (v_idx a))) ⟶
                  (⨁ fun b : Fin n => L_X (E_X (u_idx b))) :=
                ∑ t : Fin r, coeff t •
                  (CategoryTheory.Limits.biproduct.π (fun a : Fin m => L_X (E_X (v_idx a)))
                      (src_rel t) ≫
                    map_X (u_l t) ≫
                    CategoryTheory.Limits.biproduct.ι (fun b : Fin n => L_X (E_X (u_idx b)))
                      (tgt_gen t))
              Nonempty (CategoryTheory.Limits.cokernel Θ_l ≅ Q))) ∧
        (∀ {G : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
          (ξ₁ ξ₂ : Q ⟶ G),
          (∀ (i : J₀) (hi : i ∈ I₀),
            ξ₁.hom.app (Opposite.op (U_G i.1)) (e i hi) =
              ξ₂.hom.app (Opposite.op (U_G i.1)) (e i hi)) →
          ξ₁ = ξ₂) ∧
        ((∀ (i : J₀) (hi : i ∈ I₀), ℓ • e i hi = 0) ∧
          (∀ {g : 𝒢} {σ₁ σ₂ : Sec g} (h : (Sum.inl ⟨g, (σ₁, σ₂)⟩ : J₁) ∈ I₁),
            e ⟨g, σ₁ + σ₂⟩ (ha h).2.2 =
              e ⟨g, σ₁⟩ (ha h).1 + e ⟨g, σ₂⟩ (ha h).2.1) ∧
          (∀ {g₁ g₂ : 𝒢} {φ_sub : Hom_G g₁ g₂} {σ : Sec g₁}
            (h : (Sum.inr ⟨g₁, g₂, (φ_sub, σ)⟩ : J₁) ∈ I₁),
            Q.obj.map (u_can φ_sub).op (e ⟨g₁, σ⟩ (hr h).1) =
              e ⟨g₂, F.obj.map (u_can φ_sub).op σ⟩ (hr h).2)) ∧
        (∀ (G : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u})
          (s : ∀ (i : J₀), i ∈ I₀ → ↑(G.obj.obj (Opposite.op (U_G i.1)))),
          (∀ (i : J₀) (hi : i ∈ I₀), ℓ • s i hi = 0) →
          (∀ {g : 𝒢} {σ₁ σ₂ : Sec g} (h : (Sum.inl ⟨g, (σ₁, σ₂)⟩ : J₁) ∈ I₁),
            s ⟨g, σ₁ + σ₂⟩ (ha h).2.2 =
              s ⟨g, σ₁⟩ (ha h).1 + s ⟨g, σ₂⟩ (ha h).2.1) →
          (∀ {g₁ g₂ : 𝒢} {φ_sub : Hom_G g₁ g₂} {σ : Sec g₁}
            (h : (Sum.inr ⟨g₁, g₂, (φ_sub, σ)⟩ : J₁) ∈ I₁),
            G.obj.map (u_can φ_sub).op (s ⟨g₁, σ⟩ (hr h).1) =
              s ⟨g₂, F.obj.map (u_can φ_sub).op σ⟩ (hr h).2) →
          ∃ ξ : Q ⟶ G,
            ∀ (i : J₀) (hi : i ∈ I₀),
              ξ.hom.app (Opposite.op (U_G i.1)) (e i hi) = s i hi) := by
    intro I₀ I₁ ha hr
    have : CategoryTheory.Limits.HasFiniteBiproducts
        (CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}) :=
      CategoryTheory.Abelian.hasFiniteBiproducts
    let n : ℕ := Fintype.card ↥I₀
    let m : ℕ := Fintype.card ↥I₁
    obtain ⟨e₀, -⟩ : ∃ e₀ : ↥I₀ ≃ Fin n, True := ⟨Fintype.equivFin ↥I₀, trivial⟩
    obtain ⟨e₁, -⟩ : ∃ e₁ : ↥I₁ ≃ Fin m, True := ⟨Fintype.equivFin ↥I₁, trivial⟩
    let gen : Fin n → J₀ := fun b => (e₀.symm b).1
    have gen_mem : ∀ b : Fin n, gen b ∈ I₀ := fun b => (e₀.symm b).2
    have he₀_gen : ∀ (i : J₀) (hi : i ∈ I₀), gen (e₀ ⟨i, hi⟩) = i :=
      fun i hi => congrArg Subtype.val (e₀.symm_apply_apply ⟨i, hi⟩)
    have he₀_fst : ∀ (i : J₀) (hi : i ∈ I₀), (gen (e₀ ⟨i, hi⟩)).1 = i.1 :=
      fun i hi => congrArg Sigma.fst (he₀_gen i hi)
    let δ_l : Fin n → Fin 3 := fun b => δ_G (gen b).1
    let C_l : Fin n → Type u := fun b => R_G (gen b).1
    let E_X : Fin n → X.Etale := fun b => U_G (gen b).1
    let v_of_rel : ∀ (rel : J₁), rel ∈ I₁ → Fin n := fun rel hm =>
      match rel, hm with
      | Sum.inl ⟨g, (σ₁, σ₂)⟩, hm => e₀ ⟨⟨g, σ₁ + σ₂⟩, (ha hm).2.2⟩
      | Sum.inr ⟨g₁, g₂, (φ_sub, σ)⟩, hm => e₀ ⟨⟨g₂, F.obj.map (u_can φ_sub).op σ⟩, (hr hm).2⟩
    let row_of_rel : ∀ (rel : J₁) (hm : rel ∈ I₁) (k : Fin 3),
        Σ (b : Fin n), ℤ × Hom_G (gen b).1 (gen (v_of_rel rel hm)).1 := fun rel hm k =>
      match rel, hm with
      | Sum.inl ⟨g, (σ₁, σ₂)⟩, hm =>
          let b₁ : Fin n := e₀ ⟨⟨g, σ₁⟩, (ha hm).1⟩
          let b₂ : Fin n := e₀ ⟨⟨g, σ₂⟩, (ha hm).2.1⟩
          let b₃ : Fin n := e₀ ⟨⟨g, σ₁ + σ₂⟩, (ha hm).2.2⟩
          let hgv : (gen b₃).1 = g := he₀_fst ⟨g, σ₁ + σ₂⟩ (ha hm).2.2
          if k.1 = 0 then ⟨b₁, (1, homOfEq ((he₀_fst ⟨g, σ₁⟩ (ha hm).1).trans hgv.symm))⟩
          else if k.1 = 1 then ⟨b₂, (1, homOfEq ((he₀_fst ⟨g, σ₂⟩ (ha hm).2.1).trans hgv.symm))⟩
          else ⟨b₃, (-1, homOfEq rfl)⟩
      | Sum.inr ⟨g₁, g₂, (φ_sub, σ)⟩, hm =>
          let b₁ : Fin n := e₀ ⟨⟨g₁, σ⟩, (hr hm).1⟩
          let b₂ : Fin n := e₀ ⟨⟨g₂, F.obj.map (u_can φ_sub).op σ⟩, (hr hm).2⟩
          let hgv : (gen b₂).1 = g₂ := he₀_fst ⟨g₂, F.obj.map (u_can φ_sub).op σ⟩ (hr hm).2
          if k.1 = 0 then ⟨b₁, (1, transportHom (he₀_fst ⟨g₁, σ⟩ (hr hm).1) hgv φ_sub)⟩
          else if k.1 = 1 then ⟨b₂, (-1, homOfEq rfl)⟩
          else ⟨b₂, (0, homOfEq rfl)⟩
    let vOfSub : ↥I₁ → Fin n := fun p => v_of_rel p.1 p.2
    let rowOfSub : ∀ (p : ↥I₁) (k : Fin 3),
        Σ (b : Fin n), ℤ × Hom_G (gen b).1 (gen (vOfSub p)).1 :=
      fun p k => row_of_rel p.1 p.2 k
    let v_idx : Fin m → Fin n := fun a => vOfSub (e₁.symm a)
    let rowEntry : ∀ (a : Fin m) (k : Fin 3),
        Σ (b : Fin n), ℤ × Hom_G (gen b).1 (gen (v_idx a)).1 :=
      fun a k => rowOfSub (e₁.symm a) k
    let r : ℕ := m * 3
    let src_rel : Fin r → Fin m := fun t => (finProdFinEquiv.symm t).1
    let tgt_gen : Fin r → Fin n := fun t =>
      (rowEntry (finProdFinEquiv.symm t).1 (finProdFinEquiv.symm t).2).1
    let coeff : Fin r → ℤ := fun t =>
      (rowEntry (finProdFinEquiv.symm t).1 (finProdFinEquiv.symm t).2).2.1
    let φ_entry : ∀ t : Fin r, Hom_G (gen (tgt_gen t)).1 (gen (v_idx (src_rel t))).1 :=
      fun t => (rowEntry (finProdFinEquiv.symm t).1 (finProdFinEquiv.symm t).2).2.2
    let u_row : ∀ t : Fin r,
        U_G (gen (v_idx (src_rel t))).1 ⟶ U_G (gen (tgt_gen t)).1 :=
      fun t => u_can (φ_entry t)
    let V_fam : Fin m → CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u} :=
      fun a => L_X (U_G (gen (v_idx a)).1)
    let U_fam : Fin n → CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u} :=
      fun b => L_X (U_G (gen b).1)
    let Θ_can : (⨁ V_fam) ⟶ (⨁ U_fam) :=
      ∑ t : Fin r, coeff t •
        (CategoryTheory.Limits.biproduct.π V_fam (src_rel t) ≫
          map_X (u_row t) ≫
          CategoryTheory.Limits.biproduct.ι U_fam (tgt_gen t))
    let Q : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u} :=
      CategoryTheory.Limits.cokernel Θ_can
    let π_Q : (⨁ U_fam) ⟶ Q := CategoryTheory.Limits.cokernel.π Θ_can
    let e : ∀ (i : J₀), i ∈ I₀ → ↑(Q.obj.obj (Opposite.op (U_G i.1))) :=
      fun i hi =>
        castU Q (he₀_fst i hi)
          (evHom (U_G (gen (e₀ ⟨i, hi⟩)).1) Q
            (CategoryTheory.Limits.biproduct.ι U_fam (e₀ ⟨i, hi⟩) ≫ π_Q))

    
    let rowSumVal : ∀ {G : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}},
        ((⨁ U_fam) ⟶ G) → ↥I₁ → Prop := fun {G} Φ p =>
      ∑ k : Fin 3,
        (rowOfSub p k).2.1 •
          G.obj.map (u_can (rowOfSub p k).2.2).op
            (evHom (U_G (gen (rowOfSub p k).1).1) G
              (CategoryTheory.Limits.biproduct.ι U_fam (rowOfSub p k).1 ≫ Φ)) = 0

    have hRowEval : ∀ {G : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
        (Φ : (⨁ U_fam) ⟶ G) (a₀ : Fin m),
        evHom (U_G (gen (v_idx a₀)).1) G
          (CategoryTheory.Limits.biproduct.ι V_fam a₀ ≫ Θ_can ≫ Φ) =
          ∑ k : Fin 3,
            (rowEntry a₀ k).2.1 •
              G.obj.map (u_can (rowEntry a₀ k).2.2).op
                (evHom (U_G (gen (rowEntry a₀ k).1).1) G
                  (CategoryTheory.Limits.biproduct.ι U_fam (rowEntry a₀ k).1 ≫ Φ)) := by
      intro G Φ a₀
      let term : Fin r → (L_X (U_G (gen (v_idx a₀)).1) ⟶ G) := fun t =>
        coeff t •
          ((CategoryTheory.Limits.biproduct.ι V_fam a₀ ≫
              CategoryTheory.Limits.biproduct.π V_fam (src_rel t)) ≫
            map_X (u_row t) ≫
            CategoryTheory.Limits.biproduct.ι U_fam (tgt_gen t) ≫ Φ)
      have hPush : CategoryTheory.Limits.biproduct.ι V_fam a₀ ≫ Θ_can ≫ Φ =
          ∑ t : Fin r, term t := by
        dsimp [Θ_can, term]
        rw [CategoryTheory.Preadditive.sum_comp, CategoryTheory.Preadditive.comp_sum]
        refine Finset.sum_congr rfl (fun t _ => ?_)
        rw [CategoryTheory.Preadditive.zsmul_comp, CategoryTheory.Preadditive.comp_zsmul]
        simp only [CategoryTheory.Category.assoc]
      rw [hPush, map_sum]
      rw [← Fintype.sum_equiv finProdFinEquiv
        (fun p : Fin m × Fin 3 => evHom (U_G (gen (v_idx a₀)).1) G (term (finProdFinEquiv p)))
        (fun t : Fin r => evHom (U_G (gen (v_idx a₀)).1) G (term t)) (fun _ => rfl)]
      rw [Fintype.sum_prod_type]
      rw [Fintype.sum_eq_single a₀]
      · refine Finset.sum_congr rfl (fun k _ => ?_)
        have h_term_eq : term (finProdFinEquiv (a₀, k)) =
            (rowEntry a₀ k).2.1 •
              (map_X (u_can (rowEntry a₀ k).2.2) ≫
                CategoryTheory.Limits.biproduct.ι U_fam (rowEntry a₀ k).1 ≫ Φ) := by
          dsimp [term, coeff, src_rel, u_row, φ_entry, tgt_gen]
          generalize hp : finProdFinEquiv.symm (finProdFinEquiv (a₀, k)) = p
          have hp_eq : p = (a₀, k) := hp.symm.trans (finProdFinEquiv.symm_apply_apply (a₀, k))
          subst hp_eq
          rw [CategoryTheory.Limits.biproduct.ι_π_self, CategoryTheory.Category.id_comp]
        rw [h_term_eq, map_zsmul, evHom_map]
      · intro a ha
        refine Finset.sum_eq_zero (fun k _ => ?_)
        have h_term_zero : term (finProdFinEquiv (a, k)) = 0 := by
          dsimp [term, coeff, src_rel, u_row, φ_entry, tgt_gen]
          generalize hp : finProdFinEquiv.symm (finProdFinEquiv (a, k)) = p
          have hp_eq : p = (a, k) := hp.symm.trans (finProdFinEquiv.symm_apply_apply (a, k))
          subst hp_eq
          rw [CategoryTheory.Limits.biproduct.ι_π_ne V_fam ha.symm,
            CategoryTheory.Limits.zero_comp, zsmul_zero]
        rw [h_term_zero, map_zero]

    have hRelEval : ∀ (rel₀ : J₁) (hm₀ : rel₀ ∈ I₁),
        rowSumVal π_Q ⟨rel₀, hm₀⟩ := by
      intro rel₀ hm₀
      let a₀ : Fin m := e₁ ⟨rel₀, hm₀⟩
      have hzero : evHom (U_G (gen (v_idx a₀)).1) Q
          (CategoryTheory.Limits.biproduct.ι V_fam a₀ ≫ Θ_can ≫ π_Q) = 0 := by
        rw [CategoryTheory.Limits.cokernel.condition, CategoryTheory.Limits.comp_zero, map_zero]
      have h₀ : rowSumVal π_Q (e₁.symm a₀) := (hRowEval π_Q a₀).symm.trans hzero
      rwa [e₁.symm_apply_apply ⟨rel₀, hm₀⟩] at h₀

    refine ⟨Q, e, ?_, ?_, ⟨?_, ?_, ?_⟩, ?_⟩
    · 
      refine ⟨n, m, n, r, δ_l, C_l, fun b => inferInstance, fun b => inferInstance,
        fun b => hEtSpecG (gen b).1, fun b => hEtAlgG (gen b).1,
        v_idx, id, src_rel, tgt_gen, coeff,
        fun t => (φ_entry t).2.choose, fun t => (φ_entry t).1,
        fun t => (φ_entry t).2.choose_spec, ?_⟩
      intro u_l hu_l
      have hu_eq : u_l = u_row := funext fun t => hu_can_eq (φ_entry t) (u_l t) (hu_l t)
      subst hu_eq
      exact ⟨CategoryTheory.Iso.refl Q⟩
    · 
      intro G ξ₁ ξ₂ hEq
      apply CategoryTheory.Limits.coequalizer.hom_ext
      apply CategoryTheory.Limits.biproduct.hom_ext'
      intro b
      apply evHom_inj
      have hb_idx : e₀ ⟨gen b, gen_mem b⟩ = b := e₀.apply_symm_apply b
      have h_eval := hEq (gen b) (gen_mem b)
      dsimp [e] at h_eval
      rw [castU_nat ξ₁ (he₀_fst (gen b) (gen_mem b)),
        castU_nat ξ₂ (he₀_fst (gen b) (gen_mem b))] at h_eval
      have h_un := castU_inj G (he₀_fst (gen b) (gen_mem b)) h_eval
      rw [← evHom_comp, ← evHom_comp, CategoryTheory.Category.assoc,
        CategoryTheory.Category.assoc] at h_un
      generalize hb₀ : e₀ ⟨gen b, gen_mem b⟩ = b₀ at h_un
      rw [hb_idx] at hb₀
      subst hb₀
      exact h_un
    · 
      intro i hi
      dsimp [e]
      rw [← map_nsmul, evHom_tor, map_zero]
    · 
      intro g σ₁ σ₂ hm
      have hzero : rowSumVal π_Q ⟨Sum.inl ⟨g, (σ₁, σ₂)⟩, hm⟩ :=
        hRelEval (Sum.inl ⟨g, (σ₁, σ₂)⟩) hm
      dsimp [rowSumVal] at hzero
      rw [Fin.sum_univ_three] at hzero
      dsimp [rowOfSub, vOfSub, row_of_rel, v_of_rel] at hzero
      let h₁ := he₀_fst ⟨g, σ₁⟩ (ha hm).1
      let h₂ := he₀_fst ⟨g, σ₂⟩ (ha hm).2.1
      have hgv : (gen (e₀ ⟨⟨g, σ₁ + σ₂⟩, (ha hm).2.2⟩)).1 = g :=
        he₀_fst ⟨g, σ₁ + σ₂⟩ (ha hm).2.2
      have hc := congrArg (castU Q hgv) hzero
      rw [map_zero, map_add, map_add, one_zsmul, one_zsmul, neg_one_zsmul,
        u_can_homOfEq_map Q (h₁.trans hgv.symm),
        u_can_homOfEq_map Q (h₂.trans hgv.symm),
        u_can_homOfEq_map Q rfl,
        castU_trans Q (h₁.trans hgv.symm) hgv,
        castU_trans Q (h₂.trans hgv.symm) hgv,
        map_neg,
        castU_trans Q rfl hgv] at hc
      have he₁_eq : castU Q ((h₁.trans hgv.symm).trans hgv)
          (evHom _ Q (CategoryTheory.Limits.biproduct.ι U_fam (e₀ ⟨⟨g, σ₁⟩, (ha hm).1⟩) ≫ π_Q)) =
          e ⟨g, σ₁⟩ (ha hm).1 := rfl
      have he₂_eq : castU Q ((h₂.trans hgv.symm).trans hgv)
          (evHom _ Q (CategoryTheory.Limits.biproduct.ι U_fam (e₀ ⟨⟨g, σ₂⟩, (ha hm).2.1⟩) ≫ π_Q)) =
          e ⟨g, σ₂⟩ (ha hm).2.1 := rfl
      have he₃_eq : castU Q ((rfl : _ = _).trans hgv)
          (evHom _ Q (CategoryTheory.Limits.biproduct.ι U_fam (e₀ ⟨⟨g, σ₁ + σ₂⟩, (ha hm).2.2⟩) ≫ π_Q)) =
          e ⟨g, σ₁ + σ₂⟩ (ha hm).2.2 := rfl
      rw [he₁_eq, he₂_eq, he₃_eq] at hc
      calc
        e ⟨g, σ₁ + σ₂⟩ (ha hm).2.2
            = (e ⟨g, σ₁⟩ (ha hm).1 + e ⟨g, σ₂⟩ (ha hm).2.1) -
                (e ⟨g, σ₁⟩ (ha hm).1 + e ⟨g, σ₂⟩ (ha hm).2.1 +
                  -e ⟨g, σ₁ + σ₂⟩ (ha hm).2.2) := by abel
        _ = (e ⟨g, σ₁⟩ (ha hm).1 + e ⟨g, σ₂⟩ (ha hm).2.1) - 0 := by rw [hc]
        _ = e ⟨g, σ₁⟩ (ha hm).1 + e ⟨g, σ₂⟩ (ha hm).2.1 := sub_zero _
    · 
      intro g₁ g₂ φ_sub σ hm
      have hzero : rowSumVal π_Q ⟨Sum.inr ⟨g₁, g₂, (φ_sub, σ)⟩, hm⟩ :=
        hRelEval (Sum.inr ⟨g₁, g₂, (φ_sub, σ)⟩) hm
      dsimp [rowSumVal] at hzero
      rw [Fin.sum_univ_three] at hzero
      dsimp [rowOfSub, vOfSub, row_of_rel, v_of_rel] at hzero
      let h₁ := he₀_fst ⟨g₁, σ⟩ (hr hm).1
      have hgv : (gen (e₀ ⟨⟨g₂, F.obj.map (u_can φ_sub).op σ⟩, (hr hm).2⟩)).1 = g₂ :=
        he₀_fst ⟨g₂, F.obj.map (u_can φ_sub).op σ⟩ (hr hm).2
      have hc := congrArg (castU Q hgv) hzero
      rw [map_zero, map_add, map_add, one_zsmul, neg_one_zsmul, zero_zsmul,
        map_zero, add_zero,
        u_can_transportHom_map Q h₁ hgv φ_sub,
        map_neg,
        u_can_homOfEq_map Q rfl,
        castU_trans Q rfl hgv] at hc
      have he₁_eq : castU Q h₁
          (evHom _ Q (CategoryTheory.Limits.biproduct.ι U_fam (e₀ ⟨⟨g₁, σ⟩, (hr hm).1⟩) ≫ π_Q)) =
          e ⟨g₁, σ⟩ (hr hm).1 := rfl
      have he₂_eq : castU Q ((rfl : _ = _).trans hgv)
          (evHom _ Q (CategoryTheory.Limits.biproduct.ι U_fam
            (e₀ ⟨⟨g₂, F.obj.map (u_can φ_sub).op σ⟩, (hr hm).2⟩) ≫ π_Q)) =
          e ⟨g₂, F.obj.map (u_can φ_sub).op σ⟩ (hr hm).2 := rfl
      rw [he₁_eq, he₂_eq] at hc
      calc
        Q.obj.map (u_can φ_sub).op (e ⟨g₁, σ⟩ (hr hm).1)
            = e ⟨g₂, F.obj.map (u_can φ_sub).op σ⟩ (hr hm).2 +
                (Q.obj.map (u_can φ_sub).op (e ⟨g₁, σ⟩ (hr hm).1) +
                  -e ⟨g₂, F.obj.map (u_can φ_sub).op σ⟩ (hr hm).2) := by abel
        _ = e ⟨g₂, F.obj.map (u_can φ_sub).op σ⟩ (hr hm).2 + 0 := by rw [hc]
        _ = e ⟨g₂, F.obj.map (u_can φ_sub).op σ⟩ (hr hm).2 := add_zero _
    · 
      intro G s hs_tor hs_add hs_res
      let Φ : (⨁ U_fam) ⟶ G :=
        CategoryTheory.Limits.biproduct.desc fun b =>
          liftHom (s (gen b) (gen_mem b)) (hs_tor (gen b) (gen_mem b))
      have castU_s_eq : ∀ (p₁ p₂ : ↥I₀) (hp : p₁ = p₂) (h₁ : p₁.1.1 = p₂.1.1),
          castU G h₁ (s p₁.1 p₁.2) = s p₂.1 p₂.2 := by
        intro p₁ p₂ hp h₁
        subst hp
        exact castU_rfl G (s p₁.1 p₁.2)
      have hΦ_eval : ∀ (i : J₀) (hi : i ∈ I₀),
          castU G (he₀_fst i hi)
            (evHom (U_G (gen (e₀ ⟨i, hi⟩)).1) G
              (CategoryTheory.Limits.biproduct.ι U_fam (e₀ ⟨i, hi⟩) ≫ Φ)) = s i hi := by
        intro i hi
        dsimp [Φ]
        rw [CategoryTheory.Limits.biproduct.ι_desc,
          evHom_lift _ (hs_tor (gen (e₀ ⟨i, hi⟩)) (gen_mem (e₀ ⟨i, hi⟩)))]
        exact castU_s_eq (e₀.symm (e₀ ⟨i, hi⟩)) ⟨i, hi⟩
          (e₀.symm_apply_apply ⟨i, hi⟩) (he₀_fst i hi)
      have hΘΦ : Θ_can ≫ Φ = 0 := by
        apply CategoryTheory.Limits.biproduct.hom_ext'
        intro a₀
        rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.comp_zero]
        apply evHom_inj
        rw [map_zero, CategoryTheory.Category.assoc, hRowEval Φ a₀]
        change rowSumVal Φ (e₁.symm a₀)
        rcases e₁.symm a₀ with ⟨⟨g, ⟨σ₁, σ₂⟩⟩ | ⟨g₁, g₂, ⟨φ_sub, σ⟩⟩, hm⟩
        · dsimp [rowSumVal]
          rw [Fin.sum_univ_three]
          dsimp [rowOfSub, vOfSub, row_of_rel, v_of_rel]
          let h₁ := he₀_fst ⟨g, σ₁⟩ (ha hm).1
          let h₂ := he₀_fst ⟨g, σ₂⟩ (ha hm).2.1
          have hgv : (gen (e₀ ⟨⟨g, σ₁ + σ₂⟩, (ha hm).2.2⟩)).1 = g :=
            he₀_fst ⟨g, σ₁ + σ₂⟩ (ha hm).2.2
          apply castU_inj G hgv
          rw [map_zero, map_add, map_add, one_zsmul, one_zsmul, neg_one_zsmul,
            u_can_homOfEq_map G (h₁.trans hgv.symm),
            u_can_homOfEq_map G (h₂.trans hgv.symm),
            u_can_homOfEq_map G rfl,
            castU_trans G (h₁.trans hgv.symm) hgv,
            castU_trans G (h₂.trans hgv.symm) hgv,
            map_neg,
            castU_trans G rfl hgv]
          have hs₁ : castU G ((h₁.trans hgv.symm).trans hgv)
              (evHom _ G (CategoryTheory.Limits.biproduct.ι U_fam (e₀ ⟨⟨g, σ₁⟩, (ha hm).1⟩) ≫ Φ)) =
              s ⟨g, σ₁⟩ (ha hm).1 := hΦ_eval ⟨g, σ₁⟩ (ha hm).1
          have hs₂ : castU G ((h₂.trans hgv.symm).trans hgv)
              (evHom _ G (CategoryTheory.Limits.biproduct.ι U_fam (e₀ ⟨⟨g, σ₂⟩, (ha hm).2.1⟩) ≫ Φ)) =
              s ⟨g, σ₂⟩ (ha hm).2.1 := hΦ_eval ⟨g, σ₂⟩ (ha hm).2.1
          have hs₃ : castU G ((rfl : _ = _).trans hgv)
              (evHom _ G (CategoryTheory.Limits.biproduct.ι U_fam
                (e₀ ⟨⟨g, σ₁ + σ₂⟩, (ha hm).2.2⟩) ≫ Φ)) =
              s ⟨g, σ₁ + σ₂⟩ (ha hm).2.2 := hΦ_eval ⟨g, σ₁ + σ₂⟩ (ha hm).2.2
          rw [hs₁, hs₂, hs₃, hs_add hm]
          abel
        · dsimp [rowSumVal]
          rw [Fin.sum_univ_three]
          dsimp [rowOfSub, vOfSub, row_of_rel, v_of_rel]
          let h₁ := he₀_fst ⟨g₁, σ⟩ (hr hm).1
          have hgv : (gen (e₀ ⟨⟨g₂, F.obj.map (u_can φ_sub).op σ⟩, (hr hm).2⟩)).1 = g₂ :=
            he₀_fst ⟨g₂, F.obj.map (u_can φ_sub).op σ⟩ (hr hm).2
          apply castU_inj G hgv
          rw [map_zero, map_add, map_add, one_zsmul, neg_one_zsmul, zero_zsmul,
            map_zero, add_zero,
            u_can_transportHom_map G h₁ hgv φ_sub,
            map_neg,
            u_can_homOfEq_map G rfl,
            castU_trans G rfl hgv]
          have hs₁ : castU G h₁
              (evHom _ G (CategoryTheory.Limits.biproduct.ι U_fam (e₀ ⟨⟨g₁, σ⟩, (hr hm).1⟩) ≫ Φ)) =
              s ⟨g₁, σ⟩ (hr hm).1 := hΦ_eval ⟨g₁, σ⟩ (hr hm).1
          have hs₂ : castU G ((rfl : _ = _).trans hgv)
              (evHom _ G (CategoryTheory.Limits.biproduct.ι U_fam
                (e₀ ⟨⟨g₂, F.obj.map (u_can φ_sub).op σ⟩, (hr hm).2⟩) ≫ Φ)) =
              s ⟨g₂, F.obj.map (u_can φ_sub).op σ⟩ (hr hm).2 :=
            hΦ_eval ⟨g₂, F.obj.map (u_can φ_sub).op σ⟩ (hr hm).2
          rw [hs₁, hs₂, hs_res hm]
          abel
      let ξ : Q ⟶ G := CategoryTheory.Limits.cokernel.desc Θ_can Φ hΘΦ
      refine ⟨ξ, fun i hi => ?_⟩
      dsimp [e]
      rw [castU_nat ξ (he₀_fst i hi), ← evHom_comp, CategoryTheory.Category.assoc]
      dsimp [π_Q, ξ]
      rw [CategoryTheory.Limits.cokernel.π_desc]
      exact hΦ_eval i hi

  
  
  
  let Q_stage : ∀ (I₀ : Finset J₀) (I₁ : Finset J₁),
      ClosedAdd I₀ I₁ → ClosedRes I₀ I₁ →
      CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u} :=
    fun I₀ I₁ ha hr => (hStage I₀ I₁ ha hr).choose
  let e_stage : ∀ (I₀ : Finset J₀) (I₁ : Finset J₁)
      (ha : ClosedAdd I₀ I₁) (hr : ClosedRes I₀ I₁) (i : J₀),
      i ∈ I₀ → ↑((Q_stage I₀ I₁ ha hr).obj.obj (Opposite.op (U_G i.1))) :=
    fun I₀ I₁ ha hr => (hStage I₀ I₁ ha hr).choose_spec.choose
  have hStage_pres := fun I₀ I₁ ha hr => (hStage I₀ I₁ ha hr).choose_spec.choose_spec.1
  have hUP1 : ∀ (I₀ : Finset J₀) (I₁ : Finset J₁) (ha : ClosedAdd I₀ I₁) (hr : ClosedRes I₀ I₁)
      {G : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
      (ξ₁ ξ₂ : Q_stage I₀ I₁ ha hr ⟶ G),
      (∀ (i : J₀) (hi : i ∈ I₀),
        ξ₁.hom.app (Opposite.op (U_G i.1)) (e_stage I₀ I₁ ha hr i hi) =
          ξ₂.hom.app (Opposite.op (U_G i.1)) (e_stage I₀ I₁ ha hr i hi)) →
      ξ₁ = ξ₂ :=
    fun I₀ I₁ ha hr => (hStage I₀ I₁ ha hr).choose_spec.choose_spec.2.1
  have hUP2_tor : ∀ (I₀ : Finset J₀) (I₁ : Finset J₁) (ha : ClosedAdd I₀ I₁) (hr : ClosedRes I₀ I₁)
      (i : J₀) (hi : i ∈ I₀), ℓ • e_stage I₀ I₁ ha hr i hi = 0 :=
    fun I₀ I₁ ha hr => (hStage I₀ I₁ ha hr).choose_spec.choose_spec.2.2.1.1
  have hUP2_add : ∀ (I₀ : Finset J₀) (I₁ : Finset J₁) (ha : ClosedAdd I₀ I₁) (hr : ClosedRes I₀ I₁)
      {g : 𝒢} {σ₁ σ₂ : Sec g} (h : (Sum.inl ⟨g, (σ₁, σ₂)⟩ : J₁) ∈ I₁),
      e_stage I₀ I₁ ha hr ⟨g, σ₁ + σ₂⟩ (ha h).2.2 =
        e_stage I₀ I₁ ha hr ⟨g, σ₁⟩ (ha h).1 + e_stage I₀ I₁ ha hr ⟨g, σ₂⟩ (ha h).2.1 :=
    fun I₀ I₁ ha hr => (hStage I₀ I₁ ha hr).choose_spec.choose_spec.2.2.1.2.1
  have hUP2_res : ∀ (I₀ : Finset J₀) (I₁ : Finset J₁) (ha : ClosedAdd I₀ I₁) (hr : ClosedRes I₀ I₁)
      {g₁ g₂ : 𝒢} {φ_sub : Hom_G g₁ g₂} {σ : Sec g₁}
      (h : (Sum.inr ⟨g₁, g₂, (φ_sub, σ)⟩ : J₁) ∈ I₁),
      (Q_stage I₀ I₁ ha hr).obj.map (u_can φ_sub).op
          (e_stage I₀ I₁ ha hr ⟨g₁, σ⟩ (hr h).1) =
        e_stage I₀ I₁ ha hr ⟨g₂, F.obj.map (u_can φ_sub).op σ⟩ (hr h).2 :=
    fun I₀ I₁ ha hr => (hStage I₀ I₁ ha hr).choose_spec.choose_spec.2.2.1.2.2
  have hUP3 : ∀ (I₀ : Finset J₀) (I₁ : Finset J₁) (ha : ClosedAdd I₀ I₁) (hr : ClosedRes I₀ I₁)
      (G : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u})
      (s : ∀ (i : J₀), i ∈ I₀ → ↑(G.obj.obj (Opposite.op (U_G i.1)))),
      (∀ (i : J₀) (hi : i ∈ I₀), ℓ • s i hi = 0) →
      (∀ {g : 𝒢} {σ₁ σ₂ : Sec g} (h : (Sum.inl ⟨g, (σ₁, σ₂)⟩ : J₁) ∈ I₁),
        s ⟨g, σ₁ + σ₂⟩ (ha h).2.2 =
          s ⟨g, σ₁⟩ (ha h).1 + s ⟨g, σ₂⟩ (ha h).2.1) →
      (∀ {g₁ g₂ : 𝒢} {φ_sub : Hom_G g₁ g₂} {σ : Sec g₁}
        (h : (Sum.inr ⟨g₁, g₂, (φ_sub, σ)⟩ : J₁) ∈ I₁),
        G.obj.map (u_can φ_sub).op (s ⟨g₁, σ⟩ (hr h).1) =
          s ⟨g₂, F.obj.map (u_can φ_sub).op σ⟩ (hr h).2) →
      ∃ ξ : Q_stage I₀ I₁ ha hr ⟶ G,
        ∀ (i : J₀) (hi : i ∈ I₀),
          ξ.hom.app (Opposite.op (U_G i.1)) (e_stage I₀ I₁ ha hr i hi) = s i hi :=
    fun I₀ I₁ ha hr => (hStage I₀ I₁ ha hr).choose_spec.choose_spec.2.2.2

  let Λ : Type u := Finset J₀ × Finset J₁
  let reqGens : J₁ → Finset J₀ := fun rel =>
    match rel with
    | Sum.inl ⟨g, (σ₁, σ₂)⟩ => {⟨g, σ₁⟩, ⟨g, σ₂⟩, ⟨g, σ₁ + σ₂⟩}
    | Sum.inr ⟨g₁, g₂, (φ_sub, σ)⟩ => {⟨g₁, σ⟩, ⟨g₂, F.obj.map (u_can φ_sub).op σ⟩}
  let I_gen : Λ → Finset J₀ := fun l => l.1 ∪ l.2.biUnion reqGens

  have ha_gen : ∀ l : Λ, ClosedAdd (I_gen l) l.2 := by
    intro l g σ₁ σ₂ hmem
    refine ⟨Finset.mem_union_right _ (Finset.mem_biUnion.mpr ⟨_, hmem, by simp [reqGens]⟩),
      Finset.mem_union_right _ (Finset.mem_biUnion.mpr ⟨_, hmem, by simp [reqGens]⟩),
      Finset.mem_union_right _ (Finset.mem_biUnion.mpr ⟨_, hmem, by simp [reqGens]⟩)⟩
  have hr_gen : ∀ l : Λ, ClosedRes (I_gen l) l.2 := by
    intro l g₁ g₂ φ_sub σ hmem
    refine ⟨Finset.mem_union_right _ (Finset.mem_biUnion.mpr ⟨_, hmem, by simp [reqGens]⟩),
      Finset.mem_union_right _ (Finset.mem_biUnion.mpr ⟨_, hmem, by simp [reqGens]⟩)⟩
  have hSub_gen : ∀ {l₁ l₂ : Λ}, l₁.1 ⊆ l₂.1 → l₁.2 ⊆ l₂.2 → I_gen l₁ ⊆ I_gen l₂ := by
    intro l₁ l₂ h₁ h₂ x hx
    rcases Finset.mem_union.mp hx with hx₁ | hx₂
    · exact Finset.mem_union_left _ (h₁ hx₁)
    · obtain ⟨rel, hrel, hxrel⟩ := Finset.mem_biUnion.mp hx₂
      exact Finset.mem_union_right _ (Finset.mem_biUnion.mpr ⟨rel, h₂ hrel, hxrel⟩)

  let Q_l : Λ → CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u} :=
    fun l => Q_stage (I_gen l) l.2 (ha_gen l) (hr_gen l)
  let e_l : ∀ (l : Λ) (i : J₀), i ∈ I_gen l → ↑((Q_l l).obj.obj (Opposite.op (U_G i.1))) :=
    fun l => e_stage (I_gen l) l.2 (ha_gen l) (hr_gen l)

  have hTrans_ex : ∀ {l₁ l₂ : Λ} (f : l₁ ⟶ l₂),
      ∃ ξ : Q_l l₁ ⟶ Q_l l₂,
        ∀ (i : J₀) (hi : i ∈ I_gen l₁),
          ξ.hom.app (Opposite.op (U_G i.1)) (e_l l₁ i hi) =
            e_l l₂ i (hSub_gen (leOfHom f.1) (leOfHom f.2) hi) := by
    intro l₁ l₂ f
    have hsub := hSub_gen (leOfHom f.1) (leOfHom f.2)
    refine hUP3 (I_gen l₁) l₁.2 (ha_gen l₁) (hr_gen l₁) (Q_l l₂)
      (fun i hi => e_l l₂ i (hsub hi))
      (fun i hi => hUP2_tor (I_gen l₂) l₂.2 (ha_gen l₂) (hr_gen l₂) i (hsub hi))
      (fun hm => hUP2_add (I_gen l₂) l₂.2 (ha_gen l₂) (hr_gen l₂) ((leOfHom f.2) hm))
      (fun hm => hUP2_res (I_gen l₂) l₂.2 (ha_gen l₂) (hr_gen l₂) ((leOfHom f.2) hm))

  let D : CategoryTheory.Functor Λ
      (CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}) :=
    { obj := Q_l
      map := fun f => (hTrans_ex f).choose
      map_id := fun l => by
        refine hUP1 (I_gen l) l.2 (ha_gen l) (hr_gen l) _ _ (fun i hi => ?_)
        exact (hTrans_ex (𝟙 l)).choose_spec i hi
      map_comp := fun {l₁ l₂ l₃} f g => by
        refine hUP1 (I_gen l₁) l₁.2 (ha_gen l₁) (hr_gen l₁) _ _ (fun i hi => ?_)
        rw [(hTrans_ex (f ≫ g)).choose_spec i hi]
        symm
        change ((hTrans_ex g).choose.hom.app (Opposite.op (U_G i.1)))
          (((hTrans_ex f).choose.hom.app (Opposite.op (U_G i.1))) (e_l l₁ i hi)) = _
        rw [(hTrans_ex f).choose_spec i hi, (hTrans_ex g).choose_spec i _] }

  have hNsmul_app : ∀ (k : ℕ) (φ : F ⟶ F) (g : 𝒢) (σ : Sec g),
      (k • φ).hom.app (Opposite.op (U_G g)) σ =
        k • (φ.hom.app (Opposite.op (U_G g)) σ) := by
    intro k φ g σ
    induction k with
    | zero => rfl
    | succ k ih =>
      rw [succ_nsmul, succ_nsmul]
      change (k • φ).hom.app (Opposite.op (U_G g)) σ + φ.hom.app (Opposite.op (U_G g)) σ = _
      rw [ih]

  have hF_sec_tor : ∀ (g : 𝒢) (σ : Sec g), ℓ • σ = 0 := by
    intro g σ
    have h0 : (ℓ • CategoryTheory.CategoryStruct.id F).hom.app (Opposite.op (U_G g)) σ = 0 := by
      rw [hF_tor]
      rfl
    rw [hNsmul_app] at h0
    exact h0

  have hc_ex : ∀ l : Λ,
      ∃ ξ : D.obj l ⟶ F,
        ∀ (i : J₀) (hi : i ∈ I_gen l),
          ξ.hom.app (Opposite.op (U_G i.1)) (e_l l i hi) = i.2 :=
    fun l =>
      hUP3 (I_gen l) l.2 (ha_gen l) (hr_gen l) F (fun i _ => i.2)
        (fun i _ => hF_sec_tor i.1 i.2) (fun _ => rfl) (fun _ => rfl)

  let c : CategoryTheory.Limits.Cocone D :=
    { pt := F
      ι :=
        { app := fun l => (hc_ex l).choose
          naturality := fun l₁ l₂ f => by
            dsimp
            rw [CategoryTheory.Category.comp_id]
            refine hUP1 (I_gen l₁) l₁.2 (ha_gen l₁) (hr_gen l₁) _ _ (fun i hi => ?_)
            change ((hc_ex l₂).choose.hom.app (Opposite.op (U_G i.1)))
              (((D.map f).hom.app (Opposite.op (U_G i.1))) (e_l l₁ i hi)) = _
            rw [(hTrans_ex f).choose_spec i hi, (hc_ex l₂).choose_spec i _,
              (hc_ex l₁).choose_spec i hi] } }

  have hc_colim : Nonempty (CategoryTheory.Limits.IsColimit c) := by
    let l₀ : J₀ → Λ := fun i => ({i}, ∅)
    have hi₀ : ∀ i : J₀, i ∈ I_gen (l₀ i) :=
      fun i => Finset.mem_union_left _ (Finset.mem_singleton_self i)
    let γ : ∀ (s : CategoryTheory.Limits.Cocone D) (g : 𝒢),
        Sec g → ↑(s.pt.obj.obj (Opposite.op (U_G g))) :=
      fun s g σ =>
        (s.ι.app (l₀ ⟨g, σ⟩)).hom.app (Opposite.op (U_G g))
          (e_l (l₀ ⟨g, σ⟩) ⟨g, σ⟩ (hi₀ ⟨g, σ⟩))
    have hγ_eq : ∀ (s : CategoryTheory.Limits.Cocone D) (l : Λ) (i : J₀) (hi : i ∈ I_gen l),
        (s.ι.app l).hom.app (Opposite.op (U_G i.1)) (e_l l i hi) = γ s i.1 i.2 := by
      intro s l i hi
      let l_top : Λ := (I_gen l, l.2)
      have hi_top : i ∈ I_gen l_top := Finset.mem_union_left _ hi
      let f₁ : l₀ i ⟶ l_top :=
        (CategoryTheory.homOfLE (Finset.singleton_subset_iff.mpr hi),
          CategoryTheory.homOfLE (Finset.empty_subset l.2))
      let f₂ : l ⟶ l_top :=
        (CategoryTheory.homOfLE Finset.subset_union_left,
          CategoryTheory.homOfLE (Finset.Subset.refl l.2))
      have hw₁ := congrArg (fun φ => φ.hom.app (Opposite.op (U_G i.1)) (e_l (l₀ i) i (hi₀ i)))
        (s.w f₁)
      have hw₂ := congrArg (fun φ => φ.hom.app (Opposite.op (U_G i.1)) (e_l l i hi))
        (s.w f₂)
      change (s.ι.app l_top).hom.app (Opposite.op (U_G i.1))
        ((D.map f₁).hom.app (Opposite.op (U_G i.1)) (e_l (l₀ i) i (hi₀ i))) =
        γ s i.1 i.2 at hw₁
      change (s.ι.app l_top).hom.app (Opposite.op (U_G i.1))
        ((D.map f₂).hom.app (Opposite.op (U_G i.1)) (e_l l i hi)) =
        (s.ι.app l).hom.app (Opposite.op (U_G i.1)) (e_l l i hi) at hw₂
      rw [(hTrans_ex f₁).choose_spec i (hi₀ i)] at hw₁
      rw [(hTrans_ex f₂).choose_spec i hi] at hw₂
      exact hw₂.symm.trans hw₁
    have hψ₀_ex : ∀ s : CategoryTheory.Limits.Cocone D,
        ∃ ψ : F ⟶ s.pt, ∀ (g : 𝒢) (σ : Sec g),
          ψ.hom.app (Opposite.op (U_G g)) σ = γ s g σ := by
      intro s
      have hγ_add : ∀ (g : 𝒢) (σ₁ σ₂ : Sec g),
          γ s g (σ₁ + σ₂) = γ s g σ₁ + γ s g σ₂ := by
        intro g σ₁ σ₂
        let r_add : J₁ := Sum.inl ⟨g, (σ₁, σ₂)⟩
        let l_add : Λ := (∅, {r_add})
        have hm : r_add ∈ l_add.2 := Finset.mem_singleton_self r_add
        have heq := congrArg ((s.ι.app l_add).hom.app (Opposite.op (U_G g)))
          (hUP2_add (I_gen l_add) l_add.2 (ha_gen l_add) (hr_gen l_add) hm)
        rw [map_add, hγ_eq s l_add ⟨g, σ₁ + σ₂⟩ _,
          hγ_eq s l_add ⟨g, σ₁⟩ _, hγ_eq s l_add ⟨g, σ₂⟩ _] at heq
        exact heq
      have hγ_zero : ∀ g : 𝒢, γ s g 0 = 0 := by
        intro g
        have h00 := hγ_add g 0 0
        rw [zero_add] at h00
        calc
          γ s g 0 = (γ s g 0 + γ s g 0) - γ s g 0 := by abel
          _ = γ s g 0 - γ s g 0 := by rw [← h00]
          _ = 0 := sub_self _
      let ψ₀ : ∀ g : 𝒢, F.obj.obj (Opposite.op (U_G g)) ⟶ s.pt.obj.obj (Opposite.op (U_G g)) :=
        fun g => AddCommGrpCat.ofHom
          { toFun := γ s g, map_zero' := hγ_zero g, map_add' := hγ_add g }
      obtain ⟨ψ, hψ⟩ := hBasis_ext ψ₀ (by
        intro g₁ g₂ h_δ φ u hφ hu
        let φ_sub : Hom_G g₁ g₂ := ⟨φ, ⟨h_δ, hφ⟩⟩
        rw [hu_can_eq φ_sub u hu]
        ext σ
        change s.pt.obj.map (u_can φ_sub).op (γ s g₁ σ) =
          γ s g₂ (F.obj.map (u_can φ_sub).op σ)
        let r_res : J₁ := Sum.inr ⟨g₁, g₂, (φ_sub, σ)⟩
        let l_res : Λ := (∅, {r_res})
        have hm : r_res ∈ l_res.2 := Finset.mem_singleton_self r_res
        have hnat := congrArg
          (fun f => f (e_l l_res ⟨g₁, σ⟩ ((hr_gen l_res hm).1)))
          ((s.ι.app l_res).hom.naturality (u_can φ_sub).op)
        change (s.ι.app l_res).hom.app (Opposite.op (U_G g₂))
            ((Q_l l_res).obj.map (u_can φ_sub).op (e_l l_res ⟨g₁, σ⟩ ((hr_gen l_res hm).1))) =
          s.pt.obj.map (u_can φ_sub).op
            ((s.ι.app l_res).hom.app (Opposite.op (U_G g₁))
              (e_l l_res ⟨g₁, σ⟩ ((hr_gen l_res hm).1))) at hnat
        rw [hUP2_res (I_gen l_res) l_res.2 (ha_gen l_res) (hr_gen l_res) hm,
          hγ_eq s l_res ⟨g₂, F.obj.map (u_can φ_sub).op σ⟩ _,
          hγ_eq s l_res ⟨g₁, σ⟩ _] at hnat
        exact hnat.symm)
      refine ⟨ψ, fun g σ => ?_⟩
      rw [hψ g]
      rfl
    refine ⟨CategoryTheory.Limits.IsColimit.mk (fun s => (hψ₀_ex s).choose) ?_ ?_⟩
    · intro s l
      refine hUP1 (I_gen l) l.2 (ha_gen l) (hr_gen l) _ _ (fun i hi => ?_)
      change ((hψ₀_ex s).choose.hom.app (Opposite.op (U_G i.1)))
        (((c.ι.app l).hom.app (Opposite.op (U_G i.1))) (e_l l i hi)) = _
      rw [(hc_ex l).choose_spec i hi, (hψ₀_ex s).choose_spec i.1 i.2,
        hγ_eq s l i hi]
    · intro s m hm
      refine hBasis_uniq m (hψ₀_ex s).choose (fun g => ?_)
      ext σ
      have hm₀ := congrArg
        (fun φ => φ.hom.app (Opposite.op (U_G g)) (e_l (l₀ ⟨g, σ⟩) ⟨g, σ⟩ (hi₀ ⟨g, σ⟩)))
        (hm (l₀ ⟨g, σ⟩))
      change m.hom.app (Opposite.op (U_G g))
          (((c.ι.app (l₀ ⟨g, σ⟩)).hom.app (Opposite.op (U_G g)))
            (e_l (l₀ ⟨g, σ⟩) ⟨g, σ⟩ (hi₀ ⟨g, σ⟩))) =
        γ s g σ at hm₀
      rw [(hc_ex (l₀ ⟨g, σ⟩)).choose_spec ⟨g, σ⟩ (hi₀ ⟨g, σ⟩)] at hm₀
      rw [hm₀, ((hψ₀_ex s).choose_spec g σ).symm]

  refine ⟨Λ, inferInstance, inferInstance, D, c, hc_colim, rfl, fun l => ?_⟩
  exact hStage_pres (I_gen l) l.2 (ha_gen l) (hr_gen l)

theorem weil_projLine_torsion_sheaf_filtered_colimit_finiteType_descent (k : Type u) [Field k] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hSite : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (g : X₁ ⟶ X₂),
      letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) g :=
        CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
      letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) g :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
          (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
      let B_g : CategoryTheory.Functor X₂.Etale X₁.Etale :=
        CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ g
      ∃ (_ : B_g.IsContinuous X₂.smallEtaleTopology X₁.smallEtaleTopology)
        (_ : (B_g.sheafPushforwardContinuous AddCommGrpCat.{u}
          X₂.smallEtaleTopology X₁.smallEtaleTopology).IsRightAdjoint),
        let pb_g := B_g.sheafPullback AddCommGrpCat.{u} X₂.smallEtaleTopology X₁.smallEtaleTopology
        pb_g.Additive ∧
        CategoryTheory.Limits.PreservesFiniteLimits pb_g ∧
        CategoryTheory.Limits.PreservesFiniteColimits pb_g)
    (A : Type u) [CommRing A] [Algebra k A]
    (F : CategoryTheory.Sheaf
      (CategoryTheory.Limits.pullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A)))
        (weilProjectiveSpaceOver k 1).hom).smallEtaleTopology
      AddCommGrpCat.{u}) :
    let P₁ := weilProjectiveSpaceOver k 1
    let X_A := CategoryTheory.Limits.pullback
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A))) P₁.hom
    let A_ℓ := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))
    ℓ • CategoryTheory.CategoryStruct.id F = 0 →
    ∃ (Λ : Type u) (_ : CategoryTheory.SmallCategory Λ) (_ : CategoryTheory.IsFiltered Λ)
      (D : CategoryTheory.Functor Λ (CategoryTheory.Sheaf X_A.smallEtaleTopology AddCommGrpCat.{u}))
      (c : CategoryTheory.Limits.Cocone D),
      Nonempty (CategoryTheory.Limits.IsColimit c) ∧
      c.pt = F ∧
      ∀ l : Λ,
        ℓ • CategoryTheory.CategoryStruct.id (D.obj l) = 0 ∧
        ∃ (R : Type u) (_ : CommRing R) (_ : Algebra k R) (_ : Algebra.FiniteType k R),
          let X_R := CategoryTheory.Limits.pullback
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k R))) P₁.hom
          ∃ (p_R : X_A ⟶ X_R)
            (V_R U_R : X_R.Etale)
            (_ : AlgebraicGeometry.IsAffine ((AlgebraicGeometry.Scheme.Etale.forget X_R).obj V_R).left)
            (_ : AlgebraicGeometry.IsAffine ((AlgebraicGeometry.Scheme.Etale.forget X_R).obj U_R).left)
            (θ_R : CategoryTheory.Sheaf.freeYoneda X_R.smallEtaleTopology V_R A_ℓ ⟶
              CategoryTheory.Sheaf.freeYoneda X_R.smallEtaleTopology U_R A_ℓ),
            WeilIsEtaleSheafPullback p_R (CategoryTheory.Limits.cokernel θ_R) (D.obj l) :=
by
  intro P₁ X_A A_ℓ hF_tor
  obtain ⟨K_ch, hRingK, hAlgK, ρ₀, ρ₁, j_S, hOpen_j, hRange_j, hComp_j, hPb_j⟩ :=
    weil_projLine_three_chart_tensorProduct_open_immersions k
  letI : ∀ δ : Fin 3, CommRing (K_ch δ) := hRingK
  letI : ∀ δ : Fin 3, Algebra k (K_ch δ) := hAlgK
  let ρ_step : ∀ (δ₁ δ₂ : Fin 3), (δ₁ = δ₂ ∨ δ₂ = 2) → (K_ch δ₁ →ₐ[k] K_ch δ₂) :=
    fun δ₁ δ₂ h =>
      match δ₁, δ₂, h with
      | ⟨0, _⟩, ⟨0, _⟩, _ => AlgHom.id k (K_ch 0)
      | ⟨1, _⟩, ⟨1, _⟩, _ => AlgHom.id k (K_ch 1)
      | ⟨2, _⟩, ⟨2, _⟩, _ => AlgHom.id k (K_ch 2)
      | ⟨0, _⟩, ⟨2, _⟩, _ => ρ₀
      | ⟨1, _⟩, ⟨2, _⟩, _ => ρ₁
      | ⟨0, _⟩, ⟨1, _⟩, h => False.elim (by rcases h with h | h <;> cases h)
      | ⟨1, _⟩, ⟨0, _⟩, h => False.elim (by rcases h with h | h <;> cases h)
      | ⟨2, _⟩, ⟨0, _⟩, h => False.elim (by rcases h with h | h <;> cases h)
      | ⟨2, _⟩, ⟨1, _⟩, h => False.elim (by rcases h with h | h <;> cases h)
  let τ_S : ∀ (S : Type u) [CommRing S] [Algebra k S] (δ₁ δ₂ : Fin 3),
      (δ₁ = δ₂ ∨ δ₂ = 2) →
      (TensorProduct k S (K_ch δ₁) →+* TensorProduct k S (K_ch δ₂)) :=
    fun S _ _ δ₁ δ₂ h =>
      (Algebra.TensorProduct.map (AlgHom.id k S) (ρ_step δ₁ δ₂ h)).toRingHom
  have hτ_id : ∀ (S : Type u) [CommRing S] [Algebra k S] (δ : Fin 3),
      τ_S S δ δ (Or.inl rfl) = RingHom.id (TensorProduct k S (K_ch δ)) := by
    intro S _ _ δ
    have hρ : ρ_step δ δ (Or.inl rfl) = AlgHom.id k (K_ch δ) := by
      fin_cases δ <;> rfl
    dsimp [τ_S]
    rw [hρ, Algebra.TensorProduct.map_id]
    rfl
  have hτ_comp : ∀ (S : Type u) [CommRing S] [Algebra k S] (δ₁ δ₂ : Fin 3)
      (h : δ₁ = δ₂ ∨ δ₂ = 2),
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (τ_S S δ₁ δ₂ h)) ≫ j_S S δ₁ =
        j_S S δ₂ := by
    intro S _ _ δ₁ δ₂ h
    rcases h with rfl | rfl
    · rw [hτ_id S δ₁, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id,
        CategoryTheory.Category.id_comp]
    · fin_cases δ₁
      · exact (hComp_j S).1
      · exact (hComp_j S).2
      · dsimp
        rw [hτ_id S 2, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id,
          CategoryTheory.Category.id_comp]
  letI : ∀ δ : Fin 3, AlgebraicGeometry.IsOpenImmersion (j_S A δ) := hOpen_j A
  obtain ⟨Λ, hCat, hFilt, D, c, hc, hpt, hStage⟩ :=
    weil_etale_three_chart_torsion_sheaf_filtered_colimit_presentation
      ℓ X_A (fun δ => TensorProduct k A (K_ch δ)) (j_S A) (τ_S A)
      (hRange_j A) (hτ_id A) (hτ_comp A) F hF_tor
  refine ⟨Λ, hCat, hFilt, D, c, hc, hpt, fun l => ?_⟩
  obtain ⟨N, m, n, r, δ_l, C_l, hRingCl, hAlgCl, hEtSpecCl, hEtAlgCl,
    v_idx, u_idx, src_rel, tgt_gen, coeff, h_step, φ_l, hφ_l, hIso_l⟩ := hStage l
  letI : ∀ c : Fin N, CommRing (C_l c) := hRingCl
  letI : ∀ c : Fin N, Algebra (TensorProduct k A (K_ch (δ_l c))) (C_l c) := hAlgCl
  letI : ∀ c : Fin N, AlgebraicGeometry.Etale
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap (TensorProduct k A (K_ch (δ_l c))) (C_l c)))) :=
    hEtSpecCl
  letI : ∀ c : Fin N, Algebra.Etale (TensorProduct k A (K_ch (δ_l c))) (C_l c) := hEtAlgCl
  obtain ⟨R, hRingR, hAlgR, hFTR, ι_R, C_R, hRingCR, hAlgCR, hEtAlgCR,
    ψ_C, φ_R, hPb_C, hφ_R, hComm_ψφ⟩ :=
    weil_etale_tensorProduct_finite_family_subalgebra_descent
      k A K_ch δ_l C_l
      (fun t => u_idx (tgt_gen t)) (fun t => v_idx (src_rel t))
      (fun t => ρ_step _ _ (h_step t)) φ_l hφ_l
  letI : CommRing R := hRingR
  letI : Algebra k R := hAlgR
  letI : Algebra.FiniteType k R := hFTR
  letI : ∀ c : Fin N, CommRing (C_R c) := hRingCR
  letI : ∀ c : Fin N, Algebra (TensorProduct k R (K_ch (δ_l c))) (C_R c) := hAlgCR
  letI : ∀ c : Fin N, AlgebraicGeometry.IsOpenImmersion (j_S R (δ_l c)) :=
    fun c => hOpen_j R (δ_l c)
  have hEtSpecCR : ∀ c : Fin N, AlgebraicGeometry.Etale
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap (TensorProduct k R (K_ch (δ_l c))) (C_R c)))) :=
    fun c =>
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
        (RingHom.etale_algebraMap.mpr (hEtAlgCR c))
  letI : ∀ c : Fin N, AlgebraicGeometry.Etale
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap (TensorProduct k R (K_ch (δ_l c))) (C_R c)))) :=
    hEtSpecCR
  let s_R := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k R))
  let s_A := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A))
  let X_R := CategoryTheory.Limits.pullback s_R P₁.hom
  let p_R : X_A ⟶ X_R :=
    CategoryTheory.Limits.pullback.lift
      (CategoryTheory.Limits.pullback.fst s_A P₁.hom ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_R.toRingHom))
      (CategoryTheory.Limits.pullback.snd s_A P₁.hom)
      ((CategoryTheory.Category.assoc _ _ _).trans
        ((congrArg (CategoryTheory.Limits.pullback.fst s_A P₁.hom ≫ ·)
          ((AlgebraicGeometry.Spec.map_comp _ _).symm.trans
            (congrArg AlgebraicGeometry.Spec.map
              ((CommRingCat.ofHom_comp _ _).symm.trans
                (congrArg CommRingCat.ofHom ι_R.comp_algebraMap))))).trans
          CategoryTheory.Limits.pullback.condition))
  let E_A : Fin N → X_A.Etale := fun c =>
    CategoryTheory.MorphismProperty.Over.mk ⊤
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap (TensorProduct k A (K_ch (δ_l c))) (C_l c))) ≫
        j_S A (δ_l c))
      inferInstance
  let E_R : Fin N → X_R.Etale := fun c =>
    CategoryTheory.MorphismProperty.Over.mk ⊤
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap (TensorProduct k R (K_ch (δ_l c))) (C_R c))) ≫
        j_S R (δ_l c))
      inferInstance
  have hAff_ER : ∀ c : Fin N,
      AlgebraicGeometry.IsAffine ((AlgebraicGeometry.Scheme.Etale.forget X_R).obj (E_R c)).left :=
    fun c => by
      change AlgebraicGeometry.IsAffine (AlgebraicGeometry.Spec (CommRingCat.of (C_R c)))
      infer_instance
  letI : ∀ a : Fin m,
      AlgebraicGeometry.IsAffine
        ((AlgebraicGeometry.Scheme.Etale.forget X_R).obj (E_R (v_idx a))).left :=
    fun a => hAff_ER (v_idx a)
  letI : ∀ b : Fin n,
      AlgebraicGeometry.IsAffine
        ((AlgebraicGeometry.Scheme.Etale.forget X_R).obj (E_R (u_idx b))).left :=
    fun b => hAff_ER (u_idx b)
  let u_A : ∀ t : Fin r, E_A (v_idx (src_rel t)) ⟶ E_A (u_idx (tgt_gen t)) := fun t =>
    CategoryTheory.MorphismProperty.Over.homMk
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_l t)))
      (by
        change AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_l t)) ≫
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (algebraMap (TensorProduct k A (K_ch (δ_l (u_idx (tgt_gen t)))))
                (C_l (u_idx (tgt_gen t))))) ≫ j_S A (δ_l (u_idx (tgt_gen t)))) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (algebraMap (TensorProduct k A (K_ch (δ_l (v_idx (src_rel t)))))
              (C_l (v_idx (src_rel t))))) ≫ j_S A (δ_l (v_idx (src_rel t)))
        rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp, hφ_l t, CommRingCat.ofHom_comp,
          AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc,
          hτ_comp A _ _ (h_step t)])
  let u_R : ∀ t : Fin r, E_R (v_idx (src_rel t)) ⟶ E_R (u_idx (tgt_gen t)) := fun t =>
    CategoryTheory.MorphismProperty.Over.homMk
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_R t)))
      (by
        change AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_R t)) ≫
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (algebraMap (TensorProduct k R (K_ch (δ_l (u_idx (tgt_gen t)))))
                (C_R (u_idx (tgt_gen t))))) ≫ j_S R (δ_l (u_idx (tgt_gen t)))) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (algebraMap (TensorProduct k R (K_ch (δ_l (v_idx (src_rel t)))))
              (C_R (v_idx (src_rel t))))) ≫ j_S R (δ_l (v_idx (src_rel t)))
        rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp, hφ_R t, CommRingCat.ofHom_comp,
          AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc,
          hτ_comp R _ _ (h_step t)])
  letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) p_R :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
      (@AlgebraicGeometry.Etale) p_R :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let B_pR : CategoryTheory.Functor X_R.Etale X_A.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ p_R
  have hpb_tot : ∀ c : Fin N,
      CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_C c)))
        (E_A c).hom (E_R c).hom p_R :=
    fun c => (hPb_C c).paste_vert (hPb_j R A ι_R (δ_l c))
  let e_c : ∀ c : Fin N, B_pR.obj (E_R c) ≅ E_A c := fun c =>
    CategoryTheory.MorphismProperty.Over.isoMk (hpb_tot c).isoPullback.symm
      ((congrArg ((hpb_tot c).isoPullback.inv ≫ ·)
        (hpb_tot c).isoPullback_hom_snd.symm).trans
        ((CategoryTheory.Category.assoc _ _ _).symm.trans
          ((congrArg (· ≫ CategoryTheory.Limits.pullback.snd (E_R c).hom p_R)
            (hpb_tot c).isoPullback.inv_hom_id).trans
            (CategoryTheory.Category.id_comp _))))
  have he_comm : ∀ t : Fin r,
      B_pR.map (u_R t) ≫ (e_c (u_idx (tgt_gen t))).hom =
        (e_c (v_idx (src_rel t))).hom ≫ u_A t := by
    intro t
    apply CategoryTheory.MorphismProperty.Over.Hom.ext
    let c₁ := v_idx (src_rel t)
    let c₂ := u_idx (tgt_gen t)
    let α₁ := (hpb_tot c₁).isoPullback
    let α₂ := (hpb_tot c₂).isoPullback
    let f_map : CategoryTheory.Limits.pullback (E_R c₁).hom p_R ⟶
        CategoryTheory.Limits.pullback (E_R c₂).hom p_R :=
      (B_pR.map (u_R t)).left
    let g_map : AlgebraicGeometry.Spec (CommRingCat.of (C_l c₁)) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of (C_l c₂)) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_l t))
    have hf_def : f_map =
        CategoryTheory.Limits.pullback.lift
          (CategoryTheory.Limits.pullback.fst (E_R c₁).hom p_R ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_R t)))
          (CategoryTheory.Limits.pullback.snd (E_R c₁).hom p_R)
          ((CategoryTheory.Category.assoc _ _ _).trans
            ((congrArg (CategoryTheory.Limits.pullback.fst (E_R c₁).hom p_R ≫ ·)
              (CategoryTheory.MorphismProperty.Over.w (u_R t))).trans
              CategoryTheory.Limits.pullback.condition)) :=
      CategoryTheory.MorphismProperty.Over.pullback_map_left
        (@AlgebraicGeometry.Etale) ⊤ p_R (u_R t)
    have h_lift : α₁.hom ≫ f_map = g_map ≫ α₂.hom := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · have hL : (α₁.hom ≫ f_map) ≫
            CategoryTheory.Limits.pullback.fst (E_R c₂).hom p_R =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_C c₁)) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_R t)) :=
          (CategoryTheory.Category.assoc _ _ _).trans
            ((congrArg (α₁.hom ≫ ·)
              ((congrArg (· ≫ CategoryTheory.Limits.pullback.fst (E_R c₂).hom p_R) hf_def).trans
                (CategoryTheory.Limits.pullback.lift_fst _ _ _))).trans
              ((CategoryTheory.Category.assoc _ _ _).symm.trans
                (congrArg (· ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_R t)))
                  (hpb_tot c₁).isoPullback_hom_fst)))
        have hM : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_C c₁)) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_R t)) =
          g_map ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_C c₂)) :=
          (AlgebraicGeometry.Spec.map_comp _ _).symm.trans
            ((congrArg AlgebraicGeometry.Spec.map
              ((CommRingCat.ofHom_comp _ _).symm.trans
                ((congrArg CommRingCat.ofHom (hComm_ψφ t)).trans
                  (CommRingCat.ofHom_comp _ _)))).trans
              (AlgebraicGeometry.Spec.map_comp _ _))
        have hR : g_map ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_C c₂)) =
            (g_map ≫ α₂.hom) ≫ CategoryTheory.Limits.pullback.fst (E_R c₂).hom p_R :=
          (congrArg (g_map ≫ ·) (hpb_tot c₂).isoPullback_hom_fst.symm).trans
            (CategoryTheory.Category.assoc _ _ _).symm
        exact hL.trans (hM.trans hR)
      · have hL : (α₁.hom ≫ f_map) ≫
            CategoryTheory.Limits.pullback.snd (E_R c₂).hom p_R =
          (E_A c₁).hom :=
          (CategoryTheory.Category.assoc _ _ _).trans
            ((congrArg (α₁.hom ≫ ·)
              ((congrArg (· ≫ CategoryTheory.Limits.pullback.snd (E_R c₂).hom p_R) hf_def).trans
                (CategoryTheory.Limits.pullback.lift_snd _ _ _))).trans
              (hpb_tot c₁).isoPullback_hom_snd)
        have hR : (E_A c₁).hom =
            (g_map ≫ α₂.hom) ≫ CategoryTheory.Limits.pullback.snd (E_R c₂).hom p_R :=
          (CategoryTheory.MorphismProperty.Over.w (u_A t)).symm.trans
            ((congrArg (g_map ≫ ·) (hpb_tot c₂).isoPullback_hom_snd.symm).trans
              (CategoryTheory.Category.assoc _ _ _).symm)
        exact hL.trans hR
    change f_map ≫ α₂.inv = α₁.inv ≫ g_map
    exact
      (congrArg (· ≫ α₂.inv)
        ((CategoryTheory.Category.id_comp f_map).symm.trans
          ((congrArg (· ≫ f_map) α₁.inv_hom_id.symm).trans
            ((CategoryTheory.Category.assoc _ _ _).trans
              (congrArg (α₁.inv ≫ ·) h_lift))))).trans
        ((CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg (α₁.inv ≫ ·)
            ((CategoryTheory.Category.assoc _ _ _).trans
              ((congrArg (g_map ≫ ·) α₂.hom_inv_id).trans
                (CategoryTheory.Category.comp_id g_map))))))
  obtain ⟨hTor_Θ, V_R, U_R, hAffV, hAffU, θ_R, hPb_θ⟩ :=
    weil_etale_freeYoneda_coproduct_consolidation_and_pullback
      ℓ @hSite p_R src_rel tgt_gen coeff
      (fun a => E_R (v_idx a)) (fun b => E_R (u_idx b))
      (fun a => E_A (v_idx a)) (fun b => E_A (u_idx b))
      u_R u_A
      ⟨fun a => e_c (v_idx a), fun b => e_c (u_idx b), he_comm⟩
  obtain ⟨iso_l⟩ := hIso_l u_A (fun _ => rfl)
  have hTor_of_iso : ∀ {G₁ G₂ : CategoryTheory.Sheaf X_A.smallEtaleTopology AddCommGrpCat.{u}}
      (e : G₁ ≅ G₂),
      ℓ • CategoryTheory.CategoryStruct.id G₁ = 0 →
      ℓ • CategoryTheory.CategoryStruct.id G₂ = 0 :=
    fun e hG₁ =>
      (congrArg (ℓ • ·)
        (e.inv_hom_id.symm.trans
          (congrArg (e.inv ≫ ·) (CategoryTheory.Category.id_comp e.hom).symm))).trans
        ((CategoryTheory.Preadditive.comp_nsmul e.inv _ ℓ).symm.trans
          ((congrArg (e.inv ≫ ·)
            ((CategoryTheory.Preadditive.nsmul_comp _ e.hom ℓ).symm.trans
              ((congrArg (· ≫ e.hom) hG₁).trans
                CategoryTheory.Limits.zero_comp))).trans
            CategoryTheory.Limits.comp_zero))
  refine ⟨hTor_of_iso iso_l hTor_Θ, R, hRingR, hAlgR, hFTR, p_R, V_R, U_R, hAffV, hAffU, θ_R, ?_⟩
  rcases hPb_θ with ⟨hc_pR, hr_pR, ⟨e_pb⟩⟩
  exact ⟨hc_pR, hr_pR, ⟨e_pb.trans iso_l⟩⟩

theorem weil_ring_domain_etale_pair_pi_trivialization (D₀ E₁ E₂ : Type u) [CommRing D₀] [IsDomain D₀]
    [CommRing E₁] [Algebra D₀ E₁] [Algebra.Etale D₀ E₁]
    [CommRing E₂] [Algebra D₀ E₂] [Algebra.Etale D₀ E₂] :
    ∃ (f : D₀) (_ : f ≠ 0)
      (B : Type u) (_ : CommRing B) (_ : IsDomain B)
      (_ : Algebra (Localization.Away f) B),
      Module.Finite (Localization.Away f) B ∧
      Algebra.Etale (Localization.Away f) B ∧
      Function.Injective (algebraMap (Localization.Away f) B) ∧
      ∃ (N₁ N₂ : ℕ),
        letI : Algebra D₀ B :=
          RingHom.toAlgebra ((algebraMap (Localization.Away f) B).comp
            (algebraMap D₀ (Localization.Away f)))
        Nonempty (TensorProduct D₀ B E₁ ≃ₐ[B] (Fin N₁ → B)) ∧
        Nonempty (TensorProduct D₀ B E₂ ≃ₐ[B] (Fin N₂ → B)) :=
by
  classical
  have h_s1 : ∀ (F A : Type u) [Field F] [CommRing A] [Algebra F A] [Algebra.Etale F A],
      ∃ (N : ℕ) (L : Type u) (_ : Field L) (_ : Algebra F L),
        FiniteDimensional F L ∧
        Algebra.IsSeparable F L ∧
        Nonempty (TensorProduct F L A ≃ₐ[L] (Fin N → L)) := by
    intro F A _ _ _ _
    obtain ⟨I, hFinI, Ai, hFieldAi, hAlgAi, e_prod, hFinSep⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod.{u, u} F A).mp ‹_›
    let _ : Finite I := hFinI
    let _ : ∀ i, Field (Ai i) := hFieldAi
    let _ : ∀ i, Algebra F (Ai i) := hAlgAi
    let m : ℕ := Nat.card I
    let eI : I ≃ Fin m := Finite.equivFin I
    let E : Fin m → Type u := fun i => Ai (eI.symm i)
    let _ : ∀ i : Fin m, Field (E i) := fun i => hFieldAi (eI.symm i)
    let _ : ∀ i : Fin m, Algebra F (E i) := fun i => hAlgAi (eI.symm i)
    have _ : ∀ i : Fin m, FiniteDimensional F (E i) := fun i => (hFinSep (eI.symm i)).1
    have _ : ∀ i : Fin m, Algebra.IsSeparable F (E i) := fun i => (hFinSep (eI.symm i)).2
    let eA : A ≃ₐ[F] (∀ i : Fin m, E i) := e_prod.trans (AlgEquiv.piCongrLeft' F Ai eI)
    have h_prim : ∀ i : Fin m, ∃ α : E i, IntermediateField.adjoin F ({α} : Set (E i)) = ⊤ :=
      fun i => Field.exists_primitive_element F (E i)
    let α : ∀ i : Fin m, E i := fun i => (h_prim i).choose
    have hα_top : ∀ i : Fin m, IntermediateField.adjoin F ({α i} : Set (E i)) = ⊤ :=
      fun i => (h_prim i).choose_spec
    have hα_int : ∀ i : Fin m, IsIntegral F (α i) := fun i => Algebra.IsIntegral.isIntegral (α i)
    let p : Fin m → Polynomial F := fun i => minpoly F (α i)
    let d : Fin m → ℕ := fun i => (p i).natDegree
    have hp_monic : ∀ i : Fin m, (p i).Monic := fun i => minpoly.monic (hα_int i)
    have hp_irred : ∀ i : Fin m, Irreducible (p i) := fun i => minpoly.irreducible (hα_int i)
    have hp_sep : ∀ i : Fin m, (p i).Separable := fun i => Algebra.IsSeparable.isSeparable F (α i)
    have h_adj_equiv : ∀ i : Fin m, Nonempty (E i ≃ₐ[F] AdjoinRoot (p i)) := by
      intro i
      let _ : Fact (Irreducible (p i)) := ⟨hp_irred i⟩
      let φ : AdjoinRoot (p i) →ₐ[F] E i :=
        AdjoinRoot.liftAlgHom (p i) (Algebra.ofId F (E i)) (α i) (minpoly.aeval F (α i))
      have hφ_inj : Function.Injective φ := φ.toRingHom.injective
      have hφ_surj : Function.Surjective φ := by
        have hadj : Algebra.adjoin F ({α i} : Set (E i)) = ⊤ :=
          Algebra.adjoin_eq_top_of_primitive_element (hα_int i).isAlgebraic (hα_top i)
        have hle : (⊤ : Subalgebra F (E i)) ≤ φ.range := by
          rw [← hadj, Algebra.adjoin_le_iff, Set.singleton_subset_iff]
          exact ⟨AdjoinRoot.root (p i), AdjoinRoot.liftAlgHom_root (p i) _ _ _⟩
        intro x
        exact hle trivial
      exact ⟨(AlgEquiv.ofBijective φ ⟨hφ_inj, hφ_surj⟩).symm⟩
    let e_adj : ∀ i : Fin m, E i ≃ₐ[F] AdjoinRoot (p i) := fun i => (h_adj_equiv i).some
    have h_tower : ∀ k : ℕ, k ≤ m →
        ∃ (Lk : Type u) (_ : Field Lk) (_ : Algebra F Lk),
          FiniteDimensional F Lk ∧
          Algebra.IsSeparable F Lk ∧
          (∀ i : Fin m, i.1 < k → (Polynomial.map (algebraMap F Lk) (p i)).Splits) := by
      intro k
      induction k with
      | zero =>
        intro _
        refine ⟨F, inferInstance, inferInstance, inferInstance, inferInstance, ?_⟩
        intro i hi
        exact absurd hi (Nat.not_lt_zero _)
      | succ k ih =>
        intro hk
        obtain ⟨Lk, hFieldLk, hAlgLk, hFinLk, hSepLk, hSplitLk⟩ := ih (Nat.le_of_succ_le hk)
        let _ : Field Lk := hFieldLk
        let _ : Algebra F Lk := hAlgLk
        have _ : FiniteDimensional F Lk := hFinLk
        have _ : Algebra.IsSeparable F Lk := hSepLk
        let ik : Fin m := ⟨k, hk⟩
        let qk : Polynomial Lk := Polynomial.map (algebraMap F Lk) (p ik)
        have hqk_sep : qk.Separable := (hp_sep ik).map
        let Lnext : Type u := qk.SplittingField
        have _ : IsGalois Lk Lnext := IsGalois.of_separable_splitting_field hqk_sep
        have _ : Algebra.IsSeparable Lk Lnext := IsGalois.to_isSeparable
        have hFin_next : FiniteDimensional F Lnext := Module.Finite.trans Lk Lnext
        have hSep_next : Algebra.IsSeparable F Lnext := Algebra.IsSeparable.trans F Lk Lnext
        refine ⟨Lnext, inferInstance, inferInstance, hFin_next, hSep_next, ?_⟩
        intro i hi
        have hmap_comp : Polynomial.map (algebraMap F Lnext) (p i) =
            Polynomial.map (algebraMap Lk Lnext) (Polynomial.map (algebraMap F Lk) (p i)) := by
          rw [IsScalarTower.algebraMap_eq F Lk Lnext, ← Polynomial.map_map]
        rw [hmap_comp]
        rcases Nat.lt_succ_iff_lt_or_eq.mp hi with hlt | heq
        · exact (hSplitLk i hlt).map (algebraMap Lk Lnext)
        · have hi_eq : i = ik := Fin.ext heq
          subst hi_eq
          exact Polynomial.SplittingField.splits qk
    obtain ⟨L, hFieldL, hAlgFL, hFinFL, hSepFL, hSplitsL⟩ := h_tower m le_rfl
    let _ : Field L := hFieldL
    let _ : Algebra F L := hAlgFL
    have h_factor : ∀ i : Fin m,
        Nonempty (TensorProduct F L (AdjoinRoot (p i)) ≃ₐ[L] (Fin (d i) → L)) := by
      intro i
      let q : Polynomial L := Polynomial.map (algebraMap F L) (p i)
      have hq_monic : q.Monic := (hp_monic i).map (algebraMap F L)
      have hq_deg : q.natDegree = d i := (hp_monic i).natDegree_map (algebraMap F L)
      have hq_sep : q.Separable := (hp_sep i).map
      have hq_splits : q.Splits := hSplitsL i i.2
      have hq_nodup : q.roots.Nodup := Polynomial.nodup_roots hq_sep
      have hq_card : q.roots.toFinset.card = d i := by
        rw [Multiset.toFinset_card_of_nodup hq_nodup, ← hq_splits.natDegree_eq_card_roots, hq_deg]
      let e_rt : ↥(q.roots.toFinset) ≃ Fin (d i) := Finset.equivFinOfCardEq hq_card
      let r : Fin (d i) → L := fun j => (e_rt.symm j).1
      have hr_inj : Function.Injective r := fun j₁ j₂ h =>
        e_rt.symm.injective (Subtype.ext h)
      have hr_ev : ∀ j : Fin (d i), Polynomial.eval₂ (algebraMap F L) (r j) (p i) = 0 := by
        intro j
        have hmem : r j ∈ q.roots := Multiset.mem_toFinset.mp (e_rt.symm j).2
        have hev : Polynomial.eval (r j) q = 0 := (Polynomial.mem_roots hq_monic.ne_zero).mp hmem
        rwa [Polynomial.eval_map] at hev
      let ev_hom : AdjoinRoot (p i) →ₐ[F] (Fin (d i) → L) :=
        AlgHom.pi fun j => AdjoinRoot.liftAlgHom (p i) (Algebra.ofId F L) (r j) (hr_ev j)
      have hev_root : ∀ j : Fin (d i), ev_hom (AdjoinRoot.root (p i)) j = r j :=
        fun j => AdjoinRoot.liftAlgHom_root (p i) (Algebra.ofId F L) (r j) (hr_ev j)
      let Ψ : TensorProduct F L (AdjoinRoot (p i)) →ₐ[L] (Fin (d i) → L) :=
        Algebra.TensorProduct.lift
          (Algebra.ofId L (Fin (d i) → L))
          ev_hom
          (fun _ _ => Commute.all _ _)
      have hΨ_surj : Function.Surjective Ψ := by
        intro w
        let Q : Polynomial L := Lagrange.interpolate Finset.univ r w
        let z : TensorProduct F L (AdjoinRoot (p i)) :=
          ∑ n ∈ Finset.range (Q.natDegree + 1),
            (Q.coeff n) ⊗ₜ[F] ((AdjoinRoot.root (p i)) ^ n)
        refine ⟨z, ?_⟩
        ext j
        have hz_j : Ψ z j = ∑ n ∈ Finset.range (Q.natDegree + 1), Q.coeff n * (r j) ^ n := by
          dsimp only [z]
          rw [map_sum, Finset.sum_apply]
          refine Finset.sum_congr rfl (fun n _ => ?_)
          dsimp only [Ψ]
          rw [Algebra.TensorProduct.lift_tmul, Pi.mul_apply, Algebra.ofId_apply,
            Pi.algebraMap_apply, map_pow, Pi.pow_apply, hev_root]
          rfl
        rw [hz_j, ← Polynomial.eval_eq_sum_range,
          Lagrange.eval_interpolate_at_node w hr_inj.injOn (Finset.mem_univ j)]
      let pb := AdjoinRoot.powerBasis' (hp_monic i)
      have _ : Module.Finite F (AdjoinRoot (p i)) := pb.finite
      have _ : Module.Free F (AdjoinRoot (p i)) := Module.Free.of_basis pb.basis
      have h_dim : Module.finrank L (TensorProduct F L (AdjoinRoot (p i))) =
          Module.finrank L (Fin (d i) → L) := by
        rw [Module.finrank_tensorProduct, Module.finrank_self, one_mul, pb.finrank,
          AdjoinRoot.powerBasis'_dim, Module.finrank_fin_fun]
