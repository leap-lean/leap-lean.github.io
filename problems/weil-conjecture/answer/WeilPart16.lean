          (∀ j : Fin (N + 1), θ₁ (xgen j) = θ₂ (xgen j)) →
          θ₁ = θ₂) ∧
        (∀ {Γ : Type u} [CommRing Γ] (κ : k →+* Γ) (w : Fin (N + 1) → Γ),
          MvPolynomial.eval₂Hom κ w L = 1 →
          ∃ ψ : HomogeneousLocalization.Away 𝒜 L →+* Γ,
            ψ.comp ι₀ = κ ∧
            (∀ j : Fin (N + 1), ψ (xgen j) = w j) ∧
            (∀ (M : MvPolynomial (Fin (N + 1)) k) (hM : M ∈ 𝒜 1),
              ψ (HomogeneousLocalization.Away.isLocalizationElem hL hM) =
                MvPolynomial.eval₂Hom κ w M))) ∧
      (∀ (L₁ L₂ : MvPolynomial (Fin (N + 1)) k) (hL₁ : L₁ ∈ 𝒜 1) (hL₂ : L₂ ∈ 𝒜 1),
        let map₁ := HomogeneousLocalization.awayMap 𝒜 hL₂ (rfl : L₁ * L₂ = L₁ * L₂)
        let map₂ := HomogeneousLocalization.awayMap 𝒜 hL₁ (mul_comm L₁ L₂)
        (∀ {Γ : Type u} [CommRing Γ]
            (θ₁₂ : HomogeneousLocalization.Away 𝒜 (L₁ * L₂) →+* Γ),
          ∃ lam lam' : Γ,
            lam * lam' = 1 ∧
            ∀ j : Fin (N + 1),
              θ₁₂ (map₁ (HomogeneousLocalization.Away.isLocalizationElem hL₁
                (MvPolynomial.isHomogeneous_X k j))) =
              lam * θ₁₂ (map₂ (HomogeneousLocalization.Away.isLocalizationElem hL₂
                (MvPolynomial.isHomogeneous_X k j)))) ∧
        (∀ {Γ : Type u} [CommRing Γ]
            (ψ₁ : HomogeneousLocalization.Away 𝒜 L₁ →+* Γ)
            (ψ₂ : HomogeneousLocalization.Away 𝒜 L₂ →+* Γ)
            (lam lam' : Γ),
          lam * lam' = 1 →
          ψ₁.comp ((HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers L₁)).comp
            (algebraMap k ↥(𝒜 0))) =
            ψ₂.comp ((HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers L₂)).comp
              (algebraMap k ↥(𝒜 0))) →
          (∀ j : Fin (N + 1),
            ψ₁ (HomogeneousLocalization.Away.isLocalizationElem hL₁
              (MvPolynomial.isHomogeneous_X k j)) =
            lam * ψ₂ (HomogeneousLocalization.Away.isLocalizationElem hL₂
              (MvPolynomial.isHomogeneous_X k j))) →
          ∃ ψ₁₂ : HomogeneousLocalization.Away 𝒜 (L₁ * L₂) →+* Γ,
            ψ₁₂.comp map₁ = ψ₁ ∧ ψ₁₂.comp map₂ = ψ₂)) := by
    intro N
    let _ : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) :=
      MvPolynomial.gradedAlgebra
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    let valHom : ∀ (S : Submonoid (MvPolynomial (Fin (N + 1)) k)),
        HomogeneousLocalization 𝒜 S →+* Localization S := fun S =>
      { toFun := HomogeneousLocalization.val
        map_one' := HomogeneousLocalization.val_one
        map_mul' := fun _ _ => HomogeneousLocalization.val_mul _ _
        map_zero' := HomogeneousLocalization.val_zero
        map_add' := fun _ _ => HomogeneousLocalization.val_add _ _ }
    have hval_fromZero : ∀ (S : Submonoid (MvPolynomial (Fin (N + 1)) k)) (c : k),
        valHom S ((HomogeneousLocalization.fromZeroRingHom 𝒜 S) (algebraMap k ↥(𝒜 0) c)) =
          Localization.mk (MvPolynomial.C c) 1 := by
      intro S c
      change Localization.mk (algebraMap k ↥(𝒜 0) c).1 1 = Localization.mk (MvPolynomial.C c) 1
      have hsub : (algebraMap k ↥(𝒜 0) c).1 = MvPolynomial.C c := by
        rw [Algebra.algebraMap_eq_smul_one]
        change (c • (1 : ↥(𝒜 0))).1 = MvPolynomial.C c
        change c • (1 : MvPolynomial (Fin (N + 1)) k) = MvPolynomial.C c
        rw [MvPolynomial.smul_eq_C_mul, mul_one]
      rw [hsub]
    have hPart1 : ∀ (L : MvPolynomial (Fin (N + 1)) k) (hL : L ∈ 𝒜 1),
        let ι₀ : k →+* HomogeneousLocalization.Away 𝒜 L :=
          (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers L)).comp
            (algebraMap k ↥(𝒜 0))
        let xgen : Fin (N + 1) → HomogeneousLocalization.Away 𝒜 L :=
          fun j => HomogeneousLocalization.Away.isLocalizationElem hL
            (MvPolynomial.isHomogeneous_X k j)
        (∀ {Γ : Type u} [CommRing Γ] (θ : HomogeneousLocalization.Away 𝒜 L →+* Γ)
            (M : MvPolynomial (Fin (N + 1)) k) (hM : M ∈ 𝒜 1),
          θ (HomogeneousLocalization.Away.isLocalizationElem hL hM) =
            MvPolynomial.eval₂Hom (θ.comp ι₀) (fun j => θ (xgen j)) M) ∧
        (HomogeneousLocalization.Away.isLocalizationElem hL hL = 1) ∧
        (∀ {Γ : Type u} [CommRing Γ] (θ₁ θ₂ : HomogeneousLocalization.Away 𝒜 L →+* Γ),
          θ₁.comp ι₀ = θ₂.comp ι₀ →
          (∀ j : Fin (N + 1), θ₁ (xgen j) = θ₂ (xgen j)) →
          θ₁ = θ₂) ∧
        (∀ {Γ : Type u} [CommRing Γ] (κ : k →+* Γ) (w : Fin (N + 1) → Γ),
          MvPolynomial.eval₂Hom κ w L = 1 →
          ∃ ψ : HomogeneousLocalization.Away 𝒜 L →+* Γ,
            ψ.comp ι₀ = κ ∧
            (∀ j : Fin (N + 1), ψ (xgen j) = w j) ∧
            (∀ (M : MvPolynomial (Fin (N + 1)) k) (hM : M ∈ 𝒜 1),
              ψ (HomogeneousLocalization.Away.isLocalizationElem hL hM) =
                MvPolynomial.eval₂Hom κ w M)) := by
      intro L hL ι₀ xgen
      let S : Submonoid (MvPolynomial (Fin (N + 1)) k) := Submonoid.powers L
      have hxgen_val : ∀ j : Fin (N + 1),
          valHom S (xgen j) =
            Localization.mk (MvPolynomial.X j) (⟨L, Submonoid.mem_powers L⟩ : S) := by
        intro j
        change HomogeneousLocalization.val
          (HomogeneousLocalization.Away.mk 𝒜 hL 1 (MvPolynomial.X j ^ 1) _) = _
        rw [HomogeneousLocalization.Away.val_mk]
        congr 1
        · exact pow_one _
        · exact Subtype.ext (pow_one L)
      have hpow_mk : ∀ (j : Fin (N + 1)) (e : ℕ),
          (valHom S (xgen j)) ^ e =
            Localization.mk (MvPolynomial.X j ^ e)
              (⟨L ^ e, S.pow_mem (Submonoid.mem_powers L) e⟩ : S) := by
        intro j e
        induction e with
        | zero =>
          simp only [pow_zero]
          exact Localization.mk_one.symm
        | succ e ih =>
          rw [pow_succ', ih, hxgen_val, Localization.mk_mul, pow_succ']
          congr 1
          exact Subtype.ext (pow_succ' L e).symm
      have hprod_mk : ∀ (m₀ : Fin (N + 1) →₀ ℕ) (s : Finset (Fin (N + 1))),
          (∏ j ∈ s, (valHom S (xgen j)) ^ (m₀ j)) =
            Localization.mk (∏ j ∈ s, MvPolynomial.X j ^ (m₀ j))
              (⟨L ^ (∑ j ∈ s, m₀ j),
                S.pow_mem (Submonoid.mem_powers L) (∑ j ∈ s, m₀ j)⟩ : S) := by
        intro m₀ s
        classical
        induction s using Finset.induction_on with
        | empty =>
          simp only [Finset.prod_empty, Finset.sum_empty, pow_zero]
          exact Localization.mk_one.symm
        | @insert j s hj ih =>
          rw [Finset.prod_insert hj, Finset.prod_insert hj, Finset.sum_insert hj,
            hpow_mk, ih, Localization.mk_mul]
          congr 1
          exact Subtype.ext (pow_add L (m₀ j) (∑ i ∈ s, m₀ i)).symm
      have hMkEval : ∀ (d : ℕ) (P : MvPolynomial (Fin (N + 1)) k) (hP : P ∈ 𝒜 (d • 1)),
          HomogeneousLocalization.Away.mk 𝒜 hL d P hP =
            MvPolynomial.eval₂Hom ι₀ xgen P := by
        intro d P hP
        apply HomogeneousLocalization.val_injective
        change HomogeneousLocalization.val (HomogeneousLocalization.Away.mk 𝒜 hL d P hP) =
          (valHom S) (MvPolynomial.eval₂Hom ι₀ xgen P)
        rw [HomogeneousLocalization.Away.val_mk]
        have hcomp : (valHom S).comp (MvPolynomial.eval₂Hom ι₀ xgen) =
            MvPolynomial.eval₂Hom ((valHom S).comp ι₀) (fun j => valHom S (xgen j)) :=
          MvPolynomial.comp_eval₂Hom ι₀ xgen (valHom S)
        change Localization.mk P _ = ((valHom S).comp (MvPolynomial.eval₂Hom ι₀ xgen)) P
        rw [hcomp]
        have hPd : P ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k d := by
          simpa [𝒜, smul_eq_mul, mul_one] using hP
        have hPhom : P.IsHomogeneous d :=
          (MvPolynomial.mem_homogeneousSubmodule d P).mp hPd
        let evS := MvPolynomial.eval₂Hom ((valHom S).comp ι₀) (fun j => valHom S (xgen j))
        let Ld_sub : S := ⟨L ^ d, S.pow_mem (Submonoid.mem_powers L) d⟩
        have hmon : ∀ m₀ ∈ P.support,
            evS (MvPolynomial.monomial m₀ (P.coeff m₀)) =
              Localization.mk (MvPolynomial.monomial m₀ (P.coeff m₀)) Ld_sub := by
          intro m₀ hm₀
          have hdeg : (∑ j : Fin (N + 1), m₀ j) = d := by
            have hw := hPhom (MvPolynomial.mem_support_iff.mp hm₀)
            rw [Finsupp.weight_apply, Finsupp.sum_fintype _ _ (fun _ => zero_mul _)] at hw
            simpa [Pi.one_apply, smul_eq_mul, mul_one] using hw
          change (MvPolynomial.eval₂Hom ((valHom S).comp ι₀) (fun j => valHom S (xgen j)))
            (MvPolynomial.monomial m₀ (P.coeff m₀)) = _
          rw [MvPolynomial.eval₂Hom_monomial]
          have hιc : ((valHom S).comp ι₀) (P.coeff m₀) =
              Localization.mk (MvPolynomial.C (P.coeff m₀)) 1 := hval_fromZero S (P.coeff m₀)
          have hfp : (m₀.prod fun j e => (valHom S (xgen j)) ^ e) =
              ∏ j : Fin (N + 1), (valHom S (xgen j)) ^ (m₀ j) :=
            Finsupp.prod_fintype m₀ _ (fun _ => pow_zero _)
          rw [hιc, hfp, hprod_mk m₀ Finset.univ, Localization.mk_mul]
          congr 1
          · rw [MvPolynomial.monomial_eq, Finsupp.prod_fintype m₀ _ (fun _ => pow_zero _)]
          · apply Subtype.ext
            change (1 : MvPolynomial (Fin (N + 1)) k) * L ^ (∑ j : Fin (N + 1), m₀ j) = L ^ d
            rw [one_mul, hdeg]
        have hsum_sup : ∀ (T : Finset (Fin (N + 1) →₀ ℕ)),
            T ⊆ P.support →
            evS (∑ m₀ ∈ T, MvPolynomial.monomial m₀ (P.coeff m₀)) =
              Localization.mk (∑ m₀ ∈ T, MvPolynomial.monomial m₀ (P.coeff m₀)) Ld_sub := by
          intro T hT
          classical
          induction T using Finset.induction_on with
          | empty =>
            simp only [Finset.sum_empty, map_zero, Localization.mk_zero]
          | @insert m₀ T hm₀ ih =>
            rw [Finset.sum_insert hm₀, map_add,
              hmon m₀ (hT (Finset.mem_insert_self m₀ T)),
              ih (Finset.Subset.trans (Finset.subset_insert m₀ T) hT),
              Localization.add_mk_self]
        have hPas := MvPolynomial.as_sum P
        have hfinal := hsum_sup P.support (Finset.Subset.refl _)
        rw [← hPas] at hfinal
        exact hfinal.symm
      have hisLoc_eq : ∀ (M : MvPolynomial (Fin (N + 1)) k) (hM : M ∈ 𝒜 1),
          HomogeneousLocalization.Away.isLocalizationElem hL hM =
            MvPolynomial.eval₂Hom ι₀ xgen M := by
        intro M hM
        have hM1 : M ∈ 𝒜 ((1 : ℕ) • 1) := by simpa using hM
        have heq : HomogeneousLocalization.Away.isLocalizationElem hL hM =
            HomogeneousLocalization.Away.mk 𝒜 hL 1 M hM1 := by
          apply HomogeneousLocalization.val_injective
          change HomogeneousLocalization.val
            (HomogeneousLocalization.Away.mk 𝒜 hL 1 (M ^ 1) _) =
            HomogeneousLocalization.val (HomogeneousLocalization.Away.mk 𝒜 hL 1 M hM1)
          rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk, pow_one]
        rw [heq, hMkEval 1 M hM1]
      have h1a : ∀ {Γ : Type u} [CommRing Γ] (θ : HomogeneousLocalization.Away 𝒜 L →+* Γ)
          (M : MvPolynomial (Fin (N + 1)) k) (hM : M ∈ 𝒜 1),
          θ (HomogeneousLocalization.Away.isLocalizationElem hL hM) =
            MvPolynomial.eval₂Hom (θ.comp ι₀) (fun j => θ (xgen j)) M := by
        intro Γ _ θ M hM
        rw [hisLoc_eq M hM]
        exact RingHom.congr_fun (MvPolynomial.comp_eval₂Hom ι₀ xgen θ) M
      have h1b : HomogeneousLocalization.Away.isLocalizationElem hL hL = 1 := by
        apply HomogeneousLocalization.val_injective
        change HomogeneousLocalization.val
          (HomogeneousLocalization.Away.mk 𝒜 hL 1 (L ^ 1) _) = HomogeneousLocalization.val 1
        rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_one]
        exact Localization.mk_self (⟨L ^ 1, S.pow_mem (Submonoid.mem_powers L) 1⟩ : S)
      have h1c : ∀ {Γ : Type u} [CommRing Γ] (θ₁ θ₂ : HomogeneousLocalization.Away 𝒜 L →+* Γ),
          θ₁.comp ι₀ = θ₂.comp ι₀ →
          (∀ j : Fin (N + 1), θ₁ (xgen j) = θ₂ (xgen j)) →
          θ₁ = θ₂ := by
        intro Γ _ θ₁ θ₂ h0 hx
        ext z
        obtain ⟨d, P, hP, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜 hL z
        rw [hMkEval d P hP]
        have hfun : (fun j => θ₁ (xgen j)) = (fun j => θ₂ (xgen j)) := funext hx
        have hc1 := RingHom.congr_fun (MvPolynomial.comp_eval₂Hom ι₀ xgen θ₁) P
        have hc2 := RingHom.congr_fun (MvPolynomial.comp_eval₂Hom ι₀ xgen θ₂) P
        change (θ₁.comp (MvPolynomial.eval₂Hom ι₀ xgen)) P =
          (θ₂.comp (MvPolynomial.eval₂Hom ι₀ xgen)) P
        rw [hc1, hc2, h0, hfun]
      have h1d : ∀ {Γ : Type u} [CommRing Γ] (κ : k →+* Γ) (w : Fin (N + 1) → Γ),
          MvPolynomial.eval₂Hom κ w L = 1 →
          ∃ ψ : HomogeneousLocalization.Away 𝒜 L →+* Γ,
            ψ.comp ι₀ = κ ∧
            (∀ j : Fin (N + 1), ψ (xgen j) = w j) ∧
            (∀ (M : MvPolynomial (Fin (N + 1)) k) (hM : M ∈ 𝒜 1),
              ψ (HomogeneousLocalization.Away.isLocalizationElem hL hM) =
                MvPolynomial.eval₂Hom κ w M) := by
        intro Γ _ κ w hwL
        let ev_w := MvPolynomial.eval₂Hom κ w
        have hunit : ∀ y : S, IsUnit (ev_w y.1) := by
          rintro ⟨_, ⟨r, rfl⟩⟩
          change IsUnit ((MvPolynomial.eval₂Hom κ w) (L ^ r))
          rw [map_pow, hwL, one_pow]
          exact isUnit_one
        let ψ : HomogeneousLocalization.Away 𝒜 L →+* Γ :=
          (IsLocalization.lift (M := S) (S := Localization S) hunit).comp (valHom S)
        have hψ_0 : ψ.comp ι₀ = κ := by
          ext c
          change (IsLocalization.lift hunit)
            (valHom S ((HomogeneousLocalization.fromZeroRingHom 𝒜 S)
              (algebraMap k ↥(𝒜 0) c))) = κ c
          rw [hval_fromZero S c, Localization.mk_one_eq_algebraMap,
            IsLocalization.lift_eq]
          exact MvPolynomial.eval₂Hom_C κ w c
        have hψ_M : ∀ (M : MvPolynomial (Fin (N + 1)) k) (hM : M ∈ 𝒜 1),
            ψ (HomogeneousLocalization.Away.isLocalizationElem hL hM) = ev_w M := by
          intro M hM
          change (IsLocalization.lift hunit)
            (HomogeneousLocalization.val (HomogeneousLocalization.Away.mk 𝒜 hL 1 (M ^ 1) _)) =
            ev_w M
          rw [HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk',
            IsLocalization.lift_mk'_spec]
          change (MvPolynomial.eval₂Hom κ w) (M ^ 1) =
            (MvPolynomial.eval₂Hom κ w) (L ^ 1) * (MvPolynomial.eval₂Hom κ w) M
          rw [pow_one, pow_one, hwL, one_mul]
        refine ⟨ψ, hψ_0, fun j => ?_, hψ_M⟩
        rw [hψ_M (MvPolynomial.X j) (MvPolynomial.isHomogeneous_X k j)]
        exact MvPolynomial.eval₂Hom_X' κ w j
      exact ⟨h1a, h1b, h1c, h1d⟩
    refine ⟨hPart1, ?_⟩
    intro L₁ L₂ hL₁ hL₂ map₁ map₂
    have hL₁₂ : L₁ * L₂ ∈ 𝒜 (1 + 1) := SetLike.mul_mem_graded hL₁ hL₂
    let S₁₂ : Submonoid (MvPolynomial (Fin (N + 1)) k) := Submonoid.powers (L₁ * L₂)
    have hmap₁_val : ∀ (M : MvPolynomial (Fin (N + 1)) k) (hM : M ∈ 𝒜 1),
        valHom S₁₂ (map₁ (HomogeneousLocalization.Away.isLocalizationElem hL₁ hM)) =
          Localization.mk (M * L₂) (⟨L₁ * L₂, Submonoid.mem_powers (L₁ * L₂)⟩ : S₁₂) := by
      intro M hM
      change HomogeneousLocalization.val
        ((HomogeneousLocalization.awayMap 𝒜 hL₂ (rfl : L₁ * L₂ = L₁ * L₂))
          (HomogeneousLocalization.Away.mk 𝒜 hL₁ 1 (M ^ 1) _)) = _
      rw [HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.Away.val_mk]
      congr 1
      · rw [pow_one, pow_one]
      · exact Subtype.ext (pow_one _)
    have hmap₂_val : ∀ (M : MvPolynomial (Fin (N + 1)) k) (hM : M ∈ 𝒜 1),
        valHom S₁₂ (map₂ (HomogeneousLocalization.Away.isLocalizationElem hL₂ hM)) =
          Localization.mk (M * L₁) (⟨L₁ * L₂, Submonoid.mem_powers (L₁ * L₂)⟩ : S₁₂) := by
      intro M hM
      change HomogeneousLocalization.val
        ((HomogeneousLocalization.awayMap 𝒜 hL₁ (mul_comm L₁ L₂))
          (HomogeneousLocalization.Away.mk 𝒜 hL₂ 1 (M ^ 1) _)) = _
      rw [HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.Away.val_mk]
      congr 1
      · rw [pow_one, pow_one]
      · exact Subtype.ext (pow_one _)
    refine ⟨?_, ?_⟩
    · intro Γ _ θ₁₂
      let c₁₂ := map₁ (HomogeneousLocalization.Away.isLocalizationElem hL₁ hL₂)
      let c₂₁ := map₂ (HomogeneousLocalization.Away.isLocalizationElem hL₂ hL₁)
      have hc_mul : c₁₂ * c₂₁ = 1 := by
        apply HomogeneousLocalization.val_injective
        change valHom S₁₂ (c₁₂ * c₂₁) = valHom S₁₂ 1
        rw [map_mul, map_one, hmap₁_val L₂ hL₂, hmap₂_val L₁ hL₁, Localization.mk_mul,
          ← Localization.mk_one, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
        refine ⟨1, ?_⟩
        simp only [Submonoid.coe_one, Submonoid.coe_mul, one_mul]
        ring
      have hc_ratio : ∀ j : Fin (N + 1),
          map₁ (HomogeneousLocalization.Away.isLocalizationElem hL₁
            (MvPolynomial.isHomogeneous_X k j)) =
          c₁₂ * map₂ (HomogeneousLocalization.Away.isLocalizationElem hL₂
            (MvPolynomial.isHomogeneous_X k j)) := by
        intro j
        apply HomogeneousLocalization.val_injective
        change valHom S₁₂ _ = valHom S₁₂ _
        rw [map_mul, hmap₁_val _ (MvPolynomial.isHomogeneous_X k j), hmap₁_val L₂ hL₂,
          hmap₂_val _ (MvPolynomial.isHomogeneous_X k j), Localization.mk_mul,
          Localization.mk_eq_mk_iff, Localization.r_iff_exists]
        refine ⟨1, ?_⟩
        simp only [Submonoid.coe_one, Submonoid.coe_mul, one_mul]
        ring
      refine ⟨θ₁₂ c₁₂, θ₁₂ c₂₁, ?_, fun j => ?_⟩
      · rw [← map_mul, hc_mul, map_one]
      · rw [hc_ratio j, map_mul]
    · intro Γ _ ψ₁ ψ₂ lam lam' hlam h0 hratio
      let ι₀₁ : k →+* HomogeneousLocalization.Away 𝒜 L₁ :=
        (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers L₁)).comp
          (algebraMap k ↥(𝒜 0))
      let ι₀₂ : k →+* HomogeneousLocalization.Away 𝒜 L₂ :=
        (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers L₂)).comp
          (algebraMap k ↥(𝒜 0))
      let xgen₁ : Fin (N + 1) → HomogeneousLocalization.Away 𝒜 L₁ :=
        fun j => HomogeneousLocalization.Away.isLocalizationElem hL₁
          (MvPolynomial.isHomogeneous_X k j)
      let xgen₂ : Fin (N + 1) → HomogeneousLocalization.Away 𝒜 L₂ :=
        fun j => HomogeneousLocalization.Away.isLocalizationElem hL₂
          (MvPolynomial.isHomogeneous_X k j)
      let κ : k →+* Γ := ψ₁.comp ι₀₁
      let w₁ : Fin (N + 1) → Γ := fun j => ψ₁ (xgen₁ j)
      let w₂ : Fin (N + 1) → Γ := fun j => ψ₂ (xgen₂ j)
      obtain ⟨h1a_1, h1b_1, h1c_1, -⟩ := hPart1 L₁ hL₁
      obtain ⟨h1a_2, h1b_2, h1c_2, -⟩ := hPart1 L₂ hL₂
      have hev₁_L₁ : MvPolynomial.eval₂Hom κ w₁ L₁ = 1 := by
        rw [← h1a_1 ψ₁ L₁ hL₁, h1b_1, map_one]
