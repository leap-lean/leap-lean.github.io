    have hAff_full : ∀ m : ℕ,
        let c_hom : Quiver.Hom (weilEtaleCechObj w m).left Z := (weilEtaleCechObj w m).hom
        ∃ (E_m : CommRingCat.{u}) (f_m : Quiver.Hom R E_m)
          (e_m : CategoryTheory.Iso (AlgebraicGeometry.Spec E_m) (weilEtaleCechObj w m).left),
          CategoryTheory.CategoryStruct.comp e_m.hom c_hom = AlgebraicGeometry.Spec.map f_m :=
      fun m => ⟨(aff_pkg m).1, (aff_pkg m).2.1, (aff_pkg m).2.2.1, (aff_pkg m).2.2.2⟩
    refine ⟨⟨K_full, fun m => weilEtaleCechObj w m, ι_full, π_full, h₀_full,
      rfl, hSE_full, hAff_full⟩,
      ⟨U, eU, K_full 1, ι_full 0, h₀_full 0,
        CategoryTheory.Category.id_comp (AlgebraicGeometry.Spec.map f),
        hSE_full 0,
        ⟨fun m => K_full (m + 1), fun m => weilEtaleCechObj w (m + 1),
          fun m => ι_full (m + 1), fun m => π_full (m + 1), fun m => h₀_full (m + 1),
          rfl, fun m => hSE_full (m + 1), fun m => hAff_full (m + 1)⟩⟩⟩
  refine ⟨?_, ?_⟩
  · have hId_et : (CommRingCat.Hom.hom (CategoryTheory.CategoryStruct.id R)).Etale := by
      rw [CommRingCat.hom_id]
      exact RingHom.Etale.of_bijective Function.bijective_id
    have hId_surj : AlgebraicGeometry.Surjective
        (AlgebraicGeometry.Spec.map (CategoryTheory.CategoryStruct.id R)) := by
      rw [AlgebraicGeometry.Spec.map_id]
      infer_instance
    exact (hBuildTower R (CategoryTheory.CategoryStruct.id R) hId_et hId_surj).1
  · intro E f hf_et hf_surj
    exact (hBuildTower E f hf_et hf_surj).2

theorem weil_etale_ext_local_vanishing_on_affine_product_cover (hEtDesc : WeilFilteredColimitEtaleDescentHolds.{u}) :
    WeilEtaleAffineProductExtVanishingHolds.{u} :=
by
  classical
  dsimp only [WeilEtaleAffineProductExtVanishingHolds]
  intro R T_Z hT_Z F₀ q hq ζ₀
  let Z : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec R
  let J := Z.smallEtaleTopology
  let Aℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
  let fyEquiv : ∀ (X : Z.Etale) (G : CategoryTheory.Sheaf J AddCommGrpCat.{u}),
      (weilFreeYonedaZ.{u} Z X ⟶ G) ≃ (Aℤ ⟶ G.obj.obj (Opposite.op X)) :=
    fun _ _ => CategoryTheory.Sheaf.freeYonedaHomEquiv
  
  have hFY_comp : ∀ {X : Z.Etale} {G₁ G₂ : CategoryTheory.Sheaf J AddCommGrpCat.{u}}
      (α : weilFreeYonedaZ.{u} Z X ⟶ G₁) (ψ : G₁ ⟶ G₂),
      fyEquiv X G₂ (α ≫ ψ) = fyEquiv X G₁ α ≫ ψ.hom.app (Opposite.op X) := by
    intro X G₁ G₂ α ψ
    let adj := CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}
    change CategoryTheory.Presheaf.freeYonedaHomEquiv ((adj.homEquiv (CategoryTheory.Presheaf.freeYoneda X Aℤ) G₂) (α ≫ ψ)) =
      CategoryTheory.Presheaf.freeYonedaHomEquiv ((adj.homEquiv (CategoryTheory.Presheaf.freeYoneda X Aℤ) G₁) α) ≫
        ψ.hom.app (Opposite.op X)
    rw [adj.homEquiv_naturality_right α ψ]
    exact CategoryTheory.Presheaf.freeYonedaHomEquiv_comp _ ψ.hom
  have hFY_id_comp : ∀ {X : Z.Etale} {G : CategoryTheory.Sheaf J AddCommGrpCat.{u}}
      (ψ : weilFreeYonedaZ.{u} Z X ⟶ G),
      fyEquiv X (weilFreeYonedaZ.{u} Z X) (𝟙 (weilFreeYonedaZ.{u} Z X)) ≫
        ψ.hom.app (Opposite.op X) = fyEquiv X G ψ := by
    intro X G ψ
    have h := hFY_comp (𝟙 (weilFreeYonedaZ.{u} Z X)) ψ
    rw [CategoryTheory.Category.id_comp] at h
    exact h.symm
  have hFY_map_eq : ∀ {W V : Z.Etale} (u : W ⟶ V),
      fyEquiv W (weilFreeYonedaZ.{u} Z V) (weilFreeYonedaMap.{u} u) =
        fyEquiv V (weilFreeYonedaZ.{u} Z V) (𝟙 (weilFreeYonedaZ.{u} Z V)) ≫
          (weilFreeYonedaZ.{u} Z V).obj.map (Opposite.op u) := by
    intro W V u
    dsimp [fyEquiv, weilFreeYonedaMap]
    exact Equiv.apply_symm_apply _ _
  have hFY_map_comp : ∀ {W V : Z.Etale} (u : W ⟶ V)
      {G : CategoryTheory.Sheaf J AddCommGrpCat.{u}}
      (φ : weilFreeYonedaZ.{u} Z V ⟶ G),
      fyEquiv W G (weilFreeYonedaMap.{u} u ≫ φ) =
        fyEquiv V G φ ≫ G.obj.map (Opposite.op u) := by
    intro W V u G φ
    rw [hFY_comp, hFY_map_eq, CategoryTheory.Category.assoc, φ.hom.naturality (Opposite.op u),
      ← CategoryTheory.Category.assoc, hFY_id_comp]
  have hFY_map_comp_map : ∀ {V₁ V₂ V₃ : Z.Etale} (u : V₁ ⟶ V₂) (v : V₂ ⟶ V₃),
      weilFreeYonedaMap.{u} u ≫ weilFreeYonedaMap.{u} v = weilFreeYonedaMap.{u} (u ≫ v) := by
    intro V₁ V₂ V₃ u v
    apply (fyEquiv V₁ (weilFreeYonedaZ.{u} Z V₃)).injective
    rw [hFY_map_comp, hFY_map_eq, hFY_map_eq, CategoryTheory.Category.assoc,
      ← (weilFreeYonedaZ.{u} Z V₃).obj.map_comp]
    rfl
  
  have hEffaceSucc : ∀ (n : ℕ) (F : CategoryTheory.Sheaf J AddCommGrpCat.{u})
      (ζ : CategoryTheory.Abelian.Ext (weilFreeYonedaZ.{u} Z T_Z) F (n + 1)),
      ∃ (S : CategoryTheory.Sieve T_Z),
        S ∈ J T_Z ∧
        ∀ (W : Z.Etale) (u : W ⟶ T_Z),
          S.arrows u →
          (CategoryTheory.Abelian.Ext.mk₀ (weilFreeYonedaMap.{u} u)).comp ζ
            (Nat.zero_add (n + 1)) = 0 := by
    intro n
    induction n with
    | zero =>
      intro F ζ
      let J_sh : CategoryTheory.Sheaf J AddCommGrpCat.{u} := CategoryTheory.Injective.under F
      let α : F ⟶ J_sh := CategoryTheory.Injective.ι F
      let Q_sh : CategoryTheory.Sheaf J AddCommGrpCat.{u} := CategoryTheory.Limits.cokernel α
      let β : J_sh ⟶ Q_sh := CategoryTheory.Limits.cokernel.π α
      let SC : CategoryTheory.ShortComplex (CategoryTheory.Sheaf J AddCommGrpCat.{u}) :=
        CategoryTheory.ShortComplex.mk α β (CategoryTheory.Limits.cokernel.condition α)
      have hSE : SC.ShortExact :=
        { exact := CategoryTheory.ShortComplex.exact_cokernel α }
      have hζα : ζ.comp (CategoryTheory.Abelian.Ext.mk₀ SC.f) (Nat.add_zero 1) = 0 :=
        CategoryTheory.Abelian.Ext.eq_zero_of_injective _
      obtain ⟨ξ, hξ⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₁
          (weilFreeYonedaZ.{u} Z T_Z) hSE ζ hζα (rfl : 0 + 1 = 1)
      let φ : weilFreeYonedaZ.{u} Z T_Z ⟶ Q_sh := CategoryTheory.Abelian.Ext.addEquiv₀ ξ
      have hφ : CategoryTheory.Abelian.Ext.mk₀ φ = ξ :=
        CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply ξ
      have hLocSurj : CategoryTheory.Presheaf.IsLocallySurjective J β.hom :=
        (CategoryTheory.Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u} β).mpr inferInstance
      let s₀ : ↑(Q_sh.obj.obj (Opposite.op T_Z)) :=
        (fyEquiv T_Z Q_sh φ).hom (ULift.up (1 : ℤ))
      let S : CategoryTheory.Sieve T_Z := CategoryTheory.Presheaf.imageSieve β.hom s₀
      have hS_mem : S ∈ J T_Z :=
        @CategoryTheory.Presheaf.IsLocallySurjective.imageSieve_mem _ _ J AddCommGrpCat.{u} _ _ _ _ _
          _ _ β.hom hLocSurj T_Z s₀
      refine ⟨S, hS_mem, ?_⟩
      intro W u hu
      have hu' : (CategoryTheory.Presheaf.imageSieve β.hom s₀).arrows u := hu
      rw [CategoryTheory.Presheaf.imageSieve_apply] at hu'
      obtain ⟨t, ht⟩ := hu'
      let g_t : Aℤ ⟶ J_sh.obj.obj (Opposite.op W) :=
        AddCommGrpCat.ofHom
          { toFun := fun k => k.down • t
            map_zero' := zero_zsmul t
            map_add' := fun a b => add_zsmul t a.down b.down }
      let φ_tilde : weilFreeYonedaZ.{u} Z W ⟶ J_sh :=
        (fyEquiv W J_sh).symm g_t
      have h_lift : φ_tilde ≫ β = weilFreeYonedaMap.{u} u ≫ φ := by
        apply (fyEquiv W Q_sh).injective
        rw [hFY_comp, hFY_map_comp]
        have h_tilde : fyEquiv W J_sh φ_tilde = g_t := Equiv.apply_symm_apply _ _
        rw [h_tilde]
        ext ⟨k⟩
        have hk : (⟨k⟩ : ULift.{u} ℤ) = k • ULift.up (1 : ℤ) := by
          ext
          change k = k • (1 : ℤ)
          simp
        change (β.hom.app (Opposite.op W)).hom (k • t) =
          (Q_sh.obj.map u.op).hom ((fyEquiv T_Z Q_sh φ).hom ⟨k⟩)
        rw [map_zsmul, ht, hk, map_zsmul, map_zsmul]
      rw [← hξ, ← hφ,
        ← CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.zero_add 0) (Nat.zero_add 1) (Nat.zero_add 1),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, ← h_lift,
        ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ φ_tilde β,
        CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.zero_add 0) (Nat.zero_add 1) (Nat.zero_add 1)]
      have hβ_ext : (CategoryTheory.Abelian.Ext.mk₀ β).comp hSE.extClass (Nat.zero_add 1) = 0 :=
        hSE.comp_extClass
      rw [hβ_ext, CategoryTheory.Abelian.Ext.comp_zero]
    | succ k ih =>
      intro F ζ
      let J_sh : CategoryTheory.Sheaf J AddCommGrpCat.{u} := CategoryTheory.Injective.under F
      let α : F ⟶ J_sh := CategoryTheory.Injective.ι F
      let Q_sh : CategoryTheory.Sheaf J AddCommGrpCat.{u} := CategoryTheory.Limits.cokernel α
      let β : J_sh ⟶ Q_sh := CategoryTheory.Limits.cokernel.π α
      let SC : CategoryTheory.ShortComplex (CategoryTheory.Sheaf J AddCommGrpCat.{u}) :=
        CategoryTheory.ShortComplex.mk α β (CategoryTheory.Limits.cokernel.condition α)
      have hSE : SC.ShortExact :=
        { exact := CategoryTheory.ShortComplex.exact_cokernel α }
      have hζα : ζ.comp (CategoryTheory.Abelian.Ext.mk₀ SC.f) (Nat.add_zero (k + 1 + 1)) = 0 :=
        CategoryTheory.Abelian.Ext.eq_zero_of_injective _
      obtain ⟨ξ, hξ⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₁
          (weilFreeYonedaZ.{u} Z T_Z) hSE ζ hζα (rfl : (k + 1) + 1 = k + 1 + 1)
      obtain ⟨S, hS_mem, hS_kill⟩ := ih Q_sh ξ
      refine ⟨S, hS_mem, ?_⟩
      intro W u hu
      rw [← hξ,
        ← CategoryTheory.Abelian.Ext.comp_assoc _ _ _
          (Nat.zero_add (k + 1)) (rfl : (k + 1) + 1 = k + 2) (Nat.zero_add (k + 2)),
        hS_kill W u hu, CategoryTheory.Abelian.Ext.zero_comp]
  obtain ⟨n₀, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.one_le_iff_ne_zero.mp hq)
  obtain ⟨S, hS_mem, hS_kill⟩ := hEffaceSucc n₀ F₀ ζ₀
  
  let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} := @AlgebraicGeometry.Etale
  have : P_et.IsStableUnderComposition :=
    { comp_mem := fun _ _ hf hg => by
        have : AlgebraicGeometry.Etale _ := hf
        have : AlgebraicGeometry.Etale _ := hg
        exact inferInstance }
  have hTopEq : Z.smallEtaleTopology =
      (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck :=
    AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology Z le_rfl
  have hS_pts : ∀ x' : ↥T_Z.left,
      ∃ (Y : Z.Etale) (g : Y ⟶ T_Z) (y : ↥Y.left),
        S.arrows g ∧ P_et g.left ∧ g.left y = x' := by
    have hmem : S ∈ (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck T_Z := by
      change S ∈ Z.smallEtaleTopology T_Z at hS_mem
      rwa [← hTopEq]
    exact (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
      (P := P_et) (Q := P_et) T_Z S).mp hmem
  let I_Z : Z.Etale :=
    CategoryTheory.MorphismProperty.Over.mk ⊤ (𝟙 Z)
      (inferInstance : AlgebraicGeometry.Etale (𝟙 Z))
  let τ_Z : I_Z ⟶ T_Z := hT_Z.from I_Z
  have hτ_pt : ∀ x : ↥Z, T_Z.hom.base (τ_Z.left.base x) = x := by
    intro x
    have hw : τ_Z.left ≫ T_Z.hom = 𝟙 Z := CategoryTheory.MorphismProperty.Over.w τ_Z
    change (τ_Z.left ≫ T_Z.hom).base x = (𝟙 Z : Z ⟶ Z).base x
    rw [hw]
    rfl
  have hChart : ∀ x : ↥Z,
      ∃ (Ex : CommRingCat.{u}) (fx : R ⟶ Ex) (zx : ↥(AlgebraicGeometry.Spec Ex))
        (hEt_sch : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map fx)),
        (CommRingCat.Hom.hom fx).Etale ∧
        (AlgebraicGeometry.Spec.map fx).base zx = x ∧
        S.arrows (hT_Z.from (CategoryTheory.MorphismProperty.Over.mk ⊤ (AlgebraicGeometry.Spec.map fx) hEt_sch)) := by
    intro x
    obtain ⟨Yx, gx, yx, hgx_S, _, hgx_y⟩ := hS_pts (τ_Z.left.base x)
    have hYx_y : Yx.hom.base yx = x := by
      have hw : gx.left ≫ T_Z.hom = Yx.hom := CategoryTheory.MorphismProperty.Over.w gx
      calc
        Yx.hom.base yx = (gx.left ≫ T_Z.hom).base yx := by rw [hw]
        _ = T_Z.hom.base (gx.left yx) := rfl
        _ = T_Z.hom.base (τ_Z.left.base x) := by rw [hgx_y]
        _ = x := hτ_pt x
    let 𝒰 := Yx.left.affineOpenCover
    let ix := 𝒰.idx yx
    let Ex : CommRingCat.{u} := 𝒰.X ix
    let jx : AlgebraicGeometry.Spec Ex ⟶ Yx.left := 𝒰.f ix
    obtain ⟨zx, hzx⟩ := 𝒰.covers yx
    have : AlgebraicGeometry.Etale Yx.hom := Yx.prop
    have : AlgebraicGeometry.Etale (jx ≫ Yx.hom) := inferInstance
    let fx : R ⟶ Ex := AlgebraicGeometry.Spec.preimage (jx ≫ Yx.hom)
    have hfx_map : AlgebraicGeometry.Spec.map fx = jx ≫ Yx.hom :=
      AlgebraicGeometry.Spec.map_preimage (jx ≫ Yx.hom)
    have hEt_sch : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map fx) := by
      rw [hfx_map]
      infer_instance
    have hfx_et : (CommRingCat.Hom.hom fx).Etale :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hEt_sch
    have hzx_pt : (AlgebraicGeometry.Spec.map fx).base zx = x := by
      rw [hfx_map]
      calc
        (jx ≫ Yx.hom).base zx = Yx.hom.base (jx zx) := rfl
        _ = Yx.hom.base yx := by rw [hzx]
        _ = x := hYx_y
    let Ux : Z.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (AlgebraicGeometry.Spec.map fx) hEt_sch
    let j_over : Ux ⟶ Yx := CategoryTheory.MorphismProperty.Over.homMk jx hfx_map.symm
    have hUx_S : S.arrows (hT_Z.from Ux) := by
      have heq : hT_Z.from Ux = j_over ≫ gx := hT_Z.hom_ext _ _
      rw [heq]
      exact S.downward_closed hgx_S j_over
    exact ⟨Ex, fx, zx, hEt_sch, hfx_et, hzx_pt, hUx_S⟩
  let Ex_of : ↥Z → CommRingCat.{u} := fun x => (hChart x).choose
  let fx_of : ∀ x : ↥Z, R ⟶ Ex_of x := fun x => (hChart x).choose_spec.choose
  let zx_of : ∀ x : ↥Z, ↥(AlgebraicGeometry.Spec (Ex_of x)) :=
    fun x => (hChart x).choose_spec.choose_spec.choose
  let hEt_sch_of : ∀ x : ↥Z, AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (fx_of x)) :=
    fun x => (hChart x).choose_spec.choose_spec.choose_spec.choose
  have hSpec_of : ∀ x : ↥Z,
      (CommRingCat.Hom.hom (fx_of x)).Etale ∧
      (AlgebraicGeometry.Spec.map (fx_of x)).base (zx_of x) = x ∧
      S.arrows (hT_Z.from (CategoryTheory.MorphismProperty.Over.mk ⊤
        (AlgebraicGeometry.Spec.map (fx_of x)) (hEt_sch_of x))) :=
    fun x => (hChart x).choose_spec.choose_spec.choose_spec.choose_spec
  let O_set : ↥Z → Set ↥Z := fun x => Set.range (AlgebraicGeometry.Spec.map (fx_of x)).base
  have hO_open : ∀ x : ↥Z, IsOpen (O_set x) := by
    intro x
    have : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (fx_of x)) := hEt_sch_of x
    exact (AlgebraicGeometry.Scheme.Hom.isOpenMap (AlgebraicGeometry.Spec.map (fx_of x))).isOpen_range
  have hO_univ : (Set.univ : Set ↥Z) ⊆ ⋃ x : ↥Z, O_set x := by
    intro x _
    exact Set.mem_iUnion.mpr ⟨x, zx_of x, (hSpec_of x).2.1⟩
  obtain ⟨F_fin, hF_cov⟩ := isCompact_univ.elim_finite_subcover O_set hO_open hO_univ
  let m : ℕ := Fintype.card ↥F_fin
  let e_fin : Fin m ≃ ↥F_fin := (Fintype.equivFin ↥F_fin).symm
  let E : Fin m → CommRingCat.{u} := fun s => Ex_of (e_fin s).1
  let f : ∀ s : Fin m, R ⟶ E s := fun s => fx_of (e_fin s).1
  let U_comp : Fin m → Z.Etale := fun s =>
    CategoryTheory.MorphismProperty.Over.mk ⊤ (AlgebraicGeometry.Spec.map (f s))
      (hEt_sch_of (e_fin s).1)
  have hf_et : ∀ s : Fin m, (CommRingCat.Hom.hom (f s)).Etale :=
    fun s => (hSpec_of (e_fin s).1).1
  have hf_cov : ∀ x : ↥Z, ∃ (s : Fin m) (y : ↥(AlgebraicGeometry.Spec (E s))),
      (AlgebraicGeometry.Spec.map (f s)).base y = x := by
    intro x
    have hx_mem : x ∈ ⋃ x₀ ∈ F_fin, O_set x₀ := hF_cov (Set.mem_univ x)
    rw [Set.mem_iUnion₂] at hx_mem
    obtain ⟨x₀, hx₀_mem, y, hy⟩ := hx_mem
    let s : Fin m := e_fin.symm ⟨x₀, hx₀_mem⟩
    have hs : (e_fin s).1 = x₀ := congrArg Subtype.val (e_fin.apply_symm_apply ⟨x₀, hx₀_mem⟩)
    have hex_y : ∃ y' : ↥(AlgebraicGeometry.Spec (Ex_of (e_fin s).1)),
        (AlgebraicGeometry.Spec.map (fx_of (e_fin s).1)).base y' = x := by
      rw [hs]
      exact ⟨y, hy⟩
    obtain ⟨y', hy'⟩ := hex_y
    exact ⟨s, y', hy'⟩
  have hKill : ∀ s : Fin m,
      (CategoryTheory.Abelian.Ext.mk₀ (weilFreeYonedaMap.{u} (hT_Z.from (U_comp s)))).comp ζ₀
        (Nat.zero_add (n₀ + 1)) = 0 :=
    fun s => hS_kill (U_comp s) (hT_Z.from (U_comp s)) (hSpec_of (e_fin s).1).2.2
  
  obtain ⟨E_prod, f_prod, π_comp, hfac, hf_prod_et, hf_prod_surj, hOpen, hCov_prod, hDisj⟩ :=
    hEtDesc.2 R m E f hf_et hf_cov
  refine ⟨E_prod, f_prod, hf_prod_et, hf_prod_surj, ?_⟩
  intro U eU heU
  let ι_left : ∀ s : Fin m, (U_comp s).left ⟶ U.left :=
    fun s => AlgebraicGeometry.Spec.map (π_comp s) ≫ eU.hom
  have hι_tri : ∀ s : Fin m, ι_left s ≫ U.hom = (U_comp s).hom := by
    intro s
    change (AlgebraicGeometry.Spec.map (π_comp s) ≫ eU.hom) ≫ U.hom = AlgebraicGeometry.Spec.map (f s)
    rw [CategoryTheory.Category.assoc, heU, ← AlgebraicGeometry.Spec.map_comp, hfac s]
  let ι : ∀ s : Fin m, U_comp s ⟶ U :=
    fun s => CategoryTheory.MorphismProperty.Over.homMk (ι_left s) (hι_tri s)
  have hι_open : ∀ s : Fin m, AlgebraicGeometry.IsOpenImmersion (ι s).left := by
    intro s
    change AlgebraicGeometry.IsOpenImmersion (AlgebraicGeometry.Spec.map (π_comp s) ≫ eU.hom)
    have : AlgebraicGeometry.IsOpenImmersion (AlgebraicGeometry.Spec.map (π_comp s)) := hOpen s
    infer_instance
  have hι_et : ∀ s : Fin m, AlgebraicGeometry.Etale (ι s).left := by
    intro s
    have := hι_open s
    infer_instance
  have hι_mono : ∀ s : Fin m, CategoryTheory.Mono (ι s) := by
    intro s
    have : AlgebraicGeometry.IsOpenImmersion (ι s).left := hι_open s
    have : CategoryTheory.Mono (ι s).left := AlgebraicGeometry.IsOpenImmersion.mono (ι s).left
    refine ⟨fun {W} g₁ g₂ hgg => ?_⟩
    apply CategoryTheory.MorphismProperty.Over.Hom.ext
    have hleft : g₁.left ≫ (ι s).left = g₂.left ≫ (ι s).left :=
      congrArg (fun k : W ⟶ U => k.left) hgg
    exact (cancel_mono (ι s).left).mp hleft
  have hCov_U : CategoryTheory.Sieve.ofArrows U_comp ι ∈ J U := by
    change CategoryTheory.Sieve.ofArrows U_comp ι ∈ Z.smallEtaleTopology U
    rw [hTopEq]
    refine (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
      (P := P_et) (Q := P_et) U (CategoryTheory.Sieve.ofArrows U_comp ι)).mpr ?_
    intro u_pt
    obtain ⟨s, y, hy⟩ := hCov_prod (eU.inv.base u_pt)
    refine ⟨U_comp s, ι s, y, CategoryTheory.Sieve.ofArrows_mk U_comp ι s, hι_et s, ?_⟩
    change (AlgebraicGeometry.Spec.map (π_comp s) ≫ eU.hom).base y = u_pt
    calc
      eU.hom.base ((AlgebraicGeometry.Spec.map (π_comp s)).base y)
          = eU.hom.base (eU.inv.base u_pt) := by rw [hy]
      _ = (eU.inv ≫ eU.hom).base u_pt := rfl
      _ = (𝟙 U.left : U.left ⟶ U.left).base u_pt := by rw [eU.inv_hom_id]
      _ = u_pt := rfl
  have hDisjTerm : ∀ {W : Z.Etale} {i j : Fin m} (a : W ⟶ U_comp i) (b : W ⟶ U_comp j),
      i ≠ j → a ≫ ι i = b ≫ ι j →
      ∀ (M : CategoryTheory.Sheaf J AddCommGrpCat.{u}),
        CategoryTheory.Limits.IsTerminal (M.obj.obj (Opposite.op W)) := by
    intro W i j a b hij hab M
    have hleft : (a.left ≫ AlgebraicGeometry.Spec.map (π_comp i)) ≫ eU.hom =
        (b.left ≫ AlgebraicGeometry.Spec.map (π_comp j)) ≫ eU.hom := by
      have h0 : a.left ≫ (AlgebraicGeometry.Spec.map (π_comp i) ≫ eU.hom) =
          b.left ≫ (AlgebraicGeometry.Spec.map (π_comp j) ≫ eU.hom) :=
        congrArg (fun k : W ⟶ U => k.left) hab
      calc
        (a.left ≫ AlgebraicGeometry.Spec.map (π_comp i)) ≫ eU.hom
            = a.left ≫ (AlgebraicGeometry.Spec.map (π_comp i) ≫ eU.hom) :=
              CategoryTheory.Category.assoc _ _ _
        _ = b.left ≫ (AlgebraicGeometry.Spec.map (π_comp j) ≫ eU.hom) := h0
        _ = (b.left ≫ AlgebraicGeometry.Spec.map (π_comp j)) ≫ eU.hom :=
              (CategoryTheory.Category.assoc _ _ _).symm
    have hpb_eq : a.left ≫ AlgebraicGeometry.Spec.map (π_comp i) =
        b.left ≫ AlgebraicGeometry.Spec.map (π_comp j) :=
      (cancel_mono eU.hom).mp hleft
    let lift_pb : W.left ⟶ CategoryTheory.Limits.pullback
        (AlgebraicGeometry.Spec.map (π_comp i))
        (AlgebraicGeometry.Spec.map (π_comp j)) :=
      CategoryTheory.Limits.pullback.lift a.left b.left hpb_eq
    have : IsEmpty ↥(CategoryTheory.Limits.pullback
        (AlgebraicGeometry.Spec.map (π_comp i))
        (AlgebraicGeometry.Spec.map (π_comp j))) := hDisj i j hij
    have hEmptyW : IsEmpty ↥W.left := ⟨fun w => IsEmpty.false (lift_pb.base w)⟩
    have hBot : (⊥ : CategoryTheory.Sieve W) ∈ J W := by
      let botW : CategoryTheory.Sieve W := ⊥
      change botW ∈ Z.smallEtaleTopology W
      rw [hTopEq]
      refine (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) W botW).mpr ?_
      intro w
      exact hEmptyW.elim w
    exact CategoryTheory.Sheaf.isTerminalOfBotCover M W hBot
  
  let x_fam : ∀ (s t : Fin m), Aℤ ⟶ (weilFreeYonedaZ.{u} Z (U_comp s)).obj.obj (Opposite.op (U_comp t)) :=
    fun s t =>
      if h : t = s then
        fyEquiv (U_comp s) (weilFreeYonedaZ.{u} Z (U_comp s)) (𝟙 (weilFreeYonedaZ.{u} Z (U_comp s))) ≫
          (weilFreeYonedaZ.{u} Z (U_comp s)).obj.map (Opposite.op (eqToHom (congrArg U_comp h)))
      else 0
  have hx_compat : ∀ (s : Fin m) ⦃W : Z.Etale⦄ ⦃i j : Fin m⦄ (a : W ⟶ U_comp i) (b : W ⟶ U_comp j),
      a ≫ ι i = b ≫ ι j →
      x_fam s i ≫ (weilFreeYonedaZ.{u} Z (U_comp s)).obj.map a.op =
        x_fam s j ≫ (weilFreeYonedaZ.{u} Z (U_comp s)).obj.map b.op := by
    intro s W i j a b hab
    by_cases hij : i = j
    · subst hij
      have : CategoryTheory.Mono (ι i) := hι_mono i
      have hab' : a = b := (cancel_mono (ι i)).mp hab
      subst hab'
      rfl
    · exact (hDisjTerm a b hij hab (weilFreeYonedaZ.{u} Z (U_comp s))).hom_ext _ _
  let σ : ∀ s : Fin m, Aℤ ⟶ (weilFreeYonedaZ.{u} Z (U_comp s)).obj.obj (Opposite.op U) :=
    fun s => ((weilFreeYonedaZ.{u} Z (U_comp s)).property).amalgamateOfArrows
      ι hCov_U (x_fam s) (hx_compat s)
  have hσ_map : ∀ (s t : Fin m),
      σ s ≫ (weilFreeYonedaZ.{u} Z (U_comp s)).obj.map (ι t).op = x_fam s t :=
    fun s t => ((weilFreeYonedaZ.{u} Z (U_comp s)).property).amalgamateOfArrows_map
      ι hCov_U (x_fam s) (hx_compat s) t
  let ψ : ∀ s : Fin m, weilFreeYonedaZ.{u} Z U ⟶ weilFreeYonedaZ.{u} Z (U_comp s) :=
    fun s => (fyEquiv U (weilFreeYonedaZ.{u} Z (U_comp s))).symm (σ s)
  
  have hPartUnity : (∑ s : Fin m, (ψ s ≫ weilFreeYonedaMap.{u} (ι s))) =
      𝟙 (weilFreeYonedaZ.{u} Z U) := by
    apply (fyEquiv U (weilFreeYonedaZ.{u} Z U)).injective
    apply ((weilFreeYonedaZ.{u} Z U).property).hom_ext_ofArrows ι hCov_U
    intro t
    have hsum_equiv :
        fyEquiv U (weilFreeYonedaZ.{u} Z U)
          (∑ s : Fin m, (ψ s ≫ weilFreeYonedaMap.{u} (ι s))) =
        ∑ s : Fin m, (σ s ≫ (weilFreeYonedaMap.{u} (ι s)).hom.app (Opposite.op U)) := by
      rw [← hFY_id_comp]
      have h_app_sum :
          (∑ s : Fin m, (ψ s ≫ weilFreeYonedaMap.{u} (ι s))).hom.app (Opposite.op U) =
          ∑ s : Fin m, (ψ s ≫ weilFreeYonedaMap.{u} (ι s)).hom.app (Opposite.op U) := by
        let F_forget := CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u}
        let ev_U := (CategoryTheory.evaluation (Z.Etale)ᵒᵖ AddCommGrpCat.{u}).obj (Opposite.op U)
        change ev_U.map (F_forget.map (∑ s : Fin m, (ψ s ≫ weilFreeYonedaMap.{u} (ι s)))) = _
        rw [CategoryTheory.Functor.map_sum, CategoryTheory.Functor.map_sum]
        rfl
      rw [h_app_sum, CategoryTheory.Preadditive.comp_sum]
      refine Finset.sum_congr rfl fun s _ => ?_
      rw [hFY_id_comp, hFY_comp]
      have hψ_s : fyEquiv U (weilFreeYonedaZ.{u} Z (U_comp s)) (ψ s) = σ s :=
        Equiv.apply_symm_apply _ _
      rw [hψ_s]
    rw [hsum_equiv, CategoryTheory.Preadditive.sum_comp]
    have hterm : ∀ s : Fin m,
        (σ s ≫ (weilFreeYonedaMap.{u} (ι s)).hom.app (Opposite.op U)) ≫
          (weilFreeYonedaZ.{u} Z U).obj.map (ι t).op =
        x_fam s t ≫ (weilFreeYonedaMap.{u} (ι s)).hom.app (Opposite.op (U_comp t)) := by
      intro s
      rw [CategoryTheory.Category.assoc, ← (weilFreeYonedaMap.{u} (ι s)).hom.naturality (ι t).op,
        ← CategoryTheory.Category.assoc, hσ_map s t]
    simp_rw [hterm]
    rw [Finset.sum_eq_single t]
    · have hx_diag : x_fam t t =
          fyEquiv (U_comp t) (weilFreeYonedaZ.{u} Z (U_comp t))
            (𝟙 (weilFreeYonedaZ.{u} Z (U_comp t))) := by
        dsimp only [x_fam]
        split_ifs with htt
        · rw [Subsingleton.elim htt rfl, eqToHom_refl]
          change _ ≫ (weilFreeYonedaZ.{u} Z (U_comp t)).obj.map (𝟙 (Opposite.op (U_comp t))) = _
          rw [CategoryTheory.Functor.map_id, CategoryTheory.Category.comp_id]
        · exact False.elim (htt rfl)
      rw [hx_diag, hFY_id_comp, hFY_map_eq]
      rfl
    · intro s _ hst
      have hts : t ≠ s := Ne.symm hst
      have hx_off : x_fam s t = 0 := by
        dsimp only [x_fam]
        split_ifs with h_eq
        · exact False.elim (hts h_eq)
        · rfl
      rw [hx_off, CategoryTheory.Limits.zero_comp]
    · intro ht_abs
      exact False.elim (ht_abs (Finset.mem_univ t))
  have hMapDecomp : weilFreeYonedaMap.{u} (hT_Z.from U) =
      ∑ s : Fin m, (ψ s ≫ weilFreeYonedaMap.{u} (hT_Z.from (U_comp s))) := by
    calc
      weilFreeYonedaMap.{u} (hT_Z.from U)
          = 𝟙 (weilFreeYonedaZ.{u} Z U) ≫ weilFreeYonedaMap.{u} (hT_Z.from U) :=
            (CategoryTheory.Category.id_comp _).symm
      _ = (∑ s : Fin m, (ψ s ≫ weilFreeYonedaMap.{u} (ι s))) ≫
            weilFreeYonedaMap.{u} (hT_Z.from U) := by rw [hPartUnity]
      _ = ∑ s : Fin m, ((ψ s ≫ weilFreeYonedaMap.{u} (ι s)) ≫
            weilFreeYonedaMap.{u} (hT_Z.from U)) := CategoryTheory.Preadditive.sum_comp _ _ _
      _ = ∑ s : Fin m, (ψ s ≫ weilFreeYonedaMap.{u} (hT_Z.from (U_comp s))) := by
        refine Finset.sum_congr rfl fun s _ => ?_
        rw [CategoryTheory.Category.assoc, hFY_map_comp_map]
        have hfrom : ι s ≫ hT_Z.from U = hT_Z.from (U_comp s) := hT_Z.hom_ext _ _
        rw [hfrom]
  rw [hMapDecomp, CategoryTheory.Abelian.Ext.mk₀_sum, CategoryTheory.Abelian.Ext.sum_comp]
  apply Finset.sum_eq_zero
  intro s _
  rw [← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
    CategoryTheory.Abelian.Ext.comp_assoc _ _ _
      (Nat.zero_add 0) (Nat.zero_add (n₀ + 1)) (Nat.zero_add (n₀ + 1)),
    hKill s, CategoryTheory.Abelian.Ext.comp_zero]

theorem weil_etale_basePullExt_functoriality_and_rebase (hc_all : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      (weilEtaleSitePullback f).IsContinuous Z₂.smallEtaleTopology Z₁.smallEtaleTopology)
    (hr_all : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _ (weilEtaleSitePullback f)
        AddCommGrpCat.{u} _ Z₂.smallEtaleTopology Z₁.smallEtaleTopology (@hc_all Z₁ Z₂ f)).IsRightAdjoint)
    (hSite : WeilEtaleSiteExactAndSliceInjHolds.{u} (@hc_all) (@hr_all)) :
    WeilEtaleBasePullExtFunctorialityHolds.{u} (@hc_all) (@hr_all) hSite :=
by
  have : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) f :=
    fun _ => MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  have : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) f :=
    fun _ => MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  have : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      (weilEtaleSitePullback f).IsContinuous Z₂.smallEtaleTopology Z₁.smallEtaleTopology := @hc_all
  have : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      ((weilEtaleSitePullback f).sheafPushforwardContinuous AddCommGrpCat.{u}
        Z₂.smallEtaleTopology Z₁.smallEtaleTopology).IsRightAdjoint := @hr_all
  have hP₁ : ∀ {Y₀ Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}}
      (π₁ : Quiver.Hom Y₁ Y₀) (π₂ : Quiver.Hom Y₂ Y₀) (h : Quiver.Hom Y₁ Y₂)
      (h_eq : h ≫ π₂ = π₁),
    let pb₁ := (weilEtaleSitePullback π₁).sheafPullback AddCommGrpCat.{u} Y₀.smallEtaleTopology Y₁.smallEtaleTopology
    let pb₂ := (weilEtaleSitePullback π₂).sheafPullback AddCommGrpCat.{u} Y₀.smallEtaleTopology Y₂.smallEtaleTopology
    let pb_h := (weilEtaleSitePullback h).sheafPullback AddCommGrpCat.{u} Y₂.smallEtaleTopology Y₁.smallEtaleTopology
    (∀ (X : Sheaf Y₀.smallEtaleTopology AddCommGrpCat.{u}),
      weilEtalePullMateHom.{u} π₁ π₂ h h_eq X ≫
        weilEtalePullMateInv.{u} π₁ π₂ h h_eq X = 𝟙 (pb₁.obj X) ∧
      weilEtalePullMateInv.{u} π₁ π₂ h h_eq X ≫
        weilEtalePullMateHom.{u} π₁ π₂ h h_eq X = 𝟙 (pb_h.obj (pb₂.obj X))) ∧
    (∀ {X Y : Sheaf Y₀.smallEtaleTopology AddCommGrpCat.{u}} (u : X ⟶ Y),
      pb₁.map u ≫ weilEtalePullMateHom.{u} π₁ π₂ h h_eq Y =
        weilEtalePullMateHom.{u} π₁ π₂ h h_eq X ≫ pb_h.map (pb₂.map u) ∧
      pb_h.map (pb₂.map u) ≫ weilEtalePullMateInv.{u} π₁ π₂ h h_eq Y =
        weilEtalePullMateInv.{u} π₁ π₂ h h_eq X ≫ pb₁.map u) := by
    intro Y₀ Y₁ Y₂ π₁ π₂ h h_eq pb₁ pb₂ pb_h
    let B₁ := weilEtaleSitePullback π₁
    let B₂ := weilEtaleSitePullback π₂
    let B_h := weilEtaleSitePullback h
    let pf₁ := B₁.sheafPushforwardContinuous AddCommGrpCat.{u} Y₀.smallEtaleTopology Y₁.smallEtaleTopology
    let pf₂ := B₂.sheafPushforwardContinuous AddCommGrpCat.{u} Y₀.smallEtaleTopology Y₂.smallEtaleTopology
    let pf_h := B_h.sheafPushforwardContinuous AddCommGrpCat.{u} Y₂.smallEtaleTopology Y₁.smallEtaleTopology
    let adj₁ := B₁.sheafAdjunctionContinuous AddCommGrpCat.{u} Y₀.smallEtaleTopology Y₁.smallEtaleTopology
    let adj₂ := B₂.sheafAdjunctionContinuous AddCommGrpCat.{u} Y₀.smallEtaleTopology Y₂.smallEtaleTopology
    let adj_h := B_h.sheafAdjunctionContinuous AddCommGrpCat.{u} Y₂.smallEtaleTopology Y₁.smallEtaleTopology
    let e_B : B₁ ≅ B₂ ⋙ B_h :=
      (MorphismProperty.Over.pullbackCongr h_eq.symm).trans (MorphismProperty.Over.pullbackComp h π₂)
    have : (B₂ ⋙ B_h).IsContinuous Y₀.smallEtaleTopology Y₁.smallEtaleTopology :=
      Functor.isContinuous_comp B₂ B_h
        Y₀.smallEtaleTopology Y₂.smallEtaleTopology Y₁.smallEtaleTopology
    let e_pf := Functor.sheafPushforwardContinuousIso e_B
      AddCommGrpCat.{u} Y₀.smallEtaleTopology Y₁.smallEtaleTopology
    let adj₁₂ : (pb₂ ⋙ pb_h) ⊣ pf₁ := (adj₂.comp adj_h).ofNatIsoRight e_pf.symm
    let η : pb₁ ≅ (pb₂ ⋙ pb_h) := adj₁.leftAdjointUniq adj₁₂
    have h_unit₁₂ : ∀ X, adj₁₂.unit.app X =
        adj₂.unit.app X ≫ (pf₂.map (adj_h.unit.app (pb₂.obj X)) ≫
          e_pf.inv.app (pb_h.obj (pb₂.obj X))) := by
      intro X
      dsimp only [adj₁₂, Adjunction.ofNatIsoRight, Adjunction.comp]
      exact Category.assoc _ _ _
    have hη_hom : ∀ X, η.hom.app X = weilEtalePullMateHom.{u} π₁ π₂ h h_eq X := by
      intro X
      apply (adj₁.homEquiv X ((pb₂ ⋙ pb_h).obj X)).injective
      refine (Adjunction.homEquiv_leftAdjointUniq_hom_app adj₁ adj₁₂ X).trans ?_
      exact (h_unit₁₂ X).trans ((adj₁.homEquiv X (pb_h.obj (pb₂.obj X))).apply_symm_apply _).symm
    have hη_inv : ∀ X, η.inv.app X = weilEtalePullMateInv.{u} π₁ π₂ h h_eq X := by
      intro X
      let β_X := weilEtalePullMateInv.{u} π₁ π₂ h h_eq X
      refine (Adjunction.leftAdjointUniq_inv_app adj₁ adj₁₂ X).trans ?_
      apply (adj₁₂.homEquiv X (pb₁.obj X)).injective
      refine (Adjunction.homEquiv_leftAdjointUniq_hom_app adj₁₂ adj₁ X).trans ?_
      symm
      have h_nat : e_pf.inv.app (pb_h.obj (pb₂.obj X)) ≫ pf₁.map β_X =
          pf₂.map (pf_h.map β_X) ≫ e_pf.inv.app (pb₁.obj X) :=
        (e_pf.inv.naturality β_X).symm
      have hβ₁ : adj_h.unit.app (pb₂.obj X) ≫ pf_h.map β_X =
          (adj₂.homEquiv X (pf_h.obj (pb₁.obj X))).symm
            (adj₁.unit.app X ≫ e_pf.hom.app (pb₁.obj X)) :=
        (Adjunction.homEquiv_unit adj_h (pb₂.obj X) (pb₁.obj X) β_X).symm.trans
          ((adj_h.homEquiv (pb₂.obj X) (pb₁.obj X)).apply_symm_apply _)
      have hβ₂ : adj₂.unit.app X ≫ pf₂.map ((adj₂.homEquiv X (pf_h.obj (pb₁.obj X))).symm
            (adj₁.unit.app X ≫ e_pf.hom.app (pb₁.obj X))) =
          adj₁.unit.app X ≫ e_pf.hom.app (pb₁.obj X) :=
        (Adjunction.homEquiv_unit adj₂ X (pf_h.obj (pb₁.obj X)) _).symm.trans
          ((adj₂.homEquiv X (pf_h.obj (pb₁.obj X))).apply_symm_apply _)
      refine (Adjunction.homEquiv_unit adj₁₂ X (pb₁.obj X) β_X).trans ?_
      erw [h_unit₁₂ X, Category.assoc, Category.assoc, h_nat,
        ← Category.assoc (pf₂.map _), ← pf₂.map_comp, hβ₁,
        ← Category.assoc (adj₂.unit.app X), hβ₂,
        Category.assoc, e_pf.hom_inv_id_app, Category.comp_id]
    refine ⟨fun X => ?_, fun {X Y} u => ?_⟩
    · erw [← hη_hom X, ← hη_inv X]
      exact ⟨η.hom_inv_id_app X, η.inv_hom_id_app X⟩
    · erw [← hη_hom X, ← hη_hom Y, ← hη_inv X, ← hη_inv Y]
      exact ⟨η.hom.naturality u, η.inv.naturality u⟩
  have heB_fst : ∀ {S₀ S₁ S₂ : AlgebraicGeometry.Scheme.{u}}
      (g_comp : Quiver.Hom S₂ S₀) (g_out : Quiver.Hom S₁ S₀) (g_in : Quiver.Hom S₂ S₁)
      (hg : g_in ≫ g_out = g_comp) (V : S₀.Etale),
      let v_hom : Quiver.Hom V.left S₀ := V.hom
      let v₁_hom : Quiver.Hom ((weilEtaleSitePullback g_out).obj V).left S₁ :=
        ((weilEtaleSitePullback g_out).obj V).hom
      let e_g : weilEtaleSitePullback g_comp ≅
          weilEtaleSitePullback g_out ⋙ weilEtaleSitePullback g_in :=
        (MorphismProperty.Over.pullbackCongr hg.symm).trans
          (MorphismProperty.Over.pullbackComp g_in g_out)
      let e_left : Quiver.Hom ((weilEtaleSitePullback g_comp).obj V).left
          ((weilEtaleSitePullback g_in).obj ((weilEtaleSitePullback g_out).obj V)).left :=
        (e_g.hom.app V).left
      (e_left ≫ Limits.pullback.fst v₁_hom g_in) ≫ Limits.pullback.fst v_hom g_out =
        Limits.pullback.fst v_hom g_comp := by
    intro S₀ S₁ S₂ g_comp g_out g_in hg V v_hom v₁_hom e_g e_left
    let e_congr : weilEtaleSitePullback g_comp ≅ weilEtaleSitePullback (g_in ≫ g_out) :=
      MorphismProperty.Over.pullbackCongr hg.symm
    let e_comp : weilEtaleSitePullback (g_in ≫ g_out) ≅
        weilEtaleSitePullback g_out ⋙ weilEtaleSitePullback g_in :=
      MorphismProperty.Over.pullbackComp g_in g_out
    let c₁ : Quiver.Hom ((weilEtaleSitePullback g_comp).obj V).left
        ((weilEtaleSitePullback (g_in ≫ g_out)).obj V).left :=
      (e_congr.hom.app V).left
    let c₂ : Quiver.Hom ((weilEtaleSitePullback (g_in ≫ g_out)).obj V).left
        ((weilEtaleSitePullback g_in).obj ((weilEtaleSitePullback g_out).obj V)).left :=
      (e_comp.hom.app V).left
    have h_comp : (c₂ ≫ Limits.pullback.fst v₁_hom g_in) ≫ Limits.pullback.fst v_hom g_out =
        Limits.pullback.fst v_hom (g_in ≫ g_out) :=
      (Category.assoc _ _ _).trans
        (MorphismProperty.Over.pullbackComp_left_fst_fst
          (P := @AlgebraicGeometry.Etale) (Q := ⊤) g_in g_out V)
    have h_congr : c₁ ≫ Limits.pullback.fst v_hom (g_in ≫ g_out) =
        Limits.pullback.fst v_hom g_comp :=
      MorphismProperty.Over.pullbackCongr_hom_app_left_fst
        (P := @AlgebraicGeometry.Etale) (Q := ⊤) hg.symm V
    have he_eq : e_left = c₁ ≫ c₂ := rfl
    exact (congrArg (fun k => (k ≫ Limits.pullback.fst v₁_hom g_in) ≫
        Limits.pullback.fst v_hom g_out) he_eq).trans
      ((congrArg (· ≫ Limits.pullback.fst v_hom g_out)
          (Category.assoc c₁ c₂ (Limits.pullback.fst v₁_hom g_in))).trans
        ((Category.assoc c₁ (c₂ ≫ Limits.pullback.fst v₁_hom g_in)
          (Limits.pullback.fst v_hom g_out)).trans
          ((congrArg (c₁ ≫ ·) h_comp).trans h_congr)))
  have hMap_fst : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom S₁ S₂)
