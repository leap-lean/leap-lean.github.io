        { app := fun U => g_m ≫ F.obj.map (Opposite.op ((hTerm Z).from U.unop))
          naturality := fun {U₁ U₂} f => by
            have h1 : Pℤ.map f ≫ g_m ≫ F.obj.map (Opposite.op ((hTerm Z).from U₂.unop)) =
