        _ = CategoryTheory.CategoryStruct.comp (uX i) (f_lvl i) := (huX_f i).symm
    · rw [CategoryTheory.Category.assoc, hvX θ, huX j, huX i]
  have hvX_comp : ∀ {i j l : ℐ} (θ : Quiver.Hom i j) (θ' : Quiver.Hom j l),
