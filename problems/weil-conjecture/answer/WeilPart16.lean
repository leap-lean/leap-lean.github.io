        (g₁ : Quiver.Hom Z₁ (AlgebraicGeometry.Spec (CommRingCat.of R₀_a)))
        (f₁ : Quiver.Hom X₁ Z₁) (π₁ : Quiver.Hom X₁ X₀_a)
        (hpb₁ : CategoryTheory.IsPullback π₁ f₁ f₀_a g₁)
        (F₀ : Sh X₀_a),
        H_grp (pb_obj g₁ (pf_obj f₀_a F₀)) 0 →+ H_grp (pb_obj π₁ F₀) 0 :=
      fun g₁ f₁ π₁ hpb₁ F₀ =>
        (eBase_of f₁ (pb_obj π₁ F₀)).symm.toAddMonoidHom.comp
          ((bc_sec g₁ f₁ π₁ hpb₁ F₀).hom.comp
            (eH₀_of (pb_obj g₁ (pf_obj f₀_a F₀))).toAddMonoidHom)
    have hbcH₀_eval : ∀ {Z₁ X₁ : AlgebraicGeometry.Scheme.{u}}
        (g₁ : Quiver.Hom Z₁ (AlgebraicGeometry.Spec (CommRingCat.of R₀_a)))
        (f₁ : Quiver.Hom X₁ Z₁) (π₁ : Quiver.Hom X₁ X₀_a)
        (hpb₁ : CategoryTheory.IsPullback π₁ f₁ f₀_a g₁)
        (F₀ : Sh X₀_a) (x : H_grp (pb_obj g₁ (pf_obj f₀_a F₀)) 0),
