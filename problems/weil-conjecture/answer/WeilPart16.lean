      _ = pb_f₁.map β₄ ≫ β₃ := by rw [h1.1, Category.comp_id]
  have hMapId : ∀ (Z₁ : AlgebraicGeometry.Scheme.{u})
      (X Y : Sheaf Z₁.smallEtaleTopology AddCommGrpCat.{u})
      (q : ℕ) (x : Abelian.Ext X Y q),
      ((Functor.id (Sheaf Z₁.smallEtaleTopology AddCommGrpCat.{u})).mapExtAddHom X Y q) x = x := by
    intro Z₁ X Y q x
    rw [Functor.mapExtAddHom_apply]
    induction q generalizing X Y with
    | zero =>
      obtain ⟨f, rfl⟩ := (Abelian.Ext.mk₀_bijective X Y).surjective x
      rw [Abelian.Ext.mapExactFunctor_mk₀]
      rfl
    | succ q ih =>
      let IdF := Functor.id (Sheaf Z₁.smallEtaleTopology AddCommGrpCat.{u})
      let ι := Injective.ι Y
      let π := Limits.cokernel.π ι
      let S := ShortComplex.mk ι π (Limits.cokernel.condition ι)
      have hS : S.ShortExact :=
        ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel ι) inferInstance inferInstance
      have : Injective S.X₂ := by
        dsimp [S]
        infer_instance
      let x' : Abelian.Ext X S.X₁ (q + 1) := x
      have hx0 : x'.comp (Abelian.Ext.mk₀ S.f) (Nat.add_zero (q + 1)) = 0 :=
        Abelian.Ext.eq_zero_of_injective _
      obtain ⟨x₀, hx₀⟩ := Abelian.Ext.covariant_sequence_exact₁ X hS x' hx0 rfl
      change Abelian.Ext.mapExactFunctor IdF x' = x'
      rw [← hx₀, Abelian.Ext.mapExactFunctor_comp,
        Abelian.Ext.mapExactFunctor_extClass, ih X S.X₃ x₀]
  have hMapComp : ∀ (Z₁ Z₂ Z₃ : AlgebraicGeometry.Scheme.{u})
      (F : Functor (Sheaf Z₁.smallEtaleTopology AddCommGrpCat.{u})
        (Sheaf Z₂.smallEtaleTopology AddCommGrpCat.{u}))
      (G : Functor (Sheaf Z₂.smallEtaleTopology AddCommGrpCat.{u})
        (Sheaf Z₃.smallEtaleTopology AddCommGrpCat.{u}))
      [F.Additive] [Limits.PreservesFiniteLimits F] [Limits.PreservesFiniteColimits F]
      [G.Additive] [Limits.PreservesFiniteLimits G] [Limits.PreservesFiniteColimits G]
      (X Y : Sheaf Z₁.smallEtaleTopology AddCommGrpCat.{u})
      (q : ℕ) (x : Abelian.Ext X Y q),
      ((F.comp G).mapExtAddHom X Y q) x =
        (G.mapExtAddHom (F.obj X) (F.obj Y) q) ((F.mapExtAddHom X Y q) x) := by
    intro Z₁ Z₂ Z₃ F G _ _ _ _ _ _ X Y q x
    simp only [Functor.mapExtAddHom_apply]
    induction q generalizing X Y with
    | zero =>
      obtain ⟨f, rfl⟩ := (Abelian.Ext.mk₀_bijective X Y).surjective x
      simp only [Abelian.Ext.mapExactFunctor_mk₀]
      rfl
    | succ q ih =>
      let ι := Injective.ι Y
      let π := Limits.cokernel.π ι
      let S := ShortComplex.mk ι π (Limits.cokernel.condition ι)
      have hS : S.ShortExact :=
        ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel ι) inferInstance inferInstance
      have : Injective S.X₂ := by
        dsimp [S]
        infer_instance
      let x' : Abelian.Ext X S.X₁ (q + 1) := x
      have hx0 : x'.comp (Abelian.Ext.mk₀ S.f) (Nat.add_zero (q + 1)) = 0 :=
        Abelian.Ext.eq_zero_of_injective _
      obtain ⟨x₀, hx₀⟩ := Abelian.Ext.covariant_sequence_exact₁ X hS x' hx0 rfl
      change Abelian.Ext.mapExactFunctor (F.comp G) x' =
        Abelian.Ext.mapExactFunctor G (Abelian.Ext.mapExactFunctor F x')
      rw [← hx₀, Abelian.Ext.mapExactFunctor_comp,
        Abelian.Ext.mapExactFunctor_extClass,
        Abelian.Ext.mapExactFunctor_comp,
        Abelian.Ext.mapExactFunctor_comp,
        Abelian.Ext.mapExactFunctor_extClass,
        Abelian.Ext.mapExactFunctor_extClass, ih X S.X₃ x₀]
  have hMapIso : ∀ (Z₁ Z₂ : AlgebraicGeometry.Scheme.{u})
      (F₁ F₂ : Functor (Sheaf Z₁.smallEtaleTopology AddCommGrpCat.{u})
        (Sheaf Z₂.smallEtaleTopology AddCommGrpCat.{u}))
      [F₁.Additive] [Limits.PreservesFiniteLimits F₁] [Limits.PreservesFiniteColimits F₁]
      [F₂.Additive] [Limits.PreservesFiniteLimits F₂] [Limits.PreservesFiniteColimits F₂]
      (ε : F₁ ≅ F₂)
      (X Y : Sheaf Z₁.smallEtaleTopology AddCommGrpCat.{u})
