        (Fintype.equivFin (∀ j : Fin r, Fin (n j + 1))).symm
    let IsZeroAt : Fin r → Fin (N + 1) → Prop :=
      fun j β => ∃ h : β.val < M, e ⟨β.val, h⟩ j = 0
