    change (CategoryTheory.Abelian.Ext.mk₀ inv_cℤ).comp
      ((CategoryTheory.Abelian.Ext.mk₀ cℤ).comp x (Nat.zero_add q)) (Nat.zero_add q) = x
    rw [← CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.zero_add 0) (Nat.zero_add q) (Nat.zero_add q),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.IsIso.inv_hom_id,
      CategoryTheory.Abelian.Ext.mk₀_id_comp]
  have hfrom_to : ∀ {Y : AlgebraicGeometry.Scheme.{u}} (π : Quiver.Hom Y X₀)
      (y : CategoryTheory.Abelian.Ext
        (((weilEtaleSitePullback π).sheafPullback AddCommGrpCat.{u}
          X₀.smallEtaleTopology Y.smallEtaleTopology).obj Fℤ₀)
        (((weilEtaleSitePullback π).sheafPullback AddCommGrpCat.{u}
          X₀.smallEtaleTopology Y.smallEtaleTopology).obj F₀) q),
      fromH π (toH π y) = y := by
    intro Y π y
    let cℤ := weilSliceColimConstZHom.{u} (@hc_all) (@hr_all) π
    letI : CategoryTheory.IsIso cℤ := (hSite.1 π).2.2.2
    let inv_cℤ := CategoryTheory.inv cℤ
    change (CategoryTheory.Abelian.Ext.mk₀ cℤ).comp
      ((CategoryTheory.Abelian.Ext.mk₀ inv_cℤ).comp y (Nat.zero_add q)) (Nat.zero_add q) = y
    rw [← CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.zero_add 0) (Nat.zero_add q) (Nat.zero_add q),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.IsIso.hom_inv_id,
      CategoryTheory.Abelian.Ext.mk₀_id_comp]
  refine ⟨?_, ?_⟩
  · intro x_inf
    obtain ⟨i, y_i, hy_i⟩ := hSysFℤ.1 (fromH π_inf x_inf)
    refine ⟨i, toH (π_lvl i) y_i, (hTriIff π_inf (π_lvl i) (uX i) (huX i) F₀ q _ x_inf).mpr ?_⟩
    exact (hConstNat π_inf (π_lvl i) (uX i) (huX i) F₀ q y_i).symm.trans
