    let Fℤ := (CategoryTheory.constantSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
    let shAdj := CategoryTheory.sheafificationAdjunction Z.smallEtaleTopology AddCommGrpCat.{u}
    let g_m : Aℤ ⟶ F.obj.obj (Opposite.op (weilAffColim0TermEtale Z)) :=
      AddCommGrpCat.ofHom
        { toFun := fun z => z.down • m
