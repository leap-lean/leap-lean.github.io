      let fst : P ⟶ W.left := CategoryTheory.Limits.pullback.fst W.hom (j δ)
      let snd : P ⟶ AlgebraicGeometry.Spec (CommRingCat.of (S_ch δ)) :=
        CategoryTheory.Limits.pullback.snd W.hom (j δ)
      obtain ⟨p, hp_fst, _⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback w y hy.symm
      obtain ⟨V, hV, hpV, -⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := p) (U := ⊤) trivial
      let B_cat : CommRingCat.{u} := P.presheaf.obj (Opposite.op V)
      let B : Type u := ↑B_cat
      let ι_V : AlgebraicGeometry.Spec B_cat ⟶ P := hV.fromSpec
      have : AlgebraicGeometry.IsOpenImmersion ι_V := hV.isOpenImmersion_fromSpec
      have hp_range : p ∈ Set.range ι_V.base := by
        rw [hV.range_fromSpec]
        exact hpV
      obtain ⟨q₀, hq₀⟩ := hp_range
      let π_B : AlgebraicGeometry.Spec B_cat ⟶
          AlgebraicGeometry.Spec (CommRingCat.of (S_ch δ)) := ι_V ≫ snd
      have hEt_πB : AlgebraicGeometry.Etale π_B := inferInstance
      let φ_B : S_ch δ →+* B := (AlgebraicGeometry.Spec.preimage π_B).hom
      have hSpec_φB : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_B) = π_B :=
        AlgebraicGeometry.Spec.map_preimage π_B
      let algB : Algebra (S_ch δ) B := φ_B.toAlgebra
      have hEt_B : @Algebra.Etale (S_ch δ) B _ _ algB := by
        refine @RingHom.etale_algebraMap (S_ch δ) B _ _ algB |>.mp ?_
        refine (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp ?_
        change AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_B))
        rw [hSpec_φB]
