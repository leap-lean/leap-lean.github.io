                Nonempty (CategoryTheory.Limits.IsColimit cE) →
                JointSurj (K p) s 𝒥 E cE ∧ LocalVanish (K p) s 𝒥 E cE := by
            intro s
            induction s with
            | zero =>
              intro _ p 𝒥 _ _ E cE hcE
              obtain ⟨f_p, g_p, hfg_p, e_p, he_p, hSE_p⟩ := hSyz p
              have hCech_p := ih 0 (Nat.zero_le q) (weilEtaleCechObj w p) (hAffCech p) 𝒥 E cE hcE
              have hCech_p1 :=
