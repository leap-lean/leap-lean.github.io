import WeilPart15
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem weil_pbc_finite_morphism (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    {X S : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ S) [AlgebraicGeometry.IsFinite f] :
    WeilCanonicalModPrimePBC ℓ f :=
by
  
  
  have h_higher_vanish : ∀ {Y' T' : AlgebraicGeometry.Scheme.{u}} (h' : Y' ⟶ T'),
      WeilEtalePushforwardPreservesEpi h' →
      ∀ (G : CategoryTheory.Sheaf Y'.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ),
        1 ≤ q → CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage h' q G) := by
    intro Y' T' h' hEpi G q hq
    let _ : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h' :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    let _ : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
        (@AlgebraicGeometry.Etale) h' :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B_h' : CategoryTheory.Functor T'.Etale Y'.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h'
    rcases hEpi with ⟨hc, h_epi⟩
    let J_T' := T'.smallEtaleTopology
    let J_Y' := Y'.smallEtaleTopology
    let _ : CategoryTheory.Abelian (CategoryTheory.Sheaf J_Y' AddCommGrpCat.{u}) := inferInstance
    let _ : CategoryTheory.HasExt.{u} (CategoryTheory.Sheaf J_Y' AddCommGrpCat.{u}) := inferInstance
    let _ : CategoryTheory.EnoughInjectives (CategoryTheory.Sheaf J_Y' AddCommGrpCat.{u}) :=
      inferInstance
    let pf_h' := B_h'.sheafPushforwardContinuous AddCommGrpCat.{u} J_T' J_Y'
    let L_T' := CategoryTheory.presheafToSheaf J_T' AddCommGrpCat.{u}
    let R_T' := CategoryTheory.sheafToPresheaf J_T' AddCommGrpCat.{u}
    let adj_T' := CategoryTheory.sheafificationAdjunction J_T' AddCommGrpCat.{u}
    let L_Y' := CategoryTheory.presheafToSheaf J_Y' AddCommGrpCat.{u}
    let freeF : CategoryTheory.Functor (CategoryTheory.Functor (Opposite Y'.Etale) (Type u))
        (CategoryTheory.Functor (Opposite Y'.Etale) AddCommGrpCat.{u}) :=
      (CategoryTheory.Functor.whiskeringRight (Opposite Y'.Etale) (Type u) AddCommGrpCat.{u}).obj
        AddCommGrpCat.free
    let Z_fun : CategoryTheory.Functor Y'.Etale (CategoryTheory.Sheaf J_Y' AddCommGrpCat.{u}) :=
      CategoryTheory.yoneda.comp (freeF.comp L_Y')
    let adj_free := (AddCommGrpCat.adj.whiskerRight (Opposite Y'.Etale)).comp
      (CategoryTheory.sheafificationAdjunction J_Y' AddCommGrpCat.{u})
    suffices h_ind : ∀ (r : ℕ) (H : CategoryTheory.Sheaf J_Y' AddCommGrpCat.{u}),
        CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage h' (r + 1) H) by
      have hq_eq : (q - 1) + 1 = q := Nat.sub_add_cancel hq
      rw [← hq_eq]
      exact h_ind (q - 1) G
    intro r
    induction r with
    | zero =>
      intro H
      let J_inj : CategoryTheory.Sheaf J_Y' AddCommGrpCat.{u} := CategoryTheory.Injective.under H
      let ι : H ⟶ J_inj := CategoryTheory.Injective.ι H
      let H₁ : CategoryTheory.Sheaf J_Y' AddCommGrpCat.{u} := CategoryTheory.Limits.cokernel ι
      let π : J_inj ⟶ H₁ := CategoryTheory.Limits.cokernel.π ι
      let S_H : CategoryTheory.ShortComplex (CategoryTheory.Sheaf J_Y' AddCommGrpCat.{u}) :=
        CategoryTheory.ShortComplex.mk ι π (CategoryTheory.Limits.cokernel.condition ι)
      have hExact : S_H.Exact :=
        CategoryTheory.ShortComplex.exact_of_g_is_cokernel S_H
          (CategoryTheory.Limits.cokernelIsCokernel ι)
      have hMono : CategoryTheory.Mono S_H.f := by dsimp [S_H, ι]; infer_instance
      have hEpi_π : CategoryTheory.Epi S_H.g := by dsimp [S_H, π]; infer_instance
      have hSE : S_H.ShortExact := CategoryTheory.ShortComplex.ShortExact.mk' hExact hMono hEpi_π
      have h_ev : ∀ (M : CategoryTheory.Sheaf J_Y' AddCommGrpCat.{u}) (V : Y'.Etale),
          ∃ e : CategoryTheory.Abelian.Ext (Z_fun.obj V) M 0 ≃+ ↥(M.obj.obj (Opposite.op V)),
            ∀ g_hom : Z_fun.obj V ⟶ M,
              e (CategoryTheory.Abelian.Ext.mk₀ g_hom) =
                CategoryTheory.yonedaEquiv
                  ((adj_free.homEquiv (CategoryTheory.yoneda.obj V) M) g_hom) := by
        intro M V
        let η_V : ↥((Z_fun.obj V).obj.obj (Opposite.op V)) :=
          CategoryTheory.yonedaEquiv (adj_free.unit.app (CategoryTheory.yoneda.obj V))
        have h_eq : ∀ g_hom : Z_fun.obj V ⟶ M,
            CategoryTheory.yonedaEquiv ((adj_free.homEquiv (CategoryTheory.yoneda.obj V) M) g_hom) =
              (g_hom.hom.app (Opposite.op V)) η_V := by
          intro g_hom
          rw [CategoryTheory.Adjunction.homEquiv_unit]
          rfl
        let eqv : CategoryTheory.Abelian.Ext (Z_fun.obj V) M 0 ≃ ↥(M.obj.obj (Opposite.op V)) :=
          CategoryTheory.Abelian.Ext.homEquiv₀.trans
            ((adj_free.homEquiv (CategoryTheory.yoneda.obj V) M).trans CategoryTheory.yonedaEquiv)
        have hmk : ∀ g_hom : Z_fun.obj V ⟶ M, eqv (CategoryTheory.Abelian.Ext.mk₀ g_hom) =
            (g_hom.hom.app (Opposite.op V)) η_V := by
          intro g_hom
          dsimp [eqv]
          rw [← CategoryTheory.Abelian.Ext.homEquiv₀_symm_apply, Equiv.apply_symm_apply, h_eq]
        refine ⟨AddEquiv.mk' eqv ?_, fun g_hom => ?_⟩
        · intro x y
          let fx : Z_fun.obj V ⟶ M := CategoryTheory.Abelian.Ext.homEquiv₀ x
          let fy : Z_fun.obj V ⟶ M := CategoryTheory.Abelian.Ext.homEquiv₀ y
          have hx : x = CategoryTheory.Abelian.Ext.mk₀ fx := by
            dsimp [fx]
            rw [← CategoryTheory.Abelian.Ext.homEquiv₀_symm_apply, Equiv.symm_apply_apply]
          have hy : y = CategoryTheory.Abelian.Ext.mk₀ fy := by
            dsimp [fy]
            rw [← CategoryTheory.Abelian.Ext.homEquiv₀_symm_apply, Equiv.symm_apply_apply]
          rw [hx, hy, ← CategoryTheory.Abelian.Ext.mk₀_add, hmk, hmk, hmk]
          rfl
        · change eqv (CategoryTheory.Abelian.Ext.mk₀ g_hom) = _
          dsimp [eqv]
          rw [← CategoryTheory.Abelian.Ext.homEquiv₀_symm_apply, Equiv.apply_symm_apply]
      let α₀ : ∀ (M : CategoryTheory.Sheaf J_Y' AddCommGrpCat.{u}),
          (pf_h'.obj M).obj ⟶ CategoryTheory.Functor.comp B_h'.op (M.cohomologyPresheaf 0) :=
        fun M =>
          { app := fun U' =>
              AddCommGrpCat.ofHom
                (h_ev M (B_h'.obj U'.unop)).choose.symm.toAddMonoidHom
            naturality := fun {U₁' U₂'} u => by
              rcases U₁' with ⟨U₁⟩
              rcases U₂' with ⟨U₂⟩
              rcases u with ⟨u₀⟩
              ext s
              let V₁ := B_h'.obj U₁
              let V₂ := B_h'.obj U₂
              let s₀ : ↥(M.obj.obj (Opposite.op V₁)) := s
              let e₁ := (h_ev M V₁).choose
              let e₂ := (h_ev M V₂).choose
              have he₁ := (h_ev M V₁).choose_spec
              have he₂ := (h_ev M V₂).choose_spec
              apply e₂.injective
              change e₂ (e₂.symm ((M.obj.map (Opposite.op (B_h'.map u₀))) s₀)) =
                e₂ ((CategoryTheory.Abelian.Ext.mk₀ (Z_fun.map (B_h'.map u₀))).comp
                  (e₁.symm s₀) (Nat.zero_add 0))
              rw [e₂.apply_symm_apply]
              let g_hom : Z_fun.obj V₁ ⟶ M := CategoryTheory.Abelian.Ext.homEquiv₀ (e₁.symm s₀)
              have hg_hom : CategoryTheory.Abelian.Ext.mk₀ g_hom = e₁.symm s₀ := by
                dsimp [g_hom]
                rw [← CategoryTheory.Abelian.Ext.homEquiv₀_symm_apply, Equiv.symm_apply_apply]
              have hs : s₀ = e₁ (CategoryTheory.Abelian.Ext.mk₀ g_hom) := by
                rw [hg_hom, e₁.apply_symm_apply]
              rw [← hg_hom, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, he₂, hs, he₁]
              change _ = CategoryTheory.yonedaEquiv
                  ((adj_free.homEquiv (CategoryTheory.yoneda.obj V₂) M)
                    ((freeF.comp L_Y').map (CategoryTheory.yoneda.map (B_h'.map u₀)) ≫ g_hom))
              rw [CategoryTheory.Adjunction.homEquiv_naturality_left,
                ← CategoryTheory.yonedaEquiv_naturality]
              rfl }
      let δ₀ : CategoryTheory.Functor.comp B_h'.op (H₁.cohomologyPresheaf 0) ⟶
          CategoryTheory.Functor.comp B_h'.op (H.cohomologyPresheaf 1) :=
        { app := fun U' =>
            AddCommGrpCat.ofHom
              (hSE.extClass.postcomp (Z_fun.obj (B_h'.obj U'.unop)) (Nat.zero_add 1))
          naturality := fun {U₁' U₂'} u => by
            ext x
            exact CategoryTheory.Abelian.Ext.comp_assoc
              (CategoryTheory.Abelian.Ext.mk₀ (Z_fun.map (B_h'.map u.unop)))
              x hSE.extClass (Nat.zero_add 0) (Nat.zero_add 1) (Nat.zero_add 1) }
      let δ_bar : (pf_h'.obj H₁).obj ⟶
          CategoryTheory.Functor.comp B_h'.op (H.cohomologyPresheaf 1) :=
        α₀ H₁ ≫ δ₀
      have h_comp_zero : (R_T'.map (pf_h'.map π)) ≫ δ_bar = 0 := by
        ext U' s
        rcases U' with ⟨U₀⟩
        let V := B_h'.obj U₀
        let s₀ : ↥(J_inj.obj.obj (Opposite.op V)) := s
        let eJ := (h_ev J_inj V).choose
        let e₁ := (h_ev H₁ V).choose
        have heJ := (h_ev J_inj V).choose_spec
        have he₁ := (h_ev H₁ V).choose_spec
        let g_hom : Z_fun.obj V ⟶ J_inj := CategoryTheory.Abelian.Ext.homEquiv₀ (eJ.symm s₀)
        have hg_hom : CategoryTheory.Abelian.Ext.mk₀ g_hom = eJ.symm s₀ := by
          dsimp [g_hom]
          rw [← CategoryTheory.Abelian.Ext.homEquiv₀_symm_apply, Equiv.symm_apply_apply]
        have h_nat_π : e₁.symm ((π.hom.app (Opposite.op V)) s₀) =
            (CategoryTheory.Abelian.Ext.mk₀ g_hom).comp
              (CategoryTheory.Abelian.Ext.mk₀ π) (Nat.zero_add 0) := by
          apply e₁.injective
          rw [e₁.apply_symm_apply, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, he₁]
          have hs : s₀ = eJ (CategoryTheory.Abelian.Ext.mk₀ g_hom) := by
            rw [hg_hom, eJ.apply_symm_apply]
          rw [hs, heJ, CategoryTheory.Adjunction.homEquiv_naturality_right]
          rfl
        change ((e₁.symm ((π.hom.app (Opposite.op V)) s₀)).comp hSE.extClass (Nat.zero_add 1)) = 0
        rw [h_nat_π, CategoryTheory.Abelian.Ext.comp_assoc _ _ _
          (Nat.zero_add 0) (Nat.zero_add 1) (Nat.zero_add 1)]
        have h_zero : (CategoryTheory.Abelian.Ext.mk₀ π).comp hSE.extClass (Nat.zero_add 1) = 0 :=
          hSE.comp_extClass
        rw [h_zero, CategoryTheory.Abelian.Ext.comp_zero]
      have h_surj : ∀ U' : Opposite T'.Etale, Function.Surjective (δ_bar.app U') := by
        intro U' y
        let V := B_h'.obj U'.unop
        have hSub1 : Subsingleton (CategoryTheory.Abelian.Ext (Z_fun.obj V) J_inj 1) :=
          CategoryTheory.Abelian.Ext.subsingleton_of_injective (Z_fun.obj V) J_inj 0
        have hy0 : y.comp (CategoryTheory.Abelian.Ext.mk₀ S_H.f) (Nat.add_zero 1) = 0 :=
          @Subsingleton.elim _ hSub1 _ _
        obtain ⟨x, hx⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁
          (Z_fun.obj V) hSE y hy0 (Nat.zero_add 1)
        refine ⟨(h_ev H₁ V).choose x, ?_⟩
        change ((h_ev H₁ V).choose.symm ((h_ev H₁ V).choose x)).comp hSE.extClass
          (Nat.zero_add 1) = y
        rw [(h_ev H₁ V).choose.symm_apply_apply, hx]
      let P₁ := CategoryTheory.Functor.comp B_h'.op (H.cohomologyPresheaf 1)
      let K : CategoryTheory.Sheaf J_T' AddCommGrpCat.{u} := L_T'.obj P₁
      change CategoryTheory.Limits.IsZero K
      rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
      apply (adj_T'.homEquiv P₁ K).injective
      have h_zero_adj : (adj_T'.homEquiv P₁ K) 0 = 0 := by
        rw [CategoryTheory.Adjunction.homEquiv_unit, R_T'.map_zero, CategoryTheory.Limits.comp_zero]
      rw [h_zero_adj]
      have h_adj_zero : δ_bar ≫ (adj_T'.homEquiv P₁ K) (CategoryTheory.CategoryStruct.id K) = 0 := by
        let ψ : pf_h'.obj H₁ ⟶ K :=
          R_T'.preimage (δ_bar ≫ (adj_T'.homEquiv P₁ K) (CategoryTheory.CategoryStruct.id K))
        have hψ_val : R_T'.map ψ =
            δ_bar ≫ (adj_T'.homEquiv P₁ K) (CategoryTheory.CategoryStruct.id K) :=
          R_T'.map_preimage _
        have _ : CategoryTheory.Epi (pf_h'.map π) := h_epi J_inj H₁ π
        have h_epi_cancel : pf_h'.map π ≫ ψ = 0 := by
          apply R_T'.map_injective
          rw [R_T'.map_comp, hψ_val, ← CategoryTheory.Category.assoc, h_comp_zero,
            CategoryTheory.Limits.zero_comp, R_T'.map_zero]
        have hψ0 : ψ = 0 := (CategoryTheory.cancel_epi (pf_h'.map π)).mp
          (by rw [h_epi_cancel, CategoryTheory.Limits.comp_zero])
        rw [← hψ_val, hψ0, R_T'.map_zero]
      ext U' y
      obtain ⟨s, rfl⟩ := h_surj U' y
      exact congrArg (fun φ => (φ.app U') s) h_adj_zero
    | succ k ih =>
      intro H
      let J_inj : CategoryTheory.Sheaf J_Y' AddCommGrpCat.{u} := CategoryTheory.Injective.under H
      let ι : H ⟶ J_inj := CategoryTheory.Injective.ι H
      let H₁ : CategoryTheory.Sheaf J_Y' AddCommGrpCat.{u} := CategoryTheory.Limits.cokernel ι
      let π : J_inj ⟶ H₁ := CategoryTheory.Limits.cokernel.π ι
      let S_H : CategoryTheory.ShortComplex (CategoryTheory.Sheaf J_Y' AddCommGrpCat.{u}) :=
        CategoryTheory.ShortComplex.mk ι π (CategoryTheory.Limits.cokernel.condition ι)
      have hExact : S_H.Exact :=
        CategoryTheory.ShortComplex.exact_of_g_is_cokernel S_H
          (CategoryTheory.Limits.cokernelIsCokernel ι)
      have hMono : CategoryTheory.Mono S_H.f := by dsimp [S_H, ι]; infer_instance
      have hEpi_π : CategoryTheory.Epi S_H.g := by dsimp [S_H, π]; infer_instance
      have hSE : S_H.ShortExact := CategoryTheory.ShortComplex.ShortExact.mk' hExact hMono hEpi_π
      let δ : CategoryTheory.Functor.comp B_h'.op (H₁.cohomologyPresheaf (k + 1)) ⟶
          CategoryTheory.Functor.comp B_h'.op (H.cohomologyPresheaf (k + 2)) :=
        { app := fun U' =>
            AddCommGrpCat.ofHom
              (hSE.extClass.postcomp (Z_fun.obj (B_h'.obj U'.unop)) rfl)
          naturality := fun {U₁' U₂'} u => by
            ext x
            exact CategoryTheory.Abelian.Ext.comp_assoc
              (CategoryTheory.Abelian.Ext.mk₀ (Z_fun.map (B_h'.map u.unop)))
              x hSE.extClass (Nat.zero_add (k + 1)) rfl (Nat.zero_add (k + 2)) }
      have h_iso_app : ∀ U' : Opposite T'.Etale, CategoryTheory.IsIso (δ.app U') := by
        intro U'
        let V := B_h'.obj U'.unop
        have hSub1 : Subsingleton (CategoryTheory.Abelian.Ext (Z_fun.obj V) J_inj (k + 1)) :=
          CategoryTheory.Abelian.Ext.subsingleton_of_injective (Z_fun.obj V) J_inj k
        have hSub2 : Subsingleton (CategoryTheory.Abelian.Ext (Z_fun.obj V) J_inj (k + 2)) :=
          CategoryTheory.Abelian.Ext.subsingleton_of_injective (Z_fun.obj V) J_inj (k + 1)
        let φ_post := hSE.extClass.postcomp (Z_fun.obj V) (rfl : (k + 1) + 1 = k + 2)
        have h_bij : Function.Bijective φ_post := by
          constructor
          · intro x₁ x₂ h_eq
            have h_sub : (x₁ - x₂).comp hSE.extClass (rfl : (k + 1) + 1 = k + 2) = 0 := by
              change φ_post (x₁ - x₂) = 0
              rw [map_sub]
              exact sub_eq_zero.mpr h_eq
            obtain ⟨w, hw⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₃
              (Z_fun.obj V) hSE (x₁ - x₂) (rfl : (k + 1) + 1 = k + 2) h_sub
            have hw0 : w = 0 := @Subsingleton.elim _ hSub1 _ _
            subst hw0
            have h0c := CategoryTheory.Abelian.Ext.zero_comp (Z_fun.obj V) (k + 1)
              (CategoryTheory.Abelian.Ext.mk₀ S_H.g) (k + 1) (Nat.add_zero (k + 1))
            exact sub_eq_zero.mp (hw.symm.trans h0c)
          · intro y
            have hy0 : y.comp (CategoryTheory.Abelian.Ext.mk₀ S_H.f) (Nat.add_zero (k + 2)) = 0 :=
              @Subsingleton.elim _ hSub2 _ _
            obtain ⟨x, hx⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁
              (Z_fun.obj V) hSE y hy0 (rfl : (k + 1) + 1 = k + 2)
            exact ⟨x, hx⟩
        exact (CategoryTheory.ConcreteCategory.isIso_iff_bijective (δ.app U')).mpr h_bij
      have _ : CategoryTheory.IsIso δ := CategoryTheory.NatIso.isIso_of_isIso_app δ
      let iso_sheaf : weilEtaleHigherDirectImage h' (k + 1) H₁ ≅
          weilEtaleHigherDirectImage h' (k + 2) H :=
        L_T'.mapIso (CategoryTheory.asIso δ)
      exact (ih H₁).of_iso iso_sheaf.symm
  
  obtain ⟨hArt, hDesc⟩ := weil_finite_alg_pointed_etale_decomposition_and_descent.{u}
  obtain ⟨hArtEpi, hAffGeom⟩ := weil_etale_affine_geom_point_pbc_of_alg_descent hArt hDesc
  intro S' X' g f' g' hpb
  obtain ⟨hEpi_f', hPBC0⟩ :=
    weil_etale_pbc_reduction_to_affine_geom_point hArtEpi hAffGeom f g f' g' hpb
  rcases hPBC0 with ⟨hc_f, hc_g, hc_f', hc_g', hra_g, hra_g', hIso0⟩
  refine ⟨hc_f, hc_g, hc_f', hc_g', hra_g, hra_g', ?_, ?_⟩
  · intro F _
    exact hIso0 F
  · intro I _ q hq
    exact h_higher_vanish f' hEpi_f' _ q hq

theorem weil_projSpace_zero_isIso_and_vandermonde_cover (k : Type u) [Field k] :
    CategoryTheory.IsIso (weilProjectiveSpaceOver k 0).hom ∧
    ∀ (n M : ℕ) (a : Fin M → k), Function.Injective a →
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) k) :=
        MvPolynomial.gradedAlgebra
      (∀ s : Fin M,
        (∑ i : Fin (n + 1),
          (MvPolynomial.C (a s ^ (i : ℕ)) : MvPolynomial (Fin (n + 1)) k) *
            (MvPolynomial.X i : MvPolynomial (Fin (n + 1)) k)) ∈
          MvPolynomial.homogeneousSubmodule (Fin (n + 1)) k 1) ∧
      (∀ (y : ↥(weilProjectiveSpaceOver k n).left) (S : Finset (Fin M)),
        (∀ s ∈ S,
          y ∉ AlgebraicGeometry.Proj.basicOpen
            (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) k)
            (∑ i : Fin (n + 1),
              (MvPolynomial.C (a s ^ (i : ℕ)) : MvPolynomial (Fin (n + 1)) k) *
                (MvPolynomial.X i : MvPolynomial (Fin (n + 1)) k))) →
        S.card ≤ n) :=
by
  have hCover : ∀ (n : ℕ) (y : ↥(weilProjectiveSpaceOver k n).left),
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) k) :=
        MvPolynomial.gradedAlgebra
      ∃ i : Fin (n + 1),
        y ∈ AlgebraicGeometry.Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) k)
          (MvPolynomial.X i) := by
    intro n y
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (n + 1)) k
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have _ : IsScalarTower k ↥(𝒜 0) (MvPolynomial (Fin (n + 1)) k) :=
      @IsScalarTower.of_algebraMap_eq k ↥(𝒜 0) (MvPolynomial (Fin (n + 1)) k) _ _ _ _ _ _
        (fun _ => rfl)
    have h_hom : ∀ i : Fin (n + 1), ∃ m, (MvPolynomial.X i : MvPolynomial (Fin (n + 1)) k) ∈ 𝒜 m :=
      fun i => ⟨1, (MvPolynomial.mem_homogeneousSubmodule 1 (MvPolynomial.X i)).mpr
        (MvPolynomial.isHomogeneous_X k i)⟩
    have h_adj : Algebra.adjoin ↥(𝒜 0)
        (Set.range (MvPolynomial.X : Fin (n + 1) → MvPolynomial (Fin (n + 1)) k)) = ⊤ := by
      rw [eq_top_iff]
      intro p _
      have hp : p ∈ Algebra.adjoin k
          (Set.range (MvPolynomial.X : Fin (n + 1) → MvPolynomial (Fin (n + 1)) k)) := by
        rw [MvPolynomial.adjoin_range_X]
        trivial
      let B : Subalgebra k (MvPolynomial (Fin (n + 1)) k) :=
        (Algebra.adjoin ↥(𝒜 0)
          (Set.range (MvPolynomial.X : Fin (n + 1) → MvPolynomial (Fin (n + 1)) k))).restrictScalars k
      have hle : Algebra.adjoin k
          (Set.range (MvPolynomial.X : Fin (n + 1) → MvPolynomial (Fin (n + 1)) k)) ≤ B :=
        Algebra.adjoin_le Algebra.subset_adjoin
      exact hle hp
    have h_top : (⨆ i : Fin (n + 1), AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X i)) = ⊤ :=
