         ∃ (ι : B →ₐ[D₀'] L'),
          Function.Injective ι ∧ (↑S : Set L') ⊆ Set.range ι) := by
    intro D₀' L' _ _ _ _ _ _ _ _ S
    let K : Type u := FractionRing D₀'
    obtain ⟨α, hα_top⟩ := Field.exists_primitive_element K L'
    have hα_int : IsIntegral K α := Algebra.IsIntegral.isIntegral α
    let H : Polynomial K := minpoly K α
    let d : ℕ := H.natDegree
    have hH_monic : H.Monic := minpoly.monic hα_int
    have hH_sep : H.Separable := Algebra.IsSeparable.isSeparable K α
    obtain ⟨P₀, Q₀, hBez₀⟩ : IsCoprime H H.derivative := hH_sep
    have h_aeval_top : (Polynomial.aeval α : Polynomial K →ₐ[K] L').range = ⊤ := by
