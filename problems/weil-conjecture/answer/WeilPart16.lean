        dsimp [P]
        refine (Polynomial.natDegree_sum_le Finset.univ _).trans ?_
        rw [Finset.fold_max_le]
        refine ⟨Nat.zero_le n, fun i _ => ?_⟩
        exact (Polynomial.natDegree_C_mul_X_pow_le (x i) (i : ℕ)).trans (Nat.lt_succ_iff.mp i.isLt)
