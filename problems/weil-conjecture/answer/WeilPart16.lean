theorem weil_pbc_projLine_strict_local_stalk_reduction (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (B : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.LocallyOfFiniteType B.hom]
    [AlgebraicGeometry.IsAffine B.left]
    (hSpec : ∀ (A : Type u) [CommRing A] [Algebra k A] (τ_A : A →ₐ[k] k),
