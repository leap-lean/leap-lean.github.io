      rw [← h_left z₁, ← h_left z₂, hz]
    exact ⟨AlgEquiv.ofBijective Φ_B ⟨hΦ_inj, hΦ_surj⟩⟩
  have h_s2 : ∀ (D₀' L' : Type u) [CommRing D₀'] [IsDomain D₀'] [Field L']
      [Algebra D₀' L'] [Algebra (FractionRing D₀') L']
      [IsScalarTower D₀' (FractionRing D₀') L']
      [FiniteDimensional (FractionRing D₀') L']
      [Algebra.IsSeparable (FractionRing D₀') L']
      (S : Finset L'),
      ∃ (f : D₀') (_ : f ≠ 0)
        (B : Type u) (_ : CommRing B) (_ : IsDomain B)
        (_ : Algebra (Localization.Away f) B),
        Module.Finite (Localization.Away f) B ∧
        Algebra.Etale (Localization.Away f) B ∧
        Function.Injective (algebraMap (Localization.Away f) B) ∧
        (letI : Algebra D₀' B :=
          RingHom.toAlgebra ((algebraMap (Localization.Away f) B).comp
