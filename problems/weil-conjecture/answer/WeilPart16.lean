    intro Z₀ h_Z r _hr U n f_gen U₀ hU₀_le N hN
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    let P_sch : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Proj 𝒜
    let P_hom : P_sch ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
      AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))
    change ∃ (Φ : (U₀ : AlgebraicGeometry.Scheme.{u}) ⟶ P_sch)
      (D : Fin (N + 1) → P_sch.Opens)
      (z : ∀ (β γ : Fin (N + 1)), ↑(P_sch.presheaf.obj (Opposite.op (D γ))))
      (IsZeroAt : Fin r → Fin (N + 1) → Prop),
      (Φ ≫ P_hom = U₀.ι ≫ h_Z) ∧
      (⨆ γ : Fin (N + 1), D γ = ⊤) ∧
