      have hR : (adj_π.homEquiv X W)
          (weilEtalePullMateHom.{u} π f₂₃ f₁ hπ₂₃ X ≫ pb_f₁.map α_23) =
          adj_f₃.unit.app X ≫ pf_f₃.map (adj_f₂.unit.app (pb_f₃.obj X)) ≫
            pf_f₃.map (pf_f₂.map (adj_f₁.unit.app (pb_f₂.obj (pb_f₃.obj X)))) ≫
