    have hT_bwd : ∀ j : Fin N,
        Φ.symm (Pi.single j (1 : L')) = ∑ q ∈ T_bwd j, q.1 ⊗ₜ[D₀'] q.2 :=
      fun j => (h_finset j).choose_spec
    let S_bwd : Finset L' :=
      (Finset.univ : Finset (Fin N)).biUnion (fun j => (T_bwd j).image Prod.fst)
    refine ⟨S_fwd ∪ S_bwd, ?_⟩
    intro B _ _ ι hι_inj hS_sub
    let ι_E : TensorProduct D₀' B E' →ₐ[D₀'] TensorProduct D₀' L' E' :=
      Algebra.TensorProduct.map ι (AlgHom.id D₀' E')
    have hιE_lin : ι_E.toLinearMap = LinearMap.rTensor E' ι.toLinearMap :=
      TensorProduct.ext' (fun _ _ => rfl)
    have hιE_inj : Function.Injective ι_E := by
      change Function.Injective ι_E.toLinearMap
      rw [hιE_lin]
      exact Module.Flat.rTensor_preserves_injective_linearMap ι.toLinearMap hι_inj
    have h_mem_e : ∀ (e : E') (j : Fin N), Φ (1 ⊗ₜ[D₀'] e) j ∈ ι.range := by
      intro e
      have he_mem : e ∈ Algebra.adjoin D₀' (↑G : Set E') := by
        rw [hG]; trivial
      refine Algebra.adjoin_induction
        (p := fun x _ => ∀ j : Fin N, Φ (1 ⊗ₜ[D₀'] x) j ∈ ι.range)
        (fun x hx j => ?_)
        (fun r j => ?_)
        (fun x y _ _ hx hy j => ?_)
        (fun x y _ _ hx hy j => ?_)
        he_mem
      · have hmem_fwd : Φ (1 ⊗ₜ[D₀'] x) j ∈ S_fwd :=
          Finset.mem_image.mpr ⟨(x, j), Finset.mem_product.mpr ⟨hx, Finset.mem_univ j⟩, rfl⟩
        exact hS_sub (Finset.mem_coe.mpr (Finset.mem_union_left S_bwd hmem_fwd))
      · have h_tmul : (1 : L') ⊗ₜ[D₀'] algebraMap D₀' E' r =
