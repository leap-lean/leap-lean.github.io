      _ = pb_f₁.map β₄ ≫ (𝟙 _ ≫ pb_f₁.map α₄) ≫ (β₂ ≫ β₁) := by rw [Category.id_comp, Category.assoc]
      _ = pb_f₁.map β₄ ≫ ((β₃ ≫ α₃) ≫ pb_f₁.map α₄) ≫ (β₂ ≫ β₁) := by rw [h3.2]
      _ = pb_f₁.map β₄ ≫ β₃ ≫ (α₃ ≫ pb_f₁.map α₄) ≫ β₂ ≫ β₁ := by simp only [Category.assoc]
      _ = pb_f₁.map β₄ ≫ β₃ ≫ (α₁ ≫ α₂) ≫ β₂ ≫ β₁ := by rw [hAlphaPent]
      _ = pb_f₁.map β₄ ≫ β₃ ≫ α₁ ≫ (α₂ ≫ β₂) ≫ β₁ := by simp only [Category.assoc]
