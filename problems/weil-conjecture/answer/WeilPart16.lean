              (AlgebraicGeometry.Spec.map (D.map (CategoryTheory.CategoryStruct.comp θ θ'))) :=
            hvX_f _
        _ = CategoryTheory.CategoryStruct.comp
              (CategoryTheory.CategoryStruct.comp (f_lvl l)
                (AlgebraicGeometry.Spec.map (D.map θ')))
              (AlgebraicGeometry.Spec.map (D.map θ)) := by
            rw [D.map_comp, AlgebraicGeometry.Spec.map_comp, ← CategoryTheory.Category.assoc]
        _ = CategoryTheory.CategoryStruct.comp
              (CategoryTheory.CategoryStruct.comp (vX θ') (vX θ)) (f_lvl i) := by
            rw [← hvX_f θ', CategoryTheory.Category.assoc, ← hvX_f θ,
