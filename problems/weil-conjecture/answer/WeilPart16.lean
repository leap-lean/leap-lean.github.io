        intro hP0
        apply hx₀
        have hcoeff : P.coeff (i₀ : ℕ) = x i₀ := by
          dsimp [P]
          rw [Polynomial.finsetSum_coeff]
          have h_eq : ∀ i : Fin (n + 1),
              (Polynomial.C (x i) * Polynomial.X ^ (i : ℕ)).coeff (i₀ : ℕ) =
