  have hExtCompNat :
      ∀ {C₁ : Type (u + 1)} [CategoryTheory.Category.{u + 1} C₁] [CategoryTheory.Abelian C₁]
        [CategoryTheory.HasExt.{u} C₁] [CategoryTheory.EnoughInjectives C₁]
        {C₂ : Type (u + 1)} [CategoryTheory.Category.{u + 1} C₂] [CategoryTheory.Abelian C₂]
        [CategoryTheory.HasExt.{u} C₂]
        {C₃ : Type (u + 1)} [CategoryTheory.Category.{u + 1} C₃] [CategoryTheory.Abelian C₃]
        [CategoryTheory.HasExt.{u} C₃]
        (F₁ : CategoryTheory.Functor C₁ C₂) [F₁.Additive]
        [CategoryTheory.Limits.PreservesFiniteLimits F₁]
        [CategoryTheory.Limits.PreservesFiniteColimits F₁]
        (F₂ : CategoryTheory.Functor C₂ C₃) [F₂.Additive]
        [CategoryTheory.Limits.PreservesFiniteLimits F₂]
        [CategoryTheory.Limits.PreservesFiniteColimits F₂]
        (G : CategoryTheory.Functor C₁ C₃) [G.Additive]
        [CategoryTheory.Limits.PreservesFiniteLimits G]
        [CategoryTheory.Limits.PreservesFiniteColimits G]
        (τ : Quiver.Hom (CategoryTheory.Functor.comp F₁ F₂) G)
        (q : ℕ) {X Y : C₁} (e : CategoryTheory.Abelian.Ext X Y q),
        (CategoryTheory.Abelian.Ext.mapExactFunctor F₂
          (CategoryTheory.Abelian.Ext.mapExactFunctor F₁ e)).comp
            (CategoryTheory.Abelian.Ext.mk₀ (τ.app Y)) (Nat.add_zero q) =
          (CategoryTheory.Abelian.Ext.mk₀ (τ.app X)).comp
            (CategoryTheory.Abelian.Ext.mapExactFunctor G e) (Nat.zero_add q) := by
    intro C₁ _ _ _ _ C₂ _ _ _ C₃ _ _ _ F₁ _ _ _ F₂ _ _ _ G _ _ _ τ q X Y e
    induction q generalizing Y with
    | zero =>
      obtain ⟨f, rfl⟩ := (CategoryTheory.Abelian.Ext.mk₀_bijective X Y).2 e
      rw [CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
