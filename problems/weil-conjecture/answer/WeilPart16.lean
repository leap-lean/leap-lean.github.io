        CategoryTheory.Limits.pullback.fst ((weilEtaleSitePullback π₂).obj A).hom h ≫
          CategoryTheory.Limits.pullback.fst A.hom π₂ := by
    intro S₀ S₁ S₂ π₁ π₂ h h_eq A e_tri
    let i₁ : @CategoryTheory.Iso (CategoryTheory.Functor S₀.Etale S₁.Etale) _
        (weilEtaleSitePullback π₁) (weilEtaleSitePullback (h ≫ π₂)) :=
      CategoryTheory.MorphismProperty.Over.pullbackCongr h_eq.symm
    let i₂ : @CategoryTheory.Iso (CategoryTheory.Functor S₀.Etale S₁.Etale) _
        (weilEtaleSitePullback (h ≫ π₂))
        (CategoryTheory.Functor.comp (weilEtaleSitePullback π₂) (weilEtaleSitePullback h)) :=
      CategoryTheory.MorphismProperty.Over.pullbackComp h π₂
    exact (CategoryTheory.Category.assoc (i₂.inv.app A).left (i₁.inv.app A).left _).trans
      ((congrArg ((i₂.inv.app A).left ≫ ·) (hCongr_inv_fst h_eq.symm A)).trans
        (hComp_inv_fst h π₂ A))

  
  refine ⟨?_, ?_, ?_⟩
  · 
    intro Y M
    exact ⟨eH₀ M, fun _ => rfl⟩
  · 
    intro X Y f_Y K
    exact ⟨(eH₀ K).trans (eBaseSec f_Y K), fun _ => rfl⟩
  · 
    intro F₀ Z_A Z_B X_A X_B p_A p_B g hg f_AX π_A hpb_A f_BX π_B hpb_B g' hg'_f hg'_π
      x_A x_B y_A y_B h_eq_A hx_AB hy_AB
    let M₀ := (pf_of f₀).obj F₀
    let G_A := (pb_of p_A).obj M₀
    let G_B := (pb_of p_B).obj M₀
    let K_A := (pb_of π_A).obj F₀
    let K_B := (pb_of π_B).obj F₀
    let u_A : Fℤ Z_A ⟶ G_A := CategoryTheory.Abelian.Ext.addEquiv₀ x_A
    let u_B : Fℤ Z_B ⟶ G_B := CategoryTheory.Abelian.Ext.addEquiv₀ x_B
    let w_A : Fℤ X_A ⟶ K_A := CategoryTheory.Abelian.Ext.addEquiv₀ y_A
    let w_B : Fℤ X_B ⟶ K_B := CategoryTheory.Abelian.Ext.addEquiv₀ y_B

    
    have hu_A_bc : u_A ≫ bc₀ p_A f_AX π_A hpb_A F₀ = uℤ_of f_AX ≫ (pf_of f_AX).map w_A := by
      apply (sheafHomEquivSec Z_A ((pf_of f_AX).obj K_A)).injective
      rw [hBase_unit f_AX K_A y_A, h_eq_A]
      rfl

    
    rcases hx_AB with ⟨hc_g, hr_g, hAdd_g, hLim_g, hColim_g, hcℤ_g, hx_ext⟩
    have h_hc_g : hc_g = @hc_all Z_B Z_A g := Subsingleton.elim _ _
    subst h_hc_g
    have h_hr_g : hr_g = @hr_all Z_B Z_A g := Subsingleton.elim _ _
    subst h_hr_g

    rcases hy_AB with ⟨hc_g', hr_g', hAdd_g', hLim_g', hColim_g', hcℤ_g', hy_ext⟩
    have h_hc_g' : hc_g' = @hc_all X_B X_A g' := Subsingleton.elim _ _
    subst h_hc_g'
    have h_hr_g' : hr_g' = @hr_all X_B X_A g' := Subsingleton.elim _ _
    subst h_hr_g'

    let cℤ_of : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
        (pb_of h).obj (Fℤ Y₂) ⟶ Fℤ Y₁ :=
      fun {Y₁ Y₂} h => ((adj_of h).homEquiv (Fℤ Y₂) (Fℤ Y₁)).symm (uℤ_of h)

    let e_B_g : CategoryTheory.Iso (weilEtaleSitePullback p_B)
        (CategoryTheory.Functor.comp (weilEtaleSitePullback p_A) (weilEtaleSitePullback g)) :=
      CategoryTheory.Iso.trans
        (CategoryTheory.MorphismProperty.Over.pullbackCongr hg.symm)
        (CategoryTheory.MorphismProperty.Over.pullbackComp g p_A)
    letI : (CategoryTheory.Functor.comp (weilEtaleSitePullback p_A)
        (weilEtaleSitePullback g)).IsContinuous Z₀.smallEtaleTopology Z_B.smallEtaleTopology :=
      CategoryTheory.Functor.isContinuous_comp (weilEtaleSitePullback p_A) (weilEtaleSitePullback g)
        Z₀.smallEtaleTopology Z_A.smallEtaleTopology Z_B.smallEtaleTopology
    let e_pf_g := CategoryTheory.Functor.sheafPushforwardContinuousIso e_B_g
      AddCommGrpCat.{u} Z₀.smallEtaleTopology Z_B.smallEtaleTopology
    let β_g : (pb_of g).obj G_A ⟶ G_B :=
      ((adj_of g).homEquiv G_A G_B).symm
        (((adj_of p_A).homEquiv M₀ ((pf_of g).obj G_B)).symm
          ((adj_of p_B).unit.app M₀ ≫ e_pf_g.hom.app G_B))

    let e_B_g' : CategoryTheory.Iso (weilEtaleSitePullback π_B)
        (CategoryTheory.Functor.comp (weilEtaleSitePullback π_A) (weilEtaleSitePullback g')) :=
      CategoryTheory.Iso.trans
        (CategoryTheory.MorphismProperty.Over.pullbackCongr hg'_π.symm)
        (CategoryTheory.MorphismProperty.Over.pullbackComp g' π_A)
    letI : (CategoryTheory.Functor.comp (weilEtaleSitePullback π_A)
        (weilEtaleSitePullback g')).IsContinuous X₀.smallEtaleTopology X_B.smallEtaleTopology :=
      CategoryTheory.Functor.isContinuous_comp (weilEtaleSitePullback π_A) (weilEtaleSitePullback g')
        X₀.smallEtaleTopology X_A.smallEtaleTopology X_B.smallEtaleTopology
    let e_pf_g' := CategoryTheory.Functor.sheafPushforwardContinuousIso e_B_g'
      AddCommGrpCat.{u} X₀.smallEtaleTopology X_B.smallEtaleTopology
    let β_g' : (pb_of g').obj K_A ⟶ K_B :=
      ((adj_of g').homEquiv K_A K_B).symm
        (((adj_of π_A).homEquiv F₀ ((pf_of g').obj K_B)).symm
          ((adj_of π_B).unit.app F₀ ≫ e_pf_g'.hom.app K_B))

    have hu_B : u_B =
        @CategoryTheory.inv _ _ _ _ (cℤ_of g) hcℤ_g ≫ (pb_of g).map u_A ≫ β_g := by
      letI := hAdd_g; letI := hLim_g; letI := hColim_g
      exact hExt_deg0_abs (pb_of g) (@CategoryTheory.inv _ _ _ _ (cℤ_of g) hcℤ_g) β_g x_A x_B hx_ext

    have hw_B : w_B =
        @CategoryTheory.inv _ _ _ _ (cℤ_of g') hcℤ_g' ≫ (pb_of g').map w_A ≫ β_g' := by
      letI := hAdd_g'; letI := hLim_g'; letI := hColim_g'
