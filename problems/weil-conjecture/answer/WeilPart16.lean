          refine ⟨e₁ x, ?_⟩
          have h0 := congrArg e₂ hx
          change e₂ (e₂.symm (f_sec (e₁ x))) = e₂ (e₂.symm b) at h0
          rwa [e₂.apply_symm_apply, e₂.apply_symm_apply] at h0
