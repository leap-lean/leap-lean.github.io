    let β₂ := weilEtalePullMateInv.{u} f₁₂ f₂ f₁ h₁₂ (pb_f₃.obj X)
    let α₃ := weilEtalePullMateHom.{u} π f₂₃ f₁ hπ₂₃ X
    let β₃ := weilEtalePullMateInv.{u} π f₂₃ f₁ hπ₂₃ X
    let α₄ := weilEtalePullMateHom.{u} f₂₃ f₃ f₂ h₂₃ X
    let β₄ := weilEtalePullMateInv.{u} f₂₃ f₃ f₂ h₂₃ X
    have h1 := (hP₁ π f₃ f₁₂ hπ₁₂).1 X
    have h2 := (hP₁ f₁₂ f₂ f₁ h₁₂).1 (pb_f₃.obj X)
    have h3 := (hP₁ π f₂₃ f₁ hπ₂₃).1 X
    have h4 := (hP₁ f₂₃ f₃ f₂ h₂₃).1 X
    have h4_map : pb_f₁.map β₄ ≫ pb_f₁.map α₄ = 𝟙 W := by
      rw [← pb_f₁.map_comp, h4.2, pb_f₁.map_id]
