        have hBip := hBiprod (Z_sh E₀) (Z_sh E₁) (q + 1) Λ D c hc h₀.1 h₀.2 h₁.1 h₁.2
        have hJS_Fℤ : JointSurj Fℤ_Y (q + 1) Λ D c :=
          (hSE_trans (CategoryTheory.ShortComplex.mk f_mv g_mv h_mv) hSE_mv Λ D c hc).2 q
            (hAffAll q q le_rfl E₀₁ hAff₀₁ Λ D c hc).1
            (hAffAll (q + 1) (q + 1) le_rfl E₀₁ hAff₀₁ Λ D c hc).2
            hBip.1
