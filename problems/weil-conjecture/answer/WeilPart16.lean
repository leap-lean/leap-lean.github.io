        have hq_zero : q𝔭 (∑ i : Fin (n + 1),
            (MvPolynomial.C (a s ^ (i : ℕ)) : MvPolynomial (Fin (n + 1)) k) *
              MvPolynomial.X i) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr hs_not_open
        dsimp [P, σ, x]
        rw [Polynomial.eval_finsetSum, ← hq_zero, map_sum]
        refine Finset.sum_congr rfl fun i _ => ?_
        simp only [Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_pow,
          Polynomial.eval_X, map_mul, map_pow]
        ring
      calc S.card = Z.card := (Finset.card_image_of_injective S hτ_inj).symm
        _ ≤ P.natDegree := Polynomial.card_le_degree_of_subset_roots hZ_sub
        _ ≤ n := hP_deg

theorem weil_vieta_glued_morphism_and_vandermonde_charts (k : Type u) [Field k]
    (m : ℕ) (a : Fin (m + 2) → k)
    (hCov :
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) k) :=
        MvPolynomial.gradedAlgebra
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 2) k) :=
        MvPolynomial.gradedAlgebra
      ∀ z : ↥(CategoryTheory.Limits.pullback
          (weilProjectiveSpaceOver k m).hom (weilProjectiveSpaceOver k 1).hom),
        ∃ s : Fin (m + 2),
          z ∈ (TopologicalSpace.Opens.map
            (CategoryTheory.Limits.pullback.fst
              (weilProjectiveSpaceOver k m).hom (weilProjectiveSpaceOver k 1).hom).base).obj
            (AlgebraicGeometry.Proj.basicOpen
              (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) k)
              (∑ i : Fin (m + 1),
                (MvPolynomial.C (a s ^ (i : ℕ)) : MvPolynomial (Fin (m + 1)) k) *
                  (MvPolynomial.X i : MvPolynomial (Fin (m + 1)) k))) ⊓
          (TopologicalSpace.Opens.map
            (CategoryTheory.Limits.pullback.snd
              (weilProjectiveSpaceOver k m).hom (weilProjectiveSpaceOver k 1).hom).base).obj
            (AlgebraicGeometry.Proj.basicOpen
              (MvPolynomial.homogeneousSubmodule (Fin 2) k)
              (∑ r : Fin 2,
                (MvPolynomial.C (a s ^ (r : ℕ)) : MvPolynomial (Fin 2) k) *
                  (MvPolynomial.X r : MvPolynomial (Fin 2) k)))) :
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) k) :=
      MvPolynomial.gradedAlgebra
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 2) k) :=
      MvPolynomial.gradedAlgebra
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (m + 2)) k) :=
      MvPolynomial.gradedAlgebra
    ∃ (μ : CategoryTheory.Limits.pullback
        (weilProjectiveSpaceOver k m).hom (weilProjectiveSpaceOver k 1).hom ⟶
        (weilProjectiveSpaceOver k (m + 1)).left),
      (μ ≫ (weilProjectiveSpaceOver k (m + 1)).hom =
        CategoryTheory.Limits.pullback.fst
          (weilProjectiveSpaceOver k m).hom (weilProjectiveSpaceOver k 1).hom ≫
          (weilProjectiveSpaceOver k m).hom) ∧
      (∀ b : Fin (m + 2),
        (TopologicalSpace.Opens.map μ.base).obj
          (AlgebraicGeometry.Proj.basicOpen
            (MvPolynomial.homogeneousSubmodule (Fin (m + 2)) k)
            (∑ j : Fin (m + 2),
              (MvPolynomial.C (a b ^ (j : ℕ)) : MvPolynomial (Fin (m + 2)) k) *
                (MvPolynomial.X j : MvPolynomial (Fin (m + 2)) k))) =
        (TopologicalSpace.Opens.map
          (CategoryTheory.Limits.pullback.fst
            (weilProjectiveSpaceOver k m).hom (weilProjectiveSpaceOver k 1).hom).base).obj
          (AlgebraicGeometry.Proj.basicOpen
            (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) k)
            (∑ i : Fin (m + 1),
              (MvPolynomial.C (a b ^ (i : ℕ)) : MvPolynomial (Fin (m + 1)) k) *
                (MvPolynomial.X i : MvPolynomial (Fin (m + 1)) k))) ⊓
        (TopologicalSpace.Opens.map
          (CategoryTheory.Limits.pullback.snd
            (weilProjectiveSpaceOver k m).hom (weilProjectiveSpaceOver k 1).hom).base).obj
          (AlgebraicGeometry.Proj.basicOpen
            (MvPolynomial.homogeneousSubmodule (Fin 2) k)
            (∑ r : Fin 2,
              (MvPolynomial.C (a b ^ (r : ℕ)) : MvPolynomial (Fin 2) k) *
                (MvPolynomial.X r : MvPolynomial (Fin 2) k)))) ∧
      (∀ (s₀ : Fin (m + 2)) (Ω : Type u) [Field Ω]
          (ybar : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
            (weilProjectiveSpaceOver k (m + 1)).left),
        (∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)),
          ybar.base pt ∈ AlgebraicGeometry.Proj.basicOpen
            (MvPolynomial.homogeneousSubmodule (Fin (m + 2)) k)
            (∑ j : Fin (m + 2),
              (MvPolynomial.C (a s₀ ^ (j : ℕ)) : MvPolynomial (Fin (m + 2)) k) *
                (MvPolynomial.X j : MvPolynomial (Fin (m + 2)) k))) →
        ∃ (σ_k : k →+* Ω) (γ : Fin (m + 2) → Ω),
          (∑ j : Fin (m + 2), σ_k (a s₀) ^ (j : ℕ) * γ j = 1) ∧
          ∀ (α : Fin (m + 1) → Ω) (β : Fin 2 → Ω),
            (∑ i : Fin (m + 1), σ_k (a s₀) ^ (i : ℕ) * α i = 1) →
            (∑ r : Fin 2, σ_k (a s₀) ^ (r : ℕ) * β r = 1) →
            (∀ j : Fin (m + 2),
              (∑ p ∈ Finset.univ.filter
                  (fun p : Fin (m + 1) × Fin 2 => (p.1 : ℕ) + (p.2 : ℕ) = (j : ℕ)),
                α p.1 * β p.2) = γ j) →
            ∃ (ytilde : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
                CategoryTheory.Limits.pullback
                  (weilProjectiveSpaceOver k m).hom (weilProjectiveSpaceOver k 1).hom),
              ytilde ≫ μ = ybar) :=
by
  
  have hMod1 :
