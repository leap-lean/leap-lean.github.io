theorem weil_finset_subalgebra_filtered_colimit_package (k : Type u) [Field k]
    (R₀ : Type u) [CommRing R₀] [Algebra k R₀] [Algebra.FiniteType k R₀]
    (R' : CommRingCat.{u}) (ψ' : Quiver.Hom (CommRingCat.of R₀) R') :
    ∃ (ℐ : Type u) (_ : CategoryTheory.SmallCategory ℐ) (_ : CategoryTheory.IsFiltered ℐ)
      (D : CategoryTheory.Functor ℐ CommRingCat.{u})
      (α : Quiver.Hom ((CategoryTheory.Functor.const ℐ).obj (CommRingCat.of R₀)) D)
      (c : CategoryTheory.Limits.Cocone D) (_ : CategoryTheory.Limits.IsColimit c)
      (e_pt : CategoryTheory.Iso c.pt R'),
      (∀ l : ℐ, CategoryTheory.CategoryStruct.comp (α.app l)
        (CategoryTheory.CategoryStruct.comp (c.ι.app l) e_pt.hom) = ψ') ∧
      (∀ l : ℐ, RingHom.FiniteType ((CommRingCat.Hom.hom (α.app l)).comp (algebraMap k R₀))) ∧
      (∀ (l : ℐ) (ι : Type u) (Q : ι → CommRingCat.{u})
          (v : ∀ a : ι, Quiver.Hom (AlgebraicGeometry.Spec (Q a)) (AlgebraicGeometry.Spec (D.obj l))),
        (∀ a : ι, AlgebraicGeometry.Etale (v a)) →
        (∀ z : ↥(AlgebraicGeometry.Spec (D.obj l)), ∃ a : ι, z ∈ Set.range (v a).base) →
        ∃ (Q' : ι → CommRingCat.{u})
          (v' : ∀ a : ι, Quiver.Hom (AlgebraicGeometry.Spec (Q' a)) (AlgebraicGeometry.Spec R'))
          (u' : ∀ a : ι, Quiver.Hom (AlgebraicGeometry.Spec (Q' a)) (AlgebraicGeometry.Spec (Q a))),
          (∀ a : ι, AlgebraicGeometry.Etale (v' a)) ∧
          (∀ z' : ↥(AlgebraicGeometry.Spec R'), ∃ a : ι, z' ∈ Set.range (v' a).base) ∧
          (∀ a : ι, CategoryTheory.IsPullback (u' a) (v' a) (v a)
            (AlgebraicGeometry.Spec.map (CategoryTheory.CategoryStruct.comp (c.ι.app l) e_pt.hom)))) :=
by
  classical
  letI : Algebra R₀ ↑R' := RingHom.toAlgebra (CommRingCat.Hom.hom ψ')
  let ℐ : Type u := Finset ↑R'
  let S : ℐ → Subalgebra R₀ ↑R' := fun l => Algebra.adjoin R₀ (↑l : Set ↑R')
  let D : CategoryTheory.Functor ℐ CommRingCat.{u} :=
    { obj := fun l => CommRingCat.of ↥(S l)
      map := fun {l₁ l₂} θ =>
        CommRingCat.ofHom
          (Subalgebra.inclusion
            (Algebra.adjoin_mono (Finset.coe_subset.mpr (CategoryTheory.leOfHom θ)))).toRingHom
      map_id := fun l => by
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro x
        exact Subtype.ext rfl
      map_comp := fun {l₁ l₂ l₃} θ₁ θ₂ => by
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro x
        exact Subtype.ext rfl }
  let α : Quiver.Hom ((CategoryTheory.Functor.const ℐ).obj (CommRingCat.of R₀)) D :=
    { app := fun l => CommRingCat.ofHom (algebraMap R₀ ↥(S l))
      naturality := fun l₁ l₂ θ => by
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro r
        exact Subtype.ext rfl }
  let c : CategoryTheory.Limits.Cocone D :=
    { pt := R'
      ι :=
        { app := fun l => CommRingCat.ofHom (S l).val.toRingHom
          naturality := fun l₁ l₂ θ => by
            apply CommRingCat.hom_ext
            apply RingHom.ext
            intro x
            rfl } }
  let e_pt : CategoryTheory.Iso c.pt R' := CategoryTheory.Iso.refl R'
  have hr_mem : ∀ r : ↑R', r ∈ S {r} := fun r =>
    Algebra.subset_adjoin (Finset.mem_coe.mpr (Finset.mem_singleton_self r))
  let d_fun : ∀ (s : CategoryTheory.Limits.Cocone D), ↑R' → ↑s.pt :=
    fun s r => CommRingCat.Hom.hom (s.ι.app {r}) ⟨r, hr_mem r⟩
  have h_eval : ∀ (s : CategoryTheory.Limits.Cocone D) (l : ℐ) (r : ↑R') (hr : r ∈ S l),
      d_fun s r = CommRingCat.Hom.hom (s.ι.app l) ⟨r, hr⟩ := by
    intro s l r hr
    let u_set : ℐ := {r} ⊔ l
    let θ₁ : {r} ⟶ u_set := CategoryTheory.homOfLE le_sup_left
    let θ₂ : l ⟶ u_set := CategoryTheory.homOfLE le_sup_right
    have h₁ : s.ι.app {r} = CategoryTheory.CategoryStruct.comp (D.map θ₁) (s.ι.app u_set) :=
      (s.w θ₁).symm
    have h₂ : s.ι.app l = CategoryTheory.CategoryStruct.comp (D.map θ₂) (s.ι.app u_set) :=
      (s.w θ₂).symm
    have heq : CommRingCat.Hom.hom (D.map θ₁) ⟨r, hr_mem r⟩ =
        CommRingCat.Hom.hom (D.map θ₂) ⟨r, hr⟩ :=
      Subtype.ext rfl
    dsimp [d_fun]
    rw [h₁, h₂]
    change CommRingCat.Hom.hom (s.ι.app u_set) (CommRingCat.Hom.hom (D.map θ₁) ⟨r, hr_mem r⟩) =
      CommRingCat.Hom.hom (s.ι.app u_set) (CommRingCat.Hom.hom (D.map θ₂) ⟨r, hr⟩)
    rw [heq]
  let d_ring : ∀ (s : CategoryTheory.Limits.Cocone D), ↑R' →+* ↑s.pt := fun s =>
    { toFun := d_fun s
      map_one' := by
        rw [h_eval s ∅ 1 (Subalgebra.one_mem (S ∅))]
        exact map_one (CommRingCat.Hom.hom (s.ι.app ∅))
      map_mul' := fun x y => by
        let l : ℐ := {x} ⊔ {y}
        have hx_l : x ∈ l := (@le_sup_left ℐ _ {x} {y}) (Finset.mem_singleton_self x)
        have hy_l : y ∈ l := (@le_sup_right ℐ _ {x} {y}) (Finset.mem_singleton_self y)
        have hx : x ∈ S l := Algebra.subset_adjoin (Finset.mem_coe.mpr hx_l)
        have hy : y ∈ S l := Algebra.subset_adjoin (Finset.mem_coe.mpr hy_l)
        rw [h_eval s l (x * y) (Subalgebra.mul_mem (S l) hx hy),
          h_eval s l x hx, h_eval s l y hy]
        exact map_mul (CommRingCat.Hom.hom (s.ι.app l)) ⟨x, hx⟩ ⟨y, hy⟩
      map_zero' := by
        rw [h_eval s ∅ 0 (Subalgebra.zero_mem (S ∅))]
        exact map_zero (CommRingCat.Hom.hom (s.ι.app ∅))
      map_add' := fun x y => by
        let l : ℐ := {x} ⊔ {y}
        have hx_l : x ∈ l := (@le_sup_left ℐ _ {x} {y}) (Finset.mem_singleton_self x)
        have hy_l : y ∈ l := (@le_sup_right ℐ _ {x} {y}) (Finset.mem_singleton_self y)
        have hx : x ∈ S l := Algebra.subset_adjoin (Finset.mem_coe.mpr hx_l)
        have hy : y ∈ S l := Algebra.subset_adjoin (Finset.mem_coe.mpr hy_l)
        rw [h_eval s l (x + y) (Subalgebra.add_mem (S l) hx hy),
          h_eval s l x hx, h_eval s l y hy]
        exact map_add (CommRingCat.Hom.hom (s.ι.app l)) ⟨x, hx⟩ ⟨y, hy⟩ }
  let hc : CategoryTheory.Limits.IsColimit c :=
    { desc := fun s => CommRingCat.ofHom (d_ring s)
      fac := fun s l => by
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro x
        exact h_eval s l x.1 x.2
      uniq := fun s m hm => by
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro r
        exact congrArg
          (fun f : Quiver.Hom (D.obj {r}) s.pt =>
            CommRingCat.Hom.hom f (⟨r, hr_mem r⟩ : ↥(S {r})))
          (hm {r}) }
  refine ⟨ℐ, inferInstance, inferInstance, D, α, c, hc, e_pt, ?_, ?_, ?_⟩
  · intro l
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro r
    rfl
  · intro l
    have hFT_adj : Algebra.FiniteType R₀ ↥(S l) :=
      Algebra.FiniteType.adjoin_of_finite l.finite_toSet
    have hFT_α : RingHom.FiniteType (CommRingCat.Hom.hom (α.app l)) :=
      (RingHom.finiteType_algebraMap (A := R₀) (B := ↥(S l))).mpr hFT_adj
    have hFT_k : RingHom.FiniteType (algebraMap k R₀) :=
      (RingHom.finiteType_algebraMap (A := k) (B := R₀)).mpr inferInstance
    exact RingHom.FiniteType.comp hFT_α hFT_k
  · intro l ι Q v hv hsurj
    let g_l : Quiver.Hom (D.obj l) R' :=
      CategoryTheory.CategoryStruct.comp (c.ι.app l) e_pt.hom
    let f_a : ∀ a : ι, Quiver.Hom (D.obj l) (Q a) :=
      fun a => AlgebraicGeometry.Spec.preimage (v a)
    have hf_a : ∀ a : ι, AlgebraicGeometry.Spec.map (f_a a) = v a :=
      fun a => AlgebraicGeometry.Spec.map_preimage (v a)
    let Q' : ι → CommRingCat.{u} :=
      fun a => CategoryTheory.Limits.pushout (f_a a) g_l
    let v' : ∀ a : ι, Quiver.Hom (AlgebraicGeometry.Spec (Q' a)) (AlgebraicGeometry.Spec R') :=
      fun a => AlgebraicGeometry.Spec.map (CategoryTheory.Limits.pushout.inr (f_a a) g_l)
    let u' : ∀ a : ι, Quiver.Hom (AlgebraicGeometry.Spec (Q' a)) (AlgebraicGeometry.Spec (Q a)) :=
      fun a => AlgebraicGeometry.Spec.map (CategoryTheory.Limits.pushout.inl (f_a a) g_l)
    have hpb : ∀ a : ι, CategoryTheory.IsPullback (u' a) (v' a) (v a)
        (AlgebraicGeometry.Spec.map g_l) := by
      intro a
      have h0 := AlgebraicGeometry.isPullback_SpecMap_pushout (f_a a) g_l
      rwa [hf_a a] at h0
    refine ⟨Q', v', u', ?_, ?_, hpb⟩
    · intro a
      exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback (hpb a) (hv a)
    · intro z'
      obtain ⟨a, x, hx⟩ := hsurj ((AlgebraicGeometry.Spec.map g_l).base z')
      obtain ⟨p, -, hp⟩ := AlgebraicGeometry.Scheme.exists_preimage_of_isPullback (hpb a) x z' hx
      exact ⟨a, p, hp⟩

theorem weil_jacobson_nullstellensatz_cover_and_affine_etale_sheaf_gluing (k : Type u) [Field k] [IsAlgClosed k]
    (E : Type u) [CommRing E] [Algebra k E] [Algebra.FiniteType k E] :
    let S_E := AlgebraicGeometry.Spec (CommRingCat.of E)
    let T_E : S_E.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤
      (CategoryTheory.CategoryStruct.id S_E)
      (inferInstance : AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.id S_E))
    ((∀ z : ↥S_E, ∃ τ : E →ₐ[k] k, z.asIdeal ≤ RingHom.ker τ.toRingHom) ∧
      (∀ (τ : E →ₐ[k] k) (z : ↥S_E),
        z.asIdeal ≤ RingHom.ker τ.toRingHom →
        ∀ (Q : CommRingCat.{u}) (φ : Quiver.Hom (CommRingCat.of E) Q) (τ_Q : ↑Q →+* k),
          RingHom.Etale (CommRingCat.Hom.hom φ) →
          (∀ e : E, τ_Q (CommRingCat.Hom.hom φ e) = τ e) →
          AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map φ) ∧
          z ∈ Set.range (AlgebraicGeometry.Spec.map φ).base)) ∧
    ((∀ {G : CategoryTheory.Sheaf S_E.smallEtaleTopology AddCommGrpCat.{u}}
        (x : ↥(G.obj.obj (Opposite.op T_E))),
        (∀ z : ↥S_E, ∃ (Q : CommRingCat.{u}) (φ : Quiver.Hom (CommRingCat.of E) Q)
            (h_et : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map φ)),
          let V_φ : S_E.Etale :=
            CategoryTheory.MorphismProperty.Over.mk ⊤ (AlgebraicGeometry.Spec.map φ) h_et
          let u_φ : Quiver.Hom V_φ T_E :=
            CategoryTheory.MorphismProperty.Over.homMk
              (AlgebraicGeometry.Spec.map φ) (CategoryTheory.Category.comp_id _)
          z ∈ Set.range (AlgebraicGeometry.Spec.map φ).base ∧
          G.obj.map (Opposite.op u_φ) x = 0) →
        x = 0) ∧
      (∀ {G H : CategoryTheory.Sheaf S_E.smallEtaleTopology AddCommGrpCat.{u}}
          (Φ : Quiver.Hom G H),
        (∀ (Q₁₂ : CommRingCat.{u}) (φ₁₂ : Quiver.Hom (CommRingCat.of E) Q₁₂)
            (h_et : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map φ₁₂)),
          RingHom.FiniteType ((CommRingCat.Hom.hom φ₁₂).comp (algebraMap k E)) →
          Function.Injective (Φ.hom.app (Opposite.op
            (CategoryTheory.MorphismProperty.Over.mk ⊤ (AlgebraicGeometry.Spec.map φ₁₂) h_et :
              S_E.Etale)))) →
        ∀ (y : ↥(H.obj.obj (Opposite.op T_E))),
          (∀ z : ↥S_E, ∃ (Q : CommRingCat.{u}) (φ : Quiver.Hom (CommRingCat.of E) Q)
              (h_et : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map φ)),
            let V_φ : S_E.Etale :=
              CategoryTheory.MorphismProperty.Over.mk ⊤ (AlgebraicGeometry.Spec.map φ) h_et
            let u_φ : Quiver.Hom V_φ T_E :=
              CategoryTheory.MorphismProperty.Over.homMk
                (AlgebraicGeometry.Spec.map φ) (CategoryTheory.Category.comp_id _)
            ∃ (s_z : ↥(G.obj.obj (Opposite.op V_φ))),
              z ∈ Set.range (AlgebraicGeometry.Spec.map φ).base ∧
              Φ.hom.app (Opposite.op V_φ) s_z = H.obj.map (Opposite.op u_φ) y) →
          ∃ x : ↥(G.obj.obj (Opposite.op T_E)), Φ.hom.app (Opposite.op T_E) x = y)) :=
by
  classical
  intro S_E T_E
  have sieve_mem_of_pointwise :
      ∀ (Q_fam : ↥S_E → CommRingCat.{u})
        (φ_fam : ∀ z : ↥S_E, Quiver.Hom (CommRingCat.of E) (Q_fam z))
        (h_et_fam : ∀ z : ↥S_E, AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (φ_fam z))),
        (∀ z : ↥S_E, z ∈ Set.range (AlgebraicGeometry.Spec.map (φ_fam z)).base) →
        let V_fam : ↥S_E → S_E.Etale := fun z =>
          CategoryTheory.MorphismProperty.Over.mk ⊤ (AlgebraicGeometry.Spec.map (φ_fam z)) (h_et_fam z)
        let u_fam : ∀ z : ↥S_E, Quiver.Hom (V_fam z) T_E := fun z =>
          CategoryTheory.MorphismProperty.Over.homMk
            (AlgebraicGeometry.Spec.map (φ_fam z)) (CategoryTheory.Category.comp_id _)
        CategoryTheory.Sieve.ofArrows V_fam u_fam ∈ S_E.smallEtaleTopology T_E := by
    intro Q_fam φ_fam h_et_fam h_cov V_fam u_fam
    have : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
      (inferInstance : CategoryTheory.MorphismProperty.IsMultiplicative (@AlgebraicGeometry.Etale)).toIsStableUnderComposition
    let R_cov : CategoryTheory.Sieve T_E := CategoryTheory.Sieve.ofArrows V_fam u_fam
    change R_cov ∈
      AlgebraicGeometry.Scheme.smallGrothendieckTopology (P := @AlgebraicGeometry.Etale) (S := S_E) T_E
    rw [AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) S_E le_rfl]
    refine (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
      (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) (S := S_E) T_E R_cov).mpr
      fun z => ?_
    obtain ⟨y, hy⟩ := h_cov z
    exact ⟨V_fam z, u_fam z, y, CategoryTheory.Sieve.ofArrows_mk V_fam u_fam z, h_et_fam z, hy⟩
  let Z_obj : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
  let elemHom : ∀ (M : AddCommGrpCat.{u}), ↥M → (Z_obj ⟶ M) := fun M m =>
    AddCommGrpCat.ofHom ((zmultiplesHom ↥M m).comp AddEquiv.ulift.toAddMonoidHom)
  have elemHom_one : ∀ (M : AddCommGrpCat.{u}) (m : ↥M), elemHom M m (ULift.up 1) = m := by
    intro M m
    change (1 : ℤ) • m = m
    exact one_zsmul m
  have elemHom_comp : ∀ {M N : AddCommGrpCat.{u}} (m : ↥M) (α : M ⟶ N),
      elemHom M m ≫ α = elemHom N (α m) := by
    intro M N m α
    ext ⟨n⟩
    change α (n • m) = n • α m
    exact map_zsmul (ConcreteCategory.hom α) n m
  have elemHom_zero : ∀ (M : AddCommGrpCat.{u}), elemHom M 0 = 0 := by
    intro M
    ext ⟨n⟩
    change n • (0 : ↥M) = 0
    exact zsmul_zero n
  refine ⟨⟨?_, ?_⟩, ⟨?_, ?_⟩⟩
  · 
    intro z
    obtain ⟨𝔫, h𝔫_max, hz_le⟩ := Ideal.exists_le_maximal z.asIdeal z.isPrime.ne_top
    have : 𝔫.IsMaximal := h𝔫_max
    let _ : Field (E ⧸ 𝔫) := Ideal.Quotient.field 𝔫
    let q_𝔫 : E →ₐ[k] (E ⧸ 𝔫) := Ideal.Quotient.mkₐ k 𝔫
    have : Algebra.FiniteType k (E ⧸ 𝔫) :=
      Algebra.FiniteType.of_surjective q_𝔫 (Ideal.Quotient.mkₐ_surjective k 𝔫)
    have : Module.Finite k (E ⧸ 𝔫) := finite_of_finite_type_of_isJacobsonRing k (E ⧸ 𝔫)
    have : Algebra.IsIntegral k (E ⧸ 𝔫) := Algebra.IsIntegral.of_finite k (E ⧸ 𝔫)
    have h_bij : Function.Bijective ⇑(algebraMap k (E ⧸ 𝔫)) :=
      IsAlgClosed.algebraMap_bijective_of_isIntegral (k := k) (K := E ⧸ 𝔫)
    let e_k : (E ⧸ 𝔫) ≃ₐ[k] k :=
      (AlgEquiv.ofBijective (Algebra.ofId k (E ⧸ 𝔫)) h_bij).symm
    refine ⟨e_k.toAlgHom.comp q_𝔫, ?_⟩
    intro e he
    rw [RingHom.mem_ker]
    change e_k (q_𝔫 e) = 0
    have hq0 : q_𝔫 e = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr (hz_le he)
    rw [hq0, map_zero]
  · 
    intro τ z hz_le Q φ τ_Q hφ_et hτ_compat
    have h_et : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map φ) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hφ_et
    have : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map φ) := h_et
    refine ⟨h_et, ?_⟩
    have h_open_map : IsOpenMap (AlgebraicGeometry.Spec.map φ).base :=
      (AlgebraicGeometry.Spec.map φ).isOpenMap
    have h_open : IsOpen (Set.range (AlgebraicGeometry.Spec.map φ).base) :=
      h_open_map.isOpen_range
    let q_τ : PrimeSpectrum ↑Q := ⟨RingHom.ker τ_Q, RingHom.ker_isPrime τ_Q⟩
    let x_τ : ↥S_E := (AlgebraicGeometry.Spec.map φ).base q_τ
    have hx_mem : x_τ ∈ Set.range (AlgebraicGeometry.Spec.map φ).base := ⟨q_τ, rfl⟩
    have hz_x : z.asIdeal ≤ x_τ.asIdeal := by
      intro e he
      change e ∈ (PrimeSpectrum.comap (CommRingCat.Hom.hom φ) q_τ).asIdeal
      rw [PrimeSpectrum.comap_asIdeal, Ideal.mem_comap, RingHom.mem_ker, hτ_compat e]
      exact RingHom.mem_ker.mp (hz_le he)
    have h_spec : z ⤳ x_τ :=
      (PrimeSpectrum.le_iff_specializes (z : PrimeSpectrum E) (x_τ : PrimeSpectrum E)).mp hz_x
    exact specializes_iff_forall_open.mp h_spec _ h_open hx_mem
  · 
    intro G x h_loc
    let Q_fam : ↥S_E → CommRingCat.{u} := fun z => (h_loc z).choose
    let φ_fam : ∀ z : ↥S_E, Quiver.Hom (CommRingCat.of E) (Q_fam z) :=
      fun z => (h_loc z).choose_spec.choose
    let h_et_fam : ∀ z : ↥S_E, AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (φ_fam z)) :=
      fun z => (h_loc z).choose_spec.choose_spec.choose
    let V_fam : ↥S_E → S_E.Etale := fun z =>
      CategoryTheory.MorphismProperty.Over.mk ⊤ (AlgebraicGeometry.Spec.map (φ_fam z)) (h_et_fam z)
    let u_fam : ∀ z : ↥S_E, Quiver.Hom (V_fam z) T_E := fun z =>
      CategoryTheory.MorphismProperty.Over.homMk
        (AlgebraicGeometry.Spec.map (φ_fam z)) (CategoryTheory.Category.comp_id _)
    have h_cov : ∀ z : ↥S_E, z ∈ Set.range (AlgebraicGeometry.Spec.map (φ_fam z)).base :=
      fun z => (h_loc z).choose_spec.choose_spec.choose_spec.1
    have h_van : ∀ z : ↥S_E, G.obj.map (Opposite.op (u_fam z)) x = 0 :=
      fun z => (h_loc z).choose_spec.choose_spec.choose_spec.2
    have hf_cov : CategoryTheory.Sieve.ofArrows V_fam u_fam ∈ S_E.smallEtaleTopology T_E :=
      sieve_mem_of_pointwise Q_fam φ_fam h_et_fam h_cov
    have h_eq_hom : elemHom (G.obj.obj (Opposite.op T_E)) x = 0 :=
      G.property.hom_ext_ofArrows u_fam hf_cov fun z =>
        ((elemHom_comp x (G.obj.map (u_fam z).op)).trans
          (congrArg (elemHom (G.obj.obj (Opposite.op (V_fam z)))) (h_van z))).trans
          ((elemHom_zero (G.obj.obj (Opposite.op (V_fam z)))).trans
            (CategoryTheory.Limits.zero_comp :
              (0 : Z_obj ⟶ G.obj.obj (Opposite.op T_E)) ≫ G.obj.map (u_fam z).op = 0).symm)
    have h_ev := congrArg (fun f : Z_obj ⟶ G.obj.obj (Opposite.op T_E) => f (ULift.up 1)) h_eq_hom
    exact (elemHom_one (G.obj.obj (Opposite.op T_E)) x).symm.trans h_ev
  · 
    intro G H Φ hΦ_inj y h_loc
    let Q_fam : ↥S_E → CommRingCat.{u} := fun z => (h_loc z).choose
    let φ_fam : ∀ z : ↥S_E, Quiver.Hom (CommRingCat.of E) (Q_fam z) :=
      fun z => (h_loc z).choose_spec.choose
    let h_et_fam : ∀ z : ↥S_E, AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (φ_fam z)) :=
      fun z => (h_loc z).choose_spec.choose_spec.choose
    let V_fam : ↥S_E → S_E.Etale := fun z =>
      CategoryTheory.MorphismProperty.Over.mk ⊤ (AlgebraicGeometry.Spec.map (φ_fam z)) (h_et_fam z)
    let u_fam : ∀ z : ↥S_E, Quiver.Hom (V_fam z) T_E := fun z =>
      CategoryTheory.MorphismProperty.Over.homMk
        (AlgebraicGeometry.Spec.map (φ_fam z)) (CategoryTheory.Category.comp_id _)
    let s_fam : ∀ z : ↥S_E, ↥(G.obj.obj (Opposite.op (V_fam z))) :=
      fun z => (h_loc z).choose_spec.choose_spec.choose_spec.choose
    have h_cov : ∀ z : ↥S_E, z ∈ Set.range (AlgebraicGeometry.Spec.map (φ_fam z)).base :=
      fun z => (h_loc z).choose_spec.choose_spec.choose_spec.choose_spec.1
    have hs_eq : ∀ z : ↥S_E,
        Φ.hom.app (Opposite.op (V_fam z)) (s_fam z) = H.obj.map (Opposite.op (u_fam z)) y :=
      fun z => (h_loc z).choose_spec.choose_spec.choose_spec.choose_spec.2
    have hf_cov : CategoryTheory.Sieve.ofArrows V_fam u_fam ∈ S_E.smallEtaleTopology T_E :=
      sieve_mem_of_pointwise Q_fam φ_fam h_et_fam h_cov
    let x_hom : ∀ z : ↥S_E, Z_obj ⟶ G.obj.obj (Opposite.op (V_fam z)) :=
      fun z => elemHom _ (s_fam z)
    have hx : ∀ ⦃W : S_E.Etale⦄ ⦃i j : ↥S_E⦄ (a : W ⟶ V_fam i) (b : W ⟶ V_fam j),
        a ≫ u_fam i = b ≫ u_fam j →
        x_hom i ≫ G.obj.map a.op = x_hom j ≫ G.obj.map b.op := by
      intro W i j a b hab
      have : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (φ_fam i)) := h_et_fam i
      have : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (φ_fam j)) := h_et_fam j
      let P₁₂ := CategoryTheory.Limits.pullback
        (AlgebraicGeometry.Spec.map (φ_fam i)) (AlgebraicGeometry.Spec.map (φ_fam j))
      let pr₁ := CategoryTheory.Limits.pullback.fst
        (AlgebraicGeometry.Spec.map (φ_fam i)) (AlgebraicGeometry.Spec.map (φ_fam j))
      let pr₂ := CategoryTheory.Limits.pullback.snd
        (AlgebraicGeometry.Spec.map (φ_fam i)) (AlgebraicGeometry.Spec.map (φ_fam j))
      let Q₁₂ : CommRingCat.{u} := P₁₂.presheaf.obj (Opposite.op ⊤)
      let e₁₂ : P₁₂ ≅ AlgebraicGeometry.Spec Q₁₂ := P₁₂.isoSpec
      let g₁₂ : AlgebraicGeometry.Spec Q₁₂ ⟶ S_E :=
        e₁₂.inv ≫ pr₁ ≫ AlgebraicGeometry.Spec.map (φ_fam i)
      let φ₁₂ : Quiver.Hom (CommRingCat.of E) Q₁₂ := AlgebraicGeometry.Spec.preimage g₁₂
      have h_map₁₂ : AlgebraicGeometry.Spec.map φ₁₂ = g₁₂ :=
        AlgebraicGeometry.Spec.map_preimage g₁₂
      have h_et_g₁₂ : AlgebraicGeometry.Etale g₁₂ := inferInstance
      have h_et₁₂ : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map φ₁₂) := by
        rwa [h_map₁₂]
      have : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map φ₁₂) := h_et₁₂
      have hFT_φ₁₂ : RingHom.FiniteType (CommRingCat.Hom.hom φ₁₂) :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff
          (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp inferInstance
      have hFT_E : RingHom.FiniteType (algebraMap k E) :=
        RingHom.finiteType_algebraMap.mpr inferInstance
      have hFT₁₂ : RingHom.FiniteType ((CommRingCat.Hom.hom φ₁₂).comp (algebraMap k E)) :=
        RingHom.FiniteType.comp hFT_φ₁₂ hFT_E
      let V₁₂ : S_E.Etale :=
        CategoryTheory.MorphismProperty.Over.mk ⊤ (AlgebraicGeometry.Spec.map φ₁₂) h_et₁₂
      let p₁ : V₁₂ ⟶ V_fam i :=
        CategoryTheory.MorphismProperty.Over.homMk (e₁₂.inv ≫ pr₁)
          ((CategoryTheory.Category.assoc e₁₂.inv pr₁
            (AlgebraicGeometry.Spec.map (φ_fam i))).trans h_map₁₂.symm)
      let p₂ : V₁₂ ⟶ V_fam j :=
        CategoryTheory.MorphismProperty.Over.homMk (e₁₂.inv ≫ pr₂)
          (((CategoryTheory.Category.assoc e₁₂.inv pr₂
            (AlgebraicGeometry.Spec.map (φ_fam j))).trans
              (congrArg (e₁₂.inv ≫ ·) CategoryTheory.Limits.pullback.condition.symm)).trans
            h_map₁₂.symm)
      have hp_comm : p₁ ≫ u_fam i = p₂ ≫ u_fam j := by
        refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
        change (e₁₂.inv ≫ pr₁) ≫ AlgebraicGeometry.Spec.map (φ_fam i) =
          (e₁₂.inv ≫ pr₂) ≫ AlgebraicGeometry.Spec.map (φ_fam j)
        rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.condition]
      have hnat₁ :
          Φ.hom.app (Opposite.op V₁₂) (G.obj.map (Opposite.op p₁) (s_fam i)) =
            H.obj.map (Opposite.op p₁) (Φ.hom.app (Opposite.op (V_fam i)) (s_fam i)) :=
        congrArg
          (fun f : G.obj.obj (Opposite.op (V_fam i)) ⟶ H.obj.obj (Opposite.op V₁₂) => f (s_fam i))
          (Φ.hom.naturality (Opposite.op p₁))
      have hnat₂ :
          Φ.hom.app (Opposite.op V₁₂) (G.obj.map (Opposite.op p₂) (s_fam j)) =
            H.obj.map (Opposite.op p₂) (Φ.hom.app (Opposite.op (V_fam j)) (s_fam j)) :=
        congrArg
          (fun f : G.obj.obj (Opposite.op (V_fam j)) ⟶ H.obj.obj (Opposite.op V₁₂) => f (s_fam j))
          (Φ.hom.naturality (Opposite.op p₂))
      have hcomp₁ :
          H.obj.map (Opposite.op (p₁ ≫ u_fam i)) y =
            H.obj.map (Opposite.op p₁) (H.obj.map (Opposite.op (u_fam i)) y) :=
        congrArg
          (fun f : H.obj.obj (Opposite.op T_E) ⟶ H.obj.obj (Opposite.op V₁₂) => f y)
          (H.obj.map_comp (Opposite.op (u_fam i)) (Opposite.op p₁))
      have hcomp₂ :
          H.obj.map (Opposite.op (p₂ ≫ u_fam j)) y =
            H.obj.map (Opposite.op p₂) (H.obj.map (Opposite.op (u_fam j)) y) :=
        congrArg
          (fun f : H.obj.obj (Opposite.op T_E) ⟶ H.obj.obj (Opposite.op V₁₂) => f y)
          (H.obj.map_comp (Opposite.op (u_fam j)) (Opposite.op p₂))
      have hs_V₁₂ :
          G.obj.map (Opposite.op p₁) (s_fam i) = G.obj.map (Opposite.op p₂) (s_fam j) :=
        hΦ_inj Q₁₂ φ₁₂ h_et₁₂ hFT₁₂
          ((hnat₁.trans (congrArg (H.obj.map (Opposite.op p₁)) (hs_eq i))).trans
            ((hcomp₁.symm.trans
              (congrArg (fun f : V₁₂ ⟶ T_E => H.obj.map (Opposite.op f) y) hp_comm)).trans
              (hcomp₂.trans
                ((congrArg (H.obj.map (Opposite.op p₂)) (hs_eq j).symm).trans hnat₂.symm))))
      have hab_left : a.left ≫ AlgebraicGeometry.Spec.map (φ_fam i) =
          b.left ≫ AlgebraicGeometry.Spec.map (φ_fam j) :=
        congrArg (fun f : W ⟶ T_E => f.left) hab
      let l_ab : W.left ⟶ P₁₂ :=
        CategoryTheory.Limits.pullback.lift a.left b.left hab_left
      let w_sch : W.left ⟶ AlgebraicGeometry.Spec Q₁₂ := l_ab ≫ e₁₂.hom
      have h_l_pr₁ : w_sch ≫ (e₁₂.inv ≫ pr₁) = a.left :=
        ((CategoryTheory.Category.assoc l_ab e₁₂.hom (e₁₂.inv ≫ pr₁)).trans
          (congrArg (l_ab ≫ ·) (e₁₂.hom_inv_id_assoc pr₁))).trans
          (CategoryTheory.Limits.pullback.lift_fst a.left b.left hab_left)
      have h_l_pr₂ : w_sch ≫ (e₁₂.inv ≫ pr₂) = b.left :=
        ((CategoryTheory.Category.assoc l_ab e₁₂.hom (e₁₂.inv ≫ pr₂)).trans
          (congrArg (l_ab ≫ ·) (e₁₂.hom_inv_id_assoc pr₂))).trans
          (CategoryTheory.Limits.pullback.lift_snd a.left b.left hab_left)
      have hw_sch : w_sch ≫ AlgebraicGeometry.Spec.map φ₁₂ = W.hom :=
        (congrArg (w_sch ≫ ·) h_map₁₂).trans
          ((congrArg (w_sch ≫ ·)
            (CategoryTheory.Category.assoc e₁₂.inv pr₁
              (AlgebraicGeometry.Spec.map (φ_fam i))).symm).trans
            (((CategoryTheory.Category.assoc w_sch (e₁₂.inv ≫ pr₁)
              (AlgebraicGeometry.Spec.map (φ_fam i))).symm.trans
              (congrArg (· ≫ AlgebraicGeometry.Spec.map (φ_fam i)) h_l_pr₁)).trans
              (CategoryTheory.MorphismProperty.Over.w a)))
      let w_et : W ⟶ V₁₂ :=
        CategoryTheory.MorphismProperty.Over.homMk w_sch hw_sch
      have hw_p₁ : w_et ≫ p₁ = a :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext h_l_pr₁ (Subsingleton.elim _ _)
      have hw_p₂ : w_et ≫ p₂ = b :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext h_l_pr₂ (Subsingleton.elim _ _)
      change elemHom _ (s_fam i) ≫ G.obj.map a.op = elemHom _ (s_fam j) ≫ G.obj.map b.op
      rw [elemHom_comp, elemHom_comp, ← hw_p₁, ← hw_p₂, op_comp, op_comp,
        G.obj.map_comp, G.obj.map_comp]
      change elemHom _ (G.obj.map w_et.op (G.obj.map (Opposite.op p₁) (s_fam i))) =
        elemHom _ (G.obj.map w_et.op (G.obj.map (Opposite.op p₂) (s_fam j)))
      rw [hs_V₁₂]
    let x_amalg : Z_obj ⟶ G.obj.obj (Opposite.op T_E) :=
      G.property.amalgamateOfArrows u_fam hf_cov x_hom hx
    let x : ↥(G.obj.obj (Opposite.op T_E)) := x_amalg (ULift.up 1)
    have h_eq_y : x_amalg ≫ Φ.hom.app (Opposite.op T_E) = elemHom _ y := by
      refine H.property.hom_ext_ofArrows u_fam hf_cov fun i => ?_
      rw [CategoryTheory.Category.assoc, ← Φ.hom.naturality (u_fam i).op,
        ← CategoryTheory.Category.assoc,
        G.property.amalgamateOfArrows_map u_fam hf_cov x_hom hx i]
      change elemHom (G.obj.obj (Opposite.op (V_fam i))) (s_fam i) ≫
        Φ.hom.app (Opposite.op (V_fam i)) =
        elemHom (H.obj.obj (Opposite.op T_E)) y ≫ H.obj.map (Opposite.op (u_fam i))
      rw [elemHom_comp, elemHom_comp]
      exact congrArg (elemHom (H.obj.obj (Opposite.op (V_fam i)))) (hs_eq i)
    refine ⟨x, ?_⟩
    have h_ev := congrArg (fun f : Z_obj ⟶ H.obj.obj (Opposite.op T_E) => f (ULift.up 1)) h_eq_y
    change Φ.hom.app (Opposite.op T_E) (x_amalg (ULift.up 1)) =
      elemHom (H.obj.obj (Opposite.op T_E)) y (ULift.up 1) at h_ev
    rwa [elemHom_one] at h_ev

