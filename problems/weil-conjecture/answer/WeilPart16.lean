      have h₂ : φ_of π₁ π₂ h h_eq F q x₂' = x₁ := (hMaps_iff π₁ π₂ h h_eq F q x₂' x₁).mp hM₂
      exact hφ_bij.1 (h₁.trans h₂.symm)

theorem weil_strict_local_algClosed_etale_sieve_id_mem (k : Type u) [Field k] [IsAlgClosed k]
    (A₀ : Type u) [CommRing A₀] [Algebra k A₀] (τ₀ : A₀ →ₐ[k] k)
    (hA₀ : WeilIsStrictLocalNoetherianAlgClosedRing k A₀ τ₀) :
    let Z_A₀ := AlgebraicGeometry.Spec (CommRingCat.of A₀)
    let T_A₀ : Z_A₀.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤
      (CategoryTheory.CategoryStruct.id Z_A₀)
      (inferInstance : AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.id Z_A₀))
    ∀ (S : CategoryTheory.Sieve T_A₀),
      S ∈ Z_A₀.smallEtaleTopology T_A₀ →
      S.arrows (CategoryTheory.CategoryStruct.id T_A₀) :=
by
  classical
  intro Z_A₀ T_A₀ S hS
  obtain ⟨_, _, _, _, hSec⟩ := hA₀
  have : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
    (inferInstance : CategoryTheory.MorphismProperty.IsMultiplicative (@AlgebraicGeometry.Etale)).toIsStableUnderComposition
  have h_top :=
    AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) Z_A₀ le_rfl
  have hS_pre := Eq.mp (congrArg (fun J => S ∈ J T_A₀) h_top) hS
  let x₀ : PrimeSpectrum A₀ := ⟨RingHom.ker τ₀.toRingHom, RingHom.ker_isPrime τ₀.toRingHom⟩
  obtain ⟨V, u, v₀, hu_arr, hu_et, hv₀⟩ :=
    (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
      (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) (S := Z_A₀) T_A₀ S).mp hS_pre x₀
  let 𝒰 := V.left.affineCover
  let i₀ := 𝒰.idx v₀
  obtain ⟨y₀, hy₀⟩ := 𝒰.covers v₀
  let W : AlgebraicGeometry.Scheme.{u} := 𝒰.X i₀
  let C_obj : CommRingCat.{u} := W.presheaf.obj (Opposite.op ⊤)
  let C : Type u := ↑C_obj
  let e_W : W ≅ AlgebraicGeometry.Spec C_obj := W.isoSpec
  let j_C : AlgebraicGeometry.Spec C_obj ⟶ V.left := e_W.inv ≫ 𝒰.f i₀
  have hj_et : AlgebraicGeometry.Etale j_C := by
    dsimp [j_C]
    infer_instance
  let w_C : AlgebraicGeometry.Spec C_obj ⟶ Z_A₀ := j_C ≫ u.left
  have hw_et : AlgebraicGeometry.Etale w_C :=
    CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale) j_C u.left hj_et hu_et
  let p_C : ↥(AlgebraicGeometry.Spec C_obj) := e_W.hom.base y₀
  have hw_pt : w_C.base p_C = x₀ := by
    have h1 : e_W.inv.base p_C = y₀ := by
      change (e_W.hom ≫ e_W.inv).base y₀ = y₀
      rw [e_W.hom_inv_id]
      rfl
    have h2 : j_C.base p_C = v₀ := by
      change (𝒰.f i₀).base (e_W.inv.base p_C) = v₀
      rw [h1]
      exact hy₀
    change u.left.base (j_C.base p_C) = x₀
    rw [h2]
    exact hv₀
  let φ_hom : CommRingCat.of A₀ ⟶ C_obj := AlgebraicGeometry.Spec.preimage w_C
  have hφ_map : AlgebraicGeometry.Spec.map φ_hom = w_C := AlgebraicGeometry.Spec.map_preimage w_C
  let φ_C : A₀ →+* C := φ_hom.hom
  have hφ_spec_et : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map φ_hom) :=
    Eq.mp (congrArg AlgebraicGeometry.Etale hφ_map.symm) hw_et
  have hφ_et : RingHom.Etale φ_C :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hφ_spec_et
  let _ : Algebra A₀ C := φ_C.toAlgebra
  have : Algebra.Etale A₀ C := hφ_et.toAlgebra
  have : Algebra.FinitePresentation A₀ C := Algebra.Etale.finitePresentation
  have hp_map_pt : (AlgebraicGeometry.Spec.map φ_hom).base p_C = x₀ :=
    (congrArg (fun f : AlgebraicGeometry.Spec C_obj ⟶ Z_A₀ => f.base p_C) hφ_map).trans hw_pt
  have hp_comap : Ideal.comap φ_C p_C.asIdeal = RingHom.ker τ₀.toRingHom :=
    congrArg PrimeSpectrum.asIdeal hp_map_pt
  obtain ⟨𝔪_C, h𝔪_max, hp_le_𝔪⟩ := Ideal.exists_le_maximal p_C.asIdeal p_C.isPrime.ne_top
  let L : Type u := C ⧸ 𝔪_C
  let _ : Field L := @Ideal.Quotient.field C _ 𝔪_C h𝔪_max
  let q_L : C →+* L := Ideal.Quotient.mk 𝔪_C
  let _ : Algebra k L := (q_L.comp (φ_C.comp (algebraMap k A₀))).toAlgebra
  have hq_φ : ∀ a : A₀, q_L (φ_C a) = algebraMap k L (τ₀ a) := by
    intro a
    have hker : a - algebraMap k A₀ (τ₀ a) ∈ RingHom.ker τ₀.toRingHom := by
      change τ₀ (a - algebraMap k A₀ (τ₀ a)) = 0
      rw [map_sub, τ₀.commutes]
      exact sub_self (τ₀ a)
    have hmem_p : φ_C (a - algebraMap k A₀ (τ₀ a)) ∈ p_C.asIdeal := by
      change a - algebraMap k A₀ (τ₀ a) ∈ Ideal.comap φ_C p_C.asIdeal
      rw [hp_comap]
      exact hker
    have hmem_m : φ_C a - φ_C (algebraMap k A₀ (τ₀ a)) ∈ 𝔪_C := by
      rw [← map_sub]
      exact hp_le_𝔪 hmem_p
    have hsub0 : q_L (φ_C a) - q_L (φ_C (algebraMap k A₀ (τ₀ a))) = 0 := by
      rw [← map_sub]
      exact (Ideal.Quotient.eq_zero_iff_mem).mpr hmem_m
    exact sub_eq_zero.mp hsub0
  obtain ⟨s_gen, hs_gen⟩ := (inferInstance : Algebra.FiniteType A₀ C).out
  let S_k : Subalgebra k L := Algebra.adjoin k (↑(s_gen.image q_L) : Set L)
  let T_sub : Subalgebra A₀ C :=
    { carrier := { c : C | q_L c ∈ S_k }
      mul_mem' := fun {x y} hx hy => by
        change q_L (x * y) ∈ S_k
        rw [map_mul]
        exact S_k.mul_mem hx hy
      one_mem' := by
        change q_L 1 ∈ S_k
        rw [map_one]
        exact S_k.one_mem
      add_mem' := fun {x y} hx hy => by
        change q_L (x + y) ∈ S_k
        rw [map_add]
        exact S_k.add_mem hx hy
      zero_mem' := by
        change q_L 0 ∈ S_k
        rw [map_zero]
        exact S_k.zero_mem
      algebraMap_mem' := fun a => by
        change q_L (φ_C a) ∈ S_k
        rw [hq_φ a]
        exact S_k.algebraMap_mem (τ₀ a) }
  have hs_le : (↑s_gen : Set C) ⊆ (T_sub : Set C) := by
    intro c hc
    change q_L c ∈ S_k
    exact Algebra.subset_adjoin (Finset.mem_coe.mpr (Finset.mem_image_of_mem q_L (Finset.mem_coe.mp hc)))
  have hT_top : (⊤ : Subalgebra A₀ C) ≤ T_sub := by
    rw [← hs_gen]
    exact Algebra.adjoin_le hs_le
  have hSk_top : S_k = ⊤ := by
    rw [eq_top_iff]
    intro x _
    obtain ⟨c, rfl⟩ := Ideal.Quotient.mk_surjective x
    exact hT_top (by trivial : c ∈ (⊤ : Subalgebra A₀ C))
  have : Algebra.FiniteType k L := ⟨⟨s_gen.image q_L, hSk_top⟩⟩
  have : Module.Finite k L := finite_of_finite_type_of_isJacobsonRing k L
  have : Algebra.IsIntegral k L := Algebra.IsIntegral.of_finite k L
  have hbij_kL : Function.Bijective (algebraMap k L) :=
    IsAlgClosed.algebraMap_bijective_of_isIntegral
  let e_kL : k ≃+* L := RingEquiv.ofBijective (algebraMap k L) hbij_kL
  let τ_C : C →+* k := e_kL.symm.toRingHom.comp q_L
  have hτ_C : ∀ a : A₀, τ_C (algebraMap A₀ C a) = τ₀ a := by
    intro a
    apply e_kL.injective
    change e_kL (e_kL.symm (q_L (φ_C a))) = algebraMap k L (τ₀ a)
    rw [e_kL.apply_symm_apply, hq_φ a]
  obtain ⟨σ_C, _⟩ := hSec C τ_C hτ_C
  let σ_hom : C_obj ⟶ CommRingCat.of A₀ :=
    CommRingCat.ofHom (R := C) (S := A₀) σ_C.toRingHom
  have hφσ : φ_hom ≫ σ_hom = CategoryTheory.CategoryStruct.id (CommRingCat.of A₀) := by
    ext a
    exact (σ_C.commutes a).trans (RingHom.id_apply a)
  have hSpec_sec : AlgebraicGeometry.Spec.map σ_hom ≫ w_C = CategoryTheory.CategoryStruct.id Z_A₀ :=
    (congrArg (AlgebraicGeometry.Spec.map σ_hom ≫ ·) hφ_map.symm).trans
      ((AlgebraicGeometry.Spec.map_comp φ_hom σ_hom).symm.trans
        ((congrArg AlgebraicGeometry.Spec.map hφσ).trans
          (AlgebraicGeometry.Spec.map_id (CommRingCat.of A₀))))
  let s_left : Z_A₀ ⟶ V.left := AlgebraicGeometry.Spec.map σ_hom ≫ j_C
  have hs_u_left : s_left ≫ u.left = CategoryTheory.CategoryStruct.id Z_A₀ :=
    (CategoryTheory.Category.assoc _ _ _).trans hSpec_sec
  have hs_w : s_left ≫ V.hom = T_A₀.hom :=
    (congrArg (s_left ≫ ·) (CategoryTheory.MorphismProperty.Over.w u).symm).trans
      ((CategoryTheory.Category.assoc _ _ _).symm.trans
        ((congrArg (· ≫ T_A₀.hom) hs_u_left).trans
          (CategoryTheory.Category.id_comp T_A₀.hom)))
  let s_V : T_A₀ ⟶ V := CategoryTheory.MorphismProperty.Over.homMk s_left hs_w trivial
  have hs_id : CategoryTheory.CategoryStruct.comp s_V u = CategoryTheory.CategoryStruct.id T_A₀ :=
    (weilEtaleIdTerminalIsTerminal.{u} Z_A₀).hom_ext _ _
  exact Eq.mp (congrArg (fun f : T_A₀ ⟶ T_A₀ => S.arrows f) hs_id) (S.downward_closed hu_arr s_V)

