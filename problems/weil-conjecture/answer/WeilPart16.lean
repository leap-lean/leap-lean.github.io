      (U₀ : AlgebraicGeometry.Scheme.{u}).presheaf.obj (Opposite.op ⊤)
    let ρ_j : ∀ j : Fin r, ↑(Z₀.presheaf.obj (Opposite.op (U j))) →+* ↑A₀_obj :=
      fun j => (AlgebraicGeometry.Scheme.Hom.appLE U₀.ι (U j) ⊤ (fun x _ => hU₀_le j x.2)).hom
    let g : Fin (N + 1) → ↑A₀_obj := fun γ =>
      if h : γ.val < M then ∏ j : Fin r, ρ_j j (f_ext j (e ⟨γ.val, h⟩ j)) else 1
    have hgi₀ : g i₀ = 1 := by
      dsimp only [g]
      split_ifs
      apply Finset.prod_eq_one
      intro j _
      have h_idx : (⟨i₀.val, hi₀_lt⟩ : Fin M) = i₀_M := Fin.ext rfl
      rw [h_idx]
      simp [i₀_M, f_ext]
    let κ₀ : k →+* ↑A₀_obj :=
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ (U₀.ι ≫ h_Z).appTop).hom
    let ψ : MvPolynomial (Fin (N + 1)) k →+* ↑A₀_obj := MvPolynomial.eval₂Hom κ₀ g
    have hψ_i₀ : ψ (MvPolynomial.X i₀ : MvPolynomial (Fin (N + 1)) k) = 1 := by simp [ψ, hgi₀]
    have hψ_unit : IsUnit (ψ (MvPolynomial.X i₀ : MvPolynomial (Fin (N + 1)) k)) :=
      hψ_i₀ ▸ isUnit_one
    let ψ_loc : Localization.Away (MvPolynomial.X i₀ : MvPolynomial (Fin (N + 1)) k) →+* ↑A₀_obj :=
      IsLocalization.Away.lift (MvPolynomial.X i₀ : MvPolynomial (Fin (N + 1)) k) hψ_unit
    let valHom : ∀ S_sub : Submonoid (MvPolynomial (Fin (N + 1)) k),
        HomogeneousLocalization 𝒜 S_sub →+* Localization S_sub := fun S_sub =>
      { toFun := HomogeneousLocalization.val
        map_one' := HomogeneousLocalization.val_one
        map_mul' := HomogeneousLocalization.val_mul
        map_zero' := HomogeneousLocalization.val_zero
        map_add' := HomogeneousLocalization.val_add }
    let φ₀ : HomogeneousLocalization.Away 𝒜
        (MvPolynomial.X i₀ : MvPolynomial (Fin (N + 1)) k) →+* ↑A₀_obj :=
      ψ_loc.comp (valHom (Submonoid.powers (MvPolynomial.X i₀ : MvPolynomial (Fin (N + 1)) k)))
    let φ₀_hom : CommRingCat.of (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i₀)) ⟶ A₀_obj :=
      CommRingCat.ofHom φ₀
    have hφ₀_mk : ∀ (d : ℕ) (p : MvPolynomial (Fin (N + 1)) k) (hp : p ∈ 𝒜 (d • 1)),
        φ₀ (HomogeneousLocalization.Away.mk 𝒜 (hX i₀) d p hp) = ψ p := by
      intro d p hp
      change ψ_loc
        (HomogeneousLocalization.val (HomogeneousLocalization.Away.mk 𝒜 (hX i₀) d p hp)) = ψ p
      rw [HomogeneousLocalization.Away.val_mk]
      let den_d : Submonoid.powers (MvPolynomial.X i₀ : MvPolynomial (Fin (N + 1)) k) :=
        ⟨MvPolynomial.X i₀ ^ d, ⟨d, rfl⟩⟩
      let locMap := algebraMap (MvPolynomial (Fin (N + 1)) k)
        (Localization.Away (MvPolynomial.X i₀ : MvPolynomial (Fin (N + 1)) k))
      have hmul : Localization.mk p den_d * locMap (MvPolynomial.X i₀ ^ d) = locMap p := by
        change Localization.mk p den_d * Localization.mk (MvPolynomial.X i₀ ^ d) 1 =
