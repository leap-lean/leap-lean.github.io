theorem weil_etale_affine_free_filtered_colimit_hom_bijective (Y : AlgebraicGeometry.Scheme.{u}) (U : Y.Etale)
    (hAffU : AlgebraicGeometry.IsAffine ((AlgebraicGeometry.Scheme.Etale.forget Y).obj U).left)
    (Λ : Type u) [CategoryTheory.SmallCategory Λ] [CategoryTheory.IsFiltered Λ]
    (D : CategoryTheory.Functor Λ (CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}))
    (c : CategoryTheory.Limits.Cocone D)
    (hc : Nonempty (CategoryTheory.Limits.IsColimit c)) :
    let Z_U := (CategoryTheory.presheafToSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj
      ((CategoryTheory.yoneda.obj U).comp AddCommGrpCat.free)
    (∀ (y : CategoryTheory.Abelian.Ext.{u} Z_U c.pt 0),
      ∃ (l : Λ) (x : CategoryTheory.Abelian.Ext.{u} Z_U (D.obj l) 0),
        (CategoryTheory.Abelian.Ext.mk₀ (c.ι.app l)).postcomp Z_U (Nat.add_zero 0) x = y) ∧
    (∀ (l : Λ) (x : CategoryTheory.Abelian.Ext.{u} Z_U (D.obj l) 0),
      (CategoryTheory.Abelian.Ext.mk₀ (c.ι.app l)).postcomp Z_U (Nat.add_zero 0) x = 0 →
      ∃ (l' : Λ) (f : l ⟶ l'),
        (CategoryTheory.Abelian.Ext.mk₀ (D.map f)).postcomp Z_U (Nat.add_zero 0) x = 0) :=
by
  intro Z_U
  obtain ⟨hc⟩ := hc
  
  have hSecColim : ∀ (C : Type u) [CategoryTheory.SmallCategory C]
      [CategoryTheory.Limits.HasPullbacks C]
      (J : CategoryTheory.GrothendieckTopology C),
      (∀ (X : C) (S : CategoryTheory.Sieve X), S ∈ J X →
        ∃ (n : ℕ) (W : Fin n → C) (π : ∀ i : Fin n, W i ⟶ X),
          (∀ i : Fin n, S.arrows (π i)) ∧
          CategoryTheory.Sieve.generate (CategoryTheory.Presieve.ofArrows W π) ∈ J X) →
      ∀ (D₀ : CategoryTheory.Functor Λ (CategoryTheory.Sheaf J AddCommGrpCat.{u}))
        (c₀ : CategoryTheory.Limits.Cocone D₀),
        CategoryTheory.Limits.IsColimit c₀ →
        ∀ (X : C),
          (∀ (y : ↥(c₀.pt.obj.obj (Opposite.op X))),
            ∃ (l : Λ) (x : ↥((D₀.obj l).obj.obj (Opposite.op X))),
              ((c₀.ι.app l).hom.app (Opposite.op X)) x = y) ∧
          (∀ (l : Λ) (x : ↥((D₀.obj l).obj.obj (Opposite.op X))),
            ((c₀.ι.app l).hom.app (Opposite.op X)) x = 0 →
            ∃ (l' : Λ) (f : l ⟶ l'),
              ((D₀.map f).hom.app (Opposite.op X)) x = 0) := by
    intro C _ _ J hQC D₀ c₀ hc₀ X
    classical
    let K_pre : CategoryTheory.Precoverage C :=
      { coverings := fun B =>
          { R : CategoryTheory.Presieve B |
            (∃ (n : ℕ) (W : Fin n → C) (π : ∀ i : Fin n, W i ⟶ B),
              R = CategoryTheory.Presieve.ofArrows W π) ∧
            CategoryTheory.Sieve.generate R ∈ J B } }
    let K_fin : CategoryTheory.Coverage C :=
      CategoryTheory.Coverage.mk K_pre (fun {B Y₀} f R hR => by
        have h_pb : CategoryTheory.Sieve.pullback f (CategoryTheory.Sieve.generate R) ∈ J Y₀ :=
          J.pullback_stable f hR.2
        obtain ⟨m, W', π', h_sub, h_cov⟩ := hQC Y₀ _ h_pb
        refine ⟨CategoryTheory.Presieve.ofArrows W' π', ⟨⟨m, W', π', rfl⟩, h_cov⟩, ?_⟩
        intro Z' g hg
        cases hg with
        | mk j =>
          rcases h_sub j with ⟨Z, h, k, hk, hcomm⟩
          exact ⟨Z, h, k, hk, hcomm⟩)
    have hK_eq : K_fin.toGrothendieck = J := by
      apply le_antisymm
      · rw [(CategoryTheory.Coverage.gi C).gc K_fin J]
        intro B R hR
        exact hR.2
      · intro B S hS
        obtain ⟨n, W, π, h_sub, h_cov⟩ := hQC B S hS
        have hR_mem : CategoryTheory.Presieve.ofArrows W π ∈ K_fin.coverings B :=
          ⟨⟨n, W, π, rfl⟩, h_cov⟩
        have hgen_mem : CategoryTheory.Sieve.generate (CategoryTheory.Presieve.ofArrows W π) ∈
            K_fin.toGrothendieck B :=
          CategoryTheory.Coverage.Saturate.of B _ hR_mem
        refine K_fin.toGrothendieck.superset_covering ?_ hgen_mem
        intro Z u hu
        rcases hu with ⟨W₀, h, k, hk, rfl⟩
        cases hk with
        | mk i => exact S.downward_closed (h_sub i) h
    have hSupObj : ∀ {α : Type} [Fintype α] (L : α → Λ),
        ∃ (l₀ : Λ), Nonempty (∀ a : α, L a ⟶ l₀) := by
      intro α _ L
      let O : Finset Λ := Finset.univ.image L
      exact ⟨CategoryTheory.IsFiltered.sup O ∅, ⟨fun a =>
        CategoryTheory.IsFiltered.toSup O ∅ (Finset.mem_image_of_mem L (Finset.mem_univ a))⟩⟩
    have hSupHom : ∀ {α : Type} [Fintype α] (l₀ : Λ) (L' : α → Λ)
        (f : ∀ a : α, l₀ ⟶ L' a),
        ∃ (l₁ : Λ) (g : l₀ ⟶ l₁),
          ∀ a : α, ∃ (h : L' a ⟶ l₁), f a ≫ h = g := by
      intro α _ l₀ L' f
      let O : Finset Λ := insert l₀ (Finset.univ.image L')
      have m₀ : l₀ ∈ O := Finset.mem_insert_self l₀ _
      have m' : ∀ a : α, L' a ∈ O := fun a =>
        Finset.mem_insert_of_mem (Finset.mem_image_of_mem L' (Finset.mem_univ a))
      let H : Finset ((X : Λ) ×' (Y : Λ) ×' (_ : X ∈ O) ×' (_ : Y ∈ O) ×' (X ⟶ Y)) :=
        Finset.univ.image (fun a : α => ⟨l₀, L' a, m₀, m' a, f a⟩)
      refine ⟨CategoryTheory.IsFiltered.sup O H, CategoryTheory.IsFiltered.toSup O H m₀, fun a => ?_⟩
      exact ⟨CategoryTheory.IsFiltered.toSup O H (m' a),
        CategoryTheory.IsFiltered.toSup_commutes O H m₀ (m' a)
          (Finset.mem_image_of_mem _ (Finset.mem_univ a))⟩
    let F_u := CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u}
    let F_forget := CategoryTheory.forget AddCommGrpCat.{u}
    let ev_set : C → ((Cᵒᵖ ⥤ AddCommGrpCat.{u}) ⥤ Type u) := fun Z =>
      ((CategoryTheory.evaluation Cᵒᵖ AddCommGrpCat.{u}).obj (Opposite.op Z)).comp F_forget
    have hColimIsSheaf : ∀ (c_psh : CategoryTheory.Limits.Cocone (D₀.comp F_u)),
        CategoryTheory.Limits.IsColimit c_psh →
        CategoryTheory.Presheaf.IsSheaf J c_psh.pt := by
      intro c_psh hc_psh
      let P_set : Cᵒᵖ ⥤ Type u := c_psh.pt.comp F_forget
      let D_set : Λ ⥤ Cᵒᵖ ⥤ Type u :=
        (D₀.comp F_u).comp ((CategoryTheory.Functor.whiskeringRight Cᵒᵖ AddCommGrpCat.{u} (Type u)).obj F_forget)
      have hc_Z : ∀ Z : C, CategoryTheory.Limits.IsColimit ((ev_set Z).mapCocone c_psh) :=
        fun Z => CategoryTheory.Limits.isColimitOfPreserves (ev_set Z) hc_psh
      have hTransfer : ∀ (Q : Cᵒᵖ ⥤ Type u),
          CategoryTheory.Presieve.IsSheaf K_fin.toGrothendieck Q →
          CategoryTheory.Presieve.IsSheaf J Q := by
        intro Q hQ
        rwa [← hK_eq]
      rw [CategoryTheory.Presheaf.isSheaf_iff_isSheaf_comp J c_psh.pt F_forget,
        CategoryTheory.isSheaf_iff_isSheaf_of_type]
      apply hTransfer P_set
      rw [CategoryTheory.Presieve.isSheaf_coverage K_fin]
      rintro B R ⟨⟨n, W, π, rfl⟩, hgen⟩
      have hSheaf_l : ∀ l : Λ,
          CategoryTheory.Presieve.IsSheafFor (D_set.obj l) (CategoryTheory.Presieve.ofArrows W π) := by
        intro l
        have hl1 : CategoryTheory.Presheaf.IsSheaf J (D_set.obj l) :=
          (CategoryTheory.Presheaf.isSheaf_iff_isSheaf_comp J (D₀.obj l).obj F_forget).mp (D₀.obj l).property
        have hl2 : CategoryTheory.Presieve.IsSheaf J (D_set.obj l) :=
          (CategoryTheory.isSheaf_iff_isSheaf_of_type J (D_set.obj l)).mp hl1
        exact hl2.isSheafFor _ hgen
      rw [CategoryTheory.Presieve.isSheafFor_arrows_iff_pullbacks P_set π]
      intro x hx
      
      have h_lift_i : ∀ i : Fin n,
          ∃ (l : Λ) (y : (D_set.obj l).obj (Opposite.op (W i))),
            (((ev_set (W i)).mapCocone c_psh).ι.app l) y = x i :=
        fun i => CategoryTheory.Limits.Types.jointly_surjective_of_isColimit (hc_Z (W i)) (x i)
      choose L y₀ hy₀ using h_lift_i
      obtain ⟨l₀, ⟨u₀⟩⟩ := hSupObj L
      let y₁ : ∀ i : Fin n, (D_set.obj l₀).obj (Opposite.op (W i)) :=
        fun i => ((D_set.map (u₀ i)).app (Opposite.op (W i))) (y₀ i)
      have hy₁ : ∀ i : Fin n, (((ev_set (W i)).mapCocone c_psh).ι.app l₀) (y₁ i) = x i := by
        intro i
        have hw := congrArg (fun k => k (y₀ i)) (((ev_set (W i)).mapCocone c_psh).w (u₀ i))
        exact hw.trans (hy₀ i)
      have h_pair_eq : ∀ p : Fin n × Fin n,
          let P_p := CategoryTheory.Limits.pullback (π p.1) (π p.2)
          let fst_p := CategoryTheory.Limits.pullback.fst (π p.1) (π p.2)
          let snd_p := CategoryTheory.Limits.pullback.snd (π p.1) (π p.2)
          ∃ (l' : Λ) (f : l₀ ⟶ l'),
            (((D₀.comp F_u).comp (ev_set P_p)).map f)
              (((D_set.obj l₀).map fst_p.op) (y₁ p.1)) =
            (((D₀.comp F_u).comp (ev_set P_p)).map f)
              (((D_set.obj l₀).map snd_p.op) (y₁ p.2)) := by
        intro p
        let P_p := CategoryTheory.Limits.pullback (π p.1) (π p.2)
        let fst_p := CategoryTheory.Limits.pullback.fst (π p.1) (π p.2)
        let snd_p := CategoryTheory.Limits.pullback.snd (π p.1) (π p.2)
        rw [← CategoryTheory.Limits.Types.FilteredColimit.isColimit_eq_iff' (hc_Z P_p)]
        have hnat1 := congrArg (fun k => F_forget.map k (y₁ p.1))
          ((c_psh.ι.app l₀).naturality fst_p.op)
        have hnat2 := congrArg (fun k => F_forget.map k (y₁ p.2))
          ((c_psh.ι.app l₀).naturality snd_p.op)
        change F_forget.map ((c_psh.ι.app l₀).app (Opposite.op P_p))
            (((D_set.obj l₀).map fst_p.op) (y₁ p.1)) =
          F_forget.map ((c_psh.ι.app l₀).app (Opposite.op P_p))
            (((D_set.obj l₀).map snd_p.op) (y₁ p.2))
        have h1 : F_forget.map ((c_psh.ι.app l₀).app (Opposite.op P_p))
            (((D_set.obj l₀).map fst_p.op) (y₁ p.1)) =
            (P_set.map fst_p.op) (x p.1) := by
          calc
            F_forget.map ((c_psh.ι.app l₀).app (Opposite.op P_p))
                (((D_set.obj l₀).map fst_p.op) (y₁ p.1))
              = F_forget.map (((D₀.obj l₀).obj.map fst_p.op) ≫
                  (c_psh.ι.app l₀).app (Opposite.op P_p)) (y₁ p.1) := by
                rw [F_forget.map_comp]; rfl
            _ = F_forget.map ((c_psh.ι.app l₀).app (Opposite.op (W p.1)) ≫
                  c_psh.pt.map fst_p.op) (y₁ p.1) := hnat1
            _ = (P_set.map fst_p.op) ((((ev_set (W p.1)).mapCocone c_psh).ι.app l₀) (y₁ p.1)) := by
                rw [F_forget.map_comp]; rfl
            _ = (P_set.map fst_p.op) (x p.1) := by rw [hy₁ p.1]
        have h2 : F_forget.map ((c_psh.ι.app l₀).app (Opposite.op P_p))
            (((D_set.obj l₀).map snd_p.op) (y₁ p.2)) =
            (P_set.map snd_p.op) (x p.2) := by
          calc
            F_forget.map ((c_psh.ι.app l₀).app (Opposite.op P_p))
                (((D_set.obj l₀).map snd_p.op) (y₁ p.2))
              = F_forget.map (((D₀.obj l₀).obj.map snd_p.op) ≫
                  (c_psh.ι.app l₀).app (Opposite.op P_p)) (y₁ p.2) := by
                rw [F_forget.map_comp]; rfl
            _ = F_forget.map ((c_psh.ι.app l₀).app (Opposite.op (W p.2)) ≫
                  c_psh.pt.map snd_p.op) (y₁ p.2) := hnat2
            _ = (P_set.map snd_p.op) ((((ev_set (W p.2)).mapCocone c_psh).ι.app l₀) (y₁ p.2)) := by
                rw [F_forget.map_comp]; rfl
            _ = (P_set.map snd_p.op) (x p.2) := by rw [hy₁ p.2]
        rw [h1, h2]
        exact hx p.1 p.2
      choose L' f_pair hf_pair using h_pair_eq
      obtain ⟨l₁, g, hg_fac⟩ := hSupHom l₀ L' f_pair
      let y₂ : ∀ i : Fin n, (D_set.obj l₁).obj (Opposite.op (W i)) :=
        fun i => ((D_set.map g).app (Opposite.op (W i))) (y₁ i)
      have hy₂_compat : CategoryTheory.Presieve.Arrows.PullbackCompatible (D_set.obj l₁) π y₂ := by
        intro i j
        let p : Fin n × Fin n := (i, j)
        let P_p := CategoryTheory.Limits.pullback (π i) (π j)
        let fst_p := CategoryTheory.Limits.pullback.fst (π i) (π j)
        let snd_p := CategoryTheory.Limits.pullback.snd (π i) (π j)
        obtain ⟨h_p, hfp_eq⟩ := hg_fac p
        have hnat_i := congrArg (fun k => k (y₁ i)) ((D_set.map g).naturality fst_p.op).symm
        have hnat_j := congrArg (fun k => k (y₁ j)) ((D_set.map g).naturality snd_p.op).symm
        have hcomp_p : (D_set.map g).app (Opposite.op P_p) =
            (D_set.map (f_pair p)).app (Opposite.op P_p) ≫ (D_set.map h_p).app (Opposite.op P_p) := by
          rw [← hfp_eq, D_set.map_comp, CategoryTheory.NatTrans.comp_app]
        calc
          ((D_set.obj l₁).map fst_p.op) (y₂ i)
            = ((D_set.map g).app (Opposite.op P_p)) (((D_set.obj l₀).map fst_p.op) (y₁ i)) := hnat_i
          _ = ((D_set.map h_p).app (Opposite.op P_p))
                (((D_set.map (f_pair p)).app (Opposite.op P_p))
                  (((D_set.obj l₀).map fst_p.op) (y₁ i))) := by
              rw [hcomp_p]; rfl
          _ = ((D_set.map h_p).app (Opposite.op P_p))
                (((D_set.map (f_pair p)).app (Opposite.op P_p))
                  (((D_set.obj l₀).map snd_p.op) (y₁ j))) := by
              exact congrArg (((D_set.map h_p).app (Opposite.op P_p)) ·) (hf_pair p)
          _ = ((D_set.map g).app (Opposite.op P_p)) (((D_set.obj l₀).map snd_p.op) (y₁ j)) := by
              rw [hcomp_p]; rfl
          _ = ((D_set.obj l₁).map snd_p.op) (y₂ j) := hnat_j.symm
      obtain ⟨t₁, ht₁, _⟩ :=
        (CategoryTheory.Presieve.isSheafFor_arrows_iff_pullbacks (D_set.obj l₁) π).mp
          (hSheaf_l l₁) y₂ hy₂_compat
      let t₀ : P_set.obj (Opposite.op B) := (((ev_set B).mapCocone c_psh).ι.app l₁) t₁
      have ht₀ : ∀ i : Fin n, (P_set.map (π i).op) t₀ = x i := by
        intro i
        have hnat := congrArg (fun k => F_forget.map k t₁)
          ((c_psh.ι.app l₁).naturality (π i).op).symm
        have hw := congrArg (fun k => k (y₁ i)) (((ev_set (W i)).mapCocone c_psh).w g)
        calc
          (P_set.map (π i).op) t₀
            = F_forget.map ((c_psh.ι.app l₁).app (Opposite.op B) ≫ c_psh.pt.map (π i).op) t₁ := by
                rw [F_forget.map_comp]; rfl
          _ = F_forget.map ((D₀.obj l₁).obj.map (π i).op ≫ (c_psh.ι.app l₁).app (Opposite.op (W i))) t₁ :=
                hnat
          _ = (((ev_set (W i)).mapCocone c_psh).ι.app l₁) (((D_set.obj l₁).map (π i).op) t₁) := by
                rw [F_forget.map_comp]; rfl
          _ = (((ev_set (W i)).mapCocone c_psh).ι.app l₁) (y₂ i) := by rw [ht₁ i]
          _ = (((ev_set (W i)).mapCocone c_psh).ι.app l₀) (y₁ i) := hw
          _ = x i := hy₁ i
      refine ⟨t₀, ht₀, ?_⟩
      
      intro t' ht'
      obtain ⟨l_a, s_a, hsa⟩ := CategoryTheory.Limits.Types.jointly_surjective_of_isColimit (hc_Z B) t'
      obtain ⟨l_b, s_b, hsb⟩ := CategoryTheory.Limits.Types.jointly_surjective_of_isColimit (hc_Z B) t₀
