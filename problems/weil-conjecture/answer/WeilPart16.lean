    let y₂ := weilEtaleBasePullExt.{u} (@hc_all) (@hr_all) hSite
      (p_i i₂) (p_i i₁) (AlgebraicGeometry.Spec.map (B.map θ₁₂)) hθ₁₂
      (weilFreeYonedaZ.{u} Z₀ (C 0)) G₀ (r + 1) y₁
    have hy₂_ker :
        (CategoryTheory.Abelian.Ext.mk₀ ((S₀.map pb₂).f)).comp y₂ (Nat.zero_add (r + 1)) = 0 := by
      change (CategoryTheory.Abelian.Ext.mk₀ (pb₂.map (ι 0))).comp y₂ (Nat.zero_add (r + 1)) = 0
      dsimp [y₂]
      rw [← (hMorNat (p_i i₂) (p_i i₁) (AlgebraicGeometry.Spec.map (B.map θ₁₂)) hθ₁₂ (ι 0)
        (CategoryTheory.CategoryStruct.id G₀) (r + 1)).1 y₁]
      exact hv₂
    obtain ⟨x'_2, hx'_2⟩ :=
      CategoryTheory.Abelian.Ext.contravariant_sequence_exact₂
        ((hSE 0).map_of_exact pb₂) (pb₂.obj G₀) y₂ hy₂_ker
    have hu₂ : CategoryTheory.CategoryStruct.comp (u_i i₂) (p_i i₂) = p_inf := by
      dsimp [u_i, p_i, p_inf]
      rw [← AlgebraicGeometry.Spec.map_comp, hf_inf i₂]
    have hu₁₂ : CategoryTheory.CategoryStruct.comp (u_i i₂)
        (AlgebraicGeometry.Spec.map (B.map θ₁₂)) = u_i i₁ := by
      dsimp [u_i]
      rw [← AlgebraicGeometry.Spec.map_comp, c.w θ₁₂]
    have hy₂_inf : weilEtaleBasePullExt.{u} (@hc_all) (@hr_all) hSite
        p_inf (p_i i₂) (u_i i₂) hu₂ (weilFreeYonedaZ.{u} Z₀ (C 0)) G₀ (r + 1) y₂ = y_inf := by
      dsimp [y₂]
      rw [hPullComp (p_i i₂) (p_i i₁) p_inf (AlgebraicGeometry.Spec.map (B.map θ₁₂))
        (u_i i₂) (u_i i₁) hu₁₂ hθ₁₂ hu₂ hu₁, hy₁]
    let x'_2_inf := weilEtaleBasePullExt.{u} (@hc_all) (@hr_all) hSite
      p_inf (p_i i₂) (u_i i₂) hu₂ (K 0) G₀ (r + 1) x'_2
    let δ_inf := x_inf - x'_2_inf
    let hS₀_inf := (hSE 0).map_of_exact pb_inf
    have hδ_ker :
        (CategoryTheory.Abelian.Ext.mk₀ (S₀.map pb_inf).g).comp δ_inf (Nat.zero_add (r + 1)) = 0 := by
      change (CategoryTheory.Abelian.Ext.mk₀ (pb_inf.map (π 0))).comp
        (x_inf - x'_2_inf) (Nat.zero_add (r + 1)) = 0
      rw [show (CategoryTheory.Abelian.Ext.mk₀ (pb_inf.map (π 0))).comp
          (x_inf - x'_2_inf) (Nat.zero_add (r + 1)) =
          y_inf - (CategoryTheory.Abelian.Ext.mk₀ (pb_inf.map (π 0))).comp
            x'_2_inf (Nat.zero_add (r + 1)) from
        map_sub ((CategoryTheory.Abelian.Ext.mk₀ (pb_inf.map (π 0))).precomp
          (pb_inf.obj G₀) (Nat.zero_add (r + 1))) x_inf x'_2_inf]
      dsimp [x'_2_inf]
      rw [← (hMorNat p_inf (p_i i₂) (u_i i₂) hu₂ (π 0)
        (CategoryTheory.CategoryStruct.id G₀) (r + 1)).1 x'_2]
      change y_inf - weilEtaleBasePullExt.{u} (@hc_all) (@hr_all) hSite
          p_inf (p_i i₂) (u_i i₂) hu₂ (weilFreeYonedaZ.{u} Z₀ (C 0)) G₀ (r + 1)
          ((CategoryTheory.Abelian.Ext.mk₀ (S₀.map pb₂).g).comp x'_2 (Nat.zero_add (r + 1))) = 0
      rw [hx'_2, hy₂_inf, sub_self]
    obtain ⟨z_inf, hz_inf⟩ :=
      CategoryTheory.Abelian.Ext.contravariant_sequence_exact₃
        hS₀_inf (pb_inf.obj G₀) δ_inf hδ_ker (Nat.one_add r)
    obtain ⟨i₃, hu₃, z₃, hz₃⟩ :=
      (hPrev ℐ B₀ B α c hc f_inf hf_inf (K 1) G₀ hResK₁).1 z_inf
    let i₄ := CategoryTheory.IsFiltered.max i₂ i₃
    let θ₂₄ : Quiver.Hom i₂ i₄ := CategoryTheory.IsFiltered.leftToMax i₂ i₃
    let θ₃₄ : Quiver.Hom i₃ i₄ := CategoryTheory.IsFiltered.rightToMax i₂ i₃
    have hθ₂₄ : CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (B.map θ₂₄)) (p_i i₂) = p_i i₄ := by
