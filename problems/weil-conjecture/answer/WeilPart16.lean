      (pb_π.obj F₀).H q →+ CategoryTheory.Abelian.Ext (pb_π.obj Fℤ₀) (pb_π.obj F₀) q :=
    fun {Y} π =>
      let pb_π := (weilEtaleSitePullback π).sheafPullback AddCommGrpCat.{u}
        X₀.smallEtaleTopology Y.smallEtaleTopology
      let cℤ := weilSliceColimConstZHom.{u} (@hc_all) (@hr_all) π
      (CategoryTheory.Abelian.Ext.mk₀ cℤ).precomp (pb_π.obj F₀) (Nat.zero_add q)
  have hto_from : ∀ {Y : AlgebraicGeometry.Scheme.{u}} (π : Quiver.Hom Y X₀)
      (x : (((weilEtaleSitePullback π).sheafPullback AddCommGrpCat.{u}
        X₀.smallEtaleTopology Y.smallEtaleTopology).obj F₀).H q),
      toH π (fromH π x) = x := by
    intro Y π x
    let cℤ := weilSliceColimConstZHom.{u} (@hc_all) (@hr_all) π
