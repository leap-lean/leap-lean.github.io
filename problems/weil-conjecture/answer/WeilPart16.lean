      · exact sup_le
          (le_iSup (fun i : Fin 2 => AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X i)) 0)
          (le_iSup (fun i : Fin 2 => AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X i)) 1)
      · refine iSup_le (fun i => ?_)
        fin_cases i
        · exact le_sup_left
        · exact le_sup_right
    exact ⟨U₀, U₁, hSup, hU₀, hU₁, hU₀₁⟩
  obtain ⟨U₀, U₁, hSup, hU₀, hU₁, hU₀₁⟩ := hCovP₁
  exact hGen P₁ U₀ U₁ hSup hU₀ hU₁ hU₀₁

theorem weil_etale_freeYoneda_coproduct_consolidation_and_pullback (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hSite : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (g : X₁ ⟶ X₂),
      letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) g :=
        CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
      letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) g :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
          (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
      let B_g : CategoryTheory.Functor X₂.Etale X₁.Etale :=
        CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ g
      ∃ (_ : B_g.IsContinuous X₂.smallEtaleTopology X₁.smallEtaleTopology)
        (_ : (B_g.sheafPushforwardContinuous AddCommGrpCat.{u}
          X₂.smallEtaleTopology X₁.smallEtaleTopology).IsRightAdjoint),
        let pb_g := B_g.sheafPullback AddCommGrpCat.{u} X₂.smallEtaleTopology X₁.smallEtaleTopology
        pb_g.Additive ∧
        CategoryTheory.Limits.PreservesFiniteLimits pb_g ∧
        CategoryTheory.Limits.PreservesFiniteColimits pb_g)
    {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (g : X₁ ⟶ X₂)
    {m n r : ℕ} (src_rel : Fin r → Fin m) (tgt_gen : Fin r → Fin n) (coeff : Fin r → ℤ)
    (V₂ : Fin m → X₂.Etale) (U₂ : Fin n → X₂.Etale)
    [∀ a, AlgebraicGeometry.IsAffine ((AlgebraicGeometry.Scheme.Etale.forget X₂).obj (V₂ a)).left]
    [∀ b, AlgebraicGeometry.IsAffine ((AlgebraicGeometry.Scheme.Etale.forget X₂).obj (U₂ b)).left]
    (V₁ : Fin m → X₁.Etale) (U₁ : Fin n → X₁.Etale)
    (u₂ : ∀ t : Fin r, V₂ (src_rel t) ⟶ U₂ (tgt_gen t))
    (u₁ : ∀ t : Fin r, V₁ (src_rel t) ⟶ U₁ (tgt_gen t)) :
    let A_ℓ := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))
    letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) g :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) g :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B_g : CategoryTheory.Functor X₂.Etale X₁.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ g
    (∃ (eV : ∀ a : Fin m, B_g.obj (V₂ a) ≅ V₁ a)
        (eU : ∀ b : Fin n, B_g.obj (U₂ b) ≅ U₁ b),
      ∀ t : Fin r,
        B_g.map (u₂ t) ≫ (eU (tgt_gen t)).hom = (eV (src_rel t)).hom ≫ u₁ t) →
    letI : CategoryTheory.Limits.HasFiniteBiproducts
        (CategoryTheory.Sheaf X₁.smallEtaleTopology AddCommGrpCat.{u}) :=
      CategoryTheory.Abelian.hasFiniteBiproducts
    let L₁ := fun E : X₁.Etale => CategoryTheory.Sheaf.freeYoneda X₁.smallEtaleTopology E A_ℓ
    let map₁ := fun {E₁ E₂ : X₁.Etale} (u : E₁ ⟶ E₂) =>
      CategoryTheory.Sheaf.freeYonedaHomEquiv.symm
        (CategoryTheory.CategoryStruct.comp
          (CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id (L₁ E₂)))
          ((L₁ E₂).obj.map (Opposite.op u)))
    let Θ₁ : (⨁ fun a : Fin m => L₁ (V₁ a)) ⟶ (⨁ fun b : Fin n => L₁ (U₁ b)) :=
      ∑ t : Fin r, coeff t •
        (CategoryTheory.Limits.biproduct.π (fun a : Fin m => L₁ (V₁ a)) (src_rel t) ≫
          map₁ (u₁ t) ≫
          CategoryTheory.Limits.biproduct.ι (fun b : Fin n => L₁ (U₁ b)) (tgt_gen t))
    ℓ • CategoryTheory.CategoryStruct.id (CategoryTheory.Limits.cokernel Θ₁) = 0 ∧
    ∃ (V_tot U_tot : X₂.Etale)
      (_ : AlgebraicGeometry.IsAffine ((AlgebraicGeometry.Scheme.Etale.forget X₂).obj V_tot).left)
      (_ : AlgebraicGeometry.IsAffine ((AlgebraicGeometry.Scheme.Etale.forget X₂).obj U_tot).left)
      (θ₂ : CategoryTheory.Sheaf.freeYoneda X₂.smallEtaleTopology V_tot A_ℓ ⟶
        CategoryTheory.Sheaf.freeYoneda X₂.smallEtaleTopology U_tot A_ℓ),
      WeilIsEtaleSheafPullback g (CategoryTheory.Limits.cokernel θ₂)
        (CategoryTheory.Limits.cokernel Θ₁) :=
by
  intro A_ℓ B_g ⟨eV, eU, he_comm⟩ L₁ map₁ Θ₁
  let _ : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) g :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  let _ : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) g :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let _ : CategoryTheory.Limits.HasFiniteBiproducts
      (CategoryTheory.Sheaf X₁.smallEtaleTopology AddCommGrpCat.{u}) :=
    CategoryTheory.Abelian.hasFiniteBiproducts
  let _ : CategoryTheory.Limits.HasFiniteBiproducts
      (CategoryTheory.Sheaf X₂.smallEtaleTopology AddCommGrpCat.{u}) :=
    CategoryTheory.Abelian.hasFiniteBiproducts
  let L₂ := fun E : X₂.Etale => CategoryTheory.Sheaf.freeYoneda X₂.smallEtaleTopology E A_ℓ
  let map₂ := fun {E₁ E₂ : X₂.Etale} (u : E₁ ⟶ E₂) =>
    CategoryTheory.Sheaf.freeYonedaHomEquiv.symm
      (CategoryTheory.CategoryStruct.comp
        (CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id (L₂ E₂)))
        ((L₂ E₂).obj.map (Opposite.op u)))

  
  have hFY_comp : ∀ {C : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C]
      (J : CategoryTheory.GrothendieckTopology C)
      [CategoryTheory.HasWeakSheafify J AddCommGrpCat.{u}]
      {E : C} {F G : CategoryTheory.Sheaf J AddCommGrpCat.{u}}
      (β : CategoryTheory.Sheaf.freeYoneda J E A_ℓ ⟶ F) (φ : F ⟶ G),
      CategoryTheory.Sheaf.freeYonedaHomEquiv (β ≫ φ) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv β ≫ φ.hom.app (Opposite.op E) := by
    intro C _ J _ E F G β φ
    unfold CategoryTheory.Sheaf.freeYoneda CategoryTheory.Sheaf.freeYonedaHomEquiv at *
    simp only [Equiv.trans_apply]
    rw [CategoryTheory.Adjunction.homEquiv_naturality_right,
      CategoryTheory.Presheaf.freeYonedaHomEquiv_comp]
    rfl

  have hFY_map_comp : ∀ {C : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C]
      (J : CategoryTheory.GrothendieckTopology C)
      [CategoryTheory.HasWeakSheafify J AddCommGrpCat.{u}]
      {E₁ E₂ : C} (u : E₁ ⟶ E₂) {G : CategoryTheory.Sheaf J AddCommGrpCat.{u}}
      (f : CategoryTheory.Sheaf.freeYoneda J E₂ A_ℓ ⟶ G),
      CategoryTheory.Sheaf.freeYonedaHomEquiv
        (CategoryTheory.Sheaf.freeYonedaHomEquiv.symm
          (CategoryTheory.Sheaf.freeYonedaHomEquiv
            (CategoryTheory.CategoryStruct.id (CategoryTheory.Sheaf.freeYoneda J E₂ A_ℓ)) ≫
            (CategoryTheory.Sheaf.freeYoneda J E₂ A_ℓ).obj.map (Opposite.op u)) ≫ f) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv f ≫ G.obj.map (Opposite.op u) := by
    intro C _ J _ E₁ E₂ u G f
    rw [hFY_comp, Equiv.apply_symm_apply, CategoryTheory.Category.assoc, f.hom.naturality,
      ← CategoryTheory.Category.assoc, ← hFY_comp, CategoryTheory.Category.id_comp]

  
  have hA_nsmul : ∀ (k : ℕ) (x : ZMod ℓ),
      ((k • CategoryTheory.CategoryStruct.id A_ℓ) (ULift.up x)).down = k • x := by
    intro k x
    induction k with
    | zero =>
      rw [zero_nsmul, zero_nsmul]
      rfl
    | succ k ih =>
      rw [succ_nsmul, succ_nsmul]
      change ((k • CategoryTheory.CategoryStruct.id A_ℓ) (ULift.up x)).down +
        (CategoryTheory.CategoryStruct.id A_ℓ (ULift.up x)).down = k • x + x
      rw [ih]
      rfl

  have hA_tor : ℓ • CategoryTheory.CategoryStruct.id A_ℓ = 0 := by
    ext ⟨x⟩
    apply ULift.ext
    rw [hA_nsmul ℓ x, nsmul_eq_mul, CharP.cast_eq_zero, zero_mul]
    rfl

  have hApp_nsmul : ∀ (E : X₁.Etale) (k : ℕ) (f : L₁ E ⟶ L₁ E),
      (k • f).hom.app (Opposite.op E) = k • (f.hom.app (Opposite.op E)) := by
    intro E k f
    induction k with
    | zero =>
      rw [zero_nsmul, zero_nsmul]
      rfl
    | succ k ih =>
      rw [succ_nsmul, succ_nsmul, CategoryTheory.Sheaf.Hom.add_app, ih]

  have hL₁_tor : ∀ E : X₁.Etale, ℓ • CategoryTheory.CategoryStruct.id (L₁ E) = 0 := by
    intro E
    apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
    have h1 : CategoryTheory.Sheaf.freeYonedaHomEquiv
        (ℓ • CategoryTheory.CategoryStruct.id (L₁ E)) = 0 := by
      calc
        CategoryTheory.Sheaf.freeYonedaHomEquiv (ℓ • CategoryTheory.CategoryStruct.id (L₁ E))
            = CategoryTheory.Sheaf.freeYonedaHomEquiv
                (CategoryTheory.CategoryStruct.id (L₁ E) ≫
                  (ℓ • CategoryTheory.CategoryStruct.id (L₁ E))) := by
              rw [CategoryTheory.Category.id_comp]
        _ = CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id (L₁ E)) ≫
              (ℓ • CategoryTheory.CategoryStruct.id (L₁ E)).hom.app (Opposite.op E) :=
              hFY_comp X₁.smallEtaleTopology _ _
        _ = CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id (L₁ E)) ≫
              (ℓ • (CategoryTheory.CategoryStruct.id (L₁ E)).hom.app (Opposite.op E)) := by
              rw [hApp_nsmul]
        _ = ℓ • (CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id (L₁ E)) ≫
              (CategoryTheory.CategoryStruct.id (L₁ E)).hom.app (Opposite.op E)) :=
              CategoryTheory.Preadditive.comp_nsmul _ _ ℓ
        _ = ℓ • (CategoryTheory.CategoryStruct.id A_ℓ ≫
              (CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id (L₁ E)) ≫
                (CategoryTheory.CategoryStruct.id (L₁ E)).hom.app (Opposite.op E))) := by
              rw [CategoryTheory.Category.id_comp]
        _ = (ℓ • CategoryTheory.CategoryStruct.id A_ℓ) ≫
              (CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id (L₁ E)) ≫
                (CategoryTheory.CategoryStruct.id (L₁ E)).hom.app (Opposite.op E)) :=
              (CategoryTheory.Preadditive.nsmul_comp _ _ ℓ).symm
        _ = 0 := by rw [hA_tor, CategoryTheory.Limits.zero_comp]
    have h0 : CategoryTheory.Sheaf.freeYonedaHomEquiv (0 : L₁ E ⟶ L₁ E) = 0 := by
      calc
        CategoryTheory.Sheaf.freeYonedaHomEquiv (0 : L₁ E ⟶ L₁ E)
            = CategoryTheory.Sheaf.freeYonedaHomEquiv
                (CategoryTheory.CategoryStruct.id (L₁ E) ≫ (0 : L₁ E ⟶ L₁ E)) := by
              rw [CategoryTheory.Limits.comp_zero]
        _ = CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id (L₁ E)) ≫
              (0 : L₁ E ⟶ L₁ E).hom.app (Opposite.op E) :=
              hFY_comp X₁.smallEtaleTopology _ _
        _ = CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id (L₁ E)) ≫ 0 :=
              rfl
        _ = 0 := CategoryTheory.Limits.comp_zero
    exact h1.trans h0.symm

  have hBip_tor : ℓ • CategoryTheory.CategoryStruct.id (⨁ fun b : Fin n => L₁ (U₁ b)) = 0 := by
    apply CategoryTheory.Limits.biproduct.hom_ext'
    intro b
    rw [CategoryTheory.Preadditive.comp_nsmul, CategoryTheory.Category.comp_id,
      ← CategoryTheory.Category.id_comp
        (CategoryTheory.Limits.biproduct.ι (fun b : Fin n => L₁ (U₁ b)) b),
      ← CategoryTheory.Preadditive.nsmul_comp, hL₁_tor (U₁ b),
      CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.comp_zero]

  have hCok_tor : ℓ • CategoryTheory.CategoryStruct.id (CategoryTheory.Limits.cokernel Θ₁) = 0 := by
    apply (CategoryTheory.cancel_epi (CategoryTheory.Limits.cokernel.π Θ₁)).mp
    rw [CategoryTheory.Preadditive.comp_nsmul, CategoryTheory.Category.comp_id,
      ← CategoryTheory.Category.id_comp (CategoryTheory.Limits.cokernel.π Θ₁),
      ← CategoryTheory.Preadditive.nsmul_comp, hBip_tor,
      CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.comp_zero]

  
  let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
    @AlgebraicGeometry.Etale.{u}
  have hMem_etale : ∀ {Z : X₂.Etale} (S : CategoryTheory.Sieve Z),
      (∀ x : ↥Z.left, ∃ (Y₀ : X₂.Etale) (f : Y₀ ⟶ Z) (y : ↥Y₀.left),
        S.arrows f ∧ AlgebraicGeometry.Etale f.left ∧ f.left y = x) →
      S ∈ X₂.smallEtaleTopology Z := by
    intro Z S h
    have hTop_eq : AlgebraicGeometry.Scheme.smallGrothendieckTopology P_et X₂ =
        (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) X₂ le_rfl
    let Z' : P_et.Over ⊤ X₂ := Z
    let S' : CategoryTheory.Sieve Z' := S
    have hmem' : S' ∈ (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck Z' :=
      (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology Z' S').mpr h
    change S' ∈ (AlgebraicGeometry.Scheme.smallGrothendieckTopology P_et X₂) Z'
    rwa [hTop_eq]

  have hConsolidate : ∀ (k : ℕ) (W : Fin k → X₂.Etale)
      [∀ i, AlgebraicGeometry.IsAffine ((AlgebraicGeometry.Scheme.Etale.forget X₂).obj (W i)).left],
      ∃ (W_tot : X₂.Etale)
        (_ : AlgebraicGeometry.IsAffine ((AlgebraicGeometry.Scheme.Etale.forget X₂).obj W_tot).left),
        Nonempty ((⨁ fun i : Fin k => L₂ (W i)) ≅ L₂ W_tot) := by
    intro k W hAffW
    let Y : Fin k → AlgebraicGeometry.Scheme.{u} :=
      fun i => ((AlgebraicGeometry.Scheme.Etale.forget X₂).obj (W i)).left
    have _ : AlgebraicGeometry.IsZariskiLocalAtSource (@AlgebraicGeometry.Etale) :=
      @AlgebraicGeometry.HasRingHomProperty.instIsZariskiLocalAtSource
        (@AlgebraicGeometry.Etale)
        (fun {R S} [CommRing R] [CommRing S] φ => φ.Etale) inferInstance
    let W_sch : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.sigmaObj Y
    let w_hom : W_sch ⟶ X₂ := CategoryTheory.Limits.Sigma.desc (fun i : Fin k => (W i).hom)
    have hEt_w : AlgebraicGeometry.Etale w_hom :=
      AlgebraicGeometry.IsZariskiLocalAtSource.sigmaDesc (fun i => (W i).prop)
    let W_tot : X₂.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ w_hom hEt_w
    let Y_u : ULift.{u, 0} (Fin k) → AlgebraicGeometry.Scheme.{u} := fun j => Y j.down
    let R_ring : ULift.{u, 0} (Fin k) → CommRingCat.{u} :=
      fun j => (Y_u j).presheaf.obj (Opposite.op ⊤)
    let e_ulift : W_sch ≅ ∐ Y_u :=
      { hom := CategoryTheory.Limits.Sigma.desc
          (fun i : Fin k => CategoryTheory.Limits.Sigma.ι Y_u (ULift.up i))
        inv := CategoryTheory.Limits.Sigma.desc
          (fun j : ULift.{u, 0} (Fin k) => CategoryTheory.Limits.Sigma.ι Y j.down)
        hom_inv_id := by
          apply CategoryTheory.Limits.Sigma.hom_ext
          intro i
          rw [CategoryTheory.Limits.Sigma.ι_comp_desc_assoc,
            CategoryTheory.Limits.Sigma.ι_comp_desc,
            CategoryTheory.Category.comp_id]
        inv_hom_id := by
          apply CategoryTheory.Limits.Sigma.hom_ext
          rintro ⟨i⟩
          rw [CategoryTheory.Limits.Sigma.ι_comp_desc_assoc,
            CategoryTheory.Limits.Sigma.ι_comp_desc,
            CategoryTheory.Category.comp_id] }
    let e_spec : ∐ Y_u ≅ ∐ (fun j : ULift.{u, 0} (Fin k) => AlgebraicGeometry.Spec (R_ring j)) :=
      CategoryTheory.Limits.Sigma.mapIso (fun j => (Y_u j).isoSpec)
    have hIso_sigma : CategoryTheory.IsIso (AlgebraicGeometry.sigmaSpec R_ring) :=
      AlgebraicGeometry.instIsIsoSchemeSigmaSpecOfFinite R_ring
    let e_aff : W_sch ≅
        AlgebraicGeometry.Spec (CommRingCat.of (∀ j : ULift.{u, 0} (Fin k), R_ring j)) :=
      e_ulift.trans
        (e_spec.trans (@CategoryTheory.asIso _ _ _ _ (AlgebraicGeometry.sigmaSpec R_ring) hIso_sigma))
    have hAff_tot : AlgebraicGeometry.IsAffine
        ((AlgebraicGeometry.Scheme.Etale.forget X₂).obj W_tot).left :=
      @AlgebraicGeometry.IsAffine.of_isIso _ _ e_aff.hom e_aff.isIso_hom inferInstance
    let ι : ∀ i : Fin k, W i ⟶ W_tot := fun i =>
      CategoryTheory.MorphismProperty.Over.homMk
        (CategoryTheory.Limits.Sigma.ι Y i)
        (CategoryTheory.Limits.Sigma.ι_comp_desc (fun j => (W j).hom) i)
    have hCov_tot : CategoryTheory.Sieve.ofArrows W ι ∈ X₂.smallEtaleTopology W_tot := by
      apply hMem_etale
      intro (x : ↥(∐ Y))
      let cov := AlgebraicGeometry.sigmaOpenCover Y
      let i : Fin k := cov.idx x
      have hmem : x ∈ Set.range ⇑(cov.f i) := cov.covers x
      change x ∈ Set.range ⇑(CategoryTheory.Limits.Sigma.ι Y i) at hmem
      obtain ⟨y, hy⟩ := hmem
      exact ⟨W i, ι i, y, CategoryTheory.Sieve.ofArrows_mk W ι i, inferInstance, hy⟩
    have hCov_empty : ∀ (Z : X₂.Etale) [IsEmpty ↥Z.left],
        CategoryTheory.Sieve.ofArrows (Empty.elim : Empty → X₂.Etale) (fun e => Empty.elim e) ∈
          X₂.smallEtaleTopology Z := by
      intro Z _
      apply hMem_etale
      intro z
      exact isEmptyElim z
    let e_hom : (⨁ fun i : Fin k => L₂ (W i)) ⟶ L₂ W_tot :=
      CategoryTheory.Limits.biproduct.desc (fun i => map₂ (ι i))
    have _hIso_ehom : CategoryTheory.IsIso e_hom := by
      apply CategoryTheory.isIso_of_coyoneda_map_bijective
      intro G
      have hCompat : ∀ (x : ∀ i : Fin k, A_ℓ ⟶ G.obj.obj (Opposite.op (W i)))
          ⦃Z : X₂.Etale⦄ ⦃i j : Fin k⦄ (a : Z ⟶ W i) (b : Z ⟶ W j),
          a ≫ ι i = b ≫ ι j →
          x i ≫ G.obj.map a.op = x j ≫ G.obj.map b.op := by
        intro x Z i j a b hab
        have hab_left : a.left ≫ CategoryTheory.Limits.Sigma.ι Y i =
            b.left ≫ CategoryTheory.Limits.Sigma.ι Y j :=
          congrArg (·.left) hab
        by_cases hij : i = j
        · subst hij
          have ha_eq : a = b :=
            CategoryTheory.MorphismProperty.Over.Hom.ext
              ((CategoryTheory.cancel_mono (CategoryTheory.Limits.Sigma.ι Y i)).mp hab_left)
          rw [ha_eq]
        · have h_disj : Disjoint
              (Set.range ⇑(CategoryTheory.Limits.Sigma.ι Y i))
              (Set.range ⇑(CategoryTheory.Limits.Sigma.ι Y j)) := by
            rw [← AlgebraicGeometry.Scheme.Hom.coe_opensRange,
              ← AlgebraicGeometry.Scheme.Hom.coe_opensRange,
              TopologicalSpace.Opens.coe_disjoint]
            exact AlgebraicGeometry.disjoint_opensRange_sigmaι Y i j hij
          have _ : IsEmpty ↥Z.left :=
            AlgebraicGeometry.Scheme.isEmpty_of_commSq ⟨hab_left⟩ h_disj
          have hUniq := G.property.existsUnique_amalgamation_ofArrows (E := A_ℓ)
            (fun e : Empty => Empty.elim e) (hCov_empty Z)
            (fun e : Empty => Empty.elim e) (fun _ e _ _ _ _ => Empty.elim e)
          exact hUniq.unique (fun e => Empty.elim e) (fun e => Empty.elim e)
      constructor
      · intro g₁ g₂ hg
        dsimp only at hg
        apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
        have hUniq := G.property.existsUnique_amalgamation_ofArrows ι hCov_tot
          (fun i => CategoryTheory.Sheaf.freeYonedaHomEquiv g₁ ≫ G.obj.map (ι i).op)
          (hCompat _)
        refine hUniq.unique (fun _ => rfl) (fun i => ?_)
        have hi : map₂ (ι i) ≫ g₂ = map₂ (ι i) ≫ g₁ := by
          calc
            map₂ (ι i) ≫ g₂
                = CategoryTheory.Limits.biproduct.ι (fun j => L₂ (W j)) i ≫ (e_hom ≫ g₂) := by
              rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.biproduct.ι_desc]
            _ = CategoryTheory.Limits.biproduct.ι (fun j => L₂ (W j)) i ≫ (e_hom ≫ g₁) := by
              rw [hg]
            _ = map₂ (ι i) ≫ g₁ := by
              rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.biproduct.ι_desc]
        calc
          CategoryTheory.Sheaf.freeYonedaHomEquiv g₂ ≫ G.obj.map (ι i).op
              = CategoryTheory.Sheaf.freeYonedaHomEquiv (map₂ (ι i) ≫ g₂) :=
                (hFY_map_comp X₂.smallEtaleTopology (ι i) g₂).symm
          _ = CategoryTheory.Sheaf.freeYonedaHomEquiv (map₂ (ι i) ≫ g₁) := by rw [hi]
          _ = CategoryTheory.Sheaf.freeYonedaHomEquiv g₁ ≫ G.obj.map (ι i).op :=
                hFY_map_comp X₂.smallEtaleTopology (ι i) g₁
      · intro h
        let x : ∀ i : Fin k, A_ℓ ⟶ G.obj.obj (Opposite.op (W i)) :=
          fun i => CategoryTheory.Sheaf.freeYonedaHomEquiv
            (CategoryTheory.Limits.biproduct.ι (fun j => L₂ (W j)) i ≫ h)
        obtain ⟨g₀, hg₀, -⟩ :=
          G.property.existsUnique_amalgamation_ofArrows ι hCov_tot x (hCompat x)
        refine ⟨CategoryTheory.Sheaf.freeYonedaHomEquiv.symm g₀, ?_⟩
        apply CategoryTheory.Limits.biproduct.hom_ext'
        intro i
        apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
        rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.biproduct.ι_desc]
        calc
          CategoryTheory.Sheaf.freeYonedaHomEquiv
              (map₂ (ι i) ≫ CategoryTheory.Sheaf.freeYonedaHomEquiv.symm g₀)
              = CategoryTheory.Sheaf.freeYonedaHomEquiv
                  (CategoryTheory.Sheaf.freeYonedaHomEquiv.symm g₀) ≫ G.obj.map (ι i).op :=
                hFY_map_comp X₂.smallEtaleTopology (ι i) _
          _ = g₀ ≫ G.obj.map (ι i).op := by rw [Equiv.apply_symm_apply]
          _ = x i := hg₀ i
    exact ⟨W_tot, hAff_tot, ⟨CategoryTheory.asIso e_hom⟩⟩

  
  have hMap₁_id : ∀ E : X₁.Etale,
      map₁ (CategoryTheory.CategoryStruct.id E) = CategoryTheory.CategoryStruct.id (L₁ E) := by
    intro E
    apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
    dsimp [map₁]
    rw [Equiv.apply_symm_apply]
    change CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id (L₁ E)) ≫
      (L₁ E).obj.map (CategoryTheory.CategoryStruct.id (Opposite.op E)) =
      CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id (L₁ E))
    rw [CategoryTheory.Functor.map_id, CategoryTheory.Category.comp_id]

  have hMap₁_comp : ∀ {E₁ E₂ E₃ : X₁.Etale} (u : E₁ ⟶ E₂) (v : E₂ ⟶ E₃),
      map₁ (u ≫ v) = map₁ u ≫ map₁ v := by
    intro E₁ E₂ E₃ u v
    apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
    have hRHS := hFY_map_comp X₁.smallEtaleTopology u (map₁ v)
    change CategoryTheory.Sheaf.freeYonedaHomEquiv (map₁ (u ≫ v)) =
      CategoryTheory.Sheaf.freeYonedaHomEquiv (map₁ u ≫ map₁ v)
    rw [hRHS]
    dsimp [map₁]
    rw [Equiv.apply_symm_apply, Equiv.apply_symm_apply]
    change CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id (L₁ E₃)) ≫
        (L₁ E₃).obj.map (Opposite.op v ≫ Opposite.op u) =
      (CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id (L₁ E₃)) ≫
        (L₁ E₃).obj.map (Opposite.op v)) ≫ (L₁ E₃).obj.map (Opposite.op u)
    rw [CategoryTheory.Functor.map_comp, CategoryTheory.Category.assoc]

  let mapIso₁ : ∀ {E₁ E₂ : X₁.Etale}, (E₁ ≅ E₂) → (L₁ E₁ ≅ L₁ E₂) := fun e =>
    { hom := map₁ e.hom
      inv := map₁ e.inv
      hom_inv_id := (hMap₁_comp e.hom e.inv).symm.trans
        ((congrArg map₁ e.hom_inv_id).trans (hMap₁_id _))
      inv_hom_id := (hMap₁_comp e.inv e.hom).symm.trans
        ((congrArg map₁ e.inv_hom_id).trans (hMap₁_id _)) }

  obtain ⟨hc, hr, hAdd, _hLim, hColim⟩ := hSite g
  have _ := hc
  have _ := hr
  let pb_g := B_g.sheafPullback AddCommGrpCat.{u} X₂.smallEtaleTopology X₁.smallEtaleTopology
  let pf_g := B_g.sheafPushforwardContinuous AddCommGrpCat.{u}
    X₂.smallEtaleTopology X₁.smallEtaleTopology
  let adj_g := B_g.sheafAdjunctionContinuous AddCommGrpCat.{u}
    X₂.smallEtaleTopology X₁.smallEtaleTopology
  have _ : pb_g.Additive := hAdd
  have _ : CategoryTheory.Limits.PreservesFiniteColimits pb_g := hColim

  let α_hom : ∀ E : X₂.Etale, pb_g.obj (L₂ E) ⟶ L₁ (B_g.obj E) := fun E =>
    let η₁ : A_ℓ ⟶ (L₁ (B_g.obj E)).obj.obj (Opposite.op (B_g.obj E)) :=
      CategoryTheory.Sheaf.freeYonedaHomEquiv
        (CategoryTheory.CategoryStruct.id (L₁ (B_g.obj E)))
    (adj_g.homEquiv (L₂ E) (L₁ (B_g.obj E))).symm
      (CategoryTheory.Sheaf.freeYonedaHomEquiv.symm
        (η₁ : A_ℓ ⟶ (pf_g.obj (L₁ (B_g.obj E))).obj.obj (Opposite.op E)))

  let α_inv : ∀ E : X₂.Etale, L₁ (B_g.obj E) ⟶ pb_g.obj (L₂ E) := fun E =>
    let η₂ : A_ℓ ⟶ (pf_g.obj (pb_g.obj (L₂ E))).obj.obj (Opposite.op E) :=
      CategoryTheory.Sheaf.freeYonedaHomEquiv
        ((adj_g.homEquiv (L₂ E) (pb_g.obj (L₂ E)))
          (CategoryTheory.CategoryStruct.id (pb_g.obj (L₂ E))))
    CategoryTheory.Sheaf.freeYonedaHomEquiv.symm
      (η₂ : A_ℓ ⟶ (pb_g.obj (L₂ E)).obj.obj (Opposite.op (B_g.obj E)))

  have hα_hom_eval : ∀ E : X₂.Etale,
      CategoryTheory.Sheaf.freeYonedaHomEquiv
        ((adj_g.homEquiv (L₂ E) (L₁ (B_g.obj E))) (α_hom E)) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv
          (CategoryTheory.CategoryStruct.id (L₁ (B_g.obj E))) := by
    intro E
    dsimp only [α_hom]
    rw [Equiv.apply_symm_apply]
    exact CategoryTheory.Sheaf.freeYonedaHomEquiv.apply_symm_apply _

  have hα_inv_eval : ∀ E : X₂.Etale,
      CategoryTheory.Sheaf.freeYonedaHomEquiv (α_inv E) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv
          ((adj_g.homEquiv (L₂ E) (pb_g.obj (L₂ E)))
            (CategoryTheory.CategoryStruct.id (pb_g.obj (L₂ E)))) := by
    intro E
    dsimp only [α_inv]
    exact CategoryTheory.Sheaf.freeYonedaHomEquiv.apply_symm_apply _

  let α : ∀ E : X₂.Etale, pb_g.obj (L₂ E) ≅ L₁ (B_g.obj E) := fun E =>
    { hom := α_hom E
      inv := α_inv E
      hom_inv_id := by
        apply (adj_g.homEquiv (L₂ E) (pb_g.obj (L₂ E))).injective
        apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
        rw [CategoryTheory.Adjunction.homEquiv_naturality_right,
          hFY_comp X₂.smallEtaleTopology, hα_hom_eval E]
        change CategoryTheory.Sheaf.freeYonedaHomEquiv
            (CategoryTheory.CategoryStruct.id (L₁ (B_g.obj E))) ≫
            (α_inv E).hom.app (Opposite.op (B_g.obj E)) = _
        rw [← hFY_comp X₁.smallEtaleTopology, CategoryTheory.Category.id_comp]
        exact hα_inv_eval E
      inv_hom_id := by
        apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
        rw [hFY_comp X₁.smallEtaleTopology, hα_inv_eval E]
        change CategoryTheory.Sheaf.freeYonedaHomEquiv
            ((adj_g.homEquiv (L₂ E) (pb_g.obj (L₂ E)))
              (CategoryTheory.CategoryStruct.id (pb_g.obj (L₂ E)))) ≫
            (pf_g.map (α_hom E)).hom.app (Opposite.op E) = _
        rw [← hFY_comp X₂.smallEtaleTopology,
          ← CategoryTheory.Adjunction.homEquiv_naturality_right,
          CategoryTheory.Category.id_comp]
        exact hα_hom_eval E }

  have hα_nat : ∀ {E₁ E₂ : X₂.Etale} (u : E₁ ⟶ E₂),
      pb_g.map (map₂ u) ≫ (α E₂).hom = (α E₁).hom ≫ map₁ (B_g.map u) := by
    intro E₁ E₂ u
    dsimp only [α]
    apply (adj_g.homEquiv (L₂ E₁) (L₁ (B_g.obj E₂))).injective
    apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
    have hLHS : CategoryTheory.Sheaf.freeYonedaHomEquiv
        ((adj_g.homEquiv (L₂ E₁) (L₁ (B_g.obj E₂))) (pb_g.map (map₂ u) ≫ α_hom E₂)) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv
          (CategoryTheory.CategoryStruct.id (L₁ (B_g.obj E₂))) ≫
          (L₁ (B_g.obj E₂)).obj.map (Opposite.op (B_g.map u)) := by
      rw [CategoryTheory.Adjunction.homEquiv_naturality_left,
        hFY_map_comp X₂.smallEtaleTopology u, hα_hom_eval E₂]
      rfl
    have hRHS : CategoryTheory.Sheaf.freeYonedaHomEquiv
        ((adj_g.homEquiv (L₂ E₁) (L₁ (B_g.obj E₂))) (α_hom E₁ ≫ map₁ (B_g.map u))) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv
          (CategoryTheory.CategoryStruct.id (L₁ (B_g.obj E₂))) ≫
          (L₁ (B_g.obj E₂)).obj.map (Opposite.op (B_g.map u)) := by
      rw [CategoryTheory.Adjunction.homEquiv_naturality_right,
        hFY_comp X₂.smallEtaleTopology, hα_hom_eval E₁]
      change CategoryTheory.Sheaf.freeYonedaHomEquiv
          (CategoryTheory.CategoryStruct.id (L₁ (B_g.obj E₁))) ≫
          (map₁ (B_g.map u)).hom.app (Opposite.op (B_g.obj E₁)) = _
      rw [← hFY_comp X₁.smallEtaleTopology, CategoryTheory.Category.id_comp]
      exact CategoryTheory.Sheaf.freeYonedaHomEquiv.apply_symm_apply _
    exact hLHS.trans hRHS.symm

  
  let P₂ : Fin m → CategoryTheory.Sheaf X₂.smallEtaleTopology AddCommGrpCat.{u} :=
    fun a => L₂ (V₂ a)
  let Q₂ : Fin n → CategoryTheory.Sheaf X₂.smallEtaleTopology AddCommGrpCat.{u} :=
    fun b => L₂ (U₂ b)
  let P₁ : Fin m → CategoryTheory.Sheaf X₁.smallEtaleTopology AddCommGrpCat.{u} :=
    fun a => L₁ (V₁ a)
  let Q₁ : Fin n → CategoryTheory.Sheaf X₁.smallEtaleTopology AddCommGrpCat.{u} :=
    fun b => L₁ (U₁ b)
  let eP : ∀ a : Fin m, pb_g.obj (P₂ a) ≅ P₁ a :=
    fun a => (α (V₂ a)).trans (mapIso₁ (eV a))
  let eQ : ∀ b : Fin n, pb_g.obj (Q₂ b) ≅ Q₁ b :=
    fun b => (α (U₂ b)).trans (mapIso₁ (eU b))
  have hComm_PQ : ∀ t : Fin r,
      pb_g.map (map₂ (u₂ t)) ≫ (eQ (tgt_gen t)).hom =
        (eP (src_rel t)).hom ≫ map₁ (u₁ t) := by
    intro t
    dsimp [eP, eQ, mapIso₁]
    rw [← CategoryTheory.Category.assoc, hα_nat (u₂ t),
      CategoryTheory.Category.assoc, ← hMap₁_comp, he_comm t,
      hMap₁_comp, CategoryTheory.Category.assoc]

  obtain ⟨V_tot, hAffV, ⟨cP⟩⟩ := hConsolidate m V₂
  obtain ⟨U_tot, hAffU, ⟨cQ⟩⟩ := hConsolidate n U₂

  let Θ₂ : (⨁ P₂) ⟶ (⨁ Q₂) :=
    ∑ t : Fin r, coeff t •
      (CategoryTheory.Limits.biproduct.π P₂ (src_rel t) ≫
        map₂ (u₂ t) ≫
        CategoryTheory.Limits.biproduct.ι Q₂ (tgt_gen t))
  let θ₂ : L₂ V_tot ⟶ L₂ U_tot := cP.inv ≫ Θ₂ ≫ cQ.hom
  have hθ₂_comm : Θ₂ ≫ cQ.hom = cP.hom ≫ θ₂ := by
    dsimp [θ₂]
    rw [← CategoryTheory.Category.assoc, cP.hom_inv_id, CategoryTheory.Category.id_comp]
  let iso₁ : CategoryTheory.Limits.cokernel θ₂ ≅ CategoryTheory.Limits.cokernel Θ₂ :=
    (CategoryTheory.Limits.cokernel.mapIso Θ₂ θ₂ cP cQ hθ₂_comm).symm
  let iso₂ : pb_g.obj (CategoryTheory.Limits.cokernel Θ₂) ≅
      CategoryTheory.Limits.cokernel (pb_g.map Θ₂) :=
    CategoryTheory.Limits.PreservesCokernel.iso pb_g Θ₂
  let isoP : pb_g.obj (⨁ P₂) ≅ ⨁ P₁ :=
    (pb_g.mapBiproduct P₂).trans
      (CategoryTheory.Limits.biproduct.mapIso (f := fun j => pb_g.obj (P₂ j)) (g := P₁) eP)
  let isoQ : pb_g.obj (⨁ Q₂) ≅ ⨁ Q₁ :=
    (pb_g.mapBiproduct Q₂).trans (CategoryTheory.Limits.biproduct.mapIso eQ)

  have h_ι_isoQ : ∀ b : Fin n,
      pb_g.map (CategoryTheory.Limits.biproduct.ι Q₂ b) ≫ isoQ.hom =
        (eQ b).hom ≫ CategoryTheory.Limits.biproduct.ι Q₁ b := by
    intro b
    have h_inv : CategoryTheory.Limits.biproduct.ι (fun j => pb_g.obj (Q₂ j)) b ≫
        (pb_g.mapBiproduct Q₂).inv =
        pb_g.map (CategoryTheory.Limits.biproduct.ι Q₂ b) := by
      rw [CategoryTheory.Functor.mapBiproduct_inv, CategoryTheory.Limits.biproduct.ι_desc]
    have h_hom : pb_g.map (CategoryTheory.Limits.biproduct.ι Q₂ b) ≫
        (pb_g.mapBiproduct Q₂).hom =
        CategoryTheory.Limits.biproduct.ι (fun j => pb_g.obj (Q₂ j)) b := by
      rw [← h_inv, CategoryTheory.Category.assoc, Iso.inv_hom_id, CategoryTheory.Category.comp_id]
    dsimp [isoQ]
    rw [← CategoryTheory.Category.assoc, h_hom,
      CategoryTheory.Limits.biproduct.mapIso_hom, CategoryTheory.Limits.biproduct.ι_map]

  have h_isoP_π : ∀ a : Fin m,
      isoP.hom ≫ CategoryTheory.Limits.biproduct.π P₁ a =
        pb_g.map (CategoryTheory.Limits.biproduct.π P₂ a) ≫ (eP a).hom := by
    intro a
    have h_hom : (pb_g.mapBiproduct P₂).hom ≫
        CategoryTheory.Limits.biproduct.π (fun j => pb_g.obj (P₂ j)) a =
        pb_g.map (CategoryTheory.Limits.biproduct.π P₂ a) := by
      rw [CategoryTheory.Functor.mapBiproduct_hom, CategoryTheory.Limits.biproduct.lift_π]
    have h_map : CategoryTheory.Limits.biproduct.map (f := fun j => pb_g.obj (P₂ j)) (g := P₁)
        (fun j => (eP j).hom) ≫ CategoryTheory.Limits.biproduct.π P₁ a =
        CategoryTheory.Limits.biproduct.π (fun j => pb_g.obj (P₂ j)) a ≫ (eP a).hom :=
      CategoryTheory.Limits.biproduct.map_π (fun j => (eP j).hom) a
    calc
      isoP.hom ≫ CategoryTheory.Limits.biproduct.π P₁ a
          = (pb_g.mapBiproduct P₂).hom ≫
              (CategoryTheory.Limits.biproduct.map (f := fun j => pb_g.obj (P₂ j)) (g := P₁)
                (fun j => (eP j).hom) ≫
                CategoryTheory.Limits.biproduct.π P₁ a) := by
            dsimp [isoP]
            rw [CategoryTheory.Limits.biproduct.mapIso_hom, CategoryTheory.Category.assoc]
      _ = (pb_g.mapBiproduct P₂).hom ≫
            (CategoryTheory.Limits.biproduct.π (fun j => pb_g.obj (P₂ j)) a ≫ (eP a).hom) := by
            rw [h_map]
      _ = ((pb_g.mapBiproduct P₂).hom ≫
            CategoryTheory.Limits.biproduct.π (fun j => pb_g.obj (P₂ j)) a) ≫ (eP a).hom :=
            (CategoryTheory.Category.assoc _ _ _).symm
      _ = pb_g.map (CategoryTheory.Limits.biproduct.π P₂ a) ≫ (eP a).hom := by
            rw [h_hom]

  have hΘ_comm : pb_g.map Θ₂ ≫ isoQ.hom = isoP.hom ≫ Θ₁ := by
    change pb_g.map Θ₂ ≫ isoQ.hom =
      isoP.hom ≫ ∑ t : Fin r, coeff t •
        (CategoryTheory.Limits.biproduct.π P₁ (src_rel t) ≫
          map₁ (u₁ t) ≫
          CategoryTheory.Limits.biproduct.ι Q₁ (tgt_gen t))
    dsimp [Θ₂]
    rw [CategoryTheory.Functor.map_sum, CategoryTheory.Preadditive.sum_comp,
      CategoryTheory.Preadditive.comp_sum]
    apply Finset.sum_congr rfl
    intro t _
    rw [CategoryTheory.Functor.map_zsmul, CategoryTheory.Preadditive.zsmul_comp,
      CategoryTheory.Preadditive.comp_zsmul]
    congr 1
    calc
      pb_g.map (CategoryTheory.Limits.biproduct.π P₂ (src_rel t) ≫
          map₂ (u₂ t) ≫ CategoryTheory.Limits.biproduct.ι Q₂ (tgt_gen t)) ≫ isoQ.hom
          = pb_g.map (CategoryTheory.Limits.biproduct.π P₂ (src_rel t)) ≫
              pb_g.map (map₂ (u₂ t)) ≫
              (pb_g.map (CategoryTheory.Limits.biproduct.ι Q₂ (tgt_gen t)) ≫ isoQ.hom) := by
            rw [CategoryTheory.Functor.map_comp, CategoryTheory.Functor.map_comp,
              CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]
      _ = pb_g.map (CategoryTheory.Limits.biproduct.π P₂ (src_rel t)) ≫
            (pb_g.map (map₂ (u₂ t)) ≫ (eQ (tgt_gen t)).hom) ≫
            CategoryTheory.Limits.biproduct.ι Q₁ (tgt_gen t) := by
            rw [h_ι_isoQ (tgt_gen t), CategoryTheory.Category.assoc]
      _ = (pb_g.map (CategoryTheory.Limits.biproduct.π P₂ (src_rel t)) ≫ (eP (src_rel t)).hom) ≫
            map₁ (u₁ t) ≫ CategoryTheory.Limits.biproduct.ι Q₁ (tgt_gen t) := by
            rw [hComm_PQ t, CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]
      _ = isoP.hom ≫ CategoryTheory.Limits.biproduct.π P₁ (src_rel t) ≫
            map₁ (u₁ t) ≫ CategoryTheory.Limits.biproduct.ι Q₁ (tgt_gen t) := by
            rw [← h_isoP_π (src_rel t), CategoryTheory.Category.assoc]

  let iso₃ : CategoryTheory.Limits.cokernel (pb_g.map Θ₂) ≅ CategoryTheory.Limits.cokernel Θ₁ :=
    CategoryTheory.Limits.cokernel.mapIso (pb_g.map Θ₂) Θ₁ isoP isoQ hΘ_comm
  let e_cok : pb_g.obj (CategoryTheory.Limits.cokernel θ₂) ≅ CategoryTheory.Limits.cokernel Θ₁ :=
    (pb_g.mapIso iso₁).trans (iso₂.trans iso₃)

  exact ⟨hCok_tor, V_tot, U_tot, hAffV, hAffU, θ₂, ⟨hc, hr, ⟨e_cok⟩⟩⟩

theorem weil_etale_tensorProduct_finite_family_subalgebra_descent (k : Type u) [Field k]
    (A : Type u) [CommRing A] [Algebra k A]
    (K : Fin 3 → Type u) [∀ δ, CommRing (K δ)] [∀ δ, Algebra k (K δ)]
    {N r : ℕ} (δ : Fin N → Fin 3)
    (C : Fin N → Type u) [∀ c, CommRing (C c)]
    [∀ c, Algebra (TensorProduct k A (K (δ c))) (C c)]
    [∀ c, Algebra.Etale (TensorProduct k A (K (δ c))) (C c)]
    (c₁ c₂ : Fin r → Fin N)
    (ρ : ∀ t : Fin r, K (δ (c₁ t)) →ₐ[k] K (δ (c₂ t)))
    (φ : ∀ t : Fin r, C (c₁ t) →+* C (c₂ t)) :
    (∀ t : Fin r,
      (φ t).comp (algebraMap (TensorProduct k A (K (δ (c₁ t)))) (C (c₁ t))) =
        (algebraMap (TensorProduct k A (K (δ (c₂ t)))) (C (c₂ t))).comp
          (Algebra.TensorProduct.map (AlgHom.id k A) (ρ t)).toRingHom) →
    ∃ (R : Type u) (hRingR : CommRing R) (hAlgR : Algebra k R),
      letI : CommRing R := hRingR
      letI : Algebra k R := hAlgR
      ∃ (_ : Algebra.FiniteType k R)
        (ι_R : R →ₐ[k] A)
        (C_R : Fin N → Type u) (hRingCR : ∀ c, CommRing (C_R c))
        (hAlgCR : ∀ c, Algebra (TensorProduct k R (K (δ c))) (C_R c)),
        letI : ∀ c, CommRing (C_R c) := hRingCR
        letI : ∀ c, Algebra (TensorProduct k R (K (δ c))) (C_R c) := hAlgCR
        ∃ (_ : ∀ c, Algebra.Etale (TensorProduct k R (K (δ c))) (C_R c))
          (ψ_C : ∀ c : Fin N, C_R c →+* C c)
          (φ_R : ∀ t : Fin r, C_R (c₁ t) →+* C_R (c₂ t)),
          (∀ c : Fin N,
            CategoryTheory.IsPullback
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_C c)))
              (AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (algebraMap (TensorProduct k A (K (δ c))) (C c))))
              (AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (algebraMap (TensorProduct k R (K (δ c))) (C_R c))))
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                (Algebra.TensorProduct.map ι_R (AlgHom.id k (K (δ c)))).toRingHom))) ∧
          (∀ t : Fin r,
            (φ_R t).comp (algebraMap (TensorProduct k R (K (δ (c₁ t)))) (C_R (c₁ t))) =
              (algebraMap (TensorProduct k R (K (δ (c₂ t)))) (C_R (c₂ t))).comp
                (Algebra.TensorProduct.map (AlgHom.id k R) (ρ t)).toRingHom) ∧
          (∀ t : Fin r,
            (ψ_C (c₂ t)).comp (φ_R t) = (φ t).comp (ψ_C (c₁ t))) :=
by
  intro hφ
  classical
  
  have h_tp_map_comp : ∀ {M₁ M₂ M₃ L₁ L₂ L₃ : Type u}
      [CommRing M₁] [Algebra k M₁] [CommRing M₂] [Algebra k M₂] [CommRing M₃] [Algebra k M₃]
      [CommRing L₁] [Algebra k L₁] [CommRing L₂] [Algebra k L₂] [CommRing L₃] [Algebra k L₃]
      (f₂ : M₂ →ₐ[k] M₃) (f₁ : M₁ →ₐ[k] M₂) (f₃ : M₁ →ₐ[k] M₃)
      (g₂ : L₂ →ₐ[k] L₃) (g₁ : L₁ →ₐ[k] L₂) (g₃ : L₁ →ₐ[k] L₃),
      (∀ x, f₂ (f₁ x) = f₃ x) → (∀ y, g₂ (g₁ y) = g₃ y) →
      (Algebra.TensorProduct.map f₂ g₂).comp (Algebra.TensorProduct.map f₁ g₁) =
        Algebra.TensorProduct.map f₃ g₃ := by
    intro M₁ M₂ M₃ L₁ L₂ L₃ _ _ _ _ _ _ _ _ _ _ _ _ f₂ f₁ f₃ g₂ g₁ g₃ hf hg
    apply AlgHom.ext
    intro w
    induction w using TensorProduct.induction_on with
    | zero => simp only [map_zero]
    | tmul u l =>
      rw [AlgHom.comp_apply, Algebra.TensorProduct.map_tmul,
        Algebra.TensorProduct.map_tmul, Algebra.TensorProduct.map_tmul, hf u, hg l]
    | add x y ihx ihy => rw [map_add, map_add, ihx, ihy]
  have h_tp_map_id : ∀ {M L : Type u} [CommRing M] [Algebra k M] [CommRing L] [Algebra k L]
      (f : M →ₐ[k] M) (g : L →ₐ[k] L),
      (∀ x, f x = x) → (∀ y, g y = y) →
      Algebra.TensorProduct.map f g = AlgHom.id k (TensorProduct k M L) := by
    intro M L _ _ _ _ f g hf hg
    apply AlgHom.ext
    intro w
    induction w using TensorProduct.induction_on with
    | zero => simp only [map_zero]
    | tmul u l => rw [Algebra.TensorProduct.map_tmul, AlgHom.id_apply, hf u, hg l]
    | add x y ihx ihy => rw [map_add, map_add, ihx, ihy]

  
  have h_single_descent : ∀ (L : Type u) [CommRing L] [Algebra k L]
      (E_inf : Type u) [CommRing E_inf] [Algebra (TensorProduct k A L) E_inf]
      [Algebra.Etale (TensorProduct k A L) E_inf],
      ∃ (s₀ : Finset A) (B₀ : CommRingCat.{u})
        (E₀ : Type u) (hRingE₀ : CommRing E₀) (hAlgE₀ : Algebra ↑B₀ E₀),
        letI : CommRing E₀ := hRingE₀
        letI : Algebra ↑B₀ E₀ := hAlgE₀
        ∃ (_ : Algebra.Etale ↑B₀ E₀)
          (θ₀ : B₀ ⟶ CommRingCat.of (TensorProduct k ↥(Algebra.adjoin k (↑s₀ : Set A)) L))
          (g₀ : CommRingCat.of E₀ ⟶ CommRingCat.of E_inf),
          CategoryTheory.IsPushout
            (θ₀ ≫ CommRingCat.ofHom
              (Algebra.TensorProduct.map
                (Algebra.adjoin k (↑s₀ : Set A)).val
                (AlgHom.id k L)).toRingHom)
            (CommRingCat.ofHom (algebraMap ↑B₀ E₀))
            (CommRingCat.ofHom (algebraMap (TensorProduct k A L) E_inf))
            g₀ := by
    intro L _ _ E_inf _ _ _
    have h_finset : ∀ z : TensorProduct k A L,
        ∃ s : Finset A,
          ∃ w : TensorProduct k ↥(Algebra.adjoin k (↑s : Set A)) L,
            Algebra.TensorProduct.map (Algebra.adjoin k (↑s : Set A)).val (AlgHom.id k L) w = z := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => exact ⟨∅, 0, map_zero _⟩
      | tmul a l =>
        exact ⟨{a},
          TensorProduct.tmul k ⟨a, Algebra.subset_adjoin
            (Finset.mem_coe.mpr (Finset.mem_singleton_self a))⟩ l,
          Algebra.TensorProduct.map_tmul _ _ _ _⟩
      | add x y ihx ihy =>
        rcases ihx with ⟨sx, wx, rfl⟩
        rcases ihy with ⟨sy, wy, rfl⟩
        let incx : ↥(Algebra.adjoin k (↑sx : Set A)) →ₐ[k]
            ↥(Algebra.adjoin k (↑(sx ∪ sy) : Set A)) :=
          Subalgebra.inclusion (Algebra.adjoin_mono (Finset.coe_subset.mpr Finset.subset_union_left))
        let incy : ↥(Algebra.adjoin k (↑sy : Set A)) →ₐ[k]
            ↥(Algebra.adjoin k (↑(sx ∪ sy) : Set A)) :=
          Subalgebra.inclusion (Algebra.adjoin_mono (Finset.coe_subset.mpr Finset.subset_union_right))
        refine ⟨sx ∪ sy,
          Algebra.TensorProduct.map incx (AlgHom.id k L) wx +
            Algebra.TensorProduct.map incy (AlgHom.id k L) wy, ?_⟩
        rw [map_add]
        have hx := AlgHom.congr_fun (h_tp_map_comp
          (Algebra.adjoin k (↑(sx ∪ sy) : Set A)).val incx (Algebra.adjoin k (↑sx : Set A)).val
          (AlgHom.id k L) (AlgHom.id k L) (AlgHom.id k L) (fun _ => rfl) (fun _ => rfl)) wx
        have hy := AlgHom.congr_fun (h_tp_map_comp
          (Algebra.adjoin k (↑(sx ∪ sy) : Set A)).val incy (Algebra.adjoin k (↑sy : Set A)).val
          (AlgHom.id k L) (AlgHom.id k L) (AlgHom.id k L) (fun _ => rfl) (fun _ => rfl)) wy
        exact congrArg₂ (· + ·) hx hy
    choose s_el w_el hw_el using h_finset
    obtain ⟨A₀, E₀, hRingE₀, hAlgE₀, hFG, hEt₀, ⟨e_iso⟩⟩ :=
      @Algebra.Etale.exists_subalgebra_fg.{u, u, u} k _ (TensorProduct k A L) E_inf _ _ _ _ inferInstance
    let _ : CommRing E₀ := hRingE₀
    let _ : Algebra ↥A₀ E₀ := hAlgE₀
    rcases hFG with ⟨S_gen, hS_gen⟩
    let s₀ : Finset A := S_gen.biUnion s_el
    let R₀ := Algebra.adjoin k (↑s₀ : Set A)
    let ι₀ : TensorProduct k ↥R₀ L →ₐ[k] TensorProduct k A L :=
      Algebra.TensorProduct.map R₀.val (AlgHom.id k L)
    have hι₀_fun : (⇑ι₀ : TensorProduct k ↥R₀ L → TensorProduct k A L) =
        ⇑(LinearMap.rTensor L R₀.val.toLinearMap) := by
      ext w
      induction w using TensorProduct.induction_on with
      | zero => simp only [map_zero]
      | tmul u l =>
        dsimp only [ι₀]
        rw [Algebra.TensorProduct.map_tmul, LinearMap.rTensor_tmul]
        rfl
      | add x y ihx ihy => rw [map_add, map_add, ihx, ihy]
    have hι₀_inj : Function.Injective ι₀ := by
      rw [hι₀_fun]
      exact Module.Flat.rTensor_preserves_injective_linearMap (M := L)
        R₀.val.toLinearMap Subtype.val_injective
    have hA₀_le : A₀ ≤ ι₀.range := by
      rw [← hS_gen, Algebra.adjoin_le_iff]
      intro z hz
      have hsub : s_el z ⊆ s₀ := Finset.subset_biUnion_of_mem s_el hz
      let inc : ↥(Algebra.adjoin k (↑(s_el z) : Set A)) →ₐ[k] ↥R₀ :=
        Subalgebra.inclusion (Algebra.adjoin_mono (Finset.coe_subset.mpr hsub))
      refine ⟨Algebra.TensorProduct.map inc (AlgHom.id k L) (w_el z), ?_⟩
      have hcomp := h_tp_map_comp R₀.val inc (Algebra.adjoin k (↑(s_el z) : Set A)).val
        (AlgHom.id k L) (AlgHom.id k L) (AlgHom.id k L) (fun _ => rfl) (fun _ => rfl)
      exact (AlgHom.congr_fun hcomp (w_el z)).trans (hw_el z)
    have hA₀_ex : ∀ x : ↥A₀, ∃ y : TensorProduct k ↥R₀ L, ι₀ y = x.1 := by
      intro x
      obtain ⟨y, hy⟩ := hA₀_le x.2
      exact ⟨y, hy⟩
    choose θ_fn hθ_fn using hA₀_ex
    let θ₀_ring : ↥A₀ →+* TensorProduct k ↥R₀ L :=
      { toFun := θ_fn
        map_one' := hι₀_inj (by rw [hθ_fn 1, map_one]; rfl)
        map_mul' := fun x y => hι₀_inj (by rw [hθ_fn (x * y), map_mul, hθ_fn x, hθ_fn y]; rfl)
        map_zero' := hι₀_inj (by rw [hθ_fn 0, map_zero]; rfl)
        map_add' := fun x y => hι₀_inj (by rw [hθ_fn (x + y), map_add, hθ_fn x, hθ_fn y]; rfl) }
    have hθ₀_comp : CommRingCat.ofHom θ₀_ring ≫ CommRingCat.ofHom ι₀.toRingHom =
        CommRingCat.ofHom (algebraMap ↥A₀ (TensorProduct k A L)) :=
      CommRingCat.hom_ext (RingHom.ext hθ_fn)
    let inr_hom : E₀ →+* TensorProduct ↥A₀ (TensorProduct k A L) E₀ :=
      (Algebra.TensorProduct.includeRight (R := ↥A₀) (A := TensorProduct k A L) (B := E₀)).toRingHom
    let g₀_hom : E₀ →+* E_inf := e_iso.symm.toRingHom.comp inr_hom
    have h_sq : CommRingCat.ofHom (algebraMap ↥A₀ (TensorProduct k A L)) ≫
        CommRingCat.ofHom (algebraMap (TensorProduct k A L) E_inf) =
        CommRingCat.ofHom (algebraMap ↥A₀ E₀) ≫ CommRingCat.ofHom g₀_hom := by
      refine CommRingCat.hom_ext (RingHom.ext fun a₀ => ?_)
      change algebraMap (TensorProduct k A L) E_inf (algebraMap ↥A₀ (TensorProduct k A L) a₀) =
        e_iso.symm (TensorProduct.tmul ↥A₀ (1 : TensorProduct k A L) (algebraMap ↥A₀ E₀ a₀))
      have h_tmul : TensorProduct.tmul ↥A₀ (1 : TensorProduct k A L) (algebraMap ↥A₀ E₀ a₀) =
          algebraMap (TensorProduct k A L) (TensorProduct ↥A₀ (TensorProduct k A L) E₀)
            (algebraMap ↥A₀ (TensorProduct k A L) a₀) := by
        rw [Algebra.algebraMap_eq_smul_one (R := ↥A₀) (A := E₀),
          ← TensorProduct.smul_tmul a₀ (1 : TensorProduct k A L) (1 : E₀),
          ← Algebra.algebraMap_eq_smul_one (R := ↥A₀) (A := TensorProduct k A L)]
        rfl
      rw [h_tmul, e_iso.symm.commutes]
    have hpo_direct : CategoryTheory.IsPushout
        (CommRingCat.ofHom (algebraMap ↥A₀ (TensorProduct k A L)))
        (CommRingCat.ofHom (algebraMap ↥A₀ E₀))
        (CommRingCat.ofHom (algebraMap (TensorProduct k A L) E_inf))
        (CommRingCat.ofHom g₀_hom) := by
      let desc_hom : ∀ s : CategoryTheory.Limits.PushoutCocone
          (CommRingCat.ofHom (algebraMap ↥A₀ (TensorProduct k A L)))
          (CommRingCat.ofHom (algebraMap ↥A₀ E₀)), E_inf →+* ↑s.pt := fun s =>
        letI : Algebra ↥A₀ ↑s.pt :=
          (s.inl.hom.comp (algebraMap ↥A₀ (TensorProduct k A L))).toAlgebra
        let f₁ : TensorProduct k A L →ₐ[↥A₀] ↑s.pt :=
          { toRingHom := s.inl.hom, commutes' := fun _ => rfl }
        let f₂ : E₀ →ₐ[↥A₀] ↑s.pt :=
          { toRingHom := s.inr.hom
            commutes' := fun a₀ => (congrArg (fun h => CommRingCat.Hom.hom h a₀) s.condition).symm }
        (Algebra.TensorProduct.productMap f₁ f₂).toRingHom.comp e_iso.toAlgHom.toRingHom
      refine CategoryTheory.IsPushout.of_isColimit
        (CategoryTheory.Limits.PushoutCocone.IsColimit.mk h_sq
          (fun s => CommRingCat.ofHom (desc_hom s))
          (fun s => ?_) (fun s => ?_) (fun s m hm₁ hm₂ => ?_))
      · refine CommRingCat.hom_ext (RingHom.ext fun x => ?_)
        let _ : Algebra ↥A₀ ↑s.pt :=
          (s.inl.hom.comp (algebraMap ↥A₀ (TensorProduct k A L))).toAlgebra
        let f₁ : TensorProduct k A L →ₐ[↥A₀] ↑s.pt :=
          { toRingHom := s.inl.hom, commutes' := fun _ => rfl }
        let f₂ : E₀ →ₐ[↥A₀] ↑s.pt :=
          { toRingHom := s.inr.hom
            commutes' := fun a₀ => (congrArg (fun h => CommRingCat.Hom.hom h a₀) s.condition).symm }
        change (Algebra.TensorProduct.productMap f₁ f₂) (e_iso (algebraMap (TensorProduct k A L) E_inf x)) =
          s.inl.hom x
        rw [e_iso.commutes x]
        change (Algebra.TensorProduct.productMap f₁ f₂) (TensorProduct.tmul ↥A₀ x 1) = s.inl.hom x
        rw [Algebra.TensorProduct.productMap_apply_tmul]
        exact (congrArg (s.inl.hom x * ·) (map_one s.inr.hom)).trans (mul_one (s.inl.hom x))
      · refine CommRingCat.hom_ext (RingHom.ext fun y => ?_)
        let _ : Algebra ↥A₀ ↑s.pt :=
          (s.inl.hom.comp (algebraMap ↥A₀ (TensorProduct k A L))).toAlgebra
        let f₁ : TensorProduct k A L →ₐ[↥A₀] ↑s.pt :=
          { toRingHom := s.inl.hom, commutes' := fun _ => rfl }
        let f₂ : E₀ →ₐ[↥A₀] ↑s.pt :=
          { toRingHom := s.inr.hom
            commutes' := fun a₀ => (congrArg (fun h => CommRingCat.Hom.hom h a₀) s.condition).symm }
        change (Algebra.TensorProduct.productMap f₁ f₂) (e_iso (e_iso.symm (TensorProduct.tmul ↥A₀ 1 y))) =
          s.inr.hom y
        rw [e_iso.apply_symm_apply, Algebra.TensorProduct.productMap_apply_tmul]
        exact (congrArg (· * s.inr.hom y) (map_one s.inl.hom)).trans (one_mul (s.inr.hom y))
      · refine CommRingCat.hom_ext (RingHom.ext fun e => ?_)
        let _ : Algebra ↥A₀ ↑s.pt :=
          (s.inl.hom.comp (algebraMap ↥A₀ (TensorProduct k A L))).toAlgebra
        let f₁ : TensorProduct k A L →ₐ[↥A₀] ↑s.pt :=
          { toRingHom := s.inl.hom, commutes' := fun _ => rfl }
        let f₂ : E₀ →ₐ[↥A₀] ↑s.pt :=
          { toRingHom := s.inr.hom
            commutes' := fun a₀ => (congrArg (fun h => CommRingCat.Hom.hom h a₀) s.condition).symm }
        suffices h_all : ∀ t : TensorProduct ↥A₀ (TensorProduct k A L) E₀,
            m.hom (e_iso.symm t) = Algebra.TensorProduct.productMap f₁ f₂ t by
          have h := h_all (e_iso e)
          rwa [e_iso.symm_apply_apply] at h
        intro t
        induction t using TensorProduct.induction_on with
        | zero => simp
        | add u v ihu ihv => rw [map_add, map_add, map_add, ihu, ihv]
        | tmul x y =>
          have hxy : TensorProduct.tmul ↥A₀ x y =
              algebraMap (TensorProduct k A L) (TensorProduct ↥A₀ (TensorProduct k A L) E₀) x *
                inr_hom y := by
            change TensorProduct.tmul ↥A₀ x y =
              TensorProduct.tmul ↥A₀ x 1 * TensorProduct.tmul ↥A₀ 1 y
            rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
          rw [hxy, map_mul, e_iso.symm.commutes x, map_mul]
          have hx' : m.hom (algebraMap (TensorProduct k A L) E_inf x) = s.inl.hom x :=
            congrArg (fun h => CommRingCat.Hom.hom h x) hm₁
          have hy' : m.hom (e_iso.symm (inr_hom y)) = s.inr.hom y :=
            congrArg (fun h => CommRingCat.Hom.hom h y) hm₂
          rw [hx', hy']
          change s.inl.hom x * s.inr.hom y =
            Algebra.TensorProduct.productMap f₁ f₂ (TensorProduct.tmul ↥A₀ x 1 * TensorProduct.tmul ↥A₀ 1 y)
          rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul,
            Algebra.TensorProduct.productMap_apply_tmul]
          rfl
    exact ⟨s₀, CommRingCat.of ↥A₀, E₀, hRingE₀, hAlgE₀, hEt₀,
      CommRingCat.ofHom θ₀_ring, CommRingCat.ofHom g₀_hom, by rwa [hθ₀_comp]⟩

  
  choose s₀_c B₀_c E₀_c hRingE₀ hAlgE₀ hEt₀_c θ₀_raw g₀_c hPo₀_raw using
    fun c : Fin N => h_single_descent (K (δ c)) (C c)
  let s₁ : Finset A := Finset.univ.biUnion s₀_c
  let ℐ := Set.Ici s₁

  
  let B : Fin 3 → CategoryTheory.Functor ℐ CommRingCat.{u} := fun d =>
    { obj := fun s =>
        CommRingCat.of (TensorProduct k ↥(Algebra.adjoin k (↑s.1 : Set A)) (K d))
      map := fun u => CommRingCat.ofHom
        (Algebra.TensorProduct.map
          (Subalgebra.inclusion (Algebra.adjoin_mono
            (Finset.coe_subset.mpr (CategoryTheory.leOfHom u))))
          (AlgHom.id k (K d))).toRingHom
      map_id := fun _ =>
        (congrArg (fun f : _ →ₐ[k] _ => CommRingCat.ofHom f.toRingHom)
          (h_tp_map_id _ _ (fun _ => rfl) (fun _ => rfl))).trans
          CommRingCat.ofHom_id
      map_comp := fun _ _ =>
        (congrArg (fun f : _ →ₐ[k] _ => CommRingCat.ofHom f.toRingHom)
          (h_tp_map_comp _ _ _ _ _ _ (fun _ => rfl) (fun _ => rfl)).symm).trans
          (CommRingCat.ofHom_comp _ _) }
  let κ_B : ∀ d : Fin 3, CategoryTheory.Limits.Cocone (B d) := fun d =>
    { pt := CommRingCat.of (TensorProduct k A (K d))
      ι :=
        { app := fun s => CommRingCat.ofHom
            (Algebra.TensorProduct.map
              (Algebra.adjoin k (↑s.1 : Set A)).val
              (AlgHom.id k (K d))).toRingHom
          naturality := fun _ _ _ =>
            ((CommRingCat.ofHom_comp _ _).symm.trans
              (congrArg (fun f : _ →ₐ[k] _ => CommRingCat.ofHom f.toRingHom)
                (h_tp_map_comp _ _ _ _ _ _ (fun _ => rfl) (fun _ => rfl)))).trans
              (CategoryTheory.Category.comp_id _).symm } }

  have hc_B_nonempty : ∀ d : Fin 3, Nonempty (CategoryTheory.Limits.IsColimit (κ_B d)) := by
    intro d
    let L := K d
    let D := B d
    let κ := κ_B d
    let b₀ : ℐ := ⊥
    let σ : A → ℐ := fun a => ⟨s₁ ∪ {a}, Finset.subset_union_left⟩
    let a_hat : ∀ a : A, ↥(Algebra.adjoin k (↑(σ a).1 : Set A)) := fun a =>
      ⟨a, Algebra.subset_adjoin
        (Finset.mem_coe.mpr (Finset.mem_union_right s₁ (Finset.mem_singleton_self a)))⟩
    have h_colim_aux : ∀ γ : CategoryTheory.Limits.Cocone D,
        ∃ desc_hom : κ.pt ⟶ γ.pt, ∀ s : ℐ, κ.ι.app s ≫ desc_hom = γ.ι.app s := by
      intro γ
      let T : Type u := ↑γ.pt
      let _ : Algebra k T := ((γ.ι.app b₀).hom.comp (algebraMap k ↑(D.obj b₀))).toAlgebra
      have h_comm_s : ∀ (s : ℐ) (r₀ : k),
          (γ.ι.app s).hom (algebraMap k ↑(D.obj s) r₀) = algebraMap k T r₀ := by
        intro s r₀
        let u₀ : b₀ ⟶ s := CategoryTheory.homOfLE bot_le
        have hw := congrArg (fun h => CommRingCat.Hom.hom h (algebraMap k ↑(D.obj b₀) r₀)) (γ.w u₀)
        change (γ.ι.app s).hom
            ((Algebra.TensorProduct.map
              (Subalgebra.inclusion (Algebra.adjoin_mono
                (Finset.coe_subset.mpr (CategoryTheory.leOfHom u₀))))
              (AlgHom.id k L)) (algebraMap k ↑(D.obj b₀) r₀)) =
          algebraMap k T r₀ at hw
        rwa [AlgHom.commutes] at hw
      let g_alg : ∀ s : ℐ, TensorProduct k ↥(Algebra.adjoin k (↑s.1 : Set A)) L →ₐ[k] T := fun s =>
        { toRingHom := (γ.ι.app s).hom, commutes' := h_comm_s s }
      let f_L : L →ₐ[k] T := (g_alg b₀).comp Algebra.TensorProduct.includeRight
      let f_A0 : A → T := fun a => g_alg (σ a) (TensorProduct.tmul k (a_hat a) 1)
      have h_eval : ∀ (s : ℐ) (x : ↥(Algebra.adjoin k (↑s.1 : Set A))),
          g_alg s (TensorProduct.tmul k x 1) = f_A0 x.1 := by
        intro s x
        let w : ℐ := ⟨s.1 ∪ {x.1}, le_trans s.2 Finset.subset_union_left⟩
        let u₁ : s ⟶ w := CategoryTheory.homOfLE Finset.subset_union_left
        let u₂ : σ x.1 ⟶ w :=
          CategoryTheory.homOfLE (Finset.union_subset_union s.2 (Finset.Subset.refl _))
        let x_w : ↥(Algebra.adjoin k (↑w.1 : Set A)) :=
          ⟨x.1, Algebra.adjoin_mono (Finset.coe_subset.mpr Finset.subset_union_left) x.2⟩
        have hm₁ : (D.map u₁).hom (TensorProduct.tmul k x 1) = TensorProduct.tmul k x_w 1 := by
          change (Algebra.TensorProduct.map _ (AlgHom.id k L)) (TensorProduct.tmul k x 1) = _
          rw [Algebra.TensorProduct.map_tmul]
          rfl
        have hm₂ : (D.map u₂).hom (TensorProduct.tmul k (a_hat x.1) 1) =
            TensorProduct.tmul k x_w 1 := by
          change (Algebra.TensorProduct.map _ (AlgHom.id k L))
            (TensorProduct.tmul k (a_hat x.1) 1) = _
          rw [Algebra.TensorProduct.map_tmul]
          rfl
        have hw₁ := congrArg (fun h => CommRingCat.Hom.hom h (TensorProduct.tmul k x 1)) (γ.w u₁)
        have hw₂ := congrArg (fun h => CommRingCat.Hom.hom h (TensorProduct.tmul k (a_hat x.1) 1)) (γ.w u₂)
        change (γ.ι.app w).hom ((D.map u₁).hom (TensorProduct.tmul k x 1)) =
          g_alg s (TensorProduct.tmul k x 1) at hw₁
        change (γ.ι.app w).hom ((D.map u₂).hom (TensorProduct.tmul k (a_hat x.1) 1)) =
          f_A0 x.1 at hw₂
        rw [hm₁] at hw₁
        rw [hm₂] at hw₂
        exact hw₁.symm.trans hw₂
      let f_A : A →ₐ[k] T :=
        { toFun := f_A0
          map_one' := by
            have h1 : ((1 : ↥(Algebra.adjoin k (↑b₀.1 : Set A))) : A) = 1 := rfl
            rw [← h1, ← h_eval b₀ 1, ← Algebra.TensorProduct.one_def, map_one]
          map_mul' := fun a b => by
            let sab : ℐ := ⟨s₁ ∪ {a, b}, Finset.subset_union_left⟩
            let xa : ↥(Algebra.adjoin k (↑sab.1 : Set A)) :=
              ⟨a, Algebra.subset_adjoin (by simp [sab])⟩
            let xb : ↥(Algebra.adjoin k (↑sab.1 : Set A)) :=
              ⟨b, Algebra.subset_adjoin (by simp [sab])⟩
            have hab : ((xa * xb : ↥(Algebra.adjoin k (↑sab.1 : Set A))) : A) = a * b := rfl
            rw [← hab, ← h_eval sab (xa * xb), ← h_eval sab xa, ← h_eval sab xb,
              ← map_mul, Algebra.TensorProduct.tmul_mul_tmul, mul_one]
          map_zero' := by
            have h0 : ((0 : ↥(Algebra.adjoin k (↑b₀.1 : Set A))) : A) = 0 := rfl
            rw [← h0, ← h_eval b₀ 0, TensorProduct.zero_tmul, map_zero]
          map_add' := fun a b => by
            let sab : ℐ := ⟨s₁ ∪ {a, b}, Finset.subset_union_left⟩
            let xa : ↥(Algebra.adjoin k (↑sab.1 : Set A)) :=
              ⟨a, Algebra.subset_adjoin (by simp [sab])⟩
            let xb : ↥(Algebra.adjoin k (↑sab.1 : Set A)) :=
              ⟨b, Algebra.subset_adjoin (by simp [sab])⟩
            have hab : ((xa + xb : ↥(Algebra.adjoin k (↑sab.1 : Set A))) : A) = a + b := rfl
            rw [← hab, ← h_eval sab (xa + xb), TensorProduct.add_tmul, map_add,
              h_eval sab xa, h_eval sab xb]
          commutes' := fun r₀ => by
            have hr : ((algebraMap k ↥(Algebra.adjoin k (↑b₀.1 : Set A)) r₀) : A) =
                algebraMap k A r₀ := rfl
            have h_am := (Algebra.TensorProduct.includeLeft :
              ↥(Algebra.adjoin k (↑b₀.1 : Set A)) →ₐ[k]
                TensorProduct k ↥(Algebra.adjoin k (↑b₀.1 : Set A)) L).commutes r₀
            change TensorProduct.tmul k (algebraMap k ↥(Algebra.adjoin k (↑b₀.1 : Set A)) r₀) 1 =
              algebraMap k (TensorProduct k ↥(Algebra.adjoin k (↑b₀.1 : Set A)) L) r₀ at h_am
            rw [← hr, ← h_eval b₀ (algebraMap k _ r₀), h_am]
            exact (g_alg b₀).commutes r₀ }
      refine ⟨CommRingCat.ofHom (Algebra.TensorProduct.productMap f_A f_L).toRingHom, fun s => ?_⟩
      refine CommRingCat.hom_ext (RingHom.ext fun z => ?_)
      induction z using TensorProduct.induction_on with
      | zero => simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply, map_zero]
      | add x y ihx ihy =>
        simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply, map_add] at ihx ihy ⊢
        rw [ihx, ihy]
      | tmul x l =>
        change (Algebra.TensorProduct.productMap f_A f_L)
            ((Algebra.TensorProduct.map (Algebra.adjoin k (↑s.1 : Set A)).val (AlgHom.id k L))
              (TensorProduct.tmul k x l)) =
          (γ.ι.app s).hom (TensorProduct.tmul k x l)
        rw [Algebra.TensorProduct.map_tmul, Algebra.TensorProduct.productMap_apply_tmul]
        have hx_ev : f_A x.1 = (γ.ι.app s).hom (TensorProduct.tmul k x 1) := (h_eval s x).symm
        let u₀ : b₀ ⟶ s := CategoryTheory.homOfLE bot_le
        have hl_map : (D.map u₀).hom (TensorProduct.tmul k 1 l) = TensorProduct.tmul k 1 l := by
          change (Algebra.TensorProduct.map _ (AlgHom.id k L)) (TensorProduct.tmul k 1 l) = _
          rw [Algebra.TensorProduct.map_tmul, map_one, AlgHom.id_apply]
        have hl_ev : f_L l = (γ.ι.app s).hom (TensorProduct.tmul k 1 l) := by
          have hw := congrArg (fun h => CommRingCat.Hom.hom h (TensorProduct.tmul k 1 l)) (γ.w u₀)
          change (γ.ι.app s).hom ((D.map u₀).hom (TensorProduct.tmul k 1 l)) = f_L l at hw
          rw [hl_map] at hw
          exact hw.symm
        change f_A x.1 * f_L l = (γ.ι.app s).hom (TensorProduct.tmul k x l)
        rw [hx_ev, hl_ev, ← map_mul, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
    choose desc_fn hdesc_fac using h_colim_aux
    refine ⟨CategoryTheory.Limits.IsColimit.mk desc_fn hdesc_fac (fun γ m hm => ?_)⟩
    refine CommRingCat.hom_ext (RingHom.ext fun z => ?_)
    induction z using TensorProduct.induction_on with
    | zero => simp only [map_zero]
    | add x y ihx ihy => rw [map_add, map_add, ihx, ihy]
    | tmul a l =>
      have ha_tmul : (κ.ι.app (σ a)).hom (TensorProduct.tmul k (a_hat a) l) =
          TensorProduct.tmul k a l := by
        change (Algebra.TensorProduct.map _ (AlgHom.id k L)) (TensorProduct.tmul k (a_hat a) l) = _
        rw [Algebra.TensorProduct.map_tmul]
        rfl
      rw [← ha_tmul]
      have hm_eq := congrArg (fun h => CommRingCat.Hom.hom h (TensorProduct.tmul k (a_hat a) l)) (hm (σ a))
      have hd_eq := congrArg (fun h => CommRingCat.Hom.hom h (TensorProduct.tmul k (a_hat a) l)) (hdesc_fac γ (σ a))
      exact hm_eq.trans hd_eq.symm
  let hc_B : ∀ d : Fin 3, CategoryTheory.Limits.IsColimit (κ_B d) :=
    fun d => (hc_B_nonempty d).some

  
  have h_po_cancel : ∀ {Z₀ Z₁ Z₂ Y₀ Y₁ Y₂ : CommRingCat.{u}}
      {f₁ : Z₀ ⟶ Z₁} {g : Z₀ ⟶ Y₀} {f₂ : Z₁ ⟶ Y₁} {h₁ : Y₀ ⟶ Y₁}
      {j₁ : Z₁ ⟶ Z₂} {k_hom : Z₂ ⟶ Y₂} {j₂ : Y₁ ⟶ Y₂},
      CategoryTheory.IsPushout f₁ g f₂ h₁ →
      CategoryTheory.IsPushout (f₁ ≫ j₁) g k_hom (h₁ ≫ j₂) →
      j₁ ≫ k_hom = f₂ ≫ j₂ →
      CategoryTheory.IsPushout j₁ f₂ k_hom j₂ := by
    intro Z₀ Z₁ Z₂ Y₀ Y₁ Y₂ f₁ g f₂ h₁ j₁ k_hom j₂ hTop hOut hSq
    refine CategoryTheory.IsPushout.of_isColimit
      (CategoryTheory.Limits.PushoutCocone.IsColimit.mk hSq
        (fun s => hOut.desc s.inl (h₁ ≫ s.inr) (by
          rw [CategoryTheory.Category.assoc, s.condition,
            ← CategoryTheory.Category.assoc, hTop.w, CategoryTheory.Category.assoc]))
        (fun s => hOut.inl_desc _ _ _)
        (fun s => hTop.hom_ext
          (by rw [← CategoryTheory.Category.assoc, ← hSq, CategoryTheory.Category.assoc,
                hOut.inl_desc, s.condition])
          (by rw [← CategoryTheory.Category.assoc, hOut.inr_desc]))
        (fun s m hm₁ hm₂ => hOut.hom_ext
          (hm₁.trans (hOut.inl_desc _ _ _).symm)
          (by rw [CategoryTheory.Category.assoc, hm₂, hOut.inr_desc])))

  have h_prop : ∀ (B₀ : CommRingCat.{u}) (E₀ : Type u) (hRing₀ : CommRing E₀)
      (hAlg₀ : Algebra ↑B₀ E₀) (_ : @Algebra.Etale ↑B₀ E₀ _ hRing₀ hAlg₀)
      (B_d : CategoryTheory.Functor ℐ CommRingCat.{u})
      (θ₀ : B₀ ⟶ B_d.obj ⊥)
      (κ_d : CategoryTheory.Limits.Cocone B_d) (_ : CategoryTheory.Limits.IsColimit κ_d)
      (E_inf : Type u) [CommRing E_inf] [Algebra ↑κ_d.pt E_inf]
      (g₀ : @CommRingCat.of E₀ hRing₀ ⟶ CommRingCat.of E_inf),
      CategoryTheory.IsPushout (θ₀ ≫ κ_d.ι.app ⊥)
        (@CommRingCat.ofHom _ E₀ _ hRing₀ (@algebraMap ↑B₀ E₀ _ hRing₀.toSemiring hAlg₀))
        (CommRingCat.ofHom (algebraMap ↑κ_d.pt E_inf)) g₀ →
      ∃ (F_E : CategoryTheory.Functor ℐ CommRingCat.{u})
        (α_E : B_d ⟶ F_E)
        (ι_E : F_E ⟶ (CategoryTheory.Functor.const ℐ).obj (CommRingCat.of E_inf)),
        Nonempty (CategoryTheory.Limits.IsColimit
          ({ pt := CommRingCat.of E_inf, ι := ι_E } : CategoryTheory.Limits.Cocone F_E)) ∧
        (∀ i : ℐ, @Algebra.Etale ↑(B_d.obj i) ↑(F_E.obj i) _ _ ((α_E.app i).hom).toAlgebra) ∧
        (∀ i : ℐ, CategoryTheory.IsPushout
          (B_d.map (CategoryTheory.homOfLE (bot_le : (⊥ : ℐ) ≤ i)))
          (α_E.app ⊥) (α_E.app i)
          (F_E.map (CategoryTheory.homOfLE (bot_le : (⊥ : ℐ) ≤ i)))) ∧
        (∀ i : ℐ, CategoryTheory.IsPushout
          (κ_d.ι.app i) (α_E.app i)
          (CommRingCat.ofHom (algebraMap ↑κ_d.pt E_inf)) (ι_E.app i)) := by
    intro B₀ E₀ hRing₀ hAlg₀ hEt₀ B_d θ₀ κ_d hc_d E_inf _ _ g₀ hPo_in
    let _ : CommRing E₀ := hRing₀
    let _ : Algebra ↑B₀ E₀ := hAlg₀
    let _ : Algebra.Etale ↑B₀ E₀ := hEt₀
    let θ : ∀ i : ℐ, B₀ ⟶ B_d.obj i :=
      fun i => θ₀ ≫ B_d.map (CategoryTheory.homOfLE (bot_le : (⊥ : ℐ) ≤ i))
    have hθ_map : ∀ {i j : ℐ} (u : i ⟶ j), θ i ≫ B_d.map u = θ j := by
      intro i j u
      dsimp [θ]
      rw [CategoryTheory.Category.assoc, ← B_d.map_comp]
      congr 2
    have hθ_cocone : ∀ i : ℐ, θ i ≫ κ_d.ι.app i = θ₀ ≫ κ_d.ι.app ⊥ := by
      intro i
      dsimp [θ]
      rw [CategoryTheory.Category.assoc, κ_d.w]
    let f₀ : B₀ ⟶ CommRingCat.of E₀ := CommRingCat.ofHom (algebraMap ↑B₀ E₀)
    let f_inf : κ_d.pt ⟶ CommRingCat.of E_inf := CommRingCat.ofHom (algebraMap ↑κ_d.pt E_inf)
    let M : ℐ → Type u := fun i =>
      letI : Algebra ↑B₀ ↑(B_d.obj i) := (θ i).hom.toAlgebra
      TensorProduct ↑B₀ ↑(B_d.obj i) E₀
    let instRingM : ∀ i : ℐ, CommRing (M i) := fun i =>
      letI : Algebra ↑B₀ ↑(B_d.obj i) := (θ i).hom.toAlgebra
      inferInstance
    let obj_E : ℐ → CommRingCat.{u} := fun i => @CommRingCat.of (M i) (instRingM i)
    let α_app : ∀ i : ℐ, B_d.obj i ⟶ obj_E i := fun i =>
      letI : Algebra ↑B₀ ↑(B_d.obj i) := (θ i).hom.toAlgebra
      @CommRingCat.ofHom ↑(B_d.obj i) (M i) _ (instRingM i)
        Algebra.TensorProduct.includeLeftRingHom
    let inr_app : ∀ i : ℐ, CommRingCat.of E₀ ⟶ obj_E i := fun i =>
      letI : Algebra ↑B₀ ↑(B_d.obj i) := (θ i).hom.toAlgebra
      @CommRingCat.ofHom E₀ (M i) _ (instRingM i)
        Algebra.TensorProduct.includeRight.toRingHom
    have hPo₀ : ∀ i : ℐ, CategoryTheory.IsPushout (θ i) f₀ (α_app i) (inr_app i) := fun i => by
      letI : Algebra ↑B₀ ↑(B_d.obj i) := (θ i).hom.toAlgebra
      exact CommRingCat.isPushout_tensorProduct ↑B₀ ↑(B_d.obj i) E₀
    have hEt_M : ∀ i : ℐ, @Algebra.Etale ↑(B_d.obj i) ↑(obj_E i) _ _ ((α_app i).hom).toAlgebra := by
      intro i
      letI : Algebra ↑B₀ ↑(B_d.obj i) := (θ i).hom.toAlgebra
      let alg_std : Algebra ↑(B_d.obj i) (M i) := inferInstance
      have h_alg_eq : ((α_app i).hom).toAlgebra = alg_std :=
        Algebra.algebra_ext _ _ (fun _ => rfl)
      change @Algebra.Etale ↑(B_d.obj i) (M i) _ (instRingM i) ((α_app i).hom).toAlgebra
      rw [h_alg_eq]
      exact Algebra.Etale.baseChange ↑B₀ E₀ ↑(B_d.obj i)
    let map_E : ∀ {i j : ℐ}, (i ⟶ j) → (obj_E i ⟶ obj_E j) := fun {i j} u =>
      (hPo₀ i).desc (B_d.map u ≫ α_app j) (inr_app j)
        (by rw [← CategoryTheory.Category.assoc, hθ_map u, (hPo₀ j).w])
    let F_E : CategoryTheory.Functor ℐ CommRingCat.{u} :=
      { obj := obj_E
        map := @map_E
        map_id := fun i => (hPo₀ i).hom_ext
          (by dsimp [map_E]; rw [(hPo₀ i).inl_desc, B_d.map_id,
                CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id])
          (by dsimp [map_E]; rw [(hPo₀ i).inr_desc, CategoryTheory.Category.comp_id])
        map_comp := fun {i j l} u v => (hPo₀ i).hom_ext
          (calc
            α_app i ≫ map_E (u ≫ v)
              = B_d.map (u ≫ v) ≫ α_app l := (hPo₀ i).inl_desc _ _ _
            _ = B_d.map u ≫ (B_d.map v ≫ α_app l) := by
                rw [B_d.map_comp, CategoryTheory.Category.assoc]
            _ = B_d.map u ≫ (α_app j ≫ map_E v) := by
                dsimp [map_E]; rw [(hPo₀ j).inl_desc]
            _ = (B_d.map u ≫ α_app j) ≫ map_E v :=
                (CategoryTheory.Category.assoc _ _ _).symm
            _ = (α_app i ≫ map_E u) ≫ map_E v := by
                dsimp [map_E]; rw [(hPo₀ i).inl_desc]
            _ = α_app i ≫ (map_E u ≫ map_E v) :=
                CategoryTheory.Category.assoc _ _ _)
          (calc
            inr_app i ≫ map_E (u ≫ v)
              = inr_app l := (hPo₀ i).inr_desc _ _ _
            _ = inr_app j ≫ map_E v := ((hPo₀ j).inr_desc _ _ _).symm
            _ = (inr_app i ≫ map_E u) ≫ map_E v := by
                dsimp [map_E]; rw [(hPo₀ i).inr_desc]
            _ = inr_app i ≫ (map_E u ≫ map_E v) :=
                CategoryTheory.Category.assoc _ _ _) }
    let α_E : B_d ⟶ F_E :=
      { app := α_app
        naturality := fun _ _ _ => ((hPo₀ _).inl_desc _ _ _).symm }
    have hPo_bot : ∀ i : ℐ, CategoryTheory.IsPushout
        (B_d.map (CategoryTheory.homOfLE (bot_le : (⊥ : ℐ) ≤ i)))
        (α_E.app ⊥) (α_E.app i)
        (F_E.map (CategoryTheory.homOfLE (bot_le : (⊥ : ℐ) ≤ i))) := by
      intro i
      refine h_po_cancel (hPo₀ ⊥) ?_ (α_E.naturality _)
      have h1 : θ ⊥ ≫ B_d.map (CategoryTheory.homOfLE (bot_le : (⊥ : ℐ) ≤ i)) = θ i :=
        hθ_map _
      have h2 : inr_app ⊥ ≫ F_E.map (CategoryTheory.homOfLE (bot_le : (⊥ : ℐ) ≤ i)) = inr_app i :=
        (hPo₀ ⊥).inr_desc _ _ _
      rw [h1, h2]
      exact hPo₀ i
    let ι_app : ∀ i : ℐ, F_E.obj i ⟶ CommRingCat.of E_inf := fun i =>
      (hPo₀ i).desc (κ_d.ι.app i ≫ f_inf) g₀
        (by rw [← CategoryTheory.Category.assoc, hθ_cocone i, hPo_in.w])
    let ι_E : F_E ⟶ (CategoryTheory.Functor.const ℐ).obj (CommRingCat.of E_inf) :=
      { app := ι_app
        naturality := fun i j u => by
          dsimp
          rw [CategoryTheory.Category.comp_id]
          refine (hPo₀ i).hom_ext ?_ ?_
          · dsimp [F_E, map_E, ι_app]
            calc
              α_app i ≫ ((hPo₀ i).desc (B_d.map u ≫ α_app j) (inr_app j) _ ≫
                  (hPo₀ j).desc (κ_d.ι.app j ≫ f_inf) g₀ _)
                = (α_app i ≫ (hPo₀ i).desc (B_d.map u ≫ α_app j) (inr_app j) _) ≫
                    (hPo₀ j).desc (κ_d.ι.app j ≫ f_inf) g₀ _ :=
                  (CategoryTheory.Category.assoc _ _ _).symm
              _ = (B_d.map u ≫ α_app j) ≫ (hPo₀ j).desc (κ_d.ι.app j ≫ f_inf) g₀ _ := by
                  rw [(hPo₀ i).inl_desc]
              _ = B_d.map u ≫ (α_app j ≫ (hPo₀ j).desc (κ_d.ι.app j ≫ f_inf) g₀ _) :=
                  CategoryTheory.Category.assoc _ _ _
              _ = B_d.map u ≫ (κ_d.ι.app j ≫ f_inf) := by
                  rw [(hPo₀ j).inl_desc]
              _ = (B_d.map u ≫ κ_d.ι.app j) ≫ f_inf :=
                  (CategoryTheory.Category.assoc _ _ _).symm
              _ = κ_d.ι.app i ≫ f_inf := by
                  rw [κ_d.w u]
              _ = α_app i ≫ (hPo₀ i).desc (κ_d.ι.app i ≫ f_inf) g₀ _ :=
                  ((hPo₀ i).inl_desc _ _ _).symm
          · dsimp [F_E, map_E, ι_app]
            rw [← CategoryTheory.Category.assoc, (hPo₀ i).inr_desc,
              (hPo₀ j).inr_desc, (hPo₀ i).inr_desc] }
    have hPo_inf : ∀ i : ℐ, CategoryTheory.IsPushout (κ_d.ι.app i) (α_E.app i) f_inf (ι_E.app i) := by
      intro i
      refine h_po_cancel (hPo₀ i) ?_ ((hPo₀ i).inl_desc _ _ _).symm
      have h2 : inr_app i ≫ ι_E.app i = g₀ := (hPo₀ i).inr_desc _ _ _
      rw [hθ_cocone i, h2]
      exact hPo_in
    let κ_E : CategoryTheory.Limits.Cocone F_E := { pt := CommRingCat.of E_inf, ι := ι_E }
    have hc_E : CategoryTheory.Limits.IsColimit κ_E := by
      let s_B_of : CategoryTheory.Limits.Cocone F_E → CategoryTheory.Limits.Cocone B_d := fun s =>
        { pt := s.pt
          ι :=
            { app := fun i => α_E.app i ≫ s.ι.app i
              naturality := fun i j u => by
                dsimp
                rw [← CategoryTheory.Category.assoc, α_E.naturality u,
                  CategoryTheory.Category.assoc, s.w u, CategoryTheory.Category.comp_id] } }
      let desc_E : ∀ s : CategoryTheory.Limits.Cocone F_E, κ_E.pt ⟶ s.pt := fun s =>
        (hPo_inf ⊥).desc (hc_d.desc (s_B_of s)) (s.ι.app ⊥) (hc_d.fac (s_B_of s) ⊥)
      refine CategoryTheory.Limits.IsColimit.mk desc_E (fun s i => ?_) (fun s m hm => ?_)
      · refine (hPo_bot i).hom_ext ?_ ?_
        · dsimp [κ_E, desc_E]
          rw [← CategoryTheory.Category.assoc, ← (hPo_inf i).w,
            CategoryTheory.Category.assoc, (hPo_inf ⊥).inl_desc]
          exact hc_d.fac (s_B_of s) i
        · have hwE : F_E.map (CategoryTheory.homOfLE (bot_le : (⊥ : ℐ) ≤ i)) ≫ κ_E.ι.app i =
              κ_E.ι.app ⊥ := κ_E.w (CategoryTheory.homOfLE (bot_le : (⊥ : ℐ) ≤ i))
          rw [← CategoryTheory.Category.assoc, hwE]
          dsimp [κ_E, desc_E]
          rw [(hPo_inf ⊥).inr_desc]
          exact (s.w (CategoryTheory.homOfLE (bot_le : (⊥ : ℐ) ≤ i))).symm
      · refine (hPo_inf ⊥).hom_ext ?_ ?_
        · dsimp [desc_E]
          rw [(hPo_inf ⊥).inl_desc]
          refine hc_d.uniq (s_B_of s) (f_inf ≫ m) (fun i => ?_)
          rw [← CategoryTheory.Category.assoc, (hPo_inf i).w, CategoryTheory.Category.assoc]
          exact congrArg (α_E.app i ≫ ·) (hm i)
        · dsimp [desc_E]
          rw [(hPo_inf ⊥).inr_desc]
          exact hm ⊥
    exact ⟨F_E, α_E, ι_E, ⟨hc_E⟩, hEt_M, hPo_bot, hPo_inf⟩

  
  have h_prop_c : ∀ c : Fin N,
      ∃ (F_E : CategoryTheory.Functor ℐ CommRingCat.{u})
        (α_E : B (δ c) ⟶ F_E)
        (ι_E : F_E ⟶ (CategoryTheory.Functor.const ℐ).obj (CommRingCat.of (C c))),
        Nonempty (CategoryTheory.Limits.IsColimit
          ({ pt := CommRingCat.of (C c), ι := ι_E } : CategoryTheory.Limits.Cocone F_E)) ∧
        (∀ i : ℐ, @Algebra.Etale ↑((B (δ c)).obj i) ↑(F_E.obj i) _ _ ((α_E.app i).hom).toAlgebra) ∧
        (∀ i : ℐ, CategoryTheory.IsPushout
          ((B (δ c)).map (CategoryTheory.homOfLE (bot_le : (⊥ : ℐ) ≤ i)))
          (α_E.app ⊥) (α_E.app i)
          (F_E.map (CategoryTheory.homOfLE (bot_le : (⊥ : ℐ) ≤ i)))) ∧
        (∀ i : ℐ, CategoryTheory.IsPushout
          ((κ_B (δ c)).ι.app i) (α_E.app i)
          (CommRingCat.ofHom (algebraMap (TensorProduct k A (K (δ c))) (C c))) (ι_E.app i)) := by
    intro c
    have hsub : s₀_c c ⊆ s₁ := Finset.subset_biUnion_of_mem s₀_c (Finset.mem_univ c)
    let step_c : CommRingCat.of (TensorProduct k ↥(Algebra.adjoin k (↑(s₀_c c) : Set A)) (K (δ c))) ⟶
        (B (δ c)).obj ⊥ :=
      CommRingCat.ofHom (Algebra.TensorProduct.map
        (Subalgebra.inclusion (Algebra.adjoin_mono (Finset.coe_subset.mpr hsub)))
        (AlgHom.id k (K (δ c)))).toRingHom
    have h_step_comp : step_c ≫ (κ_B (δ c)).ι.app ⊥ =
        CommRingCat.ofHom (Algebra.TensorProduct.map
          (Algebra.adjoin k (↑(s₀_c c) : Set A)).val
          (AlgHom.id k (K (δ c)))).toRingHom :=
      (CommRingCat.ofHom_comp _ _).symm.trans
        (congrArg (fun f : _ →ₐ[k] _ => CommRingCat.ofHom f.toRingHom)
          (h_tp_map_comp _ _ _ _ _ _ (fun _ => rfl) (fun _ => rfl)))
    have hPo_s₁ : CategoryTheory.IsPushout
        ((θ₀_raw c ≫ step_c) ≫ (κ_B (δ c)).ι.app ⊥)
        (@CommRingCat.ofHom _ (E₀_c c) _ (hRingE₀ c)
          (@algebraMap ↑(B₀_c c) (E₀_c c) _ (hRingE₀ c).toSemiring (hAlgE₀ c)))
        (CommRingCat.ofHom (algebraMap (TensorProduct k A (K (δ c))) (C c)))
        (g₀_c c) := by
      rw [CategoryTheory.Category.assoc, h_step_comp]
      exact hPo₀_raw c
    exact h_prop (B₀_c c) (E₀_c c) (hRingE₀ c) (hAlgE₀ c) (hEt₀_c c)
      (B (δ c)) (θ₀_raw c ≫ step_c) (κ_B (δ c)) (hc_B (δ c)) (C c) (g₀_c c) hPo_s₁

  choose F_C α_C ι_C hc_C_nonempty hEt_C hPo_bot hPo_inf using h_prop_c
  let κ_C : ∀ c : Fin N, CategoryTheory.Limits.Cocone (F_C c) :=
    fun c => { pt := CommRingCat.of (C c), ι := ι_C c }
  let hc_C : ∀ c : Fin N, CategoryTheory.Limits.IsColimit (κ_C c) :=
    fun c => (hc_C_nonempty c).some

  
  have hFP_bot : ∀ c : Fin N, (((α_C c).app ⊥).hom).FinitePresentation := by
    intro c
    letI : Algebra ↑((B (δ c)).obj ⊥) ↑((F_C c).obj ⊥) := (((α_C c).app ⊥).hom).toAlgebra
    letI : Algebra.Etale ↑((B (δ c)).obj ⊥) ↑((F_C c).obj ⊥) := hEt_C c ⊥
    exact RingHom.finitePresentation_algebraMap.mpr Algebra.Etale.finitePresentation

  let ρ_B : ∀ t : Fin r, B (δ (c₁ t)) ⟶ B (δ (c₂ t)) := fun t =>
    { app := fun i => CommRingCat.ofHom
        (Algebra.TensorProduct.map
          (AlgHom.id k ↥(Algebra.adjoin k (↑i.1 : Set A)))
          (ρ t)).toRingHom
      naturality := fun i j u => by
        dsimp [B]
        rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
        have h1 := h_tp_map_comp
          (AlgHom.id k _)
          (Subalgebra.inclusion (Algebra.adjoin_mono (Finset.coe_subset.mpr (CategoryTheory.leOfHom u))))
          (Subalgebra.inclusion (Algebra.adjoin_mono (Finset.coe_subset.mpr (CategoryTheory.leOfHom u))))
          (ρ t) (AlgHom.id k _) (ρ t) (fun _ => rfl) (fun _ => rfl)
        have h2 := h_tp_map_comp
          (Subalgebra.inclusion (Algebra.adjoin_mono (Finset.coe_subset.mpr (CategoryTheory.leOfHom u))))
          (AlgHom.id k _)
          (Subalgebra.inclusion (Algebra.adjoin_mono (Finset.coe_subset.mpr (CategoryTheory.leOfHom u))))
          (AlgHom.id k _) (ρ t) (ρ t) (fun _ => rfl) (fun _ => rfl)
        exact congrArg (fun f : _ →ₐ[k] _ => CommRingCat.ofHom f.toRingHom) (h1.trans h2.symm) }

  let ρ_inf : ∀ t : Fin r, (κ_B (δ (c₁ t))).pt ⟶ (κ_B (δ (c₂ t))).pt := fun t =>
    CommRingCat.ofHom (Algebra.TensorProduct.map (AlgHom.id k A) (ρ t)).toRingHom

  have hρ_comm : ∀ (t : Fin r) (i : ℐ),
      (ρ_B t).app i ≫ (κ_B (δ (c₂ t))).ι.app i =
        (κ_B (δ (c₁ t))).ι.app i ≫ ρ_inf t := by
    intro t i
    dsimp [ρ_B, κ_B, ρ_inf]
    rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
    have h1 := h_tp_map_comp
      (Algebra.adjoin k (↑i.1 : Set A)).val (AlgHom.id k _) (Algebra.adjoin k (↑i.1 : Set A)).val
      (AlgHom.id k _) (ρ t) (ρ t) (fun _ => rfl) (fun _ => rfl)
    have h2 := h_tp_map_comp
      (AlgHom.id k A) (Algebra.adjoin k (↑i.1 : Set A)).val (Algebra.adjoin k (↑i.1 : Set A)).val
      (ρ t) (AlgHom.id k _) (ρ t) (fun _ => rfl) (fun _ => rfl)
    exact congrArg (fun f : _ →ₐ[k] _ => CommRingCat.ofHom f.toRingHom) (h1.trans h2.symm)

  let f_inf_c : ∀ c : Fin N, (κ_B (δ c)).pt ⟶ (κ_C c).pt := fun c =>
    CommRingCat.ofHom (algebraMap (TensorProduct k A (K (δ c))) (C c))

  have hφ_cat : ∀ t : Fin r,
      f_inf_c (c₁ t) ≫ CommRingCat.ofHom (φ t) = ρ_inf t ≫ f_inf_c (c₂ t) :=
    fun t => CommRingCat.hom_ext (hφ t)

  have h_lift_each : ∀ t : Fin r,
      ∃ (i_t : ℐ) (g'_t : (F_C (c₁ t)).obj ⊥ ⟶ (F_C (c₂ t)).obj i_t),
        (α_C (c₁ t)).app ⊥ ≫ g'_t =
          (B (δ (c₁ t))).map (CategoryTheory.homOfLE (bot_le : (⊥ : ℐ) ≤ i_t)) ≫
            (ρ_B t).app i_t ≫ (α_C (c₂ t)).app i_t ∧
        (κ_C (c₁ t)).ι.app ⊥ ≫ CommRingCat.ofHom (φ t) =
          g'_t ≫ (κ_C (c₂ t)).ι.app i_t := by
    intro t
    let β_t : (CategoryTheory.Functor.const ℐ).obj ((B (δ (c₁ t))).obj ⊥) ⟶ F_C (c₂ t) :=
      { app := fun i =>
          (B (δ (c₁ t))).map (CategoryTheory.homOfLE (bot_le : (⊥ : ℐ) ≤ i)) ≫
            (ρ_B t).app i ≫ (α_C (c₂ t)).app i
        naturality := fun i j u => by
          dsimp
          rw [CategoryTheory.Category.id_comp]
          calc
            (B (δ (c₁ t))).map (CategoryTheory.homOfLE (bot_le : (⊥ : ℐ) ≤ j)) ≫
                ((ρ_B t).app j ≫ (α_C (c₂ t)).app j)
              = ((B (δ (c₁ t))).map (CategoryTheory.homOfLE (bot_le : (⊥ : ℐ) ≤ i)) ≫
                  (B (δ (c₁ t))).map u) ≫ ((ρ_B t).app j ≫ (α_C (c₂ t)).app j) := by
                rw [← (B (δ (c₁ t))).map_comp]
            _ = (B (δ (c₁ t))).map (CategoryTheory.homOfLE (bot_le : (⊥ : ℐ) ≤ i)) ≫
                  (((B (δ (c₁ t))).map u ≫ (ρ_B t).app j) ≫ (α_C (c₂ t)).app j) := by
                simp only [CategoryTheory.Category.assoc]
            _ = (B (δ (c₁ t))).map (CategoryTheory.homOfLE (bot_le : (⊥ : ℐ) ≤ i)) ≫
                  (((ρ_B t).app i ≫ (B (δ (c₂ t))).map u) ≫ (α_C (c₂ t)).app j) := by
                rw [(ρ_B t).naturality u]
            _ = (B (δ (c₁ t))).map (CategoryTheory.homOfLE (bot_le : (⊥ : ℐ) ≤ i)) ≫
                  ((ρ_B t).app i ≫ ((B (δ (c₂ t))).map u ≫ (α_C (c₂ t)).app j)) := by
                simp only [CategoryTheory.Category.assoc]
            _ = (B (δ (c₁ t))).map (CategoryTheory.homOfLE (bot_le : (⊥ : ℐ) ≤ i)) ≫
                  ((ρ_B t).app i ≫ ((α_C (c₂ t)).app i ≫ (F_C (c₂ t)).map u)) := by
                rw [(α_C (c₂ t)).naturality u]
            _ = ((B (δ (c₁ t))).map (CategoryTheory.homOfLE (bot_le : (⊥ : ℐ) ≤ i)) ≫
                  ((ρ_B t).app i ≫ (α_C (c₂ t)).app i)) ≫ (F_C (c₂ t)).map u := by
                simp only [CategoryTheory.Category.assoc] }
    let g_t : (F_C (c₁ t)).obj ⊥ ⟶ (κ_C (c₂ t)).pt :=
      (κ_C (c₁ t)).ι.app ⊥ ≫ CommRingCat.ofHom (φ t)
    have hg_t : ∀ i : ℐ,
        (α_C (c₁ t)).app ⊥ ≫ g_t = β_t.app i ≫ (κ_C (c₂ t)).ι.app i := by
      intro i
      dsimp [g_t, β_t, κ_C]
      calc
        (α_C (c₁ t)).app ⊥ ≫ ((ι_C (c₁ t)).app ⊥ ≫ CommRingCat.ofHom (φ t))
          = ((α_C (c₁ t)).app ⊥ ≫ (ι_C (c₁ t)).app ⊥) ≫ CommRingCat.ofHom (φ t) :=
            (CategoryTheory.Category.assoc _ _ _).symm
        _ = ((κ_B (δ (c₁ t))).ι.app ⊥ ≫ f_inf_c (c₁ t)) ≫ CommRingCat.ofHom (φ t) := by
            dsimp [f_inf_c]
            rw [← (hPo_inf (c₁ t) ⊥).w]
        _ = (κ_B (δ (c₁ t))).ι.app ⊥ ≫ (f_inf_c (c₁ t) ≫ CommRingCat.ofHom (φ t)) :=
            CategoryTheory.Category.assoc _ _ _
        _ = (κ_B (δ (c₁ t))).ι.app ⊥ ≫ (ρ_inf t ≫ f_inf_c (c₂ t)) := by
            rw [hφ_cat t]
        _ = ((B (δ (c₁ t))).map (CategoryTheory.homOfLE (bot_le : (⊥ : ℐ) ≤ i)) ≫
              (κ_B (δ (c₁ t))).ι.app i) ≫ (ρ_inf t ≫ f_inf_c (c₂ t)) := by
            rw [(κ_B (δ (c₁ t))).w (CategoryTheory.homOfLE (bot_le : (⊥ : ℐ) ≤ i))]
        _ = (B (δ (c₁ t))).map (CategoryTheory.homOfLE (bot_le : (⊥ : ℐ) ≤ i)) ≫
              (((κ_B (δ (c₁ t))).ι.app i ≫ ρ_inf t) ≫ f_inf_c (c₂ t)) := by
            simp only [CategoryTheory.Category.assoc]
        _ = (B (δ (c₁ t))).map (CategoryTheory.homOfLE (bot_le : (⊥ : ℐ) ≤ i)) ≫
              (((ρ_B t).app i ≫ (κ_B (δ (c₂ t))).ι.app i) ≫ f_inf_c (c₂ t)) := by
            rw [← hρ_comm t i]
        _ = (B (δ (c₁ t))).map (CategoryTheory.homOfLE (bot_le : (⊥ : ℐ) ≤ i)) ≫
              ((ρ_B t).app i ≫ ((κ_B (δ (c₂ t))).ι.app i ≫ f_inf_c (c₂ t))) := by
            simp only [CategoryTheory.Category.assoc]
        _ = (B (δ (c₁ t))).map (CategoryTheory.homOfLE (bot_le : (⊥ : ℐ) ≤ i)) ≫
              ((ρ_B t).app i ≫ ((α_C (c₂ t)).app i ≫ (ι_C (c₂ t)).app i)) := by
            dsimp [f_inf_c]
            rw [(hPo_inf (c₂ t) i).w]
        _ = ((B (δ (c₁ t))).map (CategoryTheory.homOfLE (bot_le : (⊥ : ℐ) ≤ i)) ≫
              ((ρ_B t).app i ≫ (α_C (c₂ t)).app i)) ≫ (ι_C (c₂ t)).app i := by
            simp only [CategoryTheory.Category.assoc]
    exact RingHom.EssFiniteType.exists_eq_comp_ι_app_of_isColimit
      ((B (δ (c₁ t))).obj ⊥) (F_C (c₂ t)) β_t ((α_C (c₁ t)).app ⊥)
      (κ_C (c₂ t)) (hc_C (c₂ t)) (hFP_bot (c₁ t)) g_t hg_t

  choose i_t g'_t h_base_t h_lift_t using h_lift_each
  let i_fin : ℐ := Finset.univ.sup i_t
  have h_le_fin : ∀ t : Fin r, i_t t ≤ i_fin :=
    fun t => Finset.le_sup (Finset.mem_univ t)

  have h_compat_fin : ∀ t : Fin r,
      (B (δ (c₁ t))).map (CategoryTheory.homOfLE (bot_le : (⊥ : ℐ) ≤ i_fin)) ≫
        ((ρ_B t).app i_fin ≫ (α_C (c₂ t)).app i_fin) =
      (α_C (c₁ t)).app ⊥ ≫
        (g'_t t ≫ (F_C (c₂ t)).map (CategoryTheory.homOfLE (h_le_fin t))) := by
    intro t
    calc
      (B (δ (c₁ t))).map (CategoryTheory.homOfLE (bot_le : (⊥ : ℐ) ≤ i_fin)) ≫
          ((ρ_B t).app i_fin ≫ (α_C (c₂ t)).app i_fin)
        = ((B (δ (c₁ t))).map (CategoryTheory.homOfLE (bot_le : (⊥ : ℐ) ≤ i_t t)) ≫
            (B (δ (c₁ t))).map (CategoryTheory.homOfLE (h_le_fin t))) ≫
            ((ρ_B t).app i_fin ≫ (α_C (c₂ t)).app i_fin) := by
          rw [← (B (δ (c₁ t))).map_comp]
      _ = (B (δ (c₁ t))).map (CategoryTheory.homOfLE (bot_le : (⊥ : ℐ) ≤ i_t t)) ≫
            (((B (δ (c₁ t))).map (CategoryTheory.homOfLE (h_le_fin t)) ≫ (ρ_B t).app i_fin) ≫
              (α_C (c₂ t)).app i_fin) := by
          simp only [CategoryTheory.Category.assoc]
      _ = (B (δ (c₁ t))).map (CategoryTheory.homOfLE (bot_le : (⊥ : ℐ) ≤ i_t t)) ≫
            (((ρ_B t).app (i_t t) ≫ (B (δ (c₂ t))).map (CategoryTheory.homOfLE (h_le_fin t))) ≫
              (α_C (c₂ t)).app i_fin) := by
          rw [(ρ_B t).naturality]
      _ = (B (δ (c₁ t))).map (CategoryTheory.homOfLE (bot_le : (⊥ : ℐ) ≤ i_t t)) ≫
            ((ρ_B t).app (i_t t) ≫
              ((B (δ (c₂ t))).map (CategoryTheory.homOfLE (h_le_fin t)) ≫
                (α_C (c₂ t)).app i_fin)) := by
          simp only [CategoryTheory.Category.assoc]
      _ = (B (δ (c₁ t))).map (CategoryTheory.homOfLE (bot_le : (⊥ : ℐ) ≤ i_t t)) ≫
            ((ρ_B t).app (i_t t) ≫
              ((α_C (c₂ t)).app (i_t t) ≫
                (F_C (c₂ t)).map (CategoryTheory.homOfLE (h_le_fin t)))) := by
          rw [(α_C (c₂ t)).naturality]
      _ = ((B (δ (c₁ t))).map (CategoryTheory.homOfLE (bot_le : (⊥ : ℐ) ≤ i_t t)) ≫
            ((ρ_B t).app (i_t t) ≫ (α_C (c₂ t)).app (i_t t))) ≫
            (F_C (c₂ t)).map (CategoryTheory.homOfLE (h_le_fin t)) := by
          simp only [CategoryTheory.Category.assoc]
      _ = ((α_C (c₁ t)).app ⊥ ≫ g'_t t) ≫
            (F_C (c₂ t)).map (CategoryTheory.homOfLE (h_le_fin t)) := by
          rw [← h_base_t t]
      _ = (α_C (c₁ t)).app ⊥ ≫
            (g'_t t ≫ (F_C (c₂ t)).map (CategoryTheory.homOfLE (h_le_fin t))) :=
          CategoryTheory.Category.assoc _ _ _

  let φ_fin : ∀ t : Fin r, (F_C (c₁ t)).obj i_fin ⟶ (F_C (c₂ t)).obj i_fin := fun t =>
    (hPo_bot (c₁ t) i_fin).desc
      ((ρ_B t).app i_fin ≫ (α_C (c₂ t)).app i_fin)
      (g'_t t ≫ (F_C (c₂ t)).map (CategoryTheory.homOfLE (h_le_fin t)))
      (h_compat_fin t)

  have hφ_base : ∀ t : Fin r,
      (α_C (c₁ t)).app i_fin ≫ φ_fin t =
        (ρ_B t).app i_fin ≫ (α_C (c₂ t)).app i_fin :=
    fun t => (hPo_bot (c₁ t) i_fin).inl_desc _ _ _

  have hφ_lift : ∀ t : Fin r,
      φ_fin t ≫ (κ_C (c₂ t)).ι.app i_fin =
        (κ_C (c₁ t)).ι.app i_fin ≫ CommRingCat.ofHom (φ t) := by
    intro t
    refine (hPo_bot (c₁ t) i_fin).hom_ext ?_ ?_
    · dsimp [κ_C]
      calc
        (α_C (c₁ t)).app i_fin ≫ (φ_fin t ≫ (ι_C (c₂ t)).app i_fin)
          = ((α_C (c₁ t)).app i_fin ≫ φ_fin t) ≫ (ι_C (c₂ t)).app i_fin :=
            (CategoryTheory.Category.assoc _ _ _).symm
        _ = ((ρ_B t).app i_fin ≫ (α_C (c₂ t)).app i_fin) ≫ (ι_C (c₂ t)).app i_fin := by
            rw [hφ_base t]
        _ = (ρ_B t).app i_fin ≫ ((α_C (c₂ t)).app i_fin ≫ (ι_C (c₂ t)).app i_fin) :=
            CategoryTheory.Category.assoc _ _ _
        _ = (ρ_B t).app i_fin ≫ ((κ_B (δ (c₂ t))).ι.app i_fin ≫ f_inf_c (c₂ t)) := by
            dsimp [f_inf_c]
            rw [← (hPo_inf (c₂ t) i_fin).w]
        _ = ((ρ_B t).app i_fin ≫ (κ_B (δ (c₂ t))).ι.app i_fin) ≫ f_inf_c (c₂ t) :=
            (CategoryTheory.Category.assoc _ _ _).symm
        _ = ((κ_B (δ (c₁ t))).ι.app i_fin ≫ ρ_inf t) ≫ f_inf_c (c₂ t) := by
            rw [hρ_comm t i_fin]
        _ = (κ_B (δ (c₁ t))).ι.app i_fin ≫ (ρ_inf t ≫ f_inf_c (c₂ t)) :=
            CategoryTheory.Category.assoc _ _ _
        _ = (κ_B (δ (c₁ t))).ι.app i_fin ≫ (f_inf_c (c₁ t) ≫ CommRingCat.ofHom (φ t)) := by
            rw [← hφ_cat t]
        _ = ((κ_B (δ (c₁ t))).ι.app i_fin ≫ f_inf_c (c₁ t)) ≫ CommRingCat.ofHom (φ t) :=
            (CategoryTheory.Category.assoc _ _ _).symm
        _ = ((α_C (c₁ t)).app i_fin ≫ (ι_C (c₁ t)).app i_fin) ≫ CommRingCat.ofHom (φ t) := by
            dsimp [f_inf_c]
            rw [(hPo_inf (c₁ t) i_fin).w]
        _ = (α_C (c₁ t)).app i_fin ≫ ((ι_C (c₁ t)).app i_fin ≫ CommRingCat.ofHom (φ t)) :=
            CategoryTheory.Category.assoc _ _ _
    · calc
        (F_C (c₁ t)).map (CategoryTheory.homOfLE (bot_le : (⊥ : ℐ) ≤ i_fin)) ≫
            (φ_fin t ≫ (κ_C (c₂ t)).ι.app i_fin)
          = ((F_C (c₁ t)).map (CategoryTheory.homOfLE (bot_le : (⊥ : ℐ) ≤ i_fin)) ≫ φ_fin t) ≫
              (κ_C (c₂ t)).ι.app i_fin :=
            (CategoryTheory.Category.assoc _ _ _).symm
        _ = (g'_t t ≫ (F_C (c₂ t)).map (CategoryTheory.homOfLE (h_le_fin t))) ≫
              (κ_C (c₂ t)).ι.app i_fin := by
            dsimp [φ_fin]
            rw [(hPo_bot (c₁ t) i_fin).inr_desc]
        _ = g'_t t ≫ ((F_C (c₂ t)).map (CategoryTheory.homOfLE (h_le_fin t)) ≫
              (κ_C (c₂ t)).ι.app i_fin) :=
            CategoryTheory.Category.assoc _ _ _
        _ = g'_t t ≫ (κ_C (c₂ t)).ι.app (i_t t) := by
            rw [(κ_C (c₂ t)).w]
        _ = (κ_C (c₁ t)).ι.app ⊥ ≫ CommRingCat.ofHom (φ t) :=
            (h_lift_t t).symm
        _ = ((F_C (c₁ t)).map (CategoryTheory.homOfLE (bot_le : (⊥ : ℐ) ≤ i_fin)) ≫
              (κ_C (c₁ t)).ι.app i_fin) ≫ CommRingCat.ofHom (φ t) := by
            rw [(κ_C (c₁ t)).w (CategoryTheory.homOfLE (bot_le : (⊥ : ℐ) ≤ i_fin))]
        _ = (F_C (c₁ t)).map (CategoryTheory.homOfLE (bot_le : (⊥ : ℐ) ≤ i_fin)) ≫
              ((κ_C (c₁ t)).ι.app i_fin ≫ CommRingCat.ofHom (φ t)) :=
            CategoryTheory.Category.assoc _ _ _

  
  let R_sub := Algebra.adjoin k (↑i_fin.1 : Set A)
  let R : Type u := ↥R_sub
  let hRingR : CommRing R := inferInstance
  let hAlgR : Algebra k R := inferInstance
  let hFTR : Algebra.FiniteType k R := Algebra.FiniteType.adjoin_of_finite i_fin.1.finite_toSet
  let ι_R : R →ₐ[k] A := R_sub.val
  let C_R : Fin N → Type u := fun c => ↑((F_C c).obj i_fin)
  let hRingCR : ∀ c : Fin N, CommRing (C_R c) := fun _ => inferInstance
  let hAlgCR : ∀ c : Fin N, Algebra (TensorProduct k R (K (δ c))) (C_R c) :=
    fun c => (((α_C c).app i_fin).hom).toAlgebra
  let ψ_C : ∀ c : Fin N, C_R c →+* C c := fun c => ((ι_C c).app i_fin).hom
  let φ_R : ∀ t : Fin r, C_R (c₁ t) →+* C_R (c₂ t) := fun t => (φ_fin t).hom

  refine ⟨R, hRingR, hAlgR, hFTR, ι_R, C_R, hRingCR, hAlgCR,
    fun c => hEt_C c i_fin, ψ_C, φ_R, ?_, ?_, ?_⟩
  · intro c
    exact AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ (hPo_inf c i_fin).flip
  · intro t
    exact congrArg CommRingCat.Hom.hom (hφ_base t)
  · intro t
    exact congrArg CommRingCat.Hom.hom (hφ_lift t)

theorem weil_etale_three_chart_torsion_sheaf_filtered_colimit_presentation (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (X : AlgebraicGeometry.Scheme.{u})
    (S_ch : Fin 3 → Type u) [∀ δ, CommRing (S_ch δ)]
    (j : ∀ δ : Fin 3, AlgebraicGeometry.Spec (CommRingCat.of (S_ch δ)) ⟶ X)
    [∀ δ, AlgebraicGeometry.IsOpenImmersion (j δ)]
    (τ : ∀ (δ₁ δ₂ : Fin 3), (δ₁ = δ₂ ∨ δ₂ = 2) → (S_ch δ₁ →+* S_ch δ₂)) :
    let A_ℓ := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))
    (Set.range (j 0).base ∪ Set.range (j 1).base = Set.univ ∧
      Set.range (j 2).base = Set.range (j 0).base ∩ Set.range (j 1).base) →
    (∀ δ : Fin 3, τ δ δ (Or.inl rfl) = RingHom.id (S_ch δ)) →
    (∀ (δ₁ δ₂ : Fin 3) (h : δ₁ = δ₂ ∨ δ₂ = 2),
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (τ δ₁ δ₂ h)) ≫ j δ₁ = j δ₂) →
    ∀ (F : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}),
      ℓ • CategoryTheory.CategoryStruct.id F = 0 →
      ∃ (Λ : Type u) (_ : CategoryTheory.SmallCategory Λ) (_ : CategoryTheory.IsFiltered Λ)
        (D : CategoryTheory.Functor Λ (CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}))
        (c : CategoryTheory.Limits.Cocone D),
        Nonempty (CategoryTheory.Limits.IsColimit c) ∧
        c.pt = F ∧
        ∀ l : Λ,
          ∃ (N m n r : ℕ) (δ_l : Fin N → Fin 3)
            (C_l : Fin N → Type u) (hRingC : ∀ c, CommRing (C_l c)),
            letI : ∀ c, CommRing (C_l c) := hRingC
            ∃ (hAlgC : ∀ c, Algebra (S_ch (δ_l c)) (C_l c)),
