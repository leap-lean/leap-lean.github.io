      exact (congrArg (adj₁.unit.app X ≫ ·) (e_R.hom_inv_id_app (L₁.obj X))).trans
        (Category.comp_id _)
    · apply (adj_h.homEquiv (L₂.obj X) (L_h.obj (L₂.obj X))).injective
      apply (adj₂.homEquiv X (R_h.obj (L_h.obj (L₂.obj X)))).injective
      rw [Adjunction.homEquiv_naturality_right, Adjunction.homEquiv_naturality_right,
        Adjunction.homEquiv_id, adj₂.homEquiv_unit, adj₂.homEquiv_unit]
      dsimp only [β]
      rw [Equiv.apply_symm_apply, hu_2, Category.assoc]
      change adj₁.unit.app X ≫ (e_R.hom.app (L₁.obj X) ≫ (R_h ⋙ R₂).map α) = _
      rw [← e_R.hom.naturality α, ← Category.assoc, hu_1, Category.assoc, Category.assoc]
      exact congrArg (adj₂.unit.app X ≫ ·)
        ((congrArg (R₂.map (adj_h.unit.app (L₂.obj X)) ≫ ·)
          (e_R.inv_hom_id_app (L_h.obj (L₂.obj X)))).trans (Category.comp_id _))

  have hMate_nat : ∀ {𝒞₀ 𝒞₁ 𝒞₂ : Type (u + 1)}
      [CategoryTheory.Category.{u + 1} 𝒞₀] [CategoryTheory.Category.{u + 1} 𝒞₁]
      [CategoryTheory.Category.{u + 1} 𝒞₂]
      {L₁ : 𝒞₀ ⥤ 𝒞₁} {R₁ : 𝒞₁ ⥤ 𝒞₀} (adj₁ : L₁ ⊣ R₁)
      {L₂ : 𝒞₀ ⥤ 𝒞₂} {R₂ : 𝒞₂ ⥤ 𝒞₀} (adj₂ : L₂ ⊣ R₂)
      {L_h : 𝒞₂ ⥤ 𝒞₁} {R_h : 𝒞₁ ⥤ 𝒞₂} (adj_h : L_h ⊣ R_h)
      (e_R : R₁ ≅ R_h ⋙ R₂) {X Y : 𝒞₀} (f : X ⟶ Y),
      let β := fun Z : 𝒞₀ =>
        (adj_h.homEquiv (L₂.obj Z) (L₁.obj Z)).symm
          ((adj₂.homEquiv Z (R_h.obj (L₁.obj Z))).symm
            (adj₁.unit.app Z ≫ e_R.hom.app (L₁.obj Z)))
      L_h.map (L₂.map f) ≫ β Y = β X ≫ L₁.map f := by
    intro 𝒞₀ 𝒞₁ 𝒞₂ _ _ _ L₁ R₁ adj₁ L₂ R₂ adj₂ L_h R_h adj_h e_R X Y f β
    apply (adj_h.homEquiv (L₂.obj X) (L₁.obj Y)).injective
    apply (adj₂.homEquiv X (R_h.obj (L₁.obj Y))).injective
    rw [Adjunction.homEquiv_naturality_left, Adjunction.homEquiv_naturality_left,
      Adjunction.homEquiv_naturality_right, Adjunction.homEquiv_naturality_right]
    dsimp only [β]
    rw [Equiv.apply_symm_apply, Equiv.apply_symm_apply, Equiv.apply_symm_apply,
      Equiv.apply_symm_apply, Category.assoc]
    change f ≫ adj₁.unit.app Y ≫ e_R.hom.app (L₁.obj Y) =
      adj₁.unit.app X ≫ (e_R.hom.app (L₁.obj X) ≫ (R_h ⋙ R₂).map (L₁.map f))
    have hu_nat : f ≫ adj₁.unit.app Y = adj₁.unit.app X ≫ R₁.map (L₁.map f) :=
      adj₁.unit.naturality f
    rw [← e_R.hom.naturality (L₁.map f), ← Category.assoc, hu_nat, Category.assoc]

  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let Pℤ : ∀ (Y : AlgebraicGeometry.Scheme.{u}),
      CategoryTheory.Functor (Opposite Y.Etale) AddCommGrpCat.{u} :=
    fun Y => (CategoryTheory.Functor.const (Opposite Y.Etale)).obj Aℤ
  let Fℤ' : ∀ (Y : AlgebraicGeometry.Scheme.{u}),
      CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u} :=
    fun Y => (CategoryTheory.presheafToSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj (Pℤ Y)
  let Fℤ : ∀ (Y : AlgebraicGeometry.Scheme.{u}),
      CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u} :=
    fun Y => (CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
  let T_of : ∀ (Y : AlgebraicGeometry.Scheme.{u}), Y.Etale := weilEtaleIdTerminal.{u}
  let hT_of : ∀ (Y : AlgebraicGeometry.Scheme.{u}), CategoryTheory.Limits.IsTerminal (T_of Y) :=
    weilEtaleIdTerminalIsTerminal.{u}
  let constPresheafHom : ∀ (Y : AlgebraicGeometry.Scheme.{u})
      (Q : CategoryTheory.Functor (Opposite Y.Etale) AddCommGrpCat.{u}),
      (Aℤ ⟶ Q.obj (Opposite.op (T_of Y))) → (Pℤ Y ⟶ Q) :=
    fun Y Q g₀ =>
      { app := fun U => g₀ ≫ Q.map (Opposite.op ((hT_of Y).from U.unop))
        naturality := fun {U₁ U₂} f => by
          change 𝟙 Aℤ ≫ g₀ ≫ Q.map (Opposite.op ((hT_of Y).from U₂.unop)) =
            (g₀ ≫ Q.map (Opposite.op ((hT_of Y).from U₁.unop))) ≫ Q.map f
          rw [Category.id_comp, Category.assoc, ← Q.map_comp]
          have hf : Opposite.op ((hT_of Y).from U₁.unop) ≫ f =
              Opposite.op ((hT_of Y).from U₂.unop) := by
            rcases U₁ with ⟨V₁⟩
            rcases U₂ with ⟨V₂⟩
            change Opposite.op (f.unop ≫ (hT_of Y).from V₁) = Opposite.op ((hT_of Y).from V₂)
            exact congrArg Opposite.op ((hT_of Y).hom_ext _ _)
          exact congrArg (g₀ ≫ Q.map ·) hf.symm }
  have hConst_ext : ∀ {Y : AlgebraicGeometry.Scheme.{u}}
      {Q : CategoryTheory.Functor (Opposite Y.Etale) AddCommGrpCat.{u}}
      {α₁ α₂ : Pℤ Y ⟶ Q},
      α₁.app (Opposite.op (T_of Y)) = α₂.app (Opposite.op (T_of Y)) → α₁ = α₂ := by
    intro Y Q α₁ α₂ h_eq
    refine CategoryTheory.NatTrans.ext (funext fun ⟨V⟩ => ?_)
    have h₁ : 𝟙 Aℤ ≫ α₁.app (Opposite.op V) =
        α₁.app (Opposite.op (T_of Y)) ≫ Q.map (Opposite.op ((hT_of Y).from V)) :=
      α₁.naturality (Opposite.op ((hT_of Y).from V))
    have h₂ : 𝟙 Aℤ ≫ α₂.app (Opposite.op V) =
        α₂.app (Opposite.op (T_of Y)) ≫ Q.map (Opposite.op ((hT_of Y).from V)) :=
      α₂.naturality (Opposite.op ((hT_of Y).from V))
    exact (Category.id_comp _).symm.trans
      (h₁.trans ((congrArg (· ≫ _) h_eq).trans (h₂.symm.trans (Category.id_comp _))))
  have hConst_app_T : ∀ (Y : AlgebraicGeometry.Scheme.{u})
      (Q : CategoryTheory.Functor (Opposite Y.Etale) AddCommGrpCat.{u})
      (g₀ : Aℤ ⟶ Q.obj (Opposite.op (T_of Y))),
      (constPresheafHom Y Q g₀).app (Opposite.op (T_of Y)) = g₀ := by
    intro Y Q g₀
    dsimp only [constPresheafHom]
    have hid : Opposite.op ((hT_of Y).from (T_of Y)) = 𝟙 (Opposite.op (T_of Y)) :=
      congrArg Opposite.op ((hT_of Y).hom_ext ((hT_of Y).from (T_of Y)) (𝟙 (T_of Y)))
    rw [hid, Q.map_id, Category.comp_id]

  let uℤ_of : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
      Fℤ' Y₂ ⟶ (pf_of h).obj (Fℤ' Y₁) :=
    fun {Y₁ Y₂} h =>
      ((CategoryTheory.sheafificationAdjunction Y₂.smallEtaleTopology AddCommGrpCat.{u}).homEquiv
        (Pℤ Y₂) ((pf_of h).obj (Fℤ' Y₁))).symm
        (CategoryTheory.Functor.whiskerLeft (B_site h).op
          ((CategoryTheory.sheafificationAdjunction Y₁.smallEtaleTopology AddCommGrpCat.{u}).unit.app (Pℤ Y₁)))
  let cℤ_of : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
      (pb_of h).obj (Fℤ' Y₂) ⟶ Fℤ' Y₁ :=
    fun {Y₁ Y₂} h => ((adj_of h).homEquiv (Fℤ' Y₂) (Fℤ' Y₁)).symm (uℤ_of h)
  have hcℤ_iso : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
      CategoryTheory.IsIso (cℤ_of h) := by
    intro Y₁ Y₂ h
    let B_h := B_site h
    let τ_h : B_h.obj (T_of Y₂) ⟶ T_of Y₁ :=
      (hT_of Y₁).from (B_h.obj (T_of Y₂))
    let σ_left : Y₁ ⟶ CategoryTheory.Limits.pullback (T_of Y₂).hom h :=
      CategoryTheory.Limits.pullback.lift h (𝟙 Y₁)
        ((Category.comp_id h).trans (Category.id_comp h).symm)
    let σ_h : T_of Y₁ ⟶ B_h.obj (T_of Y₂) :=
      CategoryTheory.MorphismProperty.Over.homMk σ_left
        (CategoryTheory.Limits.pullback.lift_snd _ _ _) trivial
    have h_τσ_left : CategoryTheory.Limits.pullback.snd (T_of Y₂).hom h ≫ σ_left =
        𝟙 (CategoryTheory.Limits.pullback (T_of Y₂).hom h) := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · exact (Category.assoc _ _ _).trans
          ((congrArg (CategoryTheory.Limits.pullback.snd _ _ ≫ ·)
            (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
            (((CategoryTheory.Limits.pullback.condition (f := (T_of Y₂).hom) (g := h)).symm.trans
              (Category.comp_id _)).trans (Category.id_comp _).symm))
      · exact (Category.assoc _ _ _).trans
          ((congrArg (CategoryTheory.Limits.pullback.snd _ _ ≫ ·)
            (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
            ((Category.comp_id _).trans (Category.id_comp _).symm))
    have h_τσ : τ_h ≫ σ_h = 𝟙 (B_h.obj (T_of Y₂)) :=
      CategoryTheory.MorphismProperty.Comma.Hom.ext h_τσ_left (Subsingleton.elim _ _)
    let adj_sh₁ := CategoryTheory.sheafificationAdjunction Y₁.smallEtaleTopology AddCommGrpCat.{u}
    let adj_sh₂ := CategoryTheory.sheafificationAdjunction Y₂.smallEtaleTopology AddCommGrpCat.{u}
    let u_app : (Fℤ' Y₂).obj.obj (Opposite.op (T_of Y₂)) ⟶
        ((pb_of h).obj (Fℤ' Y₂)).obj.obj (Opposite.op (B_h.obj (T_of Y₂))) :=
      ((adj_of h).unit.app (Fℤ' Y₂)).hom.app (Opposite.op (T_of Y₂))
    let g₀ : Aℤ ⟶ ((pb_of h).obj (Fℤ' Y₂)).obj.obj (Opposite.op (T_of Y₁)) :=
      (adj_sh₂.unit.app (Pℤ Y₂)).app (Opposite.op (T_of Y₂)) ≫
        u_app ≫ ((pb_of h).obj (Fℤ' Y₂)).obj.map (Opposite.op σ_h)
    let dℤ : Fℤ' Y₁ ⟶ (pb_of h).obj (Fℤ' Y₂) :=
      (adj_sh₁.homEquiv (Pℤ Y₁) ((pb_of h).obj (Fℤ' Y₂))).symm
        (constPresheafHom Y₁ ((pb_of h).obj (Fℤ' Y₂)).obj g₀)
    have hdℤ_eq : adj_sh₁.unit.app (Pℤ Y₁) ≫ dℤ.hom =
        constPresheafHom Y₁ ((pb_of h).obj (Fℤ' Y₂)).obj g₀ :=
      (adj_sh₁.homEquiv (Pℤ Y₁) ((pb_of h).obj (Fℤ' Y₂))).apply_symm_apply _
    have huℤ_eq : adj_sh₂.unit.app (Pℤ Y₂) ≫ (uℤ_of h).hom =
        CategoryTheory.Functor.whiskerLeft B_h.op (adj_sh₁.unit.app (Pℤ Y₁)) :=
      (adj_sh₂.homEquiv (Pℤ Y₂) ((pf_of h).obj (Fℤ' Y₁))).apply_symm_apply _
    refine ⟨⟨dℤ, ?_, ?_⟩⟩
    · apply ((adj_of h).homEquiv (Fℤ' Y₂) ((pb_of h).obj (Fℤ' Y₂))).injective
      rw [Adjunction.homEquiv_naturality_right, Adjunction.homEquiv_id]
      dsimp only [cℤ_of]
      rw [Equiv.apply_symm_apply]
      apply (adj_sh₂.homEquiv (Pℤ Y₂) ((pf_of h).obj ((pb_of h).obj (Fℤ' Y₂)))).injective
      apply hConst_ext
      change ((adj_sh₂.unit.app (Pℤ Y₂) ≫ (uℤ_of h).hom) ≫ ((pf_of h).map dℤ).hom).app
          (Opposite.op (T_of Y₂)) =
        (adj_sh₂.unit.app (Pℤ Y₂)).app (Opposite.op (T_of Y₂)) ≫ u_app
      rw [huℤ_eq]
      change (adj_sh₁.unit.app (Pℤ Y₁)).app (Opposite.op (B_h.obj (T_of Y₂))) ≫
          dℤ.hom.app (Opposite.op (B_h.obj (T_of Y₂))) = _
      have hdℤ_app := congrArg (fun t => t.app (Opposite.op (B_h.obj (T_of Y₂)))) hdℤ_eq
      dsimp only [NatTrans.comp_app] at hdℤ_app
      rw [hdℤ_app]
      dsimp only [constPresheafHom, g₀]
      have h_op_τσ : Opposite.op σ_h ≫ Opposite.op τ_h = 𝟙 (Opposite.op (B_h.obj (T_of Y₂))) :=
        congrArg Opposite.op h_τσ
      have h_map_id : ((pb_of h).obj (Fℤ' Y₂)).obj.map (Opposite.op σ_h) ≫
          ((pb_of h).obj (Fℤ' Y₂)).obj.map (Opposite.op τ_h) = 𝟙 _ :=
        (((pb_of h).obj (Fℤ' Y₂)).obj.map_comp _ _).symm.trans
          ((congrArg ((pb_of h).obj (Fℤ' Y₂)).obj.map h_op_τσ).trans
            (((pb_of h).obj (Fℤ' Y₂)).obj.map_id _))
      exact (Category.assoc _ _ _).trans
        ((congrArg (_ ≫ ·) (Category.assoc _ _ _)).trans
          (congrArg (_ ≫ ·) ((congrArg (u_app ≫ ·) h_map_id).trans (Category.comp_id _))))
    · apply (adj_sh₁.homEquiv (Pℤ Y₁) (Fℤ' Y₁)).injective
      apply hConst_ext
      change ((adj_sh₁.unit.app (Pℤ Y₁) ≫ dℤ.hom) ≫ (cℤ_of h).hom).app (Opposite.op (T_of Y₁)) =
        (adj_sh₁.unit.app (Pℤ Y₁) ≫ 𝟙 _).app (Opposite.op (T_of Y₁))
      rw [hdℤ_eq, Category.comp_id]
      change (constPresheafHom Y₁ ((pb_of h).obj (Fℤ' Y₂)).obj g₀).app (Opposite.op (T_of Y₁)) ≫
          (cℤ_of h).hom.app (Opposite.op (T_of Y₁)) =
        (adj_sh₁.unit.app (Pℤ Y₁)).app (Opposite.op (T_of Y₁))
      rw [hConst_app_T]
      dsimp only [g₀]
      have h_c_nat : ((pb_of h).obj (Fℤ' Y₂)).obj.map (Opposite.op σ_h) ≫
          (cℤ_of h).hom.app (Opposite.op (T_of Y₁)) =
          (cℤ_of h).hom.app (Opposite.op (B_h.obj (T_of Y₂))) ≫
            (Fℤ' Y₁).obj.map (Opposite.op σ_h) :=
        (cℤ_of h).hom.naturality (Opposite.op σ_h)
      have hcℤ_mate : (adj_of h).unit.app (Fℤ' Y₂) ≫ (pf_of h).map (cℤ_of h) = uℤ_of h :=
        ((adj_of h).homEquiv_unit _ _ (cℤ_of h)).symm.trans (Equiv.apply_symm_apply _ _)
      have hcℤ_app : u_app ≫ (cℤ_of h).hom.app (Opposite.op (B_h.obj (T_of Y₂))) =
          (uℤ_of h).hom.app (Opposite.op (T_of Y₂)) :=
        congrArg (fun t => t.hom.app (Opposite.op (T_of Y₂))) hcℤ_mate
      have huℤ_app : (adj_sh₂.unit.app (Pℤ Y₂)).app (Opposite.op (T_of Y₂)) ≫
          (uℤ_of h).hom.app (Opposite.op (T_of Y₂)) =
          (adj_sh₁.unit.app (Pℤ Y₁)).app (Opposite.op (B_h.obj (T_of Y₂))) :=
        congrArg (fun t => t.app (Opposite.op (T_of Y₂))) huℤ_eq
      have h_nat : 𝟙 Aℤ ≫ (adj_sh₁.unit.app (Pℤ Y₁)).app (Opposite.op (T_of Y₁)) =
          (adj_sh₁.unit.app (Pℤ Y₁)).app (Opposite.op (B_h.obj (T_of Y₂))) ≫
            (Fℤ' Y₁).obj.map (Opposite.op σ_h) :=
        (adj_sh₁.unit.app (Pℤ Y₁)).naturality (Opposite.op σ_h)
      exact (Category.assoc _ _ _).trans
        ((congrArg (_ ≫ ·) ((Category.assoc _ _ _).trans
          ((congrArg (u_app ≫ ·) h_c_nat).trans
            ((Category.assoc _ _ _).symm.trans (congrArg (· ≫ _) hcℤ_app))))).trans
          ((Category.assoc _ _ _).symm.trans
            ((congrArg (· ≫ _) huℤ_app).trans (h_nat.symm.trans (Category.id_comp _)))))

  have hExt_natIso : ∀ {𝒞₁ 𝒞₂ : Type (u + 1)}
      [CategoryTheory.Category.{u + 1} 𝒞₁] [CategoryTheory.Category.{u + 1} 𝒞₂]
      [CategoryTheory.Abelian 𝒞₁] [CategoryTheory.Abelian 𝒞₂]
      [CategoryTheory.HasExt 𝒞₁] [CategoryTheory.HasExt 𝒞₂]
      [CategoryTheory.EnoughInjectives 𝒞₁]
      {G₁ G₂ : 𝒞₁ ⥤ 𝒞₂}
      [G₁.Additive] [CategoryTheory.Limits.PreservesFiniteLimits G₁]
      [CategoryTheory.Limits.PreservesFiniteColimits G₁]
      [G₂.Additive] [CategoryTheory.Limits.PreservesFiniteLimits G₂]
      [CategoryTheory.Limits.PreservesFiniteColimits G₂]
      (γ : G₁ ≅ G₂) (q : ℕ) {X Y : 𝒞₁} (α : CategoryTheory.Abelian.Ext X Y q),
      (CategoryTheory.Abelian.Ext.mapExactFunctor G₁ α).comp
        (CategoryTheory.Abelian.Ext.mk₀ (γ.hom.app Y)) (Nat.add_zero q) =
      (CategoryTheory.Abelian.Ext.mk₀ (γ.hom.app X)).comp
        (CategoryTheory.Abelian.Ext.mapExactFunctor G₂ α) (Nat.zero_add q) := by
    intro 𝒞₁ 𝒞₂ _ _ _ _ _ _ _ G₁ G₂ _ _ _ _ _ _ γ q
    induction q with
    | zero =>
      intro X Y α
      rw [← CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply α,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        γ.hom.naturality]
    | succ q ih =>
      intro X Y α
      let ι : Y ⟶ CategoryTheory.Injective.under Y := CategoryTheory.Injective.ι Y
      let S : CategoryTheory.ShortComplex 𝒞₁ :=
        CategoryTheory.ShortComplex.mk ι (CategoryTheory.Limits.cokernel.π ι)
          (CategoryTheory.Limits.cokernel.condition ι)
      have : CategoryTheory.Mono S.f := by
        dsimp [S, ι]
        infer_instance
      have : CategoryTheory.Epi S.g := by
        dsimp [S]
        infer_instance
      have hS : S.ShortExact := { exact := CategoryTheory.ShortComplex.exact_cokernel ι }
      have h_kill : α.comp (CategoryTheory.Abelian.Ext.mk₀ S.f) (Nat.add_zero (q + 1)) = 0 := by
        have : CategoryTheory.Injective S.X₂ := by
          dsimp [S]
          infer_instance
        exact CategoryTheory.Abelian.Ext.eq_zero_of_injective _
      obtain ⟨ξ, rfl⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ X hS α h_kill rfl
      have hS₁ : (S.map G₁).ShortExact := hS.map_of_exact G₁
      have hS₂ : (S.map G₂).ShortExact := hS.map_of_exact G₂
      let φ_S : S.map G₁ ⟶ S.map G₂ :=
        { τ₁ := γ.hom.app S.X₁
          τ₂ := γ.hom.app S.X₂
          τ₃ := γ.hom.app S.X₃
          comm₁₂ := (γ.hom.naturality S.f).symm
          comm₂₃ := (γ.hom.naturality S.g).symm }
      have h_ext_nat :=
        CategoryTheory.ShortComplex.ShortExact.extClass_naturality hS₁ hS₂ φ_S
      rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass G₁ hS,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass G₂ hS,
        CategoryTheory.Abelian.Ext.comp_assoc _ _ _ rfl (Nat.add_zero 1) (Nat.add_zero (q + 1)),
        h_ext_nat,
        ← CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero q) (Nat.zero_add 1) (by omega),
        ih ξ,
        CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.zero_add q) rfl (Nat.zero_add (q + 1))]

  have hExt_comp : ∀ {𝒞₁ 𝒞₂ 𝒞₃ : Type (u + 1)}
      [CategoryTheory.Category.{u + 1} 𝒞₁] [CategoryTheory.Category.{u + 1} 𝒞₂]
      [CategoryTheory.Category.{u + 1} 𝒞₃]
      [CategoryTheory.Abelian 𝒞₁] [CategoryTheory.Abelian 𝒞₂] [CategoryTheory.Abelian 𝒞₃]
      [CategoryTheory.HasExt 𝒞₁] [CategoryTheory.HasExt 𝒞₂] [CategoryTheory.HasExt 𝒞₃]
      [CategoryTheory.EnoughInjectives 𝒞₁]
      (G₁ : 𝒞₁ ⥤ 𝒞₂) (G₂ : 𝒞₂ ⥤ 𝒞₃)
      [G₁.Additive] [CategoryTheory.Limits.PreservesFiniteLimits G₁]
      [CategoryTheory.Limits.PreservesFiniteColimits G₁]
      [G₂.Additive] [CategoryTheory.Limits.PreservesFiniteLimits G₂]
      [CategoryTheory.Limits.PreservesFiniteColimits G₂]
      (q : ℕ) {X Y : 𝒞₁} (α : CategoryTheory.Abelian.Ext X Y q),
      CategoryTheory.Abelian.Ext.mapExactFunctor (G₁ ⋙ G₂) α =
        CategoryTheory.Abelian.Ext.mapExactFunctor G₂
          (CategoryTheory.Abelian.Ext.mapExactFunctor G₁ α) := by
    intro 𝒞₁ 𝒞₂ 𝒞₃ _ _ _ _ _ _ _ _ _ _ G₁ G₂ _ _ _ _ _ _ q
    induction q with
    | zero =>
      intro X Y α
      rw [← CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply α,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀]
      rfl
    | succ q ih =>
      intro X Y α
      let ι : Y ⟶ CategoryTheory.Injective.under Y := CategoryTheory.Injective.ι Y
      let S : CategoryTheory.ShortComplex 𝒞₁ :=
        CategoryTheory.ShortComplex.mk ι (CategoryTheory.Limits.cokernel.π ι)
          (CategoryTheory.Limits.cokernel.condition ι)
      have : CategoryTheory.Mono S.f := by
        dsimp [S, ι]
        infer_instance
      have : CategoryTheory.Epi S.g := by
        dsimp [S]
        infer_instance
      have hS : S.ShortExact := { exact := CategoryTheory.ShortComplex.exact_cokernel ι }
      have h_kill : α.comp (CategoryTheory.Abelian.Ext.mk₀ S.f) (Nat.add_zero (q + 1)) = 0 := by
        have : CategoryTheory.Injective S.X₂ := by
          dsimp [S]
          infer_instance
        exact CategoryTheory.Abelian.Ext.eq_zero_of_injective _
      obtain ⟨ξ, rfl⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ X hS α h_kill rfl
      rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass (G₁ ⋙ G₂) hS,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass G₁ hS,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass G₂ (hS.map_of_exact G₁),
        ih ξ]

  let e_pf_comp : ∀ {Y₀ Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}}
      (π₁ : Quiver.Hom Y₁ Y₀) (π₂ : Quiver.Hom Y₂ Y₀) (h : Quiver.Hom Y₁ Y₂)
      (h_eq : CategoryTheory.CategoryStruct.comp h π₂ = π₁),
      pf_of π₁ ≅ pf_of h ⋙ pf_of π₂ :=
    fun {Y₀ Y₁ Y₂} π₁ π₂ h h_eq =>
      let B₁ := B_site π₁
      let B₂ := B_site π₂
      let B_h := B_site h
      let e_B : CategoryTheory.Iso B₁ (CategoryTheory.Functor.comp B₂ B_h) :=
        CategoryTheory.Iso.trans
          (CategoryTheory.MorphismProperty.Over.pullbackCongr h_eq.symm)
          (CategoryTheory.MorphismProperty.Over.pullbackComp h π₂)
      let _ : (CategoryTheory.Functor.comp B₂ B_h).IsContinuous
          Y₀.smallEtaleTopology Y₁.smallEtaleTopology :=
        CategoryTheory.Functor.isContinuous_comp B₂ B_h
          Y₀.smallEtaleTopology Y₂.smallEtaleTopology Y₁.smallEtaleTopology
      (CategoryTheory.Functor.sheafPushforwardContinuousIso e_B
        AddCommGrpCat.{u} Y₀.smallEtaleTopology Y₁.smallEtaleTopology).trans
        (CategoryTheory.Functor.sheafPushforwardContinuousComp B₂ B_h
          AddCommGrpCat.{u} Y₀.smallEtaleTopology Y₂.smallEtaleTopology Y₁.smallEtaleTopology).symm

  let β_of : ∀ {Y₀ Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}}
      (π₁ : Quiver.Hom Y₁ Y₀) (π₂ : Quiver.Hom Y₂ Y₀) (h : Quiver.Hom Y₁ Y₂)
      (h_eq : CategoryTheory.CategoryStruct.comp h π₂ = π₁)
      (F : CategoryTheory.Sheaf Y₀.smallEtaleTopology AddCommGrpCat.{u}),
      (pb_of h).obj ((pb_of π₂).obj F) ⟶ (pb_of π₁).obj F :=
    fun {Y₀ Y₁ Y₂} π₁ π₂ h h_eq F =>
      ((adj_of h).homEquiv ((pb_of π₂).obj F) ((pb_of π₁).obj F)).symm
        (((adj_of π₂).homEquiv F ((pf_of h).obj ((pb_of π₁).obj F))).symm
          ((adj_of π₁).unit.app F ≫ (e_pf_comp π₁ π₂ h h_eq).hom.app ((pb_of π₁).obj F)))

  let φ_of : ∀ {Y₀ Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}}
      (π₁ : Quiver.Hom Y₁ Y₀) (π₂ : Quiver.Hom Y₂ Y₀) (h : Quiver.Hom Y₁ Y₂)
      (h_eq : CategoryTheory.CategoryStruct.comp h π₂ = π₁)
      (F : CategoryTheory.Sheaf Y₀.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ),
      ((pb_of π₂).obj F).H q →+ ((pb_of π₁).obj F).H q :=
    fun {Y₀ Y₁ Y₂} π₁ π₂ h h_eq F q =>
      have : CategoryTheory.IsIso (cℤ_of h) := hcℤ_iso h
      have : (pb_of h).Additive := hPbAdd h
      have : CategoryTheory.Limits.PreservesFiniteLimits (pb_of h) := hPbLim h
      have : CategoryTheory.Limits.PreservesFiniteColimits (pb_of h) := hPbColim h
      let cℤ_std : (pb_of h).obj (Fℤ Y₂) ⟶ Fℤ Y₁ := cℤ_of h
      have hcℤ_std : CategoryTheory.IsIso cℤ_std := hcℤ_iso h
      ((CategoryTheory.Abelian.Ext.mk₀ (β_of π₁ π₂ h h_eq F)).postcomp (Fℤ Y₁) (Nat.add_zero q)).comp
        (((CategoryTheory.Abelian.Ext.mk₀ (@CategoryTheory.inv _ _ _ _ cℤ_std hcℤ_std)).precomp
          ((pb_of h).obj ((pb_of π₂).obj F)) (Nat.zero_add q)).comp
          ((pb_of h).mapExtAddHom (Fℤ Y₂) ((pb_of π₂).obj F) q))

  have hMaps_iff : ∀ {Y₀ Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}}
      (π₁ : Quiver.Hom Y₁ Y₀) (π₂ : Quiver.Hom Y₂ Y₀) (h : Quiver.Hom Y₁ Y₂)
      (h_eq : CategoryTheory.CategoryStruct.comp h π₂ = π₁)
      (F : CategoryTheory.Sheaf Y₀.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ)
      (x₂ : ((pb_of π₂).obj F).H q) (x₁ : ((pb_of π₁).obj F).H q),
      WeilEtaleTrianglePullbackMapsTo π₁ π₂ h h_eq F q x₂ x₁ ↔
        φ_of π₁ π₂ h h_eq F q x₂ = x₁ := by
    intro Y₀ Y₁ Y₂ π₁ π₂ h h_eq F q x₂ x₁
    have he_pf_eq : ∀ (K : CategoryTheory.Sheaf Y₁.smallEtaleTopology AddCommGrpCat.{u}),
        (e_pf_comp π₁ π₂ h h_eq).hom.app K =
          (let e_B : CategoryTheory.Iso (B_site π₁)
              (CategoryTheory.Functor.comp (B_site π₂) (B_site h)) :=
            CategoryTheory.Iso.trans
              (CategoryTheory.MorphismProperty.Over.pullbackCongr h_eq.symm)
              (CategoryTheory.MorphismProperty.Over.pullbackComp h π₂)
           let _ : (CategoryTheory.Functor.comp (B_site π₂)
              (B_site h)).IsContinuous Y₀.smallEtaleTopology Y₁.smallEtaleTopology :=
            CategoryTheory.Functor.isContinuous_comp (B_site π₂)
              (B_site h) Y₀.smallEtaleTopology Y₂.smallEtaleTopology Y₁.smallEtaleTopology
           (CategoryTheory.Functor.sheafPushforwardContinuousIso e_B AddCommGrpCat.{u}
              Y₀.smallEtaleTopology Y₁.smallEtaleTopology).hom.app K) := by
      intro K
      apply CategoryTheory.Sheaf.hom_ext
      refine CategoryTheory.NatTrans.ext (funext fun ⟨V₀⟩ => ?_)
      exact CategoryTheory.Category.comp_id _
    have hβ_eq : β_of π₁ π₂ h h_eq F =
        ((adj_of h).homEquiv ((pb_of π₂).obj F) ((pb_of π₁).obj F)).symm
          (((adj_of π₂).homEquiv F ((pf_of h).obj ((pb_of π₁).obj F))).symm
            ((adj_of π₁).unit.app F ≫
              (let e_B : CategoryTheory.Iso (B_site π₁)
                  (CategoryTheory.Functor.comp (B_site π₂) (B_site h)) :=
                CategoryTheory.Iso.trans
                  (CategoryTheory.MorphismProperty.Over.pullbackCongr h_eq.symm)
                  (CategoryTheory.MorphismProperty.Over.pullbackComp h π₂)
               let _ : (CategoryTheory.Functor.comp (B_site π₂)
                  (B_site h)).IsContinuous Y₀.smallEtaleTopology Y₁.smallEtaleTopology :=
                CategoryTheory.Functor.isContinuous_comp (B_site π₂)
                  (B_site h) Y₀.smallEtaleTopology Y₂.smallEtaleTopology Y₁.smallEtaleTopology
               (CategoryTheory.Functor.sheafPushforwardContinuousIso e_B AddCommGrpCat.{u}
                  Y₀.smallEtaleTopology Y₁.smallEtaleTopology).hom.app ((pb_of π₁).obj F)))) := by
      dsimp only [β_of]
      rw [he_pf_eq]
    constructor
    · rintro ⟨_hc, _hr, _hAdd, _hLim, _hColim, _hcℤ, h_eq_ext⟩
      dsimp only [φ_of, AddMonoidHom.comp_apply]
      rw [hβ_eq]
      exact h_eq_ext
    · intro hφ_eq
      refine ⟨@hc_all Y₁ Y₂ h, @hr_all Y₁ Y₂ h, hPbAdd h, hPbLim h, hPbColim h, hcℤ_iso h, ?_⟩
      dsimp only [φ_of, AddMonoidHom.comp_apply] at hφ_eq
      rwa [← hβ_eq]

  refine ⟨?_, ?_, ?_⟩
  · intro Y₀ Y₁ Y₂ π₁ π₂ h h_eq F q
    exact ⟨φ_of π₁ π₂ h h_eq F q, hMaps_iff π₁ π₂ h h_eq F q⟩
  · intro Y₀ Y₁ Y₂ Y₃ π₁ π₂ π₃ h h' h_eq h'_eq h''_eq F q x₂ x₁ x₃ hMaps₁ hMaps₂
    rw [hMaps_iff] at hMaps₁ hMaps₂ ⊢
    subst hMaps₁
    subst hMaps₂
    have : (pb_of h).Additive := hPbAdd h
    have : CategoryTheory.Limits.PreservesFiniteLimits (pb_of h) := hPbLim h
    have : CategoryTheory.Limits.PreservesFiniteColimits (pb_of h) := hPbColim h
    have : (pb_of h').Additive := hPbAdd h'
    have : CategoryTheory.Limits.PreservesFiniteLimits (pb_of h') := hPbLim h'
    have : CategoryTheory.Limits.PreservesFiniteColimits (pb_of h') := hPbColim h'
    have : (pb_of (h' ≫ h)).Additive := hPbAdd (h' ≫ h)
    have : CategoryTheory.Limits.PreservesFiniteLimits (pb_of (h' ≫ h)) := hPbLim (h' ≫ h)
    have : CategoryTheory.Limits.PreservesFiniteColimits (pb_of (h' ≫ h)) := hPbColim (h' ≫ h)
    let α_hh' : ∀ M : CategoryTheory.Sheaf Y₂.smallEtaleTopology AddCommGrpCat.{u},
        (pb_of (h' ≫ h)).obj M ⟶ (pb_of h').obj ((pb_of h).obj M) :=
      fun M =>
        ((adj_of (h' ≫ h)).homEquiv M ((pb_of h').obj ((pb_of h).obj M))).symm
          ((adj_of h).unit.app M ≫
            (pf_of h).map ((adj_of h').unit.app ((pb_of h).obj M)) ≫
            (e_pf_comp (h' ≫ h) h h' rfl).inv.app ((pb_of h').obj ((pb_of h).obj M)))
    let γ_iso : pb_of h ⋙ pb_of h' ≅ pb_of (h' ≫ h) :=
      { hom :=
          { app := fun M => β_of (h' ≫ h) h h' rfl M
            naturality := fun M₁ M₂ f =>
              hMate_nat (adj_of (h' ≫ h)) (adj_of h) (adj_of h') (e_pf_comp (h' ≫ h) h h' rfl) f }
        inv :=
          { app := α_hh'
            naturality := fun M₁ M₂ f => by
              have h_inv_hom : ∀ M, α_hh' M ≫ β_of (h' ≫ h) h h' rfl M = 𝟙 _ :=
                fun M => (hMate_inv_hom (adj_of (h' ≫ h)) (adj_of h) (adj_of h')
                  (e_pf_comp (h' ≫ h) h h' rfl) M).1
              have h_nat : (pb_of h').map ((pb_of h).map f) ≫ β_of (h' ≫ h) h h' rfl M₂ =
                  β_of (h' ≫ h) h h' rfl M₁ ≫ (pb_of (h' ≫ h)).map f :=
                hMate_nat (adj_of (h' ≫ h)) (adj_of h) (adj_of h')
                  (e_pf_comp (h' ≫ h) h h' rfl) f
              calc
                (pb_of (h' ≫ h)).map f ≫ α_hh' M₂ =
                    (α_hh' M₁ ≫ β_of (h' ≫ h) h h' rfl M₁) ≫
                      (pb_of (h' ≫ h)).map f ≫ α_hh' M₂ := by
                  rw [h_inv_hom M₁, Category.id_comp]
                _ = α_hh' M₁ ≫ (β_of (h' ≫ h) h h' rfl M₁ ≫ (pb_of (h' ≫ h)).map f) ≫ α_hh' M₂ := by
                  simp (config := { zeta := false }) only [Category.assoc]
                _ = α_hh' M₁ ≫ ((pb_of h').map ((pb_of h).map f) ≫ β_of (h' ≫ h) h h' rfl M₂) ≫ α_hh' M₂ := by
                  rw [← h_nat]
                _ = α_hh' M₁ ≫ (pb_of h').map ((pb_of h).map f) := by
                  have h_hom_inv : β_of (h' ≫ h) h h' rfl M₂ ≫ α_hh' M₂ = 𝟙 _ :=
                    (hMate_inv_hom (adj_of (h' ≫ h)) (adj_of h) (adj_of h')
                      (e_pf_comp (h' ≫ h) h h' rfl) M₂).2
                  rw [Category.assoc ((pb_of h').map ((pb_of h).map f)), h_hom_inv, Category.comp_id] }
        hom_inv_id :=
          CategoryTheory.NatTrans.ext (funext fun M =>
            (hMate_inv_hom (adj_of (h' ≫ h)) (adj_of h) (adj_of h')
              (e_pf_comp (h' ≫ h) h h' rfl) M).2)
        inv_hom_id :=
          CategoryTheory.NatTrans.ext (funext fun M =>
            (hMate_inv_hom (adj_of (h' ≫ h)) (adj_of h) (adj_of h')
              (e_pf_comp (h' ≫ h) h h' rfl) M).1) }

    have : CategoryTheory.IsIso (cℤ_of h) := hcℤ_iso h
    have : CategoryTheory.IsIso (cℤ_of h') := hcℤ_iso h'
    have : CategoryTheory.IsIso (cℤ_of (h' ≫ h)) := hcℤ_iso (h' ≫ h)
    have hcℤ_fwd : γ_iso.hom.app (Fℤ' Y₂) ≫ cℤ_of (h' ≫ h) =
        (pb_of h').map (cℤ_of h) ≫ cℤ_of h' := by
      apply ((adj_of h').homEquiv ((pb_of h).obj (Fℤ' Y₂)) (Fℤ' Y₃)).injective
      apply ((adj_of h).homEquiv (Fℤ' Y₂) ((pf_of h').obj (Fℤ' Y₃))).injective
      have hLHS_mate : (adj_of h).homEquiv (Fℤ' Y₂) ((pf_of h').obj (Fℤ' Y₃))
          ((adj_of h').homEquiv ((pb_of h).obj (Fℤ' Y₂)) (Fℤ' Y₃)
            (γ_iso.hom.app (Fℤ' Y₂) ≫ cℤ_of (h' ≫ h))) =
          uℤ_of (h' ≫ h) ≫ (e_pf_comp (h' ≫ h) h h' rfl).hom.app (Fℤ' Y₃) := by
        rw [Adjunction.homEquiv_naturality_right, Adjunction.homEquiv_naturality_right]
        dsimp only [γ_iso, β_of]
        rw [Equiv.apply_symm_apply, Equiv.apply_symm_apply, Category.assoc]
        change (adj_of (h' ≫ h)).unit.app (Fℤ' Y₂) ≫
          ((e_pf_comp (h' ≫ h) h h' rfl).hom.app _ ≫
            (pf_of h' ⋙ pf_of h).map (cℤ_of (h' ≫ h))) = _
        have hu_hh' : (adj_of (h' ≫ h)).unit.app (Fℤ' Y₂) ≫
            (pf_of (h' ≫ h)).map (cℤ_of (h' ≫ h)) = uℤ_of (h' ≫ h) :=
          ((adj_of (h' ≫ h)).homEquiv_unit _ _ _).symm.trans (Equiv.apply_symm_apply _ _)
        rw [← (e_pf_comp (h' ≫ h) h h' rfl).hom.naturality (cℤ_of (h' ≫ h)),
          ← Category.assoc, hu_hh']
      have hRHS_mate : (adj_of h).homEquiv (Fℤ' Y₂) ((pf_of h').obj (Fℤ' Y₃))
          ((adj_of h').homEquiv ((pb_of h).obj (Fℤ' Y₂)) (Fℤ' Y₃)
            ((pb_of h').map (cℤ_of h) ≫ cℤ_of h')) =
          uℤ_of h ≫ (pf_of h).map (uℤ_of h') := by
        rw [Adjunction.homEquiv_naturality_left, Adjunction.homEquiv_naturality_right]
        dsimp only [cℤ_of]
        rw [Equiv.apply_symm_apply, Equiv.apply_symm_apply]
      rw [hLHS_mate, hRHS_mate]
      let adj_sh₂ := CategoryTheory.sheafificationAdjunction Y₂.smallEtaleTopology AddCommGrpCat.{u}
      let adj_sh₃ := CategoryTheory.sheafificationAdjunction Y₃.smallEtaleTopology AddCommGrpCat.{u}
      apply (adj_sh₂.homEquiv (Pℤ Y₂) ((pf_of h).obj ((pf_of h').obj (Fℤ' Y₃)))).injective
      refine CategoryTheory.NatTrans.ext (funext fun ⟨V₂⟩ => ?_)
      have huℤ_hh' : adj_sh₂.unit.app (Pℤ Y₂) ≫ (uℤ_of (h' ≫ h)).hom =
          CategoryTheory.Functor.whiskerLeft (B_site (h' ≫ h)).op (adj_sh₃.unit.app (Pℤ Y₃)) :=
        (adj_sh₂.homEquiv (Pℤ Y₂) ((pf_of (h' ≫ h)).obj (Fℤ' Y₃))).apply_symm_apply _
      have huℤ_h : adj_sh₂.unit.app (Pℤ Y₂) ≫ (uℤ_of h).hom =
          CategoryTheory.Functor.whiskerLeft (B_site h).op
            ((CategoryTheory.sheafificationAdjunction Y₁.smallEtaleTopology AddCommGrpCat.{u}).unit.app (Pℤ Y₁)) :=
        (adj_sh₂.homEquiv (Pℤ Y₂) ((pf_of h).obj (Fℤ' Y₁))).apply_symm_apply _
      change ((adj_sh₂.unit.app (Pℤ Y₂) ≫ (uℤ_of (h' ≫ h)).hom) ≫
            ((e_pf_comp (h' ≫ h) h h' rfl).hom.app (Fℤ' Y₃)).hom).app (Opposite.op V₂) =
        ((adj_sh₂.unit.app (Pℤ Y₂) ≫ (uℤ_of h).hom) ≫
          ((pf_of h).map (uℤ_of h')).hom).app (Opposite.op V₂)
      rw [huℤ_hh', huℤ_h]
      change ((adj_sh₃.unit.app (Pℤ Y₃)).app (Opposite.op ((B_site (h' ≫ h)).obj V₂)) ≫
            (((e_pf_comp (h' ≫ h) h h' rfl).hom.app (Fℤ' Y₃)).hom.app (Opposite.op V₂))) =
        ((CategoryTheory.sheafificationAdjunction Y₁.smallEtaleTopology AddCommGrpCat.{u}).unit.app
            (Pℤ Y₁)).app (Opposite.op ((B_site h).obj V₂)) ≫
          (uℤ_of h').hom.app (Opposite.op ((B_site h).obj V₂))
      have huℤ_h' : (CategoryTheory.sheafificationAdjunction Y₁.smallEtaleTopology AddCommGrpCat.{u}).unit.app
            (Pℤ Y₁) ≫ (uℤ_of h').hom =
          CategoryTheory.Functor.whiskerLeft (B_site h').op (adj_sh₃.unit.app (Pℤ Y₃)) :=
        ((CategoryTheory.sheafificationAdjunction Y₁.smallEtaleTopology AddCommGrpCat.{u}).homEquiv
          (Pℤ Y₁) ((pf_of h').obj (Fℤ' Y₃))).apply_symm_apply _
      have huℤ_app := congrArg (fun t => t.app (Opposite.op ((B_site h).obj V₂))) huℤ_h'
      dsimp only [NatTrans.comp_app] at huℤ_app
      rw [huℤ_app]
      let e_B_hh' : CategoryTheory.Iso (B_site (h' ≫ h))
          (CategoryTheory.Functor.comp (B_site h) (B_site h')) :=
        CategoryTheory.Iso.trans
          (CategoryTheory.MorphismProperty.Over.pullbackCongr (rfl : h' ≫ h = h' ≫ h))
          (CategoryTheory.MorphismProperty.Over.pullbackComp h' h)
      have he_app : ((e_pf_comp (h' ≫ h) h h' rfl).hom.app (Fℤ' Y₃)).hom.app (Opposite.op V₂) =
          (Fℤ' Y₃).obj.map (Opposite.op (e_B_hh'.inv.app V₂)) :=
        CategoryTheory.Category.comp_id _
      rw [he_app]
      have h_nat : 𝟙 Aℤ ≫ (adj_sh₃.unit.app (Pℤ Y₃)).app
            (Opposite.op ((B_site h').obj ((B_site h).obj V₂))) =
          (adj_sh₃.unit.app (Pℤ Y₃)).app (Opposite.op ((B_site (h' ≫ h)).obj V₂)) ≫
            (Fℤ' Y₃).obj.map (Opposite.op (e_B_hh'.inv.app V₂)) :=
        (adj_sh₃.unit.app (Pℤ Y₃)).naturality (Opposite.op (e_B_hh'.inv.app V₂))
      exact h_nat.symm.trans (Category.id_comp _)

    have hcℤ_inv : CategoryTheory.inv (cℤ_of h') ≫
        (pb_of h').map (CategoryTheory.inv (cℤ_of h)) ≫
        γ_iso.hom.app (Fℤ' Y₂) =
        CategoryTheory.inv (cℤ_of (h' ≫ h)) := by
      apply CategoryTheory.IsIso.eq_inv_of_hom_inv_id
      calc
        cℤ_of (h' ≫ h) ≫ CategoryTheory.inv (cℤ_of h') ≫
            (pb_of h').map (CategoryTheory.inv (cℤ_of h)) ≫ γ_iso.hom.app (Fℤ' Y₂)
          = (γ_iso.inv.app (Fℤ' Y₂) ≫ γ_iso.hom.app (Fℤ' Y₂) ≫ cℤ_of (h' ≫ h)) ≫
              CategoryTheory.inv (cℤ_of h') ≫
              (pb_of h').map (CategoryTheory.inv (cℤ_of h)) ≫ γ_iso.hom.app (Fℤ' Y₂) := by
            rw [← Category.assoc (γ_iso.inv.app (Fℤ' Y₂)), Iso.inv_hom_id_app, Category.id_comp]
        _ = γ_iso.inv.app (Fℤ' Y₂) ≫ ((pb_of h').map (cℤ_of h) ≫ cℤ_of h') ≫
              CategoryTheory.inv (cℤ_of h') ≫
              (pb_of h').map (CategoryTheory.inv (cℤ_of h)) ≫ γ_iso.hom.app (Fℤ' Y₂) := by
            rw [hcℤ_fwd, Category.assoc]
        _ = γ_iso.inv.app (Fℤ' Y₂) ≫ γ_iso.hom.app (Fℤ' Y₂) := by
            rw [Category.assoc ((pb_of h').map (cℤ_of h)),
