          bc_sec g₁ f₁ π₁ hpb₁ F₀ (evalH₀_fn (pb_obj g₁ (pf_obj f₀_a F₀)) x) := by
      intro Z₁ X₁ g₁ f₁ π₁ hpb₁ F₀ x
