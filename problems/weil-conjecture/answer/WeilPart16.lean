      have h_nat₃ : epf_23.inv.app (pb_f₂.obj (pb_f₃.obj X)) ≫
          pf_f₂₃.map (adj_f₁.unit.app (pb_f₂.obj (pb_f₃.obj X))) =
          pf_f₃.map (pf_f₂.map (adj_f₁.unit.app (pb_f₂.obj (pb_f₃.obj X)))) ≫
