    | succ q ih =>
      let J := CategoryTheory.Injective.under Y
      let ι_Y : Y ⟶ J := CategoryTheory.Injective.ι Y
      let S := CategoryTheory.ShortComplex.mk ι_Y (CategoryTheory.Limits.cokernel.π ι_Y)
        (CategoryTheory.Limits.cokernel.condition ι_Y)
      have hS : S.ShortExact := { exact := CategoryTheory.ShortComplex.exact_cokernel ι_Y }
      have he0 : e.comp (CategoryTheory.Abelian.Ext.mk₀ S.f) (Nat.add_zero (q + 1)) = 0 :=
        CategoryTheory.Abelian.Ext.eq_zero_of_injective _
      obtain ⟨y, rfl⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ X hS e he0 rfl
      let hS₁ := hS.map_of_exact F₁
      let hS₁₂ := hS₁.map_of_exact F₂
      let hS_G := hS.map_of_exact G
      let φ_τ : (S.map F₁).map F₂ ⟶ S.map G :=
        { τ₁ := τ.app S.X₁
          τ₂ := τ.app S.X₂
          τ₃ := τ.app S.X₃
          comm₁₂ := (τ.naturality S.f).symm
          comm₂₃ := (τ.naturality S.g).symm }
      have h_ext_nat := CategoryTheory.ShortComplex.ShortExact.extClass_naturality hS₁₂ hS_G φ_τ
      rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp F₁ y hS.extClass rfl,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass F₁ hS,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp F₂ _ hS₁.extClass rfl,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass F₂ hS₁,
        CategoryTheory.Abelian.Ext.comp_assoc _ hS₁₂.extClass _ rfl (Nat.add_zero 1) (Nat.add_zero (q + 1)),
        h_ext_nat,
        ← CategoryTheory.Abelian.Ext.comp_assoc _ (CategoryTheory.Abelian.Ext.mk₀ (τ.app S.X₃))
          hS_G.extClass (Nat.add_zero q) (Nat.zero_add 1) rfl,
        ih y,
        CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ (τ.app X)) _
          hS_G.extClass (Nat.zero_add q) rfl (Nat.zero_add (q + 1)),
        ← CategoryTheory.Abelian.Ext.mapExactFunctor_extClass G hS,
        ← CategoryTheory.Abelian.Ext.mapExactFunctor_comp G y hS.extClass rfl]

  
  
  
