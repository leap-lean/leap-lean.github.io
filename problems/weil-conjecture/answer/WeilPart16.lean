    obtain ⟨G, hG⟩ := hFT_E.out
    let S_fwd : Finset L' :=
      (G ×ˢ (Finset.univ : Finset (Fin N))).image (fun q => Φ (1 ⊗ₜ[D₀'] q.1) q.2)
