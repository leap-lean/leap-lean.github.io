        (((F₁.mapExtAddHom X Y q) x).comp
          (Abelian.Ext.mk₀ (ε.hom.app Y)) (Nat.add_zero q))
        (Nat.zero_add q) =
        (F₂.mapExtAddHom X Y q) x := by
    intro Z₁ Z₂ F₁ F₂ _ _ _ _ _ _ ε X Y q x
    simp only [Functor.mapExtAddHom_apply]
    induction q generalizing X Y with
    | zero =>
      obtain ⟨f, rfl⟩ := (Abelian.Ext.mk₀_bijective X Y).surjective x
      simp only [Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mk₀_comp_mk₀]
      congr 1
      rw [ε.hom.naturality f, ε.inv_hom_id_app_assoc]
    | succ q ih =>
      let ι := Injective.ι Y
      let π := Limits.cokernel.π ι
      let S := ShortComplex.mk ι π (Limits.cokernel.condition ι)
      have hS : S.ShortExact :=
        ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel ι) inferInstance inferInstance
      have : Injective S.X₂ := by
        dsimp [S]
        infer_instance
      let x' : Abelian.Ext X S.X₁ (q + 1) := x
      have hx0 : x'.comp (Abelian.Ext.mk₀ S.f) (Nat.add_zero (q + 1)) = 0 :=
        Abelian.Ext.eq_zero_of_injective _
      obtain ⟨x₀, hx₀⟩ := Abelian.Ext.covariant_sequence_exact₁ X hS x' hx0 rfl
      change (Abelian.Ext.mk₀ (ε.inv.app X)).comp
          (((Abelian.Ext.mapExactFunctor F₁ x').comp
            (Abelian.Ext.mk₀ (ε.hom.app S.X₁)) (Nat.add_zero (q + 1))))
          (Nat.zero_add (q + 1)) =
        Abelian.Ext.mapExactFunctor F₂ x'
      rw [← hx₀, Abelian.Ext.mapExactFunctor_comp,
        Abelian.Ext.mapExactFunctor_extClass,
        Abelian.Ext.mapExactFunctor_comp,
        Abelian.Ext.mapExactFunctor_extClass]
      let Ψ : S.map F₁ ⟶ S.map F₂ :=
        { τ₁ := ε.hom.app S.X₁
          τ₂ := ε.hom.app S.X₂
          τ₃ := ε.hom.app S.X₃
          comm₁₂ := (ε.hom.naturality S.f).symm
          comm₂₃ := (ε.hom.naturality S.g).symm }
      have hnat := ShortComplex.ShortExact.extClass_naturality
        (hS.map_of_exact F₁) (hS.map_of_exact F₂) Ψ
      dsimp [Ψ] at hnat
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, hnat,
        ← Abelian.Ext.comp_assoc_of_second_deg_zero,
        ← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ (ε.inv.app X))
          ((Abelian.Ext.mapExactFunctor F₁ x₀).comp (Abelian.Ext.mk₀ (ε.hom.app S.X₃)) (Nat.add_zero q))
          (hS.map_of_exact F₂).extClass (Nat.zero_add q) rfl (Nat.zero_add (q + 1)),
