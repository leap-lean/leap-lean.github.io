    let JointSurj := fun (X : 𝒞) (n : ℕ) (Λ : Type u) [CategoryTheory.SmallCategory Λ]
        (D : CategoryTheory.Functor Λ 𝒞) (c : CategoryTheory.Limits.Cocone D) =>
      ∀ (y : CategoryTheory.Abelian.Ext.{u} X c.pt n),
        ∃ (l : Λ) (x : CategoryTheory.Abelian.Ext.{u} X (D.obj l) n),
          (CategoryTheory.Abelian.Ext.mk₀ (c.ι.app l)).postcomp X (Nat.add_zero n) x = y
    let LocalVanish := fun (X : 𝒞) (n : ℕ) (Λ : Type u) [CategoryTheory.SmallCategory Λ]
        (D : CategoryTheory.Functor Λ 𝒞) (c : CategoryTheory.Limits.Cocone D) =>
      ∀ (l : Λ) (x : CategoryTheory.Abelian.Ext.{u} X (D.obj l) n),
        (CategoryTheory.Abelian.Ext.mk₀ (c.ι.app l)).postcomp X (Nat.add_zero n) x = 0 →
        ∃ (l' : Λ) (f : l ⟶ l'),
          (CategoryTheory.Abelian.Ext.mk₀ (D.map f)).postcomp X (Nat.add_zero n) x = 0
    obtain ⟨hPush, hSE_trans, hBiprod⟩ :=
      weil_etale_abelian_ext_filtered_colimit_pushout_and_shortExact Y
    obtain ⟨hEff, hCech⟩ :=
      weil_etale_cech_syzygy_and_local_affine_effacement Y
