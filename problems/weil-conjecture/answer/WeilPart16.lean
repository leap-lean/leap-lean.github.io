      change e₂_eqv G₂ (f ≫ u) = (u.hom.app (Opposite.op U)) (e₂_eqv G₁ f)
      rw [he₂_eval G₂ (f ≫ u), he₂_eval G₁ f, adj_sh.homEquiv_naturality_right f u]
      rfl
    have : AlgebraicGeometry.IsAffine U.left := hAffU
    let R : CommRingCat.{u} := U.left.presheaf.obj (Opposite.op ⊤)
    let e_sch : AlgebraicGeometry.Spec R ≅ U.left := (AlgebraicGeometry.Scheme.isoSpec U.left).symm
    have : AlgebraicGeometry.Etale e_sch.hom := inferInstance
    have : AlgebraicGeometry.Etale U.hom := U.prop
    have : AlgebraicGeometry.Etale (e_sch.hom ≫ U.hom) := inferInstance
    let U_aff : Y.AffineEtale := AlgebraicGeometry.Scheme.AffineEtale.mk (e_sch.hom ≫ U.hom)
    let iso_U : G_spec.obj U_aff ≅ U := CategoryTheory.MorphismProperty.Over.isoMk e_sch rfl
    let X_U : CategoryTheory.SmallModel.{u} Y.AffineEtale := E_mod.functor.obj U_aff
    let iso_et : G_spec.obj (E_mod.inverse.obj X_U) ≅ U :=
      G_spec.mapIso (E_mod.unitIso.symm.app U_aff) ≪≫ iso_U
    let e₃ : ∀ (G : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}),
        ↥(G.obj.obj (Opposite.op U)) ≃+ ↥((F_tr.obj G).obj.obj (Opposite.op X_U)) :=
      fun G => (G.obj.mapIso iso_et.op).addCommGroupIsoToAddEquiv
    have he₃_nat : ∀ {G₁ G₂ : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}}
        (u : G₁ ⟶ G₂) (s : ↥(G₁.obj.obj (Opposite.op U))),
        e₃ G₂ ((u.hom.app (Opposite.op U)) s) =
          (((F_tr.map u).hom.app (Opposite.op X_U)) (e₃ G₁ s)) := by
      intro G₁ G₂ u s
      change (G₂.obj.map iso_et.hom.op) ((u.hom.app (Opposite.op U)) s) =
        (u.hom.app (Opposite.op (G_spec.obj (E_mod.inverse.obj X_U))))
          ((G₁.obj.map iso_et.hom.op) s)
      exact congrArg (fun k => k s) (u.hom.naturality iso_et.hom.op).symm
    refine ⟨X_U, fun G => ((e₁ G).trans (e₂ G)).trans (e₃ G), ?_⟩
    intro G₁ G₂ u x
    dsimp only [AddEquiv.trans_apply]
    rw [he₁_nat u x, he₂_nat u (e₁ G₁ x), he₃_nat u (e₂ G₁ (e₁ G₁ x))]
  
  have : CategoryTheory.Limits.HasPullbacks (CategoryTheory.SmallModel.{u} Y.AffineEtale) := hPB
  obtain ⟨X_U, e, hNat⟩ := hChartEquiv
  have hc_small : CategoryTheory.Limits.IsColimit (F_tr.mapCocone c) :=
    CategoryTheory.Limits.isColimitOfPreserves F_tr hc
  obtain ⟨hJS, hLV⟩ := hSecColim (CategoryTheory.SmallModel.{u} Y.AffineEtale) J_small hQC
    (D.comp F_tr) (F_tr.mapCocone c) hc_small X_U
  refine ⟨?_, ?_⟩
  · intro y
    obtain ⟨l, x_sec, hx_sec⟩ := hJS (e c.pt y)
    let x := (e (D.obj l)).symm x_sec
    refine ⟨l, x, ?_⟩
    apply (e c.pt).injective
    have h1 : e c.pt (((CategoryTheory.Abelian.Ext.mk₀ (c.ι.app l)).postcomp Z_U (Nat.add_zero 0)) x) =
        (((F_tr.mapCocone c).ι.app l).hom.app (Opposite.op X_U)) (e (D.obj l) x) :=
      @hNat (D.obj l) c.pt (c.ι.app l) x
    rw [h1, (e (D.obj l)).apply_symm_apply x_sec]
    exact hx_sec
  · intro l x hx0
    have h1 : e c.pt (((CategoryTheory.Abelian.Ext.mk₀ (c.ι.app l)).postcomp Z_U (Nat.add_zero 0)) x) =
        (((F_tr.mapCocone c).ι.app l).hom.app (Opposite.op X_U)) (e (D.obj l) x) :=
      @hNat (D.obj l) c.pt (c.ι.app l) x
    have hx_sec0 : (((F_tr.mapCocone c).ι.app l).hom.app (Opposite.op X_U)) (e (D.obj l) x) = 0 := by
      rw [← h1, hx0, map_zero]
    obtain ⟨l', f, hf⟩ := hLV l (e (D.obj l) x) hx_sec0
    refine ⟨l', f, ?_⟩
    apply (e (D.obj l')).injective
    rw [@hNat (D.obj l) (D.obj l') (D.map f) x, map_zero]
    exact hf

theorem weil_etale_abelian_ext_filtered_colimit_pushout_and_shortExact (Y : AlgebraicGeometry.Scheme.{u}) :
    let 𝒞 := CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}
    let JointSurj := fun (X : 𝒞) (n : ℕ) (Λ : Type u) [CategoryTheory.SmallCategory Λ]
        (D : CategoryTheory.Functor Λ 𝒞) (c : CategoryTheory.Limits.Cocone D) =>
      ∀ (y : CategoryTheory.Abelian.Ext.{u} X c.pt n),
        ∃ (l : Λ) (x : CategoryTheory.Abelian.Ext.{u} X (D.obj l) n),
          (CategoryTheory.Abelian.Ext.mk₀ (c.ι.app l)).postcomp X (Nat.add_zero n) x = y
    let LocalVanish := fun (X : 𝒞) (n : ℕ) (Λ : Type u) [CategoryTheory.SmallCategory Λ]
        (D : CategoryTheory.Functor Λ 𝒞) (c : CategoryTheory.Limits.Cocone D) =>
      ∀ (l : Λ) (x : CategoryTheory.Abelian.Ext.{u} X (D.obj l) n),
        (CategoryTheory.Abelian.Ext.mk₀ (c.ι.app l)).postcomp X (Nat.add_zero n) x = 0 →
        ∃ (l' : Λ) (f : l ⟶ l'),
          (CategoryTheory.Abelian.Ext.mk₀ (D.map f)).postcomp X (Nat.add_zero n) x = 0
    (∀ (X : 𝒞) (r : ℕ),
      (∀ (𝒥 : Type u) [CategoryTheory.SmallCategory 𝒥] [CategoryTheory.IsFiltered 𝒥]
          (E : CategoryTheory.Functor 𝒥 𝒞) (cE : CategoryTheory.Limits.Cocone E),
        Nonempty (CategoryTheory.Limits.IsColimit cE) →
        JointSurj X r 𝒥 E cE) →
      ∀ (Λ : Type u) [CategoryTheory.SmallCategory Λ] [CategoryTheory.IsFiltered Λ]
          (D : CategoryTheory.Functor Λ 𝒞) (c : CategoryTheory.Limits.Cocone D),
        Nonempty (CategoryTheory.Limits.IsColimit c) →
        LocalVanish X (r + 1) Λ D c) ∧
    (∀ (SC : CategoryTheory.ShortComplex 𝒞),
      SC.ShortExact →
      ∀ (Λ : Type u) [CategoryTheory.SmallCategory Λ] [CategoryTheory.IsFiltered Λ]
        (D : CategoryTheory.Functor Λ 𝒞) (c : CategoryTheory.Limits.Cocone D),
        Nonempty (CategoryTheory.Limits.IsColimit c) →
        ((∀ (W' : 𝒞) (e : W' ⟶ SC.X₁),
            CategoryTheory.Epi e →
            JointSurj SC.X₂ 0 Λ D c →
            LocalVanish SC.X₂ 0 Λ D c →
            LocalVanish W' 0 Λ D c →
            JointSurj SC.X₃ 0 Λ D c ∧ LocalVanish SC.X₃ 0 Λ D c) ∧
         (∀ (r : ℕ),
            JointSurj SC.X₁ r Λ D c →
            LocalVanish SC.X₁ (r + 1) Λ D c →
            JointSurj SC.X₂ (r + 1) Λ D c →
            JointSurj SC.X₃ (r + 1) Λ D c))) ∧
    (∀ (A₁ A₂ : 𝒞) (n : ℕ)
        (Λ : Type u) [CategoryTheory.SmallCategory Λ] [CategoryTheory.IsFiltered Λ]
        (D : CategoryTheory.Functor Λ 𝒞) (c : CategoryTheory.Limits.Cocone D),
      Nonempty (CategoryTheory.Limits.IsColimit c) →
      JointSurj A₁ n Λ D c → LocalVanish A₁ n Λ D c →
      JointSurj A₂ n Λ D c → LocalVanish A₂ n Λ D c →
      JointSurj (CategoryTheory.Limits.biprod A₁ A₂) n Λ D c ∧
        LocalVanish (CategoryTheory.Limits.biprod A₁ A₂) n Λ D c) :=
by
  intro 𝒞 JointSurj LocalVanish
  have hPostComp : ∀ {A G₁ G₂ G₃ : 𝒞} {q : ℕ} (u : G₁ ⟶ G₂) (v : G₂ ⟶ G₃)
      (x : CategoryTheory.Abelian.Ext.{u} A G₁ q),
      ((CategoryTheory.Abelian.Ext.mk₀ (u ≫ v)).postcomp A (Nat.add_zero q)) x =
        ((CategoryTheory.Abelian.Ext.mk₀ v).postcomp A (Nat.add_zero q))
          (((CategoryTheory.Abelian.Ext.mk₀ u).postcomp A (Nat.add_zero q)) x) := by
    intro A G₁ G₂ G₃ q u v x
    change x.comp (CategoryTheory.Abelian.Ext.mk₀ (u ≫ v)) (Nat.add_zero q) =
      (x.comp (CategoryTheory.Abelian.Ext.mk₀ u) (Nat.add_zero q)).comp
        (CategoryTheory.Abelian.Ext.mk₀ v) (Nat.add_zero q)
    rw [← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ u v,
      ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero x
        (CategoryTheory.Abelian.Ext.mk₀ u) (CategoryTheory.Abelian.Ext.mk₀ v) (Nat.add_zero q)]
  have hPrePost : ∀ {A B G₁ G₂ : 𝒞} {p q n : ℕ} (hpq : p + q = n)
      (α : CategoryTheory.Abelian.Ext.{u} A B p)
      (x : CategoryTheory.Abelian.Ext.{u} B G₁ q) (u : G₁ ⟶ G₂),
      ((CategoryTheory.Abelian.Ext.mk₀ u).postcomp A (Nat.add_zero n)) (α.comp x hpq) =
        α.comp (((CategoryTheory.Abelian.Ext.mk₀ u).postcomp B (Nat.add_zero q)) x) hpq := by
    intro A B G₁ G₂ p q n hpq α x u
    exact CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero α x
      (CategoryTheory.Abelian.Ext.mk₀ u) hpq
  have hPreComp : ∀ {A₁ A₂ A₃ G : 𝒞} {q : ℕ} (u : A₁ ⟶ A₂) (v : A₂ ⟶ A₃)
      (x : CategoryTheory.Abelian.Ext.{u} A₃ G q),
      (CategoryTheory.Abelian.Ext.mk₀ (u ≫ v)).comp x (Nat.zero_add q) =
        (CategoryTheory.Abelian.Ext.mk₀ u).comp
          ((CategoryTheory.Abelian.Ext.mk₀ v).comp x (Nat.zero_add q)) (Nat.zero_add q) := by
    intro A₁ A₂ A₃ G q u v x
    rw [← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ u v,
      CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero
        (CategoryTheory.Abelian.Ext.mk₀ u) (CategoryTheory.Abelian.Ext.mk₀ v) x
        (Nat.zero_add q)]
  have hEpiPreInj : ∀ {A B G : 𝒞} (p : A ⟶ B) [CategoryTheory.Epi p]
      {x₁ x₂ : CategoryTheory.Abelian.Ext.{u} B G 0},
      (CategoryTheory.Abelian.Ext.mk₀ p).comp x₁ (Nat.zero_add 0) =
        (CategoryTheory.Abelian.Ext.mk₀ p).comp x₂ (Nat.zero_add 0) →
      x₁ = x₂ := by
    intro A B G p _ x₁ x₂ hx
    obtain ⟨f₁, rfl⟩ := (CategoryTheory.Abelian.Ext.mk₀_bijective B G).2 x₁
    obtain ⟨f₂, rfl⟩ := (CategoryTheory.Abelian.Ext.mk₀_bijective B G).2 x₂
    rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀] at hx
    have hpf : p ≫ f₁ = p ≫ f₂ := (CategoryTheory.Abelian.Ext.mk₀_bijective A G).1 hx
    rw [(CategoryTheory.cancel_epi p).mp hpf]
  have hCoconePost : ∀ {A : 𝒞} {q : ℕ} {Λ : Type u} [CategoryTheory.SmallCategory Λ]
      {D : CategoryTheory.Functor Λ 𝒞} (c : CategoryTheory.Limits.Cocone D)
      {l₁ l₂ : Λ} (φ : l₁ ⟶ l₂) (z : CategoryTheory.Abelian.Ext.{u} A (D.obj l₁) q),
      ((CategoryTheory.Abelian.Ext.mk₀ (c.ι.app l₂ : D.obj l₂ ⟶ c.pt)).postcomp A (Nat.add_zero q))
        (((CategoryTheory.Abelian.Ext.mk₀ (D.map φ)).postcomp A (Nat.add_zero q)) z) =
      ((CategoryTheory.Abelian.Ext.mk₀ (c.ι.app l₁ : D.obj l₁ ⟶ c.pt)).postcomp A (Nat.add_zero q)) z := by
    intro A q Λ _ D c l₁ l₂ φ z
    rw [← hPostComp (D.map φ) (c.ι.app l₂ : D.obj l₂ ⟶ c.pt) z]
    have hcw : (D.map φ ≫ c.ι.app l₂ : D.obj l₁ ⟶ c.pt) = (c.ι.app l₁ : D.obj l₁ ⟶ c.pt) :=
      c.w φ
    rw [hcw]
    rfl
  refine ⟨?_, ?_, ?_⟩
  · 
    intro X r hJS_r Λ _ _ D c ⟨hc⟩ l₀ α₀ hα₀
    let I₀ : 𝒞 := CategoryTheory.Injective.under (D.obj l₀)
    let u₀ : D.obj l₀ ⟶ I₀ := CategoryTheory.Injective.ι (D.obj l₀)
    let Q₀ : 𝒞 := CategoryTheory.Limits.cokernel u₀
    let p₀ : I₀ ⟶ Q₀ := CategoryTheory.Limits.cokernel.π u₀
    have h₀ : u₀ ≫ p₀ = 0 := CategoryTheory.Limits.cokernel.condition u₀
    let S₀ : CategoryTheory.ShortComplex 𝒞 := CategoryTheory.ShortComplex.mk u₀ p₀ h₀
    have hS₀ : S₀.ShortExact :=
      CategoryTheory.ShortComplex.ShortExact.mk'
        (CategoryTheory.ShortComplex.exact_of_g_is_cokernel S₀
          (CategoryTheory.Limits.cokernelIsCokernel u₀))
        inferInstance inferInstance
    have hα₀_I₀ : α₀.comp (CategoryTheory.Abelian.Ext.mk₀ S₀.f) (Nat.add_zero (r + 1)) = 0 := by
      have hInjDim : CategoryTheory.HasInjectiveDimensionLT I₀ 1 :=
        CategoryTheory.injective_iff_hasInjectiveDimensionLT_one.mp inferInstance
      rw [CategoryTheory.hasInjectiveDimensionLT_iff] at hInjDim
      exact hInjDim (r + 1) (Nat.le_add_left 1 r) _
    obtain ⟨β, hβ⟩ :=
      CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ X hS₀ α₀ hα₀_I₀ rfl
    let 𝒥 : Type u := CategoryTheory.StructuredArrow l₀ (CategoryTheory.Functor.id Λ)
    let π : 𝒥 ⥤ Λ := CategoryTheory.StructuredArrow.proj l₀ (CategoryTheory.Functor.id Λ)
    have : CategoryTheory.IsFiltered 𝒥 :=
      (CategoryTheory.Functor.final_iff_isFiltered_structuredArrow
        (CategoryTheory.Functor.id Λ)).mp inferInstance l₀
    have : π.Final := inferInstance
    have : CategoryTheory.IsConnected 𝒥 := CategoryTheory.IsFiltered.isConnected 𝒥
    let F₀ : 𝒥 ⥤ 𝒞 := (CategoryTheory.Functor.const 𝒥).obj (D.obj l₀)
    let F₁ : 𝒥 ⥤ 𝒞 := π ⋙ D
    let α_D : F₀ ⟶ F₁ :=
      { app := fun j => D.map j.hom
        naturality := fun j j' θ => by
          dsimp [F₀, F₁, π]
          rw [CategoryTheory.Category.id_comp, ← D.map_comp]
          congr 1
          exact (CategoryTheory.StructuredArrow.w θ).symm }
    let u_c := (CategoryTheory.Functor.const 𝒥).map u₀
    let p_c := (CategoryTheory.Functor.const 𝒥).map p₀
    have hSc : (S₀.map (CategoryTheory.Functor.const 𝒥)).ShortExact :=
      hS₀.map_of_exact (CategoryTheory.Functor.const 𝒥)
    have : CategoryTheory.Mono u_c := hSc.mono_f
    have : CategoryTheory.Epi p_c := hSc.epi_g
    let E : 𝒥 ⥤ 𝒞 := CategoryTheory.Limits.pushout α_D u_c
    let u_n : F₁ ⟶ E := CategoryTheory.Limits.pushout.inl α_D u_c
    let v_n : (CategoryTheory.Functor.const 𝒥).obj I₀ ⟶ E :=
      CategoryTheory.Limits.pushout.inr α_D u_c
    have h_zero_c : α_D ≫ (0 : F₁ ⟶ (CategoryTheory.Functor.const 𝒥).obj Q₀) = u_c ≫ p_c := by
      rw [CategoryTheory.Limits.comp_zero]
      dsimp [u_c, p_c]
      rw [← CategoryTheory.Functor.map_comp, h₀, CategoryTheory.Functor.map_zero]
    let p_n : E ⟶ (CategoryTheory.Functor.const 𝒥).obj Q₀ :=
      CategoryTheory.Limits.pushout.desc (0 : F₁ ⟶ (CategoryTheory.Functor.const 𝒥).obj Q₀) p_c h_zero_c
    have hu_p : u_n ≫ p_n = 0 := CategoryTheory.Limits.pushout.inl_desc _ _ _
    have hv_p : v_n ≫ p_n = p_c := CategoryTheory.Limits.pushout.inr_desc _ _ _
    have : CategoryTheory.Mono u_n := CategoryTheory.Abelian.mono_pushout_of_mono_g α_D u_c
    have : CategoryTheory.Epi p_n :=
      @CategoryTheory.epi_of_epi_fac _ _ _ _ _ v_n p_n p_c inferInstance hv_p
    have hcok_c := hSc.gIsCokernel
    let desc_n : ∀ (s : CategoryTheory.Limits.CokernelCofork u_n),
        (CategoryTheory.Functor.const 𝒥).obj Q₀ ⟶ s.pt :=
      fun s => hcok_c.desc (CategoryTheory.Limits.CokernelCofork.ofπ (v_n ≫ s.π) (by
        change (u_c ≫ v_n) ≫ s.π = 0
        rw [← CategoryTheory.Limits.pushout.condition, CategoryTheory.Category.assoc,
          s.condition, CategoryTheory.Limits.comp_zero]))
    have h_fac : ∀ (s : CategoryTheory.Limits.CokernelCofork u_n), p_n ≫ desc_n s = s.π := by
      intro s
      apply CategoryTheory.Limits.pushout.hom_ext
      · change (u_n ≫ p_n) ≫ desc_n s = u_n ≫ s.π
        rw [hu_p, CategoryTheory.Limits.zero_comp, s.condition]
      · change (v_n ≫ p_n) ≫ desc_n s = v_n ≫ s.π
        rw [hv_p]
        exact hcok_c.fac _ CategoryTheory.Limits.WalkingParallelPair.one
    have hcok_n : CategoryTheory.Limits.IsColimit
        (CategoryTheory.Limits.CokernelCofork.ofπ p_n hu_p) :=
      CategoryTheory.Limits.Cofork.IsColimit.mk _ desc_n h_fac
        (fun s m hm => (CategoryTheory.cancel_epi p_n).mp (hm.trans (h_fac s).symm))
    let S_fun : CategoryTheory.ShortComplex (𝒥 ⥤ 𝒞) :=
      CategoryTheory.ShortComplex.mk u_n p_n hu_p
    have hS_fun : S_fun.ShortExact :=
      CategoryTheory.ShortComplex.ShortExact.mk'
        (CategoryTheory.ShortComplex.exact_of_g_is_cokernel S_fun hcok_n)
        inferInstance inferInstance
    let colimJ := CategoryTheory.Limits.colim (J := 𝒥) (C := 𝒞)
    have hS_colim : (S_fun.map colimJ).ShortExact := hS_fun.map_of_exact colimJ
    let c₁ : CategoryTheory.Limits.Cocone F₁ := c.whisker π
    have hc₁ : CategoryTheory.Limits.IsColimit c₁ :=
      (CategoryTheory.Functor.Final.isColimitWhiskerEquiv π c).symm hc
    let cE : CategoryTheory.Limits.Cocone E := CategoryTheory.Limits.colimit.cocone E
    have hcE : CategoryTheory.Limits.IsColimit cE := CategoryTheory.Limits.colimit.isColimit E
    let c₃ := CategoryTheory.Limits.constCocone 𝒥 Q₀
    have hc₃ : CategoryTheory.Limits.IsColimit c₃ := CategoryTheory.Limits.isColimitConstCocone 𝒥 Q₀
    let e₁ : (S_fun.map colimJ).X₁ ≅ c.pt :=
      (CategoryTheory.Limits.colimit.isColimit F₁).coconePointUniqueUpToIso hc₁
    let e₃ : (S_fun.map colimJ).X₃ ≅ Q₀ :=
      (CategoryTheory.Limits.colimit.isColimit
        ((CategoryTheory.Functor.const 𝒥).obj Q₀)).coconePointUniqueUpToIso hc₃
    let u_inf : c.pt ⟶ cE.pt := e₁.inv ≫ (S_fun.map colimJ).f
    let p_inf : cE.pt ⟶ Q₀ := (S_fun.map colimJ).g ≫ e₃.hom
    have h_inf : u_inf ≫ p_inf = 0 := by
      dsimp only [u_inf, p_inf]
      rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc (S_fun.map colimJ).f,
        (S_fun.map colimJ).zero, CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.comp_zero]
    let S_inf : CategoryTheory.ShortComplex 𝒞 := CategoryTheory.ShortComplex.mk u_inf p_inf h_inf
    let iso_inf : S_fun.map colimJ ≅ S_inf :=
      CategoryTheory.ShortComplex.isoMk e₁ (CategoryTheory.Iso.refl cE.pt) e₃
        (by
          change e₁.hom ≫ (e₁.inv ≫ (S_fun.map colimJ).f) = (S_fun.map colimJ).f ≫ 𝟙 cE.pt
          rw [← CategoryTheory.Category.assoc, e₁.hom_inv_id, CategoryTheory.Category.id_comp]
          exact (CategoryTheory.Category.comp_id _).symm)
        (by
          change 𝟙 cE.pt ≫ p_inf = (S_fun.map colimJ).g ≫ e₃.hom
          rw [CategoryTheory.Category.id_comp])
    have hS_inf : S_inf.ShortExact := CategoryTheory.ShortComplex.shortExact_of_iso iso_inf hS_colim
    have hleg₁ : ∀ j : 𝒥, c.ι.app j.right ≫ u_inf = u_n.app j ≫ cE.ι.app j := by
      intro j
      dsimp [u_inf, colimJ, S_fun, cE]
      rw [← CategoryTheory.Category.assoc]
      have he₁ : c₁.ι.app j ≫ e₁.inv = CategoryTheory.Limits.colimit.ι F₁ j :=
        CategoryTheory.Limits.IsColimit.comp_coconePointUniqueUpToIso_inv
          (CategoryTheory.Limits.colimit.isColimit F₁) hc₁ j
      change (c₁.ι.app j ≫ e₁.inv) ≫ CategoryTheory.Limits.colimMap u_n = _
      rw [he₁, CategoryTheory.Limits.ι_colimMap]
    have hleg₃ : ∀ j : 𝒥, cE.ι.app j ≫ p_inf = p_n.app j := by
      intro j
      dsimp [p_inf, colimJ, S_fun, cE]
      rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.ι_colimMap,
        CategoryTheory.Category.assoc]
      have he₃ : CategoryTheory.Limits.colimit.ι ((CategoryTheory.Functor.const 𝒥).obj Q₀) j ≫ e₃.hom =
