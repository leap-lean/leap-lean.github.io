  have h_s3 : ∀ (D₀' L' E' : Type u) [CommRing D₀'] [CommRing L'] [Algebra D₀' L']
      [CommRing E'] [Algebra D₀' E'] [Module.Flat D₀' E'] [Algebra.FiniteType D₀' E']
      (N : ℕ) (Φ : TensorProduct D₀' L' E' ≃ₐ[L'] (Fin N → L')),
      ∃ (S : Finset L'),
