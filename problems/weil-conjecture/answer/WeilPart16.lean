    let φ₂' : (CategoryTheory.presheafToSheaf Y₂.smallEtaleTopology AddCommGrpCat.{u}).obj Pℤ₂ ⟶ pb₂.obj F₀ := φ₂
    have hShAdj_iff : (φ₂ ≫ γ = uℤ ≫ pf_h.map φ₁) ↔
