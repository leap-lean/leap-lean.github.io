          obtain ⟨η_inf, hη_inf⟩ :=
            CategoryTheory.Abelian.Ext.contravariant_sequence_exact₃ hSE₀ c.pt ξ hξ0 (Nat.add_comm 1 q)
          obtain ⟨l, η_l, hη_l⟩ := (hK_all q le_rfl 1 Λ D c hc).1 η_inf
          refine ⟨l, hSE₀.extClass.comp η_l (Nat.add_comm 1 q), ?_⟩
