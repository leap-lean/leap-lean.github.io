            (Opposite.op W)) one_W
        have h_step1 : (((pb_of w).map φ₁).hom.app (Opposite.op (T_of Y₂))) s₁ =
            (((pb_of w).obj N₁).obj.map (Opposite.op δ_w))
              ((((pf_of w).map ((pb_of w).map φ₁)).hom.app (Opposite.op W))
                ((((adj_of w).unit.app Fℤ₁).hom.app (Opposite.op W)) one_W)) :=
          h_pb_nat
        have h_step2 : ((((pf_of w).map ((pb_of w).map φ₁)).hom.app (Opposite.op W))
            ((((adj_of w).unit.app Fℤ₁).hom.app (Opposite.op W)) one_W)) =
            (((adj_of w).unit.app N₁).hom.app (Opposite.op W))
              ((φ₁.hom.app (Opposite.op W)) one_W) :=
          h_unit_nat
        exact congrArg (β_w.hom.app (Opposite.op (T_of Y₂)))
          (h_step1.trans
            (congrArg (((pb_of w).obj N₁).obj.map (Opposite.op δ_w))
              (h_step2.trans (congrArg (((adj_of w).unit.app N₁).hom.app (Opposite.op W)) h_res_W))))
      have h_RHS : (((CategoryTheory.CategoryStruct.comp cℤ φ₂).hom.app
          (Opposite.op (T_of Y₂))) s₁) = evalH₀ N₂ z₂ := by
        have h_c_nat := CategoryTheory.ConcreteCategory.congr_hom
          (cℤ.hom.naturality (Opposite.op δ_w))
          ((((adj_of w).unit.app Fℤ₁).hom.app (Opposite.op W)) one_W)
        have h_adj_c : CategoryTheory.CategoryStruct.comp ((adj_of w).unit.app Fℤ₁) ((pf_of w).map cℤ) = uℤ :=
          (((adj_of w).homEquiv_unit Fℤ₁ Fℤ₂ cℤ).symm).trans (Equiv.apply_symm_apply _ _)
        have h_adj_c_app := CategoryTheory.ConcreteCategory.congr_hom
          (CategoryTheory.NatTrans.congr_app
            (congrArg (CategoryTheory.sheafToPresheaf Y₁.smallEtaleTopology AddCommGrpCat.{u}).map h_adj_c)
            (Opposite.op W)) one_W
        let adj_sh₁ := CategoryTheory.sheafificationAdjunction Y₁.smallEtaleTopology AddCommGrpCat.{u}
        have h_sh_u : CategoryTheory.CategoryStruct.comp η_Y₁ uℤ.hom = η_w :=
          ((adj_sh₁.homEquiv_unit Pℤ₁ ((pf_of w).obj Fℤ₂) uℤ).symm).trans
            (Equiv.apply_symm_apply _ _)
        have h_sh_u_app := CategoryTheory.ConcreteCategory.congr_hom
          (CategoryTheory.NatTrans.congr_app h_sh_u (Opposite.op W)) one_Z
        have h_η₂_nat := CategoryTheory.ConcreteCategory.congr_hom
          (η_Y₂.naturality (Opposite.op δ_w)) one_Z
        have h_c_s₁ : (cℤ.hom.app (Opposite.op (T_of Y₂))) s₁ =
            (η_Y₂.app (Opposite.op (T_of Y₂))) one_Z :=
          h_c_nat.trans
            ((congrArg (Fℤ₂.obj.map (Opposite.op δ_w))
              (h_adj_c_app.trans h_sh_u_app)).trans h_η₂_nat.symm)
        exact congrArg (φ₂.hom.app (Opposite.op (T_of Y₂))) h_c_s₁
      exact h_RHS.symm.trans (h_eval_s₁.symm.trans h_LHS)

  
  
  
  have hMateIso : ∀ {Y₀ Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}}
      (p₁ : Quiver.Hom Y₁ Y₀) (p₂ : Quiver.Hom Y₂ Y₀) (h : Quiver.Hom Y₁ Y₂)
      (h_eq : CategoryTheory.CategoryStruct.comp h p₂ = p₁)
      (M : CategoryTheory.Sheaf Y₀.smallEtaleTopology AddCommGrpCat.{u}),
      CategoryTheory.IsIso (weilEtalePullMateInv p₁ p₂ h h_eq M) := by
    intro Y₀ Y₁ Y₂ p₁ p₂ h h_eq M
    let α_M := weilEtalePullMateHom p₁ p₂ h h_eq M
    let β_M := weilEtalePullMateInv p₁ p₂ h h_eq M
    let B₁ := weilEtaleSitePullback p₁
    let B₂ := weilEtaleSitePullback p₂
    let B_h := weilEtaleSitePullback h
    let e_B : CategoryTheory.Iso B₁ (CategoryTheory.Functor.comp B₂ B_h) :=
      CategoryTheory.Iso.trans
        (CategoryTheory.MorphismProperty.Over.pullbackCongr h_eq.symm)
        (CategoryTheory.MorphismProperty.Over.pullbackComp h p₂)
    letI : (CategoryTheory.Functor.comp B₂ B_h).IsContinuous
        Y₀.smallEtaleTopology Y₁.smallEtaleTopology :=
      CategoryTheory.Functor.isContinuous_comp B₂ B_h
        Y₀.smallEtaleTopology Y₂.smallEtaleTopology Y₁.smallEtaleTopology
    let e_pf := CategoryTheory.Functor.sheafPushforwardContinuousIso e_B
      AddCommGrpCat.{u} Y₀.smallEtaleTopology Y₁.smallEtaleTopology
    have h_epf_hom_nat : ∀ {A B : CategoryTheory.Sheaf Y₁.smallEtaleTopology AddCommGrpCat.{u}}
        (γ : Quiver.Hom A B),
        CategoryTheory.CategoryStruct.comp ((pf_of p₁).map γ) (e_pf.hom.app B) =
        CategoryTheory.CategoryStruct.comp (e_pf.hom.app A) ((pf_of p₂).map ((pf_of h).map γ)) :=
      fun γ => e_pf.hom.naturality γ
    have h_epf_inv_nat : ∀ {A B : CategoryTheory.Sheaf Y₁.smallEtaleTopology AddCommGrpCat.{u}}
        (γ : Quiver.Hom A B),
        CategoryTheory.CategoryStruct.comp (e_pf.inv.app A) ((pf_of p₁).map γ) =
        CategoryTheory.CategoryStruct.comp ((pf_of p₂).map ((pf_of h).map γ)) (e_pf.inv.app B) :=
      fun γ => (e_pf.inv.naturality γ).symm
    have hα_def : CategoryTheory.CategoryStruct.comp ((adj_of p₁).unit.app M) ((pf_of p₁).map α_M) =
        CategoryTheory.CategoryStruct.comp ((adj_of p₂).unit.app M)
          (CategoryTheory.CategoryStruct.comp
            ((pf_of p₂).map ((adj_of h).unit.app ((pb_of p₂).obj M)))
            (e_pf.inv.app ((pb_of h).obj ((pb_of p₂).obj M)))) :=
      (((adj_of p₁).homEquiv_unit M ((pb_of h).obj ((pb_of p₂).obj M)) α_M).symm).trans
        (Equiv.apply_symm_apply _ _)
    have hβ_mid : CategoryTheory.CategoryStruct.comp
        ((adj_of h).unit.app ((pb_of p₂).obj M)) ((pf_of h).map β_M) =
        ((adj_of p₂).homEquiv M ((pf_of h).obj ((pb_of p₁).obj M))).symm
          (CategoryTheory.CategoryStruct.comp ((adj_of p₁).unit.app M)
            (e_pf.hom.app ((pb_of p₁).obj M))) :=
      (((adj_of h).homEquiv_unit ((pb_of p₂).obj M) ((pb_of p₁).obj M) β_M).symm).trans
        (Equiv.apply_symm_apply _ _)
    have hβ_def : CategoryTheory.CategoryStruct.comp ((adj_of p₂).unit.app M)
        ((pf_of p₂).map (CategoryTheory.CategoryStruct.comp
          ((adj_of h).unit.app ((pb_of p₂).obj M)) ((pf_of h).map β_M))) =
        CategoryTheory.CategoryStruct.comp ((adj_of p₁).unit.app M)
          (e_pf.hom.app ((pb_of p₁).obj M)) := by
      rw [hβ_mid]
      exact (((adj_of p₂).homEquiv_unit M ((pf_of h).obj ((pb_of p₁).obj M)) _).symm).trans
        (Equiv.apply_symm_apply _ _)
    refine ⟨⟨α_M, ?_, ?_⟩⟩
    · apply ((adj_of h).homEquiv ((pb_of p₂).obj M) ((pb_of h).obj ((pb_of p₂).obj M))).injective
      apply ((adj_of p₂).homEquiv M ((pf_of h).obj ((pb_of h).obj ((pb_of p₂).obj M)))).injective
      let N_comp := (pb_of h).obj ((pb_of p₂).obj M)
      have h1 : (adj_of h).homEquiv ((pb_of p₂).obj M) N_comp
          (CategoryTheory.CategoryStruct.comp β_M α_M) =
          CategoryTheory.CategoryStruct.comp
            (CategoryTheory.CategoryStruct.comp ((adj_of h).unit.app ((pb_of p₂).obj M)) ((pf_of h).map β_M))
            ((pf_of h).map α_M) :=
        ((adj_of h).homEquiv_unit ((pb_of p₂).obj M) N_comp _).trans
          ((congrArg (CategoryTheory.CategoryStruct.comp ((adj_of h).unit.app _))
            ((pf_of h).map_comp β_M α_M)).trans
            (CategoryTheory.Category.assoc _ _ _).symm)
      have hL : (adj_of p₂).homEquiv M ((pf_of h).obj N_comp)
          ((adj_of h).homEquiv ((pb_of p₂).obj M) N_comp
            (CategoryTheory.CategoryStruct.comp β_M α_M)) =
          CategoryTheory.CategoryStruct.comp ((adj_of p₂).unit.app M)
            ((pf_of p₂).map ((adj_of h).unit.app ((pb_of p₂).obj M))) :=
        (congrArg ((adj_of p₂).homEquiv M ((pf_of h).obj N_comp)) h1).trans
          (((adj_of p₂).homEquiv_unit M ((pf_of h).obj N_comp) _).trans
            ((congrArg (CategoryTheory.CategoryStruct.comp ((adj_of p₂).unit.app M))
              ((pf_of p₂).map_comp _ ((pf_of h).map α_M))).trans
              ((CategoryTheory.Category.assoc _ _ _).symm.trans
                ((congrArg (fun k => CategoryTheory.CategoryStruct.comp k ((pf_of p₂).map ((pf_of h).map α_M)))
                  hβ_def).trans
                  ((CategoryTheory.Category.assoc ((adj_of p₁).unit.app M) _ _).trans
                    ((congrArg (CategoryTheory.CategoryStruct.comp ((adj_of p₁).unit.app M))
                      (h_epf_hom_nat α_M).symm).trans
                      ((CategoryTheory.Category.assoc ((adj_of p₁).unit.app M) ((pf_of p₁).map α_M) _).symm.trans
                        ((congrArg (fun k => CategoryTheory.CategoryStruct.comp k (e_pf.hom.app N_comp))
                          hα_def).trans
                          ((CategoryTheory.Category.assoc ((adj_of p₂).unit.app M) _ _).trans
                            (congrArg (CategoryTheory.CategoryStruct.comp ((adj_of p₂).unit.app M))
                              ((CategoryTheory.Category.assoc _ _ _).trans
                                ((congrArg (CategoryTheory.CategoryStruct.comp _)
                                  (e_pf.inv_hom_id_app N_comp)).trans
                                  (CategoryTheory.Category.comp_id _)))))))))))))
      have hR_inner : (adj_of h).homEquiv ((pb_of p₂).obj M) N_comp
          (CategoryTheory.CategoryStruct.id N_comp) =
          (adj_of h).unit.app ((pb_of p₂).obj M) :=
        ((adj_of h).homEquiv_unit ((pb_of p₂).obj M) N_comp _).trans
          ((congrArg (CategoryTheory.CategoryStruct.comp ((adj_of h).unit.app _))
            ((pf_of h).map_id N_comp)).trans
            (CategoryTheory.Category.comp_id _))
      have hR : (adj_of p₂).homEquiv M ((pf_of h).obj N_comp)
          ((adj_of h).homEquiv ((pb_of p₂).obj M) N_comp
            (CategoryTheory.CategoryStruct.id N_comp)) =
          CategoryTheory.CategoryStruct.comp ((adj_of p₂).unit.app M)
            ((pf_of p₂).map ((adj_of h).unit.app ((pb_of p₂).obj M))) :=
        (congrArg ((adj_of p₂).homEquiv M ((pf_of h).obj N_comp)) hR_inner).trans
          ((adj_of p₂).homEquiv_unit M ((pf_of h).obj N_comp) _)
      exact hL.trans hR.symm
    · apply ((adj_of p₁).homEquiv M ((pb_of p₁).obj M)).injective
      let N₁ := (pb_of p₁).obj M
      have hL : (adj_of p₁).homEquiv M N₁ (CategoryTheory.CategoryStruct.comp α_M β_M) =
          (adj_of p₁).unit.app M :=
        ((adj_of p₁).homEquiv_unit M N₁ (CategoryTheory.CategoryStruct.comp α_M β_M)).trans
          ((congrArg (CategoryTheory.CategoryStruct.comp ((adj_of p₁).unit.app M))
            ((pf_of p₁).map_comp α_M β_M)).trans
            ((CategoryTheory.Category.assoc _ _ _).symm.trans
              ((congrArg (fun k => CategoryTheory.CategoryStruct.comp k ((pf_of p₁).map β_M)) hα_def).trans
                ((CategoryTheory.Category.assoc ((adj_of p₂).unit.app M) _ _).trans
                  ((congrArg (CategoryTheory.CategoryStruct.comp ((adj_of p₂).unit.app M))
                    ((CategoryTheory.Category.assoc _ _ _).trans
                      ((congrArg (CategoryTheory.CategoryStruct.comp _) (h_epf_inv_nat β_M)).trans
                        ((CategoryTheory.Category.assoc _ _ _).symm.trans
                          (congrArg (fun k => CategoryTheory.CategoryStruct.comp k (e_pf.inv.app N₁))
                            ((pf_of p₂).map_comp _ _).symm))))).trans
                    ((CategoryTheory.Category.assoc ((adj_of p₂).unit.app M) _ _).symm.trans
                      ((congrArg (fun k => CategoryTheory.CategoryStruct.comp k (e_pf.inv.app N₁)) hβ_def).trans
                        ((CategoryTheory.Category.assoc _ _ _).trans
                          ((congrArg (CategoryTheory.CategoryStruct.comp ((adj_of p₁).unit.app M))
                            (e_pf.hom_inv_id_app N₁)).trans
                            (CategoryTheory.Category.comp_id _))))))))))
      have hR : (adj_of p₁).homEquiv M N₁ (CategoryTheory.CategoryStruct.id N₁) =
          (adj_of p₁).unit.app M :=
        ((adj_of p₁).homEquiv_unit M N₁ (CategoryTheory.CategoryStruct.id N₁)).trans
          ((congrArg (CategoryTheory.CategoryStruct.comp ((adj_of p₁).unit.app M))
            ((pf_of p₁).map_id N₁)).trans
            (CategoryTheory.Category.comp_id _))
      exact hL.trans hR.symm

  
  have hTriInvFst : ∀ {A B C : AlgebraicGeometry.Scheme.{u}}
      (p : Quiver.Hom A B) (q : Quiver.Hom B C) (r : Quiver.Hom A C)
      (h_eq : CategoryTheory.CategoryStruct.comp p q = r) (U : C.Etale),
      let e_tri : CategoryTheory.Iso (weilEtaleSitePullback r)
          (CategoryTheory.Functor.comp (weilEtaleSitePullback q) (weilEtaleSitePullback p)) :=
        CategoryTheory.Iso.trans
          (CategoryTheory.MorphismProperty.Over.pullbackCongr h_eq.symm)
          (CategoryTheory.MorphismProperty.Over.pullbackComp p q)
      (e_tri.inv.app U).left ≫ CategoryTheory.Limits.pullback.fst U.hom r =
        CategoryTheory.Limits.pullback.fst ((weilEtaleSitePullback q).obj U).hom p ≫
          CategoryTheory.Limits.pullback.fst U.hom q := by
    intro A B C p q r h_eq U
    let e_congr : CategoryTheory.Iso (weilEtaleSitePullback r) (weilEtaleSitePullback (p ≫ q)) :=
      CategoryTheory.MorphismProperty.Over.pullbackCongr h_eq.symm
    let e_comp : CategoryTheory.Iso (weilEtaleSitePullback (p ≫ q))
        (CategoryTheory.Functor.comp (weilEtaleSitePullback q) (weilEtaleSitePullback p)) :=
      CategoryTheory.MorphismProperty.Over.pullbackComp p q
    let c_congr : CategoryTheory.Iso ((weilEtaleSitePullback r).obj U)
        ((weilEtaleSitePullback (p ≫ q)).obj U) := e_congr.app U
    let c_comp : CategoryTheory.Iso ((weilEtaleSitePullback (p ≫ q)).obj U)
        ((weilEtaleSitePullback p).obj ((weilEtaleSitePullback q).obj U)) := e_comp.app U
    have h1_hom : c_congr.hom.left ≫ CategoryTheory.Limits.pullback.fst U.hom (p ≫ q) =
        CategoryTheory.Limits.pullback.fst U.hom r :=
      CategoryTheory.MorphismProperty.Over.pullbackCongr_hom_app_left_fst h_eq.symm U
    have h1_id : c_congr.inv.left ≫ c_congr.hom.left =
        CategoryTheory.CategoryStruct.id (((weilEtaleSitePullback (p ≫ q)).obj U).left) :=
      congrArg (fun m : Quiver.Hom ((weilEtaleSitePullback (p ≫ q)).obj U)
        ((weilEtaleSitePullback (p ≫ q)).obj U) => m.left) c_congr.inv_hom_id
    have h1_inv : c_congr.inv.left ≫ CategoryTheory.Limits.pullback.fst U.hom r =
        CategoryTheory.Limits.pullback.fst U.hom (p ≫ q) :=
      (congrArg (c_congr.inv.left ≫ ·) h1_hom.symm).trans
        ((CategoryTheory.Category.assoc _ _ _).symm.trans
          ((congrArg (· ≫ CategoryTheory.Limits.pullback.fst U.hom (p ≫ q)) h1_id).trans
            (CategoryTheory.Category.id_comp _)))
    have h2_hom : c_comp.hom.left ≫
        (CategoryTheory.Limits.pullback.fst ((weilEtaleSitePullback q).obj U).hom p ≫
          CategoryTheory.Limits.pullback.fst U.hom q) =
        CategoryTheory.Limits.pullback.fst U.hom (p ≫ q) :=
      CategoryTheory.MorphismProperty.Over.pullbackComp_left_fst_fst p q U
    have h2_id : c_comp.inv.left ≫ c_comp.hom.left =
        CategoryTheory.CategoryStruct.id
          (((weilEtaleSitePullback p).obj ((weilEtaleSitePullback q).obj U)).left) :=
      congrArg (fun m : Quiver.Hom ((weilEtaleSitePullback p).obj ((weilEtaleSitePullback q).obj U))
        ((weilEtaleSitePullback p).obj ((weilEtaleSitePullback q).obj U)) => m.left) c_comp.inv_hom_id
    have h2_inv : c_comp.inv.left ≫ CategoryTheory.Limits.pullback.fst U.hom (p ≫ q) =
        CategoryTheory.Limits.pullback.fst ((weilEtaleSitePullback q).obj U).hom p ≫
          CategoryTheory.Limits.pullback.fst U.hom q :=
      (congrArg (c_comp.inv.left ≫ ·) h2_hom.symm).trans
        ((CategoryTheory.Category.assoc _ _ _).symm.trans
          ((congrArg (· ≫ _) h2_id).trans
            (CategoryTheory.Category.id_comp _)))
    exact (CategoryTheory.Category.assoc c_comp.inv.left c_congr.inv.left _).trans
      ((congrArg (c_comp.inv.left ≫ ·) h1_inv).trans h2_inv)

  have hSqInvFstFst : ∀ {A B C D : AlgebraicGeometry.Scheme.{u}}
      (π' : Quiver.Hom A B) (f' : Quiver.Hom A C) (f : Quiver.Hom B D) (g : Quiver.Hom C D)
      (hw : CategoryTheory.CategoryStruct.comp π' f = CategoryTheory.CategoryStruct.comp f' g)
      (U : D.Etale),
      let e_sq : CategoryTheory.Iso
          (CategoryTheory.Functor.comp (weilEtaleSitePullback f) (weilEtaleSitePullback π'))
          (CategoryTheory.Functor.comp (weilEtaleSitePullback g) (weilEtaleSitePullback f')) :=
        CategoryTheory.Iso.trans
          (CategoryTheory.Iso.symm (CategoryTheory.MorphismProperty.Over.pullbackComp π' f))
          (CategoryTheory.Iso.trans
            (CategoryTheory.MorphismProperty.Over.pullbackCongr hw)
            (CategoryTheory.MorphismProperty.Over.pullbackComp f' g))
      (e_sq.inv.app U).left ≫
          (CategoryTheory.Limits.pullback.fst ((weilEtaleSitePullback f).obj U).hom π' ≫
            CategoryTheory.Limits.pullback.fst U.hom f) =
        CategoryTheory.Limits.pullback.fst ((weilEtaleSitePullback g).obj U).hom f' ≫
          CategoryTheory.Limits.pullback.fst U.hom g := by
    intro A B C D π' f' f g hw U
    let e_left : CategoryTheory.Iso (weilEtaleSitePullback (π' ≫ f))
        (CategoryTheory.Functor.comp (weilEtaleSitePullback f) (weilEtaleSitePullback π')) :=
      CategoryTheory.MorphismProperty.Over.pullbackComp π' f
    let c_left : CategoryTheory.Iso ((weilEtaleSitePullback (π' ≫ f)).obj U)
        ((weilEtaleSitePullback π').obj ((weilEtaleSitePullback f).obj U)) := e_left.app U
    have hL : c_left.hom.left ≫
        (CategoryTheory.Limits.pullback.fst ((weilEtaleSitePullback f).obj U).hom π' ≫
          CategoryTheory.Limits.pullback.fst U.hom f) =
        CategoryTheory.Limits.pullback.fst U.hom (π' ≫ f) :=
      CategoryTheory.MorphismProperty.Over.pullbackComp_left_fst_fst π' f U
    have hR := hTriInvFst f' g (π' ≫ f) hw.symm U
    exact (CategoryTheory.Category.assoc _ c_left.hom.left _).trans
      ((congrArg (_ ≫ ·) hL).trans hR)

  have hHorizSquare : ∀ {Z₁ X₁ Z₂ X₂ : AlgebraicGeometry.Scheme.{u}}
      (g₁ : Quiver.Hom Z₁ Z₀) (f₁ : Quiver.Hom X₁ Z₁) (π₁ : Quiver.Hom X₁ X₀)
      (hpb₁ : CategoryTheory.IsPullback π₁ f₁ f₀ g₁)
      (F₀ : CategoryTheory.Sheaf X₀.smallEtaleTopology AddCommGrpCat.{u})
      (v : Quiver.Hom Z₂ Z₁) (hv : AlgebraicGeometry.Etale v)
      (f₂ : Quiver.Hom X₂ Z₂) (v_X : Quiver.Hom X₂ X₁)
      (π₂ : Quiver.Hom X₂ X₀) (g₂ : Quiver.Hom Z₂ Z₀)
      (hpb_v : CategoryTheory.IsPullback v_X f₂ f₁ v)
      (hv_π : CategoryTheory.CategoryStruct.comp v_X π₁ = π₂)
      (hv_g : CategoryTheory.CategoryStruct.comp v g₁ = g₂)
      (hpb₂ : CategoryTheory.IsPullback π₂ f₂ f₀ g₂),
      let M₀ := (pf_of f₀).obj F₀
      let G₁ := (pb_of g₁).obj M₀
      let G₂ := (pb_of g₂).obj M₀
      let K₁ := (pb_of π₁).obj F₀
      let K₂ := (pb_of π₂).obj F₀
      let H₁ := (pf_of f₁).obj K₁
      let H₂ := (pf_of f₂).obj K₂
      let V : Z₁.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ v hv
      let δ_v : Quiver.Hom (T_of Z₂) ((weilEtaleSitePullback v).obj V) :=
        CategoryTheory.MorphismProperty.Over.homMk
          (CategoryTheory.Limits.pullback.lift
            (CategoryTheory.CategoryStruct.id Z₂)
            (CategoryTheory.CategoryStruct.id Z₂) rfl)
          (CategoryTheory.Limits.pullback.lift_snd _ _ _) trivial
      let hv_X : AlgebraicGeometry.Etale v_X :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_v.flip hv
      let V_X : X₁.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ v_X hv_X
      let δ_vX : Quiver.Hom (T_of X₂) ((weilEtaleSitePullback v_X).obj V_X) :=
        CategoryTheory.MorphismProperty.Over.homMk
          (CategoryTheory.Limits.pullback.lift
            (CategoryTheory.CategoryStruct.id X₂)
            (CategoryTheory.CategoryStruct.id X₂) rfl)
          (CategoryTheory.Limits.pullback.lift_snd _ _ _) trivial
      let e_VX : CategoryTheory.Iso V_X ((weilEtaleSitePullback f₁).obj V) :=
        CategoryTheory.MorphismProperty.Over.isoMk
          hpb_v.flip.isoPullback hpb_v.flip.isoPullback_hom_snd
      let τ_f₂ : Quiver.Hom ((weilEtaleSitePullback f₂).obj (T_of Z₂)) (T_of X₂) :=
        CategoryTheory.MorphismProperty.Over.homMk
          ((weilEtaleSitePullback f₂).obj (T_of Z₂)).hom
          (CategoryTheory.Category.comp_id _)
      let α_G : Quiver.Hom (G₁.obj.obj (Opposite.op V)) (G₂.obj.obj (Opposite.op (T_of Z₂))) :=
        CategoryTheory.CategoryStruct.comp
          (CategoryTheory.CategoryStruct.comp
            (((adj_of v).unit.app G₁).hom.app (Opposite.op V))
            (((pb_of v).obj G₁).obj.map (Opposite.op δ_v)))
          ((weilEtalePullMateInv g₂ g₁ v hv_g M₀).hom.app (Opposite.op (T_of Z₂)))
      let α_H : Quiver.Hom (H₁.obj.obj (Opposite.op V)) (H₂.obj.obj (Opposite.op (T_of Z₂))) :=
        CategoryTheory.CategoryStruct.comp
          (K₁.obj.map (Opposite.op e_VX.hom))
