          π_inf (π_lvl i) (uX i) (huX i) F₀ q (toH (π_lvl i) (fromH (π_lvl i) x_i)) at h1
      rw [hto_from (π_lvl i) x_i, hpull0] at h1
      exact (hfrom_to π_inf _).symm.trans ((congrArg (fromH π_inf) h1).trans (map_zero _))
    obtain ⟨j, θ, hθ0⟩ := hSysFℤ.2 i (fromH (π_lvl i) x_i) hleg_y0
    refine ⟨j, θ, (hTriIff (π_lvl j) (π_lvl i) (vX θ) (hvX θ) F₀ q x_i 0).mpr ?_⟩
    have h2 := hConstNat (π_lvl j) (π_lvl i) (vX θ) (hvX θ) F₀ q (fromH (π_lvl i) x_i)
