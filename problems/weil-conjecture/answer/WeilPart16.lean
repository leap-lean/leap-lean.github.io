      exact (eBase_of f₁ (pb_obj π₁ F₀)).apply_symm_apply _
    have hbcH₀_bij_iff : ∀ {Z₁ X₁ : AlgebraicGeometry.Scheme.{u}}
        (g₁ : Quiver.Hom Z₁ (AlgebraicGeometry.Spec (CommRingCat.of R₀_a)))
        (f₁ : Quiver.Hom X₁ Z₁) (π₁ : Quiver.Hom X₁ X₀_a)
        (hpb₁ : CategoryTheory.IsPullback π₁ f₁ f₀_a g₁)
