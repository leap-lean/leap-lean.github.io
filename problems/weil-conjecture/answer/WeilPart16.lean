  let diag_left : Quiver.Hom V_sch (B_v.obj V).left :=
    CategoryTheory.Limits.pullback.lift
      (CategoryTheory.CategoryStruct.id V_sch)
      (CategoryTheory.CategoryStruct.id V_sch) rfl
