    · rw [hvX _, CategoryTheory.Category.assoc, hvX θ, hvX θ']

  
  have hs4 :
      (∀ (C D₀_sys D₁_sys E : WeilFilteredAbelianSystem.{u} ℐ)
        (res₀ : ∀ i : ℐ, ↥(C.obj i) →+ ↥(D₀_sys.obj i)) (res₀_inf : ↥C.pt →+ ↥D₀_sys.pt)
        (res₁ : ∀ i : ℐ, ↥(C.obj i) →+ ↥(D₁_sys.obj i)) (res₁_inf : ↥C.pt →+ ↥D₁_sys.pt)
        (diff : ∀ i : ℐ, (↥(D₀_sys.obj i) × ↥(D₁_sys.obj i)) →+ ↥(E.obj i))
        (diff_inf : (↥D₀_sys.pt × ↥D₁_sys.pt) →+ ↥E.pt),
        (∀ (i : ℐ) (x : ↥(C.obj i)),
          res₀_inf (C.leg i x) = D₀_sys.leg i (res₀ i x) ∧
          res₁_inf (C.leg i x) = D₁_sys.leg i (res₁ i x)) →
        (∀ (i : ℐ) (u : ↥(D₀_sys.obj i)) (v : ↥(D₁_sys.obj i)),
          diff_inf (D₀_sys.leg i u, D₁_sys.leg i v) = E.leg i (diff i (u, v))) →
        (∀ {i j : ℐ} (θ : Quiver.Hom i j) (x : ↥(C.obj i)),
          res₀ j (C.map θ x) = D₀_sys.map θ (res₀ i x) ∧
          res₁ j (C.map θ x) = D₁_sys.map θ (res₁ i x)) →
        (∀ {i j : ℐ} (θ : Quiver.Hom i j) (u : ↥(D₀_sys.obj i)) (v : ↥(D₁_sys.obj i)),
          diff j (D₀_sys.map θ u, D₁_sys.map θ v) = E.map θ (diff i (u, v))) →
        (∀ x : ↥C.pt, res₀_inf x = 0 → res₁_inf x = 0 → x = 0) →
        (∀ x : ↥C.pt, diff_inf (res₀_inf x, res₁_inf x) = 0) →
        (∀ (i : ℐ) (x : ↥(C.obj i)), res₀ i x = 0 → res₁ i x = 0 → x = 0) →
        (∀ (i : ℐ) (p : ↥(D₀_sys.obj i) × ↥(D₁_sys.obj i)),
          diff i p = 0 → ∃ x : ↥(C.obj i), (res₀ i x, res₁ i x) = p) →
        WeilFilteredAbelianColimSurj D₀_sys → WeilFilteredAbelianColimInj D₀_sys →
        WeilFilteredAbelianColimSurj D₁_sys → WeilFilteredAbelianColimInj D₁_sys →
        WeilFilteredAbelianColimInj E →
        WeilFilteredAbelianColimSurj C ∧ WeilFilteredAbelianColimInj C) ∧
      (∀ (A₀ A₁ B C D₀_sys D₁_sys E : WeilFilteredAbelianSystem.{u} ℐ)
        (diffA : ∀ i : ℐ, (↥(A₀.obj i) × ↥(A₁.obj i)) →+ ↥(B.obj i))
        (diffA_inf : (↥A₀.pt × ↥A₁.pt) →+ ↥B.pt)
        (δ : ∀ i : ℐ, ↥(B.obj i) →+ ↥(C.obj i)) (δ_inf : ↥B.pt →+ ↥C.pt)
        (res₀ : ∀ i : ℐ, ↥(C.obj i) →+ ↥(D₀_sys.obj i)) (res₀_inf : ↥C.pt →+ ↥D₀_sys.pt)
        (res₁ : ∀ i : ℐ, ↥(C.obj i) →+ ↥(D₁_sys.obj i)) (res₁_inf : ↥C.pt →+ ↥D₁_sys.pt)
        (diffD : ∀ i : ℐ, (↥(D₀_sys.obj i) × ↥(D₁_sys.obj i)) →+ ↥(E.obj i))
        (diffD_inf : (↥D₀_sys.pt × ↥D₁_sys.pt) →+ ↥E.pt),
        (∀ (i : ℐ) (u : ↥(A₀.obj i)) (v : ↥(A₁.obj i)),
          diffA_inf (A₀.leg i u, A₁.leg i v) = B.leg i (diffA i (u, v))) →
        (∀ (i : ℐ) (b : ↥(B.obj i)), δ_inf (B.leg i b) = C.leg i (δ i b)) →
        (∀ (i : ℐ) (x : ↥(C.obj i)),
          res₀_inf (C.leg i x) = D₀_sys.leg i (res₀ i x) ∧
          res₁_inf (C.leg i x) = D₁_sys.leg i (res₁ i x)) →
        (∀ (i : ℐ) (u : ↥(D₀_sys.obj i)) (v : ↥(D₁_sys.obj i)),
          diffD_inf (D₀_sys.leg i u, D₁_sys.leg i v) = E.leg i (diffD i (u, v))) →
        (∀ {i j : ℐ} (θ : Quiver.Hom i j) (u : ↥(A₀.obj i)) (v : ↥(A₁.obj i)),
          diffA j (A₀.map θ u, A₁.map θ v) = B.map θ (diffA i (u, v))) →
        (∀ {i j : ℐ} (θ : Quiver.Hom i j) (b : ↥(B.obj i)),
          δ j (B.map θ b) = C.map θ (δ i b)) →
        (∀ {i j : ℐ} (θ : Quiver.Hom i j) (x : ↥(C.obj i)),
          res₀ j (C.map θ x) = D₀_sys.map θ (res₀ i x) ∧
          res₁ j (C.map θ x) = D₁_sys.map θ (res₁ i x)) →
        (∀ {i j : ℐ} (θ : Quiver.Hom i j) (u : ↥(D₀_sys.obj i)) (v : ↥(D₁_sys.obj i)),
          diffD j (D₀_sys.map θ u, D₁_sys.map θ v) = E.map θ (diffD i (u, v))) →
        (∀ b_inf : ↥B.pt, δ_inf b_inf = 0 →
          ∃ p : ↥A₀.pt × ↥A₁.pt, diffA_inf p = b_inf) →
        (∀ c_inf : ↥C.pt, res₀_inf c_inf = 0 → res₁_inf c_inf = 0 →
          ∃ b_inf : ↥B.pt, δ_inf b_inf = c_inf) →
        (∀ c_inf : ↥C.pt, diffD_inf (res₀_inf c_inf, res₁_inf c_inf) = 0) →
        (∀ (i : ℐ) (p : ↥(A₀.obj i) × ↥(A₁.obj i)), δ i (diffA i p) = 0) →
        (∀ (i : ℐ) (c_i : ↥(C.obj i)), res₀ i c_i = 0 → res₁ i c_i = 0 →
          ∃ b_i : ↥(B.obj i), δ i b_i = c_i) →
        (∀ (i : ℐ) (p : ↥(D₀_sys.obj i) × ↥(D₁_sys.obj i)), diffD i p = 0 →
          ∃ c_i : ↥(C.obj i), (res₀ i c_i, res₁ i c_i) = p) →
        WeilFilteredAbelianColimSurj A₀ → WeilFilteredAbelianColimSurj A₁ →
        WeilFilteredAbelianColimSurj B → WeilFilteredAbelianColimInj B →
        WeilFilteredAbelianColimSurj D₀_sys → WeilFilteredAbelianColimInj D₀_sys →
        WeilFilteredAbelianColimSurj D₁_sys → WeilFilteredAbelianColimInj D₁_sys →
        WeilFilteredAbelianColimInj E →
        WeilFilteredAbelianColimSurj C ∧ WeilFilteredAbelianColimInj C) := by
    have hProdSurj : ∀ {M₀ M₁ : WeilFilteredAbelianSystem.{u} ℐ},
        WeilFilteredAbelianColimSurj M₀ → WeilFilteredAbelianColimSurj M₁ →
        ∀ (u_inf : ↥M₀.pt) (v_inf : ↥M₁.pt),
          ∃ (m : ℐ) (u_m : ↥(M₀.obj m)) (v_m : ↥(M₁.obj m)),
            M₀.leg m u_m = u_inf ∧ M₁.leg m v_m = v_inf := by
      intro M₀ M₁ hS₀ hS₁ u_inf v_inf
      obtain ⟨i₀, u₀, hu₀⟩ := hS₀ u_inf
      obtain ⟨i₁, v₁, hv₁⟩ := hS₁ v_inf
      let m := CategoryTheory.IsFiltered.max i₀ i₁
      let σ₀ := CategoryTheory.IsFiltered.leftToMax i₀ i₁
      let σ₁ := CategoryTheory.IsFiltered.rightToMax i₀ i₁
      refine ⟨m, M₀.map σ₀ u₀, M₁.map σ₁ v₁, ?_, ?_⟩
      · rw [M₀.leg_map, hu₀]
      · rw [M₁.leg_map, hv₁]
    have hProdInj : ∀ {M₀ M₁ : WeilFilteredAbelianSystem.{u} ℐ},
        WeilFilteredAbelianColimInj M₀ → WeilFilteredAbelianColimInj M₁ →
        ∀ (i : ℐ) (u_i : ↥(M₀.obj i)) (v_i : ↥(M₁.obj i)),
          M₀.leg i u_i = 0 → M₁.leg i v_i = 0 →
          ∃ (j : ℐ) (θ : Quiver.Hom i j), M₀.map θ u_i = 0 ∧ M₁.map θ v_i = 0 := by
      intro M₀ M₁ hI₀ hI₁ i u_i v_i hu hv
      obtain ⟨j₀, θ₀, hθ₀⟩ := hI₀ i u_i hu
      obtain ⟨j₁, θ₁, hθ₁⟩ := hI₁ i v_i hv
      let j₂ := CategoryTheory.IsFiltered.max j₀ j₁
      let τ₀ := CategoryTheory.IsFiltered.leftToMax j₀ j₁
      let τ₁ := CategoryTheory.IsFiltered.rightToMax j₀ j₁
      let f₀ := CategoryTheory.CategoryStruct.comp θ₀ τ₀
      let f₁ := CategoryTheory.CategoryStruct.comp θ₁ τ₁
      let j₃ := CategoryTheory.IsFiltered.coeq f₀ f₁
      let σ := CategoryTheory.IsFiltered.coeqHom f₀ f₁
      have h_coeq : CategoryTheory.CategoryStruct.comp f₀ σ =
          CategoryTheory.CategoryStruct.comp f₁ σ :=
        CategoryTheory.IsFiltered.coeq_condition f₀ f₁
      refine ⟨j₃, CategoryTheory.CategoryStruct.comp f₀ σ, ?_, ?_⟩
      · rw [M₀.map_comp, M₀.map_comp, hθ₀, map_zero, map_zero]
      · rw [h_coeq, M₁.map_comp, M₁.map_comp, hθ₁, map_zero, map_zero]
    refine ⟨?_, ?_⟩
    · intro C D₀_sys D₁_sys E res₀ res₀_inf res₁ res₁_inf diff diff_inf
        hleg_res hleg_diff hmap_res hmap_diff hinj_inf hex0_inf hinj_i hex_i
        hSD₀ hID₀ hSD₁ hID₁ hIE
      refine ⟨?_, ?_⟩
      · intro c_inf
        obtain ⟨i₁, u₁, v₁, hu₁, hv₁⟩ :=
          hProdSurj hSD₀ hSD₁ (res₀_inf c_inf) (res₁_inf c_inf)
        have hdiff_leg : E.leg i₁ (diff i₁ (u₁, v₁)) = 0 := by
          rw [← hleg_diff, hu₁, hv₁, hex0_inf]
        obtain ⟨i₂, θ₁₂, hθ₁₂⟩ := hIE i₁ (diff i₁ (u₁, v₁)) hdiff_leg
        have hdiff_i₂ : diff i₂ (D₀_sys.map θ₁₂ u₁, D₁_sys.map θ₁₂ v₁) = 0 := by
          rw [hmap_diff, hθ₁₂]
        obtain ⟨c₂, hc₂⟩ := hex_i i₂ (D₀_sys.map θ₁₂ u₁, D₁_sys.map θ₁₂ v₁) hdiff_i₂
        have hc₂_0 : res₀ i₂ c₂ = D₀_sys.map θ₁₂ u₁ := congrArg Prod.fst hc₂
        have hc₂_1 : res₁ i₂ c₂ = D₁_sys.map θ₁₂ v₁ := congrArg Prod.snd hc₂
        refine ⟨i₂, c₂, ?_⟩
        apply sub_eq_zero.mp
        apply hinj_inf
        · rw [map_sub, (hleg_res i₂ c₂).1, hc₂_0, D₀_sys.leg_map, hu₁, sub_self]
        · rw [map_sub, (hleg_res i₂ c₂).2, hc₂_1, D₁_sys.leg_map, hv₁, sub_self]
      · intro i c_i hc_i
        have hr₀ : D₀_sys.leg i (res₀ i c_i) = 0 := by
          rw [← (hleg_res i c_i).1, hc_i, map_zero]
        have hr₁ : D₁_sys.leg i (res₁ i c_i) = 0 := by
          rw [← (hleg_res i c_i).2, hc_i, map_zero]
        obtain ⟨j, θ, hθ₀, hθ₁⟩ := hProdInj hID₀ hID₁ i (res₀ i c_i) (res₁ i c_i) hr₀ hr₁
        refine ⟨j, θ, hinj_i j (C.map θ c_i) ?_ ?_⟩
        · rw [(hmap_res θ c_i).1, hθ₀]
        · rw [(hmap_res θ c_i).2, hθ₁]
    · intro A₀ A₁ B C D₀_sys D₁_sys E diffA diffA_inf δ δ_inf res₀ res₀_inf res₁ res₁_inf
        diffD diffD_inf hleg_diffA hleg_δ hleg_res hleg_diffD
        hmap_diffA hmap_δ hmap_res hmap_diffD
        hexB_inf hexC_inf hexD_inf hδdiff_i hexC_i hexD_i
        hSA₀ hSA₁ hSB hIB hSD₀ hID₀ hSD₁ hID₁ hIE
      refine ⟨?_, ?_⟩
      · intro c_inf
        obtain ⟨i₁, d₀₁, d₁₁, hd₀₁, hd₁₁⟩ :=
          hProdSurj hSD₀ hSD₁ (res₀_inf c_inf) (res₁_inf c_inf)
        have hdiff_leg : E.leg i₁ (diffD i₁ (d₀₁, d₁₁)) = 0 := by
          rw [← hleg_diffD, hd₀₁, hd₁₁, hexD_inf]
        obtain ⟨i₂, θ₁₂, hθ₁₂⟩ := hIE i₁ (diffD i₁ (d₀₁, d₁₁)) hdiff_leg
        have hdiff_i₂ : diffD i₂ (D₀_sys.map θ₁₂ d₀₁, D₁_sys.map θ₁₂ d₁₁) = 0 := by
          rw [hmap_diffD, hθ₁₂]
        obtain ⟨c'₂, hc'₂⟩ := hexD_i i₂ (D₀_sys.map θ₁₂ d₀₁, D₁_sys.map θ₁₂ d₁₁) hdiff_i₂
        have hc'₂_0 : res₀ i₂ c'₂ = D₀_sys.map θ₁₂ d₀₁ := congrArg Prod.fst hc'₂
        have hc'₂_1 : res₁ i₂ c'₂ = D₁_sys.map θ₁₂ d₁₁ := congrArg Prod.snd hc'₂
        have hsub₀ : res₀_inf (c_inf - C.leg i₂ c'₂) = 0 := by
          rw [map_sub, (hleg_res i₂ c'₂).1, hc'₂_0, D₀_sys.leg_map, hd₀₁, sub_self]
        have hsub₁ : res₁_inf (c_inf - C.leg i₂ c'₂) = 0 := by
          rw [map_sub, (hleg_res i₂ c'₂).2, hc'₂_1, D₁_sys.leg_map, hd₁₁, sub_self]
        obtain ⟨b_inf, hb_inf⟩ := hexC_inf (c_inf - C.leg i₂ c'₂) hsub₀ hsub₁
        obtain ⟨i₃, b₃, hb₃⟩ := hSB b_inf
        let i₄ := CategoryTheory.IsFiltered.max i₂ i₃
        let σ₂ := CategoryTheory.IsFiltered.leftToMax i₂ i₃
        let σ₃ := CategoryTheory.IsFiltered.rightToMax i₂ i₃
        refine ⟨i₄, C.map σ₂ c'₂ + δ i₄ (B.map σ₃ b₃), ?_⟩
        rw [map_add, C.leg_map, ← hleg_δ, B.leg_map, hb₃, hb_inf, add_sub_cancel]
      · intro i₀ c₀ hc₀
        have hr₀ : D₀_sys.leg i₀ (res₀ i₀ c₀) = 0 := by
          rw [← (hleg_res i₀ c₀).1, hc₀, map_zero]
        have hr₁ : D₁_sys.leg i₀ (res₁ i₀ c₀) = 0 := by
          rw [← (hleg_res i₀ c₀).2, hc₀, map_zero]
        obtain ⟨i₁, θ₀₁, hθ₀₁_0, hθ₀₁_1⟩ :=
          hProdInj hID₀ hID₁ i₀ (res₀ i₀ c₀) (res₁ i₀ c₀) hr₀ hr₁
        have hres_c₁_0 : res₀ i₁ (C.map θ₀₁ c₀) = 0 := by
          rw [(hmap_res θ₀₁ c₀).1, hθ₀₁_0]
        have hres_c₁_1 : res₁ i₁ (C.map θ₀₁ c₀) = 0 := by
          rw [(hmap_res θ₀₁ c₀).2, hθ₀₁_1]
        obtain ⟨b₁, hb₁⟩ := hexC_i i₁ (C.map θ₀₁ c₀) hres_c₁_0 hres_c₁_1
        have hδ_b₁ : δ_inf (B.leg i₁ b₁) = 0 := by
          rw [hleg_δ, hb₁, C.leg_map, hc₀]
        obtain ⟨⟨a₀_inf, a₁_inf⟩, ha_inf⟩ := hexB_inf (B.leg i₁ b₁) hδ_b₁
        obtain ⟨i₂, a₀₂, a₁₂, ha₀₂, ha₁₂⟩ := hProdSurj hSA₀ hSA₁ a₀_inf a₁_inf
        let i₃ := CategoryTheory.IsFiltered.max i₁ i₂
        let τ₁ := CategoryTheory.IsFiltered.leftToMax i₁ i₂
        let τ₂ := CategoryTheory.IsFiltered.rightToMax i₁ i₂
        let diff_b₃ := B.map τ₁ b₁ - diffA i₃ (A₀.map τ₂ a₀₂, A₁.map τ₂ a₁₂)
        have hleg_diff_b₃ : B.leg i₃ diff_b₃ = 0 := by
          dsimp [diff_b₃]
          rw [map_sub, B.leg_map, ← hleg_diffA, A₀.leg_map, A₁.leg_map, ha₀₂, ha₁₂, ha_inf, sub_self]
        obtain ⟨i₄, θ₃₄, hθ₃₄⟩ := hIB i₃ diff_b₃ hleg_diff_b₃
        have hb₄_eq : B.map θ₃₄ (B.map τ₁ b₁) =
            diffA i₄ (A₀.map θ₃₄ (A₀.map τ₂ a₀₂), A₁.map θ₃₄ (A₁.map τ₂ a₁₂)) := by
          rw [hmap_diffA]
          exact sub_eq_zero.mp (by rw [← map_sub]; exact hθ₃₄)
        refine ⟨i₄, CategoryTheory.CategoryStruct.comp
          (CategoryTheory.CategoryStruct.comp θ₀₁ τ₁) θ₃₄, ?_⟩
        rw [C.map_comp, C.map_comp, ← hb₁, ← hmap_δ, ← hmap_δ, hb₄_eq]
        exact hδdiff_i i₄ _

  
  have hs1 : ∃ (W₀ W₁ : P₁.left.Opens)
      (C₀ C₁ C₀₁ : CommRingCat.{u})
      (γ₀ : Quiver.Hom (CommRingCat.of k) C₀)
      (γ₁ : Quiver.Hom (CommRingCat.of k) C₁)
      (γ₀₁ : Quiver.Hom (CommRingCat.of k) C₀₁)
      (e₀ : CategoryTheory.Iso (W₀ : AlgebraicGeometry.Scheme.{u}) (AlgebraicGeometry.Spec C₀))
      (e₁ : CategoryTheory.Iso (W₁ : AlgebraicGeometry.Scheme.{u}) (AlgebraicGeometry.Spec C₁))
      (e₀₁ : CategoryTheory.Iso ((W₀ ⊓ W₁ : P₁.left.Opens) : AlgebraicGeometry.Scheme.{u})
        (AlgebraicGeometry.Spec C₀₁)),
      W₀ ⊔ W₁ = ⊤ ∧
      CategoryTheory.CategoryStruct.comp W₀.ι P₁.hom =
        CategoryTheory.CategoryStruct.comp e₀.hom (AlgebraicGeometry.Spec.map γ₀) ∧
      CategoryTheory.CategoryStruct.comp W₁.ι P₁.hom =
        CategoryTheory.CategoryStruct.comp e₁.hom (AlgebraicGeometry.Spec.map γ₁) ∧
      CategoryTheory.CategoryStruct.comp (W₀ ⊓ W₁ : P₁.left.Opens).ι P₁.hom =
        CategoryTheory.CategoryStruct.comp e₀₁.hom (AlgebraicGeometry.Spec.map γ₀₁) := by
    dsimp only [P₁, weilProjectiveSpaceOver]
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin 2) k
    letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    let x₀ : MvPolynomial (Fin 2) k := MvPolynomial.X 0
    let x₁ : MvPolynomial (Fin 2) k := MvPolynomial.X 1
    let f₀₁ : MvPolynomial (Fin 2) k := x₀ * x₁
    have hx₀ : x₀ ∈ 𝒜 1 := MvPolynomial.isHomogeneous_X k 0
    have hx₁ : x₁ ∈ 𝒜 1 := MvPolynomial.isHomogeneous_X k 1
    have hf₀₁ : f₀₁ ∈ 𝒜 2 := by
      change MvPolynomial.IsHomogeneous f₀₁ (1 + 1)
      exact MvPolynomial.IsHomogeneous.mul hx₀ hx₁
    let W₀ : (AlgebraicGeometry.Proj 𝒜).Opens := AlgebraicGeometry.Proj.basicOpen 𝒜 x₀
    let W₁ : (AlgebraicGeometry.Proj 𝒜).Opens := AlgebraicGeometry.Proj.basicOpen 𝒜 x₁
    have hW_top : W₀ ⊔ W₁ = ⊤ := by
      have : IsScalarTower k ↥(𝒜 0) (MvPolynomial (Fin 2) k) :=
        @IsScalarTower.of_algebraMap_eq k ↥(𝒜 0) (MvPolynomial (Fin 2) k) _ _ _ _ _ _ (fun _ => rfl)
      have hadj : Algebra.adjoin (↥(𝒜 0))
          (Set.range (MvPolynomial.X : Fin 2 → MvPolynomial (Fin 2) k)) = ⊤ := by
        rw [eq_top_iff]
        intro p _
        have hp_k : p ∈ Algebra.adjoin k
            (Set.range (MvPolynomial.X : Fin 2 → MvPolynomial (Fin 2) k)) := by
          rw [MvPolynomial.adjoin_range_X]
          trivial
        refine Algebra.adjoin_induction (fun y hy => Algebra.subset_adjoin hy) (fun r => ?_)
          (fun _ _ _ _ ha hb => add_mem ha hb) (fun _ _ _ _ ha hb => mul_mem ha hb) hp_k
        rw [IsScalarTower.algebraMap_apply k ↥(𝒜 0) (MvPolynomial (Fin 2) k)]
        exact Subalgebra.algebraMap_mem _ _
      have hiSup : (⨆ i : Fin 2, AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X i)) = ⊤ :=
        AlgebraicGeometry.Proj.iSup_basicOpen_eq_top' 𝒜
          (MvPolynomial.X : Fin 2 → MvPolynomial (Fin 2) k)
          (fun i => ⟨1, MvPolynomial.isHomogeneous_X k i⟩) hadj
      apply le_antisymm le_top
      rw [← hiSup]
      refine iSup_le (fun i => ?_)
      fin_cases i
      · exact le_sup_left
      · exact le_sup_right
    let C₀ : CommRingCat.{u} := CommRingCat.of (HomogeneousLocalization.Away 𝒜 x₀)
    let C₁ : CommRingCat.{u} := CommRingCat.of (HomogeneousLocalization.Away 𝒜 x₁)
    let C₀₁ : CommRingCat.{u} := CommRingCat.of (HomogeneousLocalization.Away 𝒜 f₀₁)
    let e₀ : CategoryTheory.Iso (W₀ : AlgebraicGeometry.Scheme.{u}) (AlgebraicGeometry.Spec C₀) :=
      AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 x₀ hx₀ Nat.one_pos
    let e₁ : CategoryTheory.Iso (W₁ : AlgebraicGeometry.Scheme.{u}) (AlgebraicGeometry.Spec C₁) :=
      AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 x₁ hx₁ Nat.one_pos
    have hmul : AlgebraicGeometry.Proj.basicOpen 𝒜 f₀₁ = (W₀ ⊓ W₁ : (AlgebraicGeometry.Proj 𝒜).Opens) :=
      AlgebraicGeometry.Proj.basicOpen_mul 𝒜 x₀ x₁
    let e₀₁ : CategoryTheory.Iso ((W₀ ⊓ W₁ : (AlgebraicGeometry.Proj 𝒜).Opens) : AlgebraicGeometry.Scheme.{u})
        (AlgebraicGeometry.Spec C₀₁) :=
      CategoryTheory.Iso.trans ((AlgebraicGeometry.Proj 𝒜).isoOfEq hmul.symm)
        (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 f₀₁ hf₀₁ Nat.zero_lt_two)
    let homP₁ := CategoryTheory.CategoryStruct.comp
