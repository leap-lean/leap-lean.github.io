        q_m = mkChart_m X_Ω (hLm_mem s₀) (e_inv.comp θ_m) ∧
        q_1 = mkChart_1 X_Ω (hL1_mem s₀) (e_inv.comp θ_1) :=
      ⟨mkChart_m X_Ω (hLm_mem s₀) (e_inv.comp θ_m),
       mkChart_1 X_Ω (hL1_mem s₀) (e_inv.comp θ_1), rfl, rfl⟩
    obtain ⟨q_m, q_1, hqm_def, hq1_def⟩ := hex_q
    have hq_comm : q_m ≫ (weilProjectiveSpaceOver k m).hom =
        q_1 ≫ (weilProjectiveSpaceOver k 1).hom := by
      apply hSpec_ext_k X_Ω
      rw [hqm_def, hq1_def,
        (hChart1_m X_Ω (hLm_mem s₀) (e_inv.comp θ_m)).2.1,
        (hChart1_1 X_Ω (hL1_mem s₀) (e_inv.comp θ_1)).2.1,
        RingHom.comp_assoc, hθ_m_0, RingHom.comp_assoc, hθ_1_0]
    have hex_ytilde : ∃ ytilde : X_Ω ⟶ Y_pb,
        ytilde ≫ CategoryTheory.Limits.pullback.fst
          (weilProjectiveSpaceOver k m).hom (weilProjectiveSpaceOver k 1).hom = q_m ∧
        ytilde ≫ CategoryTheory.Limits.pullback.snd
          (weilProjectiveSpaceOver k m).hom (weilProjectiveSpaceOver k 1).hom = q_1 :=
      ⟨CategoryTheory.Limits.pullback.lift q_m q_1 hq_comm,
       CategoryTheory.Limits.pullback.lift_fst _ _ _,
       CategoryTheory.Limits.pullback.lift_snd _ _ _⟩
    obtain ⟨ytilde, hyt_fst, hyt_snd⟩ := hex_ytilde
    have hyt_in_U : ∀ pt : ↥X_Ω, ytilde.base pt ∈ U s₀ := by
      intro pt
      rw [hU_def s₀]
      have h1 : (ytilde ≫ CategoryTheory.Limits.pullback.fst
          (weilProjectiveSpaceOver k m).hom (weilProjectiveSpaceOver k 1).hom).base pt ∈
          AlgebraicGeometry.Proj.basicOpen
            (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) k) (L_m s₀) := by
        rw [hyt_fst, hqm_def]
        exact (hChart1_m X_Ω (hLm_mem s₀) (e_inv.comp θ_m)).1 pt
      have h2 : (ytilde ≫ CategoryTheory.Limits.pullback.snd
          (weilProjectiveSpaceOver k m).hom (weilProjectiveSpaceOver k 1).hom).base pt ∈
          AlgebraicGeometry.Proj.basicOpen
            (MvPolynomial.homogeneousSubmodule (Fin 2) k) (L_1 s₀) := by
        rw [hyt_snd, hq1_def]
        exact (hChart1_1 X_Ω (hL1_mem s₀) (e_inv.comp θ_1)).1 pt
      exact ⟨h1, h2⟩
    obtain ⟨ytilde₀, hyt₀_ι⟩ := hU_lift s₀ ytilde hyt_in_U
    have hφ_m_eq : (ytilde₀.appTop).hom.comp (ι_ms s₀) = e_inv.comp θ_m := by
      apply (hChart1_m X_Ω (hLm_mem s₀) _).2.2.2.2
      rw [← (hChart1_m (U s₀).toScheme (hLm_mem s₀) (ι_ms s₀)).2.2.2.1 ytilde₀,
        ← hι_m_eq s₀, ← CategoryTheory.Category.assoc, hyt₀_ι, hyt_fst, hqm_def]
    have hφ_1_eq : (ytilde₀.appTop).hom.comp (ι_1s s₀) = e_inv.comp θ_1 := by
      apply (hChart1_1 X_Ω (hL1_mem s₀) _).2.2.2.2
      rw [← (hChart1_1 (U s₀).toScheme (hL1_mem s₀) (ι_1s s₀)).2.2.2.1 ytilde₀,
        ← hι_1_eq s₀, ← CategoryTheory.Category.assoc, hyt₀_ι, hyt_snd, hq1_def]
    have hψ_eq_θΓ : (ytilde₀.appTop).hom.comp (ψ_s s₀) = θ_Γ := by
      apply h1c_succ
      · rw [RingHom.comp_assoc, hψ_κ s₀, ← hι_m_κ s₀,
          ← RingHom.comp_assoc, hφ_m_eq, RingHom.comp_assoc, hθ_m_0]
        ext c
        dsimp only [σ_k, ι₀_succ]
        change e_inv (e_hom (θ_Γ (ι₀_succ c))) = θ_Γ (ι₀_succ c)
        exact he_inv_hom _
      · intro j
        change (ytilde₀.appTop).hom (ψ_s s₀ _) = θ_Γ _
        rw [hψ_x s₀ j, hw_def s₀ j, map_sum]
        have hsum_eq :
            (∑ p ∈ Finset.univ.filter
                (fun p : Fin (m + 1) × Fin 2 => (p.1 : ℕ) + (p.2 : ℕ) = (j : ℕ)),
              (ytilde₀.appTop).hom (u_s s₀ p.1 * v_s s₀ p.2)) =
            ∑ p ∈ Finset.univ.filter
                (fun p : Fin (m + 1) × Fin 2 => (p.1 : ℕ) + (p.2 : ℕ) = (j : ℕ)),
              e_inv (α p.1 * β p.2) := by
          refine Finset.sum_congr rfl fun p _ => ?_
          rw [map_mul, map_mul, hu_def s₀ p.1, hv_def s₀ p.2]
          have hm_p := RingHom.congr_fun hφ_m_eq
            (HomogeneousLocalization.Away.isLocalizationElem
              (hLm_mem s₀) (MvPolynomial.isHomogeneous_X k p.1))
          have h1_p := RingHom.congr_fun hφ_1_eq
            (HomogeneousLocalization.Away.isLocalizationElem
              (hL1_mem s₀) (MvPolynomial.isHomogeneous_X k p.2))
          change ((ytilde₀.appTop).hom.comp (ι_ms s₀)) _ *
              ((ytilde₀.appTop).hom.comp (ι_1s s₀)) _ = _
          rw [hm_p, h1_p]
          change e_inv (θ_m _) * e_inv (θ_1 _) = _
          rw [hθ_m_x p.1, hθ_1_x p.2]
        rw [hsum_eq, ← map_sum, hProd j]
        exact he_inv_hom _
    refine ⟨ytilde, ?_⟩
    rw [← hyt₀_ι, CategoryTheory.Category.assoc, hμ_ι s₀, hμ_chart_def s₀,
      (hChart1_succ (U s₀).toScheme (hLsucc_mem s₀) (ψ_s s₀)).2.2.2.1 ytilde₀,
      hψ_eq_θΓ, ← hybar_eq]

theorem weil_projSpace_pullback_isFinite_of_affineOpen_cover (k : Type u) [Field k]
    (m n r : ℕ)
    (μ : CategoryTheory.Limits.pullback
      (weilProjectiveSpaceOver k m).hom (weilProjectiveSpaceOver k n).hom ⟶
      (weilProjectiveSpaceOver k r).left)
    (hComm : μ ≫ (weilProjectiveSpaceOver k r).hom =
      CategoryTheory.Limits.pullback.fst
        (weilProjectiveSpaceOver k m).hom (weilProjectiveSpaceOver k n).hom ≫
        (weilProjectiveSpaceOver k m).hom)
    (hAffCov : ∀ y : ↥(weilProjectiveSpaceOver k r).left,
      ∃ (V : (weilProjectiveSpaceOver k r).left.Opens)
        (U_m : (weilProjectiveSpaceOver k m).left.Opens)
        (U_n : (weilProjectiveSpaceOver k n).left.Opens),
        y ∈ V ∧
        AlgebraicGeometry.IsAffineOpen V ∧
        AlgebraicGeometry.IsAffineOpen U_m ∧
        AlgebraicGeometry.IsAffineOpen U_n ∧
        (TopologicalSpace.Opens.map μ.base).obj V =
          (TopologicalSpace.Opens.map
            (CategoryTheory.Limits.pullback.fst
              (weilProjectiveSpaceOver k m).hom (weilProjectiveSpaceOver k n).hom).base).obj U_m ⊓
          (TopologicalSpace.Opens.map
            (CategoryTheory.Limits.pullback.snd
              (weilProjectiveSpaceOver k m).hom (weilProjectiveSpaceOver k n).hom).base).obj U_n) :
    AlgebraicGeometry.IsFinite μ :=
by
  have hPropProj : ∀ (N : ℕ), AlgebraicGeometry.IsProper (weilProjectiveSpaceOver k N).hom := by
    intro N
    dsimp only [weilProjectiveSpaceOver, CategoryTheory.Over.mk_hom]
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have hSurj₀ : Function.Surjective (algebraMap k ↥(𝒜 0)) := by
      intro p
      have hp1 : p.1 ∈ (1 : Submodule k (MvPolynomial (Fin (N + 1)) k)) := by
        rw [← MvPolynomial.homogeneousSubmodule_zero]
        exact p.2
      obtain ⟨c, hc⟩ := Submodule.mem_one.mp hp1
      exact ⟨c, Subtype.ext hc⟩
    have : AlgebraicGeometry.IsClosedImmersion
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))) :=
      AlgebraicGeometry.IsClosedImmersion.spec_of_surjective
        (CommRingCat.ofHom (algebraMap k ↥(𝒜 0))) hSurj₀
    have : IsScalarTower k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
      @IsScalarTower.of_algebraMap_eq k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) _ _ _ _ _ _
        (fun _ => rfl)
    have : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
      Algebra.FiniteType.of_restrictScalars_finiteType k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k)
    have : AlgebraicGeometry.IsProper (AlgebraicGeometry.Proj.toSpecZero 𝒜) := inferInstance
    exact inferInstance
  let p_m := (weilProjectiveSpaceOver k m).hom
  let p_n := (weilProjectiveSpaceOver k n).hom
  let p_r := (weilProjectiveSpaceOver k r).hom
  let fst := CategoryTheory.Limits.pullback.fst p_m p_n
  let snd := CategoryTheory.Limits.pullback.snd p_m p_n
  have hProp_μ : AlgebraicGeometry.IsProper μ := by
    have : AlgebraicGeometry.IsProper p_m := hPropProj m
    have : AlgebraicGeometry.IsProper p_n := hPropProj n
    have : AlgebraicGeometry.IsProper p_r := hPropProj r
    have : AlgebraicGeometry.IsSeparated p_r := inferInstance
    have hProp_comp : AlgebraicGeometry.IsProper (fst ≫ p_m) := inferInstance
    have : AlgebraicGeometry.IsProper (μ ≫ p_r) := by
      dsimp only [p_r]
      rw [hComm]
      exact hProp_comp
    exact AlgebraicGeometry.IsProper.of_comp μ p_r
  have hAff_μ : AlgebraicGeometry.IsAffineHom μ := by
    apply AlgebraicGeometry.isAffineHom_of_forall_exists_isAffineOpen
    intro y
    obtain ⟨V, U_m, U_n, hyV, hAffV, hAff_m, hAff_n, hPreV⟩ := hAffCov y
    refine ⟨V, hyV, hAffV, ?_⟩
    rw [hPreV]
    let W₁ : (CategoryTheory.Limits.pullback p_m p_n).Opens :=
      (TopologicalSpace.Opens.map fst.base).obj U_m
    let W₂ : (CategoryTheory.Limits.pullback p_m p_n).Opens :=
      (TopologicalSpace.Opens.map snd.base).obj U_n
    let W_prod : (CategoryTheory.Limits.pullback p_m p_n).Opens := W₁ ⊓ W₂
    change AlgebraicGeometry.IsAffineOpen W_prod
    have hpb₁ : CategoryTheory.IsPullback (fst ∣_ U_m) (W₁.ι ≫ snd) (U_m.ι ≫ p_m) p_n :=
      (AlgebraicGeometry.isPullback_morphismRestrict fst U_m).paste_vert
        (CategoryTheory.IsPullback.of_hasPullback p_m p_n)
    let q : W₁.toScheme ⟶ (weilProjectiveSpaceOver k n).left := W₁.ι ≫ snd
    let W' : W₁.toScheme.Opens := (TopologicalSpace.Opens.map q.base).obj U_n
    have hpb₂ : CategoryTheory.IsPullback
        (W'.ι ≫ (fst ∣_ U_m)) (q ∣_ U_n) (U_m.ι ≫ p_m) (U_n.ι ≫ p_n) :=
      ((AlgebraicGeometry.isPullback_morphismRestrict q U_n).paste_vert hpb₁.flip).flip
    have : AlgebraicGeometry.IsAffine U_m.toScheme := hAff_m
    have : AlgebraicGeometry.IsAffine U_n.toScheme := hAff_n
    have : AlgebraicGeometry.IsAffine
        (CategoryTheory.Limits.pullback (U_m.ι ≫ p_m) (U_n.ι ≫ p_n)) :=
      inferInstance
    have : AlgebraicGeometry.IsAffine W'.toScheme :=
      AlgebraicGeometry.IsAffine.of_isIso hpb₂.isoPullback.hom
    have hrange_eq : Set.range W_prod.ι.base = Set.range (W'.ι ≫ W₁.ι).base := by
      ext z
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      constructor
      · intro hz
        have hz₁ : z ∈ (W₁ : Set ↥(CategoryTheory.Limits.pullback p_m p_n)) := hz.1
        have hz₂ : snd.base z ∈ U_n := hz.2
        rw [← AlgebraicGeometry.Scheme.Opens.range_ι] at hz₁
        obtain ⟨w₁, hw₁⟩ := hz₁
        have hw₁_mem : w₁ ∈ (W' : Set ↥W₁.toScheme) := by
          change q.base w₁ ∈ U_n
          dsimp only [q]
          rw [AlgebraicGeometry.Scheme.Hom.comp_apply, hw₁]
          exact hz₂
        rw [← AlgebraicGeometry.Scheme.Opens.range_ι] at hw₁_mem
        obtain ⟨w', hw'⟩ := hw₁_mem
        refine ⟨w', ?_⟩
        rw [AlgebraicGeometry.Scheme.Hom.comp_apply, hw', hw₁]
      · rintro ⟨w', rfl⟩
        rw [AlgebraicGeometry.Scheme.Hom.comp_apply]
        set w₁ := W'.ι.base w'
        have hw₁_range : W₁.ι.base w₁ ∈ Set.range W₁.ι.base := ⟨w₁, rfl⟩
        rw [AlgebraicGeometry.Scheme.Opens.range_ι] at hw₁_range
        have hw'_range : w₁ ∈ Set.range W'.ι.base := ⟨w', rfl⟩
        rw [AlgebraicGeometry.Scheme.Opens.range_ι] at hw'_range
        refine ⟨hw₁_range, ?_⟩
        have hq : q.base w₁ ∈ U_n := hw'_range
        dsimp only [q] at hq
        rwa [AlgebraicGeometry.Scheme.Hom.comp_apply] at hq
    let isoW : W_prod.toScheme ≅ W'.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq W_prod.ι (W'.ι ≫ W₁.ι) hrange_eq
    exact AlgebraicGeometry.IsAffine.of_isIso isoW.hom
  exact AlgebraicGeometry.IsFinite.iff_isProper_and_isAffineHom.mpr ⟨hProp_μ, hAff_μ⟩

theorem weil_algClosed_binary_form_chart_split (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (m : ℕ) (c : Ω) (γ : Fin (m + 2) → Ω)
    (hγ : ∑ j : Fin (m + 2), c ^ (j : ℕ) * γ j = 1) :
    ∃ (α : Fin (m + 1) → Ω) (β : Fin 2 → Ω),
      (∑ i : Fin (m + 1), c ^ (i : ℕ) * α i = 1) ∧
      (∑ r : Fin 2, c ^ (r : ℕ) * β r = 1) ∧
      (∀ j : Fin (m + 2),
        (∑ p ∈ Finset.univ.filter
            (fun p : Fin (m + 1) × Fin 2 => (p.1 : ℕ) + (p.2 : ℕ) = (j : ℕ)),
          α p.1 * β p.2) = γ j) :=
by
  classical
  let H : Polynomial Ω := ∑ j : Fin (m + 2), Polynomial.C (γ j) * Polynomial.X ^ (j : ℕ)
  have hH_eval : H.eval c = 1 := by
    dsimp only [H]
    rw [Polynomial.eval_finsetSum]
    have hcongr : ∀ j ∈ (Finset.univ : Finset (Fin (m + 2))),
        (Polynomial.C (γ j) * Polynomial.X ^ (j : ℕ)).eval c = c ^ (j : ℕ) * γ j := by
      intro j _
      rw [Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_pow, Polynomial.eval_X,
        mul_comm]
    rw [Finset.sum_congr rfl hcongr]
    exact hγ
  have hH_coeff : ∀ k : ℕ, H.coeff k = if hk : k < m + 2 then γ ⟨k, hk⟩ else 0 := by
    intro k
    dsimp only [H]
    rw [Polynomial.finsetSum_coeff]
    have hterm : ∀ b ∈ (Finset.univ : Finset (Fin (m + 2))),
        (Polynomial.C (γ b) * Polynomial.X ^ (b : ℕ)).coeff k =
          if k = (b : ℕ) then γ b else 0 := by
      intro b _
      rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow]
      split_ifs <;> simp
    rw [Finset.sum_congr rfl hterm]
    split_ifs with hk
    · rw [Finset.sum_eq_single ⟨k, hk⟩]
      · simp
      · intro b _ hb
        have hne : k ≠ (b : ℕ) := fun h => hb (Fin.ext h.symm)
        simp [hne]
      · intro habs
        exact absurd (Finset.mem_univ _) habs
    · apply Finset.sum_eq_zero
      intro b _
      have hne : k ≠ (b : ℕ) := by
        have hb : (b : ℕ) < m + 2 := b.isLt
        omega
      simp [hne]
  have hH_coeff_fin : ∀ j : Fin (m + 2), H.coeff (j : ℕ) = γ j := by
    intro j
    rw [hH_coeff (j : ℕ)]
    simp only [j.isLt, ↓reduceDIte, Fin.eta]
  have hBridge : ∀ (α : Fin (m + 1) → Ω) (β : Fin 2 → Ω),
      let A : Polynomial Ω := ∑ i : Fin (m + 1), Polynomial.C (α i) * Polynomial.X ^ (i : ℕ)
      let B : Polynomial Ω := ∑ r : Fin 2, Polynomial.C (β r) * Polynomial.X ^ (r : ℕ)
      A.eval c = 1 → B.eval c = 1 → A * B = H →
      (∑ i : Fin (m + 1), c ^ (i : ℕ) * α i = 1) ∧
      (∑ r : Fin 2, c ^ (r : ℕ) * β r = 1) ∧
      (∀ j : Fin (m + 2),
        (∑ p ∈ Finset.univ.filter
            (fun p : Fin (m + 1) × Fin 2 => (p.1 : ℕ) + (p.2 : ℕ) = (j : ℕ)),
          α p.1 * β p.2) = γ j) := by
    intro α β A B hA hB hAB
    refine ⟨?_, ?_, ?_⟩
    · rw [← hA]
      dsimp only [A]
      rw [Polynomial.eval_finsetSum]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_pow, Polynomial.eval_X, mul_comm]
    · rw [← hB]
      dsimp only [B]
      rw [Polynomial.eval_finsetSum]
      refine Finset.sum_congr rfl fun r _ => ?_
      rw [Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_pow, Polynomial.eval_X, mul_comm]
    · intro j
      calc
        (∑ p ∈ Finset.univ.filter
            (fun p : Fin (m + 1) × Fin 2 => (p.1 : ℕ) + (p.2 : ℕ) = (j : ℕ)),
          α p.1 * β p.2)
          = ∑ p : Fin (m + 1) × Fin 2,
              if (p.1 : ℕ) + (p.2 : ℕ) = (j : ℕ) then α p.1 * β p.2 else 0 := by
            rw [Finset.sum_filter]
        _ = ∑ p : Fin (m + 1) × Fin 2,
              ((Polynomial.C (α p.1) * Polynomial.X ^ (p.1 : ℕ)) *
                (Polynomial.C (β p.2) * Polynomial.X ^ (p.2 : ℕ))).coeff (j : ℕ) := by
            refine Finset.sum_congr rfl fun p _ => ?_
            have hprod : (Polynomial.C (α p.1) * Polynomial.X ^ (p.1 : ℕ)) *
                (Polynomial.C (β p.2) * Polynomial.X ^ (p.2 : ℕ)) =
                Polynomial.C (α p.1 * β p.2) * Polynomial.X ^ ((p.1 : ℕ) + (p.2 : ℕ)) := by
              rw [Polynomial.C_mul, pow_add]
              ring
            rw [hprod, Polynomial.coeff_C_mul, Polynomial.coeff_X_pow]
            by_cases hpj : (p.1 : ℕ) + (p.2 : ℕ) = (j : ℕ)
            · simp [hpj]
            · have hjp : (j : ℕ) ≠ (p.1 : ℕ) + (p.2 : ℕ) := Ne.symm hpj
              simp [hpj, hjp]
        _ = ∑ i : Fin (m + 1), ∑ r : Fin 2,
              ((Polynomial.C (α i) * Polynomial.X ^ (i : ℕ)) *
                (Polynomial.C (β r) * Polynomial.X ^ (r : ℕ))).coeff (j : ℕ) :=
            Fintype.sum_prod_type' fun i r =>
              ((Polynomial.C (α i) * Polynomial.X ^ (i : ℕ)) *
                (Polynomial.C (β r) * Polynomial.X ^ (r : ℕ))).coeff (j : ℕ)
        _ = (A * B).coeff (j : ℕ) := by
            dsimp only [A, B]
            rw [Finset.sum_mul_sum, Polynomial.finsetSum_coeff]
            refine Finset.sum_congr rfl fun i _ => ?_
            rw [Polynomial.finsetSum_coeff]
        _ = H.coeff (j : ℕ) := by rw [hAB]
        _ = γ j := hH_coeff_fin j
  by_cases htop : γ (Fin.last (m + 1)) = 0
  · let α : Fin (m + 1) → Ω := fun i => γ i.castSucc
    let β : Fin 2 → Ω := fun r => if (r : ℕ) = 0 then 1 else 0
    let A : Polynomial Ω := ∑ i : Fin (m + 1), Polynomial.C (α i) * Polynomial.X ^ (i : ℕ)
    let B : Polynomial Ω := ∑ r : Fin 2, Polynomial.C (β r) * Polynomial.X ^ (r : ℕ)
    have hHA : H = A := by
      dsimp only [H, A, α]
      rw [Fin.sum_univ_castSucc, htop, map_zero, zero_mul, add_zero]
      rfl
    have hB1 : B = 1 := by
      dsimp only [B, β]
      rw [Fin.sum_univ_two]
      simp
    have hAe : A.eval c = 1 := by
      rw [← hHA, hH_eval]
    have hBe : B.eval c = 1 := by
      rw [hB1, Polynomial.eval_one]
    have hAB : A * B = H := by
      rw [← hHA, hB1, mul_one]
    exact ⟨α, β, hBridge α β hAe hBe hAB⟩
  · have hH_top : H.coeff (m + 1) = γ (Fin.last (m + 1)) := by
      have hlt : m + 1 < m + 2 := Nat.lt_succ_self (m + 1)
      rw [hH_coeff (m + 1)]
      simp only [hlt, ↓reduceDIte]
      rfl
    have hH_ne : H ≠ 0 := by
      intro h0
      apply htop
      rw [← hH_top, h0, Polynomial.coeff_zero]
    have hH_natDeg : H.natDegree = m + 1 := by
      apply le_antisymm
      · rw [Polynomial.natDegree_le_iff_coeff_eq_zero]
        intro k hk
        have hnk : ¬ k < m + 2 := by omega
        rw [hH_coeff k]
        simp only [hnk, ↓reduceDIte]
      · apply Polynomial.le_natDegree_of_ne_zero
        rw [hH_top]
        exact htop
    have hH_deg_ne_zero : H.degree ≠ 0 := by
      rw [Polynomial.degree_eq_natDegree hH_ne, hH_natDeg]
      intro h0
      exact Nat.succ_ne_zero m (WithBot.coe_inj.mp h0)
    obtain ⟨ρ, hρ⟩ := IsAlgClosed.exists_root H hH_deg_ne_zero
    have hρ_eval : H.eval ρ = 0 := Polynomial.IsRoot.def.mp hρ
    let δ : Ω := c - ρ
    have hc_ne_ρ : c ≠ ρ := by
      intro h_eq
      have h10 : (1 : Ω) = 0 := by
        rw [← hH_eval, h_eq, hρ_eval]
      exact one_ne_zero h10
    have hδ_ne : δ ≠ 0 := sub_ne_zero.mpr hc_ne_ρ
    let Q₀ : Polynomial Ω := H.divByMonic (Polynomial.X - Polynomial.C ρ)
    have hFact : (Polynomial.X - Polynomial.C ρ) * Q₀ = H :=
      Polynomial.mul_divByMonic_eq_iff_isRoot.mpr hρ
    have hQc : δ * Q₀.eval c = 1 := by
      have hev := congrArg (Polynomial.eval c) hFact
      rw [Polynomial.eval_mul, Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C,
        hH_eval] at hev
      exact hev
    have hQ_lt : Q₀.natDegree < m + 1 := by
      have hdeg := Polynomial.natDegree_divByMonic H (Polynomial.monic_X_sub_C ρ)
      rw [hH_natDeg, Polynomial.natDegree_X_sub_C] at hdeg
      dsimp only [Q₀]
      omega
    have hQ_sum : Q₀ = ∑ i : Fin (m + 1), Polynomial.C (Q₀.coeff (i : ℕ)) * Polynomial.X ^ (i : ℕ) := by
      rw [Fin.sum_univ_eq_sum_range (fun k => Polynomial.C (Q₀.coeff k) * Polynomial.X ^ k) (m + 1)]
      exact Polynomial.as_sum_range_C_mul_X_pow' Q₀ hQ_lt
    let α : Fin (m + 1) → Ω := fun i => δ * Q₀.coeff (i : ℕ)
    let β : Fin 2 → Ω := fun r => if (r : ℕ) = 0 then -ρ * δ⁻¹ else δ⁻¹
    let A : Polynomial Ω := ∑ i : Fin (m + 1), Polynomial.C (α i) * Polynomial.X ^ (i : ℕ)
    let B : Polynomial Ω := ∑ r : Fin 2, Polynomial.C (β r) * Polynomial.X ^ (r : ℕ)
    have hA_eq : A = Polynomial.C δ * Q₀ := by
      conv_rhs => rw [hQ_sum]
      rw [Finset.mul_sum]
      dsimp only [A, α]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [Polynomial.C_mul, mul_assoc]
    have hB_eq : B = Polynomial.C δ⁻¹ * (Polynomial.X - Polynomial.C ρ) := by
      have hneg : -ρ * δ⁻¹ = -(δ⁻¹ * ρ) := by ring
      dsimp only [B, β]
      rw [Fin.sum_univ_two]
      simp only [Fin.val_zero, ↓reduceIte, pow_zero, mul_one, Fin.val_one, one_ne_zero, pow_one]
      rw [hneg, map_neg, mul_sub, ← Polynomial.C_mul]
      ring
    have hAe : A.eval c = 1 := by
      rw [hA_eq, Polynomial.eval_mul, Polynomial.eval_C]
      exact hQc
    have hBe : B.eval c = 1 := by
      rw [hB_eq, Polynomial.eval_mul, Polynomial.eval_sub, Polynomial.eval_C,
        Polynomial.eval_X, Polynomial.eval_C]
      exact inv_mul_cancel₀ hδ_ne
    have hAB : A * B = H := by
      calc
        A * B = (Polynomial.C δ * Q₀) * (Polynomial.C δ⁻¹ * (Polynomial.X - Polynomial.C ρ)) := by
          rw [hA_eq, hB_eq]
        _ = (Polynomial.C δ * Polynomial.C δ⁻¹) * ((Polynomial.X - Polynomial.C ρ) * Q₀) := by
          ring
        _ = Polynomial.C (δ * δ⁻¹) * H := by
          rw [← Polynomial.C_mul, hFact]
        _ = H := by
          rw [mul_inv_cancel₀ hδ_ne, map_one, one_mul]
    exact ⟨α, β, hBridge α β hAe hBe hAB⟩

theorem weil_vieta_binary_form_cover_projSpace (k : Type u) [Field k] [IsAlgClosed k] :
    CategoryTheory.IsIso (weilProjectiveSpaceOver k 0).hom ∧
    ∀ (m : ℕ), ∃ (μ : CategoryTheory.Limits.pullback
        (weilProjectiveSpaceOver k m).hom (weilProjectiveSpaceOver k 1).hom ⟶
        (weilProjectiveSpaceOver k (m + 1)).left),
      AlgebraicGeometry.IsFinite μ ∧
      AlgebraicGeometry.Surjective μ ∧
      μ ≫ (weilProjectiveSpaceOver k (m + 1)).hom =
        CategoryTheory.Limits.pullback.fst
          (weilProjectiveSpaceOver k m).hom (weilProjectiveSpaceOver k 1).hom ≫
          (weilProjectiveSpaceOver k m).hom :=
by
  obtain ⟨hIsoP0, hVand⟩ := weil_projSpace_zero_isIso_and_vandermonde_cover k
  refine ⟨hIsoP0, fun m => ?_⟩
  classical
  let _ : Infinite k := IsAlgClosed.instInfinite
  let a : Fin (m + 2) → k := fun s => Infinite.natEmbedding k (s : ℕ)
  have ha : Function.Injective a := fun s t h =>
    Fin.ext ((Infinite.natEmbedding k).injective h)
  let _ : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) k) :=
    MvPolynomial.gradedAlgebra
  let _ : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 2) k) :=
    MvPolynomial.gradedAlgebra
  let _ : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (m + 2)) k) :=
    MvPolynomial.gradedAlgebra
  obtain ⟨hL_m, hCard_m⟩ := hVand m (m + 2) a ha
  obtain ⟨hL_1, hCard_1⟩ := hVand 1 (m + 2) a ha
  obtain ⟨hL_succ, hCard_succ⟩ := hVand (m + 1) (m + 2) a ha

  have hCov :
      ∀ z : ↥(CategoryTheory.Limits.pullback
          (weilProjectiveSpaceOver k m).hom (weilProjectiveSpaceOver k 1).hom),
        ∃ s : Fin (m + 2),
          z ∈ (TopologicalSpace.Opens.map
            (CategoryTheory.Limits.pullback.fst
              (weilProjectiveSpaceOver k m).hom (weilProjectiveSpaceOver k 1).hom).base).obj
            (AlgebraicGeometry.Proj.basicOpen
              (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) k)
              (∑ i : Fin (m + 1),
                (MvPolynomial.C (a s ^ (i : ℕ)) : MvPolynomial (Fin (m + 1)) k) *
                  (MvPolynomial.X i : MvPolynomial (Fin (m + 1)) k))) ⊓
          (TopologicalSpace.Opens.map
            (CategoryTheory.Limits.pullback.snd
              (weilProjectiveSpaceOver k m).hom (weilProjectiveSpaceOver k 1).hom).base).obj
            (AlgebraicGeometry.Proj.basicOpen
              (MvPolynomial.homogeneousSubmodule (Fin 2) k)
              (∑ r : Fin 2,
                (MvPolynomial.C (a s ^ (r : ℕ)) : MvPolynomial (Fin 2) k) *
                  (MvPolynomial.X r : MvPolynomial (Fin 2) k))) := by
    intro z
    let fst := CategoryTheory.Limits.pullback.fst
      (weilProjectiveSpaceOver k m).hom (weilProjectiveSpaceOver k 1).hom
    let snd := CategoryTheory.Limits.pullback.snd
      (weilProjectiveSpaceOver k m).hom (weilProjectiveSpaceOver k 1).hom
    let S₁ : Finset (Fin (m + 2)) := Finset.univ.filter fun s : Fin (m + 2) =>
      fst.base z ∉ AlgebraicGeometry.Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) k)
        (∑ i : Fin (m + 1),
          (MvPolynomial.C (a s ^ (i : ℕ)) : MvPolynomial (Fin (m + 1)) k) *
            (MvPolynomial.X i : MvPolynomial (Fin (m + 1)) k))
    let S₂ : Finset (Fin (m + 2)) := Finset.univ.filter fun s : Fin (m + 2) =>
      snd.base z ∉ AlgebraicGeometry.Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin 2) k)
        (∑ r : Fin 2,
          (MvPolynomial.C (a s ^ (r : ℕ)) : MvPolynomial (Fin 2) k) *
            (MvPolynomial.X r : MvPolynomial (Fin 2) k))
    have hlt : (S₁ ∪ S₂).card < (Finset.univ : Finset (Fin (m + 2))).card := by
      have h1 : S₁.card ≤ m := hCard_m (fst.base z) S₁ fun s hs => (Finset.mem_filter.mp hs).2
      have h2 : S₂.card ≤ 1 := hCard_1 (snd.base z) S₂ fun s hs => (Finset.mem_filter.mp hs).2
      have hu : (S₁ ∪ S₂).card ≤ S₁.card + S₂.card := Finset.card_union_le S₁ S₂
      simp only [Finset.card_univ, Fintype.card_fin]
      omega
    obtain ⟨s, -, hs⟩ := Finset.exists_mem_notMem_of_card_lt_card hlt
    rw [Finset.mem_union, not_or, Finset.mem_filter, Finset.mem_filter] at hs
    exact ⟨s,
      by_contra fun h1 => hs.1 ⟨Finset.mem_univ s, h1⟩,
      by_contra fun h2 => hs.2 ⟨Finset.mem_univ s, h2⟩⟩

  obtain ⟨μ, hComm, hPre, hLift⟩ :=
    weil_vieta_glued_morphism_and_vandermonde_charts k m a hCov

  have hCov_succ : ∀ y : ↥(weilProjectiveSpaceOver k (m + 1)).left,
      ∃ s : Fin (m + 2),
        y ∈ AlgebraicGeometry.Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin (m + 2)) k)
          (∑ j : Fin (m + 2),
            (MvPolynomial.C (a s ^ (j : ℕ)) : MvPolynomial (Fin (m + 2)) k) *
              (MvPolynomial.X j : MvPolynomial (Fin (m + 2)) k)) := by
    intro y
    let Sy : Finset (Fin (m + 2)) := Finset.univ.filter fun s : Fin (m + 2) =>
      y ∉ AlgebraicGeometry.Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin (m + 2)) k)
        (∑ j : Fin (m + 2),
          (MvPolynomial.C (a s ^ (j : ℕ)) : MvPolynomial (Fin (m + 2)) k) *
            (MvPolynomial.X j : MvPolynomial (Fin (m + 2)) k))
    have hlt : Sy.card < (Finset.univ : Finset (Fin (m + 2))).card := by
      have hle : Sy.card ≤ m + 1 :=
        hCard_succ y Sy fun s hs => (Finset.mem_filter.mp hs).2
      simp only [Finset.card_univ, Fintype.card_fin]
      omega
    obtain ⟨s, -, hs⟩ := Finset.exists_mem_notMem_of_card_lt_card hlt
    rw [Finset.mem_filter] at hs
    exact ⟨s, by_contra fun hnot => hs ⟨Finset.mem_univ s, hnot⟩⟩

  have hFin_μ : AlgebraicGeometry.IsFinite μ := by
    refine weil_projSpace_pullback_isFinite_of_affineOpen_cover k m 1 (m + 1) μ hComm fun y => ?_
    obtain ⟨b, hb⟩ := hCov_succ y
    exact ⟨AlgebraicGeometry.Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin (m + 2)) k)
        (∑ j : Fin (m + 2),
          (MvPolynomial.C (a b ^ (j : ℕ)) : MvPolynomial (Fin (m + 2)) k) *
            (MvPolynomial.X j : MvPolynomial (Fin (m + 2)) k)),
      AlgebraicGeometry.Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) k)
        (∑ i : Fin (m + 1),
          (MvPolynomial.C (a b ^ (i : ℕ)) : MvPolynomial (Fin (m + 1)) k) *
            (MvPolynomial.X i : MvPolynomial (Fin (m + 1)) k)),
      AlgebraicGeometry.Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin 2) k)
        (∑ r : Fin 2,
          (MvPolynomial.C (a b ^ (r : ℕ)) : MvPolynomial (Fin 2) k) *
            (MvPolynomial.X r : MvPolynomial (Fin 2) k)),
      hb,
      AlgebraicGeometry.Proj.isAffineOpen_basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin (m + 2)) k) _ (hL_succ b) zero_lt_one,
      AlgebraicGeometry.Proj.isAffineOpen_basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) k) _ (hL_m b) zero_lt_one,
      AlgebraicGeometry.Proj.isAffineOpen_basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin 2) k) _ (hL_1 b) zero_lt_one,
      hPre b⟩

  have hSurj_μ : AlgebraicGeometry.Surjective μ := by
    refine ⟨fun y => ?_⟩
    obtain ⟨s₀, hs₀⟩ := hCov_succ y
    let P_succ := weilProjectiveSpaceOver k (m + 1)
    let κ_y := P_succ.left.residueField y
    let Ω : Type u := AlgebraicClosure ↥κ_y
    let ybar : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ P_succ.left :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥κ_y Ω)) ≫
        P_succ.left.fromSpecResidueField y
    have hybar_pt : ∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)), ybar.base pt = y := by
      intro pt
      dsimp only [ybar]
      change (P_succ.left.fromSpecResidueField y).base _ = y
      exact AlgebraicGeometry.Scheme.fromSpecResidueField_apply y _
    have hybar_sub : ∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)),
        ybar.base pt ∈ AlgebraicGeometry.Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin (m + 2)) k)
          (∑ j : Fin (m + 2),
            (MvPolynomial.C (a s₀ ^ (j : ℕ)) : MvPolynomial (Fin (m + 2)) k) *
              (MvPolynomial.X j : MvPolynomial (Fin (m + 2)) k)) := by
      intro pt
      rw [hybar_pt pt]
      exact hs₀
    obtain ⟨σ_k, γ, hγ_norm, hMakeLift⟩ := hLift s₀ Ω ybar hybar_sub
    obtain ⟨α, β, hα, hβ, hProd⟩ :=
      weil_algClosed_binary_form_chart_split Ω m (σ_k (a s₀)) γ hγ_norm
    obtain ⟨ytilde, hytilde⟩ := hMakeLift α β hα hβ hProd
    obtain ⟨pt₀⟩ := (inferInstance : Nonempty ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)))
    refine ⟨ytilde.base pt₀, ?_⟩
    change (ytilde ≫ μ).base pt₀ = y
    rw [hytilde, hybar_pt pt₀]

  exact ⟨μ, hFin_μ, hSurj_μ, hComm⟩

theorem weil_relative_chow_projective_factorization (k : Type u) [Field k]
    (X S : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.LocallyOfFiniteType S.hom]
    [AlgebraicGeometry.IsAffine S.left]
    (f : X ⟶ S) [AlgebraicGeometry.IsProper f.left] :
    ∃ (N : ℕ) (X_tilde : AlgebraicGeometry.Scheme.{u})
      (ι_X : X_tilde ⟶ CategoryTheory.Limits.pullback X.hom (weilProjectiveSpaceOver k N).hom)
      (ι_S : X_tilde ⟶ CategoryTheory.Limits.pullback S.hom (weilProjectiveSpaceOver k N).hom),
      AlgebraicGeometry.IsFinite ι_X ∧
      AlgebraicGeometry.IsFinite ι_S ∧
      AlgebraicGeometry.Surjective
        (ι_X ≫ CategoryTheory.Limits.pullback.fst X.hom (weilProjectiveSpaceOver k N).hom) ∧
      (ι_X ≫ CategoryTheory.Limits.pullback.fst X.hom (weilProjectiveSpaceOver k N).hom) ≫ f.left =
        ι_S ≫ CategoryTheory.Limits.pullback.fst S.hom (weilProjectiveSpaceOver k N).hom :=
by
  classical
  
  have appLE_congr : ∀ {A B : AlgebraicGeometry.Scheme.{u}} {f₁ f₂ : A ⟶ B} (h : f₁ = f₂)
      (U_B : B.Opens) (V_A : A.Opens)
      (h₁ : V_A ≤ f₁ ⁻¹ᵁ U_B) (h₂ : V_A ≤ f₂ ⁻¹ᵁ U_B),
      f₁.appLE U_B V_A h₁ = f₂.appLE U_B V_A h₂ := by
    intro A B f₁ f₂ h U_B V_A h₁ h₂
    subst h
    rfl
  have appLE_res : ∀ {A B : AlgebraicGeometry.Scheme.{u}} (h : A ⟶ B)
      (U_B : B.Opens) (V₁ V₂ : A.Opens) (h₁ : V₁ ≤ h ⁻¹ᵁ U_B) (hle : V₂ ≤ V₁),
      h.appLE U_B V₁ h₁ ≫ A.presheaf.map (homOfLE hle).op =
        h.appLE U_B V₂ (hle.trans h₁) := by
    intro A B h U_B V₁ V₂ h₁ hle
    unfold AlgebraicGeometry.Scheme.Hom.appLE
    rw [Category.assoc, ← CategoryTheory.Functor.map_comp]
    congr 2
  have appLE_top_top : ∀ {A B : AlgebraicGeometry.Scheme.{u}} (v : A ⟶ B)
      (hv : (⊤ : A.Opens) ≤ v ⁻¹ᵁ ⊤),
      v.appLE ⊤ ⊤ hv = v.appTop := by
    intro A B v hv
    unfold AlgebraicGeometry.Scheme.Hom.appLE AlgebraicGeometry.Scheme.Hom.appTop
    have h_eq_top : v ⁻¹ᵁ (⊤ : B.Opens) = ⊤ := rfl
    have heq : (homOfLE hv).op = eqToHom (congrArg Opposite.op h_eq_top) := Subsingleton.elim _ _
    rw [heq, eqToHom_map]
    erw [eqToHom_refl, Category.comp_id]
  have hι_self : ∀ {Y : AlgebraicGeometry.Scheme.{u}} (W : Y.Opens),
      W.ι.appLE W ⊤ (fun x _ => x.2) = W.topIso.inv := by
    intro Y W
    unfold AlgebraicGeometry.Scheme.Hom.appLE
    have h_top : W.ι ⁻¹ᵁ W = ⊤ := by
      ext x
      exact ⟨fun _ => trivial, fun _ => x.2⟩
    have h_hom :
        homOfLE (fun x _ => x.2 : (⊤ : (W : AlgebraicGeometry.Scheme.{u}).Opens) ≤ W.ι ⁻¹ᵁ W) =
          eqToHom h_top.symm := Subsingleton.elim _ _
    rw [h_hom, AlgebraicGeometry.Scheme.Opens.ι_app_self,
      AlgebraicGeometry.Scheme.Opens.topIso_inv]
    simp only [eqToHom_op, eqToHom_map]
    erw [eqToHom_map]
    exact eqToHom_trans _ _
  have h_ι_appTop : ∀ {Y : AlgebraicGeometry.Scheme.{u}} (W : Y.Opens),
      W.ι.appTop = Y.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op ≫ W.topIso.inv := by
    intro Y W
    have h_id_appLE : AlgebraicGeometry.Scheme.Hom.appLE (𝟙 Y) ⊤ W (fun _ _ => trivial) =
        Y.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op := by
      unfold AlgebraicGeometry.Scheme.Hom.appLE
      have h_id_top : AlgebraicGeometry.Scheme.Hom.app (𝟙 Y) ⊤ = 𝟙 _ :=
        AlgebraicGeometry.Scheme.Hom.id_appTop
      erw [h_id_top, Category.id_comp]
      rfl
    rw [← h_id_appLE, ← hι_self W,
      AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE W.ι (𝟙 Y) ⊤ W ⊤
        (fun _ _ => trivial) (fun x _ => x.2),
      appLE_congr (Category.comp_id W.ι) ⊤ ⊤ _ (fun _ _ => trivial),
      appLE_top_top W.ι (fun _ _ => trivial)]
  have hComp_ι_appLE : ∀ {A Y : AlgebraicGeometry.Scheme.{u}} (W : Y.Opens)
      (v : A ⟶ (W : AlgebraicGeometry.Scheme.{u}))
      (hv : (⊤ : A.Opens) ≤ (v ≫ W.ι) ⁻¹ᵁ W),
      (v ≫ W.ι).appLE W ⊤ hv = W.topIso.inv ≫ v.appTop := by
    intro A Y W v hv
    rw [← AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE v W.ι W ⊤ ⊤ (fun x _ => x.2) le_top,
      hι_self W, appLE_top_top v le_top]
  have hSpecId : ∀ (R : CommRingCat.{u}),
      (AlgebraicGeometry.Spec R).toSpecΓ ≫
        AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.ΓSpecIso R).inv =
        𝟙 (AlgebraicGeometry.Spec R) := by
    intro R
    apply (cancel_mono (AlgebraicGeometry.Spec R).toSpecΓ).mp
    rw [Category.id_comp, AlgebraicGeometry.Scheme.toSpecΓ_naturality]
    have happ : ((AlgebraicGeometry.Spec R).toSpecΓ ≫
        AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.ΓSpecIso R).inv).appTop = 𝟙 _ := by
      rw [AlgebraicGeometry.Scheme.Hom.comp_appTop,
        AlgebraicGeometry.Scheme.toSpecΓ_appTop,
        AlgebraicGeometry.Scheme.ΓSpecIso_naturality,
        Iso.hom_inv_id]
    rw [happ, AlgebraicGeometry.Spec.map_id, Category.comp_id]
  have hΓSpec_inv_nat : ∀ {R₁ R₂ : CommRingCat.{u}} (φ : R₁ ⟶ R₂),
      φ ≫ (AlgebraicGeometry.Scheme.ΓSpecIso R₂).inv =
        (AlgebraicGeometry.Scheme.ΓSpecIso R₁).inv ≫
          (AlgebraicGeometry.Spec.map φ).appTop := by
    intro R₁ R₂ φ
    rw [Iso.comp_inv_eq, Category.assoc, AlgebraicGeometry.Scheme.ΓSpecIso_naturality,
      Iso.inv_hom_id_assoc]
  have toSpecΓ_SpecMap_of_eq : ∀ {W : AlgebraicGeometry.Scheme.{u}} {R : CommRingCat.{u}}
      (u : W ⟶ AlgebraicGeometry.Spec R)
      (φ : R ⟶ W.presheaf.obj (Opposite.op ⊤)),
      φ = (AlgebraicGeometry.Scheme.ΓSpecIso R).inv ≫ u.appTop →
      W.toSpecΓ ≫ AlgebraicGeometry.Spec.map φ = u := by
    intro W R u φ hφ
    rw [hφ, AlgebraicGeometry.Spec.map_comp, ← Category.assoc,
      ← AlgebraicGeometry.Scheme.toSpecΓ_naturality u,
      Category.assoc, hSpecId, Category.comp_id]
  have appTop_toSpecΓ_SpecMap : ∀ {W : AlgebraicGeometry.Scheme.{u}} {R : CommRingCat.{u}}
      (φ : R ⟶ W.presheaf.obj (Opposite.op ⊤)),
      (AlgebraicGeometry.Scheme.ΓSpecIso R).inv ≫
        (W.toSpecΓ ≫ AlgebraicGeometry.Spec.map φ).appTop = φ := by
    intro W R φ
    rw [AlgebraicGeometry.Scheme.Hom.comp_appTop, ← Category.assoc,
      ← hΓSpec_inv_nat φ, Category.assoc,
      AlgebraicGeometry.Scheme.toSpecΓ_appTop, Iso.inv_hom_id, Category.comp_id]
  
  have step1 : ∃ (m : ℕ) (Z : Fin m → AlgebraicGeometry.Scheme.{u})
      (i : ∀ t : Fin m, Z t ⟶ X.left),
      (∀ t : Fin m, AlgebraicGeometry.IsClosedImmersion (i t)) ∧
      (∀ t : Fin m, AlgebraicGeometry.IsIntegral (Z t)) ∧
      (⋃ t : Fin m, Set.range (i t).base) = Set.univ := by
    have : AlgebraicGeometry.IsLocallyNoetherian S.left :=
      AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian S.hom
    have : AlgebraicGeometry.IsLocallyNoetherian X.left :=
      AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian f.left
    have : CompactSpace ↥X.left :=
      AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace f.left
    have : AlgebraicGeometry.IsNoetherian X.left := {}
    have : TopologicalSpace.NoetherianSpace ↥X.left :=
      AlgebraicGeometry.IsNoetherian.noetherianSpace
    obtain ⟨S_fin, hIrred_fin, hSup_fin⟩ :=
      TopologicalSpace.NoetherianSpace.exists_finset_irreducible
        (⊤ : TopologicalSpace.Closeds ↥X.left)
    let m : ℕ := S_fin.card
    let e_S : ↥S_fin ≃ Fin m := S_fin.equivFin
    let C : Fin m → TopologicalSpace.Closeds ↥X.left := fun t => (e_S.symm t).1
    let I : Fin m → X.left.IdealSheafData :=
      fun t => AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal (C t)
    let Z : Fin m → AlgebraicGeometry.Scheme.{u} := fun t => (I t).subscheme
    let i : ∀ t : Fin m, Z t ⟶ X.left := fun t => (I t).subschemeι
    have hRange : ∀ t : Fin m, Set.range (i t).base = (C t : Set ↥X.left) := by
      intro t
      dsimp [i, I]
      rw [AlgebraicGeometry.Scheme.IdealSheafData.range_subschemeι,
        AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal]
    refine ⟨m, Z, i, fun t => inferInstance, ?_, ?_⟩
    · intro t
      have hIrredC : IsIrreducible (C t : Set ↥X.left) := hIrred_fin (e_S.symm t)
      have hEmb : Topology.IsClosedEmbedding (i t).base :=
        AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding (i t)
      have hIrredZ : IrreducibleSpace ↥(Z t) := by
        refine { isPreirreducible_univ := ?_, toNonempty := ?_ }
        · intro U₁ U₂ hU₁ hU₂ ⟨z₁, _, hz₁⟩ ⟨z₂, _, hz₂⟩
          obtain ⟨V₁, hV₁, rfl⟩ := hEmb.isInducing.isOpen_iff.mp hU₁
          obtain ⟨V₂, hV₂, rfl⟩ := hEmb.isInducing.isOpen_iff.mp hU₂
          have hx₁ : (i t).base z₁ ∈ (C t : Set ↥X.left) ∩ V₁ :=
            ⟨hRange t ▸ ⟨z₁, rfl⟩, hz₁⟩
          have hx₂ : (i t).base z₂ ∈ (C t : Set ↥X.left) ∩ V₂ :=
            ⟨hRange t ▸ ⟨z₂, rfl⟩, hz₂⟩
          obtain ⟨x, hxC, hxV₁, hxV₂⟩ :=
            hIrredC.isPreirreducible V₁ V₂ hV₁ hV₂ ⟨_, hx₁⟩ ⟨_, hx₂⟩
          rw [← hRange t] at hxC
          obtain ⟨z, rfl⟩ := hxC
          exact ⟨z, trivial, hxV₁, hxV₂⟩
        · obtain ⟨x₀, hx₀⟩ := hIrredC.nonempty
          rw [← hRange t] at hx₀
          obtain ⟨z₀, _⟩ := hx₀
          exact ⟨z₀⟩
      have hSupp : (I t).support = C t :=
        SetLike.ext' (AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal (C t))
      have hRad : (I t).radical = I t := by
        dsimp [I]
        nth_rw 2 [← hSupp]
        exact (I t).vanishingIdeal_support.symm
      have : ∀ W : ((I t).subschemeCover.openCover).I₀,
          AlgebraicGeometry.IsReduced (((I t).subschemeCover.openCover).X W) := by
        intro W
        let W_aff : X.left.affineOpens := W
        change AlgebraicGeometry.IsReduced
          (AlgebraicGeometry.Spec
            (CommRingCat.of (↑(X.left.presheaf.obj (Opposite.op W_aff.1)) ⧸ (I t).ideal W_aff)))
        have hIdRad : ((I t).ideal W_aff).IsRadical := by
          have hEqId : ((I t).ideal W_aff).radical = (I t).ideal W_aff := by
            rw [← AlgebraicGeometry.Scheme.IdealSheafData.radical_ideal, hRad]
          rw [← hEqId]
          exact Ideal.radical_isRadical _
        have : IsReduced (↑(X.left.presheaf.obj (Opposite.op W_aff.1)) ⧸ (I t).ideal W_aff) :=
          (Ideal.isRadical_iff_quotient_reduced _).mp hIdRad
        infer_instance
      have hRedZ : AlgebraicGeometry.IsReduced (Z t) :=
        AlgebraicGeometry.IsReduced.of_openCover (Z t) (I t).subschemeCover.openCover
      exact @AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced (Z t) hRedZ hIrredZ
    · apply Set.eq_univ_of_forall
      intro x
      let K_cl : TopologicalSpace.Closeds ↥X.left :=
        ⟨⋃ c ∈ S_fin, (c : Set ↥X.left),
          S_fin.finite_toSet.isClosed_biUnion (fun c _ => c.isClosed)⟩
      have hSupLE : S_fin.sup id ≤ K_cl :=
        Finset.sup_le (fun c hc => Set.subset_biUnion_of_mem hc)
      have hx_top : x ∈ ((⊤ : TopologicalSpace.Closeds ↥X.left) : Set ↥X.left) := trivial
      rw [hSup_fin] at hx_top
      have hx_K : x ∈ (K_cl : Set ↥X.left) := hSupLE hx_top
      obtain ⟨c, hc_mem⟩ := Set.mem_iUnion.mp hx_K
      obtain ⟨hcS, hxc⟩ := Set.mem_iUnion.mp hc_mem
      refine Set.mem_iUnion.mpr ⟨e_S ⟨c, hcS⟩, ?_⟩
      rw [hRange]
      simpa [C] using hxc
  
  have step2 : ∀ (Z₀ : AlgebraicGeometry.Scheme.{u})
      (hIntZ : AlgebraicGeometry.IsIntegral Z₀)
      (g_Z : Z₀ ⟶ S.left) [AlgebraicGeometry.IsProper g_Z],
      Z₀.IsSeparated ∧
      ∃ (r : ℕ) (_ : 0 < r) (U : Fin r → Z₀.Opens),
        (⨆ j : Fin r, U j = ⊤) ∧
        (∀ j : Fin r, AlgebraicGeometry.IsAffineOpen (U j)) ∧
        (∀ j : Fin r, Nonempty ↥(U j)) ∧
        ∃ (n : Fin r → ℕ)
          (f_gen : ∀ j : Fin r, Fin (n j) → ↑(Z₀.presheaf.obj (Opposite.op (U j)))),
          (∀ j : Fin r,
            Function.Surjective
              (MvPolynomial.eval₂Hom
                ((AlgebraicGeometry.Scheme.Hom.appLE g_Z ⊤ (U j) le_top).hom) (f_gen j))) ∧
          ∃ (U₀ : Z₀.Opens),
            (∀ j : Fin r, U₀ ≤ U j) ∧
            Nonempty ↥U₀ ∧
            AlgebraicGeometry.IsAffineOpen U₀ := by
    intro Z₀ hIntZ g_Z _
    have hSepZ : Z₀.IsSeparated := by
      rw [AlgebraicGeometry.Scheme.isSeparated_iff]
      have hTermS : AlgebraicGeometry.IsSeparated (CategoryTheory.Limits.terminal.from S.left) :=
        (AlgebraicGeometry.Scheme.isSeparated_iff S.left).mp inferInstance
      have hEq : CategoryTheory.Limits.terminal.from Z₀ =
          g_Z ≫ CategoryTheory.Limits.terminal.from S.left :=
        CategoryTheory.Limits.terminal.hom_ext _ _
      rw [hEq]
      infer_instance
