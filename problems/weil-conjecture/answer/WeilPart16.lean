      have hPrime : 𝔭.IsPrime := y'.isPrime
      let D := MvPolynomial (Fin (n + 1)) k ⧸ 𝔭
      let _ : IsDomain D := (Ideal.Quotient.isDomain_iff_prime 𝔭).mpr hPrime
