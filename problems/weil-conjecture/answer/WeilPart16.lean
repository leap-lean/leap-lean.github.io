    have hX : ∀ γ : Fin (N + 1), (MvPolynomial.X γ : MvPolynomial (Fin (N + 1)) k) ∈ 𝒜 1 :=
      fun γ => MvPolynomial.isHomogeneous_X k γ
    have hX_smul : ∀ γ : Fin (N + 1),
        (MvPolynomial.X γ : MvPolynomial (Fin (N + 1)) k) ∈ 𝒜 (1 • 1) := by
      intro γ; simpa using hX γ
    let f_ext : ∀ j : Fin r, Fin (n j + 1) → ↑(Z₀.presheaf.obj (Opposite.op (U j))) :=
