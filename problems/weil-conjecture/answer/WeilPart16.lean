theorem weil_projLine_filtered_ring_colimit_of_affine_all_degrees (k : Type u) [Field k]
    (hc_all : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      (weilEtaleSitePullback f).IsContinuous Z₂.smallEtaleTopology Z₁.smallEtaleTopology)
    (hr_all : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _ (weilEtaleSitePullback f)
        AddCommGrpCat.{u} _ Z₂.smallEtaleTopology Z₁.smallEtaleTopology (@hc_all Z₁ Z₂ f)).IsRightAdjoint)
    (hSite : WeilEtaleSiteExactAndSliceInjHolds.{u} (@hc_all) (@hr_all))
    (hAffAll : ∀ (q : ℕ), WeilAffineFilteredRingColimitAtDegreeHolds.{u} (@hc_all) (@hr_all) q)
    (ℐ : Type u) [CategoryTheory.SmallCategory ℐ] [CategoryTheory.IsFiltered ℐ]
    (D₀ : Type u) [CommRing D₀] [Algebra k D₀]
    (D : CategoryTheory.Functor ℐ CommRingCat.{u})
    (α : Quiver.Hom ((CategoryTheory.Functor.const ℐ).obj (CommRingCat.of D₀)) D)
    (c : CategoryTheory.Limits.Cocone D) (hc : CategoryTheory.Limits.IsColimit c)
    (f_inf : Quiver.Hom (CommRingCat.of D₀) c.pt)
    (hf_inf : ∀ i : ℐ, CategoryTheory.CategoryStruct.comp (α.app i) (c.ι.app i) = f_inf) :
    letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
        (weilEtaleSitePullback f).IsContinuous Z₂.smallEtaleTopology Z₁.smallEtaleTopology := @hc_all
    letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
        ((weilEtaleSitePullback f).sheafPushforwardContinuous AddCommGrpCat.{u}
          Z₂.smallEtaleTopology Z₁.smallEtaleTopology).IsRightAdjoint := @hr_all
    let Z₀ := AlgebraicGeometry.Spec (CommRingCat.of D₀)
    let s₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k D₀))
    let P₁ := weilProjectiveSpaceOver k 1
    let X₀ := CategoryTheory.Limits.pullback s₀ P₁.hom
    let p₁₀ := CategoryTheory.Limits.pullback.fst s₀ P₁.hom
    let p_i : ∀ i : ℐ, Quiver.Hom (AlgebraicGeometry.Spec (D.obj i)) Z₀ :=
      fun i => AlgebraicGeometry.Spec.map (α.app i)
    let p_inf : Quiver.Hom (AlgebraicGeometry.Spec c.pt) Z₀ :=
      AlgebraicGeometry.Spec.map f_inf
    let u_i : ∀ i : ℐ, Quiver.Hom (AlgebraicGeometry.Spec c.pt) (AlgebraicGeometry.Spec (D.obj i)) :=
      fun i => AlgebraicGeometry.Spec.map (c.ι.app i)
    ∀ (F₀ : CategoryTheory.Sheaf X₀.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ)
      (X_inf : AlgebraicGeometry.Scheme.{u})
      (f_infX : Quiver.Hom X_inf (AlgebraicGeometry.Spec c.pt))
      (π_inf : Quiver.Hom X_inf X₀)
      (_ : CategoryTheory.IsPullback f_infX π_inf p_inf p₁₀)
      (X_lvl : ℐ → AlgebraicGeometry.Scheme.{u})
      (f_lvl : ∀ i : ℐ, Quiver.Hom (X_lvl i) (AlgebraicGeometry.Spec (D.obj i)))
      (π_lvl : ∀ i : ℐ, Quiver.Hom (X_lvl i) X₀)
      (_ : ∀ i : ℐ, CategoryTheory.IsPullback (f_lvl i) (π_lvl i) (p_i i) p₁₀)
      (uX : ∀ i : ℐ, Quiver.Hom X_inf (X_lvl i))
      (_ : ∀ i : ℐ, CategoryTheory.CategoryStruct.comp (uX i) (f_lvl i) =
        CategoryTheory.CategoryStruct.comp f_infX (u_i i))
      (huX : ∀ i : ℐ, CategoryTheory.CategoryStruct.comp (uX i) (π_lvl i) = π_inf)
      (vX : ∀ {i j : ℐ}, Quiver.Hom i j → Quiver.Hom (X_lvl j) (X_lvl i))
      (_ : ∀ {i j : ℐ} (θ : Quiver.Hom i j),
        CategoryTheory.CategoryStruct.comp (vX θ) (f_lvl i) =
          CategoryTheory.CategoryStruct.comp (f_lvl j) (AlgebraicGeometry.Spec.map (D.map θ)))
      (hvX : ∀ {i j : ℐ} (θ : Quiver.Hom i j),
        CategoryTheory.CategoryStruct.comp (vX θ) (π_lvl i) = π_lvl j),
      (∀ (x_inf : (((weilEtaleSitePullback π_inf).sheafPullback AddCommGrpCat.{u}
            X₀.smallEtaleTopology X_inf.smallEtaleTopology).obj F₀).H q),
        ∃ (i : ℐ) (x_i : (((weilEtaleSitePullback (π_lvl i)).sheafPullback AddCommGrpCat.{u}
            X₀.smallEtaleTopology (X_lvl i).smallEtaleTopology).obj F₀).H q),
          WeilEtaleTrianglePullbackMapsTo π_inf (π_lvl i) (uX i) (huX i) F₀ q x_i x_inf) ∧
      (∀ (i : ℐ) (x_i : (((weilEtaleSitePullback (π_lvl i)).sheafPullback AddCommGrpCat.{u}
            X₀.smallEtaleTopology (X_lvl i).smallEtaleTopology).obj F₀).H q),
        WeilEtaleTrianglePullbackMapsTo π_inf (π_lvl i) (uX i) (huX i) F₀ q x_i 0 →
        ∃ (j : ℐ) (θ : Quiver.Hom i j),
          WeilEtaleTrianglePullbackMapsTo (π_lvl j) (π_lvl i) (vX θ) (hvX θ) F₀ q x_i 0) :=
by
  intro Z₀ s₀ P₁ X₀ p₁₀ p_i p_inf u_i
    F₀ q X_inf f_infX π_inf hpb_inf X_lvl f_lvl π_lvl hpb_lvl
    uX huX_f huX vX hvX_f hvX
  haveI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      (weilEtaleSitePullback f).IsContinuous Z₂.smallEtaleTopology Z₁.smallEtaleTopology := @hc_all
  haveI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      ((weilEtaleSitePullback f).sheafPushforwardContinuous AddCommGrpCat.{u}
        Z₂.smallEtaleTopology Z₁.smallEtaleTopology).IsRightAdjoint := @hr_all
  
  have hFunc : WeilEtaleBasePullExtFunctorialityHolds.{u} (@hc_all) (@hr_all) hSite :=
    weil_etale_basePullExt_functoriality_and_rebase (@hc_all) (@hr_all) hSite
  have hCore : WeilFreeYonedaPullbackCoreHolds.{u} (@hc_all) (@hr_all) :=
    (weil_etale_freeYoneda_pullback_resolution_and_pushout_effacement
      (@hc_all) (@hr_all) hSite hFunc).1
  have hSliceIso : WeilEtaleSliceCohomologyIsoHolds.{u} (@hc_all) (@hr_all) hSite :=
    weil_etale_slice_cohomology_bijective (@hc_all) (@hr_all) hSite
  have hConst : WeilSliceColimConstAndTerminalHolds.{u} (@hc_all) (@hr_all) hSite :=
    weil_etale_const_pullback_cocycle_and_terminal_colimit
      (@hc_all) (@hr_all) hSite hFunc hCore
  have hSliceComp : WeilSliceColimBaseSliceComparisonHolds.{u} (@hc_all) (@hr_all) hSite :=
    weil_etale_base_slice_ext_to_cohomology_iso_and_naturality
      (@hc_all) (@hr_all) hSite hFunc hCore hSliceIso hConst
  obtain ⟨_, _, hBaseComp, hBaseMor, hBaseSES, _⟩ := id hFunc
  obtain ⟨hTriIff, _, hConstNat, _⟩ := id hConst

  
  have huX_compat : ∀ {i j : ℐ} (θ : Quiver.Hom i j),
      CategoryTheory.CategoryStruct.comp (uX j) (vX θ) = uX i := by
    intro i j θ
    apply (hpb_lvl i).hom_ext
    · calc
        CategoryTheory.CategoryStruct.comp (CategoryTheory.CategoryStruct.comp (uX j) (vX θ)) (f_lvl i)
          = CategoryTheory.CategoryStruct.comp (uX j)
              (CategoryTheory.CategoryStruct.comp (vX θ) (f_lvl i)) :=
            CategoryTheory.Category.assoc _ _ _
        _ = CategoryTheory.CategoryStruct.comp (CategoryTheory.CategoryStruct.comp (uX j) (f_lvl j))
              (AlgebraicGeometry.Spec.map (D.map θ)) := by
            rw [hvX_f θ, ← CategoryTheory.Category.assoc]
        _ = CategoryTheory.CategoryStruct.comp f_infX
              (CategoryTheory.CategoryStruct.comp (u_i j)
                (AlgebraicGeometry.Spec.map (D.map θ))) := by
            rw [huX_f j, CategoryTheory.Category.assoc]
        _ = CategoryTheory.CategoryStruct.comp f_infX (u_i i) := by
