      have hi₀_mem' : y' ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X i₀) := hi₀_mem
      have hi₀_not_mem : (MvPolynomial.X i₀ : MvPolynomial (Fin (n + 1)) k) ∉ 𝔭 :=
        (AlgebraicGeometry.Proj.mem_basicOpen 𝒜 (MvPolynomial.X i₀) y').mp hi₀_mem'
      have hx₀ : x i₀ ≠ 0 :=
