      (weilEtaleSitePullback f).IsContinuous Z₂.smallEtaleTopology Z₁.smallEtaleTopology := @hc_all
  have : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      ((weilEtaleSitePullback f).sheafPushforwardContinuous AddCommGrpCat.{u}
        Z₂.smallEtaleTopology Z₁.smallEtaleTopology).IsRightAdjoint := @hr_all
  have hTerm : ∀ (Z : AlgebraicGeometry.Scheme.{u}),
      CategoryTheory.Limits.IsTerminal (weilAffColim0TermEtale Z) := fun Z =>
    @CategoryTheory.Limits.IsTerminal.ofUniqueHom Z.Etale _ (weilAffColim0TermEtale Z)
      (fun V => CategoryTheory.MorphismProperty.Over.homMk V.hom (CategoryTheory.Category.comp_id V.hom))
      (fun V m => CategoryTheory.MorphismProperty.Over.Hom.ext
        ((CategoryTheory.Category.comp_id m.left).symm.trans (CategoryTheory.MorphismProperty.Over.w m)))
