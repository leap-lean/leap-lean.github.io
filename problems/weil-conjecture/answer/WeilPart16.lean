    WeilFreeYonedaPullbackAndPushoutHolds.{u} (@hc_all) (@hr_all) hSite :=
by
  have : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
