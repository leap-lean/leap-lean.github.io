        [_hr : ((weilEtaleSitePullback π).sheafPushforwardContinuous AddCommGrpCat.{u}
          X.smallEtaleTopology X_tilde.smallEtaleTopology).IsRightAdjoint]
        (G : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}),
        CategoryTheory.Mono
          (((weilEtaleSitePullback π).sheafAdjunctionContinuous AddCommGrpCat.{u}
            X.smallEtaleTopology X_tilde.smallEtaleTopology).unit.app G) :=
    fun {_ _} π hπ {_ _} G =>
