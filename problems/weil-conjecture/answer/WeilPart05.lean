    let ψ_spec : AlgebraicGeometry.Spec (X.presheaf.obj (Opposite.op V₀)) ≅
        AlgebraicGeometry.Spec (W.presheaf.obj (Opposite.op W₀)) :=
      hV₀.isoSpec.symm ≪≫ CategoryTheory.asIso (f ∣_ W₀) ≪≫ hW₀.isoSpec
    let α_hom : W.presheaf.obj (Opposite.op W₀) ⟶ X.presheaf.obj (Opposite.op V₀) :=
      AlgebraicGeometry.Spec.preimage ψ_spec.hom
    let α_inv : X.presheaf.obj (Opposite.op V₀) ⟶ W.presheaf.obj (Opposite.op W₀) :=
      AlgebraicGeometry.Spec.preimage ψ_spec.inv
    have hα_id1 : α_inv ≫ α_hom = 𝟙 _ := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        AlgebraicGeometry.Spec.map_preimage, ψ_spec.hom_inv_id, AlgebraicGeometry.Spec.map_id]
    have hα_id2 : α_hom ≫ α_inv = 𝟙 _ := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        AlgebraicGeometry.Spec.map_preimage, ψ_spec.inv_hom_id, AlgebraicGeometry.Spec.map_id]
    let e_VW : ↑(X.presheaf.obj (Opposite.op V₀)) ≃+* ↑(W.presheaf.obj (Opposite.op W₀)) :=
      { toFun := α_inv.hom
        invFun := α_hom.hom
        left_inv := fun x => congrArg (fun g => g.hom x) hα_id1
        right_inv := fun y => congrArg (fun g => g.hom y) hα_id2
        map_mul' := map_mul α_inv.hom
