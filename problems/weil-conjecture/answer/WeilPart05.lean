    change j_VP.base (g'_M.base (π'_M.base z_new)) = P
    rw [hz_new_fst]
    have hg_max : g'_M.base z_new_M = m_R_pt := PrimeSpectrum.ext hz_new_M_max
    rw [hg_max]
    exact hj_max
  have hMod_subsing : ∀ Q : PrimeSpectrum ↥V,
      (Mod_q0 ∩ (g'_0 ≫ j_VP).base ⁻¹' {Q}).Subsingleton := by
    rintro Q z₁ ⟨hz₁_mod, hz₁_Q⟩ z₂ ⟨hz₂_mod, hz₂_Q⟩
    have hz₁_range : π'_M.base z₁ ∈ Set.range σ_Mod.base := by rw [hσ_range]; exact hz₁_mod
    have hz₂_range : π'_M.base z₂ ∈ Set.range σ_Mod.base := by rw [hσ_range]; exact hz₂_mod
    obtain ⟨t₁, ht₁⟩ := hz₁_range
    obtain ⟨t₂, ht₂⟩ := hz₂_range
    have hj1 : j_VP.base ((σ_Mod ≫ g'_M).base t₁) = Q := by
      change j_VP.base (g'_M.base (σ_Mod.base t₁)) = Q
      rw [ht₁]
      change (π'_M ≫ g'_M ≫ j_VP).base z₁ = Q
      rw [← CategoryTheory.Category.assoc, ← hg'_0_eq]
      exact hz₁_Q
    have hj2 : j_VP.base ((σ_Mod ≫ g'_M).base t₂) = Q := by
      change j_VP.base (g'_M.base (σ_Mod.base t₂)) = Q
      rw [ht₂]
      change (π'_M ≫ g'_M ≫ j_VP).base z₂ = Q
      rw [← CategoryTheory.Category.assoc, ← hg'_0_eq]
      exact hz₂_Q
    have ht_eq : t₁ = t₂ := hσg_inj (hj_inj (hj1.trans hj2.symm))
    subst ht_eq
    exact (hUnique_t t₁).unique ht₁.symm ht₂.symm
  have hMod_P : Mod_q0 ∩ (g'_0 ≫ j_VP).base ⁻¹' {P} = {z_new} := by
    ext z
    simp only [Set.mem_inter_iff, Set.mem_preimage, Set.mem_singleton_iff]
    refine ⟨fun hz => hMod_subsing P hz ⟨hz_new_mem, hz_new_P⟩, ?_⟩
    rintro rfl
    exact ⟨hz_new_mem, hz_new_P⟩
  have hq0_znew_eq_ZX0 : q_0.base ⁻¹' {z_new} = Z_X0 := by
    have hqpb_znew : q_pb.base ⁻¹' {z_new} = π_tilde.base ⁻¹' E_Z_M := by
      ext w
      simp only [Set.mem_preimage, Set.mem_singleton_iff]
      rw [← hEZ_M]
      simp only [Set.mem_preimage, Set.mem_singleton_iff]
      have hcomm_w : π'_M.base (q_pb.base w) = q_M.base (π_tilde.base w) := by
        change (q_pb ≫ π'_M).base w = (π_tilde ≫ q_M).base w
        rw [hqpb_fst]
      constructor
      · intro hw
        rw [← hcomm_w, hw, hz_new_fst]
      · intro hw
        exact hz_new_uniq (q_pb.base w) (hcomm_w.trans hw)
    have hΦ_inj : Function.Injective Φ.hom.base :=
      (ConcreteCategory.bijective_of_isIso Φ.hom.base).1
    change Φ.hom.base ⁻¹' (q_pb.base ⁻¹' {z_new}) = Z_X0
    rw [hqpb_znew, ← hΦ_ZX0]
    exact Set.preimage_image_eq Z_X0 hΦ_inj
  have hFexc_P : F_exc ∩ (f_0 ≫ g_WB ≫ j_VP).base ⁻¹' {P} = Z_X0 := by
    have hf0_comp : f_0 ≫ g_WB ≫ j_VP = q_0 ≫ (g'_0 ≫ j_VP) := by
      rw [← hq0_f0]
      simp only [g'_0, CategoryTheory.Category.assoc]
    change q_0.base ⁻¹' Mod_q0 ∩ (f_0 ≫ g_WB ≫ j_VP).base ⁻¹' {P} = Z_X0
    rw [hf0_comp]
    change q_0.base ⁻¹' Mod_q0 ∩ q_0.base ⁻¹' ((g'_0 ≫ j_VP).base ⁻¹' {P}) = Z_X0
    rw [← Set.preimage_inter, hMod_P]
    exact hq0_znew_eq_ZX0

  
  have hGen_z0 : ∃ (Q₀ : PrimeSpectrum ↥V) (z₀ : ↥X'_0),
      Q₀.asIdeal ≠ ⊥ ∧
      Q₀.asIdeal ≤ P.asIdeal ∧
      z₀ ∈ Mod_q0 ∧
      (g'_0 ≫ j_VP).base z₀ = Q₀ ∧
      IsIrreducible (q_0.base ⁻¹' {z₀}) ∧
      F_exc = closure (q_0.base ⁻¹' {z₀}) := by
    let Q₀ : PrimeSpectrum ↥V := j_VP.base Q₀_R
    have hz₀_in_range : z₀_M ∈ Set.range σ_Mod.base := by
      rw [hσ_range]; exact hz₀_M_mem
    obtain ⟨t₀, ht₀⟩ := hz₀_in_range
    obtain ⟨z₀, hz₀_fst, hz₀_uniq⟩ := hUnique_t t₀
    rw [ht₀] at hz₀_fst hz₀_uniq
    have hz₀_mem : z₀ ∈ Mod_q0 := by
      change π'_M.base z₀ ∈ Mod_qM
      rw [hz₀_fst]
      exact hz₀_M_mem
    have hz₀_Q0 : (g'_0 ≫ j_VP).base z₀ = Q₀ := by
      rw [hg'_0_eq]
      change j_VP.base (g'_M.base (π'_M.base z₀)) = Q₀
      rw [hz₀_fst, hz₀_M_Q0]
    have hqpb_z0 : q_pb.base ⁻¹' {z₀} = π_tilde.base ⁻¹' (q_M.base ⁻¹' {z₀_M}) := by
      ext w
      simp only [Set.mem_preimage, Set.mem_singleton_iff]
      have hcomm_w : π'_M.base (q_pb.base w) = q_M.base (π_tilde.base w) := by
        change (q_pb ≫ π'_M).base w = (π_tilde ≫ q_M).base w
        rw [hqpb_fst]
      constructor
      · intro hw
        rw [← hcomm_w, hw, hz₀_fst]
      · intro hw
        exact hz₀_uniq (q_pb.base w) (hcomm_w.trans hw)
    have hqpb_Mod : q_pb.base ⁻¹' Mod_q0 = π_tilde.base ⁻¹' (q_M.base ⁻¹' Mod_qM) := by
      ext w
      change π'_M.base (q_pb.base w) ∈ Mod_qM ↔ q_M.base (π_tilde.base w) ∈ Mod_qM
      have hcomm_w : π'_M.base (q_pb.base w) = q_M.base (π_tilde.base w) := by
        change (q_pb ≫ π'_M).base w = (π_tilde ≫ q_M).base w
        rw [hqpb_fst]
      rw [hcomm_w]
    obtain ⟨⟨y₀_WB, _, he0_y0M⟩, hAlg_y0M⟩ := hBaseT t₀
    have hBij_z0M : ∀ x ∈ q_M.base ⁻¹' {z₀_M}, ∃! w : ↥X_tilde, π_tilde.base w = x := by
      intro x hx
      have hx_f : (q_M ≫ f'_M).base x = f'_M.base (σ_Mod.base t₀) := by
        change f'_M.base (q_M.base x) = _
        rw [Set.mem_preimage, Set.mem_singleton_iff] at hx
        rw [hx, ht₀]
      exact (hSingPb M_0 W_B.toScheme e_0 (f'_M.base (σ_Mod.base t₀)) y₀_WB
        he0_y0M hAlg_y0M M_tilde (q_M ≫ f'_M) x hx_f).1
    have _ : AlgebraicGeometry.Etale π_tilde := inferInstance
    have _ : AlgebraicGeometry.UniversallyOpen π_tilde :=
      AlgebraicGeometry.UniversallyOpen.of_flat π_tilde
    have hIrred_qpb : IsIrreducible (q_pb.base ⁻¹' {z₀}) := by
      rw [hqpb_z0]
      refine ⟨?_, ?_⟩
      · obtain ⟨x₀, hx₀⟩ := hIrred_z0M.nonempty
        obtain ⟨w₀, hw₀, _⟩ := hBij_z0M x₀ hx₀
        exact ⟨w₀, by rw [Set.mem_preimage, hw₀]; exact hx₀⟩
      · intro U₁ U₂ hU₁ hU₂ ⟨w₁, hw₁S, hw₁U⟩ ⟨w₂, hw₂S, hw₂U⟩
        obtain ⟨x, hxS, ⟨a₁, ha₁U, ha₁x⟩, ⟨a₂, ha₂U, ha₂x⟩⟩ :=
          hIrred_z0M.isPreirreducible (π_tilde.base '' U₁) (π_tilde.base '' U₂)
            (π_tilde.isOpenMap U₁ hU₁) (π_tilde.isOpenMap U₂ hU₂)
            ⟨π_tilde.base w₁, hw₁S, ⟨w₁, hw₁U, rfl⟩⟩
            ⟨π_tilde.base w₂, hw₂S, ⟨w₂, hw₂U, rfl⟩⟩
        have ha_eq : a₁ = a₂ := (hBij_z0M x hxS).unique ha₁x ha₂x
        subst ha_eq
        exact ⟨a₁, by rw [Set.mem_preimage, ha₁x]; exact hxS, ha₁U, ha₂U⟩
    have hCl_qpb : q_pb.base ⁻¹' Mod_q0 = closure (q_pb.base ⁻¹' {z₀}) := by
      rw [hqpb_Mod, hClosure_z0M,
        IsOpenMap.preimage_closure_eq_closure_preimage π_tilde.isOpenMap π_tilde.continuous,
        hqpb_z0]
    let e_Φ : ↥X_0.toScheme ≃ₜ ↥X_tilde :=
      TopCat.homeoOfIso (AlgebraicGeometry.Scheme.forgetToTop.mapIso Φ)
    have hq0_pre_eq : q_0.base ⁻¹' {z₀} = e_Φ ⁻¹' (q_pb.base ⁻¹' {z₀}) := rfl
    have hIrred_q0 : IsIrreducible (q_0.base ⁻¹' {z₀}) := by
      have himg : e_Φ ⁻¹' (q_pb.base ⁻¹' {z₀}) = e_Φ.symm '' (q_pb.base ⁻¹' {z₀}) := by
        ext v
        exact ⟨fun hv => ⟨e_Φ v, hv, e_Φ.symm_apply_apply v⟩,
          fun ⟨x, hx, hxv⟩ => by rw [← hxv]; simpa using hx⟩
      rw [hq0_pre_eq, himg]
      exact hIrred_qpb.image e_Φ.symm e_Φ.symm.continuous.continuousOn
    have hFexc_cl : F_exc = closure (q_0.base ⁻¹' {z₀}) := by
      change e_Φ ⁻¹' (q_pb.base ⁻¹' Mod_q0) = closure (q_0.base ⁻¹' {z₀})
      rw [hCl_qpb, e_Φ.preimage_closure]
      rfl
    exact ⟨Q₀, z₀, hj_neBot Q₀_R hQ₀_neBot, hj_le_P Q₀_R, hz₀_mem, hz₀_Q0, hIrred_q0, hFexc_cl⟩

  
  have hSpec_ZX0 : ∀ y ∈ F_exc, ∃ z ∈ Z_X0, z ∈ closure ({y} : Set _) := by
    have _ : AlgebraicGeometry.IsProper f'_M := hProp_f'M
    have _ : AlgebraicGeometry.IsProper f'_0 := inferInstance
    have _ : AlgebraicGeometry.IsProper q_pb :=
      CategoryTheory.MorphismProperty.of_isPullback hPb hProp_qM
    have _ : AlgebraicGeometry.IsProper q_0 := by
      dsimp [q_0]
      infer_instance
    have hMod_q0_cl : IsClosed Mod_q0 := hMod_qM_cl.preimage π'_M.continuous
    intro y hy
    let z_y : ↥X'_0 := q_0.base y
    have hzy_mod : z_y ∈ Mod_q0 := hy
    have hfzy_Zmod : f'_0.base z_y ∈ Z_mod := hMod_sub ⟨z_y, hzy_mod, rfl⟩
    have hu0_cl : u₀_WB ∈ closure ({f'_0.base z_y} : Set ↥W_B.toScheme) :=
      hZ_sp (f'_0.base z_y) hfzy_Zmod
    have hu0_img : u₀_WB ∈ f'_0.base '' closure ({z_y} : Set ↥X'_0) := by
      refine closure_minimal ?_ (f'_0.isClosedMap _ isClosed_closure) hu0_cl
      rw [Set.singleton_subset_iff]
      exact ⟨z_y, subset_closure (Set.mem_singleton z_y), rfl⟩
    obtain ⟨z₁, hz₁_cl, hz₁_f⟩ := hu0_img
    have hz₁_mod : z₁ ∈ Mod_q0 :=
      closure_minimal (Set.singleton_subset_iff.mpr hzy_mod) hMod_q0_cl hz₁_cl
    have hz₁_P : (g'_0 ≫ j_VP).base z₁ = P := by
      change j_VP.base (g_WB.base (f'_0.base z₁)) = P
      rw [hz₁_f, ← he0_comm]
      change j_VP.base (g_M0.base (e_0.base u₀_WB)) = P
      rw [he0_u0]
      have hm0_pt : g_M0.base m_0 = m_R_pt := PrimeSpectrum.ext hm0_max
      rw [hm0_pt]
      exact hj_max
    have hz₁_eq : z₁ = z_new := by
      have hm : z₁ ∈ ({z_new} : Set ↥X'_0) := hMod_P ▸ ⟨hz₁_mod, hz₁_P⟩
      exact Set.mem_singleton_iff.mp hm
    rw [hz₁_eq] at hz₁_cl
    have hznew_img : z_new ∈ q_0.base '' closure ({y} : Set _) := by
      refine closure_minimal ?_ (q_0.isClosedMap _ isClosed_closure) hz₁_cl
      rw [Set.singleton_subset_iff]
      exact ⟨y, subset_closure (Set.mem_singleton y), rfl⟩
    obtain ⟨z, hz_cl, hz_q0⟩ := hznew_img
    have hz_ZX0 : z ∈ Z_X0 := by
      rw [← hq0_znew_eq_ZX0]
      exact hz_q0
    exact ⟨z, hz_ZX0, hz_cl⟩

  exact ⟨z_new, hMod_sub, hz_new_mem, hz_new_P, hFexc_P, hMod_P, hMod_subsing, hGen_z0, hSpec_ZX0⟩

theorem weil_etale_baseChange_chart_contraction_transfer (K : Type u) [Field K] [IsSepClosed K]
    (m : ℕ) (V : ValuationSubring K) (hPkg : IsValuationRingAlgPackage m V)
    (P : PrimeSpectrum ↥V) (hP : P.asIdeal ≠ ⊥)
    (hPkg_VP : IsValuationRingAlgPackage m (V.ofPrime P.asIdeal))
    (hMax_VP : IsLocalRing.maximalIdeal ↥(V.ofPrime P.asIdeal) ≠ ⊥)
    (U_ss C_cur : AlgebraicGeometry.Scheme.{u})
    (g_ss : U_ss ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (hSS : IsStrictlySemistableCurveOverValuation V g_ss)
    (g_cur : C_cur ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (hSS_cur : IsStrictlySemistableCurveOverValuation V g_cur)
    (f_ss_cur : C_cur ⟶ U_ss)
    (hProp_fss : AlgebraicGeometry.IsProper f_ss_cur)
    (hComm_fss : f_ss_cur ≫ g_ss = g_cur)
    (u₀ : ↥U_ss)
    (ϖ : ↥V) (W_B : U_ss.Opens) (hu₀ : u₀ ∈ W_B)
    (g_WB : W_B.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥(V.ofPrime P.asIdeal)))
    (Z_mod : Set ↥W_B.toScheme) (hZ_closed : IsClosed Z_mod)
    (hChart : IsIsolatedStrictlySemistableModChart V g_ss f_ss_cur P u₀ ϖ W_B hu₀ g_WB
      Z_mod hZ_closed)
    (a_opt : Option ↥(V.ofPrime P.asIdeal))
    (M_0 : AlgebraicGeometry.Scheme.{u})
    (g_M0 : M_0 ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥(V.ofPrime P.asIdeal)))
    (m_0 : ↥M_0)
    (e_0 : W_B.toScheme ⟶ M_0)
    (F_0 F_WB : Type u) [Field F_0] [Field F_WB]
    (η_M0 : AlgebraicGeometry.Spec (CommRingCat.of F_0) ⟶ M_0)
    (η_WB : AlgebraicGeometry.Spec (CommRingCat.of F_WB) ⟶ W_B.toScheme)
    (φ_KF0 : K →+* F_0)
    (φ_F0_FWB : F_0 →+* F_WB)
    (T_0 : F_0)
    (hStd : IsStandardModelCoordDatum (V.ofPrime P.asIdeal) a_opt M_0 g_M0 m_0 η_M0 φ_KF0 T_0)
    (hFunc_WB : IsSchemeFunctionField W_B.toScheme F_WB η_WB)
    (hEt_e0 : AlgebraicGeometry.Etale e_0)
    (he0_comm : e_0 ≫ g_M0 = g_WB)
    (hη_e0 : η_WB ≫ e_0 = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_F0_FWB) ≫ η_M0)
    (he0_m0 : e_0.base ⁻¹' {m_0} = {(⟨u₀, hu₀⟩ : ↥W_B.toScheme)})
    (he0_Zmod : ∀ y ∈ Z_mod, e_0.base ⁻¹' {e_0.base y} = {y}) :
    (∀ (N : ℕ) (c π : Fin N → ↥(V.ofPrime P.asIdeal))
       (M_T : AlgebraicGeometry.Scheme.{u})
       (g_MT : M_T ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥(V.ofPrime P.asIdeal)))
       (f_MT : M_T ⟶ M_0)
       (η_MT : AlgebraicGeometry.Spec (CommRingCat.of F_0) ⟶ M_T)
       (Z_MT : Set ↥M_0)
       (B_comp : Fin N → Set ↥(CategoryTheory.Limits.pullback g_MT
         (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
           (algebraMap ↥(V.ofPrime P.asIdeal)
             (IsLocalRing.maximalIdeal ↥(V.ofPrime P.asIdeal)).ResidueField))))),
      IsBaseDiscTreeModel (V.ofPrime P.asIdeal) a_opt g_M0 m_0 η_M0 φ_KF0 T_0 c π
        M_T g_MT f_MT η_MT Z_MT B_comp →
      ∃ (η_XT : AlgebraicGeometry.Spec (CommRingCat.of F_WB) ⟶
          CategoryTheory.Limits.pullback f_MT e_0)
        (E_XT : Fin N → Set ↥(CategoryTheory.Limits.pullback
          (CategoryTheory.Limits.pullback.snd f_MT e_0 ≫ g_WB)
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (algebraMap ↥(V.ofPrime P.asIdeal)
              (IsLocalRing.maximalIdeal ↥(V.ofPrime P.asIdeal)).ResidueField)))))
        (p_nb : Fin N → Fin N → ↥(CategoryTheory.Limits.pullback
          (CategoryTheory.Limits.pullback.snd f_MT e_0 ≫ g_WB)
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (algebraMap ↥(V.ofPrime P.asIdeal)
              (IsLocalRing.maximalIdeal ↥(V.ofPrime P.asIdeal)).ResidueField)))))
        (H_nb : Fin N → Fin N → Set ↥(CategoryTheory.Limits.pullback
          (CategoryTheory.Limits.pullback.snd f_MT e_0 ≫ g_WB)
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (algebraMap ↥(V.ofPrime P.asIdeal)
              (IsLocalRing.maximalIdeal ↥(V.ofPrime P.asIdeal)).ResidueField))))),
        IsStrictlySemistableCurveOverValuation (V.ofPrime P.asIdeal)
          (CategoryTheory.Limits.pullback.snd f_MT e_0 ≫ g_WB) ∧
        AlgebraicGeometry.IsProper (CategoryTheory.Limits.pullback.snd f_MT e_0) ∧
        IsSchemeFunctionField (CategoryTheory.Limits.pullback f_MT e_0) F_WB η_XT ∧
        η_XT ≫ CategoryTheory.Limits.pullback.snd f_MT e_0 = η_WB ∧
        (∃ U_XT : W_B.toScheme.Opens, Nonempty ↥U_XT ∧
          CategoryTheory.IsIso ((CategoryTheory.Limits.pullback.snd f_MT e_0) ∣_ U_XT)) ∧
        (e_0.base ⁻¹' Z_MT ⊆ Z_mod →
          CategoryTheory.IsIso ((CategoryTheory.Limits.pullback.snd f_MT e_0) ∣_
            (⟨Z_modᶜ, hZ_closed.isOpen_compl⟩ : W_B.toScheme.Opens))) ∧
        (∀ i : Fin N, ¬ IsDiscBoundaryIdx ↥(V.ofPrime P.asIdeal) a_opt (c i) (π i) →
          E_XT i ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback
            (CategoryTheory.Limits.pullback.snd f_MT e_0 ≫ g_WB)
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (algebraMap ↥(V.ofPrime P.asIdeal)
                (IsLocalRing.maximalIdeal ↥(V.ofPrime P.asIdeal)).ResidueField)))) ∧
          (CategoryTheory.Limits.pullback.fst
            (CategoryTheory.Limits.pullback.snd f_MT e_0 ≫ g_WB)
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (algebraMap ↥(V.ofPrime P.asIdeal)
                (IsLocalRing.maximalIdeal ↥(V.ofPrime P.asIdeal)).ResidueField)))).base '' (E_XT i) =
            (CategoryTheory.Limits.pullback.fst f_MT e_0).base ⁻¹'
              ((CategoryTheory.Limits.pullback.fst g_MT
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                  (algebraMap ↥(V.ofPrime P.asIdeal)
                    (IsLocalRing.maximalIdeal ↥(V.ofPrime P.asIdeal)).ResidueField)))).base '' (B_comp i)) ∧
          (∀ q ∈ E_XT i,
            (CategoryTheory.Limits.pullback.snd f_MT e_0).base
              ((CategoryTheory.Limits.pullback.fst
                (CategoryTheory.Limits.pullback.snd f_MT e_0 ≫ g_WB)
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                  (algebraMap ↥(V.ofPrime P.asIdeal)
                    (IsLocalRing.maximalIdeal ↥(V.ofPrime P.asIdeal)).ResidueField)))).base q) =
              (⟨u₀, hu₀⟩ : ↥W_B.toScheme)) ∧
          ∃ W_i : ValuationSubring F_WB,
            IsComponentStalkVal (V.ofPrime P.asIdeal)
              (CategoryTheory.Limits.pullback.snd f_MT e_0 ≫ g_WB) η_XT (E_XT i) W_i ∧
            IsDiscValuationOnWB (V.ofPrime P.asIdeal) (⟨u₀, hu₀⟩ : ↥W_B.toScheme) η_WB
              (φ_F0_FWB.comp φ_KF0) (φ_F0_FWB T_0) (c i) (π i) W_i) ∧
        (∀ E ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback
            (CategoryTheory.Limits.pullback.snd f_MT e_0 ≫ g_WB)
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (algebraMap ↥(V.ofPrime P.asIdeal)
                (IsLocalRing.maximalIdeal ↥(V.ofPrime P.asIdeal)).ResidueField)))),
          (∀ q ∈ E,
            (CategoryTheory.Limits.pullback.snd f_MT e_0).base
              ((CategoryTheory.Limits.pullback.fst
                (CategoryTheory.Limits.pullback.snd f_MT e_0 ≫ g_WB)
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                  (algebraMap ↥(V.ofPrime P.asIdeal)
                    (IsLocalRing.maximalIdeal ↥(V.ofPrime P.asIdeal)).ResidueField)))).base q) =
              (⟨u₀, hu₀⟩ : ↥W_B.toScheme)) →
          ∃ i : Fin N, ¬ IsDiscBoundaryIdx ↥(V.ofPrime P.asIdeal) a_opt (c i) (π i) ∧ E = E_XT i) ∧
