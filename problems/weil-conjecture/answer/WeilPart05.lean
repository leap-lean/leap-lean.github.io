          rw [Ideal.comap_comap, hComm_θ]; exact hq_η_Q₀
        have hp_z₀_mR : Ideal.comap Polynomial.C p_z₀ = m_R := by
          rw [Ideal.comap_comap, hComm_θ]; exact hq_z₀_mR
        have hp_η_min : ∀ p₀ : Ideal (Polynomial ↥R),
            p₀.IsPrime → Ideal.comap Polynomial.C p₀ = Q₀ → p₀ ≤ p_η → p₀ = p_η :=
          fun p₀ hp₀_pr hp₀_cm hp₀_le =>
            hChartMin_of_min U hU η_Q hη_U hMin_η Polynomial.C θ hEt_θ hComm_θ
              p₀ hp₀_pr hp₀_cm hp₀_le
        obtain ⟨hDom_sm, hIC_sm, p_m, hp_m_pr, u_coord, hp_lo, hp_hi, hp_m_mR, hu_tr⟩ :=
          hMod_sm p_η p_z₀ hp_le hp_η_Q₀ hp_z₀_mR hp_η_min
        have _ : p_m.IsPrime := hp_m_pr
        obtain ⟨q₁, hq₁_pr, hq₁_lo, hq₁_hi, hq₁_θ⟩ :=
          weil_etale_normal_quotient_goingDown_prime_lift
            (Polynomial ↥R) ↑(Y.presheaf.obj (Opposite.op U))
            θ hEt_θ q_η.asIdeal q_z₀.asIdeal hq_le hDom_sm hIC_sm p_m hp_lo hp_hi
        refine ⟨q₁, hq₁_pr, θ u_coord, hq₁_lo, hq₁_hi, ?_, ?_⟩
        · dsimp only [γ_B]; rw [← hComm_θ, ← Ideal.comap_comap, hq₁_θ, hp_m_mR]
        · intro g hg hmem
          apply hu_tr g hg
          rw [← hq₁_θ, Ideal.mem_comap, Polynomial.hom_eval₂, hComm_θ]
          exact hmem
      · let γ_nod : ↥R →+* (MvPolynomial (Fin 2) ↥R ⧸
            Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}) :=
          (Ideal.Quotient.mk _).comp MvPolynomial.C
        let p_η : Ideal (MvPolynomial (Fin 2) ↥R ⧸
            Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}) :=
          Ideal.comap θ q_η.asIdeal
        let p_z₀ : Ideal (MvPolynomial (Fin 2) ↥R ⧸
            Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}) :=
          Ideal.comap θ q_z₀.asIdeal
        have _ : p_η.IsPrime := Ideal.IsPrime.comap θ
        have _ : p_z₀.IsPrime := Ideal.IsPrime.comap θ
        have hp_le : p_η ≤ p_z₀ := Ideal.comap_mono hq_le
        have hp_η_Q₀ : Ideal.comap γ_nod p_η = Q₀ := by
          rw [Ideal.comap_comap, hComm_θ]; exact hq_η_Q₀
        have hp_z₀_mR : Ideal.comap γ_nod p_z₀ = m_R := by
          rw [Ideal.comap_comap, hComm_θ]; exact hq_z₀_mR
        have hp_η_min : ∀ p₀ : Ideal (MvPolynomial (Fin 2) ↥R ⧸
            Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}),
            p₀.IsPrime → Ideal.comap γ_nod p₀ = Q₀ → p₀ ≤ p_η → p₀ = p_η :=
          fun p₀ hp₀_pr hp₀_cm hp₀_le =>
            hChartMin_of_min U hU η_Q hη_U hMin_η γ_nod θ hEt_θ hComm_θ
              p₀ hp₀_pr hp₀_cm hp₀_le
        obtain ⟨hDom_nod, hIC_nod, p_m, hp_m_pr, u_coord, hp_lo, hp_hi, hp_m_mR, hu_tr⟩ :=
          hMod_nod a ha_ne p_η p_z₀ hp_le hp_η_Q₀ hp_z₀_mR hp_η_min
        have _ : p_m.IsPrime := hp_m_pr
        obtain ⟨q₁, hq₁_pr, hq₁_lo, hq₁_hi, hq₁_θ⟩ :=
          weil_etale_normal_quotient_goingDown_prime_lift
            (MvPolynomial (Fin 2) ↥R ⧸
              Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a})
            ↑(Y.presheaf.obj (Opposite.op U))
            θ hEt_θ q_η.asIdeal q_z₀.asIdeal hq_le hDom_nod hIC_nod p_m hp_lo hp_hi
        refine ⟨q₁, hq₁_pr, θ u_coord, hq₁_lo, hq₁_hi, ?_, ?_⟩
        · dsimp only [γ_B]; rw [← hComm_θ, ← Ideal.comap_comap, hq₁_θ, hp_m_mR]
        · intro g hg hmem
          apply hu_tr g hg
          rw [← hq₁_θ, Ideal.mem_comap, Polynomial.hom_eval₂, hComm_θ]
          exact hmem

    obtain ⟨q₁_id, hq₁_pr, t_B, hq₁_lo, _hq₁_hi, hq₁_mR, ht_B⟩ := hex_q₁
    let p₁ : PrimeSpectrum ↑(Y.presheaf.obj (Opposite.op U)) := ⟨q₁_id, hq₁_pr⟩
    let P_m : PrimeSpectrum ↥R := ⟨m_R, inferInstance⟩
    obtain ⟨_, hAlg_dichot⟩ := hDichot_of_chart U hU P_m hCh
    have hp₁_Pm : PrimeSpectrum.comap (algebraMap ↥R ↑(Y.presheaf.obj (Opposite.op U))) p₁ = P_m :=
      PrimeSpectrum.ext hq₁_mR
    let e_fib_m := PrimeSpectrum.preimageHomeomorphFiber ↥R ↑(Y.presheaf.obj (Opposite.op U)) P_m
    have hp₁_fib_min :
        (e_fib_m ⟨p₁, hp₁_Pm⟩).asIdeal ∈
          minimalPrimes (P_m.asIdeal.Fiber ↑(Y.presheaf.obj (Opposite.op U))) := by
      by_contra hNotMin
      have hAlg_tB :=
        hAlg_dichot p₁ hp₁_Pm hNotMin (algebraMap _ p₁.asIdeal.ResidueField t_B)
      let φ_res : P_m.asIdeal.ResidueField →+* p₁.asIdeal.ResidueField :=
        Ideal.ResidueField.map P_m.asIdeal p₁.asIdeal
          (algebraMap ↥R ↑(Y.presheaf.obj (Opposite.op U)))
          (congrArg PrimeSpectrum.asIdeal hp₁_Pm.symm)
      obtain ⟨G_bar, hG_ne, hG_aeval⟩ := hAlg_tB
      have hex_coeff : ∃ i : ℕ, G_bar.coeff i ≠ 0 := by
        by_contra h_all
        push Not at h_all
        exact hG_ne (Polynomial.ext fun i => h_all i)
      obtain ⟨i₀, hi₀_ne⟩ := hex_coeff
      obtain ⟨g, hg_map⟩ := Polynomial.map_surjective (algebraMap ↥R k_R) hSurj_res G_bar
      have hgi₀_not : g.coeff i₀ ∉ m_R := by
        intro hmem
        apply hi₀_ne
        rw [← hg_map, Polynomial.coeff_map]
        exact RingHom.mem_ker.mp ((Ideal.ker_algebraMap_residueField m_R).symm ▸ hmem)
      have hg_eval_in : Polynomial.eval₂ γ_B t_B g ∈ q₁_id := by
        have hker : RingHom.ker
            (algebraMap ↑(Y.presheaf.obj (Opposite.op U)) p₁.asIdeal.ResidueField) = p₁.asIdeal :=
          Ideal.ker_algebraMap_residueField p₁.asIdeal
        change Polynomial.eval₂ γ_B t_B g ∈ p₁.asIdeal
        rw [← hker, RingHom.mem_ker, Polynomial.hom_eval₂]
        have hcomp_eq : (algebraMap ↑(Y.presheaf.obj (Opposite.op U))
              p₁.asIdeal.ResidueField).comp γ_B =
            φ_res.comp (algebraMap ↥R P_m.asIdeal.ResidueField) := by
          ext r
          exact (Ideal.ResidueField.map_algebraMap P_m.asIdeal p₁.asIdeal
            (algebraMap ↥R ↑(Y.presheaf.obj (Opposite.op U)))
            (congrArg PrimeSpectrum.asIdeal hp₁_Pm.symm) r).symm
        rw [hcomp_eq, ← Polynomial.eval₂_map, hg_map]
        exact hG_aeval
      exact ht_B g ⟨i₀, hgi₀_not⟩ hg_eval_in

    have hp₁_loc_min : ∀ p' : PrimeSpectrum ↑(Y.presheaf.obj (Opposite.op U)),
        Ideal.comap γ_B p'.asIdeal = m_R → p' ≤ p₁ → p' = p₁ := by
      intro p' hp'_mR hp'_le
      have hp'_Pm : PrimeSpectrum.comap
          (algebraMap ↥R ↑(Y.presheaf.obj (Opposite.op U))) p' = P_m :=
        PrimeSpectrum.ext hp'_mR
      let p'_sub : ↑(PrimeSpectrum.comap
          (algebraMap ↥R ↑(Y.presheaf.obj (Opposite.op U))) ⁻¹' {P_m}) := ⟨p', hp'_Pm⟩
      let p₁_sub : ↑(PrimeSpectrum.comap
          (algebraMap ↥R ↑(Y.presheaf.obj (Opposite.op U))) ⁻¹' {P_m}) := ⟨p₁, hp₁_Pm⟩
      have hp₁_cl_sub : p₁_sub ∈ closure ({p'_sub} : Set _) := by
        rw [mem_closure_iff]
        intro W hW hp₁W
        rw [isOpen_induced_iff] at hW
        obtain ⟨V, hV_open, rfl⟩ := hW
        have hp₁_cl_B : p₁ ∈
            closure ({p'} : Set (PrimeSpectrum ↑(Y.presheaf.obj (Opposite.op U)))) :=
          (PrimeSpectrum.le_iff_mem_closure p' p₁).mp hp'_le
        obtain ⟨u, huV, hu_eq⟩ := mem_closure_iff.mp hp₁_cl_B V hV_open hp₁W
        rw [Set.mem_singleton_iff] at hu_eq
        have hp'V : p' ∈ V := hu_eq ▸ huV
        exact ⟨p'_sub, hp'V, Set.mem_singleton p'_sub⟩
      have hq₁_cl_fib : e_fib_m p₁_sub ∈ closure ({e_fib_m p'_sub} : Set _) := by
        have hsub := image_closure_subset_closure_image e_fib_m.continuous
          (s := ({p'_sub} : Set _))
        rw [Set.image_singleton] at hsub
        exact hsub ⟨p₁_sub, hp₁_cl_sub, rfl⟩
      have hfib_le : (e_fib_m p'_sub).asIdeal ≤ (e_fib_m p₁_sub).asIdeal :=
        (PrimeSpectrum.le_iff_mem_closure (e_fib_m p'_sub) (e_fib_m p₁_sub)).mpr hq₁_cl_fib
      have hfib_ge : (e_fib_m p₁_sub).asIdeal ≤ (e_fib_m p'_sub).asIdeal :=
        hp₁_fib_min.2 ⟨(e_fib_m p'_sub).isPrime, bot_le⟩ hfib_le
      have hfib_eq : e_fib_m p'_sub = e_fib_m p₁_sub :=
        PrimeSpectrum.ext (le_antisymm hfib_le hfib_ge)
      exact congrArg Subtype.val (e_fib_m.injective hfib_eq)

    let z₁ : ↥Y := hU.fromSpec.base p₁
    have hz₁_cl : z₁ ∈ closure ({η_Q} : Set ↥Y) := by
      rw [← hq_η_pt]
      exact hFromSpec_cl U hU p₁ q_η hq₁_lo
    have hz₁_max : (g_Y.base z₁).asIdeal = m_R := by
      rw [hPt_asIdeal U hU p₁]
      exact hq₁_mR
    obtain ⟨E₁, hE₁_irr, hE₁_img⟩ := hMkComp U hU p₁ hq₁_mR hp₁_loc_min
    exact ⟨z₁, E₁, hz₁_cl, hz₁_max, hE₁_irr, hE₁_img⟩

theorem weil_normal_curve_modification_domination_morphism (K : Type u) [Field K] [IsSepClosed K]
    (m : ℕ) (R : ValuationSubring K) (hPkg_R : IsValuationRingAlgPackage m R)
    (hMax_R : IsLocalRing.maximalIdeal ↥R ≠ ⊥)
    (W_B_sch : AlgebraicGeometry.Scheme.{u})
    (g_WB : W_B_sch ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
    (hAff_WB : AlgebraicGeometry.IsAffine W_B_sch)
    (hSS_WB : IsStrictlySemistableCurveOverValuation R g_WB)
    (u₀_WB : ↥W_B_sch)
    (hu₀_cl : IsClosed ({u₀_WB} : Set ↥W_B_sch))
    (hu₀_max : (g_WB.base u₀_WB).asIdeal = IsLocalRing.maximalIdeal ↥R)
    (Z_mod : Set ↥W_B_sch) (hZ_cl : IsClosed Z_mod) (hZ_fin : Z_mod.Finite)
    (hZ_neBot : ∀ y ∈ Z_mod, (g_WB.base y).asIdeal ≠ ⊥)
    (hZ_sp : ∀ y ∈ Z_mod, u₀_WB ∈ closure ({y} : Set ↥W_B_sch))
    (F_WB : Type u) [Field F_WB]
    (η_WB : AlgebraicGeometry.Spec (CommRingCat.of F_WB) ⟶ W_B_sch)
    (hFunc_WB : IsSchemeFunctionField W_B_sch F_WB η_WB)
    (Y₁ Y₂ : AlgebraicGeometry.Scheme.{u})
    (g₁ : Y₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
    (g₂ : Y₂ ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
    (f₁ : Y₁ ⟶ W_B_sch) (f₂ : Y₂ ⟶ W_B_sch)
    (η₁ : AlgebraicGeometry.Spec (CommRingCat.of F_WB) ⟶ Y₁)
    (η₂ : AlgebraicGeometry.Spec (CommRingCat.of F_WB) ⟶ Y₂) :
    let s_R := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.maximalIdeal ↥R).ResidueField))
    IsStrictlySemistableCurveOverValuation R g₁ →
    IsStrictlySemistableCurveOverValuation R g₂ →
    IsSchemeFunctionField Y₁ F_WB η₁ →
    IsSchemeFunctionField Y₂ F_WB η₂ →
    AlgebraicGeometry.IsProper f₁ →
    AlgebraicGeometry.IsProper f₂ →
    f₁ ≫ g_WB = g₁ →
    f₂ ≫ g_WB = g₂ →
    η₁ ≫ f₁ = η_WB →
    η₂ ≫ f₂ = η_WB →
    CategoryTheory.IsIso (f₁ ∣_ (⟨Z_modᶜ, hZ_cl.isOpen_compl⟩ : W_B_sch.Opens)) →
    (∃ U₂ : W_B_sch.Opens, Nonempty ↥U₂ ∧ CategoryTheory.IsIso (f₂ ∣_ U₂)) →
    (∀ E₁ ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g₁ s_R),
      (∀ q ∈ E₁, f₁.base ((CategoryTheory.Limits.pullback.fst g₁ s_R).base q) = u₀_WB) →
      ∀ W : ValuationSubring F_WB, IsComponentStalkVal R g₁ η₁ E₁ W →
        ∃ E₂ ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g₂ s_R),
          IsComponentStalkVal R g₂ η₂ E₂ W) →
    ∃ (α : Y₂ ⟶ Y₁),
      α ≫ g₁ = g₂ ∧
      α ≫ f₁ = f₂ ∧
      η₂ ≫ α = η₁ ∧
      AlgebraicGeometry.IsProper α ∧
      AlgebraicGeometry.Surjective α :=
by
  classical
  intro s_R hSS₁ hSS₂ hFunc₁ hFunc₂ hProp₁ hProp₂ hf₁_g hf₂_g hη₁_f hη₂_f hIso₁ _hU₂ hDom₁₂
  have hDom_specMap : ∀ {A : Type u} [CommRing A] {F : Type u} [Field F]
      (f : A →+* F), Function.Injective f →
      AlgebraicGeometry.IsDominant (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f)) := by
    intro A _ F _ f hf
    rw [AlgebraicGeometry.isDominant_iff, DenseRange]
    intro q
    let p₀ : PrimeSpectrum A :=
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f)).base (⊥ : PrimeSpectrum F)
    have hle : p₀ ≤ (q : PrimeSpectrum A) := by
      change Ideal.comap f (⊥ : PrimeSpectrum F).asIdeal ≤ (q : PrimeSpectrum A).asIdeal
      have hbot : (⊥ : PrimeSpectrum F).asIdeal = ⊥ := rfl
      rw [hbot, Ideal.comap_bot_of_injective f hf]
      exact bot_le
    have hcl : (q : PrimeSpectrum A) ∈ closure ({p₀} : Set (PrimeSpectrum A)) :=
      (PrimeSpectrum.le_iff_mem_closure p₀ q).mp hle
    have hmem : p₀ ∈ Set.range (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f)).base :=
      ⟨(⊥ : PrimeSpectrum F), rfl⟩
    exact closure_mono (Set.singleton_subset_iff.mpr hmem) hcl
  have hDom_funcField : ∀ (X : AlgebraicGeometry.Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral X)
      (η : AlgebraicGeometry.Spec (CommRingCat.of F_WB) ⟶ X),
      IsSchemeFunctionField X F_WB η → AlgebraicGeometry.IsDominant η := by
    intro X hIntX η hFunc
    rw [AlgebraicGeometry.isDominant_iff, denseRange_iff_closure_range]
    ext x
    simp only [Set.mem_univ, iff_true, mem_closure_iff]
    intro V hV hxV
    obtain ⟨U, hU_aff, hxU, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := ⊤) (x := x) trivial
    have hne : Nonempty ↥U := ⟨⟨x, hxU⟩⟩
    obtain ⟨φ, hFrac, hη_eq⟩ := hFunc U hU_aff hne
    have _ : IsDomain ↑(X.presheaf.obj (Opposite.op U)) :=
      @AlgebraicGeometry.IsIntegral.component_integral X hIntX U hne
    have hinj : Function.Injective φ.hom :=
      @IsFractionRing.injective ↑(X.presheaf.obj (Opposite.op U)) _ F_WB _ φ.hom.toAlgebra hFrac
    have hx_range : x ∈ Set.range hU_aff.fromSpec.base := by
      rwa [hU_aff.range_fromSpec]
    obtain ⟨p, hp_eq⟩ := hx_range
    have hDom_map : AlgebraicGeometry.IsDominant (AlgebraicGeometry.Spec.map φ) :=
      hDom_specMap φ.hom hinj
    have hp_cl : p ∈ closure (Set.range (AlgebraicGeometry.Spec.map φ).base) :=
      hDom_map.denseRange p
    rw [mem_closure_iff] at hp_cl
    have hp_open : IsOpen (hU_aff.fromSpec.base ⁻¹' V) :=
      hV.preimage hU_aff.fromSpec.continuous
    have hp_mem : p ∈ hU_aff.fromSpec.base ⁻¹' V := by
      show hU_aff.fromSpec.base p ∈ V
      rwa [hp_eq]
    obtain ⟨_, hqV, q₀, rfl⟩ := hp_cl _ hp_open hp_mem
    refine ⟨η.base q₀, ?_, ⟨q₀, rfl⟩⟩
    rw [← hη_eq]
    exact hqV
  obtain ⟨_, hNorm_all, _⟩ :=
    weil_strictlySemistable_isAffineNormal_and_funcField K m R hPkg_R
  have hNorm₂ : IsAffineNormalScheme Y₂ := hNorm_all Y₂ g₂ hSS₂
  let U_compl : W_B_sch.Opens := ⟨Z_modᶜ, hZ_cl.isOpen_compl⟩
  obtain ⟨Γ, π₁, π₂, η_Γ,
    ⟨hInt_Γ, hProp_π₁, hProp_π₂, hDom_ηΓ, hFunc_Γ, hπ_f, hη_π₁, hη_π₂⟩,
    hSub_compl, hSub_val, hInj_res⟩ :=
    weil_birational_modification_graph_closure_and_val_subsingleton
      W_B_sch Y₁ Y₂ F_WB f₁ f₂ η_WB η₁ η₂ U_compl
      hAff_WB hSS_WB.1 hSS₁.1 hSS₂.1 hProp₁ hProp₂
      hη₁_f hη₂_f hFunc_WB hFunc₁ hFunc₂ hIso₁
  have hπ_g : π₁ ≫ g₁ = π₂ ≫ g₂ := by
    rw [← hf₁_g, ← hf₂_g, ← CategoryTheory.Category.assoc, hπ_f, CategoryTheory.Category.assoc]
  obtain ⟨_, hInfMin₁, hSpec₁⟩ :=
    weil_strictlySemistable_higherRank_component_specialization K m R hPkg_R hMax_R Y₁ g₁ hSS₁
  obtain ⟨hNonSing₂, _, _⟩ :=
    weil_strictlySemistable_higherRank_component_specialization K m R hPkg_R hMax_R Y₂ g₂ hSS₂
  have hFin : ∀ w : ↥Y₂, (π₂.base ⁻¹' {w}).Finite := by
    intro w
    let y : ↥W_B_sch := f₂.base w
    let Q : PrimeSpectrum ↥R := g₂.base w
    have hy_Q : g_WB.base y = Q := by
      change (f₂ ≫ g_WB).base w = Q
      rw [hf₂_g]
    by_cases hy : y ∈ Z_mod
    · by_cases hMin : ∀ w' : ↥Y₂, g₂.base w' = g₂.base w → w ∈ closure ({w'} : Set ↥Y₂) → w' = w
      · exact (hSub_val w
          (weil_strictlySemistable_minimalFiberPrime_stalk_valuation
            K R Y₂ g₂ F_WB η₂ hSS₂ hNorm₂ hFunc₂ w hMin)).finite
      · by_contra hInf
        obtain ⟨hu₀_uniq, hSp_w⟩ :=
          weil_finite_modLocus_quotient_and_closedPoint_specialization
            K m R hPkg_R W_B_sch g_WB hAff_WB hSS_WB u₀_WB hu₀_max
            Z_mod hZ_cl hZ_fin hZ_neBot hZ_sp Y₂ g₂ f₂ hSS₂ hProp₂ hf₂_g y hy
        obtain ⟨hSurj_res, hw_Q_uniq, w₀, _hw₀_mem, hw₀_cl, _hw₀_max, hw₀_uniq⟩ :=
          hSp_w w rfl hMin
        let S_w : Set ↥Y₁ := π₁.base '' (π₂.base ⁻¹' ({w} : Set ↥Y₂))
        have hSw_inf : ¬ S_w.Finite :=
          fun hFinSw => hInf (Set.Finite.of_finite_image hFinSw (hInj_res w hSurj_res))
        let F_cl : Set ↥Y₁ := π₁.base '' (π₂.base ⁻¹' closure ({w} : Set ↥Y₂))
        have _ : AlgebraicGeometry.IsProper π₁ := hProp_π₁
        have hFcl_closed : IsClosed F_cl :=
          π₁.isClosedMap _ (isClosed_closure.preimage π₂.continuous)
        have hFcl_eq :
            F_cl ∩ g₁.base ⁻¹' ({Q} : Set ↥(AlgebraicGeometry.Spec (CommRingCat.of ↥R))) = S_w := by
          ext v
          constructor
          · rintro ⟨⟨ξ, hξ_cl, rfl⟩, hv_Q⟩
            have hξ_Q : g₂.base (π₂.base ξ) = g₂.base w := by
              change (π₂ ≫ g₂).base ξ = g₂.base w
              rw [← hπ_g]
              exact hv_Q
            exact ⟨ξ, hw_Q_uniq (π₂.base ξ) hξ_cl hξ_Q, rfl⟩
          · rintro ⟨ξ, hξ_w, rfl⟩
            have hξ_w' : π₂.base ξ = w := hξ_w
            refine ⟨⟨ξ, Set.preimage_mono subset_closure hξ_w, rfl⟩, ?_⟩
            change (π₁ ≫ g₁).base ξ = Q
            rw [hπ_g]
            change g₂.base (π₂.base ξ) = Q
            rw [hξ_w']
        have hFcl_inf :
            ¬ (F_cl ∩ g₁.base ⁻¹' ({Q} : Set ↥(AlgebraicGeometry.Spec (CommRingCat.of ↥R)))).Finite :=
          fun hF => hSw_inf (Eq.mp (congrArg Set.Finite hFcl_eq) hF)
        have _ : AlgebraicGeometry.IsAffine W_B_sch := hAff_WB
        have _ : AlgebraicGeometry.IsProper f₁ := hProp₁
        have hComp₁ : CompactSpace ↥Y₁ :=
          AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace f₁
        obtain ⟨η_Q, hηQ_mem, hηQ_min⟩ := hInfMin₁ hComp₁ Q F_cl hFcl_closed hFcl_inf
        have hηQ_Q : g₁.base η_Q = Q := hηQ_mem.2
        have hηQ_Sw : η_Q ∈ S_w := Eq.mp (congrArg (η_Q ∈ ·) hFcl_eq) hηQ_mem
        obtain ⟨η_Γ', hηΓ'_w, hηΓ'_π₁⟩ := hηQ_Sw
        have hηΓ'_π₂ : π₂.base η_Γ' = w := hηΓ'_w
        have hf₁_ηQ : f₁.base η_Q = y := by
          rw [← hηΓ'_π₁]
          change (π₁ ≫ f₁).base η_Γ' = y
          rw [hπ_f]
          change f₂.base (π₂.base η_Γ') = y
          rw [hηΓ'_π₂]
        have hηQ_neBot : (g₁.base η_Q).asIdeal ≠ ⊥ := by
          rw [hηQ_Q, ← hy_Q]
          exact hZ_neBot y hy
        have hu₀_in_img : u₀_WB ∈ f₁.base '' closure ({η_Q} : Set ↥Y₁) := by
          refine closure_minimal ?_ (f₁.isClosedMap _ isClosed_closure) (hZ_sp y hy)
          rw [Set.singleton_subset_iff]
          exact ⟨η_Q, subset_closure (Set.mem_singleton η_Q), hf₁_ηQ⟩
        obtain ⟨z₀, hz₀_cl, hf₁_z₀⟩ := hu₀_in_img
        have hz₀_max : (g₁.base z₀).asIdeal = IsLocalRing.maximalIdeal ↥R := by
          calc (g₁.base z₀).asIdeal
              = ((f₁ ≫ g_WB).base z₀).asIdeal := by rw [hf₁_g]
            _ = (g_WB.base (f₁.base z₀)).asIdeal := rfl
            _ = (g_WB.base u₀_WB).asIdeal := by rw [hf₁_z₀]
            _ = IsLocalRing.maximalIdeal ↥R := hu₀_max
        obtain ⟨z₁, E₁, hz₁_cl, hz₁_max, hE₁_irr, hE₁_img⟩ :=
          hSpec₁ η_Q z₀ hηQ_neBot
            (fun y' hy' hcl => hηQ_min y' (hy'.trans hηQ_Q) hcl)
            hz₀_cl hz₀_max
        have hf₁_z₁_cly : f₁.base z₁ ∈ closure ({y} : Set ↥W_B_sch) := by
          have hmem : f₁.base z₁ ∈ f₁.base '' closure ({η_Q} : Set ↥Y₁) := ⟨z₁, hz₁_cl, rfl⟩
          have hsub := image_closure_subset_closure_image f₁.continuous (s := ({η_Q} : Set ↥Y₁))
          rw [Set.image_singleton, hf₁_ηQ] at hsub
          exact hsub hmem
        have hf₁_z₁_max : (g_WB.base (f₁.base z₁)).asIdeal = IsLocalRing.maximalIdeal ↥R := by
          calc (g_WB.base (f₁.base z₁)).asIdeal
              = ((f₁ ≫ g_WB).base z₁).asIdeal := rfl
            _ = (g₁.base z₁).asIdeal := by rw [hf₁_g]
            _ = IsLocalRing.maximalIdeal ↥R := hz₁_max
        have hf₁_z₁ : f₁.base z₁ = u₀_WB := hu₀_uniq (f₁.base z₁) hf₁_z₁_cly hf₁_z₁_max
        have hE₁_u₀ : ∀ q ∈ E₁,
            f₁.base ((CategoryTheory.Limits.pullback.fst g₁ s_R).base q) = u₀_WB := by
          have hcl_sub : closure ({z₁} : Set ↥Y₁) ⊆ f₁.base ⁻¹' ({u₀_WB} : Set ↥W_B_sch) := by
            refine closure_minimal ?_ (hu₀_cl.preimage f₁.continuous)
            rw [Set.singleton_subset_iff]
            exact hf₁_z₁
          intro q hq
          have hmem : (CategoryTheory.Limits.pullback.fst g₁ s_R).base q ∈
              closure ({z₁} : Set ↥Y₁) := by
            rw [← hE₁_img]
            exact ⟨q, hq, rfl⟩
          exact hcl_sub hmem
        have hz₁_in_img : z₁ ∈ π₁.base '' closure ({η_Γ'} : Set ↥Γ) := by
          refine closure_minimal ?_ (π₁.isClosedMap _ isClosed_closure) hz₁_cl
          rw [Set.singleton_subset_iff]
          exact ⟨η_Γ', subset_closure (Set.mem_singleton η_Γ'), hηΓ'_π₁⟩
        obtain ⟨ξ₀, hξ₀_cl, hξ₀_π₁⟩ := hz₁_in_img
        have hξ₀_clw : π₂.base ξ₀ ∈ closure ({w} : Set ↥Y₂) := by
          have hmem : π₂.base ξ₀ ∈ π₂.base '' closure ({η_Γ'} : Set ↥Γ) := ⟨ξ₀, hξ₀_cl, rfl⟩
          have hsub := image_closure_subset_closure_image π₂.continuous (s := ({η_Γ'} : Set ↥Γ))
          rw [Set.image_singleton, hηΓ'_π₂] at hsub
          exact hsub hmem
        have hξ₀_max : (g₂.base (π₂.base ξ₀)).asIdeal = IsLocalRing.maximalIdeal ↥R := by
          calc (g₂.base (π₂.base ξ₀)).asIdeal
              = ((π₂ ≫ g₂).base ξ₀).asIdeal := rfl
            _ = ((π₁ ≫ g₁).base ξ₀).asIdeal := by rw [← hπ_g]
            _ = (g₁.base (π₁.base ξ₀)).asIdeal := rfl
            _ = (g₁.base z₁).asIdeal := by rw [hξ₀_π₁]
            _ = IsLocalRing.maximalIdeal ↥R := hz₁_max
        have hξ₀_π₂ : π₂.base ξ₀ = w₀ := hw₀_uniq (π₂.base ξ₀) hξ₀_clw hξ₀_max
        obtain ⟨U_Γ, hU_Γ, hξ₀_U, _⟩ :=
          AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := ⊤) (x := ξ₀) trivial
        have hUΓ_ne : Nonempty ↥U_Γ := ⟨⟨ξ₀, hξ₀_U⟩⟩
        let A_Γ : Type u := ↑(Γ.presheaf.obj (Opposite.op U_Γ))
        have _ : IsDomain A_Γ :=
          @AlgebraicGeometry.IsIntegral.component_integral Γ hInt_Γ U_Γ hUΓ_ne
        obtain ⟨φ_Γ, hFrac_Γ, hSpec_Γ⟩ := hFunc_Γ U_Γ hU_Γ hUΓ_ne
        have hInj_φΓ : Function.Injective φ_Γ.hom :=
          @IsFractionRing.injective A_Γ _ F_WB _ φ_Γ.hom.toAlgebra hFrac_Γ
        let p_ξ : PrimeSpectrum A_Γ := hU_Γ.primeIdealOf ⟨ξ₀, hξ₀_U⟩
        have _ : p_ξ.asIdeal.IsPrime := p_ξ.isPrime
        let L_ξ := Localization.AtPrime p_ξ.asIdeal
        have hUnits_ξ : ∀ s : p_ξ.asIdeal.primeCompl, IsUnit (φ_Γ.hom s.1) := by
          intro s
          have hs0 : s.1 ≠ 0 := fun h0 => s.2 (h0 ▸ p_ξ.asIdeal.zero_mem)
          exact IsUnit.mk0 (φ_Γ.hom s.1) (fun h => hs0 (hInj_φΓ (h.trans (map_zero φ_Γ.hom).symm)))
        let f_loc : L_ξ →+* F_WB := IsLocalization.lift (M := p_ξ.asIdeal.primeCompl) hUnits_ξ
        obtain ⟨W₀, hMem_W₀, hLocal_g⟩ := IsLocalRing.exists_factor_valuationRing f_loc
        let g_loc : L_ξ →+* ↥W₀ := f_loc.codRestrict W₀.toSubring hMem_W₀
        have _ : IsLocalHom g_loc := hLocal_g
        let ψ_A : A_Γ →+* ↥W₀ := g_loc.comp (algebraMap A_Γ L_ξ)
        let ψ_Γ : AlgebraicGeometry.Spec (CommRingCat.of ↥W₀) ⟶ Γ :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_A) ≫ hU_Γ.fromSpec
        let mW₀ : AlgebraicGeometry.Spec (CommRingCat.of ↥W₀) :=
          ⟨IsLocalRing.maximalIdeal ↥W₀, (IsLocalRing.maximalIdeal.isMaximal ↥W₀).isPrime⟩
        have hψΓ_η : AlgebraicGeometry.Spec.map (CommRingCat.ofHom W₀.subtype) ≫ ψ_Γ = η_Γ := by
          dsimp only [ψ_Γ]
          rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
          have hcomp : CommRingCat.ofHom ψ_A ≫ CommRingCat.ofHom W₀.subtype = φ_Γ := by
            apply CommRingCat.hom_ext
            ext a
            change f_loc (algebraMap A_Γ L_ξ a) = φ_Γ.hom a
            exact IsLocalization.lift_eq (M := p_ξ.asIdeal.primeCompl) hUnits_ξ a
          rw [hcomp, hSpec_Γ]
        have hψΓ_pt : ψ_Γ.base mW₀ = ξ₀ := by
          have hcomap_g : Ideal.comap g_loc (IsLocalRing.maximalIdeal ↥W₀) =
              IsLocalRing.maximalIdeal L_ξ := by
            ext x
            rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, IsLocalRing.mem_maximalIdeal]
            change ¬ IsUnit (g_loc x) ↔ ¬ IsUnit x
            exact not_congr ⟨fun hu => isUnit_of_map_unit g_loc x hu, IsUnit.map g_loc⟩
          have hcomap_A : Ideal.comap ψ_A (IsLocalRing.maximalIdeal ↥W₀) = p_ξ.asIdeal := by
            dsimp only [ψ_A]
            rw [← Ideal.comap_comap, hcomap_g]
            exact IsLocalization.AtPrime.comap_maximalIdeal L_ξ p_ξ.asIdeal
          have hspec_pt :
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_A)).base mW₀ = p_ξ :=
            PrimeSpectrum.ext hcomap_A
          change hU_Γ.fromSpec.base
            ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_A)).base mW₀) = ξ₀
          rw [hspec_pt]
          exact hU_Γ.fromSpec_primeIdealOf ⟨ξ₀, hξ₀_U⟩
        have hStalk₁ : IsComponentStalkVal R g₁ η₁ E₁ W₀ := by
          refine ⟨ψ_Γ ≫ π₁, mW₀, rfl, ?_, ?_⟩
          · rw [← CategoryTheory.Category.assoc, hψΓ_η, hη_π₁]
          · change (CategoryTheory.Limits.pullback.fst g₁ s_R).base '' E₁ =
              closure ({π₁.base (ψ_Γ.base mW₀)} : Set ↥Y₁)
            rw [hψΓ_pt, hξ₀_π₁, hE₁_img]
        obtain ⟨E₂, hE₂_irr, ψ'₂, m'W₀, hm'W₀, hψ'₂_η, hE₂_img⟩ :=
          hDom₁₂ E₁ hE₁_irr hE₁_u₀ W₀ hStalk₁
        let ψ₂ : AlgebraicGeometry.Spec (CommRingCat.of ↥W₀) ⟶ Y₂ := ψ_Γ ≫ π₂
        have hψ₂_η : AlgebraicGeometry.Spec.map (CommRingCat.ofHom W₀.subtype) ≫ ψ₂ = η₂ := by
          dsimp only [ψ₂]
          rw [← CategoryTheory.Category.assoc, hψΓ_η, hη_π₂]
        have _ : AlgebraicGeometry.IsSeparated g₂ := hSS₂.2.2.1
        have _ : AlgebraicGeometry.IsDominant
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom W₀.subtype)) :=
          hDom_specMap W₀.subtype Subtype.val_injective
        have hg₂_eq : ψ'₂ ≫ g₂ = ψ₂ ≫ g₂ := by
          refine AlgebraicGeometry.ext_of_isDominant
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom W₀.subtype)) ?_
          rw [← CategoryTheory.Category.assoc, hψ'₂_η, ← CategoryTheory.Category.assoc, hψ₂_η]
        have hψ₂_eq : ψ'₂ = ψ₂ :=
          AlgebraicGeometry.ext_of_isDominant_of_isSeparated g₂ hg₂_eq
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom W₀.subtype))
            (hψ'₂_η.trans hψ₂_η.symm)
        have hmW₀_eq : m'W₀ = mW₀ := PrimeSpectrum.ext hm'W₀
        have hE₂_eq : (CategoryTheory.Limits.pullback.fst g₂ s_R).base '' E₂ = {w₀} := by
          rw [hE₂_img, hψ₂_eq, hmW₀_eq]
          change closure ({π₂.base (ψ_Γ.base mW₀)} : Set ↥Y₂) = {w₀}
          rw [hψΓ_pt, hξ₀_π₂, hw₀_cl.closure_eq]
        exact hNonSing₂ E₂ hE₂_irr w₀ hw₀_cl hE₂_eq
    · exact (hSub_compl w hy).finite
  have hLocQF : ∀ z : Γ,
      ∃ (U_X : Y₂.Opens) (_ : AlgebraicGeometry.IsAffineOpen U_X)
        (V_C : Γ.Opens) (_ : AlgebraicGeometry.IsAffineOpen V_C)
        (e_X : V_C ≤ (TopologicalSpace.Opens.map π₂.base).obj U_X),
        z ∈ V_C ∧
        (π₂.appLE U_X V_C e_X).hom.FiniteType ∧
        (π₂.appLE U_X V_C e_X).hom.QuasiFinite := by
    intro z
    have _ : AlgebraicGeometry.IsProper π₂ := hProp_π₂
    have hLFT_π₂ : AlgebraicGeometry.LocallyOfFiniteType π₂ := inferInstance
    obtain ⟨U_X, hUX, hzUX, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := π₂.base z) (U := ⊤) trivial
    obtain ⟨V_C, hVC, hzVC, e_X⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
        (x := z) (U := (TopologicalSpace.Opens.map π₂.base).obj U_X) hzUX
    refine ⟨U_X, hUX, V_C, hVC, e_X, hzVC, hLFT_π₂.finiteType_appLE hUX hVC e_X, ?_⟩
    let B_X : Type u := ↑(Y₂.presheaf.obj (Opposite.op U_X))
    let B_C : Type u := ↑(Γ.presheaf.obj (Opposite.op V_C))
    let α_hom : B_X →+* B_C := (π₂.appLE U_X V_C e_X).hom
    let _ : Algebra B_X B_C := α_hom.toAlgebra
    have _ : Algebra.FiniteType B_X B_C := hLFT_π₂.finiteType_appLE hUX hVC e_X
    change Algebra.QuasiFinite B_X B_C
    rw [Algebra.QuasiFinite.iff_finite_primesOver]
    intro I hI
    let x : ↥Y₂ := hUX.fromSpec.base ⟨I, hI⟩
    let f_map : ↥(I.primesOver B_C) → ↥(π₂.base ⁻¹' {x}) := fun J =>
      ⟨hVC.fromSpec.base ⟨J.1, J.2.1⟩, by
        change (hVC.fromSpec ≫ π₂).base ⟨J.1, J.2.1⟩ = hUX.fromSpec.base ⟨I, hI⟩
        rw [← AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec π₂ hUX hVC e_X]
        change hUX.fromSpec.base
          ((AlgebraicGeometry.Spec.map (π₂.appLE U_X V_C e_X)).base ⟨J.1, J.2.1⟩) =
          hUX.fromSpec.base ⟨I, hI⟩
        congr 1
        rw [AlgebraicGeometry.Spec.map_base]
        apply PrimeSpectrum.ext
        have hover := (@Ideal.LiesOver.over _ _ _ _ _ J.1 I J.2.2).symm
        rwa [Ideal.under_def] at hover⟩
    have hInj_f : Function.Injective f_map := by
      intro J₁ J₂ heq
      have hval : (f_map J₁).1 = (f_map J₂).1 := congrArg Subtype.val heq
      have hpt := hVC.fromSpec.isOpenEmbedding.injective hval
      exact Subtype.ext (congrArg PrimeSpectrum.asIdeal hpt)
    have _ : Finite ↥(π₂.base ⁻¹' {x}) := (hFin x).to_subtype
    have _ : Finite ↥(I.primesOver B_C) := Finite.of_injective f_map hInj_f
    exact Set.toFinite _
  have hIso_π₂ : CategoryTheory.IsIso π₂ :=
    weil_birational_proper_iso_of_locallyQuasiFinite_normal
      Γ Y₂ F_WB π₂ η_Γ η₂ hInt_Γ hSS₂.1 hNorm₂ hProp_π₂ hDom_ηΓ hη_π₂ hFunc_Γ hFunc₂ hLocQF
  have _ : CategoryTheory.IsIso π₂ := hIso_π₂
  have _ : AlgebraicGeometry.IsProper π₁ := hProp_π₁
  let α : Y₂ ⟶ Y₁ := CategoryTheory.inv π₂ ≫ π₁
  have hα_g : α ≫ g₁ = g₂ := by
    dsimp only [α]
    rw [CategoryTheory.Category.assoc, hπ_g, CategoryTheory.IsIso.inv_hom_id_assoc]
  have hα_f : α ≫ f₁ = f₂ := by
    dsimp only [α]
    rw [CategoryTheory.Category.assoc, hπ_f, CategoryTheory.IsIso.inv_hom_id_assoc]
  have hη₂_α : η₂ ≫ α = η₁ := by
    dsimp only [α]
    rw [← hη_π₂, CategoryTheory.Category.assoc, CategoryTheory.IsIso.hom_inv_id_assoc, hη_π₁]
  have hProp_α : AlgebraicGeometry.IsProper α := by
    dsimp only [α]
    infer_instance
  have _ : AlgebraicGeometry.IsProper α := hProp_α
  have hDom_η₁ : AlgebraicGeometry.IsDominant η₁ :=
    hDom_funcField Y₁ hSS₁.1 η₁ hFunc₁
  have hDom_α : AlgebraicGeometry.IsDominant α := by
    rw [AlgebraicGeometry.isDominant_iff, DenseRange]
    intro x
    have hx : x ∈ closure (Set.range η₁.base) := hDom_η₁.denseRange x
    refine closure_mono ?_ hx
    rintro _ ⟨q, rfl⟩
    rw [← hη₂_α]
    exact ⟨η₂.base q, rfl⟩
  have _ : AlgebraicGeometry.IsDominant α := hDom_α
  have hSurj_α : AlgebraicGeometry.Surjective α :=
    AlgebraicGeometry.Surjective.of_universallyClosed_of_isDominant α
  exact ⟨α, hα_g, hα_f, hη₂_α, hProp_α, hSurj_α⟩

theorem weil_nodal_single_coord_branch_composite_valuation (K : Type u) [Field K] [IsSepClosed K]
    (m : ℕ) (R : ValuationSubring K) (hPkg_R : IsValuationRingAlgPackage m R)
    (hMax_R : IsLocalRing.maximalIdeal ↥R ≠ ⊥)
    (F : Type u) [Field F]
    (Y_hat : AlgebraicGeometry.Scheme.{u})
    (g_hat : Y_hat ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
    (η_hat : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ Y_hat)
    (hSS_hat : IsStrictlySemistableCurveOverValuation R g_hat)
    (hFunc_hat : IsSchemeFunctionField Y_hat F η_hat) :
    let s_R := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.maximalIdeal ↥R).ResidueField))
    ∀ (B₀ : Set ↥(CategoryTheory.Limits.pullback g_hat s_R))
      (W₀ : ValuationSubring F)
      (p₀ : ↥(CategoryTheory.Limits.pullback g_hat s_R)),
      B₀ ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_hat s_R) →
      IsComponentStalkVal R g_hat η_hat B₀ W₀ →
      p₀ ∈ B₀ →
      (∃ (U_nod : Y_hat.Opens) (a_n : ↥R)
         (e_n : U_nod.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of
           (MvPolynomial (Fin 2) ↥R ⧸ Ideal.span
             {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a_n}))),
         a_n ≠ 0 ∧ a_n ∈ IsLocalRing.maximalIdeal ↥R ∧
         AlgebraicGeometry.Etale e_n ∧
         U_nod.ι ≫ g_hat = e_n ≫ AlgebraicGeometry.Spec.map
           (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) ∧
         ∃ hp : (CategoryTheory.Limits.pullback.fst g_hat s_R).base p₀ ∈ U_nod,
           (∀ j : Fin 2, Ideal.Quotient.mk _ (MvPolynomial.X j) ∈
             (e_n.base ⟨_, hp⟩).asIdeal) ∧
           ∃ b₀ : Fin 2, ∀ x : ↥U_nod,
             (g_hat.base x.1).asIdeal = IsLocalRing.maximalIdeal ↥R →
             (x.1 ∈ (CategoryTheory.Limits.pullback.fst g_hat s_R).base '' B₀ ↔
               Ideal.Quotient.mk _ (MvPolynomial.X b₀) ∈ (e_n.base x).asIdeal)) →
      ∃ (U₀ : ValuationSubring F)
        (φ_hat : AlgebraicGeometry.Spec (CommRingCat.of ↥U₀) ⟶ Y_hat)
        (mU₀ : AlgebraicGeometry.Spec (CommRingCat.of ↥U₀)),
        U₀ ≤ W₀ ∧
        U₀ ≠ W₀ ∧
        mU₀.asIdeal = IsLocalRing.maximalIdeal ↥U₀ ∧
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom U₀.subtype) ≫ φ_hat = η_hat ∧
        φ_hat.base mU₀ = (CategoryTheory.Limits.pullback.fst g_hat s_R).base p₀ :=
by
  intro s_R B₀ W₀ p₀ _hB₀_irr hW₀ hp₀_B₀
  rintro ⟨U_nod, a_n, e_n, _ha_ne, ha_mem, hEt_e, he_comm, hp, hXj, b₀, hb₀⟩
  let m_R : Ideal ↥R := IsLocalRing.maximalIdeal ↥R
  let tilde_p₀ : ↥Y_hat := (CategoryTheory.Limits.pullback.fst g_hat s_R).base p₀
  let I_a : @Ideal (MvPolynomial (Fin 2) ↥R) CommRing.toCommSemiring.toSemiring :=
    Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a_n}
  let R_nod : CommRingCat.{u} := CommRingCat.of (MvPolynomial (Fin 2) ↥R ⧸ I_a)
  let mk_nod : MvPolynomial (Fin 2) ↥R →+* ↑R_nod := Ideal.Quotient.mk I_a
  obtain ⟨V, hV_aff, hp_V, hV_sub⟩ :=
    AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hp
  let R_V : CommRingCat.{u} := Y_hat.presheaf.obj (Opposite.op V)
  have hRange_VU : Set.range hV_aff.fromSpec.base ⊆ Set.range U_nod.ι.base := by
    rw [hV_aff.range_fromSpec, AlgebraicGeometry.Scheme.Opens.range_ι]
    exact hV_sub
  let ι_VU : AlgebraicGeometry.Spec R_V ⟶ U_nod.toScheme :=
