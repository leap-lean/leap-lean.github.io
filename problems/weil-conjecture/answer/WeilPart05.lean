    (algebraMap (weilNodalQuot ↥R π_tilde) (Localization.Away h_0)).comp
      ((Ideal.Quotient.mk (weilNodalIdeal ↥R π_tilde)).comp MvPolynomial.C)
  let φ_R1 : ↥R →+* Localization.Away h_1 :=
    (algebraMap (weilNodalQuot ↥R b') (Localization.Away h_1)).comp
      ((Ideal.Quotient.mk (weilNodalIdeal ↥R b')).comp MvPolynomial.C)
  let u_0 : Localization.Away h_0 :=
    algebraMap (weilNodalQuot ↥R π_tilde) (Localization.Away h_0)
      (Ideal.Quotient.mk (weilNodalIdeal ↥R π_tilde) (MvPolynomial.X 0))
  let g_0 : Localization.Away h_0 :=
    algebraMap (weilNodalQuot ↥R π_tilde) (Localization.Away h_0)
      (Ideal.Quotient.mk (weilNodalIdeal ↥R π_tilde) (MvPolynomial.X 1))
  let g_1 : Localization.Away h_1 :=
    algebraMap (weilNodalQuot ↥R b') (Localization.Away h_1)
      (Ideal.Quotient.mk (weilNodalIdeal ↥R b') (MvPolynomial.X 0))
  let v_1 : Localization.Away h_1 :=
    algebraMap (weilNodalQuot ↥R b') (Localization.Away h_1)
      (Ideal.Quotient.mk (weilNodalIdeal ↥R b') (MvPolynomial.X 1))
  let d_X_B : Fin 2 → Localization.Away h_e := fun b_idx =>
    algebraMap (weilNodalQuot ↥R (b' * π_tilde)) (Localization.Away h_e)
      (Ideal.Quotient.mk (weilNodalIdeal ↥R (b' * π_tilde)) (MvPolynomial.X b_idx))
  let σ_loc : AlgebraicGeometry.Spec (CommRingCat.of (↥R ⧸ Q₀_R.asIdeal)) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away h_e)) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_σ)
  have hMod_cl : IsClosed (Set.range σ_loc.base) := by
    change IsClosed (Set.range (PrimeSpectrum.comap ρ_σ))
    rw [hRange_σ]
    exact PrimeSpectrum.isClosed_zeroLocus _
  obtain ⟨U_bl, p_bl, ι_0, ι_1, hOpen_ι0, hOpen_ι1, hCov_Ubl, hGlue_01,
      hRange_01, hRange_10, hι0_p, hι1_p, hProp_p, hIso_compl,
      hInt_of, hFlat_of, hLfp_of⟩ :=
    weil_twoChart_gluing_projProper_and_fourOpen_iso ↥R
      (Localization.Away h_e) (Localization.Away h_0) (Localization.Away h_1)
      (Localization.Away h_01)
      φ_RB ψ_0 ψ_1 g_0 g_1 f₀₁ f₁₀ hLoc0 hLoc1 hCocycle hGen0 hGen1 hInv
      (Set.range σ_loc.base) hMod_cl
      (d_X_B 0) (d_X_B 1) (φ_RB π_tilde) (φ_RB b')
      hRange_σ hOpen0 hOpen1 hOpen2 hOpen3
  let g_B : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away h_e)) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of ↥R) :=
    AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom
          ((Ideal.Quotient.mk (weilNodalIdeal ↥R (b' * π_tilde))).comp MvPolynomial.C) ≫
        CommRingCat.ofHom (algebraMap (weilNodalQuot ↥R (b' * π_tilde)) (Localization.Away h_e)))
  have hgB_eq : g_B = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_RB) := by
    dsimp only [g_B, φ_RB]
    rw [← CommRingCat.ofHom_comp]
  let g_Ubl : U_bl ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R) := p_bl ≫ g_B
  have hh0_ne : h_0 ≠ 0 := fun h0 => hh0_notMem (h0 ▸ Ideal.zero_mem _)
  have hh1_ne : h_1 ≠ 0 := fun h1 => hh1_notMem (h1 ▸ Ideal.zero_mem _)
  have hh01_ne : h_01 ≠ 0 := by
    intro h01_zero
    have h01_unit : IsUnit ((0 : ↥R) - 1) := by
      rw [zero_sub]; exact isUnit_one.neg
    have hev := hhZ_eval 0 1 (IsLocalRing.notMem_maximalIdeal.mpr h01_unit)
    rw [h01_zero, Polynomial.zero_comp, Polynomial.eval_zero] at hev
    exact hev (Ideal.zero_mem _)
  obtain ⟨hDom0, hFlat0, hLfp0⟩ := hChartProps π_tilde h_0 hπ_ne hh0_ne
  obtain ⟨hDom1, hFlat1, hLfp1⟩ := hChartProps b' h_1 hb'_ne hh1_ne
  have hInt_Ubl : AlgebraicGeometry.IsIntegral U_bl :=
    hInt_of hDom0 hDom1 (hPolyNontriv h_01 hh01_ne)
  have hψ0_φRB : ψ_0.comp φ_RB = φ_R0 := RingHom.ext hψ0_C
  have hψ1_φRB : ψ_1.comp φ_RB = φ_R1 := RingHom.ext hψ1_C
  have hFlat_Ubl : AlgebraicGeometry.Flat g_Ubl := by
    change AlgebraicGeometry.Flat (p_bl ≫ g_B)
    rw [hgB_eq]
    exact hFlat_of (hψ0_φRB.symm ▸ hFlat0) (hψ1_φRB.symm ▸ hFlat1)
  have hLfp_Ubl : AlgebraicGeometry.LocallyOfFinitePresentation g_Ubl := by
    change AlgebraicGeometry.LocallyOfFinitePresentation (p_bl ≫ g_B)
    rw [hgB_eq]
    exact hLfp_of (hψ0_φRB.symm ▸ hLfp0) (hψ1_φRB.symm ▸ hLfp1)
  have hψ0_d1_mul : ψ_0 (d_X_B 1) = φ_R0 b' * g_0 := by
    dsimp only [d_X_B]
    rw [hψ0_d1]
    dsimp only [φ_R0, g_0, RingHom.comp_apply]
    rw [← map_mul, ← map_mul]
  have hψ1_d0_mul : ψ_1 (d_X_B 0) = φ_R1 π_tilde * g_1 := by
    dsimp only [d_X_B]
    rw [hψ1_d0]
    dsimp only [φ_R1, g_1, RingHom.comp_apply]
    rw [← map_mul, ← map_mul]
  have hu0_mul_g0 : u_0 * g_0 = φ_R0 π_tilde := by
    have hq : Ideal.Quotient.mk (weilNodalIdeal ↥R π_tilde) (MvPolynomial.X 0) *
        Ideal.Quotient.mk (weilNodalIdeal ↥R π_tilde) (MvPolynomial.X 1) =
        Ideal.Quotient.mk (weilNodalIdeal ↥R π_tilde) (MvPolynomial.C π_tilde) := by
      rw [← map_mul, ← sub_eq_zero, ← map_sub, Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.subset_span rfl
    dsimp only [u_0, g_0, φ_R0, RingHom.comp_apply]
    rw [← map_mul, hq]
  have hg1_mul_v1 : g_1 * v_1 = φ_R1 b' := by
    have hq : Ideal.Quotient.mk (weilNodalIdeal ↥R b') (MvPolynomial.X 0) *
        Ideal.Quotient.mk (weilNodalIdeal ↥R b') (MvPolynomial.X 1) =
        Ideal.Quotient.mk (weilNodalIdeal ↥R b') (MvPolynomial.C b') := by
      rw [← map_mul, ← sub_eq_zero, ← map_sub, Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.subset_span rfl
    dsimp only [g_1, v_1, φ_R1, RingHom.comp_apply]
    rw [← map_mul, hq]
  have hShiftZ : ∀ (δ_e c_tilde : ↥R),
      δ_e - c_tilde ∉ IsLocalRing.maximalIdeal ↥R →
      ∃ (h_Z : Polynomial ↥R) (Θ_δ : Localization.Away h_01 ≃+* Localization.Away h_Z),
        Polynomial.eval c_tilde h_Z ∉ IsLocalRing.maximalIdeal ↥R ∧
        IsUnit (algebraMap (Polynomial ↥R) (Localization.Away h_Z)
          (Polynomial.X - Polynomial.C δ_e)) ∧
        (∀ r : ↥R,
          Θ_δ (algebraMap (Polynomial ↥R) (Localization.Away h_01) (Polynomial.C r)) =
            algebraMap (Polynomial ↥R) (Localization.Away h_Z) (Polynomial.C r)) ∧
        Θ_δ (algebraMap (Polynomial ↥R) (Localization.Away h_01) Polynomial.X) =
          algebraMap (Polynomial ↥R) (Localization.Away h_Z)
            (Polynomial.X - Polynomial.C δ_e) := by
    intro δ_e c_tilde hδc
    obtain ⟨hUnit_Z, Θ_δ, hΘ_C, hΘ_X⟩ := hShift δ_e
    exact ⟨h_01.comp (Polynomial.X - Polynomial.C δ_e), Θ_δ,
      hhZ_eval δ_e c_tilde hδc, hUnit_Z, hΘ_C, hΘ_X⟩
  obtain ⟨hσ_gB, hσ_X, hτ0_p, hτ1_p, hDisj_τ, hGen_fib, hTriad⟩ :=
    hFiberGlue π_tilde b' hπ_mem hb'_mem Q₀_R hπ_Q hb'_Q hQ_le_mR
      (Localization.Away h_e) (Localization.Away h_0) (Localization.Away h_1)
      (Localization.Away h_01)
      φ_RB φ_R0 φ_R1 ψ_0 ψ_1 f₀₁ f₁₀
      d_X_B u_0 g_0 g_1 v_1
      g_B U_bl p_bl g_Ubl ι_0 ι_1 ρ_σ ρ_τ0 ρ_τ1
      hgB_eq rfl hψ0_C hψ1_C hψ0_d0 hψ0_d1_mul hψ1_d0_mul hψ1_d1
      hu0_mul_g0 hg1_mul_v1 hf01_C hf01_u0 hf01_g0 hLoc0 hCocycle
      hOpen_ι0 hOpen_ι1 hCov_Ubl hGlue_01 hRange_01 hRange_10 hι0_p hι1_p
      hMod_cl hρ_σ_surj hρ_σ_R hρ_σ_X
      (fun x q => hEq_σ x q) hρ_τ0_comp hρ_τ1_comp hg1_mem_τ1
      hq01_gen hqS0_ex hqS1_ex hp_nod0_uniq hp_nod1_uniq hShiftZ
  refine ⟨Q₀_R, U_bl, g_Ubl, p_bl, σ_loc,
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_τ0) ≫ ι_0,
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_τ1) ≫ ι_1,
    h_0, h_1, ι_0, ι_1, ψ_0, ψ_1,
    hQ_ne, hπ_Q, hb'_Q, hInt_Ubl, rfl, hProp_p, hFlat_Ubl, hLfp_Ubl,
    hσ_gB, hσ_X, hτ0_p, hτ1_p, hDisj_τ, ⟨hMod_cl, hIso_compl⟩, hGen_fib,
    hh0_notMem, hh1_notMem, hOpen_ι0, hOpen_ι1, hCov_Ubl, hι0_p, hι1_p,
    hψ0_C, hψ0_d0, hψ0_d1, hψ1_C, hψ1_d0, hψ1_d1, ?_, hTriad⟩
  intro F _ φ_B hd2_ne hd3_ne hd0_ne
  obtain ⟨φ_01, hφ01_B, hφ01_g0, hφ01_g1⟩ := hFieldLift F φ_B hd2_ne hd3_ne hd0_ne
  refine ⟨φ_01.comp f₀₁, φ_01.comp f₁₀, hφ01_B, ?_, ?_, hφ01_g0, hφ01_g1⟩
  · rw [RingHom.comp_assoc, ← hCocycle, ← RingHom.comp_assoc]
    exact hφ01_B
  · rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc,
      hGlue_01, ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp]

theorem weil_join_closed_disc_tree_insertion_hasse_and_residues (K : Type u) [Field K] (R : ValuationSubring K) (a_opt : Option ↥R)
    (N' : ℕ) (c π : Fin (N' + 1) → ↥R)
    (hTree : IsJoinClosedDiscTree ↥R a_opt c π)
    (i_Z : Fin (N' + 1))
    (hiZ_nb : ¬ IsDiscBoundaryIdx ↥R a_opt (c i_Z) (π i_Z))
    (hDeg_lo : 1 ≤ {j : Fin (N' + 1) | IsDiscHasseCover ↥R c π i_Z j ∨
      IsDiscHasseCover ↥R c π j i_Z}.ncard)
    (hDeg_hi : {j : Fin (N' + 1) | IsDiscHasseCover ↥R c π i_Z j ∨
      IsDiscHasseCover ↥R c π j i_Z}.ncard ≤ 2) :
    let c' : Fin N' → ↥R := c ∘ i_Z.succAbove
    let π' : Fin N' → ↥R := π ∘ i_Z.succAbove
    let S_nb : Set (Fin (N' + 1)) :=
      {j : Fin (N' + 1) | IsDiscHasseCover ↥R c π i_Z j ∨ IsDiscHasseCover ↥R c π j i_Z}
    (c i_Z ∈ IsLocalRing.maximalIdeal ↥R ∧
      π i_Z ∈ IsLocalRing.maximalIdeal ↥R ∧
      (∀ a₀ : ↥R, a_opt = some a₀ → ¬ IsValDiscLE ↥R (c i_Z) (π i_Z) 0 a₀)) ∧
    ∃ (i'_p : Fin N') (π_tilde c_tilde_Z : ↥R),
      IsDiscHasseCover ↥R c π (i_Z.succAbove i'_p) i_Z ∧
      (∀ j : Fin (N' + 1), IsDiscHasseCover ↥R c π j i_Z → j = i_Z.succAbove i'_p) ∧
      π i_Z = π_tilde * π' i'_p ∧
      c i_Z - c' i'_p = c_tilde_Z * π' i'_p ∧
      π_tilde ≠ 0 ∧
      π_tilde ∈ IsLocalRing.maximalIdeal ↥R ∧
      ¬ (∃ a₀ : ↥R, a_opt = some a₀ ∧ IsValDiscEq ↥R (c' i'_p) (π' i'_p) 0 a₀) ∧
      ((S_nb.ncard = 1 ∧
          S_nb = {i_Z.succAbove i'_p} ∧
          (∀ j : Fin (N' + 1), ¬ IsDiscHasseCover ↥R c π i_Z j) ∧
          (IsDiscBoundaryIdx ↥R a_opt (c' i'_p) (π' i'_p) →
            a_opt = none ∧ c' i'_p = 0 ∧ π' i'_p = 1 ∧
              c_tilde_Z ∈ IsLocalRing.maximalIdeal ↥R) ∧
          (∀ x' y' : Fin N',
            IsDiscHasseCover ↥R c π (i_Z.succAbove x') (i_Z.succAbove y') ↔
              IsDiscHasseCover ↥R c' π' x' y') ∧
          (∀ (j' : Fin N') (r : ↥R),
            IsDiscHasseCover ↥R c' π' i'_p j' →
            c' j' - c' i'_p = r * π' i'_p →
            r - c_tilde_Z ∉ IsLocalRing.maximalIdeal ↥R)) ∨
       (S_nb.ncard ≠ 1 ∧
          ∃ (i'_c : Fin N') (b' δ_c : ↥R),
            i'_c ≠ i'_p ∧
            IsDiscHasseCover ↥R c π i_Z (i_Z.succAbove i'_c) ∧
            (∀ j : Fin (N' + 1), IsDiscHasseCover ↥R c π i_Z j → j = i_Z.succAbove i'_c) ∧
            S_nb = {i_Z.succAbove i'_p, i_Z.succAbove i'_c} ∧
            π' i'_c = b' * π i_Z ∧
            c' i'_c - c i_Z = δ_c * π i_Z ∧
            b' ≠ 0 ∧
            b' ∈ IsLocalRing.maximalIdeal ↥R ∧
            IsDiscHasseCover ↥R c' π' i'_p i'_c ∧
            (IsDiscBoundaryIdx ↥R a_opt (c' i'_p) (π' i'_p) →
              IsDiscBoundaryIdx ↥R a_opt (c' i'_c) (π' i'_c) →
              ∃ a₀ : ↥R, a_opt = some a₀ ∧
                c' i'_p = 0 ∧ π' i'_p = 1 ∧ c' i'_c = 0 ∧ π' i'_c = a₀) ∧
            (∀ x' y' : Fin N',
              IsDiscHasseCover ↥R c π (i_Z.succAbove x') (i_Z.succAbove y') ↔
                (IsDiscHasseCover ↥R c' π' x' y' ∧ (x' ≠ i'_p ∨ y' ≠ i'_c))) ∧
            (∀ x' y' : Fin N',
              IsDiscHasseCover ↥R c' π' x' y' → x' = i'_c → y' ≠ i'_p) ∧
            (∀ (x' : Fin N') (c_tilde : ↥R),
              (∀ (j : Fin (N' + 1)),
                IsDiscHasseCover ↥R c π (i_Z.succAbove x') j →
                ∀ r : ↥R, c j - c' x' = r * π' x' →
                  r - c_tilde ∉ IsLocalRing.maximalIdeal ↥R) →
              (∀ (j' : Fin N'),
                IsDiscHasseCover ↥R c' π' x' j' →
                ∀ r : ↥R, c' j' - c' x' = r * π' x' →
                  r - c_tilde ∉ IsLocalRing.maximalIdeal ↥R)))) :=
by
  classical
  intro c' π' S_nb
  change 1 ≤ S_nb.ncard at hDeg_lo
  change S_nb.ncard ≤ 2 at hDeg_hi
  obtain ⟨hπ_ne, h_anti, ⟨i_top, hc_top, hπ_top⟩, h_bot, h_mR, h_join⟩ := hTree
  have h1_not_mR : (1 : ↥R) ∉ IsLocalRing.maximalIdeal ↥R :=
    IsLocalRing.notMem_maximalIdeal.mpr isUnit_one
  have r_dvd_total : ∀ x y : ↥R, (∃ r : ↥R, x = r * y) ∨ (∃ r : ↥R, y = r * x) := by
    intro x y
    by_cases hy : y = 0
    · right; exact ⟨0, by rw [hy, zero_mul]⟩
    · have hy0 : (y : K) ≠ 0 := fun h => hy (Subtype.ext h)
      rcases ValuationSubring.mem_or_inv_mem R ((x : K) / (y : K)) with hxy | hyx
      · left
        refine ⟨⟨(x : K) / (y : K), hxy⟩, Subtype.ext ?_⟩
        exact (div_mul_cancel₀ (x : K) hy0).symm
      · by_cases hx : x = 0
        · left; exact ⟨0, by rw [hx, zero_mul]⟩
        · have hx0 : (x : K) ≠ 0 := fun h => hx (Subtype.ext h)
          right
          refine ⟨⟨((x : K) / (y : K))⁻¹, hyx⟩, Subtype.ext ?_⟩
          change (y : K) = ((x : K) / (y : K))⁻¹ * (x : K)
          rw [inv_div]
          exact (div_mul_cancel₀ (y : K) hx0).symm
  have disc_le_refl : ∀ c₁ π₁ : ↥R, IsValDiscLE ↥R c₁ π₁ c₁ π₁ := fun c₁ π₁ =>
    ⟨⟨1, (one_mul π₁).symm⟩, ⟨0, by rw [sub_self, zero_mul]⟩⟩
  have disc_le_trans : ∀ {c₁ π₁ c₂ π₂ c₃ π₃ : ↥R},
      IsValDiscLE ↥R c₁ π₁ c₂ π₂ → IsValDiscLE ↥R c₂ π₂ c₃ π₃ →
      IsValDiscLE ↥R c₁ π₁ c₃ π₃ := by
    rintro c₁ π₁ c₂ π₂ c₃ π₃ ⟨⟨r₁, hr₁⟩, ⟨s₁, hs₁⟩⟩ ⟨⟨r₂, hr₂⟩, ⟨s₂, hs₂⟩⟩
    refine ⟨⟨r₁ * r₂, by rw [hr₁, hr₂, mul_assoc]⟩, ⟨s₁ * r₂ + s₂, ?_⟩⟩
    calc c₁ - c₃ = (c₁ - c₂) + (c₂ - c₃) := by ring
      _ = s₁ * (r₂ * π₃) + s₂ * π₃ := by rw [hs₁, hr₂, hs₂]
      _ = (s₁ * r₂ + s₂) * π₃ := by ring
  have disc_eq_refl : ∀ c₁ π₁ : ↥R, IsValDiscEq ↥R c₁ π₁ c₁ π₁ :=
    fun c₁ π₁ => ⟨disc_le_refl c₁ π₁, disc_le_refl c₁ π₁⟩
  have disc_eq_symm : ∀ {c₁ π₁ c₂ π₂ : ↥R},
      IsValDiscEq ↥R c₁ π₁ c₂ π₂ → IsValDiscEq ↥R c₂ π₂ c₁ π₁ :=
    fun h => ⟨h.2, h.1⟩
  have disc_eq_trans : ∀ {c₁ π₁ c₂ π₂ c₃ π₃ : ↥R},
      IsValDiscEq ↥R c₁ π₁ c₂ π₂ → IsValDiscEq ↥R c₂ π₂ c₃ π₃ →
      IsValDiscEq ↥R c₁ π₁ c₃ π₃ :=
    fun h₁ h₂ => ⟨disc_le_trans h₁.1 h₂.1, disc_le_trans h₂.2 h₁.2⟩
  have disc_le_total_above : ∀ {c₀ π₀ c₁ π₁ c₂ π₂ : ↥R},
      IsValDiscLE ↥R c₀ π₀ c₁ π₁ → IsValDiscLE ↥R c₀ π₀ c₂ π₂ →
      IsValDiscLE ↥R c₁ π₁ c₂ π₂ ∨ IsValDiscLE ↥R c₂ π₂ c₁ π₁ := by
    rintro c₀ π₀ c₁ π₁ c₂ π₂ ⟨_, ⟨s₁, hs₁⟩⟩ ⟨_, ⟨s₂, hs₂⟩⟩
    rcases r_dvd_total π₁ π₂ with ⟨r, hr⟩ | ⟨r, hr⟩
    · left
      refine ⟨⟨r, hr⟩, ⟨s₂ - s₁ * r, ?_⟩⟩
      calc c₁ - c₂ = (c₀ - c₂) - (c₀ - c₁) := by ring
        _ = s₂ * π₂ - s₁ * (r * π₂) := by rw [hs₂, hs₁, hr]
        _ = (s₂ - s₁ * r) * π₂ := by ring
    · right
      refine ⟨⟨r, hr⟩, ⟨s₁ - s₂ * r, ?_⟩⟩
      calc c₂ - c₁ = (c₀ - c₁) - (c₀ - c₂) := by ring
        _ = s₁ * π₁ - s₂ * (r * π₁) := by rw [hs₁, hs₂, hr]
        _ = (s₁ - s₂ * r) * π₁ := by ring
  have proper_subdisc_factor : ∀ {i j : Fin (N' + 1)} {r s : ↥R},
      i ≠ j → π i = r * π j → c i - c j = s * π j →
      r ≠ 0 ∧ r ∈ IsLocalRing.maximalIdeal ↥R := by
    intro i j r s hij hπ hc
    refine ⟨?_, ?_⟩
    · rintro rfl
      rw [zero_mul] at hπ
      exact hπ_ne i hπ
    · by_contra hr_not
      have hr_unit : IsUnit r := IsLocalRing.notMem_maximalIdeal.mp hr_not
      obtain ⟨r_inv, hr_inv⟩ := hr_unit.exists_right_inv
      have hπ_rev : π j = r_inv * π i := by
        calc π j = 1 * π j := (one_mul _).symm
          _ = (r * r_inv) * π j := by rw [hr_inv]
          _ = r_inv * (r * π j) := by ring
          _ = r_inv * π i := by rw [← hπ]
      have hc_rev : c j - c i = (-s * r_inv) * π i := by
        calc c j - c i = -(c i - c j) := by ring
          _ = -(s * π j) := by rw [hc]
          _ = -(s * (r_inv * π i)) := by rw [← hπ_rev]
          _ = (-s * r_inv) * π i := by ring
