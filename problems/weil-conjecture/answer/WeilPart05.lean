                  (fun h2 => Fin.succAbove_ne i_Z k' h2.1)
        · obtain ⟨hcov', hnot_pc⟩ := (hHasse_iff_B x' y').mp hcov
          have hnot_pair : ¬ ((x' = i'_p ∨ x' = i'_c) ∧ (y' = i'_p ∨ y' = i'_c)) := by
            rintro ⟨hx_pc | hx_pc, hy_pc | hy_pc⟩
            · exact hcov'.1 (hx_pc.trans hy_pc.symm)
            · exact hnot_pc.elim (fun h => h hx_pc) (fun h => h hy_pc)
            · exact hNot_cp x' y' hcov' hx_pc hy_pc
            · exact hcov'.1 (hx_pc.trans hy_pc.symm)
          obtain ⟨c_xy, c_r, hr_cxy, hπ_cr, hcr_ne, hcr_mR, h_xy, ι_xy, φ_xy,
            hhxy_not, hOpen_xy, hιxy_g, hφxy_η, hφxy_X0, hφxy_X1, hιxy_comp⟩ :=
            hEdge_M' x' y' hcov'
          have hp0_not_Mod : ∀ p₀ : PrimeSpectrum (Localization.Away h_xy),
              (g'_M.base (ι_xy.base p₀)).asIdeal = IsLocalRing.maximalIdeal ↥R →
              algebraMap (weilNodalQuot ↥R c_r) (Localization.Away h_xy)
                (Ideal.Quotient.mk (weilNodalIdeal ↥R c_r) (MvPolynomial.X 0)) ∈ p₀.asIdeal →
              algebraMap (weilNodalQuot ↥R c_r) (Localization.Away h_xy)
                (Ideal.Quotient.mk (weilNodalIdeal ↥R c_r) (MvPolynomial.X 1)) ∈ p₀.asIdeal →
              ι_xy.base p₀ ∉ Mod_qM := by
            intro p₀ hp₀_mR hp₀_X0 hp₀_X1 hMod
            have h_in : ι_xy.base p₀ ∈
                Mod_qM ∩ {x : ↥M' | (g'_M.base x).asIdeal = IsLocalRing.maximalIdeal ↥R} :=
              ⟨hMod, hp₀_mR⟩
            rw [hMod_inter, Set.mem_singleton_iff] at h_in
            change ι_xy.base p₀ = z_new_M at h_in
            have hmem_x : z_new_M ∈ fst'_R.base '' (B'_comp x') := by
              rw [← h_in]; exact (hιxy_comp p₀ x' hp₀_mR).mpr (Or.inl ⟨rfl, hp₀_X1⟩)
            have hmem_y : z_new_M ∈ fst'_R.base '' (B'_comp y') := by
              rw [← h_in]; exact (hιxy_comp p₀ y' hp₀_mR).mpr (Or.inr ⟨rfl, hp₀_X0⟩)
            exact hnot_pair ⟨(hz_new_comp x').mp hmem_x, (hz_new_comp y').mp hmem_y⟩
          obtain ⟨g_xy, lam_xy, ι_tilde, u_lift, φ_tilde, hhgxy_not, hlam_q, hOpen_tilde,
            hu_j2, hu_ι, hιtilde_g, hφtilde_q, hφtilde_η⟩ :=
            hShrink_nod c_r h_xy M' M_tilde g'_M q_M Mod_qM hMod_cl j_2 ι_xy η_tilde φ_xy
              hcr_mR hhxy_not hOpen_j2 hj2_q hPre_compl hOpen_xy hιxy_g hη_not_Mod
              (by rw [hη_q, hφxy_η]) hp0_not_Mod
          refine ⟨c_xy, c_r, hr_cxy, hπ_cr, hcr_ne, hcr_mR, h_xy * g_xy, ι_tilde, φ_tilde,
            hhgxy_not, hOpen_tilde, hιtilde_g, hφtilde_η,
            by rw [hφtilde_q]; exact hφxy_X0,
            by rw [hφtilde_q]; exact hφxy_X1, ?_⟩
          intro p k hp_mR
          have hp_q : (ι_tilde ≫ q_M).base p = ι_xy.base (PrimeSpectrum.comap lam_xy p) := by
            rw [← hu_j2, CategoryTheory.Category.assoc, hj2_q, hu_ι]; rfl
          have hp'_mR : (g'_M.base (ι_xy.base (PrimeSpectrum.comap lam_xy p))).asIdeal =
              IsLocalRing.maximalIdeal ↥R := by
            change (g'_M.base ((ι_tilde ≫ q_M).base p)).asIdeal = _ at hp_mR
            rwa [hp_q] at hp_mR
          rw [← hu_j2]
          rcases idx_eq k with rfl | ⟨k', rfl⟩
          · rw [hBset_Z]
            refine ⟨fun h => False.elim ?_, fun h => False.elim ?_⟩
            · change u_lift.base p ∈ j_2.base ⁻¹' E_Z_M at h
              rw [hj2_EZ] at h; exact h
            · exact h.elim (fun h1 => Fin.succAbove_ne i_Z x' h1.1.symm)
                (fun h2 => Fin.succAbove_ne i_Z y' h2.1.symm)
          · change u_lift.base p ∈ j_2.base ⁻¹' (B_set (i_Z.succAbove k')) ↔ _
            rw [hj2_succ]
            simp only [Fin.succAbove_right_injective.eq_iff]
            have hu_pt : U_compl.ι.base (u_lift.base p) =
                ι_xy.base (PrimeSpectrum.comap lam_xy p) := by
              change (u_lift ≫ U_compl.ι).base p = _; rw [hu_ι]; rfl
            change U_compl.ι.base (u_lift.base p) ∈ fst'_R.base '' (B'_comp k') ↔ _
            rw [hu_pt, hιxy_comp (PrimeSpectrum.comap lam_xy p) k' hp'_mR]
            have hcomap_mem : ∀ q : weilNodalQuot ↥R c_r,
                algebraMap (weilNodalQuot ↥R c_r) (Localization.Away h_xy) q ∈
                  (PrimeSpectrum.comap lam_xy p).asIdeal ↔
                algebraMap (weilNodalQuot ↥R c_r) (Localization.Away (h_xy * g_xy)) q ∈ p.asIdeal := by
              intro q
              change lam_xy (algebraMap (weilNodalQuot ↥R c_r) (Localization.Away h_xy) q) ∈ p.asIdeal ↔ _
              rw [hlam_q]
            rw [hcomap_mem, hcomap_mem]
    obtain ⟨hCharted_tilde, hEZ_eq⟩ :=
      weil_charted_model_closed_fiber_assembly_of_raw_charts K m R hPkg_R hMax_R
        a_opt M_0 g_M0 m_0 F_0 η_M0 φ_KF0 T_0 N' c π hTree i_Z hiZ_nb
        M' M_tilde g'_M f'_M η'_M Z_M' B'_comp hModel'
        g_tilde q_M η_tilde Z_tilde Mod_qM hMod_cl z_new_M E_Z_M j_2
        hContr_model.1
        (by have := hContr_model.2.2.2.2.1; have := hProp_f'; infer_instance)
        hContr_model.2.2.2.1 rfl hη_q hZtilde_all hOpen_j2 hj2_q hPre_compl
        hMod_inter hz_new_cl hz_m0
        hContr_model.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2
        hEZ_cl hEZ_irr hEZ_sub
        (by
          dsimp only
          rw [@Fin.insertNth_apply_same N' (fun _ => Set ↥M_tilde) i_Z E_Z_M _]
          exact hWZ_stalk)
        hBset_cov hBset_disj hBset_hasse hRaw_vert hRaw_bot hRaw_edge
    exact ⟨M_tilde, g_tilde, q_M, η_tilde, Z_tilde, B_tilde,
      Mod_qM, z_new_M, Q₀_R, z₀_M, E_Z_M, hCharted_tilde, hContr_model, hEZ_eq⟩

theorem weil_join_closed_disc_tree_model_and_one_step_blowup (K : Type u) [Field K] [IsSepClosed K]
    (m : ℕ) (R : ValuationSubring K) (hPkg_R : IsValuationRingAlgPackage m R)
    (hMax_R : IsLocalRing.maximalIdeal ↥R ≠ ⊥)
    (a_opt : Option ↥R)
    (M_0 : AlgebraicGeometry.Scheme.{u})
    (g_M0 : M_0 ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
    (m_0 : ↥M_0)
    (F_0 : Type u) [Field F_0]
    (η_M0 : AlgebraicGeometry.Spec (CommRingCat.of F_0) ⟶ M_0)
    (φ_KF0 : K →+* F_0)
    (T_0 : F_0)
    (hStd : IsStandardModelCoordDatum R a_opt M_0 g_M0 m_0 η_M0 φ_KF0 T_0) :
    let s_R := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.maximalIdeal ↥R).ResidueField))
    (∀ (N : ℕ) (c π : Fin N → ↥R),
      IsJoinClosedDiscTree ↥R a_opt c π →
      ∃ (M_T : AlgebraicGeometry.Scheme.{u})
        (g_MT : M_T ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
        (f_MT : M_T ⟶ M_0)
        (η_MT : AlgebraicGeometry.Spec (CommRingCat.of F_0) ⟶ M_T)
        (Z_MT : Set ↥M_0)
        (B_comp : Fin N → Set ↥(CategoryTheory.Limits.pullback g_MT s_R)),
        IsBaseDiscTreeModel R a_opt g_M0 m_0 η_M0 φ_KF0 T_0 c π
          M_T g_MT f_MT η_MT Z_MT B_comp) ∧
    (∀ (N : ℕ) (c π : Fin N → ↥R),
      IsJoinClosedDiscTree ↥R a_opt c π →
      ∀ (i_Z : Fin N),
        ¬ IsDiscBoundaryIdx ↥R a_opt (c i_Z) (π i_Z) →
        let S_nb : Set (Fin N) :=
          {j : Fin N | IsDiscHasseCover ↥R c π i_Z j ∨ IsDiscHasseCover ↥R c π j i_Z}
        1 ≤ S_nb.ncard ∧ S_nb.ncard ≤ 2 →
        ∃ (M_tilde M' : AlgebraicGeometry.Scheme.{u})
          (g_tilde : M_tilde ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
          (g'_M : M' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
          (f'_M : M' ⟶ M_0)
          (q_M : M_tilde ⟶ M')
          (η_tilde : AlgebraicGeometry.Spec (CommRingCat.of F_0) ⟶ M_tilde)
          (Z_tilde : Set ↥M_0)
          (B_tilde : Fin N → Set ↥(CategoryTheory.Limits.pullback g_tilde s_R))
          (Mod_qM : Set ↥M')
          (z_new_M : ↥M')
          (Q₀_R : PrimeSpectrum ↥R)
          (z₀_M : ↥M')
          (E_Z_M : Set ↥M_tilde),
          IsBaseDiscTreeModel R a_opt g_M0 m_0 η_M0 φ_KF0 T_0 c π
            M_tilde g_tilde (q_M ≫ f'_M) η_tilde Z_tilde B_tilde ∧
          IsBaseOneStepContractionModel R g_M0 m_0 (S_nb.ncard = 1)
            M_tilde M' g_tilde g'_M f'_M q_M Mod_qM z_new_M Q₀_R z₀_M E_Z_M ∧
          E_Z_M = (CategoryTheory.Limits.pullback.fst g_tilde s_R).base '' (B_tilde i_Z)) :=
by
  classical
  let s_R := AlgebraicGeometry.Spec.map
    (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.maximalIdeal ↥R).ResidueField))
  dsimp only
  obtain ⟨hGauss, hBase⟩ :=
    weil_gauss_disc_valuation_and_standard_base_tree_model K m R hPkg_R hMax_R
      a_opt M_0 g_M0 m_0 F_0 η_M0 φ_KF0 T_0 hStd
  have hSmBl : HasLocalSmoothLeafBlowup R :=
    weil_local_chart_smooth_leaf_blowup_package K m R hPkg_R hMax_R
  have hNodBl : HasLocalNodalSubdivBlowup R :=
    weil_local_chart_nodal_subdivision_blowup_package K m R hPkg_R hMax_R
  have r_dvd_total : ∀ x y : ↥R, (∃ r : ↥R, x = r * y) ∨ (∃ r : ↥R, y = r * x) := by
    intro x y
    by_cases hy : y = 0
    · right; exact ⟨0, by rw [hy, zero_mul]⟩
    · have hy0 : (y : K) ≠ 0 := fun h => hy (Subtype.ext h)
      rcases ValuationSubring.mem_or_inv_mem R ((x : K) / (y : K)) with hxy | hyx
      · left
        refine ⟨⟨(x : K) / (y : K), hxy⟩, Subtype.ext ?_⟩
        exact (div_mul_cancel₀ (x : K) hy0).symm
      · by_cases hx : x = 0
        · left; exact ⟨0, by rw [hx, zero_mul]⟩
        · have hx0 : (x : K) ≠ 0 := fun h => hx (Subtype.ext h)
          right
          refine ⟨⟨((x : K) / (y : K))⁻¹, hyx⟩, Subtype.ext ?_⟩
          change (y : K) = ((x : K) / (y : K))⁻¹ * (x : K)
          rw [inv_div]
          exact (div_mul_cancel₀ (y : K) hx0).symm
  have disc_le_refl : ∀ c₁ π₁ : ↥R, IsValDiscLE ↥R c₁ π₁ c₁ π₁ := fun c₁ π₁ =>
    ⟨⟨1, (one_mul π₁).symm⟩, ⟨0, by rw [sub_self, zero_mul]⟩⟩
  have disc_le_trans : ∀ {c₁ π₁ c₂ π₂ c₃ π₃ : ↥R},
      IsValDiscLE ↥R c₁ π₁ c₂ π₂ → IsValDiscLE ↥R c₂ π₂ c₃ π₃ →
      IsValDiscLE ↥R c₁ π₁ c₃ π₃ := by
    rintro c₁ π₁ c₂ π₂ c₃ π₃ ⟨⟨r₁, hr₁⟩, ⟨s₁, hs₁⟩⟩ ⟨⟨r₂, hr₂⟩, ⟨s₂, hs₂⟩⟩
    refine ⟨⟨r₁ * r₂, by rw [hr₁, hr₂, mul_assoc]⟩, ⟨s₁ * r₂ + s₂, ?_⟩⟩
    calc c₁ - c₃ = (c₁ - c₂) + (c₂ - c₃) := by ring
      _ = s₁ * (r₂ * π₃) + s₂ * π₃ := by rw [hs₁, hr₂, hs₂]
      _ = (s₁ * r₂ + s₂) * π₃ := by ring
  have disc_eq_refl : ∀ c₁ π₁ : ↥R, IsValDiscEq ↥R c₁ π₁ c₁ π₁ :=
    fun c₁ π₁ => ⟨disc_le_refl c₁ π₁, disc_le_refl c₁ π₁⟩
  have disc_eq_symm : ∀ {c₁ π₁ c₂ π₂ : ↥R},
      IsValDiscEq ↥R c₁ π₁ c₂ π₂ → IsValDiscEq ↥R c₂ π₂ c₁ π₁ :=
    fun h => ⟨h.2, h.1⟩
  have disc_eq_trans : ∀ {c₁ π₁ c₂ π₂ c₃ π₃ : ↥R},
      IsValDiscEq ↥R c₁ π₁ c₂ π₂ → IsValDiscEq ↥R c₂ π₂ c₃ π₃ →
      IsValDiscEq ↥R c₁ π₁ c₃ π₃ :=
    fun h₁ h₂ => ⟨disc_le_trans h₁.1 h₂.1, disc_le_trans h₂.2 h₁.2⟩
  have disc_le_total_above : ∀ {c₀ π₀ c₁ π₁ c₂ π₂ : ↥R},
      IsValDiscLE ↥R c₀ π₀ c₁ π₁ → IsValDiscLE ↥R c₀ π₀ c₂ π₂ →
      IsValDiscLE ↥R c₁ π₁ c₂ π₂ ∨ IsValDiscLE ↥R c₂ π₂ c₁ π₁ := by
    rintro c₀ π₀ c₁ π₁ c₂ π₂ ⟨_, ⟨s₁, hs₁⟩⟩ ⟨_, ⟨s₂, hs₂⟩⟩
    rcases r_dvd_total π₁ π₂ with ⟨r, hr⟩ | ⟨r, hr⟩
    · left
      refine ⟨⟨r, hr⟩, ⟨s₂ - s₁ * r, ?_⟩⟩
      calc c₁ - c₂ = (c₀ - c₂) - (c₀ - c₁) := by ring
        _ = s₂ * π₂ - s₁ * (r * π₂) := by rw [hs₂, hs₁, hr]
        _ = (s₂ - s₁ * r) * π₂ := by ring
    · right
      refine ⟨⟨r, hr⟩, ⟨s₁ - s₂ * r, ?_⟩⟩
      calc c₂ - c₁ = (c₀ - c₁) - (c₀ - c₂) := by ring
        _ = s₁ * π₁ - s₂ * (r * π₁) := by rw [hs₁, hs₂, hr]
        _ = (s₁ - s₂ * r) * π₁ := by ring
  have exists_unique_parent : ∀ {N : ℕ} {c π : Fin N → ↥R},
      IsJoinClosedDiscTree ↥R a_opt c π →
      ∀ (i_Z : Fin N), ¬ IsDiscBoundaryIdx ↥R a_opt (c i_Z) (π i_Z) →
      ∃ i_p : Fin N, IsDiscHasseCover ↥R c π i_p i_Z ∧
        ∀ j : Fin N, IsDiscHasseCover ↥R c π j i_Z → j = i_p := by
    intro N c π hTree i_Z hiZ_nb
    obtain ⟨_, h_anti, ⟨i_top, hc_top, hπ_top⟩, _, _, _⟩ := hTree
    have hiZ_ne_top : i_Z ≠ i_top := by
      rintro rfl
      exact hiZ_nb (Or.inl (by rw [hc_top, hπ_top]; exact disc_eq_refl 0 1))
    have h_le_top : ∀ i : Fin N, IsValDiscLE ↥R (c i) (π i) (c i_top) (π i_top) := fun i => by
      rw [hc_top, hπ_top]
      exact ⟨⟨π i, (mul_one (π i)).symm⟩, ⟨c i, by rw [sub_zero, mul_one]⟩⟩
    let upCard : Fin N → ℕ := fun i =>
      (Finset.univ.filter (fun j => IsValDiscLE ↥R (c i) (π i) (c j) (π j))).card
    have upCard_lt : ∀ {i j : Fin N}, IsValDiscLE ↥R (c i) (π i) (c j) (π j) → i ≠ j →
        upCard j < upCard i := by
      intro i j hij hne
      apply Finset.card_lt_card
      rw [Finset.ssubset_iff_subset_ne]
      refine ⟨fun z hz => ?_, fun heq => ?_⟩
      · simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hz ⊢
        exact disc_le_trans hij hz
      · have hi_in : i ∈ Finset.univ.filter (fun z => IsValDiscLE ↥R (c i) (π i) (c z) (π z)) := by
          simp [disc_le_refl]
        rw [← heq] at hi_in
        simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hi_in
        exact hne (h_anti i j ⟨hij, hi_in⟩)
    let U : Finset (Fin N) := Finset.univ.filter
      (fun j => IsValDiscLE ↥R (c i_Z) (π i_Z) (c j) (π j) ∧ j ≠ i_Z)
    have hU_ne : U.Nonempty := ⟨i_top, by simp [U, h_le_top i_Z, hiZ_ne_top.symm]⟩
    obtain ⟨i_p, hip_U, hip_max⟩ := Finset.exists_max_image U upCard hU_ne
    simp only [U, Finset.mem_filter, Finset.mem_univ, true_and] at hip_U
    have hip_min : ∀ j : Fin N, IsValDiscLE ↥R (c i_Z) (π i_Z) (c j) (π j) → j ≠ i_Z →
        IsValDiscLE ↥R (c i_p) (π i_p) (c j) (π j) := by
      intro j hij hj_ne
      rcases disc_le_total_above hip_U.1 hij with hpj | hjp
      · exact hpj
      · by_cases hjeq : j = i_p
        · subst hjeq; exact disc_le_refl _ _
        · have hj_U : j ∈ U := by simp [U, hij, hj_ne]
          exact absurd (upCard_lt hjp hjeq) (not_lt.mpr (hip_max j hj_U))
    have hip_cov : IsDiscHasseCover ↥R c π i_p i_Z := by
      refine ⟨hip_U.2, hip_U.1, fun k hk1 hk2 => ?_⟩
      by_cases hkeq : k = i_Z
      · exact Or.inl hkeq
      · exact Or.inr (h_anti k i_p ⟨hk2, hip_min k hk1 hkeq⟩)
    refine ⟨i_p, hip_cov, fun j hj_cov => ?_⟩
    rcases hj_cov.2.2 i_p hip_U.1 (hip_min j hj_cov.2.1 hj_cov.1) with h1 | h2
    · exact absurd h1 hip_U.2
    · exact h2.symm
  have exists_child_above : ∀ {N : ℕ} {c π : Fin N → ↥R},
      IsJoinClosedDiscTree ↥R a_opt c π →
      ∀ {x i_Z : Fin N}, IsValDiscLE ↥R (c x) (π x) (c i_Z) (π i_Z) → x ≠ i_Z →
      ∃ u : Fin N, IsValDiscLE ↥R (c x) (π x) (c u) (π u) ∧ IsDiscHasseCover ↥R c π i_Z u := by
    intro N c π hTree x i_Z hx_le hx_ne
    let downCard : Fin N → ℕ := fun i =>
      (Finset.univ.filter (fun j => IsValDiscLE ↥R (c j) (π j) (c i) (π i))).card
    have downCard_lt : ∀ {i j : Fin N}, IsValDiscLE ↥R (c i) (π i) (c j) (π j) → i ≠ j →
        downCard i < downCard j := by
      intro i j hij hne
      apply Finset.card_lt_card
      rw [Finset.ssubset_iff_subset_ne]
      refine ⟨fun z hz => ?_, fun heq => ?_⟩
      · simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hz ⊢
        exact disc_le_trans hz hij
      · have hj_in : j ∈ Finset.univ.filter (fun z => IsValDiscLE ↥R (c z) (π z) (c j) (π j)) := by
          simp [disc_le_refl]
        rw [← heq] at hj_in
        simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hj_in
        exact hne (hTree.2.1 i j ⟨hij, hj_in⟩)
    let D : Finset (Fin N) := Finset.univ.filter (fun u =>
      IsValDiscLE ↥R (c x) (π x) (c u) (π u) ∧
      IsValDiscLE ↥R (c u) (π u) (c i_Z) (π i_Z) ∧ u ≠ i_Z)
    have hD_ne : D.Nonempty := ⟨x, by simp [D, disc_le_refl, hx_le, hx_ne]⟩
    obtain ⟨u, hu_D, hu_max⟩ := Finset.exists_max_image D downCard hD_ne
    simp only [D, Finset.mem_filter, Finset.mem_univ, true_and] at hu_D
    refine ⟨u, hu_D.1, hu_D.2.2.symm, hu_D.2.1, fun k hk1 hk2 => ?_⟩
    by_cases hkeq : k = i_Z
    · exact Or.inr hkeq
    · by_cases huk : k = u
      · exact Or.inl huk
      · have hk_D : k ∈ D := by simp [D, disc_le_trans hu_D.1 hk1, hk2, hkeq]
        exact absurd (downCard_lt hk1 (Ne.symm huk)) (not_lt.mpr (hu_max k hk_D))
  have tree_delete : ∀ {N' : ℕ} {c π : Fin (N' + 1) → ↥R},
      IsJoinClosedDiscTree ↥R a_opt c π →
      ∀ (i_Z : Fin (N' + 1)), ¬ IsDiscBoundaryIdx ↥R a_opt (c i_Z) (π i_Z) →
      {j : Fin (N' + 1) | IsDiscHasseCover ↥R c π i_Z j ∨ IsDiscHasseCover ↥R c π j i_Z}.ncard ≤ 2 →
      IsJoinClosedDiscTree ↥R a_opt (c ∘ i_Z.succAbove) (π ∘ i_Z.succAbove) := by
    intro N' c π hTree i_Z hiZ_nb hDeg
    obtain ⟨i_p, hip_cov, _⟩ := exists_unique_parent hTree i_Z hiZ_nb
    obtain ⟨hπ_ne, h_anti, ⟨i_top, hc_top, hπ_top⟩, h_bot, h_mR, h_join⟩ := hTree
    let S_nb : Set (Fin (N' + 1)) :=
      {j : Fin (N' + 1) | IsDiscHasseCover ↥R c π i_Z j ∨ IsDiscHasseCover ↥R c π j i_Z}
    have hChild_sub : ∀ u₁ u₂ : Fin (N' + 1),
        IsDiscHasseCover ↥R c π i_Z u₁ → IsDiscHasseCover ↥R c π i_Z u₂ → u₁ = u₂ := by
      intro u₁ u₂ hu₁ hu₂
      by_contra hne12
      have hu1_ne_p : u₁ ≠ i_p := fun heq => by
        subst heq
        exact hu₁.1 (h_anti i_Z u₁ ⟨hip_cov.2.1, hu₁.2.1⟩)
      have hu2_ne_p : u₂ ≠ i_p := fun heq => by
        subst heq
        exact hu₂.1 (h_anti i_Z u₂ ⟨hip_cov.2.1, hu₂.2.1⟩)
      have hsub : ({u₁, u₂, i_p} : Set (Fin (N' + 1))) ⊆ S_nb := by
        intro z hz
        simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
        rcases hz with rfl | rfl | rfl
        · exact Or.inl hu₁
        · exact Or.inl hu₂
        · exact Or.inr hip_cov
      have hcard3 : ({u₁, u₂, i_p} : Set (Fin (N' + 1))).ncard = 3 := by
        have h1 : u₁ ∉ ({u₂, i_p} : Set (Fin (N' + 1))) := by simp [hne12, hu1_ne_p]
        have h2 : u₂ ∉ ({i_p} : Set (Fin (N' + 1))) := by simp [hu2_ne_p]
        rw [Set.ncard_insert_of_notMem h1, Set.ncard_insert_of_notMem h2, Set.ncard_singleton]
      have hle : ({u₁, u₂, i_p} : Set (Fin (N' + 1))).ncard ≤ S_nb.ncard :=
        Set.ncard_le_ncard hsub
      dsimp only [S_nb] at hle
      omega
    refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
    · intro x'
      exact hπ_ne (i_Z.succAbove x')
    · intro x' y' hxy
      exact Fin.succAbove_right_injective (h_anti _ _ hxy)
    · have htop_ne : i_top ≠ i_Z := by
        rintro rfl
        exact hiZ_nb (Or.inl (by rw [hc_top, hπ_top]; exact disc_eq_refl 0 1))
      obtain ⟨i'_top, hi'_top⟩ := Fin.exists_succAbove_eq htop_ne
      exact ⟨i'_top, by simp [Function.comp, hi'_top, hc_top, hπ_top]⟩
    · intro a₀ ha
      obtain ⟨ha0_ne, ha0_mem, ⟨i_bot, hc_bot, hπ_bot⟩, h_min_bot⟩ := h_bot a₀ ha
      have hbot_ne : i_bot ≠ i_Z := by
        rintro rfl
        exact hiZ_nb (Or.inr ⟨a₀, ha, by rw [hc_bot, hπ_bot]; exact disc_eq_refl 0 a₀⟩)
      obtain ⟨i'_bot, hi'_bot⟩ := Fin.exists_succAbove_eq hbot_ne
      refine ⟨ha0_ne, ha0_mem, ⟨i'_bot, by simp [Function.comp, hi'_bot, hc_bot, hπ_bot]⟩, ?_⟩
      intro x' hx'
      exact h_min_bot (i_Z.succAbove x') hx'
    · intro x' hx'
      exact h_mR (i_Z.succAbove x') hx'
    · intro x' y'
      let x := i_Z.succAbove x'
      let y := i_Z.succAbove y'
      obtain ⟨k, hxk, hyk, hk_lub⟩ := h_join x y
      have hk_ne : k ≠ i_Z := by
        intro hk_eq
        rw [hk_eq] at hxk hyk hk_lub
        have hx_ne : x ≠ i_Z := Fin.succAbove_ne i_Z x'
        have hy_ne : y ≠ i_Z := Fin.succAbove_ne i_Z y'
        obtain ⟨u_x, hx_ux, hux_cov⟩ := exists_child_above ⟨hπ_ne, h_anti, ⟨i_top, hc_top, hπ_top⟩,
          h_bot, h_mR, h_join⟩ hxk hx_ne
        obtain ⟨u_y, hy_uy, huy_cov⟩ := exists_child_above ⟨hπ_ne, h_anti, ⟨i_top, hc_top, hπ_top⟩,
          h_bot, h_mR, h_join⟩ hyk hy_ne
        have hu_eq : u_x = u_y := hChild_sub u_x u_y hux_cov huy_cov
        rw [← hu_eq] at hy_uy
        have hk_ux : IsValDiscLE ↥R (c i_Z) (π i_Z) (c u_x) (π u_x) :=
          hk_lub (c u_x) (π u_x) (hπ_ne u_x) hx_ux hy_uy
        exact hux_cov.1 (h_anti i_Z u_x ⟨hk_ux, hux_cov.2.1⟩)
      obtain ⟨k', hk'⟩ := Fin.exists_succAbove_eq hk_ne
      refine ⟨k', ?_, ?_, ?_⟩
      · simpa [Function.comp, hk'] using hxk
      · simpa [Function.comp, hk'] using hyk
      · intro c_u π_u hπu hxu hyu
        simpa [Function.comp, hk'] using hk_lub c_u π_u hπu hxu hyu
  have exists_min_nonbd_deg12 : ∀ {N : ℕ} {c π : Fin N → ↥R},
      IsJoinClosedDiscTree ↥R a_opt c π →
      (Finset.univ.filter (fun i : Fin N => ¬ IsDiscBoundaryIdx ↥R a_opt (c i) (π i))).Nonempty →
      ∃ i_min : Fin N,
        ¬ IsDiscBoundaryIdx ↥R a_opt (c i_min) (π i_min) ∧
        1 ≤ {j : Fin N | IsDiscHasseCover ↥R c π i_min j ∨ IsDiscHasseCover ↥R c π j i_min}.ncard ∧
        {j : Fin N | IsDiscHasseCover ↥R c π i_min j ∨ IsDiscHasseCover ↥R c π j i_min}.ncard ≤ 2 := by
    intro N c π hTree hNonbd
    let Nonbd : Finset (Fin N) :=
      Finset.univ.filter (fun i : Fin N => ¬ IsDiscBoundaryIdx ↥R a_opt (c i) (π i))
    let downCard : Fin N → ℕ := fun i =>
      (Finset.univ.filter (fun j => IsValDiscLE ↥R (c j) (π j) (c i) (π i))).card
    have downCard_lt : ∀ {i j : Fin N}, IsValDiscLE ↥R (c i) (π i) (c j) (π j) → i ≠ j →
        downCard i < downCard j := by
      intro i j hij hne
      apply Finset.card_lt_card
      rw [Finset.ssubset_iff_subset_ne]
      refine ⟨fun z hz => ?_, fun heq => ?_⟩
      · simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hz ⊢
        exact disc_le_trans hz hij
      · have hj_in : j ∈ Finset.univ.filter (fun z => IsValDiscLE ↥R (c z) (π z) (c j) (π j)) := by
          simp [disc_le_refl]
        rw [← heq] at hj_in
        simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hj_in
        exact hne (hTree.2.1 i j ⟨hij, hj_in⟩)
    obtain ⟨i_min, hi_min_mem, hi_min_le⟩ := Finset.exists_min_image Nonbd downCard hNonbd
    have hi_min_nb : ¬ IsDiscBoundaryIdx ↥R a_opt (c i_min) (π i_min) :=
      (Finset.mem_filter.mp hi_min_mem).2
    obtain ⟨i_p, hip_cov, hip_uniq⟩ := exists_unique_parent hTree i_min hi_min_nb
    obtain ⟨_, h_anti, ⟨i_top, hc_top, hπ_top⟩, _, _, _⟩ := hTree
    have h_le_top : ∀ i : Fin N, IsValDiscLE ↥R (c i) (π i) (c i_top) (π i_top) := fun i => by
      rw [hc_top, hπ_top]
      exact ⟨⟨π i, (mul_one (π i)).symm⟩, ⟨c i, by rw [sub_zero, mul_one]⟩⟩
    let S_nb : Set (Fin N) :=
      {j : Fin N | IsDiscHasseCover ↥R c π i_min j ∨ IsDiscHasseCover ↥R c π j i_min}
    have hlo : 1 ≤ S_nb.ncard := by
      have hp_mem : i_p ∈ S_nb := Or.inr hip_cov
      have h1 : ({i_p} : Set (Fin N)) ⊆ S_nb := Set.singleton_subset_iff.mpr hp_mem
      have hle := Set.ncard_le_ncard h1
      rwa [Set.ncard_singleton] at hle
    have hChild_uniq : ∀ u₁ u₂ : Fin N,
        IsDiscHasseCover ↥R c π i_min u₁ → IsDiscHasseCover ↥R c π i_min u₂ → u₁ = u₂ := by
      have hChild_bot : ∀ u : Fin N, IsDiscHasseCover ↥R c π i_min u →
          ∃ a₀ : ↥R, a_opt = some a₀ ∧ IsValDiscEq ↥R (c u) (π u) 0 a₀ := by
        intro u hu_cov
        have hu_bd : IsDiscBoundaryIdx ↥R a_opt (c u) (π u) := by
          by_contra hu_nb
          have hu_in : u ∈ Nonbd := by simp [Nonbd, hu_nb]
          exact absurd (downCard_lt hu_cov.2.1 hu_cov.1.symm) (not_lt.mpr (hi_min_le u hu_in))
        rcases hu_bd with hu_top | hu_bot
        · exfalso
          have hu_eq_top : u = i_top :=
            h_anti u i_top (disc_eq_trans hu_top (by rw [hc_top, hπ_top]; exact disc_eq_refl 0 1))
          rw [hu_eq_top] at hu_cov
          exact hu_cov.1 (h_anti i_min i_top ⟨h_le_top i_min, hu_cov.2.1⟩)
        · exact hu_bot
      intro u₁ u₂ hu₁ hu₂
      obtain ⟨a₁, ha₁, heq₁⟩ := hChild_bot u₁ hu₁
      obtain ⟨a₂, ha₂, heq₂⟩ := hChild_bot u₂ hu₂
      rw [ha₁] at ha₂
      injection ha₂ with ha_eq
      subst ha_eq
      exact h_anti u₁ u₂ (disc_eq_trans heq₁ (disc_eq_symm heq₂))
    have hhi : S_nb.ncard ≤ 2 := by
      by_cases hex : ∃ u : Fin N, IsDiscHasseCover ↥R c π i_min u
      · obtain ⟨u₀, hu₀⟩ := hex
        have hsub : S_nb ⊆ ({i_p, u₀} : Set (Fin N)) := by
          intro j hj
          rcases hj with hj_ch | hj_par
          · exact Set.mem_insert_of_mem i_p (Set.mem_singleton_iff.mpr (hChild_uniq j u₀ hj_ch hu₀))
          · exact Set.mem_insert_iff.mpr (Or.inl (hip_uniq j hj_par))
        calc S_nb.ncard ≤ ({i_p, u₀} : Set (Fin N)).ncard := Set.ncard_le_ncard hsub
          _ ≤ ({u₀} : Set (Fin N)).ncard + 1 := Set.ncard_insert_le i_p {u₀}
          _ = 2 := by rw [Set.ncard_singleton]
      · have hsub : S_nb ⊆ ({i_p} : Set (Fin N)) := by
          intro j hj
          rcases hj with hj_ch | hj_par
          · exact absurd ⟨j, hj_ch⟩ hex
          · exact Set.mem_singleton_iff.mpr (hip_uniq j hj_par)
        calc S_nb.ncard ≤ ({i_p} : Set (Fin N)).ncard := Set.ncard_le_ncard hsub
          _ = 1 := Set.ncard_singleton i_p
          _ ≤ 2 := by omega
    exact ⟨i_min, hi_min_nb, hlo, hhi⟩
  have hChartedAll : ∀ (k : ℕ) (N : ℕ) (c π : Fin N → ↥R),
      IsJoinClosedDiscTree ↥R a_opt c π →
      (Finset.univ.filter (fun i : Fin N => ¬ IsDiscBoundaryIdx ↥R a_opt (c i) (π i))).card = k →
      ∃ (M_T : AlgebraicGeometry.Scheme.{u})
        (g_MT : M_T ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
        (f_MT : M_T ⟶ M_0)
        (η_MT : AlgebraicGeometry.Spec (CommRingCat.of F_0) ⟶ M_T)
        (Z_MT : Set ↥M_0)
        (B_comp : Fin N → Set ↥(CategoryTheory.Limits.pullback g_MT s_R)),
        IsChartedBaseDiscTreeModel R a_opt g_M0 m_0 η_M0 φ_KF0 T_0 c π
          M_T g_MT f_MT η_MT Z_MT B_comp := by
    intro k
    induction k with
    | zero =>
      intro N c π hTree hk
      have hAllBd : ∀ i : Fin N, IsDiscBoundaryIdx ↥R a_opt (c i) (π i) := by
        intro i
        by_contra hnb
        have hi : i ∈ Finset.univ.filter (fun j : Fin N => ¬ IsDiscBoundaryIdx ↥R a_opt (c j) (π j)) :=
          by simp [hnb]
        rw [Finset.card_eq_zero.mp hk] at hi
        exact Finset.notMem_empty i hi
      obtain ⟨B_0, hCharted0⟩ := hBase N c π hTree hAllBd
      exact ⟨M_0, g_M0, 𝟙 M_0, η_M0, ∅, B_0, hCharted0⟩
    | succ k ih =>
      intro N c π hTree hk
      let Nonbd : Finset (Fin N) :=
        Finset.univ.filter (fun i : Fin N => ¬ IsDiscBoundaryIdx ↥R a_opt (c i) (π i))
      have hNonbd : Nonbd.Nonempty := Finset.card_pos.mp (by dsimp [Nonbd]; omega)
      obtain ⟨i_min, hi_min_nb, hlo, hhi⟩ := exists_min_nonbd_deg12 hTree hNonbd
      cases N with
      | zero => exact Fin.elim0 i_min
      | succ N' =>
        have hTree' : IsJoinClosedDiscTree ↥R a_opt (c ∘ i_min.succAbove) (π ∘ i_min.succAbove) :=
          tree_delete hTree i_min hi_min_nb hhi
        let Nonbd' : Finset (Fin N') := Finset.univ.filter
          (fun x' : Fin N' => ¬ IsDiscBoundaryIdx ↥R a_opt
            (c (i_min.succAbove x')) (π (i_min.succAbove x')))
        have hmap_eq : Nonbd'.map ⟨i_min.succAbove, Fin.succAbove_right_injective⟩ =
            Nonbd.erase i_min := by
          ext x
          simp only [Nonbd', Nonbd, Finset.mem_map, Function.Embedding.coeFn_mk,
            Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_erase]
          constructor
          · rintro ⟨x', hx'_nb, rfl⟩
            exact ⟨Fin.succAbove_ne i_min x', hx'_nb⟩
          · rintro ⟨hx_ne, hx_nb⟩
            obtain ⟨x', hx'⟩ := Fin.exists_succAbove_eq hx_ne
            exact ⟨x', by rwa [hx'], hx'⟩
        have hk' : Nonbd'.card = k := by
          have h1 : Nonbd'.card = (Nonbd.erase i_min).card := by
            rw [← hmap_eq, Finset.card_map]
          have hi_in : i_min ∈ Nonbd := by simp [Nonbd, hi_min_nb]
          have h2 : (Nonbd.erase i_min).card + 1 = Nonbd.card := Finset.card_erase_add_one hi_in
          rw [← h1] at h2
          dsimp only [Nonbd] at h2
          rw [hk] at h2
          exact Nat.succ.inj h2
        obtain ⟨M', g'_M, f'_M, η'_M, Z_M', B'_comp, hModel'⟩ :=
          ih N' (c ∘ i_min.succAbove) (π ∘ i_min.succAbove) hTree' hk'
        obtain ⟨M_tilde, g_tilde, q_M, η_tilde, Z_tilde, B_tilde, _, _, _, _, _,
          hCharted_tilde, _, _⟩ :=
          weil_charted_disc_tree_one_step_insertion K m R hPkg_R hMax_R
            a_opt M_0 g_M0 m_0 F_0 η_M0 φ_KF0 T_0 hStd hGauss hSmBl hNodBl
            N' c π hTree i_min hi_min_nb hlo hhi hTree'
            M' g'_M f'_M η'_M Z_M' B'_comp hModel'
        exact ⟨M_tilde, g_tilde, q_M ≫ f'_M, η_tilde, Z_tilde, B_tilde, hCharted_tilde⟩
  refine ⟨?_, ?_⟩
  · intro N c π hTree
    obtain ⟨M_T, g_MT, f_MT, η_MT, Z_MT, B_comp, hCharted⟩ :=
      hChartedAll _ N c π hTree rfl
    exact ⟨M_T, g_MT, f_MT, η_MT, Z_MT, B_comp, hCharted.1⟩
  · intro N c π hTree i_Z hiZ_nb hBounds
    cases N with
    | zero => exact Fin.elim0 i_Z
    | succ N' =>
      have hTree' : IsJoinClosedDiscTree ↥R a_opt (c ∘ i_Z.succAbove) (π ∘ i_Z.succAbove) :=
        tree_delete hTree i_Z hiZ_nb hBounds.2
      obtain ⟨M', g'_M, f'_M, η'_M, Z_M', B'_comp, hModel'⟩ :=
        hChartedAll _ N' (c ∘ i_Z.succAbove) (π ∘ i_Z.succAbove) hTree' rfl
      obtain ⟨M_tilde, g_tilde, q_M, η_tilde, Z_tilde, B_tilde,
        Mod_qM, z_new_M, Q₀_R, z₀_M, E_Z_M, hCharted_tilde, hContr, hEZ⟩ :=
        weil_charted_disc_tree_one_step_insertion K m R hPkg_R hMax_R
          a_opt M_0 g_M0 m_0 F_0 η_M0 φ_KF0 T_0 hStd hGauss hSmBl hNodBl
          N' c π hTree i_Z hiZ_nb hBounds.1 hBounds.2 hTree'
          M' g'_M f'_M η'_M Z_M' B'_comp hModel'
      exact ⟨M_tilde, M', g_tilde, g'_M, f'_M, q_M, η_tilde, Z_tilde, B_tilde,
        Mod_qM, z_new_M, Q₀_R, z₀_M, E_Z_M, hCharted_tilde.1, hContr, hEZ⟩

theorem weil_etale_disc_and_stalk_valuation_transfer (K : Type u) [Field K]
    (m : ℕ) (R : ValuationSubring K)
    (hPkg_R : IsValuationRingAlgPackage m R)
    (hMax_R : IsLocalRing.maximalIdeal ↥R ≠ ⊥)
    (a_opt : Option ↥R)
    (M_0 W_B_sch : AlgebraicGeometry.Scheme.{u})
    (g_M0 : M_0 ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
    (g_WB : W_B_sch ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
    (m_0 : ↥M_0) (u₀_WB : ↥W_B_sch)
    (e_0 : W_B_sch ⟶ M_0)
    (F_0 F_WB : Type u) [Field F_0] [Field F_WB]
    (η_M0 : AlgebraicGeometry.Spec (CommRingCat.of F_0) ⟶ M_0)
    (η_WB : AlgebraicGeometry.Spec (CommRingCat.of F_WB) ⟶ W_B_sch)
    (φ_KF0 : K →+* F_0) (φ_F0_FWB : F_0 →+* F_WB)
    (T_0 : F_0)
    (hAff_WB : AlgebraicGeometry.IsAffine W_B_sch)
    (hInt_WB : AlgebraicGeometry.IsIntegral W_B_sch)
    (hStd : IsStandardModelCoordDatum R a_opt M_0 g_M0 m_0 η_M0 φ_KF0 T_0)
    (hFunc_WB : IsSchemeFunctionField W_B_sch F_WB η_WB)
    (hEt_e0 : AlgebraicGeometry.Etale e_0)
    (he0_comm : e_0 ≫ g_M0 = g_WB)
    (hη_e0 : η_WB ≫ e_0 = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_F0_FWB) ≫ η_M0)
    (he0_m0 : e_0.base ⁻¹' {m_0} = {u₀_WB})
    (M_T : AlgebraicGeometry.Scheme.{u})
    (g_MT : M_T ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
    (f_MT : M_T ⟶ M_0)
    (η_MT : AlgebraicGeometry.Spec (CommRingCat.of F_0) ⟶ M_T)
    (hfMT_g : f_MT ≫ g_M0 = g_MT)
    (hη_MT : η_MT ≫ f_MT = η_M0)
    (hη_comm : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_F0_FWB) ≫ η_MT) ≫ f_MT =
      η_WB ≫ e_0)
    (hπR_comm : (CategoryTheory.Limits.pullback.snd f_MT e_0 ≫ g_WB) ≫ 𝟙 _ =
      CategoryTheory.Limits.pullback.fst f_MT e_0 ≫ g_MT) :
    let s_R := AlgebraicGeometry.Spec.map (CommRingCat.ofHom
      (algebraMap ↥R (IsLocalRing.maximalIdeal ↥R).ResidueField))
    let X_T := CategoryTheory.Limits.pullback f_MT e_0
    let π_MT := CategoryTheory.Limits.pullback.fst f_MT e_0
    let f_XT := CategoryTheory.Limits.pullback.snd f_MT e_0
    let g_XT := f_XT ≫ g_WB
    let η_XT : AlgebraicGeometry.Spec (CommRingCat.of F_WB) ⟶ X_T :=
      CategoryTheory.Limits.pullback.lift
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_F0_FWB) ≫ η_MT) η_WB hη_comm
    let π_R : CategoryTheory.Limits.pullback g_XT s_R ⟶
        CategoryTheory.Limits.pullback g_MT s_R :=
      CategoryTheory.Limits.pullback.map g_XT s_R g_MT s_R π_MT (𝟙 _) (𝟙 _) hπR_comm
        ((CategoryTheory.Category.comp_id s_R).trans (CategoryTheory.Category.id_comp s_R).symm)
    ∀ (B_i : Set ↥(CategoryTheory.Limits.pullback g_MT s_R))
      (c_d π_d : ↥R) (W_0 : ValuationSubring F_0),
      (∀ q ∈ B_i, f_MT.base ((CategoryTheory.Limits.pullback.fst g_MT s_R).base q) = m_0) →
      IsComponentStalkVal R g_MT η_MT B_i W_0 →
      IsDiscValuationOnWB R m_0 η_M0 φ_KF0 T_0 c_d π_d W_0 →
      ∃ W_i : ValuationSubring F_WB,
        IsComponentStalkVal R g_XT η_XT (π_R.base ⁻¹' B_i) W_i ∧
        IsDiscValuationOnWB R u₀_WB η_WB (φ_F0_FWB.comp φ_KF0) (φ_F0_FWB T_0) c_d π_d W_i :=
by
  have h_s1 :
      ∃ (A_0 B_WB : Type u) (_ : CommRing A_0) (_ : IsDomain A_0) (_ : CommRing B_WB)
        (iso_M0 : M_0 ≅ AlgebraicGeometry.Spec (CommRingCat.of A_0))
        (iso_WB : W_B_sch ≅ AlgebraicGeometry.Spec (CommRingCat.of B_WB))
        (φ_A0 : A_0 →+* F_0) (φ_B : B_WB →+* F_WB) (α_0 : A_0 →+* B_WB),
        @IsFractionRing A_0 _ F_0 _ φ_A0.toAlgebra ∧
        Function.Injective φ_B ∧
        @Module.Flat A_0 B_WB _ _ α_0.toAlgebra.toModule ∧
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_A0) ≫ iso_M0.inv = η_M0 ∧
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_B) ≫ iso_WB.inv = η_WB ∧
        iso_WB.inv ≫ e_0 ≫ iso_M0.hom = AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_0) ∧
        φ_B.comp α_0 = φ_F0_FWB.comp φ_A0 ∧
        Ideal.comap α_0 (iso_WB.hom.base u₀_WB).asIdeal = (iso_M0.hom.base m_0).asIdeal ∧
