    exact (AlgebraicGeometry.isIntegral_iff_irreducibleSpace_and_isReduced Γ).mpr ⟨hIrredΓ, hRedΓ⟩
  have _ : AlgebraicGeometry.IsIntegral Γ := hIntΓ
  
  have hFunc_Γ : IsSchemeFunctionField Γ F η_Γ := by
    have hLift_aff : ∀ (U : Γ.Opens) (hU : AlgebraicGeometry.IsAffineOpen U),
