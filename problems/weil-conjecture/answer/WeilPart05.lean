    have hL1_Φ1 :
        ((j_1.comp α_1).comp (Ideal.Quotient.mk (weilNodalIdeal R₀ b'))).comp Φ_1 =
          MvPolynomial.eval₂Hom ι_L1 ![ι_L1 π_tilde * j_1 g_1, j_1 v_1] := by
      apply MvPolynomial.ringHom_ext'
      · ext r; simp [Φ_1, ι_L1]
