              have hψo_d : ψ_o d ∉ q.asIdeal := by
                have hpq : p_bl.base (ι_o.base q) = PrimeSpectrum.comap ψ_o q := by
                  change (ι_o ≫ p_bl).base q = (Spec.map (CommRingCat.ofHom ψ_o)).base q
                  rw [hιo_p]
                rwa [hpq] at hd_notMem
              exact (hRange_o q).mpr (hExcl_o q hψo_d)
          obtain ⟨p, hp⟩ := hy_in_m
          rw [← hp] at hd_notMem ⊢
          have hψm_d : p ∈ (PrimeSpectrum.basicOpen (ψ_m d) : Set (PrimeSpectrum C_m)) := by
            have hpp : p_bl.base (ι_m.base p) = PrimeSpectrum.comap ψ_m p := by
              change (ι_m ≫ p_bl).base p = (Spec.map (CommRingCat.ofHom ψ_m)).base p
              rw [hιm_p]
            rwa [hpp] at hd_notMem
          rw [← hRange_jm] at hψm_d
          obtain ⟨r, rfl⟩ := hψm_d
          exact ⟨r, rfl⟩
        · rintro ⟨r, rfl⟩
          have hpr : p_bl.base (u_d.base r) ∈ (PrimeSpectrum.basicOpen d : Set (PrimeSpectrum B)) := by
            have h1 : p_bl.base (u_d.base r) = j_B.base (θ_d.base r) := by
              change (u_d ≫ p_bl).base r = (θ_d ≫ j_B).base r
              rw [hu_p]
            rw [h1, ← hRange_jB]
            exact ⟨θ_d.base r, rfl⟩
          have hur_V : u_d.base r ∈ Set.range V_compl.ι.base := by
            rw [V_compl.range_ι]
            exact hd_sub hpr
          obtain ⟨y', hy'⟩ := hur_V
          refine ⟨y', ?_, hy'⟩
          have h1 : (f_compl ≫ U_compl.ι).base y' = (V_compl.ι ≫ p_bl).base y' :=
            congrArg (fun g => g.base y') (morphismRestrict_ι p_bl U_compl)
          change (f_compl ≫ U_compl.ι).base y' ∈ (PrimeSpectrum.basicOpen d : Set (PrimeSpectrum B))
          rw [h1]
          change p_bl.base (V_compl.ι.base y') ∈ (PrimeSpectrum.basicOpen d : Set (PrimeSpectrum B))
          rwa [hy']
      let α_d : V_d.toScheme ≅ Spec (CommRingCat.of L_m) :=
        IsOpenImmersion.isoOfRangeEq (V_d.ι ≫ V_compl.ι) u_d hRange_V
      have hα_fac : α_d.hom ≫ u_d = V_d.ι ≫ V_compl.ι :=
        IsOpenImmersion.isoOfRangeEq_hom_fac (V_d.ι ≫ V_compl.ι) u_d hRange_V
      have hf_eq : f_compl ∣_ W_d = α_d.hom ≫ θ_d ≫ β_d.hom := by
        rw [← cancel_mono (W_d.ι ≫ U_compl.ι)]
        calc (f_compl ∣_ W_d) ≫ W_d.ι ≫ U_compl.ι
            = ((f_compl ∣_ W_d) ≫ W_d.ι) ≫ U_compl.ι := (Category.assoc _ _ _).symm
          _ = (V_d.ι ≫ f_compl) ≫ U_compl.ι := by rw [morphismRestrict_ι]
          _ = V_d.ι ≫ (f_compl ≫ U_compl.ι) := Category.assoc _ _ _
          _ = V_d.ι ≫ (V_compl.ι ≫ p_bl) := by rw [morphismRestrict_ι]
          _ = (V_d.ι ≫ V_compl.ι) ≫ p_bl := (Category.assoc _ _ _).symm
          _ = (α_d.hom ≫ u_d) ≫ p_bl := by rw [hα_fac]
          _ = α_d.hom ≫ (u_d ≫ p_bl) := Category.assoc _ _ _
          _ = α_d.hom ≫ (θ_d ≫ j_B) := by rw [hu_p]
          _ = α_d.hom ≫ θ_d ≫ (β_d.hom ≫ W_d.ι ≫ U_compl.ι) := by rw [hβ_fac]
          _ = (α_d.hom ≫ θ_d ≫ β_d.hom) ≫ W_d.ι ≫ U_compl.ι := by simp only [Category.assoc]
      rw [hf_eq]
      infer_instance
    let d_vec : Fin 4 → B := ![d₀, d₁, d₂, d₃]
    let W_cov : Fin 4 → U_compl.toScheme.Opens :=
      fun i => (TopologicalSpace.Opens.map U_compl.ι.base).obj (PrimeSpectrum.basicOpen (d_vec i))
    have hd_sub : ∀ i : Fin 4,
        (PrimeSpectrum.basicOpen (d_vec i) : Set (PrimeSpectrum B)) ⊆ M_clᶜ := by
      intro i p hp hpM
      rw [hM_eq, PrimeSpectrum.mem_zeroLocus] at hpM
      apply hp
      apply hpM
      fin_cases i <;> simp [d_vec]
    have hW_sup : iSup W_cov = ⊤ := by
      rw [eq_top_iff]
      intro x _
      rw [TopologicalSpace.Opens.mem_iSup]
      have hx_mem : U_compl.ι.base x ∈ M_clᶜ := by
        have h1 : U_compl.ι.base x ∈ Set.range U_compl.ι.base := ⟨x, rfl⟩
        rwa [U_compl.range_ι] at h1
      let px : PrimeSpectrum B := U_compl.ι.base x
      have hx_not : px ∉ PrimeSpectrum.zeroLocus ({d₀, d₁, d₂, d₃} : Set B) := by
        rw [← hM_eq]
        exact hx_mem
      rw [PrimeSpectrum.mem_zeroLocus] at hx_not
      by_contra! hall
      apply hx_not
      rintro b (rfl | rfl | rfl | rfl)
      · by_contra hb; exact hall 0 hb
      · by_contra hb; exact hall 1 hb
      · by_contra hb; exact hall 2 hb
      · by_contra hb; exact hall 3 hb
    refine IsZariskiLocalAtTarget.of_iSup_eq_top
      (P := CategoryTheory.MorphismProperty.isomorphisms Scheme.{u}) W_cov hW_sup ?_
    intro i
    fin_cases i
    · exact hHelper C₀ C₁ ψ₀ ψ₁ g₁ ι_0 ι_1 hCov hRange₁ hι0_p hι1_p d₀ (hd_sub 0) hOpen₀.1 hOpen₀.2
    · exact hHelper C₁ C₀ ψ₁ ψ₀ g₀ ι_1 ι_0 (Set.union_comm _ _ ▸ hCov) hRange₀ hι1_p hι0_p d₁ (hd_sub 1) hOpen₁.1 hOpen₁.2
    · exact hHelper C₁ C₀ ψ₁ ψ₀ g₀ ι_1 ι_0 (Set.union_comm _ _ ▸ hCov) hRange₀ hι1_p hι0_p d₂ (hd_sub 2) hOpen₂.1 hOpen₂.2
    · exact hHelper C₀ C₁ ψ₀ ψ₁ g₁ ι_0 ι_1 hCov hRange₁ hι0_p hι1_p d₃ (hd_sub 3) hOpen₃.1 hOpen₃.2
  
  exact ⟨U_bl, p_bl, ι_0, ι_1, hOpen_ι0, hOpen_ι1, hCov, hGlue, hRange₀, hRange₁,
    hι0_p, hι1_p, hProp, hIso, hInt_of, hFlat_of, hLfp_of⟩

theorem weil_nodal_subdiv_prime_ideals_and_section_kernels (R₀ : Type u) [CommRing R₀] [IsLocalRing R₀] (π_tilde b' : R₀)
    (hπ_mem : π_tilde ∈ IsLocalRing.maximalIdeal R₀)
    (hb'_mem : b' ∈ IsLocalRing.maximalIdeal R₀)
    (P_h : MvPolynomial (Fin 2) R₀)
    (h_e : weilNodalQuot R₀ (b' * π_tilde))
    (h_0 : weilNodalQuot R₀ π_tilde)
    (h_1 : weilNodalQuot R₀ b')
    (h_01 : Polynomial R₀)
    (hh_e_eq : h_e = Ideal.Quotient.mk (weilNodalIdeal R₀ (b' * π_tilde)) P_h)
    (hh_0_eq : h_0 = Ideal.Quotient.mk (weilNodalIdeal R₀ π_tilde)
      (MvPolynomial.eval₂Hom MvPolynomial.C
        ![MvPolynomial.X 0, MvPolynomial.C b' * MvPolynomial.X 1] P_h))
    (hh_1_eq : h_1 = Ideal.Quotient.mk (weilNodalIdeal R₀ b')
      (MvPolynomial.eval₂Hom MvPolynomial.C
        ![MvPolynomial.C π_tilde * MvPolynomial.X 0, MvPolynomial.X 1] P_h))
    (hh_01_eq : h_01 = Polynomial.X * ∑ d ∈ P_h.support,
      Polynomial.C (P_h.coeff d * π_tilde ^ (d 0) * b' ^ (d 1)) *
        Polynomial.X ^ (d 0 + (P_h.totalDegree - d 1)))
    (hh_e : h_e ∉
      Ideal.span {Ideal.Quotient.mk (weilNodalIdeal R₀ (b' * π_tilde)) (MvPolynomial.X 0),
          Ideal.Quotient.mk (weilNodalIdeal R₀ (b' * π_tilde)) (MvPolynomial.X 1)} ⊔
        Ideal.map ((Ideal.Quotient.mk (weilNodalIdeal R₀ (b' * π_tilde))).comp MvPolynomial.C)
          (IsLocalRing.maximalIdeal R₀))
    (Q₀ : Ideal R₀) [Q₀.IsPrime]
    (hπ_Q : π_tilde ∈ Q₀) (hb'_Q : b' ∈ Q₀)
    (hQ_rad : ∀ P : PrimeSpectrum R₀,
      (π_tilde ∈ P.asIdeal ∧ b' ∈ P.asIdeal) ↔ Q₀ ≤ P.asIdeal) :
    let u_0 : Localization.Away h_0 :=
      algebraMap (weilNodalQuot R₀ π_tilde) (Localization.Away h_0)
        (Ideal.Quotient.mk (weilNodalIdeal R₀ π_tilde) (MvPolynomial.X 0))
    let g_0 : Localization.Away h_0 :=
      algebraMap (weilNodalQuot R₀ π_tilde) (Localization.Away h_0)
        (Ideal.Quotient.mk (weilNodalIdeal R₀ π_tilde) (MvPolynomial.X 1))
    let g_1 : Localization.Away h_1 :=
      algebraMap (weilNodalQuot R₀ b') (Localization.Away h_1)
        (Ideal.Quotient.mk (weilNodalIdeal R₀ b') (MvPolynomial.X 0))
    let v_1 : Localization.Away h_1 :=
      algebraMap (weilNodalQuot R₀ b') (Localization.Away h_1)
        (Ideal.Quotient.mk (weilNodalIdeal R₀ b') (MvPolynomial.X 1))
    let d_0 : Localization.Away h_e :=
      algebraMap (weilNodalQuot R₀ (b' * π_tilde)) (Localization.Away h_e)
        (Ideal.Quotient.mk (weilNodalIdeal R₀ (b' * π_tilde)) (MvPolynomial.X 0))
    let d_1 : Localization.Away h_e :=
      algebraMap (weilNodalQuot R₀ (b' * π_tilde)) (Localization.Away h_e)
        (Ideal.Quotient.mk (weilNodalIdeal R₀ (b' * π_tilde)) (MvPolynomial.X 1))
    let d_2 : Localization.Away h_e :=
      algebraMap (weilNodalQuot R₀ (b' * π_tilde)) (Localization.Away h_e)
        (Ideal.Quotient.mk (weilNodalIdeal R₀ (b' * π_tilde)) (MvPolynomial.C π_tilde))
    let d_3 : Localization.Away h_e :=
      algebraMap (weilNodalQuot R₀ (b' * π_tilde)) (Localization.Away h_e)
        (Ideal.Quotient.mk (weilNodalIdeal R₀ (b' * π_tilde)) (MvPolynomial.C b'))
    let φ_RB : R₀ →+* Localization.Away h_e :=
      (algebraMap (weilNodalQuot R₀ (b' * π_tilde)) (Localization.Away h_e)).comp
        ((Ideal.Quotient.mk (weilNodalIdeal R₀ (b' * π_tilde))).comp MvPolynomial.C)
    let φ_R0 : R₀ →+* Localization.Away h_0 :=
      (algebraMap (weilNodalQuot R₀ π_tilde) (Localization.Away h_0)).comp
        ((Ideal.Quotient.mk (weilNodalIdeal R₀ π_tilde)).comp MvPolynomial.C)
    let φ_R1 : R₀ →+* Localization.Away h_1 :=
      (algebraMap (weilNodalQuot R₀ b') (Localization.Away h_1)).comp
        ((Ideal.Quotient.mk (weilNodalIdeal R₀ b')).comp MvPolynomial.C)
    ∀ (ψ_0 : Localization.Away h_e →+* Localization.Away h_0)
      (ψ_1 : Localization.Away h_e →+* Localization.Away h_1)
      (f₀₁ : Localization.Away h_0 →+* Localization.Away h_01)
      (f₁₀ : Localization.Away h_1 →+* Localization.Away h_01),
      ((∀ r : R₀, ψ_0 (φ_RB r) = φ_R0 r) ∧
        ψ_0 d_0 = u_0 ∧
        ψ_0 d_1 =
          algebraMap (weilNodalQuot R₀ π_tilde) (Localization.Away h_0)
            (Ideal.Quotient.mk (weilNodalIdeal R₀ π_tilde)
              (MvPolynomial.C b' * MvPolynomial.X 1)) ∧
        (∀ r : R₀, ψ_1 (φ_RB r) = φ_R1 r) ∧
        ψ_1 d_0 =
          algebraMap (weilNodalQuot R₀ b') (Localization.Away h_1)
            (Ideal.Quotient.mk (weilNodalIdeal R₀ b')
              (MvPolynomial.C π_tilde * MvPolynomial.X 0)) ∧
        ψ_1 d_1 = v_1) →
      ((∀ r : R₀,
          f₀₁ (φ_R0 r) = algebraMap (Polynomial R₀) (Localization.Away h_01) (Polynomial.C r)) ∧
        f₀₁ u_0 =
          algebraMap (Polynomial R₀) (Localization.Away h_01)
            (Polynomial.C π_tilde * Polynomial.X) ∧
        algebraMap (Polynomial R₀) (Localization.Away h_01) Polynomial.X * f₀₁ g_0 = 1 ∧
        (∀ r : R₀,
          f₁₀ (φ_R1 r) = algebraMap (Polynomial R₀) (Localization.Away h_01) (Polynomial.C r)) ∧
        f₁₀ g_1 = algebraMap (Polynomial R₀) (Localization.Away h_01) Polynomial.X ∧
        algebraMap (Polynomial R₀) (Localization.Away h_01) Polynomial.X * f₁₀ v_1 =
          algebraMap (Polynomial R₀) (Localization.Away h_01) (Polynomial.C b')) →
      (h_0 ∉ Ideal.span {Ideal.Quotient.mk (weilNodalIdeal R₀ π_tilde) (MvPolynomial.X 0),
            Ideal.Quotient.mk (weilNodalIdeal R₀ π_tilde) (MvPolynomial.X 1)} ⊔
          Ideal.map ((Ideal.Quotient.mk (weilNodalIdeal R₀ π_tilde)).comp MvPolynomial.C)
            (IsLocalRing.maximalIdeal R₀) ∧
        h_1 ∉ Ideal.span {Ideal.Quotient.mk (weilNodalIdeal R₀ b') (MvPolynomial.X 0),
            Ideal.Quotient.mk (weilNodalIdeal R₀ b') (MvPolynomial.X 1)} ⊔
          Ideal.map ((Ideal.Quotient.mk (weilNodalIdeal R₀ b')).comp MvPolynomial.C)
            (IsLocalRing.maximalIdeal R₀) ∧
        ∀ δ_e c_tilde : R₀,
          δ_e - c_tilde ∉ IsLocalRing.maximalIdeal R₀ →
          Polynomial.eval c_tilde (h_01.comp (Polynomial.X - Polynomial.C δ_e)) ∉
            IsLocalRing.maximalIdeal R₀) ∧
      (∃ (ρ_σ : Localization.Away h_e →+* (R₀ ⧸ Q₀))
         (ρ_τ0 : Localization.Away h_0 →+* (R₀ ⧸ Q₀))
         (ρ_τ1 : Localization.Away h_1 →+* (R₀ ⧸ Q₀)),
        Function.Surjective ρ_σ ∧
        ρ_σ.comp φ_RB = Ideal.Quotient.mk Q₀ ∧
        (∀ b_idx : Fin 2,
          ρ_σ (algebraMap (weilNodalQuot R₀ (b' * π_tilde)) (Localization.Away h_e)
            (Ideal.Quotient.mk (weilNodalIdeal R₀ (b' * π_tilde))
              (MvPolynomial.X b_idx))) = 0) ∧
        Set.range (PrimeSpectrum.comap ρ_σ) =
          PrimeSpectrum.zeroLocus ({d_0, d_1, d_2, d_3} : Set (Localization.Away h_e)) ∧
        (∀ (x : PrimeSpectrum (Localization.Away h_e)) (q : PrimeSpectrum (R₀ ⧸ Q₀)),
          (PrimeSpectrum.comap φ_RB x = PrimeSpectrum.comap (Ideal.Quotient.mk Q₀) q ∧
            d_0 ∈ x.asIdeal ∧ d_1 ∈ x.asIdeal) ↔
          x = PrimeSpectrum.comap ρ_σ q) ∧
        ρ_τ0.comp ψ_0 = ρ_σ ∧
        ρ_τ1.comp ψ_1 = ρ_σ ∧
        (∀ q : PrimeSpectrum (R₀ ⧸ Q₀), g_1 ∈ (PrimeSpectrum.comap ρ_τ1 q).asIdeal)) ∧
      ((∀ (Q : Ideal R₀) [Q.IsPrime],
          π_tilde ∈ Q → b' ∈ Q →
          ∃ q_01 : PrimeSpectrum (Localization.Away h_01),
            (PrimeSpectrum.comap φ_R0 (PrimeSpectrum.comap f₀₁ q_01)).asIdeal = Q ∧
            u_0 ∈ (PrimeSpectrum.comap f₀₁ q_01).asIdeal ∧
            (∀ p₀ : PrimeSpectrum (Localization.Away h_0),
              u_0 ∈ p₀.asIdeal → Q ≤ (PrimeSpectrum.comap φ_R0 p₀).asIdeal →
              (PrimeSpectrum.comap f₀₁ q_01).asIdeal ≤ p₀.asIdeal) ∧
            (∀ p₁ : PrimeSpectrum (Localization.Away h_1),
              v_1 ∈ p₁.asIdeal → Q ≤ (PrimeSpectrum.comap φ_R1 p₁).asIdeal →
              (PrimeSpectrum.comap f₁₀ q_01).asIdeal ≤ p₁.asIdeal)) ∧
        (∃ q_S0 : PrimeSpectrum (Localization.Away h_0),
          (PrimeSpectrum.comap φ_R0 q_S0).asIdeal = IsLocalRing.maximalIdeal R₀ ∧
          g_0 ∈ q_S0.asIdeal ∧
          u_0 ∉ q_S0.asIdeal ∧
          ∀ p₀ : PrimeSpectrum (Localization.Away h_0),
            g_0 ∈ p₀.asIdeal →
            IsLocalRing.maximalIdeal R₀ ≤ (PrimeSpectrum.comap φ_R0 p₀).asIdeal →
            q_S0.asIdeal ≤ p₀.asIdeal) ∧
        (∃ q_S1 : PrimeSpectrum (Localization.Away h_1),
          (PrimeSpectrum.comap φ_R1 q_S1).asIdeal = IsLocalRing.maximalIdeal R₀ ∧
          g_1 ∈ q_S1.asIdeal ∧
          v_1 ∉ q_S1.asIdeal ∧
          ∀ p₁ : PrimeSpectrum (Localization.Away h_1),
            g_1 ∈ p₁.asIdeal →
            IsLocalRing.maximalIdeal R₀ ≤ (PrimeSpectrum.comap φ_R1 p₁).asIdeal →
            q_S1.asIdeal ≤ p₁.asIdeal) ∧
        (∃! p_nod0 : PrimeSpectrum (Localization.Away h_0),
          (PrimeSpectrum.comap φ_R0 p_nod0).asIdeal = IsLocalRing.maximalIdeal R₀ ∧
          u_0 ∈ p_nod0.asIdeal ∧ g_0 ∈ p_nod0.asIdeal) ∧
        (∃! p_nod1 : PrimeSpectrum (Localization.Away h_1),
          (PrimeSpectrum.comap φ_R1 p_nod1).asIdeal = IsLocalRing.maximalIdeal R₀ ∧
          g_1 ∈ p_nod1.asIdeal ∧ v_1 ∈ p_nod1.asIdeal)) :=
by
  classical
  intro u_0 g_0 g_1 v_1 d_0 d_1 d_2 d_3 φ_RB φ_R0 φ_R1
  rintro ψ_0 ψ_1 f₀₁ f₁₀
    ⟨hψ0_C, hψ0_d0, hψ0_d1, hψ1_C, hψ1_d0, hψ1_d1⟩
    ⟨hf01_C, hf01_u0, hf01_g0, hf10_C, hf10_g1, hf10_v1⟩
  let m₀ : Ideal R₀ := IsLocalRing.maximalIdeal R₀
  have hm₀_max : m₀.IsMaximal := IsLocalRing.maximalIdeal.isMaximal R₀
  let k₀ := R₀ ⧸ m₀
  let _ : Field k₀ := Ideal.Quotient.field m₀
  let q_m : R₀ →+* k₀ := Ideal.Quotient.mk m₀
  
  have hmon_eq : ∀ (d : Fin 2 →₀ ℕ) (c : R₀),
      MvPolynomial.monomial d c =
        MvPolynomial.C c * (MvPolynomial.X 0 ^ d 0 * MvPolynomial.X 1 ^ d 1) := by
    intro d c
    rw [MvPolynomial.monomial_eq, Finsupp.prod_fintype _ _ (fun _ => pow_zero _), Fin.prod_univ_two]
  
  have hfin2_ext : ∀ {d₁ d₂ : Fin 2 →₀ ℕ}, d₁ 0 = d₂ 0 → d₁ 1 = d₂ 1 → d₁ = d₂ := by
    intro d₁ d₂ h0 h1
    ext j
    fin_cases j
    · exact h0
    · exact h1
  have hd_ne_zero : ∀ {d : Fin 2 →₀ ℕ}, d ≠ 0 → d 0 ≠ 0 ∨ d 1 ≠ 0 := by
    intro d hd
    rcases Decidable.em (d 0 = 0) with hd0 | hd0
    · exact Or.inr fun hd1 => hd (hfin2_ext hd0 hd1)
    · exact Or.inl hd0
  
  have hmon_mem : ∀ {S : Type u} [CommRing S]
      (ψ : MvPolynomial (Fin 2) R₀ →+* S) (I : Ideal S) (i : Fin 2)
      (d : Fin 2 →₀ ℕ) (c : R₀),
      ψ (MvPolynomial.X i) ∈ I → d i ≠ 0 → ψ (MvPolynomial.monomial d c) ∈ I := by
    intro S _ ψ I i d c hXi hdi
    obtain ⟨k, hk⟩ := Nat.exists_eq_succ_of_ne_zero hdi
    rw [hmon_eq, map_mul, map_mul, map_pow, map_pow]
    fin_cases i
    · change d 0 = k + 1 at hk
      rw [hk, pow_succ]
      exact Ideal.mul_mem_left I _ (Ideal.mul_mem_right _ I (Ideal.mul_mem_left I _ hXi))
    · change d 1 = k + 1 at hk
      rw [hk, pow_succ]
      exact Ideal.mul_mem_left I _ (Ideal.mul_mem_left I _ (Ideal.mul_mem_left I _ hXi))
  
  have hsub_C_mem : ∀ {S : Type u} [CommRing S]
      (ψ : MvPolynomial (Fin 2) R₀ →+* S) (I : Ideal S),
      ψ (MvPolynomial.X 0) ∈ I → ψ (MvPolynomial.X 1) ∈ I →
      ∀ F : MvPolynomial (Fin 2) R₀, ψ F - ψ (MvPolynomial.C (F.coeff 0)) ∈ I := by
    intro S _ ψ I hX0 hX1 F
    have hF_sum : ψ F = ∑ d ∈ F.support, ψ (MvPolynomial.monomial d (F.coeff d)) := by
      conv_lhs => rw [MvPolynomial.as_sum F]
      rw [map_sum]
    rw [hF_sum]
    by_cases h0 : (0 : Fin 2 →₀ ℕ) ∈ F.support
    · rw [← Finset.add_sum_erase _ _ h0]
      have hm0 : ψ (MvPolynomial.monomial 0 (F.coeff 0)) = ψ (MvPolynomial.C (F.coeff 0)) := by
        rw [hmon_eq]; simp
      rw [hm0, add_sub_cancel_left]
      refine Ideal.sum_mem I fun d hd => ?_
      rcases hd_ne_zero (Finset.ne_of_mem_erase hd) with hd0 | hd1
      · exact hmon_mem ψ I 0 d (F.coeff d) hX0 hd0
      · exact hmon_mem ψ I 1 d (F.coeff d) hX1 hd1
    · have hc0_zero : F.coeff 0 = 0 := MvPolynomial.notMem_support_iff.mp h0
      rw [hc0_zero, map_zero, map_zero, sub_zero]
      refine Ideal.sum_mem I fun d hd => ?_
      have hd_ne : d ≠ 0 := fun h => h0 (h ▸ hd)
      rcases hd_ne_zero hd_ne with hd0 | hd1
      · exact hmon_mem ψ I 0 d (F.coeff d) hX0 hd0
      · exact hmon_mem ψ I 1 d (F.coeff d) hX1 hd1
  
  let mkConstQuotHom : ∀ {T : Type u} [CommRing T] (a : R₀) (q : R₀ →+* T),
      q a = 0 → weilNodalQuot R₀ a →+* T :=
    fun {T} _ a q ha =>
      Ideal.Quotient.lift (weilNodalIdeal R₀ a) (q.comp MvPolynomial.constantCoeff)
        (fun x hx => by
          have hle : weilNodalIdeal R₀ a ≤ RingHom.ker (q.comp MvPolynomial.constantCoeff) := by
            rw [weilNodalIdeal, Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
            simp [RingHom.comp_apply, MvPolynomial.constantCoeff_X, MvPolynomial.constantCoeff_C, ha]
          exact RingHom.mem_ker.mp (hle hx))
  have hmkConstQuotHom_mk : ∀ {T : Type u} [CommRing T] (a : R₀) (q : R₀ →+* T)
      (ha : q a = 0) (P : MvPolynomial (Fin 2) R₀),
      mkConstQuotHom a q ha (Ideal.Quotient.mk (weilNodalIdeal R₀ a) P) = q (P.coeff 0) := by
    intro T _ a q ha P
    change q (MvPolynomial.constantCoeff P) = q (P.coeff 0)
    rw [MvPolynomial.constantCoeff_eq]
  
  have hsurj_away : ∀ {A : Type u} [CommRing A] (h : A) (z : Localization.Away h),
      ∃ a : A, ∀ I : Ideal (Localization.Away h),
        z ∈ I ↔ algebraMap A (Localization.Away h) a ∈ I := by
    intro A _ h z
    obtain ⟨⟨a, s⟩, hzs⟩ := IsLocalization.surj (Submonoid.powers h) z
    refine ⟨a, fun I => ⟨fun hz => ?_, fun ha => ?_⟩⟩
    · rw [← hzs]
      exact Ideal.mul_mem_right _ I hz
    · obtain ⟨u, hu⟩ := IsLocalization.map_units (Localization.Away h) s
      have hz_eq : z = algebraMap A (Localization.Away h) a * ↑u⁻¹ := by
        calc z = z * (↑u * ↑u⁻¹) := by rw [Units.mul_inv, mul_one]
          _ = (z * algebraMap A (Localization.Away h) s.1) * ↑u⁻¹ := by rw [← mul_assoc, hu]
          _ = algebraMap A (Localization.Away h) a * ↑u⁻¹ := by rw [hzs]
      rw [hz_eq]
      exact Ideal.mul_mem_right _ I ha
  
  have hmem_J_iff : ∀ (a : R₀), a ∈ m₀ → ∀ (P : MvPolynomial (Fin 2) R₀),
      Ideal.Quotient.mk (weilNodalIdeal R₀ a) P ∈
        Ideal.span {Ideal.Quotient.mk (weilNodalIdeal R₀ a) (MvPolynomial.X 0),
            Ideal.Quotient.mk (weilNodalIdeal R₀ a) (MvPolynomial.X 1)} ⊔
          Ideal.map ((Ideal.Quotient.mk (weilNodalIdeal R₀ a)).comp MvPolynomial.C) m₀ ↔
      P.coeff 0 ∈ m₀ := by
    intro a ha P
    let mk_a := Ideal.Quotient.mk (weilNodalIdeal R₀ a)
    let J_a := Ideal.span {mk_a (MvPolynomial.X 0), mk_a (MvPolynomial.X 1)} ⊔
      Ideal.map (mk_a.comp MvPolynomial.C) m₀
    change mk_a P ∈ J_a ↔ P.coeff 0 ∈ m₀
    constructor
    · intro hmem
      have hqa : q_m a = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr ha
      let ε_a := mkConstQuotHom a q_m hqa
      have hle : J_a ≤ RingHom.ker ε_a := by
        refine sup_le ?_ ?_
        · rw [Ideal.span_le]
          rintro _ (rfl | rfl)
          · change mkConstQuotHom a q_m hqa
              (Ideal.Quotient.mk (weilNodalIdeal R₀ a) (MvPolynomial.X 0)) = 0
            rw [hmkConstQuotHom_mk a q_m hqa, ← MvPolynomial.constantCoeff_eq,
              MvPolynomial.constantCoeff_X, map_zero]
          · change mkConstQuotHom a q_m hqa
              (Ideal.Quotient.mk (weilNodalIdeal R₀ a) (MvPolynomial.X 1)) = 0
            rw [hmkConstQuotHom_mk a q_m hqa, ← MvPolynomial.constantCoeff_eq,
              MvPolynomial.constantCoeff_X, map_zero]
        · rw [Ideal.map_le_iff_le_comap]
          intro r hr
          change mkConstQuotHom a q_m hqa
            (Ideal.Quotient.mk (weilNodalIdeal R₀ a) (MvPolynomial.C r)) = 0
          rw [hmkConstQuotHom_mk a q_m hqa, ← MvPolynomial.constantCoeff_eq,
            MvPolynomial.constantCoeff_C]
          exact Ideal.Quotient.eq_zero_iff_mem.mpr hr
      have h0 : mkConstQuotHom a q_m hqa (Ideal.Quotient.mk (weilNodalIdeal R₀ a) P) = 0 :=
        hle hmem
      rw [hmkConstQuotHom_mk a q_m hqa] at h0
      exact Ideal.Quotient.eq_zero_iff_mem.mp h0
    · intro hc0_in
      have hX0_in : mk_a (MvPolynomial.X 0) ∈ J_a :=
        Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))
      have hX1_in : mk_a (MvPolynomial.X 1) ∈ J_a :=
        Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))
      have hsub := hsub_C_mem mk_a J_a hX0_in hX1_in P
      have hC_in : mk_a (MvPolynomial.C (P.coeff 0)) ∈ J_a :=
        Ideal.mem_sup_right (Ideal.mem_map_of_mem (mk_a.comp MvPolynomial.C) hc0_in)
      have hsum := J_a.add_mem hsub hC_in
      rwa [sub_add_cancel] at hsum
  have hc0_notMem : P_h.coeff 0 ∉ m₀ := by
    intro hc0_in
    apply hh_e
    rw [hh_e_eq]
    exact (hmem_J_iff (b' * π_tilde) (Ideal.mul_mem_left m₀ b' hπ_mem) P_h).mpr hc0_in
  have hc0_unit : IsUnit (P_h.coeff 0) := IsLocalRing.notMem_maximalIdeal.mp hc0_notMem
  let Φ_0 : MvPolynomial (Fin 2) R₀ →+* MvPolynomial (Fin 2) R₀ :=
    MvPolynomial.eval₂Hom MvPolynomial.C ![MvPolynomial.X 0, MvPolynomial.C b' * MvPolynomial.X 1]
  let Φ_1 : MvPolynomial (Fin 2) R₀ →+* MvPolynomial (Fin 2) R₀ :=
    MvPolynomial.eval₂Hom MvPolynomial.C ![MvPolynomial.C π_tilde * MvPolynomial.X 0, MvPolynomial.X 1]
  let P_0 : MvPolynomial (Fin 2) R₀ := Φ_0 P_h
  let P_1 : MvPolynomial (Fin 2) R₀ := Φ_1 P_h
  have hP0_coeff0 : P_0.coeff 0 = P_h.coeff 0 := by
    have hcomp : MvPolynomial.constantCoeff.comp Φ_0 =
        (MvPolynomial.constantCoeff : MvPolynomial (Fin 2) R₀ →+* R₀) := by
      apply MvPolynomial.ringHom_ext'
      · ext r; simp [Φ_0]
      · intro j; fin_cases j <;> simp [Φ_0]
    have h1 := RingHom.congr_fun hcomp P_h
    rw [RingHom.comp_apply, MvPolynomial.constantCoeff_eq, MvPolynomial.constantCoeff_eq] at h1
    exact h1
  have hP1_coeff0 : P_1.coeff 0 = P_h.coeff 0 := by
    have hcomp : MvPolynomial.constantCoeff.comp Φ_1 =
        (MvPolynomial.constantCoeff : MvPolynomial (Fin 2) R₀ →+* R₀) := by
      apply MvPolynomial.ringHom_ext'
      · ext r; simp [Φ_1]
      · intro j; fin_cases j <;> simp [Φ_1]
    have h1 := RingHom.congr_fun hcomp P_h
    rw [RingHom.comp_apply, MvPolynomial.constantCoeff_eq, MvPolynomial.constantCoeff_eq] at h1
    exact h1
  have hP0_notMem : P_0.coeff 0 ∉ m₀ := hP0_coeff0 ▸ hc0_notMem
  have hP1_notMem : P_1.coeff 0 ∉ m₀ := hP1_coeff0 ▸ hc0_notMem
  have hh0_notMem : h_0 ∉
      Ideal.span {Ideal.Quotient.mk (weilNodalIdeal R₀ π_tilde) (MvPolynomial.X 0),
          Ideal.Quotient.mk (weilNodalIdeal R₀ π_tilde) (MvPolynomial.X 1)} ⊔
        Ideal.map ((Ideal.Quotient.mk (weilNodalIdeal R₀ π_tilde)).comp MvPolynomial.C) m₀ := by
    rw [hh_0_eq]
    exact mt (hmem_J_iff π_tilde hπ_mem P_0).mp hP0_notMem
  have hh1_notMem : h_1 ∉
      Ideal.span {Ideal.Quotient.mk (weilNodalIdeal R₀ b') (MvPolynomial.X 0),
          Ideal.Quotient.mk (weilNodalIdeal R₀ b') (MvPolynomial.X 1)} ⊔
        Ideal.map ((Ideal.Quotient.mk (weilNodalIdeal R₀ b')).comp MvPolynomial.C) m₀ := by
    rw [hh_1_eq]
    exact mt (hmem_J_iff b' hb'_mem P_1).mp hP1_notMem
  have hh01_shift : ∀ δ_e c_tilde : R₀,
      δ_e - c_tilde ∉ m₀ →
      Polynomial.eval c_tilde (h_01.comp (Polynomial.X - Polynomial.C δ_e)) ∉ m₀ := by
    intro δ_e c_tilde hδc h_in
    let Δ : R₀ := c_tilde - δ_e
    have hΔ_not : Δ ∉ m₀ := by
      intro hΔ_in
      have hneg := m₀.neg_mem hΔ_in
      rw [neg_sub] at hneg
      exact hδc hneg
    have hqΔ_ne : q_m Δ ≠ 0 := fun h0 => hΔ_not (Ideal.Quotient.eq_zero_iff_mem.mp h0)
    have hqc0_ne : q_m (P_h.coeff 0) ≠ 0 :=
      fun h0 => hc0_notMem (Ideal.Quotient.eq_zero_iff_mem.mp h0)
    have h0_supp : (0 : Fin 2 →₀ ℕ) ∈ P_h.support :=
      MvPolynomial.mem_support_iff.mpr fun h0 => hc0_notMem (h0 ▸ m₀.zero_mem)
    have hev_eq : Polynomial.eval c_tilde (h_01.comp (Polynomial.X - Polynomial.C δ_e)) =
        Polynomial.eval Δ h_01 := by
      rw [Polynomial.eval_comp, Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C]
    rw [hev_eq] at h_in
    have hq_ev0 : q_m (Polynomial.eval Δ h_01) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr h_in
    have hqπ : q_m π_tilde = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hπ_mem
    have hqb : q_m b' = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hb'_mem
    have hq_calc : q_m (Polynomial.eval Δ h_01) =
        q_m Δ * (q_m (P_h.coeff 0) * q_m Δ ^ P_h.totalDegree) := by
      rw [hh_01_eq, Polynomial.eval_mul, Polynomial.eval_X, Polynomial.eval_finsetSum,
        map_mul, map_sum]
      congr 1
      rw [Finset.sum_eq_single (0 : Fin 2 →₀ ℕ)]
      · simp
      · intro d _ hd_ne
        rw [Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_pow, Polynomial.eval_X]
        simp only [map_mul, map_pow, hqπ, hqb]
        rcases hd_ne_zero hd_ne with hd0 | hd1
        · simp [zero_pow hd0]
        · simp [zero_pow hd1]
      · intro hnot
        exact absurd h0_supp hnot
    rw [hq_calc] at hq_ev0
    exact mul_ne_zero hqΔ_ne (mul_ne_zero hqc0_ne (pow_ne_zero _ hqΔ_ne)) hq_ev0
  
  have hPart2 : ∃ (ρ_σ : Localization.Away h_e →+* (R₀ ⧸ Q₀))
       (ρ_τ0 : Localization.Away h_0 →+* (R₀ ⧸ Q₀))
       (ρ_τ1 : Localization.Away h_1 →+* (R₀ ⧸ Q₀)),
      Function.Surjective ρ_σ ∧
      ρ_σ.comp φ_RB = Ideal.Quotient.mk Q₀ ∧
      (∀ b_idx : Fin 2,
        ρ_σ (algebraMap (weilNodalQuot R₀ (b' * π_tilde)) (Localization.Away h_e)
          (Ideal.Quotient.mk (weilNodalIdeal R₀ (b' * π_tilde))
            (MvPolynomial.X b_idx))) = 0) ∧
      Set.range (PrimeSpectrum.comap ρ_σ) =
        PrimeSpectrum.zeroLocus ({d_0, d_1, d_2, d_3} : Set (Localization.Away h_e)) ∧
      (∀ (x : PrimeSpectrum (Localization.Away h_e)) (q : PrimeSpectrum (R₀ ⧸ Q₀)),
        (PrimeSpectrum.comap φ_RB x = PrimeSpectrum.comap (Ideal.Quotient.mk Q₀) q ∧
          d_0 ∈ x.asIdeal ∧ d_1 ∈ x.asIdeal) ↔
        x = PrimeSpectrum.comap ρ_σ q) ∧
      ρ_τ0.comp ψ_0 = ρ_σ ∧
      ρ_τ1.comp ψ_1 = ρ_σ ∧
      (∀ q : PrimeSpectrum (R₀ ⧸ Q₀), g_1 ∈ (PrimeSpectrum.comap ρ_τ1 q).asIdeal) := by
    let q_Q₀ : R₀ →+* (R₀ ⧸ Q₀) := Ideal.Quotient.mk Q₀
    have hqQ_π : q_Q₀ π_tilde = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hπ_Q
    have hqQ_b : q_Q₀ b' = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hb'_Q
    have hqQ_bπ : q_Q₀ (b' * π_tilde) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mul_mem_left Q₀ b' hπ_Q)
    let ρ_σ_pre := mkConstQuotHom (b' * π_tilde) q_Q₀ hqQ_bπ
    let ρ_τ0_pre := mkConstQuotHom π_tilde q_Q₀ hqQ_π
    let ρ_τ1_pre := mkConstQuotHom b' q_Q₀ hqQ_b
    have hu_he : IsUnit (ρ_σ_pre h_e) := by
      rw [hh_e_eq]
      change IsUnit (mkConstQuotHom (b' * π_tilde) q_Q₀ hqQ_bπ
        (Ideal.Quotient.mk (weilNodalIdeal R₀ (b' * π_tilde)) P_h))
      rw [hmkConstQuotHom_mk (b' * π_tilde) q_Q₀ hqQ_bπ]
      exact hc0_unit.map q_Q₀
