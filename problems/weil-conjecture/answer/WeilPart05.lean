    let ev_B : B →+* ↑((AlgebraicGeometry.Spec (CommRingCat.of B)).residueField p) :=
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of B)).inv ≫
        (AlgebraicGeometry.Spec (CommRingCat.of B)).Γevaluation p).hom
    obtain ⟨hker_R, hsurj_R⟩ := ev_spec R₀ Q
    obtain ⟨hker_B, hsurj_B⟩ := ev_spec B p
    have hnat : ∀ r : R₀, (f.residueFieldMap p).hom (ev_R r) = ev_B (γ r) := by
      intro r
      have h1 := AlgebraicGeometry.Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom γ)
      have h2 := AlgebraicGeometry.Scheme.Γevaluation_naturality f p
      have hcomp :
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).inv ≫
            ((AlgebraicGeometry.Spec (CommRingCat.of R₀)).Γevaluation Q ≫ f.residueFieldMap p) =
          CommRingCat.ofHom γ ≫
            ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of B)).inv ≫
              (AlgebraicGeometry.Spec (CommRingCat.of B)).Γevaluation p) := by
        calc (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).inv ≫
              ((AlgebraicGeometry.Spec (CommRingCat.of R₀)).Γevaluation Q ≫ f.residueFieldMap p)
            = ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₀)).inv ≫ f.appTop) ≫
                (AlgebraicGeometry.Spec (CommRingCat.of B)).Γevaluation p := by
                rw [h2, CategoryTheory.Category.assoc]
          _ = CommRingCat.ofHom γ ≫
                ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of B)).inv ≫
                  (AlgebraicGeometry.Spec (CommRingCat.of B)).Γevaluation p) := by
                rw [← h1, CategoryTheory.Category.assoc]
      exact congrArg (fun φ => φ.hom r) hcomp
    constructor
    · intro hSurj b
      obtain ⟨z, hz⟩ := hSurj (ev_B b)
      obtain ⟨a, s, hsQ, hzs⟩ := hsurj_R z
      refine ⟨a, s, hsQ, ?_⟩
      rw [← hker_B, RingHom.mem_ker, map_sub, map_mul, ← hz, ← hnat s, ← hnat a, ← map_mul, hzs,
        sub_self]
    · intro hFrac ξ
      obtain ⟨b₁, b₂, hb₂, hξ⟩ := hsurj_B ξ
      obtain ⟨a₁, s₁, hs₁, h₁⟩ := hFrac b₁
      obtain ⟨a₂, s₂, hs₂, h₂⟩ := hFrac b₂
      have hev_b₁ : ev_B b₁ * ev_B (γ s₁) = ev_B (γ a₁) := by
        have h0 : ev_B (b₁ * γ s₁ - γ a₁) = 0 := RingHom.mem_ker.mp (hker_B.symm ▸ h₁)
        rw [map_sub, map_mul] at h0; exact sub_eq_zero.mp h0
      have hev_b₂ : ev_B b₂ * ev_B (γ s₂) = ev_B (γ a₂) := by
        have h0 : ev_B (b₂ * γ s₂ - γ a₂) = 0 := RingHom.mem_ker.mp (hker_B.symm ▸ h₂)
        rw [map_sub, map_mul] at h0; exact sub_eq_zero.mp h0
      have hb₂_ne : ev_B b₂ ≠ 0 := fun h0 => hb₂ (hker_B ▸ RingHom.mem_ker.mpr h0)
      have hs₁_ne : ev_R s₁ ≠ 0 := fun h0 => hs₁ (hker_R ▸ RingHom.mem_ker.mpr h0)
      have hs₂_ne : ev_R s₂ ≠ 0 := fun h0 => hs₂ (hker_R ▸ RingHom.mem_ker.mpr h0)
      have ha₂_ne : ev_R a₂ ≠ 0 := by
        intro h0
        have hγa₂ : ev_B (γ a₂) = 0 := by rw [← hnat a₂, h0, map_zero]
        rw [hγa₂] at hev_b₂
        rcases mul_eq_zero.mp hev_b₂ with hbad | hγs₂
        · exact hb₂_ne hbad
        · rw [← hnat s₂] at hγs₂
          exact hs₂_ne ((RingHom.injective (f.residueFieldMap p).hom)
            (hγs₂.trans (map_zero _).symm))
      refine ⟨ev_R a₁ * ev_R s₂ * (ev_R s₁ * ev_R a₂)⁻¹, ?_⟩
      have hden_R : ev_R s₁ * ev_R a₂ ≠ 0 := mul_ne_zero hs₁_ne ha₂_ne
      have hden_ne : ev_B (γ s₁) * ev_B (γ a₂) ≠ 0 := by
        rw [← hnat s₁, ← hnat a₂, ← map_mul]
        exact (map_ne_zero (f.residueFieldMap p).hom).mpr hden_R
      have hmap_den :
          (f.residueFieldMap p).hom ((ev_R s₁ * ev_R a₂)⁻¹) *
            (ev_B (γ s₁) * ev_B (γ a₂)) = 1 := by
        rw [← hnat s₁, ← hnat a₂, ← map_mul (f.residueFieldMap p).hom,
          ← map_mul (f.residueFieldMap p).hom, inv_mul_cancel₀ hden_R, map_one]
      apply mul_right_cancel₀ hb₂_ne
      rw [hξ]
      apply mul_right_cancel₀ hden_ne
      calc (f.residueFieldMap p).hom (ev_R a₁ * ev_R s₂ * (ev_R s₁ * ev_R a₂)⁻¹) * ev_B b₂ *
            (ev_B (γ s₁) * ev_B (γ a₂))
          = ev_B (γ a₁) * (ev_B b₂ * ev_B (γ s₂)) *
              ((f.residueFieldMap p).hom ((ev_R s₁ * ev_R a₂)⁻¹) *
                (ev_B (γ s₁) * ev_B (γ a₂))) := by
              rw [map_mul, map_mul, hnat a₁, hnat s₂]
              ring
        _ = ev_B (γ a₁) * ev_B (γ a₂) * 1 := by rw [hev_b₂, hmap_den]
        _ = (ev_B b₁ * ev_B (γ s₁)) * ev_B (γ a₂) := by rw [mul_one, ← hev_b₁]
        _ = ev_B b₁ * (ev_B (γ s₁) * ev_B (γ a₂)) := by ring
  have separated_valuation_specialization :
      ∀ (X : AlgebraicGeometry.Scheme.{u})
        (g_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
        [AlgebraicGeometry.IsSeparated g_X]
        (x x_max : ↥X),
        Function.Surjective (g_X.residueFieldMap x).hom →
        x_max ∈ closure ({x} : Set ↥X) →
        (g_X.base x_max).asIdeal = IsLocalRing.maximalIdeal ↥R →
        (∀ u ∈ closure ({x} : Set ↥X), g_X.base u = g_X.base x → u = x) ∧
        ∃ x₀ : ↥X,
          x₀ ∈ closure ({x} : Set ↥X) ∧
          IsClosed ({x₀} : Set ↥X) ∧
          (g_X.base x₀).asIdeal = IsLocalRing.maximalIdeal ↥R ∧
          (∀ u ∈ closure ({x} : Set ↥X),
            (g_X.base u).asIdeal = IsLocalRing.maximalIdeal ↥R → u = x₀) := by
    intro X g_X _ x x_max hSurj hx_max_cl hx_max_m
    let Q : PrimeSpectrum ↥R := g_X.base x
    have _ : Q.asIdeal.IsPrime := Q.isPrime
    obtain ⟨U₀, hU₀, hx_max_U, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := ⊤) (x := x_max) trivial
    have hx_U : x ∈ U₀ := by
      obtain ⟨z, hz_U, hz_x⟩ := mem_closure_iff.mp hx_max_cl U₀ U₀.isOpen hx_max_U
      rw [Set.mem_singleton_iff] at hz_x
      rwa [← hz_x]
    let B₀_obj := X.presheaf.obj (Opposite.op U₀)
    let B₀ := ↑B₀_obj
    let γ₀_hom := AlgebraicGeometry.Spec.preimage (hU₀.fromSpec ≫ g_X)
    let γ₀ : ↥R →+* B₀ := γ₀_hom.hom
    let f_γ := AlgebraicGeometry.Spec.map γ₀_hom
    have hf_γ : f_γ = hU₀.fromSpec ≫ g_X :=
      AlgebraicGeometry.Spec.map_preimage (hU₀.fromSpec ≫ g_X)
    let p_x : ↥(AlgebraicGeometry.Spec B₀_obj) := hU₀.primeIdealOf ⟨x, hx_U⟩
    let p_max : ↥(AlgebraicGeometry.Spec B₀_obj) := hU₀.primeIdealOf ⟨x_max, hx_max_U⟩
    have _ : p_x.asIdeal.IsPrime := p_x.isPrime
    have _ : p_max.asIdeal.IsPrime := p_max.isPrime
    have hfrom_x : hU₀.fromSpec.base p_x = x := hU₀.fromSpec_primeIdealOf ⟨x, hx_U⟩
    have hfrom_max : hU₀.fromSpec.base p_max = x_max := hU₀.fromSpec_primeIdealOf ⟨x_max, hx_max_U⟩
    have hfp_x : f_γ.base p_x = Q := by
      rw [hf_γ]
      change g_X.base (hU₀.fromSpec.base p_x) = Q
      rw [hfrom_x]
    have hcomap_x : Ideal.comap γ₀ p_x.asIdeal = Q.asIdeal :=
      congrArg PrimeSpectrum.asIdeal hfp_x
    have hcomap_max : Ideal.comap γ₀ p_max.asIdeal = IsLocalRing.maximalIdeal ↥R := by
      have hfp_max : f_γ.base p_max = g_X.base x_max := by
        rw [hf_γ]
        change g_X.base (hU₀.fromSpec.base p_max) = g_X.base x_max
        rw [hfrom_max]
      exact (congrArg PrimeSpectrum.asIdeal hfp_max).trans hx_max_m
    have hp_le : p_x.asIdeal ≤ p_max.asIdeal := by
      have hcl_eq :=
        hU₀.fromSpec.isOpenEmbedding.isInducing.closure_eq_preimage_closure_image ({p_x} : Set _)
      have hmem_pre : p_max ∈ hU₀.fromSpec.base ⁻¹' closure (⇑hU₀.fromSpec '' ({p_x} : Set _)) := by
        change hU₀.fromSpec.base p_max ∈ closure (⇑hU₀.fromSpec '' ({p_x} : Set _))
        have himg : (⇑hU₀.fromSpec '' ({p_x} : Set _)) = ({x} : Set ↥X) := by
          rw [Set.image_singleton]; exact congrArg Set.singleton hfrom_x
        rw [himg, hfrom_max]
        exact hx_max_cl
      have hmem_cl : p_max ∈ closure ({p_x} : Set _) := hcl_eq ▸ hmem_pre
      exact (PrimeSpectrum.le_iff_mem_closure (hU₀.primeIdealOf ⟨x, hx_U⟩)
