        neg_mem' := by
          rintro y ⟨a, s, hs, hy⟩
          exact ⟨-a, s, hs, by rw [map_neg, neg_mul, hy]⟩ }
    have hRBP_le_W : ∀ {y : F}, y ∈ R_BP → y ∈ W₀ := by
      rintro y ⟨a, s, hs, hy⟩
      have hs_not_mW : (⟨φ_B s, hW_mem s⟩ : ↥W₀) ∉ IsLocalRing.maximalIdeal ↥W₀ := by
        rwa [hW_max s]
      have hs_unit : IsUnit (⟨φ_B s, hW_mem s⟩ : ↥W₀) := IsLocalRing.notMem_maximalIdeal.mp hs_not_mW
      obtain ⟨u_inv, hu_inv⟩ := hs_unit.exists_right_inv
      have hy_eq : y = φ_B a * u_inv.1 := by
        have hval : φ_B s * u_inv.1 = 1 := congrArg Subtype.val hu_inv
        calc y = y * (φ_B s * u_inv.1) := by rw [hval, mul_one]
          _ = (y * φ_B s) * u_inv.1 := by ring
          _ = φ_B a * u_inv.1 := by rw [hy]
      rw [hy_eq]
      exact W₀.toSubring.mul_mem (hW_mem a) u_inv.2
    have hRBP_inv_of_not_mW : ∀ {y : F} (hy : y ∈ R_BP),
        (⟨y, hRBP_le_W hy⟩ : ↥W₀) ∉ IsLocalRing.maximalIdeal ↥W₀ → y⁻¹ ∈ R_BP := by
      rintro y ⟨a, s, hs, hy_eq⟩ hy_not_mW
      have ha_not_P : a ∉ P := by
        intro ha_P
        apply hy_not_mW
        have ha_mW : (⟨φ_B a, hW_mem a⟩ : ↥W₀) ∈ IsLocalRing.maximalIdeal ↥W₀ := (hW_max a).mpr ha_P
        have hs_unit : IsUnit (⟨φ_B s, hW_mem s⟩ : ↥W₀) :=
          IsLocalRing.notMem_maximalIdeal.mp (by rwa [hW_max s])
        obtain ⟨u_inv, hu_inv⟩ := hs_unit.exists_right_inv
        have hprod_eq : (⟨y, hRBP_le_W ⟨a, s, hs, hy_eq⟩⟩ : ↥W₀) =
            ⟨φ_B a, hW_mem a⟩ * u_inv := Subtype.ext (by
          change y = φ_B a * u_inv.1
          have hval : φ_B s * u_inv.1 = 1 := congrArg Subtype.val hu_inv
          calc y = y * (φ_B s * u_inv.1) := by rw [hval, mul_one]
            _ = (y * φ_B s) * u_inv.1 := by ring
            _ = φ_B a * u_inv.1 := by rw [hy_eq])
        rw [hprod_eq]
        exact Ideal.mul_mem_right u_inv _ ha_mW
      have hy_ne : y ≠ 0 := by
        intro h0
        apply hy_not_mW
        have hzero_W : (⟨y, hRBP_le_W ⟨a, s, hs, hy_eq⟩⟩ : ↥W₀) = 0 := Subtype.ext h0
        rw [hzero_W]
        exact Ideal.zero_mem _
      exact ⟨s, a, ha_not_P, by rw [← hy_eq, inv_mul_cancel_left₀ hy_ne]⟩
    have hV₀_in_RBP : ∀ u : ↥F₀, u ∈ V₀ → u.1 ∈ R_BP := by
      rintro u ⟨P₁, P₂, hP₂_not, hu_eq⟩
      exact ⟨α₀ P₁, α₀ P₂, hP₂_not, hu_eq⟩
    have hV₀_max_to_W : ∀ u : ↥V₀,
        u ∈ IsLocalRing.maximalIdeal ↥V₀ →
        (⟨u.1.1, hRBP_le_W (hV₀_in_RBP u.1 u.2)⟩ : ↥W₀) ∈ IsLocalRing.maximalIdeal ↥W₀ := by
      intro u hu_max
      obtain ⟨P₁, P₂, hP₂_not, hu_eq⟩ := u.2
      have hP₁_in : P₁ ∈ p₀ := by
        by_contra hP₁_not
        have hu_ne : u.1 ≠ 0 := by
          intro h0
          have h0' : u.1.1 = 0 := congrArg Subtype.val h0
          rw [h0', zero_mul] at hu_eq
          exact hP₁_not (by rw [hι₀_inj (hu_eq.symm.trans (map_zero ι₀).symm)]; exact Ideal.zero_mem _)
        have hinv_V₀ : u.1⁻¹ ∈ V₀ := ⟨P₂, P₁, hP₁_not, by
          change u.1.1⁻¹ * ι₀ P₁ = ι₀ P₂
          rw [← hu_eq, inv_mul_cancel_left₀ (fun h => hu_ne (Subtype.ext h))]⟩
        have hu_unit : IsUnit u := ⟨⟨u, ⟨u.1⁻¹, hinv_V₀⟩,
          Subtype.ext (Subtype.ext (mul_inv_cancel₀ (fun h => hu_ne (Subtype.ext h)))),
          Subtype.ext (Subtype.ext (inv_mul_cancel₀ (fun h => hu_ne (Subtype.ext h))))⟩, rfl⟩
        exact (IsLocalRing.mem_maximalIdeal u).mp hu_max hu_unit
      have ha_mW : (⟨φ_B (α₀ P₁), hW_mem (α₀ P₁)⟩ : ↥W₀) ∈ IsLocalRing.maximalIdeal ↥W₀ :=
        (hW_max (α₀ P₁)).mpr hP₁_in
      have hs_unit : IsUnit (⟨φ_B (α₀ P₂), hW_mem (α₀ P₂)⟩ : ↥W₀) :=
        IsLocalRing.notMem_maximalIdeal.mp (by rwa [hW_max (α₀ P₂)])
      obtain ⟨w_inv, hw_inv⟩ := hs_unit.exists_right_inv
      have heq_W : (⟨u.1.1, hRBP_le_W (hV₀_in_RBP u.1 u.2)⟩ : ↥W₀) =
          ⟨φ_B (α₀ P₁), hW_mem (α₀ P₁)⟩ * w_inv := Subtype.ext (by
        change u.1.1 = φ_B (α₀ P₁) * w_inv.1
        have hval : φ_B (α₀ P₂) * w_inv.1 = 1 := congrArg Subtype.val hw_inv
        calc u.1.1 = u.1.1 * (φ_B (α₀ P₂) * w_inv.1) := by rw [hval, mul_one]
          _ = (u.1.1 * ι₀ P₂) * w_inv.1 := by dsimp only [ι₀, RingHom.comp_apply]; ring
          _ = φ_B (α₀ P₁) * w_inv.1 := by rw [hu_eq]; rfl)
      rw [heq_W]
      exact Ideal.mul_mem_right w_inv _ ha_mW
    have hIC_RBP_fn : ∀ ⦃x : F⦄, IsIntegral ↥R_BP x → x ∈ R_BP := by
      intro x ⟨Q, hQ_monic, hQ_eval⟩
      let d := Q.natDegree
      rcases Nat.eq_zero_or_pos d with hd0 | hd_pos
      · exfalso
        have hQ1 : Q = 1 := Polynomial.eq_one_of_monic_natDegree_zero hQ_monic hd0
        rw [hQ1, Polynomial.eval₂_one] at hQ_eval
        exact one_ne_zero hQ_eval
      · let a_fn : ℕ → B := fun i => Classical.choose (Q.coeff i).2
        let s_fn : ℕ → B := fun i => Classical.choose (Classical.choose_spec (Q.coeff i).2)
        have hs_fn : ∀ i : ℕ, s_fn i ∉ P ∧ (Q.coeff i).1 * φ_B (s_fn i) = φ_B (a_fn i) :=
          fun i => Classical.choose_spec (Classical.choose_spec (Q.coeff i).2)
        let S : B := ∏ i ∈ Finset.range d, s_fn i
        have hS_not_P : S ∉ P := by
          have hnot : ∀ T : Finset ℕ, (∀ i ∈ T, s_fn i ∉ P) → (∏ i ∈ T, s_fn i) ∉ P := by
            intro T
            induction T using Finset.induction_on with
            | empty => intro _; rw [Finset.prod_empty]; exact hP.one_notMem
            | insert k T hkT ih =>
              intro hall hmem
              rw [Finset.prod_insert hkT] at hmem
              rcases hP.mem_or_mem hmem with hk | hT_mem
              · exact hall k (Finset.mem_insert_self k T) hk
              · exact ih (fun i hi => hall i (Finset.mem_insert_of_mem hi)) hT_mem
          exact hnot (Finset.range d) (fun i _ => (hs_fn i).1)
        have hCoeff_S : ∀ i ∈ Finset.range d, ∃ b_i : B, (Q.coeff i).1 * φ_B S = φ_B b_i := by
          intro i hi
          obtain ⟨t_i, ht_i⟩ := Finset.dvd_prod_of_mem s_fn hi
          refine ⟨a_fn i * t_i, ?_⟩
          change (Q.coeff i).1 * φ_B (∏ j ∈ Finset.range d, s_fn j) = φ_B (a_fn i * t_i)
          rw [ht_i, map_mul, ← mul_assoc, (hs_fn i).2, map_mul]
        let b_fn : ℕ → B := fun i =>
          if hi : i ∈ Finset.range d then Classical.choose (hCoeff_S i hi) else 0
        let Q_B : Polynomial B :=
          Polynomial.X ^ d + ∑ i ∈ Finset.range d,
            Polynomial.C (b_fn i * S ^ (d - 1 - i)) * Polynomial.X ^ i
        have hQB_monic : Q_B.Monic := by
          apply Polynomial.Monic.add_of_left (Polynomial.monic_X_pow d)
          rw [Polynomial.degree_X_pow, Polynomial.degree_lt_iff_coeff_zero]
          intro k hk
          rw [Polynomial.finset_sum_coeff]
          apply Finset.sum_eq_zero
          intro i hi
          rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow]
          have hik : k ≠ i := by have := Finset.mem_range.mp hi; omega
          simp [hik]
        have hQB_eval : Polynomial.aeval (x * φ_B S) Q_B = 0 := by
          have hQB_expand : Polynomial.aeval (x * φ_B S) Q_B =
              (x * φ_B S) ^ d + ∑ i ∈ Finset.range d,
                φ_B (b_fn i * S ^ (d - 1 - i)) * (x * φ_B S) ^ i := by
            simp only [Q_B, map_add, map_pow, Polynomial.aeval_X, map_sum, Polynomial.aeval_C]
            congr 1
            refine Finset.sum_congr rfl (fun i _ => ?_)
            rw [map_mul, map_pow, Polynomial.aeval_X, Polynomial.aeval_C]
            rfl
          rw [hQB_expand]
          have hterms : ∀ i ∈ Finset.range d,
              φ_B (b_fn i * S ^ (d - 1 - i)) * (x * φ_B S) ^ i =
              (φ_B S) ^ d * ((Q.coeff i).1 * x ^ i) := by
            intro i hi
            have hi_lt : i < d := Finset.mem_range.mp hi
            have hb_eq : (Q.coeff i).1 * φ_B S = φ_B (b_fn i) := by
              simp only [b_fn, hi, ↓reduceDIte]
              exact Classical.choose_spec (hCoeff_S i hi)
            have hpow_eq : 1 + (d - 1 - i) + i = d := by omega
            calc φ_B (b_fn i * S ^ (d - 1 - i)) * (x * φ_B S) ^ i
                = φ_B (b_fn i) * (φ_B S) ^ (d - 1 - i) * (x ^ i * (φ_B S) ^ i) := by
                    rw [map_mul, map_pow, mul_pow]
              _ = ((Q.coeff i).1 * φ_B S) * (φ_B S) ^ (d - 1 - i) * (φ_B S) ^ i * x ^ i := by
                    rw [← hb_eq]; ring
              _ = (φ_B S) ^ (1 + (d - 1 - i) + i) * ((Q.coeff i).1 * x ^ i) := by
                    rw [pow_add, pow_add, pow_one]; ring
              _ = (φ_B S) ^ d * ((Q.coeff i).1 * x ^ i) := by rw [hpow_eq]
          rw [Finset.sum_congr rfl hterms, ← Finset.mul_sum, mul_pow, mul_comm (x ^ d), ← mul_add]
          have hQ_sum : Polynomial.aeval x Q =
              x ^ d + ∑ i ∈ Finset.range d, (Q.coeff i).1 * x ^ i := by
            rw [Polynomial.aeval_def, Polynomial.eval₂_eq_sum_range, Finset.sum_range_succ,
              add_comm]
            have hlead : (Q.coeff d).1 = 1 := by
              change (Q.leadingCoeff : F) = 1
              rw [hQ_monic.leadingCoeff]; rfl
            change (Q.coeff d).1 * x ^ d + ∑ i ∈ Finset.range d, (Q.coeff i).1 * x ^ i = _
            rw [hlead, one_mul]
          rw [← hQ_sum]
          have hQ_eval' : Polynomial.aeval x Q = 0 := hQ_eval
          rw [hQ_eval', mul_zero]
        have hy_int : IsIntegral B (x * φ_B S) := ⟨Q_B, hQB_monic, hQB_eval⟩
        obtain ⟨a_x, ha_x⟩ := (isIntegrallyClosed_iff F).mp inferInstance hy_int
        exact ⟨a_x, S, hS_not_P, ha_x.symm⟩
    haveI : IsIntegrallyClosedIn ↥R_BP F := Subring.isIntegrallyClosedIn_iff.mpr hIC_RBP_fn
    intro z hz_W
    change z ∈ R_BP
    by_cases hz0 : z = 0
    · subst hz0; exact R_BP.zero_mem
    · have hz_int_F₀ : IsIntegral ↥F₀ z := hInt_F₀ z
      let Q_min := minpoly ↥F₀ z
      have hQmin_monic : Q_min.Monic := minpoly.monic hz_int_F₀
      have hQmin_eval : Polynomial.aeval z Q_min = 0 := minpoly.aeval ↥F₀ z
      let n := Q_min.natDegree
      have hn_pos : 0 < n := minpoly.natDegree_pos hz_int_F₀
      let a : Fin (n + 1) → ↥F₀ := fun i => Q_min.coeff i.1
      have ha_n : a ⟨n, Nat.lt_succ_self n⟩ = 1 := hQmin_monic.leadingCoeff
      let S_idx : Finset (Fin (n + 1)) := Finset.univ.filter (fun k => a k ≠ 0)
      have hS_idx_ne : S_idx.Nonempty :=
        ⟨⟨n, Nat.lt_succ_self n⟩, Finset.mem_filter.mpr ⟨Finset.mem_univ _, by rw [ha_n]; exact one_ne_zero⟩⟩
      have hM_ex : ∃ k₀ : Fin (n + 1), a k₀ ≠ 0 ∧ ∀ i : Fin (n + 1), a i * (a k₀)⁻¹ ∈ V₀ := by
        have hind : ∀ T : Finset (Fin (n + 1)), T.Nonempty → (∀ k ∈ T, a k ≠ 0) →
            ∃ k₀ ∈ T, ∀ i ∈ T, a i * (a k₀)⁻¹ ∈ V₀ := by
          intro T hT_ne
          induction hT_ne using Finset.Nonempty.cons_induction with
          | singleton k =>
            intro hk_nz
            refine ⟨k, Finset.mem_singleton_self k, fun i hi => ?_⟩
            rw [Finset.mem_singleton.mp hi, mul_inv_cancel₀ (hk_nz k (Finset.mem_singleton_self k))]
            exact V₀.one_mem
          | cons k T hkT hT ih =>
            intro hall
            obtain ⟨k₁, hk₁T, hdiv₁⟩ := ih (fun j hj => hall j (Finset.mem_cons_of_mem hj))
            have hk_nz : a k ≠ 0 := hall k (Finset.mem_cons_self k T)
            have hk₁_nz : a k₁ ≠ 0 := hall k₁ (Finset.mem_cons_of_mem hk₁T)
            rcases V₀.mem_or_inv_mem (a k₁ * (a k)⁻¹) with hmem | hmem_inv
            · refine ⟨k, Finset.mem_cons_self k T, fun i hi => ?_⟩
              rcases Finset.mem_cons.mp hi with rfl | hiT
              · rw [mul_inv_cancel₀ hk_nz]; exact V₀.one_mem
              · have heq : a i * (a k)⁻¹ = (a i * (a k₁)⁻¹) * (a k₁ * (a k)⁻¹) := by
                  rw [mul_assoc, inv_mul_cancel_left₀ hk₁_nz]
                rw [heq]
                exact V₀.toSubring.mul_mem (hdiv₁ i hiT) hmem
            · have hmem' : a k * (a k₁)⁻¹ ∈ V₀ := by
                have heq : (a k₁ * (a k)⁻¹)⁻¹ = a k * (a k₁)⁻¹ := by rw [mul_inv_rev, inv_inv]
                rwa [← heq]
              refine ⟨k₁, Finset.mem_cons_of_mem hk₁T, fun i hi => ?_⟩
              rcases Finset.mem_cons.mp hi with rfl | hiT
              · exact hmem'
              · exact hdiv₁ i hiT
        obtain ⟨k₀, hk₀_S, hk₀_div⟩ := hind S_idx hS_idx_ne (fun k hk => (Finset.mem_filter.mp hk).2)
        refine ⟨k₀, (Finset.mem_filter.mp hk₀_S).2, fun i => ?_⟩
        by_cases hai : a i = 0
        · rw [hai, zero_mul]; exact V₀.zero_mem
        · exact hk₀_div i (Finset.mem_filter.mpr ⟨Finset.mem_univ i, hai⟩)
      let M_min : Finset (Fin (n + 1)) :=
        Finset.univ.filter (fun k => a k ≠ 0 ∧ ∀ i : Fin (n + 1), a i * (a k)⁻¹ ∈ V₀)
      have hM_ne : M_min.Nonempty := by
        obtain ⟨k₀, hk₀_nz, hk₀_div⟩ := hM_ex
        exact ⟨k₀, Finset.mem_filter.mpr ⟨Finset.mem_univ k₀, hk₀_nz, hk₀_div⟩⟩
      let m_fin : Fin (n + 1) := M_min.max' hM_ne
      have hm_mem : m_fin ∈ M_min := Finset.max'_mem M_min hM_ne
      obtain ⟨ham_nz, ham_div⟩ := (Finset.mem_filter.mp hm_mem).2
      let m₀ : ℕ := m_fin.1
      have hm₀_le_n : m₀ ≤ n := Nat.lt_succ_iff.mp m_fin.2
      let c_V₀ : ∀ i : Fin (n + 1), ↥V₀ := fun i => ⟨a i * (a m_fin)⁻¹, ham_div i⟩
      let c : ℕ → F := fun i => if hi : i < n + 1 then (c_V₀ ⟨i, hi⟩).1.1 else 0
      have hc_RBP : ∀ i : ℕ, c i ∈ R_BP := by
        intro i
        by_cases hi : i < n + 1
        · simp only [c, hi, ↓reduceDIte]
          exact hV₀_in_RBP _ (c_V₀ ⟨i, hi⟩).2
        · simp only [c, hi, ↓reduceDIte]
          exact R_BP.zero_mem
      have hc_m₀ : c m₀ = 1 := by
        dsimp only [c, m₀]
        rw [dif_pos m_fin.2]
        change ((a m_fin * (a m_fin)⁻¹ : ↥F₀) : F) = 1
        rw [mul_inv_cancel₀ ham_nz]; rfl
      have hc_gt_max : ∀ j : ℕ, m₀ < j → j < n + 1 →
          (⟨c j, hRBP_le_W (hc_RBP j)⟩ : ↥W₀) ∈ IsLocalRing.maximalIdeal ↥W₀ := by
        intro j hj_gt hj_lt
        let j_fin : Fin (n + 1) := ⟨j, hj_lt⟩
        have hj_max_V₀ : c_V₀ j_fin ∈ IsLocalRing.maximalIdeal ↥V₀ := by
          rw [IsLocalRing.mem_maximalIdeal]
          intro hunit
          obtain ⟨v_inv, hv_inv⟩ := hunit.exists_right_inv
          have hval : (a j_fin * (a m_fin)⁻¹) * v_inv.1 = 1 :=
            congrArg Subtype.val hv_inv
          have haj_nz : a j_fin ≠ 0 := by
            intro h0; rw [h0, zero_mul, zero_mul] at hval; exact zero_ne_one hval
          have hvinv_eq : v_inv.1 = a m_fin * (a j_fin)⁻¹ := by
            apply mul_left_cancel₀ (mul_ne_zero haj_nz (inv_ne_zero ham_nz))
            calc (a j_fin * (a m_fin)⁻¹) * v_inv.1
                = 1 := hval
              _ = (a j_fin * (a j_fin)⁻¹) * ((a m_fin)⁻¹ * a m_fin) := by
                    rw [mul_inv_cancel₀ haj_nz, inv_mul_cancel₀ ham_nz, one_mul]
              _ = (a j_fin * (a m_fin)⁻¹) * (a m_fin * (a j_fin)⁻¹) := by ring
          have hj_in_M : j_fin ∈ M_min := by
            refine Finset.mem_filter.mpr ⟨Finset.mem_univ _, haj_nz, fun i => ?_⟩
            have heq : a i * (a j_fin)⁻¹ = (a i * (a m_fin)⁻¹) * v_inv.1 := by
              rw [hvinv_eq, mul_assoc, inv_mul_cancel_left₀ ham_nz]
            rw [heq]
            exact V₀.toSubring.mul_mem (ham_div i) v_inv.2
          have hj_le : j_fin ≤ m_fin := Finset.le_max' M_min j_fin hj_in_M
          have hj_le_nat : j ≤ m₀ := Fin.le_def.mp hj_le
          omega
        have hW_mem_j := hV₀_max_to_W (c_V₀ j_fin) hj_max_V₀
        convert hW_mem_j using 1
        ext
        dsimp only [c, j_fin]
        rw [dif_pos hj_lt]
      have hsum_c_zero : ∑ i ∈ Finset.range (n + 1), c i * z ^ i = 0 := by
        have hQ_sum : ∑ i ∈ Finset.range (n + 1), (Q_min.coeff i).1 * z ^ i = 0 := by
          change ∑ i ∈ Finset.range (n + 1), algebraMap ↥F₀ F (Q_min.coeff i) * z ^ i = 0
          rw [← Polynomial.eval₂_eq_sum_range, ← Polynomial.aeval_def]
          exact hQmin_eval
        have hterms : ∀ i ∈ Finset.range (n + 1),
            c i * z ^ i = ((a m_fin)⁻¹).1 * ((Q_min.coeff i).1 * z ^ i) := by
          intro i hi
          have hi_lt : i < n + 1 := Finset.mem_range.mp hi
          simp only [c, hi_lt, ↓reduceDIte, c_V₀, a]
          change ((Q_min.coeff i).1 * ((a m_fin)⁻¹).1) * z ^ i = _
          ring
        rw [Finset.sum_congr rfl hterms, ← Finset.mul_sum, hQ_sum, mul_zero]
      let s_sep : F := ∑ j ∈ Finset.Icc m₀ n, c j * z ^ (j - m₀)
      let w_term : ℕ → ↥W₀ := fun j => ⟨c j, hRBP_le_W (hc_RBP j)⟩ * ⟨z, hz_W⟩ ^ (j - m₀)
      let s_W : ↥W₀ := 1 + ∑ j ∈ Finset.Ioc m₀ n, w_term j
      have hsW_val : s_W.1 = s_sep := by
        have hIcc_eq : Finset.Icc m₀ n = insert m₀ (Finset.Ioc m₀ n) := by
          ext j
          simp only [Finset.mem_Icc, Finset.mem_insert, Finset.mem_Ioc]
          omega
        change (1 : F) + (∑ j ∈ Finset.Ioc m₀ n, w_term j : ↥W₀).1 = s_sep
        rw [AddSubmonoidClass.coe_finset_sum]
        dsimp only [s_sep]
        rw [hIcc_eq, Finset.sum_insert (by simp)]
        congr 1
        rw [Nat.sub_self, pow_zero, hc_m₀, mul_one]
      have hsW_not_max : s_W ∉ IsLocalRing.maximalIdeal ↥W₀ := by
        have hsum_max : (∑ j ∈ Finset.Ioc m₀ n, w_term j) ∈ IsLocalRing.maximalIdeal ↥W₀ := by
          refine Submodule.sum_mem _ (fun j hj => ?_)
          rw [Finset.mem_Ioc] at hj
          exact Ideal.mul_mem_right _ _ (hc_gt_max j hj.1 (by omega))
