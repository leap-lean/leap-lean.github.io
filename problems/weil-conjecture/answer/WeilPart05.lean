        have hsub_q := hsub_C_mem ψ_B (PrimeSpectrum.comap ρ_σ q).asIdeal hd0_q hd1_q F
        rw [hψB_C] at hsub_q
        have hF_x : ψ_B F ∈ x.asIdeal ↔ φ_RB (F.coeff 0) ∈ x.asIdeal :=
          ⟨fun h => by have hd := x.asIdeal.sub_mem h hsub_x; rwa [sub_sub_cancel] at hd,
           fun h => by have hs := x.asIdeal.add_mem hsub_x h; rwa [sub_add_cancel] at hs⟩
        have hF_q : ψ_B F ∈ (PrimeSpectrum.comap ρ_σ q).asIdeal ↔
