theorem weil_etale_closed_fiber_disc_tree_components_and_nodes (K : Type u) [Field K]
    (m : ℕ) (R : ValuationSubring K)
    (hPkg_R : IsValuationRingAlgPackage m R)
    (hMax_R : IsLocalRing.maximalIdeal ↥R ≠ ⊥)
    (a_opt : Option ↥R)
    (M_0 W_B_sch : AlgebraicGeometry.Scheme.{u})
    (g_M0 : M_0 ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
    (g_WB : W_B_sch ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
    (m_0 : ↥M_0) (u₀_WB : ↥W_B_sch)
    (e_0 : W_B_sch ⟶ M_0)
    (hAff_M0 : AlgebraicGeometry.IsAffine M_0)
    (hAff_WB : AlgebraicGeometry.IsAffine W_B_sch)
    (hm0_cl : IsClosed ({m_0} : Set ↥M_0))
    (hm0_max : (g_M0.base m_0).asIdeal = IsLocalRing.maximalIdeal ↥R)
    (hLft_M0 : AlgebraicGeometry.LocallyOfFiniteType g_M0)
    (hEt_e0 : AlgebraicGeometry.Etale e_0)
    (he0_comm : e_0 ≫ g_M0 = g_WB)
    (he0_m0 : e_0.base ⁻¹' {m_0} = {u₀_WB})
    (N : ℕ) (c π : Fin N → ↥R)
    (M_T : AlgebraicGeometry.Scheme.{u})
    (g_MT : M_T ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
    (f_MT : M_T ⟶ M_0)
    (B_comp : Fin N → Set ↥(CategoryTheory.Limits.pullback g_MT
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥R (IsLocalRing.maximalIdeal ↥R).ResidueField)))))
    (hFlat_MT : AlgebraicGeometry.Flat g_MT)
    (hLfp_MT : AlgebraicGeometry.LocallyOfFinitePresentation g_MT)
    (hProp_fMT : AlgebraicGeometry.IsProper f_MT)
    (hSurj_fMT : AlgebraicGeometry.Surjective f_MT)
    (hfMT_g : f_MT ≫ g_M0 = g_MT)
    (hB_inj : Function.Injective B_comp)
    (hB_irred : ∀ i : Fin N, B_comp i ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_MT
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥R (IsLocalRing.maximalIdeal ↥R).ResidueField)))))
    (hB_nonbd : ∀ i : Fin N, ¬ IsDiscBoundaryIdx ↥R a_opt (c i) (π i) →
      ∀ q ∈ B_comp i, f_MT.base ((CategoryTheory.Limits.pullback.fst g_MT
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (algebraMap ↥R (IsLocalRing.maximalIdeal ↥R).ResidueField)))).base q) = m_0)
    (hB_bd : ∀ i : Fin N, IsDiscBoundaryIdx ↥R a_opt (c i) (π i) →
      ∃ q ∈ B_comp i, f_MT.base ((CategoryTheory.Limits.pullback.fst g_MT
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (algebraMap ↥R (IsLocalRing.maximalIdeal ↥R).ResidueField)))).base q) ≠ m_0)
    (hB_exh : ∀ E ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_MT
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (algebraMap ↥R (IsLocalRing.maximalIdeal ↥R).ResidueField)))),
      (∀ q ∈ E, f_MT.base ((CategoryTheory.Limits.pullback.fst g_MT
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (algebraMap ↥R (IsLocalRing.maximalIdeal ↥R).ResidueField)))).base q) = m_0) →
      ∃ i : Fin N, ¬ IsDiscBoundaryIdx ↥R a_opt (c i) (π i) ∧ E = B_comp i)
    (hB_hasse : ∀ (i j : Fin N),
      IsDiscHasseCover ↥R c π i j →
      ∃! q : ↥(CategoryTheory.Limits.pullback g_MT
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (algebraMap ↥R (IsLocalRing.maximalIdeal ↥R).ResidueField)))),
        q ∈ B_comp i ∧ q ∈ B_comp j)
    (hB_two : ∀ (i j₁ j₂ : Fin N),
      ¬ IsDiscBoundaryIdx ↥R a_opt (c i) (π i) → j₁ ≠ i → j₂ ≠ i →
      ∀ q : ↥(CategoryTheory.Limits.pullback g_MT
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (algebraMap ↥R (IsLocalRing.maximalIdeal ↥R).ResidueField)))),
        q ∈ B_comp i → q ∈ B_comp j₁ → q ∈ B_comp j₂ → j₁ = j₂)
    (hB_nod : ∀ (i : Fin N), ¬ IsDiscBoundaryIdx ↥R a_opt (c i) (π i) →
      ∀ (q : ↥(CategoryTheory.Limits.pullback g_MT
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (algebraMap ↥R (IsLocalRing.maximalIdeal ↥R).ResidueField)))))
        (E' : Set ↥(CategoryTheory.Limits.pullback g_MT
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (algebraMap ↥R (IsLocalRing.maximalIdeal ↥R).ResidueField))))),
        q ∈ B_comp i →
        E' ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_MT
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (algebraMap ↥R (IsLocalRing.maximalIdeal ↥R).ResidueField)))) →
        E' ≠ B_comp i → q ∈ E' →
        ∃ j : Fin N, (IsDiscHasseCover ↥R c π i j ∨ IsDiscHasseCover ↥R c π j i) ∧
          E' = B_comp j ∧
          ∃ (U_nod : M_T.Opens) (a_n : ↥R)
            (e_n : U_nod.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of
              (MvPolynomial (Fin 2) ↥R ⧸ Ideal.span
                {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a_n}))),
            a_n ≠ 0 ∧ a_n ∈ IsLocalRing.maximalIdeal ↥R ∧
            AlgebraicGeometry.Etale e_n ∧
            U_nod.ι ≫ g_MT = e_n ≫ AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) ∧
            ∃ hq : (CategoryTheory.Limits.pullback.fst g_MT
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                  (algebraMap ↥R (IsLocalRing.maximalIdeal ↥R).ResidueField)))).base q ∈ U_nod,
              (∀ b : Fin 2, Ideal.Quotient.mk _ (MvPolynomial.X b) ∈
                (e_n.base ⟨_, hq⟩).asIdeal) ∧
              ∃ b₀ : Fin 2, ∀ x : ↥U_nod,
                (g_MT.base x.1).asIdeal = IsLocalRing.maximalIdeal ↥R →
                (x.1 ∈ (CategoryTheory.Limits.pullback.fst g_MT
                    (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                      (algebraMap ↥R (IsLocalRing.maximalIdeal ↥R).ResidueField)))).base '' E' ↔
                  Ideal.Quotient.mk _ (MvPolynomial.X b₀) ∈ (e_n.base x).asIdeal))
    (hπR_comm : (CategoryTheory.Limits.pullback.snd f_MT e_0 ≫ g_WB) ≫ 𝟙 _ =
      CategoryTheory.Limits.pullback.fst f_MT e_0 ≫ g_MT) :
    let s_R := AlgebraicGeometry.Spec.map (CommRingCat.ofHom
      (algebraMap ↥R (IsLocalRing.maximalIdeal ↥R).ResidueField))
    let X_T := CategoryTheory.Limits.pullback f_MT e_0
    let π_MT := CategoryTheory.Limits.pullback.fst f_MT e_0
    let f_XT := CategoryTheory.Limits.pullback.snd f_MT e_0
    let g_XT := f_XT ≫ g_WB
    let Y_MT := CategoryTheory.Limits.pullback g_MT s_R
    let Y_XT := CategoryTheory.Limits.pullback g_XT s_R
    let π_R : Y_XT ⟶ Y_MT :=
      CategoryTheory.Limits.pullback.map g_XT s_R g_MT s_R π_MT (𝟙 _) (𝟙 _) hπR_comm
        ((CategoryTheory.Category.comp_id s_R).trans (CategoryTheory.Category.id_comp s_R).symm)
    let E_XT : Fin N → Set ↥Y_XT := fun i => π_R.base ⁻¹' (B_comp i)
    ∃ (p_nb : Fin N → Fin N → ↥Y_XT)
      (H_nb : Fin N → Fin N → Set ↥Y_XT),
      (∀ i : Fin N, ¬ IsDiscBoundaryIdx ↥R a_opt (c i) (π i) →
        E_XT i ∈ irreducibleComponents ↥Y_XT ∧
        (CategoryTheory.Limits.pullback.fst g_XT s_R).base '' (E_XT i) =
          π_MT.base ⁻¹' ((CategoryTheory.Limits.pullback.fst g_MT s_R).base '' (B_comp i)) ∧
        (∀ q ∈ E_XT i,
          f_XT.base ((CategoryTheory.Limits.pullback.fst g_XT s_R).base q) = u₀_WB)) ∧
      (∀ E ∈ irreducibleComponents ↥Y_XT,
        (∀ q ∈ E, f_XT.base ((CategoryTheory.Limits.pullback.fst g_XT s_R).base q) = u₀_WB) →
        ∃ i : Fin N, ¬ IsDiscBoundaryIdx ↥R a_opt (c i) (π i) ∧ E = E_XT i) ∧
      (∀ (i j : Fin N), ¬ IsDiscBoundaryIdx ↥R a_opt (c i) (π i) →
        (IsDiscHasseCover ↥R c π i j ∨ IsDiscHasseCover ↥R c π j i) →
        H_nb i j ∈ irreducibleComponents ↥Y_XT ∧
        H_nb i j ≠ E_XT i ∧
        p_nb i j ∈ E_XT i ∧
        p_nb i j ∈ H_nb i j ∧
        (¬ IsDiscBoundaryIdx ↥R a_opt (c j) (π j) →
          H_nb i j = E_XT j ∧ p_nb i j = p_nb j i) ∧
        (IsDiscBoundaryIdx ↥R a_opt (c j) (π j) →
          ∃ q ∈ H_nb i j,
            f_XT.base ((CategoryTheory.Limits.pullback.fst g_XT s_R).base q) ≠ u₀_WB) ∧
        ∃ (U_nod : X_T.Opens)
          (a_n : ↥R)
          (e_n : U_nod.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of
            (MvPolynomial (Fin 2) ↥R ⧸ Ideal.span
              {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a_n}))),
          a_n ≠ 0 ∧ a_n ∈ IsLocalRing.maximalIdeal ↥R ∧
          AlgebraicGeometry.Etale e_n ∧
          U_nod.ι ≫ g_XT = e_n ≫ AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) ∧
          ∃ hp : (CategoryTheory.Limits.pullback.fst g_XT s_R).base (p_nb i j) ∈ U_nod,
            (∀ b : Fin 2, Ideal.Quotient.mk _ (MvPolynomial.X b) ∈
              (e_n.base ⟨_, hp⟩).asIdeal) ∧
            ∃ b₀ : Fin 2, ∀ x : ↥U_nod,
              (g_XT.base x.1).asIdeal = IsLocalRing.maximalIdeal ↥R →
              (x.1 ∈ (CategoryTheory.Limits.pullback.fst g_XT s_R).base '' (H_nb i j) ↔
                Ideal.Quotient.mk _ (MvPolynomial.X b₀) ∈ (e_n.base x).asIdeal)) ∧
      (∀ (i₁ j₁ i₂ j₂ : Fin N),
        ¬ IsDiscBoundaryIdx ↥R a_opt (c i₁) (π i₁) →
        ¬ IsDiscBoundaryIdx ↥R a_opt (c i₂) (π i₂) →
        (IsDiscHasseCover ↥R c π i₁ j₁ ∨ IsDiscHasseCover ↥R c π j₁ i₁) →
        (IsDiscHasseCover ↥R c π i₂ j₂ ∨ IsDiscHasseCover ↥R c π j₂ i₂) →
        p_nb i₁ j₁ = p_nb i₂ j₂ →
        (i₁ = i₂ ∧ j₁ = j₂) ∨ (i₁ = j₂ ∧ j₁ = i₂)) ∧
      (∀ i : Fin N, ¬ IsDiscBoundaryIdx ↥R a_opt (c i) (π i) →
        ∀ q : ↥Y_XT,
          (q ∈ E_XT i ∧ ∃ E' ∈ irreducibleComponents ↥Y_XT, E' ≠ E_XT i ∧ q ∈ E') ↔
          ∃ j : Fin N, (IsDiscHasseCover ↥R c π i j ∨ IsDiscHasseCover ↥R c π j i) ∧
            q = p_nb i j) :=
by
  intro s_R X_T π_MT f_XT g_XT Y_MT Y_XT π_R E_XT
  
  have nodal_krull_2branch : ∀ (k₀ : Type u) [Field k₀] (B : Type u) [CommRing B]
      (φ_nod : (MvPolynomial (Fin 2) k₀ ⧸
        Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} : Set (MvPolynomial (Fin 2) k₀))) →+* B),
      φ_nod.Etale →
      ∀ (q_0 : PrimeSpectrum B),
      (∀ b : Fin 2, φ_nod (Ideal.Quotient.mk _ (MvPolynomial.X b)) ∈ q_0.asIdeal) →
      ∀ (P₁ P₂ P₃ : Ideal B),
        P₁ ∈ minimalPrimes B → P₂ ∈ minimalPrimes B → P₃ ∈ minimalPrimes B →
        P₁ ≤ q_0.asIdeal → P₂ ≤ q_0.asIdeal → P₃ ≤ q_0.asIdeal →
        P₁ = P₂ ∨ P₁ = P₃ ∨ P₂ = P₃ := by
    intro k₀ _ B _ φ_nod hEt q_0 hq0_X
    let I_k : Ideal (MvPolynomial (Fin 2) k₀) :=
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}
    let A_nod_k := MvPolynomial (Fin 2) k₀ ⧸ I_k
    let _ : Algebra A_nod_k B := φ_nod.toAlgebra
    have : Algebra.Etale A_nod_k B := RingHom.etale_algebraMap.mp hEt
    let x_coord : Fin 2 → B := fun b => φ_nod (Ideal.Quotient.mk I_k (MvPolynomial.X b))
    have hx_mul_zero : x_coord 0 * x_coord 1 = 0 := by
      dsimp [x_coord]
      rw [← map_mul, ← map_mul]
      have hzero : Ideal.Quotient.mk I_k (MvPolynomial.X 0 * MvPolynomial.X 1) = 0 := by
        rw [Ideal.Quotient.eq_zero_iff_mem]
        exact Ideal.subset_span (Set.mem_singleton _)
      rw [hzero, map_zero]
    have hBranch_uniq : ∀ (b : Fin 2) (P₁ P₂ : Ideal B),
        P₁ ∈ minimalPrimes B → P₂ ∈ minimalPrimes B →
        P₁ ≤ q_0.asIdeal → P₂ ≤ q_0.asIdeal →
        x_coord b ∈ P₁ → x_coord b ∈ P₂ → P₁ = P₂ := by
      intro b P₁ P₂ hP₁ hP₂ hP₁_le hP₂_le hx₁ hx₂
      let b' : Fin 2 := 1 - b
      have hb'_ne : b' ≠ b := by fin_cases b <;> decide
      let B_b := B ⧸ Ideal.span {x_coord b}
      let π_b : B →+* B_b := Ideal.Quotient.mk (Ideal.span {x_coord b})
      let ev_b_raw : MvPolynomial (Fin 2) k₀ →+* Polynomial k₀ :=
        MvPolynomial.eval₂Hom Polynomial.C (fun i => if i = b then 0 else Polynomial.X)
      have hIk_evb : I_k ≤ RingHom.ker ev_b_raw := by
        rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
        fin_cases b <;> simp [ev_b_raw]
      let q_ev_b : A_nod_k →+* Polynomial k₀ := Ideal.Quotient.lift I_k ev_b_raw hIk_evb
      let s_ev_b : Polynomial k₀ →+* A_nod_k :=
        Polynomial.eval₂RingHom ((Ideal.Quotient.mk I_k).comp MvPolynomial.C)
          (Ideal.Quotient.mk I_k (MvPolynomial.X b'))
      have hq_sec : q_ev_b.comp s_ev_b = RingHom.id (Polynomial k₀) := by
        apply Polynomial.ringHom_ext
        · intro c
          rw [RingHom.comp_apply, RingHom.id_apply]
          have hs : s_ev_b (Polynomial.C c) = Ideal.Quotient.mk I_k (MvPolynomial.C c) := by
            simp [s_ev_b]
          rw [hs]
          change ev_b_raw (MvPolynomial.C c) = Polynomial.C c
          simp [ev_b_raw]
        · rw [RingHom.comp_apply, RingHom.id_apply]
          have hs : s_ev_b Polynomial.X = Ideal.Quotient.mk I_k (MvPolynomial.X b') := by
            simp [s_ev_b]
          rw [hs]
          change ev_b_raw (MvPolynomial.X b') = Polynomial.X
          simp [ev_b_raw, hb'_ne]
      let φ_poly_Bb : Polynomial k₀ →+* B_b := (π_b.comp φ_nod).comp s_ev_b
      let _ : Algebra A_nod_k (Polynomial k₀) := q_ev_b.toAlgebra
      let _ : Algebra (Polynomial k₀) B_b := φ_poly_Bb.toAlgebra
      let _ : Algebra A_nod_k B_b := (π_b.comp φ_nod).toAlgebra
      have h_comm_Ak_Bb : φ_poly_Bb.comp q_ev_b = π_b.comp φ_nod := by
        apply Ideal.Quotient.ringHom_ext
        apply MvPolynomial.ringHom_ext
        · intro c
          change φ_poly_Bb (ev_b_raw (MvPolynomial.C c)) = π_b (φ_nod (Ideal.Quotient.mk I_k (MvPolynomial.C c)))
          simp [φ_poly_Bb, s_ev_b, ev_b_raw]
        · intro i
          change φ_poly_Bb (ev_b_raw (MvPolynomial.X i)) = π_b (φ_nod (Ideal.Quotient.mk I_k (MvPolynomial.X i)))
          by_cases hib : i = b
          · subst hib
            simp only [ev_b_raw, MvPolynomial.eval₂Hom_X', ↓reduceIte, map_zero]
            symm
            change Ideal.Quotient.mk (Ideal.span {x_coord i}) (x_coord i) = 0
            rw [Ideal.Quotient.eq_zero_iff_mem]
            exact Ideal.subset_span (Set.mem_singleton _)
          · have hib' : i = b' := by fin_cases b <;> fin_cases i <;> first | rfl | contradiction
            subst hib'
            simp [φ_poly_Bb, s_ev_b, ev_b_raw, hb'_ne]
      have : IsScalarTower A_nod_k (Polynomial k₀) B_b :=
        IsScalarTower.of_algebraMap_eq' h_comm_Ak_Bb.symm
      let ψ_left_b : Polynomial k₀ →ₐ[A_nod_k] B_b :=
        { toRingHom := φ_poly_Bb
          commutes' := fun a => RingHom.congr_fun h_comm_Ak_Bb a }
      let ψ_right_b : B →ₐ[A_nod_k] B_b :=
        { toRingHom := π_b
          commutes' := fun _ => rfl }
      let ψ_fwd_b : TensorProduct A_nod_k (Polynomial k₀) B →+* B_b :=
        (Algebra.TensorProduct.productMap ψ_left_b ψ_right_b).toRingHom
      have h_xb_ker : Ideal.span {x_coord b} ≤
          RingHom.ker (Algebra.TensorProduct.includeRight : B →ₐ[A_nod_k]
            TensorProduct A_nod_k (Polynomial k₀) B).toRingHom := by
        rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
        let r_b : A_nod_k := Ideal.Quotient.mk I_k (MvPolynomial.X b)
        have hxb_smul : x_coord b = r_b • (1 : B) := by
          change x_coord b = φ_nod r_b * 1
          rw [mul_one]
        change (1 : Polynomial k₀) ⊗ₜ[A_nod_k] x_coord b = 0
        rw [hxb_smul, ← TensorProduct.smul_tmul (R := A_nod_k) r_b (1 : Polynomial k₀) (1 : B)]
        have hsmul : r_b • (1 : Polynomial k₀) = 0 := by
          change ev_b_raw (MvPolynomial.X b) * 1 = 0
          simp [ev_b_raw]
        rw [hsmul, TensorProduct.zero_tmul]
      let ψ_inv_b : B_b →+* TensorProduct A_nod_k (Polynomial k₀) B :=
        Ideal.Quotient.lift (Ideal.span {x_coord b})
          (Algebra.TensorProduct.includeRight : B →ₐ[A_nod_k] _).toRingHom h_xb_ker
      have hψ_fwd_inv : ψ_fwd_b.comp ψ_inv_b = RingHom.id B_b := by
        apply Ideal.Quotient.ringHom_ext
        ext y
        change ψ_fwd_b ((1 : Polynomial k₀) ⊗ₜ[A_nod_k] y) = π_b y
        simp [ψ_fwd_b, ψ_right_b]
      have hψ_inv_fwd : ψ_inv_b.comp ψ_fwd_b = RingHom.id _ := by
        refine RingHom.ext fun z => TensorProduct.inductionOn
          (motive := fun w => (ψ_inv_b.comp ψ_fwd_b) w = RingHom.id _ w)
          z (fun P y => ?_) (fun x y ihx ihy => by rw [map_add, ihx, ihy, map_add])
        let r_P : A_nod_k := s_ev_b P
        have hP : P = q_ev_b r_P := (RingHom.congr_fun hq_sec P).symm
        have hP_smul : q_ev_b r_P = r_P • (1 : Polynomial k₀) := by
          change q_ev_b r_P = q_ev_b r_P * 1
          rw [mul_one]
        have htmul : P ⊗ₜ[A_nod_k] y = (1 : Polynomial k₀) ⊗ₜ[A_nod_k] (φ_nod r_P * y) := by
          conv_lhs => rw [hP, hP_smul]
          rw [TensorProduct.smul_tmul (R := A_nod_k) r_P (1 : Polynomial k₀) y]
          rfl
        rw [htmul]
        change ψ_inv_b (ψ_fwd_b ((1 : Polynomial k₀) ⊗ₜ[A_nod_k] (φ_nod r_P * y))) =
          (1 : Polynomial k₀) ⊗ₜ[A_nod_k] (φ_nod r_P * y)
        have h1 : ψ_fwd_b ((1 : Polynomial k₀) ⊗ₜ[A_nod_k] (φ_nod r_P * y)) =
            π_b (φ_nod r_P * y) := by
          simp [ψ_fwd_b, ψ_right_b]
        rw [h1]
        rfl
      let e_Bb_ring : TensorProduct A_nod_k (Polynomial k₀) B ≃+* B_b :=
        { toFun := ψ_fwd_b
          invFun := ψ_inv_b
          left_inv := fun z => RingHom.congr_fun hψ_inv_fwd z
          right_inv := fun z => RingHom.congr_fun hψ_fwd_inv z
          map_mul' := map_mul ψ_fwd_b
          map_add' := map_add ψ_fwd_b }
      let e_Bb_alg : TensorProduct A_nod_k (Polynomial k₀) B ≃ₐ[Polynomial k₀] B_b :=
        AlgEquiv.ofRingEquiv (f := e_Bb_ring) (fun P => by
          change ψ_fwd_b (P ⊗ₜ[A_nod_k] (1 : B)) = φ_poly_Bb P
          simp [ψ_fwd_b, ψ_left_b])
      have : Algebra.Etale (Polynomial k₀) B_b := Algebra.Etale.of_equiv e_Bb_alg
      have : IsNoetherianRing B_b := Algebra.FiniteType.isNoetherianRing (Polynomial k₀) B_b
      have hker_πb_le : RingHom.ker π_b ≤ q_0.asIdeal := by
        rw [Ideal.mk_ker, Ideal.span_singleton_le_iff_mem]
        exact hq0_X b
      let q_bar_0 : Ideal B_b := Ideal.map π_b q_0.asIdeal
      have hcomap_qbar : Ideal.comap π_b q_bar_0 = q_0.asIdeal := by
        rw [Ideal.comap_map_of_surjective π_b Ideal.Quotient.mk_surjective]
        exact sup_eq_left.mpr hker_πb_le
      have hqbar_prime : q_bar_0.IsPrime :=
        Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective hker_πb_le
      let p_X : Ideal (Polynomial k₀) := Ideal.comap (algebraMap (Polynomial k₀) B_b) q_bar_0
      have hpX_prime : p_X.IsPrime := Ideal.IsPrime.comap _
      have hX_in_pX : Polynomial.X ∈ p_X := by
        change φ_poly_Bb Polynomial.X ∈ q_bar_0
        have hφX : φ_poly_Bb Polynomial.X = π_b (x_coord b') := by
          simp [φ_poly_Bb, s_ev_b, x_coord]
        rw [hφX]
        exact Ideal.mem_map_of_mem π_b (hq0_X b')
      have hSpanX_max : (Ideal.span ({Polynomial.X} : Set (Polynomial k₀))).IsMaximal := by
        have hsurj_ev0 : Function.Surjective (Polynomial.evalRingHom (0 : k₀)) :=
          fun c => ⟨Polynomial.C c, by simp⟩
        have hker_ev0 : RingHom.ker (Polynomial.evalRingHom (0 : k₀)) =
            Ideal.span {Polynomial.X} := by
          ext f
          change Polynomial.eval 0 f = 0 ↔ f ∈ Ideal.span {Polynomial.X}
          have hX0 : (Polynomial.X : Polynomial k₀) = Polynomial.X - Polynomial.C 0 := by simp
          rw [Ideal.mem_span_singleton, hX0, Polynomial.dvd_iff_isRoot, Polynomial.IsRoot]
        rw [← hker_ev0]
        exact RingHom.ker_isMaximal_of_surjective _ hsurj_ev0
      have hpX_eq : p_X = Ideal.span {Polynomial.X} := by
        have hle : Ideal.span ({Polynomial.X} : Set (Polynomial k₀)) ≤ p_X := by
          rw [Ideal.span_singleton_le_iff_mem]; exact hX_in_pX
        exact (hSpanX_max.eq_of_le hpX_prime.ne_top hle).symm
      let R_X := Localization.AtPrime p_X
      let L_b := Localization.AtPrime q_bar_0
      have : IsNoetherianRing L_b := IsLocalization.isNoetherianRing q_bar_0.primeCompl L_b ‹_›
      let φ_loc : R_X →+* L_b :=
        Localization.localRingHom p_X q_bar_0 (algebraMap (Polynomial k₀) B_b) rfl
      let _ : Algebra R_X L_b := φ_loc.toAlgebra
      have : IsScalarTower (Polynomial k₀) R_X L_b :=
        IsScalarTower.of_algebraMap_eq fun P =>
          (Localization.localRingHom_to_map p_X q_bar_0 (algebraMap (Polynomial k₀) B_b) rfl P).symm
      have : IsLocalHom (algebraMap R_X L_b) :=
        Localization.isLocalHom_localRingHom p_X q_bar_0 (algebraMap (Polynomial k₀) B_b) rfl
      have : Algebra.EssFiniteType (Polynomial k₀) L_b :=
        Algebra.EssFiniteType.comp (Polynomial k₀) B_b L_b
      have : Algebra.EssFiniteType R_X L_b :=
        Algebra.EssFiniteType.of_comp (Polynomial k₀) R_X L_b
      have : Algebra.FormallyUnramified B_b L_b :=
        Algebra.FormallyUnramified.instLocalization q_bar_0.primeCompl
      have : Algebra.FormallyUnramified (Polynomial k₀) L_b :=
        Algebra.FormallyUnramified.comp (Polynomial k₀) B_b L_b
      have : Algebra.FormallyUnramified R_X L_b :=
        Algebra.FormallyUnramified.localization_base p_X.primeCompl
      let t_b : L_b := algebraMap (Polynomial k₀) L_b Polynomial.X
      have hm_Lb : IsLocalRing.maximalIdeal L_b = Ideal.span {t_b} := by
        have hmap_RX : Ideal.map (algebraMap (Polynomial k₀) R_X) p_X =
            Ideal.map (algebraMap (Polynomial k₀) R_X) (Ideal.span {Polynomial.X}) :=
          congrArg (Ideal.map _) hpX_eq
        rw [← Algebra.FormallyUnramified.map_maximalIdeal (R := R_X) (S := L_b),
          ← Localization.AtPrime.map_eq_maximalIdeal, hmap_RX, Ideal.map_span, Ideal.map_span]
        simp only [Set.image_singleton]
        congr 1; ext z; simp [t_b, ← IsScalarTower.algebraMap_apply (Polynomial k₀) R_X L_b]
      have : Module.Flat (Polynomial k₀) L_b :=
        Localization.flat (R := Polynomial k₀) B_b q_bar_0.primeCompl
      have htb_reg : ∀ z : L_b, t_b * z = 0 → z = 0 := by
        let μ_X : Polynomial k₀ →ₗ[Polynomial k₀] Polynomial k₀ :=
          LinearMap.mulLeft (Polynomial k₀) Polynomial.X
        have hμ_inj : Function.Injective μ_X := mul_right_injective₀ Polynomial.X_ne_zero
        have hlT_inj : Function.Injective (LinearMap.lTensor L_b μ_X) :=
          Module.Flat.lTensor_preserves_injective_linearMap μ_X hμ_inj
        intro z hz
        have h0 : (LinearMap.lTensor L_b μ_X) (z ⊗ₜ[Polynomial k₀] (1 : Polynomial k₀)) = 0 := by
          apply (TensorProduct.rid (Polynomial k₀) L_b).injective
          rw [map_zero, LinearMap.lTensor_tmul]
          have hμ1 : μ_X 1 = Polynomial.X := mul_one Polynomial.X
          rw [hμ1, TensorProduct.rid_tmul, Algebra.smul_def, hz]
        have hz_tmul : z ⊗ₜ[Polynomial k₀] (1 : Polynomial k₀) = 0 :=
          hlT_inj (h0.trans (map_zero _).symm)
        simpa using congrArg (TensorProduct.rid (Polynomial k₀) L_b) hz_tmul
      have htb_pow_reg : ∀ (n : ℕ) (z : L_b), t_b ^ n * z = 0 → z = 0 := by
        intro n
        induction n with
        | zero => intro z hz; simpa using hz
        | succ n ih =>
          intro z hz
          rw [pow_succ', mul_assoc] at hz
          exact ih z (htb_reg _ hz)
      have hKrull : (⨅ n : ℕ, (IsLocalRing.maximalIdeal L_b) ^ n) = ⊥ :=
        Ideal.iInf_pow_eq_bot_of_isLocalRing (IsLocalRing.maximalIdeal L_b)
          (IsLocalRing.maximalIdeal.isMaximal L_b).ne_top
      have hUnit_pow : ∀ z : L_b, z ≠ 0 → ∃ (r : ℕ) (u : L_b), IsUnit u ∧ z = t_b ^ r * u := by
        intro z hz
        have hz_not_iInf : z ∉ ⨅ n : ℕ, (IsLocalRing.maximalIdeal L_b) ^ n := by
          rw [hKrull, Ideal.mem_bot]; exact hz
        rw [Ideal.mem_iInf, not_forall] at hz_not_iInf
        classical
        let n := Nat.find hz_not_iInf
        have hn_spec : z ∉ (IsLocalRing.maximalIdeal L_b) ^ n := Nat.find_spec hz_not_iInf
        have hn_ne_zero : n ≠ 0 := by
          intro hn0
          rw [hn0, pow_zero, Ideal.one_eq_top] at hn_spec
          exact hn_spec trivial
        obtain ⟨r, hr⟩ := Nat.exists_eq_succ_of_ne_zero hn_ne_zero
        have hr_lt : r < n := by omega
        have hz_in_r : z ∈ (IsLocalRing.maximalIdeal L_b) ^ r := by
          by_contra hnot
          exact Nat.find_min hz_not_iInf hr_lt hnot
        rw [hm_Lb, Ideal.span_singleton_pow, Ideal.mem_span_singleton] at hz_in_r
        obtain ⟨u, rfl⟩ := hz_in_r
        have hu_unit : IsUnit u := by
          rw [← IsLocalRing.notMem_maximalIdeal, hm_Lb, Ideal.mem_span_singleton]
          rintro ⟨v, rfl⟩
          apply hn_spec
          rw [hr, hm_Lb, Ideal.span_singleton_pow, Ideal.mem_span_singleton]
          exact ⟨v, by rw [Nat.succ_eq_add_one, pow_add, pow_one, mul_assoc]⟩
        exact ⟨r, u, hu_unit, rfl⟩
      have hDom_Lb : IsDomain L_b := by
        have : NoZeroDivisors L_b := ⟨fun {z₁ z₂} hmul => by
          by_contra hne
          rw [not_or] at hne
          obtain ⟨r₁, u₁, hu₁, rfl⟩ := hUnit_pow z₁ hne.1
          obtain ⟨r₂, u₂, hu₂, rfl⟩ := hUnit_pow z₂ hne.2
          have hprod : t_b ^ (r₁ + r₂) * (u₁ * u₂) = 0 := by
            calc t_b ^ (r₁ + r₂) * (u₁ * u₂) = (t_b ^ r₁ * u₁) * (t_b ^ r₂ * u₂) := by ring
              _ = 0 := hmul
          exact (hu₁.mul hu₂).ne_zero (htb_pow_reg (r₁ + r₂) (u₁ * u₂) hprod)⟩
        exact NoZeroDivisors.to_isDomain L_b
      let Q_b : Ideal B := RingHom.ker ((algebraMap B_b L_b).comp π_b)
      have hQb_prime : Q_b.IsPrime := RingHom.ker_isPrime _
      have hMin_eq : ∀ (P : Ideal B), P ∈ minimalPrimes B → P ≤ q_0.asIdeal → x_coord b ∈ P →
          P = Q_b := by
        intro P hP_min hP_le hxP
        have hQb_le : Q_b ≤ P := by
          intro y hy
          rw [RingHom.mem_ker, RingHom.comp_apply,
            IsLocalization.map_eq_zero_iff q_bar_0.primeCompl L_b] at hy
          obtain ⟨⟨s, hs_not_qbar⟩, hsy⟩ := hy
          obtain ⟨s₀, rfl⟩ := Ideal.Quotient.mk_surjective s
          have hs₀_not_P : s₀ ∉ P := fun hs₀P => hs_not_qbar (by
            change s₀ ∈ Ideal.comap π_b q_bar_0
            rw [hcomap_qbar]
            exact hP_le hs₀P)
          have hs₀y_in_P : s₀ * y ∈ P := by
            have hker_mem : s₀ * y ∈ Ideal.span {x_coord b} := by
              rw [← Ideal.Quotient.eq_zero_iff_mem, map_mul]
              exact hsy
            have hspan_le : Ideal.span {x_coord b} ≤ P := by
              rw [Ideal.span_singleton_le_iff_mem]; exact hxP
            exact hspan_le hker_mem
          exact hP_min.1.1.mem_or_mem hs₀y_in_P |>.resolve_left hs₀_not_P
        exact le_antisymm (hP_min.2 ⟨hQb_prime, bot_le⟩ hQb_le) hQb_le
      exact (hMin_eq P₁ hP₁ hP₁_le hx₁).trans (hMin_eq P₂ hP₂ hP₂_le hx₂).symm
    intro P₁ P₂ P₃ hP₁ hP₂ hP₃ hle₁ hle₂ hle₃
    have hx_or : ∀ P ∈ minimalPrimes B, x_coord 0 ∈ P ∨ x_coord 1 ∈ P :=
      fun P hP => hP.1.1.mem_or_mem (hx_mul_zero.symm ▸ P.zero_mem)
    rcases hx_or P₁ hP₁ with h10 | h11 <;>
    rcases hx_or P₂ hP₂ with h20 | h21 <;>
    rcases hx_or P₃ hP₃ with h30 | h31
    · exact Or.inl (hBranch_uniq 0 P₁ P₂ hP₁ hP₂ hle₁ hle₂ h10 h20)
    · exact Or.inl (hBranch_uniq 0 P₁ P₂ hP₁ hP₂ hle₁ hle₂ h10 h20)
    · exact Or.inr (Or.inl (hBranch_uniq 0 P₁ P₃ hP₁ hP₃ hle₁ hle₃ h10 h30))
    · exact Or.inr (Or.inr (hBranch_uniq 1 P₂ P₃ hP₂ hP₃ hle₂ hle₃ h21 h31))
    · exact Or.inr (Or.inr (hBranch_uniq 0 P₂ P₃ hP₂ hP₃ hle₂ hle₃ h20 h30))
    · exact Or.inr (Or.inl (hBranch_uniq 1 P₁ P₃ hP₁ hP₃ hle₁ hle₃ h11 h31))
    · exact Or.inl (hBranch_uniq 1 P₁ P₂ hP₁ hP₂ hle₁ hle₂ h11 h21)
    · exact Or.inl (hBranch_uniq 1 P₁ P₂ hP₁ hP₂ hle₁ hle₂ h11 h21)
  
  have nodal_tensor_iso : ∀ (R₀ k₀ : Type u) [CommRing R₀] [Field k₀] [Algebra R₀ k₀]
      (a_n : R₀), algebraMap R₀ k₀ a_n = 0 →
      let I_R : Ideal (MvPolynomial (Fin 2) R₀) :=
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a_n}
      let A_nod_R := MvPolynomial (Fin 2) R₀ ⧸ I_R
      let I_k : Ideal (MvPolynomial (Fin 2) k₀) :=
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}
      let A_nod_k := MvPolynomial (Fin 2) k₀ ⧸ I_k
      ∃ (θ_fwd : TensorProduct R₀ A_nod_R k₀ →+* A_nod_k)
        (θ_inv : A_nod_k →+* TensorProduct R₀ A_nod_R k₀),
        θ_fwd.comp θ_inv = RingHom.id A_nod_k ∧
        θ_inv.comp θ_fwd = RingHom.id (TensorProduct R₀ A_nod_R k₀) ∧
        ∀ b : Fin 2, θ_inv (Ideal.Quotient.mk I_k (MvPolynomial.X b)) =
          (Ideal.Quotient.mk I_R (MvPolynomial.X b)) ⊗ₜ[R₀] (1 : k₀) := by
    intro R₀ k₀ _ _ _ a_n h_an_zero I_R A_nod_R I_k A_nod_k
    have h_IR_le : I_R ≤ RingHom.ker ((Ideal.Quotient.mk I_k).comp
        (MvPolynomial.map (algebraMap R₀ k₀))) := by
      rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker, RingHom.comp_apply,
        Ideal.Quotient.eq_zero_iff_mem]
      simp only [map_sub, map_mul, MvPolynomial.map_X, MvPolynomial.map_C, h_an_zero,
        map_zero, sub_zero]
      exact Ideal.subset_span (Set.mem_singleton _)
    let φ_Rk_nod : A_nod_R →+* A_nod_k :=
      Ideal.Quotient.lift I_R ((Ideal.Quotient.mk I_k).comp (MvPolynomial.map (algebraMap R₀ k₀)))
        h_IR_le
    let c_nod_k : k₀ →+* A_nod_k := (Ideal.Quotient.mk I_k).comp MvPolynomial.C
    let _ : Algebra R₀ A_nod_k := (c_nod_k.comp (algebraMap R₀ k₀)).toAlgebra
    let f_left_nod : A_nod_R →ₐ[R₀] A_nod_k :=
      { toRingHom := φ_Rk_nod
        commutes' := fun r => by
          change Ideal.Quotient.mk I_k ((MvPolynomial.map (algebraMap R₀ k₀)) (MvPolynomial.C r)) =
            Ideal.Quotient.mk I_k (MvPolynomial.C (algebraMap R₀ k₀ r))
          rw [MvPolynomial.map_C] }
    let f_right_nod : k₀ →ₐ[R₀] A_nod_k :=
      { toRingHom := c_nod_k
        commutes' := fun _ => rfl }
    let θ_fwd : TensorProduct R₀ A_nod_R k₀ →+* A_nod_k :=
      (Algebra.TensorProduct.productMap f_left_nod f_right_nod).toRingHom
    let ev_inv_raw :=
      MvPolynomial.eval₂Hom
        (Algebra.TensorProduct.includeRight : k₀ →ₐ[R₀] TensorProduct R₀ A_nod_R k₀).toRingHom
        (fun b => (Algebra.TensorProduct.includeLeft :
          A_nod_R →ₐ[R₀] TensorProduct R₀ A_nod_R k₀) (Ideal.Quotient.mk I_R (MvPolynomial.X b)))
    have h_Ik_le : I_k ≤ RingHom.ker ev_inv_raw := by
      rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
      simp only [ev_inv_raw, map_mul, MvPolynomial.eval₂Hom_X']
      change (Ideal.Quotient.mk I_R (MvPolynomial.X 0) ⊗ₜ[R₀] (1 : k₀)) *
        (Ideal.Quotient.mk I_R (MvPolynomial.X 1) ⊗ₜ[R₀] (1 : k₀)) = 0
      rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, ← map_mul]
      have hX01 : Ideal.Quotient.mk I_R (MvPolynomial.X 0 * MvPolynomial.X 1) =
          Ideal.Quotient.mk I_R (MvPolynomial.C a_n) := by
        rw [Ideal.Quotient.eq]
        exact Ideal.subset_span (Set.mem_singleton _)
      rw [hX01]
      have han_smul : Ideal.Quotient.mk I_R (MvPolynomial.C a_n) = a_n • (1 : A_nod_R) := by
        rw [Algebra.smul_def a_n (1 : A_nod_R), mul_one]; rfl
      rw [han_smul, TensorProduct.smul_tmul (R := R₀) a_n (1 : A_nod_R) (1 : k₀)]
      have han_k : a_n • (1 : k₀) = 0 := by
        rw [Algebra.smul_def, mul_one, h_an_zero]
      rw [han_k, TensorProduct.tmul_zero]
    let θ_inv : A_nod_k →+* TensorProduct R₀ A_nod_R k₀ :=
      Ideal.Quotient.lift I_k ev_inv_raw h_Ik_le
