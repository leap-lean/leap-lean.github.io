      have hcomp : φ_e.comp (algebraMap A_a0 L_e) = φ_top.hom :=
        RingHom.ext fun y => IsLocalization.Away.lift_eq (S := L_e) (1 : A_a0) hφe_unit y
      have hhom : CommRingCat.ofHom (algebraMap A_a0 L_e) ≫ CommRingCat.ofHom φ_e = φ_top :=
        CommRingCat.hom_ext hcomp
      rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp, hhom, hφ_η]
    let B_0 : Fin N → Set ↥Y_M0 := fun i => if i = i_top then C_br 0 else C_br 1
    have hB0_top : B_0 i_top = C_br 0 := by simp [B_0]
    have hB0_bot : B_0 i_bot = C_br 1 := by simp [B_0, htop_ne_bot.symm]
    refine ⟨B_0, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · refine ⟨hSS_M0, inferInstance, CategoryTheory.Category.id_comp g_M0,
        CategoryTheory.Category.comp_id η_M0, isClosed_empty, inferInstance,
        fun _ hy => False.elim hy, ?_, ?_,
        fun i hi => absurd (hAllBd i) hi, ?_, ?_, ?_,
        fun i _ _ hi => absurd (hAllBd i) hi,
        fun i hi => absurd (hAllBd i) hi⟩
      · intro i j hij
        rcases hi_cases i with rfl | rfl <;> rcases hi_cases j with rfl | rfl
        · rfl
        · rw [hB0_top, hB0_bot] at hij; exact absurd hij hC0_ne_C1
        · rw [hB0_bot, hB0_top] at hij; exact absurd hij.symm hC0_ne_C1
        · rfl
      · intro i
        rcases hi_cases i with rfl | rfl
        · rw [hB0_top]; exact hC_comp 0
        · rw [hB0_bot]; exact hC_comp 1
      · intro i _
        rcases hi_cases i with rfl | rfl
        · rw [hB0_top]
          obtain ⟨_, q_gen, hq_in, _, hq_ne⟩ := hC_branch_pkg 0
          exact ⟨q_gen, hq_in, hq_ne⟩
        · rw [hB0_bot]
          obtain ⟨_, q_gen, hq_in, _, hq_ne⟩ := hC_branch_pkg 1
          exact ⟨q_gen, hq_in, hq_ne⟩
      · intro E hE hE_m0
        rcases hC_exh E hE with rfl | rfl
        · obtain ⟨_, q_gen, hq_in, _, hq_ne⟩ := hC_branch_pkg 0
          exact absurd (hE_m0 q_gen hq_in) hq_ne
        · obtain ⟨_, q_gen, hq_in, _, hq_ne⟩ := hC_branch_pkg 1
          exact absurd (hE_m0 q_gen hq_in) hq_ne
      · intro i j hcov
        obtain ⟨rfl, rfl⟩ := (hCov_iff i j).mp hcov
        rw [hB0_top, hB0_bot]
        exact hq₀_unique
    · ext q
      simp only [Set.mem_iUnion, Set.mem_univ, iff_true]
      have hq : q ∈ C_br 0 ∪ C_br 1 := by rw [hC_union]; trivial
      rcases hq with h0 | h1
      · exact ⟨i_top, by rwa [hB0_top]⟩
      · exact ⟨i_bot, by rwa [hB0_bot]⟩
    · intro i j hij hnot1 hnot2
      rcases hi_cases i with rfl | rfl <;> rcases hi_cases j with rfl | rfl
      · exact absurd rfl hij
      · exact absurd hCov_top_bot hnot1
      · exact absurd hCov_top_bot hnot2
      · exact absurd rfl hij
    · intro i hNotBot c_tilde hc_tilde
      have hi : i = i_top := by
        rcases hi_cases i with h | rfl
        · exact h
        · exfalso
          exact hNotBot ⟨a₀, ha_some, by rw [hc_bot, hπ_bot]; exact disc_eq_refl 0 a₀⟩
      subst hi
      have hct_not_mR : c_tilde ∉ m_R := by
        have h0_sub : (0 : ↥R) - c_tilde ∉ m_R :=
          hc_tilde i_bot hCov_top_bot 0 (by simp [hc_top, hc_bot])
        rw [zero_sub, Ideal.neg_mem_iff] at h0_sub
        exact h0_sub
      refine ⟨Polynomial.X, ι_0, φ_0, by rwa [Polynomial.eval_X], hOpen_0, hι0_g, hφ0_η, ?_, ?_⟩
      · rw [hc_top, hπ_top, hφ0_X]
        simp
      · intro p k hp
        obtain ⟨_, hin0, hnot1⟩ := hι0_fib p hp
        rcases hi_cases k with rfl | rfl
        · rw [hB0_top]; exact ⟨fun _ => rfl, fun _ => hin0⟩
        · rw [hB0_bot]; exact ⟨fun h => absurd h hnot1, fun h => absurd h.symm htop_ne_bot⟩
    · intro i a₀' ha' _
      rw [ha_some] at ha'; injection ha' with h_eq; subst h_eq
      have hi : i = i_bot := hTree.2.1 i i_bot (by rwa [hc_bot, hπ_bot])
      subst hi
      let ev_LX1 : MvPolynomial (Fin 2) ↥R →+* L_X :=
        MvPolynomial.eval₂Hom ((algebraMap (Polynomial ↥R) L_X).comp Polynomial.C)
          (fun j => if j = (1 : Fin 2) then algebraMap (Polynomial ↥R) L_X Polynomial.X
            else algebraMap (Polynomial ↥R) L_X (Polynomial.C a₀) * x_inv)
      let α_bar1 : A_a0 →+* L_X := Ideal.Quotient.lift I_a0 ev_LX1 hker_LX1
      let ι_1 : AlgebraicGeometry.Spec (CommRingCat.of L_X) ⟶ M_0 :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_bar1) ≫ iso.inv
      refine ⟨Polynomial.X, ι_1, by rw [Polynomial.eval_X]; exact h1_not_mR, hOpen_1, hι1_g,
        fun p hp => (hι1_fib p hp).1, ?_⟩
      intro p k hp
      obtain ⟨_, hin1, hnot0⟩ := hι1_fib p hp
      rcases hi_cases k with rfl | rfl
      · rw [hB0_top]; exact ⟨fun h => absurd h hnot0, fun h => absurd h htop_ne_bot⟩
      · rw [hB0_bot]; exact ⟨fun _ => rfl, fun _ => hin1⟩
    · intro i_p i_c hcov
      obtain ⟨rfl, rfl⟩ := (hCov_iff i_p i_c).mp hcov
      refine ⟨0, a₀, ⟨0, by simp [hc_bot]⟩, by simp [hπ_bot, hπ_top], ha₀_ne, ha₀_mem,
        1, ι_e, φ_e, h1_not_nod, hOpen_e, hιe_g, hφe_η, ?_, ?_, ?_⟩
      · rw [hπ_top]
        have hX0 : φ_e (algebraMap A_a0 L_e (u 0)) = T_0 :=
          (IsLocalization.Away.lift_eq (S := L_e) (1 : A_a0) hφe_unit (u 0)).trans hφ_X0
        rw [hX0]
        simp
      · rw [hπ_bot]
        have hX1 : φ_e (algebraMap A_a0 L_e (u 1)) = φ_top.hom (u 1) :=
          IsLocalization.Away.lift_eq (S := L_e) (1 : A_a0) hφe_unit (u 1)
        rw [hX1, map_zero, map_zero, sub_zero]
        exact hTU1
      · intro p k hp
        obtain ⟨q_p, hqp_fst⟩ := (hfst_range (ι_e.base p)).mpr hp
        have hiso_qp : (iso.hom.base (fst_R.base q_p)).asIdeal =
            Ideal.comap (algebraMap A_a0 L_e) p.asIdeal := by
          rw [hqp_fst]
          dsimp [ι_e]
          change ((iso.inv ≫ iso.hom).base (PrimeSpectrum.comap _ p)).asIdeal = _
          rw [iso.inv_hom_id]; rfl
        have hmem_iff : ∀ S : Set ↥Y_M0, ι_e.base p ∈ fst_R.base '' S ↔ q_p ∈ S := by
          intro S
          constructor
          · rintro ⟨q', hq', hq'_eq⟩
            rwa [← hfst_inj (hq'_eq.trans hqp_fst.symm)]
          · exact fun hqp => ⟨q_p, hqp, hqp_fst⟩
        rcases hi_cases k with rfl | rfl
        · rw [hB0_top, hmem_iff]
          simp only [true_and, htop_ne_bot, false_and, or_false]
          change u 1 ∈ (iso.hom.base (fst_R.base q_p)).asIdeal ↔ _
          rw [hiso_qp]; rfl
        · rw [hB0_bot, hmem_iff]
          simp only [htop_ne_bot.symm, false_and, true_and, false_or]
          change u 0 ∈ (iso.hom.base (fst_R.base q_p)).asIdeal ↔ _
          rw [hiso_qp]; rfl

theorem weil_standard_etale_bridge_and_contracted_component_transcendence (K : Type u) [Field K]
    (m : ℕ) (R : ValuationSubring K) (hPkg_R : IsValuationRingAlgPackage m R)
    (hMax_R : IsLocalRing.maximalIdeal ↥R ≠ ⊥)
    (a_opt : Option ↥R)
    (M_0 W_B_sch X_0_sch : AlgebraicGeometry.Scheme.{u})
    (g_M0 : M_0 ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
    (g_WB : W_B_sch ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
    (f_0 : X_0_sch ⟶ W_B_sch)
    (m_0 : ↥M_0) (u₀_WB : ↥W_B_sch)
    (e_0 : W_B_sch ⟶ M_0)
    (F_0 F_WB : Type u) [Field F_0] [Field F_WB]
    (η_M0 : AlgebraicGeometry.Spec (CommRingCat.of F_0) ⟶ M_0)
    (η_WB : AlgebraicGeometry.Spec (CommRingCat.of F_WB) ⟶ W_B_sch)
    (η_X0 : AlgebraicGeometry.Spec (CommRingCat.of F_WB) ⟶ X_0_sch)
    (φ_KF0 : K →+* F_0) (φ_F0_FWB : F_0 →+* F_WB) (T_0 : F_0)
    (hAff_WB : AlgebraicGeometry.IsAffine W_B_sch)
    (hSS_X0 : IsStrictlySemistableCurveOverValuation R (f_0 ≫ g_WB))
    (hStd : IsStandardModelCoordDatum R a_opt M_0 g_M0 m_0 η_M0 φ_KF0 T_0)
    (hEt_e0 : AlgebraicGeometry.Etale e_0)
    (he0_comm : e_0 ≫ g_M0 = g_WB)
    (he0_m0 : e_0.base ⁻¹' {m_0} = {u₀_WB})
    (hFunc_WB : IsSchemeFunctionField W_B_sch F_WB η_WB)
    (hFunc_X0 : IsSchemeFunctionField X_0_sch F_WB η_X0)
    (hηX0_f0 : η_X0 ≫ f_0 = η_WB)
    (hη_e0 : η_WB ≫ e_0 = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_F0_FWB) ≫ η_M0) :
    let A_0 : Type u := ↑(M_0.presheaf.obj (Opposite.op ⊤))
    let B : Type u := ↑(W_B_sch.presheaf.obj (Opposite.op ⊤))
    let α_0 : A_0 →+* B := (e_0.appTop).hom
    let s_R := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.maximalIdeal ↥R).ResidueField))
    let g_X0 := f_0 ≫ g_WB
    ∃ (instDomA0 : IsDomain A_0) (instDomB : IsDomain B)
      (φ_A0 : A_0 →+* F_0) (φ_B : B →+* F_WB)
      (p_0 : Ideal A_0) (q_0 : Ideal B),
      (α_0.Etale ∧
        @IsFractionRing A_0 _ F_0 _ φ_A0.toAlgebra ∧
        @IsFractionRing B _ F_WB _ φ_B.toAlgebra ∧
        φ_B.comp α_0 = φ_F0_FWB.comp φ_A0 ∧
        p_0.IsMaximal ∧
        q_0.IsPrime ∧
        Ideal.map α_0 p_0 = q_0 ∧
        (∀ b : B, ∃ a : A_0, b - α_0 a ∈ q_0)) ∧
      (∀ z : F_0, ∃ P Q : Polynomial ↥R,
        Polynomial.eval₂ (φ_KF0.comp R.subtype) T_0 Q ≠ 0 ∧
        z * Polynomial.eval₂ (φ_KF0.comp R.subtype) T_0 Q =
          Polynomial.eval₂ (φ_KF0.comp R.subtype) T_0 P) ∧
      (∀ (W : ValuationSubring F_WB)
         (ψ_WB : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ W_B_sch)
         (mW : AlgebraicGeometry.Spec (CommRingCat.of ↥W)),
        mW.asIdeal = IsLocalRing.maximalIdeal ↥W →
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype) ≫ ψ_WB = η_WB →
        ψ_WB.base mW = u₀_WB →
        (∀ b : B, φ_B b ∈ W) ∧
        (∀ a : A_0, ∃ ha : φ_A0 a ∈ W.comap φ_F0_FWB,
          a ∈ p_0 →
            (⟨φ_A0 a, ha⟩ : ↥(W.comap φ_F0_FWB)) ∈
              IsLocalRing.maximalIdeal ↥(W.comap φ_F0_FWB)) ∧
        (∃ hT0 : T_0 ∈ W.comap φ_F0_FWB,
          (⟨T_0, hT0⟩ : ↥(W.comap φ_F0_FWB)) ∈
            IsLocalRing.maximalIdeal ↥(W.comap φ_F0_FWB)) ∧
        (∀ a₀ : ↥R, a_opt = some a₀ →
          a₀ ≠ 0 ∧
          ∃ v₁ : ↥(W.comap φ_F0_FWB),
            v₁ ∈ IsLocalRing.maximalIdeal ↥(W.comap φ_F0_FWB) ∧
            T_0 * (W.comap φ_F0_FWB).subtype v₁ = φ_KF0 (R.subtype a₀))) ∧
      (∀ E ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_X0 s_R),
        (∀ q ∈ E, f_0.base ((CategoryTheory.Limits.pullback.fst g_X0 s_R).base q) = u₀_WB) →
        ∀ W : ValuationSubring F_WB,
          IsComponentStalkVal R g_X0 η_X0 E W →
          ∃ (ψ_WB : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ W_B_sch)
            (mW : AlgebraicGeometry.Spec (CommRingCat.of ↥W))
            (hR : ∀ r : ↥R, (φ_F0_FWB.comp φ_KF0) (R.subtype r) ∈ W)
            (u_W : ↥W),
            mW.asIdeal = IsLocalRing.maximalIdeal ↥W ∧
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype) ≫ ψ_WB = η_WB ∧
            ψ_WB.base mW = u₀_WB ∧
            (∀ r : ↥R,
              (⟨(φ_F0_FWB.comp φ_KF0) (R.subtype r), hR r⟩ : ↥W) ∈
                IsLocalRing.maximalIdeal ↥W ↔
                r ∈ IsLocalRing.maximalIdeal ↥R) ∧
            (∀ Q : Polynomial ↥R,
              (∃ j : ℕ, Q.coeff j ∉ IsLocalRing.maximalIdeal ↥R) →
              Polynomial.eval₂
                (((φ_F0_FWB.comp φ_KF0).comp R.subtype).codRestrict W.toSubring hR)
                u_W Q ∉ IsLocalRing.maximalIdeal ↥W)) :=
by
  classical
  dsimp only
  have hPillar1 :
      let A_0 : Type u := ↑(M_0.presheaf.obj (Opposite.op ⊤))
      ∃ (hAff_M0 : AlgebraicGeometry.IsAffine M_0)
        (instDomA0 : IsDomain A_0)
        (φ_A0 : A_0 →+* F_0)
        (p_0 : Ideal A_0)
        (ev_A0 : A_0 →+* (IsLocalRing.maximalIdeal ↥R).ResidueField),
        p_0 = ((@AlgebraicGeometry.Scheme.isoSpec M_0 hAff_M0).hom.base m_0).asIdeal ∧
        @IsFractionRing A_0 _ F_0 _ φ_A0.toAlgebra ∧
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_A0) ≫
          (@AlgebraicGeometry.Scheme.isoSpec M_0 hAff_M0).inv = η_M0 ∧
        Function.Surjective ev_A0 ∧
        RingHom.ker ev_A0 = p_0 ∧
        (∀ z : F_0, ∃ P Q : Polynomial ↥R,
          Polynomial.eval₂ (φ_KF0.comp R.subtype) T_0 Q ≠ 0 ∧
          z * Polynomial.eval₂ (φ_KF0.comp R.subtype) T_0 Q =
            Polynomial.eval₂ (φ_KF0.comp R.subtype) T_0 P) ∧
        (∃ t_A0 : A_0, t_A0 ∈ p_0 ∧ φ_A0 t_A0 = T_0) ∧
        (∀ a₀ : ↥R, a_opt = some a₀ →
          a₀ ≠ 0 ∧ ∃ u1_A0 : A_0, u1_A0 ∈ p_0 ∧ T_0 * φ_A0 u1_A0 = φ_KF0 (R.subtype a₀)) := by
    dsimp only
    let m_R : Ideal ↥R := IsLocalRing.maximalIdeal ↥R
    have _ : m_R.IsMaximal := IsLocalRing.maximalIdeal.isMaximal ↥R
    let k_R : Type u := m_R.ResidueField
    let q_R : ↥R →+* k_R := algebraMap ↥R k_R
    have hqR_ker : RingHom.ker q_R = m_R := Ideal.ker_algebraMap_residueField m_R
    have hqR_mem : ∀ r : ↥R, q_R r = 0 ↔ r ∈ m_R := fun r => by
      change r ∈ RingHom.ker q_R ↔ r ∈ m_R
      exact Eq.to_iff (congrArg (r ∈ ·) hqR_ker)
    have hqR_surj : Function.Surjective q_R := by
      intro c
      obtain ⟨xbar, rfl⟩ := (Ideal.bijective_algebraMap_quotient_residueField m_R).2 c
      obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective xbar
      exact ⟨r, (IsScalarTower.algebraMap_apply ↥R (↥R ⧸ m_R) k_R r).symm⟩
    obtain ⟨hFunc_M0, hηM0_g, hBranches⟩ := hStd
    have hAff_M0 : AlgebraicGeometry.IsAffine M_0 := by
      rcases hBranches with ⟨_, iso, _, _⟩ | ⟨_, iso, _, _, _, _, _⟩
      · exact AlgebraicGeometry.isAffine_of_isAffineHom iso.hom
      · exact AlgebraicGeometry.isAffine_of_isAffineHom iso.hom
    let _ : AlgebraicGeometry.IsAffine M_0 := hAff_M0
    let A_0 : Type u := ↑(M_0.presheaf.obj (Opposite.op ⊤))
    have hTop_M0 : AlgebraicGeometry.IsAffineOpen (⊤ : M_0.Opens) :=
      AlgebraicGeometry.isAffineOpen_top M_0
    obtain ⟨φ_cat, hFrac_A0, hη_top⟩ := hFunc_M0 ⊤ hTop_M0 ⟨⟨m_0, trivial⟩⟩
    let φ_A0 : A_0 →+* F_0 := φ_cat.hom
    have hη_A0 : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_A0) ≫ M_0.isoSpec.inv = η_M0 := by
      rw [← AlgebraicGeometry.IsAffineOpen.fromSpec_top]
      exact hη_top
    have hInj_A0 : Function.Injective φ_A0 := by
      let _ : Algebra A_0 F_0 := φ_A0.toAlgebra
      exact @IsFractionRing.injective A_0 _ F_0 _ _ hFrac_A0
    have instDomA0 : IsDomain A_0 := Function.Injective.isDomain φ_A0 hInj_A0
    let p_0 : Ideal A_0 := (M_0.isoSpec.hom.base m_0).asIdeal
    have hTransport : ∀ (R_cat : CommRingCat.{u})
        (iso : M_0 ≅ AlgebraicGeometry.Spec R_cat)
        (φ_top : R_cat ⟶ CommRingCat.of F_0),
        AlgebraicGeometry.Spec.map φ_top ≫ iso.inv = η_M0 →
        ∃ θ : ↑R_cat ≃+* A_0,
          φ_A0.comp θ.toRingHom = φ_top.hom ∧
          (∀ y : ↑R_cat, θ y ∈ p_0 ↔ y ∈ (iso.hom.base m_0).asIdeal) ∧
          Ideal.comap θ.symm.toRingHom (iso.hom.base m_0).asIdeal = p_0 := by
      intro R_cat iso φ_top hφ_η
      let θ_hom : R_cat ⟶ M_0.presheaf.obj (Opposite.op ⊤) :=
        AlgebraicGeometry.Spec.preimage (M_0.isoSpec.inv ≫ iso.hom)
      let θ_inv : M_0.presheaf.obj (Opposite.op ⊤) ⟶ R_cat :=
        AlgebraicGeometry.Spec.preimage (iso.inv ≫ M_0.isoSpec.hom)
      have h_hom_inv : θ_hom ≫ θ_inv = 𝟙 _ := by
        apply AlgebraicGeometry.Spec.map_injective
        rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
          AlgebraicGeometry.Spec.map_preimage, AlgebraicGeometry.Spec.map_id]
        simp [Category.assoc]
      have h_inv_hom : θ_inv ≫ θ_hom = 𝟙 _ := by
        apply AlgebraicGeometry.Spec.map_injective
        rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
          AlgebraicGeometry.Spec.map_preimage, AlgebraicGeometry.Spec.map_id]
        simp [Category.assoc]
      let θ : ↑R_cat ≃+* A_0 :=
        { toFun := θ_hom.hom
          invFun := θ_inv.hom
          left_inv := fun x => congrFun (congrArg DFunLike.coe (congrArg CommRingCat.Hom.hom h_hom_inv)) x
          right_inv := fun x => congrFun (congrArg DFunLike.coe (congrArg CommRingCat.Hom.hom h_inv_hom)) x
          map_mul' := θ_hom.hom.map_mul
          map_add' := θ_hom.hom.map_add }
      have hφ_θ : θ_hom ≫ φ_cat = φ_top := by
        apply AlgebraicGeometry.Spec.map_injective
        rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage]
        calc AlgebraicGeometry.Spec.map φ_cat ≫ (M_0.isoSpec.inv ≫ iso.hom)
            = (AlgebraicGeometry.Spec.map φ_cat ≫ hTop_M0.fromSpec) ≫ iso.hom := by
                rw [AlgebraicGeometry.IsAffineOpen.fromSpec_top, Category.assoc]
          _ = η_M0 ≫ iso.hom := by rw [hη_top]
          _ = (AlgebraicGeometry.Spec.map φ_top ≫ iso.inv) ≫ iso.hom := by rw [← hφ_η]
          _ = AlgebraicGeometry.Spec.map φ_top := by simp [Category.assoc]
      have hiso_θ : M_0.isoSpec.hom ≫ AlgebraicGeometry.Spec.map θ_hom = iso.hom := by
        rw [AlgebraicGeometry.Spec.map_preimage, ← Category.assoc, Iso.hom_inv_id, Category.id_comp]
      have hiso_θ_inv : iso.hom ≫ AlgebraicGeometry.Spec.map θ_inv = M_0.isoSpec.hom := by
        rw [AlgebraicGeometry.Spec.map_preimage, ← Category.assoc, Iso.hom_inv_id, Category.id_comp]
      refine ⟨θ, congrArg CommRingCat.Hom.hom hφ_θ, ?_, ?_⟩
      · intro y
        have hpt : (AlgebraicGeometry.Spec.map θ_hom).base (M_0.isoSpec.hom.base m_0) =
            iso.hom.base m_0 := by
          change (M_0.isoSpec.hom ≫ AlgebraicGeometry.Spec.map θ_hom).base m_0 = iso.hom.base m_0
          rw [hiso_θ]
        have hid : Ideal.comap θ_hom.hom p_0 = (iso.hom.base m_0).asIdeal :=
          congrArg PrimeSpectrum.asIdeal hpt
        rw [← hid]
        rfl
      · have hpt : (AlgebraicGeometry.Spec.map θ_inv).base (iso.hom.base m_0) =
            M_0.isoSpec.hom.base m_0 := by
          change (iso.hom ≫ AlgebraicGeometry.Spec.map θ_inv).base m_0 = M_0.isoSpec.hom.base m_0
          rw [hiso_θ_inv]
