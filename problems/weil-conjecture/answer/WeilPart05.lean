    rw [← CategoryTheory.cancel_epi erest.hom,
      AlgebraicGeometry.pullbackRestrictIsoRestrict_hom_morphismRestrict]
    simp only [CategoryTheory.Iso.trans_hom, CategoryTheory.Iso.symm_hom,
      CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id_assoc]
