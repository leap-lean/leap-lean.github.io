    let _ : Algebra P_1 B_K := g.toAlgebra
    have : IsScalarTower K P_1 B_K :=
      IsScalarTower.of_algebraMap_eq' hg_C.symm
    have : Algebra.Etale P_1 B_K := hg_et.toAlgebra
    have : Algebra.FiniteType P_1 B_K := inferInstance
    have : Algebra.FiniteType K B_K :=
      Algebra.FiniteType.trans (R := K) (S := P_1) (A := B_K) inferInstance inferInstance
    have : Algebra.EssFiniteType K B_K := Algebra.EssFiniteType.of_finiteType K B_K
    have : Algebra.EssFiniteType B_K F :=
