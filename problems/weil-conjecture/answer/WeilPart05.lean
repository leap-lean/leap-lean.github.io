    · 
      let I_a0 : Ideal (MvPolynomial (Fin 2) ↥R) :=
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a₀}
      let A_0 := MvPolynomial (Fin 2) ↥R ⧸ I_a0
