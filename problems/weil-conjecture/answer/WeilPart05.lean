  let snd_R := CategoryTheory.Limits.pullback.snd g_X0 s_R
  let fst_P := CategoryTheory.Limits.pullback.fst g_cur s_P
  let snd_P := CategoryTheory.Limits.pullback.snd g_cur s_P
  let j_pb : Y_X0 ⟶ Y_P :=
    CategoryTheory.Limits.pullback.map g_X0 s_R g_cur s_P X_0.ι iso_k.hom j_RV hComm_X0 hs_comm
  have hPb_j : CategoryTheory.IsPullback j_pb fst_R fst_P X_0.ι := by
    refine { w := CategoryTheory.Limits.pullback.lift_fst _ _ _, isLimit' := ⟨?_⟩ }
    refine CategoryTheory.Limits.PullbackCone.IsLimit.mk _
      (fun c => CategoryTheory.Limits.pullback.lift c.snd (c.fst ≫ snd_P ≫ iso_k.inv) ?_)
      (fun c => ?_)
      (fun c => CategoryTheory.Limits.pullback.lift_fst _ _ _)
      (fun c m' hm1 hm2 => ?_)
    · apply (CategoryTheory.cancel_mono j_RV).mp
      calc (c.snd ≫ g_X0) ≫ j_RV
          = c.snd ≫ (g_X0 ≫ j_RV) := CategoryTheory.Category.assoc _ _ _
        _ = c.snd ≫ (X_0.ι ≫ g_cur) := by rw [hComm_X0]
        _ = (c.snd ≫ X_0.ι) ≫ g_cur := (CategoryTheory.Category.assoc _ _ _).symm
        _ = (c.fst ≫ fst_P) ≫ g_cur := by rw [c.condition]
        _ = c.fst ≫ (fst_P ≫ g_cur) := CategoryTheory.Category.assoc _ _ _
        _ = c.fst ≫ (snd_P ≫ s_P) := by rw [CategoryTheory.Limits.pullback.condition]
        _ = c.fst ≫ snd_P ≫ (iso_k.inv ≫ iso_k.hom) ≫ s_P := by
              rw [iso_k.inv_hom_id, CategoryTheory.Category.id_comp]
        _ = c.fst ≫ snd_P ≫ iso_k.inv ≫ (iso_k.hom ≫ s_P) := by
              simp only [CategoryTheory.Category.assoc]
        _ = c.fst ≫ snd_P ≫ iso_k.inv ≫ (s_R ≫ j_RV) := by rw [← hs_comm]
        _ = ((c.fst ≫ snd_P ≫ iso_k.inv) ≫ s_R) ≫ j_RV := by
              simp only [CategoryTheory.Category.assoc]
    · apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst, c.condition]
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
          iso_k.inv_hom_id, CategoryTheory.Category.comp_id]
    · apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Limits.pullback.lift_fst, hm2]
      · rw [CategoryTheory.Limits.pullback.lift_snd]
        calc m' ≫ snd_R
            = m' ≫ snd_R ≫ (iso_k.hom ≫ iso_k.inv) := by
                rw [iso_k.hom_inv_id, CategoryTheory.Category.comp_id]
          _ = m' ≫ (j_pb ≫ snd_P) ≫ iso_k.inv := by
                rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.assoc]
          _ = (m' ≫ j_pb) ≫ snd_P ≫ iso_k.inv := by
                simp only [CategoryTheory.Category.assoc]
          _ = c.fst ≫ snd_P ≫ iso_k.inv := by rw [hm1]

  haveI : AlgebraicGeometry.IsOpenImmersion j_pb :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      hPb_j.flip inferInstance
  let j : ↥Y_X0 → ↥Y_P := j_pb.base
  have hj : Topology.IsOpenEmbedding j := j_pb.isOpenEmbedding
  let U_pb : Set ↥Y_P := Set.range j
  have hU_open : IsOpen U_pb := hj.isOpen_range
  have hRange_jpb : U_pb = fst_P.base ⁻¹' (X_0 : Set ↥C_cur) := by
    have h1 : j_pb = hPb_j.isoPullback.hom ≫
        CategoryTheory.Limits.pullback.fst fst_P X_0.ι :=
      hPb_j.isoPullback_hom_fst.symm
    have hSurj_iso : Function.Surjective hPb_j.isoPullback.hom.base :=
      (ConcreteCategory.bijective_of_isIso hPb_j.isoPullback.hom.base).2
    change Set.range j_pb.base = _
    rw [h1]
    change Set.range ((CategoryTheory.Limits.pullback.fst fst_P X_0.ι).base ∘
      hPb_j.isoPullback.hom.base) = _
    rw [Set.range_comp, hSurj_iso.range_eq, Set.image_univ,
      AlgebraicGeometry.Scheme.Pullback.range_fst, AlgebraicGeometry.Scheme.Opens.range_ι]

  
  have hPreirred_pre : ∀ {S : Set ↥Y_P}, IsPreirreducible S → IsPreirreducible (j ⁻¹' S) := by
    intro S hS u v hu hv ⟨x₁, hx₁S, hx₁u⟩ ⟨x₂, hx₂S, hx₂v⟩
    obtain ⟨y, hyS, ⟨z₁, hz₁u, rfl⟩, ⟨z₂, hz₂v, hz₂eq⟩⟩ :=
      hS (j '' u) (j '' v) (hj.isOpenMap u hu) (hj.isOpenMap v hv)
        ⟨j x₁, hx₁S, x₁, hx₁u, rfl⟩ ⟨j x₂, hx₂S, x₂, hx₂v, rfl⟩
    cases hj.injective hz₂eq
    exact ⟨z₁, hyS, hz₁u, hz₂v⟩

  have hPhi_mem : ∀ {E_0 : Set ↥Y_X0}, E_0 ∈ irreducibleComponents ↥Y_X0 →
      closure (j '' E_0) ∈ irreducibleComponents ↥Y_P ∧
      j ⁻¹' closure (j '' E_0) = E_0 := by
    intro E_0 hE0
    have hE0_cl : IsClosed E_0 := isClosed_of_mem_irreducibleComponents E_0 hE0
    have hpre : j ⁻¹' closure (j '' E_0) = E_0 :=
      (hj.isEmbedding.closure_eq_preimage_closure_image E_0).symm.trans hE0_cl.closure_eq
    obtain ⟨q₀, hq₀⟩ := hE0.1.nonempty
    refine ⟨⟨(hE0.1.image j hj.continuous.continuousOn).closure, ?_⟩, hpre⟩
    intro T hT hSub
    have hE0_sub_pre : E_0 ⊆ j ⁻¹' closure T := by
      rw [← hpre]
      exact Set.preimage_mono (hSub.trans subset_closure)
    have hpreT_irred : IsIrreducible (j ⁻¹' closure T) :=
      ⟨⟨q₀, hE0_sub_pre hq₀⟩, hPreirred_pre hT.closure.isPreirreducible⟩
    have hpreT_le : j ⁻¹' closure T ⊆ E_0 := hE0.2 hpreT_irred hE0_sub_pre
    intro t ht
    by_contra ht_not
    obtain ⟨w, hw_clT, hw_compl, ⟨z, rfl⟩⟩ :=
      hT.closure.isPreirreducible (closure (j '' E_0))ᶜ U_pb
        isClosed_closure.isOpen_compl hU_open
        ⟨t, subset_closure ht, ht_not⟩
        ⟨j q₀, subset_closure (hSub (subset_closure ⟨q₀, hq₀, rfl⟩)), q₀, rfl⟩
    exact hw_compl (subset_closure ⟨z, hpreT_le hw_clT, rfl⟩)

  have hPsi_mem : ∀ {E : Set ↥Y_P}, E ∈ irreducibleComponents ↥Y_P →
      (E ∩ U_pb).Nonempty →
      j ⁻¹' E ∈ irreducibleComponents ↥Y_X0 ∧ closure (j '' (j ⁻¹' E)) = E := by
    rintro E hE ⟨_, hqE, ⟨q₀, rfl⟩⟩
    have hE_cl : IsClosed E := isClosed_of_mem_irreducibleComponents E hE
    have hPsi_irred : IsIrreducible (j ⁻¹' E) :=
      ⟨⟨q₀, hqE⟩, hPreirred_pre hE.1.isPreirreducible⟩
    have hCl_eq : closure (j '' (j ⁻¹' E)) = E := by
      apply Set.Subset.antisymm (closure_minimal (Set.image_preimage_subset j E) hE_cl)
      intro y hy
      by_contra hy_not
      obtain ⟨w, hwE, hw_compl, ⟨z, rfl⟩⟩ :=
        hE.1.isPreirreducible (closure (j '' (j ⁻¹' E)))ᶜ U_pb
          isClosed_closure.isOpen_compl hU_open
          ⟨y, hy, hy_not⟩ ⟨j q₀, hqE, q₀, rfl⟩
      exact hw_compl (subset_closure ⟨z, hwE, rfl⟩)
    refine ⟨⟨hPsi_irred, ?_⟩, hCl_eq⟩
    intro S_0 hS0 hSub
    have hE_sub : E ⊆ closure (j '' S_0) := by
      rw [← hCl_eq]
      exact closure_mono (Set.image_mono hSub)
    have hClS0_le : closure (j '' S_0) ⊆ E :=
      hE.2 (hS0.image j hj.continuous.continuousOn).closure hE_sub
    intro z hz
    exact hClS0_le (subset_closure ⟨z, hz, rfl⟩)

  
  have hFin_X0 : (irreducibleComponents ↥Y_X0).Finite := by
    refine hFinFib_P.of_injOn (f := fun E_0 => closure (j '' E_0))
      (fun E_0 hE0 => (hPhi_mem hE0).1) ?_
    intro E₁ hE₁ E₂ hE₂ heq
    dsimp only at heq
    rw [← (hPhi_mem hE₁).2, ← (hPhi_mem hE₂).2, heq]
  let S_contr : Set (Set ↥Y_X0) :=
    {E_0 ∈ irreducibleComponents ↥Y_X0 | ∀ q ∈ E_0, f_0.base (fst_R.base q) = u₀_WB}
  have hFin_contr : S_contr.Finite := hFin_X0.subset (fun _ h => h.1)
  let F_contr : Finset (Set ↥Y_X0) := hFin_contr.toFinset
  let r_c : ℕ := Fintype.card ↥F_contr
  let e_fin : Fin r_c ≃ ↥F_contr := (Fintype.equivFin ↥F_contr).symm
  let E_c : Fin r_c → Set ↥Y_X0 := fun l => (e_fin l).1
  have hEc_inj : Function.Injective E_c := Subtype.val_injective.comp e_fin.injective
  have hEc_mem : ∀ l : Fin r_c, E_c l ∈ irreducibleComponents ↥Y_X0 ∧
      ∀ q ∈ E_c l, f_0.base (fst_R.base q) = u₀_WB :=
    fun l => hFin_contr.mem_toFinset.mp (e_fin l).2
  have hEc_exh : ∀ E ∈ irreducibleComponents ↥Y_X0,
      (∀ q ∈ E, f_0.base (fst_R.base q) = u₀_WB) → ∃ l : Fin r_c, E = E_c l := by
    intro E hE_irred hE_u0
    let u_E : ↥F_contr := ⟨E, hFin_contr.mem_toFinset.mpr ⟨hE_irred, hE_u0⟩⟩
    exact ⟨e_fin.symm u_E, congrArg Subtype.val (e_fin.apply_symm_apply u_E).symm⟩

  have hZ_sub_U : Z ⊆ U_pb := by
    intro q hq
    rw [hRange_jpb]
    change f_ss_cur.base (fst_P.base q) ∈ W_B
    rw [hZ_u₀ q hq]
    exact hu₀
  obtain ⟨q_Z, hq_Z⟩ := hZ_irred.1.nonempty
  let Z_0 : Set ↥Y_X0 := j ⁻¹' Z
  obtain ⟨hZ0_irred, hPhi_Z0⟩ := hPsi_mem hZ_irred ⟨q_Z, hq_Z, hZ_sub_U hq_Z⟩
  have hZ0_u0 : ∀ q ∈ Z_0, f_0.base (fst_R.base q) = u₀_WB := by
    intro q hq
    apply W_B.ι.isOpenEmbedding.injective
    calc W_B.ι.base (f_0.base (fst_R.base q))
        = (f_0 ≫ W_B.ι).base (fst_R.base q) := rfl
      _ = (X_0.ι ≫ f_ss_cur).base (fst_R.base q) := by
          rw [AlgebraicGeometry.morphismRestrict_ι f_ss_cur W_B]
      _ = f_ss_cur.base ((fst_R ≫ X_0.ι).base q) := rfl
      _ = f_ss_cur.base ((j_pb ≫ fst_P).base q) := by
          rw [hPb_j.w]
      _ = f_ss_cur.base (fst_P.base (j q)) := rfl
      _ = u₀ := hZ_u₀ (j q) hq
      _ = W_B.ι.base u₀_WB := rfl
  let u_Z0 : ↥F_contr := ⟨Z_0, hFin_contr.mem_toFinset.mpr ⟨hZ0_irred, hZ0_u0⟩⟩
  let i_Z0 : Fin r_c := e_fin.symm u_Z0
  have hEc_iZ0 : E_c i_Z0 = Z_0 := congrArg Subtype.val (e_fin.apply_symm_apply u_Z0)

  have hZX0_eq : fst_R.base '' (E_c i_Z0) = X_0.ι.base ⁻¹' (fst_P.base '' Z) := by
    rw [hEc_iZ0]
    ext x
    constructor
    · rintro ⟨q₀, hq₀, rfl⟩
      refine ⟨j q₀, hq₀, ?_⟩
      change (j_pb ≫ fst_P).base q₀ = (fst_R ≫ X_0.ι).base q₀
      rw [hPb_j.w]
    · rintro ⟨q, hq, hqx⟩
      obtain ⟨q₀, rfl⟩ := hZ_sub_U hq
      refine ⟨q₀, hq, X_0.ι.isOpenEmbedding.injective ?_⟩
      calc X_0.ι.base (fst_R.base q₀)
          = (fst_R ≫ X_0.ι).base q₀ := rfl
        _ = (j_pb ≫ fst_P).base q₀ := by rw [hPb_j.w]
        _ = fst_P.base (j q₀) := rfl
        _ = X_0.ι.base x := hqx

  have hΔ_eq : {q ∈ Z | ∃ E' ∈ irreducibleComponents ↥Y_P, E' ≠ Z ∧ q ∈ E'}.ncard =
      {q ∈ E_c i_Z0 | ∃ E' ∈ irreducibleComponents ↥Y_X0, E' ≠ E_c i_Z0 ∧ q ∈ E'}.ncard := by
    rw [hEc_iZ0]
    symm
    refine Set.ncard_congr (fun q₀ _ => j q₀) ?_ ?_ ?_
    · rintro q₀ ⟨hq₀_Z, E'_0, hE'0_irred, hE'0_ne, hq₀_E'⟩
      obtain ⟨hPhi_irred, hPhi_pre⟩ := hPhi_mem hE'0_irred
      refine ⟨hq₀_Z, closure (j '' E'_0), hPhi_irred, ?_,
        subset_closure ⟨q₀, hq₀_E', rfl⟩⟩
      intro heq
      apply hE'0_ne
      rw [← hPhi_pre, heq]
    · intro q₁ q₂ _ _ hjeq
      exact hj.injective hjeq
    · rintro q ⟨hq_Z, E', hE'_irred, hE'_ne, hq_E'⟩
      obtain ⟨q₀, rfl⟩ := hZ_sub_U hq_Z
      obtain ⟨hPsi_irred, hPsi_cl⟩ := hPsi_mem hE'_irred ⟨j q₀, hq_E', q₀, rfl⟩
      refine ⟨q₀, ⟨hq_Z, j ⁻¹' E', hPsi_irred, ?_, hq_E'⟩, rfl⟩
      intro heq
      apply hE'_ne
      rw [← hPsi_cl, heq, hPhi_Z0]

  exact ⟨a_opt, M_0, g_M0, m_0, e_0, F_0, inferInstance, F_WB, inferInstance,
    η_M0, η_WB, η_X0, φ_KF0, φ_F0_FWB, T_0, r_c, E_c, i_Z0,
    hSS_WB, hSS_X0, hu₀_cl, hu₀_max, hZ_neBot, hStd, hEt_e0, he0_comm,
    he0_m0, he0_Zmod, hFunc_WB, hFunc_X0, hηX0_f0, hη_e0,
    hEc_inj, hEc_mem, hEc_exh, hZX0_eq, hΔ_eq⟩

theorem weil_gauss_disc_valuation_and_standard_base_tree_model (K : Type u) [Field K] [IsSepClosed K]
    (m : ℕ) (R : ValuationSubring K) (hPkg_R : IsValuationRingAlgPackage m R)
    (hMax_R : IsLocalRing.maximalIdeal ↥R ≠ ⊥)
    (a_opt : Option ↥R)
    (M_0 : AlgebraicGeometry.Scheme.{u})
    (g_M0 : M_0 ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
    (m_0 : ↥M_0)
    (F_0 : Type u) [Field F_0]
    (η_M0 : AlgebraicGeometry.Spec (CommRingCat.of F_0) ⟶ M_0)
    (φ_KF0 : K →+* F_0)
    (T_0 : F_0)
    (hStd : IsStandardModelCoordDatum R a_opt M_0 g_M0 m_0 η_M0 φ_KF0 T_0) :
    HasStandardGaussDiscValuations R a_opt g_M0 m_0 η_M0 φ_KF0 T_0 ∧
    ∀ (N : ℕ) (c π : Fin N → ↥R),
      IsJoinClosedDiscTree ↥R a_opt c π →
      (∀ i : Fin N, IsDiscBoundaryIdx ↥R a_opt (c i) (π i)) →
      ∃ (B_0 : Fin N → Set ↥(CategoryTheory.Limits.pullback g_M0
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (algebraMap ↥R (IsLocalRing.maximalIdeal ↥R).ResidueField))))),
        IsChartedBaseDiscTreeModel R a_opt g_M0 m_0 η_M0 φ_KF0 T_0 c π
          M_0 g_M0 (𝟙 M_0) η_M0 ∅ B_0 :=
by
  classical
  let m_R : Ideal ↥R := IsLocalRing.maximalIdeal ↥R
  let k_R : Type u := (IsLocalRing.maximalIdeal ↥R).ResidueField
  let s_R := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥R k_R))
  let Y_M0 := CategoryTheory.Limits.pullback g_M0 s_R
  let fst_R := CategoryTheory.Limits.pullback.fst g_M0 s_R
  let φ_R : ↥R →+* F_0 := φ_KF0.comp R.subtype
  have h1_not_mR : (1 : ↥R) ∉ IsLocalRing.maximalIdeal ↥R :=
    fun h1 => (IsLocalRing.maximalIdeal.isMaximal ↥R).ne_top
      (Ideal.eq_top_of_isUnit_mem _ h1 isUnit_one)
  have hφR_inj : Function.Injective φ_R := φ_KF0.injective.comp Subtype.val_injective
  have hφR_ne : ∀ {r : ↥R}, r ≠ 0 → φ_R r ≠ 0 :=
    fun {r} hr h0 => hr (hφR_inj (h0.trans (map_zero φ_R).symm))
  have r_dvd_total : ∀ x y : ↥R, (∃ r : ↥R, x = r * y) ∨ (∃ r : ↥R, y = r * x) := by
    intro x y
    by_cases hy : y = 0
    · right; exact ⟨0, by rw [hy, zero_mul]⟩
    · have hy0 : (y : K) ≠ 0 := fun h => hy (Subtype.ext h)
      rcases ValuationSubring.mem_or_inv_mem R ((x : K) / (y : K)) with hxy | hyx
      · left
        exact ⟨⟨(x : K) / (y : K), hxy⟩, Subtype.ext (div_mul_cancel₀ (x : K) hy0).symm⟩
      · by_cases hx : x = 0
        · left; exact ⟨0, by rw [hx, zero_mul]⟩
        · have hx0 : (x : K) ≠ 0 := fun h => hx (Subtype.ext h)
          right
          refine ⟨⟨((x : K) / (y : K))⁻¹, hyx⟩, Subtype.ext ?_⟩
          change (y : K) = ((x : K) / (y : K))⁻¹ * (x : K)
          rw [inv_div]
          exact (div_mul_cancel₀ (y : K) hx0).symm
  have mvPoly_split_var : ∀ (b : Fin 2) (F : MvPolynomial (Fin 2) ↥R),
      ∃ G : MvPolynomial (Fin 2) ↥R,
        F = Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.X (1 - b))
          (MvPolynomial.eval₂Hom Polynomial.C
            (if b = 0 then ![0, Polynomial.X] else ![Polynomial.X, 0]) F) +
          MvPolynomial.X b * G := by
    intro b F
    induction F using MvPolynomial.induction_on with
    | C r =>
      exact ⟨0, by simp⟩
    | add p q ihp ihq =>
      obtain ⟨Gp, hp⟩ := ihp
      obtain ⟨Gq, hq⟩ := ihq
      refine ⟨Gp + Gq, ?_⟩
      rw [map_add, map_add]
      linear_combination hp + hq
    | mul_X p i ihp =>
      obtain ⟨Gp, hp⟩ := ihp
      by_cases hib : i = b
      · subst hib
        refine ⟨p, ?_⟩
        have hzero : (if i = 0 then (![0, Polynomial.X] : Fin 2 → Polynomial ↥R)
            else ![Polynomial.X, 0]) i = 0 := by
          fin_cases i <;> rfl
        rw [map_mul, MvPolynomial.eval₂Hom_X', hzero, mul_zero, map_zero, zero_add, mul_comm]
      · have hi_eq : i = 1 - b := by fin_cases b <;> fin_cases i <;> simp at hib ⊢
        subst hi_eq
        refine ⟨Gp * MvPolynomial.X (1 - b), ?_⟩
        have hX : (if b = 0 then (![0, Polynomial.X] : Fin 2 → Polynomial ↥R)
            else ![Polynomial.X, 0]) (1 - b) = Polynomial.X := by
          fin_cases b <;> rfl
        rw [map_mul, MvPolynomial.eval₂Hom_X', hX, map_mul, Polynomial.coe_eval₂RingHom,
          Polynomial.eval₂_X, ← Polynomial.coe_eval₂RingHom]
        linear_combination hp * MvPolynomial.X (1 - b)
  have nodal_alg_pkg : ∀ (a₀ : ↥R), a₀ ≠ 0 →
      IsDomain (weilNodalQuot ↥R a₀) ∧
      Function.Injective (Polynomial.eval₂RingHom
        ((Ideal.Quotient.mk (weilNodalIdeal ↥R a₀)).comp MvPolynomial.C)
        (Ideal.Quotient.mk (weilNodalIdeal ↥R a₀) (MvPolynomial.X 0))) ∧
      (∀ y : weilNodalQuot ↥R a₀, ∀ D : ℕ,
        (Ideal.Quotient.mk (weilNodalIdeal ↥R a₀) (MvPolynomial.X 0)) ^ D * y = 0 → y = 0) ∧
      (∀ y : weilNodalQuot ↥R a₀, ∃ (D : ℕ) (P : Polynomial ↥R),
        (Ideal.Quotient.mk (weilNodalIdeal ↥R a₀) (MvPolynomial.X 0)) ^ D * y =
          Polynomial.eval₂RingHom
            ((Ideal.Quotient.mk (weilNodalIdeal ↥R a₀)).comp MvPolynomial.C)
            (Ideal.Quotient.mk (weilNodalIdeal ↥R a₀) (MvPolynomial.X 0)) P) := by
    intro a₀ ha₀_ne
    let I := weilNodalIdeal ↥R a₀
    let mk := Ideal.Quotient.mk I
    let c_R : ↥R →+* weilNodalQuot ↥R a₀ := mk.comp MvPolynomial.C
    let u₀ : weilNodalQuot ↥R a₀ := mk (MvPolynomial.X 0)
    let u₁ : weilNodalQuot ↥R a₀ := mk (MvPolynomial.X 1)
    let ι₀ : Polynomial ↥R →+* weilNodalQuot ↥R a₀ := Polynomial.eval₂RingHom c_R u₀
