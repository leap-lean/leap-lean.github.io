        · rw [h]
        · exact Nat.le_of_lt (upCard_lt_of_lt hw₁_u₁ h)
      rw [heq] at hlt1
      exact Nat.lt_irrefl _ (Nat.lt_of_lt_of_le (Nat.lt_trans hlt1 hlt2) hle3)
    have hw₀_ne_w₂ : w₀ ≠ w₂ := by
      intro heq
      have hlt1 : upCard w₀ < upCard k_root := upCard_lt_of_lt hw₀_hasse.2.1 hw₀_hasse.1.symm
      have hlt2 : upCard k_root < upCard u₂ := upCard_lt_of_lt hu₂_hasse.2.1 hu₂_hasse.1.symm
      have hle3 : upCard u₂ ≤ upCard w₂ := by
        by_cases h : w₂ = u₂
        · rw [h]
        · exact Nat.le_of_lt (upCard_lt_of_lt hw₂_u₂ h)
      rw [heq] at hlt1
      exact Nat.lt_irrefl _ (Nat.lt_of_lt_of_le (Nat.lt_trans hlt1 hlt2) hle3)
    
    let v_arr : Fin 3 → Fin N := ![k_root, v₁, v₂]
    let w_arr : Fin 3 → Fin N := ![w₀, w₁, w₂]
    have hv_arr_not : ∀ b : Fin 3, ¬ inD0 (v_arr b) := by
