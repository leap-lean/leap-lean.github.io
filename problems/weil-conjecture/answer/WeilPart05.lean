      let A_U : Type u := ↑(Γ.presheaf.obj (Opposite.op U))
      have _ : IsDomain A_U :=
        @AlgebraicGeometry.IsIntegral.component_integral Γ hIntΓ U ⟨⟨y₀, hy₀⟩⟩
      have hbot_prime : (⊥ : Ideal A_U).IsPrime := by
