theorem weil_semistable_model_minimal_prime_and_maxFiber_transcendental (K : Type u) [Field K]
    (R : ValuationSubring K)
    (hNodalNorm : ∀ (K₀ : Type u) [Field K₀] (V₀ : ValuationSubring K₀) (a₀ : ↥V₀),
      a₀ ≠ 0 →
      IsDomain (MvPolynomial (Fin 2) ↥V₀ ⧸ Ideal.span
        {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a₀}) ∧
      IsIntegrallyClosed (MvPolynomial (Fin 2) ↥V₀ ⧸ Ideal.span
        {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a₀}))
    (Q : Ideal ↥R) [Q.IsPrime] :
    let m_R := IsLocalRing.maximalIdeal ↥R
    (∀ (p_η p_z₀ : Ideal (Polynomial ↥R)) [p_η.IsPrime] [p_z₀.IsPrime],
      p_η ≤ p_z₀ →
      Ideal.comap Polynomial.C p_η = Q →
      Ideal.comap Polynomial.C p_z₀ = m_R →
      (∀ p₀ : Ideal (Polynomial ↥R), p₀.IsPrime → Ideal.comap Polynomial.C p₀ = Q → p₀ ≤ p_η → p₀ = p_η) →
      IsDomain (Polynomial ↥R ⧸ p_η) ∧
      IsIntegrallyClosed (Polynomial ↥R ⧸ p_η) ∧
      ∃ (p_m : Ideal (Polynomial ↥R)) (_ : p_m.IsPrime) (u_coord : Polynomial ↥R),
        p_η ≤ p_m ∧ p_m ≤ p_z₀ ∧ Ideal.comap Polynomial.C p_m = m_R ∧
        (∀ g : Polynomial ↥R, (∃ i : ℕ, g.coeff i ∉ m_R) →
          Polynomial.eval₂ Polynomial.C u_coord g ∉ p_m)) ∧
    (∀ (a : ↥R), a ≠ 0 →
      let γ_nod : ↥R →+* (MvPolynomial (Fin 2) ↥R ⧸
          Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}) :=
        (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a})).comp
          MvPolynomial.C
      ∀ (p_η p_z₀ : Ideal (MvPolynomial (Fin 2) ↥R ⧸
          Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}))
          [p_η.IsPrime] [p_z₀.IsPrime],
        p_η ≤ p_z₀ →
        Ideal.comap γ_nod p_η = Q →
        Ideal.comap γ_nod p_z₀ = m_R →
        (∀ p₀ : Ideal (MvPolynomial (Fin 2) ↥R ⧸
            Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}),
