    have hG1_T : G_1 T = j_1 g_1 := by
      dsimp only [T]; rw [hG1_eq]; simp [β_1]
    have hG1_C : ∀ r : R₀, G_1 (α_01 (Polynomial.C r)) = ι_L1 r := by
