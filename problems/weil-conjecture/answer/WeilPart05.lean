      have hp_eq : ι_U.base p_nod = fst_tilde.base q := hp_pin (fst_tilde.base q) hqi hqj₁
      have hp_j₂ : ι_U.base p_nod ∈ B_set j₂ := hp_eq.symm ▸ hqj₂
      rcases (hιU_comp p_nod j₂ hp_mR).mp hp_j₂ with ⟨hj₂_i, _⟩ | ⟨hj₂_j₁, _⟩
      · exact False.elim (hj₂_ne hj₂_i)
      · exact hj₂_j₁.symm
    · obtain ⟨_, _, _, _, ι_U, p_nod, _, _, hp_mR, _, hp_pin, hιU_comp⟩ := hEdge_pin j₁ i hcov
      have hp_eq : ι_U.base p_nod = fst_tilde.base q := hp_pin (fst_tilde.base q) hqj₁ hqi
      have hp_j₂ : ι_U.base p_nod ∈ B_set j₂ := hp_eq.symm ▸ hqj₂
      rcases (hιU_comp p_nod j₂ hp_mR).mp hp_j₂ with ⟨hj₂_j₁, _⟩ | ⟨hj₂_i, _⟩
      · exact hj₂_j₁.symm
      · exact False.elim (hj₂_ne hj₂_i)
  have hNod_open : ∀ (i : Fin (N' + 1)), ¬ IsDiscBoundaryIdx ↥R a_opt (c i) (π i) →
      ∀ (q : ↥Y_Mtilde) (E' : Set ↥Y_Mtilde),
        q ∈ B_tilde i → E' ∈ irreducibleComponents ↥Y_Mtilde → E' ≠ B_tilde i → q ∈ E' →
        ∃ j : Fin (N' + 1), (IsDiscHasseCover ↥R c π i j ∨ IsDiscHasseCover ↥R c π j i) ∧
          E' = B_tilde j ∧
          ∃ (U_nod : M_tilde.Opens) (a_n : ↥R)
            (e_n : U_nod.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of
              (MvPolynomial (Fin 2) ↥R ⧸ Ideal.span
                {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a_n}))),
            a_n ≠ 0 ∧ a_n ∈ m_R ∧
            AlgebraicGeometry.Etale e_n ∧
            U_nod.ι ≫ g_tilde = e_n ≫ AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) ∧
            ∃ hq : fst_tilde.base q ∈ U_nod,
              (∀ b : Fin 2, Ideal.Quotient.mk _ (MvPolynomial.X b) ∈
                (e_n.base ⟨_, hq⟩).asIdeal) ∧
              ∃ b₀ : Fin 2, ∀ x : ↥U_nod,
                (g_tilde.base x.1).asIdeal = m_R →
                (x.1 ∈ fst_tilde.base '' E' ↔
                  Ideal.Quotient.mk _ (MvPolynomial.X b₀) ∈ (e_n.base x).asIdeal) := by
    intro i _ q E' hqi hE'_irr hE'_ne hqE'
    obtain ⟨j, rfl⟩ := hBtilde_exh_irred E' hE'_irr
    have hij : i ≠ j := fun h => hE'_ne (congrArg B_tilde h.symm)
    rcases hHasse_or_of_inter hij hqi hqE' with hcov | hcov
    · obtain ⟨c', hc'_ne, hc'_mR, h, ι_U, p_nod, hOpen_U, hιU_g, _, hp_X, hp_pin, hιU_comp⟩ :=
        hEdge_pin i j hcov
      have : AlgebraicGeometry.IsOpenImmersion ι_U := hOpen_U
      have hp_eq : ι_U.base p_nod = fst_tilde.base q := hp_pin (fst_tilde.base q) hqi hqE'
      let U_nod : M_tilde.Opens := ι_U.opensRange
      let isoU := AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq ι_U U_nod.ι
        (AlgebraicGeometry.Scheme.Opens.range_ι U_nod).symm
      have hU_ι : isoU.inv ≫ ι_U = U_nod.ι :=
        AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_inv_fac ι_U U_nod.ι _
      let e_n : U_nod.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of (weilNodalQuot ↥R c')) :=
        isoU.inv ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (weilNodalQuot ↥R c') (Localization.Away h)))
      have hq_mem : fst_tilde.base q ∈ U_nod := ⟨p_nod, hp_eq⟩
      have hinv_q : isoU.inv.base ⟨fst_tilde.base q, hq_mem⟩ = p_nod := by
        apply ι_U.isOpenEmbedding.injective
        change (isoU.inv ≫ ι_U).base ⟨fst_tilde.base q, hq_mem⟩ = ι_U.base p_nod
        rw [hU_ι]
        exact hp_eq.symm
      refine ⟨j, Or.inl hcov, rfl, U_nod, c', e_n, hc'_ne, hc'_mR, inferInstance, ?_,
        hq_mem, ?_, 0, ?_⟩
      · rw [← hU_ι, CategoryTheory.Category.assoc, hιU_g]
        dsimp only [e_n]
        rw [CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
      · intro b
        change algebraMap (weilNodalQuot ↥R c') (Localization.Away h)
          (Ideal.Quotient.mk (weilNodalIdeal ↥R c') (MvPolynomial.X b)) ∈
          (isoU.inv.base ⟨fst_tilde.base q, hq_mem⟩).asIdeal
        rw [hinv_q]
        exact hp_X b
      · intro x hx_mR
        let p_x : PrimeSpectrum (Localization.Away h) := isoU.inv.base x
        have hpx_eq : ι_U.base p_x = x.1 := by
          change (isoU.inv ≫ ι_U).base x = x.1
          rw [hU_ι]; rfl
        have hpx_mR : (g_tilde.base (ι_U.base p_x)).asIdeal = m_R := by
          rw [hpx_eq]; exact hx_mR
        rw [hImg_B j, ← hpx_eq, hιU_comp p_x j hpx_mR]
        change (j = i ∧ _) ∨ (j = j ∧ _) ↔
          algebraMap (weilNodalQuot ↥R c') (Localization.Away h)
            (Ideal.Quotient.mk (weilNodalIdeal ↥R c') (MvPolynomial.X 0)) ∈ p_x.asIdeal
        simp [hij.symm]
    · obtain ⟨c', hc'_ne, hc'_mR, h, ι_U, p_nod, hOpen_U, hιU_g, _, hp_X, hp_pin, hιU_comp⟩ :=
        hEdge_pin j i hcov
      have : AlgebraicGeometry.IsOpenImmersion ι_U := hOpen_U
      have hp_eq : ι_U.base p_nod = fst_tilde.base q := hp_pin (fst_tilde.base q) hqE' hqi
      let U_nod : M_tilde.Opens := ι_U.opensRange
      let isoU := AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq ι_U U_nod.ι
        (AlgebraicGeometry.Scheme.Opens.range_ι U_nod).symm
      have hU_ι : isoU.inv ≫ ι_U = U_nod.ι :=
        AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_inv_fac ι_U U_nod.ι _
      let e_n : U_nod.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of (weilNodalQuot ↥R c')) :=
        isoU.inv ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (weilNodalQuot ↥R c') (Localization.Away h)))
      have hq_mem : fst_tilde.base q ∈ U_nod := ⟨p_nod, hp_eq⟩
      have hinv_q : isoU.inv.base ⟨fst_tilde.base q, hq_mem⟩ = p_nod := by
        apply ι_U.isOpenEmbedding.injective
        change (isoU.inv ≫ ι_U).base ⟨fst_tilde.base q, hq_mem⟩ = ι_U.base p_nod
        rw [hU_ι]
        exact hp_eq.symm
      refine ⟨j, Or.inr hcov, rfl, U_nod, c', e_n, hc'_ne, hc'_mR, inferInstance, ?_,
        hq_mem, ?_, 1, ?_⟩
      · rw [← hU_ι, CategoryTheory.Category.assoc, hιU_g]
        dsimp only [e_n]
        rw [CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
      · intro b
        change algebraMap (weilNodalQuot ↥R c') (Localization.Away h)
          (Ideal.Quotient.mk (weilNodalIdeal ↥R c') (MvPolynomial.X b)) ∈
          (isoU.inv.base ⟨fst_tilde.base q, hq_mem⟩).asIdeal
        rw [hinv_q]
        exact hp_X b
      · intro x hx_mR
        let p_x : PrimeSpectrum (Localization.Away h) := isoU.inv.base x
        have hpx_eq : ι_U.base p_x = x.1 := by
          change (isoU.inv ≫ ι_U).base x = x.1
          rw [hU_ι]; rfl
        have hpx_mR : (g_tilde.base (ι_U.base p_x)).asIdeal = m_R := by
          rw [hpx_eq]; exact hx_mR
        rw [hImg_B j, ← hpx_eq, hιU_comp p_x j hpx_mR]
        change (j = j ∧ _) ∨ (j = i ∧ _) ↔
          algebraMap (weilNodalQuot ↥R c') (Localization.Away h)
            (Ideal.Quotient.mk (weilNodalIdeal ↥R c') (MvPolynomial.X 1)) ∈ p_x.asIdeal
        simp [hij.symm]
  
  obtain ⟨hZ_cl, hIso_Z, hZ_pts⟩ := hZtilde_pkg
  refine ⟨⟨?_, hBtilde_cov, ?_, ?_, ?_, ?_⟩, (hImg_B i_Z).trans hBset_Z |>.symm⟩
  · refine ⟨hSS_tilde, hProp_qf, hqf_g, by rw [← CategoryTheory.Category.assoc, hη_q, hη'_f'],
      hZ_cl, hIso_Z, hZ_pts, hBtilde_inj, hBtilde_mem_irred, hNb_tilde, hBd_tilde, ?_, ?_,
      hTwo_branch, hNod_open⟩
    · intro E hE_irr hE_m0
      obtain ⟨i, rfl⟩ := hBtilde_exh_irred E hE_irr
      refine ⟨i, ?_, rfl⟩
      intro hi_bd
      obtain ⟨q, hq, hq_ne⟩ := hBd_tilde i hi_bd
      exact hq_ne (hE_m0 q hq)
    · intro i j hcov
      obtain ⟨y, ⟨hyi, hyj⟩, hy_uniq⟩ := hBset_hasse i j hcov
      obtain ⟨q, rfl⟩ := hSub_Bset i hyi
      refine ⟨q, ⟨hyi, hyj⟩, ?_⟩
      rintro q' ⟨hq'i, hq'j⟩
      exact fst_tilde.isClosedEmbedding.injective (hy_uniq (fst_tilde.base q') ⟨hq'i, hq'j⟩)
  · intro i j hij h1 h2
    exact (hBset_disj i j hij h1 h2).preimage fst_tilde.base
  · intro i hi_not_a0 c_tilde hc_sep
    obtain ⟨h, ι_U, φ_U, hhc, hOpen, hg, hη, hX, hmem⟩ := hRaw_vert i hi_not_a0 c_tilde hc_sep
    refine ⟨h, ι_U, φ_U, hhc, hOpen, hg, hη, hX, fun p k hp => ?_⟩
    change ι_U.base p ∈ fst_tilde.base '' (B_tilde k) ↔ k = i
    rw [hImg_B k]
    exact hmem p k hp
  · intro i a₀ ha₀ hEq
    obtain ⟨h, ι_U, hh1, hOpen, hg, hne_m0, hmem⟩ := hRaw_bot i a₀ ha₀ hEq
    refine ⟨h, ι_U, hh1, hOpen, hg, hne_m0, fun p k hp => ?_⟩
    change ι_U.base p ∈ fst_tilde.base '' (B_tilde k) ↔ k = i
    rw [hImg_B k]
    exact hmem p k hp
  · intro i_p i_c hcov
    obtain ⟨c_e, c', hr, hπ, hc'_ne, hc'_mR, h, ι_U, φ_U,
      hh_not, hOpen, hg, hη, hX0, hX1, hmem⟩ := hRaw_edge i_p i_c hcov
    refine ⟨c_e, c', hr, hπ, hc'_ne, hc'_mR, h, ι_U, φ_U,
      hh_not, hOpen, hg, hη, hX0, hX1, fun p k hp => ?_⟩
    change ι_U.base p ∈ fst_tilde.base '' (B_tilde k) ↔ _
    rw [hImg_B k]
    exact hmem p k hp

theorem weil_charted_disc_tree_one_step_insertion (K : Type u) [Field K] [IsSepClosed K]
    (m : ℕ) (R : ValuationSubring K) (hPkg_R : IsValuationRingAlgPackage m R)
    (hMax_R : IsLocalRing.maximalIdeal ↥R ≠ ⊥)
    (a_opt : Option ↥R)
    (M_0 : AlgebraicGeometry.Scheme.{u})
    (g_M0 : M_0 ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
    (m_0 : ↥M_0)
    (F_0 : Type u) [Field F_0]
    (η_M0 : AlgebraicGeometry.Spec (CommRingCat.of F_0) ⟶ M_0)
    (φ_KF0 : K →+* F_0)
    (T_0 : F_0)
    (hStd : IsStandardModelCoordDatum R a_opt M_0 g_M0 m_0 η_M0 φ_KF0 T_0)
    (hGauss : HasStandardGaussDiscValuations R a_opt g_M0 m_0 η_M0 φ_KF0 T_0)
    (hSmBl : HasLocalSmoothLeafBlowup R)
    (hNodBl : HasLocalNodalSubdivBlowup R)
    (N' : ℕ) (c π : Fin (N' + 1) → ↥R)
    (hTree : IsJoinClosedDiscTree ↥R a_opt c π)
    (i_Z : Fin (N' + 1))
    (hiZ_nb : ¬ IsDiscBoundaryIdx ↥R a_opt (c i_Z) (π i_Z))
    (hDeg_lo : 1 ≤ {j : Fin (N' + 1) | IsDiscHasseCover ↥R c π i_Z j ∨
      IsDiscHasseCover ↥R c π j i_Z}.ncard)
    (hDeg_hi : {j : Fin (N' + 1) | IsDiscHasseCover ↥R c π i_Z j ∨
      IsDiscHasseCover ↥R c π j i_Z}.ncard ≤ 2)
    (hTree' : IsJoinClosedDiscTree ↥R a_opt (c ∘ i_Z.succAbove) (π ∘ i_Z.succAbove))
    (M' : AlgebraicGeometry.Scheme.{u})
    (g'_M : M' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
    (f'_M : M' ⟶ M_0)
    (η'_M : AlgebraicGeometry.Spec (CommRingCat.of F_0) ⟶ M')
    (Z_M' : Set ↥M_0)
    (B'_comp : Fin N' → Set ↥(CategoryTheory.Limits.pullback g'_M
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥R (IsLocalRing.maximalIdeal ↥R).ResidueField)))))
    (hModel' : IsChartedBaseDiscTreeModel R a_opt g_M0 m_0 η_M0 φ_KF0 T_0
      (c ∘ i_Z.succAbove) (π ∘ i_Z.succAbove) M' g'_M f'_M η'_M Z_M' B'_comp) :
    let s_R := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.maximalIdeal ↥R).ResidueField))
    ∃ (M_tilde : AlgebraicGeometry.Scheme.{u})
      (g_tilde : M_tilde ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
      (q_M : M_tilde ⟶ M')
      (η_tilde : AlgebraicGeometry.Spec (CommRingCat.of F_0) ⟶ M_tilde)
      (Z_tilde : Set ↥M_0)
      (B_tilde : Fin (N' + 1) → Set ↥(CategoryTheory.Limits.pullback g_tilde s_R))
      (Mod_qM : Set ↥M')
      (z_new_M : ↥M')
      (Q₀_R : PrimeSpectrum ↥R)
      (z₀_M : ↥M')
      (E_Z_M : Set ↥M_tilde),
      IsChartedBaseDiscTreeModel R a_opt g_M0 m_0 η_M0 φ_KF0 T_0 c π
        M_tilde g_tilde (q_M ≫ f'_M) η_tilde Z_tilde B_tilde ∧
      IsBaseOneStepContractionModel R g_M0 m_0
        ({j : Fin (N' + 1) | IsDiscHasseCover ↥R c π i_Z j ∨
          IsDiscHasseCover ↥R c π j i_Z}.ncard = 1)
        M_tilde M' g_tilde g'_M f'_M q_M Mod_qM z_new_M Q₀_R z₀_M E_Z_M ∧
      E_Z_M = (CategoryTheory.Limits.pullback.fst g_tilde s_R).base '' (B_tilde i_Z) :=
by
  classical
  let s_R := AlgebraicGeometry.Spec.map
    (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.maximalIdeal ↥R).ResidueField))
  dsimp only
  let c' : Fin N' → ↥R := c ∘ i_Z.succAbove
  let π' : Fin N' → ↥R := π ∘ i_Z.succAbove
  let S_nb : Set (Fin (N' + 1)) :=
    {j : Fin (N' + 1) | IsDiscHasseCover ↥R c π i_Z j ∨ IsDiscHasseCover ↥R c π j i_Z}
  let fst'_R := CategoryTheory.Limits.pullback.fst g'_M s_R
  have ⟨hBase', hCov_M', hDisj_M', hVert_M', hBot_M', hEdge_M'⟩ := hModel'
  have ⟨hSS_M', hProp_f', hf'_g, hη'_f', hZM'_cl, hIso_f', hZM'_pts,
    _, hIrred_B', hNb_B', _, _, hHasse_B', _, _⟩ := hBase'
  have hη'_g : η'_M ≫ g'_M =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_KF0.comp R.subtype)) := by
    rw [← hf'_g, ← CategoryTheory.Category.assoc, hη'_f', hStd.2.1]
  have hφ_ne : ∀ r : ↥R, r ≠ 0 → φ_KF0 (R.subtype r) ≠ 0 := by
    intro r hr h0
    apply hr
    apply Subtype.ext
    exact RingHom.injective φ_KF0 (by simpa using h0)
  have hSurj_res : Function.Surjective (algebraMap ↥R (IsLocalRing.maximalIdeal ↥R).ResidueField) :=
    Ideal.algebraMap_residueField_surjective (IsLocalRing.maximalIdeal ↥R)
  have : AlgebraicGeometry.IsClosedImmersion s_R :=
    AlgebraicGeometry.IsClosedImmersion.spec_of_surjective _ hSurj_res
  have hClImm_fst' : AlgebraicGeometry.IsClosedImmersion fst'_R := inferInstance
  have hInj_fst' : Function.Injective fst'_R.base := fst'_R.isClosedEmbedding.injective
  have hRange_fst' : Set.range fst'_R.base =
      {x : ↥M' | (g'_M.base x).asIdeal = IsLocalRing.maximalIdeal ↥R} := by
    rw [AlgebraicGeometry.Scheme.Pullback.range_fst]
    ext x
    simp only [Set.mem_preimage, Set.mem_range]
    change (∃ pt, s_R.base pt = g'_M.base x) ↔
      (g'_M.base x).asIdeal = IsLocalRing.maximalIdeal ↥R
    let pt₀ : PrimeSpectrum (IsLocalRing.maximalIdeal ↥R).ResidueField := ⊥
    constructor
    · rintro ⟨pt, hpt⟩
      rw [← hpt]
      ext r
      have hpt_bot : pt.asIdeal = ⊥ := Subsingleton.elim pt pt₀ ▸ rfl
      change algebraMap ↥R (IsLocalRing.maximalIdeal ↥R).ResidueField r ∈ pt.asIdeal ↔ _
      rw [hpt_bot, Ideal.mem_bot, Ideal.algebraMap_residueField_eq_zero]
    · intro hx
      refine ⟨pt₀, ?_⟩
      apply PrimeSpectrum.ext
      ext r
      change algebraMap ↥R (IsLocalRing.maximalIdeal ↥R).ResidueField r ∈ (⊥ : Ideal _) ↔
        r ∈ (g'_M.base x).asIdeal
      rw [hx, Ideal.mem_bot, Ideal.algebraMap_residueField_eq_zero]
  have hCl_S' : ∀ k' : Fin N', IsClosed (fst'_R.base '' (B'_comp k')) := fun k' =>
    fst'_R.isClosedEmbedding.isClosedMap _ (isClosed_of_mem_irreducibleComponents _ (hIrred_B' k'))
  have hSub_S' : ∀ k' : Fin N',
      fst'_R.base '' (B'_comp k') ⊆
        {x : ↥M' | (g'_M.base x).asIdeal = IsLocalRing.maximalIdeal ↥R} := by
    rintro k' x ⟨q, _, rfl⟩
    rw [← hRange_fst']
    exact ⟨q, rfl⟩
  obtain ⟨⟨hciZ_mR, hπiZ_mR, hiZ_not_a0⟩,
    i'_p, π_tilde, c_tilde_Z, hip_cov, hip_uniq, hπ_iZ_eq, hc_iZ_eq,
    hπtilde_ne, hπtilde_mR, hip_not_a0, hBranch⟩ :=
    weil_join_closed_disc_tree_insertion_hasse_and_residues K R a_opt N' c π
      hTree i_Z hiZ_nb hDeg_lo hDeg_hi
  obtain ⟨hShrink_sm_vert, hShrink_sm_bot, hShrink_nod, hSep_sm, hOrigin_eval⟩ :=
    weil_away_chart_two_prime_shrinking_and_origin_eval K R a_opt M_0 g_M0 m_0
      F_0 η_M0 φ_KF0 T_0 hStd hGauss
  obtain ⟨hUniq_sm, hUniq_nod, hGauss_bridge⟩ :=
    weil_blowup_center_comap_and_gauss_stalk_bridge K R a_opt M_0 g_M0 m_0
      F_0 η_M0 φ_KF0 T_0 hStd.2.1 hGauss
  obtain ⟨hOrigin_sm, hOrigin_nod⟩ := hOrigin_eval M' g'_M f'_M η'_M hf'_g hη'_f'
  have idx_eq : ∀ k : Fin (N' + 1), i_Z = k ∨ ∃ k' : Fin N', i_Z.succAbove k' = k := by
    intro k
    by_cases hk : k = i_Z
    · exact Or.inl hk.symm
    · obtain ⟨k', hk'⟩ := Fin.exists_succAbove_eq hk
      exact Or.inr ⟨k', by simp [hk']⟩
  rcases hBranch with
    ⟨hCard1, _, hNoChild_iZ, hBd_ip, hHasse_iff_A, hSep_sib_A⟩ |
    ⟨hCardNe1, i'_c, b', δ_c, hi'_c_ne, hic_cov, hic_uniq, _,
      hπ_ic_eq, hc_ic_eq, hb'_ne, hb'_mR, hCov_pc', hBd_pc, hHasse_iff_B, hNot_cp, hSep_tr_B⟩
  · 
    obtain ⟨h_p, ι_p, φ_p, hh_p_eval, hOpen_p, hιp_g, hφp_η, hφp_X, hιp_comp⟩ :=
      hVert_M' i'_p hip_not_a0 c_tilde_Z (fun j' hj' r hr => hSep_sib_A j' r hj' hr)
    let B := Localization.Away h_p
    let g_B : AlgebraicGeometry.Spec (CommRingCat.of B) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of ↥R) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        ((algebraMap (Polynomial ↥R) B).comp Polynomial.C))
    let h_0 : Polynomial ↥R :=
      h_p.comp (Polynomial.C c_tilde_Z + Polynomial.C π_tilde * Polynomial.X)
    obtain ⟨Q₀_R, U_bl, g_Ubl, p_bl, σ_loc, τ₀_loc, τ₁_loc, h_1, ι_0, ι_1, ψ_0, ψ_1,
      hQ₀_ne, hπtilde_Q₀, hSm_gB, hInt_Ubl, hp_g, hProp_p, hFlat_Ubl, hLfp_Ubl,
      hσ_g, hσ_X, hτ₀_p, hτ₁_p, hτ_disj, hIso_p,
      ⟨q_gen, hq_gen_R, hGen_irr, hMod_pre⟩,
