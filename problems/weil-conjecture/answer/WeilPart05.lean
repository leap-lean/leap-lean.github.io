      have hof_eq : CommRingCat.ofHom γ₀ = γ₀_hom := CommRingCat.hom_ext (RingHom.ext fun _ => rfl)
      have hSurj_fγ' :
          Function.Surjective
            ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ₀)).residueFieldMap p_x).hom := by
        rwa [hof_eq]
      have hiff := (spec_map_residueFieldMap_iff γ₀ p_x).mp hSurj_fγ'
      have hfp_x' : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ₀)).base p_x = Q := by
        rwa [hof_eq]
      rwa [hfp_x'] at hiff
    have r_dvd_total : ∀ a s : ↥R, (∃ r : ↥R, a = r * s) ∨ (∃ r : ↥R, s = r * a) := by
      intro a s
      by_cases hs : s = 0
      · right; exact ⟨0, by rw [hs, zero_mul]⟩
      · have hs0 : (s : K) ≠ 0 := fun h => hs (Subtype.ext h)
        rcases ValuationSubring.mem_or_inv_mem R ((a : K) / (s : K)) with has | hsa
        · left
          refine ⟨⟨(a : K) / (s : K), has⟩, Subtype.ext ?_⟩
          exact (div_mul_cancel₀ (a : K) hs0).symm
        · by_cases ha : a = 0
          · left; exact ⟨0, by rw [ha, zero_mul]⟩
          · have ha0 : (a : K) ≠ 0 := fun h => ha (Subtype.ext h)
            right
            refine ⟨⟨((a : K) / (s : K))⁻¹, hsa⟩, Subtype.ext ?_⟩
            change (s : K) = ((a : K) / (s : K))⁻¹ * (a : K)
            rw [inv_div]
            exact (div_mul_cancel₀ (s : K) ha0).symm
    have hCancel : ∀ b : B₀, ∃ r : ↥R, b - γ₀ r ∈ p_x.asIdeal := by
      intro b
      obtain ⟨a, s, hsQ, hbsa⟩ := hFrac b
      have hγs_not : γ₀ s ∉ p_x.asIdeal := by
        rw [← Ideal.mem_comap, hcomap_x]; exact hsQ
      rcases r_dvd_total a s with ⟨r, rfl⟩ | ⟨r, hrs⟩
      · refine ⟨r, ?_⟩
        have hmul : (b - γ₀ r) * γ₀ s ∈ p_x.asIdeal := by
          have h_eq : (b - γ₀ r) * γ₀ s = b * γ₀ s - γ₀ (r * s) := by
            rw [map_mul]; ring
          rwa [h_eq]
        exact (p_x.isPrime.mem_or_mem hmul).resolve_right hγs_not
      · by_cases hr_m : r ∈ IsLocalRing.maximalIdeal ↥R
        · exfalso
          have haQ : a ∉ Q.asIdeal := fun ha =>
            hsQ (hrs ▸ Ideal.mul_mem_left Q.asIdeal r ha)
          have hγa_not : γ₀ a ∉ p_x.asIdeal := by
            rw [← Ideal.mem_comap, hcomap_x]; exact haQ
          have hmul_a : (b * γ₀ r - 1) * γ₀ a ∈ p_x.asIdeal := by
            have h_eq : (b * γ₀ r - 1) * γ₀ a = b * γ₀ s - γ₀ a := by
              rw [hrs, map_mul]; ring
            rwa [h_eq]
          have hbr1_x : b * γ₀ r - 1 ∈ p_x.asIdeal :=
            (p_x.isPrime.mem_or_mem hmul_a).resolve_right hγa_not
          have hbr1_max : b * γ₀ r - 1 ∈ p_max.asIdeal := hp_le hbr1_x
          have hγr_max : γ₀ r ∈ p_max.asIdeal := by
            rw [← Ideal.mem_comap, hcomap_max]; exact hr_m
          have hbr_max : b * γ₀ r ∈ p_max.asIdeal :=
            Ideal.mul_mem_left p_max.asIdeal b hγr_max
          have hone_max : (1 : B₀) ∈ p_max.asIdeal := by
            have hsub := p_max.asIdeal.sub_mem hbr_max hbr1_max
            rwa [show b * γ₀ r - (b * γ₀ r - 1) = (1 : B₀) by ring] at hsub
