            Ideal.map ((Ideal.Quotient.mk (weilNodalIdeal ↥R a₀)).comp MvPolynomial.C)
              (IsLocalRing.maximalIdeal ↥R) →
        ι_e ≫ g'_M = AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk (weilNodalIdeal ↥R a₀)).comp MvPolynomial.C) ≫
            CommRingCat.ofHom (algebraMap (weilNodalQuot ↥R a₀) (Localization.Away h_e))) →
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_e) ≫ ι_e = η'_M →
        φ_KF0 (R.subtype 1) *
            φ_e (algebraMap (weilNodalQuot ↥R a₀) (Localization.Away h_e)
              (Ideal.Quotient.mk (weilNodalIdeal ↥R a₀) (MvPolynomial.X 0))) =
          T_0 - φ_KF0 (R.subtype c_e) →
        (T_0 - φ_KF0 (R.subtype c_e)) *
            φ_e (algebraMap (weilNodalQuot ↥R a₀) (Localization.Away h_e)
              (Ideal.Quotient.mk (weilNodalIdeal ↥R a₀) (MvPolynomial.X 1))) =
          φ_KF0 (R.subtype a₀) →
        (g'_M.base (ι_e.base p_max)).asIdeal = IsLocalRing.maximalIdeal ↥R →
        (∀ b_idx : Fin 2,
          algebraMap (weilNodalQuot ↥R a₀) (Localization.Away h_e)
            (Ideal.Quotient.mk (weilNodalIdeal ↥R a₀) (MvPolynomial.X b_idx)) ∈
