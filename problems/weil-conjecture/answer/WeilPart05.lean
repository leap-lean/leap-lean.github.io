    rcases hRoof with ⟨e₀, m₀, hEt_e₀, he₀_comm, hX_m₀, hC_m₀, he₀_m₀, he₀_Zmod⟩ |
      ⟨a₀, e₀, m₀, ha₀_ne, ha₀_mem, hEt_e₀, he₀_comm, hX_m₀, hC_m₀, he₀_m₀, he₀_Zmod⟩
    · 
      let ψ : Polynomial ↥R →+* F_0 :=
        (algebraMap (Polynomial K) F_0).comp (Polynomial.mapRingHom R.subtype)
      let ε : Polynomial ↥R →+* k_R := Polynomial.eval₂RingHom (algebraMap ↥R k_R) 0
