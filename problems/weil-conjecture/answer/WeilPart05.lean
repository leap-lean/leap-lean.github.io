                rw [hyp] at hqy; rw [hxc] at hqx
                obtain ⟨q_pc, _, hq_pc_uniq⟩ := hHasse_B' i'_p i'_c hCov_pc'
                obtain ⟨q_z1, hqz1_p, hqz1_eq⟩ := (hz_new_comp i'_p).mpr (Or.inl rfl)
                obtain ⟨q_z2, hqz2_c, hqz2_eq⟩ := (hz_new_comp i'_c).mpr (Or.inr rfl)
                have hqz_eq : q_z1 = q_z2 := hInj_fst' (hqz1_eq.trans hqz2_eq.symm)
                rw [hqz_eq] at hqz1_p
                have h1 : qy = q_pc := hq_pc_uniq qy ⟨hqy, hqx⟩
                have h2 : q_z2 = q_pc := hq_pc_uniq q_z2 ⟨hqz1_p, hqz2_c⟩
                have hv_eq : U_compl.ι.base v = z_new_M := by
                  rw [← hqy_eq, h1, ← h2]; exact hqz2_eq
                have hmem : U_compl.ι.base v ∈ Mod_qMᶜ := v.2
                rw [hv_eq] at hmem
                exact hmem ⟨q_max, rfl⟩
              · exact Set.disjoint_left.mp (hDisj_M' x' y' hx_ne_y hcov1 hcov2) hqx hqy
    have hBset_hasse : ∀ i j : Fin (N' + 1), IsDiscHasseCover ↥R c π i j →
        ∃! y : ↥M_tilde, y ∈ B_set i ∧ y ∈ B_set j := by
      intro i j hcov
      rcases idx_eq i with rfl | ⟨x', rfl⟩
      · have hj_eq : j = i_Z.succAbove i'_c := hic_uniq j hcov
        rw [hj_eq]
        obtain ⟨y_nod1, ⟨hyE, hyS1⟩, hy_uniq⟩ := hNod1_uniq
        refine ⟨j_1.base y_nod1, ?_, ?_⟩
        · refine ⟨?_, ?_⟩
          · rw [hBset_Z]; exact ⟨y_nod1, hyE, rfl⟩
          · change y_nod1 ∈ j_1.base ⁻¹' (B_set (i_Z.succAbove i'_c))
            rwa [hj1_succ_ic]
        · rintro y ⟨hy1, hy2⟩
          rw [hBset_Z] at hy1
          obtain ⟨u, huE, rfl⟩ := hy1
          change u ∈ j_1.base ⁻¹' (B_set (i_Z.succAbove i'_c)) at hy2
          rw [hj1_succ_ic] at hy2
          exact congrArg j_1.base (hy_uniq u ⟨huE, hy2⟩)
      · rcases idx_eq j with rfl | ⟨y', rfl⟩
        · have hxp : x' = i'_p := Fin.succAbove_right_injective (hip_uniq _ hcov)
          rw [hxp]
          obtain ⟨y_nod0, ⟨hyE, hyS0⟩, hy_uniq⟩ := hNod0_uniq
          refine ⟨j_1.base y_nod0, ?_, ?_⟩
          · refine ⟨?_, ?_⟩
            · change y_nod0 ∈ j_1.base ⁻¹' (B_set (i_Z.succAbove i'_p))
