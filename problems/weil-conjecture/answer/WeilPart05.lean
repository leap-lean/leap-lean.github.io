        obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective a
        let ψ_B : MvPolynomial (Fin 2) R₀ →+* Localization.Away h_e :=
          (algebraMap (weilNodalQuot R₀ (b' * π_tilde)) (Localization.Away h_e)).comp
