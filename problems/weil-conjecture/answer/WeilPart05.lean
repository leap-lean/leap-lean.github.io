      intro k'
      rw [hBset_succ]
      exact (hSt_pre (fst'_R.base '' (B'_comp k')) (hCl_S' k') (hSub_S' k')).2.2
    have hBset_cov : (⋃ i : Fin (N' + 1), B_set i) =
        {y : ↥M_tilde | (g_tilde.base y).asIdeal = IsLocalRing.maximalIdeal ↥R} := by
      ext y
      simp only [Set.mem_iUnion]
      change (∃ i, y ∈ B_set i) ↔ (g_tilde.base y).asIdeal = IsLocalRing.maximalIdeal ↥R
