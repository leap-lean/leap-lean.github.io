      calc β_1 Q_01 * w_1 ^ D
          = MvPolynomial.eval₂ ι_L1 ![ι_L1 π_tilde * j_1 g_1, ι_L1 b' * w_1] P_h :=
              hLaurent ι_L1 (j_1 g_1) w_1 hj1_w1
        _ = (MvPolynomial.eval₂Hom ι_L1 ![ι_L1 π_tilde * j_1 g_1, j_1 v_1]) P_h := by
              rw [hb_w1]; rfl
        _ = (((j_1.comp α_1).comp (Ideal.Quotient.mk _)).comp Φ_1) P_h := by rw [← hL1_Φ1]
        _ = j_1 (α_1 h_1) := congrArg (fun x => j_1 (α_1 x)) hh_1_eq.symm
    have hUnit_β1_Q01 : IsUnit (β_1 Q_01) := by
