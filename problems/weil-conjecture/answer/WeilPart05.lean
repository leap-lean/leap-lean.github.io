          rw [h_eq]
          exact Ideal.sub_mem _ hmem (Ideal.mul_mem_left _ r_0 hb'_mR)
        obtain ⟨h_Z, ι_Z, ψ_Z, hhZ_eval, _, hOpen_Z, hιZ_p,
          hψZ_C, _, _, hLift_Z, hChartZ_mem⟩ := hSm_Z_pkg δ_e c_tilde hδe_sep
        obtain ⟨φ_Z, hφZ_ψZ, _, hφZ_rel⟩ := hLift_Z φ_e φ_0 hφ0_ψ0 hφe_πt_ne hφe_X0_ne
        have hιZ_gUbl : ι_Z ≫ g_Ubl = AlgebraicGeometry.Spec.map (CommRingCat.ofHom
