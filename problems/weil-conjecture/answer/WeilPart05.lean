      rw [hg_eq]
      exact hz_bot
    have hqx0_mem : q_0.base x₀ ∈ U'_0 := by
      apply hGen_U'0
      have hq0_g : q_0 ≫ g'_0 = f_0 ≫ g_WB := by
        dsimp [g'_0]
        rw [← CategoryTheory.Category.assoc, hq0_f]
      have hx₀_eq : (q_0 ≫ g'_0).base x₀ = p_bot := by rw [hq0_g]; exact hx₀_bot
      exact congrArg PrimeSpectrum.asIdeal hx₀_eq
    have hNe_U'0 : Nonempty ↥U'_0 := ⟨⟨q_0.base x₀, hqx0_mem⟩⟩
    have : Nonempty ↥U'_0.toScheme := hNe_U'0
    let W_X0 : X_0_sch.Opens := (TopologicalSpace.Opens.map q_0.base).obj U'_0
    have hInt_U'0 : AlgebraicGeometry.IsIntegral U'_0.toScheme :=
      AlgebraicGeometry.isIntegral_of_isOpenImmersion
        (CategoryTheory.inv (q_0 ∣_ U'_0) ≫ W_X0.ι)
    have hSS_X'0 : IsStrictlySemistableCurveOverValuation R g'_0 :=
      h_s1 M' X'_0 g'_M g'_0 π'_M U'_0 hSS_M' hEt_π'M hSep_g'0 hπ'M_comm
        hNe_U'0 hInt_U'0 hGen_U'0
    refine ⟨hSS_X'0, hq0_f, rfl, hProp_q0, hProp_f'0, hSurj_q0, hIso_q0, ?_⟩
    intro hl z hz
    obtain ⟨V_sm_M, hz_V, hSm_V⟩ := hSm_M' hl (π'_M.base z) hz
    let V_sm : X'_0.Opens := (TopologicalSpace.Opens.map π'_M.base).obj V_sm_M
    have : AlgebraicGeometry.Etale (π'_M ∣_ V_sm_M) :=
      CategoryTheory.MorphismProperty.of_isPullback
        (AlgebraicGeometry.isPullback_morphismRestrict π'_M V_sm_M).flip hEt_π'M
    have hSm_comp : AlgebraicGeometry.SmoothOfRelativeDimension (0 + 1)
        ((π'_M ∣_ V_sm_M) ≫ (V_sm_M.ι ≫ g'_M)) := inferInstance
    refine ⟨V_sm, hz_V, ?_⟩
    rw [Nat.zero_add, ← CategoryTheory.Category.assoc,
      AlgebraicGeometry.morphismRestrict_ι, CategoryTheory.Category.assoc, hπ'M_comm] at hSm_comp
    exact hSm_comp

theorem weil_pullback_snd_iso_over_open_of_base_fiber_subsingleton (K : Type u) [Field K]
    [IsSepClosed K] (m : ℕ) (R : ValuationSubring K) (hPkg_R : IsValuationRingAlgPackage m R)
    (M_0 W_B_sch M_1 : AlgebraicGeometry.Scheme.{u})
    (g_M0 : M_0 ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
    (g_WB : W_B_sch ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
    (g_M1 : M_1 ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
    (e_0 : W_B_sch ⟶ M_0)
    (f_M1 : M_1 ⟶ M_0)
    (F_0 F_WB : Type u) [Field F_0] [Field F_WB]
    (η_M0 : AlgebraicGeometry.Spec (CommRingCat.of F_0) ⟶ M_0)
    (η_WB : AlgebraicGeometry.Spec (CommRingCat.of F_WB) ⟶ W_B_sch)
    (η_M1 : AlgebraicGeometry.Spec (CommRingCat.of F_0) ⟶ M_1)
    (φ_KF0 : K →+* F_0) (φ_F0_FWB : F_0 →+* F_WB)
    (Z_M1 : Set ↥M_0) (hZM1_cl : IsClosed Z_M1)
    (U_compl : W_B_sch.Opens)
    (hAff_M0 : AlgebraicGeometry.IsAffine M_0)
    (hAff_WB : AlgebraicGeometry.IsAffine W_B_sch)
    (hSS_WB : IsStrictlySemistableCurveOverValuation R g_WB)
    (hEt_e0 : AlgebraicGeometry.Etale e_0)
    (he0_comm : e_0 ≫ g_M0 = g_WB)
    (hFunc_WB : IsSchemeFunctionField W_B_sch F_WB η_WB)
    (hηM0_g : η_M0 ≫ g_M0 = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_KF0.comp R.subtype)))
    (hη_e0 : η_WB ≫ e_0 = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_F0_FWB) ≫ η_M0)
    (hSS_M1 : IsStrictlySemistableCurveOverValuation R g_M1)
    (hProp_fM1 : AlgebraicGeometry.IsProper f_M1)
    (hfM1_g : f_M1 ≫ g_M0 = g_M1)
    (hη_M1 : η_M1 ≫ f_M1 = η_M0)
    (hIso_fM1 : CategoryTheory.IsIso (f_M1 ∣_ (⟨Z_M1ᶜ, hZM1_cl.isOpen_compl⟩ : M_0.Opens)))
    (hZM1_neBot : ∀ y ∈ Z_M1, (g_M0.base y).asIdeal ≠ ⊥)
    (hηWB_U : ∀ pt : AlgebraicGeometry.Spec (CommRingCat.of F_WB), η_WB.base pt ∈ U_compl)
    (hFib_sub : ∀ y_B : ↥W_B_sch, y_B ∈ U_compl → (f_M1.base ⁻¹' {e_0.base y_B}).Subsingleton) :
    CategoryTheory.IsIso ((CategoryTheory.Limits.pullback.snd f_M1 e_0) ∣_ U_compl) :=
by
  
  have hSS_norm_pkg := weil_strictlySemistable_isAffineNormal_and_funcField K m R hPkg_R
  have hOpen_ηR :
      AlgebraicGeometry.IsOpenImmersion
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom R.subtype)) :=
    hSS_norm_pkg.1
  have hNorm_WB : IsAffineNormalScheme W_B_sch :=
    hSS_norm_pkg.2.1 W_B_sch g_WB hSS_WB

  
  let X_1 : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback f_M1 e_0
  let π_M1 : X_1 ⟶ M_1 := CategoryTheory.Limits.pullback.fst f_M1 e_0
  let f_X1 : X_1 ⟶ W_B_sch := CategoryTheory.Limits.pullback.snd f_M1 e_0
  have hη_comm :
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_F0_FWB) ≫ η_M1) ≫ f_M1 =
        η_WB ≫ e_0 := by
    rw [CategoryTheory.Category.assoc, hη_M1, hη_e0]
  let η_X1 : AlgebraicGeometry.Spec (CommRingCat.of F_WB) ⟶ X_1 :=
    CategoryTheory.Limits.pullback.lift
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_F0_FWB) ≫ η_M1) η_WB hη_comm
  obtain ⟨hSS_X1, hProp_fX1, hFunc_X1, hη_X1_f, _, _⟩ :=
    (weil_etale_pullback_semistable_and_functionField K R hOpen_ηR M_0 W_B_sch g_M0 g_WB e_0
      hAff_WB hSS_WB.1 hEt_e0 he0_comm).1 F_0 F_WB η_M0 η_WB φ_KF0 φ_F0_FWB
      hFunc_WB hηM0_g hη_e0 M_1 g_M1 f_M1 η_M1 Z_M1 hZM1_cl
      hSS_M1 hProp_fM1 hfM1_g hη_M1 hIso_fM1 hZM1_neBot hη_comm

  
  let V_X1 : X_1.Opens := (TopologicalSpace.Opens.map f_X1.base).obj U_compl
  let f' : V_X1.toScheme ⟶ U_compl.toScheme := f_X1 ∣_ U_compl
  let pt₀ : AlgebraicGeometry.Spec (CommRingCat.of F_WB) := (⊥ : PrimeSpectrum F_WB)
  have hRange_WB : Set.range η_WB.base ⊆ Set.range U_compl.ι.base := by
    rw [AlgebraicGeometry.Scheme.Opens.range_ι]
    rintro _ ⟨pt, rfl⟩
    exact hηWB_U pt
  have hRange_X1 : Set.range η_X1.base ⊆ Set.range V_X1.ι.base := by
    rw [AlgebraicGeometry.Scheme.Opens.range_ι]
    rintro _ ⟨pt, rfl⟩
    change f_X1.base (η_X1.base pt) ∈ U_compl
    have hpt_eq : f_X1.base (η_X1.base pt) = η_WB.base pt :=
      congrArg (fun k => k.base pt) hη_X1_f
    rw [hpt_eq]
    exact hηWB_U pt
  let η_U : AlgebraicGeometry.Spec (CommRingCat.of F_WB) ⟶ U_compl.toScheme :=
    AlgebraicGeometry.IsOpenImmersion.lift U_compl.ι η_WB hRange_WB
  let η_V : AlgebraicGeometry.Spec (CommRingCat.of F_WB) ⟶ V_X1.toScheme :=
    AlgebraicGeometry.IsOpenImmersion.lift V_X1.ι η_X1 hRange_X1
  have hηU_fac : η_U ≫ U_compl.ι = η_WB :=
    AlgebraicGeometry.IsOpenImmersion.lift_fac U_compl.ι η_WB hRange_WB
  have hηV_fac : η_V ≫ V_X1.ι = η_X1 :=
    AlgebraicGeometry.IsOpenImmersion.lift_fac V_X1.ι η_X1 hRange_X1
  have hη_VF : η_V ≫ f' = η_U := by
    apply (CategoryTheory.cancel_mono U_compl.ι).mp
    rw [CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι f_X1 U_compl,
      ← CategoryTheory.Category.assoc, hηV_fac, hη_X1_f, hηU_fac]
  have _ : Nonempty ↥U_compl.toScheme := ⟨η_U.base pt₀⟩
  have _ : Nonempty ↥V_X1.toScheme := ⟨η_V.base pt₀⟩
  have _ : AlgebraicGeometry.IsIntegral W_B_sch := hSS_WB.1
  have _ : AlgebraicGeometry.IsIntegral X_1 := hSS_X1.1
  have hInt_U : AlgebraicGeometry.IsIntegral U_compl.toScheme :=
    AlgebraicGeometry.isIntegral_of_isOpenImmersion U_compl.ι
  have hInt_V : AlgebraicGeometry.IsIntegral V_X1.toScheme :=
    AlgebraicGeometry.isIntegral_of_isOpenImmersion V_X1.ι
  have _ : AlgebraicGeometry.IsProper f_X1 := hProp_fX1
  have hProp_f' : AlgebraicGeometry.IsProper f' := inferInstance

  
  have hFromSpec_open :
      ∀ (Y : AlgebraicGeometry.Scheme.{u}) (O : Y.Opens)
        (W : O.toScheme.Opens) (hW : AlgebraicGeometry.IsAffineOpen W),
        (hW.image_of_isOpenImmersion O.ι).fromSpec = hW.fromSpec ≫ O.ι := by
    intro Y O W hW
    let V : Y.Opens := (AlgebraicGeometry.Scheme.Hom.opensFunctor O.ι).obj W
    let hV : AlgebraicGeometry.IsAffineOpen V := hW.image_of_isOpenImmersion O.ι
    have hV_set : (V : Set ↥Y) = O.ι.base '' (W : Set ↥O.toScheme) :=
      IsOpenMap.coe_functor_obj O.ι.isOpenEmbedding.isOpenMap W
    have e_WV : W ≤ (TopologicalSpace.Opens.map O.ι.base).obj V := by
      intro w hw
      change O.ι.base w ∈ (V : Set ↥Y)
      rw [hV_set]
      exact ⟨w, hw, rfl⟩
    have happ1 :
        (O.ι.appLE V W e_WV : Y.presheaf.obj (Opposite.op V) ⟶ Y.presheaf.obj (Opposite.op V)) =
          Y.presheaf.map (CategoryTheory.homOfLE (le_rfl : V ≤ V)).op :=
      AlgebraicGeometry.Scheme.Opens.ι_appLE O V W e_WV
    have hhom_id :
        (CategoryTheory.homOfLE (le_rfl : V ≤ V)).op = 𝟙 (Opposite.op V) :=
      Subsingleton.elim _ _
    have happ2 :
        Y.presheaf.map (CategoryTheory.homOfLE (le_rfl : V ≤ V)).op =
          𝟙 (Y.presheaf.obj (Opposite.op V)) := by
      rw [hhom_id, CategoryTheory.Functor.map_id]
    have happ := happ1.trans happ2
    have hspec :
        AlgebraicGeometry.Spec.map (O.ι.appLE V W e_WV) ≫ hV.fromSpec = hW.fromSpec ≫ O.ι :=
      AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec O.ι hV hW e_WV
    have hid :
        AlgebraicGeometry.Spec.map (O.ι.appLE V W e_WV) ≫ hV.fromSpec = hV.fromSpec := by
      calc
        (@AlgebraicGeometry.Spec.map
            (Y.presheaf.obj (Opposite.op V)) (Y.presheaf.obj (Opposite.op V))
            (O.ι.appLE V W e_WV) ≫ hV.fromSpec)
        _ = AlgebraicGeometry.Spec.map (𝟙 (Y.presheaf.obj (Opposite.op V))) ≫ hV.fromSpec :=
            congrArg (fun g => AlgebraicGeometry.Spec.map g ≫ hV.fromSpec) happ
        _ = hV.fromSpec := by
            rw [AlgebraicGeometry.Spec.map_id, CategoryTheory.Category.id_comp]
    exact hid.symm.trans hspec

  have hNorm_U : IsAffineNormalScheme U_compl.toScheme := by
    intro W hW ⟨w₀, hw₀⟩
    let V : W_B_sch.Opens := (AlgebraicGeometry.Scheme.Hom.opensFunctor U_compl.ι).obj W
    have hV : AlgebraicGeometry.IsAffineOpen V := hW.image_of_isOpenImmersion U_compl.ι
    have hV_set : (V : Set ↥W_B_sch) = U_compl.ι.base '' (W : Set ↥U_compl.toScheme) :=
      IsOpenMap.coe_functor_obj U_compl.ι.isOpenEmbedding.isOpenMap W
    have hV_ne : Nonempty ↥V :=
      ⟨⟨U_compl.ι.base w₀, by change U_compl.ι.base w₀ ∈ (V : Set ↥W_B_sch); rw [hV_set]; exact ⟨w₀, hw₀, rfl⟩⟩⟩
    exact hNorm_WB V hV hV_ne

  have hFunc_open :
      ∀ (Y : AlgebraicGeometry.Scheme.{u}) (O : Y.Opens)
        (η_Y : AlgebraicGeometry.Spec (CommRingCat.of F_WB) ⟶ Y)
        (η_O : AlgebraicGeometry.Spec (CommRingCat.of F_WB) ⟶ O.toScheme),
        IsSchemeFunctionField Y F_WB η_Y →
        η_O ≫ O.ι = η_Y →
        IsSchemeFunctionField O.toScheme F_WB η_O := by
    intro Y O η_Y η_O hFunc_Y h_fac W hW ⟨w₀, hw₀⟩
    let V : Y.Opens := (AlgebraicGeometry.Scheme.Hom.opensFunctor O.ι).obj W
    have hV : AlgebraicGeometry.IsAffineOpen V := hW.image_of_isOpenImmersion O.ι
    have hV_set : (V : Set ↥Y) = O.ι.base '' (W : Set ↥O.toScheme) :=
      IsOpenMap.coe_functor_obj O.ι.isOpenEmbedding.isOpenMap W
    have hV_ne : Nonempty ↥V :=
      ⟨⟨O.ι.base w₀, by change O.ι.base w₀ ∈ (V : Set ↥Y); rw [hV_set]; exact ⟨w₀, hw₀, rfl⟩⟩⟩
    obtain ⟨φ, hFrac, hSpec⟩ := hFunc_Y V hV hV_ne
    refine ⟨φ, hFrac, ?_⟩
    apply (CategoryTheory.cancel_mono O.ι).mp
    exact (CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map φ) hW.fromSpec O.ι).trans
      ((congrArg (fun g => AlgebraicGeometry.Spec.map φ ≫ g) (hFromSpec_open Y O W hW).symm).trans
        (hSpec.trans h_fac.symm))

  have hFunc_U : IsSchemeFunctionField U_compl.toScheme F_WB η_U :=
    hFunc_open W_B_sch U_compl η_WB η_U hFunc_WB hηU_fac
  have hFunc_V : IsSchemeFunctionField V_X1.toScheme F_WB η_V :=
    hFunc_open X_1 V_X1 η_X1 η_V hFunc_X1 hηV_fac

  have hDom_V : AlgebraicGeometry.IsDominant η_V := by
    have _ : AlgebraicGeometry.IsIntegral V_X1.toScheme := hInt_V
    have _ : IrreducibleSpace ↥V_X1.toScheme :=
      AlgebraicGeometry.irreducibleSpace_of_isIntegral V_X1.toScheme
    obtain ⟨W₀, hW₀, hpt_W₀, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := η_V.base pt₀) (U := ⊤) trivial
    have hW₀_ne : Nonempty ↥W₀.toScheme := ⟨⟨η_V.base pt₀, hpt_W₀⟩⟩
    obtain ⟨φ₀, hFrac₀, hSpec₀⟩ := hFunc_V W₀ hW₀ ⟨⟨η_V.base pt₀, hpt_W₀⟩⟩
    let A₀ : Type u := ↑(V_X1.toScheme.presheaf.obj (Opposite.op W₀))
    have _ : IsDomain A₀ :=
      @AlgebraicGeometry.IsIntegral.component_integral V_X1.toScheme hInt_V W₀ hW₀_ne
    have hInj_φ₀ : Function.Injective φ₀.hom :=
      @IsFractionRing.injective A₀ _ F_WB _ φ₀.hom.toAlgebra hFrac₀
    let p_bot : PrimeSpectrum A₀ := (AlgebraicGeometry.Spec.map φ₀).base pt₀
    have hp_bot : p_bot.asIdeal = ⊥ := by
      change Ideal.comap φ₀.hom (pt₀ : PrimeSpectrum F_WB).asIdeal = ⊥
      change Ideal.comap φ₀.hom ⊥ = ⊥
      exact (RingHom.injective_iff_ker_eq_bot φ₀.hom).mp hInj_φ₀
    rw [AlgebraicGeometry.isDominant_iff, DenseRange]
    intro z
    rw [mem_closure_iff]
    intro O hO_open hz_O
    have hRange_open : IsOpen (Set.range hW₀.fromSpec.base) :=
      hW₀.fromSpec.isOpenEmbedding.isOpen_range
    have hRange_ne : (Set.range hW₀.fromSpec.base).Nonempty :=
      ⟨hW₀.fromSpec.base p_bot, ⟨p_bot, rfl⟩⟩
    have hz_cl : z ∈ closure (Set.range hW₀.fromSpec.base) :=
      hRange_open.dense hRange_ne z
    obtain ⟨_, ⟨hO_y, q, rfl⟩⟩ := mem_closure_iff.mp hz_cl O hO_open hz_O
    have hle : p_bot ≤ q := by
      change p_bot.asIdeal ≤ q.asIdeal
      rw [hp_bot]
      exact bot_le
    have hq_cl : q ∈ closure ({p_bot} : Set (PrimeSpectrum A₀)) :=
      (PrimeSpectrum.le_iff_mem_closure p_bot q).mp hle
    have hPre_open : IsOpen (hW₀.fromSpec.base ⁻¹' O) :=
      hO_open.preimage hW₀.fromSpec.continuous
    obtain ⟨w, hw_O, hw_sing⟩ := mem_closure_iff.mp hq_cl (hW₀.fromSpec.base ⁻¹' O) hPre_open hO_y
    have hw_eq : w = p_bot := hw_sing
    refine ⟨η_V.base pt₀, ?_, ⟨pt₀, rfl⟩⟩
    have h_eq : η_V.base pt₀ = hW₀.fromSpec.base p_bot := by
      rw [← hSpec₀]
      rfl
    rw [h_eq, ← hw_eq]
    exact hw_O

  
  have hFin_π : ∀ z_M : ↥M_1, (π_M1.base ⁻¹' {z_M}).Finite := by
    intro z_M
    have _ := hAff_M0
    have _ := hAff_WB
    have _ := hEt_e0
    have hAff_e0 : AlgebraicGeometry.IsAffineHom e_0 :=
      AlgebraicGeometry.isAffineHom_of_isAffine e_0
    have hAff_π : AlgebraicGeometry.IsAffineHom π_M1 :=
      AlgebraicGeometry.isAffineHom_isStableUnderBaseChange.of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback f_M1 e_0).flip hAff_e0
    have hEt_π : AlgebraicGeometry.Etale π_M1 := inferInstance
    obtain ⟨U_z, hUz, hz_U, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := z_M) (U := ⊤) trivial
    let W_z : X_1.Opens := (TopologicalSpace.Opens.map π_M1.base).obj U_z
    have hWz : AlgebraicGeometry.IsAffineOpen W_z := hAff_π.isAffine_preimage U_z hUz
    let A_z : Type u := ↑(M_1.presheaf.obj (Opposite.op U_z))
    let B_z : Type u := ↑(X_1.presheaf.obj (Opposite.op W_z))
    let α_z : A_z →+* B_z := (π_M1.appLE U_z W_z le_rfl).hom
    have hEt_α : α_z.Etale :=
      AlgebraicGeometry.HasRingHomProperty.appLE @AlgebraicGeometry.Etale π_M1 hEt_π
        ⟨U_z, hUz⟩ ⟨W_z, hWz⟩ le_rfl
    let _ : Algebra A_z B_z := α_z.toAlgebra
    have _ : Algebra.Etale A_z B_z := hEt_α
    have _ : Algebra.QuasiFinite A_z B_z := inferInstance
    let P_z : PrimeSpectrum A_z := hUz.isoSpec.hom.base ⟨z_M, hz_U⟩
    have hFin_alg : (PrimeSpectrum.comap α_z ⁻¹' {P_z}).Finite :=
      Algebra.QuasiFinite.finite_comap_preimage_singleton P_z
    refine (hFin_alg.image hWz.fromSpec.base).subset ?_
    intro x hx_mem
    have hx_eq : π_M1.base x = z_M := hx_mem
    have hx_W : x ∈ W_z := by
      change π_M1.base x ∈ U_z
      rw [hx_eq]
      exact hz_U
    let q : PrimeSpectrum B_z := hWz.isoSpec.hom.base ⟨x, hx_W⟩
    have hq_from : hWz.fromSpec.base q = x := by
      change (hWz.isoSpec.hom ≫ hWz.fromSpec).base ⟨x, hx_W⟩ = x
      rw [← hWz.isoSpec_inv_ι, CategoryTheory.Iso.hom_inv_id_assoc]
      rfl
    have hPz_from : hUz.fromSpec.base P_z = z_M := by
      change (hUz.isoSpec.hom ≫ hUz.fromSpec).base ⟨z_M, hz_U⟩ = z_M
      rw [← hUz.isoSpec_inv_ι, CategoryTheory.Iso.hom_inv_id_assoc]
      rfl
    refine ⟨q, ?_, hq_from⟩
    change PrimeSpectrum.comap α_z q = P_z
    apply hUz.fromSpec.isOpenEmbedding.injective
    have hcomm := AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec π_M1 hUz hWz le_rfl
    have hcomm_q :
        hUz.fromSpec.base ((AlgebraicGeometry.Spec.map (π_M1.appLE U_z W_z le_rfl)).base q) =
          π_M1.base (hWz.fromSpec.base q) :=
      congrArg (fun k => k.base q) hcomm
    exact hcomm_q.trans ((congrArg π_M1.base hq_from).trans (hx_eq.trans hPz_from.symm))

  have hFin_f' : ∀ u : ↥U_compl.toScheme, (f'.base ⁻¹' {u}).Finite := by
    intro u
    let y_B : ↥W_B_sch := U_compl.ι.base u
    have hy_B : y_B ∈ U_compl := by
      change y_B ∈ (U_compl : Set ↥W_B_sch)
      rw [← AlgebraicGeometry.Scheme.Opens.range_ι U_compl]
      exact ⟨u, rfl⟩
    have hFin_base : (f_M1.base ⁻¹' {e_0.base y_B}).Finite :=
      (hFib_sub y_B hy_B).finite
    have hFin_fX1 : (f_X1.base ⁻¹' {y_B}).Finite := by
      refine (hFin_base.biUnion (fun z_M _ => hFin_π z_M)).subset ?_
      intro x hx
      have hx_eq : f_X1.base x = y_B := hx
      rw [Set.mem_iUnion₂]
      refine ⟨π_M1.base x, ?_, rfl⟩
      change (π_M1 ≫ f_M1).base x = e_0.base y_B
      rw [CategoryTheory.Limits.pullback.condition]
      change e_0.base (f_X1.base x) = e_0.base y_B
      rw [hx_eq]
    refine (hFin_fX1.preimage (V_X1.ι.isOpenEmbedding.injective.injOn)).subset ?_
    intro v hv
    have hv_eq : f'.base v = u := hv
    change (V_X1.ι ≫ f_X1).base v = y_B
    rw [← AlgebraicGeometry.morphismRestrict_ι f_X1 U_compl]
    change U_compl.ι.base (f'.base v) = y_B
    rw [hv_eq]

  have hLocQF : ∀ z : ↥V_X1.toScheme,
      ∃ (U_X : U_compl.toScheme.Opens) (_ : AlgebraicGeometry.IsAffineOpen U_X)
        (V_C : V_X1.toScheme.Opens) (_ : AlgebraicGeometry.IsAffineOpen V_C)
        (e_X : V_C ≤ (TopologicalSpace.Opens.map f'.base).obj U_X),
        z ∈ V_C ∧
        (f'.appLE U_X V_C e_X).hom.FiniteType ∧
        (f'.appLE U_X V_C e_X).hom.QuasiFinite := by
    intro z
    have _ : AlgebraicGeometry.IsProper f' := hProp_f'
    have hLFT : AlgebraicGeometry.LocallyOfFiniteType f' := inferInstance
    obtain ⟨U_X, hUX, hfz, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := f'.base z) (U := ⊤) trivial
    obtain ⟨V_C, hVC, hz_VC, e_X⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
        (x := z) (U := (TopologicalSpace.Opens.map f'.base).obj U_X) hfz
    have hFT : (f'.appLE U_X V_C e_X).hom.FiniteType := hLFT.finiteType_appLE hUX hVC e_X
    refine ⟨U_X, hUX, V_C, hVC, e_X, hz_VC, hFT, ?_⟩
    let A_X : Type u := ↑(U_compl.toScheme.presheaf.obj (Opposite.op U_X))
    let B_C : Type u := ↑(V_X1.toScheme.presheaf.obj (Opposite.op V_C))
    let ψ : A_X →+* B_C := (f'.appLE U_X V_C e_X).hom
    let _ : Algebra A_X B_C := ψ.toAlgebra
    have _ : Algebra.FiniteType A_X B_C := hFT
    change Algebra.QuasiFinite A_X B_C
    rw [Algebra.QuasiFinite.iff_finite_comap_preimage_singleton]
    intro P
    let u : ↥U_compl.toScheme := hUX.fromSpec.base P
    refine ((hFin_f' u).preimage (hVC.fromSpec.isOpenEmbedding.injective.injOn)).subset ?_
    intro q hq
    have hq_eq : PrimeSpectrum.comap ψ q = P := hq
    change (hVC.fromSpec ≫ f').base q = hUX.fromSpec.base P
    have hcomm := AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec f' hUX hVC e_X
    have hcomm_q :
        hUX.fromSpec.base ((AlgebraicGeometry.Spec.map (f'.appLE U_X V_C e_X)).base q) =
          (hVC.fromSpec ≫ f').base q :=
      congrArg (fun k => k.base q) hcomm
    exact hcomm_q.symm.trans (congrArg hUX.fromSpec.base hq_eq)

  
  exact weil_birational_proper_iso_of_locallyQuasiFinite_normal
    V_X1.toScheme U_compl.toScheme F_WB f' η_V η_U
    hInt_V hInt_U hNorm_U hProp_f' hDom_V hη_VF hFunc_V hFunc_U hLocQF

theorem weil_disc_tree_pullback_iso_over_mod_complement (K : Type u) [Field K] [IsSepClosed K]
    (m : ℕ) (R : ValuationSubring K) (hPkg_R : IsValuationRingAlgPackage m R)
    (hMax_R : IsLocalRing.maximalIdeal ↥R ≠ ⊥)
    (a_opt : Option ↥R)
    (M_0 W_B_sch X_0_sch : AlgebraicGeometry.Scheme.{u})
    (g_M0 : M_0 ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
    (g_WB : W_B_sch ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
    (f_0 : X_0_sch ⟶ W_B_sch)
    (m_0 : ↥M_0) (u₀_WB : ↥W_B_sch)
    (e_0 : W_B_sch ⟶ M_0)
    (Z_mod : Set ↥W_B_sch) (hZ_closed : IsClosed Z_mod)
    (F_0 F_WB : Type u) [Field F_0] [Field F_WB]
    (η_M0 : AlgebraicGeometry.Spec (CommRingCat.of F_0) ⟶ M_0)
    (η_WB : AlgebraicGeometry.Spec (CommRingCat.of F_WB) ⟶ W_B_sch)
    (η_X0 : AlgebraicGeometry.Spec (CommRingCat.of F_WB) ⟶ X_0_sch)
    (φ_KF0 : K →+* F_0) (φ_F0_FWB : F_0 →+* F_WB) (T_0 : F_0)
    (hAff_WB : AlgebraicGeometry.IsAffine W_B_sch)
    (hSS_WB : IsStrictlySemistableCurveOverValuation R g_WB)
    (hSS_X0 : IsStrictlySemistableCurveOverValuation R (f_0 ≫ g_WB))
    (hProp_f0 : AlgebraicGeometry.IsProper f_0)
    (hu₀_max : (g_WB.base u₀_WB).asIdeal = IsLocalRing.maximalIdeal ↥R)
    (hZ_neBot : ∀ y ∈ Z_mod, (g_WB.base y).asIdeal ≠ ⊥)
    (hIso_f0_compl : CategoryTheory.IsIso (f_0 ∣_ (⟨Z_modᶜ, hZ_closed.isOpen_compl⟩ : W_B_sch.Opens)))
    (he0_Zmod : ∀ y ∈ Z_mod, e_0.base ⁻¹' {e_0.base y} = {y})
    (hStd : IsStandardModelCoordDatum R a_opt M_0 g_M0 m_0 η_M0 φ_KF0 T_0)
    (hEt_e0 : AlgebraicGeometry.Etale e_0)
    (he0_comm : e_0 ≫ g_M0 = g_WB)
    (he0_m0 : e_0.base ⁻¹' {m_0} = {u₀_WB})
    (hFunc_WB : IsSchemeFunctionField W_B_sch F_WB η_WB)
    (hFunc_X0 : IsSchemeFunctionField X_0_sch F_WB η_X0)
    (hηX0_f0 : η_X0 ≫ f_0 = η_WB)
    (hη_e0 : η_WB ≫ e_0 = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_F0_FWB) ≫ η_M0)
    (r_c : ℕ)
    (E_c : Fin r_c → Set ↥(CategoryTheory.Limits.pullback (f_0 ≫ g_WB)
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥R (IsLocalRing.maximalIdeal ↥R).ResidueField)))))
    (W_c : Fin r_c → ValuationSubring F_WB)
    (c_0 π_0 : Fin r_c → ↥R)
    (hEc_stalk : ∀ l : Fin r_c,
      E_c l ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback (f_0 ≫ g_WB)
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (algebraMap ↥R (IsLocalRing.maximalIdeal ↥R).ResidueField)))) ∧
      π_0 l ≠ 0 ∧
      IsComponentStalkVal R (f_0 ≫ g_WB) η_X0 (E_c l) (W_c l) ∧
      IsDiscValuationOnWB R u₀_WB η_WB (φ_F0_FWB.comp φ_KF0) (φ_F0_FWB T_0)
        (c_0 l) (π_0 l) (W_c l))
    (N : ℕ) (c π : Fin N → ↥R)
    (M_1 : AlgebraicGeometry.Scheme.{u})
    (g_M1 : M_1 ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
    (f_M1 : M_1 ⟶ M_0)
    (η_M1 : AlgebraicGeometry.Spec (CommRingCat.of F_0) ⟶ M_1)
    (Z_M1 : Set ↥M_0)
    (B_1 : Fin N → Set ↥(CategoryTheory.Limits.pullback g_M1
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥R (IsLocalRing.maximalIdeal ↥R).ResidueField)))))
    (hMod1 : IsBaseDiscTreeModel R a_opt g_M0 m_0 η_M0 φ_KF0 T_0 c π
      M_1 g_M1 f_M1 η_M1 Z_M1 B_1)
    (hNonBd_in_rc : ∀ i : Fin N, ¬ IsDiscBoundaryIdx ↥R a_opt (c i) (π i) →
      ∃ l : Fin r_c, IsValDiscEq ↥R (c i) (π i) (c_0 l) (π_0 l)) :
    CategoryTheory.IsIso ((CategoryTheory.Limits.pullback.snd f_M1 e_0) ∣_
      (⟨Z_modᶜ, hZ_closed.isOpen_compl⟩ : W_B_sch.Opens)) :=
by
  obtain ⟨hSS_M1, hProp_fM1, hfM1_g, hη_M1, hZM1_cl, hIso_fM1, hZM1_pts, _⟩ := hMod1
  have hZM1_neBot : ∀ y ∈ Z_M1, (g_M0.base y).asIdeal ≠ ⊥ :=
    fun y hy => (hZM1_pts y hy).1
  have hSpec_M0 : ∃ (A_0 : CommRingCat.{u}) (iso : M_0 ≅ AlgebraicGeometry.Spec A_0), True := by
    rcases hStd.2.2 with ⟨_, iso, _⟩ | ⟨_, iso, _⟩
    · exact ⟨_, iso, trivial⟩
    · exact ⟨_, iso, trivial⟩
  obtain ⟨A_0, iso_M0, _⟩ := hSpec_M0
  have hAff_M0 : AlgebraicGeometry.IsAffine M_0 :=
    AlgebraicGeometry.isAffine_of_isAffineHom iso_M0.hom
  let U_compl : W_B_sch.Opens := ⟨Z_modᶜ, hZ_closed.isOpen_compl⟩
  have hηWB_U : ∀ pt : AlgebraicGeometry.Spec (CommRingCat.of F_WB), η_WB.base pt ∈ U_compl := by
    intro pt
    have hηWB_g : η_WB ≫ g_WB =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (φ_F0_FWB.comp (φ_KF0.comp R.subtype))) := by
      calc η_WB ≫ g_WB
        _ = (η_WB ≫ e_0) ≫ g_M0 := by rw [← he0_comm, CategoryTheory.Category.assoc]
        _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_F0_FWB) ≫ η_M0) ≫ g_M0 := by
            rw [hη_e0]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_F0_FWB) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_KF0.comp R.subtype)) := by
            rw [CategoryTheory.Category.assoc, hStd.2.1]
        _ = AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (φ_F0_FWB.comp (φ_KF0.comp R.subtype))) := by
            rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    have hpt_bot : pt.asIdeal = ⊥ := by
      refine le_bot_iff.mp fun x hx => ?_
      by_contra hx0
      exact pt.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem pt.asIdeal hx (IsUnit.mk0 x hx0))
    have hIdeal_bot : (g_WB.base (η_WB.base pt)).asIdeal = ⊥ := by
      have hbase_eq : g_WB.base (η_WB.base pt) =
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (φ_F0_FWB.comp (φ_KF0.comp R.subtype)))).base pt := by
        change (η_WB ≫ g_WB).base pt = _
        rw [hηWB_g]
      rw [hbase_eq]
      change Ideal.comap (φ_F0_FWB.comp (φ_KF0.comp R.subtype)) pt.asIdeal = ⊥
      rw [hpt_bot]
      refine le_bot_iff.mp fun r hr => ?_
      have hzero : φ_F0_FWB (φ_KF0 (R.subtype r)) = 0 := hr
      exact Subtype.val_injective (φ_KF0.injective (φ_F0_FWB.injective
        (hzero.trans (by simp))))
    intro hmem
    exact hZ_neBot (η_WB.base pt) hmem hIdeal_bot
  obtain ⟨hDichot_cl, hSub_M1⟩ :=
    weil_standard_model_fiber_dichotomy_and_nonclosed_subsingleton
      K m R hPkg_R hMax_R a_opt M_0 M_1 g_M0 g_M1 f_M1 m_0 F_0 η_M0 η_M1 φ_KF0 T_0
      Z_M1 hZM1_cl hStd hSS_M1 hfM1_g hη_M1 hIso_fM1 hZM1_neBot
  refine weil_pullback_snd_iso_over_open_of_base_fiber_subsingleton
    K m R hPkg_R M_0 W_B_sch M_1 g_M0 g_WB g_M1 e_0 f_M1 F_0 F_WB η_M0 η_WB η_M1
    φ_KF0 φ_F0_FWB Z_M1 hZM1_cl U_compl hAff_M0 hAff_WB hSS_WB hEt_e0 he0_comm
    hFunc_WB hStd.2.1 hη_e0 hSS_M1 hProp_fM1 hfM1_g hη_M1 hIso_fM1 hZM1_neBot hηWB_U ?_
  intro y_B hy_B
  have hy_B_notZ : y_B ∉ Z_mod := hy_B
  let y_bar : ↥M_0 := e_0.base y_B
  apply hSub_M1 y_bar
  by_cases hy_bar : y_bar ∈ Z_M1
  · refine Or.inr ?_
    by_contra hNo_sp
    have hFib_cl : ∀ z : ↥M_0,
        z ∈ closure ({y_bar} : Set ↥M_0) → g_M0.base z = g_M0.base y_bar → z = y_bar := by
      intro z hz_cl hz_fib
      by_contra hne
      exact hNo_sp ⟨z, hz_cl, hz_fib, hne⟩
    obtain ⟨z_bar0, hy_in_cl_z0, hz0_fib, hz0_ne⟩ := hDichot_cl y_bar hFib_cl
    obtain ⟨_, _, i, hi_nb, _, W_0, ψ_M0, pW0, hW0_disc, hψ_M0, hpW0_eq⟩ :=
      hZM1_pts y_bar hy_bar
    obtain ⟨l, hEq_il⟩ := hNonBd_in_rc i hi_nb
    obtain ⟨hEl_irred, hπ0_ne, hWl_stalk, hWl_disc⟩ := hEc_stalk l
    obtain ⟨ψ_WB, _, _, _, _, hψ_WB, _⟩ := id hWl_disc
    obtain ⟨_, j_W, pW, hj_W_sub, hpW_eq⟩ :=
      weil_disc_valuation_comap_and_prime_lift
        K m R hPkg_R hMax_R a_opt M_0 W_B_sch g_M0 m_0 u₀_WB F_0 F_WB η_M0 η_WB
        φ_KF0 φ_F0_FWB T_0 hStd (c i) (π i) (c_0 l) (π_0 l) hπ0_ne hEq_il
        W_0 (W_c l) hW0_disc hWl_disc pW0
    have hψ_comm : ψ_WB ≫ e_0 =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom j_W) ≫ ψ_M0 := by
      rw [← CategoryTheory.cancel_mono iso_M0.hom]
      let f₁ : AlgebraicGeometry.Spec (CommRingCat.of ↥(W_c l)) ⟶ AlgebraicGeometry.Spec A_0 :=
        (ψ_WB ≫ e_0) ≫ iso_M0.hom
      let f₂ : AlgebraicGeometry.Spec (CommRingCat.of ↥(W_c l)) ⟶ AlgebraicGeometry.Spec A_0 :=
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom j_W) ≫ ψ_M0) ≫ iso_M0.hom
      change f₁ = f₂
      rw [← AlgebraicGeometry.Spec.map_preimage f₁, ← AlgebraicGeometry.Spec.map_preimage f₂]
      congr 1
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro a
      apply (Subtype.val_injective : Function.Injective (W_c l).subtype)
      have h_eq :
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (W_c l).subtype) ≫ f₁ =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (W_c l).subtype) ≫ f₂ := by
        dsimp only [f₁, f₂]
        have hLHS :
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (W_c l).subtype) ≫
              (ψ_WB ≫ e_0) ≫ iso_M0.hom =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_F0_FWB) ≫ η_M0 ≫ iso_M0.hom := by
          calc AlgebraicGeometry.Spec.map (CommRingCat.ofHom (W_c l).subtype) ≫
                (ψ_WB ≫ e_0) ≫ iso_M0.hom
            _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (W_c l).subtype) ≫ ψ_WB) ≫
                  e_0 ≫ iso_M0.hom := by simp only [CategoryTheory.Category.assoc]
            _ = η_WB ≫ e_0 ≫ iso_M0.hom := by rw [hψ_WB]
            _ = (η_WB ≫ e_0) ≫ iso_M0.hom := by simp only [CategoryTheory.Category.assoc]
            _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_F0_FWB) ≫ η_M0 ≫ iso_M0.hom := by
                rw [hη_e0, CategoryTheory.Category.assoc]
        have hRHS :
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (W_c l).subtype) ≫
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom j_W) ≫ ψ_M0) ≫ iso_M0.hom =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_F0_FWB) ≫ η_M0 ≫ iso_M0.hom := by
          have hsub_comp :
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (W_c l).subtype) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom j_W) =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_F0_FWB) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom W_0.subtype) := by
            rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
              ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hj_W_sub]
          calc AlgebraicGeometry.Spec.map (CommRingCat.ofHom (W_c l).subtype) ≫
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom j_W) ≫ ψ_M0) ≫ iso_M0.hom
            _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (W_c l).subtype) ≫
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom j_W)) ≫ ψ_M0 ≫ iso_M0.hom := by
                simp only [CategoryTheory.Category.assoc]
            _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_F0_FWB) ≫
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom W_0.subtype)) ≫ ψ_M0 ≫ iso_M0.hom := by
                rw [hsub_comp]
            _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_F0_FWB) ≫
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom W_0.subtype) ≫ ψ_M0) ≫ iso_M0.hom := by
                simp only [CategoryTheory.Category.assoc]
            _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_F0_FWB) ≫ η_M0 ≫ iso_M0.hom := by
                rw [hψ_M0]
        exact hLHS.trans hRHS.symm
      have h_pre := congrArg AlgebraicGeometry.Spec.preimage h_eq
      rw [AlgebraicGeometry.Spec.preimage_comp, AlgebraicGeometry.Spec.preimage_comp,
        AlgebraicGeometry.Spec.preimage_map] at h_pre
      exact congrArg (fun g : A_0 ⟶ CommRingCat.of F_WB => g.hom a) h_pre
    let y_1 : ↥W_B_sch := ψ_WB.base pW
    have hy1_e0 : e_0.base y_1 = y_bar := by
      change (ψ_WB ≫ e_0).base pW = y_bar
      rw [hψ_comm]
      change ψ_M0.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom j_W)).base pW) = y_bar
      rw [hpW_eq, hpW0_eq]
    haveI : AlgebraicGeometry.Etale e_0 := hEt_e0
    have hy_sp : z_bar0 ⤳ (e_0 : ↥W_B_sch → ↥M_0) y_1 := by
      have heq_y : (e_0 : ↥W_B_sch → ↥M_0) y_1 = y_bar := hy1_e0
      rw [heq_y]
      exact specializes_iff_mem_closure.mpr hy_in_cl_z0
    obtain ⟨z_1, hz1_sp, hz1_eq⟩ := AlgebraicGeometry.Flat.generalizingMap e_0 hy_sp
    have hz1_e0 : e_0.base z_1 = z_bar0 := hz1_eq
    have hz1_cl : y_1 ∈ closure ({z_1} : Set ↥W_B_sch) :=
      specializes_iff_mem_closure.mp hz1_sp
    have hz1_fib : g_WB.base z_1 = g_WB.base y_1 := by
      calc g_WB.base z_1
        _ = (e_0 ≫ g_M0).base z_1 := by rw [he0_comm]
        _ = g_M0.base (e_0.base z_1) := rfl
        _ = g_M0.base z_bar0 := by rw [hz1_e0]
        _ = g_M0.base y_bar := hz0_fib
        _ = g_M0.base (e_0.base y_1) := by rw [hy1_e0]
        _ = (e_0 ≫ g_M0).base y_1 := rfl
        _ = g_WB.base y_1 := by rw [he0_comm]
    have hz1_ne : z_1 ≠ y_1 := by
      intro heq
      apply hz0_ne
      rw [← hz1_e0, heq, hy1_e0]
    have hy1_mem : y_1 ∈ Z_mod :=
      weil_contracted_component_val_generalization_mem_mod
        K R W_B_sch X_0_sch g_WB f_0 Z_mod hZ_closed F_WB η_WB η_X0
        hAff_WB hSS_WB hSS_X0 hIso_f0_compl hηX0_f0 (E_c l) hEl_irred (W_c l)
        hWl_stalk ψ_WB hψ_WB pW z_1 hz1_cl hz1_fib hz1_ne
    have hyB_mem_pre : y_B ∈ e_0.base ⁻¹' {e_0.base y_1} := by
      change e_0.base y_B = e_0.base y_1
      exact hy1_e0.symm
    rw [he0_Zmod y_1 hy1_mem, Set.mem_singleton_iff] at hyB_mem_pre
    exact hy_B_notZ (hyB_mem_pre ▸ hy1_mem)
  · exact Or.inl hy_bar

theorem weil_birational_modification_graph_closure_and_val_subsingleton (W_B_sch Y₁ Y₂ : AlgebraicGeometry.Scheme.{u})
    (F : Type u) [Field F]
    (f₁ : Y₁ ⟶ W_B_sch) (f₂ : Y₂ ⟶ W_B_sch)
    (η_WB : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ W_B_sch)
    (η₁ : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ Y₁)
    (η₂ : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ Y₂)
    (U_compl : W_B_sch.Opens)
    (hAff_WB : AlgebraicGeometry.IsAffine W_B_sch)
    (hInt_WB : AlgebraicGeometry.IsIntegral W_B_sch)
    (hInt₁ : AlgebraicGeometry.IsIntegral Y₁)
    (hInt₂ : AlgebraicGeometry.IsIntegral Y₂)
    (hProp₁ : AlgebraicGeometry.IsProper f₁)
    (hProp₂ : AlgebraicGeometry.IsProper f₂)
    (hη₁_f : η₁ ≫ f₁ = η_WB)
    (hη₂_f : η₂ ≫ f₂ = η_WB)
    (hFunc_WB : IsSchemeFunctionField W_B_sch F η_WB)
    (hFunc₁ : IsSchemeFunctionField Y₁ F η₁)
    (hFunc₂ : IsSchemeFunctionField Y₂ F η₂)
    (hIso₁ : CategoryTheory.IsIso (f₁ ∣_ U_compl)) :
    ∃ (Γ : AlgebraicGeometry.Scheme.{u})
      (π₁ : Γ ⟶ Y₁) (π₂ : Γ ⟶ Y₂)
      (η_Γ : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ Γ),
      (AlgebraicGeometry.IsIntegral Γ ∧
        AlgebraicGeometry.IsProper π₁ ∧
        AlgebraicGeometry.IsProper π₂ ∧
        AlgebraicGeometry.IsDominant η_Γ ∧
        IsSchemeFunctionField Γ F η_Γ ∧
        π₁ ≫ f₁ = π₂ ≫ f₂ ∧
        η_Γ ≫ π₁ = η₁ ∧
        η_Γ ≫ π₂ = η₂) ∧
      (∀ w : ↥Y₂, f₂.base w ∈ U_compl → (π₂.base ⁻¹' {w}).Subsingleton) ∧
      (∀ w : ↥Y₂,
        (∃ (U_w : Y₂.Opens) (hUw : AlgebraicGeometry.IsAffineOpen U_w) (hw : w ∈ U_w)
