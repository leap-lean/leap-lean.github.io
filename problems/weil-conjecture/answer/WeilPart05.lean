    obtain ⟨a, k, hak⟩ := (hOfPrime x.1).mp x.2
    have ha_eq : ι_VP a = x * (ι_VP ϖ) ^ k := Subtype.ext hak.symm
    have haQ : a ∈ (j_VP.base Q_R).asIdeal := by
