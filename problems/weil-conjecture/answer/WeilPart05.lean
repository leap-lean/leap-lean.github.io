        y ∈ W ∧ a ≠ 0 ∧ AlgebraicGeometry.Etale e ∧
        W.ι ≫ g_tilde = e ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C))) := by
    intro y
    have hy_cov : y ∈ Set.range j_1.base ∪ Set.range j_2.base := hCov_j12 ▸ Set.mem_univ y
    rcases hy_cov with ⟨u, rfl⟩ | ⟨v, rfl⟩
    · rcases hCharts_Ubl u with ⟨W, e, huW, he, hcomm⟩ | ⟨W, a, e, huW, ha, he, hcomm⟩
      · exact Or.inl (hPushChart j_1 g_Ubl _ u W e hj1_g huW he hcomm)
      · obtain ⟨W', e', hyW', he', hcomm'⟩ := hPushChart j_1 g_Ubl _ u W e hj1_g huW he hcomm
        exact Or.inr ⟨W', a, e', hyW', ha, he', hcomm'⟩
    · rcases hCharts_M' (U_compl.ι.base v) with
        ⟨W', e', hvW', he', hcomm'⟩ | ⟨W', a, e', hvW', ha, he', hcomm'⟩
      · left
        let W_v : U_compl.toScheme.Opens := U_compl.ι ⁻¹ᵁ W'
        have hsub : Set.range (W_v.ι ≫ U_compl.ι).base ⊆ Set.range W'.ι.base := by
          rw [AlgebraicGeometry.Scheme.Opens.range_ι]
          rintro _ ⟨w, rfl⟩; exact w.2
        let ℓ : W_v.toScheme ⟶ W'.toScheme :=
          AlgebraicGeometry.IsOpenImmersion.lift W'.ι (W_v.ι ≫ U_compl.ι) hsub
        have hℓ_fac : ℓ ≫ W'.ι = W_v.ι ≫ U_compl.ι :=
          AlgebraicGeometry.IsOpenImmersion.lift_fac W'.ι (W_v.ι ≫ U_compl.ι) hsub
        haveI : AlgebraicGeometry.IsOpenImmersion (ℓ ≫ W'.ι) := by
          rw [hℓ_fac]; infer_instance
        haveI : AlgebraicGeometry.IsOpenImmersion ℓ :=
          AlgebraicGeometry.IsOpenImmersion.of_comp ℓ W'.ι
        refine hPushChart j_2 (U_compl.ι ≫ g'_M) _ v W_v (ℓ ≫ e') hj2_g hvW' inferInstance ?_
        rw [← CategoryTheory.Category.assoc, ← hℓ_fac, CategoryTheory.Category.assoc,
          hcomm', CategoryTheory.Category.assoc]
      · right
        let W_v : U_compl.toScheme.Opens := U_compl.ι ⁻¹ᵁ W'
        have hsub : Set.range (W_v.ι ≫ U_compl.ι).base ⊆ Set.range W'.ι.base := by
          rw [AlgebraicGeometry.Scheme.Opens.range_ι]
          rintro _ ⟨w, rfl⟩; exact w.2
        let ℓ : W_v.toScheme ⟶ W'.toScheme :=
          AlgebraicGeometry.IsOpenImmersion.lift W'.ι (W_v.ι ≫ U_compl.ι) hsub
        have hℓ_fac : ℓ ≫ W'.ι = W_v.ι ≫ U_compl.ι :=
          AlgebraicGeometry.IsOpenImmersion.lift_fac W'.ι (W_v.ι ≫ U_compl.ι) hsub
        haveI : AlgebraicGeometry.IsOpenImmersion (ℓ ≫ W'.ι) := by
          rw [hℓ_fac]; infer_instance
        haveI : AlgebraicGeometry.IsOpenImmersion ℓ :=
          AlgebraicGeometry.IsOpenImmersion.of_comp ℓ W'.ι
        obtain ⟨W_t, e_t, hy_t, he_t, hcomm_t⟩ :=
          hPushChart j_2 (U_compl.ι ≫ g'_M) _ v W_v (ℓ ≫ e') hj2_g hvW' inferInstance (by
            rw [← CategoryTheory.Category.assoc, ← hℓ_fac, CategoryTheory.Category.assoc,
              hcomm', CategoryTheory.Category.assoc])
        exact ⟨W_t, a, e_t, hy_t, ha, he_t, hcomm_t⟩
  have hSS_tilde : IsStrictlySemistableCurveOverValuation R (q_M ≫ g'_M) :=
    ⟨hInt_Mtilde, hFlat_tilde, hSep_tilde, hLfp_tilde, hCharts_tilde⟩
  
  have hη'_sub : Set.range η'_M.base ⊆ Set.range U_compl.ι.base := by
    rw [AlgebraicGeometry.Scheme.Opens.range_ι]
    rintro _ ⟨pt, rfl⟩
    exact hη'_not_Mod pt
  let η_U : AlgebraicGeometry.Spec (CommRingCat.of F_0) ⟶ U_compl.toScheme :=
    AlgebraicGeometry.IsOpenImmersion.lift U_compl.ι η'_M hη'_sub
  have hηU_fac : η_U ≫ U_compl.ι = η'_M :=
    AlgebraicGeometry.IsOpenImmersion.lift_fac U_compl.ι η'_M hη'_sub
  let η_tilde : AlgebraicGeometry.Spec (CommRingCat.of F_0) ⟶ M_tilde := η_U ≫ j_2
  have hη_q : η_tilde ≫ q_M = η'_M := by
    change (η_U ≫ j_2) ≫ q_M = η'_M
    rw [CategoryTheory.Category.assoc, hj2_q, hηU_fac]
  have hη_not_Mod : ∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of F_0)),
      (η_tilde ≫ q_M).base pt ∉ Mod_qM := by
    intro pt; rw [hη_q]; exact hη'_not_Mod pt
  have hη_aff : ∀ (W_aff : AlgebraicGeometry.Scheme.{u})
      (ι_aff : W_aff ⟶ U_bl)
      (ξ : AlgebraicGeometry.Spec (CommRingCat.of F_0) ⟶ W_aff),
      AlgebraicGeometry.IsOpenImmersion ι_aff →
      ξ ≫ ι_aff ≫ p_bl ≫ ι_ctr = η'_M →
      ξ ≫ ι_aff ≫ j_1 = η_tilde := by
    intro W_aff ι_aff ξ _ hξ
    let ζ : AlgebraicGeometry.Spec (CommRingCat.of F_0) ⟶ M_tilde := ξ ≫ ι_aff ≫ j_1
    have hζ_q : ζ ≫ q_M = η'_M := by
      dsimp [ζ]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hj1_q, hξ]
    have hζ_sub : Set.range ζ.base ⊆ Set.range j_2.base := by
      rw [← hPre_compl]
      rintro _ ⟨pt, rfl⟩
      change (ζ ≫ q_M).base pt ∈ Mod_qMᶜ
      rw [hζ_q]
      exact hη'_not_Mod pt
    let ζ_U := AlgebraicGeometry.IsOpenImmersion.lift j_2 ζ hζ_sub
    have hζU_fac : ζ_U ≫ j_2 = ζ :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac j_2 ζ hζ_sub
    have hζU_eq : ζ_U = η_U := by
      apply (CategoryTheory.cancel_mono U_compl.ι).mp
      rw [hηU_fac, ← hj2_q, ← CategoryTheory.Category.assoc, hζU_fac, hζ_q]
    change ζ = η_tilde
    rw [← hζU_fac, hζU_eq]
  have hZtilde_cl : IsClosed (Z_M' ∪ f'_M.base '' Mod_qM) :=
    hZM'_cl.union (f'_M.isClosedMap _ hMod_cl)
  let W_0 : M_0.Opens := ⟨(Z_M' ∪ f'_M.base '' Mod_qM)ᶜ, hZtilde_cl.isOpen_compl⟩
  let U_0 : M_0.Opens := ⟨Z_M'ᶜ, hZM'_cl.isOpen_compl⟩
  have hW0_le : W_0 ≤ U_0 := fun _ hy hz => hy (Or.inl hz)
  have hW'_le : (f'_M ⁻¹ᵁ W_0) ≤ U_compl := fun x hx hmod => hx (Or.inr ⟨x, hmod, rfl⟩)
  have hIso_f_W0 : CategoryTheory.IsIso (f'_M ∣_ W_0) := hIsoOfLE f'_M hW0_le hIso_f'
  have hIso_q_W' : CategoryTheory.IsIso (q_M ∣_ (f'_M ⁻¹ᵁ W_0)) :=
    hIsoOfLE q_M hW'_le hIso_q_compl
  have hIso_Ztilde : CategoryTheory.IsIso ((q_M ≫ f'_M) ∣_ W_0) := by
    rw [AlgebraicGeometry.morphismRestrict_comp]
    exact @CategoryTheory.IsIso.comp_isIso _ _ _ _ _
      (q_M ∣_ (f'_M ⁻¹ᵁ W_0)) (f'_M ∣_ W_0) hIso_q_W' hIso_f_W0
  let τ₀ : AlgebraicGeometry.Spec (CommRingCat.of (↥R ⧸ Q₀_R.asIdeal)) ⟶ M_tilde :=
    τ₀_loc ≫ j_1
  let τ₁ : AlgebraicGeometry.Spec (CommRingCat.of (↥R ⧸ Q₀_R.asIdeal)) ⟶ M_tilde :=
    τ₁_loc ≫ j_1
  have hτ₀_q : τ₀ ≫ q_M = σ_Mod := by
    change (τ₀_loc ≫ j_1) ≫ q_M = σ_loc ≫ ι_ctr
    rw [CategoryTheory.Category.assoc, hj1_q, ← CategoryTheory.Category.assoc, hτ₀_p]
  have hτ₁_q : τ₁ ≫ q_M = σ_Mod := by
    change (τ₁_loc ≫ j_1) ≫ q_M = σ_loc ≫ ι_ctr
    rw [CategoryTheory.Category.assoc, hj1_q, ← CategoryTheory.Category.assoc, hτ₁_p]
  have hτ01_disj : Disjoint (Set.range τ₀.base) (Set.range τ₁.base) := by
    rw [Set.disjoint_left]
    rintro _ ⟨a, rfl⟩ ⟨b, heq⟩
    have hab : τ₀_loc.base a = τ₁_loc.base b := j_1.isOpenEmbedding.injective heq.symm
    exact Set.disjoint_left.mp hτ_disj ⟨a, rfl⟩ ⟨b, hab.symm⟩
  have hSurj_qM : AlgebraicGeometry.Surjective q_M := by
    refine ⟨fun x => ?_⟩
    by_cases hx : x ∈ Mod_qM
    · rcases hx with ⟨q, rfl⟩
      refine ⟨τ₀.base q, ?_⟩
      change (τ₀ ≫ q_M).base q = σ_Mod.base q
      rw [hτ₀_q]
    · refine ⟨j_2.base ⟨x, hx⟩, ?_⟩
      change (j_2 ≫ q_M).base ⟨x, hx⟩ = x
      rw [hj2_q]; rfl
  have hPre_sec : ∀ q : AlgebraicGeometry.Spec (CommRingCat.of (↥R ⧸ Q₀_R.asIdeal)),
      q_M.base ⁻¹' {σ_Mod.base q} = j_1.base '' (p_bl.base ⁻¹' {σ_loc.base q}) := by
    intro q
    ext y
    simp only [Set.mem_preimage, Set.mem_singleton_iff, Set.mem_image]
    constructor
    · intro hy
      have hy_not_j2 : y ∉ Set.range j_2.base := by
        rw [← hPre_compl]
        intro hnot
        exact hnot ⟨q, hy.symm⟩
      have hy_cov : y ∈ Set.range j_1.base ∪ Set.range j_2.base := hCov_j12 ▸ Set.mem_univ y
      rcases hy_cov with ⟨u, rfl⟩ | hy2
      · refine ⟨u, ?_, rfl⟩
        change (j_1 ≫ q_M).base u = σ_Mod.base q at hy
        rw [hj1_q] at hy
        exact ι_ctr.isOpenEmbedding.injective hy
      · exact False.elim (hy_not_j2 hy2)
    · rintro ⟨u, hu, rfl⟩
      change (j_1 ≫ q_M).base u = σ_Mod.base q
      rw [hj1_q]
      change ι_ctr.base (p_bl.base u) = ι_ctr.base (σ_loc.base q)
      rw [hu]
  let E_Z_M : Set ↥M_tilde := j_1.base '' (p_bl.base ⁻¹' {σ_loc.base q_max})
  have hPre_znew : q_M.base ⁻¹' {z_new_M} = E_Z_M := hPre_sec q_max
  have hPre_z0 : q_M.base ⁻¹' {z₀_M} = j_1.base '' (p_bl.base ⁻¹' {σ_loc.base q_gen}) :=
    hPre_sec q_gen
  have hEZ_cl : IsClosed E_Z_M := by
    rw [← hPre_znew]
    exact hz_new_cl.preimage q_M.continuous
  have hEZ_irr : IsIrreducible E_Z_M :=
    hEloc_irr.image j_1.base j_1.continuous.continuousOn
  have hGen_irr_M : IsIrreducible (q_M.base ⁻¹' {z₀_M}) := by
    rw [hPre_z0]
    exact hGen_irr.image j_1.base j_1.continuous.continuousOn
  have hEZ_sub : E_Z_M ⊆
      {y : ↥M_tilde | ((q_M ≫ g'_M).base y).asIdeal = IsLocalRing.maximalIdeal ↥R} := by
    rw [← hPre_znew]
    intro y hy
    have hy_eq : q_M.base y = z_new_M := hy
    change (g'_M.base (q_M.base y)).asIdeal = IsLocalRing.maximalIdeal ↥R
    rw [hy_eq]
    exact hz_new_mR
  have hPre_Mod_cl : q_M.base ⁻¹' Mod_qM = closure (q_M.base ⁻¹' {z₀_M}) := by
    apply Set.Subset.antisymm
    · intro y hy
      have hy_not_j2 : y ∉ Set.range j_2.base := by
        rw [← hPre_compl]; exact fun hnot => hnot hy
      have hy_cov : y ∈ Set.range j_1.base ∪ Set.range j_2.base := hCov_j12 ▸ Set.mem_univ y
      rcases hy_cov with ⟨u, rfl⟩ | hy2
      · have hu : u ∈ j_1.base ⁻¹' (q_M.base ⁻¹' Mod_qM) := hy
        rw [hj1_pre_Mod, hMod_pre] at hu
        rw [hPre_z0]
        exact image_closure_subset_closure_image j_1.continuous ⟨u, hu, rfl⟩
      · exact False.elim (hy_not_j2 hy2)
    · refine closure_minimal ?_ (hMod_cl.preimage q_M.continuous)
      intro y hy
      change q_M.base y ∈ Mod_qM
      rw [Set.mem_preimage.mp hy]
      exact ⟨q_gen, rfl⟩
  have hSt_all : ∀ (S' : Set ↥M'),
      IsClosed S' →
      S' ⊆ {x : ↥M' | (g'_M.base x).asIdeal = IsLocalRing.maximalIdeal ↥R} →
      let B_st : Set ↥M_tilde := closure (q_M.base ⁻¹' (S' \ {z_new_M}))
      B_st ⊆ {y : ↥M_tilde | ((q_M ≫ g'_M).base y).asIdeal = IsLocalRing.maximalIdeal ↥R} ∧
      j_1.base ⁻¹' B_st = closure (p_bl.base ⁻¹' (ι_ctr.base ⁻¹' (S' \ {z_new_M}))) ∧
      j_2.base ⁻¹' B_st = U_compl.ι.base ⁻¹' S' := by
    intro S' hS'_cl hS'_sub
    dsimp only
    refine ⟨?_, ?_, ?_⟩
    · have hsub_qS : closure (q_M.base ⁻¹' (S' \ {z_new_M})) ⊆ q_M.base ⁻¹' S' :=
        closure_minimal (Set.preimage_mono Set.diff_subset) (hS'_cl.preimage q_M.continuous)
      intro y hy
      exact hS'_sub (hsub_qS hy)
    · rw [j_1.isOpenEmbedding.isOpenMap.preimage_closure_eq_closure_preimage j_1.continuous]
      congr 1
      change (j_1 ≫ q_M).base ⁻¹' (S' \ {z_new_M}) = _
      rw [hj1_q]
      rfl
    · rw [j_2.isOpenEmbedding.isOpenMap.preimage_closure_eq_closure_preimage j_2.continuous]
      have hpre_eq : j_2.base ⁻¹' (q_M.base ⁻¹' (S' \ {z_new_M})) = U_compl.ι.base ⁻¹' S' := by
        change (j_2 ≫ q_M).base ⁻¹' (S' \ {z_new_M}) = U_compl.ι.base ⁻¹' S'
        rw [hj2_q]
        ext v
        simp only [Set.mem_preimage, Set.mem_diff, Set.mem_singleton_iff, and_iff_left_iff_imp]
        rintro _ hv_eq
        have hv_mem : U_compl.ι.base v ∈ Mod_qM := by
          rw [hv_eq]
          exact ⟨q_max, rfl⟩
        exact v.2 hv_mem
      rw [hpre_eq]
      exact (hS'_cl.preimage U_compl.ι.continuous).closure_eq
  have hContr_model : IsBaseOneStepContractionModel R g_M0 m_0 isLeaf M_tilde M'
      (q_M ≫ g'_M) g'_M f'_M q_M Mod_qM z_new_M Q₀_R z₀_M E_Z_M :=
    ⟨hSS_tilde, ⟨hInt_M', hFlat_M', hSep_M', hLfp_M', hCharts_M'⟩, hf'_g,
      by rw [CategoryTheory.Category.assoc, hf'_g],
      hProp_qM, hProp_f', hSurj_qM, ⟨hMod_cl, hIso_q_compl⟩, hLeaf_sm,
      hQ₀_ne, ⟨q_max, rfl⟩, ⟨q_gen, rfl⟩, hz_m0, hz_new_mR, hz0_Q0,
      ⟨σ_Mod, τ₀, τ₁, hClImm_σMod, hσMod_g, rfl, hτ₀_q, hτ₁_q, hτ01_disj⟩,
      hGen_irr_M, hPre_Mod_cl, hPre_znew⟩
  exact ⟨hMod_cl, M_tilde, j_1, j_2, q_M, η_tilde,
    hOpen_j1, hOpen_j2, hCov_j12, hj1_q, hj2_q, hPre_compl, hj1_pre_Mod,
    hMod_inter, hz_new_cl, hEZ_cl, hEZ_irr, hEZ_sub,
    hη_q, hη_not_Mod, hη_aff, ⟨hZtilde_cl, hIso_Ztilde⟩, hSt_all, hContr_model⟩

theorem weil_away_chart_two_prime_shrinking_and_origin_eval (K : Type u) [Field K] (R : ValuationSubring K)
    (a_opt : Option ↥R)
    (M_0 : AlgebraicGeometry.Scheme.{u})
    (g_M0 : M_0 ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
    (m_0 : ↥M_0)
    (F_0 : Type u) [Field F_0]
    (η_M0 : AlgebraicGeometry.Spec (CommRingCat.of F_0) ⟶ M_0)
    (φ_KF0 : K →+* F_0) (T_0 : F_0)
    (hStd : IsStandardModelCoordDatum R a_opt M_0 g_M0 m_0 η_M0 φ_KF0 T_0)
    (hGauss : HasStandardGaussDiscValuations R a_opt g_M0 m_0 η_M0 φ_KF0 T_0) :
    (∀ (h : Polynomial ↥R) (c_val : ↥R)
       (M' M_tilde : AlgebraicGeometry.Scheme.{u})
       (g'_M : M' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
       (q_M : M_tilde ⟶ M')
       (Z : Set ↥M') (hZ_cl : IsClosed Z)
       (j_2 : AlgebraicGeometry.Scheme.Opens.toScheme
         (⟨Zᶜ, hZ_cl.isOpen_compl⟩ : M'.Opens) ⟶ M_tilde)
       (ι_U : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away h)) ⟶ M')
       (η_tilde : AlgebraicGeometry.Spec (CommRingCat.of F_0) ⟶ M_tilde)
       (φ_U : Localization.Away h →+* F_0),
      Polynomial.eval c_val h ∉ IsLocalRing.maximalIdeal ↥R →
      AlgebraicGeometry.IsOpenImmersion j_2 →
      j_2 ≫ q_M = AlgebraicGeometry.Scheme.Opens.ι (⟨Zᶜ, hZ_cl.isOpen_compl⟩ : M'.Opens) →
      q_M.base ⁻¹' Zᶜ = Set.range j_2.base →
      AlgebraicGeometry.IsOpenImmersion ι_U →
      ι_U ≫ g'_M = AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        ((algebraMap (Polynomial ↥R) (Localization.Away h)).comp Polynomial.C)) →
      (∀ pt, (η_tilde ≫ q_M).base pt ∉ Z) →
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_U) ≫ ι_U = η_tilde ≫ q_M →
      (∀ p₀ : PrimeSpectrum (Localization.Away h),
        (g'_M.base (ι_U.base p₀)).asIdeal = IsLocalRing.maximalIdeal ↥R →
        algebraMap (Polynomial ↥R) (Localization.Away h)
          (Polynomial.X - Polynomial.C c_val) ∈ p₀.asIdeal →
        ι_U.base p₀ ∉ Z) →
      ∃ (g : Polynomial ↥R)
        (lam : Localization.Away h →+* Localization.Away (h * g))
        (ι_tilde : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (h * g))) ⟶ M_tilde)
        (u_lift : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (h * g))) ⟶
          AlgebraicGeometry.Scheme.Opens.toScheme (⟨Zᶜ, hZ_cl.isOpen_compl⟩ : M'.Opens))
        (φ_tilde : Localization.Away (h * g) →+* F_0),
        Polynomial.eval c_val (h * g) ∉ IsLocalRing.maximalIdeal ↥R ∧
        (∀ P : Polynomial ↥R,
          lam (algebraMap (Polynomial ↥R) (Localization.Away h) P) =
            algebraMap (Polynomial ↥R) (Localization.Away (h * g)) P) ∧
        AlgebraicGeometry.IsOpenImmersion ι_tilde ∧
        u_lift ≫ j_2 = ι_tilde ∧
        u_lift ≫ AlgebraicGeometry.Scheme.Opens.ι (⟨Zᶜ, hZ_cl.isOpen_compl⟩ : M'.Opens) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom lam) ≫ ι_U ∧
        ι_tilde ≫ (q_M ≫ g'_M) = AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          ((algebraMap (Polynomial ↥R) (Localization.Away (h * g))).comp Polynomial.C)) ∧
        (∀ P : Polynomial ↥R,
          φ_tilde (algebraMap (Polynomial ↥R) (Localization.Away (h * g)) P) =
            φ_U (algebraMap (Polynomial ↥R) (Localization.Away h) P)) ∧
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_tilde) ≫ ι_tilde = η_tilde) ∧
    (∀ (h : Polynomial ↥R) (c_val : ↥R)
       (M' M_tilde : AlgebraicGeometry.Scheme.{u})
       (g'_M : M' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
       (q_M : M_tilde ⟶ M')
       (Z : Set ↥M') (hZ_cl : IsClosed Z)
       (j_2 : AlgebraicGeometry.Scheme.Opens.toScheme
         (⟨Zᶜ, hZ_cl.isOpen_compl⟩ : M'.Opens) ⟶ M_tilde)
       (ι_U : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away h)) ⟶ M'),
      Polynomial.eval c_val h ∉ IsLocalRing.maximalIdeal ↥R →
      AlgebraicGeometry.IsOpenImmersion j_2 →
      j_2 ≫ q_M = AlgebraicGeometry.Scheme.Opens.ι (⟨Zᶜ, hZ_cl.isOpen_compl⟩ : M'.Opens) →
      AlgebraicGeometry.IsOpenImmersion ι_U →
      ι_U ≫ g'_M = AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        ((algebraMap (Polynomial ↥R) (Localization.Away h)).comp Polynomial.C)) →
      (∀ p₀ : PrimeSpectrum (Localization.Away h),
        (g'_M.base (ι_U.base p₀)).asIdeal = IsLocalRing.maximalIdeal ↥R →
        algebraMap (Polynomial ↥R) (Localization.Away h)
          (Polynomial.X - Polynomial.C c_val) ∈ p₀.asIdeal →
        ι_U.base p₀ ∉ Z) →
      ∃ (g : Polynomial ↥R)
        (lam : Localization.Away h →+* Localization.Away (h * g))
        (ι_tilde : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (h * g))) ⟶ M_tilde)
        (u_lift : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (h * g))) ⟶
          AlgebraicGeometry.Scheme.Opens.toScheme (⟨Zᶜ, hZ_cl.isOpen_compl⟩ : M'.Opens)),
        Polynomial.eval c_val (h * g) ∉ IsLocalRing.maximalIdeal ↥R ∧
        (∀ P : Polynomial ↥R,
          lam (algebraMap (Polynomial ↥R) (Localization.Away h) P) =
            algebraMap (Polynomial ↥R) (Localization.Away (h * g)) P) ∧
        AlgebraicGeometry.IsOpenImmersion ι_tilde ∧
        u_lift ≫ j_2 = ι_tilde ∧
        u_lift ≫ AlgebraicGeometry.Scheme.Opens.ι (⟨Zᶜ, hZ_cl.isOpen_compl⟩ : M'.Opens) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom lam) ≫ ι_U ∧
        ι_tilde ≫ (q_M ≫ g'_M) = AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          ((algebraMap (Polynomial ↥R) (Localization.Away (h * g))).comp Polynomial.C))) ∧
    (∀ (c' : ↥R) (h : weilNodalQuot ↥R c')
       (M' M_tilde : AlgebraicGeometry.Scheme.{u})
       (g'_M : M' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
       (q_M : M_tilde ⟶ M')
       (Z : Set ↥M') (hZ_cl : IsClosed Z)
       (j_2 : AlgebraicGeometry.Scheme.Opens.toScheme
         (⟨Zᶜ, hZ_cl.isOpen_compl⟩ : M'.Opens) ⟶ M_tilde)
       (ι_U : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away h)) ⟶ M')
       (η_tilde : AlgebraicGeometry.Spec (CommRingCat.of F_0) ⟶ M_tilde)
       (φ_U : Localization.Away h →+* F_0),
      c' ∈ IsLocalRing.maximalIdeal ↥R →
      h ∉ Ideal.span {Ideal.Quotient.mk (weilNodalIdeal ↥R c') (MvPolynomial.X 0),
            Ideal.Quotient.mk (weilNodalIdeal ↥R c') (MvPolynomial.X 1)} ⊔
          Ideal.map ((Ideal.Quotient.mk (weilNodalIdeal ↥R c')).comp MvPolynomial.C)
