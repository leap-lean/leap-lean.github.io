theorem weil_valuation_ofPrime_strictlySemistable_chart_rescaling (K : Type u) [Field K] (V : ValuationSubring K)
    (P : PrimeSpectrum ↥V) (ϖ : ↥V) (hϖ_P : ϖ ∉ P.asIdeal)
    (hLoc_VP : ∀ x : K,
      x ∈ V.ofPrime P.asIdeal ↔ ∃ (a : ↥V) (k : ℕ), x * (V.subtype ϖ) ^ k = V.subtype a)
    (hOpen_VP : AlgebraicGeometry.IsOpenImmersion
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (Subring.inclusion (ValuationSubring.le_ofPrime V P.asIdeal)))))
    (C_cur X'_0 U_2 C_next : AlgebraicGeometry.Scheme.{u})
    (g_cur : C_cur ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (g'_0 : X'_0 ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥(V.ofPrime P.asIdeal)))
    (g_next : C_next ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (ι_U2 : U_2 ⟶ C_cur) (hOpen_U2 : AlgebraicGeometry.IsOpenImmersion ι_U2)
    (ι_1 : X'_0 ⟶ C_next) (hOpen_1 : AlgebraicGeometry.IsOpenImmersion ι_1)
    (ι_2 : U_2 ⟶ C_next) (hOpen_2 : AlgebraicGeometry.IsOpenImmersion ι_2)
    (hCov : Set.range ι_1.base ∪ Set.range ι_2.base = Set.univ)
    (hIrred : IrreducibleSpace ↥C_next)
    (hSep : AlgebraicGeometry.IsSeparated g_next)
    (hSS_cur : IsStrictlySemistableCurveOverValuation V g_cur)
    (hSS_X'0 : IsStrictlySemistableCurveOverValuation (V.ofPrime P.asIdeal) g'_0)
    (hComm_1 : ι_1 ≫ g_next =
      g'_0 ≫ AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (Subring.inclusion (ValuationSubring.le_ofPrime V P.asIdeal))))
    (hComm_2 : ι_2 ≫ g_next = ι_U2 ≫ g_cur) :
    IsStrictlySemistableCurveOverValuation V g_next :=
by
  let R : Type u := ↥V
  let S : Type u := ↥(V.ofPrime P.asIdeal)
  let ι_VP : R →+* S := Subring.inclusion (ValuationSubring.le_ofPrime V P.asIdeal)
  let j_VP : AlgebraicGeometry.Spec (CommRingCat.of S) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of R) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_VP)
  let _ : Algebra R S := ι_VP.toAlgebra
  have hϖ_ne : ϖ ≠ 0 := fun h0 => hϖ_P (h0 ▸ P.asIdeal.zero_mem)
  have hw_ne : V.subtype ϖ ≠ 0 := fun hw => hϖ_ne (Subtype.ext hw)
  have hInv_mem : (V.subtype ϖ)⁻¹ ∈ V.ofPrime P.asIdeal := by
    refine (hLoc_VP (V.subtype ϖ)⁻¹).mpr ⟨1, 1, ?_⟩
    rw [pow_one, inv_mul_cancel₀ hw_ne, map_one]
  let u_inv : S := ⟨(V.subtype ϖ)⁻¹, hInv_mem⟩
  have hϖ_mul_inv : ι_VP ϖ * u_inv = 1 := by
    apply Subtype.ext
    change V.subtype ϖ * (V.subtype ϖ)⁻¹ = 1
    exact mul_inv_cancel₀ hw_ne
  have hinv_mul_ϖ : u_inv * ι_VP ϖ = 1 := by
    rw [mul_comm, hϖ_mul_inv]
  have hUnit_ϖ : IsUnit (algebraMap R S ϖ) :=
    ⟨⟨ι_VP ϖ, u_inv, hϖ_mul_inv, hinv_mul_ϖ⟩, rfl⟩
  have hLoc_S : IsLocalization.Away ϖ S := by
    refine IsLocalization.Away.mk ϖ hUnit_ϖ (fun s => ?_) (fun a b hab => ?_)
    · obtain ⟨a, n, hn⟩ := (hLoc_VP s.1).mp s.2
      refine ⟨n, a, ?_⟩
      apply Subtype.val_injective
      change (V.ofPrime P.asIdeal).subtype (s * (ι_VP ϖ) ^ n) =
        (V.ofPrime P.asIdeal).subtype (ι_VP a)
      rw [map_mul, map_pow]
      exact hn
    · have hab' : a = b := Subtype.ext (congrArg (V.ofPrime P.asIdeal).subtype hab)
      exact ⟨0, by rw [hab']⟩
  have hAwayEtale : ∀ {A B : Type u} [CommRing A] [CommRing B] (s₀ : A) (Φ : A →+* B)
      (φ : Localization.Away s₀ →+* B) (ψ : B →+* Localization.Away s₀),
      φ.comp (algebraMap A (Localization.Away s₀)) = Φ →
      φ.comp ψ = RingHom.id B →
      ψ.comp φ = RingHom.id (Localization.Away s₀) →
      AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom Φ)) := by
    intro A B _ _ s₀ Φ φ ψ hcomp hφψ hψφ
    have _ : CategoryTheory.IsIso (CommRingCat.ofHom φ) :=
      ⟨⟨CommRingCat.ofHom ψ,
        by rw [← CommRingCat.ofHom_comp, hψφ]; rfl,
        by rw [← CommRingCat.ofHom_comp, hφψ]; rfl⟩⟩
    have _ : CategoryTheory.IsIso (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)) :=
      inferInstance
    have _ : AlgebraicGeometry.IsOpenImmersion
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap A (Localization.Away s₀)))) :=
      AlgebraicGeometry.Scheme.isOpenImmersion_SpecMap_localizationAway
        (R := CommRingCat.of A) s₀
    have hEq_map : AlgebraicGeometry.Spec.map (CommRingCat.ofHom Φ) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ) ≫
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap A (Localization.Away s₀))) := by
      rw [← hcomp, CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp]
    rw [hEq_map]
    infer_instance
  let Φ_sm : Polynomial R →+* Polynomial S := Polynomial.mapRingHom ι_VP
  let Ψ_sm : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial S)) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of (Polynomial R)) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom Φ_sm)
  have hEt_sm : AlgebraicGeometry.Etale Ψ_sm := by
    let s_sm : Polynomial R := Polynomial.C ϖ
    let loc_sm : Polynomial R →+* Localization.Away s_sm :=
      algebraMap (Polynomial R) (Localization.Away s_sm)
    have hUnit_sm : IsUnit (Φ_sm s_sm) := by
      change IsUnit (Polynomial.map ι_VP (Polynomial.C ϖ))
      rw [Polynomial.map_C]
      exact hUnit_ϖ.map Polynomial.C
    let φ_sm : Localization.Away s_sm →+* Polynomial S :=
      IsLocalization.Away.lift s_sm hUnit_sm
    have hφ_comp : φ_sm.comp loc_sm = Φ_sm := IsLocalization.Away.lift_comp s_sm hUnit_sm
    let α_sm : R →+* Localization.Away s_sm := loc_sm.comp Polynomial.C
    have hUnit_α : IsUnit (α_sm ϖ) := IsLocalization.Away.algebraMap_isUnit s_sm
    let β_sm : S →+* Localization.Away s_sm := IsLocalization.Away.lift (S := S) ϖ hUnit_α
    have hβ_comp : β_sm.comp (algebraMap R S) = α_sm :=
      IsLocalization.Away.lift_comp (S := S) ϖ hUnit_α
    let ψ_sm : Polynomial S →+* Localization.Away s_sm :=
      Polynomial.eval₂RingHom β_sm (loc_sm Polynomial.X)
    have hφψ : φ_sm.comp ψ_sm = RingHom.id (Polynomial S) := by
      apply Polynomial.ringHom_ext'
      · have hC : (φ_sm.comp ψ_sm).comp Polynomial.C = φ_sm.comp β_sm := by
          apply RingHom.ext
          intro s
          simp [ψ_sm]
        rw [hC]
        apply IsLocalization.ringHom_ext (Submonoid.powers ϖ)
        apply RingHom.ext
        intro v
        have hv1 : β_sm (algebraMap R S v) = α_sm v := RingHom.congr_fun hβ_comp v
        have hv2 : φ_sm (α_sm v) = Φ_sm (Polynomial.C v) :=
          RingHom.congr_fun hφ_comp (Polynomial.C v)
        have hv3 : Φ_sm (Polynomial.C v) = Polynomial.C (ι_VP v) := by simp [Φ_sm]
        exact (congrArg φ_sm hv1).trans (hv2.trans hv3)
      · change φ_sm (ψ_sm Polynomial.X) = Polynomial.X
        have hX : ψ_sm Polynomial.X = loc_sm Polynomial.X := by simp [ψ_sm]
        rw [hX]
        have hv2 : φ_sm (loc_sm Polynomial.X) = Φ_sm Polynomial.X :=
          RingHom.congr_fun hφ_comp Polynomial.X
        simpa [Φ_sm] using hv2
    have hψφ : ψ_sm.comp φ_sm = RingHom.id (Localization.Away s_sm) := by
      apply IsLocalization.ringHom_ext (Submonoid.powers s_sm)
      rw [RingHom.id_comp, RingHom.comp_assoc, hφ_comp]
      apply Polynomial.ringHom_ext'
      · apply RingHom.ext
        intro v
        change ψ_sm (Φ_sm (Polynomial.C v)) = loc_sm (Polynomial.C v)
        have h1 : Φ_sm (Polynomial.C v) = Polynomial.C (ι_VP v) := by simp [Φ_sm]
        have h2 : ψ_sm (Polynomial.C (ι_VP v)) = β_sm (ι_VP v) := by simp [ψ_sm]
        rw [h1, h2]
        exact RingHom.congr_fun hβ_comp v
      · change ψ_sm (Φ_sm Polynomial.X) = loc_sm Polynomial.X
        simp [Φ_sm, ψ_sm]
    exact hAwayEtale s_sm Φ_sm φ_sm ψ_sm hφ_comp hφψ hψφ
  have hComm_sm : Ψ_sm ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) ≫ j_VP := by
    dsimp [Ψ_sm, j_VP]
    rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
    congr 2
    apply RingHom.ext
    intro v
    simp [Φ_sm]
  have hNodalLocStep : ∀ {A_R A_S : Type u} [CommRing A_R] [CommRing A_S]
      (π_R : MvPolynomial (Fin 2) R →+* A_R)
      (π_S : MvPolynomial (Fin 2) S →+* A_S)
      (Φ_nod : A_R →+* A_S) (r : ℕ) (a : R) (c' : S),
      Function.Surjective π_R →
      Function.Surjective π_S →
      (∀ {L : Type u} [CommRing L] (Ψ₀ : MvPolynomial (Fin 2) S →+* L),
        Ψ₀ (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c') = 0 →
        ∃ ψ : A_S →+* L, ψ.comp π_S = Ψ₀) →
      π_R (MvPolynomial.X 0) * π_R (MvPolynomial.X 1) = π_R (MvPolynomial.C a) →
      (∀ v : R, Φ_nod (π_R (MvPolynomial.C v)) = π_S (MvPolynomial.C (ι_VP v))) →
      (∀ i : Fin 2, Φ_nod (π_R (MvPolynomial.X i)) =
        π_S (MvPolynomial.C (ι_VP ϖ)) ^ r * π_S (MvPolynomial.X i)) →
      ι_VP a = c' * (ι_VP ϖ) ^ (2 * r) →
      AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom Φ_nod)) := by
    intro A_R A_S _ _ π_R π_S Φ_nod r a c' hSurj_R hSurj_S hLift_S hRel_R hΦ_C hΦ_X ha_eq
    let s₀ : A_R := π_R (MvPolynomial.C ϖ)
    let loc_nod : A_R →+* Localization.Away s₀ := algebraMap A_R (Localization.Away s₀)
    let w_inv : Localization.Away s₀ := IsLocalization.Away.invSelf s₀
    have hw_mul : loc_nod s₀ * w_inv = 1 := IsLocalization.Away.mul_invSelf s₀
    have hUnit_s₀ : IsUnit (Φ_nod s₀) := by
      rw [show Φ_nod s₀ = π_S (MvPolynomial.C (ι_VP ϖ)) from hΦ_C ϖ]
      exact hUnit_ϖ.map (π_S.comp MvPolynomial.C)
    let φ_nod : Localization.Away s₀ →+* A_S := IsLocalization.Away.lift s₀ hUnit_s₀
    have hφ_comp : φ_nod.comp loc_nod = Φ_nod := IsLocalization.Away.lift_comp s₀ hUnit_s₀
    have hφ_inv : Φ_nod s₀ * φ_nod w_inv = 1 := by
      calc
        Φ_nod s₀ * φ_nod w_inv = φ_nod (loc_nod s₀) * φ_nod w_inv :=
          congrArg (· * φ_nod w_inv) (RingHom.congr_fun hφ_comp s₀).symm
        _ = φ_nod (loc_nod s₀ * w_inv) := (map_mul φ_nod _ _).symm
        _ = 1 := by rw [hw_mul, map_one]
    let α_nod : R →+* Localization.Away s₀ := loc_nod.comp (π_R.comp MvPolynomial.C)
    have hUnit_α : IsUnit (α_nod ϖ) := IsLocalization.Away.algebraMap_isUnit s₀
    let β_nod : S →+* Localization.Away s₀ := IsLocalization.Away.lift (S := S) ϖ hUnit_α
    have hβ_comp : β_nod.comp (algebraMap R S) = α_nod :=
      IsLocalization.Away.lift_comp (S := S) ϖ hUnit_α
    have hβ_ϖ : β_nod (ι_VP ϖ) = loc_nod s₀ := RingHom.congr_fun hβ_comp ϖ
    have hβ_c : β_nod c' = loc_nod (π_R (MvPolynomial.C a)) * w_inv ^ (2 * r) := by
      have hβ_a : β_nod (ι_VP a) = loc_nod (π_R (MvPolynomial.C a)) := RingHom.congr_fun hβ_comp a
      have h1 : β_nod (ι_VP a) = β_nod c' * (loc_nod s₀) ^ (2 * r) := by
        rw [ha_eq, map_mul, map_pow, hβ_ϖ]
      calc
        β_nod c' = β_nod c' * 1 ^ (2 * r) := by rw [one_pow, mul_one]
        _ = β_nod c' * (loc_nod s₀ * w_inv) ^ (2 * r) := by rw [hw_mul]
        _ = (β_nod c' * (loc_nod s₀) ^ (2 * r)) * w_inv ^ (2 * r) := by rw [mul_pow, mul_assoc]
        _ = loc_nod (π_R (MvPolynomial.C a)) * w_inv ^ (2 * r) := by rw [← h1, hβ_a]
    let Ψ₀ : MvPolynomial (Fin 2) S →+* Localization.Away s₀ :=
      MvPolynomial.eval₂Hom β_nod (fun i => loc_nod (π_R (MvPolynomial.X i)) * w_inv ^ r)
    have hΨ₀_rel : Ψ₀ (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c') = 0 := by
      simp only [Ψ₀, map_sub, map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C]
      rw [hβ_c, ← hRel_R, map_mul, two_mul, pow_add]
      ring
    obtain ⟨ψ_nod, hψ_comp⟩ := hLift_S Ψ₀ hΨ₀_rel
    have hφψ : φ_nod.comp ψ_nod = RingHom.id A_S := by
      have hPoly : (φ_nod.comp ψ_nod).comp π_S = π_S := by
        apply MvPolynomial.ringHom_ext'
        · have hC : ((φ_nod.comp ψ_nod).comp π_S).comp MvPolynomial.C = φ_nod.comp β_nod := by
            apply RingHom.ext
            intro s
            have hs : ψ_nod (π_S (MvPolynomial.C s)) = Ψ₀ (MvPolynomial.C s) :=
              RingHom.congr_fun hψ_comp (MvPolynomial.C s)
            simpa [Ψ₀] using congrArg φ_nod hs
          rw [hC]
          apply IsLocalization.ringHom_ext (Submonoid.powers ϖ)
          apply RingHom.ext
          intro v
          have hv1 : β_nod (algebraMap R S v) = α_nod v := RingHom.congr_fun hβ_comp v
          have hv2 : φ_nod (α_nod v) = Φ_nod (π_R (MvPolynomial.C v)) :=
            RingHom.congr_fun hφ_comp (π_R (MvPolynomial.C v))
          exact (congrArg φ_nod hv1).trans (hv2.trans (hΦ_C v))
        · intro i
          change φ_nod (ψ_nod (π_S (MvPolynomial.X i))) = π_S (MvPolynomial.X i)
          have hXi : ψ_nod (π_S (MvPolynomial.X i)) =
              loc_nod (π_R (MvPolynomial.X i)) * w_inv ^ r := by
            simpa [Ψ₀] using RingHom.congr_fun hψ_comp (MvPolynomial.X i)
          rw [hXi, map_mul, map_pow]
          have hv2 : φ_nod (loc_nod (π_R (MvPolynomial.X i))) = Φ_nod (π_R (MvPolynomial.X i)) :=
            RingHom.congr_fun hφ_comp (π_R (MvPolynomial.X i))
          rw [hv2, hΦ_X i, ← hΦ_C ϖ]
          calc
            (Φ_nod s₀ ^ r * π_S (MvPolynomial.X i)) * φ_nod w_inv ^ r
              = (Φ_nod s₀ * φ_nod w_inv) ^ r * π_S (MvPolynomial.X i) := by rw [mul_pow]; ring
            _ = π_S (MvPolynomial.X i) := by rw [hφ_inv, one_pow, one_mul]
      apply RingHom.ext
      intro x
      obtain ⟨p, rfl⟩ := hSurj_S x
      exact RingHom.congr_fun hPoly p
    have hψφ : ψ_nod.comp φ_nod = RingHom.id (Localization.Away s₀) := by
      apply IsLocalization.ringHom_ext (Submonoid.powers s₀)
      rw [RingHom.id_comp, RingHom.comp_assoc, hφ_comp]
      have hPoly : (ψ_nod.comp Φ_nod).comp π_R = loc_nod.comp π_R := by
        apply MvPolynomial.ringHom_ext'
        · apply RingHom.ext
          intro v
          change ψ_nod (Φ_nod (π_R (MvPolynomial.C v))) = loc_nod (π_R (MvPolynomial.C v))
          rw [hΦ_C v]
          have h2 : ψ_nod (π_S (MvPolynomial.C (ι_VP v))) = β_nod (ι_VP v) := by
            simpa [Ψ₀] using RingHom.congr_fun hψ_comp (MvPolynomial.C (ι_VP v))
          rw [h2]
          exact RingHom.congr_fun hβ_comp v
        · intro i
          change ψ_nod (Φ_nod (π_R (MvPolynomial.X i))) = loc_nod (π_R (MvPolynomial.X i))
          rw [hΦ_X i, map_mul, map_pow]
          have h2 : ψ_nod (π_S (MvPolynomial.C (ι_VP ϖ))) = loc_nod s₀ := by
            have h2' : ψ_nod (π_S (MvPolynomial.C (ι_VP ϖ))) = β_nod (ι_VP ϖ) := by
              simpa [Ψ₀] using RingHom.congr_fun hψ_comp (MvPolynomial.C (ι_VP ϖ))
            rw [h2', hβ_ϖ]
          have h3 : ψ_nod (π_S (MvPolynomial.X i)) =
              loc_nod (π_R (MvPolynomial.X i)) * w_inv ^ r := by
            simpa [Ψ₀] using RingHom.congr_fun hψ_comp (MvPolynomial.X i)
          rw [h2, h3]
          calc
            loc_nod s₀ ^ r * (loc_nod (π_R (MvPolynomial.X i)) * w_inv ^ r)
              = (loc_nod s₀ * w_inv) ^ r * loc_nod (π_R (MvPolynomial.X i)) := by rw [mul_pow]; ring
            _ = loc_nod (π_R (MvPolynomial.X i)) := by rw [hw_mul, one_pow, one_mul]
      apply RingHom.ext
      intro x
      obtain ⟨p, rfl⟩ := hSurj_R x
      exact RingHom.congr_fun hPoly p
    exact hAwayEtale s₀ Φ_nod φ_nod ψ_nod hφ_comp hφψ hψφ
  have hNodalBridge : ∀ (c' : S), c' ≠ 0 →
      ∃ (a : R)
        (Ψ_nod : AlgebraicGeometry.Spec (CommRingCat.of
            (MvPolynomial (Fin 2) S ⧸ Ideal.span
              {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c'})) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of
            (MvPolynomial (Fin 2) R ⧸ Ideal.span
              {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}))),
        a ≠ 0 ∧
        AlgebraicGeometry.Etale Ψ_nod ∧
        Ψ_nod ≫ AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) =
          AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) ≫ j_VP := by
    intro c' hc'
    obtain ⟨b₀, r, hr⟩ := (hLoc_VP c'.1).mp c'.2
    have hcr : c' * (ι_VP ϖ) ^ r = ι_VP b₀ := by
      apply Subtype.val_injective
      change (V.ofPrime P.asIdeal).subtype (c' * (ι_VP ϖ) ^ r) =
        (V.ofPrime P.asIdeal).subtype (ι_VP b₀)
      rw [map_mul, map_pow]
      exact hr
    let a : R := b₀ * ϖ ^ r
    have ha_eq : ι_VP a = c' * (ι_VP ϖ) ^ (2 * r) := by
      change ι_VP (b₀ * ϖ ^ r) = c' * (ι_VP ϖ) ^ (2 * r)
      rw [map_mul, map_pow, ← hcr, two_mul, pow_add, mul_assoc]
    have ha_ne : a ≠ 0 := by
      intro ha0
      apply hc'
      have h0 : c' * (ι_VP ϖ) ^ (2 * r) = 0 := by
        rw [← ha_eq, ha0, map_zero]
      calc
        c' = c' * 1 ^ (2 * r) := by rw [one_pow, mul_one]
        _ = c' * (ι_VP ϖ * u_inv) ^ (2 * r) := by rw [hϖ_mul_inv]
        _ = (c' * (ι_VP ϖ) ^ (2 * r)) * u_inv ^ (2 * r) := by rw [mul_pow, mul_assoc]
        _ = 0 := by rw [h0, zero_mul]
    let I_a : Ideal (MvPolynomial (Fin 2) R) :=
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}
    let π_R : MvPolynomial (Fin 2) R →+* (MvPolynomial (Fin 2) R ⧸ I_a) :=
      Ideal.Quotient.mk I_a
    let I_c : Ideal (MvPolynomial (Fin 2) S) :=
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c'}
    let π_S : MvPolynomial (Fin 2) S →+* (MvPolynomial (Fin 2) S ⧸ I_c) :=
      Ideal.Quotient.mk I_c
    have hRel_S : π_S (MvPolynomial.X 0) * π_S (MvPolynomial.X 1) = π_S (MvPolynomial.C c') := by
      have h0 : π_S (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c') = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton _))
      rw [map_sub, map_mul] at h0
      exact sub_eq_zero.mp h0
    have hRel_R : π_R (MvPolynomial.X 0) * π_R (MvPolynomial.X 1) = π_R (MvPolynomial.C a) := by
      have h0 : π_R (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton _))
      rw [map_sub, map_mul] at h0
      exact sub_eq_zero.mp h0
    let Φ₀ : MvPolynomial (Fin 2) R →+* (MvPolynomial (Fin 2) S ⧸ I_c) :=
      MvPolynomial.eval₂Hom (π_S.comp (MvPolynomial.C.comp ι_VP))
        (fun i => π_S (MvPolynomial.C (ι_VP ϖ)) ^ r * π_S (MvPolynomial.X i))
    have hΦ₀_ker : ∀ f ∈ I_a, Φ₀ f = 0 := by
      have hle : I_a ≤ RingHom.ker Φ₀ := by
        rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
        simp only [Φ₀, map_sub, map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C,
          RingHom.comp_apply]
        rw [ha_eq, map_mul, map_pow, map_mul, map_pow, two_mul, pow_add]
        calc
          (π_S (MvPolynomial.C (ι_VP ϖ)) ^ r * π_S (MvPolynomial.X 0)) *
              (π_S (MvPolynomial.C (ι_VP ϖ)) ^ r * π_S (MvPolynomial.X 1)) -
              π_S (MvPolynomial.C c') *
                (π_S (MvPolynomial.C (ι_VP ϖ)) ^ r * π_S (MvPolynomial.C (ι_VP ϖ)) ^ r)
            = (π_S (MvPolynomial.X 0) * π_S (MvPolynomial.X 1) - π_S (MvPolynomial.C c')) *
                (π_S (MvPolynomial.C (ι_VP ϖ)) ^ r * π_S (MvPolynomial.C (ι_VP ϖ)) ^ r) := by ring
          _ = 0 := by rw [hRel_S, sub_self, zero_mul]
      exact fun f hf => hle hf
    let Φ_nod : (MvPolynomial (Fin 2) R ⧸ I_a) →+* (MvPolynomial (Fin 2) S ⧸ I_c) :=
      Ideal.Quotient.lift I_a Φ₀ hΦ₀_ker
    let Ψ_nod : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 2) S ⧸ I_c)) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 2) R ⧸ I_a)) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Φ_nod)
    refine ⟨a, Ψ_nod, ha_ne, ?_, ?_⟩
    · refine hNodalLocStep
        (A_R := MvPolynomial (Fin 2) R ⧸ I_a)
        (A_S := MvPolynomial (Fin 2) S ⧸ I_c)
        π_R π_S Φ_nod r a c' Ideal.Quotient.mk_surjective
        Ideal.Quotient.mk_surjective (fun Ψ₀ hrel => ?_) hRel_R
        (fun v => by change Φ₀ (MvPolynomial.C v) = _; simp [Φ₀])
        (fun i => by change Φ₀ (MvPolynomial.X i) = _; simp [Φ₀]) ha_eq
      have hker : ∀ f ∈ I_c, Ψ₀ f = 0 := by
        have hle : I_c ≤ RingHom.ker Ψ₀ := by
          rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
          exact hrel
        exact fun f hf => hle hf
      refine ⟨Ideal.Quotient.lift I_c Ψ₀ hker, ?_⟩
      apply RingHom.ext
      intro p
      rfl
    · dsimp [Ψ_nod, j_VP]
      rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
      congr 2
      apply RingHom.ext
      intro v
      change Φ₀ (MvPolynomial.C v) = π_S (MvPolynomial.C (ι_VP v))
      simp [Φ₀]
  obtain ⟨hInt_cur, hFlat_cur, _, hLfp_cur, hCharts_cur⟩ := hSS_cur
  obtain ⟨hInt_X0, hFlat_X0, _, hLfp_X0, hCharts_X0⟩ := hSS_X'0
  have _ : AlgebraicGeometry.IsIntegral C_cur := hInt_cur
  have _ : AlgebraicGeometry.IsIntegral X'_0 := hInt_X0
  have _ : AlgebraicGeometry.IsOpenImmersion ι_U2 := hOpen_U2
  have _ : AlgebraicGeometry.IsOpenImmersion ι_1 := hOpen_1
  have _ : AlgebraicGeometry.IsOpenImmersion ι_2 := hOpen_2
  have _ : AlgebraicGeometry.IsOpenImmersion j_VP := hOpen_VP
  have _ : AlgebraicGeometry.Flat g_cur := hFlat_cur
  have _ : AlgebraicGeometry.LocallyOfFinitePresentation g_cur := hLfp_cur
  have _ : AlgebraicGeometry.Flat g'_0 := hFlat_X0
  have _ : AlgebraicGeometry.LocallyOfFinitePresentation g'_0 := hLfp_X0
  let covObj : ULift.{u} Bool → AlgebraicGeometry.Scheme.{u} :=
    fun j => Bool.rec (motive := fun _ => AlgebraicGeometry.Scheme.{u}) X'_0 U_2 j.down
  let covMap : ∀ j : ULift.{u} Bool, covObj j ⟶ C_next :=
    fun j => Bool.rec
      (motive := fun b => Bool.rec (motive := fun _ => AlgebraicGeometry.Scheme.{u}) X'_0 U_2 b ⟶ C_next)
      ι_1 ι_2 j.down
  have hCovSurj : ∀ y : ↥C_next, ∃ (j : ULift.{u} Bool) (z : ↥(covObj j)), (covMap j) z = y := by
    intro y
    have hy : y ∈ Set.range ι_1.base ∪ Set.range ι_2.base := by
      rw [hCov]; trivial
    rcases hy with ⟨x', hx'⟩ | ⟨u, hu⟩
    · exact ⟨⟨false⟩, x', hx'⟩
    · exact ⟨⟨true⟩, u, hu⟩
  have hCovOpen : ∀ j : ULift.{u} Bool, AlgebraicGeometry.IsOpenImmersion (covMap j) := by
    rintro ⟨_ | _⟩
    · exact hOpen_1
    · exact hOpen_2
  let 𝒰 : C_next.OpenCover :=
    AlgebraicGeometry.Scheme.Cover.mkOfCovers (P := @AlgebraicGeometry.IsOpenImmersion)
      (ULift.{u} Bool) covObj covMap hCovSurj hCovOpen
  have _ : AlgebraicGeometry.IsReduced U_2 :=
    AlgebraicGeometry.isReduced_of_isOpenImmersion ι_U2
  have _ : ∀ i : 𝒰.I₀, AlgebraicGeometry.IsReduced (𝒰.X i) := by
    rintro ⟨_ | _⟩
    · change AlgebraicGeometry.IsReduced X'_0
      infer_instance
    · change AlgebraicGeometry.IsReduced U_2
      infer_instance
  have hRed_next : AlgebraicGeometry.IsReduced C_next :=
    AlgebraicGeometry.IsReduced.of_openCover C_next 𝒰
  have hInt_next : AlgebraicGeometry.IsIntegral C_next :=
    (AlgebraicGeometry.isIntegral_iff_irreducibleSpace_and_isReduced C_next).mpr
      ⟨hIrred, hRed_next⟩
  have _ := AlgebraicGeometry.HasRingHomProperty.instIsZariskiLocalAtSource
    (P := @AlgebraicGeometry.Flat.{u})
  have _ := AlgebraicGeometry.HasRingHomProperty.instIsZariskiLocalAtSource
    (P := @AlgebraicGeometry.LocallyOfFinitePresentation.{u})
  have hFlat_next : AlgebraicGeometry.Flat g_next := by
    refine AlgebraicGeometry.IsZariskiLocalAtSource.of_openCover 𝒰 (fun i => ?_)
    rcases i with ⟨_ | _⟩
    · change AlgebraicGeometry.Flat (ι_1 ≫ g_next)
      rw [hComm_1]
      exact inferInstance
    · change AlgebraicGeometry.Flat (ι_2 ≫ g_next)
      rw [hComm_2]
      exact inferInstance
  have hLfp_next : AlgebraicGeometry.LocallyOfFinitePresentation g_next := by
    refine AlgebraicGeometry.IsZariskiLocalAtSource.of_openCover 𝒰 (fun i => ?_)
    rcases i with ⟨_ | _⟩
    · change AlgebraicGeometry.LocallyOfFinitePresentation (ι_1 ≫ g_next)
      rw [hComm_1]
      exact inferInstance
    · change AlgebraicGeometry.LocallyOfFinitePresentation (ι_2 ≫ g_next)
      rw [hComm_2]
      exact inferInstance
  have hPush : ∀ {Y M : AlgebraicGeometry.Scheme.{u}}
      (ι : Y ⟶ C_next) [AlgebraicGeometry.IsOpenImmersion ι]
      (g_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
      (p_M : M ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
      (z : ↥Y) (W_Y : Y.Opens) (e_Y : W_Y.toScheme ⟶ M),
      ι ≫ g_next = g_Y →
      z ∈ W_Y →
      AlgebraicGeometry.Etale e_Y →
      W_Y.ι ≫ g_Y = e_Y ≫ p_M →
      ∃ (W_next : C_next.Opens) (e_next : W_next.toScheme ⟶ M),
        ι.base z ∈ W_next ∧
        AlgebraicGeometry.Etale e_next ∧
        W_next.ι ≫ g_next = e_next ≫ p_M := by
    intro Y M ι _ g_Y p_M z W_Y e_Y hι_comm hz hEt_eY heY_comm
    have _ : AlgebraicGeometry.Etale e_Y := hEt_eY
    let W_next : C_next.Opens := ι.opensFunctor.obj W_Y
    have hz_next : ι.base z ∈ W_next := ⟨z, hz, rfl⟩
    have hRange : Set.range ⇑(W_Y.ι ≫ ι) = Set.range ⇑W_next.ι := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      refine Set.Subset.antisymm ?_ ?_
      · rintro _ ⟨w, rfl⟩
        exact ⟨W_Y.ι.base w, w.2, rfl⟩
      · rintro _ ⟨w, hw, rfl⟩
        exact ⟨⟨w, hw⟩, rfl⟩
    let α : W_Y.toScheme ≅ W_next.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq (W_Y.ι ≫ ι) W_next.ι hRange
    refine ⟨W_next, α.inv ≫ e_Y, hz_next, inferInstance, ?_⟩
    calc
      W_next.ι ≫ g_next = (α.inv ≫ (W_Y.ι ≫ ι)) ≫ g_next := by
        rw [AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_inv_fac]
      _ = α.inv ≫ W_Y.ι ≫ (ι ≫ g_next) := by simp only [Category.assoc]
      _ = α.inv ≫ (W_Y.ι ≫ g_Y) := by rw [hι_comm]
      _ = (α.inv ≫ e_Y) ≫ p_M := by rw [heY_comm, Category.assoc]
  have hPullU2 : ∀ {M : AlgebraicGeometry.Scheme.{u}}
      (p_M : M ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
      (u : ↥U_2) (W_cur : C_cur.Opens) (e_cur : W_cur.toScheme ⟶ M),
      ι_U2.base u ∈ W_cur →
      AlgebraicGeometry.Etale e_cur →
      W_cur.ι ≫ g_cur = e_cur ≫ p_M →
      ∃ (W_next : C_next.Opens) (e_next : W_next.toScheme ⟶ M),
        ι_2.base u ∈ W_next ∧
        AlgebraicGeometry.Etale e_next ∧
        W_next.ι ≫ g_next = e_next ≫ p_M := by
    intro M p_M u W_cur e_cur hu hEt_cur he_comm
    have _ : AlgebraicGeometry.Etale e_cur := hEt_cur
    let W_U2 : U_2.Opens := (TopologicalSpace.Opens.map ι_U2.base).obj W_cur
    have hSub : Set.range ⇑(W_U2.ι ≫ ι_U2) ⊆ Set.range ⇑W_cur.ι := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rintro _ ⟨w, rfl⟩
      exact w.2
    let j_cur : W_U2.toScheme ⟶ W_cur.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift W_cur.ι (W_U2.ι ≫ ι_U2) hSub
    have hj_fac : j_cur ≫ W_cur.ι = W_U2.ι ≫ ι_U2 :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac W_cur.ι (W_U2.ι ≫ ι_U2) hSub
    have _ : AlgebraicGeometry.IsOpenImmersion (j_cur ≫ W_cur.ι) := by
      rw [hj_fac]; infer_instance
    have _ : AlgebraicGeometry.IsOpenImmersion j_cur :=
      AlgebraicGeometry.IsOpenImmersion.of_comp j_cur W_cur.ι
    refine hPush ι_2 (ι_U2 ≫ g_cur) p_M u W_U2 (j_cur ≫ e_cur) hComm_2 hu inferInstance ?_
    calc
      W_U2.ι ≫ (ι_U2 ≫ g_cur) = (W_U2.ι ≫ ι_U2) ≫ g_cur := (Category.assoc _ _ _).symm
      _ = (j_cur ≫ W_cur.ι) ≫ g_cur := by rw [← hj_fac]
      _ = j_cur ≫ (W_cur.ι ≫ g_cur) := Category.assoc _ _ _
      _ = (j_cur ≫ e_cur) ≫ p_M := by rw [he_comm, Category.assoc]
  refine ⟨hInt_next, hFlat_next, hSep, hLfp_next, fun y => ?_⟩
  have hy : y ∈ Set.range ι_1.base ∪ Set.range ι_2.base := by
    rw [hCov]; trivial
  rcases hy with ⟨x', rfl⟩ | ⟨u, rfl⟩
  · rcases hCharts_X0 x' with ⟨W'_0, e', hx', hEt_e', hComm_e'⟩ | ⟨W'_0, c', e', hx', hc', hEt_e', hComm_e'⟩
    · have _ : AlgebraicGeometry.Etale e' := hEt_e'
      have _ : AlgebraicGeometry.Etale Ψ_sm := hEt_sm
      refine Or.inl (hPush ι_1 (g'_0 ≫ j_VP)
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C))
        x' W'_0 (e' ≫ Ψ_sm) hComm_1 hx' inferInstance ?_)
      calc
        W'_0.ι ≫ (g'_0 ≫ j_VP) = (W'_0.ι ≫ g'_0) ≫ j_VP := (Category.assoc _ _ _).symm
        _ = e' ≫ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) ≫ j_VP) := by
          rw [hComm_e', Category.assoc]
        _ = (e' ≫ Ψ_sm) ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) := by
          rw [← hComm_sm, Category.assoc]
    · obtain ⟨a, Ψ_nod, ha_ne, hEt_nod, hComm_nod⟩ := hNodalBridge c' hc'
      have _ : AlgebraicGeometry.Etale e' := hEt_e'
      have _ : AlgebraicGeometry.Etale Ψ_nod := hEt_nod
      obtain ⟨W_next, e_next, hx_next, hEt_next, hComm_next⟩ :=
        hPush ι_1 (g'_0 ≫ j_VP)
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)))
          x' W'_0 (e' ≫ Ψ_nod) hComm_1 hx' inferInstance (by
            calc
              W'_0.ι ≫ (g'_0 ≫ j_VP) = (W'_0.ι ≫ g'_0) ≫ j_VP := (Category.assoc _ _ _).symm
              _ = e' ≫ (AlgebraicGeometry.Spec.map
                  (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) ≫ j_VP) := by
                rw [hComm_e', Category.assoc]
              _ = (e' ≫ Ψ_nod) ≫ AlgebraicGeometry.Spec.map
                  (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) := by
                rw [← hComm_nod, Category.assoc])
      exact Or.inr ⟨W_next, a, e_next, hx_next, ha_ne, hEt_next, hComm_next⟩
  · rcases hCharts_cur (ι_U2.base u) with ⟨W_cur, e_cur, hu_W, hEt_cur, hComm_cur⟩ | ⟨W_cur, a, e_cur, hu_W, ha_ne, hEt_cur, hComm_cur⟩
    · exact Or.inl (hPullU2 _ u W_cur e_cur hu_W hEt_cur hComm_cur)
    · obtain ⟨W_next, e_next, hu_next, hEt_next, hComm_next⟩ :=
        hPullU2 _ u W_cur e_cur hu_W hEt_cur hComm_cur
      exact Or.inr ⟨W_next, a, e_next, hu_next, ha_ne, hEt_next, hComm_next⟩

theorem weil_local_contraction_gluing_and_pointed_transfer (K : Type u) [Field K] [IsSepClosed K]
    (m : ℕ) (V : ValuationSubring K) (hPkg : IsValuationRingAlgPackage m V)
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (n : ℕ) (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (hIntCK : AlgebraicGeometry.IsIntegral C_K)
    (hPropCK : AlgebraicGeometry.IsProper p_K)
    (hSmCK : AlgebraicGeometry.SmoothOfRelativeDimension 1 p_K)
    (hStabCK : IsGeometricStablePointedCurve p_K n σ_K)
    (C' : AlgebraicGeometry.Scheme.{u})
    (g' : C' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (τ' : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C'))
    (ι' : C_K ⟶ C')
    (hMod' : IsValuationPointedCurveModel V p_K n σ_K C' g' τ' ι')
    (U' : C'.Opens) (hU' : Nonempty ↥U')
    (U_ss : AlgebraicGeometry.Scheme.{u})
    (g_ss : U_ss ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (hAff_ss : AlgebraicGeometry.IsAffine U_ss)
    (hSS : IsStrictlySemistableCurveOverValuation V g_ss)
    (h_mod : U'.toScheme ⟶ U_ss)
    (hProp_mod : AlgebraicGeometry.IsProper h_mod)
    (hComm_mod : h_mod ≫ g_ss = U'.ι ≫ g')
    (ι_U' : AlgebraicGeometry.Scheme.Opens.toScheme
      ((TopologicalSpace.Opens.map ι'.base).obj U') ⟶ U'.toScheme)
    (hι_comm : ι_U' ≫ U'.ι =
      AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj U') ≫ ι')
    (hPb_U' : CategoryTheory.IsPullback ι_U'
      (AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj U') ≫ p_K)
      (U'.ι ≫ g')
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (hPb_ss : CategoryTheory.IsPullback (ι_U' ≫ h_mod)
      (AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj U') ≫ p_K)
      g_ss
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (C_cur : AlgebraicGeometry.Scheme.{u})
    (g_cur : C_cur ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (f_dom_cur : C_cur ⟶ U'.toScheme)
    (τ_cur : ∀ j : Fin n,
      AlgebraicGeometry.Scheme.Opens.toScheme
        ((TopologicalSpace.Opens.map (τ' j).base).obj U') ⟶ C_cur)
    (ι_cur : AlgebraicGeometry.Scheme.Opens.toScheme
      ((TopologicalSpace.Opens.map ι'.base).obj U') ⟶ C_cur)
    (hRes_cur : IsResolvedLocalStrictlySemistableMod V p_K g' n τ' ι' U' h_mod ι_U'
      C_cur g_cur f_dom_cur τ_cur ι_cur)
    (hFinFib : ∀ Q : PrimeSpectrum ↥V,
      (irreducibleComponents ↥(CategoryTheory.Limits.pullback g_cur
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap ↥V Q.asIdeal.ResidueField))))).Finite)
    (P : PrimeSpectrum ↥V)
    (x₀ : ↥U'.toScheme)
    (Z : Set ↥(CategoryTheory.Limits.pullback g_cur
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap ↥V P.asIdeal.ResidueField)))))
    (hDatum : IsClosedPointRelExceptionalDatum V g' n τ' U' g_cur f_dom_cur τ_cur P x₀ Z)
    (ϖ : ↥V) (W_B : U_ss.Opens) (hu₀ : h_mod.base x₀ ∈ W_B)
    (g_WB : W_B.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥(V.ofPrime P.asIdeal)))
    (Z_mod : Set ↥W_B.toScheme) (hZ_closed : IsClosed Z_mod)
    (hChart : IsIsolatedStrictlySemistableModChart V g_ss (f_dom_cur ≫ h_mod) P (h_mod.base x₀)
      ϖ W_B hu₀ g_WB Z_mod hZ_closed)
    (hNormDom : ∀ (C_next : AlgebraicGeometry.Scheme.{u})
        (g_next : C_next ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
        (f_ss_next : C_next ⟶ U_ss)
        (q_contr : C_cur ⟶ C_next)
        (M_contr : Set ↥C_next)
        (hM_cl : IsClosed M_contr),
      IsStrictlySemistableCurveOverValuation V g_next →
      AlgebraicGeometry.IsProper q_contr →
      AlgebraicGeometry.Surjective q_contr →
      q_contr ≫ g_next = g_cur →
      q_contr ≫ f_ss_next = f_dom_cur ≫ h_mod →
      CategoryTheory.IsIso (q_contr ∣_ (⟨M_contrᶜ, hM_cl.isOpen_compl⟩ : C_next.Opens)) →
      (∀ Q : PrimeSpectrum ↥V,
        (f_dom_cur.base '' (q_contr.base ⁻¹' M_contr ∩ g_cur.base ⁻¹' {Q})).Subsingleton) →
      ∃ f_dom_next : C_next ⟶ U'.toScheme,
        q_contr ≫ f_dom_next = f_dom_cur ∧
        AlgebraicGeometry.IsProper f_dom_next)
    (X'_0 : AlgebraicGeometry.Scheme.{u})
    (g'_0 : X'_0 ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥(V.ofPrime P.asIdeal)))
    (f'_0 : X'_0 ⟶ W_B.toScheme)
    (q_0 : AlgebraicGeometry.Scheme.Opens.toScheme
      ((TopologicalSpace.Opens.map (f_dom_cur ≫ h_mod).base).obj W_B) ⟶ X'_0)
    (Mod_q0 : Set ↥X'_0)
    (hMod_closed : IsClosed Mod_q0)
    (z_new : ↥X'_0)
    (hContr : IsSingleComponentChartContraction V P g_WB ((f_dom_cur ≫ h_mod) ∣_ W_B) Z_mod
      ((AlgebraicGeometry.Scheme.Opens.ι (X := C_cur)
        ((TopologicalSpace.Opens.map (f_dom_cur ≫ h_mod).base).obj W_B)).base ⁻¹'
        ((CategoryTheory.Limits.pullback.fst g_cur
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap ↥V P.asIdeal.ResidueField)))).base '' Z))
      ({q ∈ Z | ∃ E' ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_cur
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap ↥V P.asIdeal.ResidueField)))), E' ≠ Z ∧ q ∈ E'}.ncard = 1)
      X'_0 g'_0 f'_0 q_0 Mod_q0 hMod_closed z_new) :
    ∃ (C_next : AlgebraicGeometry.Scheme.{u})
      (g_next : C_next ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
      (f_dom_next : C_next ⟶ U'.toScheme)
      (τ_next : ∀ j : Fin n,
        AlgebraicGeometry.Scheme.Opens.toScheme
          ((TopologicalSpace.Opens.map (τ' j).base).obj U') ⟶ C_next)
      (ι_next : AlgebraicGeometry.Scheme.Opens.toScheme
        ((TopologicalSpace.Opens.map ι'.base).obj U') ⟶ C_next),
      IsResolvedLocalStrictlySemistableMod V p_K g' n τ' ι' U' h_mod ι_U'
        C_next g_next f_dom_next τ_next ι_next ∧
      (∑ Q ∈ hPkg.1.toFinset,
        Nat.card ↥(irreducibleComponents ↥(CategoryTheory.Limits.pullback g_next
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap ↥V Q.asIdeal.ResidueField)))))) <
      (∑ Q ∈ hPkg.1.toFinset,
        Nat.card ↥(irreducibleComponents ↥(CategoryTheory.Limits.pullback g_cur
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap ↥V Q.asIdeal.ResidueField)))))) :=
by
  classical
  obtain ⟨_, _, hProp_g', _, _, _, hτ'_sec, _, _⟩ := hMod'
  obtain ⟨hSS_cur, hProp_fdom, hfdom_g, ⟨f_ss_0, hf_ss_0, hProp_fss_0⟩,
    hι_fdom, hPb_cur, hτ_fdom, hDisj_cur, hSm_cur⟩ := hRes_cur
  obtain ⟨hP_ne, hx₀_cl, hx₀_P, hZ_irred, _hZ_P1, hZ_x₀, hΔ_lo, hΔ_hi, hΔ_two, hΔ_one⟩ := hDatum
  have ⟨hϖ_P, _hϖ_iff, hLoc_VP, hOpen_VP, _hAff_WB, hComm_WB,
    _hZmod_fin, hZmod_ne, _hIso_f0, _hu₀_cl, _hChart_et⟩ := hChart
  have hProp_fss_cur : AlgebraicGeometry.IsProper (f_dom_cur ≫ h_mod) := by
    rw [hf_ss_0]; exact hProp_fss_0
  obtain ⟨hF_cl, hK_cl, hF_sub⟩ :=
    weil_chart_contraction_global_closedness_and_fiber_subsingleton
      K m V hPkg C' g' U' U_ss g_ss hAff_ss hSS h_mod hProp_mod hComm_mod
      C_cur g_cur f_dom_cur hSS_cur hProp_fdom hfdom_g
      P hP_ne x₀ hx₀_cl hx₀_P Z hZ_irred.1.1 hZ_x₀
      ϖ W_B hu₀ g_WB Z_mod hZ_closed hChart _
      X'_0 g'_0 f'_0 q_0 Mod_q0 hMod_closed z_new hContr
  obtain ⟨hSS_X'0, hq0_f'0, hf'0_gWB, hProp_q0, hProp_f'0, hSurj_q0, hMod_sub_Zmod,
