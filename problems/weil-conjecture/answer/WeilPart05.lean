          ⟨fun h => by
             have hd := (PrimeSpectrum.comap ρ_σ q).asIdeal.sub_mem h hsub_q
             rwa [sub_sub_cancel] at hd,
           fun h => by
             have hs := (PrimeSpectrum.comap ρ_σ q).asIdeal.add_mem hsub_q h
             rwa [sub_add_cancel] at hs⟩
