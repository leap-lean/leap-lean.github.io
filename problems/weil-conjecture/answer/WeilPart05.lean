  let z_new_M : ↥M' := σ_Mod.base q_max
  let z₀_M : ↥M' := σ_Mod.base q_gen
  
  have hRestrictFactor : ∀ {X Y U : AlgebraicGeometry.Scheme.{u}}
      (f : X ⟶ Y) (W : Y.Opens) (iU : U ⟶ X) [AlgebraicGeometry.IsOpenImmersion iU]
      (g : U ⟶ W.toScheme),
      iU ≫ f = g ≫ W.ι →
      f.base ⁻¹' (W : Set ↥Y) = Set.range iU.base →
      ∃ e : (f ⁻¹ᵁ W).toScheme ≅ U, (f ∣_ W) = e.hom ≫ g := by
    intro X Y U f W iU _ g hcomm hpre
    have hp : CategoryTheory.IsPullback g iU W.ι f :=
      AlgebraicGeometry.IsOpenImmersion.isPullback g iU W.ι f hcomm (by
        ext x
        change x ∈ f.base ⁻¹' Set.range W.ι.base ↔ x ∈ Set.range iU.base
        rw [AlgebraicGeometry.Scheme.Opens.range_ι, hpre])
    let epb : U ≅ CategoryTheory.Limits.pullback f W.ι := hp.flip.isoPullback
    let erest := AlgebraicGeometry.pullbackRestrictIsoRestrict f W
