            algebraMap (weilNodalQuot ↥R c') (Localization.Away (h * g)) q) ∧
        AlgebraicGeometry.IsOpenImmersion ι_tilde ∧
        u_lift ≫ j_2 = ι_tilde ∧
        u_lift ≫ AlgebraicGeometry.Scheme.Opens.ι (⟨Zᶜ, hZ_cl.isOpen_compl⟩ : M'.Opens) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom lam) ≫ ι_U ∧
        ι_tilde ≫ (q_M ≫ g'_M) = AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk (weilNodalIdeal ↥R c')).comp MvPolynomial.C) ≫
            CommRingCat.ofHom (algebraMap (weilNodalQuot ↥R c') (Localization.Away (h * g)))) ∧
        (∀ q : weilNodalQuot ↥R c',
          φ_tilde (algebraMap (weilNodalQuot ↥R c') (Localization.Away (h * g)) q) =
            φ_U (algebraMap (weilNodalQuot ↥R c') (Localization.Away h) q)) ∧
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_tilde) ≫ ι_tilde = η_tilde) ∧
    (∀ (M' : AlgebraicGeometry.Scheme.{u})
       (g'_M : M' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
       (η'_M : AlgebraicGeometry.Spec (CommRingCat.of F_0) ⟶ M')
       (c_d π_d c_1 c_2 : ↥R)
       (h_1 h_2 : Polynomial ↥R)
       (ι_1 : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away h_1)) ⟶ M')
       (ι_2 : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away h_2)) ⟶ M')
       (φ_1 : Localization.Away h_1 →+* F_0)
       (φ_2 : Localization.Away h_2 →+* F_0)
       (p_1 : PrimeSpectrum (Localization.Away h_1))
       (p_2 : PrimeSpectrum (Localization.Away h_2)),
      η'_M ≫ g'_M = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_KF0.comp R.subtype)) →
      π_d ≠ 0 →
      c_1 - c_2 ∉ IsLocalRing.maximalIdeal ↥R →
      AlgebraicGeometry.IsOpenImmersion ι_1 →
      ι_1 ≫ g'_M = AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        ((algebraMap (Polynomial ↥R) (Localization.Away h_1)).comp Polynomial.C)) →
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_1) ≫ ι_1 = η'_M →
      φ_KF0 (R.subtype π_d) *
          φ_1 (algebraMap (Polynomial ↥R) (Localization.Away h_1) Polynomial.X) =
        T_0 - φ_KF0 (R.subtype c_d) →
      AlgebraicGeometry.IsOpenImmersion ι_2 →
      ι_2 ≫ g'_M = AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        ((algebraMap (Polynomial ↥R) (Localization.Away h_2)).comp Polynomial.C)) →
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_2) ≫ ι_2 = η'_M →
      φ_KF0 (R.subtype π_d) *
          φ_2 (algebraMap (Polynomial ↥R) (Localization.Away h_2) Polynomial.X) =
        T_0 - φ_KF0 (R.subtype c_d) →
      (g'_M.base (ι_1.base p_1)).asIdeal = IsLocalRing.maximalIdeal ↥R →
      (g'_M.base (ι_2.base p_2)).asIdeal = IsLocalRing.maximalIdeal ↥R →
      algebraMap (Polynomial ↥R) (Localization.Away h_1)
        (Polynomial.X - Polynomial.C c_1) ∈ p_1.asIdeal →
      algebraMap (Polynomial ↥R) (Localization.Away h_2)
        (Polynomial.X - Polynomial.C c_2) ∈ p_2.asIdeal →
      ι_1.base p_1 ≠ ι_2.base p_2) ∧
    (∀ (M' : AlgebraicGeometry.Scheme.{u})
       (g'_M : M' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
       (f'_M : M' ⟶ M_0)
       (η'_M : AlgebraicGeometry.Spec (CommRingCat.of F_0) ⟶ M'),
      f'_M ≫ g_M0 = g'_M →
      η'_M ≫ f'_M = η_M0 →
      (a_opt = none →
        ∀ (c_tilde_Z : ↥R) (h_p : Polynomial ↥R)
