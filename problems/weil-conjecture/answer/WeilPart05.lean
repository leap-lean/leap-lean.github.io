      calc G_1 T_inv = 1 * G_1 T_inv := (one_mul _).symm
        _ = (w_1 * j_1 g_1) * G_1 T_inv := by rw [hw1_j1]
        _ = w_1 * (j_1 g_1 * G_1 T_inv) := mul_assoc _ _ _
        _ = w_1 := by rw [hmul, mul_one]
    have hFG1 : F_1.comp G_1 = RingHom.id (Localization.Away h_01) := by
      apply polyAway_ringHom_ext
      · intro r
        change F_1 (G_1 (α_01 (Polynomial.C r))) = α_01 (Polynomial.C r)
        rw [hG1_C]
        change F_1 (j_1 (α_1 (Ideal.Quotient.mk _ (MvPolynomial.C r)))) = _
        rw [hF1_eq, hf10_C]
      · change F_1 (G_1 T) = T
        rw [hG1_T, hF1_eq, hf10_g1]
    have hGF1 : G_1.comp F_1 = RingHom.id (Localization.Away g_1) := by
      apply IsLocalization.ringHom_ext (Submonoid.powers g_1)
      have hcomp : G_1.comp f₁₀ = j_1 := by
        apply nodalAway_ringHom_ext
        · intro r
          change G_1 (f₁₀ (α_1 (Ideal.Quotient.mk _ (MvPolynomial.C r)))) =
            j_1 (α_1 (Ideal.Quotient.mk _ (MvPolynomial.C r)))
          rw [hf10_C, hG1_C]
          rfl
        · change G_1 (f₁₀ g_1) = j_1 g_1
          rw [hf10_g1, hG1_T]
        · change G_1 (f₁₀ v_1) = j_1 v_1
