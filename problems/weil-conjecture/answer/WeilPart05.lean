      intro b; fin_cases b
      · exact Or.inr hw₀_hasse
      · exact Or.inl hvw₁_hasse
      · exact Or.inl hvw₂_hasse
    have hx_arr : ∀ b : Fin 3, x_of (v_arr b) (hv_arr_not b) = x_star := by
      intro b; fin_cases b
      · rfl
      · exact hx_v1
      · exact hx_v2
    let p_arr : Fin 3 → ↥Y_Xhat := fun b => p_nb (v_arr b) (w_arr b)
    let B_arr : Fin 3 → Set ↥Y_Xhat := fun b => H_nb (v_arr b) (w_arr b)
    have hp_inj : Function.Injective p_arr := by
      intro b₁ b₂ hp_eq
      rcases hPnb_inj (v_arr b₁) (w_arr b₁) (v_arr b₂) (w_arr b₂)
        (hv_arr_nb b₁) (hv_arr_nb b₂) (hEdge_arr b₁) (hEdge_arr b₂) hp_eq with
        ⟨_, hw_eq⟩ | ⟨hvw_eq, _⟩
      · fin_cases b₁ <;> fin_cases b₂
        · rfl
        · exact absurd hw_eq hw₀_ne_w₁
        · exact absurd hw_eq hw₀_ne_w₂
        · exact absurd hw_eq.symm hw₀_ne_w₁
        · rfl
        · exact absurd hw_eq hw₁_ne_w₂
        · exact absurd hw_eq.symm hw₀_ne_w₂
        · exact absurd hw_eq.symm hw₁_ne_w₂
        · rfl
      · exfalso
        exact hv_arr_not b₁ (hvw_eq ▸ hw_arr_D0 b₂)
    have hx_star_u0 : f_0.base ((CategoryTheory.Limits.pullback.fst g_X0 s_R).base x_star) = u₀_WB := by
      obtain ⟨_, _, hp0_in, _, _, _, _⟩ := hHnb_props k_root w₀ (hv_arr_nb 0) (Or.inr hw₀_hasse)
      have hx0_img : α_hat_R.base (p_nb k_root w₀) = x_star := by
        have hmem : α_hat_R.base (p_nb k_root w₀) ∈ ({x_star} : Set ↥Y_X0) := by
          rw [← hx_of_eq k_root hk_root_not]
