    rw [IsLocalRing.mem_maximalIdeal]
    intro hunit_U
    have hunit_W : IsUnit (⟨δ, hδ_W⟩ : ↥(W b₀)) := hunit_U.map (Subring.inclusion hUW_b₀)
    exact (IsLocalRing.mem_maximalIdeal _).mp hδ_mW hunit_W
  have hUnitInv_of_not_M : ∀ (b₀ : Fin 3) {t : A_Y}, t ∉ M_star →
      (φ_AY t)⁻¹ ∈ U b₀ ∧ IsUnit (⟨φ_AY t, hU_mem b₀ t⟩ : ↥(U b₀)) := by
    intro b₀ t ht_not
    have ht_ne : t ≠ 0 := fun h0 => ht_not (h0 ▸ Ideal.zero_mem M_star)
    have hφt_ne : φ_AY t ≠ 0 := hφAY_ne ht_ne
    have ht_unit : IsUnit (⟨φ_AY t, hU_mem b₀ t⟩ : ↥(U b₀)) :=
      IsLocalRing.notMem_maximalIdeal.mp (by rwa [hU_max b₀ t])
    obtain ⟨ut_inv, hut_inv⟩ := ht_unit.exists_right_inv
    have hut_val : ut_inv.1 = (φ_AY t)⁻¹ := by
      apply mul_left_cancel₀ hφt_ne
      rw [mul_inv_cancel₀ hφt_ne]
      exact congrArg Subtype.val hut_inv
    exact ⟨hut_val ▸ ut_inv.2, ht_unit⟩
  have hU_le_symm : ∀ (b b' : Fin 3), P b = 𝔓 → P b' = 𝔓 → U b ≤ U b' := by
    intro b b' hb hb' z hz_Ub
    have hz_Wb : z ∈ W b := (hProps b).2.2.1 hz_Ub
    obtain ⟨a, s, hs_not_P, hz_eq⟩ := hStalkSurj b hb z hz_Wb
    have hs_ne : s ≠ 0 := fun h0 => hs_not_P (h0 ▸ Ideal.zero_mem 𝔓)
    have hφs_ne : φ_AY s ≠ 0 := hφAY_ne hs_ne
    have hz_div : z = φ_AY a * (φ_AY s)⁻¹ := by
      apply mul_right_cancel₀ hφs_ne
      rw [inv_mul_cancel_right₀ hφs_ne]
      exact hz_eq
    by_cases ha_P : a ∈ 𝔓
    · rw [hz_div]
      exact (hMem_mU_of_P b' hb' ha_P hs_not_P).1
    · have ha_ne : a ≠ 0 := fun h0 => ha_P (h0 ▸ Ideal.zero_mem 𝔓)
      have hφa_ne : φ_AY a ≠ 0 := hφAY_ne ha_ne
      have hz_ne : z ≠ 0 := fun h0 => by rw [h0, zero_mul] at hz_eq; exact hφa_ne hz_eq.symm
      rcases hFactII a s ha_P hs_not_P with ⟨c, t, ht_not_M, hdiff_P⟩ | ⟨c, t, ht_not_M, hdiff_P⟩
      · have ht_not_P : t ∉ 𝔓 := fun ht => ht_not_M (hP_le b₁ ht)
        have hst_not_P : s * t ∉ 𝔓 := fun hst =>
          (h𝔓_prime.mem_or_mem hst).elim hs_not_P ht_not_P
        have hφt_ne : φ_AY t ≠ 0 := hφAY_ne (fun h0 => ht_not_M (h0 ▸ Ideal.zero_mem M_star))
        have hz_decomp : z = φ_AY c * (φ_AY t)⁻¹ +
            φ_AY (a * t - s * c) * (φ_AY (s * t))⁻¹ := by
          apply mul_right_cancel₀ (mul_ne_zero hφs_ne hφt_ne)
          rw [add_mul, map_sub, map_mul, map_mul, map_mul]
          have h1 : φ_AY c * (φ_AY t)⁻¹ * (φ_AY s * φ_AY t) = φ_AY c * φ_AY s := by
            calc φ_AY c * (φ_AY t)⁻¹ * (φ_AY s * φ_AY t)
                = φ_AY c * φ_AY s * ((φ_AY t)⁻¹ * φ_AY t) := by ring
              _ = φ_AY c * φ_AY s := by rw [inv_mul_cancel₀ hφt_ne, mul_one]
          have h2 : (φ_AY a * φ_AY t - φ_AY s * φ_AY c) * (φ_AY s * φ_AY t)⁻¹ *
              (φ_AY s * φ_AY t) = φ_AY a * φ_AY t - φ_AY s * φ_AY c :=
            inv_mul_cancel_right₀ (mul_ne_zero hφs_ne hφt_ne) _
          rw [h1, h2]
          linear_combination hz_eq * φ_AY t
        rw [hz_decomp]
        exact (U b').toSubring.add_mem
          ((U b').toSubring.mul_mem (hU_mem b' c) (hUnitInv_of_not_M b' ht_not_M).1)
          (hMem_mU_of_P b' hb' hdiff_P hst_not_P).1
      · have ht_not_P : t ∉ 𝔓 := fun ht => ht_not_M (hP_le b₁ ht)
        have hat_not_P : a * t ∉ 𝔓 := fun hat =>
          (h𝔓_prime.mem_or_mem hat).elim ha_P ht_not_P
        have hφt_ne : φ_AY t ≠ 0 := hφAY_ne (fun h0 => ht_not_M (h0 ▸ Ideal.zero_mem M_star))
        let δ' : F := φ_AY (s * t - a * c) * (φ_AY (a * t))⁻¹
        have hz_inv_decomp : z⁻¹ = φ_AY c * (φ_AY t)⁻¹ + δ' := by
          apply mul_right_cancel₀ (mul_ne_zero hφa_ne hφt_ne)
          dsimp only [δ']
          rw [add_mul, map_sub, map_mul, map_mul, map_mul]
          have h0 : z⁻¹ * (φ_AY a * φ_AY t) = φ_AY s * φ_AY t := by
            rw [← hz_eq]
            calc z⁻¹ * (z * φ_AY s * φ_AY t)
                = (z⁻¹ * z) * (φ_AY s * φ_AY t) := by ring
              _ = φ_AY s * φ_AY t := by rw [inv_mul_cancel₀ hz_ne, one_mul]
          have h1 : φ_AY c * (φ_AY t)⁻¹ * (φ_AY a * φ_AY t) = φ_AY c * φ_AY a := by
            calc φ_AY c * (φ_AY t)⁻¹ * (φ_AY a * φ_AY t)
                = φ_AY c * φ_AY a * ((φ_AY t)⁻¹ * φ_AY t) := by ring
              _ = φ_AY c * φ_AY a := by rw [inv_mul_cancel₀ hφt_ne, mul_one]
          have h2 : (φ_AY s * φ_AY t - φ_AY a * φ_AY c) * (φ_AY a * φ_AY t)⁻¹ *
              (φ_AY a * φ_AY t) = φ_AY s * φ_AY t - φ_AY a * φ_AY c :=
            inv_mul_cancel_right₀ (mul_ne_zero hφa_ne hφt_ne) _
          rw [h0, h1, h2]
          ring
        obtain ⟨hδ'_Ub, hδ'_mUb⟩ := hMem_mU_of_P b hb hdiff_P hat_not_P
        obtain ⟨hδ'_Ub', hδ'_mUb'⟩ := hMem_mU_of_P b' hb' hdiff_P hat_not_P
        obtain ⟨htinv_Ub, _⟩ := hUnitInv_of_not_M b ht_not_M
        obtain ⟨htinv_Ub', _⟩ := hUnitInv_of_not_M b' ht_not_M
        have hc_not_M : c ∉ M_star := by
          intro hc_M
          have hc_mUb : (⟨φ_AY c, hU_mem b c⟩ : ↥(U b)) ∈ IsLocalRing.maximalIdeal ↥(U b) :=
            (hU_max b c).mpr hc_M
          have hct_Ub : φ_AY c * (φ_AY t)⁻¹ ∈ U b :=
            (U b).toSubring.mul_mem (hU_mem b c) htinv_Ub
          have hct_mUb : (⟨φ_AY c * (φ_AY t)⁻¹, hct_Ub⟩ : ↥(U b)) ∈
              IsLocalRing.maximalIdeal ↥(U b) := by
            have heq : (⟨φ_AY c * (φ_AY t)⁻¹, hct_Ub⟩ : ↥(U b)) =
                ⟨φ_AY c, hU_mem b c⟩ * ⟨(φ_AY t)⁻¹, htinv_Ub⟩ := rfl
            rw [heq]
            exact Ideal.mul_mem_right _ _ hc_mUb
          have hzinv_Ub : z⁻¹ ∈ U b := by
            rw [hz_inv_decomp]
            exact (U b).toSubring.add_mem hct_Ub hδ'_Ub
          have hzinv_mUb : (⟨z⁻¹, hzinv_Ub⟩ : ↥(U b)) ∈ IsLocalRing.maximalIdeal ↥(U b) := by
            have heq : (⟨z⁻¹, hzinv_Ub⟩ : ↥(U b)) =
                ⟨φ_AY c * (φ_AY t)⁻¹, hct_Ub⟩ + ⟨δ', hδ'_Ub⟩ := Subtype.ext hz_inv_decomp
            rw [heq]
            exact Ideal.add_mem _ hct_mUb hδ'_mUb
          have h1_mUb : (1 : ↥(U b)) ∈ IsLocalRing.maximalIdeal ↥(U b) := by
            have hmul : (⟨z, hz_Ub⟩ : ↥(U b)) * ⟨z⁻¹, hzinv_Ub⟩ = 1 :=
              Subtype.ext (mul_inv_cancel₀ hz_ne)
            rw [← hmul]
            exact Ideal.mul_mem_left _ _ hzinv_mUb
          exact (IsLocalRing.maximalIdeal.isMaximal ↥(U b)).ne_top
            (Ideal.eq_top_of_isUnit_mem _ h1_mUb isUnit_one)
        have hc_unit_Ub' : IsUnit (⟨φ_AY c, hU_mem b' c⟩ : ↥(U b')) :=
          IsLocalRing.notMem_maximalIdeal.mp (by rwa [hU_max b' c])
        have htinv_unit_Ub' : IsUnit (⟨(φ_AY t)⁻¹, htinv_Ub'⟩ : ↥(U b')) :=
          ⟨⟨⟨(φ_AY t)⁻¹, htinv_Ub'⟩, ⟨φ_AY t, hU_mem b' t⟩,
            Subtype.ext (inv_mul_cancel₀ hφt_ne), Subtype.ext (mul_inv_cancel₀ hφt_ne)⟩, rfl⟩
        let u_ct : ↥(U b') := ⟨φ_AY c, hU_mem b' c⟩ * ⟨(φ_AY t)⁻¹, htinv_Ub'⟩
        have hu_ct_unit : IsUnit u_ct := hc_unit_Ub'.mul htinv_unit_Ub'
        let zinv_elem : ↥(U b') := u_ct + ⟨δ', hδ'_Ub'⟩
        have hzinv_val : zinv_elem.1 = z⁻¹ := hz_inv_decomp.symm
        have hzinv_unit : IsUnit zinv_elem := by
          rw [← IsLocalRing.notMem_maximalIdeal]
          intro hmem
          have hu_in : u_ct ∈ IsLocalRing.maximalIdeal ↥(U b') := by
            have hsub := Ideal.sub_mem _ hmem hδ'_mUb'
            have heq_sub : zinv_elem - ⟨δ', hδ'_Ub'⟩ = u_ct :=
              add_sub_cancel_right u_ct ⟨δ', hδ'_Ub'⟩
            rwa [heq_sub] at hsub
          exact (IsLocalRing.mem_maximalIdeal u_ct).mp hu_in hu_ct_unit
        obtain ⟨z_elem, hz_elem⟩ := hzinv_unit.exists_right_inv
        have hzelem_val : z_elem.1 = z := by
          have hval : z⁻¹ * z_elem.1 = 1 := by
            rw [← hzinv_val]; exact congrArg Subtype.val hz_elem
          calc z_elem.1 = z * (z⁻¹ * z_elem.1) := by rw [← mul_assoc, mul_inv_cancel₀ hz_ne, one_mul]
            _ = z := by rw [hval, mul_one]
        rw [← hzelem_val]
        exact z_elem.2
  exact ⟨b₁, b₂, hb_ne, le_antisymm (hU_le_symm b₁ b₂ hP_b₁ hP_b₂) (hU_le_symm b₂ b₁ hP_b₂ hP_b₁)⟩

theorem weil_normal_curve_modification_domination_and_branch_bound (K : Type u) [Field K] [IsSepClosed K]
    (m : ℕ) (R : ValuationSubring K) (hPkg_R : IsValuationRingAlgPackage m R)
    (hMax_R : IsLocalRing.maximalIdeal ↥R ≠ ⊥)
    (W_B_sch : AlgebraicGeometry.Scheme.{u})
    (g_WB : W_B_sch ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
    (hAff_WB : AlgebraicGeometry.IsAffine W_B_sch)
    (hSS_WB : IsStrictlySemistableCurveOverValuation R g_WB)
    (u₀_WB : ↥W_B_sch)
    (hu₀_cl : IsClosed ({u₀_WB} : Set ↥W_B_sch))
    (hu₀_max : (g_WB.base u₀_WB).asIdeal = IsLocalRing.maximalIdeal ↥R)
    (Z_mod : Set ↥W_B_sch) (hZ_cl : IsClosed Z_mod) (hZ_fin : Z_mod.Finite)
    (hZ_neBot : ∀ y ∈ Z_mod, (g_WB.base y).asIdeal ≠ ⊥)
    (hZ_sp : ∀ y ∈ Z_mod, u₀_WB ∈ closure ({y} : Set ↥W_B_sch))
    (F_WB : Type u) [Field F_WB]
    (η_WB : AlgebraicGeometry.Spec (CommRingCat.of F_WB) ⟶ W_B_sch)
    (hFunc_WB : IsSchemeFunctionField W_B_sch F_WB η_WB) :
    let s_R := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.maximalIdeal ↥R).ResidueField))
    (∀ (Y : AlgebraicGeometry.Scheme.{u})
       (g_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
       (η_Y : AlgebraicGeometry.Spec (CommRingCat.of F_WB) ⟶ Y),
      IsStrictlySemistableCurveOverValuation R g_Y →
      IsSchemeFunctionField Y F_WB η_Y →
      ∀ E ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_Y s_R),
      ∀ W₁ W₂ : ValuationSubring F_WB,
        IsComponentStalkVal R g_Y η_Y E W₁ →
        IsComponentStalkVal R g_Y η_Y E W₂ →
        W₁ = W₂) ∧
    (∀ (Y₁ Y₂ : AlgebraicGeometry.Scheme.{u})
       (g₁ : Y₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
       (g₂ : Y₂ ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
       (f₁ : Y₁ ⟶ W_B_sch) (f₂ : Y₂ ⟶ W_B_sch)
       (η₁ : AlgebraicGeometry.Spec (CommRingCat.of F_WB) ⟶ Y₁)
       (η₂ : AlgebraicGeometry.Spec (CommRingCat.of F_WB) ⟶ Y₂),
      IsStrictlySemistableCurveOverValuation R g₁ →
      IsStrictlySemistableCurveOverValuation R g₂ →
      IsSchemeFunctionField Y₁ F_WB η₁ →
      IsSchemeFunctionField Y₂ F_WB η₂ →
      AlgebraicGeometry.IsProper f₁ →
      AlgebraicGeometry.IsProper f₂ →
      f₁ ≫ g_WB = g₁ →
      f₂ ≫ g_WB = g₂ →
      η₁ ≫ f₁ = η_WB →
      η₂ ≫ f₂ = η_WB →
      CategoryTheory.IsIso (f₁ ∣_ (⟨Z_modᶜ, hZ_cl.isOpen_compl⟩ : W_B_sch.Opens)) →
      (∃ U₂ : W_B_sch.Opens, Nonempty ↥U₂ ∧ CategoryTheory.IsIso (f₂ ∣_ U₂)) →
      (∀ E₁ ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g₁ s_R),
        (∀ q ∈ E₁, f₁.base ((CategoryTheory.Limits.pullback.fst g₁ s_R).base q) = u₀_WB) →
        ∀ W : ValuationSubring F_WB, IsComponentStalkVal R g₁ η₁ E₁ W →
          ∃ E₂ ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g₂ s_R),
            IsComponentStalkVal R g₂ η₂ E₂ W) →
      ∃ (α : Y₂ ⟶ Y₁) (hα_g : α ≫ g₁ = g₂),
        α ≫ f₁ = f₂ ∧
        η₂ ≫ α = η₁ ∧
        AlgebraicGeometry.IsProper α ∧
        AlgebraicGeometry.Surjective α ∧
        (let α_R : CategoryTheory.Limits.pullback g₂ s_R ⟶
           CategoryTheory.Limits.pullback g₁ s_R :=
           CategoryTheory.Limits.pullback.map g₂ s_R g₁ s_R α (𝟙 _) (𝟙 _)
             (by rw [CategoryTheory.Category.comp_id, hα_g])
             (by rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
         ∀ E₂ ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g₂ s_R),
         ∀ W : ValuationSubring F_WB,
           IsComponentStalkVal R g₂ η₂ E₂ W →
           ((∃ x_star : ↥(CategoryTheory.Limits.pullback g₁ s_R),
               IsClosed ({x_star} : Set ↥(CategoryTheory.Limits.pullback g₁ s_R)) ∧
               α_R.base '' E₂ = {x_star}) ∨
            (α_R.base '' E₂ ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g₁ s_R) ∧
             IsComponentStalkVal R g₁ η₁ (α_R.base '' E₂) W ∧
             ∀ x : ↥(CategoryTheory.Limits.pullback g₁ s_R), ∃ q ∈ E₂, α_R.base q ≠ x)) ∧
           (∀ E₁ ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g₁ s_R),
             IsComponentStalkVal R g₁ η₁ E₁ W →
             α_R.base '' E₂ = E₁ ∧
             ∀ x : ↥(CategoryTheory.Limits.pullback g₁ s_R), ∃ q ∈ E₂, α_R.base q ≠ x)) ∧
        (CategoryTheory.IsIso (f₂ ∣_ (⟨Z_modᶜ, hZ_cl.isOpen_compl⟩ : W_B_sch.Opens)) →
         (∀ E₂ ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g₂ s_R),
           (∀ q ∈ E₂, f₂.base ((CategoryTheory.Limits.pullback.fst g₂ s_R).base q) = u₀_WB) →
           ∀ W : ValuationSubring F_WB, IsComponentStalkVal R g₂ η₂ E₂ W →
             ∃ E₁ ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g₁ s_R),
               IsComponentStalkVal R g₁ η₁ E₁ W) →
         CategoryTheory.IsIso α)) ∧
    (∀ (Y_hat Y : AlgebraicGeometry.Scheme.{u})
       (g_hat : Y_hat ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
       (g_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
       (α : Y_hat ⟶ Y)
       (η_hat : AlgebraicGeometry.Spec (CommRingCat.of F_WB) ⟶ Y_hat)
       (hα_g : α ≫ g_Y = g_hat),
      IsStrictlySemistableCurveOverValuation R g_hat →
      IsStrictlySemistableCurveOverValuation R g_Y →
      IsSchemeFunctionField Y_hat F_WB η_hat →
      IsSchemeFunctionField Y F_WB (η_hat ≫ α) →
      AlgebraicGeometry.IsProper α →
      let α_R : CategoryTheory.Limits.pullback g_hat s_R ⟶
        CategoryTheory.Limits.pullback g_Y s_R :=
        CategoryTheory.Limits.pullback.map g_hat s_R g_Y s_R α (𝟙 _) (𝟙 _)
          (by rw [CategoryTheory.Category.comp_id, hα_g])
          (by rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
      ¬ ∃ (x_star : ↥(CategoryTheory.Limits.pullback g_Y s_R))
          (p : Fin 3 → ↥(CategoryTheory.Limits.pullback g_hat s_R))
          (B : Fin 3 → Set ↥(CategoryTheory.Limits.pullback g_hat s_R)),
          IsClosed ({x_star} : Set ↥(CategoryTheory.Limits.pullback g_Y s_R)) ∧
          Function.Injective p ∧
          ∀ b : Fin 3,
            B b ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_hat s_R) ∧
            p b ∈ B b ∧
            α_R.base (p b) = x_star ∧
            (∃ q ∈ B b, α_R.base q ≠ x_star) ∧
            ∃ (U_nod : Y_hat.Opens) (a_n : ↥R)
              (e_n : U_nod.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of
                (MvPolynomial (Fin 2) ↥R ⧸ Ideal.span
                  {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a_n}))),
              a_n ≠ 0 ∧ a_n ∈ IsLocalRing.maximalIdeal ↥R ∧
              AlgebraicGeometry.Etale e_n ∧
              U_nod.ι ≫ g_hat = e_n ≫ AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) ∧
              ∃ hp : (CategoryTheory.Limits.pullback.fst g_hat s_R).base (p b) ∈ U_nod,
                (∀ j : Fin 2, Ideal.Quotient.mk _ (MvPolynomial.X j) ∈
                  (e_n.base ⟨_, hp⟩).asIdeal) ∧
                ∃ b₀ : Fin 2, ∀ x : ↥U_nod,
                  (g_hat.base x.1).asIdeal = IsLocalRing.maximalIdeal ↥R →
                  (x.1 ∈ (CategoryTheory.Limits.pullback.fst g_hat s_R).base '' (B b) ↔
                    Ideal.Quotient.mk _ (MvPolynomial.X b₀) ∈ (e_n.base x).asIdeal)) :=
by
  classical
  let s_R := AlgebraicGeometry.Spec.map
    (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.maximalIdeal ↥R).ResidueField))
  have hDom_specMap : ∀ {A : Type u} [CommRing A] {F : Type u} [Field F]
      (f : A →+* F), Function.Injective f →
      AlgebraicGeometry.IsDominant (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f)) := by
    intro A _ F _ f hf
    rw [AlgebraicGeometry.isDominant_iff, DenseRange]
    intro q
    let p₀ : PrimeSpectrum A :=
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f)).base (⊥ : PrimeSpectrum F)
    have hle : p₀ ≤ (q : PrimeSpectrum A) := by
      change Ideal.comap f (⊥ : PrimeSpectrum F).asIdeal ≤ (q : PrimeSpectrum A).asIdeal
      have hbot : (⊥ : PrimeSpectrum F).asIdeal = ⊥ := rfl
      rw [hbot, Ideal.comap_bot_of_injective f hf]
      exact bot_le
    have hcl : (q : PrimeSpectrum A) ∈ closure ({p₀} : Set (PrimeSpectrum A)) :=
      (PrimeSpectrum.le_iff_mem_closure p₀ q).mp hle
    have hmem : p₀ ∈ Set.range (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f)).base :=
      ⟨(⊥ : PrimeSpectrum F), rfl⟩
    exact closure_mono (Set.singleton_subset_iff.mpr hmem) hcl
  have hDom_funcField : ∀ (X : AlgebraicGeometry.Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral X)
      (η : AlgebraicGeometry.Spec (CommRingCat.of F_WB) ⟶ X),
      IsSchemeFunctionField X F_WB η → AlgebraicGeometry.IsDominant η := by
    intro X hIntX η hFunc
    rw [AlgebraicGeometry.isDominant_iff, denseRange_iff_closure_range]
    ext x
    simp only [Set.mem_univ, iff_true, mem_closure_iff]
    intro V hV hxV
    obtain ⟨U, hU_aff, hxU, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := ⊤) (x := x) trivial
    have hne : Nonempty ↥U := ⟨⟨x, hxU⟩⟩
    obtain ⟨φ, hFrac, hη_eq⟩ := hFunc U hU_aff hne
    have hDom_U : IsDomain ↑(X.presheaf.obj (Opposite.op U)) :=
      @AlgebraicGeometry.IsIntegral.component_integral X hIntX U hne
    have hinj : Function.Injective φ.hom :=
      @IsFractionRing.injective ↑(X.presheaf.obj (Opposite.op U)) _ F_WB _ φ.hom.toAlgebra hFrac
    have hx_range : x ∈ Set.range hU_aff.fromSpec.base := by
      rwa [hU_aff.range_fromSpec]
    obtain ⟨p, hp_eq⟩ := hx_range
    have hDom_map : AlgebraicGeometry.IsDominant (AlgebraicGeometry.Spec.map φ) :=
      hDom_specMap φ.hom hinj
    have hp_cl : p ∈ closure (Set.range (AlgebraicGeometry.Spec.map φ).base) :=
      hDom_map.denseRange p
    rw [mem_closure_iff] at hp_cl
    have hp_open : IsOpen (hU_aff.fromSpec.base ⁻¹' V) :=
      hV.preimage hU_aff.fromSpec.continuous
    have hp_mem : p ∈ hU_aff.fromSpec.base ⁻¹' V := by
      show hU_aff.fromSpec.base p ∈ V
      rwa [hp_eq]
    obtain ⟨_, hqV, q₀, rfl⟩ := hp_cl _ hp_open hp_mem
    refine ⟨η.base q₀, ?_, ⟨q₀, rfl⟩⟩
    rw [← hη_eq]
    exact hqV
  have hSurj_res : Function.Surjective
      (algebraMap ↥R (IsLocalRing.maximalIdeal ↥R).ResidueField) := by
    intro y
    obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective y
    obtain ⟨⟨r, s⟩, hz⟩ := IsLocalization.surj (IsLocalRing.maximalIdeal ↥R).primeCompl z
    have hs_unit : IsUnit (s : ↥R) := IsLocalRing.notMem_maximalIdeal.mp s.2
    obtain ⟨s_inv, hs_inv⟩ := hs_unit.exists_right_inv
    refine ⟨r * s_inv, ?_⟩
    change Ideal.Quotient.mk _
      (algebraMap ↥R (Localization.AtPrime (IsLocalRing.maximalIdeal ↥R)) (r * s_inv)) =
      Ideal.Quotient.mk _ z
    congr 1
    have hz' : z * algebraMap ↥R _ (s : ↥R) = algebraMap ↥R _ r := hz
    calc algebraMap ↥R (Localization.AtPrime (IsLocalRing.maximalIdeal ↥R)) (r * s_inv)
        = algebraMap ↥R _ r * algebraMap ↥R _ s_inv := map_mul _ r s_inv
      _ = z * algebraMap ↥R _ (s : ↥R) * algebraMap ↥R _ s_inv := by rw [hz']
      _ = z * algebraMap ↥R _ ((s : ↥R) * s_inv) := by rw [mul_assoc, ← map_mul]
      _ = z * 1 := by rw [hs_inv, map_one]
      _ = z := mul_one z
  obtain ⟨hStalkExUniq, hDichot⟩ :=
    weil_strictlySemistable_fiber_component_stalk_val_and_dichotomy K m R hPkg_R hMax_R F_WB
  refine ⟨?_, ?_, ?_⟩
  · intro Y g_Y η_Y hSS_Y hFunc_Y E hE W₁ W₂ hW₁ hW₂
    exact (hStalkExUniq Y g_Y η_Y hSS_Y hFunc_Y E hE).2 W₁ W₂ hW₁ hW₂
  · intro Y₁ Y₂ g₁ g₂ f₁ f₂ η₁ η₂ hSS₁ hSS₂ hFunc₁ hFunc₂ hProp₁ hProp₂
      hf₁_g hf₂_g hη₁_f hη₂_f hIso₁ hU₂ hDom₁₂
    obtain ⟨α, hα_g, hα_f, hα_η, hProp_α, hSurj_α⟩ :=
      weil_normal_curve_modification_domination_morphism K m R hPkg_R hMax_R
        W_B_sch g_WB hAff_WB hSS_WB u₀_WB hu₀_cl hu₀_max Z_mod hZ_cl hZ_fin
        hZ_neBot hZ_sp F_WB η_WB hFunc_WB
        Y₁ Y₂ g₁ g₂ f₁ f₂ η₁ η₂
        hSS₁ hSS₂ hFunc₁ hFunc₂ hProp₁ hProp₂ hf₁_g hf₂_g hη₁_f hη₂_f hIso₁ hU₂ hDom₁₂
    refine ⟨α, hα_g, hα_f, hα_η, hProp_α, hSurj_α,
      hDichot Y₁ Y₂ g₁ g₂ η₁ η₂ α hα_g hSS₁ hSS₂ hFunc₁ hFunc₂ hα_η hProp_α, ?_⟩
    intro hIso₂ hDom₂₁
    have hNonempty_compl : Nonempty ↥(⟨Z_modᶜ, hZ_cl.isOpen_compl⟩ : W_B_sch.Opens) := by
      have _ : AlgebraicGeometry.Flat g_WB := hSS_WB.2.1
      let p_bot : PrimeSpectrum ↥R := ⊥
      have hsp : (p_bot : AlgebraicGeometry.Spec (CommRingCat.of ↥R)) ⤳ g_WB.base u₀_WB :=
        (PrimeSpectrum.le_iff_specializes p_bot (g_WB.base u₀_WB)).mp bot_le
      obtain ⟨y₀, _, hy₀⟩ := AlgebraicGeometry.Flat.generalizingMap g_WB hsp
      have hy₀_bot : (g_WB.base y₀).asIdeal = ⊥ := congrArg PrimeSpectrum.asIdeal hy₀
      exact ⟨⟨y₀, fun hy => hZ_neBot y₀ hy hy₀_bot⟩⟩
    obtain ⟨β, hβ_g, _, hβ_η, _, _⟩ :=
      weil_normal_curve_modification_domination_morphism K m R hPkg_R hMax_R
        W_B_sch g_WB hAff_WB hSS_WB u₀_WB hu₀_cl hu₀_max Z_mod hZ_cl hZ_fin
        hZ_neBot hZ_sp F_WB η_WB hFunc_WB
        Y₂ Y₁ g₂ g₁ f₂ f₁ η₂ η₁
        hSS₂ hSS₁ hFunc₂ hFunc₁ hProp₂ hProp₁ hf₂_g hf₁_g hη₂_f hη₁_f
        hIso₂ ⟨⟨Z_modᶜ, hZ_cl.isOpen_compl⟩, hNonempty_compl, hIso₁⟩ hDom₂₁
    have _ : AlgebraicGeometry.IsIntegral Y₁ := hSS₁.1
    have _ : AlgebraicGeometry.IsIntegral Y₂ := hSS₂.1
    have _ : AlgebraicGeometry.IsSeparated g₁ := hSS₁.2.2.1
    have _ : AlgebraicGeometry.IsSeparated g₂ := hSS₂.2.2.1
    have _ : AlgebraicGeometry.IsDominant η₁ := hDom_funcField Y₁ hSS₁.1 η₁ hFunc₁
    have _ : AlgebraicGeometry.IsDominant η₂ := hDom_funcField Y₂ hSS₂.1 η₂ hFunc₂
    have hαβ : α ≫ β = 𝟙 Y₂ := by
      refine AlgebraicGeometry.ext_of_isDominant_of_isSeparated g₂ ?_ η₂ ?_
      · rw [CategoryTheory.Category.assoc, hβ_g, hα_g, CategoryTheory.Category.id_comp]
      · rw [← CategoryTheory.Category.assoc, hα_η, hβ_η, CategoryTheory.Category.comp_id]
    have hβα : β ≫ α = 𝟙 Y₁ := by
      refine AlgebraicGeometry.ext_of_isDominant_of_isSeparated g₁ ?_ η₁ ?_
      · rw [CategoryTheory.Category.assoc, hα_g, hβ_g, CategoryTheory.Category.id_comp]
      · rw [← CategoryTheory.Category.assoc, hβ_η, hα_η, CategoryTheory.Category.comp_id]
    exact ⟨⟨β, hαβ, hβα⟩⟩
  · intro Y_hat Y g_hat g_Y α η_hat hα_g hSS_hat hSS_Y hFunc_hat hFunc_Y hProp_α α_R
    rintro ⟨x_star, p, B, hx_cl, hp_inj, hB⟩
    have hW_ex : ∀ b : Fin 3, ∃ W : ValuationSubring F_WB,
        IsComponentStalkVal R g_hat η_hat (B b) W :=
      fun b => (hStalkExUniq Y_hat g_hat η_hat hSS_hat hFunc_hat (B b) (hB b).1).1
    choose W hW using hW_ex
    let E : Fin 3 → Set ↥(CategoryTheory.Limits.pullback g_Y s_R) :=
      fun b => α_R.base '' (B b)
    have hE_props : ∀ b : Fin 3,
        E b ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_Y s_R) ∧
        IsComponentStalkVal R g_Y (η_hat ≫ α) (E b) (W b) := by
      intro b
      have hD := (hDichot Y Y_hat g_Y g_hat (η_hat ≫ α) η_hat α hα_g
        hSS_Y hSS_hat hFunc_Y hFunc_hat rfl hProp_α (B b) (hB b).1 (W b) (hW b)).1
      rcases hD with ⟨x', _, hx'_eq⟩ | ⟨hE_irr, hE_stalk, _⟩
      · exfalso
        have hp_in : α_R.base (p b) ∈ ({x'} : Set _) :=
          hx'_eq ▸ ⟨p b, (hB b).2.1, rfl⟩
        rw [Set.mem_singleton_iff, (hB b).2.2.1] at hp_in
        obtain ⟨q, hqB, hq_ne⟩ := (hB b).2.2.2.1
        have hq_in : α_R.base q ∈ ({x'} : Set _) :=
          hx'_eq ▸ ⟨q, hqB, rfl⟩
        rw [Set.mem_singleton_iff, ← hp_in] at hq_in
        exact hq_ne hq_in
      · exact ⟨hE_irr, hE_stalk⟩
    have hU_ex : ∀ b : Fin 3,
        ∃ (U₀ : ValuationSubring F_WB)
          (φ_hat : AlgebraicGeometry.Spec (CommRingCat.of ↥U₀) ⟶ Y_hat)
          (mU₀ : AlgebraicGeometry.Spec (CommRingCat.of ↥U₀)),
          U₀ ≤ W b ∧
          U₀ ≠ W b ∧
          mU₀.asIdeal = IsLocalRing.maximalIdeal ↥U₀ ∧
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom U₀.subtype) ≫ φ_hat = η_hat ∧
          φ_hat.base mU₀ = (CategoryTheory.Limits.pullback.fst g_hat s_R).base (p b) :=
      fun b => weil_nodal_single_coord_branch_composite_valuation K m R hPkg_R hMax_R F_WB
        Y_hat g_hat η_hat hSS_hat hFunc_hat (B b) (W b) (p b)
        (hB b).1 (hW b) (hB b).2.1 (hB b).2.2.2.2
    choose U φ_hat mU hU_le hU_ne hmU hφ_η hφ_pt using hU_ex
    let φ_Y : ∀ b : Fin 3, AlgebraicGeometry.Spec (CommRingCat.of ↥(U b)) ⟶ Y :=
      fun b => φ_hat b ≫ α
    have hφY_props : ∀ b : Fin 3,
        E b ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_Y s_R) ∧
        IsComponentStalkVal R g_Y (η_hat ≫ α) (E b) (W b) ∧
        U b ≤ W b ∧
        U b ≠ W b ∧
        (mU b).asIdeal = IsLocalRing.maximalIdeal ↥(U b) ∧
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (U b).subtype) ≫ φ_Y b = η_hat ≫ α ∧
        (φ_Y b).base (mU b) = (CategoryTheory.Limits.pullback.fst g_Y s_R).base x_star := by
      intro b
      refine ⟨(hE_props b).1, (hE_props b).2, hU_le b, hU_ne b, hmU b, ?_, ?_⟩
      · dsimp only [φ_Y]
        rw [← CategoryTheory.Category.assoc, hφ_η b]
      · have hfst_comm :
            (CategoryTheory.Limits.pullback.fst g_hat s_R ≫ α).base (p b) =
            (α_R ≫ CategoryTheory.Limits.pullback.fst g_Y s_R).base (p b) := by
          dsimp only [α_R, CategoryTheory.Limits.pullback.map]
          rw [CategoryTheory.Limits.pullback.lift_fst]
        change α.base ((φ_hat b).base (mU b)) = _
        rw [hφ_pt b]
        change (CategoryTheory.Limits.pullback.fst g_hat s_R ≫ α).base (p b) = _
        rw [hfst_comm]
        change (CategoryTheory.Limits.pullback.fst g_Y s_R).base (α_R.base (p b)) = _
        rw [(hB b).2.2.1]
    obtain ⟨b₁, b₂, hb_ne, hU_eq⟩ :=
      weil_semistable_closed_point_at_most_two_composite_valuations K m R hPkg_R hMax_R F_WB
        Y g_Y (η_hat ≫ α) hSS_Y hFunc_Y x_star hx_cl E W U φ_Y mU hφY_props
    have hpt_eq : ∀ (U₁ U₂ : ValuationSubring F_WB) (_ : U₁ = U₂)
        (φ₁ : AlgebraicGeometry.Spec (CommRingCat.of ↥U₁) ⟶ Y_hat)
        (φ₂ : AlgebraicGeometry.Spec (CommRingCat.of ↥U₂) ⟶ Y_hat)
        (m₁ : AlgebraicGeometry.Spec (CommRingCat.of ↥U₁))
        (m₂ : AlgebraicGeometry.Spec (CommRingCat.of ↥U₂)),
        m₁.asIdeal = IsLocalRing.maximalIdeal ↥U₁ →
        m₂.asIdeal = IsLocalRing.maximalIdeal ↥U₂ →
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom U₁.subtype) ≫ φ₁ = η_hat →
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom U₂.subtype) ≫ φ₂ = η_hat →
        φ₁.base m₁ = φ₂.base m₂ := by
      rintro U₁ U₂ rfl φ₁ φ₂ m₁ m₂ hm₁ hm₂ hφ₁ hφ₂
      have _ : AlgebraicGeometry.IsSeparated g_hat := hSS_hat.2.2.1
      have _ : AlgebraicGeometry.IsDominant
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom U₁.subtype)) :=
        hDom_specMap U₁.subtype Subtype.val_injective
      have hg_eq : φ₁ ≫ g_hat = φ₂ ≫ g_hat := by
        refine AlgebraicGeometry.ext_of_isDominant
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom U₁.subtype)) ?_
        rw [← CategoryTheory.Category.assoc, hφ₁, ← CategoryTheory.Category.assoc, hφ₂]
      have hφ_eq : φ₁ = φ₂ :=
        AlgebraicGeometry.ext_of_isDominant_of_isSeparated g_hat hg_eq
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom U₁.subtype)) (hφ₁.trans hφ₂.symm)
      have hm_eq : m₁ = m₂ := PrimeSpectrum.ext (hm₁.trans hm₂.symm)
      rw [hφ_eq, hm_eq]
    have hfst_eq : (CategoryTheory.Limits.pullback.fst g_hat s_R).base (p b₁) =
        (CategoryTheory.Limits.pullback.fst g_hat s_R).base (p b₂) := by
      rw [← hφ_pt b₁, ← hφ_pt b₂]
      exact hpt_eq (U b₁) (U b₂) hU_eq (φ_hat b₁) (φ_hat b₂) (mU b₁) (mU b₂)
        (hmU b₁) (hmU b₂) (hφ_η b₁) (hφ_η b₂)
    have _ : AlgebraicGeometry.IsClosedImmersion s_R :=
      AlgebraicGeometry.IsClosedImmersion.spec_of_surjective
        (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.maximalIdeal ↥R).ResidueField)) hSurj_res
    have hp_eq : p b₁ = p b₂ :=
      (CategoryTheory.Limits.pullback.fst g_hat s_R).isClosedEmbedding.injective hfst_eq
    exact hb_ne (hp_inj hp_eq)

theorem weil_local_chart_smooth_leaf_blowup_package (K : Type u) [Field K] [IsSepClosed K]
    (m : ℕ) (R : ValuationSubring K) (hPkg_R : IsValuationRingAlgPackage m R)
    (hMax_R : IsLocalRing.maximalIdeal ↥R ≠ ⊥) :
    HasLocalSmoothLeafBlowup R :=
by
  suffices h_goal : ∀ (K₀ : Type u) [Field K₀] (R₀ : ValuationSubring K₀),
      HasLocalSmoothLeafBlowup R₀ from h_goal K R
  clear * -
  intro K _ R
  have h_1_3 : ∀ (h_p : Polynomial ↥R) (c_tilde π_tilde : ↥R),
      Polynomial.eval c_tilde h_p ∉ IsLocalRing.maximalIdeal ↥R →
      π_tilde ≠ 0 →
      π_tilde ∈ IsLocalRing.maximalIdeal ↥R →
      let B := Localization.Away h_p
      let g_B : AlgebraicGeometry.Spec (CommRingCat.of B) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of ↥R) :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          ((algebraMap (Polynomial ↥R) B).comp Polynomial.C))
      let h_0 : Polynomial ↥R :=
        h_p.comp (Polynomial.C c_tilde + Polynomial.C π_tilde * Polynomial.X)
      let u_B := algebraMap (Polynomial ↥R) B (Polynomial.X - Polynomial.C c_tilde)
      let π_B := algebraMap (Polynomial ↥R) B (Polynomial.C π_tilde)
      let C_0 := Localization.Away h_0
      let t_0 := algebraMap (Polynomial ↥R) C_0 Polynomial.X
      let C_01 := Localization.Away (h_0 * Polynomial.X)
      ∃ (Q₀_R : PrimeSpectrum ↥R)
        (h_1 : weilNodalQuot ↥R π_tilde)
        (ψ_0 : B →+* C_0)
        (ψ_1 : B →+* Localization.Away h_1)
        (f_01 : C_0 →+* C_01)
        (f_10 : Localization.Away h_1 →+* C_01)
        (ψ_π : C_0 →+* Localization.Away π_B)
        (ψ_u : Localization.Away h_1 →+* Localization.Away u_B),
        let C_1 := Localization.Away h_1
        let u_1 := algebraMap (weilNodalQuot ↥R π_tilde) C_1
          (Ideal.Quotient.mk (weilNodalIdeal ↥R π_tilde) (MvPolynomial.X 0))
        let s_1 := algebraMap (weilNodalQuot ↥R π_tilde) C_1
          (Ideal.Quotient.mk (weilNodalIdeal ↥R π_tilde) (MvPolynomial.X 1))
        let g_0 := AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((algebraMap (Polynomial ↥R) C_0).comp Polynomial.C))
        let g_1 := AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((algebraMap (weilNodalQuot ↥R π_tilde) C_1).comp
            ((Ideal.Quotient.mk (weilNodalIdeal ↥R π_tilde)).comp MvPolynomial.C)))
        Q₀_R.asIdeal = Ideal.radical (Ideal.span {π_tilde}) ∧
        Q₀_R.asIdeal ≠ ⊥ ∧
        π_tilde ∈ Q₀_R.asIdeal ∧
        Q₀_R.asIdeal ≤ IsLocalRing.maximalIdeal ↥R ∧
        (∀ c_val : ↥R, Polynomial.eval c_val h_0 ∉ IsLocalRing.maximalIdeal ↥R) ∧
        h_1 ∉ Ideal.span {Ideal.Quotient.mk (weilNodalIdeal ↥R π_tilde) (MvPolynomial.X 0),
              Ideal.Quotient.mk (weilNodalIdeal ↥R π_tilde) (MvPolynomial.X 1)} ⊔
            Ideal.map ((Ideal.Quotient.mk (weilNodalIdeal ↥R π_tilde)).comp MvPolynomial.C)
              (IsLocalRing.maximalIdeal ↥R) ∧
        h_1 = Ideal.Quotient.mk (weilNodalIdeal ↥R π_tilde)
          (Polynomial.eval₂ MvPolynomial.C (MvPolynomial.C c_tilde + MvPolynomial.X 0) h_p) ∧
        IsDomain B ∧ IsDomain C_0 ∧ IsDomain C_1 ∧ IsDomain C_01 ∧
        (∀ r : ↥R, ψ_0 (algebraMap (Polynomial ↥R) B (Polynomial.C r)) =
          algebraMap (Polynomial ↥R) C_0 (Polynomial.C r)) ∧
        ψ_0 (algebraMap (Polynomial ↥R) B Polynomial.X) =
          algebraMap (Polynomial ↥R) C_0 (Polynomial.C c_tilde + Polynomial.C π_tilde * Polynomial.X) ∧
        (∀ r : ↥R, ψ_1 (algebraMap (Polynomial ↥R) B (Polynomial.C r)) =
          algebraMap (weilNodalQuot ↥R π_tilde) C_1
            (Ideal.Quotient.mk (weilNodalIdeal ↥R π_tilde) (MvPolynomial.C r))) ∧
        ψ_1 (algebraMap (Polynomial ↥R) B Polynomial.X) =
          algebraMap (weilNodalQuot ↥R π_tilde) C_1
            (Ideal.Quotient.mk (weilNodalIdeal ↥R π_tilde) (MvPolynomial.C c_tilde + MvPolynomial.X 0)) ∧
        ψ_0 u_B = ψ_0 π_B * t_0 ∧
        ψ_1 u_B = u_1 ∧
        ψ_1 π_B = u_1 * s_1 ∧
        Subring.closure (Set.range ψ_0 ∪ {t_0}) = ⊤ ∧
        Subring.closure (Set.range ψ_1 ∪ {s_1}) = ⊤ ∧
        @IsLocalization.Away C_0 _ t_0 C_01 _ f_01.toAlgebra ∧
        @IsLocalization.Away C_1 _ s_1 C_01 _ f_10.toAlgebra ∧
        Function.Injective f_01 ∧
        Function.Injective f_10 ∧
        f_01.comp ψ_0 = f_10.comp ψ_1 ∧
        f_01 t_0 * f_10 s_1 = 1 ∧
        (∀ P : Polynomial ↥R, f_01 (algebraMap (Polynomial ↥R) C_0 P) =
          algebraMap (Polynomial ↥R) C_01 P) ∧
        (∀ r : ↥R, f_10 (algebraMap (weilNodalQuot ↥R π_tilde) C_1
          (Ideal.Quotient.mk (weilNodalIdeal ↥R π_tilde) (MvPolynomial.C r))) =
          algebraMap (Polynomial ↥R) C_01 (Polynomial.C r)) ∧
        f_10 u_1 = algebraMap (Polynomial ↥R) C_01 (Polynomial.C π_tilde * Polynomial.X) ∧
        algebraMap (Polynomial ↥R) C_01 Polynomial.X * f_10 s_1 = 1 ∧
        ψ_π.comp ψ_0 = algebraMap B (Localization.Away π_B) ∧
        @IsLocalization.Away C_0 _ (ψ_0 π_B) (Localization.Away π_B) _ ψ_π.toAlgebra ∧
        ψ_u.comp ψ_1 = algebraMap B (Localization.Away u_B) ∧
        @IsLocalization.Away C_1 _ (ψ_1 u_B) (Localization.Away u_B) _ ψ_u.toAlgebra ∧
        AlgebraicGeometry.SmoothOfRelativeDimension 1 g_B ∧
        AlgebraicGeometry.Flat g_0 ∧
        AlgebraicGeometry.LocallyOfFinitePresentation g_0 ∧
        AlgebraicGeometry.Flat g_1 ∧
        AlgebraicGeometry.LocallyOfFinitePresentation g_1 := by
    intro h_p c_tilde π_tilde hh_p hπ_ne hπ_mem
    classical
    dsimp only
    let m_R : Ideal ↥R := IsLocalRing.maximalIdeal ↥R
    have hmR_max : m_R.IsMaximal := IsLocalRing.maximalIdeal.isMaximal ↥R
    let _ : m_R.IsMaximal := hmR_max
    let k_R : Type u := ↥R ⧸ m_R
    let _ : Field k_R := Ideal.Quotient.field m_R
    let res_R : ↥R →+* k_R := Ideal.Quotient.mk m_R
    have hres_π : res_R π_tilde = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hπ_mem
    have hh_p_res : res_R (Polynomial.eval c_tilde h_p) ≠ 0 :=
      fun h0 => hh_p (Ideal.Quotient.eq_zero_iff_mem.mp h0)
    have hh_p_ne : h_p ≠ 0 := by
      rintro rfl
      simp [map_zero] at hh_p_res

    
    have r_dvd_total : ∀ x y : ↥R, (∃ r : ↥R, x = r * y) ∨ (∃ r : ↥R, y = r * x) := by
      intro x y
      by_cases hy : y = 0
      · right; exact ⟨0, by rw [hy, zero_mul]⟩
      · have hy0 : (y : K) ≠ 0 := fun h => hy (Subtype.ext h)
        rcases ValuationSubring.mem_or_inv_mem R ((x : K) / (y : K)) with hxy | hyx
        · left
          exact ⟨⟨(x : K) / (y : K), hxy⟩, Subtype.ext (div_mul_cancel₀ (x : K) hy0).symm⟩
        · by_cases hx : x = 0
          · left; exact ⟨0, by rw [hx, zero_mul]⟩
          · have hx0 : (x : K) ≠ 0 := fun h => hx (Subtype.ext h)
            right
            refine ⟨⟨((x : K) / (y : K))⁻¹, hyx⟩, Subtype.ext ?_⟩
            change (y : K) = ((x : K) / (y : K))⁻¹ * (x : K)
            rw [inv_div]
            exact (div_mul_cancel₀ (y : K) hx0).symm
    let J_0 : Ideal ↥R := Ideal.radical (Ideal.span ({π_tilde} : Set ↥R))
    have hπ_J0 : π_tilde ∈ J_0 := ⟨1, by rw [pow_one]; exact Ideal.mem_span_singleton_self π_tilde⟩
    have hJ0_ne_bot : J_0 ≠ ⊥ := by
      intro hbot
      rw [hbot, Ideal.mem_bot] at hπ_J0
      exact hπ_ne hπ_J0
    have hJ0_le_mR : J_0 ≤ m_R := by
      calc J_0 ≤ m_R.radical :=
            Ideal.radical_mono (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hπ_mem))
        _ = m_R := hmR_max.isPrime.radical
    have hJ0_prime : J_0.IsPrime := by
      refine ⟨ne_top_of_le_ne_top hmR_max.ne_top hJ0_le_mR, fun {a b} hab => ?_⟩
      obtain ⟨k, hk⟩ := hab
      rw [Ideal.mem_span_singleton] at hk
      obtain ⟨s, hs⟩ := hk
      rcases r_dvd_total a b with ⟨r, rfl⟩ | ⟨r, rfl⟩
      · left
        refine ⟨2 * k, Ideal.mem_span_singleton.mpr ⟨r ^ k * s, ?_⟩⟩
        calc (r * b) ^ (2 * k) = ((r * b) ^ 2) ^ k := pow_mul (r * b) 2 k
          _ = (r * ((r * b) * b)) ^ k := by ring_nf
          _ = r ^ k * ((r * b) * b) ^ k := mul_pow r ((r * b) * b) k
          _ = r ^ k * (π_tilde * s) := by rw [hs]
          _ = π_tilde * (r ^ k * s) := by ring
      · right
        refine ⟨2 * k, Ideal.mem_span_singleton.mpr ⟨r ^ k * s, ?_⟩⟩
        calc (r * a) ^ (2 * k) = ((r * a) ^ 2) ^ k := pow_mul (r * a) 2 k
          _ = (r * (a * (r * a))) ^ k := by ring_nf
          _ = r ^ k * (a * (r * a)) ^ k := mul_pow r (a * (r * a)) k
          _ = r ^ k * (π_tilde * s) := by rw [hs]
          _ = π_tilde * (r ^ k * s) := by ring
    let Q₀_R : PrimeSpectrum ↥R := ⟨J_0, hJ0_prime⟩

    
    let I_nod := weilNodalIdeal ↥R π_tilde
    let A_nod := weilNodalQuot ↥R π_tilde
    let mk_nod : MvPolynomial (Fin 2) ↥R →+* A_nod := Ideal.Quotient.mk I_nod
    let c_nod : ↥R →+* A_nod := mk_nod.comp MvPolynomial.C
    let u0_nod : A_nod := mk_nod (MvPolynomial.X 0)
    let u1_nod : A_nod := mk_nod (MvPolynomial.X 1)
    let ι0_nod : Polynomial ↥R →+* A_nod := Polynomial.eval₂RingHom c_nod u0_nod
    have hu01_nod : u0_nod * u1_nod = c_nod π_tilde := by
      apply sub_eq_zero.mp
      change mk_nod (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C π_tilde) = 0
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
    have mvPoly_split0 : ∀ F : MvPolynomial (Fin 2) ↥R,
        ∃ G : MvPolynomial (Fin 2) ↥R,
          F = Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.X 1)
            (MvPolynomial.eval₂Hom Polynomial.C ![0, Polynomial.X] F) +
            MvPolynomial.X 0 * G := by
      intro F
      induction F using MvPolynomial.induction_on with
      | C r => exact ⟨0, by simp⟩
      | add p q ihp ihq =>
        obtain ⟨Gp, hp⟩ := ihp
        obtain ⟨Gq, hq⟩ := ihq
        refine ⟨Gp + Gq, ?_⟩
        rw [map_add, map_add]
        linear_combination hp + hq
      | mul_X p i ihp =>
        obtain ⟨Gp, hp⟩ := ihp
        fin_cases i
        · change ∃ G, p * MvPolynomial.X 0 =
            Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.X 1)
              (MvPolynomial.eval₂Hom Polynomial.C ![0, Polynomial.X] (p * MvPolynomial.X 0)) +
              MvPolynomial.X 0 * G
          refine ⟨p, ?_⟩
          rw [map_mul, MvPolynomial.eval₂Hom_X', Matrix.cons_val_zero, mul_zero,
            map_zero, zero_add, mul_comm]
        · change ∃ G, p * MvPolynomial.X 1 =
            Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.X 1)
              (MvPolynomial.eval₂Hom Polynomial.C ![0, Polynomial.X] (p * MvPolynomial.X 1)) +
              MvPolynomial.X 0 * G
          refine ⟨Gp * MvPolynomial.X 1, ?_⟩
          rw [map_mul, MvPolynomial.eval₂Hom_X', Matrix.cons_val_one, Matrix.cons_val_zero, map_mul,
            Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X, ← Polynomial.coe_eval₂RingHom]
          linear_combination hp * MvPolynomial.X 1
    have hu0_reg1 : ∀ y : A_nod, u0_nod * y = 0 → y = 0 := by
      refine Quotient.ind fun F hF => ?_
      have hmem : MvPolynomial.X 0 * F ∈ I_nod := Ideal.Quotient.eq_zero_iff_mem.mp hF
      rw [Ideal.mem_span_singleton] at hmem
      obtain ⟨H, hH⟩ := hmem
      let P0_hom : MvPolynomial (Fin 2) ↥R →+* Polynomial ↥R :=
        MvPolynomial.eval₂Hom Polynomial.C ![0, Polynomial.X]
      have hP0 := congrArg P0_hom hH
      simp only [P0_hom, map_mul, map_sub, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C,
        Matrix.cons_val_zero, Matrix.cons_val_one, zero_mul, zero_sub] at hP0
      have hπ_C : (-Polynomial.C π_tilde : Polynomial ↥R) ≠ 0 :=
        neg_ne_zero.mpr (Polynomial.C_ne_zero.mpr hπ_ne)
      have hH0 : P0_hom H = 0 := (mul_eq_zero.mp hP0.symm).resolve_left hπ_C
      obtain ⟨G, hG⟩ := mvPoly_split0 H
      change H = Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.X 1) (P0_hom H) +
        MvPolynomial.X 0 * G at hG
      rw [hH0, map_zero, zero_add] at hG
      rw [hG, ← mul_left_comm] at hH
      have hF_eq : F = (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C π_tilde) * G :=
        mul_left_cancel₀ (MvPolynomial.X_ne_zero (0 : Fin 2)) hH
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton.mpr ⟨G, hF_eq⟩)
    have hu0_reg : ∀ (y : A_nod) (D : ℕ), u0_nod ^ D * y = 0 → y = 0 := by
      intro y D
      induction D with
      | zero => simp
      | succ D ih => rw [pow_succ', mul_assoc]; exact fun h => ih (hu0_reg1 _ h)
    have hClear_u0 : ∀ y : A_nod, ∃ (D : ℕ) (P : Polynomial ↥R), u0_nod ^ D * y = ι0_nod P := by
      intro y
      obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective y
      induction F using MvPolynomial.induction_on with
      | C r =>
        refine ⟨0, Polynomial.C r, ?_⟩
        simp only [pow_zero, one_mul, ι0_nod, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
        rfl
      | add p q ihp ihq =>
        obtain ⟨D₁, P₁, hp⟩ := ihp
        obtain ⟨D₂, P₂, hq⟩ := ihq
        refine ⟨D₁ + D₂, Polynomial.X ^ D₂ * P₁ + Polynomial.X ^ D₁ * P₂, ?_⟩
        have hu0_X : ∀ k : ℕ, ι0_nod (Polynomial.X ^ k) = u0_nod ^ k := fun k => by simp [ι0_nod]
        have hp' : u0_nod ^ D₁ * mk_nod p = ι0_nod P₁ := hp
        have hq' : u0_nod ^ D₂ * mk_nod q = ι0_nod P₂ := hq
        change u0_nod ^ (D₁ + D₂) * mk_nod (p + q) = ι0_nod (Polynomial.X ^ D₂ * P₁ + Polynomial.X ^ D₁ * P₂)
        rw [map_add mk_nod, mul_add, map_add ι0_nod, map_mul ι0_nod, map_mul ι0_nod, hu0_X, hu0_X]
        calc u0_nod ^ (D₁ + D₂) * mk_nod p + u0_nod ^ (D₁ + D₂) * mk_nod q
            = u0_nod ^ D₂ * (u0_nod ^ D₁ * mk_nod p) + u0_nod ^ D₁ * (u0_nod ^ D₂ * mk_nod q) := by
              rw [pow_add]; ring
          _ = u0_nod ^ D₂ * ι0_nod P₁ + u0_nod ^ D₁ * ι0_nod P₂ := by rw [hp', hq']
      | mul_X p i ihp =>
        obtain ⟨D, P, hp⟩ := ihp
        have hp' : u0_nod ^ D * mk_nod p = ι0_nod P := hp
        fin_cases i
        · refine ⟨D, P * Polynomial.X, ?_⟩
          have hX : ι0_nod Polynomial.X = u0_nod := by simp [ι0_nod]
          change u0_nod ^ D * mk_nod (p * MvPolynomial.X 0) = ι0_nod (P * Polynomial.X)
          rw [map_mul mk_nod, map_mul ι0_nod, hX]
          change u0_nod ^ D * (mk_nod p * u0_nod) = ι0_nod P * u0_nod
          rw [← mul_assoc, hp']
        · refine ⟨D + 1, P * Polynomial.C π_tilde, ?_⟩
          calc u0_nod ^ (D + 1) * mk_nod (p * MvPolynomial.X 1)
              = (u0_nod ^ D * mk_nod p) * (u0_nod * u1_nod) := by
                rw [map_mul mk_nod, pow_succ]
                change (u0_nod ^ D * u0_nod) * (mk_nod p * u1_nod) = (u0_nod ^ D * mk_nod p) * (u0_nod * u1_nod)
                ring
            _ = ι0_nod P * c_nod π_tilde := by rw [hp', hu01_nod]
            _ = ι0_nod (P * Polynomial.C π_tilde) := by simp [ι0_nod]
    have hDom_Anod : IsDomain A_nod := by
      let L_X := Localization.Away (Polynomial.X : Polynomial ↥R)
      have hSub_X : Submonoid.powers (Polynomial.X : Polynomial ↥R) ≤ nonZeroDivisors (Polynomial ↥R) := by
        rintro _ ⟨k, rfl⟩
        exact mem_nonZeroDivisors_of_ne_zero (pow_ne_zero k Polynomial.X_ne_zero)
      have _ : IsDomain L_X := IsLocalization.isDomain_localization hSub_X
      have hLX_inj : Function.Injective (algebraMap (Polynomial ↥R) L_X) :=
        IsLocalization.injective L_X hSub_X
      let ev_LX : MvPolynomial (Fin 2) ↥R →+* L_X :=
        MvPolynomial.eval₂Hom ((algebraMap (Polynomial ↥R) L_X).comp Polynomial.C)
          ![algebraMap (Polynomial ↥R) L_X Polynomial.X,
            algebraMap (Polynomial ↥R) L_X (Polynomial.C π_tilde) *
              IsLocalization.Away.invSelf (S := L_X) (Polynomial.X : Polynomial ↥R)]
      have hev_ker : I_nod ≤ RingHom.ker ev_LX := by
        rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
        simp only [ev_LX, map_sub, map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C,
          Matrix.cons_val_zero, Matrix.cons_val_one, RingHom.comp_apply]
        have hmul := IsLocalization.Away.mul_invSelf (S := L_X) (Polynomial.X : Polynomial ↥R)
        linear_combination algebraMap (Polynomial ↥R) L_X (Polynomial.C π_tilde) * hmul
      let α_LX : A_nod →+* L_X := Ideal.Quotient.lift I_nod ev_LX hev_ker
      have hα_ι0 : α_LX.comp ι0_nod = algebraMap (Polynomial ↥R) L_X := by
        apply Polynomial.ringHom_ext
        · intro r
          change α_LX (ι0_nod (Polynomial.C r)) = _
          have h1 : ι0_nod (Polynomial.C r) = mk_nod (MvPolynomial.C r) := by simp [ι0_nod, c_nod]
          rw [h1]
          exact (Ideal.Quotient.lift_mk I_nod ev_LX hev_ker).trans (by simp [ev_LX])
        · change α_LX (ι0_nod Polynomial.X) = _
          have h1 : ι0_nod Polynomial.X = mk_nod (MvPolynomial.X 0) := by simp [ι0_nod, u0_nod]
          rw [h1]
          exact (Ideal.Quotient.lift_mk I_nod ev_LX hev_ker).trans (by simp [ev_LX])
      have hι0_inj : Function.Injective ι0_nod := fun P₁ P₂ hP =>
        hLX_inj ((RingHom.congr_fun hα_ι0 P₁).symm.trans ((congrArg α_LX hP).trans (RingHom.congr_fun hα_ι0 P₂)))
      have _ : Nontrivial A_nod :=
        ⟨1, 0, fun h10 => one_ne_zero (α := L_X) (by simpa using congrArg α_LX h10)⟩
      have _ : NoZeroDivisors A_nod := ⟨fun {x y} hxy => by
        obtain ⟨D₁, P₁, hx⟩ := hClear_u0 x
        obtain ⟨D₂, P₂, hy⟩ := hClear_u0 y
        have hmul : ι0_nod (P₁ * P₂) = 0 := by
          calc ι0_nod (P₁ * P₂) = (u0_nod ^ D₁ * x) * (u0_nod ^ D₂ * y) := by rw [map_mul, hx, hy]
            _ = u0_nod ^ (D₁ + D₂) * (x * y) := by rw [pow_add]; ring
            _ = 0 := by rw [hxy, mul_zero]
        rcases mul_eq_zero.mp (hι0_inj (hmul.trans (map_zero ι0_nod).symm)) with rfl | rfl
        · left; rw [map_zero] at hx; exact hu0_reg x D₁ hx
        · right; rw [map_zero] at hy; exact hu0_reg y D₂ hy⟩
      exact NoZeroDivisors.to_isDomain A_nod
    let _ : IsDomain A_nod := hDom_Anod

    
    let B := Localization.Away h_p
    let u_B := algebraMap (Polynomial ↥R) B (Polynomial.X - Polynomial.C c_tilde)
    let π_B := algebraMap (Polynomial ↥R) B (Polynomial.C π_tilde)
    let h_0 : Polynomial ↥R := h_p.comp (Polynomial.C c_tilde + Polynomial.C π_tilde * Polynomial.X)
    have hh0_eval : ∀ c_val : ↥R, Polynomial.eval c_val h_0 ∉ m_R := by
      intro c_val hc_mem
      apply hh_p_res
      have hev : Polynomial.eval c_val h_0 = Polynomial.eval (c_tilde + π_tilde * c_val) h_p := by
        simp [h_0, Polynomial.eval_comp]
      have hres_ev : res_R (Polynomial.eval (c_tilde + π_tilde * c_val) h_p) =
          res_R (Polynomial.eval c_tilde h_p) := by
        have h1 := Polynomial.hom_eval₂ h_p (RingHom.id ↥R) res_R (c_tilde + π_tilde * c_val)
        have h2 := Polynomial.hom_eval₂ h_p (RingHom.id ↥R) res_R c_tilde
        change res_R (Polynomial.eval₂ (RingHom.id ↥R) (c_tilde + π_tilde * c_val) h_p) =
          res_R (Polynomial.eval₂ (RingHom.id ↥R) c_tilde h_p)
        rw [h1, h2]
        congr 1
        simp [hres_π]
      rw [← hres_ev, ← hev]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr hc_mem
    have hh0_ne : h_0 ≠ 0 := by
      rintro h0
      have hm : Polynomial.eval 0 h_0 ∈ m_R := by rw [h0, Polynomial.eval_zero]; exact m_R.zero_mem
      exact hh0_eval 0 hm
    have hh0X_ne : h_0 * Polynomial.X ≠ 0 := mul_ne_zero hh0_ne Polynomial.X_ne_zero
    let H_1 : MvPolynomial (Fin 2) ↥R :=
      Polynomial.eval₂ MvPolynomial.C (MvPolynomial.C c_tilde + MvPolynomial.X 0) h_p
    let h_1 : A_nod := mk_nod H_1
    let ε_0 : MvPolynomial (Fin 2) ↥R →+* k_R := MvPolynomial.eval₂Hom res_R 0
    have hε0_ker : I_nod ≤ RingHom.ker ε_0 := by
      rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
      simp [ε_0, hres_π]
    let ε_bar0 : A_nod →+* k_R := Ideal.Quotient.lift I_nod ε_0 hε0_ker
    have hε_h1 : ε_bar0 h_1 = res_R (Polynomial.eval c_tilde h_p) := by
      change ε_0 H_1 = res_R (Polynomial.eval₂ (RingHom.id ↥R) c_tilde h_p)
      dsimp only [H_1]
      rw [Polynomial.hom_eval₂, Polynomial.hom_eval₂]
      have hcomp_C : ε_0.comp MvPolynomial.C = res_R.comp (RingHom.id ↥R) := by
        ext r; simp [ε_0]
      have hx : ε_0 (MvPolynomial.C c_tilde + MvPolynomial.X 0) = res_R c_tilde := by
        simp [ε_0]
      rw [hcomp_C, hx]
    have hh1_not_Jmax : h_1 ∉ Ideal.span {u0_nod, u1_nod} ⊔ Ideal.map c_nod m_R := by
      intro hmem
      have hle : Ideal.span {u0_nod, u1_nod} ⊔ Ideal.map c_nod m_R ≤ RingHom.ker ε_bar0 := by
        rw [sup_le_iff, Ideal.span_le, Ideal.map_le_iff_le_comap]
        refine ⟨?_, ?_⟩
        · rintro y (rfl | rfl)
          · change ε_0 (MvPolynomial.X 0) = 0; simp [ε_0]
          · change ε_0 (MvPolynomial.X 1) = 0; simp [ε_0]
        · intro r hr
          change ε_0 (MvPolynomial.C r) = 0
          rw [MvPolynomial.eval₂Hom_C]
          exact Ideal.Quotient.eq_zero_iff_mem.mpr hr
      exact hh_p_res (hε_h1 ▸ hle hmem)
    have hh1_ne : h_1 ≠ 0 := by
      rintro h0
      apply hh_p_res
      rw [← hε_h1, h0, map_zero]
    let C_0 := Localization.Away h_0
    let C_1 := Localization.Away h_1
    let C_01 := Localization.Away (h_0 * Polynomial.X)
    have hSub_B : Submonoid.powers h_p ≤ nonZeroDivisors (Polynomial ↥R) := by
      rintro _ ⟨k, rfl⟩; exact mem_nonZeroDivisors_of_ne_zero (pow_ne_zero k hh_p_ne)
    have hSub_C0 : Submonoid.powers h_0 ≤ nonZeroDivisors (Polynomial ↥R) := by
      rintro _ ⟨k, rfl⟩; exact mem_nonZeroDivisors_of_ne_zero (pow_ne_zero k hh0_ne)
    have hSub_C1 : Submonoid.powers h_1 ≤ nonZeroDivisors A_nod := by
      rintro _ ⟨k, rfl⟩; exact mem_nonZeroDivisors_of_ne_zero (pow_ne_zero k hh1_ne)
    have hSub_C01 : Submonoid.powers (h_0 * Polynomial.X) ≤ nonZeroDivisors (Polynomial ↥R) := by
      rintro _ ⟨k, rfl⟩; exact mem_nonZeroDivisors_of_ne_zero (pow_ne_zero k hh0X_ne)
    have hDom_B : IsDomain B := IsLocalization.isDomain_localization hSub_B
    have hDom_C0 : IsDomain C_0 := IsLocalization.isDomain_localization hSub_C0
    have hDom_C1 : IsDomain C_1 := IsLocalization.isDomain_localization hSub_C1
    have hDom_C01 : IsDomain C_01 := IsLocalization.isDomain_localization hSub_C01
    let _ : IsDomain B := hDom_B
    let _ : IsDomain C_0 := hDom_C0
    let _ : IsDomain C_1 := hDom_C1
    let _ : IsDomain C_01 := hDom_C01
    have hjB_inj : Function.Injective (algebraMap (Polynomial ↥R) B) := IsLocalization.injective B hSub_B
    have hjC0_inj : Function.Injective (algebraMap (Polynomial ↥R) C_0) := IsLocalization.injective C_0 hSub_C0
    have hjC1_inj : Function.Injective (algebraMap A_nod C_1) := IsLocalization.injective C_1 hSub_C1
    have hjC01_inj : Function.Injective (algebraMap (Polynomial ↥R) C_01) := IsLocalization.injective C_01 hSub_C01

    
    let t_0 : C_0 := algebraMap (Polynomial ↥R) C_0 Polynomial.X
    let u_1 : C_1 := algebraMap A_nod C_1 u0_nod
    let s_1 : C_1 := algebraMap A_nod C_1 u1_nod
    let ψ0_poly : Polynomial ↥R →+* C_0 :=
      (algebraMap (Polynomial ↥R) C_0).comp
        (Polynomial.compRingHom (Polynomial.C c_tilde + Polynomial.C π_tilde * Polynomial.X))
    have hψ0_hp_unit : IsUnit (ψ0_poly h_p) := by
      change IsUnit (algebraMap (Polynomial ↥R) C_0 h_0)
      exact IsLocalization.map_units C_0 ⟨h_0, Submonoid.mem_powers h_0⟩
    let ψ_0 : B →+* C_0 := IsLocalization.Away.lift h_p hψ0_hp_unit
    have hψ0_eq : ∀ P : Polynomial ↥R, ψ_0 (algebraMap (Polynomial ↥R) B P) = ψ0_poly P :=
      fun P => IsLocalization.Away.lift_eq h_p hψ0_hp_unit P
    have hψ0_C : ∀ r : ↥R, ψ_0 (algebraMap (Polynomial ↥R) B (Polynomial.C r)) =
        algebraMap (Polynomial ↥R) C_0 (Polynomial.C r) := by
      intro r; rw [hψ0_eq]; simp [ψ0_poly]
    have hψ0_X : ψ_0 (algebraMap (Polynomial ↥R) B Polynomial.X) =
        algebraMap (Polynomial ↥R) C_0 (Polynomial.C c_tilde + Polynomial.C π_tilde * Polynomial.X) := by
      rw [hψ0_eq]; simp [ψ0_poly]
    have hψ0_uB : ψ_0 u_B = ψ_0 π_B * t_0 := by
      dsimp only [u_B, π_B, t_0]
      rw [map_sub (algebraMap (Polynomial ↥R) B), map_sub ψ_0, hψ0_X, hψ0_C c_tilde, hψ0_C π_tilde,
        ← map_mul, ← map_sub]
      congr 1; ring

    let ψ1_poly : Polynomial ↥R →+* C_1 :=
      Polynomial.eval₂RingHom ((algebraMap A_nod C_1).comp c_nod)
        (algebraMap A_nod C_1 (mk_nod (MvPolynomial.C c_tilde + MvPolynomial.X 0)))
    have hψ1_hp_eq : ψ1_poly h_p = algebraMap A_nod C_1 h_1 := by
      change Polynomial.eval₂ ((algebraMap A_nod C_1).comp (mk_nod.comp MvPolynomial.C))
        ((algebraMap A_nod C_1) (mk_nod (MvPolynomial.C c_tilde + MvPolynomial.X 0))) h_p =
        algebraMap A_nod C_1 (mk_nod H_1)
      dsimp only [H_1]
      rw [Polynomial.hom_eval₂, Polynomial.hom_eval₂]
    have hψ1_hp_unit : IsUnit (ψ1_poly h_p) := by
      rw [hψ1_hp_eq]
      exact IsLocalization.map_units C_1 ⟨h_1, Submonoid.mem_powers h_1⟩
    let ψ_1 : B →+* C_1 := IsLocalization.Away.lift h_p hψ1_hp_unit
    have hψ1_eq : ∀ P : Polynomial ↥R, ψ_1 (algebraMap (Polynomial ↥R) B P) = ψ1_poly P :=
      fun P => IsLocalization.Away.lift_eq h_p hψ1_hp_unit P
    have hψ1_C : ∀ r : ↥R, ψ_1 (algebraMap (Polynomial ↥R) B (Polynomial.C r)) =
        algebraMap A_nod C_1 (mk_nod (MvPolynomial.C r)) := by
      intro r; rw [hψ1_eq]; simp [ψ1_poly, c_nod]
    have hψ1_X : ψ_1 (algebraMap (Polynomial ↥R) B Polynomial.X) =
        algebraMap A_nod C_1 (mk_nod (MvPolynomial.C c_tilde + MvPolynomial.X 0)) := by
      rw [hψ1_eq]; simp [ψ1_poly]
    have hψ1_uB : ψ_1 u_B = u_1 := by
      dsimp only [u_B, u_1, u0_nod]
      rw [map_sub (algebraMap (Polynomial ↥R) B), map_sub ψ_1, hψ1_X, hψ1_C c_tilde,
        ← map_sub, ← map_sub]
      congr 2; ring
    have hψ1_πB : ψ_1 π_B = u_1 * s_1 := by
      dsimp only [π_B, u_1, s_1]
      rw [hψ1_C π_tilde, ← map_mul]
      exact congrArg (algebraMap A_nod C_1) hu01_nod.symm

    let u_hp : B := IsLocalization.Away.invSelf (S := B) h_p
    have huhp_mul : algebraMap (Polynomial ↥R) B h_p * u_hp = 1 :=
      IsLocalization.Away.mul_invSelf (S := B) h_p
    have hinv_h0 : IsLocalization.Away.invSelf (S := C_0) h_0 = ψ_0 u_hp := by
      have h1 : algebraMap (Polynomial ↥R) C_0 h_0 * IsLocalization.Away.invSelf (S := C_0) h_0 = 1 :=
        IsLocalization.Away.mul_invSelf (S := C_0) h_0
      have h2 : algebraMap (Polynomial ↥R) C_0 h_0 * ψ_0 u_hp = 1 := by
        have hm := congrArg ψ_0 huhp_mul
        rw [map_mul, map_one, hψ0_eq h_p] at hm
        exact hm
      exact mul_left_cancel₀ ((map_ne_zero_iff _ hjC0_inj).mpr hh0_ne) (h1.trans h2.symm)
    have hinv_h1 : IsLocalization.Away.invSelf (S := C_1) h_1 = ψ_1 u_hp := by
      have h1 : algebraMap A_nod C_1 h_1 * IsLocalization.Away.invSelf (S := C_1) h_1 = 1 :=
        IsLocalization.Away.mul_invSelf (S := C_1) h_1
      have h2 : algebraMap A_nod C_1 h_1 * ψ_1 u_hp = 1 := by
        have hm := congrArg ψ_1 huhp_mul
        rw [map_mul, map_one, hψ1_eq h_p, hψ1_hp_eq] at hm
        exact hm
      exact mul_left_cancel₀ ((map_ne_zero_iff _ hjC1_inj).mpr hh1_ne) (h1.trans h2.symm)

    have hgen0 : Subring.closure (Set.range ψ_0 ∪ {t_0}) = ⊤ := by
      rw [eq_top_iff]
      intro z _
      let S0 := Subring.closure (Set.range ψ_0 ∪ {t_0})
      have hP_mem : ∀ P : Polynomial ↥R, algebraMap (Polynomial ↥R) C_0 P ∈ S0 := by
        intro P
        induction P using Polynomial.induction_on' with
        | add p q hp hq => rw [map_add]; exact S0.add_mem hp hq
        | monomial n r =>
          rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow, ← hψ0_C r]
          exact S0.mul_mem (Subring.subset_closure (Or.inl ⟨_, rfl⟩))
            (S0.pow_mem (Subring.subset_closure (Or.inr rfl)) n)
      obtain ⟨⟨P, ⟨_, k, rfl⟩⟩, hz⟩ := IsLocalization.surj (Submonoid.powers h_0) z
      dsimp only at hz
      have hinv_pow : algebraMap (Polynomial ↥R) C_0 (h_0 ^ k) * (ψ_0 u_hp) ^ k = 1 := by
        rw [map_pow, ← mul_pow, ← hinv_h0, IsLocalization.Away.mul_invSelf, one_pow]
      have hz_eq : z = algebraMap (Polynomial ↥R) C_0 P * (ψ_0 u_hp) ^ k := by
        calc z = z * (algebraMap (Polynomial ↥R) C_0 (h_0 ^ k) * (ψ_0 u_hp) ^ k) := by
              rw [hinv_pow, mul_one]
          _ = (z * algebraMap (Polynomial ↥R) C_0 (h_0 ^ k)) * (ψ_0 u_hp) ^ k := by ring
          _ = algebraMap (Polynomial ↥R) C_0 P * (ψ_0 u_hp) ^ k := by rw [hz]
      rw [hz_eq]
      exact S0.mul_mem (hP_mem P) (S0.pow_mem (Subring.subset_closure (Or.inl ⟨u_hp, rfl⟩)) k)

    have hgen1 : Subring.closure (Set.range ψ_1 ∪ {s_1}) = ⊤ := by
      rw [eq_top_iff]
      intro z _
      let S1 := Subring.closure (Set.range ψ_1 ∪ {s_1})
      have hF_mem : ∀ F : MvPolynomial (Fin 2) ↥R, algebraMap A_nod C_1 (mk_nod F) ∈ S1 := by
        intro F
        induction F using MvPolynomial.induction_on with
        | C r =>
          rw [← hψ1_C r]
          exact Subring.subset_closure (Or.inl ⟨_, rfl⟩)
        | add p q hp hq =>
          rw [map_add, map_add]
          exact S1.add_mem hp hq
        | mul_X p i hp =>
          rw [map_mul, map_mul]
          refine S1.mul_mem hp ?_
          fin_cases i
          · change u_1 ∈ S1
            rw [← hψ1_uB]
            exact Subring.subset_closure (Or.inl ⟨u_B, rfl⟩)
          · exact Subring.subset_closure (Or.inr rfl)
      obtain ⟨⟨y, ⟨_, k, rfl⟩⟩, hz⟩ := IsLocalization.surj (Submonoid.powers h_1) z
      obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective y
      dsimp only at hz
      have hinv_pow : algebraMap A_nod C_1 (h_1 ^ k) * (ψ_1 u_hp) ^ k = 1 := by
        rw [map_pow, ← mul_pow, ← hinv_h1, IsLocalization.Away.mul_invSelf, one_pow]
      have hz_eq : z = algebraMap A_nod C_1 (mk_nod F) * (ψ_1 u_hp) ^ k := by
        calc z = z * (algebraMap A_nod C_1 (h_1 ^ k) * (ψ_1 u_hp) ^ k) := by rw [hinv_pow, mul_one]
          _ = (z * algebraMap A_nod C_1 (h_1 ^ k)) * (ψ_1 u_hp) ^ k := by ring
          _ = algebraMap A_nod C_1 (mk_nod F) * (ψ_1 u_hp) ^ k := by rw [hz]
      rw [hz_eq]
      exact S1.mul_mem (hF_mem F) (S1.pow_mem (Subring.subset_closure (Or.inl ⟨u_hp, rfl⟩)) k)

    
    let j_01 := algebraMap (Polynomial ↥R) C_01
    let w_inv : C_01 := IsLocalization.Away.invSelf (S := C_01) (h_0 * Polynomial.X)
    have hw_mul : j_01 (h_0 * Polynomial.X) * w_inv = 1 :=
      IsLocalization.Away.mul_invSelf (S := C_01) (h_0 * Polynomial.X)
    let h0_inv01 : C_01 := j_01 Polynomial.X * w_inv
    let x_inv01 : C_01 := j_01 h_0 * w_inv
    have hh0_mul01 : j_01 h_0 * h0_inv01 = 1 := by
      calc j_01 h_0 * (j_01 Polynomial.X * w_inv)
          = (j_01 h_0 * j_01 Polynomial.X) * w_inv := by ring
        _ = j_01 (h_0 * Polynomial.X) * w_inv := by rw [← map_mul]
        _ = 1 := hw_mul
    have hx_mul01 : j_01 Polynomial.X * x_inv01 = 1 := by
      calc j_01 Polynomial.X * (j_01 h_0 * w_inv)
          = (j_01 h_0 * j_01 Polynomial.X) * w_inv := by ring
        _ = j_01 (h_0 * Polynomial.X) * w_inv := by rw [← map_mul]
        _ = 1 := hw_mul
    have hh0_unit01 : IsUnit (j_01 h_0) := IsUnit.of_mul_eq_one h0_inv01 hh0_mul01
    let f_01 : C_0 →+* C_01 := IsLocalization.Away.lift h_0 hh0_unit01
    have hf01_eq : ∀ P : Polynomial ↥R, f_01 (algebraMap (Polynomial ↥R) C_0 P) = j_01 P :=
      fun P => IsLocalization.Away.lift_eq h_0 hh0_unit01 P
    have hf01_inj : Function.Injective f_01 := by
      rw [RingHom.injective_iff_ker_eq_bot, eq_bot_iff]
      intro x hx
      rw [RingHom.mem_ker] at hx
      obtain ⟨⟨P, ⟨_, k, rfl⟩⟩, hxk⟩ := IsLocalization.surj (Submonoid.powers h_0) x
      dsimp only at hxk
      have hP0 : j_01 P = 0 := by
        have hm := congrArg f_01 hxk
        rw [map_mul, hx, zero_mul, hf01_eq P] at hm
        exact hm.symm
      have hP_eq : P = 0 := hjC01_inj (hP0.trans (map_zero j_01).symm)
      rw [hP_eq, map_zero] at hxk
      exact (mul_eq_zero.mp hxk).resolve_right ((map_ne_zero_iff _ hjC0_inj).mpr (pow_ne_zero k hh0_ne))
    have hloc_f01 : @IsLocalization.Away C_0 _ t_0 C_01 _ f_01.toAlgebra := by
      let _ : Algebra C_0 C_01 := f_01.toAlgebra
      refine { map_units := ?_, surj := ?_, exists_of_eq := ?_ }
      · rintro ⟨_, k, rfl⟩
        change IsUnit (f_01 (t_0 ^ k))
        rw [map_pow, hf01_eq Polynomial.X]
        exact (IsUnit.of_mul_eq_one x_inv01 hx_mul01).pow k
      · intro z
        obtain ⟨⟨P, ⟨_, k, rfl⟩⟩, hz⟩ := IsLocalization.surj (Submonoid.powers (h_0 * Polynomial.X)) z
        dsimp only at hz
        refine ⟨⟨algebraMap (Polynomial ↥R) C_0 P * (IsLocalization.Away.invSelf (S := C_0) h_0) ^ k,
          ⟨t_0 ^ k, ⟨k, rfl⟩⟩⟩, ?_⟩
        change z * f_01 (t_0 ^ k) =
          f_01 (algebraMap (Polynomial ↥R) C_0 P * (IsLocalization.Away.invSelf (S := C_0) h_0) ^ k)
        have hh0_inv_eq : f_01 (algebraMap (Polynomial ↥R) C_0 h_0) *
            f_01 (IsLocalization.Away.invSelf (S := C_0) h_0) = 1 := by
          rw [← map_mul, IsLocalization.Away.mul_invSelf, map_one]
        have hh0_pow_eq : (j_01 h_0) ^ k * (f_01 (IsLocalization.Away.invSelf (S := C_0) h_0)) ^ k = 1 := by
          rw [← hf01_eq h_0, ← mul_pow, hh0_inv_eq, one_pow]
        rw [map_mul, map_pow, map_pow, hf01_eq P, hf01_eq Polynomial.X]
        calc z * (j_01 Polynomial.X) ^ k
            = z * (j_01 Polynomial.X) ^ k *
                ((j_01 h_0) ^ k * (f_01 (IsLocalization.Away.invSelf (S := C_0) h_0)) ^ k) := by
              rw [hh0_pow_eq, mul_one]
          _ = (z * j_01 ((h_0 * Polynomial.X) ^ k)) *
                (f_01 (IsLocalization.Away.invSelf (S := C_0) h_0)) ^ k := by
              rw [mul_pow, map_mul, map_pow, map_pow]; ring
          _ = j_01 P * (f_01 (IsLocalization.Away.invSelf (S := C_0) h_0)) ^ k := by rw [hz]
      · intro x y hxy
        exact ⟨⟨1, Submonoid.one_mem _⟩, by rw [hf01_inj hxy]⟩

    let α_10 : MvPolynomial (Fin 2) ↥R →+* C_01 :=
      MvPolynomial.eval₂Hom (j_01.comp Polynomial.C)
        ![j_01 (Polynomial.C π_tilde * Polynomial.X), x_inv01]
    have hα10_ker : I_nod ≤ RingHom.ker α_10 := by
      rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
      simp only [α_10, map_sub, map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C,
        Matrix.cons_val_zero, Matrix.cons_val_one, RingHom.comp_apply]
      linear_combination j_01 (Polynomial.C π_tilde) * hx_mul01
    let α_bar10 : A_nod →+* C_01 := Ideal.Quotient.lift I_nod α_10 hα10_ker
    have hα10_h1 : α_bar10 h_1 = j_01 h_0 := by
      change α_10 H_1 = j_01 (h_p.comp (Polynomial.C c_tilde + Polynomial.C π_tilde * Polynomial.X))
      dsimp only [H_1]
      rw [Polynomial.hom_eval₂, Polynomial.comp_eq_aeval]
      change Polynomial.eval₂ (α_10.comp MvPolynomial.C)
        (α_10 (MvPolynomial.C c_tilde + MvPolynomial.X 0)) h_p =
        j_01 (Polynomial.eval₂ Polynomial.C (Polynomial.C c_tilde + Polynomial.C π_tilde * Polynomial.X) h_p)
      rw [Polynomial.hom_eval₂]
      have hc : α_10.comp MvPolynomial.C = j_01.comp Polynomial.C := by
        ext r; simp [α_10]
      have hx : α_10 (MvPolynomial.C c_tilde + MvPolynomial.X 0) =
          j_01 (Polynomial.C c_tilde + Polynomial.C π_tilde * Polynomial.X) := by
        simp [α_10]
      rw [hc, hx]
    have hα10_unit : IsUnit (α_bar10 h_1) := hα10_h1 ▸ hh0_unit01
    let f_10 : C_1 →+* C_01 := IsLocalization.Away.lift h_1 hα10_unit
    have hf10_eq : ∀ y : A_nod, f_10 (algebraMap A_nod C_1 y) = α_bar10 y :=
      fun y => IsLocalization.Away.lift_eq h_1 hα10_unit y
    have hf10_C : ∀ r : ↥R, f_10 (algebraMap A_nod C_1 (mk_nod (MvPolynomial.C r))) =
        j_01 (Polynomial.C r) := by
      intro r
      rw [hf10_eq]
      exact (Ideal.Quotient.lift_mk I_nod α_10 hα10_ker).trans (by simp [α_10])
    have hf10_u1 : f_10 u_1 = j_01 (Polynomial.C π_tilde * Polynomial.X) := by
      dsimp only [u_1, u0_nod]
      rw [hf10_eq]
      exact (Ideal.Quotient.lift_mk I_nod α_10 hα10_ker).trans (by simp [α_10])
    have hf10_s1 : f_10 s_1 = x_inv01 := by
      dsimp only [s_1, u1_nod]
      rw [hf10_eq]
      exact (Ideal.Quotient.lift_mk I_nod α_10 hα10_ker).trans (by simp [α_10])
    have hf_inv : f_01 t_0 * f_10 s_1 = 1 := by
      rw [hf01_eq Polynomial.X, hf10_s1]; exact hx_mul01
    have hX_s1_inv : j_01 Polynomial.X * f_10 s_1 = 1 := by
      rw [hf10_s1]; exact hx_mul01
    have hf_comp : f_01.comp ψ_0 = f_10.comp ψ_1 := by
      apply IsLocalization.ringHom_ext (Submonoid.powers h_p)
      apply Polynomial.ringHom_ext
      · intro r
        change f_01 (ψ_0 (algebraMap (Polynomial ↥R) B (Polynomial.C r))) =
          f_10 (ψ_1 (algebraMap (Polynomial ↥R) B (Polynomial.C r)))
        rw [hψ0_C r, hf01_eq, hψ1_C r, hf10_C r]
      · change f_01 (ψ_0 (algebraMap (Polynomial ↥R) B Polynomial.X)) =
          f_10 (ψ_1 (algebraMap (Polynomial ↥R) B Polynomial.X))
        rw [hψ0_X, hf01_eq, hψ1_X, map_add mk_nod, map_add (algebraMap A_nod C_1), map_add f_10,
          hf10_C c_tilde]
        change j_01 (Polynomial.C c_tilde + Polynomial.C π_tilde * Polynomial.X) =
          j_01 (Polynomial.C c_tilde) + f_10 u_1
        rw [hf10_u1, map_add]
    have hf10_inj : Function.Injective f_10 := by
      have hα_inj : ∀ y : A_nod, α_bar10 y = 0 → y = 0 := by
        intro y hy0
        obtain ⟨D, P, hP⟩ := hClear_u0 y
        have hα_ι0 : α_bar10.comp ι0_nod =
            j_01.comp (Polynomial.compRingHom (Polynomial.C π_tilde * Polynomial.X)) := by
          apply Polynomial.ringHom_ext
          · intro r
            change α_bar10 (ι0_nod (Polynomial.C r)) = _
            have h1 : ι0_nod (Polynomial.C r) = mk_nod (MvPolynomial.C r) := by simp [ι0_nod, c_nod]
            rw [h1]
            exact (Ideal.Quotient.lift_mk I_nod α_10 hα10_ker).trans (by simp [α_10])
          · change α_bar10 (ι0_nod Polynomial.X) = _
            have h1 : ι0_nod Polynomial.X = mk_nod (MvPolynomial.X 0) := by simp [ι0_nod, u0_nod]
            rw [h1]
            exact (Ideal.Quotient.lift_mk I_nod α_10 hα10_ker).trans (by simp [α_10])
        have hcomp0 : j_01 (P.comp (Polynomial.C π_tilde * Polynomial.X)) = 0 := by
          have hm := congrArg α_bar10 hP
          rw [map_mul, hy0, mul_zero] at hm
          have hr := RingHom.congr_fun hα_ι0 P
          exact hr.symm.trans hm.symm
        have hP_comp0 : P.comp (Polynomial.C π_tilde * Polynomial.X) = 0 :=
          hjC01_inj (hcomp0.trans (map_zero j_01).symm)
        have hP_eq0 : P = 0 := by
          apply Polynomial.ext
          intro k
          rw [Polynomial.coeff_zero]
          have hck : (P.comp (Polynomial.C π_tilde * Polynomial.X)).coeff k =
              P.coeff k * π_tilde ^ k := by
            conv_lhs => rw [P.as_sum_support_C_mul_X_pow]
            rw [Polynomial.sum_comp, Polynomial.finsetSum_coeff]
            have hterm : ∀ i ∈ P.support,
                ((Polynomial.C (P.coeff i) * Polynomial.X ^ i).comp
                  (Polynomial.C π_tilde * Polynomial.X)).coeff k =
                if k = i then P.coeff i * π_tilde ^ i else 0 := by
              intro i _
              rw [Polynomial.mul_comp, Polynomial.C_comp, Polynomial.pow_comp, Polynomial.X_comp,
                mul_pow, ← Polynomial.C_pow, ← mul_assoc, ← Polynomial.C_mul,
                Polynomial.coeff_C_mul_X_pow]
            rw [Finset.sum_congr rfl hterm, Finset.sum_ite_eq P.support k]
            by_cases hk : k ∈ P.support
            · simp [hk]
            · simp [hk, Polynomial.notMem_support_iff.mp hk]
          rw [hP_comp0, Polynomial.coeff_zero] at hck
          exact (mul_eq_zero.mp hck.symm).resolve_right (pow_ne_zero k hπ_ne)
        rw [hP_eq0, map_zero] at hP
        exact hu0_reg y D hP
      rw [RingHom.injective_iff_ker_eq_bot, eq_bot_iff]
      intro x hx
      rw [RingHom.mem_ker] at hx
      obtain ⟨⟨y, ⟨_, k, rfl⟩⟩, hxk⟩ := IsLocalization.surj (Submonoid.powers h_1) x
      dsimp only at hxk
      have hy0 : α_bar10 y = 0 := by
        have hm := congrArg f_10 hxk
        rw [map_mul, hx, zero_mul, hf10_eq y] at hm
        exact hm.symm
      rw [hα_inj y hy0, map_zero] at hxk
      exact (mul_eq_zero.mp hxk).resolve_right ((map_ne_zero_iff _ hjC1_inj).mpr (pow_ne_zero k hh1_ne))

    have hloc_f10 : @IsLocalization.Away C_1 _ s_1 C_01 _ f_10.toAlgebra := by
      let _ : Algebra C_1 C_01 := f_10.toAlgebra
      refine { map_units := ?_, surj := ?_, exists_of_eq := ?_ }
      · rintro ⟨_, k, rfl⟩
        change IsUnit (f_10 (s_1 ^ k))
        rw [map_pow]
        exact (IsUnit.of_mul_eq_one_right (f_01 t_0) hf_inv).pow k
      · intro z
        have hP_surj : ∀ P : Polynomial ↥R, ∃ (d : ℕ) (w : C_1), j_01 P * f_10 (s_1 ^ d) = f_10 w := by
          intro P
          induction P using Polynomial.induction_on' with
          | add p q ihp ihq =>
            obtain ⟨d₁, w₁, hp⟩ := ihp
            obtain ⟨d₂, w₂, hq⟩ := ihq
            refine ⟨d₁ + d₂, w₁ * s_1 ^ d₂ + w₂ * s_1 ^ d₁, ?_⟩
            rw [map_add, add_mul, pow_add, map_mul f_10 (s_1 ^ d₁), map_add, map_mul, map_mul]
            calc j_01 p * (f_10 (s_1 ^ d₁) * f_10 (s_1 ^ d₂)) +
                  j_01 q * (f_10 (s_1 ^ d₁) * f_10 (s_1 ^ d₂))
                = (j_01 p * f_10 (s_1 ^ d₁)) * f_10 (s_1 ^ d₂) +
                  (j_01 q * f_10 (s_1 ^ d₂)) * f_10 (s_1 ^ d₁) := by ring
              _ = f_10 w₁ * f_10 (s_1 ^ d₂) + f_10 w₂ * f_10 (s_1 ^ d₁) := by rw [hp, hq]
          | monomial n r =>
            refine ⟨n, algebraMap A_nod C_1 (mk_nod (MvPolynomial.C r)), ?_⟩
            rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow, map_pow, hf10_C r, mul_assoc,
              ← mul_pow, hX_s1_inv, one_pow, mul_one]
        obtain ⟨⟨P, ⟨_, k, rfl⟩⟩, hz⟩ := IsLocalization.surj (Submonoid.powers (h_0 * Polynomial.X)) z
        dsimp only at hz
        obtain ⟨d, w, hw⟩ := hP_surj P
        let inv_h1 : C_1 := IsLocalization.Away.invSelf (S := C_1) h_1
        have hwinv_eq : j_01 ((h_0 * Polynomial.X) ^ k) * f_10 ((inv_h1 * s_1) ^ k) = 1 := by
          rw [map_pow, map_pow, ← mul_pow]
          have h1 : j_01 (h_0 * Polynomial.X) * f_10 (inv_h1 * s_1) = 1 := by
            rw [map_mul, map_mul, ← hα10_h1, ← hf10_eq h_1]
            have hh1_inv : f_10 (algebraMap A_nod C_1 h_1) * f_10 inv_h1 = 1 := by
              rw [← map_mul, IsLocalization.Away.mul_invSelf, map_one]
            calc (f_10 (algebraMap A_nod C_1 h_1) * j_01 Polynomial.X) * (f_10 inv_h1 * f_10 s_1)
                = (f_10 (algebraMap A_nod C_1 h_1) * f_10 inv_h1) *
                    (j_01 Polynomial.X * f_10 s_1) := by ring
              _ = 1 * 1 := by rw [hh1_inv, hX_s1_inv]
              _ = 1 := one_mul 1
          rw [h1, one_pow]
        refine ⟨⟨w * (inv_h1 * s_1) ^ k, ⟨s_1 ^ d, ⟨d, rfl⟩⟩⟩, ?_⟩
        change z * f_10 (s_1 ^ d) = f_10 (w * (inv_h1 * s_1) ^ k)
        rw [map_mul]
        calc z * f_10 (s_1 ^ d)
            = z * (j_01 ((h_0 * Polynomial.X) ^ k) * f_10 ((inv_h1 * s_1) ^ k)) * f_10 (s_1 ^ d) := by
              rw [hwinv_eq, mul_one]
          _ = (z * j_01 ((h_0 * Polynomial.X) ^ k)) * f_10 (s_1 ^ d) * f_10 ((inv_h1 * s_1) ^ k) := by ring
          _ = f_10 w * f_10 ((inv_h1 * s_1) ^ k) := by rw [hz, hw]
      · intro x y hxy
        exact ⟨⟨1, Submonoid.one_mem _⟩, by rw [hf10_inj hxy]⟩

    
    let L_π := Localization.Away π_B
    let j_π := algebraMap B L_π
    let inv_π : L_π := IsLocalization.Away.invSelf (S := L_π) π_B
    have hπ_mul : j_π π_B * inv_π = 1 := IsLocalization.Away.mul_invSelf (S := L_π) π_B
    let α_π : Polynomial ↥R →+* L_π :=
      Polynomial.eval₂RingHom (j_π.comp ((algebraMap (Polynomial ↥R) B).comp Polynomial.C))
        (j_π u_B * inv_π)
    have hαπ_shift : α_π (Polynomial.C c_tilde + Polynomial.C π_tilde * Polynomial.X) =
        j_π (algebraMap (Polynomial ↥R) B Polynomial.X) := by
      simp only [α_π, map_add, map_mul, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C,
        Polynomial.eval₂_X, RingHom.comp_apply]
      have h1 : j_π (algebraMap (Polynomial ↥R) B (Polynomial.C π_tilde)) * (j_π u_B * inv_π) =
          j_π u_B := by
        change j_π π_B * (j_π u_B * inv_π) = j_π u_B
        calc j_π π_B * (j_π u_B * inv_π) = j_π u_B * (j_π π_B * inv_π) := by ring
          _ = j_π u_B := by rw [hπ_mul, mul_one]
      rw [h1]
      dsimp only [u_B]
      rw [← map_add, ← map_add]
      congr 2; ring
    have hαπ_comp : ∀ P : Polynomial ↥R,
        α_π (P.comp (Polynomial.C c_tilde + Polynomial.C π_tilde * Polynomial.X)) =
          j_π (algebraMap (Polynomial ↥R) B P) := by
      intro P
      induction P using Polynomial.induction_on' with
      | add p q hp hq => rw [Polynomial.add_comp, map_add, hp, hq, ← map_add, ← map_add]
      | monomial n r =>
        rw [← Polynomial.C_mul_X_pow_eq_monomial, Polynomial.mul_comp, Polynomial.C_comp,
          Polynomial.pow_comp, Polynomial.X_comp, map_mul, map_pow, hαπ_shift]
        simp [α_π]
    have hαπ_h0_unit : IsUnit (α_π h_0) := by
      rw [hαπ_comp h_p]
      exact RingHom.isUnit_map j_π (IsLocalization.map_units B ⟨h_p, Submonoid.mem_powers h_p⟩)
    let ψ_π : C_0 →+* L_π := IsLocalization.Away.lift h_0 hαπ_h0_unit
    have hψπ_eq : ∀ P : Polynomial ↥R, ψ_π (algebraMap (Polynomial ↥R) C_0 P) = α_π P :=
      fun P => IsLocalization.Away.lift_eq h_0 hαπ_h0_unit P
    have hψπ_comp : ψ_π.comp ψ_0 = j_π := by
      apply IsLocalization.ringHom_ext (Submonoid.powers h_p)
      apply RingHom.ext
      intro P
      change ψ_π (ψ_0 (algebraMap (Polynomial ↥R) B P)) = j_π (algebraMap (Polynomial ↥R) B P)
      rw [hψ0_eq P]
      change ψ_π (algebraMap (Polynomial ↥R) C_0 (P.comp _)) = _
      rw [hψπ_eq, hαπ_comp P]
    have hloc_ψπ : @IsLocalization.Away C_0 _ (ψ_0 π_B) L_π _ ψ_π.toAlgebra := by
      let _ : Algebra C_0 L_π := ψ_π.toAlgebra
      have hπB_ne : π_B ≠ 0 := (map_ne_zero_iff _ hjB_inj).mpr (Polynomial.C_ne_zero.mpr hπ_ne)
      have hSub_πB : Submonoid.powers π_B ≤ nonZeroDivisors B := by
        rintro _ ⟨k, rfl⟩; exact mem_nonZeroDivisors_of_ne_zero (pow_ne_zero k hπB_ne)
      have hjπ_inj : Function.Injective j_π := IsLocalization.injective L_π hSub_πB
      refine { map_units := ?_, surj := ?_, exists_of_eq := ?_ }
      · rintro ⟨_, k, rfl⟩
        change IsUnit (ψ_π ((ψ_0 π_B) ^ k))
        rw [map_pow]
        have h1 : ψ_π (ψ_0 π_B) = j_π π_B := RingHom.congr_fun hψπ_comp π_B
        rw [h1]
        exact (IsLocalization.map_units L_π ⟨π_B, Submonoid.mem_powers π_B⟩).pow k
      · intro z
        obtain ⟨⟨b, ⟨_, k, rfl⟩⟩, hz⟩ := IsLocalization.surj (Submonoid.powers π_B) z
        dsimp only at hz
        refine ⟨⟨ψ_0 b, ⟨(ψ_0 π_B) ^ k, ⟨k, rfl⟩⟩⟩, ?_⟩
        change z * ψ_π ((ψ_0 π_B) ^ k) = ψ_π (ψ_0 b)
        have hb : ψ_π (ψ_0 b) = j_π b := RingHom.congr_fun hψπ_comp b
        have hπk : ψ_π ((ψ_0 π_B) ^ k) = j_π (π_B ^ k) := by
          rw [← map_pow ψ_0]
          exact RingHom.congr_fun hψπ_comp (π_B ^ k)
        rw [hb, hπk, hz]
      · intro x y hxy
        suffices hinj : ∀ w : C_0, ψ_π w = 0 → w = 0 by
          have hw : x - y = 0 := hinj (x - y) (by rw [map_sub]; exact sub_eq_zero.mpr hxy)
          exact ⟨⟨1, Submonoid.one_mem _⟩, by rw [sub_eq_zero.mp hw]⟩
        intro w hw0
        obtain ⟨⟨Q, ⟨_, k, rfl⟩⟩, hwk⟩ := IsLocalization.surj (Submonoid.powers h_0) w
        dsimp only at hwk
        have hQ_clear : ∀ P : Polynomial ↥R, ∃ (d : ℕ) (b : B),
            (ψ_0 π_B) ^ d * algebraMap (Polynomial ↥R) C_0 P = ψ_0 b := by
          intro P
          induction P using Polynomial.induction_on' with
          | add p q ihp ihq =>
            obtain ⟨d₁, b₁, hp⟩ := ihp
            obtain ⟨d₂, b₂, hq⟩ := ihq
            refine ⟨d₁ + d₂, π_B ^ d₂ * b₁ + π_B ^ d₁ * b₂, ?_⟩
            rw [map_add, map_add, map_mul, map_mul, map_pow, map_pow, mul_add]
            calc (ψ_0 π_B) ^ (d₁ + d₂) * algebraMap (Polynomial ↥R) C_0 p +
                  (ψ_0 π_B) ^ (d₁ + d₂) * algebraMap (Polynomial ↥R) C_0 q
                = (ψ_0 π_B) ^ d₂ * ((ψ_0 π_B) ^ d₁ * algebraMap (Polynomial ↥R) C_0 p) +
                  (ψ_0 π_B) ^ d₁ * ((ψ_0 π_B) ^ d₂ * algebraMap (Polynomial ↥R) C_0 q) := by
                  rw [pow_add]; ring
              _ = (ψ_0 π_B) ^ d₂ * ψ_0 b₁ + (ψ_0 π_B) ^ d₁ * ψ_0 b₂ := by rw [hp, hq]
          | monomial n r =>
            refine ⟨n, algebraMap (Polynomial ↥R) B (Polynomial.C r) * u_B ^ n, ?_⟩
            rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow, ← hψ0_C r,
              map_mul ψ_0, map_pow ψ_0, hψ0_uB, mul_pow]
            change (ψ_0 π_B) ^ n * (ψ_0 (algebraMap (Polynomial ↥R) B (Polynomial.C r)) * t_0 ^ n) = _
            ring
        obtain ⟨d, b, hb⟩ := hQ_clear Q
        have hjb0 : j_π b = 0 := by
          rw [← RingHom.congr_fun hψπ_comp b]
          change ψ_π (ψ_0 b) = 0
          rw [← hb, ← hwk]
          have hm : ψ_π ((ψ_0 π_B) ^ d * (w * algebraMap (Polynomial ↥R) C_0 (h_0 ^ k))) = 0 := by
            rw [map_mul, map_mul, hw0, zero_mul, mul_zero]
          exact hm
        have hb0 : b = 0 := hjπ_inj (hjb0.trans (map_zero j_π).symm)
        rw [hb0, map_zero, ← hwk] at hb
        have hπ0_ne : (ψ_0 π_B) ^ d ≠ 0 := by
          rw [hψ0_C π_tilde]
          exact pow_ne_zero d ((map_ne_zero_iff _ hjC0_inj).mpr (Polynomial.C_ne_zero.mpr hπ_ne))
        have hwk0 : w * algebraMap (Polynomial ↥R) C_0 (h_0 ^ k) = 0 :=
          (mul_eq_zero.mp hb).resolve_left hπ0_ne
        exact (mul_eq_zero.mp hwk0).resolve_right ((map_ne_zero_iff _ hjC0_inj).mpr (pow_ne_zero k hh0_ne))

    let L_u := Localization.Away u_B
    let j_u := algebraMap B L_u
    let inv_u : L_u := IsLocalization.Away.invSelf (S := L_u) u_B
    have hu_mul : j_u u_B * inv_u = 1 := IsLocalization.Away.mul_invSelf (S := L_u) u_B
    let α_u0 : MvPolynomial (Fin 2) ↥R →+* L_u :=
      MvPolynomial.eval₂Hom (j_u.comp ((algebraMap (Polynomial ↥R) B).comp Polynomial.C))
        ![j_u u_B, j_u π_B * inv_u]
    have hαu0_ker : I_nod ≤ RingHom.ker α_u0 := by
      rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
      simp only [α_u0, map_sub, map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C,
        Matrix.cons_val_zero, Matrix.cons_val_one, RingHom.comp_apply]
      change j_u u_B * (j_u π_B * inv_u) - j_u π_B = 0
      linear_combination j_u π_B * hu_mul
    let α_u : A_nod →+* L_u := Ideal.Quotient.lift I_nod α_u0 hαu0_ker
    have hαu_h1 : α_u h_1 = j_u (algebraMap (Polynomial ↥R) B h_p) := by
      change α_u0 H_1 = j_u (algebraMap (Polynomial ↥R) B h_p)
      dsimp only [H_1]
      rw [Polynomial.hom_eval₂]
      have hc : α_u0.comp MvPolynomial.C = j_u.comp ((algebraMap (Polynomial ↥R) B).comp Polynomial.C) := by
        ext r; simp [α_u0]
      have hx : α_u0 (MvPolynomial.C c_tilde + MvPolynomial.X 0) =
          j_u (algebraMap (Polynomial ↥R) B Polynomial.X) := by
        simp only [α_u0, map_add, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X',
          Matrix.cons_val_zero, RingHom.comp_apply, u_B]
        rw [← map_add, ← map_add]
        congr 2; ring
      rw [hc, hx]
      have h_id : Polynomial.eval₂ (j_u.comp ((algebraMap (Polynomial ↥R) B).comp Polynomial.C))
          (j_u (algebraMap (Polynomial ↥R) B Polynomial.X)) h_p =
          j_u (algebraMap (Polynomial ↥R) B (Polynomial.eval₂ Polynomial.C Polynomial.X h_p)) := by
        rw [Polynomial.hom_eval₂, Polynomial.hom_eval₂]
      rw [h_id, Polynomial.eval₂_C_X]
    have hαu_h1_unit : IsUnit (α_u h_1) := by
      rw [hαu_h1]
      exact RingHom.isUnit_map j_u (IsLocalization.map_units B ⟨h_p, Submonoid.mem_powers h_p⟩)
    let ψ_u : C_1 →+* L_u := IsLocalization.Away.lift h_1 hαu_h1_unit
    have hψu_eq : ∀ y : A_nod, ψ_u (algebraMap A_nod C_1 y) = α_u y :=
      fun y => IsLocalization.Away.lift_eq h_1 hαu_h1_unit y
    have hψu_comp : ψ_u.comp ψ_1 = j_u := by
      apply IsLocalization.ringHom_ext (Submonoid.powers h_p)
      apply Polynomial.ringHom_ext
      · intro r
        change ψ_u (ψ_1 (algebraMap (Polynomial ↥R) B (Polynomial.C r))) =
          j_u (algebraMap (Polynomial ↥R) B (Polynomial.C r))
        rw [hψ1_C r, hψu_eq]
        exact (Ideal.Quotient.lift_mk I_nod α_u0 hαu0_ker).trans (by simp [α_u0])
      · change ψ_u (ψ_1 (algebraMap (Polynomial ↥R) B Polynomial.X)) =
          j_u (algebraMap (Polynomial ↥R) B Polynomial.X)
        rw [hψ1_X, hψu_eq]
        change α_u0 (MvPolynomial.C c_tilde + MvPolynomial.X 0) = _
        simp only [α_u0, map_add, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X',
          Matrix.cons_val_zero, RingHom.comp_apply, u_B]
        rw [← map_add, ← map_add]; congr 2; ring
    have hloc_ψu : @IsLocalization.Away C_1 _ (ψ_1 u_B) L_u _ ψ_u.toAlgebra := by
      let _ : Algebra C_1 L_u := ψ_u.toAlgebra
      have huB_ne : u_B ≠ 0 := (map_ne_zero_iff _ hjB_inj).mpr (Polynomial.X_sub_C_ne_zero c_tilde)
      have hSub_uB : Submonoid.powers u_B ≤ nonZeroDivisors B := by
        rintro _ ⟨k, rfl⟩; exact mem_nonZeroDivisors_of_ne_zero (pow_ne_zero k huB_ne)
      have hju_inj : Function.Injective j_u := IsLocalization.injective L_u hSub_uB
      refine { map_units := ?_, surj := ?_, exists_of_eq := ?_ }
      · rintro ⟨_, k, rfl⟩
        change IsUnit (ψ_u ((ψ_1 u_B) ^ k))
        rw [map_pow]
        have h1 : ψ_u (ψ_1 u_B) = j_u u_B := RingHom.congr_fun hψu_comp u_B
        rw [h1]
        exact (IsLocalization.map_units L_u ⟨u_B, Submonoid.mem_powers u_B⟩).pow k
      · intro z
        obtain ⟨⟨b, ⟨_, k, rfl⟩⟩, hz⟩ := IsLocalization.surj (Submonoid.powers u_B) z
        dsimp only at hz
        refine ⟨⟨ψ_1 b, ⟨(ψ_1 u_B) ^ k, ⟨k, rfl⟩⟩⟩, ?_⟩
        change z * ψ_u ((ψ_1 u_B) ^ k) = ψ_u (ψ_1 b)
        have hb : ψ_u (ψ_1 b) = j_u b := RingHom.congr_fun hψu_comp b
        have huk : ψ_u ((ψ_1 u_B) ^ k) = j_u (u_B ^ k) := by
          rw [← map_pow ψ_1]
          exact RingHom.congr_fun hψu_comp (u_B ^ k)
        rw [hb, huk, hz]
      · intro x y hxy
        suffices hinj : ∀ w : C_1, ψ_u w = 0 → w = 0 by
          have hw : x - y = 0 := hinj (x - y) (by rw [map_sub]; exact sub_eq_zero.mpr hxy)
          exact ⟨⟨1, Submonoid.one_mem _⟩, by rw [sub_eq_zero.mp hw]⟩
        intro w hw0
        obtain ⟨⟨y0, ⟨_, k, rfl⟩⟩, hwk⟩ := IsLocalization.surj (Submonoid.powers h_1) w
        dsimp only at hwk
        obtain ⟨D, P, hP⟩ := hClear_u0 y0
        have hι0_ψ1 : ∀ Q : Polynomial ↥R,
            algebraMap A_nod C_1 (ι0_nod Q) =
              ψ_1 (algebraMap (Polynomial ↥R) B (Q.comp (Polynomial.X - Polynomial.C c_tilde))) := by
          intro Q
          induction Q using Polynomial.induction_on' with
          | add p q hp hq =>
            rw [map_add, map_add, hp, hq, Polynomial.add_comp, map_add, map_add]
          | monomial n r =>
            rw [← Polynomial.C_mul_X_pow_eq_monomial, Polynomial.mul_comp, Polynomial.C_comp,
              Polynomial.pow_comp, Polynomial.X_comp, map_mul, map_pow, map_mul, map_pow,
              map_mul, map_mul, map_pow, map_pow]
            have hc : algebraMap A_nod C_1 (ι0_nod (Polynomial.C r)) =
                ψ_1 (algebraMap (Polynomial ↥R) B (Polynomial.C r)) := by
              rw [hψ1_C r]; simp [ι0_nod, c_nod]
            have hx : algebraMap A_nod C_1 (ι0_nod Polynomial.X) = ψ_1 u_B := by
              rw [hψ1_uB]; simp [ι0_nod, u_1]
            rw [hc, hx]
        let b : B := algebraMap (Polynomial ↥R) B (P.comp (Polynomial.X - Polynomial.C c_tilde))
        have hb : (ψ_1 u_B) ^ D * algebraMap A_nod C_1 y0 = ψ_1 b := by
          rw [hψ1_uB]
          calc u_1 ^ D * algebraMap A_nod C_1 y0
              = algebraMap A_nod C_1 (u0_nod ^ D * y0) := by rw [map_mul, map_pow]
            _ = algebraMap A_nod C_1 (ι0_nod P) := by rw [hP]
            _ = ψ_1 b := hι0_ψ1 P
        have hjb0 : j_u b = 0 := by
          rw [← RingHom.congr_fun hψu_comp b]
          change ψ_u (ψ_1 b) = 0
          rw [← hb, ← hwk]
          have hm : ψ_u ((ψ_1 u_B) ^ D * (w * algebraMap A_nod C_1 (h_1 ^ k))) = 0 := by
            rw [map_mul, map_mul, hw0, zero_mul, mul_zero]
          exact hm
        have hb0 : b = 0 := hju_inj (hjb0.trans (map_zero j_u).symm)
        rw [hb0, map_zero, ← hwk] at hb
        have hu1_ne : (ψ_1 u_B) ^ D ≠ 0 := by
          rw [hψ1_uB]
          exact pow_ne_zero D ((map_ne_zero_iff _ hjC1_inj).mpr (fun h0 =>
            one_ne_zero (α := A_nod) (hu0_reg 1 1 (by rw [pow_one, mul_one, h0]))))
        have hwk0 : w * algebraMap A_nod C_1 (h_1 ^ k) = 0 :=
          (mul_eq_zero.mp hb).resolve_left hu1_ne
        exact (mul_eq_zero.mp hwk0).resolve_right ((map_ne_zero_iff _ hjC1_inj).mpr (pow_ne_zero k hh1_ne))

    
    let g_poly := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : ↥R →+* Polynomial ↥R))
    have hSm_poly : AlgebraicGeometry.SmoothOfRelativeDimension 1 g_poly := by
      have h1 : Algebra.IsStandardSmoothOfRelativeDimension 1 ↥R (MvPolynomial (Fin 1) ↥R) := by
        simpa using Algebra.IsStandardSmoothOfRelativeDimension.mvPolynomial ↥R (Fin 1)
      have h2 : Algebra.IsStandardSmoothOfRelativeDimension 1 ↥R (Polynomial ↥R) :=
        Algebra.IsStandardSmoothOfRelativeDimension.of_algEquiv 1
          (MvPolynomial.uniqueAlgEquiv ↥R (Fin 1))
      rw [AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.SmoothOfRelativeDimension 1)]
      change RingHom.Locally (RingHom.IsStandardSmoothOfRelativeDimension 1)
        (algebraMap ↥R (Polynomial ↥R))
      rw [RingHom.locally_iff_finite]
      refine ⟨{1}, by simp, fun t ht => ?_⟩
      have ht1 : t = 1 := Finset.mem_singleton.mp ht
      subst ht1
      let e1 : Polynomial ↥R ≃ₐ[Polynomial ↥R] Localization.Away (1 : Polynomial ↥R) :=
        IsLocalization.atOne (Polynomial ↥R) (Localization.Away (1 : Polynomial ↥R))
      have h3 : Algebra.IsStandardSmoothOfRelativeDimension 1 ↥R
          (Localization.Away (1 : Polynomial ↥R)) :=
        Algebra.IsStandardSmoothOfRelativeDimension.of_algEquiv 1 (e1.restrictScalars ↥R)
      exact (RingHom.isStandardSmoothOfRelativeDimension_algebraMap 1).mpr h3
    have hSm_gB : AlgebraicGeometry.SmoothOfRelativeDimension 1
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          ((algebraMap (Polynomial ↥R) B).comp Polynomial.C))) := by
      have hfac : AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          ((algebraMap (Polynomial ↥R) B).comp Polynomial.C)) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial ↥R) B)) ≫ g_poly := by
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      rw [hfac]
      have _ : AlgebraicGeometry.IsOpenImmersion
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial ↥R) B))) :=
        AlgebraicGeometry.IsOpenImmersion.of_isLocalization h_p
      have _ : AlgebraicGeometry.SmoothOfRelativeDimension 0
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial ↥R) B))) :=
        inferInstance
      have h01 : AlgebraicGeometry.SmoothOfRelativeDimension (0 + 1)
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial ↥R) B)) ≫ g_poly) :=
        inferInstance
      simpa using h01

    have hFlat_poly : AlgebraicGeometry.Flat g_poly := by
      apply (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Flat)).mpr
      change (algebraMap ↥R (Polynomial ↥R)).Flat
      rw [RingHom.flat_algebraMap_iff]
      infer_instance
    have hLfp_poly : AlgebraicGeometry.LocallyOfFinitePresentation g_poly := by
      apply (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFinitePresentation)).mpr
      change (algebraMap ↥R (Polynomial ↥R)).FinitePresentation
      rw [RingHom.finitePresentation_algebraMap]
      exact Algebra.FinitePresentation.polynomial ↥R ↥R
    have _ : AlgebraicGeometry.IsOpenImmersion
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial ↥R) C_0))) :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization h_0
    have hFlat_g0 : AlgebraicGeometry.Flat
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((algebraMap (Polynomial ↥R) C_0).comp Polynomial.C))) := by
      have hfac : AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((algebraMap (Polynomial ↥R) C_0).comp Polynomial.C)) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial ↥R) C_0)) ≫ g_poly := by
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      rw [hfac]; infer_instance
    have hLfp_g0 : AlgebraicGeometry.LocallyOfFinitePresentation
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((algebraMap (Polynomial ↥R) C_0).comp Polynomial.C))) := by
      have hfac : AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((algebraMap (Polynomial ↥R) C_0).comp Polynomial.C)) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial ↥R) C_0)) ≫ g_poly := by
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      rw [hfac]; infer_instance

    let g_Anod := AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_nod)
    have hFlat_Anod : AlgebraicGeometry.Flat g_Anod := by
      apply (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Flat)).mpr
      change (algebraMap ↥R A_nod).Flat
      rw [RingHom.flat_algebraMap_iff, Module.Flat.flat_iff_torsion_eq_bot_of_isBezout, eq_bot_iff]
      intro y hy
      rw [Submodule.mem_torsion_iff] at hy
      obtain ⟨⟨r, hr_nzd⟩, hry⟩ := hy
      have hr_ne : r ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hr_nzd
      rw [Submonoid.mk_smul, Algebra.smul_def] at hry
      change c_nod r * y = 0 at hry
      let ret0 : MvPolynomial (Fin 2) ↥R →+* ↥R :=
        MvPolynomial.eval₂Hom (RingHom.id ↥R) ![π_tilde, 1]
      have hret_ker : I_nod ≤ RingHom.ker ret0 := by
        rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
        simp [ret0]
      let ret : A_nod →+* ↥R := Ideal.Quotient.lift I_nod ret0 hret_ker
      have hcr_ne : c_nod r ≠ 0 := by
        intro h0
        have hrr : ret (c_nod r) = r :=
          (Ideal.Quotient.lift_mk I_nod ret0 hret_ker).trans (by simp [ret0])
        rw [h0, map_zero] at hrr
        exact hr_ne hrr.symm
      exact (mul_eq_zero.mp hry).resolve_left hcr_ne
    have hLfp_Anod : AlgebraicGeometry.LocallyOfFinitePresentation g_Anod := by
      apply (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFinitePresentation)).mpr
      have hfp_C : (MvPolynomial.C : ↥R →+* MvPolynomial (Fin 2) ↥R).FinitePresentation := by
        rw [← MvPolynomial.algebraMap_eq, RingHom.finitePresentation_algebraMap]
        exact Algebra.FinitePresentation.mvPolynomial ↥R ↥R (Fin 2)
      have hfp_mk : mk_nod.FinitePresentation := by
        refine RingHom.FinitePresentation.of_surjective mk_nod Ideal.Quotient.mk_surjective ?_
        rw [Ideal.mk_ker]
        exact Submodule.fg_span_singleton _
      exact RingHom.FinitePresentation.comp hfp_mk hfp_C
    have _ : AlgebraicGeometry.IsOpenImmersion
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A_nod C_1))) :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization h_1
    have hFlat_g1 : AlgebraicGeometry.Flat
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((algebraMap A_nod C_1).comp c_nod))) := by
      have hfac : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((algebraMap A_nod C_1).comp c_nod)) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A_nod C_1)) ≫ g_Anod := by
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      rw [hfac]; infer_instance
    have hLfp_g1 : AlgebraicGeometry.LocallyOfFinitePresentation
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((algebraMap A_nod C_1).comp c_nod))) := by
      have hfac : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((algebraMap A_nod C_1).comp c_nod)) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A_nod C_1)) ≫ g_Anod := by
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      rw [hfac]; infer_instance

    exact ⟨Q₀_R, h_1, ψ_0, ψ_1, f_01, f_10, ψ_π, ψ_u,
      rfl, hJ0_ne_bot, hπ_J0, hJ0_le_mR, hh0_eval, hh1_not_Jmax, rfl,
      hDom_B, hDom_C0, hDom_C1, hDom_C01,
      hψ0_C, hψ0_X, hψ1_C, hψ1_X, hψ0_uB, hψ1_uB, hψ1_πB,
      hgen0, hgen1, hloc_f01, hloc_f10, hf01_inj, hf10_inj, hf_comp, hf_inv,
      hf01_eq, hf10_C, hf10_u1, hX_s1_inv,
      hψπ_comp, hloc_ψπ, hψu_comp, hloc_ψu,
      hSm_gB, hFlat_g0, hLfp_g0, hFlat_g1, hLfp_g1⟩

  classical
  intro h_p c_tilde π_tilde hh_p hπ_ne hπ_mem
  dsimp only
  obtain ⟨Q₀_R, h_1, ψ_0, ψ_1, f_01, f_10, ψ_π, ψ_u,
    hQ0_eq, hQ0_ne_bot, hπ_Q0, hQ0_le_mR, hh0_eval, hh1_not_Jmax, hh1_def,
    hDom_B, hDom_C0, hDom_C1, hDom_C01,
    hψ0_C, hψ0_X, hψ1_C, hψ1_X, hψ0_uB, hψ1_uB, hψ1_πB,
    hgen0, hgen1, hloc_f01, hloc_f10, hf01_inj, hf10_inj, hf_comp, hf_inv,
    hf01_eq, hf10_C, hf10_u1, hX_s1_inv,
    hψπ_comp, hloc_ψπ, hψu_comp, hloc_ψu,
    hSm_gB, hFlat_g0, hLfp_g0, hFlat_g1, hLfp_g1⟩ :=
    h_1_3 h_p c_tilde π_tilde hh_p hπ_ne hπ_mem
  clear h_1_3

  let m_R : Ideal ↥R := IsLocalRing.maximalIdeal ↥R
  have hmR_max : m_R.IsMaximal := IsLocalRing.maximalIdeal.isMaximal ↥R
  let _ : m_R.IsMaximal := hmR_max
  let k_R : Type u := ↥R ⧸ m_R
  let _ : Field k_R := Ideal.Quotient.field m_R
  let res_R : ↥R →+* k_R := Ideal.Quotient.mk m_R
  have hres_π : res_R π_tilde = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hπ_mem
  have hh_p_unit : IsUnit (Polynomial.eval c_tilde h_p) :=
    IsLocalRing.notMem_maximalIdeal.mp hh_p
  have hh_p_res : res_R (Polynomial.eval c_tilde h_p) ≠ 0 :=
    fun h0 => hh_p (Ideal.Quotient.eq_zero_iff_mem.mp h0)

  let B := Localization.Away h_p
  let g_B : AlgebraicGeometry.Spec (CommRingCat.of B) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of ↥R) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom
      ((algebraMap (Polynomial ↥R) B).comp Polynomial.C))
  let h_0 : Polynomial ↥R :=
    h_p.comp (Polynomial.C c_tilde + Polynomial.C π_tilde * Polynomial.X)
  let u_B := algebraMap (Polynomial ↥R) B (Polynomial.X - Polynomial.C c_tilde)
  let π_B := algebraMap (Polynomial ↥R) B (Polynomial.C π_tilde)
  let I_nod := weilNodalIdeal ↥R π_tilde
  let A_nod := weilNodalQuot ↥R π_tilde
  let mk_nod : MvPolynomial (Fin 2) ↥R →+* A_nod := Ideal.Quotient.mk I_nod
  let c_nod : ↥R →+* A_nod := mk_nod.comp MvPolynomial.C
  let C_0 := Localization.Away h_0
  let C_1 := Localization.Away h_1
  let C_01 := Localization.Away (h_0 * Polynomial.X)
  let t_0 := algebraMap (Polynomial ↥R) C_0 Polynomial.X
  let u_1 := algebraMap A_nod C_1 (mk_nod (MvPolynomial.X 0))
  let s_1 := algebraMap A_nod C_1 (mk_nod (MvPolynomial.X 1))
  let _ : IsDomain B := hDom_B
  let _ : IsDomain C_0 := hDom_C0
  let _ : IsDomain C_1 := hDom_C1
  let _ : IsDomain C_01 := hDom_C01

  
  let f_01_spec : AlgebraicGeometry.Spec (CommRingCat.of C_01) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of C_0) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_01)
  let f_10_spec : AlgebraicGeometry.Spec (CommRingCat.of C_01) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of C_1) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_10)
  have hOpen_f01 : AlgebraicGeometry.IsOpenImmersion f_01_spec := by
    let _ : Algebra C_0 C_01 := f_01.toAlgebra
    have _ := hloc_f01
    exact AlgebraicGeometry.IsOpenImmersion.of_isLocalization t_0
  have hOpen_f10 : AlgebraicGeometry.IsOpenImmersion f_10_spec := by
    let _ : Algebra C_1 C_01 := f_10.toAlgebra
    have _ := hloc_f10
    exact AlgebraicGeometry.IsOpenImmersion.of_isLocalization s_1
  let U_fn : ULift.{u} Bool → AlgebraicGeometry.Scheme.{u}
    | ⟨false⟩ => AlgebraicGeometry.Spec (CommRingCat.of C_0)
    | ⟨true⟩ => AlgebraicGeometry.Spec (CommRingCat.of C_1)
  let f_fn : ∀ (i j : ULift.{u} Bool), i ≠ j →
      (AlgebraicGeometry.Spec (CommRingCat.of C_01) ⟶ U_fn i)
    | ⟨false⟩, ⟨true⟩, _ => f_01_spec
    | ⟨true⟩, ⟨false⟩, _ => f_10_spec
    | ⟨false⟩, ⟨false⟩, h => (h rfl).elim
    | ⟨true⟩, ⟨true⟩, h => (h rfl).elim
  have hf_open_neq : ∀ (i j : ULift.{u} Bool) (h : i ≠ j),
      AlgebraicGeometry.IsOpenImmersion (f_fn i j h) := by
    rintro ⟨_ | _⟩ ⟨_ | _⟩ h
    · exact (h rfl).elim
    · exact hOpen_f01
    · exact hOpen_f10
    · exact (h rfl).elim
  have hf_mono : ∀ (i j : ULift.{u} Bool) (h : i ≠ j), CategoryTheory.Mono (f_fn i j h) := by
    intro i j h; have _ := hf_open_neq i j h; exact inferInstance
  let D' : CategoryTheory.GlueData' AlgebraicGeometry.Scheme.{u} :=
    { J := ULift.{u} Bool
      U := U_fn
      V := fun _ _ _ => AlgebraicGeometry.Spec (CommRingCat.of C_01)
      f := f_fn
      f_mono := hf_mono
      f_hasPullback := fun _ _ _ _ _ => inferInstance
      t := fun _ _ _ => 𝟙 _
      t_inv := fun _ _ _ => CategoryTheory.Category.id_comp _
      t' := fun i j k hij hik hjk => by
        rcases i with ⟨_ | _⟩ <;> rcases j with ⟨_ | _⟩ <;> rcases k with ⟨_ | _⟩ <;>
          exfalso <;> first | exact hij rfl | exact hik rfl | exact hjk rfl
      t_fac := fun i j k hij hik hjk => by
        rcases i with ⟨_ | _⟩ <;> rcases j with ⟨_ | _⟩ <;> rcases k with ⟨_ | _⟩ <;>
          exfalso <;> first | exact hij rfl | exact hik rfl | exact hjk rfl
      cocycle := fun i j k hij hik hjk => by
        rcases i with ⟨_ | _⟩ <;> rcases j with ⟨_ | _⟩ <;> rcases k with ⟨_ | _⟩ <;>
          exfalso <;> first | exact hij rfl | exact hik rfl | exact hjk rfl }
  let D : AlgebraicGeometry.Scheme.GlueData :=
    { toGlueData := CategoryTheory.GlueData.ofGlueData' D'
      f_open := by
        intro i j
        dsimp only [CategoryTheory.GlueData.ofGlueData']
        split_ifs with h
        · subst h; exact inferInstance
        · have _ := hf_open_neq i j h; exact inferInstance }
  have _ : CategoryTheory.Limits.HasMulticoequalizer D.toGlueData.diagram :=
    AlgebraicGeometry.Scheme.GlueData.instHasMulticoequalizerDiagram D
  let U_bl : AlgebraicGeometry.Scheme.{u} := D.glued
  let ι_0 : AlgebraicGeometry.Spec (CommRingCat.of C_0) ⟶ U_bl := D.ι ⟨false⟩
  let ι_1 : AlgebraicGeometry.Spec (CommRingCat.of C_1) ⟶ U_bl := D.ι ⟨true⟩
  have hOpen_ι0 : AlgebraicGeometry.IsOpenImmersion ι_0 := D.ι_isOpenImmersion ⟨false⟩
  have hOpen_ι1 : AlgebraicGeometry.IsOpenImmersion ι_1 := D.ι_isOpenImmersion ⟨true⟩
  let _ : AlgebraicGeometry.IsOpenImmersion ι_0 := hOpen_ι0
  let _ : AlgebraicGeometry.IsOpenImmersion ι_1 := hOpen_ι1
  have hCov_or : ∀ y : ↥U_bl, y ∈ Set.range ι_0.base ∨ y ∈ Set.range ι_1.base := by
    intro y
    have hcov_top : (⨆ i : D.openCover.I₀, (D.openCover.f i).opensRange) = ⊤ :=
      (AlgebraicGeometry.Scheme.OpenCover.isOpenCover_opensRange D.openCover).iSup_eq_top
    have hmem : y ∈ (⨆ i : D.openCover.I₀, (D.openCover.f i).opensRange : U_bl.Opens) := by
      rw [hcov_top]; trivial
    rw [TopologicalSpace.Opens.mem_iSup] at hmem
    rcases hmem with ⟨⟨_ | _⟩, hy⟩
    · left; exact hy
    · right; exact hy
  have hCov_union : Set.range ι_0.base ∪ Set.range ι_1.base = Set.univ :=
    Set.eq_univ_of_forall hCov_or
  have hne01 : (⟨false⟩ : ULift.{u} Bool) ≠ ⟨true⟩ := by simp
  have hne10 : (⟨true⟩ : ULift.{u} Bool) ≠ ⟨false⟩ := by simp
  have hf01_D : D.f ⟨false⟩ ⟨true⟩ = eqToHom (if_neg hne01) ≫ f_01_spec := by
    dsimp only [D, CategoryTheory.GlueData.ofGlueData', CategoryTheory.GlueData'.f']
    exact dif_neg hne01
  have hf10_D : D.f ⟨true⟩ ⟨false⟩ = eqToHom (if_neg hne10) ≫ f_10_spec := by
    dsimp only [D, CategoryTheory.GlueData.ofGlueData', CategoryTheory.GlueData'.f']
    exact dif_neg hne10
  have ht01_D : D.t ⟨false⟩ ⟨true⟩ =
      eqToHom (if_neg hne01) ≫ 𝟙 _ ≫ eqToHom (if_neg hne10).symm := by
    dsimp only [D, CategoryTheory.GlueData.ofGlueData']; exact dif_neg hne01
  have ht10_D : D.t ⟨true⟩ ⟨false⟩ =
      eqToHom (if_neg hne10) ≫ 𝟙 _ ≫ eqToHom (if_neg hne01).symm := by
    dsimp only [D, CategoryTheory.GlueData.ofGlueData']; exact dif_neg hne10
  have ht_diag_D : ∀ i : ULift.{u} Bool, D.t i i = 𝟙 _ := fun i => by
    dsimp only [D, CategoryTheory.GlueData.ofGlueData']; exact dif_pos rfl
  have ht01_f10 : D.t ⟨false⟩ ⟨true⟩ ≫ D.f ⟨true⟩ ⟨false⟩ =
      eqToHom (if_neg hne01) ≫ f_10_spec := by
    rw [ht01_D, hf10_D]
    erw [CategoryTheory.Category.id_comp, ← CategoryTheory.Category.assoc,
      CategoryTheory.eqToHom_trans, CategoryTheory.eqToHom_trans]
    rfl
  have ht10_f01 : D.t ⟨true⟩ ⟨false⟩ ≫ D.f ⟨false⟩ ⟨true⟩ =
      eqToHom (if_neg hne10) ≫ f_01_spec := by
    rw [ht10_D, hf01_D]
    erw [CategoryTheory.Category.id_comp, ← CategoryTheory.Category.assoc,
      CategoryTheory.eqToHom_trans, CategoryTheory.eqToHom_trans]
    rfl
  have hGlue : f_01_spec ≫ ι_0 = f_10_spec ≫ ι_1 := by
    have hgc := D.glue_condition ⟨false⟩ ⟨true⟩
    erw [← CategoryTheory.Category.assoc, ht01_f10, hf01_D,
      CategoryTheory.Category.assoc, CategoryTheory.Category.assoc] at hgc
    exact ((CategoryTheory.cancel_epi (eqToHom (if_neg hne01))).mp hgc).symm

  let p_chart : ∀ i : D.J, D.U i ⟶ AlgebraicGeometry.Spec (CommRingCat.of B)
    | ⟨false⟩ => AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_0)
    | ⟨true⟩ => AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_1)
  have hp_ov : f_01_spec ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_0) =
      f_10_spec ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_1) := by
    dsimp only [f_01_spec, f_10_spec]
    rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hf_comp]
  let p_bl : U_bl ⟶ AlgebraicGeometry.Spec (CommRingCat.of B) :=
    CategoryTheory.Limits.Multicoequalizer.desc D.toGlueData.diagram _ p_chart (by
      rintro ⟨⟨_ | _⟩, ⟨_ | _⟩⟩
      · change D.f ⟨false⟩ ⟨false⟩ ≫ p_chart ⟨false⟩ =
          (D.t ⟨false⟩ ⟨false⟩ ≫ D.f ⟨false⟩ ⟨false⟩) ≫ p_chart ⟨false⟩
        rw [ht_diag_D ⟨false⟩, CategoryTheory.Category.id_comp]
      · change D.f ⟨false⟩ ⟨true⟩ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_0) =
          (D.t ⟨false⟩ ⟨true⟩ ≫ D.f ⟨true⟩ ⟨false⟩) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_1)
        rw [hf01_D, ht01_f10]
        erw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hp_ov]
        rfl
      · change D.f ⟨true⟩ ⟨false⟩ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_1) =
          (D.t ⟨true⟩ ⟨false⟩ ≫ D.f ⟨false⟩ ⟨true⟩) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_0)
        rw [hf10_D, ht10_f01]
        erw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hp_ov]
        rfl
      · change D.f ⟨true⟩ ⟨true⟩ ≫ p_chart ⟨true⟩ =
          (D.t ⟨true⟩ ⟨true⟩ ≫ D.f ⟨true⟩ ⟨true⟩) ≫ p_chart ⟨true⟩
        rw [ht_diag_D ⟨true⟩, CategoryTheory.Category.id_comp])
  have hι0_p : ι_0 ≫ p_bl = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_0) :=
    CategoryTheory.Limits.Multicoequalizer.π_desc D.toGlueData.diagram _ p_chart _ ⟨false⟩
  have hι1_p : ι_1 ≫ p_bl = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_1) :=
    CategoryTheory.Limits.Multicoequalizer.π_desc D.toGlueData.diagram _ p_chart _ ⟨true⟩
  let g_Ubl := p_bl ≫ g_B

  
  have hι0_g : ι_0 ≫ g_Ubl = AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom ((algebraMap (Polynomial ↥R) C_0).comp Polynomial.C)) := by
    change (ι_0 ≫ p_bl) ≫ g_B = _
    rw [hι0_p]
    dsimp only [g_B]
    rw [← AlgebraicGeometry.Spec.map_comp]
    congr 1; apply CommRingCat.hom_ext; ext r
    exact hψ0_C r
  have hι1_g : ι_1 ≫ g_Ubl = AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom ((algebraMap A_nod C_1).comp c_nod)) := by
    change (ι_1 ≫ p_bl) ≫ g_B = _
    rw [hι1_p]
    dsimp only [g_B]
    rw [← AlgebraicGeometry.Spec.map_comp]
    congr 1; apply CommRingCat.hom_ext; ext r
    exact hψ1_C r
  have hFlat_Ubl : AlgebraicGeometry.Flat g_Ubl := by
    have _ : AlgebraicGeometry.IsZariskiLocalAtSource (@AlgebraicGeometry.Flat.{u}) :=
      AlgebraicGeometry.HasRingHomProperty.instIsZariskiLocalAtSource
        (P := @AlgebraicGeometry.Flat.{u}) (Q := @RingHom.Flat)
    refine AlgebraicGeometry.IsZariskiLocalAtSource.of_openCover
      (P := @AlgebraicGeometry.Flat.{u}) D.openCover ?_
    rintro ⟨_ | _⟩
    · change AlgebraicGeometry.Flat (ι_0 ≫ g_Ubl); rw [hι0_g]; exact hFlat_g0
    · change AlgebraicGeometry.Flat (ι_1 ≫ g_Ubl); rw [hι1_g]; exact hFlat_g1
  have hLfp_Ubl : AlgebraicGeometry.LocallyOfFinitePresentation g_Ubl := by
    have _ : AlgebraicGeometry.IsZariskiLocalAtSource (@AlgebraicGeometry.LocallyOfFinitePresentation.{u}) :=
      AlgebraicGeometry.HasRingHomProperty.instIsZariskiLocalAtSource
        (P := @AlgebraicGeometry.LocallyOfFinitePresentation.{u}) (Q := @RingHom.FinitePresentation)
    refine AlgebraicGeometry.IsZariskiLocalAtSource.of_openCover
      (P := @AlgebraicGeometry.LocallyOfFinitePresentation.{u}) D.openCover ?_
    rintro ⟨_ | _⟩
    · change AlgebraicGeometry.LocallyOfFinitePresentation (ι_0 ≫ g_Ubl); rw [hι0_g]; exact hLfp_g0
    · change AlgebraicGeometry.LocallyOfFinitePresentation (ι_1 ≫ g_Ubl); rw [hι1_g]; exact hLfp_g1
  have hInt_Ubl : AlgebraicGeometry.IsIntegral U_bl := by
    have _ : ∀ i : D.openCover.I₀, AlgebraicGeometry.IsReduced (D.openCover.X i) := by
      rintro ⟨_ | _⟩
      · change AlgebraicGeometry.IsReduced (AlgebraicGeometry.Spec (CommRingCat.of C_0)); infer_instance
      · change AlgebraicGeometry.IsReduced (AlgebraicGeometry.Spec (CommRingCat.of C_1)); infer_instance
    have _ : AlgebraicGeometry.IsReduced U_bl := AlgebraicGeometry.IsReduced.of_openCover U_bl D.openCover
    let η_0 : PrimeSpectrum C_0 := ⊥
    let η_1 : PrimeSpectrum C_1 := ⊥
    let η_01 : PrimeSpectrum C_01 := ⊥
    have hf01_η : f_01_spec.base η_01 = η_0 :=
      PrimeSpectrum.ext ((RingHom.injective_iff_ker_eq_bot f_01).mp hf01_inj)
    have hf10_η : f_10_spec.base η_01 = η_1 :=
      PrimeSpectrum.ext ((RingHom.injective_iff_ker_eq_bot f_10).mp hf10_inj)
    have hη_eq : ι_0.base η_0 = ι_1.base η_1 := by
      rw [← hf01_η, ← hf10_η]
      exact congrArg (fun h => h.base η_01) hGlue
