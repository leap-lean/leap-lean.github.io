        · obtain ⟨hcov', hnot_pc⟩ := (hHasse_iff_B x' y').mp hcov
          have hnot_pair : ¬ ((x' = i'_p ∨ x' = i'_c) ∧ (y' = i'_p ∨ y' = i'_c)) := by
            rintro ⟨hx_pc | hx_pc, hy_pc | hy_pc⟩
            · exact hcov'.1 (hx_pc.trans hy_pc.symm)
            · exact hnot_pc.elim (fun h => h hx_pc) (fun h => h hy_pc)
            · exact hNot_cp x' y' hcov' hx_pc hy_pc
            · exact hcov'.1 (hx_pc.trans hy_pc.symm)
          obtain ⟨q_xy, ⟨hqx, hqy⟩, hq_uniq⟩ := hHasse_B' x' y' hcov'
          have hpt_not_Mod : fst'_R.base q_xy ∉ Mod_qM := by
            intro hMod
            have h_in : fst'_R.base q_xy ∈
                Mod_qM ∩ {x : ↥M' | (g'_M.base x).asIdeal = IsLocalRing.maximalIdeal ↥R} :=
              ⟨hMod, hSub_S' x' ⟨q_xy, hqx, rfl⟩⟩
            rw [hMod_inter, Set.mem_singleton_iff] at h_in
            change fst'_R.base q_xy = z_new_M at h_in
            have hmem_x : z_new_M ∈ fst'_R.base '' (B'_comp x') := ⟨q_xy, hqx, h_in⟩
            have hmem_y : z_new_M ∈ fst'_R.base '' (B'_comp y') := ⟨q_xy, hqy, h_in⟩
            exact hnot_pair ⟨(hz_new_comp x').mp hmem_x, (hz_new_comp y').mp hmem_y⟩
          let u_xy : ↥U_compl := ⟨fst'_R.base q_xy, hpt_not_Mod⟩
          refine ⟨j_2.base u_xy, ?_, ?_⟩
          · constructor
            · change u_xy ∈ j_2.base ⁻¹' (B_set (i_Z.succAbove x'))
              rw [hj2_succ]; exact ⟨q_xy, hqx, rfl⟩
            · change u_xy ∈ j_2.base ⁻¹' (B_set (i_Z.succAbove y'))
              rw [hj2_succ]; exact ⟨q_xy, hqy, rfl⟩
          · rintro y ⟨hyx, hyy⟩
            have hy_u : y ∈ Set.range j_1.base ∪ Set.range j_2.base := hCov_j12 ▸ Set.mem_univ y
            rcases hy_u with ⟨u, rfl⟩ | ⟨v, rfl⟩
