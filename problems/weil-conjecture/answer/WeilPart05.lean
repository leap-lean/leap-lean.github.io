  have finset_val_div : ∀ {L : Type u} [Field L] (V : ValuationSubring L)
      (S : Finset ↥V), S.Nonempty → ∃ c₀ ∈ S, ∀ c ∈ S, ∃ q : ↥V, c = c₀ * q := by
    intro L _ V S hS
    induction hS using Finset.Nonempty.cons_induction with
    | singleton a =>
      exact ⟨a, Finset.mem_singleton_self a, fun c hc =>
        ⟨1, by rw [Finset.mem_singleton.mp hc, mul_one]⟩⟩
    | cons a T haT hT ih =>
      obtain ⟨c₁, hc₁T, hdiv₁⟩ := ih
      by_cases ha0 : a = 0
      · refine ⟨c₁, Finset.mem_cons_of_mem hc₁T, fun c hc => ?_⟩
        rcases Finset.mem_cons.mp hc with rfl | hcT
        · exact ⟨0, by rw [ha0, mul_zero]⟩
        · exact hdiv₁ c hcT
      · by_cases hc₁0 : c₁ = 0
        · refine ⟨a, Finset.mem_cons_self a T, fun c hc => ?_⟩
          rcases Finset.mem_cons.mp hc with rfl | hcT
          · exact ⟨1, (mul_one c).symm⟩
          · obtain ⟨q, hq⟩ := hdiv₁ c hcT
            exact ⟨0, by rw [hq, hc₁0, zero_mul, mul_zero]⟩
        · have ha_val : (a : L) ≠ 0 := fun h => ha0 (Subtype.ext h)
          have hc₁_val : (c₁ : L) ≠ 0 := fun h => hc₁0 (Subtype.ext h)
          rcases V.mem_or_inv_mem ((c₁ : L) * (a : L)⁻¹) with hmem | hmem_inv
          · let q₀ : ↥V := ⟨(c₁ : L) * (a : L)⁻¹, hmem⟩
            have haq : a * q₀ = c₁ := Subtype.ext (by
              change (a : L) * ((c₁ : L) * (a : L)⁻¹) = (c₁ : L)
              rw [mul_comm, inv_mul_cancel_right₀ ha_val])
            refine ⟨a, Finset.mem_cons_self a T, fun c hc => ?_⟩
            rcases Finset.mem_cons.mp hc with rfl | hcT
            · exact ⟨1, (mul_one c).symm⟩
            · obtain ⟨q, rfl⟩ := hdiv₁ c hcT
              exact ⟨q₀ * q, by rw [← mul_assoc, haq]⟩
          · have hmem' : (a : L) * (c₁ : L)⁻¹ ∈ V := by
              have heq : ((c₁ : L) * (a : L)⁻¹)⁻¹ = (a : L) * (c₁ : L)⁻¹ := by
                rw [mul_inv_rev, inv_inv]
              rwa [← heq]
            let q₀ : ↥V := ⟨(a : L) * (c₁ : L)⁻¹, hmem'⟩
            have hcq : c₁ * q₀ = a := Subtype.ext (by
              change (c₁ : L) * ((a : L) * (c₁ : L)⁻¹) = (a : L)
              rw [mul_comm, inv_mul_cancel_right₀ hc₁_val])
            refine ⟨c₁, Finset.mem_cons_of_mem hc₁T, fun c hc => ?_⟩
            rcases Finset.mem_cons.mp hc with rfl | hcT
            · exact ⟨q₀, hcq.symm⟩
            · exact hdiv₁ c hcT
  
  have hStep3 :
      ∀ (B : Type u) [CommRing B] [IsDomain B] [IsIntegrallyClosed B]
        (φ_B : B →+* F), @IsFractionRing B _ F _ φ_B.toAlgebra →
        ∀ (α₀ : Polynomial ↥R →+* B), α₀.Etale →
        ∀ (P : Ideal B), P.IsPrime →
        (∀ P_T : Polynomial ↥R,
          α₀ P_T ∈ P ↔ ∀ i : ℕ, P_T.coeff i ∈ IsLocalRing.maximalIdeal ↥R) →
        ∀ (W₀ : ValuationSubring F) (hW_mem : ∀ b : B, φ_B b ∈ W₀),
        (∀ b : B, (⟨φ_B b, hW_mem b⟩ : ↥W₀) ∈ IsLocalRing.maximalIdeal ↥W₀ ↔ b ∈ P) →
        ∀ z ∈ W₀, ∃ a s : B, s ∉ P ∧ z * φ_B s = φ_B a := by
    intro B _ _ _ φ_B hFrac α₀ hEt P hP hP_comap W₀ hW_mem hW_max
    letI : Algebra B F := φ_B.toAlgebra
    letI : Algebra (Polynomial ↥R) B := α₀.toAlgebra
    have hφ_inj : Function.Injective φ_B :=
      @IsFractionRing.injective B _ F _ φ_B.toAlgebra hFrac
    haveI : Algebra.Etale (Polynomial ↥R) B := RingHom.etale_algebraMap.mp hEt
    haveI : Module.Flat (Polynomial ↥R) B := inferInstance
    haveI : Module.IsTorsionFree (Polynomial ↥R) B := Module.Flat.isTorsionFree
    have hα_inj : Function.Injective α₀ := by
      rw [RingHom.injective_iff_ker_eq_bot, Submodule.eq_bot_iff]
      intro Q hQ
      rw [RingHom.mem_ker] at hQ
      have hsmul : Q • (1 : B) = 0 := by rw [Algebra.smul_def, mul_one]; exact hQ
      rcases smul_eq_zero.mp hsmul with rfl | h10
      · rfl
      · exact absurd h10 one_ne_zero
    let ι₀ : Polynomial ↥R →+* F := φ_B.comp α₀
    have hι₀_inj : Function.Injective ι₀ := hφ_inj.comp hα_inj
    have hι₀_ne : ∀ {Q : Polynomial ↥R}, Q ≠ 0 → ι₀ Q ≠ 0 :=
      fun hQ h0 => hQ (hι₀_inj (h0.trans (map_zero ι₀).symm))
    let p₀ : Ideal (Polynomial ↥R) := Ideal.comap α₀ P
    haveI hp₀_prime : p₀.IsPrime := Ideal.IsPrime.comap α₀
    let F₀ : Subfield F :=
      { carrier := {w : F | ∃ P₁ P₂ : Polynomial ↥R, P₂ ≠ 0 ∧ w * ι₀ P₂ = ι₀ P₁}
        mul_mem' := by
