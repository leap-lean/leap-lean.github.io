          exact hev.symm.trans hQ
        have hC_mem : Polynomial.C (Q.coeff 0) ∈ m₀.asIdeal := hC_m₀ (Q.coeff 0) hr_mem
        simpa using m₀.asIdeal.add_mem hsub hC_mem
      refine ⟨none, Polynomial ↥R, inferInstance, Polynomial.C, RingHom.id _, m₀, e₀, ψ, ε,
        hInj_ψ, RingHom.ext fun _ => by simp [ψ, φ_KF0], rfl,
