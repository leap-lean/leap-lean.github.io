    have ha0 : a ≠ 0 := fun h0 => by
      have hx0' : x.1 ≠ 0 := fun h => hx0 (Subtype.ext h)
      apply mul_ne_zero hx0' (pow_ne_zero k hϖ_ne)
      rw [hak, h0, map_zero]
    exact (Submodule.ne_bot_iff _).mpr ⟨a, haQ, ha0⟩

  
