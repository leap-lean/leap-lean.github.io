        · exact Or.inl (discEq_trans (discEq_symm hi_l_eq) htop)
        · exact Or.inr ⟨a₀, ha, discEq_trans (discEq_symm hi_l_eq) hbot⟩
      obtain ⟨hEi_irred, _, _, W_i, hWi_stalk, hWi_disc⟩ := hEX1_nonbd i_l hi_l_nb
      have hWi_eq : W_i = W_c l :=
        (hDiscUniq (c i_l) (π i_l) (c_0 l) (π_0 l) W_i (W_c l)
          (hTree.1 i_l) (hπ0_ne l) hWi_disc (hWc_disc l)).mpr hi_l_eq
      rw [hWi_eq] at hWi_stalk
      exact ⟨E_X1 i_l, hEi_irred, hWi_stalk⟩
    obtain ⟨α_1, hα1_g, hα1_f, _, _, _, hα1_dichot, hα1_iso_imp⟩ :=
      hDomPkg X_0.toScheme X_1 g_X0 g_X1 f_0 f_X1 η_X0 η_X1
        hSS_X0 hSS_X1 hFunc_X0 hFunc_X1 hProp_f0 hProp_fX1 rfl rfl
        hηX0_f0 hη_X1_f hIso_f0_compl hGenIso_X1 hDom1_fwd
    
    have hIso_fX1_compl :
        CategoryTheory.IsIso (f_X1 ∣_ (⟨Z_modᶜ, hZ_closed.isOpen_compl⟩ : W_B.toScheme.Opens)) :=
      weil_disc_tree_pullback_iso_over_mod_complement K m R hPkg_VP hMax_VP a_opt
        M_0 W_B.toScheme X_0.toScheme g_M0 g_WB f_0 m_0 u₀_WB e_0 Z_mod hZ_closed
        F_0 F_WB η_M0 η_WB η_X0 φ_KF0 φ_F0_FWB T_0 hAff_WB hSS_WB hSS_X0 hProp_f0
        hu₀_max hZ_neBot hIso_f0_compl he0_Zmod hStd hEt_e0 he0_comm he0_m0
        hFunc_WB hFunc_X0 hηX0_f0 hη_e0 r_c E_c W_c c_0 π_0 hEc_stalk
        N c π M_1 g_M1 f_M1 η_M1 Z_M1 B_1 hMod1 hNonBd_in_rc
    have hDom1_rev : ∀ E₂ ∈ irreducibleComponents ↥Y_X1,
        (∀ q ∈ E₂, f_X1.base ((CategoryTheory.Limits.pullback.fst g_X1 s_R).base q) = u₀_WB) →
        ∀ W : ValuationSubring F_WB, IsComponentStalkVal R g_X1 η_X1 E₂ W →
          ∃ E₁ ∈ irreducibleComponents ↥Y_X0, IsComponentStalkVal R g_X0 η_X0 E₁ W := by
      intro E₂ hE₂_irred hE₂_u0 W hW_stalk
      obtain ⟨i, hi_nb, rfl⟩ := hEX1_exh E₂ hE₂_irred hE₂_u0
      obtain ⟨hEi_irred, _, _, W_i, hWi_stalk, hWi_disc⟩ := hEX1_nonbd i hi_nb
      have hW_eq : W = W_i :=
        hStalkUniq X_1 g_X1 η_X1 hSS_X1 hFunc_X1 (E_X1 i) hEi_irred W W_i hW_stalk hWi_stalk
      obtain ⟨l, hl_eq⟩ := hNonBd_in_rc i hi_nb
      have hWi_eq : W_i = W_c l :=
        (hDiscUniq (c i) (π i) (c_0 l) (π_0 l) W_i (W_c l)
          (hTree.1 i) (hπ0_ne l) hWi_disc (hWc_disc l)).mpr hl_eq
      rw [hW_eq, hWi_eq]
      exact ⟨E_c l, (hEc_mem l).1, hWc l⟩
    have hIso_α1 : CategoryTheory.IsIso α_1 := hα1_iso_imp hIso_fX1_compl hDom1_rev
    obtain ⟨hEZ1_irred, hEZ1_fst, _, W_Z1, hWZ1_stalk, hWZ1_disc⟩ := hEX1_nonbd i_Z hiZ_nb
    have hWZ1_eq : W_Z1 = W_c i_Z0 :=
      (hDiscUniq (c i_Z) (π i_Z) (c_0 i_Z0) (π_0 i_Z0) W_Z1 (W_c i_Z0)
        (hTree.1 i_Z) (hπ0_ne i_Z0) hWZ1_disc (hWc_disc i_Z0)).mpr hiZ_eq
    rw [hWZ1_eq] at hWZ1_stalk
    have hImg_Z : (CategoryTheory.Limits.pullback.map g_X1 s_R g_X0 s_R α_1 (𝟙 _) (𝟙 _)
        (by rw [CategoryTheory.Category.comp_id, hα1_g])
        (by rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])).base ''
          (E_X1 i_Z) = E_c i_Z0 :=
      ((hα1_dichot (E_X1 i_Z) hEZ1_irred (W_c i_Z0) hWZ1_stalk).2
        (E_c i_Z0) (hEc_mem i_Z0).1 (hWc i_Z0)).1
    have hInj_iZ : ∀ j₁ j₂ : Fin N,
        (IsDiscHasseCover ↥R c π i_Z j₁ ∨ IsDiscHasseCover ↥R c π j₁ i_Z) →
        (IsDiscHasseCover ↥R c π i_Z j₂ ∨ IsDiscHasseCover ↥R c π j₂ i_Z) →
        p_nb1 i_Z j₁ = p_nb1 i_Z j₂ → j₁ = j₂ := by
      intro j₁ j₂ hj₁ hj₂ hp_eq
      rcases hPnb1_inj i_Z j₁ i_Z j₂ hiZ_nb hiZ_nb hj₁ hj₂ hp_eq with
        ⟨_, h⟩ | ⟨h_eq, _⟩
      · exact h
      · exfalso
        rcases hj₂ with hH | hH
        · exact hH.1 h_eq
        · exact hH.1 h_eq.symm
    exact ⟨α_1, hα1_g, E_X1, p_nb1, hIso_α1, hα1_f, hEZ1_fst, hImg_Z, hInj_iZ,
      hEX1_nb i_Z hiZ_nb⟩
  
  let S_nb : Set (Fin N) :=
    {j : Fin N | IsDiscHasseCover ↥R c π i_Z j ∨ IsDiscHasseCover ↥R c π j i_Z}
  obtain ⟨α_1, hα1_g, E_X1, p_nb1, hIso_α1, _, _, hImg_Z1, hInj_iZ1, hNb_iff1⟩ :=
    hIsoOfModel M_hat g_Mhat f_Mhat η_Mhat Z_Mhat B_hat hMod_hat
  let α_1_R : Y_Xhat ⟶ Y_X0 :=
    CategoryTheory.Limits.pullback.map g_Xhat s_R g_X0 s_R α_1 (𝟙 _) (𝟙 _)
      (by rw [CategoryTheory.Category.comp_id, hα1_g])
      (by rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
  haveI : CategoryTheory.IsIso α_1 := hIso_α1
  haveI : CategoryTheory.IsIso α_1_R := inferInstance
  let hHomeo : ↥Y_Xhat ≃ₜ ↥Y_X0 :=
    TopCat.homeoOfIso (AlgebraicGeometry.Scheme.forgetToTop.mapIso (CategoryTheory.asIso α_1_R))
  have hHomeo_apply : ∀ q : ↥Y_Xhat, hHomeo q = α_1_R.base q := fun _ => rfl
  have hHomeo_irred : ∀ S : Set ↥Y_Xhat,
      S ∈ irreducibleComponents ↥Y_Xhat ↔ (hHomeo '' S) ∈ irreducibleComponents ↥Y_X0 := by
    intro S
    rw [irreducibleComponents_eq_maximals_closed, irreducibleComponents_eq_maximals_closed]
    simp only [Set.mem_setOf_eq]
    constructor
    · intro hS
      refine ⟨⟨(hHomeo.isClosed_image).mpr hS.prop.1,
        hS.prop.2.image hHomeo hHomeo.continuous.continuousOn⟩, ?_⟩
      intro T hT hST
      have hpre_cl : IsClosed (hHomeo.symm '' T) := (hHomeo.symm.isClosed_image).mpr hT.1
      have hpre_ir : IsIrreducible (hHomeo.symm '' T) :=
        hT.2.image hHomeo.symm hHomeo.symm.continuous.continuousOn
      have hS_sub : S ⊆ hHomeo.symm '' T := by
        intro x hx
        exact ⟨hHomeo x, hST ⟨x, hx, rfl⟩, hHomeo.symm_apply_apply x⟩
      have h_le := hS.le_of_ge ⟨hpre_cl, hpre_ir⟩ hS_sub
      intro w hw
      exact ⟨hHomeo.symm w, h_le ⟨w, hw, rfl⟩, hHomeo.apply_symm_apply w⟩
    · intro hImg
      refine ⟨⟨(hHomeo.isClosed_image).mp hImg.prop.1, ?_⟩, ?_⟩
      · have heq : S = hHomeo.symm '' (hHomeo '' S) := by
          ext x
          exact ⟨fun hx => ⟨hHomeo x, ⟨x, hx, rfl⟩, hHomeo.symm_apply_apply x⟩,
            by rintro ⟨_, ⟨z, hz, rfl⟩, h⟩; rw [hHomeo.symm_apply_apply] at h; rwa [← h]⟩
        rw [heq]
        exact hImg.prop.2.image hHomeo.symm hHomeo.symm.continuous.continuousOn
      · intro T hT hST
        have hT_cl : IsClosed (hHomeo '' T) := (hHomeo.isClosed_image).mpr hT.1
        have hT_ir : IsIrreducible (hHomeo '' T) :=
          hT.2.image hHomeo hHomeo.continuous.continuousOn
        have h_le := hImg.le_of_ge ⟨hT_cl, hT_ir⟩ (Set.image_mono hST)
        intro x hx
        obtain ⟨z, hz, hzx⟩ := h_le ⟨x, hx, rfl⟩
        rwa [← hHomeo.injective hzx]
  let Δ_X1 : Set ↥Y_Xhat :=
    {q ∈ E_X1 i_Z | ∃ E' ∈ irreducibleComponents ↥Y_Xhat, E' ≠ E_X1 i_Z ∧ q ∈ E'}
  let Δ_X0 : Set ↥Y_X0 :=
    {q ∈ E_c i_Z0 | ∃ E' ∈ irreducibleComponents ↥Y_X0, E' ≠ E_c i_Z0 ∧ q ∈ E'}
  have hSnb_eq_ΔX1 : S_nb.ncard = Δ_X1.ncard := by
    refine Set.ncard_congr (fun j _ => p_nb1 i_Z j) ?_ ?_ ?_
    · intro j hj
      exact (hNb_iff1 (p_nb1 i_Z j)).mpr ⟨j, hj, rfl⟩
    · intro j₁ j₂ hj₁ hj₂ hp_eq
      exact hInj_iZ1 j₁ j₂ hj₁ hj₂ hp_eq
    · intro q hq
      obtain ⟨j, hj, rfl⟩ := (hNb_iff1 q).mp hq
      exact ⟨j, hj, rfl⟩
  have hΔX1_eq_ΔX0 : Δ_X1.ncard = Δ_X0.ncard := by
    have hImg_Z_homeo : hHomeo '' (E_X1 i_Z) = E_c i_Z0 := hImg_Z1
    refine Set.ncard_congr (fun q _ => hHomeo q) ?_ ?_ ?_
    · rintro q ⟨hq_Z, E', hE'_irred, hE'_ne, hq_E'⟩
      refine ⟨by rw [← hImg_Z_homeo]; exact ⟨q, hq_Z, rfl⟩,
        hHomeo '' E', (hHomeo_irred E').mp hE'_irred, ?_, ⟨q, hq_E', rfl⟩⟩
      intro heq
      apply hE'_ne
      rw [← hImg_Z_homeo] at heq
      ext x
      constructor
      · intro hx
        obtain ⟨z, hz, hzx⟩ := Set.ext_iff.mp heq (hHomeo x) |>.mp ⟨x, hx, rfl⟩
        rwa [← hHomeo.injective hzx]
      · intro hx
        obtain ⟨z, hz, hzx⟩ := Set.ext_iff.mp heq (hHomeo x) |>.mpr ⟨x, hx, rfl⟩
        rwa [← hHomeo.injective hzx]
    · intro q₁ q₂ _ _ hq_eq
      exact hHomeo.injective hq_eq
    · rintro q₀ ⟨hq₀_Z, E₀, hE₀_irred, hE₀_ne, hq₀_E₀⟩
      rw [← hImg_Z_homeo] at hq₀_Z
      rcases hq₀_Z with ⟨q₁, hq₁_Z, rfl⟩
      let E₁ : Set ↥Y_Xhat := hHomeo ⁻¹' E₀
      have hE₁_img : hHomeo '' E₁ = E₀ := Set.image_preimage_eq E₀ hHomeo.surjective
      refine ⟨q₁, ⟨hq₁_Z, E₁, (hHomeo_irred E₁).mpr (hE₁_img.symm ▸ hE₀_irred), ?_, hq₀_E₀⟩, rfl⟩
      intro h_eq
      apply hE₀_ne
      rw [← hE₁_img, h_eq, hImg_Z_homeo]
  let Δ_Z : Set ↥(CategoryTheory.Limits.pullback g_cur s_P) :=
    {q ∈ Z | ∃ E' ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_cur s_P),
      E' ≠ Z ∧ q ∈ E'}
  have hSnb_eq_ΔZ : S_nb.ncard = Δ_Z.ncard :=
    hSnb_eq_ΔX1.trans (hΔX1_eq_ΔX0.trans hΔ_eq.symm)
  have hSnb_bounds : 1 ≤ S_nb.ncard ∧ S_nb.ncard ≤ 2 := by
    rw [hSnb_eq_ΔZ]
    exact ⟨hΔ_lo, hΔ_hi⟩
  
  obtain ⟨M_tilde, M', g_tilde, g'_M, f'_M, q_M, η_tilde, Z_tilde, B_tilde,
      Mod_qM, z_new_M, Q₀_R, z₀_M, E_Z_M, hMod_tilde, hContr_M, hEZM_eq⟩ :=
    hOneStepPkg N c π hTree i_Z hiZ_nb hSnb_bounds
  
  obtain ⟨α_tilde, hαtilde_g, E_tilde, _, hIso_αtilde, hαtilde_f, hEtilde_fst, hImg_Ztilde, _, _⟩ :=
    hIsoOfModel M_tilde g_tilde (q_M ≫ f'_M) η_tilde Z_tilde B_tilde hMod_tilde
  haveI : CategoryTheory.IsIso α_tilde := hIso_αtilde
  let Φ : X_0.toScheme ≅ CategoryTheory.Limits.pullback (q_M ≫ f'_M) e_0 :=
    (CategoryTheory.asIso α_tilde).symm
  have hΦ_f : Φ.hom ≫ CategoryTheory.Limits.pullback.snd (q_M ≫ f'_M) e_0 = f_0 := by
    change CategoryTheory.inv α_tilde ≫ CategoryTheory.Limits.pullback.snd (q_M ≫ f'_M) e_0 = f_0
    rw [← hαtilde_f, CategoryTheory.IsIso.inv_hom_id_assoc]
  let Z_X0 : Set ↥X_0.toScheme :=
    X_0.ι.base ⁻¹' ((CategoryTheory.Limits.pullback.fst g_cur s_P).base '' Z)
  have hΦ_ZX0 : Φ.hom.base '' Z_X0 =
      (CategoryTheory.Limits.pullback.fst (q_M ≫ f'_M) e_0).base ⁻¹' E_Z_M := by
    have hZX0_as_α : Z_X0 = α_tilde.base ''
        ((CategoryTheory.Limits.pullback.fst
          (CategoryTheory.Limits.pullback.snd (q_M ≫ f'_M) e_0 ≫ g_WB) s_R).base ''
            (E_tilde i_Z)) := by
      have hZX0_eq' : Z_X0 = (CategoryTheory.Limits.pullback.fst g_X0 s_R).base '' (E_c i_Z0) :=
        hZX0_eq.symm
      have hImg_Ztilde' : (CategoryTheory.Limits.pullback.map
          (CategoryTheory.Limits.pullback.snd (q_M ≫ f'_M) e_0 ≫ g_WB) s_R g_X0 s_R α_tilde
          (𝟙 _) (𝟙 _) (by rw [CategoryTheory.Category.comp_id, hαtilde_g])
          (by rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])).base ''
            (E_tilde i_Z) = E_c i_Z0 := hImg_Ztilde
      rw [hZX0_eq', ← hImg_Ztilde', ← Set.image_comp, ← Set.image_comp]
      congr 1
      ext q
      change ((CategoryTheory.Limits.pullback.map
          (CategoryTheory.Limits.pullback.snd (q_M ≫ f'_M) e_0 ≫ g_WB) s_R g_X0 s_R α_tilde
          (𝟙 _) (𝟙 _) (by rw [CategoryTheory.Category.comp_id, hαtilde_g])
          (by rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])) ≫
            CategoryTheory.Limits.pullback.fst g_X0 s_R).base q =
        (CategoryTheory.Limits.pullback.fst
          (CategoryTheory.Limits.pullback.snd (q_M ≫ f'_M) e_0 ≫ g_WB) s_R ≫ α_tilde).base q
      rw [CategoryTheory.Limits.pullback.lift_fst]
    rw [hZX0_as_α, ← Set.image_comp]
    have hcomp_id : Φ.hom.base ∘ α_tilde.base = id := by
      ext x
      change (α_tilde ≫ Φ.hom).base x = x
      change (α_tilde ≫ CategoryTheory.inv α_tilde).base x = x
      rw [CategoryTheory.IsIso.hom_inv_id]
      rfl
    rw [hcomp_id, Set.image_id, hEtilde_fst, hEZM_eq]
  have hLeaf_eq : (S_nb.ncard = 1) = (Δ_Z.ncard = 1) := by
    rw [hSnb_eq_ΔZ]
  rw [hLeaf_eq] at hContr_M
  exact hTransferContr (Δ_Z.ncard = 1) Z_X0 M_tilde M' g_tilde g'_M f'_M q_M
    Mod_qM z_new_M Q₀_R z₀_M E_Z_M Φ hContr_M hΦ_f hΦ_ZX0

theorem weil_chart_contraction_global_closedness_and_fiber_subsingleton (K : Type u) [Field K] (m : ℕ) (V : ValuationSubring K)
    (hPkg : IsValuationRingAlgPackage m V)
    (C' : AlgebraicGeometry.Scheme.{u})
    (g' : C' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (U' : C'.Opens)
    (U_ss : AlgebraicGeometry.Scheme.{u})
    (g_ss : U_ss ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (hAff_ss : AlgebraicGeometry.IsAffine U_ss)
    (hSS : IsStrictlySemistableCurveOverValuation V g_ss)
    (h_mod : U'.toScheme ⟶ U_ss)
    (hProp_mod : AlgebraicGeometry.IsProper h_mod)
    (hComm_mod : h_mod ≫ g_ss = U'.ι ≫ g')
    (C_cur : AlgebraicGeometry.Scheme.{u})
    (g_cur : C_cur ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (f_dom_cur : C_cur ⟶ U'.toScheme)
    (hSS_cur : IsStrictlySemistableCurveOverValuation V g_cur)
    (hProp_fdom : AlgebraicGeometry.IsProper f_dom_cur)
    (hfdom_g : f_dom_cur ≫ U'.ι ≫ g' = g_cur)
    (P : PrimeSpectrum ↥V) (hP_ne : P.asIdeal ≠ ⊥)
    (x₀ : ↥U'.toScheme)
    (hx₀_cl : IsClosed ({x₀} : Set ↥U'.toScheme))
    (hx₀_P : (U'.ι ≫ g').base x₀ = P)
    (Z : Set ↥(CategoryTheory.Limits.pullback g_cur
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap ↥V P.asIdeal.ResidueField)))))
    (hZ_nonempty : Z.Nonempty)
    (hZ_x₀ : ∀ q ∈ Z,
      f_dom_cur.base ((CategoryTheory.Limits.pullback.fst g_cur
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap ↥V P.asIdeal.ResidueField)))).base q) = x₀)
    (ϖ : ↥V) (W_B : U_ss.Opens) (hu₀ : h_mod.base x₀ ∈ W_B)
    (g_WB : W_B.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥(V.ofPrime P.asIdeal)))
    (Z_mod : Set ↥W_B.toScheme) (hZ_closed : IsClosed Z_mod)
    (hChart : IsIsolatedStrictlySemistableModChart V g_ss (f_dom_cur ≫ h_mod) P (h_mod.base x₀)
      ϖ W_B hu₀ g_WB Z_mod hZ_closed)
    (isLeaf : Prop)
    (X'_0 : AlgebraicGeometry.Scheme.{u})
    (g'_0 : X'_0 ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥(V.ofPrime P.asIdeal)))
    (f'_0 : X'_0 ⟶ W_B.toScheme)
    (q_0 : AlgebraicGeometry.Scheme.Opens.toScheme
      ((TopologicalSpace.Opens.map (f_dom_cur ≫ h_mod).base).obj W_B) ⟶ X'_0)
    (Mod_q0 : Set ↥X'_0) (hMod_closed : IsClosed Mod_q0) (z_new : ↥X'_0)
    (hContr : IsSingleComponentChartContraction V P g_WB ((f_dom_cur ≫ h_mod) ∣_ W_B) Z_mod
      ((AlgebraicGeometry.Scheme.Opens.ι (X := C_cur)
        ((TopologicalSpace.Opens.map (f_dom_cur ≫ h_mod).base).obj W_B)).base ⁻¹'
        ((CategoryTheory.Limits.pullback.fst g_cur
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap ↥V P.asIdeal.ResidueField)))).base '' Z))
      isLeaf X'_0 g'_0 f'_0 q_0 Mod_q0 hMod_closed z_new) :
    let X_0 : C_cur.Opens := (TopologicalSpace.Opens.map (f_dom_cur ≫ h_mod).base).obj W_B
    let F_contr : Set ↥C_cur := X_0.ι.base '' (q_0.base ⁻¹' Mod_q0)
    IsClosed F_contr ∧
    IsClosed (W_B.ι.base '' (f'_0.base '' Mod_q0)) ∧
    ∀ Q : PrimeSpectrum ↥V,
      (f_dom_cur.base '' (F_contr ∩ g_cur.base ⁻¹' {Q})).Subsingleton :=
by
  classical
  have _ := And.intro hSS_cur hP_ne
  intro X_0 F_contr
  obtain ⟨_hϖ_P, _hϖ_iff, _hLoc_VP, _hOpen_VP, _hAff_WB, hComm_WB,
    hZmod_fin, _hZmod_ne, _hIso_f0, hu₀_spec_all, _hChart_et⟩ := hChart
  obtain ⟨_hSS_X'0, hq0_f'0, hf'0_gWB, _hProp_q0, hProp_f'0, hSurj_q0, hMod_sub_Zmod,
    _hIso_q0, _hLeafSm, _hz_new_mem, _hz_new_P, hFexc_P, _hMod_P, _hMod_sub,
    ⟨Q₀, z₀, hQ₀_ne, _hQ₀_le, hz₀_mem, hz₀_Q₀, hIrred_F0, hFexc_eq⟩, _hSpec_Z⟩ := hContr
  have := hAff_ss
  have : AlgebraicGeometry.LocallyOfFinitePresentation g_ss := hSS.2.2.2.1
  have : AlgebraicGeometry.IsProper h_mod := hProp_mod
  have : AlgebraicGeometry.IsProper f_dom_cur := hProp_fdom
  have : AlgebraicGeometry.IsProper f'_0 := hProp_f'0
  have : AlgebraicGeometry.Surjective q_0 := hSurj_q0
  let ι_VP : ↥V →+* ↥(V.ofPrime P.asIdeal) :=
    Subring.inclusion (ValuationSubring.le_ofPrime V P.asIdeal)
  let f_ss_cur : C_cur ⟶ U_ss := f_dom_cur ≫ h_mod
  let u₀ : ↥U_ss := h_mod.base x₀
  let u_WB : ↥W_B.toScheme := f'_0.base z₀
  let u_gen : ↥U_ss := W_B.ι.base u_WB

  have hMap_cl_sing : ∀ {α β : Type u} [TopologicalSpace α] [TopologicalSpace β]
      {f : α → β}, Continuous f → ∀ {x x₀ : α},
      x ∈ closure ({x₀} : Set α) → f x ∈ closure ({f x₀} : Set β) := by
    intro α β _ _ f hf x x₀ hx
    have hsub : ({x₀} : Set α) ⊆ f ⁻¹' closure ({f x₀} : Set β) :=
      Set.singleton_subset_iff.mpr (subset_closure (Set.mem_singleton (f x₀)))
    exact ((isClosed_closure (s := ({f x₀} : Set β))).preimage hf).closure_subset_iff.mpr hsub hx

  
  have hVal_and_Inj : ∀ (R₁ D : Type u) [CommRing R₁] [IsDomain R₁] [ValuationRing R₁]
      [CommRing D] [IsDomain D] (ψ : R₁ →+* D),
      Function.Injective ψ →
      (∀ d : D, ∃ x s : R₁, s ≠ 0 ∧ ψ s * d = ψ x) →
      ValuationRing D ∧ Function.Injective (PrimeSpectrum.comap ψ) := by
    intro R₁ D _ _ _ _ _ ψ hInj hDR
    refine ⟨ValuationRing.iff_dvd_total.mpr ⟨fun d₁ d₂ => ?_⟩, ?_⟩
    · obtain ⟨x₁, s₁, hs₁, hd₁⟩ := hDR d₁
      obtain ⟨x₂, s₂, hs₂, hd₂⟩ := hDR d₂
      have hs12 : ψ (s₁ * s₂) ≠ 0 := fun h0 =>
        mul_ne_zero hs₁ hs₂ (hInj (h0.trans (map_zero ψ).symm))
      rcases ValuationRing.dvd_total (x₁ * s₂) (x₂ * s₁) with ⟨r, hr⟩ | ⟨r, hr⟩
      · left
        refine ⟨ψ r, mul_left_cancel₀ hs12 ?_⟩
        calc
          ψ (s₁ * s₂) * d₂ = ψ s₁ * (ψ s₂ * d₂) := by rw [map_mul, mul_assoc]
          _ = ψ (x₂ * s₁) := by rw [hd₂, ← map_mul, mul_comm]
          _ = ψ (x₁ * s₂) * ψ r := by rw [hr, map_mul]
          _ = ψ s₂ * (ψ x₁) * ψ r := by rw [map_mul, mul_comm (ψ x₁)]
          _ = ψ (s₁ * s₂) * (d₁ * ψ r) := by rw [← hd₁, map_mul]; ring
      · right
        refine ⟨ψ r, mul_left_cancel₀ hs12 ?_⟩
        calc
          ψ (s₁ * s₂) * d₁ = ψ s₂ * (ψ s₁ * d₁) := by rw [map_mul]; ring
          _ = ψ (x₁ * s₂) := by rw [hd₁, ← map_mul, mul_comm]
          _ = ψ (x₂ * s₁) * ψ r := by rw [hr, map_mul]
          _ = ψ s₁ * (ψ x₂) * ψ r := by rw [map_mul, mul_comm (ψ x₂)]
          _ = ψ (s₁ * s₂) * (d₂ * ψ r) := by rw [← hd₂, map_mul]; ring
    · have hle : ∀ p₁ p₂ : PrimeSpectrum D,
          Ideal.comap ψ p₁.asIdeal ≤ Ideal.comap ψ p₂.asIdeal → p₁.asIdeal ≤ p₂.asIdeal := by
        intro p₁ p₂ hcomap d hd
        obtain ⟨x, s, hs, hsd⟩ := hDR d
        rcases ValuationRing.dvd_total s x with ⟨r, rfl⟩ | ⟨r, hsr⟩
        · have hψs : ψ s ≠ 0 := fun h0 => hs (hInj (h0.trans (map_zero ψ).symm))
          have hd_eq : d = ψ r := mul_left_cancel₀ hψs (by rw [hsd, map_mul])
          have hr_mem : r ∈ Ideal.comap ψ p₁.asIdeal := by
            change ψ r ∈ p₁.asIdeal
            rw [← hd_eq]
            exact hd
          exact hd_eq ▸ hcomap hr_mem
        · exfalso
          have hx_ne : x ≠ 0 := fun hx0 => hs (by rw [hsr, hx0, zero_mul])
          have hψx : ψ x ≠ 0 := fun h0 => hx_ne (hInj (h0.trans (map_zero ψ).symm))
          have h1 : ψ r * d = 1 := mul_left_cancel₀ hψx <| by
            calc
              ψ x * (ψ r * d) = ψ (x * r) * d := by rw [← mul_assoc, ← map_mul]
              _ = ψ s * d := by rw [hsr]
              _ = ψ x * 1 := by rw [hsd, mul_one]
          exact p₁.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr (h1 ▸ p₁.asIdeal.mul_mem_left _ hd))
      intro p₁ p₂ hp
      have hp_id : Ideal.comap ψ p₁.asIdeal = Ideal.comap ψ p₂.asIdeal :=
        congrArg PrimeSpectrum.asIdeal hp
      exact PrimeSpectrum.ext (le_antisymm (hle p₁ p₂ hp_id.le) (hle p₂ p₁ hp_id.ge))

  
  let B : Type u := ↑(U_ss.presheaf.obj (Opposite.op ⊤))
  let φ_V_cat : CommRingCat.of ↥V ⟶ U_ss.presheaf.obj (Opposite.op ⊤) :=
    (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).inv ≫ g_ss.appTop
  let φ_V : ↥V →+* B := φ_V_cat.hom
  have hIso_ss_hom_inv : ∀ u : ↥U_ss, U_ss.isoSpec.inv.base (U_ss.isoSpec.hom.base u) = u := by
    intro u
    change (U_ss.isoSpec.hom ≫ U_ss.isoSpec.inv).base u = u
    rw [Iso.hom_inv_id]
    rfl
  have hIso_ss_inv_hom : ∀ p : PrimeSpectrum B,
      U_ss.isoSpec.hom.base (U_ss.isoSpec.inv.base p) = p := by
    intro p
    change (U_ss.isoSpec.inv ≫ U_ss.isoSpec.hom).base p = p
    rw [Iso.inv_hom_id]
    rfl
  have hFT_φV : φ_V.FiniteType := by
    have htop : g_ss ⁻¹ᵁ ⊤ = ⊤ := rfl
    have h1 : (g_ss.appLE ⊤ (g_ss ⁻¹ᵁ ⊤) le_rfl).hom.FiniteType :=
      g_ss.finiteType_appLE (isAffineOpen_top _) (htop ▸ isAffineOpen_top U_ss) le_rfl
    have happ : g_ss.appTop = g_ss.appLE ⊤ (g_ss ⁻¹ᵁ ⊤) le_rfl := g_ss.app_eq_appLE
    rw [← happ] at h1
    have hsurj : Function.Surjective ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).inv).hom :=
      (ConcreteCategory.bijective_of_isIso
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).inv)).2
    exact RingHom.FiniteType.comp h1 (RingHom.FiniteType.of_surjective _ hsurj)
  have hComap_gss : ∀ u : ↥U_ss, PrimeSpectrum.comap φ_V (U_ss.isoSpec.hom.base u) = g_ss.base u := by
    intro u
    have hnat : U_ss.isoSpec.hom ≫ AlgebraicGeometry.Spec.map g_ss.appTop =
        g_ss ≫ (AlgebraicGeometry.Spec (CommRingCat.of ↥V)).isoSpec.hom :=
      AlgebraicGeometry.Scheme.isoSpec_hom_naturality g_ss
    have hspec : (AlgebraicGeometry.Spec (CommRingCat.of ↥V)).isoSpec.inv =
        AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).inv :=
      AlgebraicGeometry.Scheme.isoSpec_Spec_inv (CommRingCat.of ↥V)
    have hcomp : U_ss.isoSpec.hom ≫ AlgebraicGeometry.Spec.map φ_V_cat = g_ss := by
      rw [AlgebraicGeometry.Spec.map_comp, ← Category.assoc, hnat, Category.assoc, ← hspec,
        Iso.hom_inv_id, Category.comp_id]
    have hmap : (AlgebraicGeometry.Spec.map φ_V_cat).base (U_ss.isoSpec.hom.base u) =
        PrimeSpectrum.comap φ_V (U_ss.isoSpec.hom.base u) := by
      rw [AlgebraicGeometry.Spec.map_base]
      rfl
    have hcomp_u : (U_ss.isoSpec.hom ≫ AlgebraicGeometry.Spec.map φ_V_cat).base u =
        (AlgebraicGeometry.Spec.map φ_V_cat).base (U_ss.isoSpec.hom.base u) := rfl
    rw [← hmap, ← hcomp_u, hcomp]

  let q_B : PrimeSpectrum B := U_ss.isoSpec.hom.base u_gen
  have hqB_comap : PrimeSpectrum.comap φ_V q_B = Q₀ := by
    rw [hComap_gss u_gen]
    have hcomm_z₀ : (f'_0 ≫ W_B.ι ≫ g_ss).base z₀ =
        (g'_0 ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_VP)).base z₀ := by
      rw [← hComm_WB, ← Category.assoc, hf'0_gWB]
    have hugen_eq : g_ss.base u_gen = (f'_0 ≫ W_B.ι ≫ g_ss).base z₀ := rfl
    rw [hugen_eq, hcomm_z₀, hz₀_Q₀]

  
  have hu_WB_mem : u_WB ∈ Z_mod := hMod_sub_Zmod ⟨z₀, hz₀_mem, rfl⟩
  have hqB_inv : U_ss.isoSpec.inv.base q_B = u_gen := hIso_ss_hom_inv u_gen
  have hInv_cont : Continuous (fun p : PrimeSpectrum B => U_ss.isoSpec.inv.base p) :=
    U_ss.isoSpec.inv.continuous
  have hqB_open_mem : q_B ∈ (fun p : PrimeSpectrum B => U_ss.isoSpec.inv.base p) ⁻¹' (W_B : Set ↥U_ss) := by
    change U_ss.isoSpec.inv.base q_B ∈ (W_B : Set ↥U_ss)
    rw [hqB_inv]
    exact u_WB.2
  obtain ⟨_, ⟨g, rfl⟩, hqB_basic, hBasic_sub⟩ :=
    PrimeSpectrum.isTopologicalBasis_basic_opens.exists_subset_of_mem_open hqB_open_mem
      (W_B.isOpen.preimage hInv_cont)
  have hg_not_mem : g ∉ q_B.asIdeal := (PrimeSpectrum.mem_basicOpen g q_B).mp hqB_basic
  have hFin_basic : {p : PrimeSpectrum B | q_B.asIdeal ≤ p.asIdeal ∧ g ∉ p.asIdeal}.Finite := by
    let S_g : Set (PrimeSpectrum B) := {p : PrimeSpectrum B | q_B.asIdeal ≤ p.asIdeal ∧ g ∉ p.asIdeal}
    have hMap_Zmod : ∀ p : ↥S_g,
        (⟨U_ss.isoSpec.inv.base p.1, hBasic_sub ((PrimeSpectrum.mem_basicOpen g p.1).mpr p.2.2)⟩ :
          ↥W_B.toScheme) ∈ Z_mod := by
      intro p
      have hp_cl : p.1 ∈ closure ({q_B} : Set (PrimeSpectrum B)) :=
        (PrimeSpectrum.le_iff_mem_closure q_B p.1).mp p.2.1
      have hinv_cl : U_ss.isoSpec.inv.base p.1 ∈ closure ({u_gen} : Set ↥U_ss) := by
        have h1 := hMap_cl_sing hInv_cont hp_cl
        rw [hqB_inv] at h1
        exact h1
      let y_p : ↥W_B.toScheme :=
        ⟨U_ss.isoSpec.inv.base p.1, hBasic_sub ((PrimeSpectrum.mem_basicOpen g p.1).mpr p.2.2)⟩
      have hyp_cl : y_p ∈ closure ({u_WB} : Set ↥W_B.toScheme) := by
        rw [W_B.ι.isEmbedding.isInducing.closure_eq_preimage_closure_image]
        have himg : W_B.ι.base '' ({u_WB} : Set ↥W_B.toScheme) = ({u_gen} : Set ↥U_ss) :=
          Set.image_singleton
        change U_ss.isoSpec.inv.base p.1 ∈ closure (W_B.ι.base '' ({u_WB} : Set ↥W_B.toScheme))
        rw [himg]
        exact hinv_cl
      exact (hZ_closed.closure_subset_iff.mpr (Set.singleton_subset_iff.mpr hu_WB_mem)) hyp_cl
    have : Finite ↥Z_mod := hZmod_fin.to_subtype
    have : Finite ↥S_g := Finite.of_injective
      (fun p : ↥S_g => (⟨_, hMap_Zmod p⟩ : ↥Z_mod)) fun p₁ p₂ hEq => by
        apply Subtype.ext
        have hval : U_ss.isoSpec.inv.base p₁.1 = U_ss.isoSpec.inv.base p₂.1 :=
          congrArg (fun z : ↥Z_mod => z.1.1) hEq
        rw [← hIso_ss_inv_hom p₁.1, hval, hIso_ss_inv_hom p₂.1]
    exact Set.toFinite S_g

  
  have : Q₀.asIdeal.IsPrime := Q₀.isPrime
  have : q_B.asIdeal.IsPrime := q_B.isPrime
  let R₁ : Type u := ↥V ⧸ Q₀.asIdeal
  let π_V : ↥V →+* R₁ := Ideal.Quotient.mk Q₀.asIdeal
  have : ValuationRing R₁ := ValuationRing.iff_dvd_total.mpr ⟨fun a0 b0 => by
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective a0
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective b0
    rcases ValuationRing.dvd_total a b with ⟨c, rfl⟩ | ⟨c, rfl⟩
    · exact Or.inl ⟨π_V c, map_mul π_V a c⟩
    · exact Or.inr ⟨π_V c, map_mul π_V b c⟩⟩
  let κ₀ : Type u := Q₀.asIdeal.ResidueField
  have : IsAlgClosed κ₀ := hPkg.2.2.2.2.1 Q₀.asIdeal hQ₀_ne

  let B₁ : Type u := B ⧸ q_B.asIdeal
  let π_B : B →+* B₁ := Ideal.Quotient.mk q_B.asIdeal
  let α_VB : ↥V →+* B₁ := π_B.comp φ_V
  have hker_VB : ∀ v ∈ Q₀.asIdeal, α_VB v = 0 := by
    intro v hv
    rw [← hqB_comap] at hv
    exact Ideal.Quotient.eq_zero_iff_mem.mpr hv
  let ψ₁ : R₁ →+* B₁ := Ideal.Quotient.lift Q₀.asIdeal α_VB hker_VB
  have hInj_ψ₁ : Function.Injective ψ₁ := by
    rw [RingHom.injective_iff_ker_eq_bot, eq_bot_iff]
    intro r hr
    obtain ⟨v, rfl⟩ := Ideal.Quotient.mk_surjective r
    change π_B (φ_V v) = 0 at hr
    have hφv : φ_V v ∈ q_B.asIdeal := Ideal.Quotient.eq_zero_iff_mem.mp hr
    have hv_qB : v ∈ (PrimeSpectrum.comap φ_V q_B).asIdeal := hφv
    rw [hqB_comap] at hv_qB
    exact Ideal.mem_bot.mpr (Ideal.Quotient.eq_zero_iff_mem.mpr hv_qB)

  have hDR_B₁ : ∀ b : B₁, ∃ x s : R₁, s ≠ 0 ∧ ψ₁ s * b = ψ₁ x := by
    let _ : Algebra ↥V B₁ := α_VB.toAlgebra
    let _ : Algebra R₁ B₁ := ψ₁.toAlgebra
    have : IsScalarTower ↥V R₁ B₁ := ⟨fun c r b => by
      obtain ⟨v, rfl⟩ := Ideal.Quotient.mk_surjective r
      change α_VB (c * v) * b = α_VB c * (α_VB v * b)
      rw [map_mul, mul_assoc]⟩
    have : Algebra.FiniteType ↥V B₁ :=
      (RingHom.FiniteType.of_surjective π_B Ideal.Quotient.mk_surjective).comp hFT_φV
    have : Algebra.FiniteType R₁ B₁ := Algebra.FiniteType.of_restrictScalars_finiteType ↥V R₁ B₁
    let g0 : B₁ := π_B g
    have hg0_ne : g0 ≠ 0 := fun h0 => hg_not_mem (Ideal.Quotient.eq_zero_iff_mem.mp h0)
    have hpow_le : Submonoid.powers g0 ≤ nonZeroDivisors B₁ := by
      rintro _ ⟨k, rfl⟩
      exact mem_nonZeroDivisors_of_ne_zero (pow_ne_zero k hg0_ne)
    let B_g : Type u := Localization.Away g0
    have : IsDomain B_g := IsLocalization.isDomain_localization hpow_le
    have hInj_Bg : Function.Injective (algebraMap B₁ B_g) := IsLocalization.injective B_g hpow_le
    let α_g : R₁ →+* B_g := (algebraMap B₁ B_g).comp ψ₁
    have hInj_αg : Function.Injective α_g := hInj_Bg.comp hInj_ψ₁
    have hFT_R₁_Bg : Algebra.FiniteType R₁ B_g :=
      Algebra.FiniteType.trans ‹Algebra.FiniteType R₁ B₁› inferInstance
    have : Finite (PrimeSpectrum B_g) := by
      let S_g : Set (PrimeSpectrum B) := {p : PrimeSpectrum B | q_B.asIdeal ≤ p.asIdeal ∧ g ∉ p.asIdeal}
      have : Finite ↥S_g := hFin_basic.to_subtype
      refine Finite.of_injective (β := ↥S_g)
        (fun p => ⟨PrimeSpectrum.comap π_B (PrimeSpectrum.comap (algebraMap B₁ B_g) p), ?_, ?_⟩)
        fun p₁ p₂ hEq => ?_
      · intro x hx
        change algebraMap B₁ B_g (π_B x) ∈ p.asIdeal
        rw [Ideal.Quotient.eq_zero_iff_mem.mpr hx, map_zero]
        exact p.asIdeal.zero_mem
      · intro hg_mem
        have hu : IsUnit (algebraMap B₁ B_g g0) :=
          IsLocalization.map_units B_g (⟨g0, Submonoid.mem_powers g0⟩ : Submonoid.powers g0)
        exact p.isPrime.ne_top (p.asIdeal.eq_top_of_isUnit_mem hg_mem hu)
      · have h1 := PrimeSpectrum.comap_injective_of_surjective π_B Ideal.Quotient.mk_surjective
          (congrArg Subtype.val hEq)
        exact PrimeSpectrum.localization_comap_injective B_g (Submonoid.powers g0) h1
    let M₀ : Submonoid B_g := (nonZeroDivisors R₁).map α_g
    have hM₀_le : M₀ ≤ nonZeroDivisors B_g := by
      rintro _ ⟨r, hr, rfl⟩
      exact mem_nonZeroDivisors_of_ne_zero fun h0 =>
        nonZeroDivisors.ne_zero hr (hInj_αg (h0.trans (map_zero α_g).symm))
    let D₀ : Type u := Localization M₀
    have : IsDomain D₀ := IsLocalization.isDomain_localization hM₀_le
    have hInj_D₀ : Function.Injective (algebraMap B_g D₀) := IsLocalization.injective D₀ hM₀_le
    have : Finite (PrimeSpectrum D₀) :=
      Finite.of_injective _ (PrimeSpectrum.localization_comap_injective D₀ M₀)
    have hUnits_D₀ : ∀ y : nonZeroDivisors R₁, IsUnit (((algebraMap B_g D₀).comp α_g) y) :=
      fun y => IsLocalization.map_units D₀ (⟨α_g y.1, y.1, y.2, rfl⟩ : M₀)
    let ι_κ : κ₀ →+* D₀ :=
      IsLocalization.lift (M := nonZeroDivisors R₁) (g := (algebraMap B_g D₀).comp α_g) hUnits_D₀
    have hικ_eq : ∀ r : R₁, ι_κ (algebraMap R₁ κ₀ r) = algebraMap B_g D₀ (α_g r) :=
      fun r => IsLocalization.lift_eq (M := nonZeroDivisors R₁) hUnits_D₀ r
    let _ : Algebra κ₀ D₀ := ι_κ.toAlgebra
    have : Algebra.FiniteType κ₀ D₀ := by
      obtain ⟨S_gen, hS_gen⟩ := hFT_R₁_Bg.out
      refine ⟨⟨S_gen.image (algebraMap B_g D₀), eq_top_iff.mpr fun z _ => ?_⟩⟩
      let A_sub : Subalgebra κ₀ D₀ :=
        Algebra.adjoin κ₀ (↑(S_gen.image (algebraMap B_g D₀)) : Set D₀)
      have hBg_mem : ∀ u : B_g, algebraMap B_g D₀ u ∈ A_sub := by
        intro u
        have hu_top : u ∈ Algebra.adjoin R₁ (↑S_gen : Set B_g) := by
          rw [hS_gen]; trivial
        refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hu_top
        · intro x hx
          exact Algebra.subset_adjoin (Finset.mem_coe.mpr (Finset.mem_image_of_mem _ hx))
        · intro r
          rw [IsScalarTower.algebraMap_apply R₁ B₁ B_g r]
          change algebraMap B_g D₀ (α_g r) ∈ A_sub
          rw [← hικ_eq r]
          exact A_sub.algebraMap_mem (algebraMap R₁ κ₀ r)
        · intro x y _ _ hx hy
          rw [map_add]
          exact A_sub.add_mem hx hy
        · intro x y _ _ hx hy
          rw [map_mul]
          exact A_sub.mul_mem hx hy
      obtain ⟨⟨x, m⟩, hzm⟩ := IsLocalization.surj M₀ z
      rcases m with ⟨_, s, hs, rfl⟩
      have hs_ne : s ≠ 0 := nonZeroDivisors.ne_zero hs
      have hcs_ne : algebraMap R₁ κ₀ s ≠ 0 := fun h0 =>
        hs_ne (IsFractionRing.injective R₁ κ₀ (h0.trans (map_zero _).symm))
      have hz_eq : z = algebraMap B_g D₀ x * ι_κ (algebraMap R₁ κ₀ s)⁻¹ := by
        calc
          z = z * ι_κ (algebraMap R₁ κ₀ s * (algebraMap R₁ κ₀ s)⁻¹) := by
            rw [mul_inv_cancel₀ hcs_ne, map_one, mul_one]
          _ = (z * algebraMap B_g D₀ (α_g s)) * ι_κ (algebraMap R₁ κ₀ s)⁻¹ := by
            rw [map_mul, hικ_eq s, mul_assoc]
          _ = algebraMap B_g D₀ x * ι_κ (algebraMap R₁ κ₀ s)⁻¹ := by rw [hzm]
      rw [hz_eq]
      exact A_sub.mul_mem (hBg_mem x) (A_sub.algebraMap_mem _)
    have hJac_D₀ : IsJacobsonRing D₀ := isJacobsonRing_of_finiteType (A := κ₀) (B := D₀)
    have hField_D₀ : IsField D₀ := by
      let ℳ : Set (Ideal D₀) := {J : Ideal D₀ | J.IsMaximal}
      have : Finite ↥ℳ := Finite.of_injective
        (fun J : ↥ℳ => (⟨J.1, J.2.isPrime⟩ : PrimeSpectrum D₀))
        fun J₁ J₂ h => Subtype.ext (congrArg PrimeSpectrum.asIdeal h)
      have hℳ_fin : ℳ.Finite := Set.toFinite ℳ
      have hjac_bot : (⊥ : Ideal D₀).jacobson = ⊥ := hJac_D₀.out Ideal.isRadical_bot
      have hinf_le : (hℳ_fin.toFinset.inf id : Ideal D₀) ≤ ⊥ := by
        rw [← hjac_bot]
        intro x hx
        refine Ideal.mem_sInf.mpr fun J ⟨_, hJ_max⟩ => ?_
        have hle_J : hℳ_fin.toFinset.inf id ≤ J :=
          Finset.inf_le (f := id) (hℳ_fin.mem_toFinset.mpr hJ_max)
        exact hle_J hx
      have hbot_prime : (⊥ : Ideal D₀).IsPrime :=
        ⟨bot_ne_top, fun {a b} hab => by
          simpa only [Ideal.mem_bot] using mul_eq_zero.mp (Ideal.mem_bot.mp hab)⟩
      obtain ⟨J, hJ_mem, hJ_le⟩ := hbot_prime.inf_le'.mp hinf_le
      have hJ_max : J.IsMaximal := hℳ_fin.mem_toFinset.mp hJ_mem
      have hbot_eq : (⊥ : Ideal D₀) = J := le_antisymm bot_le hJ_le
      exact Ring.isField_iff_maximal_bot.mpr (hbot_eq ▸ hJ_max)
    let _ : Field D₀ := hField_D₀.toField
    have : Module.Finite κ₀ D₀ := finite_of_finite_type_of_isJacobsonRing κ₀ D₀
    have hBij_ικ : Function.Bijective ι_κ :=
      IsAlgClosed.algebraMap_bijective_of_isIntegral (k := κ₀) (K := D₀)
    let ι_B₁ : B₁ →+* D₀ := (algebraMap B_g D₀).comp (algebraMap B₁ B_g)
    have hInj_ιB₁ : Function.Injective ι_B₁ := hInj_D₀.comp hInj_Bg
    intro b
    obtain ⟨q, hq⟩ := hBij_ικ.2 (ι_B₁ b)
    obtain ⟨⟨x, s⟩, hqs⟩ := IsLocalization.surj (nonZeroDivisors R₁) q
    refine ⟨x, s.1, nonZeroDivisors.ne_zero s.2, hInj_ιB₁ ?_⟩
    calc
      ι_B₁ (ψ₁ s.1 * b) = ι_B₁ b * algebraMap B_g D₀ (α_g s.1) := by
        rw [map_mul, mul_comm]; rfl
      _ = ι_κ q * ι_κ (algebraMap R₁ κ₀ s.1) := by rw [hq, hικ_eq s.1]
      _ = ι_κ (q * algebraMap R₁ κ₀ s.1) := (map_mul ι_κ _ _).symm
      _ = ι_κ (algebraMap R₁ κ₀ x) := by rw [hqs]
      _ = ι_B₁ (ψ₁ x) := hικ_eq x

  have : ValuationRing B₁ := (hVal_and_Inj R₁ B₁ ψ₁ hInj_ψ₁ hDR_B₁).1

  
  have hTot_B : ∀ p₁ p₂ : PrimeSpectrum B,
      q_B.asIdeal ≤ p₁.asIdeal → q_B.asIdeal ≤ p₂.asIdeal →
      p₁.asIdeal ≤ p₂.asIdeal ∨ p₂.asIdeal ≤ p₁.asIdeal := by
    intro p₁ p₂ hp₁ hp₂
    by_cases hle : p₁.asIdeal ≤ p₂.asIdeal
    · exact Or.inl hle
    · right
      obtain ⟨a, ha₁, ha₂⟩ := Set.not_subset.mp hle
      intro c hc₂
      rcases ValuationRing.dvd_total (π_B a) (π_B c) with ⟨u0_q, hu0_q⟩ | ⟨u0_q, hu0_q⟩
      · obtain ⟨u, rfl⟩ := Ideal.Quotient.mk_surjective u0_q
        have hdiff : c - a * u ∈ q_B.asIdeal := Ideal.Quotient.eq_zero_iff_mem.mp <| by
          rw [map_sub, map_mul, hu0_q, sub_self]
        have hmem : c - a * u + a * u ∈ p₁.asIdeal :=
          p₁.asIdeal.add_mem (hp₁ hdiff) (p₁.asIdeal.mul_mem_right u ha₁)
        simpa only [sub_add_cancel] using hmem
      · exfalso
        obtain ⟨u, rfl⟩ := Ideal.Quotient.mk_surjective u0_q
        have hdiff : a - c * u ∈ q_B.asIdeal := Ideal.Quotient.eq_zero_iff_mem.mp <| by
          rw [map_sub, map_mul, hu0_q, sub_self]
        have hmem : a - c * u + c * u ∈ p₂.asIdeal :=
          p₂.asIdeal.add_mem (hp₂ hdiff) (p₂.asIdeal.mul_mem_right u hc₂)
        have ha_mem : a ∈ p₂.asIdeal := by simpa only [sub_add_cancel] using hmem
        exact ha₂ ha_mem

  
  have hInj_comap : ∀ (A_Y : Type u) [CommRing A_Y] (φ_BY : B →+* A_Y) (η_Y : PrimeSpectrum A_Y),
      φ_BY.Finite →
      (∀ p : PrimeSpectrum A_Y, η_Y.asIdeal ≤ p.asIdeal) →
      PrimeSpectrum.comap φ_BY η_Y = q_B →
      Function.Injective (PrimeSpectrum.comap (φ_BY.comp φ_V)) := by
    intro A_Y _ φ_BY η_Y hFin_BY hη_min hη_comap
    have : η_Y.asIdeal.IsPrime := η_Y.isPrime
    let D_Y : Type u := A_Y ⧸ η_Y.asIdeal
    let π_Y : A_Y →+* D_Y := Ideal.Quotient.mk η_Y.asIdeal
    let α_BY : B →+* D_Y := π_Y.comp φ_BY
    have hker_BY : ∀ b ∈ q_B.asIdeal, α_BY b = 0 := by
      intro b hb
      rw [← hη_comap] at hb
      exact Ideal.Quotient.eq_zero_iff_mem.mpr hb
    let θ_Y : B₁ →+* D_Y := Ideal.Quotient.lift q_B.asIdeal α_BY hker_BY
    have hInj_θY : Function.Injective θ_Y := by
      rw [RingHom.injective_iff_ker_eq_bot, eq_bot_iff]
      intro b_q hb_q
      obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective b_q
      change π_Y (φ_BY b) = 0 at hb_q
      have hφb : φ_BY b ∈ η_Y.asIdeal := Ideal.Quotient.eq_zero_iff_mem.mp hb_q
      have hb_qB : b ∈ (PrimeSpectrum.comap φ_BY η_Y).asIdeal := hφb
      rw [hη_comap] at hb_qB
      exact Ideal.mem_bot.mpr (Ideal.Quotient.eq_zero_iff_mem.mpr hb_qB)
    have hFin_αBY : α_BY.Finite :=
      (RingHom.Finite.of_surjective π_Y Ideal.Quotient.mk_surjective).comp hFin_BY
    have hInt_αBY : α_BY.IsIntegral := hFin_αBY.to_isIntegral
    let ψ_Y : R₁ →+* D_Y := θ_Y.comp ψ₁
    have hInj_ψY : Function.Injective ψ_Y := hInj_θY.comp hInj_ψ₁
    let L_Y : Type u := FractionRing D_Y
    have hInj_LY : Function.Injective (algebraMap D_Y L_Y) := IsFractionRing.injective D_Y L_Y
    let γ_RY : R₁ →+* L_Y := (algebraMap D_Y L_Y).comp ψ_Y
    have hInj_γRY : Function.Injective γ_RY := hInj_LY.comp hInj_ψY
    let β_κ : κ₀ →+* L_Y := IsFractionRing.lift hInj_γRY
    have hβκ_eq : ∀ r : R₁, β_κ (algebraMap R₁ κ₀ r) = algebraMap D_Y L_Y (ψ_Y r) :=
      fun r => IsFractionRing.lift_algebraMap hInj_γRY r
    have hB₁_in_κ₀ : ∀ b : B₁, ∃ q : κ₀, β_κ q = algebraMap D_Y L_Y (θ_Y b) := by
      intro b
      obtain ⟨x, s, hs_ne, hsb⟩ := hDR_B₁ b
      have hcs_ne : algebraMap R₁ κ₀ s ≠ 0 := fun h0 =>
        hs_ne (IsFractionRing.injective R₁ κ₀ (h0.trans (map_zero _).symm))
      have hβs_ne : β_κ (algebraMap R₁ κ₀ s) ≠ 0 :=
        (map_ne_zero_iff β_κ β_κ.injective).mpr hcs_ne
      refine ⟨algebraMap R₁ κ₀ x * (algebraMap R₁ κ₀ s)⁻¹, mul_right_cancel₀ hβs_ne ?_⟩
      calc
        β_κ (algebraMap R₁ κ₀ x * (algebraMap R₁ κ₀ s)⁻¹) * β_κ (algebraMap R₁ κ₀ s)
          = β_κ (algebraMap R₁ κ₀ x * ((algebraMap R₁ κ₀ s)⁻¹ * algebraMap R₁ κ₀ s)) := by
            rw [← map_mul, mul_assoc]
        _ = β_κ (algebraMap R₁ κ₀ x) := by rw [inv_mul_cancel₀ hcs_ne, mul_one]
        _ = algebraMap D_Y L_Y (θ_Y (ψ₁ x)) := hβκ_eq x
        _ = algebraMap D_Y L_Y (θ_Y (ψ₁ s * b)) := by rw [hsb]
        _ = algebraMap D_Y L_Y (θ_Y b) * β_κ (algebraMap R₁ κ₀ s) := by
          rw [hβκ_eq s, RingHom.comp_apply, map_mul, map_mul, mul_comm]
    choose f_Bκ hf_Bκ using hB₁_in_κ₀
    let φ_Bκ : B₁ →+* κ₀ :=
      { toFun := f_Bκ
        map_one' := β_κ.injective (by rw [hf_Bκ 1, map_one, map_one, map_one])
        map_mul' := fun x y => β_κ.injective (by simp only [hf_Bκ, map_mul])
        map_zero' := β_κ.injective (by rw [hf_Bκ 0, map_zero, map_zero, map_zero])
        map_add' := fun x y => β_κ.injective (by simp only [hf_Bκ, map_add]) }
    have hcomp_Bκ : β_κ.comp φ_Bκ = (algebraMap D_Y L_Y).comp θ_Y :=
      RingHom.ext fun b => hf_Bκ b
    let _ : Algebra κ₀ L_Y := β_κ.toAlgebra
    have hDR_DY : ∀ d : D_Y, ∃ x s : R₁, s ≠ 0 ∧ ψ_Y s * d = ψ_Y x := by
      intro d
      obtain ⟨P_B, hPB_monic, hPB_eval⟩ := hInt_αBY d
      let P₁ : Polynomial B₁ := P_B.map π_B
      have hP₁_monic : P₁.Monic := hPB_monic.map π_B
      have hP₁_eval : Polynomial.eval₂ θ_Y d P₁ = 0 := by
        rw [Polynomial.eval₂_map]
        exact hPB_eval
      let P_κ : Polynomial κ₀ := P₁.map φ_Bκ
      have hInt_dbar : IsIntegral κ₀ (algebraMap D_Y L_Y d) := by
        refine ⟨P_κ, hP₁_monic.map φ_Bκ, ?_⟩
        change Polynomial.eval₂ β_κ (algebraMap D_Y L_Y d) (P₁.map φ_Bκ) = 0
        rw [Polynomial.eval₂_map, hcomp_Bκ, ← Polynomial.hom_eval₂, hP₁_eval, map_zero]
      have hdbar_mem : algebraMap D_Y L_Y d ∈ algebraicClosure κ₀ L_Y :=
        mem_algebraicClosure_iff'.mpr hInt_dbar
      have hBij_alg :=
        IsAlgClosed.algebraMap_bijective_of_isIntegral (k := κ₀) (K := ↥(algebraicClosure κ₀ L_Y))
      obtain ⟨q, hq_sub⟩ := hBij_alg.2 ⟨algebraMap D_Y L_Y d, hdbar_mem⟩
      have hq : β_κ q = algebraMap D_Y L_Y d := congrArg Subtype.val hq_sub
      obtain ⟨⟨x, s⟩, hqs⟩ := IsLocalization.surj (nonZeroDivisors R₁) q
      refine ⟨x, s.1, nonZeroDivisors.ne_zero s.2, hInj_LY ?_⟩
      calc
        algebraMap D_Y L_Y (ψ_Y s.1 * d)
          = algebraMap D_Y L_Y d * algebraMap D_Y L_Y (ψ_Y s.1) := by rw [map_mul, mul_comm]
        _ = β_κ q * β_κ (algebraMap R₁ κ₀ s.1) := by rw [hq, hβκ_eq s.1]
        _ = β_κ (q * algebraMap R₁ κ₀ s.1) := (map_mul β_κ _ _).symm
        _ = β_κ (algebraMap R₁ κ₀ x) := by rw [hqs]
        _ = algebraMap D_Y L_Y (ψ_Y x) := hβκ_eq x
    have hInj_ψY_spec : Function.Injective (PrimeSpectrum.comap ψ_Y) :=
      (hVal_and_Inj R₁ D_Y ψ_Y hInj_ψY hDR_DY).2
    have hInj_πV_spec : Function.Injective (PrimeSpectrum.comap π_V) :=
      PrimeSpectrum.comap_injective_of_surjective π_V Ideal.Quotient.mk_surjective
    have hcomp_eq : ψ_Y.comp π_V = π_Y.comp (φ_BY.comp φ_V) := RingHom.ext fun _ => rfl
    intro p₁ p₂ hp_eq
    have hp₁_prime : (Ideal.map π_Y p₁.asIdeal).IsPrime :=
      Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective
        (by rw [Ideal.mk_ker]; exact hη_min p₁)
    have hp₂_prime : (Ideal.map π_Y p₂.asIdeal).IsPrime :=
      Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective
        (by rw [Ideal.mk_ker]; exact hη_min p₂)
    let q₁ : PrimeSpectrum D_Y := ⟨Ideal.map π_Y p₁.asIdeal, hp₁_prime⟩
    let q₂ : PrimeSpectrum D_Y := ⟨Ideal.map π_Y p₂.asIdeal, hp₂_prime⟩
    have hq₁_comap : PrimeSpectrum.comap π_Y q₁ = p₁ := by
      apply PrimeSpectrum.ext
      change Ideal.comap π_Y (Ideal.map π_Y p₁.asIdeal) = p₁.asIdeal
      rw [Ideal.comap_map_of_surjective π_Y Ideal.Quotient.mk_surjective,
        ← RingHom.ker_eq_comap_bot, Ideal.mk_ker, sup_eq_left.mpr (hη_min p₁)]
    have hq₂_comap : PrimeSpectrum.comap π_Y q₂ = p₂ := by
      apply PrimeSpectrum.ext
      change Ideal.comap π_Y (Ideal.map π_Y p₂.asIdeal) = p₂.asIdeal
      rw [Ideal.comap_map_of_surjective π_Y Ideal.Quotient.mk_surjective,
        ← RingHom.ker_eq_comap_bot, Ideal.mk_ker, sup_eq_left.mpr (hη_min p₂)]
    have hq_eq : q₁ = q₂ := by
      apply hInj_ψY_spec
      apply hInj_πV_spec
      change PrimeSpectrum.comap (ψ_Y.comp π_V) q₁ = PrimeSpectrum.comap (ψ_Y.comp π_V) q₂
      rw [hcomp_eq]
      change PrimeSpectrum.comap (φ_BY.comp φ_V) (PrimeSpectrum.comap π_Y q₁) =
        PrimeSpectrum.comap (φ_BY.comp φ_V) (PrimeSpectrum.comap π_Y q₂)
      rw [hq₁_comap, hq₂_comap, hp_eq]
    rw [← hq₁_comap, ← hq₂_comap, hq_eq]

  
  have hHom_cont : Continuous (fun u : ↥U_ss => (U_ss.isoSpec.hom.base u : PrimeSpectrum B)) :=
    U_ss.isoSpec.hom.continuous
  have hSpec_iff : ∀ w₁ w₂ : ↥U_ss,
      w₁ ∈ closure ({w₂} : Set ↥U_ss) ↔
        (U_ss.isoSpec.hom.base w₂ : PrimeSpectrum B).asIdeal ≤
          (U_ss.isoSpec.hom.base w₁ : PrimeSpectrum B).asIdeal := by
    intro w₁ w₂
    let p₁ : PrimeSpectrum B := U_ss.isoSpec.hom.base w₁
    let p₂ : PrimeSpectrum B := U_ss.isoSpec.hom.base w₂
    change w₁ ∈ closure ({w₂} : Set ↥U_ss) ↔ p₂ ≤ p₁
    rw [PrimeSpectrum.le_iff_mem_closure]
    constructor
    · exact fun hw => hMap_cl_sing hHom_cont hw
    · intro hw
      have h1 := hMap_cl_sing hInv_cont hw
      rw [hIso_ss_hom_inv w₁, hIso_ss_hom_inv w₂] at h1
      exact h1

  have hu₀_cl : IsClosed ({u₀} : Set ↥U_ss) := by
    have h1 := h_mod.isClosedMap ({x₀} : Set ↥U'.toScheme) hx₀_cl
    have himg : h_mod.base '' ({x₀} : Set ↥U'.toScheme) = ({u₀} : Set ↥U_ss) :=
      Set.image_singleton
    rwa [himg] at h1
  have hu₀_in_cl : u₀ ∈ closure ({u_gen} : Set ↥U_ss) := by
    have hspec_WB : (⟨u₀, hu₀⟩ : ↥W_B.toScheme) ∈ closure ({u_WB} : Set ↥W_B.toScheme) :=
      hu₀_spec_all u_WB hu_WB_mem
    exact hMap_cl_sing (f := fun y : ↥W_B.toScheme => W_B.ι.base y) W_B.ι.continuous hspec_WB
  have hSpec_u₀ : ∀ w ∈ closure ({u_gen} : Set ↥U_ss), u₀ ∈ closure ({w} : Set ↥U_ss) := by
    intro w hw
    have hw_le : q_B.asIdeal ≤ (U_ss.isoSpec.hom.base w).asIdeal := (hSpec_iff w u_gen).mp hw
    have hu₀_le : q_B.asIdeal ≤ (U_ss.isoSpec.hom.base u₀).asIdeal :=
      (hSpec_iff u₀ u_gen).mp hu₀_in_cl
    rcases hTot_B _ _ hw_le hu₀_le with h1 | h2
    · exact (hSpec_iff u₀ w).mpr h1
    · have hw_in_u₀ : w ∈ closure ({u₀} : Set ↥U_ss) := (hSpec_iff w u₀).mpr h2
      rw [hu₀_cl.closure_eq, Set.mem_singleton_iff] at hw_in_u₀
      rw [hw_in_u₀]
      exact subset_closure rfl
  have hCl_sub_WB : closure ({u_gen} : Set ↥U_ss) ⊆ (W_B : Set ↥U_ss) := by
    intro w hw
    obtain ⟨t, ht_WB, ht_w⟩ := mem_closure_iff.mp (hSpec_u₀ w hw) (W_B : Set ↥U_ss) W_B.isOpen hu₀
    rw [Set.mem_singleton_iff] at ht_w
    exact ht_w ▸ ht_WB

  have hMod_eq_cl : Mod_q0 = closure ({z₀} : Set ↥X'_0) := by
    refine Set.Subset.antisymm ?_
      (hMod_closed.closure_subset_iff.mpr (Set.singleton_subset_iff.mpr hz₀_mem))
    intro x' hx'
    obtain ⟨y, rfl⟩ := q_0.surjective x'
    have hy_cl : y ∈ closure (q_0.base ⁻¹' ({z₀} : Set ↥X'_0)) := hFexc_eq ▸ hx'
    have hsub_q : q_0.base ⁻¹' ({z₀} : Set ↥X'_0) ⊆
        (fun w => q_0.base w) ⁻¹' closure ({z₀} : Set ↥X'_0) := fun w hw => by
      change q_0.base w ∈ closure ({z₀} : Set ↥X'_0)
      rw [Set.mem_preimage.mp hw]
      exact subset_closure rfl
    exact (isClosed_closure.preimage q_0.continuous).closure_subset_iff.mpr hsub_q hy_cl
  have hf'0_Mod_eq : f'_0.base '' Mod_q0 = closure ({u_WB} : Set ↥W_B.toScheme) := by
    refine Set.Subset.antisymm ?_ ?_
    · rw [hMod_eq_cl]
      rintro _ ⟨x', hx', rfl⟩
      exact hMap_cl_sing (f := fun z : ↥X'_0 => f'_0.base z) f'_0.continuous hx'
    · exact (f'_0.isClosedMap Mod_q0 hMod_closed).closure_subset_iff.mpr
        (Set.singleton_subset_iff.mpr ⟨z₀, hz₀_mem, rfl⟩)
  have hK_eq_cl : W_B.ι.base '' (f'_0.base '' Mod_q0) = closure ({u_gen} : Set ↥U_ss) := by
    rw [hf'0_Mod_eq]
    refine Set.Subset.antisymm ?_ ?_
    · rintro _ ⟨y, hy, rfl⟩
      exact hMap_cl_sing (f := fun z : ↥W_B.toScheme => W_B.ι.base z) W_B.ι.continuous hy
    · intro w hw
      let y_w : ↥W_B.toScheme := ⟨w, hCl_sub_WB hw⟩
      refine ⟨y_w, ?_, rfl⟩
      rw [W_B.ι.isEmbedding.isInducing.closure_eq_preimage_closure_image]
      have himg : W_B.ι.base '' ({u_WB} : Set ↥W_B.toScheme) = ({u_gen} : Set ↥U_ss) :=
        Set.image_singleton
      change w ∈ closure (W_B.ι.base '' ({u_WB} : Set ↥W_B.toScheme))
      rw [himg]
      exact hw
  have hK_cl : IsClosed (W_B.ι.base '' (f'_0.base '' Mod_q0)) := hK_eq_cl ▸ isClosed_closure

  let F_0 : Set ↥X_0.toScheme := q_0.base ⁻¹' ({z₀} : Set ↥X'_0)
  have hX0_fss : X_0.ι ≫ f_ss_cur = q_0 ≫ f'_0 ≫ W_B.ι := by
    calc
      X_0.ι ≫ f_ss_cur = (f_ss_cur ∣_ W_B) ≫ W_B.ι :=
        (AlgebraicGeometry.morphismRestrict_ι f_ss_cur W_B).symm
      _ = (q_0 ≫ f'_0) ≫ W_B.ι := by rw [hq0_f'0]
      _ = q_0 ≫ f'_0 ≫ W_B.ι := Category.assoc _ _ _
  have hF0_to_ugen : ∀ y ∈ F_0, f_ss_cur.base (X_0.ι.base y) = u_gen := by
    intro y hy
    have hpt : (X_0.ι ≫ f_ss_cur).base y = (q_0 ≫ f'_0 ≫ W_B.ι).base y := by rw [hX0_fss]
    have h1 : f_ss_cur.base (X_0.ι.base y) = (X_0.ι ≫ f_ss_cur).base y := rfl
    have h2 : (q_0 ≫ f'_0 ≫ W_B.ι).base y = W_B.ι.base (f'_0.base (q_0.base y)) := rfl
    have hy_eq : q_0.base y = z₀ := hy
    rw [h1, hpt, h2, hy_eq]
  have hu_gen_mem : u_gen ∈ f_ss_cur.base '' F_contr := by
    obtain ⟨y₀, hy₀⟩ := hIrred_F0.1
    have hy₀_Mod : y₀ ∈ q_0.base ⁻¹' Mod_q0 := by
      change q_0.base y₀ ∈ Mod_q0
      rw [hy₀]
      exact hz₀_mem
    exact ⟨X_0.ι.base y₀, ⟨y₀, hy₀_Mod, rfl⟩, hF0_to_ugen y₀ hy₀⟩
  have hCl_F0_sub : closure (X_0.ι.base '' F_0) ⊆
      (fun c : ↥C_cur => f_ss_cur.base c) ⁻¹' closure ({u_gen} : Set ↥U_ss) := by
    refine (isClosed_closure.preimage f_ss_cur.continuous).closure_subset_iff.mpr ?_
    rintro _ ⟨y, hy, rfl⟩
    change f_ss_cur.base (X_0.ι.base y) ∈ closure ({u_gen} : Set ↥U_ss)
    rw [hF0_to_ugen y hy]
    exact subset_closure rfl
  have hF_eq : F_contr = closure (X_0.ι.base '' F_0) := by
    change X_0.ι.base '' (q_0.base ⁻¹' Mod_q0) = closure (X_0.ι.base '' F_0)
    rw [hFexc_eq]
    refine Set.Subset.antisymm
      (image_closure_subset_closure_image X_0.ι.continuous) ?_
    intro c hc
    have hc_WB : c ∈ (X_0 : Set ↥C_cur) := hCl_sub_WB (hCl_F0_sub hc)
    let y_c : ↥X_0.toScheme := ⟨c, hc_WB⟩
    refine ⟨y_c, ?_, rfl⟩
    rw [X_0.ι.isEmbedding.isInducing.closure_eq_preimage_closure_image]
    exact hc
  have hF_cl : IsClosed F_contr := hF_eq ▸ isClosed_closure
  have hF_irred : IsIrreducible F_contr :=
    hF_eq ▸ (hIrred_F0.image X_0.ι.base X_0.ι.continuous.continuousOn).closure
  have hSub_cl : f_ss_cur.base '' F_contr ⊆ closure ({u_gen} : Set ↥U_ss) :=
    Set.image_subset_iff.mpr (hF_eq ▸ hCl_F0_sub)

  
  let s_P := AlgebraicGeometry.Spec.map
    (CommRingCat.ofHom (algebraMap ↥V P.asIdeal.ResidueField))
  let fst_P := CategoryTheory.Limits.pullback.fst g_cur s_P
  let Y_dom : Set ↥U'.toScheme := f_dom_cur.base '' F_contr
  have hx₀_mem : x₀ ∈ Y_dom := by
    obtain ⟨q_star, hq_star⟩ := hZ_nonempty
    let c_star : ↥C_cur := fst_P.base q_star
    have hc_x₀ : f_dom_cur.base c_star = x₀ := hZ_x₀ q_star hq_star
    have hc_X0 : c_star ∈ X_0 := by
      change h_mod.base (f_dom_cur.base c_star) ∈ W_B
      rw [hc_x₀]
      exact hu₀
    let y_star : ↥X_0.toScheme := ⟨c_star, hc_X0⟩
    have hy_ZX0 : y_star ∈ X_0.ι.base ⁻¹' (fst_P.base '' Z) := ⟨q_star, hq_star, rfl⟩
    rw [← hFexc_P] at hy_ZX0
    exact ⟨c_star, ⟨y_star, hy_ZX0.1, rfl⟩, hc_x₀⟩
  have hx₀_uniq : ∀ x ∈ Y_dom, h_mod.base x = u₀ → x = x₀ := by
    rintro _ ⟨_, ⟨y, hy_Mod, rfl⟩, rfl⟩ hhx
    have hy_P : (((f_dom_cur ≫ h_mod) ∣_ W_B) ≫ g_WB ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_VP)).base y = P := by
      have hcomm_y : ((f_dom_cur ≫ h_mod) ∣_ W_B) ≫ g_WB ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_VP) =
          X_0.ι ≫ f_dom_cur ≫ h_mod ≫ g_ss := by
        rw [hComm_WB, ← Category.assoc, AlgebraicGeometry.morphismRestrict_ι, Category.assoc,
          Category.assoc]
      rw [hcomm_y]
      change g_ss.base (h_mod.base (f_dom_cur.base (X_0.ι.base y))) = P
      rw [hhx]
      change (h_mod ≫ g_ss).base x₀ = P
      rw [hComm_mod]
      exact hx₀_P
    have hy_ZX0 : y ∈ X_0.ι.base ⁻¹' (fst_P.base '' Z) := by
      rw [← hFexc_P]
      exact ⟨hy_Mod, hy_P⟩
    rcases hy_ZX0 with ⟨q, hqZ, hq_eq⟩
    change f_dom_cur.base (X_0.ι.base y) = x₀
    rw [← hq_eq]
    exact hZ_x₀ q hqZ

  have hY_cl : IsClosed Y_dom := f_dom_cur.isClosedMap F_contr hF_cl
  have hY_irred : IsIrreducible Y_dom :=
    hF_irred.image f_dom_cur.base f_dom_cur.continuous.continuousOn
  let I_Y : U'.toScheme.IdealSheafData :=
    AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal ⟨Y_dom, hY_cl⟩
  let Y_sch : AlgebraicGeometry.Scheme.{u} := I_Y.subscheme
  let ι_Y : Y_sch ⟶ U'.toScheme := I_Y.subschemeι
  have hRange_ιY : Set.range ι_Y.base = Y_dom := by
    rw [I_Y.range_subschemeι, AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal]
    rfl
  obtain ⟨x0_Y, hx0_Y⟩ : ∃ x0_Y : ↥Y_sch, ι_Y.base x0_Y = x₀ := by
    rw [← hRange_ιY] at hx₀_mem
    exact hx₀_mem
  have hIrred_Ysch : IrreducibleSpace ↥Y_sch := by
    refine { toPreirreducibleSpace := ⟨?_⟩, toNonempty := ⟨x0_Y⟩ }
    rw [isPreirreducible_iff_isClosed_union_isClosed]
    intro Z₁ Z₂ hZ₁ hZ₂ huniv
    have hY_sub : Y_dom ⊆ (ι_Y.base '' Z₁) ∪ (ι_Y.base '' Z₂) := by
      rw [← hRange_ιY, ← Set.image_univ, ← Set.image_union]
      exact Set.image_mono huniv
    rcases (isPreirreducible_iff_isClosed_union_isClosed.mp hY_irred.2)
        (ι_Y.base '' Z₁) (ι_Y.base '' Z₂)
        (ι_Y.isClosedMap Z₁ hZ₁) (ι_Y.isClosedMap Z₂ hZ₂) hY_sub with h₁ | h₂
    · left
      intro y _
      have hy_mem : ι_Y.base y ∈ ι_Y.base '' Z₁ := h₁ (hRange_ιY ▸ ⟨y, rfl⟩)
      rcases hy_mem with ⟨z, hz, hzy⟩
      exact ι_Y.isEmbedding.injective hzy ▸ hz
    · right
      intro y _
      have hy_mem : ι_Y.base y ∈ ι_Y.base '' Z₂ := h₂ (hRange_ιY ▸ ⟨y, rfl⟩)
      rcases hy_mem with ⟨z, hz, hzy⟩
      exact ι_Y.isEmbedding.injective hzy ▸ hz

  obtain ⟨W_x, hWx_aff, hx0_Wx, _⟩ :=
    AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := (⊤ : Y_sch.Opens)) (x := x0_Y) trivial
  let p_ss : Y_sch ⟶ U_ss := ι_Y ≫ h_mod
  have hWx_top : W_x = ⊤ := by
    apply TopologicalSpace.Opens.ext
    refine Set.eq_univ_of_forall fun y_Y => ?_
    by_contra hy_not
    let K_bad : Set ↥U_ss := p_ss.base '' ((W_x : Set ↥Y_sch)ᶜ)
    have hK_bad_cl : IsClosed K_bad := p_ss.isClosedMap _ W_x.isOpen.isClosed_compl
    have hw_bad : p_ss.base y_Y ∈ K_bad := ⟨y_Y, hy_not, rfl⟩
    have hw_cl : p_ss.base y_Y ∈ closure ({u_gen} : Set ↥U_ss) := by
      have hy_dom : ι_Y.base y_Y ∈ Y_dom := hRange_ιY ▸ ⟨y_Y, rfl⟩
      rcases hy_dom with ⟨c, hcF, hc_eq⟩
      apply hSub_cl
      refine ⟨c, hcF, ?_⟩
      change h_mod.base (f_dom_cur.base c) = h_mod.base (ι_Y.base y_Y)
      rw [hc_eq]
    have hu₀_bad : u₀ ∈ K_bad :=
      (hK_bad_cl.closure_subset_iff.mpr (Set.singleton_subset_iff.mpr hw_bad))
        (hSpec_u₀ (p_ss.base y_Y) hw_cl)
    rcases hu₀_bad with ⟨y1_Y, hy1_not, hy1_eq⟩
    have hy1_dom : ι_Y.base y1_Y ∈ Y_dom := hRange_ιY ▸ ⟨y1_Y, rfl⟩
    have hmod_y1 : h_mod.base (ι_Y.base y1_Y) = u₀ := hy1_eq
    have hι_eq : ι_Y.base y1_Y = ι_Y.base x0_Y :=
      (hx₀_uniq (ι_Y.base y1_Y) hy1_dom hmod_y1).trans hx0_Y.symm
    exact hy1_not (ι_Y.isEmbedding.injective hι_eq ▸ hx0_Wx)
  have hTop_aff : AlgebraicGeometry.IsAffineOpen (⊤ : Y_sch.Opens) := hWx_top ▸ hWx_aff
  let _ : AlgebraicGeometry.IsAffine (⊤ : Y_sch.Opens).toScheme := hTop_aff
  have : AlgebraicGeometry.IsAffine Y_sch :=
    AlgebraicGeometry.isAffine_of_isAffineHom Y_sch.topIso.inv
  have : AlgebraicGeometry.IsAffineHom p_ss := AlgebraicGeometry.isAffineHom_of_isAffine p_ss
  have : AlgebraicGeometry.IsFinite p_ss :=
    AlgebraicGeometry.IsFinite.iff_isProper_and_isAffineHom.mpr ⟨inferInstance, inferInstance⟩

  let A_Y : Type u := ↑(Y_sch.presheaf.obj (Opposite.op ⊤))
  let φ_BY : B →+* A_Y := (p_ss.appTop).hom
  have hIso_Y_hom_inv : ∀ y : ↥Y_sch, Y_sch.isoSpec.inv.base (Y_sch.isoSpec.hom.base y) = y := by
    intro y
    change (Y_sch.isoSpec.hom ≫ Y_sch.isoSpec.inv).base y = y
    rw [Iso.hom_inv_id]
    rfl
  have hIso_Y_inv_hom : ∀ p : PrimeSpectrum A_Y,
      Y_sch.isoSpec.hom.base (Y_sch.isoSpec.inv.base p) = p := by
    intro p
    change (Y_sch.isoSpec.inv ≫ Y_sch.isoSpec.hom).base p = p
    rw [Iso.inv_hom_id]
    rfl
  have hFin_BY : φ_BY.Finite :=
    AlgebraicGeometry.IsFinite.finite_app p_ss ⊤ (isAffineOpen_top U_ss)
  have hComap_pss : ∀ y_Y : ↥Y_sch,
      PrimeSpectrum.comap φ_BY (Y_sch.isoSpec.hom.base y_Y) =
        U_ss.isoSpec.hom.base (p_ss.base y_Y) := by
    intro y_Y
    have hmap : ((AlgebraicGeometry.Spec.map p_ss.appTop).base (Y_sch.isoSpec.hom.base y_Y) :
        PrimeSpectrum B) = PrimeSpectrum.comap φ_BY (Y_sch.isoSpec.hom.base y_Y) := by
      rw [AlgebraicGeometry.Spec.map_base]
      rfl
    have hnat_pt : ((Y_sch.isoSpec.hom ≫ AlgebraicGeometry.Spec.map p_ss.appTop).base y_Y :
        PrimeSpectrum B) = U_ss.isoSpec.hom.base (p_ss.base y_Y) :=
      congrArg (fun f => (f.base y_Y : PrimeSpectrum B))
        (AlgebraicGeometry.Scheme.isoSpec_hom_naturality p_ss)
    exact hmap.symm.trans hnat_pt
  have : IrreducibleSpace (PrimeSpectrum A_Y) := by
    refine { toPreirreducibleSpace := ⟨?_⟩, toNonempty := ⟨Y_sch.isoSpec.hom.base x0_Y⟩ }
    have huniv : (fun y : ↥Y_sch => (Y_sch.isoSpec.hom.base y : PrimeSpectrum A_Y)) ''
        (Set.univ : Set ↥Y_sch) = (Set.univ : Set (PrimeSpectrum A_Y)) :=
      Set.eq_univ_of_forall fun p => ⟨Y_sch.isoSpec.inv.base p, trivial, hIso_Y_inv_hom p⟩
    change IsPreirreducible (Set.univ : Set (PrimeSpectrum A_Y))
    rw [← huniv]
    exact (@PreirreducibleSpace.isPreirreducible_univ ↥Y_sch _
      hIrred_Ysch.toPreirreducibleSpace).image
      (fun y : ↥Y_sch => (Y_sch.isoSpec.hom.base y : PrimeSpectrum A_Y))
      Y_sch.isoSpec.hom.continuous.continuousOn
  let η_Y : PrimeSpectrum A_Y := genericPoint (PrimeSpectrum A_Y)
  have hη_min : ∀ p : PrimeSpectrum A_Y, η_Y.asIdeal ≤ p.asIdeal := by
    intro p
    change η_Y ≤ p
    rw [PrimeSpectrum.le_iff_mem_closure, genericPoint_closure]
    trivial
  have hη_comap : PrimeSpectrum.comap φ_BY η_Y = q_B := by
    apply PrimeSpectrum.ext
    refine le_antisymm ?_ ?_
    · rcases hu_gen_mem with ⟨c_gen, hc_gen_F, hc_gen_eq⟩
      have hdom_gen : f_dom_cur.base c_gen ∈ Set.range ι_Y.base :=
        hRange_ιY.symm ▸ ⟨c_gen, hc_gen_F, rfl⟩
      rcases hdom_gen with ⟨y_gen, hy_gen⟩
      have hpss_gen : p_ss.base y_gen = u_gen := by
        change h_mod.base (ι_Y.base y_gen) = u_gen
        rw [hy_gen]
        exact hc_gen_eq
      have hle_gen : (PrimeSpectrum.comap φ_BY η_Y).asIdeal ≤
          (PrimeSpectrum.comap φ_BY (Y_sch.isoSpec.hom.base y_gen)).asIdeal :=
        Ideal.comap_mono (hη_min (Y_sch.isoSpec.hom.base y_gen))
      rw [hComap_pss y_gen, hpss_gen] at hle_gen
      exact hle_gen
    · let y_eta : ↥Y_sch := Y_sch.isoSpec.inv.base η_Y
      have hy_eta_eq : Y_sch.isoSpec.hom.base y_eta = η_Y := hIso_Y_inv_hom η_Y
      have hpss_η : p_ss.base y_eta ∈ closure ({u_gen} : Set ↥U_ss) := by
        have hy_dom : ι_Y.base y_eta ∈ Y_dom := hRange_ιY ▸ ⟨y_eta, rfl⟩
        rcases hy_dom with ⟨c, hcF, hc_eq⟩
        apply hSub_cl
        refine ⟨c, hcF, ?_⟩
        change h_mod.base (f_dom_cur.base c) = h_mod.base (ι_Y.base y_eta)
        rw [hc_eq]
      have hle_η : q_B.asIdeal ≤ (U_ss.isoSpec.hom.base (p_ss.base y_eta)).asIdeal :=
        (hSpec_iff (p_ss.base y_eta) u_gen).mp hpss_η
      rw [← hComap_pss y_eta, hy_eta_eq] at hle_η
      exact hle_η

  have hInj_YV : Function.Injective (PrimeSpectrum.comap (φ_BY.comp φ_V)) :=
    hInj_comap A_Y φ_BY η_Y hFin_BY hη_min hη_comap
  refine ⟨hF_cl, hK_cl, fun Q => ?_⟩
  rintro _ ⟨c₁, ⟨hc₁F, hc₁Q⟩, rfl⟩ _ ⟨c₂, ⟨hc₂F, hc₂Q⟩, rfl⟩
  have hdom₁ : f_dom_cur.base c₁ ∈ Set.range ι_Y.base := hRange_ιY.symm ▸ ⟨c₁, hc₁F, rfl⟩
  have hdom₂ : f_dom_cur.base c₂ ∈ Set.range ι_Y.base := hRange_ιY.symm ▸ ⟨c₂, hc₂F, rfl⟩
  rcases hdom₁ with ⟨y1_Y, hy1_Y⟩
  rcases hdom₂ with ⟨y2_Y, hy2_Y⟩
  have hQ_y : ∀ (y_Y : ↥Y_sch) (c : ↥C_cur),
      ι_Y.base y_Y = f_dom_cur.base c → g_cur.base c = Q →
      PrimeSpectrum.comap (φ_BY.comp φ_V) (Y_sch.isoSpec.hom.base y_Y) = Q := by
    intro y_Y c hy_Y hcQ
    change PrimeSpectrum.comap φ_V (PrimeSpectrum.comap φ_BY (Y_sch.isoSpec.hom.base y_Y)) = Q
    rw [hComap_pss y_Y, hComap_gss (p_ss.base y_Y)]
    have h1 : g_ss.base (p_ss.base y_Y) = (ι_Y ≫ h_mod ≫ g_ss).base y_Y := rfl
    rw [h1, hComm_mod]
    change (U'.ι ≫ g').base (ι_Y.base y_Y) = Q
    rw [hy_Y]
    change (f_dom_cur ≫ U'.ι ≫ g').base c = Q
    rw [hfdom_g]
    exact hcQ
  have hspec_eq : Y_sch.isoSpec.hom.base y1_Y = Y_sch.isoSpec.hom.base y2_Y :=
    hInj_YV ((hQ_y y1_Y c₁ hy1_Y hc₁Q).trans (hQ_y y2_Y c₂ hy2_Y hc₂Q).symm)
  have hy_eq : y1_Y = y2_Y := by
    rw [← hIso_Y_hom_inv y1_Y, hspec_eq, hIso_Y_hom_inv y2_Y]
  rw [← hy1_Y, ← hy2_Y, hy_eq]

theorem weil_two_open_chart_contraction_gluing (C_cur U_ss X'_0 : AlgebraicGeometry.Scheme.{u})
    (f_ss_cur : C_cur ⟶ U_ss)
    (hProp_fss : AlgebraicGeometry.IsProper f_ss_cur)
    (W_B : U_ss.Opens)
    (f'_0 : X'_0 ⟶ W_B.toScheme)
    (hProp_f'0 : AlgebraicGeometry.IsProper f'_0)
    (q_0 : AlgebraicGeometry.Scheme.Opens.toScheme
      ((TopologicalSpace.Opens.map f_ss_cur.base).obj W_B) ⟶ X'_0)
    (hq0_comm : q_0 ≫ f'_0 = f_ss_cur ∣_ W_B)
    (hProp_q0 : AlgebraicGeometry.IsProper q_0)
    (hSurj_q0 : AlgebraicGeometry.Surjective q_0)
    (Mod_q0 : Set ↥X'_0)
    (hMod_closed : IsClosed Mod_q0)
    (hIso_q0 : CategoryTheory.IsIso
      (q_0 ∣_ (⟨Mod_q0ᶜ, hMod_closed.isOpen_compl⟩ : X'_0.Opens)))
    (hF_cl : IsClosed
      ((AlgebraicGeometry.Scheme.Opens.ι (X := C_cur)
        ((TopologicalSpace.Opens.map f_ss_cur.base).obj W_B)).base '' (q_0.base ⁻¹' Mod_q0)))
    (hK_cl : IsClosed (W_B.ι.base '' (f'_0.base '' Mod_q0))) :
    let X_0 : C_cur.Opens := (TopologicalSpace.Opens.map f_ss_cur.base).obj W_B
    let F_contr : Set ↥C_cur := X_0.ι.base '' (q_0.base ⁻¹' Mod_q0)
    let U_compl : C_cur.Opens := ⟨F_contrᶜ, hF_cl.isOpen_compl⟩
    ∃ (C_next : AlgebraicGeometry.Scheme.{u})
      (ι_1 : X'_0 ⟶ C_next)
      (ι_2 : U_compl.toScheme ⟶ C_next)
      (q_contr : C_cur ⟶ C_next)
      (f_ss_next : C_next ⟶ U_ss)
      (hM_cl : IsClosed (ι_1.base '' Mod_q0)),
      AlgebraicGeometry.IsOpenImmersion ι_1 ∧
      AlgebraicGeometry.IsOpenImmersion ι_2 ∧
      Set.range ι_1.base ∪ Set.range ι_2.base = Set.univ ∧
      ι_1.base '' Mod_q0 = (Set.range ι_2.base)ᶜ ∧
      q_contr.base ⁻¹' (ι_1.base '' Mod_q0) = F_contr ∧
      X_0.ι ≫ q_contr = q_0 ≫ ι_1 ∧
      U_compl.ι ≫ q_contr = ι_2 ∧
      ι_1 ≫ f_ss_next = f'_0 ≫ W_B.ι ∧
      ι_2 ≫ f_ss_next = U_compl.ι ≫ f_ss_cur ∧
      q_contr ≫ f_ss_next = f_ss_cur ∧
      AlgebraicGeometry.IsProper q_contr ∧
      AlgebraicGeometry.Surjective q_contr ∧
      AlgebraicGeometry.IsProper f_ss_next ∧
      CategoryTheory.IsIso
        (q_contr ∣_ (⟨(ι_1.base '' Mod_q0)ᶜ, hM_cl.isOpen_compl⟩ : C_next.Opens)) :=
by
  classical
  intro X_0 F_contr U_compl
  have hRestrictFactor : ∀ {X Y U : AlgebraicGeometry.Scheme.{u}}
      (f : X ⟶ Y) (W : Y.Opens) (iU : U ⟶ X) [AlgebraicGeometry.IsOpenImmersion iU]
      (g : U ⟶ W.toScheme),
      iU ≫ f = g ≫ W.ι →
      f.base ⁻¹' (W : Set ↥Y) = Set.range iU.base →
      ∃ e : AlgebraicGeometry.Scheme.Opens.toScheme
          ((TopologicalSpace.Opens.map f.base).obj W) ≅ U,
        f ∣_ W = e.hom ≫ g := by
    intro X Y U f W iU _ g hcomm hpre
    have hOpens : (TopologicalSpace.Opens.map f.base).obj W.ι.opensRange = iU.opensRange := by
      apply TopologicalSpace.Opens.ext
      change f.base ⁻¹' (Set.range ⇑W.ι) = Set.range ⇑iU
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      exact hpre
    have hPb : CategoryTheory.IsPullback iU g f W.ι :=
      (AlgebraicGeometry.IsOpenImmersion.isPullback g iU W.ι f hcomm hOpens).flip
    refine ⟨(AlgebraicGeometry.pullbackRestrictIsoRestrict f W).symm ≪≫ hPb.isoPullback.symm, ?_⟩
    calc
      f ∣_ W = (AlgebraicGeometry.pullbackRestrictIsoRestrict f W).inv ≫
          ((AlgebraicGeometry.pullbackRestrictIsoRestrict f W).hom ≫ (f ∣_ W)) := by
        rw [CategoryTheory.Iso.inv_hom_id_assoc]
      _ = (AlgebraicGeometry.pullbackRestrictIsoRestrict f W).inv ≫
          CategoryTheory.Limits.pullback.snd f W.ι := by
        rw [AlgebraicGeometry.pullbackRestrictIsoRestrict_hom_morphismRestrict]
      _ = (AlgebraicGeometry.pullbackRestrictIsoRestrict f W).inv ≫
          hPb.isoPullback.inv ≫ (hPb.isoPullback.hom ≫ CategoryTheory.Limits.pullback.snd f W.ι) := by
        rw [CategoryTheory.Iso.inv_hom_id_assoc]
      _ = ((AlgebraicGeometry.pullbackRestrictIsoRestrict f W).symm ≪≫ hPb.isoPullback.symm).hom ≫ g := by
        rw [hPb.isoPullback_hom_snd, CategoryTheory.Iso.trans_hom, CategoryTheory.Iso.symm_hom,
          CategoryTheory.Iso.symm_hom, CategoryTheory.Category.assoc]
  
  let V_01 : X'_0.Opens := ⟨Mod_q0ᶜ, hMod_closed.isOpen_compl⟩
  let X_0ov : X_0.toScheme.Opens := (TopologicalSpace.Opens.map q_0.base).obj V_01
  let V_10 : U_compl.toScheme.Opens := (TopologicalSpace.Opens.map U_compl.ι.base).obj X_0
  have : CategoryTheory.IsIso (q_0 ∣_ V_01) := hIso_q0
  let β_ov : X_0ov.toScheme ≅ V_01.toScheme := CategoryTheory.asIso (q_0 ∣_ V_01)
  have hβ_comm : β_ov.hom ≫ V_01.ι = X_0ov.ι ≫ q_0 :=
    AlgebraicGeometry.morphismRestrict_ι q_0 V_01
  have h_range : Set.range ⇑(X_0ov.ι ≫ X_0.ι) = Set.range ⇑(V_10.ι ≫ U_compl.ι) := by
    refine Set.Subset.antisymm ?_ ?_
    · rintro _ ⟨w, rfl⟩
      let x : ↥X_0.toScheme := X_0ov.ι.base w
      have hx_ov : x ∈ X_0ov := by
        have : x ∈ Set.range ⇑X_0ov.ι := ⟨w, rfl⟩
        rwa [AlgebraicGeometry.Scheme.Opens.range_ι] at this
      have hqx_not_mod : q_0.base x ∉ Mod_q0 := hx_ov
      have hc_X0 : X_0.ι.base x ∈ X_0 := by
        have : X_0.ι.base x ∈ Set.range ⇑X_0.ι := ⟨x, rfl⟩
        rwa [AlgebraicGeometry.Scheme.Opens.range_ι] at this
      have hc_not_F : X_0.ι.base x ∉ F_contr := by
        rintro ⟨x', hx'_mod, hx'_eq⟩
        have hxx' : x' = x := X_0.ι.isOpenEmbedding.injective hx'_eq
        exact hqx_not_mod (hxx' ▸ hx'_mod)
      have hc_U : X_0.ι.base x ∈ Set.range ⇑U_compl.ι := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        exact hc_not_F
      rcases hc_U with ⟨u, hu⟩
      have hu_V10 : u ∈ Set.range ⇑V_10.ι := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        change U_compl.ι.base u ∈ X_0
        rw [hu]
        exact hc_X0
      rcases hu_V10 with ⟨v, hv⟩
      refine ⟨v, ?_⟩
      change U_compl.ι.base (V_10.ι.base v) = X_0.ι.base x
      rw [hv, hu]
    · rintro _ ⟨v, rfl⟩
      let u : ↥U_compl.toScheme := V_10.ι.base v
      have hu_V10 : u ∈ V_10 := by
        have : u ∈ Set.range ⇑V_10.ι := ⟨v, rfl⟩
        rwa [AlgebraicGeometry.Scheme.Opens.range_ι] at this
      have hc_X0 : U_compl.ι.base u ∈ Set.range ⇑X_0.ι := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        exact hu_V10
      rcases hc_X0 with ⟨x, hx⟩
      have hc_U : U_compl.ι.base u ∈ U_compl := by
        have : U_compl.ι.base u ∈ Set.range ⇑U_compl.ι := ⟨u, rfl⟩
        rwa [AlgebraicGeometry.Scheme.Opens.range_ι] at this
      have hc_not_F : U_compl.ι.base u ∉ F_contr := hc_U
      have hx_ov : x ∈ Set.range ⇑X_0ov.ι := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        change q_0.base x ∉ Mod_q0
        intro hqx_mod
        exact hc_not_F ⟨x, hqx_mod, hx⟩
      rcases hx_ov with ⟨w, hw⟩
      refine ⟨w, ?_⟩
      change X_0.ι.base (X_0ov.ι.base w) = U_compl.ι.base u
      rw [hw, hx]
  let α_ov : X_0ov.toScheme ≅ V_10.toScheme :=
    AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq (X_0ov.ι ≫ X_0.ι) (V_10.ι ≫ U_compl.ι) h_range
  have hα_comm : α_ov.hom ≫ (V_10.ι ≫ U_compl.ι) = X_0ov.ι ≫ X_0.ι :=
    AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac
      (X_0ov.ι ≫ X_0.ι) (V_10.ι ≫ U_compl.ι) h_range
