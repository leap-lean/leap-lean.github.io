import WeilPart04
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem weil_isolated_chart_coord_and_closed_fiber_alignment (K : Type u) [Field K] [IsSepClosed K]
    (m : ℕ) (V : ValuationSubring K) (hPkg : IsValuationRingAlgPackage m V)
    (P : PrimeSpectrum ↥V) (hP : P.asIdeal ≠ ⊥)
    (hPkg_VP : IsValuationRingAlgPackage m (V.ofPrime P.asIdeal))
    (hMax_VP : IsLocalRing.maximalIdeal ↥(V.ofPrime P.asIdeal) ≠ ⊥)
    (U_ss C_cur : AlgebraicGeometry.Scheme.{u})
    (g_ss : U_ss ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (hAff_ss : AlgebraicGeometry.IsAffine U_ss)
    (hSS : IsStrictlySemistableCurveOverValuation V g_ss)
    (g_cur : C_cur ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (hSS_cur : IsStrictlySemistableCurveOverValuation V g_cur)
    (f_ss_cur : C_cur ⟶ U_ss)
    (hProp_fss : AlgebraicGeometry.IsProper f_ss_cur)
    (hComm_fss : f_ss_cur ≫ g_ss = g_cur)
    (hFinFib_P : (irreducibleComponents ↥(CategoryTheory.Limits.pullback g_cur
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap ↥V P.asIdeal.ResidueField))))).Finite)
    (u₀ : ↥U_ss)
    (ϖ : ↥V) (W_B : U_ss.Opens) (hu₀ : u₀ ∈ W_B)
    (g_WB : W_B.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥(V.ofPrime P.asIdeal)))
    (Z_mod : Set ↥W_B.toScheme) (hZ_closed : IsClosed Z_mod)
    (hChart : IsIsolatedStrictlySemistableModChart V g_ss f_ss_cur P u₀ ϖ W_B hu₀ g_WB
      Z_mod hZ_closed)
    (Z : Set ↥(CategoryTheory.Limits.pullback g_cur
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap ↥V P.asIdeal.ResidueField)))))
    (hZ_irred : Z ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_cur
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap ↥V P.asIdeal.ResidueField)))))
    (hZ_u₀ : ∀ q ∈ Z,
      f_ss_cur.base ((CategoryTheory.Limits.pullback.fst g_cur
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap ↥V P.asIdeal.ResidueField)))).base q) = u₀) :
    let R := V.ofPrime P.asIdeal
    let X_0 : C_cur.Opens := (TopologicalSpace.Opens.map f_ss_cur.base).obj W_B
    let f_0 : X_0.toScheme ⟶ W_B.toScheme := f_ss_cur ∣_ W_B
    let g_X0 := f_0 ≫ g_WB
    let u₀_WB : ↥W_B.toScheme := ⟨u₀, hu₀⟩
    let s_P := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap ↥V P.asIdeal.ResidueField))
    let s_R := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.maximalIdeal ↥R).ResidueField))
    ∃ (a_opt : Option ↥R)
      (M_0 : AlgebraicGeometry.Scheme.{u})
      (g_M0 : M_0 ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
      (m_0 : ↥M_0)
      (e_0 : W_B.toScheme ⟶ M_0)
      (F_0 : Type u) (_ : Field F_0)
      (F_WB : Type u) (_ : Field F_WB)
      (η_M0 : AlgebraicGeometry.Spec (CommRingCat.of F_0) ⟶ M_0)
      (η_WB : AlgebraicGeometry.Spec (CommRingCat.of F_WB) ⟶ W_B.toScheme)
      (η_X0 : AlgebraicGeometry.Spec (CommRingCat.of F_WB) ⟶ X_0.toScheme)
      (φ_KF0 : K →+* F_0)
      (φ_F0_FWB : F_0 →+* F_WB)
      (T_0 : F_0)
      (r_c : ℕ)
      (E_c : Fin r_c → Set ↥(CategoryTheory.Limits.pullback g_X0 s_R))
      (i_Z0 : Fin r_c),
      IsStrictlySemistableCurveOverValuation R g_WB ∧
      IsStrictlySemistableCurveOverValuation R g_X0 ∧
      IsClosed ({u₀_WB} : Set ↥W_B.toScheme) ∧
      (g_WB.base u₀_WB).asIdeal = IsLocalRing.maximalIdeal ↥R ∧
      (∀ y ∈ Z_mod, (g_WB.base y).asIdeal ≠ ⊥) ∧
      IsStandardModelCoordDatum R a_opt M_0 g_M0 m_0 η_M0 φ_KF0 T_0 ∧
      AlgebraicGeometry.Etale e_0 ∧
      e_0 ≫ g_M0 = g_WB ∧
      e_0.base ⁻¹' {m_0} = {u₀_WB} ∧
      (∀ y ∈ Z_mod, e_0.base ⁻¹' {e_0.base y} = {y}) ∧
      IsSchemeFunctionField W_B.toScheme F_WB η_WB ∧
      IsSchemeFunctionField X_0.toScheme F_WB η_X0 ∧
      η_X0 ≫ f_0 = η_WB ∧
      η_WB ≫ e_0 = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_F0_FWB) ≫ η_M0 ∧
      Function.Injective E_c ∧
      (∀ l : Fin r_c,
        E_c l ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_X0 s_R) ∧
        ∀ q ∈ E_c l, f_0.base ((CategoryTheory.Limits.pullback.fst g_X0 s_R).base q) = u₀_WB) ∧
      (∀ E ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_X0 s_R),
        (∀ q ∈ E, f_0.base ((CategoryTheory.Limits.pullback.fst g_X0 s_R).base q) = u₀_WB) →
        ∃ l : Fin r_c, E = E_c l) ∧
      (CategoryTheory.Limits.pullback.fst g_X0 s_R).base '' (E_c i_Z0) =
        X_0.ι.base ⁻¹' ((CategoryTheory.Limits.pullback.fst g_cur s_P).base '' Z) ∧
      {q ∈ Z | ∃ E' ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_cur s_P),
        E' ≠ Z ∧ q ∈ E'}.ncard =
      {q ∈ E_c i_Z0 | ∃ E' ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_X0 s_R),
        E' ≠ E_c i_Z0 ∧ q ∈ E'}.ncard :=
by
  classical
  let R := V.ofPrime P.asIdeal
  let X_0 : C_cur.Opens := (TopologicalSpace.Opens.map f_ss_cur.base).obj W_B
  let f_0 : X_0.toScheme ⟶ W_B.toScheme := f_ss_cur ∣_ W_B
  let g_X0 := f_0 ≫ g_WB
  let u₀_WB : ↥W_B.toScheme := ⟨u₀, hu₀⟩
  let s_P := AlgebraicGeometry.Spec.map
    (CommRingCat.ofHom (algebraMap ↥V P.asIdeal.ResidueField))
  let s_R := AlgebraicGeometry.Spec.map
    (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.maximalIdeal ↥R).ResidueField))
  let ι_VP : ↥V →+* ↥R := Subring.inclusion (ValuationSubring.le_ofPrime V P.asIdeal)
  let j_RV := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_VP)
  obtain ⟨_, _, _, hOpen_VP, hAff_WB, hComm_WB, _, hZ_ss_neBot, hIso_f0_compl, _, hRoof⟩ := hChart
  haveI : AlgebraicGeometry.IsOpenImmersion j_RV := hOpen_VP
  haveI : AlgebraicGeometry.IsAffine W_B.toScheme := hAff_WB

  
  have hInj_VP : Function.Injective ι_VP := fun x y h =>
    Subtype.ext (congrArg (Subtype.val : ↥R → K) h)
  have hWB_ne : Nonempty ↥W_B.toScheme := ⟨u₀_WB⟩
  have hX0_ne : Nonempty ↥X_0.toScheme := by
    obtain ⟨q₀, hq₀⟩ := hZ_irred.1.nonempty
    refine ⟨⟨(CategoryTheory.Limits.pullback.fst g_cur s_P).base q₀, ?_⟩⟩
    change f_ss_cur.base ((CategoryTheory.Limits.pullback.fst g_cur s_P).base q₀) ∈ W_B
    rw [hZ_u₀ q₀ hq₀]
    exact hu₀
  have hComm_X0 : g_X0 ≫ j_RV = X_0.ι ≫ g_cur := by
    calc g_X0 ≫ j_RV
        = f_0 ≫ (g_WB ≫ j_RV) := CategoryTheory.Category.assoc _ _ _
      _ = f_0 ≫ (W_B.ι ≫ g_ss) := by rw [hComm_WB]
      _ = (f_0 ≫ W_B.ι) ≫ g_ss := (CategoryTheory.Category.assoc _ _ _).symm
      _ = (X_0.ι ≫ f_ss_cur) ≫ g_ss := by rw [AlgebraicGeometry.morphismRestrict_ι f_ss_cur W_B]
      _ = X_0.ι ≫ (f_ss_cur ≫ g_ss) := CategoryTheory.Category.assoc _ _ _
      _ = X_0.ι ≫ g_cur := by rw [hComm_fss]
  have hZ_neBot : ∀ y ∈ Z_mod, (g_WB.base y).asIdeal ≠ ⊥ := by
    intro y hy hbot
    apply hZ_ss_neBot y hy
    have h1 : (W_B.ι ≫ g_ss).base y = j_RV.base (g_WB.base y) := by
      rw [← hComm_WB]; rfl
    rw [h1, AlgebraicGeometry.Spec.map_apply]
    change Ideal.comap ι_VP (g_WB.base y).asIdeal = ⊥
    rw [hbot, Submodule.eq_bot_iff]
    intro v hv
    exact hInj_VP ((Ideal.mem_bot.mp hv).trans (map_zero ι_VP).symm)

  
  have isPullback_id_of_mono : ∀ {A B C : AlgebraicGeometry.Scheme.{u}}
      (f : A ⟶ B) (g : B ⟶ C) [CategoryTheory.Mono g],
      CategoryTheory.IsPullback (𝟙 A) f (f ≫ g) g := by
    intro A B C f g _
    refine { w := CategoryTheory.Category.id_comp (f ≫ g), isLimit' := ⟨?_⟩ }
    refine CategoryTheory.Limits.PullbackCone.IsLimit.mk _ (fun s => s.fst)
      (fun s => CategoryTheory.Category.comp_id s.fst)
      (fun s => (CategoryTheory.cancel_mono g).mp ?_)
      (fun s u hu _ => (CategoryTheory.Category.comp_id u).symm.trans hu)
    rw [CategoryTheory.Category.assoc, s.condition]

  have hRestrictSS : ∀ (U : AlgebraicGeometry.Scheme.{u})
      (g_U : U ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V)),
      IsStrictlySemistableCurveOverValuation V g_U →
      ∀ (U_0 : U.Opens), Nonempty ↥U_0.toScheme →
      ∀ (g_0 : U_0.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R)),
      g_0 ≫ j_RV = U_0.ι ≫ g_U →
      IsStrictlySemistableCurveOverValuation R g_0 := by
    intro U g_U hSS_U U_0 hU0_ne g_0 hComm
    have hInt_U0 : AlgebraicGeometry.IsIntegral U_0.toScheme :=
      @AlgebraicGeometry.isIntegral_of_isOpenImmersion U_0.toScheme U U_0.ι
        inferInstance hSS_U.1 hU0_ne
    have hPb_g0 : CategoryTheory.IsPullback (𝟙 U_0.toScheme) g_0 (U_0.ι ≫ g_U) j_RV := by
      rw [← hComm]; exact isPullback_id_of_mono g_0 j_RV
    have hFlat_g0 : AlgebraicGeometry.Flat g_0 := by
      haveI := hSS_U.2.1
      exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_g0
        (inferInstance : AlgebraicGeometry.Flat (U_0.ι ≫ g_U))
    have hSep_g0 : AlgebraicGeometry.IsSeparated g_0 := by
      haveI := hSS_U.2.2.1
      exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_g0
        (inferInstance : AlgebraicGeometry.IsSeparated (U_0.ι ≫ g_U))
    have hLfp_g0 : AlgebraicGeometry.LocallyOfFinitePresentation g_0 := by
      haveI := hSS_U.2.2.2.1
      exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_g0
        (inferInstance : AlgebraicGeometry.LocallyOfFinitePresentation (U_0.ι ≫ g_U))
    refine ⟨hInt_U0, hFlat_g0, hSep_g0, hLfp_g0, fun y => ?_⟩
    rcases hSS_U.2.2.2.2 (U_0.ι.base y) with ⟨W, e, hyW, hEt_e, hW_comm⟩ |
      ⟨W, a, e, hyW, ha_ne, hEt_e, hW_comm⟩
    · left
      let W_0 : U_0.toScheme.Opens := (TopologicalSpace.Opens.map U_0.ι.base).obj W
      let j_W : W_0.toScheme ⟶ W.toScheme := U_0.ι ∣_ W
      haveI : AlgebraicGeometry.Etale e := hEt_e
      let e' := j_W ≫ e
      haveI : AlgebraicGeometry.Etale e' := inferInstance
      let C_V : CommRingCat.of ↥V ⟶ CommRingCat.of (Polynomial ↥V) :=
        CommRingCat.ofHom Polynomial.C
      let C_R : CommRingCat.of ↥R ⟶ CommRingCat.of (Polynomial ↥R) :=
        CommRingCat.ofHom Polynomial.C
      let ψ_sm : CommRingCat.of (Polynomial ↥V) ⟶ CommRingCat.of (Polynomial ↥R) :=
        CommRingCat.ofHom (Polynomial.mapRingHom ι_VP)
      have hPush_sm : CategoryTheory.IsPushout C_V (CommRingCat.ofHom ι_VP) ψ_sm C_R := by
        refine { w := CommRingCat.hom_ext (RingHom.ext fun v => by
                   change Polynomial.map ι_VP (Polynomial.C v) = Polynomial.C (ι_VP v)
                   rw [Polynomial.map_C]),
                 isColimit' := ⟨?_⟩ }
        refine CategoryTheory.Limits.PushoutCocone.IsColimit.mk _
          (fun s => CommRingCat.ofHom
            (Polynomial.eval₂RingHom s.inr.hom (s.inl.hom Polynomial.X)))
          (fun s => CommRingCat.hom_ext (Polynomial.ringHom_ext'
            (RingHom.ext fun v => ?_) ?_))
          (fun s => CommRingCat.hom_ext (RingHom.ext fun r => Polynomial.eval₂_C _ _))
          (fun s m' hm1 hm2 => CommRingCat.hom_ext (Polynomial.ringHom_ext'
            (RingHom.ext fun r => ?_) ?_))
        · change Polynomial.eval₂ s.inr.hom (s.inl.hom Polynomial.X)
            (Polynomial.map ι_VP (Polynomial.C v)) = s.inl.hom (Polynomial.C v)
          rw [Polynomial.map_C, Polynomial.eval₂_C]
          exact congrFun (congrArg DFunLike.coe
            (congrArg CommRingCat.Hom.hom s.condition.symm)) v
        · change Polynomial.eval₂ s.inr.hom (s.inl.hom Polynomial.X)
            (Polynomial.map ι_VP Polynomial.X) = s.inl.hom Polynomial.X
          rw [Polynomial.map_X, Polynomial.eval₂_X]
        · change m'.hom (Polynomial.C r) =
            Polynomial.eval₂ s.inr.hom (s.inl.hom Polynomial.X) (Polynomial.C r)
          rw [Polynomial.eval₂_C, ← hm2]; rfl
        · change m'.hom Polynomial.X =
            Polynomial.eval₂ s.inr.hom (s.inl.hom Polynomial.X) Polynomial.X
          rw [Polynomial.eval₂_X, ← hm1]
          change m'.hom Polynomial.X = m'.hom (Polynomial.map ι_VP Polynomial.X)
          rw [Polynomial.map_X]
      have hPb_sm := AlgebraicGeometry.isPullback_SpecMap_of_isPushout
        C_V (CommRingCat.ofHom ι_VP) ψ_sm C_R hPush_sm
      have he'_comm : e' ≫ AlgebraicGeometry.Spec.map C_V = (W_0.ι ≫ g_0) ≫ j_RV := by
        calc j_W ≫ e ≫ AlgebraicGeometry.Spec.map C_V
            = j_W ≫ (W.ι ≫ g_U) := by rw [← hW_comm]
          _ = (j_W ≫ W.ι) ≫ g_U := (CategoryTheory.Category.assoc _ _ _).symm
          _ = (W_0.ι ≫ U_0.ι) ≫ g_U := by rw [AlgebraicGeometry.morphismRestrict_ι U_0.ι W]
          _ = W_0.ι ≫ (U_0.ι ≫ g_U) := CategoryTheory.Category.assoc _ _ _
          _ = W_0.ι ≫ (g_0 ≫ j_RV) := by rw [← hComm]
          _ = (W_0.ι ≫ g_0) ≫ j_RV := (CategoryTheory.Category.assoc _ _ _).symm
      let e_R := hPb_sm.lift e' (W_0.ι ≫ g_0) he'_comm
      haveI : AlgebraicGeometry.IsOpenImmersion (AlgebraicGeometry.Spec.map ψ_sm) :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          hPb_sm.flip hOpen_VP
      have hPb_eR : CategoryTheory.IsPullback (𝟙 W_0.toScheme) e_R e'
          (AlgebraicGeometry.Spec.map ψ_sm) := by
        have hfac : e_R ≫ AlgebraicGeometry.Spec.map ψ_sm = e' :=
          hPb_sm.lift_fst e' (W_0.ι ≫ g_0) he'_comm
        rw [← hfac]
        exact isPullback_id_of_mono e_R (AlgebraicGeometry.Spec.map ψ_sm)
      have hEt_eR : AlgebraicGeometry.Etale e_R :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_eR inferInstance
      exact ⟨W_0, e_R, hyW, hEt_eR, (hPb_sm.lift_snd e' (W_0.ι ≫ g_0) he'_comm).symm⟩
    · right
      let W_0 : U_0.toScheme.Opens := (TopologicalSpace.Opens.map U_0.ι.base).obj W
      let j_W : W_0.toScheme ⟶ W.toScheme := U_0.ι ∣_ W
      haveI : AlgebraicGeometry.Etale e := hEt_e
      let e' := j_W ≫ e
      haveI : AlgebraicGeometry.Etale e' := inferInstance
      let a_R : ↥R := ι_VP a
      have haR_ne : a_R ≠ 0 := fun h => ha_ne (hInj_VP (h.trans (map_zero ι_VP).symm))
      let I_V : Ideal (MvPolynomial (Fin 2) ↥V) :=
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}
      let I_R : Ideal (MvPolynomial (Fin 2) ↥R) :=
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a_R}
      let C_nod_V : CommRingCat.of ↥V ⟶ CommRingCat.of (MvPolynomial (Fin 2) ↥V ⧸ I_V) :=
        CommRingCat.ofHom ((Ideal.Quotient.mk I_V).comp MvPolynomial.C)
      let C_nod_R : CommRingCat.of ↥R ⟶ CommRingCat.of (MvPolynomial (Fin 2) ↥R ⧸ I_R) :=
        CommRingCat.ofHom ((Ideal.Quotient.mk I_R).comp MvPolynomial.C)
      have hψ_ker : ∀ f ∈ I_V,
          ((Ideal.Quotient.mk I_R).comp (MvPolynomial.map ι_VP)) f = 0 := by
        intro f hf
        rw [← RingHom.mem_ker]
        refine Ideal.span_le.mpr ?_ hf
        rintro _ rfl
        simp only [SetLike.mem_coe, RingHom.mem_ker, RingHom.comp_apply, map_sub, map_mul,
          MvPolynomial.map_X, MvPolynomial.map_C]
        exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
      let ψ_nod : CommRingCat.of (MvPolynomial (Fin 2) ↥V ⧸ I_V) ⟶
          CommRingCat.of (MvPolynomial (Fin 2) ↥R ⧸ I_R) :=
        CommRingCat.ofHom (Ideal.Quotient.lift I_V
          ((Ideal.Quotient.mk I_R).comp (MvPolynomial.map ι_VP)) hψ_ker)
      have hPush_nod : CategoryTheory.IsPushout C_nod_V (CommRingCat.ofHom ι_VP)
          ψ_nod C_nod_R := by
        refine { w := CommRingCat.hom_ext (RingHom.ext fun v => by
                   change Ideal.Quotient.mk I_R (MvPolynomial.map ι_VP (MvPolynomial.C v)) =
                     Ideal.Quotient.mk I_R (MvPolynomial.C (ι_VP v))
                   rw [MvPolynomial.map_C]),
                 isColimit' := ⟨?_⟩ }
        refine CategoryTheory.Limits.PushoutCocone.IsColimit.mk _
          (fun s => CommRingCat.ofHom (Ideal.Quotient.lift I_R
            (MvPolynomial.eval₂Hom s.inr.hom
              (fun i => s.inl.hom (Ideal.Quotient.mk I_V (MvPolynomial.X i))))
            (fun f hf => RingHom.mem_ker.mp (Ideal.span_le.mpr (by
              rintro _ rfl
              simp only [SetLike.mem_coe, RingHom.mem_ker, map_sub, map_mul,
                MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C]
              have hsc : s.inr.hom a_R = s.inl.hom (Ideal.Quotient.mk I_V (MvPolynomial.C a)) :=
                congrFun (congrArg DFunLike.coe
                  (congrArg CommRingCat.Hom.hom s.condition.symm)) a
              rw [hsc, ← map_mul, ← map_sub, ← map_mul, ← map_sub]
              have h0 : Ideal.Quotient.mk I_V
                  (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a) = 0 :=
                Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
              rw [h0, map_zero]) hf))))
          (fun s => CommRingCat.hom_ext (Ideal.Quotient.ringHom_ext
            (MvPolynomial.ringHom_ext'
              (RingHom.ext fun v => by
                simp only [ψ_nod, CommRingCat.hom_comp, CommRingCat.hom_ofHom,
                  RingHom.comp_apply, Ideal.Quotient.lift_mk, MvPolynomial.map_C,
                  MvPolynomial.eval₂Hom_C]
                exact congrFun (congrArg DFunLike.coe
                  (congrArg CommRingCat.Hom.hom s.condition.symm)) v)
              (fun i => by
                simp only [ψ_nod, CommRingCat.hom_comp, CommRingCat.hom_ofHom,
                  RingHom.comp_apply, Ideal.Quotient.lift_mk, MvPolynomial.map_X,
                  MvPolynomial.eval₂Hom_X']))))
          (fun s => CommRingCat.hom_ext (RingHom.ext fun r => by
            simp only [C_nod_R, CommRingCat.hom_comp, CommRingCat.hom_ofHom,
              RingHom.comp_apply, Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_C]))
          (fun s m' hm1 hm2 => CommRingCat.hom_ext (Ideal.Quotient.ringHom_ext
            (MvPolynomial.ringHom_ext'
              (RingHom.ext fun r => by
                simp only [CommRingCat.hom_ofHom, RingHom.comp_apply,
                  Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_C, ← hm2]
                rfl)
              (fun i => by
                simp only [CommRingCat.hom_ofHom, RingHom.comp_apply,
                  Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_X', ← hm1]
                simp only [ψ_nod, CommRingCat.hom_comp, CommRingCat.hom_ofHom,
                  RingHom.comp_apply, Ideal.Quotient.lift_mk, MvPolynomial.map_X]))))
      have hPb_nod := AlgebraicGeometry.isPullback_SpecMap_of_isPushout
        C_nod_V (CommRingCat.ofHom ι_VP) ψ_nod C_nod_R hPush_nod
      have he'_comm : e' ≫ AlgebraicGeometry.Spec.map C_nod_V = (W_0.ι ≫ g_0) ≫ j_RV := by
        calc j_W ≫ e ≫ AlgebraicGeometry.Spec.map C_nod_V
            = j_W ≫ (W.ι ≫ g_U) := by rw [← hW_comm]
          _ = (j_W ≫ W.ι) ≫ g_U := (CategoryTheory.Category.assoc _ _ _).symm
          _ = (W_0.ι ≫ U_0.ι) ≫ g_U := by rw [AlgebraicGeometry.morphismRestrict_ι U_0.ι W]
          _ = W_0.ι ≫ (U_0.ι ≫ g_U) := CategoryTheory.Category.assoc _ _ _
          _ = W_0.ι ≫ (g_0 ≫ j_RV) := by rw [← hComm]
          _ = (W_0.ι ≫ g_0) ≫ j_RV := (CategoryTheory.Category.assoc _ _ _).symm
      let e_R := hPb_nod.lift e' (W_0.ι ≫ g_0) he'_comm
      haveI : AlgebraicGeometry.IsOpenImmersion (AlgebraicGeometry.Spec.map ψ_nod) :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          hPb_nod.flip hOpen_VP
      have hPb_eR : CategoryTheory.IsPullback (𝟙 W_0.toScheme) e_R e'
          (AlgebraicGeometry.Spec.map ψ_nod) := by
        have hfac : e_R ≫ AlgebraicGeometry.Spec.map ψ_nod = e' :=
          hPb_nod.lift_fst e' (W_0.ι ≫ g_0) he'_comm
        rw [← hfac]
        exact isPullback_id_of_mono e_R (AlgebraicGeometry.Spec.map ψ_nod)
      have hEt_eR : AlgebraicGeometry.Etale e_R :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_eR inferInstance
      exact ⟨W_0, a_R, e_R, hyW, haR_ne, hEt_eR,
        (hPb_nod.lift_snd e' (W_0.ι ≫ g_0) he'_comm).symm⟩

