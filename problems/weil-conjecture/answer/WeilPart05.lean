          exact Nat.not_lt.mpr (hu_min m hm_Ia) (upCard_lt_of_lt hum (Ne.symm hmu_eq))
    obtain ⟨u₁, ha₁_u₁, hu₁_hasse⟩ := exists_child_above a₁ ha₁_le_kroot ha₁_ne
    obtain ⟨u₂, ha₂_u₂, hu₂_hasse⟩ := exists_child_above a₂ ha₂_le_kroot ha₂_ne
    have hu₁_ne_u₂ : u₁ ≠ u₂ := by
      intro heq
      rw [← heq] at ha₂_u₂
      exact hu₁_hasse.1 (leIdx_antisymm (hkroot_lub u₁ ha₁_u₁ ha₂_u₂) hu₁_hasse.2.1)
    
    have exists_cone_exit : ∀ (a u : Fin N),
        inD0 a → leIdx a u → IsDiscHasseCover ↥R c π k_root u →
        ∃ v w : Fin N, inD0 w ∧ ¬ inD0 v ∧ leIdx w u ∧
          IsDiscHasseCover ↥R c π v w ∧ leIdx v k_root ∧
          ∀ t : Fin N, leIdx v t → leIdx t k_root → ¬ inD0 t := by
      intro a u ha_D0 hau hu_hasse
      let D_u : Finset (Fin N) := Finset.univ.filter (fun w : Fin N => leIdx w u ∧ inD0 w)
      have hDu_ne : D_u.Nonempty := ⟨a, Finset.mem_filter.mpr ⟨Finset.mem_univ a, hau, ha_D0⟩⟩
      obtain ⟨w, hw_mem, hw_min⟩ := Finset.exists_min_image D_u upCard hDu_ne
      obtain ⟨_, hwu, hw_D0⟩ := Finset.mem_filter.mp hw_mem
      have hwk : leIdx w k_root := leIdx_trans hwu hu_hasse.2.1
      have hw_ne_kroot : w ≠ k_root := fun h => hk_root_not (h ▸ hw_D0)
      have hw_ne_top : w ≠ i_top := by
        intro htop
        rw [htop] at hwk
        exact hk_root_ne_top (leIdx_antisymm (leIdx_top k_root) hwk)
      obtain ⟨v, hvw_hasse, hv_iff⟩ := exists_par w hw_ne_top
      have hvk : leIdx v k_root := (hv_iff k_root).mp ⟨hwk, hw_ne_kroot.symm⟩
      have hInt : ∀ t : Fin N, leIdx v t → leIdx t k_root → ¬ inD0 t := by
        intro t hvt htk ht_D0
        by_cases htk_eq : t = k_root
        · exact hk_root_not (htk_eq ▸ ht_D0)
        · have hwt : leIdx w t := leIdx_trans hvw_hasse.2.1 hvt
          have htu : leIdx t u := by
            rcases leIdx_total_above hwu hwt with hut | htu
            · rcases hu_hasse.2.2 t hut htk with htu_eq | htk'
              · rw [htu_eq]
                exact leIdx_refl u
              · exact absurd htk' htk_eq
            · exact htu
          have ht_Du : t ∈ D_u := Finset.mem_filter.mpr ⟨Finset.mem_univ t, htu, ht_D0⟩
          have hlt_vw : upCard v < upCard w := upCard_lt_of_lt hvw_hasse.2.1 hvw_hasse.1.symm
          have hle_tv : upCard t ≤ upCard v := by
            by_cases htv_eq : t = v
            · rw [htv_eq]
            · exact Nat.le_of_lt (upCard_lt_of_lt hvt (Ne.symm htv_eq))
          exact Nat.not_lt.mpr (hw_min t ht_Du) (Nat.lt_of_le_of_lt hle_tv hlt_vw)
      exact ⟨v, w, hw_D0, hInt v (leIdx_refl v) hvk, hwu, hvw_hasse, hvk, hInt⟩
    obtain ⟨v₁, w₁, hw₁_D0, hv₁_not, hw₁_u₁, hvw₁_hasse, hv₁_k, hInt₁⟩ :=
      exists_cone_exit a₁ u₁ ha₁_D0 ha₁_u₁ hu₁_hasse
    obtain ⟨v₂, w₂, hw₂_D0, hv₂_not, hw₂_u₂, hvw₂_hasse, hv₂_k, hInt₂⟩ :=
      exists_cone_exit a₂ u₂ ha₂_D0 ha₂_u₂ hu₂_hasse
    
    have hx_climb : ∀ (c_up : ℕ) (v : Fin N), upCard v = c_up →
        ∀ (hv_le : leIdx v k_root)
          (hInt : ∀ t : Fin N, leIdx v t → leIdx t k_root → ¬ inD0 t),
          x_of v (hInt v (leIdx_refl v) hv_le) = x_of k_root hk_root_not := by
      intro c_up
      induction c_up using Nat.strong_induction_on with
      | h c_up ih =>
        intro v hv_card hv_le hInt
        by_cases hvk_eq : v = k_root
        · subst hvk_eq; rfl
        · have hv_ne_top : v ≠ i_top := by
            intro htop
            rw [htop] at hv_le
            exact hk_root_ne_top (leIdx_antisymm (leIdx_top k_root) hv_le)
          obtain ⟨p, hvp_hasse, hp_iff⟩ := exists_par v hv_ne_top
          have hp_le : leIdx p k_root := (hp_iff k_root).mp ⟨hv_le, Ne.symm hvk_eq⟩
          have hp_lt : upCard p < c_up := by
            rw [← hv_card]
            exact upCard_lt_of_lt hvp_hasse.2.1 hvp_hasse.1.symm
