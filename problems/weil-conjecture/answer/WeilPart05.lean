        · exact heq
        · exfalso
          exact ne_of_gt (pow_lt_pow_left₀ hgt zero_le (by omega)) hv_pow_bK
      have hφbK_ne : φ_KF0 b_K ≠ 0 := (map_ne_zero φ_KF0).mpr hbK_ne
      have hv_φbK_ne : W_0.valuation (φ_KF0 b_K) ≠ 0 :=
        (Valuation.ne_zero_iff W_0.valuation).mpr hφbK_ne
      have hv_ratio : W_0.valuation (g * (φ_KF0 b_K)⁻¹) = 1 := by
        rw [Valuation.map_mul, map_inv₀, hv_g_eq, mul_inv_cancel₀ hv_φbK_ne]
      have h_ratio_mem : g * (φ_KF0 b_K)⁻¹ ∈ W_0 :=
        (W_0.valuation_le_one_iff _).mp (le_of_eq hv_ratio)
