        ⟨⟨ι_B (j_W x), ⟨(φ_F0_FWB x.1)⁻¹, hinv_B⟩, hmul1, mul_comm (ι_B (j_W x)) _ ▸ hmul1⟩, rfl⟩
      exact (IsLocalRing.mem_maximalIdeal (ι_B (j_W x))).mp hmem hunit
    · intro hx_in
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      rcases hu.exists_right_inv with ⟨u, hu_eq⟩
      have hu_val : φ_F0_FWB x.1 * u.1 = 1 := congrArg Subtype.val hu_eq
      have hx0 : x.1 ≠ 0 := by
        intro h0
        rw [h0, map_zero, zero_mul] at hu_val
        exact zero_ne_one hu_val
      obtain ⟨s, hs_not, hsu_W⟩ := (hBloc_mem u.1).mp u.2
      have hsx_WB : φ_F0_FWB (s.1 * x.1⁻¹) ∈ W := by
        have heq_u : φ_F0_FWB (s.1 * x.1⁻¹) = φ_F0_FWB s.1 * u.1 := by
          calc φ_F0_FWB (s.1 * x.1⁻¹)
            _ = φ_F0_FWB (s.1 * x.1⁻¹) * (φ_F0_FWB x.1 * u.1) := by rw [hu_val, mul_one]
            _ = (φ_F0_FWB (s.1 * x.1⁻¹) * φ_F0_FWB x.1) * u.1 := (mul_assoc _ _ _).symm
            _ = φ_F0_FWB (s.1 * (x.1⁻¹ * x.1)) * u.1 := by rw [← map_mul, mul_assoc]
            _ = φ_F0_FWB s.1 * u.1 := by rw [inv_mul_cancel₀ hx0, mul_one]
        rwa [heq_u]
      have hsx_W0 : s.1 * x.1⁻¹ ∈ W_0 :=
        Eq.mp (congrArg ((s.1 * x.1⁻¹) ∈ ·) hComap)
          (ValuationSubring.mem_comap.mpr hsx_WB)
      let q : ↥W_0 := ⟨s.1 * x.1⁻¹, hsx_W0⟩
      have hqx : q * x = s := by
        apply Subtype.ext
        change (s.1 * x.1⁻¹) * x.1 = s.1
        rw [mul_assoc, inv_mul_cancel₀ hx0, mul_one]
      exact hs_not (hqx ▸ pW0.asIdeal.mul_mem_left q hx_in)
  exact ⟨hComap, j_W, pW, hj_sub, hpW_eq⟩

theorem weil_standard_model_fiber_dichotomy_and_nonclosed_subsingleton (K : Type u) [Field K]
    [IsSepClosed K] (m : ℕ) (R : ValuationSubring K) (hPkg_R : IsValuationRingAlgPackage m R)
    (hMax_R : IsLocalRing.maximalIdeal ↥R ≠ ⊥)
    (a_opt : Option ↥R)
    (M_0 M_1 : AlgebraicGeometry.Scheme.{u})
    (g_M0 : M_0 ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
    (g_M1 : M_1 ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
    (f_M1 : M_1 ⟶ M_0)
    (m_0 : ↥M_0)
    (F_0 : Type u) [Field F_0]
    (η_M0 : AlgebraicGeometry.Spec (CommRingCat.of F_0) ⟶ M_0)
    (η_M1 : AlgebraicGeometry.Spec (CommRingCat.of F_0) ⟶ M_1)
    (φ_KF0 : K →+* F_0) (T_0 : F_0)
    (Z_M1 : Set ↥M_0) (hZM1_cl : IsClosed Z_M1)
    (hStd : IsStandardModelCoordDatum R a_opt M_0 g_M0 m_0 η_M0 φ_KF0 T_0)
    (hSS_M1 : IsStrictlySemistableCurveOverValuation R g_M1)
    (hfM1_g : f_M1 ≫ g_M0 = g_M1)
    (hη_M1 : η_M1 ≫ f_M1 = η_M0)
    (hIso_fM1 : CategoryTheory.IsIso (f_M1 ∣_ (⟨Z_M1ᶜ, hZM1_cl.isOpen_compl⟩ : M_0.Opens)))
    (hZM1_neBot : ∀ y ∈ Z_M1, (g_M0.base y).asIdeal ≠ ⊥) :
    (∀ y : ↥M_0,
      (∀ z : ↥M_0, z ∈ closure ({y} : Set ↥M_0) → g_M0.base z = g_M0.base y → z = y) →
      ∃ z₀ : ↥M_0, y ∈ closure ({z₀} : Set ↥M_0) ∧ g_M0.base z₀ = g_M0.base y ∧ z₀ ≠ y) ∧
    (∀ y : ↥M_0,
      (y ∉ Z_M1 ∨ (∃ z : ↥M_0, z ∈ closure ({y} : Set ↥M_0) ∧ g_M0.base z = g_M0.base y ∧ z ≠ y)) →
      (f_M1.base ⁻¹' {y}).Subsingleton) :=
by
  have _ := hPkg_R
  have _ := hMax_R
  have poly_dichot : ∀ (Q_R : PrimeSpectrum ↥R)
      (q_y : PrimeSpectrum (Polynomial ↥R)),
      PrimeSpectrum.comap Polynomial.C q_y = Q_R →
      ((∀ q_z : PrimeSpectrum (Polynomial ↥R),
          q_y.asIdeal ≤ q_z.asIdeal → PrimeSpectrum.comap Polynomial.C q_z = Q_R → q_z = q_y) →
        ∃ q_0 : PrimeSpectrum (Polynomial ↥R),
          q_0.asIdeal ≤ q_y.asIdeal ∧ PrimeSpectrum.comap Polynomial.C q_0 = Q_R ∧ q_0 ≠ q_y) ∧
      ((∃ q_z : PrimeSpectrum (Polynomial ↥R),
          q_y.asIdeal ≤ q_z.asIdeal ∧ PrimeSpectrum.comap Polynomial.C q_z = Q_R ∧ q_z ≠ q_y) →
        ∀ P : Polynomial ↥R, P ∈ q_y.asIdeal ↔ ∀ n : ℕ, P.coeff n ∈ Q_R.asIdeal) := by
    intro Q_R q_y hq_over
    let k_Q := Q_R.asIdeal.ResidueField
    let π_Q : Polynomial ↥R →+* Polynomial k_Q := Polynomial.mapRingHom (algebraMap ↥R k_Q)
    have hker_π : ∀ P : Polynomial ↥R, π_Q P = 0 ↔ ∀ n : ℕ, P.coeff n ∈ Q_R.asIdeal := by
      intro P
      rw [Polynomial.ext_iff]
      refine forall_congr' fun n => ?_
      change (Polynomial.map (algebraMap ↥R k_Q) P).coeff n = 0 ↔ _
      rw [Polynomial.coeff_map, Ideal.algebraMap_residueField_eq_zero]
    let q_0 : PrimeSpectrum (Polynomial ↥R) := ⟨RingHom.ker π_Q, RingHom.ker_isPrime π_Q⟩
    have hq0_mem : ∀ P : Polynomial ↥R, P ∈ q_0.asIdeal ↔ ∀ n : ℕ, P.coeff n ∈ Q_R.asIdeal := hker_π
    have hq0_over : PrimeSpectrum.comap Polynomial.C q_0 = Q_R := by
      ext r
      change Polynomial.C r ∈ q_0.asIdeal ↔ r ∈ Q_R.asIdeal
      rw [hq0_mem]
      constructor
      · intro h
        simpa [Polynomial.coeff_C] using h 0
      · intro hr n
        rw [Polynomial.coeff_C]
        split_ifs
        · exact hr
        · exact Q_R.asIdeal.zero_mem
    have hq0_le_of_over : ∀ q : PrimeSpectrum (Polynomial ↥R),
        PrimeSpectrum.comap Polynomial.C q = Q_R → q_0.asIdeal ≤ q.asIdeal := by
      intro q hq P hP
      rw [hq0_mem] at hP
      rw [P.as_sum_support_C_mul_X_pow]
      refine Ideal.sum_mem q.asIdeal fun n _ => Ideal.mul_mem_right _ _ ?_
      have hcomap : Ideal.comap Polynomial.C q.asIdeal = Q_R.asIdeal :=
        congrArg PrimeSpectrum.asIdeal hq
      change P.coeff n ∈ Ideal.comap Polynomial.C q.asIdeal
      rw [hcomap]
      exact hP n
    constructor
    · intro hClosed
      let ε_0 : Polynomial ↥R →+* k_Q := (Polynomial.evalRingHom (0 : k_Q)).comp π_Q
      let p_ev : PrimeSpectrum (Polynomial ↥R) := ⟨RingHom.ker ε_0, RingHom.ker_isPrime ε_0⟩
      have hq0_le_pev : q_0.asIdeal ≤ p_ev.asIdeal := by
        intro P hP
        change Polynomial.eval 0 (π_Q P) = 0
        rw [show π_Q P = 0 from hP, Polynomial.eval_zero]
      have hpev_over : PrimeSpectrum.comap Polynomial.C p_ev = Q_R := by
        ext r
        change Polynomial.eval 0 (Polynomial.map (algebraMap ↥R k_Q) (Polynomial.C r)) = 0 ↔
          r ∈ Q_R.asIdeal
        rw [Polynomial.map_C, Polynomial.eval_C, Ideal.algebraMap_residueField_eq_zero]
      have hpev_ne_q0 : p_ev ≠ q_0 := by
        intro heq
        have hX_pev : (Polynomial.X : Polynomial ↥R) ∈ p_ev.asIdeal := by
          change Polynomial.eval 0 (Polynomial.map (algebraMap ↥R k_Q) Polynomial.X) = 0
          simp
        rw [heq, hq0_mem] at hX_pev
        exact Q_R.isPrime.one_notMem (by simpa using hX_pev 1)
      refine ⟨q_0, hq0_le_of_over q_y hq_over, hq0_over, ?_⟩
      intro heq
      subst heq
      exact hpev_ne_q0 (hClosed p_ev hq0_le_pev hpev_over)
    · rintro ⟨q_z, hqy_le_qz, hqz_over, hqz_ne⟩
      have kQ_clear : ∀ x : k_Q, ∃ a s : ↥R,
          s ∉ Q_R.asIdeal ∧ algebraMap ↥R k_Q s * x = algebraMap ↥R k_Q a := by
        intro x
        obtain ⟨abar, bbar, hbbar_mem, hdiv⟩ :=
          IsFractionRing.div_surjective (A := ↥R ⧸ Q_R.asIdeal) x
        obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective abar
        obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective bbar
        have hbbar_ne : Ideal.Quotient.mk Q_R.asIdeal s ≠ 0 :=
          mem_nonZeroDivisors_iff_ne_zero.mp hbbar_mem
        have hs_notMem : s ∉ Q_R.asIdeal :=
          fun hs => hbbar_ne (Ideal.Quotient.eq_zero_iff_mem.mpr hs)
        have hs_alg_ne : algebraMap ↥R k_Q s ≠ 0 :=
          mt Ideal.algebraMap_residueField_eq_zero.mp hs_notMem
        refine ⟨a, s, hs_notMem, ?_⟩
        have hdiv' : algebraMap ↥R k_Q a / algebraMap ↥R k_Q s = x := hdiv
        rw [← hdiv', mul_div_cancel₀ _ hs_alg_ne]
      have poly_clear_denom : ∀ g : Polynomial k_Q, ∃ (s : ↥R) (G : Polynomial ↥R),
          s ∉ Q_R.asIdeal ∧ Polynomial.C (algebraMap ↥R k_Q s) * g = π_Q G := by
        intro g
        refine Polynomial.induction_on' g ?_ ?_
        · intro p₁ p₂ ⟨s₁, G₁, hs₁, h₁⟩ ⟨s₂, G₂, hs₂, h₂⟩
          refine ⟨s₁ * s₂, Polynomial.C s₂ * G₁ + Polynomial.C s₁ * G₂,
            Q_R.isPrime.mul_notMem hs₁ hs₂, ?_⟩
          calc Polynomial.C (algebraMap ↥R k_Q (s₁ * s₂)) * (p₁ + p₂)
            _ = Polynomial.C (algebraMap ↥R k_Q s₂) * (Polynomial.C (algebraMap ↥R k_Q s₁) * p₁) +
                  Polynomial.C (algebraMap ↥R k_Q s₁) * (Polynomial.C (algebraMap ↥R k_Q s₂) * p₂) := by
                simp only [map_mul]; ring
            _ = Polynomial.C (algebraMap ↥R k_Q s₂) * π_Q G₁ +
                  Polynomial.C (algebraMap ↥R k_Q s₁) * π_Q G₂ := by rw [h₁, h₂]
            _ = π_Q (Polynomial.C s₂ * G₁ + Polynomial.C s₁ * G₂) := by
                simp only [π_Q, map_add, map_mul, Polynomial.coe_mapRingHom, Polynomial.map_C]
        · intro n x
          obtain ⟨a, s, hs, hsx⟩ := kQ_clear x
          refine ⟨s, Polynomial.monomial n a, hs, ?_⟩
          rw [Polynomial.C_mul_monomial, hsx]
          change Polynomial.monomial n _ = Polynomial.map (algebraMap ↥R k_Q) (Polynomial.monomial n a)
          rw [Polynomial.map_monomial]
      let J_of : PrimeSpectrum (Polynomial ↥R) → Ideal (Polynomial k_Q) := fun q =>
        { carrier := {f : Polynomial k_Q | ∃ s : ↥R, s ∉ Q_R.asIdeal ∧
            ∃ F ∈ q.asIdeal, Polynomial.C (algebraMap ↥R k_Q s) * f = π_Q F}
          add_mem' := by
            rintro f₁ f₂ ⟨s₁, hs₁, F₁, hF₁, hf₁⟩ ⟨s₂, hs₂, F₂, hF₂, hf₂⟩
            refine ⟨s₁ * s₂, Q_R.isPrime.mul_notMem hs₁ hs₂,
              Polynomial.C s₂ * F₁ + Polynomial.C s₁ * F₂,
              q.asIdeal.add_mem (Ideal.mul_mem_left _ _ hF₁) (Ideal.mul_mem_left _ _ hF₂), ?_⟩
            calc Polynomial.C (algebraMap ↥R k_Q (s₁ * s₂)) * (f₁ + f₂)
              _ = Polynomial.C (algebraMap ↥R k_Q s₂) * (Polynomial.C (algebraMap ↥R k_Q s₁) * f₁) +
                    Polynomial.C (algebraMap ↥R k_Q s₁) * (Polynomial.C (algebraMap ↥R k_Q s₂) * f₂) := by
                  simp only [map_mul]; ring
              _ = Polynomial.C (algebraMap ↥R k_Q s₂) * π_Q F₁ +
                    Polynomial.C (algebraMap ↥R k_Q s₁) * π_Q F₂ := by rw [hf₁, hf₂]
              _ = π_Q (Polynomial.C s₂ * F₁ + Polynomial.C s₁ * F₂) := by
                  simp only [π_Q, map_add, map_mul, Polynomial.coe_mapRingHom, Polynomial.map_C]
          zero_mem' := ⟨1, Q_R.isPrime.one_notMem, 0, q.asIdeal.zero_mem, by simp⟩
          smul_mem' := by
            rintro g f ⟨s, hs, F, hF, hf⟩
            obtain ⟨t, G, ht, hg⟩ := poly_clear_denom g
            refine ⟨t * s, Q_R.isPrime.mul_notMem ht hs, G * F, Ideal.mul_mem_left _ G hF, ?_⟩
            change Polynomial.C (algebraMap ↥R k_Q (t * s)) * (g * f) = π_Q (G * F)
            calc Polynomial.C (algebraMap ↥R k_Q (t * s)) * (g * f)
              _ = (Polynomial.C (algebraMap ↥R k_Q t) * g) *
                    (Polynomial.C (algebraMap ↥R k_Q s) * f) := by
                  simp only [map_mul]; ring
              _ = π_Q G * π_Q F := by rw [hg, hf]
              _ = π_Q (G * F) := (map_mul π_Q G F).symm }
      have mem_J_iff : ∀ (q : PrimeSpectrum (Polynomial ↥R)),
          PrimeSpectrum.comap Polynomial.C q = Q_R →
          ∀ P : Polynomial ↥R, π_Q P ∈ J_of q ↔ P ∈ q.asIdeal := by
        intro q hq P
        constructor
        · rintro ⟨s, hs, F, hF, hEq⟩
          have hdiff_ker : Polynomial.C s * P - F ∈ q_0.asIdeal := by
            change π_Q (Polynomial.C s * P - F) = 0
            rw [map_sub, map_mul]
            have hCs : π_Q (Polynomial.C s) = Polynomial.C (algebraMap ↥R k_Q s) :=
              Polynomial.map_C _
            rw [hCs, hEq, sub_self]
          have hdiff_q : Polynomial.C s * P - F ∈ q.asIdeal := hq0_le_of_over q hq hdiff_ker
          have hCsP_q : Polynomial.C s * P ∈ q.asIdeal := by
            have := q.asIdeal.add_mem hdiff_q hF
            rwa [sub_add_cancel] at this
          have hCs_not : Polynomial.C s ∉ q.asIdeal := by
            have hcomap : Ideal.comap Polynomial.C q.asIdeal = Q_R.asIdeal :=
              congrArg PrimeSpectrum.asIdeal hq
            intro hmem
            have : s ∈ Ideal.comap Polynomial.C q.asIdeal := hmem
            rw [hcomap] at this
            exact hs this
          exact (q.isPrime.mem_or_mem hCsP_q).resolve_left hCs_not
        · intro hP
          exact ⟨1, Q_R.isPrime.one_notMem, P, hP, by simp⟩
      have isPrime_J : ∀ (q : PrimeSpectrum (Polynomial ↥R)),
          PrimeSpectrum.comap Polynomial.C q = Q_R → (J_of q).IsPrime := by
        intro q hq
        refine ⟨?_, ?_⟩
        · intro htop
          have h1 : π_Q 1 ∈ J_of q := by rw [htop]; trivial
          exact q.isPrime.one_notMem ((mem_J_iff q hq 1).mp h1)
        · intro f₁ f₂ hf₁₂
          obtain ⟨t₁, G₁, ht₁, hg₁⟩ := poly_clear_denom f₁
          obtain ⟨t₂, G₂, ht₂, hg₂⟩ := poly_clear_denom f₂
          have hprod_J : π_Q (G₁ * G₂) ∈ J_of q := by
            have hEq : π_Q (G₁ * G₂) =
                Polynomial.C (algebraMap ↥R k_Q (t₁ * t₂)) * (f₁ * f₂) := by
              calc π_Q (G₁ * G₂) = π_Q G₁ * π_Q G₂ := map_mul π_Q G₁ G₂
                _ = (Polynomial.C (algebraMap ↥R k_Q t₁) * f₁) *
                      (Polynomial.C (algebraMap ↥R k_Q t₂) * f₂) := by rw [← hg₁, ← hg₂]
                _ = Polynomial.C (algebraMap ↥R k_Q (t₁ * t₂)) * (f₁ * f₂) := by
                    simp only [map_mul]; ring
            rw [hEq]
            exact Ideal.mul_mem_left _ _ hf₁₂
          have hprod_q : G₁ * G₂ ∈ q.asIdeal := (mem_J_iff q hq (G₁ * G₂)).mp hprod_J
          rcases q.isPrime.mem_or_mem hprod_q with hG₁ | hG₂
          · exact Or.inl ⟨t₁, ht₁, G₁, hG₁, hg₁⟩
          · exact Or.inr ⟨t₂, ht₂, G₂, hG₂, hg₂⟩
      have hJy_le_Jz : J_of q_y ≤ J_of q_z := by
        rintro f ⟨s, hs, F, hF, hf⟩
        exact ⟨s, hs, F, hqy_le_qz hF, hf⟩
      have hJy_bot : J_of q_y = ⊥ := by
        by_contra hne_bot
        have : (J_of q_y).IsPrime := isPrime_J q_y hq_over
        have hMax : (J_of q_y).IsMaximal := _root_.IsPrime.to_maximal_ideal hne_bot
        have hEq_J : J_of q_y = J_of q_z :=
          hMax.eq_of_le (isPrime_J q_z hqz_over).ne_top hJy_le_Jz
        apply hqz_ne
        ext P
        rw [← mem_J_iff q_z hqz_over P, ← hEq_J, mem_J_iff q_y hq_over P]
      intro P
      rw [← mem_J_iff q_y hq_over P, hJy_bot, Ideal.mem_bot, hker_π]
  have nodal_pkg : ∀ (a₀ : ↥R), a₀ ≠ 0 →
      let I_nod : Ideal (MvPolynomial (Fin 2) ↥R) :=
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a₀}
      let A_nod := MvPolynomial (Fin 2) ↥R ⧸ I_nod
      let c_nod : ↥R →+* A_nod := (Ideal.Quotient.mk I_nod).comp MvPolynomial.C
      IsDomain A_nod ∧
      (∀ b : Fin 2,
        Function.Injective
          (Polynomial.eval₂RingHom c_nod (Ideal.Quotient.mk I_nod (MvPolynomial.X b))) ∧
        ∀ f : A_nod, ∃ (D : ℕ) (P : Polynomial ↥R),
          (Ideal.Quotient.mk I_nod (MvPolynomial.X b)) ^ D * f =
            Polynomial.eval₂RingHom c_nod (Ideal.Quotient.mk I_nod (MvPolynomial.X b)) P) ∧
      (∀ (Q_R : PrimeSpectrum ↥R) (q_y : PrimeSpectrum A_nod),
        PrimeSpectrum.comap c_nod q_y = Q_R →
        (∀ q_z : PrimeSpectrum A_nod,
          q_y.asIdeal ≤ q_z.asIdeal → PrimeSpectrum.comap c_nod q_z = Q_R → q_z = q_y) →
        ∃ q_0 : PrimeSpectrum A_nod,
          q_0.asIdeal ≤ q_y.asIdeal ∧ PrimeSpectrum.comap c_nod q_0 = Q_R ∧ q_0 ≠ q_y) ∧
      (∀ (Q_R : PrimeSpectrum ↥R) (q_y : PrimeSpectrum A_nod),
        PrimeSpectrum.comap c_nod q_y = Q_R →
        (∃ q_z : PrimeSpectrum A_nod,
          q_y.asIdeal ≤ q_z.asIdeal ∧ PrimeSpectrum.comap c_nod q_z = Q_R ∧ q_z ≠ q_y) →
        ∃ b : Fin 2,
          Ideal.Quotient.mk I_nod (MvPolynomial.X b) ∉ q_y.asIdeal ∧
          ∀ P : Polynomial ↥R,
            Polynomial.eval₂RingHom c_nod (Ideal.Quotient.mk I_nod (MvPolynomial.X b)) P ∈
              q_y.asIdeal ↔ ∀ n : ℕ, P.coeff n ∈ Q_R.asIdeal) := by
    intro a₀ ha₀_ne I_nod A_nod c_nod
    let u : Fin 2 → A_nod := fun b => Ideal.Quotient.mk I_nod (MvPolynomial.X b)
    let ι : Fin 2 → (Polynomial ↥R →+* A_nod) := fun b => Polynomial.eval₂RingHom c_nod (u b)
    have hι_C : ∀ (b : Fin 2) (r : ↥R), ι b (Polynomial.C r) = c_nod r := by
      intro b r; simp [ι]
    have hι_X : ∀ b : Fin 2, ι b Polynomial.X = u b := by
      intro b; simp [ι]
    have pow_notMem_prime : ∀ (q : PrimeSpectrum A_nod) (x : A_nod) (D : ℕ),
        x ∉ q.asIdeal → x ^ D ∉ q.asIdeal := by
      intro q x D hx
      induction D with
      | zero => rw [pow_zero]; exact q.isPrime.one_notMem
      | succ D ih => rw [pow_succ]; exact q.isPrime.mul_notMem ih hx
    have hu01 : u 0 * u 1 = c_nod a₀ := by
      apply sub_eq_zero.mp
      change Ideal.Quotient.mk I_nod (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a₀) = 0
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
    have hub_mul : ∀ (b i : Fin 2), i ≠ b → u b * u i = c_nod a₀ := by
      intro b i hne
      fin_cases b <;> fin_cases i
      · exact absurd rfl hne
      · exact hu01
      · change u 1 * u 0 = c_nod a₀
        exact (mul_comm (u 1) (u 0)).trans hu01
      · exact absurd rfl hne
    have hClear : ∀ (b : Fin 2) (f : A_nod),
        ∃ (D : ℕ) (P : Polynomial ↥R), (u b) ^ D * f = ι b P := by
      intro b f
      obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective f
      refine @MvPolynomial.induction_on ↥R (Fin 2) _
        (fun F => ∃ (D : ℕ) (P : Polynomial ↥R),
          (u b) ^ D * Ideal.Quotient.mk I_nod F = ι b P) F ?_ ?_ ?_
      · intro r
        refine ⟨0, Polynomial.C r, ?_⟩
        rw [pow_zero, one_mul, hι_C]
        rfl
      · rintro p q ⟨D₁, P₁, hp⟩ ⟨D₂, P₂, hq⟩
        refine ⟨D₁ + D₂, Polynomial.X ^ D₂ * P₁ + Polynomial.X ^ D₁ * P₂, ?_⟩
        simp only [map_add, map_mul, map_pow, hι_X]
        rw [← hp, ← hq]
        ring
      · rintro p i ⟨D, P, hp⟩
        by_cases hib : i = b
        · subst hib
          refine ⟨D, P * Polynomial.X, ?_⟩
          simp only [map_mul, hι_X]
          rw [← hp]
          ring
        · refine ⟨D + 1, P * Polynomial.C a₀, ?_⟩
          simp only [map_mul, hι_C]
          rw [← hub_mul b i hib]
          calc (u b) ^ (D + 1) * (Ideal.Quotient.mk I_nod p * u i)
            _ = ((u b) ^ D * Ideal.Quotient.mk I_nod p) * (u b * u i) := by ring
            _ = ι b P * (u b * u i) := by rw [hp]
    have hι_inj : ∀ b : Fin 2, Function.Injective (ι b) := by
      intro b
      let L_X := Localization.Away (Polynomial.X : Polynomial ↥R)
      have hSub : Submonoid.powers (Polynomial.X : Polynomial ↥R) ≤
          nonZeroDivisors (Polynomial ↥R) :=
        Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero Polynomial.X_ne_zero)
      have halg_inj : Function.Injective (algebraMap (Polynomial ↥R) L_X) :=
        IsLocalization.injective L_X hSub
      let invX : L_X := IsLocalization.Away.invSelf (Polynomial.X : Polynomial ↥R)
      have hmul_inv : algebraMap (Polynomial ↥R) L_X Polynomial.X * invX = 1 :=
        IsLocalization.Away.mul_invSelf (Polynomial.X : Polynomial ↥R)
      let v_b : Fin 2 → L_X :=
        if b = 0 then
          ![algebraMap (Polynomial ↥R) L_X Polynomial.X,
            algebraMap (Polynomial ↥R) L_X (Polynomial.C a₀) * invX]
        else
          ![algebraMap (Polynomial ↥R) L_X (Polynomial.C a₀) * invX,
            algebraMap (Polynomial ↥R) L_X Polynomial.X]
      let α_tilde : MvPolynomial (Fin 2) ↥R →+* L_X :=
        MvPolynomial.eval₂Hom ((algebraMap (Polynomial ↥R) L_X).comp Polynomial.C) v_b
      have hI_ker : ∀ a ∈ I_nod, α_tilde a = 0 := by
        show I_nod ≤ RingHom.ker α_tilde
        rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
        simp only [α_tilde, map_sub, map_mul, MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_X,
          MvPolynomial.eval₂_C, RingHom.coe_comp, Function.comp_apply]
        fin_cases b <;> dsimp [v_b]
        · calc algebraMap (Polynomial ↥R) L_X Polynomial.X *
                (algebraMap (Polynomial ↥R) L_X (Polynomial.C a₀) * invX) -
                algebraMap (Polynomial ↥R) L_X (Polynomial.C a₀)
            _ = algebraMap (Polynomial ↥R) L_X (Polynomial.C a₀) *
                  (algebraMap (Polynomial ↥R) L_X Polynomial.X * invX) -
                algebraMap (Polynomial ↥R) L_X (Polynomial.C a₀) := by ring
            _ = 0 := by rw [hmul_inv, mul_one, sub_self]
        · calc (algebraMap (Polynomial ↥R) L_X (Polynomial.C a₀) * invX) *
                algebraMap (Polynomial ↥R) L_X Polynomial.X -
                algebraMap (Polynomial ↥R) L_X (Polynomial.C a₀)
            _ = algebraMap (Polynomial ↥R) L_X (Polynomial.C a₀) *
                  (algebraMap (Polynomial ↥R) L_X Polynomial.X * invX) -
                algebraMap (Polynomial ↥R) L_X (Polynomial.C a₀) := by ring
            _ = 0 := by rw [hmul_inv, mul_one, sub_self]
      let α_b : A_nod →+* L_X := Ideal.Quotient.lift I_nod α_tilde hI_ker
      have hcomp_eq : α_b.comp (ι b) = algebraMap (Polynomial ↥R) L_X := by
        apply Polynomial.ringHom_ext'
        · apply RingHom.ext
          intro r
          simp only [RingHom.coe_comp, Function.comp_apply, hι_C]
          change Ideal.Quotient.lift I_nod α_tilde hI_ker
            (Ideal.Quotient.mk I_nod (MvPolynomial.C r)) = _
          rw [Ideal.Quotient.lift_mk]
          simp [α_tilde]
        · simp only [RingHom.coe_comp, Function.comp_apply, hι_X]
          change Ideal.Quotient.lift I_nod α_tilde hI_ker
            (Ideal.Quotient.mk I_nod (MvPolynomial.X b)) = _
          rw [Ideal.Quotient.lift_mk]
          fin_cases b <;> simp [α_tilde, v_b]
      intro P₁ P₂ hEq
      apply halg_inj
      rw [← hcomp_eq]
      exact congrArg α_b hEq
    have hNontriv_A : Nontrivial A_nod := (hι_inj 0).nontrivial
    let σ_var : Fin 2 → (MvPolynomial (Fin 2) ↥R →+* Polynomial ↥R) := fun b =>
      MvPolynomial.eval₂Hom Polynomial.C
        (if b = 0 then ![0, Polynomial.X] else ![Polynomial.X, 0])
    let j_var : Fin 2 → (Polynomial ↥R →+* MvPolynomial (Fin 2) ↥R) := fun b =>
      Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.X (1 - b))
    have mvPoly_split_var : ∀ (b : Fin 2) (F : MvPolynomial (Fin 2) ↥R),
        ∃ G : MvPolynomial (Fin 2) ↥R, F = j_var b (σ_var b F) + MvPolynomial.X b * G := by
      intro b F
      refine @MvPolynomial.induction_on ↥R (Fin 2) _
        (fun F => ∃ G : MvPolynomial (Fin 2) ↥R,
          F = j_var b (σ_var b F) + MvPolynomial.X b * G) F ?_ ?_ ?_
      · intro r
        refine ⟨0, ?_⟩
        simp [σ_var, j_var]
      · rintro p q ⟨G₁, hp⟩ ⟨G₂, hq⟩
        refine ⟨G₁ + G₂, ?_⟩
        calc p + q
          _ = (j_var b (σ_var b p) + MvPolynomial.X b * G₁) +
                (j_var b (σ_var b q) + MvPolynomial.X b * G₂) := by rw [← hp, ← hq]
          _ = j_var b (σ_var b (p + q)) + MvPolynomial.X b * (G₁ + G₂) := by
              rw [map_add, map_add]; ring
      · rintro p i ⟨G, hp⟩
        by_cases hib : i = b
        · subst hib
          refine ⟨p, ?_⟩
          have hXb_zero : σ_var i (MvPolynomial.X i) = 0 := by
            fin_cases i <;> simp [σ_var]
          rw [map_mul, hXb_zero, mul_zero, map_zero, zero_add, mul_comm]
        · refine ⟨G * MvPolynomial.X i, ?_⟩
          have hXi : σ_var b (MvPolynomial.X i) = Polynomial.X ∧ 1 - b = i := by
            fin_cases b <;> fin_cases i
            · exact absurd rfl hib
            · simp [σ_var]
            · simp [σ_var]
            · exact absurd rfl hib
          rw [map_mul, hXi.1, map_mul]
          have hjX : j_var b Polynomial.X = MvPolynomial.X i := by
            simp [j_var, hXi.2]
          rw [hjX]
          calc p * MvPolynomial.X i
            _ = (j_var b (σ_var b p) + MvPolynomial.X b * G) * MvPolynomial.X i := by rw [← hp]
            _ = j_var b (σ_var b p) * MvPolynomial.X i +
                  MvPolynomial.X b * (G * MvPolynomial.X i) := by ring
    have hu0_reg : ∀ y : A_nod, u 0 * y = 0 → y = 0 := by
      intro y hy
      obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective y
      have hmem : MvPolynomial.X 0 * F ∈ I_nod :=
        Ideal.Quotient.eq_zero_iff_mem.mp hy
      rw [Ideal.mem_span_singleton] at hmem
      obtain ⟨H, hH⟩ := hmem
      have hσH_eq : (0 : Polynomial ↥R) = -Polynomial.C a₀ * σ_var 0 H := by
        have h1 := congrArg (σ_var 0) hH
        have hX0 : σ_var 0 (MvPolynomial.X 0) = 0 := by simp [σ_var]
        have hC : σ_var 0 (MvPolynomial.C a₀) = Polynomial.C a₀ := by simp [σ_var]
        simp only [map_mul, map_sub, hX0, hC, zero_mul, zero_sub] at h1
        exact h1
      have hCa0_ne : (-Polynomial.C a₀ : Polynomial ↥R) ≠ 0 :=
        neg_ne_zero.mpr (Polynomial.C_ne_zero.mpr ha₀_ne)
      have hσH_zero : σ_var 0 H = 0 :=
        (mul_eq_zero.mp hσH_eq.symm).resolve_left hCa0_ne
      obtain ⟨G, hG⟩ := mvPoly_split_var 0 H
      rw [hσH_zero, map_zero, zero_add] at hG
      have hCancel : F = (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a₀) * G := by
        apply mul_left_cancel₀ (MvPolynomial.X_ne_zero (0 : Fin 2) :
          (MvPolynomial.X 0 : MvPolynomial (Fin 2) ↥R) ≠ 0)
        rw [hH, hG]
        ring
      apply Ideal.Quotient.eq_zero_iff_mem.mpr
      rw [Ideal.mem_span_singleton]
      exact ⟨G, hCancel⟩
    have hu0_pow_reg : ∀ (D : ℕ) (y : A_nod), (u 0) ^ D * y = 0 → y = 0 := by
      intro D
      induction D with
      | zero =>
        intro y hy
        simpa using hy
      | succ D ih =>
        intro y hy
        apply ih
        apply hu0_reg
        calc u 0 * ((u 0) ^ D * y) = (u 0) ^ (D + 1) * y := by ring
          _ = 0 := hy
    have hDom_A : IsDomain A_nod := by
      have : NoZeroDivisors A_nod := ⟨by
        intro x y hxy
        obtain ⟨D₁, P₁, hx⟩ := hClear 0 x
        obtain ⟨D₂, P₂, hy⟩ := hClear 0 y
        have hP12 : ι 0 (P₁ * P₂) = 0 := by
          rw [map_mul, ← hx, ← hy]
          calc ((u 0) ^ D₁ * x) * ((u 0) ^ D₂ * y)
            _ = (u 0) ^ (D₁ + D₂) * (x * y) := by ring
            _ = 0 := by rw [hxy, mul_zero]
        have hP_zero : P₁ * P₂ = 0 := (hι_inj 0) (hP12.trans (map_zero _).symm)
        rcases mul_eq_zero.mp hP_zero with rfl | rfl
        · rw [map_zero] at hx
          exact Or.inl (hu0_pow_reg D₁ x hx)
        · rw [map_zero] at hy
          exact Or.inr (hu0_pow_reg D₂ y hy)⟩
      exact NoZeroDivisors.to_isDomain A_nod
    have poly_coeff_mem_imp : ∀ (Q_R : PrimeSpectrum ↥R) (q : PrimeSpectrum A_nod) (b : Fin 2)
        (P : Polynomial ↥R),
        PrimeSpectrum.comap c_nod q = Q_R →
        (∀ n : ℕ, P.coeff n ∈ Q_R.asIdeal) →
        ι b P ∈ q.asIdeal := by
      intro Q_R q b P hq hcoeff
      rw [P.as_sum_support_C_mul_X_pow, map_sum]
      refine Ideal.sum_mem q.asIdeal fun n _ => ?_
      rw [map_mul]
      refine Ideal.mul_mem_right _ _ ?_
      rw [hι_C]
      have hcomap : Ideal.comap c_nod q.asIdeal = Q_R.asIdeal := congrArg PrimeSpectrum.asIdeal hq
      change P.coeff n ∈ Ideal.comap c_nod q.asIdeal
      rw [hcomap]
      exact hcoeff n
    refine ⟨hDom_A, fun b => ⟨hι_inj b, hClear b⟩, ?_, ?_⟩
    · intro Q_R q_y hq_over hClosed
      let k_Q := Q_R.asIdeal.ResidueField
      by_cases hBoth : ∀ b : Fin 2, u b ∈ q_y.asIdeal
      · have ha0_Q : a₀ ∈ Q_R.asIdeal := by
          have hc : c_nod a₀ ∈ q_y.asIdeal := by
            rw [← hu01]
            exact Ideal.mul_mem_right _ _ (hBoth 0)
          have hcomap : Ideal.comap c_nod q_y.asIdeal = Q_R.asIdeal :=
            congrArg PrimeSpectrum.asIdeal hq_over
          rw [← hcomap]
          exact hc
        have ha0_kQ : algebraMap ↥R k_Q a₀ = 0 :=
          Ideal.algebraMap_residueField_eq_zero.mpr ha0_Q
        let τ_tilde : MvPolynomial (Fin 2) ↥R →+* Polynomial k_Q :=
          MvPolynomial.eval₂Hom (Polynomial.C.comp (algebraMap ↥R k_Q)) ![Polynomial.X, 0]
        have hI_ker : ∀ a ∈ I_nod, τ_tilde a = 0 := by
          show I_nod ≤ RingHom.ker τ_tilde
          rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
          simp [τ_tilde, ha0_kQ]
        let τ_0 : A_nod →+* Polynomial k_Q := Ideal.Quotient.lift I_nod τ_tilde hI_ker
        let q_0 : PrimeSpectrum A_nod := ⟨RingHom.ker τ_0, RingHom.ker_isPrime τ_0⟩
        have hτ0_mk : ∀ G : MvPolynomial (Fin 2) ↥R,
            τ_0 (Ideal.Quotient.mk I_nod G) = τ_tilde G :=
          fun G => Ideal.Quotient.lift_mk I_nod τ_tilde hI_ker
        have hτ0_ι0 : τ_0.comp (ι 0) = Polynomial.mapRingHom (algebraMap ↥R k_Q) := by
          apply Polynomial.ringHom_ext'
          · apply RingHom.ext
            intro r
            simp only [RingHom.coe_comp, Function.comp_apply, hι_C, Polynomial.coe_mapRingHom,
              Polynomial.map_C]
            change τ_0 (Ideal.Quotient.mk I_nod (MvPolynomial.C r)) = _
            rw [hτ0_mk]
            simp [τ_tilde]
          · simp only [RingHom.coe_comp, Function.comp_apply, hι_X, Polynomial.coe_mapRingHom,
              Polynomial.map_X]
            change τ_0 (Ideal.Quotient.mk I_nod (MvPolynomial.X 0)) = _
            rw [hτ0_mk]
            simp [τ_tilde]
        have hq0_over : PrimeSpectrum.comap c_nod q_0 = Q_R := by
          ext r
          change τ_0 (Ideal.Quotient.mk I_nod (MvPolynomial.C r)) = 0 ↔ r ∈ Q_R.asIdeal
          rw [hτ0_mk]
          simp only [τ_tilde, MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_C, RingHom.coe_comp,
            Function.comp_apply, Polynomial.C_eq_zero]
          exact Ideal.algebraMap_residueField_eq_zero
        have hq0_le : q_0.asIdeal ≤ q_y.asIdeal := by
          intro f hf
          obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective f
          obtain ⟨G₁, hF_split⟩ := mvPoly_split_var 1 F
          have hmk_split : Ideal.Quotient.mk I_nod F =
              ι 0 (σ_var 1 F) + u 1 * Ideal.Quotient.mk I_nod G₁ := by
            have hj1 : (Ideal.Quotient.mk I_nod).comp (j_var 1) = ι 0 := by
              apply Polynomial.ringHom_ext'
              · apply RingHom.ext; intro r; simp [j_var, ι, c_nod]
              · simp [j_var, ι, u]
            calc Ideal.Quotient.mk I_nod F
              _ = Ideal.Quotient.mk I_nod (j_var 1 (σ_var 1 F) + MvPolynomial.X 1 * G₁) :=
                  congrArg _ hF_split
              _ = ((Ideal.Quotient.mk I_nod).comp (j_var 1)) (σ_var 1 F) +
                    u 1 * Ideal.Quotient.mk I_nod G₁ := by simp [u]
              _ = ι 0 (σ_var 1 F) + u 1 * Ideal.Quotient.mk I_nod G₁ := by rw [hj1]
          have hτ_zero : Polynomial.map (algebraMap ↥R k_Q) (σ_var 1 F) = 0 := by
            have h0 : τ_0 (Ideal.Quotient.mk I_nod F) = 0 := hf
            rw [hmk_split, map_add, map_mul] at h0
            have hu1_zero : τ_0 (u 1) = 0 := by
              change τ_0 (Ideal.Quotient.mk I_nod (MvPolynomial.X 1)) = 0
              rw [hτ0_mk]
              simp [τ_tilde]
            have hι_eq : τ_0 (ι 0 (σ_var 1 F)) =
                Polynomial.map (algebraMap ↥R k_Q) (σ_var 1 F) :=
              congrFun (congrArg DFunLike.coe hτ0_ι0) (σ_var 1 F)
            rw [hu1_zero, zero_mul, add_zero, hι_eq] at h0
            exact h0
          have hcoeff : ∀ n : ℕ, (σ_var 1 F).coeff n ∈ Q_R.asIdeal := by
            intro n
            rw [← Ideal.algebraMap_residueField_eq_zero, ← Polynomial.coeff_map, hτ_zero,
              Polynomial.coeff_zero]
          rw [hmk_split]
          exact q_y.asIdeal.add_mem (poly_coeff_mem_imp Q_R q_y 0 (σ_var 1 F) hq_over hcoeff)
            (Ideal.mul_mem_right _ _ (hBoth 1))
        have hq0_ne : q_0 ≠ q_y := by
          intro heq
          have hu0_q0 : u 0 ∈ q_0.asIdeal := heq.symm ▸ hBoth 0
          have hX : τ_0 (u 0) = Polynomial.X := by
            change τ_0 (Ideal.Quotient.mk I_nod (MvPolynomial.X 0)) = Polynomial.X
            rw [hτ0_mk]
            simp [τ_tilde]
          exact Polynomial.X_ne_zero (hX.symm.trans hu0_q0)
        exact ⟨q_0, hq0_le, hq0_over, hq0_ne⟩
      · have hEx : ∃ b : Fin 2, u b ∉ q_y.asIdeal := not_forall.mp hBoth
        obtain ⟨b, hub⟩ := hEx
        let L_kQ := Localization.Away (Polynomial.X : Polynomial k_Q)
        have hSub_kQ : Submonoid.powers (Polynomial.X : Polynomial k_Q) ≤
            nonZeroDivisors (Polynomial k_Q) :=
          Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero Polynomial.X_ne_zero)
        have : IsDomain L_kQ := IsLocalization.isDomain_localization hSub_kQ
        have halg_kQ_inj : Function.Injective (algebraMap (Polynomial k_Q) L_kQ) :=
          IsLocalization.injective L_kQ hSub_kQ
        let invX_Q : L_kQ := IsLocalization.Away.invSelf (Polynomial.X : Polynomial k_Q)
        have hmul_inv_Q : algebraMap (Polynomial k_Q) L_kQ Polynomial.X * invX_Q = 1 :=
          IsLocalization.Away.mul_invSelf (Polynomial.X : Polynomial k_Q)
        let a0_Q : L_kQ :=
          algebraMap (Polynomial k_Q) L_kQ (Polynomial.C (algebraMap ↥R k_Q a₀))
        let w_b : Fin 2 → L_kQ :=
          if b = 0 then
            ![algebraMap (Polynomial k_Q) L_kQ Polynomial.X, a0_Q * invX_Q]
          else
            ![a0_Q * invX_Q, algebraMap (Polynomial k_Q) L_kQ Polynomial.X]
        let E_tilde : MvPolynomial (Fin 2) ↥R →+* L_kQ :=
          MvPolynomial.eval₂Hom
            ((algebraMap (Polynomial k_Q) L_kQ).comp (Polynomial.C.comp (algebraMap ↥R k_Q))) w_b
        have hI_E : ∀ a ∈ I_nod, E_tilde a = 0 := by
          show I_nod ≤ RingHom.ker E_tilde
          rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
          simp only [E_tilde, map_sub, map_mul, MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_X,
            MvPolynomial.eval₂_C, RingHom.coe_comp, Function.comp_apply]
          fin_cases b <;> dsimp [w_b, a0_Q]
          · calc algebraMap (Polynomial k_Q) L_kQ Polynomial.X *
                  (algebraMap (Polynomial k_Q) L_kQ (Polynomial.C (algebraMap ↥R k_Q a₀)) * invX_Q) -
                  algebraMap (Polynomial k_Q) L_kQ (Polynomial.C (algebraMap ↥R k_Q a₀))
              _ = algebraMap (Polynomial k_Q) L_kQ (Polynomial.C (algebraMap ↥R k_Q a₀)) *
                    (algebraMap (Polynomial k_Q) L_kQ Polynomial.X * invX_Q) -
                  algebraMap (Polynomial k_Q) L_kQ (Polynomial.C (algebraMap ↥R k_Q a₀)) := by ring
              _ = 0 := by rw [hmul_inv_Q, mul_one, sub_self]
          · calc (algebraMap (Polynomial k_Q) L_kQ (Polynomial.C (algebraMap ↥R k_Q a₀)) * invX_Q) *
                  algebraMap (Polynomial k_Q) L_kQ Polynomial.X -
                  algebraMap (Polynomial k_Q) L_kQ (Polynomial.C (algebraMap ↥R k_Q a₀))
              _ = algebraMap (Polynomial k_Q) L_kQ (Polynomial.C (algebraMap ↥R k_Q a₀)) *
                    (algebraMap (Polynomial k_Q) L_kQ Polynomial.X * invX_Q) -
                  algebraMap (Polynomial k_Q) L_kQ (Polynomial.C (algebraMap ↥R k_Q a₀)) := by ring
              _ = 0 := by rw [hmul_inv_Q, mul_one, sub_self]
        let E_bar : A_nod →+* L_kQ := Ideal.Quotient.lift I_nod E_tilde hI_E
        let q_0 : PrimeSpectrum A_nod := ⟨RingHom.ker E_bar, RingHom.ker_isPrime E_bar⟩
        have hE_ι : E_bar.comp (ι b) =
            (algebraMap (Polynomial k_Q) L_kQ).comp (Polynomial.mapRingHom (algebraMap ↥R k_Q)) := by
          apply Polynomial.ringHom_ext'
          · apply RingHom.ext
            intro r
            simp only [RingHom.coe_comp, Function.comp_apply, hι_C, Polynomial.coe_mapRingHom,
              Polynomial.map_C]
            change Ideal.Quotient.lift I_nod E_tilde hI_E
              (Ideal.Quotient.mk I_nod (MvPolynomial.C r)) = _
            rw [Ideal.Quotient.lift_mk]
            simp [E_tilde]
          · simp only [RingHom.coe_comp, Function.comp_apply, hι_X, Polynomial.coe_mapRingHom,
              Polynomial.map_X]
            change Ideal.Quotient.lift I_nod E_tilde hI_E
              (Ideal.Quotient.mk I_nod (MvPolynomial.X b)) = _
            rw [Ideal.Quotient.lift_mk]
            fin_cases b <;> simp [E_tilde, w_b]
        have hq0_ι : ∀ P : Polynomial ↥R,
            ι b P ∈ q_0.asIdeal ↔ ∀ n : ℕ, P.coeff n ∈ Q_R.asIdeal := by
          intro P
          change E_bar (ι b P) = 0 ↔ _
          have h1 : E_bar (ι b P) =
