            · rw [hBset_Z]; exact ⟨y_nod0, hyE, rfl⟩
          · rintro y ⟨hy1, hy2⟩
            rw [hBset_Z] at hy2
            obtain ⟨u, huE, rfl⟩ := hy2
            change u ∈ j_1.base ⁻¹' (B_set (i_Z.succAbove i'_p)) at hy1
            rw [hj1_succ_ip] at hy1
