      rw [hmkConstQuotHom_mk b' q_Q₀ hqQ_b, hP1_coeff0]
      exact hc0_unit.map q_Q₀
    let ρ_σ : Localization.Away h_e →+* (R₀ ⧸ Q₀) :=
      IsLocalization.Away.lift (S := Localization.Away h_e) h_e hu_he
    let ρ_τ0 : Localization.Away h_0 →+* (R₀ ⧸ Q₀) :=
