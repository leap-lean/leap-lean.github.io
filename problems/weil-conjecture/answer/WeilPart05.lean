      · rw [hComap_eq_kerΦQ]
        intro x hx
        obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective x
        rw [RingHom.mem_ker, hΦP_mk]
        rw [RingHom.mem_ker, hΦQ_mk] at hx
        apply Polynomial.ext
        intro k
        simp only [Polynomial.coeff_map, Polynomial.coeff_zero]
        have hkQ : τ_Q ((MvPolynomial.eval₂Hom Polynomial.C
            (fun j => if j = i₀ then 0 else Polynomial.X) F).coeff k) = 0 := by
          have := congrArg (fun p => Polynomial.coeff p k) hx
          simpa using this
        have hk_in_P := hQP (hKer_τQ ▸ RingHom.mem_ker.mpr hkQ)
        exact RingHom.mem_ker.mp (hKer_τP.symm ▸ hk_in_P)
      · ext c
        simp only [Ideal.mem_comap, p_P, RingHom.mem_ker, hΦP_C, Polynomial.C_eq_zero]
        rw [← RingHom.mem_ker, hKer_τP]
      · intro g ⟨k, hgk⟩ hmem
        rw [RingHom.mem_ker, hΦP_eval] at hmem
        have hk0 : τ_P (g.coeff k) = 0 := by
          have := congrArg (fun p => Polynomial.coeff p k) hmem
          simpa using this
        exact hgk (hKer_τP ▸ RingHom.mem_ker.mpr hk0)

    · 
      
      
      have mkNodalMap : ∀ {I : Ideal ↥V} [I.IsPrime] {V_I : ValuationSubring I.ResidueField}
          (τ_I : ↥V →+* ↥V_I),
          Function.Surjective τ_I → RingHom.ker τ_I = I → a ∉ I →
          let I_bar : Ideal (MvPolynomial (Fin 2) ↥V_I) :=
            Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C (τ_I a)}
          IsDomain (MvPolynomial (Fin 2) ↥V_I ⧸ I_bar) ∧
          IsIntegrallyClosed (MvPolynomial (Fin 2) ↥V_I ⧸ I_bar) ∧
          ∃ ψ_nod : A_nod →+* (MvPolynomial (Fin 2) ↥V_I ⧸ I_bar),
            Function.Surjective ψ_nod ∧
            (∀ F : MvPolynomial (Fin 2) ↥V,
              ψ_nod (mk_a F) = Ideal.Quotient.mk I_bar (MvPolynomial.map τ_I F)) ∧
            RingHom.ker ψ_nod = Ideal.map γ_nod I := by
        intro I _ V_I τ_I hSurj_τ hKer_τ ha_not_I I_bar
        have hτa_ne : τ_I a ≠ 0 :=
          fun h0 => ha_not_I (hKer_τ ▸ RingHom.mem_ker.mpr h0)
        obtain ⟨hDom_I, hIC_I⟩ := hNodalNorm I.ResidueField V_I (τ_I a) hτa_ne
        let ψ_tilde : MvPolynomial (Fin 2) ↥V →+* (MvPolynomial (Fin 2) ↥V_I ⧸ I_bar) :=
          (Ideal.Quotient.mk I_bar).comp (MvPolynomial.map τ_I)
        have h_ker_le : I_a ≤ RingHom.ker ψ_tilde := by
          rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
          change Ideal.Quotient.mk I_bar (MvPolynomial.map τ_I
            (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a)) = 0
          rw [map_sub, map_mul, MvPolynomial.map_X, MvPolynomial.map_X, MvPolynomial.map_C]
          exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
        let ψ_nod : A_nod →+* (MvPolynomial (Fin 2) ↥V_I ⧸ I_bar) :=
          Ideal.Quotient.lift I_a ψ_tilde (fun x hx => h_ker_le hx)
        have hSurj_ψ : Function.Surjective ψ_nod := by
          intro y
          obtain ⟨F_bar, rfl⟩ := Ideal.Quotient.mk_surjective y
          obtain ⟨F, rfl⟩ := MvPolynomial.map_surjective τ_I hSurj_τ F_bar
          exact ⟨mk_a F, rfl⟩
        refine ⟨hDom_I, hIC_I, ψ_nod, hSurj_ψ, fun _ => rfl, ?_⟩
        apply le_antisymm
        · intro x hx
          obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective x
          have hmem_bar : MvPolynomial.map τ_I F ∈ I_bar :=
            Ideal.Quotient.eq_zero_iff_mem.mp hx
          obtain ⟨G_bar, hG_bar⟩ := Ideal.mem_span_singleton.mp hmem_bar
          obtain ⟨G, rfl⟩ := MvPolynomial.map_surjective τ_I hSurj_τ G_bar
          let H : MvPolynomial (Fin 2) ↥V :=
            F - (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a) * G
          have hmk_H : mk_a F = mk_a H := by
            have hmem_Ia : (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a) * G ∈ I_a :=
              I_a.mul_mem_right G (Ideal.subset_span rfl)
            change mk_a F = mk_a (F - (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a) * G)
            rw [map_sub, Ideal.Quotient.eq_zero_iff_mem.mpr hmem_Ia, sub_zero]
          have hmap_H : MvPolynomial.map τ_I H = 0 := by
            simp only [H, map_sub, map_mul, MvPolynomial.map_X, MvPolynomial.map_C]
            rw [hG_bar, sub_self]
          rw [hmk_H, MvPolynomial.as_sum H, map_sum]
          refine (Ideal.map γ_nod I).sum_mem fun d _hd => ?_
          have hmon : MvPolynomial.monomial d (H.coeff d) =
              MvPolynomial.C (H.coeff d) * MvPolynomial.monomial d 1 := by
            rw [MvPolynomial.C_mul_monomial, mul_one]
          rw [hmon, map_mul]
          refine (Ideal.map γ_nod I).mul_mem_right _ ?_
          have hd0 : τ_I (H.coeff d) = 0 := by
            have := congrArg (fun p => p.coeff d) hmap_H
            simpa [MvPolynomial.coeff_map] using this
          exact Ideal.mem_map_of_mem γ_nod (hKer_τ ▸ RingHom.mem_ker.mpr hd0)
        · rw [Ideal.map_le_iff_le_comap]
          intro c hc
          have hc0 : τ_I c = 0 := RingHom.mem_ker.mp (by rwa [hKer_τ])
          change Ideal.Quotient.mk I_bar (MvPolynomial.map τ_I (MvPolynomial.C c)) = 0
          rw [MvPolynomial.map_C, hc0, map_zero, map_zero]

      obtain ⟨hDom_AQ, hIC_AQ, ψ_nod_Q, hSurj_ψQ, hψQ_mk, hKer_ψQ⟩ :=
        mkNodalMap τ_Q hSurj_τQ hKer_τQ haQ
      let I_bar_Q : Ideal (MvPolynomial (Fin 2) ↥V_Q) :=
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C (τ_Q a)}
      let A_nod_Q := MvPolynomial (Fin 2) ↥V_Q ⧸ I_bar_Q
      letI : CommRing A_nod_Q := Ideal.Quotient.commRing I_bar_Q
      have : IsDomain A_nod_Q := hDom_AQ
      have : IsIntegrallyClosed A_nod_Q := hIC_AQ

      
      have hprod_ne : σ u₀ * σ u₁ ≠ 0 := by
        rw [← map_mul, hu_mul, hσ_C]
        intro h0
        have ha0 : algebraMap ↥V Q.ResidueField a = 0 := ι_QW.injective (h0.trans (map_zero _).symm)
        exact haQ ((Ideal.ker_algebraMap_residueField Q).le ha0)
      have hσ_u₀_ne : σ u₀ ≠ 0 := left_ne_zero_of_mul hprod_ne
      have hσ_u₀_tr : σ u₀ ∉ Set.range ι_QW := by
        rintro ⟨z₀, hz₀⟩
        apply hNotBoth_mem
        refine ⟨⟨z₀, hz₀⟩, z₀⁻¹ * algebraMap ↥V Q.ResidueField a, ?_⟩
        apply mul_left_cancel₀ hσ_u₀_ne
        calc
          σ u₀ * ι_QW (z₀⁻¹ * algebraMap ↥V Q.ResidueField a)
            = (σ u₀ * (σ u₀)⁻¹) * ι_QW (algebraMap ↥V Q.ResidueField a) := by
              rw [map_mul, map_inv₀, hz₀, mul_assoc]
          _ = σ (γ_nod a) := by rw [mul_inv_cancel₀ hσ_u₀_ne, one_mul, ← hσ_C]
          _ = σ u₀ * σ u₁ := by rw [← hu_mul, map_mul]

      let ε_tilde_Q : MvPolynomial (Fin 2) ↥V_Q →+* κ_W :=
        MvPolynomial.eval₂Hom (ι_QW.comp V_Q.subtype) ![σ u₀, σ u₁]
      have h_ker_εQ : I_bar_Q ≤ RingHom.ker ε_tilde_Q := by
        rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
        simp only [ε_tilde_Q, map_sub, map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C,
          Matrix.cons_val_zero, Matrix.cons_val_one, RingHom.comp_apply,
          hSub_τQ, ← hσ_C, ← hu_mul, sub_self]
      let ε_nod_Q : A_nod_Q →+* κ_W :=
        Ideal.Quotient.lift I_bar_Q ε_tilde_Q (fun x hx => h_ker_εQ hx)
      have hε_ψQ : ε_nod_Q.comp ψ_nod_Q = σ := by
        apply Ideal.Quotient.ringHom_ext
        apply MvPolynomial.ringHom_ext
        · intro c
          change ε_nod_Q (ψ_nod_Q (mk_a (MvPolynomial.C c))) = σ (γ_nod c)
          rw [hψQ_mk, hσ_C]
          change ε_tilde_Q (MvPolynomial.map τ_Q (MvPolynomial.C c)) = _
          rw [MvPolynomial.map_C, MvPolynomial.eval₂Hom_C, RingHom.comp_apply, hSub_τQ]
        · intro j
          have hj : j = 0 ∨ j = 1 := by fin_cases j <;> simp
          rcases hj with rfl | rfl
          · change ε_nod_Q (ψ_nod_Q (mk_a (MvPolynomial.X 0))) = σ u₀
            rw [hψQ_mk]
            change ε_tilde_Q (MvPolynomial.map τ_Q (MvPolynomial.X 0)) = σ u₀
            rw [MvPolynomial.map_X, MvPolynomial.eval₂Hom_X', Matrix.cons_val_zero]
          · change ε_nod_Q (ψ_nod_Q (mk_a (MvPolynomial.X 1))) = σ u₁
            rw [hψQ_mk]
            change ε_tilde_Q (MvPolynomial.map τ_Q (MvPolynomial.X 1)) = σ u₁
            rw [MvPolynomial.map_X, MvPolynomial.eval₂Hom_X', Matrix.cons_val_one,
              Matrix.cons_val_zero]

      
      have hInj_εQ : Function.Injective ε_nod_Q := by
        rw [injective_iff_map_eq_zero]
        let mk_Q : MvPolynomial (Fin 2) ↥V_Q →+* A_nod_Q := Ideal.Quotient.mk I_bar_Q
        let X_bar₀ : A_nod_Q := mk_Q (MvPolynomial.X 0)
        let X_bar₁ : A_nod_Q := mk_Q (MvPolynomial.X 1)
        let c_Q : ↥V_Q →+* A_nod_Q := mk_Q.comp MvPolynomial.C
        have hε_X₀ : ε_nod_Q X_bar₀ = σ u₀ := by
          change ε_tilde_Q (MvPolynomial.X 0) = σ u₀
          rw [MvPolynomial.eval₂Hom_X', Matrix.cons_val_zero]
        have hX_mul : X_bar₀ * X_bar₁ = c_Q (τ_Q a) := by
          have h0 : mk_Q (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C (τ_Q a)) = 0 :=
            Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
          rw [map_sub, map_mul] at h0
          exact sub_eq_zero.mp h0
        have hX₀_ne : X_bar₀ ≠ 0 := by
          intro h0
          exact hσ_u₀_ne (hε_X₀ ▸ (h0 ▸ map_zero ε_nod_Q))
        have hLaurent : ∀ F : MvPolynomial (Fin 2) ↥V_Q,
            ∃ (N : ℕ) (P₀ : Polynomial ↥V_Q),
              X_bar₀ ^ N * mk_Q F = Polynomial.eval₂ c_Q X_bar₀ P₀ := by
          intro F
          induction F using MvPolynomial.induction_on with
          | C b =>
            exact ⟨0, Polynomial.C b, by simp [c_Q]⟩
          | add p q hp hq =>
            obtain ⟨N₁, P₁, h₁⟩ := hp
            obtain ⟨N₂, P₂, h₂⟩ := hq
            refine ⟨N₁ + N₂, Polynomial.X ^ N₂ * P₁ + Polynomial.X ^ N₁ * P₂, ?_⟩
            rw [Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_mul,
              Polynomial.eval₂_X_pow, Polynomial.eval₂_X_pow, ← h₁, ← h₂, map_add]
            ring
          | mul_X p j hp =>
            obtain ⟨N₁, P₁, h₁⟩ := hp
            have hj : j = 0 ∨ j = 1 := by fin_cases j <;> simp
            rcases hj with rfl | rfl
            · refine ⟨N₁, P₁ * Polynomial.X, ?_⟩
              rw [Polynomial.eval₂_mul, Polynomial.eval₂_X, ← h₁, map_mul]
              change X_bar₀ ^ N₁ * (mk_Q p * X_bar₀) = (X_bar₀ ^ N₁ * mk_Q p) * X_bar₀
              ring
            · refine ⟨N₁ + 1, Polynomial.C (τ_Q a) * P₁, ?_⟩
              rw [Polynomial.eval₂_mul, Polynomial.eval₂_C, ← h₁, map_mul]
              calc
                X_bar₀ ^ (N₁ + 1) * (mk_Q p * X_bar₁)
                  = (X_bar₀ * X_bar₁) * (X_bar₀ ^ N₁ * mk_Q p) := by ring
                _ = c_Q (τ_Q a) * (X_bar₀ ^ N₁ * mk_Q p) := by rw [hX_mul]
        intro x hx
        obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective x
        obtain ⟨N, P₀, hNP⟩ := hLaurent F
        have hEval_zero : Polynomial.eval₂ (ι_QW.comp V_Q.subtype) (σ u₀) P₀ = 0 := by
          have h1 := congrArg ε_nod_Q hNP
          rw [map_mul, hx, mul_zero, Polynomial.hom_eval₂] at h1
          have hc : ε_nod_Q.comp c_Q = ι_QW.comp V_Q.subtype := by
            apply RingHom.ext
            intro b
            change ε_tilde_Q (MvPolynomial.C b) = (ι_QW.comp V_Q.subtype) b
            exact MvPolynomial.eval₂Hom_C _ _ b
          rw [hc, hε_X₀] at h1
          exact h1.symm
        have hEval_map : Polynomial.eval₂ ι_QW (σ u₀) (P₀.map V_Q.subtype) = 0 := by
          rw [Polynomial.eval₂_map]; exact hEval_zero
        have hMap_zero := hAlgClosed_tr (σ u₀) hσ_u₀_tr (P₀.map V_Q.subtype) hEval_map
        have hP₀_zero : P₀ = 0 :=
          Polynomial.map_injective V_Q.subtype Subtype.val_injective
            (hMap_zero.trans (Polynomial.map_zero V_Q.subtype).symm)
        rw [hP₀_zero, Polynomial.eval₂_zero] at hNP
        exact (mul_eq_zero.mp hNP).resolve_left (pow_ne_zero N hX₀_ne)

      have hComap_eq_kerψQ : Ideal.comap θ_nod q'_η = RingHom.ker ψ_nod_Q := by
        rw [← hKer_σ]
        ext x
        simp only [RingHom.mem_ker, ← hε_ψQ, RingHom.comp_apply, map_eq_zero_iff ε_nod_Q hInj_εQ]

      let e_nod_Q : (A_nod ⧸ Ideal.comap θ_nod q'_η) ≃+* A_nod_Q :=
        (Ideal.quotEquivOfEq hComap_eq_kerψQ).trans
          (RingHom.quotientKerEquivOfSurjective hSurj_ψQ)
      have hDom_Q : IsDomain (A_nod ⧸ Ideal.comap θ_nod q'_η) :=
        Function.Injective.isDomain e_nod_Q.toRingHom e_nod_Q.injective
      have hIC_Q : IsIntegrallyClosed (A_nod ⧸ Ideal.comap θ_nod q'_η) :=
        IsIntegrallyClosed.of_equiv e_nod_Q.symm
      have hComap_eq_mapQ : Ideal.comap θ_nod q'_η = Ideal.map γ_nod Q :=
        hComap_eq_kerψQ.trans hKer_ψQ

      by_cases haP : a ∈ P
      · 
        
        
        have hu_prod_y₀ : u₀ * u₁ ∈ p_y₀ := by
          rw [hu_mul]
          change a ∈ Ideal.comap γ_nod p_y₀
          rwa [hp_y₀_P]
        have hex_y₀_branch : ∃ i₀ i₁ : Fin 2,
            ((i₀ = 0 ∧ i₁ = 1) ∨ (i₀ = 1 ∧ i₁ = 0)) ∧ mk_a (MvPolynomial.X i₀) ∈ p_y₀ := by
          have instPrime_py₀ : p_y₀.IsPrime := Ideal.IsPrime.comap θ_nod
          rcases instPrime_py₀.mem_or_mem hu_prod_y₀ with h0 | h1
          · exact ⟨0, 1, Or.inl ⟨rfl, rfl⟩, h0⟩
          · exact ⟨1, 0, Or.inr ⟨rfl, rfl⟩, h1⟩
        obtain ⟨i₀, i₁, hij, hu_i₀_y₀⟩ := hex_y₀_branch
        obtain ⟨Φ_P, _hSurj_ΦP, hΦP_mk, hΦP_C, _hΦP_i₀, _hΦP_i₁, hΦP_eval⟩ :=
          mkBranchProj τ_P hSurj_τP hKer_τP haP i₀ i₁ hij
        let p_P : Ideal A_nod := RingHom.ker Φ_P
        have instPrime_pP : p_P.IsPrime := RingHom.ker_isPrime Φ_P
        have hp_P_C : Ideal.comap γ_nod p_P = P := by
          ext c
          simp only [Ideal.mem_comap, p_P, RingHom.mem_ker, hΦP_C, Polynomial.C_eq_zero]
          rw [← RingHom.mem_ker, hKer_τP]
        refine ⟨hDom_Q, hIC_Q, p_P, instPrime_pP, mk_a (MvPolynomial.X i₁), ?_,
          hBranch_le_y₀ i₀ i₁ hij Φ_P hΦP_mk hu_i₀_y₀, hp_P_C, ?_⟩
        · rw [hComap_eq_mapQ, Ideal.map_le_iff_le_comap, hp_P_C]
          exact hQP
        · intro g ⟨k, hgk⟩ hmem
          rw [RingHom.mem_ker, hΦP_eval] at hmem
          have hk0 : τ_P (g.coeff k) = 0 := by
            have := congrArg (fun p => Polynomial.coeff p k) hmem
            simpa using this
          exact hgk (hKer_τP ▸ RingHom.mem_ker.mpr hk0)

      · 
        
        
        obtain ⟨hDom_AP, _hIC_AP, ψ_nod_P, _hSurj_ψP, _hψP_mk, hKer_ψP⟩ :=
          mkNodalMap τ_P hSurj_τP hKer_τP haP
        let I_bar_P : Ideal (MvPolynomial (Fin 2) ↥V_P) :=
          Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C (τ_P a)}
        have : IsDomain (MvPolynomial (Fin 2) ↥V_P ⧸ I_bar_P) := hDom_AP
        let p_P : Ideal A_nod := RingHom.ker ψ_nod_P
        have instPrime_pP : p_P.IsPrime := RingHom.ker_isPrime ψ_nod_P
        have hp_lo : Ideal.comap θ_nod q'_η ≤ p_P := by
          rw [hComap_eq_mapQ, show p_P = Ideal.map γ_nod P from hKer_ψP]
          exact Ideal.map_mono hQP
        have hp_hi : p_P ≤ p_y₀ := by
          rw [show p_P = Ideal.map γ_nod P from hKer_ψP, Ideal.map_le_iff_le_comap]
          exact hp_y₀_P.ge
        have hp_P_C : Ideal.comap γ_nod p_P = P := by
          apply le_antisymm
          · exact hp_y₀_P ▸ Ideal.comap_mono hp_hi
          · rw [show p_P = Ideal.map γ_nod P from hKer_ψP]
            exact Ideal.le_comap_map
        refine ⟨hDom_Q, hIC_Q, p_P, instPrime_pP, u₀, hp_lo, hp_hi, hp_P_C, ?_⟩
        
        intro g ⟨k, hgk⟩ hmem
        let K_P := P.ResidueField
        let π_P : ↥V →+* K_P := algebraMap ↥V K_P
        let L_P := Localization.Away (Polynomial.X : Polynomial K_P)
        let alg_L : Polynomial K_P →+* L_P := algebraMap (Polynomial K_P) L_P
        have hInj_L : Function.Injective alg_L := by
          refine IsLocalization.injective L_P
            (M := Submonoid.powers (Polynomial.X : Polynomial K_P)) ?_
          rintro _ ⟨n, rfl⟩
          exact mem_nonZeroDivisors_of_ne_zero (pow_ne_zero n Polynomial.X_ne_zero)
        let T₀ : L_P := alg_L Polynomial.X
        let T₀_inv : L_P :=
          IsLocalization.Away.invSelf (S := L_P) (Polynomial.X : Polynomial K_P)
        have hT₀_mul : T₀ * T₀_inv = 1 :=
          IsLocalization.Away.mul_invSelf (S := L_P) (Polynomial.X : Polynomial K_P)
        let ν_tilde : MvPolynomial (Fin 2) ↥V →+* L_P :=
          MvPolynomial.eval₂Hom (alg_L.comp (Polynomial.C.comp π_P))
            ![T₀, alg_L (Polynomial.C (π_P a)) * T₀_inv]
        have h_ker_ν : I_a ≤ RingHom.ker ν_tilde := by
          rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
          simp only [ν_tilde, map_sub, map_mul, MvPolynomial.eval₂Hom_X',
            MvPolynomial.eval₂Hom_C, Matrix.cons_val_zero, Matrix.cons_val_one,
            RingHom.comp_apply]
          calc
            T₀ * (alg_L (Polynomial.C (π_P a)) * T₀_inv) - alg_L (Polynomial.C (π_P a))
              = alg_L (Polynomial.C (π_P a)) * (T₀ * T₀_inv) - alg_L (Polynomial.C (π_P a)) := by
                ring
            _ = 0 := by rw [hT₀_mul, mul_one, sub_self]
        let ν : A_nod →+* L_P :=
          Ideal.Quotient.lift I_a ν_tilde (fun x hx => h_ker_ν hx)
        have hpP_ker_ν : p_P ≤ RingHom.ker ν := by
          rw [show p_P = Ideal.map γ_nod P from hKer_ψP, Ideal.map_le_iff_le_comap]
          intro c hc
          have hc0 : π_P c = 0 :=
            RingHom.mem_ker.mp (by rwa [Ideal.ker_algebraMap_residueField])
          change ν_tilde (MvPolynomial.C c) = 0
          simp only [ν_tilde, MvPolynomial.eval₂Hom_C, RingHom.comp_apply, hc0, map_zero]
        have hν_zero : ν (Polynomial.eval₂ γ_nod u₀ g) = 0 := hpP_ker_ν hmem
        have hν_eval : ν (Polynomial.eval₂ γ_nod u₀ g) = alg_L (g.map π_P) := by
          rw [Polynomial.hom_eval₂]
          have hcomp : ν.comp γ_nod = alg_L.comp (Polynomial.C.comp π_P) := by
            apply RingHom.ext
            intro c
            change ν_tilde (MvPolynomial.C c) = (alg_L.comp (Polynomial.C.comp π_P)) c
            exact MvPolynomial.eval₂Hom_C _ _ c
          have hu₀ : ν u₀ = alg_L Polynomial.X := by
            change ν_tilde (MvPolynomial.X 0) = alg_L Polynomial.X
            rw [MvPolynomial.eval₂Hom_X', Matrix.cons_val_zero]
          rw [hcomp, hu₀, ← Polynomial.hom_eval₂, ← Polynomial.eval₂_map, Polynomial.eval₂_C_X]
        have hg_map_zero : g.map π_P = 0 :=
          hInj_L ((hν_eval.symm.trans hν_zero).trans (map_zero alg_L).symm)
        have hk0 : π_P (g.coeff k) = 0 := by
          have := congrArg (fun p => Polynomial.coeff p k) hg_map_zero
          simpa using this
        exact hgk ((Ideal.ker_algebraMap_residueField P).le hk0)

theorem weil_bivariate_obstruction_and_algClosed_fiber_nonMaximal (K : Type u) [Field K]
    (V : ValuationSubring K) :
    (∀ (F : Type u) [Field F] (φ_KF : K →+* F),
      (∀ (W : ValuationSubring F)
          (hV : ∀ c : ↥V, φ_KF (V.subtype c) ∈ W)
          (P : Ideal ↥V) [P.IsPrime],
        (∀ c : ↥V,
          ((⟨φ_KF (V.subtype c), hV c⟩ : ↥W) ∈ IsLocalRing.maximalIdeal ↥W ↔ c ∈ P)) →
        ¬ ∃ (t₁ t₂ : ↥W),
          ∀ (Q : MvPolynomial (Fin 2) ↥V),
            (∃ d : Fin 2 →₀ ℕ, Q.coeff d ∉ P) →
            MvPolynomial.eval₂ ((φ_KF.comp V.subtype).codRestrict W.toSubring hV) ![t₁, t₂] Q ∉
              IsLocalRing.maximalIdeal ↥W) →
      ∀ (P : Ideal ↥V) [P.IsPrime]
        (B : Type u) [CommRing B] [IsDomain B]
        (γ : ↥V →+* B) (φ : B →+* F),
        Function.Injective φ →
        (∀ c : ↥V, φ (γ c) = φ_KF (V.subtype c)) →
        ∀ (q₁ q₂ : Ideal B) [q₁.IsPrime] [q₂.IsPrime],
          q₁ ≤ q₂ →
          Ideal.comap γ q₁ = P →
          ∀ (b₁ : B),
            (∀ g : Polynomial ↥V, (∃ i : ℕ, g.coeff i ∉ P) → Polynomial.eval₂ γ b₁ g ∉ q₂) →
            q₁ = q₂) ∧
    (∀ (P : Ideal ↥V) [P.IsPrime] [IsAlgClosed P.ResidueField]
        (B : Type u) [CommRing B]
        (γ : ↥V →+* B),
      γ.FiniteType →
      ∀ (q_P : Ideal B) [q_P.IsPrime],
        Ideal.comap γ q_P = P →
        ∀ (t_coord : B),
          (∀ g : Polynomial ↥V, (∃ i : ℕ, g.coeff i ∉ P) → Polynomial.eval₂ γ t_coord g ∉ q_P) →
          ∃ (q₁ : Ideal B) (_ : q₁.IsPrime),
            q_P ≤ q₁ ∧ q₁ ≠ q_P ∧ Ideal.comap γ q₁ = P) :=
by
  refine ⟨?_, ?_⟩
  · intro F _ φ_KF hTwoVar P _ B _ _ γ φ hInj hCompat q₁ q₂ _ _ hq_le hq₁_P b₁ hb₁_tr
    by_contra hne
    have hnot_le : ¬ ((q₂ : Set B) ⊆ (q₁ : Set B)) := fun h =>
      hne (le_antisymm hq_le (SetLike.coe_subset_coe.mp h))
    obtain ⟨b₂, hb₂_q₂, hb₂_not_q₁⟩ := Set.not_subset.mp hnot_le
    
    let R_loc := _root_.Localization.AtPrime q₁
    have h_unit : ∀ y : q₁.primeCompl, IsUnit (φ y) := by
      intro y
      have hy_ne : (y : B) ≠ 0 := fun h0 => y.2 (h0 ▸ q₁.zero_mem)
      have hφ_ne : φ y ≠ 0 := fun h0 => hy_ne (hInj (h0.trans (map_zero φ).symm))
      exact hφ_ne.isUnit
    let φ_loc : R_loc →+* F := IsLocalization.lift (M := q₁.primeCompl) (S := R_loc) h_unit
    have hφ_loc_eq : ∀ b : B, φ_loc (algebraMap B R_loc b) = φ b :=
      IsLocalization.lift_eq (M := q₁.primeCompl) (S := R_loc) h_unit
    obtain ⟨W, h_mem, h_loc⟩ := IsLocalRing.exists_factor_valuationRing φ_loc
    let ψ_loc : R_loc →+* ↥W := φ_loc.codRestrict W.toSubring h_mem
    have : IsLocalHom ψ_loc := h_loc
    let ρ : B →+* ↥W := ψ_loc.comp (algebraMap B R_loc)
    have hρ_val : ∀ b : B, (ρ b : F) = φ b := fun b => hφ_loc_eq b
    have hV : ∀ c : ↥V, φ_KF (V.subtype c) ∈ W := by
      intro c
      rw [← hCompat c, ← hρ_val (γ c)]
      exact (ρ (γ c)).2
    have hCodEq : (φ_KF.comp V.subtype).codRestrict W.toSubring hV = ρ.comp γ := by
      ext c
      change φ_KF (V.subtype c) = (ρ (γ c) : F)
      rw [hρ_val, hCompat]
    have hρ_q₁ : ∀ b : B, ρ b ∈ IsLocalRing.maximalIdeal ↥W ↔ b ∈ q₁ := by
      intro b
      change ψ_loc (algebraMap B R_loc b) ∈ IsLocalRing.maximalIdeal ↥W ↔ b ∈ q₁
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, isUnit_map_iff ψ_loc,
        ← mem_nonunits_iff, ← IsLocalRing.mem_maximalIdeal,
        IsLocalization.AtPrime.to_map_mem_maximal_iff R_loc q₁ b]
    have hCenter : ∀ c : ↥V,
        ((⟨φ_KF (V.subtype c), hV c⟩ : ↥W) ∈ IsLocalRing.maximalIdeal ↥W ↔ c ∈ P) := by
      intro c
      have hc_eq : (⟨φ_KF (V.subtype c), hV c⟩ : ↥W) = ρ (γ c) := by
        have h := RingHom.congr_fun hCodEq c
        exact h
      rw [hc_eq, hρ_q₁, ← hq₁_P]
      rfl
    
    apply hTwoVar W hV P hCenter
    refine ⟨ρ b₁, ρ b₂, ?_⟩
    intro Q hQ
    have hvec : (fun i : Fin 2 => ρ (![b₁, b₂] i)) = ![ρ b₁, ρ b₂] := by
      funext i
      fin_cases i <;> rfl
    rw [hCodEq, ← hvec, ← MvPolynomial.hom_eval₂ Q γ ρ ![b₁, b₂], hρ_q₁]
    classical
    let R₀ := ↥V
    let Φ : MvPolynomial (Fin 2) R₀ →+* Polynomial (Polynomial R₀) :=
      MvPolynomial.eval₂Hom (Polynomial.C.comp Polynomial.C)
        ![Polynomial.C Polynomial.X, Polynomial.X]
    let H : Polynomial (Polynomial R₀) := Φ Q
    let α : Polynomial R₀ →+* B := Polynomial.eval₂RingHom γ b₁
    let E : Polynomial (Polynomial R₀) →+* B := Polynomial.eval₂RingHom α b₂
    have hEΦ : E.comp Φ = MvPolynomial.eval₂Hom γ ![b₁, b₂] := by
      apply MvPolynomial.ringHom_ext'
      · ext c
        simp [Φ, E, α]
      · intro k
        fin_cases k <;> simp [Φ, E, α]
    let F_poly : Polynomial B := Polynomial.map α H
    have hEvalEq : MvPolynomial.eval₂ γ ![b₁, b₂] Q = F_poly.eval b₂ := by
      have h1 : MvPolynomial.eval₂ γ ![b₁, b₂] Q = E H :=
        (RingHom.congr_fun hEΦ Q).symm
      rw [h1]
      exact Polynomial.eval₂_eq_eval_map α
    have hF_coeff : ∀ j : ℕ, F_poly.coeff j = Polynomial.eval₂ γ b₁ (H.coeff j) := by
      intro j
      exact Polynomial.coeff_map α j
    have hΦ_mon : ∀ (v : Fin 2 →₀ ℕ) (c : R₀),
        Φ (MvPolynomial.monomial v c) =
          Polynomial.monomial (v 1) (Polynomial.monomial (v 0) c) := by
      intro v c
      change MvPolynomial.eval₂ (Polynomial.C.comp Polynomial.C)
        ![Polynomial.C Polynomial.X, Polynomial.X] (MvPolynomial.monomial v c) = _
      rw [MvPolynomial.eval₂_monomial, Finsupp.prod_fintype _ _ (fun _ => pow_zero _),
        Fin.prod_univ_two]
      change Polynomial.C (Polynomial.C c) *
          ((Polynomial.C Polynomial.X) ^ v 0 * Polynomial.X ^ v 1) = _
      rw [← Polynomial.C_pow, ← mul_assoc, ← Polynomial.C_mul,
        Polynomial.C_mul_X_pow_eq_monomial, Polynomial.C_mul_X_pow_eq_monomial]
    obtain ⟨d_star, hd_star⟩ := hQ
    have hH_dstar : (H.coeff (d_star 1)).coeff (d_star 0) = Q.coeff d_star := by
      have hQ_sum : H = ∑ v ∈ Q.support,
          Polynomial.monomial (v 1) (Polynomial.monomial (v 0) (Q.coeff v)) := by
        conv_lhs => rw [show H = Φ Q from rfl, MvPolynomial.as_sum Q, map_sum]
        refine Finset.sum_congr rfl fun v _ => ?_
        exact hΦ_mon v (Q.coeff v)
      rw [hQ_sum, Polynomial.finsetSum_coeff, Polynomial.finsetSum_coeff]
      rw [Finset.sum_eq_single d_star]
      · simp
      · intro v _ hv_ne
        by_cases hv1 : v 1 = d_star 1
        · have hv0 : v 0 ≠ d_star 0 := by
            intro hv0_eq
            apply hv_ne
            ext k
            fin_cases k
            · exact hv0_eq
            · exact hv1
          simp [Polynomial.coeff_monomial, hv1, hv0]
        · simp [Polynomial.coeff_monomial, hv1]
      · intro hnot_supp
        exfalso
        rw [MvPolynomial.mem_support_iff, not_not] at hnot_supp
        exact hd_star (hnot_supp ▸ P.zero_mem)
    have h_ex : ∃ j : ℕ, ∃ i : ℕ, (H.coeff j).coeff i ∉ P :=
      ⟨d_star 1, d_star 0, hH_dstar.symm ▸ hd_star⟩
    let j₀ : ℕ := Nat.find h_ex
    have hj₀_spec : F_poly.coeff j₀ ∉ q₂ := by
      rw [hF_coeff j₀]
      exact hb₁_tr (H.coeff j₀) (Nat.find_spec h_ex)
    have hj₀_low : ∀ j < j₀, F_poly.coeff j ∈ q₁ := by
      intro j hj
      have hmin := Nat.find_min h_ex hj
      rw [hF_coeff j, Polynomial.eval₂_eq_sum_range]
      refine q₁.sum_mem fun i _ => q₁.mul_mem_right (b₁ ^ i) ?_
      have hiP : (H.coeff j).coeff i ∈ P := by
        by_contra hi_not
        exact hmin ⟨i, hi_not⟩
      rw [← hq₁_P] at hiP
      exact hiP
    rw [hEvalEq]
    intro h_eval_mem
    let S_low : B := ∑ j ∈ Finset.range j₀, F_poly.coeff j * b₂ ^ j
    let S_high : B := ∑ k ∈ Finset.range F_poly.natDegree,
        F_poly.coeff (j₀ + (k + 1)) * b₂ ^ k
    have hDecomp : F_poly.eval b₂ = S_low + b₂ ^ j₀ * (F_poly.coeff j₀ + b₂ * S_high) := by
      have hdeg : F_poly.natDegree < j₀ + (F_poly.natDegree + 1) := by omega
      rw [Polynomial.eval_eq_sum_range' hdeg, Finset.sum_range_add, Finset.sum_range_succ']
      have hsum_eq : (∑ k ∈ Finset.range F_poly.natDegree,
            F_poly.coeff (j₀ + (k + 1)) * b₂ ^ (j₀ + (k + 1))) =
          b₂ ^ j₀ * (b₂ * S_high) := by
        rw [Finset.mul_sum, Finset.mul_sum]
        refine Finset.sum_congr rfl fun k _ => ?_
        rw [pow_add, pow_succ]
        ring
      rw [hsum_eq, Nat.add_zero]
      change S_low + (b₂ ^ j₀ * (b₂ * S_high) + F_poly.coeff j₀ * b₂ ^ j₀) = _
      ring
    have hSlow_mem : S_low ∈ q₁ :=
      q₁.sum_mem fun j hj => q₁.mul_mem_right (b₂ ^ j) (hj₀_low j (Finset.mem_range.mp hj))
    have hProd_mem : b₂ ^ j₀ * (F_poly.coeff j₀ + b₂ * S_high) ∈ q₁ := by
      have hsub := q₁.sub_mem h_eval_mem hSlow_mem
      rwa [hDecomp, add_sub_cancel_left] at hsub
    have hb₂_pow_not : b₂ ^ j₀ ∉ q₁ := fun hpow =>
      hb₂_not_q₁ (Ideal.IsPrime.mem_of_pow_mem ‹_› j₀ hpow)
    have hFactor_q₁ : F_poly.coeff j₀ + b₂ * S_high ∈ q₁ := by
      rcases (Ideal.IsPrime.mul_mem_iff_mem_or_mem ‹_›).mp hProd_mem with h1 | h2
      · exact False.elim (hb₂_pow_not h1)
      · exact h2
    have hFactor_q₂ : F_poly.coeff j₀ + b₂ * S_high ∈ q₂ := hq_le hFactor_q₁
    have hHigh_q₂ : b₂ * S_high ∈ q₂ := q₂.mul_mem_right S_high hb₂_q₂
    have hj₀_mem : F_poly.coeff j₀ ∈ q₂ := by
      have hsub := q₂.sub_mem hFactor_q₂ hHigh_q₂
      rwa [add_sub_cancel_right] at hsub
    exact hj₀_spec hj₀_mem
  · 
    intro P _ _ B _ γ hFT q_P _ hq_P t_coord ht_tr
    classical
    let R₀ := ↥V
    let D := B ⧸ q_P
    let π_q : B →+* D := Ideal.Quotient.mk q_P
    let γ_D : R₀ →+* D := π_q.comp γ
    have hγD_zero_iff : ∀ r : R₀, γ_D r = 0 ↔ r ∈ P := by
      intro r
      change Ideal.Quotient.mk q_P (γ r) = 0 ↔ r ∈ P
      rw [Ideal.Quotient.eq_zero_iff_mem, ← hq_P]
      rfl
    let S_P : Submonoid D := Submonoid.map γ_D P.primeCompl
    have hS_le : S_P ≤ nonZeroDivisors D := by
      intro y hy
      rcases Submonoid.mem_map.mp hy with ⟨s, hs, rfl⟩
      apply mem_nonZeroDivisors_of_ne_zero
      intro h0
      exact hs ((hγD_zero_iff s).mp h0)
    let C_fib := _root_.Localization S_P
    let ι_loc : D →+* C_fib := algebraMap D C_fib
    let ψ : B →+* C_fib := ι_loc.comp π_q
    have h_inj : Function.Injective ι_loc := IsLocalization.injective C_fib hS_le
    have : IsDomain C_fib := IsLocalization.isDomain_localization hS_le
    let f₀ : R₀ →+* C_fib := ι_loc.comp γ_D
    have hf₁ : P ≤ RingHom.ker f₀ := by
      intro r hr
      rw [RingHom.mem_ker]
      change ι_loc (γ_D r) = 0
      rw [(hγD_zero_iff r).mpr hr, map_zero]
    have hf₂ : ∀ s ∉ P, IsUnit (f₀ s) := by
      intro s hs
      have hs_mem : γ_D s ∈ S_P := ⟨s, hs, rfl⟩
      change IsUnit (ι_loc (γ_D s))
      exact IsLocalization.map_units C_fib (⟨γ_D s, hs_mem⟩ : S_P)
    let ι_K : P.ResidueField →+* C_fib := Ideal.ResidueField.lift P f₀ hf₁ hf₂
    have hιK_alg : ∀ r : R₀, ι_K (algebraMap R₀ P.ResidueField r) = f₀ r :=
      Ideal.ResidueField.lift_algebraMap P f₀ hf₁ hf₂
    let _ : Algebra P.ResidueField C_fib := ι_K.toAlgebra
    have hFT_fib : Algebra.FiniteType P.ResidueField C_fib := by
      let _ : Algebra R₀ B := γ.toAlgebra
      have : Algebra.FiniteType R₀ B := hFT
      obtain ⟨T, hT⟩ := ‹Algebra.FiniteType R₀ B›
      let T' : Finset C_fib := T.image ψ
      let A' : Subalgebra P.ResidueField C_fib :=
        Algebra.adjoin P.ResidueField (T' : Set C_fib)
      have hψ_mem : ∀ b : B, ψ b ∈ A' := by
        intro b
        have hb : b ∈ Algebra.adjoin R₀ (T : Set B) := by
          rw [hT]; trivial
        refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hb
        · intro x hx
          exact Algebra.subset_adjoin (Finset.mem_coe.mpr (Finset.mem_image_of_mem ψ hx))
        · intro r
          change f₀ r ∈ A'
          rw [← hιK_alg r]
          exact A'.algebraMap_mem (algebraMap R₀ P.ResidueField r)
        · intro x y _ _ hx hy
          rw [map_add]
          exact A'.add_mem hx hy
        · intro x y _ _ hx hy
          rw [map_mul]
          exact A'.mul_mem hx hy
      refine ⟨⟨T', eq_top_iff.mpr ?_⟩⟩
      intro z _
      obtain ⟨⟨d, y⟩, hzy⟩ := IsLocalization.surj S_P z
      rcases y with ⟨y_val, s, hs, rfl⟩
      obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective d
      change z * f₀ s = ψ b at hzy
      let s_bar : P.ResidueField := algebraMap R₀ P.ResidueField s
      have hs_bar_ne : s_bar ≠ 0 := by
        intro h0
        have hker : s ∈ RingHom.ker (algebraMap R₀ P.ResidueField) := h0
        rw [Ideal.ker_algebraMap_residueField P] at hker
        exact hs hker
      have hz_eq : z = ψ b * algebraMap P.ResidueField C_fib s_bar⁻¹ := by
        calc
          z = z * 1 := (mul_one z).symm
          _ = z * ι_K (s_bar * s_bar⁻¹) := by
            rw [mul_inv_cancel₀ hs_bar_ne, map_one]
          _ = (z * f₀ s) * ι_K s_bar⁻¹ := by
            rw [map_mul, hιK_alg s, mul_assoc]
          _ = ψ b * algebraMap P.ResidueField C_fib s_bar⁻¹ := by
            rw [hzy]; rfl
      rw [hz_eq]
      exact A'.mul_mem (hψ_mem b) (A'.algebraMap_mem s_bar⁻¹)
    obtain ⟨𝔪, h𝔪_max⟩ := Ideal.exists_maximal C_fib
    have hm_ne_bot : 𝔪 ≠ ⊥ := by
      intro hm_bot
      let L := C_fib ⧸ 𝔪
      let _ : Field L := Ideal.Quotient.field 𝔪
      have : Algebra.FiniteType P.ResidueField L :=
        Algebra.FiniteType.quotient P.ResidueField 𝔪
      have : Module.Finite P.ResidueField L :=
        finite_of_finite_type_of_isJacobsonRing P.ResidueField L
      have : Algebra.IsIntegral P.ResidueField L :=
        Algebra.IsIntegral.of_finite P.ResidueField L
      have hbij := IsAlgClosed.algebraMap_bijective_of_isIntegral
        (k := P.ResidueField) (K := L)
      obtain ⟨u, hu⟩ := hbij.2 (Ideal.Quotient.mk 𝔪 (ψ t_coord))
      have hu_mk : Ideal.Quotient.mk 𝔪 (ι_K u) = Ideal.Quotient.mk 𝔪 (ψ t_coord) := hu
      have hu_eq : ι_K u = ψ t_coord := by
        have hsub : ι_K u - ψ t_coord ∈ 𝔪 := Ideal.Quotient.eq.mp hu_mk
        rw [hm_bot, Submodule.mem_bot] at hsub
        exact sub_eq_zero.mp hsub
      obtain ⟨x, rfl⟩ := IsLocalRing.residue_surjective u
      obtain ⟨⟨c, s⟩, hxs⟩ := IsLocalization.surj P.primeCompl x
      have hres_eq : IsLocalRing.residue (_root_.Localization.AtPrime P) x *
          algebraMap R₀ P.ResidueField s.1 = algebraMap R₀ P.ResidueField c := by
        have h1 := congrArg (IsLocalRing.residue (_root_.Localization.AtPrime P)) hxs
        rw [map_mul] at h1
        exact h1
      have hfib_eq : ι_loc (π_q (γ s.1 * t_coord)) = ι_loc (π_q (γ c)) := by
        calc
          ι_loc (π_q (γ s.1 * t_coord)) = ψ t_coord * f₀ s.1 := by
            change ι_loc (π_q (γ s.1) * π_q t_coord) = ι_loc (π_q t_coord) * ι_loc (π_q (γ s.1))
            rw [map_mul, mul_comm]
          _ = ι_K (IsLocalRing.residue (_root_.Localization.AtPrime P) x *
                algebraMap R₀ P.ResidueField s.1) := by
            rw [map_mul, hu_eq, hιK_alg s.1]
          _ = ι_K (algebraMap R₀ P.ResidueField c) := by
            rw [hres_eq]
          _ = ι_loc (π_q (γ c)) := hιK_alg c
      have hquot_eq : π_q (γ s.1 * t_coord) = π_q (γ c) := h_inj hfib_eq
      have hmem_qP : γ s.1 * t_coord - γ c ∈ q_P := Ideal.Quotient.eq.mp hquot_eq
      let g : Polynomial R₀ := Polynomial.C s.1 * Polynomial.X - Polynomial.C c
      have hg_coeff : g.coeff 1 ∉ P := by
        have hc1 : g.coeff 1 = s.1 := by
          simp [g, Polynomial.coeff_C]
        rw [hc1]
        exact s.2
      have hg_eval : Polynomial.eval₂ γ t_coord g ∈ q_P := by
        have hev : Polynomial.eval₂ γ t_coord g = γ s.1 * t_coord - γ c := by
          simp [g]
        rwa [hev]
      exact ht_tr g ⟨1, hg_coeff⟩ hg_eval
    have : 𝔪.IsPrime := h𝔪_max.isPrime
    let q₁ : Ideal B := Ideal.comap ψ 𝔪
    have hq₁_prime : q₁.IsPrime := Ideal.IsPrime.comap ψ
    have hqP_le_q₁ : q_P ≤ q₁ := by
      intro b hb
      change ι_loc (π_q b) ∈ 𝔪
      rw [Ideal.Quotient.eq_zero_iff_mem.mpr hb, map_zero]
      exact 𝔪.zero_mem
    have hq₁_ne_qP : q₁ ≠ q_P := by
      intro hq_eq
      obtain ⟨z, hz_mem, hz_ne⟩ := (Submodule.ne_bot_iff 𝔪).mp hm_ne_bot
      obtain ⟨⟨d, y⟩, hzy⟩ := IsLocalization.surj S_P z
      obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective d
      have hψb_mem : ψ b ∈ 𝔪 := by
        change ι_loc (π_q b) ∈ 𝔪
        rw [← hzy]
        exact 𝔪.mul_mem_right (ι_loc y.1) hz_mem
      have hb_q₁ : b ∈ q₁ := hψb_mem
      rw [hq_eq] at hb_q₁
      have hψb_zero : ψ b = 0 := by
        change ι_loc (π_q b) = 0
        rw [Ideal.Quotient.eq_zero_iff_mem.mpr hb_q₁, map_zero]
      have hprod_zero : z * ι_loc y.1 = 0 := hzy.trans hψb_zero
      have hy_unit : IsUnit (ι_loc y.1) := IsLocalization.map_units C_fib y
      rcases mul_eq_zero.mp hprod_zero with hz0 | hy0
      · exact hz_ne hz0
      · exact hy_unit.ne_zero hy0
    have hq₁_comap : Ideal.comap γ q₁ = P := by
      apply le_antisymm
      · intro r hr
        by_contra hr_not_P
        have hr_mem_S : γ_D r ∈ S_P := ⟨r, hr_not_P, rfl⟩
        have hr_unit : IsUnit (ι_loc (γ_D r)) :=
          IsLocalization.map_units C_fib (⟨γ_D r, hr_mem_S⟩ : S_P)
        have hr_mem : ι_loc (γ_D r) ∈ 𝔪 := hr
        exact h𝔪_max.ne_top (Ideal.eq_top_of_isUnit_mem 𝔪 hr_mem hr_unit)
      · rw [← hq_P]
        exact Ideal.comap_mono hqP_le_q₁
    exact ⟨q₁, hq₁_prime, hqP_le_q₁, hq₁_ne_qP, hq₁_comap⟩

theorem weil_residueField_fiber_pullback_components_assembly (R₀ : Type u) [CommRing R₀]
    (P : Ideal R₀) [P.IsPrime]
    (X Y P_tilde : AlgebraicGeometry.Scheme.{u})
    (g_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of R₀))
    (g_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of R₀))
    (π₁ : P_tilde ⟶ X)
    (π₂ : P_tilde ⟶ Y)
    (hProp_π₂ : AlgebraicGeometry.IsProper π₂)
    (hπ_g : π₁ ≫ g_X = π₂ ≫ g_Y)
    (x₀ : X)
    (hClosed_x₀ : IsClosed ({x₀} : Set X))
    (z_P : P_tilde)
    (hz_x₀ : π₁.base z_P = x₀)
    (hz_P : ((π₁ ≫ g_X).base z_P).asIdeal = P)
    (y₁_base : Y)
    (hy₁_ne : y₁_base ≠ π₂.base z_P)
    (hy₁_cl : y₁_base ∈ closure ({π₂.base z_P} : Set Y))
    (hy₁_P : (g_Y.base y₁_base).asIdeal = P)
    (hMax_zP : ∀ z' : P_tilde,
      ((π₁ ≫ g_X).base z').asIdeal = P →
      z_P ∈ closure ({z'} : Set P_tilde) →
      z' = z_P)
    (hMax_yP : ∀ y' : Y,
      (g_Y.base y').asIdeal = P →
      π₂.base z_P ∈ closure ({y'} : Set Y) →
      y' = π₂.base z_P) :
    ∃ (E_tilde : Set ↥(CategoryTheory.Limits.pullback (π₁ ≫ g_X)
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ P.ResidueField)))))
      (F_target : Set ↥(CategoryTheory.Limits.pullback g_Y
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ P.ResidueField))))),
      E_tilde ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback (π₁ ≫ g_X)
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ P.ResidueField)))) ∧
      F_target ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_Y
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ P.ResidueField)))) ∧
      (∃ y₁ y₂, y₁ ≠ y₂ ∧ y₁ ∈ F_target ∧ y₂ ∈ F_target) ∧
      (∀ w ∈ E_tilde,
        π₁.base ((CategoryTheory.Limits.pullback.fst (π₁ ≫ g_X)
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ P.ResidueField)))).base w) = x₀) ∧
      (∀ (π₂_P : CategoryTheory.Limits.pullback (π₁ ≫ g_X)
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ P.ResidueField))) ⟶
          CategoryTheory.Limits.pullback g_Y
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ P.ResidueField)))),
        π₂_P ≫ CategoryTheory.Limits.pullback.fst g_Y
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ P.ResidueField))) =
          CategoryTheory.Limits.pullback.fst (π₁ ≫ g_X)
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ P.ResidueField))) ≫ π₂ →
        π₂_P ≫ CategoryTheory.Limits.pullback.snd g_Y
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ P.ResidueField))) =
          CategoryTheory.Limits.pullback.snd (π₁ ≫ g_X)
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ P.ResidueField))) →
        π₂_P.base '' E_tilde = F_target) :=
by
  let s_P : AlgebraicGeometry.Spec (CommRingCat.of P.ResidueField) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of R₀) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ P.ResidueField))
  have hPre_loc : AlgebraicGeometry.IsPreimmersion
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (Localization.AtPrime P)))) :=
    AlgebraicGeometry.IsPreimmersion.of_isLocalization (M := P.primeCompl)
  have hClosed_res : AlgebraicGeometry.IsClosedImmersion
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue (Localization.AtPrime P)))) :=
    AlgebraicGeometry.IsClosedImmersion.spec_of_surjective
      (CommRingCat.ofHom (IsLocalRing.residue (Localization.AtPrime P)))
      IsLocalRing.residue_surjective
  have h_sP_fac : s_P =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue (Localization.AtPrime P))) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (Localization.AtPrime P))) := by
    rw [← AlgebraicGeometry.Spec.map_comp]
    rfl
  have : AlgebraicGeometry.IsPreimmersion s_P := by
    rw [h_sP_fac]
    infer_instance
  let F_P := CategoryTheory.Limits.pullback (π₁ ≫ g_X) s_P
  let F_Y := CategoryTheory.Limits.pullback g_Y s_P
  let fst_P := CategoryTheory.Limits.pullback.fst (π₁ ≫ g_X) s_P
  let snd_P := CategoryTheory.Limits.pullback.snd (π₁ ≫ g_X) s_P
  let fst_Y := CategoryTheory.Limits.pullback.fst g_Y s_P
  let snd_Y := CategoryTheory.Limits.pullback.snd g_Y s_P
  have hEmb_P : Topology.IsEmbedding fst_P.base := fst_P.isEmbedding
  have hEmb_Y : Topology.IsEmbedding fst_Y.base := fst_Y.isEmbedding
  have hsP_asIdeal : ∀ u : ↥(AlgebraicGeometry.Spec (CommRingCat.of P.ResidueField)),
      (s_P.base u).asIdeal = P := by
    intro u
    have h1 : s_P.base u = PrimeSpectrum.comap (algebraMap R₀ P.ResidueField) u :=
      AlgebraicGeometry.Spec.map_apply (CommRingCat.ofHom (algebraMap R₀ P.ResidueField)) u
    rw [h1]
    change Ideal.comap (algebraMap R₀ P.ResidueField) u.asIdeal = P
    have : u.asIdeal.IsPrime := u.isPrime
    have hu_bot : u.asIdeal = ⊥ := Ideal.eq_bot_of_prime u.asIdeal
    rw [hu_bot]
    exact Ideal.ker_algebraMap_residueField P
  have hsP_range : Set.range s_P.base =
      {q : ↥(AlgebraicGeometry.Spec (CommRingCat.of R₀)) | q.asIdeal = P} := by
    ext q
    constructor
    · rintro ⟨u, rfl⟩
      exact hsP_asIdeal u
    · intro hq
      let u₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of P.ResidueField)) :=
        (default : PrimeSpectrum P.ResidueField)
      refine ⟨u₀, PrimeSpectrum.ext ?_⟩
      rw [hsP_asIdeal u₀]
      exact hq.symm
  have hRange_fst : ∀ {Z : AlgebraicGeometry.Scheme.{u}}
      (g : Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of R₀)) (z : Z),
      z ∈ Set.range (CategoryTheory.Limits.pullback.fst g s_P).base ↔ (g.base z).asIdeal = P := by
    intro Z g z
    have hr : Set.range (CategoryTheory.Limits.pullback.fst g s_P).base =
        g.base ⁻¹' Set.range s_P.base :=
      AlgebraicGeometry.Scheme.Pullback.range_fst g s_P
    rw [hr, hsP_range]
    rfl
  let π₂_P_star : F_P ⟶ F_Y :=
    CategoryTheory.Limits.pullback.lift (fst_P ≫ π₂) snd_P
      (by rw [CategoryTheory.Category.assoc, ← hπ_g, CategoryTheory.Limits.pullback.condition])
  have hπ₂_fst : π₂_P_star ≫ fst_Y = fst_P ≫ π₂ :=
    CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hπ₂_snd : π₂_P_star ≫ snd_Y = snd_P :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hPb_star : CategoryTheory.IsPullback fst_P π₂_P_star π₂ fst_Y := by
    refine (CategoryTheory.IsPullback.paste_vert_iff
      (CategoryTheory.IsPullback.of_hasPullback g_Y s_P) hπ₂_fst.symm).mp ?_
    rw [hπ₂_snd, ← hπ_g]
    exact CategoryTheory.IsPullback.of_hasPullback (π₁ ≫ g_X) s_P
  have : AlgebraicGeometry.IsProper π₂_P_star :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (P := @AlgebraicGeometry.IsProper) hPb_star hProp_π₂
  obtain ⟨w_P, hw_P⟩ := (hRange_fst (π₁ ≫ g_X) z_P).mpr hz_P
  let E_tilde : Set ↥F_P := irreducibleComponent w_P
  have hE_comp : E_tilde ∈ irreducibleComponents ↥F_P :=
    irreducibleComponent_mem_irreducibleComponents w_P
  obtain ⟨η_E, hGen_E⟩ :=
    QuasiSober.sober (isIrreducible_irreducibleComponent (x := w_P))
      (isClosed_irreducibleComponent (x := w_P))
  have h_wP_cl : w_P ∈ closure ({η_E} : Set ↥F_P) := by
    rw [hGen_E.def]
    exact mem_irreducibleComponent
  have hzP_cl_η : z_P ∈ closure ({fst_P.base η_E} : Set P_tilde) := by
    have him : fst_P.base w_P ∈ fst_P.base '' closure ({η_E} : Set ↥F_P) := ⟨w_P, h_wP_cl, rfl⟩
    have hsub := image_closure_subset_closure_image fst_P.continuous (s := ({η_E} : Set ↥F_P))
    rw [Set.image_singleton] at hsub
    rw [← hw_P]
    exact hsub him
  have hηE_P : ((π₁ ≫ g_X).base (fst_P.base η_E)).asIdeal = P :=
    (hRange_fst (π₁ ≫ g_X) (fst_P.base η_E)).mp ⟨η_E, rfl⟩
  have hηE_eq_wP : η_E = w_P := by
    apply hEmb_P.injective
    rw [hw_P]
    exact hMax_zP (fst_P.base η_E) hηE_P hzP_cl_η
  have hE_eq : E_tilde = closure ({w_P} : Set ↥F_P) := by
    dsimp only [E_tilde]
    rw [← hGen_E.def, hηE_eq_wP]
  have hE_x₀ : ∀ w ∈ E_tilde, π₁.base (fst_P.base w) = x₀ := by
    have hCl_pre : IsClosed ((fst_P ≫ π₁).base ⁻¹' ({x₀} : Set X)) :=
      hClosed_x₀.preimage (fst_P ≫ π₁).continuous
    have hwP_pre : w_P ∈ (fst_P ≫ π₁).base ⁻¹' ({x₀} : Set X) := by
      change π₁.base (fst_P.base w_P) = x₀
      rw [hw_P, hz_x₀]
    have hsub : E_tilde ⊆ (fst_P ≫ π₁).base ⁻¹' ({x₀} : Set X) := by
      rw [hE_eq]
      exact closure_minimal (Set.singleton_subset_iff.mpr hwP_pre) hCl_pre
    intro w hw
    exact hsub hw
  let F_target : Set ↥F_Y := π₂_P_star.base '' E_tilde
  let y₂ : ↥F_Y := π₂_P_star.base w_P
  have hy₂_fst : fst_Y.base y₂ = π₂.base z_P := by
    change (π₂_P_star ≫ fst_Y).base w_P = π₂.base z_P
    rw [hπ₂_fst]
    change π₂.base (fst_P.base w_P) = π₂.base z_P
    rw [hw_P]
  have hy₂_mem : y₂ ∈ F_target := ⟨w_P, mem_irreducibleComponent, rfl⟩
  have hF_closed : IsClosed F_target :=
    π₂_P_star.isClosedMap E_tilde isClosed_irreducibleComponent
  have hF_eq : F_target = closure ({y₂} : Set ↥F_Y) := by
    apply Set.Subset.antisymm
    · dsimp only [F_target, y₂]
      rw [hE_eq]
      have hsub := image_closure_subset_closure_image π₂_P_star.continuous (s := ({w_P} : Set ↥F_P))
      rwa [Set.image_singleton] at hsub
    · exact closure_minimal (Set.singleton_subset_iff.mpr hy₂_mem) hF_closed
  have hF_irred : IsIrreducible F_target := by
    rw [hF_eq]
    exact isIrreducible_singleton.closure
  have hF_comp : F_target ∈ irreducibleComponents ↥F_Y := by
    rw [irreducibleComponents_eq_maximals_closed]
    refine ⟨⟨hF_closed, hF_irred⟩, ?_⟩
    intro F' hF' hSub
    obtain ⟨η_F, hGen_F⟩ := QuasiSober.sober hF'.2 hF'.1
    have hy₂_cl_η : y₂ ∈ closure ({η_F} : Set ↥F_Y) := by
      rw [hGen_F.def]
      exact hSub hy₂_mem
    have hyP_cl_η : π₂.base z_P ∈ closure ({fst_Y.base η_F} : Set Y) := by
      have him : fst_Y.base y₂ ∈ fst_Y.base '' closure ({η_F} : Set ↥F_Y) := ⟨y₂, hy₂_cl_η, rfl⟩
      have hsub := image_closure_subset_closure_image fst_Y.continuous (s := ({η_F} : Set ↥F_Y))
      rw [Set.image_singleton] at hsub
      rw [← hy₂_fst]
      exact hsub him
    have hηF_P : (g_Y.base (fst_Y.base η_F)).asIdeal = P :=
      (hRange_fst g_Y (fst_Y.base η_F)).mp ⟨η_F, rfl⟩
    have hηF_eq_y₂ : η_F = y₂ := by
      apply hEmb_Y.injective
      rw [hy₂_fst]
      exact hMax_yP (fst_Y.base η_F) hηF_P hyP_cl_η
    have hEq : F' = F_target := by
      rw [← hGen_F.def, hηF_eq_y₂, hF_eq]
    exact hEq.le
  obtain ⟨y₁, hy₁_fst⟩ := (hRange_fst g_Y y₁_base).mpr hy₁_P
  have hy₁₂_ne : y₁ ≠ y₂ := by
    intro heq
    apply hy₁_ne
    rw [← hy₁_fst, heq, hy₂_fst]
  have hy₁_mem : y₁ ∈ F_target := by
    rw [hF_eq, hEmb_Y.closure_eq_preimage_closure_image ({y₂} : Set ↥F_Y),
      Set.image_singleton, hy₂_fst]
    change fst_Y.base y₁ ∈ closure ({π₂.base z_P} : Set Y)
    rwa [hy₁_fst]
  refine ⟨E_tilde, F_target, hE_comp, hF_comp, ⟨y₁, y₂, hy₁₂_ne, hy₁_mem, hy₂_mem⟩, hE_x₀, ?_⟩
  intro π₂_P h₁ h₂
  have hπ_eq : π₂_P = π₂_P_star :=
    CategoryTheory.Limits.pullback.hom_ext (h₁.trans hπ₂_fst.symm) (h₂.trans hπ₂_snd.symm)
  rw [hπ_eq]

theorem weil_strictlySemistable_closedPoint_contracted_component_specialization (K : Type u) [Field K]
    (m : ℕ) (V : ValuationSubring K) (hPkg : IsValuationRingAlgPackage m V)
    (hNodalNorm : ∀ (K₀ : Type u) [Field K₀] (V₀ : ValuationSubring K₀) (a₀ : ↥V₀),
      a₀ ≠ 0 →
      IsDomain (MvPolynomial (Fin 2) ↥V₀ ⧸ Ideal.span
        {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a₀}) ∧
      IsIntegrallyClosed (MvPolynomial (Fin 2) ↥V₀ ⧸ Ideal.span
        {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a₀}))
    (F : Type u) [Field F]
    (φ_KF : K →+* F)
    (hTwoVar : ∀ (W : ValuationSubring F)
        (hV : ∀ c : ↥V, φ_KF (V.subtype c) ∈ W)
        (P : Ideal ↥V) [P.IsPrime],
      (∀ c : ↥V,
        ((⟨φ_KF (V.subtype c), hV c⟩ : ↥W) ∈ IsLocalRing.maximalIdeal ↥W ↔ c ∈ P)) →
      ¬ ∃ (t₁ t₂ : ↥W),
        ∀ (Q : MvPolynomial (Fin 2) ↥V),
          (∃ d : Fin 2 →₀ ℕ, Q.coeff d ∉ P) →
          MvPolynomial.eval₂ ((φ_KF.comp V.subtype).codRestrict W.toSubring hV) ![t₁, t₂] Q ∉
            IsLocalRing.maximalIdeal ↥W)
    (X Y P_tilde : AlgebraicGeometry.Scheme.{u})
    (g_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (g_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (π₁ : P_tilde ⟶ X)
    (π₂ : P_tilde ⟶ Y)
    (η_P : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ P_tilde)
    (η_Y : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ Y)
    (hSS_X : IsStrictlySemistableCurveOverValuation V g_X)
    (hSS_Y : IsStrictlySemistableCurveOverValuation V g_Y)
    (hNoeth_X : TopologicalSpace.NoetherianSpace ↥X)
    (hNoeth_Y : TopologicalSpace.NoetherianSpace ↥Y)
    (hNoeth_P : TopologicalSpace.NoetherianSpace ↥P_tilde)
    (hInt_P : AlgebraicGeometry.IsIntegral P_tilde)
    (hProp_π₁ : AlgebraicGeometry.IsProper π₁)
    (hProp_π₂ : AlgebraicGeometry.IsProper π₂)
    (hπ_g : π₁ ≫ g_X = π₂ ≫ g_Y)
    (hηP_Y : η_P ≫ π₂ = η_Y)
    (hFunc_P : IsSchemeFunctionField P_tilde F η_P)
    (hFunc_Y : IsSchemeFunctionField Y F η_Y)
    (hφ_V : ∀ c : ↥V,
      φ_KF (V.subtype c) = (AlgebraicGeometry.Spec.preimage (η_P ≫ π₁ ≫ g_X)).hom c)
    (Q : Ideal ↥V) [Q.IsPrime]
    (hQ_ne : Q ≠ ⊥)
    (U_X : X.Opens) (hUX : AlgebraicGeometry.IsAffineOpen U_X)
    (U_Y : Y.Opens) (hUY : AlgebraicGeometry.IsAffineOpen U_Y)
    (V_P : P_tilde.Opens) (hVP : AlgebraicGeometry.IsAffineOpen V_P)
    (e_X : V_P ≤ (TopologicalSpace.Opens.map π₁.base).obj U_X)
    (e_Y : V_P ≤ (TopologicalSpace.Opens.map π₂.base).obj U_Y)
    (φ_P : P_tilde.presheaf.obj (Opposite.op V_P) ⟶ CommRingCat.of F)
    (hφ_P : AlgebraicGeometry.Spec.map φ_P ≫ hVP.fromSpec = η_P)
    (p : Ideal ↑(X.presheaf.obj (Opposite.op U_X))) [p.IsPrime]
    (hp_comap : Ideal.comap (AlgebraicGeometry.Spec.preimage (hUX.fromSpec ≫ g_X)).hom p = Q)
    (W : ValuationSubring F)
    (hV : ∀ c : ↥V, φ_KF (V.subtype c) ∈ W)
    (ρ_P : ↑(P_tilde.presheaf.obj (Opposite.op V_P)) →+* ↥W)
    (c_star : ↑(Y.presheaf.obj (Opposite.op U_Y)))
    (hρ_sub : W.subtype.comp ρ_P = φ_P.hom)
    (hρ_comap : Ideal.comap (ρ_P.comp (π₁.appLE U_X V_P e_X).hom) (IsLocalRing.maximalIdeal ↥W) = p)
    (hTransY : ∀ P_poly : Polynomial ↥V,
      (∃ i : ℕ, P_poly.coeff i ∉ Q) →
      Polynomial.eval₂ ((φ_KF.comp V.subtype).codRestrict W.toSubring hV)
        (ρ_P ((π₂.appLE U_Y V_P e_Y).hom c_star)) P_poly ∉ IsLocalRing.maximalIdeal ↥W)
    (hLinX : ∀ (d r : ↑(X.presheaf.obj (Opposite.op U_X))), r ∉ p →
      ∃ (c₀ s₀ : ↥V), s₀ ∉ Q ∧
        (AlgebraicGeometry.Spec.preimage (hUX.fromSpec ≫ g_X)).hom s₀ * d -
          (AlgebraicGeometry.Spec.preimage (hUX.fromSpec ≫ g_X)).hom c₀ * r ∈ p) :
    ∃ (P : Ideal ↥V) (_ : P.IsPrime) (_ : P ≠ ⊥)
      (x₀ : X)
      (E_tilde : Set ↥(CategoryTheory.Limits.pullback (π₁ ≫ g_X)
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V P.ResidueField)))))
      (F_target : Set ↥(CategoryTheory.Limits.pullback g_Y
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V P.ResidueField))))),
      IsClosed ({x₀} : Set X) ∧
      (g_X.base x₀).asIdeal = P ∧
      E_tilde ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback (π₁ ≫ g_X)
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V P.ResidueField)))) ∧
      F_target ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_Y
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V P.ResidueField)))) ∧
      (∃ y₁ y₂, y₁ ≠ y₂ ∧ y₁ ∈ F_target ∧ y₂ ∈ F_target) ∧
      (∀ w ∈ E_tilde,
        π₁.base ((CategoryTheory.Limits.pullback.fst (π₁ ≫ g_X)
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V P.ResidueField)))).base w) = x₀) ∧
      (∀ (π₂_P : CategoryTheory.Limits.pullback (π₁ ≫ g_X)
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V P.ResidueField))) ⟶
          CategoryTheory.Limits.pullback g_Y
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V P.ResidueField)))),
        π₂_P ≫ CategoryTheory.Limits.pullback.fst g_Y
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V P.ResidueField))) =
          CategoryTheory.Limits.pullback.fst (π₁ ≫ g_X)
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V P.ResidueField))) ≫ π₂ →
