  have hIsoOfModel : ∀ (M_1 : AlgebraicGeometry.Scheme.{u})
      (g_M1 : M_1 ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
      (f_M1 : M_1 ⟶ M_0)
      (η_M1 : AlgebraicGeometry.Spec (CommRingCat.of F_0) ⟶ M_1)
      (Z_M1 : Set ↥M_0)
      (B_1 : Fin N → Set ↥(CategoryTheory.Limits.pullback g_M1 s_R)),
      IsBaseDiscTreeModel R a_opt g_M0 m_0 η_M0 φ_KF0 T_0 c π
