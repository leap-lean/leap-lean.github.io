        rw [hlhs, hu_Q, ← RingHom.ker_eq_comap_bot, Ideal.mk_ker]
      have hq_bot : q = q_bot := PrimeSpectrum.ext
        (Ideal.comap_injective_of_surjective _ Ideal.Quotient.mk_surjective hcomap_eq)
      rw [hq_bot, hσ_bot]
    · let m_R := IsLocalRing.maximalIdeal ↥R
