    exact (hy_uniq (ι_U.base p_nod) ⟨hp_nod_ip, hp_nod_ic⟩).trans (hy_uniq y ⟨hy_ip, hy_ic⟩).symm
  have hHasse_or_of_inter : ∀ {i j : Fin (N' + 1)}, i ≠ j →
      ∀ {y : ↥M_tilde}, y ∈ B_set i → y ∈ B_set j →
