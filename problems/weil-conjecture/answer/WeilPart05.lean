    · exact (hSucc_lift i').2.2 (hBd_B' i' hi_bd)
  
  have hEdge_pin : ∀ (i_p i_c : Fin (N' + 1)), IsDiscHasseCover ↥R c π i_p i_c →
      ∃ (c' : ↥R), c' ≠ 0 ∧ c' ∈ m_R ∧
        ∃ (h : weilNodalQuot ↥R c')
          (ι_U : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away h)) ⟶ M_tilde)
          (p_nod : PrimeSpectrum (Localization.Away h)),
          AlgebraicGeometry.IsOpenImmersion ι_U ∧
          ι_U ≫ g_tilde = AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((Ideal.Quotient.mk (weilNodalIdeal ↥R c')).comp MvPolynomial.C) ≫
              CommRingCat.ofHom (algebraMap (weilNodalQuot ↥R c') (Localization.Away h))) ∧
          (g_tilde.base (ι_U.base p_nod)).asIdeal = m_R ∧
          (∀ b : Fin 2, algebraMap (weilNodalQuot ↥R c') (Localization.Away h)
            (Ideal.Quotient.mk (weilNodalIdeal ↥R c') (MvPolynomial.X b)) ∈ p_nod.asIdeal) ∧
          (∀ y : ↥M_tilde, y ∈ B_set i_p → y ∈ B_set i_c → ι_U.base p_nod = y) ∧
          (∀ (p : PrimeSpectrum (Localization.Away h)) (k : Fin (N' + 1)),
            (g_tilde.base (ι_U.base p)).asIdeal = m_R →
            (ι_U.base p ∈ B_set k ↔
              (k = i_p ∧ algebraMap (weilNodalQuot ↥R c') (Localization.Away h)
