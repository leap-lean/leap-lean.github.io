    have hAlg_AU_F : (algebraMap A_U F : A_U →+* F) = φ_U.hom := rfl
    have hAlg_AU_Bg : (algebraMap A_U B_g : A_U →+* B_g) = res_g.hom := by
      unfold AlgebraicGeometry.Scheme.algebra_section_section_basicOpen
      rfl
    have _ : IsLocalization.Away g B_g := hU.isLocalization_basicOpen g
    refine
      { map_units := fun y => ?_
        surj := fun x => ?_
        exists_of_eq := fun {a₁ a₂} ha => ?_ }
    · rw [hAlg_AU_F]
      have hy0 : y.1 ≠ 0 := nonZeroDivisors.ne_zero y.2
