  have h_s3 : ∀ (X W : AlgebraicGeometry.Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral X)
      (F : Type u) [Field F] (f : X ⟶ W)
      (η_X : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ X)
      (η_W : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ W)
