    clear * -
    intro K _ C_K p_K hIntCK x₀_K U_base hUb V_K hVK hx₀_VK e_VK hStd F _ φ_VK hFracBK φ_KF hφ_pK
    let _ : Algebra K F := φ_KF.toAlgebra
    let B_K : Type u := ↑(C_K.presheaf.obj (Opposite.op V_K))
    have : IsDomain B_K :=
      @AlgebraicGeometry.IsIntegral.component_integral C_K hIntCK V_K ⟨⟨x₀_K, hx₀_VK⟩⟩
    let _ : Algebra B_K F := φ_VK.hom.toAlgebra
    have : IsFractionRing B_K F := hFracBK
    have hUb_top : hUb.fromSpec.opensRange = ⊤ := by
      ext pt
      simp only [TopologicalSpace.Opens.coe_top, Set.mem_univ, iff_true]
      have hpt : pt = p_K.base x₀_K := Subsingleton.elim pt (p_K.base x₀_K)
      rw [hpt]
      change p_K.base x₀_K ∈ Set.range hUb.fromSpec.base
      rw [AlgebraicGeometry.IsAffineOpen.range_fromSpec]
      exact e_VK hx₀_VK
    have : CategoryTheory.IsIso hUb.fromSpec :=
      AlgebraicGeometry.isIso_of_isOpenImmersion_of_opensRange_eq_top hUb.fromSpec hUb_top
    let R_0_obj := (AlgebraicGeometry.Spec (CommRingCat.of K)).presheaf.obj (Opposite.op U_base)
    let R_0 : Type u := ↑R_0_obj
    let e_K : CommRingCat.of K ⟶ R_0_obj :=
      AlgebraicGeometry.Spec.preimage hUb.fromSpec
    let e_K_inv : R_0_obj ⟶ CommRingCat.of K :=
      AlgebraicGeometry.Spec.preimage (CategoryTheory.inv hUb.fromSpec)
    have heK_id1 : e_K ≫ e_K_inv = 𝟙 (CommRingCat.of K) := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        AlgebraicGeometry.Spec.map_preimage, CategoryTheory.IsIso.inv_hom_id,
        AlgebraicGeometry.Spec.map_id]
    have heK_id2 : e_K_inv ≫ e_K = 𝟙 R_0_obj := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        AlgebraicGeometry.Spec.map_preimage, CategoryTheory.IsIso.hom_inv_id,
        AlgebraicGeometry.Spec.map_id]
    let eK_equiv : K ≃+* R_0 :=
      (CategoryTheory.Iso.mk e_K e_K_inv heK_id1 heK_id2).commRingCatIsoToRingEquiv
    obtain ⟨g₀, hg₀_C, hg₀_et⟩ := hStd.exists_etale_mvPolynomial
    let e_mv : MvPolynomial (Fin 1) K →+* MvPolynomial (Fin 1) R_0 :=
