      intro P hP
      obtain ⟨i₀, hi₀, hdiv⟩ := finset_min_dvd P.support (Polynomial.support_nonempty.mpr hP) P.coeff
      let a : ↥R := P.coeff i₀
      have ha_ne : a ≠ 0 := Polynomial.mem_support_iff.mp hi₀
      have hcoeff_ex : ∀ i : ℕ, ∃ c : ↥R, P.coeff i = c * a := by
        intro i
        by_cases hi : i ∈ P.support
        · exact hdiv i hi
        · rw [Polynomial.notMem_support_iff.mp hi]
