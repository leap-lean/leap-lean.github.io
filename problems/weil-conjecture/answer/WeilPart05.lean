    · have hcF : c ∈ F_contr := by
        by_contra hnot
        exact hcU hnot
      obtain ⟨q_c, hqc_Z, hqc_r⟩ := hMarkSpec j b hcF
      have hLeaf_eq :
          {q ∈ Z | ∃ E' ∈ irreducibleComponents ↥Y_P, E' ≠ Z ∧ q ∈ E'}.ncard = 1 := by
        let k_Δ : ℕ := {q ∈ Z | ∃ E' ∈ irreducibleComponents ↥Y_P, E' ≠ Z ∧ q ∈ E'}.ncard
        have hlo_YP : 1 ≤ k_Δ := hΔ_lo
        have hhi_YP : k_Δ ≤ 2 := hΔ_hi
        have hnot2 : k_Δ ≠ 2 := fun h2 => hΔ_two h2 j q_c hqc_Z hqc_r
        change k_Δ = 1
        omega
      have hz_mod : (τ_next j).base b ∈ ι_1.base '' Mod_q0 := by
        have hcF' : c ∈ X_0.ι.base '' (q_0.base ⁻¹' Mod_q0) := hcF
        dsimp only [X_0] at hcF'
        rw [← hq_pre] at hcF'
        exact hcF'
      rcases hz_mod with ⟨x', hx'_mod, hx'_eq⟩
      obtain ⟨V'_sm, hx'_V, hSm_V'⟩ := hLeafSm hLeaf_eq x' hx'_mod
      let V_next : C_next.Opens := ι_1.opensFunctor.obj V'_sm
      have hz_Vnext : (τ_next j).base b ∈ V_next := by
        rw [← hx'_eq]
        exact ⟨x', hx'_V, rfl⟩
      have hRange_V' : Set.range ⇑(V'_sm.ι ≫ ι_1) = Set.range ⇑V_next.ι := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        refine Set.Subset.antisymm ?_ ?_
        · rintro _ ⟨w, rfl⟩
          exact ⟨V'_sm.ι.base w, w.2, rfl⟩
        · rintro _ ⟨w', hw', rfl⟩
          exact ⟨⟨w', hw'⟩, rfl⟩
      let α'_V : V'_sm.toScheme ≅ V_next.toScheme :=
        AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq (V'_sm.ι ≫ ι_1) V_next.ι hRange_V'
      have hComp_sm' : V_next.ι ≫ g_next =
          (α'_V.inv ≫ (V'_sm.ι ≫ g'_0)) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_VP) := by
        calc
          V_next.ι ≫ g_next = (α'_V.inv ≫ (V'_sm.ι ≫ ι_1)) ≫ g_next := by
            rw [AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_inv_fac]
          _ = α'_V.inv ≫ V'_sm.ι ≫ (ι_1 ≫ g_next) := by simp only [Category.assoc]
          _ = (α'_V.inv ≫ (V'_sm.ι ≫ g'_0)) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_VP) := by
            rw [hComm_1]; simp only [Category.assoc]
      have : AlgebraicGeometry.SmoothOfRelativeDimension 1 (α'_V.inv ≫ (V'_sm.ι ≫ g'_0)) := by
        simpa only [Nat.zero_add] using
          (inferInstance : AlgebraicGeometry.SmoothOfRelativeDimension (0 + 1)
            (α'_V.inv ≫ (V'_sm.ι ≫ g'_0)))
      have : AlgebraicGeometry.IsOpenImmersion
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_VP)) := hOpen_VP
      have hSm_comp' : AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_next.ι ≫ g_next) := by
        rw [hComp_sm']
        exact (inferInstance : AlgebraicGeometry.SmoothOfRelativeDimension (1 + 0)
          ((α'_V.inv ≫ (V'_sm.ι ≫ g'_0)) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_VP)))
      exact ⟨V_next, hz_Vnext, hSm_comp'⟩
  have hRes_next : IsResolvedLocalStrictlySemistableMod V p_K g' n τ' ι' U' h_mod ι_U'
      C_next g_next f_dom_next τ_next ι_next :=
    ⟨hSS_next, hProp_fdom_next, hfdom_next_g, ⟨f_ss_next, hfdom_next_ss, hProp_fss_next⟩,
      by change (ι_cur ≫ q_contr) ≫ f_dom_next = ι_U'; rw [Category.assoc, hq_fdom, hι_fdom],
      hPb_next,
      fun j => by
        dsimp only [τ_next]
        rw [Category.assoc (τ_cur j) q_contr f_dom_next, hq_fdom]
        exact hτ_fdom j,
      hDisj_next, hSm_next⟩
  
  let s_fib : ∀ Q : PrimeSpectrum ↥V,
      AlgebraicGeometry.Spec (CommRingCat.of Q.asIdeal.ResidueField) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of ↥V) :=
    fun Q => AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap ↥V Q.asIdeal.ResidueField))
  let q_fib : ∀ Q : PrimeSpectrum ↥V,
      CategoryTheory.Limits.pullback g_cur (s_fib Q) ⟶
        CategoryTheory.Limits.pullback g_next (s_fib Q) :=
    fun Q => CategoryTheory.Limits.pullback.map g_cur (s_fib Q) g_next (s_fib Q)
      q_contr (𝟙 _) (𝟙 _) hq_g.symm (by simp)
  have hSurj_fib : ∀ Q : PrimeSpectrum ↥V, AlgebraicGeometry.Surjective (q_fib Q) := by
    intro Q
    have hRight : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.snd g_next (s_fib Q))
        (CategoryTheory.Limits.pullback.fst g_next (s_fib Q))
        (s_fib Q) g_next :=
      (CategoryTheory.IsPullback.of_hasPullback g_next (s_fib Q)).flip
    have hOuter : CategoryTheory.IsPullback
        (q_fib Q ≫ CategoryTheory.Limits.pullback.snd g_next (s_fib Q))
        (CategoryTheory.Limits.pullback.fst g_cur (s_fib Q))
        (s_fib Q) (q_contr ≫ g_next) := by
      rw [CategoryTheory.Limits.pullback.lift_snd, Category.comp_id]
      simpa only [hq_g] using (CategoryTheory.IsPullback.of_hasPullback g_cur (s_fib Q)).flip
    have hLeft : CategoryTheory.IsPullback
        (q_fib Q)
        (CategoryTheory.Limits.pullback.fst g_cur (s_fib Q))
        (CategoryTheory.Limits.pullback.fst g_next (s_fib Q))
        q_contr :=
      CategoryTheory.IsPullback.of_right hOuter
        (CategoryTheory.Limits.pullback.lift_fst _ _ _) hRight
    exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      hLeft.flip hSurj_q
  have hCardCov : ∀ (Q : PrimeSpectrum ↥V)
      (S : Set (Set ↥(CategoryTheory.Limits.pullback g_cur (s_fib Q)))),
      S.Finite →
      S ⊆ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_cur (s_fib Q)) →
      (⋃ E ∈ S, closure ((q_fib Q).base '' E)) = Set.univ →
      Nat.card ↥(irreducibleComponents ↥(CategoryTheory.Limits.pullback g_next (s_fib Q))) ≤
        Nat.card ↥S := by
    intro Q S hS_fin hS_sub hS_cov
    have hFinSub : ∀ (F : Set ↥(CategoryTheory.Limits.pullback g_next (s_fib Q))),
        IsIrreducible F →
        ∀ (T : Finset (Set ↥(CategoryTheory.Limits.pullback g_cur (s_fib Q)))),
          F ⊆ (⋃ E ∈ T, closure ((q_fib Q).base '' E)) →
          ∃ E ∈ T, F ⊆ closure ((q_fib Q).base '' E) := by
      intro F hF T
      induction T using Finset.induction_on with
      | empty =>
        intro hsub
        obtain ⟨y₀, hy₀⟩ := hF.1
        have hmem := hsub hy₀
        simp at hmem
      | insert E₀ T' _ ih =>
        intro hsub
        have hsub' : F ⊆ closure ((q_fib Q).base '' E₀) ∪
            (⋃ E ∈ T', closure ((q_fib Q).base '' E)) := by
          intro y hy
          rcases Set.mem_iUnion₂.mp (hsub hy) with ⟨E, hE_ins, hyE⟩
          rcases Finset.mem_insert.mp hE_ins with rfl | hET'
          · exact Or.inl hyE
          · exact Or.inr (Set.mem_iUnion₂.mpr ⟨E, hET', hyE⟩)
        have hCl₂ : IsClosed (⋃ E ∈ T', closure ((q_fib Q).base '' E)) :=
          T'.finite_toSet.isClosed_biUnion fun _ _ => isClosed_closure
        rcases (isPreirreducible_iff_isClosed_union_isClosed.mp hF.2)
            _ _ isClosed_closure hCl₂ hsub' with h₁ | h₂
        · exact ⟨E₀, Finset.mem_insert_self E₀ T', h₁⟩
        · obtain ⟨E, hET', hFE⟩ := ih h₂
          exact ⟨E, Finset.mem_insert_of_mem hET', hFE⟩
    have hHit : ∀ F : ↥(irreducibleComponents
        ↥(CategoryTheory.Limits.pullback g_next (s_fib Q))),
        ∃ E : ↥S, F.1 = closure ((q_fib Q).base '' E.1) := by
      intro F
      have hF_cov : F.1 ⊆ ⋃ E ∈ hS_fin.toFinset, closure ((q_fib Q).base '' E) := by
        have hEq : (⋃ E ∈ hS_fin.toFinset, closure ((q_fib Q).base '' E)) = Set.univ := by
          simpa only [Set.Finite.mem_toFinset] using hS_cov
        rw [hEq]
        exact Set.subset_univ _
      obtain ⟨E, hET, hFE⟩ := hFinSub F.1 F.2.1 hS_fin.toFinset hF_cov
      have hES : E ∈ S := hS_fin.mem_toFinset.mp hET
      have hE_irred : IsIrreducible (closure ((q_fib Q).base '' E)) :=
        ((hS_sub hES).1.image (q_fib Q).base (q_fib Q).continuous.continuousOn).closure
      have hEF : closure ((q_fib Q).base '' E) ⊆ F.1 := F.2.2 hE_irred hFE
      exact ⟨⟨E, hES⟩, Set.Subset.antisymm hFE hEF⟩
    choose φ hφ using hHit
    have : Finite ↥S := hS_fin.to_subtype
    refine Nat.card_le_card_of_injective φ ?_
    intro F₁ F₂ hEq
    apply Subtype.ext
    rw [hφ F₁, hφ F₂, hEq]
  have hLe_all : ∀ Q ∈ hPkg.1.toFinset,
      Nat.card ↥(irreducibleComponents ↥(CategoryTheory.Limits.pullback g_next (s_fib Q))) ≤
      Nat.card ↥(irreducibleComponents ↥(CategoryTheory.Limits.pullback g_cur (s_fib Q))) := by
    intro Q _
    have : AlgebraicGeometry.Surjective (q_fib Q) := hSurj_fib Q
    refine hCardCov Q _ (hFinFib Q) Set.Subset.rfl ?_
    ext y
    simp only [Set.mem_iUnion, Set.mem_univ, iff_true]
    obtain ⟨x, rfl⟩ := (q_fib Q).surjective y
    exact ⟨irreducibleComponent x, irreducibleComponent_mem_irreducibleComponents x,
      subset_closure ⟨x, mem_irreducibleComponent, rfl⟩⟩
  have hPre_sP : AlgebraicGeometry.IsPreimmersion (s_fib P) := by
    change AlgebraicGeometry.IsPreimmersion
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap ↥V P.asIdeal.ResidueField)))
    have hEq : algebraMap ↥V P.asIdeal.ResidueField =
        (IsLocalRing.residue (Localization.AtPrime P.asIdeal)).comp
          (algebraMap ↥V (Localization.AtPrime P.asIdeal)) :=
      IsScalarTower.algebraMap_eq ↥V (Localization.AtPrime P.asIdeal) P.asIdeal.ResidueField
    have hHom : CommRingCat.ofHom (algebraMap ↥V P.asIdeal.ResidueField) =
        CommRingCat.ofHom (algebraMap ↥V (Localization.AtPrime P.asIdeal)) ≫
          CommRingCat.ofHom (IsLocalRing.residue (Localization.AtPrime P.asIdeal)) := by
      rw [hEq]; rfl
    rw [hHom, AlgebraicGeometry.Spec.map_comp]
    have : AlgebraicGeometry.IsPreimmersion
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap ↥V (Localization.AtPrime P.asIdeal)))) :=
      @AlgebraicGeometry.IsPreimmersion.of_isLocalization ↥V (Localization.AtPrime P.asIdeal) _
        P.asIdeal.primeCompl _ _ _
    have : AlgebraicGeometry.IsClosedImmersion
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (IsLocalRing.residue (Localization.AtPrime P.asIdeal)))) :=
      AlgebraicGeometry.IsClosedImmersion.spec_of_surjective _
        IsLocalRing.residue_surjective
    infer_instance
  have hPre_fstP : AlgebraicGeometry.IsPreimmersion
      (CategoryTheory.Limits.pullback.fst g_next (s_fib P)) :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (CategoryTheory.IsPullback.of_hasPullback g_next (s_fib P)).flip hPre_sP
  have hInj_fstP : Function.Injective
      (CategoryTheory.Limits.pullback.fst g_next (s_fib P)).base :=
    (CategoryTheory.Limits.pullback.fst g_next (s_fib P)).isEmbedding.injective
  have hZ_to_znew : ∀ q ∈ Z, q_contr.base (fst_P.base q) = ι_1.base z_new := by
    intro q hq
    have hq_WB : (f_dom_cur ≫ h_mod).base (fst_P.base q) ∈ W_B := by
      change h_mod.base (f_dom_cur.base (fst_P.base q)) ∈ W_B
      rw [hZ_x₀ q hq]
      exact hu₀
    let y : ↥X_0.toScheme := ⟨fst_P.base q, hq_WB⟩
    have hy_ZX0 : y ∈ X_0.ι.base ⁻¹' (fst_P.base '' Z) := ⟨q, hq, rfl⟩
    rw [← hFexc_P] at hy_ZX0
    rcases hy_ZX0 with ⟨hy_Fexc, hy_P⟩
    have hq0y_P : (g'_0 ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_VP)).base
        (q_0.base y) = P := by
      have hcomm_y : ((f_dom_cur ≫ h_mod) ∣_ W_B) ≫ g_WB = q_0 ≫ g'_0 := by
        rw [← hq0_f'0, Category.assoc, hf'0_gWB]
      have hy_P' : (((f_dom_cur ≫ h_mod) ∣_ W_B) ≫ g_WB ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_VP)).base y = P := hy_P
      rw [← Category.assoc, hcomm_y, Category.assoc] at hy_P'
      exact hy_P'
    have hq0y_eq : q_0.base y = z_new := by
      have hmem : q_0.base y ∈
          Mod_q0 ∩ (g'_0 ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_VP)).base ⁻¹' {P} :=
        ⟨hy_Fexc, hq0y_P⟩
      rw [hMod_P] at hmem
      exact hmem
    calc
      q_contr.base (fst_P.base q) = (X_0.ι ≫ q_contr).base y := rfl
      _ = (q_0 ≫ ι_1).base y := by rw [hq_X0]
      _ = ι_1.base z_new := by change ι_1.base (q_0.base y) = ι_1.base z_new; rw [hq0y_eq]
  have hZ_const_fib : ∀ q₁ ∈ Z, ∀ q₂ ∈ Z, (q_fib P).base q₁ = (q_fib P).base q₂ := by
    intro q₁ hq₁ q₂ hq₂
    apply hInj_fstP
    have hcomm_q : ∀ q : ↥Y_P,
        (CategoryTheory.Limits.pullback.fst g_next (s_fib P)).base ((q_fib P).base q) =
          q_contr.base (fst_P.base q) := by
      intro q
      change (q_fib P ≫ CategoryTheory.Limits.pullback.fst g_next (s_fib P)).base q =
        (fst_P ≫ q_contr).base q
      rw [CategoryTheory.Limits.pullback.lift_fst]
    rw [hcomm_q q₁, hcomm_q q₂, hZ_to_znew q₁ hq₁, hZ_to_znew q₂ hq₂]
  have hΔ_nonempty :
      {q ∈ Z | ∃ E' ∈ irreducibleComponents ↥Y_P, E' ≠ Z ∧ q ∈ E'}.Nonempty := by
    rw [Set.nonempty_iff_ne_empty]
    intro hemp
    rw [hemp, Set.ncard_empty] at hΔ_lo
    omega
  rcases hΔ_nonempty with ⟨q₀_star, hq₀_Z, E₁, hE₁_comp, hE₁_ne, hq₀_E₁⟩
  let S_P : Set (Set ↥(CategoryTheory.Limits.pullback g_cur (s_fib P))) :=
    (irreducibleComponents ↥(CategoryTheory.Limits.pullback g_cur (s_fib P))) \ {Z}
  have hLt_P :
      Nat.card ↥(irreducibleComponents ↥(CategoryTheory.Limits.pullback g_next (s_fib P))) <
      Nat.card ↥(irreducibleComponents ↥(CategoryTheory.Limits.pullback g_cur (s_fib P))) := by
    have hLe_SP :
        Nat.card ↥(irreducibleComponents ↥(CategoryTheory.Limits.pullback g_next (s_fib P))) ≤
          Nat.card ↥S_P := by
      refine hCardCov P S_P ((hFinFib P).sdiff) Set.sdiff_subset ?_
      have : AlgebraicGeometry.Surjective (q_fib P) := hSurj_fib P
      ext y
      simp only [Set.mem_iUnion, Set.mem_univ, iff_true]
      obtain ⟨x, rfl⟩ := (q_fib P).surjective y
      by_cases hxZ : irreducibleComponent x = Z
      · have hx_in_Z : x ∈ Z := hxZ ▸ mem_irreducibleComponent
        have hqx : (q_fib P).base x = (q_fib P).base q₀_star :=
          hZ_const_fib x hx_in_Z q₀_star hq₀_Z
        refine ⟨E₁, ⟨hE₁_comp, hE₁_ne⟩, ?_⟩
        rw [hqx]
        exact subset_closure ⟨q₀_star, hq₀_E₁, rfl⟩
      · exact ⟨irreducibleComponent x,
          ⟨irreducibleComponent_mem_irreducibleComponents x, hxZ⟩,
          subset_closure ⟨x, mem_irreducibleComponent, rfl⟩⟩
    have hSSub : S_P ⊂ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_cur (s_fib P)) :=
      ⟨Set.sdiff_subset, fun hsup => (hsup hZ_irred).2 rfl⟩
    exact lt_of_le_of_lt hLe_SP ((hFinFib P).card_lt_card hSSub)
  have hLt :
      (∑ Q ∈ hPkg.1.toFinset,
        Nat.card ↥(irreducibleComponents ↥(CategoryTheory.Limits.pullback g_next (s_fib Q)))) <
      (∑ Q ∈ hPkg.1.toFinset,
        Nat.card ↥(irreducibleComponents ↥(CategoryTheory.Limits.pullback g_cur (s_fib Q)))) :=
    Finset.sum_lt_sum hLe_all ⟨P, hPkg.1.mem_toFinset.mpr (Set.mem_univ P), hLt_P⟩
  exact ⟨C_next, g_next, f_dom_next, τ_next, ι_next, hRes_next, hLt⟩

theorem weil_local_strictlySemistable_relative_contraction (K : Type u) [Field K] [IsSepClosed K]
    (m : ℕ) (V : ValuationSubring K) (hPkg : IsValuationRingAlgPackage m V)
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (n : ℕ) (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (hIntCK : AlgebraicGeometry.IsIntegral C_K)
    (hPropCK : AlgebraicGeometry.IsProper p_K)
    (hSmCK : AlgebraicGeometry.SmoothOfRelativeDimension 1 p_K)
    (hStabCK : IsGeometricStablePointedCurve p_K n σ_K)
    (C' : AlgebraicGeometry.Scheme.{u})
    (g' : C' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (τ' : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C'))
    (ι' : C_K ⟶ C')
    (hMod' : IsValuationPointedCurveModel V p_K n σ_K C' g' τ' ι')
    (U' : C'.Opens) (hU' : Nonempty ↥U')
    (U_ss : AlgebraicGeometry.Scheme.{u})
    (g_ss : U_ss ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (hAff_ss : AlgebraicGeometry.IsAffine U_ss)
    (hSS : IsStrictlySemistableCurveOverValuation V g_ss)
    (h_mod : U'.toScheme ⟶ U_ss)
    (hProp_mod : AlgebraicGeometry.IsProper h_mod)
    (hComm_mod : h_mod ≫ g_ss = U'.ι ≫ g')
    (ι_U' : AlgebraicGeometry.Scheme.Opens.toScheme
      ((TopologicalSpace.Opens.map ι'.base).obj U') ⟶ U'.toScheme)
    (hι_comm : ι_U' ≫ U'.ι =
      AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj U') ≫ ι')
    (hPb_U' : CategoryTheory.IsPullback ι_U'
      (AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj U') ≫ p_K)
      (U'.ι ≫ g')
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (hPb_ss : CategoryTheory.IsPullback (ι_U' ≫ h_mod)
      (AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj U') ≫ p_K)
      g_ss
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (C'' : AlgebraicGeometry.Scheme.{u})
    (g'' : C'' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (f_dom : C'' ⟶ U'.toScheme)
    (τ'' : ∀ j : Fin n,
      AlgebraicGeometry.Scheme.Opens.toScheme
        ((TopologicalSpace.Opens.map (τ' j).base).obj U') ⟶ C'')
    (ι_C'' : AlgebraicGeometry.Scheme.Opens.toScheme
      ((TopologicalSpace.Opens.map ι'.base).obj U') ⟶ C'')
    (hRes : IsResolvedLocalStrictlySemistableMod V p_K g' n τ' ι' U' h_mod ι_U'
      C'' g'' f_dom τ'' ι_C'') :
    ∃ (C_bar : AlgebraicGeometry.Scheme.{u})
      (g_bar : C_bar ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
      (f_bar : C_bar ⟶ U'.toScheme)
      (τ_bar : ∀ j : Fin n,
        AlgebraicGeometry.Scheme.Opens.toScheme
          ((TopologicalSpace.Opens.map (τ' j).base).obj U') ⟶ C_bar)
      (ι_bar : AlgebraicGeometry.Scheme.Opens.toScheme
        ((TopologicalSpace.Opens.map ι'.base).obj U') ⟶ C_bar),
      IsLocalRelativeStableMod V p_K g' n τ' ι' U' ι_U' C_bar g_bar f_bar τ_bar ι_bar :=
by
  by_cases hMax : IsLocalRing.maximalIdeal ↥V = ⊥
  · 
    have hSurj : Function.Surjective V.subtype := by
      intro a
      by_cases haV : a ∈ V
      · exact ⟨⟨a, haV⟩, rfl⟩
      · exfalso
        have ha0 : a ≠ 0 := fun h => haV (h ▸ V.zero_mem)
        rcases ValuationSubring.mem_or_inv_mem V a with ha | ha_inv
        · exact haV ha
        · let x : ↥V := ⟨a⁻¹, ha_inv⟩
          have hx_nonunit : ¬ IsUnit x := by
            intro hu
            rcases hu.exists_right_inv with ⟨y, hy⟩
            have hval : a⁻¹ * y.1 = 1 := congrArg Subtype.val hy
            have hy_eq : y.1 = a := by
              calc y.1 = a * (a⁻¹ * y.1) := by rw [← mul_assoc, mul_inv_cancel₀ ha0, one_mul]
              _ = a := by rw [hval, mul_one]
            exact haV (hy_eq ▸ y.2)
          have hx_max : x ∈ IsLocalRing.maximalIdeal ↥V :=
            (IsLocalRing.mem_maximalIdeal x).2 hx_nonunit
          rw [hMax, Ideal.mem_bot] at hx_max
          exact inv_ne_zero ha0 (congrArg Subtype.val hx_max)
    let eV : ↥V ≃+* K := RingEquiv.ofBijective V.subtype ⟨Subtype.val_injective, hSurj⟩
