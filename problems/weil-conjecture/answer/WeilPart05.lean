    let Θ : TensorProduct P_1 ↥E_0 B_K →ₐ[↥E_0] F :=
      Algebra.TensorProduct.lift (Algebra.ofId ↥E_0 F) β_BK (fun _ _ => Commute.all _ _)
    have hAlg_BK : ∀ b : B_K, IsAlgebraic ↥E_0 (algebraMap B_K F b) := by
      intro b
      have hInt_b : IsIntegral ↥E_0 (Θ (1 ⊗ₜ[P_1] b)) :=
