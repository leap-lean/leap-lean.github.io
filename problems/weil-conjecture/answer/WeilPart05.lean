    (R : ValuationSubring K)
    (hOpen_ηR : AlgebraicGeometry.IsOpenImmersion
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom R.subtype)))
    (M_0 W_B_sch : AlgebraicGeometry.Scheme.{u})
