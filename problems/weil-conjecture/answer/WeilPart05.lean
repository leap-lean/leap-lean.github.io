      have hSurj_open : Function.Surjective (hU₀.fromSpec.residueFieldMap p_x).hom :=
        (ConcreteCategory.bijective_of_isIso (hU₀.fromSpec.residueFieldMap p_x)).2
      have hSurj_comp : Function.Surjective ((hU₀.fromSpec ≫ g_X).residueFieldMap p_x).hom := by
        rw [AlgebraicGeometry.Scheme.residueFieldMap_comp]
