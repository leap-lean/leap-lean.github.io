        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    let _ : Algebra ↥A_sub ↥E_0 := ι_AE.toAlgebra
    have : IsScalarTower ↥A_sub ↥E_0 F := IsScalarTower.of_algebraMap_eq' rfl
    have : Algebra.IsAlgebraic ↥A_sub ↥E_0 := by
      refine ⟨fun z => ?_⟩
      obtain ⟨a, ha, b, hb, hb0, hzb⟩ := hE₀_le_L z.2
      let P_lin : Polynomial ↥A_sub :=
        Polynomial.C ⟨b, hb⟩ * Polynomial.X - Polynomial.C ⟨a, ha⟩
      refine ⟨P_lin, ?_, ?_⟩
      · intro hP0
        have hc1 := congrArg (fun q => q.coeff 1) hP0
        simp only [P_lin, Polynomial.coeff_sub, Polynomial.coeff_C_mul, Polynomial.coeff_X_one,
          mul_one, Polynomial.coeff_C_succ, sub_zero, Polynomial.coeff_zero] at hc1
        exact hb0 (congrArg Subtype.val hc1)
      · apply Subtype.ext
        change (E_0.val.toRingHom) (Polynomial.aeval z P_lin) = 0
        simp only [P_lin, map_sub, map_mul, Polynomial.aeval_C, Polynomial.aeval_X]
        change b * z.1 - a = 0
        rw [mul_comm, hzb, sub_self]
    have : Algebra.IsAlgebraic ↥A_sub F := Algebra.IsAlgebraic.trans ↥A_sub ↥E_0 F
    have hTr : Algebra.trdeg K F ≤ 1 := by
      calc
        Algebra.trdeg K F ≤ Cardinal.mk ↑({t₀} : Set F) :=
          Algebra.IsAlgebraic.trdeg_le_cardinalMk K ({t₀} : Set F)
        _ = 1 := Cardinal.mk_singleton t₀
    exact ⟨hEss, hTr⟩

  
  have step_graph : ∀ (U₀ S₀ X₀ Y₀ : AlgebraicGeometry.Scheme.{u})
      (_ : Nonempty ↥U₀)
      (_ : AlgebraicGeometry.IsIntegral U₀)
      (_ : AlgebraicGeometry.IsIntegral X₀)
      (_ : AlgebraicGeometry.IsIntegral Y₀)
      (f_X₀ : X₀ ⟶ S₀) (f_Y₀ : Y₀ ⟶ S₀)
      [AlgebraicGeometry.IsProper f_X₀] [AlgebraicGeometry.IsProper f_Y₀]
      (ι_X₀ : U₀ ⟶ X₀) (ι_Y₀ : U₀ ⟶ Y₀)
      [AlgebraicGeometry.IsOpenImmersion ι_X₀] [AlgebraicGeometry.IsOpenImmersion ι_Y₀]
      (hι_comm : ι_X₀ ≫ f_X₀ = ι_Y₀ ≫ f_Y₀)
      (_ : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.lift ι_X₀ ι_Y₀ hι_comm)
        (𝟙 U₀) (CategoryTheory.Limits.pullback.fst f_X₀ f_Y₀) ι_X₀)
      (F : Type u) [Field F]
      (η₀ : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ U₀),
      IsSchemeFunctionField U₀ F η₀ →
      ∃ (P_tilde : AlgebraicGeometry.Scheme.{u})
        (j_P : P_tilde ⟶ CategoryTheory.Limits.pullback f_X₀ f_Y₀)
        (π₁ : P_tilde ⟶ X₀) (π₂ : P_tilde ⟶ Y₀)
        (ι_P : U₀ ⟶ P_tilde)
        (η_P : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ P_tilde)
        (η_X : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ X₀)
        (η_Y : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ Y₀),
        AlgebraicGeometry.IsClosedImmersion j_P ∧
        π₁ = j_P ≫ CategoryTheory.Limits.pullback.fst f_X₀ f_Y₀ ∧
        π₂ = j_P ≫ CategoryTheory.Limits.pullback.snd f_X₀ f_Y₀ ∧
        η_X = η₀ ≫ ι_X₀ ∧
        AlgebraicGeometry.IsIntegral P_tilde ∧
        AlgebraicGeometry.IsProper π₁ ∧
        AlgebraicGeometry.IsProper π₂ ∧
        π₁ ≫ f_X₀ = π₂ ≫ f_Y₀ ∧
        ι_P ≫ π₁ = ι_X₀ ∧
        ι_P ≫ π₂ = ι_Y₀ ∧
        CategoryTheory.IsPullback ι_P (𝟙 U₀) π₁ ι_X₀ ∧
        AlgebraicGeometry.IsDominant η_P ∧
        η_P ≫ π₁ = η_X ∧
        η_P ≫ π₂ = η_Y ∧
        IsSchemeFunctionField P_tilde F η_P ∧
        IsSchemeFunctionField X₀ F η_X ∧
        IsSchemeFunctionField Y₀ F η_Y ∧
        (∀ x : X₀, x ∈ Set.range ι_X₀.base → Set.Subsingleton (π₁.base ⁻¹' {x})) := by
    clear * - basicOpen_algebraMap_eq hIsFrac_of_away
    intro U₀ S₀ X Y hU₀_ne hIntU₀ hIntX hIntY f_X f_Y _ _ ι_X ι_Y _ _ hι_comm hPb_Δ F _ η₀ hFunc₀
    let P_raw := CategoryTheory.Limits.pullback f_X f_Y
    let fst_raw := CategoryTheory.Limits.pullback.fst f_X f_Y
    let snd_raw := CategoryTheory.Limits.pullback.snd f_X f_Y
    let Δ_K := CategoryTheory.Limits.pullback.lift ι_X ι_Y hι_comm
    let η_raw : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ P_raw := η₀ ≫ Δ_K
    let P_tilde : AlgebraicGeometry.Scheme.{u} := η_raw.image
    let j_P : P_tilde ⟶ P_raw := η_raw.imageι
    let η_P : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ P_tilde := η_raw.toImage
    let π₁ : P_tilde ⟶ X := j_P ≫ fst_raw
    let π₂ : P_tilde ⟶ Y := j_P ≫ snd_raw
    let η_X : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ X := η₀ ≫ ι_X
    let η_Y : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ Y := η₀ ≫ ι_Y
    let pt_F : ↥(AlgebraicGeometry.Spec (CommRingCat.of F)) := ⟨⊥, inferInstance⟩
    have hDom_P : AlgebraicGeometry.IsDominant η_P := inferInstance
    have hCl_jP : AlgebraicGeometry.IsClosedImmersion j_P := inferInstance
    have hProp_π₁ : AlgebraicGeometry.IsProper π₁ := inferInstance
    have hProp_π₂ : AlgebraicGeometry.IsProper π₂ := inferInstance
    have hπ_comm : π₁ ≫ f_X = π₂ ≫ f_Y := by
      simp only [π₁, π₂, fst_raw, snd_raw, CategoryTheory.Category.assoc]
      rw [CategoryTheory.Limits.pullback.condition]
    have hηP_X : η_P ≫ π₁ = η_X := by
      calc
        η_P ≫ π₁ = (η_P ≫ j_P) ≫ fst_raw := by simp only [π₁, CategoryTheory.Category.assoc]
        _ = (η₀ ≫ Δ_K) ≫ fst_raw := by rw [AlgebraicGeometry.Scheme.Hom.toImage_imageι]
        _ = η₀ ≫ ι_X := by
            rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst]
        _ = η_X := rfl
    have hηP_Y : η_P ≫ π₂ = η_Y := by
      calc
        η_P ≫ π₂ = (η_P ≫ j_P) ≫ snd_raw := by simp only [π₂, CategoryTheory.Category.assoc]
        _ = (η₀ ≫ Δ_K) ≫ snd_raw := by rw [AlgebraicGeometry.Scheme.Hom.toImage_imageι]
        _ = η₀ ≫ ι_Y := by
            rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd]
        _ = η_Y := rfl
    have hInt_P : AlgebraicGeometry.IsIntegral P_tilde := by
      have hIrredP : IrreducibleSpace ↥P_tilde := by
        have hPreSpec : IsPreirreducible (Set.univ : Set ↥(AlgebraicGeometry.Spec (CommRingCat.of F))) :=
          PreirreducibleSpace.isPreirreducible_univ
        have hIm : IsPreirreducible (Set.range η_P.base) := by
          rw [← Set.image_univ]
          exact hPreSpec.image η_P.base η_P.continuous.continuousOn
        have hCl : IsPreirreducible (closure (Set.range η_P.base)) := hIm.closure
        rw [hDom_P.denseRange.closure_eq] at hCl
        exact { isPreirreducible_univ := hCl, toNonempty := ⟨η_P.base pt_F⟩ }
      have : ∀ z : ↥P_tilde, IsReduced ↑(P_tilde.presheaf.stalk z) := by
        intro z
        obtain ⟨U_raw, hU_raw, hz_raw, _⟩ :=
          AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := ⊤) (x := j_P.base z) trivial
        let U_aff : P_raw.affineOpens := ⟨U_raw, hU_raw⟩
        let V_sub : P_tilde.Opens := (TopologicalSpace.Opens.map j_P.base).obj U_raw
        have hV_sub : AlgebraicGeometry.IsAffineOpen V_sub := hU_raw.preimage j_P
        have hz_V : z ∈ V_sub := hz_raw
        have hKer_eq :
            RingHom.ker (j_P.app U_raw).hom = RingHom.ker (η_raw.app U_raw).hom := by
          calc
            RingHom.ker (j_P.app U_raw).hom = j_P.ker.ideal U_aff :=
              (j_P.ker_apply U_aff).symm
            _ = η_raw.ker.ideal U_aff := by
              change (η_raw.ker.subschemeι).ker.ideal U_aff = η_raw.ker.ideal U_aff
              rw [AlgebraicGeometry.Scheme.IdealSheafData.ker_subschemeι]
            _ = RingHom.ker (η_raw.app U_raw).hom := η_raw.ker_apply U_aff
        have hSurj_jP : Function.Surjective (j_P.app U_raw).hom :=
          AlgebraicGeometry.Scheme.Hom.app_surjective j_P U_raw hU_raw
        have : AlgebraicGeometry.IsReduced (AlgebraicGeometry.Spec (CommRingCat.of F)) :=
          (AlgebraicGeometry.affine_isReduced_iff (CommRingCat.of F)).mpr inferInstance
        have : IsReduced
            ↑((AlgebraicGeometry.Spec (CommRingCat.of F)).presheaf.obj
              (Opposite.op ((TopologicalSpace.Opens.map η_raw.base).obj U_raw))) :=
          AlgebraicGeometry.IsReduced.component_reduced _
        have hRed_V_sec : IsReduced ↑(P_tilde.presheaf.obj (Opposite.op V_sub)) := by
          refine ⟨fun w ⟨k, hwk⟩ => ?_⟩
          obtain ⟨a, rfl⟩ := hSurj_jP w
          rw [← map_pow] at hwk
          have ha_ker : a ^ k ∈ RingHom.ker (η_raw.app U_raw).hom := by
            rw [← hKer_eq]; exact hwk
          change (η_raw.app U_raw).hom (a ^ k) = 0 at ha_ker
          rw [map_pow] at ha_ker
          have ha0_F : (η_raw.app U_raw).hom a = 0 :=
            IsNilpotent.eq_zero ⟨k, ha_ker⟩
          have ha_ker' : a ∈ RingHom.ker (j_P.app U_raw).hom := by
            rw [hKer_eq]; exact ha0_F
          exact ha_ker'
        have : AlgebraicGeometry.IsReduced
            (AlgebraicGeometry.Spec (P_tilde.presheaf.obj (Opposite.op V_sub))) :=
          (AlgebraicGeometry.affine_isReduced_iff _).mpr hRed_V_sec
        have : AlgebraicGeometry.IsReduced V_sub.toScheme :=
          AlgebraicGeometry.isReduced_of_isOpenImmersion hV_sub.isoSpec.hom
        have : IsReduced ↑(V_sub.toScheme.presheaf.stalk ⟨z, hz_V⟩) :=
          AlgebraicGeometry.isReduced_stalk_of_isReduced V_sub.toScheme ⟨z, hz_V⟩
        exact isReduced_of_injective
          (V_sub.stalkIso ⟨z, hz_V⟩).symm.commRingCatIsoToRingEquiv.toRingHom
          (V_sub.stalkIso ⟨z, hz_V⟩).symm.commRingCatIsoToRingEquiv.injective
      have : AlgebraicGeometry.IsReduced P_tilde :=
        AlgebraicGeometry.isReduced_of_isReduced_stalk P_tilde
      exact AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced P_tilde
    have hKer_₀ : η₀.ker = ⊥ := by
      apply AlgebraicGeometry.Scheme.IdealSheafData.ext_of_iSup_eq_top
        (U := fun V : ↥U₀.affineOpens => V)
      · rw [eq_top_iff]
        intro u _
        obtain ⟨W, hW, huW, _⟩ :=
          AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := ⊤) (x := u) trivial
        exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨W, hW⟩, huW⟩
      · intro U
        have hU_aff : AlgebraicGeometry.IsAffineOpen U.1 := U.2
        rw [η₀.ker_apply U]
        have hbot_ideal : (⊥ : U₀.IdealSheafData).ideal U = ⊥ := rfl
        rw [hbot_ideal]
        by_cases hUne : Nonempty ↥U.1
        · obtain ⟨φ_U, hFracU, hφU⟩ := hFunc₀ U.1 hU_aff hUne
          have hInj_φU : Function.Injective φ_U.hom := by
            let _ : Algebra ↑(U₀.presheaf.obj (Opposite.op U.1)) F := φ_U.hom.toAlgebra
            exact @IsFractionRing.injective _ _ F _ _ hFracU
          have htop_le : (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of F)).Opens) ≤
              (TopologicalSpace.Opens.map η₀.base).obj U.1 := by
            intro q _
            have hq : q = pt_F := Subsingleton.elim q pt_F
            rw [hq, ← hφU]
            change hU_aff.fromSpec.base ((AlgebraicGeometry.Spec.map φ_U).base pt_F) ∈ (U.1 : Set _)
            rw [← AlgebraicGeometry.IsAffineOpen.range_fromSpec hU_aff]
            exact ⟨(AlgebraicGeometry.Spec.map φ_U).base pt_F, rfl⟩
          let hTopF := AlgebraicGeometry.isAffineOpen_top (AlgebraicGeometry.Spec (CommRingCat.of F))
          let ψ_top : CommRingCat.of F ⟶
              (AlgebraicGeometry.Spec (CommRingCat.of F)).presheaf.obj (Opposite.op ⊤) :=
            AlgebraicGeometry.Spec.preimage hTopF.fromSpec
          have hSpec_eq :
              AlgebraicGeometry.Spec.map (φ_U ≫ ψ_top) ≫ hU_aff.fromSpec =
                AlgebraicGeometry.Spec.map (η₀.appLE U.1 ⊤ htop_le) ≫ hU_aff.fromSpec := by
            calc
              AlgebraicGeometry.Spec.map (φ_U ≫ ψ_top) ≫ hU_aff.fromSpec
                = AlgebraicGeometry.Spec.map ψ_top ≫
                    (AlgebraicGeometry.Spec.map φ_U ≫ hU_aff.fromSpec) := by
                  simp only [AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc]
              _ = hTopF.fromSpec ≫ η₀ := by
                  rw [AlgebraicGeometry.Spec.map_preimage, hφU]
              _ = AlgebraicGeometry.Spec.map (η₀.appLE U.1 ⊤ htop_le) ≫ hU_aff.fromSpec :=
                  (AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec η₀ hU_aff hTopF htop_le).symm
          have happLE_eq : φ_U ≫ ψ_top = η₀.appLE U.1 ⊤ htop_le :=
            AlgebraicGeometry.Spec.map_injective ((cancel_mono hU_aff.fromSpec).mp hSpec_eq)
          have : Nontrivial
              ↑((AlgebraicGeometry.Spec (CommRingCat.of F)).presheaf.obj (Opposite.op ⊤)) := by
            by_contra hNotNontriv
            rw [not_nontrivial_iff_subsingleton] at hNotNontriv
            have hEmpty : IsEmpty
                ↥(AlgebraicGeometry.Spec
                  ((AlgebraicGeometry.Spec (CommRingCat.of F)).presheaf.obj (Opposite.op ⊤))) :=
              PrimeSpectrum.isEmpty_iff_subsingleton.mpr hNotNontriv
            obtain ⟨q₀, _⟩ : pt_F ∈ Set.range hTopF.fromSpec.base := by
              rw [AlgebraicGeometry.IsAffineOpen.range_fromSpec]
              trivial
            exact hEmpty.false q₀
          rw [eq_bot_iff]
          intro a ha
          have ha_appLE : (η₀.appLE U.1 ⊤ htop_le).hom a = 0 := by
            change ((AlgebraicGeometry.Spec (CommRingCat.of F)).presheaf.map
              (CategoryTheory.homOfLE htop_le).op).hom ((η₀.app U.1).hom a) = 0
            have ha0 : (η₀.app U.1).hom a = 0 := ha
            rw [ha0, map_zero]
          rw [← happLE_eq] at ha_appLE
          have hφa0 : φ_U.hom a = 0 :=
            (RingHom.injective ψ_top.hom) (ha_appLE.trans ψ_top.hom.map_zero.symm)
          exact hInj_φU (hφa0.trans φ_U.hom.map_zero.symm)
        · have hEmpty : IsEmpty ↥(AlgebraicGeometry.Spec (U₀.presheaf.obj (Opposite.op U.1))) :=
            ⟨fun q => hUne ⟨⟨hU_aff.fromSpec.base q, by
              change hU_aff.fromSpec.base q ∈ (U.1 : Set ↥U₀)
              rw [← AlgebraicGeometry.IsAffineOpen.range_fromSpec hU_aff]
              exact ⟨q, rfl⟩⟩⟩⟩
          have : Subsingleton ↑(U₀.presheaf.obj (Opposite.op U.1)) :=
            PrimeSpectrum.isEmpty_iff_subsingleton.mp hEmpty
          exact Subsingleton.elim _ ⊥
    have hKer_jP_eq : j_P.ker = Δ_K.ker := by
      calc
        j_P.ker = η_raw.ker := by
          change (η_raw.ker.subschemeι).ker = η_raw.ker
          exact AlgebraicGeometry.Scheme.IdealSheafData.ker_subschemeι η_raw.ker
        _ = (η₀.ker).map Δ_K := AlgebraicGeometry.Scheme.Hom.ker_comp η₀ Δ_K
        _ = (⊥ : U₀.IdealSheafData).map Δ_K := by rw [hKer_₀]
        _ = Δ_K.ker := AlgebraicGeometry.Scheme.IdealSheafData.map_bot Δ_K
    let ι_P : U₀ ⟶ P_tilde :=
      AlgebraicGeometry.IsClosedImmersion.lift j_P Δ_K (le_of_eq hKer_jP_eq)
    have hιP_jP : ι_P ≫ j_P = Δ_K :=
      AlgebraicGeometry.IsClosedImmersion.lift_fac j_P Δ_K (le_of_eq hKer_jP_eq)
    have hιP_π₁ : ι_P ≫ π₁ = ι_X := by
      calc
        ι_P ≫ π₁ = (ι_P ≫ j_P) ≫ fst_raw := by simp only [π₁, CategoryTheory.Category.assoc]
        _ = Δ_K ≫ fst_raw := by rw [hιP_jP]
        _ = ι_X := CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hιP_π₂ : ι_P ≫ π₂ = ι_Y := by
      calc
        ι_P ≫ π₂ = (ι_P ≫ j_P) ≫ snd_raw := by simp only [π₂, CategoryTheory.Category.assoc]
        _ = Δ_K ≫ snd_raw := by rw [hιP_jP]
        _ = ι_Y := CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hη₀_ιP : η₀ ≫ ι_P = η_P := by
      apply (cancel_mono j_P).mp
      rw [CategoryTheory.Category.assoc, hιP_jP, AlgebraicGeometry.Scheme.Hom.toImage_imageι]
    have hPb_inner : CategoryTheory.IsPullback ι_P (𝟙 U₀) π₁ ι_X := by
      have hw : ι_P ≫ π₁ = 𝟙 U₀ ≫ ι_X := by
        rw [hιP_π₁, CategoryTheory.Category.id_comp]
      let cone_ιP := CategoryTheory.Limits.PullbackCone.mk ι_P (𝟙 U₀) hw
      refine CategoryTheory.IsPullback.of_isLimit (c := cone_ιP)
        (CategoryTheory.Limits.PullbackCone.IsLimit.mk hw
          (fun s => s.snd)
          (fun s => ?_)
          (fun s => CategoryTheory.Category.comp_id s.snd)
          (fun s m _ hm₂ => by simpa using hm₂))
      apply (cancel_mono j_P).mp
      rw [CategoryTheory.Category.assoc, hιP_jP]
      have hs_raw : (s.fst ≫ j_P) ≫ fst_raw = s.snd ≫ ι_X := by
        rw [CategoryTheory.Category.assoc]; exact s.condition
      have hl_snd : hPb_Δ.lift (s.fst ≫ j_P) s.snd hs_raw = s.snd := by
        simpa using hPb_Δ.lift_snd (s.fst ≫ j_P) s.snd hs_raw
      calc
        s.snd ≫ Δ_K = hPb_Δ.lift (s.fst ≫ j_P) s.snd hs_raw ≫ Δ_K := by rw [hl_snd]
        _ = s.fst ≫ j_P := hPb_Δ.lift_fst (s.fst ≫ j_P) s.snd hs_raw
    have : AlgebraicGeometry.IsOpenImmersion ι_P :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (P := @AlgebraicGeometry.IsOpenImmersion) hPb_inner.flip inferInstance
    obtain ⟨u_base⟩ := id hU₀_ne
    have hPushFunc : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral Z)
        (ι_Z : U₀ ⟶ Z) [AlgebraicGeometry.IsOpenImmersion ι_Z],
        IsSchemeFunctionField Z F (η₀ ≫ ι_Z) := by
      intro Z hIntZ ι_Z _ U hU hUne
      have hIrredZ : IrreducibleSpace ↥Z :=
        @AlgebraicGeometry.irreducibleSpace_of_isIntegral Z hIntZ
      have : PreirreducibleSpace ↥Z := hIrredZ.toPreirreducibleSpace
      obtain ⟨⟨z₁, hz₁⟩⟩ := id hUne
      obtain ⟨z₀, hz₀_U, hz₀_range⟩ :=
        nonempty_preirreducible_inter U.2 ι_Z.isOpenEmbedding.isOpen_range
          ⟨z₁, hz₁⟩ ⟨ι_Z.base u_base, u_base, rfl⟩
      have hz₀_or : z₀ ∈ (ι_Z.opensRange : Set Z) := hz₀_range
      obtain ⟨r, hr_le_or, hz₀_Dr⟩ := hU.exists_basicOpen_le ⟨z₀, hz₀_or⟩ hz₀_U
      have hDr_aff : AlgebraicGeometry.IsAffineOpen (Z.basicOpen r) := hU.basicOpen r
      let A_U : Type u := ↑(Z.presheaf.obj (Opposite.op U))
      have : IsDomain A_U :=
        @AlgebraicGeometry.IsIntegral.component_integral Z hIntZ U hUne
      have hr_ne : r ≠ 0 := by intro hr0; simp [hr0] at hz₀_Dr
      let V_r : U₀.Opens := (TopologicalSpace.Opens.map ι_Z.base).obj (Z.basicOpen r)
      have hVr_aff : AlgebraicGeometry.IsAffineOpen V_r :=
        hDr_aff.preimage_of_isOpenImmersion ι_Z hr_le_or
      obtain ⟨u₀, rfl⟩ := hz₀_range
      have hVr_ne : Nonempty ↥V_r := ⟨⟨u₀, hz₀_Dr⟩⟩
      obtain ⟨φ_Vr, hFrac_Vr, hφ_Vr⟩ := hFunc₀ V_r hVr_aff hVr_ne
      have : CategoryTheory.IsIso (ι_Z.app (Z.basicOpen r)) :=
        AlgebraicGeometry.Scheme.Hom.isIso_app ι_Z (Z.basicOpen r) hr_le_or
      let φ_Dr : Z.presheaf.obj (Opposite.op (Z.basicOpen r)) ⟶ CommRingCat.of F :=
        ι_Z.app (Z.basicOpen r) ≫ φ_Vr
      have hFrac_Dr :
          @IsFractionRing ↑(Z.presheaf.obj (Opposite.op (Z.basicOpen r))) _ F _ φ_Dr.hom.toAlgebra := by
        let eqv := (CategoryTheory.asIso (ι_Z.app (Z.basicOpen r))).commRingCatIsoToRingEquiv
        have : IsDomain ↑(Z.presheaf.obj (Opposite.op (Z.basicOpen r))) :=
          @AlgebraicGeometry.IsIntegral.component_integral Z hIntZ (Z.basicOpen r)
            ⟨⟨ι_Z.base u₀, hz₀_Dr⟩⟩
        have hInj : Function.Injective φ_Dr.hom := by
          let _ : Algebra ↑(U₀.presheaf.obj (Opposite.op V_r)) F := φ_Vr.hom.toAlgebra
          exact (@IsFractionRing.injective _ _ F _ _ hFrac_Vr).comp eqv.injective
        let _ : Algebra ↑(Z.presheaf.obj (Opposite.op (Z.basicOpen r))) F := φ_Dr.hom.toAlgebra
        refine
          { map_units := fun y => IsUnit.mk0 (φ_Dr.hom y.1) (fun h0 =>
              nonZeroDivisors.ne_zero y.2 (hInj (h0.trans φ_Dr.hom.map_zero.symm)))
            surj := fun f => ?_
            exists_of_eq := fun {x y} hxy => ⟨1, by simp [hInj hxy]⟩ }
        let _ : Algebra ↑(U₀.presheaf.obj (Opposite.op V_r)) F := φ_Vr.hom.toAlgebra
        obtain ⟨⟨b₁, b₂⟩, hf_eq⟩ := @IsLocalization.surj _ _ _ F _ _ hFrac_Vr f
        have hb₂_ne : eqv.symm b₂.1 ≠ 0 := fun h0 =>
          nonZeroDivisors.ne_zero b₂.2 (eqv.symm.injective (h0.trans eqv.symm.map_zero.symm))
        refine ⟨⟨eqv.symm b₁, ⟨eqv.symm b₂.1, mem_nonZeroDivisors_of_ne_zero hb₂_ne⟩⟩, ?_⟩
        change f * φ_Vr.hom (eqv (eqv.symm b₂.1)) = φ_Vr.hom (eqv (eqv.symm b₁))
        rw [eqv.apply_symm_apply, eqv.apply_symm_apply]
        exact hf_eq
      have : IsLocalization.Away r ↑(Z.presheaf.obj (Opposite.op (Z.basicOpen r))) :=
        hU.isLocalization_basicOpen r
      let res_U_Dr := Z.presheaf.map (CategoryTheory.homOfLE (Z.basicOpen_le r)).op
      let φ_U : Z.presheaf.obj (Opposite.op U) ⟶ CommRingCat.of F := res_U_Dr ≫ φ_Dr
      refine ⟨φ_U,
        hIsFrac_of_away r hr_ne φ_Dr.hom φ_U.hom
          (fun a => by rw [basicOpen_algebraMap_eq Z U r]; rfl) hFrac_Dr,
        ?_⟩
      calc
        AlgebraicGeometry.Spec.map φ_U ≫ hU.fromSpec
          = AlgebraicGeometry.Spec.map φ_Dr ≫
              (AlgebraicGeometry.Spec.map res_U_Dr ≫ hU.fromSpec) := by
            simp only [φ_U, AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc]
        _ = AlgebraicGeometry.Spec.map φ_Dr ≫ hDr_aff.fromSpec := by
            rw [hU.map_fromSpec hDr_aff (CategoryTheory.homOfLE (Z.basicOpen_le r)).op]
        _ = AlgebraicGeometry.Spec.map φ_Vr ≫
              (AlgebraicGeometry.Spec.map (ι_Z.app (Z.basicOpen r)) ≫ hDr_aff.fromSpec) := by
            simp only [φ_Dr, AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc]
        _ = AlgebraicGeometry.Spec.map φ_Vr ≫ (hVr_aff.fromSpec ≫ ι_Z) := by
            rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE,
              AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec ι_Z hDr_aff hVr_aff le_rfl]
        _ = (AlgebraicGeometry.Spec.map φ_Vr ≫ hVr_aff.fromSpec) ≫ ι_Z := by
            rw [← CategoryTheory.Category.assoc]
        _ = η₀ ≫ ι_Z := by rw [hφ_Vr]
    have hSub_range : ∀ x : X, x ∈ Set.range ι_X.base → Set.Subsingleton (π₁.base ⁻¹' {x}) := by
      intro x hx_range z₁ hz₁ z₂ hz₂
      have hSurj_iso : Function.Surjective hPb_inner.isoPullback.hom.base := fun q =>
        ⟨hPb_inner.isoPullback.inv.base q, by
          change (hPb_inner.isoPullback.inv ≫ hPb_inner.isoPullback.hom).base q = q
          rw [CategoryTheory.Iso.inv_hom_id]; rfl⟩
      have hRange_ιP : Set.range ι_P.base = π₁.base ⁻¹' Set.range ι_X.base := by
        calc
          Set.range ι_P.base
            = Set.range (hPb_inner.isoPullback.hom ≫
                CategoryTheory.Limits.pullback.fst π₁ ι_X).base :=
              congrArg (fun f => Set.range f.base) hPb_inner.isoPullback_hom_fst.symm
          _ = Set.range (CategoryTheory.Limits.pullback.fst π₁ ι_X).base :=
              hSurj_iso.range_comp _
          _ = π₁.base ⁻¹' Set.range ι_X.base :=
              AlgebraicGeometry.Scheme.Pullback.range_fst π₁ ι_X
      have hz₁_range : z₁ ∈ Set.range ι_P.base := by
        rw [hRange_ιP]; change π₁.base z₁ ∈ Set.range ι_X.base
        have h1 : π₁.base z₁ = x := hz₁; rw [h1]; exact hx_range
      have hz₂_range : z₂ ∈ Set.range ι_P.base := by
        rw [hRange_ιP]; change π₁.base z₂ ∈ Set.range ι_X.base
        have h2 : π₁.base z₂ = x := hz₂; rw [h2]; exact hx_range
      obtain ⟨u₁, rfl⟩ := hz₁_range
      obtain ⟨u₂, rfl⟩ := hz₂_range
      have hu_eq : ι_X.base u₁ = ι_X.base u₂ := by
        rw [← hιP_π₁]
        change π₁.base (ι_P.base u₁) = π₁.base (ι_P.base u₂)
        have h1 : π₁.base (ι_P.base u₁) = x := hz₁
        have h2 : π₁.base (ι_P.base u₂) = x := hz₂
        exact h1.trans h2.symm
      exact congrArg ι_P.base (ι_X.isOpenEmbedding.injective hu_eq)
    exact ⟨P_tilde, j_P, π₁, π₂, ι_P, η_P, η_X, η_Y,
      hCl_jP, rfl, rfl, rfl, hInt_P, hProp_π₁, hProp_π₂, hπ_comm,
      hιP_π₁, hιP_π₂, hPb_inner, hDom_P, hηP_X, hηP_Y,
      by rw [← hη₀_ιP]; exact hPushFunc P_tilde hInt_P ι_P,
      hPushFunc X hIntX ι_X, hPushFunc Y hIntY ι_Y, hSub_range⟩

  
  have step_noeth : ∀ (R : Type u) [CommRing R],
      Set.Finite (Set.univ : Set (PrimeSpectrum R)) →
      ∀ (Z : AlgebraicGeometry.Scheme.{u}) [CompactSpace ↥Z]
        (g_Z : Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
        [AlgebraicGeometry.LocallyOfFiniteType g_Z],
        TopologicalSpace.NoetherianSpace ↥Z := by
    clear * -
    intro R _ hFinSpec Z _ g_Z _
    obtain ⟨s_cov, hs_fin, hs_iSup⟩ :=
      (AlgebraicGeometry.isCompact_iff_finite_and_eq_biUnion_affineOpens
        (U := (⊤ : Z.Opens))).mp isCompact_univ
    have : Finite ↥s_cov := hs_fin.to_subtype
    have : Finite (PrimeSpectrum R) := Set.finite_univ_iff.mp hFinSpec
    let ι_idx := ↥s_cov × PrimeSpectrum R
    let hAff_s : ∀ U : ↥s_cov, AlgebraicGeometry.IsAffineOpen U.1.1 := fun U => U.1.2
    let B_s : ↥s_cov → Type u := fun U => ↑(Z.presheaf.obj (Opposite.op U.1.1))
    let alg_hom_s : ∀ U : ↥s_cov, R →+* B_s U := fun U =>
      (AlgebraicGeometry.Spec.preimage ((hAff_s U).fromSpec ≫ g_Z)).hom
    let F_fib : ι_idx → Type u := fun idx =>
      letI : Algebra R (B_s idx.1) := (alg_hom_s idx.1).toAlgebra
      TensorProduct R idx.2.asIdeal.ResidueField (B_s idx.1)
    let Φ_fib : ∀ idx : ι_idx, PrimeSpectrum (F_fib idx) → ↥Z := fun idx r =>
      letI : Algebra R (B_s idx.1) := (alg_hom_s idx.1).toAlgebra
      (hAff_s idx.1).fromSpec.base
        (PrimeSpectrum.comap
          (Algebra.TensorProduct.includeRight (R := R)
            (A := idx.2.asIdeal.ResidueField) (B := B_s idx.1)).toRingHom r)
    have hNoeth_range : ∀ idx : ι_idx,
        TopologicalSpace.NoetherianSpace ↑(Set.range (Φ_fib idx)) := by
      intro idx
      let U := idx.1
      let P := idx.2
      have hU_aff : AlgebraicGeometry.IsAffineOpen U.1.1 := hAff_s U
      have hLft_mU : AlgebraicGeometry.LocallyOfFiniteType (hU_aff.fromSpec ≫ g_Z) := inferInstance
      have hFT_hom : (alg_hom_s U).FiniteType := by
        have hSpec_lft : AlgebraicGeometry.LocallyOfFiniteType
            (AlgebraicGeometry.Spec.map (AlgebraicGeometry.Spec.preimage (hU_aff.fromSpec ≫ g_Z))) := by
          rwa [AlgebraicGeometry.Spec.map_preimage]
        exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff
          (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp hSpec_lft
      let _ : Algebra R (B_s U) := (alg_hom_s U).toAlgebra
      have : Algebra.FiniteType R (B_s U) := hFT_hom
      have : Algebra.FiniteType P.asIdeal.ResidueField (F_fib idx) :=
        Algebra.FiniteType.baseChange P.asIdeal.ResidueField
      have : IsNoetherianRing (F_fib idx) :=
        Algebra.FiniteType.isNoetherianRing P.asIdeal.ResidueField (F_fib idx)
      have hCont_Φ : Continuous (Φ_fib idx) :=
        hU_aff.fromSpec.continuous.comp (PrimeSpectrum.continuous_comap _)
      exact TopologicalSpace.NoetherianSpace.range (Φ_fib idx) hCont_Φ
    have hUnion_univ : (⋃ idx : ι_idx, Set.range (Φ_fib idx)) = Set.univ := by
      ext z
      simp only [Set.mem_iUnion, Set.mem_range, Set.mem_univ, iff_true]
      have hz_top : z ∈ (⊤ : Z.Opens) := trivial
      rw [hs_iSup] at hz_top
      obtain ⟨U_aff, hz_biSup⟩ := TopologicalSpace.Opens.mem_iSup.mp hz_top
      obtain ⟨hU_mem, hz_U⟩ := TopologicalSpace.Opens.mem_iSup.mp hz_biSup
      let U : ↥s_cov := ⟨U_aff, hU_mem⟩
      have hU_aff : AlgebraicGeometry.IsAffineOpen U.1.1 := hAff_s U
      have hz_range : z ∈ Set.range hU_aff.fromSpec.base := by
        rw [AlgebraicGeometry.IsAffineOpen.range_fromSpec hU_aff]
        exact hz_U
      obtain ⟨q, rfl⟩ := hz_range
      let q_ps : PrimeSpectrum (B_s U) := q
      let _ : Algebra R (B_s U) := (alg_hom_s U).toAlgebra
      let P : PrimeSpectrum R := PrimeSpectrum.comap (algebraMap R (B_s U)) q_ps
      let κ_hom : P.asIdeal.ResidueField →ₐ[R] q_ps.asIdeal.ResidueField :=
        Ideal.ResidueField.mapₐ P.asIdeal q_ps.asIdeal (Algebra.ofId R (B_s U)) rfl
      let B_hom : B_s U →ₐ[R] q_ps.asIdeal.ResidueField :=
        IsScalarTower.toAlgHom R (B_s U) q_ps.asIdeal.ResidueField
      let ψ_q : F_fib (U, P) →ₐ[R] q_ps.asIdeal.ResidueField :=
        Algebra.TensorProduct.lift κ_hom B_hom (fun _ _ => Commute.all _ _)
      let r_q : PrimeSpectrum (F_fib (U, P)) :=
        PrimeSpectrum.comap ψ_q.toRingHom (⊥ : PrimeSpectrum q_ps.asIdeal.ResidueField)
      refine ⟨(U, P), r_q, congrArg (hAff_s U).fromSpec.base (PrimeSpectrum.ext ?_)⟩
      change Ideal.comap (ψ_q.toRingHom.comp Algebra.TensorProduct.includeRight.toRingHom) ⊥ =
        q_ps.asIdeal
      have hcomp_B : ψ_q.toRingHom.comp Algebra.TensorProduct.includeRight.toRingHom =
          algebraMap (B_s U) q_ps.asIdeal.ResidueField := by
        ext b
        change ψ_q (1 ⊗ₜ[R] b) = algebraMap (B_s U) q_ps.asIdeal.ResidueField b
        rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
        rfl
      rw [hcomp_B]
      change RingHom.ker (algebraMap (B_s U) q_ps.asIdeal.ResidueField) = q_ps.asIdeal
      exact Ideal.ker_algebraMap_residueField q_ps.asIdeal
    have hNoeth_univ : TopologicalSpace.NoetherianSpace ↑(Set.univ : Set ↥Z) := by
      rw [← hUnion_univ]
      exact @TopologicalSpace.NoetherianSpace.iUnion ↥Z _ ι_idx
        (fun idx => Set.range (Φ_fib idx)) inferInstance hNoeth_range
    exact TopologicalSpace.noetherian_univ_iff.mp hNoeth_univ

  
  have step_cover : ∀ (S₀ X₀ Y₀ P_tilde : AlgebraicGeometry.Scheme.{u})
      (f_X₀ : X₀ ⟶ S₀) (f_Y₀ : Y₀ ⟶ S₀)
      (j_P : P_tilde ⟶ CategoryTheory.Limits.pullback f_X₀ f_Y₀)
      [AlgebraicGeometry.IsClosedImmersion j_P]
      (π₁ : P_tilde ⟶ X₀) [AlgebraicGeometry.LocallyOfFiniteType π₁]
      (π₂ : P_tilde ⟶ Y₀),
      π₁ = j_P ≫ CategoryTheory.Limits.pullback.fst f_X₀ f_Y₀ →
      π₂ = j_P ≫ CategoryTheory.Limits.pullback.snd f_X₀ f_Y₀ →
      ∀ z : P_tilde,
        ∃ (U_X : X₀.Opens) (_ : AlgebraicGeometry.IsAffineOpen U_X)
          (U_Y : Y₀.Opens) (_ : AlgebraicGeometry.IsAffineOpen U_Y)
          (V_P : P_tilde.Opens) (_ : AlgebraicGeometry.IsAffineOpen V_P)
          (e_X : V_P ≤ (TopologicalSpace.Opens.map π₁.base).obj U_X)
          (e_Y : V_P ≤ (TopologicalSpace.Opens.map π₂.base).obj U_Y),
          z ∈ V_P ∧
          (π₁.appLE U_X V_P e_X).hom.FiniteType ∧
          Subring.closure
            (Set.range (π₂.appLE U_Y V_P e_Y).hom ∪
              Set.range (π₁.appLE U_X V_P e_X).hom) = ⊤ := by
    clear * -
    intro S_0 X Y P_tilde f_X f_Y j_P _ π₁ _ π₂ hπ₁ hπ₂ z
    let P_raw := CategoryTheory.Limits.pullback f_X f_Y
    let fst_raw := CategoryTheory.Limits.pullback.fst f_X f_Y
    let snd_raw := CategoryTheory.Limits.pullback.snd f_X f_Y
    let z_raw : ↥P_raw := j_P.base z
    let x₀ : ↥X := fst_raw.base z_raw
    let y₀ : ↥Y := snd_raw.base z_raw
    let s₀ : ↥S_0 := f_X.base x₀
    have hy₀_s₀ : f_Y.base y₀ = s₀ := by
      change (snd_raw ≫ f_Y).base z_raw = (fst_raw ≫ f_X).base z_raw
      rw [CategoryTheory.Limits.pullback.condition]
    obtain ⟨W_0, hW_0, hs₀_W0, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := ⊤) (x := s₀) trivial
    obtain ⟨U_X, hUX, hx₀_UX, hUX_W0⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
        (U := (TopologicalSpace.Opens.map f_X.base).obj W_0) (x := x₀) hs₀_W0
    obtain ⟨U_Y, hUY, hy₀_UY, hUY_W0⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
        (U := (TopologicalSpace.Opens.map f_Y.base).obj W_0) (x := y₀)
        (by change f_Y.base y₀ ∈ W_0; rwa [hy₀_s₀])
    let A_0 : Type u := ↑(S_0.presheaf.obj (Opposite.op W_0))
    let B_X : Type u := ↑(X.presheaf.obj (Opposite.op U_X))
    let B_Y : Type u := ↑(Y.presheaf.obj (Opposite.op U_Y))
    let _ : Algebra A_0 B_X := (f_X.appLE W_0 U_X hUX_W0).hom.toAlgebra
    let _ : Algebra A_0 B_Y := (f_Y.appLE W_0 U_Y hUY_W0).hom.toAlgebra
    let p₁ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A_0 B_X))
    let p₂ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A_0 B_Y))
    have he₁ : p₁ ≫ hW_0.fromSpec = hUX.fromSpec ≫ f_X :=
      AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec f_X hW_0 hUX hUX_W0
    have he₂ : p₂ ≫ hW_0.fromSpec = hUY.fromSpec ≫ f_Y :=
      AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec f_Y hW_0 hUY hUY_W0
    let ι_Q : CategoryTheory.Limits.pullback p₁ p₂ ⟶ P_raw :=
      CategoryTheory.Limits.pullback.map p₁ p₂ f_X f_Y
        hUX.fromSpec hUY.fromSpec hW_0.fromSpec he₁ he₂
    have : AlgebraicGeometry.IsOpenImmersion ι_Q :=
      AlgebraicGeometry.Scheme.pullback_map_isOpenImmersion
        p₁ p₂ f_X f_Y hUX.fromSpec hUY.fromSpec hW_0.fromSpec he₁ he₂
    let T_prod : Type u := TensorProduct A_0 B_X B_Y
    let e_spec : AlgebraicGeometry.Spec (CommRingCat.of T_prod) ⟶ P_raw :=
      (AlgebraicGeometry.pullbackSpecIso A_0 B_X B_Y).inv ≫ ι_Q
    let W_prod : P_raw.Opens := (e_spec.opensFunctor).obj ⊤
    have hWprod : AlgebraicGeometry.IsAffineOpen W_prod :=
      (AlgebraicGeometry.isAffineOpen_top _).image_of_isOpenImmersion e_spec
    have hSurj_pb : Function.Surjective (AlgebraicGeometry.pullbackSpecIso A_0 B_X B_Y).inv.base :=
      fun q => ⟨(AlgebraicGeometry.pullbackSpecIso A_0 B_X B_Y).hom.base q, by
        change ((AlgebraicGeometry.pullbackSpecIso A_0 B_X B_Y).hom ≫
          (AlgebraicGeometry.pullbackSpecIso A_0 B_X B_Y).inv).base q = q
        rw [CategoryTheory.Iso.hom_inv_id]; rfl⟩
    have hWprod_range : (W_prod : Set ↥P_raw) = Set.range e_spec.base := by
      change e_spec.base '' Set.univ = Set.range e_spec.base
      exact Set.image_univ
    have hWprod_carrier : (W_prod : Set ↥P_raw) =
        fst_raw.base ⁻¹' (U_X : Set ↥X) ∩ snd_raw.base ⁻¹' (U_Y : Set ↥Y) := by
      rw [hWprod_range]
      change Set.range (ι_Q.base ∘ (AlgebraicGeometry.pullbackSpecIso A_0 B_X B_Y).inv.base) = _
      rw [hSurj_pb.range_comp]
      rw [AlgebraicGeometry.Scheme.Pullback.range_map
        p₁ p₂ f_X f_Y hUX.fromSpec hUY.fromSpec hW_0.fromSpec he₁ he₂]
      rw [AlgebraicGeometry.IsAffineOpen.range_fromSpec hUX,
        AlgebraicGeometry.IsAffineOpen.range_fromSpec hUY]
    have hz_Wprod : z_raw ∈ W_prod := by
      change z_raw ∈ (W_prod : Set ↥P_raw)
      rw [hWprod_carrier]
      exact ⟨hx₀_UX, hy₀_UY⟩
    have e_WX : W_prod ≤ (TopologicalSpace.Opens.map fst_raw.base).obj U_X := by
      intro w hw
      have hw' : w ∈ (W_prod : Set ↥P_raw) := hw
      rw [hWprod_carrier] at hw'
      exact hw'.1
    have e_WY : W_prod ≤ (TopologicalSpace.Opens.map snd_raw.base).obj U_Y := by
      intro w hw
      have hw' : w ∈ (W_prod : Set ↥P_raw) := hw
      rw [hWprod_carrier] at hw'
      exact hw'.2
    let V_P : P_tilde.Opens := (TopologicalSpace.Opens.map j_P.base).obj W_prod
    have hVP : AlgebraicGeometry.IsAffineOpen V_P := hWprod.preimage j_P
    have hz_VP : z ∈ V_P := hz_Wprod
    have e_X : V_P ≤ (TopologicalSpace.Opens.map π₁.base).obj U_X := by
      rw [hπ₁]; exact fun w hw => e_WX hw
    have e_Y : V_P ≤ (TopologicalSpace.Opens.map π₂.base).obj U_Y := by
      rw [hπ₂]; exact fun w hw => e_WY hw
    have hFT_π₁ : (π₁.appLE U_X V_P e_X).hom.FiniteType :=
      AlgebraicGeometry.Scheme.Hom.finiteType_appLE π₁ hUX hVP e_X
    have he_spec_range : Set.range e_spec.base ⊆ Set.range hWprod.fromSpec.base := by
      rw [AlgebraicGeometry.IsAffineOpen.range_fromSpec hWprod, hWprod_range]
    let ℓ := AlgebraicGeometry.IsOpenImmersion.lift hWprod.fromSpec e_spec he_spec_range
    have hℓ_fac : ℓ ≫ hWprod.fromSpec = e_spec :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac hWprod.fromSpec e_spec he_spec_range
    have hℓ_top : ℓ.opensRange = ⊤ := by
      ext q
      simp only [TopologicalSpace.Opens.coe_top, Set.mem_univ, iff_true]
      have hq_mem : hWprod.fromSpec.base q ∈ Set.range e_spec.base := by
        rw [← hWprod_range, ← AlgebraicGeometry.IsAffineOpen.range_fromSpec hWprod]
        exact ⟨q, rfl⟩
      obtain ⟨t, ht⟩ := hq_mem
      refine ⟨t, hWprod.fromSpec.isOpenEmbedding.injective ?_⟩
      change (ℓ ≫ hWprod.fromSpec).base t = hWprod.fromSpec.base q
      rw [hℓ_fac]; exact ht
    have : CategoryTheory.IsIso ℓ :=
      AlgebraicGeometry.isIso_of_isOpenImmersion_of_opensRange_eq_top ℓ hℓ_top
    let θ : P_raw.presheaf.obj (Opposite.op W_prod) ⟶ CommRingCat.of T_prod :=
      AlgebraicGeometry.Spec.preimage ℓ
    let θ_inv : CommRingCat.of T_prod ⟶ P_raw.presheaf.obj (Opposite.op W_prod) :=
      AlgebraicGeometry.Spec.preimage (CategoryTheory.inv ℓ)
    have hθ_id1 : θ ≫ θ_inv = 𝟙 _ := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        AlgebraicGeometry.Spec.map_preimage, CategoryTheory.IsIso.inv_hom_id,
        AlgebraicGeometry.Spec.map_id]
    have hιQ_fst : ι_Q ≫ fst_raw = CategoryTheory.Limits.pullback.fst p₁ p₂ ≫ hUX.fromSpec := by
      simp only [ι_Q, fst_raw, CategoryTheory.Limits.pullback.map,
        CategoryTheory.Limits.pullback.lift_fst]
    have hιQ_snd : ι_Q ≫ snd_raw = CategoryTheory.Limits.pullback.snd p₁ p₂ ≫ hUY.fromSpec := by
      simp only [ι_Q, snd_raw, CategoryTheory.Limits.pullback.map,
        CategoryTheory.Limits.pullback.lift_snd]
    have hfst_θ :
        CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom : B_X →+* T_prod) ≫ θ_inv =
          fst_raw.appLE U_X W_prod e_WX := by
      have hSpec_eq :
          AlgebraicGeometry.Spec.map (fst_raw.appLE U_X W_prod e_WX ≫ θ) ≫ hUX.fromSpec =
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom : B_X →+* T_prod)) ≫
              hUX.fromSpec := by
        calc
          AlgebraicGeometry.Spec.map (fst_raw.appLE U_X W_prod e_WX ≫ θ) ≫ hUX.fromSpec
            = AlgebraicGeometry.Spec.map θ ≫
                (AlgebraicGeometry.Spec.map (fst_raw.appLE U_X W_prod e_WX) ≫ hUX.fromSpec) := by
              simp only [AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc]
          _ = ℓ ≫ (hWprod.fromSpec ≫ fst_raw) := by
              rw [AlgebraicGeometry.Spec.map_preimage,
                AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec fst_raw hUX hWprod e_WX]
          _ = e_spec ≫ fst_raw := by rw [← CategoryTheory.Category.assoc, hℓ_fac]
          _ = (AlgebraicGeometry.pullbackSpecIso A_0 B_X B_Y).inv ≫ (ι_Q ≫ fst_raw) := by
              simp only [e_spec, CategoryTheory.Category.assoc]
          _ = ((AlgebraicGeometry.pullbackSpecIso A_0 B_X B_Y).inv ≫
                CategoryTheory.Limits.pullback.fst p₁ p₂) ≫ hUX.fromSpec := by
              rw [hιQ_fst, CategoryTheory.Category.assoc]
          _ = AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom : B_X →+* T_prod)) ≫
                hUX.fromSpec := by
              rw [AlgebraicGeometry.pullbackSpecIso_inv_fst]
      have hpre := AlgebraicGeometry.Spec.map_injective ((cancel_mono hUX.fromSpec).mp hSpec_eq)
      calc
        CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom ≫ θ_inv
          = (fst_raw.appLE U_X W_prod e_WX ≫ θ) ≫ θ_inv := by rw [hpre]
        _ = fst_raw.appLE U_X W_prod e_WX := by
            rw [CategoryTheory.Category.assoc, hθ_id1, CategoryTheory.Category.comp_id]
    have hsnd_θ :
        CommRingCat.ofHom (↑(Algebra.TensorProduct.includeRight : B_Y →ₐ[A_0] T_prod) :
          B_Y →+* T_prod) ≫ θ_inv =
          snd_raw.appLE U_Y W_prod e_WY := by
      have hSpec_eq :
          AlgebraicGeometry.Spec.map (snd_raw.appLE U_Y W_prod e_WY ≫ θ) ≫ hUY.fromSpec =
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (↑(Algebra.TensorProduct.includeRight : B_Y →ₐ[A_0] T_prod) :
                B_Y →+* T_prod)) ≫ hUY.fromSpec := by
        calc
          AlgebraicGeometry.Spec.map (snd_raw.appLE U_Y W_prod e_WY ≫ θ) ≫ hUY.fromSpec
            = AlgebraicGeometry.Spec.map θ ≫
                (AlgebraicGeometry.Spec.map (snd_raw.appLE U_Y W_prod e_WY) ≫ hUY.fromSpec) := by
              simp only [AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc]
          _ = ℓ ≫ (hWprod.fromSpec ≫ snd_raw) := by
              rw [AlgebraicGeometry.Spec.map_preimage,
                AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec snd_raw hUY hWprod e_WY]
          _ = e_spec ≫ snd_raw := by rw [← CategoryTheory.Category.assoc, hℓ_fac]
          _ = (AlgebraicGeometry.pullbackSpecIso A_0 B_X B_Y).inv ≫ (ι_Q ≫ snd_raw) := by
              simp only [e_spec, CategoryTheory.Category.assoc]
          _ = ((AlgebraicGeometry.pullbackSpecIso A_0 B_X B_Y).inv ≫
                CategoryTheory.Limits.pullback.snd p₁ p₂) ≫ hUY.fromSpec := by
              rw [hιQ_snd, CategoryTheory.Category.assoc]
          _ = AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (↑(Algebra.TensorProduct.includeRight : B_Y →ₐ[A_0] T_prod) :
                  B_Y →+* T_prod)) ≫ hUY.fromSpec := by
              rw [AlgebraicGeometry.pullbackSpecIso_inv_snd]
      have hpre := AlgebraicGeometry.Spec.map_injective ((cancel_mono hUY.fromSpec).mp hSpec_eq)
      calc
        CommRingCat.ofHom (↑(Algebra.TensorProduct.includeRight : B_Y →ₐ[A_0] T_prod)) ≫ θ_inv
          = (snd_raw.appLE U_Y W_prod e_WY ≫ θ) ≫ θ_inv := by rw [hpre]
        _ = snd_raw.appLE U_Y W_prod e_WY := by
            rw [CategoryTheory.Category.assoc, hθ_id1, CategoryTheory.Category.comp_id]
    let q_hom : CommRingCat.of T_prod ⟶ P_tilde.presheaf.obj (Opposite.op V_P) :=
      θ_inv ≫ j_P.app W_prod
    have hSurj_θinv : Function.Surjective θ_inv.hom := fun w =>
      ⟨θ.hom w, by change (θ ≫ θ_inv).hom w = w; rw [hθ_id1]; rfl⟩
    have hSurj_q : Function.Surjective q_hom.hom :=
      (AlgebraicGeometry.Scheme.Hom.app_surjective j_P W_prod hWprod).comp hSurj_θinv
    have hq_left : ∀ b_X : B_X,
        q_hom.hom (Algebra.TensorProduct.includeLeftRingHom b_X) =
          (π₁.appLE U_X V_P e_X).hom b_X := by
      intro b_X
      have hcomp :
          CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom : B_X →+* T_prod) ≫ q_hom =
            π₁.appLE U_X V_P e_X := by
        calc
          CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom ≫ (θ_inv ≫ j_P.app W_prod)
            = (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom ≫ θ_inv) ≫
                j_P.app W_prod := by rw [← CategoryTheory.Category.assoc]
          _ = fst_raw.appLE U_X W_prod e_WX ≫ j_P.appLE W_prod V_P le_rfl := by
              rw [hfst_θ, AlgebraicGeometry.Scheme.Hom.app_eq_appLE]
          _ = (j_P ≫ fst_raw).appLE U_X V_P (fun w hw => e_WX hw) :=
              AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE j_P fst_raw U_X W_prod V_P e_WX le_rfl
          _ = π₁.appLE U_X V_P e_X := by subst hπ₁; rfl
      exact congrArg (fun f => f.hom b_X) hcomp
    have hq_right : ∀ b_Y : B_Y,
        q_hom.hom (Algebra.TensorProduct.includeRight b_Y) =
          (π₂.appLE U_Y V_P e_Y).hom b_Y := by
      intro b_Y
      have hcomp :
          CommRingCat.ofHom (↑(Algebra.TensorProduct.includeRight : B_Y →ₐ[A_0] T_prod) :
            B_Y →+* T_prod) ≫ q_hom =
            π₂.appLE U_Y V_P e_Y := by
        calc
          CommRingCat.ofHom (↑(Algebra.TensorProduct.includeRight : B_Y →ₐ[A_0] T_prod)) ≫
              (θ_inv ≫ j_P.app W_prod)
            = (CommRingCat.ofHom (↑(Algebra.TensorProduct.includeRight : B_Y →ₐ[A_0] T_prod)) ≫
                θ_inv) ≫ j_P.app W_prod := by rw [← CategoryTheory.Category.assoc]
          _ = snd_raw.appLE U_Y W_prod e_WY ≫ j_P.appLE W_prod V_P le_rfl := by
              rw [hsnd_θ, AlgebraicGeometry.Scheme.Hom.app_eq_appLE]
          _ = (j_P ≫ snd_raw).appLE U_Y V_P (fun w hw => e_WY hw) :=
              AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE j_P snd_raw U_Y W_prod V_P e_WY le_rfl
          _ = π₂.appLE U_Y V_P e_Y := by subst hπ₂; rfl
      exact congrArg (fun f => f.hom b_Y) hcomp
    refine ⟨U_X, hUX, U_Y, hUY, V_P, hVP, e_X, e_Y, hz_VP, hFT_π₁, ?_⟩
    rw [eq_top_iff]
    rintro w -
    obtain ⟨t, rfl⟩ := hSurj_q w
    induction t using TensorProduct.induction_on with
    | zero =>
      rw [map_zero]
      exact Subring.zero_mem _
    | tmul b_X b_Y =>
      have htmul : (b_X ⊗ₜ[A_0] b_Y : T_prod) =
          Algebra.TensorProduct.includeLeftRingHom b_X *
            Algebra.TensorProduct.includeRight b_Y := by
        change b_X ⊗ₜ[A_0] b_Y = (b_X ⊗ₜ[A_0] (1 : B_Y)) * ((1 : B_X) ⊗ₜ[A_0] b_Y)
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      rw [htmul, map_mul, hq_left, hq_right]
      exact Subring.mul_mem _
        (Subring.subset_closure (Or.inr ⟨b_X, rfl⟩))
        (Subring.subset_closure (Or.inl ⟨b_Y, rfl⟩))
    | add t₁ t₂ ih₁ ih₂ =>
      rw [map_add]
      exact Subring.add_mem _ ih₁ ih₂

  
  
  
  let η_V : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of ↥V) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)
  let U_0K : C_K.Opens := (TopologicalSpace.Opens.map ι'.base).obj U_0

  have hIrredCK : IrreducibleSpace ↥C_K :=
    @AlgebraicGeometry.irreducibleSpace_of_isIntegral C_K hIntCK
  have : PreirreducibleSpace ↥C_K := hIrredCK.toPreirreducibleSpace
  have hIrredC' : IrreducibleSpace ↥C' :=
    @AlgebraicGeometry.irreducibleSpace_of_isIntegral C' hMod'.1
  have : PreirreducibleSpace ↥C' := hIrredC'.toPreirreducibleSpace
  have : AlgebraicGeometry.IsOpenImmersion ι' :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (P := @AlgebraicGeometry.IsOpenImmersion) hMod'.2.2.2.2.2.2.2.1.flip hOpenη
  have hUK_ne : Nonempty ↥U_0K := by
    obtain ⟨xK⟩ := hIrredCK.toNonempty
    obtain ⟨⟨u0, hu0⟩⟩ := id hU_0
    obtain ⟨y, hyU, ⟨x0, rfl⟩⟩ :=
      nonempty_preirreducible_inter U_0.2 ι'.isOpenEmbedding.isOpen_range
        ⟨u0, hu0⟩ ⟨ι'.base xK, xK, rfl⟩
    exact ⟨⟨x0, hyU⟩⟩
  have hIntUK : AlgebraicGeometry.IsIntegral U_0K.toScheme :=
    @AlgebraicGeometry.isIntegral_of_isOpenImmersion _ _ U_0K.ι inferInstance hIntCK hUK_ne
  obtain ⟨⟨x₀_K, hx₀_UK⟩⟩ := id hUK_ne

  obtain ⟨U_base, hUb, V_K, hVK, hx₀_VK, e_VK, hStd⟩ :=
    (AlgebraicGeometry.smoothOfRelativeDimension_iff 1 p_K).mp hSmCK x₀_K
  have hDomBK : IsDomain ↑(C_K.presheaf.obj (Opposite.op V_K)) :=
    @AlgebraicGeometry.IsIntegral.component_integral C_K hIntCK V_K ⟨⟨x₀_K, hx₀_VK⟩⟩
  let B_K : Type u := ↑(C_K.presheaf.obj (Opposite.op V_K))
  let F : Type u := FractionRing B_K
  let ι_frac : C_K.presheaf.obj (Opposite.op V_K) ⟶ CommRingCat.of F :=
    CommRingCat.ofHom (algebraMap B_K F)
  let η_CK : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ C_K :=
    AlgebraicGeometry.Spec.map ι_frac ≫ hVK.fromSpec
  let φ_KF : K →+* F := (AlgebraicGeometry.Spec.preimage (η_CK ≫ p_K)).hom
  have hη_pK : η_CK ≫ p_K = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_KF) :=
    (AlgebraicGeometry.Spec.map_preimage (η_CK ≫ p_K)).symm

  have hFuncCK : IsSchemeFunctionField C_K F η_CK :=
    step_funcCK C_K hIntCK V_K hVK x₀_K hx₀_VK hDomBK
  obtain ⟨φ_VK_0, hFrac_VK_0, hφ_VK_0⟩ := hFuncCK V_K hVK ⟨⟨x₀_K, hx₀_VK⟩⟩
  have hEssTr : (letI : Algebra K F := φ_KF.toAlgebra
      Algebra.EssFiniteType K F ∧ Algebra.trdeg K F ≤ 1) :=
    step_essTr K C_K p_K hIntCK x₀_K U_base hUb V_K hVK hx₀_VK e_VK hStd
      F φ_VK_0 hFrac_VK_0 φ_KF (by rw [hφ_VK_0, hη_pK])

  have hηCK_range : Set.range η_CK.base ⊆ Set.range U_0K.ι.base := by
    rw [AlgebraicGeometry.Scheme.Opens.range_ι]
    rintro _ ⟨pt, rfl⟩
    let pt_F : ↥(AlgebraicGeometry.Spec (CommRingCat.of F)) := ⟨⊥, inferInstance⟩
    have hpt : pt = pt_F := Subsingleton.elim pt pt_F
    rw [hpt]
    let pt_BK : ↥(AlgebraicGeometry.Spec (C_K.presheaf.obj (Opposite.op V_K))) :=
      ⟨⊥, inferInstance⟩
    have hbot_eq : (AlgebraicGeometry.Spec.map ι_frac).base pt_F = pt_BK := by
      apply PrimeSpectrum.ext
      rw [AlgebraicGeometry.Spec.map_apply]
      ext b
      change algebraMap B_K F b ∈ (⊥ : Ideal F) ↔ b ∈ (⊥ : Ideal B_K)
      simp only [Ideal.mem_bot]
      exact ⟨fun hb => (IsFractionRing.injective B_K F) (hb.trans (map_zero _).symm),
        fun hb => by rw [hb, map_zero]⟩
    change hVK.fromSpec.base ((AlgebraicGeometry.Spec.map ι_frac).base pt_F) ∈ (U_0K : Set C_K)
    rw [hbot_eq]
    obtain ⟨w, hw_UK, hw_VK⟩ :=
      nonempty_preirreducible_inter U_0K.2 V_K.2 ⟨x₀_K, hx₀_UK⟩ ⟨x₀_K, hx₀_VK⟩
    have hw_range : w ∈ Set.range hVK.fromSpec.base := by
      rwa [AlgebraicGeometry.IsAffineOpen.range_fromSpec]
    obtain ⟨q, rfl⟩ := hw_range
    let O : Set ↥(AlgebraicGeometry.Spec (C_K.presheaf.obj (Opposite.op V_K))) :=
      hVK.fromSpec.base ⁻¹' (U_0K : Set C_K)
    have hO_open : IsOpen O := U_0K.2.preimage hVK.fromSpec.continuous
    let bot_BK : PrimeSpectrum B_K := ⊥
    let q_BK : PrimeSpectrum B_K := q
    have hspec : bot_BK ⤳ q_BK :=
      (PrimeSpectrum.le_iff_specializes bot_BK q_BK).mp bot_le
    exact hspec.mem_open hO_open hw_UK

  let η_UK : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ U_0K.toScheme :=
    AlgebraicGeometry.IsOpenImmersion.lift U_0K.ι η_CK hηCK_range
  have hηUK_fac : η_UK ≫ U_0K.ι = η_CK :=
    AlgebraicGeometry.IsOpenImmersion.lift_fac U_0K.ι η_CK hηCK_range

  have hFuncUK : IsSchemeFunctionField U_0K.toScheme F η_UK := by
    intro W hW hWne
    let W' : C_K.Opens := (U_0K.ι.opensFunctor).obj W
    have hW'_aff : AlgebraicGeometry.IsAffineOpen W' :=
      hW.image_of_isOpenImmersion U_0K.ι
    obtain ⟨⟨w₀, hw₀⟩⟩ := id hWne
    have hW'_ne : Nonempty ↥W' := ⟨⟨U_0K.ι.base w₀, ⟨w₀, hw₀, rfl⟩⟩⟩
    obtain ⟨φ_W', hFrac_W', hφ_W'⟩ := hFuncCK W' hW'_aff hW'_ne
    have hW'_le : W' ≤ U_0K.ι.opensRange := by rintro _ ⟨w, _, rfl⟩; exact ⟨w, rfl⟩
    have : CategoryTheory.IsIso (U_0K.ι.app W') :=
      AlgebraicGeometry.Scheme.Hom.isIso_app U_0K.ι W' hW'_le
    have hpre_eq : (TopologicalSpace.Opens.map U_0K.ι.base).obj W' = W := by
      ext u
      change U_0K.ι.base u ∈ U_0K.ι.base '' (W : Set ↥U_0K.toScheme) ↔ u ∈ W
      exact ⟨fun ⟨u', hu', heq⟩ => U_0K.ι.isOpenEmbedding.injective heq ▸ hu',
        fun hu => ⟨u, hu, rfl⟩⟩
    have he_W : W ≤ (TopologicalSpace.Opens.map U_0K.ι.base).obj W' := hpre_eq.symm.le
    let e_res : U_0K.toScheme.presheaf.obj
        (Opposite.op ((TopologicalSpace.Opens.map U_0K.ι.base).obj W')) ≅
        U_0K.toScheme.presheaf.obj (Opposite.op W) :=
      { hom := U_0K.toScheme.presheaf.map (CategoryTheory.homOfLE he_W).op
        inv := U_0K.toScheme.presheaf.map (CategoryTheory.homOfLE hpre_eq.le).op
        hom_inv_id := by
          rw [← U_0K.toScheme.presheaf.map_comp]
          exact U_0K.toScheme.presheaf.map_id _
        inv_hom_id := by
          rw [← U_0K.toScheme.presheaf.map_comp]
          exact U_0K.toScheme.presheaf.map_id _ }
    let e_app : C_K.presheaf.obj (Opposite.op W') ≅ U_0K.toScheme.presheaf.obj (Opposite.op W) :=
      CategoryTheory.asIso (U_0K.ι.app W') ≪≫ e_res
    have he_app_hom : e_app.hom = U_0K.ι.appLE W' W he_W := rfl
    let φ_W : U_0K.toScheme.presheaf.obj (Opposite.op W) ⟶ CommRingCat.of F :=
      e_app.inv ≫ φ_W'
    refine ⟨φ_W, ?_, ?_⟩
    · let eqv := e_app.symm.commRingCatIsoToRingEquiv
      have : IsDomain ↑(U_0K.toScheme.presheaf.obj (Opposite.op W)) :=
        @AlgebraicGeometry.IsIntegral.component_integral U_0K.toScheme hIntUK W hWne
      have hInj : Function.Injective φ_W.hom := by
        let _ : Algebra ↑(C_K.presheaf.obj (Opposite.op W')) F := φ_W'.hom.toAlgebra
        exact (@IsFractionRing.injective _ _ F _ _ hFrac_W').comp eqv.injective
      let _ : Algebra ↑(U_0K.toScheme.presheaf.obj (Opposite.op W)) F := φ_W.hom.toAlgebra
      refine
        { map_units := fun y => IsUnit.mk0 (φ_W.hom y.1) (fun h0 =>
            nonZeroDivisors.ne_zero y.2 (hInj (h0.trans φ_W.hom.map_zero.symm)))
          surj := fun f => ?_
          exists_of_eq := fun {x y} hxy => ⟨1, by simp [hInj hxy]⟩ }
      let _ : Algebra ↑(C_K.presheaf.obj (Opposite.op W')) F := φ_W'.hom.toAlgebra
      obtain ⟨⟨b₁, b₂⟩, hf_eq⟩ := @IsLocalization.surj _ _ _ F _ _ hFrac_W' f
      have hb₂_ne : eqv.symm b₂.1 ≠ 0 := fun h0 =>
        nonZeroDivisors.ne_zero b₂.2 (eqv.symm.injective (h0.trans eqv.symm.map_zero.symm))
      refine ⟨⟨eqv.symm b₁, ⟨eqv.symm b₂.1, mem_nonZeroDivisors_of_ne_zero hb₂_ne⟩⟩, ?_⟩
      change f * (e_app.hom ≫ e_app.inv ≫ φ_W').hom b₂.1 =
        (e_app.hom ≫ e_app.inv ≫ φ_W').hom b₁
      rw [e_app.hom_inv_id_assoc]; exact hf_eq
    · apply (cancel_mono U_0K.ι).mp
      calc
        (AlgebraicGeometry.Spec.map φ_W ≫ hW.fromSpec) ≫ U_0K.ι
          = AlgebraicGeometry.Spec.map φ_W' ≫
              AlgebraicGeometry.Spec.map e_app.inv ≫ (hW.fromSpec ≫ U_0K.ι) := by
            simp only [φ_W, AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc]
        _ = AlgebraicGeometry.Spec.map φ_W' ≫
              AlgebraicGeometry.Spec.map e_app.inv ≫
              (AlgebraicGeometry.Spec.map (U_0K.ι.appLE W' W he_W) ≫ hW'_aff.fromSpec) := by
            rw [AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec U_0K.ι hW'_aff hW he_W]
        _ = AlgebraicGeometry.Spec.map φ_W' ≫
              (AlgebraicGeometry.Spec.map e_app.inv ≫ AlgebraicGeometry.Spec.map e_app.hom) ≫
              hW'_aff.fromSpec := by
            rw [← he_app_hom, CategoryTheory.Category.assoc]
        _ = AlgebraicGeometry.Spec.map φ_W' ≫
              AlgebraicGeometry.Spec.map (e_app.hom ≫ e_app.inv) ≫ hW'_aff.fromSpec := by
            rw [← AlgebraicGeometry.Spec.map_comp]
        _ = AlgebraicGeometry.Spec.map φ_W' ≫ hW'_aff.fromSpec := by
            rw [e_app.hom_inv_id, AlgebraicGeometry.Spec.map_id, CategoryTheory.Category.id_comp]
        _ = η_CK := hφ_W'
        _ = η_UK ≫ U_0K.ι := hηUK_fac.symm

  have : AlgebraicGeometry.IsOpenImmersion ι_X :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (P := @AlgebraicGeometry.IsOpenImmersion) hPb_X.flip hOpenη
  have : AlgebraicGeometry.IsOpenImmersion ι_Y :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (P := @AlgebraicGeometry.IsOpenImmersion) hPb_Y.flip hOpenη
  have hι_comm : ι_X ≫ f_X = ι_Y ≫ f_Y := hιX_fX.trans hιY_fY.symm

  have hPb_Δ : CategoryTheory.IsPullback
      (CategoryTheory.Limits.pullback.lift ι_X ι_Y hι_comm)
      (𝟙 U_0K.toScheme) (CategoryTheory.Limits.pullback.fst f_X f_Y) ι_X := by
    let Δ_K := CategoryTheory.Limits.pullback.lift ι_X ι_Y hι_comm
    let fst_raw := CategoryTheory.Limits.pullback.fst f_X f_Y
    let snd_raw := CategoryTheory.Limits.pullback.snd f_X f_Y
    have hw : Δ_K ≫ fst_raw = 𝟙 U_0K.toScheme ≫ ι_X := by
      rw [CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.id_comp]
    let cone_Δ := CategoryTheory.Limits.PullbackCone.mk Δ_K (𝟙 U_0K.toScheme) hw
    refine CategoryTheory.IsPullback.of_isLimit (c := cone_Δ)
      (CategoryTheory.Limits.PullbackCone.IsLimit.mk hw
        (fun s => s.snd)
        (fun s => ?_)
        (fun s => CategoryTheory.Category.comp_id s.snd)
        (fun s m _ hm₂ => (CategoryTheory.Category.comp_id m).symm.trans hm₂))
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst, s.condition]
    · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd]
      have hcomm_Y : (s.fst ≫ snd_raw) ≫ g_Y = (s.snd ≫ U_0K.ι ≫ p_K) ≫ η_V := by
        calc
          (s.fst ≫ snd_raw) ≫ g_Y
            = s.fst ≫ (snd_raw ≫ f_Y) ≫ (U_0.ι ≫ g') := by
              rw [← hfY_g]; simp only [CategoryTheory.Category.assoc]
          _ = s.fst ≫ (fst_raw ≫ f_X) ≫ (U_0.ι ≫ g') := by
              rw [CategoryTheory.Limits.pullback.condition]
          _ = (s.fst ≫ fst_raw) ≫ (f_X ≫ U_0.ι ≫ g') := by
              simp only [CategoryTheory.Category.assoc]
          _ = (s.snd ≫ ι_X) ≫ g_X := by rw [s.condition, hfX_g]
          _ = s.snd ≫ (ι_X ≫ g_X) := by rw [CategoryTheory.Category.assoc]
          _ = (s.snd ≫ U_0K.ι ≫ p_K) ≫ η_V := by
              rw [hPb_X.w]; simp only [CategoryTheory.Category.assoc, U_0K, η_V]
      let l : s.pt ⟶ U_0K.toScheme :=
        hPb_Y.lift (s.fst ≫ snd_raw) (s.snd ≫ U_0K.ι ≫ p_K) hcomm_Y
      have hl_eq : l = s.snd := by
        apply hPb_U0.hom_ext
        · calc
            l ≫ ι_U0 = l ≫ (ι_Y ≫ f_Y) := by rw [hιY_fY]
            _ = (l ≫ ι_Y) ≫ f_Y := by rw [← CategoryTheory.Category.assoc]
            _ = s.fst ≫ (snd_raw ≫ f_Y) := by
                rw [hPb_Y.lift_fst, CategoryTheory.Category.assoc]
            _ = s.fst ≫ (fst_raw ≫ f_X) := by
                rw [CategoryTheory.Limits.pullback.condition]
            _ = (s.fst ≫ fst_raw) ≫ f_X := by rw [← CategoryTheory.Category.assoc]
            _ = (s.snd ≫ ι_X) ≫ f_X := by rw [s.condition]
            _ = s.snd ≫ ι_U0 := by rw [CategoryTheory.Category.assoc, hιX_fX]
        · exact hPb_Y.lift_snd _ _ _
      calc
        s.snd ≫ ι_Y = l ≫ ι_Y := by rw [hl_eq]
        _ = s.fst ≫ snd_raw := hPb_Y.lift_fst _ _ _

  obtain ⟨P_tilde, j_P, π₁, π₂, ι_P, η_P, η_X, η_Y,
      hCl_jP, hπ₁_eq, hπ₂_eq, hηX_eq, hInt_P, hProp_π₁, hProp_π₂, hπ_comm,
      hιP_π₁, hιP_π₂, hPb_inner, hDom_P, hηP_X, hηP_Y,
      hFunc_P, hFunc_X, hFunc_Y, hSub_range⟩ :=
    step_graph U_0K.toScheme U_0.toScheme X Y hUK_ne hIntUK hIntX hIntY
      f_X f_Y ι_X ι_Y hι_comm hPb_Δ F η_UK hFuncUK

  have hPb_P : CategoryTheory.IsPullback ι_P (U_0K.ι ≫ p_K) (π₁ ≫ g_X) η_V := by
    simpa only [CategoryTheory.Category.id_comp] using hPb_inner.paste_vert hPb_X

  have hφ_V : ∀ c : ↥V,
      φ_KF (V.subtype c) = (AlgebraicGeometry.Spec.preimage (η_X ≫ g_X)).hom c := by
    intro c
    have hSpec_eq : η_X ≫ g_X =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_KF.comp V.subtype)) := by
      calc
        η_X ≫ g_X = η_UK ≫ (ι_X ≫ g_X) := by rw [hηX_eq, CategoryTheory.Category.assoc]
        _ = η_UK ≫ (U_0K.ι ≫ p_K) ≫ η_V := by rw [hPb_X.w]
        _ = ((η_UK ≫ U_0K.ι) ≫ p_K) ≫ η_V := by simp only [CategoryTheory.Category.assoc]
        _ = (η_CK ≫ p_K) ≫ η_V := by rw [hηUK_fac]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_KF) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype) := by rw [hη_pK]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_KF.comp V.subtype)) := by
              rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    rw [hSpec_eq, AlgebraicGeometry.Spec.preimage_map]
    rfl

  have hGenSub : ∀ x : X, (g_X.base x).asIdeal = ⊥ → Set.Subsingleton (π₁.base ⁻¹' {x}) := by
    intro x hx_bot
    apply hSub_range x
    let pt_K : ↥(AlgebraicGeometry.Spec (CommRingCat.of K)) := ⟨⊥, inferInstance⟩
    have hx_mem_ηV : g_X.base x ∈ Set.range η_V.base := by
      refine ⟨pt_K, PrimeSpectrum.ext ?_⟩
      rw [AlgebraicGeometry.Spec.map_apply, hx_bot]
      ext c
      change V.subtype c ∈ (⊥ : Ideal K) ↔ c ∈ (⊥ : Ideal ↥V)
      simp only [Ideal.mem_bot, ValuationSubring.subtype_apply, ZeroMemClass.coe_eq_zero]
    have hSurj_isoX : Function.Surjective hPb_X.isoPullback.hom.base := fun q =>
      ⟨hPb_X.isoPullback.inv.base q, by
        change (hPb_X.isoPullback.inv ≫ hPb_X.isoPullback.hom).base q = q
        rw [CategoryTheory.Iso.inv_hom_id]; rfl⟩
    have hRange_ιX : Set.range ι_X.base = g_X.base ⁻¹' Set.range η_V.base := by
      calc
        Set.range ι_X.base
          = Set.range (hPb_X.isoPullback.hom ≫
              CategoryTheory.Limits.pullback.fst g_X η_V).base :=
            congrArg (fun f => Set.range f.base) hPb_X.isoPullback_hom_fst.symm
        _ = Set.range (CategoryTheory.Limits.pullback.fst g_X η_V).base :=
            hSurj_isoX.range_comp _
        _ = g_X.base ⁻¹' Set.range η_V.base :=
            AlgebraicGeometry.Scheme.Pullback.range_fst g_X η_V
    rw [hRange_ιX]
    exact hx_mem_ηV

  have : CompactSpace ↥X := @TopologicalSpace.NoetherianSpace.compactSpace ↥X _ hNoethX
  have : CompactSpace ↥P_tilde :=
    AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace π₁
  have hNoeth_P : TopologicalSpace.NoetherianSpace ↥P_tilde :=
    step_noeth ↥V hPkg.1 P_tilde (π₁ ≫ g_X)
  have hCover := step_cover U_0.toScheme X Y P_tilde f_X f_Y j_P π₁ π₂ hπ₁_eq hπ₂_eq

  exact ⟨F, inferInstance, φ_KF, P_tilde, π₁, π₂, ι_P, η_P, η_X, η_Y,
    hInt_P, hNoeth_P, hProp_π₁, hProp_π₂, hπ_comm, hιP_π₁, hιP_π₂, hPb_P,
    hDom_P, hηP_X, hηP_Y, hFunc_P, hFunc_X, hFunc_Y, hφ_V, hEssTr, hGenSub, hCover⟩

theorem weil_noetherian_closedPoint_and_linear_fiber_singleton (K : Type u) [Field K]
    (V : ValuationSubring K)
    (X : AlgebraicGeometry.Scheme.{u})
    (g_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (hSep_X : AlgebraicGeometry.IsSeparated g_X)
    (hNoeth_X : TopologicalSpace.NoetherianSpace ↥X)
    (Q : Ideal ↥V) [Q.IsPrime]
    (hQ_ne : Q ≠ ⊥)
    (U_X : X.Opens) (hUX : AlgebraicGeometry.IsAffineOpen U_X)
    (p : Ideal ↑(X.presheaf.obj (Opposite.op U_X))) [p.IsPrime]
    (hp_comap : Ideal.comap (AlgebraicGeometry.Spec.preimage (hUX.fromSpec ≫ g_X)).hom p = Q)
    (hLinX : ∀ (d r : ↑(X.presheaf.obj (Opposite.op U_X))), r ∉ p →
      ∃ (c₀ s₀ : ↥V), s₀ ∉ Q ∧
        (AlgebraicGeometry.Spec.preimage (hUX.fromSpec ≫ g_X)).hom s₀ * d -
          (AlgebraicGeometry.Spec.preimage (hUX.fromSpec ≫ g_X)).hom c₀ * r ∈ p) :
    ∃ (P : Ideal ↥V) (_ : P.IsPrime) (_ : P ≠ ⊥) (x₀ : X),
      x₀ ∈ closure ({hUX.fromSpec.base ⟨p, inferInstance⟩} : Set X) ∧
      IsClosed ({x₀} : Set X) ∧
      (g_X.base x₀).asIdeal = P ∧
      Q ≤ P ∧
      (∀ x₁ : X,
        x₁ ∈ closure ({hUX.fromSpec.base ⟨p, inferInstance⟩} : Set X) →
        (g_X.base x₁).asIdeal = P →
        x₁ = x₀) :=
by
  
  let B_X := ↑(X.presheaf.obj (Opposite.op U_X))
  let γ_X_hom := AlgebraicGeometry.Spec.preimage (hUX.fromSpec ≫ g_X)
  let γ_X : ↥V →+* B_X := γ_X_hom.hom
  let pt_p : ↥(AlgebraicGeometry.Spec (X.presheaf.obj (Opposite.op U_X))) := ⟨p, inferInstance⟩
  let x_Q : X := hUX.fromSpec.base pt_p
  have hx_Q : (g_X.base x_Q).asIdeal = Q := by
    have hmap_eq : (hUX.fromSpec ≫ g_X).base pt_p =
        (AlgebraicGeometry.Spec.map γ_X_hom).base pt_p := by
      rw [AlgebraicGeometry.Spec.map_preimage]
    have hg_eq : g_X.base x_Q = (hUX.fromSpec ≫ g_X).base pt_p := rfl
    rw [hg_eq, hmap_eq, AlgebraicGeometry.Spec.map_apply]
    exact hp_comap

  
  let F_set : Set (TopologicalSpace.Closeds ↥X) :=
    {C | (C : Set X).Nonempty ∧ (C : Set X) ⊆ closure ({x_Q} : Set X)}
  let C_top : TopologicalSpace.Closeds ↥X := ⟨closure ({x_Q} : Set X), isClosed_closure⟩
  have hF_ne : F_set.Nonempty :=
    ⟨C_top, ⟨x_Q, subset_closure (Set.mem_singleton x_Q)⟩, Set.Subset.rfl⟩
  let wf_cl : WellFounded (· < · : TopologicalSpace.Closeds ↥X → _ → Prop) :=
    @TopologicalSpace.instWellFoundedLTClosedsOfNoetherianSpace ↥X _ hNoeth_X
  obtain ⟨S_min, ⟨hS_ne, hS_sub⟩, hS_min⟩ := wf_cl.has_min F_set hF_ne
  obtain ⟨x₀, hx₀_eq⟩ := minimal_nonempty_closed_eq_singleton S_min.isClosed hS_ne
    (fun t ht_sub ht_ne ht_cl => by
      let C_t : TopologicalSpace.Closeds ↥X := ⟨t, ht_cl⟩
      have hCt_mem : C_t ∈ F_set := ⟨ht_ne, ht_sub.trans hS_sub⟩
      have hCt_le : C_t ≤ S_min := ht_sub
      have hCt_eq : C_t = S_min := eq_of_le_of_not_lt hCt_le (hS_min C_t hCt_mem)
      exact congrArg SetLike.coe hCt_eq)
  have hx₀_cl : x₀ ∈ closure ({x_Q} : Set X) := by
    apply hS_sub
    rw [hx₀_eq]
    exact Set.mem_singleton x₀
  have hClosed_x₀ : IsClosed ({x₀} : Set X) := by
    rw [← hx₀_eq]
    exact S_min.isClosed
  let P : Ideal ↥V := (g_X.base x₀).asIdeal
  let instPrimeP : P.IsPrime := (g_X.base x₀).isPrime
  have hx₀_P : (g_X.base x₀).asIdeal = P := rfl
  have hQP : Q ≤ P := by
    have hsub : ({x_Q} : Set X) ⊆ g_X.base ⁻¹' closure ({g_X.base x_Q} : Set ↥(AlgebraicGeometry.Spec (CommRingCat.of ↥V))) :=
      Set.singleton_subset_iff.mpr (subset_closure (Set.mem_singleton _))
    have hmem_cl : g_X.base x₀ ∈ closure ({g_X.base x_Q} : Set ↥(AlgebraicGeometry.Spec (CommRingCat.of ↥V))) :=
      closure_minimal hsub (isClosed_closure.preimage g_X.continuous) hx₀_cl
    let q₁_ps : PrimeSpectrum ↥V := g_X.base x_Q
    let q₂_ps : PrimeSpectrum ↥V := g_X.base x₀
    have hps : q₂_ps ∈ closure ({q₁_ps} : Set (PrimeSpectrum ↥V)) := hmem_cl
    rw [PrimeSpectrum.closure_singleton] at hps
    have hle : (g_X.base x_Q).asIdeal ≤ P := hps
    rwa [hx_Q] at hle
  have hP_ne : P ≠ ⊥ := fun hP_bot => hQ_ne (le_bot_iff.mp (hP_bot ▸ hQP))

  
  let K_Q := Q.ResidueField
  let π_Q : ↥V →+* K_Q := algebraMap ↥V K_Q
  have hker_π : RingHom.ker π_Q = Q := Ideal.ker_algebraMap_residueField Q
  have h1_not_p : (1 : B_X) ∉ p := fun h1 => ‹p.IsPrime›.ne_top (p.eq_top_iff_one.mpr h1)
  have h1_not_Q : (1 : ↥V) ∉ Q := fun h1 => ‹Q.IsPrime›.ne_top (Q.eq_top_iff_one.mpr h1)
  have hmul_not_Q : ∀ {x y : ↥V}, x ∉ Q → y ∉ Q → x * y ∉ Q :=
    fun hx hy hxy => (‹Q.IsPrime›.mem_or_mem hxy).elim hx hy
  have h1_not_P : (1 : ↥V) ∉ P := fun h1 => instPrimeP.ne_top (P.eq_top_iff_one.mpr h1)
  have hmul_not_P : ∀ {x y : ↥V}, x ∉ P → y ∉ P → x * y ∉ P :=
    fun hx hy hxy => (instPrimeP.mem_or_mem hxy).elim hx hy
  have hLin1 : ∀ d : B_X, ∃ c₀ s₀ : ↥V, s₀ ∉ Q ∧ γ_X s₀ * d - γ_X c₀ ∈ p := by
    intro d
    obtain ⟨c₀, s₀, hs₀, hrel⟩ := hLinX d 1 h1_not_p
    rw [mul_one] at hrel
    exact ⟨c₀, s₀, hs₀, hrel⟩
  let c₀_fn : B_X → ↥V := fun d => Classical.choose (hLin1 d)
  let s₀_fn : B_X → ↥V := fun d => Classical.choose (Classical.choose_spec (hLin1 d))
  have hs₀_fn : ∀ d : B_X, s₀_fn d ∉ Q :=
    fun d => (Classical.choose_spec (Classical.choose_spec (hLin1 d))).1
  have hrel_fn : ∀ d : B_X, γ_X (s₀_fn d) * d - γ_X (c₀_fn d) ∈ p :=
    fun d => (Classical.choose_spec (Classical.choose_spec (hLin1 d))).2
  let fn : B_X → K_Q := fun d => π_Q (c₀_fn d) / π_Q (s₀_fn d)
  have hfn_eq : ∀ (d : B_X) (c s : ↥V), s ∉ Q → γ_X s * d - γ_X c ∈ p → fn d = π_Q c / π_Q s := by
    intro d c s hs hrel
    have hπs₀ : π_Q (s₀_fn d) ≠ 0 := fun h0 => hs₀_fn d (hker_π ▸ h0)
    have hπs : π_Q s ≠ 0 := fun h0 => hs (hker_π ▸ h0)
    change π_Q (c₀_fn d) / π_Q (s₀_fn d) = π_Q c / π_Q s
    rw [div_eq_div_iff hπs₀ hπs]
    have hmem_p : γ_X (c₀_fn d * s - c * s₀_fn d) ∈ p := by
      have hcomb : γ_X (s₀_fn d) * (γ_X s * d - γ_X c) -
          γ_X s * (γ_X (s₀_fn d) * d - γ_X (c₀_fn d)) ∈ p :=
        p.sub_mem (p.mul_mem_left _ hrel) (p.mul_mem_left _ (hrel_fn d))
      have heq : γ_X (c₀_fn d * s - c * s₀_fn d) =
          γ_X (s₀_fn d) * (γ_X s * d - γ_X c) -
          γ_X s * (γ_X (s₀_fn d) * d - γ_X (c₀_fn d)) := by
        rw [map_sub, map_mul, map_mul]
        ring
      rwa [heq]
    have hmem_Q : c₀_fn d * s - c * s₀_fn d ∈ Q := by
      rw [← hp_comap]
      exact hmem_p
    have h0 : π_Q (c₀_fn d * s - c * s₀_fn d) = 0 := by
      rw [← hker_π, RingHom.mem_ker] at hmem_Q
      exact hmem_Q
    rw [map_sub, map_mul, map_mul] at h0
    exact sub_eq_zero.mp h0
  have hfn_γ : ∀ v : ↥V, fn (γ_X v) = π_Q v := by
    intro v
    have h1 : γ_X 1 * γ_X v - γ_X v ∈ p := by
      rw [map_one, one_mul, sub_self]
      exact p.zero_mem
    rw [hfn_eq (γ_X v) v 1 h1_not_Q h1, map_one, div_one]
  let ψ_Q : B_X →+* K_Q :=
    { toFun := fn
      map_one' := by rw [← map_one γ_X, hfn_γ, map_one]
      map_mul' := by
        intro d₁ d₂
        have hrel_mul : γ_X (s₀_fn d₁ * s₀_fn d₂) * (d₁ * d₂) -
            γ_X (c₀_fn d₁ * c₀_fn d₂) ∈ p := by
          have hc := p.add_mem (p.mul_mem_left (γ_X (s₀_fn d₂) * d₂) (hrel_fn d₁))
            (p.mul_mem_left (γ_X (c₀_fn d₁)) (hrel_fn d₂))
          have heq : γ_X (s₀_fn d₁ * s₀_fn d₂) * (d₁ * d₂) - γ_X (c₀_fn d₁ * c₀_fn d₂) =
              (γ_X (s₀_fn d₂) * d₂) * (γ_X (s₀_fn d₁) * d₁ - γ_X (c₀_fn d₁)) +
              γ_X (c₀_fn d₁) * (γ_X (s₀_fn d₂) * d₂ - γ_X (c₀_fn d₂)) := by
            rw [map_mul, map_mul]
            ring
          rwa [heq]
        rw [hfn_eq (d₁ * d₂) _ _ (hmul_not_Q (hs₀_fn d₁) (hs₀_fn d₂)) hrel_mul]
        change _ = (π_Q (c₀_fn d₁) / π_Q (s₀_fn d₁)) * (π_Q (c₀_fn d₂) / π_Q (s₀_fn d₂))
        rw [div_mul_div_comm, map_mul, map_mul]
      map_zero' := by rw [← map_zero γ_X, hfn_γ, map_zero]
      map_add' := by
        intro d₁ d₂
        have hrel_add : γ_X (s₀_fn d₁ * s₀_fn d₂) * (d₁ + d₂) -
            γ_X (c₀_fn d₁ * s₀_fn d₂ + c₀_fn d₂ * s₀_fn d₁) ∈ p := by
          have hc := p.add_mem (p.mul_mem_left (γ_X (s₀_fn d₂)) (hrel_fn d₁))
            (p.mul_mem_left (γ_X (s₀_fn d₁)) (hrel_fn d₂))
          have heq : γ_X (s₀_fn d₁ * s₀_fn d₂) * (d₁ + d₂) -
              γ_X (c₀_fn d₁ * s₀_fn d₂ + c₀_fn d₂ * s₀_fn d₁) =
              γ_X (s₀_fn d₂) * (γ_X (s₀_fn d₁) * d₁ - γ_X (c₀_fn d₁)) +
              γ_X (s₀_fn d₁) * (γ_X (s₀_fn d₂) * d₂ - γ_X (c₀_fn d₂)) := by
            rw [map_mul, map_add, map_mul, map_mul]
            ring
          rwa [heq]
        rw [hfn_eq (d₁ + d₂) _ _ (hmul_not_Q (hs₀_fn d₁) (hs₀_fn d₂)) hrel_add]
        have hπ1 : π_Q (s₀_fn d₁) ≠ 0 := fun h0 => hs₀_fn d₁ (hker_π ▸ h0)
        have hπ2 : π_Q (s₀_fn d₂) ≠ 0 := fun h0 => hs₀_fn d₂ (hker_π ▸ h0)
        change _ = π_Q (c₀_fn d₁) / π_Q (s₀_fn d₁) + π_Q (c₀_fn d₂) / π_Q (s₀_fn d₂)
        rw [div_add_div _ _ hπ1 hπ2, map_add, map_mul, map_mul, map_mul]
        ring }
  have hker_ψQ : RingHom.ker ψ_Q = p := by
    ext d
    rw [RingHom.mem_ker]
    constructor
    · intro hd0
      have hπs₀ : π_Q (s₀_fn d) ≠ 0 := fun h0 => hs₀_fn d (hker_π ▸ h0)
      change π_Q (c₀_fn d) / π_Q (s₀_fn d) = 0 at hd0
      have hπc₀ : π_Q (c₀_fn d) = 0 := (div_eq_zero_iff.mp hd0).resolve_right hπs₀
      have hc₀_Q : c₀_fn d ∈ Q := by rwa [← hker_π, RingHom.mem_ker]
      have hc₀_p : γ_X (c₀_fn d) ∈ p := by
        rw [← hp_comap] at hc₀_Q
        exact hc₀_Q
      have hmul_p : γ_X (s₀_fn d) * d ∈ p := by
        have hsum := p.add_mem (hrel_fn d) hc₀_p
        rwa [sub_add_cancel] at hsum
      have hs₀_not_p : γ_X (s₀_fn d) ∉ p := fun hp_mem => hs₀_fn d (hp_comap ▸ hp_mem)
      exact (‹p.IsPrime›.mem_or_mem hmul_p).resolve_left hs₀_not_p
    · intro hdp
      have hrel0 : γ_X 1 * d - γ_X 0 ∈ p := by
        rw [map_one, one_mul, map_zero, sub_zero]
        exact hdp
      change fn d = 0
      rw [hfn_eq d 0 1 h1_not_Q hrel0, map_zero, zero_div]

  
  have hKQ_surj : ∀ z : K_Q, ∃ a b : ↥V, b ∉ Q ∧ z * π_Q b = π_Q a := by
    intro z
    obtain ⟨y, rfl⟩ := IsLocalRing.residue_surjective (R := Localization.AtPrime Q) z
    obtain ⟨⟨a, ⟨b, hb⟩⟩, hy⟩ := IsLocalization.surj Q.primeCompl y
    refine ⟨a, b, hb, ?_⟩
    have h1 := congrArg (IsLocalRing.residue (Localization.AtPrime Q)) hy
    rw [map_mul] at h1
    exact h1
  let S_QP : Subring K_Q :=
    { carrier := {z : K_Q | ∃ c s : ↥V, s ∉ P ∧ z * π_Q s = π_Q c}
      mul_mem' := by
        rintro z₁ z₂ ⟨c₁, s₁, hs₁, h₁⟩ ⟨c₂, s₂, hs₂, h₂⟩
        refine ⟨c₁ * c₂, s₁ * s₂, hmul_not_P hs₁ hs₂, ?_⟩
        rw [map_mul, map_mul]
        calc (z₁ * z₂) * (π_Q s₁ * π_Q s₂)
            = (z₁ * π_Q s₁) * (z₂ * π_Q s₂) := by ring
          _ = π_Q c₁ * π_Q c₂ := by rw [h₁, h₂]
      one_mem' := ⟨1, 1, h1_not_P, by simp⟩
      add_mem' := by
        rintro z₁ z₂ ⟨c₁, s₁, hs₁, h₁⟩ ⟨c₂, s₂, hs₂, h₂⟩
        refine ⟨c₁ * s₂ + c₂ * s₁, s₁ * s₂, hmul_not_P hs₁ hs₂, ?_⟩
        rw [map_mul, map_add, map_mul, map_mul]
        calc (z₁ + z₂) * (π_Q s₁ * π_Q s₂)
            = (z₁ * π_Q s₁) * π_Q s₂ + (z₂ * π_Q s₂) * π_Q s₁ := by ring
          _ = π_Q c₁ * π_Q s₂ + π_Q c₂ * π_Q s₁ := by rw [h₁, h₂]
      zero_mem' := ⟨0, 1, h1_not_P, by simp⟩
      neg_mem' := by
        rintro z ⟨c, s, hs, h⟩
        refine ⟨-c, s, hs, ?_⟩
        rw [map_neg, neg_mul, h] }
  have h_tot : ∀ z : K_Q, z ∈ S_QP ∨ z⁻¹ ∈ S_QP := by
    intro z
    by_cases hz0 : z = 0
    · exact Or.inl (hz0 ▸ S_QP.zero_mem)
    · obtain ⟨a, b, hb, hzb⟩ := hKQ_surj z
      have hπb : π_Q b ≠ 0 := fun h0 => hb (hker_π ▸ h0)
      have hπa : π_Q a ≠ 0 := by rw [← hzb]; exact mul_ne_zero hz0 hπb
      rcases ValuationRing.dvd_total a b with ⟨u, rfl⟩ | ⟨u, rfl⟩
      · right
        have hzu : z * π_Q u = 1 := by
          apply mul_right_cancel₀ hπa
          calc (z * π_Q u) * π_Q a = z * (π_Q a * π_Q u) := by ring
            _ = z * π_Q (a * u) := by rw [map_mul]
            _ = π_Q a := hzb
            _ = 1 * π_Q a := (one_mul _).symm
        refine ⟨u, 1, h1_not_P, ?_⟩
        rw [map_one, mul_one]
        apply mul_left_cancel₀ hz0
        rw [mul_inv_cancel₀ hz0, hzu]
      · left
        have hzu : z = π_Q u := by
          apply mul_right_cancel₀ hπb
          calc z * π_Q b = π_Q (b * u) := hzb
            _ = π_Q b * π_Q u := map_mul π_Q b u
            _ = π_Q u * π_Q b := mul_comm _ _
        exact ⟨u, 1, h1_not_P, by rw [map_one, mul_one, hzu]⟩
  let R_QP : ValuationSubring K_Q := ValuationSubring.ofSubring S_QP h_tot
  let ι_VR : ↥V →+* ↥R_QP :=
    π_Q.codRestrict R_QP.toSubring (fun v => by
      change π_Q v ∈ R_QP
      rw [ValuationSubring.mem_ofSubring]
      exact ⟨v, 1, h1_not_P, by rw [map_one, mul_one]⟩)
  have hcomap_ι : ∀ v : ↥V, ι_VR v ∈ IsLocalRing.maximalIdeal ↥R_QP ↔ v ∈ P := by
    intro v
    rw [← not_iff_not, IsLocalRing.notMem_maximalIdeal]
    constructor
    · intro hunit
      obtain ⟨w, hw⟩ := hunit.exists_right_inv
      have hw_val : π_Q v * w.1 = 1 := congrArg Subtype.val hw
      have hw_mem : w.1 ∈ R_QP := w.2
      rw [ValuationSubring.mem_ofSubring] at hw_mem
      rcases hw_mem with ⟨c, s, hs, hwc⟩
      intro hvP
      apply hs
      have hdiff : s - v * c ∈ Q := by
        rw [← hker_π, RingHom.mem_ker, map_sub, map_mul, ← hwc]
        calc π_Q s - π_Q v * (w.1 * π_Q s)
            = (1 - π_Q v * w.1) * π_Q s := by ring
          _ = (1 - 1) * π_Q s := by rw [hw_val]
          _ = 0 := by ring
      have hsubP : s - v * c ∈ P := hQP hdiff
      have hvcP : v * c ∈ P := P.mul_mem_right c hvP
      have hs_eq : s = (s - v * c) + v * c := by ring
      rw [hs_eq]
      exact P.add_mem hsubP hvcP
    · intro hvP
      have hvQ : v ∉ Q := fun h => hvP (hQP h)
      have hπv : π_Q v ≠ 0 := fun h0 => hvQ (hker_π ▸ h0)
      have hinv_mem : (π_Q v)⁻¹ ∈ R_QP := by
        rw [ValuationSubring.mem_ofSubring]
        exact ⟨1, v, hvP, by rw [inv_mul_cancel₀ hπv, map_one]⟩
      exact IsUnit.of_mul_eq_one (⟨(π_Q v)⁻¹, hinv_mem⟩ : ↥R_QP)
        (Subtype.ext (mul_inv_cancel₀ hπv))

  
  let η₀ : AlgebraicGeometry.Spec (CommRingCat.of K_Q) ⟶ X :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_Q) ≫ hUX.fromSpec
  have hη₀_pt : ∀ q : ↥(AlgebraicGeometry.Spec (CommRingCat.of K_Q)), η₀.base q = x_Q := by
    intro q
    have hq_bot : q.asIdeal = ⊥ := @Ideal.eq_bot_of_prime K_Q _ q.asIdeal q.isPrime
    have hpt_eq : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_Q)).base q = pt_p := by
      apply PrimeSpectrum.ext
      rw [AlgebraicGeometry.Spec.map_apply]
      change Ideal.comap ψ_Q q.asIdeal = p
      rw [hq_bot]
      exact hker_ψQ
    change hUX.fromSpec.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_Q)).base q) = x_Q
    rw [hpt_eq]
  have hη₀_gX : η₀ ≫ g_X = AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_Q) := by
    have hhom_eq : γ_X_hom ≫ CommRingCat.ofHom ψ_Q = CommRingCat.ofHom π_Q := by
      ext v
      exact hfn_γ v
    calc
      η₀ ≫ g_X
        = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_Q) ≫ (hUX.fromSpec ≫ g_X) :=
          CategoryTheory.Category.assoc _ _ _
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_Q) ≫
            AlgebraicGeometry.Spec.map γ_X_hom := by
          rw [AlgebraicGeometry.Spec.map_preimage]
      _ = AlgebraicGeometry.Spec.map (γ_X_hom ≫ CommRingCat.ofHom ψ_Q) := by
          rw [AlgebraicGeometry.Spec.map_comp]
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_Q) := by
          rw [hhom_eq]

  let m_R : ↥(AlgebraicGeometry.Spec (CommRingCat.of ↥R_QP)) :=
    ⟨IsLocalRing.maximalIdeal ↥R_QP, inferInstance⟩
  let j_R : AlgebraicGeometry.Spec (CommRingCat.of K_Q) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of ↥R_QP) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom R_QP.subtype)
  let s_VR : AlgebraicGeometry.Spec (CommRingCat.of ↥R_QP) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of ↥V) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_VR)

  have hLift : ∀ x : X, x ∈ closure ({x_Q} : Set X) → (g_X.base x).asIdeal = P →
      ∃ τ : AlgebraicGeometry.Spec (CommRingCat.of ↥R_QP) ⟶ X,
        τ.base m_R = x ∧ j_R ≫ τ = η₀ ∧ τ ≫ g_X = s_VR := by
    intro x hx_cl hx_P
    have hx_top : x ∈ (⊤ : X.Opens) := trivial
    obtain ⟨U₁, hU₁, hx_U₁, _⟩ := AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hx_top
    obtain ⟨w, hw_U₁, hw_eq⟩ := mem_closure_iff.mp hx_cl (U₁ : Set X) U₁.2 hx_U₁
    have hxQ_U₁ : x_Q ∈ U₁ := by
      have hw_xQ : w = x_Q := hw_eq
      rwa [← hw_xQ]
    have hη₀_range : Set.range η₀.base ⊆ Set.range hU₁.fromSpec.base := by
      rw [hU₁.range_fromSpec]
      rintro _ ⟨q, rfl⟩
      rw [hη₀_pt q]
      exact hxQ_U₁
    let f₁ := AlgebraicGeometry.IsOpenImmersion.lift hU₁.fromSpec η₀ hη₀_range
    have hf₁ : f₁ ≫ hU₁.fromSpec = η₀ :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac hU₁.fromSpec η₀ hη₀_range
    let B₁ := ↑(X.presheaf.obj (Opposite.op U₁))
    let ψ₁_hom := AlgebraicGeometry.Spec.preimage f₁
    let ψ₁ : B₁ →+* K_Q := ψ₁_hom.hom
    let γ₁_hom := AlgebraicGeometry.Spec.preimage (hU₁.fromSpec ≫ g_X)
    let γ₁ : ↥V →+* B₁ := γ₁_hom.hom
    let pt_x : ↥(AlgebraicGeometry.Spec (X.presheaf.obj (Opposite.op U₁))) :=
      hU₁.primeIdealOf ⟨x, hx_U₁⟩
    have hpt_x_base : hU₁.fromSpec.base pt_x = x :=
      hU₁.fromSpec_primeIdealOf ⟨x, hx_U₁⟩
    let q₁ : Ideal B₁ := pt_x.asIdeal
    have hq₁_prime : q₁.IsPrime := pt_x.isPrime
    have hker₁ : RingHom.ker ψ₁ ≤ q₁ := by
      let pt₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of K_Q)) := ⟨⊥, inferInstance⟩
      let pt_Q : ↥(AlgebraicGeometry.Spec (X.presheaf.obj (Opposite.op U₁))) :=
        (AlgebraicGeometry.Spec.map ψ₁_hom).base pt₀
      have hptQ_ideal : pt_Q.asIdeal = RingHom.ker ψ₁ := by
        change ((AlgebraicGeometry.Spec.map ψ₁_hom).base pt₀).asIdeal = RingHom.ker ψ₁
        rw [AlgebraicGeometry.Spec.map_apply]
        rfl
      have hptQ_base : hU₁.fromSpec.base pt_Q = x_Q := by
        change (AlgebraicGeometry.Spec.map ψ₁_hom ≫ hU₁.fromSpec).base pt₀ = x_Q
        rw [AlgebraicGeometry.Spec.map_preimage, hf₁]
        exact hη₀_pt pt₀
      have hemb := hU₁.fromSpec.isOpenEmbedding.isEmbedding
      have hmem : pt_x ∈ closure ({pt_Q} : Set ↥(AlgebraicGeometry.Spec (X.presheaf.obj (Opposite.op U₁)))) := by
        rw [hemb.closure_eq_preimage_closure_image, Set.image_singleton]
        change hU₁.fromSpec.base pt_x ∈ closure ({hU₁.fromSpec.base pt_Q} : Set X)
        rwa [hpt_x_base, hptQ_base]
      let qQ_ps : PrimeSpectrum B₁ := pt_Q
      let qx_ps : PrimeSpectrum B₁ := pt_x
      have hps : qx_ps ∈ closure ({qQ_ps} : Set (PrimeSpectrum B₁)) := hmem
      rw [PrimeSpectrum.closure_singleton] at hps
      have hle : pt_Q.asIdeal ≤ q₁ := hps
      rwa [hptQ_ideal] at hle
    have hcomp₁ : ψ₁.comp γ₁ = π_Q := by
      have hSpec_eq : AlgebraicGeometry.Spec.map (γ₁_hom ≫ ψ₁_hom) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_Q) := by
        calc
          AlgebraicGeometry.Spec.map (γ₁_hom ≫ ψ₁_hom)
            = AlgebraicGeometry.Spec.map ψ₁_hom ≫ AlgebraicGeometry.Spec.map γ₁_hom :=
              AlgebraicGeometry.Spec.map_comp _ _
          _ = f₁ ≫ (hU₁.fromSpec ≫ g_X) := by
              rw [AlgebraicGeometry.Spec.map_preimage, AlgebraicGeometry.Spec.map_preimage]
          _ = (f₁ ≫ hU₁.fromSpec) ≫ g_X := (CategoryTheory.Category.assoc _ _ _).symm
          _ = η₀ ≫ g_X := by rw [hf₁]
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_Q) := hη₀_gX
      have hPre := congrArg AlgebraicGeometry.Spec.preimage hSpec_eq
      rw [AlgebraicGeometry.Spec.preimage_map, AlgebraicGeometry.Spec.preimage_map] at hPre
      exact congrArg CommRingCat.Hom.hom hPre
    have hcomap₁ : Ideal.comap γ₁ q₁ = P := by
      have hmap_pt : ((AlgebraicGeometry.Spec.map γ₁_hom).base pt_x).asIdeal =
          Ideal.comap γ₁ q₁ := by
        rw [AlgebraicGeometry.Spec.map_apply]
        rfl
      rw [← hmap_pt, AlgebraicGeometry.Spec.map_preimage]
      change (g_X.base (hU₁.fromSpec.base pt_x)).asIdeal = P
      rw [hpt_x_base]
      exact hx_P
    have hb_lift : ∀ b : B₁,
        ∃ y : ↥R_QP, y.1 = ψ₁ b ∧ (y ∈ IsLocalRing.maximalIdeal ↥R_QP ↔ b ∈ q₁) := by
      intro b
      obtain ⟨a, s₀, hs₀, hbs₀⟩ := hKQ_surj (ψ₁ b)
      have hπs₀ : π_Q s₀ ≠ 0 := fun h0 => hs₀ (hker_π ▸ h0)
      rcases ValuationRing.dvd_total a s₀ with ⟨u, rfl⟩ | ⟨u, rfl⟩
      · have hs₀_au : a * u ∉ Q := hs₀
        have ha_not_Q : a ∉ Q := fun haQ => hs₀_au (Q.mul_mem_right u haQ)
        have hπa : π_Q a ≠ 0 := fun h0 => ha_not_Q (hker_π ▸ h0)
        have hbu : ψ₁ b * π_Q u = 1 := by
          apply mul_right_cancel₀ hπa
          calc (ψ₁ b * π_Q u) * π_Q a = ψ₁ b * (π_Q a * π_Q u) := by ring
            _ = ψ₁ b * π_Q (a * u) := by rw [map_mul]
            _ = π_Q a := hbs₀
            _ = 1 * π_Q a := (one_mul _).symm
        have hker_bu : b * γ₁ u - 1 ∈ q₁ := by
          apply hker₁
          rw [RingHom.mem_ker, map_sub, map_mul, map_one]
          have hγu : ψ₁ (γ₁ u) = π_Q u := DFunLike.congr_fun hcomp₁ u
          rw [hγu, hbu, sub_self]
        have h1_not_q₁ : (1 : B₁) ∉ q₁ :=
          fun h1 => hq₁_prime.ne_top (q₁.eq_top_iff_one.mpr h1)
        have hb_not_q₁ : b ∉ q₁ := by
          intro hbq
          apply h1_not_q₁
          have hmul : b * γ₁ u ∈ q₁ := q₁.mul_mem_right (γ₁ u) hbq
          have hdiff := q₁.sub_mem hmul hker_bu
          rwa [sub_sub_cancel] at hdiff
        have hu_not_P : u ∉ P := by
          intro huP
          apply h1_not_q₁
          have hγu_q₁ : γ₁ u ∈ q₁ := by
            rw [← hcomap₁] at huP
            exact huP
          have hmul : b * γ₁ u ∈ q₁ := q₁.mul_mem_left b hγu_q₁
          have hdiff := q₁.sub_mem hmul hker_bu
          rwa [sub_sub_cancel] at hdiff
        have hy_mem : ψ₁ b ∈ R_QP := by
          rw [ValuationSubring.mem_ofSubring]
          exact ⟨1, u, hu_not_P, by rw [hbu, map_one]⟩
        let y : ↥R_QP := ⟨ψ₁ b, hy_mem⟩
        have hy_unit : IsUnit y :=
          IsUnit.of_mul_eq_one (ι_VR u) (Subtype.ext hbu)
        have hy_not_m : y ∉ IsLocalRing.maximalIdeal ↥R_QP :=
          IsLocalRing.notMem_maximalIdeal.mpr hy_unit
        exact ⟨y, rfl, iff_of_false hy_not_m hb_not_q₁⟩
      · have hbu : ψ₁ b = π_Q u := by
          apply mul_right_cancel₀ hπs₀
          calc ψ₁ b * π_Q s₀ = π_Q (s₀ * u) := hbs₀
            _ = π_Q s₀ * π_Q u := map_mul π_Q s₀ u
            _ = π_Q u * π_Q s₀ := mul_comm _ _
        have hker_bu : b - γ₁ u ∈ q₁ := by
          apply hker₁
          rw [RingHom.mem_ker, map_sub]
          have hγu : ψ₁ (γ₁ u) = π_Q u := DFunLike.congr_fun hcomp₁ u
          rw [hbu, hγu, sub_self]
        refine ⟨ι_VR u, hbu.symm, ?_⟩
        rw [hcomap_ι u, ← hcomap₁]
        change γ₁ u ∈ q₁ ↔ b ∈ q₁
        constructor
        · intro hγu
          have hsum := q₁.add_mem hker_bu hγu
          rwa [sub_add_cancel] at hsum
        · intro hbq
          have hdiff := q₁.sub_mem hbq hker_bu
          rwa [sub_sub_cancel] at hdiff
    let ρ₁ : B₁ →+* ↥R_QP :=
      ψ₁.codRestrict R_QP.toSubring (fun b => by
        obtain ⟨y, hy_eq, _⟩ := hb_lift b
        change ψ₁ b ∈ R_QP
        rw [← hy_eq]
        exact y.2)
    have hρ₁_comap : Ideal.comap ρ₁ (IsLocalRing.maximalIdeal ↥R_QP) = q₁ := by
      ext b
      obtain ⟨y, hy_eq, hy_iff⟩ := hb_lift b
      have hy_ρ : ρ₁ b = y := Subtype.ext hy_eq.symm
      change ρ₁ b ∈ IsLocalRing.maximalIdeal ↥R_QP ↔ b ∈ q₁
      rwa [hy_ρ]
    let τ : AlgebraicGeometry.Spec (CommRingCat.of ↥R_QP) ⟶ X :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ₁) ≫ hU₁.fromSpec
    refine ⟨τ, ?_, ?_, ?_⟩
    · have hpt_mR : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ₁)).base m_R = pt_x := by
        apply PrimeSpectrum.ext
        rw [AlgebraicGeometry.Spec.map_apply]
        exact hρ₁_comap
      change hU₁.fromSpec.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ₁)).base m_R) = x
      rw [hpt_mR, hpt_x_base]
    · have hsub_hom : CommRingCat.ofHom ρ₁ ≫ CommRingCat.ofHom R_QP.subtype = ψ₁_hom := by
        ext b
        rfl
      calc
        j_R ≫ τ
          = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom R_QP.subtype) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ₁)) ≫ hU₁.fromSpec :=
            (CategoryTheory.Category.assoc _ _ _).symm
        _ = AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom ρ₁ ≫ CommRingCat.ofHom R_QP.subtype) ≫ hU₁.fromSpec := by
            rw [← AlgebraicGeometry.Spec.map_comp]
        _ = f₁ ≫ hU₁.fromSpec := by
            rw [hsub_hom, AlgebraicGeometry.Spec.map_preimage]
        _ = η₀ := hf₁
    · have hγ_hom : γ₁_hom ≫ CommRingCat.ofHom ρ₁ = CommRingCat.ofHom ι_VR := by
        ext v
        exact DFunLike.congr_fun hcomp₁ v
      calc
        τ ≫ g_X
          = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ₁) ≫ (hU₁.fromSpec ≫ g_X) :=
            CategoryTheory.Category.assoc _ _ _
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ₁) ≫
              AlgebraicGeometry.Spec.map γ₁_hom := by
            rw [AlgebraicGeometry.Spec.map_preimage]
        _ = AlgebraicGeometry.Spec.map (γ₁_hom ≫ CommRingCat.ofHom ρ₁) := by
            rw [AlgebraicGeometry.Spec.map_comp]
        _ = s_VR := by
            rw [hγ_hom]

  
  have : AlgebraicGeometry.IsSeparated g_X := hSep_X
  have : AlgebraicGeometry.IsDominant j_R := by
    rw [AlgebraicGeometry.isDominant_iff]
    intro q
    let pt₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of K_Q)) := ⟨⊥, inferInstance⟩
    let q₀_ps : PrimeSpectrum ↥R_QP := j_R.base pt₀
    let q_ps : PrimeSpectrum ↥R_QP := q
    have hle : q₀_ps.asIdeal ≤ q_ps.asIdeal := by
      have hq₀ : ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom R_QP.subtype)).base pt₀).asIdeal =
          RingHom.ker R_QP.subtype := by
        rw [AlgebraicGeometry.Spec.map_apply]
        rfl
      intro z hz
      have hz_ker : z ∈ RingHom.ker R_QP.subtype := hq₀ ▸ hz
      rw [RingHom.mem_ker] at hz_ker
      have hz0 : z = 0 := R_QP.subtype_injective (hz_ker.trans R_QP.subtype.map_zero.symm)
      rw [hz0]
      exact q.asIdeal.zero_mem
    have hcl_ps : q_ps ∈ closure ({q₀_ps} : Set (PrimeSpectrum ↥R_QP)) := by
      rw [PrimeSpectrum.closure_singleton]
      exact hle
    have hsub_range :
        ({j_R.base pt₀} : Set ↥(AlgebraicGeometry.Spec (CommRingCat.of ↥R_QP))) ⊆
          Set.range j_R.base :=
      Set.singleton_subset_iff.mpr ⟨pt₀, rfl⟩
    exact closure_mono hsub_range hcl_ps
  obtain ⟨τ₀, hτ₀_m, hj_τ₀, hτ₀_g⟩ := hLift x₀ hx₀_cl hx₀_P
  refine ⟨P, instPrimeP, hP_ne, x₀, hx₀_cl, hClosed_x₀, hx₀_P, hQP, ?_⟩
  intro x₁ hx₁_cl hx₁_P
  obtain ⟨τ₁, hτ₁_m, hj_τ₁, hτ₁_g⟩ := hLift x₁ hx₁_cl hx₁_P
  have hτ_eq : τ₁ = τ₀ :=
    AlgebraicGeometry.ext_of_isDominant_of_isSeparated g_X
      (hτ₁_g.trans hτ₀_g.symm) j_R (hj_τ₁.trans hj_τ₀.symm)
  calc
    x₁ = τ₁.base m_R := hτ₁_m.symm
    _ = τ₀.base m_R := by rw [hτ_eq]
    _ = x₀ := hτ₀_m

theorem weil_etale_semistable_chart_goingDown_transcendental_lift (K : Type u) [Field K]
    (V : ValuationSubring K)
    (hNodalNorm : ∀ (K₀ : Type u) [Field K₀] (V₀ : ValuationSubring K₀) (a₀ : ↥V₀),
      a₀ ≠ 0 →
      IsDomain (MvPolynomial (Fin 2) ↥V₀ ⧸ Ideal.span
        {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a₀}) ∧
      IsIntegrallyClosed (MvPolynomial (Fin 2) ↥V₀ ⧸ Ideal.span
        {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a₀}))
    (Q P : Ideal ↥V) [Q.IsPrime] [P.IsPrime] [IsAlgClosed Q.ResidueField]
    (hQP : Q ≤ P)
    (F : Type u) [Field F]
    (φ_KF : K →+* F)
    (W : ValuationSubring F)
    (hV : ∀ c : ↥V, φ_KF (V.subtype c) ∈ W)
    (B'_Y : Type u) [CommRing B'_Y]
    (γ'_Y : ↥V →+* B'_Y)
    (q'_η q'_y₀ : Ideal B'_Y) [q'_η.IsPrime] [q'_y₀.IsPrime]
    (hq_le : q'_η ≤ q'_y₀)
    (hq'_η_Q : Ideal.comap γ'_Y q'_η = Q)
    (hq'_y₀_P : Ideal.comap γ'_Y q'_y₀ = P)
    (ρ'_Y : B'_Y →+* ↥W)
    (hρ'_comap : Ideal.comap ρ'_Y (IsLocalRing.maximalIdeal ↥W) = q'_η)
    (hγ'_W : ∀ c : ↥V, ρ'_Y (γ'_Y c) = ⟨φ_KF (V.subtype c), hV c⟩)
    (b_num r'_0 : B'_Y)
    (t_W : ↥W)
    (k_pow : ℕ)
    (hr'_0 : r'_0 ∉ q'_η)
    (ht_eq : t_W * (ρ'_Y r'_0) ^ k_pow = ρ'_Y b_num)
    (ht_tr : ∀ P_poly : Polynomial ↥V,
      (∃ i : ℕ, P_poly.coeff i ∉ Q) →
      Polynomial.eval₂ ((φ_KF.comp V.subtype).codRestrict W.toSubring hV) t_W P_poly ∉
        IsLocalRing.maximalIdeal ↥W)
    (hChart : (∃ θ_sm : Polynomial ↥V →+* B'_Y,
        θ_sm.Etale ∧ θ_sm.comp Polynomial.C = γ'_Y) ∨
      (∃ (a : ↥V) (θ_nod : (MvPolynomial (Fin 2) ↥V ⧸ Ideal.span
          {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}) →+* B'_Y),
        a ≠ 0 ∧ θ_nod.Etale ∧ θ_nod.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) = γ'_Y)) :
    ∃ (q_P : Ideal B'_Y) (_ : q_P.IsPrime) (t_coord : B'_Y),
      q'_η ≤ q_P ∧
      q_P ≤ q'_y₀ ∧
      Ideal.comap γ'_Y q_P = P ∧
      (∀ g : Polynomial ↥V, (∃ i : ℕ, g.coeff i ∉ P) → Polynomial.eval₂ γ'_Y t_coord g ∉ q_P) :=
by
  
  
  
  let κ_W := IsLocalRing.ResidueField ↥W
  let res_W : ↥W →+* κ_W := IsLocalRing.residue ↥W
  let φ_VW : ↥V →+* ↥W := (φ_KF.comp V.subtype).codRestrict W.toSubring hV
  let ρ_bar : B'_Y →+* κ_W := res_W.comp ρ'_Y
  let γ_bar : ↥V →+* κ_W := ρ_bar.comp γ'_Y

  have hKer_ρ_bar : ∀ y : B'_Y, ρ_bar y = 0 ↔ y ∈ q'_η := by
    intro y
    change res_W (ρ'_Y y) = 0 ↔ y ∈ q'_η
    rw [← RingHom.mem_ker, IsLocalRing.ker_residue, ← hρ'_comap]
    rfl

  have hKer_γ_bar : ∀ c : ↥V, γ_bar c = 0 ↔ c ∈ Q := by
    intro c
    change ρ_bar (γ'_Y c) = 0 ↔ c ∈ Q
    rw [hKer_ρ_bar, ← hq'_η_Q]
    rfl

  have hγ_le_ker : Q ≤ RingHom.ker γ_bar := fun c hc => (hKer_γ_bar c).mpr hc
  have hγ_units : Q.primeCompl ≤ Submonoid.comap γ_bar (IsUnit.submonoid κ_W) := by
    intro c hc
    change IsUnit (γ_bar c)
    exact isUnit_iff_ne_zero.mpr (fun h0 => hc ((hKer_γ_bar c).mp h0))

  let ι_QW : Q.ResidueField →+* κ_W :=
    Ideal.ResidueField.lift Q γ_bar hγ_le_ker hγ_units
  have hι_QW_alg : ∀ c : ↥V, ι_QW (algebraMap ↥V Q.ResidueField c) = γ_bar c :=
    Ideal.ResidueField.lift_algebraMap Q γ_bar hγ_le_ker hγ_units

  
  have hAlgClosed_tr : ∀ x : κ_W, x ∉ Set.range ι_QW →
      ∀ G : Polynomial Q.ResidueField, Polynomial.eval₂ ι_QW x G = 0 → G = 0 := by
    intro x hx G hG
    by_contra hne
    letI : Algebra Q.ResidueField κ_W := ι_QW.toAlgebra
    have hlc : G.leadingCoeff ≠ 0 := Polynomial.leadingCoeff_ne_zero.mpr hne
    let G' : Polynomial Q.ResidueField := Polynomial.C G.leadingCoeff⁻¹ * G
    have hMonic : G'.Monic :=
      Polynomial.monic_C_mul_of_mul_leadingCoeff_eq_one (inv_mul_cancel₀ hlc)
    have hEval : Polynomial.eval₂ (algebraMap Q.ResidueField κ_W) x G' = 0 := by
      change Polynomial.eval₂ ι_QW x (Polynomial.C G.leadingCoeff⁻¹ * G) = 0
      rw [Polynomial.eval₂_mul, Polynomial.eval₂_C, hG, mul_zero]
    have hInt : IsIntegral Q.ResidueField x := ⟨G', hMonic, hEval⟩
    have hdeg : (minpoly Q.ResidueField x).degree = 1 :=
      IsAlgClosed.degree_eq_one_of_irreducible Q.ResidueField (minpoly.irreducible hInt)
    exact hx (minpoly.mem_range_of_degree_eq_one Q.ResidueField x hdeg)

  
  
  
  have hNonAlg : ∀ (A₀ : Type u) [CommRing A₀] (γ_A₀ : ↥V →+* A₀) (θ₀ : A₀ →+* B'_Y),
      θ₀.Etale → θ₀.comp γ_A₀ = γ'_Y →
      ∃ x₀ : A₀, ρ_bar (θ₀ x₀) ∉ Set.range ι_QW := by
    intro A₀ _ γ_A₀ θ₀ hEt _hComm
    let σ₀ : A₀ →+* κ_W := ρ_bar.comp θ₀
    by_contra h_not
    simp only [not_exists, Set.not_notMem] at h_not
    let e_K : Q.ResidueField ≃+* ↥ι_QW.range :=
      RingEquiv.ofBijective ι_QW.rangeRestrict
        ⟨fun a b h => ι_QW.injective (congrArg Subtype.val h), ι_QW.rangeRestrict_surjective⟩
    let τ₀ : A₀ →+* Q.ResidueField :=
      e_K.symm.toRingHom.comp (σ₀.codRestrict ι_QW.range h_not)
    have h_comp_τ₀ : ι_QW.comp τ₀ = ρ_bar.comp θ₀ := by
      ext x
      change (e_K (e_K.symm (σ₀.codRestrict ι_QW.range h_not x))).1 = σ₀ x
      rw [e_K.apply_symm_apply]
      rfl
    letI : Algebra A₀ B'_Y := θ₀.toAlgebra
    letI : Algebra Q.ResidueField κ_W := ι_QW.toAlgebra
    have hInt_mem : ∀ z : B'_Y, IsIntegral A₀ z → ρ_bar z ∈ Set.range ι_QW := by
      intro z hz
      have hz_KQ : IsIntegral Q.ResidueField (ρ_bar z) :=
        IsIntegral.map_of_comp_eq τ₀ ρ_bar h_comp_τ₀ hz
      have hdeg : (minpoly Q.ResidueField (ρ_bar z)).degree = 1 :=
        IsAlgClosed.degree_eq_one_of_irreducible Q.ResidueField (minpoly.irreducible hz_KQ)
      exact minpoly.mem_range_of_degree_eq_one Q.ResidueField (ρ_bar z) hdeg
    have : Algebra.Etale A₀ B'_Y := RingHom.Etale.toAlgebra hEt
    have hzmt : Algebra.ZariskisMainProperty A₀ q'_η :=
      Algebra.ZariskisMainProperty.of_finiteType (R := A₀) q'_η
    rw [Algebra.zariskisMainProperty_iff] at hzmt
    obtain ⟨r_η, hr_η_notMem, hr_η_int, hr_η_all⟩ := hzmt
    have hr_η_ne : ρ_bar r_η ≠ 0 := fun h0 => hr_η_notMem ((hKer_ρ_bar r_η).mp h0)
    obtain ⟨α_η, hα_η⟩ := hInt_mem r_η hr_η_int
    have hAll_B : ∀ y : B'_Y, ρ_bar y ∈ Set.range ι_QW := by
      intro y
      obtain ⟨m, hm⟩ := hr_η_all y
      obtain ⟨β_y, hβ_y⟩ := hInt_mem (r_η ^ m * y) hm
      refine ⟨(α_η ^ m)⁻¹ * β_y, ?_⟩
      have hpow_ne : ρ_bar r_η ^ m ≠ 0 := pow_ne_zero m hr_η_ne
      apply mul_left_cancel₀ hpow_ne
      have hα_pow : ι_QW (α_η ^ m) = ρ_bar r_η ^ m := by rw [map_pow, hα_η]
      calc
        ρ_bar r_η ^ m * ι_QW ((α_η ^ m)⁻¹ * β_y)
          = (ρ_bar r_η ^ m * (ρ_bar r_η ^ m)⁻¹) * ι_QW β_y := by
            rw [map_mul, map_inv₀, hα_pow, mul_assoc]
        _ = 1 * ι_QW β_y := by rw [mul_inv_cancel₀ hpow_ne]
        _ = ρ_bar (r_η ^ m * y) := by rw [one_mul, hβ_y]
        _ = ρ_bar r_η ^ m * ρ_bar y := by rw [map_mul, map_pow]
    obtain ⟨β_b, hβ_b⟩ := hAll_B b_num
    obtain ⟨α_0, hα_0⟩ := hAll_B r'_0
    have hr0_ne : ρ_bar r'_0 ≠ 0 := fun h0 => hr'_0 ((hKer_ρ_bar r'_0).mp h0)
    have hr0_pow_ne : ρ_bar r'_0 ^ k_pow ≠ 0 := pow_ne_zero k_pow hr0_ne
    let z₀ : Q.ResidueField := β_b * (α_0 ^ k_pow)⁻¹
    have hz₀_eq : ι_QW z₀ = res_W t_W := by
      have hα0_pow : ι_QW (α_0 ^ k_pow) = ρ_bar r'_0 ^ k_pow := by rw [map_pow, hα_0]
      apply mul_right_cancel₀ hr0_pow_ne
      calc
        ι_QW z₀ * ρ_bar r'_0 ^ k_pow
          = ι_QW β_b * ((ρ_bar r'_0 ^ k_pow)⁻¹ * ρ_bar r'_0 ^ k_pow) := by
            rw [map_mul, map_inv₀, hα0_pow, mul_assoc]
        _ = ρ_bar b_num := by rw [inv_mul_cancel₀ hr0_pow_ne, mul_one, hβ_b]
        _ = res_W (ρ'_Y b_num) := rfl
        _ = res_W (t_W * (ρ'_Y r'_0) ^ k_pow) := by rw [← ht_eq]
        _ = res_W t_W * ρ_bar r'_0 ^ k_pow := by rw [map_mul, map_pow]; rfl
    obtain ⟨w₀, h_res_w₀⟩ := IsLocalRing.residue_surjective z₀
    obtain ⟨⟨c, s⟩, hw₀⟩ := IsLocalization.surj Q.primeCompl w₀
    have h_alg_Q : ∀ x : ↥V,
        IsLocalRing.residue (Localization.AtPrime Q) (algebraMap ↥V (Localization.AtPrime Q) x) =
          algebraMap ↥V Q.ResidueField x := fun _ => rfl
    have hz₀_frac : z₀ * algebraMap ↥V Q.ResidueField s.1 = algebraMap ↥V Q.ResidueField c := by
      have := congrArg (IsLocalRing.residue (Localization.AtPrime Q)) hw₀
      simpa only [map_mul, h_alg_Q, h_res_w₀] using this
    have hφ_γ : ∀ v : ↥V, res_W (φ_VW v) = ι_QW (algebraMap ↥V Q.ResidueField v) := by
      intro v
      rw [hι_QW_alg]
      change res_W (φ_VW v) = res_W (ρ'_Y (γ'_Y v))
      congr 1
      exact (hγ'_W v).symm
    have h_rel_res : res_W (φ_VW s.1 * t_W - φ_VW c) = 0 := by
      rw [map_sub, map_mul, mul_comm (res_W (φ_VW s.1)), hφ_γ s.1, hφ_γ c, ← hz₀_eq,
        ← map_mul, hz₀_frac, sub_self]
    have h_mem_max : φ_VW s.1 * t_W - φ_VW c ∈ IsLocalRing.maximalIdeal ↥W := by
      rwa [← IsLocalRing.ker_residue, RingHom.mem_ker]
    let P_poly : Polynomial ↥V := Polynomial.C s.1 * Polynomial.X - Polynomial.C c
    have hP_coeff : ∃ i : ℕ, P_poly.coeff i ∉ Q := by
      refine ⟨1, ?_⟩
      have hc1 : P_poly.coeff 1 = s.1 := by
        simp [P_poly, Polynomial.coeff_C]
      rw [hc1]
      exact s.2
    have hP_eval : Polynomial.eval₂ φ_VW t_W P_poly = φ_VW s.1 * t_W - φ_VW c := by
      simp [P_poly]
    exact ht_tr P_poly hP_coeff (hP_eval ▸ h_mem_max)

  
  
  
  have mkQuotVal : ∀ (I : Ideal ↥V) [I.IsPrime],
      ∃ (V_I : ValuationSubring I.ResidueField) (τ_I : ↥V →+* ↥V_I),
        Function.Surjective τ_I ∧
        (∀ c : ↥V, V_I.subtype (τ_I c) = algebraMap ↥V I.ResidueField c) ∧
        RingHom.ker τ_I = I := by
    intro I _
    let π_I : ↥V →+* I.ResidueField := algebraMap ↥V I.ResidueField
    let V_I : ValuationSubring I.ResidueField :=
      { π_I.range with
        mem_or_inv_mem' := by
          intro z
          obtain ⟨w, rfl⟩ := IsLocalRing.residue_surjective z
          obtain ⟨⟨c, s⟩, hws⟩ := IsLocalization.surj I.primeCompl w
          have h_alg : ∀ x : ↥V,
              IsLocalRing.residue (Localization.AtPrime I)
                (algebraMap ↥V (Localization.AtPrime I) x) = π_I x := fun _ => rfl
          have hzw : IsLocalRing.residue (Localization.AtPrime I) w * π_I s.1 = π_I c := by
            have := congrArg (IsLocalRing.residue (Localization.AtPrime I)) hws
            simpa only [map_mul, h_alg] using this
          have hs_ne : π_I s.1 ≠ 0 :=
            fun h0 => s.2 ((Ideal.ker_algebraMap_residueField I).le h0)
          rcases ValuationRing.dvd_total c s.1 with ⟨u, hu⟩ | ⟨u, hu⟩
          · right
            refine ⟨u, ?_⟩
            have hs_eq : π_I s.1 = π_I c * π_I u := by rw [hu, map_mul]
            have hc_ne : π_I c ≠ 0 := left_ne_zero_of_mul (hs_eq ▸ hs_ne)
            have h1 : IsLocalRing.residue (Localization.AtPrime I) w * π_I u = 1 := by
              apply mul_right_cancel₀ hc_ne
              calc
                IsLocalRing.residue (Localization.AtPrime I) w * π_I u * π_I c
                  = IsLocalRing.residue (Localization.AtPrime I) w * (π_I c * π_I u) := by ring
                _ = IsLocalRing.residue (Localization.AtPrime I) w * π_I s.1 := by rw [← hs_eq]
                _ = 1 * π_I c := by rw [hzw, one_mul]
            exact eq_inv_of_mul_eq_one_right h1
          · left
            refine ⟨u, ?_⟩
            apply mul_right_cancel₀ hs_ne
            rw [hzw, hu, map_mul, mul_comm] }
    let τ_I : ↥V →+* ↥V_I := π_I.rangeRestrict
    refine ⟨V_I, τ_I, π_I.rangeRestrict_surjective, fun _ => rfl, ?_⟩
    ext c
    rw [RingHom.mem_ker, Subtype.ext_iff]
    change π_I c = 0 ↔ c ∈ I
    rw [← RingHom.mem_ker, Ideal.ker_algebraMap_residueField]

  obtain ⟨V_Q, τ_Q, hSurj_τQ, hSub_τQ, hKer_τQ⟩ := mkQuotVal Q
  obtain ⟨V_P, τ_P, hSurj_τP, _hSub_τP, hKer_τP⟩ := mkQuotVal P

  
  
  
  have hGoingDownLift : ∀ (A₀ : Type u) [CommRing A₀] (θ₀ : A₀ →+* B'_Y),
      θ₀.Etale →
      IsDomain (A₀ ⧸ Ideal.comap θ₀ q'_η) →
      IsIntegrallyClosed (A₀ ⧸ Ideal.comap θ₀ q'_η) →
      ∀ (p_P : Ideal A₀) [p_P.IsPrime],
        Ideal.comap θ₀ q'_η ≤ p_P →
        p_P ≤ Ideal.comap θ₀ q'_y₀ →
        ∃ (q_P : Ideal B'_Y) (_ : q_P.IsPrime),
          q'_η ≤ q_P ∧ q_P ≤ q'_y₀ ∧ Ideal.comap θ₀ q_P = p_P := by
    intro A₀ _ θ₀ hEt hDom hIC p_P _ hp_lo hp_hi
    let p_η : Ideal A₀ := Ideal.comap θ₀ q'_η
    let p_y₀ : Ideal A₀ := Ideal.comap θ₀ q'_y₀
    have : p_η.IsPrime := Ideal.IsPrime.comap θ₀
    have : p_y₀.IsPrime := Ideal.IsPrime.comap θ₀
    let C₀ := A₀ ⧸ p_η
    let D₀ := B'_Y ⧸ q'_η
    letI : CommRing C₀ := Ideal.Quotient.commRing p_η
    letI : CommRing D₀ := Ideal.Quotient.commRing q'_η
    let π_C : A₀ →+* C₀ := Ideal.Quotient.mk p_η
    let π_D : B'_Y →+* D₀ := Ideal.Quotient.mk q'_η
    have hSurj_πC : Function.Surjective π_C := Ideal.Quotient.mk_surjective
    have hSurj_πD : Function.Surjective π_D := Ideal.Quotient.mk_surjective
    have hKer_πC : RingHom.ker π_C = p_η := Ideal.mk_ker
    have hKer_πD : RingHom.ker π_D = q'_η := Ideal.mk_ker
    let θ_bar : C₀ →+* D₀ :=
      Ideal.Quotient.lift p_η (π_D.comp θ₀) (fun a ha => Ideal.Quotient.eq_zero_iff_mem.mpr ha)
    have hComm_θ_bar : θ_bar.comp π_C = π_D.comp θ₀ := rfl
    have hInj_θ_bar : Function.Injective θ_bar := by
      intro x₁ x₂ h
      obtain ⟨a₁, rfl⟩ := hSurj_πC x₁
      obtain ⟨a₂, rfl⟩ := hSurj_πC x₂
      have hsub : π_D (θ₀ (a₁ - a₂)) = 0 := by
        rw [map_sub, map_sub, sub_eq_zero]
        exact h
      have hmem : θ₀ (a₁ - a₂) ∈ q'_η := Ideal.Quotient.eq_zero_iff_mem.mp hsub
      exact sub_eq_zero.mp (Ideal.Quotient.eq_zero_iff_mem.mpr hmem)

    letI : Algebra C₀ D₀ := θ_bar.toAlgebra
    let R_int : Subalgebra C₀ D₀ := integralClosure C₀ D₀
    have : FaithfulSMul C₀ ↥R_int := ⟨by
      intro c₁ c₂ h
      apply hInj_θ_bar
      have h1 : (c₁ • (1 : ↥R_int)).1 = (c₂ • (1 : ↥R_int)).1 := congrArg Subtype.val (h 1)
      change θ_bar c₁ * 1 = θ_bar c₂ * 1 at h1
      rwa [mul_one, mul_one] at h1⟩
    have : Algebra.HasGoingDown C₀ ↥R_int := inferInstance

    let p_bar_P : Ideal C₀ := Ideal.map π_C p_P
    let p_bar_y₀ : Ideal C₀ := Ideal.map π_C p_y₀
    let q_bar_y₀ : Ideal D₀ := Ideal.map π_D q'_y₀
    have hp_bar_P_comap : Ideal.comap π_C p_bar_P = p_P := by
      rw [Ideal.comap_map_of_surjective' π_C hSurj_πC, hKer_πC, sup_eq_left.mpr hp_lo]
    have hp_bar_y₀_comap : Ideal.comap π_C p_bar_y₀ = p_y₀ := by
      rw [Ideal.comap_map_of_surjective' π_C hSurj_πC, hKer_πC,
        sup_eq_left.mpr (hp_lo.trans hp_hi)]
    have hq_bar_y₀_comap : Ideal.comap π_D q_bar_y₀ = q'_y₀ := by
      rw [Ideal.comap_map_of_surjective' π_D hSurj_πD, hKer_πD, sup_eq_left.mpr hq_le]
    have instPrime_p_bar_P : p_bar_P.IsPrime :=
      Ideal.map_isPrime_of_surjective hSurj_πC (by rwa [hKer_πC])
    have instPrime_p_bar_y₀ : p_bar_y₀.IsPrime :=
      Ideal.map_isPrime_of_surjective hSurj_πC (by rw [hKer_πC]; exact hp_lo.trans hp_hi)
    have instPrime_q_bar_y₀ : q_bar_y₀.IsPrime :=
      Ideal.map_isPrime_of_surjective hSurj_πD (by rwa [hKer_πD])
    have hp_bar_le : p_bar_P ≤ p_bar_y₀ := Ideal.map_mono hp_hi
    have h_over_D₀ : Ideal.comap θ_bar q_bar_y₀ = p_bar_y₀ := by
      ext x
      obtain ⟨a, rfl⟩ := hSurj_πC x
      change π_D (θ₀ a) ∈ q_bar_y₀ ↔ π_C a ∈ p_bar_y₀
      change a ∈ Ideal.comap θ₀ (Ideal.comap π_D q_bar_y₀) ↔ a ∈ Ideal.comap π_C p_bar_y₀
      rw [hq_bar_y₀_comap, hp_bar_y₀_comap]

    let q_int_y₀ : Ideal ↥R_int := Ideal.comap R_int.val q_bar_y₀
    have : q_int_y₀.IsPrime := Ideal.IsPrime.comap R_int.val
    have : q_int_y₀.LiesOver p_bar_y₀ := ⟨by rw [Ideal.under_def, ← h_over_D₀]; rfl⟩
    obtain ⟨q_int_P, hq_int_le, instPrime_q_int_P, instLies_P⟩ :=
      Ideal.exists_ideal_le_liesOver_of_le q_int_y₀ hp_bar_le
    have : q_int_P.IsPrime := instPrime_q_int_P
    have hq_int_over : Ideal.comap (algebraMap C₀ ↥R_int) q_int_P = p_bar_P := by
      have hover := instLies_P.over
      rwa [Ideal.under_def, eq_comm] at hover

    
    letI : Algebra A₀ B'_Y := θ₀.toAlgebra
    have : Algebra.Etale A₀ B'_Y := RingHom.Etale.toAlgebra hEt
    have hzmt : Algebra.ZariskisMainProperty A₀ q'_y₀ :=
      Algebra.ZariskisMainProperty.of_finiteType (R := A₀) q'_y₀
    rw [Algebra.zariskisMainProperty_iff] at hzmt
    obtain ⟨r_raw, hr_raw_notMem, hr_raw_int, hr_raw_all⟩ := hzmt
    let r : D₀ := π_D r_raw
    have h_int_map : ∀ y : B'_Y, IsIntegral A₀ y → π_D y ∈ R_int :=
      fun y hy => IsIntegral.map_of_comp_eq π_C π_D hComm_θ_bar hy
    have hr_mem : r ∈ R_int := h_int_map r_raw hr_raw_int
    let r₀ : ↥R_int := ⟨r, hr_mem⟩
    have hD₀_all : ∀ x : D₀, ∃ m : ℕ, r ^ m * x ∈ R_int := by
      intro x
      obtain ⟨y, rfl⟩ := hSurj_πD x
      obtain ⟨m, hm⟩ := hr_raw_all y
      refine ⟨m, ?_⟩
      have := h_int_map (r_raw ^ m * y) hm
      simpa only [map_mul, map_pow] using this
    have hr_notMem_y₀ : r ∉ q_bar_y₀ := by
      intro hmem
      exact hr_raw_notMem (hq_bar_y₀_comap.le hmem)
    have hr₀_notMem : r₀ ∉ q_int_P := fun hmem => hr_notMem_y₀ (hq_int_le hmem)
    have hr₀_pow_notMem : ∀ m : ℕ, r₀ ^ m ∉ q_int_P :=
      fun m hm => hr₀_notMem (instPrime_q_int_P.mem_of_pow_mem m hm)

    let S_sat : Set D₀ :=
      {x : D₀ | ∃ (m : ℕ) (hm : r ^ m * x ∈ R_int), (⟨r ^ m * x, hm⟩ : ↥R_int) ∈ q_int_P}
    have h_indep : ∀ (x : D₀) (k : ℕ) (hk : r ^ k * x ∈ R_int),
        x ∈ S_sat ↔ (⟨r ^ k * x, hk⟩ : ↥R_int) ∈ q_int_P := by
      intro x k hk
      constructor
      · rintro ⟨m, hm, hmem⟩
        have heq : r₀ ^ m * (⟨r ^ k * x, hk⟩ : ↥R_int) = r₀ ^ k * (⟨r ^ m * x, hm⟩ : ↥R_int) := by
          ext; change r ^ m * (r ^ k * x) = r ^ k * (r ^ m * x); ring
        have hmul : r₀ ^ m * (⟨r ^ k * x, hk⟩ : ↥R_int) ∈ q_int_P := by
          rw [heq]; exact q_int_P.mul_mem_left (r₀ ^ k) hmem
        exact (instPrime_q_int_P.mem_or_mem hmul).resolve_left (hr₀_pow_notMem m)
      · exact fun h => ⟨k, hk, h⟩

    let q_bar_P : Ideal D₀ :=
      { carrier := S_sat
        zero_mem' := by
          refine ⟨0, by simp, ?_⟩
          convert q_int_P.zero_mem using 1
          ext; simp
        add_mem' := by
          rintro x y ⟨m₁, hm₁, h₁⟩ ⟨m₂, hm₂, h₂⟩
          let u₁ : ↥R_int := ⟨r ^ m₁ * x, hm₁⟩
          let u₂ : ↥R_int := ⟨r ^ m₂ * y, hm₂⟩
          let s_val : ↥R_int := r₀ ^ m₂ * u₁ + r₀ ^ m₁ * u₂
          have hs_mem : s_val ∈ q_int_P :=
            q_int_P.add_mem (q_int_P.mul_mem_left _ h₁) (q_int_P.mul_mem_left _ h₂)
          have hsum_eq : r ^ (m₁ + m₂) * (x + y) = s_val.1 := by
            change r ^ (m₁ + m₂) * (x + y) = r ^ m₂ * (r ^ m₁ * x) + r ^ m₁ * (r ^ m₂ * y)
            ring
          refine ⟨m₁ + m₂, hsum_eq ▸ s_val.2, ?_⟩
          convert hs_mem using 1
          ext; exact hsum_eq
        smul_mem' := by
          rintro d x ⟨m_x, hm_x, hx⟩
          obtain ⟨m_d, hm_d⟩ := hD₀_all d
          let u_d : ↥R_int := ⟨r ^ m_d * d, hm_d⟩
          let u_x : ↥R_int := ⟨r ^ m_x * x, hm_x⟩
          let prod_val : ↥R_int := u_d * u_x
          have hp_mem : prod_val ∈ q_int_P := q_int_P.mul_mem_left u_d hx
          have hmul_eq : r ^ (m_d + m_x) * (d • x) = prod_val.1 := by
            change r ^ (m_d + m_x) * (d * x) = (r ^ m_d * d) * (r ^ m_x * x)
            ring
          refine ⟨m_d + m_x, hmul_eq ▸ prod_val.2, ?_⟩
          convert hp_mem using 1
          ext; exact hmul_eq }

    have instPrime_q_bar_P : q_bar_P.IsPrime := by
      rw [Ideal.isPrime_iff]
      refine ⟨?_, ?_⟩
      · intro htop
        have h1 : (1 : D₀) ∈ q_bar_P := htop.symm ▸ Submodule.mem_top
        have h1_mem : (⟨r ^ 0 * 1, by simp⟩ : ↥R_int) ∈ q_int_P :=
          (h_indep 1 0 (by simp)).mp h1
        have h1_eq : (⟨r ^ 0 * 1, by simp⟩ : ↥R_int) = 1 := by ext; simp
        exact instPrime_q_int_P.ne_top ((Ideal.eq_top_iff_one q_int_P).mpr (h1_eq ▸ h1_mem))
      · intro x y hxy
        obtain ⟨m_x, hm_x⟩ := hD₀_all x
        obtain ⟨m_y, hm_y⟩ := hD₀_all y
        let u_x : ↥R_int := ⟨r ^ m_x * x, hm_x⟩
        let u_y : ↥R_int := ⟨r ^ m_y * y, hm_y⟩
        have hxy_eq : r ^ (m_x + m_y) * (x * y) = (u_x * u_y).1 := by
          change r ^ (m_x + m_y) * (x * y) = (r ^ m_x * x) * (r ^ m_y * y)
          ring
        have hprod_mem : (⟨r ^ (m_x + m_y) * (x * y), hxy_eq ▸ (u_x * u_y).2⟩ : ↥R_int) ∈ q_int_P :=
          (h_indep (x * y) (m_x + m_y) (hxy_eq ▸ (u_x * u_y).2)).mp hxy
        have hsub : (⟨r ^ (m_x + m_y) * (x * y), hxy_eq ▸ (u_x * u_y).2⟩ : ↥R_int) = u_x * u_y := by
          ext; exact hxy_eq
        rcases instPrime_q_int_P.mem_or_mem (hsub ▸ hprod_mem) with hx | hy
        · exact Or.inl ⟨m_x, hm_x, hx⟩
        · exact Or.inr ⟨m_y, hm_y, hy⟩

    have hq_bar_le : q_bar_P ≤ q_bar_y₀ := by
      rintro x ⟨m, hm, hmem⟩
      have hy₀_mem : r ^ m * x ∈ q_bar_y₀ := hq_int_le hmem
      have hr_pow : r ^ m ∉ q_bar_y₀ :=
        fun h => hr_notMem_y₀ (instPrime_q_bar_y₀.mem_of_pow_mem m h)
      exact (instPrime_q_bar_y₀.mem_or_mem hy₀_mem).resolve_left hr_pow

    have hq_bar_comap : Ideal.comap θ_bar q_bar_P = p_bar_P := by
      ext c
      have hc_alg : (algebraMap C₀ ↥R_int c).1 = θ_bar c := rfl
      have hc_mem : r ^ 0 * θ_bar c ∈ R_int := by
        rw [pow_zero, one_mul, ← hc_alg]
        exact (algebraMap C₀ ↥R_int c).2
      change θ_bar c ∈ S_sat ↔ c ∈ p_bar_P
      rw [h_indep (θ_bar c) 0 hc_mem, ← hq_int_over, Ideal.mem_comap]
      have hsub : (⟨r ^ 0 * θ_bar c, hc_mem⟩ : ↥R_int) = algebraMap C₀ ↥R_int c := by
        ext; change r ^ 0 * θ_bar c = θ_bar c; simp
      rw [hsub]

    let q_P : Ideal B'_Y := Ideal.comap π_D q_bar_P
    have instPrime_qP : q_P.IsPrime := Ideal.IsPrime.comap π_D
    refine ⟨q_P, instPrime_qP, ?_, ?_, ?_⟩
    · rw [← hKer_πD]
      intro b hb
      change π_D b ∈ q_bar_P
      rw [RingHom.mem_ker.mp hb]
      exact q_bar_P.zero_mem
    · calc
        q_P ≤ Ideal.comap π_D q_bar_y₀ := Ideal.comap_mono hq_bar_le
        _ = q'_y₀ := hq_bar_y₀_comap
    · calc
        Ideal.comap θ₀ q_P = Ideal.comap (π_D.comp θ₀) q_bar_P := Ideal.comap_comap θ₀ π_D
        _ = Ideal.comap (θ_bar.comp π_C) q_bar_P := by rw [← hComm_θ_bar]
        _ = Ideal.comap π_C (Ideal.comap θ_bar q_bar_P) := (Ideal.comap_comap π_C θ_bar).symm
        _ = Ideal.comap π_C p_bar_P := by rw [hq_bar_comap]
        _ = p_P := hp_bar_P_comap

  
  
  
  rcases hChart with ⟨θ_sm, hEt_sm, hComm_sm⟩ | ⟨a, θ_nod, ha_ne, hEt_nod, hComm_nod⟩
  · 
    
    
    let σ : Polynomial ↥V →+* κ_W := ρ_bar.comp θ_sm
    have hKer_σ : RingHom.ker σ = Ideal.comap θ_sm q'_η := by
      ext f; exact hKer_ρ_bar (θ_sm f)
    have hσ_C : ∀ c : ↥V, σ (Polynomial.C c) = ι_QW (algebraMap ↥V Q.ResidueField c) := by
      intro c
      rw [hι_QW_alg]
      change ρ_bar ((θ_sm.comp Polynomial.C) c) = ρ_bar (γ'_Y c)
      rw [hComm_sm]
    obtain ⟨f₀, hf₀_tr⟩ := hNonAlg (Polynomial ↥V) Polynomial.C θ_sm hEt_sm hComm_sm
    have hX_tr : σ Polynomial.X ∉ Set.range ι_QW := by
      intro hX_mem
      have hAll_poly : ∀ f : Polynomial ↥V, σ f ∈ ι_QW.range := by
        intro f
        induction f using Polynomial.induction_on with
        | C c => rw [hσ_C]; exact ⟨_, rfl⟩
        | add p q hp hq => rw [map_add]; exact ι_QW.range.add_mem hp hq
        | monomial n c _ih =>
          rw [map_mul, map_pow, hσ_C]
          exact ι_QW.range.mul_mem ⟨_, rfl⟩ (ι_QW.range.pow_mem hX_mem _)
      exact hf₀_tr (hAll_poly f₀)

    let ψ_Q : Polynomial ↥V →+* Polynomial ↥V_Q := Polynomial.mapRingHom τ_Q
    have hSurj_ψQ : Function.Surjective ψ_Q := Polynomial.map_surjective τ_Q hSurj_τQ
    let ε_Q : Polynomial ↥V_Q →+* κ_W :=
