                _ ≤ max ((Polynomial.C lam_0).degree + Polynomial.X.degree) 0 :=
                    max_le_max (Polynomial.degree_mul_le _ _) Polynomial.degree_C_le
                _ ≤ max (0 + 1) 0 :=
                    max_le_max (add_le_add Polynomial.degree_C_le Polynomial.degree_X_le) le_rfl
                _ = 1 := by decide
            exact lt_of_le_of_lt hdeg_rhs (by
              rw [Polynomial.degree_X_pow]
              change (WithBot.some 1 : WithBot ℕ) < WithBot.some (p ^ e)
              exact WithBot.coe_lt_coe.mpr (Nat.lt_of_lt_of_le Nat.one_lt_two hpe_ge2))
          have hderiv_pert : Polynomial.derivative g_pert = Polynomial.C lam_0 := by
            simp only [g_pert, map_add, map_sub, Polynomial.derivative_X_pow,
              Polynomial.derivative_C_mul_X, Polynomial.derivative_C, sub_zero]
            have hcast0 : ((p ^ e : ℕ) : K) = 0 := by
              rw [Nat.cast_pow, CharP.cast_eq_zero K p, zero_pow he0]
            rw [hcast0, map_zero, zero_mul, zero_add]
          have hg_pert_sep : g_pert.Separable := by
            refine ⟨0, Polynomial.C lam_0⁻¹, ?_⟩
            rw [hderiv_pert, zero_mul, zero_add, ← Polynomial.C_mul,
              inv_mul_cancel₀ hlam0_ne, Polynomial.C_1]
          have hg_pert_sp : g_pert.Splits :=
            IsSepClosed.splits_of_separable g_pert hg_pert_sep
          obtain ⟨M_roots, hM_eq⟩ := Polynomial.splits_iff_exists_multiset.mp hg_pert_sp
          rw [hg_pert_monic.leadingCoeff, Polynomial.C_1, one_mul] at hM_eq
          let u_pert : ↥W_0 := u_f + ι_0 δ_0 * ⟨T_0, hT0⟩
          have hπ_upert : π_W u_pert = π_W u_f := by
            have hδ_W : ι_0 δ_0 ∈ m_W := (hMax0 δ_0).mpr hδ0_mem
            have hprod_W : ι_0 δ_0 * ⟨T_0, hT0⟩ ∈ m_W := Ideal.mul_mem_right _ m_W hδ_W
            rw [map_add, Ideal.Quotient.eq_zero_iff_mem.mpr hprod_W, add_zero]
          have hu_pert_unit : IsUnit u_pert := by
            rw [← IsLocalRing.notMem_maximalIdeal, ← Ideal.Quotient.eq_zero_iff_mem, hπ_upert,
              Ideal.Quotient.eq_zero_iff_mem]
            exact IsLocalRing.notMem_maximalIdeal.mpr hu_f
          have hg_pert_ev : Polynomial.eval₂ φ_KF0 T_0 g_pert =
              φ_KF0 c_f * W_0.subtype u_pert := by
            have hf_ev : Polynomial.eval₂ φ_KF0 T_0 f = T_0 ^ (p ^ e) - φ_KF0 β := by
              rw [hf_eq, Polynomial.eval₂_sub, Polynomial.eval₂_pow,
                Polynomial.eval₂_X, Polynomial.eval₂_C]
            simp only [g_pert, Polynomial.eval₂_add, Polynomial.eval₂_sub,
              Polynomial.eval₂_pow, Polynomial.eval₂_mul, Polynomial.eval₂_X,
              Polynomial.eval₂_C]
            change T_0 ^ (p ^ e) + (φ_KF0 (c_f * R.subtype δ_0) * T_0 - φ_KF0 β) =
              φ_KF0 c_f * (W_0.subtype u_f + φ_KF0 (R.subtype δ_0) * T_0)
            rw [map_mul]
            linear_combination -hf_ev - hcf_eq
          have hg_pert_not_alg : ¬ IsCosetAlg (Polynomial.eval₂ φ_KF0 T_0 g_pert) := by
            intro halg
            exact huf_not_alg (hπ_upert ▸ halg c_f u_pert hc_f hu_pert_unit hg_pert_ev.symm)
          have hprod_ev : Polynomial.eval₂ φ_KF0 T_0 g_pert =
              (M_roots.map (fun a : K => T_0 - φ_KF0 a)).prod := by
            let ev : Polynomial K →+* F_0 := Polynomial.eval₂RingHom φ_KF0 T_0
            change ev g_pert = _
            rw [hM_eq, map_multiset_prod, Multiset.map_map]
            congr 1
            exact Multiset.map_congr rfl fun a _ => by simp [ev]
          by_contra h_all_roots
          push Not at h_all_roots
          apply hg_pert_not_alg
          rw [hprod_ev]
          refine (isCosetAlg_multiset_prod _ ?_).2
          intro x hx
          rcases Multiset.mem_map.mp hx with ⟨a, ha_M, rfl⟩
          have hlin_ne : T_0 - φ_KF0 a ≠ 0 := by
            have hX_ne := Polynomial.X_sub_C_ne_zero a
            have hev := hTrans_K (Polynomial.X - Polynomial.C a) hX_ne
            simpa using hev
          exact ⟨hlin_ne, h_all_roots a⟩
      · have _ : CharZero K := CharP.charP_to_charZero K
        let α_0 : K := -f.coeff 0
        have hf_eq : f = Polynomial.X - Polynomial.C α_0 :=
          monic_irred_sep_eq_X_sub_C f hf_monic hf_irred hf_irred.separable
        refine ⟨α_0, ?_⟩
        have hev_eq : Polynomial.eval₂ φ_KF0 T_0 f = T_0 - φ_KF0 α_0 := by
          rw [hf_eq, Polynomial.eval₂_sub, Polynomial.eval₂_X, Polynomial.eval₂_C]
        rwa [← hev_eq]
    obtain ⟨α_0, hα0_not_alg⟩ := hex_linear
    have hT0_sub_ne : T_0 - φ_KF0 α_0 ≠ 0 := by
      have hev := hTrans_K (Polynomial.X - Polynomial.C α_0) (Polynomial.X_sub_C_ne_zero α_0)
      simpa using hev
    obtain ⟨γ_0, w_0, hγ0_ne, hw0_unit, hw0_eq⟩ := hValEq (T_0 - φ_KF0 α_0) hT0_sub_ne
    have hw0_tr_res : Transcendental k_R (π_W w_0) := by
      intro halg
      exact hα0_not_alg (isCosetAlg_of_norm γ_0 w_0 hγ0_ne hw0_unit hw0_eq halg)
    have hw0_tr : ∀ Q : Polynomial ↥R,
        (∃ j : ℕ, Q.coeff j ∉ m_R) → Polynomial.eval₂ ι_0 w_0 Q ∉ m_W :=
      (tr_iff w_0).mpr hw0_tr_res
    
    have hγ_inv_not_R : γ_0⁻¹ ∉ R := by
      intro hγ_inv
      let r_inv : ↥R := ⟨γ_0⁻¹, hγ_inv⟩
      have hφγ_ne : φ_KF0 γ_0 ≠ 0 := (map_ne_zero φ_KF0).mpr hγ0_ne
      have hs0_eq : φ_KF0 (γ_0⁻¹ * α_0) = φ_KF0 γ_0⁻¹ * T_0 - W_0.subtype w_0 := by
        apply mul_left_cancel₀ hφγ_ne
        calc φ_KF0 γ_0 * φ_KF0 (γ_0⁻¹ * α_0)
            = φ_KF0 ((γ_0 * γ_0⁻¹) * α_0) := by rw [← map_mul, mul_assoc]
          _ = φ_KF0 α_0 := by rw [mul_inv_cancel₀ hγ0_ne, one_mul]
          _ = (φ_KF0 γ_0 * φ_KF0 γ_0⁻¹) * T_0 - (T_0 - φ_KF0 α_0) := by
                rw [← map_mul, mul_inv_cancel₀ hγ0_ne, map_one, one_mul]; ring
          _ = φ_KF0 γ_0 * (φ_KF0 γ_0⁻¹ * T_0 - W_0.subtype w_0) := by
                rw [← hw0_eq]; ring
      have hs0_W0 : φ_KF0 (γ_0⁻¹ * α_0) ∈ W_0 := by
        rw [hs0_eq]
        exact W_0.toSubring.sub_mem (W_0.toSubring.mul_mem (hR0 r_inv) hT0) w_0.2
      let s_0 : ↥R := ⟨γ_0⁻¹ * α_0, hK_mem W_0 hR0 hMax0 _ hs0_W0⟩
      have hw_add : w_0 + ι_0 s_0 = ι_0 r_inv * ⟨T_0, hT0⟩ := by
        apply Subtype.ext
        change W_0.subtype w_0 + φ_KF0 (γ_0⁻¹ * α_0) = φ_KF0 γ_0⁻¹ * T_0
        rw [hs0_eq]
        ring
      have hw_add_max : w_0 + ι_0 s_0 ∈ m_W := by
        rw [hw_add]
        exact Ideal.mul_mem_left _ _ hT0_max
      let Q_lin : Polynomial ↥R := Polynomial.X + Polynomial.C s_0
      have hQ_prim : ∃ j : ℕ, Q_lin.coeff j ∉ m_R :=
        ⟨1, by
          rw [Polynomial.coeff_add, Polynomial.coeff_X_one, Polynomial.coeff_C_succ, add_zero]
          exact one_not_mem_maxR⟩
      have hQ_ev : Polynomial.eval₂ ι_0 w_0 Q_lin = w_0 + ι_0 s_0 := by
        simp [Q_lin]
      exact hw0_tr Q_lin hQ_prim (hQ_ev ▸ hw_add_max)
    have hγ0_R : γ_0 ∈ R :=
      (ValuationSubring.mem_or_inv_mem R γ_0).resolve_right hγ_inv_not_R
    let π_E : ↥R := ⟨γ_0, hγ0_R⟩
    have hπE_ne : π_E ≠ 0 := fun h0 => hγ0_ne (congrArg Subtype.val h0)
    have hπE_max : π_E ∈ m_R := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      rcases hu.exists_right_inv with ⟨y, hy⟩
      have hy_val : γ_0 * y.1 = 1 := congrArg Subtype.val hy
      have hy_eq : y.1 = γ_0⁻¹ := by
        calc y.1 = γ_0⁻¹ * (γ_0 * y.1) := by rw [← mul_assoc, inv_mul_cancel₀ hγ0_ne, one_mul]
          _ = γ_0⁻¹ := by rw [hy_val, mul_one]
      exact hγ_inv_not_R (hy_eq ▸ y.2)
    have hα0_eq : φ_KF0 α_0 = T_0 - φ_KF0 (R.subtype π_E) * W_0.subtype w_0 := by
      change φ_KF0 α_0 = T_0 - φ_KF0 γ_0 * W_0.subtype w_0
      linear_combination hw0_eq
    have hα0_W0 : φ_KF0 α_0 ∈ W_0 := by
      rw [hα0_eq]
      exact W_0.toSubring.sub_mem hT0 (W_0.toSubring.mul_mem (hR0 π_E) w_0.2)
    let c_E : ↥R := ⟨α_0, hK_mem W_0 hR0 hMax0 _ hα0_W0⟩
    have hcE_W0 : ι_0 c_E = ⟨T_0, hT0⟩ - ι_0 π_E * w_0 := Subtype.ext hα0_eq
    have hcE_max : c_E ∈ m_R := by
      apply (hMax0 c_E).mp
      change ι_0 c_E ∈ m_W
      rw [hcE_W0]
      exact Ideal.sub_mem m_W hT0_max (Ideal.mul_mem_right w_0 m_W ((hMax0 π_E).mpr hπE_max))
    exact ⟨c_E, π_E, w_0, hcE_max, hπE_max, hπE_ne, hw0_eq, hw0_tr⟩

theorem weil_etale_disc_uniqueness_and_linear_gauss_coset (K : Type u) [Field K] [IsSepClosed K]
    (m : ℕ) (R : ValuationSubring K) (hPkg_R : IsValuationRingAlgPackage m R)
    (hMax_R : IsLocalRing.maximalIdeal ↥R ≠ ⊥)
    (a_opt : Option ↥R)
    (M_0 W_B_sch X_0_sch : AlgebraicGeometry.Scheme.{u})
    (g_M0 : M_0 ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
    (g_WB : W_B_sch ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
    (f_0 : X_0_sch ⟶ W_B_sch)
    (m_0 : ↥M_0) (u₀_WB : ↥W_B_sch)
    (e_0 : W_B_sch ⟶ M_0)
    (F_0 F_WB : Type u) [Field F_0] [Field F_WB]
    (η_M0 : AlgebraicGeometry.Spec (CommRingCat.of F_0) ⟶ M_0)
    (η_WB : AlgebraicGeometry.Spec (CommRingCat.of F_WB) ⟶ W_B_sch)
    (η_X0 : AlgebraicGeometry.Spec (CommRingCat.of F_WB) ⟶ X_0_sch)
    (φ_KF0 : K →+* F_0) (φ_F0_FWB : F_0 →+* F_WB) (T_0 : F_0)
    (hAff_WB : AlgebraicGeometry.IsAffine W_B_sch)
    (hSS_WB : IsStrictlySemistableCurveOverValuation R g_WB)
    (hSS_X0 : IsStrictlySemistableCurveOverValuation R (f_0 ≫ g_WB))
    (hStd : IsStandardModelCoordDatum R a_opt M_0 g_M0 m_0 η_M0 φ_KF0 T_0)
    (hEt_e0 : AlgebraicGeometry.Etale e_0)
    (he0_comm : e_0 ≫ g_M0 = g_WB)
    (he0_m0 : e_0.base ⁻¹' {m_0} = {u₀_WB})
    (hFunc_WB : IsSchemeFunctionField W_B_sch F_WB η_WB)
    (hFunc_X0 : IsSchemeFunctionField X_0_sch F_WB η_X0)
    (hηX0_f0 : η_X0 ≫ f_0 = η_WB)
    (hη_e0 : η_WB ≫ e_0 = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_F0_FWB) ≫ η_M0) :
    let s_R := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.maximalIdeal ↥R).ResidueField))
    let g_X0 := f_0 ≫ g_WB
    (∀ (c₁ π₁ c₂ π₂ : ↥R) (W₁ W₂ : ValuationSubring F_WB),
      π₁ ≠ 0 → π₂ ≠ 0 →
      IsDiscValuationOnWB R u₀_WB η_WB (φ_F0_FWB.comp φ_KF0) (φ_F0_FWB T_0) c₁ π₁ W₁ →
      IsDiscValuationOnWB R u₀_WB η_WB (φ_F0_FWB.comp φ_KF0) (φ_F0_FWB T_0) c₂ π₂ W₂ →
      (W₁ = W₂ ↔ IsValDiscEq ↥R c₁ π₁ c₂ π₂)) ∧
    (∀ E ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_X0 s_R),
      (∀ q ∈ E, f_0.base ((CategoryTheory.Limits.pullback.fst g_X0 s_R).base q) = u₀_WB) →
      ∀ W : ValuationSubring F_WB,
        IsComponentStalkVal R g_X0 η_X0 E W →
        ∃ (c_E π_E : ↥R),
          c_E ∈ IsLocalRing.maximalIdeal ↥R ∧
          π_E ∈ IsLocalRing.maximalIdeal ↥R ∧
          π_E ≠ 0 ∧
          (∀ a₀ : ↥R, a_opt = some a₀ → ¬ IsValDiscLE ↥R c_E π_E 0 a₀) ∧
          IsDiscValuationOnWB R u₀_WB η_WB (φ_F0_FWB.comp φ_KF0) (φ_F0_FWB T_0) c_E π_E W) :=
by
  classical
  dsimp only
  let φ_KF : K →+* F_WB := φ_F0_FWB.comp φ_KF0
  let T_WB : F_WB := φ_F0_FWB T_0
  have hTrans_T0 : ∀ P : Polynomial ↥R, P ≠ 0 →
      Polynomial.eval₂ (φ_KF0.comp R.subtype) T_0 P ≠ 0 :=
    (weil_gauss_disc_valuation_and_standard_base_tree_model K m R hPkg_R hMax_R
      a_opt M_0 g_M0 m_0 F_0 η_M0 φ_KF0 T_0 hStd).1.2.1
  obtain ⟨instDomA0, instDomB, φ_A0, φ_B, p_0, q_0,
      ⟨hEt_α0, hFrac_A0, hFrac_B, hComm_φ, hp0_max, hq0_prime, hMap_pq, hRes_surj⟩,
      hGen_F0, hBrVal, hBrComp⟩ :=
    weil_standard_etale_bridge_and_contracted_component_transcendence
      K m R hPkg_R hMax_R a_opt M_0 W_B_sch X_0_sch g_M0 g_WB f_0 m_0 u₀_WB e_0
      F_0 F_WB η_M0 η_WB η_X0 φ_KF0 φ_F0_FWB T_0
      hAff_WB hSS_X0 hStd hEt_e0 he0_comm he0_m0 hFunc_WB hFunc_X0 hηX0_f0 hη_e0
  letI : IsDomain ↑(M_0.presheaf.obj (Opposite.op ⊤)) := instDomA0
  letI : IsDomain ↑(W_B_sch.presheaf.obj (Opposite.op ⊤)) := instDomB
  obtain ⟨hEtValUniq, hResDescent⟩ :=
    weil_etale_singleton_fiber_valuation_uniqueness_and_residue_descent
      ↥R ↑(M_0.presheaf.obj (Opposite.op ⊤)) ↑(W_B_sch.presheaf.obj (Opposite.op ⊤)) F_0 F_WB
      (e_0.appTop).hom φ_A0 φ_B (φ_KF0.comp R.subtype) φ_F0_FWB p_0 q_0
      (@weil_etale_domain_over_integrallyClosed_isIntegrallyClosed)
      hEt_α0 hFrac_A0 hFrac_B hComm_φ hp0_max hq0_prime hMap_pq hRes_surj
  obtain ⟨hRatDiscUniq, hRatLinearCoset⟩ :=
    weil_rational_funcField_gauss_uniqueness_and_linear_coset
      K R hMax_R hPkg_R.2.2.2.1 F_0 φ_KF0 T_0 hTrans_T0 hGen_F0
  have one_not_mem_maxR : (1 : ↥R) ∉ IsLocalRing.maximalIdeal ↥R := fun h1 =>
    (IsLocalRing.maximalIdeal.isMaximal ↥R).ne_top (Ideal.eq_top_iff_one _ |>.mpr h1)
  have jW_mem_max_iff : ∀ (W : ValuationSubring F_WB) (x : ↥(W.comap φ_F0_FWB)),
      ((φ_F0_FWB.comp (W.comap φ_F0_FWB).subtype).codRestrict W.toSubring (fun z => z.2)) x ∈
        IsLocalRing.maximalIdeal ↥W ↔
      x ∈ IsLocalRing.maximalIdeal ↥(W.comap φ_F0_FWB) := by
    intro W x
    let W₀ := W.comap φ_F0_FWB
    let jW : ↥W₀ →+* ↥W := (φ_F0_FWB.comp W₀.subtype).codRestrict W.toSubring (fun z => z.2)
    change jW x ∈ IsLocalRing.maximalIdeal ↥W ↔ x ∈ IsLocalRing.maximalIdeal ↥W₀
    rw [← not_iff_not, IsLocalRing.notMem_maximalIdeal, IsLocalRing.notMem_maximalIdeal]
    refine ⟨fun hu => ?_, fun hx => jW.isUnit_map hx⟩
    have hx0 : x.1 ≠ 0 := by
      intro h0
      have hj0 : jW x = 0 := Subtype.ext (by change φ_F0_FWB x.1 = 0; rw [h0, map_zero])
      rw [hj0] at hu
      exact not_isUnit_zero hu
    rcases hu.exists_right_inv with ⟨v, hv⟩
    have hv_val : φ_F0_FWB x.1 * v.1 = 1 := congrArg Subtype.val hv
    have hx_ne_FWB : φ_F0_FWB x.1 ≠ 0 := (map_ne_zero φ_F0_FWB).mpr hx0
    have hv_eq : v.1 = φ_F0_FWB x.1⁻¹ := by
      apply mul_left_cancel₀ hx_ne_FWB
      rw [hv_val, ← map_mul, mul_inv_cancel₀ hx0, map_one]
    have hx_inv_mem : x.1⁻¹ ∈ W₀ := by
      change φ_F0_FWB x.1⁻¹ ∈ W
      rw [← hv_eq]
      exact v.2
    exact isUnit_iff_exists_inv.mpr ⟨⟨x.1⁻¹, hx_inv_mem⟩, Subtype.ext (mul_inv_cancel₀ hx0)⟩
  have hDiscLE_of_same_W : ∀ (c₁ π₁ c₂ π₂ : ↥R) (W : ValuationSubring F_WB),
      π₁ ≠ 0 → π₂ ≠ 0 →
      IsDiscValuationOnWB R u₀_WB η_WB φ_KF T_WB c₁ π₁ W →
      IsDiscValuationOnWB R u₀_WB η_WB φ_KF T_WB c₂ π₂ W →
      IsValDiscLE ↥R c₁ π₁ c₂ π₂ := by
    intro c₁ π₁ c₂ π₂ W hπ₁ hπ₂ hD₁ hD₂
    obtain ⟨_, _, hR₁, w₁, _, _, _, hMax₁, hw₁, hQ₁⟩ := hD₁
    obtain ⟨_, _, _, w₂, _, _, _, _, hw₂, _⟩ := hD₂
    have hK_mem : ∀ z : K, φ_KF z ∈ W → z ∈ R := by
      intro z hzW
      by_contra hzR
      have hz0 : z ≠ 0 := fun h0 => hzR (h0 ▸ R.zero_mem)
      rcases ValuationSubring.mem_or_inv_mem R z with hz | hz_inv
      · exact hzR hz
      · let r_inv : ↥R := ⟨z⁻¹, hz_inv⟩
        have hr_max : r_inv ∈ IsLocalRing.maximalIdeal ↥R := by
          rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
          intro hu
          rcases hu.exists_right_inv with ⟨y, hy⟩
          have hy_val : z⁻¹ * y.1 = 1 := congrArg Subtype.val hy
          have hy_eq : y.1 = z := by
            calc y.1 = z * (z⁻¹ * y.1) := by rw [← mul_assoc, mul_inv_cancel₀ hz0, one_mul]
              _ = z := by rw [hy_val, mul_one]
          exact hzR (hy_eq ▸ y.2)
        have hw_max : (⟨φ_KF (R.subtype r_inv), hR₁ r_inv⟩ : ↥W) ∈ IsLocalRing.maximalIdeal ↥W :=
          (hMax₁ r_inv).mpr hr_max
        have h1_eq : (⟨φ_KF z, hzW⟩ : ↥W) * ⟨φ_KF (R.subtype r_inv), hR₁ r_inv⟩ = 1 := by
          apply Subtype.ext
          change φ_KF z * φ_KF z⁻¹ = 1
          rw [← map_mul, mul_inv_cancel₀ hz0, map_one]
        have h1_max : (1 : ↥W) ∈ IsLocalRing.maximalIdeal ↥W := by
          rw [← h1_eq]
          exact Ideal.mul_mem_left _ _ hw_max
        exact (IsLocalRing.maximalIdeal.isMaximal ↥W).ne_top (Ideal.eq_top_iff_one _ |>.mpr h1_max)
    have hπ₁_K : (π₁ : K) ≠ 0 := fun h => hπ₁ (Subtype.ext h)
    have hπ₂_K : (π₂ : K) ≠ 0 := fun h => hπ₂ (Subtype.ext h)
    have h_dvd : ∃ r : ↥R, π₁ = r * π₂ := by
      by_contra h_not
      rcases ValuationSubring.mem_or_inv_mem R ((π₂ : K) * (π₁ : K)⁻¹) with hz | hz_inv
      · let r' : ↥R := ⟨(π₂ : K) * (π₁ : K)⁻¹, hz⟩
        have hπ₂_eq : π₂ = r' * π₁ := by
          apply Subtype.ext
          change (π₂ : K) = ((π₂ : K) * (π₁ : K)⁻¹) * (π₁ : K)
          rw [mul_assoc, inv_mul_cancel₀ hπ₁_K, mul_one]
        have hr'_max : r' ∈ IsLocalRing.maximalIdeal ↥R := by
          rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
          intro hu
          rcases hu.exists_left_inv with ⟨u, hu_eq⟩
          apply h_not
          refine ⟨u, ?_⟩
          rw [hπ₂_eq, ← mul_assoc, hu_eq, one_mul]
        have hdiff_F : φ_KF (R.subtype π₁) * (W.subtype w₁ - φ_KF (R.subtype r') * W.subtype w₂) =
            φ_KF (R.subtype (c₂ - c₁)) := by
          have hπ₂_map : φ_KF (R.subtype π₂) = φ_KF (R.subtype r') * φ_KF (R.subtype π₁) := by
            rw [hπ₂_eq]; exact map_mul _ _ _
          have hc_map : φ_KF (R.subtype (c₂ - c₁)) =
              φ_KF (R.subtype c₂) - φ_KF (R.subtype c₁) := map_sub _ _ _
          rw [hc_map]
          linear_combination hw₁ - hw₂ + hπ₂_map * W.subtype w₂
        have hφπ₁_ne : φ_KF (R.subtype π₁) ≠ 0 := (map_ne_zero φ_KF).mpr hπ₁_K
        have hs_eq_W : φ_KF (((c₂ - c₁ : ↥R) : K) * (π₁ : K)⁻¹) =
            W.subtype w₁ - φ_KF (R.subtype r') * W.subtype w₂ := by
          apply mul_left_cancel₀ hφπ₁_ne
          rw [hdiff_F, ← map_mul]
          congr 1
          calc (π₁ : K) * (((c₂ - c₁ : ↥R) : K) * (π₁ : K)⁻¹)
              = ((c₂ - c₁ : ↥R) : K) * ((π₁ : K) * (π₁ : K)⁻¹) := by ring
            _ = ((c₂ - c₁ : ↥R) : K) := by rw [mul_inv_cancel₀ hπ₁_K, mul_one]
        have hs_W : φ_KF (((c₂ - c₁ : ↥R) : K) * (π₁ : K)⁻¹) ∈ W := by
          rw [hs_eq_W]
          exact W.toSubring.sub_mem w₁.2 (W.toSubring.mul_mem (hR₁ r') w₂.2)
        let s : ↥R := ⟨((c₂ - c₁ : ↥R) : K) * (π₁ : K)⁻¹, hK_mem _ hs_W⟩
        have hw_sub : w₁ - ⟨φ_KF (R.subtype s), hR₁ s⟩ =
            ⟨φ_KF (R.subtype r'), hR₁ r'⟩ * w₂ := by
          apply Subtype.ext
          change W.subtype w₁ - φ_KF (((c₂ - c₁ : ↥R) : K) * (π₁ : K)⁻¹) =
            φ_KF (R.subtype r') * W.subtype w₂
          rw [hs_eq_W]
          ring
        have hw_sub_max : w₁ - ⟨φ_KF (R.subtype s), hR₁ s⟩ ∈ IsLocalRing.maximalIdeal ↥W := by
          rw [hw_sub]
          exact Ideal.mul_mem_right w₂ _ ((hMax₁ r').mpr hr'_max)
        let Q : Polynomial ↥R := Polynomial.X - Polynomial.C s
        have hQ_coeff : ∃ j : ℕ, Q.coeff j ∉ IsLocalRing.maximalIdeal ↥R := by
          refine ⟨1, ?_⟩
          simpa [Q] using one_not_mem_maxR
        have hQ_eval : Polynomial.eval₂
            ((φ_KF.comp R.subtype).codRestrict W.toSubring hR₁) w₁ Q =
            w₁ - ⟨φ_KF (R.subtype s), hR₁ s⟩ := by
          simp only [Q, Polynomial.eval₂_sub, Polynomial.eval₂_X, Polynomial.eval₂_C]
          rfl
        exact hQ₁ Q hQ_coeff (hQ_eval ▸ hw_sub_max)
      · have hinv_eq : ((π₂ : K) * (π₁ : K)⁻¹)⁻¹ = (π₁ : K) * (π₂ : K)⁻¹ := by
          rw [mul_inv_rev, inv_inv]
        rw [hinv_eq] at hz_inv
        refine h_not ⟨⟨(π₁ : K) * (π₂ : K)⁻¹, hz_inv⟩, Subtype.ext ?_⟩
        change (π₁ : K) = ((π₁ : K) * (π₂ : K)⁻¹) * (π₂ : K)
        rw [mul_assoc, inv_mul_cancel₀ hπ₂_K, mul_one]
    rcases h_dvd with ⟨r, hr⟩
    refine ⟨⟨r, hr⟩, ?_⟩
    have hdiff_F2 : φ_KF (R.subtype π₂) * (W.subtype w₂ - φ_KF (R.subtype r) * W.subtype w₁) =
        φ_KF (R.subtype (c₁ - c₂)) := by
      have hπ₁_map : φ_KF (R.subtype π₁) = φ_KF (R.subtype r) * φ_KF (R.subtype π₂) := by
        rw [hr]; exact map_mul _ _ _
      have hc_map : φ_KF (R.subtype (c₁ - c₂)) =
          φ_KF (R.subtype c₁) - φ_KF (R.subtype c₂) := map_sub _ _ _
      rw [hc_map]
      linear_combination hw₂ - hw₁ + hπ₁_map * W.subtype w₁
    have hφπ₂_ne : φ_KF (R.subtype π₂) ≠ 0 := (map_ne_zero φ_KF).mpr hπ₂_K
    have hs₁_eq_W : φ_KF (((c₁ - c₂ : ↥R) : K) * (π₂ : K)⁻¹) =
        W.subtype w₂ - φ_KF (R.subtype r) * W.subtype w₁ := by
      apply mul_left_cancel₀ hφπ₂_ne
      rw [hdiff_F2, ← map_mul]
      congr 1
      calc (π₂ : K) * (((c₁ - c₂ : ↥R) : K) * (π₂ : K)⁻¹)
          = ((c₁ - c₂ : ↥R) : K) * ((π₂ : K) * (π₂ : K)⁻¹) := by ring
        _ = ((c₁ - c₂ : ↥R) : K) := by rw [mul_inv_cancel₀ hπ₂_K, mul_one]
    have hs₁_W : φ_KF (((c₁ - c₂ : ↥R) : K) * (π₂ : K)⁻¹) ∈ W := by
      rw [hs₁_eq_W]
      exact W.toSubring.sub_mem w₂.2 (W.toSubring.mul_mem (hR₁ r) w₁.2)
    refine ⟨⟨((c₁ - c₂ : ↥R) : K) * (π₂ : K)⁻¹, hK_mem _ hs₁_W⟩, Subtype.ext ?_⟩
    change ((c₁ - c₂ : ↥R) : K) = (((c₁ - c₂ : ↥R) : K) * (π₂ : K)⁻¹) * (π₂ : K)
    rw [mul_assoc, inv_mul_cancel₀ hπ₂_K, mul_one]
  refine ⟨?_, ?_⟩
  · intro c₁ π₁ c₂ π₂ W₁ W₂ hπ₁ hπ₂ hD₁ hD₂
    constructor
    · rintro rfl
      exact ⟨hDiscLE_of_same_W c₁ π₁ c₂ π₂ W₁ hπ₁ hπ₂ hD₁ hD₂,
        hDiscLE_of_same_W c₂ π₂ c₁ π₁ W₁ hπ₂ hπ₁ hD₂ hD₁⟩
    · intro hEq
      obtain ⟨ψ₁, mW₁, hR₁, w₁, hmW₁, hψ₁_η, hψ₁_u0, hMax₁, hw₁, hQ₁⟩ := hD₁
      obtain ⟨ψ₂, mW₂, hR₂, w₂, hmW₂, hψ₂_η, hψ₂_u0, hMax₂, hw₂, hQ₂⟩ := hD₂
      let W₀₁ := W₁.comap φ_F0_FWB
      let W₀₂ := W₂.comap φ_F0_FWB
      let j₁ : ↥W₀₁ →+* ↥W₁ :=
        (φ_F0_FWB.comp W₀₁.subtype).codRestrict W₁.toSubring (fun z => z.2)
      let j₂ : ↥W₀₂ →+* ↥W₂ :=
        (φ_F0_FWB.comp W₀₂.subtype).codRestrict W₂.toSubring (fun z => z.2)
      have hπ₁_K : (π₁ : K) ≠ 0 := fun h => hπ₁ (Subtype.ext h)
      have hπ₂_K : (π₂ : K) ≠ 0 := fun h => hπ₂ (Subtype.ext h)
      have hπ₁_F0 : φ_KF0 (R.subtype π₁) ≠ 0 := (map_ne_zero φ_KF0).mpr hπ₁_K
      have hπ₂_F0 : φ_KF0 (R.subtype π₂) ≠ 0 := (map_ne_zero φ_KF0).mpr hπ₂_K
      have hπ₁_FWB : φ_KF (R.subtype π₁) ≠ 0 := (map_ne_zero φ_KF).mpr hπ₁_K
      have hπ₂_FWB : φ_KF (R.subtype π₂) ≠ 0 := (map_ne_zero φ_KF).mpr hπ₂_K
      let u₁ : F_0 := (T_0 - φ_KF0 (R.subtype c₁)) * (φ_KF0 (R.subtype π₁))⁻¹
      let u₂ : F_0 := (T_0 - φ_KF0 (R.subtype c₂)) * (φ_KF0 (R.subtype π₂))⁻¹
      have hu₁_mul : φ_KF0 (R.subtype π₁) * u₁ = T_0 - φ_KF0 (R.subtype c₁) := by
        calc φ_KF0 (R.subtype π₁) * u₁
            = (T_0 - φ_KF0 (R.subtype c₁)) *
                (φ_KF0 (R.subtype π₁) * (φ_KF0 (R.subtype π₁))⁻¹) := by dsimp [u₁]; ring
          _ = T_0 - φ_KF0 (R.subtype c₁) := by rw [mul_inv_cancel₀ hπ₁_F0, mul_one]
      have hu₂_mul : φ_KF0 (R.subtype π₂) * u₂ = T_0 - φ_KF0 (R.subtype c₂) := by
        calc φ_KF0 (R.subtype π₂) * u₂
            = (T_0 - φ_KF0 (R.subtype c₂)) *
                (φ_KF0 (R.subtype π₂) * (φ_KF0 (R.subtype π₂))⁻¹) := by dsimp [u₂]; ring
          _ = T_0 - φ_KF0 (R.subtype c₂) := by rw [mul_inv_cancel₀ hπ₂_F0, mul_one]
      have hu₁_map : φ_F0_FWB u₁ = W₁.subtype w₁ := by
        apply mul_left_cancel₀ hπ₁_FWB
        calc φ_KF (R.subtype π₁) * φ_F0_FWB u₁
            = φ_F0_FWB (φ_KF0 (R.subtype π₁) * u₁) :=
                (map_mul φ_F0_FWB (φ_KF0 (R.subtype π₁)) u₁).symm
          _ = φ_F0_FWB (T_0 - φ_KF0 (R.subtype c₁)) := by rw [hu₁_mul]
          _ = T_WB - φ_KF (R.subtype c₁) := map_sub _ _ _
          _ = φ_KF (R.subtype π₁) * W₁.subtype w₁ := hw₁.symm
      have hu₂_map : φ_F0_FWB u₂ = W₂.subtype w₂ := by
        apply mul_left_cancel₀ hπ₂_FWB
        calc φ_KF (R.subtype π₂) * φ_F0_FWB u₂
            = φ_F0_FWB (φ_KF0 (R.subtype π₂) * u₂) :=
                (map_mul φ_F0_FWB (φ_KF0 (R.subtype π₂)) u₂).symm
          _ = φ_F0_FWB (T_0 - φ_KF0 (R.subtype c₂)) := by rw [hu₂_mul]
          _ = T_WB - φ_KF (R.subtype c₂) := map_sub _ _ _
          _ = φ_KF (R.subtype π₂) * W₂.subtype w₂ := hw₂.symm
      let w₀₁ : ↥W₀₁ := ⟨u₁, by change φ_F0_FWB u₁ ∈ W₁; rw [hu₁_map]; exact w₁.2⟩
      let w₀₂ : ↥W₀₂ := ⟨u₂, by change φ_F0_FWB u₂ ∈ W₂; rw [hu₂_map]; exact w₂.2⟩
      have hj₁_w : j₁ w₀₁ = w₁ := Subtype.ext hu₁_map
      have hj₂_w : j₂ w₀₂ = w₂ := Subtype.ext hu₂_map
      have hMax₀₁ : ∀ r : ↥R,
          (⟨φ_KF0 (R.subtype r), hR₁ r⟩ : ↥W₀₁) ∈ IsLocalRing.maximalIdeal ↥W₀₁ ↔
          r ∈ IsLocalRing.maximalIdeal ↥R := by
        intro r
        rw [← jW_mem_max_iff W₁ ⟨φ_KF0 (R.subtype r), hR₁ r⟩]
        exact hMax₁ r
      have hMax₀₂ : ∀ r : ↥R,
          (⟨φ_KF0 (R.subtype r), hR₂ r⟩ : ↥W₀₂) ∈ IsLocalRing.maximalIdeal ↥W₀₂ ↔
          r ∈ IsLocalRing.maximalIdeal ↥R := by
        intro r
        rw [← jW_mem_max_iff W₂ ⟨φ_KF0 (R.subtype r), hR₂ r⟩]
        exact hMax₂ r
      have hQ₀₁ : ∀ Q : Polynomial ↥R,
          (∃ j : ℕ, Q.coeff j ∉ IsLocalRing.maximalIdeal ↥R) →
          Polynomial.eval₂ ((φ_KF0.comp R.subtype).codRestrict W₀₁.toSubring hR₁) w₀₁ Q ∉
            IsLocalRing.maximalIdeal ↥W₀₁ := by
        intro Q hQ
        rw [← jW_mem_max_iff W₁]
        have hcomp₁ : j₁.comp ((φ_KF0.comp R.subtype).codRestrict W₀₁.toSubring hR₁) =
            (φ_KF.comp R.subtype).codRestrict W₁.toSubring hR₁ :=
          RingHom.ext fun _ => Subtype.ext rfl
        change j₁ (Polynomial.eval₂ _ w₀₁ Q) ∉ IsLocalRing.maximalIdeal ↥W₁
        rw [Polynomial.hom_eval₂, hcomp₁, hj₁_w]
        exact hQ₁ Q hQ
      have hQ₀₂ : ∀ Q : Polynomial ↥R,
          (∃ j : ℕ, Q.coeff j ∉ IsLocalRing.maximalIdeal ↥R) →
          Polynomial.eval₂ ((φ_KF0.comp R.subtype).codRestrict W₀₂.toSubring hR₂) w₀₂ Q ∉
            IsLocalRing.maximalIdeal ↥W₀₂ := by
        intro Q hQ
        rw [← jW_mem_max_iff W₂]
        have hcomp₂ : j₂.comp ((φ_KF0.comp R.subtype).codRestrict W₀₂.toSubring hR₂) =
            (φ_KF.comp R.subtype).codRestrict W₂.toSubring hR₂ :=
          RingHom.ext fun _ => Subtype.ext rfl
        change j₂ (Polynomial.eval₂ _ w₀₂ Q) ∉ IsLocalRing.maximalIdeal ↥W₂
        rw [Polynomial.hom_eval₂, hcomp₂, hj₂_w]
        exact hQ₂ Q hQ
      have hComapEq : W₁.comap φ_F0_FWB = W₂.comap φ_F0_FWB :=
        hRatDiscUniq c₁ π₁ c₂ π₂ W₀₁ W₀₂ hR₁ hR₂ w₀₁ w₀₂ hπ₁ hπ₂ hEq
          hMax₀₁ hMax₀₂ hu₁_mul hu₂_mul hQ₀₁ hQ₀₂
      obtain ⟨hB_W₁, hA0_W₁, _, _⟩ := hBrVal W₁ ψ₁ mW₁ hmW₁ hψ₁_η hψ₁_u0
      obtain ⟨hB_W₂, _, _, _⟩ := hBrVal W₂ ψ₂ mW₂ hmW₂ hψ₂_η hψ₂_u0
      exact hEtValUniq W₁ W₂ hComapEq hB_W₁ hB_W₂ hA0_W₁
  · intro E hE_irred hE_u0 W hStalk
    obtain ⟨ψ_WB, mW, hR, u_W, hmW, hψ_η, hψ_u0, hMax_RW, huW_tr⟩ :=
      hBrComp E hE_irred hE_u0 W hStalk
    obtain ⟨_, _, ⟨hT0, hT0_max⟩, hNodal_v1⟩ :=
      hBrVal W ψ_WB mW hmW hψ_η hψ_u0
    let W₀ := W.comap φ_F0_FWB
    let jW : ↥W₀ →+* ↥W :=
      (φ_F0_FWB.comp W₀.subtype).codRestrict W.toSubring (fun z => z.2)
    obtain ⟨t_1, ht1_tr⟩ := hResDescent W hR u_W hMax_RW huW_tr
    have hMax_RW0 : ∀ r : ↥R,
        (⟨φ_KF0 (R.subtype r), hR r⟩ : ↥W₀) ∈ IsLocalRing.maximalIdeal ↥W₀ ↔
        r ∈ IsLocalRing.maximalIdeal ↥R := by
      intro r
      rw [← jW_mem_max_iff W ⟨φ_KF0 (R.subtype r), hR r⟩]
      exact hMax_RW r
    obtain ⟨c_E, π_E, w_0, hcE_mem, hπE_mem, hπE_ne, hw0_eq, hw0_tr⟩ :=
      hRatLinearCoset W₀ hR hT0 t_1 hMax_RW0 hT0_max ht1_tr
    refine ⟨c_E, π_E, hcE_mem, hπE_mem, hπE_ne, ?_, ?_⟩
    · intro a₀ ha ⟨⟨r₁, hr₁⟩, ⟨r₂, hr₂⟩⟩
      obtain ⟨ha₀_ne, v₁, hv₁_max, hv₁_eq⟩ := hNodal_v1 a₀ ha
      have ha₀_K : (a₀ : K) ≠ 0 := fun h => ha₀_ne (Subtype.ext h)
      have ha₀_F0 : φ_KF0 (R.subtype a₀) ≠ 0 := (map_ne_zero φ_KF0).mpr ha₀_K
      have hcE_eq : c_E = r₂ * a₀ := by simpa using hr₂
      have hT0_fac : T_0 =
          φ_KF0 (R.subtype a₀) *
            (φ_KF0 (R.subtype r₂) + φ_KF0 (R.subtype r₁) * W₀.subtype w_0) := by
        have hc_map : φ_KF0 (R.subtype c_E) =
            φ_KF0 (R.subtype r₂) * φ_KF0 (R.subtype a₀) := by
          rw [hcE_eq]; exact map_mul _ _ _
        have hπ_map : φ_KF0 (R.subtype π_E) =
            φ_KF0 (R.subtype r₁) * φ_KF0 (R.subtype a₀) := by
          rw [hr₁]; exact map_mul _ _ _
        linear_combination -hw0_eq + hc_map + hπ_map * W₀.subtype w_0
      have h1_F0 : (φ_KF0 (R.subtype r₂) + φ_KF0 (R.subtype r₁) * W₀.subtype w_0) *
          W₀.subtype v₁ = 1 := by
        apply mul_left_cancel₀ ha₀_F0
        calc φ_KF0 (R.subtype a₀) *
              ((φ_KF0 (R.subtype r₂) + φ_KF0 (R.subtype r₁) * W₀.subtype w_0) * W₀.subtype v₁)
            = T_0 * W₀.subtype v₁ := by rw [hT0_fac]; ring
          _ = φ_KF0 (R.subtype a₀) * 1 := by rw [hv₁_eq, mul_one]
      have h1_W0 : (⟨φ_KF0 (R.subtype r₂), hR r₂⟩ +
          ⟨φ_KF0 (R.subtype r₁), hR r₁⟩ * w_0) * v₁ = (1 : ↥W₀) :=
        Subtype.ext h1_F0
      have h1_max : (1 : ↥W₀) ∈ IsLocalRing.maximalIdeal ↥W₀ := by
        rw [← h1_W0]
        exact Ideal.mul_mem_left _ _ hv₁_max
      exact (IsLocalRing.maximalIdeal.isMaximal ↥W₀).ne_top (Ideal.eq_top_iff_one _ |>.mpr h1_max)
    · refine ⟨ψ_WB, mW, hR, jW w_0, hmW, hψ_η, hψ_u0, hMax_RW, ?_, ?_⟩
      · calc φ_KF (R.subtype π_E) * W.subtype (jW w_0)
            = φ_F0_FWB (φ_KF0 (R.subtype π_E) * W₀.subtype w_0) :=
                (map_mul φ_F0_FWB (φ_KF0 (R.subtype π_E)) (W₀.subtype w_0)).symm
          _ = φ_F0_FWB (T_0 - φ_KF0 (R.subtype c_E)) := by rw [hw0_eq]
          _ = T_WB - φ_KF (R.subtype c_E) := map_sub _ _ _
      · intro Q hQ
        have hcomp : jW.comp ((φ_KF0.comp R.subtype).codRestrict W₀.toSubring hR) =
            (φ_KF.comp R.subtype).codRestrict W.toSubring hR :=
          RingHom.ext fun _ => Subtype.ext rfl
        rw [← hcomp, ← Polynomial.hom_eval₂, jW_mem_max_iff W]
        exact hw0_tr Q hQ

theorem weil_disc_valuation_comap_and_prime_lift (K : Type u) [Field K] [IsSepClosed K]
    (m : ℕ) (R : ValuationSubring K) (hPkg_R : IsValuationRingAlgPackage m R)
    (hMax_R : IsLocalRing.maximalIdeal ↥R ≠ ⊥)
    (a_opt : Option ↥R)
    (M_0 W_B_sch : AlgebraicGeometry.Scheme.{u})
    (g_M0 : M_0 ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
    (m_0 : ↥M_0) (u₀_WB : ↥W_B_sch)
    (F_0 F_WB : Type u) [Field F_0] [Field F_WB]
    (η_M0 : AlgebraicGeometry.Spec (CommRingCat.of F_0) ⟶ M_0)
    (η_WB : AlgebraicGeometry.Spec (CommRingCat.of F_WB) ⟶ W_B_sch)
    (φ_KF0 : K →+* F_0) (φ_F0_FWB : F_0 →+* F_WB) (T_0 : F_0)
    (hStd : IsStandardModelCoordDatum R a_opt M_0 g_M0 m_0 η_M0 φ_KF0 T_0)
    (c₁ π₁ c₂ π₂ : ↥R) (hπ₂_ne : π₂ ≠ 0)
    (hEq : IsValDiscEq ↥R c₁ π₁ c₂ π₂)
    (W_0 : ValuationSubring F_0) (W : ValuationSubring F_WB)
    (hW0_disc : IsDiscValuationOnWB R m_0 η_M0 φ_KF0 T_0 c₁ π₁ W_0)
    (hW_disc : IsDiscValuationOnWB R u₀_WB η_WB (φ_F0_FWB.comp φ_KF0) (φ_F0_FWB T_0) c₂ π₂ W)
    (pW0 : AlgebraicGeometry.Spec (CommRingCat.of ↥W_0)) :
    W.comap φ_F0_FWB = W_0 ∧
    ∃ (j_W : ↥W_0 →+* ↥W)
      (pW : AlgebraicGeometry.Spec (CommRingCat.of ↥W)),
      W.subtype.comp j_W = φ_F0_FWB.comp W_0.subtype ∧
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom j_W)).base pW = pW0 :=
by
  classical
  let φ_R : ↥R →+* F_0 := φ_KF0.comp R.subtype
  have hφR_inj : Function.Injective φ_R := φ_KF0.injective.comp Subtype.val_injective
  have hφR_ne : ∀ {r : ↥R}, r ≠ 0 → φ_R r ≠ 0 :=
    fun hr h0 => hr (hφR_inj (h0.trans (map_zero φ_R).symm))
  have h1_not_mR : (1 : ↥R) ∉ IsLocalRing.maximalIdeal ↥R :=
    IsLocalRing.notMem_maximalIdeal.mpr isUnit_one
  
  obtain ⟨⟨⟨r₁, hr₁⟩, ⟨s₁, hs₁⟩⟩, ⟨⟨r₂, hr₂⟩, _⟩⟩ := hEq
  have hπ₁_ne : π₁ ≠ 0 := by
    intro h0
    apply hπ₂_ne
    rw [hr₂, h0, mul_zero]
  have hr₂₁ : r₂ * r₁ = 1 := by
    apply mul_right_cancel₀ hπ₂_ne
    calc (r₂ * r₁) * π₂ = r₂ * (r₁ * π₂) := mul_assoc r₂ r₁ π₂
      _ = r₂ * π₁ := by rw [← hr₁]
      _ = π₂ := hr₂.symm
      _ = 1 * π₂ := (one_mul π₂).symm
  obtain ⟨_, _, hR₀, w₀, _, _, _, hm₀, hw₀, hPrim₀⟩ := hW0_disc
