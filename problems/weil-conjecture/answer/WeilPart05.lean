          _ = W_0.valuation (φ_KF0 c_b) * (W_0.valuation g) ^ k_exp *
                (W_0.valuation (φ_KF0 c_b))⁻¹ := by
                rw [mul_assoc, mul_comm ((W_0.valuation (φ_KF0 c_b))⁻¹), ← mul_assoc]
      obtain ⟨b_K, u_R, hu_R, hbK_pow⟩ :=
        hDiv (c_a * c_b⁻¹) (mul_ne_zero hca_ne (inv_ne_zero hcb_ne)) k_exp hk_exp
      have hbK_ne : b_K ≠ 0 := by
        intro h0
        rw [h0, zero_pow (by omega), zero_mul] at hbK_pow
