        · change ρ_σ d_0 ∈ q.asIdeal
          rw [hρ_σ_X 0]; exact q.asIdeal.zero_mem
        · change ρ_σ d_1 ∈ q.asIdeal
          rw [hρ_σ_X 1]; exact q.asIdeal.zero_mem
    have hRange_σ : Set.range (PrimeSpectrum.comap ρ_σ) =
        PrimeSpectrum.zeroLocus ({d_0, d_1, d_2, d_3} : Set (Localization.Away h_e)) := by
      rw [range_comap_of_surjective (R₀ ⧸ Q₀) ρ_σ hρ_σ_surj]
      ext x
