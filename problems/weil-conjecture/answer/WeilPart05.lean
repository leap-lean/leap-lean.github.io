      ∀ (b : K) (u : ↥W_0), b ≠ 0 → IsUnit u → φ_KF0 b * W_0.subtype u = z →
        IsAlgebraic k_R (π_W u)
    have isCosetAlg_of_norm : ∀ {z : F_0} (b₀ : K) (u₀ : ↥W_0),
        b₀ ≠ 0 → IsUnit u₀ → φ_KF0 b₀ * W_0.subtype u₀ = z →
        IsAlgebraic k_R (π_W u₀) → IsCosetAlg z := by
      intro z b₀ u₀ _ hu₀ hz₀ halg₀ b u hb _ hz
      have hφb_ne : φ_KF0 b ≠ 0 := (map_ne_zero φ_KF0).mpr hb
      have hu_eq : W_0.subtype u = φ_KF0 (b₀ * b⁻¹) * W_0.subtype u₀ := by
        apply mul_left_cancel₀ hφb_ne
        calc φ_KF0 b * W_0.subtype u = z := hz
          _ = φ_KF0 b₀ * W_0.subtype u₀ := hz₀.symm
          _ = φ_KF0 (b * (b₀ * b⁻¹)) * W_0.subtype u₀ := by
              congr 2
              calc b₀ = b₀ * (b⁻¹ * b) := by rw [inv_mul_cancel₀ hb, mul_one]
                _ = b * (b₀ * b⁻¹) := by ring
          _ = φ_KF0 b * (φ_KF0 (b₀ * b⁻¹) * W_0.subtype u₀) := by rw [map_mul, mul_assoc]
      rcases hu₀.exists_right_inv with ⟨v₀, hv₀⟩
      have hratio_W0 : φ_KF0 (b₀ * b⁻¹) ∈ W_0 := by
        have h_eq : φ_KF0 (b₀ * b⁻¹) = W_0.subtype u * W_0.subtype v₀ := by
          rw [hu_eq, mul_assoc, ← map_mul, hv₀, map_one, mul_one]
        rw [h_eq]
        exact W_0.toSubring.mul_mem u.2 v₀.2
      let r : ↥R := ⟨b₀ * b⁻¹, hK_mem W_0 hR0 hMax0 _ hratio_W0⟩
      have hu_sub : u = ι_0 r * u₀ := Subtype.ext hu_eq
      have hπu : π_W u = algebraMap k_R κ_0 (π_R r) * π_W u₀ := by
        rw [hu_sub, map_mul]
        rfl
      rw [hπu]
      exact (isAlgebraic_algebraMap (π_R r)).mul halg₀
