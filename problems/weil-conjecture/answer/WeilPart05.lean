        · exact False.elim (hH_ne_Ei h12.symm)
        · have hy_Ei : y ∈ E_XT i := h13.symm ▸ hy_Ey
          have hy_pnb : y = p_nb i j := hp_uniq y ⟨hy_Ei, hy_Bj⟩
          exact hy_pnb ▸ hp_in_H
        · exact h23.symm ▸ hy_Ey
      exact ⟨y, hy_H, hy_fst⟩
  have hConj4 : ∀ (i₁ j₁ i₂ j₂ : Fin N),
      ¬ IsDiscBoundaryIdx ↥R a_opt (c i₁) (π i₁) →
      ¬ IsDiscBoundaryIdx ↥R a_opt (c i₂) (π i₂) →
      (IsDiscHasseCover ↥R c π i₁ j₁ ∨ IsDiscHasseCover ↥R c π j₁ i₁) →
      (IsDiscHasseCover ↥R c π i₂ j₂ ∨ IsDiscHasseCover ↥R c π j₂ i₂) →
      p_nb i₁ j₁ = p_nb i₂ j₂ →
      (i₁ = i₂ ∧ j₁ = j₂) ∨ (i₁ = j₂ ∧ j₁ = i₂) := by
    intro i₁ j₁ i₂ j₂ hi₁ hi₂ hc₁ hc₂ hp_eq
    obtain ⟨⟨hq_i1, hq_j1⟩, _⟩ := hp_nb_spec i₁ j₁ hi₁ hc₁
    obtain ⟨⟨hq_i2, hq_j2⟩, _⟩ := hp_nb_spec i₂ j₂ hi₂ hc₂
    let q_M : ↥Y_MT := π_R.base (p_nb i₁ j₁)
    have hq_i2' : q_M ∈ B_comp i₂ := by dsimp [q_M]; rwa [hp_eq]
    have hq_j2' : q_M ∈ B_comp j₂ := by dsimp [q_M]; rwa [hp_eq]
    have hj1_ne : j₁ ≠ i₁ := (hcov_ne hc₁).symm
    have hj2_ne : j₂ ≠ i₂ := (hcov_ne hc₂).symm
    by_cases h12 : i₁ = i₂
    · subst h12
      exact Or.inl ⟨rfl, hB_two i₁ j₁ j₂ hi₁ hj1_ne hj2_ne q_M hq_i1 hq_j1 hq_j2'⟩
    · have hj1_eq : j₁ = i₂ := hB_two i₁ j₁ i₂ hi₁ hj1_ne (Ne.symm h12) q_M hq_i1 hq_j1 hq_i2'
      have hj2_eq : j₂ = i₁ := hB_two i₂ j₂ i₁ hi₂ hj2_ne h12 q_M hq_i2' hq_j2' hq_i1
      exact Or.inr ⟨hj2_eq.symm, hj1_eq⟩
  have hConj5 : ∀ i : Fin N, ¬ IsDiscBoundaryIdx ↥R a_opt (c i) (π i) →
      ∀ q : ↥Y_XT,
        (q ∈ E_XT i ∧ ∃ E' ∈ irreducibleComponents ↥Y_XT, E' ≠ E_XT i ∧ q ∈ E') ↔
        ∃ j : Fin N, (IsDiscHasseCover ↥R c π i j ∨ IsDiscHasseCover ↥R c π j i) ∧
          q = p_nb i j := by
    intro i hi q
    constructor
    · rintro ⟨hq_Ei, E', hE'_irr, hE'_ne, hq_E'⟩
      let C' : Set ↥Y_MT := closure (π_R.base '' E')
      have hC'_irr : C' ∈ irreducibleComponents ↥Y_MT := hPush_comp E' hE'_irr
      have hq_C' : π_R.base q ∈ C' := subset_closure ⟨q, hq_E', rfl⟩
      have hC'_ne_Bi : C' ≠ B_comp i := by
        intro hEq
        have hE'_sub : E' ⊆ E_XT i := by
          intro y hy
          change π_R.base y ∈ B_comp i
          rw [← hEq]
          exact subset_closure ⟨y, hy, rfl⟩
        have hEi_irr : E_XT i ∈ irreducibleComponents ↥Y_XT := (hConj1 i hi).1
        exact hE'_ne (Set.Subset.antisymm hE'_sub (hE'_irr.2 hEi_irr.1 hE'_sub))
      obtain ⟨j, hj_cov, hC'_eq, _⟩ :=
        hB_nod i hi (π_R.base q) C' hq_Ei hC'_irr hC'_ne_Bi hq_C'
      have hq_Bj : π_R.base q ∈ B_comp j := hC'_eq ▸ hq_C'
      obtain ⟨_, hp_uniq⟩ := hp_nb_spec i j hi hj_cov
      exact ⟨j, hj_cov, hp_uniq q ⟨hq_Ei, hq_Bj⟩⟩
    · rintro ⟨j, hj_cov, rfl⟩
      obtain ⟨hH_irr, hH_ne, hp_Ei, hp_H, _⟩ := hConj3 i j hi hj_cov
      exact ⟨hp_Ei, H_nb i j, hH_irr, hH_ne, hp_H⟩
  exact ⟨p_nb, H_nb, hConj1, hConj2, hConj3, hConj4, hConj5⟩

theorem weil_etale_contraction_locus_singleton_and_specialization_transfer (K : Type u) [Field K]
    (m : ℕ) (V : ValuationSubring K) (P : PrimeSpectrum ↥V)
    (hPkg_VP : IsValuationRingAlgPackage m (V.ofPrime P.asIdeal))
    (U_ss C_cur : AlgebraicGeometry.Scheme.{u})
    (g_ss : U_ss ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (g_cur : C_cur ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (f_ss_cur : C_cur ⟶ U_ss)
    (hComm_fss : f_ss_cur ≫ g_ss = g_cur)
    (u₀ : ↥U_ss) (ϖ : ↥V) (W_B : U_ss.Opens) (hu₀ : u₀ ∈ W_B)
    (g_WB : W_B.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥(V.ofPrime P.asIdeal)))
    (Z_mod : Set ↥W_B.toScheme) (hZ_closed : IsClosed Z_mod)
    (hChart : IsIsolatedStrictlySemistableModChart V g_ss f_ss_cur P u₀ ϖ W_B hu₀ g_WB
      Z_mod hZ_closed)
    (M_0 : AlgebraicGeometry.Scheme.{u})
    (g_M0 : M_0 ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥(V.ofPrime P.asIdeal)))
    (m_0 : ↥M_0)
    (hm0_max : (g_M0.base m_0).asIdeal = IsLocalRing.maximalIdeal ↥(V.ofPrime P.asIdeal))
    (e_0 : W_B.toScheme ⟶ M_0)
    (hEt_e0 : AlgebraicGeometry.Etale e_0)
    (he0_comm : e_0 ≫ g_M0 = g_WB)
    (he0_m0 : e_0.base ⁻¹' {m_0} = {(⟨u₀, hu₀⟩ : ↥W_B.toScheme)})
    (he0_Zmod : ∀ y ∈ Z_mod, e_0.base ⁻¹' {e_0.base y} = {y})
    (isLeaf : Prop)
    (Z_X0 : Set ↥(AlgebraicGeometry.Scheme.Opens.toScheme
      ((TopologicalSpace.Opens.map f_ss_cur.base).obj W_B)))
    (M_tilde M' : AlgebraicGeometry.Scheme.{u})
    (g_tilde : M_tilde ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥(V.ofPrime P.asIdeal)))
    (g'_M : M' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥(V.ofPrime P.asIdeal)))
    (f'_M : M' ⟶ M_0)
    (q_M : M_tilde ⟶ M')
    (Mod_qM : Set ↥M')
    (hMod_qM_cl : IsClosed Mod_qM)
    (z_new_M : ↥M')
    (Q₀_R : PrimeSpectrum ↥(V.ofPrime P.asIdeal))
    (z₀_M : ↥M')
    (E_Z_M : Set ↥M_tilde)
    (Φ : AlgebraicGeometry.Scheme.Opens.toScheme
      ((TopologicalSpace.Opens.map f_ss_cur.base).obj W_B) ≅
      CategoryTheory.Limits.pullback (q_M ≫ f'_M) e_0)
    (hContr_M : IsBaseOneStepContractionModel (V.ofPrime P.asIdeal) g_M0 m_0 isLeaf
      M_tilde M' g_tilde g'_M f'_M q_M Mod_qM z_new_M Q₀_R z₀_M E_Z_M)
    (hΦ_f : Φ.hom ≫ CategoryTheory.Limits.pullback.snd (q_M ≫ f'_M) e_0 = (f_ss_cur ∣_ W_B))
    (hΦ_ZX0 : Φ.hom.base '' Z_X0 =
      (CategoryTheory.Limits.pullback.fst (q_M ≫ f'_M) e_0).base ⁻¹' E_Z_M) :
    let X'_0 := CategoryTheory.Limits.pullback f'_M e_0
    let π'_M := CategoryTheory.Limits.pullback.fst f'_M e_0
    let f'_0 := CategoryTheory.Limits.pullback.snd f'_M e_0
    let g'_0 := f'_0 ≫ g_WB
    let q_pb : CategoryTheory.Limits.pullback (q_M ≫ f'_M) e_0 ⟶ X'_0 :=
      CategoryTheory.Limits.pullback.map (q_M ≫ f'_M) e_0 f'_M e_0 q_M (𝟙 _) (𝟙 _)
        (CategoryTheory.Category.comp_id (q_M ≫ f'_M))
        ((CategoryTheory.Category.comp_id e_0).trans (CategoryTheory.Category.id_comp e_0).symm)
    let q_0 := Φ.hom ≫ q_pb
    let Mod_q0 : Set ↥X'_0 := π'_M.base ⁻¹' Mod_qM
    let ι_VP : ↥V →+* ↥(V.ofPrime P.asIdeal) :=
      Subring.inclusion (ValuationSubring.le_ofPrime V P.asIdeal)
    let F_exc : Set ↥(AlgebraicGeometry.Scheme.Opens.toScheme
      ((TopologicalSpace.Opens.map f_ss_cur.base).obj W_B)) := q_0.base ⁻¹' Mod_q0
    ∃ (z_new : ↥X'_0),
      f'_0.base '' Mod_q0 ⊆ Z_mod ∧
      z_new ∈ Mod_q0 ∧
      (g'_0 ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_VP)).base z_new = P ∧
      F_exc ∩ ((f_ss_cur ∣_ W_B) ≫ g_WB ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_VP)).base ⁻¹' {P} = Z_X0 ∧
      Mod_q0 ∩ (g'_0 ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_VP)).base ⁻¹' {P} = {z_new} ∧
      (∀ Q : PrimeSpectrum ↥V,
        (Mod_q0 ∩ (g'_0 ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_VP)).base ⁻¹' {Q}).Subsingleton) ∧
      (∃ (Q₀ : PrimeSpectrum ↥V) (z₀ : ↥X'_0),
        Q₀.asIdeal ≠ ⊥ ∧
        Q₀.asIdeal ≤ P.asIdeal ∧
        z₀ ∈ Mod_q0 ∧
        (g'_0 ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_VP)).base z₀ = Q₀ ∧
        IsIrreducible (q_0.base ⁻¹' {z₀}) ∧
        F_exc = closure (q_0.base ⁻¹' {z₀})) ∧
      (∀ y ∈ F_exc, ∃ z ∈ Z_X0, z ∈ closure ({y} : Set _)) :=
by
  intro X'_0 π'_M f'_0 g'_0 q_pb q_0 Mod_q0 ι_VP F_exc
  have _ := hComm_fss
  classical

  
  have hResAlgClosed : ∀ (A : Type u) [CommRing A] (I₀ : Ideal A)
      (M : AlgebraicGeometry.Scheme.{u})
      (g_M : M ⟶ AlgebraicGeometry.Spec (CommRingCat.of A))
      (ψ : AlgebraicGeometry.Spec (CommRingCat.of (A ⧸ I₀)) ⟶ M),
      ψ ≫ g_M = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I₀)) →
      ∀ (t : ↥(AlgebraicGeometry.Spec (CommRingCat.of (A ⧸ I₀)))),
        (let Q_A : PrimeSpectrum A := g_M.base (ψ.base t);
         IsAlgClosed Q_A.asIdeal.ResidueField) →
        IsAlgClosed ↑(M.residueField (ψ.base t)) := by
    intro A _ I₀ M g_M ψ hcomm t hAlg
    let y_M : ↥M := ψ.base t
    let Q_A : PrimeSpectrum A := g_M.base y_M
    have : Q_A.asIdeal.IsPrime := Q_A.isPrime
    let κ : Type u := Q_A.asIdeal.ResidueField
    have hQA_eq : Q_A = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I₀))).base t := by
      change (ψ ≫ g_M).base t = _
      rw [hcomm]
    let t_ps : PrimeSpectrum (A ⧸ I₀) := t
    have hI₀_le : I₀ ≤ Q_A.asIdeal := by
      rw [hQA_eq]
      intro r hr
      change Ideal.Quotient.mk I₀ r ∈ t_ps.asIdeal
      rw [Ideal.Quotient.eq_zero_iff_mem.mpr hr]
      exact t_ps.asIdeal.zero_mem
    let ρ_t : A ⧸ I₀ →+* κ :=
      Ideal.Quotient.lift I₀ (algebraMap A κ) (fun r hr => by
        change (algebraMap (A ⧸ Q_A.asIdeal) κ) (Ideal.Quotient.mk Q_A.asIdeal r) = 0
        rw [Ideal.Quotient.eq_zero_iff_mem.mpr (hI₀_le hr), map_zero])
    have hρ_comp : ρ_t.comp (Ideal.Quotient.mk I₀) = algebraMap A κ :=
      RingHom.ext fun _ => rfl
    let s_t : AlgebraicGeometry.Spec (CommRingCat.of κ) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of (A ⧸ I₀)) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_t)
    let pt_κ : ↥(AlgebraicGeometry.Spec (CommRingCat.of κ)) := (⊥ : PrimeSpectrum κ)
    have hst_bot : s_t.base pt_κ = t := by
      apply PrimeSpectrum.ext
      ext x
      obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective x
      change ρ_t (Ideal.Quotient.mk I₀ r) ∈ (⊥ : Ideal κ) ↔ Ideal.Quotient.mk I₀ r ∈ t_ps.asIdeal
      rw [Ideal.mem_bot]
      have h1 : ρ_t (Ideal.Quotient.mk I₀ r) =
          (algebraMap (A ⧸ Q_A.asIdeal) κ) (Ideal.Quotient.mk Q_A.asIdeal r) := rfl
      rw [h1]
      have hinj := IsFractionRing.injective (A ⧸ Q_A.asIdeal) κ
      have hzero : (algebraMap (A ⧸ Q_A.asIdeal) κ) (Ideal.Quotient.mk Q_A.asIdeal r) = 0 ↔
          Ideal.Quotient.mk Q_A.asIdeal r = 0 := by
        rw [← map_zero (algebraMap (A ⧸ Q_A.asIdeal) κ), hinj.eq_iff]
      rw [hzero, Ideal.Quotient.eq_zero_iff_mem]
      have h2 : r ∈ Q_A.asIdeal ↔ Ideal.Quotient.mk I₀ r ∈ t_ps.asIdeal := by
        rw [hQA_eq]; rfl
      exact h2
    let u_M : AlgebraicGeometry.Spec (CommRingCat.of κ) ⟶ M := s_t ≫ ψ
    have hu_bot : u_M.base pt_κ = y_M := by
      change ψ.base (s_t.base pt_κ) = y_M
      rw [hst_bot]
    rcases h_eq_p : M.SpecToEquivOfField κ u_M with ⟨y', f'⟩
    have hsymm_u : AlgebraicGeometry.Spec.map f' ≫ M.fromSpecResidueField y' = u_M := by
      rw [← AlgebraicGeometry.Scheme.SpecToEquivOfField_symm_apply (xf := ⟨y', f'⟩), ← h_eq_p]
      exact (M.SpecToEquivOfField κ).symm_apply_apply u_M
    have hy'_eq : y' = y_M := by
      have hbase := congrArg (fun g => g.base pt_κ) hsymm_u
      rw [hu_bot] at hbase
      exact (AlgebraicGeometry.Scheme.fromSpecResidueField_apply y'
        ((AlgebraicGeometry.Spec.map f').base pt_κ)).symm.trans hbase
    subst hy'_eq
    let S_A := AlgebraicGeometry.Spec (CommRingCat.of A)
    let q_A : ↥S_A := g_M.base y_M
    let L_Q : Type u := ↑(S_A.residueField q_A)
    let φ_A : A →+* L_Q := (AlgebraicGeometry.Spec.preimage (S_A.fromSpecResidueField q_A)).hom
    have hφ_map : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_A) =
        S_A.fromSpecResidueField q_A :=
      AlgebraicGeometry.Spec.map_preimage _
    let pt_LQ : ↥(AlgebraicGeometry.Spec (S_A.residueField q_A)) := (⊥ : PrimeSpectrum L_Q)
    have hker_φ : RingHom.ker φ_A = Q_A.asIdeal := by
      have hpt : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_A)).base pt_LQ = q_A := by
        rw [hφ_map]
        exact AlgebraicGeometry.Scheme.fromSpecResidueField_apply q_A pt_LQ
      ext r
      change φ_A r ∈ (⊥ : Ideal L_Q) ↔ r ∈ Q_A.asIdeal
      change r ∈ ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_A)).base pt_LQ).asIdeal ↔
        r ∈ Q_A.asIdeal
      rw [hpt]
    let φ_quot : A ⧸ Q_A.asIdeal →+* L_Q :=
      Ideal.Quotient.lift Q_A.asIdeal φ_A (fun r hr => by rw [← hker_φ] at hr; exact hr)
    have hφ_units : ∀ y : nonZeroDivisors (A ⧸ Q_A.asIdeal), IsUnit (φ_quot y) := by
      intro ⟨y, hy⟩
      refine Ne.isUnit (fun h0 => ?_)
      obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective y
      have hrQ : r ∈ Q_A.asIdeal := by rw [← hker_φ]; exact h0
      exact nonZeroDivisors.ne_zero hy (Ideal.Quotient.eq_zero_iff_mem.mpr hrQ)
    let α₀ : κ →+* L_Q := IsLocalization.lift (M := nonZeroDivisors (A ⧸ Q_A.asIdeal)) hφ_units
    have hα₀_comp : α₀.comp (algebraMap A κ) = φ_A := by
      ext r
      change α₀ ((algebraMap (A ⧸ Q_A.asIdeal) κ) (Ideal.Quotient.mk Q_A.asIdeal r)) = φ_A r
      rw [IsLocalization.lift_eq]; rfl
    have h_id_map : AlgebraicGeometry.Spec.map (g_M.residueFieldMap y_M ≫ f' ≫ CommRingCat.ofHom α₀) ≫
        S_A.fromSpecResidueField q_A =
        𝟙 _ ≫ S_A.fromSpecResidueField q_A := by
      rw [CategoryTheory.Category.id_comp, AlgebraicGeometry.Spec.map_comp,
        AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc,
        CategoryTheory.Category.assoc, g_M.SpecMap_residueFieldMap_fromSpecResidueField y_M,
        ← CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map f'), hsymm_u]
      have hu_g : u_M ≫ g_M = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A κ)) := by
        dsimp [u_M, s_t]
        rw [CategoryTheory.Category.assoc, hcomm, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp, hρ_comp]
      rw [← CategoryTheory.Category.assoc, CategoryTheory.Category.assoc _ u_M g_M, hu_g,
        ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hα₀_comp, hφ_map]
    have h_eq1 := (cancel_mono (S_A.fromSpecResidueField q_A)).mp h_id_map
    rw [← AlgebraicGeometry.Spec.map_id] at h_eq1
    have h_id : g_M.residueFieldMap y_M ≫ f' ≫ CommRingCat.ofHom α₀ = 𝟙 _ :=
      AlgebraicGeometry.Spec.map_inj.mp h_eq1
    have hα_inj : Function.Injective α₀ := RingHom.injective α₀
    have hf'_surj : Function.Surjective f'.hom := by
      intro c
      refine ⟨(g_M.residueFieldMap y_M).hom (α₀ c), ?_⟩
      apply hα_inj
      exact congrArg (fun f => f.hom (α₀ c)) h_id
    let e_κ : ↑(M.residueField y_M) ≃+* κ :=
      RingEquiv.ofBijective f'.hom ⟨RingHom.injective f'.hom, hf'_surj⟩
    exact @IsAlgClosed.of_ringEquiv κ _ ↑(M.residueField y_M) _ e_κ.symm hAlg

  
  have hSingPb : ∀ (M W : AlgebraicGeometry.Scheme.{u}) (e : W ⟶ M) [AlgebraicGeometry.Etale e]
      (y : ↥M) (w : ↥W),
      e.base ⁻¹' {y} = {w} →
      IsAlgClosed ↑(M.residueField y) →
      ∀ (Z : AlgebraicGeometry.Scheme.{u}) (h : Z ⟶ M) (z : ↥Z),
        h.base z = y →
        (∃! u : ↥(CategoryTheory.Limits.pullback h e),
          (CategoryTheory.Limits.pullback.fst h e).base u = z) ∧
        (∀ u : ↥(CategoryTheory.Limits.pullback h e),
          (CategoryTheory.Limits.pullback.fst h e).base u = z →
          (CategoryTheory.Limits.pullback.snd h e).base u = w) := by
    intro M W e hEt y w he_pre hAlg Z h z hz
    have hw : e.base w = y := by
      have hw_mem : w ∈ e.base ⁻¹' {y} := by rw [he_pre]; exact rfl
      exact hw_mem
    subst hw
    let F := e.fiber (e.base w)
    have hSubF : Subsingleton ↥F := by
      have _ : Subsingleton ↑(e.base ⁻¹' {e.base w}) := by
        rw [he_pre]
        infer_instance
      exact (e.fiberHomeo (e.base w)).injective.subsingleton
    let lift_w : AlgebraicGeometry.Spec (W.residueField w) ⟶ F :=
      CategoryTheory.Limits.pullback.lift (W.fromSpecResidueField w)
        (AlgebraicGeometry.Spec.map (e.residueFieldMap w))
        (e.SpecMap_residueFieldMap_fromSpecResidueField w).symm
    have hlift_fst : lift_w ≫ e.fiberι (e.base w) = W.fromSpecResidueField w :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hlift_snd : lift_w ≫ e.fiberToSpecResidueField (e.base w) =
        AlgebraicGeometry.Spec.map (e.residueFieldMap w) :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have : AlgebraicGeometry.IsPreimmersion (lift_w ≫ e.fiberι (e.base w)) := by
      rw [hlift_fst]; infer_instance
    have : AlgebraicGeometry.IsPreimmersion lift_w :=
      AlgebraicGeometry.IsPreimmersion.of_comp lift_w (e.fiberι (e.base w))
    have hRange_univ : Set.range lift_w.base = Set.univ := by
      ext q
      simp only [Set.mem_range, Set.mem_univ, iff_true]
      exact ⟨(⊥ : PrimeSpectrum ↑(W.residueField w)), Subsingleton.elim _ _⟩
    have : AlgebraicGeometry.IsClosedImmersion lift_w :=
      AlgebraicGeometry.IsClosedImmersion.of_isPreimmersion lift_w (hRange_univ ▸ isClosed_univ)
    have : AlgebraicGeometry.LocallyOfFiniteType (AlgebraicGeometry.Spec.map (e.residueFieldMap w)) := by
      rw [← hlift_snd]
      infer_instance
    have hFT_map : (e.residueFieldMap w).hom.FiniteType := by
      rwa [← AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.LocallyOfFiniteType)]
    let k_y : Type u := ↑(M.residueField (e.base w))
    let L_w : Type u := ↑(W.residueField w)
    let φ : k_y →+* L_w := (e.residueFieldMap w).hom
    let _ : Algebra k_y L_w := φ.toAlgebra
    have hAlgFT : Algebra.FiniteType k_y L_w := hFT_map
    obtain ⟨n, ev, hev_surj⟩ :=
      (Algebra.FiniteType.iff_quotient_mvPolynomial'' (R := k_y) (S := L_w)).mp hAlgFT
    have hMax : (RingHom.ker ev.toRingHom).IsMaximal :=
      RingHom.ker_isMaximal_of_surjective ev.toRingHom hev_surj
    obtain ⟨c, hc⟩ := (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton (K := k_y)).mp hMax
    have hφ_surj : Function.Surjective φ := by
      intro u
      obtain ⟨p, rfl⟩ := hev_surj u
      refine ⟨MvPolynomial.aeval c p, ?_⟩
      have hmem : p - MvPolynomial.C (MvPolynomial.aeval c p) ∈ RingHom.ker ev.toRingHom := by
        rw [hc, MvPolynomial.mem_vanishingIdeal_singleton_iff]
        simp
      rw [RingHom.mem_ker, map_sub, sub_eq_zero] at hmem
      calc φ (MvPolynomial.aeval c p)
          = ev (MvPolynomial.C (MvPolynomial.aeval c p)) := (ev.commutes _).symm
        _ = ev p := hmem.symm
    let e_res : k_y ≃+* L_w := RingEquiv.ofBijective φ ⟨RingHom.injective φ, hφ_surj⟩
    have hIso_res : CategoryTheory.IsIso (e.residueFieldMap w) :=
      ⟨⟨CommRingCat.ofHom e_res.symm.toRingHom,
        CommRingCat.hom_ext (RingHom.ext e_res.symm_apply_apply),
        CommRingCat.hom_ext (RingHom.ext e_res.apply_symm_apply)⟩⟩
    have hsnd_eq : ∀ u : ↥(CategoryTheory.Limits.pullback h e),
        (CategoryTheory.Limits.pullback.fst h e).base u = z →
        (CategoryTheory.Limits.pullback.snd h e).base u = w := by
      intro u hu
      have he_u : e.base ((CategoryTheory.Limits.pullback.snd h e).base u) = e.base w := by
        calc e.base ((CategoryTheory.Limits.pullback.snd h e).base u)
            = (CategoryTheory.Limits.pullback.snd h e ≫ e).base u := rfl
          _ = (CategoryTheory.Limits.pullback.fst h e ≫ h).base u := by
              rw [CategoryTheory.Limits.pullback.condition]
          _ = h.base ((CategoryTheory.Limits.pullback.fst h e).base u) := rfl
          _ = e.base w := by rw [hu, hz]
      have hmem : (CategoryTheory.Limits.pullback.snd h e).base u ∈ e.base ⁻¹' {e.base w} := he_u
      rwa [he_pre, Set.mem_singleton_iff] at hmem
    obtain ⟨u₀, hu₀_fst, _⟩ := AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback z w hz
    refine ⟨⟨u₀, hu₀_fst, fun u hu => ?_⟩, hsnd_eq⟩
    have hu_snd : (CategoryTheory.Limits.pullback.snd h e).base u = w := hsnd_eq u hu
    have hu₀_snd : (CategoryTheory.Limits.pullback.snd h e).base u₀ = w := hsnd_eq u₀ hu₀_fst
    apply AlgebraicGeometry.Scheme.Pullback.carrierEquiv.injective
    have hx1 : (AlgebraicGeometry.Scheme.Pullback.carrierEquiv u).1.x = z := by
      have := AlgebraicGeometry.Scheme.Pullback.carrierEquiv_symm_fst
        (AlgebraicGeometry.Scheme.Pullback.carrierEquiv u).1
        (AlgebraicGeometry.Scheme.Pullback.carrierEquiv u).2
      rwa [Equiv.symm_apply_apply, hu] at this
    have hx2 : (AlgebraicGeometry.Scheme.Pullback.carrierEquiv u₀).1.x = z := by
      have := AlgebraicGeometry.Scheme.Pullback.carrierEquiv_symm_fst
        (AlgebraicGeometry.Scheme.Pullback.carrierEquiv u₀).1
        (AlgebraicGeometry.Scheme.Pullback.carrierEquiv u₀).2
      rwa [Equiv.symm_apply_apply, hu₀_fst] at this
    have hy1 : (AlgebraicGeometry.Scheme.Pullback.carrierEquiv u).1.y = w := by
      have := AlgebraicGeometry.Scheme.Pullback.carrierEquiv_symm_snd
        (AlgebraicGeometry.Scheme.Pullback.carrierEquiv u).1
        (AlgebraicGeometry.Scheme.Pullback.carrierEquiv u).2
      rwa [Equiv.symm_apply_apply, hu_snd] at this
    have hy2 : (AlgebraicGeometry.Scheme.Pullback.carrierEquiv u₀).1.y = w := by
      have := AlgebraicGeometry.Scheme.Pullback.carrierEquiv_symm_snd
        (AlgebraicGeometry.Scheme.Pullback.carrierEquiv u₀).1
        (AlgebraicGeometry.Scheme.Pullback.carrierEquiv u₀).2
      rwa [Equiv.symm_apply_apply, hu₀_snd] at this
    have hT_eq : (AlgebraicGeometry.Scheme.Pullback.carrierEquiv u).1 =
        (AlgebraicGeometry.Scheme.Pullback.carrierEquiv u₀).1 :=
      AlgebraicGeometry.Scheme.Pullback.Triplet.ext (hx1.trans hx2.symm) (hy1.trans hy2.symm)
    let T₀ := (AlgebraicGeometry.Scheme.Pullback.carrierEquiv u₀).1
    have : CategoryTheory.IsIso (e.residueFieldMap T₀.y) := by
      rw [hy2]; exact hIso_res
    have : CategoryTheory.IsIso
        (AlgebraicGeometry.Spec.map ((M.residueFieldCongr T₀.hy).inv ≫ e.residueFieldMap T₀.y)) :=
      inferInstance
    have _ : CategoryTheory.IsIso (AlgebraicGeometry.Spec.map T₀.tensorInl) :=
      CategoryTheory.IsPullback.isIso_fst_of_isIso
        (AlgebraicGeometry.Scheme.Pullback.Triplet.isPullback_SpecMap_tensor T₀)
    have _ : Subsingleton ↥(AlgebraicGeometry.Spec (Z.residueField T₀.x)) := by
      change Subsingleton (PrimeSpectrum ↑(Z.residueField T₀.x))
      infer_instance
    have hSubTensor : Subsingleton ↥(AlgebraicGeometry.Spec T₀.tensor) :=
      (ConcreteCategory.bijective_of_isIso
        (AlgebraicGeometry.Spec.map T₀.tensorInl).base).1.subsingleton
    exact AlgebraicGeometry.Scheme.Pullback.carrierEquiv_eq_iff.mpr
      ⟨hT_eq, @Subsingleton.elim _ hSubTensor _ _⟩

  
  let R := V.ofPrime P.asIdeal
  let j_VP := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_VP)
  let u₀_WB : ↥W_B.toScheme := ⟨u₀, hu₀⟩
  let X_0 : C_cur.Opens := (TopologicalSpace.Opens.map f_ss_cur.base).obj W_B
