      have huR_W0 : IsUnit (ι_0 u_R) := by
        rw [← IsLocalRing.notMem_maximalIdeal]
        intro hmem
        exact IsLocalRing.notMem_maximalIdeal.mpr hu_R ((hMax0 u_R).mp hmem)
      have hv_uR : W_0.valuation (φ_KF0 (R.subtype u_R)) = 1 :=
        (W_0.valuation_eq_one_iff (ι_0 u_R)).mp huR_W0
      have hv_pow_bK : (W_0.valuation g) ^ k_exp = (W_0.valuation (φ_KF0 b_K)) ^ k_exp := by
        rw [hv_pow_eq, ← hbK_pow, map_mul, map_pow, Valuation.map_mul,
          Valuation.map_pow, hv_uR, mul_one]
      have hv_g_eq : W_0.valuation g = W_0.valuation (φ_KF0 b_K) := by
