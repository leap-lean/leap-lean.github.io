    intro U hU hUne
    obtain ⟨φ_U, hSpec_U, hInj_φU⟩ := hLift_aff U hU hUne
    refine ⟨φ_U, ?_, hSpec_U⟩
    obtain ⟨⟨z, hzU⟩⟩ := hUne
    obtain ⟨U₂, hU₂, hzU₂, _⟩ :=
