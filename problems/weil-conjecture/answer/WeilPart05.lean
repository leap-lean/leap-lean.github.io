      obtain ⟨q_m01, hqm01_R, hu0_qm01, hqm01_le0, hqm01_le1⟩ := hq01_gen m_R hπ_mem hb'_mem
      let η_E : ↥U_bl := (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₀₁) ≫ ι_0).base q_m01
      have hqm_comap : PrimeSpectrum.comap (Ideal.Quotient.mk Q₀_R.asIdeal) q_max =
          ⟨m_R, hmR_prime⟩ := by
        apply PrimeSpectrum.ext
        ext r
        change f_max (Ideal.Quotient.mk Q₀_R.asIdeal r) = 0 ↔ r ∈ m_R
        rw [Ideal.Quotient.factor_mk hQ_le_mR, Ideal.Quotient.eq_zero_iff_mem]
      have hηE_in : η_E ∈ E_loc := by
        change (p_bl.base (ι_0.base (PrimeSpectrum.comap f₀₁ q_m01)) : PrimeSpectrum B) =
          PrimeSpectrum.comap ρ_σ q_max
        have hp_eq : (p_bl.base (ι_0.base (PrimeSpectrum.comap f₀₁ q_m01)) : PrimeSpectrum B) =
            PrimeSpectrum.comap ψ_0 (PrimeSpectrum.comap f₀₁ q_m01) := by
          change (ι_0 ≫ p_bl).base (PrimeSpectrum.comap f₀₁ q_m01) = _; rw [hι0_p]; rfl
        rw [hp_eq]
        apply (hEq_σ _ q_max).mp
        refine ⟨?_, ?_, ?_⟩
        · rw [hqm_comap]
          apply PrimeSpectrum.ext
          change (PrimeSpectrum.comap (ψ_0.comp φ_RB) (PrimeSpectrum.comap f₀₁ q_m01)).asIdeal = m_R
          rw [hψ0_φRB, hqm01_R]
        · change ψ_0 (d_X 0) ∈ (PrimeSpectrum.comap f₀₁ q_m01).asIdeal
          rwa [hψ0_d0]
        · change ψ_0 (d_X 1) ∈ (PrimeSpectrum.comap f₀₁ q_m01).asIdeal
          rw [hψ0_d1_mul]
          have hb'_in : φ_R0 b' ∈ (PrimeSpectrum.comap f₀₁ q_m01).asIdeal := by
            change b' ∈ (PrimeSpectrum.comap φ_R0 (PrimeSpectrum.comap f₀₁ q_m01)).asIdeal
            rwa [hqm01_R]
          exact Ideal.mul_mem_right g_0 _ hb'_in
      have hEloc_sub_cl : E_loc ⊆ closure ({η_E} : Set ↥U_bl) := by
        intro y hy
        have hy' : (p_bl.base y : PrimeSpectrum B) = PrimeSpectrum.comap ρ_σ q_max := hy
        obtain ⟨hRB_y, hd0_y, hd1_y⟩ := (hEq_σ (p_bl.base y) q_max).mpr hy'
        have hmR_le_y : m_R ≤ (PrimeSpectrum.comap φ_RB (p_bl.base y)).asIdeal := by
          rw [hRB_y, hqm_comap]
        rcases hCov_cases y with ⟨p₀, rfl⟩ | ⟨p₁, rfl⟩
        · have hp0_pbl : (p_bl.base (ι_0.base p₀) : PrimeSpectrum B) =
              PrimeSpectrum.comap ψ_0 p₀ := by
            change (ι_0 ≫ p_bl).base p₀ = _; rw [hι0_p]; rfl
          rw [hp0_pbl] at hd0_y hmR_le_y
          have hu0_p0 : u_0 ∈ p₀.asIdeal := by
            change ψ_0 (d_X 0) ∈ p₀.asIdeal at hd0_y; rwa [hψ0_d0] at hd0_y
          have hmR_p0 : m_R ≤ (PrimeSpectrum.comap φ_R0 p₀).asIdeal := by
            rw [← hψ0_φRB]; exact hmR_le_y
          exact map_mem_closure_of_le ι_0 (hqm01_le0 p₀ hu0_p0 hmR_p0)
        · have hp1_pbl : (p_bl.base (ι_1.base p₁) : PrimeSpectrum B) =
              PrimeSpectrum.comap ψ_1 p₁ := by
            change (ι_1 ≫ p_bl).base p₁ = _; rw [hι1_p]; rfl
          rw [hp1_pbl] at hd1_y hmR_le_y
          have hv1_p1 : v_1 ∈ p₁.asIdeal := by
            change ψ_1 (d_X 1) ∈ p₁.asIdeal at hd1_y; rwa [hψ1_d1] at hd1_y
          have hmR_p1 : m_R ≤ (PrimeSpectrum.comap φ_R1 p₁).asIdeal := by
            rw [← hψ1_φRB]; exact hmR_le_y
          have hη_eq1 : η_E = ι_1.base (PrimeSpectrum.comap f₁₀ q_m01) := by
            change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₀₁) ≫ ι_0).base q_m01 =
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₁₀) ≫ ι_1).base q_m01
            rw [hGlue_01]
          rw [hη_eq1]
          exact map_mem_closure_of_le ι_1 (hqm01_le1 p₁ hv1_p1 hmR_p1)
      have hIrred_Eloc : IsIrreducible E_loc := isIrred_of_mem_closure hηE_in hEloc_sub_cl
      let Z_0 : Set ↥U_bl :=
        ι_0.base '' {p : PrimeSpectrum C_0 |
          g_0 ∈ p.asIdeal ∧ (PrimeSpectrum.comap φ_R0 p).asIdeal = m_R}
      let Z_1 : Set ↥U_bl :=
        ι_1.base '' {p : PrimeSpectrum C_1 |
          g_1 ∈ p.asIdeal ∧ (PrimeSpectrum.comap φ_R1 p).asIdeal = m_R}
      have isClosed_of_preimages : ∀ {Z : Set ↥U_bl},
          IsClosed (ι_0.base ⁻¹' Z) → IsClosed (ι_1.base ⁻¹' Z) → IsClosed Z := by
        intro Z h0 h1
        rw [← isOpen_compl_iff]
        have hcompl : Zᶜ = ι_0.base '' (ι_0.base ⁻¹' Z)ᶜ ∪ ι_1.base '' (ι_1.base ⁻¹' Z)ᶜ := by
          ext y
          simp only [Set.mem_compl_iff, Set.mem_union, Set.mem_image, Set.mem_preimage]
          constructor
          · intro hy
            rcases hCov_cases y with ⟨p₀, rfl⟩ | ⟨p₁, rfl⟩
            · exact Or.inl ⟨p₀, hy, rfl⟩
            · exact Or.inr ⟨p₁, hy, rfl⟩
          · rintro (⟨p₀, hp₀, rfl⟩ | ⟨p₁, hp₁, rfl⟩) <;> assumption
        rw [hcompl]
        exact (ι_0.isOpenEmbedding.isOpenMap _ h0.isOpen_compl).union
          (ι_1.isOpenEmbedding.isOpenMap _ h1.isOpen_compl)
      have hmR_eq_iff_le : ∀ (P : PrimeSpectrum ↥R), P.asIdeal = m_R ↔ m_R ≤ P.asIdeal :=
        fun P => ⟨fun h => h.ge, fun h => (hmR_max.eq_of_le P.isPrime.ne_top h).symm⟩
      have hZ0_pre0 : ι_0.base ⁻¹' Z_0 =
          PrimeSpectrum.zeroLocus ({g_0} ∪ φ_R0 '' (m_R : Set ↥R)) := by
        ext p
        constructor
        · rintro ⟨p', ⟨hg0_p', hp'_mR⟩, hp_eq⟩
          cases hι0_inj hp_eq
          rintro z (rfl | ⟨r, hr, rfl⟩)
          · exact hg0_p'
          · rw [← hp'_mR] at hr
            exact hr
        · intro hp_zl
          refine ⟨p, ⟨hp_zl (Or.inl rfl),
            (hmR_eq_iff_le (PrimeSpectrum.comap φ_R0 p)).mpr fun r hr =>
              hp_zl (Or.inr ⟨r, hr, rfl⟩)⟩, rfl⟩
      have hZ0_pre1 : ι_1.base ⁻¹' Z_0 = ∅ := by
        ext p₁
        simp only [Z_0, Set.mem_preimage, Set.mem_image, Set.mem_empty_iff_false, iff_false]
        rintro ⟨p₀, ⟨hg0_p0, _⟩, hp_eq⟩
        exact (hRange_01 p₀).mp ⟨p₁, hp_eq.symm⟩ hg0_p0
      have hCl_Z0 : IsClosed Z_0 := by
        refine isClosed_of_preimages ?_ ?_
        · rw [hZ0_pre0]; exact PrimeSpectrum.isClosed_zeroLocus _
        · rw [hZ0_pre1]; exact isClosed_empty
      have hZ1_pre1 : ι_1.base ⁻¹' Z_1 =
          PrimeSpectrum.zeroLocus ({g_1} ∪ φ_R1 '' (m_R : Set ↥R)) := by
        ext p
        constructor
        · rintro ⟨p', ⟨hg1_p', hp'_mR⟩, hp_eq⟩
          cases hι1_inj hp_eq
          rintro z (rfl | ⟨r, hr, rfl⟩)
          · exact hg1_p'
          · rw [← hp'_mR] at hr
            exact hr
        · intro hp_zl
          refine ⟨p, ⟨hp_zl (Or.inl rfl),
            (hmR_eq_iff_le (PrimeSpectrum.comap φ_R1 p)).mpr fun r hr =>
              hp_zl (Or.inr ⟨r, hr, rfl⟩)⟩, rfl⟩
      have hZ1_pre0 : ι_0.base ⁻¹' Z_1 = ∅ := by
        ext p₀
        simp only [Z_1, Set.mem_preimage, Set.mem_image, Set.mem_empty_iff_false, iff_false]
        rintro ⟨p₁, ⟨hg1_p1, _⟩, hp_eq⟩
        exact (hRange_10 p₁).mp ⟨p₀, hp_eq.symm⟩ hg1_p1
      have hCl_Z1 : IsClosed Z_1 := by
        refine isClosed_of_preimages ?_ ?_
        · rw [hZ1_pre0]; exact isClosed_empty
        · rw [hZ1_pre1]; exact PrimeSpectrum.isClosed_zeroLocus _
      have hqS0_in_T0 : ι_0.base q_S0 ∈ p_bl.base ⁻¹' T_0 := by
        have hp_eq : (p_bl.base (ι_0.base q_S0) : PrimeSpectrum B) =
            PrimeSpectrum.comap ψ_0 q_S0 := by
          change (ι_0 ≫ p_bl).base q_S0 = _; rw [hι0_p]; rfl
        change (p_bl.base (ι_0.base q_S0) : PrimeSpectrum B) ∈ T_0
        rw [hp_eq]
        refine ⟨⟨?_, ?_⟩, ?_⟩
        · change ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_0) ≫ g_B).base q_S0).asIdeal = m_R
          rw [hgB_eq, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hψ0_φRB]
          exact hqS0_R
        · change ψ_0 (d_X 1) ∈ q_S0.asIdeal
          rw [hψ0_d1_mul]
          exact Ideal.mul_mem_left _ _ hg0_qS0
        · intro heq
          have hd0_mem : d_X 0 ∈ (PrimeSpectrum.comap ρ_σ q_max).asIdeal := by
            change ρ_σ (d_X 0) ∈ q_max.asIdeal
            rw [hρ_σ_X 0]
            exact Ideal.zero_mem _
          have heq' : PrimeSpectrum.comap ψ_0 q_S0 = PrimeSpectrum.comap ρ_σ q_max := heq
          rw [← heq'] at hd0_mem
          change ψ_0 (d_X 0) ∈ q_S0.asIdeal at hd0_mem
          rw [hψ0_d0] at hd0_mem
          exact hu0_qS0 hd0_mem
      have hT0_sub_Z0 : p_bl.base ⁻¹' T_0 ⊆ Z_0 := by
        rintro y ⟨⟨hy_mR, hd1_y⟩, hy_ne⟩
        have hy_RB : PrimeSpectrum.comap φ_RB (p_bl.base y) = ⟨m_R, hmR_prime⟩ := by
          apply PrimeSpectrum.ext
          rw [hgB_eq] at hy_mR
          exact hy_mR
        have hd0_not_y : d_X 0 ∉ (p_bl.base y).asIdeal := by
          intro hd0_y
          apply hy_ne
          exact (hEq_σ (p_bl.base y) q_max).mp ⟨hy_RB.trans hqm_comap.symm, hd0_y, hd1_y⟩
        rcases hCov_cases y with ⟨p₀, rfl⟩ | ⟨p₁, rfl⟩
        · have hp0_pbl : (p_bl.base (ι_0.base p₀) : PrimeSpectrum B) =
              PrimeSpectrum.comap ψ_0 p₀ := by
            change (ι_0 ≫ p_bl).base p₀ = _; rw [hι0_p]; rfl
          have hp0_mR : (PrimeSpectrum.comap φ_R0 p₀).asIdeal = m_R := by
            rw [← hψ0_φRB]
            rw [hp0_pbl] at hy_RB
            exact congrArg PrimeSpectrum.asIdeal hy_RB
          have hu0_not : u_0 ∉ p₀.asIdeal := by
            rw [hp0_pbl] at hd0_not_y
            change ψ_0 (d_X 0) ∉ p₀.asIdeal at hd0_not_y
            rwa [hψ0_d0] at hd0_not_y
          have hprod_mem : u_0 * g_0 ∈ p₀.asIdeal := by
            rw [hu0_mul_g0]
            change π_tilde ∈ (PrimeSpectrum.comap φ_R0 p₀).asIdeal
            rwa [hp0_mR]
          have hg0_mem : g_0 ∈ p₀.asIdeal :=
            (p₀.isPrime.mem_or_mem hprod_mem).resolve_left hu0_not
          exact ⟨p₀, ⟨hg0_mem, hp0_mR⟩, rfl⟩
        · exfalso
          have hp1_pbl : (p_bl.base (ι_1.base p₁) : PrimeSpectrum B) =
              PrimeSpectrum.comap ψ_1 p₁ := by
            change (ι_1 ≫ p_bl).base p₁ = _; rw [hι1_p]; rfl
          have hp1_mR : (PrimeSpectrum.comap φ_R1 p₁).asIdeal = m_R := by
            rw [← hψ1_φRB]
            rw [hp1_pbl] at hy_RB
            exact congrArg PrimeSpectrum.asIdeal hy_RB
          apply hd0_not_y
          rw [hp1_pbl]
          change ψ_1 (d_X 0) ∈ p₁.asIdeal
          rw [hψ1_d0_mul]
          have hπ_in : φ_R1 π_tilde ∈ p₁.asIdeal := by
            change π_tilde ∈ (PrimeSpectrum.comap φ_R1 p₁).asIdeal
            rwa [hp1_mR]
          exact Ideal.mul_mem_right g_1 _ hπ_in
      have hZ0_sub_cl : Z_0 ⊆ closure ({ι_0.base q_S0} : Set ↥U_bl) := by
        rintro _ ⟨p₀, ⟨hg0_p0, hp0_mR⟩, rfl⟩
        exact map_mem_closure_of_le ι_0 (hqS0_min p₀ hg0_p0 hp0_mR.ge)
      have hS0_eq_cl : S_0 = closure ({ι_0.base q_S0} : Set ↥U_bl) := by
        apply Set.Subset.antisymm
        · exact (closure_minimal hT0_sub_Z0 hCl_Z0).trans hZ0_sub_cl
        · exact closure_mono (Set.singleton_subset_iff.mpr hqS0_in_T0)
      have hS0_eq_Z0 : S_0 = Z_0 := by
        apply Set.Subset.antisymm
        · exact closure_minimal hT0_sub_Z0 hCl_Z0
        · rw [hS0_eq_cl]; exact hZ0_sub_cl
      have hqS1_in_T1 : ι_1.base q_S1 ∈ p_bl.base ⁻¹' T_1 := by
        have hp_eq : (p_bl.base (ι_1.base q_S1) : PrimeSpectrum B) =
            PrimeSpectrum.comap ψ_1 q_S1 := by
          change (ι_1 ≫ p_bl).base q_S1 = _; rw [hι1_p]; rfl
        change (p_bl.base (ι_1.base q_S1) : PrimeSpectrum B) ∈ T_1
        rw [hp_eq]
        refine ⟨⟨?_, ?_⟩, ?_⟩
        · change ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_1) ≫ g_B).base q_S1).asIdeal = m_R
          rw [hgB_eq, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hψ1_φRB]
          exact hqS1_R
        · change ψ_1 (d_X 0) ∈ q_S1.asIdeal
          rw [hψ1_d0_mul]
          exact Ideal.mul_mem_left _ _ hg1_qS1
        · intro heq
          have hd1_mem : d_X 1 ∈ (PrimeSpectrum.comap ρ_σ q_max).asIdeal := by
            change ρ_σ (d_X 1) ∈ q_max.asIdeal
            rw [hρ_σ_X 1]
            exact Ideal.zero_mem _
          have heq' : PrimeSpectrum.comap ψ_1 q_S1 = PrimeSpectrum.comap ρ_σ q_max := heq
          rw [← heq'] at hd1_mem
          change ψ_1 (d_X 1) ∈ q_S1.asIdeal at hd1_mem
          rw [hψ1_d1] at hd1_mem
          exact hv1_qS1 hd1_mem
      have hT1_sub_Z1 : p_bl.base ⁻¹' T_1 ⊆ Z_1 := by
        rintro y ⟨⟨hy_mR, hd0_y⟩, hy_ne⟩
        have hy_RB : PrimeSpectrum.comap φ_RB (p_bl.base y) = ⟨m_R, hmR_prime⟩ := by
          apply PrimeSpectrum.ext
          rw [hgB_eq] at hy_mR
          exact hy_mR
        have hd1_not_y : d_X 1 ∉ (p_bl.base y).asIdeal := by
          intro hd1_y
          apply hy_ne
          exact (hEq_σ (p_bl.base y) q_max).mp ⟨hy_RB.trans hqm_comap.symm, hd0_y, hd1_y⟩
        rcases hCov_cases y with ⟨p₀, rfl⟩ | ⟨p₁, rfl⟩
        · exfalso
          have hp0_pbl : (p_bl.base (ι_0.base p₀) : PrimeSpectrum B) =
              PrimeSpectrum.comap ψ_0 p₀ := by
            change (ι_0 ≫ p_bl).base p₀ = _; rw [hι0_p]; rfl
          have hp0_mR : (PrimeSpectrum.comap φ_R0 p₀).asIdeal = m_R := by
            rw [← hψ0_φRB]
            rw [hp0_pbl] at hy_RB
            exact congrArg PrimeSpectrum.asIdeal hy_RB
          apply hd1_not_y
          rw [hp0_pbl]
          change ψ_0 (d_X 1) ∈ p₀.asIdeal
          rw [hψ0_d1_mul]
          have hb'_in : φ_R0 b' ∈ p₀.asIdeal := by
            change b' ∈ (PrimeSpectrum.comap φ_R0 p₀).asIdeal
            rwa [hp0_mR]
          exact Ideal.mul_mem_right g_0 _ hb'_in
        · have hp1_pbl : (p_bl.base (ι_1.base p₁) : PrimeSpectrum B) =
              PrimeSpectrum.comap ψ_1 p₁ := by
            change (ι_1 ≫ p_bl).base p₁ = _; rw [hι1_p]; rfl
          have hp1_mR : (PrimeSpectrum.comap φ_R1 p₁).asIdeal = m_R := by
            rw [← hψ1_φRB]
            rw [hp1_pbl] at hy_RB
            exact congrArg PrimeSpectrum.asIdeal hy_RB
          have hv1_not : v_1 ∉ p₁.asIdeal := by
            rw [hp1_pbl] at hd1_not_y
            change ψ_1 (d_X 1) ∉ p₁.asIdeal at hd1_not_y
            rwa [hψ1_d1] at hd1_not_y
          have hprod_mem : g_1 * v_1 ∈ p₁.asIdeal := by
            rw [hg1_mul_v1]
            change b' ∈ (PrimeSpectrum.comap φ_R1 p₁).asIdeal
            rwa [hp1_mR]
          have hg1_mem : g_1 ∈ p₁.asIdeal :=
            (p₁.isPrime.mem_or_mem hprod_mem).resolve_right hv1_not
          exact ⟨p₁, ⟨hg1_mem, hp1_mR⟩, rfl⟩
      have hZ1_sub_cl : Z_1 ⊆ closure ({ι_1.base q_S1} : Set ↥U_bl) := by
        rintro _ ⟨p₁, ⟨hg1_p1, hp1_mR⟩, rfl⟩
        exact map_mem_closure_of_le ι_1 (hqS1_min p₁ hg1_p1 hp1_mR.ge)
      have hS1_eq_cl : S_1 = closure ({ι_1.base q_S1} : Set ↥U_bl) := by
        apply Set.Subset.antisymm
        · exact (closure_minimal hT1_sub_Z1 hCl_Z1).trans hZ1_sub_cl
        · exact closure_mono (Set.singleton_subset_iff.mpr hqS1_in_T1)
      have hS1_eq_Z1 : S_1 = Z_1 := by
        apply Set.Subset.antisymm
        · exact closure_minimal hT1_sub_Z1 hCl_Z1
        · rw [hS1_eq_cl]; exact hZ1_sub_cl
      have hIrred_S0 : IsIrreducible S_0 := by
        rw [hS0_eq_cl]; exact isIrreducible_singleton.closure
      have hIrred_S1 : IsIrreducible S_1 := by
        rw [hS1_eq_cl]; exact isIrreducible_singleton.closure
      have hChart0_fib : ∀ p : PrimeSpectrum C_0,
          (g_Ubl.base (ι_0.base p)).asIdeal = m_R →
          ι_0.base p ∉ S_1 ∧
          (ι_0.base p ∈ S_0 ↔ g_0 ∈ p.asIdeal) ∧
          (ι_0.base p ∈ E_loc ↔ u_0 ∈ p.asIdeal) := by
        intro p hp_mR
        have hp_R0 : (PrimeSpectrum.comap φ_R0 p).asIdeal = m_R := by
          change ((ι_0 ≫ g_Ubl).base p).asIdeal = m_R at hp_mR
          rwa [hι0_gUbl] at hp_mR
        refine ⟨?_, ?_, ?_⟩
        · rw [hS1_eq_Z1]
          intro hmem
          have hpre : p ∈ ι_0.base ⁻¹' Z_1 := hmem
          rw [hZ1_pre0] at hpre
          exact hpre
        · rw [hS0_eq_Z0]
          constructor
          · rintro ⟨p', ⟨hg0_p', _⟩, hp_eq⟩
            cases hι0_inj hp_eq
            exact hg0_p'
          · intro hg0_p
            exact ⟨p, ⟨hg0_p, hp_R0⟩, rfl⟩
        · have hp_pbl : (p_bl.base (ι_0.base p) : PrimeSpectrum B) =
              PrimeSpectrum.comap ψ_0 p := by
            change (ι_0 ≫ p_bl).base p = _; rw [hι0_p]; rfl
          have hEloc_iff : ι_0.base p ∈ E_loc ↔
              PrimeSpectrum.comap ψ_0 p = PrimeSpectrum.comap ρ_σ q_max := by
            change (p_bl.base (ι_0.base p) : PrimeSpectrum B) = PrimeSpectrum.comap ρ_σ q_max ↔ _
            rw [hp_pbl]
            rfl
          rw [hEloc_iff, ← hEq_σ (PrimeSpectrum.comap ψ_0 p) q_max]
          have hRB_eq : PrimeSpectrum.comap φ_RB (PrimeSpectrum.comap ψ_0 p) =
              PrimeSpectrum.comap (Ideal.Quotient.mk Q₀_R.asIdeal) q_max := by
            rw [hqm_comap]
            apply PrimeSpectrum.ext
            change (PrimeSpectrum.comap (ψ_0.comp φ_RB) p).asIdeal = m_R
            rwa [hψ0_φRB]
          have hd1_in : d_X 1 ∈ (PrimeSpectrum.comap ψ_0 p).asIdeal := by
            change ψ_0 (d_X 1) ∈ p.asIdeal
            rw [hψ0_d1_mul]
            have hb'_in : φ_R0 b' ∈ p.asIdeal := by
              change b' ∈ (PrimeSpectrum.comap φ_R0 p).asIdeal; rwa [hp_R0]
            exact Ideal.mul_mem_right g_0 _ hb'_in
