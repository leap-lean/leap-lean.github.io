    obtain ⟨P₀, hP₀_lt, hP₀_prime, hP₀_lies⟩ :=
      Ideal.exists_ideal_lt_liesOver_of_lt (R := Polynomial R₀) (S := A₁) M₁ hp₀_lt_q₁
    have hc₁_P₀ : Ideal.comap c₁ P₀ = m_R := by
      have hover : Ideal.comap ψ_sm P₀ = p₀ := hP₀_lies.1.symm
      ext r
      have h1 : r ∈ Ideal.comap c₁ P₀ ↔ Polynomial.C r ∈ Ideal.comap ψ_sm P₀ := by
        simp only [Ideal.mem_comap, ← hψ_c, RingHom.comp_apply]
      rw [h1, hover, hπR_ker_mem]
      refine ⟨fun h => by simpa using h 0, fun hr i => ?_⟩
      rcases eq_or_ne i 0 with rfl | hi
      · simpa using hr
      · simp [Polynomial.coeff_C, hi]
    obtain ⟨hDom_Rstar, hinj_Rstar, hUniquePrime_Rstar, hDiv_Rstar⟩ :=
      etale_over_poly_atPrime_dvr k₀ B₁ M₁_bar hunder_ne_bot
    let R_star := Localization.AtPrime M₁_bar
    let loc_map : A₁ →+* R_star := (algebraMap B₁ R_star).comp (Ideal.Quotient.mk J₁)
    let Q_sm : Ideal A₁ := RingHom.ker loc_map
    haveI : Q_sm.IsPrime := RingHom.ker_isPrime loc_map
    refine ⟨⟨P₀, hP₀_prime, hc₁_P₀, hP₀_lt.le, hP₀_lt.ne⟩, ⟨Q_sm, ?_⟩⟩
    intro P hP_prime hc₁_P hP_le hP_ne
    have hJ₁_le_P : J₁ ≤ P := by
      rw [Ideal.map_le_iff_le_comap, hc₁_P]
    let P_bar : Ideal B₁ := Ideal.map (Ideal.Quotient.mk J₁) P
    have hP_comap : Ideal.comap (Ideal.Quotient.mk J₁) P_bar = P := by
      dsimp only [P_bar]
      rw [Ideal.comap_map_of_surjective' (Ideal.Quotient.mk J₁) Ideal.Quotient.mk_surjective,
        Ideal.mk_ker, sup_of_le_left hJ₁_le_P]
    haveI hP_bar_prime : P_bar.IsPrime :=
      Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective (by rwa [Ideal.mk_ker])
    have hP_bar_le : P_bar ≤ M₁_bar := Ideal.map_mono hP_le
    have hP_bar_ne : P_bar ≠ M₁_bar := by
      intro heq
      apply hP_ne
      rw [← hP_comap, heq, hM₁_comap]
    have hDisj_Pbar : Disjoint (M₁_bar.primeCompl : Set B₁) (P_bar : Set B₁) := by
      rw [Set.disjoint_left]
      intro b hb_compl hb_P
      exact hb_compl (hP_bar_le hb_P)
    let P_loc : Ideal R_star := Ideal.map (algebraMap B₁ R_star) P_bar
    haveI hP_loc_prime : P_loc.IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint M₁_bar.primeCompl R_star P_bar hP_bar_prime hDisj_Pbar
    have hP_loc_under : Ideal.comap (algebraMap B₁ R_star) P_loc = P_bar :=
      IsLocalization.under_map_of_isPrime_disjoint M₁_bar.primeCompl R_star hP_bar_prime hDisj_Pbar
    have hP_loc_ne_max : P_loc ≠ IsLocalRing.maximalIdeal R_star := by
      intro heq
      apply hP_bar_ne
      rw [← hP_loc_under, heq, ← Localization.AtPrime.map_eq_maximalIdeal]
      exact IsLocalization.under_map_of_isPrime_disjoint M₁_bar.primeCompl R_star
        hM₁_bar_max.isPrime (Set.disjoint_left.mpr (fun _ h1 h2 => h1 h2))
    have hP_loc_bot : P_loc = ⊥ := hUniquePrime_Rstar P_loc hP_loc_ne_max
    have hP_eq_Qsm : P = Q_sm := by
      calc P = Ideal.comap (Ideal.Quotient.mk J₁) P_bar := hP_comap.symm
        _ = Ideal.comap (Ideal.Quotient.mk J₁) (Ideal.comap (algebraMap B₁ R_star) P_loc) := by
              rw [hP_loc_under]
        _ = Ideal.comap loc_map P_loc := rfl
        _ = Ideal.comap loc_map ⊥ := by rw [hP_loc_bot]
        _ = Q_sm := rfl
    have hψ_P_iff : ∀ P_T : Polynomial R₀,
        ψ_sm P_T ∈ P ↔ ∀ i : ℕ, P_T.coeff i ∈ m_R := by
      intro P_T
      rw [hP_eq_Qsm]
      change (algebraMap B₁ R_star) (((Ideal.Quotient.mk J₁).comp ψ_sm) P_T) = 0 ↔ _
      rw [← hψ_bar_comm]
      change (algebraMap (Polynomial k₀) R_star) (π_R P_T) = 0 ↔ _
      rw [← map_zero (algebraMap (Polynomial k₀) R_star), hinj_Rstar.eq_iff]
      exact hπR_ker_mem P_T
    refine ⟨hP_eq_Qsm, hψ_P_iff, ?_, ?_⟩
    · intro x y _ _
      rcases hDiv_Rstar (loc_map x) (loc_map y) with ⟨q_r, hq_r⟩ | ⟨q_r, hq_r⟩
      · obtain ⟨⟨c_bar, t_bar⟩, hsurj⟩ := IsLocalization.surj M₁_bar.primeCompl q_r
        obtain ⟨c, rfl⟩ := Ideal.Quotient.mk_surjective c_bar
        obtain ⟨t, ht_eq⟩ := Ideal.Quotient.mk_surjective t_bar.1
        have ht_not : t ∉ M₁ := by
          rw [← hM₁_comap, Ideal.mem_comap, ht_eq]
          exact t_bar.2
        refine Or.inl ⟨c, t, ht_not, ?_⟩
        rw [hP_eq_Qsm]
        change loc_map (x * t - y * c) = 0
        have hsurj' : q_r * loc_map t = loc_map c := by
          change q_r * algebraMap B₁ R_star (Ideal.Quotient.mk J₁ t) =
            algebraMap B₁ R_star (Ideal.Quotient.mk J₁ c)
          rw [ht_eq]; exact hsurj
        calc loc_map (x * t - y * c)
            = loc_map x * loc_map t - loc_map y * loc_map c := by
                rw [map_sub, map_mul, map_mul]
          _ = (q_r * loc_map y) * loc_map t - loc_map y * (q_r * loc_map t) := by
                rw [hq_r, hsurj']
          _ = 0 := by ring
      · obtain ⟨⟨c_bar, t_bar⟩, hsurj⟩ := IsLocalization.surj M₁_bar.primeCompl q_r
        obtain ⟨c, rfl⟩ := Ideal.Quotient.mk_surjective c_bar
        obtain ⟨t, ht_eq⟩ := Ideal.Quotient.mk_surjective t_bar.1
        have ht_not : t ∉ M₁ := by
          rw [← hM₁_comap, Ideal.mem_comap, ht_eq]
          exact t_bar.2
        refine Or.inr ⟨c, t, ht_not, ?_⟩
        rw [hP_eq_Qsm]
        change loc_map (y * t - x * c) = 0
        have hsurj' : q_r * loc_map t = loc_map c := by
          change q_r * algebraMap B₁ R_star (Ideal.Quotient.mk J₁ t) =
            algebraMap B₁ R_star (Ideal.Quotient.mk J₁ c)
          rw [ht_eq]; exact hsurj
        calc loc_map (y * t - x * c)
            = loc_map y * loc_map t - loc_map x * loc_map c := by
                rw [map_sub, map_mul, map_mul]
          _ = (q_r * loc_map x) * loc_map t - loc_map x * (q_r * loc_map t) := by
                rw [hq_r, hsurj']
          _ = 0 := by ring
    · refine ⟨1, hP_prime.one_notMem, (algebraMap A₁ (Localization.Away (1 : A₁))).comp ψ_sm, ?_, ?_, ?_⟩
      · have het1 : (algebraMap A₁ (Localization.Away (1 : A₁))).Etale :=
          RingHom.etale_algebraMap.mpr (Algebra.Etale.of_isLocalizationAway (1 : A₁))
        exact RingHom.Etale.stableUnderComposition ψ_sm _ hψ_et het1
      · rw [RingHom.comp_assoc, hψ_c]
      · intro P_T
        have hDisj1 : Disjoint (Submonoid.powers (1 : A₁) : Set A₁) (P : Set A₁) := by
          rw [Set.disjoint_left]
          rintro _ ⟨k, rfl⟩ hmem
          change (1 : A₁) ^ k ∈ P at hmem
          rw [one_pow] at hmem
          exact hP_prime.one_notMem hmem
        have hunder1 : Ideal.comap (algebraMap A₁ (Localization.Away (1 : A₁)))
            (Ideal.map (algebraMap A₁ (Localization.Away (1 : A₁))) P) = P :=
          IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers (1 : A₁))
            (Localization.Away (1 : A₁)) hP_prime hDisj1
        change ψ_sm P_T ∈ Ideal.comap (algebraMap A₁ (Localization.Away (1 : A₁)))
          (Ideal.map (algebraMap A₁ (Localization.Away (1 : A₁))) P) ↔ _
        rw [hunder1]
        exact hψ_P_iff P_T
  
  have exists_nodalLaurEquiv : ∀ {R₀ : Type u} [CommRing R₀] (a : R₀) (i₀ : Fin 2),
      let I_a : Ideal (MvPolynomial (Fin 2) R₀) :=
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}
      ∃ e_laur : Localization.Away (Polynomial.X : Polynomial R₀) ≃+*
          Localization.Away (Ideal.Quotient.mk I_a (MvPolynomial.X i₀)),
        (∀ r : R₀, e_laur (algebraMap (Polynomial R₀) _ (Polynomial.C r)) =
          algebraMap _ _ (Ideal.Quotient.mk I_a (MvPolynomial.C r))) ∧
        e_laur (algebraMap (Polynomial R₀) _ Polynomial.X) =
          algebraMap _ _ (Ideal.Quotient.mk I_a (MvPolynomial.X i₀)) := by
    intro R₀ _ a i₀ I_a
    let A_nod := MvPolynomial (Fin 2) R₀ ⧸ I_a
    let x₀ : A_nod := Ideal.Quotient.mk I_a (MvPolynomial.X i₀)
    let x₁ : A_nod := Ideal.Quotient.mk I_a (MvPolynomial.X (1 - i₀))
    have hx_mul : x₀ * x₁ = Ideal.Quotient.mk I_a (MvPolynomial.C a) := by
      have hrel : Ideal.Quotient.mk I_a (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
      rw [map_sub, map_mul, sub_eq_zero] at hrel
      fin_cases i₀
      · exact hrel
      · change Ideal.Quotient.mk I_a (MvPolynomial.X 1) * Ideal.Quotient.mk I_a (MvPolynomial.X 0) = _
        rw [mul_comm]; exact hrel
    let f_poly : Polynomial R₀ →+* Localization.Away x₀ :=
      Polynomial.eval₂RingHom
        ((algebraMap A_nod (Localization.Away x₀)).comp ((Ideal.Quotient.mk I_a).comp MvPolynomial.C))
        (algebraMap A_nod (Localization.Away x₀) x₀)
    have hf_X_unit : IsUnit (f_poly Polynomial.X) := by
      simp only [f_poly, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
      exact IsLocalization.Away.algebraMap_isUnit x₀
    let fwd : Localization.Away (Polynomial.X : Polynomial R₀) →+* Localization.Away x₀ :=
      IsLocalization.Away.lift Polynomial.X hf_X_unit
    obtain ⟨x_inv, hinv⟩ :=
      (IsLocalization.Away.algebraMap_isUnit
        (S := Localization.Away (Polynomial.X : Polynomial R₀))
        (Polynomial.X : Polynomial R₀)).exists_right_inv
    let g_mv : MvPolynomial (Fin 2) R₀ →+* Localization.Away (Polynomial.X : Polynomial R₀) :=
      MvPolynomial.eval₂Hom
        ((algebraMap (Polynomial R₀) (Localization.Away (Polynomial.X : Polynomial R₀))).comp Polynomial.C)
        (fun i : Fin 2 => if i = i₀ then
          algebraMap (Polynomial R₀) (Localization.Away (Polynomial.X : Polynomial R₀)) Polynomial.X
        else
          algebraMap (Polynomial R₀) (Localization.Away (Polynomial.X : Polynomial R₀)) (Polynomial.C a) * x_inv)
    have hg_ker : I_a ≤ RingHom.ker g_mv := by
      rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker, map_sub, map_mul]
      fin_cases i₀
      · simp only [g_mv, MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_X, MvPolynomial.eval₂_C,
          ↓reduceIte, Fin.one_eq_zero_iff, OfNat.ofNat_ne_zero, RingHom.comp_apply]
        calc algebraMap (Polynomial R₀) _ Polynomial.X *
              (algebraMap (Polynomial R₀) _ (Polynomial.C a) * x_inv) -
              algebraMap (Polynomial R₀) _ (Polynomial.C a)
            = algebraMap (Polynomial R₀) _ (Polynomial.C a) *
                (algebraMap (Polynomial R₀) _ Polynomial.X * x_inv) -
                algebraMap (Polynomial R₀) _ (Polynomial.C a) := by ring
          _ = 0 := by rw [hinv, mul_one, sub_self]
      · simp only [g_mv, MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_X, MvPolynomial.eval₂_C,
          Fin.zero_eq_one_iff, OfNat.ofNat_ne_zero, ↓reduceIte, RingHom.comp_apply]
        calc (algebraMap (Polynomial R₀) _ (Polynomial.C a) * x_inv) *
              algebraMap (Polynomial R₀) _ Polynomial.X -
              algebraMap (Polynomial R₀) _ (Polynomial.C a)
            = algebraMap (Polynomial R₀) _ (Polynomial.C a) *
                (algebraMap (Polynomial R₀) _ Polynomial.X * x_inv) -
                algebraMap (Polynomial R₀) _ (Polynomial.C a) := by ring
          _ = 0 := by rw [hinv, mul_one, sub_self]
    let g_nod : A_nod →+* Localization.Away (Polynomial.X : Polynomial R₀) :=
      Ideal.Quotient.lift I_a g_mv hg_ker
    have hg_x₀_unit : IsUnit (g_nod x₀) := by
      have hx₀_eq : g_nod x₀ = algebraMap (Polynomial R₀) _ Polynomial.X := by
        change g_mv (MvPolynomial.X i₀) = _
        simp [g_mv]
      rw [hx₀_eq]
      exact IsLocalization.Away.algebraMap_isUnit Polynomial.X
    let bwd : Localization.Away x₀ →+* Localization.Away (Polynomial.X : Polynomial R₀) :=
      IsLocalization.Away.lift x₀ hg_x₀_unit
    have h_left : bwd.comp fwd = RingHom.id _ := by
      apply IsLocalization.ringHom_ext (Submonoid.powers (Polynomial.X : Polynomial R₀))
      have hfwd_eq : fwd.comp (algebraMap (Polynomial R₀) (Localization.Away (Polynomial.X : Polynomial R₀))) = f_poly :=
        RingHom.ext (IsLocalization.Away.lift_eq (S := Localization.Away (Polynomial.X : Polynomial R₀)) Polynomial.X hf_X_unit)
      rw [RingHom.comp_assoc, hfwd_eq]
      apply Polynomial.ringHom_ext
      · intro r
        change bwd (f_poly (Polynomial.C r)) = algebraMap (Polynomial R₀) _ (Polynomial.C r)
        simp only [f_poly, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C, RingHom.comp_apply]
        rw [IsLocalization.Away.lift_eq]
        change g_mv (MvPolynomial.C r) = _
        simp [g_mv]
      · change bwd (f_poly Polynomial.X) = algebraMap (Polynomial R₀) _ Polynomial.X
        simp only [f_poly, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
        rw [IsLocalization.Away.lift_eq]
        change g_mv (MvPolynomial.X i₀) = _
        simp [g_mv]
    have h_right : fwd.comp bwd = RingHom.id _ := by
      apply IsLocalization.ringHom_ext (Submonoid.powers x₀)
      have hbwd_eq : bwd.comp (algebraMap A_nod (Localization.Away x₀)) = g_nod :=
        RingHom.ext (IsLocalization.Away.lift_eq (S := Localization.Away x₀) x₀ hg_x₀_unit)
      rw [RingHom.comp_assoc, hbwd_eq]
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro r
        change fwd (g_mv (MvPolynomial.C r)) =
          algebraMap A_nod _ (Ideal.Quotient.mk I_a (MvPolynomial.C r))
        simp only [g_mv, MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_C, RingHom.comp_apply]
        rw [IsLocalization.Away.lift_eq]
        simp [f_poly]
      · intro i
        change fwd (g_mv (MvPolynomial.X i)) =
          algebraMap A_nod _ (Ideal.Quotient.mk I_a (MvPolynomial.X i))
        by_cases hi : i = i₀
        · subst hi
          simp only [g_mv, MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_X, ↓reduceIte]
          rw [IsLocalization.Away.lift_eq]
          simp [f_poly, x₀]
        · have hi1 : i = 1 - i₀ := by fin_cases i₀ <;> fin_cases i <;> simp_all
          subst hi1
          simp only [g_mv, MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_X, hi, ↓reduceIte,
            map_mul]
          rw [IsLocalization.Away.lift_eq]
          have h_inv_map : fwd x_inv * algebraMap A_nod _ x₀ = 1 := by
            have h1 : algebraMap A_nod (Localization.Away x₀) x₀ =
                fwd (algebraMap (Polynomial R₀) _ Polynomial.X) := by
              rw [IsLocalization.Away.lift_eq]; simp [f_poly]
            rw [h1, ← map_mul, mul_comm, hinv, map_one]
          have hf_Ca : f_poly (Polynomial.C a) =
              algebraMap A_nod _ (Ideal.Quotient.mk I_a (MvPolynomial.C a)) := by
            simp [f_poly]
          rw [hf_Ca, ← hx_mul, map_mul]
          calc (algebraMap A_nod _ x₀ * algebraMap A_nod _ x₁) * fwd x_inv
              = algebraMap A_nod _ x₁ * (fwd x_inv * algebraMap A_nod _ x₀) := by ring
            _ = algebraMap A_nod _ x₁ := by rw [h_inv_map, mul_one]
    let e_laur : Localization.Away (Polynomial.X : Polynomial R₀) ≃+* Localization.Away x₀ :=
      { fwd with
        invFun := bwd
        left_inv := fun z => RingHom.congr_fun h_left z
        right_inv := fun z => RingHom.congr_fun h_right z }
    refine ⟨e_laur, ?_, ?_⟩
    · intro r
      change fwd (algebraMap (Polynomial R₀) _ (Polynomial.C r)) = _
      rw [IsLocalization.Away.lift_eq]
      simp only [f_poly, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C, RingHom.comp_apply]
      rfl
    · change fwd (algebraMap (Polynomial R₀) _ Polynomial.X) = _
      rw [IsLocalization.Away.lift_eq]
      simp only [f_poly, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
      rfl
  
  have ring_closed_point_at_most_two_dvr_branches :
      ∀ (R₀ : Type u) [CommRing R₀] [IsLocalRing R₀]
        (A_Y : Type u) [CommRing A_Y]
        (c_R : R₀ →+* A_Y)
        (M_star : Ideal A_Y), M_star.IsMaximal →
        Ideal.comap c_R M_star = IsLocalRing.maximalIdeal R₀ →
        ((∃ ψ_sm : Polynomial R₀ →+* A_Y,
            ψ_sm.Etale ∧ ψ_sm.comp Polynomial.C = c_R) ∨
         (∃ (a : R₀) (ψ_nod : (MvPolynomial (Fin 2) R₀ ⧸
              Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}) →+* A_Y),
            a ≠ 0 ∧ ψ_nod.Etale ∧
            ψ_nod.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) = c_R)) →
        (∃ P₀ : Ideal A_Y, P₀.IsPrime ∧
          Ideal.comap c_R P₀ = IsLocalRing.maximalIdeal R₀ ∧
          P₀ ≤ M_star ∧ P₀ ≠ M_star) ∧
        (∃ Q : Fin 2 → Ideal A_Y,
          ∀ (P : Ideal A_Y) (_ : P.IsPrime),
            Ideal.comap c_R P = IsLocalRing.maximalIdeal R₀ →
            P ≤ M_star →
            P ≠ M_star →
            (∃ j : Fin 2, P = Q j) ∧
            (∀ x y : A_Y, x ∉ P → y ∉ P →
              (∃ c t : A_Y, t ∉ M_star ∧ x * t - y * c ∈ P) ∨
              (∃ c t : A_Y, t ∉ M_star ∧ y * t - x * c ∈ P)) ∧
            (∃ f₀ : A_Y, f₀ ∉ P ∧
              ∃ α₀ : Polynomial R₀ →+* Localization.Away f₀,
                α₀.Etale ∧
                α₀.comp Polynomial.C = (algebraMap A_Y (Localization.Away f₀)).comp c_R ∧
                ∀ P_T : Polynomial R₀,
                  (α₀ P_T ∈ Ideal.map (algebraMap A_Y (Localization.Away f₀)) P ↔
                    ∀ i : ℕ, P_T.coeff i ∈ IsLocalRing.maximalIdeal R₀))) := by
    intro R₀ _ _ A_Y _ c_R M_star hMax_M hcR_M hChart
    rcases hChart with ⟨ψ_sm, hψ_et, hψ_c⟩ | ⟨a, ψ_nod, _ha_ne, hψ_et, hψ_c⟩
    · obtain ⟨hEx, Q_sm, hQ_sm⟩ :=
        smooth_case_dvr_branches R₀ c_R M_star hMax_M hcR_M ψ_sm hψ_et hψ_c
      refine ⟨hEx, fun _ => Q_sm, fun P hP hcP hPle hPne => ?_⟩
      obtain ⟨hP_eq, _hψ_P, hFactII, hAway⟩ := hQ_sm P hP hcP hPle hPne
      exact ⟨⟨0, hP_eq⟩, hFactII, hAway⟩
    · let I_a : Ideal (MvPolynomial (Fin 2) R₀) :=
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}
      let A_nod := MvPolynomial (Fin 2) R₀ ⧸ I_a
      let xbar : Fin 2 → A_nod := fun j => Ideal.Quotient.mk I_a (MvPolynomial.X j)
      have hBuildAlpha : ∀ i₀ : Fin 2,
          ∃ α₀ : Polynomial R₀ →+* Localization.Away (ψ_nod (xbar i₀)),
            α₀.Etale ∧
            (∀ r : R₀, α₀ (Polynomial.C r) =
              algebraMap A_Y (Localization.Away (ψ_nod (xbar i₀))) (c_R r)) ∧
            α₀ Polynomial.X =
              algebraMap A_Y (Localization.Away (ψ_nod (xbar i₀))) (ψ_nod (xbar i₀)) := by
