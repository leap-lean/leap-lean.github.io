  let π_tilde := CategoryTheory.Limits.pullback.fst (q_M ≫ f'_M) e_0
  let f_tilde := CategoryTheory.Limits.pullback.snd (q_M ≫ f'_M) e_0

  obtain ⟨hϖ_P, hϖ_iff, hOfPrime, hOpen_j, _, _, _, _, hIso_f0_compl, hZ_sp, _⟩ := hChart
  obtain ⟨_, _, hf'_g, _, hProp_qM, hProp_f'M, _, _, _, hQ₀_neBot,
    hz_new_M_mem, hz₀_M_mem, hz_new_M_m0, hz_new_M_max, hz₀_M_Q0,
