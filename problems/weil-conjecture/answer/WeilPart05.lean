      refine ⟨fun z => ?_⟩
      obtain ⟨b₁, b₂, hb₂, hz_div⟩ := IsFractionRing.div_surjective (A := B_K) z
      rw [← hz_div, div_eq_mul_inv, ← Subalgebra.mem_algebraicClosure]
