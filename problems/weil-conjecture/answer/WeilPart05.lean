        · have hw_mul : (⟨x, hxW⟩ : ↥W₀) * ⟨x⁻¹, hxiW⟩ = 1 :=
            Subtype.ext (mul_inv_cancel₀ hx0)
          have hres_mul : res_W ⟨x, hxW⟩ * res_W ⟨x⁻¹, hxiW⟩ = 1 := by
            rw [← map_mul, hw_mul, map_one]
          have hres_ne : res_W ⟨x, hxW⟩ ≠ 0 := fun h0 =>
            zero_ne_one (by rw [h0, zero_mul] at hres_mul; exact hres_mul)
          have hres_inv : res_W ⟨x⁻¹, hxiW⟩ = (res_W ⟨x, hxW⟩)⁻¹ :=
            mul_left_cancel₀ hres_ne (hres_mul.trans (mul_inv_cancel₀ hres_ne).symm)
          rcases ValuationSubring.mem_or_inv_mem V₀ (res_W ⟨x, hxW⟩) with hv | hvi
          · exact Or.inl ⟨hxW, hv⟩
          · exact Or.inr ⟨hxiW, by rwa [hres_inv]⟩
        · have hnot_unit : ¬ IsUnit (⟨x, hxW⟩ : ↥W₀) := by
            intro hu
            obtain ⟨y, hy⟩ := hu.exists_right_inv
            have hy_val : x * y.1 = 1 := congrArg Subtype.val hy
            have hy_eq : y.1 = x⁻¹ :=
              mul_left_cancel₀ hx0 (hy_val.trans (mul_inv_cancel₀ hx0).symm)
            exact hxiW (hy_eq ▸ y.2)
          have hres0 : res_W ⟨x, hxW⟩ = 0 :=
            (IsLocalRing.residue_eq_zero_iff _).mpr ((IsLocalRing.mem_maximalIdeal _).mpr hnot_unit)
          exact Or.inl ⟨hxW, hres0 ▸ V₀.zero_mem⟩
      · rcases ValuationSubring.mem_or_inv_mem W₀ x with hxW' | hxiW
        · exact absurd hxW' hxW
        · have hnot_unit : ¬ IsUnit (⟨x⁻¹, hxiW⟩ : ↥W₀) := by
            intro hu
            obtain ⟨y, hy⟩ := hu.exists_right_inv
            have hy_val : x⁻¹ * y.1 = 1 := congrArg Subtype.val hy
            have hx_inv_ne : x⁻¹ ≠ 0 := inv_ne_zero hx0
            have hy_eq : y.1 = x :=
              mul_left_cancel₀ hx_inv_ne (hy_val.trans (inv_mul_cancel₀ hx0).symm)
            exact hxW (hy_eq ▸ y.2)
          have hres0 : res_W ⟨x⁻¹, hxiW⟩ = 0 :=
            (IsLocalRing.residue_eq_zero_iff _).mpr ((IsLocalRing.mem_maximalIdeal _).mpr hnot_unit)
          exact Or.inr ⟨hxiW, hres0 ▸ V₀.zero_mem⟩
  let U₀ : ValuationSubring F := ValuationSubring.mk U₀_sub hU₀_val
  have hU₀_le : U₀ ≤ W₀ := fun _ ⟨hx, _⟩ => hx
  let ι_UW : ↥U₀ →+* ↥W₀ := Subring.inclusion hU₀_le
  have h_res_V₀ : ∀ u : ↥U₀, (res_W.comp ι_UW) u ∈ V₀.toSubring :=
    fun u => let ⟨_, hv⟩ := u.2; hv
  let π_UV : ↥U₀ →+* ↥V₀ := (res_W.comp ι_UW).codRestrict V₀.toSubring h_res_V₀
  have hUnit_UV : ∀ u : ↥U₀, IsUnit u ↔ IsUnit (π_UV u) := by
    intro u
    refine ⟨IsUnit.map π_UV, fun huV => ?_⟩
    obtain ⟨v, hv⟩ := huV.exists_right_inv
    have hv_val : res_W (ι_UW u) * v.1 = 1 := congrArg Subtype.val hv
    have h_ne0 : res_W (ι_UW u) ≠ 0 := fun h0 =>
      zero_ne_one (by rw [h0, zero_mul] at hv_val; exact hv_val)
    have h_not_max : ι_UW u ∉ IsLocalRing.maximalIdeal ↥W₀ := by
      rwa [← IsLocalRing.residue_eq_zero_iff]
    obtain ⟨w, hw⟩ := (IsLocalRing.notMem_maximalIdeal.mp h_not_max).exists_right_inv
    have hw_res : res_W w = v.1 := by
      apply mul_left_cancel₀ h_ne0
      calc res_W (ι_UW u) * res_W w = res_W (ι_UW u * w) := (map_mul _ _ _).symm
        _ = res_W 1 := by rw [hw]
        _ = 1 := map_one _
        _ = res_W (ι_UW u) * v.1 := hv_val.symm
    have hw_U : w.1 ∈ U₀ := ⟨w.2, by change res_W w ∈ V₀; rw [hw_res]; exact v.2⟩
    refine IsUnit.of_mul_eq_one (⟨w.1, hw_U⟩ : ↥U₀) ?_
    apply Subtype.ext
    change (ι_UW u * w).1 = (1 : ↥W₀).1
    exact congrArg Subtype.val hw
  have hU₀_ne : U₀ ≠ W₀ := by
    intro h_eq
    have ht_not_max : ρ_W t ∉ IsLocalRing.maximalIdeal ↥W₀ := by
      change t ∉ Ideal.comap ρ_W (IsLocalRing.maximalIdeal ↥W₀)
      rw [hρW_comap]
      exact ht_not_PB
    obtain ⟨w_t, hwt⟩ := (IsLocalRing.notMem_maximalIdeal.mp ht_not_max).exists_right_inv
    let t_loc : Localization.AtPrime M_p'.asIdeal :=
      algebraMap (↑R_V) (Localization.AtPrime M_p'.asIdeal) t
    have ht_loc_max : t_loc ∈ IsLocalRing.maximalIdeal (Localization.AtPrime M_p'.asIdeal) :=
      (IsLocalization.AtPrime.to_map_mem_maximal_iff
        (Localization.AtPrime M_p'.asIdeal) M_p'.asIdeal t).mpr ht_Mp
    have ht_loc_not_unit : ¬ IsUnit t_loc :=
      (IsLocalRing.mem_maximalIdeal t_loc).mp ht_loc_max
    have hg_not_unit : ¬ IsUnit (g_loc t_loc) :=
      fun hu => ht_loc_not_unit (isUnit_of_map_unit g_loc t_loc hu)
    have hw_U : w_t.1 ∈ U₀ := h_eq.symm ▸ w_t.2
    have hg_unit : IsUnit (g_loc t_loc) := by
      refine IsUnit.of_mul_eq_one (π_UV ⟨w_t.1, hw_U⟩) ?_
      apply Subtype.ext
      change f_loc t_loc * res_W (ι_UW ⟨w_t.1, hw_U⟩) = 1
      have h_iw : ι_UW ⟨w_t.1, hw_U⟩ = w_t := rfl
      rw [h_iw, hf_loc t]
      change res_W (ρ_W t) * res_W w_t = 1
      rw [← map_mul, hwt, map_one]
    exact hg_not_unit hg_unit
  have hφC_U₀ : ∀ c : ↑R_V, φ_C.hom c ∈ U₀.toSubring := by
    intro c
    have hxW : φ_C.hom c ∈ W₀ := (hρW_val c) ▸ (ρ_W c).2
    refine ⟨hxW, ?_⟩
    have h_sub_eq : (⟨φ_C.hom c, hxW⟩ : ↥W₀) = ρ_W c := Subtype.ext (hρW_val c).symm
    rw [h_sub_eq]
    change bar_ρ c ∈ V₀
    rw [← hf_loc c]
    exact hV₀_mem (algebraMap (↑R_V) (Localization.AtPrime M_p'.asIdeal) c)
  let σ_U : ↑R_V →+* ↥U₀ := φ_C.hom.codRestrict U₀.toSubring hφC_U₀
  let σ_U_hom : R_V ⟶ CommRingCat.of ↥U₀ := CommRingCat.ofHom σ_U
  have hπ_σ : ∀ c : ↑R_V,
      π_UV (σ_U c) = g_loc (algebraMap (↑R_V) (Localization.AtPrime M_p'.asIdeal) c) := by
    intro c
    apply Subtype.ext
    change res_W (ι_UW (σ_U c)) =
      f_loc (algebraMap (↑R_V) (Localization.AtPrime M_p'.asIdeal) c)
    have h_iw : ι_UW (σ_U c) = ρ_W c := Subtype.ext (hρW_val c).symm
    rw [h_iw, hf_loc c]
    rfl
  let φ_hat : AlgebraicGeometry.Spec (CommRingCat.of ↥U₀) ⟶ Y_hat :=
    AlgebraicGeometry.Spec.map σ_U_hom ≫ hV_aff.fromSpec
  let mU₀ : AlgebraicGeometry.Spec (CommRingCat.of ↥U₀) :=
    ⟨IsLocalRing.maximalIdeal ↥U₀, (IsLocalRing.maximalIdeal.isMaximal ↥U₀).isPrime⟩
  refine ⟨U₀, φ_hat, mU₀, hU₀_le, hU₀_ne, rfl, ?_, ?_⟩
  · dsimp only [φ_hat]
    rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
    have hσ_sub : σ_U_hom ≫ CommRingCat.ofHom U₀.subtype = φ_C :=
      CommRingCat.hom_ext (RingHom.ext fun _ => rfl)
    rw [hσ_sub]
    exact hφC_η
  · have hmU_eq :
        ((AlgebraicGeometry.Spec.map σ_U_hom).base mU₀ : PrimeSpectrum ↑R_V) = M_p' := by
      apply PrimeSpectrum.ext
      ext c
      change σ_U c ∈ IsLocalRing.maximalIdeal ↥U₀ ↔ c ∈ M_p'.asIdeal
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, hUnit_UV (σ_U c), hπ_σ c]
      have h_loc_unit :
          IsUnit (g_loc (algebraMap (↑R_V) (Localization.AtPrime M_p'.asIdeal) c)) ↔
            IsUnit (algebraMap (↑R_V) (Localization.AtPrime M_p'.asIdeal) c) :=
        ⟨isUnit_of_map_unit g_loc _, IsUnit.map g_loc⟩
      rw [h_loc_unit, ← mem_nonunits_iff, ← IsLocalRing.mem_maximalIdeal,
        IsLocalization.AtPrime.to_map_mem_maximal_iff
          (Localization.AtPrime M_p'.asIdeal) M_p'.asIdeal c]
    change f_V ((AlgebraicGeometry.Spec.map σ_U_hom).base mU₀) = tilde_p₀
    rw [hmU_eq]
    exact hMp_eq

theorem weil_semistable_closed_point_at_most_two_composite_valuations (K : Type u) [Field K] [IsSepClosed K]
    (m : ℕ) (R : ValuationSubring K) (hPkg_R : IsValuationRingAlgPackage m R)
    (hMax_R : IsLocalRing.maximalIdeal ↥R ≠ ⊥)
    (F : Type u) [Field F]
    (Y : AlgebraicGeometry.Scheme.{u})
    (g_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
    (η_Y : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ Y)
    (hSS_Y : IsStrictlySemistableCurveOverValuation R g_Y)
    (hFunc_Y : IsSchemeFunctionField Y F η_Y) :
    let s_R := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.maximalIdeal ↥R).ResidueField))
    ∀ (x_star : ↥(CategoryTheory.Limits.pullback g_Y s_R)),
      IsClosed ({x_star} : Set ↥(CategoryTheory.Limits.pullback g_Y s_R)) →
      ∀ (E : Fin 3 → Set ↥(CategoryTheory.Limits.pullback g_Y s_R))
        (W U : Fin 3 → ValuationSubring F)
        (φ_Y : ∀ b : Fin 3, AlgebraicGeometry.Spec (CommRingCat.of ↥(U b)) ⟶ Y)
        (mU : ∀ b : Fin 3, AlgebraicGeometry.Spec (CommRingCat.of ↥(U b))),
        (∀ b : Fin 3,
          E b ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_Y s_R) ∧
          IsComponentStalkVal R g_Y η_Y (E b) (W b) ∧
          U b ≤ W b ∧
          U b ≠ W b ∧
          (mU b).asIdeal = IsLocalRing.maximalIdeal ↥(U b) ∧
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (U b).subtype) ≫ φ_Y b = η_Y ∧
          (φ_Y b).base (mU b) = (CategoryTheory.Limits.pullback.fst g_Y s_R).base x_star) →
        ∃ b₁ b₂ : Fin 3, b₁ ≠ b₂ ∧ U b₁ = U b₂ :=
by
  classical
  have _ := hMax_R
  
  have etale_quotient_of_surjective : ∀ {R₀ S₀ R_bar : Type u}
      [CommRing R₀] [CommRing S₀] [CommRing R_bar]
      (ψ : R₀ →+* S₀), ψ.Etale →
      ∀ (π_R : R₀ →+* R_bar), Function.Surjective π_R →
      ∀ (J : Ideal S₀), J = Ideal.map ψ (RingHom.ker π_R) →
      ∀ (ψ_bar : R_bar →+* (S₀ ⧸ J)),
        ψ_bar.comp π_R = (Ideal.Quotient.mk J).comp ψ →
        ψ_bar.Etale := by
    intro R₀ S₀ R_bar _ _ _ ψ hψ π_R hπ_surj J hJ ψ_bar hcomm
    letI : Algebra R₀ S₀ := ψ.toAlgebra
    letI : Algebra R₀ R_bar := π_R.toAlgebra
    letI : Algebra R_bar (S₀ ⧸ J) := ψ_bar.toAlgebra
    letI : Algebra R₀ (S₀ ⧸ J) := ((Ideal.Quotient.mk J).comp ψ).toAlgebra
    haveI : IsScalarTower R₀ R_bar (S₀ ⧸ J) := IsScalarTower.of_algebraMap_eq' hcomm.symm
    haveI : Algebra.Etale R₀ S₀ := RingHom.etale_algebraMap.mp hψ
    haveI : Algebra.Etale R_bar (TensorProduct R₀ R_bar S₀) := Algebra.Etale.baseChange R₀ S₀ R_bar
    let f₁ : R_bar →ₐ[R₀] (S₀ ⧸ J) :=
      { toRingHom := ψ_bar
        commutes' := fun r => RingHom.congr_fun hcomm r }
    let f₂ : S₀ →ₐ[R₀] (S₀ ⧸ J) :=
      { toRingHom := Ideal.Quotient.mk J
        commutes' := fun _ => rfl }
    let fwd : TensorProduct R₀ R_bar S₀ →ₐ[R₀] (S₀ ⧸ J) :=
      Algebra.TensorProduct.productMap f₁ f₂
    have hker : J ≤ RingHom.ker (Algebra.TensorProduct.includeRight (R := R₀) (A := R_bar) (B := S₀)).toRingHom := by
      rw [hJ, Ideal.map_le_iff_le_comap]
      intro r hr
      simp only [Ideal.mem_comap, RingHom.mem_ker] at hr ⊢
      change (1 : R_bar) ⊗ₜ[R₀] (algebraMap R₀ S₀ r) = 0
      have h1 : (algebraMap R₀ S₀ r) = r • (1 : S₀) := by rw [Algebra.smul_def, mul_one]
      have h2 : (r • (1 : R_bar)) = 0 := by rw [Algebra.smul_def, mul_one]; exact hr
      rw [h1, TensorProduct.tmul_smul, TensorProduct.smul_tmul', h2, TensorProduct.zero_tmul]
    let bwd_ring : (S₀ ⧸ J) →+* TensorProduct R₀ R_bar S₀ :=
      Ideal.Quotient.lift J (Algebra.TensorProduct.includeRight (R := R₀) (A := R_bar) (B := S₀)).toRingHom hker
    let bwd : (S₀ ⧸ J) →ₐ[R₀] TensorProduct R₀ R_bar S₀ :=
      { toRingHom := bwd_ring
        commutes' := fun r => by
          change (1 : R_bar) ⊗ₜ[R₀] (algebraMap R₀ S₀ r) = (algebraMap R₀ R_bar r) ⊗ₜ[R₀] (1 : S₀)
          have h1 : (algebraMap R₀ S₀ r) = r • (1 : S₀) := by rw [Algebra.smul_def, mul_one]
          have h2 : (algebraMap R₀ R_bar r) = r • (1 : R_bar) := by rw [Algebra.smul_def, mul_one]
          rw [h1, h2, TensorProduct.tmul_smul, TensorProduct.smul_tmul'] }
    have h_left : bwd.comp fwd = AlgHom.id R₀ _ := by
      apply Algebra.TensorProduct.ext
      · ext r_bar
        obtain ⟨r₀, rfl⟩ := hπ_surj r_bar
        have h_eq : (algebraMap R₀ R_bar r₀ : R_bar) ⊗ₜ[R₀] (1 : S₀) =
            algebraMap R₀ (TensorProduct R₀ R_bar S₀) r₀ := rfl
        change bwd (fwd (algebraMap R₀ R_bar r₀ ⊗ₜ[R₀] 1)) = algebraMap R₀ R_bar r₀ ⊗ₜ[R₀] 1
        rw [h_eq, AlgHom.commutes, AlgHom.commutes]
      · ext s
        simp [fwd, bwd, bwd_ring, f₁, f₂]
    have h_right : fwd.comp bwd = AlgHom.id R₀ _ := by
      apply AlgHom.coe_ringHom_injective
      apply Ideal.Quotient.ringHom_ext
      ext s
      change fwd.toRingHom (bwd_ring (Ideal.Quotient.mk J s)) = Ideal.Quotient.mk J s
      change fwd (1 ⊗ₜ[R₀] s) = Ideal.Quotient.mk J s
      simp [fwd, f₁, f₂]
    let e_ring : TensorProduct R₀ R_bar S₀ ≃+* (S₀ ⧸ J) :=
      { fwd.toRingHom with
        invFun := bwd.toRingHom
        left_inv := fun x => AlgHom.congr_fun h_left x
        right_inv := fun x => AlgHom.congr_fun h_right x }
    have h_et_base : (algebraMap R_bar (TensorProduct R₀ R_bar S₀)).Etale :=
      RingHom.etale_algebraMap.mpr inferInstance
    have h_comp_eq : e_ring.toRingHom.comp (algebraMap R_bar (TensorProduct R₀ R_bar S₀)) = ψ_bar := by
      ext r_bar
      change fwd (r_bar ⊗ₜ[R₀] 1) = ψ_bar r_bar
      simp [fwd, f₁, f₂]
    rw [← h_comp_eq]
    exact RingHom.Etale.respectsIso.left (algebraMap R_bar (TensorProduct R₀ R_bar S₀)) e_ring h_et_base
  
  have etale_away_map : ∀ {A₀ B₀ : Type u} [CommRing A₀] [CommRing B₀]
      (ψ : A₀ →+* B₀), ψ.Etale → ∀ (r : A₀), (Localization.awayMap ψ r).Etale := by
    intro A₀ B₀ _ _ ψ hψ r
    let ψ_r : Localization.Away r →+* Localization.Away (ψ r) := Localization.awayMap ψ r
    let A_r := Localization.Away r
    letI : Algebra A₀ B₀ := ψ.toAlgebra
    let B_r := Localization.Away (ψ r)
    letI : Algebra A_r B_r := ψ_r.toAlgebra
    have hcomm_r : ψ_r.comp (algebraMap A₀ A_r) = (algebraMap B₀ B_r).comp ψ :=
      RingHom.ext (IsLocalization.Away.lift_eq r (IsLocalization.Away.algebraMap_isUnit (ψ r)))
    haveI : IsScalarTower A₀ A_r B_r := IsScalarTower.of_algebraMap_eq (fun a => by
      calc algebraMap A₀ B_r a = algebraMap B₀ B_r (algebraMap A₀ B₀ a) :=
            IsScalarTower.algebraMap_apply A₀ B₀ B_r a
        _ = ψ_r (algebraMap A₀ A_r a) := (RingHom.congr_fun hcomm_r a).symm)
    haveI : Algebra.Etale A₀ B₀ := RingHom.etale_algebraMap.mp hψ
    haveI : Algebra.Etale A_r (TensorProduct A₀ A_r B₀) := Algebra.Etale.baseChange A₀ B₀ A_r
    let f₁ : A_r →ₐ[A₀] B_r :=
      { toRingHom := ψ_r
        commutes' := fun a => RingHom.congr_fun hcomm_r a }
    let f₂ : B₀ →ₐ[A₀] B_r :=
      { toRingHom := algebraMap B₀ B_r
        commutes' := fun _ => rfl }
    let fwd : TensorProduct A₀ A_r B₀ →ₐ[A₀] B_r :=
      Algebra.TensorProduct.productMap f₁ f₂
    have hunit_tp : IsUnit ((Algebra.TensorProduct.includeRight (R := A₀) (A := A_r) (B := B₀)).toRingHom (ψ r)) := by
      have heq : (Algebra.TensorProduct.includeRight (R := A₀) (A := A_r) (B := B₀)).toRingHom (ψ r) =
          algebraMap A_r (TensorProduct A₀ A_r B₀) (algebraMap A₀ A_r r) := by
        change (1 : A_r) ⊗ₜ[A₀] (algebraMap A₀ B₀ r) = (algebraMap A₀ A_r r) ⊗ₜ[A₀] (1 : B₀)
        have h1 : (algebraMap A₀ B₀ r) = r • (1 : B₀) := by rw [Algebra.smul_def, mul_one]
        have h2 : (algebraMap A₀ A_r r) = r • (1 : A_r) := by rw [Algebra.smul_def, mul_one]
        rw [h1, h2, TensorProduct.tmul_smul, TensorProduct.smul_tmul']
      rw [heq]
      exact (IsLocalization.Away.algebraMap_isUnit (S := A_r) r).map _
    let bwd_ring : B_r →+* TensorProduct A₀ A_r B₀ :=
      IsLocalization.Away.lift (ψ r) hunit_tp
    have hbwd_eq : bwd_ring.comp (algebraMap B₀ B_r) =
        (Algebra.TensorProduct.includeRight (R := A₀) (A := A_r) (B := B₀)).toRingHom :=
      RingHom.ext (IsLocalization.Away.lift_eq (ψ r) hunit_tp)
    let bwd : B_r →ₐ[A₀] TensorProduct A₀ A_r B₀ :=
      { toRingHom := bwd_ring
        commutes' := fun a => by
          change (bwd_ring.comp (algebraMap B₀ B_r)) (ψ a) = (algebraMap A₀ A_r a) ⊗ₜ[A₀] (1 : B₀)
          rw [hbwd_eq]
          change (1 : A_r) ⊗ₜ[A₀] (algebraMap A₀ B₀ a) = (algebraMap A₀ A_r a) ⊗ₜ[A₀] (1 : B₀)
          have h1 : (algebraMap A₀ B₀ a) = a • (1 : B₀) := by rw [Algebra.smul_def, mul_one]
          have h2 : (algebraMap A₀ A_r a) = a • (1 : A_r) := by rw [Algebra.smul_def, mul_one]
          rw [h1, h2, TensorProduct.tmul_smul, TensorProduct.smul_tmul'] }
    have h_left : bwd.comp fwd = AlgHom.id A₀ _ := by
      apply Algebra.TensorProduct.ext
      · apply AlgHom.coe_ringHom_injective
        apply IsLocalization.ringHom_ext (Submonoid.powers r)
        ext a
        change bwd (fwd (algebraMap A₀ A_r a ⊗ₜ[A₀] 1)) = algebraMap A₀ A_r a ⊗ₜ[A₀] 1
        have h_eq : (algebraMap A₀ A_r a : A_r) ⊗ₜ[A₀] (1 : B₀) =
            algebraMap A₀ (TensorProduct A₀ A_r B₀) a := rfl
        rw [h_eq, AlgHom.commutes, AlgHom.commutes]
      · ext b
        change bwd_ring (ψ_r 1 * algebraMap B₀ B_r b) = 1 ⊗ₜ[A₀] b
        rw [map_one, one_mul]
        exact RingHom.congr_fun hbwd_eq b
    have h_right : fwd.comp bwd = AlgHom.id A₀ _ := by
      apply AlgHom.coe_ringHom_injective
      have hcomp_B0 : (fwd.toRingHom.comp bwd_ring).comp (algebraMap B₀ B_r) =
          (RingHom.id B_r).comp (algebraMap B₀ B_r) := by
        rw [RingHom.comp_assoc, hbwd_eq]
        ext b
        change fwd (1 ⊗ₜ[A₀] b) = algebraMap B₀ B_r b
        simp [fwd, f₁, f₂]
      exact IsLocalization.ringHom_ext (Submonoid.powers (ψ r)) hcomp_B0
    let e_ring : TensorProduct A₀ A_r B₀ ≃+* B_r :=
      { fwd.toRingHom with
        invFun := bwd.toRingHom
        left_inv := fun x => AlgHom.congr_fun h_left x
        right_inv := fun x => AlgHom.congr_fun h_right x }
    have h_et_base : (algebraMap A_r (TensorProduct A₀ A_r B₀)).Etale :=
      RingHom.etale_algebraMap.mpr inferInstance
