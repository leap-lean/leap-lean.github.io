            exact ⟨0, A_sub.zero_mem, 1, A_sub.one_mem, one_ne_zero, zero_mul 1⟩
          · have ha0 : a ≠ 0 := by rw [← hu]; exact mul_ne_zero hu0 hb0
            exact ⟨b, hb, a, ha, ha0, by rw [← hu, inv_mul_cancel_left₀ hu0]⟩
