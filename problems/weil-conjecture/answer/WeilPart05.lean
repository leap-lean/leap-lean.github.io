      have hφgr_ne : φ_U.hom (g ^ r) ≠ 0 :=
        fun h => hgr_ne (hInj_φU (h.trans (map_zero φ_U.hom).symm))
      have hφc₂_ne : φ_U.hom c₂ ≠ 0 := by
        rw [← hc₂_F]
        exact mul_ne_zero hφt₂_ne hφgr_ne
      have hc₂_ne : c₂ ≠ 0 := fun h0 => hφc₂_ne (h0 ▸ map_zero φ_U.hom)
      have hden_ne : c₂ * g ^ k ≠ 0 := mul_ne_zero hc₂_ne (pow_ne_zero k hg_ne)
      refine ⟨⟨c₁ * g ^ r, ⟨c₂ * g ^ k, mem_nonZeroDivisors_of_ne_zero hden_ne⟩⟩, ?_⟩
      dsimp only
      rw [hAlg_AU_F, map_mul, map_mul, ← hc₂_F]
      calc x * ((φ₂.hom t₂.1 * φ_U.hom (g ^ r)) * φ_U.hom (g ^ k))
          = ((x * φ₂.hom t₂.1) * φ_U.hom (g ^ k)) * φ_U.hom (g ^ r) := by ring
        _ = (φ₂.hom a₂ * φ_U.hom (g ^ k)) * φ_U.hom (g ^ r) := by rw [hxt₂']
        _ = φ_U.hom c₁ * φ_U.hom (g ^ r) := by rw [hc₁_F]
    · rw [hAlg_AU_F] at ha
      exact ⟨1, by rw [OneMemClass.coe_one, one_mul, one_mul, hInj_φU ha]⟩
  
  have hSub_compl : ∀ w : ↥Y₂, f₂.base w ∈ U_compl → (π₂.base ⁻¹' {w}).Subsingleton := by
    have _ : CategoryTheory.IsIso (f₁ ∣_ U_compl) := hIso₁
    let V₂ : Y₂.Opens := (TopologicalSpace.Opens.map f₂.base).obj U_compl
    let W₁₂ : P₁₂.Opens := (TopologicalSpace.Opens.map snd₁₂.base).obj V₂
    let U₁ : Y₁.Opens := (TopologicalSpace.Opens.map f₁.base).obj U_compl
    have hPb_top : CategoryTheory.IsPullback (snd₁₂ ∣_ V₂) W₁₂.ι V₂.ι snd₁₂ :=
      AlgebraicGeometry.isPullback_morphismRestrict snd₁₂ V₂
    have hPb_bot : CategoryTheory.IsPullback snd₁₂ fst₁₂ f₂ f₁ :=
      (CategoryTheory.IsPullback.of_hasPullback f₁ f₂).flip
    have h_paste : CategoryTheory.IsPullback (snd₁₂ ∣_ V₂) (W₁₂.ι ≫ fst₁₂) (V₂.ι ≫ f₂) f₁ :=
      hPb_top.paste_vert hPb_bot
    have hPb_f₁ : CategoryTheory.IsPullback U₁.ι (f₁ ∣_ U_compl) f₁ U_compl.ι :=
      (AlgebraicGeometry.isPullback_morphismRestrict f₁ U_compl).flip
    have hcomm_u : (W₁₂.ι ≫ fst₁₂) ≫ f₁ =
        ((snd₁₂ ∣_ V₂) ≫ (f₂ ∣_ U_compl)) ≫ U_compl.ι := by
      rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
        ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.morphismRestrict_ι snd₁₂ V₂,
        CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        AlgebraicGeometry.morphismRestrict_ι f₂ U_compl]
    let u : W₁₂.toScheme ⟶ U₁.toScheme :=
      hPb_f₁.lift (W₁₂.ι ≫ fst₁₂) ((snd₁₂ ∣_ V₂) ≫ (f₂ ∣_ U_compl)) hcomm_u
    have hu_fst : u ≫ U₁.ι = W₁₂.ι ≫ fst₁₂ :=
      hPb_f₁.lift_fst _ _ hcomm_u
    have hu_snd : u ≫ (f₁ ∣_ U_compl) = (snd₁₂ ∣_ V₂) ≫ (f₂ ∣_ U_compl) :=
      hPb_f₁.lift_snd _ _ hcomm_u
    have h_paste_flip : CategoryTheory.IsPullback (u ≫ U₁.ι) (snd₁₂ ∣_ V₂)
        f₁ ((f₂ ∣_ U_compl) ≫ U_compl.ι) := by
      rw [hu_fst, AlgebraicGeometry.morphismRestrict_ι f₂ U_compl]
      exact h_paste.flip
    have hPb_res : CategoryTheory.IsPullback u (snd₁₂ ∣_ V₂) (f₁ ∣_ U_compl) (f₂ ∣_ U_compl) :=
      CategoryTheory.IsPullback.of_right h_paste_flip hu_snd hPb_f₁
    have _ : CategoryTheory.IsIso (snd₁₂ ∣_ V₂) := hPb_res.isIso_snd_of_isIso
    intro w hw z₁ hz₁ z₂ hz₂
    have hw₁ : π₂.base z₁ = w := hz₁
    have hw₂ : π₂.base z₂ = w := hz₂
    let p₁ : ↥P₁₂ := ι_Γ.base z₁
    let p₂ : ↥P₁₂ := ι_Γ.base z₂
    have hp₁ : p₁ ∈ W₁₂ := by
      show f₂.base (snd₁₂.base p₁) ∈ U_compl
      change f₂.base (π₂.base z₁) ∈ U_compl
      rwa [hw₁]
    have hp₂ : p₂ ∈ W₁₂ := by
      show f₂.base (snd₁₂.base p₂) ∈ U_compl
      change f₂.base (π₂.base z₂) ∈ U_compl
      rwa [hw₂]
    let q₁ : ↥W₁₂.toScheme := ⟨p₁, hp₁⟩
    let q₂ : ↥W₁₂.toScheme := ⟨p₂, hp₂⟩
    have hq_val : V₂.ι.base ((snd₁₂ ∣_ V₂).base q₁) = V₂.ι.base ((snd₁₂ ∣_ V₂).base q₂) := by
      have h1 : V₂.ι.base ((snd₁₂ ∣_ V₂).base q₁) = w := by
        change ((snd₁₂ ∣_ V₂) ≫ V₂.ι).base q₁ = w
        rw [AlgebraicGeometry.morphismRestrict_ι snd₁₂ V₂]
        exact hw₁
      have h2 : V₂.ι.base ((snd₁₂ ∣_ V₂).base q₂) = w := by
        change ((snd₁₂ ∣_ V₂) ≫ V₂.ι).base q₂ = w
        rw [AlgebraicGeometry.morphismRestrict_ι snd₁₂ V₂]
        exact hw₂
      exact h1.trans h2.symm
    have hq_res := V₂.ι.isOpenEmbedding.injective hq_val
    have hq_eq : q₁ = q₂ :=
      (CategoryTheory.ConcreteCategory.bijective_of_isIso (snd₁₂ ∣_ V₂).base).1 hq_res
    have hp_eq : p₁ = p₂ := congrArg (Subtype.val : ↥W₁₂.toScheme → ↥P₁₂) hq_eq
    exact ι_Γ.isClosedEmbedding.injective hp_eq
  
  have hSub_val : ∀ w : ↥Y₂,
      (∃ (U_w : Y₂.Opens) (hUw : AlgebraicGeometry.IsAffineOpen U_w) (hw : w ∈ U_w)
          (φ_w : Y₂.presheaf.obj (Opposite.op U_w) ⟶ CommRingCat.of F)
          (W_w : ValuationSubring F),
        AlgebraicGeometry.Spec.map φ_w ≫ hUw.fromSpec = η₂ ∧
        (∀ x : F, x ∈ W_w ↔
          ∃ b s : ↑(Y₂.presheaf.obj (Opposite.op U_w)),
            s ∉ (hUw.isoSpec.hom.base ⟨w, hw⟩).asIdeal ∧
            φ_w.hom s * x = φ_w.hom b) ∧
        (∀ b : ↑(Y₂.presheaf.obj (Opposite.op U_w)),
          ∃ hb : φ_w.hom b ∈ W_w,
            (⟨φ_w.hom b, hb⟩ : ↥W_w) ∈ IsLocalRing.maximalIdeal ↥W_w ↔
              b ∈ (hUw.isoSpec.hom.base ⟨w, hw⟩).asIdeal)) →
      (π₂.base ⁻¹' {w}).Subsingleton := by
    rintro w ⟨U_w, hUw, hw, φ_w, W_w, hη_w, hW_mem, hW_max⟩
    let B : Type u := ↑(Y₂.presheaf.obj (Opposite.op U_w))
    let p_w_pt : PrimeSpectrum B := hUw.isoSpec.hom.base ⟨w, hw⟩
    let p_w : Ideal B := p_w_pt.asIdeal
    have hUw_from_pt : hUw.fromSpec.base p_w_pt = w := by
      change (hUw.isoSpec.hom ≫ hUw.fromSpec).base ⟨w, hw⟩ = w
      rw [hUw.isoSpec_hom, hUw.toSpecΓ_fromSpec]
      rfl
    let ρ_w : B →+* ↥W_w := φ_w.hom.codRestrict W_w.toSubring (fun b => (hW_max b).1)
    let ψ_w : AlgebraicGeometry.Spec (CommRingCat.of ↥W_w) ⟶ Y₂ :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_w) ≫ hUw.fromSpec
    let ι_Ww : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of ↥W_w) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom W_w.subtype)
    let m_Ww : ↥(AlgebraicGeometry.Spec (CommRingCat.of ↥W_w)) :=
      ⟨IsLocalRing.maximalIdeal ↥W_w, (IsLocalRing.maximalIdeal.isMaximal ↥W_w).isPrime⟩
    have _ : AlgebraicGeometry.IsReduced (AlgebraicGeometry.Spec (CommRingCat.of ↥W_w)) :=
      (AlgebraicGeometry.affine_isReduced_iff (CommRingCat.of ↥W_w)).mpr inferInstance
    have hDom_ιW : AlgebraicGeometry.IsDominant ι_Ww := by
      rw [AlgebraicGeometry.isDominant_iff, DenseRange]
      intro q
      let p₀ : PrimeSpectrum ↥W_w := ι_Ww.base (⊥ : PrimeSpectrum F)
      have hle : p₀ ≤ q := by
        change Ideal.comap W_w.subtype (⊥ : PrimeSpectrum F).asIdeal ≤ q.asIdeal
        have hbot : (⊥ : PrimeSpectrum F).asIdeal = ⊥ := rfl
        rw [hbot, Ideal.comap_bot_of_injective W_w.subtype Subtype.val_injective]
        exact bot_le
      have hcl : q ∈ closure ({p₀} : Set (PrimeSpectrum ↥W_w)) :=
        (PrimeSpectrum.le_iff_mem_closure p₀ q).mp hle
      have hmem_p₀ : p₀ ∈ Set.range ι_Ww.base := ⟨(⊥ : PrimeSpectrum F), rfl⟩
      exact closure_mono (Set.singleton_subset_iff.mpr hmem_p₀) hcl
    have _ : AlgebraicGeometry.IsDominant ι_Ww := hDom_ιW
    have hLift_z : ∀ z : ↥Γ, π₂.base z = w →
        ∃ ψ_z : AlgebraicGeometry.Spec (CommRingCat.of ↥W_w) ⟶ Γ,
          ι_Ww ≫ ψ_z = η_Γ ∧ ψ_z ≫ π₂ = ψ_w ∧ ψ_z.base m_Ww = z := by
      intro z hz_w
      have hz_pre : z ∈ (TopologicalSpace.Opens.map π₂.base).obj U_w := by
        show π₂.base z ∈ U_w
        rwa [hz_w]
      obtain ⟨V, hV, hzV, e_V_sub⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
          (X := Γ) (x := z) (U := (TopologicalSpace.Opens.map π₂.base).obj U_w) hz_pre
      have e_V : V ≤ (TopologicalSpace.Opens.map π₂.base).obj U_w := e_V_sub
      let C : Type u := ↑(Γ.presheaf.obj (Opposite.op V))
      have hV_ne : Nonempty ↥V := ⟨⟨z, hzV⟩⟩
      have _ : IsDomain C := @AlgebraicGeometry.IsIntegral.component_integral Γ hIntΓ V hV_ne
      let P_z_pt : PrimeSpectrum C := hV.isoSpec.hom.base ⟨z, hzV⟩
      let P_z : Ideal C := P_z_pt.asIdeal
      have _ : P_z.IsPrime := P_z_pt.isPrime
      have hV_from_pt : hV.fromSpec.base P_z_pt = z := by
        change (hV.isoSpec.hom ≫ hV.fromSpec).base ⟨z, hzV⟩ = z
        rw [hV.isoSpec_hom, hV.toSpecΓ_fromSpec]
        rfl
      obtain ⟨φ_V, hFrac_V, hSpec_V⟩ := hFunc_Γ V hV hV_ne
      have hInj_φV : Function.Injective φ_V.hom :=
        @IsFractionRing.injective C _ F _ φ_V.hom.toAlgebra hFrac_V
      let β : B →+* C := (π₂.appLE U_w V e_V).hom
      have hφV_β : ∀ b : B, φ_V.hom (β b) = φ_w.hom b := by
        have hmap : AlgebraicGeometry.Spec.map (π₂.appLE U_w V e_V ≫ φ_V) ≫ hUw.fromSpec =
            AlgebraicGeometry.Spec.map φ_w ≫ hUw.fromSpec := by
          rw [AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc,
            hUw.SpecMap_appLE_fromSpec π₂ hV e_V, ← CategoryTheory.Category.assoc,
            hSpec_V, hη_π₂, hη_w]
        have heq_spec := (CategoryTheory.cancel_mono hUw.fromSpec).mp hmap
        have heq_hom : π₂.appLE U_w V e_V ≫ φ_V = φ_w := by
          calc π₂.appLE U_w V e_V ≫ φ_V
              = AlgebraicGeometry.Spec.preimage
                  (AlgebraicGeometry.Spec.map (π₂.appLE U_w V e_V ≫ φ_V)) :=
                (AlgebraicGeometry.Spec.preimage_map _).symm
            _ = AlgebraicGeometry.Spec.preimage (AlgebraicGeometry.Spec.map φ_w) := by rw [heq_spec]
            _ = φ_w := AlgebraicGeometry.Spec.preimage_map _
        intro b
        exact congrArg (fun f : Y₂.presheaf.obj (Opposite.op U_w) ⟶ CommRingCat.of F => f.hom b) heq_hom
      have h_comap_β : Ideal.comap β P_z = p_w := by
        have hpt_img : hUw.fromSpec.base
            ((AlgebraicGeometry.Spec.map (π₂.appLE U_w V e_V)).base P_z_pt) =
            hUw.fromSpec.base p_w_pt := by
          change (AlgebraicGeometry.Spec.map (π₂.appLE U_w V e_V) ≫ hUw.fromSpec).base P_z_pt =
            hUw.fromSpec.base p_w_pt
          rw [hUw.SpecMap_appLE_fromSpec π₂ hV e_V]
          change π₂.base (hV.fromSpec.base P_z_pt) = hUw.fromSpec.base p_w_pt
          rw [hV_from_pt, hz_w, hUw_from_pt]
        have hpt_eq := hUw.fromSpec.isOpenEmbedding.injective hpt_img
        exact congrArg PrimeSpectrum.asIdeal hpt_eq
      have hc_W : ∀ c : C, φ_V.hom c ∈ W_w := by
        intro c
        by_contra hc_not
        have hc0 : φ_V.hom c ≠ 0 := fun h0 => hc_not (h0 ▸ W_w.zero_mem)
        have hinv_W : (φ_V.hom c)⁻¹ ∈ W_w := by
          rcases ValuationSubring.mem_or_inv_mem W_w (φ_V.hom c) with hc_in | hinv
          · exact False.elim (hc_not hc_in)
          · exact hinv
        let x_inv : ↥W_w := ⟨(φ_V.hom c)⁻¹, hinv_W⟩
        have hx_max : x_inv ∈ IsLocalRing.maximalIdeal ↥W_w := by
          rw [IsLocalRing.mem_maximalIdeal]
          intro hu
          rcases hu.exists_right_inv with ⟨u, hu_eq⟩
          have hval : (φ_V.hom c)⁻¹ * u.1 = 1 := congrArg Subtype.val hu_eq
          have hu_c : u.1 = φ_V.hom c := by
            calc u.1 = φ_V.hom c * ((φ_V.hom c)⁻¹ * u.1) := by
                  rw [← mul_assoc, mul_inv_cancel₀ hc0, one_mul]
              _ = φ_V.hom c := by rw [hval, mul_one]
          exact hc_not (hu_c ▸ u.2)
        obtain ⟨b, s, hs_not_pw, hbs⟩ := (hW_mem (φ_V.hom c)⁻¹).mp hinv_W
        obtain ⟨hs_W, _⟩ := hW_max s
        obtain ⟨hb_W, hb_iff⟩ := hW_max b
        have hb_eq : (⟨φ_w.hom b, hb_W⟩ : ↥W_w) = ⟨φ_w.hom s, hs_W⟩ * x_inv :=
          Subtype.ext hbs.symm
        have hb_pw : b ∈ p_w := hb_iff.mp (hb_eq ▸ Ideal.mul_mem_left _ _ hx_max)
        have hbs_F : φ_w.hom s = φ_w.hom b * φ_V.hom c := by
          calc φ_w.hom s = (φ_w.hom s * (φ_V.hom c)⁻¹) * φ_V.hom c :=
                (inv_mul_cancel_right₀ hc0 (φ_w.hom s)).symm
            _ = φ_w.hom b * φ_V.hom c := by rw [hbs]
        have hβ_eq : β s = β b * c := by
          apply hInj_φV
          rw [map_mul, hφV_β, hφV_β, hbs_F]
        have hβb_Pz : β b ∈ P_z := by
          have : b ∈ Ideal.comap β P_z := h_comap_β.symm ▸ hb_pw
          exact this
        have hs_pw : s ∈ p_w := by
          rw [← h_comap_β, Ideal.mem_comap, hβ_eq]
          exact Ideal.mul_mem_right c P_z hβb_Pz
        exact hs_not_pw hs_pw
      let ρ_V : C →+* ↥W_w := φ_V.hom.codRestrict W_w.toSubring hc_W
      have h_comap_ρV : Ideal.comap ρ_V (IsLocalRing.maximalIdeal ↥W_w) = P_z := by
        ext c
        rw [Ideal.mem_comap]
        constructor
        · intro hρc
          obtain ⟨b, s, hs_not_pw, hbs⟩ := (hW_mem (φ_V.hom c)).mp (hc_W c)
          obtain ⟨hs_W, _⟩ := hW_max s
          obtain ⟨hb_W, hb_iff⟩ := hW_max b
          have hb_eq : (⟨φ_w.hom b, hb_W⟩ : ↥W_w) = ⟨φ_w.hom s, hs_W⟩ * ρ_V c :=
            Subtype.ext hbs.symm
          have hb_pw : b ∈ p_w := hb_iff.mp (hb_eq ▸ Ideal.mul_mem_left _ _ hρc)
          have hβb_Pz : β b ∈ P_z := by
            have : b ∈ Ideal.comap β P_z := h_comap_β.symm ▸ hb_pw
            exact this
          have hmul_eq : β s * c = β b := by
            apply hInj_φV
            rw [map_mul, hφV_β, hφV_β, hbs]
          have hmul_Pz : β s * c ∈ P_z := hmul_eq.symm ▸ hβb_Pz
          rcases P_z_pt.isPrime.mem_or_mem hmul_Pz with hβs_Pz | hc_Pz
          · exfalso
            have hs_pw : s ∈ p_w := by
              rw [← h_comap_β]
              exact hβs_Pz
            exact hs_not_pw hs_pw
          · exact hc_Pz
        · intro hc_Pz
          by_contra hnot_max
          have hu : IsUnit (ρ_V c) := IsLocalRing.notMem_maximalIdeal.mp hnot_max
          rcases hu.exists_right_inv with ⟨u, hu_eq⟩
          have hval : φ_V.hom c * u.1 = 1 := congrArg Subtype.val hu_eq
          obtain ⟨b, s, hs_not_pw, hbs⟩ := (hW_mem u.1).mp u.2
          have hbs_F : φ_w.hom s = φ_w.hom b * φ_V.hom c := by
            calc φ_w.hom s = φ_w.hom s * (φ_V.hom c * u.1) := by rw [hval, mul_one]
              _ = (φ_w.hom s * u.1) * φ_V.hom c := by ring
              _ = φ_w.hom b * φ_V.hom c := by rw [hbs]
          have hβ_eq : β s = β b * c := by
            apply hInj_φV
            rw [map_mul, hφV_β, hφV_β, hbs_F]
          have hs_pw : s ∈ p_w := by
            rw [← h_comap_β, Ideal.mem_comap, hβ_eq]
            exact Ideal.mul_mem_left P_z (β b) hc_Pz
          exact hs_not_pw hs_pw
      let ψ_z : AlgebraicGeometry.Spec (CommRingCat.of ↥W_w) ⟶ Γ :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_V) ≫ hV.fromSpec
      refine ⟨ψ_z, ?_, ?_, ?_⟩
      · dsimp only [ι_Ww, ψ_z]
        rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
        have hcomp : CommRingCat.ofHom ρ_V ≫ CommRingCat.ofHom W_w.subtype = φ_V :=
          CommRingCat.hom_ext (RingHom.ext fun _ => rfl)
        rw [hcomp, hSpec_V]
      · dsimp only [ψ_z, ψ_w]
        rw [CategoryTheory.Category.assoc, ← hUw.SpecMap_appLE_fromSpec π₂ hV e_V,
          ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
        have hcomp : π₂.appLE U_w V e_V ≫ CommRingCat.ofHom ρ_V = CommRingCat.ofHom ρ_w := by
          apply CommRingCat.hom_ext
          ext b
          exact hφV_β b
        exact congrArg (fun f => AlgebraicGeometry.Spec.map f ≫ hUw.fromSpec) hcomp
      · have hspec_pt :
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_V)).base m_Ww = P_z_pt :=
          PrimeSpectrum.ext h_comap_ρV
        exact (congrArg hV.fromSpec.base hspec_pt).trans hV_from_pt
    intro z₁ hz₁ z₂ hz₂
    obtain ⟨ψ₁, hη₁_ψ, hπ₂_ψ₁, hpt₁⟩ := hLift_z z₁ hz₁
    obtain ⟨ψ₂, hη₂_ψ, hπ₂_ψ₂, hpt₂⟩ := hLift_z z₂ hz₂
    have _ : AlgebraicGeometry.IsSeparated π₂ := hProp_π₂.toIsSeparated
    have hψ_eq : ψ₁ = ψ₂ :=
      AlgebraicGeometry.ext_of_isDominant_of_isSeparated π₂
        (hπ₂_ψ₁.trans hπ₂_ψ₂.symm) ι_Ww (hη₁_ψ.trans hη₂_ψ.symm)
    rw [← hpt₁, ← hpt₂, hψ_eq]
  
  have hInj_res : ∀ w : ↥Y₂, Function.Surjective (f₂.residueFieldMap w).hom →
      Set.InjOn π₁.base (π₂.base ⁻¹' {w}) := by
    intro w hSurj z₁ hz₁ z₂ hz₂ hπ₁_eq
    have hw₁ : π₂.base z₁ = w := hz₁
    have hw₂ : π₂.base z₂ = w := hz₂
    let p₁ : ↥P₁₂ := ι_Γ.base z₁
    let p₂ : ↥P₁₂ := ι_Γ.base z₂
    let e_car := AlgebraicGeometry.Scheme.Pullback.carrierEquiv (f := f₁) (g := f₂)
    rcases h1 : e_car p₁ with ⟨T₁, q₁⟩
    rcases h2 : e_car p₂ with ⟨T₂, q₂⟩
    have hp₁_symm : p₁ = e_car.symm ⟨T₁, q₁⟩ := by
      rw [← h1, e_car.symm_apply_apply]
    have hp₂_symm : p₂ = e_car.symm ⟨T₂, q₂⟩ := by
      rw [← h2, e_car.symm_apply_apply]
    have hT₁x : T₁.x = π₁.base z₁ := by
      have hfst := AlgebraicGeometry.Scheme.Pullback.carrierEquiv_symm_fst T₁ q₁
      change fst₁₂.base (e_car.symm ⟨T₁, q₁⟩) = T₁.x at hfst
      exact hfst.symm.trans (congrArg fst₁₂.base hp₁_symm.symm)
    have hT₂x : T₂.x = π₁.base z₂ := by
      have hfst := AlgebraicGeometry.Scheme.Pullback.carrierEquiv_symm_fst T₂ q₂
      change fst₁₂.base (e_car.symm ⟨T₂, q₂⟩) = T₂.x at hfst
      exact hfst.symm.trans (congrArg fst₁₂.base hp₂_symm.symm)
    have hT₁y : T₁.y = w := by
      have hsnd := AlgebraicGeometry.Scheme.Pullback.carrierEquiv_symm_snd T₁ q₁
      change snd₁₂.base (e_car.symm ⟨T₁, q₁⟩) = T₁.y at hsnd
      exact hsnd.symm.trans ((congrArg snd₁₂.base hp₁_symm.symm).trans hw₁)
    have hT₂y : T₂.y = w := by
      have hsnd := AlgebraicGeometry.Scheme.Pullback.carrierEquiv_symm_snd T₂ q₂
      change snd₁₂.base (e_car.symm ⟨T₂, q₂⟩) = T₂.y at hsnd
      exact hsnd.symm.trans ((congrArg snd₁₂.base hp₂_symm.symm).trans hw₂)
    have hT : T₁ = T₂ :=
      AlgebraicGeometry.Scheme.Pullback.Triplet.ext
        (hT₁x.trans (hπ₁_eq.trans hT₂x.symm))
        (hT₁y.trans hT₂y.symm)
    subst hT
    have hSurj_T1 : Function.Surjective (f₂.residueFieldMap T₁.y).hom :=
      Eq.mp (congrArg (fun y => Function.Surjective (f₂.residueFieldMap y).hom) hT₁y.symm) hSurj
    let e_res := RingEquiv.ofBijective (f₂.residueFieldMap T₁.y).hom
      ⟨RingHom.injective (f₂.residueFieldMap T₁.y).hom, hSurj_T1⟩
    have _ : CategoryTheory.IsIso (f₂.residueFieldMap T₁.y) :=
      ⟨⟨CommRingCat.ofHom e_res.symm.toRingHom,
        CommRingCat.hom_ext (RingHom.ext e_res.symm_apply_apply),
        CommRingCat.hom_ext (RingHom.ext e_res.apply_symm_apply)⟩⟩
    have _ : CategoryTheory.IsIso (AlgebraicGeometry.Spec.map T₁.tensorInl) :=
      T₁.isPullback_SpecMap_tensor.isIso_fst_of_isIso
    have hSubTensor : Subsingleton ↥(AlgebraicGeometry.Spec T₁.tensor) :=
      (CategoryTheory.ConcreteCategory.bijective_of_isIso
        (AlgebraicGeometry.Spec.map T₁.tensorInl).base).1.subsingleton
    have hq_eq : q₁ = q₂ := @Subsingleton.elim _ hSubTensor q₁ q₂
    have he_eq : e_car p₁ = e_car p₂ := by
      rw [h1, h2, hq_eq]
    have hp_eq : p₁ = p₂ := e_car.injective he_eq
    exact ι_Γ.isClosedEmbedding.injective hp_eq
  exact ⟨Γ, π₁, π₂, η_Γ,
    ⟨hIntΓ, hProp_π₁, hProp_π₂, hDom_ηΓ, hFunc_Γ, hπ_f, hη_π₁, hη_π₂⟩,
    hSub_compl, hSub_val, hInj_res⟩

theorem weil_strictlySemistable_minimalFiberPrime_stalk_valuation (K : Type u) [Field K]
    (R : ValuationSubring K)
    (Y : AlgebraicGeometry.Scheme.{u})
    (g_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
    (F : Type u) [Field F]
    (η_Y : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ Y)
    (hSS_Y : IsStrictlySemistableCurveOverValuation R g_Y)
    (hNorm_Y : IsAffineNormalScheme Y)
    (hFunc_Y : IsSchemeFunctionField Y F η_Y)
    (w : ↥Y)
