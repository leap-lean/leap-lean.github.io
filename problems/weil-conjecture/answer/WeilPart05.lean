        · obtain ⟨k, hk⟩ := Nat.exists_eq_succ_of_ne_zero hd1
          rw [hk, pow_succ]
          have h_eq : mk_c (MvPolynomial.C (F.coeff d) *
              (MvPolynomial.X 0 ^ d 0 * (MvPolynomial.X 1 ^ k * MvPolynomial.X 1))) =
