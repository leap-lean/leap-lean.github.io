  have hNb_tilde : ∀ i : Fin (N' + 1), ¬ IsDiscBoundaryIdx ↥R a_opt (c i) (π i) →
      (∀ q ∈ B_tilde i, (q_M ≫ f'_M).base (fst_tilde.base q) = m_0) ∧
