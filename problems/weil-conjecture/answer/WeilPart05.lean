      ∀ q : ↥Y_Mtilde, q ∈ B_tilde i → q ∈ B_tilde j₁ → q ∈ B_tilde j₂ → j₁ = j₂ := by
    intro i j₁ j₂ _ hj₁_ne hj₂_ne q hqi hqj₁ hqj₂
