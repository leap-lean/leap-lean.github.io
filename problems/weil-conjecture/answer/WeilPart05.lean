        f'_M.base (ι_e.base p_max) = m_0)) :=
by
  classical
  let m_R : Ideal ↥R := IsLocalRing.maximalIdeal ↥R
  let k_R : Type u := m_R.ResidueField
  let ρ_R : ↥R →+* k_R := algebraMap ↥R k_R
  let φ_R : ↥R →+* F_0 := φ_KF0.comp R.subtype
  have hφR_inj : Function.Injective φ_R :=
    (RingHom.injective φ_KF0).comp Subtype.val_injective

  
  have nodal_sub_const_mem_span : ∀ (a : ↥R) (F : MvPolynomial (Fin 2) ↥R),
      Ideal.Quotient.mk (weilNodalIdeal ↥R a) F -
        Ideal.Quotient.mk (weilNodalIdeal ↥R a) (MvPolynomial.C (F.coeff 0)) ∈
        Ideal.span ({Ideal.Quotient.mk (weilNodalIdeal ↥R a) (MvPolynomial.X 0),
          Ideal.Quotient.mk (weilNodalIdeal ↥R a) (MvPolynomial.X 1)} :
          Set (weilNodalQuot ↥R a)) := by
    intro a F
    let mk := Ideal.Quotient.mk (weilNodalIdeal ↥R a)
    let S_span : Ideal (weilNodalQuot ↥R a) :=
      Ideal.span ({mk (MvPolynomial.X 0), mk (MvPolynomial.X 1)} : Set (weilNodalQuot ↥R a))
    have hX0_mem : mk (MvPolynomial.X 0) ∈ S_span := Ideal.subset_span (by simp)
    have hX1_mem : mk (MvPolynomial.X 1) ∈ S_span := Ideal.subset_span (by simp)
    have hmon_mem : ∀ d : Fin 2 →₀ ℕ, d ≠ 0 →
        mk ((MvPolynomial.monomial d) (F.coeff d)) ∈ S_span := by
      intro d hd_ne
      have hd01 : d 0 ≠ 0 ∨ d 1 ≠ 0 := by
        by_cases hd0 : d 0 = 0
        · right
          intro hd1
          apply hd_ne
          ext i
          fin_cases i
          · exact hd0
          · exact hd1
        · exact Or.inl hd0
      rw [MvPolynomial.monomial_eq, Finsupp.prod_fintype _ _ (fun _ => pow_zero _),
        Fin.prod_univ_two, map_mul, map_mul, map_pow, map_pow]
      rcases hd01 with hd0 | hd1
      · obtain ⟨k, hk⟩ := Nat.exists_eq_succ_of_ne_zero hd0
        rw [hk, pow_succ]
        have h_eq : mk (MvPolynomial.C (F.coeff d)) *
            (mk (MvPolynomial.X 0) ^ k * mk (MvPolynomial.X 0) * mk (MvPolynomial.X 1) ^ d 1) =
            (mk (MvPolynomial.C (F.coeff d)) * mk (MvPolynomial.X 0) ^ k *
              mk (MvPolynomial.X 1) ^ d 1) * mk (MvPolynomial.X 0) := by ring
        rw [h_eq]
        exact Ideal.mul_mem_left S_span _ hX0_mem
      · obtain ⟨k, hk⟩ := Nat.exists_eq_succ_of_ne_zero hd1
        rw [hk, pow_succ]
        have h_eq : mk (MvPolynomial.C (F.coeff d)) *
            (mk (MvPolynomial.X 0) ^ d 0 * (mk (MvPolynomial.X 1) ^ k * mk (MvPolynomial.X 1))) =
            (mk (MvPolynomial.C (F.coeff d)) * mk (MvPolynomial.X 0) ^ d 0 *
              mk (MvPolynomial.X 1) ^ k) * mk (MvPolynomial.X 1) := by ring
        rw [h_eq]
        exact Ideal.mul_mem_left S_span _ hX1_mem
    have hsum := congrArg mk (MvPolynomial.as_sum F)
    rw [map_sum] at hsum
    change mk F - mk (MvPolynomial.C (F.coeff 0)) ∈ S_span
    by_cases h0 : (0 : Fin 2 →₀ ℕ) ∈ F.support
    · rw [← Finset.add_sum_erase _ _ h0] at hsum
      have hm0 : mk ((MvPolynomial.monomial 0) (F.coeff 0)) = mk (MvPolynomial.C (F.coeff 0)) := by
        rw [MvPolynomial.monomial_zero']
      rw [hm0] at hsum
      have hdiff : mk F - mk (MvPolynomial.C (F.coeff 0)) =
          ∑ d ∈ F.support.erase 0, mk ((MvPolynomial.monomial d) (F.coeff d)) := by
        linear_combination hsum
      rw [hdiff]
      exact Ideal.sum_mem S_span fun d hd => hmon_mem d (Finset.mem_erase.mp hd).1
    · have hcoeff0 : F.coeff 0 = 0 := MvPolynomial.notMem_support_iff.mp h0
      rw [hcoeff0, map_zero, map_zero, sub_zero, hsum]
      exact Ideal.sum_mem S_span fun d hd => hmon_mem d (fun heq => h0 (heq ▸ hd))

  
  have hShrink_gen : ∀ {A : Type u} [CommRing A]
      (c_A : ↥R →+* A) (h : A)
      (ε₀ : A →+* k_R)
      (_hε_R : ε₀.comp c_A = ρ_R)
      (_hε_h : ε₀ h ≠ 0)
      (M' M_tilde : AlgebraicGeometry.Scheme.{u})
      (g'_M : M' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
      (q_M : M_tilde ⟶ M')
      (Z : Set ↥M') (hZ_cl : IsClosed Z)
      (j_2 : AlgebraicGeometry.Scheme.Opens.toScheme
        (⟨Zᶜ, hZ_cl.isOpen_compl⟩ : M'.Opens) ⟶ M_tilde)
      (ι_U : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away h)) ⟶ M')
      (q_opt : Option (PrimeSpectrum (Localization.Away h))),
      AlgebraicGeometry.IsOpenImmersion j_2 →
      j_2 ≫ q_M = AlgebraicGeometry.Scheme.Opens.ι (⟨Zᶜ, hZ_cl.isOpen_compl⟩ : M'.Opens) →
      AlgebraicGeometry.IsOpenImmersion ι_U →
      ι_U ≫ g'_M = AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        ((algebraMap A (Localization.Away h)).comp c_A)) →
      (∀ p₀ : PrimeSpectrum (Localization.Away h),
        (g'_M.base (ι_U.base p₀)).asIdeal = m_R →
        (∀ a : A, ε₀ a = 0 → algebraMap A (Localization.Away h) a ∈ p₀.asIdeal) →
        ι_U.base p₀ ∉ Z) →
      (∀ p₁ : PrimeSpectrum (Localization.Away h), q_opt = some p₁ → ι_U.base p₁ ∉ Z) →
      ∃ (g : A)
        (lam : Localization.Away h →+* Localization.Away (h * g))
        (ι_tilde : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (h * g))) ⟶ M_tilde)
        (u_lift : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (h * g))) ⟶
          AlgebraicGeometry.Scheme.Opens.toScheme (⟨Zᶜ, hZ_cl.isOpen_compl⟩ : M'.Opens)),
        ε₀ (h * g) ≠ 0 ∧
        (∀ p₁ : PrimeSpectrum (Localization.Away h), q_opt = some p₁ →
          algebraMap A (Localization.Away h) g ∉ p₁.asIdeal) ∧
        (∀ a : A, lam (algebraMap A (Localization.Away h) a) =
          algebraMap A (Localization.Away (h * g)) a) ∧
        AlgebraicGeometry.IsOpenImmersion ι_tilde ∧
        u_lift ≫ j_2 = ι_tilde ∧
        u_lift ≫ AlgebraicGeometry.Scheme.Opens.ι (⟨Zᶜ, hZ_cl.isOpen_compl⟩ : M'.Opens) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom lam) ≫ ι_U ∧
        ι_tilde ≫ (q_M ≫ g'_M) = AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          ((algebraMap A (Localization.Away (h * g))).comp c_A)) ∧
        (∀ (η_tilde : AlgebraicGeometry.Spec (CommRingCat.of F_0) ⟶ M_tilde)
           (φ_U : Localization.Away h →+* F_0)
           (q_F0 : PrimeSpectrum F_0),
          q_M.base ⁻¹' Zᶜ = Set.range j_2.base →
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_U) ≫ ι_U = η_tilde ≫ q_M →
          q_opt = some (PrimeSpectrum.comap φ_U q_F0) →
          ∃ (φ_tilde : Localization.Away (h * g) →+* F_0),
            (∀ a : A, φ_tilde (algebraMap A (Localization.Away (h * g)) a) =
              φ_U (algebraMap A (Localization.Away h) a)) ∧
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_tilde) ≫ ι_tilde = η_tilde) := by
    intro A _ c_A h ε₀ hε_R hε_h M' M_tilde g'_M q_M Z hZ_cl j_2 ι_U q_opt
      hOpen_j2 hj2_q hOpen_U hιU_g hp₀_not_Z hq_not_Z
    let B_h := Localization.Away h
    let U_compl : M'.Opens := ⟨Zᶜ, hZ_cl.isOpen_compl⟩
    have hu_h : IsUnit (ε₀ h) := isUnit_iff_ne_zero.mpr hε_h
    let ε_hat : B_h →+* k_R := IsLocalization.Away.lift h hu_h
    have hε_hat_eq : ∀ a : A, ε_hat (algebraMap A B_h a) = ε₀ a :=
      IsLocalization.Away.lift_eq h hu_h
    let p₀ : PrimeSpectrum B_h := ⟨RingHom.ker ε_hat, RingHom.ker_isPrime ε_hat⟩
    have hp₀_mR : (g'_M.base (ι_U.base p₀)).asIdeal = m_R := by
      have h1 : (ι_U ≫ g'_M).base p₀ =
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((algebraMap A B_h).comp c_A))).base p₀ :=
        by rw [hιU_g]
      have h2 : (g'_M.base (ι_U.base p₀)).asIdeal =
          Ideal.comap ((algebraMap A B_h).comp c_A) (RingHom.ker ε_hat) :=
        congrArg PrimeSpectrum.asIdeal h1
      rw [h2]
      ext r
      change ε_hat (algebraMap A B_h (c_A r)) = 0 ↔ r ∈ m_R
      rw [hε_hat_eq, ← RingHom.comp_apply, hε_R]
      exact Ideal.algebraMap_residueField_eq_zero
    have hp₀ : ι_U.base p₀ ∉ Z :=
      hp₀_not_Z p₀ hp₀_mR (fun a ha => by change ε_hat (algebraMap A B_h a) = 0; rw [hε_hat_eq, ha])
    let p₁ : PrimeSpectrum B_h := q_opt.getD p₀
    have hp₁ : ι_U.base p₁ ∉ Z := by
      dsimp only [p₁]
      cases hq : q_opt with
      | none => exact hp₀
      | some q₁ => exact hq_not_Z q₁ hq
    have hZ_pre_cl : IsClosed (ι_U.base ⁻¹' Z) := hZ_cl.preimage ι_U.continuous
    obtain ⟨I_Z, hIZ⟩ := (PrimeSpectrum.isClosed_iff_zeroLocus_ideal (ι_U.base ⁻¹' Z)).mp hZ_pre_cl
    have hp₀_not_zl : p₀ ∉ PrimeSpectrum.zeroLocus (I_Z : Set B_h) := by
      rw [← hIZ]; exact hp₀
    have hp₁_not_zl : p₁ ∉ PrimeSpectrum.zeroLocus (I_Z : Set B_h) := by
      rw [← hIZ]; exact hp₁
    rw [PrimeSpectrum.mem_zeroLocus, Set.not_subset] at hp₀_not_zl hp₁_not_zl
    obtain ⟨f₀, hf₀_IZ, hf₀_p₀⟩ := hp₀_not_zl
    obtain ⟨f₁, hf₁_IZ, hf₁_p₁⟩ := hp₁_not_zl
    let f : B_h := if f₀ ∉ p₁.asIdeal then f₀ else if f₁ ∉ p₀.asIdeal then f₁ else f₀ + f₁
    have hf_props : f ∈ I_Z ∧ f ∉ p₀.asIdeal ∧ f ∉ p₁.asIdeal := by
      dsimp only [f]
      by_cases h1 : f₀ ∉ p₁.asIdeal
      · simp only [h1]
        exact ⟨hf₀_IZ, hf₀_p₀, h1⟩
      · simp only [h1, ↓reduceIte]
        have h1_mem : f₀ ∈ p₁.asIdeal := Classical.not_not.mp h1
        by_cases h2 : f₁ ∉ p₀.asIdeal
        · simp only [h2]
          exact ⟨hf₁_IZ, h2, hf₁_p₁⟩
        · simp only [h2, ↓reduceIte]
          have h2_mem : f₁ ∈ p₀.asIdeal := Classical.not_not.mp h2
          refine ⟨I_Z.add_mem hf₀_IZ hf₁_IZ, ?_, ?_⟩
          · intro hsum
            have hf₀_in : f₀ = (f₀ + f₁) - f₁ := by ring
            exact hf₀_p₀ (hf₀_in ▸ p₀.asIdeal.sub_mem hsum h2_mem)
          · intro hsum
            have hf₁_in : f₁ = (f₀ + f₁) - f₀ := by ring
            exact hf₁_p₁ (hf₁_in ▸ p₁.asIdeal.sub_mem hsum h1_mem)
    obtain ⟨hf_IZ, hf_p₀, hf_p₁⟩ := hf_props
    obtain ⟨⟨g, ⟨_, n, rfl⟩⟩, hg_eq⟩ := IsLocalization.surj (Submonoid.powers h) f
    dsimp only at hg_eq
    let g_Bh : B_h := algebraMap A B_h g
    have hg_IZ : g_Bh ∈ I_Z := by
      change algebraMap A B_h g ∈ I_Z
      rw [← hg_eq]
      exact I_Z.mul_mem_right _ hf_IZ
    have hu_hn : IsUnit (algebraMap A B_h (h ^ n)) := by
      rw [map_pow]
      exact (IsLocalization.Away.algebraMap_isUnit h).pow n
    have hg_p₀ : g_Bh ∉ p₀.asIdeal := by
      intro hmem
      have hmul : f * algebraMap A B_h (h ^ n) ∈ p₀.asIdeal := by
        rw [hg_eq]; exact hmem
      rcases p₀.isPrime.mem_or_mem hmul with h_l | h_r
      · exact hf_p₀ h_l
      · exact p₀.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ h_r hu_hn)
    have hg_p₁ : g_Bh ∉ p₁.asIdeal := by
      intro hmem
      have hmul : f * algebraMap A B_h (h ^ n) ∈ p₁.asIdeal := by
        rw [hg_eq]; exact hmem
      rcases p₁.isPrime.mem_or_mem hmul with h_l | h_r
      · exact hf_p₁ h_l
      · exact p₁.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ h_r hu_hn)
    have hε_hg : ε₀ (h * g) ≠ 0 := by
      rw [map_mul]
      refine mul_ne_zero hε_h ?_
      rw [← hε_hat_eq]
      exact hg_p₀
    have hq_g_not : ∀ q₁ : PrimeSpectrum B_h, q_opt = some q₁ → g_Bh ∉ q₁.asIdeal := by
      intro q₁ hq
      have hp₁_eq : p₁ = q₁ := by dsimp [p₁]; rw [hq]; rfl
      rwa [← hp₁_eq]
    let B_hg := Localization.Away (h * g)
    have hu_hg_map : IsUnit (algebraMap A B_hg h * algebraMap A B_hg g) := by
      rw [← map_mul]
      exact IsLocalization.Away.algebraMap_isUnit (h * g)
    have hu_h' : IsUnit (algebraMap A B_hg h) := isUnit_of_mul_isUnit_left hu_hg_map
    have hu_g' : IsUnit (algebraMap A B_hg g) := isUnit_of_mul_isUnit_right hu_hg_map
    let lam : B_h →+* B_hg := IsLocalization.Away.lift h hu_h'
    have hlam_A : ∀ a : A, lam (algebraMap A B_h a) = algebraMap A B_hg a :=
      IsLocalization.Away.lift_eq h hu_h'
    
    have hOpen_lam : AlgebraicGeometry.IsOpenImmersion
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom lam)) := by
      let T' := Localization.Away g_Bh
      have hLoc_T' : IsLocalization.Away (h * g) T' := IsLocalization.Away.mul' B_h T' h g
      let e_A : T' ≃ₐ[A] B_hg :=
        @IsLocalization.algEquiv A _ (Submonoid.powers (h * g)) T' _ _ hLoc_T' B_hg _ _ _
      let _ : Algebra B_h B_hg := lam.toAlgebra
      have hcomm_Bh : e_A.toRingHom.comp (algebraMap B_h T') = lam := by
        apply IsLocalization.ringHom_ext (Submonoid.powers h)
        ext a
        change e_A (algebraMap B_h T' (algebraMap A B_h a)) = lam (algebraMap A B_h a)
        rw [← IsScalarTower.algebraMap_apply A B_h T' a, e_A.commutes, hlam_A]
      let e_Bh : @AlgEquiv B_h T' B_hg _ _ _ _ lam.toAlgebra :=
        { e_A.toRingEquiv with
          commutes' := fun x => RingHom.congr_fun hcomm_Bh x }
      have hLoc_Bh : @IsLocalization.Away B_h _ g_Bh B_hg _ lam.toAlgebra :=
        @IsLocalization.isLocalization_of_algEquiv B_h _ (Submonoid.powers g_Bh)
          T' _ _ B_hg _ lam.toAlgebra _ e_Bh
      exact @AlgebraicGeometry.IsOpenImmersion.of_isLocalization B_h B_hg _ _ lam.toAlgebra g_Bh hLoc_Bh
    have hRange_sub : Set.range (AlgebraicGeometry.Spec.map (CommRingCat.ofHom lam) ≫ ι_U).base ⊆
        Set.range U_compl.ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rintro _ ⟨q, rfl⟩
      change ι_U.base (PrimeSpectrum.comap lam q) ∈ Zᶜ
      rw [Set.mem_compl_iff]
      intro hmemZ
      have hmem_zl : PrimeSpectrum.comap lam q ∈ PrimeSpectrum.zeroLocus (I_Z : Set B_h) := by
        rw [← hIZ]; exact hmemZ
      have hg_in_q : lam g_Bh ∈ q.asIdeal := hmem_zl hg_IZ
      rw [hlam_A] at hg_in_q
      exact q.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ hg_in_q hu_g')
    let u_lift := AlgebraicGeometry.IsOpenImmersion.lift U_compl.ι
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom lam) ≫ ι_U) hRange_sub
    have hu_ι : u_lift ≫ U_compl.ι =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom lam) ≫ ι_U :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac U_compl.ι _ hRange_sub
    have hOpen_comp : AlgebraicGeometry.IsOpenImmersion
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom lam) ≫ ι_U) :=
      @AlgebraicGeometry.IsOpenImmersion.comp _ _ _ _ _ hOpen_lam hOpen_U
    have hOpen_u_ι : AlgebraicGeometry.IsOpenImmersion (u_lift ≫ U_compl.ι) := by
      rw [hu_ι]; exact hOpen_comp
    have hOpen_ulift : AlgebraicGeometry.IsOpenImmersion u_lift :=
      @AlgebraicGeometry.IsOpenImmersion.of_comp _ _ _ u_lift U_compl.ι _ hOpen_u_ι
    let ι_tilde := u_lift ≫ j_2
    have hOpen_tilde : AlgebraicGeometry.IsOpenImmersion ι_tilde :=
      @AlgebraicGeometry.IsOpenImmersion.comp _ _ _ u_lift j_2 hOpen_ulift hOpen_j2
    have hιtilde_g : ι_tilde ≫ (q_M ≫ g'_M) = AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        ((algebraMap A B_hg).comp c_A)) := by
      change (u_lift ≫ j_2) ≫ (q_M ≫ g'_M) = _
      rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc j_2, hj2_q,
        ← CategoryTheory.Category.assoc, hu_ι, CategoryTheory.Category.assoc, hιU_g,
        ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      congr 1
      apply CommRingCat.hom_ext
      ext r
      exact hlam_A (c_A r)
    refine ⟨g, lam, ι_tilde, u_lift, hε_hg, hq_g_not, hlam_A, hOpen_tilde, rfl, hu_ι,
      hιtilde_g, ?_⟩
    intro η_tilde φ_U q_F0 hPre hφU_η hq_eq
    have hg_not_ker : g_Bh ∉ (PrimeSpectrum.comap φ_U q_F0).asIdeal := hq_g_not _ hq_eq
    have hφU_g_ne : φ_U g_Bh ≠ 0 := fun h0 =>
      hg_not_ker (by change φ_U g_Bh ∈ q_F0.asIdeal; rw [h0]; exact q_F0.asIdeal.zero_mem)
    have hu_φU_hg : IsUnit ((φ_U.comp (algebraMap A B_h)) (h * g)) := by
      change IsUnit (φ_U (algebraMap A B_h (h * g)))
      rw [map_mul, map_mul]
      exact ((IsLocalization.Away.algebraMap_isUnit h).map φ_U).mul
        (isUnit_iff_ne_zero.mpr hφU_g_ne)
    let φ_tilde : B_hg →+* F_0 := IsLocalization.Away.lift (h * g) hu_φU_hg
    have hφtilde_A : ∀ a : A, φ_tilde (algebraMap A B_hg a) = φ_U (algebraMap A B_h a) :=
      IsLocalization.Away.lift_eq (h * g) hu_φU_hg
    have hφtilde_lam : φ_tilde.comp lam = φ_U := by
      apply IsLocalization.ringHom_ext (Submonoid.powers h)
      ext a
      change φ_tilde (lam (algebraMap A B_h a)) = φ_U (algebraMap A B_h a)
      rw [hlam_A, hφtilde_A]
    have hη_range : Set.range η_tilde.base ⊆ Set.range j_2.base := by
      rw [← hPre]
      rintro _ ⟨pt, rfl⟩
      have hpt_eq : pt = q_F0 := Subsingleton.elim pt q_F0
      subst hpt_eq
      change (η_tilde ≫ q_M).base pt ∈ Zᶜ
      rw [← hφU_η]
      exact hq_not_Z _ hq_eq
    let η_U := AlgebraicGeometry.IsOpenImmersion.lift j_2 η_tilde hη_range
    have hηU_j2 : η_U ≫ j_2 = η_tilde :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac j_2 η_tilde hη_range
    have hφ_ulift : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_tilde) ≫ u_lift = η_U := by
      apply (cancel_mono U_compl.ι).mp
      rw [CategoryTheory.Category.assoc, hu_ι, ← CategoryTheory.Category.assoc,
        ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hφtilde_lam, hφU_η,
        ← hj2_q, ← CategoryTheory.Category.assoc, hηU_j2]
    refine ⟨φ_tilde, hφtilde_A, ?_⟩
    change AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_tilde) ≫ (u_lift ≫ j_2) = η_tilde
    rw [← CategoryTheory.Category.assoc, hφ_ulift, hηU_j2]

  
  have smooth_away_φ_injective : ∀ (c_d π_d : ↥R), π_d ≠ 0 →
      ∀ (h : Polynomial ↥R) (φ : Localization.Away h →+* F_0),
        (∀ r : ↥R, φ (algebraMap (Polynomial ↥R) (Localization.Away h) (Polynomial.C r)) = φ_R r) →
        φ_R π_d * φ (algebraMap (Polynomial ↥R) (Localization.Away h) Polynomial.X) =
          T_0 - φ_R c_d →
        Function.Injective φ := by
    intro c_d π_d hπ_ne h φ hφ_C hφ_X
    refine (injective_iff_map_eq_zero φ).mpr fun x hx => ?_
    obtain ⟨⟨P, ⟨_, n, rfl⟩⟩, hP_eq⟩ := IsLocalization.surj (Submonoid.powers h) x
    dsimp only at hP_eq
    let u : F_0 := φ (algebraMap (Polynomial ↥R) (Localization.Away h) Polynomial.X)
    have hφ_eval : φ.comp (algebraMap (Polynomial ↥R) (Localization.Away h)) =
        Polynomial.eval₂RingHom φ_R u := by
      apply Polynomial.ringHom_ext
      · intro r
        simp only [RingHom.comp_apply, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
        exact hφ_C r
      · simp only [RingHom.comp_apply, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X, u]
    have hP_eval : Polynomial.eval₂ φ_R u P = 0 := by
      change (Polynomial.eval₂RingHom φ_R u) P = 0
      rw [← hφ_eval, RingHom.comp_apply, ← hP_eq, map_mul, hx, zero_mul]
    let D := P.natDegree
    let Q_P : Polynomial ↥R :=
      ∑ i ∈ Finset.range (D + 1),
        Polynomial.C (P.coeff i * π_d ^ (D - i)) * (Polynomial.X - Polynomial.C c_d) ^ i
    have hQ_eval : Polynomial.eval₂ φ_R T_0 Q_P = 0 := by
      dsimp only [Q_P]
      rw [Polynomial.eval₂_finsetSum]
      have hterms : ∀ i ∈ Finset.range (D + 1),
          Polynomial.eval₂ φ_R T_0
            (Polynomial.C (P.coeff i * π_d ^ (D - i)) * (Polynomial.X - Polynomial.C c_d) ^ i) =
          (φ_R π_d) ^ D * (φ_R (P.coeff i) * u ^ i) := by
        intro i hi
        have hi_le : i ≤ D := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
        rw [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_pow, Polynomial.eval₂_sub,
          Polynomial.eval₂_X, Polynomial.eval₂_C, ← hφ_X, mul_pow, map_mul, map_pow]
        have hpow : (φ_R π_d) ^ (D - i) * (φ_R π_d) ^ i = (φ_R π_d) ^ D := by
          rw [← pow_add, Nat.sub_add_cancel hi_le]
        calc φ_R (P.coeff i) * φ_R π_d ^ (D - i) * (φ_R π_d ^ i * u ^ i)
            = (φ_R π_d ^ (D - i) * φ_R π_d ^ i) * (φ_R (P.coeff i) * u ^ i) := by ring
          _ = φ_R π_d ^ D * (φ_R (P.coeff i) * u ^ i) := by rw [hpow]
      rw [Finset.sum_congr rfl hterms, ← Finset.mul_sum, ← Polynomial.eval₂_eq_sum_range,
        hP_eval, mul_zero]
    have hQP_zero : Q_P = 0 := by
      by_contra hne
      exact hGauss.2.1 Q_P hne hQ_eval
    let S_lin : Polynomial ↥R := Polynomial.C c_d + Polynomial.C π_d * Polynomial.X
    have hsum_comp : ∀ (s : Finset ℕ) (f_s : ℕ → Polynomial ↥R),
        (∑ i ∈ s, f_s i).comp S_lin = ∑ i ∈ s, (f_s i).comp S_lin := by
      intro s f_s
      induction s using Finset.cons_induction with
      | empty => rw [Finset.sum_empty, Finset.sum_empty, Polynomial.zero_comp]
      | cons a s ha ih => rw [Finset.sum_cons, Finset.sum_cons, Polynomial.add_comp, ih]
    have hcomp_eq : Q_P.comp S_lin = Polynomial.C (π_d ^ D) * P := by
      dsimp only [Q_P]
      rw [hsum_comp]
      have hX_sub : (Polynomial.X - Polynomial.C c_d).comp S_lin =
          Polynomial.C π_d * Polynomial.X := by
        rw [Polynomial.sub_comp, Polynomial.X_comp, Polynomial.C_comp]
        dsimp only [S_lin]
        ring
      have hterms : ∀ i ∈ Finset.range (D + 1),
          (Polynomial.C (P.coeff i * π_d ^ (D - i)) *
            (Polynomial.X - Polynomial.C c_d) ^ i).comp S_lin =
          Polynomial.C (π_d ^ D) * (Polynomial.monomial i (P.coeff i)) := by
        intro i hi
        have hi_le : i ≤ D := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
        rw [Polynomial.mul_comp, Polynomial.C_comp, Polynomial.pow_comp, hX_sub, mul_pow,
          ← Polynomial.C_pow, ← mul_assoc, ← Polynomial.C_mul, ← Polynomial.C_mul_X_pow_eq_monomial]
        have hpow : P.coeff i * π_d ^ (D - i) * π_d ^ i = π_d ^ D * P.coeff i := by
          calc P.coeff i * π_d ^ (D - i) * π_d ^ i
              = (π_d ^ (D - i) * π_d ^ i) * P.coeff i := by ring
            _ = π_d ^ D * P.coeff i := by rw [← pow_add, Nat.sub_add_cancel hi_le]
        rw [hpow, Polynomial.C_mul, mul_assoc]
      rw [Finset.sum_congr rfl hterms, ← Finset.mul_sum, ← Polynomial.as_sum_range]
    have hmul_P : Polynomial.C (π_d ^ D) * P = 0 := by
      rw [← hcomp_eq, hQP_zero, Polynomial.zero_comp]
    have hC_ne : Polynomial.C (π_d ^ D) ≠ 0 :=
      Polynomial.C_ne_zero.mpr (pow_ne_zero D hπ_ne)
    have hP_zero : P = 0 := (mul_eq_zero.mp hmul_P).resolve_left hC_ne
    have hx_mul : x * (algebraMap (Polynomial ↥R) (Localization.Away h) h) ^ n = 0 := by
      rw [← map_pow, hP_eq, hP_zero, map_zero]
    have hinv : (algebraMap (Polynomial ↥R) (Localization.Away h) h) ^ n *
        (IsLocalization.Away.invSelf (S := Localization.Away h) h) ^ n = 1 := by
      rw [← mul_pow, IsLocalization.Away.mul_invSelf, one_pow]
    have hx_zero : x = 0 := by
      calc x = x * 1 := (mul_one x).symm
        _ = x * ((algebraMap (Polynomial ↥R) (Localization.Away h) h) ^ n *
              (IsLocalization.Away.invSelf (S := Localization.Away h) h) ^ n) := by rw [hinv]
        _ = (x * (algebraMap (Polynomial ↥R) (Localization.Away h) h) ^ n) *
              (IsLocalization.Away.invSelf (S := Localization.Away h) h) ^ n := (mul_assoc _ _ _).symm
        _ = 0 := by rw [hx_mul, zero_mul]
    exact hx_zero

  let q_F0 : PrimeSpectrum F_0 := ⟨RingHom.ker (RingHom.id F_0), RingHom.ker_isPrime (RingHom.id F_0)⟩

