  let ρ_D : ↑(Y.presheaf.obj (Opposite.op D'_Y)) →+* ↥W :=
    IsLocalization.Away.lift r'_0 hr'_0_unit
  let res_UY_D' := Y.presheaf.map (CategoryTheory.homOfLE hD'_le_UY).op
  let t_W : ↥W := ρ_P ((π₂.appLE U_Y V_P e_Y).hom c_star)
  have hρD_resUY : ρ_D (res_UY_D'.hom c_star) = t_W := by
    have hSpec_eq : AlgebraicGeometry.Spec.map (res_UY_D' ≫ CommRingCat.ofHom ρ_D) =
        AlgebraicGeometry.Spec.map (π₂.appLE U_Y V_P e_Y ≫ CommRingCat.ofHom ρ_P) := by
      apply (cancel_mono hUY.fromSpec).mp
      have hρD_comp : Y.presheaf.map (CategoryTheory.homOfLE (Y.basicOpen_le r'_0)).op ≫
          CommRingCat.ofHom ρ_D = ρ'_Y_hom := by
        ext a
        exact congrArg W.subtype (IsLocalization.Away.lift_eq r'_0 hr'_0_unit a)
      calc
        AlgebraicGeometry.Spec.map (res_UY_D' ≫ CommRingCat.ofHom ρ_D) ≫ hUY.fromSpec
          = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_D) ≫
              (AlgebraicGeometry.Spec.map res_UY_D' ≫ hUY.fromSpec) := by
            rw [AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_D) ≫ hD'_aff.fromSpec := by
            rw [hUY.map_fromSpec hD'_aff (CategoryTheory.homOfLE hD'_le_UY).op]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_D) ≫
              (AlgebraicGeometry.Spec.map
                (Y.presheaf.map (CategoryTheory.homOfLE (Y.basicOpen_le r'_0)).op) ≫
                hU'_Y.fromSpec) := by
            rw [hU'_Y.map_fromSpec hD'_aff (CategoryTheory.homOfLE (Y.basicOpen_le r'_0)).op]
        _ = AlgebraicGeometry.Spec.map
              (Y.presheaf.map (CategoryTheory.homOfLE (Y.basicOpen_le r'_0)).op ≫
                CommRingCat.ofHom ρ_D) ≫ hU'_Y.fromSpec := by
            rw [AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc]
        _ = AlgebraicGeometry.Spec.map ρ'_Y_hom ≫ hU'_Y.fromSpec := by
            rw [hρD_comp]
        _ = ψ_W := hρ'_fromSpec
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_P) ≫ (hVP.fromSpec ≫ π₂) := rfl
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_P) ≫
              (AlgebraicGeometry.Spec.map (π₂.appLE U_Y V_P e_Y) ≫ hUY.fromSpec) := by
            rw [AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec π₂ hUY hVP e_Y]
        _ = AlgebraicGeometry.Spec.map (π₂.appLE U_Y V_P e_Y ≫ CommRingCat.ofHom ρ_P) ≫
              hUY.fromSpec := by
            rw [AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc]
    have hPre := congrArg AlgebraicGeometry.Spec.preimage hSpec_eq
    rw [AlgebraicGeometry.Spec.preimage_map, AlgebraicGeometry.Spec.preimage_map] at hPre
    exact congrArg (fun f => f.hom c_star) hPre
  obtain ⟨k_pow, b_num, hsurj⟩ := IsLocalization.Away.surj r'_0 (res_UY_D'.hom c_star)
  have ht_eq : t_W * (ρ'_Y r'_0) ^ k_pow = ρ'_Y b_num := by
    have h1 := congrArg ρ_D hsurj
    rw [map_mul, map_pow, IsLocalization.Away.lift_eq r'_0 hr'_0_unit r'_0,
      IsLocalization.Away.lift_eq r'_0 hr'_0_unit b_num, hρD_resUY] at h1
    exact h1
  
  obtain ⟨q_P, instPrime_qP, t_coord, hq_η_P, hq_P_y₀, hqP_comap, ht_coord_tr⟩ :=
    weil_etale_semistable_chart_goingDown_transcendental_lift K V hNodalNorm Q P hQP F φ_KF W hV
      B'_Y γ'_Y q'_η q'_y₀ hq_le hq'_η_Q hq'_y₀_P ρ'_Y rfl hγ'_W
      b_num r'_0 t_W k_pow hr'_0 ht_eq hTransY hChart
  letI : q_P.IsPrime := instPrime_qP
  let pt'_P : ↥(AlgebraicGeometry.Spec (Y.presheaf.obj (Opposite.op U'_Y))) := ⟨q_P, instPrime_qP⟩
  let y_P : Y := hU'_Y.fromSpec.base pt'_P
  have hy_P_cl : y_P ∈ closure ({η_YQ} : Set Y) := by
    rw [← hpt'_η_base]
    exact (hFromSpec_cl_iff hU'_Y pt'_η pt'_P).mpr hq_η_P
  have hy_P_im : y_P ∈ π₂.base '' Z := by
    rw [hπ₂_Z]; exact hy_P_cl
  obtain ⟨z_P, hzP_Z, hzP_yP⟩ := hy_P_im
  have hz_P : ((π₁ ≫ g_X).base z_P).asIdeal = P := by
    rw [hπ_g]
    have h1 : ((π₂ ≫ g_Y).base z_P).asIdeal = (g_Y.base (π₂.base z_P)).asIdeal := rfl
    rw [h1, hzP_yP]
    change ((hU'_Y.fromSpec ≫ g_Y).base pt'_P).asIdeal = P
    rw [hSpec_over_V (hU'_Y.fromSpec ≫ g_Y) pt'_P]
    exact hqP_comap
  have hz_x₀ : π₁.base z_P = x₀ := by
    apply hSing_X (π₁.base z_P)
    · rw [← hπ₁_Z]; exact ⟨z_P, hzP_Z, rfl⟩
    · exact hz_P
  
  have hBivar := weil_bivariate_obstruction_and_algClosed_fiber_nonMaximal K V
  obtain ⟨q₁, instPrime_q₁, hqP_le_q₁, hq₁_ne_qP, hq₁_comap⟩ :=
    hBivar.2 P B'_Y γ'_Y hFT_γ'_Y q_P hqP_comap t_coord ht_coord_tr
  letI : q₁.IsPrime := instPrime_q₁
  let pt'_1 : ↥(AlgebraicGeometry.Spec (Y.presheaf.obj (Opposite.op U'_Y))) := ⟨q₁, instPrime_q₁⟩
  let y₁_base : Y := hU'_Y.fromSpec.base pt'_1
  have hy₁_ne : y₁_base ≠ π₂.base z_P := by
    rw [hzP_yP]
    intro heq
    have hpt_eq : pt'_1 = pt'_P := hU'_Y.fromSpec.isOpenEmbedding.injective heq
    exact hq₁_ne_qP (congrArg PrimeSpectrum.asIdeal hpt_eq)
  have hy₁_cl : y₁_base ∈ closure ({π₂.base z_P} : Set Y) := by
    rw [hzP_yP]
    exact (hFromSpec_cl_iff hU'_Y pt'_P pt'_1).mpr hqP_le_q₁
  have hy₁_P : (g_Y.base y₁_base).asIdeal = P := by
    change ((hU'_Y.fromSpec ≫ g_Y).base pt'_1).asIdeal = P
    rw [hSpec_over_V (hU'_Y.fromSpec ≫ g_Y) pt'_1]
    exact hq₁_comap
  
  have hU'_ne : Nonempty ↥U'_Y := ⟨⟨y₀, hy₀_U'⟩⟩
  haveI : IsDomain B'_Y :=
    @AlgebraicGeometry.IsIntegral.component_integral Y hSS_Y.1 U'_Y hU'_ne
  obtain ⟨φ_UY', hFrac_UY', hφ_UY'⟩ := hFunc_Y U'_Y hU'_Y hU'_ne
  have hInj_UY' : Function.Injective φ_UY'.hom := by
    letI : Algebra B'_Y F := φ_UY'.hom.toAlgebra
    exact @IsFractionRing.injective B'_Y _ F _ _ hFrac_UY'
  have hCompat_UY' : ∀ c : ↥V, φ_UY'.hom (γ'_Y c) = φ_KF (V.subtype c) := by
    intro c
    have hSpec_eq : AlgebraicGeometry.Spec.map (γ'_Y_hom ≫ φ_UY') = η_P ≫ π₁ ≫ g_X := by
      calc
        AlgebraicGeometry.Spec.map (γ'_Y_hom ≫ φ_UY')
          = AlgebraicGeometry.Spec.map φ_UY' ≫ AlgebraicGeometry.Spec.map γ'_Y_hom := by
            rw [AlgebraicGeometry.Spec.map_comp]
        _ = (AlgebraicGeometry.Spec.map φ_UY' ≫ hU'_Y.fromSpec) ≫ g_Y := by
            rw [AlgebraicGeometry.Spec.map_preimage, CategoryTheory.Category.assoc]
        _ = η_Y ≫ g_Y := by
            rw [hφ_UY']
        _ = η_P ≫ (π₂ ≫ g_Y) := by
            rw [← hηP_Y, CategoryTheory.Category.assoc]
        _ = η_P ≫ π₁ ≫ g_X := by
            rw [← hπ_g]
    have hPre := congrArg AlgebraicGeometry.Spec.preimage hSpec_eq
    rw [AlgebraicGeometry.Spec.preimage_map] at hPre
    exact (congrArg (fun f => f.hom c) hPre).trans (hφ_V c).symm
  have hMax_yP : ∀ y' : Y,
      (g_Y.base y').asIdeal = P →
      π₂.base z_P ∈ closure ({y'} : Set Y) →
      y' = π₂.base z_P := by
    intro y' hy'_P hy'_cl
    have hyP_U' : y_P ∈ U'_Y := by
      change y_P ∈ (U'_Y : Set Y)
      rw [← hU'_Y.range_fromSpec]; exact ⟨pt'_P, rfl⟩
    rw [hzP_yP] at hy'_cl ⊢
    obtain ⟨w, hw_U', hw_eq⟩ := mem_closure_iff.mp hy'_cl (U'_Y : Set Y) U'_Y.2 hyP_U'
    have hy'_U' : y' ∈ U'_Y := by
      have hw_y' : w = y' := hw_eq
      rwa [← hw_y']
    let pt'_y' : ↥(AlgebraicGeometry.Spec (Y.presheaf.obj (Opposite.op U'_Y))) :=
      hU'_Y.primeIdealOf ⟨y', hy'_U'⟩
    have hpt'_y'_base : hU'_Y.fromSpec.base pt'_y' = y' :=
      hU'_Y.fromSpec_primeIdealOf ⟨y', hy'_U'⟩
    have hle : pt'_y'.asIdeal ≤ q_P := by
      apply (hFromSpec_cl_iff hU'_Y pt'_y' pt'_P).mp
      rwa [hpt'_y'_base]
    have hcomap : Ideal.comap γ'_Y pt'_y'.asIdeal = P := by
      rw [← hSpec_over_V (hU'_Y.fromSpec ≫ g_Y) pt'_y']
      change (g_Y.base (hU'_Y.fromSpec.base pt'_y')).asIdeal = P
      rw [hpt'_y'_base]; exact hy'_P
    have hq_eq : pt'_y'.asIdeal = q_P :=
      hBivar.1 F φ_KF hTwoVar P B'_Y γ'_Y φ_UY'.hom hInj_UY' hCompat_UY'
        pt'_y'.asIdeal q_P hle hcomap t_coord ht_coord_tr
    have hpt_eq : pt'_y' = pt'_P := PrimeSpectrum.ext hq_eq
    rw [← hpt'_y'_base, hpt_eq]
  have hMax_zP : ∀ z' : P_tilde,
      ((π₁ ≫ g_X).base z').asIdeal = P →
      z_P ∈ closure ({z'} : Set P_tilde) →
      z' = z_P := by
    intro z' hz'_P hz'_cl
    have hzP_pre : z_P ∈ (TopologicalSpace.Opens.map π₂.base).obj U'_Y := by
      change π₂.base z_P ∈ (U'_Y : Set Y)
