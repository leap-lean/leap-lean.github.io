      intro a ha
      refine isCosetAlg_of_norm a 1 ha isUnit_one (by simp) ?_
      have h1 : π_W 1 = algebraMap k_R κ_0 1 := by simp
      rw [h1]
      exact isAlgebraic_algebraMap (1 : k_R)
    have isCosetAlg_mul : ∀ {z₁ z₂ : F_0},
        z₁ ≠ 0 → z₂ ≠ 0 → IsCosetAlg z₁ → IsCosetAlg z₂ → IsCosetAlg (z₁ * z₂) := by
      intro z₁ z₂ hz₁ hz₂ halg₁ halg₂
      obtain ⟨b₁, u₁, hb₁, hu₁, heq₁⟩ := hValEq z₁ hz₁
      obtain ⟨b₂, u₂, hb₂, hu₂, heq₂⟩ := hValEq z₂ hz₂
      have ha₁ : IsAlgebraic k_R (π_W u₁) := halg₁ b₁ u₁ hb₁ hu₁ heq₁
      have ha₂ : IsAlgebraic k_R (π_W u₂) := halg₂ b₂ u₂ hb₂ hu₂ heq₂
      refine isCosetAlg_of_norm (b₁ * b₂) (u₁ * u₂) (mul_ne_zero hb₁ hb₂) (hu₁.mul hu₂) ?_ ?_
      · calc φ_KF0 (b₁ * b₂) * W_0.subtype (u₁ * u₂)
            = (φ_KF0 b₁ * W_0.subtype u₁) * (φ_KF0 b₂ * W_0.subtype u₂) := by
                rw [map_mul, map_mul]; ring
          _ = z₁ * z₂ := by rw [heq₁, heq₂]
      · rw [map_mul]
        exact ha₁.mul ha₂
    have isCosetAlg_inv : ∀ {z : F_0}, z ≠ 0 → IsCosetAlg z → IsCosetAlg z⁻¹ := by
      intro z hz halg
      obtain ⟨b, u, hb, hu, heq⟩ := hValEq z hz
      have ha : IsAlgebraic k_R (π_W u) := halg b u hb hu heq
