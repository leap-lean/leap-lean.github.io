          rw [Polynomial.coeff_C_mul_X_pow]
          split_ifs with heq
          · exact absurd (hfin2_ext heq.symm ((Finset.mem_filter.mp hd).2.trans
              (Finset.mem_filter.mp hd₀).2.symm)) hd_ne
          · rfl
        · intro hnot
          exact absurd hd₀ hnot
      refine (ha_iff p₁.asIdeal).mpr ?_
      change ψF1 F ∈ p₁.asIdeal
      rw [hsplit]
      exact p₁.asIdeal.add_mem hS1_p1 hS1'_p1
  
  have hChartClosed : ∀ (a : R₀), a ∈ m₀ →
      ∀ (P : MvPolynomial (Fin 2) R₀), P.coeff 0 ∉ m₀ →
      ∀ (h : weilNodalQuot R₀ a), h = Ideal.Quotient.mk (weilNodalIdeal R₀ a) P →
      let φ_Ra : R₀ →+* Localization.Away h :=
        (algebraMap (weilNodalQuot R₀ a) (Localization.Away h)).comp
          ((Ideal.Quotient.mk (weilNodalIdeal R₀ a)).comp MvPolynomial.C)
      let x_coord : Fin 2 → Localization.Away h := fun j =>
        algebraMap (weilNodalQuot R₀ a) (Localization.Away h)
          (Ideal.Quotient.mk (weilNodalIdeal R₀ a) (MvPolynomial.X j))
      (∀ i : Fin 2,
        ∃ q_S : PrimeSpectrum (Localization.Away h),
          (PrimeSpectrum.comap φ_Ra q_S).asIdeal = m₀ ∧
          x_coord i ∈ q_S.asIdeal ∧
          x_coord (1 - i) ∉ q_S.asIdeal ∧
          ∀ p : PrimeSpectrum (Localization.Away h),
            x_coord i ∈ p.asIdeal →
            m₀ ≤ (PrimeSpectrum.comap φ_Ra p).asIdeal →
            q_S.asIdeal ≤ p.asIdeal) ∧
      (∃! p_nod : PrimeSpectrum (Localization.Away h),
        (PrimeSpectrum.comap φ_Ra p_nod).asIdeal = m₀ ∧
        x_coord 0 ∈ p_nod.asIdeal ∧ x_coord 1 ∈ p_nod.asIdeal) := by
    intro a ha_mem P hc0_P h hh_eq φ_Ra x_coord
    have hqa : q_m a = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr ha_mem
    have hqc0_ne : q_m (P.coeff 0) ≠ 0 :=
      fun h0 => hc0_P (Ideal.Quotient.eq_zero_iff_mem.mp h0)
    constructor
    · intro i
      let ev_Si : MvPolynomial (Fin 2) R₀ →+* Polynomial k₀ :=
        MvPolynomial.eval₂Hom (Polynomial.C.comp q_m)
          (fun j : Fin 2 => if j = i then 0 else Polynomial.X)
      let h_bar : Polynomial k₀ := ev_Si P
      have hev0_comp : (Polynomial.evalRingHom (0 : k₀)).comp ev_Si =
          q_m.comp MvPolynomial.constantCoeff := by
        apply MvPolynomial.ringHom_ext'
        · ext r; simp [ev_Si]
        · intro j
          simp only [RingHom.comp_apply, Polynomial.coe_evalRingHom, ev_Si,
            MvPolynomial.eval₂Hom_X', MvPolynomial.constantCoeff_X, map_zero]
          split_ifs <;> simp
      have h_bar_ne : h_bar ≠ 0 := by
        intro h0
        have hev : Polynomial.eval 0 h_bar = q_m (P.coeff 0) := by
          have h1 := RingHom.congr_fun hev0_comp P
          rw [RingHom.comp_apply, RingHom.comp_apply, Polynomial.coe_evalRingHom,
            MvPolynomial.constantCoeff_eq] at h1
          exact h1
        rw [h0, Polynomial.eval_zero] at hev
        exact hqc0_ne hev.symm
      let L_Si := Localization.Away h_bar
      have hbar_le_nzd : Submonoid.powers h_bar ≤ nonZeroDivisors (Polynomial k₀) :=
        Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero h_bar_ne)
      have _ : IsDomain L_Si := IsLocalization.isDomain_of_le_nonZeroDivisors L_Si hbar_le_nzd
      have h_inj_Si : Function.Injective (algebraMap (Polynomial k₀) L_Si) :=
        IsLocalization.injective L_Si hbar_le_nzd
      let θ_pre : weilNodalQuot R₀ a →+* L_Si :=
        Ideal.Quotient.lift (weilNodalIdeal R₀ a) ((algebraMap (Polynomial k₀) L_Si).comp ev_Si)
          (fun x hx => by
            have hle : weilNodalIdeal R₀ a ≤
                RingHom.ker ((algebraMap (Polynomial k₀) L_Si).comp ev_Si) := by
              rw [weilNodalIdeal, Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
              fin_cases i <;> simp [ev_Si, hqa]
            exact RingHom.mem_ker.mp (hle hx))
      have hu_h : IsUnit (θ_pre h) := by
        rw [hh_eq]
        change IsUnit (algebraMap (Polynomial k₀) L_Si h_bar)
        exact IsLocalization.Away.algebraMap_isUnit (S := L_Si) h_bar
      let θ_Si : Localization.Away h →+* L_Si :=
        IsLocalization.Away.lift (S := Localization.Away h) h hu_h
      have hθ_Si_mk : ∀ F : MvPolynomial (Fin 2) R₀,
          θ_Si (algebraMap (weilNodalQuot R₀ a) (Localization.Away h)
            (Ideal.Quotient.mk (weilNodalIdeal R₀ a) F)) =
          algebraMap (Polynomial k₀) L_Si (ev_Si F) := by
        intro F
        exact IsLocalization.Away.lift_eq (S := Localization.Away h) h hu_h
          (Ideal.Quotient.mk (weilNodalIdeal R₀ a) F)
      let q_S : PrimeSpectrum (Localization.Away h) :=
        ⟨RingHom.ker θ_Si, RingHom.ker_isPrime θ_Si⟩
      have hqS_m : (PrimeSpectrum.comap φ_Ra q_S).asIdeal = m₀ := by
        ext r
        change θ_Si (algebraMap (weilNodalQuot R₀ a) (Localization.Away h)
          (Ideal.Quotient.mk (weilNodalIdeal R₀ a) (MvPolynomial.C r))) = 0 ↔ r ∈ m₀
        rw [hθ_Si_mk]
        dsimp only [ev_Si]
        rw [MvPolynomial.eval₂Hom_C, RingHom.comp_apply, map_eq_zero_iff _ h_inj_Si,
          Polynomial.C_eq_zero]
        exact Ideal.Quotient.eq_zero_iff_mem
      have hxi_in : x_coord i ∈ q_S.asIdeal := by
        change θ_Si (x_coord i) = 0
        dsimp only [x_coord]
        rw [hθ_Si_mk]
        simp [ev_Si]
      have hx1i_not : x_coord (1 - i) ∉ q_S.asIdeal := by
        change θ_Si (x_coord (1 - i)) ≠ 0
        dsimp only [x_coord]
        rw [hθ_Si_mk]
        have hev_1i : ev_Si (MvPolynomial.X (1 - i)) = Polynomial.X := by
          fin_cases i <;> simp [ev_Si]
        rw [hev_1i]
        exact fun h0 => Polynomial.X_ne_zero ((map_eq_zero_iff _ h_inj_Si).mp h0)
      refine ⟨q_S, hqS_m, hxi_in, hx1i_not, ?_⟩
      intro p hx_p hm_p z hz
      obtain ⟨b, hb_iff⟩ := hsurj_away h z
      obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective b
      let ψFa : MvPolynomial (Fin 2) R₀ →+* Localization.Away h :=
        (algebraMap (weilNodalQuot R₀ a) (Localization.Away h)).comp
          (Ideal.Quotient.mk (weilNodalIdeal R₀ a))
      have hF_ker : θ_Si (algebraMap (weilNodalQuot R₀ a) (Localization.Away h)
          (Ideal.Quotient.mk (weilNodalIdeal R₀ a) F)) = 0 :=
        (hb_iff q_S.asIdeal).mp hz
      have hev_F0 : ev_Si F = 0 := by
        rw [hθ_Si_mk] at hF_ker
        exact (map_eq_zero_iff _ h_inj_Si).mp hF_ker
      let S' := F.support.filter (fun d => d i = 0)
      let S'' := F.support.filter (fun d => ¬ d i = 0)
      have hsplitF : F = (∑ d ∈ S', MvPolynomial.monomial d (F.coeff d)) +
          (∑ d ∈ S'', MvPolynomial.monomial d (F.coeff d)) := by
        conv_lhs => rw [MvPolynomial.as_sum F]
        rw [← Finset.sum_filter_add_sum_filter_not F.support (fun d => d i = 0)]
      have hS''_p : ψFa (∑ d ∈ S'', MvPolynomial.monomial d (F.coeff d)) ∈ p.asIdeal := by
        rw [map_sum]
        exact Ideal.sum_mem p.asIdeal fun d hd =>
          hmon_mem ψFa p.asIdeal i d (F.coeff d) hx_p (Finset.mem_filter.mp hd).2
      have hS''_ev : ev_Si (∑ d ∈ S'', MvPolynomial.monomial d (F.coeff d)) = 0 := by
        have hxi_ev : ev_Si (MvPolynomial.X i) ∈ (⊥ : Ideal (Polynomial k₀)) := by
          simp [ev_Si]
        rw [map_sum]
        refine Finset.sum_eq_zero fun d hd => ?_
        rw [← Ideal.mem_bot]
        exact hmon_mem ev_Si (⊥ : Ideal (Polynomial k₀)) i d (F.coeff d) hxi_ev
          (Finset.mem_filter.mp hd).2
      have hS'_ev : ev_Si (∑ d ∈ S', MvPolynomial.monomial d (F.coeff d)) = 0 := by
        rw [hsplitF, map_add, hS''_ev, add_zero] at hev_F0
        exact hev_F0
      have hmon_S' : ∀ d ∈ S',
          ev_Si (MvPolynomial.monomial d (F.coeff d)) =
            Polynomial.C (q_m (F.coeff d)) * Polynomial.X ^ d (1 - i) := by
        intro d hd
        have hdi : d i = 0 := (Finset.mem_filter.mp hd).2
        rw [hmon_eq]
        fin_cases i
        · change d 0 = 0 at hdi
          simp [ev_Si, hdi]
        · change d 1 = 0 at hdi
          simp [ev_Si, hdi]
      have hpoly0 : (∑ d ∈ S', Polynomial.C (q_m (F.coeff d)) * Polynomial.X ^ d (1 - i)) = 0 := by
        rw [← hS'_ev, map_sum]
        exact Finset.sum_congr rfl fun d hd => (hmon_S' d hd).symm
      have hS'_p : ψFa (∑ d ∈ S', MvPolynomial.monomial d (F.coeff d)) ∈ p.asIdeal := by
        rw [map_sum]
        refine Ideal.sum_mem p.asIdeal fun d₀ hd₀ => ?_
        have hcoeff0 :
            (∑ d ∈ S', Polynomial.C (q_m (F.coeff d)) * Polynomial.X ^ d (1 - i)).coeff
              (d₀ (1 - i)) = 0 := by
          rw [hpoly0, Polynomial.coeff_zero]
        rw [Polynomial.finsetSum_coeff, Finset.sum_eq_single d₀] at hcoeff0
        · rw [Polynomial.coeff_C_mul_X_pow] at hcoeff0
          simp only [↓reduceIte] at hcoeff0
          have hc_m : F.coeff d₀ ∈ m₀ := Ideal.Quotient.eq_zero_iff_mem.mp hcoeff0
          have hc_p : ψFa (MvPolynomial.C (F.coeff d₀)) ∈ p.asIdeal := hm_p hc_m
          rw [hmon_eq, map_mul]
          exact Ideal.mul_mem_right _ p.asIdeal hc_p
        · intro d hd hd_ne
          rw [Polynomial.coeff_C_mul_X_pow]
          split_ifs with heq
          · exfalso
            have hdi : d i = d₀ i :=
              (Finset.mem_filter.mp hd).2.trans (Finset.mem_filter.mp hd₀).2.symm
            fin_cases i
            · exact hd_ne (hfin2_ext hdi heq.symm)
            · exact hd_ne (hfin2_ext heq.symm hdi)
          · rfl
        · intro hnot
          exact absurd hd₀ hnot
      refine (hb_iff p.asIdeal).mpr ?_
      change ψFa F ∈ p.asIdeal
      rw [hsplitF, map_add]
      exact p.asIdeal.add_mem hS'_p hS''_p
    · let ε_pre := mkConstQuotHom a q_m hqa
      have hu_ε : IsUnit (ε_pre h) := by
        rw [hh_eq]
        change IsUnit (mkConstQuotHom a q_m hqa (Ideal.Quotient.mk (weilNodalIdeal R₀ a) P))
        rw [hmkConstQuotHom_mk a q_m hqa]
        exact isUnit_iff_ne_zero.mpr hqc0_ne
      let ε_loc : Localization.Away h →+* k₀ :=
        IsLocalization.Away.lift (S := Localization.Away h) h hu_ε
      have hε_mk : ∀ F : MvPolynomial (Fin 2) R₀,
          ε_loc (algebraMap (weilNodalQuot R₀ a) (Localization.Away h)
            (Ideal.Quotient.mk (weilNodalIdeal R₀ a) F)) = q_m (F.coeff 0) := by
        intro F
        exact (IsLocalization.Away.lift_eq (S := Localization.Away h) h hu_ε
          (Ideal.Quotient.mk (weilNodalIdeal R₀ a) F)).trans
          (hmkConstQuotHom_mk a q_m hqa F)
      have hε_R_pt : ∀ r : R₀, ε_loc (φ_Ra r) = q_m r := by
        intro r
        change ε_loc (algebraMap (weilNodalQuot R₀ a) (Localization.Away h)
          (Ideal.Quotient.mk (weilNodalIdeal R₀ a) (MvPolynomial.C r))) = q_m r
        rw [hε_mk, ← MvPolynomial.constantCoeff_eq, MvPolynomial.constantCoeff_C]
      have hε_surj : Function.Surjective ε_loc := by
        intro y
        obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective y
        exact ⟨φ_Ra r, hε_R_pt r⟩
      have hmax_ker : (RingHom.ker ε_loc).IsMaximal :=
        RingHom.ker_isMaximal_of_surjective ε_loc hε_surj
      let p_nod : PrimeSpectrum (Localization.Away h) := ⟨RingHom.ker ε_loc, hmax_ker.isPrime⟩
      have hpnod_m : (PrimeSpectrum.comap φ_Ra p_nod).asIdeal = m₀ := by
        ext r
        change ε_loc (φ_Ra r) = 0 ↔ r ∈ m₀
        rw [hε_R_pt r]
        exact Ideal.Quotient.eq_zero_iff_mem
      have hpnod_0 : x_coord 0 ∈ p_nod.asIdeal := by
        change ε_loc (x_coord 0) = 0
        dsimp only [x_coord]
        rw [hε_mk, ← MvPolynomial.constantCoeff_eq, MvPolynomial.constantCoeff_X, map_zero]
      have hpnod_1 : x_coord 1 ∈ p_nod.asIdeal := by
        change ε_loc (x_coord 1) = 0
        dsimp only [x_coord]
        rw [hε_mk, ← MvPolynomial.constantCoeff_eq, MvPolynomial.constantCoeff_X, map_zero]
      refine ⟨p_nod, ⟨hpnod_m, hpnod_0, hpnod_1⟩, ?_⟩
      rintro p ⟨hp_m, hp_0, hp_1⟩
      apply PrimeSpectrum.ext
      refine (hmax_ker.eq_of_le p.isPrime.ne_top ?_).symm
      intro z hz
      obtain ⟨b, hb_iff⟩ := hsurj_away h z
      obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective b
      have hF_ker : ε_loc (algebraMap (weilNodalQuot R₀ a) (Localization.Away h)
          (Ideal.Quotient.mk (weilNodalIdeal R₀ a) F)) = 0 :=
        (hb_iff p_nod.asIdeal).mp hz
      rw [hε_mk] at hF_ker
      have hc0_m : F.coeff 0 ∈ m₀ := Ideal.Quotient.eq_zero_iff_mem.mp hF_ker
      have hc0_p : φ_Ra (F.coeff 0) ∈ p.asIdeal := by
        change F.coeff 0 ∈ (PrimeSpectrum.comap φ_Ra p).asIdeal
        rwa [hp_m]
      let ψFa : MvPolynomial (Fin 2) R₀ →+* Localization.Away h :=
        (algebraMap (weilNodalQuot R₀ a) (Localization.Away h)).comp
          (Ideal.Quotient.mk (weilNodalIdeal R₀ a))
      have hψFa_C : ψFa (MvPolynomial.C (F.coeff 0)) = φ_Ra (F.coeff 0) := rfl
      have hsub := hsub_C_mem ψFa p.asIdeal hp_0 hp_1 F
      rw [hψFa_C] at hsub
      have hsum_p := p.asIdeal.add_mem hsub hc0_p
      rw [sub_add_cancel] at hsum_p
      exact (hb_iff p.asIdeal).mpr hsum_p
  
  obtain ⟨hqS0_fn, hp_nod0⟩ := hChartClosed π_tilde hπ_mem P_0 hP0_notMem h_0 hh_0_eq
  obtain ⟨hqS1_fn, hp_nod1⟩ := hChartClosed b' hb'_mem P_1 hP1_notMem h_1 hh_1_eq
  exact ⟨⟨hh0_notMem, hh1_notMem, hh01_shift⟩, hPart2,
    hPart3a, hqS0_fn 1, hqS1_fn 0, hp_nod0, hp_nod1⟩

theorem weil_local_chart_nodal_subdivision_blowup_package (K : Type u) [Field K] [IsSepClosed K]
    (m : ℕ) (R : ValuationSubring K) (hPkg_R : IsValuationRingAlgPackage m R)
    (hMax_R : IsLocalRing.maximalIdeal ↥R ≠ ⊥) :
    HasLocalNodalSubdivBlowup R :=
by
  classical
  
  
  have hFiberGlue :
      ∀ (π_tilde b' : ↥R)
        (hπ_mem : π_tilde ∈ IsLocalRing.maximalIdeal ↥R)
        (hb'_mem : b' ∈ IsLocalRing.maximalIdeal ↥R)
        (Q₀_R : PrimeSpectrum ↥R)
        (hπ_Q : π_tilde ∈ Q₀_R.asIdeal)
        (hb'_Q : b' ∈ Q₀_R.asIdeal)
        (hQ_le_mR : Q₀_R.asIdeal ≤ IsLocalRing.maximalIdeal ↥R)
        (B C_0 C_1 C_01 : Type u)
        [CommRing B] [CommRing C_0] [CommRing C_1] [CommRing C_01]
        [Algebra (Polynomial ↥R) C_01]
        (φ_RB : ↥R →+* B) (φ_R0 : ↥R →+* C_0) (φ_R1 : ↥R →+* C_1)
        (ψ_0 : B →+* C_0) (ψ_1 : B →+* C_1)
        (f₀₁ : C_0 →+* C_01) (f₁₀ : C_1 →+* C_01)
        (d_X : Fin 2 → B) (u_0 g_0 : C_0) (g_1 v_1 : C_1)
        (g_B : AlgebraicGeometry.Spec (CommRingCat.of B) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of ↥R))
        (U_bl : AlgebraicGeometry.Scheme.{u})
        (p_bl : U_bl ⟶ AlgebraicGeometry.Spec (CommRingCat.of B))
        (g_Ubl : U_bl ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
        (ι_0 : AlgebraicGeometry.Spec (CommRingCat.of C_0) ⟶ U_bl)
        (ι_1 : AlgebraicGeometry.Spec (CommRingCat.of C_1) ⟶ U_bl)
        (ρ_σ : B →+* (↥R ⧸ Q₀_R.asIdeal))
        (ρ_τ0 : C_0 →+* (↥R ⧸ Q₀_R.asIdeal))
        (ρ_τ1 : C_1 →+* (↥R ⧸ Q₀_R.asIdeal)),
        g_B = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_RB) →
        p_bl ≫ g_B = g_Ubl →
        (∀ r : ↥R, ψ_0 (φ_RB r) = φ_R0 r) →
        (∀ r : ↥R, ψ_1 (φ_RB r) = φ_R1 r) →
        ψ_0 (d_X 0) = u_0 →
        ψ_0 (d_X 1) = φ_R0 b' * g_0 →
        ψ_1 (d_X 0) = φ_R1 π_tilde * g_1 →
        ψ_1 (d_X 1) = v_1 →
        u_0 * g_0 = φ_R0 π_tilde →
        g_1 * v_1 = φ_R1 b' →
        (∀ r : ↥R, f₀₁ (φ_R0 r) = algebraMap (Polynomial ↥R) C_01 (Polynomial.C r)) →
        f₀₁ u_0 = algebraMap (Polynomial ↥R) C_01 (Polynomial.C π_tilde * Polynomial.X) →
        algebraMap (Polynomial ↥R) C_01 Polynomial.X * f₀₁ g_0 = 1 →
        @IsLocalization.Away C_0 _ g_0 C_01 _ f₀₁.toAlgebra →
        f₀₁.comp ψ_0 = f₁₀.comp ψ_1 →
        AlgebraicGeometry.IsOpenImmersion ι_0 →
        AlgebraicGeometry.IsOpenImmersion ι_1 →
        Set.range ι_0.base ∪ Set.range ι_1.base = Set.univ →
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₀₁) ≫ ι_0 =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₁₀) ≫ ι_1 →
        (∀ p₀ : PrimeSpectrum C_0, ι_0.base p₀ ∈ Set.range ι_1.base ↔ g_0 ∉ p₀.asIdeal) →
        (∀ p₁ : PrimeSpectrum C_1, ι_1.base p₁ ∈ Set.range ι_0.base ↔ g_1 ∉ p₁.asIdeal) →
        ι_0 ≫ p_bl = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_0) →
        ι_1 ≫ p_bl = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_1) →
        IsClosed (Set.range (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_σ)).base) →
        Function.Surjective ρ_σ →
        ρ_σ.comp φ_RB = Ideal.Quotient.mk Q₀_R.asIdeal →
        (∀ b_idx : Fin 2, ρ_σ (d_X b_idx) = 0) →
        (∀ (x : PrimeSpectrum B) (q : PrimeSpectrum (↥R ⧸ Q₀_R.asIdeal)),
          (PrimeSpectrum.comap φ_RB x = PrimeSpectrum.comap (Ideal.Quotient.mk Q₀_R.asIdeal) q ∧
            d_X 0 ∈ x.asIdeal ∧ d_X 1 ∈ x.asIdeal) ↔
          x = PrimeSpectrum.comap ρ_σ q) →
        ρ_τ0.comp ψ_0 = ρ_σ →
        ρ_τ1.comp ψ_1 = ρ_σ →
        (∀ q : PrimeSpectrum (↥R ⧸ Q₀_R.asIdeal), g_1 ∈ (PrimeSpectrum.comap ρ_τ1 q).asIdeal) →
        (∀ (Q : Ideal ↥R) [Q.IsPrime],
          π_tilde ∈ Q → b' ∈ Q →
          ∃ q_01 : PrimeSpectrum C_01,
            (PrimeSpectrum.comap φ_R0 (PrimeSpectrum.comap f₀₁ q_01)).asIdeal = Q ∧
            u_0 ∈ (PrimeSpectrum.comap f₀₁ q_01).asIdeal ∧
            (∀ p₀ : PrimeSpectrum C_0,
              u_0 ∈ p₀.asIdeal → Q ≤ (PrimeSpectrum.comap φ_R0 p₀).asIdeal →
              (PrimeSpectrum.comap f₀₁ q_01).asIdeal ≤ p₀.asIdeal) ∧
            (∀ p₁ : PrimeSpectrum C_1,
              v_1 ∈ p₁.asIdeal → Q ≤ (PrimeSpectrum.comap φ_R1 p₁).asIdeal →
              (PrimeSpectrum.comap f₁₀ q_01).asIdeal ≤ p₁.asIdeal)) →
        (∃ q_S0 : PrimeSpectrum C_0,
          (PrimeSpectrum.comap φ_R0 q_S0).asIdeal = IsLocalRing.maximalIdeal ↥R ∧
          g_0 ∈ q_S0.asIdeal ∧ u_0 ∉ q_S0.asIdeal ∧
          ∀ p₀ : PrimeSpectrum C_0,
            g_0 ∈ p₀.asIdeal →
            IsLocalRing.maximalIdeal ↥R ≤ (PrimeSpectrum.comap φ_R0 p₀).asIdeal →
            q_S0.asIdeal ≤ p₀.asIdeal) →
        (∃ q_S1 : PrimeSpectrum C_1,
          (PrimeSpectrum.comap φ_R1 q_S1).asIdeal = IsLocalRing.maximalIdeal ↥R ∧
          g_1 ∈ q_S1.asIdeal ∧ v_1 ∉ q_S1.asIdeal ∧
