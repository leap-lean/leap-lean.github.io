        · have hv_mR : (g'_M.base (U_compl.ι.base v)).asIdeal = IsLocalRing.maximalIdeal ↥R := by
            have h1 : (j_2 ≫ g_tilde).base v = (U_compl.ι ≫ g'_M).base v := by
