                  constructor
                  · intro h; exact hnot_pair ⟨hxp, Or.inl h⟩
                  · intro h; exact hnot_pair ⟨hxp, Or.inr h⟩
                change u ∈ j_1.base ⁻¹' (B_set (i_Z.succAbove y')) at hyy
                rw [hj1_succ_ne y' hyp.1 hyp.2] at hyy; exact hyy
              · rw [not_or] at hxp
                change u ∈ j_1.base ⁻¹' (B_set (i_Z.succAbove x')) at hyx
                rw [hj1_succ_ne x' hxp.1 hxp.2] at hyx; exact hyx
            · change v ∈ j_2.base ⁻¹' (B_set (i_Z.succAbove x')) at hyx
              change v ∈ j_2.base ⁻¹' (B_set (i_Z.succAbove y')) at hyy
              rw [hj2_succ] at hyx hyy
              obtain ⟨qx, hqx', hqx_eq⟩ := hyx
              obtain ⟨qy, hqy', hqy_eq⟩ := hyy
              have hq_eq : qx = qy := hInj_fst' (hqx_eq.trans hqy_eq.symm)
              rw [hq_eq] at hqx'
              have hqy_xy : qy = q_xy := hq_uniq qy ⟨hqx', hqy'⟩
              have hv_eq : v = u_xy := Subtype.ext (hqy_eq.symm.trans (congrArg fst'_R.base hqy_xy))
