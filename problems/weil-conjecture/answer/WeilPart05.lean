  · intro c' h M' M_tilde g'_M q_M Z hZ_cl j_2 ι_U η_tilde φ_U
      hc'_mR hh_not hOpen_j2 hj2_q hPre hOpen_U hιU_g hη_not_Z hφU_η hp₀_not_Z
    let mk := Ideal.Quotient.mk (weilNodalIdeal ↥R c')
    let c_A : ↥R →+* weilNodalQuot ↥R c' := mk.comp MvPolynomial.C
