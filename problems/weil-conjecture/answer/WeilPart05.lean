  let η_Γ : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ Γ := Δ.toImage
  let π₁ : Γ ⟶ Y₁ := ι_Γ ≫ fst₁₂
  let π₂ : Γ ⟶ Y₂ := ι_Γ ≫ snd₁₂
  have hDom_ηΓ : AlgebraicGeometry.IsDominant η_Γ :=
