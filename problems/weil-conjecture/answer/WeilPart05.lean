    let mk_c := Ideal.Quotient.mk (weilNodalIdeal ↥R c')
    let I_max : Ideal (weilNodalQuot ↥R c') :=
      Ideal.span {mk_c (MvPolynomial.X 0), mk_c (MvPolynomial.X 1)} ⊔
        Ideal.map (mk_c.comp MvPolynomial.C) m_R
    let ε00 : MvPolynomial (Fin 2) ↥R →+* k_R := MvPolynomial.eval₂Hom (algebraMap ↥R k_R) 0
    have hI_ker : ∀ f ∈ weilNodalIdeal ↥R c', ε00 f = 0 := by
      intro f hf
      refine RingHom.mem_ker.mp (Ideal.span_le.mpr ?_ hf)
      rw [Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
      have hc'0 : algebraMap ↥R k_R c' = 0 := Ideal.algebraMap_residueField_eq_zero.mpr hc'_mR
      simp [ε00, hc'0]
    let εbar : weilNodalQuot ↥R c' →+* k_R :=
      Ideal.Quotient.lift (weilNodalIdeal ↥R c') ε00 hI_ker
    have hh_ne0 : εbar h ≠ 0 := by
      intro hz
      apply hh_not
      obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective h
      have hF0 : F.coeff 0 ∈ m_R := by
        have hconst : ε00 = (algebraMap ↥R k_R).comp MvPolynomial.constantCoeff := by
          apply MvPolynomial.ringHom_ext'
          · ext r; simp [ε00]
          · intro b; simp [ε00]
        have h1 : ε00 F = 0 := hz
        rw [hconst] at h1
        exact Ideal.algebraMap_residueField_eq_zero.mp h1
      rw [F.as_sum, map_sum]
