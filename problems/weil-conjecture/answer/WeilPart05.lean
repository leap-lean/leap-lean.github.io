    have _ : AlgebraicGeometry.IsClosedImmersion σ_x :=
      AlgebraicGeometry.IsClosedImmersion.of_comp σ_x g_X
    have hbot_prime_RQ : (⊥ : Ideal (↥R ⧸ Q.asIdeal)).IsPrime := by
      rw [Ideal.isPrime_iff]
      refine ⟨bot_ne_top, fun {a b} hab => ?_⟩
      rw [Ideal.mem_bot] at hab ⊢
      rw [Ideal.mem_bot]
      exact mul_eq_zero.mp hab
    let q_bot : ↥(AlgebraicGeometry.Spec (CommRingCat.of (↥R ⧸ Q.asIdeal))) := ⟨⊥, hbot_prime_RQ⟩
    have hσ_bot : σ_x.base q_bot = x := by
      have hmap_bot :
