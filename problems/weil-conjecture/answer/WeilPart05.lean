      (∀ (a₀ c_e r_0 : ↥R) (h_e : weilNodalQuot ↥R a₀)
         (ι_e : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away h_e)) ⟶ M')
         (φ_e : Localization.Away h_e →+* F_0)
         (p_max : PrimeSpectrum (Localization.Away h_e)),
        a_opt = some a₀ →
        c_e - 0 = r_0 * a₀ →
        h_e ∉ Ideal.span {Ideal.Quotient.mk (weilNodalIdeal ↥R a₀) (MvPolynomial.X 0),
