        fun P Q => ev0 P + MvPolynomial.X 1 * ev1 Q
      have hgen_I : MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a₀ ∈ I_a0 :=
        Ideal.subset_span rfl
      have hNF : ∀ G : MvPolynomial (Fin 2) ↥R,
          ∃ P Q : Polynomial ↥R, G - nf P Q ∈ I_a0 := by
        intro G
        induction G using MvPolynomial.induction_on with
        | C r =>
          refine ⟨Polynomial.C r, 0, ?_⟩
          simp [nf, ev0, ev1]
        | add G₁ G₂ ih₁ ih₂ =>
          rcases ih₁ with ⟨P₁, Q₁, h₁⟩
          rcases ih₂ with ⟨P₂, Q₂, h₂⟩
          refine ⟨P₁ + P₂, Q₁ + Q₂, ?_⟩
          have heq : (G₁ + G₂) - nf (P₁ + P₂) (Q₁ + Q₂) =
              (G₁ - nf P₁ Q₁) + (G₂ - nf P₂ Q₂) := by
            simp only [nf, map_add]; ring
          rw [heq]
          exact I_a0.add_mem h₁ h₂
        | mul_X G' i ih =>
          rcases ih with ⟨P, Q, hG'⟩
          have hstep1 : G' * MvPolynomial.X i - nf P Q * MvPolynomial.X i ∈ I_a0 := by
            have heq : G' * MvPolynomial.X i - nf P Q * MvPolynomial.X i =
                (G' - nf P Q) * MvPolynomial.X i := by ring
            rw [heq]
            exact I_a0.mul_mem_right (MvPolynomial.X i) hG'
          have hev0_X : ev0 Polynomial.X = MvPolynomial.X 0 :=
            Polynomial.eval₂_X MvPolynomial.C (MvPolynomial.X 0)
          have hev0_C : ∀ r : ↥R, ev0 (Polynomial.C r) = MvPolynomial.C r :=
            fun r => Polynomial.eval₂_C MvPolynomial.C (MvPolynomial.X 0)
          have hev1_X : ev1 Polynomial.X = MvPolynomial.X 1 :=
            Polynomial.eval₂_X MvPolynomial.C (MvPolynomial.X 1)
          have hev1_C : ∀ r : ↥R, ev1 (Polynomial.C r) = MvPolynomial.C r :=
            fun r => Polynomial.eval₂_C MvPolynomial.C (MvPolynomial.X 1)
          have hi : i = 0 ∨ i = 1 := by fin_cases i <;> simp
          rcases hi with rfl | rfl
          · refine ⟨P * Polynomial.X + Polynomial.C (a₀ * Q.coeff 0),
              Polynomial.C a₀ * Q.divX, ?_⟩
            have hQ_decomp : ev1 Q =
                MvPolynomial.X 1 * ev1 Q.divX + MvPolynomial.C (Q.coeff 0) := by
              conv_lhs => rw [← Polynomial.X_mul_divX_add Q]
              rw [map_add, map_mul, hev1_X, hev1_C]
            have hstep2 : nf P Q * MvPolynomial.X 0 -
                nf (P * Polynomial.X + Polynomial.C (a₀ * Q.coeff 0))
                  (Polynomial.C a₀ * Q.divX) =
                (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a₀) * ev1 Q := by
              dsimp only [nf]
              rw [map_add, map_mul ev0 P, map_mul ev1, hev0_X, hev0_C, hev1_C,
                map_mul MvPolynomial.C, hQ_decomp]
              ring
            have hsum : G' * MvPolynomial.X 0 -
                nf (P * Polynomial.X + Polynomial.C (a₀ * Q.coeff 0))
                  (Polynomial.C a₀ * Q.divX) =
                (G' * MvPolynomial.X 0 - nf P Q * MvPolynomial.X 0) +
                (nf P Q * MvPolynomial.X 0 -
                  nf (P * Polynomial.X + Polynomial.C (a₀ * Q.coeff 0))
                    (Polynomial.C a₀ * Q.divX)) := by ring
            rw [hsum, hstep2]
            exact I_a0.add_mem hstep1 (I_a0.mul_mem_right _ hgen_I)
          · refine ⟨Polynomial.C a₀ * P.divX,
              Polynomial.C (P.coeff 0) + Polynomial.X * Q, ?_⟩
            have hP_decomp : ev0 P =
                MvPolynomial.X 0 * ev0 P.divX + MvPolynomial.C (P.coeff 0) := by
              conv_lhs => rw [← Polynomial.X_mul_divX_add P]
              rw [map_add, map_mul, hev0_X, hev0_C]
            have hstep2 : nf P Q * MvPolynomial.X 1 -
                nf (Polynomial.C a₀ * P.divX)
                  (Polynomial.C (P.coeff 0) + Polynomial.X * Q) =
                (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a₀) * ev0 P.divX := by
              dsimp only [nf]
              rw [map_add, map_mul, map_mul, hev0_C, hev1_C, hev1_X, hP_decomp]
              ring
            have hsum : G' * MvPolynomial.X 1 -
                nf (Polynomial.C a₀ * P.divX)
                  (Polynomial.C (P.coeff 0) + Polynomial.X * Q) =
                (G' * MvPolynomial.X 1 - nf P Q * MvPolynomial.X 1) +
                (nf P Q * MvPolynomial.X 1 -
                  nf (Polynomial.C a₀ * P.divX)
                    (Polynomial.C (P.coeff 0) + Polynomial.X * Q)) := by ring
            rw [hsum, hstep2]
            exact I_a0.add_mem hstep1 (I_a0.mul_mem_right _ hgen_I)
      have hψ_ev0 : ψ_raw.comp ev0 =
          (algebraMap (Polynomial K) F_0).comp (Polynomial.mapRingHom R.subtype) := by
        apply Polynomial.ringHom_ext'
        · ext r
          simp [ψ_raw, ev0, φ_KF0]
        · simp [ψ_raw, ev0, T_0]
      have hInj_ψ : Function.Injective ψ := by
        rw [RingHom.injective_iff_ker_eq_bot, Submodule.eq_bot_iff]
        intro x hx
        obtain ⟨G, rfl⟩ := Ideal.Quotient.mk_surjective x
        rw [Ideal.Quotient.eq_zero_iff_mem]
        obtain ⟨P, Q, hPQ⟩ := hNF G
        have hψ_nf : ψ_raw (nf P Q) = 0 := by
          have h1 : ψ_raw G = 0 := hx
          have h2 : ψ_raw (G - nf P Q) = 0 := hψ_ker_le _ hPQ
          rw [map_sub, h1, zero_sub, neg_eq_zero] at h2
          exact h2
        let N := Q.natDegree
        let P_K : Polynomial K := Polynomial.map R.subtype P
        let R_low : Polynomial K :=
          ∑ k ∈ Finset.range (N + 1),
            Polynomial.monomial (N - k) (R.subtype (Q.coeff k * a₀ ^ (k + 1)))
        have hQ_eval : T_0 ^ (N + 1) * ψ_raw (MvPolynomial.X 1 * ev1 Q) =
            algebraMap (Polynomial K) F_0 R_low := by
          have hQ_sum : Q = ∑ k ∈ Finset.range (N + 1), Polynomial.monomial k (Q.coeff k) :=
            Polynomial.as_sum_range Q
          conv_lhs => rw [hQ_sum]
          rw [map_sum, Finset.mul_sum, map_sum, Finset.mul_sum, map_sum]
          refine Finset.sum_congr rfl fun k hk => ?_
          have hk_le : k ≤ N := Nat.lt_succ_iff.mp (Finset.mem_range.mp hk)
          have hmon : ev1 (Polynomial.monomial k (Q.coeff k)) =
              MvPolynomial.C (Q.coeff k) * (MvPolynomial.X 1) ^ k := by
            simp [ev1, Polynomial.eval₂_monomial]
          rw [hmon]
          have hval : ψ_raw (MvPolynomial.X 1 *
              (MvPolynomial.C (Q.coeff k) * (MvPolynomial.X 1) ^ k)) =
              φ_KF0 (R.subtype (Q.coeff k * a₀ ^ (k + 1))) * (T_0⁻¹) ^ (k + 1) := by
            have ha_hom : φ_KF0 (R.subtype (Q.coeff k * a₀ ^ (k + 1))) =
                φ_KF0 (R.subtype (Q.coeff k)) * φ_KF0 (R.subtype a₀) ^ (k + 1) := by
              rw [map_mul, map_pow, map_mul, map_pow]
            rw [ha_hom]
            simp only [ψ_raw, map_mul, map_pow, MvPolynomial.eval₂Hom_X',
              MvPolynomial.eval₂Hom_C, Matrix.cons_val_one, Matrix.cons_val_zero,
              RingHom.comp_apply]
            ring
          rw [hval]
          have hpow : T_0 ^ (N + 1) *
              (φ_KF0 (R.subtype (Q.coeff k * a₀ ^ (k + 1))) * (T_0⁻¹) ^ (k + 1)) =
              φ_KF0 (R.subtype (Q.coeff k * a₀ ^ (k + 1))) * T_0 ^ (N - k) := by
            have hN : N + 1 = (N - k) + (k + 1) := by omega
            rw [hN, pow_add]
            have hcancel : T_0 ^ (k + 1) * (T_0⁻¹) ^ (k + 1) = 1 := by
              rw [← mul_pow, mul_inv_cancel₀ hT0_ne, one_pow]
            calc T_0 ^ (N - k) * T_0 ^ (k + 1) *
                  (φ_KF0 (R.subtype (Q.coeff k * a₀ ^ (k + 1))) * (T_0⁻¹) ^ (k + 1))
                = φ_KF0 (R.subtype (Q.coeff k * a₀ ^ (k + 1))) * T_0 ^ (N - k) *
                    (T_0 ^ (k + 1) * (T_0⁻¹) ^ (k + 1)) := by ring
              _ = φ_KF0 (R.subtype (Q.coeff k * a₀ ^ (k + 1))) * T_0 ^ (N - k) := by
                    rw [hcancel, mul_one]
          rw [hpow, ← Polynomial.C_mul_X_pow_eq_monomial,
            map_mul (algebraMap (Polynomial K) F_0),
            map_pow (algebraMap (Polynomial K) F_0)]
          rfl
        have hPoly_zero : Polynomial.X ^ (N + 1) * P_K + R_low = 0 := by
          apply hInj_PK_F0
          rw [map_zero, map_add, map_mul, map_pow, ← hQ_eval]
          have hP_eval : algebraMap (Polynomial K) F_0 P_K = ψ_raw (ev0 P) :=
            (RingHom.congr_fun hψ_ev0 P).symm
          change T_0 ^ (N + 1) * algebraMap (Polynomial K) F_0 P_K +
            T_0 ^ (N + 1) * ψ_raw (MvPolynomial.X 1 * ev1 Q) = 0
          rw [hP_eval, ← mul_add, ← map_add ψ_raw]
          change T_0 ^ (N + 1) * ψ_raw (nf P Q) = 0
          rw [hψ_nf, mul_zero]
        have hRlow_coeff : ∀ m < N + 1, R_low.coeff m = 0 := by
          intro m hm
          have hc := congrArg (fun p : Polynomial K => p.coeff m) hPoly_zero
          simp only [Polynomial.coeff_add, Polynomial.coeff_zero,
            Polynomial.coeff_X_pow_mul', show ¬ (N + 1 ≤ m) by omega, ↓reduceIte,
            zero_add] at hc
          exact hc
        have hRlow_zero : R_low = 0 := by
          apply Polynomial.ext
          intro m
          rw [Polynomial.coeff_zero]
          by_cases hm : m < N + 1
          · exact hRlow_coeff m hm
          · simp only [R_low, Polynomial.finsetSum_coeff]
            refine Finset.sum_eq_zero fun k hk => ?_
            rw [Polynomial.coeff_monomial]
            have : N - k ≠ m := by omega
            simp [this]
        have hP_zero : P = 0 := by
          rw [hRlow_zero, add_zero] at hPoly_zero
          have hPK0 : P_K = 0 :=
            (mul_eq_zero.mp hPoly_zero).resolve_left (pow_ne_zero _ Polynomial.X_ne_zero)
          exact Polynomial.map_injective R.subtype Subtype.val_injective
            (hPK0.trans (Polynomial.map_zero R.subtype).symm)
        have hQ_zero : Q = 0 := by
          apply Polynomial.ext
          intro k
          rw [Polynomial.coeff_zero]
          by_cases hk : k ≤ N
          · have hc0 := hRlow_coeff (N - k) (by omega)
            simp only [R_low, Polynomial.finsetSum_coeff] at hc0
            rw [Finset.sum_eq_single k] at hc0
            · rw [Polynomial.coeff_monomial, ite_eq_left_iff.mpr (fun h => absurd rfl h)] at hc0
              have hmul0 : Q.coeff k * a₀ ^ (k + 1) = 0 :=
                Subtype.val_injective (hc0.trans R.subtype.map_zero.symm)
              exact (mul_eq_zero.mp hmul0).resolve_right (pow_ne_zero _ ha₀_ne)
            · intro j hj hjk
              have hj_le : j ≤ N := Nat.lt_succ_iff.mp (Finset.mem_range.mp hj)
              rw [Polynomial.coeff_monomial]
              have : N - j ≠ N - k := by omega
              simp [this]
            · intro hnot
              exact absurd (Finset.mem_range.mpr (Nat.lt_succ_of_le hk)) hnot
          · exact Polynomial.coeff_eq_zero_of_natDegree_lt (Nat.lt_of_not_ge hk)
        rw [hP_zero, hQ_zero] at hPQ
        simpa [nf, ev0, ev1] using hPQ
      let ε_raw : MvPolynomial (Fin 2) ↥R →+* k_R :=
        MvPolynomial.eval₂Hom (algebraMap ↥R k_R) 0
      have hε_ker_le : ∀ f ∈ I_a0, ε_raw f = 0 := by
        intro f hf
        rw [← RingHom.mem_ker]
        refine Ideal.span_le.mpr ?_ hf
        rintro _ rfl
        have ha₀_k : algebraMap ↥R k_R a₀ = 0 := by
          rwa [← RingHom.mem_ker, Ideal.ker_algebraMap_residueField]
        simp [ε_raw, ha₀_k]
      let ε : A_0 →+* k_R := Ideal.Quotient.lift I_a0 ε_raw hε_ker_le
      have h_mod_m₀ : ∀ G : MvPolynomial (Fin 2) ↥R,
          Ideal.Quotient.mk I_a0 G -
            Ideal.Quotient.mk I_a0 (MvPolynomial.C (MvPolynomial.constantCoeff G)) ∈
            m₀.asIdeal ∧
          ε_raw G = algebraMap ↥R k_R (MvPolynomial.constantCoeff G) := by
        intro G
        induction G using MvPolynomial.induction_on with
        | C r =>
          simp [ε_raw]
        | add p q ihp ihq =>
          rcases ihp with ⟨hp1, hp2⟩
          rcases ihq with ⟨hq1, hq2⟩
          refine ⟨?_, ?_⟩
          · rw [map_add, map_add, map_add, map_add]
            have heq : Ideal.Quotient.mk I_a0 p + Ideal.Quotient.mk I_a0 q -
                (Ideal.Quotient.mk I_a0 (MvPolynomial.C (MvPolynomial.constantCoeff p)) +
                 Ideal.Quotient.mk I_a0 (MvPolynomial.C (MvPolynomial.constantCoeff q))) =
                (Ideal.Quotient.mk I_a0 p -
                  Ideal.Quotient.mk I_a0 (MvPolynomial.C (MvPolynomial.constantCoeff p))) +
                (Ideal.Quotient.mk I_a0 q -
                  Ideal.Quotient.mk I_a0 (MvPolynomial.C (MvPolynomial.constantCoeff q))) := by
              ring
            rw [heq]
            exact m₀.asIdeal.add_mem hp1 hq1
          · rw [map_add, map_add, map_add, hp2, hq2]
        | mul_X p i _ =>
          have hc0 : MvPolynomial.constantCoeff (p * MvPolynomial.X i) = 0 := by
            rw [map_mul, MvPolynomial.constantCoeff_X, mul_zero]
          rw [hc0, map_zero, map_zero, sub_zero, map_zero]
          refine ⟨?_, ?_⟩
          · rw [map_mul]
            exact m₀.asIdeal.mul_mem_left _ (hX_m₀ i)
          · simp [ε_raw]
      have hker_le : RingHom.ker ε ≤ m₀.asIdeal := by
        intro x hx
        obtain ⟨G, rfl⟩ := Ideal.Quotient.mk_surjective x
        obtain ⟨hsub, hev⟩ := h_mod_m₀ G
        have hr_mem : MvPolynomial.constantCoeff G ∈ IsLocalRing.maximalIdeal ↥R := by
          rw [← Ideal.ker_algebraMap_residueField (IsLocalRing.maximalIdeal ↥R)]
          exact hev.symm.trans hx
        have hC_mem : Ideal.Quotient.mk I_a0
            (MvPolynomial.C (MvPolynomial.constantCoeff G)) ∈ m₀.asIdeal :=
          hC_m₀ _ hr_mem
        simpa using m₀.asIdeal.add_mem hsub hC_mem
      refine ⟨some a₀, A_0, inferInstance, C_A0, ev0_A, m₀, e₀, ψ, ε,
        hInj_ψ, RingHom.ext fun r => by
          change Ideal.Quotient.lift I_a0 ψ_raw hψ_ker_le
            (Ideal.Quotient.mk I_a0 (MvPolynomial.C r)) = φ_KF0 (R.subtype r)
          rw [Ideal.Quotient.lift_mk]
          exact MvPolynomial.eval₂Hom_C _ _ r,
        hψ_ev0, RingHom.ext fun r => by
          change Ideal.Quotient.lift I_a0 ε_raw hε_ker_le
            (Ideal.Quotient.mk I_a0 (MvPolynomial.C r)) = algebraMap ↥R k_R r
          rw [Ideal.Quotient.lift_mk]
          exact MvPolynomial.eval₂Hom_C _ _ r, hker_le,
        hEt_e₀, he₀_comm, he₀_m₀, he₀_Zmod,
        Or.inr ⟨a₀, CategoryTheory.Iso.refl _, CommRingCat.ofHom ψ,
          rfl, ha₀_ne, ha₀_mem, CategoryTheory.Category.id_comp _, hX_m₀, hC_m₀,
          CategoryTheory.Category.comp_id _, by
            change Ideal.Quotient.lift I_a0 ψ_raw hψ_ker_le
              (Ideal.Quotient.mk I_a0 (MvPolynomial.X 0)) = T_0
            rw [Ideal.Quotient.lift_mk]
            simp [ψ_raw]⟩⟩

  obtain ⟨a_opt, A_0, instCommA0, C_A0, ev0_A, m_0, e_0, ψ, ε,
      hInj_ψ, hψ_C, hψ_ev0, hε_C, hker_ε_le, hEt_e0, he0_comm, he0_m0, he0_Zmod,
      hStd_branch⟩ := hRoofPkg
  letI : CommRing A_0 := instCommA0
  haveI : IsDomain A_0 := Function.Injective.isDomain ψ hInj_ψ
  let M_0 : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of A_0)
  let g_M0 : M_0 ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom C_A0)
  let η_M0 : AlgebraicGeometry.Spec (CommRingCat.of F_0) ⟶ M_0 :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)

  
  have hFrac_A0 : @IsFractionRing A_0 _ F_0 _ ψ.toAlgebra := by
    letI : Algebra A_0 F_0 := ψ.toAlgebra
    refine { map_units := ?_, surj := ?_, exists_of_eq := ?_ }
    · intro y
      have hy0 : (y : A_0) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp y.2
      have hψy : ψ y ≠ 0 := fun h => hy0 (hInj_ψ (h.trans (map_zero ψ).symm))
      exact IsUnit.mk0 (ψ y) hψy
    · intro z
      obtain ⟨⟨P, Q⟩, hz⟩ := IsLocalization.surj (nonZeroDivisors (Polynomial K)) z
      have hQ0 : (Q : Polynomial K) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp Q.2
      obtain ⟨d_P, P_R, hdP, hPR⟩ := hClearPoly P
      obtain ⟨d_Q, Q_R, hdQ, hQR⟩ := hClearPoly Q.1
      let num : A_0 := ev0_A (Polynomial.C d_Q * P_R)
      let den : A_0 := ev0_A (Polynomial.C d_P * Q_R)
      have hψ_num : ψ num = algebraMap (Polynomial K) F_0
          (Polynomial.C (R.subtype d_Q) * Polynomial.C (R.subtype d_P) * P) := by
        change (ψ.comp ev0_A) (Polynomial.C d_Q * P_R) = _
        rw [hψ_ev0]
        simp only [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_mul,
          Polynomial.map_C, hPR, mul_assoc]
      have hψ_den : ψ den = algebraMap (Polynomial K) F_0
          (Polynomial.C (R.subtype d_P) * Polynomial.C (R.subtype d_Q) * Q.1) := by
        change (ψ.comp ev0_A) (Polynomial.C d_P * Q_R) = _
        rw [hψ_ev0]
        simp only [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_mul,
          Polynomial.map_C, hQR, mul_assoc]
      have hden_ne : den ≠ 0 := by
        intro h0
        have hdP_K : Polynomial.C (R.subtype d_P) ≠ (0 : Polynomial K) := by
          simp only [ne_eq, Polynomial.C_eq_zero]
          exact fun h => hdP (Subtype.ext h)
        have hdQ_K : Polynomial.C (R.subtype d_Q) ≠ (0 : Polynomial K) := by
          simp only [ne_eq, Polynomial.C_eq_zero]
          exact fun h => hdQ (Subtype.ext h)
        have hprod_ne : Polynomial.C (R.subtype d_P) * Polynomial.C (R.subtype d_Q) * Q.1 ≠ 0 :=
          mul_ne_zero (mul_ne_zero hdP_K hdQ_K) hQ0
        apply hprod_ne
        apply hInj_PK_F0
        rw [map_zero, ← hψ_den, h0, map_zero]
      refine ⟨⟨num, ⟨den, mem_nonZeroDivisors_iff_ne_zero.mpr hden_ne⟩⟩, ?_⟩
      change z * ψ den = ψ num
      rw [hψ_den, hψ_num]
      simp only [map_mul]
      calc z * (algebraMap (Polynomial K) F_0 (Polynomial.C (R.subtype d_P)) *
              algebraMap (Polynomial K) F_0 (Polynomial.C (R.subtype d_Q)) *
              algebraMap (Polynomial K) F_0 Q.1)
          = algebraMap (Polynomial K) F_0 (Polynomial.C (R.subtype d_Q)) *
              algebraMap (Polynomial K) F_0 (Polynomial.C (R.subtype d_P)) *
              (z * algebraMap (Polynomial K) F_0 Q.1) := by ring
        _ = algebraMap (Polynomial K) F_0 (Polynomial.C (R.subtype d_Q)) *
              algebraMap (Polynomial K) F_0 (Polynomial.C (R.subtype d_P)) *
              algebraMap (Polynomial K) F_0 P := by rw [hz]
    · intro x y hxy
      exact ⟨1, by simp [hInj_ψ hxy]⟩

  
  have hFunc_M0 : IsSchemeFunctionField M_0 F_0 η_M0 := by
    let h_top_M0 : AlgebraicGeometry.IsAffineOpen (⊤ : M_0.Opens) :=
      AlgebraicGeometry.isAffineOpen_top M_0
    have h_top_M0_ne : Nonempty ↥(⊤ : M_0.Opens) := ⟨⟨m_0, trivial⟩⟩
    let isoΓ := AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A_0)
    let φ_0 : M_0.presheaf.obj (Opposite.op ⊤) ⟶ CommRingCat.of F_0 :=
      isoΓ.hom ≫ CommRingCat.ofHom ψ
    have hFrac_M0_top :
        @IsFractionRing ↑(M_0.presheaf.obj (Opposite.op ⊤)) _ F_0 _ φ_0.hom.toAlgebra :=
      isFractionRing_of_bijective isoΓ.hom.hom
        (ConcreteCategory.bijective_of_isIso isoΓ.hom) ψ hFrac_A0
    have hη_M0_top : AlgebraicGeometry.Spec.map φ_0 ≫ h_top_M0.fromSpec = η_M0 := by
      have h_id : AlgebraicGeometry.Spec.map isoΓ.hom ≫ h_top_M0.fromSpec = 𝟙 M_0 := by
        rw [AlgebraicGeometry.IsAffineOpen.fromSpec_top, AlgebraicGeometry.Scheme.isoSpec_Spec]
