        exact ⟨z, congrArg ι_1.base hz⟩
    let e_src := AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq f_top U_Du.ι hrng_top
    let e_dst := AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq f_bot D_u.ι hrng_bot
    have heq_hom : p_bl ∣_ D_u = e_src.inv ≫ e_dst.hom := by
      apply (CategoryTheory.cancel_epi e_src.hom).mp
      apply (CategoryTheory.cancel_mono D_u.ι).mp
      rw [CategoryTheory.Iso.hom_inv_id_assoc,
        CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
        ← CategoryTheory.Category.assoc,
        AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac,
        AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac, hftop_p]
    rw [heq_hom]; infer_instance

  
  let R_Q := ↥R ⧸ Q₀_R.asIdeal
  have _ : Q₀_R.asIdeal.IsPrime := Q₀_R.isPrime
  let _ : IsDomain R_Q := Ideal.Quotient.isDomain Q₀_R.asIdeal
  let mk_Q : ↥R →+* R_Q := Ideal.Quotient.mk Q₀_R.asIdeal
  have hmkQ_π : mk_Q π_tilde = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hπ_Q0
  let ρ_σ0 : Polynomial ↥R →+* R_Q := Polynomial.eval₂RingHom mk_Q (mk_Q c_tilde)
  have hρσ0_hp : ρ_σ0 h_p = mk_Q (Polynomial.eval c_tilde h_p) := by
    change Polynomial.eval₂ mk_Q (mk_Q c_tilde) h_p =
      mk_Q (Polynomial.eval₂ (RingHom.id ↥R) c_tilde h_p)
    rw [Polynomial.hom_eval₂]; rfl
  have hρσ0_unit : IsUnit (ρ_σ0 h_p) := hρσ0_hp ▸ RingHom.isUnit_map mk_Q hh_p_unit
  let ρ_σ : B →+* R_Q := IsLocalization.Away.lift h_p hρσ0_unit
  have hρσ_eq : ∀ P : Polynomial ↥R, ρ_σ (algebraMap (Polynomial ↥R) B P) = ρ_σ0 P :=
    fun P => IsLocalization.Away.lift_eq h_p hρσ0_unit P
  have hρσ_C : ∀ r : ↥R, ρ_σ (algebraMap (Polynomial ↥R) B (Polynomial.C r)) = mk_Q r := by
    intro r; rw [hρσ_eq]; simp [ρ_σ0]
  have hρσ_X : ρ_σ (algebraMap (Polynomial ↥R) B Polynomial.X) = mk_Q c_tilde := by
    rw [hρσ_eq]; simp [ρ_σ0]
  have hρσ_uB : ρ_σ u_B = 0 := by
    dsimp only [u_B]; rw [map_sub, map_sub, hρσ_X, hρσ_C, sub_self]
  have hρσ_πB : ρ_σ π_B = 0 := by
    dsimp only [π_B]; rw [hρσ_C, hmkQ_π]
  have hSurj_ρσ : Function.Surjective ρ_σ := by
    intro y
    obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective y
    exact ⟨algebraMap (Polynomial ↥R) B (Polynomial.C r), hρσ_C r⟩

  let ρ_τ0_poly : Polynomial ↥R →+* R_Q := Polynomial.eval₂RingHom mk_Q 0
  have hρτ0_h0 : ρ_τ0_poly h_0 = mk_Q (Polynomial.eval 0 h_0) := by
    change Polynomial.eval₂ mk_Q (mk_Q 0) h_0 = mk_Q (Polynomial.eval₂ (RingHom.id ↥R) 0 h_0)
    rw [Polynomial.hom_eval₂]; rfl
  have hρτ0_unit : IsUnit (ρ_τ0_poly h_0) :=
    hρτ0_h0 ▸ RingHom.isUnit_map mk_Q (IsLocalRing.notMem_maximalIdeal.mp (hh0_eval 0))
  let ρ_τ0 : C_0 →+* R_Q := IsLocalization.Away.lift h_0 hρτ0_unit
  have hρτ0_eq : ∀ P : Polynomial ↥R, ρ_τ0 (algebraMap (Polynomial ↥R) C_0 P) = ρ_τ0_poly P :=
    fun P => IsLocalization.Away.lift_eq h_0 hρτ0_unit P
  have hρτ0_comp : ρ_τ0.comp ψ_0 = ρ_σ := by
    apply IsLocalization.ringHom_ext (Submonoid.powers h_p)
    apply Polynomial.ringHom_ext
    · intro r
      change ρ_τ0 (ψ_0 (algebraMap (Polynomial ↥R) B (Polynomial.C r))) =
        ρ_σ (algebraMap (Polynomial ↥R) B (Polynomial.C r))
      rw [hψ0_C r, hρτ0_eq, hρσ_C r]; simp [ρ_τ0_poly]
    · change ρ_τ0 (ψ_0 (algebraMap (Polynomial ↥R) B Polynomial.X)) =
        ρ_σ (algebraMap (Polynomial ↥R) B Polynomial.X)
      rw [hψ0_X, hρτ0_eq, hρσ_X]; simp [ρ_τ0_poly, hmkQ_π]

  let ρ_τ1_mv : MvPolynomial (Fin 2) ↥R →+* R_Q := MvPolynomial.eval₂Hom mk_Q 0
  have hρτ1_ker : I_nod ≤ RingHom.ker ρ_τ1_mv := by
    rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
    simp [ρ_τ1_mv, hmkQ_π]
  let ρ_τ1_bar : A_nod →+* R_Q := Ideal.Quotient.lift I_nod ρ_τ1_mv hρτ1_ker
  have hρτ1_h1 : ρ_τ1_bar h_1 = mk_Q (Polynomial.eval c_tilde h_p) := by
    rw [hh1_def]
    change ρ_τ1_mv (Polynomial.eval₂ MvPolynomial.C (MvPolynomial.C c_tilde + MvPolynomial.X 0) h_p) =
      mk_Q (Polynomial.eval₂ (RingHom.id ↥R) c_tilde h_p)
    rw [Polynomial.hom_eval₂, Polynomial.hom_eval₂]
    have hc : ρ_τ1_mv.comp MvPolynomial.C = mk_Q.comp (RingHom.id ↥R) := by ext r; simp [ρ_τ1_mv]
    have hx : ρ_τ1_mv (MvPolynomial.C c_tilde + MvPolynomial.X 0) = mk_Q c_tilde := by simp [ρ_τ1_mv]
    rw [hc, hx]
  have hρτ1_unit : IsUnit (ρ_τ1_bar h_1) := hρτ1_h1 ▸ RingHom.isUnit_map mk_Q hh_p_unit
  let ρ_τ1 : C_1 →+* R_Q := IsLocalization.Away.lift h_1 hρτ1_unit
  have hρτ1_eq : ∀ y : A_nod, ρ_τ1 (algebraMap A_nod C_1 y) = ρ_τ1_bar y :=
    fun y => IsLocalization.Away.lift_eq h_1 hρτ1_unit y
  have hρτ1_s1 : ρ_τ1 s_1 = 0 := by
    dsimp only [s_1]
    rw [hρτ1_eq]
    exact (Ideal.Quotient.lift_mk I_nod ρ_τ1_mv hρτ1_ker).trans (by simp [ρ_τ1_mv])
  have hρτ1_comp : ρ_τ1.comp ψ_1 = ρ_σ := by
    apply IsLocalization.ringHom_ext (Submonoid.powers h_p)
    apply Polynomial.ringHom_ext
    · intro r
      change ρ_τ1 (ψ_1 (algebraMap (Polynomial ↥R) B (Polynomial.C r))) =
        ρ_σ (algebraMap (Polynomial ↥R) B (Polynomial.C r))
      rw [hψ1_C r, hρτ1_eq, hρσ_C r]
      exact (Ideal.Quotient.lift_mk I_nod ρ_τ1_mv hρτ1_ker).trans (by simp [ρ_τ1_mv])
    · change ρ_τ1 (ψ_1 (algebraMap (Polynomial ↥R) B Polynomial.X)) =
        ρ_σ (algebraMap (Polynomial ↥R) B Polynomial.X)
      rw [hψ1_X, hρτ1_eq, hρσ_X]
      exact (Ideal.Quotient.lift_mk I_nod ρ_τ1_mv hρτ1_ker).trans (by simp [ρ_τ1_mv])

  let σ_loc : AlgebraicGeometry.Spec (CommRingCat.of R_Q) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of B) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_σ)
  let τ₀_loc : AlgebraicGeometry.Spec (CommRingCat.of R_Q) ⟶ U_bl :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_τ0) ≫ ι_0
  let τ₁_loc : AlgebraicGeometry.Spec (CommRingCat.of R_Q) ⟶ U_bl :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_τ1) ≫ ι_1

  have hσ_gB : σ_loc ≫ g_B = AlgebraicGeometry.Spec.map (CommRingCat.ofHom mk_Q) := by
    dsimp only [σ_loc, g_B]
    rw [← AlgebraicGeometry.Spec.map_comp]
    congr 1; apply CommRingCat.hom_ext; ext r; exact hρσ_C r
  have hσ_uB : ∀ q : PrimeSpectrum R_Q, u_B ∈ (σ_loc.base q).asIdeal := by
    intro q
    change ρ_σ u_B ∈ q.asIdeal
    rw [hρσ_uB]; exact q.asIdeal.zero_mem
  have hτ0_p : τ₀_loc ≫ p_bl = σ_loc := by
    dsimp only [τ₀_loc, σ_loc]
    rw [CategoryTheory.Category.assoc, hι0_p, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp, hρτ0_comp]
  have hτ1_p : τ₁_loc ≫ p_bl = σ_loc := by
    dsimp only [τ₁_loc, σ_loc]
    rw [CategoryTheory.Category.assoc, hι1_p, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp, hρτ1_comp]
  have hDisj_τ : Disjoint (Set.range τ₀_loc.base) (Set.range τ₁_loc.base) := by
    rw [Set.disjoint_left]
    rintro _ ⟨q₀, rfl⟩ ⟨q₁, hq⟩
    have hin0 : ι_1.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_τ1)).base q₁) ∈
        Set.range ι_0.base :=
      ⟨(AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_τ0)).base q₀, hq.symm⟩
    have hs1_not := (hov1 _).mp hin0
    apply hs1_not
    change ρ_τ1 s_1 ∈ q₁.asIdeal
    rw [hρτ1_s1]; exact q₁.asIdeal.zero_mem

  have hrng_σ : Set.range σ_loc.base = PrimeSpectrum.zeroLocus ({u_B, π_B} : Set B) := by
    ext p
    constructor
    · rintro ⟨q, rfl⟩ z (rfl | rfl)
      · change ρ_σ u_B ∈ q.asIdeal; rw [hρσ_uB]; exact q.asIdeal.zero_mem
      · change ρ_σ π_B ∈ q.asIdeal; rw [hρσ_πB]; exact q.asIdeal.zero_mem
    · intro hp
      have hu : u_B ∈ p.asIdeal := hp (Set.mem_insert u_B {π_B})
      have hπ : π_B ∈ p.asIdeal := hp (Set.mem_insert_of_mem u_B rfl)
      have hker_le : RingHom.ker ρ_σ ≤ p.asIdeal := by
        intro z hz
        rw [RingHom.mem_ker] at hz
        obtain ⟨⟨P, ⟨_, k, rfl⟩⟩, hzk⟩ := IsLocalization.surj (Submonoid.powers h_p) z
        dsimp only at hzk
        have hPeval_Q0 : Polynomial.eval c_tilde P ∈ Q₀_R.asIdeal := by
          have hm := congrArg ρ_σ hzk
          rw [map_mul, hz, zero_mul, hρσ_eq P] at hm
          have h0 : mk_Q (Polynomial.eval c_tilde P) = 0 := by
            have h1 := Polynomial.hom_eval₂ P (RingHom.id ↥R) mk_Q c_tilde
            change mk_Q (Polynomial.eval₂ (RingHom.id ↥R) c_tilde P) = 0
            rw [h1]; exact hm.symm
          exact Ideal.Quotient.eq_zero_iff_mem.mp h0
        rw [hQ0_eq] at hPeval_Q0
        obtain ⟨n, hn⟩ := hPeval_Q0
        rw [Ideal.mem_span_singleton] at hn
        obtain ⟨r, hr⟩ := hn
        have hCeval_pow : (algebraMap (Polynomial ↥R) B (Polynomial.C (Polynomial.eval c_tilde P))) ^ n ∈
            p.asIdeal := by
          rw [← map_pow, ← Polynomial.C_pow, hr, Polynomial.C_mul, map_mul]
          exact Ideal.mul_mem_right _ p.asIdeal hπ
        have hCeval_mem : algebraMap (Polynomial ↥R) B (Polynomial.C (Polynomial.eval c_tilde P)) ∈
            p.asIdeal := p.isPrime.mem_of_pow_mem n hCeval_pow
        obtain ⟨Q, hQ⟩ := Polynomial.X_sub_C_dvd_sub_C_eval (a := c_tilde) (p := P)
        have hP_eq : P = (Polynomial.X - Polynomial.C c_tilde) * Q +
            Polynomial.C (Polynomial.eval c_tilde P) := sub_eq_iff_eq_add.mp hQ
        have hP_mem : algebraMap (Polynomial ↥R) B P ∈ p.asIdeal := by
          rw [hP_eq, map_add, map_mul]
          exact p.asIdeal.add_mem (Ideal.mul_mem_right _ p.asIdeal hu) hCeval_mem
        have hinv_k : algebraMap (Polynomial ↥R) B (h_p ^ k) *
            (IsLocalization.Away.invSelf (S := B) h_p) ^ k = 1 := by
          rw [map_pow, ← mul_pow, IsLocalization.Away.mul_invSelf, one_pow]
        have hz_eq : z = algebraMap (Polynomial ↥R) B P *
            (IsLocalization.Away.invSelf (S := B) h_p) ^ k := by
          calc z = z * (algebraMap (Polynomial ↥R) B (h_p ^ k) *
                (IsLocalization.Away.invSelf (S := B) h_p) ^ k) := by rw [hinv_k, mul_one]
            _ = (z * algebraMap (Polynomial ↥R) B (h_p ^ k)) *
                (IsLocalization.Away.invSelf (S := B) h_p) ^ k := by ring
            _ = _ := by rw [hzk]
        rw [hz_eq]
        exact Ideal.mul_mem_right _ p.asIdeal hP_mem
      have _ : p.asIdeal.IsPrime := p.isPrime
      have hPrime_map : (Ideal.map ρ_σ p.asIdeal).IsPrime :=
        Ideal.map_isPrime_of_surjective hSurj_ρσ hker_le
      refine ⟨⟨Ideal.map ρ_σ p.asIdeal, hPrime_map⟩, PrimeSpectrum.ext ?_⟩
      change Ideal.comap ρ_σ (Ideal.map ρ_σ p.asIdeal) = p.asIdeal
      have hcom_le : Ideal.comap ρ_σ ⊥ ≤ p.asIdeal := hker_le
      rw [Ideal.comap_map_of_surjective ρ_σ hSurj_ρσ, sup_eq_left.mpr hcom_le]

  have hMod_cl : IsClosed (Set.range σ_loc.base) :=
    hrng_σ.symm ▸ PrimeSpectrum.isClosed_zeroLocus ({u_B, π_B} : Set B)
  have hIso_compl : CategoryTheory.IsIso
      (p_bl ∣_ (⟨(Set.range σ_loc.base)ᶜ, hMod_cl.isOpen_compl⟩ :
        (AlgebraicGeometry.Spec (CommRingCat.of B)).Opens)) := by
    let W_compl : (AlgebraicGeometry.Spec (CommRingCat.of B)).Opens :=
      ⟨(Set.range σ_loc.base)ᶜ, hMod_cl.isOpen_compl⟩
    have hDπ_le : D_π ≤ W_compl := by
      intro q hq hz
      rw [hrng_σ] at hz
      exact hq (hz (Set.mem_insert_of_mem u_B rfl))
    have hDu_le : D_u ≤ W_compl := by
      intro q hq hz
      rw [hrng_σ] at hz
      exact hq (hz (Set.mem_insert u_B {π_B}))
    let U_W : Fin 2 → W_compl.toScheme.Opens
      | 0 => (TopologicalSpace.Opens.map W_compl.ι.base).obj D_π
      | 1 => (TopologicalSpace.Opens.map W_compl.ι.base).obj D_u
    have hCov_W : (⨆ i : Fin 2, U_W i) = ⊤ := by
      rw [eq_top_iff]
      intro x _
      rw [TopologicalSpace.Opens.mem_iSup]
      have hx : x.1 ∉ PrimeSpectrum.zeroLocus ({u_B, π_B} : Set B) := by
        have hx' : x.1 ∉ Set.range σ_loc.base := x.2
        rwa [hrng_σ] at hx'
      by_cases h0 : π_B ∈ x.1.asIdeal
      · refine ⟨1, fun h1 => hx ?_⟩
        rintro z (rfl | rfl) <;> assumption
      · exact ⟨0, h0⟩
    change CategoryTheory.MorphismProperty.isomorphisms AlgebraicGeometry.Scheme (p_bl ∣_ W_compl)
    rw [AlgebraicGeometry.IsZariskiLocalAtTarget.iff_of_iSup_eq_top
      (P := CategoryTheory.MorphismProperty.isomorphisms AlgebraicGeometry.Scheme) U_W hCov_W]
    intro i
    fin_cases i
    · have hrr := AlgebraicGeometry.morphismRestrictRestrict p_bl W_compl (U_W 0)
      have himg : W_compl.ι ''ᵁ (U_W 0) = D_π := by
        ext q
        constructor
        · rintro ⟨z, hz, rfl⟩; exact hz
        · intro hqD; exact ⟨⟨q, hDπ_le hqD⟩, hqD, rfl⟩
      have hIso_img : CategoryTheory.IsIso (p_bl ∣_ (W_compl.ι ''ᵁ (U_W 0))) := by
        rw [himg]; exact hIso_Dπ
      exact (CategoryTheory.MorphismProperty.arrow_mk_iso_iff
        (CategoryTheory.MorphismProperty.isomorphisms AlgebraicGeometry.Scheme) hrr).mpr hIso_img
    · have hrr := AlgebraicGeometry.morphismRestrictRestrict p_bl W_compl (U_W 1)
      have himg : W_compl.ι ''ᵁ (U_W 1) = D_u := by
        ext q
        constructor
        · rintro ⟨z, hz, rfl⟩; exact hz
        · intro hqD; exact ⟨⟨q, hDu_le hqD⟩, hqD, rfl⟩
      have hIso_img : CategoryTheory.IsIso (p_bl ∣_ (W_compl.ι ''ᵁ (U_W 1))) := by
        rw [himg]; exact hIso_Du
      exact (CategoryTheory.MorphismProperty.arrow_mk_iso_iff
        (CategoryTheory.MorphismProperty.isomorphisms AlgebraicGeometry.Scheme) hrr).mpr hIso_img

  
  have hFieldLift : ∀ {F : Type u} [Field F] (φ_B : B →+* F),
      φ_B π_B ≠ 0 → φ_B u_B ≠ 0 →
      ∃ (φ_0 : C_0 →+* F) (φ_1 : C_1 →+* F),
        φ_0.comp ψ_0 = φ_B ∧
        φ_1.comp ψ_1 = φ_B ∧
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_0) ≫ ι_0 =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_1) ≫ ι_1 ∧
        φ_B π_B * φ_0 t_0 = φ_B u_B ∧
        φ_B u_B * φ_1 s_1 = φ_B π_B := by
    intro F _ φ_B hπF huF
    let t_F : F := φ_B u_B * (φ_B π_B)⁻¹
    have htF_ne : t_F ≠ 0 := mul_ne_zero huF (inv_ne_zero hπF)
    let φ_poly : Polynomial ↥R →+* F :=
      Polynomial.eval₂RingHom (φ_B.comp ((algebraMap (Polynomial ↥R) B).comp Polynomial.C)) t_F
    have hφ_shift : φ_poly (Polynomial.C c_tilde + Polynomial.C π_tilde * Polynomial.X) =
        φ_B (algebraMap (Polynomial ↥R) B Polynomial.X) := by
      simp only [φ_poly, map_add, map_mul, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C,
        Polynomial.eval₂_X, RingHom.comp_apply]
      have hmul : φ_B (algebraMap (Polynomial ↥R) B (Polynomial.C π_tilde)) * t_F = φ_B u_B := by
        change φ_B π_B * (φ_B u_B * (φ_B π_B)⁻¹) = φ_B u_B
        calc φ_B π_B * (φ_B u_B * (φ_B π_B)⁻¹) = φ_B u_B * (φ_B π_B * (φ_B π_B)⁻¹) := by ring
          _ = φ_B u_B := by rw [mul_inv_cancel₀ hπF, mul_one]
      rw [hmul]
      dsimp only [u_B]
      rw [← map_add, ← map_add]
      congr 2; ring
    have hφ_comp : ∀ P : Polynomial ↥R,
        φ_poly (P.comp (Polynomial.C c_tilde + Polynomial.C π_tilde * Polynomial.X)) =
          φ_B (algebraMap (Polynomial ↥R) B P) := by
      intro P
      induction P using Polynomial.induction_on' with
      | add p q hp hq => rw [Polynomial.add_comp, map_add, hp, hq, ← map_add, ← map_add]
      | monomial n r =>
        rw [← Polynomial.C_mul_X_pow_eq_monomial, Polynomial.mul_comp, Polynomial.C_comp,
          Polynomial.pow_comp, Polynomial.X_comp, map_mul, map_pow, hφ_shift]
        simp [φ_poly]
    have hφ_h0X_unit : IsUnit (φ_poly (h_0 * Polynomial.X)) := by
      rw [map_mul, hφ_comp h_p]
      have hu1 : IsUnit (φ_B (algebraMap (Polynomial ↥R) B h_p)) :=
        RingHom.isUnit_map φ_B (IsLocalization.map_units B ⟨h_p, Submonoid.mem_powers h_p⟩)
      have hu2 : IsUnit (φ_poly Polynomial.X) := by
        dsimp only [φ_poly]
        rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
        exact IsUnit.mk0 t_F htF_ne
      exact hu1.mul hu2
    let φ_01 : C_01 →+* F := IsLocalization.Away.lift (h_0 * Polynomial.X) hφ_h0X_unit
    have hφ01_eq : ∀ P : Polynomial ↥R, φ_01 (algebraMap (Polynomial ↥R) C_01 P) = φ_poly P :=
      fun P => IsLocalization.Away.lift_eq (h_0 * Polynomial.X) hφ_h0X_unit P
    let φ_0 : C_0 →+* F := φ_01.comp f_01
    let φ_1 : C_1 →+* F := φ_01.comp f_10
    have hφ0_ψ0 : φ_0.comp ψ_0 = φ_B := by
      apply IsLocalization.ringHom_ext (Submonoid.powers h_p)
      apply Polynomial.ringHom_ext
      · intro r
        change φ_01 (f_01 (ψ_0 (algebraMap (Polynomial ↥R) B (Polynomial.C r)))) =
          φ_B (algebraMap (Polynomial ↥R) B (Polynomial.C r))
        rw [hψ0_C r, hf01_eq, hφ01_eq]; simp [φ_poly]
      · change φ_01 (f_01 (ψ_0 (algebraMap (Polynomial ↥R) B Polynomial.X))) =
          φ_B (algebraMap (Polynomial ↥R) B Polynomial.X)
        rw [hψ0_X, hf01_eq, hφ01_eq, hφ_shift]
    have hφ1_ψ1 : φ_1.comp ψ_1 = φ_B := by
      dsimp only [φ_1]
      rw [RingHom.comp_assoc, ← hf_comp, ← RingHom.comp_assoc]
      exact hφ0_ψ0
    have hSpec_φ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_0) ≫ ι_0 =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_1) ≫ ι_1 := by
      dsimp only [φ_0, φ_1]
      rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc,
        hGlue, ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp]
    have hmul_t0 : φ_B π_B * φ_0 t_0 = φ_B u_B := by
      have ht0_eq : φ_0 t_0 = t_F := by
        change φ_01 (f_01 (algebraMap (Polynomial ↥R) C_0 Polynomial.X)) = t_F
        rw [hf01_eq, hφ01_eq]; simp [φ_poly]
      rw [ht0_eq]
      calc φ_B π_B * (φ_B u_B * (φ_B π_B)⁻¹) = φ_B u_B * (φ_B π_B * (φ_B π_B)⁻¹) := by ring
        _ = φ_B u_B := by rw [mul_inv_cancel₀ hπF, mul_one]
    have hmul_s1 : φ_B u_B * φ_1 s_1 = φ_B π_B := by
      have hts : φ_0 t_0 * φ_1 s_1 = 1 := by
        change φ_01 (f_01 t_0) * φ_01 (f_10 s_1) = 1
        rw [← map_mul, hf_inv, map_one]
      calc φ_B u_B * φ_1 s_1 = (φ_B π_B * φ_0 t_0) * φ_1 s_1 := by rw [hmul_t0]
        _ = φ_B π_B * (φ_0 t_0 * φ_1 s_1) := by ring
        _ = φ_B π_B := by rw [hts, mul_one]
    exact ⟨φ_0, φ_1, hφ0_ψ0, hφ1_ψ1, hSpec_φ, hmul_t0, hmul_s1⟩

  
  have away_ring_lift : ∀ {A B₂ : Type u} [CommRing A] [CommRing B₂]
      (φ : A →+* B₂) (h : A) (hu : IsUnit (φ h)),
      ∃ (Ψ : Localization.Away h →+* B₂),
        ∀ a : A, Ψ (algebraMap A (Localization.Away h) a) = φ a := by
    intro A B₂ _ _ φ h hu
    let g : @RingHom A B₂
        CommSemiring.toSemiring.toNonAssocSemiring
        CommSemiring.toSemiring.toNonAssocSemiring :=
      { toFun := φ
        map_one' := φ.map_one
        map_mul' := φ.map_mul
        map_zero' := φ.map_zero
        map_add' := φ.map_add }
    have hu' : IsUnit (g h) := hu
    let L := IsLocalization.Away.lift (S := Localization.Away h) h hu'
    exact ⟨{ toFun := L
             map_one' := L.map_one
             map_mul' := L.map_mul
             map_zero' := L.map_zero
             map_add' := L.map_add },
      fun a => IsLocalization.Away.lift_eq (S := Localization.Away h) h hu' a⟩

  have exc_glued_generic_point_aux :
      ∀ (J_P : Ideal ↥R) (R_P : Type u) [CommRing R_P] [IsDomain R_P]
        (mk_P : ↥R →+* R_P),
        RingHom.ker mk_P = J_P →
        π_tilde ∈ J_P →
        ∃ (y_P : ↥U_bl),
          (p_bl.base y_P).asIdeal =
            RingHom.ker (IsLocalization.Away.lift h_p (S := B)
              (g := Polynomial.eval₂RingHom mk_P (mk_P c_tilde))
              (by
                rw [Polynomial.coe_eval₂RingHom]
                have hev : Polynomial.eval₂ mk_P (mk_P c_tilde) h_p =
                    mk_P (Polynomial.eval c_tilde h_p) := by
                  change _ = mk_P (Polynomial.eval₂ (RingHom.id ↥R) c_tilde h_p)
                  rw [Polynomial.hom_eval₂]; rfl
                exact hev ▸ RingHom.isUnit_map mk_P hh_p_unit)) ∧
          ∀ y : ↥U_bl,
            J_P ≤ (g_Ubl.base y).asIdeal →
            u_B ∈ (p_bl.base y).asIdeal →
            y ∈ closure ({y_P} : Set ↥U_bl) := by
    intro J_P R_P _ _ mk_P hker_mkP hπ_JP
    have hmkP_π : mk_P π_tilde = 0 := by rw [← RingHom.mem_ker, hker_mkP]; exact hπ_JP
    have hunit_P : IsUnit (mk_P (Polynomial.eval c_tilde h_p)) := RingHom.isUnit_map mk_P hh_p_unit
    have hρP_unit : IsUnit ((Polynomial.eval₂RingHom mk_P (mk_P c_tilde)) h_p) := by
      rw [Polynomial.coe_eval₂RingHom]
      have hev : Polynomial.eval₂ mk_P (mk_P c_tilde) h_p = mk_P (Polynomial.eval c_tilde h_p) := by
        change _ = mk_P (Polynomial.eval₂ (RingHom.id ↥R) c_tilde h_p)
        rw [Polynomial.hom_eval₂]; rfl
      exact hev ▸ hunit_P
    let ρ_P : B →+* R_P := IsLocalization.Away.lift h_p hρP_unit

    
    have hh0_map : Polynomial.map mk_P h_0 = Polynomial.C (mk_P (Polynomial.eval c_tilde h_p)) := by
      dsimp only [h_0]
      rw [Polynomial.map_comp]
      have hlin : Polynomial.map mk_P (Polynomial.C c_tilde + Polynomial.C π_tilde * Polynomial.X) =
          Polynomial.C (mk_P c_tilde) := by
        simp [hmkP_π]
      rw [hlin, Polynomial.comp_C, Polynomial.eval_map]
      congr 1
      change Polynomial.eval₂ mk_P (mk_P c_tilde) h_p =
        mk_P (Polynomial.eval₂ (RingHom.id ↥R) c_tilde h_p)
      rw [Polynomial.hom_eval₂]; rfl
    have hh0_map_unit : IsUnit ((Polynomial.mapRingHom mk_P) h_0) := by
      change IsUnit (Polynomial.map mk_P h_0)
      rw [hh0_map]
      exact RingHom.isUnit_map Polynomial.C hunit_P
    obtain ⟨π_P0, hπP0_eq'⟩ := away_ring_lift (Polynomial.mapRingHom mk_P) h_0 hh0_map_unit
    have hπP0_eq : ∀ Q : Polynomial ↥R,
        π_P0 (algebraMap (Polynomial ↥R) C_0 Q) = Polynomial.map mk_P Q := hπP0_eq'

    let ev01_mv : MvPolynomial (Fin 2) ↥R →+* Polynomial ↥R :=
      MvPolynomial.eval₂Hom Polynomial.C ![0, Polynomial.X]
    let α_P1 : MvPolynomial (Fin 2) ↥R →+* Polynomial R_P :=
      (Polynomial.mapRingHom mk_P).comp ev01_mv
    have hαP1_ker : I_nod ≤ RingHom.ker α_P1 := by
      rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
      simp [α_P1, ev01_mv, hmkP_π]
    let α_barP1 : A_nod →+* Polynomial R_P := Ideal.Quotient.lift I_nod α_P1 hαP1_ker
    have hαP1_h1 : α_barP1 h_1 = Polynomial.C (mk_P (Polynomial.eval c_tilde h_p)) := by
      rw [hh1_def]
      change α_P1 (Polynomial.eval₂ MvPolynomial.C (MvPolynomial.C c_tilde + MvPolynomial.X 0) h_p) =
        Polynomial.C (mk_P (Polynomial.eval₂ (RingHom.id ↥R) c_tilde h_p))
      rw [Polynomial.hom_eval₂, Polynomial.hom_eval₂, Polynomial.hom_eval₂]
      have hc : α_P1.comp MvPolynomial.C = Polynomial.C.comp (mk_P.comp (RingHom.id ↥R)) := by
        ext r; simp [α_P1, ev01_mv]
      have hx : α_P1 (MvPolynomial.C c_tilde + MvPolynomial.X 0) = Polynomial.C (mk_P c_tilde) := by
        simp [α_P1, ev01_mv]
      rw [hc, hx]
    have hαP1_unit : IsUnit (α_barP1 h_1) := hαP1_h1 ▸ RingHom.isUnit_map Polynomial.C hunit_P
    obtain ⟨π_P1, hπP1_eq⟩ := away_ring_lift α_barP1 h_1 hαP1_unit

    
    let L_PX := Localization.Away (Polynomial.X : Polynomial R_P)
    have hSub_PX : Submonoid.powers (Polynomial.X : Polynomial R_P) ≤
        nonZeroDivisors (Polynomial R_P) := by
      rintro _ ⟨k, rfl⟩; exact mem_nonZeroDivisors_of_ne_zero (pow_ne_zero k Polynomial.X_ne_zero)
    have _ : IsDomain L_PX :=
      IsLocalization.isDomain_localization (M := Submonoid.powers (Polynomial.X : Polynomial R_P)) hSub_PX
    let j_PX := algebraMap (Polynomial R_P) L_PX
    have hjPX_inj : Function.Injective j_PX :=
      IsLocalization.injective L_PX (M := Submonoid.powers (Polynomial.X : Polynomial R_P)) hSub_PX
    let xinv_PX : L_PX := IsLocalization.Away.invSelf (S := L_PX) (Polynomial.X : Polynomial R_P)
    have hx_PX_mul : j_PX Polynomial.X * xinv_PX = 1 :=
      IsLocalization.Away.mul_invSelf (S := L_PX) (Polynomial.X : Polynomial R_P)
    let ι_PX_inv : Polynomial R_P →+* L_PX :=
      Polynomial.eval₂RingHom (j_PX.comp Polynomial.C) xinv_PX
    have hιPX_C : ∀ a : R_P, ι_PX_inv (Polynomial.C a) = j_PX (Polynomial.C a) := by
      intro a; dsimp only [ι_PX_inv]; rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]; rfl
    have hιPX_X : ι_PX_inv Polynomial.X = xinv_PX := by
      dsimp only [ι_PX_inv]; rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
    have hιPX_inj : Function.Injective ι_PX_inv := by
      have hu_xinv : IsUnit (ι_PX_inv Polynomial.X) := by
        rw [hιPX_X]
        exact IsUnit.of_mul_eq_one_right (j_PX Polynomial.X) hx_PX_mul
      obtain ⟨swap_PX, hswap_eq⟩ := away_ring_lift ι_PX_inv (Polynomial.X : Polynomial R_P) hu_xinv
      have hswap_xinv : swap_PX xinv_PX = j_PX Polynomial.X := by
        have hm := congrArg swap_PX hx_PX_mul
        rw [map_mul, map_one, hswap_eq Polynomial.X, hιPX_X] at hm
        have hm2 : xinv_PX * j_PX Polynomial.X = 1 := by rw [mul_comm]; exact hx_PX_mul
        have hxinv_ne : xinv_PX ≠ 0 := fun h0 => by rw [h0, mul_zero] at hx_PX_mul; exact zero_ne_one hx_PX_mul
        exact mul_left_cancel₀ hxinv_ne (hm.trans hm2.symm)
      have hcomp_id : swap_PX.comp ι_PX_inv = j_PX := by
        apply Polynomial.ringHom_ext
        · intro a
          change swap_PX (ι_PX_inv (Polynomial.C a)) = j_PX (Polynomial.C a)
          rw [hιPX_C a, hswap_eq]
          exact hιPX_C a
        · change swap_PX (ι_PX_inv Polynomial.X) = j_PX Polynomial.X
          rw [hιPX_X]; exact hswap_xinv
      intro p q hpq
      exact hjPX_inj ((RingHom.congr_fun hcomp_id p).symm.trans
        ((congrArg swap_PX hpq).trans (RingHom.congr_fun hcomp_id q)))

    have hh0X_PX_unit : IsUnit ((j_PX.comp (Polynomial.mapRingHom mk_P)) (h_0 * Polynomial.X)) := by
      rw [map_mul]
      refine (RingHom.isUnit_map j_PX hh0_map_unit).mul ?_
      change IsUnit (j_PX (Polynomial.map mk_P Polynomial.X))
      rw [Polynomial.map_X]
      exact IsLocalization.map_units L_PX
        (⟨Polynomial.X, Submonoid.mem_powers (Polynomial.X : Polynomial R_P)⟩ :
          Submonoid.powers (Polynomial.X : Polynomial R_P))
    obtain ⟨π_P01, hπP01_eq'⟩ := away_ring_lift (j_PX.comp (Polynomial.mapRingHom mk_P))
      (h_0 * Polynomial.X) hh0X_PX_unit
    have hπP01_eq : ∀ Q : Polynomial ↥R,
        π_P01 (algebraMap (Polynomial ↥R) C_01 Q) = j_PX (Polynomial.map mk_P Q) := hπP01_eq'
    have hπP01_f01 : π_P01.comp f_01 = j_PX.comp π_P0 := by
      apply IsLocalization.ringHom_ext (Submonoid.powers h_0)
      apply RingHom.ext
      intro Q
      change π_P01 (f_01 (algebraMap (Polynomial ↥R) C_0 Q)) =
        j_PX (π_P0 (algebraMap (Polynomial ↥R) C_0 Q))
      rw [hf01_eq Q, hπP01_eq Q, hπP0_eq Q]
    have hπP01_f10 : π_P01.comp f_10 = ι_PX_inv.comp π_P1 := by
      apply IsLocalization.ringHom_ext (Submonoid.powers h_1)
      apply RingHom.ext
      refine Quotient.ind fun F => ?_
      have hboth : (π_P01.comp (f_10.comp (algebraMap A_nod C_1))).comp mk_nod =
          (ι_PX_inv.comp (π_P1.comp (algebraMap A_nod C_1))).comp mk_nod := by
        apply MvPolynomial.ringHom_ext'
        · ext r
          change π_P01 (f_10 (algebraMap A_nod C_1 (mk_nod (MvPolynomial.C r)))) =
            ι_PX_inv (π_P1 (algebraMap A_nod C_1 (mk_nod (MvPolynomial.C r))))
          rw [hf10_C r, hπP01_eq, hπP1_eq]
          have h1 : α_barP1 (mk_nod (MvPolynomial.C r)) = Polynomial.C (mk_P r) :=
            (Ideal.Quotient.lift_mk I_nod α_P1 hαP1_ker).trans (by simp [α_P1, ev01_mv])
          rw [h1]; simp [ι_PX_inv]
        · intro i
          fin_cases i
          · change π_P01 (f_10 u_1) = ι_PX_inv (π_P1 u_1)
            rw [hf10_u1, hπP01_eq, hπP1_eq]
            have h1 : α_barP1 (mk_nod (MvPolynomial.X 0)) = 0 :=
              (Ideal.Quotient.lift_mk I_nod α_P1 hαP1_ker).trans (by simp [α_P1, ev01_mv])
            rw [h1]; simp [hmkP_π]
          · change π_P01 (f_10 s_1) = ι_PX_inv (π_P1 s_1)
            have hs1_xinv : π_P01 (f_10 s_1) = xinv_PX := by
              have hm := congrArg π_P01 hX_s1_inv
              rw [map_mul, map_one, hπP01_eq Polynomial.X, Polynomial.map_X] at hm
              have hjX_ne : j_PX Polynomial.X ≠ 0 :=
                (map_ne_zero_iff _ hjPX_inj).mpr Polynomial.X_ne_zero
              exact mul_left_cancel₀ hjX_ne (hm.trans hx_PX_mul.symm)
            rw [hs1_xinv, hπP1_eq]
            have h1 : α_barP1 (mk_nod (MvPolynomial.X 1)) = Polynomial.X :=
              (Ideal.Quotient.lift_mk I_nod α_P1 hαP1_ker).trans (by simp [α_P1, ev01_mv])
            rw [h1]; simp [ι_PX_inv]
      exact RingHom.congr_fun hboth F

    let p_exc0 : PrimeSpectrum C_0 := ⟨RingHom.ker π_P0, RingHom.ker_isPrime π_P0⟩
    let p_exc1 : PrimeSpectrum C_1 := ⟨RingHom.ker π_P1, RingHom.ker_isPrime π_P1⟩
    let p_exc01 : PrimeSpectrum C_01 := ⟨RingHom.ker π_P01, RingHom.ker_isPrime π_P01⟩
    have hf01_pexc : f_01_spec.base p_exc01 = p_exc0 := by
      apply PrimeSpectrum.ext; ext x
      change π_P01 (f_01 x) = 0 ↔ π_P0 x = 0
      have h := RingHom.congr_fun hπP01_f01 x
      change π_P01 (f_01 x) = j_PX (π_P0 x) at h
      rw [h]; exact map_eq_zero_iff j_PX hjPX_inj
    have hf10_pexc : f_10_spec.base p_exc01 = p_exc1 := by
      apply PrimeSpectrum.ext; ext x
      change π_P01 (f_10 x) = 0 ↔ π_P1 x = 0
      have h := RingHom.congr_fun hπP01_f10 x
      change π_P01 (f_10 x) = ι_PX_inv (π_P1 x) at h
      rw [h]; exact map_eq_zero_iff ι_PX_inv hιPX_inj
    have hyP_eq : ι_0.base p_exc0 = ι_1.base p_exc1 := by
      rw [← hf01_pexc, ← hf10_pexc]
      exact congrArg (fun h => h.base p_exc01) hGlue
    let y_P : ↥U_bl := ι_0.base p_exc0
    have hπP0_ψ0 : π_P0.comp ψ_0 = Polynomial.C.comp ρ_P := by
      apply IsLocalization.ringHom_ext (Submonoid.powers h_p)
      apply Polynomial.ringHom_ext
      · intro r
        change π_P0 (ψ_0 (algebraMap (Polynomial ↥R) B (Polynomial.C r))) =
          Polynomial.C (ρ_P (algebraMap (Polynomial ↥R) B (Polynomial.C r)))
        rw [hψ0_C r, hπP0_eq, IsLocalization.Away.lift_eq h_p hρP_unit]; simp
      · change π_P0 (ψ_0 (algebraMap (Polynomial ↥R) B Polynomial.X)) =
          Polynomial.C (ρ_P (algebraMap (Polynomial ↥R) B Polynomial.X))
        rw [hψ0_X, hπP0_eq, IsLocalization.Away.lift_eq h_p hρP_unit]; simp [hmkP_π]
    have hyP_base : (p_bl.base y_P).asIdeal = RingHom.ker ρ_P := by
      change ((ι_0 ≫ p_bl).base p_exc0).asIdeal = RingHom.ker ρ_P
      rw [hι0_p]
      ext b
      change π_P0 (ψ_0 b) = 0 ↔ ρ_P b = 0
      have h := RingHom.congr_fun hπP0_ψ0 b
      change π_P0 (ψ_0 b) = Polynomial.C (ρ_P b) at h
      rw [h]; exact Polynomial.C_eq_zero
    refine ⟨y_P, hyP_base, fun y hy_JP hy_uB => ?_⟩
    rcases hCov_or y with ⟨p_0, rfl⟩ | ⟨p_1, rfl⟩
    · have hker0 : p_exc0.asIdeal ≤ p_0.asIdeal := by
        intro z hz
        rw [RingHom.mem_ker] at hz
        obtain ⟨⟨Q, ⟨_, k, rfl⟩⟩, hzk⟩ := IsLocalization.surj (Submonoid.powers h_0) z
        dsimp only at hzk
        have hQ_map0 : Polynomial.map mk_P Q = 0 := by
          have hm := congrArg π_P0 hzk
          rw [map_mul, hz, zero_mul, hπP0_eq Q] at hm
          exact hm.symm
        have hQ_mem : algebraMap (Polynomial ↥R) C_0 Q ∈ p_0.asIdeal := by
          rw [Q.as_sum_support_C_mul_X_pow, map_sum]
          refine Ideal.sum_mem p_0.asIdeal fun i _ => ?_
          rw [map_mul]
          refine Ideal.mul_mem_right _ p_0.asIdeal ?_
          have hci_JP : Q.coeff i ∈ J_P := by
            have hci0 : mk_P (Q.coeff i) = 0 := by
              rw [← Polynomial.coeff_map, hQ_map0, Polynomial.coeff_zero]
            rw [← hker_mkP]; exact hci0
          have hci_g : Q.coeff i ∈ ((ι_0 ≫ g_Ubl).base p_0).asIdeal := hy_JP hci_JP
          rw [hι0_g] at hci_g
          exact hci_g
        have hinv_k : algebraMap (Polynomial ↥R) C_0 (h_0 ^ k) *
            (IsLocalization.Away.invSelf (S := C_0) h_0) ^ k = 1 := by
          rw [map_pow, ← mul_pow, IsLocalization.Away.mul_invSelf, one_pow]
        have hz_eq : z = algebraMap (Polynomial ↥R) C_0 Q *
            (IsLocalization.Away.invSelf (S := C_0) h_0) ^ k := by
          calc z = z * (algebraMap (Polynomial ↥R) C_0 (h_0 ^ k) *
                (IsLocalization.Away.invSelf (S := C_0) h_0) ^ k) := by rw [hinv_k, mul_one]
            _ = (z * algebraMap (Polynomial ↥R) C_0 (h_0 ^ k)) *
                (IsLocalization.Away.invSelf (S := C_0) h_0) ^ k := by ring
            _ = _ := by rw [hzk]
        rw [hz_eq]
        exact Ideal.mul_mem_right _ p_0.asIdeal hQ_mem
      have hp0_cl : p_0 ∈ closure ({p_exc0} : Set (PrimeSpectrum C_0)) := by
        rw [PrimeSpectrum.closure_singleton]; exact hker0
      exact closure_mono (by rintro _ ⟨z, hz, rfl⟩; have hz' : z = p_exc0 := hz; subst hz'; rfl)
        (image_closure_subset_closure_image ι_0.continuous ⟨p_0, hp0_cl, rfl⟩)
    · have hu1_mem : u_1 ∈ p_1.asIdeal := by
        have h1 : ((ι_1 ≫ p_bl).base p_1).asIdeal =
            ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_1)).base p_1).asIdeal :=
          congrArg (fun f : AlgebraicGeometry.Spec (CommRingCat.of C_1) ⟶
              AlgebraicGeometry.Spec (CommRingCat.of B) => (f.base p_1).asIdeal) hι1_p
        have hψ1_mem : ψ_1 u_B ∈ p_1.asIdeal := Eq.mp (congrArg (u_B ∈ ·) h1) hy_uB
        exact Eq.mp (congrArg (· ∈ p_1.asIdeal) (show ψ_1 u_B = u_1 from hψ1_uB)) hψ1_mem
      have hker1 : p_exc1.asIdeal ≤ p_1.asIdeal := by
        intro z hz
        rw [RingHom.mem_ker] at hz
        obtain ⟨⟨y0, ⟨_, k, rfl⟩⟩, hzk⟩ := IsLocalization.surj (Submonoid.powers h_1) z
        obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective y0
        dsimp only at hzk
        have hF_map0 : Polynomial.map mk_P (ev01_mv F) = 0 := by
          have hm := congrArg π_P1 hzk
          rw [map_mul, hz, zero_mul, hπP1_eq] at hm
          exact (Ideal.Quotient.lift_mk I_nod α_P1 hαP1_ker).symm.trans hm.symm
        let q_p1 := Ideal.Quotient.mk p_1.asIdeal
        let ev_q1 : Polynomial ↥R →+* C_1 ⧸ p_1.asIdeal :=
          Polynomial.eval₂RingHom (q_p1.comp ((algebraMap A_nod C_1).comp c_nod)) (q_p1 s_1)
        have hhom_eq : q_p1.comp ((algebraMap A_nod C_1).comp mk_nod) = ev_q1.comp ev01_mv := by
          apply MvPolynomial.ringHom_ext'
          · ext r; simp [ev_q1, ev01_mv, c_nod]
          · intro i
            fin_cases i
            · change q_p1 u_1 = ev_q1 (ev01_mv (MvPolynomial.X 0))
              simp [ev01_mv, q_p1, Ideal.Quotient.eq_zero_iff_mem.mpr hu1_mem]
            · change q_p1 s_1 = ev_q1 (ev01_mv (MvPolynomial.X 1))
              simp [ev01_mv, ev_q1]
        have hev_zero : ev_q1 (ev01_mv F) = 0 := by
          let Q := ev01_mv F
          change ev_q1 Q = 0
          rw [Q.as_sum_support_C_mul_X_pow, map_sum]
          refine Finset.sum_eq_zero fun i _ => ?_
          rw [map_mul]
          have hci_JP : Q.coeff i ∈ J_P := by
            have hci0 : mk_P (Q.coeff i) = 0 := by
              rw [← Polynomial.coeff_map, hF_map0, Polynomial.coeff_zero]
            rw [← hker_mkP]; exact hci0
          have hci_g : Q.coeff i ∈ ((ι_1 ≫ g_Ubl).base p_1).asIdeal := hy_JP hci_JP
          rw [hι1_g] at hci_g
          have hci_q0 : q_p1 (algebraMap A_nod C_1 (c_nod (Q.coeff i))) = 0 :=
            Ideal.Quotient.eq_zero_iff_mem.mpr hci_g
          have hev_C : ev_q1 (Polynomial.C (Q.coeff i)) =
              q_p1 (algebraMap A_nod C_1 (c_nod (Q.coeff i))) := by simp [ev_q1]
          rw [hev_C, hci_q0, zero_mul]
        have hF_mem : algebraMap A_nod C_1 (mk_nod F) ∈ p_1.asIdeal := by
          apply Ideal.Quotient.eq_zero_iff_mem.mp
          exact (RingHom.congr_fun hhom_eq F).trans hev_zero
        have hinv_k : algebraMap A_nod C_1 (h_1 ^ k) *
            (IsLocalization.Away.invSelf (S := C_1) h_1) ^ k = 1 := by
          rw [map_pow, ← mul_pow, IsLocalization.Away.mul_invSelf, one_pow]
        have hz_eq : z = algebraMap A_nod C_1 (mk_nod F) *
            (IsLocalization.Away.invSelf (S := C_1) h_1) ^ k := by
          calc z = z * (algebraMap A_nod C_1 (h_1 ^ k) *
                (IsLocalization.Away.invSelf (S := C_1) h_1) ^ k) := by rw [hinv_k, mul_one]
            _ = (z * algebraMap A_nod C_1 (h_1 ^ k)) *
                (IsLocalization.Away.invSelf (S := C_1) h_1) ^ k := by ring
            _ = _ := by rw [hzk]
        rw [hz_eq]
        exact Ideal.mul_mem_right _ p_1.asIdeal hF_mem
      have hp1_cl : p_1 ∈ closure ({p_exc1} : Set (PrimeSpectrum C_1)) := by
        rw [PrimeSpectrum.closure_singleton]; exact hker1
      exact closure_mono
        (by rintro _ ⟨z, hz, rfl⟩; have hz' : z = p_exc1 := hz; subst hz'; exact hyP_eq.symm)
        (image_closure_subset_closure_image ι_1.continuous ⟨p_1, hp1_cl, rfl⟩)

  have exc_glued_generic_point : ∀ (J_P : Ideal ↥R) [J_P.IsPrime],
      π_tilde ∈ J_P → J_P ≤ m_R →
      ∃ (y_P : ↥U_bl),
        (p_bl.base y_P).asIdeal =
          RingHom.ker (IsLocalization.Away.lift h_p (S := B)
            (g := Polynomial.eval₂RingHom (Ideal.Quotient.mk J_P) (Ideal.Quotient.mk J_P c_tilde))
            (by
              rw [Polynomial.coe_eval₂RingHom]
              have hev : Polynomial.eval₂ (Ideal.Quotient.mk J_P) (Ideal.Quotient.mk J_P c_tilde) h_p =
                  Ideal.Quotient.mk J_P (Polynomial.eval c_tilde h_p) := by
                change _ = Ideal.Quotient.mk J_P (Polynomial.eval₂ (RingHom.id ↥R) c_tilde h_p)
                rw [Polynomial.hom_eval₂]; rfl
              exact hev ▸ RingHom.isUnit_map (Ideal.Quotient.mk J_P) hh_p_unit)) ∧
        ∀ y : ↥U_bl,
          J_P ≤ (g_Ubl.base y).asIdeal →
          u_B ∈ (p_bl.base y).asIdeal →
          y ∈ closure ({y_P} : Set ↥U_bl) := by
    intro J_P _ hπ_JP _
    have hdom_P : @IsDomain (↥R ⧸ J_P) (@CommSemiring.toSemiring (↥R ⧸ J_P) CommRing.toCommSemiring) :=
      Ideal.Quotient.isDomain J_P
    exact @exc_glued_generic_point_aux J_P (↥R ⧸ J_P) inferInstance hdom_P
      (Ideal.Quotient.mk J_P) Ideal.mk_ker hπ_JP

  
  have hC15 : ∃ q_gen : AlgebraicGeometry.Spec (CommRingCat.of R_Q),
      g_B.base (σ_loc.base q_gen) = Q₀_R ∧
      IsIrreducible (p_bl.base ⁻¹' {σ_loc.base q_gen}) ∧
      p_bl.base ⁻¹' (Set.range σ_loc.base) = closure (p_bl.base ⁻¹' {σ_loc.base q_gen}) := by
    let q_gen : PrimeSpectrum R_Q := ⊥
    have hq_gen_Q0 : g_B.base (σ_loc.base q_gen) = Q₀_R := by
      apply PrimeSpectrum.ext
      change ((σ_loc ≫ g_B).base q_gen).asIdeal = Q₀_R.asIdeal
      rw [hσ_gB]
      change Ideal.comap mk_Q ⊥ = Q₀_R.asIdeal
      exact Ideal.mk_ker
    obtain ⟨y_Q, hyQ_base, hyQ_cl⟩ := exc_glued_generic_point Q₀_R.asIdeal hπ_Q0 hQ0_le_mR
    have hyQ_mem : y_Q ∈ p_bl.base ⁻¹' {σ_loc.base q_gen} := by
      change p_bl.base y_Q = σ_loc.base q_gen
      apply PrimeSpectrum.ext
      rw [hyQ_base]
      rfl
    have hpre_cl : IsClosed (p_bl.base ⁻¹' (Set.range σ_loc.base)) :=
      hMod_cl.preimage p_bl.base.hom.continuous
    have hsub_cl : p_bl.base ⁻¹' (Set.range σ_loc.base) ⊆ closure ({y_Q} : Set ↥U_bl) := by
      rintro y ⟨q, hq⟩
      apply hyQ_cl y
      · intro r hr
        have h1 : r ∈ (g_B.base (p_bl.base y)).asIdeal := by
          rw [← hq]
          change r ∈ ((σ_loc ≫ g_B).base q).asIdeal
          rw [hσ_gB]
          change mk_Q r ∈ q.asIdeal
          rw [Ideal.Quotient.eq_zero_iff_mem.mpr hr]
          exact q.asIdeal.zero_mem
        exact h1
      · rw [← hq]; exact hσ_uB q
    have hcl_yQ_eq : p_bl.base ⁻¹' (Set.range σ_loc.base) = closure ({y_Q} : Set ↥U_bl) :=
      Set.Subset.antisymm hsub_cl
        (closure_minimal (Set.singleton_subset_iff.mpr ⟨q_gen, hyQ_mem.symm⟩) hpre_cl)
    have hcl_eq : p_bl.base ⁻¹' (Set.range σ_loc.base) =
        closure (p_bl.base ⁻¹' {σ_loc.base q_gen}) := by
      apply Set.Subset.antisymm
      · rw [hcl_yQ_eq]
        exact closure_mono (Set.singleton_subset_iff.mpr hyQ_mem)
      · exact closure_minimal
          (Set.preimage_mono (Set.singleton_subset_iff.mpr ⟨q_gen, rfl⟩)) hpre_cl
    have hIrr_gen : IsIrreducible (p_bl.base ⁻¹' {σ_loc.base q_gen}) := by
      have hA_sub : p_bl.base ⁻¹' {σ_loc.base q_gen} ⊆ closure ({y_Q} : Set ↥U_bl) := by
        rw [← hcl_yQ_eq]
        exact Set.preimage_mono (Set.singleton_subset_iff.mpr ⟨q_gen, rfl⟩)
      refine ⟨⟨y_Q, hyQ_mem⟩, fun U V hU hV ⟨a, haA, haU⟩ ⟨b, hbA, hbV⟩ => ?_⟩
      have hyU : y_Q ∈ U := by
        by_contra hy_not
        exact (closure_minimal (Set.singleton_subset_iff.mpr hy_not) hU.isClosed_compl (hA_sub haA)) haU
      have hyV : y_Q ∈ V := by
        by_contra hy_not
        exact (closure_minimal (Set.singleton_subset_iff.mpr hy_not) hV.isClosed_compl (hA_sub hbA)) hbV
      exact ⟨y_Q, hyQ_mem, hyU, hyV⟩
    exact ⟨q_gen, hq_gen_Q0, hIrr_gen, hcl_eq⟩

  
  have hC28 : ∃ (q_max : PrimeSpectrum R_Q),
      (g_B.base (σ_loc.base q_max)).asIdeal = m_R ∧
      let E_loc : Set ↥U_bl := p_bl.base ⁻¹' {σ_loc.base q_max}
      let S_strict : Set ↥U_bl :=
        closure (p_bl.base ⁻¹' ({x : PrimeSpectrum B | (g_B.base x).asIdeal = m_R} \ {σ_loc.base q_max}))
      IsClosed E_loc ∧ IsIrreducible E_loc ∧
      IsClosed S_strict ∧ IsIrreducible S_strict ∧
      E_loc ∪ S_strict = {y : ↥U_bl | (g_Ubl.base y).asIdeal = m_R} ∧
      (∃! y_nod : ↥U_bl, y_nod ∈ E_loc ∧ y_nod ∈ S_strict) ∧
      (∀ p : PrimeSpectrum C_0, (g_Ubl.base (ι_0.base p)).asIdeal = m_R →
        ι_0.base p ∈ E_loc ∧ ι_0.base p ∉ S_strict) ∧
      (∀ p : PrimeSpectrum C_1, (g_Ubl.base (ι_1.base p)).asIdeal = m_R →
        (ι_1.base p ∈ S_strict ↔ s_1 ∈ p.asIdeal) ∧
        (ι_1.base p ∈ E_loc ↔ u_1 ∈ p.asIdeal)) := by
    have hker_mkQ_le : RingHom.ker mk_Q ≤ m_R := by rw [Ideal.mk_ker]; exact hQ0_le_mR
    have hcom_mkQ_le : Ideal.comap mk_Q ⊥ ≤ m_R := hker_mkQ_le
    let q_max : PrimeSpectrum R_Q :=
      ⟨Ideal.map mk_Q m_R, Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective hker_mkQ_le⟩
    have hqmax_mR : (g_B.base (σ_loc.base q_max)).asIdeal = m_R := by
      change ((σ_loc ≫ g_B).base q_max).asIdeal = m_R
      rw [hσ_gB]
      change Ideal.comap mk_Q (Ideal.map mk_Q m_R) = m_R
      rw [Ideal.comap_map_of_surjective mk_Q Ideal.Quotient.mk_surjective, sup_eq_left.mpr hcom_mkQ_le]
    let x_max : PrimeSpectrum B := σ_loc.base q_max

    
    have hεB_unit : IsUnit ((Polynomial.eval₂RingHom res_R (res_R c_tilde)) h_p) := by
      rw [Polynomial.coe_eval₂RingHom]
      have hev : Polynomial.eval₂ res_R (res_R c_tilde) h_p = res_R (Polynomial.eval c_tilde h_p) := by
        change _ = res_R (Polynomial.eval₂ (RingHom.id ↥R) c_tilde h_p)
        rw [Polynomial.hom_eval₂]; rfl
      exact hev ▸ RingHom.isUnit_map res_R hh_p_unit
    let ε_Bmax : B →+* k_R := IsLocalization.Away.lift h_p hεB_unit
    have hεB_eq : ∀ P : Polynomial ↥R,
        ε_Bmax (algebraMap (Polynomial ↥R) B P) = Polynomial.eval₂ res_R (res_R c_tilde) P :=
      fun P => IsLocalization.Away.lift_eq h_p hεB_unit P
    have hSurj_εB : Function.Surjective ε_Bmax := by
      intro z
      obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective z
      exact ⟨algebraMap (Polynomial ↥R) B (Polynomial.C r), by rw [hεB_eq, Polynomial.eval₂_C]⟩
    let factor_Qm : R_Q →+* k_R := Ideal.Quotient.factor hQ0_le_mR
    have hεB_fac : factor_Qm.comp ρ_σ = ε_Bmax := by
      apply IsLocalization.ringHom_ext (Submonoid.powers h_p)
      apply Polynomial.ringHom_ext
      · intro r
        change factor_Qm (ρ_σ (algebraMap (Polynomial ↥R) B (Polynomial.C r))) =
          ε_Bmax (algebraMap (Polynomial ↥R) B (Polynomial.C r))
        rw [hρσ_C r, hεB_eq, Polynomial.eval₂_C]; rfl
      · change factor_Qm (ρ_σ (algebraMap (Polynomial ↥R) B Polynomial.X)) =
          ε_Bmax (algebraMap (Polynomial ↥R) B Polynomial.X)
        rw [hρσ_X, hεB_eq, Polynomial.eval₂_X]; rfl
    have hxmax_ker : x_max.asIdeal = RingHom.ker ε_Bmax := by
      rw [← hεB_fac]
      ext b
      change ρ_σ b ∈ Ideal.map mk_Q m_R ↔ factor_Qm (ρ_σ b) = 0
      obtain ⟨r, hr⟩ := Ideal.Quotient.mk_surjective (ρ_σ b)
      rw [← hr]
      change mk_Q r ∈ Ideal.map mk_Q m_R ↔ res_R r = 0
      rw [Ideal.Quotient.eq_zero_iff_mem]
      constructor
      · intro hmem
        have hcom : r ∈ Ideal.comap mk_Q (Ideal.map mk_Q m_R) := hmem
        rwa [Ideal.comap_map_of_surjective mk_Q Ideal.Quotient.mk_surjective,
          sup_eq_left.mpr hcom_mkQ_le] at hcom
      · exact fun hr_m => Ideal.mem_map_of_mem mk_Q hr_m
    have hxmax_max : x_max.asIdeal.IsMaximal :=
      hxmax_ker ▸ RingHom.ker_isMaximal_of_surjective ε_Bmax hSurj_εB
    have hxmax_cl : IsClosed ({x_max} : Set (PrimeSpectrum B)) := by
      have heq_zl : ({x_max} : Set (PrimeSpectrum B)) =
          PrimeSpectrum.zeroLocus (x_max.asIdeal : Set B) := by
        ext y
        rw [Set.mem_singleton_iff, PrimeSpectrum.mem_zeroLocus, SetLike.coe_subset_coe]
        exact ⟨by rintro rfl; exact le_rfl,
          fun hle => PrimeSpectrum.ext (hxmax_max.eq_of_le y.isPrime.ne_top hle).symm⟩
      rw [heq_zl]
      exact PrimeSpectrum.isClosed_zeroLocus _

    have hxmax_iff : ∀ x : PrimeSpectrum B, (g_B.base x).asIdeal = m_R →
        (x = x_max ↔ u_B ∈ x.asIdeal) := by
      intro x hx_mR
      constructor
      · rintro rfl; exact hσ_uB q_max
      · intro hu_x
        have hle : x_max.asIdeal ≤ x.asIdeal := by
          rw [hxmax_ker]
          intro z hz
          rw [RingHom.mem_ker] at hz
          obtain ⟨⟨P, ⟨_, k, rfl⟩⟩, hzk⟩ := IsLocalization.surj (Submonoid.powers h_p) z
          dsimp only at hzk
          have hP_eval_mR : Polynomial.eval c_tilde P ∈ m_R := by
            have hm := congrArg ε_Bmax hzk
            rw [map_mul, hz, zero_mul, hεB_eq P] at hm
            have h0 : res_R (Polynomial.eval c_tilde P) = 0 := by
              have h1 := Polynomial.hom_eval₂ P (RingHom.id ↥R) res_R c_tilde
              change res_R (Polynomial.eval₂ (RingHom.id ↥R) c_tilde P) = 0
              rw [h1]; exact hm.symm
            exact Ideal.Quotient.eq_zero_iff_mem.mp h0
          have hC_mem : algebraMap (Polynomial ↥R) B (Polynomial.C (Polynomial.eval c_tilde P)) ∈
              x.asIdeal := by
            change Polynomial.eval c_tilde P ∈ (g_B.base x).asIdeal
            rwa [hx_mR]
          obtain ⟨Q, hQ⟩ := Polynomial.X_sub_C_dvd_sub_C_eval (a := c_tilde) (p := P)
          have hP_eq : P = (Polynomial.X - Polynomial.C c_tilde) * Q +
              Polynomial.C (Polynomial.eval c_tilde P) := sub_eq_iff_eq_add.mp hQ
          have hP_mem : algebraMap (Polynomial ↥R) B P ∈ x.asIdeal := by
            rw [hP_eq, map_add, map_mul]
            exact x.asIdeal.add_mem (Ideal.mul_mem_right _ x.asIdeal hu_x) hC_mem
          have hinv_k : algebraMap (Polynomial ↥R) B (h_p ^ k) *
              (IsLocalization.Away.invSelf (S := B) h_p) ^ k = 1 := by
            rw [map_pow, ← mul_pow, IsLocalization.Away.mul_invSelf, one_pow]
          have hz_eq : z = algebraMap (Polynomial ↥R) B P *
              (IsLocalization.Away.invSelf (S := B) h_p) ^ k := by
            calc z = z * (algebraMap (Polynomial ↥R) B (h_p ^ k) *
                  (IsLocalization.Away.invSelf (S := B) h_p) ^ k) := by rw [hinv_k, mul_one]
              _ = (z * algebraMap (Polynomial ↥R) B (h_p ^ k)) *
                  (IsLocalization.Away.invSelf (S := B) h_p) ^ k := by ring
              _ = _ := by rw [hzk]
          rw [hz_eq]
          exact Ideal.mul_mem_right _ x.asIdeal hP_mem
        exact PrimeSpectrum.ext (hxmax_max.eq_of_le x.isPrime.ne_top hle).symm

    let E_loc : Set ↥U_bl := p_bl.base ⁻¹' {x_max}
    let S_open : Set ↥U_bl := p_bl.base ⁻¹' ({x : PrimeSpectrum B | (g_B.base x).asIdeal = m_R} \ {x_max})
    let S_strict : Set ↥U_bl := closure S_open
    have hCl_Eloc : IsClosed E_loc := hxmax_cl.preimage p_bl.base.hom.continuous
    have hCl_Sstrict : IsClosed S_strict := isClosed_closure

    
    obtain ⟨y_E, hyE_base, hyE_cl⟩ := exc_glued_generic_point m_R hπ_mem le_rfl
    have hyE_mem : y_E ∈ E_loc := by
      change p_bl.base y_E = x_max
      apply PrimeSpectrum.ext
      rw [hyE_base, hxmax_ker]
    have hEloc_eq_cl : E_loc = closure ({y_E} : Set ↥U_bl) := by
      apply Set.Subset.antisymm
      · intro y hy
        change p_bl.base y = x_max at hy
        apply hyE_cl y
        · change m_R ≤ (g_B.base (p_bl.base y)).asIdeal
          rw [hy, hqmax_mR]
        · rw [hy]; exact hσ_uB q_max
      · exact closure_minimal (Set.singleton_subset_iff.mpr hyE_mem) hCl_Eloc
    have hIrr_Eloc : IsIrreducible E_loc :=
      hEloc_eq_cl ▸ (isIrreducible_singleton (x := y_E)).closure

    
    have hChart0_Eloc : ∀ p : PrimeSpectrum C_0,
        (g_Ubl.base (ι_0.base p)).asIdeal = m_R → ι_0.base p ∈ E_loc := by
      intro p hp_mR
      change p_bl.base (ι_0.base p) = x_max
      have hp_B : (g_B.base (p_bl.base (ι_0.base p))).asIdeal = m_R := hp_mR
      refine (hxmax_iff (p_bl.base (ι_0.base p)) hp_B).mpr ?_
      change u_B ∈ ((ι_0 ≫ p_bl).base p).asIdeal
      rw [hι0_p]
      change ψ_0 u_B ∈ p.asIdeal
      rw [hψ0_uB]
      refine Ideal.mul_mem_right t_0 p.asIdeal ?_
      change π_B ∈ ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_0)).base p).asIdeal
      rw [← hι0_p]
      change π_tilde ∈ (g_B.base (p_bl.base (ι_0.base p))).asIdeal
      rw [hp_B]; exact hπ_mem
    have hSstrict_disj0 : S_strict ⊆ (Set.range ι_0.base)ᶜ := by
      apply closure_minimal _ ι_0.isOpenEmbedding.isOpen_range.isClosed_compl
      rintro y ⟨hy_mR, hy_ne⟩ ⟨p_0, rfl⟩
      exact hy_ne (hChart0_Eloc p_0 hy_mR)
    have hChart0_mR : ∀ p : PrimeSpectrum C_0,
        (g_Ubl.base (ι_0.base p)).asIdeal = m_R →
        ι_0.base p ∈ E_loc ∧ ι_0.base p ∉ S_strict :=
      fun p hp => ⟨hChart0_Eloc p hp, fun hs => hSstrict_disj0 hs ⟨p, rfl⟩⟩

    
    have hChart1_Eloc : ∀ p : PrimeSpectrum C_1,
        (g_Ubl.base (ι_1.base p)).asIdeal = m_R →
        (ι_1.base p ∈ E_loc ↔ u_1 ∈ p.asIdeal) := by
      intro p hp_mR
      have hp_B : (g_B.base (p_bl.base (ι_1.base p))).asIdeal = m_R := hp_mR
      change p_bl.base (ι_1.base p) = x_max ↔ u_1 ∈ p.asIdeal
      refine (hxmax_iff (p_bl.base (ι_1.base p)) hp_B).trans ?_
      have h1 : u_B ∈ (p_bl.base (ι_1.base p)).asIdeal ↔ ψ_1 u_B ∈ p.asIdeal := by
        change u_B ∈ ((ι_1 ≫ p_bl).base p).asIdeal ↔ ψ_1 u_B ∈ p.asIdeal
        rw [hι1_p]; rfl
      exact h1.trans (by rw [show ψ_1 u_B = u_1 from hψ1_uB])

    
    let hp_bar : Polynomial k_R := Polynomial.map res_R h_p
    have hhp_bar_ne : hp_bar ≠ 0 := by
      rintro h0
      apply hh_p_res
      have hev : Polynomial.eval (res_R c_tilde) hp_bar = res_R (Polynomial.eval c_tilde h_p) := by
        dsimp only [hp_bar]
        rw [Polynomial.eval_map]
        change Polynomial.eval₂ res_R (res_R c_tilde) h_p =
          res_R (Polynomial.eval₂ (RingHom.id ↥R) c_tilde h_p)
        rw [Polynomial.hom_eval₂]; rfl
      rw [← hev, h0, Polynomial.eval_zero]
    let L_S := Localization.Away hp_bar
    have hSub_LS : Submonoid.powers hp_bar ≤ nonZeroDivisors (Polynomial k_R) := by
      rintro _ ⟨k, rfl⟩; exact mem_nonZeroDivisors_of_ne_zero (pow_ne_zero k hhp_bar_ne)
    have _ : IsDomain L_S := IsLocalization.isDomain_localization hSub_LS
    let j_LS := algebraMap (Polynomial k_R) L_S
    have hjLS_inj : Function.Injective j_LS := IsLocalization.injective L_S hSub_LS
    let ev10_mv : MvPolynomial (Fin 2) ↥R →+* Polynomial ↥R :=
      MvPolynomial.eval₂Hom Polynomial.C ![Polynomial.X, 0]
    let shift_kR : Polynomial k_R →+* Polynomial k_R :=
      Polynomial.compRingHom (Polynomial.X - Polynomial.C (res_R c_tilde))
    let α_S1 : MvPolynomial (Fin 2) ↥R →+* L_S :=
      j_LS.comp (shift_kR.comp ((Polynomial.mapRingHom res_R).comp ev10_mv))
    have hαS1_ker : I_nod ≤ RingHom.ker α_S1 := by
      rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
      simp [α_S1, ev10_mv, shift_kR, hres_π]
    let α_barS1 : A_nod →+* L_S := Ideal.Quotient.lift I_nod α_S1 hαS1_ker
    have hαS1_h1 : α_barS1 h_1 = j_LS hp_bar := by
      rw [hh1_def]
      change α_S1 (Polynomial.eval₂ MvPolynomial.C (MvPolynomial.C c_tilde + MvPolynomial.X 0) h_p) =
        j_LS (Polynomial.eval₂ (Polynomial.C.comp res_R) Polynomial.X h_p)
      rw [Polynomial.hom_eval₂, Polynomial.hom_eval₂]
      have hc : α_S1.comp MvPolynomial.C = j_LS.comp (Polynomial.C.comp res_R) := by
        ext r; simp [α_S1, ev10_mv, shift_kR]
      have hx : α_S1 (MvPolynomial.C c_tilde + MvPolynomial.X 0) = j_LS Polynomial.X := by
        simp only [α_S1, RingHom.comp_apply, map_add, ev10_mv, MvPolynomial.eval₂Hom_C,
          MvPolynomial.eval₂Hom_X', Matrix.cons_val_zero, Polynomial.coe_mapRingHom,
          Polynomial.map_C, Polynomial.map_X]
        rw [← map_add]
        congr 1
        change (Polynomial.C (res_R c_tilde)).comp (Polynomial.X - Polynomial.C (res_R c_tilde)) +
            Polynomial.X.comp (Polynomial.X - Polynomial.C (res_R c_tilde)) =
          Polynomial.X
        rw [Polynomial.C_comp, Polynomial.X_comp]
        ring
      rw [hc, hx]
    have hαS1_unit : IsUnit (α_barS1 h_1) :=
      hαS1_h1 ▸ IsLocalization.map_units L_S ⟨hp_bar, Submonoid.mem_powers hp_bar⟩
    let π_S1 : C_1 →+* L_S := IsLocalization.Away.lift h_1 hαS1_unit
    have hπS1_eq : ∀ y : A_nod, π_S1 (algebraMap A_nod C_1 y) = α_barS1 y :=
      fun y => IsLocalization.Away.lift_eq h_1 hαS1_unit y

    let p_S1 : PrimeSpectrum C_1 := ⟨RingHom.ker π_S1, RingHom.ker_isPrime π_S1⟩
    let y_Sgen : ↥U_bl := ι_1.base p_S1
    have hySgen_Sopen : y_Sgen ∈ S_open := by
      refine ⟨?_, ?_⟩
      · change ((ι_1 ≫ g_Ubl).base p_S1).asIdeal = m_R
        rw [hι1_g]
        ext r
        change π_S1 (algebraMap A_nod C_1 (c_nod r)) = 0 ↔ r ∈ m_R
        rw [hπS1_eq]
        have h1 : α_barS1 (c_nod r) = j_LS (Polynomial.C (res_R r)) :=
          (Ideal.Quotient.lift_mk I_nod α_S1 hαS1_ker).trans (by simp [α_S1, ev10_mv, shift_kR])
        rw [h1, map_eq_zero_iff j_LS hjLS_inj, Polynomial.C_eq_zero, Ideal.Quotient.eq_zero_iff_mem]
      · intro heq
        have hu_mem : u_B ∈ (p_bl.base y_Sgen).asIdeal := by
          rw [Set.mem_singleton_iff.mp heq]
          exact hσ_uB q_max
        have hu1_ker : π_S1 u_1 = 0 := by
          have hu_mem' : u_B ∈ ((ι_1 ≫ p_bl).base p_S1).asIdeal := hu_mem
          rw [hι1_p] at hu_mem'
          have hu_ψ1 : π_S1 (ψ_1 u_B) = 0 := hu_mem'
          rwa [hψ1_uB] at hu_ψ1
        rw [hπS1_eq] at hu1_ker
        have h1 : α_barS1 (mk_nod (MvPolynomial.X 0)) =
            j_LS (Polynomial.X - Polynomial.C (res_R c_tilde)) :=
          (Ideal.Quotient.lift_mk I_nod α_S1 hαS1_ker).trans (by simp [α_S1, ev10_mv, shift_kR])
        rw [h1] at hu1_ker
        exact Polynomial.X_sub_C_ne_zero (res_R c_tilde)
          (hjLS_inj (hu1_ker.trans (map_zero j_LS).symm))

    let Z_S1 : Set (PrimeSpectrum C_1) := closure ({p_S1} : Set (PrimeSpectrum C_1))
    have hZS1_iff : ∀ p_1 : PrimeSpectrum C_1,
        p_1 ∈ Z_S1 ↔ s_1 ∈ p_1.asIdeal ∧ ∀ r ∈ m_R, algebraMap A_nod C_1 (c_nod r) ∈ p_1.asIdeal := by
      intro p_1
      dsimp only [Z_S1]
      rw [PrimeSpectrum.closure_singleton]
      constructor
      · intro hle
        refine ⟨hle ?_, fun r hr => hle ?_⟩
        · change π_S1 s_1 = 0
          rw [hπS1_eq]
          exact (Ideal.Quotient.lift_mk I_nod α_S1 hαS1_ker).trans (by simp [α_S1, ev10_mv, shift_kR])
        · change π_S1 (algebraMap A_nod C_1 (c_nod r)) = 0
          rw [hπS1_eq]
          have hr0 : res_R r = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hr
          exact (Ideal.Quotient.lift_mk I_nod α_S1 hαS1_ker).trans
            (by simp [α_S1, ev10_mv, shift_kR, hr0])
      · rintro ⟨hs1_p1, hmR_p1⟩ z hz
        have hz' : π_S1 z = 0 := hz
        obtain ⟨⟨y0, ⟨_, k, rfl⟩⟩, hzk⟩ := IsLocalization.surj (Submonoid.powers h_1) z
        obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective y0
        dsimp only at hzk
        have hF_shift0 : j_LS (shift_kR (Polynomial.map res_R (ev10_mv F))) = 0 := by
          have hm := congrArg π_S1 hzk
          rw [map_mul, hz', zero_mul, hπS1_eq] at hm
          exact (Ideal.Quotient.lift_mk I_nod α_S1 hαS1_ker).symm.trans hm.symm
        have hF_comp0 : (Polynomial.map res_R (ev10_mv F)).comp
            (Polynomial.X - Polynomial.C (res_R c_tilde)) = 0 :=
          hjLS_inj (hF_shift0.trans (map_zero j_LS).symm)
        have hF_map0 : Polynomial.map res_R (ev10_mv F) = 0 := by
          have hc := congrArg (fun g : Polynomial k_R => g.comp (Polynomial.X + Polynomial.C (res_R c_tilde))) hF_comp0
          rw [Polynomial.zero_comp, Polynomial.comp_assoc] at hc
          have hlin : (Polynomial.X - Polynomial.C (res_R c_tilde)).comp
              (Polynomial.X + Polynomial.C (res_R c_tilde)) = Polynomial.X := by
            rw [Polynomial.sub_comp, Polynomial.X_comp, Polynomial.C_comp, add_sub_cancel_right]
          rwa [hlin, Polynomial.comp_X] at hc
        let q_p1 := Ideal.Quotient.mk p_1.asIdeal
        let ev_q0 : Polynomial ↥R →+* C_1 ⧸ p_1.asIdeal :=
          Polynomial.eval₂RingHom (q_p1.comp ((algebraMap A_nod C_1).comp c_nod)) (q_p1 u_1)
        have hhom_eq : q_p1.comp ((algebraMap A_nod C_1).comp mk_nod) = ev_q0.comp ev10_mv := by
          apply MvPolynomial.ringHom_ext'
          · ext r; simp [ev_q0, ev10_mv, c_nod]
          · intro i
            fin_cases i
            · change q_p1 u_1 = ev_q0 (ev10_mv (MvPolynomial.X 0))
              simp [ev10_mv, ev_q0]
            · change q_p1 s_1 = ev_q0 (ev10_mv (MvPolynomial.X 1))
              simp [ev10_mv, q_p1, Ideal.Quotient.eq_zero_iff_mem.mpr hs1_p1]
        have hev_zero : ev_q0 (ev10_mv F) = 0 := by
          let Q := ev10_mv F
          change ev_q0 Q = 0
          rw [Q.as_sum_support_C_mul_X_pow, map_sum]
          refine Finset.sum_eq_zero fun i _ => ?_
          rw [map_mul]
          have hci_mR : Q.coeff i ∈ m_R := by
            have hci0 : res_R (Q.coeff i) = 0 := by
              rw [← Polynomial.coeff_map, hF_map0, Polynomial.coeff_zero]
            exact Ideal.Quotient.eq_zero_iff_mem.mp hci0
          have hci_q0 : q_p1 (algebraMap A_nod C_1 (c_nod (Q.coeff i))) = 0 :=
            Ideal.Quotient.eq_zero_iff_mem.mpr (hmR_p1 (Q.coeff i) hci_mR)
          have hev_C : ev_q0 (Polynomial.C (Q.coeff i)) =
              q_p1 (algebraMap A_nod C_1 (c_nod (Q.coeff i))) := by simp [ev_q0]
          rw [hev_C, hci_q0, zero_mul]
        have hF_mem : algebraMap A_nod C_1 (mk_nod F) ∈ p_1.asIdeal :=
          Ideal.Quotient.eq_zero_iff_mem.mp ((RingHom.congr_fun hhom_eq F).trans hev_zero)
        have hinv_k : algebraMap A_nod C_1 (h_1 ^ k) *
            (IsLocalization.Away.invSelf (S := C_1) h_1) ^ k = 1 := by
          rw [map_pow, ← mul_pow, IsLocalization.Away.mul_invSelf, one_pow]
        have hz_eq : z = algebraMap A_nod C_1 (mk_nod F) *
            (IsLocalization.Away.invSelf (S := C_1) h_1) ^ k := by
          calc z = z * (algebraMap A_nod C_1 (h_1 ^ k) *
                (IsLocalization.Away.invSelf (S := C_1) h_1) ^ k) := by rw [hinv_k, mul_one]
            _ = (z * algebraMap A_nod C_1 (h_1 ^ k)) *
                (IsLocalization.Away.invSelf (S := C_1) h_1) ^ k := by ring
            _ = _ := by rw [hzk]
        rw [hz_eq]
        exact Ideal.mul_mem_right _ p_1.asIdeal hF_mem

    have hSopen_sub_ZS1 : S_open ⊆ ι_1.base '' Z_S1 := by
      rintro y ⟨hy_mR, hy_ne⟩
      have hy_not0 : y ∉ Set.range ι_0.base := by
        rintro ⟨p_0, rfl⟩
        exact hy_ne (hChart0_Eloc p_0 hy_mR)
      rcases hCov_or y with hy0 | ⟨p_1, rfl⟩
      · exact (hy_not0 hy0).elim
      · have hs1_in : s_1 ∈ p_1.asIdeal := by
          by_contra hs1_not
          exact hy_not0 ((hov1 p_1).mpr hs1_not)
        refine ⟨p_1, (hZS1_iff p_1).mpr ⟨hs1_in, fun r hr => ?_⟩, rfl⟩
        have hr_g : r ∈ ((ι_1 ≫ g_Ubl).base p_1).asIdeal := by
          change r ∈ (g_B.base (p_bl.base (ι_1.base p_1))).asIdeal
          rwa [hy_mR]
        rwa [hι1_g] at hr_g

    have hImgZS1_cl : IsClosed (ι_1.base '' Z_S1) := by
      rw [← isOpen_compl_iff]
      have hcompl_eq : (ι_1.base '' Z_S1)ᶜ = Set.range ι_0.base ∪ ι_1.base '' (Z_S1ᶜ) := by
        ext y
        constructor
        · intro hy_not
          rcases hCov_or y with hy0 | ⟨p_1, rfl⟩
          · left; exact hy0
          · right; exact ⟨p_1, fun hp => hy_not ⟨p_1, hp, rfl⟩, rfl⟩
        · rintro (hy0 | ⟨p_1, hp_not, rfl⟩) ⟨q_1, hq_Z, hq_eq⟩
          · rw [← hq_eq] at hy0
            exact ((hov1 q_1).mp hy0) ((hZS1_iff q_1).mp hq_Z).1
          · exact hp_not (ι_1.isOpenEmbedding.injective hq_eq ▸ hq_Z)
      rw [hcompl_eq]
      exact ι_0.isOpenEmbedding.isOpen_range.union
        (ι_1.isOpenEmbedding.isOpenMap _ isClosed_closure.isOpen_compl)

    have hSstrict_eq_img : S_strict = ι_1.base '' Z_S1 := by
      have h1 : closure ({y_Sgen} : Set ↥U_bl) ⊆ S_strict :=
        closure_mono (Set.singleton_subset_iff.mpr hySgen_Sopen)
      have h2 : S_strict ⊆ ι_1.base '' Z_S1 := closure_minimal hSopen_sub_ZS1 hImgZS1_cl
      have h3 : ι_1.base '' Z_S1 ⊆ closure ({y_Sgen} : Set ↥U_bl) := by
        rintro _ ⟨p_1, hp_1, rfl⟩
        exact closure_mono (by rintro _ ⟨z, hz, rfl⟩; have hz' : z = p_S1 := hz; subst hz'; rfl)
          (image_closure_subset_closure_image ι_1.continuous ⟨p_1, hp_1, rfl⟩)
      exact Set.Subset.antisymm h2 (h3.trans h1)
    have hSstrict_eq_cl : S_strict = closure ({y_Sgen} : Set ↥U_bl) := by
      apply Set.Subset.antisymm
      · rw [hSstrict_eq_img]
        rintro _ ⟨p_1, hp_1, rfl⟩
        exact closure_mono (by rintro _ ⟨z, hz, rfl⟩; have hz' : z = p_S1 := hz; subst hz'; rfl)
          (image_closure_subset_closure_image ι_1.continuous ⟨p_1, hp_1, rfl⟩)
      · exact closure_mono (Set.singleton_subset_iff.mpr hySgen_Sopen)
    have hIrr_Sstrict : IsIrreducible S_strict :=
      hSstrict_eq_cl ▸ (isIrreducible_singleton (x := y_Sgen)).closure

    have hChart1_mR : ∀ p : PrimeSpectrum C_1,
        (g_Ubl.base (ι_1.base p)).asIdeal = m_R →
        (ι_1.base p ∈ S_strict ↔ s_1 ∈ p.asIdeal) ∧
        (ι_1.base p ∈ E_loc ↔ u_1 ∈ p.asIdeal) := by
      intro p hp_mR
      refine ⟨?_, hChart1_Eloc p hp_mR⟩
      have himg_iff : ι_1.base p ∈ ι_1.base '' Z_S1 ↔ p ∈ Z_S1 :=
        ⟨by rintro ⟨q, hq, hqp⟩; exact ι_1.isOpenEmbedding.injective hqp ▸ hq,
         fun hp => ⟨p, hp, rfl⟩⟩
      rw [hSstrict_eq_img, himg_iff, hZS1_iff]
      refine ⟨fun h => h.1, fun hs1 => ⟨hs1, fun r hr => ?_⟩⟩
      have hr_g : r ∈ ((ι_1 ≫ g_Ubl).base p).asIdeal := hp_mR.symm ▸ hr
      rwa [hι1_g] at hr_g

    have hUnion_fib : E_loc ∪ S_strict = {y : ↥U_bl | (g_Ubl.base y).asIdeal = m_R} := by
      ext y
      constructor
      · rintro (hyE | hyS)
        · change (g_B.base (p_bl.base y)).asIdeal = m_R
          have hyx : p_bl.base y = x_max := hyE
          rw [hyx, hqmax_mR]
        · rw [hSstrict_eq_img] at hyS
          obtain ⟨p_1, hp_Z, rfl⟩ := hyS
          have hmR_le : m_R ≤ ((ι_1 ≫ g_Ubl).base p_1).asIdeal := by
            rw [hι1_g]
            exact ((hZS1_iff p_1).mp hp_Z).2
          have hne_top : ((ι_1 ≫ g_Ubl).base p_1).asIdeal ≠ ⊤ := ((ι_1 ≫ g_Ubl).base p_1).isPrime.ne_top
          exact (hmR_max.eq_of_le hne_top hmR_le).symm
      · intro hy_mR
        rcases hCov_or y with ⟨p_0, rfl⟩ | ⟨p_1, rfl⟩
        · exact Or.inl (hChart0_Eloc p_0 hy_mR)
        · have hπ_in : ψ_1 π_B ∈ p_1.asIdeal := by
            have hr_g : π_tilde ∈ ((ι_1 ≫ g_Ubl).base p_1).asIdeal := by
              change π_tilde ∈ (g_Ubl.base (ι_1.base p_1)).asIdeal
              rw [hy_mR]; exact hπ_mem
            rw [hι1_g] at hr_g
            dsimp only [π_B]
            rw [hψ1_C π_tilde]
            exact hr_g
          rw [hψ1_πB] at hπ_in
          rcases p_1.isPrime.mem_or_mem hπ_in with hu1_in | hs1_in
          · exact Or.inl ((hChart1_mR p_1 hy_mR).2.mpr hu1_in)
          · exact Or.inr ((hChart1_mR p_1 hy_mR).1.mpr hs1_in)

    
    let ε_nod0 : MvPolynomial (Fin 2) ↥R →+* k_R := MvPolynomial.eval₂Hom res_R 0
    have hεnod_ker : I_nod ≤ RingHom.ker ε_nod0 := by
      rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
      simp [ε_nod0, hres_π]
    let ε_nod_bar : A_nod →+* k_R := Ideal.Quotient.lift I_nod ε_nod0 hεnod_ker
    have hεnod_h1 : ε_nod_bar h_1 = res_R (Polynomial.eval c_tilde h_p) := by
      rw [hh1_def]
      change ε_nod0 (Polynomial.eval₂ MvPolynomial.C (MvPolynomial.C c_tilde + MvPolynomial.X 0) h_p) =
        res_R (Polynomial.eval₂ (RingHom.id ↥R) c_tilde h_p)
      rw [Polynomial.hom_eval₂, Polynomial.hom_eval₂]
      have hc : ε_nod0.comp MvPolynomial.C = res_R.comp (RingHom.id ↥R) := by ext r; simp [ε_nod0]
      have hx : ε_nod0 (MvPolynomial.C c_tilde + MvPolynomial.X 0) = res_R c_tilde := by simp [ε_nod0]
      rw [hc, hx]
    have hεnod_unit : IsUnit (ε_nod_bar h_1) := hεnod_h1 ▸ RingHom.isUnit_map res_R hh_p_unit
    let ε_nod : C_1 →+* k_R := IsLocalization.Away.lift h_1 hεnod_unit
    have hεnod_eq : ∀ y : A_nod, ε_nod (algebraMap A_nod C_1 y) = ε_nod_bar y :=
      fun y => IsLocalization.Away.lift_eq h_1 hεnod_unit y
    have hSurj_εnod : Function.Surjective ε_nod := by
      intro z
      obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective z
      refine ⟨algebraMap A_nod C_1 (c_nod r), ?_⟩
      rw [hεnod_eq]
      exact (Ideal.Quotient.lift_mk I_nod ε_nod0 hεnod_ker).trans (by simp [ε_nod0]; rfl)
    let p_nod : PrimeSpectrum C_1 := ⟨RingHom.ker ε_nod, RingHom.ker_isPrime ε_nod⟩
    have hpnod_max : p_nod.asIdeal.IsMaximal :=
      RingHom.ker_isMaximal_of_surjective ε_nod hSurj_εnod
    let y_nod : ↥U_bl := ι_1.base p_nod
    have hynod_mR : (g_Ubl.base y_nod).asIdeal = m_R := by
      change ((ι_1 ≫ g_Ubl).base p_nod).asIdeal = m_R
      rw [hι1_g]
      ext r
      change ε_nod (algebraMap A_nod C_1 (c_nod r)) = 0 ↔ r ∈ m_R
      rw [hεnod_eq]
      have h1 : ε_nod_bar (c_nod r) = res_R r :=
        (Ideal.Quotient.lift_mk I_nod ε_nod0 hεnod_ker).trans (by simp [ε_nod0])
      rw [h1, Ideal.Quotient.eq_zero_iff_mem]
    have hu1_pnod : u_1 ∈ p_nod.asIdeal := by
      change ε_nod u_1 = 0
      rw [hεnod_eq]
      exact (Ideal.Quotient.lift_mk I_nod ε_nod0 hεnod_ker).trans (by simp [ε_nod0])
    have hs1_pnod : s_1 ∈ p_nod.asIdeal := by
      change ε_nod s_1 = 0
      rw [hεnod_eq]
      exact (Ideal.Quotient.lift_mk I_nod ε_nod0 hεnod_ker).trans (by simp [ε_nod0])
    have hynod_in : y_nod ∈ E_loc ∧ y_nod ∈ S_strict :=
      ⟨(hChart1_mR p_nod hynod_mR).2.mpr hu1_pnod, (hChart1_mR p_nod hynod_mR).1.mpr hs1_pnod⟩
    have hynod_uniq : ∀ y' : ↥U_bl, y' ∈ E_loc ∧ y' ∈ S_strict → y' = y_nod := by
      rintro y' ⟨hy'E, hy'S⟩
      have hy'_mR : (g_Ubl.base y').asIdeal = m_R := by
        have hmem : y' ∈ E_loc ∪ S_strict := Or.inl hy'E
        rwa [hUnion_fib] at hmem
      rw [hSstrict_eq_img] at hy'S
      obtain ⟨p', _, rfl⟩ := hy'S
      have hu1_p' : u_1 ∈ p'.asIdeal := (hChart1_mR p' hy'_mR).2.mp hy'E
      have hs1_p' : s_1 ∈ p'.asIdeal := (hChart1_mR p' hy'_mR).1.mp
        (hSstrict_eq_img.symm ▸ ⟨p', ‹p' ∈ Z_S1›, rfl⟩)
      have hle : p_nod.asIdeal ≤ p'.asIdeal := by
        intro z hz
        rw [RingHom.mem_ker] at hz
        obtain ⟨⟨y0, ⟨_, k, rfl⟩⟩, hzk⟩ := IsLocalization.surj (Submonoid.powers h_1) z
        obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective y0
        dsimp only at hzk
        have hF0_mR : MvPolynomial.eval 0 F ∈ m_R := by
          have hm := congrArg ε_nod hzk
          rw [map_mul, hz, zero_mul, hεnod_eq] at hm
          have h0 : ε_nod0 F = 0 :=
            (Ideal.Quotient.lift_mk I_nod ε_nod0 hεnod_ker).symm.trans hm.symm
          have hev_eq : ε_nod0 = res_R.comp (MvPolynomial.eval 0) := by
            apply MvPolynomial.ringHom_ext'
            · ext r; simp [ε_nod0]
            · intro i; simp [ε_nod0]
          exact Ideal.Quotient.eq_zero_iff_mem.mp ((RingHom.congr_fun hev_eq F).symm.trans h0)
        let q_p' := Ideal.Quotient.mk p'.asIdeal
        have hhom_eq : q_p'.comp ((algebraMap A_nod C_1).comp mk_nod) =
            (q_p'.comp ((algebraMap A_nod C_1).comp c_nod)).comp (MvPolynomial.eval 0) := by
          apply MvPolynomial.ringHom_ext'
          · ext r; simp [c_nod]
          · intro i
            fin_cases i
            · change q_p' u_1 = _
              simp [q_p', Ideal.Quotient.eq_zero_iff_mem.mpr hu1_p']
            · change q_p' s_1 = _
              simp [q_p', Ideal.Quotient.eq_zero_iff_mem.mpr hs1_p']
        have hc_p' : algebraMap A_nod C_1 (c_nod (MvPolynomial.eval 0 F)) ∈ p'.asIdeal := by
          have hr_g : MvPolynomial.eval 0 F ∈ ((ι_1 ≫ g_Ubl).base p').asIdeal := by
            change MvPolynomial.eval 0 F ∈ (g_Ubl.base (ι_1.base p')).asIdeal
            rwa [hy'_mR]
          rwa [hι1_g] at hr_g
        have hF_mem : algebraMap A_nod C_1 (mk_nod F) ∈ p'.asIdeal := by
          apply Ideal.Quotient.eq_zero_iff_mem.mp
          exact (RingHom.congr_fun hhom_eq F).trans (Ideal.Quotient.eq_zero_iff_mem.mpr hc_p')
        have hinv_k : algebraMap A_nod C_1 (h_1 ^ k) *
            (IsLocalization.Away.invSelf (S := C_1) h_1) ^ k = 1 := by
          rw [map_pow, ← mul_pow, IsLocalization.Away.mul_invSelf, one_pow]
        have hz_eq : z = algebraMap A_nod C_1 (mk_nod F) *
            (IsLocalization.Away.invSelf (S := C_1) h_1) ^ k := by
          calc z = z * (algebraMap A_nod C_1 (h_1 ^ k) *
                (IsLocalization.Away.invSelf (S := C_1) h_1) ^ k) := by rw [hinv_k, mul_one]
            _ = (z * algebraMap A_nod C_1 (h_1 ^ k)) *
                (IsLocalization.Away.invSelf (S := C_1) h_1) ^ k := by ring
            _ = _ := by rw [hzk]
        rw [hz_eq]
        exact Ideal.mul_mem_right _ p'.asIdeal hF_mem
      have hp_eq : p' = p_nod := PrimeSpectrum.ext (hpnod_max.eq_of_le p'.isPrime.ne_top hle).symm
      exact congrArg ι_1.base hp_eq

    exact ⟨q_max, hqmax_mR, hCl_Eloc, hIrr_Eloc, hCl_Sstrict, hIrr_Sstrict, hUnion_fib,
      ⟨y_nod, hynod_in, hynod_uniq⟩, hChart0_mR, hChart1_mR⟩

  exact ⟨Q₀_R, U_bl, g_Ubl, p_bl, σ_loc, τ₀_loc, τ₁_loc, h_1, ι_0, ι_1, ψ_0, ψ_1,
    hQ0_ne_bot, hπ_Q0, hSm_gB, hInt_Ubl, rfl, hProp_pbl, hFlat_Ubl, hLfp_Ubl,
    hσ_gB, hσ_uB, hτ0_p, hτ1_p, hDisj_τ, ⟨hMod_cl, hIso_compl⟩, hC15,
    hh0_eval, hh1_not_Jmax, hOpen_ι0, hOpen_ι1, hCov_union, hι0_p, hι1_p,
    hψ0_C, hψ0_X, hψ1_C, hψ1_X, hFieldLift, hC28⟩

theorem weil_valuationSubring_jointRadical_and_nodalAway_flat_fpres (K : Type u) [Field K] (R : ValuationSubring K) (π_tilde b' : ↥R)
    (hπ_ne : π_tilde ≠ 0) (hπ_mem : π_tilde ∈ IsLocalRing.maximalIdeal ↥R)
    (hb'_ne : b' ≠ 0) (hb'_mem : b' ∈ IsLocalRing.maximalIdeal ↥R) :
    (∃ Q₀_R : PrimeSpectrum ↥R,
      Q₀_R.asIdeal ≠ ⊥ ∧
      π_tilde ∈ Q₀_R.asIdeal ∧
      b' ∈ Q₀_R.asIdeal ∧
      Q₀_R.asIdeal ≤ IsLocalRing.maximalIdeal ↥R ∧
      ∀ P : PrimeSpectrum ↥R,
        (π_tilde ∈ P.asIdeal ∧ b' ∈ P.asIdeal) ↔ Q₀_R.asIdeal ≤ P.asIdeal) ∧
    (∀ (a : ↥R) (h : weilNodalQuot ↥R a),
      a ≠ 0 → h ≠ 0 →
      let φ_Ra : ↥R →+* Localization.Away h :=
        (algebraMap (weilNodalQuot ↥R a) (Localization.Away h)).comp
          ((Ideal.Quotient.mk (weilNodalIdeal ↥R a)).comp MvPolynomial.C)
      IsDomain (Localization.Away h) ∧
      AlgebraicGeometry.Flat (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_Ra)) ∧
      AlgebraicGeometry.LocallyOfFinitePresentation
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_Ra))) ∧
    (∀ h_poly : Polynomial ↥R, h_poly ≠ 0 → Nontrivial (Localization.Away h_poly)) :=
by
  have _ := hb'_ne
  refine ⟨?_, ?_, ?_⟩
  · let m_R : Ideal ↥R := IsLocalRing.maximalIdeal ↥R
    have hmR_max : m_R.IsMaximal := IsLocalRing.maximalIdeal.isMaximal ↥R
    have hmR_prime : m_R.IsPrime := hmR_max.isPrime
    let I₀ : Ideal ↥R := Ideal.span ({π_tilde, b'} : Set ↥R)
    let J₀ : Ideal ↥R := I₀.radical
    have hπ_J₀ : π_tilde ∈ J₀ := Ideal.le_radical (Ideal.subset_span (by simp))
    have hb'_J₀ : b' ∈ J₀ := Ideal.le_radical (Ideal.subset_span (by simp))
    have hJ₀_ne_bot : J₀ ≠ ⊥ := by
      intro hbot
      apply hπ_ne
      rw [← Ideal.mem_bot, ← hbot]
      exact hπ_J₀
    have hI₀_le_mR : I₀ ≤ m_R := by
      rw [Ideal.span_le, Set.insert_subset_iff, Set.singleton_subset_iff]
      exact ⟨hπ_mem, hb'_mem⟩
    have hJ₀_le_mR : J₀ ≤ m_R := by
      calc J₀ = I₀.radical := rfl
        _ ≤ m_R.radical := Ideal.radical_mono hI₀_le_mR
        _ = m_R := hmR_prime.radical
    have hJ₀_ne_top : J₀ ≠ ⊤ := by
      intro htop
      apply hmR_prime.ne_top
      exact top_unique (htop ▸ hJ₀_le_mR)
    have hJ₀_prime : J₀.IsPrime := by
      refine ⟨hJ₀_ne_top, ?_⟩
      intro x y hxy
      obtain ⟨n, hn⟩ := Ideal.mem_radical_iff.mp hxy
      rcases ValuationRing.dvd_total x y with ⟨c, hy⟩ | ⟨c, hx⟩
      · right
        refine Ideal.mem_radical_iff.mpr ⟨2 * n, ?_⟩
        have heq : y ^ (2 * n) = c ^ n * (x * y) ^ n := by
          calc y ^ (2 * n)
              = (x * c) ^ (2 * n) := by rw [hy]
            _ = ((x * c) ^ 2) ^ n := by rw [pow_mul]
            _ = (c * (x * (x * c))) ^ n := by congr 1; ring
            _ = c ^ n * (x * (x * c)) ^ n := by rw [mul_pow]
            _ = c ^ n * (x * y) ^ n := by rw [← hy]
        rw [heq]
        exact I₀.mul_mem_left (c ^ n) hn
      · left
        refine Ideal.mem_radical_iff.mpr ⟨2 * n, ?_⟩
        have heq : x ^ (2 * n) = c ^ n * (x * y) ^ n := by
          calc x ^ (2 * n)
              = (y * c) ^ (2 * n) := by rw [hx]
            _ = ((y * c) ^ 2) ^ n := by rw [pow_mul]
            _ = (c * ((y * c) * y)) ^ n := by congr 1; ring
            _ = c ^ n * ((y * c) * y) ^ n := by rw [mul_pow]
            _ = c ^ n * (x * y) ^ n := by rw [← hx]
        rw [heq]
        exact I₀.mul_mem_left (c ^ n) hn
    refine ⟨⟨J₀, hJ₀_prime⟩, hJ₀_ne_bot, hπ_J₀, hb'_J₀, hJ₀_le_mR, ?_⟩
    intro P
    constructor
    · rintro ⟨hπ_P, hb'_P⟩
      have hI₀_le_P : I₀ ≤ P.asIdeal := by
        rw [Ideal.span_le, Set.insert_subset_iff, Set.singleton_subset_iff]
        exact ⟨hπ_P, hb'_P⟩
      calc J₀ = I₀.radical := rfl
        _ ≤ P.asIdeal.radical := Ideal.radical_mono hI₀_le_P
        _ = P.asIdeal := P.isPrime.radical
    · intro hle
      exact ⟨hle hπ_J₀, hle hb'_J₀⟩
  · intro a h ha hh
    dsimp only
    let φ_Ra : ↥R →+* Localization.Away h :=
      (algebraMap (weilNodalQuot ↥R a) (Localization.Away h)).comp
        ((Ideal.Quotient.mk (weilNodalIdeal ↥R a)).comp MvPolynomial.C)
    let I_a : Ideal (MvPolynomial (Fin 2) ↥R) := weilNodalIdeal ↥R a
    let A_a : Type u := weilNodalQuot ↥R a
    let mk : MvPolynomial (Fin 2) ↥R →+* A_a := Ideal.Quotient.mk I_a
    let ι_R : ↥R →+* A_a := mk.comp MvPolynomial.C
    let u : A_a := mk (MvPolynomial.X 0)
    let v : A_a := mk (MvPolynomial.X 1)
    have huv : u * v = ι_R a := by
      have hmem : MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a ∈ I_a :=
        Ideal.subset_span rfl
      have hzero : mk (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr hmem
      rw [map_sub, map_mul] at hzero
      exact sub_eq_zero.mp hzero
    let ev₀ : Polynomial ↥R →+* A_a := Polynomial.eval₂RingHom ι_R u
    let ev₁ : Polynomial ↥R →+* A_a := Polynomial.eval₂RingHom ι_R v
    have hev₀_C : ∀ c : ↥R, ev₀ (Polynomial.C c) = ι_R c := fun c => by simp [ev₀]
    have hev₁_C : ∀ c : ↥R, ev₁ (Polynomial.C c) = ι_R c := fun c => by simp [ev₁]
    have hev₀_X : ev₀ Polynomial.X = u := by simp [ev₀]
    have hev₁_X : ev₁ Polynomial.X = v := by simp [ev₁]
    have hdivX₀ : ∀ G : Polynomial ↥R,
        ev₀ G = ev₀ G.divX * u + ι_R (G.coeff 0) := by
      intro G
      conv_lhs => rw [← Polynomial.divX_mul_X_add G]
      rw [map_add, map_mul, hev₀_X, hev₀_C]
    have hdivX₁ : ∀ G : Polynomial ↥R,
        ev₁ G = ev₁ G.divX * v + ι_R (G.coeff 0) := by
      intro G
      conv_lhs => rw [← Polynomial.divX_mul_X_add G]
      rw [map_add, map_mul, hev₁_X, hev₁_C]
    have hNF : ∀ F : MvPolynomial (Fin 2) ↥R,
        ∃ P Q : Polynomial ↥R, mk F = ev₀ P + v * ev₁ Q := by
      intro F
      refine MvPolynomial.induction_on
        (motive := fun F => ∃ P Q : Polynomial ↥R, mk F = ev₀ P + v * ev₁ Q) F
        (fun c => ?_) (fun F₁ F₂ ih₁ ih₂ => ?_) (fun F₀ i ih => ?_)
      · refine ⟨Polynomial.C c, 0, ?_⟩
        rw [hev₀_C, map_zero, mul_zero, add_zero]
        rfl
      · obtain ⟨P₁, Q₁, h₁⟩ := ih₁
        obtain ⟨P₂, Q₂, h₂⟩ := ih₂
        refine ⟨P₁ + P₂, Q₁ + Q₂, ?_⟩
        rw [map_add, h₁, h₂, map_add, map_add]
        ring
      · obtain ⟨P, Q, h₀⟩ := ih
        fin_cases i
        · refine ⟨P * Polynomial.X + Polynomial.C (a * Q.coeff 0),
            Polynomial.C a * Q.divX, ?_⟩
          change mk (F₀ * MvPolynomial.X 0) = _
          have hmkX0 : mk (MvPolynomial.X (0 : Fin 2)) = u := rfl
          rw [map_mul, h₀, hmkX0, hdivX₁ Q, map_add, map_mul, hev₀_X, hev₀_C, map_mul,
            map_mul, hev₁_C]
          linear_combination (ev₁ Q.divX * v + ι_R (Q.coeff 0)) * huv
        · refine ⟨Polynomial.C a * P.divX,
            Polynomial.C (P.coeff 0) + Q * Polynomial.X, ?_⟩
          change mk (F₀ * MvPolynomial.X 1) = _
          have hmkX1 : mk (MvPolynomial.X (1 : Fin 2)) = v := rfl
          rw [map_mul, h₀, hmkX1, hdivX₀ P, map_mul, hev₀_C, map_add, hev₁_C, map_mul, hev₁_X]
          linear_combination ev₀ P.divX * huv
    let X_pol : Polynomial ↥R := Polynomial.X
    have hX_nzd : Submonoid.powers X_pol ≤ nonZeroDivisors (Polynomial ↥R) :=
      Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero Polynomial.X_ne_zero)
    let L : Type u := Localization.Away X_pol
    let α : Polynomial ↥R →+* L := algebraMap (Polynomial ↥R) L
    letI hDom_L : IsDomain L := IsLocalization.isDomain_localization hX_nzd
    have hα_inj : Function.Injective α := IsLocalization.injective L hX_nzd
    let t : L := α Polynomial.X
    let t_inv : L := IsLocalization.Away.invSelf (S := L) X_pol
    have ht_inv : t * t_inv = 1 := IsLocalization.Away.mul_invSelf (S := L) X_pol
    let Φ_tilde : MvPolynomial (Fin 2) ↥R →+* L :=
      MvPolynomial.eval₂Hom (α.comp Polynomial.C) ![t, α (Polynomial.C a) * t_inv]
    have hI_ker : ∀ f ∈ I_a, Φ_tilde f = 0 := by
      intro f hf
      change f ∈ RingHom.ker Φ_tilde
      refine Ideal.span_le.mpr ?_ hf
      rw [Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
      simp only [Φ_tilde, map_sub, map_mul, MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_X,
        MvPolynomial.eval₂_C, RingHom.comp_apply, Matrix.cons_val_zero, Matrix.cons_val_one]
      linear_combination α (Polynomial.C a) * ht_inv
    let Φ : A_a →+* L := Ideal.Quotient.lift I_a Φ_tilde hI_ker
    have hΦ_C : ∀ c : ↥R, Φ (ι_R c) = α (Polynomial.C c) := by
      intro c
      change Ideal.Quotient.lift I_a Φ_tilde hI_ker (Ideal.Quotient.mk I_a (MvPolynomial.C c)) = _
      rw [Ideal.Quotient.lift_mk]
      simp [Φ_tilde]
    have hΦ_u : Φ u = t := by
      change Ideal.Quotient.lift I_a Φ_tilde hI_ker (Ideal.Quotient.mk I_a (MvPolynomial.X 0)) = t
      rw [Ideal.Quotient.lift_mk]
      simp [Φ_tilde]
    have hΦ_v : Φ v = α (Polynomial.C a) * t_inv := by
      change Ideal.Quotient.lift I_a Φ_tilde hI_ker (Ideal.Quotient.mk I_a (MvPolynomial.X 1)) = _
      rw [Ideal.Quotient.lift_mk]
      simp [Φ_tilde]
    have hΦ_ev₀ : ∀ P : Polynomial ↥R, Φ (ev₀ P) = α P := by
      have hext : Φ.comp ev₀ = α := by
        apply Polynomial.ringHom_ext'
        · ext c
          simp [RingHom.comp_apply, hev₀_C, hΦ_C]
        · simp [RingHom.comp_apply, hev₀_X, hΦ_u, t]
      intro P
      exact RingHom.congr_fun hext P
    have hΦ_inj : Function.Injective Φ := by
      rw [injective_iff_map_eq_zero]
      intro z hz
      obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective z
      obtain ⟨P, Q, hPQ⟩ := hNF F
      change mk F = 0
      rw [hPQ] at hz ⊢
      let N : ℕ := Q.natDegree + 1
      have hpow_cancel : ∀ m : ℕ, m < N → t ^ N * t_inv ^ (m + 1) = t ^ (N - 1 - m) := by
        intro m hm
        have hN_eq : N = (N - 1 - m) + (m + 1) := by omega
        calc t ^ N * t_inv ^ (m + 1)
            = t ^ ((N - 1 - m) + (m + 1)) * t_inv ^ (m + 1) := by rw [← hN_eq]
          _ = t ^ (N - 1 - m) * (t ^ (m + 1) * t_inv ^ (m + 1)) := by rw [pow_add, mul_assoc]
          _ = t ^ (N - 1 - m) * (t * t_inv) ^ (m + 1) := by rw [← mul_pow]
          _ = t ^ (N - 1 - m) := by rw [ht_inv, one_pow, mul_one]
      have hQ_sum : Q = ∑ m ∈ Finset.range N, Polynomial.C (Q.coeff m) * Polynomial.X ^ m := by
        conv_lhs => rw [Polynomial.as_sum_range' Q N (Nat.lt_succ_self Q.natDegree)]
        refine Finset.sum_congr rfl fun m _ => ?_
        exact (Polynomial.C_mul_X_pow_eq_monomial).symm
      have hQ_term : t ^ N * Φ (v * ev₁ Q) =
          α (∑ m ∈ Finset.range N,
            Polynomial.C (Q.coeff m * a ^ (m + 1)) * Polynomial.X ^ (N - 1 - m)) := by
        conv_lhs => rw [hQ_sum]
        rw [map_sum, Finset.mul_sum, map_sum, Finset.mul_sum, map_sum]
        refine Finset.sum_congr rfl fun m hm => ?_
        have hm_lt : m < N := Finset.mem_range.mp hm
        rw [map_mul ev₁, map_pow ev₁, hev₁_C, hev₁_X, map_mul Φ, map_mul Φ, map_pow Φ, hΦ_v, hΦ_C]
        have h_alg : t ^ N * (α (Polynomial.C a) * t_inv *
              (α (Polynomial.C (Q.coeff m)) * (α (Polynomial.C a) * t_inv) ^ m)) =
            (α (Polynomial.C (Q.coeff m)) * α (Polynomial.C a) ^ (m + 1)) *
              (t ^ N * t_inv ^ (m + 1)) := by
          rw [mul_pow]
          ring
        rw [h_alg, hpow_cancel m hm_lt]
        simp only [t, map_mul, map_pow]
      let R_clr : Polynomial ↥R :=
        P * Polynomial.X ^ N +
          ∑ m ∈ Finset.range N,
            Polynomial.C (Q.coeff m * a ^ (m + 1)) * Polynomial.X ^ (N - 1 - m)
      have hR_clr_zero : R_clr = 0 := by
        have hz' : Φ (ev₀ P) + Φ (v * ev₁ Q) = 0 := by rwa [map_add] at hz
        apply hα_inj
        rw [map_zero]
        dsimp only [R_clr]
        rw [map_add, map_mul, map_pow, ← hQ_term, ← hΦ_ev₀ P]
        dsimp only [t]
        linear_combination t ^ N * hz'
      have hP_zero : P = 0 := by
        apply Polynomial.ext
        intro k
        rw [Polynomial.coeff_zero]
        have hk_coeff : R_clr.coeff (k + N) = 0 := by rw [hR_clr_zero, Polynomial.coeff_zero]
        dsimp only [R_clr] at hk_coeff
        rw [Polynomial.coeff_add, Polynomial.coeff_mul_X_pow, Polynomial.finsetSum_coeff] at hk_coeff
        have hsum_zero : (∑ m ∈ Finset.range N,
            (Polynomial.C (Q.coeff m * a ^ (m + 1)) * Polynomial.X ^ (N - 1 - m)).coeff (k + N)) = 0 := by
          refine Finset.sum_eq_zero fun m hm => ?_
          have hm_lt : m < N := Finset.mem_range.mp hm
          rw [Polynomial.coeff_C_mul_X_pow]
          have hne : k + N ≠ N - 1 - m := by omega
          simp [hne]
        rw [hsum_zero, add_zero] at hk_coeff
        exact hk_coeff
      have hQ_zero : Q = 0 := by
        have hsum_poly_zero : (∑ m ∈ Finset.range N,
            Polynomial.C (Q.coeff m * a ^ (m + 1)) * Polynomial.X ^ (N - 1 - m)) = 0 := by
          have hR' := hR_clr_zero
          dsimp only [R_clr] at hR'
          rwa [hP_zero, zero_mul, zero_add] at hR'
        apply Polynomial.ext
        intro m₀
        rw [Polynomial.coeff_zero]
        by_cases hm₀ : m₀ < N
        · have hc : (∑ m ∈ Finset.range N,
              Polynomial.C (Q.coeff m * a ^ (m + 1)) * Polynomial.X ^ (N - 1 - m)).coeff (N - 1 - m₀) = 0 := by
            rw [hsum_poly_zero, Polynomial.coeff_zero]
          rw [Polynomial.finsetSum_coeff] at hc
          have hsingle : (∑ m ∈ Finset.range N,
              (Polynomial.C (Q.coeff m * a ^ (m + 1)) * Polynomial.X ^ (N - 1 - m)).coeff (N - 1 - m₀)) =
              Q.coeff m₀ * a ^ (m₀ + 1) := by
            rw [Finset.sum_eq_single m₀]
            · rw [Polynomial.coeff_C_mul_X_pow, ite_eq_left_iff.mpr (fun h => absurd rfl h)]
            · intro m hm hm_ne
              have hm_lt : m < N := Finset.mem_range.mp hm
              rw [Polynomial.coeff_C_mul_X_pow]
              have hne : N - 1 - m₀ ≠ N - 1 - m := by omega
              simp [hne]
            · intro hnot
              exact absurd (Finset.mem_range.mpr hm₀) hnot
          rw [hsingle] at hc
          exact (mul_eq_zero.mp hc).resolve_right (pow_ne_zero (m₀ + 1) ha)
        · have hm₀_gt : Q.natDegree < m₀ := by dsimp only [N] at hm₀; omega
          exact Polynomial.coeff_eq_zero_of_natDegree_lt hm₀_gt
      rw [hP_zero, hQ_zero, map_zero, map_zero, mul_zero, add_zero]
    letI hDom_Aa : IsDomain A_a := Function.Injective.isDomain Φ hΦ_inj
    have hh_nzd : Submonoid.powers h ≤ nonZeroDivisors A_a :=
      Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hh)
    letI hDom_Away : IsDomain (Localization.Away h) :=
      IsLocalization.isDomain_localization hh_nzd
    have hLoc_inj : Function.Injective (algebraMap A_a (Localization.Away h)) :=
      IsLocalization.injective (Localization.Away h) hh_nzd
    have hιR_inj : Function.Injective ι_R := by
      intro c₁ c₂ hc
      apply Polynomial.C_injective
      apply hα_inj
      rw [← hΦ_C c₁, ← hΦ_C c₂, hc]
    have hφ_inj : Function.Injective φ_Ra := hLoc_inj.comp hιR_inj
    have hFlat_of_inj : ∀ (S : Type u) [CommRing S] [IsDomain S] (f : ↥R →+* S),
        Function.Injective f → f.Flat := by
      intro S _ _ f hf
      letI : Algebra ↥R S := f.toAlgebra
      rw [← RingHom.algebraMap_toAlgebra f, RingHom.flat_algebraMap_iff,
        Module.Flat.flat_iff_torsion_eq_bot_of_isBezout,
        ← Submodule.isTorsionFree_iff_torsion_eq_bot,
        Module.isTorsionFree_iff_algebraMap_injective, RingHom.algebraMap_toAlgebra f]
      exact hf
    have hFlat_φ : φ_Ra.Flat := hFlat_of_inj (Localization.Away h) φ_Ra hφ_inj
    have hSpec_flat : AlgebraicGeometry.Flat (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_Ra)) := by
      rw [@AlgebraicGeometry.HasRingHomProperty.Spec_iff @AlgebraicGeometry.Flat _
        AlgebraicGeometry.Flat.instHasRingHomPropertyFlat, CommRingCat.hom_ofHom]
      exact hFlat_φ
    have hf₁_fp : (MvPolynomial.C : ↥R →+* MvPolynomial (Fin 2) ↥R).FinitePresentation := by
      haveI : Algebra.FinitePresentation ↥R (MvPolynomial (Fin 2) ↥R) :=
        Algebra.FinitePresentation.mvPolynomial ↥R ↥R (Fin 2)
      rw [← MvPolynomial.algebraMap_eq]
      exact RingHom.finitePresentation_algebraMap.mpr inferInstance
    have hf₂_fp : mk.FinitePresentation := by
      refine RingHom.FinitePresentation.of_surjective mk Ideal.Quotient.mk_surjective ?_
      rw [Ideal.mk_ker]
      exact Submodule.fg_span_singleton (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a)
    have hf₃_fp : (algebraMap A_a (Localization.Away h)).FinitePresentation := by
      haveI : Algebra.FinitePresentation A_a (Localization.Away h) :=
        IsLocalization.Away.finitePresentation h
      exact RingHom.finitePresentation_algebraMap.mpr inferInstance
    have hφ_fp : φ_Ra.FinitePresentation := hf₃_fp.comp (hf₂_fp.comp hf₁_fp)
    have hSpec_lfp : AlgebraicGeometry.LocallyOfFinitePresentation
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_Ra)) := by
      rw [@AlgebraicGeometry.HasRingHomProperty.Spec_iff
        @AlgebraicGeometry.LocallyOfFinitePresentation _
        AlgebraicGeometry.instHasRingHomPropertyLocallyOfFinitePresentationFinitePresentation,
        CommRingCat.hom_ofHom]
      exact hφ_fp
    exact ⟨hDom_Away, hSpec_flat, hSpec_lfp⟩
  · intro h_poly hh_poly
    have hh_nzd : Submonoid.powers h_poly ≤ nonZeroDivisors (Polynomial ↥R) :=
      Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hh_poly)
    letI : IsDomain (Localization.Away h_poly) :=
      IsLocalization.isDomain_localization hh_nzd
    infer_instance

theorem weil_nodal_subdiv_chart_overlap_and_fourOpen_algebra (R₀ : Type u) [CommRing R₀] (π_tilde b' : R₀)
    (P_h : MvPolynomial (Fin 2) R₀)
    (h_e : weilNodalQuot R₀ (b' * π_tilde))
    (h_0 : weilNodalQuot R₀ π_tilde)
    (h_1 : weilNodalQuot R₀ b')
    (h_01 : Polynomial R₀)
    (hh_e_eq : h_e = Ideal.Quotient.mk (weilNodalIdeal R₀ (b' * π_tilde)) P_h)
    (hh_0_eq : h_0 = Ideal.Quotient.mk (weilNodalIdeal R₀ π_tilde)
      (MvPolynomial.eval₂Hom MvPolynomial.C
        ![MvPolynomial.X 0, MvPolynomial.C b' * MvPolynomial.X 1] P_h))
    (hh_1_eq : h_1 = Ideal.Quotient.mk (weilNodalIdeal R₀ b')
      (MvPolynomial.eval₂Hom MvPolynomial.C
        ![MvPolynomial.C π_tilde * MvPolynomial.X 0, MvPolynomial.X 1] P_h))
    (hh_01_eq : h_01 = Polynomial.X * ∑ d ∈ P_h.support,
      Polynomial.C (P_h.coeff d * π_tilde ^ (d 0) * b' ^ (d 1)) *
        Polynomial.X ^ (d 0 + (P_h.totalDegree - d 1))) :
    let g_0 : Localization.Away h_0 :=
      algebraMap (weilNodalQuot R₀ π_tilde) (Localization.Away h_0)
        (Ideal.Quotient.mk (weilNodalIdeal R₀ π_tilde) (MvPolynomial.X 1))
    let g_1 : Localization.Away h_1 :=
      algebraMap (weilNodalQuot R₀ b') (Localization.Away h_1)
        (Ideal.Quotient.mk (weilNodalIdeal R₀ b') (MvPolynomial.X 0))
    let d_0 : Localization.Away h_e :=
      algebraMap (weilNodalQuot R₀ (b' * π_tilde)) (Localization.Away h_e)
        (Ideal.Quotient.mk (weilNodalIdeal R₀ (b' * π_tilde)) (MvPolynomial.X 0))
    let d_1 : Localization.Away h_e :=
      algebraMap (weilNodalQuot R₀ (b' * π_tilde)) (Localization.Away h_e)
        (Ideal.Quotient.mk (weilNodalIdeal R₀ (b' * π_tilde)) (MvPolynomial.X 1))
    let d_2 : Localization.Away h_e :=
      algebraMap (weilNodalQuot R₀ (b' * π_tilde)) (Localization.Away h_e)
        (Ideal.Quotient.mk (weilNodalIdeal R₀ (b' * π_tilde)) (MvPolynomial.C π_tilde))
    let d_3 : Localization.Away h_e :=
      algebraMap (weilNodalQuot R₀ (b' * π_tilde)) (Localization.Away h_e)
        (Ideal.Quotient.mk (weilNodalIdeal R₀ (b' * π_tilde)) (MvPolynomial.C b'))
    ∃ (ψ_0 : Localization.Away h_e →+* Localization.Away h_0)
      (ψ_1 : Localization.Away h_e →+* Localization.Away h_1)
      (f₀₁ : Localization.Away h_0 →+* Localization.Away h_01)
      (f₁₀ : Localization.Away h_1 →+* Localization.Away h_01),
      ((∀ r : R₀,
          ψ_0 (algebraMap (weilNodalQuot R₀ (b' * π_tilde)) (Localization.Away h_e)
              (Ideal.Quotient.mk (weilNodalIdeal R₀ (b' * π_tilde)) (MvPolynomial.C r))) =
            algebraMap (weilNodalQuot R₀ π_tilde) (Localization.Away h_0)
              (Ideal.Quotient.mk (weilNodalIdeal R₀ π_tilde) (MvPolynomial.C r))) ∧
        ψ_0 d_0 =
          algebraMap (weilNodalQuot R₀ π_tilde) (Localization.Away h_0)
            (Ideal.Quotient.mk (weilNodalIdeal R₀ π_tilde) (MvPolynomial.X 0)) ∧
        ψ_0 d_1 =
          algebraMap (weilNodalQuot R₀ π_tilde) (Localization.Away h_0)
            (Ideal.Quotient.mk (weilNodalIdeal R₀ π_tilde)
              (MvPolynomial.C b' * MvPolynomial.X 1)) ∧
        (∀ r : R₀,
          ψ_1 (algebraMap (weilNodalQuot R₀ (b' * π_tilde)) (Localization.Away h_e)
              (Ideal.Quotient.mk (weilNodalIdeal R₀ (b' * π_tilde)) (MvPolynomial.C r))) =
            algebraMap (weilNodalQuot R₀ b') (Localization.Away h_1)
              (Ideal.Quotient.mk (weilNodalIdeal R₀ b') (MvPolynomial.C r))) ∧
        ψ_1 d_0 =
          algebraMap (weilNodalQuot R₀ b') (Localization.Away h_1)
            (Ideal.Quotient.mk (weilNodalIdeal R₀ b')
              (MvPolynomial.C π_tilde * MvPolynomial.X 0)) ∧
        ψ_1 d_1 =
          algebraMap (weilNodalQuot R₀ b') (Localization.Away h_1)
            (Ideal.Quotient.mk (weilNodalIdeal R₀ b') (MvPolynomial.X 1))) ∧
      ((∀ r : R₀,
          f₀₁ (algebraMap (weilNodalQuot R₀ π_tilde) (Localization.Away h_0)
              (Ideal.Quotient.mk (weilNodalIdeal R₀ π_tilde) (MvPolynomial.C r))) =
            algebraMap (Polynomial R₀) (Localization.Away h_01) (Polynomial.C r)) ∧
        f₀₁ (algebraMap (weilNodalQuot R₀ π_tilde) (Localization.Away h_0)
            (Ideal.Quotient.mk (weilNodalIdeal R₀ π_tilde) (MvPolynomial.X 0))) =
          algebraMap (Polynomial R₀) (Localization.Away h_01)
            (Polynomial.C π_tilde * Polynomial.X) ∧
        algebraMap (Polynomial R₀) (Localization.Away h_01) Polynomial.X * f₀₁ g_0 = 1 ∧
        (∀ r : R₀,
          f₁₀ (algebraMap (weilNodalQuot R₀ b') (Localization.Away h_1)
              (Ideal.Quotient.mk (weilNodalIdeal R₀ b') (MvPolynomial.C r))) =
            algebraMap (Polynomial R₀) (Localization.Away h_01) (Polynomial.C r)) ∧
        f₁₀ g_1 = algebraMap (Polynomial R₀) (Localization.Away h_01) Polynomial.X ∧
        algebraMap (Polynomial R₀) (Localization.Away h_01) Polynomial.X *
          f₁₀ (algebraMap (weilNodalQuot R₀ b') (Localization.Away h_1)
            (Ideal.Quotient.mk (weilNodalIdeal R₀ b') (MvPolynomial.X 1))) =
          algebraMap (Polynomial R₀) (Localization.Away h_01) (Polynomial.C b')) ∧
      (@IsLocalization.Away (Localization.Away h_0) _ g_0 (Localization.Away h_01) _
          f₀₁.toAlgebra ∧
        @IsLocalization.Away (Localization.Away h_1) _ g_1 (Localization.Away h_01) _
          f₁₀.toAlgebra ∧
        f₀₁.comp ψ_0 = f₁₀.comp ψ_1 ∧
        Subring.closure (Set.range ψ_0 ∪ {g_0}) = ⊤ ∧
        Subring.closure (Set.range ψ_1 ∪ {g_1}) = ⊤ ∧
        f₁₀ g_1 * f₀₁ g_0 = 1) ∧
      (((∀ q : PrimeSpectrum (Localization.Away h_1), ψ_1 d_0 ∉ q.asIdeal → g_1 ∉ q.asIdeal) ∧
          @IsLocalization.Away (Localization.Away h_e) _ d_0 (Localization.Away (ψ_0 d_0)) _
            ((algebraMap (Localization.Away h_0) (Localization.Away (ψ_0 d_0))).comp ψ_0).toAlgebra) ∧
        ((∀ q : PrimeSpectrum (Localization.Away h_0), ψ_0 d_1 ∉ q.asIdeal → g_0 ∉ q.asIdeal) ∧
          @IsLocalization.Away (Localization.Away h_e) _ d_1 (Localization.Away (ψ_1 d_1)) _
            ((algebraMap (Localization.Away h_1) (Localization.Away (ψ_1 d_1))).comp ψ_1).toAlgebra) ∧
        ((∀ q : PrimeSpectrum (Localization.Away h_0), ψ_0 d_2 ∉ q.asIdeal → g_0 ∉ q.asIdeal) ∧
          @IsLocalization.Away (Localization.Away h_e) _ d_2 (Localization.Away (ψ_1 d_2)) _
            ((algebraMap (Localization.Away h_1) (Localization.Away (ψ_1 d_2))).comp ψ_1).toAlgebra) ∧
        ((∀ q : PrimeSpectrum (Localization.Away h_1), ψ_1 d_3 ∉ q.asIdeal → g_1 ∉ q.asIdeal) ∧
          @IsLocalization.Away (Localization.Away h_e) _ d_3 (Localization.Away (ψ_0 d_3)) _
            ((algebraMap (Localization.Away h_0) (Localization.Away (ψ_0 d_3))).comp ψ_0).toAlgebra)) ∧
      (∀ δ_e : R₀,
        let h_Z : Polynomial R₀ := h_01.comp (Polynomial.X - Polynomial.C δ_e)
        IsUnit (algebraMap (Polynomial R₀) (Localization.Away h_Z)
          (Polynomial.X - Polynomial.C δ_e)) ∧
        ∃ Θ_δ : Localization.Away h_01 ≃+* Localization.Away h_Z,
          (∀ r : R₀,
            Θ_δ (algebraMap (Polynomial R₀) (Localization.Away h_01) (Polynomial.C r)) =
              algebraMap (Polynomial R₀) (Localization.Away h_Z) (Polynomial.C r)) ∧
          Θ_δ (algebraMap (Polynomial R₀) (Localization.Away h_01) Polynomial.X) =
            algebraMap (Polynomial R₀) (Localization.Away h_Z)
              (Polynomial.X - Polynomial.C δ_e)) ∧
      (∀ (F : Type u) [Field F] (φ_B : Localization.Away h_e →+* F),
        φ_B d_2 ≠ 0 → φ_B d_3 ≠ 0 → φ_B d_0 ≠ 0 →
        ∃ φ_01 : Localization.Away h_01 →+* F,
          (φ_01.comp f₀₁).comp ψ_0 = φ_B ∧
          φ_B d_0 * φ_01 (f₀₁ g_0) = φ_B d_2 ∧
          φ_B d_2 * φ_01 (f₁₀ g_1) = φ_B d_0) :=
by
  classical
  intro g_0 g_1 d_0 d_1 d_2 d_3
  let α_e := algebraMap (weilNodalQuot R₀ (b' * π_tilde)) (Localization.Away h_e)
  let α_0 := algebraMap (weilNodalQuot R₀ π_tilde) (Localization.Away h_0)
  let α_1 := algebraMap (weilNodalQuot R₀ b') (Localization.Away h_1)
  let α_01 := algebraMap (Polynomial R₀) (Localization.Away h_01)
  let u_0 : Localization.Away h_0 :=
    α_0 (Ideal.Quotient.mk (weilNodalIdeal R₀ π_tilde) (MvPolynomial.X 0))
  let v_1 : Localization.Away h_1 :=
    α_1 (Ideal.Quotient.mk (weilNodalIdeal R₀ b') (MvPolynomial.X 1))
  let Φ_0 : MvPolynomial (Fin 2) R₀ →+* MvPolynomial (Fin 2) R₀ :=
    MvPolynomial.eval₂Hom MvPolynomial.C ![MvPolynomial.X 0, MvPolynomial.C b' * MvPolynomial.X 1]
  let Φ_1 : MvPolynomial (Fin 2) R₀ →+* MvPolynomial (Fin 2) R₀ :=
    MvPolynomial.eval₂Hom MvPolynomial.C ![MvPolynomial.C π_tilde * MvPolynomial.X 0, MvPolynomial.X 1]
  let D : ℕ := P_h.totalDegree
  let Q_01 : Polynomial R₀ :=
    ∑ d ∈ P_h.support,
      Polynomial.C (P_h.coeff d * π_tilde ^ (d 0) * b' ^ (d 1)) *
        Polynomial.X ^ (d 0 + (D - d 1))

  
  have nodal_mk_mul : ∀ (a : R₀),
      Ideal.Quotient.mk (weilNodalIdeal R₀ a) (MvPolynomial.X 0) *
        Ideal.Quotient.mk (weilNodalIdeal R₀ a) (MvPolynomial.X 1) =
        Ideal.Quotient.mk (weilNodalIdeal R₀ a) (MvPolynomial.C a) := by
    intro a
    rw [← map_mul, ← sub_eq_zero, ← map_sub, Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.subset_span rfl

  have hd0_mul_d1 : d_0 * d_1 = d_3 * d_2 := by
    dsimp only [d_0, d_1, d_2, d_3]
    rw [← map_mul, nodal_mk_mul, map_mul MvPolynomial.C, map_mul, map_mul]

  have hu0_mul_g0 : u_0 * g_0 =
      α_0 (Ideal.Quotient.mk (weilNodalIdeal R₀ π_tilde) (MvPolynomial.C π_tilde)) := by
    dsimp only [u_0, g_0, α_0]
    rw [← map_mul, nodal_mk_mul]

  have hg1_mul_v1 : g_1 * v_1 =
      α_1 (Ideal.Quotient.mk (weilNodalIdeal R₀ b') (MvPolynomial.C b')) := by
    dsimp only [g_1, v_1, α_1]
    rw [← map_mul, nodal_mk_mul]

  
  have exists_liftNodalQuot :
      ∀ {a : R₀} {S : Type u} [CommRing S] (ι : R₀ →+* S) (x₀ x₁ : S),
        x₀ * x₁ = ι a →
        ∃ φ : weilNodalQuot R₀ a →+* S,
          (∀ P : MvPolynomial (Fin 2) R₀,
            φ (Ideal.Quotient.mk (weilNodalIdeal R₀ a) P) =
              MvPolynomial.eval₂Hom ι ![x₀, x₁] P) ∧
          (∀ r : R₀,
            φ (Ideal.Quotient.mk (weilNodalIdeal R₀ a) (MvPolynomial.C r)) = ι r) ∧
          φ (Ideal.Quotient.mk (weilNodalIdeal R₀ a) (MvPolynomial.X 0)) = x₀ ∧
          φ (Ideal.Quotient.mk (weilNodalIdeal R₀ a) (MvPolynomial.X 1)) = x₁ := by
    intro a S _ ι x₀ x₁ hrel
    refine ⟨Ideal.Quotient.lift (weilNodalIdeal R₀ a) (MvPolynomial.eval₂Hom ι ![x₀, x₁]) ?_,
      fun _ => rfl, fun r => ?_, ?_, ?_⟩
    · intro p hp
      obtain ⟨q, rfl⟩ := Ideal.mem_span_singleton.mp hp
      rw [map_mul, map_sub, map_mul]
      simp only [MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_X, MvPolynomial.eval₂_C,
        Matrix.cons_val_zero, Matrix.cons_val_one, hrel, sub_self, zero_mul]
    · change (MvPolynomial.eval₂Hom ι ![x₀, x₁]) (MvPolynomial.C r) = ι r; simp
    · change (MvPolynomial.eval₂Hom ι ![x₀, x₁]) (MvPolynomial.X 0) = x₀; simp
    · change (MvPolynomial.eval₂Hom ι ![x₀, x₁]) (MvPolynomial.X 1) = x₁; simp

  
  have nodalAway_ringHom_ext :
      ∀ {a : R₀} {h : weilNodalQuot R₀ a} {S : Type u} [CommRing S]
        {φ₁ φ₂ : Localization.Away h →+* S},
        (∀ r : R₀,
          φ₁ (algebraMap (weilNodalQuot R₀ a) (Localization.Away h)
              (Ideal.Quotient.mk (weilNodalIdeal R₀ a) (MvPolynomial.C r))) =
            φ₂ (algebraMap (weilNodalQuot R₀ a) (Localization.Away h)
              (Ideal.Quotient.mk (weilNodalIdeal R₀ a) (MvPolynomial.C r)))) →
        φ₁ (algebraMap (weilNodalQuot R₀ a) (Localization.Away h)
            (Ideal.Quotient.mk (weilNodalIdeal R₀ a) (MvPolynomial.X 0))) =
          φ₂ (algebraMap (weilNodalQuot R₀ a) (Localization.Away h)
            (Ideal.Quotient.mk (weilNodalIdeal R₀ a) (MvPolynomial.X 0))) →
        φ₁ (algebraMap (weilNodalQuot R₀ a) (Localization.Away h)
            (Ideal.Quotient.mk (weilNodalIdeal R₀ a) (MvPolynomial.X 1))) =
          φ₂ (algebraMap (weilNodalQuot R₀ a) (Localization.Away h)
            (Ideal.Quotient.mk (weilNodalIdeal R₀ a) (MvPolynomial.X 1))) →
        φ₁ = φ₂ := by
    intro a h S _ φ₁ φ₂ hC hX0 hX1
    apply IsLocalization.ringHom_ext (Submonoid.powers h)
    refine RingHom.ext fun x => ?_
    obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective x
    let ψ₁ := (φ₁.comp (algebraMap (weilNodalQuot R₀ a) (Localization.Away h))).comp
      (Ideal.Quotient.mk (weilNodalIdeal R₀ a))
    let ψ₂ := (φ₂.comp (algebraMap (weilNodalQuot R₀ a) (Localization.Away h))).comp
      (Ideal.Quotient.mk (weilNodalIdeal R₀ a))
    have hψ : ψ₁ = ψ₂ := by
      apply MvPolynomial.ringHom_ext'
      · ext r; exact hC r
      · intro i; fin_cases i
        · exact hX0
        · exact hX1
    exact DFunLike.congr_fun hψ P

  
  have polyAway_ringHom_ext :
      ∀ {p : Polynomial R₀} {S : Type u} [CommRing S]
        {φ₁ φ₂ : Localization.Away p →+* S},
        (∀ r : R₀,
          φ₁ (algebraMap (Polynomial R₀) (Localization.Away p) (Polynomial.C r)) =
            φ₂ (algebraMap (Polynomial R₀) (Localization.Away p) (Polynomial.C r))) →
        φ₁ (algebraMap (Polynomial R₀) (Localization.Away p) Polynomial.X) =
          φ₂ (algebraMap (Polynomial R₀) (Localization.Away p) Polynomial.X) →
        φ₁ = φ₂ := by
    intro p S _ φ₁ φ₂ hC hX
    apply IsLocalization.ringHom_ext (Submonoid.powers p)
    apply Polynomial.ringHom_ext'
    · ext r; exact hC r
    · exact hX

  
  have isLocalization_away_of_inv :
      ∀ {A : Type u} [CommRing A] (x : A) {B : Type u} [CommRing B]
        (f : A →+* B) (F : Localization.Away x →+* B) (G : B →+* Localization.Away x),
        (∀ a : A, F (algebraMap A (Localization.Away x) a) = f a) →
        F.comp G = RingHom.id B →
        G.comp F = RingHom.id (Localization.Away x) →
        @IsLocalization.Away A _ x B _ f.toAlgebra := by
    intro A _ x B _ f F G hF_alg hFG hGF
    letI : Algebra A B := f.toAlgebra
    let e_ring : Localization.Away x ≃+* B := RingEquiv.ofRingHom F G hFG hGF
    let e_alg : Localization.Away x ≃ₐ[A] B := AlgEquiv.ofRingEquiv (f := e_ring) hF_alg
    exact (IsLocalization.isLocalization_iff_of_algEquiv (Submonoid.powers x) e_alg).mp
      inferInstance

  
  
  
  have hrel_ψ0 :
      Ideal.Quotient.mk (weilNodalIdeal R₀ π_tilde) (MvPolynomial.X 0) *
        Ideal.Quotient.mk (weilNodalIdeal R₀ π_tilde) (MvPolynomial.C b' * MvPolynomial.X 1) =
        ((Ideal.Quotient.mk (weilNodalIdeal R₀ π_tilde)).comp MvPolynomial.C) (b' * π_tilde) := by
    rw [map_mul, mul_left_comm, nodal_mk_mul]
    simp only [RingHom.comp_apply, map_mul]

  obtain ⟨ψ_0_pre, _hψ0_pre_mk, hψ0_pre_C, hψ0_pre_X0, hψ0_pre_X1⟩ :=
    exists_liftNodalQuot ((Ideal.Quotient.mk (weilNodalIdeal R₀ π_tilde)).comp MvPolynomial.C)
      (Ideal.Quotient.mk (weilNodalIdeal R₀ π_tilde) (MvPolynomial.X 0))
      (Ideal.Quotient.mk (weilNodalIdeal R₀ π_tilde) (MvPolynomial.C b' * MvPolynomial.X 1))
      hrel_ψ0

  have hψ0_pre_comp :
      ψ_0_pre.comp (Ideal.Quotient.mk (weilNodalIdeal R₀ (b' * π_tilde))) =
        (Ideal.Quotient.mk (weilNodalIdeal R₀ π_tilde)).comp Φ_0 := by
    apply MvPolynomial.ringHom_ext'
    · ext r
      change ψ_0_pre (Ideal.Quotient.mk _ (MvPolynomial.C r)) =
        Ideal.Quotient.mk _ (Φ_0 (MvPolynomial.C r))
      rw [hψ0_pre_C]
      simp [Φ_0]
    · intro i; fin_cases i
      · change ψ_0_pre (Ideal.Quotient.mk _ (MvPolynomial.X 0)) =
          Ideal.Quotient.mk _ (Φ_0 (MvPolynomial.X 0))
        rw [hψ0_pre_X0]
        simp [Φ_0]
      · change ψ_0_pre (Ideal.Quotient.mk _ (MvPolynomial.X 1)) =
          Ideal.Quotient.mk _ (Φ_0 (MvPolynomial.X 1))
        rw [hψ0_pre_X1]
        simp [Φ_0]

  have hψ0_pre_he : ψ_0_pre h_e = h_0 := by
    rw [hh_e_eq, hh_0_eq]
    exact DFunLike.congr_fun hψ0_pre_comp P_h

  have hUnit_ψ0 : IsUnit ((α_0.comp ψ_0_pre) h_e) := by
    change IsUnit (α_0 (ψ_0_pre h_e))
    rw [hψ0_pre_he]
    exact IsLocalization.Away.algebraMap_isUnit h_0

  let ψ_0 : Localization.Away h_e →+* Localization.Away h_0 :=
    IsLocalization.Away.lift h_e (g := α_0.comp ψ_0_pre) hUnit_ψ0

  have hψ0_lift : ∀ x, ψ_0 (α_e x) = α_0 (ψ_0_pre x) :=
    fun x => IsLocalization.Away.lift_eq h_e (g := α_0.comp ψ_0_pre) hUnit_ψ0 x

  have hψ0_C : ∀ r : R₀,
      ψ_0 (α_e (Ideal.Quotient.mk (weilNodalIdeal R₀ (b' * π_tilde)) (MvPolynomial.C r))) =
        α_0 (Ideal.Quotient.mk (weilNodalIdeal R₀ π_tilde) (MvPolynomial.C r)) := by
    intro r
    rw [hψ0_lift, hψ0_pre_C]
    rfl

  have hψ0_d0 : ψ_0 d_0 = u_0 := by
    dsimp only [d_0, u_0]
    change ψ_0 (α_e (Ideal.Quotient.mk _ (MvPolynomial.X 0))) = _
    rw [hψ0_lift, hψ0_pre_X0]

  have hψ0_d1 : ψ_0 d_1 =
      α_0 (Ideal.Quotient.mk (weilNodalIdeal R₀ π_tilde)
        (MvPolynomial.C b' * MvPolynomial.X 1)) := by
    dsimp only [d_1]
    change ψ_0 (α_e (Ideal.Quotient.mk _ (MvPolynomial.X 1))) = _
    rw [hψ0_lift, hψ0_pre_X1]

  have hrel_ψ1 :
      Ideal.Quotient.mk (weilNodalIdeal R₀ b') (MvPolynomial.C π_tilde * MvPolynomial.X 0) *
        Ideal.Quotient.mk (weilNodalIdeal R₀ b') (MvPolynomial.X 1) =
        ((Ideal.Quotient.mk (weilNodalIdeal R₀ b')).comp MvPolynomial.C) (b' * π_tilde) := by
    rw [map_mul, mul_assoc, nodal_mk_mul]
    simp only [RingHom.comp_apply, map_mul, mul_comm]

  obtain ⟨ψ_1_pre, _hψ1_pre_mk, hψ1_pre_C, hψ1_pre_X0, hψ1_pre_X1⟩ :=
    exists_liftNodalQuot ((Ideal.Quotient.mk (weilNodalIdeal R₀ b')).comp MvPolynomial.C)
      (Ideal.Quotient.mk (weilNodalIdeal R₀ b') (MvPolynomial.C π_tilde * MvPolynomial.X 0))
      (Ideal.Quotient.mk (weilNodalIdeal R₀ b') (MvPolynomial.X 1))
      hrel_ψ1

  have hψ1_pre_comp :
      ψ_1_pre.comp (Ideal.Quotient.mk (weilNodalIdeal R₀ (b' * π_tilde))) =
        (Ideal.Quotient.mk (weilNodalIdeal R₀ b')).comp Φ_1 := by
    apply MvPolynomial.ringHom_ext'
    · ext r
      change ψ_1_pre (Ideal.Quotient.mk _ (MvPolynomial.C r)) =
        Ideal.Quotient.mk _ (Φ_1 (MvPolynomial.C r))
      rw [hψ1_pre_C]
      simp [Φ_1]
    · intro i; fin_cases i
      · change ψ_1_pre (Ideal.Quotient.mk _ (MvPolynomial.X 0)) =
          Ideal.Quotient.mk _ (Φ_1 (MvPolynomial.X 0))
        rw [hψ1_pre_X0]
        simp [Φ_1]
      · change ψ_1_pre (Ideal.Quotient.mk _ (MvPolynomial.X 1)) =
          Ideal.Quotient.mk _ (Φ_1 (MvPolynomial.X 1))
        rw [hψ1_pre_X1]
        simp [Φ_1]

  have hψ1_pre_he : ψ_1_pre h_e = h_1 := by
    rw [hh_e_eq, hh_1_eq]
    exact DFunLike.congr_fun hψ1_pre_comp P_h

  have hUnit_ψ1 : IsUnit ((α_1.comp ψ_1_pre) h_e) := by
    change IsUnit (α_1 (ψ_1_pre h_e))
    rw [hψ1_pre_he]
    exact IsLocalization.Away.algebraMap_isUnit h_1

  let ψ_1 : Localization.Away h_e →+* Localization.Away h_1 :=
    IsLocalization.Away.lift h_e (g := α_1.comp ψ_1_pre) hUnit_ψ1

  have hψ1_lift : ∀ x, ψ_1 (α_e x) = α_1 (ψ_1_pre x) :=
    fun x => IsLocalization.Away.lift_eq h_e (g := α_1.comp ψ_1_pre) hUnit_ψ1 x

  have hψ1_C : ∀ r : R₀,
      ψ_1 (α_e (Ideal.Quotient.mk (weilNodalIdeal R₀ (b' * π_tilde)) (MvPolynomial.C r))) =
        α_1 (Ideal.Quotient.mk (weilNodalIdeal R₀ b') (MvPolynomial.C r)) := by
    intro r
    rw [hψ1_lift, hψ1_pre_C]
    rfl

  have hψ1_d0 : ψ_1 d_0 =
      α_1 (Ideal.Quotient.mk (weilNodalIdeal R₀ b')
        (MvPolynomial.C π_tilde * MvPolynomial.X 0)) := by
    dsimp only [d_0]
    change ψ_1 (α_e (Ideal.Quotient.mk _ (MvPolynomial.X 0))) = _
    rw [hψ1_lift, hψ1_pre_X0]

  have hψ1_d1 : ψ_1 d_1 = v_1 := by
    dsimp only [d_1, v_1]
    change ψ_1 (α_e (Ideal.Quotient.mk _ (MvPolynomial.X 1))) = _
    rw [hψ1_lift, hψ1_pre_X1]

  have hψ0_d2 : ψ_0 d_2 =
      α_0 (Ideal.Quotient.mk (weilNodalIdeal R₀ π_tilde) (MvPolynomial.C π_tilde)) :=
    hψ0_C π_tilde

  have hψ0_d3 : ψ_0 d_3 =
      α_0 (Ideal.Quotient.mk (weilNodalIdeal R₀ π_tilde) (MvPolynomial.C b')) :=
    hψ0_C b'

  have hψ1_d2 : ψ_1 d_2 =
      α_1 (Ideal.Quotient.mk (weilNodalIdeal R₀ b') (MvPolynomial.C π_tilde)) :=
    hψ1_C π_tilde

  have hψ1_d3 : ψ_1 d_3 =
      α_1 (Ideal.Quotient.mk (weilNodalIdeal R₀ b') (MvPolynomial.C b')) :=
    hψ1_C b'

  
  have subring_closure_nodal_away :
      ∀ {a : R₀} (h : weilNodalQuot R₀ a)
        (ψ : Localization.Away h_e →+* Localization.Away h)
        (g : Localization.Away h),
        ψ (α_e h_e) = algebraMap (weilNodalQuot R₀ a) (Localization.Away h) h →
        (∀ r : R₀,
          algebraMap (weilNodalQuot R₀ a) (Localization.Away h)
            (Ideal.Quotient.mk (weilNodalIdeal R₀ a) (MvPolynomial.C r)) ∈ Set.range ψ) →
        algebraMap (weilNodalQuot R₀ a) (Localization.Away h)
          (Ideal.Quotient.mk (weilNodalIdeal R₀ a) (MvPolynomial.X 0)) ∈ Set.range ψ ∪ {g} →
        algebraMap (weilNodalQuot R₀ a) (Localization.Away h)
          (Ideal.Quotient.mk (weilNodalIdeal R₀ a) (MvPolynomial.X 1)) ∈ Set.range ψ ∪ {g} →
        Subring.closure (Set.range ψ ∪ {g}) = ⊤ := by
    intro a h ψ g hψ_h hC hX0 hX1
    let α := algebraMap (weilNodalQuot R₀ a) (Localization.Away h)
    let mk := Ideal.Quotient.mk (weilNodalIdeal R₀ a)
    let S := Subring.closure (Set.range ψ ∪ {g})
    rw [Subring.eq_top_iff']
    intro z
    have hinv_eq : IsLocalization.Away.invSelf h = ψ (IsLocalization.Away.invSelf h_e) := by
      calc IsLocalization.Away.invSelf h
          = 1 * IsLocalization.Away.invSelf h := (one_mul _).symm
        _ = ψ (α_e h_e * IsLocalization.Away.invSelf h_e) * IsLocalization.Away.invSelf h := by
              rw [IsLocalization.Away.mul_invSelf h_e, map_one]
        _ = ψ (IsLocalization.Away.invSelf h_e) * (α h * IsLocalization.Away.invSelf h) := by
              rw [map_mul, hψ_h]; ring
        _ = ψ (IsLocalization.Away.invSelf h_e) := by
              rw [IsLocalization.Away.mul_invSelf h, mul_one]
    have hinv_mem : IsLocalization.Away.invSelf h ∈ S :=
      Subring.subset_closure (Or.inl ⟨IsLocalization.Away.invSelf h_e, hinv_eq.symm⟩)
    have hMv_mem : ∀ P : MvPolynomial (Fin 2) R₀, α (mk P) ∈ S := by
      intro P
      induction P using MvPolynomial.induction_on with
      | C r => exact Subring.subset_closure (Or.inl (hC r))
      | add p q hp hq =>
          rw [map_add, map_add]
          exact S.add_mem hp hq
      | mul_X p i hp =>
          rw [map_mul, map_mul]
          refine S.mul_mem hp (Subring.subset_closure ?_)
          fin_cases i
          · exact hX0
          · exact hX1
    obtain ⟨⟨x, _, ⟨n, rfl⟩⟩, hz⟩ := IsLocalization.surj (Submonoid.powers h) z
    obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective x
    have hz_eq : z = α (mk P) * (IsLocalization.Away.invSelf h) ^ n := by
      calc z = z * 1 := (mul_one z).symm
        _ = z * (α h * IsLocalization.Away.invSelf h) ^ n := by
              rw [IsLocalization.Away.mul_invSelf h, one_pow]
        _ = (z * α (h ^ n)) * (IsLocalization.Away.invSelf h) ^ n := by
              rw [mul_pow, map_pow, mul_assoc]
        _ = α (mk P) * (IsLocalization.Away.invSelf h) ^ n := by
              rw [hz]
    rw [hz_eq]
    exact S.mul_mem (hMv_mem P) (S.pow_mem hinv_mem n)

  have hGen0 : Subring.closure (Set.range ψ_0 ∪ {g_0}) = ⊤ :=
    subring_closure_nodal_away h_0 ψ_0 g_0
      (by rw [hψ0_lift, hψ0_pre_he])
      (fun r => ⟨α_e (Ideal.Quotient.mk _ (MvPolynomial.C r)), hψ0_C r⟩)
      (Or.inl ⟨d_0, hψ0_d0⟩)
      (Or.inr rfl)

  have hGen1 : Subring.closure (Set.range ψ_1 ∪ {g_1}) = ⊤ :=
    subring_closure_nodal_away h_1 ψ_1 g_1
      (by rw [hψ1_lift, hψ1_pre_he])
      (fun r => ⟨α_e (Ideal.Quotient.mk _ (MvPolynomial.C r)), hψ1_C r⟩)
      (Or.inr rfl)
      (Or.inl ⟨d_1, hψ1_d1⟩)

  
  
  
  have hLaurent : ∀ {S : Type u} [CommRing S] (ι : R₀ →+* S) (u v : S),
      u * v = 1 →
      (Polynomial.eval₂ ι u Q_01) * v ^ D =
        MvPolynomial.eval₂ ι ![ι π_tilde * u, ι b' * v] P_h := by
    intro S _ ι u v huv
    dsimp only [Q_01]
    rw [Polynomial.eval₂_finsetSum, Finset.sum_mul, MvPolynomial.eval₂_eq]
    refine Finset.sum_congr rfl fun d hd => ?_
    rw [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X_pow]
    have hprod : (∏ i ∈ d.support, (![ι π_tilde * u, ι b' * v] i) ^ (d i)) =
        (ι π_tilde * u) ^ (d 0) * (ι b' * v) ^ (d 1) := by
      calc (∏ i ∈ d.support, (![ι π_tilde * u, ι b' * v] i) ^ (d i))
          = ∏ i : Fin 2, (![ι π_tilde * u, ι b' * v] i) ^ (d i) := by
              refine Finset.prod_subset (Finset.subset_univ d.support) ?_
              intro i _ hi
              rw [Finsupp.notMem_support_iff.mp hi, pow_zero]
        _ = (ι π_tilde * u) ^ (d 0) * (ι b' * v) ^ (d 1) := by
              rw [Fin.prod_univ_two]
              simp
    rw [hprod]
    have hd1_le : d 1 ≤ D :=
      (MvPolynomial.monomial_le_degreeOf 1 hd).trans (MvPolynomial.degreeOf_le_totalDegree P_h 1)
    have hD_split : (D - d 1) + d 1 = D := Nat.sub_add_cancel hd1_le
    have huv_pow : u ^ (d 0 + (D - d 1)) * v ^ D = u ^ (d 0) * v ^ (d 1) := by
      calc u ^ (d 0 + (D - d 1)) * v ^ D
          = u ^ (d 0) * u ^ (D - d 1) * v ^ ((D - d 1) + d 1) := by rw [pow_add, hD_split]
        _ = u ^ (d 0) * (u * v) ^ (D - d 1) * v ^ (d 1) := by rw [pow_add, mul_pow]; ring
        _ = u ^ (d 0) * v ^ (d 1) := by rw [huv, one_pow, mul_one]
    rw [mul_assoc, huv_pow, map_mul, map_mul, map_pow, map_pow, mul_pow, mul_pow]
    ring

  let ι_01 : R₀ →+* Localization.Away h_01 := α_01.comp Polynomial.C
  let T : Localization.Away h_01 := α_01 Polynomial.X
  let q_01 : Localization.Away h_01 := α_01 Q_01
  let T_inv : Localization.Away h_01 := q_01 * IsLocalization.Away.invSelf h_01

  have hh_01_mul : h_01 = Polynomial.X * Q_01 := hh_01_eq

  have hT_mul_Tinv : T * T_inv = 1 := by
    dsimp only [T, T_inv, q_01]
    rw [← mul_assoc, ← map_mul, ← hh_01_mul]
    exact IsLocalization.Away.mul_invSelf h_01

  have hq01_mul_inv : q_01 * (T * IsLocalization.Away.invSelf h_01) = 1 := by
    calc q_01 * (T * IsLocalization.Away.invSelf h_01)
        = T * T_inv := by dsimp only [T_inv]; ring
      _ = 1 := hT_mul_Tinv

  have hUnit_T : IsUnit T := IsUnit.of_mul_eq_one T_inv hT_mul_Tinv
  have hUnit_Tinv : IsUnit T_inv := IsUnit.of_mul_eq_one T (mul_comm T T_inv ▸ hT_mul_Tinv)
  have hUnit_q01 : IsUnit q_01 := IsUnit.of_mul_eq_one _ hq01_mul_inv

  have heval_01_eq : Polynomial.eval₂RingHom ι_01 T = α_01 := by
    apply Polynomial.ringHom_ext'
    · ext r; simp [ι_01]
    · simp [T]

  have heval_Q01 : Polynomial.eval₂ ι_01 T Q_01 = q_01 := by
    change Polynomial.eval₂RingHom ι_01 T Q_01 = q_01
    rw [heval_01_eq]

  
  have hrel_f01 : (ι_01 π_tilde * T) * T_inv = ι_01 π_tilde := by
    rw [mul_assoc, hT_mul_Tinv, mul_one]

  obtain ⟨f₀₁_pre, hf01_pre_mk, hf01_pre_C, hf01_pre_X0, hf01_pre_X1⟩ :=
    exists_liftNodalQuot ι_01 (ι_01 π_tilde * T) T_inv hrel_f01

  have hf01_comp_Φ0 :
      (MvPolynomial.eval₂Hom ι_01 ![ι_01 π_tilde * T, T_inv]).comp Φ_0 =
        MvPolynomial.eval₂Hom ι_01 ![ι_01 π_tilde * T, ι_01 b' * T_inv] := by
    apply MvPolynomial.ringHom_ext'
    · ext r; simp [Φ_0]
    · intro i; fin_cases i <;> simp [Φ_0]

  have hf01_pre_h0 : f₀₁_pre h_0 = q_01 * T_inv ^ D := by
    rw [hh_0_eq, hf01_pre_mk]
    change ((MvPolynomial.eval₂Hom ι_01 ![ι_01 π_tilde * T, T_inv]).comp Φ_0) P_h = _
    rw [hf01_comp_Φ0, MvPolynomial.coe_eval₂Hom, ← hLaurent ι_01 T T_inv hT_mul_Tinv, heval_Q01]

  have hUnit_f01 : IsUnit (f₀₁_pre h_0) := by
    rw [hf01_pre_h0]
    exact hUnit_q01.mul (hUnit_Tinv.pow D)

  let f₀₁ : Localization.Away h_0 →+* Localization.Away h_01 :=
    IsLocalization.Away.lift h_0 (g := f₀₁_pre) hUnit_f01

  have hf01_lift : ∀ x, f₀₁ (α_0 x) = f₀₁_pre x :=
    fun x => IsLocalization.Away.lift_eq h_0 (g := f₀₁_pre) hUnit_f01 x

  have hf01_C : ∀ r : R₀,
      f₀₁ (α_0 (Ideal.Quotient.mk (weilNodalIdeal R₀ π_tilde) (MvPolynomial.C r))) =
        α_01 (Polynomial.C r) := by
    intro r
    rw [hf01_lift, hf01_pre_C]
    rfl

  have hf01_u0 : f₀₁ u_0 = α_01 (Polynomial.C π_tilde * Polynomial.X) := by
    dsimp only [u_0]
    rw [hf01_lift, hf01_pre_X0, map_mul]
    rfl

  have hf01_g0_eq : f₀₁ g_0 = T_inv := by
    change f₀₁ (α_0 (Ideal.Quotient.mk _ (MvPolynomial.X 1))) = T_inv
    rw [hf01_lift, hf01_pre_X1]

  have hf01_g0 : α_01 Polynomial.X * f₀₁ g_0 = 1 := by
    rw [hf01_g0_eq]
    exact hT_mul_Tinv

  
  have hrel_f10 : T * (ι_01 b' * T_inv) = ι_01 b' := by
    calc T * (ι_01 b' * T_inv) = ι_01 b' * (T * T_inv) := by ring
      _ = ι_01 b' := by rw [hT_mul_Tinv, mul_one]

  obtain ⟨f₁₀_pre, hf10_pre_mk, hf10_pre_C, hf10_pre_X0, hf10_pre_X1⟩ :=
    exists_liftNodalQuot ι_01 T (ι_01 b' * T_inv) hrel_f10

  have hf10_comp_Φ1 :
      (MvPolynomial.eval₂Hom ι_01 ![T, ι_01 b' * T_inv]).comp Φ_1 =
        MvPolynomial.eval₂Hom ι_01 ![ι_01 π_tilde * T, ι_01 b' * T_inv] := by
    apply MvPolynomial.ringHom_ext'
    · ext r; simp [Φ_1]
    · intro i; fin_cases i <;> simp [Φ_1]

  have hf10_pre_h1 : f₁₀_pre h_1 = q_01 * T_inv ^ D := by
    rw [hh_1_eq, hf10_pre_mk]
    change ((MvPolynomial.eval₂Hom ι_01 ![T, ι_01 b' * T_inv]).comp Φ_1) P_h = _
    rw [hf10_comp_Φ1, MvPolynomial.coe_eval₂Hom, ← hLaurent ι_01 T T_inv hT_mul_Tinv, heval_Q01]

  have hUnit_f10 : IsUnit (f₁₀_pre h_1) := by
    rw [hf10_pre_h1]
    exact hUnit_q01.mul (hUnit_Tinv.pow D)

  let f₁₀ : Localization.Away h_1 →+* Localization.Away h_01 :=
    IsLocalization.Away.lift h_1 (g := f₁₀_pre) hUnit_f10

  have hf10_lift : ∀ x, f₁₀ (α_1 x) = f₁₀_pre x :=
    fun x => IsLocalization.Away.lift_eq h_1 (g := f₁₀_pre) hUnit_f10 x

  have hf10_C : ∀ r : R₀,
      f₁₀ (α_1 (Ideal.Quotient.mk (weilNodalIdeal R₀ b') (MvPolynomial.C r))) =
        α_01 (Polynomial.C r) := by
    intro r
    rw [hf10_lift, hf10_pre_C]
    rfl

  have hf10_g1 : f₁₀ g_1 = α_01 Polynomial.X := by
    change f₁₀ (α_1 (Ideal.Quotient.mk _ (MvPolynomial.X 0))) = _
    rw [hf10_lift, hf10_pre_X0]

  have hf10_v1_eq : f₁₀ v_1 = ι_01 b' * T_inv := by
    dsimp only [v_1]
    rw [hf10_lift, hf10_pre_X1]

  have hf10_v1 : α_01 Polynomial.X * f₁₀ v_1 = α_01 (Polynomial.C b') := by
    rw [hf10_v1_eq]
    exact hrel_f10

  have hInv : f₁₀ g_1 * f₀₁ g_0 = 1 := by
    rw [hf10_g1]
    exact hf01_g0

  have hψ0_d1_mul : ψ_0 d_1 = ψ_0 d_3 * g_0 := by
    rw [hψ0_d1, map_mul, map_mul, hψ0_d3]

  have hψ1_d0_mul : ψ_1 d_0 = ψ_1 d_2 * g_1 := by
    rw [hψ1_d0, map_mul, map_mul, hψ1_d2]

  have hCocycle : f₀₁.comp ψ_0 = f₁₀.comp ψ_1 := by
    apply nodalAway_ringHom_ext
    · intro r
      change f₀₁ (ψ_0 (α_e (Ideal.Quotient.mk _ (MvPolynomial.C r)))) =
        f₁₀ (ψ_1 (α_e (Ideal.Quotient.mk _ (MvPolynomial.C r))))
      rw [hψ0_C, hf01_C, hψ1_C, hf10_C]
    · change f₀₁ (ψ_0 d_0) = f₁₀ (ψ_1 d_0)
      rw [hψ0_d0, hf01_u0, hψ1_d0_mul, map_mul f₁₀, hψ1_d2, hf10_C π_tilde, hf10_g1, map_mul]
    · change f₀₁ (ψ_0 d_1) = f₁₀ (ψ_1 d_1)
      rw [hψ0_d1_mul, map_mul, hψ0_d3, hf01_C b', hf01_g0_eq, hψ1_d1, hf10_v1_eq]
      rfl

  
  have hLoc0 : @IsLocalization.Away (Localization.Away h_0) _ g_0
      (Localization.Away h_01) _ f₀₁.toAlgebra := by
    let j_0 := algebraMap (Localization.Away h_0) (Localization.Away g_0)
    let w_0 : Localization.Away g_0 := IsLocalization.Away.invSelf g_0
    have hj0_w0 : j_0 g_0 * w_0 = 1 := IsLocalization.Away.mul_invSelf g_0
    have hw0_j0 : w_0 * j_0 g_0 = 1 := mul_comm (j_0 g_0) w_0 ▸ hj0_w0
    have hUnit_w0 : IsUnit w_0 := IsUnit.of_mul_eq_one (j_0 g_0) hw0_j0
    have hUnit_f01_g0 : IsUnit (f₀₁ g_0) := hf01_g0_eq ▸ hUnit_Tinv
    let F_0 : Localization.Away g_0 →+* Localization.Away h_01 :=
      IsLocalization.Away.lift g_0 (g := f₀₁) hUnit_f01_g0
    have hF0_eq : ∀ c, F_0 (j_0 c) = f₀₁ c :=
      fun c => IsLocalization.Away.lift_eq g_0 (g := f₀₁) hUnit_f01_g0 c
    have hF0_w0 : F_0 w_0 = T := by
      have hmul : T_inv * F_0 w_0 = 1 := by
        calc T_inv * F_0 w_0 = F_0 (j_0 g_0) * F_0 w_0 := by rw [hF0_eq, hf01_g0_eq]
          _ = F_0 (j_0 g_0 * w_0) := (map_mul F_0 _ _).symm
          _ = 1 := by rw [hj0_w0, map_one]
      calc F_0 w_0 = 1 * F_0 w_0 := (one_mul _).symm
        _ = (T * T_inv) * F_0 w_0 := by rw [hT_mul_Tinv]
        _ = T * (T_inv * F_0 w_0) := mul_assoc _ _ _
        _ = T := by rw [hmul, mul_one]
    let ι_L0 : R₀ →+* Localization.Away g_0 :=
      (j_0.comp α_0).comp ((Ideal.Quotient.mk (weilNodalIdeal R₀ π_tilde)).comp MvPolynomial.C)
    let β_0 : Polynomial R₀ →+* Localization.Away g_0 := Polynomial.eval₂RingHom ι_L0 w_0
    have hπ_w0 : ι_L0 π_tilde * w_0 = j_0 u_0 := by
      have hprod : j_0 u_0 * j_0 g_0 = ι_L0 π_tilde := by
        rw [← map_mul, hu0_mul_g0]; rfl
      calc ι_L0 π_tilde * w_0 = (j_0 u_0 * j_0 g_0) * w_0 := by rw [hprod]
        _ = j_0 u_0 * (j_0 g_0 * w_0) := mul_assoc _ _ _
        _ = j_0 u_0 := by rw [hj0_w0, mul_one]
    have hL0_Φ0 :
        ((j_0.comp α_0).comp (Ideal.Quotient.mk (weilNodalIdeal R₀ π_tilde))).comp Φ_0 =
          MvPolynomial.eval₂Hom ι_L0 ![j_0 u_0, ι_L0 b' * j_0 g_0] := by
      apply MvPolynomial.ringHom_ext'
      · ext r; simp [Φ_0, ι_L0]
      · intro i; fin_cases i
        · simp [Φ_0, u_0]
        · change j_0 (α_0 (Ideal.Quotient.mk _ (Φ_0 (MvPolynomial.X 1)))) =
            (MvPolynomial.eval₂Hom ι_L0 ![j_0 u_0, ι_L0 b' * j_0 g_0]) (MvPolynomial.X 1)
          simp only [Φ_0, MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_X, Matrix.cons_val_one,
            Matrix.cons_val_zero, map_mul]
          rfl
    have hβ0_Q01 : β_0 Q_01 * (j_0 g_0) ^ D = j_0 (α_0 h_0) := by
      calc β_0 Q_01 * (j_0 g_0) ^ D
          = MvPolynomial.eval₂ ι_L0 ![ι_L0 π_tilde * w_0, ι_L0 b' * j_0 g_0] P_h :=
              hLaurent ι_L0 w_0 (j_0 g_0) hw0_j0
        _ = (MvPolynomial.eval₂Hom ι_L0 ![j_0 u_0, ι_L0 b' * j_0 g_0]) P_h := by
              rw [hπ_w0]; rfl
        _ = (((j_0.comp α_0).comp (Ideal.Quotient.mk _)).comp Φ_0) P_h := by rw [← hL0_Φ0]
        _ = j_0 (α_0 h_0) := congrArg (fun x => j_0 (α_0 x)) hh_0_eq.symm
    have hUnit_β0_Q01 : IsUnit (β_0 Q_01) := by
      have hU : IsUnit (β_0 Q_01 * (j_0 g_0) ^ D) := by
        rw [hβ0_Q01]
        exact IsUnit.map j_0 (IsLocalization.Away.algebraMap_isUnit h_0)
      exact isUnit_of_mul_isUnit_left hU
    have hUnit_β0_h01 : IsUnit (β_0 h_01) := by
      rw [hh_01_mul, map_mul]
      have hX : β_0 Polynomial.X = w_0 := by simp [β_0]
      rw [hX]
      exact hUnit_w0.mul hUnit_β0_Q01
    let G_0 : Localization.Away h_01 →+* Localization.Away g_0 :=
      IsLocalization.Away.lift h_01 (g := β_0) hUnit_β0_h01
    have hG0_eq : ∀ p, G_0 (α_01 p) = β_0 p :=
      fun p => IsLocalization.Away.lift_eq h_01 (g := β_0) hUnit_β0_h01 p
    have hG0_T : G_0 T = w_0 := by
      dsimp only [T]; rw [hG0_eq]; simp [β_0]
    have hG0_C : ∀ r : R₀, G_0 (α_01 (Polynomial.C r)) = ι_L0 r := by
      intro r; rw [hG0_eq]; simp [β_0]
    have hG0_Tinv : G_0 T_inv = j_0 g_0 := by
      have hmul : w_0 * G_0 T_inv = 1 := by
        calc w_0 * G_0 T_inv = G_0 T * G_0 T_inv := by rw [hG0_T]
          _ = G_0 (T * T_inv) := (map_mul G_0 _ _).symm
          _ = 1 := by rw [hT_mul_Tinv, map_one]
      calc G_0 T_inv = 1 * G_0 T_inv := (one_mul _).symm
        _ = (j_0 g_0 * w_0) * G_0 T_inv := by rw [hj0_w0]
        _ = j_0 g_0 * (w_0 * G_0 T_inv) := mul_assoc _ _ _
        _ = j_0 g_0 := by rw [hmul, mul_one]
    have hFG0 : F_0.comp G_0 = RingHom.id (Localization.Away h_01) := by
      apply polyAway_ringHom_ext
      · intro r
        change F_0 (G_0 (α_01 (Polynomial.C r))) = α_01 (Polynomial.C r)
        rw [hG0_C]
        change F_0 (j_0 (α_0 (Ideal.Quotient.mk _ (MvPolynomial.C r)))) = _
        rw [hF0_eq, hf01_C]
      · change F_0 (G_0 T) = T
        rw [hG0_T, hF0_w0]
    have hGF0 : G_0.comp F_0 = RingHom.id (Localization.Away g_0) := by
      apply IsLocalization.ringHom_ext (Submonoid.powers g_0)
      have hcomp : G_0.comp f₀₁ = j_0 := by
        apply nodalAway_ringHom_ext
        · intro r
          change G_0 (f₀₁ (α_0 (Ideal.Quotient.mk _ (MvPolynomial.C r)))) =
            j_0 (α_0 (Ideal.Quotient.mk _ (MvPolynomial.C r)))
          rw [hf01_C, hG0_C]
          rfl
        · change G_0 (f₀₁ u_0) = j_0 u_0
          rw [hf01_u0, map_mul, map_mul, hG0_C π_tilde, hG0_T, hπ_w0]
        · change G_0 (f₀₁ g_0) = j_0 g_0
          rw [hf01_g0_eq, hG0_Tinv]
      ext c
      change G_0 (F_0 (j_0 c)) = j_0 c
      rw [hF0_eq]
      exact DFunLike.congr_fun hcomp c
    exact isLocalization_away_of_inv g_0 f₀₁ F_0 G_0 hF0_eq hFG0 hGF0

  
  have hLoc1 : @IsLocalization.Away (Localization.Away h_1) _ g_1
      (Localization.Away h_01) _ f₁₀.toAlgebra := by
    let j_1 := algebraMap (Localization.Away h_1) (Localization.Away g_1)
    let w_1 : Localization.Away g_1 := IsLocalization.Away.invSelf g_1
    have hj1_w1 : j_1 g_1 * w_1 = 1 := IsLocalization.Away.mul_invSelf g_1
    have hw1_j1 : w_1 * j_1 g_1 = 1 := mul_comm (j_1 g_1) w_1 ▸ hj1_w1
    have hUnit_j1_g1 : IsUnit (j_1 g_1) := IsLocalization.Away.algebraMap_isUnit g_1
    have hUnit_f10_g1 : IsUnit (f₁₀ g_1) := hf10_g1.symm ▸ hUnit_T
    let F_1 : Localization.Away g_1 →+* Localization.Away h_01 :=
      IsLocalization.Away.lift g_1 (g := f₁₀) hUnit_f10_g1
    have hF1_eq : ∀ c, F_1 (j_1 c) = f₁₀ c :=
      fun c => IsLocalization.Away.lift_eq g_1 (g := f₁₀) hUnit_f10_g1 c
    let ι_L1 : R₀ →+* Localization.Away g_1 :=
      (j_1.comp α_1).comp ((Ideal.Quotient.mk (weilNodalIdeal R₀ b')).comp MvPolynomial.C)
    let β_1 : Polynomial R₀ →+* Localization.Away g_1 := Polynomial.eval₂RingHom ι_L1 (j_1 g_1)
    have hb_w1 : ι_L1 b' * w_1 = j_1 v_1 := by
      have hprod : j_1 v_1 * j_1 g_1 = ι_L1 b' := by
        rw [mul_comm, ← map_mul, hg1_mul_v1]; rfl
      calc ι_L1 b' * w_1 = (j_1 v_1 * j_1 g_1) * w_1 := by rw [hprod]
        _ = j_1 v_1 * (j_1 g_1 * w_1) := mul_assoc _ _ _
