    have e'_Y : V'_P ≤ (TopologicalSpace.Opens.map π₂.base).obj U'_Y := hV'_sub
    obtain ⟨w, hw_V', hw_eq⟩ := mem_closure_iff.mp hz'_cl (V'_P : Set P_tilde) V'_P.2 hzP_V'
    have hz'_V' : z' ∈ V'_P := by
      have hw_z' : w = z' := hw_eq
      rwa [← hw_z']
    have hV'_ne : Nonempty ↥V'_P := ⟨⟨z_P, hzP_V'⟩⟩
    let B'_P := ↑(P_tilde.presheaf.obj (Opposite.op V'_P))
    haveI : IsDomain B'_P :=
      @AlgebraicGeometry.IsIntegral.component_integral P_tilde hInt_P V'_P hV'_ne
    obtain ⟨φ'_P, hFrac'_P, hφ'_P⟩ := hFunc_P V'_P hV'_P hV'_ne
    have hInj'_P : Function.Injective φ'_P.hom := by
      letI : Algebra B'_P F := φ'_P.hom.toAlgebra
      exact @IsFractionRing.injective B'_P _ F _ _ hFrac'_P
    let γ'_P_hom := AlgebraicGeometry.Spec.preimage (hV'_P.fromSpec ≫ π₁ ≫ g_X)
    let γ'_P : ↥V →+* B'_P := γ'_P_hom.hom
    have hCompat'_P : ∀ c : ↥V, φ'_P.hom (γ'_P c) = φ_KF (V.subtype c) := by
      intro c
      have hSpec_eq : AlgebraicGeometry.Spec.map (γ'_P_hom ≫ φ'_P) = η_P ≫ π₁ ≫ g_X := by
        calc
          AlgebraicGeometry.Spec.map (γ'_P_hom ≫ φ'_P)
            = AlgebraicGeometry.Spec.map φ'_P ≫ AlgebraicGeometry.Spec.map γ'_P_hom := by
              rw [AlgebraicGeometry.Spec.map_comp]
          _ = (AlgebraicGeometry.Spec.map φ'_P ≫ hV'_P.fromSpec) ≫ π₁ ≫ g_X := by
              rw [AlgebraicGeometry.Spec.map_preimage]
              simp only [CategoryTheory.Category.assoc]
          _ = η_P ≫ π₁ ≫ g_X := by
              rw [hφ'_P]
      have hPre := congrArg AlgebraicGeometry.Spec.preimage hSpec_eq
      rw [AlgebraicGeometry.Spec.preimage_map] at hPre
      exact (congrArg (fun f => f.hom c) hPre).trans (hφ_V c).symm
    let pt_zP : ↥(AlgebraicGeometry.Spec (P_tilde.presheaf.obj (Opposite.op V'_P))) :=
      hV'_P.primeIdealOf ⟨z_P, hzP_V'⟩
    have hpt_zP_base : hV'_P.fromSpec.base pt_zP = z_P :=
      hV'_P.fromSpec_primeIdealOf ⟨z_P, hzP_V'⟩
    let pt_z' : ↥(AlgebraicGeometry.Spec (P_tilde.presheaf.obj (Opposite.op V'_P))) :=
      hV'_P.primeIdealOf ⟨z', hz'_V'⟩
    have hpt_z'_base : hV'_P.fromSpec.base pt_z' = z' :=
      hV'_P.fromSpec_primeIdealOf ⟨z', hz'_V'⟩
    have hle : pt_z'.asIdeal ≤ pt_zP.asIdeal := by
      apply (hFromSpec_cl_iff hV'_P pt_z' pt_zP).mp
      rwa [hpt_zP_base, hpt_z'_base]
    have hcomap : Ideal.comap γ'_P pt_z'.asIdeal = P := by
      rw [← hSpec_over_V (hV'_P.fromSpec ≫ π₁ ≫ g_X) pt_z']
      change ((π₁ ≫ g_X).base (hV'_P.fromSpec.base pt_z')).asIdeal = P
      rw [hpt_z'_base]; exact hz'_P
    let β' : B'_Y →+* B'_P := (π₂.appLE U'_Y V'_P e'_Y).hom
    have hβ'_γ : β'.comp γ'_Y = γ'_P := by
      have hSpec_eq : AlgebraicGeometry.Spec.map (γ'_Y_hom ≫ π₂.appLE U'_Y V'_P e'_Y) =
          hV'_P.fromSpec ≫ π₁ ≫ g_X := by
        calc
          AlgebraicGeometry.Spec.map (γ'_Y_hom ≫ π₂.appLE U'_Y V'_P e'_Y)
            = AlgebraicGeometry.Spec.map (π₂.appLE U'_Y V'_P e'_Y) ≫
                AlgebraicGeometry.Spec.map γ'_Y_hom := by
              rw [AlgebraicGeometry.Spec.map_comp]
          _ = (AlgebraicGeometry.Spec.map (π₂.appLE U'_Y V'_P e'_Y) ≫ hU'_Y.fromSpec) ≫ g_Y := by
              rw [AlgebraicGeometry.Spec.map_preimage, CategoryTheory.Category.assoc]
          _ = hV'_P.fromSpec ≫ (π₂ ≫ g_Y) := by
              rw [AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec π₂ hU'_Y hV'_P e'_Y,
                CategoryTheory.Category.assoc]
          _ = hV'_P.fromSpec ≫ π₁ ≫ g_X := by
              rw [← hπ_g]
      have hPre := congrArg AlgebraicGeometry.Spec.preimage hSpec_eq
      rw [AlgebraicGeometry.Spec.preimage_map] at hPre
      exact congrArg CommRingCat.Hom.hom hPre
    have hβ'_comap : Ideal.comap β' pt_zP.asIdeal = q_P := by
      have hmap_pt : (AlgebraicGeometry.Spec.map (π₂.appLE U'_Y V'_P e'_Y)).base pt_zP = pt'_P := by
        apply hU'_Y.fromSpec.isOpenEmbedding.injective
        change (AlgebraicGeometry.Spec.map (π₂.appLE U'_Y V'_P e'_Y) ≫ hU'_Y.fromSpec).base pt_zP = y_P
        rw [AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec π₂ hU'_Y hV'_P e'_Y]
        change π₂.base (hV'_P.fromSpec.base pt_zP) = y_P
        rw [hpt_zP_base, hzP_yP]
      rw [AlgebraicGeometry.Spec.map_apply] at hmap_pt
      exact congrArg PrimeSpectrum.asIdeal hmap_pt
    have ht_tr_P : ∀ g : Polynomial ↥V,
        (∃ i : ℕ, g.coeff i ∉ P) → Polynomial.eval₂ γ'_P (β' t_coord) g ∉ pt_zP.asIdeal := by
      intro g hg
      rw [← hβ'_γ, ← Polynomial.hom_eval₂ g γ'_Y β']
      change Polynomial.eval₂ γ'_Y t_coord g ∉ Ideal.comap β' pt_zP.asIdeal
      rw [hβ'_comap]
      exact ht_coord_tr g hg
    have hq_eq : pt_z'.asIdeal = pt_zP.asIdeal :=
      hBivar.1 F φ_KF hTwoVar P B'_P γ'_P φ'_P.hom hInj'_P hCompat'_P
        pt_z'.asIdeal pt_zP.asIdeal hle hcomap (β' t_coord) ht_tr_P
    have hpt_eq : pt_z' = pt_zP := PrimeSpectrum.ext hq_eq
    rw [← hpt_z'_base, ← hpt_zP_base, hpt_eq]
  obtain ⟨E_tilde, F_target, hE_comp, hF_comp, hF_two, hE_x₀, hE_im⟩ :=
    weil_residueField_fiber_pullback_components_assembly ↥V P X Y P_tilde g_X g_Y π₁ π₂
      hProp_π₂ hπ_g x₀ hClosed_x₀ z_P hz_x₀ hz_P y₁_base hy₁_ne hy₁_cl hy₁_P hMax_zP hMax_yP
  exact ⟨P, instPrimeP, hP_ne, x₀, E_tilde, F_target,
    hClosed_x₀, hx₀_P, hE_comp, hF_comp, hF_two, hE_x₀, hE_im⟩

theorem weil_strictlySemistable_affineNormal_and_birational_graph (K : Type u) [Field K] [IsSepClosed K]
    (m : ℕ) (V : ValuationSubring K) (hPkg : IsValuationRingAlgPackage m V)
    (hOpenη : AlgebraicGeometry.IsOpenImmersion
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (n : ℕ) (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (hIntCK : AlgebraicGeometry.IsIntegral C_K)
    (hSmCK : AlgebraicGeometry.SmoothOfRelativeDimension 1 p_K)
    (hStabCK : IsGeometricStablePointedCurve p_K n σ_K)
    (C' : AlgebraicGeometry.Scheme.{u})
    (g' : C' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (τ' : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C'))
    (ι' : C_K ⟶ C')
    (hMod' : IsValuationPointedCurveModel V p_K n σ_K C' g' τ' ι') :
    (∀ (W : AlgebraicGeometry.Scheme.{u})
        (g_W : W ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V)),
      IsStrictlySemistableCurveOverValuation V g_W →
      IsOverlapAffineNormalScheme W) ∧
    (∀ (U_0 : C'.Opens) (_ : Nonempty ↥U_0)
        (ι_U0 : AlgebraicGeometry.Scheme.Opens.toScheme
          ((TopologicalSpace.Opens.map ι'.base).obj U_0) ⟶ U_0.toScheme)
        (_ : CategoryTheory.IsPullback ι_U0
          (AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj U_0) ≫ p_K)
          (U_0.ι ≫ g')
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
        (X Y : AlgebraicGeometry.Scheme.{u})
        (g_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
        (g_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
        (f_X : X ⟶ U_0.toScheme)
        (f_Y : Y ⟶ U_0.toScheme)
        (ι_X : AlgebraicGeometry.Scheme.Opens.toScheme
          ((TopologicalSpace.Opens.map ι'.base).obj U_0) ⟶ X)
        (ι_Y : AlgebraicGeometry.Scheme.Opens.toScheme
          ((TopologicalSpace.Opens.map ι'.base).obj U_0) ⟶ Y),
      IsStrictlySemistableCurveOverValuation V g_X →
      IsStrictlySemistableCurveOverValuation V g_Y →
      TopologicalSpace.NoetherianSpace ↥X →
      TopologicalSpace.NoetherianSpace ↥Y →
      AlgebraicGeometry.IsProper f_X →
      AlgebraicGeometry.IsProper f_Y →
      f_X ≫ U_0.ι ≫ g' = g_X →
      f_Y ≫ U_0.ι ≫ g' = g_Y →
      ι_X ≫ f_X = ι_U0 →
      ι_Y ≫ f_Y = ι_U0 →
      CategoryTheory.IsPullback ι_X
        (AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj U_0) ≫ p_K)
        g_X
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)) →
      CategoryTheory.IsPullback ι_Y
        (AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj U_0) ≫ p_K)
        g_Y
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)) →
      (∃ α : X ⟶ Y, α ≫ f_Y = f_X) ∨
      ∃ (P_tilde : AlgebraicGeometry.Scheme.{u})
        (π₁ : P_tilde ⟶ X)
        (π₂ : P_tilde ⟶ Y)
        (ι_P : AlgebraicGeometry.Scheme.Opens.toScheme
          ((TopologicalSpace.Opens.map ι'.base).obj U_0) ⟶ P_tilde)
        (P : Ideal ↥V) (_ : P.IsPrime) (_ : P ≠ ⊥)
        (x₀ : X)
        (E_tilde : Set ↥(CategoryTheory.Limits.pullback (π₁ ≫ g_X)
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V P.ResidueField)))))
        (F_target : Set ↥(CategoryTheory.Limits.pullback g_Y
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V P.ResidueField))))),
        AlgebraicGeometry.IsIntegral P_tilde ∧
        TopologicalSpace.NoetherianSpace ↥P_tilde ∧
        AlgebraicGeometry.IsProper π₁ ∧
        AlgebraicGeometry.IsProper π₂ ∧
        π₁ ≫ f_X = π₂ ≫ f_Y ∧
        ι_P ≫ π₁ = ι_X ∧
        ι_P ≫ π₂ = ι_Y ∧
        CategoryTheory.IsPullback ι_P
