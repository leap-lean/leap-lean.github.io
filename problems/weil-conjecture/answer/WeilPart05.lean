    have hsub : Polynomial.C r₁ * Polynomial.X + Polynomial.C s₁ - Polynomial.C s₁ =
        Polynomial.C r₁ * Polynomial.X := add_sub_cancel_right _ _
    rw [hsub, ← mul_assoc, ← Polynomial.C_mul, hr₂₁, map_one, one_mul]
  have hev_L₁ : Polynomial.eval₂ α_R' w₂' L₁ = w₁' := by
    simp [L₁, w₁']
  have hPrim₁' : ∀ Q : Polynomial ↥R,
      (∃ j : ℕ, Q.coeff j ∉ IsLocalRing.maximalIdeal ↥R) →
      Polynomial.eval₂ α_R' w₁' Q ∉ IsLocalRing.maximalIdeal ↥W' := by
    intro Q ⟨j, hj⟩
    let Q_sh : Polynomial ↥R := Q.comp L₁
    have hQ_back : Q_sh.comp L₂ = Q := by
      dsimp only [Q_sh]
      rw [Polynomial.comp_assoc, hL₁₂, Polynomial.comp_X]
    have hQsh_prim : ∃ i : ℕ, Q_sh.coeff i ∉ IsLocalRing.maximalIdeal ↥R := by
      by_contra hAll
      have hAll' : ∀ i : ℕ, Q_sh.coeff i ∈ IsLocalRing.maximalIdeal ↥R :=
        fun i => Classical.not_not.mp fun hi => hAll ⟨i, hi⟩
      apply hj
      have hsum := Polynomial.as_sum_support_C_mul_X_pow Q_sh
      have hQ_sum : Q = ∑ i ∈ Q_sh.support,
          Polynomial.C (Q_sh.coeff i) * (Polynomial.X ^ i).comp L₂ := by
        calc Q = Q_sh.comp L₂ := hQ_back.symm
          _ = (∑ i ∈ Q_sh.support, Polynomial.C (Q_sh.coeff i) * Polynomial.X ^ i).comp L₂ :=
              congrArg (·.comp L₂) hsum
          _ = ∑ i ∈ Q_sh.support, Polynomial.C (Q_sh.coeff i) * (Polynomial.X ^ i).comp L₂ := by
              rw [Polynomial.sum_comp]
              refine Finset.sum_congr rfl fun i _ => ?_
              rw [Polynomial.mul_comp, Polynomial.C_comp]
      rw [hQ_sum, Polynomial.finsetSum_coeff]
      refine Ideal.sum_mem _ fun i _ => ?_
      rw [Polynomial.coeff_C_mul]
      exact Ideal.mul_mem_right _ _ (hAll' i)
    have h_not := hPrim₂' Q_sh hQsh_prim
    dsimp only [Q_sh] at h_not
    rwa [Polynomial.eval₂_comp, hev_L₁] at h_not
  
  have exists_dvd_min : ∀ (S : Finset ℕ) (f : ℕ → ↥R), S.Nonempty →
      ∃ i₀ ∈ S, ∀ i ∈ S, f i₀ ∣ f i := by
    intro S f
    induction S using Finset.induction_on with
    | empty =>
      intro hne
      exact absurd hne Finset.not_nonempty_empty
    | @insert k T hk ih =>
      intro _
      by_cases hT : T.Nonempty
      · obtain ⟨i₁, hi₁_T, hi₁_dvd⟩ := ih hT
        rcases ValuationRing.dvd_total (f k) (f i₁) with h_ki₁ | h_i₁k
        · refine ⟨k, Finset.mem_insert_self k T, fun i hi => ?_⟩
          rcases Finset.mem_insert.mp hi with rfl | hi_T
          · exact dvd_rfl
          · exact dvd_trans h_ki₁ (hi₁_dvd i hi_T)
        · refine ⟨i₁, Finset.mem_insert_of_mem hi₁_T, fun i hi => ?_⟩
          rcases Finset.mem_insert.mp hi with rfl | hi_T
          · exact h_i₁k
          · exact hi₁_dvd i hi_T
      · rw [Finset.not_nonempty_iff_eq_empty.mp hT]
        refine ⟨k, Finset.mem_singleton_self k, fun i hi => ?_⟩
        rw [Finset.mem_singleton.mp hi]
  have gauss_factor : ∀ P : Polynomial ↥R, P ≠ 0 →
      ∃ (a : ↥R) (P₀ : Polynomial ↥R),
        a ≠ 0 ∧ (∃ j₀ : ℕ, P₀.coeff j₀ ∉ IsLocalRing.maximalIdeal ↥R) ∧
        P = Polynomial.C a * P₀ := by
    intro P hP
    obtain ⟨i₀, hi₀, hdvd⟩ :=
      exists_dvd_min P.support P.coeff (Polynomial.support_nonempty.mpr hP)
    let a : ↥R := P.coeff i₀
    have ha_ne : a ≠ 0 := Polynomial.mem_support_iff.mp hi₀
    let c : ℕ → ↥R := fun i =>
      if i = i₀ then 1
      else if hi : i ∈ P.support then Classical.choose (hdvd i hi)
      else 0
    have hac : ∀ i : ℕ, a * c i = P.coeff i := by
      intro i
      dsimp only [c]
      split_ifs with h₁ h₂
      · subst h₁
        exact mul_one a
      · exact (Classical.choose_spec (hdvd i h₂)).symm
      · rw [mul_zero]
        exact (Polynomial.notMem_support_iff.mp h₂).symm
    let P₀ : Polynomial ↥R := ∑ i ∈ P.support, Polynomial.monomial i (c i)
    have hP₀_coeff : ∀ j : ℕ, P₀.coeff j = if j ∈ P.support then c j else 0 := by
      intro j
      dsimp only [P₀]
      rw [Polynomial.finsetSum_coeff]
      split_ifs with hj
      · rw [Finset.sum_eq_single j]
        · exact Polynomial.coeff_monomial_same j (c j)
        · intro i _ hij
          rw [Polynomial.coeff_monomial, ite_eq_right_iff.mpr fun h => absurd h hij]
        · intro hnot
          exact absurd hj hnot
      · refine Finset.sum_eq_zero fun i hi => ?_
        have hij : i ≠ j := fun heq => hj (heq ▸ hi)
        rw [Polynomial.coeff_monomial, ite_eq_right_iff.mpr fun h => absurd h hij]
    have hP₀_i0 : P₀.coeff i₀ ∉ IsLocalRing.maximalIdeal ↥R := by
      have hc_i0 : P₀.coeff i₀ = 1 := by
        rw [hP₀_coeff i₀, ite_eq_left_iff.mpr fun h => absurd hi₀ h]
        simp [c]
      rw [hc_i0]
      exact h1_not_mR
    refine ⟨a, P₀, ha_ne, ⟨i₀, hP₀_i0⟩, ?_⟩
    apply Polynomial.ext
    intro j
    rw [Polynomial.coeff_C_mul, hP₀_coeff j]
    split_ifs with hj
    · exact (hac j).symm
    · rw [mul_zero]
      exact Polynomial.notMem_support_iff.mp hj
  have val_mem_char : ∀ (V : ValuationSubring F_0)
      (hR_V : ∀ r : ↥R, φ_R r ∈ V)
      (w_V : ↥V),
      w_V.1 = w₀.1 →
      (∀ r : ↥R, (⟨φ_R r, hR_V r⟩ : ↥V) ∈ IsLocalRing.maximalIdeal ↥V ↔
        r ∈ IsLocalRing.maximalIdeal ↥R) →
      (∀ Q : Polynomial ↥R, (∃ j : ℕ, Q.coeff j ∉ IsLocalRing.maximalIdeal ↥R) →
        Polynomial.eval₂ (φ_R.codRestrict V.toSubring hR_V) w_V Q ∉
          IsLocalRing.maximalIdeal ↥V) →
      (∀ x : K, φ_KF0 x ∈ V ↔ x ∈ R) ∧
      (∀ P₀ : Polynomial ↥R,
        (∃ j : ℕ, P₀.coeff j ∉ IsLocalRing.maximalIdeal ↥R) →
        Polynomial.eval₂ φ_R w₀.1 P₀ ≠ 0 ∧
        Polynomial.eval₂ φ_R w₀.1 P₀ ∈ V ∧
        (Polynomial.eval₂ φ_R w₀.1 P₀)⁻¹ ∈ V) := by
    intro V hR_V w_V hw_V_eq hm_V hPrim_V
    let α_RV : ↥R →+* ↥V := φ_R.codRestrict V.toSubring hR_V
    have hsub_α : V.subtype.comp α_RV = φ_R := RingHom.ext fun _ => rfl
    refine ⟨fun x => ⟨fun hxV => ?_, fun hxR => hR_V ⟨x, hxR⟩⟩, fun P₀ hP₀ => ?_⟩
    · by_contra hxR
      have hx0 : x ≠ 0 := fun h0 => hxR (h0 ▸ R.zero_mem)
      rcases ValuationSubring.mem_or_inv_mem R x with hx_in | hx_inv
      · exact hxR hx_in
      · let r : ↥R := ⟨x⁻¹, hx_inv⟩
        have hr_max : r ∈ IsLocalRing.maximalIdeal ↥R := by
          rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
          intro hu
          rcases hu.exists_right_inv with ⟨s, hs⟩
          have hval : x⁻¹ * s.1 = 1 := congrArg Subtype.val hs
          have hs_eq : s.1 = x := by
            calc s.1 = x * (x⁻¹ * s.1) := by rw [← mul_assoc, mul_inv_cancel₀ hx0, one_mul]
              _ = x := by rw [hval, mul_one]
          exact hxR (hs_eq ▸ s.2)
        have hαr_max : α_RV r ∈ IsLocalRing.maximalIdeal ↥V := (hm_V r).mpr hr_max
        have hαr_unit : IsUnit (α_RV r) := by
          have hmul1 : α_RV r * (⟨φ_KF0 x, hxV⟩ : ↥V) = 1 := by
            apply Subtype.ext
            change φ_KF0 x⁻¹ * φ_KF0 x = 1
            rw [← map_mul, inv_mul_cancel₀ hx0, map_one]
          exact ⟨⟨α_RV r, ⟨φ_KF0 x, hxV⟩, hmul1, mul_comm (α_RV r) _ ▸ hmul1⟩, rfl⟩
        exact (IsLocalRing.mem_maximalIdeal (α_RV r)).mp hαr_max hαr_unit
    · let u_V : ↥V := Polynomial.eval₂ α_RV w_V P₀
      have hu_unit : IsUnit u_V := IsLocalRing.notMem_maximalIdeal.mp (hPrim_V P₀ hP₀)
      rcases hu_unit.exists_right_inv with ⟨v_V, hv_V⟩
      have hu_val : u_V.1 = Polynomial.eval₂ φ_R w₀.1 P₀ := by
        calc u_V.1 = V.subtype (Polynomial.eval₂ α_RV w_V P₀) := rfl
          _ = Polynomial.eval₂ (V.subtype.comp α_RV) (V.subtype w_V) P₀ :=
              Polynomial.hom_eval₂ P₀ α_RV V.subtype w_V
          _ = Polynomial.eval₂ φ_R w₀.1 P₀ := by rw [hsub_α]; congr 1
      have huv : u_V.1 * v_V.1 = 1 := congrArg Subtype.val hv_V
      have hu_ne : u_V.1 ≠ 0 := by
        intro h0
        rw [h0, zero_mul] at huv
        exact zero_ne_one huv
      have hinv_eq : (u_V.1)⁻¹ = v_V.1 := by
        calc (u_V.1)⁻¹ = (u_V.1)⁻¹ * (u_V.1 * v_V.1) := by rw [huv, mul_one]
          _ = ((u_V.1)⁻¹ * u_V.1) * v_V.1 := (mul_assoc _ _ _).symm
          _ = v_V.1 := by rw [inv_mul_cancel₀ hu_ne, one_mul]
      rw [← hu_val]
      exact ⟨hu_ne, u_V.2, hinv_eq.symm ▸ v_V.2⟩
  obtain ⟨hK_W', hUnit_W'⟩ := val_mem_char W' hR' w₁' hw₁'_eq hm' hPrim₁'
  obtain ⟨hK_W0, hUnit_W0⟩ := val_mem_char W_0 hR₀ w₀ rfl hm₀ hPrim₀
  have hComap : W.comap φ_F0_FWB = W_0 := by
    change W' = W_0
    ext z
    by_cases hz : z = 0
    · subst hz
      exact ⟨fun _ => W_0.zero_mem, fun _ => W'.zero_mem⟩
    · obtain ⟨A₁, A₂, hA₂_ne, hz_A⟩ := hFrac z
      have hA₁_ne : Polynomial.eval₂ φ_R T_0 A₁ ≠ 0 := by
        rw [← hz_A]
        exact mul_ne_zero hz hA₂_ne
      let S_lin : Polynomial ↥R := Polynomial.C c₁ + Polynomial.C π₁ * Polynomial.X
      have hev_S : Polynomial.eval₂ φ_R w₀.1 S_lin = T_0 := by
        have hlin_S : Polynomial.eval₂ φ_R w₀.1 S_lin = φ_R c₁ + φ_R π₁ * w₀.1 := by
          simp [S_lin]
        rw [hlin_S]
        have hw₀' : φ_R π₁ * w₀.1 = T_0 - φ_R c₁ := hw₀
        linear_combination hw₀'
      let P : Polynomial ↥R := A₁.comp S_lin
      let Q : Polynomial ↥R := A₂.comp S_lin
      have hev_P : Polynomial.eval₂ φ_R w₀.1 P = Polynomial.eval₂ φ_R T_0 A₁ := by
        dsimp only [P]
        rw [Polynomial.eval₂_comp, hev_S]
      have hev_Q : Polynomial.eval₂ φ_R w₀.1 Q = Polynomial.eval₂ φ_R T_0 A₂ := by
        dsimp only [Q]
        rw [Polynomial.eval₂_comp, hev_S]
      have hP_ne : P ≠ 0 := by
        intro h0
        apply hA₁_ne
        rw [← hev_P, h0, Polynomial.eval₂_zero]
      have hQ_ne : Q ≠ 0 := by
        intro h0
        apply hA₂_ne
        rw [← hev_Q, h0, Polynomial.eval₂_zero]
      obtain ⟨a, P₀, _, hP₀_prim, hP_fac⟩ := gauss_factor P hP_ne
      obtain ⟨b, Q₀, hb_ne, hQ₀_prim, hQ_fac⟩ := gauss_factor Q hQ_ne
      let eP₀ : F_0 := Polynomial.eval₂ φ_R w₀.1 P₀
      let eQ₀ : F_0 := Polynomial.eval₂ φ_R w₀.1 Q₀
      obtain ⟨heP₀_ne, heP₀_W', heP₀_inv_W'⟩ := hUnit_W' P₀ hP₀_prim
      obtain ⟨heQ₀_ne, heQ₀_W', heQ₀_inv_W'⟩ := hUnit_W' Q₀ hQ₀_prim
      obtain ⟨_, heP₀_W0, heP₀_inv_W0⟩ := hUnit_W0 P₀ hP₀_prim
      obtain ⟨_, heQ₀_W0, heQ₀_inv_W0⟩ := hUnit_W0 Q₀ hQ₀_prim
      have hφb_ne : φ_KF0 b.1 ≠ 0 := hφR_ne hb_ne
      have hbK_ne : (b.1 : K) ≠ 0 := fun h0 => hb_ne (Subtype.ext h0)
      have hz_rel : z * (φ_KF0 b.1 * eQ₀) = φ_KF0 a.1 * eP₀ := by
        have hP_ev : Polynomial.eval₂ φ_R w₀.1 P = φ_KF0 a.1 * eP₀ := by
          rw [hP_fac, Polynomial.eval₂_mul, Polynomial.eval₂_C]
          rfl
        have hQ_ev : Polynomial.eval₂ φ_R w₀.1 Q = φ_KF0 b.1 * eQ₀ := by
          rw [hQ_fac, Polynomial.eval₂_mul, Polynomial.eval₂_C]
          rfl
        rw [← hP_ev, ← hQ_ev, hev_P, hev_Q]
        exact hz_A
      have hz_formula : z = φ_KF0 (a.1 * (b.1)⁻¹) * (eP₀ * eQ₀⁻¹) := by
        apply mul_right_cancel₀ (mul_ne_zero hφb_ne heQ₀_ne)
        calc z * (φ_KF0 b.1 * eQ₀)
          _ = φ_KF0 a.1 * eP₀ := hz_rel
          _ = (φ_KF0 a.1 * ((φ_KF0 b.1)⁻¹ * φ_KF0 b.1)) * (eP₀ * (eQ₀⁻¹ * eQ₀)) := by
              rw [inv_mul_cancel₀ hφb_ne, mul_one, inv_mul_cancel₀ heQ₀_ne, mul_one]
          _ = (φ_KF0 (a.1 * (b.1)⁻¹) * (eP₀ * eQ₀⁻¹)) * (φ_KF0 b.1 * eQ₀) := by
              rw [map_mul, map_inv₀]
              ring
      have hab_formula : φ_KF0 (a.1 * (b.1)⁻¹) = z * (eQ₀ * eP₀⁻¹) := by
        calc φ_KF0 (a.1 * (b.1)⁻¹)
          _ = φ_KF0 (a.1 * (b.1)⁻¹) * ((eP₀ * eP₀⁻¹) * (eQ₀⁻¹ * eQ₀)) := by
              rw [mul_inv_cancel₀ heP₀_ne, inv_mul_cancel₀ heQ₀_ne, mul_one, mul_one]
          _ = (φ_KF0 (a.1 * (b.1)⁻¹) * (eP₀ * eQ₀⁻¹)) * (eQ₀ * eP₀⁻¹) := by ring
          _ = z * (eQ₀ * eP₀⁻¹) := by rw [← hz_formula]
      have hiff_W' : z ∈ W' ↔ a.1 * (b.1)⁻¹ ∈ R := by
        rw [← hK_W']
        exact ⟨fun hz_in => hab_formula ▸ mul_mem hz_in (mul_mem heQ₀_W' heP₀_inv_W'),
          fun hab_in => hz_formula ▸ mul_mem hab_in (mul_mem heP₀_W' heQ₀_inv_W')⟩
      have hiff_W0 : z ∈ W_0 ↔ a.1 * (b.1)⁻¹ ∈ R := by
        rw [← hK_W0]
        exact ⟨fun hz_in => hab_formula ▸ mul_mem hz_in (mul_mem heQ₀_W0 heP₀_inv_W0),
          fun hab_in => hz_formula ▸ mul_mem hab_in (mul_mem heP₀_W0 heQ₀_inv_W0)⟩
      exact hiff_W'.trans hiff_W0.symm
  
  have hxW : ∀ x : ↥W_0, φ_F0_FWB x.1 ∈ W :=
    fun x => ValuationSubring.mem_comap.mp (Eq.mp (congrArg (x.1 ∈ ·) hComap.symm) x.2)
  let j_W : ↥W_0 →+* ↥W := (φ_F0_FWB.comp W_0.subtype).codRestrict W.toSubring hxW
  have hj_sub : W.subtype.comp j_W = φ_F0_FWB.comp W_0.subtype :=
    RingHom.ext fun _ => rfl
  have h1_not_pW0 : (1 : ↥W_0) ∉ pW0.asIdeal :=
    fun h1 => pW0.isPrime.ne_top (Ideal.eq_top_iff_one _ |>.mpr h1)
  have hBloc_ex : ∃ B_loc : ValuationSubring F_WB,
      ∀ z : F_WB, z ∈ B_loc ↔ ∃ s : ↥W_0, s ∉ pW0.asIdeal ∧ φ_F0_FWB s.1 * z ∈ W := by
    let S_sub : Subring F_WB :=
      { carrier := {z : F_WB | ∃ s : ↥W_0, s ∉ pW0.asIdeal ∧ φ_F0_FWB s.1 * z ∈ W}
        one_mem' := ⟨1, h1_not_pW0, by simp⟩
        mul_mem' := by
          rintro z₁ z₂ ⟨s₁, hs₁, hz₁⟩ ⟨s₂, hs₂, hz₂⟩
          refine ⟨s₁ * s₂, fun h12 => (pW0.isPrime.mem_or_mem h12).elim hs₁ hs₂, ?_⟩
          have hmul : φ_F0_FWB (s₁ * s₂).1 * (z₁ * z₂) =
              (φ_F0_FWB s₁.1 * z₁) * (φ_F0_FWB s₂.1 * z₂) := by
            change φ_F0_FWB (s₁.1 * s₂.1) * (z₁ * z₂) = _
            rw [map_mul]
            ring
          rw [hmul]
          exact mul_mem hz₁ hz₂
        zero_mem' := ⟨1, h1_not_pW0, by simp⟩
        add_mem' := by
          rintro z₁ z₂ ⟨s₁, hs₁, hz₁⟩ ⟨s₂, hs₂, hz₂⟩
          refine ⟨s₁ * s₂, fun h12 => (pW0.isPrime.mem_or_mem h12).elim hs₁ hs₂, ?_⟩
          have hadd : φ_F0_FWB (s₁ * s₂).1 * (z₁ + z₂) =
              φ_F0_FWB s₂.1 * (φ_F0_FWB s₁.1 * z₁) +
                φ_F0_FWB s₁.1 * (φ_F0_FWB s₂.1 * z₂) := by
            change φ_F0_FWB (s₁.1 * s₂.1) * (z₁ + z₂) = _
            rw [map_mul]
            ring
          rw [hadd]
          exact add_mem (mul_mem (hxW s₂) hz₁) (mul_mem (hxW s₁) hz₂)
        neg_mem' := by
          rintro z ⟨s, hs, hz⟩
          refine ⟨s, hs, ?_⟩
          rw [mul_neg]
          exact neg_mem hz }
    have h_or : ∀ z : F_WB, z ∈ S_sub ∨ z⁻¹ ∈ S_sub := by
      intro z
      rcases ValuationSubring.mem_or_inv_mem W z with hz | hz_inv
      · exact Or.inl ⟨1, h1_not_pW0, by simpa using hz⟩
      · exact Or.inr ⟨1, h1_not_pW0, by simpa using hz_inv⟩
    exact ⟨ValuationSubring.ofSubring S_sub h_or, fun z => ValuationSubring.mem_ofSubring S_sub h_or z⟩
  obtain ⟨B_loc, hBloc_mem⟩ := hBloc_ex
  let ι_B : ↥W →+* ↥B_loc :=
    W.subtype.codRestrict B_loc.toSubring
      (fun w => (hBloc_mem w.1).mpr ⟨1, h1_not_pW0, by simp [w.2]⟩)
  let pW : AlgebraicGeometry.Spec (CommRingCat.of ↥W) :=
    ⟨Ideal.comap ι_B (IsLocalRing.maximalIdeal ↥B_loc), Ideal.IsPrime.comap ι_B⟩
  have hpW_eq : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom j_W)).base pW = pW0 := by
    rw [AlgebraicGeometry.Spec.map_apply]
