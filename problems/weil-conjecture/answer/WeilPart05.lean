                mk_c (MvPolynomial.X 1) := by
            simp only [← map_mul]; congr 1; ring
          rw [h_eq]
          exact Ideal.mem_sup_left (Ideal.mul_mem_left _ _ (Ideal.subset_span (by simp)))
    have hu : IsUnit (εbar h) := isUnit_iff_ne_zero.mpr hh_ne0
    let εtilde : Localization.Away h →+* k_R := IsLocalization.Away.lift h hu
    let p_nod : PrimeSpectrum (Localization.Away h) :=
      ⟨RingHom.ker εtilde, RingHom.ker_isPrime εtilde⟩
    have hp_nod_mR : (g_tilde.base (ι_U.base p_nod)).asIdeal = m_R := by
      have h_eq : g_tilde.base (ι_U.base p_nod) =
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            ((algebraMap (weilNodalQuot ↥R c') (Localization.Away h)).comp
              (mk_c.comp MvPolynomial.C)))).base p_nod := by
        change (ι_U ≫ g_tilde).base p_nod = _
        rw [hιU_g, ← CommRingCat.ofHom_comp]
      rw [h_eq]
      ext r
      change εtilde (algebraMap (weilNodalQuot ↥R c') (Localization.Away h)
        (mk_c (MvPolynomial.C r))) = 0 ↔ r ∈ m_R
      rw [IsLocalization.Away.lift_eq (S := Localization.Away h) h hu]
      change ε00 (MvPolynomial.C r) = 0 ↔ r ∈ m_R
      simp only [ε00, MvPolynomial.eval₂Hom_C]
      exact Ideal.algebraMap_residueField_eq_zero
    have hp_nod_X : ∀ b : Fin 2,
        algebraMap (weilNodalQuot ↥R c') (Localization.Away h)
          (mk_c (MvPolynomial.X b)) ∈ p_nod.asIdeal := by
      intro b
      change εtilde (algebraMap (weilNodalQuot ↥R c') (Localization.Away h)
        (mk_c (MvPolynomial.X b))) = 0
      rw [IsLocalization.Away.lift_eq (S := Localization.Away h) h hu]
      change ε00 (MvPolynomial.X b) = 0
      simp [ε00]
    have hp_nod_ip : ι_U.base p_nod ∈ B_set i_p :=
      (hιU_comp p_nod i_p hp_nod_mR).mpr (Or.inl ⟨rfl, hp_nod_X 1⟩)
    have hp_nod_ic : ι_U.base p_nod ∈ B_set i_c :=
