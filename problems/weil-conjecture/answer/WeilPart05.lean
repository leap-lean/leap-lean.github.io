          change (φ_e.comp θ) x_0 = φ_e (U_0 + c_B c_e)
          rw [hφe_θ, hφtop_X0, map_add]
          change T_0 = ψ_e x_0 + ψ_e (c_A0 c_e)
          rw [hψe_x0, hψe_C]
          dsimp only [τ]
          ring
        have hce_mR : c_e ∈ m_R := by
          have hce_r0 : c_e = r_0 * a₀ := by linear_combination hce_eq
          rw [hce_r0]
          exact m_R.mul_mem_left r_0 ha0_mR
        have hcB_mR : ∀ r : ↥R, c_B r ∈ p_max.asIdeal ↔ r ∈ m_R := by
          have h1 : (ι_e ≫ g'_M).base p_max =
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_B)).base p_max := by rw [hιe_g']
          have h2 : (PrimeSpectrum.comap c_B p_max).asIdeal = m_R :=
            (congrArg PrimeSpectrum.asIdeal h1).symm.trans hp_mR
          intro r
          change r ∈ (PrimeSpectrum.comap c_B p_max).asIdeal ↔ r ∈ m_R
          rw [h2]
        have hx0_I1 : x_0 ∈ (PrimeSpectrum.comap θ p_max).asIdeal := by
          change θ x_0 ∈ p_max.asIdeal
          rw [hθ_x0]
          exact p_max.asIdeal.add_mem (hp_X 0) ((hcB_mR c_e).mpr hce_mR)
        have hθ_x1_rel : (1 + c_B r_0 * U_1) * θ x_1 = U_1 := by
          apply hInj_φe
          apply mul_left_cancel₀ hτ_ne
          have h1 : τ * φ_e (1 + c_B r_0 * U_1) = T_0 := by
            rw [map_add, map_one, map_mul]
            change τ * (1 + ψ_e (c_A0 r_0) * ψ_e x_1) = T_0
            rw [hψe_C]
            calc τ * (1 + φ_R r_0 * ψ_e x_1)
                = τ + φ_R r_0 * (τ * ψ_e x_1) := by ring
              _ = (T_0 - φ_R c_e) + φ_R r_0 * φ_R a₀ := by rw [hψe_x1]
              _ = T_0 - φ_R c_e + φ_R (r_0 * a₀) := by rw [← map_mul]
              _ = T_0 - φ_R c_e + φ_R (c_e - 0) := by rw [← hce_eq]
              _ = T_0 := by rw [sub_zero]; ring
          have h2 : T_0 * φ_e (θ x_1) = φ_R a₀ := by
            change T_0 * (φ_e.comp θ) x_1 = φ_R a₀
            rw [hφe_θ, ← hφtop_X0, ← map_mul, hx01, hφtop_C]
          rw [map_mul, ← mul_assoc, h1, h2]
          exact hψe_x1.symm
        have hx1_I1 : x_1 ∈ (PrimeSpectrum.comap θ p_max).asIdeal := by
          change θ x_1 ∈ p_max.asIdeal
          have hprod_mem : (1 + c_B r_0 * U_1) * θ x_1 ∈ p_max.asIdeal := by
            rw [hθ_x1_rel]; exact hp_X 1
          rcases p_max.isPrime.mem_or_mem hprod_mem with hunit_mem | hx1_mem
          · exfalso
            have h1_mem : (1 : B_e) ∈ p_max.asIdeal := by
              have h_eq1 : (1 : B_e) = (1 + c_B r_0 * U_1) - c_B r_0 * U_1 := by ring
              rw [h_eq1]
              exact p_max.asIdeal.sub_mem hunit_mem
                (p_max.asIdeal.mul_mem_left (c_B r_0) (hp_X 1))
            exact p_max.isPrime.ne_top (p_max.asIdeal.eq_top_iff_one.mpr h1_mem)
          · exact hx1_mem
        have hcA0_I1 : ∀ r : ↥R, c_A0 r ∈ (PrimeSpectrum.comap θ p_max).asIdeal ↔ r ∈ m_R := by
          have h1 : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ.comp c_A0)) =
              ι_e ≫ g'_M := by
            rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, hθ_map,
              CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hiso_g, hf'_g]
          have h2 : (PrimeSpectrum.comap (θ.comp c_A0) p_max).asIdeal = m_R :=
            (congrArg PrimeSpectrum.asIdeal (congrArg (fun f => f.base p_max) h1)).trans hp_mR
          intro r
          change r ∈ (PrimeSpectrum.comap (θ.comp c_A0) p_max).asIdeal ↔ r ∈ m_R
          rw [h2]
        have hcA0_I2 : ∀ r : ↥R, c_A0 r ∈ (iso.hom.base m_0).asIdeal ↔ r ∈ m_R := by
          intro r
          refine ⟨fun hmem => ?_, fun hr => hm0_mR r hr⟩
          by_contra hr_not
          have hu_r : IsUnit r := IsLocalRing.notMem_maximalIdeal.mp hr_not
          exact (iso.hom.base m_0).isPrime.ne_top
            (Ideal.eq_top_of_isUnit_mem _ hmem (hu_r.map c_A0))
        have hspan_I1 : Ideal.span ({x_0, x_1} : Set A₀) ≤
            (PrimeSpectrum.comap θ p_max).asIdeal := by
          rw [Ideal.span_le, Set.insert_subset_iff, Set.singleton_subset_iff]
          exact ⟨hx0_I1, hx1_I1⟩
        have hspan_I2 : Ideal.span ({x_0, x_1} : Set A₀) ≤ (iso.hom.base m_0).asIdeal := by
          rw [Ideal.span_le, Set.insert_subset_iff, Set.singleton_subset_iff]
          exact ⟨hm0_X 0, hm0_X 1⟩
        have hcomap_eq : PrimeSpectrum.comap θ p_max = iso.hom.base m_0 := by
          ext q
          obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective q
          have hdiff_1 : mk F - c_A0 (F.coeff 0) ∈ (PrimeSpectrum.comap θ p_max).asIdeal :=
            hspan_I1 (nodal_sub_const_mem_span a₀ F)
          have hdiff_2 : mk F - c_A0 (F.coeff 0) ∈ (iso.hom.base m_0).asIdeal :=
            hspan_I2 (nodal_sub_const_mem_span a₀ F)
          have hc_eq : c_A0 (F.coeff 0) = mk F - (mk F - c_A0 (F.coeff 0)) := by ring
          have hF_eq : mk F = (mk F - c_A0 (F.coeff 0)) + c_A0 (F.coeff 0) := by ring
          constructor
          · intro hmem
            have hc_mem1 : c_A0 (F.coeff 0) ∈ (PrimeSpectrum.comap θ p_max).asIdeal := by
              rw [hc_eq]
              exact (PrimeSpectrum.comap θ p_max).asIdeal.sub_mem hmem hdiff_1
            have hc_mem2 : c_A0 (F.coeff 0) ∈ (iso.hom.base m_0).asIdeal :=
              (hcA0_I2 _).mpr ((hcA0_I1 _).mp hc_mem1)
            change mk F ∈ (iso.hom.base m_0).asIdeal
            rw [hF_eq]
            exact (iso.hom.base m_0).asIdeal.add_mem hdiff_2 hc_mem2
          · intro hmem
            have hmem' : mk F ∈ (iso.hom.base m_0).asIdeal := hmem
            have hc_mem2 : c_A0 (F.coeff 0) ∈ (iso.hom.base m_0).asIdeal := by
              rw [hc_eq]
              exact (iso.hom.base m_0).asIdeal.sub_mem hmem' hdiff_2
            have hc_mem1 : c_A0 (F.coeff 0) ∈ (PrimeSpectrum.comap θ p_max).asIdeal :=
              (hcA0_I1 _).mpr ((hcA0_I2 _).mp hc_mem2)
            change mk F ∈ (PrimeSpectrum.comap θ p_max).asIdeal
            rw [hF_eq]
            exact (PrimeSpectrum.comap θ p_max).asIdeal.add_mem hdiff_1 hc_mem1
        have hiso_pt : iso.hom.base (f'_M.base (ι_e.base p_max)) = iso.hom.base m_0 := by
          change (ι_e ≫ f'_M ≫ iso.hom).base p_max = iso.hom.base m_0
          rw [← hθ_map]
          exact hcomap_eq
        have hinv_pt := congrArg iso.inv.base hiso_pt
        change (iso.hom ≫ iso.inv).base (f'_M.base (ι_e.base p_max)) =
          (iso.hom ≫ iso.inv).base m_0 at hinv_pt
        rw [iso.hom_inv_id] at hinv_pt
        exact hinv_pt

theorem weil_blowup_center_comap_and_gauss_stalk_bridge (K : Type u) [Field K] (R : ValuationSubring K)
    (a_opt : Option ↥R)
    (M_0 : AlgebraicGeometry.Scheme.{u})
    (g_M0 : M_0 ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
    (m_0 : ↥M_0)
    (F_0 : Type u) [Field F_0]
    (η_M0 : AlgebraicGeometry.Spec (CommRingCat.of F_0) ⟶ M_0)
    (φ_KF0 : K →+* F_0) (T_0 : F_0)
    (hηM0_g : η_M0 ≫ g_M0 = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_KF0.comp R.subtype)))
    (hGauss : HasStandardGaussDiscValuations R a_opt g_M0 m_0 η_M0 φ_KF0 T_0) :
    (∀ (h_p h_0 : Polynomial ↥R) (c_tilde π_tilde : ↥R)
       (Q₀_R : PrimeSpectrum ↥R)
       (σ_loc : AlgebraicGeometry.Spec (CommRingCat.of (↥R ⧸ Q₀_R.asIdeal)) ⟶
         AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away h_p)))
       (ψ_0 : Localization.Away h_p →+* Localization.Away h_0),
      π_tilde ∈ Q₀_R.asIdeal →
      σ_loc ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          ((algebraMap (Polynomial ↥R) (Localization.Away h_p)).comp Polynomial.C)) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk Q₀_R.asIdeal)) →
      (∀ q : PrimeSpectrum (↥R ⧸ Q₀_R.asIdeal),
        algebraMap (Polynomial ↥R) (Localization.Away h_p)
          (Polynomial.X - Polynomial.C c_tilde) ∈ (σ_loc.base q).asIdeal) →
      (∀ r : ↥R,
        ψ_0 (algebraMap (Polynomial ↥R) (Localization.Away h_p) (Polynomial.C r)) =
          algebraMap (Polynomial ↥R) (Localization.Away h_0) (Polynomial.C r)) →
      ψ_0 (algebraMap (Polynomial ↥R) (Localization.Away h_p) Polynomial.X) =
        algebraMap (Polynomial ↥R) (Localization.Away h_0)
          (Polynomial.C c_tilde + Polynomial.C π_tilde * Polynomial.X) →
      ∀ (q : PrimeSpectrum (↥R ⧸ Q₀_R.asIdeal)) (p_Z : PrimeSpectrum (Localization.Away h_0)),
        Ideal.comap ((algebraMap (Polynomial ↥R) (Localization.Away h_0)).comp Polynomial.C)
            p_Z.asIdeal =
          Ideal.comap (Ideal.Quotient.mk Q₀_R.asIdeal) q.asIdeal →
        PrimeSpectrum.comap ψ_0 p_Z = σ_loc.base q) ∧
    (∀ (π_tilde b' δ_e : ↥R)
       (h_e : weilNodalQuot ↥R (b' * π_tilde))
       (h_Z : Polynomial ↥R)
       (Q₀_R : PrimeSpectrum ↥R)
       (σ_loc : AlgebraicGeometry.Spec (CommRingCat.of (↥R ⧸ Q₀_R.asIdeal)) ⟶
         AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away h_e)))
       (ψ_Z : Localization.Away h_e →+* Localization.Away h_Z),
      π_tilde ∈ Q₀_R.asIdeal →
      b' ∈ Q₀_R.asIdeal →
      IsUnit (algebraMap (Polynomial ↥R) (Localization.Away h_Z)
        (Polynomial.X - Polynomial.C δ_e)) →
      σ_loc ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom
              ((Ideal.Quotient.mk (weilNodalIdeal ↥R (b' * π_tilde))).comp MvPolynomial.C) ≫
            CommRingCat.ofHom
              (algebraMap (weilNodalQuot ↥R (b' * π_tilde)) (Localization.Away h_e))) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk Q₀_R.asIdeal)) →
      (∀ (q : PrimeSpectrum (↥R ⧸ Q₀_R.asIdeal)) (b_idx : Fin 2),
        algebraMap (weilNodalQuot ↥R (b' * π_tilde)) (Localization.Away h_e)
          (Ideal.Quotient.mk (weilNodalIdeal ↥R (b' * π_tilde)) (MvPolynomial.X b_idx)) ∈
            (σ_loc.base q).asIdeal) →
      (∀ r : ↥R,
        ψ_Z (algebraMap (weilNodalQuot ↥R (b' * π_tilde)) (Localization.Away h_e)
            (Ideal.Quotient.mk (weilNodalIdeal ↥R (b' * π_tilde)) (MvPolynomial.C r))) =
          algebraMap (Polynomial ↥R) (Localization.Away h_Z) (Polynomial.C r)) →
      ψ_Z (algebraMap (weilNodalQuot ↥R (b' * π_tilde)) (Localization.Away h_e)
          (Ideal.Quotient.mk (weilNodalIdeal ↥R (b' * π_tilde)) (MvPolynomial.X 0))) =
        algebraMap (Polynomial ↥R) (Localization.Away h_Z)
          (Polynomial.C π_tilde * (Polynomial.X - Polynomial.C δ_e)) →
      algebraMap (Polynomial ↥R) (Localization.Away h_Z)
          (Polynomial.X - Polynomial.C δ_e) *
        ψ_Z (algebraMap (weilNodalQuot ↥R (b' * π_tilde)) (Localization.Away h_e)
            (Ideal.Quotient.mk (weilNodalIdeal ↥R (b' * π_tilde)) (MvPolynomial.X 1))) =
        algebraMap (Polynomial ↥R) (Localization.Away h_Z) (Polynomial.C b') →
      ∀ (q : PrimeSpectrum (↥R ⧸ Q₀_R.asIdeal)) (p_Z : PrimeSpectrum (Localization.Away h_Z)),
        Ideal.comap ((algebraMap (Polynomial ↥R) (Localization.Away h_Z)).comp Polynomial.C)
            p_Z.asIdeal =
          Ideal.comap (Ideal.Quotient.mk Q₀_R.asIdeal) q.asIdeal →
        PrimeSpectrum.comap ψ_Z p_Z = σ_loc.base q) ∧
    (∀ (M' M_tilde : AlgebraicGeometry.Scheme.{u})
       (g'_M : M' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
       (f'_M : M' ⟶ M_0)
       (q_M : M_tilde ⟶ M')
       (η_tilde : AlgebraicGeometry.Spec (CommRingCat.of F_0) ⟶ M_tilde)
       (c_Z π_Z : ↥R)
       (Q₀_R : PrimeSpectrum ↥R)
       (σ_Mod : AlgebraicGeometry.Spec (CommRingCat.of (↥R ⧸ Q₀_R.asIdeal)) ⟶ M')
       (q_max : PrimeSpectrum (↥R ⧸ Q₀_R.asIdeal))
       (E_Z_M : Set ↥M_tilde)
       (h_Z0 : Polynomial ↥R) (c_val0 : ↥R)
       (ι_full : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away h_Z0)) ⟶ M_tilde)
       (φ_Z0 : Localization.Away h_Z0 →+* F_0),
      f'_M ≫ g_M0 = g'_M →
      η_tilde ≫ q_M ≫ f'_M = η_M0 →
      π_Z ≠ 0 →
      c_Z ∈ IsLocalRing.maximalIdeal ↥R →
      π_Z ∈ IsLocalRing.maximalIdeal ↥R →
      (∀ a₀ : ↥R, a_opt = some a₀ → ¬ IsValDiscLE ↥R c_Z π_Z 0 a₀) →
      Q₀_R.asIdeal ≠ ⊥ →
      π_Z ∈ Q₀_R.asIdeal →
      σ_Mod ≫ g'_M =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk Q₀_R.asIdeal)) →
      Ideal.comap (Ideal.Quotient.mk Q₀_R.asIdeal) q_max.asIdeal =
        IsLocalRing.maximalIdeal ↥R →
      f'_M.base (σ_Mod.base q_max) = m_0 →
      IsClosed E_Z_M →
      IsIrreducible E_Z_M →
      E_Z_M ⊆ {y : ↥M_tilde | ((q_M ≫ g'_M).base y).asIdeal = IsLocalRing.maximalIdeal ↥R} →
      Polynomial.eval c_val0 h_Z0 ∉ IsLocalRing.maximalIdeal ↥R →
      AlgebraicGeometry.IsOpenImmersion ι_full →
      ι_full ≫ (q_M ≫ g'_M) = AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        ((algebraMap (Polynomial ↥R) (Localization.Away h_Z0)).comp Polynomial.C)) →
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_Z0) ≫ ι_full = η_tilde →
      φ_KF0 (R.subtype π_Z) *
          φ_Z0 (algebraMap (Polynomial ↥R) (Localization.Away h_Z0) Polynomial.X) =
        T_0 - φ_KF0 (R.subtype c_Z) →
      (∀ p : PrimeSpectrum (Localization.Away h_Z0),
        (((q_M ≫ g'_M).base (ι_full.base p)).asIdeal = IsLocalRing.maximalIdeal ↥R) →
        ι_full.base p ∈ E_Z_M) →
      (∀ (q : PrimeSpectrum (↥R ⧸ Q₀_R.asIdeal)) (p_Z : PrimeSpectrum (Localization.Away h_Z0)),
        Ideal.comap ((algebraMap (Polynomial ↥R) (Localization.Away h_Z0)).comp Polynomial.C)
            p_Z.asIdeal =
          Ideal.comap (Ideal.Quotient.mk Q₀_R.asIdeal) q.asIdeal →
        (ι_full ≫ q_M).base p_Z = σ_Mod.base q) →
      let s_R := AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.maximalIdeal ↥R).ResidueField))
      let fst_tilde := CategoryTheory.Limits.pullback.fst (q_M ≫ g'_M) s_R
      (∃ W_0 : ValuationSubring F_0,
        IsComponentStalkVal R (q_M ≫ g'_M) η_tilde (fst_tilde.base ⁻¹' E_Z_M) W_0 ∧
        IsDiscValuationOnWB R m_0 η_M0 φ_KF0 T_0 c_Z π_Z W_0) ∧
      (∀ y ∈ f'_M.base '' (Set.range σ_Mod.base),
        (g_M0.base y).asIdeal ≠ ⊥ ∧
        m_0 ∈ closure ({y} : Set ↥M_0) ∧
        π_Z ∈ (g_M0.base y).asIdeal ∧
        ∃ (W_0 : ValuationSubring F_0)
          (ψ_M0 : AlgebraicGeometry.Spec (CommRingCat.of ↥W_0) ⟶ M_0)
          (pW0 : AlgebraicGeometry.Spec (CommRingCat.of ↥W_0)),
          IsDiscValuationOnWB R m_0 η_M0 φ_KF0 T_0 c_Z π_Z W_0 ∧
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom W_0.subtype) ≫ ψ_M0 = η_M0 ∧
          ψ_M0.base pW0 = y)) :=
by
  refine ⟨?_, ?_, ?_⟩
  · intro h_p h_0 c_tilde π_tilde Q₀_R σ_loc ψ_0
      hπ_Q₀ hσ_g hσ_X hψ0_C hψ0_X q p_Z hpZ_comap
    let ι_p := algebraMap (Polynomial ↥R) (Localization.Away h_p)
    let ι_0 := algebraMap (Polynomial ↥R) (Localization.Away h_0)
    let Q_R : Ideal ↥R := Ideal.comap (Ideal.Quotient.mk Q₀_R.asIdeal) q.asIdeal
    apply PrimeSpectrum.localization_comap_injective (Localization.Away h_p) (Submonoid.powers h_p)
    apply PrimeSpectrum.ext
    let J₁ : Ideal (Polynomial ↥R) :=
      (PrimeSpectrum.comap ι_p (PrimeSpectrum.comap ψ_0 p_Z)).asIdeal
    let J₂ : Ideal (Polynomial ↥R) :=
      (PrimeSpectrum.comap ι_p (σ_loc.base q)).asIdeal
    change J₁ = J₂
    have hJ₁_C : ∀ r : ↥R, Polynomial.C r ∈ J₁ ↔ r ∈ Q_R := by
      intro r
      change ψ_0 (ι_p (Polynomial.C r)) ∈ p_Z.asIdeal ↔ r ∈ Q_R
      rw [hψ0_C r]
      change r ∈ Ideal.comap (ι_0.comp Polynomial.C) p_Z.asIdeal ↔ r ∈ Q_R
      rw [hpZ_comap]
    have hσ_comap :
        Ideal.comap (ι_p.comp Polynomial.C) (σ_loc.base q).asIdeal = Q_R := by
      have h1 := congrArg (fun φ => (φ.base q).asIdeal) hσ_g
      exact h1
    have hJ₂_C : ∀ r : ↥R, Polynomial.C r ∈ J₂ ↔ r ∈ Q_R := by
      intro r
      change r ∈ Ideal.comap (ι_p.comp Polynomial.C) (σ_loc.base q).asIdeal ↔ r ∈ Q_R
      rw [hσ_comap]
    have hπ_QR : π_tilde ∈ Q_R := by
      change Ideal.Quotient.mk Q₀_R.asIdeal π_tilde ∈ q.asIdeal
      rw [Ideal.Quotient.eq_zero_iff_mem.mpr hπ_Q₀]
      exact Ideal.zero_mem _
    have hJ₁_X : Polynomial.X - Polynomial.C c_tilde ∈ J₁ := by
      change ψ_0 (ι_p (Polynomial.X - Polynomial.C c_tilde)) ∈ p_Z.asIdeal
      rw [map_sub, map_sub, hψ0_X, hψ0_C c_tilde, map_add, map_mul, add_sub_cancel_left]
      have hπ_pZ : ι_0 (Polynomial.C π_tilde) ∈ p_Z.asIdeal := by
        have hmem : Polynomial.C π_tilde ∈ J₁ := (hJ₁_C π_tilde).mpr hπ_QR
        change ψ_0 (ι_p (Polynomial.C π_tilde)) ∈ p_Z.asIdeal at hmem
        rwa [hψ0_C π_tilde] at hmem
      exact Ideal.mul_mem_right _ p_Z.asIdeal hπ_pZ
    have hJ₂_X : Polynomial.X - Polynomial.C c_tilde ∈ J₂ := hσ_X q
    have poly_eval_mem : ∀ (J : Ideal (Polynomial ↥R)),
        Polynomial.X - Polynomial.C c_tilde ∈ J →
        ∀ P : Polynomial ↥R, P ∈ J ↔ Polynomial.C (Polynomial.eval c_tilde P) ∈ J := by
      intro J hX P
      let π₁ : Polynomial ↥R →+* (Polynomial ↥R ⧸ J) := Ideal.Quotient.mk J
      let π₂ : Polynomial ↥R →+* (Polynomial ↥R ⧸ J) :=
        π₁.comp (Polynomial.C.comp (Polynomial.evalRingHom c_tilde))
      have hπ : π₁ = π₂ := by
        apply Polynomial.ringHom_ext
        · intro a
          dsimp [π₁, π₂]
          rw [Polynomial.eval_C]
        · dsimp [π₁, π₂]
          rw [Polynomial.eval_X]
          exact Ideal.Quotient.eq.mpr hX
      rw [← Ideal.Quotient.eq_zero_iff_mem, ← Ideal.Quotient.eq_zero_iff_mem]
      have hP : π₁ P = π₂ P := DFunLike.congr_fun hπ P
      change π₁ P = 0 ↔ π₂ P = 0
      rw [hP]
    ext P
    rw [poly_eval_mem J₁ hJ₁_X P, hJ₁_C, poly_eval_mem J₂ hJ₂_X P, hJ₂_C]
  · intro π_tilde b' δ_e h_e h_Z Q₀_R σ_loc ψ_Z
      hπ_Q₀ hb'_Q₀ hUnit_Z hσ_g hσ_X hψZ_C hψZ_X0 hψZ_X1 q p_Z hpZ_comap
    let I_nod := weilNodalIdeal ↥R (b' * π_tilde)
    let mk := Ideal.Quotient.mk I_nod
    let ι_e := algebraMap (weilNodalQuot ↥R (b' * π_tilde)) (Localization.Away h_e)
    let ι_Z := algebraMap (Polynomial ↥R) (Localization.Away h_Z)
    let Q_R : Ideal ↥R := Ideal.comap (Ideal.Quotient.mk Q₀_R.asIdeal) q.asIdeal
    apply PrimeSpectrum.localization_comap_injective (Localization.Away h_e) (Submonoid.powers h_e)
    apply PrimeSpectrum.comap_injective_of_surjective mk Ideal.Quotient.mk_surjective
    apply PrimeSpectrum.ext
    let J₁ : Ideal (MvPolynomial (Fin 2) ↥R) :=
      Ideal.comap (ι_e.comp mk) (PrimeSpectrum.comap ψ_Z p_Z).asIdeal
    let J₂ : Ideal (MvPolynomial (Fin 2) ↥R) :=
      Ideal.comap (ι_e.comp mk) (σ_loc.base q).asIdeal
    change J₁ = J₂
    have hJ₁_C : ∀ r : ↥R, MvPolynomial.C r ∈ J₁ ↔ r ∈ Q_R := by
      intro r
      change ψ_Z (ι_e (mk (MvPolynomial.C r))) ∈ p_Z.asIdeal ↔ r ∈ Q_R
      rw [hψZ_C r]
      change r ∈ Ideal.comap (ι_Z.comp Polynomial.C) p_Z.asIdeal ↔ r ∈ Q_R
      rw [hpZ_comap]
    have hJ₂_C : ∀ r : ↥R, MvPolynomial.C r ∈ J₂ ↔ r ∈ Q_R := by
      intro r
      have hσ_g' := hσ_g
      rw [AlgebraicGeometry.Spec.map_comp] at hσ_g'
      have h1 := congrArg (fun φ => r ∈ (φ.base q).asIdeal) hσ_g'
      exact Iff.of_eq h1
    have hQ₀_le : Q₀_R.asIdeal ≤ Q_R := by
      intro r hr
      change Ideal.Quotient.mk Q₀_R.asIdeal r ∈ q.asIdeal
      rw [Ideal.Quotient.eq_zero_iff_mem.mpr hr]
      exact Ideal.zero_mem _
    have hπ_pZ : ι_Z (Polynomial.C π_tilde) ∈ p_Z.asIdeal := by
      have hmem : MvPolynomial.C π_tilde ∈ J₁ := (hJ₁_C π_tilde).mpr (hQ₀_le hπ_Q₀)
      change ψ_Z (ι_e (mk (MvPolynomial.C π_tilde))) ∈ p_Z.asIdeal at hmem
      rwa [hψZ_C π_tilde] at hmem
    have hb'_pZ : ι_Z (Polynomial.C b') ∈ p_Z.asIdeal := by
      have hmem : MvPolynomial.C b' ∈ J₁ := (hJ₁_C b').mpr (hQ₀_le hb'_Q₀)
      change ψ_Z (ι_e (mk (MvPolynomial.C b'))) ∈ p_Z.asIdeal at hmem
      rwa [hψZ_C b'] at hmem
    have hJ₁_X : ∀ b_idx : Fin 2, MvPolynomial.X b_idx ∈ J₁ := by
      intro b_idx
      fin_cases b_idx
      · change ψ_Z (ι_e (mk (MvPolynomial.X 0))) ∈ p_Z.asIdeal
        rw [hψZ_X0, map_mul]
        exact Ideal.mul_mem_right _ p_Z.asIdeal hπ_pZ
      · change ψ_Z (ι_e (mk (MvPolynomial.X 1))) ∈ p_Z.asIdeal
        have hprod : ι_Z (Polynomial.X - Polynomial.C δ_e) *
            ψ_Z (ι_e (mk (MvPolynomial.X 1))) ∈ p_Z.asIdeal := by
          rw [hψZ_X1]
          exact hb'_pZ
        rcases p_Z.isPrime.mem_or_mem hprod with hu | hx1
        · exfalso
          exact p_Z.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem p_Z.asIdeal hu hUnit_Z)
        · exact hx1
    have hJ₂_X : ∀ b_idx : Fin 2, MvPolynomial.X b_idx ∈ J₂ := fun b_idx => hσ_X q b_idx
    have mv_const_mem : ∀ (J : Ideal (MvPolynomial (Fin 2) ↥R)),
        (∀ b_idx : Fin 2, MvPolynomial.X b_idx ∈ J) →
        ∀ F : MvPolynomial (Fin 2) ↥R,
          F ∈ J ↔ MvPolynomial.C (MvPolynomial.constantCoeff F) ∈ J := by
      intro J hX F
      let π₁ : MvPolynomial (Fin 2) ↥R →+* (MvPolynomial (Fin 2) ↥R ⧸ J) :=
        Ideal.Quotient.mk J
      let π₂ : MvPolynomial (Fin 2) ↥R →+* (MvPolynomial (Fin 2) ↥R ⧸ J) :=
        π₁.comp (MvPolynomial.C.comp MvPolynomial.constantCoeff)
      have hπ : π₁ = π₂ := by
        apply MvPolynomial.ringHom_ext
        · intro a
          dsimp [π₁, π₂]
          rw [MvPolynomial.constantCoeff_C]
        · intro b_idx
          dsimp [π₁, π₂]
          rw [MvPolynomial.constantCoeff_X, map_zero, map_zero]
          exact Ideal.Quotient.eq_zero_iff_mem.mpr (hX b_idx)
      rw [← Ideal.Quotient.eq_zero_iff_mem, ← Ideal.Quotient.eq_zero_iff_mem]
      have hF : π₁ F = π₂ F := DFunLike.congr_fun hπ F
      change π₁ F = 0 ↔ π₂ F = 0
      rw [hF]
    ext F
    rw [mv_const_mem J₁ hJ₁_X F, hJ₁_C, mv_const_mem J₂ hJ₂_X F, hJ₂_C]
  · intro M' M_tilde g'_M f'_M q_M η_tilde c_Z π_Z Q₀_R σ_Mod q_max E_Z_M
      h_Z0 c_val0 ι_full φ_Z0
      hf'_g hη_f hπZ_ne hcZ_mR hπZ_mR hnot_a0 hQ₀_ne hπZ_Q₀
      hσMod_g' hqmax_mR hz_m0 hEZ_cl hEZ_irr hEZ_sub hhZ0_eval
      hOpen_full hιfull_g hφZ0_η hφZ0_X hιfull_EZ hιfull_q
    let s_R := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.maximalIdeal ↥R).ResidueField))
    let g_tilde := q_M ≫ g'_M
    let fst_tilde := CategoryTheory.Limits.pullback.fst g_tilde s_R
    let α_0 : ↥R →+* Localization.Away h_Z0 :=
      (algebraMap (Polynomial ↥R) (Localization.Away h_Z0)).comp Polynomial.C
    dsimp only
    obtain ⟨W_0, hR, hDisc, hLiftPrime, hLiftAway⟩ :=
      hGauss.2.2 c_Z π_Z hπZ_ne hcZ_mR hπZ_mR hnot_a0
    have hcoeff_not_mR : ∃ j : ℕ, h_Z0.coeff j ∉ IsLocalRing.maximalIdeal ↥R := by
      by_contra h_all
      apply hhZ0_eval
      rw [Polynomial.eval_eq_sum_range]
      exact Ideal.sum_mem _ fun j _ =>
        Ideal.mul_mem_right _ _ (Classical.not_not.mp fun hj => h_all ⟨j, hj⟩)
    have hφZ0_comp : φ_Z0.comp α_0 = φ_KF0.comp R.subtype := by
      have hcomm : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_Z0.comp α_0)) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_KF0.comp R.subtype)) := by
        rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp]
        dsimp only [α_0]
        rw [← hιfull_g, ← CategoryTheory.Category.assoc, hφZ0_η,
          ← hf'_g, ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
          CategoryTheory.Category.assoc η_tilde q_M f'_M, hη_f, hηM0_g]
      have hinj := AlgebraicGeometry.Spec.map_injective hcomm
      ext r
      exact ConcreteCategory.congr_hom hinj r
    obtain ⟨ρ_Z0, hρ_sub, hρ_mW⟩ :=
      hLiftAway h_Z0 φ_Z0 hcoeff_not_mR hφZ0_comp hφZ0_X
    refine ⟨?_, ?_⟩
    · refine ⟨W_0, ?_, hDisc⟩
      let ψ_tilde : AlgebraicGeometry.Spec (CommRingCat.of ↥W_0) ⟶ M_tilde :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_Z0) ≫ ι_full
      let mW : ↥(AlgebraicGeometry.Spec (CommRingCat.of ↥W_0)) :=
        ⟨IsLocalRing.maximalIdeal ↥W_0, (IsLocalRing.maximalIdeal.isMaximal ↥W_0).isPrime⟩
      have hψ_η : AlgebraicGeometry.Spec.map (CommRingCat.ofHom W_0.subtype) ≫ ψ_tilde =
          η_tilde := by
        dsimp only [ψ_tilde]
        rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp, hρ_sub, hφZ0_η]
      have hEZ_range : E_Z_M ⊆ Set.range fst_tilde.base := by
        intro y hy
        have hy_mR : (g_tilde.base y).asIdeal = IsLocalRing.maximalIdeal ↥R := hEZ_sub hy
        dsimp only [fst_tilde]
        rw [AlgebraicGeometry.Scheme.Pullback.range_fst]
        let pt₀ : PrimeSpectrum (IsLocalRing.maximalIdeal ↥R).ResidueField := ⊥
        refine ⟨pt₀, ?_⟩
        apply PrimeSpectrum.ext
        ext r
        change algebraMap ↥R (IsLocalRing.maximalIdeal ↥R).ResidueField r ∈
          (⊥ : Ideal (IsLocalRing.maximalIdeal ↥R).ResidueField) ↔ r ∈ (g_tilde.base y).asIdeal
        rw [hy_mR, Ideal.mem_bot, Ideal.algebraMap_residueField_eq_zero]
      have hfst_img : fst_tilde.base '' (fst_tilde.base ⁻¹' E_Z_M) = E_Z_M :=
        Set.image_preimage_eq_iff.mpr hEZ_range
      let p_gen : PrimeSpectrum (Localization.Away h_Z0) :=
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_Z0)).base mW
      have hp_gen_ideal : p_gen.asIdeal = Ideal.map α_0 (IsLocalRing.maximalIdeal ↥R) := by
        ext f
        exact hρ_mW f
      have hp_gen_comap : Ideal.comap α_0 p_gen.asIdeal = IsLocalRing.maximalIdeal ↥R := by
        apply le_antisymm
        · exact IsLocalRing.le_maximalIdeal (p_gen.isPrime.comap α_0).ne_top
        · rw [hp_gen_ideal]
          exact Ideal.le_comap_map
      have hp_gen_gtilde : (g_tilde.base (ι_full.base p_gen)).asIdeal =
          IsLocalRing.maximalIdeal ↥R := by
        have h1 : (ι_full ≫ g_tilde).base p_gen =
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_0)).base p_gen := by
          rw [hιfull_g]
        exact (congrArg PrimeSpectrum.asIdeal h1).trans hp_gen_comap
      have hmW_mem : ψ_tilde.base mW ∈ E_Z_M := hιfull_EZ p_gen hp_gen_gtilde
      have hcl_sub : closure ({ψ_tilde.base mW} : Set ↥M_tilde) ⊆ E_Z_M :=
        closure_minimal (Set.singleton_subset_iff.mpr hmW_mem) hEZ_cl
      have hinter_sub :
          E_Z_M ∩ Set.range ι_full.base ⊆ closure ({ψ_tilde.base mW} : Set ↥M_tilde) := by
        rintro y ⟨hy_EZ, p, rfl⟩
        have hp_gtilde : (g_tilde.base (ι_full.base p)).asIdeal =
            IsLocalRing.maximalIdeal ↥R := hEZ_sub hy_EZ
        have hp_comap : Ideal.comap α_0 p.asIdeal = IsLocalRing.maximalIdeal ↥R := by
          have h1 : (ι_full ≫ g_tilde).base p =
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_0)).base p := by
            rw [hιfull_g]
          exact (congrArg PrimeSpectrum.asIdeal h1).symm.trans hp_gtilde
        have hle : p_gen ≤ p := by
          change p_gen.asIdeal ≤ p.asIdeal
          rw [hp_gen_ideal, Ideal.map_le_iff_le_comap, hp_comap]
        have hp_cl : p ∈ closure ({p_gen} : Set (PrimeSpectrum (Localization.Away h_Z0))) :=
          (PrimeSpectrum.le_iff_mem_closure p_gen p).mp hle
        have hsub_cl :
            closure ({p_gen} : Set (PrimeSpectrum (Localization.Away h_Z0))) ⊆
              ι_full.base ⁻¹' closure ({ψ_tilde.base mW} : Set ↥M_tilde) :=
          closure_minimal
            (Set.singleton_subset_iff.mpr (subset_closure (Set.mem_singleton _)))
            (isClosed_closure.preimage ι_full.continuous)
        exact hsub_cl hp_cl
      have hEZ_sub_cl : E_Z_M ⊆ closure ({ψ_tilde.base mW} : Set ↥M_tilde) := by
        intro z hz_EZ
        by_contra hz_not
        have hOpen1 : IsOpen (Set.range ι_full.base) := ι_full.isOpenEmbedding.isOpen_range
        have hOpen2 : IsOpen ((closure ({ψ_tilde.base mW} : Set ↥M_tilde))ᶜ) :=
          isClosed_closure.isOpen_compl
        obtain ⟨w, hw_EZ, hw_rng, hw_not⟩ := hEZ_irr.isPreirreducible
          (Set.range ι_full.base) ((closure ({ψ_tilde.base mW} : Set ↥M_tilde))ᶜ)
          hOpen1 hOpen2 ⟨ψ_tilde.base mW, hmW_mem, p_gen, rfl⟩ ⟨z, hz_EZ, hz_not⟩
        exact hw_not (hinter_sub ⟨hw_EZ, hw_rng⟩)
      refine ⟨ψ_tilde, mW, rfl, hψ_η, ?_⟩
      change fst_tilde.base '' (fst_tilde.base ⁻¹' E_Z_M) =
        closure ({ψ_tilde.base mW} : Set ↥M_tilde)
      rw [hfst_img]
      exact Set.Subset.antisymm hEZ_sub_cl hcl_sub
    · rintro y ⟨_, ⟨q, rfl⟩, rfl⟩
      let Q_R : PrimeSpectrum ↥R :=
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk Q₀_R.asIdeal))).base q
      have hg_y : g_M0.base (f'_M.base (σ_Mod.base q)) = Q_R := by
        change (σ_Mod ≫ f'_M ≫ g_M0).base q = Q_R
        rw [hf'_g, hσMod_g']
      have hQ₀_le : Q₀_R.asIdeal ≤ Q_R.asIdeal := by
        intro r hr
        change Ideal.Quotient.mk Q₀_R.asIdeal r ∈ q.asIdeal
        rw [Ideal.Quotient.eq_zero_iff_mem.mpr hr]
        exact Ideal.zero_mem _
      have hy_ne_bot : (g_M0.base (f'_M.base (σ_Mod.base q))).asIdeal ≠ ⊥ := by
        rw [hg_y]
        intro hbot
        apply hQ₀_ne
        exact le_bot_iff.mp (hbot ▸ hQ₀_le)
      have hπ_mem : π_Z ∈ (g_M0.base (f'_M.base (σ_Mod.base q))).asIdeal := by
        rw [hg_y]
        exact hQ₀_le hπZ_Q₀
      have hm0_cl : m_0 ∈ closure ({f'_M.base (σ_Mod.base q)} : Set ↥M_0) := by
        let q' : PrimeSpectrum (↥R ⧸ Q₀_R.asIdeal) := q
        have hQR_le : Q_R.asIdeal ≤
            Ideal.comap (Ideal.Quotient.mk Q₀_R.asIdeal) q_max.asIdeal := by
          rw [hqmax_mR]
          exact IsLocalRing.le_maximalIdeal Q_R.isPrime.ne_top
        have hq_le : q' ≤ q_max := by
          intro x hx
          obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective x
          exact hQR_le hx
        have hqmax_cl : q_max ∈ closure ({q'} : Set (PrimeSpectrum (↥R ⧸ Q₀_R.asIdeal))) :=
          (PrimeSpectrum.le_iff_mem_closure q' q_max).mp hq_le
        have hsub_cl :
            closure ({q'} : Set (PrimeSpectrum (↥R ⧸ Q₀_R.asIdeal))) ⊆
              (σ_Mod ≫ f'_M).base ⁻¹' closure ({f'_M.base (σ_Mod.base q)} : Set ↥M_0) :=
          closure_minimal
            (Set.singleton_subset_iff.mpr (subset_closure (Set.mem_singleton _)))
            (isClosed_closure.preimage (σ_Mod ≫ f'_M).continuous)
        have himg : (σ_Mod ≫ f'_M).base q_max ∈
            closure ({f'_M.base (σ_Mod.base q)} : Set ↥M_0) :=
          hsub_cl hqmax_cl
        change f'_M.base (σ_Mod.base q_max) ∈
          closure ({f'_M.base (σ_Mod.base q)} : Set ↥M_0) at himg
        rwa [hz_m0] at himg
      let ψ_M0 : AlgebraicGeometry.Spec (CommRingCat.of ↥W_0) ⟶ M_0 :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_Z0) ≫ ι_full ≫ q_M ≫ f'_M
      have hψM0_η : AlgebraicGeometry.Spec.map (CommRingCat.ofHom W_0.subtype) ≫ ψ_M0 =
          η_M0 := by
        dsimp only [ψ_M0]
        rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp, hρ_sub,
          ← CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_Z0)),
          hφZ0_η, hη_f]
      obtain ⟨pW0, hpW0⟩ := hLiftPrime Q_R
      let p_Z : PrimeSpectrum (Localization.Away h_Z0) :=
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_Z0)).base pW0
      have hpZ_comap : Ideal.comap α_0 p_Z.asIdeal =
          Ideal.comap (Ideal.Quotient.mk Q₀_R.asIdeal) q.asIdeal := by
        ext r
        have hρ_r : ρ_Z0 (α_0 r) = (⟨φ_KF0 (R.subtype r), hR r⟩ : ↥W_0) := by
          apply Subtype.ext
          change (W_0.subtype.comp ρ_Z0) (α_0 r) = (φ_KF0.comp R.subtype) r
          rw [hρ_sub]
          exact DFunLike.congr_fun hφZ0_comp r
        change ρ_Z0 (α_0 r) ∈ pW0.asIdeal ↔ r ∈ Q_R.asIdeal
        rw [hρ_r]
        exact hpW0 r
      have hψM0_pt : ψ_M0.base pW0 = f'_M.base (σ_Mod.base q) := by
        change f'_M.base ((ι_full ≫ q_M).base p_Z) = f'_M.base (σ_Mod.base q)
        rw [hιfull_q q p_Z hpZ_comap]
      exact ⟨hy_ne_bot, hm0_cl, hπ_mem, W_0, ψ_M0, pW0, hDisc, hψM0_η, hψM0_pt⟩

theorem weil_charted_model_closed_fiber_assembly_of_raw_charts (K : Type u) [Field K]
    (m : ℕ) (R : ValuationSubring K) (hPkg_R : IsValuationRingAlgPackage m R)
    (hMax_R : IsLocalRing.maximalIdeal ↥R ≠ ⊥)
    (a_opt : Option ↥R)
    (M_0 : AlgebraicGeometry.Scheme.{u})
    (g_M0 : M_0 ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
    (m_0 : ↥M_0)
    (F_0 : Type u) [Field F_0]
    (η_M0 : AlgebraicGeometry.Spec (CommRingCat.of F_0) ⟶ M_0)
    (φ_KF0 : K →+* F_0) (T_0 : F_0)
    (N' : ℕ) (c π : Fin (N' + 1) → ↥R)
    (hTree : IsJoinClosedDiscTree ↥R a_opt c π)
    (i_Z : Fin (N' + 1))
    (hiZ_nb : ¬ IsDiscBoundaryIdx ↥R a_opt (c i_Z) (π i_Z))
    (M' M_tilde : AlgebraicGeometry.Scheme.{u})
    (g'_M : M' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
    (f'_M : M' ⟶ M_0)
    (η'_M : AlgebraicGeometry.Spec (CommRingCat.of F_0) ⟶ M')
    (Z_M' : Set ↥M_0)
    (B'_comp : Fin N' → Set ↥(CategoryTheory.Limits.pullback g'_M
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥R (IsLocalRing.maximalIdeal ↥R).ResidueField)))))
    (hModel' : IsChartedBaseDiscTreeModel R a_opt g_M0 m_0 η_M0 φ_KF0 T_0
      (c ∘ i_Z.succAbove) (π ∘ i_Z.succAbove) M' g'_M f'_M η'_M Z_M' B'_comp)
    (g_tilde : M_tilde ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
    (q_M : M_tilde ⟶ M')
    (η_tilde : AlgebraicGeometry.Spec (CommRingCat.of F_0) ⟶ M_tilde)
    (Z_tilde : Set ↥M_0)
    (Mod_qM : Set ↥M') (hMod_cl : IsClosed Mod_qM)
    (z_new_M : ↥M')
    (E_Z_M : Set ↥M_tilde)
    (j_2 : AlgebraicGeometry.Scheme.Opens.toScheme
      (⟨Mod_qMᶜ, hMod_cl.isOpen_compl⟩ : M'.Opens) ⟶ M_tilde) :
    let s_R := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.maximalIdeal ↥R).ResidueField))
    let fst'_R := CategoryTheory.Limits.pullback.fst g'_M s_R
    let fst_tilde := CategoryTheory.Limits.pullback.fst g_tilde s_R
    let B_set : Fin (N' + 1) → Set ↥M_tilde :=
      Fin.insertNth i_Z E_Z_M
        (fun i' => closure (q_M.base ⁻¹' ((fst'_R.base '' (B'_comp i')) \ {z_new_M})))
    let B_tilde : Fin (N' + 1) → Set ↥(CategoryTheory.Limits.pullback g_tilde s_R) :=
      fun i => fst_tilde.base ⁻¹' (B_set i)
    IsStrictlySemistableCurveOverValuation R g_tilde →
    AlgebraicGeometry.IsProper (q_M ≫ f'_M) →
    (q_M ≫ f'_M) ≫ g_M0 = g_tilde →
    q_M ≫ g'_M = g_tilde →
    η_tilde ≫ q_M = η'_M →
    (∃ hZ_cl : IsClosed Z_tilde,
      CategoryTheory.IsIso ((q_M ≫ f'_M) ∣_ (⟨Z_tildeᶜ, hZ_cl.isOpen_compl⟩ : M_0.Opens)) ∧
      ∀ y ∈ Z_tilde, (g_M0.base y).asIdeal ≠ ⊥ ∧ m_0 ∈ closure ({y} : Set ↥M_0) ∧
        ∃ i : Fin (N' + 1), ¬ IsDiscBoundaryIdx ↥R a_opt (c i) (π i) ∧
          π i ∈ (g_M0.base y).asIdeal ∧
          ∃ (W_0 : ValuationSubring F_0)
            (ψ_M0 : AlgebraicGeometry.Spec (CommRingCat.of ↥W_0) ⟶ M_0)
            (pW0 : AlgebraicGeometry.Spec (CommRingCat.of ↥W_0)),
            IsDiscValuationOnWB R m_0 η_M0 φ_KF0 T_0 (c i) (π i) W_0 ∧
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom W_0.subtype) ≫ ψ_M0 = η_M0 ∧
            ψ_M0.base pW0 = y) →
    AlgebraicGeometry.IsOpenImmersion j_2 →
    j_2 ≫ q_M = AlgebraicGeometry.Scheme.Opens.ι (⟨Mod_qMᶜ, hMod_cl.isOpen_compl⟩ : M'.Opens) →
    q_M.base ⁻¹' Mod_qMᶜ = Set.range j_2.base →
    Mod_qM ∩ {x : ↥M' | (g'_M.base x).asIdeal = IsLocalRing.maximalIdeal ↥R} = {z_new_M} →
    IsClosed ({z_new_M} : Set ↥M') →
    f'_M.base z_new_M = m_0 →
    q_M.base ⁻¹' {z_new_M} = E_Z_M →
    IsClosed E_Z_M →
    IsIrreducible E_Z_M →
