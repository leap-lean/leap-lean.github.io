            fun t hpt htk => hInt t (leIdx_trans hvp_hasse.2.1 hpt) htk
          have hv_not : ¬ inD0 v := hInt v (leIdx_refl v) hv_le
          have hp_not : ¬ inD0 p := hInt_p p (leIdx_refl p) hp_le
          exact (hx_of_step hv_not hp_not hvp_hasse).trans
            (ih (upCard p) hp_lt p rfl hp_le hInt_p)
    let x_star : ↥Y_X0 := x_of k_root hk_root_not
    have hx_star_cl : IsClosed ({x_star} : Set ↥Y_X0) := hx_of_cl k_root hk_root_not
    have hx_v1 : x_of v₁ hv₁_not = x_star := hx_climb (upCard v₁) v₁ rfl hv₁_k hInt₁
    have hx_v2 : x_of v₂ hv₂_not = x_star := hx_climb (upCard v₂) v₂ rfl hv₂_k hInt₂
    
    have hw₁_ne_w₂ : w₁ ≠ w₂ := by
      intro heq
