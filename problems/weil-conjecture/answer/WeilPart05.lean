  have isFractionRing_of_bijective : ∀ {B₁ B₂ L : Type u} [CommRing B₁] [CommRing B₂] [Field L]
      [IsDomain B₂] (f : B₁ →+* B₂) (hf : Function.Bijective f) (φ : B₂ →+* L),
      @IsFractionRing B₂ _ L _ φ.toAlgebra →
      @IsFractionRing B₁ _ L _ (φ.comp f).toAlgebra := by
    intro B₁ B₂ L _ _ _ _ f hf φ hFrac2
    letI : Algebra B₂ L := φ.toAlgebra
    haveI : IsFractionRing B₂ L := hFrac2
    have hInj_φ : Function.Injective φ := IsFractionRing.injective B₂ L
    haveI : IsDomain B₁ := Function.Injective.isDomain f hf.1
    letI : Algebra B₁ L := (φ.comp f).toAlgebra
    refine { map_units := ?_, surj := ?_, exists_of_eq := ?_ }
    · intro y
      have hy0 : (y : B₁) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp y.2
      have hfy : φ (f y) ≠ 0 := fun h =>
        hy0 (hf.1 (hInj_φ (h.trans (map_zero φ).symm) |>.trans (map_zero f).symm))
      exact IsUnit.mk0 (φ (f y)) hfy
    · intro z
      obtain ⟨⟨a, s⟩, hz⟩ := IsLocalization.surj (nonZeroDivisors B₂) z
      obtain ⟨r_a, rfl⟩ := hf.2 a
      obtain ⟨r_s, hrs⟩ := hf.2 s.1
      have hs0 : (s : B₂) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s.2
      have hrs_ne : r_s ≠ 0 := fun h0 => hs0 (hrs.symm.trans (h0 ▸ map_zero f))
      refine ⟨⟨r_a, ⟨r_s, mem_nonZeroDivisors_iff_ne_zero.mpr hrs_ne⟩⟩, ?_⟩
      change z * φ (f r_s) = φ (f r_a)
      rw [hrs]
      exact hz
    · intro x y hxy
      exact ⟨1, by simp [hf.1 (hInj_φ hxy)]⟩

  
  have isSchemeFunctionField_of_single : ∀ (Y : AlgebraicGeometry.Scheme.{u})
      (_ : AlgebraicGeometry.IsIntegral Y) (L : Type u) [Field L]
      (η : AlgebraicGeometry.Spec (CommRingCat.of L) ⟶ Y)
      (V_0 : Y.Opens) (hV0 : AlgebraicGeometry.IsAffineOpen V_0) (hV0_ne : Nonempty ↥V_0)
      (φ_0 : Y.presheaf.obj (Opposite.op V_0) ⟶ CommRingCat.of L),
      @IsFractionRing ↑(Y.presheaf.obj (Opposite.op V_0)) _ L _ φ_0.hom.toAlgebra →
      AlgebraicGeometry.Spec.map φ_0 ≫ hV0.fromSpec = η →
      IsSchemeFunctionField Y L η := by
    intro Y hIntY L _ η V_0 hV0 hV0_ne φ_0 hFrac0 hη0
    haveI : AlgebraicGeometry.IsIntegral Y := hIntY
    let R_0 : Type u := ↑(Y.presheaf.obj (Opposite.op V_0))
    let K_Y : Type u := ↑Y.functionField
    have hθ_ex : ∃ (θ_equiv : K_Y ≃+* L),
        (letI : Nonempty V_0 := hV0_ne
         Y.germToFunctionField V_0 ≫ CommRingCat.ofHom θ_equiv.toRingHom = φ_0) := by
      letI : Nonempty V_0 := hV0_ne
      letI : Algebra R_0 L := φ_0.hom.toAlgebra
      haveI : IsFractionRing R_0 L := hFrac0
      haveI : IsFractionRing R_0 K_Y :=
        AlgebraicGeometry.functionField_isFractionRing_of_isAffineOpen Y V_0 hV0
      let θ_alg : K_Y ≃ₐ[R_0] L := IsLocalization.algEquiv (nonZeroDivisors R_0) K_Y L
      exact ⟨θ_alg.toRingEquiv, CommRingCat.hom_ext (RingHom.ext fun r => θ_alg.commutes r)⟩
    obtain ⟨θ_equiv, hθ_V0⟩ := hθ_ex
    let θ : Y.functionField ⟶ CommRingCat.of L := CommRingCat.ofHom θ_equiv.toRingHom
    have hmem_V0 : genericPoint ↥Y ∈ V_0 := by
      obtain ⟨v⟩ := hV0_ne
      exact ((genericPoint_spec ↥Y).mem_open_set_iff V_0.isOpen).mpr ⟨v.1, trivial, v.2⟩
    intro U hU hU_ne
    letI : Nonempty U := hU_ne
    let R_U : Type u := ↑(Y.presheaf.obj (Opposite.op U))
    let φ_U : Y.presheaf.obj (Opposite.op U) ⟶ CommRingCat.of L := Y.germToFunctionField U ≫ θ
    refine ⟨φ_U, ?_, ?_⟩
    · letI : Algebra R_U L := φ_U.hom.toAlgebra
      haveI : IsFractionRing R_U K_Y :=
        AlgebraicGeometry.functionField_isFractionRing_of_isAffineOpen Y U hU
      let θ_U : K_Y ≃ₐ[R_U] L := AlgEquiv.ofRingEquiv (f := θ_equiv) (fun _ => rfl)
      exact IsLocalization.isLocalization_of_algEquiv (nonZeroDivisors R_U) θ_U
    · have hmem_U : genericPoint ↥Y ∈ U := by
        obtain ⟨u⟩ := hU_ne
        exact ((genericPoint_spec ↥Y).mem_open_set_iff U.isOpen).mpr ⟨u.1, trivial, u.2⟩
      have h_stalk_U : AlgebraicGeometry.Spec.map (Y.germToFunctionField U) ≫ hU.fromSpec =
          Y.fromSpecStalk (genericPoint ↥Y) :=
        hU.fromSpecStalk_eq_fromSpecStalk hmem_U
      have h_stalk_V0 : (letI : Nonempty V_0 := hV0_ne
          AlgebraicGeometry.Spec.map (Y.germToFunctionField V_0) ≫ hV0.fromSpec) =
          Y.fromSpecStalk (genericPoint ↥Y) := by
        letI : Nonempty V_0 := hV0_ne
        exact hV0.fromSpecStalk_eq_fromSpecStalk hmem_V0
      calc AlgebraicGeometry.Spec.map φ_U ≫ hU.fromSpec
          = AlgebraicGeometry.Spec.map θ ≫
              (AlgebraicGeometry.Spec.map (Y.germToFunctionField U) ≫ hU.fromSpec) := by
            rw [AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc]
        _ = AlgebraicGeometry.Spec.map θ ≫ Y.fromSpecStalk (genericPoint ↥Y) := by
            rw [h_stalk_U]
        _ = (letI : Nonempty V_0 := hV0_ne
            AlgebraicGeometry.Spec.map θ ≫
              (AlgebraicGeometry.Spec.map (Y.germToFunctionField V_0) ≫ hV0.fromSpec)) := by
            rw [h_stalk_V0]
        _ = (letI : Nonempty V_0 := hV0_ne
            AlgebraicGeometry.Spec.map (Y.germToFunctionField V_0 ≫ θ) ≫ hV0.fromSpec) := by
            letI : Nonempty V_0 := hV0_ne
            rw [AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc]
        _ = η := by
            letI : Nonempty V_0 := hV0_ne
            rw [hθ_V0, hη0]

  
