            (ι_U : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away h)) ⟶ M_tilde)
            (φ_U : Localization.Away h →+* F_0),
            Polynomial.eval c_tilde h ∉ IsLocalRing.maximalIdeal ↥R ∧
