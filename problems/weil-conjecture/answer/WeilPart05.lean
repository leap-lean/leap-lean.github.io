        rw [AlgebraicGeometry.Spec.preimage_comp, AlgebraicGeometry.Spec.preimage_comp,
          AlgebraicGeometry.Spec.preimage_map] at h_pre
        exact congrArg (fun u : CommRingCat.of A_0 ⟶ CommRingCat.of F_0 => u.hom a) h_pre
      have hψ_g : ψ₁ ≫ g_M1 = ψ₂ ≫ g_M1 := by
        rw [← hfM1_g, ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc, hψ_f]
      have : AlgebraicGeometry.IsSeparated g_M1 := hSep_M1
      have hψ_eq : ψ₁ = ψ₂ :=
        AlgebraicGeometry.ext_of_isDominant_of_isSeparated g_M1 hψ_g ι_W (hη₁.trans hη₂.symm)
      rw [← hψ₁_z, ← hψ₂_z, hψ_eq]
  have aff_and_spec_helpers : ∀ (A_0 : Type u) [CommRing A_0] [IsDomain A_0]
      (iso : M_0 ≅ AlgebraicGeometry.Spec (CommRingCat.of A_0))
      (φ_top : CommRingCat.of A_0 ⟶ CommRingCat.of F_0)
      (C_map : ↥R →+* A_0),
      iso.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom C_map) = g_M0 →
      AlgebraicGeometry.Spec.map φ_top ≫ iso.inv = η_M0 →
      Function.Injective φ_top.hom ∧
      (∀ x : F_0, ∃ f g : A_0, g ≠ 0 ∧ φ_top.hom g * x = φ_top.hom f) ∧
      (∀ w₁ w₂ : ↥M_0,
        (w₂ ∈ closure ({w₁} : Set ↥M_0) ↔ (iso.hom.base w₁).asIdeal ≤ (iso.hom.base w₂).asIdeal) ∧
        (w₁ = w₂ ↔ iso.hom.base w₁ = iso.hom.base w₂)) ∧
      (∀ w : ↥M_0, g_M0.base w = PrimeSpectrum.comap C_map (iso.hom.base w)) := by
    intro A_0 _ _ iso φ_top C_map hiso_g hφ_η
    have : AlgebraicGeometry.IsAffine M_0 := AlgebraicGeometry.isAffine_of_isAffineHom iso.hom
    have hTop : AlgebraicGeometry.IsAffineOpen (⊤ : M_0.Opens) := AlgebraicGeometry.isAffineOpen_top M_0
    obtain ⟨φ_Γ, hFrac_Γ, hφΓ_eq⟩ := hStd.1 ⊤ hTop ⟨⟨m_0, trivial⟩⟩
    let e_Spec : AlgebraicGeometry.Spec (M_0.presheaf.obj (Opposite.op ⊤)) ≅
        AlgebraicGeometry.Spec (CommRingCat.of A_0) :=
      M_0.isoSpec.symm ≪≫ iso
    have he_hom : e_Spec.hom = hTop.fromSpec ≫ iso.hom := by
      change M_0.isoSpec.inv ≫ iso.hom = hTop.fromSpec ≫ iso.hom
      rw [AlgebraicGeometry.IsAffineOpen.fromSpec_top]
    let θ : CommRingCat.of A_0 ⟶ M_0.presheaf.obj (Opposite.op ⊤) :=
      AlgebraicGeometry.Spec.preimage e_Spec.hom
    let θ_inv : M_0.presheaf.obj (Opposite.op ⊤) ⟶ CommRingCat.of A_0 :=
      AlgebraicGeometry.Spec.preimage e_Spec.inv
    have hθ_left : θ_inv ≫ θ = 𝟙 _ := by
      rw [← AlgebraicGeometry.Spec.preimage_comp, e_Spec.hom_inv_id,
        AlgebraicGeometry.Spec.preimage_id]
    have hθ_right : θ ≫ θ_inv = 𝟙 _ := by
      rw [← AlgebraicGeometry.Spec.preimage_comp, e_Spec.inv_hom_id,
        AlgebraicGeometry.Spec.preimage_id]
    have hθ_φ : θ ≫ φ_Γ = φ_top := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage, he_hom]
      calc AlgebraicGeometry.Spec.map φ_Γ ≫ hTop.fromSpec ≫ iso.hom
        _ = (AlgebraicGeometry.Spec.map φ_Γ ≫ hTop.fromSpec) ≫ iso.hom := by
            simp only [CategoryTheory.Category.assoc]
        _ = η_M0 ≫ iso.hom := by rw [hφΓ_eq]
        _ = (AlgebraicGeometry.Spec.map φ_top ≫ iso.inv) ≫ iso.hom := by rw [← hφ_η]
        _ = AlgebraicGeometry.Spec.map φ_top := by
            rw [CategoryTheory.Category.assoc, iso.inv_hom_id, CategoryTheory.Category.comp_id]
    have hφΓ_inj : Function.Injective φ_Γ.hom :=
      @IsFractionRing.injective (↑(M_0.presheaf.obj (Opposite.op ⊤))) _ F_0 _
        φ_Γ.hom.toAlgebra hFrac_Γ
    have hθ_inj : Function.Injective θ.hom := by
      intro a₁ a₂ ha
      have h1 := congrArg θ_inv.hom ha
      change (θ ≫ θ_inv).hom a₁ = (θ ≫ θ_inv).hom a₂ at h1
      rwa [hθ_right] at h1
    have hφ_inj : Function.Injective φ_top.hom := by
      rw [← hθ_φ]
      exact hφΓ_inj.comp hθ_inj
    have hFrac : ∀ x : F_0, ∃ f g : A_0, g ≠ 0 ∧ φ_top.hom g * x = φ_top.hom f := by
      intro x
      obtain ⟨a, b, hb_mem, hdiv⟩ :=
        @IsFractionRing.div_surjective (↑(M_0.presheaf.obj (Opposite.op ⊤))) _ F_0 _
          φ_Γ.hom.toAlgebra hFrac_Γ x
      let f : A_0 := θ_inv.hom a
      let g : A_0 := θ_inv.hom b
      have hθf : θ.hom f = a := by
        change (θ_inv ≫ θ).hom a = a
        rw [hθ_left]; rfl
      have hθg : θ.hom g = b := by
        change (θ_inv ≫ θ).hom b = b
        rw [hθ_left]; rfl
      have : Nontrivial ↑(M_0.presheaf.obj (Opposite.op ⊤)) := hθ_inj.nontrivial
      have : NoZeroDivisors ↑(M_0.presheaf.obj (Opposite.op ⊤)) :=
        ⟨fun {u v} huv => by
          have h := congrArg φ_Γ.hom huv
          rw [map_mul, map_zero] at h
          rcases mul_eq_zero.mp h with hu | hv
          · exact Or.inl (hφΓ_inj (hu.trans (map_zero _).symm))
          · exact Or.inr (hφΓ_inj (hv.trans (map_zero _).symm))⟩
      have hb_ne : b ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hb_mem
      have hg_ne : g ≠ 0 := fun h0 => hb_ne (by rw [← hθg, h0, map_zero])
      have hφb_ne : φ_Γ.hom b ≠ 0 := fun h0 => hb_ne (hφΓ_inj (h0.trans (map_zero _).symm))
      refine ⟨f, g, hg_ne, ?_⟩
      have hdiv' : φ_Γ.hom a / φ_Γ.hom b = x := hdiv
      have hφg : φ_top.hom g = φ_Γ.hom b := by rw [← hθ_φ]; exact congrArg φ_Γ.hom hθg
      have hφf : φ_top.hom f = φ_Γ.hom a := by rw [← hθ_φ]; exact congrArg φ_Γ.hom hθf
      rw [hφg, hφf, ← hdiv', mul_div_cancel₀ _ hφb_ne]
    let hHomeo : ↥M_0 ≃ₜ ↥(AlgebraicGeometry.Spec (CommRingCat.of A_0)) :=
      TopCat.homeoOfIso (AlgebraicGeometry.Scheme.forgetToTop.mapIso iso)
    have hHomeo_apply : ∀ w : ↥M_0, hHomeo w = iso.hom.base w := fun _ => rfl
    refine ⟨hφ_inj, hFrac, fun w₁ w₂ => ⟨?_, ?_⟩, fun w => ?_⟩
    · constructor
      · intro hw
        have himg : hHomeo w₂ ∈ hHomeo '' closure ({w₁} : Set ↥M_0) := ⟨w₂, hw, rfl⟩
        rw [Homeomorph.image_closure, Set.image_singleton, hHomeo_apply, hHomeo_apply] at himg
        let p₁ : PrimeSpectrum A_0 := iso.hom.base w₁
        let p₂ : PrimeSpectrum A_0 := iso.hom.base w₂
        exact (PrimeSpectrum.le_iff_mem_closure p₁ p₂).mpr himg
      · intro hle
        let p₁ : PrimeSpectrum A_0 := iso.hom.base w₁
        let p₂ : PrimeSpectrum A_0 := iso.hom.base w₂
        have himg : hHomeo w₂ ∈ closure ({hHomeo w₁} :
            Set ↥(AlgebraicGeometry.Spec (CommRingCat.of A_0))) :=
          (PrimeSpectrum.le_iff_mem_closure p₁ p₂).mp hle
        rw [← Set.image_singleton, ← Homeomorph.image_closure] at himg
        obtain ⟨u, hu_cl, hu_eq⟩ := himg
        exact hHomeo.injective hu_eq ▸ hu_cl
    · exact ⟨fun h => h ▸ rfl, fun h => hHomeo.injective h⟩
    · rw [← hiso_g]
      rfl
  rcases hStd.2.2 with ⟨_, iso, φ_top, hiso_g, _, _, hφ_η, _⟩ |
      ⟨a₀, iso, φ_top, _, ha₀_ne, _, hiso_g, _, _, hφ_η, _⟩
  · obtain ⟨hφ_inj, hFrac, hSpec_cl, hSpec_g⟩ :=
      aff_and_spec_helpers (Polynomial ↥R) iso φ_top Polynomial.C hiso_g hφ_η
    constructor
    · intro y hClosed_y
      let Q_R : PrimeSpectrum ↥R := g_M0.base y
      let q_y : PrimeSpectrum (Polynomial ↥R) := iso.hom.base y
      have hqy_over : PrimeSpectrum.comap Polynomial.C q_y = Q_R := (hSpec_g y).symm
      have hClosed_q : ∀ q_z : PrimeSpectrum (Polynomial ↥R),
          q_y.asIdeal ≤ q_z.asIdeal → PrimeSpectrum.comap Polynomial.C q_z = Q_R → q_z = q_y := by
        intro q_z hle hqz_over
        let z : ↥M_0 := iso.inv.base q_z
        have hiso_z : iso.hom.base z = q_z := by
          change (iso.inv ≫ iso.hom).base q_z = q_z
          rw [iso.inv_hom_id]; rfl
        have hz_cl : z ∈ closure ({y} : Set ↥M_0) :=
          (hSpec_cl y z).1.mpr (by rw [hiso_z]; exact hle)
        have hz_g : g_M0.base z = g_M0.base y := by
          rw [hSpec_g z, hiso_z, hqz_over]
        have hzy : z = y := hClosed_y z hz_cl hz_g
        rw [← hiso_z, hzy]
      obtain ⟨q_0, hq0_le, hq0_over, hq0_ne⟩ := (poly_dichot Q_R q_y hqy_over).1 hClosed_q
      let z₀ : ↥M_0 := iso.inv.base q_0
      have hiso_z0 : iso.hom.base z₀ = q_0 := by
        change (iso.inv ≫ iso.hom).base q_0 = q_0
        rw [iso.inv_hom_id]; rfl
      refine ⟨z₀, (hSpec_cl z₀ y).1.mpr (by rw [hiso_z0]; exact hq0_le), ?_, ?_⟩
      · rw [hSpec_g z₀, hiso_z0, hq0_over]
      · intro heq
        apply hq0_ne
        rw [← hiso_z0, heq]
    · intro y hy_or
      apply birat_sub (Polynomial ↥R) iso φ_top hφ_inj hφ_η y
      rcases hy_or with hy_notZ | ⟨z, hz_cl, hz_g, hz_ne⟩
      · exact Or.inl hy_notZ
      · refine Or.inr ?_
        let Q_R : PrimeSpectrum ↥R := g_M0.base y
        let q_y : PrimeSpectrum (Polynomial ↥R) := iso.hom.base y
        let q_z : PrimeSpectrum (Polynomial ↥R) := iso.hom.base z
        have hqy_over : PrimeSpectrum.comap Polynomial.C q_y = Q_R := (hSpec_g y).symm
        have hqz_over : PrimeSpectrum.comap Polynomial.C q_z = Q_R := by
          rw [← hSpec_g z, hz_g]
        have hqy_le_qz : q_y.asIdeal ≤ q_z.asIdeal := (hSpec_cl y z).1.mp hz_cl
        have hqz_ne : q_z ≠ q_y := mt (hSpec_cl z y).2.mpr hz_ne
        have hGauss := (poly_dichot Q_R q_y hqy_over).2 ⟨q_z, hqy_le_qz, hqz_over, hqz_ne⟩
        exact gauss_val Q_R (Polynomial ↥R) φ_top.hom q_y (RingHom.id (Polynomial ↥R))
          hφ_inj Function.injective_id hFrac hGauss
  · let I_nod : Ideal (MvPolynomial (Fin 2) ↥R) :=
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a₀}
    let A_nod := MvPolynomial (Fin 2) ↥R ⧸ I_nod
    let c_nod : ↥R →+* A_nod := (Ideal.Quotient.mk I_nod).comp MvPolynomial.C
    obtain ⟨hDom_A, hBr, hNod_cl, hNod_noncl⟩ := nodal_pkg a₀ ha₀_ne
    have : IsDomain A_nod := hDom_A
    obtain ⟨hφ_inj, hFrac, hSpec_cl, hSpec_g⟩ :=
      aff_and_spec_helpers A_nod iso φ_top c_nod hiso_g hφ_η
    constructor
    · intro y hClosed_y
      let Q_R : PrimeSpectrum ↥R := g_M0.base y
      let q_y : PrimeSpectrum A_nod := iso.hom.base y
      have hqy_over : PrimeSpectrum.comap c_nod q_y = Q_R := (hSpec_g y).symm
      have hClosed_q : ∀ q_z : PrimeSpectrum A_nod,
          q_y.asIdeal ≤ q_z.asIdeal → PrimeSpectrum.comap c_nod q_z = Q_R → q_z = q_y := by
        intro q_z hle hqz_over
        let z : ↥M_0 := iso.inv.base q_z
        have hiso_z : iso.hom.base z = q_z := by
          change (iso.inv ≫ iso.hom).base q_z = q_z
          rw [iso.inv_hom_id]; rfl
        have hz_cl : z ∈ closure ({y} : Set ↥M_0) :=
          (hSpec_cl y z).1.mpr (by rw [hiso_z]; exact hle)
        have hz_g : g_M0.base z = g_M0.base y := by
          rw [hSpec_g z, hiso_z, hqz_over]
        have hzy : z = y := hClosed_y z hz_cl hz_g
        rw [← hiso_z, hzy]
      obtain ⟨q_0, hq0_le, hq0_over, hq0_ne⟩ := hNod_cl Q_R q_y hqy_over hClosed_q
      let z₀ : ↥M_0 := iso.inv.base q_0
      have hiso_z0 : iso.hom.base z₀ = q_0 := by
        change (iso.inv ≫ iso.hom).base q_0 = q_0
        rw [iso.inv_hom_id]; rfl
      refine ⟨z₀, (hSpec_cl z₀ y).1.mpr (by rw [hiso_z0]; exact hq0_le), ?_, ?_⟩
      · rw [hSpec_g z₀, hiso_z0, hq0_over]
      · intro heq
        apply hq0_ne
        rw [← hiso_z0, heq]
    · intro y hy_or
      apply birat_sub A_nod iso φ_top hφ_inj hφ_η y
      rcases hy_or with hy_notZ | ⟨z, hz_cl, hz_g, hz_ne⟩
      · exact Or.inl hy_notZ
      · refine Or.inr ?_
        let Q_R : PrimeSpectrum ↥R := g_M0.base y
        let q_y : PrimeSpectrum A_nod := iso.hom.base y
        let q_z : PrimeSpectrum A_nod := iso.hom.base z
        have hqy_over : PrimeSpectrum.comap c_nod q_y = Q_R := (hSpec_g y).symm
        have hqz_over : PrimeSpectrum.comap c_nod q_z = Q_R := by
          rw [← hSpec_g z, hz_g]
        have hqy_le_qz : q_y.asIdeal ≤ q_z.asIdeal := (hSpec_cl y z).1.mp hz_cl
        have hqz_ne : q_z ≠ q_y := mt (hSpec_cl z y).2.mpr hz_ne
        obtain ⟨b, hub_notMem, hGauss_b⟩ :=
          hNod_noncl Q_R q_y hqy_over ⟨q_z, hqy_le_qz, hqz_over, hqz_ne⟩
        let u_b : A_nod := Ideal.Quotient.mk I_nod (MvPolynomial.X b)
        let ι_b : Polynomial ↥R →+* A_nod := Polynomial.eval₂RingHom c_nod u_b
        have hub_ne : u_b ≠ 0 := by
          intro h0
          apply hub_notMem
          change u_b ∈ q_y.asIdeal
          rw [h0]
          exact q_y.asIdeal.zero_mem
        have hPoly_frac_b : ∀ x : F_0, ∃ P S : Polynomial ↥R,
            S ≠ 0 ∧ φ_top.hom (ι_b S) * x = φ_top.hom (ι_b P) := by
          intro x
          obtain ⟨f, g, hg_ne, hfg⟩ := hFrac x
          obtain ⟨D₁, P₁, hf_cl⟩ := (hBr b).2 f
          obtain ⟨D₂, P₂, hg_cl⟩ := (hBr b).2 g
          let P : Polynomial ↥R := Polynomial.X ^ D₂ * P₁
          let S : Polynomial ↥R := Polynomial.X ^ D₁ * P₂
          have hι_X : ι_b Polynomial.X = u_b := by simp [ι_b]
          have hιP : ι_b P = u_b ^ (D₁ + D₂) * f := by
            calc ι_b P = u_b ^ D₂ * ι_b P₁ := by simp only [P, map_mul, map_pow, hι_X]
              _ = u_b ^ D₂ * (u_b ^ D₁ * f) := by rw [← hf_cl]
              _ = u_b ^ (D₁ + D₂) * f := by ring
          have hιS : ι_b S = u_b ^ (D₁ + D₂) * g := by
            calc ι_b S = u_b ^ D₁ * ι_b P₂ := by simp only [S, map_mul, map_pow, hι_X]
              _ = u_b ^ D₁ * (u_b ^ D₂ * g) := by rw [← hg_cl]
              _ = u_b ^ (D₁ + D₂) * g := by ring
          have hS_ne : S ≠ 0 := by
            intro hS0
            rw [hS0, map_zero] at hιS
            exact mul_ne_zero (pow_ne_zero (D₁ + D₂) hub_ne) hg_ne hιS.symm
          refine ⟨P, S, hS_ne, ?_⟩
          rw [hιS, hιP, map_mul, map_mul, mul_assoc, hfg]
        exact gauss_val Q_R A_nod φ_top.hom q_y ι_b hφ_inj (hBr b).1 hPoly_frac_b hGauss_b

theorem weil_contracted_component_val_generalization_mem_mod (K : Type u) [Field K]
    (R : ValuationSubring K)
    (W_B_sch X_0_sch : AlgebraicGeometry.Scheme.{u})
    (g_WB : W_B_sch ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
    (f_0 : X_0_sch ⟶ W_B_sch)
    (Z_mod : Set ↥W_B_sch) (hZ_closed : IsClosed Z_mod)
    (F_WB : Type u) [Field F_WB]
    (η_WB : AlgebraicGeometry.Spec (CommRingCat.of F_WB) ⟶ W_B_sch)
    (η_X0 : AlgebraicGeometry.Spec (CommRingCat.of F_WB) ⟶ X_0_sch)
    (hAff_WB : AlgebraicGeometry.IsAffine W_B_sch)
    (hSS_WB : IsStrictlySemistableCurveOverValuation R g_WB)
    (hSS_X0 : IsStrictlySemistableCurveOverValuation R (f_0 ≫ g_WB))
    (hIso_f0_compl : CategoryTheory.IsIso (f_0 ∣_ (⟨Z_modᶜ, hZ_closed.isOpen_compl⟩ : W_B_sch.Opens)))
    (hηX0_f0 : η_X0 ≫ f_0 = η_WB)
    (E : Set ↥(CategoryTheory.Limits.pullback (f_0 ≫ g_WB)
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥R (IsLocalRing.maximalIdeal ↥R).ResidueField)))))
    (hE_irred : E ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback (f_0 ≫ g_WB)
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥R (IsLocalRing.maximalIdeal ↥R).ResidueField)))))
    (W : ValuationSubring F_WB)
    (hW_stalk : IsComponentStalkVal R (f_0 ≫ g_WB) η_X0 E W)
    (ψ_WB : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ W_B_sch)
    (hψ_WB : AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype) ≫ ψ_WB = η_WB)
    (pW : AlgebraicGeometry.Spec (CommRingCat.of ↥W))
    (z_1 : ↥W_B_sch)
    (hz1_cl : ψ_WB.base pW ∈ closure ({z_1} : Set ↥W_B_sch))
    (hz1_fib : g_WB.base z_1 = g_WB.base (ψ_WB.base pW))
    (hz1_ne : z_1 ≠ ψ_WB.base pW) :
    ψ_WB.base pW ∈ Z_mod :=
by
  classical
  
  obtain ⟨ψ_X0, mW, hmW_max, hψ_X0, hE_cl⟩ := hW_stalk
  have _ : AlgebraicGeometry.IsAffine W_B_sch := hAff_WB
  let iso_WB := W_B_sch.isoSpec
  have hψ_comm : ψ_X0 ≫ f_0 = ψ_WB := by
    rw [← CategoryTheory.cancel_mono iso_WB.hom]
    let f₁ : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶
        AlgebraicGeometry.Spec (W_B_sch.presheaf.obj (Opposite.op ⊤)) :=
      (ψ_X0 ≫ f_0) ≫ iso_WB.hom
    let f₂ : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶
        AlgebraicGeometry.Spec (W_B_sch.presheaf.obj (Opposite.op ⊤)) :=
      ψ_WB ≫ iso_WB.hom
    change f₁ = f₂
    rw [← AlgebraicGeometry.Spec.map_preimage f₁, ← AlgebraicGeometry.Spec.map_preimage f₂]
    congr 1
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro a
    apply (Subtype.val_injective : Function.Injective W.subtype)
    have h_gen :
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype) ≫ f₁ =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype) ≫ f₂ := by
      dsimp only [f₁, f₂]
      calc AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype) ≫ (ψ_X0 ≫ f_0) ≫ iso_WB.hom
        _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype) ≫ ψ_X0) ≫ f_0 ≫ iso_WB.hom := by
            simp only [CategoryTheory.Category.assoc]
        _ = (η_X0 ≫ f_0) ≫ iso_WB.hom := by
            rw [hψ_X0, CategoryTheory.Category.assoc]
        _ = η_WB ≫ iso_WB.hom := by
            rw [hηX0_f0]
        _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype) ≫ ψ_WB) ≫ iso_WB.hom := by
            rw [hψ_WB]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype) ≫ ψ_WB ≫ iso_WB.hom := by
            simp only [CategoryTheory.Category.assoc]
    have h_pre := congrArg AlgebraicGeometry.Spec.preimage h_gen
    rw [AlgebraicGeometry.Spec.preimage_comp, AlgebraicGeometry.Spec.preimage_comp,
      AlgebraicGeometry.Spec.preimage_map] at h_pre
    exact congrArg (fun g : W_B_sch.presheaf.obj (Opposite.op ⊤) ⟶ CommRingCat.of F_WB => g.hom a) h_pre
  let x_E : ↥X_0_sch := ψ_X0.base mW
  let x_1 : ↥X_0_sch := ψ_X0.base pW
  let y_1 : ↥W_B_sch := ψ_WB.base pW
  have hf0_x1 : f_0.base x_1 = y_1 := by
    change (ψ_X0 ≫ f_0).base pW = ψ_WB.base pW
