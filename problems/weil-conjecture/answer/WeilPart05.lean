      rcases leIdx_total_above hw₁_u₁ hw₂_u₂ with hu₁₂ | hu₂₁
      · rcases hu₁_hasse.2.2 u₂ hu₁₂ hu₂_hasse.2.1 with h | h
        · exact hu₁_ne_u₂ h.symm
        · exact hu₂_hasse.1 h.symm
      · rcases hu₂_hasse.2.2 u₁ hu₂₁ hu₁_hasse.2.1 with h | h
        · exact hu₁_ne_u₂ h
        · exact hu₁_hasse.1 h.symm
