    let V₀ : X.Opens := (TopologicalSpace.Opens.map f.base).obj W₀
    have : CategoryTheory.IsIso (f ∣_ W₀) := hIso_sub W₀ hW₀_le
    have : AlgebraicGeometry.IsAffine W₀.toScheme := hW₀
