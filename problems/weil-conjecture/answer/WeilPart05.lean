      have heq_hom : res_g ≫ φ_g = φ_U := by
        calc res_g ≫ φ_g
            = AlgebraicGeometry.Spec.preimage (AlgebraicGeometry.Spec.map (res_g ≫ φ_g)) :=
              (AlgebraicGeometry.Spec.preimage_map _).symm
          _ = AlgebraicGeometry.Spec.preimage (AlgebraicGeometry.Spec.map φ_U) := by rw [heq_spec]
          _ = φ_U := AlgebraicGeometry.Spec.preimage_map _
      intro a
      exact congrArg (fun f : Γ.presheaf.obj (Opposite.op U) ⟶ CommRingCat.of F => f.hom a) heq_hom
    have h_β_φ : ∀ b : B₂, φ_g.hom (β b) = φ₂.hom b := by
      have hmap : AlgebraicGeometry.Spec.map (π₂.appLE U₂ B_op e_g ≫ φ_g) ≫ hU₂.fromSpec =
