      { carrier := {u : F | ∃ a ∈ A_sub, ∃ b ∈ A_sub, b ≠ 0 ∧ u * b = a}
        add_mem' := by
          rintro u₁ u₂ ⟨a₁, ha₁, b₁, hb₁, hb₁0, hu₁⟩ ⟨a₂, ha₂, b₂, hb₂, hb₂0, hu₂⟩
          refine ⟨a₁ * b₂ + a₂ * b₁, A_sub.add_mem (A_sub.mul_mem ha₁ hb₂) (A_sub.mul_mem ha₂ hb₁),
            b₁ * b₂, A_sub.mul_mem hb₁ hb₂, mul_ne_zero hb₁0 hb₂0, ?_⟩
          calc
            (u₁ + u₂) * (b₁ * b₂) = (u₁ * b₁) * b₂ + (u₂ * b₂) * b₁ := by ring
            _ = a₁ * b₂ + a₂ * b₁ := by rw [hu₁, hu₂]
        zero_mem' := ⟨0, A_sub.zero_mem, 1, A_sub.one_mem, one_ne_zero, zero_mul 1⟩
        mul_mem' := by
          rintro u₁ u₂ ⟨a₁, ha₁, b₁, hb₁, hb₁0, hu₁⟩ ⟨a₂, ha₂, b₂, hb₂, hb₂0, hu₂⟩
          refine ⟨a₁ * a₂, A_sub.mul_mem ha₁ ha₂, b₁ * b₂, A_sub.mul_mem hb₁ hb₂,
            mul_ne_zero hb₁0 hb₂0, ?_⟩
          calc
            (u₁ * u₂) * (b₁ * b₂) = (u₁ * b₁) * (u₂ * b₂) := by ring
            _ = a₁ * a₂ := by rw [hu₁, hu₂]
        one_mem' := ⟨1, A_sub.one_mem, 1, A_sub.one_mem, one_ne_zero, one_mul 1⟩
        inv_mem' := by
          rintro u ⟨a, ha, b, hb, hb0, hu⟩
          by_cases hu0 : u = 0
