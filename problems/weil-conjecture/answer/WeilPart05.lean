        · exact ⟨0, h0⟩
        · exact ⟨1, h1⟩
      obtain ⟨i₀, hu_η⟩ := hex_i₀
      have hu_z₀ : u i₀ ∈ p_z₀ := hp_le hu_η
      obtain ⟨Φ_Q, hΦ_Q_mk, hSurj_ΦQ, _, hΦ_Q_cm, hΦ_Q_br⟩ :=
        hBranchHom τ_Q hSurj_Q ha_τQ i₀
      let p₀ : Ideal A_nod := RingHom.ker Φ_Q
      have hp₀_pr : p₀.IsPrime := RingHom.ker_isPrime Φ_Q
      have hp₀_cm : Ideal.comap γ_nod p₀ = Q := hΦ_Q_cm.trans hker_τQ
      have hp₀_le : p₀ ≤ p_η := hΦ_Q_br p_η (hp_η_Q.trans hker_τQ.symm) hu_η
      have hp₀_eq : p₀ = p_η := hMin p₀ hp₀_pr hp₀_cm hp₀_le
      let e_Q : (A_nod ⧸ p_η) ≃+* Polynomial ↥V_Q :=
        (Ideal.quotEquivOfEq hp₀_eq.symm).trans (RingHom.quotientKerEquivOfSurjective hSurj_ΦQ)
      have hIC_nod : IsIntegrallyClosed (A_nod ⧸ p_η) :=
        IsIntegrallyClosed.of_equiv e_Q.symm
      obtain ⟨Φ_m, hΦ_m_mk, _, hΦ_m_ev, hΦ_m_cm, hΦ_m_br⟩ :=
        hBranchHom π_m hSurj_m ha_πm i₀
      let p_m : Ideal A_nod := RingHom.ker Φ_m
      have hp_m_pr : p_m.IsPrime := RingHom.ker_isPrime Φ_m
      refine ⟨inferInstance, hIC_nod, p_m, hp_m_pr, u (1 - i₀), ?_, ?_, ?_, ?_⟩
      · rw [← hp₀_eq]
        intro x hx
        obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective x
        rw [RingHom.mem_ker] at hx ⊢
        rw [hΦ_Q_mk] at hx
        rw [hΦ_m_mk]
        ext n
        rw [Polynomial.coeff_map, Polynomial.coeff_zero]
        have hn : (MvPolynomial.eval₂Hom Polynomial.C
            (fun j : Fin 2 => if j = i₀ then 0 else Polynomial.X) F).coeff n ∈ Q := by
          rw [← hker_τQ, RingHom.mem_ker, ← Polynomial.coeff_map, hx, Polynomial.coeff_zero]
        exact RingHom.mem_ker.mp (hker_m.symm ▸ hQ_le_mR hn)
      · exact hΦ_m_br p_z₀ (hp_z₀_m.trans hker_m.symm) hu_z₀
      · exact hΦ_m_cm.trans hker_m
      · rintro g ⟨i, hi⟩ hmem
        rw [RingHom.mem_ker, hΦ_m_ev] at hmem
        apply hi
        rw [← hker_m, RingHom.mem_ker, ← Polynomial.coeff_map, hmem, Polynomial.coeff_zero]
    · have ha_VQ : τ_Q a ≠ 0 := fun h => ha_Q (hker_τQ ▸ RingHom.mem_ker.mpr h)
      let I_VQ : Ideal (MvPolynomial (Fin 2) ↥V_Q) :=
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C (τ_Q a)}
      let A_VQ := MvPolynomial (Fin 2) ↥V_Q ⧸ I_VQ
      let _ : CommRing A_VQ := Ideal.Quotient.commRing I_VQ
      obtain ⟨hDom_VQ, hIC_VQ⟩ := hNodalNorm Q.ResidueField V_Q (τ_Q a) ha_VQ
      have _ : IsDomain A_VQ := hDom_VQ
      have _ : IsIntegrallyClosed A_VQ := hIC_VQ
      obtain ⟨ψ_bar_Q, hSurj_ψQ, hker_ψQ⟩ := hBaseChangeHom τ_Q hSurj_Q
      rw [hker_τQ] at hker_ψQ
      let p₀ : Ideal A_nod := RingHom.ker ψ_bar_Q
      have hp₀_pr : p₀.IsPrime := RingHom.ker_isPrime ψ_bar_Q
      have hp₀_le : p₀ ≤ p_η := by
        change RingHom.ker ψ_bar_Q ≤ p_η
        rw [hker_ψQ, Ideal.map_le_iff_le_comap]
        exact hp_η_Q.ge
      have hp₀_cm : Ideal.comap γ_nod p₀ = Q := by
        refine le_antisymm ((Ideal.comap_mono hp₀_le).trans hp_η_Q.le) ?_
        change Q ≤ Ideal.comap γ_nod (RingHom.ker ψ_bar_Q)
        rw [hker_ψQ]
        exact Ideal.le_comap_map
      have hp₀_eq : p₀ = p_η := hMin p₀ hp₀_pr hp₀_cm hp₀_le
      let e_VQ : (A_nod ⧸ p_η) ≃+* A_VQ :=
        (Ideal.quotEquivOfEq hp₀_eq.symm).trans (RingHom.quotientKerEquivOfSurjective hSurj_ψQ)
      have hIC_nod : IsIntegrallyClosed (A_nod ⧸ p_η) :=
        IsIntegrallyClosed.of_equiv e_VQ.symm
      have hp_η_map : p_η = Ideal.map γ_nod Q := hp₀_eq.symm.trans hker_ψQ
      by_cases ha_m : a ∈ m_R
      · have ha_πm : π_m a = 0 := RingHom.mem_ker.mp (hker_m.symm ▸ ha_m)
        have hga_z₀ : u 0 * u 1 ∈ p_z₀ := by
          rw [hu_mul, ← Ideal.mem_comap, hp_z₀_m]
          exact ha_m
        have hex_i₀ : ∃ i₀ : Fin 2, u i₀ ∈ p_z₀ := by
          rcases hp_z₀_pr.mem_or_mem hga_z₀ with h0 | h1
          · exact ⟨0, h0⟩
          · exact ⟨1, h1⟩
        obtain ⟨i₀, hu_z₀⟩ := hex_i₀
        obtain ⟨Φ_m, _, _, hΦ_m_ev, hΦ_m_cm, hΦ_m_br⟩ :=
          hBranchHom π_m hSurj_m ha_πm i₀
        let p_m : Ideal A_nod := RingHom.ker Φ_m
        have hp_m_pr : p_m.IsPrime := RingHom.ker_isPrime Φ_m
        refine ⟨inferInstance, hIC_nod, p_m, hp_m_pr, u (1 - i₀), ?_, ?_, ?_, ?_⟩
        · rw [hp_η_map, Ideal.map_le_iff_le_comap, hΦ_m_cm, hker_m]
          exact hQ_le_mR
        · exact hΦ_m_br p_z₀ (hp_z₀_m.trans hker_m.symm) hu_z₀
        · exact hΦ_m_cm.trans hker_m
        · rintro g ⟨i, hi⟩ hmem
          rw [RingHom.mem_ker, hΦ_m_ev] at hmem
          apply hi
          rw [← hker_m, RingHom.mem_ker, ← Polynomial.coeff_map, hmem, Polynomial.coeff_zero]
      · let V_top : ValuationSubring k_R := ⊤
        let τ_m : ↥R →+* ↥V_top := π_m.codRestrict V_top (fun _ => trivial)
        have hSurj_τm : Function.Surjective τ_m := by
          intro y
          obtain ⟨r, hr⟩ := hSurj_m y.1
          exact ⟨r, Subtype.ext hr⟩
        have hker_τm : RingHom.ker τ_m = m_R := by
          ext r
          rw [RingHom.mem_ker, Subtype.ext_iff]
          change π_m r = 0 ↔ r ∈ m_R
          rw [← RingHom.mem_ker, hker_m]
        have ha_top : τ_m a ≠ 0 := fun h => ha_m (hker_τm ▸ RingHom.mem_ker.mpr h)
        let I_top : Ideal (MvPolynomial (Fin 2) ↥V_top) :=
          Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C (τ_m a)}
        let A_top := MvPolynomial (Fin 2) ↥V_top ⧸ I_top
        let _ : CommRing A_top := Ideal.Quotient.commRing I_top
        obtain ⟨hDom_top, _⟩ := hNodalNorm k_R V_top (τ_m a) ha_top
        have _ : IsDomain A_top := hDom_top
        obtain ⟨ψ_bar_m, _, hker_ψm⟩ := hBaseChangeHom τ_m hSurj_τm
        rw [hker_τm] at hker_ψm
        let p_m : Ideal A_nod := RingHom.ker ψ_bar_m
        have hp_m_pr : p_m.IsPrime := RingHom.ker_isPrime ψ_bar_m
        have hp_m_lo : p_η ≤ p_m := by
          change p_η ≤ RingHom.ker ψ_bar_m
          rw [hp_η_map, hker_ψm]
          exact Ideal.map_mono hQ_le_mR
        have hp_m_hi : p_m ≤ p_z₀ := by
          change RingHom.ker ψ_bar_m ≤ p_z₀
          rw [hker_ψm, Ideal.map_le_iff_le_comap]
          exact hp_z₀_m.ge
        have hp_m_cm : Ideal.comap γ_nod p_m = m_R := by
          refine le_antisymm ((Ideal.comap_mono hp_m_hi).trans hp_z₀_m.le) ?_
          change m_R ≤ Ideal.comap γ_nod (RingHom.ker ψ_bar_m)
          rw [hker_ψm]
          exact Ideal.le_comap_map
        refine ⟨inferInstance, hIC_nod, p_m, hp_m_pr, u 0, hp_m_lo, hp_m_hi, hp_m_cm, ?_⟩
        let w_m : Fin 2 → LaurentPolynomial k_R :=
          ![LaurentPolynomial.T 1, LaurentPolynomial.C (π_m a) * LaurentPolynomial.T (-1)]
        let ν₀ : MvPolynomial (Fin 2) ↥R →+* LaurentPolynomial k_R :=
          MvPolynomial.eval₂Hom (LaurentPolynomial.C.comp π_m) w_m
        have hIa_le_ν : I_a ≤ RingHom.ker ν₀ := by
          rw [Ideal.span_le]
          intro y hy
          rw [Set.mem_singleton_iff] at hy
          subst hy
          rw [SetLike.mem_coe, RingHom.mem_ker]
          rw [map_sub, map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X',
            MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
          dsimp only [w_m, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons]
          calc LaurentPolynomial.T 1 * (LaurentPolynomial.C (π_m a) * LaurentPolynomial.T (-1)) -
                LaurentPolynomial.C (π_m a)
              = LaurentPolynomial.C (π_m a) *
                  (LaurentPolynomial.T 1 * LaurentPolynomial.T (-1)) -
                LaurentPolynomial.C (π_m a) := by rw [mul_left_comm]
            _ = LaurentPolynomial.C (π_m a) * LaurentPolynomial.T ((1 : ℤ) + -1) -
                LaurentPolynomial.C (π_m a) := by rw [← LaurentPolynomial.T_add]
            _ = 0 := by rw [add_neg_cancel, LaurentPolynomial.T_zero, mul_one, sub_self]
        let ν_bar_m : A_nod →+* LaurentPolynomial k_R := Ideal.Quotient.lift I_a ν₀ hIa_le_ν
        have hp_m_le_ν : p_m ≤ RingHom.ker ν_bar_m := by
          change RingHom.ker ψ_bar_m ≤ RingHom.ker ν_bar_m
          rw [hker_ψm, Ideal.map_le_iff_le_comap]
          intro c hc
          have hc0 : π_m c = 0 := RingHom.mem_ker.mp (hker_m.symm ▸ hc)
          rw [Ideal.mem_comap, RingHom.mem_ker]
          change ν₀ (MvPolynomial.C c) = 0
          rw [MvPolynomial.eval₂Hom_C, RingHom.comp_apply, hc0, map_zero]
        rintro g ⟨i, hi⟩ hmem
        have hν0 : ν_bar_m (Polynomial.eval₂ γ_nod (u 0) g) = 0 :=
          RingHom.mem_ker.mp (hp_m_le_ν hmem)
        have hν_eq : ν_bar_m (Polynomial.eval₂ γ_nod (u 0) g) =
            Polynomial.toLaurent (Polynomial.map π_m g) := by
          rw [Polynomial.hom_eval₂]
          have hcomp : ν_bar_m.comp γ_nod = (Polynomial.toLaurent.comp Polynomial.C).comp π_m := by
            apply RingHom.ext
            intro c
            change ν₀ (MvPolynomial.C c) = Polynomial.toLaurent (Polynomial.C (π_m c))
            rw [MvPolynomial.eval₂Hom_C, RingHom.comp_apply, Polynomial.toLaurent_C]
          have hu0 : ν_bar_m (u 0) = Polynomial.toLaurent Polynomial.X := by
            change ν₀ (MvPolynomial.X 0) = Polynomial.toLaurent Polynomial.X
            rw [MvPolynomial.eval₂Hom_X', Polynomial.toLaurent_X]
            rfl
          rw [hcomp, ← Polynomial.eval₂_map, hu0, ← Polynomial.hom_eval₂, Polynomial.eval₂_C_X]
        rw [hν_eq] at hν0
        have hg_map0 : Polynomial.map π_m g = 0 :=
          Polynomial.toLaurent_injective (hν0.trans (map_zero Polynomial.toLaurent).symm)
        apply hi
        rw [← hker_m, RingHom.mem_ker, ← Polynomial.coeff_map, hg_map0, Polynomial.coeff_zero]

theorem weil_etale_normal_quotient_goingDown_prime_lift (A₀ B : Type u) [CommRing A₀] [CommRing B]
    (θ₀ : A₀ →+* B) (hEt : θ₀.Etale)
    (q_η q_z₀ : Ideal B) [q_η.IsPrime] [q_z₀.IsPrime] (hq_le : q_η ≤ q_z₀)
    (hDom : IsDomain (A₀ ⧸ Ideal.comap θ₀ q_η))
    (hIC : IsIntegrallyClosed (A₀ ⧸ Ideal.comap θ₀ q_η))
    (p_m : Ideal A₀) [p_m.IsPrime]
    (hp_lo : Ideal.comap θ₀ q_η ≤ p_m)
    (hp_hi : p_m ≤ Ideal.comap θ₀ q_z₀) :
    ∃ (q_m : Ideal B) (_ : q_m.IsPrime),
      q_η ≤ q_m ∧ q_m ≤ q_z₀ ∧ Ideal.comap θ₀ q_m = p_m :=
by
  
  let p_η : Ideal A₀ := Ideal.comap θ₀ q_η
  let p_z₀ : Ideal A₀ := Ideal.comap θ₀ q_z₀
  haveI hp_η_pr : p_η.IsPrime := Ideal.IsPrime.comap θ₀
  haveI hp_z₀_pr : p_z₀.IsPrime := Ideal.IsPrime.comap θ₀
  have hp_η_z₀ : p_η ≤ p_z₀ := Ideal.comap_mono hq_le
  let C₀ : Type u := A₀ ⧸ p_η
  let D₀ : Type u := B ⧸ q_η
  haveI : IsDomain D₀ := Ideal.Quotient.isDomain q_η
  let π_C : A₀ →+* C₀ := Ideal.Quotient.mk p_η
  let π_D : B →+* D₀ := Ideal.Quotient.mk q_η
  have hSurj_C : Function.Surjective π_C := Ideal.Quotient.mk_surjective
  have hSurj_D : Function.Surjective π_D := Ideal.Quotient.mk_surjective
  have hker_C : RingHom.ker π_C = p_η := by
    ext x; exact Ideal.Quotient.eq_zero_iff_mem
  have hker_D : RingHom.ker π_D = q_η := by
    ext x; exact Ideal.Quotient.eq_zero_iff_mem
  let θ_bar : C₀ →+* D₀ :=
    Ideal.Quotient.lift p_η (π_D.comp θ₀) (fun _ ha => Ideal.Quotient.eq_zero_iff_mem.mpr ha)
  letI : Algebra C₀ D₀ := θ_bar.toAlgebra
  have hComm : (algebraMap C₀ D₀).comp π_C = π_D.comp θ₀ :=
    RingHom.ext fun _ => rfl
  have hInj : Function.Injective (algebraMap C₀ D₀) := by
    intro x y hxy
    obtain ⟨a, rfl⟩ := hSurj_C x
    obtain ⟨b, rfl⟩ := hSurj_C y
    have h0 : π_D (θ₀ (a - b)) = 0 := by
      change (π_D.comp θ₀) (a - b) = 0
      rw [← hComm, RingHom.comp_apply, map_sub, map_sub, hxy, sub_self]
    have hab : a - b ∈ p_η := by
      change θ₀ (a - b) ∈ q_η
      rw [← hker_D]
      exact h0
    have hsub0 : π_C (a - b) = 0 := by
      rw [← RingHom.mem_ker, hker_C]
      exact hab
    exact sub_eq_zero.mp (by rwa [map_sub] at hsub0)
  let p_bar_m : Ideal C₀ := Ideal.map π_C p_m
  let p_bar_z₀ : Ideal C₀ := Ideal.map π_C p_z₀
  let q_bar_z₀ : Ideal D₀ := Ideal.map π_D q_z₀
  haveI hp_bar_m_pr : p_bar_m.IsPrime :=
    Ideal.map_isPrime_of_surjective hSurj_C (by rw [hker_C]; exact hp_lo)
  haveI hp_bar_z₀_pr : p_bar_z₀.IsPrime :=
    Ideal.map_isPrime_of_surjective hSurj_C (by rw [hker_C]; exact hp_η_z₀)
  haveI hq_bar_z₀_pr : q_bar_z₀.IsPrime :=
    Ideal.map_isPrime_of_surjective hSurj_D (by rw [hker_D]; exact hq_le)
  have hp_comap_m : Ideal.comap π_C p_bar_m = p_m := by
    rw [Ideal.comap_map_of_surjective' π_C hSurj_C p_m, hker_C, sup_eq_left.mpr hp_lo]
  have hp_comap_z₀ : Ideal.comap π_C p_bar_z₀ = p_z₀ := by
    rw [Ideal.comap_map_of_surjective' π_C hSurj_C p_z₀, hker_C, sup_eq_left.mpr hp_η_z₀]
  have hq_comap_z₀ : Ideal.comap π_D q_bar_z₀ = q_z₀ := by
    rw [Ideal.comap_map_of_surjective' π_D hSurj_D q_z₀, hker_D, sup_eq_left.mpr hq_le]
  have hp_bar_le : p_bar_m ≤ p_bar_z₀ := Ideal.map_mono hp_hi
  have hq_bar_over : Ideal.comap (algebraMap C₀ D₀) q_bar_z₀ = p_bar_z₀ := by
    ext x
    obtain ⟨a, rfl⟩ := hSurj_C x
    change (algebraMap C₀ D₀) (π_C a) ∈ q_bar_z₀ ↔ π_C a ∈ p_bar_z₀
    have h1 : (algebraMap C₀ D₀) (π_C a) = π_D (θ₀ a) := rfl
    rw [h1, ← Ideal.mem_comap, hq_comap_z₀]
    change a ∈ p_z₀ ↔ π_C a ∈ p_bar_z₀
    rw [← hp_comap_z₀, Ideal.mem_comap]

  
  have hZMT : ∃ r_raw : B, r_raw ∉ q_z₀ ∧ IsIntegral C₀ (π_D r_raw) ∧
      ∀ x : D₀, ∃ k : ℕ, IsIntegral C₀ (π_D r_raw ^ k * x) := by
    letI : Algebra A₀ B := θ₀.toAlgebra
    haveI : Algebra.Etale A₀ B := RingHom.Etale.toAlgebra hEt
    obtain ⟨r_raw, hr_not, hr_int_A₀, h_pow_A₀⟩ :=
      Algebra.zariskisMainProperty_iff.mp (Algebra.ZariskisMainProperty.of_finiteType (R := A₀) q_z₀)
    have hComm' : (algebraMap C₀ D₀).comp π_C = π_D.comp (algebraMap A₀ B) := hComm
    refine ⟨r_raw, hr_not, IsIntegral.map_of_comp_eq π_C π_D hComm' hr_int_A₀, fun x => ?_⟩
    obtain ⟨y, rfl⟩ := hSurj_D x
    obtain ⟨k, hk⟩ := h_pow_A₀ y
    refine ⟨k, ?_⟩
    have hk' := IsIntegral.map_of_comp_eq π_C π_D hComm' hk
    rwa [map_mul, map_pow] at hk'
  obtain ⟨r_raw, hr_raw_not, hr_int, h_pow_int⟩ := hZMT
  let R_int : Subalgebra C₀ D₀ := integralClosure C₀ D₀
  let r₀ : ↥R_int := ⟨π_D r_raw, (mem_integralClosure_iff C₀ D₀).mpr hr_int⟩
  have hr₀_not_hi : (r₀ : D₀) ∉ q_bar_z₀ := by
    change π_D r_raw ∉ q_bar_z₀
    rw [← Ideal.mem_comap, hq_comap_z₀]
    exact hr_raw_not
  have h_mult : ∀ x : D₀, ∃ k : ℕ, (r₀ : D₀) ^ k * x ∈ R_int := by
    intro x
    obtain ⟨k, hk⟩ := h_pow_int x
    exact ⟨k, (mem_integralClosure_iff C₀ D₀).mpr hk⟩

  
  let Q_hi : Ideal ↥R_int := Ideal.comap R_int.val.toRingHom q_bar_z₀
  have hGD : ∃ (q_int : Ideal ↥R_int) (_ : q_int.IsPrime),
      q_int ≤ Q_hi ∧ Ideal.comap (algebraMap C₀ ↥R_int) q_int = p_bar_m := by
    have hFaith : FaithfulSMul C₀ ↥R_int := ⟨by
      intro c₁ c₂ h
      apply hInj
      have h1 : algebraMap C₀ ↥R_int c₁ = algebraMap C₀ ↥R_int c₂ := by
        simpa only [Algebra.smul_def, mul_one] using h 1
      exact congrArg Subtype.val h1⟩
    haveI : Algebra.HasGoingDown C₀ ↥R_int :=
      @instHasGoingDownOfIsDomainOfFaithfulSMulOfIsIntegralOfIsIntegrallyClosed
        C₀ ↥R_int _ _ _ _ hFaith _ hIC
    haveI : Q_hi.IsPrime := Ideal.IsPrime.comap R_int.val.toRingHom
    have hQ_under : p_bar_z₀ = Ideal.under C₀ Q_hi := by
      rw [Ideal.under_def]
      exact hq_bar_over.symm
    haveI : Q_hi.LiesOver p_bar_z₀ := ⟨hQ_under⟩
    obtain ⟨q_int, hq_int_le, hq_int_pr, hq_int_over⟩ :=
      Ideal.exists_ideal_le_liesOver_of_le (p := p_bar_m) (q := p_bar_z₀) Q_hi hp_bar_le
    refine ⟨q_int, hq_int_pr, hq_int_le, ?_⟩
    have hover := hq_int_over.over.symm
    rwa [Ideal.under_def] at hover
  obtain ⟨q_int, hq_int_pr, hq_int_le, hq_int_over⟩ := hGD
  haveI : q_int.IsPrime := hq_int_pr

  
  have hr₀_not_S : r₀ ∉ q_int := fun h => hr₀_not_hi (hq_int_le h)
  have hr₀_pow_not_S : ∀ k : ℕ, r₀ ^ k ∉ q_int :=
    fun k hk => hr₀_not_S (hq_int_pr.mem_of_pow_mem k hk)
  have hr₀_pow_not_hi : ∀ k : ℕ, (r₀ : D₀) ^ k ∉ q_bar_z₀ :=
    fun k hk => hr₀_not_hi (hq_bar_z₀_pr.mem_of_pow_mem k hk)
  let P_sat : Set D₀ :=
    {x : D₀ | ∃ (k : ℕ) (h : (r₀ : D₀) ^ k * x ∈ R_int),
      (⟨(r₀ : D₀) ^ k * x, h⟩ : ↥R_int) ∈ q_int}
  have h_indep : ∀ {x : D₀}, x ∈ P_sat → ∀ (k₁ : ℕ) (h₁ : (r₀ : D₀) ^ k₁ * x ∈ R_int),
      (⟨(r₀ : D₀) ^ k₁ * x, h₁⟩ : ↥R_int) ∈ q_int := by
    rintro x ⟨k, h, hu⟩ k₁ h₁
    let u : ↥R_int := ⟨(r₀ : D₀) ^ k * x, h⟩
    let u₁ : ↥R_int := ⟨(r₀ : D₀) ^ k₁ * x, h₁⟩
    have hmul_eq : r₀ ^ k * u₁ = r₀ ^ k₁ * u := by
      apply Subtype.ext
      dsimp only [u, u₁]
      push_cast
      ring
    have hmul_mem : r₀ ^ k * u₁ ∈ q_int := by
      rw [hmul_eq]
      exact q_int.mul_mem_left (r₀ ^ k₁) hu
    exact (hq_int_pr.mem_or_mem hmul_mem).resolve_left (hr₀_pow_not_S k)
  let q_bar_m : Ideal D₀ :=
    { carrier := P_sat
      zero_mem' := by
        have h0_mem : (r₀ : D₀) ^ 0 * 0 ∈ R_int := by
          simp only [pow_zero, one_mul]
          exact R_int.zero_mem
        refine ⟨0, h0_mem, ?_⟩
        have hsub0 : (⟨(r₀ : D₀) ^ 0 * 0, h0_mem⟩ : ↥R_int) = 0 := by
          apply Subtype.ext
          simp only [pow_zero, one_mul, ZeroMemClass.coe_zero]
        rw [hsub0]
        exact q_int.zero_mem
      add_mem' := by
        rintro x y ⟨kx, hx, hux⟩ ⟨ky, hy, huy⟩
        let ux : ↥R_int := ⟨(r₀ : D₀) ^ kx * x, hx⟩
        let uy : ↥R_int := ⟨(r₀ : D₀) ^ ky * y, hy⟩
        let v : ↥R_int := r₀ ^ ky * ux + r₀ ^ kx * uy
        have hv_mem : v ∈ q_int :=
          q_int.add_mem (q_int.mul_mem_left (r₀ ^ ky) hux) (q_int.mul_mem_left (r₀ ^ kx) huy)
        have hv_eq : (r₀ : D₀) ^ (kx + ky) * (x + y) = (v : D₀) := by
          dsimp only [v, ux, uy]
          push_cast
          ring
        refine ⟨kx + ky, hv_eq.symm ▸ v.2, ?_⟩
        have hsub : (⟨(r₀ : D₀) ^ (kx + ky) * (x + y), hv_eq.symm ▸ v.2⟩ : ↥R_int) = v :=
          Subtype.ext hv_eq
        rwa [hsub]
      smul_mem' := by
        rintro d x ⟨kx, hx, hux⟩
        change d * x ∈ P_sat
        obtain ⟨kd, hd⟩ := h_mult d
        let ud : ↥R_int := ⟨(r₀ : D₀) ^ kd * d, hd⟩
        let ux : ↥R_int := ⟨(r₀ : D₀) ^ kx * x, hx⟩
        let v : ↥R_int := ud * ux
        have hv_mem : v ∈ q_int := q_int.mul_mem_left ud hux
        have hv_eq : (r₀ : D₀) ^ (kd + kx) * (d * x) = (v : D₀) := by
          dsimp only [v, ud, ux]
          push_cast
          ring
        refine ⟨kd + kx, hv_eq.symm ▸ v.2, ?_⟩
        have hsub : (⟨(r₀ : D₀) ^ (kd + kx) * (d * x), hv_eq.symm ▸ v.2⟩ : ↥R_int) = v :=
          Subtype.ext hv_eq
        rwa [hsub] }
  have hq_bar_m_pr : q_bar_m.IsPrime := by
    rw [Ideal.isPrime_iff]
    refine ⟨?_, ?_⟩
    · intro htop
      have h1_mem : (1 : D₀) ∈ q_bar_m := htop.symm ▸ Submodule.mem_top
      have h1_R : (r₀ : D₀) ^ 0 * (1 : D₀) ∈ R_int := by
        simp only [pow_zero, one_mul]
        exact R_int.one_mem
      have hu1 : (⟨(r₀ : D₀) ^ 0 * (1 : D₀), h1_R⟩ : ↥R_int) ∈ q_int :=
        h_indep h1_mem 0 h1_R
      have hsub1 : (⟨(r₀ : D₀) ^ 0 * (1 : D₀), h1_R⟩ : ↥R_int) = 1 := by
        apply Subtype.ext
        simp only [pow_zero, one_mul, OneMemClass.coe_one]
      rw [hsub1] at hu1
      exact hq_int_pr.one_notMem hu1
    · intro x y hxy
      obtain ⟨kx, hx⟩ := h_mult x
      obtain ⟨ky, hy⟩ := h_mult y
      let ux : ↥R_int := ⟨(r₀ : D₀) ^ kx * x, hx⟩
      let uy : ↥R_int := ⟨(r₀ : D₀) ^ ky * y, hy⟩
      let v : ↥R_int := ux * uy
      have hv_eq : (r₀ : D₀) ^ (kx + ky) * (x * y) = (v : D₀) := by
        dsimp only [v, ux, uy]
        push_cast
        ring
      have hv_mem' : (⟨(r₀ : D₀) ^ (kx + ky) * (x * y), hv_eq.symm ▸ v.2⟩ : ↥R_int) ∈ q_int :=
        h_indep hxy (kx + ky) (hv_eq.symm ▸ v.2)
      have hsub : (⟨(r₀ : D₀) ^ (kx + ky) * (x * y), hv_eq.symm ▸ v.2⟩ : ↥R_int) = v :=
        Subtype.ext hv_eq
      rw [hsub] at hv_mem'
      rcases hq_int_pr.mem_or_mem hv_mem' with hux_mem | huy_mem
      · exact Or.inl ⟨kx, hx, hux_mem⟩
      · exact Or.inr ⟨ky, hy, huy_mem⟩
  have hq_bar_m_le : q_bar_m ≤ q_bar_z₀ := by
    rintro x ⟨k, _, hu⟩
    have hmem : (r₀ : D₀) ^ k * x ∈ q_bar_z₀ := hq_int_le hu
    exact (hq_bar_z₀_pr.mem_or_mem hmem).resolve_left (hr₀_pow_not_hi k)
  have hq_bar_m_comap : Ideal.comap R_int.val.toRingHom q_bar_m = q_int := by
    ext s
    rw [Ideal.mem_comap]
    change (s : D₀) ∈ q_bar_m ↔ s ∈ q_int
    have hs0 : (r₀ : D₀) ^ 0 * (s : D₀) ∈ R_int := by
      simp only [pow_zero, one_mul]
      exact s.2
    have hsub : (⟨(r₀ : D₀) ^ 0 * (s : D₀), hs0⟩ : ↥R_int) = s := by
      apply Subtype.ext
      simp only [pow_zero, one_mul]
    constructor
    · intro hs_mem
      have hu := h_indep hs_mem 0 hs0
      rwa [hsub] at hu
    · intro hs_q
      exact ⟨0, hs0, by rwa [hsub]⟩

  
  haveI : q_bar_m.IsPrime := hq_bar_m_pr
  let q_m : Ideal B := Ideal.comap π_D q_bar_m
  have hq_m_pr : q_m.IsPrime := Ideal.IsPrime.comap π_D
  refine ⟨q_m, hq_m_pr, ?_, ?_, ?_⟩
  · intro b hb
    rw [Ideal.mem_comap, Ideal.Quotient.eq_zero_iff_mem.mpr hb]
    exact q_bar_m.zero_mem
  · calc q_m = Ideal.comap π_D q_bar_m := rfl
      _ ≤ Ideal.comap π_D q_bar_z₀ := Ideal.comap_mono hq_bar_m_le
      _ = q_z₀ := hq_comap_z₀
  · have hC_comap : Ideal.comap (algebraMap C₀ D₀) q_bar_m = p_bar_m := by
      have halg_fac : algebraMap C₀ D₀ = R_int.val.toRingHom.comp (algebraMap C₀ ↥R_int) := rfl
      rw [halg_fac, ← Ideal.comap_comap, hq_bar_m_comap, hq_int_over]
    calc Ideal.comap θ₀ q_m
        = Ideal.comap (π_D.comp θ₀) q_bar_m := Ideal.comap_comap θ₀ π_D
      _ = Ideal.comap ((algebraMap C₀ D₀).comp π_C) q_bar_m := by rw [hComm]
      _ = Ideal.comap π_C (Ideal.comap (algebraMap C₀ D₀) q_bar_m) :=
          (Ideal.comap_comap π_C (algebraMap C₀ D₀)).symm
      _ = Ideal.comap π_C p_bar_m := by rw [hC_comap]
      _ = p_m := hp_comap_m

theorem weil_strictlySemistable_affine_chart_and_closedFiber_components (K : Type u) [Field K]
    (R : ValuationSubring K)
    (Y : AlgebraicGeometry.Scheme.{u})
    (g_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
    (hSS_Y : IsStrictlySemistableCurveOverValuation R g_Y) :
    let s_R := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.maximalIdeal ↥R).ResidueField))
    (∀ y : ↥Y, ∃ (U : Y.Opens) (hU : AlgebraicGeometry.IsAffineOpen U),
      y ∈ U ∧
      ((∃ θ : Polynomial ↥R →+* ↑(Y.presheaf.obj (Opposite.op U)),
          θ.Etale ∧
          θ.comp Polynomial.C = (AlgebraicGeometry.Spec.preimage (hU.fromSpec ≫ g_Y)).hom) ∨
       (∃ (a : ↥R) (θ : (MvPolynomial (Fin 2) ↥R ⧸
            Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}) →+*
              ↑(Y.presheaf.obj (Opposite.op U))),
          a ≠ 0 ∧ θ.Etale ∧
          θ.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) =
            (AlgebraicGeometry.Spec.preimage (hU.fromSpec ≫ g_Y)).hom))) ∧
    (AlgebraicGeometry.IsClosedImmersion (CategoryTheory.Limits.pullback.fst g_Y s_R) ∧
      Set.range (CategoryTheory.Limits.pullback.fst g_Y s_R).base =
        {y : ↥Y | (g_Y.base y).asIdeal = IsLocalRing.maximalIdeal ↥R}) ∧
    (∀ (U : Y.Opens) (hU : AlgebraicGeometry.IsAffineOpen U)
        (p₁ : PrimeSpectrum ↑(Y.presheaf.obj (Opposite.op U))),
      Ideal.comap (AlgebraicGeometry.Spec.preimage (hU.fromSpec ≫ g_Y)).hom p₁.asIdeal =
        IsLocalRing.maximalIdeal ↥R →
      (∀ p' : PrimeSpectrum ↑(Y.presheaf.obj (Opposite.op U)),
        Ideal.comap (AlgebraicGeometry.Spec.preimage (hU.fromSpec ≫ g_Y)).hom p'.asIdeal =
          IsLocalRing.maximalIdeal ↥R →
        p' ≤ p₁ → p' = p₁) →
      ∃ E₁ ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_Y s_R),
        (CategoryTheory.Limits.pullback.fst g_Y s_R).base '' E₁ =
          closure ({hU.fromSpec.base p₁} : Set ↥Y)) :=
by
  classical
  intro s_R
  let m_R : Ideal ↥R := IsLocalRing.maximalIdeal ↥R
  have _ : m_R.IsMaximal := IsLocalRing.maximalIdeal.isMaximal ↥R
  have _ : m_R.IsPrime := (IsLocalRing.maximalIdeal.isMaximal ↥R).isPrime
  let k_R : Type u := m_R.ResidueField
  let F_R := CategoryTheory.Limits.pullback g_Y s_R
  let fst_Y := CategoryTheory.Limits.pullback.fst g_Y s_R
  have hShrink : ∀ (y : ↥Y) (W : Y.Opens) {A_ch : Type u} [CommRing A_ch]
      (c_ch : ↥R →+* A_ch)
      (e : W.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of A_ch)),
      y ∈ W →
      AlgebraicGeometry.Etale e →
      W.ι ≫ g_Y = e ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_ch) →
      ∃ (U : Y.Opens) (hU : AlgebraicGeometry.IsAffineOpen U),
        y ∈ U ∧
        ∃ θ : A_ch →+* ↑(Y.presheaf.obj (Opposite.op U)),
          θ.Etale ∧
          θ.comp c_ch = (AlgebraicGeometry.Spec.preimage (hU.fromSpec ≫ g_Y)).hom := by
    intro y W A_ch _ c_ch e hyW hEt_e hComm
    obtain ⟨U, hU, hyU, hUW⟩ := AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hyW
    have hUW' : U ≤ W := hUW
    have _ : AlgebraicGeometry.Etale e := hEt_e
    let e_U : AlgebraicGeometry.Spec (Y.presheaf.obj (Opposite.op U)) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of A_ch) :=
      hU.isoSpec.inv ≫ Y.homOfLE hUW' ≫ e
    have hEt_eU : AlgebraicGeometry.Etale e_U := by
      dsimp only [e_U]
      infer_instance
    let φ_θ : CommRingCat.of A_ch ⟶ Y.presheaf.obj (Opposite.op U) :=
      AlgebraicGeometry.Spec.preimage e_U
    have hEt_map : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map φ_θ) := by
      rw [AlgebraicGeometry.Spec.map_preimage]
      exact hEt_eU
    have hEt_θ : φ_θ.hom.Etale :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.Etale) (φ := φ_θ)).mp hEt_map
    have hSpec_eq : AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_ch ≫ φ_θ) =
        hU.fromSpec ≫ g_Y := by
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage]
      dsimp only [e_U]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, ← hComm,
        ← CategoryTheory.Category.assoc (Y.homOfLE hUW') W.ι g_Y,
        AlgebraicGeometry.Scheme.homOfLE_ι,
        ← CategoryTheory.Category.assoc hU.isoSpec.inv U.ι g_Y,
        AlgebraicGeometry.IsAffineOpen.isoSpec_inv_ι]
    have hPre_eq : CommRingCat.ofHom c_ch ≫ φ_θ =
        AlgebraicGeometry.Spec.preimage (hU.fromSpec ≫ g_Y) := by
      have := congrArg AlgebraicGeometry.Spec.preimage hSpec_eq
      rwa [AlgebraicGeometry.Spec.preimage_map] at this
    have hHom_eq : φ_θ.hom.comp c_ch =
        (AlgebraicGeometry.Spec.preimage (hU.fromSpec ≫ g_Y)).hom :=
      congrArg CommRingCat.Hom.hom hPre_eq
    exact ⟨U, hU, hyU, φ_θ.hom, hEt_θ, hHom_eq⟩
  have hConj1 : ∀ y : ↥Y, ∃ (U : Y.Opens) (hU : AlgebraicGeometry.IsAffineOpen U),
      y ∈ U ∧
      ((∃ θ : Polynomial ↥R →+* ↑(Y.presheaf.obj (Opposite.op U)),
          θ.Etale ∧
          θ.comp Polynomial.C = (AlgebraicGeometry.Spec.preimage (hU.fromSpec ≫ g_Y)).hom) ∨
       (∃ (a : ↥R) (θ : (MvPolynomial (Fin 2) ↥R ⧸
            Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}) →+*
              ↑(Y.presheaf.obj (Opposite.op U))),
          a ≠ 0 ∧ θ.Etale ∧
          θ.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) =
            (AlgebraicGeometry.Spec.preimage (hU.fromSpec ≫ g_Y)).hom)) := by
    intro y
    rcases hSS_Y.2.2.2.2 y with ⟨W, e, hyW, hEt_e, hComm⟩ | ⟨W, a, e, hyW, ha_ne, hEt_e, hComm⟩
    · obtain ⟨U, hU, hyU, θ, hEt_θ, hComm_θ⟩ := hShrink y W Polynomial.C e hyW hEt_e hComm
      exact ⟨U, hU, hyU, Or.inl ⟨θ, hEt_θ, hComm_θ⟩⟩
    · let I_a : Ideal (MvPolynomial (Fin 2) ↥R) :=
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}
      obtain ⟨U, hU, hyU, θ, hEt_θ, hComm_θ⟩ :=
        hShrink y W ((Ideal.Quotient.mk I_a).comp MvPolynomial.C) e hyW hEt_e hComm
      exact ⟨U, hU, hyU, Or.inr ⟨a, θ, ha_ne, hEt_θ, hComm_θ⟩⟩
  have hSurj_res : Function.Surjective (algebraMap ↥R k_R) := by
    intro y
    obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective y
    obtain ⟨⟨r, s⟩, hz⟩ := IsLocalization.surj m_R.primeCompl z
    have hs_unit : IsUnit (s : ↥R) := IsLocalRing.notMem_maximalIdeal.mp s.2
    obtain ⟨s_inv, hs_inv⟩ := hs_unit.exists_right_inv
    refine ⟨r * s_inv, ?_⟩
    change Ideal.Quotient.mk _ (algebraMap ↥R (Localization.AtPrime m_R) (r * s_inv)) =
      Ideal.Quotient.mk _ z
    congr 1
    have hz' : z * algebraMap ↥R (Localization.AtPrime m_R) (s : ↥R) =
        algebraMap ↥R (Localization.AtPrime m_R) r := hz
    calc algebraMap ↥R (Localization.AtPrime m_R) (r * s_inv)
        = algebraMap ↥R _ r * algebraMap ↥R _ s_inv := map_mul _ r s_inv
      _ = z * algebraMap ↥R _ (s : ↥R) * algebraMap ↥R _ s_inv := by rw [hz']
      _ = z * algebraMap ↥R _ ((s : ↥R) * s_inv) := by rw [mul_assoc, ← map_mul]
      _ = z * 1 := by rw [hs_inv, map_one]
      _ = z := mul_one z
  have _ : AlgebraicGeometry.IsClosedImmersion s_R :=
    AlgebraicGeometry.IsClosedImmersion.spec_of_surjective
      (CommRingCat.ofHom (algebraMap ↥R k_R)) hSurj_res
  have hClImm_fst : AlgebraicGeometry.IsClosedImmersion fst_Y := inferInstance
  have hsR_asIdeal : ∀ u : ↥(AlgebraicGeometry.Spec (CommRingCat.of k_R)),
      (s_R.base u).asIdeal = m_R := by
    intro u
    let u' : PrimeSpectrum k_R := u
    have hcomap : (s_R.base u : PrimeSpectrum ↥R) = PrimeSpectrum.comap (algebraMap ↥R k_R) u' := by
      change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥R k_R))).base u = _
      rw [AlgebraicGeometry.Spec.map_base]
      rfl
    change (s_R.base u : PrimeSpectrum ↥R).asIdeal = m_R
    rw [hcomap, PrimeSpectrum.comap_asIdeal]
    have _ : u'.asIdeal.IsPrime := u'.isPrime
    rw [Ideal.eq_bot_of_prime u'.asIdeal]
    exact Ideal.ker_algebraMap_residueField m_R
  have hRange_sR : Set.range s_R.base =
      {q : ↥(AlgebraicGeometry.Spec (CommRingCat.of ↥R)) | q.asIdeal = m_R} := by
    ext q
    constructor
    · rintro ⟨u, rfl⟩
      exact hsR_asIdeal u
    · intro hq
      let u₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of k_R)) := (⊥ : PrimeSpectrum k_R)
      refine ⟨u₀, PrimeSpectrum.ext ?_⟩
      rw [hsR_asIdeal u₀]
      exact hq.symm
  have hRange_fst : Set.range fst_Y.base = {y : ↥Y | (g_Y.base y).asIdeal = m_R} := by
    rw [AlgebraicGeometry.Scheme.Pullback.range_fst g_Y s_R, hRange_sR]
    rfl
  have hPt_asIdeal : ∀ (U : Y.Opens) (hU : AlgebraicGeometry.IsAffineOpen U)
      (p : PrimeSpectrum ↑(Y.presheaf.obj (Opposite.op U))),
      (g_Y.base (hU.fromSpec.base p)).asIdeal =
        Ideal.comap (AlgebraicGeometry.Spec.preimage (hU.fromSpec ≫ g_Y)).hom p.asIdeal := by
    intro U hU p
    have hcomap : g_Y.base (hU.fromSpec.base p) =
        PrimeSpectrum.comap (AlgebraicGeometry.Spec.preimage (hU.fromSpec ≫ g_Y)).hom p := by
      change (hU.fromSpec ≫ g_Y).base p = _
      conv_lhs => rw [← AlgebraicGeometry.Spec.map_preimage (hU.fromSpec ≫ g_Y)]
      rw [AlgebraicGeometry.Spec.map_base]
      rfl
    exact congrArg PrimeSpectrum.asIdeal hcomap
  have hFromSpec_le : ∀ (U : Y.Opens) (hU : AlgebraicGeometry.IsAffineOpen U)
      (p p' : PrimeSpectrum ↑(Y.presheaf.obj (Opposite.op U))),
      hU.fromSpec.base p ∈ closure ({hU.fromSpec.base p'} : Set ↥Y) → p' ≤ p := by
    intro U hU p p' hcl
    rw [PrimeSpectrum.le_iff_mem_closure, mem_closure_iff]
    intro V hV hpV
    have hImg_open : IsOpen (hU.fromSpec.base '' V) :=
      hU.fromSpec.isOpenEmbedding.isOpenMap V hV
    have hp_img : hU.fromSpec.base p ∈ hU.fromSpec.base '' V := ⟨p, hpV, rfl⟩
    obtain ⟨w, hw_img, hw_eq⟩ := mem_closure_iff.mp hcl _ hImg_open hp_img
    rw [Set.mem_singleton_iff] at hw_eq
    obtain ⟨q, hqV, hqp'⟩ := hw_img
    have hq_eq : q = p' := hU.fromSpec.isOpenEmbedding.injective (hqp'.trans hw_eq)
    exact ⟨p', hq_eq ▸ hqV, Set.mem_singleton p'⟩
  refine ⟨hConj1, ⟨hClImm_fst, hRange_fst⟩, ?_⟩
  intro U hU p₁ hp₁_mR hp₁_min
  have _ : AlgebraicGeometry.IsClosedImmersion fst_Y := hClImm_fst
  let z₁ : ↥Y := hU.fromSpec.base p₁
  have hz₁_range : z₁ ∈ Set.range fst_Y.base := by
    rw [hRange_fst]
    change (g_Y.base (hU.fromSpec.base p₁)).asIdeal = m_R
    rw [hPt_asIdeal U hU p₁]
    exact hp₁_mR
  obtain ⟨q₁, hq₁⟩ := hz₁_range
  let E₁ : Set ↥F_R := closure ({q₁} : Set ↥F_R)
  have hE₁_img : fst_Y.base '' E₁ = closure ({z₁} : Set ↥Y) := by
    apply Set.Subset.antisymm
    · calc fst_Y.base '' closure ({q₁} : Set ↥F_R)
          ⊆ closure (fst_Y.base '' ({q₁} : Set ↥F_R)) :=
            image_closure_subset_closure_image fst_Y.continuous
        _ = closure ({z₁} : Set ↥Y) := by
            rw [Set.image_singleton, hq₁]
    · refine closure_minimal ?_ (fst_Y.isClosedEmbedding.isClosedMap _ isClosed_closure)
      rw [Set.singleton_subset_iff]
      exact ⟨q₁, subset_closure (Set.mem_singleton q₁), hq₁⟩
  have hE₁_irrComp : E₁ ∈ irreducibleComponents ↥F_R := by
    refine ⟨(isIrreducible_singleton (x := q₁)).closure, ?_⟩
    intro T hT_irr hE₁_sub
    obtain ⟨ξ, hGen⟩ := QuasiSober.sober hT_irr.closure isClosed_closure
    have hcl_ξ : closure ({ξ} : Set ↥F_R) = closure T := hGen.def
    have hq₁_cl_ξ : q₁ ∈ closure ({ξ} : Set ↥F_R) := by
      rw [hcl_ξ]
      exact subset_closure (hE₁_sub (subset_closure (Set.mem_singleton q₁)))
    have hz₁_cl_ξ : z₁ ∈ closure ({fst_Y.base ξ} : Set ↥Y) := by
      have hmem : z₁ ∈ fst_Y.base '' closure ({ξ} : Set ↥F_R) := ⟨q₁, hq₁_cl_ξ, hq₁⟩
      have hsub := image_closure_subset_closure_image fst_Y.continuous (s := ({ξ} : Set ↥F_R))
      rw [Set.image_singleton] at hsub
      exact hsub hmem
    have hz₁_U : z₁ ∈ (U : Set ↥Y) := by
      rw [← hU.range_fromSpec]
      exact ⟨p₁, rfl⟩
    obtain ⟨w, hw_U, hw_eq⟩ := mem_closure_iff.mp hz₁_cl_ξ (U : Set ↥Y) U.isOpen hz₁_U
    rw [Set.mem_singleton_iff] at hw_eq
    have hξ_range_U : fst_Y.base ξ ∈ Set.range hU.fromSpec.base := by
      rw [hU.range_fromSpec, ← hw_eq]
      exact hw_U
    obtain ⟨p'_spec, hp'_eq⟩ := hξ_range_U
    let p' : PrimeSpectrum ↑(Y.presheaf.obj (Opposite.op U)) := p'_spec
    have hp'_fromSpec : hU.fromSpec.base p' = fst_Y.base ξ := hp'_eq
    have hp'_mR : Ideal.comap (AlgebraicGeometry.Spec.preimage (hU.fromSpec ≫ g_Y)).hom p'.asIdeal = m_R := by
      rw [← hPt_asIdeal U hU p', hp'_fromSpec]
      have hξ_range : fst_Y.base ξ ∈ Set.range fst_Y.base := ⟨ξ, rfl⟩
      rwa [hRange_fst] at hξ_range
    have hp'_le : p' ≤ p₁ := by
      apply hFromSpec_le U hU p₁ p'
      change z₁ ∈ closure ({hU.fromSpec.base p'} : Set ↥Y)
      rwa [hp'_fromSpec]
    have hp'_eq_p₁ : p' = p₁ := hp₁_min p' hp'_mR hp'_le
    have hfst_ξ_eq : fst_Y.base ξ = fst_Y.base q₁ := by
      calc fst_Y.base ξ
          = hU.fromSpec.base p' := hp'_fromSpec.symm
        _ = hU.fromSpec.base p₁ := congrArg hU.fromSpec.base hp'_eq_p₁
        _ = z₁ := rfl
        _ = fst_Y.base q₁ := hq₁.symm
    have hξ_eq : ξ = q₁ := fst_Y.isClosedEmbedding.injective hfst_ξ_eq
    intro t ht
    have ht_cl : t ∈ closure T := subset_closure ht
    rwa [← hcl_ξ, hξ_eq] at ht_cl
  exact ⟨E₁, hE₁_irrComp, hE₁_img⟩

theorem weil_strictlySemistable_higherRank_component_specialization (K : Type u) [Field K] [IsSepClosed K]
    (m : ℕ) (R : ValuationSubring K) (hPkg_R : IsValuationRingAlgPackage m R)
    (hMax_R : IsLocalRing.maximalIdeal ↥R ≠ ⊥)
    (Y : AlgebraicGeometry.Scheme.{u})
    (g_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
    (hSS_Y : IsStrictlySemistableCurveOverValuation R g_Y) :
    let s_R := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.maximalIdeal ↥R).ResidueField))
    (∀ E ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_Y s_R),
      ∀ w₀ : ↥Y, IsClosed ({w₀} : Set ↥Y) →
        (CategoryTheory.Limits.pullback.fst g_Y s_R).base '' E ≠ {w₀}) ∧
    (CompactSpace ↥Y →
      ∀ (Q : PrimeSpectrum ↥R) (F_cl : Set ↥Y),
        IsClosed F_cl →
        ¬ (F_cl ∩ g_Y.base ⁻¹' {Q}).Finite →
        ∃ η_Q ∈ F_cl ∩ g_Y.base ⁻¹' {Q},
          ∀ y' : ↥Y, g_Y.base y' = Q → η_Q ∈ closure ({y'} : Set ↥Y) → y' = η_Q) ∧
    (∀ (η_Q z₀ : ↥Y),
      (g_Y.base η_Q).asIdeal ≠ ⊥ →
      (∀ y' : ↥Y, g_Y.base y' = g_Y.base η_Q → η_Q ∈ closure ({y'} : Set ↥Y) → y' = η_Q) →
      z₀ ∈ closure ({η_Q} : Set ↥Y) →
      (g_Y.base z₀).asIdeal = IsLocalRing.maximalIdeal ↥R →
      ∃ (z₁ : ↥Y) (E₁ : Set ↥(CategoryTheory.Limits.pullback g_Y s_R)),
        z₁ ∈ closure ({η_Q} : Set ↥Y) ∧
        (g_Y.base z₁).asIdeal = IsLocalRing.maximalIdeal ↥R ∧
        E₁ ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_Y s_R) ∧
        (CategoryTheory.Limits.pullback.fst g_Y s_R).base '' E₁ = closure ({z₁} : Set ↥Y)) :=
by
  classical
  intro s_R
  let m_R : Ideal ↥R := IsLocalRing.maximalIdeal ↥R
  have _ : m_R.IsMaximal := IsLocalRing.maximalIdeal.isMaximal ↥R
  have _ : m_R.IsPrime := (IsLocalRing.maximalIdeal.isMaximal ↥R).isPrime
  let k_R : Type u := m_R.ResidueField
  let F_R := CategoryTheory.Limits.pullback g_Y s_R
  let fst_Y := CategoryTheory.Limits.pullback.fst g_Y s_R

  obtain ⟨hAffChart, ⟨hClImm_fst, hRange_fst⟩, hMkComp⟩ :=
    weil_strictlySemistable_affine_chart_and_closedFiber_components K R Y g_Y hSS_Y

  have hSurj_res : Function.Surjective (algebraMap ↥R k_R) := by
    intro y
    obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective y
    obtain ⟨⟨r, s⟩, hz⟩ := IsLocalization.surj m_R.primeCompl z
    have hs_unit : IsUnit (s : ↥R) := IsLocalRing.notMem_maximalIdeal.mp s.2
    obtain ⟨s_inv, hs_inv⟩ := hs_unit.exists_right_inv
    refine ⟨r * s_inv, ?_⟩
    change Ideal.Quotient.mk _ (algebraMap ↥R (Localization.AtPrime m_R) (r * s_inv)) =
      Ideal.Quotient.mk _ z
    congr 1
    have hz' : z * algebraMap ↥R (Localization.AtPrime m_R) (s : ↥R) =
        algebraMap ↥R (Localization.AtPrime m_R) r := hz
    calc algebraMap ↥R (Localization.AtPrime m_R) (r * s_inv)
        = algebraMap ↥R _ r * algebraMap ↥R _ s_inv := map_mul _ r s_inv
      _ = z * algebraMap ↥R _ (s : ↥R) * algebraMap ↥R _ s_inv := by rw [hz']
      _ = z * algebraMap ↥R _ ((s : ↥R) * s_inv) := by rw [mul_assoc, ← map_mul]
      _ = z * 1 := by rw [hs_inv, map_one]
      _ = z := mul_one z

  have hFT_polyC : (Polynomial.C : ↥R →+* Polynomial ↥R).FiniteType := by
    let algP : Algebra ↥R (Polynomial ↥R) := Polynomial.C.toAlgebra
    let G_P : Finset (Polynomial ↥R) := {Polynomial.X}
    let S : @Subalgebra ↥R (Polynomial ↥R) _ _ algP :=
      @Algebra.adjoin ↥R (Polynomial ↥R) _ _ algP (G_P : Set (Polynomial ↥R))
    have hmem : ∀ p : Polynomial ↥R, p ∈ S := by
      intro p
      induction p using Polynomial.induction_on with
      | C r => exact @Subalgebra.algebraMap_mem ↥R (Polynomial ↥R) _ _ algP S r
      | add p q hp hq => exact S.add_mem hp hq
      | monomial n r _ =>
        exact S.mul_mem (@Subalgebra.algebraMap_mem ↥R (Polynomial ↥R) _ _ algP S r)
          (S.pow_mem (@Algebra.subset_adjoin ↥R (Polynomial ↥R) _ _ algP (G_P : Set (Polynomial ↥R))
            Polynomial.X (Finset.mem_coe.mpr (Finset.mem_singleton_self Polynomial.X))) (n + 1))
    exact @Algebra.FiniteType.mk ↥R (Polynomial ↥R) _ _ algP ⟨G_P, top_unique fun p _ => hmem p⟩

  have hFT_mvC : (MvPolynomial.C : ↥R →+* MvPolynomial (Fin 2) ↥R).FiniteType := by
    let algM : Algebra ↥R (MvPolynomial (Fin 2) ↥R) := MvPolynomial.C.toAlgebra
    let G : Finset (MvPolynomial (Fin 2) ↥R) :=
      Finset.univ.image (MvPolynomial.X : Fin 2 → MvPolynomial (Fin 2) ↥R)
    let S : @Subalgebra ↥R (MvPolynomial (Fin 2) ↥R) _ _ algM :=
      @Algebra.adjoin ↥R (MvPolynomial (Fin 2) ↥R) _ _ algM (G : Set (MvPolynomial (Fin 2) ↥R))
    have hmem : ∀ p : MvPolynomial (Fin 2) ↥R, p ∈ S := by
      intro p
      induction p using MvPolynomial.induction_on with
      | C r => exact @Subalgebra.algebraMap_mem ↥R (MvPolynomial (Fin 2) ↥R) _ _ algM S r
      | add p q hp hq => exact S.add_mem hp hq
      | mul_X p i hp =>
        refine S.mul_mem hp (@Algebra.subset_adjoin ↥R (MvPolynomial (Fin 2) ↥R) _ _ algM
          (G : Set (MvPolynomial (Fin 2) ↥R)) (MvPolynomial.X i) ?_)
        exact Finset.mem_coe.mpr (Finset.mem_image_of_mem _ (Finset.mem_univ i))
    exact @Algebra.FiniteType.mk ↥R (MvPolynomial (Fin 2) ↥R) _ _ algM ⟨G, top_unique fun p _ => hmem p⟩

  have hPt_comap : ∀ (U : Y.Opens) (hU : AlgebraicGeometry.IsAffineOpen U)
      (p : PrimeSpectrum ↑(Y.presheaf.obj (Opposite.op U))),
      g_Y.base (hU.fromSpec.base p) =
        PrimeSpectrum.comap (AlgebraicGeometry.Spec.preimage (hU.fromSpec ≫ g_Y)).hom p := by
    intro U hU p
    change (hU.fromSpec ≫ g_Y).base p = _
    conv_lhs => rw [← AlgebraicGeometry.Spec.map_preimage (hU.fromSpec ≫ g_Y)]
    rw [AlgebraicGeometry.Spec.map_base]
    rfl

  have hPt_asIdeal : ∀ (U : Y.Opens) (hU : AlgebraicGeometry.IsAffineOpen U)
      (p : PrimeSpectrum ↑(Y.presheaf.obj (Opposite.op U))),
      (g_Y.base (hU.fromSpec.base p)).asIdeal =
        Ideal.comap (AlgebraicGeometry.Spec.preimage (hU.fromSpec ≫ g_Y)).hom p.asIdeal := by
    intro U hU p
    exact congrArg PrimeSpectrum.asIdeal (hPt_comap U hU p)

  have hFromSpec_le : ∀ (U : Y.Opens) (hU : AlgebraicGeometry.IsAffineOpen U)
      (p p' : PrimeSpectrum ↑(Y.presheaf.obj (Opposite.op U))),
      hU.fromSpec.base p ∈ closure ({hU.fromSpec.base p'} : Set ↥Y) → p' ≤ p := by
    intro U hU p p' hcl
    rw [PrimeSpectrum.le_iff_mem_closure, mem_closure_iff]
    intro V hV hpV
    have hImg_open : IsOpen (hU.fromSpec.base '' V) :=
      hU.fromSpec.isOpenEmbedding.isOpenMap V hV
    have hp_img : hU.fromSpec.base p ∈ hU.fromSpec.base '' V := ⟨p, hpV, rfl⟩
    obtain ⟨w, hw_img, hw_eq⟩ := mem_closure_iff.mp hcl _ hImg_open hp_img
    rw [Set.mem_singleton_iff] at hw_eq
    obtain ⟨q, hqV, hqp'⟩ := hw_img
    have hq_eq : q = p' := hU.fromSpec.isOpenEmbedding.injective (hqp'.trans hw_eq)
    exact ⟨p', hq_eq ▸ hqV, Set.mem_singleton p'⟩

  have hFromSpec_cl : ∀ (U : Y.Opens) (hU : AlgebraicGeometry.IsAffineOpen U)
      (p p' : PrimeSpectrum ↑(Y.presheaf.obj (Opposite.op U))),
      p' ≤ p → hU.fromSpec.base p ∈ closure ({hU.fromSpec.base p'} : Set ↥Y) := by
    intro U hU p p' hle
    have hp_cl : p ∈ closure ({p'} : Set (PrimeSpectrum ↑(Y.presheaf.obj (Opposite.op U)))) :=
      (PrimeSpectrum.le_iff_mem_closure p' p).mp hle
    rw [mem_closure_iff]
    intro V hV hpV
    have hPre_open : IsOpen (hU.fromSpec.base ⁻¹' V) :=
      hV.preimage hU.fromSpec.continuous
    obtain ⟨q, hqV, hq_eq⟩ := mem_closure_iff.mp hp_cl _ hPre_open hpV
    rw [Set.mem_singleton_iff] at hq_eq
    exact ⟨hU.fromSpec.base p', hq_eq ▸ hqV, Set.mem_singleton _⟩

  have hChart_FT : ∀ (U : Y.Opens) (hU : AlgebraicGeometry.IsAffineOpen U),
      ((∃ θ : Polynomial ↥R →+* ↑(Y.presheaf.obj (Opposite.op U)),
          θ.Etale ∧
          θ.comp Polynomial.C = (AlgebraicGeometry.Spec.preimage (hU.fromSpec ≫ g_Y)).hom) ∨
       (∃ (a : ↥R) (θ : (MvPolynomial (Fin 2) ↥R ⧸
            Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}) →+*
              ↑(Y.presheaf.obj (Opposite.op U))),
          a ≠ 0 ∧ θ.Etale ∧
          θ.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) =
            (AlgebraicGeometry.Spec.preimage (hU.fromSpec ≫ g_Y)).hom)) →
      (AlgebraicGeometry.Spec.preimage (hU.fromSpec ≫ g_Y)).hom.FiniteType := by
    intro U hU hCh
    rcases hCh with ⟨θ, hEt_θ, hComm_θ⟩ | ⟨a, θ, _, hEt_θ, hComm_θ⟩
    · rw [← hComm_θ]
      have hFT_θ : θ.FiniteType := by
        let _ : Algebra (Polynomial ↥R) ↑(Y.presheaf.obj (Opposite.op U)) := θ.toAlgebra
        have _ : Algebra.Etale (Polynomial ↥R) ↑(Y.presheaf.obj (Opposite.op U)) :=
          RingHom.Etale.toAlgebra hEt_θ
        exact (inferInstance : Algebra.FiniteType (Polynomial ↥R) ↑(Y.presheaf.obj (Opposite.op U)))
      exact RingHom.FiniteType.comp hFT_θ hFT_polyC
    · rw [← hComm_θ]
      have hFT_θ : θ.FiniteType := by
        let _ : Algebra (MvPolynomial (Fin 2) ↥R ⧸
            Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a})
          ↑(Y.presheaf.obj (Opposite.op U)) := θ.toAlgebra
        have _ : Algebra.Etale (MvPolynomial (Fin 2) ↥R ⧸
            Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a})
          ↑(Y.presheaf.obj (Opposite.op U)) := RingHom.Etale.toAlgebra hEt_θ
        exact (inferInstance : Algebra.FiniteType (MvPolynomial (Fin 2) ↥R ⧸
          Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a})
          ↑(Y.presheaf.obj (Opposite.op U)))
      have hFT_mk : (Ideal.Quotient.mk
          (Ideal.span {MvPolynomial.X (0 : Fin 2) * MvPolynomial.X 1 - MvPolynomial.C a})).FiniteType :=
        RingHom.FiniteType.of_surjective _ Ideal.Quotient.mk_surjective
      exact RingHom.FiniteType.comp hFT_θ (RingHom.FiniteType.comp hFT_mk hFT_mvC)

  have hDichot_of_chart : ∀ (U : Y.Opens) (hU : AlgebraicGeometry.IsAffineOpen U)
      (Q : PrimeSpectrum ↥R),
      let γ_B : ↥R →+* ↑(Y.presheaf.obj (Opposite.op U)) :=
        (AlgebraicGeometry.Spec.preimage (hU.fromSpec ≫ g_Y)).hom
      letI : Algebra ↥R ↑(Y.presheaf.obj (Opposite.op U)) := γ_B.toAlgebra
      ((∃ θ : Polynomial ↥R →+* ↑(Y.presheaf.obj (Opposite.op U)),
          θ.Etale ∧ θ.comp Polynomial.C = γ_B) ∨
       (∃ (a : ↥R) (θ : (MvPolynomial (Fin 2) ↥R ⧸
            Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}) →+*
              ↑(Y.presheaf.obj (Opposite.op U))),
          a ≠ 0 ∧ θ.Etale ∧ θ.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) = γ_B)) →
      (∀ Z : Set (PrimeSpectrum (Q.asIdeal.Fiber ↑(Y.presheaf.obj (Opposite.op U)))),
        IsClosed Z →
        (∀ q ∈ Z, q.asIdeal ∉ minimalPrimes (Q.asIdeal.Fiber ↑(Y.presheaf.obj (Opposite.op U)))) →
        Z.Finite) ∧
      (∀ (p : PrimeSpectrum ↑(Y.presheaf.obj (Opposite.op U)))
         (hp : PrimeSpectrum.comap (algebraMap ↥R ↑(Y.presheaf.obj (Opposite.op U))) p = Q),
        (PrimeSpectrum.preimageHomeomorphFiber ↥R ↑(Y.presheaf.obj (Opposite.op U)) Q ⟨p, hp⟩).asIdeal ∉
          minimalPrimes (Q.asIdeal.Fiber ↑(Y.presheaf.obj (Opposite.op U))) →
        ∀ x : p.asIdeal.ResidueField,
          @IsAlgebraic Q.asIdeal.ResidueField p.asIdeal.ResidueField _ _
            (Ideal.ResidueField.map Q.asIdeal p.asIdeal
              (algebraMap ↥R ↑(Y.presheaf.obj (Opposite.op U)))
              (congrArg PrimeSpectrum.asIdeal hp.symm)).toAlgebra x) := by
    intro U hU Q γ_B hCh
    let _ : Algebra ↥R ↑(Y.presheaf.obj (Opposite.op U)) := γ_B.toAlgebra
    have _ : Algebra.FiniteType ↥R ↑(Y.presheaf.obj (Opposite.op U)) := hChart_FT U hU hCh
    let ι₁ : ↑(Y.presheaf.obj (Opposite.op U)) →+*
        Localization.Away (1 : ↑(Y.presheaf.obj (Opposite.op U))) :=
      algebraMap _ _
    have hBij_ι₁ : Function.Bijective ι₁ :=
      (IsLocalization.atOne ↑(Y.presheaf.obj (Opposite.op U))
        (Localization.Away (1 : ↑(Y.presheaf.obj (Opposite.op U))))).bijective
    have hEt_ι₁ : ι₁.Etale := RingHom.Etale.of_bijective hBij_ι₁
    rcases hCh with ⟨θ, hEt_θ, hComm_θ⟩ | ⟨a, θ, ha_ne, hEt_θ, hComm_θ⟩
    · have hRes := weil_semistable_algebra_fiber_dichotomy_and_finiteness
        K R ↑(Y.presheaf.obj (Opposite.op U)) Q ?_
      · exact ⟨hRes.2.1, hRes.2.2⟩
      · intro p
        refine ⟨1, p.isPrime.one_notMem, Or.inl ⟨ι₁.comp θ, ?_, ?_⟩⟩
        · exact RingHom.Etale.stableUnderComposition _ _ hEt_θ hEt_ι₁
        · rw [RingHom.comp_assoc, hComm_θ]; rfl
    · have hRes := weil_semistable_algebra_fiber_dichotomy_and_finiteness
        K R ↑(Y.presheaf.obj (Opposite.op U)) Q ?_
      · exact ⟨hRes.2.1, hRes.2.2⟩
      · intro p
        refine ⟨1, p.isPrime.one_notMem, Or.inr ⟨a, ι₁.comp θ, ha_ne, ?_, ?_⟩⟩
        · exact RingHom.Etale.stableUnderComposition _ _ hEt_θ hEt_ι₁
        · rw [RingHom.comp_assoc, hComm_θ]; rfl

  have hChartMin_of_min : ∀ (U : Y.Opens) (hU : AlgebraicGeometry.IsAffineOpen U)
      (y : ↥Y) (hy : y ∈ U)
      (hMin_y : ∀ y' : ↥Y, g_Y.base y' = g_Y.base y → y ∈ closure ({y'} : Set ↥Y) → y' = y)
      {A_ch : Type u} [CommRing A_ch] (c_ch : ↥R →+* A_ch)
      (θ : A_ch →+* ↑(Y.presheaf.obj (Opposite.op U))),
      θ.Etale →
      θ.comp c_ch = (AlgebraicGeometry.Spec.preimage (hU.fromSpec ≫ g_Y)).hom →
      ∀ p₀ : Ideal A_ch, p₀.IsPrime →
        Ideal.comap c_ch p₀ = (g_Y.base y).asIdeal →
        p₀ ≤ Ideal.comap θ (hU.primeIdealOf ⟨y, hy⟩).asIdeal →
        p₀ = Ideal.comap θ (hU.primeIdealOf ⟨y, hy⟩).asIdeal := by
    intro U hU y hy hMin_y A_ch _ c_ch θ hEt_θ hComm_θ p₀ hp₀_pr hp₀_comap hp₀_le
    let q_y : PrimeSpectrum ↑(Y.presheaf.obj (Opposite.op U)) := hU.primeIdealOf ⟨y, hy⟩
    have _ : q_y.asIdeal.IsPrime := q_y.isPrime
    let p_y : Ideal A_ch := Ideal.comap θ q_y.asIdeal
    have _ : p_y.IsPrime := Ideal.IsPrime.comap θ
    have _ : p₀.IsPrime := hp₀_pr
    let _ : Algebra A_ch ↑(Y.presheaf.obj (Opposite.op U)) := θ.toAlgebra
    have _ : Algebra.Etale A_ch ↑(Y.presheaf.obj (Opposite.op U)) := RingHom.Etale.toAlgebra hEt_θ
    have _ : Algebra.HasGoingDown A_ch ↑(Y.presheaf.obj (Opposite.op U)) :=
      Algebra.HasGoingDown.of_flat
    have _ : q_y.asIdeal.LiesOver p_y := ⟨rfl⟩
    obtain ⟨q₀, hq₀_le, hq₀_pr, hq₀_over⟩ :=
      Ideal.exists_ideal_le_liesOver_of_le (p := p₀) (q := p_y) q_y.asIdeal hp₀_le
    let p'_0 : PrimeSpectrum ↑(Y.presheaf.obj (Opposite.op U)) := ⟨q₀, hq₀_pr⟩
    let y' : ↥Y := hU.fromSpec.base p'_0
    have hy'_Q : g_Y.base y' = g_Y.base y := by
      apply PrimeSpectrum.ext
      rw [hPt_asIdeal U hU p'_0, ← hComm_θ, ← Ideal.comap_comap]
      have hover : p₀ = Ideal.comap θ q₀ := hq₀_over.over
      rw [← hover, hp₀_comap]
    have hqy_eq : hU.fromSpec.base q_y = y := hU.fromSpec_primeIdealOf ⟨y, hy⟩
    have hy_cl : y ∈ closure ({y'} : Set ↥Y) := by
      rw [← hqy_eq]
      exact hFromSpec_cl U hU q_y p'_0 hq₀_le
    have hy'_eq : y' = y := hMin_y y' hy'_Q hy_cl
    have hp'_eq : p'_0 = q_y :=
      hU.fromSpec.isOpenEmbedding.injective (hy'_eq.trans hqy_eq.symm)
    have hq₀_eq : q₀ = q_y.asIdeal := congrArg PrimeSpectrum.asIdeal hp'_eq
    exact hq₀_over.over.trans (congrArg (Ideal.comap θ) hq₀_eq)

  refine ⟨?_, ?_, ?_⟩
  · 
    intro E hE w₀ hw₀_cl hImg
    have _ : AlgebraicGeometry.IsClosedImmersion fst_Y := hClImm_fst
    obtain ⟨q₀, hq₀E⟩ := hE.1.nonempty
    have hq₀_w₀ : fst_Y.base q₀ = w₀ := by
      have hm : fst_Y.base q₀ ∈ ({w₀} : Set ↥Y) := hImg ▸ ⟨q₀, hq₀E, rfl⟩
      exact Set.mem_singleton_iff.mp hm
    have hInj_fst : Function.Injective fst_Y.base := fst_Y.isClosedEmbedding.injective
    have hE_sub : E ⊆ ({q₀} : Set ↥F_R) := by
      intro q hq
      rw [Set.mem_singleton_iff]
      apply hInj_fst
