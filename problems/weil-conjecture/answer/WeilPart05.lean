          · exact ⟨i_Z, by rw [hBset_Z]; exact ⟨u, huE, rfl⟩⟩
          · refine ⟨i_Z.succAbove i'_p, ?_⟩
            change u ∈ j_1.base ⁻¹' (B_set (i_Z.succAbove i'_p))
