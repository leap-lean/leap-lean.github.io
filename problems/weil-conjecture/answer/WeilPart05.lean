    (hAff_WB : AlgebraicGeometry.IsAffine W_B_sch)
    (hInt_WB : AlgebraicGeometry.IsIntegral W_B_sch)
    (hEt_e0 : AlgebraicGeometry.Etale e_0)
    (he0_comm : e_0 ≫ g_M0 = g_WB) :
    (∀ (F_0 F_WB : Type u) [Field F_0] [Field F_WB]
       (η_M0 : AlgebraicGeometry.Spec (CommRingCat.of F_0) ⟶ M_0)
       (η_WB : AlgebraicGeometry.Spec (CommRingCat.of F_WB) ⟶ W_B_sch)
       (φ_KF0 : K →+* F_0) (φ_F0_FWB : F_0 →+* F_WB),
      IsSchemeFunctionField W_B_sch F_WB η_WB →
      η_M0 ≫ g_M0 = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_KF0.comp R.subtype)) →
      η_WB ≫ e_0 = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_F0_FWB) ≫ η_M0 →
      ∀ (M_T : AlgebraicGeometry.Scheme.{u})
        (g_MT : M_T ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
        (f_MT : M_T ⟶ M_0)
        (η_MT : AlgebraicGeometry.Spec (CommRingCat.of F_0) ⟶ M_T)
        (Z_MT : Set ↥M_0) (hZ_MT_cl : IsClosed Z_MT),
        IsStrictlySemistableCurveOverValuation R g_MT →
        AlgebraicGeometry.IsProper f_MT →
        f_MT ≫ g_M0 = g_MT →
        η_MT ≫ f_MT = η_M0 →
        CategoryTheory.IsIso (f_MT ∣_ (⟨Z_MTᶜ, hZ_MT_cl.isOpen_compl⟩ : M_0.Opens)) →
        (∀ y ∈ Z_MT, (g_M0.base y).asIdeal ≠ ⊥) →
        ∀ (hη_comm : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_F0_FWB) ≫ η_MT) ≫ f_MT =
            η_WB ≫ e_0),
        let X_T := CategoryTheory.Limits.pullback f_MT e_0
        let f_XT := CategoryTheory.Limits.pullback.snd f_MT e_0
        let g_XT := f_XT ≫ g_WB
        let η_XT : AlgebraicGeometry.Spec (CommRingCat.of F_WB) ⟶ X_T :=
          CategoryTheory.Limits.pullback.lift
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_F0_FWB) ≫ η_MT) η_WB hη_comm
        IsStrictlySemistableCurveOverValuation R g_XT ∧
        AlgebraicGeometry.IsProper f_XT ∧
        IsSchemeFunctionField X_T F_WB η_XT ∧
        η_XT ≫ f_XT = η_WB ∧
        (∃ U_XT : W_B_sch.Opens, Nonempty ↥U_XT ∧ CategoryTheory.IsIso (f_XT ∣_ U_XT)) ∧
        (∀ (Z_mod : Set ↥W_B_sch) (hZ_closed : IsClosed Z_mod),
          e_0.base ⁻¹' Z_MT ⊆ Z_mod →
          CategoryTheory.IsIso
            (f_XT ∣_ (⟨Z_modᶜ, hZ_closed.isOpen_compl⟩ : W_B_sch.Opens)))) ∧
    (∀ (X_0_sch M_tilde M' : AlgebraicGeometry.Scheme.{u})
       (f_0 : X_0_sch ⟶ W_B_sch)
       (g_tilde : M_tilde ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
       (g'_M : M' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
       (f'_M : M' ⟶ M_0)
       (q_M : M_tilde ⟶ M')
       (Mod_qM : Set ↥M') (hMod_qM_cl : IsClosed Mod_qM)
       (isLeaf : Prop)
       (Φ : X_0_sch ≅ CategoryTheory.Limits.pullback (q_M ≫ f'_M) e_0),
      AlgebraicGeometry.IsIntegral X_0_sch →
      AlgebraicGeometry.Flat g_tilde →
      IsStrictlySemistableCurveOverValuation R g'_M →
      f'_M ≫ g_M0 = g'_M →
      (q_M ≫ f'_M) ≫ g_M0 = g_tilde →
      AlgebraicGeometry.IsProper q_M →
      AlgebraicGeometry.IsProper f'_M →
      AlgebraicGeometry.Surjective q_M →
      CategoryTheory.IsIso (q_M ∣_ (⟨Mod_qMᶜ, hMod_qM_cl.isOpen_compl⟩ : M'.Opens)) →
      (∀ z ∈ Mod_qM, (g'_M.base z).asIdeal ≠ ⊥) →
      (isLeaf → ∀ z ∈ Mod_qM, ∃ V_sm : M'.Opens,
        z ∈ V_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ g'_M)) →
      Φ.hom ≫ CategoryTheory.Limits.pullback.snd (q_M ≫ f'_M) e_0 = f_0 →
      let X'_0 := CategoryTheory.Limits.pullback f'_M e_0
      let π'_M := CategoryTheory.Limits.pullback.fst f'_M e_0
      let f'_0 := CategoryTheory.Limits.pullback.snd f'_M e_0
      let g'_0 := f'_0 ≫ g_WB
      let q_pb : CategoryTheory.Limits.pullback (q_M ≫ f'_M) e_0 ⟶ X'_0 :=
        CategoryTheory.Limits.pullback.map (q_M ≫ f'_M) e_0 f'_M e_0 q_M (𝟙 _) (𝟙 _)
          (CategoryTheory.Category.comp_id (q_M ≫ f'_M))
          ((CategoryTheory.Category.comp_id e_0).trans (CategoryTheory.Category.id_comp e_0).symm)
      let q_0 := Φ.hom ≫ q_pb
      let Mod_q0 : Set ↥X'_0 := π'_M.base ⁻¹' Mod_qM
      let hMod_closed : IsClosed Mod_q0 := hMod_qM_cl.preimage π'_M.continuous
      IsStrictlySemistableCurveOverValuation R g'_0 ∧
      q_0 ≫ f'_0 = f_0 ∧
      f'_0 ≫ g_WB = g'_0 ∧
      AlgebraicGeometry.IsProper q_0 ∧
      AlgebraicGeometry.IsProper f'_0 ∧
      AlgebraicGeometry.Surjective q_0 ∧
      CategoryTheory.IsIso (q_0 ∣_ (⟨Mod_q0ᶜ, hMod_closed.isOpen_compl⟩ : X'_0.Opens)) ∧
      (isLeaf → ∀ z ∈ Mod_q0, ∃ V_sm : X'_0.Opens,
        z ∈ V_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ g'_0))) :=
by
  classical
  let botPt : ∀ (D : Type u) [CommRing D] [IsDomain D], PrimeSpectrum D :=
    fun D _ _ => ⟨⊥, ⟨bot_ne_top, fun {a b} hab => by
      simp only [Ideal.mem_bot] at hab ⊢
      exact mul_eq_zero.mp hab⟩⟩
  let p_bot : PrimeSpectrum ↥R := botPt ↥R

  
  have h_s1 : ∀ (M X : AlgebraicGeometry.Scheme.{u})
      (g_M : M ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
      (g_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
      (π : X ⟶ M) (U_int : X.Opens),
      IsStrictlySemistableCurveOverValuation R g_M →
      AlgebraicGeometry.Etale π →
      AlgebraicGeometry.IsSeparated g_X →
      π ≫ g_M = g_X →
      Nonempty ↥U_int →
      AlgebraicGeometry.IsIntegral U_int.toScheme →
      (∀ x : ↥X, (g_X.base x).asIdeal = ⊥ → x ∈ U_int) →
      IsStrictlySemistableCurveOverValuation R g_X := by
    intro M X g_M g_X π U_int hSS_M hEt_π hSep_gX hπ_comm hNe_U hInt_U hGen_sub
    obtain ⟨_hInt_M, hFlat_M, _hSep_M, hLfp_M, hCharts_M⟩ := hSS_M
    have hFlat_X : AlgebraicGeometry.Flat g_X := by rw [← hπ_comm]; infer_instance
    have hLfp_X : AlgebraicGeometry.LocallyOfFinitePresentation g_X := by
      rw [← hπ_comm]; infer_instance
    
    have hIrred_U : IrreducibleSpace ↥U_int.toScheme :=
      @AlgebraicGeometry.irreducibleSpace_of_isIntegral U_int.toScheme hInt_U
    have hPre_U : IsPreirreducible (U_int : Set ↥X) := by
      have h1 := hIrred_U.isPreirreducible_univ.image U_int.ι.base U_int.ι.continuous.continuousOn
      rwa [Set.image_univ, AlgebraicGeometry.Scheme.Opens.range_ι] at h1
    have hDense_U : closure (U_int : Set ↥X) = Set.univ := by
      apply Set.eq_univ_of_forall
      intro x
      have hcl : g_X.base x ∈ closure ({p_bot} : Set (PrimeSpectrum ↥R)) :=
        (PrimeSpectrum.le_iff_mem_closure p_bot (g_X.base x)).mp
          (bot_le : (⊥ : Ideal ↥R) ≤ (g_X.base x).asIdeal)
      have hspec_base : Specializes p_bot (g_X.base x) := specializes_iff_mem_closure.mpr hcl
      obtain ⟨x₀, hx₀_spec, hx₀_eq⟩ := AlgebraicGeometry.Flat.generalizingMap g_X hspec_base
      have hx₀_bot : (g_X.base x₀).asIdeal = ⊥ := congrArg PrimeSpectrum.asIdeal hx₀_eq
      have hx₀_mem : x₀ ∈ (U_int : Set ↥X) := hGen_sub x₀ hx₀_bot
      exact closure_mono (Set.singleton_subset_iff.mpr hx₀_mem)
        (specializes_iff_mem_closure.mp hx₀_spec)
    obtain ⟨u₀, _⟩ := hNe_U
    have hNonempty_X : Nonempty ↥X := ⟨u₀⟩
    have hPreSpace_X : PreirreducibleSpace ↥X := ⟨by rw [← hDense_U]; exact hPre_U.closure⟩
    have hIrred_X : IrreducibleSpace ↥X := { toNonempty := hNonempty_X }
    
    have hRed_X : AlgebraicGeometry.IsReduced X := by
      refine @AlgebraicGeometry.IsReduced.of_openCover X X.affineCover (fun i => ?_)
      let Y : AlgebraicGeometry.Scheme.{u} := X.affineCover.X i
      let j_Y : Y ⟶ X := X.affineCover.f i
      by_cases hY_ne : Nonempty ↥Y
      · obtain ⟨y₁⟩ := hY_ne
        have : Nonempty ↥Y := ⟨y₁⟩
        let R_Y : CommRingCat.{u} := Y.presheaf.obj (Opposite.op ⊤)
        let A : Type u := ↑R_Y
        let iso_Y : Y ≅ AlgebraicGeometry.Spec R_Y := Y.isoSpec
        let z₁ : PrimeSpectrum A := iso_Y.hom.base y₁
        have h10_A : (1 : A) ≠ 0 := fun h10 =>
          z₁.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr (h10 ▸ z₁.asIdeal.zero_mem))
        have : Nontrivial A := ⟨⟨1, 0, h10_A⟩⟩
        let f_A : AlgebraicGeometry.Spec R_Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R) :=
          iso_Y.inv ≫ j_Y ≫ g_X
        have : AlgebraicGeometry.Flat f_A := by dsimp [f_A]; infer_instance
        let φ_RA : CommRingCat.of ↥R ⟶ R_Y := AlgebraicGeometry.Spec.preimage f_A
        have hFlat_φ : φ_RA.hom.Flat := by
          rw [← AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Flat),
            AlgebraicGeometry.Spec.map_preimage]
          infer_instance
        letI : Algebra ↥R A := φ_RA.hom.toAlgebra
        have hSpec_alg : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥R A)) = f_A :=
          AlgebraicGeometry.Spec.map_preimage f_A
        have : Module.Flat ↥R A := RingHom.flat_algebraMap_iff.mp hFlat_φ
        have hinj_lTensor : Function.Injective (LinearMap.lTensor A (Algebra.linearMap ↥R K)) :=
          Module.Flat.lTensor_preserves_injective_linearMap (M := A)
            (Algebra.linearMap ↥R K) Subtype.val_injective
        let toAK : A →+* TensorProduct ↥R A K := Algebra.TensorProduct.includeLeftRingHom
        have hinj_AK : Function.Injective toAK := by
          intro a₁ a₂ heq
          have ht : (LinearMap.lTensor A (Algebra.linearMap ↥R K)) (a₁ ⊗ₜ[↥R] (1 : ↥R)) =
              (LinearMap.lTensor A (Algebra.linearMap ↥R K)) (a₂ ⊗ₜ[↥R] (1 : ↥R)) := by
            simpa [toAK, LinearMap.lTensor_tmul, Algebra.linearMap_apply, map_one] using heq
          have ht' := hinj_lTensor ht
          simpa using congrArg (TensorProduct.rid ↥R A) ht'
        have : Nontrivial (TensorProduct ↥R A K) :=
          ⟨⟨1, 0, fun h => one_ne_zero (hinj_AK (by rw [map_one, map_zero]; exact h))⟩⟩
        let η_R := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥R K))
        have : AlgebraicGeometry.IsOpenImmersion η_R := hOpen_ηR
        let iso_P := AlgebraicGeometry.pullbackSpecIso ↥R A K
        let fst_P := CategoryTheory.Limits.pullback.fst
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥R A))) η_R
        let snd_P := CategoryTheory.Limits.pullback.snd
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥R A))) η_R
        have : AlgebraicGeometry.IsOpenImmersion fst_P :=
          CategoryTheory.MorphismProperty.pullback_fst _ _ hOpen_ηR
        let ι_AK : AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct ↥R A K)) ⟶ X :=
          iso_P.inv ≫ fst_P ≫ iso_Y.inv ≫ j_Y
        have : AlgebraicGeometry.IsOpenImmersion ι_AK := by dsimp [ι_AK]; infer_instance
        have hRange_AK : Set.range ι_AK.base ⊆ Set.range U_int.ι.base := by
          rw [AlgebraicGeometry.Scheme.Opens.range_ι]
          rintro _ ⟨p, rfl⟩
          apply hGen_sub
          have hcomm_AK : ι_AK ≫ g_X = iso_P.inv ≫ snd_P ≫ η_R := by
            have hfA_eq : iso_P.inv ≫ fst_P ≫ f_A =
                iso_P.inv ≫ fst_P ≫
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥R A)) :=
              congrArg (fun k => iso_P.inv ≫ fst_P ≫ k) hSpec_alg.symm
            calc ι_AK ≫ g_X
                = iso_P.inv ≫ fst_P ≫ f_A := by
                    simp only [ι_AK, f_A, CategoryTheory.Category.assoc]
              _ = iso_P.inv ≫ (fst_P ≫
                    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥R A))) := hfA_eq
              _ = iso_P.inv ≫ snd_P ≫ η_R := by
                    rw [CategoryTheory.Limits.pullback.condition]
          change ((ι_AK ≫ g_X).base p).asIdeal = ⊥
          rw [hcomm_AK]
          let q_K : PrimeSpectrum K := (iso_P.inv ≫ snd_P).base p
          have hqK_eq : q_K = botPt K := Subsingleton.elim _ _
          change (η_R.base q_K).asIdeal = ⊥
          rw [hqK_eq]
          change Ideal.comap R.subtype (⊥ : Ideal K) = ⊥
          ext r
          simp only [Ideal.mem_comap, Ideal.mem_bot]
          exact ⟨fun h => Subtype.ext h, fun h => by rw [h, map_zero]⟩
        let ι_AKU : AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct ↥R A K)) ⟶
            U_int.toScheme :=
          AlgebraicGeometry.IsOpenImmersion.lift U_int.ι ι_AK hRange_AK
        have hfac_AKU : ι_AKU ≫ U_int.ι = ι_AK :=
          AlgebraicGeometry.IsOpenImmersion.lift_fac U_int.ι ι_AK hRange_AK
        have : AlgebraicGeometry.IsOpenImmersion (ι_AKU ≫ U_int.ι) := by
          rw [hfac_AKU]; infer_instance
        have : AlgebraicGeometry.IsOpenImmersion ι_AKU :=
          AlgebraicGeometry.IsOpenImmersion.of_comp ι_AKU U_int.ι
        have hNe_SpecAK :
            Nonempty ↥(AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct ↥R A K))) := by
          change Nonempty (PrimeSpectrum (TensorProduct ↥R A K))
          infer_instance
        have : AlgebraicGeometry.IsIntegral
            (AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct ↥R A K))) :=
          AlgebraicGeometry.isIntegral_of_isOpenImmersion ι_AKU
        obtain ⟨p_AK⟩ := hNe_SpecAK
        let T_top : (AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct ↥R A K))).Opens := ⊤
        have : Nonempty T_top := ⟨⟨p_AK, trivial⟩⟩
        have hDom_top : IsDomain ↑((AlgebraicGeometry.Spec
            (CommRingCat.of (TensorProduct ↥R A K))).presheaf.obj (Opposite.op T_top)) :=
          @AlgebraicGeometry.IsIntegral.component_integral _ _ T_top _
        let isoΓ := AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (TensorProduct ↥R A K))
        have hinj_Γ : Function.Injective isoΓ.inv.hom :=
          (ConcreteCategory.bijective_of_isIso isoΓ.inv).1
        have : IsDomain (TensorProduct ↥R A K) :=
          Function.Injective.isDomain isoΓ.inv.hom hinj_Γ
        have : IsDomain A := Function.Injective.isDomain toAK hinj_AK
        have : AlgebraicGeometry.IsIntegral Y :=
          AlgebraicGeometry.isIntegral_of_isAffine_of_isDomain Y
        infer_instance
      · have : IsEmpty ↥Y := not_nonempty_iff.mp hY_ne
        exact @AlgebraicGeometry.isReduced_of_isReduced_stalk Y (fun x => isEmptyElim x)
    have hInt_X : AlgebraicGeometry.IsIntegral X :=
      AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced X
    refine ⟨hInt_X, hFlat_X, hSep_gX, hLfp_X, fun y => ?_⟩
    rcases hCharts_M (π.base y) with ⟨W_M, e_M, hy_M, hEt_eM, hComm_M⟩ |
      ⟨W_M, a, e_M, hy_M, ha_ne, hEt_eM, hComm_M⟩
    · left
      let W_X : X.Opens := (TopologicalSpace.Opens.map π.base).obj W_M
      have : AlgebraicGeometry.Etale (π ∣_ W_M) :=
        CategoryTheory.MorphismProperty.of_isPullback
          (AlgebraicGeometry.isPullback_morphismRestrict π W_M).flip hEt_π
      refine ⟨W_X, (π ∣_ W_M) ≫ e_M, hy_M, inferInstance, ?_⟩
      rw [← hπ_comm, ← AlgebraicGeometry.morphismRestrict_ι_assoc, hComm_M,
        CategoryTheory.Category.assoc]
    · right
      let W_X : X.Opens := (TopologicalSpace.Opens.map π.base).obj W_M
      have : AlgebraicGeometry.Etale (π ∣_ W_M) :=
        CategoryTheory.MorphismProperty.of_isPullback
          (AlgebraicGeometry.isPullback_morphismRestrict π W_M).flip hEt_π
      refine ⟨W_X, a, (π ∣_ W_M) ≫ e_M, hy_M, ha_ne, inferInstance, ?_⟩
      rw [← hπ_comm, ← AlgebraicGeometry.morphismRestrict_ι_assoc, hComm_M,
        CategoryTheory.Category.assoc]

  
  have h_s2_iso : ∀ {P X Y S : AlgebraicGeometry.Scheme.{u}}
      {fst : P ⟶ X} {snd : P ⟶ Y} {f : X ⟶ S} {g : Y ⟶ S},
      CategoryTheory.IsPullback fst snd f g →
      ∀ (U : S.Opens) (V : Y.Opens),
        CategoryTheory.IsIso (f ∣_ U) →
        V ≤ (TopologicalSpace.Opens.map g.base).obj U →
        CategoryTheory.IsIso (snd ∣_ V) := by
    intro P X Y S fst snd f g hPb U V hIso hV
    let W_P : P.Opens := (TopologicalSpace.Opens.map snd.base).obj V
    let U_X : X.Opens := (TopologicalSpace.Opens.map f.base).obj U
    have hWP : W_P ≤ (TopologicalSpace.Opens.map fst.base).obj U_X := by
      intro p hp
      have hpV : snd.base p ∈ V := hp
      have hgU : g.base (snd.base p) ∈ U := hV hpV
      change f.base (fst.base p) ∈ U
      have heq : f.base (fst.base p) = g.base (snd.base p) :=
        congrArg (fun k => k.base p) hPb.w
      rwa [heq]
    have hPb_paste : CategoryTheory.IsPullback (W_P.ι ≫ fst) (snd ∣_ V) f (V.ι ≫ g) :=
      (AlgebraicGeometry.isPullback_morphismRestrict snd V).flip.paste_horiz hPb
    have hPb_outer : CategoryTheory.IsPullback
        (fst.resLE U_X W_P hWP ≫ U_X.ι) (snd ∣_ V) f (g.resLE U V hV ≫ U.ι) := by
      rwa [AlgebraicGeometry.Scheme.Hom.resLE_comp_ι,
        AlgebraicGeometry.Scheme.Hom.resLE_comp_ι]
    have hPb_right : CategoryTheory.IsPullback U_X.ι (f ∣_ U) f U.ι :=
      (AlgebraicGeometry.isPullback_morphismRestrict f U).flip
    have h_mid : fst.resLE U_X W_P hWP ≫ (f ∣_ U) = (snd ∣_ V) ≫ g.resLE U V hV := by
      apply (CategoryTheory.cancel_mono U.ι).mp
      rw [CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
        AlgebraicGeometry.Scheme.Hom.resLE_comp_ι_assoc, hPb.w,
        CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.Hom.resLE_comp_ι,
        AlgebraicGeometry.morphismRestrict_ι_assoc]
    have hPb_res := CategoryTheory.IsPullback.of_right hPb_outer h_mid hPb_right
    exact hPb_res.isIso_snd_of_isIso

  
  have h_s2_pb : ∀ {M_tilde M' : AlgebraicGeometry.Scheme.{u}}
      (q_M : M_tilde ⟶ M') (f'_M : M' ⟶ M_0),
      let q_pb : CategoryTheory.Limits.pullback (q_M ≫ f'_M) e_0 ⟶
          CategoryTheory.Limits.pullback f'_M e_0 :=
        CategoryTheory.Limits.pullback.map (q_M ≫ f'_M) e_0 f'_M e_0 q_M (𝟙 _) (𝟙 _)
          (CategoryTheory.Category.comp_id (q_M ≫ f'_M))
          ((CategoryTheory.Category.comp_id e_0).trans (CategoryTheory.Category.id_comp e_0).symm)
      CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst (q_M ≫ f'_M) e_0) q_pb
        q_M (CategoryTheory.Limits.pullback.fst f'_M e_0) := by
    intro M_tilde M' q_M f'_M q_pb
    have h_fst : q_pb ≫ CategoryTheory.Limits.pullback.fst f'_M e_0 =
        CategoryTheory.Limits.pullback.fst (q_M ≫ f'_M) e_0 ≫ q_M := by
      dsimp [q_pb, CategoryTheory.Limits.pullback.map]
      rw [CategoryTheory.Limits.pullback.lift_fst]
    have h_snd : q_pb ≫ CategoryTheory.Limits.pullback.snd f'_M e_0 =
        CategoryTheory.Limits.pullback.snd (q_M ≫ f'_M) e_0 := by
      dsimp [q_pb, CategoryTheory.Limits.pullback.map]
      rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.comp_id]
    have h_outer : CategoryTheory.IsPullback
        (q_pb ≫ CategoryTheory.Limits.pullback.snd f'_M e_0)
        (CategoryTheory.Limits.pullback.fst (q_M ≫ f'_M) e_0) e_0 (q_M ≫ f'_M) := by
      rw [h_snd]
      exact (CategoryTheory.IsPullback.of_hasPullback (q_M ≫ f'_M) e_0).flip
    have h_right : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.snd f'_M e_0)
        (CategoryTheory.Limits.pullback.fst f'_M e_0) e_0 f'_M :=
      (CategoryTheory.IsPullback.of_hasPullback f'_M e_0).flip
    exact (CategoryTheory.IsPullback.of_right h_outer h_fst h_right).flip

  
  have h_frac_equiv : ∀ {A B K₁ K₂ : Type u} [CommRing A] [CommRing B] [CommRing K₁] [CommRing K₂]
      (e_base : A ≃+* B) (e_frac : K₁ ≃+* K₂) (φ_B : B →+* K₁) (φ_A : A →+* K₂),
      @IsFractionRing B _ K₁ _ φ_B.toAlgebra →
      (∀ a : A, φ_A a = e_frac (φ_B (e_base a))) →
      @IsFractionRing A _ K₂ _ φ_A.toAlgebra := by
    intro A B K₁ K₂ _ _ _ _ e_base e_frac φ_B φ_A hFrac hcomm
    letI : Algebra B K₁ := φ_B.toAlgebra
    letI : Algebra A K₂ := φ_A.toAlgebra
    have hAlgB : algebraMap B K₁ = φ_B := rfl
    have hLocB : IsLocalization (nonZeroDivisors B) K₁ := hFrac
    have map_nzd : ∀ {C D : Type u} [CommRing C] [CommRing D] (e : C ≃+* D) (x : C),
        x ∈ nonZeroDivisors C → e x ∈ nonZeroDivisors D := by
      intro C D _ _ e x hx
      rw [mem_nonZeroDivisors_iff_right] at hx ⊢
      intro z hz
      apply e.symm.injective
      rw [map_zero]
      apply hx
      apply e.injective
      rw [map_mul, e.apply_symm_apply, map_zero]
      exact hz
    refine { map_units := ?_, surj := ?_, exists_of_eq := ?_ }
    · rintro ⟨y, hy⟩
      change IsUnit (φ_A y)
      rw [hcomm y]
      have hu : IsUnit (algebraMap B K₁ (e_base y)) :=
        @IsLocalization.map_units B _ (nonZeroDivisors B) K₁ _ φ_B.toAlgebra hLocB
          ⟨e_base y, map_nzd e_base y hy⟩
      rw [hAlgB] at hu
      exact hu.map e_frac.toRingHom
    · intro z
      obtain ⟨⟨b, ⟨s, hs⟩⟩, hbs⟩ :=
        @IsLocalization.surj B _ (nonZeroDivisors B) K₁ _ φ_B.toAlgebra hLocB (e_frac.symm z)
      refine ⟨⟨e_base.symm b, ⟨e_base.symm s, map_nzd e_base.symm s hs⟩⟩, ?_⟩
      change z * φ_A (e_base.symm s) = φ_A (e_base.symm b)
      rw [hcomm, hcomm, e_base.apply_symm_apply, e_base.apply_symm_apply]
      have heq := congrArg e_frac hbs
