    intro Q_R A_0 _ φ_top q_y ι hφ_inj hι_inj hPoly_frac hGauss_ker
    classical
    have r_dvd_total : ∀ a b : ↥R, (∃ r : ↥R, a = r * b) ∨ (∃ r : ↥R, b = r * a) := by
      intro a b
      by_cases hb : b = 0
      · exact Or.inr ⟨0, by simp [hb]⟩
      · have hbK : (b : K) ≠ 0 := fun h => hb (Subtype.ext h)
        rcases ValuationSubring.mem_or_inv_mem R ((a : K) * (b : K)⁻¹) with hmem | hinv
        · refine Or.inl ⟨⟨(a : K) * (b : K)⁻¹, hmem⟩, Subtype.ext ?_⟩
          change (a : K) = ((a : K) * (b : K)⁻¹) * (b : K)
          rw [mul_assoc, inv_mul_cancel₀ hbK, mul_one]
        · by_cases ha : a = 0
          · exact Or.inl ⟨0, by simp [ha]⟩
