          rcases r_dvd_total (g j) (g i₁) with ⟨r, hr⟩ | ⟨r, hr⟩
          · refine ⟨i₁, Finset.mem_insert_of_mem hi₁, fun i hi => ?_⟩
            rcases Finset.mem_insert.mp hi with rfl | hiT
            · exact ⟨r, hr⟩
            · exact hdiv₁ i hiT
          · refine ⟨j, Finset.mem_insert_self j T, fun i hi => ?_⟩
            rcases Finset.mem_insert.mp hi with rfl | hiT
