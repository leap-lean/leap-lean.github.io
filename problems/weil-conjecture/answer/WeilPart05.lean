    intro M_1 g_M1 f_M1 η_M1 Z_M1 B_1 hMod1
    obtain ⟨η_X1, E_X1, p_nb1, _H_nb1,
        hSS_X1, hProp_fX1, hFunc_X1, hη_X1_f, hGenIso_X1, _,
