        obtain ⟨_, hmemO', pt, hpt_eq⟩ := hDom_ηΓ.denseRange.inter_open_nonempty O' hO'_open hO'_ne
        rw [Subsingleton.elim pt (⊥ : PrimeSpectrum F)] at hpt_eq
