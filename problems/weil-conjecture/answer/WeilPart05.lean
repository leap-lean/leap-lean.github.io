  have _ : AlgebraicGeometry.IsOpenImmersion j_VP := hOpen_j
  have hj_inj : Function.Injective j_VP.base := j_VP.isOpenEmbedding.injective
  have hϖ_ne : V.subtype ϖ ≠ 0 := fun h0 =>
    hϖ_P ((Subtype.ext h0 : ϖ = 0) ▸ P.asIdeal.zero_mem)
  have hϖ_inv_mem : (V.subtype ϖ)⁻¹ ∈ R :=
    (hOfPrime (V.subtype ϖ)⁻¹).mpr ⟨1, 1, by
      rw [pow_one, map_one]
      exact inv_mul_cancel₀ hϖ_ne⟩
  let ϖ_inv : ↥R := ⟨(V.subtype ϖ)⁻¹, hϖ_inv_mem⟩
  have hϖ_unit : IsUnit (ι_VP ϖ) :=
    ⟨⟨ι_VP ϖ, ϖ_inv, Subtype.ext (mul_inv_cancel₀ hϖ_ne), Subtype.ext (inv_mul_cancel₀ hϖ_ne)⟩, rfl⟩
  have hj_le_P : ∀ Q_R : PrimeSpectrum ↥R, (j_VP.base Q_R).asIdeal ≤ P.asIdeal := by
    intro Q_R
    refine (hϖ_iff (j_VP.base Q_R)).mp (fun h_in => Q_R.isPrime.ne_top ?_)
    change ι_VP ϖ ∈ Q_R.asIdeal at h_in
    exact Ideal.eq_top_of_isUnit_mem Q_R.asIdeal h_in hϖ_unit
  let m_R_pt : PrimeSpectrum ↥R :=
    ⟨IsLocalRing.maximalIdeal ↥R, (IsLocalRing.maximalIdeal.isMaximal ↥R).isPrime⟩
  have hj_max : j_VP.base m_R_pt = P := by
    apply PrimeSpectrum.ext
    apply le_antisymm (hj_le_P m_R_pt)
    intro a ha
    change ι_VP a ∈ IsLocalRing.maximalIdeal ↥R
    rw [IsLocalRing.mem_maximalIdeal]
    rintro ⟨u, hu_eq⟩
    let y : ↥R := ↑u⁻¹
    have hay : V.subtype a * y.1 = 1 := congrArg Subtype.val (hu_eq ▸ u.val_inv)
    obtain ⟨b, k, hbk⟩ := (hOfPrime y.1).mp y.2
    have hpow : ϖ ^ k = a * b := Subtype.ext <| calc
      V.subtype (ϖ ^ k) = (V.subtype ϖ) ^ k := map_pow V.subtype ϖ k
      _ = (V.subtype a * y.1) * (V.subtype ϖ) ^ k := by rw [hay, one_mul]
      _ = V.subtype a * (y.1 * (V.subtype ϖ) ^ k) := mul_assoc _ _ _
      _ = V.subtype (a * b) := by rw [hbk, map_mul]
    exact hϖ_P (P.isPrime.mem_of_pow_mem k (hpow ▸ Ideal.mul_mem_right b P.asIdeal ha))
  have hj_neBot : ∀ Q_R : PrimeSpectrum ↥R, Q_R.asIdeal ≠ ⊥ → (j_VP.base Q_R).asIdeal ≠ ⊥ := by
    intro Q_R hne
