    rw [Polynomial.hom_eval₂, hu_W] at hmem
    have hcomp_res : q_W_res.comp ρ_RW =
        ι_res.comp ((algebraMap A_E p_x.asIdeal.ResidueField).comp c_U) := by
      ext r
      change q_W_res (ρ_RW r) = ι_res (algebraMap A_E p_x.asIdeal.ResidueField (c_U r))
      rw [← hα_c]
      exact (Ideal.ResidueField.map_algebraMap p_x.asIdeal m_W α_AE hp_comap (c_U r)).symm
    rw [hcomp_res, ← Polynomial.hom_eval₂] at hmem
    exact ht_x Q hQ ((RingHom.injective ι_res) (hmem.trans (map_zero ι_res).symm))

theorem weil_etale_singleton_fiber_valuation_uniqueness_and_residue_descent (R_base A_0 B F_0 F_WB : Type u)
    [CommRing R_base] [IsLocalRing R_base]
    [CommRing A_0] [IsDomain A_0]
    [CommRing B] [IsDomain B]
    [Field F_0] [Field F_WB]
    (α_0 : A_0 →+* B) (φ_A0 : A_0 →+* F_0) (φ_B : B →+* F_WB)
    (φ_RF0 : R_base →+* F_0) (φ_F : F_0 →+* F_WB)
    (p_0 : Ideal A_0) (q_0 : Ideal B)
    (hEtIC : ∀ (D₀ D₁ : Type u) [CommRing D₀] [IsDomain D₀] [IsIntegrallyClosed D₀]
      [CommRing D₁] [IsDomain D₁] [Algebra D₀ D₁] [Algebra.Etale D₀ D₁],
      IsIntegrallyClosed D₁)
    (hEt_α0 : α_0.Etale)
    (hFrac_A0 : @IsFractionRing A_0 _ F_0 _ φ_A0.toAlgebra)
    (hFrac_B : @IsFractionRing B _ F_WB _ φ_B.toAlgebra)
    (hComm_φ : φ_B.comp α_0 = φ_F.comp φ_A0)
    (hp0_max : p_0.IsMaximal)
    (hq0_prime : q_0.IsPrime)
    (hMap_pq : Ideal.map α_0 p_0 = q_0)
    (hRes_surj : ∀ b : B, ∃ a : A_0, b - α_0 a ∈ q_0) :
    (∀ (W₁ W₂ : ValuationSubring F_WB),
      W₁.comap φ_F = W₂.comap φ_F →
      (∀ b : B, φ_B b ∈ W₁) →
      (∀ b : B, φ_B b ∈ W₂) →
      (∀ a : A_0, ∃ ha : φ_A0 a ∈ W₁.comap φ_F,
        a ∈ p_0 →
          (⟨φ_A0 a, ha⟩ : ↥(W₁.comap φ_F)) ∈ IsLocalRing.maximalIdeal ↥(W₁.comap φ_F)) →
      W₁ = W₂) ∧
    (∀ (W : ValuationSubring F_WB)
       (hR : ∀ r : R_base, (φ_F.comp φ_RF0) r ∈ W)
       (u_W : ↥W),
      (∀ r : R_base,
        (⟨(φ_F.comp φ_RF0) r, hR r⟩ : ↥W) ∈ IsLocalRing.maximalIdeal ↥W ↔
          r ∈ IsLocalRing.maximalIdeal R_base) →
      (∀ Q : Polynomial R_base,
        (∃ j : ℕ, Q.coeff j ∉ IsLocalRing.maximalIdeal R_base) →
        Polynomial.eval₂ ((φ_F.comp φ_RF0).codRestrict W.toSubring hR) u_W Q ∉
          IsLocalRing.maximalIdeal ↥W) →
      ∃ t_1 : ↥(W.comap φ_F),
        ∀ Q : Polynomial R_base,
          (∃ j : ℕ, Q.coeff j ∉ IsLocalRing.maximalIdeal R_base) →
          Polynomial.eval₂
            (φ_RF0.codRestrict (W.comap φ_F).toSubring (fun r => hR r)) t_1 Q ∉
            IsLocalRing.maximalIdeal ↥(W.comap φ_F)) :=
by
  classical
  
  have jW_mem_max_iff : ∀ (W : ValuationSubring F_WB) (z : ↥(W.comap φ_F)),
      ((φ_F.comp (W.comap φ_F).subtype).codRestrict W.toSubring (fun w => w.2)) z ∈
        IsLocalRing.maximalIdeal ↥W ↔
      z ∈ IsLocalRing.maximalIdeal ↥(W.comap φ_F) := by
    intro W z
    let W₀ := W.comap φ_F
    let jW : ↥W₀ →+* ↥W := (φ_F.comp W₀.subtype).codRestrict W.toSubring (fun w => w.2)
    change jW z ∈ IsLocalRing.maximalIdeal ↥W ↔ z ∈ IsLocalRing.maximalIdeal ↥W₀
    rw [← not_iff_not, IsLocalRing.notMem_maximalIdeal, IsLocalRing.notMem_maximalIdeal]
    refine ⟨fun hu => ?_, fun hz => jW.isUnit_map hz⟩
    have hz0 : z.1 ≠ 0 := by
      intro h0
      have hj0 : jW z = 0 := Subtype.ext (by change φ_F z.1 = 0; rw [h0, map_zero])
      rw [hj0] at hu
      exact not_isUnit_zero hu
    rcases hu.exists_right_inv with ⟨v, hv⟩
    have hv_val : φ_F z.1 * v.1 = 1 := congrArg Subtype.val hv
    have hz_ne_FWB : φ_F z.1 ≠ 0 := (map_ne_zero φ_F).mpr hz0
    have hv_eq : v.1 = φ_F z.1⁻¹ := by
      apply mul_left_cancel₀ hz_ne_FWB
      rw [hv_val, ← map_mul, mul_inv_cancel₀ hz0, map_one]
    have hz_inv_mem : z.1⁻¹ ∈ W₀ := by
      change φ_F z.1⁻¹ ∈ W
      rw [← hv_eq]
      exact v.2
    exact isUnit_iff_exists_inv.mpr ⟨⟨z.1⁻¹, hz_inv_mem⟩, Subtype.ext (mul_inv_cancel₀ hz0)⟩

  
  have exists_norm_coeff : ∀ (V₀ : ValuationSubring F_0) (P : Polynomial F_0), P ≠ 0 →
      ∃ i_star ∈ P.support, ∀ i : ℕ, P.coeff i * (P.coeff i_star)⁻¹ ∈ V₀ := by
    intro V₀ P hP_ne
    have h_on_finset : ∀ (S : Finset ℕ), S.Nonempty → (∀ k ∈ S, P.coeff k ≠ 0) →
        ∃ i_star ∈ S, ∀ i ∈ S, P.coeff i * (P.coeff i_star)⁻¹ ∈ V₀ := by
      intro S
      induction S using Finset.induction_on with
      | empty => intro hne; exact absurd hne Finset.not_nonempty_empty
      | @insert a s has ih =>
        intro _ h_nz
        have ha_nz : P.coeff a ≠ 0 := h_nz a (Finset.mem_insert_self a s)
        rcases s.eq_empty_or_nonempty with rfl | hs_ne
        · refine ⟨a, Finset.mem_singleton_self a, ?_⟩
          intro i hi
          rw [Finset.mem_singleton.mp hi, mul_inv_cancel₀ ha_nz]
          exact V₀.one_mem
        · obtain ⟨b, hb_mem, hb_all⟩ :=
            ih hs_ne (fun k hk => h_nz k (Finset.mem_insert_of_mem hk))
          have hb_nz : P.coeff b ≠ 0 := h_nz b (Finset.mem_insert_of_mem hb_mem)
          rcases ValuationSubring.mem_or_inv_mem V₀ (P.coeff a * (P.coeff b)⁻¹) with hab | hba
          · refine ⟨b, Finset.mem_insert_of_mem hb_mem, ?_⟩
            intro i hi
            rcases Finset.mem_insert.mp hi with rfl | hi_s
            · exact hab
            · exact hb_all i hi_s
          · have hba' : P.coeff b * (P.coeff a)⁻¹ ∈ V₀ := by
              have h_eq : (P.coeff a * (P.coeff b)⁻¹)⁻¹ = P.coeff b * (P.coeff a)⁻¹ := by
                rw [mul_inv_rev, inv_inv, mul_comm]
              rwa [← h_eq]
            refine ⟨a, Finset.mem_insert_self a s, ?_⟩
            intro i hi
            rcases Finset.mem_insert.mp hi with rfl | hi_s
            · rw [mul_inv_cancel₀ ha_nz]
              exact V₀.one_mem
            · have h_prod : P.coeff i * (P.coeff a)⁻¹ =
                  (P.coeff i * (P.coeff b)⁻¹) * (P.coeff b * (P.coeff a)⁻¹) := by
                calc P.coeff i * (P.coeff a)⁻¹
                    = P.coeff i * ((P.coeff b)⁻¹ * P.coeff b) * (P.coeff a)⁻¹ := by
                        rw [inv_mul_cancel₀ hb_nz, mul_one]
                  _ = (P.coeff i * (P.coeff b)⁻¹) * (P.coeff b * (P.coeff a)⁻¹) := by ring
              rw [h_prod]
              exact V₀.toSubring.mul_mem (hb_all i hi_s) hba'
    obtain ⟨i_star, hi_supp, hi_all⟩ := h_on_finset P.support
      (Polynomial.support_nonempty.mpr hP_ne) (fun k hk => Polynomial.mem_support_iff.mp hk)
    refine ⟨i_star, hi_supp, fun i => ?_⟩
    by_cases hi : i ∈ P.support
    · exact hi_all i hi
    · rw [Polynomial.notMem_support_iff.mp hi, zero_mul]
      exact V₀.zero_mem

  
  let _ : Algebra A_0 B := α_0.toAlgebra
  let _ : Algebra A_0 F_0 := φ_A0.toAlgebra
  let _ : Algebra F_0 F_WB := φ_F.toAlgebra
  let _ : Algebra A_0 F_WB := (φ_F.comp φ_A0).toAlgebra
  have : IsScalarTower A_0 F_0 F_WB := IsScalarTower.of_algebraMap_eq' rfl
  have : IsFractionRing A_0 F_0 := hFrac_A0
  have : Algebra.Etale A_0 B := hEt_α0
  have hφ_A0_inj : Function.Injective φ_A0 := IsFractionRing.injective A_0 F_0
  have hφ_B_inj : Function.Injective φ_B :=
    @IsFractionRing.injective B _ F_WB _ φ_B.toAlgebra hFrac_B
  let g_B : B →ₐ[A_0] F_WB :=
    { φ_B with commutes' := fun a => RingHom.congr_fun hComm_φ a }
  let T_gen : Type u := TensorProduct A_0 F_0 B
  have : Algebra.Etale F_0 T_gen := inferInstance
  let μ_alg : T_gen →ₐ[F_0] F_WB :=
    Algebra.TensorProduct.lift (Algebra.ofId F_0 F_WB) g_B (fun _ _ => Commute.all _ _)
  have hClearDenom : ∀ x : T_gen,
      ∃ (s : nonZeroDivisors A_0) (b : B),
        (φ_A0 s.1 ⊗ₜ[A_0] (1 : B)) * x = (1 : F_0) ⊗ₜ[A_0] b := by
    intro x
    refine TensorProduct.inductionOn
      (motive := fun x => ∃ (s : nonZeroDivisors A_0) (b : B),
        (φ_A0 s.1 ⊗ₜ[A_0] (1 : B)) * x = (1 : F_0) ⊗ₜ[A_0] b) x ?_ ?_
    · intro z b₀
      obtain ⟨⟨a, s⟩, hzs⟩ := @IsLocalization.surj A_0 _ (nonZeroDivisors A_0) F_0 _ _ hFrac_A0 z
      refine ⟨s, α_0 a * b₀, ?_⟩
      have hzs' : φ_A0 s.1 * z = φ_A0 a := by
        calc φ_A0 s.1 * z = z * algebraMap A_0 F_0 s.1 := mul_comm _ _
          _ = algebraMap A_0 F_0 a := hzs
      calc (φ_A0 s.1 ⊗ₜ[A_0] (1 : B)) * (z ⊗ₜ[A_0] b₀)
          = (φ_A0 s.1 * z) ⊗ₜ[A_0] ((1 : B) * b₀) := Algebra.TensorProduct.tmul_mul_tmul _ _ _ _
        _ = (a • (1 : F_0)) ⊗ₜ[A_0] b₀ := by
            rw [hzs', one_mul]
            change φ_A0 a ⊗ₜ[A_0] b₀ = (algebraMap A_0 F_0 a * 1) ⊗ₜ[A_0] b₀
            rw [mul_one]; rfl
        _ = (1 : F_0) ⊗ₜ[A_0] (a • b₀) := TensorProduct.smul_tmul a (1 : F_0) b₀
        _ = (1 : F_0) ⊗ₜ[A_0] (α_0 a * b₀) := rfl
    · intro x₁ x₂ ⟨s₁, b₁, hx₁⟩ ⟨s₂, b₂, hx₂⟩
      refine ⟨s₁ * s₂, α_0 s₂.1 * b₁ + α_0 s₁.1 * b₂, ?_⟩
      have hmul_s : (φ_A0 (s₁ * s₂).1 ⊗ₜ[A_0] (1 : B)) =
          (φ_A0 s₂.1 ⊗ₜ[A_0] (1 : B)) * (φ_A0 s₁.1 ⊗ₜ[A_0] (1 : B)) := by
        change φ_A0 (s₁.1 * s₂.1) ⊗ₜ[A_0] (1 : B) = _
        rw [map_mul, mul_comm (φ_A0 s₁.1) (φ_A0 s₂.1), Algebra.TensorProduct.tmul_mul_tmul, one_mul]
      have hmul_s' : (φ_A0 (s₁ * s₂).1 ⊗ₜ[A_0] (1 : B)) =
          (φ_A0 s₁.1 ⊗ₜ[A_0] (1 : B)) * (φ_A0 s₂.1 ⊗ₜ[A_0] (1 : B)) := by
        change φ_A0 (s₁.1 * s₂.1) ⊗ₜ[A_0] (1 : B) = _
        rw [map_mul, Algebra.TensorProduct.tmul_mul_tmul, one_mul]
      have hterm : ∀ (a : A_0) (b : B),
          (φ_A0 a ⊗ₜ[A_0] (1 : B)) * ((1 : F_0) ⊗ₜ[A_0] b) = (1 : F_0) ⊗ₜ[A_0] (α_0 a * b) := by
        intro a b
        calc (φ_A0 a ⊗ₜ[A_0] (1 : B)) * ((1 : F_0) ⊗ₜ[A_0] b)
            = (φ_A0 a * 1) ⊗ₜ[A_0] ((1 : B) * b) := Algebra.TensorProduct.tmul_mul_tmul _ _ _ _
          _ = (a • (1 : F_0)) ⊗ₜ[A_0] b := by rw [Algebra.smul_def, one_mul]; rfl
          _ = (1 : F_0) ⊗ₜ[A_0] (a • b) := TensorProduct.smul_tmul a (1 : F_0) b
          _ = (1 : F_0) ⊗ₜ[A_0] (α_0 a * b) := rfl
      rw [mul_add, TensorProduct.tmul_add]
      congr 1
      · rw [hmul_s, mul_assoc, hx₁, hterm]
      · rw [hmul_s', mul_assoc, hx₂, hterm]
  have hμ_alg_inj : Function.Injective μ_alg := by
    change Function.Injective μ_alg.toRingHom
    rw [RingHom.injective_iff_ker_eq_bot]
    ext x
    simp only [RingHom.mem_ker, Ideal.mem_bot]
    refine ⟨fun hx0 => ?_, fun hx => by rw [hx, map_zero]⟩
    obtain ⟨s, b, hsx⟩ := hClearDenom x
    have hμ_1b : μ_alg.toRingHom ((1 : F_0) ⊗ₜ[A_0] b) = φ_B b := by
      change μ_alg ((1 : F_0) ⊗ₜ[A_0] b) = φ_B b
      rw [Algebra.TensorProduct.lift_tmul]
      change algebraMap F_0 F_WB 1 * φ_B b = φ_B b
      rw [map_one, one_mul]
    have hb0 : b = 0 := by
      apply hφ_B_inj
      rw [map_zero, ← hμ_1b, ← hsx, map_mul, hx0, mul_zero]
    rw [hb0, TensorProduct.tmul_zero] at hsx
    have hs_ne : s.1 ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s.2
    have hφs_ne : φ_A0 s.1 ≠ 0 := (map_ne_zero_iff φ_A0 hφ_A0_inj).mpr hs_ne
    have hinv_s : ((φ_A0 s.1)⁻¹ ⊗ₜ[A_0] (1 : B)) * (φ_A0 s.1 ⊗ₜ[A_0] (1 : B)) = (1 : T_gen) := by
      rw [Algebra.TensorProduct.tmul_mul_tmul, inv_mul_cancel₀ hφs_ne, one_mul]
      rfl
    calc x = (1 : T_gen) * x := (one_mul x).symm
      _ = (((φ_A0 s.1)⁻¹ ⊗ₜ[A_0] (1 : B)) * (φ_A0 s.1 ⊗ₜ[A_0] (1 : B))) * x := by rw [hinv_s]
      _ = ((φ_A0 s.1)⁻¹ ⊗ₜ[A_0] (1 : B)) * ((φ_A0 s.1 ⊗ₜ[A_0] (1 : B)) * x) := mul_assoc _ _ _
      _ = 0 := by rw [hsx, mul_zero]
  have : IsDomain T_gen := Function.Injective.isDomain μ_alg.toRingHom hμ_alg_inj
  have : Module.Finite F_0 T_gen := by
    obtain ⟨I, instFinI, Ai, instFieldAi, instAlgAi, e_prod, hFinSep⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod F_0 T_gen).mp inferInstance
    let _ : _root_.Finite I := instFinI
    let _ : ∀ i : I, Field (Ai i) := instFieldAi
    let _ : ∀ i : I, Algebra F_0 (Ai i) := instAlgAi
    have : ∀ i : I, Module.Finite F_0 (Ai i) := fun i => (hFinSep i).1
    have : Module.Finite F_0 (∀ i : I, Ai i) := Module.Finite.pi
    exact Module.Finite.equiv e_prod.symm.toLinearEquiv
  have : Algebra.IsIntegral F_0 T_gen := Algebra.IsIntegral.of_finite F_0 T_gen
  have hIsField_T : IsField T_gen :=
    (Algebra.IsIntegral.isField_iff_isField (RingHom.injective (algebraMap F_0 T_gen))).mp
      (Field.toIsField F_0)
  have hμ_alg_surj : Function.Surjective μ_alg := by
    intro y
    obtain ⟨⟨b₁, t⟩, hyt⟩ :=
      @IsLocalization.surj B _ (nonZeroDivisors B) F_WB _ φ_B.toAlgebra hFrac_B y
    have ht_ne : t.1 ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp t.2
    have hφt_ne : φ_B t.1 ≠ 0 := (map_ne_zero_iff φ_B hφ_B_inj).mpr ht_ne
    have h1t_ne : ((1 : F_0) ⊗ₜ[A_0] t.1 : T_gen) ≠ 0 := by
      intro h0
      have hμ0 : μ_alg ((1 : F_0) ⊗ₜ[A_0] t.1) = 0 := by rw [h0, map_zero]
      rw [Algebra.TensorProduct.lift_tmul] at hμ0
      change algebraMap F_0 F_WB 1 * φ_B t.1 = 0 at hμ0
      rw [map_one, one_mul] at hμ0
      exact hφt_ne hμ0
    obtain ⟨u, hu⟩ := hIsField_T.mul_inv_cancel h1t_ne
    refine ⟨((1 : F_0) ⊗ₜ[A_0] b₁) * u, ?_⟩
    have hμ_t : φ_B t.1 * μ_alg u = 1 := by
      have h1 := congrArg μ_alg hu
      rw [map_mul, map_one, Algebra.TensorProduct.lift_tmul] at h1
      change (algebraMap F_0 F_WB 1 * φ_B t.1) * μ_alg u = 1 at h1
      rwa [map_one, one_mul] at h1
    rw [map_mul, Algebra.TensorProduct.lift_tmul]
    change (algebraMap F_0 F_WB 1 * φ_B b₁) * μ_alg u = y
    rw [map_one, one_mul]
    have hyt' : φ_B b₁ = y * φ_B t.1 := hyt.symm
    rw [hyt', mul_assoc, hμ_t, mul_one]
  have : Module.Finite F_0 F_WB := Module.Finite.of_surjective μ_alg.toLinearMap hμ_alg_surj
  have hAlg_F : Algebra.IsAlgebraic F_0 F_WB := Algebra.IsAlgebraic.of_finite F_0 F_WB

  refine ⟨?_, ?_⟩
  · 
    intro W₁ W₂ hComap hB₁ hB₂ hA0
    
    let W_bar : ValuationSubring F_0 := W₁.comap φ_F
    have ha_mem : ∀ a : A_0, φ_A0 a ∈ W_bar := fun a => (hA0 a).1
    have ha_max : ∀ a : A_0, a ∈ p_0 →
        (⟨φ_A0 a, ha_mem a⟩ : ↥W_bar) ∈ IsLocalRing.maximalIdeal ↥W_bar :=
      fun a hp => (hA0 a).2 hp
    let ι_A0 : A_0 →+* ↥W_bar := φ_A0.codRestrict W_bar.toSubring ha_mem
    let _ : Algebra A_0 ↥W_bar := ι_A0.toAlgebra
    let B_1 : Type u := TensorProduct A_0 ↥W_bar B
    have : Algebra.Etale ↥W_bar B_1 := inferInstance
    let f_W : ↥W_bar →ₐ[A_0] F_WB :=
      { φ_F.comp W_bar.subtype with commutes' := fun _ => rfl }
    let μ_W_alg : B_1 →ₐ[A_0] F_WB :=
      Algebra.TensorProduct.lift f_W g_B (fun _ _ => Commute.all _ _)
    let μ : B_1 →+* F_WB := μ_W_alg.toRingHom
    let ι_lin : ↥W_bar →ₗ[A_0] F_0 :=
      { toFun := Subtype.val
        map_add' := fun _ _ => rfl
        map_smul' := fun _ _ => rfl }
    have h_rTensor_inj : Function.Injective (LinearMap.rTensor B ι_lin) :=
      Module.Flat.rTensor_preserves_injective_linearMap ι_lin Subtype.val_injective
    have hμ_fac : ∀ z : B_1, μ_alg (LinearMap.rTensor B ι_lin z) = μ z := by
      intro z
      refine TensorProduct.inductionOn
        (motive := fun z => μ_alg (LinearMap.rTensor B ι_lin z) = μ z) z ?_ ?_
      · intro w b
        rw [LinearMap.rTensor_tmul]
        change μ_alg (w.1 ⊗ₜ[A_0] b) = μ_W_alg (w ⊗ₜ[A_0] b)
        rw [Algebra.TensorProduct.lift_tmul, Algebra.TensorProduct.lift_tmul]
        rfl
      · intro x y hx hy
        rw [map_add, map_add, map_add, hx, hy]
    have hμ_inj : Function.Injective μ := by
      intro x y hxy
      apply h_rTensor_inj
      apply hμ_alg_inj
      rw [hμ_fac, hμ_fac, hxy]
    have : IsDomain B_1 := Function.Injective.isDomain μ hμ_inj
    have hIC_B1 : IsIntegrallyClosed B_1 :=
      @hEtIC ↥W_bar B_1 _ _ (instIsIntegrallyClosedSubtypeMemValuationSubring W_bar)
        _ _ _ inferInstance
    let D_0 : Subring F_WB := μ.range
    let e_D0 : B_1 ≃+* ↥D_0 :=
      RingEquiv.ofBijective μ.rangeRestrict
        ⟨fun x y h => hμ_inj (congrArg Subtype.val h), μ.rangeRestrict_surjective⟩
    have : IsIntegrallyClosed ↥D_0 := IsIntegrallyClosed.of_equiv e_D0
    have : IsFractionRing ↥D_0 F_WB :=
      { map_units := fun y => by
          have hy_ne : (y.1 : ↥D_0) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp y.2
          have hy_val : (y.1 : F_WB) ≠ 0 := fun h => hy_ne (Subtype.ext h)
          exact Ne.isUnit hy_val
        surj := fun z => by
          obtain ⟨⟨b, t⟩, hzt⟩ :=
            @IsLocalization.surj B _ (nonZeroDivisors B) F_WB _ φ_B.toAlgebra hFrac_B z
          have hμ_1b : ∀ c : B, μ ((1 : ↥W_bar) ⊗ₜ[A_0] c) = φ_B c := by
            intro c
            change μ_W_alg ((1 : ↥W_bar) ⊗ₜ[A_0] c) = φ_B c
            rw [Algebra.TensorProduct.lift_tmul]
            change φ_F (1 : F_0) * φ_B c = φ_B c
            rw [map_one, one_mul]
          let d_num : ↥D_0 := ⟨φ_B b, ⟨(1 : ↥W_bar) ⊗ₜ[A_0] b, hμ_1b b⟩⟩
          let d_den : ↥D_0 := ⟨φ_B t.1, ⟨(1 : ↥W_bar) ⊗ₜ[A_0] t.1, hμ_1b t.1⟩⟩
          have ht_ne : t.1 ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp t.2
          have hd_den_ne : d_den ≠ 0 := by
            intro h0
            exact (map_ne_zero_iff φ_B hφ_B_inj).mpr ht_ne (congrArg Subtype.val h0)
          exact ⟨(d_num, ⟨d_den, mem_nonZeroDivisors_iff_ne_zero.mpr hd_den_ne⟩), hzt⟩
        exists_of_eq := fun h => ⟨1, by simp [Subtype.ext h]⟩ }
    have : IsIntegrallyClosedIn ↥D_0 F_WB :=
      (isIntegrallyClosed_iff_isIntegrallyClosedIn F_WB).mp inferInstance

    have hμ_W1 : ∀ z : B_1, μ z ∈ W₁ := by
      intro z
      refine TensorProduct.inductionOn (motive := fun z => μ z ∈ W₁) z ?_ ?_
      · intro w b
        change μ_W_alg (w ⊗ₜ[A_0] b) ∈ W₁
        rw [Algebra.TensorProduct.lift_tmul]
        exact W₁.toSubring.mul_mem w.2 (hB₁ b)
      · intro x y hx hy
        rw [map_add]
        exact W₁.toSubring.add_mem hx hy
    have hμ_W2 : ∀ z : B_1, μ z ∈ W₂ := by
      intro z
      refine TensorProduct.inductionOn (motive := fun z => μ z ∈ W₂) z ?_ ?_
      · intro w b
        change μ_W_alg (w ⊗ₜ[A_0] b) ∈ W₂
        rw [Algebra.TensorProduct.lift_tmul]
        have hw₂ : w.1 ∈ W₂.comap φ_F := by
          rw [← hComap]
          exact w.2
        exact W₂.toSubring.mul_mem hw₂ (hB₂ b)
      · intro x y hx hy
        rw [map_add]
        exact W₂.toSubring.add_mem hx hy
    have hle₁ : D_0 ≤ W₁.toSubring := by rintro _ ⟨z, rfl⟩; exact hμ_W1 z
    have hle₂ : D_0 ≤ W₂.toSubring := by rintro _ ⟨z, rfl⟩; exact hμ_W2 z
    have hWbar_D0 : ∀ z : F_0, z ∈ W_bar → φ_F z ∈ D_0 := by
      intro z hz
      refine ⟨(⟨z, hz⟩ : ↥W_bar) ⊗ₜ[A_0] (1 : B), ?_⟩
      change μ_W_alg ((⟨z, hz⟩ : ↥W_bar) ⊗ₜ[A_0] (1 : B)) = φ_F z
      rw [Algebra.TensorProduct.lift_tmul]
      change φ_F z * φ_B 1 = φ_F z
      rw [map_one, mul_one]

    
    let m_Wbar : Ideal ↥W_bar := IsLocalRing.maximalIdeal ↥W_bar
    let κ_Wbar := ↥W_bar ⧸ m_Wbar
    let _ : Field κ_Wbar := Ideal.Quotient.field m_Wbar
    let π_Wbar : ↥W_bar →+* κ_Wbar := Ideal.Quotient.mk m_Wbar
    let _ : Field (A_0 ⧸ p_0) := Ideal.Quotient.field p_0
    have : Nontrivial (B ⧸ q_0) := Ideal.Quotient.nontrivial_iff.mpr hq0_prime.ne_top
    let bar_α0 : (A_0 ⧸ p_0) →+* (B ⧸ q_0) :=
      Ideal.Quotient.lift p_0 ((Ideal.Quotient.mk q_0).comp α_0) (fun a ha => by
        rw [RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem, ← hMap_pq]
        exact Ideal.mem_map_of_mem α_0 ha)
    have hbar_α0_surj : Function.Surjective bar_α0 := by
      intro x
      obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective x
      obtain ⟨a, hab⟩ := hRes_surj b
      refine ⟨Ideal.Quotient.mk p_0 a, ?_⟩
      change Ideal.Quotient.mk q_0 (α_0 a) = Ideal.Quotient.mk q_0 b
      rw [Ideal.Quotient.eq]
      have hneg : α_0 a - b = -(b - α_0 a) := by ring
      rw [hneg]
      exact q_0.neg_mem hab
    let e_res : (A_0 ⧸ p_0) ≃+* (B ⧸ q_0) :=
      RingEquiv.ofBijective bar_α0 ⟨bar_α0.injective, hbar_α0_surj⟩
    let bar_θ0 : (A_0 ⧸ p_0) →+* κ_Wbar :=
      Ideal.Quotient.lift p_0 (π_Wbar.comp ι_A0) (fun a ha =>
        Ideal.Quotient.eq_zero_iff_mem.mpr (ha_max a ha))
    let ε_B : B →+* κ_Wbar :=
      bar_θ0.comp (e_res.symm.toRingHom.comp (Ideal.Quotient.mk q_0))
    let ε_B_alg : B →ₐ[A_0] κ_Wbar :=
      { ε_B with
        commutes' := fun a => by
          change bar_θ0 (e_res.symm (Ideal.Quotient.mk q_0 (α_0 a))) = algebraMap A_0 κ_Wbar a
          have heq : Ideal.Quotient.mk q_0 (α_0 a) = e_res (Ideal.Quotient.mk p_0 a) := rfl
          rw [heq, e_res.symm_apply_apply]
          rfl }
    let ε_1 : B_1 →+* κ_Wbar :=
      (Algebra.TensorProduct.lift (Ideal.Quotient.mkₐ A_0 m_Wbar) ε_B_alg
        (fun _ _ => Commute.all _ _)).toRingHom
    have hε1_w1 : ∀ w : ↥W_bar, ε_1 (w ⊗ₜ[A_0] (1 : B)) = π_Wbar w := by
      intro w
      change (Algebra.TensorProduct.lift (Ideal.Quotient.mkₐ A_0 m_Wbar) ε_B_alg _)
        (w ⊗ₜ[A_0] (1 : B)) = π_Wbar w
      rw [Algebra.TensorProduct.lift_tmul]
      change π_Wbar w * ε_B 1 = π_Wbar w
      rw [map_one, mul_one]
    have hε1_surj : Function.Surjective ε_1 := by
      intro y
      obtain ⟨w, rfl⟩ := Ideal.Quotient.mk_surjective y
      exact ⟨w ⊗ₜ[A_0] (1 : B), hε1_w1 w⟩
    have hKer_max : (RingHom.ker ε_1).IsMaximal :=
      RingHom.ker_isMaximal_of_surjective ε_1 hε1_surj

    let M_1 : Ideal B_1 :=
      Ideal.map (Algebra.TensorProduct.includeLeft : ↥W_bar →ₐ[A_0] B_1).toRingHom m_Wbar
    have hM1_le_ker : M_1 ≤ RingHom.ker ε_1 := by
      rw [Ideal.map_le_iff_le_comap]
      intro w hw
      change ε_1 (w ⊗ₜ[A_0] (1 : B)) = 0
      rw [hε1_w1]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr hw
    have hq0_M1 : ∀ r ∈ q_0, ∀ w : ↥W_bar, w ⊗ₜ[A_0] r ∈ M_1 := by
      intro r hr
      rw [← hMap_pq] at hr
      refine Submodule.span_induction (p := fun x _ => ∀ w : ↥W_bar, w ⊗ₜ[A_0] x ∈ M_1)
        ?_ ?_ ?_ ?_ hr
      · rintro _ ⟨a, ha, rfl⟩ w
        have htmul : w ⊗ₜ[A_0] α_0 a = (ι_A0 a * w) ⊗ₜ[A_0] (1 : B) := by
          calc w ⊗ₜ[A_0] α_0 a = w ⊗ₜ[A_0] (a • (1 : B)) := by change _ = w ⊗ₜ (α_0 a * 1); rw [mul_one]
            _ = (a • w) ⊗ₜ[A_0] (1 : B) := (TensorProduct.smul_tmul a w (1 : B)).symm
            _ = (ι_A0 a * w) ⊗ₜ[A_0] (1 : B) := rfl
        rw [htmul]
        exact Ideal.mem_map_of_mem _ (Ideal.mul_mem_right w m_Wbar (ha_max a ha))
      · intro w
        rw [TensorProduct.tmul_zero]
        exact M_1.zero_mem
      · intro x y _ _ hx hy w
        rw [TensorProduct.tmul_add]
        exact M_1.add_mem (hx w) (hy w)
      · intro b' x _ hx w
        have hsmul : w ⊗ₜ[A_0] (b' • x) = ((1 : ↥W_bar) ⊗ₜ[A_0] b') * (w ⊗ₜ[A_0] x) := by
          change w ⊗ₜ[A_0] (b' * x) = _
          rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul]
        rw [hsmul]
        exact M_1.mul_mem_left _ (hx w)
    have hz_decomp : ∀ z : B_1, ∃ w_z : ↥W_bar, z - w_z ⊗ₜ[A_0] (1 : B) ∈ M_1 := by
      intro z
      refine TensorProduct.inductionOn
        (motive := fun z => ∃ w_z : ↥W_bar, z - w_z ⊗ₜ[A_0] (1 : B) ∈ M_1) z ?_ ?_
      · intro w b
        obtain ⟨a, hab⟩ := hRes_surj b
        refine ⟨ι_A0 a * w, ?_⟩
        have htmul : (ι_A0 a * w) ⊗ₜ[A_0] (1 : B) = w ⊗ₜ[A_0] α_0 a := by
          calc (ι_A0 a * w) ⊗ₜ[A_0] (1 : B)
              = (a • w) ⊗ₜ[A_0] (1 : B) := rfl
            _ = w ⊗ₜ[A_0] (a • (1 : B)) := TensorProduct.smul_tmul a w (1 : B)
            _ = w ⊗ₜ[A_0] α_0 a := by rw [Algebra.smul_def, mul_one]; rfl
        rw [htmul, ← TensorProduct.tmul_sub]
        exact hq0_M1 (b - α_0 a) hab w
      · intro x y ⟨wx, hx⟩ ⟨wy, hy⟩
        refine ⟨wx + wy, ?_⟩
        have hsplit : (x + y) - (wx + wy) ⊗ₜ[A_0] (1 : B) =
            (x - wx ⊗ₜ[A_0] (1 : B)) + (y - wy ⊗ₜ[A_0] (1 : B)) := by
          rw [TensorProduct.add_tmul]; ring
        rw [hsplit]
        exact M_1.add_mem hx hy
    have hM1_eq_ker : M_1 = RingHom.ker ε_1 := by
      refine le_antisymm hM1_le_ker ?_
      intro z hz
      obtain ⟨w_z, hw_z⟩ := hz_decomp z
      have hdiff_ker : ε_1 (z - w_z ⊗ₜ[A_0] (1 : B)) = 0 := hM1_le_ker hw_z
      rw [map_sub, hz, zero_sub, neg_eq_zero, hε1_w1] at hdiff_ker
      have hw_mem : w_z ∈ m_Wbar := Ideal.Quotient.eq_zero_iff_mem.mp hdiff_ker
      have hw_M1 : w_z ⊗ₜ[A_0] (1 : B) ∈ M_1 := Ideal.mem_map_of_mem _ hw_mem
      have hz_sum : z = (z - w_z ⊗ₜ[A_0] (1 : B)) + w_z ⊗ₜ[A_0] (1 : B) := by ring
      rw [hz_sum]
      exact M_1.add_mem hw_z hw_M1
    have hM1_max : M_1.IsMaximal := hM1_eq_ker.symm ▸ hKer_max

    let γ_1 : B_1 →+* ↥W₁ := μ.codRestrict W₁.toSubring hμ_W1
    let γ_2 : B_1 →+* ↥W₂ := μ.codRestrict W₂.toSubring hμ_W2
    have hM1_comap1 : M_1 = Ideal.comap γ_1 (IsLocalRing.maximalIdeal ↥W₁) := by
      refine hM1_max.eq_of_le (Ideal.IsPrime.ne_top inferInstance) ?_
      rw [Ideal.map_le_iff_le_comap]
      intro w hw
      change γ_1 (w ⊗ₜ[A_0] (1 : B)) ∈ IsLocalRing.maximalIdeal ↥W₁
      have hγ1 : γ_1 (w ⊗ₜ[A_0] (1 : B)) =
          ((φ_F.comp W_bar.subtype).codRestrict W₁.toSubring (fun u => u.2)) w := by
        apply Subtype.ext
        change μ_W_alg (w ⊗ₜ[A_0] (1 : B)) = φ_F w.1
        rw [Algebra.TensorProduct.lift_tmul]
        change φ_F w.1 * φ_B 1 = φ_F w.1
        rw [map_one, mul_one]
      rw [hγ1]
      exact (jW_mem_max_iff W₁ w).mpr hw
    have hM1_comap2 : M_1 = Ideal.comap γ_2 (IsLocalRing.maximalIdeal ↥W₂) := by
      refine hM1_max.eq_of_le (Ideal.IsPrime.ne_top inferInstance) ?_
      rw [Ideal.map_le_iff_le_comap]
      intro w hw
      change γ_2 (w ⊗ₜ[A_0] (1 : B)) ∈ IsLocalRing.maximalIdeal ↥W₂
      have hw₂_mem : w.1 ∈ W₂.comap φ_F := by
        rw [← hComap]
        exact w.2
      let w₂ : ↥(W₂.comap φ_F) := ⟨w.1, hw₂_mem⟩
      have hw₂_max : w₂ ∈ IsLocalRing.maximalIdeal ↥(W₂.comap φ_F) := by
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
        intro hu₂
        rcases hu₂.exists_right_inv with ⟨v₂, hv₂⟩
        have hv₂_val : w.1 * v₂.1 = 1 := congrArg Subtype.val hv₂
        have hv₂_Wbar : v₂.1 ∈ W_bar := by
          change v₂.1 ∈ W₁.comap φ_F
          rw [hComap]
          exact v₂.2
        have hw_unit : IsUnit w :=
          isUnit_iff_exists_inv.mpr ⟨⟨v₂.1, hv₂_Wbar⟩, Subtype.ext hv₂_val⟩
        exact (IsLocalRing.mem_maximalIdeal w).mp hw hw_unit
      have hγ2 : γ_2 (w ⊗ₜ[A_0] (1 : B)) =
          ((φ_F.comp (W₂.comap φ_F).subtype).codRestrict W₂.toSubring (fun u => u.2)) w₂ := by
        apply Subtype.ext
        change μ_W_alg (w ⊗ₜ[A_0] (1 : B)) = φ_F w.1
        rw [Algebra.TensorProduct.lift_tmul]
        change φ_F w.1 * φ_B 1 = φ_F w.1
        rw [map_one, mul_one]
      rw [hγ2]
      exact (jW_mem_max_iff W₂ w₂).mpr hw₂_max
    have hCenter : ∀ (d : F_WB) (hd₁ : d ∈ W₁) (hd₂ : d ∈ W₂), d ∈ D_0 →
        ((⟨d, hd₁⟩ : ↥W₁) ∈ IsLocalRing.maximalIdeal ↥W₁ ↔
         (⟨d, hd₂⟩ : ↥W₂) ∈ IsLocalRing.maximalIdeal ↥W₂) := by
      rintro d hd₁ hd₂ ⟨z, rfl⟩
      have h1 : (⟨μ z, hd₁⟩ : ↥W₁) = γ_1 z := rfl
      have h2 : (⟨μ z, hd₂⟩ : ↥W₂) = γ_2 z := rfl
      rw [h1, h2]
      change z ∈ Ideal.comap γ_1 (IsLocalRing.maximalIdeal ↥W₁) ↔
        z ∈ Ideal.comap γ_2 (IsLocalRing.maximalIdeal ↥W₂)
      rw [← hM1_comap1, ← hM1_comap2]

    
    have hBourbakiSub : ∀ (U₁ U₂ : ValuationSubring F_WB),
        U₁.comap φ_F = U₂.comap φ_F →
        D_0 ≤ U₁.toSubring →
        D_0 ≤ U₂.toSubring →
        (∀ z : F_0, z ∈ U₁.comap φ_F → φ_F z ∈ D_0) →
        (∀ (d : F_WB) (hd₁ : d ∈ U₁) (hd₂ : d ∈ U₂), d ∈ D_0 →
          ((⟨d, hd₁⟩ : ↥U₁) ∈ IsLocalRing.maximalIdeal ↥U₁ ↔
           (⟨d, hd₂⟩ : ↥U₂) ∈ IsLocalRing.maximalIdeal ↥U₂)) →
        ∀ x : F_WB, x ∈ U₁ → x ∈ U₂ := by
      intro U₁ U₂ _ hU₁_D0 hU₂_D0 hW0_D0 hUCenter x hx₁
      let W₀ : ValuationSubring F_0 := U₁.comap φ_F
      have one_not_max_W0 : (1 : ↥W₀) ∉ IsLocalRing.maximalIdeal ↥W₀ := fun h1 =>
        (IsLocalRing.maximalIdeal.isMaximal ↥W₀).ne_top (Ideal.eq_top_iff_one _ |>.mpr h1)
      have one_not_max_U1 : (1 : ↥U₁) ∉ IsLocalRing.maximalIdeal ↥U₁ := fun h1 =>
        (IsLocalRing.maximalIdeal.isMaximal ↥U₁).ne_top (Ideal.eq_top_iff_one _ |>.mpr h1)
      obtain ⟨P, hP_ne, hP_aeval⟩ := Algebra.IsAlgebraic.isAlgebraic (R := F_0) x
      have hP_eval : Polynomial.eval₂ φ_F x P = 0 := by rwa [Polynomial.aeval_def] at hP_aeval
      obtain ⟨i_star, hi_star_supp, ha'_mem⟩ := exists_norm_coeff W₀ P hP_ne
      have hi_star_nz : P.coeff i_star ≠ 0 := Polynomial.mem_support_iff.mp hi_star_supp
      let n : ℕ := P.natDegree
      have hi_star_le : i_star ≤ n := Polynomial.le_natDegree_of_mem_supp _ hi_star_supp
      let a' : ℕ → ↥W₀ := fun i => ⟨P.coeff i * (P.coeff i_star)⁻¹, ha'_mem i⟩
      have ha'_istar : a' i_star = 1 := Subtype.ext (mul_inv_cancel₀ hi_star_nz)
      let S_unit : Finset ℕ :=
        (Finset.range (n + 1)).filter (fun i => a' i ∉ IsLocalRing.maximalIdeal ↥W₀)
      have hS_ne : S_unit.Nonempty :=
        ⟨i_star, Finset.mem_filter.mpr
          ⟨Finset.mem_range.mpr (Nat.lt_succ_of_le hi_star_le), ha'_istar ▸ one_not_max_W0⟩⟩
      let m_max : ℕ := S_unit.max' hS_ne
      have hm_mem : m_max ∈ S_unit := S_unit.max'_mem hS_ne
      have hm_lt : m_max < n + 1 := Finset.mem_range.mp (Finset.mem_filter.mp hm_mem).1
      have hm_not_max : a' m_max ∉ IsLocalRing.maximalIdeal ↥W₀ := (Finset.mem_filter.mp hm_mem).2
      rcases (IsLocalRing.notMem_maximalIdeal.mp hm_not_max).exists_left_inv with ⟨u_inv, hu_inv⟩
      let w : ℕ → ↥W₀ := fun i => u_inv * a' i
      let a : ℕ → F_0 := fun i => (w i).1
      have hw_m : w m_max = 1 := hu_inv
      have ha_m : a m_max = 1 := congrArg Subtype.val hw_m
      let c₁ : ℕ → ↥U₁ :=
        fun i => ((φ_F.comp W₀.subtype).codRestrict U₁.toSubring (fun z => z.2)) (w i)
      have hc₁_m : c₁ m_max = 1 := by
        dsimp only [c₁]
        rw [hw_m, map_one]
      have hc₁_gt_max : ∀ j : ℕ, m_max < j → j < n + 1 →
          c₁ j ∈ IsLocalRing.maximalIdeal ↥U₁ := by
        intro j hmj hjn
        have hj_not_S : j ∉ S_unit := fun hjS => Nat.not_lt.mpr (S_unit.le_max' j hjS) hmj
        have ha'_j_max : a' j ∈ IsLocalRing.maximalIdeal ↥W₀ := by
          by_contra h_not
          exact hj_not_S (Finset.mem_filter.mpr ⟨Finset.mem_range.mpr hjn, h_not⟩)
        have hw_j_max : w j ∈ IsLocalRing.maximalIdeal ↥W₀ :=
          Ideal.mul_mem_left _ u_inv ha'_j_max
        exact (jW_mem_max_iff U₁ (w j)).mpr hw_j_max
      have hsum_zero : ∑ i ∈ Finset.range (n + 1), φ_F (a i) * x ^ i = 0 := by
        have hfactor : ∀ i : ℕ,
            φ_F (a i) * x ^ i =
              φ_F (u_inv.1 * (P.coeff i_star)⁻¹) * (φ_F (P.coeff i) * x ^ i) := by
          intro i
          have ha_eq : a i = (u_inv.1 * (P.coeff i_star)⁻¹) * P.coeff i := by
            change u_inv.1 * (P.coeff i * (P.coeff i_star)⁻¹) = _
            ring
          rw [ha_eq, map_mul, mul_assoc]
        simp_rw [hfactor, ← Finset.mul_sum]
        have heval_sum : ∑ i ∈ Finset.range (n + 1), φ_F (P.coeff i) * x ^ i =
            Polynomial.eval₂ φ_F x P := (Polynomial.eval₂_eq_sum_range φ_F x).symm
        rw [heval_sum, hP_eval, mul_zero]
      let x₁ : ↥U₁ := ⟨x, hx₁⟩
      have hm_pos : 1 ≤ m_max := by
        by_contra hm0_not
        have hm0 : m_max = 0 := by omega
        have hsum_U1 : ∑ i ∈ Finset.range (n + 1), c₁ i * x₁ ^ i = 0 := by
          apply Subtype.ext
          change U₁.subtype (∑ i ∈ Finset.range (n + 1), c₁ i * x₁ ^ i) = 0
          rw [map_sum U₁.subtype]
          simp_rw [map_mul, map_pow]
          exact hsum_zero
        rw [Finset.sum_range_succ'] at hsum_U1
        have hc0 : c₁ 0 * x₁ ^ 0 = 1 := by rw [pow_zero, mul_one, ← hm0, hc₁_m]
        rw [hc0] at hsum_U1
        have h1_eq : (1 : ↥U₁) = - ∑ k ∈ Finset.range n, c₁ (k + 1) * x₁ ^ (k + 1) := by
          linear_combination hsum_U1
        have htail_max : ∑ k ∈ Finset.range n, c₁ (k + 1) * x₁ ^ (k + 1) ∈
            IsLocalRing.maximalIdeal ↥U₁ := by
          refine (IsLocalRing.maximalIdeal ↥U₁).sum_mem fun k hk => ?_
          have hk_lt : k < n := Finset.mem_range.mp hk
          exact Ideal.mul_mem_right _ _
            (hc₁_gt_max (k + 1) (by omega) (by omega))
        exact one_not_max_U1 (h1_eq ▸ (IsLocalRing.maximalIdeal ↥U₁).neg_mem htail_max)

      let L : ℕ := n - m_max
      have hmL : m_max + (L + 1) = n + 1 := by omega
      let y : F_WB := ∑ k ∈ Finset.range (L + 1), φ_F (a (m_max + k)) * x ^ k
      have hy_pow : y * x ^ m_max = - ∑ i ∈ Finset.range m_max, φ_F (a i) * x ^ i := by
        have hy_mul : y * x ^ m_max =
            ∑ k ∈ Finset.range (L + 1), φ_F (a (m_max + k)) * x ^ (m_max + k) := by
          rw [Finset.sum_mul]
          refine Finset.sum_congr rfl fun k _ => ?_
          rw [mul_assoc, ← pow_add, add_comm k m_max]
        have hsplit := Finset.sum_range_add (fun i => φ_F (a i) * x ^ i) m_max (L + 1)
        rw [hmL, hsum_zero, ← hy_mul] at hsplit
        linear_combination -hsplit
      let y₁ : ↥U₁ := ∑ k ∈ Finset.range (L + 1), c₁ (m_max + k) * x₁ ^ k
      have hy₁_val : y₁.1 = y := by
        change U₁.subtype y₁ = y
        rw [map_sum U₁.subtype]
        rfl
      have hy₁ : y ∈ U₁ := hy₁_val ▸ y₁.2
      have hy₁_not_max : (⟨y, hy₁⟩ : ↥U₁) ∉ IsLocalRing.maximalIdeal ↥U₁ := by
        have heq_y1 : (⟨y, hy₁⟩ : ↥U₁) = y₁ := Subtype.ext hy₁_val.symm
        rw [heq_y1]
        intro hy_max
        have hy_split : y₁ =
            (∑ k ∈ Finset.range L, c₁ (m_max + (k + 1)) * x₁ ^ (k + 1)) + 1 := by
          dsimp only [y₁]
          rw [Finset.sum_range_succ', add_zero, hc₁_m, pow_zero, mul_one]
        have hsum_max : ∑ k ∈ Finset.range L, c₁ (m_max + (k + 1)) * x₁ ^ (k + 1) ∈
            IsLocalRing.maximalIdeal ↥U₁ := by
          refine (IsLocalRing.maximalIdeal ↥U₁).sum_mem fun k hk => ?_
          have hk_lt : k < L := Finset.mem_range.mp hk
          exact Ideal.mul_mem_right _ _
            (hc₁_gt_max (m_max + (k + 1)) (by omega) (by omega))
        have h1_eq : (1 : ↥U₁) =
            y₁ - ∑ k ∈ Finset.range L, c₁ (m_max + (k + 1)) * x₁ ^ (k + 1) := by
          linear_combination -hy_split
        exact one_not_max_U1 (h1_eq ▸ (IsLocalRing.maximalIdeal ↥U₁).sub_mem hy_max hsum_max)

      
      have hy_and_yx_V' : ∀ V' : ValuationSubring F_WB, D_0 ≤ V'.toSubring →
          y ∈ V' ∧ y * x ∈ V' := by
        intro V' hD0_V'
        have hai_V' : ∀ i : ℕ, φ_F (a i) ∈ V' := fun i => hD0_V' (hW0_D0 (a i) (w i).2)
        by_cases hx_V' : x ∈ V'
        · have hy_V' : y ∈ V' :=
            V'.toSubring.sum_mem fun k _ =>
              V'.toSubring.mul_mem (hai_V' _) (V'.toSubring.pow_mem hx_V' k)
          exact ⟨hy_V', V'.toSubring.mul_mem hy_V' hx_V'⟩
        · have hx_ne : x ≠ 0 := fun h0 => hx_V' (h0 ▸ V'.zero_mem)
          have hx_inv_V' : x⁻¹ ∈ V' :=
            (ValuationSubring.mem_or_inv_mem V' x).resolve_left hx_V'
          have hy_inv_eq : y =
              - ∑ i ∈ Finset.range m_max, φ_F (a i) * (x⁻¹) ^ (m_max - i) := by
            have hlhs : y = (y * x ^ m_max) * (x⁻¹) ^ m_max := by
              rw [mul_assoc, ← mul_pow, mul_inv_cancel₀ hx_ne, one_pow, mul_one]
            calc y = (y * x ^ m_max) * (x⁻¹) ^ m_max := hlhs
              _ = (- ∑ i ∈ Finset.range m_max, φ_F (a i) * x ^ i) * (x⁻¹) ^ m_max := by
                    rw [hy_pow]
              _ = - ∑ i ∈ Finset.range m_max, (φ_F (a i) * x ^ i) * (x⁻¹) ^ m_max := by
                    rw [neg_mul, Finset.sum_mul]
              _ = - ∑ i ∈ Finset.range m_max, φ_F (a i) * (x⁻¹) ^ (m_max - i) := by
                    congr 1
                    refine Finset.sum_congr rfl fun i hi => ?_
                    have hi_lt : i < m_max := Finset.mem_range.mp hi
                    have hm_split : m_max = i + (m_max - i) := by omega
                    calc (φ_F (a i) * x ^ i) * (x⁻¹) ^ m_max
                        = φ_F (a i) * (x ^ i * (x⁻¹) ^ (i + (m_max - i))) := by
                            rw [← hm_split, mul_assoc]
                      _ = φ_F (a i) * ((x ^ i * (x⁻¹) ^ i) * (x⁻¹) ^ (m_max - i)) := by
                            rw [pow_add, mul_assoc]
                      _ = φ_F (a i) * (x⁻¹) ^ (m_max - i) := by
                            rw [← mul_pow, mul_inv_cancel₀ hx_ne, one_pow, one_mul]
          have hyx_inv_eq : y * x =
              - ∑ i ∈ Finset.range m_max, φ_F (a i) * (x⁻¹) ^ (m_max - 1 - i) := by
            have hm_pred : (m_max - 1) + 1 = m_max := by omega
            have hlhs_fac : (y * x) * x ^ (m_max - 1) = y * x ^ m_max := by
              calc (y * x) * x ^ (m_max - 1)
                  = y * (x ^ (m_max - 1) * x) := by ring
                _ = y * x ^ ((m_max - 1) + 1) := by rw [← pow_succ]
                _ = y * x ^ m_max := by rw [hm_pred]
            have hlhs2 : y * x = ((y * x) * x ^ (m_max - 1)) * (x⁻¹) ^ (m_max - 1) := by
              rw [mul_assoc, ← mul_pow, mul_inv_cancel₀ hx_ne, one_pow, mul_one]
            calc y * x = ((y * x) * x ^ (m_max - 1)) * (x⁻¹) ^ (m_max - 1) := hlhs2
              _ = (y * x ^ m_max) * (x⁻¹) ^ (m_max - 1) := by rw [hlhs_fac]
              _ = (- ∑ i ∈ Finset.range m_max, φ_F (a i) * x ^ i) * (x⁻¹) ^ (m_max - 1) := by
                    rw [hy_pow]
              _ = - ∑ i ∈ Finset.range m_max, (φ_F (a i) * x ^ i) * (x⁻¹) ^ (m_max - 1) := by
                    rw [neg_mul, Finset.sum_mul]
              _ = - ∑ i ∈ Finset.range m_max, φ_F (a i) * (x⁻¹) ^ (m_max - 1 - i) := by
                    congr 1
                    refine Finset.sum_congr rfl fun i hi => ?_
                    have hi_lt : i < m_max := Finset.mem_range.mp hi
                    have hm1_split : m_max - 1 = i + (m_max - 1 - i) := by omega
                    calc (φ_F (a i) * x ^ i) * (x⁻¹) ^ (m_max - 1)
                        = φ_F (a i) * (x ^ i * (x⁻¹) ^ (i + (m_max - 1 - i))) := by
                            rw [← hm1_split, mul_assoc]
                      _ = φ_F (a i) * ((x ^ i * (x⁻¹) ^ i) * (x⁻¹) ^ (m_max - 1 - i)) := by
                            rw [pow_add, mul_assoc]
                      _ = φ_F (a i) * (x⁻¹) ^ (m_max - 1 - i) := by
                            rw [← mul_pow, mul_inv_cancel₀ hx_ne, one_pow, one_mul]
          refine ⟨?_, ?_⟩
          · rw [hy_inv_eq]
            exact V'.toSubring.neg_mem
              (V'.toSubring.sum_mem fun i _ =>
                V'.toSubring.mul_mem (hai_V' i) (V'.toSubring.pow_mem hx_inv_V' _))
          · rw [hyx_inv_eq]
            exact V'.toSubring.neg_mem
              (V'.toSubring.sum_mem fun i _ =>
                V'.toSubring.mul_mem (hai_V' i) (V'.toSubring.pow_mem hx_inv_V' _))

      have hy_D0 : y ∈ D_0 := by
        by_contra hy_not
        obtain ⟨V', hD0_V', hy_not_V'⟩ :=
          Subring.exists_le_valuationSubring_of_isIntegrallyClosedIn hy_not
        exact hy_not_V' (hy_and_yx_V' V' hD0_V').1
      have hyx_D0 : y * x ∈ D_0 := by
        by_contra hyx_not
        obtain ⟨V', hD0_V', hyx_not_V'⟩ :=
          Subring.exists_le_valuationSubring_of_isIntegrallyClosedIn hyx_not
        exact hyx_not_V' (hy_and_yx_V' V' hD0_V').2
      have hy₂ : y ∈ U₂ := hU₂_D0 hy_D0
      have hyx₂ : y * x ∈ U₂ := hU₂_D0 hyx_D0
      have hy₂_not_max : (⟨y, hy₂⟩ : ↥U₂) ∉ IsLocalRing.maximalIdeal ↥U₂ :=
        mt (hUCenter y hy₁ hy₂ hy_D0).mpr hy₁_not_max
      rcases (IsLocalRing.notMem_maximalIdeal.mp hy₂_not_max).exists_right_inv with ⟨v₂, hv₂⟩
      have hv₂_val : y * v₂.1 = 1 := congrArg Subtype.val hv₂
      have hx_eq : x = (y * x) * v₂.1 := by
        calc x = x * (y * v₂.1) := by rw [hv₂_val, mul_one]
          _ = (y * x) * v₂.1 := by ring
      rw [hx_eq]
      exact U₂.toSubring.mul_mem hyx₂ v₂.2

    ext x
    exact ⟨hBourbakiSub W₁ W₂ hComap hle₁ hle₂ hWbar_D0 hCenter x,
      hBourbakiSub W₂ W₁ hComap.symm hle₂ hle₁
        (fun z hz => hWbar_D0 z (by change z ∈ W₁.comap φ_F; rwa [hComap]))
        (fun d hd₂ hd₁ hd => (hCenter d hd₁ hd₂ hd).symm) x⟩

  · 
    intro W hR u_W hMax_R huW_tr
    let W₀ : ValuationSubring F_0 := W.comap φ_F
    let j_W : ↥W₀ →+* ↥W := (φ_F.comp W₀.subtype).codRestrict W.toSubring (fun z => z.2)
    let ρ_0 : R_base →+* ↥W₀ := φ_RF0.codRestrict W₀.toSubring (fun r => hR r)
    let ρ_W : R_base →+* ↥W := (φ_F.comp φ_RF0).codRestrict W.toSubring hR
    have hMax_R0 : ∀ r : R_base,
        ρ_0 r ∈ IsLocalRing.maximalIdeal ↥W₀ ↔ r ∈ IsLocalRing.maximalIdeal R_base := by
      intro r
      rw [← jW_mem_max_iff W (ρ_0 r)]
      exact hMax_R r

    let k_base := R_base ⧸ IsLocalRing.maximalIdeal R_base
    let κ_W0 := ↥W₀ ⧸ IsLocalRing.maximalIdeal ↥W₀
    let κ_W := ↥W ⧸ IsLocalRing.maximalIdeal ↥W
    let _ : Field k_base := Ideal.Quotient.field (IsLocalRing.maximalIdeal R_base)
    let _ : Field κ_W0 := Ideal.Quotient.field (IsLocalRing.maximalIdeal ↥W₀)
    let _ : Field κ_W := Ideal.Quotient.field (IsLocalRing.maximalIdeal ↥W)
    let π_base : R_base →+* k_base := Ideal.Quotient.mk (IsLocalRing.maximalIdeal R_base)
    let π_W0 : ↥W₀ →+* κ_W0 := Ideal.Quotient.mk (IsLocalRing.maximalIdeal ↥W₀)
    let π_W : ↥W →+* κ_W := Ideal.Quotient.mk (IsLocalRing.maximalIdeal ↥W)
    let bar_ρ0 : k_base →+* κ_W0 :=
      Ideal.Quotient.lift (IsLocalRing.maximalIdeal R_base) (π_W0.comp ρ_0) (fun r hr =>
        Ideal.Quotient.eq_zero_iff_mem.mpr ((hMax_R0 r).mpr hr))
    let bar_jW : κ_W0 →+* κ_W :=
      Ideal.Quotient.lift (IsLocalRing.maximalIdeal ↥W₀) (π_W.comp j_W) (fun z hz =>
        Ideal.Quotient.eq_zero_iff_mem.mpr ((jW_mem_max_iff W z).mpr hz))
    let bar_ρW : k_base →+* κ_W := bar_jW.comp bar_ρ0
    let _ : Algebra k_base κ_W0 := bar_ρ0.toAlgebra
    let _ : Algebra κ_W0 κ_W := bar_jW.toAlgebra
    let _ : Algebra k_base κ_W := bar_ρW.toAlgebra
    have : IsScalarTower k_base κ_W0 κ_W := IsScalarTower.of_algebraMap_eq' rfl

    let bar_uW : κ_W := π_W u_W
    have hTrans_uW : Transcendental k_base bar_uW := by
      rintro ⟨P, hP_ne, hP_aeval⟩
      obtain ⟨Q, rfl⟩ := Polynomial.map_surjective π_base Ideal.Quotient.mk_surjective P
      have hex_j : ∃ j : ℕ, Q.coeff j ∉ IsLocalRing.maximalIdeal R_base := by
        by_contra h_no
        apply hP_ne
        ext j
        rw [Polynomial.coeff_map, Polynomial.coeff_zero, Ideal.Quotient.eq_zero_iff_mem]
        by_contra hj_not
        exact h_no ⟨j, hj_not⟩
      have hcomp_W : bar_ρW.comp π_base = π_W.comp ρ_W := RingHom.ext fun _ => rfl
      have heval_eq : Polynomial.aeval bar_uW (Polynomial.map π_base Q) =
          π_W (Polynomial.eval₂ ρ_W u_W Q) := by
        rw [Polynomial.aeval_def, Polynomial.eval₂_map]
        change Polynomial.eval₂ (bar_ρW.comp π_base) (π_W u_W) Q = _
        rw [hcomp_W, ← Polynomial.hom_eval₂]
      rw [heval_eq, Ideal.Quotient.eq_zero_iff_mem] at hP_aeval
      exact huW_tr Q hex_j hP_aeval

    have hAlg_uW : IsAlgebraic κ_W0 bar_uW := by
      obtain ⟨P, hP_ne, hP_aeval⟩ := Algebra.IsAlgebraic.isAlgebraic (R := F_0) u_W.1
      have hP_eval : Polynomial.eval₂ φ_F u_W.1 P = 0 := by rwa [Polynomial.aeval_def] at hP_aeval
      obtain ⟨i_star, hi_star_supp, hc_mem⟩ := exists_norm_coeff W₀ P hP_ne
      have hi_star_nz : P.coeff i_star ≠ 0 := Polynomial.mem_support_iff.mp hi_star_supp
      let n : ℕ := P.natDegree
      have hi_star_le : i_star ≤ n := Polynomial.le_natDegree_of_mem_supp _ hi_star_supp
      let c₀ : ℕ → ↥W₀ := fun i => ⟨P.coeff i * (P.coeff i_star)⁻¹, hc_mem i⟩
      let P_W0 : Polynomial ↥W₀ :=
        ∑ i ∈ Finset.range (n + 1), Polynomial.monomial i (c₀ i)
      let P_bar : Polynomial κ_W0 := Polynomial.map π_W0 P_W0
      have hPbar_ne : P_bar ≠ 0 := by
        intro h0
        have hcoeff0 : P_bar.coeff i_star = 0 := by rw [h0, Polynomial.coeff_zero]
        have hcoeff_W0 : P_W0.coeff i_star = 1 := by
          dsimp only [P_W0]
          rw [Polynomial.finsetSum_coeff]
          simp_rw [Polynomial.coeff_monomial]
          have hmem_range : i_star ∈ Finset.range (n + 1) :=
            Finset.mem_range.mpr (Nat.lt_succ_of_le hi_star_le)
          rw [Finset.sum_ite_eq' (Finset.range (n + 1)) i_star c₀]
          simp only [hmem_range, ↓reduceIte]
          exact Subtype.ext (mul_inv_cancel₀ hi_star_nz)
        have hcoeff1 : P_bar.coeff i_star = 1 := by
          dsimp only [P_bar]
          rw [Polynomial.coeff_map, hcoeff_W0, map_one]
        exact one_ne_zero (hcoeff1.symm.trans hcoeff0)
      have heval_W0 : Polynomial.eval₂ j_W u_W P_W0 = 0 := by
        apply Subtype.ext
        change W.subtype (Polynomial.eval₂ j_W u_W P_W0) = 0
        dsimp only [P_W0]
        rw [Polynomial.eval₂_finsetSum, map_sum W.subtype]
        have hterm : ∀ i : ℕ,
            W.subtype (Polynomial.eval₂ j_W u_W (Polynomial.monomial i (c₀ i))) =
              (φ_F (P.coeff i) * u_W.1 ^ i) * φ_F (P.coeff i_star)⁻¹ := by
          intro i
          rw [Polynomial.eval₂_monomial, map_mul, map_pow]
          change φ_F (P.coeff i * (P.coeff i_star)⁻¹) * u_W.1 ^ i = _
          rw [map_mul]
          ring
        simp_rw [hterm, ← Finset.sum_mul]
        have heval_sum : ∑ i ∈ Finset.range (n + 1), φ_F (P.coeff i) * u_W.1 ^ i =
            Polynomial.eval₂ φ_F u_W.1 P := (Polynomial.eval₂_eq_sum_range φ_F u_W.1).symm
        rw [heval_sum, hP_eval, zero_mul]
      refine ⟨P_bar, hPbar_ne, ?_⟩
      dsimp only [P_bar]
      rw [Polynomial.aeval_def, Polynomial.eval₂_map]
      have hcomp_jW : bar_jW.comp π_W0 = π_W.comp j_W := RingHom.ext fun _ => rfl
      change Polynomial.eval₂ (bar_jW.comp π_W0) (π_W u_W) P_W0 = 0
      rw [hcomp_jW, ← Polynomial.hom_eval₂, heval_W0, map_zero]

    have hex_bar_t1 : ∃ bar_t1 : κ_W0, Transcendental k_base bar_t1 := by
      by_contra h_none
      have : Algebra.IsIntegral k_base κ_W0 :=
        Algebra.isIntegral_def.mpr fun y => by
          have hy_alg : IsAlgebraic k_base y := by
            by_contra hy_tr
            exact h_none ⟨y, hy_tr⟩
          exact isAlgebraic_iff_isIntegral.mp hy_alg
      have hu_int_W0 : _root_.IsIntegral κ_W0 bar_uW := isAlgebraic_iff_isIntegral.mp hAlg_uW
      have hu_int_base : _root_.IsIntegral k_base bar_uW :=
        isIntegral_trans (A := κ_W0) bar_uW hu_int_W0
      exact hTrans_uW (isAlgebraic_iff_isIntegral.mpr hu_int_base)

    obtain ⟨bar_t1, hTrans_t1⟩ := hex_bar_t1
    obtain ⟨t_1, ht1_eq⟩ := Ideal.Quotient.mk_surjective bar_t1
    refine ⟨t_1, ?_⟩
    intro Q ⟨j, hj_not_max⟩ heval_mem
    let P_Q : Polynomial k_base := Polynomial.map π_base Q
    have hPQ_ne : P_Q ≠ 0 := by
      intro h0
      have hcj : P_Q.coeff j = 0 := by rw [h0, Polynomial.coeff_zero]
      rw [Polynomial.coeff_map, Ideal.Quotient.eq_zero_iff_mem] at hcj
      exact hj_not_max hcj
    apply hTrans_t1
    refine ⟨P_Q, hPQ_ne, ?_⟩
    dsimp only [P_Q]
    rw [← ht1_eq, Polynomial.aeval_def, Polynomial.eval₂_map]
    have hcomp_0 : bar_ρ0.comp π_base = π_W0.comp ρ_0 := RingHom.ext fun _ => rfl
    change Polynomial.eval₂ (bar_ρ0.comp π_base) (π_W0 t_1) Q = 0
    rw [hcomp_0, ← Polynomial.hom_eval₂, Ideal.Quotient.eq_zero_iff_mem]
    exact heval_mem

theorem weil_rational_funcField_gauss_uniqueness_and_linear_coset (K : Type u) [Field K] [IsSepClosed K]
    (R : ValuationSubring K)
    (hMax_R : IsLocalRing.maximalIdeal ↥R ≠ ⊥)
    (hDiv : ∀ (a : K), a ≠ 0 → ∀ (d : ℕ), 1 ≤ d →
      ∃ (b : K) (u : ↥R), IsUnit u ∧ b ^ d * R.subtype u = a)
    (F_0 : Type u) [Field F_0]
    (φ_KF0 : K →+* F_0) (T_0 : F_0)
    (hTrans_T0 : ∀ P : Polynomial ↥R, P ≠ 0 →
      Polynomial.eval₂ (φ_KF0.comp R.subtype) T_0 P ≠ 0)
    (hGen_F0 : ∀ z : F_0, ∃ P Q : Polynomial ↥R,
      Polynomial.eval₂ (φ_KF0.comp R.subtype) T_0 Q ≠ 0 ∧
      z * Polynomial.eval₂ (φ_KF0.comp R.subtype) T_0 Q =
        Polynomial.eval₂ (φ_KF0.comp R.subtype) T_0 P) :
    (∀ (c₁ π₁ c₂ π₂ : ↥R) (W₁ W₂ : ValuationSubring F_0)
       (hR₁ : ∀ r : ↥R, φ_KF0 (R.subtype r) ∈ W₁)
       (hR₂ : ∀ r : ↥R, φ_KF0 (R.subtype r) ∈ W₂)
       (w₁ : ↥W₁) (w₂ : ↥W₂),
      π₁ ≠ 0 → π₂ ≠ 0 →
      IsValDiscEq ↥R c₁ π₁ c₂ π₂ →
      (∀ r : ↥R,
        (⟨φ_KF0 (R.subtype r), hR₁ r⟩ : ↥W₁) ∈ IsLocalRing.maximalIdeal ↥W₁ ↔
          r ∈ IsLocalRing.maximalIdeal ↥R) →
      (∀ r : ↥R,
        (⟨φ_KF0 (R.subtype r), hR₂ r⟩ : ↥W₂) ∈ IsLocalRing.maximalIdeal ↥W₂ ↔
          r ∈ IsLocalRing.maximalIdeal ↥R) →
      φ_KF0 (R.subtype π₁) * W₁.subtype w₁ = T_0 - φ_KF0 (R.subtype c₁) →
      φ_KF0 (R.subtype π₂) * W₂.subtype w₂ = T_0 - φ_KF0 (R.subtype c₂) →
      (∀ Q : Polynomial ↥R,
        (∃ j : ℕ, Q.coeff j ∉ IsLocalRing.maximalIdeal ↥R) →
        Polynomial.eval₂ ((φ_KF0.comp R.subtype).codRestrict W₁.toSubring hR₁) w₁ Q ∉
          IsLocalRing.maximalIdeal ↥W₁) →
      (∀ Q : Polynomial ↥R,
        (∃ j : ℕ, Q.coeff j ∉ IsLocalRing.maximalIdeal ↥R) →
        Polynomial.eval₂ ((φ_KF0.comp R.subtype).codRestrict W₂.toSubring hR₂) w₂ Q ∉
          IsLocalRing.maximalIdeal ↥W₂) →
      W₁ = W₂) ∧
    (∀ (W_0 : ValuationSubring F_0)
       (hR0 : ∀ r : ↥R, φ_KF0 (R.subtype r) ∈ W_0)
       (hT0 : T_0 ∈ W_0)
       (t_1 : ↥W_0),
      (∀ r : ↥R,
        (⟨φ_KF0 (R.subtype r), hR0 r⟩ : ↥W_0) ∈ IsLocalRing.maximalIdeal ↥W_0 ↔
          r ∈ IsLocalRing.maximalIdeal ↥R) →
      (⟨T_0, hT0⟩ : ↥W_0) ∈ IsLocalRing.maximalIdeal ↥W_0 →
      (∀ Q : Polynomial ↥R,
        (∃ j : ℕ, Q.coeff j ∉ IsLocalRing.maximalIdeal ↥R) →
        Polynomial.eval₂ ((φ_KF0.comp R.subtype).codRestrict W_0.toSubring hR0) t_1 Q ∉
          IsLocalRing.maximalIdeal ↥W_0) →
      ∃ (c_E π_E : ↥R) (w_0 : ↥W_0),
        c_E ∈ IsLocalRing.maximalIdeal ↥R ∧
        π_E ∈ IsLocalRing.maximalIdeal ↥R ∧
        π_E ≠ 0 ∧
        φ_KF0 (R.subtype π_E) * W_0.subtype w_0 = T_0 - φ_KF0 (R.subtype c_E) ∧
        ∀ Q : Polynomial ↥R,
          (∃ j : ℕ, Q.coeff j ∉ IsLocalRing.maximalIdeal ↥R) →
          Polynomial.eval₂ ((φ_KF0.comp R.subtype).codRestrict W_0.toSubring hR0) w_0 Q ∉
            IsLocalRing.maximalIdeal ↥W_0) :=
by
  classical
  let ι_R : ↥R →+* F_0 := φ_KF0.comp R.subtype
  have one_not_mem_maxR : (1 : ↥R) ∉ IsLocalRing.maximalIdeal ↥R := fun h1 =>
    (IsLocalRing.maximalIdeal.isMaximal ↥R).ne_top (Ideal.eq_top_iff_one _ |>.mpr h1)
  have hK_mem : ∀ (W : ValuationSubring F_0)
      (hR : ∀ r : ↥R, φ_KF0 (R.subtype r) ∈ W)
      (_ : ∀ r : ↥R,
        (⟨φ_KF0 (R.subtype r), hR r⟩ : ↥W) ∈ IsLocalRing.maximalIdeal ↥W ↔
          r ∈ IsLocalRing.maximalIdeal ↥R)
      (z : K), φ_KF0 z ∈ W → z ∈ R := by
    intro W hR hMax z hzW
    by_contra hzR
    have hz0 : z ≠ 0 := fun h0 => hzR (h0 ▸ R.zero_mem)
    rcases ValuationSubring.mem_or_inv_mem R z with hz | hz_inv
    · exact hzR hz
    · let r_inv : ↥R := ⟨z⁻¹, hz_inv⟩
      have hr_max : r_inv ∈ IsLocalRing.maximalIdeal ↥R := by
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
        intro hu
        rcases hu.exists_right_inv with ⟨y, hy⟩
        have hy_val : z⁻¹ * y.1 = 1 := congrArg Subtype.val hy
        have hy_eq : y.1 = z := by
          calc y.1 = z * (z⁻¹ * y.1) := by rw [← mul_assoc, mul_inv_cancel₀ hz0, one_mul]
            _ = z := by rw [hy_val, mul_one]
        exact hzR (hy_eq ▸ y.2)
      have hw_max : (⟨φ_KF0 (R.subtype r_inv), hR r_inv⟩ : ↥W) ∈ IsLocalRing.maximalIdeal ↥W :=
        (hMax r_inv).mpr hr_max
      have h1_eq : (⟨φ_KF0 z, hzW⟩ : ↥W) * ⟨φ_KF0 (R.subtype r_inv), hR r_inv⟩ = 1 := by
        apply Subtype.ext
        change φ_KF0 z * φ_KF0 z⁻¹ = 1
        rw [← map_mul, mul_inv_cancel₀ hz0, map_one]
      have h1_max : (1 : ↥W) ∈ IsLocalRing.maximalIdeal ↥W := by
        rw [← h1_eq]
        exact Ideal.mul_mem_left _ _ hw_max
      exact (IsLocalRing.maximalIdeal.isMaximal ↥W).ne_top (Ideal.eq_top_iff_one _ |>.mpr h1_max)
  have polyK_factor : ∀ (F : Polynomial K), F ≠ 0 →
      ∃ (c_F : K) (Q_F : Polynomial ↥R),
        c_F ≠ 0 ∧
        (∃ j : ℕ, Q_F.coeff j ∉ IsLocalRing.maximalIdeal ↥R) ∧
        F = Polynomial.C c_F * Q_F.map R.subtype := by
    intro F hF
    obtain ⟨j₀, hj₀_mem, hj₀_max⟩ :=
      Finset.exists_max_image F.support (fun j => R.valuation (F.coeff j))
        (Polynomial.support_nonempty.mpr hF)
    let c_F : K := F.coeff j₀
    have hc_F : c_F ≠ 0 := Polynomial.mem_support_iff.mp hj₀_mem
    have hvc_F : R.valuation c_F ≠ 0 := (Valuation.ne_zero_iff R.valuation).mpr hc_F
    have hcoeff_mem : ∀ j : ℕ, F.coeff j * c_F⁻¹ ∈ R := by
      intro j
      rw [← R.valuation_le_one_iff]
      have hle : R.valuation (F.coeff j) ≤ R.valuation c_F := by
        by_cases hj : j ∈ F.support
        · exact hj₀_max j hj
        · have hj0 : F.coeff j = 0 :=
            Classical.not_not.mp fun hne => hj (Polynomial.mem_support_iff.mpr hne)
          rw [hj0, Valuation.map_zero]
          exact zero_le
      calc R.valuation (F.coeff j * c_F⁻¹)
          = R.valuation (F.coeff j) * (R.valuation c_F)⁻¹ := by
              rw [Valuation.map_mul, map_inv₀]
        _ ≤ R.valuation c_F * (R.valuation c_F)⁻¹ :=
              mul_le_mul_of_nonneg_right hle zero_le
        _ = 1 := mul_inv_cancel₀ hvc_F
    let Q_F : Polynomial ↥R :=
      ∑ j ∈ F.support, Polynomial.monomial j ⟨F.coeff j * c_F⁻¹, hcoeff_mem j⟩
    have hQF_j0 : Q_F.coeff j₀ = 1 := by
      rw [Polynomial.finsetSum_coeff]
      simp only [Polynomial.coeff_monomial, Finset.sum_ite_eq', hj₀_mem, ↓reduceIte]
      exact Subtype.ext (mul_inv_cancel₀ hc_F)
    refine ⟨c_F, Q_F, hc_F, ⟨j₀, hQF_j0 ▸ one_not_mem_maxR⟩, ?_⟩
    ext k
    rw [Polynomial.coeff_C_mul, Polynomial.coeff_map, Polynomial.finsetSum_coeff]
    simp only [Polynomial.coeff_monomial, Finset.sum_ite_eq']
    split_ifs with hk
    · change F.coeff k = c_F * (F.coeff k * c_F⁻¹)
      calc F.coeff k = (F.coeff k * c_F⁻¹) * c_F := by
            rw [mul_assoc, inv_mul_cancel₀ hc_F, mul_one]
        _ = c_F * (F.coeff k * c_F⁻¹) := mul_comm _ _
    · have hk0 : F.coeff k = 0 :=
        Classical.not_not.mp fun hne => hk (Polynomial.mem_support_iff.mpr hne)
      rw [hk0, map_zero, mul_zero]
  have polyR_factor : ∀ (G : Polynomial ↥R), G ≠ 0 →
      ∃ (a_G : ↥R) (G_0 : Polynomial ↥R),
        a_G ≠ 0 ∧
        (∃ j : ℕ, G_0.coeff j ∉ IsLocalRing.maximalIdeal ↥R) ∧
        G = Polynomial.C a_G * G_0 := by
    intro G hG
    obtain ⟨j₀, hj₀_mem, hj₀_max⟩ :=
      Finset.exists_max_image G.support (fun j => R.valuation (R.subtype (G.coeff j)))
        (Polynomial.support_nonempty.mpr hG)
    let a_G : ↥R := G.coeff j₀
    have ha_G : a_G ≠ 0 := Polynomial.mem_support_iff.mp hj₀_mem
    have ha_GK : R.subtype a_G ≠ 0 := fun h => ha_G (Subtype.ext h)
    have hva_G : R.valuation (R.subtype a_G) ≠ 0 :=
      (Valuation.ne_zero_iff R.valuation).mpr ha_GK
    have hcoeff_mem : ∀ j : ℕ, R.subtype (G.coeff j) * (R.subtype a_G)⁻¹ ∈ R := by
      intro j
      rw [← R.valuation_le_one_iff]
      have hle : R.valuation (R.subtype (G.coeff j)) ≤ R.valuation (R.subtype a_G) := by
        by_cases hj : j ∈ G.support
        · exact hj₀_max j hj
        · have hj0 : G.coeff j = 0 :=
            Classical.not_not.mp fun hne => hj (Polynomial.mem_support_iff.mpr hne)
          rw [hj0, map_zero, Valuation.map_zero]
          exact zero_le
      calc R.valuation (R.subtype (G.coeff j) * (R.subtype a_G)⁻¹)
          = R.valuation (R.subtype (G.coeff j)) * (R.valuation (R.subtype a_G))⁻¹ := by
              rw [Valuation.map_mul, map_inv₀]
        _ ≤ R.valuation (R.subtype a_G) * (R.valuation (R.subtype a_G))⁻¹ :=
              mul_le_mul_of_nonneg_right hle zero_le
        _ = 1 := mul_inv_cancel₀ hva_G
    let G_0 : Polynomial ↥R :=
      ∑ j ∈ G.support,
        Polynomial.monomial j ⟨R.subtype (G.coeff j) * (R.subtype a_G)⁻¹, hcoeff_mem j⟩
    have hG0_j0 : G_0.coeff j₀ = 1 := by
      rw [Polynomial.finsetSum_coeff]
      simp only [Polynomial.coeff_monomial, Finset.sum_ite_eq', hj₀_mem, ↓reduceIte]
      exact Subtype.ext (mul_inv_cancel₀ ha_GK)
    refine ⟨a_G, G_0, ha_G, ⟨j₀, hG0_j0 ▸ one_not_mem_maxR⟩, ?_⟩
    ext k
    rw [Polynomial.coeff_C_mul, Polynomial.finsetSum_coeff]
    simp only [Polynomial.coeff_monomial, Finset.sum_ite_eq']
    split_ifs with hk
    · change R.subtype (G.coeff k) = R.subtype a_G * (R.subtype (G.coeff k) * (R.subtype a_G)⁻¹)
      calc R.subtype (G.coeff k)
          = (R.subtype (G.coeff k) * (R.subtype a_G)⁻¹) * R.subtype a_G := by
              rw [mul_assoc, inv_mul_cancel₀ ha_GK, mul_one]
        _ = R.subtype a_G * (R.subtype (G.coeff k) * (R.subtype a_G)⁻¹) := mul_comm _ _
    · have hk0 : G.coeff k = 0 :=
        Classical.not_not.mp fun hne => hk (Polynomial.mem_support_iff.mpr hne)
      rw [hk0, mul_zero]
  have hTrans_K : ∀ (F : Polynomial K), F ≠ 0 → Polynomial.eval₂ φ_KF0 T_0 F ≠ 0 := by
    intro F hF
    obtain ⟨c_F, Q_F, hc_F, ⟨j₀, hj₀⟩, hF_eq⟩ := polyK_factor F hF
    have hQF_ne : Q_F ≠ 0 := by
      intro h0
      rw [h0, Polynomial.coeff_zero] at hj₀
      exact hj₀ (Ideal.zero_mem _)
    rw [hF_eq, Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_map]
    exact mul_ne_zero ((map_ne_zero φ_KF0).mpr hc_F) (hTrans_T0 Q_F hQF_ne)
  
  have hBivarRel : ∀ (A₁ B₁ A₂ B₂ : Polynomial K) (x₁ x₂ : F_0),
      Polynomial.eval₂ φ_KF0 T_0 B₁ ≠ 0 →
      Polynomial.eval₂ φ_KF0 T_0 B₂ ≠ 0 →
      Polynomial.eval₂ φ_KF0 T_0 A₁ = x₁ * Polynomial.eval₂ φ_KF0 T_0 B₁ →
      Polynomial.eval₂ φ_KF0 T_0 A₂ = x₂ * Polynomial.eval₂ φ_KF0 T_0 B₂ →
      ∃ (N : ℕ) (P_j : Fin (N + 1) → Polynomial K),
        (∃ j₀ : Fin (N + 1), P_j j₀ ≠ 0) ∧
        (∑ j : Fin (N + 1), Polynomial.eval₂ φ_KF0 x₁ (P_j j) * x₂ ^ j.1) = 0 := by
    intro A₁ B₁ A₂ B₂ x₁ x₂ hβ₁ hβ₂ hA₁_ev hA₂_ev
    obtain ⟨β₁, hβ₁_def⟩ : ∃ β₁ : F_0, β₁ = Polynomial.eval₂ φ_KF0 T_0 B₁ := ⟨_, rfl⟩
    obtain ⟨β₂, hβ₂_def⟩ : ∃ β₂ : F_0, β₂ = Polynomial.eval₂ φ_KF0 T_0 B₂ := ⟨_, rfl⟩
    rw [← hβ₁_def] at hβ₁ hA₁_ev
    rw [← hβ₂_def] at hβ₂ hA₂_ev
    obtain ⟨d, hdA₁, hdB₁, hdA₂, hdB₂⟩ :
        ∃ d : ℕ, A₁.natDegree ≤ d ∧ B₁.natDegree ≤ d ∧
          A₂.natDegree ≤ d ∧ B₂.natDegree ≤ d :=
      ⟨max (max A₁.natDegree B₁.natDegree) (max A₂.natDegree B₂.natDegree),
        le_trans (le_max_left _ _) (le_max_left _ _),
        le_trans (le_max_right _ _) (le_max_left _ _),
        le_trans (le_max_left _ _) (le_max_right _ _),
        le_trans (le_max_right _ _) (le_max_right _ _)⟩
    obtain ⟨N, hN⟩ : ∃ N : ℕ, N = 2 * d + 1 := ⟨2 * d + 1, rfl⟩
    obtain ⟨D, hD⟩ : ∃ D : ℕ, D = 4 * d ^ 2 + 2 * d := ⟨4 * d ^ 2 + 2 * d, rfl⟩
    obtain ⟨M, hM_def⟩ : ∃ M : Fin (N + 1) × Fin (N + 1) → Polynomial K,
        ∀ p, M p = A₁ ^ p.1.1 * B₁ ^ (N - p.1.1) * A₂ ^ p.2.1 * B₂ ^ (N - p.2.1) :=
      ⟨fun p => A₁ ^ p.1.1 * B₁ ^ (N - p.1.1) * A₂ ^ p.2.1 * B₂ ^ (N - p.2.1), fun _ => rfl⟩
    have hM_deg : ∀ p : Fin (N + 1) × Fin (N + 1), (M p).natDegree ≤ D := by
      intro p
      have hi : p.1.1 ≤ N := Nat.le_of_lt_succ p.1.2
      have hj : p.2.1 ≤ N := Nat.le_of_lt_succ p.2.2
      rw [hM_def p]
      have hdeg1 : (A₁ ^ p.1.1 * B₁ ^ (N - p.1.1)).natDegree ≤ p.1.1 * d + (N - p.1.1) * d :=
        le_trans Polynomial.natDegree_mul_le
          (add_le_add (le_trans Polynomial.natDegree_pow_le (Nat.mul_le_mul_left _ hdA₁))
            (le_trans Polynomial.natDegree_pow_le (Nat.mul_le_mul_left _ hdB₁)))
      have hdeg2 : (A₁ ^ p.1.1 * B₁ ^ (N - p.1.1) * A₂ ^ p.2.1).natDegree ≤
          p.1.1 * d + (N - p.1.1) * d + p.2.1 * d :=
        le_trans Polynomial.natDegree_mul_le
          (add_le_add hdeg1 (le_trans Polynomial.natDegree_pow_le (Nat.mul_le_mul_left _ hdA₂)))
      have hdeg3 : (A₁ ^ p.1.1 * B₁ ^ (N - p.1.1) * A₂ ^ p.2.1 * B₂ ^ (N - p.2.1)).natDegree ≤
          p.1.1 * d + (N - p.1.1) * d + p.2.1 * d + (N - p.2.1) * d :=
        le_trans Polynomial.natDegree_mul_le
          (add_le_add hdeg2 (le_trans Polynomial.natDegree_pow_le (Nat.mul_le_mul_left _ hdB₂)))
      refine le_trans hdeg3 (le_of_eq ?_)
      have h1 : p.1.1 + (N - p.1.1) = N := Nat.add_sub_of_le hi
      have h2 : p.2.1 + (N - p.2.1) = N := Nat.add_sub_of_le hj
      calc p.1.1 * d + (N - p.1.1) * d + p.2.1 * d + (N - p.2.1) * d
          = (p.1.1 + (N - p.1.1)) * d + (p.2.1 + (N - p.2.1)) * d := by ring
        _ = N * d + N * d := by rw [h1, h2]
        _ = D := by rw [hD, hN]; ring
    let v_vec : Fin (N + 1) × Fin (N + 1) → (Fin (D + 1) → K) :=
      fun p k => (M p).coeff k.1
    have hv_not_ind : ¬ LinearIndependent K v_vec := by
      intro hv
      have hcard := hv.fintype_card_le_finrank
      rw [Fintype.card_prod, Fintype.card_fin, Module.finrank_fintype_fun_eq_card,
        Fintype.card_fin, hN, hD] at hcard
      nlinarith
    obtain ⟨lam, hlam_sum, p₀, hlam₀⟩ := Fintype.not_linearIndependent_iff.mp hv_not_ind
    have hpoly_zero : (∑ p : Fin (N + 1) × Fin (N + 1), Polynomial.C (lam p) * M p) = 0 := by
      ext k
      rw [Polynomial.finsetSum_coeff, Polynomial.coeff_zero]
      simp only [Polynomial.coeff_C_mul]
      by_cases hk : k < D + 1
      · have hval := congrFun hlam_sum ⟨k, hk⟩
        simpa [v_vec, Finset.sum_apply, smul_eq_mul] using hval
      · refine Finset.sum_eq_zero fun p _ => ?_
        have hgt : (M p).natDegree < k := Nat.lt_of_le_of_lt (hM_deg p) (by omega)
        rw [Polynomial.coeff_eq_zero_of_natDegree_lt hgt, mul_zero]
    have hev_zero :
        (∑ p : Fin (N + 1) × Fin (N + 1),
          φ_KF0 (lam p) * x₁ ^ p.1.1 * x₂ ^ p.2.1) = 0 := by
      have h0 : Polynomial.eval₂ φ_KF0 T_0
          (∑ p : Fin (N + 1) × Fin (N + 1), Polynomial.C (lam p) * M p) = 0 := by
        rw [hpoly_zero, Polynomial.eval₂_zero]
      rw [Polynomial.eval₂_finsetSum] at h0
      have hterm : ∀ p : Fin (N + 1) × Fin (N + 1),
          Polynomial.eval₂ φ_KF0 T_0 (Polynomial.C (lam p) * M p) =
            (φ_KF0 (lam p) * x₁ ^ p.1.1 * x₂ ^ p.2.1) * (β₁ ^ N * β₂ ^ N) := by
        intro p
        have hi : p.1.1 ≤ N := Nat.le_of_lt_succ p.1.2
        have hj : p.2.1 ≤ N := Nat.le_of_lt_succ p.2.2
        rw [hM_def p]
        simp only [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_pow,
          hA₁_ev, hA₂_ev, ← hβ₁_def, ← hβ₂_def]
        rw [mul_pow, mul_pow]
        have hβ₁_pow : β₁ ^ p.1.1 * β₁ ^ (N - p.1.1) = β₁ ^ N := by
          rw [← pow_add, Nat.add_sub_of_le hi]
        have hβ₂_pow : β₂ ^ p.2.1 * β₂ ^ (N - p.2.1) = β₂ ^ N := by
          rw [← pow_add, Nat.add_sub_of_le hj]
        calc φ_KF0 (lam p) *
              (((x₁ ^ p.1.1 * β₁ ^ p.1.1) * β₁ ^ (N - p.1.1) *
                (x₂ ^ p.2.1 * β₂ ^ p.2.1)) * β₂ ^ (N - p.2.1))
            = (φ_KF0 (lam p) * x₁ ^ p.1.1 * x₂ ^ p.2.1) *
                ((β₁ ^ p.1.1 * β₁ ^ (N - p.1.1)) * (β₂ ^ p.2.1 * β₂ ^ (N - p.2.1))) := by ring
          _ = (φ_KF0 (lam p) * x₁ ^ p.1.1 * x₂ ^ p.2.1) *
                (β₁ ^ N * β₂ ^ N) := by rw [hβ₁_pow, hβ₂_pow]
      simp_rw [hterm, ← Finset.sum_mul] at h0
      exact (mul_eq_zero.mp h0).resolve_right
        (mul_ne_zero (pow_ne_zero N hβ₁) (pow_ne_zero N hβ₂))
    let P_j : Fin (N + 1) → Polynomial K :=
      fun j => ∑ i : Fin (N + 1), Polynomial.monomial i.1 (lam (i, j))
    have hPj0_ne : P_j p₀.2 ≠ 0 := by
      intro h0
      have hcoeff : (P_j p₀.2).coeff p₀.1.1 = lam p₀ := by
        simp only [P_j, Polynomial.finsetSum_coeff, Polynomial.coeff_monomial]
        have h_ite : ∀ i : Fin (N + 1),
            (if i.1 = p₀.1.1 then lam (i, p₀.2) else 0) =
              if i = p₀.1 then lam (i, p₀.2) else 0 :=
          fun i => if_congr Fin.ext_iff.symm rfl rfl
        simp_rw [h_ite]
        simp [Finset.sum_ite_eq']
      rw [h0, Polynomial.coeff_zero] at hcoeff
      exact hlam₀ hcoeff.symm
    refine ⟨N, P_j, ⟨p₀.2, hPj0_ne⟩, ?_⟩
    rw [Fintype.sum_prod_type_right] at hev_zero
    rw [← hev_zero]
    refine Finset.sum_congr rfl fun j _ => ?_
    simp only [P_j, Polynomial.eval₂_finsetSum, Polynomial.eval₂_monomial, Finset.sum_mul]
  refine ⟨?_, ?_⟩
  · 
    intro c₁ π₁ c₂ π₂ W₁ W₂ hR₁ hR₂ w₁ w₂ hπ₁ hπ₂ hEq hMax₁ hMax₂ hw₁ hw₂ hQ₁ hQ₂
    rcases hEq with ⟨⟨⟨r₁, hr₁⟩, ⟨s₁, hs₁⟩⟩, ⟨⟨r₂, hr₂⟩, _⟩⟩
    have hr₁₂ : r₁ * r₂ = 1 := by
      apply mul_right_cancel₀ hπ₁
      calc (r₁ * r₂) * π₁ = r₁ * (r₂ * π₁) := mul_assoc r₁ r₂ π₁
        _ = r₁ * π₂ := by rw [hr₂]
        _ = π₁ := hr₁.symm
        _ = 1 * π₁ := (one_mul π₁).symm
    have hr₂₁ : r₂ * r₁ = 1 := by rw [mul_comm, hr₁₂]
    have hπ₁_K : R.subtype π₁ ≠ 0 := fun h => hπ₁ (Subtype.ext h)
    have hφπ₁_ne : φ_KF0 (R.subtype π₁) ≠ 0 := (map_ne_zero φ_KF0).mpr hπ₁_K
    have hw₁_eq_W₂ : W₁.subtype w₁ =
        φ_KF0 (R.subtype r₂) * W₂.subtype w₂ - φ_KF0 (R.subtype (r₂ * s₁)) := by
      apply mul_left_cancel₀ hφπ₁_ne
      have hπ₂_map : φ_KF0 (R.subtype π₂) = φ_KF0 (R.subtype r₂) * φ_KF0 (R.subtype π₁) := by
        rw [hr₂, map_mul, map_mul]
      have hc_diff : φ_KF0 (R.subtype c₁) - φ_KF0 (R.subtype c₂) =
          φ_KF0 (R.subtype s₁) * φ_KF0 (R.subtype π₂) := by
        calc φ_KF0 (R.subtype c₁) - φ_KF0 (R.subtype c₂)
            = φ_KF0 (R.subtype (c₁ - c₂)) := by rw [map_sub, map_sub]
          _ = φ_KF0 (R.subtype (s₁ * π₂)) := by rw [hs₁]
          _ = φ_KF0 (R.subtype s₁) * φ_KF0 (R.subtype π₂) := by rw [map_mul, map_mul]
      have hrs_map : φ_KF0 (R.subtype (r₂ * s₁)) =
          φ_KF0 (R.subtype r₂) * φ_KF0 (R.subtype s₁) := by
        rw [map_mul, map_mul]
      calc φ_KF0 (R.subtype π₁) * W₁.subtype w₁
          = (T_0 - φ_KF0 (R.subtype c₂)) -
              (φ_KF0 (R.subtype c₁) - φ_KF0 (R.subtype c₂)) := by rw [hw₁]; ring
        _ = φ_KF0 (R.subtype π₂) * W₂.subtype w₂ -
              φ_KF0 (R.subtype s₁) * φ_KF0 (R.subtype π₂) := by rw [hw₂, hc_diff]
        _ = φ_KF0 (R.subtype π₁) *
              (φ_KF0 (R.subtype r₂) * W₂.subtype w₂ - φ_KF0 (R.subtype (r₂ * s₁))) := by
