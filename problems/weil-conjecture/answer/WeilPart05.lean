  have hFunc_WB : IsSchemeFunctionField W_B.toScheme F_WB η_WB :=
    isSchemeFunctionField_of_single W_B.toScheme hSS_WB.1 F_WB η_WB
      ⊤ h_top_WB h_top_WB_ne φ_WB_top hFrac_WB_top rfl

  
  let F_0 : Type u := FractionRing (Polynomial K)
  let φ_KF0 : K →+* F_0 := (algebraMap (Polynomial K) F_0).comp Polynomial.C
  let T_0 : F_0 := algebraMap (Polynomial K) F_0 Polynomial.X
