      calc ξ₁ = ξ₁' ≫ U_int.ι := (AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ _).symm
        _ = η_X' ≫ U_int.ι := by rw [hξ₁_eq_ηX']
        _ = η_X := AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ _
    
    have hIrred_X : IrreducibleSpace ↥X := AlgebraicGeometry.irreducibleSpace_of_isIntegral X
    let x_gen : ↥X := genericPoint ↥X
    have hGerm_spec : ∀ (W_X : X.Opens) (hWX : AlgebraicGeometry.IsAffineOpen W_X)
        [Nonempty W_X],
        AlgebraicGeometry.Spec.map (X.germToFunctionField W_X) ≫ hWX.fromSpec =
          X.fromSpecStalk x_gen := by
      intro W_X hWX hWX_inst
      have hWX_ne : Nonempty ↥W_X := hWX_inst
      obtain ⟨w₀, hw₀⟩ := hWX_ne
