        _ = g := by rw [inv_mul_cancel₀ hφbK_ne, mul_one]
    
    let m_R := IsLocalRing.maximalIdeal ↥R
    let m_W := IsLocalRing.maximalIdeal ↥W_0
    let k_R := ↥R ⧸ m_R
    let κ_0 := ↥W_0 ⧸ m_W
    let _ : Field k_R := Ideal.Quotient.field m_R
    let _ : Field κ_0 := Ideal.Quotient.field m_W
    let π_R : ↥R →+* k_R := Ideal.Quotient.mk m_R
    let π_W : ↥W_0 →+* κ_0 := Ideal.Quotient.mk m_W
    let ι_bar0 : k_R →+* κ_0 :=
