        exact Set.mem_singleton_iff.mp hmem
      rw [← hx0_img]
      have hfst_comm : (CategoryTheory.Limits.pullback.fst g_X0 s_R).base
            (α_hat_R.base (p_nb k_root w₀)) =
          α_hat.base ((CategoryTheory.Limits.pullback.fst g_Xhat s_R).base (p_nb k_root w₀)) := by
        change (α_hat_R ≫ CategoryTheory.Limits.pullback.fst g_X0 s_R).base _ =
          (CategoryTheory.Limits.pullback.fst g_Xhat s_R ≫ α_hat).base _
        rw [CategoryTheory.Limits.pullback.lift_fst]
      rw [hfst_comm]
      change (α_hat ≫ f_0).base _ = u₀_WB
      rw [hαhat_f]
      exact (hEXhat_nonbd k_root (hv_arr_nb 0)).2.2.1 _ hp0_in
    have hFunc_X0' : IsSchemeFunctionField X_0.toScheme F_WB (η_Xhat ≫ α_hat) := by
      rwa [hη_αhat]
    refine hBranchBound X_hat X_0.toScheme g_Xhat g_X0 α_hat η_Xhat hαhat_g
      hSS_Xhat hSS_X0 hFunc_Xhat hFunc_X0' hProp_αhat ⟨x_star, p_arr, B_arr, hx_star_cl, hp_inj, ?_⟩
    intro b
    obtain ⟨hBb_irred, _, hpb_in_v, hpb_in_B, hBb_nonbd, hBb_bd, hBb_nod⟩ :=
      hHnb_props (v_arr b) (w_arr b) (hv_arr_nb b) (hEdge_arr b)
    have hpb_img : α_hat_R.base (p_arr b) = x_star := by
      rw [← hx_arr b]
      have hmem : α_hat_R.base (p_arr b) ∈ ({x_of (v_arr b) (hv_arr_not b)} : Set ↥Y_X0) := by
        rw [← hx_of_eq (v_arr b) (hv_arr_not b)]
        exact ⟨p_arr b, hpb_in_v, rfl⟩
      exact Set.mem_singleton_iff.mp hmem
    have hBb_nonconst : ∃ q ∈ B_arr b, α_hat_R.base q ≠ x_star := by
      by_cases hw_bd : IsDiscBoundaryIdx ↥R a_opt (c (w_arr b)) (π (w_arr b))
      · obtain ⟨q, hq_B, hq_ne⟩ := hBb_bd hw_bd
        refine ⟨q, hq_B, ?_⟩
        intro hq_eq
        apply hq_ne
        have hfst_comm : (CategoryTheory.Limits.pullback.fst g_X0 s_R).base (α_hat_R.base q) =
            α_hat.base ((CategoryTheory.Limits.pullback.fst g_Xhat s_R).base q) := by
          change (α_hat_R ≫ CategoryTheory.Limits.pullback.fst g_X0 s_R).base q =
            (CategoryTheory.Limits.pullback.fst g_Xhat s_R ≫ α_hat).base q
          rw [CategoryTheory.Limits.pullback.lift_fst]
        have hf_eq : f_0.base ((CategoryTheory.Limits.pullback.fst g_X0 s_R).base
              (α_hat_R.base q)) =
            f_Xhat.base ((CategoryTheory.Limits.pullback.fst g_Xhat s_R).base q) := by
          rw [hfst_comm]
