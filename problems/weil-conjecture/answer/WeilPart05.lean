    refine ⟨?_, ?_⟩
    · intro u hu_cl hu_Q
      rw [hcl_eq_range] at hu_cl
      obtain ⟨q, rfl⟩ := hu_cl
      have hcomap_eq :
          Ideal.comap (Ideal.Quotient.mk Q.asIdeal) q.asIdeal =
            Ideal.comap (Ideal.Quotient.mk Q.asIdeal) (⊥ : Ideal (↥R ⧸ Q.asIdeal)) := by
        have hlhs : Ideal.comap (Ideal.Quotient.mk Q.asIdeal) q.asIdeal =
            (g_X.base (σ_x.base q)).asIdeal := by
          change ((AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (Ideal.Quotient.mk Q.asIdeal))).base q).asIdeal =
            ((σ_x ≫ g_X).base q).asIdeal
