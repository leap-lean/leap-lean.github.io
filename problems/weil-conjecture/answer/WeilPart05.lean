    have hUnit_β1_h01 : IsUnit (β_1 h_01) := by
      rw [hh_01_mul, map_mul]
      have hX : β_1 Polynomial.X = j_1 g_1 := by simp [β_1]
      rw [hX]
      exact hUnit_j1_g1.mul hUnit_β1_Q01
    let G_1 : Localization.Away h_01 →+* Localization.Away g_1 :=
      IsLocalization.Away.lift h_01 (g := β_1) hUnit_β1_h01
    have hG1_eq : ∀ p, G_1 (α_01 p) = β_1 p :=
