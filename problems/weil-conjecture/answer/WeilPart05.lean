    Polynomial.X_ne_zero (hInj_PK_F0 (h.trans (map_zero _).symm))
  have hClearPoly : ∀ P : Polynomial K,
      ∃ (d : ↥R) (P_R : Polynomial ↥R),
        d ≠ 0 ∧ Polynomial.map R.subtype P_R = Polynomial.C (R.subtype d) * P := by
    intro P
    refine Polynomial.induction_on' P ?_ ?_
    · rintro p q ⟨d_p, p_R, hdp, hp⟩ ⟨d_q, q_R, hdq, hq⟩
      refine ⟨d_p * d_q, Polynomial.C d_q * p_R + Polynomial.C d_p * q_R,
        mul_ne_zero hdp hdq, ?_⟩
      simp only [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_C, hp, hq, map_mul]
      ring
    · intro n c
      by_cases hc0 : c = 0
      · subst hc0
        exact ⟨1, 0, one_ne_zero, by simp⟩
      · rcases ValuationSubring.mem_or_inv_mem R c with hc | hcinv
        · refine ⟨1, Polynomial.monomial n ⟨c, hc⟩, one_ne_zero, ?_⟩
          simp [Polynomial.map_monomial]
        · refine ⟨⟨c⁻¹, hcinv⟩, Polynomial.monomial n 1, ?_, ?_⟩
