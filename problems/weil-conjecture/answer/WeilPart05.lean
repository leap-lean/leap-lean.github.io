            hf_not_alg (isCosetAlg_of_norm c_f u_f hc_f hu_f hcf_eq ha)
          have hex_δ0 : ∃ δ_0 : ↥R, δ_0 ∈ m_R ∧ δ_0 ≠ 0 := by
            by_contra h_all0
            push Not at h_all0
            apply hMax_R
            ext x
