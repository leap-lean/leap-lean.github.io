    let B_op : Γ.Opens := Γ.basicOpen g
    have hBg : AlgebraicGeometry.IsAffineOpen B_op := hU.basicOpen g
    have hBg_ne : Nonempty ↥B_op := ⟨⟨z, hzBg⟩⟩
    have e_g : B_op ≤ (TopologicalSpace.Opens.map π₂.base).obj U₂ :=
