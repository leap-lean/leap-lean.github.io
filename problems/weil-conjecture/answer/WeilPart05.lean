    let _ : Algebra P_1 ↥E_0 := ψ₀.toRingHom.toAlgebra
    let _ : Algebra P_1 F := (E_0.val.toRingHom.comp ψ₀.toRingHom).toAlgebra
    have : IsScalarTower P_1 ↥E_0 F := IsScalarTower.of_algebraMap_eq' rfl
    have : Algebra.Etale ↥E_0 (TensorProduct P_1 ↥E_0 B_K) :=
      Algebra.Etale.baseChange P_1 B_K ↥E_0
    have hModFin : Module.Finite ↥E_0 (TensorProduct P_1 ↥E_0 B_K) := by
      obtain ⟨I, hFinI, Ai, instFieldAi, instAlgAi, e_prod, hAi⟩ :=
        (Algebra.Etale.iff_exists_algEquiv_prod ↥E_0 (TensorProduct P_1 ↥E_0 B_K)).mp inferInstance
      let _ : Finite I := hFinI
      let _ : ∀ i, Field (Ai i) := instFieldAi
      let _ : ∀ i, Algebra ↥E_0 (Ai i) := instAlgAi
      have : ∀ i, Module.Finite ↥E_0 (Ai i) := fun i => (hAi i).1
