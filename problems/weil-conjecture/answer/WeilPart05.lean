    let ρ_τ1 : Localization.Away h_1 →+* (R₀ ⧸ Q₀) :=
      IsLocalization.Away.lift (S := Localization.Away h_1) h_1 hu_h1
    have hρ_σ_mk : ∀ P : MvPolynomial (Fin 2) R₀,
        ρ_σ (algebraMap (weilNodalQuot R₀ (b' * π_tilde)) (Localization.Away h_e)
          (Ideal.Quotient.mk (weilNodalIdeal R₀ (b' * π_tilde)) P)) = q_Q₀ (P.coeff 0) := by
      intro P
      exact (IsLocalization.Away.lift_eq (S := Localization.Away h_e) h_e hu_he
