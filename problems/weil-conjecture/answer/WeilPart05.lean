        (g'_M.base (ι_U.base p₀)).asIdeal = IsLocalRing.maximalIdeal ↥R →
        algebraMap (weilNodalQuot ↥R c') (Localization.Away h)
          (Ideal.Quotient.mk (weilNodalIdeal ↥R c') (MvPolynomial.X 0)) ∈ p₀.asIdeal →
