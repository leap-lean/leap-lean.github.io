          ((TopologicalSpace.Opens.map ι'.base).obj U_0) ⟶ V_0.toScheme),
        ι_U0 ≫ U_0.ι =
          AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj U_0) ≫ ι' ∧
        CategoryTheory.IsPullback ι_U0
          (AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj U_0) ≫ p_K)
          (U_0.ι ≫ g')
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)) ∧
        f_V0 ≫ U_0.ι = V_0.ι ≫ f_bar ≫ U_a.ι ∧
        TopologicalSpace.NoetherianSpace ↥V_0.toScheme ∧
        (∀ j : Fin n, AlgebraicGeometry.IsClosedImmersion (τ_V0 j)) ∧
        IsLocalRelativeStableMod V p_K g' n τ' ι' U_0 ι_U0
          V_0.toScheme (V_0.ι ≫ g_bar) f_V0 τ_V0 ι_V0) ∧
    (∀ (U_0 : C'.Opens) (_ : Nonempty ↥U_0)
        (ι_U0 : AlgebraicGeometry.Scheme.Opens.toScheme
          ((TopologicalSpace.Opens.map ι'.base).obj U_0) ⟶ U_0.toScheme)
        (_ : CategoryTheory.IsPullback ι_U0
          (AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj U_0) ≫ p_K)
          (U_0.ι ≫ g')
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
        (X Y : AlgebraicGeometry.Scheme.{u})
        (g_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
        (g_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
        (f_X : X ⟶ U_0.toScheme)
        (f_Y : Y ⟶ U_0.toScheme)
        (ι_X : AlgebraicGeometry.Scheme.Opens.toScheme
          ((TopologicalSpace.Opens.map ι'.base).obj U_0) ⟶ X)
        (ι_Y : AlgebraicGeometry.Scheme.Opens.toScheme
          ((TopologicalSpace.Opens.map ι'.base).obj U_0) ⟶ Y),
      AlgebraicGeometry.IsIntegral X →
      AlgebraicGeometry.IsSeparated g_Y →
      f_X ≫ U_0.ι ≫ g' = g_X →
      f_Y ≫ U_0.ι ≫ g' = g_Y →
      ι_X ≫ f_X = ι_U0 →
      ι_Y ≫ f_Y = ι_U0 →
      CategoryTheory.IsPullback ι_X
        (AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj U_0) ≫ p_K)
        g_X
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)) →
      CategoryTheory.IsPullback ι_Y
        (AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj U_0) ≫ p_K)
        g_Y
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)) →
      (∀ (ψ₁ ψ₂ : X ⟶ Y), ψ₁ ≫ f_Y = f_X → ψ₂ ≫ f_Y = f_X → ψ₁ = ψ₂) ∧
      (∀ (S₀ : (AlgebraicGeometry.Spec (CommRingCat.of ↥V)).Opens)
          (s₁ s₂ : S₀.toScheme ⟶ Y),
        s₁ ≫ g_Y = S₀.ι → s₂ ≫ g_Y = S₀.ι → s₁ ≫ f_Y = s₂ ≫ f_Y → s₁ = s₂)) :=
by
  
  have hProp_P1 : ∀ (K' : Type u) [Field K'],
      AlgebraicGeometry.IsProper (weilProjectiveSpaceOver K' 1).hom := by
    clear hPkg C_K p_K n σ_K hIntCK hStabCK C' g' τ' ι' hMod' V m
    intro K' _
    classical
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K'
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have _ : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (1 + 1)) K') := by
      refine ⟨⟨Finset.univ.image MvPolynomial.X, ?_⟩⟩
      rw [eq_top_iff]
      intro p
      induction p using MvPolynomial.induction_on with
      | C c =>
        intro _
        let c0 : ↥(𝒜 0) := ⟨MvPolynomial.C c, MvPolynomial.isHomogeneous_C _ c⟩
        exact Subalgebra.algebraMap_mem _ c0
      | add _ _ hp hq =>
        intro _
        exact Subalgebra.add_mem _ (hp trivial) (hq trivial)
      | mul_X _ i hp =>
        intro _
        refine Subalgebra.mul_mem _ (hp trivial) (Algebra.subset_adjoin ?_)
        exact Finset.mem_coe.mpr (Finset.mem_image_of_mem MvPolynomial.X (Finset.mem_univ i))
    have _ : AlgebraicGeometry.IsProper (AlgebraicGeometry.Proj.toSpecZero 𝒜) := inferInstance
    let inv0 : ↥(𝒜 0) →+* K' :=
      { toFun := fun p => MvPolynomial.constantCoeff p.1
        map_one' := map_one MvPolynomial.constantCoeff
        map_mul' := fun x y => map_mul MvPolynomial.constantCoeff x.1 y.1
        map_zero' := map_zero MvPolynomial.constantCoeff
        map_add' := fun x y => map_add MvPolynomial.constantCoeff x.1 y.1 }
    have _ : CategoryTheory.IsIso (CommRingCat.ofHom (algebraMap K' ↥(𝒜 0))) := by
      refine ⟨⟨CommRingCat.ofHom inv0, ?_, ?_⟩⟩
      · apply CommRingCat.hom_ext
        apply RingHom.ext
        intro c
        exact MvPolynomial.constantCoeff_C _ c
      · apply CommRingCat.hom_ext
        apply RingHom.ext
        intro p
        apply Subtype.ext
        have hp0 : MvPolynomial.IsHomogeneous p.1 0 := p.2
        have hdeg : p.1.totalDegree = 0 := by
          by_cases hpz : p.1 = 0
          · simp [hpz]
          · exact hp0.totalDegree hpz
        exact (MvPolynomial.totalDegree_eq_zero_iff_eq_C.mp hdeg).symm
    have _ : CategoryTheory.IsIso
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K' ↥(𝒜 0)))) :=
      inferInstance
    change AlgebraicGeometry.IsProper
      (AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K' ↥(𝒜 0))))
    infer_instance

  let η_V : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of ↥V) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)
  have hFinV : Set.Finite (Set.univ : Set (PrimeSpectrum ↥V)) := hPkg.1

  
  have hOpenη : AlgebraicGeometry.IsOpenImmersion η_V := by
    let _ : Algebra ↥V K := V.subtype.toAlgebra
    have hTotal : Std.Total (fun I J : Ideal ↥V => I ≤ J) :=
      ValuationRing.iff_ideal_total.mp inferInstance
    let S : Set (PrimeSpectrum ↥V) := {P | P.asIdeal ≠ ⊥}
    have hS_fin : S.Finite := hFinV.subset (Set.subset_univ S)
    let F : Finset (PrimeSpectrum ↥V) := hS_fin.toFinset
    by_cases hF : F.Nonempty
    · have hMinAux : ∀ G : Finset (PrimeSpectrum ↥V), G.Nonempty →
          ∃ P₀ ∈ G, ∀ Q ∈ G, P₀.asIdeal ≤ Q.asIdeal := by
        intro G
        induction G using Finset.cons_induction with
        | empty =>
          intro hne
          exact False.elim (Finset.not_nonempty_empty hne)
        | cons a s _ ih =>
          intro _
          by_cases hs : s.Nonempty
          · obtain ⟨P₀, hP₀s, hP₀le⟩ := ih hs
            rcases hTotal.total a.asIdeal P₀.asIdeal with haP | hPa
            · refine ⟨a, Finset.mem_cons_self a s, ?_⟩
              intro Q hQ
              rcases Finset.mem_cons.mp hQ with rfl | hQs
              · exact le_rfl
              · exact haP.trans (hP₀le Q hQs)
            · refine ⟨P₀, Finset.mem_cons_of_mem hP₀s, ?_⟩
              intro Q hQ
              rcases Finset.mem_cons.mp hQ with rfl | hQs
              · exact hPa
              · exact hP₀le Q hQs
          · refine ⟨a, Finset.mem_cons_self a s, ?_⟩
            intro Q hQ
            rcases Finset.mem_cons.mp hQ with rfl | hQs
            · exact le_rfl
            · exact False.elim (hs ⟨Q, hQs⟩)
      obtain ⟨P₀, hP₀F, hP₀le⟩ := hMinAux F hF
      have hP₀_ne : P₀.asIdeal ≠ ⊥ := hS_fin.mem_toFinset.mp hP₀F
      obtain ⟨s₀, hs₀_mem, hs₀_ne⟩ := (Submodule.ne_bot_iff P₀.asIdeal).mp hP₀_ne
      have hLoc : IsLocalization.Away s₀ K := by
        refine { map_units := ?_, surj := ?_, exists_of_eq := ?_ }
        · rintro ⟨_, k, rfl⟩
          apply IsUnit.mk0
          change V.subtype (s₀ ^ k) ≠ 0
          rw [map_pow]
          exact pow_ne_zero k (fun h0 => hs₀_ne (Subtype.ext h0))
        · intro z
          by_cases hz0 : z = 0
          · exact ⟨⟨0, ⟨1, 0, pow_zero s₀⟩⟩, by simp [hz0]⟩
          · rcases ValuationSubring.mem_or_inv_mem V z with hzV | hzinvV
            · exact ⟨⟨⟨z, hzV⟩, ⟨1, 0, pow_zero s₀⟩⟩,
                by change z * V.subtype 1 = V.subtype ⟨z, hzV⟩; simp⟩
            · let b : ↥V := ⟨z⁻¹, hzinvV⟩
              have hb_ne : b ≠ 0 := fun hb0 => inv_ne_zero hz0 (congrArg Subtype.val hb0)
              have hs₀_rad : s₀ ∈ (Ideal.span ({b} : Set ↥V)).radical := by
                rw [Ideal.radical_eq_sInf, Submodule.mem_sInf]
                rintro Q ⟨hbQ, hQprime⟩
                have hb_mem : b ∈ Q := hbQ (Ideal.subset_span (Set.mem_singleton b))
                have hQ_ne : Q ≠ ⊥ := fun hbot => hb_ne (by simpa [hbot] using hb_mem)
                have hQ_F : (⟨Q, hQprime⟩ : PrimeSpectrum ↥V) ∈ F :=
                  hS_fin.mem_toFinset.mpr hQ_ne
                exact hP₀le ⟨Q, hQprime⟩ hQ_F hs₀_mem
              obtain ⟨k, hk⟩ := Ideal.mem_radical_iff.mp hs₀_rad
              obtain ⟨a, ha⟩ := Ideal.mem_span_singleton.mp hk
              refine ⟨⟨a, ⟨s₀ ^ k, k, rfl⟩⟩, ?_⟩
              change z * V.subtype (s₀ ^ k) = V.subtype a
              rw [ha, map_mul]
              change z * (z⁻¹ * V.subtype a) = V.subtype a
              rw [← mul_assoc, mul_inv_cancel₀ hz0, one_mul]
        · intro x y hxy
          exact ⟨⟨1, 0, pow_zero s₀⟩, by simp [Subtype.ext hxy]⟩
      exact @AlgebraicGeometry.IsOpenImmersion.of_isLocalization ↥V K _ _ _ s₀ hLoc
    · have hUnit : ∀ b : ↥V, b ≠ 0 → IsUnit b := by
        intro b hb_ne
        by_contra hnu
        have hne_top : Ideal.span ({b} : Set ↥V) ≠ ⊤ := by
          rwa [ne_eq, Ideal.span_singleton_eq_top]
        obtain ⟨𝔪, h𝔪_max, hb𝔪⟩ := Ideal.exists_le_maximal _ hne_top
        have h𝔪_prime : 𝔪.IsPrime := h𝔪_max.isPrime
        have hb_mem : b ∈ 𝔪 := hb𝔪 (Ideal.subset_span (Set.mem_singleton b))
        have h𝔪_ne : 𝔪 ≠ ⊥ := fun hbot => hb_ne (by simpa [hbot] using hb_mem)
        have hmemF : (⟨𝔪, h𝔪_prime⟩ : PrimeSpectrum ↥V) ∈ F := hS_fin.mem_toFinset.mpr h𝔪_ne
        exact hF ⟨⟨𝔪, h𝔪_prime⟩, hmemF⟩
      have hLoc : IsLocalization.Away (1 : ↥V) K := by
        refine { map_units := ?_, surj := ?_, exists_of_eq := ?_ }
        · rintro ⟨_, k, rfl⟩
          change IsUnit (V.subtype ((1 : ↥V) ^ k))
          simp
        · intro z
          by_cases hz0 : z = 0
          · exact ⟨⟨0, ⟨1, 0, pow_zero 1⟩⟩, by simp [hz0]⟩
          · rcases ValuationSubring.mem_or_inv_mem V z with hzV | hzinvV
            · exact ⟨⟨⟨z, hzV⟩, ⟨1, 0, pow_zero 1⟩⟩,
                by change z * V.subtype 1 = z; simp⟩
            · let b : ↥V := ⟨z⁻¹, hzinvV⟩
              have hb_ne : b ≠ 0 := fun hb0 => inv_ne_zero hz0 (congrArg Subtype.val hb0)
              obtain ⟨u, hu⟩ := hUnit b hb_ne
              let a : ↥V := (u⁻¹ : Units ↥V).val
              refine ⟨⟨a, ⟨1, 0, pow_zero 1⟩⟩, ?_⟩
              have hmul : b * a = 1 := by
                rw [← hu]
                exact Units.mul_inv u
              have hK : z⁻¹ * V.subtype a = 1 := by
                have h1 := congrArg V.subtype hmul
                simpa [map_mul] using h1
              change z * V.subtype 1 = V.subtype a
              rw [map_one, mul_one]
              calc
                z = z * (z⁻¹ * V.subtype a) := by rw [hK, mul_one]
                _ = (z * z⁻¹) * V.subtype a := by rw [mul_assoc]
                _ = V.subtype a := by rw [mul_inv_cancel₀ hz0, one_mul]
        · intro x y hxy
          exact ⟨⟨1, 0, pow_zero 1⟩, by simp [Subtype.ext hxy]⟩
      exact @AlgebraicGeometry.IsOpenImmersion.of_isLocalization ↥V K _ _ _ (1 : ↥V) hLoc

  
  have hNoethOverV : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (_ : CompactSpace ↥Z)
      (g_Z : Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
      (_ : AlgebraicGeometry.LocallyOfFiniteType g_Z),
      TopologicalSpace.NoetherianSpace ↥Z := by
    intro Z _ g_Z _
    have _ : Finite (PrimeSpectrum ↥V) := Set.finite_univ_iff.mp hFinV
    have hAffNoeth : ∀ (B : Type u) [CommRing B] [Algebra ↥V B] [Algebra.FiniteType ↥V B],
        TopologicalSpace.NoetherianSpace (PrimeSpectrum B) := by
      intro B _ _ _
      let F_P : PrimeSpectrum ↥V → Set (PrimeSpectrum B) := fun P =>
        Set.range (PrimeSpectrum.comap
          (Algebra.TensorProduct.includeRight (R := ↥V) (A := P.asIdeal.ResidueField) (B := B)).toRingHom)
      have _ : ∀ P : PrimeSpectrum ↥V, TopologicalSpace.NoetherianSpace ↥(F_P P) := by
        intro P
        have _ : IsNoetherianRing (TensorProduct ↥V P.asIdeal.ResidueField B) :=
          Algebra.FiniteType.isNoetherianRing P.asIdeal.ResidueField
            (TensorProduct ↥V P.asIdeal.ResidueField B)
        exact TopologicalSpace.NoetherianSpace.range _ (PrimeSpectrum.continuous_comap _)
      have hUnion : (⋃ P : PrimeSpectrum ↥V, F_P P) = Set.univ := by
        ext q
        simp only [Set.mem_iUnion, Set.mem_univ, iff_true]
        let P : PrimeSpectrum ↥V := PrimeSpectrum.comap (algebraMap ↥V B) q
        refine ⟨P, ?_⟩
        let α : P.asIdeal.ResidueField →ₐ[↥V] q.asIdeal.ResidueField :=
          Ideal.ResidueField.mapₐ P.asIdeal q.asIdeal (Algebra.ofId ↥V B) rfl
        let β : B →ₐ[↥V] q.asIdeal.ResidueField :=
          IsScalarTower.toAlgHom ↥V B q.asIdeal.ResidueField
        have hcomm : ∀ x y, Commute (α x) (β y) := fun _ _ => mul_comm _ _
        let Φ : TensorProduct ↥V P.asIdeal.ResidueField B →ₐ[↥V] q.asIdeal.ResidueField :=
          Algebra.TensorProduct.lift α β hcomm
        refine ⟨PrimeSpectrum.comap Φ.toRingHom ⊥, ?_⟩
        ext x
        change x ∈ Ideal.comap (Φ.toRingHom.comp
          (Algebra.TensorProduct.includeRight (R := ↥V) (A := P.asIdeal.ResidueField) (B := B)).toRingHom)
          (⊥ : Ideal q.asIdeal.ResidueField) ↔ x ∈ q.asIdeal
        have hcomp : Φ.toRingHom.comp
            (Algebra.TensorProduct.includeRight (R := ↥V) (A := P.asIdeal.ResidueField) (B := B)).toRingHom =
            algebraMap B q.asIdeal.ResidueField := by
          ext b
          change Φ ((1 : P.asIdeal.ResidueField) ⊗ₜ[↥V] b) = algebraMap B q.asIdeal.ResidueField b
          rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
          rfl
        rw [hcomp]
        change algebraMap B q.asIdeal.ResidueField x = 0 ↔ x ∈ q.asIdeal
        rw [← RingHom.mem_ker, Ideal.ker_algebraMap_residueField]
      have hUnivNoeth : TopologicalSpace.NoetherianSpace ↥(⋃ P : PrimeSpectrum ↥V, F_P P) :=
        TopologicalSpace.NoetherianSpace.iUnion F_P
      rw [hUnion] at hUnivNoeth
      exact TopologicalSpace.noetherian_univ_iff.mp hUnivNoeth
    have hCover : ∀ z : ↥Z, ∃ U : Z.Opens, AlgebraicGeometry.IsAffineOpen U ∧ z ∈ U := by
      intro z
      obtain ⟨U, hU, hzU, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := ⊤) (x := z) trivial
      exact ⟨U, hU, hzU⟩
    choose U_z hAff_z hz_mem using hCover
    obtain ⟨I, hICov⟩ := isCompact_univ.elim_finite_subcover (fun z => (U_z z : Set ↥Z))
      (fun z => (U_z z).2) (fun z _ => Set.mem_iUnion.mpr ⟨z, hz_mem z⟩)
    let G : ↥I → Set ↥Z := fun i => (U_z i.1 : Set ↥Z)
    have _ : ∀ i : ↥I, TopologicalSpace.NoetherianSpace ↥(G i) := by
      intro i
      let U := U_z i.1
      have hU : AlgebraicGeometry.IsAffineOpen U := hAff_z i.1
      have hle : U ≤ (TopologicalSpace.Opens.map g_Z.base).obj ⊤ := fun _ _ => trivial
      let ψ := g_Z.appLE ⊤ U hle
      have hFT_ψ : ψ.hom.FiniteType :=
        AlgebraicGeometry.Scheme.Hom.finiteType_appLE g_Z
          (AlgebraicGeometry.isAffineOpen_top _) hU hle
      let eR := AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)
      let φ : ↥V →+* ↑(Z.presheaf.obj (Opposite.op U)) := (eR.inv ≫ ψ).hom
      have hFT_eR : eR.inv.hom.FiniteType := by
        apply RingHom.FiniteType.of_surjective
        intro y
        refine ⟨eR.hom.hom y, ?_⟩
        change (eR.hom ≫ eR.inv).hom y = y
        rw [eR.hom_inv_id]
        rfl
      have hFT_φ : φ.FiniteType := by
        change (ψ.hom.comp eR.inv.hom).FiniteType
        exact hFT_ψ.comp hFT_eR
      let _ : Algebra ↥V ↑(Z.presheaf.obj (Opposite.op U)) := φ.toAlgebra
      have _ : Algebra.FiniteType ↥V ↑(Z.presheaf.obj (Opposite.op U)) := hFT_φ
      have _ : TopologicalSpace.NoetherianSpace
          (PrimeSpectrum ↑(Z.presheaf.obj (Opposite.op U))) :=
        hAffNoeth ↑(Z.presheaf.obj (Opposite.op U))
      have _ : TopologicalSpace.NoetherianSpace
          ↥(AlgebraicGeometry.Spec (Z.presheaf.obj (Opposite.op U))) := ‹_›
      have hRange : Set.range hU.fromSpec.base = (U : Set ↥Z) := hU.range_fromSpec
      have hNoethRange : TopologicalSpace.NoetherianSpace ↥(Set.range hU.fromSpec.base) :=
        TopologicalSpace.NoetherianSpace.range hU.fromSpec.base hU.fromSpec.continuous
      rwa [hRange] at hNoethRange
    have hUnionI : (⋃ i : ↥I, G i) = Set.univ := by
      ext z
      simp only [Set.mem_iUnion, Set.mem_univ, iff_true]
      obtain ⟨_, ⟨x, rfl⟩, _, ⟨hxI, rfl⟩, hzx⟩ := hICov (Set.mem_univ z)
      exact ⟨⟨x, hxI⟩, hzx⟩
    have hNoethUniv : TopologicalSpace.NoetherianSpace ↥(⋃ i : ↥I, G i) :=
      TopologicalSpace.NoetherianSpace.iUnion G
    rw [hUnionI] at hNoethUniv
    exact TopologicalSpace.noetherian_univ_iff.mp hNoethUniv

  
  have hPb_open_preimage : ∀ {X₀ Y₀ X Y : AlgebraicGeometry.Scheme.{u}}
      (f₀ : X₀ ⟶ Y₀) (i_X : X₀ ⟶ X) (i_Y : Y₀ ⟶ Y) (f : X ⟶ Y)
      [AlgebraicGeometry.IsOpenImmersion i_X] [AlgebraicGeometry.IsOpenImmersion i_Y],
      f₀ ≫ i_Y = i_X ≫ f →
      (∀ x : ↥X, x ∈ Set.range i_X.base ↔ f.base x ∈ Set.range i_Y.base) →
      CategoryTheory.IsPullback f₀ i_X i_Y f := by
    intro X₀ Y₀ X Y f₀ i_X i_Y f _ _ hcomm hpre
    have hsub : ∀ s : CategoryTheory.Limits.PullbackCone i_Y f,
        Set.range s.snd.base ⊆ Set.range i_X.base := by
      intro s x hx
      rcases hx with ⟨t, rfl⟩
      rw [hpre]
      have ht : f.base (s.snd.base t) = i_Y.base (s.fst.base t) := by
        change (s.snd ≫ f).base t = (s.fst ≫ i_Y).base t
        rw [s.condition]
      rw [ht]
      exact ⟨s.fst.base t, rfl⟩
    refine CategoryTheory.IsPullback.of_isLimit
      (CategoryTheory.Limits.PullbackCone.IsLimit.mk hcomm
        (fun s => AlgebraicGeometry.IsOpenImmersion.lift i_X s.snd (hsub s)) ?_ ?_ ?_)
    · intro s
      apply (cancel_mono i_Y).mp
      rw [CategoryTheory.Category.assoc, hcomm, ← CategoryTheory.Category.assoc,
        AlgebraicGeometry.IsOpenImmersion.lift_fac, s.condition]
    · intro s
      exact AlgebraicGeometry.IsOpenImmersion.lift_fac i_X s.snd (hsub s)
    · intro s m _ hm2
      apply (cancel_mono i_X).mp
      rw [hm2, AlgebraicGeometry.IsOpenImmersion.lift_fac]

  have hPb_ι' : CategoryTheory.IsPullback ι' p_K g' η_V := hMod'.2.2.2.2.2.2.2.1
  have hOpen_ι' : AlgebraicGeometry.IsOpenImmersion ι' :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (P := @AlgebraicGeometry.IsOpenImmersion) hPb_ι'.flip hOpenη
  have hIrredCK : IrreducibleSpace ↥C_K :=
    @AlgebraicGeometry.irreducibleSpace_of_isIntegral C_K hIntCK
  have hIrredC' : IrreducibleSpace ↥C' :=
    @AlgebraicGeometry.irreducibleSpace_of_isIntegral C' hMod'.1
  have _ : PreirreducibleSpace ↥C' := hIrredC'.toPreirreducibleSpace
  have hNonemptyUK : ∀ (U_0 : C'.Opens), Nonempty ↥U_0 →
      Nonempty ↥(AlgebraicGeometry.Scheme.Opens.toScheme
        ((TopologicalSpace.Opens.map ι'.base).obj U_0)) := by
    intro U_0 ⟨⟨x₀, hx₀⟩⟩
    obtain ⟨xK⟩ := hIrredCK.toNonempty
    obtain ⟨y, hyU0, ⟨x0, rfl⟩⟩ :=
      nonempty_preirreducible_inter U_0.2 ι'.isOpenEmbedding.isOpen_range
        ⟨x₀, hx₀⟩ ⟨ι'.base xK, xK, rfl⟩
    exact ⟨⟨x0, hyU0⟩⟩

  have hProp_g' : AlgebraicGeometry.IsProper g' := hMod'.2.2.1
  have hCompC' : CompactSpace ↥C' :=
    @AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace _ _ g' inferInstance inferInstance
  have hNoethC' : TopologicalSpace.NoetherianSpace ↥C' :=
    hNoethOverV C' hCompC' g' inferInstance

  refine ⟨hOpenη, ?_, ?_⟩

  
  · intro U_a U_0 hLE hU_0 ι_Ua hι_a _hPb_Ua C_bar g_bar f_bar τ_bar ι_bar hStab
    dsimp only
    let V_0 : C_bar.Opens := (TopologicalSpace.Opens.map (f_bar ≫ U_a.ι).base).obj U_0
    let U_0K : C_K.Opens := (TopologicalSpace.Opens.map ι'.base).obj U_0
    let U_aK : C_K.Opens := (TopologicalSpace.Opens.map ι'.base).obj U_a
    let S_0 : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V)).Opens :=
      fun j => (TopologicalSpace.Opens.map (τ' j).base).obj U_0
    let S_a : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V)).Opens :=
      fun j => (TopologicalSpace.Opens.map (τ' j).base).obj U_a

    obtain ⟨hSS_bar, hProp_fbar, hfbar_g, hιbar_f, hPb_bar,
      hτbar_comm, hDisj_bar, hSm_bar, hRel_bar⟩ := hStab
    obtain ⟨hInt_bar, hFlat_bar, hSep_bar, hLfp_bar, hCharts_bar⟩ := hSS_bar

    
    let ι_U0 : U_0K.toScheme ⟶ U_0.toScheme := ι' ∣_ U_0
    let f_V0 : V_0.toScheme ⟶ U_0.toScheme := (f_bar ≫ U_a.ι) ∣_ U_0
    have hι_U0 : ι_U0 ≫ U_0.ι = U_0K.ι ≫ ι' :=
      AlgebraicGeometry.morphismRestrict_ι ι' U_0
    have hf_V0 : f_V0 ≫ U_0.ι = V_0.ι ≫ f_bar ≫ U_a.ι :=
      AlgebraicGeometry.morphismRestrict_ι (f_bar ≫ U_a.ι) U_0
    have hPb_U0_top : CategoryTheory.IsPullback ι_U0 U_0K.ι U_0.ι ι' := by
      refine hPb_open_preimage ι_U0 U_0K.ι U_0.ι ι' hι_U0 ?_
      intro x
      simp only [AlgebraicGeometry.Scheme.Opens.range_ι]
      rfl
    have hPb_U0 : CategoryTheory.IsPullback ι_U0 (U_0K.ι ≫ p_K) (U_0.ι ≫ g') η_V :=
      hPb_U0_top.paste_vert hPb_ι'

    
    let i_0a : U_0.toScheme ⟶ U_a.toScheme := C'.homOfLE hLE
    have hf_V0_ia : f_V0 ≫ i_0a = V_0.ι ≫ f_bar := by
      apply (cancel_mono U_a.ι).mp
      rw [CategoryTheory.Category.assoc, C'.homOfLE_ι, hf_V0, CategoryTheory.Category.assoc]
    have hRange_homOfLE : ∀ {X : AlgebraicGeometry.Scheme.{u}} {W₁ W₂ : X.Opens} (hle : W₁ ≤ W₂)
        (u : ↥W₂.toScheme),
        u ∈ Set.range (X.homOfLE hle).base ↔ W₂.ι.base u ∈ (W₁ : Set ↥X) := by
      intro X W₁ W₂ hle u
      constructor
      · rintro ⟨u₁, rfl⟩
        change (X.homOfLE hle ≫ W₂.ι).base u₁ ∈ (W₁ : Set ↥X)
        rw [X.homOfLE_ι, ← W₁.range_ι]
        exact ⟨u₁, rfl⟩
      · intro hu
        rw [← W₁.range_ι] at hu
        obtain ⟨u₁, hu₁⟩ := hu
        refine ⟨u₁, W₂.ι.isOpenEmbedding.injective ?_⟩
        change (X.homOfLE hle ≫ W₂.ι).base u₁ = W₂.ι.base u
        rw [X.homOfLE_ι, hu₁]
    have hPb_fV0 : CategoryTheory.IsPullback f_V0 V_0.ι i_0a f_bar := by
      refine hPb_open_preimage f_V0 V_0.ι i_0a f_bar hf_V0_ia ?_
      intro y
      rw [V_0.range_ι, hRange_homOfLE hLE]
      rfl
    have hProp_fV0 : AlgebraicGeometry.IsProper f_V0 :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (P := @AlgebraicGeometry.IsProper) hPb_fV0.flip hProp_fbar

    
    let k_0a : U_0K.toScheme ⟶ U_aK.toScheme :=
      C_K.homOfLE ((TopologicalSpace.Opens.map ι'.base).monotone hLE)
    have hk_range : Set.range (k_0a ≫ ι_bar).base ⊆ Set.range V_0.ι.base := by
      rintro y ⟨u, rfl⟩
      rw [V_0.range_ι]
      change ((k_0a ≫ ι_bar) ≫ f_bar ≫ U_a.ι).base u ∈ (U_0 : Set ↥C')
      have hEq : (k_0a ≫ ι_bar) ≫ f_bar ≫ U_a.ι = ι_U0 ≫ U_0.ι := by
        calc
          (k_0a ≫ ι_bar) ≫ f_bar ≫ U_a.ι
            = k_0a ≫ (ι_bar ≫ f_bar) ≫ U_a.ι := by simp only [CategoryTheory.Category.assoc]
          _ = k_0a ≫ ι_Ua ≫ U_a.ι := by rw [hιbar_f]
          _ = k_0a ≫ U_aK.ι ≫ ι' := by rw [hι_a]
          _ = (k_0a ≫ U_aK.ι) ≫ ι' := by rw [← CategoryTheory.Category.assoc]
          _ = U_0K.ι ≫ ι' := by rw [C_K.homOfLE_ι]
          _ = ι_U0 ≫ U_0.ι := hι_U0.symm
      rw [hEq, ← U_0.range_ι]
      exact ⟨ι_U0.base u, rfl⟩
    let ι_V0 : U_0K.toScheme ⟶ V_0.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift V_0.ι (k_0a ≫ ι_bar) hk_range
    have hι_V0_fac : ι_V0 ≫ V_0.ι = k_0a ≫ ι_bar :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac V_0.ι (k_0a ≫ ι_bar) hk_range
    have hι_V0_f : ι_V0 ≫ f_V0 = ι_U0 := by
      apply (cancel_mono U_0.ι).mp
      calc
        (ι_V0 ≫ f_V0) ≫ U_0.ι = ι_V0 ≫ (f_V0 ≫ U_0.ι) := by rw [CategoryTheory.Category.assoc]
        _ = (ι_V0 ≫ V_0.ι) ≫ f_bar ≫ U_a.ι := by
          rw [hf_V0, ← CategoryTheory.Category.assoc]
        _ = (k_0a ≫ ι_bar) ≫ f_bar ≫ U_a.ι := by rw [hι_V0_fac]
        _ = k_0a ≫ (ι_bar ≫ f_bar) ≫ U_a.ι := by simp only [CategoryTheory.Category.assoc]
        _ = k_0a ≫ ι_Ua ≫ U_a.ι := by rw [hιbar_f]
        _ = (k_0a ≫ U_aK.ι) ≫ ι' := by rw [hι_a, ← CategoryTheory.Category.assoc]
        _ = U_0K.ι ≫ ι' := by rw [C_K.homOfLE_ι]
        _ = ι_U0 ≫ U_0.ι := hι_U0.symm
    have hPb_ιV0_top : CategoryTheory.IsPullback ι_V0 k_0a V_0.ι ι_bar := by
      refine hPb_open_preimage ι_V0 k_0a V_0.ι ι_bar hι_V0_fac ?_
      intro u
      rw [V_0.range_ι, hRange_homOfLE]
      change U_aK.ι.base u ∈ (U_0K : Set ↥C_K) ↔
        (ι_bar ≫ f_bar ≫ U_a.ι).base u ∈ (U_0 : Set ↥C')
      have hEq : ι_bar ≫ f_bar ≫ U_a.ι = U_aK.ι ≫ ι' := by
        rw [← CategoryTheory.Category.assoc, hιbar_f, hι_a]
      rw [hEq]
      rfl
    have hPb_V0 : CategoryTheory.IsPullback ι_V0 (U_0K.ι ≫ p_K) (V_0.ι ≫ g_bar) η_V := by
      have hPaste := hPb_ιV0_top.paste_vert hPb_bar
      rwa [← CategoryTheory.Category.assoc, C_K.homOfLE_ι] at hPaste

    
    let s_0a : ∀ j : Fin n, (S_0 j).toScheme ⟶ (S_a j).toScheme :=
      fun j => (AlgebraicGeometry.Spec (CommRingCat.of ↥V)).homOfLE
        ((TopologicalSpace.Opens.map (τ' j).base).monotone hLE)
    have hs_range : ∀ j : Fin n,
        Set.range (s_0a j ≫ τ_bar j).base ⊆ Set.range V_0.ι.base := by
      intro j y hy
      rcases hy with ⟨b, rfl⟩
      rw [V_0.range_ι]
      change ((s_0a j ≫ τ_bar j) ≫ f_bar ≫ U_a.ι).base b ∈ (U_0 : Set ↥C')
      have hEq : (s_0a j ≫ τ_bar j) ≫ f_bar ≫ U_a.ι = (S_0 j).ι ≫ τ' j := by
        calc
          (s_0a j ≫ τ_bar j) ≫ f_bar ≫ U_a.ι
            = s_0a j ≫ ((τ_bar j ≫ f_bar) ≫ U_a.ι) := by
              simp only [CategoryTheory.Category.assoc]
          _ = (s_0a j ≫ (S_a j).ι) ≫ τ' j := by
              rw [hτbar_comm j, ← CategoryTheory.Category.assoc]
          _ = (S_0 j).ι ≫ τ' j := by rw [AlgebraicGeometry.Scheme.homOfLE_ι]
      rw [hEq]
      have hb_mem : (S_0 j).ι.base b ∈ (S_0 j : Set _) := by
        rw [← (S_0 j).range_ι]
        exact ⟨b, rfl⟩
      exact hb_mem
    let τ_V0 : ∀ j : Fin n, (S_0 j).toScheme ⟶ V_0.toScheme :=
      fun j => AlgebraicGeometry.IsOpenImmersion.lift V_0.ι (s_0a j ≫ τ_bar j) (hs_range j)
    have hτ_V0_fac : ∀ j : Fin n, τ_V0 j ≫ V_0.ι = s_0a j ≫ τ_bar j :=
      fun j => AlgebraicGeometry.IsOpenImmersion.lift_fac V_0.ι (s_0a j ≫ τ_bar j) (hs_range j)
    have hτ_V0_comm : ∀ j : Fin n, (τ_V0 j ≫ f_V0) ≫ U_0.ι = (S_0 j).ι ≫ τ' j := by
      intro j
      calc
        (τ_V0 j ≫ f_V0) ≫ U_0.ι = τ_V0 j ≫ (f_V0 ≫ U_0.ι) := by
          rw [CategoryTheory.Category.assoc]
        _ = (τ_V0 j ≫ V_0.ι) ≫ f_bar ≫ U_a.ι := by
          rw [hf_V0, ← CategoryTheory.Category.assoc]
        _ = s_0a j ≫ ((τ_bar j ≫ f_bar) ≫ U_a.ι) := by
          rw [hτ_V0_fac j]
          simp only [CategoryTheory.Category.assoc]
        _ = (s_0a j ≫ (S_a j).ι) ≫ τ' j := by
          rw [hτbar_comm j, ← CategoryTheory.Category.assoc]
        _ = (S_0 j).ι ≫ τ' j := by rw [AlgebraicGeometry.Scheme.homOfLE_ι]
    have hCl_τV0 : ∀ j : Fin n, AlgebraicGeometry.IsClosedImmersion (τ_V0 j) := by
      intro j
      have hCl_τ' : AlgebraicGeometry.IsClosedImmersion (τ' j) := by
        have _ : AlgebraicGeometry.IsClosedImmersion (τ' j ≫ g') := by
          rw [hMod'.2.2.2.2.2.2.1 j]
          infer_instance
        exact AlgebraicGeometry.IsClosedImmersion.of_comp (τ' j) g'
      have hPb_τ' : CategoryTheory.IsPullback ((τ' j) ∣_ U_0) (S_0 j).ι U_0.ι (τ' j) := by
        refine hPb_open_preimage ((τ' j) ∣_ U_0) (S_0 j).ι U_0.ι (τ' j)
          (AlgebraicGeometry.morphismRestrict_ι (τ' j) U_0) ?_
        intro s
        simp only [AlgebraicGeometry.Scheme.Opens.range_ι]
        rfl
      have hCl_res : AlgebraicGeometry.IsClosedImmersion ((τ' j) ∣_ U_0) :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (P := @AlgebraicGeometry.IsClosedImmersion) hPb_τ'.flip hCl_τ'
      have hEq_res : τ_V0 j ≫ f_V0 = (τ' j) ∣_ U_0 := by
        apply (cancel_mono U_0.ι).mp
        rw [hτ_V0_comm j, AlgebraicGeometry.morphismRestrict_ι]
      have _ : AlgebraicGeometry.IsClosedImmersion (τ_V0 j ≫ f_V0) := by
        rwa [hEq_res]
      exact AlgebraicGeometry.IsClosedImmersion.of_comp (τ_V0 j) f_V0

    
    have hNoeth_V0 : TopologicalSpace.NoetherianSpace ↥V_0.toScheme := by
      have hNoeth_U0 : TopologicalSpace.NoetherianSpace ↥U_0.toScheme :=
        TopologicalSpace.NoetherianSpace.set (U_0 : Set ↥C')
      have hComp_U0 : CompactSpace ↥U_0.toScheme :=
        @TopologicalSpace.NoetherianSpace.compactSpace _ _ hNoeth_U0
      have hComp_V0 : CompactSpace ↥V_0.toScheme :=
        @AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace _ _ f_V0
          inferInstance hComp_U0
      exact hNoethOverV V_0.toScheme hComp_V0 (V_0.ι ≫ g_bar) inferInstance

    
    have hNonempty_V0 : Nonempty ↥V_0.toScheme := by
      obtain ⟨u₀⟩ := hNonemptyUK U_0 hU_0
      exact ⟨ι_V0.base u₀⟩
    have hInt_V0 : AlgebraicGeometry.IsIntegral V_0.toScheme :=
      @AlgebraicGeometry.isIntegral_of_isOpenImmersion _ _ V_0.ι inferInstance hInt_bar hNonempty_V0
    have hSS_V0 : IsStrictlySemistableCurveOverValuation V (V_0.ι ≫ g_bar) := by
      refine ⟨hInt_V0, inferInstance, inferInstance, inferInstance, ?_⟩
      intro y
      rcases hCharts_bar (V_0.ι.base y) with ⟨W, e, hyW, hEt_e, hWe⟩ | ⟨W, a, e, hyW, ha0, hEt_e, hWe⟩
      · left
        let W_0 : V_0.toScheme.Opens := (TopologicalSpace.Opens.map V_0.ι.base).obj W
        refine ⟨W_0, (V_0.ι ∣_ W) ≫ e, hyW, inferInstance, ?_⟩
        calc
          W_0.ι ≫ V_0.ι ≫ g_bar = (W_0.ι ≫ V_0.ι) ≫ g_bar := by
            rw [← CategoryTheory.Category.assoc]
          _ = ((V_0.ι ∣_ W) ≫ W.ι) ≫ g_bar := by
            rw [AlgebraicGeometry.morphismRestrict_ι]
          _ = (V_0.ι ∣_ W) ≫ (W.ι ≫ g_bar) := by rw [CategoryTheory.Category.assoc]
          _ = ((V_0.ι ∣_ W) ≫ e) ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) := by
            rw [hWe, CategoryTheory.Category.assoc]
      · right
        let W_0 : V_0.toScheme.Opens := (TopologicalSpace.Opens.map V_0.ι.base).obj W
        refine ⟨W_0, a, (V_0.ι ∣_ W) ≫ e, hyW, ha0, inferInstance, ?_⟩
        calc
          W_0.ι ≫ V_0.ι ≫ g_bar = (W_0.ι ≫ V_0.ι) ≫ g_bar := by
            rw [← CategoryTheory.Category.assoc]
          _ = ((V_0.ι ∣_ W) ≫ W.ι) ≫ g_bar := by
            rw [AlgebraicGeometry.morphismRestrict_ι]
          _ = (V_0.ι ∣_ W) ≫ (W.ι ≫ g_bar) := by rw [CategoryTheory.Category.assoc]
          _ = ((V_0.ι ∣_ W) ≫ e) ≫
              AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) := by
            rw [hWe, CategoryTheory.Category.assoc]

    
    have hDisj_V0 : _root_.Pairwise fun i j : Fin n =>
        Disjoint (Set.range (τ_V0 i).base) (Set.range (τ_V0 j).base) := by
      intro i j hij
      rw [Set.disjoint_left]
      rintro y ⟨b_i, rfl⟩ ⟨b_j, hbj⟩
      have h1 : V_0.ι.base ((τ_V0 i).base b_i) ∈ Set.range (τ_bar i).base := by
        change (τ_V0 i ≫ V_0.ι).base b_i ∈ Set.range (τ_bar i).base
        rw [hτ_V0_fac i]
        exact ⟨(s_0a i).base b_i, rfl⟩
      have h2 : V_0.ι.base ((τ_V0 i).base b_i) ∈ Set.range (τ_bar j).base := by
        rw [← hbj]
        change (τ_V0 j ≫ V_0.ι).base b_j ∈ Set.range (τ_bar j).base
        rw [hτ_V0_fac j]
        exact ⟨(s_0a j).base b_j, rfl⟩
      exact Set.disjoint_left.mp (hDisj_bar hij) h1 h2

    have hSm_cast : ∀ {A B : AlgebraicGeometry.Scheme.{u}} {d₁ d₂ : ℕ} {f₁ f₂ : A ⟶ B},
        d₁ = d₂ → f₁ = f₂ →
        AlgebraicGeometry.SmoothOfRelativeDimension d₁ f₁ →
        AlgebraicGeometry.SmoothOfRelativeDimension d₂ f₂ := by
      rintro _ _ _ _ _ _ rfl rfl h
      exact h
    have hSm_V0 : ∀ (j : Fin n) (b : (S_0 j).toScheme),
        ∃ V_sm0 : V_0.toScheme.Opens,
          (τ_V0 j).base b ∈ V_sm0 ∧
          AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm0.ι ≫ V_0.ι ≫ g_bar) := by
      intro j b
      obtain ⟨V_sm, hb_sm, hSm1⟩ := hSm_bar j ((s_0a j).base b)
      let V_sm0 : V_0.toScheme.Opens := (TopologicalSpace.Opens.map V_0.ι.base).obj V_sm
      have hb_sm0 : (τ_V0 j).base b ∈ V_sm0 := by
        change (τ_V0 j ≫ V_0.ι).base b ∈ V_sm
        rw [hτ_V0_fac j]
        exact hb_sm
      have hSm01 : AlgebraicGeometry.SmoothOfRelativeDimension (0 + 1)
          ((V_0.ι ∣_ V_sm) ≫ (V_sm.ι ≫ g_bar)) := inferInstance
      have hMorEq : (V_0.ι ∣_ V_sm) ≫ (V_sm.ι ≫ g_bar) = V_sm0.ι ≫ V_0.ι ≫ g_bar := by
        rw [← CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
          CategoryTheory.Category.assoc]
      exact ⟨V_sm0, hb_sm0, hSm_cast (Nat.zero_add 1) hMorEq hSm01⟩

    
    have hRel_V0 : ∀ (K' : Type u) [Field K'] [IsAlgClosed K']
        (s : AlgebraicGeometry.Spec (CommRingCat.of K') ⟶
          AlgebraicGeometry.Spec (CommRingCat.of ↥V))
        (E : Set ↥(CategoryTheory.Limits.pullback (V_0.ι ≫ g_bar) s))
        (E_sch : AlgebraicGeometry.Scheme.{u})
        (ιE : E_sch ⟶ CategoryTheory.Limits.pullback (V_0.ι ≫ g_bar) s),
        E ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback (V_0.ι ≫ g_bar) s) →
        AlgebraicGeometry.IsClosedImmersion ιE →
        AlgebraicGeometry.IsIntegral E_sch →
        Set.range ιE.base = E →
        (∃ isoP1 : E_sch ≅ (weilProjectiveSpaceOver K' 1).left,
          ιE ≫ CategoryTheory.Limits.pullback.snd (V_0.ι ≫ g_bar) s =
            isoP1.hom ≫ (weilProjectiveSpaceOver K' 1).hom) →
        (∃ x₀ : U_0.toScheme,
          ∀ q ∈ E,
            f_V0.base ((CategoryTheory.Limits.pullback.fst (V_0.ι ≫ g_bar) s).base q) = x₀) →
        ∃ q₁ q₂ q₃ : ↥(CategoryTheory.Limits.pullback (V_0.ι ≫ g_bar) s),
          q₁ ≠ q₂ ∧ q₁ ≠ q₃ ∧ q₂ ≠ q₃ ∧
          q₁ ∈ E ∧ q₂ ∈ E ∧ q₃ ∈ E ∧
          (∀ q ∈ ({q₁, q₂, q₃} : Set ↥(CategoryTheory.Limits.pullback (V_0.ι ≫ g_bar) s)),
            (∃ E' ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback (V_0.ι ≫ g_bar) s),
              E' ≠ E ∧ q ∈ E') ∨
            (∃ j : Fin n,
              (CategoryTheory.Limits.pullback.fst (V_0.ι ≫ g_bar) s).base q ∈
                Set.range (τ_V0 j).base)) := by
      intro K' _ _ s E E_sch ιE hE_comp hCl_ιE hInt_E hE_range ⟨isoP1, hisoP1⟩ ⟨x₀, hx₀⟩
      let F_0 := CategoryTheory.Limits.pullback (V_0.ι ≫ g_bar) s
      let F_a := CategoryTheory.Limits.pullback g_bar s
      let fst_0 := CategoryTheory.Limits.pullback.fst (V_0.ι ≫ g_bar) s
      let snd_0 := CategoryTheory.Limits.pullback.snd (V_0.ι ≫ g_bar) s
      let fst_a := CategoryTheory.Limits.pullback.fst g_bar s
      let snd_a := CategoryTheory.Limits.pullback.snd g_bar s
      let j_pb : F_0 ⟶ F_a := CategoryTheory.Limits.pullback.lift
        (fst_0 ≫ V_0.ι) snd_0
        (by rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition])
      have hPb_jpb : CategoryTheory.IsPullback fst_0 j_pb V_0.ι fst_a := by
        refine (CategoryTheory.IsPullback.paste_vert_iff
          (CategoryTheory.IsPullback.of_hasPullback g_bar s)
          (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm).mp ?_
        rw [CategoryTheory.Limits.pullback.lift_snd]
        exact CategoryTheory.IsPullback.of_hasPullback (V_0.ι ≫ g_bar) s
      have _ : AlgebraicGeometry.IsOpenImmersion j_pb :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (P := @AlgebraicGeometry.IsOpenImmersion) hPb_jpb inferInstance

      
      have _ : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver K' 1).hom := hProp_P1 K'
      have hiso_snd_a : (ιE ≫ j_pb) ≫ snd_a = isoP1.hom ≫ (weilProjectiveSpaceOver K' 1).hom := by
        rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd, hisoP1]
      have _ : AlgebraicGeometry.IsProper ((ιE ≫ j_pb) ≫ snd_a) := by
        rw [hiso_snd_a]
        infer_instance
      have _ : AlgebraicGeometry.IsProper (ιE ≫ j_pb) :=
        AlgebraicGeometry.IsProper.of_comp (ιE ≫ j_pb) snd_a
      have hCl_ιE_a : AlgebraicGeometry.IsClosedImmersion (ιE ≫ j_pb) :=
        @AlgebraicGeometry.IsClosedImmersion.of_isPreimmersion _ _ (ιE ≫ j_pb)
          inferInstance (ιE ≫ j_pb).isClosedMap.isClosed_range

      
      have hj_emb : Topology.IsOpenEmbedding j_pb.base := j_pb.isOpenEmbedding
      have hPreirred_pre : ∀ (S : Set ↥F_a),
          IsPreirreducible S → IsPreirreducible (j_pb.base ⁻¹' S) := by
        intro S hS U₁ U₂ hU₁ hU₂ ⟨z₁, hz₁S, hz₁U₁⟩ ⟨z₂, hz₂S, hz₂U₂⟩
        have hW₁ : IsOpen (j_pb.base '' U₁) := hj_emb.isOpenMap U₁ hU₁
        have hW₂ : IsOpen (j_pb.base '' U₂) := hj_emb.isOpenMap U₂ hU₂
        obtain ⟨y, hyS, ⟨w₁, hw₁U₁, hw₁y⟩, ⟨w₂, hw₂U₂, hw₂y⟩⟩ :=
          hS (j_pb.base '' U₁) (j_pb.base '' U₂) hW₁ hW₂
            ⟨j_pb.base z₁, hz₁S, z₁, hz₁U₁, rfl⟩
            ⟨j_pb.base z₂, hz₂S, z₂, hz₂U₂, rfl⟩
        have hw : w₁ = w₂ := hj_emb.injective (hw₁y.trans hw₂y.symm)
        subst hw
        exact ⟨w₁, by simpa [hw₁y] using hyS, hw₁U₁, hw₂U₂⟩
      have hIrred_closed_or : ∀ (S C U : Set ↥F_a),
          IsPreirreducible S → IsClosed C → IsOpen U →
          S ⊆ C ∪ Uᶜ → (S ∩ U).Nonempty → S ⊆ C := by
        intro S C U hS hC hU hSub ⟨y₁, hy₁S, hy₁U⟩ y₂ hy₂S
        by_contra hy₂C
        obtain ⟨y₃, hy₃S, hy₃notC, hy₃U⟩ :=
          hS Cᶜ U hC.isOpen_compl hU ⟨y₂, hy₂S, hy₂C⟩ ⟨y₁, hy₁S, hy₁U⟩
        rcases hSub hy₃S with hC₃ | hnotU₃
        · exact hy₃notC hC₃
        · exact hnotU₃ hy₃U

      let E_a : Set ↥F_a := j_pb.base '' E
      have hEa_range : Set.range (ιE ≫ j_pb).base = E_a := by
        change Set.range (j_pb.base ∘ ιE.base) = j_pb.base '' E
        rw [Set.range_comp, hE_range]
      have hClosed_Ea : IsClosed E_a := by
        rw [← hEa_range]
        exact (ιE ≫ j_pb).isClosedMap.isClosed_range
      have hEa_irred : IsIrreducible E_a :=
        hE_comp.1.image j_pb.base j_pb.continuous.continuousOn
      have hEa_comp : E_a ∈ irreducibleComponents ↥F_a := by
        refine ⟨hEa_irred, ?_⟩
        intro S_a hSa hES
        have hE_sub_pre : E ⊆ j_pb.base ⁻¹' S_a := fun q hq => hES ⟨q, hq, rfl⟩
        have hPre_irred : IsIrreducible (j_pb.base ⁻¹' S_a) :=
          ⟨hE_comp.1.1.mono hE_sub_pre, hPreirred_pre S_a hSa.2⟩
        have hPre_le_E : j_pb.base ⁻¹' S_a ⊆ E := hE_comp.2 hPre_irred hE_sub_pre
        have hSa_cov : S_a ⊆ E_a ∪ (Set.range j_pb.base)ᶜ := by
          intro y hy
          by_cases hyR : y ∈ Set.range j_pb.base
          · rcases hyR with ⟨q, rfl⟩
            exact Or.inl ⟨q, hPre_le_E hy, rfl⟩
          · exact Or.inr hyR
        obtain ⟨q₀, hq₀E⟩ := hE_comp.1.1
        exact hIrred_closed_or S_a E_a (Set.range j_pb.base) hSa.2 hClosed_Ea
          hj_emb.isOpen_range hSa_cov ⟨j_pb.base q₀, hES ⟨q₀, hq₀E, rfl⟩, q₀, rfl⟩

      have hx₀_a : ∀ y ∈ E_a, f_bar.base (fst_a.base y) = i_0a.base x₀ := by
        rintro _ ⟨q, hqE, rfl⟩
        have h1 : f_bar.base (fst_a.base (j_pb.base q)) =
            i_0a.base (f_V0.base (fst_0.base q)) := by
          change (j_pb ≫ fst_a ≫ f_bar).base q = (fst_0 ≫ f_V0 ≫ i_0a).base q
          rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
            CategoryTheory.Category.assoc, ← hf_V0_ia]
        rw [h1, hx₀ q hqE]

      obtain ⟨qa1, qa2, qa3, hne12, hne13, hne23, hqa1E, hqa2E, hqa3E, hSpec_a⟩ :=
        hRel_bar K' s E_a E_sch (ιE ≫ j_pb) hEa_comp hCl_ιE_a hInt_E hEa_range
          ⟨isoP1, hiso_snd_a⟩ ⟨i_0a.base x₀, hx₀_a⟩
      rcases hqa1E with ⟨q₁, hq₁E, rfl⟩
      rcases hqa2E with ⟨q₂, hq₂E, rfl⟩
      rcases hqa3E with ⟨q₃, hq₃E, rfl⟩
      refine ⟨q₁, q₂, q₃,
        fun h => hne12 (congrArg j_pb.base h),
        fun h => hne13 (congrArg j_pb.base h),
        fun h => hne23 (congrArg j_pb.base h),
        hq₁E, hq₂E, hq₃E, ?_⟩
      intro q hq_set
      have hqa_set : j_pb.base q ∈ ({j_pb.base q₁, j_pb.base q₂, j_pb.base q₃} : Set ↥F_a) := by
        rcases hq_set with rfl | rfl | rfl
        · exact Set.mem_insert _ _
        · exact Set.mem_insert_of_mem _ (Set.mem_insert _ _)
        · exact Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ (Set.mem_singleton _))
      rcases hSpec_a (j_pb.base q) hqa_set with ⟨E'_a, hE'a_comp, hE'a_ne, hq_E'a⟩ | ⟨j, b_a, hb_a⟩
      · left
        let E'_0 : Set ↥F_0 := j_pb.base ⁻¹' E'_a
        have hq_E'0 : q ∈ E'_0 := hq_E'a
        have hE'0_irred : IsIrreducible E'_0 :=
          ⟨⟨q, hq_E'0⟩, hPreirred_pre E'_a hE'a_comp.1.2⟩
        have hE'0_comp : E'_0 ∈ irreducibleComponents ↥F_0 := by
          refine ⟨hE'0_irred, ?_⟩
          intro T_0 hT0 hSub0
          let T_a : Set ↥F_a := closure (j_pb.base '' T_0)
          have hTa_irred : IsIrreducible T_a :=
            (hT0.image j_pb.base j_pb.continuous.continuousOn).closure
          have hE'a_cov : E'_a ⊆ T_a ∪ (Set.range j_pb.base)ᶜ := by
            intro y hy
            by_cases hyR : y ∈ Set.range j_pb.base
            · rcases hyR with ⟨z, rfl⟩
              exact Or.inl (subset_closure ⟨z, hSub0 hy, rfl⟩)
            · exact Or.inr hyR
          have hE'a_sub_Ta : E'_a ⊆ T_a :=
            hIrred_closed_or E'_a T_a (Set.range j_pb.base) hE'a_comp.1.2 isClosed_closure
              hj_emb.isOpen_range hE'a_cov ⟨j_pb.base q, hq_E'a, q, rfl⟩
          have hTa_sub_E'a : T_a ⊆ E'_a := hE'a_comp.2 hTa_irred hE'a_sub_Ta
          intro z hz
          exact hTa_sub_E'a (subset_closure ⟨z, hz, rfl⟩)
        have hE'0_ne : E'_0 ≠ E := by
          intro hEq
          have hE'a_cov : E'_a ⊆ E_a ∪ (Set.range j_pb.base)ᶜ := by
            intro y hy
            by_cases hyR : y ∈ Set.range j_pb.base
            · rcases hyR with ⟨z, rfl⟩
              have hzE : z ∈ E := by
                rw [← hEq]
                exact hy
              exact Or.inl ⟨z, hzE, rfl⟩
            · exact Or.inr hyR
          have hle1 : E'_a ⊆ E_a :=
            hIrred_closed_or E'_a E_a (Set.range j_pb.base) hE'a_comp.1.2 hClosed_Ea
              hj_emb.isOpen_range hE'a_cov ⟨j_pb.base q, hq_E'a, q, rfl⟩
          have hle2 : E_a ⊆ E'_a := hE'a_comp.2 hEa_irred hle1
          exact hE'a_ne (Set.Subset.antisymm hle1 hle2)
        exact ⟨E'_0, hE'0_comp, hE'0_ne, hq_E'0⟩
      · right
        have hb_mem_S0 : (S_a j).ι.base b_a ∈ (S_0 j : Set _) := by
          change (τ' j).base ((S_a j).ι.base b_a) ∈ (U_0 : Set ↥C')
          have h1 : (τ' j).base ((S_a j).ι.base b_a) =
              (f_V0 ≫ U_0.ι).base (fst_0.base q) := by
            calc
              (τ' j).base ((S_a j).ι.base b_a) = ((S_a j).ι ≫ τ' j).base b_a := rfl
              _ = ((τ_bar j ≫ f_bar) ≫ U_a.ι).base b_a := by rw [← hτbar_comm j]
              _ = (f_bar ≫ U_a.ι).base ((τ_bar j).base b_a) := rfl
              _ = (f_bar ≫ U_a.ι).base (fst_a.base (j_pb.base q)) := by rw [hb_a]
              _ = (j_pb ≫ fst_a ≫ f_bar ≫ U_a.ι).base q := rfl
              _ = ((j_pb ≫ fst_a) ≫ f_bar ≫ U_a.ι).base q := by
                simp only [CategoryTheory.Category.assoc]
              _ = ((fst_0 ≫ V_0.ι) ≫ f_bar ≫ U_a.ι).base q := by
                rw [CategoryTheory.Limits.pullback.lift_fst]
              _ = (fst_0 ≫ (V_0.ι ≫ f_bar ≫ U_a.ι)).base q := by
                simp only [CategoryTheory.Category.assoc]
              _ = (fst_0 ≫ (f_V0 ≫ U_0.ι)).base q := by rw [← hf_V0]
              _ = (f_V0 ≫ U_0.ι).base (fst_0.base q) := rfl
          rw [h1, ← U_0.range_ι]
          exact ⟨f_V0.base (fst_0.base q), rfl⟩
        rw [← hRange_homOfLE ((TopologicalSpace.Opens.map (τ' j).base).monotone hLE)] at hb_mem_S0
        obtain ⟨b_0, hb_0⟩ := hb_mem_S0
        refine ⟨j, b_0, V_0.ι.isOpenEmbedding.injective ?_⟩
        calc
          V_0.ι.base ((τ_V0 j).base b_0) = (τ_V0 j ≫ V_0.ι).base b_0 := rfl
          _ = (s_0a j ≫ τ_bar j).base b_0 := by rw [hτ_V0_fac j]
          _ = (τ_bar j).base ((s_0a j).base b_0) := rfl
          _ = (τ_bar j).base b_a := congrArg (τ_bar j).base hb_0
          _ = fst_a.base (j_pb.base q) := hb_a
          _ = (j_pb ≫ fst_a).base q := rfl
          _ = (fst_0 ≫ V_0.ι).base q := by rw [CategoryTheory.Limits.pullback.lift_fst]
          _ = V_0.ι.base (fst_0.base q) := rfl

    have hf_V0_g : f_V0 ≫ U_0.ι ≫ g' = V_0.ι ≫ g_bar := by
      rw [← CategoryTheory.Category.assoc, hf_V0, CategoryTheory.Category.assoc,
        CategoryTheory.Category.assoc, hfbar_g]
    exact ⟨ι_U0, f_V0, τ_V0, ι_V0, hι_U0, hPb_U0, hf_V0, hNoeth_V0, hCl_τV0,
      ⟨hSS_V0, hProp_fV0, hf_V0_g, hι_V0_f, hPb_V0, hτ_V0_comm, hDisj_V0, hSm_V0, hRel_V0⟩⟩

  
  · intro U_0 hU_0 ι_U0 hPb_U0 X Y g_X g_Y f_X f_Y ι_X ι_Y
      hIntX hSepY hfX_g hfY_g hιX_f hιY_f hPb_X hPb_Y
    let U_0K : C_K.Opens := (TopologicalSpace.Opens.map ι'.base).obj U_0
    have _ : Nonempty ↥U_0K.toScheme := hNonemptyUK U_0 hU_0
    have _ : AlgebraicGeometry.IsOpenImmersion ι_U0 :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (P := @AlgebraicGeometry.IsOpenImmersion) hPb_U0.flip hOpenη
    have _ : AlgebraicGeometry.IsOpenImmersion ι_X :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (P := @AlgebraicGeometry.IsOpenImmersion) hPb_X.flip hOpenη
    refine ⟨?_, ?_⟩
    · intro ψ₁ ψ₂ hψ₁ hψ₂
      have _ : IrreducibleSpace ↥X :=
        @AlgebraicGeometry.irreducibleSpace_of_isIntegral X hIntX
      have _ : AlgebraicGeometry.IsDominant ι_X := by
        rw [AlgebraicGeometry.isDominant_iff, DenseRange]
        exact ι_X.isOpenEmbedding.isOpen_range.dense (Set.range_nonempty ι_X.base)
      have hψ₁_g : ψ₁ ≫ g_Y = g_X := by
        rw [← hfY_g, ← CategoryTheory.Category.assoc, hψ₁, hfX_g]
      have hψ₂_g : ψ₂ ≫ g_Y = g_X := by
        rw [← hfY_g, ← CategoryTheory.Category.assoc, hψ₂, hfX_g]
      have hα₁_cond : (ι_X ≫ ψ₁) ≫ g_Y = (U_0K.ι ≫ p_K) ≫ η_V := by
        rw [CategoryTheory.Category.assoc, hψ₁_g, hPb_X.w]
      have hα₂_cond : (ι_X ≫ ψ₂) ≫ g_Y = (U_0K.ι ≫ p_K) ≫ η_V := by
        rw [CategoryTheory.Category.assoc, hψ₂_g, hPb_X.w]
      let α₁ := hPb_Y.lift (ι_X ≫ ψ₁) (U_0K.ι ≫ p_K) hα₁_cond
      let α₂ := hPb_Y.lift (ι_X ≫ ψ₂) (U_0K.ι ≫ p_K) hα₂_cond
      have hα₁_fst : α₁ ≫ ι_Y = ι_X ≫ ψ₁ := hPb_Y.lift_fst _ _ _
      have hα₂_fst : α₂ ≫ ι_Y = ι_X ≫ ψ₂ := hPb_Y.lift_fst _ _ _
      have hα_eq : α₁ = α₂ := by
        apply (cancel_mono ι_U0).mp
        calc
          α₁ ≫ ι_U0 = α₁ ≫ (ι_Y ≫ f_Y) := by rw [← hιY_f]
          _ = (α₁ ≫ ι_Y) ≫ f_Y := by rw [← CategoryTheory.Category.assoc]
          _ = (ι_X ≫ ψ₁) ≫ f_Y := by rw [hα₁_fst]
          _ = ι_X ≫ f_X := by rw [CategoryTheory.Category.assoc, hψ₁]
          _ = (ι_X ≫ ψ₂) ≫ f_Y := by rw [← hψ₂, CategoryTheory.Category.assoc]
          _ = (α₂ ≫ ι_Y) ≫ f_Y := by rw [← hα₂_fst]
          _ = α₂ ≫ ι_U0 := by rw [CategoryTheory.Category.assoc, hιY_f]
      have hι_eq : ι_X ≫ ψ₁ = ι_X ≫ ψ₂ := by
        rw [← hα₁_fst, ← hα₂_fst]
        exact congrArg (· ≫ ι_Y) hα_eq
      exact AlgebraicGeometry.ext_of_isDominant_of_isSeparated g_Y
        (hψ₁_g.trans hψ₂_g.symm) ι_X hι_eq
    · intro S₀ s₁ s₂ hs₁ hs₂ hsf
      rcases isEmpty_or_nonempty ↥S₀.toScheme with hEmpty | hNonempty
      · exact (AlgebraicGeometry.isInitialOfIsEmpty (X := S₀.toScheme)).hom_ext s₁ s₂
      · have hIntSpecV : AlgebraicGeometry.IsIntegral
            (AlgebraicGeometry.Spec (CommRingCat.of ↥V)) := inferInstance
        have hIrredSpecV : IrreducibleSpace ↥(AlgebraicGeometry.Spec (CommRingCat.of ↥V)) :=
          @AlgebraicGeometry.irreducibleSpace_of_isIntegral _ hIntSpecV
        have _ : PreirreducibleSpace ↥(AlgebraicGeometry.Spec (CommRingCat.of ↥V)) :=
          hIrredSpecV.toPreirreducibleSpace
        have hIntS₀ : AlgebraicGeometry.IsIntegral S₀.toScheme :=
          @AlgebraicGeometry.isIntegral_of_isOpenImmersion _ _ S₀.ι inferInstance hIntSpecV hNonempty
        have _ : IrreducibleSpace ↥S₀.toScheme :=
          @AlgebraicGeometry.irreducibleSpace_of_isIntegral _ hIntS₀
        obtain ⟨u₀⟩ := hNonempty
        have hu₀_mem : S₀.ι.base u₀ ∈ (S₀ : Set _) := by
          rw [← S₀.range_ι]
          exact ⟨u₀, rfl⟩
        obtain ⟨ptK⟩ := (inferInstance : Nonempty ↥(AlgebraicGeometry.Spec (CommRingCat.of K)))
        obtain ⟨_, hyS₀, ⟨x₀, rfl⟩⟩ :=
          nonempty_preirreducible_inter S₀.2 η_V.isOpenEmbedding.isOpen_range
            ⟨S₀.ι.base u₀, hu₀_mem⟩ ⟨η_V.base ptK, ptK, rfl⟩
        have hη_range : Set.range η_V.base ⊆ Set.range S₀.ι.base := by
          rintro _ ⟨x, rfl⟩
          rw [S₀.range_ι, Subsingleton.elim x x₀]
          exact hyS₀
        let j_K : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ S₀.toScheme :=
          AlgebraicGeometry.IsOpenImmersion.lift S₀.ι η_V hη_range
        have hj_K : j_K ≫ S₀.ι = η_V :=
          AlgebraicGeometry.IsOpenImmersion.lift_fac S₀.ι η_V hη_range
        have hOpen_jK : AlgebraicGeometry.IsOpenImmersion j_K := by
          have _ : AlgebraicGeometry.IsOpenImmersion (j_K ≫ S₀.ι) := by
            rwa [hj_K]
          exact AlgebraicGeometry.IsOpenImmersion.of_comp j_K S₀.ι
        have _ : AlgebraicGeometry.IsDominant j_K := by
          rw [AlgebraicGeometry.isDominant_iff, DenseRange]
          exact j_K.isOpenEmbedding.isOpen_range.dense (Set.range_nonempty j_K.base)
        have hβ₁_cond : (j_K ≫ s₁) ≫ g_Y = 𝟙 _ ≫ η_V := by
          rw [CategoryTheory.Category.assoc, hs₁, hj_K, CategoryTheory.Category.id_comp]
        have hβ₂_cond : (j_K ≫ s₂) ≫ g_Y = 𝟙 _ ≫ η_V := by
          rw [CategoryTheory.Category.assoc, hs₂, hj_K, CategoryTheory.Category.id_comp]
        let β₁ := hPb_Y.lift (j_K ≫ s₁) (𝟙 _) hβ₁_cond
        let β₂ := hPb_Y.lift (j_K ≫ s₂) (𝟙 _) hβ₂_cond
        have hβ₁_fst : β₁ ≫ ι_Y = j_K ≫ s₁ := hPb_Y.lift_fst _ _ _
        have hβ₂_fst : β₂ ≫ ι_Y = j_K ≫ s₂ := hPb_Y.lift_fst _ _ _
        have hβ_eq : β₁ = β₂ := by
          apply (cancel_mono ι_U0).mp
          calc
            β₁ ≫ ι_U0 = β₁ ≫ (ι_Y ≫ f_Y) := by rw [← hιY_f]
            _ = (β₁ ≫ ι_Y) ≫ f_Y := by rw [← CategoryTheory.Category.assoc]
            _ = (j_K ≫ s₁) ≫ f_Y := by rw [hβ₁_fst]
            _ = j_K ≫ (s₁ ≫ f_Y) := by rw [CategoryTheory.Category.assoc]
            _ = j_K ≫ (s₂ ≫ f_Y) := by rw [hsf]
            _ = (j_K ≫ s₂) ≫ f_Y := by rw [← CategoryTheory.Category.assoc]
            _ = (β₂ ≫ ι_Y) ≫ f_Y := by rw [← hβ₂_fst]
            _ = β₂ ≫ ι_U0 := by rw [CategoryTheory.Category.assoc, hιY_f]
        have hj_eq : j_K ≫ s₁ = j_K ≫ s₂ := by
          rw [← hβ₁_fst, ← hβ₂_fst]
          exact congrArg (· ≫ ι_Y) hβ_eq
        exact AlgebraicGeometry.ext_of_isDominant_of_isSeparated g_Y
          (hs₁.trans hs₂.symm) j_K hj_eq

theorem weil_overlap_birational_graph_closure_and_twoVar_setup (K : Type u) [Field K]
    (m : ℕ) (V : ValuationSubring K) (hPkg : IsValuationRingAlgPackage m V)
    (hOpenη : AlgebraicGeometry.IsOpenImmersion
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (n : ℕ) (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (hIntCK : AlgebraicGeometry.IsIntegral C_K)
    (hSmCK : AlgebraicGeometry.SmoothOfRelativeDimension 1 p_K)
    (C' : AlgebraicGeometry.Scheme.{u})
    (g' : C' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (τ' : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C'))
    (ι' : C_K ⟶ C')
    (hMod' : IsValuationPointedCurveModel V p_K n σ_K C' g' τ' ι')
    (U_0 : C'.Opens) (hU_0 : Nonempty ↥U_0)
    (ι_U0 : AlgebraicGeometry.Scheme.Opens.toScheme
      ((TopologicalSpace.Opens.map ι'.base).obj U_0) ⟶ U_0.toScheme)
    (hPb_U0 : CategoryTheory.IsPullback ι_U0
      (AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj U_0) ≫ p_K)
      (U_0.ι ≫ g')
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (X Y : AlgebraicGeometry.Scheme.{u})
    (g_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (g_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (f_X : X ⟶ U_0.toScheme)
    (f_Y : Y ⟶ U_0.toScheme)
    (ι_X : AlgebraicGeometry.Scheme.Opens.toScheme
      ((TopologicalSpace.Opens.map ι'.base).obj U_0) ⟶ X)
    (ι_Y : AlgebraicGeometry.Scheme.Opens.toScheme
      ((TopologicalSpace.Opens.map ι'.base).obj U_0) ⟶ Y)
    (hIntX : AlgebraicGeometry.IsIntegral X)
    (hIntY : AlgebraicGeometry.IsIntegral Y)
    (hLfpX : AlgebraicGeometry.LocallyOfFinitePresentation g_X)
    (hNoethX : TopologicalSpace.NoetherianSpace ↥X)
    (hProp_fX : AlgebraicGeometry.IsProper f_X)
    (hProp_fY : AlgebraicGeometry.IsProper f_Y)
    (hfX_g : f_X ≫ U_0.ι ≫ g' = g_X)
    (hfY_g : f_Y ≫ U_0.ι ≫ g' = g_Y)
    (hιX_fX : ι_X ≫ f_X = ι_U0)
    (hιY_fY : ι_Y ≫ f_Y = ι_U0)
    (hPb_X : CategoryTheory.IsPullback ι_X
      (AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj U_0) ≫ p_K)
      g_X
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (hPb_Y : CategoryTheory.IsPullback ι_Y
      (AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj U_0) ≫ p_K)
      g_Y
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype))) :
    ∃ (F : Type u) (_ : Field F)
      (φ_KF : K →+* F)
      (P_tilde : AlgebraicGeometry.Scheme.{u})
      (π₁ : P_tilde ⟶ X)
      (π₂ : P_tilde ⟶ Y)
      (ι_P : AlgebraicGeometry.Scheme.Opens.toScheme
        ((TopologicalSpace.Opens.map ι'.base).obj U_0) ⟶ P_tilde)
      (η_P : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ P_tilde)
      (η_X : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ X)
      (η_Y : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ Y),
      AlgebraicGeometry.IsIntegral P_tilde ∧
      TopologicalSpace.NoetherianSpace ↥P_tilde ∧
      AlgebraicGeometry.IsProper π₁ ∧
      AlgebraicGeometry.IsProper π₂ ∧
      π₁ ≫ f_X = π₂ ≫ f_Y ∧
      ι_P ≫ π₁ = ι_X ∧
      ι_P ≫ π₂ = ι_Y ∧
      CategoryTheory.IsPullback ι_P
        (AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj U_0) ≫ p_K)
        (π₁ ≫ g_X)
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)) ∧
      AlgebraicGeometry.IsDominant η_P ∧
      η_P ≫ π₁ = η_X ∧
      η_P ≫ π₂ = η_Y ∧
      IsSchemeFunctionField P_tilde F η_P ∧
      IsSchemeFunctionField X F η_X ∧
      IsSchemeFunctionField Y F η_Y ∧
      (∀ c : ↥V,
        φ_KF (V.subtype c) = (AlgebraicGeometry.Spec.preimage (η_X ≫ g_X)).hom c) ∧
      (letI : Algebra K F := φ_KF.toAlgebra
       Algebra.EssFiniteType K F ∧ Algebra.trdeg K F ≤ 1) ∧
      (∀ x : X, (g_X.base x).asIdeal = ⊥ → Set.Subsingleton (π₁.base ⁻¹' {x})) ∧
      (∀ z : P_tilde,
        ∃ (U_X : X.Opens) (_ : AlgebraicGeometry.IsAffineOpen U_X)
          (U_Y : Y.Opens) (_ : AlgebraicGeometry.IsAffineOpen U_Y)
          (V_P : P_tilde.Opens) (_ : AlgebraicGeometry.IsAffineOpen V_P)
          (e_X : V_P ≤ (TopologicalSpace.Opens.map π₁.base).obj U_X)
          (e_Y : V_P ≤ (TopologicalSpace.Opens.map π₂.base).obj U_Y),
          z ∈ V_P ∧
          (π₁.appLE U_X V_P e_X).hom.FiniteType ∧
          Subring.closure
            (Set.range (π₂.appLE U_Y V_P e_Y).hom ∪
              Set.range (π₁.appLE U_X V_P e_X).hom) = ⊤) :=
by
  
  
  
  have basicOpen_algebraMap_eq : ∀ (W_sch : AlgebraicGeometry.Scheme.{u}) (U : W_sch.Opens)
      (r : ↑(W_sch.presheaf.obj (Opposite.op U))),
      algebraMap ↑(W_sch.presheaf.obj (Opposite.op U))
        ↑(W_sch.presheaf.obj (Opposite.op (W_sch.basicOpen r))) =
        (W_sch.presheaf.map (CategoryTheory.homOfLE (W_sch.basicOpen_le r)).op).hom := by
    clear * -
    intro W_sch U r
    ext a
    change (@Algebra.algebraMap _ _ _ _
      (AlgebraicGeometry.Scheme.algebra_section_section_basicOpen r)) a = _
    unfold AlgebraicGeometry.Scheme.algebra_section_section_basicOpen
    rfl

  have hIsFrac_of_away : ∀ {F A B : Type u} [Field F] [CommRing A] [IsDomain A]
      [CommRing B] [Algebra A B] (r : A) (_ : r ≠ 0) [IsLocalization.Away r B]
      (ψ : B →+* F) (φ : A →+* F),
      (∀ a : A, φ a = ψ (algebraMap A B a)) →
      @IsFractionRing B _ F _ ψ.toAlgebra →
      @IsFractionRing A _ F _ φ.toAlgebra := by
    clear * -
    intro F A B _ _ _ _ _ r hr _ ψ φ hφ hFracB
    have hPow_nzd : Submonoid.powers r ≤ nonZeroDivisors A := by
      rintro _ ⟨k, rfl⟩
      exact mem_nonZeroDivisors_of_ne_zero (pow_ne_zero k hr)
    have hInj_AB : Function.Injective (algebraMap A B) :=
      IsLocalization.injective B hPow_nzd
    have hInj_ψ : Function.Injective ψ := by
      let _ : Algebra B F := ψ.toAlgebra
      exact @IsFractionRing.injective B _ F _ _ hFracB
    have hInj_φ : Function.Injective φ := by
      intro x y hxy
      rw [hφ x, hφ y] at hxy
      exact hInj_AB (hInj_ψ hxy)
    let _ : Algebra A F := φ.toAlgebra
    refine
      { map_units := fun y => IsUnit.mk0 (φ y.1) (fun h0 =>
          nonZeroDivisors.ne_zero y.2 (hInj_φ (h0.trans φ.map_zero.symm)))
        surj := fun z => ?_
        exists_of_eq := fun {x y} hxy => ⟨1, by simp [hInj_φ hxy]⟩ }
    let _ : Algebra B F := ψ.toAlgebra
    obtain ⟨⟨b₁, b₂⟩, hz_eq⟩ := @IsLocalization.surj B _ (nonZeroDivisors B) F _ _ hFracB z
    have hψb₂_ne : ψ b₂.1 ≠ 0 :=
      (@IsLocalization.map_units B _ (nonZeroDivisors B) F _ _ hFracB b₂).ne_zero
    obtain ⟨n₁, a₁, hb₁⟩ := IsLocalization.Away.surj r b₁
    obtain ⟨n₂, a₂, hb₂⟩ := IsLocalization.Away.surj r b₂.1
    have hφr_ne : φ r ≠ 0 := fun h0 => hr (hInj_φ (h0.trans φ.map_zero.symm))
    have ha₂_ne : a₂ ≠ 0 := by
      intro ha₂_0
      have h0 : ψ (algebraMap A B a₂) = 0 := by
        rw [← hφ a₂, ha₂_0, map_zero]
      rw [← hb₂, map_mul, map_pow, ← hφ r] at h0
      exact mul_ne_zero hψb₂_ne (pow_ne_zero n₂ hφr_ne) h0
    have hden_nzd : a₂ * r ^ n₁ ∈ nonZeroDivisors A :=
      mem_nonZeroDivisors_of_ne_zero (mul_ne_zero ha₂_ne (pow_ne_zero n₁ hr))
    refine ⟨⟨a₁ * r ^ n₂, ⟨a₂ * r ^ n₁, hden_nzd⟩⟩, ?_⟩
    change z * φ (a₂ * r ^ n₁) = φ (a₁ * r ^ n₂)
    have h1 : φ a₁ = ψ b₁ * (φ r) ^ n₁ := by
      rw [hφ a₁, ← hb₁, map_mul, map_pow, ← hφ r]
    have h2 : φ a₂ = ψ b₂.1 * (φ r) ^ n₂ := by
      rw [hφ a₂, ← hb₂, map_mul, map_pow, ← hφ r]
    have hz' : z * ψ b₂.1 = ψ b₁ := hz_eq
    calc
      z * φ (a₂ * r ^ n₁) = z * (φ a₂ * (φ r) ^ n₁) := by rw [map_mul, map_pow]
      _ = (z * ψ b₂.1) * ((φ r) ^ n₂ * (φ r) ^ n₁) := by rw [h2]; ring
      _ = (ψ b₁ * (φ r) ^ n₁) * (φ r) ^ n₂ := by rw [hz']; ring
      _ = φ a₁ * (φ r) ^ n₂ := by rw [h1]
      _ = φ (a₁ * r ^ n₂) := by rw [map_mul, map_pow]

  
  have step_funcCK : ∀ (W_K : AlgebraicGeometry.Scheme.{u})
      (_ : AlgebraicGeometry.IsIntegral W_K)
      (V_K : W_K.Opens) (hVK : AlgebraicGeometry.IsAffineOpen V_K)
      (x₀_K : ↥W_K) (_ : x₀_K ∈ V_K)
      (hDomBK : IsDomain ↑(W_K.presheaf.obj (Opposite.op V_K))),
      let B_K : Type u := ↑(W_K.presheaf.obj (Opposite.op V_K))
      let F : Type u := FractionRing B_K
      let ι_frac : W_K.presheaf.obj (Opposite.op V_K) ⟶ CommRingCat.of F :=
        CommRingCat.ofHom (algebraMap B_K F)
      let η_CK : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ W_K :=
        AlgebraicGeometry.Spec.map ι_frac ≫ hVK.fromSpec
      IsSchemeFunctionField W_K F η_CK := by
    clear * - basicOpen_algebraMap_eq hIsFrac_of_away
    intro C_K hIntCK V_K hVK x₀_K hx₀_VK hDomBK B_K F ι_frac η_CK U hU hUne
    have hIrredCK : IrreducibleSpace ↥C_K :=
      @AlgebraicGeometry.irreducibleSpace_of_isIntegral C_K hIntCK
    have : PreirreducibleSpace ↥C_K := hIrredCK.toPreirreducibleSpace
    let A_U : Type u := ↑(C_K.presheaf.obj (Opposite.op U))
    have : IsDomain A_U :=
      @AlgebraicGeometry.IsIntegral.component_integral C_K hIntCK U hUne
    obtain ⟨⟨u₀, hu₀⟩⟩ := id hUne
    obtain ⟨z, hzU, hzVK⟩ :=
      nonempty_preirreducible_inter U.2 V_K.2 ⟨u₀, hu₀⟩ ⟨x₀_K, hx₀_VK⟩
    obtain ⟨r, hr_le_VK, hz_Dr⟩ := hU.exists_basicOpen_le ⟨z, hzVK⟩ hzU
    have hDr_aff : AlgebraicGeometry.IsAffineOpen (C_K.basicOpen r) := hU.basicOpen r
    have hDr_ne : Nonempty ↥(C_K.basicOpen r) := ⟨⟨z, hz_Dr⟩⟩
    have : IsDomain ↑(C_K.presheaf.obj (Opposite.op (C_K.basicOpen r))) :=
      @AlgebraicGeometry.IsIntegral.component_integral C_K hIntCK (C_K.basicOpen r) hDr_ne
    obtain ⟨s, hs_le_Dr, hz_Ds⟩ := hVK.exists_basicOpen_le ⟨z, hz_Dr⟩ hzVK
    have hDs_aff : AlgebraicGeometry.IsAffineOpen (C_K.basicOpen s) := hVK.basicOpen s
    have hr_ne : r ≠ 0 := by intro hr0; simp [hr0] at hz_Dr
    have hs_ne : s ≠ 0 := by intro hs0; simp [hs0] at hz_Ds
    have : IsLocalization.Away s ↑(C_K.presheaf.obj (Opposite.op (C_K.basicOpen s))) :=
      hVK.isLocalization_basicOpen s
    have halg_s_ne : algebraMap B_K F s ≠ 0 := fun h0 =>
      hs_ne ((IsFractionRing.injective B_K F) (h0.trans (map_zero _).symm))
    let ψ_Ds : ↑(C_K.presheaf.obj (Opposite.op (C_K.basicOpen s))) →+* F :=
      IsLocalization.Away.lift s (IsUnit.mk0 (algebraMap B_K F s) halg_s_ne)
    let res_VK_Ds := C_K.presheaf.map (CategoryTheory.homOfLE (C_K.basicOpen_le s)).op
    have hres_VK_eq : res_VK_Ds.hom =
        algebraMap ↑(C_K.presheaf.obj (Opposite.op V_K))
          ↑(C_K.presheaf.obj (Opposite.op (C_K.basicOpen s))) :=
      (basicOpen_algebraMap_eq C_K V_K s).symm
    have hψ_comp_VK : ψ_Ds.comp res_VK_Ds.hom = algebraMap B_K F := by
      ext b
      change ψ_Ds (res_VK_Ds.hom b) = algebraMap B_K F b
      rw [hres_VK_eq]
      exact IsLocalization.Away.lift_eq s (IsUnit.mk0 (algebraMap B_K F s) halg_s_ne) b
    have hDomDs : IsDomain ↑(C_K.presheaf.obj (Opposite.op (C_K.basicOpen s))) :=
      @AlgebraicGeometry.IsIntegral.component_integral C_K hIntCK (C_K.basicOpen s) ⟨⟨z, hz_Ds⟩⟩
    have hFrac_Ds :
        @IsFractionRing ↑(C_K.presheaf.obj (Opposite.op (C_K.basicOpen s))) _ F _ ψ_Ds.toAlgebra := by
      have hPow_s : Submonoid.powers s ≤ nonZeroDivisors B_K := by
        rintro _ ⟨k, rfl⟩
        exact mem_nonZeroDivisors_of_ne_zero (pow_ne_zero k hs_ne)
      have hInj_res : Function.Injective
          (algebraMap ↑(C_K.presheaf.obj (Opposite.op V_K))
            ↑(C_K.presheaf.obj (Opposite.op (C_K.basicOpen s)))) :=
        IsLocalization.injective _ hPow_s
      have hInj_ψ : Function.Injective ψ_Ds := by
        intro w₁ w₂ hw
        have hw0 : ψ_Ds (w₁ - w₂) = 0 := by rw [map_sub, hw, sub_self]
        obtain ⟨k, b, hwb⟩ := IsLocalization.Away.surj s (w₁ - w₂)
        have hfb : algebraMap B_K F b = 0 := by
          have := congrArg ψ_Ds hwb
          rw [map_mul, map_pow, hw0, zero_mul] at this
          exact (IsLocalization.Away.lift_eq s
            (IsUnit.mk0 (algebraMap B_K F s) halg_s_ne) b).symm.trans this.symm
        have hb0 : b = 0 := (IsFractionRing.injective B_K F) (hfb.trans (map_zero _).symm)
        rw [hb0, map_zero] at hwb
        have hs_res_ne :
            (algebraMap ↑(C_K.presheaf.obj (Opposite.op V_K))
              ↑(C_K.presheaf.obj (Opposite.op (C_K.basicOpen s)))) s ≠ 0 :=
          fun h0 => hs_ne (hInj_res (h0.trans (map_zero _).symm))
        exact sub_eq_zero.mp ((mul_eq_zero.mp hwb).resolve_right (pow_ne_zero k hs_res_ne))
      let _ : Algebra ↑(C_K.presheaf.obj (Opposite.op (C_K.basicOpen s))) F := ψ_Ds.toAlgebra
      refine
        { map_units := fun y => IsUnit.mk0 (ψ_Ds y.1) (fun h0 =>
            nonZeroDivisors.ne_zero y.2 (hInj_ψ (h0.trans ψ_Ds.map_zero.symm)))
          surj := fun f => ?_
          exists_of_eq := fun {x y} hxy => ⟨1, by simp [hInj_ψ hxy]⟩ }
      obtain ⟨⟨b₁, b₂⟩, hf_eq⟩ := IsLocalization.surj (M := nonZeroDivisors B_K) f
      have hb₂_ne : b₂.1 ≠ 0 := nonZeroDivisors.ne_zero b₂.2
      have hres_b₂_ne : res_VK_Ds.hom b₂.1 ≠ 0 := by
        rw [hres_VK_eq]
        exact fun h0 => hb₂_ne (hInj_res (h0.trans (map_zero _).symm))
      refine ⟨⟨res_VK_Ds.hom b₁, ⟨res_VK_Ds.hom b₂.1, mem_nonZeroDivisors_of_ne_zero hres_b₂_ne⟩⟩, ?_⟩
      change f * ψ_Ds (res_VK_Ds.hom b₂.1) = ψ_Ds (res_VK_Ds.hom b₁)
      have h1 : ψ_Ds (res_VK_Ds.hom b₁) = algebraMap B_K F b₁ :=
        RingHom.congr_fun hψ_comp_VK b₁
      have h2 : ψ_Ds (res_VK_Ds.hom b₂.1) = algebraMap B_K F b₂.1 :=
        RingHom.congr_fun hψ_comp_VK b₂.1
      rw [h1, h2]
      exact hf_eq
    let s' := (C_K.presheaf.map (CategoryTheory.homOfLE hr_le_VK).op).hom s
    have hDs_eq : C_K.basicOpen s' = C_K.basicOpen s := by
      rw [C_K.basicOpen_res s (CategoryTheory.homOfLE hr_le_VK).op]
      exact inf_eq_right.mpr hs_le_Dr
    have hs'_ne : s' ≠ 0 := by
      intro hs'0
      have hbot : C_K.basicOpen s' = ⊥ := by simp [hs'0]
      rw [hDs_eq] at hbot
      change z ∈ (C_K.basicOpen s : Set C_K) at hz_Ds
      rw [hbot] at hz_Ds
      exact hz_Ds
    let iso_Ds : C_K.presheaf.obj (Opposite.op (C_K.basicOpen s)) ≅
        C_K.presheaf.obj (Opposite.op (C_K.basicOpen s')) :=
      { hom := C_K.presheaf.map (CategoryTheory.homOfLE hDs_eq.le).op
        inv := C_K.presheaf.map (CategoryTheory.homOfLE hDs_eq.ge).op
        hom_inv_id := by rw [← C_K.presheaf.map_comp]; exact C_K.presheaf.map_id _
        inv_hom_id := by rw [← C_K.presheaf.map_comp]; exact C_K.presheaf.map_id _ }
    let ψ_Ds' : ↑(C_K.presheaf.obj (Opposite.op (C_K.basicOpen s'))) →+* F :=
      (iso_Ds.inv ≫ CommRingCat.ofHom ψ_Ds).hom
    have hFrac_Ds' :
        @IsFractionRing ↑(C_K.presheaf.obj (Opposite.op (C_K.basicOpen s'))) _ F _ ψ_Ds'.toAlgebra := by
      let e_ring := iso_Ds.commRingCatIsoToRingEquiv
      have : IsDomain ↑(C_K.presheaf.obj (Opposite.op (C_K.basicOpen s'))) :=
        @AlgebraicGeometry.IsIntegral.component_integral C_K hIntCK (C_K.basicOpen s')
          ⟨⟨z, hDs_eq.symm ▸ (hz_Ds : z ∈ C_K.basicOpen s)⟩⟩
      have hψ_symm : ∀ w, ψ_Ds' (e_ring w) = ψ_Ds w := by
        intro w
        change (iso_Ds.hom ≫ iso_Ds.inv ≫ CommRingCat.ofHom ψ_Ds).hom w = ψ_Ds w
        rw [iso_Ds.hom_inv_id_assoc]; rfl
      have hInj_ψ' : Function.Injective ψ_Ds' := by
        intro x y hxy
        obtain ⟨wx, rfl⟩ := e_ring.surjective x
        obtain ⟨wy, rfl⟩ := e_ring.surjective y
        rw [hψ_symm, hψ_symm] at hxy
        let _ : Algebra ↑(C_K.presheaf.obj (Opposite.op (C_K.basicOpen s))) F := ψ_Ds.toAlgebra
        exact congrArg e_ring ((@IsFractionRing.injective _ _ F _ _ hFrac_Ds) hxy)
      let _ : Algebra ↑(C_K.presheaf.obj (Opposite.op (C_K.basicOpen s'))) F := ψ_Ds'.toAlgebra
      refine
        { map_units := fun y => IsUnit.mk0 (ψ_Ds' y.1) (fun h0 =>
            nonZeroDivisors.ne_zero y.2 (hInj_ψ' (h0.trans ψ_Ds'.map_zero.symm)))
          surj := fun f => ?_
          exists_of_eq := fun {x y} hxy => ⟨1, by simp [hInj_ψ' hxy]⟩ }
      let _ : Algebra ↑(C_K.presheaf.obj (Opposite.op (C_K.basicOpen s))) F := ψ_Ds.toAlgebra
      obtain ⟨⟨w₁, w₂⟩, hf_eq⟩ := @IsLocalization.surj _ _ _ F _ _ hFrac_Ds f
      have hw₂_ne : e_ring w₂.1 ≠ 0 := fun h0 =>
        nonZeroDivisors.ne_zero w₂.2 (e_ring.injective (h0.trans e_ring.map_zero.symm))
      refine ⟨⟨e_ring w₁, ⟨e_ring w₂.1, mem_nonZeroDivisors_of_ne_zero hw₂_ne⟩⟩, ?_⟩
      change f * ψ_Ds' (e_ring w₂.1) = ψ_Ds' (e_ring w₁)
      rw [hψ_symm, hψ_symm]
      exact hf_eq
    have : IsLocalization.Away s' ↑(C_K.presheaf.obj (Opposite.op (C_K.basicOpen s'))) :=
      hDr_aff.isLocalization_basicOpen s'
    let res_Dr_Ds' := C_K.presheaf.map (CategoryTheory.homOfLE (C_K.basicOpen_le s')).op
    let φ_Dr_hom : ↑(C_K.presheaf.obj (Opposite.op (C_K.basicOpen r))) →+* F :=
      ψ_Ds'.comp res_Dr_Ds'.hom
    have hFrac_Dr :
        @IsFractionRing ↑(C_K.presheaf.obj (Opposite.op (C_K.basicOpen r))) _ F _ φ_Dr_hom.toAlgebra :=
      hIsFrac_of_away s' hs'_ne ψ_Ds' φ_Dr_hom
        (fun a => by rw [basicOpen_algebraMap_eq C_K (C_K.basicOpen r) s']; rfl)
        hFrac_Ds'
    have : IsLocalization.Away r ↑(C_K.presheaf.obj (Opposite.op (C_K.basicOpen r))) :=
      hU.isLocalization_basicOpen r
    let res_U_Dr := C_K.presheaf.map (CategoryTheory.homOfLE (C_K.basicOpen_le r)).op
    have hDs_le_U : C_K.basicOpen s ≤ U := hs_le_Dr.trans (C_K.basicOpen_le r)
    let φ_U : C_K.presheaf.obj (Opposite.op U) ⟶ CommRingCat.of F :=
      C_K.presheaf.map (CategoryTheory.homOfLE hDs_le_U).op ≫ CommRingCat.ofHom ψ_Ds
    have hφU_eq : ∀ a : A_U,
        φ_U.hom a = φ_Dr_hom (algebraMap A_U ↑(C_K.presheaf.obj (Opposite.op (C_K.basicOpen r))) a) := by
      intro a
      rw [basicOpen_algebraMap_eq C_K U r]
      have hmap_comp : (res_U_Dr ≫ res_Dr_Ds') ≫ iso_Ds.inv =
          C_K.presheaf.map (CategoryTheory.homOfLE hDs_le_U).op := by
        change (C_K.presheaf.map (CategoryTheory.homOfLE (C_K.basicOpen_le r)).op ≫
            C_K.presheaf.map (CategoryTheory.homOfLE (C_K.basicOpen_le s')).op) ≫
            C_K.presheaf.map (CategoryTheory.homOfLE hDs_eq.ge).op =
          C_K.presheaf.map (CategoryTheory.homOfLE hDs_le_U).op
        rw [← C_K.presheaf.map_comp, ← C_K.presheaf.map_comp]
        rfl
      change (C_K.presheaf.map (CategoryTheory.homOfLE hDs_le_U).op ≫ CommRingCat.ofHom ψ_Ds).hom a =
        (((res_U_Dr ≫ res_Dr_Ds') ≫ iso_Ds.inv) ≫ CommRingCat.ofHom ψ_Ds).hom a
      rw [hmap_comp]
    refine ⟨φ_U, hIsFrac_of_away r hr_ne φ_Dr_hom φ_U.hom hφU_eq hFrac_Dr, ?_⟩
    calc
      AlgebraicGeometry.Spec.map φ_U ≫ hU.fromSpec
        = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_Ds) ≫
            (AlgebraicGeometry.Spec.map
              (C_K.presheaf.map (CategoryTheory.homOfLE hDs_le_U).op) ≫ hU.fromSpec) := by
          simp only [φ_U, AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc]
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_Ds) ≫ hDs_aff.fromSpec := by
          rw [hU.map_fromSpec hDs_aff (CategoryTheory.homOfLE hDs_le_U).op]
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_Ds) ≫
            (AlgebraicGeometry.Spec.map res_VK_Ds ≫ hVK.fromSpec) := by
          rw [← hVK.map_fromSpec hDs_aff (CategoryTheory.homOfLE (C_K.basicOpen_le s)).op]
      _ = AlgebraicGeometry.Spec.map (res_VK_Ds ≫ CommRingCat.ofHom ψ_Ds) ≫ hVK.fromSpec := by
          rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
      _ = AlgebraicGeometry.Spec.map ι_frac ≫ hVK.fromSpec := by
          have hhom : res_VK_Ds ≫ CommRingCat.ofHom ψ_Ds = ι_frac := by
            ext b; exact RingHom.congr_fun hψ_comp_VK b
          rw [hhom]
      _ = η_CK := rfl

  
  have step_essTr : ∀ (K₀ : Type u) [Field K₀]
      (W_K : AlgebraicGeometry.Scheme.{u})
      (q_K : W_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K₀))
      (_ : AlgebraicGeometry.IsIntegral W_K)
      (x₀_K : ↥W_K)
      (U_base : (AlgebraicGeometry.Spec (CommRingCat.of K₀)).Opens)
      (hUb : AlgebraicGeometry.IsAffineOpen U_base)
      (V_K : W_K.Opens) (hVK : AlgebraicGeometry.IsAffineOpen V_K)
      (_ : x₀_K ∈ V_K)
      (e_VK : V_K ≤ (TopologicalSpace.Opens.map q_K.base).obj U_base)
      (_ : RingHom.IsStandardSmoothOfRelativeDimension 1 (q_K.appLE U_base V_K e_VK).hom)
      (F : Type u) [Field F]
      (φ_VK : W_K.presheaf.obj (Opposite.op V_K) ⟶ CommRingCat.of F)
      (_ : @IsFractionRing ↑(W_K.presheaf.obj (Opposite.op V_K)) _ F _ φ_VK.hom.toAlgebra)
      (φ_KF : K₀ →+* F),
      (AlgebraicGeometry.Spec.map φ_VK ≫ hVK.fromSpec) ≫ q_K =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_KF) →
      (letI : Algebra K₀ F := φ_KF.toAlgebra
