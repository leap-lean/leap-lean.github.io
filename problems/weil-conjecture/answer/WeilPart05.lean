            _ = q * (m_1 * π' i'_p) := hπk
            _ = (q * m_1) * π' i'_p := by ring
        have h1_eq : (1 : ↥R) = q * m_1 :=
          mul_right_cancel₀ (hπ_ne (i_Z.succAbove i'_p)) hmul
        have h1_in : (1 : ↥R) ∈ IsLocalRing.maximalIdeal ↥R := by
          rw [h1_eq]
          exact Ideal.mul_mem_left _ q hm1_mR
        exact h1_not_mR h1_in
      have hk_eq_iZ : k = i_Z := by
        rcases hip_cov.2.2 k hiZ_k hk_ip with h1 | h2
        · exact h1
        · exact absurd h2 hk_ne_ip
      have hk_eq_j : k = j := by
        rcases hcov_j.2.2 k hj_k hk_ip with h1 | h2
        · exact h1
        · exact absurd h2 hk_ne_ip
      exact Fin.succAbove_ne i_Z j' (hk_eq_j.symm.trans hk_eq_iZ)
    exact ⟨hCard1, hSnb_eq, hNoChild, hBd_ip, hHasse_iff_A, hSep_A⟩
  · 
    right
    have hCardNe1 : S_nb.ncard ≠ 1 := hCard1
    have hex_ic : ∃ i_c ∈ S_nb, i_c ≠ i_Z.succAbove i'_p := by
      by_contra h_all
      have hsub : S_nb ⊆ {i_Z.succAbove i'_p} := by
        intro j hj
        rw [Set.mem_singleton_iff]
        by_contra hj_ne
        exact h_all ⟨j, hj, hj_ne⟩
      have hle : S_nb.ncard ≤ ({i_Z.succAbove i'_p} : Set (Fin (N' + 1))).ncard :=
        Set.ncard_le_ncard hsub
      rw [Set.ncard_singleton] at hle
      exact hCardNe1 (by omega)
    obtain ⟨i_c_raw, hic_mem, hic_ne_p_raw⟩ := hex_ic
    have hic_cov_raw : IsDiscHasseCover ↥R c π i_Z i_c_raw := by
      rcases hic_mem with h1 | h2
      · exact h1
      · exact absurd (hip_uniq i_c_raw h2) hic_ne_p_raw
    have hic_uniq_raw : ∀ j : Fin (N' + 1), IsDiscHasseCover ↥R c π i_Z j → j = i_c_raw := by
      intro j hj
      by_contra hne
      have hj_ne_p : j ≠ i_Z.succAbove i'_p := fun heq => by
        rw [heq] at hj
        exact hj.1 (h_anti i_Z (i_Z.succAbove i'_p) ⟨hip_cov.2.1, hj.2.1⟩)
      have hsub : ({j, i_c_raw, i_Z.succAbove i'_p} : Set (Fin (N' + 1))) ⊆ S_nb := by
        intro z hz
        simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
        rcases hz with rfl | rfl | rfl
        · exact Or.inl hj
        · exact Or.inl hic_cov_raw
        · exact Or.inr hip_cov
      have hcard3 : ({j, i_c_raw, i_Z.succAbove i'_p} : Set (Fin (N' + 1))).ncard = 3 := by
        have h1 : j ∉ ({i_c_raw, i_Z.succAbove i'_p} : Set (Fin (N' + 1))) := by
          simp [hne, hj_ne_p]
        have h2 : i_c_raw ∉ ({i_Z.succAbove i'_p} : Set (Fin (N' + 1))) := by
          simp [hic_ne_p_raw]
        rw [Set.ncard_insert_of_notMem h1, Set.ncard_insert_of_notMem h2, Set.ncard_singleton]
      have hle : ({j, i_c_raw, i_Z.succAbove i'_p} : Set (Fin (N' + 1))).ncard ≤ S_nb.ncard :=
        Set.ncard_le_ncard hsub
      omega
    obtain ⟨i'_c, hi'_c⟩ := Fin.exists_succAbove_eq hic_cov_raw.1.symm
    have hic_cov : IsDiscHasseCover ↥R c π i_Z (i_Z.succAbove i'_c) := by
      rwa [hi'_c]
    have hic_uniq : ∀ j : Fin (N' + 1), IsDiscHasseCover ↥R c π i_Z j → j = i_Z.succAbove i'_c := by
      intro j hj
      rw [hi'_c]
      exact hic_uniq_raw j hj
    have hic_ne_p : i_Z.succAbove i'_c ≠ i_Z.succAbove i'_p := by
      rwa [hi'_c]
    have hi'_c_ne : i'_c ≠ i'_p :=
      fun h => hic_ne_p (congrArg i_Z.succAbove h)
    have hSnb_eq_B : S_nb = {i_Z.succAbove i'_p, i_Z.succAbove i'_c} := by
      ext j
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff]
      change (IsDiscHasseCover ↥R c π i_Z j ∨ IsDiscHasseCover ↥R c π j i_Z) ↔ _
      constructor
      · rintro (h1 | h2)
        · exact Or.inr (hic_uniq j h1)
        · exact Or.inl (hip_uniq j h2)
      · rintro (rfl | rfl)
        · exact Or.inr hip_cov
        · exact Or.inl hic_cov
    obtain ⟨⟨b', hπ_ic_eq_raw⟩, ⟨δ_c, hc_ic_eq_raw⟩⟩ := hic_cov.2.1
    have hπ_ic_eq : π' i'_c = b' * π i_Z := hπ_ic_eq_raw
    have hc_ic_eq : c' i'_c - c i_Z = δ_c * π i_Z := hc_ic_eq_raw
    obtain ⟨hb'_ne, hb'_mR⟩ :=
      proper_subdisc_factor (Fin.succAbove_ne i_Z i'_c) hπ_ic_eq_raw hc_ic_eq_raw
    have hic_max : ∀ x : Fin (N' + 1),
        IsValDiscLE ↥R (c x) (π x) (c i_Z) (π i_Z) → x ≠ i_Z →
        IsValDiscLE ↥R (c x) (π x) (c' i'_c) (π' i'_c) := by
      intro x hx_le hx_ne
      obtain ⟨u, hx_u, hu_cov⟩ := exists_child_above hx_le hx_ne
      change IsValDiscLE ↥R (c x) (π x) (c (i_Z.succAbove i'_c)) (π (i_Z.succAbove i'_c))
      rwa [← hic_uniq u hu_cov]
    have hCov_pc' : IsDiscHasseCover ↥R c' π' i'_p i'_c := by
      refine ⟨hi'_c_ne.symm, disc_le_trans hic_cov.2.1 hip_cov.2.1, fun k' hic_k hk_ip => ?_⟩
      let k := i_Z.succAbove k'
      have hk_ne_Z : k ≠ i_Z := Fin.succAbove_ne i_Z k'
      rcases disc_le_total_above hic_k hic_cov.2.1 with hk_iZ | hiZ_k
      · rcases hic_cov.2.2 k hic_k hk_iZ with h1 | h2
        · exact Or.inl (Fin.succAbove_right_injective h1)
        · exact absurd h2 hk_ne_Z
      · rcases hip_cov.2.2 k hiZ_k hk_ip with h1 | h2
        · exact absurd h1 hk_ne_Z
        · exact Or.inr (Fin.succAbove_right_injective h2)
    have hBd_pc : IsDiscBoundaryIdx ↥R a_opt (c' i'_p) (π' i'_p) →
        IsDiscBoundaryIdx ↥R a_opt (c' i'_c) (π' i'_c) →
        ∃ a₀ : ↥R, a_opt = some a₀ ∧
          c' i'_p = 0 ∧ π' i'_p = 1 ∧ c' i'_c = 0 ∧ π' i'_c = a₀ := by
      intro hBd_p hBd_c
      have heq_p01 : IsValDiscEq ↥R (c' i'_p) (π' i'_p) 0 1 := by
        rcases hBd_p with h01 | ha0
        · exact h01
        · exact False.elim (hip_not_a0 ha0)
      have hip_top : i_Z.succAbove i'_p = i_top :=
        h_anti (i_Z.succAbove i'_p) i_top
          (disc_eq_trans heq_p01 (by rw [hc_top, hπ_top]; exact disc_eq_refl 0 1))
      have hcip0 : c' i'_p = 0 := by
        change c (i_Z.succAbove i'_p) = 0
        rw [hip_top, hc_top]
      have hπip1 : π' i'_p = 1 := by
        change π (i_Z.succAbove i'_p) = 1
        rw [hip_top, hπ_top]
      rcases hBd_c with heq_c01 | ⟨a₀, ha₀, heq_ca0⟩
      · exfalso
        have hic_top : i_Z.succAbove i'_c = i_top :=
          h_anti (i_Z.succAbove i'_c) i_top
            (disc_eq_trans heq_c01 (by rw [hc_top, hπ_top]; exact disc_eq_refl 0 1))
        exact hic_ne_p (hic_top.trans hip_top.symm)
      · obtain ⟨_, _, ⟨i_bot, hc_bot, hπ_bot⟩, _⟩ := h_bot a₀ ha₀
        have hic_bot : i_Z.succAbove i'_c = i_bot :=
          h_anti (i_Z.succAbove i'_c) i_bot
            (disc_eq_trans heq_ca0 (by rw [hc_bot, hπ_bot]; exact disc_eq_refl 0 a₀))
        have hcic0 : c' i'_c = 0 := by
          change c (i_Z.succAbove i'_c) = 0
          rw [hic_bot, hc_bot]
        have hπica0 : π' i'_c = a₀ := by
          change π (i_Z.succAbove i'_c) = a₀
          rw [hic_bot, hπ_bot]
        exact ⟨a₀, ha₀, hcip0, hπip1, hcic0, hπica0⟩
    have hHasse_iff_B : ∀ x' y' : Fin N',
        IsDiscHasseCover ↥R c π (i_Z.succAbove x') (i_Z.succAbove y') ↔
          (IsDiscHasseCover ↥R c' π' x' y' ∧ (x' ≠ i'_p ∨ y' ≠ i'_c)) := by
      intro x' y'
      constructor
      · intro hcov
        refine ⟨⟨fun h => hcov.1 (congrArg i_Z.succAbove h), hcov.2.1, fun k' hyk hkx => ?_⟩, ?_⟩
        · rcases hcov.2.2 (i_Z.succAbove k') hyk hkx with h1 | h2
          · exact Or.inl (Fin.succAbove_right_injective h1)
          · exact Or.inr (Fin.succAbove_right_injective h2)
        · by_cases hxp : x' = i'_p
          · right
            intro hyc
            rw [hxp, hyc] at hcov
            rcases hcov.2.2 i_Z hic_cov.2.1 hip_cov.2.1 with h1 | h2
            · exact Fin.succAbove_ne i_Z i'_c h1.symm
            · exact Fin.succAbove_ne i_Z i'_p h2.symm
          · exact Or.inl hxp
      · rintro ⟨hcov', hnot_pc⟩
        refine ⟨fun h => hcov'.1 (Fin.succAbove_right_injective h), hcov'.2.1, fun k hyk hkx => ?_⟩
        by_cases hkZ : k = i_Z
        · exfalso
          rw [hkZ] at hyk hkx
          have hy_ic : IsValDiscLE ↥R (c' y') (π' y') (c' i'_c) (π' i'_c) :=
            hic_max (i_Z.succAbove y') hyk (Fin.succAbove_ne i_Z y')
          have hip_x : IsValDiscLE ↥R (c' i'_p) (π' i'_p) (c' x') (π' x') :=
            hip_min (i_Z.succAbove x') hkx (Fin.succAbove_ne i_Z x')
          have hic_x : IsValDiscLE ↥R (c' i'_c) (π' i'_c) (c' x') (π' x') :=
            disc_le_trans hic_cov.2.1 hkx
          have hy_ip : IsValDiscLE ↥R (c' y') (π' y') (c' i'_p) (π' i'_p) :=
            disc_le_trans hyk hip_cov.2.1
          have hy_eq_c : y' = i'_c := by
            rcases hcov'.2.2 i'_c hy_ic hic_x with h1 | h2
            · exact h1.symm
            · exfalso
              rw [← h2] at hkx
              exact Fin.succAbove_ne i_Z i'_c
                (h_anti (i_Z.succAbove i'_c) i_Z ⟨hic_cov.2.1, hkx⟩)
          have hx_eq_p : x' = i'_p := by
            rcases hcov'.2.2 i'_p hy_ip hip_x with h1 | h2
            · exfalso
              rw [← h1] at hyk
              exact Fin.succAbove_ne i_Z i'_p
                (h_anti (i_Z.succAbove i'_p) i_Z ⟨hyk, hip_cov.2.1⟩)
            · exact h2.symm
          rcases hnot_pc with hnp | hnc
          · exact hnp hx_eq_p
          · exact hnc hy_eq_c
        · obtain ⟨k', hk'⟩ := Fin.exists_succAbove_eq hkZ
          rw [← hk'] at hyk hkx ⊢
          rcases hcov'.2.2 k' hyk hkx with h1 | h2
          · exact Or.inl (congrArg i_Z.succAbove h1)
          · exact Or.inr (congrArg i_Z.succAbove h2)
    have hNot_cp : ∀ x' y' : Fin N',
        IsDiscHasseCover ↥R c' π' x' y' → x' = i'_c → y' ≠ i'_p := by
      intro x' y' hcov' hx hy
      have hle_rev : IsValDiscLE ↥R (c' i'_p) (π' i'_p) (c' i'_c) (π' i'_c) := by
        rw [← hx, ← hy]
        exact hcov'.2.1
      exact hic_ne_p (h_anti (i_Z.succAbove i'_c) (i_Z.succAbove i'_p) ⟨hCov_pc'.2.1, hle_rev⟩)
    have hSep_tr : ∀ (x' : Fin N') (c_tilde : ↥R),
        (∀ (j : Fin (N' + 1)),
          IsDiscHasseCover ↥R c π (i_Z.succAbove x') j →
          ∀ r : ↥R, c j - c' x' = r * π' x' →
            r - c_tilde ∉ IsLocalRing.maximalIdeal ↥R) →
        (∀ (j' : Fin N'),
          IsDiscHasseCover ↥R c' π' x' j' →
          ∀ r : ↥R, c' j' - c' x' = r * π' x' →
            r - c_tilde ∉ IsLocalRing.maximalIdeal ↥R) := by
      intro x' c_tilde h_sep_T j' hcov' r hr
      by_cases hxp : x' = i'_p
      · by_cases hjc : j' = i'_c
        · rw [hxp] at h_sep_T hr
          rw [hjc] at hr
          have h_ctZ_sep : c_tilde_Z - c_tilde ∉ IsLocalRing.maximalIdeal ↥R :=
            h_sep_T i_Z hip_cov c_tilde_Z hc_iZ_eq
          have h_mul_eq : (c_tilde_Z + δ_c * π_tilde) * π' i'_p = r * π' i'_p := by
            calc
              (c_tilde_Z + δ_c * π_tilde) * π' i'_p
                = c_tilde_Z * π' i'_p + δ_c * (π_tilde * π' i'_p) := by ring
              _ = (c i_Z - c' i'_p) + (c' i'_c - c i_Z) := by
                  rw [← hc_iZ_eq, ← hπ_iZ_eq, ← hc_ic_eq]
              _ = c' i'_c - c' i'_p := by ring
              _ = r * π' i'_p := hr
          have hr_eq : c_tilde_Z + δ_c * π_tilde = r :=
            mul_right_cancel₀ (hπ_ne (i_Z.succAbove i'_p)) h_mul_eq
          intro h_in
          have h_prod_in : δ_c * π_tilde ∈ IsLocalRing.maximalIdeal ↥R :=
            Ideal.mul_mem_left _ δ_c hπtilde_mR
          have h_sub_in : (r - c_tilde) - δ_c * π_tilde ∈ IsLocalRing.maximalIdeal ↥R :=
            Ideal.sub_mem _ h_in h_prod_in
          have h_eq_diff : (r - c_tilde) - δ_c * π_tilde = c_tilde_Z - c_tilde := by
            rw [← hr_eq]; ring
          rw [h_eq_diff] at h_sub_in
          exact h_ctZ_sep h_sub_in
        · exact h_sep_T (i_Z.succAbove j')
            ((hHasse_iff_B x' j').mpr ⟨hcov', Or.inr hjc⟩) r hr
      · exact h_sep_T (i_Z.succAbove j')
          ((hHasse_iff_B x' j').mpr ⟨hcov', Or.inl hxp⟩) r hr
    exact ⟨hCardNe1, i'_c, b', δ_c, hi'_c_ne, hic_cov, hic_uniq, hSnb_eq_B,
      hπ_ic_eq, hc_ic_eq, hb'_ne, hb'_mR, hCov_pc', hBd_pc, hHasse_iff_B, hNot_cp, hSep_tr⟩

theorem weil_open_chart_blowup_gluing_and_contraction_model (K : Type u) [Field K] (R : ValuationSubring K)
    (M_0 M' U_bl : AlgebraicGeometry.Scheme.{u})
    (g_M0 : M_0 ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
    (m_0 : ↥M_0)
    (F_0 : Type u) [Field F_0]
    (η_M0 : AlgebraicGeometry.Spec (CommRingCat.of F_0) ⟶ M_0)
    (φ_KF0 : K →+* F_0)
    (hηM0_g : η_M0 ≫ g_M0 = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_KF0.comp R.subtype)))
    (g'_M : M' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
    (f'_M : M' ⟶ M_0)
    (η'_M : AlgebraicGeometry.Spec (CommRingCat.of F_0) ⟶ M')
    (Z_M' : Set ↥M_0) (hZM'_cl : IsClosed Z_M')
    (hSS_M' : IsStrictlySemistableCurveOverValuation R g'_M)
    (hProp_f' : AlgebraicGeometry.IsProper f'_M)
    (hf'_g : f'_M ≫ g_M0 = g'_M)
    (hη'_f' : η'_M ≫ f'_M = η_M0)
    (hIso_f' : CategoryTheory.IsIso (f'_M ∣_ (⟨Z_M'ᶜ, hZM'_cl.isOpen_compl⟩ : M_0.Opens)))
    (isLeaf : Prop)
    (B : Type u) [CommRing B]
    (g_B : AlgebraicGeometry.Spec (CommRingCat.of B) ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
    (ι_ctr : AlgebraicGeometry.Spec (CommRingCat.of B) ⟶ M')
    (hOpen_ctr : AlgebraicGeometry.IsOpenImmersion ι_ctr)
    (hι_g : ι_ctr ≫ g'_M = g_B)
    (hSm_B : isLeaf → AlgebraicGeometry.SmoothOfRelativeDimension 1 g_B)
    (Q₀_R : PrimeSpectrum ↥R) (hQ₀_ne : Q₀_R.asIdeal ≠ ⊥)
    (g_Ubl : U_bl ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
    (p_bl : U_bl ⟶ AlgebraicGeometry.Spec (CommRingCat.of B))
    (σ_loc : AlgebraicGeometry.Spec (CommRingCat.of (↥R ⧸ Q₀_R.asIdeal)) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of B))
    (τ₀_loc τ₁_loc : AlgebraicGeometry.Spec (CommRingCat.of (↥R ⧸ Q₀_R.asIdeal)) ⟶ U_bl)
    (q_gen q_max : AlgebraicGeometry.Spec (CommRingCat.of (↥R ⧸ Q₀_R.asIdeal)))
    (hInt_Ubl : AlgebraicGeometry.IsIntegral U_bl)
    (hp_g : p_bl ≫ g_B = g_Ubl)
    (hProp_p : AlgebraicGeometry.IsProper p_bl)
    (hFlat_Ubl : AlgebraicGeometry.Flat g_Ubl)
    (hLfp_Ubl : AlgebraicGeometry.LocallyOfFinitePresentation g_Ubl)
    (hCharts_Ubl : ∀ y : ↥U_bl,
      (∃ (W : U_bl.Opens)
          (e : W.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial ↥R))),
        y ∈ W ∧ AlgebraicGeometry.Etale e ∧
        W.ι ≫ g_Ubl = e ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C)) ∨
      (∃ (W : U_bl.Opens) (a : ↥R)
          (e : W.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of
            (MvPolynomial (Fin 2) ↥R ⧸ Ideal.span
              {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}))),
        y ∈ W ∧ a ≠ 0 ∧ AlgebraicGeometry.Etale e ∧
        W.ι ≫ g_Ubl = e ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C))))
    (hσ_g : σ_loc ≫ g_B =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk Q₀_R.asIdeal)))
    (hτ₀_p : τ₀_loc ≫ p_bl = σ_loc)
    (hτ₁_p : τ₁_loc ≫ p_bl = σ_loc)
    (hτ_disj : Disjoint (Set.range τ₀_loc.base) (Set.range τ₁_loc.base))
    (hIso_p : ∃ hCl : IsClosed (Set.range σ_loc.base),
      CategoryTheory.IsIso
        (p_bl ∣_ (⟨(Set.range σ_loc.base)ᶜ, hCl.isOpen_compl⟩ :
          (AlgebraicGeometry.Spec (CommRingCat.of B)).Opens)))
    (hq_gen_R : g_B.base (σ_loc.base q_gen) = Q₀_R)
    (hGen_irr : IsIrreducible (p_bl.base ⁻¹' {σ_loc.base q_gen}))
    (hMod_pre : p_bl.base ⁻¹' (Set.range σ_loc.base) =
      closure (p_bl.base ⁻¹' {σ_loc.base q_gen}))
    (hq_max_R : (g_B.base (σ_loc.base q_max)).asIdeal = IsLocalRing.maximalIdeal ↥R)
    (hEloc_irr : IsIrreducible (p_bl.base ⁻¹' {σ_loc.base q_max}))
    (hz_m0 : f'_M.base ((σ_loc ≫ ι_ctr).base q_max) = m_0) :
    let σ_Mod := σ_loc ≫ ι_ctr
    let Mod_qM : Set ↥M' := Set.range σ_Mod.base
    let z_new_M : ↥M' := σ_Mod.base q_max
    let z₀_M : ↥M' := σ_Mod.base q_gen
    ∃ (hMod_cl : IsClosed Mod_qM)
      (M_tilde : AlgebraicGeometry.Scheme.{u})
      (j_1 : U_bl ⟶ M_tilde)
      (j_2 : AlgebraicGeometry.Scheme.Opens.toScheme
        (⟨Mod_qMᶜ, hMod_cl.isOpen_compl⟩ : M'.Opens) ⟶ M_tilde)
      (q_M : M_tilde ⟶ M')
      (η_tilde : AlgebraicGeometry.Spec (CommRingCat.of F_0) ⟶ M_tilde),
      let U_compl : M'.Opens := ⟨Mod_qMᶜ, hMod_cl.isOpen_compl⟩
      let E_Z_M : Set ↥M_tilde := j_1.base '' (p_bl.base ⁻¹' {σ_loc.base q_max})
      AlgebraicGeometry.IsOpenImmersion j_1 ∧
      AlgebraicGeometry.IsOpenImmersion j_2 ∧
      Set.range j_1.base ∪ Set.range j_2.base = Set.univ ∧
      j_1 ≫ q_M = p_bl ≫ ι_ctr ∧
      j_2 ≫ q_M = AlgebraicGeometry.Scheme.Opens.ι U_compl ∧
      q_M.base ⁻¹' Mod_qMᶜ = Set.range j_2.base ∧
      j_1.base ⁻¹' (q_M.base ⁻¹' Mod_qM) = p_bl.base ⁻¹' (Set.range σ_loc.base) ∧
      Mod_qM ∩ {x : ↥M' | (g'_M.base x).asIdeal = IsLocalRing.maximalIdeal ↥R} = {z_new_M} ∧
      IsClosed ({z_new_M} : Set ↥M') ∧
      IsClosed E_Z_M ∧
      IsIrreducible E_Z_M ∧
      E_Z_M ⊆ {y : ↥M_tilde | ((q_M ≫ g'_M).base y).asIdeal = IsLocalRing.maximalIdeal ↥R} ∧
      η_tilde ≫ q_M = η'_M ∧
      (∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of F_0)),
        (η_tilde ≫ q_M).base pt ∉ Mod_qM) ∧
      (∀ (W_aff : AlgebraicGeometry.Scheme.{u})
         (ι_aff : W_aff ⟶ U_bl)
         (ξ : AlgebraicGeometry.Spec (CommRingCat.of F_0) ⟶ W_aff),
        AlgebraicGeometry.IsOpenImmersion ι_aff →
