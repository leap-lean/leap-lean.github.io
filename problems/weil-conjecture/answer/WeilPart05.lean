        exact h_abs (↥R ⧸ Q.asIdeal) (Ideal.Quotient.mk Q.asIdeal) ι_bar₀
          (fun _ => Ideal.Quotient.eq_zero_iff_mem) (fun _ => rfl)
      obtain ⟨i₀, hi₀⟩ := h_coord
      let x₀ : ↑R_nod_obj := mk_nod (MvPolynomial.X i₀)
      let u₀ : B₁ := ψ_nod x₀
      have hu₀_not : u₀ ∉ p₁.asIdeal := hi₀
      let U_w : Y.Opens := Y.basicOpen u₀
      have hUw : AlgebraicGeometry.IsAffineOpen U_w := hU₁.basicOpen u₀
      have hw : w ∈ U_w := by
        have hp₁_mem : p₁ ∈ (TopologicalSpace.Opens.map hU₁.fromSpec.base).obj U_w := by
          rw [hU₁.fromSpec_preimage_basicOpen u₀]
          exact hu₀_not
        change hU₁.fromSpec.base p₁ ∈ U_w at hp₁_mem
        rwa [hpU_pt U₁ hU₁ hw₁] at hp₁_mem
      let B_w : Type u := ↑(Y.presheaf.obj (Opposite.op U_w))
      let res_hom : Y.presheaf.obj (Opposite.op U₁) ⟶ Y.presheaf.obj (Opposite.op U_w) :=
        Y.presheaf.map (CategoryTheory.homOfLE (Y.basicOpen_le u₀)).op
      let res_w : B₁ →+* B_w := res_hom.hom
      let _ : Algebra B₁ B_w := res_w.toAlgebra
      have : IsLocalization.Away u₀ B_w := hU₁.isLocalization_basicOpen u₀
      
      let L_X := Localization.Away (Polynomial.X : Polynomial ↥R)
      let L_x₀ := Localization.Away x₀
      let f₀ : Polynomial ↥R →+* L_x₀ :=
        Polynomial.eval₂RingHom ((algebraMap (↑R_nod_obj) L_x₀).comp (mk_nod.comp MvPolynomial.C))
          (algebraMap (↑R_nod_obj) L_x₀ x₀)
      have hf₀_X_unit : IsUnit (f₀ Polynomial.X) := by
        simpa [f₀] using IsLocalization.Away.algebraMap_isUnit x₀
      let f_laur : L_X →+* L_x₀ := IsLocalization.Away.lift Polynomial.X hf₀_X_unit
      have hf_laur_alg : ∀ P : Polynomial ↥R, f_laur (algebraMap (Polynomial ↥R) L_X P) = f₀ P :=
        fun P => IsLocalization.Away.lift_eq Polynomial.X hf₀_X_unit P
      let t_X : L_X := algebraMap (Polynomial ↥R) L_X Polynomial.X
      let t_X_inv : L_X := IsLocalization.Away.invSelf (S := L_X) (Polynomial.X : Polynomial ↥R)
      have htX_mul : t_X * t_X_inv = 1 :=
        IsLocalization.Away.mul_invSelf (S := L_X) (Polynomial.X : Polynomial ↥R)
      let g_mv : MvPolynomial (Fin 2) ↥R →+* L_X :=
        MvPolynomial.eval₂Hom ((algebraMap (Polynomial ↥R) L_X).comp Polynomial.C)
          (fun j : Fin 2 =>
            if j = i₀ then t_X
            else algebraMap (Polynomial ↥R) L_X (Polynomial.C a) * t_X_inv)
      have hg_mv_rel : ∀ f ∈ I_a, g_mv f = 0 := by
        intro f hf
        have hle : I_a ≤ RingHom.ker g_mv := by
          rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
          simp only [g_mv, map_sub, map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C,
            RingHom.coe_comp, Function.comp_apply]
          fin_cases i₀ <;> simp only [Fin.zero_eta, Fin.mk_one, Fin.isValue, ↓reduceIte,
            Fin.reduceEq, sub_eq_zero]
          · calc t_X * (algebraMap (Polynomial ↥R) L_X (Polynomial.C a) * t_X_inv)
                = algebraMap (Polynomial ↥R) L_X (Polynomial.C a) * (t_X * t_X_inv) := by ring
              _ = algebraMap (Polynomial ↥R) L_X (Polynomial.C a) := by rw [htX_mul, mul_one]
          · calc (algebraMap (Polynomial ↥R) L_X (Polynomial.C a) * t_X_inv) * t_X
                = algebraMap (Polynomial ↥R) L_X (Polynomial.C a) * (t_X * t_X_inv) := by ring
              _ = algebraMap (Polynomial ↥R) L_X (Polynomial.C a) := by rw [htX_mul, mul_one]
        exact hle hf
      let g₀ : ↑R_nod_obj →+* L_X := Ideal.Quotient.lift I_a g_mv hg_mv_rel
      have hg₀_x₀_unit : IsUnit (g₀ x₀) := by
        change IsUnit (g_mv (MvPolynomial.X i₀))
        simp only [g_mv, MvPolynomial.eval₂Hom_X', ↓reduceIte, t_X]
        exact IsLocalization.Away.algebraMap_isUnit Polynomial.X
      let g_laur : L_x₀ →+* L_X := IsLocalization.Away.lift x₀ hg₀_x₀_unit
      have hg_laur_alg : ∀ z : ↑R_nod_obj, g_laur (algebraMap (↑R_nod_obj) L_x₀ z) = g₀ z :=
        fun z => IsLocalization.Away.lift_eq x₀ hg₀_x₀_unit z
      have hf_inv : f_laur t_X_inv = IsLocalization.Away.invSelf (S := L_x₀) x₀ := by
        have h1 : algebraMap (↑R_nod_obj) L_x₀ x₀ * f_laur t_X_inv = 1 := by
          have hfx : f_laur t_X = algebraMap (↑R_nod_obj) L_x₀ x₀ := by
            simpa [t_X, f₀] using hf_laur_alg Polynomial.X
          rw [← hfx, ← map_mul, htX_mul, map_one]
        have h2 : IsLocalization.Away.invSelf (S := L_x₀) x₀ * algebraMap (↑R_nod_obj) L_x₀ x₀ = 1 := by
          rw [mul_comm]
          exact IsLocalization.Away.mul_invSelf (S := L_x₀) x₀
        calc f_laur t_X_inv
            = (IsLocalization.Away.invSelf (S := L_x₀) x₀ * algebraMap (↑R_nod_obj) L_x₀ x₀) *
                f_laur t_X_inv := by rw [h2, one_mul]
          _ = IsLocalization.Away.invSelf (S := L_x₀) x₀ *
                (algebraMap (↑R_nod_obj) L_x₀ x₀ * f_laur t_X_inv) := by ring
          _ = IsLocalization.Away.invSelf (S := L_x₀) x₀ := by rw [h1, mul_one]
      have h_gf : g_laur.comp f_laur = RingHom.id L_X := by
        refine IsLocalization.ringHom_ext (Submonoid.powers (Polynomial.X : Polynomial ↥R)) ?_
        apply Polynomial.ringHom_ext'
        · ext c
          simp only [RingHom.coe_comp, Function.comp_apply, RingHom.id_apply, hf_laur_alg, f₀,
            Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C, hg_laur_alg]
          change g_mv (MvPolynomial.C c) = algebraMap (Polynomial ↥R) L_X (Polynomial.C c)
          simp [g_mv]
        · simp only [RingHom.coe_comp, Function.comp_apply, RingHom.id_apply, hf_laur_alg, f₀,
            Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X, hg_laur_alg]
          change g_mv (MvPolynomial.X i₀) = t_X
          simp [g_mv]
      have h_fg : f_laur.comp g_laur = RingHom.id L_x₀ := by
        refine IsLocalization.ringHom_ext (Submonoid.powers x₀) ?_
        apply RingHom.ext
        intro z
        obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective z
        revert f
        suffices (((f_laur.comp g_laur).comp (algebraMap (↑R_nod_obj) L_x₀)).comp mk_nod) =
            (algebraMap (↑R_nod_obj) L_x₀).comp mk_nod by
          intro f; exact RingHom.congr_fun this f
        apply MvPolynomial.ringHom_ext'
        · ext c
          simp only [RingHom.coe_comp, Function.comp_apply, hg_laur_alg]
          change f_laur (g_mv (MvPolynomial.C c)) = algebraMap (↑R_nod_obj) L_x₀ (mk_nod (MvPolynomial.C c))
          simp [g_mv, hf_laur_alg, f₀]
        · intro j
          simp only [RingHom.coe_comp, Function.comp_apply, hg_laur_alg]
          change f_laur (g_mv (MvPolynomial.X j)) = algebraMap (↑R_nod_obj) L_x₀ (mk_nod (MvPolynomial.X j))
          simp only [g_mv, MvPolynomial.eval₂Hom_X']
          split_ifs with hj
          · subst hj
            simpa [t_X, f₀] using hf_laur_alg Polynomial.X
          · rw [map_mul, hf_laur_alg, hf_inv]
            simp only [f₀, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C, RingHom.coe_comp,
              Function.comp_apply]
            have hprod : x₀ * mk_nod (MvPolynomial.X j) = mk_nod (MvPolynomial.C a) := by
              dsimp [x₀]
              fin_cases i₀ <;> fin_cases j <;> simp at hj ⊢
              · exact hmk_rel
              · rw [mul_comm]; exact hmk_rel
            rw [← hprod, map_mul]
            calc (algebraMap (↑R_nod_obj) L_x₀ x₀ *
                  algebraMap (↑R_nod_obj) L_x₀ (mk_nod (MvPolynomial.X j))) *
                  IsLocalization.Away.invSelf (S := L_x₀) x₀
                = algebraMap (↑R_nod_obj) L_x₀ (mk_nod (MvPolynomial.X j)) *
                  (algebraMap (↑R_nod_obj) L_x₀ x₀ *
                    IsLocalization.Away.invSelf (S := L_x₀) x₀) := by ring
              _ = algebraMap (↑R_nod_obj) L_x₀ (mk_nod (MvPolynomial.X j)) := by
                rw [IsLocalization.Away.mul_invSelf, mul_one]
      let e_laur : L_X ≃+* L_x₀ :=
        { f_laur with
          invFun := g_laur
          left_inv := fun x => RingHom.congr_fun h_gf x
          right_inv := fun y => RingHom.congr_fun h_fg y }
      let ψ_loc : L_x₀ →+* B_w := IsLocalization.Away.map L_x₀ B_w ψ_nod x₀
      have hEt_loc : ψ_loc.Etale :=
        RingHom.Etale.propertyIsLocal.localizationAwayPreserves ψ_nod x₀ L_x₀ B_w hEt_ψ
      have : Algebra.Etale (Polynomial ↥R) L_X := Algebra.Etale.of_isLocalizationAway Polynomial.X
      have hEt_1 : (algebraMap (Polynomial ↥R) L_X).Etale :=
        RingHom.etale_algebraMap.mpr inferInstance
      have hEt_2 : e_laur.toRingHom.Etale := RingHom.Etale.of_bijective e_laur.bijective
      let α₀ : Polynomial ↥R →+* B_w :=
        ψ_loc.comp (e_laur.toRingHom.comp (algebraMap (Polynomial ↥R) L_X))
      have hEt_α₀ : α₀.Etale :=
        RingHom.Etale.stableUnderComposition _ _
          (RingHom.Etale.stableUnderComposition _ _ hEt_1 hEt_2) hEt_loc
      have hα₀_C : α₀.comp Polynomial.C = res_w.comp (ψ_nod.comp (mk_nod.comp MvPolynomial.C)) := by
        ext c
        simp only [α₀, RingHom.coe_comp, Function.comp_apply]
        change ψ_loc (f_laur (algebraMap (Polynomial ↥R) L_X (Polynomial.C c))) =
          res_w (ψ_nod (mk_nod (MvPolynomial.C c)))
        rw [hf_laur_alg]
        simp only [f₀, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C, RingHom.coe_comp,
          Function.comp_apply, ψ_loc, IsLocalization.Away.map, IsLocalization.map_eq]
        rfl
      have hfrom_res : AlgebraicGeometry.Spec.map res_hom ≫ hU₁.fromSpec = hUw.fromSpec :=
        hU₁.map_fromSpec hUw (CategoryTheory.homOfLE (Y.basicOpen_le u₀)).op
      have hComm_w : hUw.fromSpec ≫ g_Y =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (α₀.comp Polynomial.C)) := by
        rw [hα₀_C, ← hfrom_res, CategoryTheory.Category.assoc, hComm₁,
          ← AlgebraicGeometry.Spec.map_comp]
        rfl
      exact ⟨U_w, hUw, hw, α₀, hEt_α₀, h_pin_QT U_w hUw hw α₀ hEt_α₀ hComm_w⟩

  obtain ⟨U_w, hUw, hw, α₀, hEt_α₀, hp_coeff⟩ := h_s1
  have hUw_ne : Nonempty ↥U_w := ⟨⟨w, hw⟩⟩
  let B : Type u := ↑(Y.presheaf.obj (Opposite.op U_w))
  obtain ⟨hDom_B, hIC_B⟩ := hNorm_Y U_w hUw hUw_ne
  have : IsDomain B := hDom_B
  have : IsIntegrallyClosed B := hIC_B
  obtain ⟨φ_w, hFrac, hη_eq⟩ := hFunc_Y U_w hUw hUw_ne
  let φ : B →+* F := φ_w.hom
  let p : Ideal B := (hUw.isoSpec.hom.base ⟨w, hw⟩).asIdeal
  have hp_prime : p.IsPrime := (hUw.isoSpec.hom.base ⟨w, hw⟩).isPrime
  let Q : Ideal ↥R := (g_Y.base w).asIdeal
  have hQ_prime : Q.IsPrime := (g_Y.base w).isPrime

  
  
  
  have h_s2 : ∃ (F₀ : Subfield F) (V_Q : ValuationSubring ↥F₀),
      (∀ x : F, @IsAlgebraic ↥F₀ F _ _ F₀.toAlgebra x) ∧
      (∀ z : ↥V_Q, ∃ b s : B, s ∉ p ∧ φ s * F₀.subtype z.1 = φ b) ∧
      (∀ z : ↥V_Q, z ∈ IsLocalRing.maximalIdeal ↥V_Q →
        ∃ b s : B, b ∈ p ∧ s ∉ p ∧ φ s * F₀.subtype z.1 = φ b) := by
    let A₀ := Polynomial ↥R
    let _ : Algebra A₀ B := α₀.toAlgebra
    have : Algebra.Etale A₀ B := hEt_α₀
    have : Module.Flat A₀ B := Algebra.Smooth.flat A₀ B
    have : Algebra.HasGoingDown A₀ B := Algebra.HasGoingDown.of_flat
    have hα₀_inj : Function.Injective α₀ := by
      rw [RingHom.injective_iff_ker_eq_bot]
      by_contra hne
      have hlt : (⊥ : Ideal A₀) < (⊥ : Ideal B).under A₀ := bot_lt_iff_ne_bot.mpr hne
      obtain ⟨P', hP'_lt, _, _⟩ := Ideal.exists_ideal_lt_liesOver_of_lt (⊥ : Ideal B) hlt
      exact not_lt_bot hP'_lt
    let _ : Algebra B F := φ.toAlgebra
    have : IsFractionRing B F := hFrac
    have hφ_inj : Function.Injective φ := IsFractionRing.injective B F
    let ψ₀ : A₀ →+* F := φ.comp α₀
    have hψ₀_inj : Function.Injective ψ₀ := hφ_inj.comp hα₀_inj
    let _ : Algebra A₀ F := ψ₀.toAlgebra
    have : IsScalarTower A₀ B F := IsScalarTower.of_algebraMap_eq' rfl
    let L₀ := (⊥ : Ideal A₀).ResidueField
    let ι₀ : L₀ →+* F := IsFractionRing.lift hψ₀_inj
    let F₀ : Subfield F := ι₀.fieldRange
    let j_L₀ : L₀ →+* ↥F₀ := ι₀.rangeRestrictField
    have hj_L₀_bij : Function.Bijective j_L₀ :=
      ⟨fun x y h => ι₀.injective (congrArg Subtype.val h),
       fun ⟨_, x, hx⟩ => ⟨x, Subtype.ext hx⟩⟩
    let e₀ : L₀ ≃+* ↥F₀ := RingEquiv.ofBijective j_L₀ hj_L₀_bij
    let _ : Algebra L₀ F := ι₀.toAlgebra
    let _ : Algebra L₀ ↥F₀ := j_L₀.toAlgebra
    have : IsScalarTower A₀ L₀ F :=
      IsScalarTower.of_algebraMap_eq fun a => (IsFractionRing.lift_algebraMap hψ₀_inj a).symm
    have : IsScalarTower L₀ ↥F₀ F := IsScalarTower.of_algebraMap_eq fun _ => rfl
    
    have hAlg : ∀ x : F, @IsAlgebraic ↥F₀ F _ _ F₀.toAlgebra x := by
      have : Module.Finite L₀ ((⊥ : Ideal A₀).Fiber B) :=
        Algebra.QuasiFinite.finite_fiber (⊥ : Ideal A₀)
      let φ_alg : B →ₐ[A₀] F := IsScalarTower.toAlgHom A₀ B F
      let ι_L₀_A₀ : L₀ →ₐ[A₀] F :=
        { ι₀ with commutes' := fun a => IsFractionRing.lift_algebraMap hψ₀_inj a }
      let Ψ₀ : TensorProduct A₀ L₀ B →ₐ[A₀] F :=
        Algebra.TensorProduct.productMap ι_L₀_A₀ φ_alg
      let Ψ : (⊥ : Ideal A₀).Fiber B →ₐ[L₀] F :=
        { Ψ₀.toRingHom with
          commutes' := fun c => by
            change Ψ₀ (c ⊗ₜ[A₀] (1 : B)) = ι₀ c
            simp [Ψ₀, ι_L₀_A₀] }
      have : Module.Finite L₀ ↥Ψ.range := Module.Finite.range Ψ.toLinearMap
      have : Algebra.IsIntegral L₀ ↥Ψ.range := Algebra.IsIntegral.of_finite L₀ ↥Ψ.range
      have hInt_B : ∀ b : B, IsIntegral ↥F₀ (φ b) := by
        intro b
        let y : ↥Ψ.range := ⟨φ b, ⟨1 ⊗ₜ[A₀] b, by
          change Ψ₀ (1 ⊗ₜ[A₀] b) = φ b
          simp [Ψ₀, ι_L₀_A₀, φ_alg]
          rfl⟩⟩
        have hL₀ : IsIntegral L₀ (φ b) :=
          IsIntegral.map Ψ.range.val (Algebra.IsIntegral.isIntegral y)
        exact IsIntegral.tower_top hL₀
      intro x
      obtain ⟨⟨b, s⟩, hx⟩ := IsLocalization.surj (nonZeroDivisors B) x
      have hs0 : (s : B) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s.2
      have hφs0 : φ s ≠ 0 := fun h => hs0 (hφ_inj (h.trans (map_zero φ).symm))
      have hx_eq : x = φ b * (φ s)⁻¹ := by
        have hx' : x * φ s = φ b := hx
        calc x = (x * φ s) * (φ s)⁻¹ := by rw [mul_assoc, mul_inv_cancel₀ hφs0, mul_one]
          _ = φ b * (φ s)⁻¹ := by rw [hx']
      rw [hx_eq, isAlgebraic_iff_isIntegral]
      have hs_alg : IsAlgebraic ↥F₀ (φ s) := isAlgebraic_iff_isIntegral.mpr (hInt_B s)
      have hsinv_int : IsIntegral ↥F₀ (φ s)⁻¹ := isAlgebraic_iff_isIntegral.mp hs_alg.inv
      exact IsIntegral.mul (hInt_B b) hsinv_int
    
    let j₀ : A₀ →+* ↥F₀ := j_L₀.comp (algebraMap A₀ L₀)
    have hj₀_sub : ∀ P : A₀, F₀.subtype (j₀ P) = φ (α₀ P) := by
      intro P
      change ι₀ (algebraMap A₀ L₀ P) = ψ₀ P
      exact IsFractionRing.lift_algebraMap hψ₀_inj P
    have hj₀_inj : Function.Injective j₀ := fun P₁ P₂ h =>
      hψ₀_inj (by
        change φ (α₀ P₁) = φ (α₀ P₂)
        rw [← hj₀_sub P₁, ← hj₀_sub P₂, h])
    have hj₀_surj : ∀ z : ↥F₀, ∃ P S : A₀, S ≠ 0 ∧ j₀ S * z = j₀ P := by
      intro z
      obtain ⟨w, rfl⟩ := e₀.surjective z
      obtain ⟨⟨P, S⟩, hw⟩ := IsLocalization.surj (nonZeroDivisors A₀) w
      have hS0 : (S : A₀) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp S.2
      refine ⟨P, S, hS0, ?_⟩
      have hw' : e₀ (w * algebraMap A₀ L₀ S) = e₀ (algebraMap A₀ L₀ P) := congrArg e₀ hw
      rw [map_mul, mul_comm] at hw'
      exact hw'
    let q_Q : Ideal A₀ := Ideal.comap α₀ p
    have hqQ_prime : q_Q.IsPrime := Ideal.IsPrime.comap α₀
    have hqQ_coeff : ∀ P : A₀, P ∈ q_Q ↔ ∀ n : ℕ, P.coeff n ∈ Q := hp_coeff
    let V_sub : Subring ↥F₀ :=
      { carrier := {z : ↥F₀ | ∃ P S : A₀, S ∉ q_Q ∧ j₀ S * z = j₀ P}
        mul_mem' := by
          rintro z₁ z₂ ⟨P₁, S₁, hS₁, h₁⟩ ⟨P₂, S₂, hS₂, h₂⟩
          refine ⟨P₁ * P₂, S₁ * S₂, hqQ_prime.mul_notMem hS₁ hS₂, ?_⟩
          rw [map_mul, map_mul]
          calc (j₀ S₁ * j₀ S₂) * (z₁ * z₂) = (j₀ S₁ * z₁) * (j₀ S₂ * z₂) := by ring
            _ = j₀ P₁ * j₀ P₂ := by rw [h₁, h₂]
        one_mem' := ⟨1, 1, hqQ_prime.one_notMem, by simp⟩
        add_mem' := by
          rintro z₁ z₂ ⟨P₁, S₁, hS₁, h₁⟩ ⟨P₂, S₂, hS₂, h₂⟩
          refine ⟨P₁ * S₂ + P₂ * S₁, S₁ * S₂, hqQ_prime.mul_notMem hS₁ hS₂, ?_⟩
          rw [map_mul, map_add, map_mul, map_mul]
          calc (j₀ S₁ * j₀ S₂) * (z₁ + z₂)
              = (j₀ S₁ * z₁) * j₀ S₂ + (j₀ S₂ * z₂) * j₀ S₁ := by ring
            _ = j₀ P₁ * j₀ S₂ + j₀ P₂ * j₀ S₁ := by rw [h₁, h₂]
        zero_mem' := ⟨0, 1, hqQ_prime.one_notMem, by simp⟩
        neg_mem' := by
          rintro z₁ ⟨P₁, S₁, hS₁, h₁⟩
          refine ⟨-P₁, S₁, hS₁, ?_⟩
          rw [map_neg, mul_neg, h₁] }
    have r_dvd_total : ∀ x y : ↥R, (∃ r : ↥R, x = y * r) ∨ (∃ r : ↥R, y = x * r) := by
      intro x y
      by_cases hy : y = 0
      · right; exact ⟨0, by rw [hy, mul_zero]⟩
      · have hy0 : (y : K) ≠ 0 := fun h => hy (Subtype.ext h)
        rcases ValuationSubring.mem_or_inv_mem R ((x : K) / (y : K)) with hxy | hyx
        · left
          refine ⟨⟨(x : K) / (y : K), hxy⟩, Subtype.ext ?_⟩
          change (x : K) = (y : K) * ((x : K) / (y : K))
          rw [mul_comm, div_mul_cancel₀ _ hy0]
        · by_cases hx : x = 0
          · left; exact ⟨0, by rw [hx, mul_zero]⟩
          · have hx0 : (x : K) ≠ 0 := fun h => hx (Subtype.ext h)
            right
            refine ⟨⟨((x : K) / (y : K))⁻¹, hyx⟩, Subtype.ext ?_⟩
            change (y : K) = (x : K) * ((x : K) / (y : K))⁻¹
            rw [inv_div, mul_comm, div_mul_cancel₀ _ hx0]
    have h_fin_min : ∀ (D : Finset ↥R), D.Nonempty →
        ∃ c₀ ∈ D, ∀ c ∈ D, ∃ r : ↥R, c = c₀ * r := by
      intro D hD
      induction hD using Finset.Nonempty.cons_induction with
      | singleton a =>
        exact ⟨a, Finset.mem_singleton_self a, fun c hc =>
          ⟨1, by rw [Finset.mem_singleton.mp hc, mul_one]⟩⟩
      | cons a s ha hs ih =>
        obtain ⟨c₁, hc₁_in, hc₁_div⟩ := ih
        rcases r_dvd_total a c₁ with ⟨r₀, hr₀⟩ | ⟨r₀, hr₀⟩
        · refine ⟨c₁, Finset.mem_cons_of_mem hc₁_in, fun c hc => ?_⟩
          rcases Finset.mem_cons.mp hc with hca | hcs
          · rw [hca]; exact ⟨r₀, hr₀⟩
          · exact hc₁_div c hcs
        · refine ⟨a, Finset.mem_cons_self a s, fun c hc => ?_⟩
          rcases Finset.mem_cons.mp hc with hca | hcs
          · rw [hca]; exact ⟨1, (mul_one a).symm⟩
          · obtain ⟨r₁, hr₁⟩ := hc₁_div c hcs
            exact ⟨r₀ * r₁, by rw [hr₁, hr₀, mul_assoc]⟩
    have h_tot : ∀ z : ↥F₀, z ∈ V_sub ∨ z⁻¹ ∈ V_sub := by
      intro z
      by_cases hz : z = 0
      · left; rw [hz]; exact V_sub.zero_mem
      · obtain ⟨P, S, hS0, hEq⟩ := hj₀_surj z
        have hjS0 : j₀ S ≠ 0 := fun h => hS0 (hj₀_inj (h.trans (map_zero j₀).symm))
        have hP0 : P ≠ 0 := by
          intro h0
          rw [h0, map_zero] at hEq
          exact mul_ne_zero hjS0 hz hEq
        let C : Finset ↥R := (P.support.image P.coeff) ∪ (S.support.image S.coeff)
        have hC_ne : C.Nonempty :=
          Finset.Nonempty.mono Finset.subset_union_left
            ((Polynomial.support_nonempty.mpr hP0).image P.coeff)
        obtain ⟨c₀, hc₀_in, hc₀_div⟩ := h_fin_min C hC_ne
        have hc₀_ne : c₀ ≠ 0 := by
          simp only [C, Finset.mem_union, Finset.mem_image, Polynomial.mem_support_iff] at hc₀_in
          rcases hc₀_in with ⟨n, hn, rfl⟩ | ⟨m, hm, rfl⟩ <;> assumption
        have hP_div : ∀ n : ℕ, ∃ r : ↥R, P.coeff n = c₀ * r := by
          intro n
          by_cases hn : n ∈ P.support
          · exact hc₀_div (P.coeff n) (Finset.mem_union_left _ (Finset.mem_image_of_mem _ hn))
          · rw [Polynomial.notMem_support_iff.mp hn]
            exact ⟨0, (mul_zero c₀).symm⟩
        have hS_div : ∀ m : ℕ, ∃ r : ↥R, S.coeff m = c₀ * r := by
          intro m
          by_cases hm : m ∈ S.support
          · exact hc₀_div (S.coeff m) (Finset.mem_union_right _ (Finset.mem_image_of_mem _ hm))
          · rw [Polynomial.notMem_support_iff.mp hm]
            exact ⟨0, (mul_zero c₀).symm⟩
        choose fP hfP using hP_div
        choose fS hfS using hS_div
        let P₁ : A₀ := ∑ n ∈ Finset.range (P.natDegree + 1), Polynomial.C (fP n) * Polynomial.X ^ n
        let S₁ : A₀ := ∑ m ∈ Finset.range (S.natDegree + 1), Polynomial.C (fS m) * Polynomial.X ^ m
        have hP_eq : P = Polynomial.C c₀ * P₁ := by
          dsimp [P₁]
          rw [Finset.mul_sum]
          conv_lhs => rw [Polynomial.as_sum_range P]
          refine Finset.sum_congr rfl fun n _ => ?_
          rw [← Polynomial.C_mul_X_pow_eq_monomial, ← mul_assoc, ← Polynomial.C_mul, ← hfP n]
        have hS_eq : S = Polynomial.C c₀ * S₁ := by
          dsimp [S₁]
          rw [Finset.mul_sum]
          conv_lhs => rw [Polynomial.as_sum_range S]
          refine Finset.sum_congr rfl fun m _ => ?_
          rw [← Polynomial.C_mul_X_pow_eq_monomial, ← mul_assoc, ← Polynomial.C_mul, ← hfS m]
        have hjc₀_ne : j₀ (Polynomial.C c₀) ≠ 0 := by
          intro h
          have hc_eq : Polynomial.C c₀ = 0 := hj₀_inj (h.trans (map_zero j₀).symm)
          exact hc₀_ne (Polynomial.C_eq_zero.mp hc_eq)
        have hEq₁ : j₀ S₁ * z = j₀ P₁ := by
          apply mul_left_cancel₀ hjc₀_ne
          calc j₀ (Polynomial.C c₀) * (j₀ S₁ * z)
              = (j₀ (Polynomial.C c₀) * j₀ S₁) * z := by ring
            _ = j₀ S * z := by rw [← map_mul, ← hS_eq]
            _ = j₀ P := hEq
            _ = j₀ (Polynomial.C c₀) * j₀ P₁ := by rw [hP_eq, map_mul]
        simp only [C, Finset.mem_union, Finset.mem_image] at hc₀_in
        rcases hc₀_in with ⟨n₀, _, hn₀⟩ | ⟨m₀, _, hm₀⟩
        · right
          have hP₁_one : P₁.coeff n₀ = 1 := by
            apply mul_left_cancel₀ hc₀_ne
            rw [mul_one, ← Polynomial.coeff_C_mul, ← hP_eq, hn₀]
          have hP₁_not : P₁ ∉ q_Q := by
            rw [hqQ_coeff]
            intro hall
            have h1 : (1 : ↥R) ∈ Q := hP₁_one ▸ hall n₀
            exact hQ_prime.one_notMem h1
          refine ⟨S₁, P₁, hP₁_not, ?_⟩
          calc j₀ P₁ * z⁻¹ = (j₀ S₁ * z) * z⁻¹ := by rw [hEq₁]
            _ = j₀ S₁ * (z * z⁻¹) := by ring
            _ = j₀ S₁ := by rw [mul_inv_cancel₀ hz, mul_one]
        · left
          have hS₁_one : S₁.coeff m₀ = 1 := by
            apply mul_left_cancel₀ hc₀_ne
            rw [mul_one, ← Polynomial.coeff_C_mul, ← hS_eq, hm₀]
          have hS₁_not : S₁ ∉ q_Q := by
            rw [hqQ_coeff]
            intro hall
            have h1 : (1 : ↥R) ∈ Q := hS₁_one ▸ hall m₀
            exact hQ_prime.one_notMem h1
          exact ⟨P₁, S₁, hS₁_not, hEq₁⟩
    let V_Q : ValuationSubring ↥F₀ := ValuationSubring.ofSubring V_sub h_tot
    refine ⟨F₀, V_Q, hAlg, ?_, ?_⟩
    · intro z
      obtain ⟨P, S, hS_not, hEq⟩ := (ValuationSubring.mem_ofSubring V_sub h_tot z.1).mp z.2
      refine ⟨α₀ P, α₀ S, hS_not, ?_⟩
      have hsub := congrArg F₀.subtype hEq
      rwa [map_mul, hj₀_sub, hj₀_sub] at hsub
    · intro z hz_max
      obtain ⟨P, S, hS_not, hEq⟩ := (ValuationSubring.mem_ofSubring V_sub h_tot z.1).mp z.2
      have hP_in : P ∈ q_Q := by
        by_contra hP_not
        have hP0 : P ≠ 0 := fun h0 => hP_not (h0 ▸ q_Q.zero_mem)
        have hjP0 : j₀ P ≠ 0 := fun h => hP0 (hj₀_inj (h.trans (map_zero j₀).symm))
        have hz0 : z.1 ≠ 0 := by
          intro h0
          rw [h0, mul_zero] at hEq
          exact hjP0 hEq.symm
        have hinv_sub : (z.1)⁻¹ ∈ V_sub :=
          ⟨S, P, hP_not, by
            calc j₀ P * (z.1)⁻¹ = (j₀ S * z.1) * (z.1)⁻¹ := by rw [hEq]
              _ = j₀ S * (z.1 * (z.1)⁻¹) := by ring
              _ = j₀ S := by rw [mul_inv_cancel₀ hz0, mul_one]⟩
        have hinv_VQ : (z.1)⁻¹ ∈ V_Q :=
          (ValuationSubring.mem_ofSubring V_sub h_tot (z.1)⁻¹).mpr hinv_sub
        have hu : IsUnit z :=
          mk_isUnit z ⟨(z.1)⁻¹, hinv_VQ⟩ (Subtype.ext (mul_inv_cancel₀ hz0))
        exact (IsLocalRing.mem_maximalIdeal z).mp hz_max hu
      refine ⟨α₀ P, α₀ S, hP_in, hS_not, ?_⟩
      have hsub := congrArg F₀.subtype hEq
      rwa [map_mul, hj₀_sub, hj₀_sub] at hsub

  obtain ⟨F₀, V_Q, hAlg, hVQ_mem, hVQ_max⟩ := h_s2

  
  
  
  have h_s3 : ∃ (W_w : ValuationSubring F),
      (∀ x : F, x ∈ W_w ↔ ∃ b s : B, s ∉ p ∧ φ s * x = φ b) ∧
      (∀ b : B, ∃ hb : φ b ∈ W_w,
        (⟨φ b, hb⟩ : ↥W_w) ∈ IsLocalRing.maximalIdeal ↥W_w ↔ b ∈ p) := by
    let _ : Algebra B F := φ.toAlgebra
    have : IsFractionRing B F := hFrac
    have hφ_inj : Function.Injective φ := IsFractionRing.injective B F
    let R_loc : Subring F :=
      { carrier := {x : F | ∃ b s : B, s ∉ p ∧ φ s * x = φ b}
        mul_mem' := by
          rintro x₁ x₂ ⟨b₁, s₁, hs₁, h₁⟩ ⟨b₂, s₂, hs₂, h₂⟩
          refine ⟨b₁ * b₂, s₁ * s₂, hp_prime.mul_notMem hs₁ hs₂, ?_⟩
          rw [map_mul, map_mul]
          calc (φ s₁ * φ s₂) * (x₁ * x₂) = (φ s₁ * x₁) * (φ s₂ * x₂) := by ring
            _ = φ b₁ * φ b₂ := by rw [h₁, h₂]
        one_mem' := ⟨1, 1, hp_prime.one_notMem, by simp⟩
        add_mem' := by
          rintro x₁ x₂ ⟨b₁, s₁, hs₁, h₁⟩ ⟨b₂, s₂, hs₂, h₂⟩
          refine ⟨b₁ * s₂ + b₂ * s₁, s₁ * s₂, hp_prime.mul_notMem hs₁ hs₂, ?_⟩
          rw [map_mul, map_add, map_mul, map_mul]
          calc (φ s₁ * φ s₂) * (x₁ + x₂)
              = (φ s₁ * x₁) * φ s₂ + (φ s₂ * x₂) * φ s₁ := by ring
            _ = φ b₁ * φ s₂ + φ b₂ * φ s₁ := by rw [h₁, h₂]
        zero_mem' := ⟨0, 1, hp_prime.one_notMem, by simp⟩
        neg_mem' := by
          rintro x₁ ⟨b₁, s₁, hs₁, h₁⟩
          refine ⟨-b₁, s₁, hs₁, ?_⟩
          rw [map_neg, mul_neg, h₁] }
    have hRloc_unit : ∀ (r : ↥R_loc) (b s : B),
        s ∉ p → φ s * r.1 = φ b → (IsUnit r ↔ b ∉ p) := by
      intro r b s hs hEq
      constructor
      · intro hu hb_in
        obtain ⟨u, hru⟩ := hu.exists_right_inv
        obtain ⟨b', s', hs', huEq⟩ := u.2
        have hru1 : r.1 * u.1 = 1 := congrArg Subtype.val hru
        have hbb : φ (b * b') = φ (s * s') := by
          rw [map_mul, map_mul, ← hEq, ← huEq]
          calc (φ s * r.1) * (φ s' * u.1) = (φ s * φ s') * (r.1 * u.1) := by ring
            _ = φ s * φ s' := by rw [hru1, mul_one]
        have h_eq : b * b' = s * s' := hφ_inj hbb
        exact hp_prime.mul_notMem hs hs' (h_eq ▸ Ideal.mul_mem_right b' p hb_in)
      · intro hb_not
        have hb0 : b ≠ 0 := fun h0 => hb_not (h0 ▸ p.zero_mem)
        have hφb0 : φ b ≠ 0 := fun h => hb0 (hφ_inj (h.trans (map_zero φ).symm))
        have hy_mem : (φ b)⁻¹ * φ s ∈ R_loc :=
          ⟨s, b, hb_not, by rw [← mul_assoc, mul_inv_cancel₀ hφb0, one_mul]⟩
        refine mk_isUnit r ⟨(φ b)⁻¹ * φ s, hy_mem⟩ (Subtype.ext ?_)
        change r.1 * ((φ b)⁻¹ * φ s) = 1
        calc r.1 * ((φ b)⁻¹ * φ s) = (φ s * r.1) * (φ b)⁻¹ := by ring
          _ = φ b * (φ b)⁻¹ := by rw [hEq]
          _ = 1 := mul_inv_cancel₀ hφb0
    have : IsLocalRing ↥R_loc := by
      refine IsLocalRing.of_nonunits_add ?_
      intro r₁ r₂ hr₁ hr₂
      obtain ⟨b₁, s₁, hs₁, h₁⟩ := r₁.2
      obtain ⟨b₂, s₂, hs₂, h₂⟩ := r₂.2
      have hb₁ : b₁ ∈ p := by_contra fun h => hr₁ ((hRloc_unit r₁ b₁ s₁ hs₁ h₁).mpr h)
      have hb₂ : b₂ ∈ p := by_contra fun h => hr₂ ((hRloc_unit r₂ b₂ s₂ hs₂ h₂).mpr h)
      have hsum_eq : φ (s₁ * s₂) * (r₁ + r₂).1 = φ (b₁ * s₂ + b₂ * s₁) := by
        change φ (s₁ * s₂) * (r₁.1 + r₂.1) = φ (b₁ * s₂ + b₂ * s₁)
        rw [map_mul, map_add, map_mul, map_mul]
        calc (φ s₁ * φ s₂) * (r₁.1 + r₂.1)
            = (φ s₁ * r₁.1) * φ s₂ + (φ s₂ * r₂.1) * φ s₁ := by ring
          _ = φ b₁ * φ s₂ + φ b₂ * φ s₁ := by rw [h₁, h₂]
      have hbsum : b₁ * s₂ + b₂ * s₁ ∈ p :=
        Ideal.add_mem p (Ideal.mul_mem_right s₂ p hb₁) (Ideal.mul_mem_right s₁ p hb₂)
      intro hu
      exact ((hRloc_unit (r₁ + r₂) (b₁ * s₂ + b₂ * s₁) (s₁ * s₂)
        (hp_prime.mul_notMem hs₁ hs₂) hsum_eq).mp hu) hbsum
    
    let φ_loc : B →+* ↥R_loc :=
      { toFun := fun b => ⟨φ b, ⟨b, 1, hp_prime.one_notMem, by simp⟩⟩
        map_one' := Subtype.ext (map_one φ)
        map_mul' := fun x y => Subtype.ext (map_mul φ x y)
        map_zero' := Subtype.ext (map_zero φ)
        map_add' := fun x y => Subtype.ext (map_add φ x y) }
    let _ : Algebra B ↥R_loc := φ_loc.toAlgebra
    have : IsLocalization p.primeCompl ↥R_loc :=
      { map_units := fun ⟨s, hs⟩ =>
          (hRloc_unit (φ_loc s) s 1 hp_prime.one_notMem (by simp [φ_loc])).mpr hs
        surj := fun r => by
          obtain ⟨b, s, hs, hEq⟩ := r.2
          refine ⟨(b, ⟨s, hs⟩), Subtype.ext ?_⟩
          change r.1 * φ s = φ b
          exact (mul_comm r.1 (φ s)).trans hEq
        exists_of_eq := fun {b₁ b₂} h =>
          ⟨⟨1, hp_prime.one_notMem⟩, by
            change (1 : B) * b₁ = 1 * b₂
            rw [one_mul, one_mul]
            exact hφ_inj (congrArg Subtype.val h)⟩ }
    have hp_nzd : p.primeCompl ≤ nonZeroDivisors B := fun s hs =>
      mem_nonZeroDivisors_iff_ne_zero.mpr fun h0 => hs (h0 ▸ p.zero_mem)
    have : IsIntegrallyClosed ↥R_loc :=
      isIntegrallyClosed_of_isLocalization ↥R_loc p.primeCompl hp_nzd
    have : IsFractionRing ↥R_loc F :=
      { map_units := fun ⟨r, hr⟩ => by
          have hr0 : r ≠ 0 := nonZeroDivisors.ne_zero hr
          exact Ne.isUnit fun h => hr0 (Subtype.ext h)
        surj := fun z => by
          obtain ⟨⟨b, s⟩, hz⟩ := IsLocalization.surj (nonZeroDivisors B) z
          have hs0 : (s : B) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s.2
          have hφs_ne : φ_loc s ≠ 0 := fun h =>
            hs0 (hφ_inj ((congrArg Subtype.val h).trans (map_zero φ).symm))
          refine ⟨(φ_loc b, ⟨φ_loc s, mem_nonZeroDivisors_iff_ne_zero.mpr hφs_ne⟩), hz⟩
        exists_of_eq := fun {r₁ r₂} h => ⟨1, by
          change (1 : ↥R_loc) * r₁ = 1 * r₂
          rw [one_mul, one_mul]
          exact Subtype.ext h⟩ }
    have : IsIntegrallyClosedIn ↥R_loc F := by
      rw [Subring.isIntegrallyClosedIn_iff]
      intro z hz
      obtain ⟨r, hr⟩ := (IsIntegrallyClosed.isIntegral_iff (x := z)).mp hz
      change r.1 = z at hr
      rw [← hr]
      exact r.2
    
    obtain ⟨W₀, hR_W₀, hLoc_W₀⟩ := IsLocalRing.exists_factor_valuationRing R_loc.subtype
    let g_loc : ↥R_loc →+* ↥W₀ := R_loc.subtype.codRestrict W₀.toSubring hR_W₀
    have : IsLocalHom g_loc := hLoc_W₀
    have hmW₀_prime : (IsLocalRing.maximalIdeal ↥W₀).IsPrime :=
      (IsLocalRing.maximalIdeal.isMaximal ↥W₀).isPrime
    have hVQ_Rloc : ∀ z : ↥V_Q, F₀.subtype z.1 ∈ R_loc := hVQ_mem
    have hVQ_W₀_max : ∀ z : ↥V_Q, z ∈ IsLocalRing.maximalIdeal ↥V_Q →
        (⟨F₀.subtype z.1, hR_W₀ ⟨F₀.subtype z.1, hVQ_Rloc z⟩⟩ : ↥W₀) ∈
          IsLocalRing.maximalIdeal ↥W₀ := by
      intro z hz
      obtain ⟨b, s, hb_in, hs_not, hEq⟩ := hVQ_max z hz
      let r_z : ↥R_loc := ⟨F₀.subtype z.1, hVQ_Rloc z⟩
      have hr_nonunit : ¬ IsUnit r_z := fun hu =>
        (hRloc_unit r_z b s hs_not hEq).mp hu hb_in
      have hg_nonunit : ¬ IsUnit (g_loc r_z) := fun hu =>
        hr_nonunit ((isUnit_map_iff g_loc r_z).mp hu)
      exact (IsLocalRing.mem_maximalIdeal (g_loc r_z)).mpr hg_nonunit
    
    have hW₀_le_Rloc : ∀ x : F, x ∈ W₀ → x ∈ R_loc := by
      intro x hx_W₀
      by_cases hx0 : x = 0
      · rw [hx0]; exact R_loc.zero_mem
      · obtain ⟨P, hP_ne, hP_eval⟩ := hAlg x
        have hP_eval' : Polynomial.eval₂ F₀.subtype x P = 0 := hP_eval
        let n := P.natDegree
        have h_min_ex : ∀ (D : Finset ℕ), D.Nonempty → (∀ k ∈ D, P.coeff k ≠ 0) →
            ∃ m ∈ D, ∀ i ∈ D, P.coeff i * (P.coeff m)⁻¹ ∈ V_Q := by
          intro D hD
          induction hD using Finset.Nonempty.cons_induction with
          | singleton a =>
            intro ha0
            refine ⟨a, Finset.mem_singleton_self a, fun i hi => ?_⟩
            rw [Finset.mem_singleton.mp hi, mul_inv_cancel₀ (ha0 a (Finset.mem_singleton_self a))]
            exact V_Q.one_mem
          | cons a s ha hs ih =>
            intro hne_all
            obtain ⟨m₀, hm₀_in, hm₀_min⟩ :=
              ih (fun k hk => hne_all k (Finset.mem_cons_of_mem hk))
            have ha_ne : P.coeff a ≠ 0 := hne_all a (Finset.mem_cons_self a s)
            have hm₀_ne : P.coeff m₀ ≠ 0 := hne_all m₀ (Finset.mem_cons_of_mem hm₀_in)
            rcases ValuationSubring.mem_or_inv_mem V_Q (P.coeff a * (P.coeff m₀)⁻¹) with ham | hma
            · refine ⟨m₀, Finset.mem_cons_of_mem hm₀_in, fun i hi => ?_⟩
              rcases Finset.mem_cons.mp hi with rfl | his
              · exact ham
              · exact hm₀_min i his
            · have hma' : P.coeff m₀ * (P.coeff a)⁻¹ ∈ V_Q := by
                have heq : (P.coeff a * (P.coeff m₀)⁻¹)⁻¹ = P.coeff m₀ * (P.coeff a)⁻¹ := by
                  rw [mul_inv_rev, inv_inv]
                rwa [← heq]
              refine ⟨a, Finset.mem_cons_self a s, fun i hi => ?_⟩
              rcases Finset.mem_cons.mp hi with rfl | his
              · rw [mul_inv_cancel₀ ha_ne]; exact V_Q.one_mem
              · have him := hm₀_min i his
                have hprod : (P.coeff i * (P.coeff m₀)⁻¹) * (P.coeff m₀ * (P.coeff a)⁻¹) =
                    P.coeff i * (P.coeff a)⁻¹ := by
                  calc (P.coeff i * (P.coeff m₀)⁻¹) * (P.coeff m₀ * (P.coeff a)⁻¹)
                      = P.coeff i * ((P.coeff m₀)⁻¹ * P.coeff m₀) * (P.coeff a)⁻¹ := by ring
                    _ = P.coeff i * (P.coeff a)⁻¹ := by rw [inv_mul_cancel₀ hm₀_ne, mul_one]
                rw [← hprod]
                exact V_Q.toSubring.mul_mem him hma'
        let M_min : Finset ℕ :=
          P.support.filter (fun m => ∀ i ∈ P.support, P.coeff i * (P.coeff m)⁻¹ ∈ V_Q)
        have hM_ne : M_min.Nonempty := by
          obtain ⟨m₀, hm₀_supp, hm₀_all⟩ := h_min_ex P.support
            (Polynomial.support_nonempty.mpr hP_ne) (fun k hk => Polynomial.mem_support_iff.mp hk)
          exact ⟨m₀, Finset.mem_filter.mpr ⟨hm₀_supp, hm₀_all⟩⟩
        let m : ℕ := M_min.max' hM_ne
        have hm_mem : m ∈ M_min := Finset.max'_mem M_min hM_ne
        have hm_supp : m ∈ P.support := (Finset.mem_filter.mp hm_mem).1
        have hm_all : ∀ i ∈ P.support, P.coeff i * (P.coeff m)⁻¹ ∈ V_Q :=
          (Finset.mem_filter.mp hm_mem).2
        have hPm_ne : P.coeff m ≠ 0 := Polynomial.mem_support_iff.mp hm_supp
        have hm_le_n : m ≤ n := Polynomial.le_natDegree_of_ne_zero hPm_ne
        let c : ℕ → ↥F₀ := fun i => P.coeff i * (P.coeff m)⁻¹
        have hc_VQ : ∀ i : ℕ, c i ∈ V_Q := by
          intro i
          by_cases hi : i ∈ P.support
          · exact hm_all i hi
          · dsimp [c]
            rw [Polynomial.notMem_support_iff.mp hi, zero_mul]
            exact V_Q.zero_mem
        have hcm_one : c m = 1 := mul_inv_cancel₀ hPm_ne
        have hc_gt_max : ∀ j : ℕ, m < j →
            (⟨c j, hc_VQ j⟩ : ↥V_Q) ∈ IsLocalRing.maximalIdeal ↥V_Q := by
          intro j hj_gt
          by_contra hj_not
          have hj_unit : IsUnit (⟨c j, hc_VQ j⟩ : ↥V_Q) :=
            IsLocalRing.notMem_maximalIdeal.mp hj_not
          obtain ⟨u, hju⟩ := hj_unit.exists_right_inv
          have hju_val : c j * u.1 = 1 := congrArg Subtype.val hju
          have hcj_ne : c j ≠ 0 := by
            intro h0
            rw [h0, zero_mul] at hju_val
            exact zero_ne_one hju_val
          have hPj_ne : P.coeff j ≠ 0 := fun h0 => hcj_ne (by simp [c, h0])
          have hj_supp : j ∈ P.support := Polynomial.mem_support_iff.mpr hPj_ne
          have hu_eq : u.1 = P.coeff m * (P.coeff j)⁻¹ := by
            apply mul_left_cancel₀ hcj_ne
            rw [hju_val]
            symm
            dsimp [c]
            calc (P.coeff j * (P.coeff m)⁻¹) * (P.coeff m * (P.coeff j)⁻¹)
                = (P.coeff j * (P.coeff j)⁻¹) * ((P.coeff m)⁻¹ * P.coeff m) := by ring
              _ = 1 := by rw [mul_inv_cancel₀ hPj_ne, inv_mul_cancel₀ hPm_ne, mul_one]
          have hmj_VQ : P.coeff m * (P.coeff j)⁻¹ ∈ V_Q := hu_eq ▸ u.2
          have hj_Mmin : j ∈ M_min := by
            refine Finset.mem_filter.mpr ⟨hj_supp, fun i hi => ?_⟩
            have him := hm_all i hi
            have hprod : (P.coeff i * (P.coeff m)⁻¹) * (P.coeff m * (P.coeff j)⁻¹) =
                P.coeff i * (P.coeff j)⁻¹ := by
              calc (P.coeff i * (P.coeff m)⁻¹) * (P.coeff m * (P.coeff j)⁻¹)
                  = P.coeff i * ((P.coeff m)⁻¹ * P.coeff m) * (P.coeff j)⁻¹ := by ring
                _ = P.coeff i * (P.coeff j)⁻¹ := by rw [inv_mul_cancel₀ hPm_ne, mul_one]
            rw [← hprod]
            exact V_Q.toSubring.mul_mem him hmj_VQ
          exact not_le_of_gt hj_gt (Finset.le_max' M_min j hj_Mmin)
        let d : ℕ → F := fun i => F₀.subtype (c i)
        have hd_Rloc : ∀ i : ℕ, d i ∈ R_loc := fun i => hVQ_Rloc ⟨c i, hc_VQ i⟩
        have hd_W₀ : ∀ i : ℕ, d i ∈ W₀ := fun i => hR_W₀ ⟨d i, hd_Rloc i⟩
        have hdm_one : d m = 1 := by simp [d, hcm_one]
        let s_sep : F := ∑ j ∈ Finset.Icc m n, d j * x ^ (j - m)
        have hs_W₀ : s_sep ∈ W₀ :=
          W₀.toSubring.sum_mem fun j _ =>
            W₀.toSubring.mul_mem (hd_W₀ j) (W₀.toSubring.pow_mem hx_W₀ (j - m))
        
        have hs_sub_one_max :
            (⟨s_sep, hs_W₀⟩ : ↥W₀) - 1 ∈ IsLocalRing.maximalIdeal ↥W₀ := by
          have hIcc_ins : Finset.Icc m n = insert m (Finset.Ioc m n) := by
            ext j; simp only [Finset.mem_Icc, Finset.mem_insert, Finset.mem_Ioc]; omega
          have hm_not_Ioc : m ∉ Finset.Ioc m n := by simp
          have hs_split : (⟨s_sep, hs_W₀⟩ : ↥W₀) - 1 =
              ∑ j ∈ Finset.Ioc m n, (⟨d j, hd_W₀ j⟩ : ↥W₀) * (⟨x, hx_W₀⟩ : ↥W₀) ^ (j - m) := by
            apply Subtype.ext
            push_cast
            dsimp [s_sep]
            rw [hIcc_ins, Finset.sum_insert hm_not_Ioc]
            simp [hdm_one]
          rw [hs_split]
          refine Ideal.sum_mem _ fun j hj => ?_
          have hj_gt : m < j := (Finset.mem_Ioc.mp hj).1
          exact Ideal.mul_mem_right _ _ (hVQ_W₀_max ⟨c j, hc_VQ j⟩ (hc_gt_max j hj_gt))
        have hs_not_max : (⟨s_sep, hs_W₀⟩ : ↥W₀) ∉ IsLocalRing.maximalIdeal ↥W₀ := by
          intro hs_in
          have h1 : (1 : ↥W₀) ∈ IsLocalRing.maximalIdeal ↥W₀ := by
            have h_id : (1 : ↥W₀) = ⟨s_sep, hs_W₀⟩ - (⟨s_sep, hs_W₀⟩ - 1) := by ring
            rw [h_id]
            exact Ideal.sub_mem _ hs_in hs_sub_one_max
          exact hmW₀_prime.one_notMem h1
        have hs_ne : s_sep ≠ 0 := by
          intro h0
          apply hs_not_max
          have heq : (⟨s_sep, hs_W₀⟩ : ↥W₀) = 0 := Subtype.ext h0
          rw [heq]
          exact (IsLocalRing.maximalIdeal ↥W₀).zero_mem
        
        have h_sum_zero : (∑ k ∈ Finset.range (n + 1), d k * x ^ k) = 0 := by
          have hev : (∑ k ∈ Finset.range (n + 1), F₀.subtype (P.coeff k) * x ^ k) = 0 := by
            rwa [Polynomial.eval₂_eq_sum_range] at hP_eval'
          have hmul : (∑ k ∈ Finset.range (n + 1), F₀.subtype (P.coeff k) * x ^ k) *
              F₀.subtype (P.coeff m)⁻¹ = 0 := by
            rw [hev, zero_mul]
          rw [Finset.sum_mul] at hmul
          convert hmul using 2 with k _
          dsimp [d, c]
          ring
        have h_union : Finset.range m ∪ Finset.Icc m n = Finset.range (n + 1) := by
          ext k; simp only [Finset.mem_union, Finset.mem_range, Finset.mem_Icc]; omega
        have h_disj : Disjoint (Finset.range m) (Finset.Icc m n) := by
          rw [Finset.disjoint_left]
          intro k hk₁ hk₂
          simp only [Finset.mem_range, Finset.mem_Icc] at hk₁ hk₂
          omega
        have h_high : (∑ j ∈ Finset.Icc m n, d j * x ^ j) = s_sep * x ^ m := by
          dsimp [s_sep]
          rw [Finset.sum_mul]
          refine Finset.sum_congr rfl fun j hj => ?_
          have hj_ge : m ≤ j := (Finset.mem_Icc.mp hj).1
          have hx_pow : x ^ j = x ^ (j - m) * x ^ m := by
            rw [← pow_add, Nat.sub_add_cancel hj_ge]
          rw [hx_pow]
          ring
        have h_fund : (∑ i ∈ Finset.range m, d i * x ^ i) + s_sep * x ^ m = 0 := by
          rw [← h_high, ← Finset.sum_union h_disj, h_union]
          exact h_sum_zero
        have hm_pos : 1 ≤ m := by
          by_contra hm0
          have hm_eq : m = 0 := by omega
          rw [hm_eq, Finset.range_zero, Finset.sum_empty, zero_add, pow_zero, mul_one] at h_fund
          exact hs_ne h_fund
        have h_dual : s_sep = - ∑ i ∈ Finset.range m, d i * (x⁻¹) ^ (m - i) := by
          have hxm_ne : x ^ m ≠ 0 := pow_ne_zero m hx0
          have hmul : ((∑ i ∈ Finset.range m, d i * x ^ i) + s_sep * x ^ m) * (x⁻¹) ^ m = 0 := by
            rw [h_fund, zero_mul]
          rw [add_mul, Finset.sum_mul] at hmul
          have h_term2 : s_sep * x ^ m * (x⁻¹) ^ m = s_sep := by
            rw [mul_assoc, inv_pow, mul_inv_cancel₀ hxm_ne, mul_one]
          have h_term1 : (∑ i ∈ Finset.range m, d i * x ^ i * (x⁻¹) ^ m) =
              ∑ i ∈ Finset.range m, d i * (x⁻¹) ^ (m - i) := by
            refine Finset.sum_congr rfl fun i hi => ?_
            have hi_lt : i < m := Finset.mem_range.mp hi
            have hexp : m = i + (m - i) := (Nat.add_sub_cancel' (le_of_lt hi_lt)).symm
            have hx_pow : x ^ i * (x⁻¹) ^ m = (x⁻¹) ^ (m - i) := by
              conv_lhs => rw [hexp, pow_add]
              rw [← mul_assoc, inv_pow, mul_inv_cancel₀ (pow_ne_zero i hx0), one_mul]
            rw [mul_assoc, hx_pow]
          rw [h_term1, h_term2] at hmul
          exact eq_neg_of_add_eq_zero_right hmul
        
        have hs_Rloc : s_sep ∈ R_loc := by
          by_contra hs_not
          obtain ⟨V', hR_V', hs_not_V'⟩ :=
            Subring.exists_le_valuationSubring_of_isIntegrallyClosedIn hs_not
          have hd_V' : ∀ k : ℕ, d k ∈ V' := fun k => hR_V' (hd_Rloc k)
          rcases ValuationSubring.mem_or_inv_mem V' x with hx_V' | hxinv_V'
          · apply hs_not_V'
            exact V'.toSubring.sum_mem fun j _ =>
              V'.toSubring.mul_mem (hd_V' j) (V'.toSubring.pow_mem hx_V' (j - m))
          · apply hs_not_V'
            rw [h_dual]
            exact V'.toSubring.neg_mem (V'.toSubring.sum_mem fun i _ =>
              V'.toSubring.mul_mem (hd_V' i) (V'.toSubring.pow_mem hxinv_V' (m - i)))
        
        let r_sep : ↥R_loc := ⟨s_sep, hs_Rloc⟩
        have hg_sep_eq : g_loc r_sep = ⟨s_sep, hs_W₀⟩ := Subtype.ext rfl
        have hg_sep_unit : IsUnit (g_loc r_sep) :=
          IsLocalRing.notMem_maximalIdeal.mp (hg_sep_eq.symm ▸ hs_not_max)
        have hr_sep_unit : IsUnit r_sep := (isUnit_map_iff g_loc r_sep).mp hg_sep_unit
        obtain ⟨u_sep, hru_sep⟩ := hr_sep_unit.exists_right_inv
        have hru_val : s_sep * u_sep.1 = 1 := congrArg Subtype.val hru_sep
        let Q_low : Polynomial ↥R_loc :=
          ∑ i ∈ Finset.range m, Polynomial.C (u_sep * ⟨d i, hd_Rloc i⟩) * Polynomial.X ^ i
        have hQ_deg : Q_low.degree < (m : WithBot ℕ) := by
          rw [Polynomial.degree_lt_iff_coeff_zero]
          intro k hk
          dsimp [Q_low]
          rw [Polynomial.finsetSum_coeff]
          refine Finset.sum_eq_zero fun i hi => ?_
          have hi_lt : i < m := Finset.mem_range.mp hi
          have hki : k ≠ i := by omega
          rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow]
          simp [hki]
        let Q_mon : Polynomial ↥R_loc := Polynomial.X ^ m + Q_low
        have hQ_monic : Q_mon.Monic := Polynomial.monic_X_pow_add hQ_deg
        have hQ_eval : Polynomial.eval₂ R_loc.subtype x Q_mon = 0 := by
          dsimp [Q_mon, Q_low]
          rw [Polynomial.eval₂_add, Polynomial.eval₂_X_pow, Polynomial.eval₂_finsetSum]
          have h_low_eval : (∑ i ∈ Finset.range m,
              Polynomial.eval₂ R_loc.subtype x
                (Polynomial.C (u_sep * ⟨d i, hd_Rloc i⟩) * Polynomial.X ^ i)) =
              u_sep.1 * (∑ i ∈ Finset.range m, d i * x ^ i) := by
            rw [Finset.mul_sum]
            refine Finset.sum_congr rfl fun i _ => ?_
            simp only [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X_pow]
            change (u_sep.1 * d i) * x ^ i = u_sep.1 * (d i * x ^ i)
            ring
          rw [h_low_eval]
          have h_sum_low : (∑ i ∈ Finset.range m, d i * x ^ i) = -(s_sep * x ^ m) :=
            eq_neg_of_add_eq_zero_left h_fund
          rw [h_sum_low]
          calc x ^ m + u_sep.1 * -(s_sep * x ^ m)
              = x ^ m - (s_sep * u_sep.1) * x ^ m := by ring
            _ = 0 := by rw [hru_val, one_mul, sub_self]
        have hx_int : IsIntegral ↥R_loc x := ⟨Q_mon, hQ_monic, hQ_eval⟩
        obtain ⟨r_x, hr_x⟩ := (IsIntegrallyClosed.isIntegral_iff (x := x)).mp hx_int
        change r_x.1 = x at hr_x
        rw [← hr_x]
        exact r_x.2
    have hW₀_iff : ∀ x : F, x ∈ W₀ ↔ ∃ b s : B, s ∉ p ∧ φ s * x = φ b := by
      intro x
      constructor
      · intro hx; exact hW₀_le_Rloc x hx
      · intro hx; exact hR_W₀ ⟨x, hx⟩
    refine ⟨W₀, hW₀_iff, ?_⟩
    intro b
    have hb_W₀ : φ b ∈ W₀ := (hW₀_iff (φ b)).mpr ⟨b, 1, hp_prime.one_notMem, by simp⟩
    refine ⟨hb_W₀, ?_⟩
    rw [IsLocalRing.mem_maximalIdeal]
    constructor
    · intro hnot_unit
      by_contra hb_not_p
      have hb0 : b ≠ 0 := fun h0 => hb_not_p (h0 ▸ p.zero_mem)
      have hφb0 : φ b ≠ 0 := fun h => hb0 (hφ_inj (h.trans (map_zero φ).symm))
      have hinv_W₀ : (φ b)⁻¹ ∈ W₀ :=
        (hW₀_iff (φ b)⁻¹).mpr ⟨1, b, hb_not_p, by rw [mul_inv_cancel₀ hφb0, map_one]⟩
      exact hnot_unit (mk_isUnit ⟨φ b, hb_W₀⟩ ⟨(φ b)⁻¹, hinv_W₀⟩
        (Subtype.ext (mul_inv_cancel₀ hφb0)))
    · intro hb_in_p hu
      obtain ⟨u, hbu⟩ := hu.exists_right_inv
      obtain ⟨b', s', hs'_not, huEq⟩ := (hW₀_iff u.1).mp u.2
      have hbu1 : φ b * u.1 = 1 := congrArg Subtype.val hbu
      have hbb : φ (b * b') = φ s' := by
        rw [map_mul, ← huEq]
        calc φ b * (φ s' * u.1) = φ s' * (φ b * u.1) := by ring
          _ = φ s' := by rw [hbu1, mul_one]
      have h_eq : b * b' = s' := hφ_inj hbb
      exact hs'_not (h_eq ▸ Ideal.mul_mem_right b' p hb_in_p)

  obtain ⟨W_w, hWw_mem, hWw_max⟩ := h_s3
  exact ⟨U_w, hUw, hw, φ_w, W_w, hη_eq, hWw_mem, hWw_max⟩

theorem weil_finite_modLocus_quotient_and_closedPoint_specialization (K : Type u) [Field K] [IsSepClosed K]
    (m : ℕ) (R : ValuationSubring K) (hPkg_R : IsValuationRingAlgPackage m R)
    (W_B_sch : AlgebraicGeometry.Scheme.{u})
    (g_WB : W_B_sch ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
    (hAff_WB : AlgebraicGeometry.IsAffine W_B_sch)
    (hSS_WB : IsStrictlySemistableCurveOverValuation R g_WB)
    (u₀_WB : ↥W_B_sch)
    (hu₀_max : (g_WB.base u₀_WB).asIdeal = IsLocalRing.maximalIdeal ↥R)
    (Z_mod : Set ↥W_B_sch) (hZ_cl : IsClosed Z_mod) (hZ_fin : Z_mod.Finite)
    (hZ_neBot : ∀ y ∈ Z_mod, (g_WB.base y).asIdeal ≠ ⊥)
    (hZ_sp : ∀ y ∈ Z_mod, u₀_WB ∈ closure ({y} : Set ↥W_B_sch))
    (Y₂ : AlgebraicGeometry.Scheme.{u})
    (g₂ : Y₂ ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥R))
    (f₂ : Y₂ ⟶ W_B_sch)
    (hSS₂ : IsStrictlySemistableCurveOverValuation R g₂)
    (hProp₂ : AlgebraicGeometry.IsProper f₂)
    (hf₂_g : f₂ ≫ g_WB = g₂)
    (y : ↥W_B_sch) (hy : y ∈ Z_mod) :
    (∀ u ∈ closure ({y} : Set ↥W_B_sch),
      (g_WB.base u).asIdeal = IsLocalRing.maximalIdeal ↥R → u = u₀_WB) ∧
    (∀ w : ↥Y₂, f₂.base w = y →
      ¬ (∀ w' : ↥Y₂, g₂.base w' = g₂.base w → w ∈ closure ({w'} : Set ↥Y₂) → w' = w) →
      Function.Surjective (f₂.residueFieldMap w).hom ∧
      (∀ u ∈ closure ({w} : Set ↥Y₂), g₂.base u = g₂.base w → u = w) ∧
      ∃ w₀ : ↥Y₂,
        w₀ ∈ closure ({w} : Set ↥Y₂) ∧
        IsClosed ({w₀} : Set ↥Y₂) ∧
        (g₂.base w₀).asIdeal = IsLocalRing.maximalIdeal ↥R ∧
        (∀ u ∈ closure ({w} : Set ↥Y₂),
          (g₂.base u).asIdeal = IsLocalRing.maximalIdeal ↥R → u = w₀)) :=
by
  classical
  subst hf₂_g
  have algClosed_root_mem_range :
      ∀ {κ L : Type u} [Field κ] [IsAlgClosed κ] [Field L]
        (ι : κ →+* L) (g : Polynomial κ) (z : L),
        g ≠ 0 → Polynomial.eval₂ ι z g = 0 → z ∈ Set.range ι := by
    intro κ L _ _ _ ι g z hg heval
    obtain ⟨m_roots, hm⟩ := Polynomial.splits_iff_exists_multiset.mp (IsAlgClosed.splits g)
    have h0 : (Polynomial.eval₂RingHom ι z) g = 0 := heval
    rw [hm, map_mul, map_multiset_prod] at h0
    simp only [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C] at h0
    have hlc : ι g.leadingCoeff ≠ 0 :=
      (map_ne_zero ι).mpr (Polynomial.leadingCoeff_ne_zero.mpr hg)
    rcases mul_eq_zero.mp h0 with hbad | hprod
    · exact absurd hbad hlc
    · have hmem0 := Multiset.prod_eq_zero_iff.mp hprod
      obtain ⟨y_f, hy_mem, hy_zero⟩ := Multiset.mem_map.mp hmem0
      obtain ⟨r, _, rfl⟩ := Multiset.mem_map.mp hy_mem
      rw [Polynomial.eval₂_sub, Polynomial.eval₂_X, Polynomial.eval₂_C] at hy_zero
      exact ⟨r, (sub_eq_zero.mp hy_zero).symm⟩
  have quasiFinite_comap_lt :
      ∀ {A₀ B : Type u} [CommRing A₀] [CommRing B]
        (θ : A₀ →+* B), θ.Etale →
        ∀ (p₁ p₂ : Ideal B) [p₁.IsPrime] [p₂.IsPrime],
          p₁ < p₂ → Ideal.comap θ p₁ < Ideal.comap θ p₂ := by
    intro A₀ B _ _ θ hEt p₁ p₂ _ _ hlt
    let _ : Algebra A₀ B := θ.toAlgebra
    have _ : Algebra.Etale A₀ B := hEt
    have _ : Algebra.QuasiFinite A₀ B := inferInstance
    refine lt_of_le_of_ne (Ideal.comap_mono hlt.le) ?_
    intro heq
    let q : Ideal A₀ := Ideal.comap θ p₁
    have _ : q.IsPrime := Ideal.comap_isPrime θ p₁
    have hp1_over : p₁.LiesOver q := ⟨rfl⟩
    have hp2_over : p₂.LiesOver q := ⟨heq⟩
    let e := PrimeSpectrum.primesOverOrderIsoFiber A₀ B q
    let x₁ : ↥(q.primesOver B) := ⟨p₁, ⟨inferInstance, hp1_over⟩⟩
    let x₂ : ↥(q.primesOver B) := ⟨p₂, ⟨inferInstance, hp2_over⟩⟩
    have hx_le : x₁ ≤ x₂ := hlt.le
    have hJ_le : (e x₁).asIdeal ≤ (e x₂).asIdeal := e.monotone hx_le
    have _ : Module.Finite q.ResidueField (q.Fiber B) := Algebra.QuasiFinite.finite_fiber q
    have _ : Algebra.IsIntegral q.ResidueField (q.Fiber B) :=
      Algebra.IsIntegral.of_finite q.ResidueField (q.Fiber B)
    have hcomap_bot :
        Ideal.comap (algebraMap q.ResidueField (q.Fiber B)) (e x₁).asIdeal = ⊥ := by
      have _ : (Ideal.comap (algebraMap q.ResidueField (q.Fiber B)) (e x₁).asIdeal).IsPrime :=
        Ideal.comap_isPrime _ _
      exact (Ideal.bot_isMaximal.eq_of_le
        (Ideal.IsPrime.ne_top inferInstance) bot_le).symm
    have _ : (e x₁).asIdeal.LiesOver (⊥ : Ideal q.ResidueField) := ⟨hcomap_bot.symm⟩
    have _ : (⊥ : Ideal q.ResidueField).IsMaximal := Ideal.bot_isMaximal
    have hmax_J1 : (e x₁).asIdeal.IsMaximal :=
      Ideal.IsMaximal.of_liesOver_isMaximal (e x₁).asIdeal (⊥ : Ideal q.ResidueField)
    have hJ_eq : e x₁ = e x₂ :=
      PrimeSpectrum.ext (hmax_J1.eq_of_le (e x₂).isPrime.ne_top hJ_le)
    have hx_eq : x₁ = x₂ := e.injective hJ_eq
    exact hlt.ne (congrArg Subtype.val hx_eq)
  have finite_closure_algClosed_frac :
      ∀ {R₀ A : Type u} [CommRing R₀] [CommRing A]
        (γ : R₀ →+* A), γ.FiniteType →
        ∀ (P : Ideal R₀) [P.IsPrime] [IsAlgClosed P.ResidueField]
          (p_y : PrimeSpectrum A),
          Ideal.comap γ p_y.asIdeal = P →
          (closure ({p_y} : Set (PrimeSpectrum A))).Finite →
          ∀ b : A, ∃ a s : R₀, s ∉ P ∧ b * γ s - γ a ∈ p_y.asIdeal := by
    intro R₀ A _ _ γ hFT P _ _ p_y hcomap hFin_cl
    let D := A ⧸ p_y.asIdeal
    have _ : p_y.asIdeal.IsPrime := p_y.isPrime
    let π_D : A →+* D := Ideal.Quotient.mk p_y.asIdeal
    let γ_D : R₀ →+* D := π_D.comp γ
    have hker_γD : RingHom.ker γ_D = P := by
      ext r
      simp only [γ_D, π_D, RingHom.mem_ker, RingHom.comp_apply]
      rw [← hcomap, Ideal.mem_comap]
      exact Ideal.Quotient.eq_zero_iff_mem
    let M : Submonoid D := Submonoid.map γ_D P.primeCompl
    have hM_nzd : M ≤ nonZeroDivisors D := by
      rintro _ ⟨s, hs, rfl⟩
      rw [mem_nonZeroDivisors_iff_ne_zero]
      intro h0
      exact hs (hker_γD ▸ h0)
    let L := Localization M
    have _ : IsDomain L := IsLocalization.isDomain_of_le_nonZeroDivisors L hM_nzd
    have hinj_DL : Function.Injective (algebraMap D L) := IsLocalization.injective L hM_nzd
    have hUnits_P : ∀ s : P.primeCompl, IsUnit ((algebraMap D L) (γ_D s.1)) := by
      intro s
      exact IsLocalization.map_units L (⟨γ_D s.1, Submonoid.mem_map_of_mem γ_D s.2⟩ : M)
    let φ_loc : Localization.AtPrime P →+* L :=
      IsLocalization.lift (M := P.primeCompl) (g := (algebraMap D L).comp γ_D) hUnits_P
    have hker_loc : IsLocalRing.maximalIdeal (Localization.AtPrime P) ≤ RingHom.ker φ_loc := by
      intro z hz
      obtain ⟨⟨r, s⟩, hzs⟩ := IsLocalization.surj P.primeCompl z
      have hrP : r ∈ P := by
        have hmul : algebraMap R₀ (Localization.AtPrime P) r ∈
            IsLocalRing.maximalIdeal (Localization.AtPrime P) := by
          rw [← hzs]
          exact Ideal.mul_mem_right _ _ hz
        have hunder := IsLocalization.AtPrime.under_maximalIdeal (Localization.AtPrime P) P
        rw [← hunder]
        exact hmul
      have hs_unit : IsUnit (φ_loc (algebraMap R₀ (Localization.AtPrime P) s.1)) := by
        change IsUnit (IsLocalization.lift hUnits_P (algebraMap R₀ _ s.1))
        rw [IsLocalization.lift_eq]
        exact hUnits_P s
      have hprod0 : φ_loc z * φ_loc (algebraMap R₀ (Localization.AtPrime P) s.1) = 0 := by
        rw [← map_mul, hzs]
        change IsLocalization.lift hUnits_P (algebraMap R₀ _ r) = 0
        rw [IsLocalization.lift_eq]
        change algebraMap D L (γ_D r) = 0
        have hγr : γ_D r = 0 := by rwa [← RingHom.mem_ker, hker_γD]
        rw [hγr, map_zero]
      rcases hs_unit with ⟨u, hu⟩
      rw [← hu] at hprod0
      have h0 := congrArg (· * (u⁻¹ : Lˣ).val) hprod0
      simpa [mul_assoc] using h0
    let φ_κ : P.ResidueField →+* L :=
      Ideal.Quotient.lift (IsLocalRing.maximalIdeal (Localization.AtPrime P)) φ_loc hker_loc
    have hφ_κ_alg : ∀ r : R₀,
        φ_κ (algebraMap R₀ P.ResidueField r) = algebraMap D L (γ_D r) := by
      intro r
      change Ideal.Quotient.lift _ φ_loc hker_loc
        (IsLocalRing.residue (Localization.AtPrime P) (algebraMap R₀ (Localization.AtPrime P) r)) = _
      change φ_loc (algebraMap R₀ (Localization.AtPrime P) r) = _
      exact IsLocalization.lift_eq hUnits_P r
    have hFT_κ : φ_κ.FiniteType := by
      let _ : Algebra R₀ A := γ.toAlgebra
      have _ : Algebra.FiniteType R₀ A := hFT
      obtain ⟨S_gen, hS_gen⟩ := Algebra.FiniteType.out (R := R₀) (A := A)
      let _ : Algebra P.ResidueField L := φ_κ.toAlgebra
      change Algebra.FiniteType P.ResidueField L
      have hd_all : ∀ d : D,
          algebraMap D L d ∈
            Algebra.adjoin P.ResidueField ↑(S_gen.image ((algebraMap D L).comp π_D)) := by
        intro d
        obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective d
        have ha_top : a ∈ (⊤ : Subalgebra R₀ A) := trivial
        rw [← hS_gen] at ha_top
        induction ha_top using Algebra.adjoin_induction with
        | mem x hx =>
          apply Algebra.subset_adjoin
          exact Finset.mem_coe.mpr (Finset.mem_image_of_mem _ hx)
        | algebraMap r =>
          change algebraMap D L (γ_D r) ∈ _
          rw [← hφ_κ_alg r]
          exact Subalgebra.algebraMap_mem _ _
        | add x y _ _ ihx ihy =>
          simp only [map_add]; exact Subalgebra.add_mem _ ihx ihy
        | mul x y _ _ ihx ihy =>
          simp only [map_mul]; exact Subalgebra.mul_mem _ ihx ihy
      refine ⟨⟨S_gen.image ((algebraMap D L).comp π_D), ?_⟩⟩
      rw [eq_top_iff]
      intro z _
      obtain ⟨⟨d, m_elt⟩, hzm⟩ := IsLocalization.surj M z
      rcases m_elt with ⟨_, s, hsP, rfl⟩
      have hs_ne : algebraMap R₀ P.ResidueField s ≠ 0 := by
        intro h0
        have hm : s ∈ RingHom.ker (algebraMap R₀ P.ResidueField) := h0
        rw [Ideal.ker_algebraMap_residueField] at hm
        exact hsP hm
      have hinv_mem :
          (φ_κ ((algebraMap R₀ P.ResidueField s)⁻¹)) ∈
            Algebra.adjoin P.ResidueField ↑(S_gen.image ((algebraMap D L).comp π_D)) :=
        Subalgebra.algebraMap_mem _ _
      have hz_eq : z = algebraMap D L d * φ_κ ((algebraMap R₀ P.ResidueField s)⁻¹) := by
        have hm_eq : algebraMap D L (γ_D s) * φ_κ ((algebraMap R₀ P.ResidueField s)⁻¹) = 1 := by
          rw [← hφ_κ_alg s, ← map_mul, mul_inv_cancel₀ hs_ne, map_one]
        calc z = z * 1 := (mul_one z).symm
          _ = z * (algebraMap D L (γ_D s) * φ_κ ((algebraMap R₀ P.ResidueField s)⁻¹)) := by
              rw [hm_eq]
          _ = (z * algebraMap D L (γ_D s)) * φ_κ ((algebraMap R₀ P.ResidueField s)⁻¹) := by
              ring
          _ = algebraMap D L d * φ_κ ((algebraMap R₀ P.ResidueField s)⁻¹) := by
              rw [hzm]
      rw [hz_eq]
      exact Subalgebra.mul_mem _ (hd_all d) hinv_mem
    have hFin_L : (Set.univ : Set (PrimeSpectrum L)).Finite := by
      let f_spec : PrimeSpectrum L → PrimeSpectrum A :=
        PrimeSpectrum.comap ((algebraMap D L).comp π_D)
      have hinj_f : Function.Injective f_spec := by
        intro q₁ q₂ heq
        have h1 : Ideal.comap π_D (Ideal.comap (algebraMap D L) q₁.asIdeal) =
            Ideal.comap π_D (Ideal.comap (algebraMap D L) q₂.asIdeal) :=
          congrArg PrimeSpectrum.asIdeal heq
        have h2 : Ideal.comap (algebraMap D L) q₁.asIdeal =
            Ideal.comap (algebraMap D L) q₂.asIdeal :=
          Ideal.comap_injective_of_surjective π_D Ideal.Quotient.mk_surjective h1
        exact PrimeSpectrum.ext ((IsLocalization.orderEmbedding M L).injective h2)
      have hsub : Set.range f_spec ⊆ closure ({p_y} : Set (PrimeSpectrum A)) := by
        rintro _ ⟨q, rfl⟩
        rw [← PrimeSpectrum.le_iff_mem_closure]
        intro a ha
        change algebraMap D L (π_D a) ∈ q.asIdeal
        have hπ0 : π_D a = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr ha
        rw [hπ0, map_zero]
        exact q.asIdeal.zero_mem
      exact Set.Finite.of_finite_image (hFin_cl.subset (by simpa using hsub))
        hinj_f.injOn
    have hJac_L : IsJacobsonRing L :=
      RingHom.FiniteType.isJacobsonRing hFT_κ
    have _ : JacobsonSpace (PrimeSpectrum L) :=
      PrimeSpectrum.isJacobsonRing_iff_jacobsonSpace.mp hJac_L
    have hbot_prime : (⊥ : Ideal L).IsPrime := by
      rw [Ideal.isPrime_iff]
      refine ⟨bot_ne_top, fun {x y} hxy => ?_⟩
      rw [Ideal.mem_bot] at hxy ⊢
      rw [Ideal.mem_bot]
      exact mul_eq_zero.mp hxy
    let q_bot : PrimeSpectrum L := ⟨⊥, hbot_prime⟩
    let S_strict : Set (PrimeSpectrum L) := Set.univ \ {q_bot}
    have hFin_S : S_strict.Finite := hFin_L.subset (Set.subset_univ _)
    let C_strict : Set (PrimeSpectrum L) :=
      ⋃ r ∈ S_strict, closure ({r} : Set (PrimeSpectrum L))
    have hCl_C : IsClosed C_strict :=
      hFin_S.isClosed_biUnion (fun _ _ => isClosed_closure)
    have hq_eq : ({q_bot} : Set (PrimeSpectrum L)) = C_strictᶜ := by
      ext q
      simp only [C_strict, S_strict, Set.mem_singleton_iff, Set.mem_compl_iff,
        Set.mem_iUnion, Set.mem_sdiff, Set.mem_univ, true_and, not_exists]
      constructor
      · rintro rfl r hr_ne hbot_cl
        have hr_le : r.asIdeal ≤ (⊥ : Ideal L) :=
          (PrimeSpectrum.le_iff_mem_closure r q_bot).mpr hbot_cl
        exact hr_ne (PrimeSpectrum.ext (le_bot_iff.mp hr_le))
      · intro hnot
        by_contra hne
        exact hnot q hne (subset_closure (Set.mem_singleton q))
    have hOpen_q : IsOpen ({q_bot} : Set (PrimeSpectrum L)) := by
      rw [hq_eq]; exact hCl_C.isOpen_compl
    have hCl_q : IsClosed ({q_bot} : Set (PrimeSpectrum L)) :=
      isClosed_singleton_of_isLocallyClosed_singleton hOpen_q.isLocallyClosed
    have hMax_bot : (⊥ : Ideal L).IsMaximal :=
      (PrimeSpectrum.isClosed_singleton_iff_isMaximal q_bot).mp hCl_q
    have hField_L : IsField L := by
      have hq_field : IsField (L ⧸ (⊥ : Ideal L)) :=
        (Ideal.Quotient.maximal_ideal_iff_isField_quotient (⊥ : Ideal L)).mp hMax_bot
      exact (RingEquiv.quotientBot L).symm.toMulEquiv.isField hq_field
    let _ : Field L := hField_L.toField
    have hFin_hom : φ_κ.Finite :=
      RingHom.finite_iff_finiteType_of_isJacobsonRing.mpr hFT_κ
    let _ : Algebra P.ResidueField L := φ_κ.toAlgebra
    have _ : Algebra.IsIntegral P.ResidueField L := ⟨hFin_hom.to_isIntegral⟩
    have hBij_κ : Function.Bijective φ_κ :=
      IsAlgClosed.algebraMap_bijective_of_isIntegral (k := P.ResidueField) (K := L)
    intro b
    obtain ⟨c, hc⟩ := hBij_κ.2 (algebraMap D L (π_D b))
    obtain ⟨z, rfl⟩ := IsLocalRing.residue_surjective (R := Localization.AtPrime P) c
    obtain ⟨⟨a, s⟩, hzs⟩ := IsLocalization.surj P.primeCompl z
    refine ⟨a, s.1, s.2, ?_⟩
    have hbar :
        IsLocalRing.residue (Localization.AtPrime P) z *
          algebraMap R₀ P.ResidueField s.1 =
        algebraMap R₀ P.ResidueField a := by
      change IsLocalRing.residue _ z *
          IsLocalRing.residue _ (algebraMap R₀ (Localization.AtPrime P) s.1) =
        IsLocalRing.residue _ (algebraMap R₀ (Localization.AtPrime P) a)
      rw [← map_mul, hzs]
    have hmap := congrArg φ_κ hbar
    rw [map_mul, hc, hφ_κ_alg s.1, hφ_κ_alg a, ← map_mul] at hmap
    have hD : π_D b * γ_D s.1 = γ_D a := hinj_DL hmap
    have hsub : π_D (b * γ s.1 - γ a) = 0 := by
      simp only [map_sub, map_mul]
      exact sub_eq_zero.mpr hD
    exact Ideal.Quotient.eq_zero_iff_mem.mp hsub
  have eval₂_mem_range_of_sep :
      ∀ {R₀ A₀ L : Type u} [CommRing R₀] [CommRing A₀] [Field L]
        (c₀ : R₀ →+* A₀) (P : Ideal R₀) [P.IsPrime] [IsAlgClosed P.ResidueField]
        (q₁ q₂ : Ideal A₀),
        Ideal.comap c₀ q₁ = P →
        ∀ (ι : P.ResidueField →+* L) (ψ : A₀ →+* L),
          RingHom.ker ψ = q₂ →
          (∀ r : R₀, ψ (c₀ r) = ι (algebraMap R₀ P.ResidueField r)) →
          ∀ (x_t : A₀) (G : Polynomial R₀),
            Polynomial.eval₂ c₀ x_t G ∈ q₂ →
            Polynomial.eval₂ c₀ x_t G ∉ q₁ →
            ψ x_t ∈ Set.range ι := by
    intro R₀ A₀ L _ _ _ c₀ P _ _ q₁ q₂ hcomap₁ ι ψ hker hcomm x_t G hG₂ hG₁
    have hcoeff : ∃ i : ℕ, G.coeff i ∉ P := by
      by_contra! hall
      apply hG₁
      rw [Polynomial.eval₂_eq_sum_range]
      refine Ideal.sum_mem q₁ fun i _ => ?_
      have hi : c₀ (G.coeff i) ∈ q₁ := by
        rw [← Ideal.mem_comap, hcomap₁]; exact hall i
      exact Ideal.mul_mem_right (x_t ^ i) q₁ hi
    obtain ⟨i₀, hi₀⟩ := hcoeff
    let g : Polynomial P.ResidueField := Polynomial.map (algebraMap R₀ P.ResidueField) G
    have hg_ne : g ≠ 0 := by
      intro h0
      have hci : g.coeff i₀ = 0 := by rw [h0, Polynomial.coeff_zero]
      rw [Polynomial.coeff_map] at hci
      have hm : G.coeff i₀ ∈ RingHom.ker (algebraMap R₀ P.ResidueField) := hci
      rw [Ideal.ker_algebraMap_residueField] at hm
      exact hi₀ hm
    have heval : Polynomial.eval₂ ι (ψ x_t) g = 0 := by
      rw [Polynomial.eval₂_map]
      have hcomp : ι.comp (algebraMap R₀ P.ResidueField) = ψ.comp c₀ := by
        ext r; exact (hcomm r).symm
      rw [hcomp]
      have hhom : Polynomial.eval₂ (ψ.comp c₀) (ψ x_t) G = ψ (Polynomial.eval₂ c₀ x_t G) := by
        rw [Polynomial.hom_eval₂]
      rw [hhom]
      exact RingHom.mem_ker.mp (hker ▸ hG₂)
    exact algClosed_root_mem_range ι g (ψ x_t) hg_ne heval
  have poly_nonMin_algRoot :
      ∀ {R₀ : Type u} [CommRing R₀] (P : Ideal R₀) [P.IsPrime] [IsAlgClosed P.ResidueField]
        (q₁ q₂ : Ideal (Polynomial R₀)) [q₁.IsPrime] [q₂.IsPrime],
        q₁ < q₂ → Ideal.comap Polynomial.C q₁ = P →
        ∀ (L : Type u) [Field L] (ι : P.ResidueField →+* L) (ψ : Polynomial R₀ →+* L),
          RingHom.ker ψ = q₂ →
          (∀ r : R₀, ψ (Polynomial.C r) = ι (algebraMap R₀ P.ResidueField r)) →
          Set.range ψ ⊆ Set.range ι := by
    intro R₀ _ P _ _ q₁ q₂ _ _ hlt hcomap₁ L _ ι ψ hker hcomm
    obtain ⟨f, hfq₂, hfq₁⟩ := Set.exists_of_ssubset hlt
    have heval_f : Polynomial.eval₂ Polynomial.C Polynomial.X f = f := Polynomial.eval₂_C_X
    have hX : ψ Polynomial.X ∈ ι.range := by
      change ψ Polynomial.X ∈ Set.range ι
      exact eval₂_mem_range_of_sep Polynomial.C P q₁ q₂ hcomap₁ ι ψ hker hcomm Polynomial.X f
        (heval_f.symm ▸ hfq₂) (heval_f.symm ▸ hfq₁)
    rintro _ ⟨p, rfl⟩
    change ψ p ∈ (ι.range : Set L)
    induction p using Polynomial.induction_on' with
    | add p₁ p₂ ih₁ ih₂ => rw [map_add]; exact ι.range.add_mem ih₁ ih₂
    | monomial n r =>
      rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow, hcomm r]
      exact ι.range.mul_mem ⟨_, rfl⟩ (ι.range.pow_mem hX n)
  have nodal_nonMin_algRoot :
      ∀ {R₀ : Type u} [CommRing R₀] (P : Ideal R₀) [P.IsPrime] [IsAlgClosed P.ResidueField]
        (a : R₀)
        (q₁ q₂ : Ideal (MvPolynomial (Fin 2) R₀ ⧸
          Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}))
        [q₁.IsPrime] [q₂.IsPrime],
        q₁ < q₂ →
        Ideal.comap
          ((Ideal.Quotient.mk
            (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a})).comp
            MvPolynomial.C) q₁ = P →
        ∀ (L : Type u) [Field L] (ι : P.ResidueField →+* L)
          (ψ : (MvPolynomial (Fin 2) R₀ ⧸
            Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}) →+* L),
          RingHom.ker ψ = q₂ →
          (∀ r : R₀,
            ψ (((Ideal.Quotient.mk
              (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a})).comp
              MvPolynomial.C) r) =
              ι (algebraMap R₀ P.ResidueField r)) →
          Set.range ψ ⊆ Set.range ι := by
    intro R₀ _ P _ _ a q₁ q₂ hq₁ _ hlt hcomap₁ L _ ι ψ hker hcomm
    let I_nod : Ideal (MvPolynomial (Fin 2) R₀) :=
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}
    let π₀ := Ideal.Quotient.mk I_nod
    let c₀ := π₀.comp MvPolynomial.C
    let x₀ := π₀ (MvPolynomial.X 0)
    let x₁ := π₀ (MvPolynomial.X 1)
    have hx_mul : x₀ * x₁ = c₀ a := by
      have h0 : x₀ * x₁ - c₀ a = 0 := by
        change π₀ (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a) = 0
        exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton _))
      exact sub_eq_zero.mp h0
    obtain ⟨u, hu₂, hu₁⟩ := Set.exists_of_ssubset hlt
    obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective u
    let mk_q₁ := Ideal.Quotient.mk q₁
    have hx_mem_range : ψ x₀ ∈ ι.range ∧ ψ x₁ ∈ ι.range := by
      by_cases haP : a ∈ P
      · have hprod_q₁ : x₀ * x₁ ∈ q₁ := by
          rw [hx_mul, ← Ideal.mem_comap, hcomap₁]; exact haP
        rcases hq₁.mem_or_mem hprod_q₁ with hx0_q₁ | hx1_q₁
        · have hx0_0 : ψ x₀ = 0 := RingHom.mem_ker.mp (hker ▸ hlt.le hx0_q₁)
          refine ⟨hx0_0 ▸ ι.range.zero_mem, ?_⟩
          let G : Polynomial R₀ := MvPolynomial.eval₂ Polynomial.C ![0, Polynomial.X] F
          have hmod : mk_q₁ (π₀ F) = mk_q₁ (Polynomial.eval₂ c₀ x₁ G) := by
            have hhom_eq : mk_q₁.comp π₀ =
                (mk_q₁.comp (Polynomial.eval₂RingHom c₀ x₁)).comp
                  (MvPolynomial.eval₂Hom Polynomial.C ![0, Polynomial.X]) := by
              apply MvPolynomial.ringHom_ext
              · intro r
                simp only [RingHom.comp_apply, MvPolynomial.eval₂Hom_C,
                  Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
                rfl
              · intro i; fin_cases i <;> dsimp
                · rw [MvPolynomial.eval₂_X, Matrix.cons_val_zero, Polynomial.eval₂_zero, map_zero]
                  exact Ideal.Quotient.eq_zero_iff_mem.mpr hx0_q₁
                · rw [MvPolynomial.eval₂_X, Matrix.cons_val_one, Matrix.cons_val_zero,
                    Polynomial.eval₂_X]
            exact RingHom.congr_fun hhom_eq F
          have hdiff_q₁ : π₀ F - Polynomial.eval₂ c₀ x₁ G ∈ q₁ :=
            Ideal.Quotient.eq_zero_iff_mem.mp (by rw [map_sub, hmod, sub_self])
          have hG₂ : Polynomial.eval₂ c₀ x₁ G ∈ q₂ := by
            have hmem := q₂.sub_mem hu₂ (hlt.le hdiff_q₁)
            rwa [show Ideal.Quotient.mk I_nod F - (π₀ F - Polynomial.eval₂ c₀ x₁ G) =
              Polynomial.eval₂ c₀ x₁ G from sub_sub_cancel _ _] at hmem
          have hG₁ : Polynomial.eval₂ c₀ x₁ G ∉ q₁ := fun hG =>
            hu₁ (by
              have hmem := q₁.add_mem hdiff_q₁ hG
              rwa [sub_add_cancel] at hmem)
          exact eval₂_mem_range_of_sep c₀ P q₁ q₂ hcomap₁ ι ψ hker hcomm x₁ G hG₂ hG₁
        · have hx1_0 : ψ x₁ = 0 := RingHom.mem_ker.mp (hker ▸ hlt.le hx1_q₁)
          refine ⟨?_, hx1_0 ▸ ι.range.zero_mem⟩
          let G : Polynomial R₀ := MvPolynomial.eval₂ Polynomial.C ![Polynomial.X, 0] F
          have hmod : mk_q₁ (π₀ F) = mk_q₁ (Polynomial.eval₂ c₀ x₀ G) := by
            have hhom_eq : mk_q₁.comp π₀ =
                (mk_q₁.comp (Polynomial.eval₂RingHom c₀ x₀)).comp
                  (MvPolynomial.eval₂Hom Polynomial.C ![Polynomial.X, 0]) := by
              apply MvPolynomial.ringHom_ext
              · intro r
                simp only [RingHom.comp_apply, MvPolynomial.eval₂Hom_C,
                  Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
                rfl
              · intro i; fin_cases i <;> dsimp
                · rw [MvPolynomial.eval₂_X, Matrix.cons_val_zero, Polynomial.eval₂_X]
                · rw [MvPolynomial.eval₂_X, Matrix.cons_val_one, Matrix.cons_val_zero,
                    Polynomial.eval₂_zero, map_zero]
                  exact Ideal.Quotient.eq_zero_iff_mem.mpr hx1_q₁
            exact RingHom.congr_fun hhom_eq F
          have hdiff_q₁ : π₀ F - Polynomial.eval₂ c₀ x₀ G ∈ q₁ :=
            Ideal.Quotient.eq_zero_iff_mem.mp (by rw [map_sub, hmod, sub_self])
          have hG₂ : Polynomial.eval₂ c₀ x₀ G ∈ q₂ := by
            have hmem := q₂.sub_mem hu₂ (hlt.le hdiff_q₁)
