  have away_via_ψ0 : ∀ (d n : Localization.Away h_e),
      d_0 * n = d_2 * d →
      d_3 * n = d_1 * d →
      ψ_0 n = ψ_0 d * g_0 →
      @IsLocalization.Away (Localization.Away h_e) _ d (Localization.Away (ψ_0 d)) _
        ((algebraMap (Localization.Away h_0) (Localization.Away (ψ_0 d))).comp ψ_0).toAlgebra := by
    intro d n hdn1 hdn2 hψn
    let j_B := algebraMap (Localization.Away h_e) (Localization.Away d)
    let j_0 := algebraMap (Localization.Away h_0) (Localization.Away (ψ_0 d))
    let f_d := j_0.comp ψ_0
    have hUnit_fd : IsUnit (f_d d) := IsLocalization.Away.algebraMap_isUnit (ψ_0 d)
    let F_d : Localization.Away d →+* Localization.Away (ψ_0 d) :=
      IsLocalization.Away.lift d (g := f_d) hUnit_fd
    have hFd_eq : ∀ b, F_d (j_B b) = j_0 (ψ_0 b) :=
      fun b => IsLocalization.Away.lift_eq d (g := f_d) hUnit_fd b
    let y_1 : Localization.Away d := j_B n * IsLocalization.Away.invSelf d
    have hy1_rel1 : j_B d_0 * y_1 = j_B d_2 := by
      calc j_B d_0 * (j_B n * IsLocalization.Away.invSelf d)
          = j_B (d_0 * n) * IsLocalization.Away.invSelf d := by rw [← mul_assoc, ← map_mul]
        _ = j_B d_2 * (j_B d * IsLocalization.Away.invSelf d) := by rw [hdn1, map_mul, mul_assoc]
        _ = j_B d_2 := by rw [IsLocalization.Away.mul_invSelf d, mul_one]
    have hy1_rel2 : j_B d_3 * y_1 = j_B d_1 := by
      calc j_B d_3 * (j_B n * IsLocalization.Away.invSelf d)
          = j_B (d_3 * n) * IsLocalization.Away.invSelf d := by rw [← mul_assoc, ← map_mul]
        _ = j_B d_1 * (j_B d * IsLocalization.Away.invSelf d) := by rw [hdn2, map_mul, mul_assoc]
        _ = j_B d_1 := by rw [IsLocalization.Away.mul_invSelf d, mul_one]
    have hFd_y1 : F_d y_1 = j_0 g_0 := by
      have hinv_d : j_0 (ψ_0 d) * F_d (IsLocalization.Away.invSelf d) = 1 := by
        calc j_0 (ψ_0 d) * F_d (IsLocalization.Away.invSelf d)
            = F_d (j_B d) * F_d (IsLocalization.Away.invSelf d) := by rw [hFd_eq]
          _ = F_d (j_B d * IsLocalization.Away.invSelf d) := (map_mul F_d _ _).symm
          _ = 1 := by rw [IsLocalization.Away.mul_invSelf d, map_one]
      calc F_d y_1 = F_d (j_B n) * F_d (IsLocalization.Away.invSelf d) := map_mul F_d _ _
        _ = j_0 (ψ_0 n) * F_d (IsLocalization.Away.invSelf d) := by rw [hFd_eq]
        _ = j_0 g_0 * (j_0 (ψ_0 d) * F_d (IsLocalization.Away.invSelf d)) := by
              rw [hψn, map_mul]; ring
        _ = j_0 g_0 := by rw [hinv_d, mul_one]
    let ι_Ld : R₀ →+* Localization.Away d :=
      (j_B.comp α_e).comp ((Ideal.Quotient.mk (weilNodalIdeal R₀ (b' * π_tilde))).comp MvPolynomial.C)
    obtain ⟨γ_pre, _hγ_pre_mk, hγ_pre_C, hγ_pre_X0, hγ_pre_X1⟩ :=
      exists_liftNodalQuot ι_Ld (j_B d_0) y_1 hy1_rel1
    have hγ_Φ0 :
        (γ_pre.comp (Ideal.Quotient.mk (weilNodalIdeal R₀ π_tilde))).comp Φ_0 =
          (j_B.comp α_e).comp (Ideal.Quotient.mk (weilNodalIdeal R₀ (b' * π_tilde))) := by
      apply MvPolynomial.ringHom_ext'
      · ext r
        change γ_pre (Ideal.Quotient.mk _ (Φ_0 (MvPolynomial.C r))) =
          j_B (α_e (Ideal.Quotient.mk _ (MvPolynomial.C r)))
        dsimp only [Φ_0]
        rw [MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_C, hγ_pre_C]
        rfl
      · intro i; fin_cases i
        · change γ_pre (Ideal.Quotient.mk _ (Φ_0 (MvPolynomial.X 0))) =
            j_B (α_e (Ideal.Quotient.mk _ (MvPolynomial.X 0)))
          dsimp only [Φ_0]
          simp only [MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_X, Matrix.cons_val_zero,
            hγ_pre_X0]
          rfl
        · change γ_pre (Ideal.Quotient.mk _ (Φ_0 (MvPolynomial.X 1))) =
            j_B (α_e (Ideal.Quotient.mk _ (MvPolynomial.X 1)))
          dsimp only [Φ_0]
          simp only [MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_X, Matrix.cons_val_one,
            Matrix.cons_val_zero, map_mul, hγ_pre_C, hγ_pre_X1]
          exact hy1_rel2
    have hγ_h0 : γ_pre h_0 = j_B (α_e h_e) :=
      (congrArg γ_pre hh_0_eq).trans
        ((DFunLike.congr_fun hγ_Φ0 P_h).trans (congrArg (fun x => j_B (α_e x)) hh_e_eq.symm))
    have hUnit_γh0 : IsUnit (γ_pre h_0) := by
      rw [hγ_h0]
      exact IsUnit.map j_B (IsLocalization.Away.algebraMap_isUnit h_e)
    let γ_C0 : Localization.Away h_0 →+* Localization.Away d :=
      IsLocalization.Away.lift h_0 (g := γ_pre) hUnit_γh0
    have hγC0_eq : ∀ x, γ_C0 (α_0 x) = γ_pre x :=
      fun x => IsLocalization.Away.lift_eq h_0 (g := γ_pre) hUnit_γh0 x
    have hγC0_ψ0 : γ_C0.comp ψ_0 = j_B := by
      apply nodalAway_ringHom_ext
      · intro r
        change γ_C0 (ψ_0 (α_e (Ideal.Quotient.mk _ (MvPolynomial.C r)))) =
          j_B (α_e (Ideal.Quotient.mk _ (MvPolynomial.C r)))
        rw [hψ0_C, hγC0_eq, hγ_pre_C]
        rfl
      · change γ_C0 (ψ_0 d_0) = j_B d_0
        rw [hψ0_d0]
        dsimp only [u_0]
        rw [hγC0_eq, hγ_pre_X0]
      · change γ_C0 (ψ_0 d_1) = j_B d_1
        rw [hψ0_d1_mul, map_mul, hψ0_d3, hγC0_eq]
        change γ_pre _ * γ_C0 (α_0 (Ideal.Quotient.mk _ (MvPolynomial.X 1))) = j_B d_1
        rw [hγC0_eq, hγ_pre_C, hγ_pre_X1]
        exact hy1_rel2
    have hUnit_γψd : IsUnit (γ_C0 (ψ_0 d)) := by
      have hd_eq : γ_C0 (ψ_0 d) = j_B d := DFunLike.congr_fun hγC0_ψ0 d
      rw [hd_eq]
      exact IsLocalization.Away.algebraMap_isUnit d
    let G_d : Localization.Away (ψ_0 d) →+* Localization.Away d :=
      IsLocalization.Away.lift (ψ_0 d) (g := γ_C0) hUnit_γψd
    have hGd_eq : ∀ c, G_d (j_0 c) = γ_C0 c :=
      fun c => IsLocalization.Away.lift_eq (ψ_0 d) (g := γ_C0) hUnit_γψd c
    have hGF_d : G_d.comp F_d = RingHom.id (Localization.Away d) := by
      apply IsLocalization.ringHom_ext (Submonoid.powers d)
      ext b
      change G_d (F_d (j_B b)) = j_B b
      rw [hFd_eq, hGd_eq]
      exact DFunLike.congr_fun hγC0_ψ0 b
    have hFG_d : F_d.comp G_d = RingHom.id (Localization.Away (ψ_0 d)) := by
      apply IsLocalization.ringHom_ext (Submonoid.powers (ψ_0 d))
      have hcomp : F_d.comp γ_C0 = j_0 := by
        apply nodalAway_ringHom_ext
        · intro r
          change F_d (γ_C0 (α_0 (Ideal.Quotient.mk _ (MvPolynomial.C r)))) =
            j_0 (α_0 (Ideal.Quotient.mk _ (MvPolynomial.C r)))
          rw [hγC0_eq, hγ_pre_C]
          change F_d (j_B (α_e (Ideal.Quotient.mk _ (MvPolynomial.C r)))) = _
          rw [hFd_eq, hψ0_C]
        · change F_d (γ_C0 u_0) = j_0 u_0
          dsimp only [u_0]
          rw [hγC0_eq, hγ_pre_X0, hFd_eq, hψ0_d0]
        · change F_d (γ_C0 (α_0 (Ideal.Quotient.mk _ (MvPolynomial.X 1)))) = j_0 g_0
          rw [hγC0_eq, hγ_pre_X1]
          exact hFd_y1
      ext c
      change F_d (G_d (j_0 c)) = j_0 c
      rw [hGd_eq]
      exact DFunLike.congr_fun hcomp c
    exact isLocalization_away_of_inv d f_d F_d G_d hFd_eq hFG_d hGF_d

  
  have away_via_ψ1 : ∀ (d n : Localization.Away h_e),
      n * d_1 = d_3 * d →
      d_2 * n = d_0 * d →
      ψ_1 n = ψ_1 d * g_1 →
      @IsLocalization.Away (Localization.Away h_e) _ d (Localization.Away (ψ_1 d)) _
        ((algebraMap (Localization.Away h_1) (Localization.Away (ψ_1 d))).comp ψ_1).toAlgebra := by
    intro d n hdn1 hdn2 hψn
    let j_B := algebraMap (Localization.Away h_e) (Localization.Away d)
    let j_1 := algebraMap (Localization.Away h_1) (Localization.Away (ψ_1 d))
    let f_d := j_1.comp ψ_1
    have hUnit_fd : IsUnit (f_d d) := IsLocalization.Away.algebraMap_isUnit (ψ_1 d)
    let F_d : Localization.Away d →+* Localization.Away (ψ_1 d) :=
      IsLocalization.Away.lift d (g := f_d) hUnit_fd
    have hFd_eq : ∀ b, F_d (j_B b) = j_1 (ψ_1 b) :=
      fun b => IsLocalization.Away.lift_eq d (g := f_d) hUnit_fd b
    let y_0 : Localization.Away d := j_B n * IsLocalization.Away.invSelf d
    have hy0_rel1 : y_0 * j_B d_1 = j_B d_3 := by
      calc (j_B n * IsLocalization.Away.invSelf d) * j_B d_1
          = j_B (n * d_1) * IsLocalization.Away.invSelf d := by rw [map_mul]; ring
        _ = j_B d_3 * (j_B d * IsLocalization.Away.invSelf d) := by rw [hdn1, map_mul, mul_assoc]
        _ = j_B d_3 := by rw [IsLocalization.Away.mul_invSelf d, mul_one]
    have hy0_rel2 : j_B d_2 * y_0 = j_B d_0 := by
      calc j_B d_2 * (j_B n * IsLocalization.Away.invSelf d)
          = j_B (d_2 * n) * IsLocalization.Away.invSelf d := by rw [← mul_assoc, ← map_mul]
        _ = j_B d_0 * (j_B d * IsLocalization.Away.invSelf d) := by rw [hdn2, map_mul, mul_assoc]
        _ = j_B d_0 := by rw [IsLocalization.Away.mul_invSelf d, mul_one]
    have hFd_y0 : F_d y_0 = j_1 g_1 := by
      have hinv_d : j_1 (ψ_1 d) * F_d (IsLocalization.Away.invSelf d) = 1 := by
        calc j_1 (ψ_1 d) * F_d (IsLocalization.Away.invSelf d)
            = F_d (j_B d) * F_d (IsLocalization.Away.invSelf d) := by rw [hFd_eq]
          _ = F_d (j_B d * IsLocalization.Away.invSelf d) := (map_mul F_d _ _).symm
          _ = 1 := by rw [IsLocalization.Away.mul_invSelf d, map_one]
      calc F_d y_0 = F_d (j_B n) * F_d (IsLocalization.Away.invSelf d) := map_mul F_d _ _
        _ = j_1 (ψ_1 n) * F_d (IsLocalization.Away.invSelf d) := by rw [hFd_eq]
        _ = j_1 g_1 * (j_1 (ψ_1 d) * F_d (IsLocalization.Away.invSelf d)) := by
              rw [hψn, map_mul]; ring
        _ = j_1 g_1 := by rw [hinv_d, mul_one]
    let ι_Ld : R₀ →+* Localization.Away d :=
      (j_B.comp α_e).comp ((Ideal.Quotient.mk (weilNodalIdeal R₀ (b' * π_tilde))).comp MvPolynomial.C)
    obtain ⟨γ_pre, _hγ_pre_mk, hγ_pre_C, hγ_pre_X0, hγ_pre_X1⟩ :=
      exists_liftNodalQuot ι_Ld y_0 (j_B d_1) hy0_rel1
    have hγ_Φ1 :
        (γ_pre.comp (Ideal.Quotient.mk (weilNodalIdeal R₀ b'))).comp Φ_1 =
          (j_B.comp α_e).comp (Ideal.Quotient.mk (weilNodalIdeal R₀ (b' * π_tilde))) := by
      apply MvPolynomial.ringHom_ext'
      · ext r
        change γ_pre (Ideal.Quotient.mk _ (Φ_1 (MvPolynomial.C r))) =
          j_B (α_e (Ideal.Quotient.mk _ (MvPolynomial.C r)))
        dsimp only [Φ_1]
        rw [MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_C, hγ_pre_C]
        rfl
      · intro i; fin_cases i
        · change γ_pre (Ideal.Quotient.mk _ (Φ_1 (MvPolynomial.X 0))) =
            j_B (α_e (Ideal.Quotient.mk _ (MvPolynomial.X 0)))
          dsimp only [Φ_1]
          simp only [MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_X, Matrix.cons_val_zero,
            map_mul, hγ_pre_C, hγ_pre_X0]
          exact hy0_rel2
        · change γ_pre (Ideal.Quotient.mk _ (Φ_1 (MvPolynomial.X 1))) =
            j_B (α_e (Ideal.Quotient.mk _ (MvPolynomial.X 1)))
          dsimp only [Φ_1]
          simp only [MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_X, Matrix.cons_val_one,
            Matrix.cons_val_zero, hγ_pre_X1]
          rfl
    have hγ_h1 : γ_pre h_1 = j_B (α_e h_e) :=
      (congrArg γ_pre hh_1_eq).trans
        ((DFunLike.congr_fun hγ_Φ1 P_h).trans (congrArg (fun x => j_B (α_e x)) hh_e_eq.symm))
    have hUnit_γh1 : IsUnit (γ_pre h_1) := by
      rw [hγ_h1]
      exact IsUnit.map j_B (IsLocalization.Away.algebraMap_isUnit h_e)
    let γ_C1 : Localization.Away h_1 →+* Localization.Away d :=
      IsLocalization.Away.lift h_1 (g := γ_pre) hUnit_γh1
    have hγC1_eq : ∀ x, γ_C1 (α_1 x) = γ_pre x :=
      fun x => IsLocalization.Away.lift_eq h_1 (g := γ_pre) hUnit_γh1 x
    have hγC1_ψ1 : γ_C1.comp ψ_1 = j_B := by
      apply nodalAway_ringHom_ext
      · intro r
        change γ_C1 (ψ_1 (α_e (Ideal.Quotient.mk _ (MvPolynomial.C r)))) =
          j_B (α_e (Ideal.Quotient.mk _ (MvPolynomial.C r)))
        rw [hψ1_C, hγC1_eq, hγ_pre_C]
        rfl
      · change γ_C1 (ψ_1 d_0) = j_B d_0
        rw [hψ1_d0_mul, map_mul, hψ1_d2, hγC1_eq]
        change γ_pre _ * γ_C1 (α_1 (Ideal.Quotient.mk _ (MvPolynomial.X 0))) = j_B d_0
        rw [hγC1_eq, hγ_pre_C, hγ_pre_X0]
        exact hy0_rel2
      · change γ_C1 (ψ_1 d_1) = j_B d_1
        rw [hψ1_d1]
        dsimp only [v_1]
        rw [hγC1_eq, hγ_pre_X1]
    have hUnit_γψd : IsUnit (γ_C1 (ψ_1 d)) := by
      have hd_eq : γ_C1 (ψ_1 d) = j_B d := DFunLike.congr_fun hγC1_ψ1 d
      rw [hd_eq]
      exact IsLocalization.Away.algebraMap_isUnit d
    let G_d : Localization.Away (ψ_1 d) →+* Localization.Away d :=
      IsLocalization.Away.lift (ψ_1 d) (g := γ_C1) hUnit_γψd
    have hGd_eq : ∀ c, G_d (j_1 c) = γ_C1 c :=
      fun c => IsLocalization.Away.lift_eq (ψ_1 d) (g := γ_C1) hUnit_γψd c
    have hGF_d : G_d.comp F_d = RingHom.id (Localization.Away d) := by
      apply IsLocalization.ringHom_ext (Submonoid.powers d)
      ext b
      change G_d (F_d (j_B b)) = j_B b
      rw [hFd_eq, hGd_eq]
      exact DFunLike.congr_fun hγC1_ψ1 b
    have hFG_d : F_d.comp G_d = RingHom.id (Localization.Away (ψ_1 d)) := by
      apply IsLocalization.ringHom_ext (Submonoid.powers (ψ_1 d))
      have hcomp : F_d.comp γ_C1 = j_1 := by
        apply nodalAway_ringHom_ext
        · intro r
          change F_d (γ_C1 (α_1 (Ideal.Quotient.mk _ (MvPolynomial.C r)))) =
            j_1 (α_1 (Ideal.Quotient.mk _ (MvPolynomial.C r)))
          rw [hγC1_eq, hγ_pre_C]
          change F_d (j_B (α_e (Ideal.Quotient.mk _ (MvPolynomial.C r)))) = _
          rw [hFd_eq, hψ1_C]
        · change F_d (γ_C1 (α_1 (Ideal.Quotient.mk _ (MvPolynomial.X 0)))) = j_1 g_1
          rw [hγC1_eq, hγ_pre_X0]
          exact hFd_y0
        · change F_d (γ_C1 v_1) = j_1 v_1
          dsimp only [v_1]
          rw [hγC1_eq, hγ_pre_X1, hFd_eq, hψ1_d1]
      ext c
      change F_d (G_d (j_1 c)) = j_1 c
      rw [hGd_eq]
      exact DFunLike.congr_fun hcomp c
    exact isLocalization_away_of_inv d f_d F_d G_d hFd_eq hFG_d hGF_d

  have hAway_d0 := away_via_ψ0 d_0 d_2
    (mul_comm d_0 d_2)
    (hd0_mul_d1.symm.trans (mul_comm d_0 d_1))
    (by rw [hψ0_d2, ← hu0_mul_g0, hψ0_d0])

  have hAway_d1 := away_via_ψ1 d_1 d_3
    rfl
    ((mul_comm d_2 d_3).trans hd0_mul_d1.symm)
    (by rw [hψ1_d3, ← hg1_mul_v1, hψ1_d1, mul_comm g_1 v_1])

  have hAway_d2 := away_via_ψ1 d_2 d_0
    hd0_mul_d1
    (mul_comm d_2 d_0)
    hψ1_d0_mul

  have hAway_d3 := away_via_ψ0 d_3 d_1
    (hd0_mul_d1.trans (mul_comm d_3 d_2))
    (mul_comm d_3 d_1)
    hψ0_d1_mul

  
  
  
  have hShift : ∀ δ_e : R₀,
      let h_Z : Polynomial R₀ := h_01.comp (Polynomial.X - Polynomial.C δ_e)
      IsUnit (algebraMap (Polynomial R₀) (Localization.Away h_Z)
        (Polynomial.X - Polynomial.C δ_e)) ∧
      ∃ Θ_δ : Localization.Away h_01 ≃+* Localization.Away h_Z,
        (∀ r : R₀,
          Θ_δ (algebraMap (Polynomial R₀) (Localization.Away h_01) (Polynomial.C r)) =
            algebraMap (Polynomial R₀) (Localization.Away h_Z) (Polynomial.C r)) ∧
        Θ_δ (algebraMap (Polynomial R₀) (Localization.Away h_01) Polynomial.X) =
          algebraMap (Polynomial R₀) (Localization.Away h_Z)
            (Polynomial.X - Polynomial.C δ_e) := by
    intro δ_e
    dsimp only
    let s_neg : Polynomial R₀ := Polynomial.X - Polynomial.C δ_e
    let s_pos : Polynomial R₀ := Polynomial.X + Polynomial.C δ_e
    let h_Z : Polynomial R₀ := h_01.comp s_neg
    let α_Z := algebraMap (Polynomial R₀) (Localization.Away h_Z)
    have hhZ_fac : h_Z = s_neg * Q_01.comp s_neg := by
      dsimp only [h_Z]
      rw [hh_01_mul, Polynomial.mul_comp, Polynomial.X_comp]
    have hUnit_sneg : IsUnit (α_Z s_neg) := by
      have hU : IsUnit (α_Z s_neg * α_Z (Q_01.comp s_neg)) := by
        rw [← map_mul, ← hhZ_fac]
        exact IsLocalization.Away.algebraMap_isUnit h_Z
      exact isUnit_of_mul_isUnit_left hU
    have hs_neg_pos : s_neg.comp s_pos = Polynomial.X := by
      dsimp only [s_neg, s_pos]
      rw [Polynomial.sub_comp, Polynomial.X_comp, Polynomial.C_comp, add_sub_cancel_right]
    have hs_pos_neg : s_pos.comp s_neg = Polynomial.X := by
      dsimp only [s_neg, s_pos]
      rw [Polynomial.add_comp, Polynomial.X_comp, Polynomial.C_comp, sub_add_cancel]
    have hhZ_pos : h_Z.comp s_pos = h_01 := by
      dsimp only [h_Z]
      rw [Polynomial.comp_assoc, hs_neg_pos, Polynomial.comp_X]
    let φ_neg : Polynomial R₀ →+* Localization.Away h_Z := α_Z.comp s_neg.compRingHom
    have hUnit_φneg : IsUnit (φ_neg h_01) :=
      IsLocalization.Away.algebraMap_isUnit h_Z
    let F_δ : Localization.Away h_01 →+* Localization.Away h_Z :=
      IsLocalization.Away.lift h_01 (g := φ_neg) hUnit_φneg
    have hFδ_eq : ∀ p, F_δ (α_01 p) = α_Z (p.comp s_neg) :=
      fun p => IsLocalization.Away.lift_eq h_01 (g := φ_neg) hUnit_φneg p
    let φ_pos : Polynomial R₀ →+* Localization.Away h_01 := α_01.comp s_pos.compRingHom
    have hUnit_φpos : IsUnit (φ_pos h_Z) := by
      change IsUnit (α_01 (h_Z.comp s_pos))
      rw [hhZ_pos]
      exact IsLocalization.Away.algebraMap_isUnit h_01
    let G_δ : Localization.Away h_Z →+* Localization.Away h_01 :=
      IsLocalization.Away.lift h_Z (g := φ_pos) hUnit_φpos
    have hGδ_eq : ∀ p, G_δ (α_Z p) = α_01 (p.comp s_pos) :=
      fun p => IsLocalization.Away.lift_eq h_Z (g := φ_pos) hUnit_φpos p
    have hFG_δ : F_δ.comp G_δ = RingHom.id (Localization.Away h_Z) := by
      apply polyAway_ringHom_ext
      · intro r
        change F_δ (G_δ (α_Z (Polynomial.C r))) = α_Z (Polynomial.C r)
        rw [hGδ_eq, Polynomial.C_comp, hFδ_eq, Polynomial.C_comp]
      · change F_δ (G_δ (α_Z Polynomial.X)) = α_Z Polynomial.X
        rw [hGδ_eq, Polynomial.X_comp, hFδ_eq, hs_pos_neg]
    have hGF_δ : G_δ.comp F_δ = RingHom.id (Localization.Away h_01) := by
      apply polyAway_ringHom_ext
      · intro r
        change G_δ (F_δ (α_01 (Polynomial.C r))) = α_01 (Polynomial.C r)
        rw [hFδ_eq, Polynomial.C_comp, hGδ_eq, Polynomial.C_comp]
      · change G_δ (F_δ (α_01 Polynomial.X)) = α_01 Polynomial.X
        rw [hFδ_eq, Polynomial.X_comp, hGδ_eq, hs_neg_pos]
    let Θ_δ : Localization.Away h_01 ≃+* Localization.Away h_Z :=
      RingEquiv.ofRingHom F_δ G_δ hFG_δ hGF_δ
    refine ⟨hUnit_sneg, Θ_δ, ?_, ?_⟩
    · intro r
      change F_δ (α_01 (Polynomial.C r)) = α_Z (Polynomial.C r)
      rw [hFδ_eq, Polynomial.C_comp]
    · change F_δ (α_01 Polynomial.X) = α_Z s_neg
      rw [hFδ_eq, Polynomial.X_comp]

  
  
  
  have hFieldLift : ∀ (F : Type u) [Field F] (φ_B : Localization.Away h_e →+* F),
      φ_B d_2 ≠ 0 → φ_B d_3 ≠ 0 → φ_B d_0 ≠ 0 →
      ∃ φ_01 : Localization.Away h_01 →+* F,
        (φ_01.comp f₀₁).comp ψ_0 = φ_B ∧
        φ_B d_0 * φ_01 (f₀₁ g_0) = φ_B d_2 ∧
        φ_B d_2 * φ_01 (f₁₀ g_1) = φ_B d_0 := by
    intro F _ φ_B hd2_ne _hd3_ne hd0_ne
    let ι_F : R₀ →+* F :=
      (φ_B.comp α_e).comp ((Ideal.Quotient.mk (weilNodalIdeal R₀ (b' * π_tilde))).comp MvPolynomial.C)
    let u : F := φ_B d_0 * (φ_B d_2)⁻¹
    let v : F := φ_B d_2 * (φ_B d_0)⁻¹
    have huv : u * v = 1 := by
      calc (φ_B d_0 * (φ_B d_2)⁻¹) * (φ_B d_2 * (φ_B d_0)⁻¹)
          = (φ_B d_0 * (φ_B d_0)⁻¹) * (φ_B d_2 * (φ_B d_2)⁻¹) := by ring
        _ = 1 := by rw [mul_inv_cancel₀ hd0_ne, mul_inv_cancel₀ hd2_ne, one_mul]
    have hUnit_u : IsUnit u := IsUnit.of_mul_eq_one v huv
    have hπ_u : φ_B d_2 * u = φ_B d_0 := by
      calc φ_B d_2 * (φ_B d_0 * (φ_B d_2)⁻¹)
          = φ_B d_0 * (φ_B d_2 * (φ_B d_2)⁻¹) := by ring
        _ = φ_B d_0 := by rw [mul_inv_cancel₀ hd2_ne, mul_one]
    have hφB_rel : φ_B d_0 * φ_B d_1 = φ_B d_3 * φ_B d_2 := by
      rw [← map_mul, hd0_mul_d1, map_mul]
    have hb_v : φ_B d_3 * v = φ_B d_1 := by
      apply mul_left_cancel₀ hd0_ne
      calc φ_B d_0 * (φ_B d_3 * (φ_B d_2 * (φ_B d_0)⁻¹))
          = (φ_B d_3 * φ_B d_2) * (φ_B d_0 * (φ_B d_0)⁻¹) := by ring
        _ = φ_B d_0 * φ_B d_1 := by rw [mul_inv_cancel₀ hd0_ne, mul_one, ← hφB_rel]
    let β_F : Polynomial R₀ →+* F := Polynomial.eval₂RingHom ι_F u
    have hφB_mv :
        (φ_B.comp α_e).comp (Ideal.Quotient.mk (weilNodalIdeal R₀ (b' * π_tilde))) =
          MvPolynomial.eval₂Hom ι_F ![φ_B d_0, φ_B d_1] := by
      apply MvPolynomial.ringHom_ext'
      · ext r; simp [ι_F]
      · intro i; fin_cases i
        · simp only [RingHom.comp_apply, MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_X]
          rfl
        · simp only [RingHom.comp_apply, MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_X]
          rfl
    have hβF_Q01 : β_F Q_01 * v ^ D = φ_B (α_e h_e) := by
      calc β_F Q_01 * v ^ D
          = MvPolynomial.eval₂ ι_F ![ι_F π_tilde * u, ι_F b' * v] P_h :=
              hLaurent ι_F u v huv
        _ = (MvPolynomial.eval₂Hom ι_F ![φ_B d_0, φ_B d_1]) P_h := by
              change MvPolynomial.eval₂ ι_F ![φ_B d_2 * u, φ_B d_3 * v] P_h = _
              rw [hπ_u, hb_v]; rfl
        _ = ((φ_B.comp α_e).comp (Ideal.Quotient.mk _)) P_h := by rw [← hφB_mv]
        _ = φ_B (α_e h_e) := congrArg (fun x => φ_B (α_e x)) hh_e_eq.symm
    have hUnit_βF_Q01 : IsUnit (β_F Q_01) := by
      have hU : IsUnit (β_F Q_01 * v ^ D) := by
        rw [hβF_Q01]
        exact IsUnit.map φ_B (IsLocalization.Away.algebraMap_isUnit h_e)
      exact isUnit_of_mul_isUnit_left hU
    have hUnit_βF_h01 : IsUnit (β_F h_01) := by
      rw [hh_01_mul, map_mul]
      have hX : β_F Polynomial.X = u := by simp [β_F]
      rw [hX]
      exact hUnit_u.mul hUnit_βF_Q01
    let φ_01 : Localization.Away h_01 →+* F :=
      IsLocalization.Away.lift h_01 (g := β_F) hUnit_βF_h01
    have hφ01_eq : ∀ p, φ_01 (α_01 p) = β_F p :=
      fun p => IsLocalization.Away.lift_eq h_01 (g := β_F) hUnit_βF_h01 p
    have hφ01_T : φ_01 T = u := by
      dsimp only [T]; rw [hφ01_eq]; simp [β_F]
    have hφ01_C : ∀ r : R₀,
        φ_01 (α_01 (Polynomial.C r)) =
          φ_B (α_e (Ideal.Quotient.mk (weilNodalIdeal R₀ (b' * π_tilde)) (MvPolynomial.C r))) := by
      intro r; rw [hφ01_eq]; simp [β_F, ι_F]
    have hu_g0 : u * φ_01 (f₀₁ g_0) = 1 := by
      calc u * φ_01 (f₀₁ g_0) = φ_01 T * φ_01 (f₀₁ g_0) := by rw [hφ01_T]
        _ = φ_01 (T * f₀₁ g_0) := (map_mul φ_01 _ _).symm
        _ = 1 := by rw [hf01_g0, map_one]
    have hout2 : φ_B d_0 * φ_01 (f₀₁ g_0) = φ_B d_2 := by
      calc φ_B d_0 * φ_01 (f₀₁ g_0)
          = (φ_B d_2 * u) * φ_01 (f₀₁ g_0) := by rw [hπ_u]
        _ = φ_B d_2 * (u * φ_01 (f₀₁ g_0)) := mul_assoc _ _ _
        _ = φ_B d_2 := by rw [hu_g0, mul_one]
    have hout3 : φ_B d_2 * φ_01 (f₁₀ g_1) = φ_B d_0 := by
      rw [hf10_g1]
      change φ_B d_2 * φ_01 T = φ_B d_0
      rw [hφ01_T]
      exact hπ_u
    have hout1 : (φ_01.comp f₀₁).comp ψ_0 = φ_B := by
      apply nodalAway_ringHom_ext
      · intro r
        change φ_01 (f₀₁ (ψ_0 (α_e (Ideal.Quotient.mk _ (MvPolynomial.C r))))) =
          φ_B (α_e (Ideal.Quotient.mk _ (MvPolynomial.C r)))
        rw [hψ0_C, hf01_C, hφ01_C]
      · change φ_01 (f₀₁ (ψ_0 d_0)) = φ_B d_0
        rw [hψ0_d0, hf01_u0, map_mul, map_mul, hφ01_C π_tilde]
        change φ_B d_2 * φ_01 T = φ_B d_0
        rw [hφ01_T]
        exact hπ_u
      · change φ_01 (f₀₁ (ψ_0 d_1)) = φ_B d_1
        rw [hψ0_d1_mul, map_mul, map_mul, hψ0_d3, hf01_C b', hφ01_C b']
        change φ_B d_3 * φ_01 (f₀₁ g_0) = φ_B d_1
        apply mul_left_cancel₀ hd0_ne
        calc φ_B d_0 * (φ_B d_3 * φ_01 (f₀₁ g_0))
            = φ_B d_3 * (φ_B d_0 * φ_01 (f₀₁ g_0)) := by ring
          _ = φ_B d_3 * φ_B d_2 := by rw [hout2]
          _ = φ_B d_0 * φ_B d_1 := hφB_rel.symm
    exact ⟨φ_01, hout1, hout2, hout3⟩

  
  
  
  exact ⟨ψ_0, ψ_1, f₀₁, f₁₀,
    ⟨hψ0_C, hψ0_d0, hψ0_d1, hψ1_C, hψ1_d0, hψ1_d1⟩,
    ⟨hf01_C, hf01_u0, hf01_g0, hf10_C, hf10_g1, hf10_v1⟩,
    ⟨hLoc0, hLoc1, hCocycle, hGen0, hGen1, hInv⟩,
    ⟨⟨hPrime0, hAway_d0⟩, ⟨hPrime1, hAway_d1⟩, ⟨hPrime2, hAway_d2⟩, ⟨hPrime3, hAway_d3⟩⟩,
    hShift, hFieldLift⟩

theorem weil_twoChart_gluing_projProper_and_fourOpen_iso (R₀ B C₀ C₁ C₀₁ : Type u)
    [CommRing R₀] [CommRing B] [CommRing C₀] [CommRing C₁] [CommRing C₀₁]
    (φ_RB : R₀ →+* B) (ψ₀ : B →+* C₀) (ψ₁ : B →+* C₁)
    (g₀ : C₀) (g₁ : C₁) (f₀₁ : C₀ →+* C₀₁) (f₁₀ : C₁ →+* C₀₁)
    (hLoc₀ : @IsLocalization.Away C₀ _ g₀ C₀₁ _ f₀₁.toAlgebra)
    (hLoc₁ : @IsLocalization.Away C₁ _ g₁ C₀₁ _ f₁₀.toAlgebra)
    (hCocycle : f₀₁.comp ψ₀ = f₁₀.comp ψ₁)
    (hGen₀ : Subring.closure (Set.range ψ₀ ∪ {g₀}) = ⊤)
    (hGen₁ : Subring.closure (Set.range ψ₁ ∪ {g₁}) = ⊤)
    (hInv : f₁₀ g₁ * f₀₁ g₀ = 1)
    (M_cl : Set ↥(AlgebraicGeometry.Spec (CommRingCat.of B)))
    (hMod_cl : IsClosed M_cl) (d₀ d₁ d₂ d₃ : B)
    (hM_eq : M_cl = PrimeSpectrum.zeroLocus ({d₀, d₁, d₂, d₃} : Set B))
    (hOpen₀ : (∀ q : PrimeSpectrum C₁, ψ₁ d₀ ∉ q.asIdeal → g₁ ∉ q.asIdeal) ∧
      @IsLocalization.Away B _ d₀ (Localization.Away (ψ₀ d₀)) _
        ((algebraMap C₀ (Localization.Away (ψ₀ d₀))).comp ψ₀).toAlgebra)
    (hOpen₁ : (∀ q : PrimeSpectrum C₀, ψ₀ d₁ ∉ q.asIdeal → g₀ ∉ q.asIdeal) ∧
      @IsLocalization.Away B _ d₁ (Localization.Away (ψ₁ d₁)) _
        ((algebraMap C₁ (Localization.Away (ψ₁ d₁))).comp ψ₁).toAlgebra)
    (hOpen₂ : (∀ q : PrimeSpectrum C₀, ψ₀ d₂ ∉ q.asIdeal → g₀ ∉ q.asIdeal) ∧
      @IsLocalization.Away B _ d₂ (Localization.Away (ψ₁ d₂)) _
        ((algebraMap C₁ (Localization.Away (ψ₁ d₂))).comp ψ₁).toAlgebra)
    (hOpen₃ : (∀ q : PrimeSpectrum C₁, ψ₁ d₃ ∉ q.asIdeal → g₁ ∉ q.asIdeal) ∧
      @IsLocalization.Away B _ d₃ (Localization.Away (ψ₀ d₃)) _
        ((algebraMap C₀ (Localization.Away (ψ₀ d₃))).comp ψ₀).toAlgebra) :
    ∃ (U_bl : AlgebraicGeometry.Scheme.{u})
      (p_bl : U_bl ⟶ AlgebraicGeometry.Spec (CommRingCat.of B))
      (ι_0 : AlgebraicGeometry.Spec (CommRingCat.of C₀) ⟶ U_bl)
      (ι_1 : AlgebraicGeometry.Spec (CommRingCat.of C₁) ⟶ U_bl),
      AlgebraicGeometry.IsOpenImmersion ι_0 ∧
      AlgebraicGeometry.IsOpenImmersion ι_1 ∧
      Set.range ι_0.base ∪ Set.range ι_1.base = Set.univ ∧
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₀₁) ≫ ι_0 =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₁₀) ≫ ι_1 ∧
      (∀ p₀ : PrimeSpectrum C₀, ι_0.base p₀ ∈ Set.range ι_1.base ↔ g₀ ∉ p₀.asIdeal) ∧
      (∀ p₁ : PrimeSpectrum C₁, ι_1.base p₁ ∈ Set.range ι_0.base ↔ g₁ ∉ p₁.asIdeal) ∧
      ι_0 ≫ p_bl = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀) ∧
      ι_1 ≫ p_bl = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁) ∧
      AlgebraicGeometry.IsProper p_bl ∧
      CategoryTheory.IsIso
        (p_bl ∣_ (⟨M_clᶜ, hMod_cl.isOpen_compl⟩ :
          (AlgebraicGeometry.Spec (CommRingCat.of B)).Opens)) ∧
      (IsDomain C₀ → IsDomain C₁ → Nontrivial C₀₁ → AlgebraicGeometry.IsIntegral U_bl) ∧
      (AlgebraicGeometry.Flat
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ₀.comp φ_RB))) →
        AlgebraicGeometry.Flat
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ₁.comp φ_RB))) →
        AlgebraicGeometry.Flat
          (p_bl ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_RB))) ∧
      (AlgebraicGeometry.LocallyOfFinitePresentation
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ₀.comp φ_RB))) →
        AlgebraicGeometry.LocallyOfFinitePresentation
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ₁.comp φ_RB))) →
        AlgebraicGeometry.LocallyOfFinitePresentation
          (p_bl ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_RB))) :=
by
  
  have hPart1 :
      ∃ (U_bl : AlgebraicGeometry.Scheme.{u})
        (p_bl : U_bl ⟶ AlgebraicGeometry.Spec (CommRingCat.of B))
        (ι_0 : AlgebraicGeometry.Spec (CommRingCat.of C₀) ⟶ U_bl)
        (ι_1 : AlgebraicGeometry.Spec (CommRingCat.of C₁) ⟶ U_bl),
        AlgebraicGeometry.IsOpenImmersion ι_0 ∧
        AlgebraicGeometry.IsOpenImmersion ι_1 ∧
        Set.range ι_0.base ∪ Set.range ι_1.base = Set.univ ∧
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₀₁) ≫ ι_0 =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₁₀) ≫ ι_1 ∧
        (∀ p₀ : PrimeSpectrum C₀, ι_0.base p₀ ∈ Set.range ι_1.base ↔ g₀ ∉ p₀.asIdeal) ∧
        (∀ p₁ : PrimeSpectrum C₁, ι_1.base p₁ ∈ Set.range ι_0.base ↔ g₁ ∉ p₁.asIdeal) ∧
        ι_0 ≫ p_bl = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀) ∧
        ι_1 ≫ p_bl = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁) ∧
        (∀ (Y : AlgebraicGeometry.Scheme.{u})
           (k₀ : AlgebraicGeometry.Spec (CommRingCat.of C₀) ⟶ Y)
           (k₁ : AlgebraicGeometry.Spec (CommRingCat.of C₁) ⟶ Y),
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₀₁) ≫ k₀ =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₁₀) ≫ k₁ →
          ∃ k : U_bl ⟶ Y, ι_0 ≫ k = k₀ ∧ ι_1 ≫ k = k₁ ∧
            ∀ k' : U_bl ⟶ Y, ι_0 ≫ k' = k₀ → ι_1 ≫ k' = k₁ → k' = k) ∧
        (IsDomain C₀ → IsDomain C₁ → Nontrivial C₀₁ → AlgebraicGeometry.IsIntegral U_bl) ∧
        (AlgebraicGeometry.Flat
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ₀.comp φ_RB))) →
          AlgebraicGeometry.Flat
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ₁.comp φ_RB))) →
          AlgebraicGeometry.Flat
            (p_bl ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_RB))) ∧
        (AlgebraicGeometry.LocallyOfFinitePresentation
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ₀.comp φ_RB))) →
          AlgebraicGeometry.LocallyOfFinitePresentation
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ₁.comp φ_RB))) →
          AlgebraicGeometry.LocallyOfFinitePresentation
            (p_bl ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_RB))) := by
    let U₀ : Scheme.{u} := Spec (CommRingCat.of C₀)
    let U₁ : Scheme.{u} := Spec (CommRingCat.of C₁)
    let W : Scheme.{u} := Spec (CommRingCat.of C₀₁)
    let e₀₁ : W ⟶ U₀ := Spec.map (CommRingCat.ofHom f₀₁)
    let e₁₀ : W ⟶ U₁ := Spec.map (CommRingCat.ofHom f₁₀)
    have hOpen_e₀₁ : IsOpenImmersion e₀₁ := by
      let _ : Algebra C₀ C₀₁ := f₀₁.toAlgebra
      have : IsLocalization.Away g₀ C₀₁ := hLoc₀
      exact IsOpenImmersion.of_isLocalization (R := C₀) (S := C₀₁) g₀
    have hOpen_e₁₀ : IsOpenImmersion e₁₀ := by
      let _ : Algebra C₁ C₀₁ := f₁₀.toAlgebra
      have : IsLocalization.Away g₁ C₀₁ := hLoc₁
      exact IsOpenImmersion.of_isLocalization (R := C₁) (S := C₀₁) g₁
    have hRange_e₀₁ : Set.range e₀₁.base = (PrimeSpectrum.basicOpen g₀ : Set (PrimeSpectrum C₀)) := by
      let _ : Algebra C₀ C₀₁ := f₀₁.toAlgebra
      have : IsLocalization.Away g₀ C₀₁ := hLoc₀
      exact PrimeSpectrum.localization_away_comap_range C₀₁ g₀
    have hRange_e₁₀ : Set.range e₁₀.base = (PrimeSpectrum.basicOpen g₁ : Set (PrimeSpectrum C₁)) := by
      let _ : Algebra C₁ C₀₁ := f₁₀.toAlgebra
      have : IsLocalization.Away g₁ C₀₁ := hLoc₁
      exact PrimeSpectrum.localization_away_comap_range C₀₁ g₁
    let J : Type u := ULift.{u} Bool
    let U_fam : J → Scheme.{u}
      | ⟨false⟩ => U₀
      | ⟨true⟩ => U₁
    let V_fam : ∀ (i j : J), i ≠ j → Scheme.{u} := fun _ _ _ => W
    let f_fam : ∀ (i j : J) (h : i ≠ j), V_fam i j h ⟶ U_fam i
      | ⟨false⟩, ⟨true⟩, _ => e₀₁
      | ⟨true⟩, ⟨false⟩, _ => e₁₀
      | ⟨false⟩, ⟨false⟩, h => (h rfl).elim
      | ⟨true⟩, ⟨true⟩, h => (h rfl).elim
    have hf_mono : ∀ (i j : J) (h : i ≠ j), Mono (f_fam i j h) := by
      rintro ⟨_ | _⟩ ⟨_ | _⟩ h
      · exact (h rfl).elim
      · dsimp [f_fam]; exact @IsOpenImmersion.mono _ _ _ hOpen_e₀₁
      · dsimp [f_fam]; exact @IsOpenImmersion.mono _ _ _ hOpen_e₁₀
      · exact (h rfl).elim
    let G' : CategoryTheory.GlueData' Scheme.{u} :=
      CategoryTheory.GlueData'.mk J U_fam V_fam f_fam hf_mono inferInstance
        (fun _ _ _ => 𝟙 W)
        (fun i j k hij hik hjk => by
          rcases i with ⟨_ | _⟩ <;> rcases j with ⟨_ | _⟩ <;> rcases k with ⟨_ | _⟩ <;>
            exfalso <;> first | exact hij rfl | exact hik rfl | exact hjk rfl)
        (fun i j k hij hik hjk => by
          rcases i with ⟨_ | _⟩ <;> rcases j with ⟨_ | _⟩ <;> rcases k with ⟨_ | _⟩ <;>
            exfalso <;> first | exact hij rfl | exact hik rfl | exact hjk rfl)
        (fun _ _ _ => Category.id_comp (𝟙 W))
        (fun i j k hij hik hjk => by
          rcases i with ⟨_ | _⟩ <;> rcases j with ⟨_ | _⟩ <;> rcases k with ⟨_ | _⟩ <;>
            exfalso <;> first | exact hij rfl | exact hik rfl | exact hjk rfl)
    let G : CategoryTheory.GlueData Scheme.{u} := CategoryTheory.GlueData.ofGlueData' G'
    have hij01 : (⟨false⟩ : J) ≠ ⟨true⟩ := by decide
    have hij10 : (⟨true⟩ : J) ≠ ⟨false⟩ := by decide
    have hGV01 : G.V (⟨false⟩, ⟨true⟩) = W := by
      dsimp [G, CategoryTheory.GlueData.ofGlueData']
      split_ifs with h
      · exact (hij01 h).elim
      · rfl
    have hGV10 : G.V (⟨true⟩, ⟨false⟩) = W := by
      dsimp [G, CategoryTheory.GlueData.ofGlueData']
      split_ifs with h
      · exact (hij10 h).elim
      · rfl
    have hGf01 : G.f ⟨false⟩ ⟨true⟩ = eqToHom hGV01 ≫ (e₀₁ : W ⟶ G.U ⟨false⟩) := by
      dsimp [G, CategoryTheory.GlueData.ofGlueData']
      split_ifs with h
      · exact (hij01 h).elim
      · rfl
    have hGf10 : G.f ⟨true⟩ ⟨false⟩ = eqToHom hGV10 ≫ (e₁₀ : W ⟶ G.U ⟨true⟩) := by
      dsimp [G, CategoryTheory.GlueData.ofGlueData']
      split_ifs with h
      · exact (hij10 h).elim
      · rfl
    have hf_open : ∀ i j : G.J, IsOpenImmersion (G.f i j) := by
      rintro ⟨_ | _⟩ ⟨_ | _⟩
      · have := G.f_id ⟨false⟩; infer_instance
      · rw [hGf01]; have := hOpen_e₀₁; exact IsOpenImmersion.comp (eqToHom hGV01) e₀₁
      · rw [hGf10]; have := hOpen_e₁₀; exact IsOpenImmersion.comp (eqToHom hGV10) e₁₀
      · have := G.f_id ⟨true⟩; infer_instance
    let D : Scheme.GlueData :=
      { toGlueData := G
        f_open := hf_open }
    let i₀ : D.J := ⟨false⟩
    let i₁ : D.J := ⟨true⟩
    let e₀₁' : W ⟶ D.U i₀ := e₀₁
    let e₁₀' : W ⟶ D.U i₁ := e₁₀
    have hV01 : D.V (i₀, i₁) = W := hGV01
    have hV10 : D.V (i₁, i₀) = W := hGV10
    have hf01_eq : D.f i₀ i₁ = eqToHom hV01 ≫ e₀₁' := hGf01
    have hf10_eq : D.f i₁ i₀ = eqToHom hV10 ≫ e₁₀' := hGf10
    have ht01_eq : D.t i₀ i₁ = eqToHom hV01 ≫ eqToHom hV10.symm := by
      dsimp [D, G, i₀, i₁, CategoryTheory.GlueData.ofGlueData']
      split_ifs with h
      · exact (hij01 h).elim
      · exact congrArg (_ ≫ ·) (Category.id_comp _)
    have ht10_eq : D.t i₁ i₀ = eqToHom hV10 ≫ eqToHom hV01.symm := by
      dsimp [D, G, i₀, i₁, CategoryTheory.GlueData.ofGlueData']
      split_ifs with h
      · exact (hij10 h).elim
      · exact congrArg (_ ≫ ·) (Category.id_comp _)
    let U_bl : Scheme.{u} := D.glued
    let ι_0 : U₀ ⟶ U_bl := D.ι i₀
    let ι_1 : U₁ ⟶ U_bl := D.ι i₁
    have hOpen_ι0 : IsOpenImmersion ι_0 := D.ι_isOpenImmersion i₀
    have hOpen_ι1 : IsOpenImmersion ι_1 := D.ι_isOpenImmersion i₁
    have hCov : Set.range ι_0.base ∪ Set.range ι_1.base = Set.univ := by
      ext z
      simp only [Set.mem_union, Set.mem_univ, iff_true]
      have ⟨x, hx⟩ : ∃ x : ↥(D.U (D.openCover.idx z)), (D.ι (D.openCover.idx z)).base x = z :=
        D.openCover.covers z
      generalize D.openCover.idx z = idx at x hx
      rcases idx with ⟨_ | _⟩
      · exact Or.inl ⟨x, hx⟩
      · exact Or.inr ⟨x, hx⟩
    have hGlue : e₀₁ ≫ ι_0 = e₁₀ ≫ ι_1 := by
      have hgc : D.t i₁ i₀ ≫ D.f i₀ i₁ ≫ D.ι i₀ = D.f i₁ i₀ ≫ D.ι i₁ :=
        D.glue_condition i₁ i₀
      rw [ht10_eq, hf01_eq, hf10_eq] at hgc
      have hgc' : eqToHom hV10 ≫ (e₀₁' ≫ D.ι i₀) = eqToHom hV10 ≫ (e₁₀' ≫ D.ι i₁) := by
        simpa only [Category.assoc, eqToHom_trans_assoc, eqToHom_refl, Category.id_comp] using hgc
      exact (cancel_epi (eqToHom hV10)).mp hgc'
    have hOverlapRange : ∀ (i j : D.J),
        Set.range (D.f i j).base = (D.ι i).base ⁻¹' Set.range (D.ι j).base := by
      intro i j
      have : IsOpenImmersion (D.ι j) := D.ι_isOpenImmersion j
      have hPb : IsPullback (D.f i j) (D.t i j ≫ D.f j i) (D.ι i) (D.ι j) :=
        IsPullback.of_isLimit (D.vPullbackConeIsLimit i j)
      have hfac : hPb.isoPullback.hom ≫ Limits.pullback.fst (D.ι i) (D.ι j) = D.f i j :=
        hPb.isoPullback_hom_fst
      have hbij : Function.Bijective hPb.isoPullback.hom.base :=
        ConcreteCategory.bijective_of_isIso hPb.isoPullback.hom.base
      have hr1 : Set.range (D.f i j).base = Set.range (Limits.pullback.fst (D.ι i) (D.ι j)).base := by
        rw [← hfac, Scheme.Hom.comp_base, TopCat.coe_comp, Set.range_comp,
          hbij.surjective.range_eq, Set.image_univ]
      rw [hr1, IsOpenImmersion.range_pullbackFst (D.ι j) (D.ι i)]
      rfl
    have hRange₀ : ∀ p₀ : PrimeSpectrum C₀, ι_0.base p₀ ∈ Set.range ι_1.base ↔ g₀ ∉ p₀.asIdeal := by
      intro p₀
      have h01 := hOverlapRange i₀ i₁
      have hr_eq : Set.range (D.f i₀ i₁).base = Set.range e₀₁.base := by
        rw [hf01_eq]
        have hbij := ConcreteCategory.bijective_of_isIso (eqToHom hV01).base
        ext x
        constructor
        · rintro ⟨y, rfl⟩; exact ⟨(eqToHom hV01).base y, rfl⟩
        · rintro ⟨w, rfl⟩
          obtain ⟨y, hy⟩ := hbij.2 w
          refine ⟨y, ?_⟩
          change e₀₁.base ((eqToHom hV01).base y) = e₀₁.base w
          rw [hy]
      rw [hr_eq, hRange_e₀₁] at h01
      exact (Set.ext_iff.mp h01 p₀).symm
    have hRange₁ : ∀ p₁ : PrimeSpectrum C₁, ι_1.base p₁ ∈ Set.range ι_0.base ↔ g₁ ∉ p₁.asIdeal := by
      intro p₁
      have h10 := hOverlapRange i₁ i₀
      have hr_eq : Set.range (D.f i₁ i₀).base = Set.range e₁₀.base := by
        rw [hf10_eq]
        have hbij := ConcreteCategory.bijective_of_isIso (eqToHom hV10).base
        ext x
        constructor
        · rintro ⟨y, rfl⟩; exact ⟨(eqToHom hV10).base y, rfl⟩
        · rintro ⟨w, rfl⟩
          obtain ⟨y, hy⟩ := hbij.2 w
          refine ⟨y, ?_⟩
          change e₁₀.base ((eqToHom hV10).base y) = e₁₀.base w
          rw [hy]
      rw [hr_eq, hRange_e₁₀] at h10
      exact (Set.ext_iff.mp h10 p₁).symm
    have hDesc : ∀ (Y : Scheme.{u}) (k₀ : U₀ ⟶ Y) (k₁ : U₁ ⟶ Y),
        e₀₁ ≫ k₀ = e₁₀ ≫ k₁ →
        ∃ k : U_bl ⟶ Y, ι_0 ≫ k = k₀ ∧ ι_1 ≫ k = k₁ ∧
          ∀ k' : U_bl ⟶ Y, ι_0 ≫ k' = k₀ → ι_1 ≫ k' = k₁ → k' = k := by
      intro Y k₀ k₁ hk
      have : Limits.HasMulticoequalizer D.diagram := Scheme.GlueData.instHasMulticoequalizerDiagram D
      let k₀' : D.U i₀ ⟶ Y := k₀
      let k₁' : D.U i₁ ⟶ Y := k₁
      have hk' : e₀₁' ≫ k₀' = e₁₀' ≫ k₁' := hk
      let k_fam : ∀ b : (Limits.MultispanShape.prod D.J).R, D.diagram.right b ⟶ Y
        | ⟨false⟩ => k₀'
        | ⟨true⟩ => k₁'
      have hCompat : ∀ a : (Limits.MultispanShape.prod D.J).L,
          D.diagram.fst a ≫ k_fam ((Limits.MultispanShape.prod D.J).fst a) =
            D.diagram.snd a ≫ k_fam ((Limits.MultispanShape.prod D.J).snd a) := by
        rintro ⟨i, j⟩
        rcases i with ⟨_ | _⟩ <;> rcases j with ⟨_ | _⟩
        · change D.f i₀ i₀ ≫ k₀' = (D.t i₀ i₀ ≫ D.f i₀ i₀) ≫ k₀'
          rw [D.t_id i₀, Category.id_comp]
        · change D.f i₀ i₁ ≫ k₀' = (D.t i₀ i₁ ≫ D.f i₁ i₀) ≫ k₁'
          rw [ht01_eq, hf01_eq, hf10_eq]
          simp only [Category.assoc, eqToHom_trans_assoc, eqToHom_refl, Category.id_comp, hk']
        · change D.f i₁ i₀ ≫ k₁' = (D.t i₁ i₀ ≫ D.f i₀ i₁) ≫ k₀'
          rw [ht10_eq, hf01_eq, hf10_eq]
          simp only [Category.assoc, eqToHom_trans_assoc, eqToHom_refl, Category.id_comp, hk']
        · change D.f i₁ i₁ ≫ k₁' = (D.t i₁ i₁ ≫ D.f i₁ i₁) ≫ k₁'
          rw [D.t_id i₁, Category.id_comp]
      let k : U_bl ⟶ Y := Limits.Multicoequalizer.desc D.diagram Y k_fam hCompat
      refine ⟨k, Limits.Multicoequalizer.π_desc D.diagram Y k_fam hCompat ⟨false⟩,
        Limits.Multicoequalizer.π_desc D.diagram Y k_fam hCompat ⟨true⟩, ?_⟩
      intro k' hk0 hk1
      apply Limits.Multicoequalizer.hom_ext
      rintro ⟨_ | _⟩
      · exact hk0.trans (Limits.Multicoequalizer.π_desc D.diagram Y k_fam hCompat ⟨false⟩).symm
      · exact hk1.trans (Limits.Multicoequalizer.π_desc D.diagram Y k_fam hCompat ⟨true⟩).symm
    have hψ_compat : e₀₁ ≫ Spec.map (CommRingCat.ofHom ψ₀) = e₁₀ ≫ Spec.map (CommRingCat.ofHom ψ₁) := by
      dsimp [e₀₁, e₁₀]
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, hCocycle, CommRingCat.ofHom_comp, Spec.map_comp]
    obtain ⟨p_bl, hι0_p, hι1_p, _⟩ :=
      hDesc (Spec (CommRingCat.of B)) (Spec.map (CommRingCat.ofHom ψ₀)) (Spec.map (CommRingCat.ofHom ψ₁)) hψ_compat
