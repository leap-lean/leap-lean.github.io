      let u_l : ↥S₁ := ⟨d_rc l, Finset.mem_union_left _ hd_l_S0⟩
      let i_l : Fin N := idxOfS1 u_l
      have hi_l_eq : IsValDiscEq ↥R (c i_l) (π i_l) (c_0 l) (π_0 l) := hIdxOfS1_eq u_l
      have hi_l_nb : ¬ IsDiscBoundaryIdx ↥R a_opt (c i_l) (π i_l) := by
