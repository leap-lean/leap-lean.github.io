          exact ⟨⟨f_in j y, hy_mem⟩, rfl⟩
      let e_W : W_j.toScheme ≅ (D' j).toScheme :=
        AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq W_j.ι (f_in j) hRange_eq
      have he_W_fac : e_W.hom ≫ f_in j = W_j.ι :=
        AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac W_j.ι (f_in j) hRange_eq
      have h_res_eq : (ι_slice ∣_ D_B (e_idx j)) =
          (e_W.hom ≫ (hAff_D' j).isoSpec.hom) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (χ j)) ≫
            (hAff_proj ↥B₀ N_i (e_idx j)).isoSpec.inv := by
        rw [← cancel_mono (D_B (e_idx j)).ι, AlgebraicGeometry.morphismRestrict_ι,
          ← he_W_fac, CategoryTheory.Category.assoc e_W.hom, h_gl j]
        dsimp only [ψ, D_B]
        simp only [CategoryTheory.Category.assoc, (hAff_proj ↥B₀ N_i (e_idx j)).isoSpec_inv_ι]
      rw [h_res_eq]
      have : AlgebraicGeometry.IsClosedImmersion
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (χ j))) :=
        AlgebraicGeometry.IsClosedImmersion.spec_of_surjective (CommRingCat.ofHom (χ j)) (hSurj j)
      infer_instance
    have : AlgebraicGeometry.IsClosedImmersion ι_slice := hCl_slice
    have : AlgebraicGeometry.IsProper π_B := (hCoord_proj ↥B₀ N_i).1
    let h_mod : U'.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥B₀) := ι_slice ≫ π_B
    refine ⟨h_mod, inferInstance, ?_, ?_⟩
    · refine 𝒰_slice.hom_ext _ _ (fun j_cov => ?_)
      let j : ι_idx := j_cov
      change f_in j ≫ h_mod ≫
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom
              (RingHom.codRestrict ((algebraMap K F).comp V.subtype) B₀ hVB₀)) =
        f_in j ≫ U'.ι ≫ g'
      dsimp only [h_mod]
      simp only [CategoryTheory.Category.assoc]
      rw [← CategoryTheory.Category.assoc (f_in j) ι_slice, h_gl j,
        ← CategoryTheory.Category.assoc (f_in j) U'.ι,
        AlgebraicGeometry.Scheme.homOfLE_ι C' (le_iSup D' j)]
      rw [← cancel_epi (hAff_D' j).isoSpec.inv]
      dsimp only [ψ]
      simp only [CategoryTheory.Category.assoc]
      rw [← CategoryTheory.Category.assoc (hAff_D' j).isoSpec.inv (hAff_D' j).isoSpec.hom,
        Iso.inv_hom_id, CategoryTheory.Category.id_comp,
        ← CategoryTheory.Category.assoc (hAff_D' j).isoSpec.inv (D' j).ι,
        (hAff_D' j).isoSpec_inv_ι,
        ← CategoryTheory.Category.assoc (hAff_proj ↥B₀ N_i (e_idx j)).fromSpec π_B,
        ← (hCoord_proj ↥B₀ N_i).2.2.1 (e_idx j),
        ← hCommP', ← CategoryTheory.Category.assoc (hAff_D' j).fromSpec ιP',
        h_fromSpec_pre ιP' (hAff_proj ↥V M (idx j)) (hAff_D' j),
        CategoryTheory.Category.assoc, ← (hCoord_proj ↥V M).2.2.1 (idx j),
        ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
        ← AlgebraicGeometry.Spec.map_comp]
      congr 1
      ext y
      exact congrArg (fun u => u y) (hχ_V j)
    · intro η_U' hηU'
      obtain ⟨φ'_emp, _, hφ'_emp⟩ := hFunc' (D' j_emp) (hAff_D' j_emp) (hne_idx j_emp)
      have hη_eq : η_U' =
          AlgebraicGeometry.Spec.map φ'_emp ≫ (hAff_D' j_emp).isoSpec.inv ≫ f_in j_emp := by
        rw [← cancel_mono U'.ι, hηU']
        simp only [CategoryTheory.Category.assoc]
        rw [AlgebraicGeometry.Scheme.homOfLE_ι C' (le_iSup D' j_emp),
          (hAff_D' j_emp).isoSpec_inv_ι, hφ'_emp]
      dsimp only [h_mod]
      rw [hη_eq]
      simp only [CategoryTheory.Category.assoc]
      rw [← CategoryTheory.Category.assoc (f_in j_emp) ι_slice, h_gl j_emp]
      dsimp only [ψ]
      simp only [CategoryTheory.Category.assoc]
      rw [← CategoryTheory.Category.assoc (hAff_D' j_emp).isoSpec.inv (hAff_D' j_emp).isoSpec.hom,
        Iso.inv_hom_id, CategoryTheory.Category.id_comp,
        ← (hCoord_proj ↥B₀ N_i).2.2.1 (e_idx j_emp),
        ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
      congr 1
      ext x
      exact congrArg (fun u => u x) (hχ_F j_emp (hAff_D' j_emp) φ'_emp hφ'_emp)
  exact ⟨h_goal1, h_s2, h_s34⟩

theorem weil_segre_slice_valuation_cover_and_generic_pullbacks (K : Type u) [Field K]
    (V : ValuationSubring K)
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (n : ℕ)
    (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (hIntCK : AlgebraicGeometry.IsIntegral C_K)
    (F : Type u) [Field F] [Algebra K F]
    (η_F : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ C_K)
    (hηF_comm : η_F ≫ p_K = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K F)))
    (hFuncF : IsSchemeFunctionField C_K F η_F)
    (hSmPoles : HasSmoothCurveLocalRegularityAndOverringOpen C_K F η_F)
    (s₀ : ↥V)
    (hs₀ : s₀ ≠ 0)
    (hLocV : @IsLocalization.Away _ _ s₀ K _ V.subtype.toAlgebra)
    (C₀ : AlgebraicGeometry.Scheme.{u})
    (g₀ : C₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (τ₀ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C₀))
    (ι₀ : C_K ⟶ C₀)
    (hMod₀ : IsValuationPointedCurveModel V p_K n σ_K C₀ g₀ τ₀ ι₀)
    (M₀ : ℕ)
    (ιP₀ : C₀ ⟶ (weilProjectiveSpaceOver ↥V M₀).left)
    (hAff_proj : ∀ (R : Type u) [CommRing R] (N : ℕ) (a : Fin (N + 1)),
      AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen R N a))
    (c_proj : ∀ (R : Type u) [CommRing R] (N : ℕ) (a : Fin (N + 1)),
      R →+* ↑((weilProjectiveSpaceOver R N).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen R N a))))
    (t_proj : ∀ (R : Type u) [CommRing R] (N : ℕ) (a : Fin (N + 1)), Fin (N + 1) →
      ↑((weilProjectiveSpaceOver R N).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen R N a))))
    (hCoord_proj : ∀ (R : Type u) [CommRing R] (N : ℕ),
      IsCommRingProjCoordSystem R N (hAff_proj R N) (c_proj R N) (t_proj R N))
    (ξ : Fin (M₀ + 1) → F)
    (hC₀K_charts : ∀ r : Fin (M₀ + 1),
      let C₀_r : C₀.Opens :=
        (TopologicalSpace.Opens.map ιP₀.base).obj (weilProjBasicOpen ↥V M₀ r)
      let V_Kr : C_K.Opens :=
        (TopologicalSpace.Opens.map (ι₀ ≫ ιP₀).base).obj (weilProjBasicOpen ↥V M₀ r)
      AlgebraicGeometry.IsAffineOpen C₀_r ∧
      AlgebraicGeometry.IsAffineOpen V_Kr ∧
      (Nonempty ↥C₀_r ↔ ξ r ≠ 0) ∧
      (Nonempty ↥V_Kr ↔ ξ r ≠ 0) ∧
      (ξ r ≠ 0 →
        (∀ (hC₀r : AlgebraicGeometry.IsAffineOpen C₀_r)
            (φ₀ : C₀.presheaf.obj (Opposite.op C₀_r) ⟶ CommRingCat.of F),
          AlgebraicGeometry.Spec.map φ₀ ≫ hC₀r.fromSpec = η_F ≫ ι₀ →
          (∀ s : Fin (M₀ + 1),
            φ₀.hom ((ιP₀.app (weilProjBasicOpen ↥V M₀ r)).hom (t_proj ↥V M₀ r s)) =
              ξ s / ξ r) ∧
          Set.range φ₀.hom =
            (Subring.closure
              (Set.range ((algebraMap K F).comp V.subtype) ∪
                Set.range (fun s : Fin (M₀ + 1) => ξ s / ξ r)) : Set F)) ∧
        (∀ (hVKr : AlgebraicGeometry.IsAffineOpen V_Kr)
            (φ_K : C_K.presheaf.obj (Opposite.op V_Kr) ⟶ CommRingCat.of F),
          AlgebraicGeometry.Spec.map φ_K ≫ hVKr.fromSpec = η_F →
          Set.range φ_K.hom =
            (Subring.closure
              (Set.range (algebraMap K F) ∪
                Set.range (fun s : Fin (M₀ + 1) => ξ s / ξ r)) : Set F))))
    (r₀ : ℕ)
    (r_idx : Fin r₀ → Fin (M₀ + 1))
    (B : Fin r₀ → Subring F)
    (hVB : ∀ (i : Fin r₀) (y : ↥V), ((algebraMap K F).comp V.subtype) y ∈ B i)
    (G : Fin r₀ → Finset F)
    (hξ_ne : ∀ i : Fin r₀, ξ (r_idx i) ≠ 0)
    (hξ_mem : ∀ (i : Fin r₀) (s : Fin (M₀ + 1)), ξ s / ξ (r_idx i) ∈ B i)
    (hG_mem : ∀ (i : Fin r₀) (g : F), g ∈ G i → g ∈ B i ∧ g ≠ 0)
    (hB_gen : ∀ i : Fin r₀,
      Subring.closure
        (Set.range ((algebraMap K F).comp V.subtype) ∪
          Set.range (fun s : Fin (M₀ + 1) => ξ s / ξ (r_idx i)) ∪
          (G i : Set F)) = B i)
    (hRZ_cov : ∀ (W : ValuationSubring F),
      (∀ y : ↥V, ((algebraMap K F).comp V.subtype) y ∈ W) →
      ∃ i : Fin r₀, (B i : Set F) ⊆ (W : Set F))
    (L : ℕ) [DecidableEq F]
    (f : Fin L → F)
    (hf_ne : ∀ γ : Fin L, f γ ≠ 0)
    (hG_sub : ∀ (i : Fin r₀) (g : F), g ∈ G i → ∃ γ : Fin L, f γ = g)
    (M : ℕ)
    (eSeg : Fin (M + 1) ≃ Fin (M₀ + 1) × Finset (Fin L))
    (Ψ_K : C_K ⟶ (weilProjectiveSpaceOver K M).left)
    (hSegK : IsSegreGenericClosedImmersion C_K p_K η_F M₀ ξ
      (fun r => (TopologicalSpace.Opens.map (ι₀ ≫ ιP₀).base).obj
        (weilProjBasicOpen ↥V M₀ r))
      L f M eSeg (t_proj K M) Ψ_K)
    (Φ_KV : (weilProjectiveSpaceOver K M).left ⟶ (weilProjectiveSpaceOver ↥V M).left)
    (hBase_KV : IsCommRingProjBaseChange ↥V K V.subtype M
      (c_proj ↥V M) (t_proj ↥V M) (c_proj K M) (t_proj K M) Φ_KV)
    (C' : AlgebraicGeometry.Scheme.{u})
    (g' : C' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (τ' : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C'))
    (ι' : C_K ⟶ C')
    (ιP' : C' ⟶ (weilProjectiveSpaceOver ↥V M).left)
    (hMod' : IsValuationPointedCurveModel V p_K n σ_K C' g' τ' ι')
    (hFunc' : IsSchemeFunctionField C' F (η_F ≫ ι'))
    (hCommP' : ιP' ≫ (weilProjectiveSpaceOver ↥V M).hom = g')
    (hιP'_eq : ι' ≫ ιP' = Ψ_K ≫ Φ_KV)
    (hC'_seg : ∀ α : Fin (M + 1),
      let C'_α : C'.Opens :=
        (TopologicalSpace.Opens.map ιP'.base).obj (weilProjBasicOpen ↥V M α)
      AlgebraicGeometry.IsAffineOpen C'_α ∧
      (Nonempty ↥C'_α →
        ξ (eSeg α).1 ≠ 0 ∧
        ∀ (hC' : AlgebraicGeometry.IsAffineOpen C'_α)
            (φ' : C'.presheaf.obj (Opposite.op C'_α) ⟶ CommRingCat.of F),
          AlgebraicGeometry.Spec.map φ' ≫ hC'.fromSpec = η_F ≫ ι' →
          ∀ β : Fin (M + 1),
            φ'.hom ((ιP'.app (weilProjBasicOpen ↥V M α)).hom (t_proj ↥V M α β)) =
              (ξ (eSeg β).1 / ξ (eSeg α).1) *
                (∏ γ ∈ (eSeg β).2 \ (eSeg α).2, f γ) *
                (∏ γ ∈ (eSeg α).2 \ (eSeg β).2, (f γ)⁻¹)))
    (U_slice : Fin r₀ → C'.Opens)
    (hU_def : ∀ i : Fin r₀,
      U_slice i = ⨆ J₀ : {J : Finset (Fin L) //
          Disjoint J (Finset.univ.filter (fun γ : Fin L => f γ ∈ G i))},
        (TopologicalSpace.Opens.map ιP'.base).obj
          (weilProjBasicOpen ↥V M (eSeg.symm (r_idx i, J₀.1))))
    (h_slice : ∀ i : Fin r₀,
      (U_slice i).toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥(B i)))
    (h_slice_comm : ∀ i : Fin r₀,
      h_slice i ≫ AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom
          (RingHom.codRestrict ((algebraMap K F).comp V.subtype) (B i) (hVB i))) =
        (U_slice i).ι ≫ g')
    (h_slice_gen : ∀ (i : Fin r₀)
        (η_U : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (U_slice i).toScheme),
      η_U ≫ (U_slice i).ι = η_F ≫ ι' →
      η_U ≫ h_slice i = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (B i).subtype)) :
    ((⋃ i : Fin r₀, (U_slice i : Set C')) = Set.univ) ∧
    (∀ i : Fin r₀, Nonempty ↥(U_slice i) →
      let U_K : C_K.Opens := (TopologicalSpace.Opens.map ι'.base).obj (U_slice i)
      let η_V := AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)
      ∃ (ι_U' : U_K.toScheme ⟶ (U_slice i).toScheme),
        ι_U' ≫ (U_slice i).ι = U_K.ι ≫ ι' ∧
        CategoryTheory.IsPullback ι_U' (U_K.ι ≫ p_K) ((U_slice i).ι ≫ g') η_V ∧
        CategoryTheory.IsPullback (ι_U' ≫ h_slice i) (U_K.ι ≫ p_K)
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom
              (RingHom.codRestrict ((algebraMap K F).comp V.subtype) (B i) (hVB i))))
          η_V) :=
by
  refine ⟨?_, ?_⟩
  · apply Set.eq_univ_iff_forall.mpr
    intro z
    have hProjCov : (⨆ a : Fin (M + 1), weilProjBasicOpen ↥V M a) = ⊤ :=
      (hCoord_proj ↥V M).2.1
    have hProjInter : ∀ a a' : Fin (M + 1),
        (weilProjectiveSpaceOver ↥V M).left.basicOpen (t_proj ↥V M a a') =
          weilProjBasicOpen ↥V M a ⊓ weilProjBasicOpen ↥V M a' :=
      (hCoord_proj ↥V M).2.2.2.2.2.2.2.1
    have hz_top : ιP'.base z ∈ (⊤ : (weilProjectiveSpaceOver ↥V M).left.Opens) := trivial
    rw [← hProjCov, TopologicalSpace.Opens.mem_iSup] at hz_top
    obtain ⟨α₁, hz_α₁⟩ := hz_top
    let C'_α₁ : C'.Opens := (TopologicalSpace.Opens.map ιP'.base).obj (weilProjBasicOpen ↥V M α₁)
    have hz_C₁ : z ∈ C'_α₁ := hz_α₁
    have hne₁ : Nonempty ↥C'_α₁ := ⟨⟨z, hz_C₁⟩⟩
    have hAff₁ : AlgebraicGeometry.IsAffineOpen C'_α₁ := (hC'_seg α₁).1
    have hξ_s₁ : ξ (eSeg α₁).1 ≠ 0 := ((hC'_seg α₁).2 hne₁).1
    have hRatio₁ := ((hC'_seg α₁).2 hne₁).2
    obtain ⟨φ'₁, hFrac₁, hφ'₁_comm⟩ := hFunc' C'_α₁ hAff₁ hne₁
    let R₁ : Type u := ↑(C'.presheaf.obj (Opposite.op C'_α₁))
    let v_mor : CommRingCat.of ↥V ⟶ C'.presheaf.obj (Opposite.op C'_α₁) :=
      AlgebraicGeometry.Spec.preimage (hAff₁.fromSpec ≫ g')
    have hComm_g' : ι' ≫ g' = p_K ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype) :=
      hMod'.2.2.2.2.2.2.2.1.w
    have hv_comm_spec :
        AlgebraicGeometry.Spec.map (v_mor ≫ φ'₁) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((algebraMap K F).comp V.subtype)) := by
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        ← Category.assoc, hφ'₁_comm, Category.assoc, hComm_g', ← Category.assoc,
        hηF_comm, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    have hv_comm : v_mor ≫ φ'₁ = CommRingCat.ofHom ((algebraMap K F).comp V.subtype) :=
      AlgebraicGeometry.Spec.map_injective hv_comm_spec
    have hv_eval : ∀ y : ↥V, φ'₁.hom (v_mor.hom y) = ((algebraMap K F).comp V.subtype) y := by
      intro y
      exact congrArg (fun ψ => ψ.hom y) hv_comm
    have hz_range : z ∈ Set.range hAff₁.fromSpec.base := by
      rw [hAff₁.range_fromSpec]
      exact hz_C₁
    obtain ⟨q_z_raw, hq_z⟩ := hz_range
    let q_z : PrimeSpectrum R₁ := q_z_raw
    let A_z := Localization.AtPrime q_z.asIdeal
    let _ : Algebra R₁ F := φ'₁.hom.toAlgebra
    have hφ_inj : Function.Injective φ'₁.hom :=
      @IsFractionRing.injective R₁ _ F _ _ hFrac₁
    have h_units : ∀ y : q_z.asIdeal.primeCompl, IsUnit (φ'₁.hom y.1) := by
      intro y
      have hy0 : (y.1 : R₁) ≠ 0 := by
        intro h0
        exact y.2 (h0 ▸ q_z.asIdeal.zero_mem)
      have hφy0 : φ'₁.hom y.1 ≠ 0 := by
        intro h0
        apply hy0
        apply hφ_inj
        simpa using h0
      exact hφy0.isUnit
    let φ_tilde : A_z →+* F :=
      IsLocalization.lift (M := q_z.asIdeal.primeCompl) (S := A_z) h_units
    obtain ⟨W_z, hW_mem, hLoc_ψ⟩ := IsLocalRing.exists_factor_valuationRing φ_tilde
    let ψ_z : A_z →+* ↥W_z := φ_tilde.codRestrict W_z.toSubring hW_mem
    have _ : IsLocalHom ψ_z := hLoc_ψ
    have hφ_mem_W : ∀ r : R₁, φ'₁.hom r ∈ W_z := by
      intro r
      have heq : φ'₁.hom r = φ_tilde (algebraMap R₁ A_z r) :=
        (IsLocalization.lift_eq (M := q_z.asIdeal.primeCompl) (S := A_z) h_units r).symm
      rw [heq]
      exact hW_mem (algebraMap R₁ A_z r)
    have hV_mem_W : ∀ y : ↥V, ((algebraMap K F).comp V.subtype) y ∈ W_z := by
      intro y
      rw [← hv_eval y]
      exact hφ_mem_W (v_mor.hom y)
    obtain ⟨i, hBi_W⟩ := hRZ_cov W_z hV_mem_W
    let I_i : Finset (Fin L) := Finset.univ.filter (fun γ : Fin L => f γ ∈ G i)
    let P_pole : Fin L → Prop := fun γ => γ ∉ I_i ∧ f γ ∉ W_z
    let J₀ : Finset (Fin L) :=
      @Finset.filter (Fin L) P_pole (Classical.decPred P_pole) Finset.univ
    have hDisj : Disjoint J₀ I_i := by
      rw [Finset.disjoint_left]
      intro γ hγJ hγI
      have hP : P_pole γ :=
        ((@Finset.mem_filter (Fin L) P_pole (Classical.decPred P_pole) Finset.univ γ).mp hγJ).2
      exact hP.1 hγI
    let β₀ : Fin (M + 1) := eSeg.symm (r_idx i, J₀)
    have heSeg_β₀ : eSeg β₀ = (r_idx i, J₀) := Equiv.apply_symm_apply eSeg (r_idx i, J₀)
    let u : R₁ := (ιP'.app (weilProjBasicOpen ↥V M α₁)).hom (t_proj ↥V M α₁ β₀)
    have hu_ratio : φ'₁.hom u =
        (ξ (r_idx i) / ξ (eSeg α₁).1) *
          (∏ γ ∈ J₀ \ (eSeg α₁).2, f γ) *
          (∏ γ ∈ (eSeg α₁).2 \ J₀, (f γ)⁻¹) := by
      have h_raw := hRatio₁ hAff₁ φ'₁ hφ'₁_comm β₀
      simpa only [u, heSeg_β₀] using h_raw
    have hu_ne : φ'₁.hom u ≠ 0 := by
      rw [hu_ratio]
      refine mul_ne_zero (mul_ne_zero (div_ne_zero (hξ_ne i) hξ_s₁) ?_) ?_
      · rw [Finset.prod_ne_zero_iff]
        intro γ _
        exact hf_ne γ
      · rw [Finset.prod_ne_zero_iff]
        intro γ _
        exact inv_ne_zero (hf_ne γ)
    have hu_inv_eq : (φ'₁.hom u)⁻¹ =
        (ξ (eSeg α₁).1 / ξ (r_idx i)) *
          (∏ γ ∈ J₀ \ (eSeg α₁).2, (f γ)⁻¹) *
          (∏ γ ∈ (eSeg α₁).2 \ J₀, f γ) := by
      rw [hu_ratio, mul_inv, mul_inv, inv_div, ← Finset.prod_inv_distrib,
        ← Finset.prod_inv_distrib]
      simp only [inv_inv]
    have hu_inv_mem : (φ'₁.hom u)⁻¹ ∈ W_z := by
      rw [hu_inv_eq]
      refine W_z.toSubring.mul_mem (W_z.toSubring.mul_mem ?_ ?_) ?_
      · exact hBi_W (hξ_mem i (eSeg α₁).1)
      · refine Subring.prod_mem W_z.toSubring ?_
        intro γ hγ
        have hγJ : γ ∈ J₀ := (Finset.mem_sdiff.mp hγ).1
        have hP : P_pole γ :=
          ((@Finset.mem_filter (Fin L) P_pole (Classical.decPred P_pole) Finset.univ γ).mp hγJ).2
        rcases ValuationSubring.mem_or_inv_mem W_z (f γ) with hmem | hinv
        · exact False.elim (hP.2 hmem)
        · exact hinv
      · refine Subring.prod_mem W_z.toSubring ?_
        intro γ hγ
        have hγ_notJ : γ ∉ J₀ := (Finset.mem_sdiff.mp hγ).2
        have h_notP : ¬ P_pole γ := by
          intro hP
          apply hγ_notJ
          exact (@Finset.mem_filter (Fin L) P_pole (Classical.decPred P_pole) Finset.univ γ).mpr
            ⟨Finset.mem_univ γ, hP⟩
        by_cases hγI : γ ∈ I_i
