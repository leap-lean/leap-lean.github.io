          ≤ 1 * ‖(w : F_hat) - (w₀ : F_hat)‖ :=
            mul_le_mul hc_le (h_pow_lip (w₀ : F_hat) (w : F_hat) hw₀_le hw_le (i : ℕ))
              (norm_nonneg _) zero_le_one
        _ = ‖(w : F_hat) - (w₀ : F_hat)‖ := one_mul _
    exact h_ultra_unit _ _ hS₂_norm (hS₂_S₃.trans_lt hw_dist)
  have hModEt₂ := h_s4 L₂ hFin₂ g₂ w hg₂_monic hg₂_deg hw_root hw_deriv' hw_indep
  exact ⟨hFin₂, hModEt₂.1, hModEt₂.2⟩

theorem weil_one_dim_separable_dense_subfield_approx (K_hat F_hat : Type u)
    [NontriviallyNormedField K_hat] [CompleteSpace K_hat]
    [IsUltrametricDist K_hat] [IsAlgClosed K_hat]
    [NontriviallyNormedField F_hat] [CompleteSpace F_hat]
    [IsUltrametricDist F_hat] [Algebra K_hat F_hat]
    (hIsoK : ∀ c : K_hat, ‖algebraMap K_hat F_hat c‖ = ‖c‖)
    (y₀ z : F_hat)
    (hz : z ∉ Set.range (algebraMap K_hat F_hat))
    (hy₀_fin :
      let Ly₀ : Subfield F_hat :=
        (IntermediateField.adjoin K_hat ({y₀} : Set F_hat)).toSubfield.topologicalClosure
      letI : Algebra ↥Ly₀ F_hat := Ly₀.toAlgebra
      FiniteDimensional ↥Ly₀ F_hat) :
    ∃ w₀ : F_hat,
      w₀ ∉ Set.range (algebraMap K_hat F_hat) ∧
      w₀ ∈ (IntermediateField.adjoin K_hat ({z} : Set F_hat)).toSubfield.topologicalClosure ∧
      ∀ δ : ℝ, 0 < δ →
        ∃ w' : F_hat,
          ‖w₀ - w'‖ < δ ∧
          (w' ∉ Set.range (algebraMap K_hat F_hat) →
            let Lw' : Subfield F_hat :=
              (IntermediateField.adjoin K_hat ({w'} : Set F_hat)).toSubfield.topologicalClosure
            letI : Algebra ↥Lw' F_hat := Lw'.toAlgebra
            FiniteDimensional ↥Lw' F_hat) :=
by
  obtain ⟨c₀, hc₀⟩ := NormedField.exists_one_lt_norm K_hat
  have hιc₀ : 1 < ‖algebraMap K_hat F_hat c₀‖ := by rwa [hIsoK c₀]

  
  have h_aeval_ne_zero : ∀ (x : F_hat), x ∉ Set.range (algebraMap K_hat F_hat) →
      ∀ (R : Polynomial K_hat), R ≠ 0 → Polynomial.aeval x R ≠ 0 := by
    intro x hx R hR
    obtain ⟨m, hm⟩ := Polynomial.splits_iff_exists_multiset.mp (IsAlgClosed.splits R)
    rw [hm, map_mul, Polynomial.aeval_C]
    have hlc : algebraMap K_hat F_hat R.leadingCoeff ≠ 0 := by
      rw [← norm_ne_zero_iff, hIsoK, norm_ne_zero_iff]
      exact Polynomial.leadingCoeff_ne_zero.mpr hR
    have hm_nz : Polynomial.aeval x (m.map (fun a => Polynomial.X - Polynomial.C a)).prod ≠ 0 := by
      clear hm
      induction m using Multiset.induction_on with
      | empty => simp
      | cons a s ih =>
        simp only [Multiset.map_cons, Multiset.prod_cons, map_mul, map_sub,
          Polynomial.aeval_X, Polynomial.aeval_C]
        refine mul_ne_zero ?_ ih
        intro h0
        exact hx ⟨a, (sub_eq_zero.mp h0).symm⟩
    exact mul_ne_zero hlc hm_nz

  
  have h_ultra_eq : ∀ {G : Type u} [NormedAddCommGroup G] [IsUltrametricDist G]
      (A B : G), ‖B‖ < ‖A‖ → ‖A + B‖ = ‖A‖ := by
    intro G _ _ A B hlt
    have hne : ‖A‖₊ ≠ ‖B‖₊ := fun heq =>
      ne_of_gt hlt (congrArg (fun t : NNReal => (t : ℝ)) heq)
    exact (congrArg (fun t : NNReal => (t : ℝ))
      (IsUltrametricDist.nnnorm_add_eq_max_of_nnnorm_ne_nnnorm hne)).trans
      (max_eq_left (le_of_lt hlt))

  have h_ultra_sum : ∀ {G : Type u} [SeminormedAddCommGroup G] [IsUltrametricDist G]
      (n : ℕ) (f : ℕ → G) (B : ℝ),
      0 ≤ B → (∀ i ∈ Finset.range n, ‖f i‖ ≤ B) → ‖∑ i ∈ Finset.range n, f i‖ ≤ B := by
    intro G _ _ n f B hB hf
    induction n with
    | zero =>
      rw [Finset.range_zero, Finset.sum_empty, norm_zero]
      exact hB
    | succ n ih =>
      rw [Finset.sum_range_succ]
      exact (IsUltrametricDist.norm_add_le_max _ _).trans
        (max_le (ih (fun i hi => hf i (Finset.mem_range.mpr (Nat.lt_succ_of_lt (Finset.mem_range.mp hi)))))
          (hf n (Finset.mem_range.mpr (Nat.lt_succ_self n))))

  let K₀_if : IntermediateField K_hat F_hat := IntermediateField.adjoin K_hat ({y₀} : Set F_hat)
  let K₀ : Subfield F_hat := K₀_if.toSubfield
  let Ly₀ : Subfield F_hat := K₀.topologicalClosure

  
  
  
  have hPart1 : ∃ (E_sep : Subfield F_hat) (w₀ : F_hat) (hLy₀E : Ly₀ ≤ E_sep),
      IsClosed (E_sep : Set F_hat) ∧
      (let _ : Algebra ↥Ly₀ ↥E_sep := (Subfield.inclusion hLy₀E).toAlgebra
       FiniteDimensional ↥Ly₀ ↥E_sep ∧ Algebra.IsSeparable ↥Ly₀ ↥E_sep) ∧
      (let _ : Algebra ↥E_sep F_hat := E_sep.toAlgebra
       FiniteDimensional ↥E_sep F_hat) ∧
      w₀ ∈ E_sep ∧
      w₀ ∉ Set.range (algebraMap K_hat F_hat) ∧
      w₀ ∈ (IntermediateField.adjoin K_hat ({z} : Set F_hat)).toSubfield.topologicalClosure := by
    let _ : Algebra ↥Ly₀ F_hat := Ly₀.toAlgebra
    have _ : FiniteDimensional ↥Ly₀ F_hat := hy₀_fin
    have hCl_Ly₀ : IsClosed (Ly₀ : Set F_hat) := Subfield.isClosed_topologicalClosure K₀
    have _ : CompleteSpace ↥Ly₀ := @IsClosed.completeSpace_coe _ _ _ _ hCl_Ly₀
    have hc₀_Ly₀ : algebraMap K_hat F_hat c₀ ∈ Ly₀ :=
      Subfield.le_topologicalClosure K₀ (K₀_if.algebraMap_mem c₀)
    let _ : NontriviallyNormedField ↥Ly₀ :=
      { (inferInstance : NormedField ↥Ly₀) with
        non_trivial := ⟨⟨algebraMap K_hat F_hat c₀, hc₀_Ly₀⟩, hιc₀⟩ }
    have _ : ContinuousSMul ↥Ly₀ F_hat :=
      ContinuousSMul.mk (continuous_subtype_val.fst'.mul continuous_snd)
    let E_if : IntermediateField ↥Ly₀ F_hat := separableClosure ↥Ly₀ F_hat
    let E_sep : Subfield F_hat := E_if.toSubfield
    have hLy₀E : Ly₀ ≤ E_sep := fun x hx => E_if.algebraMap_mem ⟨x, hx⟩
    have hFin_Ly₀_Eif : FiniteDimensional ↥Ly₀ ↥E_if := FiniteDimensional.left ↥Ly₀ ↥E_if F_hat
    have hFin_E_F : (let _ : Algebra ↥E_sep F_hat := E_sep.toAlgebra; FiniteDimensional ↥E_sep F_hat) :=
      FiniteDimensional.right ↥Ly₀ ↥E_if F_hat
    have hSep_Ly₀_Eif : Algebra.IsSeparable ↥Ly₀ ↥E_if := separableClosure.isSeparable ↥Ly₀ F_hat
    have hCl_E : IsClosed (E_sep : Set F_hat) := by
      have _ : FiniteDimensional ↥Ly₀ ↥E_if.toSubmodule := hFin_Ly₀_Eif
      exact Submodule.closed_of_finiteDimensional E_if.toSubmodule
    have _ : Algebra.IsAlgebraic ↥Ly₀ F_hat := Algebra.IsAlgebraic.of_finite ↥Ly₀ F_hat
    have _ : IsPurelyInseparable ↥E_if F_hat := separableClosure.isPurelyInseparable ↥Ly₀ F_hat
    obtain ⟨q, _⟩ := ExpChar.exists ↥E_if
    have hq_pos : 0 < q := expChar_pos ↥E_if q
    obtain ⟨m_exp, hm_exp⟩ := IsPurelyInseparable.pow_mem ↥E_if q z
    let N_exp : ℕ := q ^ m_exp
    have hN_pos : 0 < N_exp := pow_pos hq_pos m_exp
    let w₀ : F_hat := z ^ N_exp
    have hw₀_E : w₀ ∈ E_sep := by
      obtain ⟨u, hu⟩ := hm_exp
      change z ^ q ^ m_exp ∈ E_sep
      rw [← hu]
      exact u.2
    have hw₀_Lz : w₀ ∈ (IntermediateField.adjoin K_hat ({z} : Set F_hat)).toSubfield.topologicalClosure :=
      Subfield.le_topologicalClosure _
        (pow_mem (IntermediateField.mem_adjoin_simple_self K_hat z) N_exp)
    have hw₀_not : w₀ ∉ Set.range (algebraMap K_hat F_hat) := by
      rintro ⟨c, hc⟩
      let R : Polynomial K_hat := Polynomial.X ^ N_exp - Polynomial.C c
      have hR_monic : R.Monic := Polynomial.monic_X_pow_sub_C c (ne_of_gt hN_pos)
      have haev : Polynomial.aeval z R = 0 := by
        simp only [R, map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C]
        change w₀ - algebraMap K_hat F_hat c = 0
        rw [hc, sub_self]
      exact h_aeval_ne_zero z hz R hR_monic.ne_zero haev
    exact ⟨E_sep, w₀, hLy₀E, hCl_E, ⟨hFin_Ly₀_Eif, hSep_Ly₀_Eif⟩, hFin_E_F,
      hw₀_E, hw₀_not, hw₀_Lz⟩

  obtain ⟨E_sep, w₀, hLy₀E, hCl_E, hFinSep_E, hFin_E_F, hw₀_E, hw₀_not, hw₀_Lz⟩ := hPart1
  have hK₀E : K₀ ≤ E_sep := (Subfield.le_topologicalClosure K₀).trans hLy₀E

  
  
  
  have hPart2 : ∃ (θ_tilde : F_hat) (P_tilde_K : Polynomial ↥K₀),
      θ_tilde ∈ E_sep ∧
      P_tilde_K.Monic ∧
      (let _ : Algebra ↥K₀ F_hat := K₀.toAlgebra; Polynomial.aeval θ_tilde P_tilde_K = 0) ∧
      (∀ u ∈ E_sep, ∀ ε : ℝ, 0 < ε →
        ∃ v ∈ IntermediateField.adjoin K_hat ({y₀, θ_tilde} : Set F_hat), ‖u - v‖ < ε) := by
    let _ : Algebra ↥Ly₀ ↥E_sep := (Subfield.inclusion hLy₀E).toAlgebra
    have _ : FiniteDimensional ↥Ly₀ ↥E_sep := hFinSep_E.1
    have _ : Algebra.IsSeparable ↥Ly₀ ↥E_sep := hFinSep_E.2
    have hCl_Ly₀ : IsClosed (Ly₀ : Set F_hat) := Subfield.isClosed_topologicalClosure K₀
    have _ : CompleteSpace ↥Ly₀ := @IsClosed.completeSpace_coe _ _ _ _ hCl_Ly₀
    have hc₀_Ly₀ : algebraMap K_hat F_hat c₀ ∈ Ly₀ :=
      Subfield.le_topologicalClosure K₀ (K₀_if.algebraMap_mem c₀)
    let _ : NontriviallyNormedField ↥Ly₀ :=
      { (inferInstance : NormedField ↥Ly₀) with
        non_trivial := ⟨⟨algebraMap K_hat F_hat c₀, hc₀_Ly₀⟩, hιc₀⟩ }
    have _ : CompleteSpace ↥E_sep := @IsClosed.completeSpace_coe _ _ _ _ hCl_E
    have _ : IsUltrametricDist ↥E_sep :=
      ⟨fun x y w => IsUltrametricDist.dist_triangle_max (x : F_hat) (y : F_hat) (w : F_hat)⟩
    have _ : ContinuousSMul ↥Ly₀ ↥E_sep :=
      ContinuousSMul.mk (by
        have h : Continuous (fun p : ↥Ly₀ × ↥E_sep => ((p.1 : F_hat) * (p.2 : F_hat))) :=
          (continuous_subtype_val.comp continuous_fst).mul (continuous_subtype_val.comp continuous_snd)
        exact h.subtype_mk _)
    have h_nat_norm_E : ∀ n : ℕ, ‖(n : ↥E_sep)‖ ≤ 1 := by
      intro n
      induction n with
      | zero => simp
      | succ n ih =>
        push_cast
        exact (IsUltrametricDist.norm_add_le_max _ _).trans (max_le ih (by simp))

    obtain ⟨θ, hθ_prim⟩ := Field.exists_primitive_element ↥Ly₀ ↥E_sep
    have hθ_int : IsIntegral ↥Ly₀ θ := Algebra.IsIntegral.isIntegral θ
    let P : Polynomial ↥Ly₀ := minpoly ↥Ly₀ θ
    let d : ℕ := P.natDegree
    have hP_monic : P.Monic := minpoly.monic hθ_int
    have hP_sep : P.Separable := Algebra.IsSeparable.isSeparable ↥Ly₀ θ
    have hP_aeval : Polynomial.aeval θ P = 0 := minpoly.aeval ↥Ly₀ θ
    have hP'_ne : Polynomial.aeval θ P.derivative ≠ 0 :=
      hP_sep.aeval_derivative_ne_zero hP_aeval

    let j_Ly₀ : ↥Ly₀ →+* ↥E_sep := algebraMap ↥Ly₀ ↥E_sep
    let P_E : Polynomial ↥E_sep := P.map j_Ly₀
    have hPE_eval : P_E.eval θ = 0 := by
      rw [Polynomial.eval_map, ← Polynomial.aeval_def]
      exact hP_aeval
    have hPE'_ne : P_E.derivative.eval θ ≠ 0 := by
      rw [Polynomial.derivative_map, Polynomial.eval_map, ← Polynomial.aeval_def]
      exact hP'_ne

    let c_coeff : ℕ → ↥E_sep := fun i => j_Ly₀ (P.coeff i)
    have hPE_sum : P_E = ∑ i ∈ Finset.range (d + 1), Polynomial.C (c_coeff i) * Polynomial.X ^ i := by
      dsimp only [P_E]
      conv_lhs => rw [Polynomial.as_sum_range_C_mul_X_pow P]
      simp only [d, Polynomial.map_sum, Polynomial.map_mul, Polynomial.map_C,
        Polynomial.map_pow, Polynomial.map_X, c_coeff]

    let μ : ℝ := ‖P_E.derivative.eval θ‖
    have hμ_pos : 0 < μ := norm_pos_iff.mpr hPE'_ne
    let R_θ : ℝ := max 1 ‖θ‖
    have hR_ge_one : 1 ≤ R_θ := le_max_left 1 ‖θ‖
    have hR_pos : 0 < R_θ := lt_of_lt_of_le zero_lt_one hR_ge_one
    have hθ_le_R : ‖θ‖ ≤ R_θ := le_max_right 1 ‖θ‖
    let M_const : ℝ := 1 + ∑ i ∈ Finset.range (d + 1), (‖c_coeff i‖ + 1) * R_θ ^ i
    have hM_sum_nonneg : 0 ≤ ∑ i ∈ Finset.range (d + 1), (‖c_coeff i‖ + 1) * R_θ ^ i :=
      Finset.sum_nonneg fun i _ =>
        mul_nonneg (add_nonneg (norm_nonneg _) zero_le_one) (pow_nonneg (le_of_lt hR_pos) i)
    have hM_pos : 0 < M_const := lt_of_lt_of_le zero_lt_one (le_add_of_nonneg_right hM_sum_nonneg)
    let ρ : ℝ := min (1 / 2) (μ / (2 * M_const))
    have hρ_pos : 0 < ρ := lt_min (by norm_num) (div_pos hμ_pos (by positivity))
    have hρ_half : ρ ≤ 1 / 2 := min_le_left _ _
    have hMρ_le : M_const * ρ ≤ μ / 2 := by
      have h1 : ρ ≤ μ / (2 * M_const) := min_le_right _ _
      calc M_const * ρ ≤ M_const * (μ / (2 * M_const)) :=
            mul_le_mul_of_nonneg_left h1 (le_of_lt hM_pos)
        _ = μ / 2 := by
            have hne : M_const ≠ 0 := ne_of_gt hM_pos
            field_simp
    let ε_approx : ℝ := min 1 (μ * ρ / (2 * R_θ ^ d))
    have hε_pos : 0 < ε_approx :=
      lt_min zero_lt_one (div_pos (mul_pos hμ_pos hρ_pos) (mul_pos (by norm_num) (pow_pos hR_pos d)))
    have hε_le_one : ε_approx ≤ 1 := min_le_left _ _
    have hεR_le : ε_approx * R_θ ^ d ≤ μ * ρ / 2 := by
      have h1 : ε_approx ≤ μ * ρ / (2 * R_θ ^ d) := min_le_right _ _
      calc ε_approx * R_θ ^ d ≤ (μ * ρ / (2 * R_θ ^ d)) * R_θ ^ d :=
            mul_le_mul_of_nonneg_right h1 (pow_nonneg (le_of_lt hR_pos) d)
        _ = μ * ρ / 2 := by
            have hne : R_θ ^ d ≠ 0 := ne_of_gt (pow_pos hR_pos d)
            field_simp

    let B_ρ : Set ↥E_sep := Metric.closedBall θ ρ
    have h_ball_norm : ∀ u ∈ B_ρ, ‖u - θ‖ ≤ ρ ∧ ‖u‖ ≤ R_θ := by
      intro u hu
      rw [Metric.mem_closedBall, dist_eq_norm] at hu
      refine ⟨hu, ?_⟩
      have hid : u = (u - θ) + θ := by ring
      rw [hid]
      exact (IsUltrametricDist.norm_add_le_max _ _).trans
        (max_le (hu.trans (hρ_half.trans (by linarith))) hθ_le_R)

    have h_pow_sub : ∀ (u : ↥E_sep), u ∈ B_ρ → ∀ k : ℕ, ‖u ^ k - θ ^ k‖ ≤ ρ * R_θ ^ k := by
      intro u hu k
      obtain ⟨hu_sub, hu_R⟩ := h_ball_norm u hu
      induction k with
      | zero =>
        simp only [pow_zero, sub_self, norm_zero, mul_one]
        exact le_of_lt hρ_pos
      | succ k ih =>
        have hid : u ^ (k + 1) - θ ^ (k + 1) = u * (u ^ k - θ ^ k) + (u - θ) * θ ^ k := by ring
        rw [hid]
        refine (IsUltrametricDist.norm_add_le_max _ _).trans (max_le ?_ ?_)
        · rw [norm_mul]
          calc ‖u‖ * ‖u ^ k - θ ^ k‖ ≤ R_θ * (ρ * R_θ ^ k) :=
                mul_le_mul hu_R ih (norm_nonneg _) (le_of_lt hR_pos)
            _ = ρ * R_θ ^ (k + 1) := by ring
        · rw [norm_mul, norm_pow]
          calc ‖u - θ‖ * ‖θ‖ ^ k ≤ ρ * R_θ ^ k :=
                mul_le_mul hu_sub (pow_le_pow_left₀ (norm_nonneg _) hθ_le_R k)
                  (pow_nonneg (norm_nonneg _) k) (le_of_lt hρ_pos)
            _ = (ρ * R_θ ^ k) * 1 := (mul_one _).symm
            _ ≤ (ρ * R_θ ^ k) * R_θ :=
                mul_le_mul_of_nonneg_left hR_ge_one
                  (mul_nonneg (le_of_lt hρ_pos) (pow_nonneg (le_of_lt hR_pos) k))
            _ = ρ * R_θ ^ (k + 1) := by ring

    have h_monom_deriv : ∀ (u : ↥E_sep), u ∈ B_ρ → ∀ i : ℕ,
        ‖((Polynomial.X ^ i : Polynomial ↥E_sep).derivative).eval u -
          ((Polynomial.X ^ i : Polynomial ↥E_sep).derivative).eval θ‖ ≤ ρ * R_θ ^ i := by
      intro u hu i
      rcases i with _ | m
      · simp only [pow_zero, Polynomial.derivative_one, Polynomial.eval_zero, sub_self, norm_zero,
          mul_one]
        exact le_of_lt hρ_pos
      · rw [Polynomial.derivative_X_pow]
        simp only [Nat.add_sub_cancel, Polynomial.eval_mul, Polynomial.eval_C,
          Polynomial.eval_pow, Polynomial.eval_X]
        rw [← mul_sub, norm_mul]
        calc ‖((m + 1 : ℕ) : ↥E_sep)‖ * ‖u ^ m - θ ^ m‖
            ≤ 1 * (ρ * R_θ ^ m) :=
              mul_le_mul (h_nat_norm_E (m + 1)) (h_pow_sub u hu m) (norm_nonneg _) zero_le_one
          _ = (ρ * R_θ ^ m) * 1 := by ring
          _ ≤ (ρ * R_θ ^ m) * R_θ :=
              mul_le_mul_of_nonneg_left hR_ge_one
                (mul_nonneg (le_of_lt hρ_pos) (pow_nonneg (le_of_lt hR_pos) m))
          _ = ρ * R_θ ^ (m + 1) := by ring

    have h_monom_lin : ∀ (u₁ u₂ : ↥E_sep), u₁ ∈ B_ρ → u₂ ∈ B_ρ → ∀ i : ℕ,
        ‖(u₂ ^ i - u₁ ^ i) -
          (((Polynomial.X ^ i : Polynomial ↥E_sep).derivative).eval θ) * (u₂ - u₁)‖ ≤
          ρ * R_θ ^ i * ‖u₂ - u₁‖ := by
      intro u₁ u₂ hu₁ hu₂ i
      obtain ⟨_, hu₁_R⟩ := h_ball_norm u₁ hu₁
      obtain ⟨hu₂_sub, hu₂_R⟩ := h_ball_norm u₂ hu₂
      rcases i with _ | m
      · simp only [pow_zero, sub_self, Polynomial.derivative_one, Polynomial.eval_zero, zero_mul,
          norm_zero]
        exact mul_nonneg (mul_nonneg (le_of_lt hρ_pos) (by simp)) (norm_nonneg _)
      · have hrec : ∀ k : ℕ,
            ‖(u₂ ^ (k + 1) - u₁ ^ (k + 1)) - ((k + 1 : ℕ) : ↥E_sep) * θ ^ k * (u₂ - u₁)‖ ≤
              ρ * R_θ ^ (k + 1) * ‖u₂ - u₁‖ := by
          intro k
          induction k with
          | zero =>
            have h0 : (u₂ ^ 1 - u₁ ^ 1) - ((1 : ℕ) : ↥E_sep) * θ ^ 0 * (u₂ - u₁) = 0 := by
              push_cast
              ring
            rw [h0, norm_zero]
            exact mul_nonneg (mul_nonneg (le_of_lt hρ_pos) (pow_nonneg (le_of_lt hR_pos) 1))
              (norm_nonneg _)
          | succ k ih =>
            have hid : (u₂ ^ (k + 2) - u₁ ^ (k + 2)) -
                ((k + 2 : ℕ) : ↥E_sep) * θ ^ (k + 1) * (u₂ - u₁) =
                u₂ * ((u₂ ^ (k + 1) - u₁ ^ (k + 1)) -
                  ((k + 1 : ℕ) : ↥E_sep) * θ ^ k * (u₂ - u₁)) +
                (((k + 1 : ℕ) : ↥E_sep) * (u₂ - θ) * θ ^ k * (u₂ - u₁) +
                  (u₁ ^ (k + 1) - θ ^ (k + 1)) * (u₂ - u₁)) := by
              push_cast
              ring
            rw [hid]
            refine (IsUltrametricDist.norm_add_le_max _ _).trans (max_le ?_ ?_)
            · rw [norm_mul]
              calc ‖u₂‖ * ‖(u₂ ^ (k + 1) - u₁ ^ (k + 1)) -
                      ((k + 1 : ℕ) : ↥E_sep) * θ ^ k * (u₂ - u₁)‖
                  ≤ R_θ * (ρ * R_θ ^ (k + 1) * ‖u₂ - u₁‖) :=
                    mul_le_mul hu₂_R ih (norm_nonneg _) (le_of_lt hR_pos)
                _ = ρ * R_θ ^ (k + 2) * ‖u₂ - u₁‖ := by ring
            · refine (IsUltrametricDist.norm_add_le_max _ _).trans (max_le ?_ ?_)
              · rw [norm_mul, norm_mul, norm_mul, norm_pow]
                have h1 : ‖((k + 1 : ℕ) : ↥E_sep)‖ * ‖u₂ - θ‖ * ‖θ‖ ^ k ≤ ρ * R_θ ^ k := by
                  calc ‖((k + 1 : ℕ) : ↥E_sep)‖ * ‖u₂ - θ‖ * ‖θ‖ ^ k
                      ≤ 1 * ρ * R_θ ^ k :=
                        mul_le_mul (mul_le_mul (h_nat_norm_E (k + 1)) hu₂_sub (norm_nonneg _)
                          zero_le_one)
                          (pow_le_pow_left₀ (norm_nonneg _) hθ_le_R k)
                          (pow_nonneg (norm_nonneg _) k)
                          (mul_nonneg zero_le_one (le_of_lt hρ_pos))
                    _ = ρ * R_θ ^ k := by ring
                have h2 : ρ * R_θ ^ k ≤ ρ * R_θ ^ (k + 2) := by
                  have hR2 : 1 ≤ R_θ ^ 2 := one_le_pow₀ hR_ge_one
                  calc ρ * R_θ ^ k = (ρ * R_θ ^ k) * 1 := (mul_one _).symm
                    _ ≤ (ρ * R_θ ^ k) * R_θ ^ 2 :=
                        mul_le_mul_of_nonneg_left hR2
                          (mul_nonneg (le_of_lt hρ_pos) (pow_nonneg (le_of_lt hR_pos) k))
                    _ = ρ * R_θ ^ (k + 2) := by ring
                exact mul_le_mul_of_nonneg_right (h1.trans h2) (norm_nonneg _)
              · rw [norm_mul]
                have h1 := h_pow_sub u₁ hu₁ (k + 1)
                have h2 : ρ * R_θ ^ (k + 1) ≤ ρ * R_θ ^ (k + 2) := by
                  calc ρ * R_θ ^ (k + 1) = (ρ * R_θ ^ (k + 1)) * 1 := (mul_one _).symm
                    _ ≤ (ρ * R_θ ^ (k + 1)) * R_θ :=
                        mul_le_mul_of_nonneg_left hR_ge_one
                          (mul_nonneg (le_of_lt hρ_pos) (pow_nonneg (le_of_lt hR_pos) (k + 1)))
                    _ = ρ * R_θ ^ (k + 2) := by ring
                exact mul_le_mul_of_nonneg_right (h1.trans h2) (norm_nonneg _)
        rw [Polynomial.derivative_X_pow]
        simp only [Nat.add_sub_cancel, Polynomial.eval_mul, Polynomial.eval_C,
          Polynomial.eval_pow, Polynomial.eval_X]
        exact hrec m

    have h_poly_bounds : ∀ (a : ℕ → ↥E_sep),
        (∀ i ∈ Finset.range (d + 1), ‖a i‖ ≤ ‖c_coeff i‖ + 1) →
        let Q : Polynomial ↥E_sep := ∑ i ∈ Finset.range (d + 1), Polynomial.C (a i) * Polynomial.X ^ i
        (∀ u₁ u₂ : ↥E_sep, u₁ ∈ B_ρ → u₂ ∈ B_ρ →
          ‖Q.eval u₂ - Q.eval u₁ - (Q.derivative.eval θ) * (u₂ - u₁)‖ ≤ (μ / 2) * ‖u₂ - u₁‖) ∧
        (∀ u : ↥E_sep, u ∈ B_ρ →
          ‖Q.derivative.eval u - Q.derivative.eval θ‖ ≤ μ / 2) := by
      intro a ha Q
      have hQ_deriv : Q.derivative =
          ∑ i ∈ Finset.range (d + 1),
            Polynomial.C (a i) * (Polynomial.X ^ i : Polynomial ↥E_sep).derivative := by
        dsimp only [Q]
        rw [Polynomial.derivative_sum]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [Polynomial.derivative_mul, Polynomial.derivative_C, zero_mul, zero_add]
      refine ⟨?_, ?_⟩
      · intro u₁ u₂ hu₁ hu₂
        have hid : Q.eval u₂ - Q.eval u₁ - (Q.derivative.eval θ) * (u₂ - u₁) =
            ∑ i ∈ Finset.range (d + 1),
              a i * ((u₂ ^ i - u₁ ^ i) -
                (((Polynomial.X ^ i : Polynomial ↥E_sep).derivative).eval θ) * (u₂ - u₁)) := by
          dsimp only [Q]
          rw [hQ_deriv]
          simp only [Polynomial.eval_finsetSum, Polynomial.eval_mul, Polynomial.eval_C,
            Polynomial.eval_pow, Polynomial.eval_X, Finset.sum_mul, ← Finset.sum_sub_distrib]
          refine Finset.sum_congr rfl fun i _ => ?_
          ring
        rw [hid]
        calc ‖∑ i ∈ Finset.range (d + 1),
                a i * ((u₂ ^ i - u₁ ^ i) -
                  (((Polynomial.X ^ i : Polynomial ↥E_sep).derivative).eval θ) * (u₂ - u₁))‖
            ≤ ∑ i ∈ Finset.range (d + 1),
                ‖a i * ((u₂ ^ i - u₁ ^ i) -
                  (((Polynomial.X ^ i : Polynomial ↥E_sep).derivative).eval θ) * (u₂ - u₁))‖ :=
              norm_sum_le _ _
          _ ≤ ∑ i ∈ Finset.range (d + 1),
                ((‖c_coeff i‖ + 1) * R_θ ^ i) * (ρ * ‖u₂ - u₁‖) := by
              refine Finset.sum_le_sum fun i hi => ?_
              rw [norm_mul]
              calc ‖a i‖ * ‖(u₂ ^ i - u₁ ^ i) -
                      (((Polynomial.X ^ i : Polynomial ↥E_sep).derivative).eval θ) * (u₂ - u₁)‖
                  ≤ (‖c_coeff i‖ + 1) * (ρ * R_θ ^ i * ‖u₂ - u₁‖) :=
                    mul_le_mul (ha i hi) (h_monom_lin u₁ u₂ hu₁ hu₂ i) (norm_nonneg _)
                      (add_nonneg (norm_nonneg _) zero_le_one)
                _ = ((‖c_coeff i‖ + 1) * R_θ ^ i) * (ρ * ‖u₂ - u₁‖) := by ring
          _ = (∑ i ∈ Finset.range (d + 1), (‖c_coeff i‖ + 1) * R_θ ^ i) * (ρ * ‖u₂ - u₁‖) :=
              (Finset.sum_mul _ _ _).symm
          _ ≤ M_const * (ρ * ‖u₂ - u₁‖) := by
              refine mul_le_mul_of_nonneg_right ?_ (mul_nonneg (le_of_lt hρ_pos) (norm_nonneg _))
              dsimp only [M_const]
              linarith
          _ = (M_const * ρ) * ‖u₂ - u₁‖ := by ring
          _ ≤ (μ / 2) * ‖u₂ - u₁‖ := mul_le_mul_of_nonneg_right hMρ_le (norm_nonneg _)
      · intro u hu
        have hid : Q.derivative.eval u - Q.derivative.eval θ =
            ∑ i ∈ Finset.range (d + 1),
              a i * (((Polynomial.X ^ i : Polynomial ↥E_sep).derivative).eval u -
                ((Polynomial.X ^ i : Polynomial ↥E_sep).derivative).eval θ) := by
          rw [hQ_deriv]
          simp only [Polynomial.eval_finsetSum, Polynomial.eval_mul, Polynomial.eval_C,
            ← Finset.sum_sub_distrib, ← mul_sub]
        rw [hid]
        calc ‖∑ i ∈ Finset.range (d + 1),
                a i * (((Polynomial.X ^ i : Polynomial ↥E_sep).derivative).eval u -
                  ((Polynomial.X ^ i : Polynomial ↥E_sep).derivative).eval θ)‖
            ≤ ∑ i ∈ Finset.range (d + 1),
                ‖a i * (((Polynomial.X ^ i : Polynomial ↥E_sep).derivative).eval u -
                  ((Polynomial.X ^ i : Polynomial ↥E_sep).derivative).eval θ)‖ :=
              norm_sum_le _ _
          _ ≤ ∑ i ∈ Finset.range (d + 1), ((‖c_coeff i‖ + 1) * R_θ ^ i) * ρ := by
              refine Finset.sum_le_sum fun i hi => ?_
              rw [norm_mul]
              calc ‖a i‖ * ‖((Polynomial.X ^ i : Polynomial ↥E_sep).derivative).eval u -
                      ((Polynomial.X ^ i : Polynomial ↥E_sep).derivative).eval θ‖
                  ≤ (‖c_coeff i‖ + 1) * (ρ * R_θ ^ i) :=
                    mul_le_mul (ha i hi) (h_monom_deriv u hu i) (norm_nonneg _)
                      (add_nonneg (norm_nonneg _) zero_le_one)
                _ = ((‖c_coeff i‖ + 1) * R_θ ^ i) * ρ := by ring
          _ = (∑ i ∈ Finset.range (d + 1), (‖c_coeff i‖ + 1) * R_θ ^ i) * ρ :=
              (Finset.sum_mul _ _ _).symm
          _ ≤ M_const * ρ := by
              refine mul_le_mul_of_nonneg_right ?_ (le_of_lt hρ_pos)
              dsimp only [M_const]
              linarith
          _ ≤ μ / 2 := hMρ_le

    
    have h_approx_c : ∀ i : ℕ, ∃ y : ↥K₀, ‖(y : F_hat) - ((P.coeff i : ↥Ly₀) : F_hat)‖ < ε_approx := by
      intro i
      have hmem : ((P.coeff i : ↥Ly₀) : F_hat) ∈ closure (K₀ : Set F_hat) := (P.coeff i).2
      obtain ⟨y, hy, hdist⟩ := Metric.mem_closure_iff.mp hmem ε_approx hε_pos
      rw [dist_eq_norm, norm_sub_rev] at hdist
      exact ⟨⟨y, hy⟩, hdist⟩
    choose c_tilde hc_tilde using h_approx_c

    let P_tilde_K : Polynomial ↥K₀ :=
      Polynomial.X ^ d + ∑ i ∈ Finset.range d, Polynomial.C (c_tilde i) * Polynomial.X ^ i
    have hP_tilde_monic : P_tilde_K.Monic := by
      refine Polynomial.monic_X_pow_add ?_
      rw [Polynomial.degree_lt_iff_coeff_zero]
      intro m hm
      rw [Polynomial.finsetSum_coeff]
      refine Finset.sum_eq_zero fun i hi => ?_
      rw [Finset.mem_range] at hi
      rw [Polynomial.coeff_C_mul_X_pow, ite_eq_right_iff.mpr (fun h => absurd h (by omega))]

    let j_K₀E : ↥K₀ →+* ↥E_sep := Subfield.inclusion hK₀E
    let P_tilde_E : Polynomial ↥E_sep := P_tilde_K.map j_K₀E
    let a_tilde : ℕ → ↥E_sep := fun i => if i < d then j_K₀E (c_tilde i) else 1
    have hP_tilde_sum : P_tilde_E =
        ∑ i ∈ Finset.range (d + 1), Polynomial.C (a_tilde i) * Polynomial.X ^ i := by
      dsimp only [P_tilde_E, P_tilde_K]
      rw [Polynomial.map_add, Polynomial.map_pow, Polynomial.map_X, Polynomial.map_sum,
        Finset.sum_range_succ]
      simp only [lt_self_iff_false, ↓reduceIte, a_tilde, Polynomial.C_1, one_mul]
      rw [add_comm]
      congr 1
      refine Finset.sum_congr rfl fun i hi => ?_
      rw [Finset.mem_range] at hi
      simp only [hi, ↓reduceIte, Polynomial.map_mul, Polynomial.map_C, Polynomial.map_pow,
        Polynomial.map_X]

    have ha_tilde_sub : ∀ i ∈ Finset.range d, ‖a_tilde i - c_coeff i‖ ≤ ε_approx := by
      intro i hi
      rw [Finset.mem_range] at hi
      simp only [a_tilde, hi, ↓reduceIte, c_coeff]
      exact le_of_lt (hc_tilde i)
    have ha_tilde_bound : ∀ i ∈ Finset.range (d + 1), ‖a_tilde i‖ ≤ ‖c_coeff i‖ + 1 := by
      intro i hi
      rw [Finset.mem_range_succ_iff] at hi
      rcases lt_or_eq_of_le hi with hlt | rfl
      · have hsub := ha_tilde_sub i (Finset.mem_range.mpr hlt)
        have htri : ‖a_tilde i‖ ≤ ‖c_coeff i‖ + ‖a_tilde i - c_coeff i‖ := by
          have hid : a_tilde i = c_coeff i + (a_tilde i - c_coeff i) := by ring
          conv_lhs => rw [hid]
          exact norm_add_le (c_coeff i) (a_tilde i - c_coeff i)
        linarith
      · simp only [a_tilde, lt_self_iff_false, ↓reduceIte, norm_one]
        exact le_add_of_nonneg_left (norm_nonneg _)
    have hc_coeff_bound : ∀ i ∈ Finset.range (d + 1), ‖c_coeff i‖ ≤ ‖c_coeff i‖ + 1 :=
      fun i _ => le_add_of_nonneg_right zero_le_one

    have hP_tilde_lin := (h_poly_bounds a_tilde ha_tilde_bound).1
    rw [← hP_tilde_sum] at hP_tilde_lin
    have hPE_bounds := h_poly_bounds c_coeff hc_coeff_bound
    rw [← hPE_sum] at hPE_bounds

    have ha_tilde_d : a_tilde d = c_coeff d := by
      simp only [a_tilde, lt_self_iff_false, ↓reduceIte, c_coeff]
      have hd_one : P.coeff d = 1 := hP_monic.coeff_natDegree
      rw [hd_one, map_one]

    have hP_tilde_at_θ : ‖P_tilde_E.eval θ‖ ≤ μ * ρ / 2 := by
      have hid : P_tilde_E.eval θ = P_tilde_E.eval θ - P_E.eval θ := by rw [hPE_eval, sub_zero]
      have hdiff : P_tilde_E.eval θ - P_E.eval θ =
          ∑ i ∈ Finset.range d, (a_tilde i - c_coeff i) * θ ^ i := by
        rw [hP_tilde_sum, hPE_sum]
        simp only [Polynomial.eval_finsetSum, Polynomial.eval_mul, Polynomial.eval_C,
          Polynomial.eval_pow, Polynomial.eval_X]
        rw [Finset.sum_range_succ, Finset.sum_range_succ, ha_tilde_d,
          add_sub_add_right_eq_sub, ← Finset.sum_sub_distrib]
        refine Finset.sum_congr rfl fun i _ => (sub_mul _ _ _).symm
      rw [hid, hdiff]
      refine (h_ultra_sum d _ (ε_approx * R_θ ^ d)
        (mul_nonneg (le_of_lt hε_pos) (pow_nonneg (le_of_lt hR_pos) d)) ?_).trans hεR_le
      intro i hi
      rw [Finset.mem_range] at hi
      rw [norm_mul, norm_pow]
      have hpow : ‖θ‖ ^ i ≤ R_θ ^ d :=
        (pow_le_pow_left₀ (norm_nonneg _) hθ_le_R i).trans
          (pow_le_pow_right₀ hR_ge_one (le_of_lt hi))
      exact mul_le_mul (ha_tilde_sub i (Finset.mem_range.mpr hi)) hpow
        (pow_nonneg (norm_nonneg _) i) (le_of_lt hε_pos)

    have hP_tilde'_diff : ‖P_tilde_E.derivative.eval θ - P_E.derivative.eval θ‖ ≤ μ * ρ / 2 := by
      have hdiff : P_tilde_E.derivative.eval θ - P_E.derivative.eval θ =
          ∑ i ∈ Finset.range d,
            (a_tilde i - c_coeff i) * ((Polynomial.X ^ i : Polynomial ↥E_sep).derivative).eval θ := by
        rw [hP_tilde_sum, hPE_sum, Polynomial.derivative_sum, Polynomial.derivative_sum]
        simp only [Polynomial.derivative_mul, Polynomial.derivative_C, zero_mul, zero_add,
          Polynomial.eval_finsetSum, Polynomial.eval_mul, Polynomial.eval_C]
        rw [Finset.sum_range_succ, Finset.sum_range_succ, ha_tilde_d,
          add_sub_add_right_eq_sub, ← Finset.sum_sub_distrib]
        refine Finset.sum_congr rfl fun i _ => (sub_mul _ _ _).symm
      rw [hdiff]
      refine (h_ultra_sum d _ (ε_approx * R_θ ^ d)
        (mul_nonneg (le_of_lt hε_pos) (pow_nonneg (le_of_lt hR_pos) d)) ?_).trans hεR_le
      intro i hi
      rw [Finset.mem_range] at hi
      rw [norm_mul]
      have hder_le : ‖((Polynomial.X ^ i : Polynomial ↥E_sep).derivative).eval θ‖ ≤ R_θ ^ d := by
        rcases i with _ | m
        · simp only [pow_zero, Polynomial.derivative_one, Polynomial.eval_zero, norm_zero]
          exact pow_nonneg (le_of_lt hR_pos) d
        · rw [Polynomial.derivative_X_pow]
          simp only [Nat.add_sub_cancel, Polynomial.eval_mul, Polynomial.eval_C,
            Polynomial.eval_pow, Polynomial.eval_X, norm_mul, norm_pow]
          calc ‖((m + 1 : ℕ) : ↥E_sep)‖ * ‖θ‖ ^ m
              ≤ 1 * R_θ ^ m :=
                mul_le_mul (h_nat_norm_E (m + 1))
                  (pow_le_pow_left₀ (norm_nonneg _) hθ_le_R m)
                  (pow_nonneg (norm_nonneg _) m) zero_le_one
            _ = R_θ ^ m := one_mul _
            _ ≤ R_θ ^ d := pow_le_pow_right₀ hR_ge_one (by omega)
      exact mul_le_mul (ha_tilde_sub i (Finset.mem_range.mpr hi)) hder_le
        (norm_nonneg _) (le_of_lt hε_pos)

    let D₁ : ↥E_sep := P_tilde_E.derivative.eval θ
    have hD₁_norm : ‖D₁‖ = μ := by
      have hlt : ‖D₁ - P_E.derivative.eval θ‖ < ‖P_E.derivative.eval θ‖ := by
        change ‖P_tilde_E.derivative.eval θ - P_E.derivative.eval θ‖ < μ
        calc ‖P_tilde_E.derivative.eval θ - P_E.derivative.eval θ‖ ≤ μ * ρ / 2 := hP_tilde'_diff
          _ ≤ μ * (1 / 2) / 2 := by
              have := mul_le_mul_of_nonneg_left hρ_half (le_of_lt hμ_pos)
              linarith
          _ < μ := by linarith
      have hid : D₁ = P_E.derivative.eval θ + (D₁ - P_E.derivative.eval θ) := by ring
      rw [hid, h_ultra_eq _ _ hlt]
    have hD₁_ne : D₁ ≠ 0 := norm_ne_zero_iff.mp (by rw [hD₁_norm]; exact ne_of_gt hμ_pos)

    
    let Φ₁ : ↥E_sep → ↥E_sep := fun u => u - (P_tilde_E.eval u) / D₁
    have hΦ₁_lip : ∀ u₁ u₂ : ↥E_sep, u₁ ∈ B_ρ → u₂ ∈ B_ρ →
        ‖Φ₁ u₂ - Φ₁ u₁‖ ≤ (1 / 2 : ℝ) * ‖u₂ - u₁‖ := by
      intro u₁ u₂ hu₁ hu₂
      have hid : Φ₁ u₂ - Φ₁ u₁ =
          -(P_tilde_E.eval u₂ - P_tilde_E.eval u₁ - D₁ * (u₂ - u₁)) / D₁ := by
        dsimp only [Φ₁]
        field_simp
        ring
      rw [hid, norm_div, norm_neg, hD₁_norm]
      calc ‖P_tilde_E.eval u₂ - P_tilde_E.eval u₁ - D₁ * (u₂ - u₁)‖ / μ
          ≤ ((μ / 2) * ‖u₂ - u₁‖) / μ :=
            div_le_div_of_nonneg_right (hP_tilde_lin u₁ u₂ hu₁ hu₂) (le_of_lt hμ_pos)
        _ = (1 / 2 : ℝ) * ‖u₂ - u₁‖ := by
            have hne : μ ≠ 0 := ne_of_gt hμ_pos
            field_simp
    have hθ_mem_B : θ ∈ B_ρ := Metric.mem_closedBall_self (le_of_lt hρ_pos)
    have hΦ₁_maps : Set.MapsTo Φ₁ B_ρ B_ρ := by
      intro u hu
      have h1 := hΦ₁_lip θ u hθ_mem_B hu
      rw [Metric.mem_closedBall, dist_eq_norm] at hu ⊢
      have h2 : ‖Φ₁ θ - θ‖ ≤ ρ / 2 := by
        dsimp only [Φ₁]
        have hsub : θ - P_tilde_E.eval θ / D₁ - θ = -(P_tilde_E.eval θ / D₁) := by ring
        rw [hsub, norm_neg, norm_div, hD₁_norm]
        calc ‖P_tilde_E.eval θ‖ / μ ≤ (μ * ρ / 2) / μ :=
              div_le_div_of_nonneg_right hP_tilde_at_θ (le_of_lt hμ_pos)
          _ = ρ / 2 := by
              have hne : μ ≠ 0 := ne_of_gt hμ_pos
              field_simp
      have hid : Φ₁ u - θ = (Φ₁ u - Φ₁ θ) + (Φ₁ θ - θ) := by ring
      rw [hid]
      calc ‖(Φ₁ u - Φ₁ θ) + (Φ₁ θ - θ)‖
          ≤ ‖Φ₁ u - Φ₁ θ‖ + ‖Φ₁ θ - θ‖ := norm_add_le _ _
        _ ≤ (1 / 2 : ℝ) * ρ + ρ / 2 :=
            add_le_add (h1.trans (mul_le_mul_of_nonneg_left hu (by norm_num))) h2
        _ = ρ := by ring

    let K_half : NNReal := ⟨1 / 2, by norm_num⟩
    have hContract₁ : ContractingWith K_half (Set.MapsTo.restrict Φ₁ B_ρ B_ρ hΦ₁_maps) := by
      refine ⟨Subtype.mk_lt_mk.mpr (by norm_num), ?_⟩
      rw [lipschitzWith_iff_dist_le_mul]
      rintro ⟨u₁, hu₁⟩ ⟨u₂, hu₂⟩
      change dist (Φ₁ u₁) (Φ₁ u₂) ≤ (1 / 2 : ℝ) * dist u₁ u₂
      rw [dist_eq_norm, dist_eq_norm, norm_sub_rev (Φ₁ u₁), norm_sub_rev u₁]
      exact hΦ₁_lip u₁ u₂ hu₁ hu₂

    obtain ⟨θ_tilde_E, hθ_tilde_B, hfp₁, _, _⟩ :=
      ContractingWith.exists_fixedPoint' Metric.isClosed_closedBall.isComplete hΦ₁_maps hContract₁
        hθ_mem_B (edist_ne_top _ _)
    have hP_tilde_root_E : P_tilde_E.eval θ_tilde_E = 0 := by
      have hfp_eq : θ_tilde_E - P_tilde_E.eval θ_tilde_E / D₁ = θ_tilde_E := hfp₁
      have hdiv0 : P_tilde_E.eval θ_tilde_E / D₁ = 0 := by linear_combination -hfp_eq
      exact (div_eq_zero_iff.mp hdiv0).resolve_right hD₁_ne

    let θ_tilde : F_hat := (θ_tilde_E : F_hat)
    have hθ_tilde_mem_E : θ_tilde ∈ E_sep := θ_tilde_E.2
    have hP_tilde_aeval : (let _ : Algebra ↥K₀ F_hat := K₀.toAlgebra;
        Polynomial.aeval θ_tilde P_tilde_K = 0) := by
      dsimp only
      let _ : Algebra ↥K₀ F_hat := K₀.toAlgebra
      have hcoe : ((P_tilde_E.eval θ_tilde_E : ↥E_sep) : F_hat) =
          Polynomial.aeval θ_tilde P_tilde_K := by
        dsimp only [P_tilde_E]
        rw [Polynomial.eval_map, Polynomial.aeval_eq_sum_range, Polynomial.eval₂_eq_sum_range]
        push_cast
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [Algebra.smul_def]
        rfl
      rw [← hcoe, hP_tilde_root_E]
      rfl

    
    let M_θ : IntermediateField ↥Ly₀ ↥E_sep :=
      IntermediateField.adjoin ↥Ly₀ ({θ_tilde_E} : Set ↥E_sep)
    have hCl_Mθ : IsClosed (M_θ : Set ↥E_sep) := by
      have _ : FiniteDimensional ↥Ly₀ ↥M_θ := FiniteDimensional.left ↥Ly₀ ↥M_θ ↥E_sep
      have _ : FiniteDimensional ↥Ly₀ ↥M_θ.toSubmodule := inferInstance
      exact Submodule.closed_of_finiteDimensional M_θ.toSubmodule

    let D₂ : ↥E_sep := P_E.derivative.eval θ_tilde_E
    have hD₂_diff : ‖D₂ - P_E.derivative.eval θ‖ ≤ μ / 2 :=
      hPE_bounds.2 θ_tilde_E hθ_tilde_B
    have hD₂_norm : ‖D₂‖ = μ := by
      have hlt : ‖D₂ - P_E.derivative.eval θ‖ < ‖P_E.derivative.eval θ‖ := by
        change ‖D₂ - P_E.derivative.eval θ‖ < μ
        linarith
      have hid : D₂ = P_E.derivative.eval θ + (D₂ - P_E.derivative.eval θ) := by ring
      rw [hid, h_ultra_eq _ _ hlt]

    have hPE_mem_Mθ : ∀ (Q : Polynomial ↥Ly₀) (v : ↥E_sep),
        v ∈ M_θ → (Q.map j_Ly₀).eval v ∈ M_θ := by
      intro Q v hv
      rw [Polynomial.eval_map, ← Polynomial.aeval_def]
      let v' : ↥M_θ := ⟨v, hv⟩
      have hval : Polynomial.aeval v Q = (Polynomial.aeval v' Q : ↥E_sep) := by
        simp only [Polynomial.aeval_eq_sum_range, Algebra.smul_def]
        push_cast
        rfl
      rw [hval]
      exact (Polynomial.aeval v' Q).2

    have hD₂_mem : D₂ ∈ M_θ := by
      dsimp only [D₂, P_E]
      rw [Polynomial.derivative_map]
      exact hPE_mem_Mθ P.derivative θ_tilde_E (IntermediateField.mem_adjoin_simple_self ↥Ly₀ θ_tilde_E)

    let Φ₂ : ↥E_sep → ↥E_sep := fun v => v - (P_E.eval v) / D₂
    have hΦ₂_mem : ∀ v ∈ M_θ, Φ₂ v ∈ M_θ := fun v hv =>
      M_θ.sub_mem hv (M_θ.div_mem (hPE_mem_Mθ P v hv) hD₂_mem)
    have hΦ₂_contract : ∀ v ∈ B_ρ, ‖Φ₂ v - θ‖ ≤ (1 / 2 : ℝ) * ‖v - θ‖ := by
      intro v hv
      have hD₂_ne : D₂ ≠ 0 := norm_ne_zero_iff.mp (by rw [hD₂_norm]; exact ne_of_gt hμ_pos)
      have hid : Φ₂ v - θ = (D₂ * (v - θ) - P_E.eval v) / D₂ := by
        dsimp only [Φ₂]
        field_simp
        ring
      have hnum_id : D₂ * (v - θ) - P_E.eval v =
          -(P_E.eval v - P_E.eval θ - (P_E.derivative.eval θ) * (v - θ)) +
          (D₂ - P_E.derivative.eval θ) * (v - θ) := by
        rw [hPE_eval]
        ring
      have hnum_le : ‖D₂ * (v - θ) - P_E.eval v‖ ≤ (μ / 2) * ‖v - θ‖ := by
        rw [hnum_id]
        refine (IsUltrametricDist.norm_add_le_max _ _).trans (max_le ?_ ?_)
        · rw [norm_neg]
          exact hPE_bounds.1 θ v hθ_mem_B hv
        · rw [norm_mul]
          exact mul_le_mul_of_nonneg_right hD₂_diff (norm_nonneg _)
      rw [hid, norm_div, hD₂_norm]
      calc ‖D₂ * (v - θ) - P_E.eval v‖ / μ
          ≤ ((μ / 2) * ‖v - θ‖) / μ := div_le_div_of_nonneg_right hnum_le (le_of_lt hμ_pos)
        _ = (1 / 2 : ℝ) * ‖v - θ‖ := by
            have hne : μ ≠ 0 := ne_of_gt hμ_pos
            field_simp

    let v_seq : ℕ → ↥E_sep := fun n => Φ₂^[n] θ_tilde_E
    have hv_props : ∀ n : ℕ, v_seq n ∈ M_θ ∧ ‖v_seq n - θ‖ ≤ (1 / 2 : ℝ) ^ n * ρ := by
      intro n
      induction n with
      | zero =>
        simp only [v_seq, Function.iterate_zero, id_eq, pow_zero, one_mul]
        exact ⟨IntermediateField.mem_adjoin_simple_self ↥Ly₀ θ_tilde_E,
          (h_ball_norm θ_tilde_E hθ_tilde_B).1⟩
      | succ n ih =>
        rcases ih with ⟨ih_mem, ih_dist⟩
        have hv_B : v_seq n ∈ B_ρ := by
          rw [Metric.mem_closedBall, dist_eq_norm]
          have hpow_le : (1 / 2 : ℝ) ^ n ≤ 1 := pow_le_one₀ (by norm_num) (by norm_num)
          exact ih_dist.trans ((mul_le_mul_of_nonneg_right hpow_le (le_of_lt hρ_pos)).trans_eq (one_mul ρ))
        simp only [v_seq, Function.iterate_succ_apply'] at *
        refine ⟨hΦ₂_mem _ ih_mem, ?_⟩
        calc ‖Φ₂ (Φ₂^[n] θ_tilde_E) - θ‖
            ≤ (1 / 2 : ℝ) * ‖Φ₂^[n] θ_tilde_E - θ‖ := hΦ₂_contract _ hv_B
          _ ≤ (1 / 2 : ℝ) * ((1 / 2 : ℝ) ^ n * ρ) :=
              mul_le_mul_of_nonneg_left ih_dist (by norm_num)
          _ = (1 / 2 : ℝ) ^ (n + 1) * ρ := by ring

    have hv_tendsto : Filter.Tendsto v_seq Filter.atTop (nhds θ) := by
      rw [tendsto_iff_dist_tendsto_zero]
      refine squeeze_zero (g := fun n : ℕ => (1 / 2 : ℝ) ^ n * ρ)
        (fun _ => dist_nonneg) (fun n => ?_) ?_
      · rw [dist_eq_norm]
        exact (hv_props n).2
      · simpa using (tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num : (0 : ℝ) ≤ 1 / 2)
          (by norm_num : (1 / 2 : ℝ) < 1)).mul_const ρ

    have hθ_in_Mθ : θ ∈ M_θ :=
      hCl_Mθ.mem_of_tendsto hv_tendsto (Filter.Eventually.of_forall fun n => (hv_props n).1)
    have hMθ_top : M_θ = ⊤ := by
      rw [eq_top_iff, ← hθ_prim, IntermediateField.adjoin_le_iff, Set.singleton_subset_iff]
      exact hθ_in_Mθ

    let l_if : IntermediateField K_hat F_hat :=
      IntermediateField.adjoin K_hat ({y₀, θ_tilde} : Set F_hat)
    let l : Subfield F_hat := l_if.toSubfield
    have hlE : l ≤ E_sep := by
      let E_K : IntermediateField K_hat F_hat :=
        { E_sep with
          algebraMap_mem' := fun c => hK₀E (K₀_if.algebraMap_mem c) }
      have hadj : l_if ≤ E_K := by
        rw [IntermediateField.adjoin_le_iff]
        rintro x (hx | hx)
        · rw [hx]
          exact hK₀E (IntermediateField.mem_adjoin_simple_self K_hat y₀)
        · rw [Set.mem_singleton_iff] at hx
          rw [hx]
          exact hθ_tilde_mem_E
      exact fun x hx => hadj hx

    refine ⟨θ_tilde, P_tilde_K, hθ_tilde_mem_E, hP_tilde_monic, hP_tilde_aeval, ?_⟩
    let l_bar : Subfield F_hat := l.topologicalClosure
    have hK₀_le_l : K₀ ≤ l := by
      have hadj : K₀_if ≤ l_if :=
        IntermediateField.adjoin_le_iff.mpr (Set.singleton_subset_iff.mpr
          (IntermediateField.subset_adjoin K_hat ({y₀, θ_tilde} : Set F_hat) (Or.inl rfl)))
      exact fun x hx => hadj hx
    have hLy₀_le_lbar : Ly₀ ≤ l_bar :=
      Subfield.topologicalClosure_minimal K₀ (hK₀_le_l.trans (Subfield.le_topologicalClosure l))
        (Subfield.isClosed_topologicalClosure l)
    let N_if : IntermediateField ↥Ly₀ ↥E_sep :=
      { l_bar.comap E_sep.subtype with
        algebraMap_mem' := fun u => hLy₀_le_lbar u.2 }
    have hθ_tilde_N : θ_tilde_E ∈ N_if :=
      Subfield.le_topologicalClosure l
        (IntermediateField.subset_adjoin K_hat ({y₀, θ_tilde} : Set F_hat) (Or.inr rfl))
    have hMθ_le_N : M_θ ≤ N_if :=
      IntermediateField.adjoin_le_iff.mpr (Set.singleton_subset_iff.mpr hθ_tilde_N)
    rw [hMθ_top] at hMθ_le_N
    intro u hu ε hε
    have hu_lbar : u ∈ closure (l : Set F_hat) :=
      hMθ_le_N (IntermediateField.mem_top : (⟨u, hu⟩ : ↥E_sep) ∈ (⊤ : IntermediateField ↥Ly₀ ↥E_sep))
    obtain ⟨v, hv, hdist⟩ := Metric.mem_closure_iff.mp hu_lbar ε hε
    rw [dist_eq_norm] at hdist
    exact ⟨v, hv, hdist⟩

  obtain ⟨θ_tilde, P_tilde_K, hθ_tilde_mem_E, hP_tilde_monic, hP_tilde_aeval, hDense_l⟩ := hPart2

  let l_if : IntermediateField K_hat F_hat :=
    IntermediateField.adjoin K_hat ({y₀, θ_tilde} : Set F_hat)
  let l : Subfield F_hat := l_if.toSubfield
  have hlE : l ≤ E_sep := by
    let E_K : IntermediateField K_hat F_hat :=
      { E_sep with
        algebraMap_mem' := fun c => hK₀E (K₀_if.algebraMap_mem c) }
    have hadj : l_if ≤ E_K := by
      rw [IntermediateField.adjoin_le_iff]
      rintro x (hx | hx)
      · rw [hx]
        exact hK₀E (IntermediateField.mem_adjoin_simple_self K_hat y₀)
      · rw [Set.mem_singleton_iff] at hx
        rw [hx]
        exact hθ_tilde_mem_E
    exact fun x hx => hadj hx

  
  
  
  refine ⟨w₀, hw₀_not, hw₀_Lz, ?_⟩
  intro δ hδ
  obtain ⟨w', hw'_l, hw'_dist⟩ := hDense_l w₀ hw₀_E δ hδ
  refine ⟨w', hw'_dist, fun hw'_not => ?_⟩
  dsimp only

  let Kw'_if : IntermediateField K_hat F_hat := IntermediateField.adjoin K_hat ({w'} : Set F_hat)
  let Kw' : Subfield F_hat := Kw'_if.toSubfield
  have hKw'l : Kw' ≤ l := by
    have hadj : Kw'_if ≤ l_if :=
      IntermediateField.adjoin_le_iff.mpr (Set.singleton_subset_iff.mpr hw'_l)
    exact fun x hx => hadj hx

  
  
  
  have hFin_Kw'_l : (let _ : Algebra ↥Kw' ↥l := (Subfield.inclusion hKw'l).toAlgebra;
      FiniteDimensional ↥Kw' ↥l) := by
    dsimp only
    have hAlg_K₀_w' : IsAlgebraic ↥K₀_if w' := by
      have hK₀_if_le_l : K₀_if ≤ l_if :=
        IntermediateField.adjoin_le_iff.mpr (Set.singleton_subset_iff.mpr
          (IntermediateField.subset_adjoin K_hat ({y₀, θ_tilde} : Set F_hat) (Or.inl rfl)))
      let _ : Algebra ↥K₀_if ↥l_if := (IntermediateField.inclusion hK₀_if_le_l).toAlgebra
      let θ_l : ↥l_if := ⟨θ_tilde,
        IntermediateField.subset_adjoin K_hat ({y₀, θ_tilde} : Set F_hat) (Or.inr rfl)⟩
      have hθ_l_int : IsIntegral ↥K₀_if θ_l := by
        refine ⟨P_tilde_K, hP_tilde_monic, ?_⟩
        apply Subtype.ext
        rw [← Polynomial.aeval_def]
        let _ : Algebra ↥K₀ F_hat := K₀.toAlgebra
        have hval : ((Polynomial.aeval θ_l P_tilde_K : ↥l_if) : F_hat) =
            Polynomial.aeval θ_tilde P_tilde_K := by
          simp only [Polynomial.aeval_eq_sum_range, Algebra.smul_def]
          push_cast
          rfl
        rw [hval]
        exact hP_tilde_aeval
      let M_top : IntermediateField ↥K₀_if ↥l_if :=
        IntermediateField.adjoin ↥K₀_if ({θ_l} : Set ↥l_if)
      have hFin_Mtop : FiniteDimensional ↥K₀_if ↥M_top :=
        IntermediateField.adjoin.finiteDimensional hθ_l_int
      have hMtop_eq : M_top = ⊤ := by
        rw [eq_top_iff]
        let M_K : IntermediateField K_hat F_hat :=
          { M_top.toSubfield.map l.subtype with
            algebraMap_mem' := fun c =>
              ⟨⟨algebraMap K_hat F_hat c, l_if.algebraMap_mem c⟩,
                M_top.algebraMap_mem ⟨algebraMap K_hat F_hat c, K₀_if.algebraMap_mem c⟩, rfl⟩ }
        have hl_le_MK : l_if ≤ M_K := by
          rw [IntermediateField.adjoin_le_iff]
          rintro x (hx | hx)
          · rw [hx]
            exact ⟨⟨y₀, hK₀_if_le_l (IntermediateField.mem_adjoin_simple_self K_hat y₀)⟩,
              M_top.algebraMap_mem ⟨y₀, IntermediateField.mem_adjoin_simple_self K_hat y₀⟩, rfl⟩
          · rw [Set.mem_singleton_iff] at hx
            rw [hx]
            exact ⟨θ_l, IntermediateField.mem_adjoin_simple_self ↥K₀_if θ_l, rfl⟩
        intro u _
        obtain ⟨u', hu', hu_eq⟩ := hl_le_MK u.2
        have hu_sub : u' = u := Subtype.ext hu_eq
        rwa [← hu_sub]
      rw [hMtop_eq] at hFin_Mtop
      have _ : FiniteDimensional ↥K₀_if ↥l_if :=
        Module.Finite.equiv IntermediateField.topEquiv.toLinearEquiv
      let w'_l : ↥l_if := ⟨w', hw'_l⟩
      obtain ⟨Q₀, hQ₀_ne, hQ₀_aev⟩ :=
        (Algebra.IsIntegral.isIntegral (R := ↥K₀_if) w'_l).isAlgebraic
      refine ⟨Q₀, hQ₀_ne, ?_⟩
      have hval : (Polynomial.aeval w'_l Q₀ : F_hat) = Polynomial.aeval w' Q₀ := by
        simp only [Polynomial.aeval_eq_sum_range, Algebra.smul_def]
        push_cast
        rfl
      rw [← hval, hQ₀_aev]
      rfl

    have hAlg_adj_w' : IsAlgebraic ↥(Algebra.adjoin K_hat ({y₀} : Set F_hat)) w' :=
      (IntermediateField.isAlgebraic_adjoin_iff (F := K_hat) (s := ({y₀} : Set F_hat))).mp hAlg_K₀_w'
    obtain ⟨Q, hQ_ne, hQ_aev⟩ := hAlg_adj_w'
    let s_deg : ℕ := Q.natDegree
    have hQ_lc_ne : ((Q.coeff s_deg : ↥(Algebra.adjoin K_hat ({y₀} : Set F_hat))) : F_hat) ≠ 0 := by
      have hne : Q.coeff s_deg ≠ 0 := Polynomial.leadingCoeff_ne_zero.mpr hQ_ne
      exact fun h0 => hne (Subtype.ext h0)

    have h_lift_P : ∀ i : ℕ, ∃ P_i : Polynomial K_hat,
        Polynomial.aeval y₀ P_i = ((Q.coeff i : ↥(Algebra.adjoin K_hat ({y₀} : Set F_hat))) : F_hat) := by
      intro i
      let qi_F : F_hat := ((Q.coeff i : ↥(Algebra.adjoin K_hat ({y₀} : Set F_hat))) : F_hat)
      have hmem : qi_F ∈ Algebra.adjoin K_hat ({y₀} : Set F_hat) := (Q.coeff i).2
      rw [Algebra.adjoin_singleton_eq_range_aeval] at hmem
      exact hmem
    choose P_lift hP_lift using h_lift_P

    have hPs_ne : P_lift s_deg ≠ 0 := by
      intro h0
      apply hQ_lc_ne
      rw [← hP_lift s_deg, h0, map_zero]
    let j₀ : ℕ := (P_lift s_deg).natDegree
    have hPs_j₀_ne : (P_lift s_deg).coeff j₀ ≠ 0 :=
      Polynomial.leadingCoeff_ne_zero.mpr hPs_ne

    let M_deg : ℕ := ∑ i ∈ Finset.range (s_deg + 1), (P_lift i).natDegree
    have hPi_deg_lt : ∀ i ∈ Finset.range (s_deg + 1), (P_lift i).natDegree < M_deg + 1 := by
      intro i hi
      have hle : (P_lift i).natDegree ≤ M_deg :=
        Finset.single_le_sum (f := fun k => (P_lift k).natDegree) (fun _ _ => Nat.zero_le _) hi
      omega
    have hj₀_mem : j₀ ∈ Finset.range (M_deg + 1) :=
      Finset.mem_range.mpr (hPi_deg_lt s_deg (Finset.mem_range.mpr (Nat.lt_succ_self s_deg)))

    let C_poly : ℕ → Polynomial K_hat := fun j =>
      ∑ i ∈ Finset.range (s_deg + 1), Polynomial.C ((P_lift i).coeff j) * Polynomial.X ^ i
    have hCj₀_ne : C_poly j₀ ≠ 0 := by
      intro h0
      apply hPs_j₀_ne
      have hc := congrArg (fun R : Polynomial K_hat => R.coeff s_deg) h0
      simp only [C_poly, Polynomial.coeff_zero, Polynomial.finsetSum_coeff,
        Polynomial.coeff_C_mul_X_pow] at hc
      rw [Finset.sum_eq_single s_deg] at hc
      · simp only [↓reduceIte] at hc
        exact hc
      · intro i _ hne
        exact ite_eq_right_iff.mpr (fun h => absurd h hne.symm)
      · intro hnot
        exact absurd (Finset.mem_range.mpr (Nat.lt_succ_self s_deg)) hnot

    have hCj₀_w'_ne : Polynomial.aeval w' (C_poly j₀) ≠ 0 :=
      h_aeval_ne_zero w' hw'_not (C_poly j₀) hCj₀_ne

    let _ : Algebra ↥Kw' F_hat := Kw'.toAlgebra
    have hC_mem_Kw' : ∀ j : ℕ, Polynomial.aeval w' (C_poly j) ∈ Kw' := by
      intro j
      dsimp only [C_poly]
      rw [map_sum]
      refine Kw'.sum_mem fun i _ => ?_
      simp only [map_mul, map_pow, Polynomial.aeval_C, Polynomial.aeval_X]
      exact Kw'.mul_mem (Kw'_if.algebraMap_mem _)
        (Kw'.pow_mem (IntermediateField.mem_adjoin_simple_self K_hat w') i)

    let G_poly : Polynomial ↥Kw' :=
      ∑ j ∈ Finset.range (M_deg + 1),
        Polynomial.C (⟨Polynomial.aeval w' (C_poly j), hC_mem_Kw' j⟩ : ↥Kw') * Polynomial.X ^ j
    have hG_ne : G_poly ≠ 0 := by
      intro h0
      apply hCj₀_w'_ne
      have hc := congrArg (fun R : Polynomial ↥Kw' => (R.coeff j₀ : F_hat)) h0
      simp only [G_poly, Polynomial.coeff_zero, ZeroMemClass.coe_zero,
        Polynomial.finsetSum_coeff, Polynomial.coeff_C_mul_X_pow] at hc
      rw [Finset.sum_eq_single j₀] at hc
      · simp only [↓reduceIte] at hc
        exact hc
      · intro j _ hne
        rw [ite_eq_right_iff.mpr (fun h => absurd h hne.symm)]
      · intro hnot
        exact absurd hj₀_mem hnot

    have hG_aeval : Polynomial.aeval y₀ G_poly = 0 := by
      dsimp only [G_poly]
      simp only [map_sum, map_mul, Polynomial.aeval_C, Polynomial.aeval_X_pow]
      have hexp_C : ∀ j : ℕ, ((algebraMap ↥Kw' F_hat) ⟨Polynomial.aeval w' (C_poly j), hC_mem_Kw' j⟩) =
          ∑ i ∈ Finset.range (s_deg + 1), algebraMap K_hat F_hat ((P_lift i).coeff j) * w' ^ i := by
        intro j
        change Polynomial.aeval w' (C_poly j) = _
        dsimp only [C_poly]
        simp only [map_sum, map_mul, Polynomial.aeval_C, Polynomial.aeval_X_pow]
      simp_rw [hexp_C, Finset.sum_mul]
      rw [Finset.sum_comm]
      have hswap : ∑ x ∈ Finset.range (s_deg + 1),
          ∑ y ∈ Finset.range (M_deg + 1), algebraMap K_hat F_hat ((P_lift x).coeff y) * w' ^ x * y₀ ^ y =
          ∑ x ∈ Finset.range (s_deg + 1),
            ((Q.coeff x : ↥(Algebra.adjoin K_hat ({y₀} : Set F_hat))) : F_hat) * w' ^ x := by
        refine Finset.sum_congr rfl fun i hi => ?_
        have hterm : ∑ j ∈ Finset.range (M_deg + 1),
              algebraMap K_hat F_hat ((P_lift i).coeff j) * w' ^ i * y₀ ^ j =
            (∑ j ∈ Finset.range (M_deg + 1),
              algebraMap K_hat F_hat ((P_lift i).coeff j) * y₀ ^ j) * w' ^ i := by
          rw [Finset.sum_mul]
          refine Finset.sum_congr rfl fun _ _ => by ring
        rw [hterm, ← hP_lift i, Polynomial.aeval_eq_sum_range' (hPi_deg_lt i hi)]
        congr 1
        refine Finset.sum_congr rfl fun _ _ => ?_
        rw [Algebra.smul_def]
      rw [hswap]
      rw [Polynomial.aeval_eq_sum_range] at hQ_aev
      simpa [s_deg, Algebra.smul_def] using hQ_aev

    have hy₀_int_Kw' : IsIntegral ↥Kw' y₀ :=
      (show IsAlgebraic ↥Kw' y₀ from ⟨G_poly, hG_ne, hG_aeval⟩).isIntegral

    let _ : Algebra ↥Kw' ↥l := (Subfield.inclusion hKw'l).toAlgebra
    let y₀_l : ↥l := ⟨y₀, IntermediateField.subset_adjoin K_hat ({y₀, θ_tilde} : Set F_hat) (Or.inl rfl)⟩
    let θ_l₂ : ↥l := ⟨θ_tilde, IntermediateField.subset_adjoin K_hat ({y₀, θ_tilde} : Set F_hat) (Or.inr rfl)⟩
    have hy₀_l_int : IsIntegral ↥Kw' y₀_l := by
      obtain ⟨R₀, hR₀_monic, hR₀_aev⟩ := hy₀_int_Kw'
      refine ⟨R₀, hR₀_monic, ?_⟩
      apply Subtype.ext
      rw [Polynomial.eval₂_eq_sum_range]
      rw [Polynomial.eval₂_eq_sum_range] at hR₀_aev
      push_cast
      exact hR₀_aev
    let M_mid : IntermediateField ↥Kw' ↥l := IntermediateField.adjoin ↥Kw' ({y₀_l} : Set ↥l)
    have _ : FiniteDimensional ↥Kw' ↥M_mid :=
      IntermediateField.adjoin.finiteDimensional hy₀_l_int

    have hK₀_to_Mmid : ∀ x ∈ K₀, ∃ hx : x ∈ l, (⟨x, hx⟩ : ↥l) ∈ M_mid := by
      let M_mid_K : IntermediateField K_hat F_hat :=
        { M_mid.toSubfield.map l.subtype with
          algebraMap_mem' := fun c =>
            ⟨⟨algebraMap K_hat F_hat c, l_if.algebraMap_mem c⟩,
              M_mid.algebraMap_mem ⟨algebraMap K_hat F_hat c, Kw'_if.algebraMap_mem c⟩, rfl⟩ }
      have hadj : K₀_if ≤ M_mid_K :=
        IntermediateField.adjoin_le_iff.mpr (Set.singleton_subset_iff.mpr
          ⟨y₀_l, IntermediateField.mem_adjoin_simple_self ↥Kw' y₀_l, rfl⟩)
      intro x hx
      obtain ⟨u, hu, hu_eq⟩ := hadj hx
      change (u : F_hat) = x at hu_eq
      subst hu_eq
      exact ⟨u.2, hu⟩

    let ψ_K₀_Mmid : ↥K₀ →+* ↥M_mid :=
      { toFun := fun u => ⟨⟨u.1, (hK₀_to_Mmid u.1 u.2).1⟩, (hK₀_to_Mmid u.1 u.2).2⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    have hθ_l₂_int : IsIntegral ↥M_mid θ_l₂ := by
      refine ⟨P_tilde_K.map ψ_K₀_Mmid, hP_tilde_monic.map ψ_K₀_Mmid, ?_⟩
      apply Subtype.ext
      rw [← Polynomial.aeval_def]
      let _ : Algebra ↥K₀ F_hat := K₀.toAlgebra
      have hval : (((Polynomial.aeval θ_l₂ (P_tilde_K.map ψ_K₀_Mmid) : ↥l) : F_hat)) =
          Polynomial.aeval θ_tilde P_tilde_K := by
        rw [Polynomial.aeval_def, Polynomial.eval₂_map, Polynomial.aeval_eq_sum_range,
          Polynomial.eval₂_eq_sum_range]
        push_cast
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [Algebra.smul_def]
        rfl
      rw [hval]
      exact hP_tilde_aeval

    let M_top₂ : IntermediateField ↥M_mid ↥l := IntermediateField.adjoin ↥M_mid ({θ_l₂} : Set ↥l)
    have hFin_Mmid_Mtop₂ : FiniteDimensional ↥M_mid ↥M_top₂ :=
      IntermediateField.adjoin.finiteDimensional hθ_l₂_int
    have hMtop₂_eq : M_top₂ = ⊤ := by
      rw [eq_top_iff]
      let M_top₂_K : IntermediateField K_hat F_hat :=
        { M_top₂.toSubfield.map l.subtype with
          algebraMap_mem' := fun c =>
            ⟨⟨algebraMap K_hat F_hat c, l_if.algebraMap_mem c⟩,
              M_top₂.algebraMap_mem ⟨⟨algebraMap K_hat F_hat c, l_if.algebraMap_mem c⟩,
                M_mid.algebraMap_mem ⟨algebraMap K_hat F_hat c, Kw'_if.algebraMap_mem c⟩⟩, rfl⟩ }
      have hl_le : l_if ≤ M_top₂_K := by
        rw [IntermediateField.adjoin_le_iff]
        rintro x (hx | hx)
        · rw [hx]
          exact ⟨y₀_l, M_top₂.algebraMap_mem ⟨y₀_l, IntermediateField.mem_adjoin_simple_self ↥Kw' y₀_l⟩, rfl⟩
        · rw [Set.mem_singleton_iff] at hx
          rw [hx]
          exact ⟨θ_l₂, IntermediateField.mem_adjoin_simple_self ↥M_mid θ_l₂, rfl⟩
      intro u _
      obtain ⟨u', hu', hu_eq⟩ := hl_le u.2
      have hu_sub : u' = u := Subtype.ext hu_eq
      rwa [← hu_sub]
    rw [hMtop₂_eq] at hFin_Mmid_Mtop₂
    have _ : FiniteDimensional ↥M_mid ↥l :=
      Module.Finite.equiv IntermediateField.topEquiv.toLinearEquiv
    exact Module.Finite.trans (R := ↥Kw') ↥M_mid ↥l

  
  
  
  let Lw' : Subfield F_hat := Kw'.topologicalClosure
  have hLw'E : Lw' ≤ E_sep := Subfield.topologicalClosure_minimal Kw' (hKw'l.trans hlE) hCl_E
  have hCl_Lw' : IsClosed (Lw' : Set F_hat) := Subfield.isClosed_topologicalClosure Kw'
  have _ : CompleteSpace ↥Lw' := @IsClosed.completeSpace_coe _ _ _ _ hCl_Lw'
  have hc₀_Lw' : algebraMap K_hat F_hat c₀ ∈ Lw' :=
    Subfield.le_topologicalClosure Kw' (Kw'_if.algebraMap_mem c₀)
  let _ : NontriviallyNormedField ↥Lw' :=
    { (inferInstance : NormedField ↥Lw') with
      non_trivial := ⟨⟨algebraMap K_hat F_hat c₀, hc₀_Lw'⟩, hιc₀⟩ }
  let _ : Algebra ↥Lw' ↥E_sep := (Subfield.inclusion hLw'E).toAlgebra
  have _ : ContinuousSMul ↥Lw' ↥E_sep :=
    ContinuousSMul.mk (by
      have h : Continuous (fun p : ↥Lw' × ↥E_sep => ((p.1 : F_hat) * (p.2 : F_hat))) :=
        (continuous_subtype_val.comp continuous_fst).mul (continuous_subtype_val.comp continuous_snd)
      exact h.subtype_mk _)

  let _ : Algebra ↥Kw' ↥l := (Subfield.inclusion hKw'l).toAlgebra
  obtain ⟨S₀, hS₀_span⟩ := @Module.Finite.fg_top ↥Kw' ↥l _ _ _ hFin_Kw'_l
  let ι_lE : ↥l →+* ↥E_sep := Subfield.inclusion hlE
  classical
  let S : Finset ↥E_sep := S₀.image ι_lE
  let V_span : Submodule ↥Lw' ↥E_sep := Submodule.span ↥Lw' (S : Set ↥E_sep)
  have hV_fg : V_span.FG := Submodule.fg_span S.finite_toSet
  have _ : FiniteDimensional ↥Lw' ↥V_span := Module.Finite.iff_fg.mpr hV_fg
  have hCl_V : IsClosed (V_span : Set ↥E_sep) := Submodule.closed_of_finiteDimensional V_span

  have hl_in_V : ∀ u : ↥l, ι_lE u ∈ V_span := by
    intro u
    have hu_top : u ∈ Submodule.span ↥Kw' (S₀ : Set ↥l) := by
      rw [hS₀_span]
      trivial
    refine Submodule.span_induction ?_ ?_ ?_ ?_ hu_top
    · intro x hx
      exact Submodule.subset_span (Finset.mem_coe.mpr (Finset.mem_image_of_mem ι_lE hx))
    · rw [map_zero]
      exact V_span.zero_mem
    · intro x y _ _ hx hy
      rw [map_add]
      exact V_span.add_mem hx hy
    · intro a x _ hx
      let a' : ↥Lw' := Subfield.inclusion (Subfield.le_topologicalClosure Kw') a
      have hsmul : ι_lE (a • x) = a' • ι_lE x := rfl
      rw [hsmul]
      exact V_span.smul_mem a' hx

  have hV_top : V_span = ⊤ := by
    rw [eq_top_iff]
    intro u_E _
    have hu_cl : u_E ∈ closure (V_span : Set ↥E_sep) := by
      rw [Metric.mem_closure_iff]
      intro ε hε
      obtain ⟨v, hv, hdist⟩ := hDense_l u_E.1 u_E.2 ε hε
      refine ⟨ι_lE ⟨v, hv⟩, hl_in_V ⟨v, hv⟩, ?_⟩
      rwa [dist_eq_norm]
    rwa [hCl_V.closure_eq] at hu_cl

  have _ : FiniteDimensional ↥Lw' ↥E_sep :=
    Module.Finite.of_fg_top ⟨S, hV_top⟩
  let _ : Algebra ↥Lw' F_hat := Lw'.toAlgebra
  let _ : Algebra ↥E_sep F_hat := E_sep.toAlgebra
  have _ : IsScalarTower ↥Lw' ↥E_sep F_hat := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  have _ : FiniteDimensional ↥E_sep F_hat := hFin_E_F
  exact Module.Finite.trans (R := ↥Lw') ↥E_sep F_hat

theorem weil_immediate_deg_p_separable_taylor_bounds (F_hat : Type u)
    [NontriviallyNormedField F_hat] [CompleteSpace F_hat] [IsUltrametricDist F_hat]
    (p : ℕ) (hp : p.Prime) (hp0 : (p : F_hat) = 0)
    (M₁ M₂ : Subfield F_hat) (hLE : M₁ ≤ M₂)
    (hNontriv₁ : ∃ c ∈ M₁, 1 < ‖c‖)
    (hCl₁ : IsClosed (M₁ : Set F_hat))
    (hCl₂ : IsClosed (M₂ : Set F_hat))
    (hDeg :
      letI : Algebra ↥M₁ ↥M₂ := (Subfield.inclusion hLE).toAlgebra
      FiniteDimensional ↥M₁ ↥M₂ ∧ Module.finrank ↥M₁ ↥M₂ = p)
    (hVal : ∀ w ∈ M₂, w ≠ 0 → ∃ u ∈ M₁, ‖w‖ = ‖u‖)
    (hRes : ∀ w ∈ M₂, ‖w‖ ≤ 1 → ∃ u ∈ M₁, ‖u‖ ≤ 1 ∧ ‖w - u‖ < 1)
    (α₀ : F_hat) (hα₀ : α₀ ∈ M₂) (hα₀_not : α₀ ∉ M₁)
    (r : ℝ) (hr_pos : 0 < r) (hr_lt : ∀ x ∈ M₁, r < ‖α₀ - x‖)
    (hr_inf : ∀ ε : ℝ, 0 < ε → ∃ x ∈ M₁, ‖α₀ - x‖ < r + ε)
    (hSep :
      letI : Algebra ↥M₁ ↥M₂ := (Subfield.inclusion hLE).toAlgebra
      (minpoly ↥M₁ (⟨α₀, hα₀⟩ : ↥M₂)).Separable) :
    letI : Algebra ↥M₁ ↥M₂ := (Subfield.inclusion hLE).toAlgebra
    let f₀ : Polynomial ↥M₁ := minpoly ↥M₁ (⟨α₀, hα₀⟩ : ↥M₂)
    ∃ δ₀ : ℝ, 0 < δ₀ ∧
      ((∀ (c : ↥M₁), ‖α₀ - (c : F_hat)‖ < r + δ₀ →
          ‖((f₀.comp (Polynomial.X + Polynomial.C c)).coeff 1 : F_hat)‖ = r ^ (p - 1) ∧
          ∀ k : ℕ, 2 ≤ k → k < p →
            ‖((f₀.comp (Polynomial.X + Polynomial.C c)).coeff k : F_hat)‖ *
              ‖α₀ - (c : F_hat)‖ ^ k < r ^ p) ∨
       (∀ (c : ↥M₁), ‖α₀ - (c : F_hat)‖ < r + δ₀ →
          ∀ k : ℕ, 1 ≤ k → k < p →
            ‖((f₀.comp (Polynomial.X + Polynomial.C c)).coeff k : F_hat)‖ *
              ‖α₀ - (c : F_hat)‖ ^ k < r ^ p)) :=
by
  let _ := hCl₂
  let _ := hVal
  let _ : Algebra ↥M₁ ↥M₂ := (Subfield.inclusion hLE).toAlgebra
  dsimp only
  have : Fact p.Prime := ⟨hp⟩
  have hp2 : 2 ≤ p := hp.two_le
  have hp_pos : 0 < p := hp.pos
  have hp_ne : p ≠ 0 := hp.ne_zero
  have : FiniteDimensional ↥M₁ ↥M₂ := hDeg.1
  have hfin_M₂ : Module.finrank ↥M₁ ↥M₂ = p := hDeg.2
  let α₀_M₂ : ↥M₂ := ⟨α₀, hα₀⟩
  let f₀ : Polynomial ↥M₁ := minpoly ↥M₁ α₀_M₂
  have hSep₀ : f₀.Separable := hSep
  have hInt : IsIntegral ↥M₁ α₀_M₂ := Algebra.IsIntegral.isIntegral α₀_M₂
  have hf₀_monic : f₀.Monic := minpoly.monic hInt
  have hfin_adj : Module.finrank ↥M₁ ↥(IntermediateField.adjoin ↥M₁ ({α₀_M₂} : Set ↥M₂)) =
      f₀.natDegree := IntermediateField.adjoin.finrank hInt
  have hf₀_deg : f₀.natDegree = p := by
    have hmul := Module.finrank_mul_finrank ↥M₁
      ↥(IntermediateField.adjoin ↥M₁ ({α₀_M₂} : Set ↥M₂)) ↥M₂
    rw [hfin_adj, hfin_M₂] at hmul
    have hdvd : f₀.natDegree ∣ p := ⟨_, hmul.symm⟩
    rcases (Nat.dvd_prime hp).mp hdvd with h1 | hp_eq
    · exfalso
      have hf₀_lin : f₀ = Polynomial.X + Polynomial.C (f₀.coeff 0) := by
        apply Polynomial.ext
        intro n
        rcases n with _ | _ | n
        · simp
        · change f₀.coeff 1 = (Polynomial.X + Polynomial.C (f₀.coeff 0)).coeff 1
          simp only [Polynomial.coeff_add, Polynomial.coeff_X_one, Polynomial.coeff_C_succ, add_zero]
          rw [← h1]
          exact hf₀_monic.coeff_natDegree
        · simp only [Polynomial.coeff_add, Polynomial.coeff_X, Polynomial.coeff_C,
            Nat.add_eq_zero_iff, one_ne_zero, and_false, ↓reduceIte, add_zero]
          have : 1 ≠ n + 2 := by omega
          simp only [this, ↓reduceIte]
          exact Polynomial.coeff_eq_zero_of_natDegree_lt (p := f₀) (by omega)
      have haev : Polynomial.aeval α₀_M₂ f₀ = 0 := minpoly.aeval ↥M₁ α₀_M₂
      rw [hf₀_lin, map_add, Polynomial.aeval_X, Polynomial.aeval_C] at haev
      have hval : α₀ + ((f₀.coeff 0 : ↥M₁) : F_hat) = 0 := congrArg Subtype.val haev
      have hα₀_eq : α₀ = - ((f₀.coeff 0 : ↥M₁) : F_hat) := eq_neg_of_add_eq_zero_left hval
      rw [hα₀_eq] at hα₀_not
      exact hα₀_not (M₁.neg_mem (f₀.coeff 0).2)
    · exact hp_eq
  have h_adj_top : IntermediateField.adjoin ↥M₁ ({α₀_M₂} : Set ↥M₂) = ⊤ := by
    have hsub_top : (IntermediateField.adjoin ↥M₁ ({α₀_M₂} : Set ↥M₂)).toSubmodule = ⊤ :=
      Submodule.eq_top_of_finrank_eq (by
        change Module.finrank ↥M₁ ↥(IntermediateField.adjoin ↥M₁ ({α₀_M₂} : Set ↥M₂)) =
          Module.finrank ↥M₁ ↥M₂
        rw [hfin_adj, hf₀_deg, hfin_M₂])
    ext x
    change x ∈ (IntermediateField.adjoin ↥M₁ ({α₀_M₂} : Set ↥M₂)).toSubmodule ↔ _
    rw [hsub_top]
    simp

  
  have h_stage1 : ∃ (N₀ : Type u) (_ : NontriviallyNormedField N₀) (_ : IsUltrametricDist N₀)
      (_ : Algebra ↥M₁ N₀),
      FiniteDimensional ↥M₁ N₀ ∧
      IsGalois ↥M₁ N₀ ∧
      (∀ c : ↥M₁, ‖algebraMap ↥M₁ N₀ c‖ = ‖c‖) ∧
      (∀ (σ : N₀ ≃ₐ[↥M₁] N₀) (w : N₀), ‖σ w‖ = ‖w‖) ∧
      ∃ (j : ↥M₂ →ₐ[↥M₁] N₀),
        (∀ w : ↥M₂, ‖j w‖ = ‖w‖) ∧
        Nat.Coprime (Nat.card ↥j.fieldRange.fixingSubgroup) p ∧
        p ∣ Nat.card (N₀ ≃ₐ[↥M₁] N₀) := by
    let _ : NontriviallyNormedField ↥M₁ :=
      { toNormedField := inferInstance
        non_trivial := let ⟨c, hcM₁, hc1⟩ := hNontriv₁; ⟨⟨c, hcM₁⟩, hc1⟩ }
    have : CompleteSpace ↥M₁ := @IsClosed.completeSpace_coe F_hat _ _ _ hCl₁
    let N₀ : Type u := Polynomial.SplittingField f₀
    have hFinN₀ : FiniteDimensional ↥M₁ N₀ := Polynomial.IsSplittingField.finiteDimensional N₀ f₀
    have : Algebra.IsAlgebraic ↥M₁ N₀ := Algebra.IsAlgebraic.of_finite ↥M₁ N₀
    have hGalN₀ : IsGalois ↥M₁ N₀ := IsGalois.of_separable_splitting_field hSep₀
    let instNormN₀ : NontriviallyNormedField N₀ := spectralNorm.nontriviallyNormedField ↥M₁ N₀
    have instUltraN₀ : IsUltrametricDist N₀ :=
      IsUltrametricDist.isUltrametricDist_of_isNonarchimedean_norm
        (isNonarchimedean_spectralNorm (K := ↥M₁) (L := N₀))
    have hIso₁ : ∀ c : ↥M₁, ‖algebraMap ↥M₁ N₀ c‖ = ‖c‖ := fun c =>
      spectralNorm_extends c
    have hIsoGal : ∀ (σ : N₀ ≃ₐ[↥M₁] N₀) (w : N₀), ‖σ w‖ = ‖w‖ := by
      intro σ w
      change spectralNorm ↥M₁ N₀ (σ w) = spectralNorm ↥M₁ N₀ w
      rw [spectralNorm.spectralNorm_eq_norm_coeff_zero_rpow ↥M₁ N₀ (σ w),
        spectralNorm.spectralNorm_eq_norm_coeff_zero_rpow ↥M₁ N₀ w,
        minpoly.algEquiv_eq σ w]
    have hSplits : (f₀.map (algebraMap ↥M₁ N₀)).Splits := Polynomial.SplittingField.splits f₀
    have hRootCard : Fintype.card ↥(f₀.rootSet N₀) = p := by
      rw [Polynomial.card_rootSet_eq_natDegree hSep₀ hSplits, hf₀_deg]
    have hRootNe : Nonempty ↥(f₀.rootSet N₀) :=
      Fintype.card_pos_iff.mp (by omega)
    obtain ⟨⟨ξ_init, hξ_init_rs⟩⟩ := hRootNe
    have hξ_init_ar : ξ_init ∈ f₀.aroots N₀ := by
      rw [Polynomial.mem_rootSet] at hξ_init_rs
      exact Polynomial.mem_aroots.mpr hξ_init_rs
    let j₀ : ↥(IntermediateField.adjoin ↥M₁ ({α₀_M₂} : Set ↥M₂)) →ₐ[↥M₁] N₀ :=
      (IntermediateField.algHomAdjoinIntegralEquiv ↥M₁ hInt).symm ⟨ξ_init, hξ_init_ar⟩
    let j : ↥M₂ →ₐ[↥M₁] N₀ :=
      j₀.comp ((IntermediateField.equivOfEq h_adj_top.symm).toAlgHom.comp
        IntermediateField.topEquiv.symm.toAlgHom)
    have : Algebra.IsAlgebraic ↥M₁ ↥M₂ := Algebra.IsAlgebraic.of_finite ↥M₁ ↥M₂
    have hSpecM₂ : ∀ w : ↥M₂, ‖w‖ = spectralNorm ↥M₁ ↥M₂ w :=
      spectralNorm_unique_field_norm_ext (f := NormedField.toAbsoluteValue ↥M₂) (fun _ => rfl)
    have hIsoJ : ∀ w : ↥M₂, ‖j w‖ = ‖w‖ := by
      intro w
      rw [hSpecM₂ w]
      change spectralNorm ↥M₁ N₀ (j w) = spectralNorm ↥M₁ ↥M₂ w
      rw [spectralNorm.spectralNorm_eq_norm_coeff_zero_rpow ↥M₁ N₀ (j w),
        spectralNorm.spectralNorm_eq_norm_coeff_zero_rpow ↥M₁ ↥M₂ w,
        minpoly.algHom_eq j j.injective w]
    let E : IntermediateField ↥M₁ N₀ := j.fieldRange
    let H : Subgroup (N₀ ≃ₐ[↥M₁] N₀) := E.fixingSubgroup
    have hfin_E : Module.finrank ↥M₁ ↥E = p := by
      let e_E : ↥M₂ ≃ₗ[↥M₁] ↥E := LinearEquiv.ofBijective
        (j.toLinearMap.codRestrict E.toSubmodule (fun x => ⟨x, rfl⟩))
        ⟨fun x y h => j.injective (congrArg Subtype.val h),
         fun ⟨y, x, hx⟩ => ⟨x, Subtype.ext hx⟩⟩
      rw [← e_E.finrank_eq, hfin_M₂]
    have hfin_EN₀ : Module.finrank ↥E N₀ = Nat.card ↥H := by
      have hfix : IntermediateField.fixedField H = E := IsGalois.fixedField_fixingSubgroup E
      have hcard := IntermediateField.finrank_fixedField_eq_card H
      have hcongr : Module.finrank ↥(IntermediateField.fixedField H) N₀ = Module.finrank ↥E N₀ :=
        congrArg (fun F : IntermediateField ↥M₁ N₀ => Module.finrank ↥F N₀) hfix
      exact hcongr.symm.trans hcard
    have hp_mul_H : p * Nat.card ↥H = Nat.card (N₀ ≃ₐ[↥M₁] N₀) := by
      have hmul := Module.finrank_mul_finrank ↥M₁ ↥E N₀
      rw [hfin_E, hfin_EN₀, ← IsGalois.card_aut_eq_finrank ↥M₁ N₀] at hmul
      exact hmul
    have hpDvd : p ∣ Nat.card (N₀ ≃ₐ[↥M₁] N₀) := ⟨Nat.card ↥H, hp_mul_H.symm⟩
    have hCoprime : Nat.Coprime (Nat.card ↥H) p := by
      classical
      have : Fact (f₀.map (algebraMap ↥M₁ N₀)).Splits := ⟨hSplits⟩
      have hdvd_perm : Nat.card (N₀ ≃ₐ[↥M₁] N₀) ∣ Nat.card (Equiv.Perm ↥(f₀.rootSet N₀)) :=
        Subgroup.card_dvd_of_injective (Polynomial.Gal.galActionHom f₀ N₀)
          (Polynomial.Gal.galActionHom_injective f₀ N₀)
      have hcard_perm : Nat.card (Equiv.Perm ↥(f₀.rootSet N₀)) = p * (p - 1).factorial := by
        rw [Nat.card_eq_fintype_card, Fintype.card_perm, hRootCard, ← Nat.mul_factorial_pred hp_ne]
      rw [← hp_mul_H, hcard_perm] at hdvd_perm
      have hdvd_fac : Nat.card ↥H ∣ (p - 1).factorial :=
        (Nat.mul_dvd_mul_iff_left hp_pos).mp hdvd_perm
      have h_not_dvd : ¬ (p ∣ Nat.card ↥H) := by
        intro hpH
        have hpfac : p ∣ (p - 1).factorial := dvd_trans hpH hdvd_fac
        have hle := (Nat.Prime.dvd_factorial hp).mp hpfac
        omega
      exact ((Nat.Prime.coprime_iff_not_dvd hp).mpr h_not_dvd).symm
    exact ⟨N₀, instNormN₀, instUltraN₀, inferInstance, hFinN₀, hGalN₀, hIso₁, hIsoGal,
      j, hIsoJ, hCoprime, hpDvd⟩

  obtain ⟨N₀, instNormN₀, instUltraN₀, instAlgN₀, hFinN₀, hGalN₀, hIso₁, hIsoGal,
    j, hIsoJ, hCoprime, hpDvd⟩ := h_stage1
  let _ : NontriviallyNormedField N₀ := instNormN₀
  let _ : IsUltrametricDist N₀ := instUltraN₀
  let _ : Algebra ↥M₁ N₀ := instAlgN₀
  have : FiniteDimensional ↥M₁ N₀ := hFinN₀
  have : IsGalois ↥M₁ N₀ := hGalN₀

  let ξ₀ : N₀ := j α₀_M₂
  have hξ₀_aeval : Polynomial.aeval ξ₀ f₀ = 0 := by
    dsimp only [ξ₀]
    rw [Polynomial.aeval_algHom_apply j α₀_M₂ f₀, minpoly.aeval ↥M₁ α₀_M₂, map_zero]
  have hp0_M₁ : (p : ↥M₁) = 0 := Subtype.ext hp0
  have hp0_N₀ : (p : N₀) = 0 := by
    have hcast : (p : N₀) = algebraMap ↥M₁ N₀ (p : ↥M₁) := by simp
    rw [hcast, hp0_M₁, map_zero]
  have : CharP N₀ p := (CharP.charP_iff_prime_eq_zero hp).mpr hp0_N₀

  have h_norm_sub_le : ∀ a b : N₀, ‖a - b‖ ≤ max ‖a‖ ‖b‖ := by
    intro a b
    rw [sub_eq_add_neg]
    refine (IsUltrametricDist.norm_add_le_max a (-b)).trans ?_
    rw [norm_neg]
  have h_ultra_eq : ∀ a b : N₀, ‖b‖ < ‖a‖ → ‖a + b‖ = ‖a‖ := by
    intro a b hlt
    have hne : ‖a‖₊ ≠ ‖b‖₊ := fun heq =>
      ne_of_gt hlt (congrArg (fun t : NNReal => (t : ℝ)) heq)
    exact (congrArg (fun t : NNReal => (t : ℝ))
      (IsUltrametricDist.nnnorm_add_eq_max_of_nnnorm_ne_nnnorm hne)).trans
      (max_eq_left (le_of_lt hlt))
  have h_ultra_sum_nat : ∀ (I : Finset ℕ) (g_fn : ℕ → N₀) (B : ℝ),
      0 < B → (∀ i ∈ I, ‖g_fn i‖ < B) → ‖∑ i ∈ I, g_fn i‖ < B := by
    intro I g_fn B hB hg
    induction I using Finset.induction_on with
    | empty =>
      rw [Finset.sum_empty, norm_zero]
      exact hB
    | @insert i J hi ih =>
      rw [Finset.sum_insert hi]
      refine (IsUltrametricDist.norm_add_le_max _ _).trans_lt (max_lt ?_ ?_)
      · exact hg i (Finset.mem_insert_self i J)
      · exact ih (fun m hm => hg m (Finset.mem_insert_of_mem hm))
  have h_natCast_le_one : ∀ n : ℕ, ‖(n : N₀)‖ ≤ 1 := by
    intro n
    induction n with
    | zero => simp
    | succ n ih =>
      push_cast
      refine (IsUltrametricDist.norm_add_le_max _ _).trans (max_le ih ?_)
      rw [norm_one]
  have h_coprime_norm_one : ∀ m : ℕ, ¬ (p ∣ m) → ‖(m : N₀)‖ = 1 := by
    intro m hm_ndvd
    have hm_zmod : (m : ZMod p) ≠ 0 := mt (ZMod.natCast_eq_zero_iff m p).mp hm_ndvd
    have hpow_zmod : (m : ZMod p) ^ (p - 1) = 1 := ZMod.pow_card_sub_one_eq_one hm_zmod
    let φ_zmod : ZMod p →+* N₀ := ZMod.castHom dvd_rfl N₀
    have hpow_N₀ : (m : N₀) ^ (p - 1) = 1 := by
      have hmap := congrArg φ_zmod hpow_zmod
      simpa only [map_pow, map_natCast, map_one] using hmap
    have hnorm_pow : ‖(m : N₀)‖ ^ (p - 1) = 1 := by
      rw [← norm_pow, hpow_N₀, norm_one]
    rcases lt_trichotomy ‖(m : N₀)‖ 1 with hlt | heq | hgt
    · exfalso
      have : ‖(m : N₀)‖ ^ (p - 1) < 1 := pow_lt_one₀ (norm_nonneg _) hlt (by omega)
      linarith
    · exact heq
    · exfalso
      have : 1 < ‖(m : N₀)‖ ^ (p - 1) := one_lt_pow₀ hgt (by omega)
      linarith

  
  have h_stage2 : ∃ τ : N₀ ≃ₐ[↥M₁] N₀,
      τ ξ₀ ≠ ξ₀ ∧ ∀ w : N₀, w ≠ 0 → ‖τ w - w‖ < ‖w‖ := by
    let E : IntermediateField ↥M₁ N₀ := j.fieldRange
    let H : Subgroup (N₀ ≃ₐ[↥M₁] N₀) := E.fixingSubgroup
    obtain ⟨τ, hτ_ord⟩ := exists_prime_orderOf_dvd_card' p hpDvd
    have hτ_pow_p : τ ^ p = 1 := by rw [← hτ_ord, pow_orderOf_eq_one]
    have hξ₀_mov : τ ξ₀ ≠ ξ₀ := by
      intro hfix_ξ₀
      let F_fix : IntermediateField ↥M₁ ↥M₂ :=
        { carrier := {w : ↥M₂ | τ (j w) = j w}
          algebraMap_mem' := fun c => by
            change τ (j (algebraMap ↥M₁ ↥M₂ c)) = j (algebraMap ↥M₁ ↥M₂ c)
            rw [j.commutes, τ.commutes]
          add_mem' := by
            intro a b ha hb
            change τ (j (a + b)) = j (a + b)
            rw [map_add, map_add, ha, hb]
          zero_mem' := by
            change τ (j 0) = j 0
            rw [map_zero, map_zero]
          mul_mem' := by
            intro a b ha hb
            change τ (j (a * b)) = j (a * b)
            rw [map_mul, map_mul, ha, hb]
          one_mem' := by
            change τ (j 1) = j 1
            rw [map_one, map_one]
          inv_mem' := by
            intro a ha
            change τ (j a⁻¹) = j a⁻¹
            rw [map_inv₀, map_inv₀, ha] }
      have hα₀_in : α₀_M₂ ∈ F_fix := hfix_ξ₀
      have htop_le : (⊤ : IntermediateField ↥M₁ ↥M₂) ≤ F_fix := by
        rw [← h_adj_top]
        exact IntermediateField.adjoin_le_iff.mpr (Set.singleton_subset_iff.mpr hα₀_in)
      have hτ_in_H : τ ∈ H := by
        rintro ⟨y, w, rfl⟩
        exact htop_le (IntermediateField.mem_top : w ∈ (⊤ : IntermediateField ↥M₁ ↥M₂))
      let τ_H : ↥H := ⟨τ, hτ_in_H⟩
      have hord_H : orderOf τ_H = p := (Subgroup.orderOf_mk τ hτ_in_H).trans hτ_ord
      have hdvd_H : p ∣ Nat.card ↥H := hord_H ▸ orderOf_dvd_natCard τ_H
      have hdvd_one : p ∣ 1 := by
        rw [← hCoprime.gcd_eq_one]
        exact Nat.dvd_gcd hdvd_H (dvd_refl p)
      exact hp.not_dvd_one hdvd_one

    let v_N := NormedField.valuation (K := N₀)
    let O_N := v_N.valuationSubring
    let κ_N := IsLocalRing.ResidueField ↥O_N
    let res : ↥O_N →+* κ_N := IsLocalRing.residue ↥O_N
    have h_mem_O : ∀ x : N₀, x ∈ O_N ↔ ‖x‖ ≤ 1 := by
      intro x
      rw [Valuation.mem_valuationSubring_iff, NormedField.valuation_apply]
      exact NNReal.coe_le_coe.symm
    have h_res_zero : ∀ y : ↥O_N, res y = 0 ↔ ‖(y : N₀)‖ < 1 := by
      intro y
      change Ideal.Quotient.mk (IsLocalRing.maximalIdeal ↥O_N) y = 0 ↔ ‖(y : N₀)‖ < 1
      rw [Ideal.Quotient.eq_zero_iff_mem, Valuation.mem_maximalIdeal_iff,
        NormedField.valuation_apply]
      exact NNReal.coe_lt_coe.symm
    have hp0_κ : (p : κ_N) = 0 := by
      have hp0_O : (p : ↥O_N) = 0 := Subtype.ext hp0_N₀
      have hcast : (p : κ_N) = res (p : ↥O_N) := by simp
      rw [hcast, hp0_O, map_zero]
    have : CharP κ_N p := (CharP.charP_iff_prime_eq_zero hp).mpr hp0_κ

    let σ_O : (N₀ ≃ₐ[↥M₁] N₀) → (↥O_N ≃+* ↥O_N) := fun σ =>
      { toFun := fun y => ⟨σ y.1, (h_mem_O _).mpr ((hIsoGal σ y.1).trans_le ((h_mem_O _).mp y.2))⟩
        invFun := fun y => ⟨σ.symm y.1,
          (h_mem_O _).mpr ((hIsoGal σ.symm y.1).trans_le ((h_mem_O _).mp y.2))⟩
        left_inv := fun y => Subtype.ext (σ.symm_apply_apply y.1)
        right_inv := fun y => Subtype.ext (σ.apply_symm_apply y.1)
        map_mul' := fun y₁ y₂ => Subtype.ext (map_mul σ y₁.1 y₂.1)
        map_add' := fun y₁ y₂ => Subtype.ext (map_add σ y₁.1 y₂.1) }
    have h_mapEquiv_res : ∀ (σ : N₀ ≃ₐ[↥M₁] N₀) (y : ↥O_N),
        (IsLocalRing.ResidueField.mapEquiv (σ_O σ)) (res y) = res (σ_O σ y) := by
      intro σ y
      rw [IsLocalRing.ResidueField.mapEquiv_apply, IsLocalRing.ResidueField.map_residue]
      rfl
    let π_res : (N₀ ≃ₐ[↥M₁] N₀) →* RingAut κ_N :=
      { toFun := fun σ => IsLocalRing.ResidueField.mapEquiv (σ_O σ)
        map_one' := by
          ext x
          obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective x
          exact h_mapEquiv_res 1 y
        map_mul' := by
          intro σ₁ σ₂
          ext x
          obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective x
          change (IsLocalRing.ResidueField.mapEquiv (σ_O (σ₁ * σ₂))) (res y) =
            (IsLocalRing.ResidueField.mapEquiv (σ_O σ₁))
              ((IsLocalRing.ResidueField.mapEquiv (σ_O σ₂)) (res y))
          rw [h_mapEquiv_res, h_mapEquiv_res, h_mapEquiv_res]
          rfl }
    have hπ_res_apply : ∀ (σ : N₀ ≃ₐ[↥M₁] N₀) (y : ↥O_N),
        π_res σ (res y) = res (σ_O σ y) := h_mapEquiv_res

    have hπ_τ_one : π_res τ = 1 := by
      let G_bar : Subgroup (RingAut κ_N) := Subgroup.map π_res ⊤
      let H_bar : Subgroup (RingAut κ_N) := Subgroup.map π_res H
      have : Finite ↥G_bar := Finite.of_surjective
        (fun σ : N₀ ≃ₐ[↥M₁] N₀ => (⟨π_res σ, Subgroup.mem_map_of_mem π_res (Subgroup.mem_top σ)⟩ : ↥G_bar))
        (fun ⟨_, σ, _, hσ⟩ => ⟨σ, Subtype.ext hσ⟩)
      have : Finite ↥H_bar := Finite.of_surjective
        (fun σ : ↥H => (⟨π_res σ.1, Subgroup.mem_map_of_mem π_res σ.2⟩ : ↥H_bar))
        (fun ⟨_, σ, hσH, hσ⟩ => ⟨⟨σ, hσH⟩, Subtype.ext hσ⟩)
      let _ : Fintype ↥H := Fintype.ofFinite _
      let _ : Fintype ↥G_bar := Fintype.ofFinite _
      let _ : Fintype ↥H_bar := Fintype.ofFinite _
      have h_sum_H_lt : ∀ (I : Finset ↥H) (g_fn : ↥H → N₀),
          (∀ σ ∈ I, ‖g_fn σ‖ < 1) → ‖∑ σ ∈ I, g_fn σ‖ < 1 := by
        intro I g_fn hg
        classical
        induction I using Finset.induction_on with
        | empty =>
          rw [Finset.sum_empty, norm_zero]
          exact zero_lt_one
        | @insert σ J hσ ih =>
          rw [Finset.sum_insert hσ]
          refine (IsUltrametricDist.norm_add_le_max _ _).trans_lt (max_lt ?_ ?_)
          · exact hg σ (Finset.mem_insert_self σ J)
          · exact ih (fun m hm => hg m (Finset.mem_insert_of_mem hm))
      have hFixedEq : FixedPoints.subfield ↥G_bar κ_N = FixedPoints.subfield ↥H_bar κ_N := by
        apply le_antisymm
        · intro y_bar hy_bar h_bar
          have h_in_G_bar : h_bar.1 ∈ G_bar := Subgroup.map_mono le_top h_bar.2
          exact hy_bar ⟨h_bar.1, h_in_G_bar⟩
        · intro y_bar hy_bar
          obtain ⟨y, rfl⟩ : ∃ y : ↥O_N, res y = y_bar := Ideal.Quotient.mk_surjective y_bar
          have hy_norm : ‖(y : N₀)‖ ≤ 1 := (h_mem_O y.1).mp y.2
          have hH_close : ∀ σ : ↥H, ‖(σ.1 : N₀ ≃ₐ[↥M₁] N₀) y.1 - y.1‖ < 1 := by
            intro σ
            have h_in_H_bar : π_res σ.1 ∈ H_bar := Subgroup.mem_map_of_mem π_res σ.2
            have hfix : π_res σ.1 (res y) = res y := hy_bar ⟨π_res σ.1, h_in_H_bar⟩
            rw [hπ_res_apply] at hfix
            have hzero : res (σ_O σ.1 y - y) = 0 := by
              rw [map_sub, hfix, sub_self]
            exact (h_res_zero (σ_O σ.1 y - y)).mp hzero
          let S : N₀ := ∑ σ : ↥H, (σ.1 : N₀ ≃ₐ[↥M₁] N₀) y.1
          let m₀ : ℕ := Fintype.card ↥H
          have hS_in_E : S ∈ E := by
            rw [← IsGalois.fixedField_fixingSubgroup E]
            intro σ₀
            dsimp only [S]
            change σ₀.1 (∑ σ : ↥H, (σ.1 : N₀ ≃ₐ[↥M₁] N₀) y.1) = _
            rw [map_sum]
            refine Fintype.sum_equiv (Equiv.mulLeft σ₀) _ _ (fun σ => ?_)
            rfl
          obtain ⟨w_M₂, hw_M₂⟩ : ∃ w_M₂ : ↥M₂, j w_M₂ = S := hS_in_E
          have hS_diff : ‖S - (m₀ : N₀) * y.1‖ < 1 := by
            have hid : S - (m₀ : N₀) * y.1 =
                ∑ σ : ↥H, ((σ.1 : N₀ ≃ₐ[↥M₁] N₀) y.1 - y.1) := by
              rw [Finset.sum_sub_distrib, Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
            rw [hid]
            exact h_sum_H_lt Finset.univ (fun σ : ↥H => (σ.1 : N₀ ≃ₐ[↥M₁] N₀) y.1 - y.1)
              (fun σ _ => hH_close σ)
          have hm₀_eq : m₀ = Nat.card ↥H := (Nat.card_eq_fintype_card).symm
          have hm₀_ndvd : ¬ (p ∣ m₀) := by
            rw [hm₀_eq]
            exact (Nat.Prime.coprime_iff_not_dvd hp).mp hCoprime.symm
          have hm₀_norm : ‖(m₀ : N₀)‖ = 1 := h_coprime_norm_one m₀ hm₀_ndvd
          have hm₀_ne : (m₀ : N₀) ≠ 0 := norm_ne_zero_iff.mp (by rw [hm₀_norm]; exact one_ne_zero)
          let w' : ↥M₂ := (m₀ : ↥M₂)⁻¹ * w_M₂
          have hjw' : j w' = (m₀ : N₀)⁻¹ * S := by
            dsimp only [w']
            rw [map_mul, map_inv₀, map_natCast, hw_M₂]
          have hjw'_close : ‖j w' - y.1‖ < 1 := by
            have hid : j w' - y.1 = (m₀ : N₀)⁻¹ * (S - (m₀ : N₀) * y.1) := by
              rw [hjw']
              field_simp
            rw [hid, norm_mul, norm_inv, hm₀_norm, inv_one, one_mul]
            exact hS_diff
          have hjw'_le : ‖j w'‖ ≤ 1 := by
            have hid : j w' = (j w' - y.1) + y.1 := by ring
            rw [hid]
            exact (IsUltrametricDist.norm_add_le_max _ _).trans (max_le (le_of_lt hjw'_close) hy_norm)
          have hw'_le : ‖(w' : F_hat)‖ ≤ 1 := by
            change ‖w'‖ ≤ 1
            rwa [← hIsoJ w']
          obtain ⟨u_M₁, hu_mem, _, hu_close⟩ := hRes (w' : F_hat) w'.2 hw'_le
          let u_sub : ↥M₁ := ⟨u_M₁, hu_mem⟩
          let u_N : N₀ := algebraMap ↥M₁ N₀ u_sub
          have hjw'_u : ‖j w' - u_N‖ < 1 := by
            have hid : j w' - u_N = j (w' - algebraMap ↥M₁ ↥M₂ u_sub) := by
              dsimp only [u_N]
              rw [map_sub, j.commutes]
            rw [hid, hIsoJ]
            exact hu_close
          have hy_u : ‖y.1 - u_N‖ < 1 := by
            have hid : y.1 - u_N = (y.1 - j w') + (j w' - u_N) := by ring
            rw [hid]
            refine (IsUltrametricDist.norm_add_le_max _ _).trans_lt (max_lt ?_ hjw'_u)
            rwa [norm_sub_rev]
          intro g_bar
          obtain ⟨g, _, hg_eq⟩ := Subgroup.mem_map.mp g_bar.2
          change g_bar.1 (res y) = res y
          rw [← hg_eq, hπ_res_apply]
          have hgy_diff : ‖g y.1 - y.1‖ < 1 := by
            have hgu : g u_N = u_N := g.commutes u_sub
            have hid : g y.1 - y.1 = g (y.1 - u_N) - (y.1 - u_N) := by
              rw [map_sub, hgu]
              ring
            rw [hid]
            refine (h_norm_sub_le _ _).trans_lt ?_
            rw [hIsoGal g, max_self]
            exact hy_u
          have hzero : res (σ_O g y - y) = 0 := (h_res_zero (σ_O g y - y)).mpr hgy_diff
          exact sub_eq_zero.mp (by rwa [map_sub] at hzero)
      have hcard_G_H : Nat.card ↥G_bar = Nat.card ↥H_bar := by
        rw [Nat.card_eq_fintype_card, Nat.card_eq_fintype_card]
        have h1 := (FixedPoints.finrank_eq_card ↥G_bar κ_N).symm
        have h2 := FixedPoints.finrank_eq_card ↥H_bar κ_N
        have hfin : Module.finrank ↥(FixedPoints.subfield ↥G_bar κ_N) κ_N =
            Module.finrank ↥(FixedPoints.subfield ↥H_bar κ_N) κ_N :=
          congrArg (fun F : Subfield κ_N => Module.finrank ↥F κ_N) hFixedEq
        exact h1.trans (hfin.trans h2)
      have hdvd_G_H : Nat.card ↥G_bar ∣ Nat.card ↥H := by
        rw [hcard_G_H]
        exact Subgroup.card_map_dvd H π_res
      let τ_bar : ↥G_bar := ⟨π_res τ, Subgroup.mem_map_of_mem π_res (Subgroup.mem_top τ)⟩
      have hτ_bar_pow : τ_bar ^ p = 1 := by
        apply Subtype.ext
        change (π_res τ) ^ p = 1
        rw [← map_pow, hτ_pow_p, map_one]
      have hdvd_p : orderOf τ_bar ∣ p := orderOf_dvd_of_pow_eq_one hτ_bar_pow
      have hdvd_H : orderOf τ_bar ∣ Nat.card ↥H := dvd_trans (orderOf_dvd_natCard τ_bar) hdvd_G_H
      have hdvd_one : orderOf τ_bar ∣ 1 := by
        rw [← hCoprime.gcd_eq_one]
        exact Nat.dvd_gcd hdvd_H hdvd_p
      have hord_one : orderOf τ_bar = 1 := Nat.dvd_one.mp hdvd_one
      have hτ_bar_one : τ_bar = 1 := orderOf_eq_one_iff.mp hord_one
      exact congrArg Subtype.val hτ_bar_one

    refine ⟨τ, hξ₀_mov, fun w hw => ?_⟩
    have hw_pos : 0 < ‖w‖ := norm_pos_iff.mpr hw
    let z : N₀ := τ w / w
    have hz_norm : ∀ ν : ℕ, ‖(τ ^ ν) z‖ ≤ 1 := by
      intro ν
      rw [hIsoGal (τ ^ ν) z]
      dsimp only [z]
      rw [norm_div, hIsoGal τ w, div_self (ne_of_gt hw_pos)]
    let z_O : ℕ → ↥O_N := fun ν => ⟨(τ ^ ν) z, (h_mem_O _).mpr (hz_norm ν)⟩
    have hres_inv : ∀ ν : ℕ, res (z_O ν) = res (z_O 0) := by
      intro ν
      induction ν with
      | zero => rfl
      | succ ν ih =>
        have hstep : z_O (ν + 1) = σ_O τ (z_O ν) := by
          apply Subtype.ext
          change (τ ^ (ν + 1)) z = τ ((τ ^ ν) z)
          rw [pow_succ']
          rfl
        rw [hstep, ← hπ_res_apply τ (z_O ν), hπ_τ_one]
        exact ih
    have hprod_tel : ∀ k : ℕ, ∏ ν ∈ Finset.range k, (τ ^ ν) z = (τ ^ k) w / w := by
      intro k
      induction k with
      | zero =>
        rw [Finset.prod_range_zero, pow_zero, AlgEquiv.one_apply, div_self hw]
      | succ k ih =>
        rw [Finset.prod_range_succ, ih]
        have htk_ne : (τ ^ k) w ≠ 0 := by
          intro h0
          have := hIsoGal (τ ^ k) w
          rw [h0, norm_zero] at this
          linarith
        have hstep : (τ ^ k) z = (τ ^ (k + 1)) w / (τ ^ k) w := by
          dsimp only [z]
          rw [map_div₀, pow_succ]
          rfl
        rw [hstep, div_mul_div_cancel₀' htk_ne]
    have hprod_one_N : ∏ ν ∈ Finset.range p, (τ ^ ν) z = 1 := by
      rw [hprod_tel p, hτ_pow_p, AlgEquiv.one_apply, div_self hw]
    have hprod_one_O : ∏ ν ∈ Finset.range p, z_O ν = 1 := by
      apply Subtype.ext
      change O_N.subtype (∏ ν ∈ Finset.range p, z_O ν) = 1
      rw [map_prod]
      exact hprod_one_N
    have hres_pow : (res (z_O 0)) ^ p = 1 := by
      have hmap := congrArg res hprod_one_O
      rw [map_prod, map_one] at hmap
      have hconst : ∏ ν ∈ Finset.range p, res (z_O ν) = (res (z_O 0)) ^ p := by
        calc ∏ ν ∈ Finset.range p, res (z_O ν)
            = ∏ _ ∈ Finset.range p, res (z_O 0) :=
              Finset.prod_congr rfl (fun ν _ => hres_inv ν)
          _ = (res (z_O 0)) ^ p := by rw [Finset.prod_const, Finset.card_range]
      exact hconst.symm.trans hmap
    have hsub_pow : (res (z_O 0) - 1) ^ p = 0 := by
      rw [sub_pow_char, hres_pow, one_pow, sub_self]
    have hres_eq_one : res (z_O 0) = 1 := by
      by_contra hne
      exact pow_ne_zero p (sub_ne_zero.mpr hne) hsub_pow
    have hres_sub_zero : res (z_O 0 - 1) = 0 := by rw [map_sub, map_one, hres_eq_one, sub_self]
    have hz_sub_lt : ‖z - 1‖ < 1 := by
      have hcoe : ((z_O 0 - 1 : ↥O_N) : N₀) = z - 1 := by
        change (τ ^ 0) z - 1 = z - 1
        simp
      simpa only [hcoe] using (h_res_zero (z_O 0 - 1)).mp hres_sub_zero
    have hid : τ w - w = (z - 1) * w := by
      dsimp only [z]
      field_simp
    rw [hid, norm_mul]
    calc ‖z - 1‖ * ‖w‖ < 1 * ‖w‖ := mul_lt_mul_of_pos_right hz_sub_lt hw_pos
      _ = ‖w‖ := one_mul ‖w‖

  obtain ⟨τ, hξ₀_mov, hτ_lt⟩ := h_stage2

  
  let f_N : Polynomial N₀ := f₀.map (algebraMap ↥M₁ N₀)
  let g : Polynomial N₀ := f_N.comp (Polynomial.X + Polynomial.C ξ₀)
  let ρ : ℝ := ‖τ ξ₀ - ξ₀‖
  have hρ_pos : 0 < ρ := norm_pos_iff.mpr (sub_ne_zero.mpr hξ₀_mov)
  have hρ_le : ρ ≤ r := by
    refine le_of_forall_pos_lt_add (fun ε hε => ?_)
    obtain ⟨x_M₁, hx_mem, hx_lt⟩ := hr_inf ε hε
    let x_sub : ↥M₁ := ⟨x_M₁, hx_mem⟩
    let c_N : N₀ := algebraMap ↥M₁ N₀ x_sub
    have hξ_c : ‖ξ₀ - c_N‖ = ‖α₀ - x_M₁‖ := by
      have hid : ξ₀ - c_N = j (α₀_M₂ - algebraMap ↥M₁ ↥M₂ x_sub) := by
        dsimp only [ξ₀, c_N]
        rw [map_sub, j.commutes]
      rw [hid, hIsoJ]
      rfl
    have hu_eq : τ ξ₀ - ξ₀ = τ (ξ₀ - c_N) - (ξ₀ - c_N) := by
      dsimp only [c_N]
      rw [map_sub, τ.commutes]
      ring
    have hle : ρ ≤ ‖ξ₀ - c_N‖ := by
      dsimp only [ρ]
      rw [hu_eq]
      refine (h_norm_sub_le _ _).trans ?_
      rw [hIsoGal τ, max_self]
    linarith

  have h_stage3 : ‖g.coeff 1‖ = ρ ^ (p - 1) ∧
      ∀ m : ℕ, 2 ≤ m → m < p → ‖g.coeff m‖ < ρ ^ (p - m) := by
    classical
    let u : N₀ := τ ξ₀ - ξ₀
    have hu_ne : u ≠ 0 := sub_ne_zero.mpr hξ₀_mov
    have hf_N_monic : f_N.Monic := hf₀_monic.map (algebraMap ↥M₁ N₀)
    have hf_N_deg : f_N.natDegree = p := by
      rw [hf₀_monic.natDegree_map, hf₀_deg]
    have hf_N_orbit_root : ∀ ν : ℕ, f_N.eval ((τ ^ ν) ξ₀) = 0 := by
      intro ν
      rw [Polynomial.eval_map_algebraMap]
      change Polynomial.aeval ((τ ^ ν).toAlgHom ξ₀) f₀ = 0
      rw [Polynomial.aeval_algHom_apply (τ ^ ν).toAlgHom ξ₀ f₀, hξ₀_aeval, map_zero]
    have hu_orbit_lt : ∀ ν : ℕ, ‖(τ ^ ν) u - u‖ < ρ := by
      intro ν
      induction ν with
      | zero =>
        simp only [pow_zero, AlgEquiv.one_apply, sub_self, norm_zero]
        exact hρ_pos
      | succ ν ih =>
        have hid : (τ ^ (ν + 1)) u - u = τ ((τ ^ ν) u - u) + (τ u - u) := by
          rw [pow_succ', AlgEquiv.mul_apply, map_sub τ ((τ ^ ν) u) u]
          ring
        rw [hid]
        refine (IsUltrametricDist.norm_add_le_max _ _).trans_lt (max_lt ?_ ?_)
        · rw [hIsoGal τ]
          exact ih
        · exact hτ_lt u hu_ne
    have hξ_orbit_lt : ∀ ν : ℕ, ‖((τ ^ ν) ξ₀ - ξ₀) - (ν : N₀) * u‖ < ρ := by
      intro ν
      induction ν with
      | zero =>
        simp only [pow_zero, AlgEquiv.one_apply, sub_self, Nat.cast_zero, zero_mul, norm_zero]
        exact hρ_pos
      | succ ν ih =>
        have hstep : (τ ^ (ν + 1)) ξ₀ = (τ ^ ν) (τ ξ₀) := by
          rw [pow_succ, AlgEquiv.mul_apply]
        have hid : ((τ ^ (ν + 1)) ξ₀ - ξ₀) - ((ν + 1 : ℕ) : N₀) * u =
            (((τ ^ ν) ξ₀ - ξ₀) - (ν : N₀) * u) + ((τ ^ ν) u - u) := by
          have htu : (τ ^ ν) u = (τ ^ ν) (τ ξ₀) - (τ ^ ν) ξ₀ := map_sub (τ ^ ν) (τ ξ₀) ξ₀
          rw [hstep, Nat.cast_add, Nat.cast_one, add_mul, one_mul, htu]
          ring
        rw [hid]
        exact (IsUltrametricDist.norm_add_le_max _ _).trans_lt (max_lt ih (hu_orbit_lt ν))

    have h_orbit_inj : Set.InjOn (fun ν : ℕ => (τ ^ ν) ξ₀) (Finset.range p) := by
      have hlt_ne : ∀ {i j : ℕ}, i < j → j < p → (τ ^ i) ξ₀ ≠ (τ ^ j) ξ₀ := by
        intro i j hij hjp heq
        have hk_ndvd : ¬ (p ∣ (j - i)) := Nat.not_dvd_of_pos_of_lt (by omega) (by omega)
        have hk_norm : ‖((j - i : ℕ) : N₀)‖ = 1 := h_coprime_norm_one (j - i) hk_ndvd
        have hid : (τ ^ j) ξ₀ - (τ ^ i) ξ₀ =
            ((j - i : ℕ) : N₀) * u +
              ((((τ ^ j) ξ₀ - ξ₀) - (j : N₀) * u) - (((τ ^ i) ξ₀ - ξ₀) - (i : N₀) * u)) := by
          rw [Nat.cast_sub (le_of_lt hij)]
          ring
        have herr_lt : ‖(((τ ^ j) ξ₀ - ξ₀) - (j : N₀) * u) -
            (((τ ^ i) ξ₀ - ξ₀) - (i : N₀) * u)‖ < ‖((j - i : ℕ) : N₀) * u‖ := by
          rw [norm_mul, hk_norm, one_mul]
          exact (h_norm_sub_le _ _).trans_lt (max_lt (hξ_orbit_lt j) (hξ_orbit_lt i))
        have hdiff_norm : ‖(τ ^ j) ξ₀ - (τ ^ i) ξ₀‖ = ρ := by
          rw [hid, h_ultra_eq _ _ herr_lt, norm_mul, hk_norm, one_mul]
        rw [heq, sub_self, norm_zero] at hdiff_norm
        linarith
      intro i hi j hj hij_eq
      simp only [Finset.coe_range, Set.mem_Iio] at hi hj
      rcases lt_trichotomy i j with hlt | rfl | hgt
      · exact absurd hij_eq (hlt_ne hlt hj)
      · rfl
      · exact absurd hij_eq.symm (hlt_ne hgt hi)

    have h_nat_inj : Set.InjOn (fun ν : ℕ => (ν : N₀)) (Finset.range p) := by
      have hlt_ne : ∀ {i j : ℕ}, i < j → j < p → (i : N₀) ≠ (j : N₀) := by
        intro i j hij hjp heq
        have hk_ndvd : ¬ (p ∣ (j - i)) := Nat.not_dvd_of_pos_of_lt (by omega) (by omega)
        have hk_norm : ‖((j - i : ℕ) : N₀)‖ = 1 := h_coprime_norm_one (j - i) hk_ndvd
        have hsub : ((j - i : ℕ) : N₀) = (j : N₀) - (i : N₀) := Nat.cast_sub (le_of_lt hij)
        rw [hsub, heq, sub_self, norm_zero] at hk_norm
        norm_num at hk_norm
      intro i hi j hj hij_eq
      simp only [Finset.coe_range, Set.mem_Iio] at hi hj
      rcases lt_trichotomy i j with hlt | rfl | hgt
      · exact absurd hij_eq (hlt_ne hlt hj)
      · rfl
      · exact absurd hij_eq.symm (hlt_ne hgt hi)

    have h_monic_eq : ∀ (P Q : Polynomial N₀) (S : Finset N₀),
        P.Monic → Q.Monic → P.natDegree = p → Q.natDegree = p →
        S.card = p → (∀ x ∈ S, P.eval x = Q.eval x) → P = Q := by
      intro P Q S hPm hQm hPd hQd hSc hEq
      by_contra hne
      let D : Polynomial N₀ := P - Q
      have hD_ne : D ≠ 0 := sub_ne_zero.mpr hne
      have hD_deg : D.natDegree ≤ p - 1 := by
        rw [Polynomial.natDegree_le_iff_coeff_eq_zero]
        intro n hn
        dsimp only [D]
        rw [Polynomial.coeff_sub]
        rcases eq_or_lt_of_le (by omega : p ≤ n) with rfl | hgt
        · have hPc : P.coeff P.natDegree = 1 := hPm.coeff_natDegree
          have hQc : Q.coeff Q.natDegree = 1 := hQm.coeff_natDegree
          rw [hPd] at hPc
          rw [hQd] at hQc
          rw [hPc, hQc, sub_self]
        · rw [Polynomial.coeff_eq_zero_of_natDegree_lt (by omega),
            Polynomial.coeff_eq_zero_of_natDegree_lt (by omega), sub_zero]
      have hS_sub : S ⊆ D.roots.toFinset := by
        intro x hx
        rw [Multiset.mem_toFinset, Polynomial.mem_roots hD_ne, Polynomial.IsRoot.def,
          Polynomial.eval_sub, hEq x hx, sub_self]
      have hcard1 : p ≤ D.roots.toFinset.card := hSc ▸ Finset.card_le_card hS_sub
      have hcard2 : D.roots.toFinset.card ≤ D.roots.card := Multiset.toFinset_card_le D.roots
      have hcard3 : D.roots.card ≤ D.natDegree := Polynomial.card_roots' D
      omega

    have hf_N_prod : f_N = ∏ ν ∈ Finset.range p, (Polynomial.X - Polynomial.C ((τ ^ ν) ξ₀)) := by
      let Q := ∏ ν ∈ Finset.range p, (Polynomial.X - Polynomial.C ((τ ^ ν) ξ₀))
      have hQm : Q.Monic :=
        Polynomial.monic_prod_of_monic _ _ (fun ν _ => Polynomial.monic_X_sub_C _)
      have hQd : Q.natDegree = p := by
        dsimp only [Q]
        rw [Polynomial.natDegree_finsetProd_X_sub_C_eq_card, Finset.card_range]
      let S : Finset N₀ := (Finset.range p).image (fun ν => (τ ^ ν) ξ₀)
      have hSc : S.card = p := by
        rw [Finset.card_image_of_injOn h_orbit_inj, Finset.card_range]
      refine h_monic_eq f_N Q S hf_N_monic hQm hf_N_deg hQd hSc (fun x hx => ?_)
      obtain ⟨ν, hν, rfl⟩ := Finset.mem_image.mp hx
      rw [hf_N_orbit_root ν, Polynomial.eval_prod]
      symm
      exact Finset.prod_eq_zero hν (by simp)

    have h_prod_comp : ∀ (J : Finset ℕ) (F : ℕ → Polynomial N₀) (R : Polynomial N₀),
        (∏ ν ∈ J, F ν).comp R = ∏ ν ∈ J, (F ν).comp R := by
      intro J F R
      induction J using Finset.induction_on with
      | empty => simp
      | @insert a J ha ih => rw [Finset.prod_insert ha, Finset.prod_insert ha, Polynomial.mul_comp, ih]

    have hg_prod : g = ∏ ν ∈ Finset.range p, (Polynomial.X - Polynomial.C ((τ ^ ν) ξ₀ - ξ₀)) := by
      dsimp only [g]
      rw [hf_N_prod, h_prod_comp]
      refine Finset.prod_congr rfl (fun ν _ => ?_)
      rw [Polynomial.sub_comp, Polynomial.X_comp, Polynomial.C_comp, map_sub]
      ring

    let h₀ : Polynomial N₀ := ∏ ν ∈ Finset.range p, (Polynomial.X - Polynomial.C (ν : N₀))
    have hh₀_eq : h₀ = Polynomial.X ^ p - Polynomial.X := by
      have hPm : (Polynomial.X ^ p - Polynomial.X : Polynomial N₀).Monic := by
        refine Polynomial.Monic.sub_of_left (Polynomial.monic_X_pow p) ?_
        rw [Polynomial.degree_X, Polynomial.degree_X_pow]
        exact_mod_cast hp2
      have hPd : (Polynomial.X ^ p - Polynomial.X : Polynomial N₀).natDegree = p := by
        rw [Polynomial.natDegree_sub_eq_left_of_natDegree_lt, Polynomial.natDegree_X_pow]
        rw [Polynomial.natDegree_X, Polynomial.natDegree_X_pow]
        exact hp2
      have hQm : h₀.Monic :=
        Polynomial.monic_prod_of_monic _ _ (fun ν _ => Polynomial.monic_X_sub_C _)
      have hQd : h₀.natDegree = p := by
        dsimp only [h₀]
        rw [Polynomial.natDegree_finsetProd_X_sub_C_eq_card, Finset.card_range]
      let S₀ : Finset N₀ := (Finset.range p).image (fun ν : ℕ => (ν : N₀))
      have hS₀c : S₀.card = p := by
        rw [Finset.card_image_of_injOn h_nat_inj, Finset.card_range]
      refine (h_monic_eq (Polynomial.X ^ p - Polynomial.X) h₀ S₀ hPm hQm hPd hQd hS₀c
        (fun x hx => ?_)).symm
      obtain ⟨ν, hν, rfl⟩ := Finset.mem_image.mp hx
      have hpow_ν : (ν : N₀) ^ p = (ν : N₀) := by
        let φ_zmod : ZMod p →+* N₀ := ZMod.castHom dvd_rfl N₀
        have hzmod : (ν : ZMod p) ^ p = (ν : ZMod p) := ZMod.pow_card (ν : ZMod p)
        have hmap := congrArg φ_zmod hzmod
        simpa only [map_pow, map_natCast] using hmap
      rw [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, hpow_ν, sub_self,
        Polynomial.eval_prod]
      symm
      exact Finset.prod_eq_zero hν (by simp)

    let w_ν : ℕ → N₀ := fun ν => ((τ ^ ν) ξ₀ - ξ₀) / u
    have hw_ν_close : ∀ ν : ℕ, ‖w_ν ν - (ν : N₀)‖ < 1 := by
      intro ν
      have hid : w_ν ν - (ν : N₀) = (((τ ^ ν) ξ₀ - ξ₀) - (ν : N₀) * u) / u := by
        dsimp only [w_ν]
        field_simp
      rw [hid, norm_div]
      exact (div_lt_one hρ_pos).mpr (hξ_orbit_lt ν)
    have hw_ν_le : ∀ ν : ℕ, ‖w_ν ν‖ ≤ 1 := by
      intro ν
      have hid : w_ν ν = (w_ν ν - (ν : N₀)) + (ν : N₀) := by ring
      rw [hid]
      exact (IsUltrametricDist.norm_add_le_max _ _).trans
        (max_le (le_of_lt (hw_ν_close ν)) (h_natCast_le_one ν))

    have h_lin_mul_le : ∀ (c : N₀) (P : Polynomial N₀),
        ‖c‖ ≤ 1 → (∀ m : ℕ, ‖P.coeff m‖ ≤ 1) →
        ∀ m : ℕ, ‖((Polynomial.X - Polynomial.C c) * P).coeff m‖ ≤ 1 := by
      intro c P hc hP m
      rw [sub_mul, Polynomial.coeff_sub, Polynomial.coeff_C_mul]
      refine (h_norm_sub_le _ _).trans (max_le ?_ ?_)
      · rcases m with _ | m
        · rw [Polynomial.coeff_X_mul_zero, norm_zero]
          exact zero_le_one
        · rw [Polynomial.coeff_X_mul]
          exact hP m
      · rw [norm_mul]
        calc ‖c‖ * ‖P.coeff m‖ ≤ 1 * 1 :=
              mul_le_mul hc (hP m) (norm_nonneg _) zero_le_one
          _ = 1 := one_mul 1

    have h_lin_mul_lt : ∀ (c : N₀) (P : Polynomial N₀),
        ‖c‖ ≤ 1 → (∀ m : ℕ, ‖P.coeff m‖ < 1) →
        ∀ m : ℕ, ‖((Polynomial.X - Polynomial.C c) * P).coeff m‖ < 1 := by
      intro c P hc hP m
      rw [sub_mul, Polynomial.coeff_sub, Polynomial.coeff_C_mul]
      refine (h_norm_sub_le _ _).trans_lt (max_lt ?_ ?_)
      · rcases m with _ | m
        · rw [Polynomial.coeff_X_mul_zero, norm_zero]
          exact zero_lt_one
        · rw [Polynomial.coeff_X_mul]
          exact hP m
      · rw [norm_mul]
        calc ‖c‖ * ‖P.coeff m‖ ≤ 1 * ‖P.coeff m‖ :=
              mul_le_mul_of_nonneg_right hc (norm_nonneg _)
          _ = ‖P.coeff m‖ := one_mul _
          _ < 1 := hP m

    have h_gauss_ind : ∀ J : Finset ℕ,
        (∀ m : ℕ, ‖(∏ ν ∈ J, (Polynomial.X - Polynomial.C (ν : N₀))).coeff m‖ ≤ 1) ∧
        (∀ m : ℕ, ‖((∏ ν ∈ J, (Polynomial.X - Polynomial.C (w_ν ν))) -
          (∏ ν ∈ J, (Polynomial.X - Polynomial.C (ν : N₀)))).coeff m‖ < 1) := by
      intro J
      induction J using Finset.induction_on with
      | empty =>
        simp only [Finset.prod_empty, sub_self, Polynomial.coeff_zero, norm_zero, zero_lt_one,
          implies_true, and_true]
        intro m
        rw [Polynomial.coeff_one]
        split_ifs <;> simp
      | @insert a J ha ih =>
        rcases ih with ⟨ih_le, ih_lt⟩
        rw [Finset.prod_insert ha, Finset.prod_insert ha]
        refine ⟨h_lin_mul_le (a : N₀) _ (h_natCast_le_one a) ih_le, fun m => ?_⟩
        let A := ∏ ν ∈ J, (Polynomial.X - Polynomial.C (w_ν ν))
        let B := ∏ ν ∈ J, (Polynomial.X - Polynomial.C (ν : N₀))
        have hid : (Polynomial.X - Polynomial.C (w_ν a)) * A -
            (Polynomial.X - Polynomial.C (a : N₀)) * B =
            (Polynomial.X - Polynomial.C (w_ν a)) * (A - B) +
            Polynomial.C ((a : N₀) - w_ν a) * B := by
          rw [map_sub]
          ring
        change ‖((Polynomial.X - Polynomial.C (w_ν a)) * A -
          (Polynomial.X - Polynomial.C (a : N₀)) * B).coeff m‖ < 1
        rw [hid, Polynomial.coeff_add, Polynomial.coeff_C_mul]
        refine (IsUltrametricDist.norm_add_le_max _ _).trans_lt
          (max_lt (h_lin_mul_lt (w_ν a) (A - B) (hw_ν_le a) ih_lt m) ?_)
        rw [norm_mul, norm_sub_rev]
        calc ‖w_ν a - (a : N₀)‖ * ‖B.coeff m‖ ≤ ‖w_ν a - (a : N₀)‖ * 1 :=
              mul_le_mul_of_nonneg_left (ih_le m) (norm_nonneg _)
          _ = ‖w_ν a - (a : N₀)‖ := mul_one _
          _ < 1 := hw_ν_close a

    let h_poly : Polynomial N₀ := ∏ ν ∈ Finset.range p, (Polynomial.X - Polynomial.C (w_ν ν))
    have hh_diff : ∀ m : ℕ, ‖(h_poly - (Polynomial.X ^ p - Polynomial.X)).coeff m‖ < 1 := by
      rw [← hh₀_eq]
      exact (h_gauss_ind (Finset.range p)).2
    have hh₁ : ‖h_poly.coeff 1‖ = 1 := by
      have hd1 := hh_diff 1
      have hxp1 : (Polynomial.X ^ p - Polynomial.X : Polynomial N₀).coeff 1 = -1 := by
        rw [Polynomial.coeff_sub, Polynomial.coeff_X_pow, Polynomial.coeff_X_one]
        have : ¬ (1 = p) := by omega
        simp [this]
      rw [Polynomial.coeff_sub, hxp1] at hd1
      have hid : h_poly.coeff 1 = (-1 : N₀) + (h_poly.coeff 1 - (-1 : N₀)) := by ring
      have hlt : ‖h_poly.coeff 1 - (-1 : N₀)‖ < ‖(-1 : N₀)‖ := by rwa [norm_neg, norm_one]
      rw [hid, h_ultra_eq _ _ hlt, norm_neg, norm_one]
    have hh_mid : ∀ m : ℕ, 2 ≤ m → m < p → ‖h_poly.coeff m‖ < 1 := by
      intro m hm2 hmp
      have hdm := hh_diff m
      have hxpm : (Polynomial.X ^ p - Polynomial.X : Polynomial N₀).coeff m = 0 := by
        rw [Polynomial.coeff_sub, Polynomial.coeff_X_pow, Polynomial.coeff_X]
        have h1 : ¬ (m = p) := by omega
        have h2 : ¬ (1 = m) := by omega
        simp [h1, h2]
      rwa [Polynomial.coeff_sub, hxpm, sub_zero] at hdm

    have h_scale_coeff : ∀ (P : Polynomial N₀) (m : ℕ),
        (P.comp (Polynomial.C u * Polynomial.X)).coeff m = P.coeff m * u ^ m := by
      intro P m
      induction P using Polynomial.induction_on' with
      | add P₁ P₂ ih₁ ih₂ =>
        rw [Polynomial.add_comp, Polynomial.coeff_add, Polynomial.coeff_add, ih₁, ih₂, add_mul]
      | monomial n a =>
        rw [Polynomial.monomial_comp, mul_pow, ← map_pow,
          ← mul_assoc, ← map_mul, Polynomial.C_mul_X_pow_eq_monomial,
          Polynomial.coeff_monomial, Polynomial.coeff_monomial]
        split_ifs with hnm <;> simp [hnm]
    have hg_scale : g.comp (Polynomial.C u * Polynomial.X) = Polynomial.C (u ^ p) * h_poly := by
      rw [hg_prod, h_prod_comp]
      have hprod_u : ∏ ν ∈ Finset.range p,
          (Polynomial.X - Polynomial.C ((τ ^ ν) ξ₀ - ξ₀)).comp (Polynomial.C u * Polynomial.X) =
          ∏ ν ∈ Finset.range p, (Polynomial.C u * (Polynomial.X - Polynomial.C (w_ν ν))) := by
        refine Finset.prod_congr rfl (fun ν _ => ?_)
        rw [Polynomial.sub_comp, Polynomial.X_comp, Polynomial.C_comp]
        have huw : u * w_ν ν = (τ ^ ν) ξ₀ - ξ₀ := mul_div_cancel₀ _ hu_ne
        rw [← huw, map_mul]
        ring
      rw [hprod_u, Finset.prod_mul_distrib, Finset.prod_const, Finset.card_range, ← map_pow]
    have hg_coeff_norm : ∀ m : ℕ, 1 ≤ m → m < p →
        ‖g.coeff m‖ = ρ ^ (p - m) * ‖h_poly.coeff m‖ := by
      intro m _ hmp
      have hcm := congrArg (fun P : Polynomial N₀ => P.coeff m) hg_scale
      rw [h_scale_coeff g m, Polynomial.coeff_C_mul] at hcm
      have hnorm := congrArg norm hcm
      rw [norm_mul, norm_pow, norm_mul, norm_pow] at hnorm
      change ‖g.coeff m‖ * ρ ^ m = ρ ^ p * ‖h_poly.coeff m‖ at hnorm
      have hpow_split : ρ ^ p = ρ ^ (p - m) * ρ ^ m := by
        rw [← pow_add, Nat.sub_add_cancel (le_of_lt hmp)]
      rw [hpow_split, mul_right_comm] at hnorm
      exact mul_right_cancel₀ (ne_of_gt (pow_pos hρ_pos m)) hnorm
    refine ⟨?_, fun m hm2 hmp => ?_⟩
    · rw [hg_coeff_norm 1 le_rfl hp2, hh₁, mul_one]
    · rw [hg_coeff_norm m (by omega) hmp]
      calc ρ ^ (p - m) * ‖h_poly.coeff m‖ < ρ ^ (p - m) * 1 :=
            mul_lt_mul_of_pos_left (hh_mid m hm2 hmp) (pow_pos hρ_pos _)
        _ = ρ ^ (p - m) := mul_one _

  obtain ⟨hg₁, hg_mid⟩ := h_stage3

  
  have hf_N_deg : f_N.natDegree = p := by
    rw [hf₀_monic.natDegree_map, hf₀_deg]
  have hg_deg : g.natDegree = p := by
    dsimp only [g]
    rw [Polynomial.natDegree_comp, hf_N_deg, Polynomial.natDegree_X_add_C, mul_one]
  have hg_sum : g = ∑ m ∈ Finset.range (p + 1), Polynomial.monomial m (g.coeff m) :=
    Polynomial.as_sum_range' g (p + 1) (by omega)

  have h_recenter_coeff : ∀ (c : ↥M₁) (k : ℕ), 1 ≤ k → k < p →
      algebraMap ↥M₁ N₀ ((f₀.comp (Polynomial.X + Polynomial.C c)).coeff k) =
        ∑ m ∈ Finset.Ico k p,
          ((m.choose k : N₀) * g.coeff m) * (-(ξ₀ - algebraMap ↥M₁ N₀ c)) ^ (m - k) := by
    intro c k hk1 hkp
    let c_N : N₀ := algebraMap ↥M₁ N₀ c
    let ξ₀_shift : N₀ := ξ₀ - c_N
    have hpoly_eq : (f₀.comp (Polynomial.X + Polynomial.C c)).map (algebraMap ↥M₁ N₀) =
        g.comp (Polynomial.X + Polynomial.C (-ξ₀_shift)) := by
      dsimp only [g, f_N]
      rw [Polynomial.map_comp, Polynomial.map_add, Polynomial.map_X, Polynomial.map_C,
        Polynomial.comp_assoc]
      congr 1
      rw [Polynomial.add_comp, Polynomial.X_comp, Polynomial.C_comp]
      have hsub_c : -ξ₀_shift + ξ₀ = c_N := by dsimp only [ξ₀_shift]; ring
      rw [add_assoc, ← Polynomial.C_add, hsub_c]
    have hcoeff_eq : algebraMap ↥M₁ N₀ ((f₀.comp (Polynomial.X + Polynomial.C c)).coeff k) =
        (g.comp (Polynomial.X + Polynomial.C (-ξ₀_shift))).coeff k := by
      rw [← Polynomial.coeff_map, hpoly_eq]
    rw [hcoeff_eq, ← Polynomial.taylor_apply (-ξ₀_shift) g, Polynomial.taylor_coeff]
    conv_lhs => rw [hg_sum]
    rw [map_sum, Polynomial.eval_finsetSum]
    have hterm : ∀ m : ℕ,
        ((Polynomial.hasseDeriv k) (Polynomial.monomial m (g.coeff m))).eval (-ξ₀_shift) =
          ((m.choose k : N₀) * g.coeff m) * (-ξ₀_shift) ^ (m - k) := by
      intro m
      rw [Polynomial.hasseDeriv_monomial, Polynomial.eval_monomial]
    simp_rw [hterm]
    rw [Finset.sum_range_succ]
    have hp_choose : (p.choose k : N₀) = 0 :=
      (CharP.cast_eq_zero_iff N₀ p (p.choose k)).mpr
        (Nat.Prime.dvd_choose_self hp (by omega) hkp)
    rw [hp_choose, zero_mul, zero_mul, add_zero, Finset.range_eq_Ico,
      ← Finset.sum_Ico_consecutive _ (Nat.zero_le k) (le_of_lt hkp)]
    have hlow_zero : ∑ m ∈ Finset.Ico 0 k,
        ((m.choose k : N₀) * g.coeff m) * (-ξ₀_shift) ^ (m - k) = 0 := by
      refine Finset.sum_eq_zero (fun m hm => ?_)
      rw [Finset.mem_Ico] at hm
      rw [Nat.choose_eq_zero_of_lt hm.2, Nat.cast_zero, zero_mul, zero_mul]
    rw [hlow_zero, zero_add]

  have h_summand_le : ∀ (m k : ℕ) (z : N₀),
      ‖((m.choose k : N₀) * g.coeff m) * (-z) ^ (m - k)‖ ≤
        ‖g.coeff m‖ * ‖z‖ ^ (m - k) := by
    intro m k z
    rw [norm_mul, norm_mul, norm_pow, norm_neg]
    calc ‖(m.choose k : N₀)‖ * ‖g.coeff m‖ * ‖z‖ ^ (m - k)
        ≤ 1 * ‖g.coeff m‖ * ‖z‖ ^ (m - k) :=
          mul_le_mul_of_nonneg_right
            (mul_le_mul_of_nonneg_right (h_natCast_le_one _) (norm_nonneg _))
            (pow_nonneg (norm_nonneg _) _)
      _ = ‖g.coeff m‖ * ‖z‖ ^ (m - k) := by ring

  have h_ξ_norm_c : ∀ c : ↥M₁, ‖ξ₀ - algebraMap ↥M₁ N₀ c‖ = ‖α₀ - (c : F_hat)‖ := by
    intro c
    have hid : ξ₀ - algebraMap ↥M₁ N₀ c = j (α₀_M₂ - algebraMap ↥M₁ ↥M₂ c) := by
      dsimp only [ξ₀]
      rw [map_sub, j.commutes]
    rw [hid, hIsoJ]
    rfl

  have h_cont_delta : ∀ θ : ℝ, 0 ≤ θ → θ < 1 →
      ∃ δ₀ : ℝ, 0 < δ₀ ∧ ∀ t : ℝ, r < t → t < r + δ₀ →
        θ * t ^ p < r ^ p ∧ θ * t ^ (p - 1) < r ^ (p - 1) := by
    intro θ _ hθ1
    have hε : 0 < r ^ p - θ * r ^ p := by
      have : r ^ p - θ * r ^ p = (1 - θ) * r ^ p := by ring
      rw [this]
      exact mul_pos (by linarith) (pow_pos hr_pos p)
    have hcont : Continuous (fun t : ℝ => θ * t ^ p) :=
      continuous_const.mul (continuous_pow p)
    obtain ⟨δ₀, hδ₀_pos, hδ₀_spec⟩ :=
      Metric.continuousAt_iff.mp (hcont.continuousAt (x := r)) (r ^ p - θ * r ^ p) hε
    refine ⟨δ₀, hδ₀_pos, fun t hrt ht_lt => ?_⟩
    have hdist : dist t r < δ₀ := by
      rw [Real.dist_eq, abs_of_pos (by linarith)]
      linarith
    have hval := hδ₀_spec hdist
    rw [Real.dist_eq] at hval
    have htp : θ * t ^ p < r ^ p := by linarith [(abs_lt.mp hval).2]
    refine ⟨htp, ?_⟩
    have ht_pos : 0 < t := lt_trans hr_pos hrt
    have h_lhs : t * (θ * t ^ (p - 1)) = θ * t ^ p := by
      have hpow : t * t ^ (p - 1) = t ^ p := by
        rw [← pow_succ', Nat.sub_add_cancel (by omega : 1 ≤ p)]
      calc t * (θ * t ^ (p - 1)) = θ * (t * t ^ (p - 1)) := by ring
        _ = θ * t ^ p := by rw [hpow]
    have h_rhs : r ^ p < t * r ^ (p - 1) := by
      have hpow : r ^ p = r * r ^ (p - 1) := by
        rw [← pow_succ', Nat.sub_add_cancel (by omega : 1 ≤ p)]
      rw [hpow]
      exact mul_lt_mul_of_pos_right hrt (pow_pos hr_pos (p - 1))
    exact lt_of_mul_lt_mul_left (by linarith) (le_of_lt ht_pos)

  rcases lt_or_eq_of_le hρ_le with hρ_lt | hρ_eq
  · 
    let S_all : Finset ℝ := (Finset.Ico 1 p).image (fun m => ‖g.coeff m‖ / r ^ (p - m))
    have hS_ne : S_all.Nonempty :=
      ⟨_, Finset.mem_image_of_mem _ (Finset.mem_Ico.mpr ⟨le_rfl, hp2⟩)⟩
    let θ : ℝ := S_all.max' hS_ne
    have hθ_bounds : 0 ≤ θ ∧ θ < 1 := by
      have hmem : θ ∈ S_all := Finset.max'_mem S_all hS_ne
      obtain ⟨m₀, hm₀, hm₀_eq⟩ := Finset.mem_image.mp hmem
      rw [Finset.mem_Ico] at hm₀
      rw [← hm₀_eq]
      refine ⟨div_nonneg (norm_nonneg _) (pow_nonneg (le_of_lt hr_pos) _),
        (div_lt_one (pow_pos hr_pos _)).mpr ?_⟩
      rcases eq_or_lt_of_le hm₀.1 with rfl | hm₀_gt
      · rw [hg₁]
        exact pow_lt_pow_left₀ hρ_lt (le_of_lt hρ_pos) (by omega)
      · exact (hg_mid m₀ (by omega) hm₀.2).trans
          (pow_lt_pow_left₀ hρ_lt (le_of_lt hρ_pos) (by omega))
    have hθ_coeff : ∀ m ∈ Finset.Ico 1 p, ‖g.coeff m‖ ≤ θ * r ^ (p - m) := by
      intro m hm
      have hle : ‖g.coeff m‖ / r ^ (p - m) ≤ θ :=
        Finset.le_max' S_all _ (Finset.mem_image_of_mem _ hm)
      exact (div_le_iff₀ (pow_pos hr_pos _)).mp hle
    obtain ⟨δ₀, hδ₀_pos, hδ₀_spec⟩ := h_cont_delta θ hθ_bounds.1 hθ_bounds.2
    refine ⟨δ₀, hδ₀_pos, Or.inr (fun c hc_lt k hk1 hkp => ?_)⟩
    let r₀ : ℝ := ‖α₀ - (c : F_hat)‖
    have hr_r₀ : r < r₀ := hr_lt (c : F_hat) c.2
    have hr₀_pos : 0 < r₀ := lt_trans hr_pos hr_r₀
    have hθ_p : θ * r₀ ^ p < r ^ p := (hδ₀_spec r₀ hr_r₀ hc_lt).1
    have hnorm_lhs : ‖((f₀.comp (Polynomial.X + Polynomial.C c)).coeff k : F_hat)‖ =
        ‖algebraMap ↥M₁ N₀ ((f₀.comp (Polynomial.X + Polynomial.C c)).coeff k)‖ :=
      (hIso₁ _).symm
    rw [hnorm_lhs, h_recenter_coeff c k hk1 hkp, ← lt_div_iff₀ (pow_pos hr₀_pos k)]
    refine h_ultra_sum_nat (Finset.Ico k p) _ (r ^ p / r₀ ^ k)
      (div_pos (pow_pos hr_pos p) (pow_pos hr₀_pos k)) (fun m hm => ?_)
    rw [Finset.mem_Ico] at hm
    rw [lt_div_iff₀ (pow_pos hr₀_pos k)]
    have hm_in : m ∈ Finset.Ico 1 p := Finset.mem_Ico.mpr ⟨by omega, hm.2⟩
    have hterm_le := h_summand_le m k (ξ₀ - algebraMap ↥M₁ N₀ c)
    rw [h_ξ_norm_c c] at hterm_le
    have hpow_m : r₀ ^ (m - k) * r₀ ^ k = r₀ ^ m := by
      rw [← pow_add, Nat.sub_add_cancel hm.1]
    have hpow_p : r₀ ^ (p - m) * r₀ ^ m = r₀ ^ p := by
      rw [← pow_add, Nat.sub_add_cancel (le_of_lt hm.2)]
    calc ‖((m.choose k : N₀) * g.coeff m) * (-(ξ₀ - algebraMap ↥M₁ N₀ c)) ^ (m - k)‖ * r₀ ^ k
        ≤ (‖g.coeff m‖ * r₀ ^ (m - k)) * r₀ ^ k :=
          mul_le_mul_of_nonneg_right hterm_le (pow_nonneg (le_of_lt hr₀_pos) k)
      _ = ‖g.coeff m‖ * r₀ ^ m := by rw [mul_assoc, hpow_m]
      _ ≤ (θ * r ^ (p - m)) * r₀ ^ m :=
          mul_le_mul_of_nonneg_right (hθ_coeff m hm_in) (pow_nonneg (le_of_lt hr₀_pos) m)
      _ ≤ (θ * r₀ ^ (p - m)) * r₀ ^ m :=
          mul_le_mul_of_nonneg_right
            (mul_le_mul_of_nonneg_left
              (pow_le_pow_left₀ (le_of_lt hr_pos) (le_of_lt hr_r₀) (p - m)) hθ_bounds.1)
            (pow_nonneg (le_of_lt hr₀_pos) m)
      _ = θ * r₀ ^ p := by rw [mul_assoc, hpow_p]
      _ < r ^ p := hθ_p

  · 
    let S_mid : Finset ℝ := (Finset.Ico 2 p).image (fun m => ‖g.coeff m‖ / r ^ (p - m))
    let θ : ℝ := if h : S_mid.Nonempty then S_mid.max' h else 0
    have hθ_bounds : 0 ≤ θ ∧ θ < 1 := by
      dsimp only [θ]
      split_ifs with h
      · have hmem : S_mid.max' h ∈ S_mid := Finset.max'_mem S_mid h
        obtain ⟨m₀, hm₀, hm₀_eq⟩ := Finset.mem_image.mp hmem
        rw [Finset.mem_Ico] at hm₀
        rw [← hm₀_eq]
        refine ⟨div_nonneg (norm_nonneg _) (pow_nonneg (le_of_lt hr_pos) _),
          (div_lt_one (pow_pos hr_pos _)).mpr ?_⟩
        rw [← hρ_eq]
        exact hg_mid m₀ hm₀.1 hm₀.2
      · exact ⟨le_rfl, zero_lt_one⟩
    have hθ_coeff : ∀ m ∈ Finset.Ico 2 p, ‖g.coeff m‖ ≤ θ * r ^ (p - m) := by
      intro m hm
      have h_ne : S_mid.Nonempty := ⟨_, Finset.mem_image_of_mem _ hm⟩
      have hθ_eq : θ = S_mid.max' h_ne := by
        dsimp only [θ]
        split_ifs
        rfl
      rw [hθ_eq]
      have hle : ‖g.coeff m‖ / r ^ (p - m) ≤ S_mid.max' h_ne :=
        Finset.le_max' S_mid _ (Finset.mem_image_of_mem _ hm)
      exact (div_le_iff₀ (pow_pos hr_pos _)).mp hle
    obtain ⟨δ₀, hδ₀_pos, hδ₀_spec⟩ := h_cont_delta θ hθ_bounds.1 hθ_bounds.2
    refine ⟨δ₀, hδ₀_pos, Or.inl (fun c hc_lt => ?_)⟩
    let r₀ : ℝ := ‖α₀ - (c : F_hat)‖
    have hr_r₀ : r < r₀ := hr_lt (c : F_hat) c.2
    have hr₀_pos : 0 < r₀ := lt_trans hr_pos hr_r₀
    obtain ⟨hθ_p, hθ_pm1⟩ := hδ₀_spec r₀ hr_r₀ hc_lt
    refine ⟨?_, fun k hk2 hkp => ?_⟩
    · 
      have hnorm_lhs : ‖((f₀.comp (Polynomial.X + Polynomial.C c)).coeff 1 : F_hat)‖ =
          ‖algebraMap ↥M₁ N₀ ((f₀.comp (Polynomial.X + Polynomial.C c)).coeff 1)‖ :=
        (hIso₁ _).symm
      rw [hnorm_lhs, h_recenter_coeff c 1 le_rfl hp2,
        ← Finset.sum_Ico_consecutive _ (by omega : 1 ≤ 2) hp2,
        Nat.Ico_succ_singleton, Finset.sum_singleton]
      simp only [Nat.choose_self, Nat.cast_one, one_mul, Nat.sub_self, pow_zero, mul_one]
      have hg₁_r : ‖g.coeff 1‖ = r ^ (p - 1) := by rw [hg₁, hρ_eq]
      have htail_lt : ‖∑ m ∈ Finset.Ico 2 p,
          ((m.choose 1 : N₀) * g.coeff m) * (-(ξ₀ - algebraMap ↥M₁ N₀ c)) ^ (m - 1)‖ <
          ‖g.coeff 1‖ := by
        rw [hg₁_r]
        refine h_ultra_sum_nat (Finset.Ico 2 p) _ (r ^ (p - 1)) (pow_pos hr_pos (p - 1))
          (fun m hm => ?_)
        have hm_ico := Finset.mem_Ico.mp hm
        have hterm_le := h_summand_le m 1 (ξ₀ - algebraMap ↥M₁ N₀ c)
        rw [h_ξ_norm_c c] at hterm_le
        have hpow_pm1 : r₀ ^ (p - m) * r₀ ^ (m - 1) = r₀ ^ (p - 1) := by
          rw [← pow_add, show p - m + (m - 1) = p - 1 by omega]
        calc ‖((m.choose 1 : N₀) * g.coeff m) * (-(ξ₀ - algebraMap ↥M₁ N₀ c)) ^ (m - 1)‖
            ≤ ‖g.coeff m‖ * r₀ ^ (m - 1) := hterm_le
          _ ≤ (θ * r ^ (p - m)) * r₀ ^ (m - 1) :=
              mul_le_mul_of_nonneg_right (hθ_coeff m hm) (pow_nonneg (le_of_lt hr₀_pos) _)
          _ ≤ (θ * r₀ ^ (p - m)) * r₀ ^ (m - 1) :=
              mul_le_mul_of_nonneg_right
                (mul_le_mul_of_nonneg_left
                  (pow_le_pow_left₀ (le_of_lt hr_pos) (le_of_lt hr_r₀) (p - m)) hθ_bounds.1)
                (pow_nonneg (le_of_lt hr₀_pos) _)
          _ = θ * r₀ ^ (p - 1) := by rw [mul_assoc, hpow_pm1]
          _ < r ^ (p - 1) := hθ_pm1
      rw [h_ultra_eq _ _ htail_lt, hg₁_r]
    · 
      have hnorm_lhs : ‖((f₀.comp (Polynomial.X + Polynomial.C c)).coeff k : F_hat)‖ =
          ‖algebraMap ↥M₁ N₀ ((f₀.comp (Polynomial.X + Polynomial.C c)).coeff k)‖ :=
        (hIso₁ _).symm
      rw [hnorm_lhs, h_recenter_coeff c k (by omega) hkp, ← lt_div_iff₀ (pow_pos hr₀_pos k)]
      refine h_ultra_sum_nat (Finset.Ico k p) _ (r ^ p / r₀ ^ k)
        (div_pos (pow_pos hr_pos p) (pow_pos hr₀_pos k)) (fun m hm => ?_)
      rw [Finset.mem_Ico] at hm
      rw [lt_div_iff₀ (pow_pos hr₀_pos k)]
      have hm_in : m ∈ Finset.Ico 2 p := Finset.mem_Ico.mpr ⟨by omega, hm.2⟩
      have hterm_le := h_summand_le m k (ξ₀ - algebraMap ↥M₁ N₀ c)
      rw [h_ξ_norm_c c] at hterm_le
      have hpow_m : r₀ ^ (m - k) * r₀ ^ k = r₀ ^ m := by
        rw [← pow_add, Nat.sub_add_cancel hm.1]
      have hpow_p : r₀ ^ (p - m) * r₀ ^ m = r₀ ^ p := by
        rw [← pow_add, Nat.sub_add_cancel (le_of_lt hm.2)]
      calc ‖((m.choose k : N₀) * g.coeff m) * (-(ξ₀ - algebraMap ↥M₁ N₀ c)) ^ (m - k)‖ * r₀ ^ k
          ≤ (‖g.coeff m‖ * r₀ ^ (m - k)) * r₀ ^ k :=
            mul_le_mul_of_nonneg_right hterm_le (pow_nonneg (le_of_lt hr₀_pos) k)
        _ = ‖g.coeff m‖ * r₀ ^ m := by rw [mul_assoc, hpow_m]
        _ ≤ (θ * r ^ (p - m)) * r₀ ^ m :=
            mul_le_mul_of_nonneg_right (hθ_coeff m hm_in) (pow_nonneg (le_of_lt hr₀_pos) m)
        _ ≤ (θ * r₀ ^ (p - m)) * r₀ ^ m :=
            mul_le_mul_of_nonneg_right
              (mul_le_mul_of_nonneg_left
                (pow_le_pow_left₀ (le_of_lt hr_pos) (le_of_lt hr_r₀) (p - m)) hθ_bounds.1)
              (pow_nonneg (le_of_lt hr₀_pos) m)
        _ = θ * r₀ ^ p := by rw [mul_assoc, hpow_p]
        _ < r ^ p := hθ_p

theorem weil_analytic_immediate_deg_p_and_perturbation (K_hat F_hat : Type u)
    [NontriviallyNormedField K_hat] [CompleteSpace K_hat]
    [IsUltrametricDist K_hat] [IsAlgClosed K_hat]
    [NontriviallyNormedField F_hat] [CompleteSpace F_hat]
    [IsUltrametricDist F_hat] [Algebra K_hat F_hat]
    (hEquiChar : ∀ p : ℕ, p.Prime → (p : K_hat) = 0 ∨ ‖(p : K_hat)‖ = 1)
    (hIsoK : ∀ c : K_hat, ‖algebraMap K_hat F_hat c‖ = ‖c‖) :
    HasWeilImmediateCosetAndPerturb K_hat F_hat :=
by
  let _ := hEquiChar
  have hNontriv : ∀ (L : Subfield F_hat),
      Set.range (algebraMap K_hat F_hat) ⊆ (L : Set F_hat) → ∃ c ∈ L, 1 < ‖c‖ := by
    intro L hRange
    obtain ⟨c₀, hc₀⟩ := NormedField.exists_one_lt_norm K_hat
    refine ⟨algebraMap K_hat F_hat c₀, hRange ⟨c₀, rfl⟩, ?_⟩
    rwa [hIsoK c₀]
  have hRange_closure : ∀ x : F_hat,
      Set.range (algebraMap K_hat F_hat) ⊆
        (((IntermediateField.adjoin K_hat ({x} : Set F_hat)).toSubfield.topologicalClosure) :
          Set F_hat) := by
    intro x
    rintro _ ⟨c, rfl⟩
    exact Subfield.le_topologicalClosure _
      ((IntermediateField.adjoin K_hat ({x} : Set F_hat)).algebraMap_mem c)
  
  have h_s1 : ∀ (z : F_hat), z ∉ Set.range (algebraMap K_hat F_hat) →
      ∃ r_z : ℝ, 0 < r_z ∧
        (∀ c : K_hat, r_z ≤ ‖z - algebraMap K_hat F_hat c‖) ∧
        (∀ ε : ℝ, 0 < ε → ∃ c : K_hat, ‖z - algebraMap K_hat F_hat c‖ < r_z + ε) ∧
        ∀ (z' : F_hat) (θ : ℝ), 0 ≤ θ → θ < 1 → ‖z - z'‖ ≤ θ * r_z →
          let Lz : Subfield F_hat :=
            (IntermediateField.adjoin K_hat ({z} : Set F_hat)).toSubfield.topologicalClosure
          let Lz' : Subfield F_hat :=
            (IntermediateField.adjoin K_hat ({z'} : Set F_hat)).toSubfield.topologicalClosure
          ∃ φ : ↥Lz ≃+* ↥Lz',
            (∀ u : ↥Lz, ‖(φ u : F_hat)‖ = ‖(u : F_hat)‖) ∧
            (∀ u : ↥Lz, ‖(u : F_hat) - (φ u : F_hat)‖ ≤ θ * ‖(u : F_hat)‖) := by
    intro z hz
    let ι : K_hat →+* F_hat := algebraMap K_hat F_hat
    let S : Set F_hat := Set.range ι
    have hIso_ι : Isometry ι := Isometry.of_dist_eq fun c₁ c₂ => by
      rw [dist_eq_norm, dist_eq_norm, ← map_sub]
      exact hIsoK (c₁ - c₂)
    have hCl_S : IsClosed S := hIso_ι.isUniformInducing.isComplete_range.isClosed
    have hS_ne : S.Nonempty := ⟨ι 0, 0, rfl⟩
    let r_z : ℝ := Metric.infDist z S
    have hr_z_pos : 0 < r_z := by
      have h_not_cl : z ∉ closure S := by rwa [hCl_S.closure_eq]
      have h_ne_zero : r_z ≠ 0 := fun h0 =>
        h_not_cl ((Metric.mem_closure_iff_infDist_zero hS_ne).mpr h0)
      exact lt_of_le_of_ne Metric.infDist_nonneg h_ne_zero.symm
    have hr_z_le : ∀ c : K_hat, r_z ≤ ‖z - ι c‖ := by
      intro c
      rw [← dist_eq_norm]
      exact Metric.infDist_le_dist_of_mem ⟨c, rfl⟩
    have hr_z_inf : ∀ ε : ℝ, 0 < ε → ∃ c : K_hat, ‖z - ι c‖ < r_z + ε := by
      intro ε hε
      obtain ⟨y, ⟨c, rfl⟩, hy⟩ := (Metric.infDist_lt_iff hS_ne).mp (lt_add_of_pos_right r_z hε)
      rw [dist_eq_norm] at hy
      exact ⟨c, hy⟩
    refine ⟨r_z, hr_z_pos, hr_z_le, hr_z_inf, ?_⟩
    intro z' θ hθ0 hθ1 hzz'
    dsimp only
    have h_norm_eq : ∀ x x' : F_hat, ‖x - x'‖ ≤ θ * ‖x‖ → ‖x'‖ = ‖x‖ := by
      intro x x' hxx'
      by_cases hx0 : x = 0
      · subst hx0
        simp only [zero_sub, norm_neg, norm_zero, mul_zero] at hxx' ⊢
        exact le_antisymm hxx' (norm_nonneg x')
      · have hx_pos : 0 < ‖x‖ := norm_pos_iff.mpr hx0
        have hlt : ‖x' - x‖ < ‖x‖ := by
          rw [norm_sub_rev]
          calc ‖x - x'‖ ≤ θ * ‖x‖ := hxx'
            _ < 1 * ‖x‖ := mul_lt_mul_of_pos_right hθ1 hx_pos
            _ = ‖x‖ := one_mul ‖x‖
        have hne_nn : ‖x‖₊ ≠ ‖x' - x‖₊ := fun heq =>
          ne_of_gt hlt (congrArg (fun r : NNReal => (r : ℝ)) heq)
        have hadd := congrArg (fun r : NNReal => (r : ℝ))
          (IsUltrametricDist.nnnorm_add_eq_max_of_nnnorm_ne_nnnorm hne_nn)
        have hx'_eq : x' = x + (x' - x) := by ring
        rw [hx'_eq]
        exact hadd.trans (max_eq_left (le_of_lt hlt))
    have h_mul_err : ∀ x x' y y' : F_hat,
        ‖x - x'‖ ≤ θ * ‖x‖ → ‖y - y'‖ ≤ θ * ‖y‖ → ‖x * y - x' * y'‖ ≤ θ * ‖x * y‖ := by
      intro x x' y y' hx hy
      have hx' : ‖x'‖ = ‖x‖ := h_norm_eq x x' hx
      have hid : x * y - x' * y' = (x - x') * y + x' * (y - y') := by ring
      rw [hid, norm_mul]
      refine (IsUltrametricDist.norm_add_le_max _ _).trans (max_le ?_ ?_)
      · rw [norm_mul]
        calc ‖x - x'‖ * ‖y‖ ≤ (θ * ‖x‖) * ‖y‖ :=
              mul_le_mul_of_nonneg_right hx (norm_nonneg y)
          _ = θ * (‖x‖ * ‖y‖) := mul_assoc θ ‖x‖ ‖y‖
      · rw [norm_mul, hx']
        calc ‖x‖ * ‖y - y'‖ ≤ ‖x‖ * (θ * ‖y‖) :=
              mul_le_mul_of_nonneg_left hy (norm_nonneg x)
          _ = θ * (‖x‖ * ‖y‖) := by ring
    have h_div_err : ∀ x x' y y' : F_hat, y ≠ 0 →
        ‖x - x'‖ ≤ θ * ‖x‖ → ‖y - y'‖ ≤ θ * ‖y‖ → ‖x / y - x' / y'‖ ≤ θ * ‖x / y‖ := by
      intro x x' y y' hy0 hx hy
      have hy' : ‖y'‖ = ‖y‖ := h_norm_eq y y' hy
      have hy_pos : 0 < ‖y‖ := norm_pos_iff.mpr hy0
      have hy'0 : y' ≠ 0 := norm_ne_zero_iff.mp (by linarith)
      have hid : x / y - x' / y' = ((x - x') * y' + x' * (y' - y)) / (y * y') := by
        field_simp
        ring
      have hx' : ‖x'‖ = ‖x‖ := h_norm_eq x x' hx
      have hnum : ‖(x - x') * y' + x' * (y' - y)‖ ≤ θ * ‖x‖ * ‖y‖ := by
        refine (IsUltrametricDist.norm_add_le_max _ _).trans (max_le ?_ ?_)
        · rw [norm_mul, hy']
          exact mul_le_mul_of_nonneg_right hx (norm_nonneg y)
        · rw [norm_mul, hx', norm_sub_rev]
          calc ‖x‖ * ‖y - y'‖ ≤ ‖x‖ * (θ * ‖y‖) :=
                mul_le_mul_of_nonneg_left hy (norm_nonneg x)
            _ = θ * ‖x‖ * ‖y‖ := by ring
      rw [hid, norm_div, norm_div, norm_mul, hy']
      calc ‖(x - x') * y' + x' * (y' - y)‖ / (‖y‖ * ‖y‖)
          ≤ (θ * ‖x‖ * ‖y‖) / (‖y‖ * ‖y‖) :=
            div_le_div_of_nonneg_right hnum (mul_nonneg (norm_nonneg y) (norm_nonneg y))
        _ = θ * (‖x‖ / ‖y‖) := by
            have hy_ne : ‖y‖ ≠ 0 := ne_of_gt hy_pos
            field_simp
    have h_mset_err : ∀ m : Multiset K_hat,
        let Q : Polynomial K_hat := (m.map (fun a => Polynomial.X - Polynomial.C a)).prod
        ‖Polynomial.aeval z Q - Polynomial.aeval z' Q‖ ≤ θ * ‖Polynomial.aeval z Q‖ ∧
        Polynomial.aeval z Q ≠ 0 := by
      intro m
      induction m using Multiset.induction_on with
      | empty =>
        simp only [Multiset.map_zero, Multiset.prod_zero, map_one, sub_self, norm_zero, norm_one,
          mul_one, ne_eq, one_ne_zero, not_false_eq_true, and_true]
        exact hθ0
      | cons a s ih =>
        rcases ih with ⟨ih_err, ih_nz⟩
        simp only [Multiset.map_cons, Multiset.prod_cons, map_mul, map_sub, Polynomial.aeval_X,
          Polynomial.aeval_C]
        have hlin_err : ‖(z - ι a) - (z' - ι a)‖ ≤ θ * ‖z - ι a‖ := by
          have hsub : (z - ι a) - (z' - ι a) = z - z' := by ring
          rw [hsub]
          exact hzz'.trans (mul_le_mul_of_nonneg_left (hr_z_le a) hθ0)
        have hlin_nz : z - ι a ≠ 0 := by
          intro h0
          have : ‖z - ι a‖ = 0 := by rw [h0, norm_zero]
          linarith [hr_z_le a]
        exact ⟨h_mul_err _ _ _ _ hlin_err ih_err, mul_ne_zero hlin_nz ih_nz⟩
    have h_poly_err : ∀ P : Polynomial K_hat,
        ‖Polynomial.aeval z P - Polynomial.aeval z' P‖ ≤ θ * ‖Polynomial.aeval z P‖ := by
      intro P
      obtain ⟨m, hm⟩ := Polynomial.splits_iff_exists_multiset.mp (IsAlgClosed.splits P)
      rw [hm, map_mul, map_mul, Polynomial.aeval_C, Polynomial.aeval_C]
      have hc_err : ‖ι P.leadingCoeff - ι P.leadingCoeff‖ ≤ θ * ‖ι P.leadingCoeff‖ := by
        rw [sub_self, norm_zero]
        exact mul_nonneg hθ0 (norm_nonneg _)
      exact h_mul_err _ _ _ _ hc_err (h_mset_err m).1
    have h_poly_nz : ∀ P : Polynomial K_hat, P ≠ 0 → Polynomial.aeval z P ≠ 0 := by
      intro P hP
      obtain ⟨m, hm⟩ := Polynomial.splits_iff_exists_multiset.mp (IsAlgClosed.splits P)
      rw [hm, map_mul, Polynomial.aeval_C]
      have hlc : P.leadingCoeff ≠ 0 := Polynomial.leadingCoeff_ne_zero.mpr hP
      have hι_lc : ι P.leadingCoeff ≠ 0 := by
        rw [← norm_ne_zero_iff, hIsoK, norm_ne_zero_iff]
        exact hlc
      exact mul_ne_zero hι_lc (h_mset_err m).2
    have h_poly_norm : ∀ P : Polynomial K_hat,
        ‖Polynomial.aeval z' P‖ = ‖Polynomial.aeval z P‖ :=
      fun P => h_norm_eq _ _ (h_poly_err P)
    have h_poly_nz' : ∀ P : Polynomial K_hat, P ≠ 0 → Polynomial.aeval z' P ≠ 0 := by
      intro P hP h0
      have := h_poly_norm P
      rw [h0, norm_zero, eq_comm, norm_eq_zero] at this
      exact h_poly_nz P hP this
    have h_poly_zero_iff : ∀ P : Polynomial K_hat,
        Polynomial.aeval z P = 0 ↔ Polynomial.aeval z' P = 0 := by
      intro P
      rw [← norm_eq_zero (a := Polynomial.aeval z P),
        ← norm_eq_zero (a := Polynomial.aeval z' P), h_poly_norm P]
    let Kz : Subfield F_hat := (IntermediateField.adjoin K_hat ({z} : Set F_hat)).toSubfield
    let Kz' : Subfield F_hat := (IntermediateField.adjoin K_hat ({z'} : Set F_hat)).toSubfield
    have h_rep_z : ∀ u : ↥Kz, ∃ p : Polynomial K_hat × Polynomial K_hat,
        p.2 ≠ 0 ∧ (u : F_hat) = Polynomial.aeval z p.1 / Polynomial.aeval z p.2 := by
      intro u
      obtain ⟨r, s, hrs⟩ := (IntermediateField.mem_adjoin_simple_iff K_hat (u : F_hat)).mp u.2
      by_cases hs : s = 0
      · refine ⟨(0, 1), one_ne_zero, ?_⟩
        subst hs
        simp only [map_zero, div_zero, map_one, div_one] at hrs ⊢
        exact hrs
      · exact ⟨(r, s), hs, hrs⟩
    have h_rep_z' : ∀ v : ↥Kz', ∃ p : Polynomial K_hat × Polynomial K_hat,
        p.2 ≠ 0 ∧ (v : F_hat) = Polynomial.aeval z' p.1 / Polynomial.aeval z' p.2 := by
      intro v
      obtain ⟨r, s, hrs⟩ := (IntermediateField.mem_adjoin_simple_iff K_hat (v : F_hat)).mp v.2
      by_cases hs : s = 0
      · refine ⟨(0, 1), one_ne_zero, ?_⟩
        subst hs
        simp only [map_zero, div_zero, map_one, div_one] at hrs ⊢
        exact hrs
      · exact ⟨(r, s), hs, hrs⟩
    have h_frac_eq : ∀ f₁ g₁ f₂ g₂ : Polynomial K_hat, g₁ ≠ 0 → g₂ ≠ 0 →
        (Polynomial.aeval z f₁ / Polynomial.aeval z g₁ =
          Polynomial.aeval z f₂ / Polynomial.aeval z g₂ ↔
        Polynomial.aeval z' f₁ / Polynomial.aeval z' g₁ =
          Polynomial.aeval z' f₂ / Polynomial.aeval z' g₂) := by
      intro f₁ g₁ f₂ g₂ hg₁ hg₂
      rw [div_eq_div_iff (h_poly_nz g₁ hg₁) (h_poly_nz g₂ hg₂),
        div_eq_div_iff (h_poly_nz' g₁ hg₁) (h_poly_nz' g₂ hg₂),
        ← sub_eq_zero (a := Polynomial.aeval z f₁ * Polynomial.aeval z g₂),
        ← sub_eq_zero (a := Polynomial.aeval z' f₁ * Polynomial.aeval z' g₂)]
      have hz_id : Polynomial.aeval z f₁ * Polynomial.aeval z g₂ -
          Polynomial.aeval z f₂ * Polynomial.aeval z g₁ =
          Polynomial.aeval z (f₁ * g₂ - f₂ * g₁) := by simp
      have hz'_id : Polynomial.aeval z' f₁ * Polynomial.aeval z' g₂ -
          Polynomial.aeval z' f₂ * Polynomial.aeval z' g₁ =
          Polynomial.aeval z' (f₁ * g₂ - f₂ * g₁) := by simp
      rw [hz_id, hz'_id]
      exact h_poly_zero_iff (f₁ * g₂ - f₂ * g₁)
    let φ₀_fun : ↥Kz → ↥Kz' := fun u =>
      let p := Classical.choose (h_rep_z u)
      ⟨Polynomial.aeval z' p.1 / Polynomial.aeval z' p.2,
        (IntermediateField.mem_adjoin_simple_iff K_hat _).mpr ⟨p.1, p.2, rfl⟩⟩
    let ψ₀_fun : ↥Kz' → ↥Kz := fun v =>
      let p := Classical.choose (h_rep_z' v)
      ⟨Polynomial.aeval z p.1 / Polynomial.aeval z p.2,
        (IntermediateField.mem_adjoin_simple_iff K_hat _).mpr ⟨p.1, p.2, rfl⟩⟩
    have hφ₀_spec : ∀ (u : ↥Kz) (f g : Polynomial K_hat), g ≠ 0 →
        (u : F_hat) = Polynomial.aeval z f / Polynomial.aeval z g →
        (φ₀_fun u : F_hat) = Polynomial.aeval z' f / Polynomial.aeval z' g := by
      intro u f g hg hu
      have hp := Classical.choose_spec (h_rep_z u)
      exact (h_frac_eq _ _ f g hp.1 hg).mp (hp.2.symm.trans hu)
    have hψ₀_spec : ∀ (v : ↥Kz') (f g : Polynomial K_hat), g ≠ 0 →
        (v : F_hat) = Polynomial.aeval z' f / Polynomial.aeval z' g →
        (ψ₀_fun v : F_hat) = Polynomial.aeval z f / Polynomial.aeval z g := by
      intro v f g hg hv
      have hp := Classical.choose_spec (h_rep_z' v)
      exact (h_frac_eq _ _ f g hp.1 hg).mpr (hp.2.symm.trans hv)
    let φ₀ : ↥Kz ≃+* ↥Kz' :=
      { toFun := φ₀_fun
        invFun := ψ₀_fun
        left_inv := fun u => by
          obtain ⟨⟨f, g⟩, hg, hu⟩ := h_rep_z u
          apply Subtype.ext
          rw [hψ₀_spec (φ₀_fun u) f g hg (hφ₀_spec u f g hg hu), hu]
        right_inv := fun v => by
          obtain ⟨⟨f, g⟩, hg, hv⟩ := h_rep_z' v
          apply Subtype.ext
          rw [hφ₀_spec (ψ₀_fun v) f g hg (hψ₀_spec v f g hg hv), hv]
        map_mul' := fun u₁ u₂ => by
          obtain ⟨⟨f₁, g₁⟩, hg₁, hu₁⟩ := h_rep_z u₁
          obtain ⟨⟨f₂, g₂⟩, hg₂, hu₂⟩ := h_rep_z u₂
          apply Subtype.ext
          have hmul : ((u₁ * u₂ : ↥Kz) : F_hat) =
