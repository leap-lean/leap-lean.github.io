        have hne : (y : F_hat) ≠ 0 := norm_ne_zero_iff.mp (by rw [hy]; exact one_ne_zero)
        let y_inv : ↥OF := ⟨(y : F_hat)⁻¹, (h_mem_OF _).mpr (by rw [norm_inv, hy]; norm_num)⟩
        exact isUnit_iff_exists_inv.mpr ⟨y_inv, Subtype.ext (mul_inv_cancel₀ hne)⟩
    have hUnit_OL : ∀ b : ↥OL, IsUnit b ↔ ‖((b : ↥OL) : F_hat)‖ = 1 := by
      intro b
      constructor
      · rintro ⟨u, rfl⟩
        have hmul : ((u.val * u.inv : ↥OL) : F_hat) = 1 :=
          congrArg (fun x : ↥OL => ((x : ↥OL) : F_hat)) u.val_inv
        have h1 : ‖((u.val : ↥OL) : F_hat)‖ * ‖((u.inv : ↥OL) : F_hat)‖ = 1 := by
          rw [← norm_mul]
          exact (congrArg norm hmul).trans norm_one
        have hle1 : ‖((u.val : ↥OL) : F_hat)‖ ≤ 1 := (h_mem_OL _).mp u.val.2
        have hle2 : ‖((u.inv : ↥OL) : F_hat)‖ ≤ 1 := (h_mem_OL _).mp u.inv.2
        nlinarith [norm_nonneg ((u.val : ↥OL) : F_hat), norm_nonneg ((u.inv : ↥OL) : F_hat)]
      · intro hb
        have hne_F : ((b : ↥OL) : F_hat) ≠ 0 := norm_ne_zero_iff.mp (by rw [hb]; exact one_ne_zero)
        have hne_L : (b : ↥L) ≠ 0 := fun h => hne_F (congrArg Subtype.val h)
        let b_inv : ↥OL := ⟨(b : ↥L)⁻¹, (h_mem_OL _).mpr (by
