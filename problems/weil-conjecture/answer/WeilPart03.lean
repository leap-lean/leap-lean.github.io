        rw [hmul]
        congr 1
        refine Finset.sum_congr rfl fun i hi => ?_
        have hi_lt : i < m := Finset.mem_range.mp hi
        have hm_split : (x⁻¹) ^ m = (x⁻¹) ^ i * (x⁻¹) ^ (m - i) := by
          conv_lhs => rw [(Nat.add_sub_of_le (Nat.le_of_lt hi_lt)).symm]
          rw [pow_add]
