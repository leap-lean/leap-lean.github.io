            have hClos := hImg.closure
            rwa [hDense.closure_eq] at hClos
          obtain ⟨x_CK⟩ := hIrred_CK.toNonempty
          exact { isPreirreducible_univ := hPreirred, toNonempty := ⟨ι₀.base x_CK⟩ }
        · have hRed_Spec_of_red : ∀ (B : CommRingCat.{u}),
              _root_.IsReduced ↑B → AlgebraicGeometry.IsReduced (AlgebraicGeometry.Spec B) := by
            intro B hRed_B
            have : ∀ x : ↥(AlgebraicGeometry.Spec B),
                _root_.IsReduced ↑((AlgebraicGeometry.Spec B).presheaf.stalk x) := by
              intro x
              have : x.asIdeal.IsPrime := x.isPrime
              let iso_st := AlgebraicGeometry.Spec.stalkIso B x
              have : _root_.IsReduced (Localization.AtPrime x.asIdeal) := by
                refine ⟨fun z hz => ?_⟩
                rcases hz with ⟨m_exp, hm_exp⟩
                obtain ⟨⟨b, s⟩, hbs⟩ := IsLocalization.surj x.asIdeal.primeCompl z
                have hbs_pow : (z * algebraMap (↑B) (Localization.AtPrime x.asIdeal) s.1) ^ m_exp =
                    (algebraMap (↑B) (Localization.AtPrime x.asIdeal) b) ^ m_exp :=
                  congrArg (· ^ m_exp) hbs
                rw [mul_pow, hm_exp, zero_mul, ← map_pow] at hbs_pow
                have hzero_map : algebraMap (↑B) (Localization.AtPrime x.asIdeal) (b ^ m_exp) =
                    algebraMap (↑B) (Localization.AtPrime x.asIdeal) 0 := by
                  rw [map_zero]
                  exact hbs_pow.symm
                obtain ⟨c, hc_eq⟩ :=
                  (IsLocalization.eq_iff_exists x.asIdeal.primeCompl
                    (Localization.AtPrime x.asIdeal)).mp hzero_map
                rw [mul_zero] at hc_eq
                have hcb_nil : IsNilpotent (c.1 * b) := by
                  refine ⟨m_exp + 1, ?_⟩
                  calc
                    (c.1 * b) ^ (m_exp + 1)
                      = c.1 ^ m_exp * (c.1 * b ^ m_exp) * b := by
                          rw [mul_pow, pow_succ, pow_succ]
                          ring
                    _ = 0 := by rw [hc_eq, mul_zero, zero_mul]
                have hcb0 : c.1 * b = 0 := hRed_B.eq_zero (c.1 * b) hcb_nil
                have hz_cs :
                    z * algebraMap (↑B) (Localization.AtPrime x.asIdeal) (c.1 * s.1) = 0 := by
                  calc
                    z * algebraMap (↑B) (Localization.AtPrime x.asIdeal) (c.1 * s.1)
                      = algebraMap (↑B) (Localization.AtPrime x.asIdeal) c.1 *
                          (z * algebraMap (↑B) (Localization.AtPrime x.asIdeal) s.1) := by
                          rw [map_mul]
                          ring
                    _ = algebraMap (↑B) (Localization.AtPrime x.asIdeal) (c.1 * b) := by
                          rw [hbs, map_mul]
                    _ = 0 := by rw [hcb0, map_zero]
                have hcs_unit : IsUnit
                    (algebraMap (↑B) (Localization.AtPrime x.asIdeal) (c.1 * s.1)) :=
                  IsLocalization.map_units (Localization.AtPrime x.asIdeal)
                    ⟨c.1 * s.1, Submonoid.mul_mem _ c.2 s.2⟩
                rcases hcs_unit with ⟨u_cs, hu_cs⟩
                rw [← hu_cs] at hz_cs
                calc
                  z = z * ((u_cs : _) * ↑(u_cs⁻¹)) := by rw [Units.mul_inv, mul_one]
                  _ = (z * (u_cs : _)) * ↑(u_cs⁻¹) := (mul_assoc _ _ _).symm
                  _ = 0 := by rw [hz_cs, zero_mul]
              exact isReduced_of_injective iso_st.hom.hom
                iso_st.commRingCatIsoToRingEquiv.injective
            exact AlgebraicGeometry.isReduced_of_isReduced_stalk (AlgebraicGeometry.Spec B)
          have hRed_W : ∀ a : Fin (M_K + 1), AlgebraicGeometry.IsReduced (W_cov a).toScheme := by
            intro a
            have := hRed_Spec_of_red (CommRingCat.of (MvPolynomial (Fin M_K) ↥V ⧸ J_a a)) (hRed_Qa a)
            exact AlgebraicGeometry.isReduced_of_isOpenImmersion (e_Wa a).hom
          have : ∀ x : ↥C₀, _root_.IsReduced ↑(C₀.presheaf.stalk x) := by
            intro x
            have hx_top : x ∈ (⨆ a : Fin (M_K + 1), W_cov a) := by
              rw [hCovW]
              trivial
            obtain ⟨a, hxa⟩ := TopologicalSpace.Opens.mem_iSup.mp hx_top
            have := hRed_W a
            have : _root_.IsReduced ↑((W_cov a).toScheme.presheaf.stalk ⟨x, hxa⟩) :=
              AlgebraicGeometry.isReduced_stalk_of_isReduced (W_cov a).toScheme ⟨x, hxa⟩
            let iso_st := AlgebraicGeometry.Scheme.Opens.stalkIso (W_cov a) ⟨x, hxa⟩
            exact isReduced_of_injective iso_st.inv.hom
              iso_st.symm.commRingCatIsoToRingEquiv.injective
          exact AlgebraicGeometry.isReduced_of_isReduced_stalk C₀
      exact ⟨C₀, g₀, τ₀, ι₀, ιP₀, hInt_C₀, hFlat_g₀, hProp_g₀, hLFP_g₀, hSurj_g₀,
        hCl_ιP₀, rfl, hτ₀_sec, hPb_gen, fun j => (hτ₀_gen j).symm⟩
    obtain ⟨C₀, g₀, τ₀, ι₀, ιP₀, hInt_C₀, hFlat_g₀, hProp_g₀, hLFP_g₀, hSurj_g₀,
        hCl_ιP₀, hιP₀_g₀, hτ₀_sec, hPb_gen, hτ₀_gen⟩ :=
      hAbs (weilProjectiveSpaceOver ↥V M_K).left (weilProjectiveSpaceOver K M_K).left
        (weilProjectiveSpaceOver ↥V M_K).hom (weilProjectiveSpaceOver K M_K).hom
        ι_proj hClProj hProjComm hPropPV Φ_V hPbPV U_chart e_chart hCovChart hChartComm
    exact ⟨C₀, g₀, τ₀, ι₀, hInt_C₀, hFlat_g₀, hProp_g₀, hLFP_g₀, hSurj_g₀,
      ⟨M_K, ιP₀, hCl_ιP₀, hιP₀_g₀⟩, hτ₀_sec, hPb_gen, hτ₀_gen⟩
  
  obtain ⟨hFinSpec, hCardSpec, hOpenGen⟩ :=
    h_s1 k m K F (fun W hW => ⟨(hUnif W hW).1, (hUnif W hW).2.1⟩) V hkV
  obtain ⟨hHensel, hDiv, hAlgRes⟩ := h_s2 K V
  have hSatFG : ∀ (r : ℕ) (J : Ideal (MvPolynomial (Fin r) ↥V)),
      (∀ (c : ↥V) (f : MvPolynomial (Fin r) ↥V), c ≠ 0 → MvPolynomial.C c * f ∈ J → f ∈ J) →
      J.FG :=
    fun r J hSat => h_s3 ↥V r J hSat
  have hPkg : IsValuationRingAlgPackage m V :=
    ⟨hFinSpec, hCardSpec, hHensel, hDiv, hAlgRes, hSatFG⟩
  obtain ⟨hPropPV, ⟨Φ_V, hPbPV⟩, ⟨U_chart, e_chart, hCovChart, hChartComm⟩⟩ :=
    h_s4 ↥V K M_K
  have h3n : 3 ≤ n := hStabCK.1
  have hn : 1 ≤ n := by omega
  have hSecK : ∀ j : Fin n, σ_K j ≫ p_K = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of K)) :=
    hStabCK.2.2.2.2.2.1
  obtain ⟨C₀, g₀, τ₀, ι₀, hMod₀⟩ :=
    h_s5 K V hOpenGen hSatFG C_K p_K n hn σ_K hSecK hIntCK
      M_K ι_proj hClProj hProjComm hPropPV Φ_V hPbPV U_chart e_chart hCovChart hChartComm
  exact ⟨hPkg, C₀, g₀, τ₀, ι₀, hMod₀⟩

theorem weil_overring_chart_witness_to_base_presentation (K : Type u) [Field K]
    (V : ValuationSubring K)
    (hFinSpec : Set.Finite (Set.univ : Set (PrimeSpectrum ↥V)))
    (E : Type u) [Field E] [Algebra K E]
    (Vx : ValuationSubring E)
    (hVVx : ∀ y : ↥V, ((algebraMap K E).comp V.subtype) y ∈ Vx)
    (S₁ : Finset E)
    (hChart : HasOverringSemistableChartWitness (Vx.comap (algebraMap K E)) Vx S₁) :
    ∃ (R : Subring E)
      (hVR : ∀ y : ↥V, ((algebraMap K E).comp V.subtype) y ∈ R),
      (∀ r ∈ R, r ∈ Vx) ∧
      (∀ z ∈ S₁, z ∈ R) ∧
      HasStandardSemistableLocalizationPresentation V R hVR :=
by
  let V₁ : ValuationSubring K := Vx.comap (algebraMap K E)
  let vMap : ↥V →+* E := (algebraMap K E).comp V.subtype
  let v₁Map : ↥V₁ →+* E := (algebraMap K E).comp V₁.subtype
  
  have hStep1 : ∃ s₀ : ↥V,
      s₀ ≠ 0 ∧
      (s₀ : K)⁻¹ ∈ V₁ ∧
      ∀ c : ↥V₁, ∃ N : ℕ, ∀ M : ℕ, N ≤ M → (c : K) * (s₀ : K) ^ M ∈ V := by
    classical
    have hSub : V.toSubring ≤ V₁.toSubring := fun y hy => hVVx ⟨y, hy⟩
    let φ : ↥V →+* ↥V₁ := Subring.inclusion hSub
    let 𝔭₁ : Ideal ↥V := (IsLocalRing.maximalIdeal ↥V₁).comap φ
    have h𝔭₁ : 𝔭₁.IsPrime := Ideal.IsPrime.comap φ
    have hex_witness : ∀ Q : PrimeSpectrum ↥V, ¬ Q.asIdeal ≤ 𝔭₁ →
        ∃ x : ↥V, x ∈ Q.asIdeal ∧ x ∉ 𝔭₁ := by
      intro Q hQ
      by_contra! h
      exact hQ (fun x hx => h x hx)
    let 𝒮 : Finset (PrimeSpectrum ↥V) :=
      hFinSpec.toFinset.filter (fun Q => ¬ Q.asIdeal ≤ 𝔭₁)
    let x_fn : PrimeSpectrum ↥V → ↥V := fun Q =>
      if hQ : ¬ Q.asIdeal ≤ 𝔭₁ then Classical.choose (hex_witness Q hQ) else 1
    let s₀ : ↥V := ∏ Q ∈ 𝒮, x_fn Q
    have hs₀_not_mem : s₀ ∉ 𝔭₁ := by
      intro hs₀_mem
      obtain ⟨Q, hQ𝒮, hxQ_mem⟩ := h𝔭₁.prod_mem_iff.mp hs₀_mem
      have hQ : ¬ Q.asIdeal ≤ 𝔭₁ := (Finset.mem_filter.mp hQ𝒮).2
      have hx_spec := Classical.choose_spec (hex_witness Q hQ)
      have hx_eq : x_fn Q = Classical.choose (hex_witness Q hQ) := by
        dsimp only [x_fn]
        split_ifs
        rfl
      rw [hx_eq] at hxQ_mem
      exact hx_spec.2 hxQ_mem
    have hs₀_ne : s₀ ≠ 0 := by
      intro h0
      apply hs₀_not_mem
      rw [h0]
      exact 𝔭₁.zero_mem
    have hs₀_K_ne : (s₀ : K) ≠ 0 := fun h => hs₀_ne (Subtype.ext h)
    have hs₀_inv : (s₀ : K)⁻¹ ∈ V₁ := by
      have hφs₀_not_max : φ s₀ ∉ IsLocalRing.maximalIdeal ↥V₁ := hs₀_not_mem
      have hUnit : IsUnit (φ s₀) := IsLocalRing.notMem_maximalIdeal.mp hφs₀_not_max
      obtain ⟨u₀, hu₀⟩ := isUnit_iff_exists_inv.mp hUnit
      have hu₀_K : (s₀ : K) * (u₀ : K) = 1 := congrArg V₁.subtype hu₀
      have hinv_eq : (s₀ : K)⁻¹ = (u₀ : K) := by
        calc
          (s₀ : K)⁻¹ = (s₀ : K)⁻¹ * ((s₀ : K) * (u₀ : K)) := by rw [hu₀_K, mul_one]
          _ = ((s₀ : K)⁻¹ * (s₀ : K)) * (u₀ : K) := by ring
          _ = (u₀ : K) := by rw [inv_mul_cancel₀ hs₀_K_ne, one_mul]
      rw [hinv_eq]
      exact u₀.2
    have hRad : ∀ b : ↥V, b ∉ 𝔭₁ → ∃ (N : ℕ) (q : ↥V), s₀ ^ N = b * q := by
      intro b hb
      have hs₀_rad : s₀ ∈ (Ideal.span ({b} : Set ↥V)).radical := by
        rw [Ideal.radical_eq_sInf, Submodule.mem_sInf]
        intro P ⟨hIP, hP_prime⟩
        have hbP : b ∈ P := hIP (Ideal.mem_span_singleton_self b)
        have hP_not_le : ¬ P ≤ 𝔭₁ := fun hle => hb (hle hbP)
        let Q : PrimeSpectrum ↥V := ⟨P, hP_prime⟩
        have hQ𝒮 : Q ∈ 𝒮 :=
          Finset.mem_filter.mpr ⟨hFinSpec.mem_toFinset.mpr (Set.mem_univ Q), hP_not_le⟩
        obtain ⟨k, hk⟩ := Finset.dvd_prod_of_mem x_fn hQ𝒮
        have hxQ_P : x_fn Q ∈ P := by
          have hQ_not_le : ¬ Q.asIdeal ≤ 𝔭₁ := hP_not_le
          have hx_eq : x_fn Q = Classical.choose (hex_witness Q hQ_not_le) := by
            dsimp only [x_fn]
            split_ifs
            rfl
          rw [hx_eq]
          exact (Classical.choose_spec (hex_witness Q hQ_not_le)).1
        dsimp only [s₀]
        rw [hk]
        exact Ideal.mul_mem_right k P hxQ_P
      obtain ⟨N, hN⟩ := Ideal.mem_radical_iff.mp hs₀_rad
      obtain ⟨q, hq⟩ := Ideal.mem_span_singleton.mp hN
      exact ⟨N, q, hq⟩
    refine ⟨s₀, hs₀_ne, hs₀_inv, ?_⟩
    intro c
    by_cases hcV : (c : K) ∈ V
    · refine ⟨0, fun M _ => mul_mem hcV (pow_mem s₀.2 M)⟩
    · have hc0 : (c : K) ≠ 0 := fun h0 => hcV (h0 ▸ zero_mem V)
      have hcinv : (c : K)⁻¹ ∈ V := (V.mem_or_inv_mem (c : K)).resolve_left hcV
      let b : ↥V := ⟨(c : K)⁻¹, hcinv⟩
      have hbc : φ b * c = 1 := Subtype.ext (inv_mul_cancel₀ hc0)
      have hb_unit : IsUnit (φ b) := isUnit_iff_exists_inv.mpr ⟨c, hbc⟩
      have hb_not_mem : b ∉ 𝔭₁ := IsLocalRing.notMem_maximalIdeal.mpr hb_unit
      obtain ⟨N, q, hNq⟩ := hRad b hb_not_mem
      have hNq_K : (s₀ : K) ^ N = (c : K)⁻¹ * (q : K) := by
        simpa using congrArg V.subtype hNq
      have hN_mem : (c : K) * (s₀ : K) ^ N ∈ V := by
        have heq : (c : K) * (s₀ : K) ^ N = (q : K) := by
          rw [hNq_K, ← mul_assoc, mul_inv_cancel₀ hc0, one_mul]
        rw [heq]
        exact q.2
      refine ⟨N, fun M hNM => ?_⟩
      have hM_eq : M = N + (M - N) := (Nat.add_sub_of_le hNM).symm
      rw [hM_eq, pow_add, ← mul_assoc]
      exact mul_mem hN_mem (pow_mem s₀.2 (M - N))
  obtain ⟨s₀, hs₀_ne, hs₀_inv, hs₀_clear⟩ := hStep1
  have hs₀_K_ne : (s₀ : K) ≠ 0 := fun h => hs₀_ne (Subtype.ext h)
  choose N_fn hN_fn using hs₀_clear
  have hvMap_s₀_ne : vMap s₀ ≠ 0 := by
    change algebraMap K E (s₀ : K) ≠ 0
    exact (map_ne_zero_iff (algebraMap K E) (RingHom.injective (algebraMap K E))).mpr hs₀_K_ne
  have hvMap_s₀_inv_Vx : (vMap s₀)⁻¹ ∈ Vx := by
    change (algebraMap K E (s₀ : K))⁻¹ ∈ Vx
    rw [← map_inv₀ (algebraMap K E) (s₀ : K)]
    exact hs₀_inv
  
  have hLocSubring : ∀ (A : Type u) [CommRing A]
      (ψ' : A →+* E) (_ : Function.Injective ψ')
      (ι_V : ↥V →+* A) (_ : ψ'.comp ι_V = vMap)
      (_ : ∀ q : A, ψ' q ∈ Vx)
      (g₀ : A) (_ : ψ' g₀ ≠ 0) (_ : (ψ' g₀)⁻¹ ∈ Vx),
      ∃ (R : Subring E)
        (hVR : ∀ y : ↥V, vMap y ∈ R)
        (ψ : A →+* ↥R),
        (∀ r ∈ R, r ∈ Vx) ∧
        (∀ q : A, ψ' q ∈ R) ∧
        (ψ' g₀)⁻¹ ∈ R ∧
        ψ.comp ι_V = RingHom.codRestrict vMap R hVR ∧
        @IsLocalization.Away _ _ g₀ ↥R _ ψ.toAlgebra := by
    intro A _ ψ' hInj ι_V hComp hAVx g₀ hg₀_ne hg₀_inv
    let γ₀ : E := ψ' g₀
    let R : Subring E :=
      { carrier := {z : E | ∃ (n : ℕ) (q : A), z * γ₀ ^ n = ψ' q}
        mul_mem' := by
          rintro z₁ z₂ ⟨n₁, q₁, h₁⟩ ⟨n₂, q₂, h₂⟩
          refine ⟨n₁ + n₂, q₁ * q₂, ?_⟩
          calc
            (z₁ * z₂) * γ₀ ^ (n₁ + n₂) = (z₁ * γ₀ ^ n₁) * (z₂ * γ₀ ^ n₂) := by
              rw [pow_add]; ring
            _ = ψ' q₁ * ψ' q₂ := by rw [h₁, h₂]
            _ = ψ' (q₁ * q₂) := (map_mul ψ' q₁ q₂).symm
        one_mem' := ⟨0, 1, by simp⟩
        add_mem' := by
          rintro z₁ z₂ ⟨n₁, q₁, h₁⟩ ⟨n₂, q₂, h₂⟩
          refine ⟨n₁ + n₂, q₁ * g₀ ^ n₂ + q₂ * g₀ ^ n₁, ?_⟩
          calc
            (z₁ + z₂) * γ₀ ^ (n₁ + n₂) =
                (z₁ * γ₀ ^ n₁) * γ₀ ^ n₂ + (z₂ * γ₀ ^ n₂) * γ₀ ^ n₁ := by
              rw [pow_add]; ring
            _ = ψ' q₁ * (ψ' g₀) ^ n₂ + ψ' q₂ * (ψ' g₀) ^ n₁ := by rw [h₁, h₂]
            _ = ψ' (q₁ * g₀ ^ n₂ + q₂ * g₀ ^ n₁) := by
              simp [map_add, map_mul, map_pow]
        zero_mem' := ⟨0, 0, by simp⟩
        neg_mem' := by
          rintro z ⟨n, q, h⟩
          refine ⟨n, -q, ?_⟩
          calc
            (-z) * γ₀ ^ n = -(z * γ₀ ^ n) := by ring
            _ = -ψ' q := by rw [h]
            _ = ψ' (-q) := (map_neg ψ' q).symm }
    have hψ'R : ∀ q : A, ψ' q ∈ R := fun q => ⟨0, q, by simp⟩
    have hVR : ∀ y : ↥V, vMap y ∈ R := by
      intro y
      have hy : vMap y = ψ' (ι_V y) := (DFunLike.congr_fun hComp y).symm
      rw [hy]
      exact hψ'R (ι_V y)
    have hγ₀_inv_R : γ₀⁻¹ ∈ R :=
      ⟨1, 1, by rw [pow_one, inv_mul_cancel₀ hg₀_ne, map_one]⟩
    have hRVx : ∀ r ∈ R, r ∈ Vx := by
      rintro r ⟨n, q, hr⟩
      have hγn : γ₀ ^ n ≠ 0 := pow_ne_zero n hg₀_ne
      have hreq : r = ψ' q * (γ₀⁻¹) ^ n := by
        calc
          r = (r * γ₀ ^ n) * (γ₀ ^ n)⁻¹ := (mul_inv_cancel_right₀ hγn r).symm
          _ = ψ' q * (γ₀⁻¹) ^ n := by rw [hr, inv_pow]
      rw [hreq]
      exact mul_mem (hAVx q) (pow_mem hg₀_inv n)
    let ψ : A →+* ↥R := ψ'.codRestrict R hψ'R
    have hψComp : ψ.comp ι_V = RingHom.codRestrict vMap R hVR :=
      RingHom.ext fun y => Subtype.ext (DFunLike.congr_fun hComp y)
    have hLoc : @IsLocalization.Away _ _ g₀ ↥R _ ψ.toAlgebra := by
      let _ : Algebra A ↥R := ψ.toAlgebra
      apply IsLocalization.Away.mk g₀
      · exact isUnit_iff_exists_inv.mpr
          ⟨⟨γ₀⁻¹, hγ₀_inv_R⟩, Subtype.ext (mul_inv_cancel₀ hg₀_ne)⟩
      · intro s
        obtain ⟨n, a, hs⟩ := s.2
        refine ⟨n, a, Subtype.ext ?_⟩
        simpa [ψ, γ₀, RingHom.algebraMap_toAlgebra] using hs
      · intro a b hab
        have hab' : ψ' a = ψ' b := congrArg Subtype.val hab
        rw [hInj hab']
        exact ⟨0, rfl⟩
    exact ⟨R, hVR, ψ, hRVx, hψ'R, hγ₀_inv_R, hψComp, hLoc⟩
  
  have hNodalKer : ∀ (u' w : E) (a : ↥V),
      Transcendental K u' →
      a ≠ 0 →
      u' * w = vMap a →
      ∀ F : MvPolynomial (Fin 2) ↥V,
        MvPolynomial.eval₂ vMap (fun i : Fin 2 => if i = 0 then u' else w) F = 0 →
        F ∈ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a} := by
    classical
    intro u' w a hu'_tr ha hu'w F hF_eval
    let gen : MvPolynomial (Fin 2) ↥V :=
      MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a
    let I_a : Ideal (MvPolynomial (Fin 2) ↥V) := Ideal.span {gen}
    have hX₀_reg : ∀ G : MvPolynomial (Fin 2) ↥V,
        MvPolynomial.X 0 * G ∈ I_a → G ∈ I_a := by
      intro G hXG
      obtain ⟨H, hH⟩ := Ideal.mem_span_singleton.mp hXG
      let B := MvPolynomial (Fin 1) ↥V
      let e : MvPolynomial (Fin 2) ↥V ≃ₐ[↥V] Polynomial B :=
        MvPolynomial.finSuccEquiv ↥V 1
      have heX0 : e (MvPolynomial.X 0) = Polynomial.X :=
        MvPolynomial.finSuccEquiv_X_zero
      have heX1 : e (MvPolynomial.X 1) = Polynomial.C (MvPolynomial.X 0) :=
        MvPolynomial.finSuccEquiv_X_succ (j := 0)
      have heCa : e (MvPolynomial.C a) = Polynomial.C (MvPolynomial.C a) := by
        dsimp only [e]
        rw [MvPolynomial.finSuccEquiv_apply]
        simp
      have heGen : e gen =
          Polynomial.X * Polynomial.C (MvPolynomial.X 0) - Polynomial.C (MvPolynomial.C a) := by
