          · rw [mul_assoc, hs₂_w, mul_zero]
          · calc
              (s₁ * s₂) * z = s₂ * (s₁ * z) := by ring
              _ = 0 := by rw [hs₁_ann z hzG, mul_zero]
    have hSq_sub : (↑S_q : Set F₀) ⊆ (q_bar : Set F₀) := by
