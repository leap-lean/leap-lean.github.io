        linarith
      let U : Set L₁ := Subtype.val '' U₀
      let S_pow : Set L₁ := {1} ∪ ⋃ (n : ℕ), (fun u : L₁ => u ^ (p ^ n)) '' U
      let B₀ : Set ↥L1_coeff := {1} ∪ ⋃ (n : ℕ), (fun u : ↥L1_coeff => u ^ (p ^ n)) '' U₀
      have hSpow_eq_img : S_pow = Subtype.val '' B₀ := by
        ext x
        simp only [S_pow, B₀, U, Set.mem_union, Set.mem_singleton_iff, Set.mem_iUnion, Set.mem_image]
        constructor
        · rintro (rfl | ⟨n, _, ⟨u₀, hu₀, rfl⟩, rfl⟩)
          · exact ⟨1, Or.inl rfl, rfl⟩
          · exact ⟨u₀ ^ (p ^ n), Or.inr ⟨n, u₀, hu₀, rfl⟩, rfl⟩
        · rintro ⟨y, rfl | ⟨n, u₀, hu₀, rfl⟩, rfl⟩
          · exact Or.inl rfl
          · exact Or.inr ⟨n, (u₀ : L₁), ⟨u₀, hu₀, rfl⟩, rfl⟩
      have hFamRange_eq : Set.range (fun idx => ((fam idx : ↥L1_coeff) : L₁)) = S_pow := by
        rw [hSpow_eq_img]
        ext x
        simp only [Set.mem_range, Set.mem_image, B₀, Set.mem_union, Set.mem_singleton_iff,
