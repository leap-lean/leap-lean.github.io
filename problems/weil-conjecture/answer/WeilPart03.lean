        have hSmulPowLalg : ∀ (e : ↥E_max) (x : ↥L1_coeff), (e • x) ^ p = (e ^ p) • (x ^ p) := by
          intro e x
          rw [Algebra.smul_def, Algebra.smul_def, mul_pow, map_pow]
        have hLI_level : ∀ (N : ℕ) (S : Finset (Option (ℕ × ↥U₀))) (g : Option (ℕ × ↥U₀) → ↥E_max),
