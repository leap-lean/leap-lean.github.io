              rw [hSumPowLalg]
              refine Finset.sum_congr rfl fun i hi => ?_
              rw [hSmulPowLalg, hr_pow i, hshift_pow i hi]
            have hu_part_mem : (∑ i ∈ S₀, g i • fam i) ∈ Submodule.span ↥E_max U₀ := by
              refine Submodule.sum_mem _ fun i hi => ?_
              rcases i with _ | ⟨n, u⟩
              · exfalso; exact Bool.false_ne_true (Finset.mem_filter.mp hi).2
