                ⟨Polynomial.aeval T Q, hpoly_T_mem_L Q⟩ := by
            apply Subtype.ext; rfl
          rw [hdiv_L, map_div₀, hPolyMapT P _, hPolyMapT Q _]
          have hPolyEvalCB : ∀ R_p : Polynomial K_hat, Polynomial.aeval T₁ R_p ∈ C_B := by
            intro R_p
            induction R_p using Polynomial.induction_on' with
            | add R₁ R₂ h₁ h₂ => rw [map_add]; exact C_B.add_mem h₁ h₂
            | monomial n c =>
              rw [Polynomial.aeval_monomial]
              exact C_B.mul_mem (hK_CB c) (C_B.pow_mem hT₁_CB n)
