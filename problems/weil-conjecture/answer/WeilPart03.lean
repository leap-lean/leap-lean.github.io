    have hCov' : iSup C'_open = ⊤ := by
      apply le_antisymm le_top
      intro x _
      rw [TopologicalSpace.Opens.mem_iSup]
      have hx : j.imageι.base x ∈ (⊤ : P_V.Opens) := trivial
      rw [← hCov, TopologicalSpace.Opens.mem_iSup] at hx
      exact hx
    have hLocal : ∀ a : Fin (M + 1),
        AlgebraicGeometry.Flat ((C'_open a).ι ≫ g') ∧
          AlgebraicGeometry.LocallyOfFinitePresentation ((C'_open a).ι ≫ g') := by
      intro a
      let W_K : C_K.Opens := j ⁻¹ᵁ U a
      have h_appLE_j : W_K.toSpecΓ ≫ AlgebraicGeometry.Spec.map (j.app (U a)) =
          j.resLE (U a) W_K (le_refl _) ≫ (U a).toSpecΓ := by
        have h0 := AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_appLE j (U a) W_K (le_refl _)
        dsimp only [AlgebraicGeometry.Scheme.Hom.appLE] at h0
        have h_id_K : C_K.presheaf.map (CategoryTheory.homOfLE (le_refl W_K)).op = 𝟙 _ := by
          rw [Subsingleton.elim (CategoryTheory.homOfLE (le_refl W_K)) (𝟙 W_K),
            CategoryTheory.op_id, CategoryTheory.Functor.map_id]
        rw [h_id_K, Category.comp_id] at h0
        exact h0
      have h_mor : W_K.toSpecΓ ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (c_V a) ≫ j.app (U a)) =
          (W_K.ι ≫ p_K) ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_RK) := by
        rw [AlgebraicGeometry.Spec.map_comp, ← Category.assoc, h_appLE_j, Category.assoc, hc_V a,
          ← Category.assoc (U a).toSpecΓ, (hAff a).toSpecΓ_fromSpec, ← Category.assoc,
          AlgebraicGeometry.Scheme.Hom.resLE_comp_ι, Category.assoc, hj_comm, Category.assoc]
      let κ_cat : CommRingCat.of K ⟶ Γ(C_K, W_K) :=
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫
          (W_K.ι ≫ p_K).appTop ≫ W_K.topIso.hom
      have h_factor : CommRingCat.ofHom (c_V a) ≫ j.app (U a) =
          CommRingCat.ofHom ι_RK ≫ κ_cat := by
        have h_top := congrArg (fun f =>
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫ f.appTop ≫ W_K.topIso.hom)
          h_mor
        simp only [AlgebraicGeometry.Scheme.Hom.comp_appTop,
          AlgebraicGeometry.Scheme.Opens.toSpecΓ_appTop, Category.assoc,
          Iso.inv_hom_id, Category.comp_id] at h_top
        rw [← Category.assoc (AlgebraicGeometry.Spec.map _).appTop,
          AlgebraicGeometry.Scheme.ΓSpecIso_naturality,
          ← Category.assoc, Iso.inv_hom_id, Category.id_comp] at h_top
        rw [h_top]
        have h_nat_V : (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_RK)).appTop =
            CommRingCat.ofHom ι_RK ≫
              (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).inv := by
          rw [← Iso.cancel_iso_hom_right _ _
              (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)),
            Category.assoc, AlgebraicGeometry.Scheme.ΓSpecIso_naturality, ← Category.assoc,
            Iso.inv_hom_id, Category.id_comp, Category.assoc, Iso.inv_hom_id, Category.comp_id]
        simp only [κ_cat, AlgebraicGeometry.Scheme.Hom.comp_appTop, ← Category.assoc]
        rw [h_nat_V]
      obtain ⟨θ_a, hθ_a⟩ := hPoly a
      let J_a : Ideal ↑Γ(P_V, U a) := j.ker.ideal ⟨U a, hAff a⟩
      let J'_a : Ideal (MvPolynomial (Fin M) R) := J_a.comap θ_a.toRingHom
      have hSat : ∀ (c : R) (f : MvPolynomial (Fin M) R),
          c ≠ 0 → MvPolynomial.C c * f ∈ J'_a → f ∈ J'_a := by
        intro c f hc hcf
        have hcK : ι_RK c ≠ 0 := fun h0 => hc (hInj (by rw [h0, map_zero]))
        have h_fac_c : (j.app (U a)).hom (c_V a c) = κ_cat.hom (ι_RK c) :=
          ConcreteCategory.congr_hom h_factor c
        have hUnit : IsUnit ((j.app (U a)).hom (c_V a c)) := by
          rw [h_fac_c]
          exact hcK.isUnit.map κ_cat.hom
        rcases hUnit with ⟨u, hu⟩
        change θ_a (MvPolynomial.C c * f) ∈ j.ker.ideal ⟨U a, hAff a⟩ at hcf
        change θ_a f ∈ j.ker.ideal ⟨U a, hAff a⟩
        rw [AlgebraicGeometry.Scheme.Hom.ker_apply, RingHom.mem_ker, map_mul, map_mul] at hcf
        have hc_eq : θ_a (MvPolynomial.C c) = c_V a c :=
          congrFun (congrArg DFunLike.coe hθ_a) c
        rw [hc_eq, ← hu] at hcf
        rw [AlgebraicGeometry.Scheme.Hom.ker_apply, RingHom.mem_ker]
        calc (j.app (U a)).hom (θ_a f)
          _ = ↑u⁻¹ * (↑u * (j.app (U a)).hom (θ_a f)) := by simp
          _ = 0 := by rw [hcf, mul_zero]
      let Q_a := MvPolynomial (Fin M) R ⧸ J'_a
      let φ_VQ : R →+* Q_a := (Ideal.Quotient.mk J'_a).comp MvPolynomial.C
      have hFlatAlg : φ_VQ.Flat := by
        change (algebraMap R Q_a).Flat
        rw [RingHom.flat_algebraMap_iff, Module.Flat.flat_iff_torsion_eq_bot_of_isBezout,
          eq_bot_iff]
        intro x hx
        obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective x
        rw [Submodule.mem_torsion_iff] at hx
        obtain ⟨⟨c, hc_nzd⟩, hc_smul⟩ := hx
        have hc_ne : c ≠ 0 := nonZeroDivisors.ne_zero hc_nzd
        have hsmul_eq : (⟨c, hc_nzd⟩ : nonZeroDivisors R) • Ideal.Quotient.mk J'_a f =
            Ideal.Quotient.mk J'_a (MvPolynomial.C c * f) := by
          change c • Ideal.Quotient.mk J'_a f = _
          rw [Algebra.smul_def]
          rfl
        rw [hsmul_eq, Ideal.Quotient.eq_zero_iff_mem] at hc_smul
        exact (Submodule.mem_bot _).mpr (Ideal.Quotient.eq_zero_iff_mem.mpr (hSat c f hc_ne hc_smul))
      have hFPAlg : φ_VQ.FinitePresentation := by
        have hFG : J'_a.FG := hSatFG M J'_a hSat
        have hC_fp : (MvPolynomial.C : R →+* MvPolynomial (Fin M) R).FinitePresentation :=
          RingHom.finitePresentation_algebraMap.mpr
            (Algebra.FinitePresentation.mvPolynomial R R (Fin M))
        have hQ_fp : (Ideal.Quotient.mk J'_a).FinitePresentation := by
          apply RingHom.FinitePresentation.of_surjective (Ideal.Quotient.mk J'_a)
            Ideal.Quotient.mk_surjective
          rwa [Ideal.mk_ker]
        exact hQ_fp.comp hC_fp
      have hJ_map : Ideal.map θ_a.toRingHom J'_a = J_a :=
        Ideal.map_comap_of_surjective θ_a.toRingHom θ_a.surjective J_a
      let e_quot : Q_a ≃+* (↑Γ(P_V, U a) ⧸ J_a) :=
        Ideal.quotientEquiv J'_a J_a θ_a hJ_map.symm
      let e_ring : CommRingCat.of Q_a ≅ Γ(j.image, C'_open a) :=
        e_quot.toCommRingCatIso ≪≫ (j.ker.subschemeObjIso ⟨U a, hAff a⟩).symm
      have h_ring_comm : CommRingCat.ofHom (c_V a) ≫ j.imageι.app (U a) =
          CommRingCat.ofHom φ_VQ ≫ e_ring.hom := by
        change CommRingCat.ofHom (c_V a) ≫ j.ker.subschemeι.app (U a) = _
        rw [AlgebraicGeometry.Scheme.IdealSheafData.subschemeι_app j.ker ⟨U a, hAff a⟩]
        have h_mk : CommRingCat.ofHom (c_V a) ≫ CommRingCat.ofHom (Ideal.Quotient.mk J_a) =
            CommRingCat.ofHom φ_VQ ≫ e_quot.toCommRingCatIso.hom := by
          rw [← CommRingCat.ofHom_comp]
          change _ = CommRingCat.ofHom (e_quot.toRingHom.comp φ_VQ)
          congr 1
          ext r
          have hr : θ_a (MvPolynomial.C r) = c_V a r :=
            congrFun (congrArg DFunLike.coe hθ_a) r
          dsimp only [RingHom.coe_comp, Function.comp_apply, RingEquiv.coe_toRingHom, φ_VQ]
          rw [← hr]
          rfl
        dsimp only [e_ring, Iso.trans_hom, Iso.symm_hom]
        rw [← Category.assoc]
        exact congrArg (· ≫ (j.ker.subschemeObjIso ⟨U a, hAff a⟩).inv) h_mk |>.trans
          (Category.assoc _ _ _)
      have h_chart_g : (C'_open a).ι ≫ g' =
          (C'_open a).toSpecΓ ≫ AlgebraicGeometry.Spec.map e_ring.hom ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_VQ) := by
        have h_appLE : (C'_open a).toSpecΓ ≫ AlgebraicGeometry.Spec.map (j.imageι.app (U a)) =
            j.imageι.resLE (U a) (C'_open a) (le_refl _) ≫ (U a).toSpecΓ := by
          have h0 := AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_appLE j.imageι (U a)
            (C'_open a) (le_refl _)
          dsimp only [AlgebraicGeometry.Scheme.Hom.appLE] at h0
          have h_id_C' :
              j.image.presheaf.map (CategoryTheory.homOfLE (le_refl (C'_open a))).op = 𝟙 _ := by
            rw [Subsingleton.elim (CategoryTheory.homOfLE (le_refl (C'_open a))) (𝟙 (C'_open a)),
              CategoryTheory.op_id, CategoryTheory.Functor.map_id]
          rw [h_id_C', Category.comp_id] at h0
          exact h0
        have h1 : (C'_open a).toSpecΓ ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (c_V a) ≫ j.imageι.app (U a)) =
            (C'_open a).ι ≫ g' := by
          rw [AlgebraicGeometry.Spec.map_comp, ← Category.assoc, h_appLE, Category.assoc, hc_V a,
            ← Category.assoc (U a).toSpecΓ, (hAff a).toSpecΓ_fromSpec,
            ← Category.assoc, AlgebraicGeometry.Scheme.Hom.resLE_comp_ι, Category.assoc]
        rw [← h1, h_ring_comm, AlgebraicGeometry.Spec.map_comp]
      have _ : IsIso (C'_open a).toSpecΓ := by
        rw [← ((hAff a).preimage j.imageι).isoSpec_hom]
        infer_instance
      have _ : IsIso (AlgebraicGeometry.Spec.map e_ring.hom) :=
        ⟨AlgebraicGeometry.Spec.map e_ring.inv,
          by rw [← AlgebraicGeometry.Spec.map_comp, Iso.inv_hom_id, AlgebraicGeometry.Spec.map_id],
          by rw [← AlgebraicGeometry.Spec.map_comp, Iso.hom_inv_id, AlgebraicGeometry.Spec.map_id]⟩
      have _ : AlgebraicGeometry.Flat (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_VQ)) :=
        AlgebraicGeometry.HasRingHomProperty.Spec_iff.mpr hFlatAlg
      have _ : AlgebraicGeometry.LocallyOfFinitePresentation
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_VQ)) :=
        AlgebraicGeometry.HasRingHomProperty.Spec_iff.mpr hFPAlg
      rw [h_chart_g]
      exact ⟨inferInstance, inferInstance⟩
    have hZ_Flat : AlgebraicGeometry.IsZariskiLocalAtSource (@AlgebraicGeometry.Flat.{u}) :=
      AlgebraicGeometry.HasRingHomProperty.instIsZariskiLocalAtSource
        (P := @AlgebraicGeometry.Flat.{u})
        (Q := fun {A B} [CommRing A] [CommRing B] => RingHom.Flat)
    have hZ_LFP : AlgebraicGeometry.IsZariskiLocalAtSource
        (@AlgebraicGeometry.LocallyOfFinitePresentation.{u}) :=
      AlgebraicGeometry.HasRingHomProperty.instIsZariskiLocalAtSource
        (P := @AlgebraicGeometry.LocallyOfFinitePresentation.{u})
        (Q := fun {A B} [CommRing A] [CommRing B] => RingHom.FinitePresentation)
    exact ⟨(@AlgebraicGeometry.IsZariskiLocalAtSource.of_iSup_eq_top
        (@AlgebraicGeometry.Flat.{u}) hZ_Flat _ _ g' _ C'_open hCov') (fun a => (hLocal a).1),
      (@AlgebraicGeometry.IsZariskiLocalAtSource.of_iSup_eq_top
        (@AlgebraicGeometry.LocallyOfFinitePresentation.{u}) hZ_LFP _ _ g' _ C'_open hCov')
        (fun a => (hLocal a).2)⟩
  have h_sec_lift : ∀ (K : Type u) [Field K] (V : ValuationSubring K)
      {C_K C' : AlgebraicGeometry.Scheme.{u}}
      (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
      (g' : C' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
      [AlgebraicGeometry.IsProper g']
      (ι' : C_K ⟶ C'),
      ι' ≫ g' = p_K ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype) →
      ∀ (σ : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K),
        σ ≫ p_K = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of K)) →
        ∃ τ : AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C',
          τ ≫ g' = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of ↥V)) ∧
          σ ≫ ι' = AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype) ≫ τ := by
    intro K _ V C_K C' p_K g' _ ι' h_comm_gen σ hσ
    have hUC : AlgebraicGeometry.UniversallyClosed g' := inferInstance
    have hEx : AlgebraicGeometry.ValuativeCriterion.Existence g' := by
      rw [AlgebraicGeometry.ValuativeCriterion.Existence.eq]
      rw [AlgebraicGeometry.universallyClosed_eq] at hUC
      exact CategoryTheory.MorphismProperty.universally_mono
        (fun (A B : AlgebraicGeometry.Scheme.{u}) (f : A ⟶ B) (hf : IsClosedMap f.base) =>
          hf.specializingMap) _ hUC
    have hSqComm : (σ ≫ ι') ≫ g' =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V K)) ≫
          𝟙 (AlgebraicGeometry.Spec (CommRingCat.of ↥V)) := by
      rw [Category.assoc, h_comm_gen, ← Category.assoc, hσ, Category.id_comp, Category.comp_id]
      rfl
    let sq : AlgebraicGeometry.ValuativeCommSq g' :=
      AlgebraicGeometry.ValuativeCommSq.mk ↥V K (σ ≫ ι')
        (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of ↥V))) ⟨hSqComm⟩
    have hLift : sq.commSq.HasLift := hEx sq
    exact ⟨sq.commSq.lift, sq.commSq.fac_right, sq.commSq.fac_left.symm⟩
  let S_V := AlgebraicGeometry.Spec (CommRingCat.of ↥V)
  let S_K := AlgebraicGeometry.Spec (CommRingCat.of K)
  let η_V : S_K ⟶ S_V := AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)
  have hOpen_η : AlgebraicGeometry.IsOpenImmersion η_V := by
    letI : Algebra ↥V K := V.subtype.toAlgebra
    exact @AlgebraicGeometry.IsOpenImmersion.of_isLocalization ↥V K _ _ _ s₀ hLocV
  have hQC_η : AlgebraicGeometry.QuasiCompact η_V := inferInstance
  have hPb_KV_flip := hBase_KV.2.1.flip
  have hOpen_Φ : AlgebraicGeometry.IsOpenImmersion Φ_KV :=
    CategoryTheory.MorphismProperty.of_isPullback
      (P := @AlgebraicGeometry.IsOpenImmersion.{u}) hPb_KV_flip hOpen_η
  have hQC_Φ : AlgebraicGeometry.QuasiCompact Φ_KV :=
    CategoryTheory.MorphismProperty.of_isPullback
      (P := @AlgebraicGeometry.QuasiCompact.{u}) hPb_KV_flip hQC_η
  have _ : AlgebraicGeometry.IsClosedImmersion Ψ_K := hClΨ
  let j : C_K ⟶ (weilProjectiveSpaceOver ↥V M).left := Ψ_K ≫ Φ_KV
  have hQC_j : AlgebraicGeometry.QuasiCompact j := inferInstance
  have hj_comm : j ≫ (weilProjectiveSpaceOver ↥V M).hom = p_K ≫ η_V := by
    dsimp only [j, η_V]
    rw [Category.assoc, hBase_KV.1, ← Category.assoc, hCommΨ]
  let C' : AlgebraicGeometry.Scheme.{u} := j.image
  let ιP' : C' ⟶ (weilProjectiveSpaceOver ↥V M).left := j.imageι
  let g' : C' ⟶ S_V := ιP' ≫ (weilProjectiveSpaceOver ↥V M).hom
  let ι' : C_K ⟶ C' := j.toImage
  have hClP' : AlgebraicGeometry.IsClosedImmersion ιP' := inferInstance
  have _ : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver ↥V M).hom := hCoord_V.1
  have hProp_g' : AlgebraicGeometry.IsProper g' := inferInstance
  have h_ι_ιP' : ι' ≫ ιP' = Ψ_K ≫ Φ_KV := AlgebraicGeometry.Scheme.Hom.toImage_imageι j
  have h_ι'_g' : ι' ≫ g' = p_K ≫ η_V := by
    change (ι' ≫ ιP') ≫ (weilProjectiveSpaceOver ↥V M).hom = p_K ≫ η_V
    rw [h_ι_ιP', hj_comm]
  have hIntC' : AlgebraicGeometry.IsIntegral C' :=
    @h_integral_img C_K (weilProjectiveSpaceOver ↥V M).left hIntCK j hQC_j
  have hPb_C' : CategoryTheory.IsPullback ι' p_K g' η_V :=
    @h_pb_img S_K S_V C_K (weilProjectiveSpaceOver K M).left (weilProjectiveSpaceOver ↥V M).left
      η_V p_K (weilProjectiveSpaceOver K M).hom (weilProjectiveSpaceOver ↥V M).hom
      Φ_KV hOpen_Φ Ψ_K hClΨ hQC_j hBase_KV.2.1 hCommΨ
  have hFlatLFP : AlgebraicGeometry.Flat g' ∧ AlgebraicGeometry.LocallyOfFinitePresentation g' :=
    @h_flat_lfp K ↥V _ _ _ _ V.subtype Subtype.val_injective hPkg.2.2.2.2.2
      C_K (weilProjectiveSpaceOver ↥V M).left p_K (weilProjectiveSpaceOver ↥V M).hom
      j hQC_j hj_comm M (weilProjBasicOpen ↥V M) hCoord_V.2.1 hAff_V c_V
      hCoord_V.2.2.1 hCoord_V.2.2.2.1
  have h_lift_all : ∀ j₀ : Fin n,
      ∃ τ : S_V ⟶ C', τ ≫ g' = 𝟙 S_V ∧ σ_K j₀ ≫ ι' = η_V ≫ τ :=
    fun j₀ => @h_sec_lift K _ V C_K C' p_K g' hProp_g' ι' h_ι'_g'
      (σ_K j₀) (hStabCK.2.2.2.2.2.1 j₀)
  choose τ' hτ'_g hτ'_gen using h_lift_all
  have h3 : 3 ≤ n := hStabCK.1
  let j_zero : Fin n := ⟨0, by omega⟩
  have hSurj_comp : AlgebraicGeometry.Surjective (τ' j_zero ≫ g') := by
    rw [hτ'_g j_zero]
    infer_instance
  have hSurj_g' : AlgebraicGeometry.Surjective g' :=
    @AlgebraicGeometry.Surjective.of_comp _ _ _ (τ' j_zero) g' hSurj_comp
  exact ⟨C', g', τ', ι', ιP',
    ⟨hIntC', hFlatLFP.1, hProp_g', hFlatLFP.2, hSurj_g',
      ⟨M, ιP', hClP', rfl⟩, hτ'_g, hPb_C', hτ'_gen⟩,
    hClP', rfl, h_ι_ιP'⟩

theorem weil_segre_model_domination_and_slice_properness (K : Type u) [Field K]
    (V : ValuationSubring K)
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (n : ℕ)
    (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (hIntCK : AlgebraicGeometry.IsIntegral C_K)
    (F : Type u) [Field F] [Algebra K F]
    (η_F : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ C_K)
    (hηF_comm : η_F ≫ p_K = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K F)))
    (hFuncF : IsSchemeFunctionField C_K F η_F)
    (C₀ : AlgebraicGeometry.Scheme.{u})
    (g₀ : C₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (τ₀ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C₀))
    (ι₀ : C_K ⟶ C₀)
    (hMod₀ : IsValuationPointedCurveModel V p_K n σ_K C₀ g₀ τ₀ ι₀)
    (hFunc₀ : IsSchemeFunctionField C₀ F (η_F ≫ ι₀))
    (M₀ : ℕ)
    (ιP₀ : C₀ ⟶ (weilProjectiveSpaceOver ↥V M₀).left)
    (hClP₀ : AlgebraicGeometry.IsClosedImmersion ιP₀)
    (hCommP₀ : ιP₀ ≫ (weilProjectiveSpaceOver ↥V M₀).hom = g₀)
    (hAff_proj : ∀ (R : Type u) [CommRing R] (N : ℕ) (a : Fin (N + 1)),
      AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen R N a))
    (c_proj : ∀ (R : Type u) [CommRing R] (N : ℕ) (a : Fin (N + 1)),
      R →+* ↑((weilProjectiveSpaceOver R N).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen R N a))))
    (t_proj : ∀ (R : Type u) [CommRing R] (N : ℕ) (a : Fin (N + 1)), Fin (N + 1) →
      ↑((weilProjectiveSpaceOver R N).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen R N a))))
    (hCoord_proj : ∀ (R : Type u) [CommRing R] (N : ℕ),
      IsCommRingProjCoordSystem R N (hAff_proj R N) (c_proj R N) (t_proj R N))
    (ξ : Fin (M₀ + 1) → F)
    (hC₀K_charts : ∀ r : Fin (M₀ + 1),
      let C₀_r : C₀.Opens :=
        (TopologicalSpace.Opens.map ιP₀.base).obj (weilProjBasicOpen ↥V M₀ r)
      let V_Kr : C_K.Opens :=
        (TopologicalSpace.Opens.map (ι₀ ≫ ιP₀).base).obj (weilProjBasicOpen ↥V M₀ r)
      AlgebraicGeometry.IsAffineOpen C₀_r ∧
      AlgebraicGeometry.IsAffineOpen V_Kr ∧
      (Nonempty ↥C₀_r ↔ ξ r ≠ 0) ∧
      (Nonempty ↥V_Kr ↔ ξ r ≠ 0) ∧
      (ξ r ≠ 0 →
        (∀ (hC₀r : AlgebraicGeometry.IsAffineOpen C₀_r)
            (φ₀ : C₀.presheaf.obj (Opposite.op C₀_r) ⟶ CommRingCat.of F),
          AlgebraicGeometry.Spec.map φ₀ ≫ hC₀r.fromSpec = η_F ≫ ι₀ →
          (∀ s : Fin (M₀ + 1),
            φ₀.hom ((ιP₀.app (weilProjBasicOpen ↥V M₀ r)).hom (t_proj ↥V M₀ r s)) =
              ξ s / ξ r) ∧
          Set.range φ₀.hom =
            (Subring.closure
              (Set.range ((algebraMap K F).comp V.subtype) ∪
                Set.range (fun s : Fin (M₀ + 1) => ξ s / ξ r)) : Set F)) ∧
        (∀ (hVKr : AlgebraicGeometry.IsAffineOpen V_Kr)
            (φ_K : C_K.presheaf.obj (Opposite.op V_Kr) ⟶ CommRingCat.of F),
          AlgebraicGeometry.Spec.map φ_K ≫ hVKr.fromSpec = η_F →
