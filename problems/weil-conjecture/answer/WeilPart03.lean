              | _ => false
            let S₀ : Finset (Option (ℕ × ↥U₀)) := S.filter (fun i => isZero i = true)
            let S_pos : Finset (Option (ℕ × ↥U₀)) := S.filter (fun i => ¬ (isZero i = true))
            have hsplit : (∑ i ∈ S, g i • fam i) =
