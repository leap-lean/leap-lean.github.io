    have hS_root_P₀ : ∀ γ ∈ S, (P₀_hat.map ι_Ω).eval γ = 0 := by
      intro γ hγ
      rw [hP₀_fac, Polynomial.map_mul, Polynomial.eval_mul]
      rcases Finset.mem_union.mp hγ with hγ₁ | hγ₂
      · rw [Multiset.mem_toFinset, Polynomial.mem_roots hP₁_Ω_monic.ne_zero] at hγ₁
        rw [hγ₁.eq_zero, zero_mul]
      · rw [Multiset.mem_toFinset, Polynomial.mem_roots hQ₂_Ω_monic.ne_zero] at hγ₂
        rw [hγ₂.eq_zero, mul_zero]
    have hS₂_root_G₀ : ∀ β ∈ S₂, (G₀_hat.map ι_Ω).eval β = 0 := by
      intro β hβ
      rw [Multiset.mem_toFinset, Polynomial.mem_roots hQ₂_Ω_monic.ne_zero] at hβ
      simp only [G₀_hat, Polynomial.map_mul, Polynomial.eval_mul,
        show Q₂.map ι_Ω = Q₂_Ω from rfl, hβ.eq_zero, mul_zero]
    let N₀ : ℕ := G₀_hat.natDegree
    let M_all : ℝ :=
      1 + (max 1 ‖θ_hat‖) ^ N₀ + ∑ β ∈ S₂, (max 1 (spectralNorm ↥Lx_hat Ω β)) ^ N₀
    have hM_all_pos : 0 < M_all := by
      have h1 : 0 ≤ (max 1 ‖θ_hat‖) ^ N₀ := pow_nonneg (by positivity) _
      have h2 : 0 ≤ ∑ β ∈ S₂, (max 1 (spectralNorm ↥Lx_hat Ω β)) ^ N₀ :=
        Finset.sum_nonneg fun _ _ => pow_nonneg (by positivity) _
      linarith
    have hδ_pos : 0 < (1 : ℝ) / (2 * M_all) := div_pos one_pos (by linarith)
    let b_coeff : ℕ → L₀ := fun j =>
      Classical.choose (hApprox_L₀ (G₀_hat.coeff j) hδ_pos)
    have hb_coeff : ∀ j : ℕ, ‖ι_L₀ (b_coeff j) - G₀_hat.coeff j‖ < 1 / (2 * M_all) :=
      fun j => Classical.choose_spec (hApprox_L₀ (G₀_hat.coeff j) hδ_pos)
    let G_base : Polynomial L₀ :=
      ∑ j ∈ Finset.range (N₀ + 1), Polynomial.C (b_coeff j) * Polynomial.X ^ j
    let G_base_hat : Polynomial ↥Lx_hat := G_base.map ι_L₀
    have hG_diff : G_base_hat - G₀_hat =
        ∑ j ∈ Finset.range (N₀ + 1),
          Polynomial.C (ι_L₀ (b_coeff j) - G₀_hat.coeff j) * Polynomial.X ^ j := by
      have hG₀_sum : G₀_hat =
          ∑ j ∈ Finset.range (N₀ + 1), Polynomial.C (G₀_hat.coeff j) * Polynomial.X ^ j :=
        G₀_hat.as_sum_range_C_mul_X_pow
      conv_lhs => rw [hG₀_sum]
      simp only [G_base_hat, G_base, Polynomial.map_sum, Polynomial.map_mul, Polynomial.map_C,
        Polynomial.map_pow, Polynomial.map_X, ← Finset.sum_sub_distrib, ← sub_mul, ← map_sub]
    have hG_base_θ : ‖Polynomial.aeval θ_hat G_base_hat - z_hat‖ < 1 / 2 := by
      have heq : Polynomial.aeval θ_hat G_base_hat - z_hat =
          Polynomial.aeval θ_hat (G_base_hat - G₀_hat) := by
        rw [map_sub, hG₀_eval]
      rw [heq, hG_diff, map_sum]
      apply ultrametric_norm_sum_lt (by norm_num)
      intro j hj
      rw [Finset.mem_range_succ_iff] at hj
      simp only [map_mul, Polynomial.aeval_C, map_pow, Polynomial.aeval_X, norm_mul, norm_pow]
      have hθ_pow : ‖θ_hat‖ ^ j ≤ M_all := by
        have h1 : ‖θ_hat‖ ^ j ≤ (max 1 ‖θ_hat‖) ^ j :=
          pow_le_pow_left₀ (norm_nonneg _) (le_max_right _ _) j
        have h2 : (max 1 ‖θ_hat‖) ^ j ≤ (max 1 ‖θ_hat‖) ^ N₀ :=
          pow_le_pow_right₀ (le_max_left _ _) hj
        have h3 : 0 ≤ ∑ β ∈ S₂, (max 1 (spectralNorm ↥Lx_hat Ω β)) ^ N₀ :=
          Finset.sum_nonneg fun _ _ => pow_nonneg (by positivity) _
        linarith
      have hlt_c : ‖((ι_L₀ (b_coeff j) - G₀_hat.coeff j : ↥Lx_hat) : F_hat)‖ < 1 / (2 * M_all) :=
        hb_coeff j
      calc ‖(Lx_hat.subtype (ι_L₀ (b_coeff j) - G₀_hat.coeff j))‖ * ‖θ_hat‖ ^ j
          ≤ ‖((ι_L₀ (b_coeff j) - G₀_hat.coeff j : ↥Lx_hat) : F_hat)‖ * M_all :=
            mul_le_mul_of_nonneg_left hθ_pow (norm_nonneg _)
        _ < (1 / (2 * M_all)) * M_all := mul_lt_mul_of_pos_right hlt_c hM_all_pos
        _ = 1 / 2 := by field_simp [ne_of_gt hM_all_pos]
    have hG_base_S₂ : ∀ β ∈ S₂, spectralNorm ↥Lx_hat Ω ((G_base_hat.map ι_Ω).eval β) < 1 / 2 := by
      intro β hβ
      have heq : (G_base_hat.map ι_Ω).eval β = ((G_base_hat - G₀_hat).map ι_Ω).eval β := by
        rw [Polynomial.map_sub, Polynomial.eval_sub, hS₂_root_G₀ β hβ, sub_zero]
      rw [heq, hG_diff, Polynomial.map_sum, Polynomial.eval_finsetSum]
      apply spectralNorm_sum_lt (by norm_num)
      intro j hj
      rw [Finset.mem_range_succ_iff] at hj
      simp only [Polynomial.map_mul, Polynomial.map_C, Polynomial.map_pow, Polynomial.map_X,
        Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_pow, Polynomial.eval_X]
      have hβ_pow : (spectralNorm ↥Lx_hat Ω β) ^ j ≤ M_all := by
        have h1 : (spectralNorm ↥Lx_hat Ω β) ^ j ≤ (max 1 (spectralNorm ↥Lx_hat Ω β)) ^ j :=
          pow_le_pow_left₀ (spectralNorm_nonneg β) (le_max_right _ _) j
        have h2 : (max 1 (spectralNorm ↥Lx_hat Ω β)) ^ j ≤
            (max 1 (spectralNorm ↥Lx_hat Ω β)) ^ N₀ :=
          pow_le_pow_right₀ (le_max_left _ _) hj
        have h3 : (max 1 (spectralNorm ↥Lx_hat Ω β)) ^ N₀ ≤
            ∑ b ∈ S₂, (max 1 (spectralNorm ↥Lx_hat Ω b)) ^ N₀ :=
          Finset.single_le_sum (f := fun b : Ω => (max 1 (spectralNorm ↥Lx_hat Ω b)) ^ N₀)
            (fun _ _ => pow_nonneg (by positivity) _) hβ
        have h4 : 0 ≤ (max 1 ‖θ_hat‖) ^ N₀ := pow_nonneg (by positivity) _
        linarith
      calc spectralNorm ↥Lx_hat Ω (ι_Ω (ι_L₀ (b_coeff j) - G₀_hat.coeff j) * β ^ j)
          ≤ ‖ι_L₀ (b_coeff j) - G₀_hat.coeff j‖ * (spectralNorm ↥Lx_hat Ω β) ^ j :=
            spectralNorm_smul_pow_le _ _ _
        _ ≤ ‖ι_L₀ (b_coeff j) - G₀_hat.coeff j‖ * M_all :=
            mul_le_mul_of_nonneg_left hβ_pow (norm_nonneg _)
        _ < (1 / (2 * M_all)) * M_all := mul_lt_mul_of_pos_right (hb_coeff j) hM_all_pos
        _ = 1 / 2 := by field_simp [ne_of_gt hM_all_pos]
    let C_pert : ℝ := 1 + ‖θ_hat‖ + ∑ β ∈ S₂, spectralNorm ↥Lx_hat Ω β
    have hTend_pert : Filter.Tendsto (fun m : ℕ => ‖ι_L₀ π₀‖ ^ m * C_pert)
        Filter.atTop (nhds 0) := by
      simpa [zero_mul] using
        (tendsto_pow_atTop_nhds_zero_of_lt_one (norm_nonneg _) hπ₀_norm_lt).mul_const C_pert
    obtain ⟨M₁, hM₁_pert⟩ :=
      Filter.eventually_atTop.mp (hTend_pert.eventually (gt_mem_nhds (by norm_num : (0 : ℝ) < 1 / 2)))
    let evalGm : ℕ → Ω → Ω := fun m γ =>
      (G_base_hat.map ι_Ω).eval γ + ι_Ω (ι_L₀ (π₀ ^ m)) * γ
    have hEx_m : ∃ m : ℕ, M₁ ≤ m ∧ Set.InjOn (evalGm m) (S : Set Ω) := by
      let I_fin : Finset ℕ := Finset.Ico M₁ (M₁ + (S ×ˢ S).card + 1)
      by_contra! hNoInj
      have hBad : ∀ m : ↥I_fin, ∃ p : ↥(S ×ˢ S),
          p.1.1 ≠ p.1.2 ∧ evalGm m.1 p.1.1 = evalGm m.1 p.1.2 := by
        intro m
        have hm_ge : M₁ ≤ m.1 := (Finset.mem_Ico.mp m.2).1
        have hnot := hNoInj m.1 hm_ge
        rw [Set.InjOn] at hnot
        push Not at hnot
        obtain ⟨γ₁, hγ₁, γ₂, hγ₂, heq, hne⟩ := hnot
        exact ⟨⟨(γ₁, γ₂), Finset.mem_product.mpr ⟨hγ₁, hγ₂⟩⟩, hne, heq⟩
      let φ_bad : ↥I_fin → ↥(S ×ˢ S) := fun m => Classical.choose (hBad m)
      have hφ_spec : ∀ m : ↥I_fin,
          (φ_bad m).1.1 ≠ (φ_bad m).1.2 ∧ evalGm m.1 (φ_bad m).1.1 = evalGm m.1 (φ_bad m).1.2 :=
        fun m => Classical.choose_spec (hBad m)
      have hcard_lt : Fintype.card ↥(S ×ˢ S) < Fintype.card ↥I_fin := by
        rw [Fintype.card_coe, Fintype.card_coe, Nat.card_Ico]
        omega
      obtain ⟨m₁, m₂, hm_ne, hφ_eq⟩ := Fintype.exists_ne_map_eq_of_card_lt φ_bad hcard_lt
      obtain ⟨hγ_ne, hev₁⟩ := hφ_spec m₁
      have hev₂ : evalGm m₂.1 (φ_bad m₁).1.1 = evalGm m₂.1 (φ_bad m₁).1.2 := by
        rw [hφ_eq]
        exact (hφ_spec m₂).2
      have hdiff0 : (ι_Ω (ι_L₀ (π₀ ^ m₁.1)) - ι_Ω (ι_L₀ (π₀ ^ m₂.1))) *
          ((φ_bad m₁).1.1 - (φ_bad m₁).1.2) = 0 := by
        dsimp only [evalGm] at hev₁ hev₂
        linear_combination hev₁ - hev₂
      rcases mul_eq_zero.mp hdiff0 with hc_eq | hγ_eq
      · rw [sub_eq_zero] at hc_eq
        have hπ_eq : ι_L₀ (π₀ ^ m₁.1) = ι_L₀ (π₀ ^ m₂.1) := ι_Ω.injective hc_eq
        have hnorm_eq : ‖ι_L₀ π₀‖ ^ m₁.1 = ‖ι_L₀ π₀‖ ^ m₂.1 := by
          simpa [map_pow, norm_pow] using congrArg norm hπ_eq
        have hm_val_eq : m₁.1 = m₂.1 := by
          rcases lt_trichotomy m₁.1 m₂.1 with hlt | heq | hgt
          · exfalso
            exact ne_of_gt (pow_lt_pow_right_of_lt_one₀ hπ₀_norm_pos hπ₀_norm_lt hlt) hnorm_eq
          · exact heq
          · exfalso
            exact ne_of_lt (pow_lt_pow_right_of_lt_one₀ hπ₀_norm_pos hπ₀_norm_lt hgt) hnorm_eq
        exact hm_ne (Subtype.ext hm_val_eq)
      · exact hγ_ne (sub_eq_zero.mp hγ_eq)
    obtain ⟨m, hm_ge, hm_inj⟩ := hEx_m
    have hm_pert : ‖ι_L₀ π₀‖ ^ m * C_pert < 1 / 2 := hM₁_pert m hm_ge
    let G_m : Polynomial L₀ := G_base + Polynomial.C (π₀ ^ m) * Polynomial.X
    let G_m_hat : Polynomial ↥Lx_hat := G_m.map ι_L₀
    let G_m_Ω : Polynomial Ω := G_m_hat.map ι_Ω
    have hGm_eval_eq : ∀ γ : Ω, G_m_Ω.eval γ = evalGm m γ := by
      intro γ
      simp [G_m_Ω, G_m_hat, G_m, G_base_hat, evalGm]
    let y : F := Polynomial.aeval θ₀ G_m
    let y₁ : F_hat := ι_F y
    have hy₁_eq : y₁ = Polynomial.aeval θ_hat G_m_hat := (hAeval_map G_m θ₀).symm
    have hy₁_dist : ‖y₁ - z_hat‖ < 1 := by
      have hsplit : y₁ - z_hat =
          (Polynomial.aeval θ_hat G_base_hat - z_hat) +
            (algebraMap ↥Lx_hat F_hat (ι_L₀ (π₀ ^ m))) * θ_hat := by
        rw [hy₁_eq]
        simp only [G_m_hat, G_m, G_base_hat, Polynomial.map_add, Polynomial.map_mul,
          Polynomial.map_C, Polynomial.map_X, map_add, map_mul, Polynomial.aeval_C,
          Polynomial.aeval_X]
        ring
      rw [hsplit]
      have h2 : ‖(algebraMap ↥Lx_hat F_hat (ι_L₀ (π₀ ^ m))) * θ_hat‖ < 1 / 2 := by
        rw [norm_mul, map_pow]
        change ‖(ι_L₀ π₀ : F_hat) ^ m‖ * ‖θ_hat‖ < 1 / 2
        rw [norm_pow]
        have hθ_le : ‖θ_hat‖ ≤ C_pert := by
          have hsum_nn : 0 ≤ ∑ β ∈ S₂, spectralNorm ↥Lx_hat Ω β :=
            Finset.sum_nonneg fun b _ => spectralNorm_nonneg b
          dsimp [C_pert]
          linarith
        calc ‖ι_L₀ π₀‖ ^ m * ‖θ_hat‖
            ≤ ‖ι_L₀ π₀‖ ^ m * C_pert :=
              mul_le_mul_of_nonneg_left hθ_le (pow_nonneg (norm_nonneg _) m)
          _ < 1 / 2 := hm_pert
      calc ‖(Polynomial.aeval θ_hat G_base_hat - z_hat) +
              (algebraMap ↥Lx_hat F_hat (ι_L₀ (π₀ ^ m))) * θ_hat‖
          ≤ ‖Polynomial.aeval θ_hat G_base_hat - z_hat‖ +
              ‖(algebraMap ↥Lx_hat F_hat (ι_L₀ (π₀ ^ m))) * θ_hat‖ := norm_add_le _ _
        _ < 1 / 2 + 1 / 2 := add_lt_add hG_base_θ h2
        _ = 1 := by norm_num
    let f : Polynomial L₀ := minpoly L₀ y
    have hy_int : IsIntegral L₀ y := Algebra.IsIntegral.isIntegral y
    have hf_monic : f.Monic := minpoly.monic hy_int
    have hf_sep : f.Separable := Algebra.IsSeparable.isSeparable L₀ y
    let f_hat : Polynomial ↥Lx_hat := f.map ι_L₀
    let f_Ω : Polynomial Ω := f_hat.map ι_Ω
    have hf_hat_monic : f_hat.Monic := hf_monic.map ι_L₀
    have hf_Ω_monic : f_Ω.Monic := hf_hat_monic.map ι_Ω
    have hf_Ω_sep : f_Ω.Separable := hf_sep.map.map
    have hf_Ω_deg : f_Ω.natDegree = f.natDegree :=
      (hf_hat_monic.natDegree_map ι_Ω).trans (hf_monic.natDegree_map ι_L₀)
    have hP₀_dvd_comp : P₀ ∣ f.comp G_m := by
      refine minpoly.dvd L₀ θ₀ ?_
      rw [Polynomial.aeval_comp]
      exact minpoly.aeval L₀ y
    have hf_Ω_roots_sub : S.image (evalGm m) ⊆ f_Ω.roots.toFinset := by
      intro r hr
      obtain ⟨γ, hγ, rfl⟩ := Finset.mem_image.mp hr
      rw [Multiset.mem_toFinset, Polynomial.mem_roots hf_Ω_monic.ne_zero, Polynomial.IsRoot]
      obtain ⟨q_c, hq_c⟩ := hP₀_dvd_comp
      have hmap_c := congrArg (fun p => ((p.map ι_L₀).map ι_Ω).eval γ) hq_c
      simp only [Polynomial.map_comp, Polynomial.map_mul, Polynomial.eval_comp,
        Polynomial.eval_mul, show P₀.map ι_L₀ = P₀_hat from rfl,
        show (f.map ι_L₀).map ι_Ω = f_Ω from rfl,
        show (G_m.map ι_L₀).map ι_Ω = G_m_Ω from rfl,
        hS_root_P₀ γ hγ, zero_mul, hGm_eval_eq] at hmap_c
      exact hmap_c
    have himg_card : (S.image (evalGm m)).card = d :=
      (Finset.card_image_of_injOn hm_inj).trans hS_card
    have hf_deg_le_d : f.natDegree ≤ d := by
      rw [← IntermediateField.adjoin.finrank hy_int]
      exact Submodule.finrank_le (IntermediateField.adjoin L₀ ({y} : Set F)).toSubmodule
    have hd_le_f_deg : d ≤ f_Ω.roots.toFinset.card :=
      himg_card ▸ Finset.card_le_card hf_Ω_roots_sub
    have hf_roots_le_deg : f_Ω.roots.toFinset.card ≤ f.natDegree := by
      calc f_Ω.roots.toFinset.card ≤ f_Ω.roots.card := Multiset.toFinset_card_le _
        _ ≤ f_Ω.natDegree := Polynomial.card_roots' f_Ω
        _ = f.natDegree := hf_Ω_deg
    have hf_deg_eq_d : f.natDegree = d := by omega
    have hy_prim : IntermediateField.adjoin L₀ ({y} : Set F) = ⊤ := by
      have hfin : Module.finrank L₀ ↥(IntermediateField.adjoin L₀ ({y} : Set F)) =
          Module.finrank L₀ F := (IntermediateField.adjoin.finrank hy_int).trans hf_deg_eq_d
      have hsub_top : (IntermediateField.adjoin L₀ ({y} : Set F)).toSubmodule = ⊤ :=
        Submodule.eq_top_of_finrank_eq hfin
      apply top_unique
      intro z _
      change z ∈ (IntermediateField.adjoin L₀ ({y} : Set F)).toSubmodule
      rw [hsub_top]
      trivial
    have hf_Ω_roots_eq : f_Ω.roots.toFinset = S.image (evalGm m) :=
      (Finset.eq_of_subset_of_card_le hf_Ω_roots_sub (by omega)).symm
    have hf_Ω_prod : f_Ω = ∏ γ ∈ S, (Polynomial.X - Polynomial.C (evalGm m γ)) := by
      have hcard_f : f_Ω.roots.toFinset.card = f_Ω.natDegree := by omega
      rw [← prod_roots_toFinset_of_monic_separable hf_Ω_monic hf_Ω_sep hcard_f,
        hf_Ω_roots_eq, Finset.prod_image (fun x hx y hy hxy => hm_inj hx hy hxy)]
    let f₁ : Polynomial ↥Lx_hat := minpoly ↥Lx_hat y₁
    have hf_hat_eval : Polynomial.aeval y₁ f_hat = 0 := by
      rw [hAeval_map f y, minpoly.aeval L₀ y, map_zero]
    have hy₁_int : IsIntegral ↥Lx_hat y₁ := ⟨f_hat, hf_hat_monic, hf_hat_eval⟩
    have hf₁_monic : f₁.Monic := minpoly.monic hy₁_int
    have hf₁_deg : f₁.natDegree = d₁ := hGen_z y₁ hy₁_dist
    have hf₁_dvd : f₁ ∣ f_hat := minpoly.dvd ↥Lx_hat y₁ hf_hat_eval
    obtain ⟨g₂, hf_fac⟩ := hf₁_dvd
    have hg₂_ne : g₂ ≠ 0 := right_ne_zero_of_mul (hf_fac ▸ hf_hat_monic.ne_zero)
    have hg₂_monic : g₂.Monic := by
      rw [Polynomial.Monic]
      have hlead : f_hat.leadingCoeff = f₁.leadingCoeff * g₂.leadingCoeff := by
        rw [hf_fac, Polynomial.leadingCoeff_mul]
      rw [hf_hat_monic.leadingCoeff, hf₁_monic.leadingCoeff, one_mul] at hlead
      exact hlead.symm
    have hf_hat_sep : f_hat.Separable := hf_sep.map
    have hf₁_sep : f₁.Separable := Polynomial.Separable.of_mul_left (hf_fac ▸ hf_hat_sep)
    let f₁_Ω : Polynomial Ω := f₁.map ι_Ω
    have hf₁_Ω_monic : f₁_Ω.Monic := hf₁_monic.map ι_Ω
    have hf₁_Ω_sep : f₁_Ω.Separable := hf₁_sep.map
    have hf₁_Ω_deg : f₁_Ω.natDegree = d₁ := (hf₁_monic.natDegree_map ι_Ω).trans hf₁_deg
    have hP₁_dvd_comp : P₁ ∣ f₁.comp G_m_hat := by
      refine minpoly.dvd ↥Lx_hat θ_hat ?_
      rw [Polynomial.aeval_comp, ← hy₁_eq]
      exact minpoly.aeval ↥Lx_hat y₁
    have hf₁_Ω_roots_sub : S₁.image (evalGm m) ⊆ f₁_Ω.roots.toFinset := by
      intro r hr
      obtain ⟨α, hα, rfl⟩ := Finset.mem_image.mp hr
      rw [Multiset.mem_toFinset, Polynomial.mem_roots hf₁_Ω_monic.ne_zero, Polynomial.IsRoot]
      have hα_root : P₁_Ω.eval α = 0 := by
        rw [Multiset.mem_toFinset, Polynomial.mem_roots hP₁_Ω_monic.ne_zero] at hα
        exact hα.eq_zero
      obtain ⟨q_c, hq_c⟩ := hP₁_dvd_comp
      have hmap_c := congrArg (fun p => (p.map ι_Ω).eval α) hq_c
      simp only [Polynomial.map_comp, Polynomial.map_mul, Polynomial.eval_comp,
        Polynomial.eval_mul, show P₁.map ι_Ω = P₁_Ω from rfl,
        show f₁.map ι_Ω = f₁_Ω from rfl, show G_m_hat.map ι_Ω = G_m_Ω from rfl,
        hα_root, zero_mul, hGm_eval_eq] at hmap_c
      exact hmap_c
    have hm_inj_S₁ : Set.InjOn (evalGm m) (S₁ : Set Ω) :=
      hm_inj.mono (by intro x hx; exact Finset.mem_coe.mpr (Finset.mem_union_left S₂ hx))
    have himg_S₁_card : (S₁.image (evalGm m)).card = d₁ :=
      (Finset.card_image_of_injOn hm_inj_S₁).trans hS₁_card
    have hf₁_roots_le : f₁_Ω.roots.toFinset.card ≤ d₁ := by
      calc f₁_Ω.roots.toFinset.card ≤ f₁_Ω.roots.card := Multiset.toFinset_card_le _
        _ ≤ f₁_Ω.natDegree := Polynomial.card_roots' f₁_Ω
        _ = d₁ := hf₁_Ω_deg
    have hf₁_Ω_roots_eq : f₁_Ω.roots.toFinset = S₁.image (evalGm m) :=
      (Finset.eq_of_subset_of_card_le hf₁_Ω_roots_sub
        (by rw [himg_S₁_card]; exact hf₁_roots_le)).symm
    have hf₁_Ω_prod : f₁_Ω = ∏ α ∈ S₁, (Polynomial.X - Polynomial.C (evalGm m α)) := by
