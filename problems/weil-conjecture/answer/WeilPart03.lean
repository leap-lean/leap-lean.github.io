        have hGeomInvRB : ∀ x ∈ R_B, ‖x‖ < 1 → (1 - x)⁻¹ ∈ R_B.topologicalClosure := by
          intro x hx_mem hx_lt
          have h1x_norm : ‖(1 : L₁) - x‖ = 1 := by
