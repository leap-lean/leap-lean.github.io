      have hsub₂ : (v₁ : F_hat) - (v₂ : F_hat) = (φ₀ (φ₀.symm (v₁ - v₂)) : F_hat) := by simp
      rw [hsub₁, hsub₂, hφ₀_norm (φ₀.symm (v₁ - v₂))]
