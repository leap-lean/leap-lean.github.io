        hψ_E_val
      let T_alg : ↥L1_coeff := inc_F0_L1 (e_F₀ ⟨T, hT⟩)
      have hT_alg_val : (T_alg : L₁) = algebraMap ↥L L₁ ⟨T, hL_sub hT⟩ := rfl
      let w_sub : ↥L1_coeff := ⟨w_coeff,
        IntermediateField.subset_adjoin ↥F₀ ({w_coeff} : Set L₁) (Set.mem_singleton w_coeff)⟩
      have hex_U₀ : ∃ U₀ : Set ↥L1_coeff,
          LinearIndependent ↥E_max ((↑) : U₀ → ↥L1_coeff) ∧
          (∀ u ∈ Submodule.span ↥E_max U₀, ∀ z : ↥L1_coeff, u + z ^ p = 0 → u = 0) ∧
          Submodule.span ↥E_max ({1} ∪ ⋃ (n : ℕ), (fun u : ↥L1_coeff => u ^ (p ^ n)) '' U₀) = ⊤ := by
        letI : Algebra ↥E_max ↥L_coeff := ιE_Lcoeff.toAlgebra
        have hT_trans : Transcendental ↥E_max T_alg := by
          have haev_mem_L : ∀ Q : Polynomial ↥E_max,
              Polynomial.aeval T (Polynomial.map ((algebraMap K_hat E_hat).comp E_max.subtype) Q) ∈ L := by
            intro Q
            induction Q using Polynomial.induction_on' with
            | add Q₁ Q₂ h₁ h₂ =>
              rw [Polynomial.map_add, map_add]
              exact L.add_mem h₁ h₂
            | monomial n e =>
              rw [Polynomial.map_monomial, Polynomial.aeval_monomial]
              exact L.mul_mem (hL_sub (hE_sub e)) (L.pow_mem (hL_sub hT) n)
          have hmap_eq : ∀ Q : Polynomial ↥E_max,
              ((Polynomial.aeval T_alg Q : ↥L1_coeff) : L₁) =
                algebraMap ↥L L₁ ⟨Polynomial.aeval T
                  (Polynomial.map ((algebraMap K_hat E_hat).comp E_max.subtype) Q), haev_mem_L Q⟩ := by
            intro Q
            induction Q using Polynomial.induction_on' with
            | add Q₁ Q₂ h₁ h₂ =>
              simp only [map_add, Polynomial.map_add]
              rw [Subfield.coe_add, h₁, h₂, ← map_add]
              rfl
