        have hle2 : ‖z⁻¹‖ ≤ 1 := hL1_coeff_norm_le z⁻¹ (L1_coeff.inv_mem hz)
        rw [norm_inv] at hle2
        have hz_pos : 0 < ‖z‖ := norm_pos_iff.mpr hzne
        have hge1 : 1 ≤ ‖z‖ := (inv_le_one₀ hz_pos).mp hle2
        exact le_antisymm hle1 hge1
      let ιE_Lcoeff : ↥E_max →+* ↥L_coeff :=
        ((algebraMap K_hat E_hat).comp E_max.subtype).codRestrict L_coeff.toSubring hE_sub
      let inc_F0_L1 : ↥F₀ →+* ↥L1_coeff := Subfield.inclusion hF0_le_L1
      let ψ_E : ↥E_max →+* ↥L1_coeff := inc_F0_L1.comp (e_F₀.toRingHom.comp ιE_Lcoeff)
      have hψ_E_val : ∀ e : ↥E_max, ((ψ_E e : ↥L1_coeff) : L₁) = algebraMap K_hat L₁ (e : K_hat) := by
        intro e
        change φ (ιE_Lcoeff e) = algebraMap K_hat L₁ (e : K_hat)
