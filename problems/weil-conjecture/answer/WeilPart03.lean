      obtain ⟨hp1_ne, hp1_V₁, hp2_pos, hp_Vx⟩ := hS p (Finset.mem_insert_self p S')
      obtain ⟨σ, hσ_ne, hσ_Vx, hσ_p⟩ := h_low_root hp1_ne hp1_V₁ hp2_pos hp_Vx
      rcases ValuationRing.dvd_total π₁' σ with ⟨c_div, hc_div⟩ | ⟨c_div, hc_div⟩
      · refine ⟨σ, hσ_ne, hσ_Vx, fun q hq => ?_⟩
