        rw [hνp_smul c f hc, hνm_smul c f hc]
      · intro f g
        dsimp only [ν_tot]
        exact max_le
          ((hνp_add f g).trans (max_le_max (le_max_left _ _) (le_max_left _ _)))
          ((hνm_add f g).trans (max_le_max (le_max_right _ _) (le_max_right _ _)))
