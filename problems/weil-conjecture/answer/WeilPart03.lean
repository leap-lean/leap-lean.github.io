        K_base hRangeBase hClBase hType3 hIsoBase hAlgCompat hIsoGal P hP_mem hP_pGroup F_sub hValSub
  obtain ⟨hModK', hFinrankMul, hValTop, hResTop⟩ := hMain23
  
  have hEqTop : L_top = K'_int := by
    rcases hP_pGroup with hP_bot | ⟨p, hp, hp0, hP_pg⟩
    · have hK'_top : K'_int = ⊤ := by
