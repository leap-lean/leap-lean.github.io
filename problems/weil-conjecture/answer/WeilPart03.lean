      let A_p : Fin (N + 1) → Polynomial K := fun t => Classical.choose (hAB t)
      let B_p : Fin (N + 1) → Polynomial K := fun t => Classical.choose (Classical.choose_spec (hAB t))
      have hAB_spec : ∀ t : Fin (N + 1),
          Polynomial.aeval z₀ (B_p t) ≠ 0 ∧ B_p t ≠ 0 ∧
          (u t : F) * Polynomial.aeval z₀ (B_p t) = Polynomial.aeval z₀ (A_p t) ∧
          (u t ≠ 0 → A_p t ≠ 0) :=
        fun t => Classical.choose_spec (Classical.choose_spec (hAB t))
