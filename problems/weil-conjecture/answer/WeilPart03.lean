    have hM_prod : (M.map (fun b => Polynomial.X - Polynomial.C b)).prod = Q.map ι_K := by
      change ((M₀.map ι_K).map (fun b => Polynomial.X - Polynomial.C b)).prod = Q.map ι_K
      rw [hQ_prod, Polynomial.map_multiset_prod, Multiset.map_map, Multiset.map_map]
      congr 1
      refine Multiset.map_congr rfl fun c _ => ?_
      simp
    refine ⟨M, hM_card, fun i _ => ?_⟩
    rw [hM_prod]
    exact hQ_err i

theorem weil_heightOne_valuation_normed_completion (F : Type u) [Field F] (W₁ : ValuationSubring F)
    (hW₁_ne : W₁ ≠ ⊤)
    (hW₁_ht1 : ∀ P : Ideal ↥W₁, P.IsPrime → P = ⊥ ∨ P = IsLocalRing.maximalIdeal ↥W₁) :
    ∃ (F_hat : Type u) (_ : NontriviallyNormedField F_hat)
      (_ : CompleteSpace F_hat) (_ : IsUltrametricDist F_hat)
      (ι_F : F →+* F_hat),
      DenseRange ι_F ∧
      (∀ w : F, w ∈ W₁ ↔ ‖ι_F w‖ ≤ 1) ∧
      (∀ (w : F) (hw : w ∈ W₁), (⟨w, hw⟩ ∈ IsLocalRing.maximalIdeal ↥W₁ ↔ ‖ι_F w‖ < 1)) ∧
      (∀ (K : Type u) [Field K] [Algebra K F],
        let V₁ : ValuationSubring K := W₁.comap (algebraMap K F)
        V₁ ≠ ⊤ →
        ∃ (K_hat : Type u) (_ : NontriviallyNormedField K_hat)
          (_ : CompleteSpace K_hat) (_ : IsUltrametricDist K_hat)
          (_ : Algebra K_hat F_hat) (ι_K : K →+* K_hat),
          DenseRange ι_K ∧
          (∀ c : K, algebraMap K_hat F_hat (ι_K c) = ι_F (algebraMap K F c)) ∧
          (∀ c : K_hat, ‖algebraMap K_hat F_hat c‖ = ‖c‖) ∧
          (∀ x : F,
            (IntermediateField.adjoin K_hat ({ι_F x} : Set F_hat)).toSubfield.topologicalClosure =
            (ι_F.comp (IntermediateField.adjoin K ({x} : Set F)).val.toRingHom).fieldRange.topologicalClosure) ∧
          (let OF : ValuationSubring F_hat := (NormedField.valuation (K := F_hat)).valuationSubring
           let OK : ValuationSubring K_hat := OF.comap (algebraMap K_hat F_hat)
           let κF := IsLocalRing.ResidueField ↥OF
           let κ_hom : ↥OK →+* κF :=
             (IsLocalRing.residue ↥OF).comp
               (((algebraMap K_hat F_hat).comp OK.subtype).codRestrict OF.toSubring (fun c => c.2))
           ∀ (φ_res : IsLocalRing.ResidueField ↥V₁ →+* IsLocalRing.ResidueField ↥W₁),
             (∀ (v : K) (hv : v ∈ V₁) (hvF : algebraMap K F v ∈ W₁),
               φ_res (IsLocalRing.residue ↥V₁ ⟨v, hv⟩) = IsLocalRing.residue ↥W₁ ⟨algebraMap K F v, hvF⟩) →
             ∀ (x₀ : F) (hx₀ : x₀ ∈ W₁) (hx₀_hat : ι_F x₀ ∈ OF),
               letI : Algebra (IsLocalRing.ResidueField ↥V₁) (IsLocalRing.ResidueField ↥W₁) := φ_res.toAlgebra
               let x_tilde : IsLocalRing.ResidueField ↥W₁ := IsLocalRing.residue ↥W₁ ⟨x₀, hx₀⟩
               let L_tilde := IntermediateField.adjoin (IsLocalRing.ResidueField ↥V₁) ({x_tilde} : Set _)
               let x_res : κF := IsLocalRing.residue ↥OF ⟨ι_F x₀, hx₀_hat⟩
               let K_res : Subfield κF := Subfield.closure (Set.range κ_hom)
               let Kx_res : Subfield κF := Subfield.closure (Set.range κ_hom ∪ {x_res})
               letI : Algebra ↥K_res κF := K_res.toAlgebra
               letI : Algebra ↥Kx_res κF := Kx_res.toAlgebra
               Transcendental (IsLocalRing.ResidueField ↥V₁) x_tilde →
               Algebra.IsSeparable ↥L_tilde (IsLocalRing.ResidueField ↥W₁) →
               Transcendental ↥K_res x_res ∧ Algebra.IsSeparable ↥Kx_res κF)) :=
by
  have h_s1 : ∃ (F_hat : Type u) (_ : NontriviallyNormedField F_hat)
      (_ : CompleteSpace F_hat) (_ : IsUltrametricDist F_hat)
      (ι_F : F →+* F_hat),
      DenseRange ι_F ∧
      (∀ w : F, w ∈ W₁ ↔ ‖ι_F w‖ ≤ 1) ∧
      (∀ (w : F) (hw : w ∈ W₁), (⟨w, hw⟩ ∈ IsLocalRing.maximalIdeal ↥W₁ ↔ ‖ι_F w‖ < 1)) := by
    let Γ₀ : Type u := W₁.ValueGroup
    let v : Valuation F Γ₀ := W₁.valuation
    have inv_lt_one_of_one_lt : ∀ {g : Γ₀}, 1 < g → g⁻¹ < 1 := by
      intro g hg
      have hg0 : g ≠ 0 := ne_of_gt (lt_of_le_of_lt zero_le hg)
      by_contra hge
      have hle : 1 ≤ g⁻¹ := not_lt.mp hge
      have hmul : g * 1 ≤ g * g⁻¹ := mul_le_mul_of_nonneg_left hle zero_le
      rw [mul_one, mul_inv_cancel₀ hg0] at hmul
      exact not_lt_of_ge hmul hg
    have hex_not_mem : ∃ z : F, z ∉ W₁ := by
      by_contra h
      push Not at h
      exact hW₁_ne (by ext z; simp [h z])
    obtain ⟨z₀, hz₀_not⟩ := hex_not_mem
    have hz₀_ne : z₀ ≠ 0 := fun h0 => hz₀_not (h0 ▸ W₁.zero_mem)
    have hvz₀_gt : 1 < v z₀ := not_le.mp (mt (ValuationSubring.valuation_le_one_iff W₁ z₀).mp hz₀_not)
    have hv_z₀_inv_lt : v z₀⁻¹ < 1 := by
      rw [map_inv₀]
      exact inv_lt_one_of_one_lt hvz₀_gt
    have hArchΓ : MulArchimedean Γ₀ := by
      refine ⟨fun {x y} hy => ?_⟩
      by_cases hx1 : x ≤ 1
      · exact ⟨0, by simpa using hx1⟩
      · have hx : 1 < x := not_le.mp hx1
        have hx0 : x ≠ 0 := ne_of_gt (lt_of_le_of_lt zero_le hx)
        have hy0 : y ≠ 0 := ne_of_gt (lt_of_le_of_lt zero_le hy)
        have hxi_lt : x⁻¹ < 1 := inv_lt_one_of_one_lt hx
        have hyi_lt : y⁻¹ < 1 := inv_lt_one_of_one_lt hy
        obtain ⟨a, ha_v⟩ := ValuationSubring.valuation_surjective W₁ x⁻¹
        obtain ⟨b, hb_v⟩ := ValuationSubring.valuation_surjective W₁ y⁻¹
        have ha_ne : a ≠ 0 := by
          intro ha0
          apply inv_ne_zero hx0
          rw [← ha_v, ha0, map_zero]
        have ha_mem : a ∈ W₁ :=
          (ValuationSubring.valuation_le_one_iff W₁ a).mp (ha_v.trans_le (le_of_lt hxi_lt))
        have hb_mem : b ∈ W₁ :=
          (ValuationSubring.valuation_le_one_iff W₁ b).mp (hb_v.trans_le (le_of_lt hyi_lt))
        let a₀ : ↥W₁ := ⟨a, ha_mem⟩
        let b₀ : ↥W₁ := ⟨b, hb_mem⟩
        have ha₀_ne : a₀ ≠ 0 := fun h => ha_ne (congrArg Subtype.val h)
        have hb₀_max : b₀ ∈ IsLocalRing.maximalIdeal ↥W₁ :=
          (ValuationSubring.valuation_lt_one_iff W₁ b₀).mpr (hb_v.trans_lt hyi_lt)
        let I : Ideal ↥W₁ := Ideal.span ({a₀} : Set ↥W₁)
        have hb₀_rad : b₀ ∈ I.radical := by
          rw [Ideal.radical_eq_sInf, Ideal.mem_sInf]
          rintro J ⟨hIJ, hJ_prime⟩
          rcases hW₁_ht1 J hJ_prime with rfl | rfl
          · exfalso
            have ha₀_bot : a₀ ∈ (⊥ : Ideal ↥W₁) := hIJ (Ideal.subset_span (Set.mem_singleton a₀))
            exact ha₀_ne (Ideal.mem_bot.mp ha₀_bot)
          · exact hb₀_max
        obtain ⟨n, hn_mem⟩ := Ideal.mem_radical_iff.mp hb₀_rad
        obtain ⟨q, hq_eq⟩ := Ideal.mem_span_singleton.mp hn_mem
        have hbn_eq : b ^ n = a * q.1 := by
          simpa using congrArg Subtype.val hq_eq
        have hvq_le : v q.1 ≤ 1 := (ValuationSubring.valuation_le_one_iff W₁ q.1).mpr q.2
        have hyn_inv_le : (y ^ n)⁻¹ ≤ x⁻¹ := by
          calc (y ^ n)⁻¹ = (y⁻¹) ^ n := (inv_pow y n).symm
            _ = (v b) ^ n := by rw [hb_v]
            _ = v (b ^ n) := (map_pow v b n).symm
            _ = v (a * q.1) := by rw [hbn_eq]
            _ = v a * v q.1 := map_mul v a q.1
            _ = x⁻¹ * v q.1 := by rw [ha_v]
            _ ≤ x⁻¹ * 1 := mul_le_mul_of_nonneg_left hvq_le zero_le
            _ = x⁻¹ := mul_one x⁻¹
        have hyn0 : y ^ n ≠ 0 := pow_ne_zero n hy0
        refine ⟨n, ?_⟩
        calc x = x * ((y ^ n)⁻¹ * y ^ n) := by rw [inv_mul_cancel₀ hyn0, mul_one]
          _ = (x * (y ^ n)⁻¹) * y ^ n := (mul_assoc _ _ _).symm
          _ ≤ (x * x⁻¹) * y ^ n :=
            mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hyn_inv_le zero_le) zero_le
          _ = y ^ n := by rw [mul_inv_cancel₀ hx0, one_mul]
    have _ : MulArchimedean Γ₀ := hArchΓ
    let _ : Valued F Γ₀ := Valued.mk' v
    let ι_F : F →+* UniformSpace.Completion F := UniformSpace.Completion.coeRingHom
    let v_hat : Valuation (UniformSpace.Completion F) Γ₀ := Valued.v
    have hv_comp_nontriv : v_hat.IsNontrivial := by
      rw [Valuation.isNontrivial_iff_exists_lt_one]
      refine ⟨ι_F z₀⁻¹, ι_F.injective.ne (inv_ne_zero hz₀_ne), ?_⟩
      exact (Valued.valuedCompletion_apply z₀⁻¹).trans_lt hv_z₀_inv_lt
    have hArchG₀ : MulArchimedean (MonoidWithZeroHom.ofClass v_hat).ValueGroup₀ := by
      let emb : (MonoidWithZeroHom.ofClass v_hat).ValueGroup₀ →*₀ Γ₀ :=
        MonoidWithZeroHom.ValueGroup₀.embedding
      have hemb_mono : StrictMono emb := MonoidWithZeroHom.ValueGroup₀.embedding_strictMono
      refine ⟨fun {x y} hy => ?_⟩
      have hy' : (1 : Γ₀) < emb y := by
        simpa [map_one] using hemb_mono hy
      obtain ⟨n, hn⟩ := MulArchimedean.arch (emb x) hy'
      refine ⟨n, ?_⟩
      rw [← map_pow] at hn
      exact hemb_mono.le_iff_le.mp hn
    have hRankOne_ne : Nonempty v_hat.RankOne :=
      (@Valuation.nonempty_rankOne_iff_mulArchimedean (UniformSpace.Completion F) Γ₀ _ _
        v_hat hv_comp_nontriv).mpr hArchG₀
    rcases hRankOne_ne with ⟨hr1_comp⟩
    let _ : (Valued.v : Valuation (UniformSpace.Completion F) Γ₀).RankOne := hr1_comp
    let _ : NontriviallyNormedField (UniformSpace.Completion F) :=
      Valued.toNontriviallyNormedField (UniformSpace.Completion F) Γ₀
    refine ⟨UniformSpace.Completion F,
      Valued.toNontriviallyNormedField (UniformSpace.Completion F) Γ₀,
      UniformSpace.Completion.completeSpace F,
      Valued.instIsUltrametricDist (UniformSpace.Completion F) Γ₀,
      ι_F,
      UniformSpace.Completion.denseRange_coe, ?_, ?_⟩
    · intro w
      rw [Valued.toNormedField.norm_le_one_iff]
      change w ∈ W₁ ↔ Valued.v ((w : F) : UniformSpace.Completion F) ≤ 1
      rw [Valued.valuedCompletion_apply]
      exact (ValuationSubring.valuation_le_one_iff W₁ w).symm
    · intro w hw
      rw [ValuationSubring.valuation_lt_one_iff, Valued.toNormedField.norm_lt_one_iff]
      change v w < 1 ↔ Valued.v ((w : F) : UniformSpace.Completion F) < 1
      rw [Valued.valuedCompletion_apply]
      rfl
  obtain ⟨F_hat, instNormF, instCompF, instUltraF, ι_F, hDenseF, hMemF, hMaxF⟩ := h_s1
  let _ : NontriviallyNormedField F_hat := instNormF
  have _ : CompleteSpace F_hat := instCompF
  have _ : IsUltrametricDist F_hat := instUltraF
  refine ⟨F_hat, instNormF, instCompF, instUltraF, ι_F, hDenseF, hMemF, hMaxF, ?_⟩
  intro K _ _ V₁ hV₁_ne
  let φ_KF : K →+* F_hat := ι_F.comp (algebraMap K F)
  let K_sub : Subfield F_hat := φ_KF.fieldRange
  let K_cl : Subfield F_hat := K_sub.topologicalClosure
  let K_hat : Type u := ↥K_cl
  have hex_K_not : ∃ a : K, a ∉ V₁ := by
    by_contra h
    push Not at h
    exact hV₁_ne (by ext a; simp [h a])
  obtain ⟨a_big, ha_big_not⟩ := hex_K_not
  have ha_big_norm : 1 < ‖φ_KF a_big‖ :=
    not_le.mp (mt (hMemF (algebraMap K F a_big)).mpr ha_big_not)
  let instNormK : NontriviallyNormedField K_hat :=
    { toNormedField := inferInstance
      non_trivial :=
        ⟨⟨φ_KF a_big, Subfield.le_topologicalClosure K_sub ⟨a_big, rfl⟩⟩, ha_big_norm⟩ }
  let _ : NontriviallyNormedField K_hat := instNormK
  have instCompK : CompleteSpace K_hat :=
    IsClosed.completeSpace_coe (hs := Subfield.isClosed_topologicalClosure K_sub)
  have instUltraK : IsUltrametricDist K_hat :=
    ⟨fun x y z => IsUltrametricDist.dist_triangle_max (x : F_hat) (y : F_hat) (z : F_hat)⟩
  let instAlgKF_hat : Algebra K_hat F_hat := K_cl.toAlgebra
  let _ : Algebra K_hat F_hat := instAlgKF_hat
  let ι_K : K →+* K_hat :=
    φ_KF.codRestrict K_cl (fun c => Subfield.le_topologicalClosure K_sub ⟨c, rfl⟩)
  have hDenseK : DenseRange ι_K := by
    rw [Metric.denseRange_iff]
    intro y ε hε
    have hy_cl : (y : F_hat) ∈ closure (K_sub : Set F_hat) := y.2
    obtain ⟨z, hz_mem, hz_dist⟩ := Metric.mem_closure_iff.mp hy_cl ε hε
    obtain ⟨c, rfl⟩ := hz_mem
    exact ⟨c, hz_dist⟩
  have hCompatK : ∀ c : K, algebraMap K_hat F_hat (ι_K c) = ι_F (algebraMap K F c) :=
    fun _ => rfl
  have hIsoK : ∀ c : K_hat, ‖algebraMap K_hat F_hat c‖ = ‖c‖ :=
    fun _ => rfl
  have hClEq : ∀ x : F,
      (IntermediateField.adjoin K_hat ({ι_F x} : Set F_hat)).toSubfield.topologicalClosure =
      (ι_F.comp (IntermediateField.adjoin K ({x} : Set F)).val.toRingHom).fieldRange.topologicalClosure := by
    intro x
    set M₁ : Subfield F_hat :=
      (IntermediateField.adjoin K_hat ({ι_F x} : Set F_hat)).toSubfield.topologicalClosure
    set M₂ : Subfield F_hat :=
      (ι_F.comp (IntermediateField.adjoin K ({x} : Set F)).val.toRingHom).fieldRange.topologicalClosure
    apply le_antisymm
    · refine Subfield.topologicalClosure_minimal _ ?_ (Subfield.isClosed_topologicalClosure _)
      have hKcl_le : K_cl ≤ M₂ := by
        refine Subfield.topologicalClosure_minimal _ ?_ (Subfield.isClosed_topologicalClosure _)
        rintro _ ⟨c, rfl⟩
        exact Subfield.le_topologicalClosure _
          ⟨⟨algebraMap K F c, IntermediateField.algebraMap_mem _ c⟩, rfl⟩
      let M₂_IF : IntermediateField K_hat F_hat :=
        { M₂ with algebraMap_mem' := fun c => hKcl_le c.2 }
      have h_adj : IntermediateField.adjoin K_hat ({ι_F x} : Set F_hat) ≤ M₂_IF := by
        rw [IntermediateField.adjoin_le_iff, Set.singleton_subset_iff]
        exact Subfield.le_topologicalClosure _
          ⟨⟨x, IntermediateField.mem_adjoin_simple_self K x⟩, rfl⟩
      exact h_adj
    · refine Subfield.topologicalClosure_minimal _ ?_ (Subfield.isClosed_topologicalClosure _)
      let N_IF : IntermediateField K F :=
        { M₁.comap ι_F with
          algebraMap_mem' := fun c => by
            change ι_F (algebraMap K F c) ∈ M₁
            rw [← hCompatK c]
            exact Subfield.le_topologicalClosure _ (IntermediateField.algebraMap_mem _ (ι_K c)) }
      have h_adj : IntermediateField.adjoin K ({x} : Set F) ≤ N_IF := by
        rw [IntermediateField.adjoin_le_iff, Set.singleton_subset_iff]
        change ι_F x ∈ M₁
        exact Subfield.le_topologicalClosure _ (IntermediateField.mem_adjoin_simple_self K_hat (ι_F x))
      rintro _ ⟨u, rfl⟩
      exact h_adj u.2
  refine ⟨K_hat, instNormK, instCompK, instUltraK, instAlgKF_hat, ι_K,
    hDenseK, hCompatK, hIsoK, hClEq, ?_⟩
  dsimp only
  set OF : ValuationSubring F_hat := (NormedField.valuation (K := F_hat)).valuationSubring
  set OK : ValuationSubring K_hat := OF.comap (algebraMap K_hat F_hat)
  set κF := IsLocalRing.ResidueField ↥OF
  set κ_hom : ↥OK →+* κF :=
    (IsLocalRing.residue ↥OF).comp
      (((algebraMap K_hat F_hat).comp OK.subtype).codRestrict OF.toSubring (fun c => c.2))
  have hOF_mem : ∀ u : F_hat, u ∈ OF ↔ ‖u‖ ≤ 1 := by
    intro u
    rw [Valuation.mem_valuationSubring_iff, NormedField.valuation_apply, ← NNReal.coe_le_one, coe_nnnorm]
  have hOF_max : ∀ (u : F_hat) (hu : u ∈ OF),
      (⟨u, hu⟩ : ↥OF) ∈ IsLocalRing.maximalIdeal ↥OF ↔ ‖u‖ < 1 := by
    intro u hu
    rw [Valuation.mem_maximalIdeal_iff, NormedField.valuation_apply, ← NNReal.coe_lt_one, coe_nnnorm]
  let ι_W₁ : ↥W₁ →+* ↥OF :=
    (ι_F.comp W₁.subtype).codRestrict OF.toSubring
      (fun w => (hOF_mem (ι_F w.1)).mpr ((hMemF w.1).mp w.2))
  have _ : IsLocalHom ι_W₁ := by
    refine ⟨fun w hw_unit => ?_⟩
    by_contra hw_not_unit
    have hw_max : w ∈ IsLocalRing.maximalIdeal ↥W₁ := by
      rwa [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    have hw_lt : ‖ι_F w.1‖ < 1 := (hMaxF w.1 w.2).mp hw_max
    have hιw_max : ι_W₁ w ∈ IsLocalRing.maximalIdeal ↥OF :=
      (hOF_max (ι_F w.1) (ι_W₁ w).2).mpr hw_lt
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hιw_max
    exact hιw_max hw_unit
  let ψ_F : IsLocalRing.ResidueField ↥W₁ →+* κF := IsLocalRing.ResidueField.map ι_W₁
  have hψ_F_surj : Function.Surjective ψ_F := by
    intro y_bar
    obtain ⟨u, rfl⟩ := IsLocalRing.residue_surjective (R := ↥OF) y_bar
    have hu_le : ‖u.1‖ ≤ 1 := (hOF_mem u.1).mp u.2
    obtain ⟨w, hw_dist⟩ := Metric.denseRange_iff.mp hDenseF u.1 1 zero_lt_one
    have hw_diff_lt : ‖ι_F w - u.1‖ < 1 := by
      rwa [dist_comm, dist_eq_norm] at hw_dist
    have hw_norm_le : ‖ι_F w‖ ≤ 1 := by
      have heq : ι_F w = (ι_F w - u.1) + u.1 := by ring
      rw [heq]
      exact (IsUltrametricDist.norm_add_le_max _ _).trans (max_le (le_of_lt hw_diff_lt) hu_le)
    have hw_W₁ : w ∈ W₁ := (hMemF w).mpr hw_norm_le
    let w₀ : ↥W₁ := ⟨w, hw_W₁⟩
    refine ⟨IsLocalRing.residue ↥W₁ w₀, ?_⟩
    rw [IsLocalRing.ResidueField.map_residue]
    rw [← sub_eq_zero, ← map_sub, IsLocalRing.residue_eq_zero_iff]
    exact (hOF_max (ι_F w - u.1) (ι_W₁ w₀ - u).2).mpr hw_diff_lt
  let e_F : IsLocalRing.ResidueField ↥W₁ ≃+* κF :=
    RingEquiv.ofBijective ψ_F ⟨ψ_F.injective, hψ_F_surj⟩
  intro φ_res hφ_compat x₀ hx₀ hx₀_hat
  let _ : Algebra (IsLocalRing.ResidueField ↥V₁) (IsLocalRing.ResidueField ↥W₁) := φ_res.toAlgebra
  set x_tilde : IsLocalRing.ResidueField ↥W₁ := IsLocalRing.residue ↥W₁ ⟨x₀, hx₀⟩
  set L_tilde := IntermediateField.adjoin (IsLocalRing.ResidueField ↥V₁) ({x_tilde} : Set _)
  set x_res : κF := IsLocalRing.residue ↥OF ⟨ι_F x₀, hx₀_hat⟩
  set K_res : Subfield κF := Subfield.closure (Set.range κ_hom)
  set Kx_res : Subfield κF := Subfield.closure (Set.range κ_hom ∪ {x_res})
  let _ : Algebra ↥K_res κF := K_res.toAlgebra
  let _ : Algebra ↥Kx_res κF := Kx_res.toAlgebra
  intro hTr_tilde hSep_tilde
  have he_F_x : e_F x_tilde = x_res := by
    change ψ_F (IsLocalRing.residue ↥W₁ ⟨x₀, hx₀⟩) = IsLocalRing.residue ↥OF ⟨ι_F x₀, hx₀_hat⟩
    rw [IsLocalRing.ResidueField.map_residue]
    congr 1
  let θ_K : IsLocalRing.ResidueField ↥V₁ →+* κF := e_F.toRingHom.comp φ_res
  have hRange_eq : Set.range κ_hom = Set.range θ_K := by
    ext z
    constructor
    · rintro ⟨c_OK, rfl⟩
      have hc_le : ‖c_OK.1‖ ≤ 1 := by
        rw [← hIsoK c_OK.1]
        exact (hOF_mem _).mp c_OK.2
      obtain ⟨v, hv_dist⟩ := Metric.denseRange_iff.mp hDenseK c_OK.1 1 zero_lt_one
      have hv_diff_lt : ‖ι_K v - c_OK.1‖ < 1 := by
        rwa [dist_comm, dist_eq_norm] at hv_dist
      have hv_norm_le : ‖ι_K v‖ ≤ 1 := by
        have heq : ι_K v = (ι_K v - c_OK.1) + c_OK.1 := by ring
        rw [heq]
        exact (IsUltrametricDist.norm_add_le_max _ _).trans (max_le (le_of_lt hv_diff_lt) hc_le)
      have hvF_W₁ : algebraMap K F v ∈ W₁ := by
        rw [hMemF, ← hCompatK v, hIsoK]
        exact hv_norm_le
      have hv_V₁ : v ∈ V₁ := hvF_W₁
      refine ⟨IsLocalRing.residue ↥V₁ ⟨v, hv_V₁⟩, ?_⟩
      change e_F (φ_res (IsLocalRing.residue ↥V₁ ⟨v, hv_V₁⟩)) = κ_hom c_OK
      rw [hφ_compat v hv_V₁ hvF_W₁]
      change ψ_F (IsLocalRing.residue ↥W₁ ⟨algebraMap K F v, hvF_W₁⟩) =
        IsLocalRing.residue ↥OF ⟨algebraMap K_hat F_hat c_OK.1, c_OK.2⟩
      rw [IsLocalRing.ResidueField.map_residue]
      rw [← sub_eq_zero, ← map_sub, IsLocalRing.residue_eq_zero_iff]
      rw [hOF_max]
      change ‖ι_F (algebraMap K F v) - algebraMap K_hat F_hat c_OK.1‖ < 1
      rw [← hCompatK v, ← map_sub, hIsoK]
      exact hv_diff_lt
    · rintro ⟨v_bar, rfl⟩
      obtain ⟨⟨v, hv_V₁⟩, rfl⟩ := IsLocalRing.residue_surjective (R := ↥V₁) v_bar
      have hvF_W₁ : algebraMap K F v ∈ W₁ := hv_V₁
      have hv_OK : ι_K v ∈ OK := by
        change algebraMap K_hat F_hat (ι_K v) ∈ OF
        rw [hCompatK v, hOF_mem]
        exact (hMemF _).mp hvF_W₁
      refine ⟨⟨ι_K v, hv_OK⟩, ?_⟩
      change IsLocalRing.residue ↥OF ⟨algebraMap K_hat F_hat (ι_K v), hv_OK⟩ =
        e_F (φ_res (IsLocalRing.residue ↥V₁ ⟨v, hv_V₁⟩))
      rw [hφ_compat v hv_V₁ hvF_W₁]
      change IsLocalRing.residue ↥OF ⟨algebraMap K_hat F_hat (ι_K v), hv_OK⟩ =
        ψ_F (IsLocalRing.residue ↥W₁ ⟨algebraMap K F v, hvF_W₁⟩)
      rw [IsLocalRing.ResidueField.map_residue]
      congr 1
  have hK_res_eq : K_res = θ_K.fieldRange := by
    change Subfield.closure (Set.range κ_hom) = θ_K.fieldRange
    rw [hRange_eq]
    exact Subfield.closure_eq θ_K.fieldRange
  let ψ_K : IsLocalRing.ResidueField ↥V₁ →+* ↥K_res :=
    θ_K.codRestrict K_res (fun r => by rw [hK_res_eq]; exact ⟨r, rfl⟩)
  have hψ_K_surj : Function.Surjective ψ_K := by
    intro y
    have hy : y.1 ∈ θ_K.fieldRange := hK_res_eq ▸ y.2
    obtain ⟨r, hr⟩ := hy
    exact ⟨r, Subtype.ext hr⟩
  let e_K : IsLocalRing.ResidueField ↥V₁ ≃+* ↥K_res :=
    RingEquiv.ofBijective ψ_K ⟨ψ_K.injective, hψ_K_surj⟩
  let θ_L : ↥L_tilde →+* κF := e_F.toRingHom.comp L_tilde.val.toRingHom
  have hKx_res_eq : Kx_res = θ_L.fieldRange := by
    apply le_antisymm
    · rw [Subfield.closure_le]
      rintro z (hz_K | rfl)
      · rw [hRange_eq] at hz_K
        obtain ⟨r, rfl⟩ := hz_K
        exact ⟨⟨φ_res r, IntermediateField.algebraMap_mem L_tilde r⟩, rfl⟩
      · rw [← he_F_x]
        exact ⟨⟨x_tilde, IntermediateField.mem_adjoin_simple_self _ x_tilde⟩, rfl⟩
    · let M_tilde : IntermediateField (IsLocalRing.ResidueField ↥V₁) (IsLocalRing.ResidueField ↥W₁) :=
        { Kx_res.comap e_F.toRingHom with
          algebraMap_mem' := fun r => by
            change θ_K r ∈ Kx_res
            apply Subfield.subset_closure
            left
            rw [hRange_eq]
            exact ⟨r, rfl⟩ }
      have hL_le : L_tilde ≤ M_tilde := by
        rw [IntermediateField.adjoin_le_iff, Set.singleton_subset_iff]
        change e_F x_tilde ∈ Kx_res
        rw [he_F_x]
        exact Subfield.subset_closure (Or.inr rfl)
      rintro _ ⟨u, rfl⟩
      exact hL_le u.2
  let ψ_Kx : ↥L_tilde →+* ↥Kx_res :=
    θ_L.codRestrict Kx_res (fun u => by rw [hKx_res_eq]; exact ⟨u, rfl⟩)
  have hψ_Kx_surj : Function.Surjective ψ_Kx := by
    intro y
    have hy : y.1 ∈ θ_L.fieldRange := hKx_res_eq ▸ y.2
    obtain ⟨u, hu⟩ := hy
    exact ⟨u, Subtype.ext hu⟩
  let e_Kx : ↥L_tilde ≃+* ↥Kx_res :=
    RingEquiv.ofBijective ψ_Kx ⟨ψ_Kx.injective, hψ_Kx_surj⟩
  refine ⟨?_, ?_⟩
  · intro hAlg
    obtain ⟨P, hP_ne, hP_eval⟩ := hAlg
    let P₀ : Polynomial (IsLocalRing.ResidueField ↥V₁) := P.map e_K.symm.toRingHom
    have hP₀_ne : P₀ ≠ 0 := Polynomial.map_ne_zero hP_ne
    apply hTr_tilde ⟨P₀, hP₀_ne, ?_⟩
    apply e_F.injective
    rw [map_zero, Polynomial.aeval_def, Polynomial.eval₂_map]
    change e_F.toRingHom (Polynomial.eval₂ (φ_res.comp e_K.symm.toRingHom) x_tilde P) = 0
    rw [Polynomial.hom_eval₂]
    have hcomp_eq : e_F.toRingHom.comp (φ_res.comp e_K.symm.toRingHom) = algebraMap ↥K_res κF := by
      ext c
      change (e_K (e_K.symm c) : κF) = (c : κF)
      rw [e_K.apply_symm_apply]
    rw [hcomp_eq]
    change Polynomial.eval₂ (algebraMap ↥K_res κF) (e_F x_tilde) P = 0
    rw [he_F_x, ← Polynomial.aeval_def]
    exact hP_eval
  · have _ : Algebra.IsSeparable ↥L_tilde (IsLocalRing.ResidueField ↥W₁) := hSep_tilde
    exact Algebra.IsSeparable.of_equiv_equiv e_Kx e_F (by ext u; rfl)

theorem weil_separating_derivation_and_algClosed_dvr : (∀ (K F : Type u) [Field K] [IsSepClosed K] [Field F] [Algebra K F] (x_sep : F),
      Transcendental K x_sep →
      (let L0 := IntermediateField.adjoin K ({x_sep} : Set F)
       FiniteDimensional ↥L0 F ∧ Algebra.IsSeparable ↥L0 F) →
      ∃ (D : F →ₗ[K] F),
        D 1 = 0 ∧ D x_sep = 1 ∧
        ∀ x₀ : F, D x₀ ≠ 0 →
          Transcendental K x₀ ∧
          let Lx₀ := IntermediateField.adjoin K ({x₀} : Set F)
          FiniteDimensional ↥Lx₀ F ∧ Algebra.IsSeparable ↥Lx₀ F) ∧
    (∀ (E L : Type u) [Field E] [IsAlgClosed E] [Field L] [Algebra E L] (z₀ : L),
      Transcendental E z₀ →
      FiniteDimensional ↥(IntermediateField.adjoin E ({z₀} : Set L)) L →
      ∃ (z_sep : L),
        Transcendental E z_sep ∧
        let L0 := IntermediateField.adjoin E ({z_sep} : Set L)
        FiniteDimensional ↥L0 L ∧ Algebra.IsSeparable ↥L0 L) ∧
    (∀ (E L : Type u) [Field E] [IsAlgClosed E] [Field L] [Algebra E L],
      (∃ (z_sep : L), Transcendental E z_sep ∧
        let L0 := IntermediateField.adjoin E ({z_sep} : Set L)
        FiniteDimensional ↥L0 L ∧ Algebra.IsSeparable ↥L0 L) →
      ∀ (O : ValuationSubring L), O ≠ ⊤ → (∀ a : E, algebraMap E L a ∈ O) →
        ∃ (π : L) (hπ : π ∈ O),
          ⟨π, hπ⟩ ∈ IsLocalRing.maximalIdeal ↥O ∧
          π ≠ 0 ∧
          (∀ P : Ideal ↥O, P.IsPrime → P = ⊥ ∨ P = IsLocalRing.maximalIdeal ↥O) ∧
          IsLocalRing.maximalIdeal ↥O = Ideal.span ({⟨π, hπ⟩} : Set ↥O) ∧
          (∀ w : L, w ∈ O → ∃ c : E, w - algebraMap E L c = 0 ∨ (w - algebraMap E L c)⁻¹ ∉ O) ∧
          Transcendental E π ∧
          let Lπ := IntermediateField.adjoin E ({π} : Set L)
          FiniteDimensional ↥Lπ L ∧ Algebra.IsSeparable ↥Lπ L) :=
by
  have hRatFunc : ∀ (K F : Type u) [Field K] [Field F] [Algebra K F]
      (x : F), Transcendental K x →
      let L0 := IntermediateField.adjoin K ({x} : Set F)
      let x0 : ↥L0 := ⟨x, IntermediateField.mem_adjoin_simple_self K x⟩
      let φ0 : Polynomial K →+* ↥L0 := (Polynomial.aeval x0).toRingHom
      letI : Algebra (Polynomial K) ↥L0 := φ0.toAlgebra
      Transcendental K x0 ∧
      (∀ z : ↥L0, ∃ P Q : Polynomial K, Q ≠ 0 ∧ z * Polynomial.aeval x0 Q = Polynomial.aeval x0 P) ∧
      IsScalarTower K (Polynomial K) ↥L0 ∧
      IsFractionRing (Polynomial K) ↥L0 := by
    intro K F _ _ _ x hTr L0 x0 φ0
    letI : Algebra (Polynomial K) ↥L0 := φ0.toAlgebra
    have hTr0 : Transcendental K x0 := by
      rintro ⟨P, hP_ne, hP0⟩
      refine hTr ⟨P, hP_ne, ?_⟩
      have h1 : L0.val (Polynomial.aeval x0 P) = L0.val 0 := congrArg L0.val hP0
      rw [← Polynomial.aeval_algHom_apply, map_zero] at h1
      exact h1
    have hInjF : Function.Injective (Polynomial.aeval x : Polynomial K →ₐ[K] F) :=
      transcendental_iff_injective.mp hTr
    have hInj0 : Function.Injective (Polynomial.aeval x0 : Polynomial K →ₐ[K] ↥L0) :=
      transcendental_iff_injective.mp hTr0
    have hEvalNe : ∀ {Q : Polynomial K}, Q ≠ 0 → Polynomial.aeval x Q ≠ 0 :=
      fun hQ h0 => hQ (hInjF (by simpa using h0))
    let M_rat : IntermediateField K F :=
      { carrier := { w : F | ∃ P Q : Polynomial K, Q ≠ 0 ∧ w = Polynomial.aeval x P / Polynomial.aeval x Q }
        add_mem' := by
          rintro _ _ ⟨P₁, Q₁, hQ₁, rfl⟩ ⟨P₂, Q₂, hQ₂, rfl⟩
          refine ⟨P₁ * Q₂ + P₂ * Q₁, Q₁ * Q₂, mul_ne_zero hQ₁ hQ₂, ?_⟩
          rw [div_add_div _ _ (hEvalNe hQ₁) (hEvalNe hQ₂), map_add, map_mul, map_mul, map_mul]
          ring
        zero_mem' := ⟨0, 1, one_ne_zero, by simp⟩
        mul_mem' := by
          rintro _ _ ⟨P₁, Q₁, hQ₁, rfl⟩ ⟨P₂, Q₂, hQ₂, rfl⟩
          exact ⟨P₁ * P₂, Q₁ * Q₂, mul_ne_zero hQ₁ hQ₂, by rw [map_mul, map_mul, div_mul_div_comm]⟩
        one_mem' := ⟨1, 1, one_ne_zero, by simp⟩
        inv_mem' := by
          rintro _ ⟨P, Q, hQ, rfl⟩
          by_cases hP : P = 0
          · subst hP; exact ⟨0, 1, one_ne_zero, by simp⟩
          · exact ⟨Q, P, hP, inv_div _ _⟩
        algebraMap_mem' := fun c => ⟨Polynomial.C c, 1, one_ne_zero, by simp⟩ }
    have hLE : L0 ≤ M_rat := by
      rw [IntermediateField.adjoin_le_iff, Set.singleton_subset_iff]
      exact ⟨Polynomial.X, 1, one_ne_zero, by simp⟩
    have hRat : ∀ z : ↥L0, ∃ P Q : Polynomial K, Q ≠ 0 ∧ z * Polynomial.aeval x0 Q = Polynomial.aeval x0 P := by
      intro z
      obtain ⟨P, Q, hQ, hz⟩ := hLE z.2
      refine ⟨P, Q, hQ, L0.val.injective ?_⟩
      change L0.val (z * Polynomial.aeval x0 Q) = L0.val (Polynomial.aeval x0 P)
      rw [map_mul, ← Polynomial.aeval_algHom_apply, ← Polynomial.aeval_algHom_apply]
      change (z : F) * Polynomial.aeval x Q = Polynomial.aeval x P
      rw [hz, div_mul_cancel₀ _ (hEvalNe hQ)]
    have hTower : IsScalarTower K (Polynomial K) ↥L0 :=
      IsScalarTower.of_algebraMap_eq fun c => by
        symm
        change φ0 (Polynomial.C c) = algebraMap K ↥L0 c
        simp [φ0]
    have hFrac : IsFractionRing (Polynomial K) ↥L0 :=
      { map_units := fun y =>
          IsUnit.mk0 _ (fun h0 => by
            change Polynomial.aeval x0 y.1 = 0 at h0
            exact mem_nonZeroDivisors_iff_ne_zero.mp y.2 (hInj0 (by simpa using h0)))
        surj := fun z =>
          let ⟨P, Q, hQ, hz⟩ := hRat z
          ⟨(P, ⟨Q, mem_nonZeroDivisors_iff_ne_zero.mpr hQ⟩), hz⟩
        exists_of_eq := fun {P₁ P₂} h => ⟨1, by simpa using hInj0 h⟩ }
    exact ⟨hTr0, hRat, hTower, hFrac⟩
  have hPillar1 : ∀ (K F : Type u) [Field K] [IsSepClosed K] [Field F] [Algebra K F]
      (x_sep : F), Transcendental K x_sep →
      (let L0 := IntermediateField.adjoin K ({x_sep} : Set F)
       FiniteDimensional ↥L0 F ∧ Algebra.IsSeparable ↥L0 F) →
      ∀ x₀ : F, x₀ ∉ Set.range (algebraMap K F) →
        Transcendental K x₀ ∧
        FiniteDimensional ↥(IntermediateField.adjoin K ({x₀} : Set F)) F := by
    intro K F _ _ _ _ x_sep hTr ⟨hFin, hSep⟩
    let L0 := IntermediateField.adjoin K ({x_sep} : Set F)
    let x_s0 : ↥L0 := ⟨x_sep, IntermediateField.mem_adjoin_simple_self K x_sep⟩
    let φ0 : Polynomial K →+* ↥L0 := (Polynomial.aeval x_s0).toRingHom
    letI : Algebra (Polynomial K) ↥L0 := φ0.toAlgebra
    obtain ⟨hTr0, hRat, hTower, hFrac⟩ := hRatFunc K F x_sep hTr
    haveI : IsScalarTower K (Polynomial K) ↥L0 := hTower
    haveI : IsFractionRing (Polynomial K) ↥L0 := hFrac
    have hInj0 : Function.Injective (Polynomial.aeval x_s0 : Polynomial K →ₐ[K] ↥L0) :=
      transcendental_iff_injective.mp hTr0
    intro x₀ hx₀_not
    have hTr_x₀ : Transcendental K x₀ := by
      intro hAlg
      have hInt : IsIntegral K x₀ := hAlg.isIntegral
      let g : Polynomial K := minpoly K x₀
      have hg_monic : g.Monic := minpoly.monic hInt
      have hg_irr : Irreducible g := minpoly.irreducible hInt
      let g₁ : Polynomial (Polynomial K) := g.map Polynomial.C
      have hg₁_monic : g₁.Monic := hg_monic.map Polynomial.C
      have hg₁_map : g₁.map (Polynomial.evalRingHom (0 : K)) = g := by
        rw [Polynomial.map_map]
        convert Polynomial.map_id
        ext c
        simp
      have hg₁_irr : Irreducible g₁ :=
        Polynomial.Monic.irreducible_of_irreducible_map (Polynomial.evalRingHom (0 : K)) g₁ hg₁_monic
          (by rwa [hg₁_map])
      have hg_L0_eq : g₁.map (algebraMap (Polynomial K) ↥L0) = g.map (algebraMap K ↥L0) := by
        rw [Polynomial.map_map]
        congr 1
        refine RingHom.ext fun c => ?_
        change φ0 (Polynomial.C c) = algebraMap K ↥L0 c
        simp [φ0]
      have hg_L0_irr : Irreducible (g.map (algebraMap K ↥L0)) := by
        rw [← hg_L0_eq]
        exact (hg₁_monic.irreducible_iff_irreducible_map_fraction_map (K := ↥L0)).mp hg₁_irr
      have hg_L0_aeval : Polynomial.aeval x₀ (g.map (algebraMap K ↥L0)) = 0 := by
        rw [Polynomial.aeval_def, Polynomial.eval₂_map, ← IsScalarTower.algebraMap_eq K ↥L0 F,
          ← Polynomial.aeval_def]
        exact minpoly.aeval K x₀
      have hmin_eq : minpoly ↥L0 x₀ = g.map (algebraMap K ↥L0) :=
        (minpoly.eq_of_irreducible_of_monic hg_L0_irr hg_L0_aeval (hg_monic.map _)).symm
      have hg_sep_L0 : (g.map (algebraMap K ↥L0)).Separable := by
        rw [← hmin_eq]
        exact Algebra.IsSeparable.isSeparable ↥L0 x₀
      have hg_sep : g.Separable := (Polynomial.separable_map (algebraMap K ↥L0)).mp hg_sep_L0
      have hg_deg : g.degree = 1 := IsSepClosed.degree_eq_one_of_irreducible K hg_irr hg_sep
      have hg_form : g = Polynomial.X + Polynomial.C (g.coeff 0) := by
        have h1 := Polynomial.eq_X_add_C_of_degree_eq_one hg_deg
        rw [hg_monic.leadingCoeff, map_one, one_mul] at h1
        exact h1
      have hEval : Polynomial.aeval x₀ g = 0 := minpoly.aeval K x₀
      rw [hg_form, map_add, Polynomial.aeval_X, Polynomial.aeval_C] at hEval
      exact hx₀_not ⟨-g.coeff 0, by rw [map_neg]; linear_combination -hEval⟩
    refine ⟨hTr_x₀, ?_⟩
    let Lx₀ := IntermediateField.adjoin K ({x₀} : Set F)
    let x0_L : ↥Lx₀ := ⟨x₀, IntermediateField.mem_adjoin_simple_self K x₀⟩
    have hTr_x0L : Transcendental K x0_L := (hRatFunc K F x₀ hTr_x₀).1
    have hInj_x0L : Function.Injective (Polynomial.aeval x0_L : Polynomial K →ₐ[K] ↥Lx₀) :=
      transcendental_iff_injective.mp hTr_x0L
    have hInt_L0 : IsIntegral ↥L0 x₀ := Algebra.IsIntegral.isIntegral x₀
    let M : Polynomial ↥L0 := minpoly ↥L0 x₀
    let d : ℕ := M.natDegree
    have hM_monic : M.Monic := minpoly.monic hInt_L0
    let A : ℕ → Polynomial K := fun j => Classical.choose (hRat (M.coeff j))
    let B : ℕ → Polynomial K := fun j => Classical.choose (Classical.choose_spec (hRat (M.coeff j)))
    have hB_spec : ∀ j : ℕ, B j ≠ 0 ∧ M.coeff j * Polynomial.aeval x_s0 (B j) = Polynomial.aeval x_s0 (A j) :=
      fun j => Classical.choose_spec (Classical.choose_spec (hRat (M.coeff j)))
    let B_tot : Polynomial K := ∏ i ∈ Finset.range (d + 1), B i
    have hBtot_ne : B_tot ≠ 0 := Finset.prod_ne_zero_iff.mpr fun i _ => (hB_spec i).1
    let P : ℕ → Polynomial K := fun j => A j * ∏ i ∈ (Finset.range (d + 1)).erase j, B i
    have hP_eval : ∀ j ∈ Finset.range (d + 1),
        Polynomial.aeval x_sep (P j) = Polynomial.aeval x_sep B_tot * (M.coeff j : F) := by
      intro j hj
      have hB_split : B_tot = B j * ∏ i ∈ (Finset.range (d + 1)).erase j, B i :=
        (Finset.mul_prod_erase (Finset.range (d + 1)) B hj).symm
      have hAB_F : (M.coeff j : F) * Polynomial.aeval x_sep (B j) = Polynomial.aeval x_sep (A j) := by
        have h1 : L0.val (M.coeff j * Polynomial.aeval x_s0 (B j)) = L0.val (Polynomial.aeval x_s0 (A j)) :=
          congrArg L0.val (hB_spec j).2
        rw [map_mul, ← Polynomial.aeval_algHom_apply, ← Polynomial.aeval_algHom_apply] at h1
        exact h1
      calc Polynomial.aeval x_sep (P j)
          = Polynomial.aeval x_sep (A j) * Polynomial.aeval x_sep (∏ i ∈ (Finset.range (d + 1)).erase j, B i) :=
            map_mul _ _ _
        _ = ((M.coeff j : F) * Polynomial.aeval x_sep (B j)) *
            Polynomial.aeval x_sep (∏ i ∈ (Finset.range (d + 1)).erase j, B i) := by rw [← hAB_F]
        _ = (Polynomial.aeval x_sep (B j) * Polynomial.aeval x_sep (∏ i ∈ (Finset.range (d + 1)).erase j, B i)) *
            (M.coeff j : F) := by ring
        _ = Polynomial.aeval x_sep B_tot * (M.coeff j : F) := by rw [hB_split, map_mul]
    have hPd_eq : P d = B_tot := by
      have hMd : M.coeff d = 1 := hM_monic.leadingCoeff
      have hAB_d := (hB_spec d).2
      rw [hMd, one_mul] at hAB_d
      have hAd_Bd : A d = B d := hInj0 hAB_d.symm
      change A d * ∏ i ∈ (Finset.range (d + 1)).erase d, B i = B_tot
      rw [hAd_Bd]
      exact Finset.mul_prod_erase (Finset.range (d + 1)) B (Finset.mem_range.mpr (Nat.lt_succ_self d))
    have hPd_ne : P d ≠ 0 := hPd_eq.symm ▸ hBtot_ne
    obtain ⟨i_star, hi_star⟩ : ∃ i : ℕ, (P d).coeff i ≠ 0 := by
      by_contra hAll
      push Not at hAll
      exact hPd_ne (Polynomial.ext fun i => by simp [hAll i])
    let Ψ : Polynomial ↥Lx₀ :=
      ∑ j ∈ Finset.range (d + 1), (P j).map (algebraMap K ↥Lx₀) * Polynomial.C (x0_L ^ j)
    have hΨ_ne : Ψ ≠ 0 := by
      intro hΨ0
      have hCoeff0 : Ψ.coeff i_star = 0 := by rw [hΨ0, Polynomial.coeff_zero]
      let Q : Polynomial K :=
        ∑ j ∈ Finset.range (d + 1), Polynomial.C ((P j).coeff i_star) * Polynomial.X ^ j
      have hQ_eval : Polynomial.aeval x0_L Q = Ψ.coeff i_star := by
        simp only [Q, Ψ, map_sum, map_mul, Polynomial.aeval_C, map_pow, Polynomial.aeval_X,
          Polynomial.finsetSum_coeff]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [← Polynomial.C.map_pow, Polynomial.coeff_mul_C, Polynomial.coeff_map]
      have hQ_ne : Q ≠ 0 := by
        intro hQ0
        have hQc : Q.coeff d = 0 := by rw [hQ0, Polynomial.coeff_zero]
        simp only [Q, Polynomial.finsetSum_coeff, Polynomial.coeff_C_mul, Polynomial.coeff_X_pow,
