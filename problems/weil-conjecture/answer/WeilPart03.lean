    let Lp : Submodule E L :=
      { carrier := { x : L | ∃ z : L, z ^ p = x }
        zero_mem' := ⟨0, zero_pow hp.ne_zero⟩
        add_mem' := by
          rintro _ _ ⟨z₁, rfl⟩ ⟨z₂, rfl⟩
