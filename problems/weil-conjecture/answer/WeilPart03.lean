    have _ : Nontrivial ↥OL :=
      ⟨⟨0, 1, fun h => zero_ne_one (congrArg (fun x : ↥OL => ((x : ↥OL) : F_hat)) h)⟩⟩
    have hg_coeff_n : g.coeff n = 1 := by
      dsimp only [g]
      rw [Polynomial.coeff_add, Polynomial.coeff_X_pow_self, hsum_coeff n]
      simp
    have hg_coeff_gt : ∀ k : ℕ, n < k → g.coeff k = 0 := by
      intro k hk
      dsimp only [g]
      rw [Polynomial.coeff_add, Polynomial.coeff_X_pow, hsum_coeff k]
      have hne : k ≠ n := by omega
      have hnot : ¬ k < n := by omega
      simp [hne, hnot]
    have hg_coeff_lt : ∀ k : ℕ, k < n → g.coeff k = a_coeff k := by
