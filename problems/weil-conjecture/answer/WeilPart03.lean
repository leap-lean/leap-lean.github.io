                Polynomial.aeval T₁ (Multiset.map (fun a : K_hat => Polynomial.X - Polynomial.C a) M).prod =
                  (M.map (fun a : K_hat => T₁ - algebraMap K_hat L₁ a)).prod := by
              intro M
              induction M using Multiset.induction_on with
              | empty => simp
              | @cons a t ih =>
                simp only [Multiset.map_cons, Multiset.prod_cons, map_mul, map_sub,
