        constructor
        · rintro ⟨none | ⟨n, u⟩, rfl⟩
          · exact ⟨1, Or.inl rfl, rfl⟩
          · exact ⟨(u : ↥L1_coeff) ^ (p ^ n), Or.inr ⟨n, u.1, u.2, rfl⟩, rfl⟩
        · rintro ⟨y, rfl | ⟨n, u₀, hu₀, rfl⟩, rfl⟩
          · exact ⟨none, rfl⟩
          · exact ⟨some (n, ⟨u₀, hu₀⟩), rfl⟩
      let V_B : Submodule K_hat L₁ := Submodule.span K_hat S_pow
      have hL1_coeff_in_VB : (L1_coeff : Set L₁) ⊆ (V_B : Set L₁) := by
        intro x hx
        have hx_B0 : (⟨x, hx⟩ : ↥L1_coeff) ∈ Submodule.span ↥E_max B₀ := by
          rw [hSpan_U₀]; trivial
        have hmap : ∀ y ∈ Submodule.span ↥E_max B₀, (y : L₁) ∈ V_B := by
          intro y hy
