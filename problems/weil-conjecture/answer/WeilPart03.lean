            have hHc1 : H.coeff 1 = b_bar - c.coeff 1 := by
              dsimp [H]
              rw [Polynomial.coeff_sub, Polynomial.coeff_add, (hPolyPowCoeff c).2 1 hp.not_dvd_one,
