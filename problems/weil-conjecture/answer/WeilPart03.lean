      exact ⟨hFinBM, hRankBM⟩
    exact hNoDegP F_hat hIsoK p hp hp0 K_base M₂ hLE ⟨hRangeBase, hClBase, hDisjMod⟩
      hClM₂ hFinDegM₂ (fun w _ hne => hVal w hne) (fun w _ hle => hRes w hle)
  · rw [one_pow, pow_one] at hn_base
    exact hy_not hn_base

theorem weil_analytic_types23_ext_uniformization (K_hat F_hat : Type u)
    [NontriviallyNormedField K_hat] [CompleteSpace K_hat]
    [IsUltrametricDist K_hat] [IsAlgClosed K_hat]
    [NontriviallyNormedField F_hat] [CompleteSpace F_hat]
    [IsUltrametricDist F_hat] [Algebra K_hat F_hat]
    (hEquiChar : ∀ p : ℕ, p.Prime → (p : K_hat) = 0 ∨ ‖(p : K_hat)‖ = 1)
    (hIsoK : ∀ c : K_hat, ‖algebraMap K_hat F_hat c‖ = ‖c‖)
    (hCritPerturb : ∀ (E_hat : Type u)
      [NontriviallyNormedField E_hat] [CompleteSpace E_hat]
      [IsUltrametricDist E_hat] [Algebra K_hat E_hat],
      (∀ c : K_hat, ‖algebraMap K_hat E_hat c‖ = ‖c‖) →
      HasWeilImmediateCosetAndPerturb K_hat E_hat)
    (y₀ : F_hat)
    (hy₀_not : y₀ ∉ Set.range (algebraMap K_hat F_hat))
    (hy₀_fin :
      let Ly₀ : Subfield F_hat :=
        (IntermediateField.adjoin K_hat ({y₀} : Set F_hat)).toSubfield.topologicalClosure
      letI : Algebra ↥Ly₀ F_hat := Ly₀.toAlgebra
      FiniteDimensional ↥Ly₀ F_hat) :
    (((∃ w : F_hat, ‖w‖ ≤ 1 ∧ ∀ c : K_hat, 1 ≤ ‖w - algebraMap K_hat F_hat c‖) ∨
      (∃ w : F_hat, w ≠ 0 ∧ ∀ c : K_hat, ‖w‖ ≠ ‖c‖)) →
      ∃ (x₀ : F_hat) (ε : ℝ), 0 < ε ∧
        ∀ x' : F_hat, ‖x' - x₀‖ < ε → IsWeilAnalyticUnramifiedGen K_hat F_hat x') ∧
    (let OF : ValuationSubring F_hat := (NormedField.valuation (K := F_hat)).valuationSubring
     let OK : ValuationSubring K_hat := OF.comap (algebraMap K_hat F_hat)
     let κF := IsLocalRing.ResidueField ↥OF
     let κ_hom : ↥OK →+* κF :=
       (IsLocalRing.residue ↥OF).comp
         (((algebraMap K_hat F_hat).comp OK.subtype).codRestrict OF.toSubring (fun c => c.2))
     ∀ (x : F_hat) (hx : x ∈ OF),
       let x_res : κF := IsLocalRing.residue ↥OF ⟨x, hx⟩
       let K_res : Subfield κF := Subfield.closure (Set.range κ_hom)
       let Kx_res : Subfield κF := Subfield.closure (Set.range κ_hom ∪ {x_res})
       letI : Algebra ↥K_res κF := K_res.toAlgebra
       letI : Algebra ↥Kx_res κF := Kx_res.toAlgebra
       Transcendental ↥K_res x_res →
       Algebra.IsSeparable ↥Kx_res κF →
       IsWeilAnalyticUnramifiedGen K_hat F_hat x) :=
by
  obtain ⟨hSepGen, hPolePBasis⟩ := weil_algClosed_functionField_pole_pBasis_and_sepGen.{u}
  obtain ⟨E_max, hE_norm, hE_alg, hE_res, hKres_alg, hKres_eq, hT2_setup⟩ :=
    weil_equichar_coeffField_and_type2_unramified_setup K_hat F_hat hEquiChar hIsoK
  let OF : ValuationSubring F_hat := (NormedField.valuation (K := F_hat)).valuationSubring
  let OK : ValuationSubring K_hat := OF.comap (algebraMap K_hat F_hat)
  let κF := IsLocalRing.ResidueField ↥OF
  let κ_hom : ↥OK →+* κF :=
    (IsLocalRing.residue ↥OF).comp
      (((algebraMap K_hat F_hat).comp OK.subtype).codRestrict OF.toSubring (fun c => c.2))
  let K_res : Subfield κF := Subfield.closure (Set.range κ_hom)
  letI : Algebra ↥K_res κF := K_res.toAlgebra
  letI : IsAlgClosed ↥E_max := hE_alg
  letI : IsAlgClosed ↥K_res := hKres_alg
  have hMemOF : ∀ z : F_hat, z ∈ OF ↔ ‖z‖ ≤ 1 := by
    intro z
    rw [Valuation.mem_valuationSubring_iff, NormedField.valuation_apply,
      ← NNReal.coe_le_coe, NNReal.coe_one, coe_nnnorm]
  have hNoDegP : ∀ (E_hat : Type u)
      [NontriviallyNormedField E_hat] [CompleteSpace E_hat]
      [IsUltrametricDist E_hat] [Algebra K_hat E_hat],
      (∀ c : K_hat, ‖algebraMap K_hat E_hat c‖ = ‖c‖) →
      ∀ (p : ℕ), p.Prime → (p : K_hat) = 0 →
      ∀ (L M₂ : Subfield E_hat) (hLE : L ≤ M₂),
        IsWeilType23ModRamified K_hat E_hat E_max L →
        IsClosed (M₂ : Set E_hat) →
        (letI : Algebra ↥L ↥M₂ := (Subfield.inclusion hLE).toAlgebra
         FiniteDimensional ↥L ↥M₂ ∧ Module.finrank ↥L ↥M₂ = p) →
        (∀ w ∈ M₂, w ≠ 0 → ∃ u ∈ L, ‖w‖ = ‖u‖) →
        (∀ w ∈ M₂, ‖w‖ ≤ 1 → ∃ u ∈ L, ‖u‖ ≤ 1 ∧ ‖w - u‖ < 1) →
        False := by
    intro E_hat _ _ _ _ hIsoE p hp hp0 L M₂ hLE hMod hClM₂ hFinM₂ hValM₂ hResM₂
    have hp0_E : (p : ↥E_max) = 0 := by
      apply Subtype.ext
      simpa using hp0
    exact weil_types23_no_immediate_deg_p_extension K_hat E_hat E_max hEquiChar hIsoE
      (hCritPerturb E_hat hIsoE) hE_norm hE_alg hE_res p hp hp0
      (fun L_alg _ _ T hTrans hFinSep =>
        @hPolePBasis ↥E_max L_alg _ hE_alg _ _ p hp hp0_E T hTrans hFinSep)
      L M₂ hLE hMod hClM₂ hFinM₂ hValM₂ hResM₂
  have hNotRange_of_trans : ∀ (z : F_hat) (hz : z ∈ OF),
      Transcendental ↥K_res (IsLocalRing.residue ↥OF ⟨z, hz⟩) →
      z ∉ Set.range (algebraMap K_hat F_hat) := by
    intro z hz hTr ⟨c, hc⟩
    have hc_OK : c ∈ OK := by
      change algebraMap K_hat F_hat c ∈ OF
      rw [hc]
      exact hz
    have h_eq : κ_hom ⟨c, hc_OK⟩ = IsLocalRing.residue ↥OF ⟨z, hz⟩ := by
      dsimp [κ_hom]
      congr 1
      exact Subtype.ext hc
    have hz_mem : IsLocalRing.residue ↥OF ⟨z, hz⟩ ∈ K_res :=
      Subfield.subset_closure ⟨⟨c, hc_OK⟩, h_eq⟩
    let c₀ : ↥K_res := ⟨IsLocalRing.residue ↥OF ⟨z, hz⟩, hz_mem⟩
    have h_aeval : Polynomial.aeval (IsLocalRing.residue ↥OF ⟨z, hz⟩)
        (Polynomial.X - Polynomial.C c₀) = 0 := by
      simp only [map_sub, Polynomial.aeval_X, Polynomial.aeval_C]
      exact sub_self _
    exact hTr ⟨Polynomial.X - Polynomial.C c₀, Polynomial.X_sub_C_ne_zero c₀, h_aeval⟩
  have hConj2 : ∀ (x : F_hat) (hx : x ∈ OF),
      let x_res : κF := IsLocalRing.residue ↥OF ⟨x, hx⟩
      let Kx_res : Subfield κF := Subfield.closure (Set.range κ_hom ∪ {x_res})
      letI : Algebra ↥Kx_res κF := Kx_res.toAlgebra
      Transcendental ↥K_res x_res →
      Algebra.IsSeparable ↥Kx_res κF →
      IsWeilAnalyticUnramifiedGen K_hat F_hat x := by
    dsimp only
    intro x hx hTrans hSep
    have hx_not : x ∉ Set.range (algebraMap K_hat F_hat) :=
      hNotRange_of_trans x hx hTrans
    have hFinLx := ((hCritPerturb F_hat hIsoK).1 y₀ x hx_not hy₀_fin).1
    obtain ⟨K_unr, hMod, hFinU, hValU, hResU, hTopImp⟩ :=
      (hT2_setup x hx hTrans hFinLx).2 hSep
    have hTop : K_unr = ⊤ :=
      weil_types23_immediate_ext_eq_top K_hat F_hat E_max hEquiChar hIsoK
        hE_norm hE_alg hE_res hNoDegP K_unr hMod hFinU hValU hResU
    exact hTopImp hTop
  refine ⟨?_, hConj2⟩
  intro hDisj
  suffices hEx₀ : ∃ x₀ : F_hat,
      x₀ ∉ Set.range (algebraMap K_hat F_hat) ∧
      IsWeilAnalyticUnramifiedGen K_hat F_hat x₀ by
    obtain ⟨x₀, hx₀_not, hx₀_gen⟩ := hEx₀
    obtain ⟨r_z, hr_pos, _, _, _, hPert⟩ :=
      ((hCritPerturb F_hat hIsoK).1 y₀ x₀ hx₀_not hy₀_fin).2
    refine ⟨x₀, r_z / 2, half_pos hr_pos, ?_⟩
    intro x' hx'
    rw [norm_sub_rev] at hx'
    exact hPert x' hx' hx₀_gen
  by_cases h1 : ∃ w : F_hat, ‖w‖ ≤ 1 ∧ ∀ c : K_hat, 1 ≤ ‖w - algebraMap K_hat F_hat c‖
  · obtain ⟨w, hw_le, hw_dist⟩ := h1
    have hw_OF : w ∈ OF := (hMemOF w).mpr hw_le
    have hw_not : w ∉ Set.range (algebraMap K_hat F_hat) := by
      rintro ⟨c, hc⟩
      have h0 : (1 : ℝ) ≤ ‖w - algebraMap K_hat F_hat c‖ := hw_dist c
      rw [hc, sub_self, norm_zero] at h0
      linarith
    let w_res : κF := IsLocalRing.residue ↥OF ⟨w, hw_OF⟩
    have hw_res_not : w_res ∉ K_res := by
      intro hw_in
      have hw_range : w_res ∈ Set.range κ_hom := by
        rw [← hKres_eq]
        exact hw_in
      obtain ⟨c_OK, hc_res⟩ := hw_range
      let d_OF : ↥OF := ⟨w, hw_OF⟩ - ⟨algebraMap K_hat F_hat c_OK.1, c_OK.2⟩
      have hd_res : IsLocalRing.residue ↥OF d_OF = 0 := by
        change w_res - κ_hom c_OK = 0
        rw [hc_res, sub_self]
      have hd_not_unit : ¬ IsUnit d_OF := by
        intro hu
        exact not_isUnit_zero (hd_res ▸ hu.map (IsLocalRing.residue ↥OF))
      have hd_ge : (1 : ℝ) ≤ ‖d_OF.1‖ := hw_dist c_OK.1
      have hd_le : ‖d_OF.1‖ ≤ 1 := (hMemOF d_OF.1).mp d_OF.2
      have hd_norm : ‖d_OF.1‖ = 1 := le_antisymm hd_le hd_ge
      have hd_ne : d_OF.1 ≠ 0 := by
        intro h0
        rw [h0, norm_zero] at hd_norm
        norm_num at hd_norm
      have hd_inv_OF : (d_OF.1)⁻¹ ∈ OF := by
        rw [hMemOF, norm_inv, hd_norm, inv_one]
      exact hd_not_unit ⟨⟨d_OF, ⟨(d_OF.1)⁻¹, hd_inv_OF⟩,
        Subtype.ext (mul_inv_cancel₀ hd_ne), Subtype.ext (inv_mul_cancel₀ hd_ne)⟩, rfl⟩
    have hw_trans : Transcendental ↥K_res w_res := by
      intro hAlg
      have hInt : IsIntegral ↥K_res w_res := hAlg.isIntegral
      have hIrr_min : Irreducible (minpoly ↥K_res w_res) := minpoly.irreducible hInt
