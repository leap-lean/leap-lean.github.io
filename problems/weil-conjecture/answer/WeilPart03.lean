        have haev_ne : Polynomial.aeval x_tilde P_bar ≠ 0 :=
          fun haev0 => hTr_tilde ⟨P_bar, hgbar_ne, haev0⟩
        have huP_res : IsLocalRing.residue ↥W₁ u_P = Polynomial.aeval x_tilde P_bar := hu_res 0
        have huP_not_max : u_P ∉ IsLocalRing.maximalIdeal ↥W₁ :=
          fun hmem => haev_ne (huP_res ▸ (IsLocalRing.residue_eq_zero_iff u_P).mpr hmem)
        have huP_unit : IsUnit u_P := by
          by_contra hnu
          apply huP_not_max
          rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
          exact hnu
        obtain ⟨huP_ne, huP_inv⟩ := (hUnit_W₁ u_P.1 u_P.2).mp huP_unit
        have hP_eq : Polynomial.aeval x₀ P = algebraMap K F c_P * (u_P : F) := by
          have h1 := hu_val 0
          change (u_P : F) = algebraMap K F c_P⁻¹ * Polynomial.aeval x₀ P at h1
          calc Polynomial.aeval x₀ P
              = algebraMap K F (c_P * c_P⁻¹) * Polynomial.aeval x₀ P := by
                rw [mul_inv_cancel₀ hc_ne, map_one, one_mul]
            _ = algebraMap K F c_P * (algebraMap K F c_P⁻¹ * Polynomial.aeval x₀ P) := by
                rw [map_mul, mul_assoc]
            _ = algebraMap K F c_P * (u_P : F) := by rw [← h1]
        exact ⟨c_P, P_bar, u_P, hc_ne, haev_ne, huP_ne, huP_inv, hP_eq, huP_res⟩
      let Lx₀ := IntermediateField.adjoin K ({x₀} : Set F)
      let Vx₀ : ValuationSubring ↥Lx₀ := W.comap Lx₀.val.toRingHom
      let Ax₀ : ValuationSubring ↥Lx₀ := W₁.comap Lx₀.val.toRingHom
      have hAx₀_res_mem : ∀ u : ↥Ax₀,
          IsLocalRing.residue ↥W₁ ⟨(u.1 : F), u.2⟩ ∈ L_tilde := by
        intro u
        have huW₁ : (u.1 : F) ∈ W₁ := u.2
        by_cases hu0 : (u.1 : F) = 0
        · have heq0 : (⟨(u.1 : F), u.2⟩ : ↥W₁) = 0 := Subtype.ext hu0
          rw [heq0, map_zero]
          exact L_tilde.zero_mem
        · obtain ⟨P, Q, hPQ⟩ := (IntermediateField.mem_adjoin_simple_iff K (u.1 : F)).mp u.1.2
          have hQ_ev : Polynomial.aeval x₀ Q ≠ 0 := by
            intro h0; rw [h0, div_zero] at hPQ; exact hu0 hPQ
          have hQ_ne : Q ≠ 0 := fun h0 => hQ_ev (by simp [h0])
          have hP_ne : P ≠ 0 := by
            intro h0; rw [h0, map_zero, zero_div] at hPQ; exact hu0 hPQ
          obtain ⟨c_P, P_bar, u_P, _, _, huP_ne, huP_inv, hP_eq, huP_res⟩ := gauss_poly P hP_ne
          obtain ⟨c_Q, Q_bar, u_Q, hcQ_ne, hQbar_ev, _, _, hQ_eq, huQ_res⟩ := gauss_poly Q hQ_ne
          have hmul_F : (u.1 : F) * (algebraMap K F c_Q * (u_Q : F)) =
              algebraMap K F c_P * (u_P : F) := by
            rw [← hQ_eq, ← hP_eq]
            exact (eq_div_iff hQ_ev).mp hPQ
          have hcQ_F_ne : algebraMap K F c_Q ≠ 0 :=
            fun h0 => hcQ_ne ((algebraMap K F).injective (by simpa using h0))
          let r : K := c_P * c_Q⁻¹
          have hr_eq : algebraMap K F r = (u.1 : F) * (u_Q : F) * (u_P : F)⁻¹ := by
            calc algebraMap K F r
                = (algebraMap K F c_P * (u_P : F)) * (u_P : F)⁻¹ * (algebraMap K F c_Q)⁻¹ := by
                    rw [mul_assoc _ (u_P : F), mul_inv_cancel₀ huP_ne, mul_one, map_mul, map_inv₀]
              _ = ((u.1 : F) * (algebraMap K F c_Q * (u_Q : F))) * (u_P : F)⁻¹ *
                    (algebraMap K F c_Q)⁻¹ := by rw [← hmul_F]
              _ = ((u.1 : F) * (u_Q : F) * (u_P : F)⁻¹) *
                    (algebraMap K F c_Q * (algebraMap K F c_Q)⁻¹) := by ring
              _ = (u.1 : F) * (u_Q : F) * (u_P : F)⁻¹ := by
                    rw [mul_inv_cancel₀ hcQ_F_ne, mul_one]
          have hrV₁ : r ∈ V₁ := by
            change algebraMap K F r ∈ W₁
            rw [hr_eq]
            exact W₁.toSubring.mul_mem (W₁.toSubring.mul_mem huW₁ u_Q.2) huP_inv
          have hW₁_rel : (⟨(u.1 : F), huW₁⟩ : ↥W₁) * u_Q = j_VW ⟨r, hrV₁⟩ * u_P := by
            apply Subtype.ext
            change (u.1 : F) * (u_Q : F) = algebraMap K F r * (u_P : F)
            rw [hr_eq, mul_assoc, inv_mul_cancel₀ huP_ne, mul_one]
          have hj_res : IsLocalRing.residue ↥W₁ (j_VW ⟨r, hrV₁⟩) =
              algebraMap K₁_res F₁_res (IsLocalRing.residue ↥V₁ ⟨r, hrV₁⟩) :=
            (hResCompat r hrV₁ hrV₁).symm
          have hres_rel : IsLocalRing.residue ↥W₁ ⟨(u.1 : F), huW₁⟩ *
              Polynomial.aeval x_tilde Q_bar =
              algebraMap K₁_res F₁_res (IsLocalRing.residue ↥V₁ ⟨r, hrV₁⟩) *
              Polynomial.aeval x_tilde P_bar := by
            have h1 := congrArg (IsLocalRing.residue ↥W₁) hW₁_rel
            simp only [map_mul, huQ_res, huP_res, hj_res] at h1
            exact h1
          have hres_div : IsLocalRing.residue ↥W₁ ⟨(u.1 : F), huW₁⟩ =
              (algebraMap K₁_res F₁_res (IsLocalRing.residue ↥V₁ ⟨r, hrV₁⟩) *
                Polynomial.aeval x_tilde P_bar) /
              Polynomial.aeval x_tilde Q_bar :=
            (eq_div_iff hQbar_ev).mpr hres_rel
          change IsLocalRing.residue ↥W₁ ⟨(u.1 : F), huW₁⟩ ∈ L_tilde
          rw [hres_div]
          exact L_tilde.div_mem
            (L_tilde.mul_mem (IntermediateField.algebraMap_mem L_tilde _)
              ((IntermediateField.mem_adjoin_simple_iff K₁_res _).mpr ⟨P_bar, 1, by simp⟩))
            ((IntermediateField.mem_adjoin_simple_iff K₁_res _).mpr ⟨Q_bar, 1, by simp⟩)
      obtain ⟨ψ, hψ_mk, _, hq_iff⟩ := mk_quot_hom x₀
      let hVAx₀ : Vx₀.toSubring ≤ Ax₀.toSubring := fun _ hu => hWW₁ hu
      let φ_Wx₀ : ↥Vx₀ →+* ↥W :=
        ((Lx₀.val.toRingHom.comp Vx₀.subtype).codRestrict W.toSubring (fun y => y.2))
      let q₀ : Ideal ↥Vx₀ := (IsLocalRing.maximalIdeal ↥Ax₀).comap (Subring.inclusion hVAx₀)
      let π_Vx : ↥Vx₀ →+* ↥Vx_tilde :=
        { toFun := fun u =>
            ⟨⟨IsLocalRing.residue ↥W₁ ⟨(u.1 : F), hWW₁ u.2⟩,
                hAx₀_res_mem ⟨u.1, hWW₁ u.2⟩⟩,
              (hW_iff (u.1 : F) (hWW₁ u.2)).mp u.2⟩
          map_one' := by
            apply Subtype.ext; apply Subtype.ext
            exact map_one (IsLocalRing.residue ↥W₁)
          map_mul' := fun u₁ u₂ => by
            apply Subtype.ext; apply Subtype.ext
            exact map_mul (IsLocalRing.residue ↥W₁) ⟨(u₁.1 : F), hWW₁ u₁.2⟩ ⟨(u₂.1 : F), hWW₁ u₂.2⟩
          map_zero' := by
            apply Subtype.ext; apply Subtype.ext
            exact map_zero (IsLocalRing.residue ↥W₁)
          map_add' := fun u₁ u₂ => by
            apply Subtype.ext; apply Subtype.ext
            exact map_add (IsLocalRing.residue ↥W₁) ⟨(u₁.1 : F), hWW₁ u₁.2⟩ ⟨(u₂.1 : F), hWW₁ u₂.2⟩ }
      have hπ_Vx_ker : ∀ u : ↥Vx₀, π_Vx u = 0 ↔ u ∈ q₀ := by
        intro u
        rw [hq_iff u, ← hπ_W_ker (φ_Wx₀ u)]
        constructor
        · intro h0
          have hval : IsLocalRing.residue ↥W₁ ⟨(u.1 : F), hWW₁ u.2⟩ = 0 :=
            congrArg (fun z : ↥Vx_tilde => (z.1 : F₁_res)) h0
          exact Subtype.ext hval
        · intro h0
          have hval : IsLocalRing.residue ↥W₁ ⟨(u.1 : F), hWW₁ u.2⟩ = 0 :=
            congrArg (fun z : ↥W_bar => (z : F₁_res)) h0
          apply Subtype.ext; apply Subtype.ext
          exact hval
      have hπ_Vx_surj : Function.Surjective π_Vx := by
        intro z
        by_cases hz0 : (z.1 : F₁_res) = 0
        · refine ⟨0, ?_⟩
          rw [map_zero]
          apply Subtype.ext; apply Subtype.ext
          exact hz0.symm
        · obtain ⟨P_bar, Q_bar, hPQ_bar⟩ :=
            (IntermediateField.mem_adjoin_simple_iff K₁_res (z.1 : F₁_res)).mp z.1.2
          have hQbar_ev : Polynomial.aeval x_tilde Q_bar ≠ 0 := by
            intro h0; rw [h0, div_zero] at hPQ_bar; exact hz0 hPQ_bar
          have hmap_surj : Function.Surjective (Polynomial.map (IsLocalRing.residue ↥V₁)) :=
            Polynomial.map_surjective _ IsLocalRing.residue_surjective
          obtain ⟨P_tilde, hP_tilde⟩ := hmap_surj P_bar
          obtain ⟨Q_tilde, hQ_tilde⟩ := hmap_surj Q_bar
          let u_num : ↥W₁ := Polynomial.eval₂ j_VW ⟨x₀, hx₀W₁⟩ P_tilde
          let u_den : ↥W₁ := Polynomial.eval₂ j_VW ⟨x₀, hx₀W₁⟩ Q_tilde
          have hcomp_res : (IsLocalRing.residue ↥W₁).comp j_VW =
              (algebraMap K₁_res F₁_res).comp (IsLocalRing.residue ↥V₁) := by
            ext v
            exact (hResCompat v.1 v.2 v.2).symm
          have hunum_res : IsLocalRing.residue ↥W₁ u_num = Polynomial.aeval x_tilde P_bar := by
            dsimp only [u_num]
            rw [Polynomial.hom_eval₂, hcomp_res, ← Polynomial.eval₂_map, hP_tilde,
              ← Polynomial.aeval_def]
          have huden_res : IsLocalRing.residue ↥W₁ u_den = Polynomial.aeval x_tilde Q_bar := by
            dsimp only [u_den]
            rw [Polynomial.hom_eval₂, hcomp_res, ← Polynomial.eval₂_map, hQ_tilde,
              ← Polynomial.aeval_def]
          have hunum_Lx₀ : (u_num : F) ∈ Lx₀ := by
            change W₁.subtype (Polynomial.eval₂ j_VW ⟨x₀, hx₀W₁⟩ P_tilde) ∈ Lx₀
            rw [Polynomial.hom_eval₂]
            have hcomp_F : W₁.subtype.comp j_VW = (algebraMap K F).comp V₁.subtype := by
              ext v; rfl
            rw [hcomp_F, ← Polynomial.eval₂_map, ← Polynomial.aeval_def]
            exact (IntermediateField.mem_adjoin_simple_iff K _).mpr
              ⟨Polynomial.map V₁.subtype P_tilde, 1, by simp⟩
          have huden_Lx₀ : (u_den : F) ∈ Lx₀ := by
            change W₁.subtype (Polynomial.eval₂ j_VW ⟨x₀, hx₀W₁⟩ Q_tilde) ∈ Lx₀
            rw [Polynomial.hom_eval₂]
            have hcomp_F : W₁.subtype.comp j_VW = (algebraMap K F).comp V₁.subtype := by
              ext v; rfl
            rw [hcomp_F, ← Polynomial.eval₂_map, ← Polynomial.aeval_def]
            exact (IntermediateField.mem_adjoin_simple_iff K _).mpr
              ⟨Polynomial.map V₁.subtype Q_tilde, 1, by simp⟩
          have huden_not_max : u_den ∉ IsLocalRing.maximalIdeal ↥W₁ :=
            fun hmem => hQbar_ev (huden_res ▸ (IsLocalRing.residue_eq_zero_iff u_den).mpr hmem)
          have huden_unit : IsUnit u_den := by
            by_contra hnu
            apply huden_not_max
            rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
            exact hnu
          obtain ⟨huden_ne, huden_invW₁⟩ := (hUnit_W₁ u_den.1 u_den.2).mp huden_unit
          let u₀ : ↥Lx₀ := ⟨(u_num : F), hunum_Lx₀⟩ / ⟨(u_den : F), huden_Lx₀⟩
          have hu₀_val : (u₀ : F) = (u_num : F) / (u_den : F) := rfl
          have hu₀W₁ : (u₀ : F) ∈ W₁ := by
            rw [hu₀_val, div_eq_mul_inv]
            exact W₁.toSubring.mul_mem u_num.2 huden_invW₁
          have hres_inv : IsLocalRing.residue ↥W₁ ⟨(u_den : F)⁻¹, huden_invW₁⟩ =
              (Polynomial.aeval x_tilde Q_bar)⁻¹ := by
            refine (inv_eq_of_mul_eq_one_right ?_).symm
            rw [← huden_res, ← map_mul]
            have hmul1 : u_den * ⟨(u_den : F)⁻¹, huden_invW₁⟩ = 1 :=
              Subtype.ext (mul_inv_cancel₀ huden_ne)
            rw [hmul1, map_one]
          have hu₀_res : IsLocalRing.residue ↥W₁ ⟨(u₀ : F), hu₀W₁⟩ = (z.1 : F₁_res) := by
            have hprod_eq : (⟨(u₀ : F), hu₀W₁⟩ : ↥W₁) = u_num * ⟨(u_den : F)⁻¹, huden_invW₁⟩ := by
              ext
              exact div_eq_mul_inv (u_num : F) (u_den : F)
            rw [hprod_eq, map_mul, hunum_res, hres_inv, ← div_eq_mul_inv, ← hPQ_bar]
          have hu₀W : (u₀ : F) ∈ W := (hW_iff (u₀ : F) hu₀W₁).mpr (hu₀_res ▸ z.2)
          refine ⟨⟨u₀, hu₀W⟩, ?_⟩
          apply Subtype.ext; apply Subtype.ext
          exact hu₀_res
      let lift_Vx : (↥Vx₀ ⧸ q₀) →+* ↥Vx_tilde :=
        Ideal.Quotient.lift q₀ π_Vx (fun u hu => (hπ_Vx_ker u).mpr hu)
      have hlift_Vx_bij : Function.Bijective lift_Vx :=
        ⟨by
          rintro ⟨u₁⟩ ⟨u₂⟩ h
          refine Ideal.Quotient.eq.mpr ((hπ_Vx_ker (u₁ - u₂)).mp ?_)
          rw [map_sub, sub_eq_zero]
          exact h,
         fun z => by
          obtain ⟨u, rfl⟩ := hπ_Vx_surj z
          exact ⟨Ideal.Quotient.mk q₀ u, rfl⟩⟩
      let eVx : (↥Vx₀ ⧸ q₀) ≃+* ↥Vx_tilde := RingEquiv.ofBijective lift_Vx hlift_Vx_bij
      have hEt_ψ : RingHom.Etale ψ := by
        refine etale_congr eVx.symm eW.symm φ_tilde ψ (fun z => ?_) hEt_tilde
        obtain ⟨u, rfl⟩ := hπ_Vx_surj z
        have hex_symm : eVx.symm (π_Vx u) = Ideal.Quotient.mk q₀ u :=
          eVx.injective (by simp [eVx, lift_Vx])
        rw [hex_symm, hψ_mk u]
        apply eW.injective
        simp only [RingEquiv.apply_symm_apply]
        change lift_W (Ideal.Quotient.mk q' (φ_Wx₀ u)) = φ_tilde (π_Vx u)
        ext
        rfl
      exact ⟨hTr_tilde, hSep_tilde, ψ, hψ_mk, hEt_ψ⟩

theorem weil_decompletion_composed_height_induction (k K F : Type u) [Field k] [Field K] [IsSepClosed K] [Field F]
    [Algebra k K] [Algebra k F] [Algebra K F] [IsScalarTower k K F]
    (W : ValuationSubring F)
    (hkW : ∀ c : k, algebraMap k F c ∈ W)
    (hFinV : Set.Finite (Set.univ : Set (PrimeSpectrum ↥(W.comap (algebraMap K F)))))
    (hFinW : Set.Finite (Set.univ : Set (PrimeSpectrum ↥W)))
    (hSepF : ∃ (x_sep : F), Transcendental K x_sep ∧
      let L0 := IntermediateField.adjoin K ({x_sep} : Set F)
      FiniteDimensional ↥L0 F ∧ Algebra.IsSeparable ↥L0 F)
    (hUnbCurve : ∀ (O_rel : ValuationSubring F), O_rel ≠ ⊤ → (∀ a : K, algebraMap K F a ∈ O_rel) →
      ∃ (x₀ : F), Transcendental K x₀ ∧
        let Lx₀ := IntermediateField.adjoin K ({x₀} : Set F)
        let Ox₀ := O_rel.comap Lx₀.val.toRingHom
        RingHom.Etale ((Lx₀.val.toRingHom.comp Ox₀.subtype).codRestrict O_rel.toSubring (fun y => y.2)) ∧
        (∀ w : F, w ∈ O_rel → ∃ u : ↥Lx₀, (u : F) ∈ O_rel ∧ (w - (u : F) = 0 ∨ (w - (u : F))⁻¹ ∉ O_rel)))
    (hAnalytic : HasWeilAnalyticOneDimUniformization k) :
    IsWeilEtaleTranscendenceParam K F W :=
by
  have etale_congr : ∀ {R₁ R₂ S₁ S₂ : Type u} [CommRing R₁] [CommRing R₂] [CommRing S₁] [CommRing S₂]
      (eR : R₁ ≃+* R₂) (eS : S₁ ≃+* S₂) (f₁ : R₁ →+* S₁) (f₂ : R₂ →+* S₂),
      (∀ r : R₁, f₂ (eR r) = eS (f₁ r)) → f₁.Etale → f₂.Etale := by
    intro R₁ R₂ S₁ S₂ _ _ _ _ eR eS f₁ f₂ hcomm hf₁
    have heq : f₂ = eS.toRingHom.comp (f₁.comp eR.symm.toRingHom) := by
      ext x
      simp [← hcomm (eR.symm x)]
    rw [heq]
    exact RingHom.Etale.stableUnderComposition _ _
      (RingHom.Etale.stableUnderComposition _ _ (RingHom.Etale.of_bijective eR.symm.bijective) hf₁)
      (RingHom.Etale.of_bijective eS.bijective)
  have etale_of_sep_finDim : ∀ (E₁ E₂ : Type u) [Field E₁] [Field E₂] [Algebra E₁ E₂]
      [FiniteDimensional E₁ E₂] [Algebra.IsSeparable E₁ E₂], (algebraMap E₁ E₂).Etale := by
    intro E₁ E₂ _ _ _ _ _
    rw [RingHom.etale_algebraMap]
    have hFT : Algebra.FiniteType E₁ E₂ := inferInstance
    have _ : Algebra.FinitePresentation E₁ E₂ := Algebra.FinitePresentation.of_finiteType.mp hFT
    have _ : Algebra.FormallyEtale E₁ E₂ := Algebra.FormallyEtale.of_isSeparable E₁ E₂
    exact {}
  have hInv : ∀ {K' F' : Type u} [Field K'] [Field F'] [Algebra K' F'] (W' : ValuationSubring F')
      (x₀ : F'),
      Transcendental K' x₀ →
      (let Lx₀ := IntermediateField.adjoin K' ({x₀} : Set F')
       let Vx₀ := W'.comap Lx₀.val.toRingHom
       RingHom.Etale ((Lx₀.val.toRingHom.comp Vx₀.subtype).codRestrict W'.toSubring (fun y => y.2))) →
      IsWeilEtaleTranscendenceParam K' F' W' := by
    intro K' F' _ _ _ W' x₀ hTr hEt
    by_cases hx₀W : x₀ ∈ W'
    · exact ⟨x₀, hx₀W, hTr, hEt⟩
    · have hx_invW : x₀⁻¹ ∈ W' := (W'.mem_or_inv_mem x₀).resolve_left hx₀W
      have hTr_inv : Transcendental K' x₀⁻¹ := fun hAlg => hTr (by simpa using hAlg.inv)
      let Lx₀ := IntermediateField.adjoin K' ({x₀} : Set F')
      let Vx₀ := W'.comap Lx₀.val.toRingHom
      let Lx_inv := IntermediateField.adjoin K' ({x₀⁻¹} : Set F')
      let Vx_inv := W'.comap Lx_inv.val.toRingHom
      have hL_eq : Lx_inv = Lx₀ := by
        apply le_antisymm
        · rw [IntermediateField.adjoin_le_iff, Set.singleton_subset_iff]
          exact Lx₀.inv_mem (IntermediateField.mem_adjoin_simple_self K' x₀)
        · rw [IntermediateField.adjoin_le_iff, Set.singleton_subset_iff]
          simpa using Lx_inv.inv_mem (IntermediateField.mem_adjoin_simple_self K' x₀⁻¹)
      let eV : ↥Vx₀ ≃+* ↥Vx_inv :=
        { toFun := fun v => ⟨⟨(v.1 : F'), by rw [hL_eq]; exact v.1.2⟩, v.2⟩
          invFun := fun u => ⟨⟨(u.1 : F'), by rw [← hL_eq]; exact u.1.2⟩, u.2⟩
          left_inv := fun v => by ext; rfl
          right_inv := fun u => by ext; rfl
          map_mul' := fun v₁ v₂ => by ext; rfl
          map_add' := fun v₁ v₂ => by ext; rfl }
      have hEt_inv : RingHom.Etale ((Lx_inv.val.toRingHom.comp Vx_inv.subtype).codRestrict W'.toSubring (fun y => y.2)) :=
        etale_congr eV (RingEquiv.refl ↥W')
          ((Lx₀.val.toRingHom.comp Vx₀.subtype).codRestrict W'.toSubring (fun y => y.2))
          ((Lx_inv.val.toRingHom.comp Vx_inv.subtype).codRestrict W'.toSubring (fun y => y.2))
          (fun v => by ext; rfl) hEt
      exact ⟨x₀⁻¹, hx_invW, hTr_inv, hEt_inv⟩
  have hGen_of_top : ∀ (F_hat : Type u) [NontriviallyNormedField F_hat] [IsUltrametricDist F_hat]
      (M : Subfield F_hat), M = ⊤ →
      (let OF : ValuationSubring F_hat := (NormedField.valuation (K := F_hat)).valuationSubring
       let OM : ValuationSubring ↥M := OF.comap M.subtype
       letI : Algebra ↥M F_hat := M.toAlgebra
       let φ_hat : ↥OM →+* ↥OF := (M.subtype.comp OM.subtype).codRestrict OF.toSubring (fun y => y.2)
       letI : Algebra ↥OM ↥OF := φ_hat.toAlgebra
       FiniteDimensional ↥M F_hat ∧ Module.Finite ↥OM ↥OF ∧ RingHom.Etale φ_hat) := by
    intro F_hat _ _ M hTop
    dsimp only
    let _ : Algebra ↥M F_hat := M.toAlgebra
    let OF : ValuationSubring F_hat := (NormedField.valuation (K := F_hat)).valuationSubring
    let OM : ValuationSubring ↥M := OF.comap M.subtype
