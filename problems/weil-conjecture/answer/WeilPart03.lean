            ∑ i ∈ cw.support, algebraMap K_hat L₁ (cw i) * ((fam i : ↥L1_coeff) : L₁) := by
          rw [Finsupp.sum]
          refine Finset.sum_congr rfl fun i _ => by rw [Algebra.smul_def]
        rw [hcw_sum] at hw'_le hw'_dist
