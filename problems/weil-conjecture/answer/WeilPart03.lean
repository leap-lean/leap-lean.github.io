            have : FiniteDimensional ↥Kw ↥S := FiniteDimensional.left ↥Kw ↥S L
            have : FiniteDimensional ↥Kw ↥M := FiniteDimensional.left ↥Kw ↥M L
            have : FiniteDimensional ↥S ↥M := FiniteDimensional.right ↥Kw ↥S ↥M
