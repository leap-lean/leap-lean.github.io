    obtain ⟨r_α, hr_α⟩ := hπ_surj α_bar
    let θ₀ : ↥R₁ := r_α * r_e
    let θ : B_q := θ₀.1
    have hInt_θ : IsIntegral A₁ θ := (Algebra.IsIntegral.isIntegral θ₀).map R₁.val
    have hπ_θ : π θ = α_bar := by
