      rw [faithfulSMul_iff_algebraMap_injective]
      have hinj_A₁Bq : Function.Injective (algebraMap A₁ B_q) :=
        (Module.isTorsionFree_iff_algebraMap_injective (R := A₁) (A := B_q)).mp inferInstance
      rw [IsScalarTower.algebraMap_eq A₁ B_q L]
      exact hinj_L.comp hinj_A₁Bq
    letI : Algebra K₀ L := FractionRing.liftAlgebra A₁ L
    haveI : IsScalarTower A₁ K₀ L := FractionRing.isScalarTower_liftAlgebra A₁ L
    let S_θ : Subalgebra A₁ B_q := Algebra.adjoin A₁ ({θ} : Set B_q)
    let θ_L : L := ιL θ
    have hIntL : IsIntegral A₁ θ_L := hInt.map (IsScalarTower.toAlgHom A₁ B_q L)
    have hIntK₀ : IsIntegral K₀ θ_L := hIntL.tower_top
    let E : IntermediateField K₀ L := IntermediateField.adjoin K₀ ({θ_L} : Set L)
    let A_θ : Subalgebra A₁ L := Algebra.adjoin A₁ ({θ_L} : Set L)
    have hAθ_eq_map : A_θ = S_θ.map (IsScalarTower.toAlgHom A₁ B_q L) :=
      (AlgHom.map_adjoin_singleton (IsScalarTower.toAlgHom A₁ B_q L) θ).symm
    have hAθ_le_E : ∀ y ∈ A_θ, y ∈ E := by
      intro y hy
      refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hy
      · intro x hx
        rw [Set.mem_singleton_iff.mp hx]
        exact IntermediateField.mem_adjoin_simple_self K₀ θ_L
      · intro a
        rw [IsScalarTower.algebraMap_apply A₁ K₀ L a]
        exact E.algebraMap_mem _
      · intro x₁ x₂ _ _ h1 h2; exact E.add_mem h1 h2
      · intro x₁ x₂ _ _ h1 h2; exact E.mul_mem h1 h2
    have hSθ_mem_E : ∀ x : ↥S_θ, ιL x.1 ∈ E := by
      intro x
      apply hAθ_le_E
      rw [hAθ_eq_map]
      exact ⟨x.1, x.2, rfl⟩
    have hBq_mem_E : ∀ z : B_q, ιL z ∈ E := by
      intro z
      obtain ⟨⟨x, s⟩, hzs⟩ := IsLocalization.surj M z
      have hs_unit : IsUnit (s.1 : B_q) := IsLocalization.map_units B_q s
      have hs_ne : ιL s.1.1 ≠ 0 := by
        intro h0
        exact hs_unit.ne_zero (hinj_L (h0.trans (map_zero _).symm))
      have hzs_L : ιL z * ιL s.1.1 = ιL x.1 := by
        rw [← map_mul]; exact congrArg ιL hzs
      have hz_eq : ιL z = ιL x.1 * (ιL s.1.1)⁻¹ := by
        calc
          ιL z = (ιL z * ιL s.1.1) * (ιL s.1.1)⁻¹ := by
            rw [mul_assoc, mul_inv_cancel₀ hs_ne, mul_one]
          _ = ιL x.1 * (ιL s.1.1)⁻¹ := by rw [hzs_L]
      rw [hz_eq]
      exact E.mul_mem (hSθ_mem_E x) (E.inv_mem (hSθ_mem_E s.1))
    have hE_top : E = ⊤ := by
      rw [eq_top_iff]
      intro w _
      obtain ⟨⟨b, s⟩, hws⟩ := IsLocalization.surj (nonZeroDivisors B_q) w
      have hs_ne_B : (s : B_q) ≠ 0 := nonZeroDivisors.ne_zero s.2
      have hs_ne : ιL s.1 ≠ 0 := fun h0 => hs_ne_B (hinj_L (h0.trans (map_zero _).symm))
      have hw_eq : w = ιL b * (ιL s.1)⁻¹ := by
        calc
          w = (w * ιL s.1) * (ιL s.1)⁻¹ := by
            rw [mul_assoc, mul_inv_cancel₀ hs_ne, mul_one]
          _ = ιL b * (ιL s.1)⁻¹ := by rw [hws]
      rw [hw_eq]
      exact E.mul_mem (hBq_mem_E b) (E.inv_mem (hBq_mem_E s.1))
    have hK₀_adjoin : Algebra.adjoin K₀ ({θ_L} : Set L) = ⊤ := by
      rw [← IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic hIntK₀.isAlgebraic]
      change E.toSubalgebra = ⊤
      rw [hE_top]
      rfl
    haveI : FiniteDimensional K₀ ↥E := IntermediateField.adjoin.finiteDimensional hIntK₀
    let e_EL : ↥E ≃ₐ[K₀] L := (IntermediateField.equivOfEq hE_top).trans IntermediateField.topEquiv
    haveI : FiniteDimensional K₀ L := Module.Finite.equiv e_EL.toLinearEquiv
    let d_θ : B_q := Polynomial.aeval θ (Polynomial.derivative (minpoly A₁ θ))
    let δ₀ : L := Polynomial.aeval θ_L (Polynomial.derivative (minpoly K₀ θ_L))
    have hmin₁ : minpoly A₁ θ_L = minpoly A₁ θ :=
      minpoly.algHom_eq (IsScalarTower.toAlgHom A₁ B_q L) hinj_L θ
    have hmin₂ : minpoly K₀ θ_L = Polynomial.map (algebraMap A₁ K₀) (minpoly A₁ θ) := by
      rw [← hmin₁]
      exact minpoly.isIntegrallyClosed_eq_field_fractions' K₀ hIntL
    have hδ₀_eq : δ₀ = ιL d_θ := by
      change Polynomial.aeval θ_L (Polynomial.derivative (minpoly K₀ θ_L)) = _
      rw [hmin₂, Polynomial.derivative_map, Polynomial.aeval_map_algebraMap K₀ θ_L]
      exact Polynomial.aeval_algHom_apply (IsScalarTower.toAlgHom A₁ B_q L) θ
        (Polynomial.derivative (minpoly A₁ θ))
    have hδ₀_ne : δ₀ ≠ 0 := by
      rw [hδ₀_eq]
      intro h0
      exact hUnit.ne_zero (hinj_L (h0.trans (map_zero _).symm))
    have hderiv_ne : Polynomial.derivative (minpoly K₀ θ_L) ≠ 0 := by
      intro h0
      apply hδ₀_ne
      change Polynomial.aeval θ_L (Polynomial.derivative (minpoly K₀ θ_L)) = 0
      rw [h0, map_zero]
    have hSep_θ : IsSeparable K₀ θ_L :=
      (Polynomial.separable_iff_derivative_ne_zero (minpoly.irreducible hIntK₀)).mpr hderiv_ne
    haveI : Algebra.IsSeparable K₀ ↥E :=
      (IntermediateField.isSeparable_adjoin_simple_iff_isSeparable K₀ L).mpr hSep_θ
    haveI : Algebra.IsSeparable K₀ L := by
      rw [Algebra.isSeparable_def]
      intro x
      let xE : ↥E := e_EL.symm x
      have hx_sep : IsSeparable K₀ xE := Algebra.IsSeparable.isSeparable K₀ xE
      have hmin_eq : minpoly K₀ x = minpoly K₀ xE := by
        have hx_eq : e_EL.toAlgHom xE = x := e_EL.apply_symm_apply x
        rw [← hx_eq]
        exact minpoly.algHom_eq e_EL.toAlgHom e_EL.injective xE
      change (minpoly K₀ x).Separable
      rw [hmin_eq]
      exact hx_sep
    rw [isIntegrallyClosed_iff L]
    intro u hu
    have hSθ_ic : S_θ ≤ integralClosure A₁ B_q := by
      rw [Algebra.adjoin_le_iff, Set.singleton_subset_iff]
      exact hInt
    haveI : Algebra.IsIntegral A₁ ↥S_θ := by
      constructor
      rintro ⟨x, hx⟩
      obtain ⟨p, hp_mon, hp_eval⟩ := (hSθ_ic hx : IsIntegral A₁ x)
      refine ⟨p, hp_mon, Subtype.ext ?_⟩
      change S_θ.val.toRingHom (Polynomial.eval₂ (algebraMap A₁ ↥S_θ) ⟨x, hx⟩ p) = 0
      rw [Polynomial.hom_eval₂]
      exact hp_eval
    obtain ⟨s, hs_int⟩ := IsIntegral.exists_multiple_integral_of_isLocalization M u hu
    let w : L := s • u
    have hw_eq : w = ιL s.1.1 * u := by
      change (s.1 : ↥S_θ) • u = ιL s.1.1 * u
      rw [Algebra.smul_def]
      rfl
    have hw_int : IsIntegral A₁ w := isIntegral_trans w hs_int
    have hAθ_ic : A_θ ≤ integralClosure A₁ L := by
      rw [Algebra.adjoin_le_iff, Set.singleton_subset_iff]
      exact hIntL
    have hw_dual : w ∈ (Algebra.traceForm K₀ L).dualSubmodule (Subalgebra.toSubmodule A_θ) := by
      rw [LinearMap.BilinForm.mem_dualSubmodule]
      intro z hz
      have hz_int : IsIntegral A₁ z := hAθ_ic hz
      have hwz_int : IsIntegral A₁ (w * z) := hw_int.mul hz_int
      have htr_int : IsIntegral A₁ (Algebra.trace K₀ L (w * z)) := Algebra.isIntegral_trace hwz_int
      rw [Algebra.traceForm_apply, Submodule.mem_one]
      exact IsIntegrallyClosed.isIntegral_iff.mp htr_int
    rw [traceForm_dualSubmodule_adjoin A₁ K₀ hK₀_adjoin hIntL] at hw_dual
    obtain ⟨y_L, hy_Aθ, hy_smul⟩ :=
      (Submodule.mem_smul_pointwise_iff_exists w δ₀⁻¹ (Subalgebra.toSubmodule A_θ)).mp hw_dual
    have hy_eq : y_L = δ₀ * w := by
      have h1 : δ₀⁻¹ * y_L = w := hy_smul
      rw [← h1, mul_inv_cancel_left₀ hδ₀_ne]
    have hy_map : y_L ∈ S_θ.map (IsScalarTower.toAlgHom A₁ B_q L) := by
      rw [← hAθ_eq_map]; exact hy_Aθ
    obtain ⟨y_B, _, hy_val⟩ := hy_map
    have hy_val' : ιL y_B = ιL (d_θ * s.1.1) * u := by
      calc
        ιL y_B = y_L := hy_val
        _ = δ₀ * w := hy_eq
        _ = ιL d_θ * (ιL s.1.1 * u) := by rw [hδ₀_eq, hw_eq]
        _ = ιL (d_θ * s.1.1) * u := by rw [← mul_assoc, ← map_mul]
    have hds_unit : IsUnit (d_θ * s.1.1) := hUnit.mul (IsLocalization.map_units B_q s)
    obtain ⟨v, hv⟩ := isUnit_iff_exists_inv.mp hds_unit
    refine ⟨y_B * v, ?_⟩
    change ιL (y_B * v) = u
    calc
      ιL (y_B * v) = ιL y_B * ιL v := map_mul _ _ _
      _ = (ιL (d_θ * s.1.1) * u) * ιL v := by rw [hy_val']
      _ = (ιL (d_θ * s.1.1) * ιL v) * u := by ring
      _ = ιL ((d_θ * s.1.1) * v) * u := by rw [← map_mul]
      _ = ιL 1 * u := by rw [hv]
      _ = u := by rw [map_one, one_mul]
  apply IsIntegrallyClosed.of_localization_maximal
  intro q _ hq_max
  haveI : q.IsPrime := hq_max.isPrime
  let p : Ideal A₀ := q.under A₀
  let A₁ : Type u := Localization.AtPrime p
  have hICA₁ : IsIntegrallyClosed A₁ :=
    @isIntegrallyClosed_of_isLocalization A₀ A₁ _ _ _ ‹IsIntegrallyClosed A₀› ‹IsDomain A₀›
      p.primeCompl p.primeCompl_le_nonZeroDivisors _
  let B_q : Type u := Localization.AtPrime q
  letI : q.LiesOver p := ⟨rfl⟩
  letI : Algebra A₁ B_q := Localization.AtPrime.algebraOfLiesOver p q
  obtain ⟨hUnram, hLocHom, hTF, hSep, hMax, R₁, hFinR₁, hIntR₁, hLocR₁⟩ := hStep2 q
  haveI : Algebra.FormallyUnramified A₁ B_q := hUnram
  haveI : IsLocalHom (algebraMap A₁ B_q) := hLocHom
  haveI : Module.IsTorsionFree A₁ B_q := hTF
  obtain ⟨θ, hIntθ, hLocθ⟩ := hStep3 A₁ B_q hSep hMax R₁ hFinR₁ hIntR₁ hLocR₁
  have hUnitθ : IsUnit (Polynomial.aeval θ (Polynomial.derivative (minpoly A₁ θ))) :=
    hStep4 A₁ B_q hICA₁ θ hIntθ hLocθ
  exact hStep5 A₁ B_q hICA₁ θ hIntθ hUnitθ _ hLocθ

theorem weil_strictlySemistable_isAffineNormal_and_funcField (K : Type u) [Field K] [IsSepClosed K] (m : ℕ)
    (V : ValuationSubring K)
    (hPkg : IsValuationRingAlgPackage m V) :
    AlgebraicGeometry.IsOpenImmersion
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)) ∧
    (∀ (X : AlgebraicGeometry.Scheme.{u})
        (g_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V)),
      IsStrictlySemistableCurveOverValuation V g_X →
      IsAffineNormalScheme X) ∧
    (∀ (U_ss : AlgebraicGeometry.Scheme.{u})
        (g_ss : U_ss ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V)),
      IsStrictlySemistableCurveOverValuation V g_ss →
      ∃ (F_ss : Type u) (_ : Field F_ss)
        (η_ss : AlgebraicGeometry.Spec (CommRingCat.of F_ss) ⟶ U_ss),
        IsSchemeFunctionField U_ss F_ss η_ss) :=
by
  refine ⟨?_, ?_, ?_⟩
  · classical
    have hFin : Set.Finite (Set.univ : Set (PrimeSpectrum ↥V)) := hPkg.1
    have : Finite (PrimeSpectrum ↥V) := Set.finite_univ_iff.mp hFin
    let _ : Fintype (PrimeSpectrum ↥V) := Fintype.ofFinite (PrimeSpectrum ↥V)
    let F_pos : Finset (PrimeSpectrum ↥V) :=
      Finset.univ.filter (fun P : PrimeSpectrum ↥V => P.asIdeal ≠ ⊥)
    have hExAway : ∃ t₀ : ↥V, IsLocalization.Away t₀ K := by
      by_cases hne : F_pos.Nonempty
      · have hMin : ∀ (G : Finset (PrimeSpectrum ↥V)), G.Nonempty →
            ∃ Q ∈ G, ∀ P ∈ G, Q.asIdeal ≤ P.asIdeal := by
          intro G
          induction G using Finset.induction with
          | empty =>
            intro hG
            exact False.elim (Finset.not_nonempty_empty hG)
          | @insert a G _ ih =>
            intro _
            by_cases hG : G.Nonempty
            · obtain ⟨Q', hQ'G, hQ'le⟩ := ih hG
              rcases le_total a.asIdeal Q'.asIdeal with haQ' | hQ'a
              · refine ⟨a, Finset.mem_insert_self a G, ?_⟩
                intro P hP
                rcases Finset.mem_insert.mp hP with rfl | hPG
                · exact le_refl _
                · exact le_trans haQ' (hQ'le P hPG)
              · refine ⟨Q', Finset.mem_insert_of_mem hQ'G, ?_⟩
                intro P hP
                rcases Finset.mem_insert.mp hP with rfl | hPG
                · exact hQ'a
                · exact hQ'le P hPG
            · refine ⟨a, Finset.mem_insert_self a G, ?_⟩
              intro P hP
              rcases Finset.mem_insert.mp hP with rfl | hPG
              · exact le_refl _
              · exact False.elim (hG ⟨P, hPG⟩)
        obtain ⟨Q₀, hQ₀_mem, hQ₀_min⟩ := hMin F_pos hne
        have hQ₀_ne : Q₀.asIdeal ≠ ⊥ := (Finset.mem_filter.mp hQ₀_mem).2
        obtain ⟨t₀, ht₀_mem, ht₀_ne⟩ := (Submodule.ne_bot_iff Q₀.asIdeal).mp hQ₀_ne
        refine ⟨t₀, ?_⟩
        refine { map_units := ?_, surj := ?_, exists_of_eq := ?_ }
        · intro y
          obtain ⟨n, hn⟩ := y.2
          dsimp at hn
          have ht₀K : (algebraMap ↥V K t₀) ≠ 0 := by
            intro h0
            apply ht₀_ne
            exact Subtype.ext h0
          have hyK : algebraMap ↥V K y.1 ≠ 0 := by
            rw [← hn, map_pow]
            exact pow_ne_zero n ht₀K
          exact Ne.isUnit hyK
        · intro z
          rcases V.mem_or_inv_mem z with hz | hz_inv
          · exact ⟨⟨⟨z, hz⟩, ⟨1, Submonoid.one_mem _⟩⟩, by simp⟩
          · by_cases hz0 : z = 0
            · subst hz0
              exact ⟨⟨0, ⟨1, Submonoid.one_mem _⟩⟩, by simp⟩
            · let b : ↥V := ⟨z⁻¹, hz_inv⟩
              have hb_ne : b ≠ 0 := by
                intro hb0
                exact inv_ne_zero hz0 (congrArg Subtype.val hb0)
              have ht₀_rad : t₀ ∈ (Ideal.span ({b} : Set ↥V)).radical := by
                rw [Ideal.radical_eq_sInf, Ideal.mem_sInf]
                rintro I ⟨hbI, hI_prime⟩
                have hI_ne : I ≠ ⊥ := by
                  intro hI0
                  apply hb_ne
                  rw [hI0] at hbI
                  exact Ideal.mem_bot.mp (hbI (Ideal.subset_span (Set.mem_singleton b)))
                have hP_mem : (⟨I, hI_prime⟩ : PrimeSpectrum ↥V) ∈ F_pos :=
                  Finset.mem_filter.mpr ⟨Finset.mem_univ _, hI_ne⟩
                exact hQ₀_min ⟨I, hI_prime⟩ hP_mem ht₀_mem
              obtain ⟨k, hk⟩ := Ideal.mem_radical_iff.mp ht₀_rad
              obtain ⟨c, hc⟩ := Ideal.mem_span_singleton.mp hk
              refine ⟨⟨c, ⟨t₀ ^ k, ⟨k, rfl⟩⟩⟩, ?_⟩
              change z * V.subtype (t₀ ^ k) = V.subtype c
              have hcK : V.subtype (t₀ ^ k) = z⁻¹ * V.subtype c := by
                simpa [b] using congrArg V.subtype hc
              rw [hcK, ← mul_assoc, mul_inv_cancel₀ hz0, one_mul]
        · intro x₁ x₂ h
          exact ⟨⟨1, Submonoid.one_mem _⟩, by simp [Subtype.ext h]⟩
      · rw [Finset.not_nonempty_iff_eq_empty] at hne
        refine ⟨1, ?_⟩
        refine { map_units := ?_, surj := ?_, exists_of_eq := ?_ }
        · intro y
          obtain ⟨n, hn⟩ := y.2
          dsimp at hn
          have hy1 : y.1 = 1 := by rw [← hn, one_pow]
          rw [hy1, map_one]
          exact isUnit_one
        · intro z
          rcases V.mem_or_inv_mem z with hz | hz_inv
          · exact ⟨⟨⟨z, hz⟩, ⟨1, Submonoid.one_mem _⟩⟩, by simp⟩
          · by_cases hz0 : z = 0
            · subst hz0
              exact ⟨⟨0, ⟨1, Submonoid.one_mem _⟩⟩, by simp⟩
            · let b : ↥V := ⟨z⁻¹, hz_inv⟩
              have hb_ne : b ≠ 0 := by
                intro hb0
                exact inv_ne_zero hz0 (congrArg Subtype.val hb0)
              have hb_unit : IsUnit b := by
                by_contra hnu
                have hspan_ne : Ideal.span ({b} : Set ↥V) ≠ ⊤ :=
                  mt Ideal.span_singleton_eq_top.mp hnu
                obtain ⟨m_id, hm_max, hle_m⟩ := Ideal.exists_le_maximal _ hspan_ne
                have : m_id.IsPrime := hm_max.isPrime
                have hm_ne : m_id ≠ ⊥ := by
                  intro hm0
                  apply hb_ne
                  rw [hm0] at hle_m
                  exact Ideal.mem_bot.mp (hle_m (Ideal.subset_span (Set.mem_singleton b)))
                have hmem : (⟨m_id, inferInstance⟩ : PrimeSpectrum ↥V) ∈ F_pos :=
                  Finset.mem_filter.mpr ⟨Finset.mem_univ _, hm_ne⟩
                rw [hne] at hmem
                exact Finset.notMem_empty _ hmem
              obtain ⟨u, hu⟩ := hb_unit
              refine ⟨⟨↑(u⁻¹), ⟨1, Submonoid.one_mem _⟩⟩, ?_⟩
              change z * V.subtype 1 = V.subtype ↑(u⁻¹)
              have huK : z⁻¹ * V.subtype ↑(u⁻¹) = 1 := by
                have hmul : V.subtype (↑u * ↑(u⁻¹)) = 1 := by simp
                rw [map_mul, hu] at hmul
                exact hmul
              calc
                z * V.subtype 1 = z * 1 := by simp
                _ = z * (z⁻¹ * V.subtype ↑(u⁻¹)) := by rw [huK]
                _ = (z * z⁻¹) * V.subtype ↑(u⁻¹) := by ring
                _ = V.subtype ↑(u⁻¹) := by rw [mul_inv_cancel₀ hz0, one_mul]
        · intro x₁ x₂ h
          exact ⟨⟨1, Submonoid.one_mem _⟩, by simp [Subtype.ext h]⟩
    obtain ⟨t₀, ht₀⟩ := hExAway
    exact @AlgebraicGeometry.IsOpenImmersion.of_isLocalization ↥V K _ _ _ t₀ ht₀
  · intro X g_X hSS U hU hUne
    have hInt : AlgebraicGeometry.IsIntegral X := hSS.1
    have : Nonempty U := hUne
    have hDomR : IsDomain ↑(X.presheaf.obj (Opposite.op U)) :=
      @AlgebraicGeometry.IsIntegral.component_integral X hInt U hUne
    refine ⟨hDomR, ?_⟩
    apply IsIntegrallyClosed.of_localization_maximal
    intro p hp_ne hp_max
    have : p.IsPrime := hp_max.isPrime
    let z₀ : AlgebraicGeometry.Spec (X.presheaf.obj (Opposite.op U)) := ⟨p, hp_max.isPrime⟩
    let y : X := hU.fromSpec.base z₀
    have hyU : y ∈ U := by
      change y ∈ (U : Set X)
      rw [← hU.range_fromSpec]
      exact ⟨z₀, rfl⟩
    have hChart_y : ∃ (A₀ : Type u) (_ : CommRing A₀) (_ : IsDomain A₀)
        (_ : IsIntegrallyClosed A₀) (W : X.Opens)
        (e : W.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of A₀)),
        y ∈ W ∧ AlgebraicGeometry.Etale e := by
      rcases hSS.2.2.2.2 y with ⟨W, e, hyW, hEt_e, _⟩ | ⟨W, a, e, hyW, ha, hEt_e, _⟩
      · have hIC_V : IsIntegrallyClosed ↥V := instIsIntegrallyClosedSubtypeMemValuationSubring V
        exact ⟨Polynomial ↥V, inferInstance, inferInstance,
          @instIsIntegrallyClosedPolynomialOfIsDomain ↥V _ _ hIC_V, W, e, hyW, hEt_e⟩
      · obtain ⟨hDom_nod, hIC_nod⟩ :=
          weil_valuationSubring_nodalQuotient_isDomain_and_isIntegrallyClosed K V a ha
        exact ⟨MvPolynomial (Fin 2) ↥V ⧸ Ideal.span
          {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a},
          inferInstance, hDom_nod, hIC_nod, W, e, hyW, hEt_e⟩
    obtain ⟨A₀, instCRA₀, instDomA₀, instICA₀, W, e, hyW, hEt_e⟩ := hChart_y
    let _ : CommRing A₀ := instCRA₀
    let _ : IsDomain A₀ := instDomA₀
    let _ : IsIntegrallyClosed A₀ := instICA₀
    have : AlgebraicGeometry.Etale e := hEt_e
    obtain ⟨f, hfW, hy_bf⟩ :=
      @AlgebraicGeometry.IsAffineOpen.exists_basicOpen_le X U hU W ⟨y, hyW⟩ hyU
    have hf_not_p : f ∉ p := by
      have hz_pre : z₀ ∈ hU.fromSpec ⁻¹ᵁ X.basicOpen f := hy_bf
      rw [hU.fromSpec_preimage_basicOpen f] at hz_pre
      exact hz_pre
    have hf_ne_zero : f ≠ 0 := by
      intro hf0
      exact hf_not_p (hf0 ▸ p.zero_mem)
    let V_f : X.Opens := X.basicOpen f
    have hVf : AlgebraicGeometry.IsAffineOpen V_f := hU.basicOpen f
    have hVf_ne : Nonempty V_f := ⟨⟨y, hy_bf⟩⟩
    let B : Type u := ↑(X.presheaf.obj (Opposite.op V_f))
    have hDomB : IsDomain B :=
      @AlgebraicGeometry.IsIntegral.component_integral X hInt V_f hVf_ne
    have hrange : Set.range hVf.fromSpec.base ⊆ Set.range W.ι.base := by
      rw [hVf.range_fromSpec, Scheme.Opens.range_ι]
      exact hfW
    let j_f : AlgebraicGeometry.Spec (X.presheaf.obj (Opposite.op V_f)) ⟶ W.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift W.ι hVf.fromSpec hrange
    have hj_fac : j_f ≫ W.ι = hVf.fromSpec :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac W.ι hVf.fromSpec hrange
    have : AlgebraicGeometry.IsOpenImmersion (j_f ≫ W.ι) := by
      rw [hj_fac]
      infer_instance
    have : AlgebraicGeometry.IsOpenImmersion j_f :=
      AlgebraicGeometry.IsOpenImmersion.of_comp j_f W.ι
    have : AlgebraicGeometry.Etale (j_f ≫ e) := inferInstance
    let φ_cat : CommRingCat.of A₀ ⟶ X.presheaf.obj (Opposite.op V_f) :=
      AlgebraicGeometry.Spec.preimage (j_f ≫ e)
    have hSpec_φ : AlgebraicGeometry.Spec.map φ_cat = j_f ≫ e :=
      AlgebraicGeometry.Spec.map_preimage (j_f ≫ e)
    have hEt_Spec : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map φ_cat) := by
      rw [hSpec_φ]
      infer_instance
    have hEt_hom : RingHom.Etale φ_cat.hom :=
      AlgebraicGeometry.HasRingHomProperty.Spec_iff.mp hEt_Spec
    have hIC_B : IsIntegrallyClosed B := by
      let _ : Algebra A₀ B := φ_cat.hom.toAlgebra
      have : Algebra.Etale A₀ B := RingHom.Etale.toAlgebra hEt_hom
      exact weil_etale_domain_over_integrallyClosed_isIntegrallyClosed A₀ B
    have hLocB : IsLocalization.Away f B := hU.isLocalization_basicOpen f
    let R : Type u := ↑(X.presheaf.obj (Opposite.op U))
    have hpow_nzd : Submonoid.powers f ≤ nonZeroDivisors R :=
      Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hf_ne_zero)
    have hinj_RB : Function.Injective (algebraMap R B) :=
      IsLocalization.injective B hpow_nzd
    let M_B : Submonoid B := p.primeCompl.map (algebraMap R B)
    have hMB_nzd : M_B ≤ nonZeroDivisors B := by
      rintro _ ⟨s, hs, rfl⟩
      apply mem_nonZeroDivisors_of_ne_zero
      intro hs0
      apply hs
      have h0 : s = 0 := hinj_RB (hs0.trans (map_zero _).symm)
      exact h0 ▸ p.zero_mem
    have hu_f : IsUnit (algebraMap R (Localization.AtPrime p) f) :=
      IsLocalization.map_units (Localization.AtPrime p) (⟨f, hf_not_p⟩ : p.primeCompl)
    let ψ : B →+* Localization.AtPrime p := IsLocalization.Away.lift f hu_f
    have hψ_eq : ∀ r : R, ψ (algebraMap R B r) = algebraMap R (Localization.AtPrime p) r :=
      IsLocalization.Away.lift_eq f hu_f
    have hLoc_p : @IsLocalization B _ M_B (Localization.AtPrime p) _ ψ.toAlgebra := by
      let _ : Algebra B (Localization.AtPrime p) := ψ.toAlgebra
      refine { map_units := ?_, surj := ?_, exists_of_eq := ?_ }
      · rintro ⟨_, s, hs, rfl⟩
        change IsUnit (ψ (algebraMap R B s))
        rw [hψ_eq]
        exact IsLocalization.map_units (Localization.AtPrime p) (⟨s, hs⟩ : p.primeCompl)
      · intro z
        obtain ⟨⟨r, s⟩, hz⟩ := IsLocalization.surj p.primeCompl z
        refine ⟨⟨algebraMap R B r, ⟨algebraMap R B s.1, s.1, s.2, rfl⟩⟩, ?_⟩
        change z * ψ (algebraMap R B s.1) = ψ (algebraMap R B r)
        rw [hψ_eq, hψ_eq]
        exact hz
      · intro b₁ b₂ hψ
        change ψ b₁ = ψ b₂ at hψ
        obtain ⟨⟨r₁, s₁⟩, hb₁⟩ := IsLocalization.surj (Submonoid.powers f) b₁
        obtain ⟨⟨r₂, s₂⟩, hb₂⟩ := IsLocalization.surj (Submonoid.powers f) b₂
        obtain ⟨n₁, hn₁⟩ := s₁.2
        obtain ⟨n₂, hn₂⟩ := s₂.2
        dsimp at hn₁ hn₂
        have hb₁' : b₁ * algebraMap R B (f ^ n₁) = algebraMap R B r₁ := by
          simpa [hn₁] using hb₁
        have hb₂' : b₂ * algebraMap R B (f ^ n₂) = algebraMap R B r₂ := by
          simpa [hn₂] using hb₂
        have hcross_p : algebraMap R (Localization.AtPrime p) (r₁ * f ^ n₂) =
            algebraMap R (Localization.AtPrime p) (r₂ * f ^ n₁) := by
          have h1 := congrArg ψ hb₁'
          have h2 := congrArg ψ hb₂'
          rw [map_mul, hψ_eq, hψ_eq] at h1
          rw [map_mul, hψ_eq, hψ_eq] at h2
          calc
            algebraMap R (Localization.AtPrime p) (r₁ * f ^ n₂)
                = algebraMap R (Localization.AtPrime p) r₁ *
                    algebraMap R (Localization.AtPrime p) (f ^ n₂) := map_mul _ _ _
            _ = (ψ b₁ * algebraMap R (Localization.AtPrime p) (f ^ n₁)) *
                  algebraMap R (Localization.AtPrime p) (f ^ n₂) := by rw [← h1]
            _ = (ψ b₂ * algebraMap R (Localization.AtPrime p) (f ^ n₂)) *
                  algebraMap R (Localization.AtPrime p) (f ^ n₁) := by rw [hψ]; ring
            _ = algebraMap R (Localization.AtPrime p) r₂ *
                  algebraMap R (Localization.AtPrime p) (f ^ n₁) := by rw [h2]
            _ = algebraMap R (Localization.AtPrime p) (r₂ * f ^ n₁) := (map_mul _ _ _).symm
        obtain ⟨t, ht⟩ :=
          (IsLocalization.eq_iff_exists p.primeCompl (Localization.AtPrime p)).mp hcross_p
        refine ⟨⟨algebraMap R B t.1, t.1, t.2, rfl⟩, ?_⟩
        have hu_fn : IsUnit (algebraMap R B (f ^ (n₁ + n₂))) :=
          IsLocalization.map_units B (⟨f ^ (n₁ + n₂), ⟨n₁ + n₂, rfl⟩⟩ : Submonoid.powers f)
        apply hu_fn.mul_right_cancel
        calc
          (algebraMap R B t.1 * b₁) * algebraMap R B (f ^ (n₁ + n₂))
              = algebraMap R B t.1 * (b₁ * algebraMap R B (f ^ n₁)) *
                  algebraMap R B (f ^ n₂) := by rw [pow_add, map_mul]; ring
          _ = algebraMap R B (t.1 * (r₁ * f ^ n₂)) := by
                rw [hb₁', ← map_mul, ← map_mul, mul_assoc]
          _ = algebraMap R B (t.1 * (r₂ * f ^ n₁)) := by rw [ht]
          _ = algebraMap R B t.1 * (b₂ * algebraMap R B (f ^ n₂)) *
                algebraMap R B (f ^ n₁) := by rw [map_mul, map_mul, ← hb₂']; ring
          _ = (algebraMap R B t.1 * b₂) * algebraMap R B (f ^ (n₁ + n₂)) := by
                rw [pow_add, map_mul]; ring
    let _ : Algebra B (Localization.AtPrime p) := ψ.toAlgebra
    have : IsLocalization M_B (Localization.AtPrime p) := hLoc_p
    exact isIntegrallyClosed_of_isLocalization (M := M_B) (S := Localization.AtPrime p) hMB_nzd
  · intro U_ss g_ss hSS
    have hInt : AlgebraicGeometry.IsIntegral U_ss := hSS.1
    have : IrreducibleSpace ↥U_ss := AlgebraicGeometry.irreducibleSpace_of_isIntegral U_ss
    refine ⟨↑U_ss.functionField, inferInstance, U_ss.fromSpecStalk (genericPoint ↥U_ss), ?_⟩
    intro U hU hUne
    have : Nonempty U := hUne
    have hxU : genericPoint ↥U_ss ∈ U := by
      have hne_set : (Set.univ ∩ (U : Set U_ss)).Nonempty := by
        rw [Set.univ_inter]
        exact Set.nonempty_coe_sort.mp hUne
      exact ((genericPoint_spec ↥U_ss).mem_open_set_iff U.isOpen).mpr hne_set
    refine ⟨U_ss.germToFunctionField U,
      @AlgebraicGeometry.functionField_isFractionRing_of_isAffineOpen U_ss hInt U hU hUne, ?_⟩
    change AlgebraicGeometry.Spec.map (U_ss.presheaf.germ U (genericPoint ↥U_ss) hxU) ≫ hU.fromSpec =
      U_ss.fromSpecStalk (genericPoint ↥U_ss)
    rw [← U.fromSpecStalkOfMem_toSpecΓ_assoc (genericPoint ↥U_ss) hxU hU.fromSpec,
      hU.toSpecΓ_fromSpec, U.fromSpecStalkOfMem_ι]

theorem weil_gauss_divisorial_valuation_finiteness_and_trdeg_bound (K : Type u) [Field K]
    (V : ValuationSubring K)
    (F_ss : Type u) [Field F_ss]
    (φ_KF : K →+* F_ss)
    (hEss : letI : Algebra K F_ss := φ_KF.toAlgebra; Algebra.EssFiniteType K F_ss)
    (hTr : letI : Algebra K F_ss := φ_KF.toAlgebra; Algebra.trdeg K F_ss ≤ 1) :
    (∀ (P : Ideal ↥V) [P.IsPrime] (t : F_ss),
      let S_Pt : Set (ValuationSubring F_ss) :=
        {W : ValuationSubring F_ss |
          ∃ (hV : ∀ c : ↥V, φ_KF (V.subtype c) ∈ W) (ht : t ∈ W),
            (∀ c : ↥V,
              ((⟨φ_KF (V.subtype c), hV c⟩ : ↥W) ∈ IsLocalRing.maximalIdeal ↥W ↔ c ∈ P)) ∧
            (∀ Q : Polynomial ↥V,
              (∃ i : ℕ, Q.coeff i ∉ P) →
              Polynomial.eval₂ ((φ_KF.comp V.subtype).codRestrict W.toSubring hV) ⟨t, ht⟩ Q ∉
                IsLocalRing.maximalIdeal ↥W)}
      S_Pt.Finite ∧ (∀ W₁ ∈ S_Pt, ∀ W₂ ∈ S_Pt, W₁ ≤ W₂ → W₁ = W₂)) ∧
    (∀ (W : ValuationSubring F_ss)
        (hV : ∀ c : ↥V, φ_KF (V.subtype c) ∈ W)
        (P : Ideal ↥V) [P.IsPrime],
      (∀ c : ↥V,
        ((⟨φ_KF (V.subtype c), hV c⟩ : ↥W) ∈ IsLocalRing.maximalIdeal ↥W ↔ c ∈ P)) →
      ¬ ∃ (t₁ t₂ : ↥W),
        ∀ (Q : MvPolynomial (Fin 2) ↥V),
          (∃ d : Fin 2 →₀ ℕ, Q.coeff d ∉ P) →
          MvPolynomial.eval₂ ((φ_KF.comp V.subtype).codRestrict W.toSubring hV) ![t₁, t₂] Q ∉
            IsLocalRing.maximalIdeal ↥W) :=
by
  let _ : Algebra K F_ss := φ_KF.toAlgebra
  have hAlgMap_eq : algebraMap K F_ss = φ_KF := rfl
  have hValDivMem : ∀ {L₀ : Type u} [Field L₀] (U₀ : ValuationSubring L₀) (x y : L₀),
      y ≠ 0 → U₀.valuation x ≤ U₀.valuation y → x / y ∈ U₀ := by
    intro L₀ _ U₀ x y hy hle
    rw [← ValuationSubring.valuation_le_one_iff]
    by_contra hnot
    rw [not_le] at hnot
    have hy_pos : 0 < U₀.valuation y := (Valuation.pos_iff U₀.valuation).mpr hy
    have hlt : 1 * U₀.valuation y < U₀.valuation (x / y) * U₀.valuation y :=
      mul_lt_mul_of_pos_right hnot hy_pos
    rw [one_mul, ← map_mul, div_mul_cancel₀ x hy] at hlt
    exact not_le_of_gt hlt hle
  
  have hClear : ∀ (P : Ideal ↥V) [P.IsPrime] {ι : Type} [DecidableEq ι]
      (S : Finset ι) (hS : S.Nonempty) (c : ι → K) (hc : ∀ i ∈ S, c i ≠ 0),
      ∃ (i₀ : ι) (s₀ : ↥V) (b : ι → ↥V),
        i₀ ∈ S ∧ s₀ ∉ P ∧ b i₀ = s₀ ∧
        (∀ i ∈ S, c i₀ * V.subtype (b i) = V.subtype s₀ * c i) := by
    intro P _ ι _ S hS c hc
    let V_P : ValuationSubring K := V.ofPrime P
    let _ : IsLocalization.AtPrime ↥V_P P := ValuationSubring.ofPrime_localization V P
    obtain ⟨i₀, hi₀S, hi₀_max⟩ :=
      Finset.exists_max_image S (fun i => V_P.valuation (c i)) hS
    have hc₀ : c i₀ ≠ 0 := hc i₀ hi₀S
    have hd_mem : ∀ i : ι, (if i ∈ S then c i / c i₀ else 0) ∈ V_P := by
      intro i
      split_ifs with hi
      · exact hValDivMem V_P (c i) (c i₀) hc₀ (hi₀_max i hi)
      · exact V_P.zero_mem
    let d : ι → ↥V_P := fun i => ⟨if i ∈ S then c i / c i₀ else 0, hd_mem i⟩
    have hsurj : ∀ i : ι, ∃ p : ↥V × P.primeCompl,
        d i * algebraMap ↥V ↥V_P p.2.1 = algebraMap ↥V ↥V_P p.1 :=
      fun i => IsLocalization.surj P.primeCompl (d i)
    choose p hp using hsurj
    let a : ι → ↥V := fun i => (p i).1
    let s : ι → P.primeCompl := fun i => (p i).2
    have hp_K : ∀ i : ι, (d i : K) * V.subtype (s i).1 = V.subtype (a i) := by
      intro i
      have h1 := congrArg V_P.subtype (hp i)
      rw [map_mul] at h1
      exact h1
    have hai₀ : a i₀ = (s i₀).1 := by
      apply Subtype.ext
      have h1 := hp_K i₀
      have hd₀ : (d i₀ : K) = 1 := by
        change (if i₀ ∈ S then c i₀ / c i₀ else 0) = 1
        simp only [hi₀S, ↓reduceIte, div_self hc₀]
      rw [hd₀, one_mul] at h1
      exact h1.symm
    let s_prod : P.primeCompl := ∏ j ∈ S, s j
    let s₀ : ↥V := s_prod.1
    have hs₀_notMem : s₀ ∉ P := s_prod.2
    have hs₀_eq : s₀ = ∏ j ∈ S, (s j).1 := Submonoid.coe_finsetProd P.primeCompl s S
    let b : ι → ↥V := fun i => if i ∈ S then a i * ∏ j ∈ S.erase i, (s j).1 else 0
    refine ⟨i₀, s₀, b, hi₀S, hs₀_notMem, ?_, ?_⟩
    · dsimp only [b]
      simp only [hi₀S, ↓reduceIte]
      rw [hai₀, Finset.mul_prod_erase S (fun j => (s j).1) hi₀S, hs₀_eq]
    · intro i hi
      dsimp only [b]
      simp only [hi, ↓reduceIte]
      rw [map_mul, map_prod, ← hp_K i]
      have hdi : (d i : K) = c i / c i₀ := by
        change (if i ∈ S then c i / c i₀ else 0) = c i / c i₀
        simp only [hi, ↓reduceIte]
      rw [hdi, mul_assoc, Finset.mul_prod_erase S (fun j => V.subtype (s j).1) hi]
      have hs₀_K : V.subtype s₀ = ∏ j ∈ S, V.subtype (s j).1 := by
        rw [hs₀_eq, map_prod]
      rw [← hs₀_K, ← mul_assoc, mul_div_cancel₀ _ hc₀, mul_comm]
  
  have hKrullPrufer : ∀ (L E : Type u) [Field L] [Field E] [Algebra L E] [FiniteDimensional L E]
      (V₀ : ValuationSubring L),
      let S_ext : Set (ValuationSubring E) :=
        {W : ValuationSubring E | W.comap (algebraMap L E) = V₀}
      S_ext.Finite ∧ (∀ W₁ ∈ S_ext, ∀ W₂ ∈ S_ext, W₁ ≤ W₂ → W₁ = W₂) := by
    intro L E _ _ _ _ V₀ S_ext
    let _ : Algebra ↥V₀ E := ((algebraMap L E).comp V₀.subtype).toAlgebra
    let _ : IsScalarTower ↥V₀ L E := IsScalarTower.of_algebraMap_eq' rfl
    let A : Subalgebra ↥V₀ E := integralClosure ↥V₀ E
    let j_W : ∀ W : ValuationSubring E, W ∈ S_ext → (↥V₀ →+* ↥W) := fun W hW =>
      { toFun := fun c => ⟨algebraMap L E c.1, by
          rw [← ValuationSubring.mem_comap, hW]; exact c.2⟩
        map_one' := Subtype.ext (map_one (algebraMap L E))
        map_mul' := fun x y => Subtype.ext (map_mul (algebraMap L E) x.1 y.1)
        map_zero' := Subtype.ext (map_zero (algebraMap L E))
        map_add' := fun x y => Subtype.ext (map_add (algebraMap L E) x.1 y.1) }
    have hj_max : ∀ (W : ValuationSubring E) (hW : W ∈ S_ext) (c : ↥V₀),
        j_W W hW c ∈ IsLocalRing.maximalIdeal ↥W ↔ c ∈ IsLocalRing.maximalIdeal ↥V₀ := by
      intro W hW c
      rw [IsLocalRing.mem_maximalIdeal, IsLocalRing.mem_maximalIdeal,
        mem_nonunits_iff, mem_nonunits_iff, not_iff_not]
      constructor
      · rintro ⟨u, hu⟩
        have hc0 : c.1 ≠ 0 := by
          intro h0
          have hu0 : (u : ↥W) = 0 := by
            rw [hu]
            exact Subtype.ext (by simp [j_W, h0])
          exact not_isUnit_zero (hu0 ▸ u.isUnit)
        have hinv_W : algebraMap L E c.1⁻¹ ∈ W := by
          rw [map_inv₀]
          have hmul : (algebraMap L E c.1) * ((↑(u⁻¹) : ↥W) : E) = 1 := by
            have := congrArg Subtype.val u.mul_inv
            simpa [hu, j_W] using this
          have heq : (algebraMap L E c.1)⁻¹ = ((↑(u⁻¹) : ↥W) : E) :=
            inv_eq_of_mul_eq_one_right hmul
          rw [heq]
          exact (↑(u⁻¹) : ↥W).2
        have hinv_V₀ : c.1⁻¹ ∈ V₀ := by
          have hmem : c.1⁻¹ ∈ W.comap (algebraMap L E) := hinv_W
          rwa [hW] at hmem
        exact IsUnit.of_mul_eq_one ⟨c.1⁻¹, hinv_V₀⟩ (Subtype.ext (mul_inv_cancel₀ hc0))
      · exact fun h => h.map (j_W W hW)
    have hA_mem : ∀ (W : ValuationSubring E) (hW : W ∈ S_ext) (a : ↥A), (a : E) ∈ W := by
      intro W hW a
      obtain ⟨P, hPm, hPe⟩ := a.2
      have haW : IsIntegral ↥W (a : E) :=
        ⟨P.map (j_W W hW), hPm.map (j_W W hW), by
          rw [Polynomial.eval₂_map]
          exact hPe⟩
      obtain ⟨w, hw⟩ := IsIntegrallyClosed.isIntegral_iff.mp haW
      exact hw ▸ w.2
    let ι_W : ∀ (W : ValuationSubring E), W ∈ S_ext → (↥A →+* ↥W) := fun W hW =>
      { toFun := fun a => ⟨(a : E), hA_mem W hW a⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    let q_W : ∀ (W : ValuationSubring E), W ∈ S_ext → Ideal ↥A := fun W hW =>
      Ideal.comap (ι_W W hW) (IsLocalRing.maximalIdeal ↥W)
    have hq_max : ∀ (W : ValuationSubring E) (hW : W ∈ S_ext), (q_W W hW).IsMaximal := by
      intro W hW
      have hPrime : (q_W W hW).IsPrime := Ideal.IsPrime.comap (ι_W W hW)
      have hUnder : Ideal.under ↥V₀ (q_W W hW) = IsLocalRing.maximalIdeal ↥V₀ := by
        ext c
        exact hj_max W hW c
      have hMaxUnder : (Ideal.under ↥V₀ (q_W W hW)).IsMaximal := by
        rw [hUnder]
        exact IsLocalRing.maximalIdeal.isMaximal ↥V₀
      exact Ideal.IsIntegral.isMaximal_of_isMaximal_under (q_W W hW) hMaxUnder
    
    have hSep : ∀ (W₁ : ValuationSubring E) (hW₁ : W₁ ∈ S_ext)
        (W₂ : ValuationSubring E) (hW₂ : W₂ ∈ S_ext),
        q_W W₂ hW₂ ≤ q_W W₁ hW₁ → W₁ ≤ W₂ := by
      intro W₁ hW₁ W₂ hW₂ hq_le x hx₁
      by_cases hx0 : x = 0
      · exact hx0 ▸ W₂.zero_mem
      have hx_int : IsIntegral L x := Algebra.IsIntegral.isIntegral x
      obtain ⟨P, hP_monic, hP_eval⟩ := hx_int
      let n : ℕ := P.natDegree
      have hn_pos : 1 ≤ n := by
        by_contra hn0
        have h0 : P.natDegree = 0 := by omega
        have hP1 : P = 1 := Polynomial.eq_one_of_monic_natDegree_zero hP_monic h0
        rw [hP1, Polynomial.eval₂_one] at hP_eval
        exact one_ne_zero hP_eval
      have hPsupp : P.support.Nonempty := Polynomial.support_nonempty.mpr hP_monic.ne_zero
      obtain ⟨i₀, hi₀_supp, hi₀_max⟩ :=
        Finset.exists_max_image P.support (fun i => V₀.valuation (P.coeff i)) hPsupp
      have hc₀ : P.coeff i₀ ≠ 0 := Polynomial.mem_support_iff.mp hi₀_supp
      have hi₀_le : i₀ ≤ n := Polynomial.le_natDegree_of_mem_supp i₀ hi₀_supp
      have ha_mem : ∀ i : ℕ, P.coeff i / P.coeff i₀ ∈ V₀ := by
        intro i
        by_cases hi : i ∈ P.support
        · exact hValDivMem V₀ (P.coeff i) (P.coeff i₀) hc₀ (hi₀_max i hi)
        · have hci : P.coeff i = 0 := Polynomial.notMem_support_iff.mp hi
          rw [hci, zero_div]
          exact V₀.zero_mem
      let a : ℕ → ↥V₀ := fun i => ⟨P.coeff i / P.coeff i₀, ha_mem i⟩
      have hai₀ : a i₀ = 1 := Subtype.ext (div_self hc₀)
      have hSum0 : ∑ i ∈ Finset.range (n + 1), algebraMap L E (a i).1 * x ^ i = 0 := by
        have hP_sum : ∑ i ∈ Finset.range (n + 1), algebraMap L E (P.coeff i) * x ^ i = 0 := by
          rw [← Polynomial.eval₂_eq_sum_range]
          exact hP_eval
        calc ∑ i ∈ Finset.range (n + 1), algebraMap L E (a i).1 * x ^ i
            = ∑ i ∈ Finset.range (n + 1),
                (algebraMap L E (P.coeff i₀))⁻¹ * (algebraMap L E (P.coeff i) * x ^ i) := by
              refine Finset.sum_congr rfl fun i _ => ?_
              change algebraMap L E (P.coeff i / P.coeff i₀) * x ^ i = _
              rw [div_eq_inv_mul, map_mul, map_inv₀, mul_assoc]
          _ = (algebraMap L E (P.coeff i₀))⁻¹ *
                ∑ i ∈ Finset.range (n + 1), algebraMap L E (P.coeff i) * x ^ i := by
              rw [← Finset.mul_sum]
          _ = 0 := by rw [hP_sum, mul_zero]
      classical
      let U_unit : Finset ℕ :=
        (Finset.range (n + 1)).filter (fun i => a i ∉ IsLocalRing.maximalIdeal ↥V₀)
      have hi₀_unit : i₀ ∈ U_unit := by
        rw [Finset.mem_filter, Finset.mem_range]
        refine ⟨Nat.lt_succ_of_le hi₀_le, ?_⟩
        rw [hai₀]
        exact (IsLocalRing.maximalIdeal.isMaximal ↥V₀).ne_top ∘
          (Ideal.eq_top_iff_one _).mpr
      have hU_ne : U_unit.Nonempty := ⟨i₀, hi₀_unit⟩
      let m : ℕ := U_unit.max' hU_ne
      have hm_mem : m ∈ U_unit := Finset.max'_mem U_unit hU_ne
      have hm_le : m ≤ n :=
        Nat.lt_succ_iff.mp (Finset.mem_range.mp (Finset.mem_filter.mp hm_mem).1)
      have ham_notMem : a m ∉ IsLocalRing.maximalIdeal ↥V₀ := (Finset.mem_filter.mp hm_mem).2
      have ha_gt : ∀ j : ℕ, m < j → j ≤ n → a j ∈ IsLocalRing.maximalIdeal ↥V₀ := by
        intro j hmj hjn
        by_contra haj
        have hj_mem : j ∈ U_unit :=
          Finset.mem_filter.mpr ⟨Finset.mem_range.mpr (Nat.lt_succ_of_le hjn), haj⟩
        have hj_le : j ≤ m := Finset.le_max' U_unit j hj_mem
        omega
      have hm_pos : 1 ≤ m := by
        by_contra hm0
        have hm_eq0 : m = 0 := by omega
        let x₁ : ↥W₁ := ⟨x, hx₁⟩
        have hW₁_sum : ∑ i ∈ Finset.range (n + 1), j_W W₁ hW₁ (a i) * x₁ ^ i = 0 := by
          have hinj : Function.Injective W₁.subtype := Subtype.val_injective
          apply hinj
          simp only [map_sum, map_mul, map_pow, map_zero]
          exact hSum0
        rw [Finset.sum_range_succ'] at hW₁_sum
        have htail_mem : (∑ k ∈ Finset.range n, j_W W₁ hW₁ (a (k + 1)) * x₁ ^ (k + 1)) ∈
            IsLocalRing.maximalIdeal ↥W₁ := by
          refine Ideal.sum_mem _ fun k hk => ?_
          have hk_lt : k < n := Finset.mem_range.mp hk
          have ha_k1 : a (k + 1) ∈ IsLocalRing.maximalIdeal ↥V₀ :=
            ha_gt (k + 1) (by omega) (by omega)
          exact Ideal.mul_mem_right _ _ ((hj_max W₁ hW₁ (a (k + 1))).mpr ha_k1)
        have ha0_W₁ : j_W W₁ hW₁ (a 0) ∈ IsLocalRing.maximalIdeal ↥W₁ := by
          rw [pow_zero, mul_one] at hW₁_sum
          have heq : j_W W₁ hW₁ (a 0) =
              -(∑ k ∈ Finset.range n, j_W W₁ hW₁ (a (k + 1)) * x₁ ^ (k + 1)) :=
            eq_neg_of_add_eq_zero_right hW₁_sum
          rw [heq]
          exact Submodule.neg_mem _ htail_mem
        have ha0_V₀ : a 0 ∈ IsLocalRing.maximalIdeal ↥V₀ := (hj_max W₁ hW₁ (a 0)).mp ha0_W₁
        exact ham_notMem (hm_eq0 ▸ ha0_V₀)
      let y : E := ∑ t ∈ Finset.range (n + 1 - m), algebraMap L E (a (m + t)).1 * x ^ t
      have hym_eq : y * x ^ m = -∑ i ∈ Finset.range m, algebraMap L E (a i).1 * x ^ i := by
        have hsplit : (∑ i ∈ Finset.range m, algebraMap L E (a i).1 * x ^ i) + y * x ^ m = 0 := by
          have hy_mul : y * x ^ m =
              ∑ t ∈ Finset.range (n + 1 - m), algebraMap L E (a (m + t)).1 * x ^ (m + t) := by
            rw [Finset.sum_mul]
            refine Finset.sum_congr rfl fun t _ => ?_
            rw [mul_assoc, ← pow_add, add_comm t m]
          rw [hy_mul, ← Finset.sum_range_add, Nat.add_sub_of_le (by omega : m ≤ n + 1)]
          exact hSum0
        exact eq_neg_of_add_eq_zero_right hsplit
      
      let N : Submodule ↥V₀ E :=
        Submodule.span ↥V₀ (↑((Finset.range n).image (fun k : ℕ => x ^ k)) : Set E)
      have hpow_mem : ∀ k : ℕ, k < n → x ^ k ∈ N := by
        intro k hk
        exact Submodule.subset_span
          (Finset.mem_coe.mpr (Finset.mem_image.mpr ⟨k, Finset.mem_range.mpr hk, rfl⟩))
      have hN_ne_bot : N ≠ ⊥ := by
        intro hbot
        have h1_mem : (1 : E) ∈ N := by simpa using hpow_mem 0 (by omega)
        rw [hbot, Submodule.mem_bot] at h1_mem
        exact one_ne_zero h1_mem
      have hN_fg : N.FG := Submodule.fg_span (Finset.finite_toSet _)
      have hy_stab : ∀ z ∈ N, y • z ∈ N := by
        have hle : N ≤ N.comap (LinearMap.mulLeft ↥V₀ y) := by
          rw [Submodule.span_le]
          intro z hz
          obtain ⟨k, hk_mem, rfl⟩ := Finset.mem_image.mp (Finset.mem_coe.mp hz)
          have hk : k < n := Finset.mem_range.mp hk_mem
          rw [SetLike.mem_coe, Submodule.mem_comap, LinearMap.mulLeft_apply]
          by_cases hkm : k < m
          · dsimp only [y]
            rw [Finset.sum_mul]
            refine Submodule.sum_mem N fun t ht => ?_
            have ht_lt : t < n + 1 - m := Finset.mem_range.mp ht
            have heq : algebraMap L E (a (m + t)).1 * x ^ t * x ^ k =
                (a (m + t)) • x ^ (t + k) := by
              rw [mul_assoc, ← pow_add]
              rfl
            rw [heq]
            exact Submodule.smul_mem N _ (hpow_mem (t + k) (by omega))
          · have hmk : m ≤ k := by omega
            have hx_split : x ^ k = x ^ m * x ^ (k - m) := by
              rw [← pow_add, Nat.add_sub_of_le hmk]
            rw [hx_split, ← mul_assoc, hym_eq, neg_mul, Finset.sum_mul]
            refine Submodule.neg_mem N (Submodule.sum_mem N fun i hi => ?_)
            have hi_lt : i < m := Finset.mem_range.mp hi
            have heq : algebraMap L E (a i).1 * x ^ i * x ^ (k - m) =
                (a i) • x ^ (i + (k - m)) := by
              rw [mul_assoc, ← pow_add]
              rfl
            rw [heq]
            exact Submodule.smul_mem N _ (hpow_mem (i + (k - m)) (by omega))
        intro z hz
        have hmem := hle hz
        rw [Submodule.mem_comap, LinearMap.mulLeft_apply] at hmem
        simpa only [smul_eq_mul] using hmem
      have hy_int : IsIntegral ↥V₀ y :=
        isIntegral_of_smul_mem_submodule N hN_ne_bot hN_fg y hy_stab
      let y_A : ↥A := ⟨y, hy_int⟩
      have hy_not_q1 : y_A ∉ q_W W₁ hW₁ := by
        intro hy_mem
        let x₁ : ↥W₁ := ⟨x, hx₁⟩
        have hn_sub : n + 1 - m = (n - m) + 1 := by omega
        have hy_W₁ : ι_W W₁ hW₁ y_A =
            (∑ s ∈ Finset.range (n - m), j_W W₁ hW₁ (a (m + (s + 1))) * x₁ ^ (s + 1)) +
              j_W W₁ hW₁ (a m) := by
          have hinj : Function.Injective W₁.subtype := Subtype.val_injective
          apply hinj
          simp only [map_add, map_sum, map_mul, map_pow]
          change y = _
          dsimp only [y]
          rw [hn_sub, Finset.sum_range_succ']
          simp only [add_zero, pow_zero, mul_one]
          rfl
        have hhi_mem : (∑ s ∈ Finset.range (n - m),
            j_W W₁ hW₁ (a (m + (s + 1))) * x₁ ^ (s + 1)) ∈ IsLocalRing.maximalIdeal ↥W₁ := by
          refine Ideal.sum_mem _ fun s hs => ?_
          have hs_lt : s < n - m := Finset.mem_range.mp hs
          have ha_s : a (m + (s + 1)) ∈ IsLocalRing.maximalIdeal ↥V₀ :=
            ha_gt (m + (s + 1)) (by omega) (by omega)
          exact Ideal.mul_mem_right _ _ ((hj_max W₁ hW₁ _).mpr ha_s)
        have ham_W₁ : j_W W₁ hW₁ (a m) ∈ IsLocalRing.maximalIdeal ↥W₁ := by
          have hmem : ι_W W₁ hW₁ y_A ∈ IsLocalRing.maximalIdeal ↥W₁ := hy_mem
          rw [hy_W₁] at hmem
          have := Ideal.sub_mem _ hmem hhi_mem
          simpa only [add_sub_cancel_left] using this
        exact ham_notMem ((hj_max W₁ hW₁ (a m)).mp ham_W₁)
      have hy_not_q2 : y_A ∉ q_W W₂ hW₂ := fun h => hy_not_q1 (hq_le h)
      by_contra hx₂
      have hx₂_inv : x⁻¹ ∈ W₂ := (ValuationSubring.mem_or_inv_mem W₂ x).resolve_left hx₂
      let x₂_inv : ↥W₂ := ⟨x⁻¹, hx₂_inv⟩
      have hx₂_inv_max : x₂_inv ∈ IsLocalRing.maximalIdeal ↥W₂ := by
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
        rintro ⟨u, hu⟩
        have hmul : x⁻¹ * ((↑(u⁻¹) : ↥W₂) : E) = 1 := by
          have := congrArg Subtype.val u.mul_inv
          simpa [hu, x₂_inv] using this
        have hx_eq : x = ((↑(u⁻¹) : ↥W₂) : E) := by
          apply mul_left_cancel₀ (inv_ne_zero hx0)
          rw [inv_mul_cancel₀ hx0, hmul]
        exact hx₂ (hx_eq ▸ (↑(u⁻¹) : ↥W₂).2)
      have hy_W₂ : ι_W W₂ hW₂ y_A =
          -∑ i ∈ Finset.range m, j_W W₂ hW₂ (a i) * x₂_inv ^ (m - i) := by
        have hinj : Function.Injective W₂.subtype := Subtype.val_injective
        apply hinj
        simp only [map_neg, map_sum, map_mul, map_pow]
        have hmul := congrArg (· * (x⁻¹) ^ m) hym_eq
        have hlhs : y * x ^ m * (x⁻¹) ^ m = y := by
          rw [mul_assoc, ← mul_pow, mul_inv_cancel₀ hx0, one_pow, mul_one]
        rw [hlhs, neg_mul, Finset.sum_mul] at hmul
