          have : ∀ (J : Finset ℤ), (∀ j ∈ J, ‖term j‖ < ‖term k‖) → ‖∑ j ∈ J, term j‖ < ‖term k‖ := by
            intro J
            induction J using Finset.induction_on with
            | empty => intro _; simpa using htk_pos
            | @insert j J hj ih =>
              intro hJ
              rw [Finset.sum_insert hj]
              exact lt_of_le_of_lt (IsUltrametricDist.norm_add_le_max _ _)
                (max_lt (hJ j (Finset.mem_insert_self j J))
                  (ih (fun m hm => hJ m (Finset.mem_insert_of_mem hm))))
          exact this (I.erase k) hrest_lt
