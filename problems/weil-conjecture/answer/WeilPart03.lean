    intro B _ s c π hs A u C₀ u_tilde s₀ C₁ t₁ C₀₁ Au Aπ
    let u_s : Bˣ := hs.unit
    have hu_s : (u_s : B) = s := IsUnit.unit_spec hs
    let s_inv : B := ↑u_s⁻¹
    have hs_mul_inv : s * s_inv = 1 := by dsimp only [s_inv]; rw [← hu_s, Units.mul_inv]
    have hinv_mul_s : s_inv * s = 1 := by dsimp only [s_inv]; rw [← hu_s, Units.inv_mul]
    let I₀ : Ideal (MvPolynomial (Fin 2) B) :=
