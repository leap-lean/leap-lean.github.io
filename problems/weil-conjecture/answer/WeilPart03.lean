      · rfl
      · apply le_antisymm
        · rw [IntermediateField.adjoin_le_iff, Set.singleton_subset_iff]
          exact L0.inv_mem (IntermediateField.mem_adjoin_simple_self E z_sep)
        · rw [IntermediateField.adjoin_le_iff, Set.singleton_subset_iff]
          simpa using (IntermediateField.adjoin E ({z_sep⁻¹} : Set L)).inv_mem
            (IntermediateField.mem_adjoin_simple_self E z_sep⁻¹)
    have hL₁_eq : L₁ = Lu₀ := by
      apply le_antisymm
      · rw [IntermediateField.adjoin_le_iff, Set.singleton_subset_iff]
        exact Lu₀.sub_mem (IntermediateField.mem_adjoin_simple_self E u₀)
          (Lu₀.algebraMap_mem c₀)
      · rw [IntermediateField.adjoin_le_iff, Set.singleton_subset_iff]
        have hu₀_sum : u₀ = u₁ + algebraMap E L c₀ := by dsimp [u₁]; ring
        rw [hu₀_sum]
        exact L₁.add_mem (IntermediateField.mem_adjoin_simple_self E u₁)
          (L₁.algebraMap_mem c₀)
    have hL₁_L0 : L₁ = L0 := hL₁_eq.trans hLu₀_eq
    have hu₁_not : u₁ ∉ Set.range (algebraMap E L) := by
      rintro ⟨a, ha⟩
      have hL₁_bot : L₁ ≤ ⊥ := by
        rw [IntermediateField.adjoin_le_iff, Set.singleton_subset_iff, ← ha]
        exact IntermediateField.algebraMap_mem ⊥ a
      have hz_bot : z_sep ∈ (⊥ : IntermediateField E L) := by
        apply hL₁_bot
        rw [hL₁_L0]
        exact IntermediateField.mem_adjoin_simple_self E z_sep
      obtain ⟨b, hb⟩ := IntermediateField.mem_bot.mp hz_bot
      exact hTr_sep (hb ▸ isAlgebraic_algebraMap b)
    obtain ⟨hTr_u₁, hFin_u₁⟩ := hSwap u₁ hu₁_not
    let e_10 : ↥L0 ≃+* ↥L₁ :=
      { toFun := fun a => ⟨(a : L), by rw [hL₁_L0]; exact a.2⟩
        invFun := fun b => ⟨(b : L), by rw [← hL₁_L0]; exact b.2⟩
        left_inv := fun _ => by ext; rfl
        right_inv := fun _ => by ext; rfl
        map_mul' := fun _ _ => by ext; rfl
        map_add' := fun _ _ => by ext; rfl }
    have hSep_u₁ : Algebra.IsSeparable ↥L₁ L := hTransSep e_10 (fun _ => rfl) hSep_sep
    obtain ⟨hDVR, S_gen, hS_mem, hLoc⟩ :=
      hPillar3 E L u₁ hTr_u₁ ⟨hFin_u₁, hSep_u₁⟩ O hEO hu₁ hu₁_max
    obtain ⟨D, hDu₁, hSepCrit⟩ := hPillar2 E L u₁ hTr_u₁ ⟨hFin_u₁, hSep_u₁⟩
    obtain ⟨π, hπ, hπ_max, hπ_ne, hPrimes, hSpan, hDπ⟩ :=
      hPillar4 E L O hDVR hEO hRes u₁ hu₁ S_gen hS_mem hLoc D hDu₁
    have hπ_not : π ∉ Set.range (algebraMap E L) := by
      rintro ⟨a, rfl⟩
      exact hDπ (D.map_algebraMap a)
    obtain ⟨hTr_π, hFin_π⟩ := hSwap π hπ_not
    exact ⟨π, hπ, hπ_max, hπ_ne, hPrimes, hSpan, hRes, hTr_π, hFin_π, hSepCrit π hDπ hFin_π⟩

theorem weil_minimalPrime_coarsening_and_gauss_residue (k K F : Type u) [Field k] [Field K] [Field F]
    [Algebra k K] [Algebra k F] [Algebra K F] [IsScalarTower k K F]
    (W : ValuationSubring F)
    (hkW : ∀ c : k, algebraMap k F c ∈ W)
    (hFinV : Set.Finite (Set.univ : Set (PrimeSpectrum ↥(W.comap (algebraMap K F)))))
    (hFinW : Set.Finite (Set.univ : Set (PrimeSpectrum ↥W)))
    (hTr1 : ∃ x_sep : F, Transcendental K x_sep ∧
      FiniteDimensional ↥(IntermediateField.adjoin K ({x_sep} : Set F)) F)
    (hBdd : ∀ w : F, ∃ s : K, s ≠ 0 ∧ algebraMap K F s ∈ W ∧ algebraMap K F s * w ∈ W)
    (hV_ne : W.comap (algebraMap K F) ≠ ⊤) :
    ∃ (W₁ : ValuationSubring F) (hWW₁ : W ≤ W₁),
      W₁ ≠ ⊤ ∧
      (∀ P : Ideal ↥W₁, P.IsPrime → P = ⊥ ∨ P = IsLocalRing.maximalIdeal ↥W₁) ∧
      let V₁ : ValuationSubring K := W₁.comap (algebraMap K F)
      V₁ ≠ ⊤ ∧
      (∃ (c₁ : K) (hc₁W₁ : algebraMap K F c₁ ∈ W₁),
        c₁ ≠ 0 ∧ ⟨algebraMap K F c₁, hc₁W₁⟩ ∈ IsLocalRing.maximalIdeal ↥W₁) ∧
      let K₁_res := IsLocalRing.ResidueField ↥V₁
      let F₁_res := IsLocalRing.ResidueField ↥W₁
      ∃ (_ : Algebra k K₁_res) (_ : Algebra k F₁_res)
        (_ : Algebra K₁_res F₁_res) (_ : IsScalarTower k K₁_res F₁_res)
        (W_bar : ValuationSubring F₁_res),
        (∀ (v : K) (hv : v ∈ V₁) (hvF : algebraMap K F v ∈ W₁),
          algebraMap K₁_res F₁_res (IsLocalRing.residue ↥V₁ ⟨v, hv⟩) =
            IsLocalRing.residue ↥W₁ ⟨algebraMap K F v, hvF⟩) ∧
        (∀ c : k, algebraMap k F₁_res c ∈ W_bar) ∧
        Set.Finite (Set.univ : Set (PrimeSpectrum ↥(W_bar.comap (algebraMap K₁_res F₁_res)))) ∧
        Set.Finite (Set.univ : Set (PrimeSpectrum ↥W_bar)) ∧
        Nat.card (PrimeSpectrum ↥(W_bar.comap (algebraMap K₁_res F₁_res))) <
          Nat.card (PrimeSpectrum ↥(W.comap (algebraMap K F))) ∧
        (Set.range (algebraMap K₁_res F₁_res) = Set.univ →
          ∀ (x₀ : F),
            let Lx₀ := IntermediateField.adjoin K ({x₀} : Set F)
            let Vx₀ : ValuationSubring ↥Lx₀ := W.comap Lx₀.val.toRingHom
            let Ax₀ : ValuationSubring ↥Lx₀ := W₁.comap Lx₀.val.toRingHom
            let hVAx₀ : Vx₀.toSubring ≤ Ax₀.toSubring := fun _ hu => hWW₁ hu
            let hWW₁_sub : W.toSubring ≤ W₁.toSubring := fun _ hw => hWW₁ hw
            let φ_Wx₀ : ↥Vx₀ →+* ↥W :=
              ((Lx₀.val.toRingHom.comp Vx₀.subtype).codRestrict W.toSubring (fun y => y.2))
            let q₀ : Ideal ↥Vx₀ := (IsLocalRing.maximalIdeal ↥Ax₀).comap (Subring.inclusion hVAx₀)
            let q' : Ideal ↥W := (IsLocalRing.maximalIdeal ↥W₁).comap (Subring.inclusion hWW₁_sub)
            ∃ (ψ : (↥Vx₀ ⧸ q₀) →+* (↥W ⧸ q')),
              (∀ u : ↥Vx₀, ψ (Ideal.Quotient.mk q₀ u) = Ideal.Quotient.mk q' (φ_Wx₀ u)) ∧
              RingHom.Etale ψ) ∧
        (Set.range (algebraMap K₁_res F₁_res) ≠ Set.univ →
          IsAlgClosed K₁_res →
          (∃ z0_tilde : F₁_res,
            Transcendental K₁_res z0_tilde ∧
            FiniteDimensional ↥(IntermediateField.adjoin K₁_res ({z0_tilde} : Set F₁_res)) F₁_res) ∧
          (IsWeilEtaleTranscendenceParam K₁_res F₁_res W_bar →
            ∃ (x₁ : F),
              x₁ ∈ W ∧
              ∀ (δ : F) (hδ : δ ∈ W₁),
                ⟨δ, hδ⟩ ∈ IsLocalRing.maximalIdeal ↥W₁ →
                (x₁ + δ) ∈ W ∧
                ∀ (hx₀W₁ : x₁ + δ ∈ W₁),
                  let x₀ := x₁ + δ
                  let x_tilde : F₁_res := IsLocalRing.residue ↥W₁ ⟨x₀, hx₀W₁⟩
                  let L_tilde := IntermediateField.adjoin K₁_res ({x_tilde} : Set F₁_res)
                  let Lx₀ := IntermediateField.adjoin K ({x₀} : Set F)
                  let Vx₀ : ValuationSubring ↥Lx₀ := W.comap Lx₀.val.toRingHom
                  let Ax₀ : ValuationSubring ↥Lx₀ := W₁.comap Lx₀.val.toRingHom
                  let hVAx₀ : Vx₀.toSubring ≤ Ax₀.toSubring := fun _ hu => hWW₁ hu
                  let hWW₁_sub : W.toSubring ≤ W₁.toSubring := fun _ hw => hWW₁ hw
                  let φ_Wx₀ : ↥Vx₀ →+* ↥W :=
                    ((Lx₀.val.toRingHom.comp Vx₀.subtype).codRestrict W.toSubring (fun y => y.2))
                  let q₀ : Ideal ↥Vx₀ := (IsLocalRing.maximalIdeal ↥Ax₀).comap (Subring.inclusion hVAx₀)
                  let q' : Ideal ↥W := (IsLocalRing.maximalIdeal ↥W₁).comap (Subring.inclusion hWW₁_sub)
                  Transcendental K₁_res x_tilde ∧
                  Algebra.IsSeparable ↥L_tilde F₁_res ∧
                  ∃ (ψ : (↥Vx₀ ⧸ q₀) →+* (↥W ⧸ q')),
                    (∀ u : ↥Vx₀, ψ (Ideal.Quotient.mk q₀ u) = Ideal.Quotient.mk q' (φ_Wx₀ u)) ∧
                    RingHom.Etale ψ)) :=
by
  classical
  
  have etale_congr : ∀ {R₁ R₂ S₁ S₂ : Type u} [CommRing R₁] [CommRing R₂] [CommRing S₁] [CommRing S₂]
      (eR : R₁ ≃+* R₂) (eS : S₁ ≃+* S₂) (f₁ : R₁ →+* S₁) (f₂ : R₂ →+* S₂),
      (∀ r : R₁, f₂ (eR r) = eS (f₁ r)) → f₁.Etale → f₂.Etale := by
    intro R₁ R₂ S₁ S₂ _ _ _ _ eR eS f₁ f₂ hcomm hf₁
    have heq : f₂ = eS.toRingHom.comp (f₁.comp eR.symm.toRingHom) := by
      ext x
      simp [← hcomm (eR.symm x)]
    rw [heq]
    exact RingHom.Etale.stableUnderComposition _ _
      (RingHom.Etale.stableUnderComposition _ _ (RingHom.Etale.of_bijective eR.symm.bijective) hf₁)
      (RingHom.Etale.of_bijective eS.bijective)
  
  
  
  have hW_ne : W ≠ ⊤ := by
    intro htop
    apply hV_ne
    ext a
    simp [htop]
  let e_W := W.primeSpectrumOrderEquiv
  have hFinSpecW : Finite (PrimeSpectrum ↥W) := Set.finite_univ_iff.mp hFinW
  let _ : Finite (PrimeSpectrum ↥W)ᵒᵈ := hFinSpecW
  have hFinOver : Finite { S : ValuationSubring F // W ≤ S } := Finite.of_equiv _ e_W.toEquiv
  let _ : Fintype { S : ValuationSubring F // W ≤ S } := Fintype.ofFinite _
  have htot_over : ∀ s₁ s₂ : { S : ValuationSubring F // W ≤ S }, s₁ ≤ s₂ ∨ s₂ ≤ s₁ :=
    (ValuationSubring.le_total_ideal W).1
  have finset_max_over : ∀ (T : Finset { S : ValuationSubring F // W ≤ S }),
      T.Nonempty → ∃ m ∈ T, ∀ x ∈ T, x ≤ m := by
    intro T
    induction T using Finset.induction_on with
    | empty => intro hne; exact absurd hne Finset.not_nonempty_empty
    | @insert a T _ ih =>
      intro _
      rcases T.eq_empty_or_nonempty with rfl | hTne
      · exact ⟨a, Finset.mem_singleton_self a, fun x hx => by rw [Finset.mem_singleton.mp hx]⟩
      · obtain ⟨m, hmT, hm⟩ := ih hTne
        rcases htot_over a m with ham | hma
        · refine ⟨m, Finset.mem_insert_of_mem hmT, fun x hx => ?_⟩
          rcases Finset.mem_insert.mp hx with rfl | hxT
          · exact ham
          · exact hm x hxT
        · refine ⟨a, Finset.mem_insert_self a T, fun x hx => ?_⟩
          rcases Finset.mem_insert.mp hx with rfl | hxT
          · exact le_rfl
          · exact le_trans (hm x hxT) hma
  let T_over : Finset { S : ValuationSubring F // W ≤ S } :=
    Finset.univ.filter (fun s => s.1 ≠ ⊤)
  obtain ⟨s_max, hs_mem, hs_max⟩ :=
    finset_max_over T_over ⟨⟨W, le_rfl⟩, by simp [T_over, hW_ne]⟩
  let W₁ : ValuationSubring F := s_max.1
  have hWW₁ : W ≤ W₁ := s_max.2
  have hW₁_ne : W₁ ≠ ⊤ := (Finset.mem_filter.mp hs_mem).2
  have hOver_W₁ : ∀ S' : ValuationSubring F, W₁ ≤ S' → S' = ⊤ ∨ S' = W₁ := by
    intro S' hle
    by_cases hS'_top : S' = ⊤
    · exact Or.inl hS'_top
    · right
      have hmem : (⟨S', le_trans hWW₁ hle⟩ : { S : ValuationSubring F // W ≤ S }) ∈ T_over := by
        simp [T_over, hS'_top]
      have hle' : S' ≤ W₁ := hs_max ⟨S', le_trans hWW₁ hle⟩ hmem
      exact le_antisymm hle' hle
  have hW₁_ht1 : ∀ P : Ideal ↥W₁, P.IsPrime → P = ⊥ ∨ P = IsLocalRing.maximalIdeal ↥W₁ := by
    intro P hP
    let e₁ := W₁.primeSpectrumOrderEquiv
    let q_top : PrimeSpectrum ↥W₁ := OrderDual.ofDual (e₁.symm ⟨⊤, le_top⟩)
    let q_min : PrimeSpectrum ↥W₁ := OrderDual.ofDual (e₁.symm ⟨W₁, le_rfl⟩)
    let p_bot : PrimeSpectrum ↥W₁ := ⟨⊥, inferInstance⟩
    let p_max : PrimeSpectrum ↥W₁ := ⟨IsLocalRing.maximalIdeal ↥W₁, inferInstance⟩
    have hq_top_eq : q_top.asIdeal = ⊥ := by
      have hle_s : e₁ (OrderDual.toDual p_bot) ≤ ⟨⊤, le_top⟩ :=
        show (e₁ (OrderDual.toDual p_bot)).1 ≤ ⊤ from le_top
      have hle_s' : e₁ (OrderDual.toDual p_bot) ≤ e₁ (OrderDual.toDual q_top) := by
        simpa [q_top] using hle_s
      have hle_p : q_top ≤ p_bot := e₁.map_rel_iff.mp hle_s'
      exact le_bot_iff.mp ((PrimeSpectrum.asIdeal_le_asIdeal q_top p_bot).mpr hle_p)
    have hq_min_eq : q_min.asIdeal = IsLocalRing.maximalIdeal ↥W₁ := by
      have hle_s : (⟨W₁, le_rfl⟩ : { S' : ValuationSubring F // W₁ ≤ S' }) ≤
          e₁ (OrderDual.toDual p_max) := (e₁ (OrderDual.toDual p_max)).2
      have hle_s' : e₁ (OrderDual.toDual q_min) ≤ e₁ (OrderDual.toDual p_max) := by
        simpa [q_min] using hle_s
      have hle_p : p_max ≤ q_min := e₁.map_rel_iff.mp hle_s'
      exact le_antisymm (IsLocalRing.le_maximalIdeal q_min.isPrime.ne_top)
        ((PrimeSpectrum.asIdeal_le_asIdeal p_max q_min).mpr hle_p)
    let p : PrimeSpectrum ↥W₁ := ⟨P, hP⟩
    rcases hOver_W₁ (e₁ (OrderDual.toDual p)).1 (e₁ (OrderDual.toDual p)).2 with h1 | h2
    · left
      have heq : e₁ (OrderDual.toDual p) = e₁ (OrderDual.toDual q_top) := by
        simpa [q_top] using Subtype.ext h1
      have hp : p = q_top := OrderDual.toDual.injective (e₁.injective heq)
      exact (congrArg PrimeSpectrum.asIdeal hp).trans hq_top_eq
    · right
      have heq : e₁ (OrderDual.toDual p) = e₁ (OrderDual.toDual q_min) := by
        simpa [q_min] using Subtype.ext h2
      have hp : p = q_min := OrderDual.toDual.injective (e₁.injective heq)
      exact (congrArg PrimeSpectrum.asIdeal hp).trans hq_min_eq
  let V₁ : ValuationSubring K := W₁.comap (algebraMap K F)
  have hV₁_ne : V₁ ≠ ⊤ := by
    intro hV₁_top
    apply hW₁_ne
    ext w
    simp only [ValuationSubring.mem_top, iff_true]
    obtain ⟨s, hs_ne, _, hsw⟩ := hBdd w
    have hsinv : algebraMap K F s⁻¹ ∈ W₁ := by
      change s⁻¹ ∈ V₁
      rw [hV₁_top]; trivial
    have hprod : algebraMap K F s⁻¹ * (algebraMap K F s * w) ∈ W₁ :=
      W₁.toSubring.mul_mem hsinv (hWW₁ hsw)
    have heq : algebraMap K F s⁻¹ * (algebraMap K F s * w) = w := by
      rw [← mul_assoc, ← map_mul, inv_mul_cancel₀ hs_ne, map_one, one_mul]
    rwa [heq] at hprod
  have hEx_y : ∃ y : K, y ∉ V₁ := by
    by_contra hAll
    push Not at hAll
    exact hV₁_ne (by ext y; simp [hAll y])
  obtain ⟨y, hy_not⟩ := hEx_y
  have hy_ne : y ≠ 0 := fun h0 => hy_not (h0 ▸ V₁.zero_mem)
  let c₁ : K := y⁻¹
  have hc₁_ne : c₁ ≠ 0 := inv_ne_zero hy_ne
  have hc₁V₁ : c₁ ∈ V₁ := (V₁.mem_or_inv_mem y).resolve_left hy_not
  have hc₁W₁ : algebraMap K F c₁ ∈ W₁ := hc₁V₁
  have hc₁_max : (⟨algebraMap K F c₁, hc₁W₁⟩ : ↥W₁) ∈ IsLocalRing.maximalIdeal ↥W₁ := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    rintro ⟨u, hu⟩
    have hm : algebraMap K F c₁ * (↑u⁻¹ : ↥W₁).1 = 1 := by
      have h1 : (u.val : ↥W₁).1 * (↑u⁻¹ : ↥W₁).1 = 1 := congrArg Subtype.val u.val_inv
      have h2 : (u.val : ↥W₁).1 = algebraMap K F c₁ := congrArg Subtype.val hu
      rwa [h2] at h1
    have hy_eq : algebraMap K F y = (↑u⁻¹ : ↥W₁).1 := by
      calc algebraMap K F y = algebraMap K F y * (algebraMap K F c₁ * (↑u⁻¹ : ↥W₁).1) := by
            rw [hm, mul_one]
        _ = algebraMap K F (y * c₁) * (↑u⁻¹ : ↥W₁).1 := by rw [← mul_assoc, ← map_mul]
        _ = (↑u⁻¹ : ↥W₁).1 := by rw [mul_inv_cancel₀ hy_ne, map_one, one_mul]
    apply hy_not
    change algebraMap K F y ∈ W₁
    rw [hy_eq]
    exact (↑u⁻¹ : ↥W₁).2
  
  
  
  let K₁_res := IsLocalRing.ResidueField ↥V₁
  let F₁_res := IsLocalRing.ResidueField ↥W₁
  let j_VW : ↥V₁ →+* ↥W₁ :=
    ((algebraMap K F).comp V₁.subtype).codRestrict W₁.toSubring (fun v => v.2)
  have _ : IsLocalHom j_VW := ⟨fun a ha => by
    rcases ha with ⟨u, hu⟩
    have hm : algebraMap K F a.1 * (↑u⁻¹ : ↥W₁).1 = 1 := by
      have h1 : (u.val : ↥W₁).1 * (↑u⁻¹ : ↥W₁).1 = 1 := congrArg Subtype.val u.val_inv
      have h2 : (u.val : ↥W₁).1 = algebraMap K F a.1 := congrArg Subtype.val hu
      rwa [h2] at h1
    have haF_ne : algebraMap K F a.1 ≠ 0 := left_ne_zero_of_mul_eq_one hm
    have ha_ne : a.1 ≠ 0 := fun h0 => haF_ne (by simp [h0])
    have hainv_eq : algebraMap K F a.1⁻¹ = (↑u⁻¹ : ↥W₁).1 := by
      rw [map_inv₀, inv_eq_of_mul_eq_one_right hm]
    have hainv_V₁ : a.1⁻¹ ∈ V₁ := by
      change algebraMap K F a.1⁻¹ ∈ W₁
      rw [hainv_eq]; exact (↑u⁻¹ : ↥W₁).2
    exact ⟨⟨a, ⟨a.1⁻¹, hainv_V₁⟩, Subtype.ext (mul_inv_cancel₀ ha_ne),
      Subtype.ext (inv_mul_cancel₀ ha_ne)⟩, rfl⟩⟩
  let φ_K1F1 : K₁_res →+* F₁_res := IsLocalRing.ResidueField.map j_VW
  have hkV₁ : ∀ c : k, algebraMap k K c ∈ V₁ := by
    intro c
    change algebraMap K F (algebraMap k K c) ∈ W₁
    rw [← IsScalarTower.algebraMap_apply k K F c]
    exact hWW₁ (hkW c)
  let φ_kK1 : k →+* K₁_res :=
    (IsLocalRing.residue ↥V₁).comp ((algebraMap k K).codRestrict V₁.toSubring hkV₁)
  let φ_kF1 : k →+* F₁_res := φ_K1F1.comp φ_kK1
  let instAlgkK1 : Algebra k K₁_res := φ_kK1.toAlgebra
  let instAlgK1F1 : Algebra K₁_res F₁_res := φ_K1F1.toAlgebra
  let instAlgkF1 : Algebra k F₁_res := φ_kF1.toAlgebra
  have instTower1 : IsScalarTower k K₁_res F₁_res :=
    IsScalarTower.of_algebraMap_eq fun _ => rfl
  have hResCompat : ∀ (v : K) (hv : v ∈ V₁) (hvF : algebraMap K F v ∈ W₁),
      algebraMap K₁_res F₁_res (IsLocalRing.residue ↥V₁ ⟨v, hv⟩) =
        IsLocalRing.residue ↥W₁ ⟨algebraMap K F v, hvF⟩ := by
    intro v hv hvF
    change IsLocalRing.ResidueField.map j_VW (IsLocalRing.residue ↥V₁ ⟨v, hv⟩) = _
    rw [IsLocalRing.ResidueField.map_residue]
    rfl
  have hMax_sub_W : ∀ (d : F) (hd : d ∈ W₁),
      (⟨d, hd⟩ : ↥W₁) ∈ IsLocalRing.maximalIdeal ↥W₁ → d ∈ W := by
    intro d hd hd_max
    by_contra hd_notW
    have hd_ne : d ≠ 0 := fun h0 => hd_notW (h0 ▸ W.zero_mem)
    have hd_invW : d⁻¹ ∈ W := (W.mem_or_inv_mem d).resolve_left hd_notW
    have hd_invW₁ : d⁻¹ ∈ W₁ := hWW₁ hd_invW
    have hunit : IsUnit (⟨d, hd⟩ : ↥W₁) :=
      ⟨⟨⟨d, hd⟩, ⟨d⁻¹, hd_invW₁⟩, Subtype.ext (mul_inv_cancel₀ hd_ne),
        Subtype.ext (inv_mul_cancel₀ hd_ne)⟩, rfl⟩
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hd_max
    exact hd_max hunit
  let hWW₁_sub : W.toSubring ≤ W₁.toSubring := fun _ hw => hWW₁ hw
  let ι_WW₁ : ↥W →+* ↥W₁ := Subring.inclusion hWW₁_sub
  let R_bar : Subring F₁_res := ((IsLocalRing.residue ↥W₁).comp ι_WW₁).range
  have hR_bar_val : ∀ z : F₁_res, z ∈ R_bar ∨ z⁻¹ ∈ R_bar := by
    intro z
    by_cases hz0 : z = 0
    · left; subst hz0; exact R_bar.zero_mem
    · obtain ⟨u, rfl⟩ := IsLocalRing.residue_surjective (R := ↥W₁) z
      have hu_not_max : u ∉ IsLocalRing.maximalIdeal ↥W₁ := fun hmem =>
        hz0 ((IsLocalRing.residue_eq_zero_iff u).mpr hmem)
      have hu_unit : IsUnit u := by
        by_contra hnu
        apply hu_not_max
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
        exact hnu
      rcases hu_unit with ⟨u_u, hu_eq⟩
      have hm : u.1 * (↑u_u⁻¹ : ↥W₁).1 = 1 := by
        have h1 : (u_u.val : ↥W₁).1 * (↑u_u⁻¹ : ↥W₁).1 = 1 := congrArg Subtype.val u_u.val_inv
        have h2 : (u_u.val : ↥W₁).1 = u.1 := congrArg Subtype.val hu_eq
        rwa [h2] at h1
      have hu_ne : u.1 ≠ 0 := left_ne_zero_of_mul_eq_one hm
      have hu_inv_eq : u.1⁻¹ = (↑u_u⁻¹ : ↥W₁).1 := inv_eq_of_mul_eq_one_right hm
      have hu_invW₁ : u.1⁻¹ ∈ W₁ := hu_inv_eq ▸ (↑u_u⁻¹ : ↥W₁).2
      rcases W.mem_or_inv_mem u.1 with huW | hu_invW
      · left
        exact ⟨⟨u.1, huW⟩, rfl⟩
      · right
        refine ⟨⟨u.1⁻¹, hu_invW⟩, ?_⟩
        have hres_mul : IsLocalRing.residue ↥W₁ u * IsLocalRing.residue ↥W₁ ⟨u.1⁻¹, hu_invW₁⟩ = 1 := by
          rw [← map_mul]
          have hmul1 : u * ⟨u.1⁻¹, hu_invW₁⟩ = 1 := Subtype.ext (mul_inv_cancel₀ hu_ne)
          rw [hmul1, map_one]
        exact (inv_eq_of_mul_eq_one_right hres_mul).symm
  let W_bar : ValuationSubring F₁_res := ValuationSubring.ofSubring R_bar hR_bar_val
  have hW_iff : ∀ (w : F) (hw : w ∈ W₁), w ∈ W ↔ IsLocalRing.residue ↥W₁ ⟨w, hw⟩ ∈ W_bar := by
    intro w hw
    rw [ValuationSubring.mem_ofSubring]
    constructor
    · intro hwW
      exact ⟨⟨w, hwW⟩, rfl⟩
    · rintro ⟨w₀, hw₀_eq⟩
      have hsub_res : IsLocalRing.residue ↥W₁ (⟨w, hw⟩ - ι_WW₁ w₀) = 0 := by
        rw [map_sub, sub_eq_zero]
        exact hw₀_eq.symm
      have hsub_max : ⟨w - w₀.1, W₁.toSubring.sub_mem hw (hWW₁ w₀.2)⟩ ∈ IsLocalRing.maximalIdeal ↥W₁ :=
        (IsLocalRing.residue_eq_zero_iff _).mp hsub_res
      have hsub_W : w - w₀.1 ∈ W := hMax_sub_W _ _ hsub_max
      have hsum : (w - w₀.1) + w₀.1 ∈ W := W.toSubring.add_mem hsub_W w₀.2
      simpa using hsum
  have hkW_bar : ∀ c : k, algebraMap k F₁_res c ∈ W_bar := by
    intro c
    have heq : algebraMap k F₁_res c =
        IsLocalRing.residue ↥W₁ ⟨algebraMap k F c, hWW₁ (hkW c)⟩ := by
      change algebraMap K₁_res F₁_res (IsLocalRing.residue ↥V₁ ⟨algebraMap k K c, hkV₁ c⟩) = _
      rw [hResCompat (algebraMap k K c) (hkV₁ c) (by
        rw [← IsScalarTower.algebraMap_apply k K F c]; exact hWW₁ (hkW c))]
      congr 1
      ext
      exact (IsScalarTower.algebraMap_apply k K F c).symm
    rw [heq]
    exact (hW_iff _ _).mp (hkW c)
  let V : ValuationSubring K := W.comap (algebraMap K F)
  let V_bar : ValuationSubring K₁_res := W_bar.comap (algebraMap K₁_res F₁_res)
  let π_W : ↥W →+* ↥W_bar :=
    ((IsLocalRing.residue ↥W₁).comp ι_WW₁).codRestrict W_bar.toSubring
      (fun w => (hW_iff w.1 (hWW₁ w.2)).mp w.2)
  have hπ_W_surj : Function.Surjective π_W := by
    rintro ⟨z, hz⟩
    obtain ⟨⟨w, hwW₁⟩, rfl⟩ := IsLocalRing.residue_surjective (R := ↥W₁) z
    have hwW : w ∈ W := (hW_iff w hwW₁).mpr hz
    exact ⟨⟨w, hwW⟩, by ext; rfl⟩
  have hFinW_bar : Set.Finite (Set.univ : Set (PrimeSpectrum ↥W_bar)) := by
    have _ : Finite (PrimeSpectrum ↥W_bar) :=
      Finite.of_injective (PrimeSpectrum.comap π_W)
        (PrimeSpectrum.comap_injective_of_surjective π_W hπ_W_surj)
    exact Set.finite_univ
  let hVV₁_sub : V.toSubring ≤ V₁.toSubring := fun _ hv => hWW₁ hv
  let ι_VV₁ : ↥V →+* ↥V₁ := Subring.inclusion hVV₁_sub
  let π_V : ↥V →+* ↥V_bar :=
    ((IsLocalRing.residue ↥V₁).comp ι_VV₁).codRestrict V_bar.toSubring (fun v => by
      change algebraMap K₁_res F₁_res (IsLocalRing.residue ↥V₁ ⟨v.1, hWW₁ v.2⟩) ∈ W_bar
      rw [hResCompat v.1 (hWW₁ v.2) (hWW₁ v.2)]
      exact (hW_iff _ _).mp v.2)
  have hπ_V_surj : Function.Surjective π_V := by
    rintro ⟨z, hz⟩
    obtain ⟨⟨v, hvV₁⟩, rfl⟩ := IsLocalRing.residue_surjective (R := ↥V₁) z
    change algebraMap K₁_res F₁_res (IsLocalRing.residue ↥V₁ ⟨v, hvV₁⟩) ∈ W_bar at hz
    rw [hResCompat v hvV₁ hvV₁] at hz
    have hvV : v ∈ V := (hW_iff _ hvV₁).mpr hz
    exact ⟨⟨v, hvV⟩, by ext; rfl⟩
  have hFinSpecV : Finite (PrimeSpectrum ↥V) := Set.finite_univ_iff.mp hFinV
  have hf_spec_inj : Function.Injective (PrimeSpectrum.comap π_V) :=
    PrimeSpectrum.comap_injective_of_surjective π_V hπ_V_surj
  have _ : Finite (PrimeSpectrum ↥V_bar) :=
    Finite.of_injective (PrimeSpectrum.comap π_V) hf_spec_inj
  have hFinV_bar : Set.Finite (Set.univ : Set (PrimeSpectrum ↥V_bar)) := Set.finite_univ
  have hCardLt : Nat.card (PrimeSpectrum ↥V_bar) < Nat.card (PrimeSpectrum ↥V) := by
    by_contra hge
    push Not at hge
    have hbij : Function.Bijective (PrimeSpectrum.comap π_V) :=
      hf_spec_inj.bijective_of_nat_card_le hge
    have hc₁V : c₁ ∈ V := hMax_sub_W (algebraMap K F c₁) hc₁W₁ hc₁_max
    have hπ_c₁ : π_V ⟨c₁, hc₁V⟩ = 0 := by
      apply Subtype.ext
      apply (algebraMap K₁_res F₁_res).injective
      change algebraMap K₁_res F₁_res (IsLocalRing.residue ↥V₁ ⟨c₁, hc₁W₁⟩) =
        algebraMap K₁_res F₁_res 0
      rw [map_zero, hResCompat c₁ hc₁W₁ hc₁W₁]
      exact (IsLocalRing.residue_eq_zero_iff _).mpr hc₁_max
    obtain ⟨Q, hQ⟩ := hbij.2 ⟨⊥, inferInstance⟩
    have hmem_bot : (⟨c₁, hc₁V⟩ : ↥V) ∈ (⊥ : Ideal ↥V) := by
      have hmem_comap : (⟨c₁, hc₁V⟩ : ↥V) ∈ (PrimeSpectrum.comap π_V Q).asIdeal := by
        change π_V ⟨c₁, hc₁V⟩ ∈ Q.asIdeal
        rw [hπ_c₁]
        exact Q.asIdeal.zero_mem
      rwa [hQ] at hmem_comap
    rw [Ideal.mem_bot] at hmem_bot
    exact hc₁_ne (congrArg Subtype.val hmem_bot)
  
  
  
  have finset_min_val : ∀ (S : Finset K), S.Nonempty → (∀ c ∈ S, c ≠ 0) →
      ∃ c_star ∈ S, ∀ c ∈ S, c_star⁻¹ * c ∈ V₁ := by
    intro S
    induction S using Finset.induction_on with
    | empty => intro hne; exact absurd hne Finset.not_nonempty_empty
    | @insert a T _ ih =>
      intro _ hne0
      have ha0 : a ≠ 0 := hne0 a (Finset.mem_insert_self a T)
      rcases T.eq_empty_or_nonempty with rfl | hTne
      · refine ⟨a, Finset.mem_singleton_self a, fun c hc => ?_⟩
        rw [Finset.mem_singleton.mp hc, inv_mul_cancel₀ ha0]
        exact V₁.one_mem
      · obtain ⟨c₀, hc₀T, hc₀⟩ := ih hTne (fun c hc => hne0 c (Finset.mem_insert_of_mem hc))
        have hc₀0 : c₀ ≠ 0 := hne0 c₀ (Finset.mem_insert_of_mem hc₀T)
        rcases V₁.mem_or_inv_mem (c₀⁻¹ * a) with h1 | h2
        · refine ⟨c₀, Finset.mem_insert_of_mem hc₀T, fun c hc => ?_⟩
          rcases Finset.mem_insert.mp hc with rfl | hcT
          · exact h1
          · exact hc₀ c hcT
        · have h2' : a⁻¹ * c₀ ∈ V₁ := by
            have heq : (c₀⁻¹ * a)⁻¹ = a⁻¹ * c₀ := by rw [mul_inv_rev, inv_inv]
            rwa [heq] at h2
          refine ⟨a, Finset.mem_insert_self a T, fun c hc => ?_⟩
          rcases Finset.mem_insert.mp hc with rfl | hcT
          · rw [inv_mul_cancel₀ ha0]; exact V₁.one_mem
          · have hprod : (a⁻¹ * c₀) * (c₀⁻¹ * c) ∈ V₁ := V₁.toSubring.mul_mem h2' (hc₀ c hcT)
            have heq : (a⁻¹ * c₀) * (c₀⁻¹ * c) = a⁻¹ * c := by
              rw [mul_assoc, ← mul_assoc c₀, mul_inv_cancel₀ hc₀0, one_mul]
            rwa [heq] at hprod
  have gauss_scale : ∀ {m : ℕ} (f : Fin m → Polynomial K), (∃ i, f i ≠ 0) →
      ∀ (z₀ : F) (hz₀ : z₀ ∈ W₁),
      ∃ (c_star : K) (i_star : Fin m) (g_bar : Fin m → Polynomial K₁_res) (u_sc : Fin m → ↥W₁),
        c_star ≠ 0 ∧ g_bar i_star ≠ 0 ∧
        (∀ i : Fin m, (u_sc i : F) = algebraMap K F c_star⁻¹ * Polynomial.aeval z₀ (f i)) ∧
        (∀ i : Fin m, IsLocalRing.residue ↥W₁ (u_sc i) =
          Polynomial.aeval (IsLocalRing.residue ↥W₁ ⟨z₀, hz₀⟩) (g_bar i)) := by
    intro m f ⟨i₀, hi₀⟩ z₀ hz₀
    let S : Finset K :=
      Finset.univ.biUnion (fun i : Fin m => (f i).support.image (fun d => (f i).coeff d))
    have hS_ne : S.Nonempty := by
      obtain ⟨d₀, hd₀⟩ := Polynomial.support_nonempty.mpr hi₀
      exact ⟨(f i₀).coeff d₀, Finset.mem_biUnion.mpr
        ⟨i₀, Finset.mem_univ i₀, Finset.mem_image.mpr ⟨d₀, hd₀, rfl⟩⟩⟩
    have hS_nz : ∀ c ∈ S, c ≠ 0 := by
      intro c hc
      obtain ⟨i, _, hd_im⟩ := Finset.mem_biUnion.mp hc
      obtain ⟨d, hd_supp, rfl⟩ := Finset.mem_image.mp hd_im
      exact Polynomial.mem_support_iff.mp hd_supp
    obtain ⟨c_star, hc_mem, hc_div⟩ := finset_min_val S hS_ne hS_nz
    have hc_star_ne : c_star ≠ 0 := hS_nz c_star hc_mem
    obtain ⟨i_star, _, hd_im⟩ := Finset.mem_biUnion.mp hc_mem
    obtain ⟨d_star, hd_star_supp, hd_star_eq⟩ := Finset.mem_image.mp hd_im
    have hdiv : ∀ (i : Fin m) (d : ℕ), c_star⁻¹ * (f i).coeff d ∈ V₁ := by
      intro i d
      by_cases hd : d ∈ (f i).support
      · exact hc_div _ (Finset.mem_biUnion.mpr
          ⟨i, Finset.mem_univ i, Finset.mem_image.mpr ⟨d, hd, rfl⟩⟩)
      · rw [Polynomial.notMem_support_iff.mp hd, mul_zero]
        exact V₁.zero_mem
    let g_tilde : Fin m → Polynomial ↥V₁ := fun i =>
      ∑ d ∈ (f i).support, Polynomial.monomial d ⟨c_star⁻¹ * (f i).coeff d, hdiv i d⟩
    let g_bar : Fin m → Polynomial K₁_res := fun i =>
      (g_tilde i).map (IsLocalRing.residue ↥V₁)
    let u_sc : Fin m → ↥W₁ := fun i =>
      Polynomial.eval₂ j_VW ⟨z₀, hz₀⟩ (g_tilde i)
    have hgbar_ne : g_bar i_star ≠ 0 := by
      intro h0
      have hcoeff : (g_bar i_star).coeff d_star = 0 := by rw [h0]; simp
      have hcoeff1 : (g_bar i_star).coeff d_star = 1 := by
        simp only [g_bar, g_tilde, Polynomial.coeff_map, Polynomial.finsetSum_coeff,
          Polynomial.coeff_monomial, Finset.sum_ite_eq', hd_star_supp, ↓reduceIte]
        have h1 : (⟨c_star⁻¹ * (f i_star).coeff d_star, hdiv i_star d_star⟩ : ↥V₁) = 1 := by
          ext; simp [hd_star_eq, inv_mul_cancel₀ hc_star_ne]
        rw [h1, map_one]
      exact one_ne_zero (hcoeff1.symm.trans hcoeff)
    refine ⟨c_star, i_star, g_bar, u_sc, hc_star_ne, hgbar_ne, ?_, ?_⟩
    · intro i
      change W₁.subtype (Polynomial.eval₂ j_VW ⟨z₀, hz₀⟩ (g_tilde i)) = _
      rw [Polynomial.hom_eval₂]
      change Polynomial.eval₂ (W₁.subtype.comp j_VW) z₀ (g_tilde i) = _
      have eval₂_sum : ∀ (s : Finset ℕ) (p : ℕ → Polynomial ↥V₁),
          Polynomial.eval₂ (W₁.subtype.comp j_VW) z₀ (∑ x ∈ s, p x) =
            ∑ x ∈ s, Polynomial.eval₂ (W₁.subtype.comp j_VW) z₀ (p x) := by
        intro s p
        induction s using Finset.induction_on with
        | empty => simp
        | @insert a s ha ih => simp [Finset.sum_insert ha, Polynomial.eval₂_add, ih]
      dsimp only [g_tilde]
      rw [eval₂_sum]
      have hsum_eq : (∑ x ∈ (f i).support,
          Polynomial.eval₂ (W₁.subtype.comp j_VW) z₀
            (Polynomial.monomial x ⟨c_star⁻¹ * (f i).coeff x, hdiv i x⟩)) =
          ∑ x ∈ (f i).support,
            (algebraMap K F c_star⁻¹ * algebraMap K F ((f i).coeff x)) * z₀ ^ x := by
        refine Finset.sum_congr rfl fun x _ => ?_
        rw [Polynomial.eval₂_monomial]
        change algebraMap K F (c_star⁻¹ * (f i).coeff x) * z₀ ^ x = _
        rw [map_mul]
      rw [hsum_eq]
      have hfactor : (∑ x ∈ (f i).support,
          (algebraMap K F c_star⁻¹ * algebraMap K F ((f i).coeff x)) * z₀ ^ x) =
          algebraMap K F c_star⁻¹ *
            ∑ x ∈ (f i).support, algebraMap K F ((f i).coeff x) * z₀ ^ x := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun x _ => by ring
      rw [hfactor, Polynomial.aeval_def, Polynomial.eval₂_eq_sum, Polynomial.sum_def]
    · intro i
      dsimp only [u_sc, g_bar]
      rw [Polynomial.hom_eval₂]
      have hcomp_res : (IsLocalRing.residue ↥W₁).comp j_VW =
          (algebraMap K₁_res F₁_res).comp (IsLocalRing.residue ↥V₁) := by
        ext v
        exact (hResCompat v.1 v.2 v.2).symm
      rw [hcomp_res, ← Polynomial.eval₂_map, ← Polynomial.aeval_def]
  obtain ⟨x_sep, _, hFin_sep⟩ := hTr1
  have gen_exchange : ∀ z₀ : F, Transcendental K z₀ →
      FiniteDimensional ↥(IntermediateField.adjoin K ({z₀} : Set F)) F := by
    intro z₀ hTr_z₀
    let L_sep := IntermediateField.adjoin K ({x_sep} : Set F)
    let L_z₀ := IntermediateField.adjoin K ({z₀} : Set F)
    have _ : FiniteDimensional ↥L_sep F := hFin_sep
    have hAlg_x : IsAlgebraic ↥L_z₀ x_sep := by
      by_contra hTr_x
      change Transcendental ↥L_z₀ x_sep at hTr_x
      rw [IntermediateField.transcendental_adjoin_iff] at hTr_x
      let v : Bool → F := fun b => cond b x_sep z₀
      have hind_false : AlgebraicIndepOn K v {false} :=
        (algebraicIndependent_singleton_iff (R := K) (x := ({false} : Set Bool).domRestrict v)
          ⟨false, Set.mem_singleton false⟩).mpr hTr_z₀
      have hind_both : AlgebraicIndepOn K v (insert true {false}) := by
        refine AlgebraicIndepOn.insert hind_false ?_
        rw [Set.image_singleton]
        exact hTr_x
      have hpair : (insert true ({false} : Set Bool)) = insert false {true} :=
        Set.pair_comm true false
      rw [hpair] at hind_both
      have hTr_z_over_x : Transcendental ↥(Algebra.adjoin K (v '' {true})) (v false) :=
        ((AlgebraicIndepOn.insert_iff (by decide : false ∉ ({true} : Set Bool))).mp hind_both).2
      rw [Set.image_singleton] at hTr_z_over_x
      have hTr_z_Lsep : Transcendental ↥L_sep z₀ :=
        IntermediateField.transcendental_adjoin_iff.mpr hTr_z_over_x
      exact hTr_z_Lsep (Algebra.IsAlgebraic.isAlgebraic (R := ↥L_sep) z₀)
    let M_comp : IntermediateField ↥L_z₀ F := IntermediateField.adjoin ↥L_z₀ ({x_sep} : Set F)
    have _ : FiniteDimensional ↥L_z₀ ↥M_comp :=
      IntermediateField.adjoin.finiteDimensional hAlg_x.isIntegral
    have hSub_L : ∀ a : ↥L_sep, (a : F) ∈ M_comp := by
      have hle : L_sep ≤ M_comp.restrictScalars K := by
        rw [IntermediateField.adjoin_le_iff, Set.singleton_subset_iff]
        exact IntermediateField.mem_adjoin_simple_self ↥L_z₀ x_sep
      exact fun a => hle a.2
    obtain ⟨s, hs⟩ := Module.Finite.fg_top (R := ↥L_sep) (M := F)
    have _ : FiniteDimensional ↥M_comp F := by
      refine ⟨⟨s, top_unique fun y _ => ?_⟩⟩
      have hy : y ∈ Submodule.span ↥L_sep (s : Set F) := by rw [hs]; trivial
      refine Submodule.span_induction (fun w hw => Submodule.subset_span hw)
        (Submodule.zero_mem _) (fun _ _ _ _ hx₁ hx₂ => Submodule.add_mem _ hx₁ hx₂)
        (fun a w _ hw => ?_) hy
      exact Submodule.smul_mem _ (⟨(a : F), hSub_L a⟩ : ↥M_comp) hw
    exact Module.Finite.trans ↥M_comp F
  have hFinAll_res : ∀ x_tilde : F₁_res, Transcendental K₁_res x_tilde →
      FiniteDimensional ↥(IntermediateField.adjoin K₁_res ({x_tilde} : Set F₁_res)) F₁_res := by
    intro x_tilde hTr_tilde
    let L_tilde := IntermediateField.adjoin K₁_res ({x_tilde} : Set F₁_res)
    obtain ⟨⟨z₀, hz₀⟩, hz₀_res⟩ := IsLocalRing.residue_surjective (R := ↥W₁) x_tilde
    have hTr_z₀ : Transcendental K z₀ := by
      intro ⟨P, hP_ne, hP_eval⟩
      obtain ⟨_, i_star, g_bar, u_sc, _, hgbar_ne, hu_val, hu_res⟩ :=
        gauss_scale (fun _ : Fin 1 => P) ⟨0, hP_ne⟩ z₀ hz₀
      rw [Fin.eq_zero i_star] at hgbar_ne
      have hu0 : u_sc 0 = 0 := by
        ext
        rw [hu_val 0, hP_eval, mul_zero]
        rfl
      have hres0 : Polynomial.aeval x_tilde (g_bar 0) = 0 := by
        rw [← hz₀_res, ← hu_res 0, hu0, map_zero]
      exact hTr_tilde ⟨g_bar 0, hgbar_ne, hres0⟩
    let L_z₀ := IntermediateField.adjoin K ({z₀} : Set F)
    have _ : FiniteDimensional ↥L_z₀ F := gen_exchange z₀ hTr_z₀
    let N : ℕ := Module.finrank ↥L_z₀ F
    have hNotLI : ∀ e : Fin (N + 1) → F₁_res, ¬ LinearIndependent ↥L_tilde e := by
      intro e he_li
      let w_lift : Fin (N + 1) → ↥W₁ := fun t =>
        Classical.choose (IsLocalRing.residue_surjective (R := ↥W₁) (e t))
      have hw_res : ∀ t : Fin (N + 1), IsLocalRing.residue ↥W₁ (w_lift t) = e t := fun t =>
        Classical.choose_spec (IsLocalRing.residue_surjective (R := ↥W₁) (e t))
      have hw_not_li : ¬ LinearIndependent ↥L_z₀ (fun t : Fin (N + 1) => (w_lift t : F)) := by
        intro hw_li
        have hle := hw_li.fintype_card_le_finrank
        simp only [Fintype.card_fin] at hle
        omega
      rw [Fintype.not_linearIndependent_iff] at hw_not_li
      obtain ⟨u, hsum_u, t₀, hut₀_ne⟩ := hw_not_li
      have hAB : ∀ t : Fin (N + 1), ∃ A B : Polynomial K,
          Polynomial.aeval z₀ B ≠ 0 ∧ B ≠ 0 ∧
