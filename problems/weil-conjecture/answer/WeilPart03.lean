          ∀ (hAff : ∀ a : Fin (M + 1), AlgebraicGeometry.IsAffineOpen (U a))
            (c_V : ∀ a : Fin (M + 1), R →+* ↑Γ(P_V, U a)),
            (∀ a : Fin (M + 1),
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (c_V a)) = (hAff a).fromSpec ≫ π_V) →
            (∀ a : Fin (M + 1),
