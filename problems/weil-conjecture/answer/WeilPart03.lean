      let H_top : Subgroup (N ≃ₐ[↥K_base] N) := L_top.fixingSubgroup
      have hH_le_P : H_top ≤ P := by
        have hle : H_top ≤ K'_int.fixingSubgroup :=
          IntermediateField.fixingSubgroup_antitone le_sup_left
        rwa [IntermediateField.fixingSubgroup_fixedField P] at hle
