  obtain ⟨π₂, hπ₂_ne, hw_Vx, hπ₂_bound⟩ :
      ∃ π₂ : ↥V₁, π₂ ≠ 0 ∧ v₁Map π₂ / y₀ ∈ Vx ∧ ∀ p ∈ U_set, p.1 / (π₂.1) ^ p.2 ∈ V₁ := by
    suffices ∀ S : Finset (K × ℕ),
        (∀ p ∈ S, p.1 ≠ 0 ∧ 1 ≤ p.2 ∧ algebraMap K E p.1 / y₀ ^ p.2 ∈ Vx) →
        ∃ π₂ : ↥V₁, π₂ ≠ 0 ∧ v₁Map π₂ / y₀ ∈ Vx ∧ ∀ p ∈ S, p.1 / (π₂.1) ^ p.2 ∈ V₁ from
      this U_set hU_valid
    intro S
    refine Finset.induction_on S ?_ ?_
    · intro _
      exact ⟨τ₀, hτ₀_ne, hτ₀_div, fun _ hp => by simp at hp⟩
    · intro p S' _ ih hS
      obtain ⟨π₂', hπ₂'_ne, hπ₂'_Vx, hπ₂'_S⟩ := ih (fun q hq => hS q (Finset.mem_insert_of_mem hq))
      obtain ⟨hp1_ne, hp2_pos, hp_Vx⟩ := hS p (Finset.mem_insert_self p S')
      obtain ⟨τ, hτ_ne, hτ_Vx, hτ_p⟩ := h_up_root hp1_ne hp2_pos hp_Vx
      rcases ValuationRing.dvd_total π₂' τ with ⟨c_div, hc_div⟩ | ⟨c_div, hc_div⟩
      · refine ⟨π₂', hπ₂'_ne, hπ₂'_Vx, fun q hq => ?_⟩
        rcases Finset.mem_insert.mp hq with hqp | hq'
        · rw [hqp]
