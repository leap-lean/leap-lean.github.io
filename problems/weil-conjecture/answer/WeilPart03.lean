          ‖γ i₀‖ ≤ ‖∑ i ∈ S, algebraMap K_hat L₁ (γ i) * ((fam i : ↥L1_coeff) : L₁)‖ := by
        intro S γ i₀ hi₀
        by_contra hlt_raw
        push Not at hlt_raw
        obtain ⟨i_max, hi_max, hmax_γ⟩ :=
          Finset.exists_max_image S (fun i => ‖γ i‖) ⟨i₀, hi₀⟩
        have hlt_max : ‖∑ i ∈ S, algebraMap K_hat L₁ (γ i) * ((fam i : ↥L1_coeff) : L₁)‖ <
            ‖γ i_max‖ := lt_of_lt_of_le hlt_raw (hmax_γ i₀ hi₀)
        have hγ_max_pos : 0 < ‖γ i_max‖ := lt_of_le_of_lt (norm_nonneg _) hlt_max
        have hγ_max_ne : γ i_max ≠ 0 := norm_ne_zero_iff.mp (ne_of_gt hγ_max_pos)
        let β : Option (ℕ × ↥U₀) → K_hat := fun i => γ i / γ i_max
        have hβ_norm : ∀ i ∈ S, ‖β i‖ ≤ 1 := by
          intro i hi
          dsimp [β]
          rw [norm_div]
          exact (div_le_one hγ_max_pos).mpr (hmax_γ i hi)
        have hβ_max : β i_max = 1 := div_self hγ_max_ne
        have hsum_β_lt : ‖∑ i ∈ S, algebraMap K_hat L₁ (β i) * ((fam i : ↥L1_coeff) : L₁)‖ < 1 := by
          have hfactor : (∑ i ∈ S, algebraMap K_hat L₁ (β i) * ((fam i : ↥L1_coeff) : L₁)) =
