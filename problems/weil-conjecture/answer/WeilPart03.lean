          rw [hVK.fromSpec_preimage_basicOpen s]
          exact hs_not_p
        obtain ⟨φ, _hFrac, hη⟩ := hFuncF W hW ⟨⟨hVK.fromSpec.base p, hpW⟩⟩
        let res_V : C_K.presheaf.obj (Opposite.op V_K) ⟶ C_K.presheaf.obj (Opposite.op W) :=
          C_K.presheaf.map (CategoryTheory.homOfLE (C_K.basicOpen_le s)).op
        have hresV_φ : res_V ≫ φ = φ_K := by
          apply AlgebraicGeometry.Spec.map_injective
          rw [← cancel_mono hVK.fromSpec, AlgebraicGeometry.Spec.map_comp, Category.assoc,
            hVK.map_fromSpec hW (CategoryTheory.homOfLE (C_K.basicOpen_le s)).op, hη, hηVK]
        have hLoc_s : @IsLocalization.Away A _ s ↑(C_K.presheaf.obj (Opposite.op W)) _
            res_V.hom.toAlgebra := hVK.isLocalization_basicOpen s
        letI : Algebra A ↑(C_K.presheaf.obj (Opposite.op W)) := res_V.hom.toAlgebra
        haveI : IsLocalization.Away s ↑(C_K.presheaf.obj (Opposite.op W)) := hLoc_s
        have hs_unit : IsUnit (res_V.hom s) :=
          IsLocalization.map_units ↑(C_K.presheaf.obj (Opposite.op W)) ⟨s, Submonoid.mem_powers s⟩
        obtain ⟨u_s, hu_s⟩ := hs_unit
        let w : ↑(C_K.presheaf.obj (Opposite.op W)) := res_V.hom a * ↑u_s⁻¹
        refine ⟨W, hW, φ, hpW, hη, w, ?_⟩
        have hV_a : φ.hom (res_V.hom a) = φ_K.hom a := congrArg (fun f => f.hom a) hresV_φ
        have hV_s : φ.hom (res_V.hom s) = φ_K.hom s := congrArg (fun f => f.hom s) hresV_φ
        apply mul_right_cancel₀ hφs0
        calc φ.hom w * φ_K.hom s
            = φ.hom (res_V.hom a * ↑u_s⁻¹ * res_V.hom s) := by rw [← hV_s, ← map_mul]
          _ = φ.hom (res_V.hom a * (↑u_s⁻¹ * ↑u_s)) := by rw [← hu_s, mul_assoc]
          _ = φ.hom (res_V.hom a) := by simp
          _ = φ_K.hom a := hV_a
          _ = g * φ_K.hom s := by rw [← has, mul_comm]
    let S_G : Set A := {s : A | ∀ f ∈ G, ∃ a : A, φ_K.hom s * f = φ_K.hom a}
    have hClear : ∀ s ∈ S_G, ∀ b : ↥B_K, ∃ (k : ℕ) (a : A), ψ_BK.hom s ^ k * b = ψ_BK.hom a := by
      intro s hs b
      refine @Subring.closure_induction F _ (Set.range φ_K.hom ∪ (G : Set F))
        (fun x hx => ∃ (k : ℕ) (a : A), ψ_BK.hom s ^ k * (⟨x, hx⟩ : ↥B_K) = ψ_BK.hom a)
        ?_ ?_ ?_ ?_ ?_ ?_ b.1 b.2
      · intro x hx
        rcases hx with ⟨a, rfl⟩ | hxG
        · exact ⟨0, a, by ext; simp [ψ_BK]⟩
        · obtain ⟨a, ha⟩ := hs x hxG
          exact ⟨1, a, by ext; simpa [ψ_BK] using ha⟩
      · exact ⟨0, 0, by ext; simp⟩
      · exact ⟨0, 1, by ext; simp⟩
      · rintro x y hx hy ⟨k₁, a₁, ha₁⟩ ⟨k₂, a₂, ha₂⟩
        refine ⟨k₁ + k₂, s ^ k₂ * a₁ + s ^ k₁ * a₂, ?_⟩
        have h₁ : ψ_BK.hom (s ^ k₂ * a₁) = ψ_BK.hom s ^ k₂ * (ψ_BK.hom s ^ k₁ * ⟨x, hx⟩) := by
          rw [map_mul, map_pow, ha₁]
        have h₂ : ψ_BK.hom (s ^ k₁ * a₂) = ψ_BK.hom s ^ k₁ * (ψ_BK.hom s ^ k₂ * ⟨y, hy⟩) := by
          rw [map_mul, map_pow, ha₂]
        have hxy : (⟨x + y, Subring.add_mem B_K hx hy⟩ : ↥B_K) = ⟨x, hx⟩ + ⟨y, hy⟩ := rfl
        rw [hxy, map_add, h₁, h₂]
        ring
      · rintro x hx ⟨k, a, ha⟩
        refine ⟨k, -a, ?_⟩
        have hneg : (⟨-x, Subring.neg_mem B_K hx⟩ : ↥B_K) = -⟨x, hx⟩ := rfl
        rw [hneg, map_neg, mul_neg, ha]
      · rintro x y hx hy ⟨k₁, a₁, ha₁⟩ ⟨k₂, a₂, ha₂⟩
        refine ⟨k₁ + k₂, a₁ * a₂, ?_⟩
        have hxy : (⟨x * y, Subring.mul_mem B_K hx hy⟩ : ↥B_K) = ⟨x, hx⟩ * ⟨y, hy⟩ := rfl
        rw [hxy, map_mul, ← ha₁, ← ha₂]
        ring
    have hLocA : ∀ s : ↥S_G,
        @IsLocalization.Away A _ s.1 (Localization.Away (ψ_BK.hom s.1)) _
          ((algebraMap ↥B_K (Localization.Away (ψ_BK.hom s.1))).comp ψ_BK.hom).toAlgebra := by
      intro s
      let L_s := Localization.Away (ψ_BK.hom s.1)
      let f_AL : A →+* L_s := (algebraMap ↥B_K L_s).comp ψ_BK.hom
      letI : Algebra A L_s := f_AL.toAlgebra
      refine { map_units := ?_, surj := ?_, exists_of_eq := ?_ }
      · rintro ⟨_, m, rfl⟩
        change IsUnit (algebraMap ↥B_K L_s (ψ_BK.hom (s.1 ^ m)))
        rw [map_pow, map_pow]
        exact (IsLocalization.map_units L_s ⟨ψ_BK.hom s.1, Submonoid.mem_powers _⟩).pow m
      · intro z
        obtain ⟨⟨b, _, m, rfl⟩, hbm⟩ := IsLocalization.surj (Submonoid.powers (ψ_BK.hom s.1)) z
        obtain ⟨k, a, hka⟩ := hClear s.1 s.2 b
        refine ⟨(a, ⟨s.1 ^ (m + k), m + k, rfl⟩), ?_⟩
        change z * algebraMap ↥B_K L_s (ψ_BK.hom (s.1 ^ (m + k))) =
          algebraMap ↥B_K L_s (ψ_BK.hom a)
        rw [pow_add, map_mul, map_mul, ← mul_assoc, map_pow, hbm, ← map_mul, map_pow, mul_comm, hka]
      · intro x₁ x₂ hx
        change algebraMap ↥B_K L_s (ψ_BK.hom x₁) = algebraMap ↥B_K L_s (ψ_BK.hom x₂) at hx
        obtain ⟨⟨_, m, rfl⟩, hm⟩ :=
          (IsLocalization.eq_iff_exists (Submonoid.powers (ψ_BK.hom s.1)) L_s).mp hx
        refine ⟨⟨s.1 ^ m, m, rfl⟩, hInj_ψ ?_⟩
        simpa [map_mul, map_pow] using hm
    have hProd_not_mem : ∀ {I_p : Ideal A} [I_p.IsPrime] {α : Type u} (S_fin : Finset α)
        (v : α → A), (∀ i ∈ S_fin, v i ∉ I_p) → (∏ i ∈ S_fin, v i) ∉ I_p := by
      intro I_p hIp α S_fin v hv
      induction S_fin using Finset.induction_on with
      | empty =>
        rw [Finset.prod_empty]
        exact hIp.one_notMem
      | @insert x₀ s_rest hx₀ ih =>
        rw [Finset.prod_insert hx₀]
        intro hmem
        rcases hIp.mem_or_mem hmem with h1 | h2
        · exact hv x₀ (Finset.mem_insert_self x₀ s_rest) h1
        · exact ih (fun i hi => hv i (Finset.mem_insert_of_mem hi)) h2
    have hCover : ∀ q : AlgebraicGeometry.Spec (CommRingCat.of ↥B_K),
        ∃ s ∈ S_G, ψ_BK.hom s ∉ q.asIdeal := by
      intro q
      let p : AlgebraicGeometry.Spec (C_K.presheaf.obj (Opposite.op V_K)) :=
        (AlgebraicGeometry.Spec.map ψ_BK).base q
      have hp_each : ∀ f : {x : F // x ∈ G}, ∃ s_f a_f : A,
          s_f ∉ p.asIdeal ∧ φ_K.hom s_f * f.1 = φ_K.hom a_f := by
        rintro ⟨f, hfG⟩
        by_cases hf0 : f = 0
        · exact ⟨1, 0, p.isPrime.one_notMem, by simp [hf0]⟩
        · obtain ⟨W, hW, φ, hzW, _hFrac, hη, h_or⟩ := hPoles f (hVK.fromSpec.base p)
          rcases h_or with hf_in | hfinv_in
          · obtain ⟨a_f, s_f, hs_f, heq⟩ := (hCrit p f).mp ⟨W, hW, φ, hzW, hη, hf_in⟩
            exact ⟨s_f, a_f, hs_f, heq⟩
          · obtain ⟨b, t, ht_not_p, hbt⟩ := (hCrit p f⁻¹).mp ⟨W, hW, φ, hzW, hη, hfinv_in⟩
            have hbf : φ_K.hom b * f = φ_K.hom t := by
              calc φ_K.hom b * f = (φ_K.hom t * f⁻¹) * f := by rw [hbt]
                _ = φ_K.hom t := inv_mul_cancel_right₀ hf0 (φ_K.hom t)
            have hb_not_p : b ∉ p.asIdeal := by
              intro hb_p
              have hb_q : ψ_BK.hom b ∈ q.asIdeal := hb_p
              let f_BK : ↥B_K := ⟨f, Subring.subset_closure (Or.inr hfG)⟩
              have hbt_BK : ψ_BK.hom b * f_BK = ψ_BK.hom t := Subtype.ext hbf
              have ht_q : ψ_BK.hom t ∈ q.asIdeal := by
                rw [← hbt_BK]
                exact Ideal.mul_mem_right f_BK q.asIdeal hb_q
              exact ht_not_p ht_q
            exact ⟨b, t, hb_not_p, hbf⟩
      choose s_pick a_pick hs_pick ha_pick using hp_each
      let s_q : A := ∏ f ∈ G.attach, s_pick f
      have hsq_not_p : s_q ∉ p.asIdeal := by
        change (∏ f ∈ G.attach, s_pick f) ∉ p.asIdeal
        exact @hProd_not_mem p.asIdeal p.isPrime {x : F // x ∈ G} G.attach s_pick
          (fun f _ => hs_pick f)
      have hsq_SG : s_q ∈ S_G := by
        intro f hfG
        obtain ⟨d, hd⟩ := Finset.dvd_prod_of_mem s_pick (Finset.mem_attach G ⟨f, hfG⟩)
        refine ⟨d * a_pick ⟨f, hfG⟩, ?_⟩
        have hsq_eq : s_q = s_pick ⟨f, hfG⟩ * d := hd
        calc φ_K.hom s_q * f
            = φ_K.hom d * (φ_K.hom (s_pick ⟨f, hfG⟩) * f) := by
                rw [hsq_eq, map_mul]; ring
          _ = φ_K.hom d * φ_K.hom (a_pick ⟨f, hfG⟩) := by rw [ha_pick ⟨f, hfG⟩]
          _ = φ_K.hom (d * a_pick ⟨f, hfG⟩) := (map_mul _ _ _).symm
      exact ⟨s_q, hsq_SG, hsq_not_p⟩
    have hInj_Spec : Function.Injective (AlgebraicGeometry.Spec.map ψ_BK).base := by
      intro q₁ q₂ hq
      obtain ⟨s₁, hs₁_SG, hs₁_not_q₁⟩ := hCover q₁
      have hp_eq : (AlgebraicGeometry.Spec.map ψ_BK).base q₁ =
          (AlgebraicGeometry.Spec.map ψ_BK).base q₂ := hq
      have hs₁_not_q₂ : ψ_BK.hom s₁ ∉ q₂.asIdeal := by
        change s₁ ∉ ((AlgebraicGeometry.Spec.map ψ_BK).base q₂).asIdeal
        rw [← hp_eq]
        exact hs₁_not_q₁
      apply PrimeSpectrum.ext
      ext b
      obtain ⟨k, a, hka⟩ := hClear s₁ hs₁_SG b
      have hs₁k_not_q₁ : ψ_BK.hom s₁ ^ k ∉ q₁.asIdeal :=
        fun hm => hs₁_not_q₁ (q₁.isPrime.mem_of_pow_mem k hm)
      have hs₁k_not_q₂ : ψ_BK.hom s₁ ^ k ∉ q₂.asIdeal :=
        fun hm => hs₁_not_q₂ (q₂.isPrime.mem_of_pow_mem k hm)
      have ha_iff : ψ_BK.hom a ∈ q₁.asIdeal ↔ ψ_BK.hom a ∈ q₂.asIdeal := by
        change a ∈ ((AlgebraicGeometry.Spec.map ψ_BK).base q₁).asIdeal ↔
          a ∈ ((AlgebraicGeometry.Spec.map ψ_BK).base q₂).asIdeal
        rw [hp_eq]
      constructor
      · intro hb₁
        have hmul₁ : ψ_BK.hom a ∈ q₁.asIdeal := by
          rw [← hka]; exact q₁.asIdeal.mul_mem_left _ hb₁
        have hmul₂ : ψ_BK.hom s₁ ^ k * b ∈ q₂.asIdeal := by
          rw [hka]; exact ha_iff.mp hmul₁
        exact (q₂.isPrime.mem_or_mem hmul₂).resolve_left hs₁k_not_q₂
      · intro hb₂
        have hmul₂ : ψ_BK.hom a ∈ q₂.asIdeal := by
          rw [← hka]; exact q₂.asIdeal.mul_mem_left _ hb₂
        have hmul₁ : ψ_BK.hom s₁ ^ k * b ∈ q₁.asIdeal := by
          rw [hka]; exact ha_iff.mpr hmul₂
        exact (q₁.isPrime.mem_or_mem hmul₁).resolve_left hs₁k_not_q₁
    let u_chart : ∀ s : ↥S_G,
        AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (ψ_BK.hom s.1))) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of ↥B_K) :=
      fun s => AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap ↥B_K (Localization.Away (ψ_BK.hom s.1))))
    haveI hOpen_u : ∀ s : ↥S_G, AlgebraicGeometry.IsOpenImmersion (u_chart s) :=
      fun s => AlgebraicGeometry.IsOpenImmersion.of_isLocalization (ψ_BK.hom s.1)
    let U_src : ↥S_G → (AlgebraicGeometry.Spec (CommRingCat.of ↥B_K)).Opens :=
      fun s => @AlgebraicGeometry.Scheme.Hom.opensRange _ _ (u_chart s) (hOpen_u s)
    have hCov_src : TopologicalSpace.IsOpenCover U_src := by
      apply eq_top_iff.mpr
      intro q _
      rw [TopologicalSpace.Opens.mem_iSup]
      obtain ⟨s, hs_SG, hs_not_q⟩ := hCover q
      refine ⟨⟨s, hs_SG⟩, ?_⟩
      change q ∈ Set.range (u_chart ⟨s, hs_SG⟩).base
      rw [show Set.range (u_chart ⟨s, hs_SG⟩).base =
          (PrimeSpectrum.basicOpen (ψ_BK.hom s) : Set (PrimeSpectrum ↥B_K)) from
        PrimeSpectrum.localization_away_comap_range (R := ↥B_K)
          (Localization.Away (ψ_BK.hom s)) (ψ_BK.hom s)]
      exact hs_not_q
    let 𝒰 := (AlgebraicGeometry.Spec (CommRingCat.of ↥B_K)).openCoverOfIsOpenCover U_src hCov_src
    have hOpen_Spec : AlgebraicGeometry.IsOpenImmersion (AlgebraicGeometry.Spec.map ψ_BK) := by
      refine AlgebraicGeometry.IsOpenImmersion.of_openCover_source
        (AlgebraicGeometry.Spec.map ψ_BK) 𝒰 hInj_Spec ?_
      intro (s : ↥S_G)
      haveI : AlgebraicGeometry.IsOpenImmersion (u_chart s) := hOpen_u s
      let f_AL : A →+* Localization.Away (ψ_BK.hom s.1) :=
        (algebraMap ↥B_K (Localization.Away (ψ_BK.hom s.1))).comp ψ_BK.hom
      letI : Algebra A (Localization.Away (ψ_BK.hom s.1)) := f_AL.toAlgebra
      haveI : IsLocalization.Away s.1 (Localization.Away (ψ_BK.hom s.1)) := hLocA s
      have hComp_u : u_chart s ≫ AlgebraicGeometry.Spec.map ψ_BK =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (algebraMap A (Localization.Away (ψ_BK.hom s.1)))) := by
        rw [← AlgebraicGeometry.Spec.map_comp]
        rfl
      have hOpen_comp : AlgebraicGeometry.IsOpenImmersion
          (u_chart s ≫ AlgebraicGeometry.Spec.map ψ_BK) := by
        exact hComp_u.symm ▸ AlgebraicGeometry.IsOpenImmersion.of_isLocalization (R := A)
          (S := Localization.Away (ψ_BK.hom s.1)) s.1
      let iso_u := @AlgebraicGeometry.Scheme.Hom.isoOpensRange _ _ (u_chart s) (hOpen_u s)
      have hEq_mor :
          iso_u.inv ≫ (u_chart s ≫ AlgebraicGeometry.Spec.map ψ_BK) =
          𝒰.f s ≫ AlgebraicGeometry.Spec.map ψ_BK := by
        have hUf : 𝒰.f s = (U_src s).ι :=
          AlgebraicGeometry.Scheme.openCoverOfIsOpenCover_f _ U_src hCov_src s
        rw [hUf, ← Category.assoc]
        congr 1
        rw [Iso.inv_comp_eq]
        dsimp only [U_src, iso_u]
        exact (@AlgebraicGeometry.Scheme.Hom.isoOpensRange_hom_ι _ _ (u_chart s) (hOpen_u s)).symm
      have hOpen_inv : AlgebraicGeometry.IsOpenImmersion iso_u.inv := inferInstance
      exact hEq_mor ▸ CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.IsOpenImmersion)
        _ _ hOpen_inv hOpen_comp
    have hOpen_ιBK : AlgebraicGeometry.IsOpenImmersion ι_BK :=
      CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.IsOpenImmersion) _ _
        hOpen_Spec inferInstance
    refine ⟨hOpen_ιBK, ?_⟩
    ext z
    simp only [Set.mem_setOf_eq]
    let p_z : AlgebraicGeometry.Spec (C_K.presheaf.obj (Opposite.op V_K)) :=
      hVK.isoSpec.hom.base z
    have hpz_inv : hVK.isoSpec.inv.base p_z = z := by
      change (hVK.isoSpec.hom ≫ hVK.isoSpec.inv).base z = z
      rw [hVK.isoSpec.hom_inv_id]; rfl
    have hz_fromSpec : V_K.ι.base z = hVK.fromSpec.base p_z := by
      calc V_K.ι.base z = V_K.ι.base (hVK.isoSpec.inv.base p_z) := by rw [hpz_inv]
        _ = (hVK.isoSpec.inv ≫ V_K.ι).base p_z := rfl
        _ = hVK.fromSpec.base p_z := by rw [hVK.isoSpec_inv_ι]
    constructor
    · rintro ⟨q, rfl⟩
      intro f hfG
      have hp_eq : p_z = (AlgebraicGeometry.Spec.map ψ_BK).base q := by
        change (AlgebraicGeometry.Spec.map ψ_BK ≫ hVK.isoSpec.inv ≫ hVK.isoSpec.hom).base q = _
        rw [hVK.isoSpec.inv_hom_id, Category.comp_id]
      obtain ⟨s, hs_SG, hs_not_q⟩ := hCover q
      have hs_not_pz : s ∉ p_z.asIdeal := by
        rw [hp_eq]; exact hs_not_q
      obtain ⟨a, ha⟩ := hs_SG f hfG
      rw [hz_fromSpec]
      exact (hCrit p_z f).mpr ⟨a, s, hs_not_pz, ha⟩
    · intro hAll
      have hp_each : ∀ f : {x : F // x ∈ G}, ∃ s_f a_f : A,
          s_f ∉ p_z.asIdeal ∧ φ_K.hom s_f * f.1 = φ_K.hom a_f := by
        rintro ⟨f, hfG⟩
        have h_f := hAll f hfG
        rw [hz_fromSpec] at h_f
        obtain ⟨a_f, s_f, hs_f, ha_f⟩ := (hCrit p_z f).mp h_f
        exact ⟨s_f, a_f, hs_f, ha_f⟩
      choose s_pick a_pick hs_pick ha_pick using hp_each
      let s₀_z : A := ∏ f ∈ G.attach, s_pick f
      have hs₀_not_pz : s₀_z ∉ p_z.asIdeal := by
        change (∏ f ∈ G.attach, s_pick f) ∉ p_z.asIdeal
        exact @hProd_not_mem p_z.asIdeal p_z.isPrime {x : F // x ∈ G} G.attach s_pick
          (fun f _ => hs_pick f)
      have hs₀_SG : s₀_z ∈ S_G := by
        intro f hfG
        obtain ⟨d, hd⟩ := Finset.dvd_prod_of_mem s_pick (Finset.mem_attach G ⟨f, hfG⟩)
        refine ⟨d * a_pick ⟨f, hfG⟩, ?_⟩
        have hs₀_eq : s₀_z = s_pick ⟨f, hfG⟩ * d := hd
        calc φ_K.hom s₀_z * f
            = φ_K.hom d * (φ_K.hom (s_pick ⟨f, hfG⟩) * f) := by
                rw [hs₀_eq, map_mul]; ring
          _ = φ_K.hom d * φ_K.hom (a_pick ⟨f, hfG⟩) := by rw [ha_pick ⟨f, hfG⟩]
          _ = φ_K.hom (d * a_pick ⟨f, hfG⟩) := (map_mul _ _ _).symm
      let s_sub : ↥S_G := ⟨s₀_z, hs₀_SG⟩
      let L_s := Localization.Away (ψ_BK.hom s_sub.1)
      let f_AL : A →+* L_s := (algebraMap ↥B_K L_s).comp ψ_BK.hom
      letI : Algebra A L_s := f_AL.toAlgebra
      haveI : IsLocalization.Away s_sub.1 L_s := hLocA s_sub
      have hpz_basic : p_z ∈ (PrimeSpectrum.basicOpen s_sub.1 : Set (PrimeSpectrum A)) :=
        hs₀_not_pz
      rw [← PrimeSpectrum.localization_away_comap_range (R := A) L_s s_sub.1] at hpz_basic
      obtain ⟨r_L, hr_L⟩ := hpz_basic
      let q_BK : AlgebraicGeometry.Spec (CommRingCat.of ↥B_K) := (u_chart s_sub).base r_L
      refine ⟨q_BK, ?_⟩
      have hq_pz : (AlgebraicGeometry.Spec.map ψ_BK).base q_BK = p_z := hr_L
      calc ι_BK.base q_BK
          = hVK.isoSpec.inv.base ((AlgebraicGeometry.Spec.map ψ_BK).base q_BK) := rfl
        _ = hVK.isoSpec.inv.base p_z := by rw [hq_pz]
        _ = z := hpz_inv
  exact ⟨⟨s₀, hs₀, hLocV⟩, hPart2, ⟨hPoles, hPart4⟩⟩

theorem weil_etale_rz_cover_by_strictlySemistable_subrings (k : Type u) [Field k]
    (m : ℕ)
    (K : Type u) [Field K] [Algebra k K]
    (V : ValuationSubring K)
    (hkV : ∀ c : k, algebraMap k K c ∈ V)
    (F : Type u) [Field F] [Algebra k F] [Algebra K F] [IsScalarTower k K F]
    (hUnif : ∀ (W : ValuationSubring F),
      (∀ c : k, algebraMap k F c ∈ W) →
      Set.Finite (Set.univ : Set (PrimeSpectrum ↥(W.comap (algebraMap K F)))) ∧
      Nat.card (PrimeSpectrum ↥(W.comap (algebraMap K F))) ≤ m + 1 ∧
      ∃ (x : F),
        x ∈ W ∧
        Transcendental K x ∧
        let Lx := IntermediateField.adjoin K ({x} : Set F)
        let Vx := W.comap Lx.val.toRingHom
        RingHom.Etale ((Lx.val.toRingHom.comp Vx.subtype).codRestrict W.toSubring (fun y => y.2)))
    (hChartApprox : ∀ (x : F),
      Transcendental K x →
      ∀ (Vx : ValuationSubring ↥(IntermediateField.adjoin K ({x} : Set F)))
        (hVVx : ∀ y : ↥V,
          ((algebraMap K ↥(IntermediateField.adjoin K ({x} : Set F))).comp V.subtype) y ∈ Vx),
        (⟨x, IntermediateField.mem_adjoin_simple_self K x⟩ :
          ↥(IntermediateField.adjoin K ({x} : Set F))) ∈ Vx →
        ∀ (S₀ : Finset ↥(IntermediateField.adjoin K ({x} : Set F))),
          (∀ z ∈ S₀, z ∈ Vx) →
          ∃ (R : Subring ↥(IntermediateField.adjoin K ({x} : Set F)))
            (hVR : ∀ y : ↥V,
              ((algebraMap K ↥(IntermediateField.adjoin K ({x} : Set F))).comp V.subtype) y ∈ R),
            (∀ r ∈ R, r ∈ Vx) ∧
            (⟨x, IntermediateField.mem_adjoin_simple_self K x⟩ :
              ↥(IntermediateField.adjoin K ({x} : Set F))) ∈ R ∧
            (∀ z ∈ S₀, z ∈ R) ∧
            HasStandardSemistableLocalizationPresentation V R hVR)
    (M₀ : ℕ)
    (ξ : Fin (M₀ + 1) → F)
    (hξ : ∃ r_gen : Fin (M₀ + 1), ξ r_gen ≠ 0) :
    IsStrictlySemistableSubringCoverForCoords V M₀ ξ :=
by
  
  have hCoordNorm : ∀ (W : ValuationSubring F),
      ∃ r_W : Fin (M₀ + 1), ξ r_W ≠ 0 ∧ ∀ s : Fin (M₀ + 1), ξ s / ξ r_W ∈ W := by
    intro W
    classical
    have hInd : ∀ (S : Finset (Fin (M₀ + 1))), S.Nonempty → (∀ s ∈ S, ξ s ≠ 0) →
        ∃ r ∈ S, ∀ s ∈ S, ξ s / ξ r ∈ W := by
      intro S hSne
      induction hSne using Finset.Nonempty.cons_induction with
      | singleton a =>
        intro hS
        refine ⟨a, Finset.mem_singleton_self a, fun s hs => ?_⟩
        rw [Finset.mem_singleton.mp hs, div_self (hS a (Finset.mem_singleton_self a))]
        exact W.one_mem
      | cons a S ha hSne ih =>
        intro hS
        obtain ⟨r₀, hr₀_mem, hr₀_div⟩ := ih (fun s hs => hS s (Finset.mem_cons_of_mem hs))
        have ha_nz : ξ a ≠ 0 := hS a (Finset.mem_cons_self a S)
        have hr₀_nz : ξ r₀ ≠ 0 := hS r₀ (Finset.mem_cons_of_mem hr₀_mem)
        rcases ValuationSubring.mem_or_inv_mem W (ξ a / ξ r₀) with h_in | h_inv
        · refine ⟨r₀, Finset.mem_cons_of_mem hr₀_mem, fun s hs => ?_⟩
          rcases Finset.mem_cons.mp hs with rfl | hsS
          · exact h_in
          · exact hr₀_div s hsS
        · rw [inv_div] at h_inv
          refine ⟨a, Finset.mem_cons_self a S, fun s hs => ?_⟩
          rcases Finset.mem_cons.mp hs with rfl | hsS
          · rw [div_self ha_nz]
            exact W.one_mem
          · have hmul : (ξ s / ξ r₀) * (ξ r₀ / ξ a) = ξ s / ξ a := by
              field_simp
            rw [← hmul]
            exact W.toSubring.mul_mem (hr₀_div s hsS) h_inv
    let S_nz : Finset (Fin (M₀ + 1)) := Finset.univ.filter (fun s => ξ s ≠ 0)
    obtain ⟨r_gen, hr_gen⟩ := hξ
    have hSnz_ne : S_nz.Nonempty := ⟨r_gen, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hr_gen⟩⟩
    obtain ⟨r_W, hrW_mem, hrW_div⟩ :=
      hInd S_nz hSnz_ne (fun s hs => (Finset.mem_filter.mp hs).2)
    refine ⟨r_W, (Finset.mem_filter.mp hrW_mem).2, fun s => ?_⟩
    by_cases hs : ξ s = 0
    · rw [hs, zero_div]
      exact W.zero_mem
    · exact hrW_div s (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hs⟩)

  
  have hTensorCore :
      ∀ (E : Type u) [Field E] [Algebra K E] (j : E →ₐ[K] F)
        (W : ValuationSubring F)
        (Vx : ValuationSubring E)
        (φ_VxW : ↥Vx →+* ↥W)
        (hφ_VxW : ∀ v : ↥Vx, (φ_VxW v : F) = j (v : E))
        [Algebra ↥Vx ↥W] (hAlg_VxW : algebraMap ↥Vx ↥W = φ_VxW)
        (C₀ : Type u) [CommRing C₀] [Algebra C₀ ↥Vx]
        (B₀ : Type u) [CommRing B₀] [Algebra C₀ B₀] [Algebra.Etale C₀ B₀]
        (e_W : ↥W ≃ₐ[↥Vx] TensorProduct C₀ ↥Vx B₀)
        (S_C : Finset E) (hSC_Vx : ∀ z ∈ S_C, z ∈ Vx)
        (hSC_gen : ∀ (R : Subring E),
          (∀ y : ↥V, ((algebraMap K E).comp V.subtype) y ∈ R) →
          (∀ z ∈ S_C, z ∈ R) →
          ∀ c : C₀, ((algebraMap C₀ ↥Vx c : ↥Vx) : E) ∈ R)
        (P : ∀ (R : Subring E), (∀ y : ↥V, ((algebraMap K E).comp V.subtype) y ∈ R) → Prop)
        (hChart : ∀ (S₀ : Finset E), (∀ z ∈ S₀, z ∈ Vx) →
          ∃ (R : Subring E) (hVR : ∀ y : ↥V, ((algebraMap K E).comp V.subtype) y ∈ R),
            (∀ r ∈ R, r ∈ Vx) ∧ (∀ z ∈ S₀, z ∈ R) ∧ P R hVR)
        (T₀ : Finset F) (hT₀ : ∀ f ∈ T₀, f ∈ W),
        ∃ (R : Subring E) (hVR : ∀ y : ↥V, ((algebraMap K E).comp V.subtype) y ∈ R)
          (B : Subring F) (hVB : ∀ y : ↥V, ((algebraMap K F).comp V.subtype) y ∈ B)
          (φ_RB : ↥R →+* ↥B),
          P R hVR ∧
          (∀ b ∈ B, b ∈ W) ∧
          (∀ f ∈ T₀, f ∈ B) ∧
          RingHom.Etale φ_RB ∧
          φ_RB.comp (RingHom.codRestrict ((algebraMap K E).comp V.subtype) R hVR) =
            RingHom.codRestrict ((algebraMap K F).comp V.subtype) B hVB := by
    intro E _ _ j W Vx φ_VxW hφ_VxW _ hAlg_VxW C₀ _ _ B₀ _ _ _ e_W S_C hSC_Vx hSC_gen P hChart T₀ hT₀
    have hDecomp : ∀ z : TensorProduct C₀ ↥Vx B₀,
        ∃ L : List (↥Vx × B₀), z = (L.map (fun p => p.1 ⊗ₜ[C₀] p.2)).sum := fun z =>
      TensorProduct.inductionOn z (fun v b => ⟨[(v, b)], by simp⟩)
        (fun x y ⟨Lx, hLx⟩ ⟨Ly, hLy⟩ =>
          ⟨Lx ++ Ly, by rw [hLx, hLy, List.map_append, List.sum_append]⟩)
    choose L_z hL_z using hDecomp
    obtain ⟨S₀, hS₀_Vx, hS₀_SC, hS₀_L⟩ :
        ∃ S₀ : Finset E,
          (∀ z ∈ S₀, z ∈ Vx) ∧
          (∀ z ∈ S_C, z ∈ S₀) ∧
          (∀ (f : F) (hf : f ∈ T₀) (p : ↥Vx × B₀),
            p ∈ L_z (e_W ⟨f, hT₀ f hf⟩) → (p.1 : E) ∈ S₀) := by
      classical
      let S_T : Finset E := T₀.attach.biUnion (fun f =>
        ((L_z (e_W ⟨f.1, hT₀ f.1 f.2⟩)).map (fun p => (p.1 : E))).toFinset)
      refine ⟨S_C ∪ S_T, ?_, fun z hz => Finset.mem_union_left _ hz, ?_⟩
      · intro z hz
        rcases Finset.mem_union.mp hz with hzC | hzT
        · exact hSC_Vx z hzC
        · obtain ⟨f, _, hf_mem⟩ := Finset.mem_biUnion.mp hzT
          obtain ⟨p, _, rfl⟩ := List.mem_map.mp (List.mem_toFinset.mp hf_mem)
          exact p.1.2
      · intro f hf p hp
        apply Finset.mem_union_right
        apply Finset.mem_biUnion.mpr
        exact ⟨⟨f, hf⟩, Finset.mem_attach _ _, List.mem_toFinset.mpr (List.mem_map.mpr ⟨p, hp, rfl⟩)⟩
    obtain ⟨R, hVR, hRVx, hS₀R, hPres⟩ := hChart S₀ hS₀_Vx
    have hCR : ∀ c : C₀, ((algebraMap C₀ ↥Vx c : ↥Vx) : E) ∈ R :=
      hSC_gen R hVR (fun z hz => hS₀R z (hS₀_SC z hz))
    let φ_CR : C₀ →+* ↥R := (Vx.subtype.comp (algebraMap C₀ ↥Vx)).codRestrict R hCR
    letI : Algebra C₀ ↥R := φ_CR.toAlgebra
    let ι_RVx : ↥R →+* ↥Vx := R.subtype.codRestrict Vx.toSubring (fun r => hRVx r.1 r.2)
    let ι_alg : ↥R →ₐ[C₀] ↥Vx := { ι_RVx with commutes' := fun _ => Subtype.ext rfl }
    have hι_inj : Function.Injective ι_alg := fun r₁ r₂ h =>
      Subtype.ext (congrArg (Subtype.val : ↥Vx → E) h)
    let Ψ : TensorProduct C₀ ↥R B₀ →ₐ[C₀] TensorProduct C₀ ↥Vx B₀ :=
      Algebra.TensorProduct.map ι_alg (AlgHom.id C₀ B₀)
    have hΨ_lin : Ψ.toLinearMap = LinearMap.rTensor B₀ ι_alg.toLinearMap :=
      TensorProduct.ext' (fun _ _ => rfl)
    have hΨ_inj : Function.Injective Ψ := by
      have hlin : Function.Injective ⇑(LinearMap.rTensor B₀ ι_alg.toLinearMap) :=
        Module.Flat.rTensor_preserves_injective_linearMap ι_alg.toLinearMap hι_inj
      intro z₁ z₂ hz
      exact hlin (by simpa [← hΨ_lin] using hz)
    let Θ : TensorProduct C₀ ↥R B₀ →+* F :=
      W.subtype.comp (e_W.symm.toRingHom.comp Ψ.toRingHom)
    have hΘ_inj : Function.Injective Θ := fun z₁ z₂ h =>
      hΨ_inj (e_W.symm.injective (Subtype.ext h))
    let B : Subring F := Θ.range
    let e_B : TensorProduct C₀ ↥R B₀ ≃+* ↥B :=
      RingEquiv.ofBijective Θ.rangeRestrict
        ⟨fun z₁ z₂ h => hΘ_inj (congrArg (Subtype.val : ↥B → F) h), Θ.rangeRestrict_surjective⟩
    let ι_left : ↥R →+* TensorProduct C₀ ↥R B₀ := Algebra.TensorProduct.includeLeftRingHom
    let φ_RB : ↥R →+* ↥B := e_B.toRingHom.comp ι_left
    have hΘ_left : ∀ r : ↥R, Θ (ι_left r) = j (r : E) := by
      intro r
      have hΨr : Ψ (ι_left r) = algebraMap ↥Vx (TensorProduct C₀ ↥Vx B₀) (ι_alg r) := rfl
      have heW : e_W.symm (Ψ (ι_left r)) = φ_VxW (ι_alg r) := by
        rw [hΨr, AlgEquiv.commutes, hAlg_VxW]
      show (e_W.symm (Ψ (ι_left r)) : F) = j (r : E)
      rw [heW, hφ_VxW]
      rfl
    have hVB : ∀ y : ↥V, ((algebraMap K F).comp V.subtype) y ∈ B := by
      intro y
      let r_y : ↥R := RingHom.codRestrict ((algebraMap K E).comp V.subtype) R hVR y
      refine ⟨ι_left r_y, ?_⟩
      rw [hΘ_left r_y]
      exact j.commutes (y : K)
    have hLiftList : ∀ (L : List (↥Vx × B₀)),
        (∀ p ∈ L, (p.1 : E) ∈ R) →
        ∃ z : TensorProduct C₀ ↥R B₀, Ψ z = (L.map (fun p => p.1 ⊗ₜ[C₀] p.2)).sum := by
      intro L hL
      induction L with
      | nil => exact ⟨0, by simp⟩
      | cons p tl ih =>
        obtain ⟨z_tl, hz_tl⟩ := ih (fun q hq => hL q (List.mem_cons_of_mem p hq))
        have hpR : (p.1 : E) ∈ R := hL p List.mem_cons_self
        refine ⟨(⟨(p.1 : E), hpR⟩ : ↥R) ⊗ₜ[C₀] p.2 + z_tl, ?_⟩
        rw [map_add, hz_tl]
        rfl
    refine ⟨R, hVR, B, hVB, φ_RB, hPres, ?_, ?_, ?_, ?_⟩
    · intro b hb
      obtain ⟨z, rfl⟩ := hb
      exact (e_W.symm (Ψ z)).2
    · intro f hf
      obtain ⟨z_f, hz_f⟩ := hLiftList (L_z (e_W ⟨f, hT₀ f hf⟩))
        (fun p hp => hS₀R (p.1 : E) (hS₀_L f hf p hp))
      refine ⟨z_f, ?_⟩
      show (e_W.symm (Ψ z_f) : F) = f
      rw [hz_f, ← hL_z, AlgEquiv.symm_apply_apply]
    · have hEt_left : RingHom.Etale ι_left := by
        change RingHom.Etale (algebraMap ↥R (TensorProduct C₀ ↥R B₀))
        exact RingHom.etale_algebraMap.mpr inferInstance
      exact RingHom.Etale.respectsIso.1 ι_left e_B hEt_left
    · ext y
      change Θ (ι_left (RingHom.codRestrict ((algebraMap K E).comp V.subtype) R hVR y)) =
        ((algebraMap K F).comp V.subtype) y
      rw [hΘ_left]
      exact j.commutes (y : K)

  
  have hEtaleDescent :
      ∀ (E : Type u) [Field E] [Algebra K E] (j : E →ₐ[K] F)
        (W : ValuationSubring F) (hVW : ∀ y : ↥V, ((algebraMap K F).comp V.subtype) y ∈ W)
        (hEt_W :
          let Vx := W.comap j.toRingHom
          RingHom.Etale ((j.toRingHom.comp Vx.subtype).codRestrict W.toSubring (fun y => y.2)))
        (P : ∀ (R : Subring E), (∀ y : ↥V, ((algebraMap K E).comp V.subtype) y ∈ R) → Prop)
        (hChart : ∀ (S₀ : Finset E), (∀ z ∈ S₀, z ∈ W.comap j.toRingHom) →
          ∃ (R : Subring E) (hVR : ∀ y : ↥V, ((algebraMap K E).comp V.subtype) y ∈ R),
            (∀ r ∈ R, r ∈ W.comap j.toRingHom) ∧ (∀ z ∈ S₀, z ∈ R) ∧ P R hVR)
        (T₀ : Finset F) (hT₀ : ∀ f ∈ T₀, f ∈ W),
        ∃ (R : Subring E) (hVR : ∀ y : ↥V, ((algebraMap K E).comp V.subtype) y ∈ R)
          (B : Subring F) (hVB : ∀ y : ↥V, ((algebraMap K F).comp V.subtype) y ∈ B)
          (φ_RB : ↥R →+* ↥B),
          P R hVR ∧
          (∀ b ∈ B, b ∈ W) ∧
          (∀ f ∈ T₀, f ∈ B) ∧
          RingHom.Etale φ_RB ∧
          φ_RB.comp (RingHom.codRestrict ((algebraMap K E).comp V.subtype) R hVR) =
            RingHom.codRestrict ((algebraMap K F).comp V.subtype) B hVB := by
    intro E _ _ j W hVW hEt_W P hChart T₀ hT₀
    let Vx : ValuationSubring E := W.comap j.toRingHom
    have hVVx : ∀ y : ↥V, ((algebraMap K E).comp V.subtype) y ∈ Vx := by
      intro y
      show j (((algebraMap K E).comp V.subtype) y) ∈ W
      rw [RingHom.comp_apply, j.commutes]
      exact hVW y
    let φ_VVx : ↥V →+* ↥Vx :=
      RingHom.codRestrict ((algebraMap K E).comp V.subtype) Vx.toSubring hVVx
    let φ_VxW : ↥Vx →+* ↥W :=
      (j.toRingHom.comp Vx.subtype).codRestrict W.toSubring (fun y => y.2)
    letI : Algebra ↥V ↥Vx := φ_VVx.toAlgebra
    letI : Algebra ↥Vx ↥W := φ_VxW.toAlgebra
    haveI : Algebra.Etale ↥Vx ↥W := by
      rw [← RingHom.etale_algebraMap]
      exact hEt_W
    obtain ⟨A₀, B₀, _, _, hA₀_fg, _, ⟨e_W⟩⟩ := Algebra.Etale.exists_subalgebra_fg ↥V ↥Vx ↥W
    obtain ⟨t_A, ht_A⟩ := hA₀_fg
    obtain ⟨S_C, hSC_Vx, hSC_mem⟩ :
        ∃ S_C : Finset E, (∀ z ∈ S_C, z ∈ Vx) ∧ (∀ v ∈ t_A, (v : E) ∈ S_C) := by
      classical
      refine ⟨t_A.image Vx.subtype, ?_, fun v hv => Finset.mem_image_of_mem _ hv⟩
      intro z hz
      obtain ⟨v, _, rfl⟩ := Finset.mem_image.mp hz
      exact v.2
    have hSC_gen : ∀ (R : Subring E),
        (∀ y : ↥V, ((algebraMap K E).comp V.subtype) y ∈ R) →
        (∀ z ∈ S_C, z ∈ R) →
        ∀ c : ↥A₀, ((algebraMap ↥A₀ ↥Vx c : ↥Vx) : E) ∈ R := by
      intro R hVR hSCR c
      let R_sub : Subalgebra ↥V ↥Vx :=
        { carrier := {v : ↥Vx | (v : E) ∈ R}
          mul_mem' := fun ha hb => R.mul_mem ha hb
          one_mem' := R.one_mem
          add_mem' := fun ha hb => R.add_mem ha hb
          zero_mem' := R.zero_mem
          algebraMap_mem' := fun y => hVR y }
      have hle : A₀ ≤ R_sub := by
        rw [← ht_A]
        exact Algebra.adjoin_le (fun v hv => hSCR (v : E) (hSC_mem v hv))
      exact hle c.2
    exact hTensorCore E j W Vx φ_VxW (fun _ => rfl) rfl ↥A₀ B₀ e_W S_C hSC_Vx hSC_gen P hChart T₀ hT₀

  
  have hCurveAndFG :
      ∀ (E : Type u) [Field E] [Algebra K E]
        (R : Subring E) (hVR : ∀ y : ↥V, ((algebraMap K E).comp V.subtype) y ∈ R)
        (hPres : HasStandardSemistableLocalizationPresentation V R hVR)
        (B : Subring F) (hVB : ∀ y : ↥V, ((algebraMap K F).comp V.subtype) y ∈ B)
        (φ_RB : ↥R →+* ↥B) (hEt_RB : RingHom.Etale φ_RB)
        (hComm_RB : φ_RB.comp (RingHom.codRestrict ((algebraMap K E).comp V.subtype) R hVR) =
          RingHom.codRestrict ((algebraMap K F).comp V.subtype) B hVB)
        (S_extra : Set F) (hS_extra : S_extra ⊆ (B : Set F)),
        IsStrictlySemistableCurveOverValuation V
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (RingHom.codRestrict ((algebraMap K F).comp V.subtype) B hVB))) ∧
        ∃ (G : Finset F),
          (∀ f ∈ G, f ∈ B ∧ f ≠ 0) ∧
          Subring.closure
            (Set.range ((algebraMap K F).comp V.subtype) ∪ S_extra ∪ (G : Set F)) = B := by
    intro E _ _ R hVR hPres B hVB φ_RB hEt_RB hComm_RB S_extra hS_extra
    let φ_VR : ↥V →+* ↥R := RingHom.codRestrict ((algebraMap K E).comp V.subtype) R hVR
    let φ_VB : ↥V →+* ↥B := RingHom.codRestrict ((algebraMap K F).comp V.subtype) B hVB
    let U_B : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of ↥B)
    let g_B : U_B ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_VB)
    have hFlat_gB : AlgebraicGeometry.Flat g_B := by
      rw [AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Flat)]
      letI : Algebra ↥V ↥B := φ_VB.toAlgebra
      change (algebraMap ↥V ↥B).Flat
      rw [RingHom.flat_algebraMap_iff, Module.Flat.flat_iff_torsion_eq_bot_of_isBezout,
        ← Submodule.isTorsionFree_iff_torsion_eq_bot]
      refine ⟨fun r hr b₁ b₂ h => ?_⟩
      have hr0 : r ≠ 0 := hr.ne_zero
      have hrK : (r : K) ≠ 0 := fun h0 => hr0 (Subtype.ext h0)
      have hrF : algebraMap K F (r : K) ≠ 0 := (map_ne_zero (algebraMap K F)).mpr hrK
      exact Subtype.ext (mul_left_cancel₀ hrF (congrArg Subtype.val h))
    have hLocChart :
        ∀ {S_std : Type u} [CommRing S_std] (C_std : ↥V →+* S_std),
          RingHom.FinitePresentation C_std →
          ∀ (ψ : S_std →+* ↥R) (g₀ : S_std),
            ψ.comp C_std = φ_VR →
            @IsLocalization.Away _ _ g₀ ↥R _ ψ.toAlgebra →
            RingHom.FinitePresentation φ_VB ∧
            ∃ (W_open : U_B.Opens)
              (e : W_open.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of S_std)),
              (∀ y : U_B, y ∈ W_open) ∧
              AlgebraicGeometry.Etale e ∧
              W_open.ι ≫ g_B = e ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom C_std) := by
      intro S_std _ C_std hFP_C ψ g₀ hψC hLoc
      have hEt_ψ : RingHom.Etale ψ := by
        letI : Algebra S_std ↥R := ψ.toAlgebra
        haveI : IsLocalization.Away g₀ ↥R := hLoc
        haveI : Algebra.Etale S_std ↥R := Algebra.Etale.of_isLocalizationAway g₀
        exact RingHom.etale_algebraMap.mpr inferInstance
      let ψ_B : S_std →+* ↥B := φ_RB.comp ψ
      have hEt_ψB : RingHom.Etale ψ_B :=
        RingHom.Etale.stableUnderComposition ψ φ_RB hEt_ψ hEt_RB
      have hψB_C : ψ_B.comp C_std = φ_VB := by
        rw [RingHom.comp_assoc, hψC, hComm_RB]
      have hFP_ψB : RingHom.FinitePresentation ψ_B := by
        letI : Algebra S_std ↥B := ψ_B.toAlgebra
        haveI : Algebra.Etale S_std ↥B := RingHom.etale_algebraMap.mp hEt_ψB
        exact RingHom.finitePresentation_algebraMap.mpr Algebra.Etale.finitePresentation
      have hFP_VB : RingHom.FinitePresentation φ_VB := by
        rw [← hψB_C]
        exact RingHom.FinitePresentation.comp hFP_ψB hFP_C
      refine ⟨hFP_VB, ⊤, U_B.topIso.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_B),
        fun _ => trivial, ?_, ?_⟩
      · have : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_B)) :=
          (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hEt_ψB
        infer_instance
      · rw [CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp, hψB_C, AlgebraicGeometry.Scheme.topIso_hom]
    have hFP_and_Charts :
        RingHom.FinitePresentation φ_VB ∧
        (∀ y : U_B,
          (∃ (W_open : U_B.Opens)
              (e : W_open.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial ↥V))),
            y ∈ W_open ∧
            AlgebraicGeometry.Etale e ∧
            W_open.ι ≫ g_B = e ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C)) ∨
          (∃ (W_open : U_B.Opens) (a : ↥V)
              (e : W_open.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of
                (MvPolynomial (Fin 2) ↥V ⧸ Ideal.span
                  {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}))),
            y ∈ W_open ∧
            a ≠ 0 ∧
            AlgebraicGeometry.Etale e ∧
            W_open.ι ≫ g_B = e ≫ AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)))) := by
      rcases hPres with ⟨ψ, g₀, hψC, hLoc⟩ | ⟨a, ψ, g₀, ha_nz, hψC, hLoc⟩
      · have hFP_poly : RingHom.FinitePresentation (Polynomial.C : ↥V →+* Polynomial ↥V) :=
          RingHom.finitePresentation_algebraMap.mpr inferInstance
        obtain ⟨hFP_VB, W_open, e, hmem, hEt_e, hcomm⟩ := hLocChart Polynomial.C hFP_poly ψ g₀ hψC hLoc
        exact ⟨hFP_VB, fun y => Or.inl ⟨W_open, e, hmem y, hEt_e, hcomm⟩⟩
      · let I_nod : Ideal (MvPolynomial (Fin 2) ↥V) :=
          Ideal.span {MvPolynomial.X (0 : Fin 2) * MvPolynomial.X 1 - MvPolynomial.C a}
        let S_nod : Type u := MvPolynomial (Fin 2) ↥V ⧸ I_nod
        have hAlgFP : Algebra.FinitePresentation ↥V S_nod :=
          Algebra.FinitePresentation.quotient (Submodule.fg_span_singleton _)
        let C_nod := @algebraMap ↥V S_nod CommRing.toCommSemiring CommRing.toCommSemiring.toSemiring inferInstance
        have hFP_nod : RingHom.FinitePresentation C_nod :=
          (@RingHom.finitePresentation_algebraMap ↥V S_nod _ _ inferInstance).mpr hAlgFP
        have hψC_nod : ψ.comp C_nod = φ_VR :=
          RingHom.ext fun y => DFunLike.congr_fun hψC y
        obtain ⟨hFP_VB, W_open, e, hmem, hEt_e, hcomm⟩ :=
          hLocChart C_nod hFP_nod ψ g₀ hψC_nod hLoc
        have hC_eq : CommRingCat.ofHom C_nod =
            CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C) :=
          congrArg CommRingCat.ofHom (RingHom.ext fun _ => rfl)
        rw [hC_eq] at hcomm
        exact ⟨hFP_VB, fun y => Or.inr ⟨W_open, a, e, hmem y, ha_nz, hEt_e, hcomm⟩⟩
    obtain ⟨hFP_VB, hCharts⟩ := hFP_and_Charts
    have hLFP_gB : AlgebraicGeometry.LocallyOfFinitePresentation g_B :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFinitePresentation)).mpr hFP_VB
    refine ⟨⟨inferInstance, hFlat_gB, inferInstance, hLFP_gB, hCharts⟩, ?_⟩
    letI : Algebra ↥V ↥B := φ_VB.toAlgebra
    have hFT_VB : Algebra.FiniteType ↥V ↥B :=
      RingHom.finiteType_algebraMap.mp (RingHom.FiniteType.of_finitePresentation hFP_VB)
    obtain ⟨s_B, hs_B⟩ := hFT_VB.out
    classical
    let G : Finset F := (s_B.image B.subtype).erase 0
    have hG_prop : ∀ f ∈ G, f ∈ B ∧ f ≠ 0 := by
      intro f hf
      obtain ⟨hf_ne, hf_img⟩ := Finset.mem_erase.mp hf
      obtain ⟨b, _, rfl⟩ := Finset.mem_image.mp hf_img
      exact ⟨b.2, hf_ne⟩
    refine ⟨G, hG_prop, ?_⟩
    let C : Subring F :=
      Subring.closure (Set.range ((algebraMap K F).comp V.subtype) ∪ S_extra ∪ (G : Set F))
    apply le_antisymm
    · refine Subring.closure_le.mpr (Set.union_subset (Set.union_subset ?_ hS_extra) ?_)
      · rintro _ ⟨y, rfl⟩
        exact hVB y
      · intro f hf
        exact (hG_prop f hf).1
    · let A' : Subalgebra ↥V ↥B :=
        { carrier := {b : ↥B | (b : F) ∈ C}
          mul_mem' := fun ha hb => C.mul_mem ha hb
          one_mem' := C.one_mem
          add_mem' := fun ha hb => C.add_mem ha hb
          zero_mem' := C.zero_mem
          algebraMap_mem' := fun y =>
            Subring.subset_closure (Or.inl (Or.inl ⟨y, rfl⟩)) }
      have hs_sub : (↑s_B : Set ↥B) ⊆ A' := by
        intro b hb
        show (b : F) ∈ C
        by_cases hb0 : (b : F) = 0
        · rw [hb0]
          exact C.zero_mem
        · apply Subring.subset_closure
          exact Or.inr (Finset.mem_erase.mpr ⟨hb0, Finset.mem_image_of_mem _ hb⟩)
      have htop : (⊤ : Subalgebra ↥V ↥B) ≤ A' := by
        rw [← hs_B]
        exact Algebra.adjoin_le hs_sub
      intro x hx
      exact htop (Algebra.mem_top (x := (⟨x, hx⟩ : ↥B)))

  
  have hTychonoff :
      ∀ (ι : Type u) (F_fin : ι → Finset F),
        (∀ (W : ValuationSubring F),
          (∀ y : ↥V, ((algebraMap K F).comp V.subtype) y ∈ W) →
          ∃ i : ι, ∀ f ∈ F_fin i, f ∈ W) →
        ∃ (r₀ : ℕ) (idx : Fin r₀ → ι),
          ∀ (W : ValuationSubring F),
            (∀ y : ↥V, ((algebraMap K F).comp V.subtype) y ∈ W) →
            ∃ a : Fin r₀, ∀ f ∈ F_fin (idx a), f ∈ W := by
    intro ι F_fin hCover
    let vMap : ↥V →+* F := (algebraMap K F).comp V.subtype
    let eqSet : F → Bool → Set (F → Bool) := fun f b₀ => {χ : F → Bool | χ f = b₀}
    have hClosed_eq : ∀ (f : F) (b₀ : Bool), IsClosed (eqSet f b₀) :=
      fun f _ => isClosed_eq (continuous_apply f) continuous_const
    let S₁ : Set (F → Bool) := eqSet 0 true
    let S₂ : Set (F → Bool) := eqSet 1 true
    let S₃ : Set (F → Bool) := ⋂ (a : F) (b : F), (eqSet a false ∪ eqSet b false) ∪ eqSet (a + b) true
    let S₄ : Set (F → Bool) := ⋂ (a : F), eqSet a false ∪ eqSet (-a) true
    let S₅ : Set (F → Bool) := ⋂ (a : F) (b : F), (eqSet a false ∪ eqSet b false) ∪ eqSet (a * b) true
    let S₆ : Set (F → Bool) := ⋂ (a : F), eqSet a true ∪ eqSet a⁻¹ true
    let S₇ : Set (F → Bool) := ⋂ (y : ↥V), eqSet (vMap y) true
    let S_RZ : Set (F → Bool) := S₁ ∩ S₂ ∩ S₃ ∩ S₄ ∩ S₅ ∩ S₆ ∩ S₇
    have hClosed_RZ : IsClosed S_RZ := by
      refine ((((((hClosed_eq 0 true).inter (hClosed_eq 1 true)).inter ?_).inter ?_).inter ?_).inter ?_).inter ?_
      · exact isClosed_iInter fun a => isClosed_iInter fun b =>
          ((hClosed_eq a false).union (hClosed_eq b false)).union (hClosed_eq (a + b) true)
      · exact isClosed_iInter fun a => (hClosed_eq a false).union (hClosed_eq (-a) true)
      · exact isClosed_iInter fun a => isClosed_iInter fun b =>
          ((hClosed_eq a false).union (hClosed_eq b false)).union (hClosed_eq (a * b) true)
      · exact isClosed_iInter fun a => (hClosed_eq a true).union (hClosed_eq a⁻¹ true)
      · exact isClosed_iInter fun y => hClosed_eq (vMap y) true
    have hCompact_RZ : IsCompact S_RZ := hClosed_RZ.isCompact
    let O : ι → Set (F → Bool) := fun i => ⋂ f ∈ F_fin i, eqSet f true
    have hOpen_O : ∀ i : ι, IsOpen (O i) := fun i =>
      isOpen_biInter_finset fun f _ => by
        have heq : eqSet f true = (eqSet f false)ᶜ := by
          ext χ
          simp [eqSet]
        rw [heq]
        exact (hClosed_eq f false).isOpen_compl
    have hSub : S_RZ ⊆ ⋃ i : ι, O i := by
      intro χ hχ
      rcases hχ with ⟨⟨⟨⟨⟨⟨h0, h1⟩, hadd⟩, hneg⟩, hmul⟩, hinv⟩, hv⟩
      let W_χ : ValuationSubring F :=
        { carrier := {f : F | χ f = true}
          mul_mem' := by
            intro a b ha hb
            rcases Set.mem_iInter.mp (Set.mem_iInter.mp hmul a) b with (ha' | hb') | hab
            · exfalso; exact Bool.false_ne_true (ha'.symm.trans ha)
            · exfalso; exact Bool.false_ne_true (hb'.symm.trans hb)
            · exact hab
          one_mem' := h1
          add_mem' := by
            intro a b ha hb
            rcases Set.mem_iInter.mp (Set.mem_iInter.mp hadd a) b with (ha' | hb') | hab
            · exfalso; exact Bool.false_ne_true (ha'.symm.trans ha)
            · exfalso; exact Bool.false_ne_true (hb'.symm.trans hb)
            · exact hab
          zero_mem' := h0
          neg_mem' := by
            intro a ha
            rcases Set.mem_iInter.mp hneg a with ha' | hna
            · exfalso; exact Bool.false_ne_true (ha'.symm.trans ha)
            · exact hna
          mem_or_inv_mem' := fun a => Set.mem_iInter.mp hinv a }
      obtain ⟨i, hi⟩ := hCover W_χ (fun y => Set.mem_iInter.mp hv y)
      exact Set.mem_iUnion.mpr ⟨i, Set.mem_iInter₂.mpr (fun f hf => hi f hf)⟩
    obtain ⟨t, ht⟩ := hCompact_RZ.elim_finite_subcover O hOpen_O hSub
    refine ⟨t.card, fun a => ((Finset.equivFin t).symm a).1, ?_⟩
    intro W hVW
    classical
    let χ_W : F → Bool := fun f => decide (f ∈ W)
    have hχW_mem : χ_W ∈ S_RZ := by
      refine ⟨⟨⟨⟨⟨⟨decide_eq_true W.toSubring.zero_mem, decide_eq_true W.toSubring.one_mem⟩, ?_⟩, ?_⟩, ?_⟩, ?_⟩, ?_⟩
      · refine Set.mem_iInter.mpr fun a => Set.mem_iInter.mpr fun b => ?_
        by_cases ha : a ∈ W
        · by_cases hb : b ∈ W
          · exact Or.inr (decide_eq_true (W.toSubring.add_mem ha hb))
          · exact Or.inl (Or.inr (decide_eq_false hb))
        · exact Or.inl (Or.inl (decide_eq_false ha))
      · refine Set.mem_iInter.mpr fun a => ?_
        by_cases ha : a ∈ W
        · exact Or.inr (decide_eq_true (W.toSubring.neg_mem ha))
        · exact Or.inl (decide_eq_false ha)
      · refine Set.mem_iInter.mpr fun a => Set.mem_iInter.mpr fun b => ?_
        by_cases ha : a ∈ W
        · by_cases hb : b ∈ W
          · exact Or.inr (decide_eq_true (W.toSubring.mul_mem ha hb))
          · exact Or.inl (Or.inr (decide_eq_false hb))
        · exact Or.inl (Or.inl (decide_eq_false ha))
      · refine Set.mem_iInter.mpr fun a => ?_
        rcases ValuationSubring.mem_or_inv_mem W a with ha | ha_inv
        · exact Or.inl (decide_eq_true ha)
        · exact Or.inr (decide_eq_true ha_inv)
      · exact Set.mem_iInter.mpr fun y => decide_eq_true (hVW y)
    obtain ⟨i, hi_mem⟩ := Set.mem_iUnion.mp (ht hχW_mem)
    obtain ⟨hi_t, hi_O⟩ := Set.mem_iUnion.mp hi_mem
    let a : Fin t.card := Finset.equivFin t ⟨i, hi_t⟩
    refine ⟨a, fun f hf => ?_⟩
    have ha_eq : ((Finset.equivFin t).symm a).1 = i := by
      simp [a]
    dsimp only at hf
    rw [ha_eq] at hf
    exact of_decide_eq_true (Set.mem_iInter₂.mp hi_O f hf)

  
  let ι : Type u := {W : ValuationSubring F // ∀ y : ↥V, ((algebraMap K F).comp V.subtype) y ∈ W}
  have hPointwise :
      ∀ w : ι,
        ∃ (r_w : Fin (M₀ + 1))
          (B_w : Subring F)
          (hVB_w : ∀ y : ↥V, ((algebraMap K F).comp V.subtype) y ∈ B_w)
          (G_w : Finset F),
          ξ r_w ≠ 0 ∧
          (∀ s : Fin (M₀ + 1), ξ s / ξ r_w ∈ B_w) ∧
          (∀ f ∈ G_w, f ∈ B_w ∧ f ≠ 0) ∧
          Subring.closure
            (Set.range ((algebraMap K F).comp V.subtype) ∪
              Set.range (fun s : Fin (M₀ + 1) => ξ s / ξ r_w) ∪
              (G_w : Set F)) = B_w ∧
          IsStrictlySemistableCurveOverValuation V
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (RingHom.codRestrict ((algebraMap K F).comp V.subtype) B_w hVB_w))) ∧
          (∀ b ∈ B_w, b ∈ w.1) := by
    intro w
    let W := w.1
    have hVW := w.2
    obtain ⟨r_w, hr_nz, hr_W⟩ := hCoordNorm W
    have hkW : ∀ c : k, algebraMap k F c ∈ W := by
      intro c
      rw [IsScalarTower.algebraMap_apply k K F c]
      exact hVW ⟨algebraMap k K c, hkV c⟩
    obtain ⟨x, hxW, hx_tr, hEt_W⟩ := (hUnif W hkW).2.2
    let Lx := IntermediateField.adjoin K ({x} : Set F)
    let Vx : ValuationSubring ↥Lx := W.comap Lx.val.toRingHom
    have hVVx : ∀ y : ↥V, ((algebraMap K ↥Lx).comp V.subtype) y ∈ Vx := by
      intro y
      show Lx.val (((algebraMap K ↥Lx).comp V.subtype) y) ∈ W
      rw [RingHom.comp_apply, Lx.val.commutes]
      exact hVW y
    have hxVx : (⟨x, IntermediateField.mem_adjoin_simple_self K x⟩ : ↥Lx) ∈ Vx := hxW
    have hChart_x : ∀ (S₀ : Finset ↥Lx), (∀ z ∈ S₀, z ∈ Vx) →
        ∃ (R : Subring ↥Lx) (hVR : ∀ y : ↥V, ((algebraMap K ↥Lx).comp V.subtype) y ∈ R),
          (∀ r ∈ R, r ∈ Vx) ∧ (∀ z ∈ S₀, z ∈ R) ∧
          HasStandardSemistableLocalizationPresentation V R hVR := by
      intro S₀ hS₀
      obtain ⟨R, hVR, hRVx, _, hS₀R, hPres⟩ := hChartApprox x hx_tr Vx hVVx hxVx S₀ hS₀
      exact ⟨R, hVR, hRVx, hS₀R, hPres⟩
    obtain ⟨T₀, hT₀_W, hT₀_mem⟩ :
        ∃ T₀ : Finset F, (∀ f ∈ T₀, f ∈ W) ∧ (∀ s : Fin (M₀ + 1), ξ s / ξ r_w ∈ T₀) := by
      classical
      refine ⟨Finset.univ.image (fun s : Fin (M₀ + 1) => ξ s / ξ r_w), ?_,
        fun s => Finset.mem_image_of_mem _ (Finset.mem_univ s)⟩
      intro f hf
      obtain ⟨s, _, rfl⟩ := Finset.mem_image.mp hf
      exact hr_W s
    obtain ⟨R, hVR, B_w, hVB_w, φ_RB, hPres, hBW, hT₀B, hEt_RB, hComm_RB⟩ :=
      hEtaleDescent ↥Lx Lx.val W hVW hEt_W (HasStandardSemistableLocalizationPresentation V)
        hChart_x T₀ hT₀_W
    have hRatios_B : ∀ s : Fin (M₀ + 1), ξ s / ξ r_w ∈ B_w :=
      fun s => hT₀B _ (hT₀_mem s)
    have hSextra_B : Set.range (fun s : Fin (M₀ + 1) => ξ s / ξ r_w) ⊆ (B_w : Set F) := by
      rintro _ ⟨s, rfl⟩
      exact hRatios_B s
    obtain ⟨hCurve_w, G_w, hGw_prop, hClos_w⟩ :=
      hCurveAndFG ↥Lx R hVR hPres B_w hVB_w φ_RB hEt_RB hComm_RB
        (Set.range (fun s : Fin (M₀ + 1) => ξ s / ξ r_w)) hSextra_B
    exact ⟨r_w, B_w, hVB_w, G_w, hr_nz, hRatios_B, hGw_prop, hClos_w, hCurve_w, hBW⟩
  choose r_w B_w hVB_w G_w hr_nz hRatios_B hGw_prop hClos_w hCurve_w hBW using hPointwise
  classical
  let F_fin : ι → Finset F :=
    fun w => Finset.univ.image (fun s : Fin (M₀ + 1) => ξ s / ξ (r_w w)) ∪ G_w w
  have hFinCover : ∀ (W : ValuationSubring F),
      (∀ y : ↥V, ((algebraMap K F).comp V.subtype) y ∈ W) →
      ∃ w : ι, ∀ f ∈ F_fin w, f ∈ W := by
    intro W hVW
    refine ⟨⟨W, hVW⟩, fun f hf => ?_⟩
    rcases Finset.mem_union.mp hf with hf_rat | hf_G
    · obtain ⟨s, _, rfl⟩ := Finset.mem_image.mp hf_rat
      exact hBW ⟨W, hVW⟩ _ (hRatios_B ⟨W, hVW⟩ s)
    · exact hBW ⟨W, hVW⟩ f (hGw_prop ⟨W, hVW⟩ f hf_G).1
  obtain ⟨r₀, idx, hSubcover⟩ := hTychonoff ι F_fin hFinCover
  refine ⟨r₀, fun i => r_w (idx i), fun i => B_w (idx i), fun i => hVB_w (idx i),
    fun i => G_w (idx i), fun i => hr_nz (idx i), fun i s => hRatios_B (idx i) s,
    fun i f hf => hGw_prop (idx i) f hf, fun i => hClos_w (idx i),
    fun i => hCurve_w (idx i), ?_⟩
  intro W hVW
  obtain ⟨i, hi⟩ := hSubcover W hVW
  refine ⟨i, ?_⟩
  change B_w (idx i) ≤ W.toSubring
  rw [← hClos_w (idx i)]
  refine Subring.closure_le.mpr (Set.union_subset (Set.union_subset ?_ ?_) ?_)
  · rintro _ ⟨y, rfl⟩
    exact hVW y
  · rintro _ ⟨s, rfl⟩
    exact hi _ (Finset.mem_union_left _ (Finset.mem_image_of_mem _ (Finset.mem_univ s)))
  · intro f hf
    exact hi f (Finset.mem_union_right _ hf)

theorem weil_commRing_projectiveSpace_chart_and_baseChange_pkg : ∃ (hAff : ∀ (R : Type u) [CommRing R] (N : ℕ) (a : Fin (N + 1)),
        AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen R N a))
      (c_proj : ∀ (R : Type u) [CommRing R] (N : ℕ) (a : Fin (N + 1)),
        R →+* ↑((weilProjectiveSpaceOver R N).left.presheaf.obj
          (Opposite.op (weilProjBasicOpen R N a))))
      (t_proj : ∀ (R : Type u) [CommRing R] (N : ℕ) (a : Fin (N + 1)), Fin (N + 1) →
        ↑((weilProjectiveSpaceOver R N).left.presheaf.obj
          (Opposite.op (weilProjBasicOpen R N a)))),
      (∀ (R : Type u) [CommRing R] (N : ℕ),
        IsCommRingProjCoordSystem R N (hAff R N) (c_proj R N) (t_proj R N)) ∧
      (∀ (R S : Type u) [CommRing R] [CommRing S] (φ_RS : R →+* S) (N : ℕ),
        ∃ (Φ : (weilProjectiveSpaceOver S N).left ⟶ (weilProjectiveSpaceOver R N).left),
          IsCommRingProjBaseChange R S φ_RS N
            (c_proj R N) (t_proj R N) (c_proj S N) (t_proj S N) Φ) :=
by
  classical
  
  let hX_mem : ∀ (R : Type u) [CommRing R] (N : ℕ) (b : Fin (N + 1)),
      MvPolynomial.X b ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R 1 :=
    fun R _ _ b => (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X R b)
  
  let hAff : ∀ (R : Type u) [CommRing R] (N : ℕ) (a : Fin (N + 1)),
      AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen R N a) :=
    fun R _ N a => by
      let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R
      let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
      exact AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜
        (MvPolynomial.X a) (hX_mem R N a) zero_lt_one
  let c_proj : ∀ (R : Type u) [CommRing R] (N : ℕ) (a : Fin (N + 1)),
      R →+* ↑((weilProjectiveSpaceOver R N).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen R N a))) :=
    fun R _ N a =>
      let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R
      letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
      (AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X a)).hom.comp
        ((HomogeneousLocalization.fromZeroRingHom 𝒜
          (Submonoid.powers (MvPolynomial.X a))).comp (algebraMap R ↥(𝒜 0)))
  let t_proj : ∀ (R : Type u) [CommRing R] (N : ℕ) (a : Fin (N + 1)), Fin (N + 1) →
      ↑((weilProjectiveSpaceOver R N).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen R N a))) :=
    fun R _ N a b =>
      let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R
      letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
      (AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X a)).hom
        (HomogeneousLocalization.Away.mk 𝒜 (hX_mem R N a) 1 (MvPolynomial.X b) (hX_mem R N b))
  
  have halg0 : ∀ (R : Type u) [CommRing R] (N : ℕ) (r : R),
      (algebraMap R ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R 0) r :
        MvPolynomial (Fin (N + 1)) R) = MvPolynomial.C r := by
    intro R _ N r
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    rw [Algebra.algebraMap_eq_smul_one]
    change r • (1 : MvPolynomial (Fin (N + 1)) R) = MvPolynomial.C r
    rw [Algebra.smul_def, mul_one, MvPolynomial.algebraMap_eq]
  
  have hProperCover : ∀ (R : Type u) [CommRing R] (N : ℕ),
      AlgebraicGeometry.IsProper (weilProjectiveSpaceOver R N).hom ∧
      (let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R
       let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
       (HomogeneousIdeal.irrelevant 𝒜).toIdeal ≤
         Ideal.span (Set.range (MvPolynomial.X : Fin (N + 1) → MvPolynomial (Fin (N + 1)) R))) ∧
      (⨆ a : Fin (N + 1), weilProjBasicOpen R N a) = ⊤ := by
    intro R _ N
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have hinj : Function.Injective (algebraMap R ↥(𝒜 0)) := by
      intro r₁ r₂ h
      have h1 : (algebraMap R ↥(𝒜 0) r₁ : MvPolynomial (Fin (N + 1)) R) =
          (algebraMap R ↥(𝒜 0) r₂ : MvPolynomial (Fin (N + 1)) R) := congrArg Subtype.val h
      rw [halg0 R N, halg0 R N] at h1
      simpa using congrArg MvPolynomial.constantCoeff h1
    have hsurj : Function.Surjective (algebraMap R ↥(𝒜 0)) := by
      intro p
      refine ⟨p.1.coeff 0, Subtype.ext ?_⟩
      rw [halg0 R N]
      ext m
      by_cases hm : m = 0
      · subst hm
        simp
      · rw [MvPolynomial.coeff_C, if_neg (Ne.symm hm)]
        symm
        by_contra hne
        have hp : p.1.IsHomogeneous 0 := (MvPolynomial.mem_homogeneousSubmodule 0 p.1).mp p.2
        have hdeg := hp hne
        simp only [Finsupp.weight_apply, Finsupp.sum, smul_eq_mul, Pi.one_apply, mul_one] at hdeg
        have hne' : ∃ i : Fin (N + 1), m i ≠ 0 := by
          by_contra hall
          exact hm (Finsupp.ext fun i => Classical.not_not.mp fun h => hall ⟨i, h⟩)
        rcases hne' with ⟨i, hi⟩
        have hmem : i ∈ m.support := Finsupp.mem_support_iff.mpr hi
        have hzero : m i = 0 := (Finset.sum_eq_zero_iff.mp hdeg) i hmem
        exact hi hzero
    let e₀ : R ≃+* ↥(𝒜 0) := RingEquiv.ofBijective (algebraMap R ↥(𝒜 0)) ⟨hinj, hsurj⟩
    have he₀ : CommRingCat.ofHom (algebraMap R ↥(𝒜 0)) = e₀.toCommRingCatIso.hom := by
      apply CommRingCat.hom_ext
      rfl
    have _ : CategoryTheory.IsIso (CommRingCat.ofHom (algebraMap R ↥(𝒜 0))) := by
      rw [he₀]
      infer_instance
    have _ : CategoryTheory.IsIso
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R ↥(𝒜 0)))) :=
      inferInstance
    let _ : IsScalarTower R ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) R) :=
      IsScalarTower.of_algebraMap_eq' (R := R) (S := ↥(𝒜 0))
        (A := MvPolynomial (Fin (N + 1)) R) (RingHom.ext fun r => by
          change algebraMap R (MvPolynomial (Fin (N + 1)) R) r =
            (algebraMap R ↥(𝒜 0) r : MvPolynomial (Fin (N + 1)) R)
          rw [halg0 R N, MvPolynomial.algebraMap_eq])
    have _ : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) R) :=
      Algebra.FiniteType.of_restrictScalars_finiteType R ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) R)
    have hProp : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver R N).hom := by
      change AlgebraicGeometry.IsProper
        (AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R ↥(𝒜 0))))
      infer_instance
    have hIrrel : (HomogeneousIdeal.irrelevant 𝒜).toIdeal ≤
        Ideal.span (Set.range (MvPolynomial.X : Fin (N + 1) → MvPolynomial (Fin (N + 1)) R)) := by
      intro p hp
      have hp0_proj : GradedRing.proj 𝒜 0 p = 0 :=
        (HomogeneousIdeal.mem_irrelevant_iff 𝒜 p).mp hp
      have hp_sum : (∑ i ∈ (DirectSum.decompose 𝒜 p).support,
          (DirectSum.decompose 𝒜 p i : MvPolynomial (Fin (N + 1)) R)) = p :=
        DirectSum.sum_support_decompose 𝒜 p
      have hcoeff0 : p.coeff 0 = 0 := by
        rw [← hp_sum, MvPolynomial.coeff_sum]
        apply Finset.sum_eq_zero
        intro i _
        by_cases hi : i = 0
        · subst hi
          have h0 : (DirectSum.decompose 𝒜 p 0 : MvPolynomial (Fin (N + 1)) R) = 0 := hp0_proj
          rw [h0]
          simp
        · have hmem_i : (DirectSum.decompose 𝒜 p i : MvPolynomial (Fin (N + 1)) R) ∈ 𝒜 i :=
            (DirectSum.decompose 𝒜 p i).2
          have hhom_i : (DirectSum.decompose 𝒜 p i : MvPolynomial (Fin (N + 1)) R).IsHomogeneous i :=
            (MvPolynomial.mem_homogeneousSubmodule i _).mp hmem_i
          by_contra hne0
          have hdeg0 := hhom_i hne0
          simp only [Finsupp.weight_apply, Finsupp.sum_zero_index] at hdeg0
          exact hi hdeg0.symm
      have hrange : (Set.range (MvPolynomial.X : Fin (N + 1) → MvPolynomial (Fin (N + 1)) R)) =
          MvPolynomial.X '' (Set.univ : Set (Fin (N + 1))) := Set.image_univ.symm
      rw [hrange, MvPolynomial.mem_ideal_span_X_image]
      intro m hm
      have hm_ne : m ≠ 0 := by
        intro hm0
        subst hm0
        exact (MvPolynomial.mem_support_iff.mp hm) hcoeff0
      have hex : ∃ a : Fin (N + 1), m a ≠ 0 := by
        by_contra hall
        exact hm_ne (Finsupp.ext fun a => Classical.not_not.mp fun h => hall ⟨a, h⟩)
      rcases hex with ⟨a, ha⟩
      exact ⟨a, Set.mem_univ a, ha⟩
    have hCov : (⨆ a : Fin (N + 1), weilProjBasicOpen R N a) = ⊤ :=
      AlgebraicGeometry.Proj.iSup_basicOpen_eq_top 𝒜 MvPolynomial.X hIrrel
    exact ⟨hProp, hIrrel, hCov⟩
  
  have hDehom : ∀ (R : Type u) [CommRing R] (N : ℕ) (a : Fin (N + 1))
      (x : MvPolynomial (Fin (N + 1)) R) (hx : x = MvPolynomial.X a),
      let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R
      let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
      ∃ (e : MvPolynomial {b : Fin (N + 1) // b ≠ a} R ≃+* HomogeneousLocalization.Away 𝒜 x),
        (∀ r : R, e (MvPolynomial.C r) =
          HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers x)
            (algebraMap R ↥(𝒜 0) r)) ∧
        (∀ b : {b : Fin (N + 1) // b ≠ a}, e (MvPolynomial.X b) =
          HomogeneousLocalization.Away.mk 𝒜 (hx ▸ hX_mem R N a) 1
            (MvPolynomial.X b.1) (hX_mem R N b.1)) := by
    intro R _ N a x hx
    subst hx
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    let τ := {b : Fin (N + 1) // b ≠ a}
    let X_a : MvPolynomial (Fin (N + 1)) R := MvPolynomial.X a
    let S_a : Submonoid (MvPolynomial (Fin (N + 1)) R) := Submonoid.powers X_a
    let ι_a : R →+* HomogeneousLocalization.Away 𝒜 X_a :=
      (HomogeneousLocalization.fromZeroRingHom 𝒜 S_a).comp (algebraMap R ↥(𝒜 0))
    let t_tilde : Fin (N + 1) → HomogeneousLocalization.Away 𝒜 X_a :=
      fun c => HomogeneousLocalization.Away.mk 𝒜 (hX_mem R N a) 1
        (MvPolynomial.X c) (hX_mem R N c)
    let α : MvPolynomial τ R →+* HomogeneousLocalization.Away 𝒜 X_a :=
      MvPolynomial.eval₂Hom ι_a (fun b : τ => t_tilde b.1)
    let w : Fin (N + 1) → MvPolynomial τ R :=
      fun j => if h : j = a then 1 else MvPolynomial.X ⟨j, h⟩
    let dehom : MvPolynomial (Fin (N + 1)) R →+* MvPolynomial τ R :=
      MvPolynomial.eval₂Hom MvPolynomial.C w
    have hdehom_Xa : dehom X_a = 1 := by
      simp [dehom, w, X_a]
    have hdehom_S : ∀ y : S_a, dehom y.1 = 1 := by
      rintro ⟨_, n, rfl⟩
      simp [map_pow, hdehom_Xa]
    have hy_unit : ∀ y : S_a, IsUnit (dehom y.1) := fun y => by
      rw [hdehom_S y]
      exact isUnit_one
    let β_loc : Localization S_a →+* MvPolynomial τ R := IsLocalization.lift hy_unit
    have hβ_loc_mk : ∀ (p : MvPolynomial (Fin (N + 1)) R) (y : S_a),
        β_loc (Localization.mk p y) = dehom p := by
      intro p y
      rw [Localization.mk_eq_mk']
      dsimp only [β_loc]
      rw [IsLocalization.lift_mk'_spec, hdehom_S y, one_mul]
    let valHom : HomogeneousLocalization.Away 𝒜 X_a →+* Localization S_a :=
      { toFun := HomogeneousLocalization.val
        map_one' := HomogeneousLocalization.val_one
        map_mul' := fun u v => HomogeneousLocalization.val_mul u v
        map_zero' := HomogeneousLocalization.val_zero
        map_add' := fun u v => HomogeneousLocalization.val_add u v }
    let β : HomogeneousLocalization.Away 𝒜 X_a →+* MvPolynomial τ R :=
      β_loc.comp valHom
    have hval_ι : ∀ r : R, (ι_a r).val = Localization.mk (MvPolynomial.C r) 1 := by
      intro r
      change (HomogeneousLocalization.mk
        ⟨0, algebraMap R ↥(𝒜 0) r, 1, Submonoid.one_mem S_a⟩).val =
        Localization.mk (MvPolynomial.C r) 1
      rw [HomogeneousLocalization.val_mk, halg0 R N r]
      rfl
    have hleft : Function.LeftInverse β α := by
      have hcomp : β.comp α = RingHom.id (MvPolynomial τ R) := by
        apply MvPolynomial.ringHom_ext'
        · apply RingHom.ext
          intro r
          simp only [RingHom.comp_apply, RingHom.id_apply, α, MvPolynomial.eval₂Hom_C, β, valHom,
            RingHom.coe_mk, MonoidHom.coe_mk, OneHom.coe_mk, hval_ι, hβ_loc_mk, dehom]
        · intro b
          simp only [RingHom.comp_apply, RingHom.id_apply, α, MvPolynomial.eval₂Hom_X', β, valHom,
            RingHom.coe_mk, MonoidHom.coe_mk, OneHom.coe_mk, t_tilde,
            HomogeneousLocalization.Away.val_mk, hβ_loc_mk, dehom, MvPolynomial.eval₂Hom_X', w,
            dif_neg b.2, Subtype.coe_eta]
      intro q
      exact RingHom.congr_fun hcomp q
    have hright : Function.RightInverse β α := by
      intro z
      rcases subsingleton_or_nontrivial R with hSub | hNontriv
      · have _ : Subsingleton R := hSub
        apply HomogeneousLocalization.val_injective S_a
        exact Subsingleton.elim _ _
      · have _ : Nontrivial R := hNontriv
        let φ : MvPolynomial (Fin (N + 1)) R →+* Localization S_a :=
          valHom.comp (α.comp dehom)
        have hφ_C : ∀ r : R, φ (MvPolynomial.C r) = Localization.mk (MvPolynomial.C r) 1 := by
          intro r
          simp [φ, dehom, α, valHom, hval_ι]
        have hφ_X : ∀ j : Fin (N + 1),
            φ (MvPolynomial.X j) =
              Localization.mk (MvPolynomial.X j) ⟨X_a, Submonoid.mem_powers X_a⟩ := by
          intro j
          by_cases hj : j = a
          · subst hj
            have h1 : φ X_a = 1 := by simp [φ, hdehom_Xa]
            rw [h1]
            exact (Localization.mk_self (⟨X_a, Submonoid.mem_powers X_a⟩ : S_a)).symm
          · have h2 : φ (MvPolynomial.X j) = (t_tilde j).val := by
              simp [φ, dehom, w, dif_neg hj, α, valHom]
            rw [h2, HomogeneousLocalization.Away.val_mk]
            congr 1
            apply Subtype.ext
            exact pow_one X_a
        have hφ_prod : ∀ (d : Fin (N + 1) →₀ ℕ) (s : Finset (Fin (N + 1))),
            φ (∏ j ∈ s, MvPolynomial.X j ^ d j) =
              Localization.mk (∏ j ∈ s, MvPolynomial.X j ^ d j)
                ⟨X_a ^ (∑ j ∈ s, d j),
                  S_a.pow_mem (Submonoid.mem_powers X_a) (∑ j ∈ s, d j)⟩ := by
          intro d s
          induction s using Finset.induction_on with
          | empty =>
            simp
          | @insert j s hj ih =>
            rw [Finset.prod_insert hj, Finset.sum_insert hj, map_mul, map_pow, hφ_X j, ih,
              Localization.mk_pow, Localization.mk_mul]
            congr 1
            apply Subtype.ext
            change X_a ^ d j * X_a ^ (∑ i ∈ s, d i) = X_a ^ (d j + ∑ i ∈ s, d i)
            rw [← pow_add]
        have hφ_monomial : ∀ (d : Fin (N + 1) →₀ ℕ) (c : R),
            φ (MvPolynomial.monomial d c) =
              Localization.mk (MvPolynomial.monomial d c)
                ⟨X_a ^ (∑ j ∈ d.support, d j),
                  S_a.pow_mem (Submonoid.mem_powers X_a) (∑ j ∈ d.support, d j)⟩ := by
          intro d c
          rw [MvPolynomial.monomial_eq, Finsupp.prod, map_mul, hφ_C c, hφ_prod d d.support,
            Localization.mk_mul]
          congr 1
          apply Subtype.ext
          exact one_mul _
        have hφ_homog : ∀ (n : ℕ) (p : MvPolynomial (Fin (N + 1)) R),
            p.IsHomogeneous n →
            φ p = Localization.mk p
              ⟨X_a ^ n, S_a.pow_mem (Submonoid.mem_powers X_a) n⟩ := by
          intro n p hp
          let y_n : S_a := ⟨X_a ^ n, S_a.pow_mem (Submonoid.mem_powers X_a) n⟩
          have hsum_eq : ∀ s : Finset (Fin (N + 1) →₀ ℕ),
              (∀ d ∈ s, (∑ j ∈ d.support, d j) = n) →
              φ (∑ d ∈ s, MvPolynomial.monomial d (p.coeff d)) =
                Localization.mk (∑ d ∈ s, MvPolynomial.monomial d (p.coeff d)) y_n := by
            intro s
            induction s using Finset.induction_on with
            | empty =>
              intro _
              simp [Localization.mk_zero]
            | @insert d s hd ih =>
              intro hs
              have hd_n : (∑ j ∈ d.support, d j) = n := hs d (Finset.mem_insert_self d s)
              have hs_n : ∀ d' ∈ s, (∑ j ∈ d'.support, d' j) = n :=
                fun d' hd' => hs d' (Finset.mem_insert_of_mem hd')
              rw [Finset.sum_insert hd, map_add, hφ_monomial d (p.coeff d), ih hs_n]
              have hy_eq : (⟨X_a ^ (∑ j ∈ d.support, d j),
                  S_a.pow_mem (Submonoid.mem_powers X_a) (∑ j ∈ d.support, d j)⟩ : S_a) = y_n := by
                apply Subtype.ext
                exact congrArg (X_a ^ ·) hd_n
              rw [hy_eq, Localization.add_mk_self]
          have hp_supp : ∀ d ∈ p.support, (∑ j ∈ d.support, d j) = n := by
            intro d hd
            have hdeg := hp (MvPolynomial.mem_support_iff.mp hd)
            simpa [Finsupp.weight_apply, Finsupp.sum, smul_eq_mul, mul_one] using hdeg
          conv_lhs => rw [MvPolynomial.as_sum p]
          conv_rhs => rw [MvPolynomial.as_sum p]
          exact hsum_eq p.support hp_supp
        obtain ⟨nd, rfl⟩ := HomogeneousLocalization.mk_surjective z
        obtain ⟨n, hn⟩ := nd.den_mem
        dsimp only at hn
        have hXa_pow_ne : X_a ^ n ≠ 0 := by
          intro hzero
          have hev : MvPolynomial.eval (fun _ => (1 : R)) (X_a ^ n) = 0 := by
            rw [hzero, map_zero]
          have hev1 : MvPolynomial.eval (fun _ => (1 : R)) (X_a ^ n) = 1 := by
            simp [X_a]
          exact one_ne_zero (hev1.symm.trans hev)
        have hex_coeff : ∃ d₀ : Fin (N + 1) →₀ ℕ, (X_a ^ n).coeff d₀ ≠ 0 := by
          by_contra hall
          exact hXa_pow_ne (MvPolynomial.ext _ _ fun d₀ => by
            simp [Classical.not_not.mp fun h => hall ⟨d₀, h⟩])
        rcases hex_coeff with ⟨d₀, hd₀⟩
        have hden_hom1 : (X_a ^ n).IsHomogeneous nd.deg := by
          rw [hn]
          exact (MvPolynomial.mem_homogeneousSubmodule nd.deg nd.den.1).mp nd.den.2
        have hden_hom2 : (X_a ^ n).IsHomogeneous n := by
          simpa using (MvPolynomial.isHomogeneous_X R a).pow n
        have hdeg_eq : nd.deg = n := (hden_hom1 hd₀).symm.trans (hden_hom2 hd₀)
        have hnum_hom : nd.num.1.IsHomogeneous n := by
          rw [← hdeg_eq]
          exact (MvPolynomial.mem_homogeneousSubmodule nd.deg nd.num.1).mp nd.num.2
        apply HomogeneousLocalization.val_injective S_a
        have hβ_nd : β (HomogeneousLocalization.mk nd) = dehom nd.num.1 := by
          change β_loc (HomogeneousLocalization.mk nd).val = dehom nd.num.1
          rw [HomogeneousLocalization.val_mk, hβ_loc_mk]
        rw [hβ_nd]
        change φ nd.num.1 = (HomogeneousLocalization.mk nd).val
        rw [hφ_homog n nd.num.1 hnum_hom, HomogeneousLocalization.val_mk]
        congr 1
        apply Subtype.ext
        exact hn
    let e : MvPolynomial τ R ≃+* HomogeneousLocalization.Away 𝒜 X_a :=
      { α with
        invFun := β
        left_inv := hleft
        right_inv := hright }
    refine ⟨e, ?_, ?_⟩
    · intro r
      exact MvPolynomial.eval₂Hom_C ι_a _ r
    · intro b
      exact MvPolynomial.eval₂Hom_X' ι_a _ b
  
  have hBridge : ∀ (R : Type u) [CommRing R] (N : ℕ)
      (f : MvPolynomial (Fin (N + 1)) R)
      (hf : f ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R 1),
      let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R
      letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
      AlgebraicGeometry.Spec.map (AlgebraicGeometry.Proj.awayToSection 𝒜 f) ≫
        AlgebraicGeometry.Proj.awayι 𝒜 f hf zero_lt_one =
      (AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜 f hf zero_lt_one).fromSpec := by
    intro R _ N f hf 𝒜
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    let U : (AlgebraicGeometry.Proj 𝒜).Opens := AlgebraicGeometry.Proj.basicOpen 𝒜 f
    let hU : AlgebraicGeometry.IsAffineOpen U :=
      AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜 f hf zero_lt_one
    let B_f : CommRingCat.{u} := CommRingCat.of (HomogeneousLocalization.Away 𝒜 f)
    have hg_eq : U.toSpecΓ ≫ AlgebraicGeometry.Spec.map
        (AlgebraicGeometry.Proj.awayToSection 𝒜 f) =
        (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 f hf zero_lt_one).hom := by
      rw [AlgebraicGeometry.Proj.basicOpenIsoSpec_hom]
      let g₁ : U.toScheme ⟶ AlgebraicGeometry.Spec B_f :=
        U.toSpecΓ ≫ AlgebraicGeometry.Spec.map (AlgebraicGeometry.Proj.awayToSection 𝒜 f)
      let g₂ : U.toScheme ⟶ AlgebraicGeometry.Spec B_f :=
        AlgebraicGeometry.Proj.basicOpenToSpec 𝒜 f
      change g₁ = g₂
      have happ : g₁.appTop = g₂.appTop := by
        dsimp only [g₁, g₂]
        rw [AlgebraicGeometry.Scheme.Hom.comp_appTop,
          AlgebraicGeometry.Scheme.Opens.toSpecΓ_appTop]
        change (AlgebraicGeometry.Spec.map (AlgebraicGeometry.Proj.awayToSection 𝒜 f)).appTop ≫
            ((AlgebraicGeometry.Scheme.ΓSpecIso _).hom ≫ U.topIso.inv) =
          (AlgebraicGeometry.Proj.basicOpenToSpec 𝒜 f).app ⊤
        rw [AlgebraicGeometry.Proj.basicOpenToSpec_app_top]
        have hnat := AlgebraicGeometry.Scheme.ΓSpecIso_naturality
          (AlgebraicGeometry.Proj.awayToSection 𝒜 f)
        rw [← Category.assoc, hnat, Category.assoc]
      let e_adj := AlgebraicGeometry.ΓSpec.adjunction.homEquiv U.toScheme (Opposite.op B_f)
      apply e_adj.symm.injective
      apply Quiver.Hom.unop_inj
      let φ₁ : B_f ⟶ U.toScheme.presheaf.obj (Opposite.op ⊤) := (e_adj.symm g₁).unop
      let φ₂ : B_f ⟶ U.toScheme.presheaf.obj (Opposite.op ⊤) := (e_adj.symm g₂).unop
      have h1 := AlgebraicGeometry.ΓSpecIso_inv_ΓSpec_adjunction_homEquiv φ₁
      have h2 := AlgebraicGeometry.ΓSpecIso_inv_ΓSpec_adjunction_homEquiv φ₂
      have hg₁ : (AlgebraicGeometry.ΓSpec.adjunction.homEquiv U.toScheme (Opposite.op B_f))
          φ₁.op = g₁ := e_adj.apply_symm_apply g₁
      have hg₂ : (AlgebraicGeometry.ΓSpec.adjunction.homEquiv U.toScheme (Opposite.op B_f))
          φ₂.op = g₂ := e_adj.apply_symm_apply g₂
      rw [hg₁] at h1
      rw [hg₂] at h2
      change φ₁ = φ₂
      rw [← h1, ← h2, happ]
    have hiso_hom : hU.isoSpec.hom = U.toSpecΓ := AlgebraicGeometry.IsAffineOpen.isoSpec_hom hU
    have hspec_eq : AlgebraicGeometry.Spec.map (AlgebraicGeometry.Proj.awayToSection 𝒜 f) =
        hU.isoSpec.inv ≫ (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 f hf zero_lt_one).hom := by
      rw [← hiso_hom] at hg_eq
      rw [← hg_eq, Iso.inv_hom_id_assoc]
