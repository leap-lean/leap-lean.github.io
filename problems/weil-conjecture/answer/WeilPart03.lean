      obtain ⟨_, hθ_ne, hyθ_Vx⟩ := Finset.mem_filter.mp hi
      exact ⟨fun h0 => hθ_ne (Subtype.ext h0), (θ i).2, hq_pos i, hyθ_Vx⟩
    · obtain ⟨f, hf_flt, rfl⟩ := Finset.mem_image.mp hp_S₁
      obtain ⟨hf_nz, hBA, hlam_not⟩ := Finset.mem_filter.mp hf_flt
      obtain ⟨hlam_ne, _, hlam_ratio⟩ := hS₁_laurent f hf_nz
      have hlam_inv_V₁ : (lam f)⁻¹ ∈ V₁ :=
        (ValuationSubring.mem_or_inv_mem V₁ (lam f)).resolve_left hlam_not
      refine ⟨inv_ne_zero hlam_ne, hlam_inv_V₁, by omega, ?_⟩
      have hyB_ne : y₀ ^ (B_exp f) ≠ 0 := pow_ne_zero (B_exp f) hy₀_ne
      have hyA_pow : y₀ ^ (A_exp f) = y₀ ^ (A_exp f - B_exp f) * y₀ ^ (B_exp f) := by
        rw [← pow_add, show A_exp f - B_exp f + B_exp f = A_exp f by omega]
      have h_eq : y₀ ^ (A_exp f - B_exp f) / algebraMap K E (lam f)⁻¹ =
