                exact ⟨a₁ * a₂, Rx.mul_mem ha₁ ha₂, b₁ * b₂, Rx.mul_mem hb₁ hb₂,
                  mul_ne_zero hb₁0 hb₂0, div_mul_div_comm a₁ b₁ a₂ b₂⟩
              one_mem' := ⟨1, Rx.one_mem, 1, Rx.one_mem, one_ne_zero, (div_one 1).symm⟩
              add_mem' := by
                rintro _ _ ⟨a₁, ha₁, b₁, hb₁, hb₁0, rfl⟩ ⟨a₂, ha₂, b₂, hb₂, hb₂0, rfl⟩
                refine ⟨a₁ * b₂ + a₂ * b₁, Rx.add_mem (Rx.mul_mem ha₁ hb₂) (Rx.mul_mem ha₂ hb₁),
                  b₁ * b₂, Rx.mul_mem hb₁ hb₂, mul_ne_zero hb₁0 hb₂0, ?_⟩
                rw [div_add_div a₁ a₂ hb₁0 hb₂0]
