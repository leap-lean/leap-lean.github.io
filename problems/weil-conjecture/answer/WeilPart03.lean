        ext c
        have hmem_iff : (⟨c.1, hVU c.2⟩ : ↥U) ∈ IsLocalRing.maximalIdeal ↥U ↔
            (⟨φ_KF (V.subtype c), hV c⟩ : ↥W) ∈ IsLocalRing.maximalIdeal ↥W := by
          rw [IsLocalRing.mem_maximalIdeal, IsLocalRing.mem_maximalIdeal,
