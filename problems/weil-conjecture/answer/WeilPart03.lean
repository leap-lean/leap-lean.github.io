    · intro b₁ b₂ hb
      exact ⟨1, by simp [hψ₀_inj hb]⟩
  let P : StandardEtalePair ↥V₁ :=
    StandardEtalePair.mk f_V hf_V_monic (f_V.derivative * Polynomial.X)
      ⟨Polynomial.X, 0, 1, by ring⟩
  have hy_map : P.HasMap y_W := ⟨hf_yW, hu_W⟩
  let Φ : P.Ring →ₐ[↥V₁] ↥W₁ := P.lift y_W hy_map
  have hΦ_X : Φ P.X = y_W := P.lift_X y_W hy_map
  have hX_map : P.HasMap P.X := StandardEtalePair.hasMap_X
  let α₀ : B₀ →ₐ[↥V₁] P.Ring := AdjoinRoot.liftAlgHom f_V (Algebra.ofId ↥V₁ P.Ring) P.X hX_map.1
  have hα₀_root : α₀ (AdjoinRoot.root f_V) = P.X :=
    AdjoinRoot.liftAlgHom_root f_V (Algebra.ofId ↥V₁ P.Ring) P.X hX_map.1
  have hα₀_mk : ∀ A : Polynomial ↥V₁, α₀ (AdjoinRoot.mk f_V A) = Polynomial.aeval P.X A := by
    intro A
    rw [← AdjoinRoot.aeval_eq, ← Polynomial.aeval_algHom_apply, hα₀_root]
  have hα₀_unit : IsUnit (α₀.toRingHom g_B) := by
