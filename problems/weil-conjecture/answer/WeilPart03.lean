          change ψ_L (algebraMap κ L_κ c * x) * z = algebraMap κ B_e' c * (ψ_L x * z)
          rw [map_mul, hψ_L_comm c, mul_assoc]⟩
        haveI : IsLocalization.Away s_L B_e' := by
          refine ⟨?_, ?_, ?_⟩
          · rintro ⟨_, ⟨n, rfl⟩⟩
            change IsUnit (ψ_L (s_L ^ n))
            rw [map_pow, hψ_L_sL, one_pow]
            exact isUnit_one
          · intro z
            obtain ⟨x, hx⟩ := hψ_L_surj z
            refine ⟨⟨x, ⟨1, ⟨0, pow_zero s_L⟩⟩⟩, ?_⟩
            change z * ψ_L 1 = ψ_L x
            rw [map_one, mul_one, hx]
          · intro u v huv
            have h0 : ψ_L (u - v) = 0 := by
              rw [map_sub]
              exact sub_eq_zero.mpr huv
            refine ⟨⟨s_L, ⟨1, pow_one s_L⟩⟩, ?_⟩
            change s_L * u = s_L * v
            rw [← sub_eq_zero, ← mul_sub]
            exact hψ_L_ker (u - v) h0
        haveI : Algebra.Etale L_κ (Localization.Away s_L) :=
          Algebra.Etale.of_isLocalizationAway s_L
        haveI : Algebra.Etale κ (Localization.Away s_L) :=
          Algebra.Etale.comp κ L_κ (Localization.Away s_L)
        let e_Be_loc : Localization.Away s_L ≃ₐ[L_κ] B_e' :=
          IsLocalization.algEquiv (Submonoid.powers s_L) (Localization.Away s_L) B_e'
        haveI : Algebra.Etale κ B_e' := Algebra.Etale.of_equiv (e_Be_loc.restrictScalars κ)
        let e_alg_κ : B_e' ≃ₐ[κ] B_e :=
          { e_Be'.symm with
            commutes' := fun c => by
              change e_Be'.symm (e_Be' (algebraMap κ B_e c)) = algebraMap κ B_e c
              exact e_Be'.symm_apply_apply _ }
        exact Algebra.Etale.of_equiv e_alg_κ
      haveI : IsLocalHom (algebraMap κ B_e) := ⟨fun c hc => by
        by_contra hnc
        have hc0 : c = 0 := by
          by_contra hc_ne
          exact hnc (IsUnit.mk0 c hc_ne)
        rw [hc0, map_zero] at hc
        exact not_isUnit_zero hc⟩
      have hmax_bot : IsLocalRing.maximalIdeal B_e = ⊥ := by
        have hunram : Algebra.FormallyUnramified κ B_e := inferInstance
        have hmap := (Algebra.FormallyUnramified.iff_map_maximalIdeal_eq.mp hunram).2
        have hmκ : IsLocalRing.maximalIdeal κ = ⊥ := IsLocalRing.maximalIdeal_eq_bot
        rw [← hmap, hmκ, Ideal.map_bot]
      haveI : IsDomain B_e := (IsLocalRing.isField_iff_maximalIdeal_eq.mpr hmax_bot).isDomain
      haveI : Algebra.IsIntegral κ B_e := Algebra.IsIntegral.of_finite κ B_e
      have hbij_κBe : Function.Bijective (algebraMap κ B_e) :=
        IsAlgClosed.algebraMap_bijective_of_isIntegral
      intro y
      obtain ⟨c, hc⟩ := hbij_κBe.2 (algebraMap A_bar B_e y)
      refine ⟨c, ?_⟩
      have hdiff : ebar * (y - algebraMap κ A_bar c) = 0 := by
        apply hBe_ker
        rw [map_sub]
        change algebraMap A_bar B_e y - algebraMap κ B_e c = 0
        rw [hc, sub_self]
      have hdiff2 : ebar * y - ebar * algebraMap κ A_bar c = 0 := by
        rw [← mul_sub ebar y (algebraMap κ A_bar c)]
        exact hdiff
      have hc1 : algebraMap κ A_bar c = c • (1 : A_bar) := by
        change c ⊗ₜ[R] (1 : ↥R₀) = (c * 1) ⊗ₜ[R] (1 : ↥R₀)
        rw [mul_one]
      calc ebar * y
          = ebar * algebraMap κ A_bar c := sub_eq_zero.mp hdiff2
        _ = algebraMap κ A_bar c * ebar := mul_comm ebar _
        _ = (c • (1 : A_bar)) * ebar := by rw [hc1]
        _ = c • ((1 : A_bar) * ebar) := smul_mul_assoc c 1 ebar
        _ = c • ebar := by rw [one_mul]
    let W_sub : Submodule κ A_bar := LinearMap.range (LinearMap.mulLeft κ (1 - ebar))
    have hW_fg : W_sub.FG := IsNoetherian.noetherian W_sub
    obtain ⟨k, w, hw_span⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hW_fg
    have hw_ann : ∀ j : Fin k, ebar * w j = 0 := by
      intro j
      have hwj : w j ∈ W_sub := hw_span ▸ Submodule.subset_span ⟨j, rfl⟩
      rcases hwj with ⟨z, hz⟩
      rw [← hz]
      change ebar * ((1 - ebar) * z) = 0
      calc ebar * ((1 - ebar) * z) = (ebar - ebar * ebar) * z := by ring
        _ = 0 := by rw [hebar_idem.eq, sub_self, zero_mul]
    let mbar : Fin (k + 1) → A_bar := Fin.cons ebar w
    have hmbar_span : Submodule.span κ (Set.range mbar) = ⊤ := by
      rw [eq_top_iff]
      intro y _
      have hy_eq : y = ebar * y + (1 - ebar) * y := by ring
      rw [hy_eq]
      refine Submodule.add_mem _ ?_ ?_
      · obtain ⟨c, hc⟩ := hebar_span y
        rw [hc]
        refine Submodule.smul_mem _ c (Submodule.subset_span ⟨0, ?_⟩)
        exact @Fin.cons_zero k (fun _ => A_bar) ebar w
      · have hmemW : (1 - ebar) * y ∈ W_sub := ⟨y, rfl⟩
        rw [← hw_span] at hmemW
        refine Submodule.span_mono ?_ hmemW
        rintro _ ⟨j, rfl⟩
        refine ⟨j.succ, ?_⟩
        exact @Fin.cons_succ k (fun _ => A_bar) ebar w j
    let m : Fin (k + 1) → ↥R₀ := fun i => Classical.choose (hπ_surj (mbar i))
    have hm_π : ∀ i : Fin (k + 1), π (m i) = mbar i :=
      fun i => Classical.choose_spec (hπ_surj (mbar i))
    have hmR_jac : m_R ≤ (⊥ : Ideal R).jacobson := by
      intro r hr
      rw [Ideal.mem_jacobson_bot]
      intro y
      rw [← IsLocalRing.notMem_maximalIdeal]
      intro hmem
      have h1 : (1 : R) ∈ m_R := by
        have hsub := m_R.sub_mem hmem (m_R.mul_mem_right y hr)
        rwa [add_sub_cancel_left] at hsub
      exact (IsLocalRing.maximalIdeal.isMaximal R).ne_top
        (Ideal.eq_top_of_isUnit_mem m_R h1 isUnit_one)
    have hJm_smul : ∀ x ∈ J_m, x ∈ m_R • (⊤ : Submodule R ↥R₀) := by
      intro x hx
      refine Submodule.span_induction
        (p := fun x _ => x ∈ m_R • (⊤ : Submodule R ↥R₀))
        ?_ (Submodule.zero_mem _)
        (fun _ _ _ _ ha hb => Submodule.add_mem _ ha hb)
        (fun a z _ hz => ?_) hx
      · rintro _ ⟨r, hr, rfl⟩
        rw [show algebraMap R ↥R₀ r = r • (1 : ↥R₀) by rw [Algebra.smul_def, mul_one]]
        exact Submodule.smul_mem_smul hr Submodule.mem_top
      · refine Submodule.smul_induction_on hz ?_
          (fun _ _ hu hv => by rw [smul_add]; exact Submodule.add_mem _ hu hv)
        intro r hr y _
        change a * (r • y) ∈ m_R • (⊤ : Submodule R ↥R₀)
        rw [mul_smul_comm]
        exact Submodule.smul_mem_smul hr Submodule.mem_top
    have hspan_lin : ∀ {K M_mod : Type u} [CommRing K] [AddCommGroup M_mod] [Module K M_mod]
        {n : ℕ} (f_gen : Fin n → M_mod) (z : M_mod),
        z ∈ Submodule.span K (Set.range f_gen) →
        ∃ c : Fin n → K, z = ∑ i : Fin n, c i • f_gen i := by
      intro K M_mod _ _ _ n f_gen z hz
      refine Submodule.span_induction
        (p := fun z _ => ∃ c : Fin n → K, z = ∑ i : Fin n, c i • f_gen i)
        ?_ ⟨0, by simp⟩
        (fun _ _ _ _ ⟨c₁, hc₁⟩ ⟨c₂, hc₂⟩ =>
          ⟨c₁ + c₂, by simp [hc₁, hc₂, Pi.add_apply, add_smul, Finset.sum_add_distrib]⟩)
        (fun a _ _ ⟨c, hc⟩ =>
          ⟨fun i => a * c i, by simp [hc, Finset.smul_sum, mul_smul]⟩) hz
      rintro _ ⟨j, rfl⟩
      refine ⟨fun i => if i = j then 1 else 0, ?_⟩
      rw [Finset.sum_eq_single j]
      · simp
      · intro b _ hb
        simp [hb]
      · intro hj
        exact absurd (Finset.mem_univ j) hj
    let S_m : Submodule R ↥R₀ := Submodule.span R (Set.range m)
    have hSm_top : S_m = ⊤ := by
      apply top_unique
      refine Submodule.le_of_le_smul_of_le_jacobson_bot Module.Finite.fg_top hmR_jac ?_
      intro x _
      obtain ⟨c, hc⟩ := hspan_lin mbar (π x) (hmbar_span.symm ▸ Submodule.mem_top)
      let r_fn : Fin (k + 1) → R := fun i => Classical.choose (IsLocalRing.residue_surjective (c i))
      have hr_fn : ∀ i : Fin (k + 1), res (r_fn i) = c i :=
        fun i => Classical.choose_spec (IsLocalRing.residue_surjective (c i))
      let x' : ↥R₀ := ∑ i : Fin (k + 1), r_fn i • m i
      have hx'_mem : x' ∈ S_m :=
        Submodule.sum_mem S_m (fun i _ => Submodule.smul_mem S_m (r_fn i) (Submodule.subset_span ⟨i, rfl⟩))
      have hdiff_ker : x - x' ∈ J_m := by
        rw [← hker_π, RingHom.mem_ker]
        change π (x - x') = 0
        rw [map_sub, hc]
        dsimp [x']
        rw [map_sum]
        have hsum_eq :
            (∑ i : Fin (k + 1), π (r_fn i • m i)) = ∑ i : Fin (k + 1), c i • mbar i := by
          refine Finset.sum_congr rfl (fun i _ => ?_)
          change π.toRingHom (r_fn i • m i) = c i • mbar i
          rw [Algebra.smul_def (r_fn i) (m i), map_mul]
          have h1 : π.toRingHom (algebraMap R ↥R₀ (r_fn i)) = algebraMap κ A_bar (c i) := by
            rw [← hr_fn i]
            exact π.commutes (r_fn i)
          have hc1_bar : algebraMap κ A_bar (c i) = c i • (1 : A_bar) := by
            change c i ⊗ₜ[R] (1 : ↥R₀) = (c i * 1) ⊗ₜ[R] (1 : ↥R₀)
            rw [mul_one]
          rw [h1, show π.toRingHom (m i) = π (m i) from rfl, hm_π i, hc1_bar,
            smul_mul_assoc, one_mul]
        rw [hsum_eq, sub_self]
      have hdiff_smul : x - x' ∈ m_R • (⊤ : Submodule R ↥R₀) := hJm_smul (x - x') hdiff_ker
      have hx_split : x = x' + (x - x') := (add_sub_cancel x' x).symm
      rw [hx_split]
      exact Submodule.add_mem_sup hx'_mem hdiff_smul
    have hJm_lin : ∀ z ∈ J_m, ∃ d : Fin (k + 1) → R,
        (∀ j : Fin (k + 1), d j ∈ m_R) ∧ z = ∑ j : Fin (k + 1), d j • m j := by
      intro z hz
      have hz_smul : z ∈ m_R • S_m := by
        rw [hSm_top]
        exact hJm_smul z hz
      refine Submodule.smul_induction_on hz_smul ?_ ?_
      · intro r hr y hy
        obtain ⟨c, rfl⟩ := hspan_lin m y hy
        refine ⟨fun j => r * c j, fun j => m_R.mul_mem_right (c j) hr, ?_⟩
        simp [Finset.smul_sum, mul_smul]
      · rintro _ _ ⟨d₁, hd₁, rfl⟩ ⟨d₂, hd₂, rfl⟩
        exact ⟨fun j => d₁ j + d₂ j, fun j => m_R.add_mem (hd₁ j) (hd₂ j),
          by simp [add_smul, Finset.sum_add_distrib]⟩
    have hrel_π : ∀ i : Fin (k + 1),
        m 0 * m i - (if i = 0 then m 0 else 0) ∈ J_m := by
      intro i
      rw [← hker_π, RingHom.mem_ker]
      change π (m 0 * m i - if i = 0 then m 0 else 0) = 0
      rw [map_sub, map_mul, hm_π 0]
      refine Fin.cases ?_ ?_ i
      · rw [if_pos rfl, hm_π 0]
        dsimp [mbar]
        rw [Fin.cons_zero, hebar_idem.eq, sub_self]
      · intro j
        rw [if_neg (Fin.succ_ne_zero j), map_zero, sub_zero, hm_π j.succ]
        dsimp [mbar]
        rw [Fin.cons_zero, Fin.cons_succ, hw_ann j]
    let d_mat : Fin (k + 1) → Fin (k + 1) → R :=
      fun i => Classical.choose (hJm_lin _ (hrel_π i))
    have hd_spec : ∀ i : Fin (k + 1),
        (∀ j : Fin (k + 1), d_mat i j ∈ m_R) ∧
        m 0 * m i - (if i = 0 then m 0 else 0) = ∑ j : Fin (k + 1), d_mat i j • m j :=
      fun i => Classical.choose_spec (hJm_lin _ (hrel_π i))
    let M : Matrix (Fin (k + 1)) (Fin (k + 1)) R :=
      Matrix.of (fun i j => (if i = 0 ∧ j = 0 then (1 : R) else 0) + d_mat i j)
    have hM_mul : ∀ i : Fin (k + 1),
        m 0 * m i = ∑ j : Fin (k + 1), algebraMap R ↥R₀ (M i j) * m j := by
      intro i
      have h1 := (hd_spec i).2
      have h2 : m 0 * m i = (if i = 0 then m 0 else 0) + ∑ j : Fin (k + 1), d_mat i j • m j := by
        rw [sub_eq_iff_eq_add.mp h1, add_comm]
      have h_ite : (if i = 0 then m 0 else 0) =
          ∑ j : Fin (k + 1), (if i = 0 ∧ j = 0 then (1 : R) else 0) • m j := by
        by_cases hi : i = 0
        · subst hi
          rw [if_pos rfl, Finset.sum_eq_single 0]
          · simp
          · intro b _ hb
            simp [hb]
          · intro h0
            exact absurd (Finset.mem_univ 0) h0
        · rw [if_neg hi, eq_comm]
          refine Finset.sum_eq_zero (fun j _ => ?_)
          simp [hi]
      rw [h2, h_ite, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [← add_smul, Algebra.smul_def]
      rfl
    let f : Polynomial R := M.charpoly
    have hf_aeval : Polynomial.aeval (m 0) f = 0 := by
      let ev_m₀ : Polynomial R →+* ↥R₀ := (Polynomial.aeval (m 0)).toRingHom
      have hdet_map : Polynomial.aeval (m 0) f =
          (ev_m₀.mapMatrix (Matrix.charmatrix M)).det :=
        RingHom.map_det ev_m₀ (Matrix.charmatrix M)
      rw [hdet_map]
      let B : Matrix (Fin (k + 1)) (Fin (k + 1)) ↥R₀ := ev_m₀.mapMatrix (Matrix.charmatrix M)
      have hB_entry : ∀ i j : Fin (k + 1),
          B i j = (if i = j then m 0 else 0) - algebraMap R ↥R₀ (M i j) := by
        intro i j
        simp only [B, RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.charmatrix_apply]
        by_cases hij : i = j
        · subst hij
          simp [ev_m₀]
        · rw [Matrix.diagonal_apply_ne _ hij, map_sub, map_zero, zero_sub, if_neg hij, zero_sub]
          simp [ev_m₀]
      have hB_mulVec : B.mulVec m = 0 := by
        ext i
        simp only [Matrix.mulVec, dotProduct, Pi.zero_apply]
        have h_term : ∀ j : Fin (k + 1),
            B i j * m j = (if i = j then m 0 * m j else 0) - algebraMap R ↥R₀ (M i j) * m j := by
          intro j
          rw [hB_entry i j, sub_mul]
          by_cases hij : i = j <;> simp [hij]
        simp_rw [h_term, Finset.sum_sub_distrib]
        have hdiag : (∑ j : Fin (k + 1), if i = j then m 0 * m j else 0) = m 0 * m i := by
          rw [Finset.sum_eq_single i]
          · simp
          · intro b _ hb
            exact if_neg (Ne.symm hb)
          · intro hi
            exact absurd (Finset.mem_univ i) hi
        rw [hdiag, hM_mul i, sub_self]
      have hdet_ann : ∀ j : Fin (k + 1), B.det * m j = 0 := by
        intro j
        have h1 : ((B.adjugate * B).mulVec m) j = 0 := by
          rw [← Matrix.mulVec_mulVec, hB_mulVec, Matrix.mulVec_zero, Pi.zero_apply]
        rw [Matrix.adjugate_mul] at h1
        have hsmul : ((B.det • (1 : Matrix (Fin (k + 1)) (Fin (k + 1)) ↥R₀)).mulVec m) j =
            B.det * m j := by
          simp [Matrix.mulVec, dotProduct, Matrix.one_apply]
        rwa [hsmul] at h1
      obtain ⟨c₁, hc₁⟩ := hspan_lin m 1 (hSm_top.symm ▸ Submodule.mem_top)
      calc B.det = B.det * 1 := (mul_one _).symm
        _ = B.det * ∑ j : Fin (k + 1), c₁ j • m j := by rw [hc₁]
        _ = ∑ j : Fin (k + 1), c₁ j • (B.det * m j) := by
            rw [Finset.mul_sum]
            refine Finset.sum_congr rfl (fun j _ => by rw [mul_smul_comm])
        _ = 0 := Finset.sum_eq_zero (fun j _ => by rw [hdet_ann j, smul_zero])
    have hf_map_res : f.map res = (Polynomial.X - 1) * Polynomial.X ^ k := by
      dsimp [f]
      rw [← Matrix.charpoly_map M res]
      have hM_res : M.map res = Matrix.diagonal (Fin.cons (1 : κ) (fun _ => 0)) := by
        ext i j
        simp only [M, Matrix.map_apply, Matrix.of_apply, map_add, Matrix.diagonal_apply]
        have hd0 : res (d_mat i j) = 0 :=
          (IsLocalRing.residue_eq_zero_iff _).mpr ((hd_spec i).1 j)
        rw [hd0, add_zero]
        refine Fin.cases ?_ ?_ i
        · refine Fin.cases ?_ ?_ j
          · simp
          · intro j'
            simp [(Fin.succ_ne_zero j').symm]
        · intro i'
          refine Fin.cases ?_ ?_ j
          · simp [Fin.succ_ne_zero i']
          · intro j'
            simp [Fin.succ_ne_zero i', Fin.succ_inj]
      rw [hM_res, Matrix.charpoly_diagonal, Fin.prod_univ_succ]
      simp
    have hf_eval1 : f.eval 1 ∈ m_R := by
      rw [← IsLocalRing.residue_eq_zero_iff]
      change res (f.eval 1) = 0
      rw [← Polynomial.eval_map_apply, hf_map_res]
      simp
    have hf_deriv1 : IsUnit (f.derivative.eval 1) := by
      apply isUnit_of_map_unit res
      have hderiv_map : (f.derivative).map res = (f.map res).derivative :=
        (Polynomial.derivative_map f res).symm
      rw [← Polynomial.eval_map_apply, hderiv_map, hf_map_res, Polynomial.derivative_mul]
      simp
    obtain ⟨a_rt, ha_root, ha_mem⟩ :=
      HenselianLocalRing.is_henselian f M.charpoly_monic 1 hf_eval1 hf_deriv1
    have hres_art : res a_rt = 1 := by
      have h0 : res (a_rt - 1) = 0 := (IsLocalRing.residue_eq_zero_iff _).mpr ha_mem
      rw [map_sub, map_one] at h0
      exact sub_eq_zero.mp h0
    obtain ⟨g, hf_fac⟩ := Polynomial.dvd_iff_isRoot.mpr ha_root
    have hg_map_res : g.map res = Polynomial.X ^ k := by
      have hfac_res := congrArg (Polynomial.map res) hf_fac
      rw [hf_map_res, Polynomial.map_mul, Polynomial.map_sub, Polynomial.map_X,
        Polynomial.map_C, hres_art, Polynomial.C_1] at hfac_res
      have hX1_ne : (Polynomial.X - 1 : Polynomial κ) ≠ 0 :=
        Polynomial.X_sub_C_ne_zero 1
      exact mul_left_cancel₀ hX1_ne hfac_res.symm
    have hg_art_res : res (g.eval a_rt) = 1 := by
      rw [← Polynomial.eval_map_apply, hg_map_res, hres_art]
      simp
    have hg_art_unit : IsUnit (g.eval a_rt) := by
      apply isUnit_of_map_unit res
      rw [hg_art_res]
      exact isUnit_one
    let u_g : Rˣ := hg_art_unit.unit
    have hu_g : (u_g : R) = g.eval a_rt := by simp [u_g]
    have hres_ug_inv : res ↑(u_g⁻¹) = 1 := by
      have h1 : res ((u_g : R) * ↑(u_g⁻¹)) = 1 := by simp
      rw [map_mul, hu_g, hg_art_res, one_mul] at h1
      exact h1
    let e_idem : ↥R₀ := algebraMap R ↥R₀ ↑(u_g⁻¹) * Polynomial.aeval (m 0) g
    have hm₀_e : m 0 * e_idem = algebraMap R ↥R₀ a_rt * e_idem := by
      have hsub : (m 0 - algebraMap R ↥R₀ a_rt) * e_idem = 0 := by
        dsimp [e_idem]
        calc (m 0 - algebraMap R ↥R₀ a_rt) * (algebraMap R ↥R₀ ↑(u_g⁻¹) * Polynomial.aeval (m 0) g)
            = algebraMap R ↥R₀ ↑(u_g⁻¹) *
                ((m 0 - algebraMap R ↥R₀ a_rt) * Polynomial.aeval (m 0) g) := by ring
          _ = algebraMap R ↥R₀ ↑(u_g⁻¹) * Polynomial.aeval (m 0) f := by
              rw [hf_fac, map_mul, map_sub, Polynomial.aeval_X, Polynomial.aeval_C]
          _ = 0 := by rw [hf_aeval, mul_zero]
      rw [sub_mul] at hsub
      exact sub_eq_zero.mp hsub
    have haeval_e : ∀ P : Polynomial R,
        Polynomial.aeval (m 0) P * e_idem = algebraMap R ↥R₀ (P.eval a_rt) * e_idem := by
      intro P
      refine Polynomial.induction_on' P ?_ ?_
      · intro p q hp hq
        rw [map_add, add_mul, hp, hq, Polynomial.eval_add, map_add, add_mul]
      · intro n c
        rw [Polynomial.aeval_monomial, Polynomial.eval_monomial, map_mul, map_pow]
        have hpow : ∀ n : ℕ, (m 0) ^ n * e_idem = (algebraMap R ↥R₀ a_rt) ^ n * e_idem := by
          intro n
          induction n with
          | zero => simp
          | succ n ih =>
            rw [pow_succ, mul_assoc, mul_comm (m 0), ← mul_assoc, ih, mul_assoc,
              mul_comm e_idem (m 0), hm₀_e, ← mul_assoc, ← pow_succ]
        rw [mul_assoc, hpow n, ← mul_assoc]
    have he_idem_sq : e_idem * e_idem = e_idem := by
      calc e_idem * e_idem
