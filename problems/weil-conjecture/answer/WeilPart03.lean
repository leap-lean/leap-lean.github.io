                  split_ifs with hb_in
                  · by_contra hne
                    apply hb_not
                    exact Finset.mem_image.mpr
                      ⟨(⟨b.1, hb_in⟩ : ↥(gb (N - 1)).1), Finsupp.mem_support_iff.mpr hne, rfl⟩
