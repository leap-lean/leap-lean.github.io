          dsimp [w_res]
          push_cast
          refine Finset.sum_congr rfl fun i _ => by rw [Algebra.smul_def, Subfield.coe_mul, hAlgE_val]
        have hdiff_w : ‖(∑ i ∈ cw.support, algebraMap K_hat L₁ (cw i) * ((fam i : ↥L1_coeff) : L₁)) -
            (w_res : L₁)‖ < 1 := by
          rw [hw_res_coe, ← Finset.sum_sub_distrib]
