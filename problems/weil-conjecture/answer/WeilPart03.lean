              intro i hi
              have hnot : ¬ (isZero i = true) := (Finset.mem_filter.mp hi).2
              rcases i with _ | ⟨n, u⟩
              · rfl
              · rcases n with _ | k
                · exfalso; exact hnot rfl
                · rfl
            have hS'_lvl : ∀ j ∈ S', lvl j ≤ M := by
              intro j hj
              rcases Finset.mem_image.mp hj with ⟨i, hi_pos, rfl⟩
              have hiS : i ∈ S := (Finset.mem_filter.mp hi_pos).1
              have hnot : ¬ (isZero i = true) := (Finset.mem_filter.mp hi_pos).2
              have hle : lvl i ≤ M + 1 := hlvl i hiS
              rcases i with _ | ⟨n, u⟩
              · exact Nat.zero_le M
