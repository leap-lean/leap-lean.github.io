        intro hEqH
        apply hNe
        rw [← IsGalois.fixedField_fixingSubgroup L_top]
        change IntermediateField.fixedField H_top = IntermediateField.fixedField P
        rw [hEqH]
      let H₀ : Subgroup ↥P := H_top.subgroupOf P
      have hH₀_ne_top : H₀ ≠ ⊤ := by
        intro hTop0
        apply hH_ne_P
        refine le_antisymm hH_le_P (fun σ hσ => ?_)
        have hmem : (⟨σ, hσ⟩ : ↥P) ∈ H₀ := hTop0 ▸ Subgroup.mem_top _
        exact hmem
      haveI : Fact p.Prime := ⟨hp⟩
      obtain ⟨k, hk⟩ := IsPGroup.iff_card.mp hP_pg
      obtain ⟨j, hj⟩ := IsPGroup.iff_card.mp (hP_pg.to_subgroup H₀)
      have hj_ne_k : j ≠ k := by
        intro hjk
        apply hH₀_ne_top
        rw [← Subgroup.card_eq_iff_eq_top, hj, hk, hjk]
      have hj_le_k : j ≤ k := by
        have hdvd : Nat.card ↥H₀ ∣ Nat.card ↥P := Subgroup.card_subgroup_dvd_card H₀
        rw [hj, hk] at hdvd
        exact (Nat.pow_dvd_pow_iff_le_right hp.one_lt).mp hdvd
      have hj_lt_k : j < k := lt_of_le_of_ne hj_le_k hj_ne_k
      have hk_pos : 1 ≤ k := Nat.one_le_of_lt hj_lt_k
      have hj_le_pred : j ≤ k - 1 := Nat.le_sub_one_of_lt hj_lt_k
      have hdvd_pred : p ^ (k - 1) ∣ Nat.card ↥P := by
        rw [hk]
        exact pow_dvd_pow p (Nat.sub_le k 1)
      obtain ⟨K₁, hK₁_card, hH₀_le_K₁⟩ :=
        Sylow.exists_subgroup_card_pow_prime_le p hdvd_pred H₀ hj hj_le_pred
      let H₁ : Subgroup (N ≃ₐ[↥K_base] N) := K₁.map P.subtype
      have hHtop_le_H₁ : H_top ≤ H₁ := by
        intro σ hσ
        exact ⟨⟨σ, hH_le_P hσ⟩, hH₀_le_K₁ hσ, rfl⟩
      have hH₁_le_P : H₁ ≤ P := by
        rintro _ ⟨⟨σ, hσ⟩, _, rfl⟩
        exact hσ
      have hH₁_card : Nat.card ↥H₁ = p ^ (k - 1) := by
        rw [Subgroup.card_map_of_injective P.subtype_injective]
        exact hK₁_card
      let M₂_int : IntermediateField ↥K_base N := IntermediateField.fixedField H₁
      let M₂ : Subfield N := M₂_int.toSubfield
