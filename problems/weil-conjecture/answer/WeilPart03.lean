      rw [h0] at hlt
      simp [hz] at hlt
    have hRhoMul : ∀ (z₁ z₂ : N), ‖z₁‖ ≤ 1 → ‖z₂‖ ≤ 1 → ρ (z₁ * z₂) = ρ z₁ * ρ z₂ := by
      intro z₁ z₂ hz₁ hz₂
      have hmul_le : ‖z₁ * z₂‖ ≤ 1 := by
        rw [norm_mul]
        exact mul_le_one₀ hz₁ (norm_nonneg z₂) hz₂
