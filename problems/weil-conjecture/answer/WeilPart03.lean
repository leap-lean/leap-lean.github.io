import WeilPart02
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem weil_close_subfield_finrank_and_etale_transfer (F_hat : Type u)
    [NontriviallyNormedField F_hat] [CompleteSpace F_hat] [IsUltrametricDist F_hat]
    (L₁ L₂ : Subfield F_hat)
    (hCl₁ : IsClosed (L₁ : Set F_hat))
    (hCl₂ : IsClosed (L₂ : Set F_hat))
    (hNontriv₁ : ∃ c ∈ L₁, 1 < ‖c‖)
    (θ : ℝ) (hθ₀ : 0 ≤ θ) (hθ₁ : θ < 1)
    (φ : ↥L₁ ≃+* ↥L₂)
    (hIso : ∀ u : ↥L₁, ‖(φ u : F_hat)‖ = ‖(u : F_hat)‖)
    (hClose : ∀ u : ↥L₁, ‖(u : F_hat) - (φ u : F_hat)‖ ≤ θ * ‖(u : F_hat)‖) :
    (letI : Algebra ↥L₁ F_hat := L₁.toAlgebra
     letI : Algebra ↥L₂ F_hat := L₂.toAlgebra
     (FiniteDimensional ↥L₁ F_hat ↔ FiniteDimensional ↥L₂ F_hat) ∧
     Module.finrank ↥L₁ F_hat = Module.finrank ↥L₂ F_hat) ∧
    (θ ≤ 1 / 2 →
      let OF : ValuationSubring F_hat := (NormedField.valuation (K := F_hat)).valuationSubring
      let OL₁ : ValuationSubring ↥L₁ := OF.comap L₁.subtype
      let OL₂ : ValuationSubring ↥L₂ := OF.comap L₂.subtype
      letI : Algebra ↥L₁ F_hat := L₁.toAlgebra
      letI : Algebra ↥L₂ F_hat := L₂.toAlgebra
      let ι₁ : ↥OL₁ →+* ↥OF :=
        (L₁.subtype.comp OL₁.subtype).codRestrict OF.toSubring (fun y => y.2)
      let ι₂ : ↥OL₂ →+* ↥OF :=
        (L₂.subtype.comp OL₂.subtype).codRestrict OF.toSubring (fun y => y.2)
      letI : Algebra ↥OL₁ ↥OF := ι₁.toAlgebra
      letI : Algebra ↥OL₂ ↥OF := ι₂.toAlgebra
      FiniteDimensional ↥L₁ F_hat →
      Module.Finite ↥OL₁ ↥OF →
      RingHom.Etale ι₁ →
      FiniteDimensional ↥L₂ F_hat ∧ Module.Finite ↥OL₂ ↥OF ∧ RingHom.Etale ι₂) :=
by
  have h_ultra_sum : ∀ {α : Type} (I : Finset α) (f : α → F_hat) (C : ℝ),
      0 ≤ C → (∀ i ∈ I, ‖f i‖ ≤ C) → ‖∑ i ∈ I, f i‖ ≤ C := by
    intro α I f C hC hf
    classical
    induction I using Finset.induction_on with
    | empty =>
      rw [Finset.sum_empty, norm_zero]
      exact hC
    | @insert a s ha ih =>
      rw [Finset.sum_insert ha]
      exact (IsUltrametricDist.norm_add_le_max _ _).trans
        (max_le (hf a (Finset.mem_insert_self a s))
          (ih fun b hb => hf b (Finset.mem_insert_of_mem hb)))
  have h_pow_lip : ∀ (u₁ u₂ : F_hat), ‖u₁‖ ≤ 1 → ‖u₂‖ ≤ 1 →
      ∀ k : ℕ, ‖u₂ ^ k - u₁ ^ k‖ ≤ ‖u₂ - u₁‖ := by
    intro u₁ u₂ hu₁ hu₂ k
    induction k with
    | zero => simp
    | succ k ih =>
      have hid : u₂ ^ (k + 1) - u₁ ^ (k + 1) =
          u₂ * (u₂ ^ k - u₁ ^ k) + (u₂ - u₁) * u₁ ^ k := by ring
      rw [hid]
      refine (IsUltrametricDist.norm_add_le_max _ _).trans (max_le ?_ ?_)
      · rw [norm_mul]
        calc ‖u₂‖ * ‖u₂ ^ k - u₁ ^ k‖ ≤ 1 * ‖u₂ - u₁‖ :=
              mul_le_mul hu₂ ih (norm_nonneg _) zero_le_one
          _ = ‖u₂ - u₁‖ := one_mul _
      · rw [norm_mul, norm_pow]
        calc ‖u₂ - u₁‖ * ‖u₁‖ ^ k ≤ ‖u₂ - u₁‖ * 1 :=
              mul_le_mul_of_nonneg_left (pow_le_one₀ (norm_nonneg _) hu₁) (norm_nonneg _)
          _ = ‖u₂ - u₁‖ := mul_one _
  have h_s1 :
      letI : Algebra ↥L₁ F_hat := L₁.toAlgebra
      letI : Algebra ↥L₂ F_hat := L₂.toAlgebra
      (FiniteDimensional ↥L₁ F_hat ↔ FiniteDimensional ↥L₂ F_hat) ∧
      Module.finrank ↥L₁ F_hat = Module.finrank ↥L₂ F_hat := by
    have h_dir : ∀ (M₁ M₂ : Subfield F_hat),
        IsClosed (M₁ : Set F_hat) →
        IsClosed (M₂ : Set F_hat) →
        (∃ c ∈ M₁, 1 < ‖c‖) →
        (∃ c ∈ M₂, 1 < ‖c‖) →
        ∀ (ψ : ↥M₁ ≃+* ↥M₂),
        (∀ u : ↥M₁, ‖(u : F_hat) - (ψ u : F_hat)‖ ≤ θ * ‖(u : F_hat)‖) →
        letI : Algebra ↥M₁ F_hat := M₁.toAlgebra
        letI : Algebra ↥M₂ F_hat := M₂.toAlgebra
        FiniteDimensional ↥M₁ F_hat →
        FiniteDimensional ↥M₂ F_hat ∧ Module.finrank ↥M₂ F_hat ≤ Module.finrank ↥M₁ F_hat := by
      intro M₁ M₂ hClM₁ hClM₂ hcM₁ hcM₂ ψ hCloseψ
      let _ : Algebra ↥M₁ F_hat := M₁.toAlgebra
      let _ : Algebra ↥M₂ F_hat := M₂.toAlgebra
      intro hFinM₁
      obtain ⟨c₁, hc₁M₁, hc₁_gt⟩ := hcM₁
      obtain ⟨c₂, hc₂M₂, hc₂_gt⟩ := hcM₂
      let _ : NontriviallyNormedField ↥M₁ :=
        { (inferInstance : NormedField ↥M₁) with non_trivial := ⟨⟨c₁, hc₁M₁⟩, hc₁_gt⟩ }
      let _ : NontriviallyNormedField ↥M₂ :=
        { (inferInstance : NormedField ↥M₂) with non_trivial := ⟨⟨c₂, hc₂M₂⟩, hc₂_gt⟩ }
      have _ : CompleteSpace ↥M₁ := @IsClosed.completeSpace_coe _ _ _ _ hClM₁
      have _ : CompleteSpace ↥M₂ := @IsClosed.completeSpace_coe _ _ _ _ hClM₂
      let _ : NormedSpace ↥M₁ F_hat :=
        { norm_smul_le := fun a x => le_of_eq (norm_mul (a : F_hat) x) }
      let _ : NormedSpace ↥M₂ F_hat :=
        { norm_smul_le := fun a x => le_of_eq (norm_mul (a : F_hat) x) }
      let n : ℕ := Module.finrank ↥M₁ F_hat
      have hn_pos : 0 < n := Module.finrank_pos
      have _ : Nonempty (Fin n) := Fin.pos_iff_nonempty.mp hn_pos
      obtain ⟨δ, hδ_pos, hδ_cont⟩ :=
        Metric.continuous_iff.mp (continuous_pow n) (1 : ℝ) (1 - θ) (sub_pos.mpr hθ₁)
      let step : ℝ := min (1 / 2) (δ / 2)
      have hstep_pos : 0 < step := lt_min (by norm_num) (half_pos hδ_pos)
      have hstep_lt_δ : step < δ := lt_of_le_of_lt (min_le_right _ _) (half_lt_self hδ_pos)
      let q : ℝ := 1 - step
      have hq_pos : 0 < q := by
        have hle : step ≤ 1 / 2 := min_le_left _ _
        dsimp only [q]
        linarith
      have hq_lt_one : q < 1 := by dsimp only [q]; linarith
      have hq_le_one : q ≤ 1 := le_of_lt hq_lt_one
      have hθ_lt_qn : θ < q ^ n := by
        have hdist : dist q 1 < δ := by
          rw [Real.dist_eq]
          have hsub : q - 1 = -step := by dsimp only [q]; ring
          rw [hsub, abs_neg, abs_of_pos hstep_pos]
          exact hstep_lt_δ
        have hpow := hδ_cont q hdist
        rw [one_pow, Real.dist_eq] at hpow
        linarith [(abs_lt.mp hpow).1]
      let r : ℝ := q ^ n
      have hr_pos : 0 < r := pow_pos hq_pos n
      have h_orth : ∀ k : ℕ, k ≤ n → ∃ e : Fin k → F_hat,
          (∀ i : Fin k, e i ≠ 0) ∧
          (∀ (a : Fin k → ↥M₁) (i : Fin k),
            q ^ k * ‖(a i : F_hat)‖ * ‖e i‖ ≤ ‖∑ j : Fin k, (a j : F_hat) * e j‖) := by
        intro k
        induction k with
        | zero =>
          intro _
          exact ⟨Fin.elim0, fun i => Fin.elim0 i, fun _ i => Fin.elim0 i⟩
        | succ k ih =>
          intro hk_succ
          obtain ⟨e, he_nz, he_orth⟩ := ih (Nat.le_of_succ_le hk_succ)
          let W_k : Submodule ↥M₁ F_hat := Submodule.span ↥M₁ (Set.range e)
          have _ : FiniteDimensional ↥M₁ ↥W_k :=
            Module.Finite.span_of_finite ↥M₁ (Set.finite_range e)
          have hCl_Wk : IsClosed (W_k : Set F_hat) := Submodule.closed_of_finiteDimensional W_k
          have hWk_not_top : ∃ x₀ : F_hat, x₀ ∉ W_k := by
            by_contra! h_all
            have htop : W_k = ⊤ := Submodule.eq_top_iff'.mpr h_all
            have hcard : Module.finrank ↥M₁ ↥W_k ≤ k := by
              classical
              calc Module.finrank ↥M₁ ↥W_k
                  ≤ (Set.range e).toFinset.card := finrank_span_le_card (Set.range e)
                _ ≤ Fintype.card (Fin k) := by
                    rw [Set.toFinset_range]
                    exact Finset.card_image_le
                _ = k := Fintype.card_fin k
            have hfin_eq : Module.finrank ↥M₁ ↥W_k = n := by
              rw [htop]
              exact LinearEquiv.finrank_eq Submodule.topEquiv
            omega
          obtain ⟨e_new, he_new_not, he_riesz⟩ := riesz_lemma hCl_Wk hWk_not_top hq_lt_one
          have he_new_nz : e_new ≠ 0 := fun h0 => he_new_not (h0 ▸ W_k.zero_mem)
          let e' : Fin (k + 1) → F_hat := Fin.snoc e e_new
          refine ⟨e', ?_, ?_⟩
          · intro i
            refine Fin.lastCases ?_ ?_ i
            · simp [e', he_new_nz]
            · intro j
              simp [e', he_nz j]
          · intro a i
            let a_last : ↥M₁ := a (Fin.last k)
            let y : F_hat := ∑ j : Fin k, (a (Fin.castSucc j) : F_hat) * e j
            let S : F_hat := ∑ j : Fin (k + 1), (a j : F_hat) * e' j
            have hS_eq : S = y + (a_last : F_hat) * e_new := by
              dsimp only [S, y, a_last, e']
              rw [Fin.sum_univ_castSucc, Fin.snoc_last]
              congr 1
              refine Finset.sum_congr rfl fun j _ => ?_
              rw [Fin.snoc_castSucc]
            have hy_mem : y ∈ W_k := by
              dsimp only [y]
              refine Submodule.sum_mem W_k fun j _ => ?_
              change a (Fin.castSucc j) • e j ∈ W_k
              exact Submodule.smul_mem W_k _ (Submodule.subset_span ⟨j, rfl⟩)
            have h_last_q : q * ‖(a_last : F_hat)‖ * ‖e_new‖ ≤ ‖S‖ := by
              by_cases ha0 : (a_last : F_hat) = 0
              · rw [ha0, norm_zero, mul_zero, zero_mul]
                exact norm_nonneg S
              · let w : F_hat := ((-a_last⁻¹) : ↥M₁) • y
                have hw_mem : w ∈ W_k := Submodule.smul_mem W_k _ hy_mem
                have hS_prod : S = (a_last : F_hat) * (e_new - w) := by
                  rw [hS_eq]
                  change y + (a_last : F_hat) * e_new =
                    (a_last : F_hat) * (e_new - (-(a_last : F_hat)⁻¹ * y))
                  field_simp
                  ring
                have hriesz_w := he_riesz w hw_mem
                rw [hS_prod, norm_mul]
                calc q * ‖(a_last : F_hat)‖ * ‖e_new‖
                    = ‖(a_last : F_hat)‖ * (q * ‖e_new‖) := by ring
                  _ ≤ ‖(a_last : F_hat)‖ * ‖e_new - w‖ :=
                       mul_le_mul_of_nonneg_left hriesz_w (norm_nonneg _)
            have h_y_q : q * ‖y‖ ≤ ‖S‖ := by
              have hy_sub : y = S + (-((a_last : F_hat) * e_new)) := by
                rw [hS_eq]
                ring
              have hmax := IsUltrametricDist.norm_add_le_max S (-((a_last : F_hat) * e_new))
              rw [← hy_sub, norm_neg, norm_mul] at hmax
              rcases le_max_iff.mp hmax with h1 | h2
              · calc q * ‖y‖ ≤ 1 * ‖S‖ := mul_le_mul hq_le_one h1 (norm_nonneg _) zero_le_one
                  _ = ‖S‖ := one_mul ‖S‖
              · calc q * ‖y‖ ≤ q * (‖(a_last : F_hat)‖ * ‖e_new‖) :=
                      mul_le_mul_of_nonneg_left h2 (le_of_lt hq_pos)
                  _ = q * ‖(a_last : F_hat)‖ * ‖e_new‖ := by ring
                  _ ≤ ‖S‖ := h_last_q
            refine Fin.lastCases ?_ ?_ i
            · simp only [e', Fin.snoc_last]
              have hq_pow : q ^ (k + 1) ≤ q := by
                rw [pow_succ]
                calc q ^ k * q ≤ 1 * q :=
                      mul_le_mul_of_nonneg_right (pow_le_one₀ (le_of_lt hq_pos) hq_le_one)
                        (le_of_lt hq_pos)
                  _ = q := one_mul q
              calc q ^ (k + 1) * ‖(a_last : F_hat)‖ * ‖e_new‖
                  ≤ q * ‖(a_last : F_hat)‖ * ‖e_new‖ :=
                    mul_le_mul_of_nonneg_right
                      (mul_le_mul_of_nonneg_right hq_pow (norm_nonneg _)) (norm_nonneg _)
                _ ≤ ‖S‖ := h_last_q
            · intro j
              simp only [e', Fin.snoc_castSucc]
              have h_ih := he_orth (fun m => a (Fin.castSucc m)) j
              calc q ^ (k + 1) * ‖(a (Fin.castSucc j) : F_hat)‖ * ‖e j‖
                  = q * (q ^ k * ‖(a (Fin.castSucc j) : F_hat)‖ * ‖e j‖) := by
                    rw [pow_succ]; ring
                _ ≤ q * ‖y‖ := mul_le_mul_of_nonneg_left h_ih (le_of_lt hq_pos)
                _ ≤ ‖S‖ := h_y_q
      obtain ⟨e, he_nz, he_orth⟩ := h_orth n le_rfl
      have hLin : LinearIndependent ↥M₁ e := by
        rw [Fintype.linearIndependent_iff]
        intro a ha i
        have h0 : ∑ j : Fin n, (a j : F_hat) * e j = 0 := ha
        have hle := he_orth a i
        rw [h0, norm_zero] at hle
        have he_pos : 0 < ‖e i‖ := norm_pos_iff.mpr (he_nz i)
        have hre_pos : 0 < r * ‖e i‖ := mul_pos hr_pos he_pos
        have hmul_le : ‖(a i : F_hat)‖ * (r * ‖e i‖) ≤ 0 := by
          calc ‖(a i : F_hat)‖ * (r * ‖e i‖) = r * ‖(a i : F_hat)‖ * ‖e i‖ := by ring
            _ ≤ 0 := hle
        have ha_le : ‖(a i : F_hat)‖ ≤ 0 := nonpos_of_mul_nonpos_left hmul_le hre_pos
        have ha_zero : (a i : F_hat) = 0 :=
          norm_eq_zero.mp (le_antisymm ha_le (norm_nonneg _))
        exact Subtype.ext ha_zero
      let B₁ : Module.Basis (Fin n) ↥M₁ F_hat :=
        basisOfLinearIndependentOfCardEqFinrank hLin (Fintype.card_fin n)
      have hB₁_coe : ∀ i : Fin n, B₁ i = e i := by
        intro i
        dsimp only [B₁]
        rw [coe_basisOfLinearIndependentOfCardEqFinrank]
      let V₂ : Submodule ↥M₂ F_hat := Submodule.span ↥M₂ (Set.range e)
      have _ : FiniteDimensional ↥M₂ ↥V₂ :=
        Module.Finite.span_of_finite ↥M₂ (Set.finite_range e)
      have hCl_V₂ : IsClosed (V₂ : Set F_hat) := Submodule.closed_of_finiteDimensional V₂
      let T : F_hat → F_hat := fun w =>
        ∑ i : Fin n, (ψ (B₁.repr w i) : F_hat) * e i
      have hT_mem : ∀ w : F_hat, T w ∈ V₂ := by
        intro w
        refine Submodule.sum_mem V₂ fun i _ => ?_
        change ψ (B₁.repr w i) • e i ∈ V₂
        exact Submodule.smul_mem V₂ _ (Submodule.subset_span ⟨i, rfl⟩)
      let ρ : ℝ := θ / r
      have hρ_nonneg : 0 ≤ ρ := div_nonneg hθ₀ (le_of_lt hr_pos)
      have hρ_lt_one : ρ < 1 := (div_lt_one hr_pos).mpr hθ_lt_qn
      have hT_err : ∀ w : F_hat, ‖w - T w‖ ≤ ρ * ‖w‖ := by
        intro w
        have hw_sum : w = ∑ i : Fin n, (B₁.repr w i : F_hat) * e i := by
          conv_lhs => rw [← B₁.sum_repr w]
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [hB₁_coe i]
          rfl
        have hdiff : w - T w =
            ∑ i : Fin n, ((B₁.repr w i : F_hat) - (ψ (B₁.repr w i) : F_hat)) * e i := by
          dsimp only [T]
          conv_lhs => arg 1; rw [hw_sum]
          rw [← Finset.sum_sub_distrib]
          refine Finset.sum_congr rfl fun i _ => ?_
          ring
        rw [hdiff]
        refine h_ultra_sum Finset.univ _ (ρ * ‖w‖) (mul_nonneg hρ_nonneg (norm_nonneg w)) ?_
        intro i _
        rw [norm_mul]
        have hc_i := hCloseψ (B₁.repr w i)
        have horth_i : r * ‖(B₁.repr w i : F_hat)‖ * ‖e i‖ ≤ ‖w‖ := by
          have h := he_orth (B₁.repr w) i
          rwa [← hw_sum] at h
        have h1 : ‖(B₁.repr w i : F_hat) - (ψ (B₁.repr w i) : F_hat)‖ * ‖e i‖ ≤
            θ * ‖(B₁.repr w i : F_hat)‖ * ‖e i‖ :=
          mul_le_mul_of_nonneg_right hc_i (norm_nonneg _)
        have h2 : θ * ‖(B₁.repr w i : F_hat)‖ * ‖e i‖ =
            ρ * (r * ‖(B₁.repr w i : F_hat)‖ * ‖e i‖) := by
          dsimp only [ρ]
          have hr_ne : r ≠ 0 := ne_of_gt hr_pos
          field_simp
        calc ‖(B₁.repr w i : F_hat) - (ψ (B₁.repr w i) : F_hat)‖ * ‖e i‖
            ≤ ρ * (r * ‖(B₁.repr w i : F_hat)‖ * ‖e i‖) := h1.trans_eq h2
          _ ≤ ρ * ‖w‖ := mul_le_mul_of_nonneg_left horth_i hρ_nonneg
      have hV₂_all : ∀ x : F_hat, x ∈ V₂ := by
        intro x
        let rem : ℕ → F_hat := fun m => Nat.recOn m x (fun _ r_m => r_m - T r_m)
        let s : ℕ → F_hat := fun m => ∑ j ∈ Finset.range m, T (rem j)
        have hs_mem : ∀ m : ℕ, s m ∈ V₂ := fun m =>
          Submodule.sum_mem V₂ fun j _ => hT_mem (rem j)
        have h_rem_eq : ∀ m : ℕ, x - s m = rem m := by
          intro m
          induction m with
          | zero => simp [s, rem]
          | succ m ih =>
            dsimp only [s]
            rw [Finset.sum_range_succ, sub_add_eq_sub_sub, ih]
        have h_rem_norm : ∀ m : ℕ, ‖rem m‖ ≤ ρ ^ m * ‖x‖ := by
          intro m
          induction m with
          | zero => simp [rem]
          | succ m ih =>
            calc ‖rem (m + 1)‖ = ‖rem m - T (rem m)‖ := rfl
              _ ≤ ρ * ‖rem m‖ := hT_err (rem m)
              _ ≤ ρ * (ρ ^ m * ‖x‖) := mul_le_mul_of_nonneg_left ih hρ_nonneg
              _ = ρ ^ (m + 1) * ‖x‖ := by rw [pow_succ']; ring
        have h_tendsto_zero : Filter.Tendsto (fun m => ρ ^ m * ‖x‖) Filter.atTop (nhds 0) := by
          simpa only [zero_mul] using
            (tendsto_pow_atTop_nhds_zero_of_lt_one hρ_nonneg hρ_lt_one).mul_const ‖x‖
        have h_dist_tendsto : Filter.Tendsto (fun m => dist (s m) x) Filter.atTop (nhds 0) := by
          refine squeeze_zero (fun _ => dist_nonneg) (fun m => ?_) h_tendsto_zero
          rw [dist_comm, dist_eq_norm, h_rem_eq m]
          exact h_rem_norm m
        have h_tendsto : Filter.Tendsto s Filter.atTop (nhds x) :=
          tendsto_iff_dist_tendsto_zero.mpr h_dist_tendsto
        exact hCl_V₂.mem_of_tendsto h_tendsto (Filter.Eventually.of_forall hs_mem)
      have hV₂_top : V₂ = ⊤ := Submodule.eq_top_iff'.mpr hV₂_all
      have hFinM₂ : FiniteDimensional ↥M₂ F_hat := by
        have _ : FiniteDimensional ↥M₂ ↥(⊤ : Submodule ↥M₂ F_hat) := hV₂_top ▸ inferInstance
        exact Module.Finite.of_injective Submodule.topEquiv.symm.toLinearMap
          Submodule.topEquiv.symm.injective
      have hRank_le : Module.finrank ↥M₂ F_hat ≤ n := by
        classical
        calc Module.finrank ↥M₂ F_hat
            = Module.finrank ↥M₂ ↥(⊤ : Submodule ↥M₂ F_hat) :=
              (LinearEquiv.finrank_eq Submodule.topEquiv).symm
          _ = Module.finrank ↥M₂ ↥V₂ := by rw [hV₂_top]
          _ ≤ (Set.range e).toFinset.card := finrank_span_le_card (Set.range e)
          _ ≤ Fintype.card (Fin n) := by
              rw [Set.toFinset_range]
              exact Finset.card_image_le
          _ = n := Fintype.card_fin n
      exact ⟨hFinM₂, hRank_le⟩
    let _ : Algebra ↥L₁ F_hat := L₁.toAlgebra
    let _ : Algebra ↥L₂ F_hat := L₂.toAlgebra
    have ⟨c, hcL₁, hc_gt⟩ := hNontriv₁
    have hNontriv₂ : ∃ c' ∈ L₂, 1 < ‖c'‖ := by
      refine ⟨(φ ⟨c, hcL₁⟩ : F_hat), (φ ⟨c, hcL₁⟩).2, ?_⟩
      rw [hIso ⟨c, hcL₁⟩]
      exact hc_gt
    have hClose_symm : ∀ v : ↥L₂, ‖(v : F_hat) - (φ.symm v : F_hat)‖ ≤ θ * ‖(v : F_hat)‖ := by
      intro v
      have hv : φ (φ.symm v) = v := φ.apply_symm_apply v
      have h1 := hClose (φ.symm v)
      rw [hv, norm_sub_rev] at h1
      have h2 := hIso (φ.symm v)
      rw [hv] at h2
      rwa [← h2] at h1
    have h12 := h_dir L₁ L₂ hCl₁ hCl₂ hNontriv₁ hNontriv₂ φ hClose
    have h21 := h_dir L₂ L₁ hCl₂ hCl₁ hNontriv₂ hNontriv₁ φ.symm hClose_symm
    have hiff : FiniteDimensional ↥L₁ F_hat ↔ FiniteDimensional ↥L₂ F_hat :=
