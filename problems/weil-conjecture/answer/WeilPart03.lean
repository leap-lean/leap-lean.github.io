        have hw_sub_pow : w_sub ^ (p - 1) = algebraMap ↥F₀ ↥L1_coeff u'_F₀ := by
          apply Subtype.ext; exact hw_coeff_u'
        have hp0_F₀ : (p : ↥F₀) = 0 := by
