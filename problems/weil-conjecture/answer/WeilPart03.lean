                (Nat.le_add_right _ _))⟩
        else 0
      let G_tilde : MvPolynomial (Fin 2) ↥V :=
        ∑ μ ∈ G₁.support, MvPolynomial.monomial μ (C_tilde μ)
      refine ⟨K_c + k_a * D₀, G_tilde, ?_⟩
      have hLHS : Φ₀ G_tilde = ∑ μ ∈ G₁.support,
          vMap (C_tilde μ) * μ.prod (fun i e => (ev₀ i) ^ e) := by
        simp only [G_tilde, Φ₀, map_sum]
        refine Finset.sum_congr rfl fun μ _ => ?_
        change MvPolynomial.eval₂ vMap ev₀ (MvPolynomial.monomial μ (C_tilde μ)) = _
        exact MvPolynomial.eval₂_monomial vMap ev₀
      have hRHS : γ₁ = ∑ μ ∈ G₁.support,
          v₁Map (G₁.coeff μ) * μ.prod (fun i e => (ev₁ i) ^ e) := by
        change (MvPolynomial.eval₂Hom v₁Map ev₁) G₁ = _
        conv_lhs => rw [MvPolynomial.as_sum G₁]
        rw [map_sum]
        refine Finset.sum_congr rfl fun μ _ => ?_
        exact MvPolynomial.eval₂_monomial v₁Map ev₁
      rw [hLHS, hRHS, Finset.mul_sum]
      refine Finset.sum_congr rfl ?_
      intro μ hμ
      have hμD₀ : μ 0 ≤ D₀ := Finset.le_sup (f := fun μ => μ 0) hμ
      have hCμ : C_tilde μ =
          ⟨(G₁.coeff μ : K) * (s₀ : K) ^ (K_c + k_a * (D₀ - μ 0)),
            hN_fn (G₁.coeff μ) (K_c + k_a * (D₀ - μ 0))
              (le_trans (Finset.le_sup (f := fun μ => N_fn (G₁.coeff μ)) hμ)
                (Nat.le_add_right _ _))⟩ := by
        simp only [C_tilde, hμ, ↓reduceDIte]
      have hvCμ : vMap (C_tilde μ) =
          v₁Map (G₁.coeff μ) * (vMap s₀) ^ (K_c + k_a * (D₀ - μ 0)) := by
        rw [hCμ]
        change algebraMap K E ((G₁.coeff μ : K) * (s₀ : K) ^ (K_c + k_a * (D₀ - μ 0))) =
          algebraMap K E (G₁.coeff μ : K) *
            (algebraMap K E (s₀ : K)) ^ (K_c + k_a * (D₀ - μ 0))
        rw [map_mul, map_pow]
      have hprod₀ : μ.prod (fun i e => (ev₀ i) ^ e) = (u') ^ (μ 0) * w ^ (μ 1) := by
        rw [Finsupp.prod_of_support_subset μ (Finset.subset_univ _)
          (fun i e => (ev₀ i) ^ e) (fun i _ => pow_zero _), Fin.prod_univ_two]
        simp [ev₀]
      have hprod₁ : μ.prod (fun i e => (ev₁ i) ^ e) = u ^ (μ 0) * w ^ (μ 1) := by
        rw [Finsupp.prod_of_support_subset μ (Finset.subset_univ _)
          (fun i e => (ev₁ i) ^ e) (fun i _ => pow_zero _), Fin.prod_univ_two]
        simp [ev₁]
      have hu'_pow : (u') ^ (μ 0) = (vMap s₀) ^ (k_a * μ 0) * u ^ (μ 0) := by
        dsimp only [u']
        rw [mul_pow, ← pow_mul]
      have hexp : (K_c + k_a * (D₀ - μ 0)) + k_a * μ 0 = K_c + k_a * D₀ := by
        calc
          (K_c + k_a * (D₀ - μ 0)) + k_a * μ 0 =
              K_c + (k_a * (D₀ - μ 0) + k_a * μ 0) := by rw [add_assoc]
          _ = K_c + k_a * (D₀ - μ 0 + μ 0) := by rw [← mul_add]
          _ = K_c + k_a * D₀ := by rw [Nat.sub_add_cancel hμD₀]
      rw [hvCμ, hprod₀, hprod₁, hu'_pow, ← hexp, pow_add]
      ring
    obtain ⟨K_tot, G_tilde, hΦ₀_Gtilde⟩ := hGtilde_ex
    let g₀ : MvPolynomial (Fin 2) ↥V ⧸
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a} :=
      Ideal.Quotient.mk _ (MvPolynomial.C s₀ * G_tilde)
    have hψ'_g₀ : ψ' g₀ = vMap s₀ * ((vMap s₀) ^ K_tot * γ₁) := by
      change Φ₀ (MvPolynomial.C s₀ * G_tilde) = _
      rw [map_mul, hΦ₀_Gtilde]
      simp [Φ₀]
    have hg₀_ne : ψ' g₀ ≠ 0 := by
      rw [hψ'_g₀]
      exact mul_ne_zero hvMap_s₀_ne (mul_ne_zero (pow_ne_zero K_tot hvMap_s₀_ne) hG₁_ne)
    have hg₀_inv : (ψ' g₀)⁻¹ ∈ Vx := by
      have hinv : (ψ' g₀)⁻¹ = (vMap s₀)⁻¹ * (((vMap s₀)⁻¹) ^ K_tot * γ₁⁻¹) := by
        rw [hψ'_g₀, mul_inv, mul_inv, inv_pow]
      rw [hinv]
      exact mul_mem hvMap_s₀_inv_Vx (mul_mem (pow_mem hvMap_s₀_inv_Vx K_tot) hG₁_inv)
    have hComp_ι : ψ'.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) = vMap := by
      ext y
      simp [ψ', Φ₀]
    obtain ⟨R, hVR, ψ, hRVx, hψ'R, hγ₀_inv_R, hψComp, hLoc⟩ :=
      hLocSubring
        (MvPolynomial (Fin 2) ↥V ⧸
          Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a})
        ψ' hψ'_inj ((Ideal.Quotient.mk _).comp MvPolynomial.C) hComp_ι hψ'_Vx
        g₀ hg₀_ne hg₀_inv
    have hs₀_inv_R : (vMap s₀)⁻¹ ∈ R := by
      have hGt_ne : (vMap s₀) ^ K_tot * γ₁ ≠ 0 :=
        mul_ne_zero (pow_ne_zero K_tot hvMap_s₀_ne) hG₁_ne
      have heq : (vMap s₀)⁻¹ = (ψ' g₀)⁻¹ * ψ' (Ideal.Quotient.mk _ G_tilde) := by
        change (vMap s₀)⁻¹ = (ψ' g₀)⁻¹ * Φ₀ G_tilde
        rw [hψ'_g₀, hΦ₀_Gtilde, mul_inv, mul_assoc, inv_mul_cancel₀ hGt_ne, mul_one]
      rw [heq]
      exact mul_mem hγ₀_inv_R (hψ'R (Ideal.Quotient.mk _ G_tilde))
    have hγ₁_inv_R : γ₁⁻¹ ∈ R := by
      have hs_pow_ne : vMap s₀ * (vMap s₀) ^ K_tot ≠ 0 :=
        mul_ne_zero hvMap_s₀_ne (pow_ne_zero K_tot hvMap_s₀_ne)
      have heq : γ₁⁻¹ = (ψ' g₀)⁻¹ * (vMap s₀ * (vMap s₀) ^ K_tot) := by
        have h1 : ψ' g₀ = (vMap s₀ * (vMap s₀) ^ K_tot) * γ₁ := by rw [hψ'_g₀, mul_assoc]
        rw [h1, mul_inv, mul_comm ((vMap s₀ * (vMap s₀) ^ K_tot)⁻¹) (γ₁⁻¹),
          mul_assoc, inv_mul_cancel₀ hs_pow_ne, mul_one]
      rw [heq]
      exact mul_mem hγ₀_inv_R (mul_mem (hVR s₀) (pow_mem (hVR s₀) K_tot))
    have hv₁R : ∀ c : ↥V₁, v₁Map c ∈ R := by
      intro c
      let N := N_fn c
      let c' : ↥V := ⟨(c : K) * (s₀ : K) ^ N, hN_fn c N le_rfl⟩
      have hvc' : vMap c' = v₁Map c * (vMap s₀) ^ N := by
        change algebraMap K E ((c : K) * (s₀ : K) ^ N) =
          algebraMap K E (c : K) * (algebraMap K E (s₀ : K)) ^ N
        rw [map_mul, map_pow]
      have hsN_ne : (vMap s₀) ^ N ≠ 0 := pow_ne_zero N hvMap_s₀_ne
      have hceq : v₁Map c = vMap c' * ((vMap s₀)⁻¹) ^ N := by
        rw [hvc', inv_pow, mul_inv_cancel_right₀ hsN_ne]
      rw [hceq]
      exact mul_mem (hVR c') (pow_mem hs₀_inv_R N)
    have hu'_R : u' ∈ R := by
      have hu'X : u' = ψ' (Ideal.Quotient.mk _ (MvPolynomial.X 0)) := by
        simp [ψ', Φ₀, ev₀]
      rw [hu'X]
      exact hψ'R _
    have hu_R : u ∈ R := by
      have hska_ne : (vMap s₀) ^ k_a ≠ 0 := pow_ne_zero k_a hvMap_s₀_ne
      have hueq : u = ((vMap s₀)⁻¹) ^ k_a * u' := by
        dsimp only [u']
        rw [inv_pow, inv_mul_cancel_left₀ hska_ne]
      rw [hueq]
      exact mul_mem (pow_mem hs₀_inv_R k_a) hu'_R
    have hw_R : w ∈ R := by
      have hwX : w = ψ' (Ideal.Quotient.mk _ (MvPolynomial.X 1)) := by
        simp [ψ', Φ₀, ev₀]
      rw [hwX]
      exact hψ'R _
    have hS₁R : ∀ z ∈ S₁, z ∈ R := by
      intro z hz
      obtain ⟨n, P, hzP⟩ := hS₁_rep z hz
      have hP_R : MvPolynomial.eval₂ v₁Map ev₁ P ∈ R := by
        rw [MvPolynomial.eval₂_eq]
        refine sum_mem fun μ _ => mul_mem (hv₁R (P.coeff μ)) (prod_mem fun i _ => ?_)
        refine pow_mem ?_ (μ i)
        dsimp only [ev₁]
        split_ifs
        · exact hu_R
        · exact hw_R
      have hγn_ne : γ₁ ^ n ≠ 0 := pow_ne_zero n hG₁_ne
      have hzeq : z = MvPolynomial.eval₂ v₁Map ev₁ P * (γ₁⁻¹) ^ n := by
        calc
          z = (z * γ₁ ^ n) * (γ₁ ^ n)⁻¹ := (mul_inv_cancel_right₀ hγn_ne z).symm
          _ = MvPolynomial.eval₂ v₁Map ev₁ P * (γ₁⁻¹) ^ n := by rw [hzP, inv_pow]
      rw [hzeq]
      exact mul_mem hP_R (pow_mem hγ₁_inv_R n)
    exact ⟨R, hVR, hRVx, hS₁R, Or.inr ⟨a, ψ, g₀, ha, hψComp, hLoc⟩⟩

theorem weil_sepClosed_ratFunc_perturbed_factorization (K : Type u) [Field K] [IsSepClosed K]
    (F : Type u) [Field F] [Algebra K F]
    (x : F) (hx_tr : Transcendental K x)
    (Vx : ValuationSubring ↥(IntermediateField.adjoin K ({x} : Set F)))
    (hxVx : (⟨x, IntermediateField.mem_adjoin_simple_self K x⟩ :
      ↥(IntermediateField.adjoin K ({x} : Set F))) ∈ Vx)
    (S₁ : Finset ↥(IntermediateField.adjoin K ({x} : Set F)))
    (hS₁ : ∀ z ∈ S₁, z ∈ Vx) :
    let E := ↥(IntermediateField.adjoin K ({x} : Set F))
    let x₀ : E := ⟨x, IntermediateField.mem_adjoin_simple_self K x⟩
    let V₁ : ValuationSubring K := Vx.comap (algebraMap K E)
    HasOverringSemistableChartWitness V₁ Vx S₁ ∨
      Nonempty (PerturbedRationalFactorization K E x₀ Vx S₁) :=
by
  classical
  let E := ↥(IntermediateField.adjoin K ({x} : Set F))
  let x₀ : E := ⟨x, IntermediateField.mem_adjoin_simple_self K x⟩
  let V₁ : ValuationSubring K := Vx.comap (algebraMap K E)
  let v₁Map : ↥V₁ →+* E := (algebraMap K E).comp V₁.subtype
  change HasOverringSemistableChartWitness V₁ Vx S₁ ∨
    Nonempty (PerturbedRationalFactorization K E x₀ Vx S₁)
  
  have hx₀_tr : Transcendental K x₀ :=
    (transcendental_algebraMap_iff (RingHom.injective (algebraMap E F))).mp hx_tr
  have haeval_ne : ∀ {R : Polynomial K}, R ≠ 0 → Polynomial.aeval x₀ R ≠ 0 := by
    intro R hR h0
    exact hx₀_tr ⟨R, hR, h0⟩
  have heval_mem : ∀ W : Polynomial ↥V₁, Polynomial.eval₂ v₁Map x₀ W ∈ Vx := by
    intro W
    induction W using Polynomial.induction_on' with
    | add p q hp hq =>
      rw [Polynomial.eval₂_add]
      exact Vx.toSubring.add_mem hp hq
    | monomial n a =>
      rw [Polynomial.eval₂_monomial]
      exact Vx.toSubring.mul_mem a.2 (Vx.toSubring.pow_mem hxVx n)
  have hex_PQ : ∀ f : E, f ≠ 0 →
      ∃ PQ : Polynomial K × Polynomial K,
        PQ.1 ≠ 0 ∧ PQ.2 ≠ 0 ∧ IsCoprime PQ.1 PQ.2 ∧
        f * Polynomial.aeval x₀ PQ.2 = Polynomial.aeval x₀ PQ.1 := by
    intro f hf0
    obtain ⟨r, s, hrs⟩ := (IntermediateField.mem_adjoin_simple_iff K f.1).mp f.2
    have hx₀_coe : (algebraMap E F) x₀ = x := rfl
    have h_alg_eval : ∀ p : Polynomial K,
        Polynomial.aeval x p = (algebraMap E F) (Polynomial.aeval x₀ p) :=
      fun p => (congrArg (fun y : F => Polynomial.aeval y p) hx₀_coe).symm.trans
        (Polynomial.aeval_algebraMap_apply F x₀ p)
    have hf_div : f = Polynomial.aeval x₀ r / Polynomial.aeval x₀ s := by
      apply RingHom.injective (algebraMap E F)
      rw [map_div₀, ← h_alg_eval r, ← h_alg_eval s]
      exact hrs
    have hr0 : r ≠ 0 := fun hr => hf0 (by rw [hf_div, hr, map_zero, zero_div])
    have hs0 : s ≠ 0 := fun hs => hf0 (by rw [hf_div, hs, map_zero, div_zero])
    let d := EuclideanDomain.gcd r s
    have hd0 : d ≠ 0 := by
      intro hd
      apply hs0
      have hdvd := EuclideanDomain.gcd_dvd_right r s
      rw [show EuclideanDomain.gcd r s = d from rfl, hd] at hdvd
      exact zero_dvd_iff.mp hdvd
    let P := r / d
    let Q := s / d
    have hdP : d * P = r := EuclideanDomain.mul_div_cancel' hd0 (EuclideanDomain.gcd_dvd_left r s)
    have hdQ : d * Q = s := EuclideanDomain.mul_div_cancel' hd0 (EuclideanDomain.gcd_dvd_right r s)
    have hP0 : P ≠ 0 := fun h => hr0 (by rw [← hdP, h, mul_zero])
    have hQ0 : Q ≠ 0 := fun h => hs0 (by rw [← hdQ, h, mul_zero])
    have hCop : IsCoprime P Q := by
      refine ⟨EuclideanDomain.gcdA r s, EuclideanDomain.gcdB r s, ?_⟩
      apply mul_left_cancel₀ hd0
      have hab : d = r * EuclideanDomain.gcdA r s + s * EuclideanDomain.gcdB r s :=
        EuclideanDomain.gcd_eq_gcd_ab r s
      calc
        d * (EuclideanDomain.gcdA r s * P + EuclideanDomain.gcdB r s * Q)
            = (d * P) * EuclideanDomain.gcdA r s + (d * Q) * EuclideanDomain.gcdB r s := by ring
        _ = r * EuclideanDomain.gcdA r s + s * EuclideanDomain.gcdB r s := by rw [hdP, hdQ]
        _ = d := hab.symm
        _ = d * 1 := (mul_one d).symm
    have hf_eq : f * Polynomial.aeval x₀ Q = Polynomial.aeval x₀ P := by
      have hd_ev : Polynomial.aeval x₀ d ≠ 0 := haeval_ne hd0
      have hQ_ev : Polynomial.aeval x₀ Q ≠ 0 := haeval_ne hQ0
      have hf_PQ : f = Polynomial.aeval x₀ P / Polynomial.aeval x₀ Q := by
        rw [hf_div, ← hdP, ← hdQ, map_mul, map_mul, mul_div_mul_left _ _ hd_ev]
      rw [hf_PQ, div_mul_cancel₀ _ hQ_ev]
    exact ⟨(P, Q), hP0, hQ0, hCop, hf_eq⟩
  let P_f : E → Polynomial K := fun f =>
    if hf : f ≠ 0 then (Classical.choose (hex_PQ f hf)).1 else 0
  let Q_f : E → Polynomial K := fun f =>
    if hf : f ≠ 0 then (Classical.choose (hex_PQ f hf)).2 else 1
  have hPQ : ∀ f ∈ S₁, f ≠ 0 →
      P_f f ≠ 0 ∧ Q_f f ≠ 0 ∧ IsCoprime (P_f f) (Q_f f) ∧
      f * Polynomial.aeval x₀ (Q_f f) = Polynomial.aeval x₀ (P_f f) := by
    intro f _ hf0
    have hP_eq : P_f f = (Classical.choose (hex_PQ f hf0)).1 := dif_pos hf0
    have hQ_eq : Q_f f = (Classical.choose (hex_PQ f hf0)).2 := dif_pos hf0
    rw [hP_eq, hQ_eq]
    exact Classical.choose_spec (hex_PQ f hf0)
  let S₁_nz := S₁.filter (fun z => z ≠ 0)
  by_cases hTop : V₁ = ⊤
  · 
    left
    left
    have hmemV₁ : ∀ c : K, c ∈ V₁ := fun c => hTop ▸ ValuationSubring.mem_top c
    let liftK : K →+* ↥V₁ :=
      { toFun := fun c => ⟨c, hmemV₁ c⟩
        map_one' := Subtype.ext rfl
        map_mul' := fun _ _ => Subtype.ext rfl
        map_zero' := Subtype.ext rfl
        map_add' := fun _ _ => Subtype.ext rfl }
    have hcomp : v₁Map.comp liftK = algebraMap K E := RingHom.ext fun _ => rfl
    have heval_map : ∀ R : Polynomial K,
        Polynomial.eval₂ v₁Map x₀ (R.map liftK) = Polynomial.aeval x₀ R := by
      intro R
      rw [Polynomial.eval₂_map, hcomp, Polynomial.aeval_def]
    have hQ_inv_mem : ∀ f ∈ S₁_nz, (Polynomial.aeval x₀ (Q_f f))⁻¹ ∈ Vx := by
      intro f hf
      obtain ⟨hfS, hf0⟩ := Finset.mem_filter.mp hf
      obtain ⟨_, _, ⟨A, B, hAB⟩, hf_eq⟩ := hPQ f hfS hf0
      have hAB_ev :
          (Polynomial.aeval x₀ A * f + Polynomial.aeval x₀ B) *
            Polynomial.aeval x₀ (Q_f f) = 1 := by
        calc
          (Polynomial.aeval x₀ A * f + Polynomial.aeval x₀ B) * Polynomial.aeval x₀ (Q_f f)
              = Polynomial.aeval x₀ A * (f * Polynomial.aeval x₀ (Q_f f)) +
                Polynomial.aeval x₀ B * Polynomial.aeval x₀ (Q_f f) := by ring
          _ = Polynomial.aeval x₀ A * Polynomial.aeval x₀ (P_f f) +
                Polynomial.aeval x₀ B * Polynomial.aeval x₀ (Q_f f) := by rw [hf_eq]
          _ = Polynomial.aeval x₀ (A * P_f f + B * Q_f f) := by simp
          _ = 1 := by rw [hAB, map_one]
      rw [inv_eq_of_mul_eq_one_left hAB_ev]
      have hA_mem : Polynomial.aeval x₀ A ∈ Vx := heval_map A ▸ heval_mem (A.map liftK)
      have hB_mem : Polynomial.aeval x₀ B ∈ Vx := heval_map B ▸ heval_mem (B.map liftK)
      exact Vx.toSubring.add_mem (Vx.toSubring.mul_mem hA_mem (hS₁ f hfS)) hB_mem
    let G : Polynomial K := ∏ f ∈ S₁_nz, Q_f f
    let g₁ : Polynomial ↥V₁ := G.map liftK
    refine ⟨x₀, g₁, hxVx, hx₀_tr, ?_, ?_, ?_⟩
    · rw [heval_map G, map_prod]
      exact Finset.prod_ne_zero_iff.mpr fun f hf =>
        haeval_ne (hPQ f (Finset.mem_filter.mp hf).1 (Finset.mem_filter.mp hf).2).2.1
    · rw [heval_map G, map_prod, ← Finset.prod_inv_distrib]
      exact Vx.toSubring.prod_mem fun f hf => hQ_inv_mem f hf
    · intro z hz
      by_cases hz0 : z = 0
      · exact ⟨0, 0, by simp [hz0]⟩
      · have hz_nz : z ∈ S₁_nz := Finset.mem_filter.mpr ⟨hz, hz0⟩
        let R_rem : Polynomial K := ∏ f ∈ S₁_nz.erase z, Q_f f
        have hG_split : G = Q_f z * R_rem := (Finset.mul_prod_erase S₁_nz Q_f hz_nz).symm
        refine ⟨1, (P_f z * R_rem).map liftK, ?_⟩
        rw [pow_one, heval_map G, heval_map (P_f z * R_rem), hG_split, map_mul, map_mul,
          ← mul_assoc, (hPQ z hz hz0).2.2.2]
  · 
    right
    obtain ⟨p_exp, hExp⟩ := ExpChar.exists K
    have hp_pos : 1 ≤ p_exp := by
      have h0 : 0 < p_exp := @expChar_pos K _ p_exp hExp
      omega
    
    have hSep_binom : ∀ (q : ℕ) (P : Polynomial K),
        P.Monic → Irreducible P → P.Separable →
        P = Polynomial.X ^ (q ^ 0) - Polynomial.C (- P.coeff 0) := by
      intro q P hMon hIrr hSep
      have hdeg1 : P.natDegree = 1 :=
        (IsSepClosed.splits_of_separable P hSep).natDegree_eq_one_of_irreducible hIrr
      have hlin := Polynomial.eq_X_add_C_of_natDegree_le_one hdeg1.le
      have hc1 : P.coeff 1 = 1 := by
        rw [← hdeg1, Polynomial.coeff_natDegree, hMon.leadingCoeff]
      rw [hc1, map_one, one_mul] at hlin
      conv_lhs => rw [hlin]
      rw [pow_zero, pow_one, map_neg, sub_neg_eq_add]
    have hBinom_deg : ∀ (d : ℕ) (P : Polynomial K),
        P.natDegree = d → P.Monic → Irreducible P →
        ∃ n : ℕ, P = Polynomial.X ^ (p_exp ^ n) - Polynomial.C (- P.coeff 0) := by
      intro d
      induction d using Nat.strong_induction_on with
      | h d ih =>
        intro P hd hMon hIrr
        cases hExp with
        | zero =>
          exact ⟨0, hSep_binom 1 P hMon hIrr hIrr.separable⟩
        | prime hprime =>
          have : Fact p_exp.Prime := ⟨hprime⟩
          rcases Polynomial.separable_or p_exp hIrr with hSep | ⟨_, g, hIrr_g, hg_eq⟩
          · exact ⟨0, hSep_binom p_exp P hMon hIrr hSep⟩
          · have hg_pos : 0 < g.natDegree := hIrr_g.natDegree_pos
            have hp_gt1 : 1 < p_exp := hprime.one_lt
            have hlt : g.natDegree < d := by
              have hexp_deg : (Polynomial.expand K p_exp g).natDegree = g.natDegree * p_exp :=
                Polynomial.natDegree_expand p_exp g
              rw [← hd, ← hg_eq, hexp_deg]
              exact lt_mul_of_one_lt_right hg_pos hp_gt1
            have hMon_g : g.Monic := by
              show g.leadingCoeff = 1
              rw [← Polynomial.leadingCoeff_expand (p := p_exp) hprime.pos, hg_eq]
              exact hMon.leadingCoeff
            obtain ⟨n', hn'⟩ := ih g.natDegree hlt g rfl hMon_g hIrr_g
            have hP_exp : P = Polynomial.X ^ (p_exp ^ (n' + 1)) - Polynomial.C (- g.coeff 0) := by
              calc
                P = Polynomial.expand K p_exp g := hg_eq.symm
                _ = Polynomial.expand K p_exp
                      (Polynomial.X ^ (p_exp ^ n') - Polynomial.C (- g.coeff 0)) :=
                  congrArg (Polynomial.expand K p_exp) hn'
                _ = (Polynomial.X ^ p_exp) ^ (p_exp ^ n') - Polynomial.C (- g.coeff 0) := by
                  rw [map_sub, map_pow, Polynomial.expand_X, Polynomial.expand_C]
                _ = Polynomial.X ^ (p_exp ^ (n' + 1)) - Polynomial.C (- g.coeff 0) := by
                  rw [← pow_mul, ← pow_succ']
            have hc0_eq : P.coeff 0 = g.coeff 0 := by
              have hpow_ne : (0 : ℕ) ≠ p_exp ^ (n' + 1) := (pow_ne_zero _ hprime.ne_zero).symm
              have hc0 := congrArg (fun Q : Polynomial K => Q.coeff 0) hP_exp
              simp only [Polynomial.coeff_sub, Polynomial.coeff_X_pow, Polynomial.coeff_C_zero] at hc0
              rw [ite_cond_eq_false _ _ (eq_false hpow_ne), zero_sub, neg_neg] at hc0
              exact hc0
            exact ⟨n' + 1, hc0_eq ▸ hP_exp⟩
    have hBinom : ∀ P : Polynomial K, P.Monic → Irreducible P →
        ∃ n : ℕ, P = Polynomial.X ^ (p_exp ^ n) - Polynomial.C (- P.coeff 0) :=
      fun P hMon hIrr => hBinom_deg P.natDegree P rfl hMon hIrr
    let NF (R : Polynomial K) : Multiset (Polynomial K) :=
      UniqueFactorizationMonoid.normalizedFactors R
    let I_set : Finset (Polynomial K) :=
      insert Polynomial.X
        (S₁_nz.biUnion fun f =>
          ((NF (P_f f)).toFinset ∪ (NF (Q_f f)).toFinset).filter fun P => P.coeff 0 ∈ V₁)
    have hI_props : ∀ P ∈ I_set, Irreducible P ∧ P.Monic ∧ P.coeff 0 ∈ V₁ := by
      intro P hP
      rcases Finset.mem_insert.mp hP with rfl | hP_bi
      · refine ⟨Polynomial.irreducible_X, Polynomial.monic_X, ?_⟩
        simp [Polynomial.coeff_X_zero]
      · obtain ⟨f, hf_nz, hP_flt⟩ := Finset.mem_biUnion.mp hP_bi
        obtain ⟨hfS, hf0⟩ := Finset.mem_filter.mp hf_nz
        obtain ⟨hP_un, hc0⟩ := Finset.mem_filter.mp hP_flt
        rcases Finset.mem_union.mp hP_un with hP_mem | hQ_mem
        · obtain ⟨hIrr, hMon, _⟩ :=
            (Polynomial.mem_normalizedFactors_iff (hPQ f hfS hf0).1).mp
              (Multiset.mem_toFinset.mp hP_mem)
          exact ⟨hIrr, hMon, hc0⟩
        · obtain ⟨hIrr, hMon, _⟩ :=
            (Polynomial.mem_normalizedFactors_iff (hPQ f hfS hf0).2.1).mp
              (Multiset.mem_toFinset.mp hQ_mem)
          exact ⟨hIrr, hMon, hc0⟩
    let M : ℕ := Fintype.card ↥I_set
    have hM : 1 ≤ M := by
      change 1 ≤ Fintype.card ↥I_set
      rw [Fintype.card_coe]
      exact Finset.card_pos.mpr ⟨Polynomial.X, Finset.mem_insert_self _ _⟩
    let σ : Fin M ≃ ↥I_set := (Fintype.equivFin ↥I_set).symm
    let P_int : Fin M → Polynomial K := fun i => (σ i).1
    let α : Fin M → ↥V₁ := fun i =>
      ⟨- (P_int i).coeff 0, V₁.toSubring.neg_mem (hI_props (P_int i) (σ i).2).2.2⟩
    have hex_e : ∀ i : Fin M,
        ∃ n : ℕ, P_int i = Polynomial.X ^ (p_exp ^ n) - Polynomial.C (α i).1 :=
      fun i => hBinom (P_int i) (hI_props (P_int i) (σ i).2).2.1 (hI_props (P_int i) (σ i).2).1
    let e : Fin M → ℕ := fun i => Classical.choose (hex_e i)
    have hP_int_eq : ∀ i : Fin M,
        P_int i = Polynomial.X ^ (p_exp ^ (e i)) - Polynomial.C (α i).1 :=
      fun i => Classical.choose_spec (hex_e i)
    have hp_coprime : ∀ i j : Fin M, i ≠ j → IsCoprime (P_int i) (P_int j) := by
      intro i j hij
      have hIrr_i := (hI_props (P_int i) (σ i).2).1
      have hIrr_j := (hI_props (P_int j) (σ j).2).1
      have hMon_i := (hI_props (P_int i) (σ i).2).2.1
      have hMon_j := (hI_props (P_int j) (σ j).2).2.1
      rw [hIrr_i.coprime_iff_not_dvd]
      intro ⟨W, hW_eq⟩
      have hUnitW : IsUnit W :=
        (hIrr_j.isUnit_or_isUnit hW_eq).resolve_left hIrr_i.not_isUnit
      obtain ⟨c, _, hcW⟩ := Polynomial.isUnit_iff.mp hUnitW
      have hc1 : c = 1 := by
        have hlc := congrArg Polynomial.leadingCoeff hW_eq
        rw [← hcW, hMon_j.leadingCoeff, Polynomial.leadingCoeff_mul, hMon_i.leadingCoeff,
          Polynomial.leadingCoeff_C, one_mul] at hlc
        exact hlc.symm
      have hEqP : P_int i = P_int j := by rw [hW_eq, ← hcW, hc1, map_one, mul_one]
      exact hij (σ.injective (Subtype.ext hEqP))
    let p_val : Fin M → E := fun i => x₀ ^ (p_exp ^ (e i)) - v₁Map (α i)
    have hp_eval_eq : ∀ i : Fin M, Polynomial.aeval x₀ (P_int i) = p_val i := by
      intro i
      rw [hP_int_eq i]
      simp [p_val, v₁Map]
    have hp_mem : ∀ i : Fin M, p_val i ∈ Vx ∧ p_val i ≠ 0 := by
      intro i
      refine ⟨Vx.toSubring.sub_mem (Vx.toSubring.pow_mem hxVx _) (α i).2, ?_⟩
      rw [← hp_eval_eq i]
      exact haeval_ne (hI_props (P_int i) (σ i).2).1.ne_zero
    have hExt_factor : ∀ P : Polynomial K,
        Irreducible P → P.Monic → P.coeff 0 ∉ V₁ →
        ∃ (s : K) (u : Polynomial ↥V₁),
          s ≠ 0 ∧
          Polynomial.eval₂ v₁Map x₀ u ≠ 0 ∧
          (Polynomial.eval₂ v₁Map x₀ u)⁻¹ ∈ Vx ∧
          Polynomial.aeval x₀ P = algebraMap K E s * Polynomial.eval₂ v₁Map x₀ u := by
      intro P hIrr hMon hc0_not
      obtain ⟨n, hn⟩ := hBinom P hMon hIrr
      let q := p_exp ^ n
      let α_P : K := - P.coeff 0
      have hα_not : α_P ∉ V₁ := fun h => hc0_not (by simpa [α_P] using V₁.toSubring.neg_mem h)
      have hα_ne : α_P ≠ 0 := fun h => hα_not (h ▸ V₁.toSubring.zero_mem)
      have hα_inv : α_P⁻¹ ∈ V₁ := (V₁.mem_or_inv_mem α_P).resolve_left hα_not
      let γ : ↥V₁ := ⟨α_P⁻¹, hα_inv⟩
      let u : Polynomial ↥V₁ := 1 - Polynomial.C γ * Polynomial.X ^ q
      have hw_mem : algebraMap K E α_P⁻¹ * x₀ ^ q ∈ Vx :=
        Vx.toSubring.mul_mem hα_inv (Vx.toSubring.pow_mem hxVx q)
      let w_Vx : ↥Vx := ⟨algebraMap K E α_P⁻¹ * x₀ ^ q, hw_mem⟩
      let z_Vx : ↥Vx := 1 - w_Vx
      have hw_nunit : ¬ IsUnit w_Vx := by
        intro ⟨u_w, hu_w⟩
        have hmulE : (algebraMap K E α_P⁻¹ * x₀ ^ q) * (↑(u_w⁻¹) : ↥Vx).1 = 1 :=
          congrArg Subtype.val (hu_w ▸ Units.mul_inv u_w)
        have hα_eq : algebraMap K E α_P = x₀ ^ q * (↑(u_w⁻¹) : ↥Vx).1 := by
          calc
            algebraMap K E α_P
                = algebraMap K E α_P * ((algebraMap K E α_P⁻¹ * x₀ ^ q) * (↑(u_w⁻¹) : ↥Vx).1) := by
                  rw [hmulE, mul_one]
            _ = algebraMap K E (α_P * α_P⁻¹) * (x₀ ^ q * (↑(u_w⁻¹) : ↥Vx).1) := by
                  rw [map_mul]; ring
            _ = x₀ ^ q * (↑(u_w⁻¹) : ↥Vx).1 := by
                  rw [mul_inv_cancel₀ hα_ne, map_one, one_mul]
        have hα_in_Vx : algebraMap K E α_P ∈ Vx := by
          rw [hα_eq]
          exact Vx.toSubring.mul_mem (Vx.toSubring.pow_mem hxVx q) (↑(u_w⁻¹) : ↥Vx).2
        exact hα_not hα_in_Vx
      have hz_unit : IsUnit z_Vx := by
        have hw_max : w_Vx ∈ IsLocalRing.maximalIdeal ↥Vx := by
          rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
          exact hw_nunit
        by_contra hz_nunit
        have hz_max : z_Vx ∈ IsLocalRing.maximalIdeal ↥Vx := by
          rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
          exact hz_nunit
        have h1_max : (1 : ↥Vx) ∈ IsLocalRing.maximalIdeal ↥Vx := by
          have hsum : z_Vx + w_Vx = 1 := sub_add_cancel 1 w_Vx
          exact hsum ▸ Ideal.add_mem _ hz_max hw_max
        exact (IsLocalRing.maximalIdeal.isMaximal ↥Vx).ne_top
          (Ideal.eq_top_of_isUnit_mem _ h1_max isUnit_one)
      obtain ⟨u_z, hu_z⟩ := hz_unit
      have hz_ev : Polynomial.eval₂ v₁Map x₀ u = z_Vx.1 := by
        simp [u, z_Vx, w_Vx, v₁Map, γ]
      have hz_mul_inv : z_Vx.1 * (↑(u_z⁻¹) : ↥Vx).1 = 1 :=
        congrArg Subtype.val (hu_z ▸ Units.mul_inv u_z)
      have hu_ne : Polynomial.eval₂ v₁Map x₀ u ≠ 0 := by
        rw [hz_ev]
        intro h0
        rw [h0, zero_mul] at hz_mul_inv
        exact zero_ne_one hz_mul_inv
      have hu_inv : (Polynomial.eval₂ v₁Map x₀ u)⁻¹ ∈ Vx := by
        rw [hz_ev, inv_eq_of_mul_eq_one_right hz_mul_inv]
        exact (↑(u_z⁻¹) : ↥Vx).2
      refine ⟨- α_P, u, neg_ne_zero.mpr hα_ne, hu_ne, hu_inv, ?_⟩
      rw [hn, hz_ev]
      change Polynomial.aeval x₀ (Polynomial.X ^ q - Polynomial.C α_P) =
        algebraMap K E (- α_P) * (1 - algebraMap K E α_P⁻¹ * x₀ ^ q)
      simp only [map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C, map_neg]
      have hcancel : algebraMap K E α_P * algebraMap K E α_P⁻¹ = 1 := by
        rw [← map_mul, mul_inv_cancel₀ hα_ne, map_one]
      calc
        x₀ ^ q - algebraMap K E α_P
            = - algebraMap K E α_P + (algebraMap K E α_P * algebraMap K E α_P⁻¹) * x₀ ^ q := by
              rw [hcancel, one_mul]; ring
        _ = (- algebraMap K E α_P) * (1 - algebraMap K E α_P⁻¹ * x₀ ^ q) := by ring
    have hFactor_poly : ∀ R : Polynomial K, R ≠ 0 →
        (∀ P ∈ (NF R).toFinset, P.coeff 0 ∈ V₁ → P ∈ I_set) →
        ∃ (s : K) (U : Polynomial ↥V₁),
          s ≠ 0 ∧
          Polynomial.eval₂ v₁Map x₀ U ≠ 0 ∧
          (Polynomial.eval₂ v₁Map x₀ U)⁻¹ ∈ Vx ∧
          Polynomial.aeval x₀ R =
            algebraMap K E s * Polynomial.eval₂ v₁Map x₀ U *
              ∏ i : Fin M, (p_val i) ^ (Multiset.count (P_int i) (NF R)) := by
      intro R hR hR_sub
      obtain ⟨u_R, hu_R⟩ := UniqueFactorizationMonoid.prod_normalizedFactors hR
      obtain ⟨c_R, hc_R_unit, hc_R_eq⟩ := Polynomial.isUnit_iff.mp u_R.isUnit
      have hc_R_ne : c_R ≠ 0 := IsUnit.ne_zero hc_R_unit
      have hR_prod : R = Polynomial.C c_R * (NF R).prod := by
        calc
          R = (NF R).prod * ↑u_R := hu_R.symm
          _ = Polynomial.C c_R * (NF R).prod := by rw [← hc_R_eq, mul_comm]
      let F_int := (NF R).toFinset.filter (fun P => P.coeff 0 ∈ V₁)
      let F_ext := (NF R).toFinset.filter (fun P => P.coeff 0 ∉ V₁)
      have hNF_split : (NF R).prod =
          (∏ P ∈ F_int, P ^ Multiset.count P (NF R)) *
          (∏ P ∈ F_ext, P ^ Multiset.count P (NF R)) := by
        rw [Finset.prod_multiset_count (s := NF R),
          ← Finset.prod_filter_mul_prod_filter_not (NF R).toFinset (fun P => P.coeff 0 ∈ V₁)]
      have hInt_eq : (∏ P ∈ F_int, P ^ Multiset.count P (NF R)) =
          ∏ i : Fin M, (P_int i) ^ Multiset.count (P_int i) (NF R) := by
        have hsub : F_int ⊆ I_set := fun P hP =>
          hR_sub P (Finset.mem_filter.mp hP).1 (Finset.mem_filter.mp hP).2
        have hzero : ∀ P ∈ I_set, P ∉ F_int → P ^ Multiset.count P (NF R) = 1 := by
          intro P hPI hPnot
          have hc0 : P.coeff 0 ∈ V₁ := (hI_props P hPI).2.2
          have hnot_to : P ∉ (NF R).toFinset := fun hmem =>
            hPnot (Finset.mem_filter.mpr ⟨hmem, hc0⟩)
          have hcnt0 : Multiset.count P (NF R) = 0 :=
            Multiset.count_eq_zero.mpr (Multiset.mem_toFinset.not.mp hnot_to)
          rw [hcnt0, pow_zero]
        rw [Finset.prod_subset hsub hzero, ← Finset.prod_coe_sort I_set, ← Equiv.prod_comp σ]
      have hExt_ex : ∀ P : Polynomial K, P ∈ F_ext →
          ∃ su : K × Polynomial ↥V₁,
            su.1 ≠ 0 ∧
            Polynomial.eval₂ v₁Map x₀ su.2 ≠ 0 ∧
            (Polynomial.eval₂ v₁Map x₀ su.2)⁻¹ ∈ Vx ∧
            Polynomial.aeval x₀ P = algebraMap K E su.1 * Polynomial.eval₂ v₁Map x₀ su.2 := by
        intro P hP
        obtain ⟨hP_to, hc0_not⟩ := Finset.mem_filter.mp hP
        obtain ⟨hIrr, hMon, _⟩ :=
          (Polynomial.mem_normalizedFactors_iff hR).mp (Multiset.mem_toFinset.mp hP_to)
        obtain ⟨s, u, hs, hu_ne, hu_inv, heq⟩ := hExt_factor P hIrr hMon hc0_not
        exact ⟨(s, u), hs, hu_ne, hu_inv, heq⟩
      let s_ext : Polynomial K → K := fun P =>
        if h : P ∈ F_ext then (Classical.choose (hExt_ex P h)).1 else 1
      let u_ext : Polynomial K → Polynomial ↥V₁ := fun P =>
        if h : P ∈ F_ext then (Classical.choose (hExt_ex P h)).2 else 1
      let s : K := c_R * ∏ P ∈ F_ext, (s_ext P) ^ Multiset.count P (NF R)
      let U : Polynomial ↥V₁ := ∏ P ∈ F_ext, (u_ext P) ^ Multiset.count P (NF R)
      have hs_ne : s ≠ 0 := by
        refine mul_ne_zero hc_R_ne (Finset.prod_ne_zero_iff.mpr fun P hP => ?_)
        apply pow_ne_zero
        have hs_eq : s_ext P = (Classical.choose (hExt_ex P hP)).1 := dif_pos hP
        rw [hs_eq]
        exact (Classical.choose_spec (hExt_ex P hP)).1
      have hU_ev : Polynomial.eval₂ v₁Map x₀ U =
          ∏ P ∈ F_ext, (Polynomial.eval₂ v₁Map x₀ (u_ext P)) ^ Multiset.count P (NF R) := by
        simp only [U, Polynomial.eval₂_finsetProd, Polynomial.eval₂_pow]
      have hU_ne : Polynomial.eval₂ v₁Map x₀ U ≠ 0 := by
        rw [hU_ev]
        refine Finset.prod_ne_zero_iff.mpr fun P hP => pow_ne_zero _ ?_
        have hu_eq : u_ext P = (Classical.choose (hExt_ex P hP)).2 := dif_pos hP
        rw [hu_eq]
        exact (Classical.choose_spec (hExt_ex P hP)).2.1
      have hU_inv : (Polynomial.eval₂ v₁Map x₀ U)⁻¹ ∈ Vx := by
        rw [hU_ev, ← Finset.prod_inv_distrib]
        refine Vx.toSubring.prod_mem fun P hP => ?_
        rw [← inv_pow]
        apply Vx.toSubring.pow_mem
        have hu_eq : u_ext P = (Classical.choose (hExt_ex P hP)).2 := dif_pos hP
        rw [hu_eq]
        exact (Classical.choose_spec (hExt_ex P hP)).2.2.1
      refine ⟨s, U, hs_ne, hU_ne, hU_inv, ?_⟩
      have hExt_ev : Polynomial.aeval x₀ (∏ P ∈ F_ext, P ^ Multiset.count P (NF R)) =
          (∏ P ∈ F_ext, algebraMap K E (s_ext P) ^ Multiset.count P (NF R)) *
          Polynomial.eval₂ v₁Map x₀ U := by
        rw [map_prod, hU_ev, ← Finset.prod_mul_distrib]
        refine Finset.prod_congr rfl fun P hP => ?_
        rw [map_pow, ← mul_pow]
        congr 1
        have hs_eq : s_ext P = (Classical.choose (hExt_ex P hP)).1 := dif_pos hP
        have hu_eq : u_ext P = (Classical.choose (hExt_ex P hP)).2 := dif_pos hP
        rw [hs_eq, hu_eq]
        exact (Classical.choose_spec (hExt_ex P hP)).2.2.2
      have hInt_ev : Polynomial.aeval x₀ (∏ P ∈ F_int, P ^ Multiset.count P (NF R)) =
          ∏ i : Fin M, (p_val i) ^ Multiset.count (P_int i) (NF R) := by
        rw [hInt_eq, map_prod]
        refine Finset.prod_congr rfl fun i _ => ?_
        rw [map_pow, hp_eval_eq i]
      calc
        Polynomial.aeval x₀ R
            = Polynomial.aeval x₀ (Polynomial.C c_R *
                ((∏ P ∈ F_int, P ^ Multiset.count P (NF R)) *
                  (∏ P ∈ F_ext, P ^ Multiset.count P (NF R)))) := by
              rw [← hNF_split, ← hR_prod]
        _ = algebraMap K E c_R *
              ((∏ i : Fin M, (p_val i) ^ Multiset.count (P_int i) (NF R)) *
                ((∏ P ∈ F_ext, algebraMap K E (s_ext P) ^ Multiset.count P (NF R)) *
                  Polynomial.eval₂ v₁Map x₀ U)) := by
              rw [map_mul, map_mul, Polynomial.aeval_C, hInt_ev, hExt_ev]
        _ = algebraMap K E s * Polynomial.eval₂ v₁Map x₀ U *
              ∏ i : Fin M, (p_val i) ^ Multiset.count (P_int i) (NF R) := by
              simp only [s, map_mul, map_prod, map_pow]
              ring
    have hex_f : ∀ f : E, f ∈ S₁_nz →
        ∃ (nm : ↥V₁ × ↥V₁) (UU : Polynomial ↥V₁ × Polynomial ↥V₁),
          nm.1 ≠ 0 ∧ nm.2 ≠ 0 ∧
          Polynomial.eval₂ v₁Map x₀ UU.1 ≠ 0 ∧
          (Polynomial.eval₂ v₁Map x₀ UU.1)⁻¹ ∈ Vx ∧
          Polynomial.eval₂ v₁Map x₀ UU.2 ≠ 0 ∧
          (Polynomial.eval₂ v₁Map x₀ UU.2)⁻¹ ∈ Vx ∧
          f * (v₁Map nm.2 * Polynomial.eval₂ v₁Map x₀ UU.2 *
              ∏ i : Fin M, (p_val i) ^ Multiset.count (P_int i) (NF (Q_f f))) =
            v₁Map nm.1 * Polynomial.eval₂ v₁Map x₀ UU.1 *
              ∏ i : Fin M, (p_val i) ^ Multiset.count (P_int i) (NF (P_f f)) := by
      intro f hf_nz
      obtain ⟨hfS, hf0⟩ := Finset.mem_filter.mp hf_nz
      obtain ⟨hP0, hQ0, _, hf_eq⟩ := hPQ f hfS hf0
      have hP_sub : ∀ P ∈ (NF (P_f f)).toFinset, P.coeff 0 ∈ V₁ → P ∈ I_set := fun P hP hc0 =>
        Finset.mem_insert_of_mem (Finset.mem_biUnion.mpr
          ⟨f, hf_nz, Finset.mem_filter.mpr ⟨Finset.mem_union_left _ hP, hc0⟩⟩)
      have hQ_sub : ∀ P ∈ (NF (Q_f f)).toFinset, P.coeff 0 ∈ V₁ → P ∈ I_set := fun P hP hc0 =>
        Finset.mem_insert_of_mem (Finset.mem_biUnion.mpr
          ⟨f, hf_nz, Finset.mem_filter.mpr ⟨Finset.mem_union_right _ hP, hc0⟩⟩)
      obtain ⟨s_P, U_P, hsP_ne, hUP_ne, hUP_inv, hP_ev⟩ := hFactor_poly (P_f f) hP0 hP_sub
      obtain ⟨s_Q, U_Q, hsQ_ne, hUQ_ne, hUQ_inv, hQ_ev⟩ := hFactor_poly (Q_f f) hQ0 hQ_sub
      let c_f : K := s_P / s_Q
      have hcf_ne : c_f ≠ 0 := div_ne_zero hsP_ne hsQ_ne
      have hnm_ex : ∃ nm : ↥V₁ × ↥V₁,
          nm.1 ≠ 0 ∧ nm.2 ≠ 0 ∧ nm.2.1 * s_P = nm.1.1 * s_Q := by
        by_cases hcf : c_f ∈ V₁
        · refine ⟨(⟨c_f, hcf⟩, 1), fun h => hcf_ne (congrArg Subtype.val h), one_ne_zero, ?_⟩
          simp [c_f, div_mul_cancel₀ _ hsQ_ne]
        · have hcf_inv : c_f⁻¹ ∈ V₁ := (V₁.mem_or_inv_mem c_f).resolve_left hcf
          refine ⟨(1, ⟨c_f⁻¹, hcf_inv⟩), one_ne_zero,
            fun h => inv_ne_zero hcf_ne (congrArg Subtype.val h), ?_⟩
          change (s_P / s_Q)⁻¹ * s_P = 1 * s_Q
          rw [inv_div, one_mul, div_mul_cancel₀ _ hsP_ne]
      obtain ⟨nm, hnm1, hnm2, hnm_rel⟩ := hnm_ex
      refine ⟨nm, (U_P, U_Q), hnm1, hnm2, hUP_ne, hUP_inv, hUQ_ne, hUQ_inv, ?_⟩
      change f * (v₁Map nm.2 * Polynomial.eval₂ v₁Map x₀ U_Q *
          ∏ i : Fin M, (p_val i) ^ Multiset.count (P_int i) (NF (Q_f f))) =
        v₁Map nm.1 * Polynomial.eval₂ v₁Map x₀ U_P *
          ∏ i : Fin M, (p_val i) ^ Multiset.count (P_int i) (NF (P_f f))
      have hsQ_E_ne : algebraMap K E s_Q ≠ 0 :=
        (map_ne_zero_iff (algebraMap K E) (RingHom.injective (algebraMap K E))).mpr hsQ_ne
      have hnm_E : v₁Map nm.2 * algebraMap K E s_P = v₁Map nm.1 * algebraMap K E s_Q := by
        change algebraMap K E nm.2.1 * algebraMap K E s_P =
          algebraMap K E nm.1.1 * algebraMap K E s_Q
        rw [← map_mul, ← map_mul, hnm_rel]
      let prod_b := Polynomial.eval₂ v₁Map x₀ U_Q *
        ∏ i : Fin M, (p_val i) ^ Multiset.count (P_int i) (NF (Q_f f))
      let prod_a := Polynomial.eval₂ v₁Map x₀ U_P *
        ∏ i : Fin M, (p_val i) ^ Multiset.count (P_int i) (NF (P_f f))
      have hf_sub : f * (algebraMap K E s_Q * prod_b) = algebraMap K E s_P * prod_a := by
        have h1 := hf_eq
        rw [hQ_ev, hP_ev] at h1
        simpa [prod_b, prod_a, mul_assoc] using h1
      apply mul_left_cancel₀ hsQ_E_ne
      calc
        algebraMap K E s_Q *
            (f * (v₁Map nm.2 * Polynomial.eval₂ v₁Map x₀ U_Q *
              ∏ i : Fin M, (p_val i) ^ Multiset.count (P_int i) (NF (Q_f f))))
            = v₁Map nm.2 * (f * (algebraMap K E s_Q * prod_b)) := by simp only [prod_b]; ring
        _ = v₁Map nm.2 * (algebraMap K E s_P * prod_a) := by rw [hf_sub]
        _ = (v₁Map nm.2 * algebraMap K E s_P) * prod_a := by ring
        _ = (v₁Map nm.1 * algebraMap K E s_Q) * prod_a := by rw [hnm_E]
        _ = algebraMap K E s_Q *
            (v₁Map nm.1 * Polynomial.eval₂ v₁Map x₀ U_P *
              ∏ i : Fin M, (p_val i) ^ Multiset.count (P_int i) (NF (P_f f))) := by
          simp only [prod_a]; ring
    let n_f : E → ↥V₁ := fun f => if h : f ∈ S₁_nz then (Classical.choose (hex_f f h)).1 else 1
    let m_f : E → ↥V₁ := fun f => if h : f ∈ S₁_nz then (Classical.choose (hex_f f h)).2 else 1
    let U_pos : E → Polynomial ↥V₁ := fun f =>
      if h : f ∈ S₁_nz then (Classical.choose (Classical.choose_spec (hex_f f h))).1 else 1
    let U_neg : E → Polynomial ↥V₁ := fun f =>
      if h : f ∈ S₁_nz then (Classical.choose (Classical.choose_spec (hex_f f h))).2 else 1
    let a_exp : E → Fin M → ℕ := fun f i => Multiset.count (P_int i) (NF (P_f f))
    let b_exp : E → Fin M → ℕ := fun f i => Multiset.count (P_int i) (NF (Q_f f))
    have hf_fac : ∀ f ∈ S₁, f ≠ 0 →
        n_f f ≠ 0 ∧
        m_f f ≠ 0 ∧
        Polynomial.eval₂ v₁Map x₀ (U_pos f) ≠ 0 ∧
        (Polynomial.eval₂ v₁Map x₀ (U_pos f))⁻¹ ∈ Vx ∧
        Polynomial.eval₂ v₁Map x₀ (U_neg f) ≠ 0 ∧
        (Polynomial.eval₂ v₁Map x₀ (U_neg f))⁻¹ ∈ Vx ∧
        (∀ i : Fin M, a_exp f i = 0 ∨ b_exp f i = 0) ∧
        f * (v₁Map (m_f f) * Polynomial.eval₂ v₁Map x₀ (U_neg f) *
            ∏ i : Fin M, (p_val i) ^ (b_exp f i)) =
          v₁Map (n_f f) * Polynomial.eval₂ v₁Map x₀ (U_pos f) *
            ∏ i : Fin M, (p_val i) ^ (a_exp f i) := by
      intro f hfS hf0
      have hf_nz : f ∈ S₁_nz := Finset.mem_filter.mpr ⟨hfS, hf0⟩
      have hspec := Classical.choose_spec (Classical.choose_spec (hex_f f hf_nz))
      have hn_eq : n_f f = (Classical.choose (hex_f f hf_nz)).1 := dif_pos hf_nz
      have hm_eq : m_f f = (Classical.choose (hex_f f hf_nz)).2 := dif_pos hf_nz
      have hup_eq : U_pos f = (Classical.choose (Classical.choose_spec (hex_f f hf_nz))).1 :=
        dif_pos hf_nz
      have hun_eq : U_neg f = (Classical.choose (Classical.choose_spec (hex_f f hf_nz))).2 :=
        dif_pos hf_nz
      rw [hn_eq, hm_eq, hup_eq, hun_eq]
      refine ⟨hspec.1, hspec.2.1, hspec.2.2.1, hspec.2.2.2.1, hspec.2.2.2.2.1, hspec.2.2.2.2.2.1,
        ?_, hspec.2.2.2.2.2.2⟩
      intro i
      by_cases ha0 : a_exp f i = 0
      · exact Or.inl ha0
      · right
        by_contra hb0
        obtain ⟨hP0, hQ0, hCop_PQ, _⟩ := hPQ f hfS hf0
        have hmemP : P_int i ∈ NF (P_f f) := Multiset.count_pos.mp (Nat.pos_of_ne_zero ha0)
        have hmemQ : P_int i ∈ NF (Q_f f) := Multiset.count_pos.mp (Nat.pos_of_ne_zero hb0)
        have hdvdP : P_int i ∣ P_f f := ((Polynomial.mem_normalizedFactors_iff hP0).mp hmemP).2.2
        have hdvdQ : P_int i ∣ Q_f f := ((Polynomial.mem_normalizedFactors_iff hQ0).mp hmemQ).2.2
        exact (hI_props (P_int i) (σ i).2).1.not_isUnit (hCop_PQ.isUnit_of_dvd' hdvdP hdvdQ)
    
    have hex_c₀ : ∃ c₀ : K, c₀ ∉ V₁ := by
      by_contra hall
      apply hTop
      ext c
      exact ⟨fun _ => trivial, fun _ => Decidable.byContradiction fun hc => hall ⟨c, hc⟩⟩
    obtain ⟨c₀, hc₀_not⟩ := hex_c₀
    have hc₀_ne : c₀ ≠ 0 := fun h => hc₀_not (h ▸ V₁.toSubring.zero_mem)
    have hc₀_inv : c₀⁻¹ ∈ V₁ := (V₁.mem_or_inv_mem c₀).resolve_left hc₀_not
    let t₀ : ↥V₁ := ⟨c₀⁻¹, hc₀_inv⟩
    have ht₀_ne : t₀ ≠ 0 := fun h => inv_ne_zero hc₀_ne (congrArg Subtype.val h)
    have ht₀_E_ne : v₁Map t₀ ≠ 0 :=
      (map_ne_zero_iff (algebraMap K E) (RingHom.injective (algebraMap K E))).mpr
        (inv_ne_zero hc₀_ne)
    have ht₀_inv_not : (v₁Map t₀)⁻¹ ∉ Vx := by
      have heq : (v₁Map t₀)⁻¹ = algebraMap K E c₀ := by
        change (algebraMap K E c₀⁻¹)⁻¹ = algebraMap K E c₀
        rw [map_inv₀, inv_inv]
      rw [heq]
      exact hc₀_not
    let I_bdd : Finset (Fin M) :=
      Finset.univ.filter fun i => ∃ d : ↥V₁, d ≠ 0 ∧ v₁Map d / p_val i ∈ Vx
    let d_wit : Fin M → ↥V₁ := fun i =>
      if hi : i ∈ I_bdd then Classical.choose (Finset.mem_filter.mp hi).2 else 1
    let δ : Fin M → ↥V₁ := fun i => if i ∈ I_bdd then t₀ * d_wit i else 1
    have hδ_props : ∀ i ∈ I_bdd,
        δ i ≠ 0 ∧ v₁Map (δ i) / p_val i ∈ Vx ∧ p_val i / v₁Map (δ i) ∉ Vx := by
      intro i hi
      have hspec := Classical.choose_spec (Finset.mem_filter.mp hi).2
      have hdw_eq : d_wit i = Classical.choose (Finset.mem_filter.mp hi).2 := dif_pos hi
      have hd_ne : d_wit i ≠ 0 := hdw_eq ▸ hspec.1
      have hd_mem : v₁Map (d_wit i) / p_val i ∈ Vx := hdw_eq ▸ hspec.2
      have hδ_eq : δ i = t₀ * d_wit i := if_pos hi
      refine ⟨hδ_eq ▸ mul_ne_zero ht₀_ne hd_ne, ?_, ?_⟩
      · rw [hδ_eq, map_mul, mul_div_assoc]
        exact Vx.toSubring.mul_mem t₀.2 hd_mem
      · intro h_in
        rw [hδ_eq, map_mul] at h_in
        have hd_E_ne : v₁Map (d_wit i) ≠ 0 :=
          (map_ne_zero_iff (algebraMap K E) (RingHom.injective (algebraMap K E))).mpr
            (Subtype.val_injective.ne hd_ne)
        have hp_ne : p_val i ≠ 0 := (hp_mem i).2
        have hprod_eq : (p_val i / (v₁Map t₀ * v₁Map (d_wit i))) * (v₁Map (d_wit i) / p_val i) =
            (v₁Map t₀)⁻¹ := by
          symm
          apply inv_eq_of_mul_eq_one_right
          calc
            v₁Map t₀ * ((p_val i / (v₁Map t₀ * v₁Map (d_wit i))) * (v₁Map (d_wit i) / p_val i))
                = ((v₁Map t₀ * v₁Map (d_wit i)) * (p_val i / (v₁Map t₀ * v₁Map (d_wit i)))) *
                    (1 / p_val i) := by ring
            _ = p_val i * (1 / p_val i) := by
                  rw [mul_div_cancel₀ _ (mul_ne_zero ht₀_E_ne hd_E_ne)]
            _ = 1 := mul_one_div_cancel hp_ne
        exact ht₀_inv_not (hprod_eq ▸ Vx.toSubring.mul_mem h_in hd_mem)
    have h_inf : ∀ i : Fin M, i ∉ I_bdd →
        ∀ d : ↥V₁, d ≠ 0 → p_val i / v₁Map d ∈ Vx ∧ v₁Map d / p_val i ∉ Vx := by
      intro i hi d hd
      have hnot : v₁Map d / p_val i ∉ Vx := fun h =>
        hi (Finset.mem_filter.mpr ⟨Finset.mem_univ i, d, hd, h⟩)
      have hinv : (v₁Map d / p_val i)⁻¹ ∈ Vx :=
        (Vx.mem_or_inv_mem (v₁Map d / p_val i)).resolve_left hnot
      rw [inv_div] at hinv
      exact ⟨hinv, hnot⟩
    have hClear : ∀ R : Polynomial K,
        ∃ d_R : ↥V₁, d_R ≠ 0 ∧ v₁Map d_R * Polynomial.aeval x₀ R ∈ Vx := by
      intro R
      let S_R := R.support.filter (fun n => R.coeff n ∉ V₁)
      let invCoeff : ℕ → ↥V₁ := fun n =>
        if h : R.coeff n ∉ V₁ then ⟨(R.coeff n)⁻¹, (V₁.mem_or_inv_mem _).resolve_left h⟩ else 1
      let d_R : ↥V₁ := ∏ n ∈ S_R, invCoeff n
      have hdR_ne : d_R ≠ 0 := by
        refine Finset.prod_ne_zero_iff.mpr fun n hn => ?_
        have hnot := (Finset.mem_filter.mp hn).2
        have hc_ne : R.coeff n ≠ 0 := fun h0 => hnot (h0 ▸ V₁.toSubring.zero_mem)
        have hinv_eq : invCoeff n = ⟨(R.coeff n)⁻¹, (V₁.mem_or_inv_mem _).resolve_left hnot⟩ :=
          dif_pos hnot
        rw [hinv_eq]
        exact fun h => inv_ne_zero hc_ne (congrArg Subtype.val h)
      refine ⟨d_R, hdR_ne, ?_⟩
      rw [Polynomial.aeval_def, Polynomial.eval₂_eq_sum, Polynomial.sum_def, Finset.mul_sum]
      refine Vx.toSubring.sum_mem fun m hm_supp => ?_
      have hm_V₁ : d_R.1 * R.coeff m ∈ V₁ := by
        by_cases hm : R.coeff m ∈ V₁
        · exact V₁.toSubring.mul_mem d_R.2 hm
        · have hm_S : m ∈ S_R := Finset.mem_filter.mpr ⟨hm_supp, hm⟩
          have hsplit : d_R = invCoeff m * ∏ n ∈ S_R.erase m, invCoeff n :=
            (Finset.mul_prod_erase S_R invCoeff hm_S).symm
          have hc_ne : R.coeff m ≠ 0 := fun h0 => hm (h0 ▸ V₁.toSubring.zero_mem)
          have hinv_m : (invCoeff m).1 = (R.coeff m)⁻¹ := by
            have heq : invCoeff m = ⟨(R.coeff m)⁻¹, (V₁.mem_or_inv_mem _).resolve_left hm⟩ :=
              dif_pos hm
            exact congrArg Subtype.val heq
          have hval : d_R.1 * R.coeff m = (∏ n ∈ S_R.erase m, invCoeff n).1 := by
            rw [hsplit]
            change (invCoeff m).1 * (∏ n ∈ S_R.erase m, invCoeff n).1 * R.coeff m = _
            rw [hinv_m]
            calc
              (R.coeff m)⁻¹ * (∏ n ∈ S_R.erase m, invCoeff n).1 * R.coeff m
                  = ((R.coeff m)⁻¹ * R.coeff m) * (∏ n ∈ S_R.erase m, invCoeff n).1 := by ring
              _ = (∏ n ∈ S_R.erase m, invCoeff n).1 := by rw [inv_mul_cancel₀ hc_ne, one_mul]
          rw [hval]
          exact (∏ n ∈ S_R.erase m, invCoeff n).2
      have hrew : v₁Map d_R * (algebraMap K E (R.coeff m) * x₀ ^ m) =
          algebraMap K E (d_R.1 * R.coeff m) * x₀ ^ m := by
        change algebraMap K E d_R.1 * (algebraMap K E (R.coeff m) * x₀ ^ m) = _
        rw [map_mul, mul_assoc]
      rw [hrew]
      exact Vx.toSubring.mul_mem hm_V₁ (Vx.toSubring.pow_mem hxVx m)
    have h_inf_subsingleton : ∀ i j : Fin M, i ∉ I_bdd → j ∉ I_bdd → i = j := by
      intro i j hi hj
      by_contra hij
      obtain ⟨A, B, hAB⟩ := hp_coprime i j hij
      obtain ⟨d_A, hdA_ne, hdA_mem⟩ := hClear A
      obtain ⟨d_B, hdB_ne, hdB_mem⟩ := hClear B
      let d_AB : ↥V₁ := d_A * d_B
      have hdAB_ne : d_AB ≠ 0 := mul_ne_zero hdA_ne hdB_ne
      let d' : ↥V₁ := t₀ * d_AB
      have hd'_ne : d' ≠ 0 := mul_ne_zero ht₀_ne hdAB_ne
      let a_t : E := v₁Map d_AB * Polynomial.aeval x₀ A
      let b_t : E := v₁Map d_AB * Polynomial.aeval x₀ B
      have ha_t_mem : a_t ∈ Vx := by
        have heq : a_t = v₁Map d_B * (v₁Map d_A * Polynomial.aeval x₀ A) := by
          simp only [a_t, d_AB, map_mul]; ring
        exact heq ▸ Vx.toSubring.mul_mem d_B.2 hdA_mem
      have hb_t_mem : b_t ∈ Vx := by
        have heq : b_t = v₁Map d_A * (v₁Map d_B * Polynomial.aeval x₀ B) := by
          simp only [b_t, d_AB, map_mul]; ring
        exact heq ▸ Vx.toSubring.mul_mem d_A.2 hdB_mem
      have hsum_dAB : a_t * p_val i + b_t * p_val j = v₁Map d_AB := by
        calc
          a_t * p_val i + b_t * p_val j
              = v₁Map d_AB * (Polynomial.aeval x₀ A * Polynomial.aeval x₀ (P_int i) +
                  Polynomial.aeval x₀ B * Polynomial.aeval x₀ (P_int j)) := by
                simp only [a_t, b_t, ← hp_eval_eq]; ring
          _ = v₁Map d_AB * Polynomial.aeval x₀ (A * P_int i + B * P_int j) := by simp
          _ = v₁Map d_AB := by rw [hAB, map_one, mul_one]
      have hpi_d' : p_val i / v₁Map d' ∈ Vx := (h_inf i hi d' hd'_ne).1
      have hpj_d' : p_val j / v₁Map d' ∈ Vx := (h_inf j hj d' hd'_ne).1
      have hdAB_E_ne : v₁Map d_AB ≠ 0 :=
        (map_ne_zero_iff (algebraMap K E) (RingHom.injective (algebraMap K E))).mpr
          (Subtype.val_injective.ne hdAB_ne)
      have ht₀_inv_eq : a_t * (p_val i / v₁Map d') + b_t * (p_val j / v₁Map d') =
          (v₁Map t₀)⁻¹ := by
        have hd'_E : v₁Map d' = v₁Map t₀ * v₁Map d_AB := map_mul v₁Map t₀ d_AB
        calc
          a_t * (p_val i / v₁Map d') + b_t * (p_val j / v₁Map d')
              = (a_t * p_val i + b_t * p_val j) / v₁Map d' := by ring
          _ = (1 * v₁Map d_AB) / (v₁Map t₀ * v₁Map d_AB) := by rw [one_mul, hsum_dAB, hd'_E]
          _ = 1 / v₁Map t₀ := mul_div_mul_right 1 (v₁Map t₀) hdAB_E_ne
          _ = (v₁Map t₀)⁻¹ := one_div _
      exact ht₀_inv_not (ht₀_inv_eq ▸
        Vx.toSubring.add_mem (Vx.toSubring.mul_mem ha_t_mem hpi_d')
          (Vx.toSubring.mul_mem hb_t_mem hpj_d'))
    have hb_inf_zero : ∀ f ∈ S₁, f ≠ 0 → ∀ i₀ : Fin M, i₀ ∉ I_bdd → b_exp f i₀ = 0 := by
      intro f hfS hf0 i₀ hi₀
      by_contra hb_ne
      have hb_ge1 : 1 ≤ b_exp f i₀ := Nat.one_le_iff_ne_zero.mpr hb_ne
      obtain ⟨hn_ne, _, hup_ne, hup_inv, _, _, hcop_exp, hf_eq⟩ := hf_fac f hfS hf0
      have ha_zero : a_exp f i₀ = 0 := (hcop_exp i₀).resolve_right hb_ne
      let J' : Finset (Fin M) := Finset.univ.erase i₀
      have hJ'_bdd : ∀ j ∈ J', j ∈ I_bdd := by
        intro j hj
        by_contra hj_not
        exact Finset.ne_of_mem_erase hj (h_inf_subsingleton j i₀ hj_not hi₀)
      let D_num : ↥V₁ := n_f f * ∏ j ∈ J', (δ j) ^ (a_exp f j)
      have hD_ne : D_num ≠ 0 :=
        mul_ne_zero hn_ne (Finset.prod_ne_zero_iff.mpr fun j hj =>
          pow_ne_zero _ (hδ_props j (hJ'_bdd j hj)).1)
      have hprod_a : (∏ i : Fin M, (p_val i) ^ (a_exp f i)) =
          ∏ j ∈ J', (p_val j) ^ (a_exp f j) := by
        rw [← Finset.mul_prod_erase Finset.univ (fun i => (p_val i) ^ (a_exp f i))
          (Finset.mem_univ i₀), ha_zero, pow_zero, one_mul]
      have hprod_b : (∏ i : Fin M, (p_val i) ^ (b_exp f i)) =
          p_val i₀ * ((p_val i₀) ^ (b_exp f i₀ - 1) * ∏ j ∈ J', (p_val j) ^ (b_exp f j)) := by
        rw [← Finset.mul_prod_erase Finset.univ (fun i => (p_val i) ^ (b_exp f i))
          (Finset.mem_univ i₀)]
        have hb_split : b_exp f i₀ = 1 + (b_exp f i₀ - 1) := (Nat.add_sub_of_le hb_ge1).symm
        conv_lhs => rw [hb_split, pow_add, pow_one]
        ring
      have hδ_cancel : (∏ j ∈ J', (p_val j) ^ (a_exp f j)) *
          (∏ j ∈ J', (v₁Map (δ j) / p_val j) ^ (a_exp f j)) =
          v₁Map (∏ j ∈ J', (δ j) ^ (a_exp f j)) := by
        rw [← Finset.prod_mul_distrib, map_prod]
        refine Finset.prod_congr rfl fun j _ => ?_
        rw [← mul_pow, mul_div_cancel₀ _ (hp_mem j).2, map_pow]
      let u_pos := Polynomial.eval₂ v₁Map x₀ (U_pos f)
      let u_neg := Polynomial.eval₂ v₁Map x₀ (U_neg f)
      let Q_Vx : E := f * v₁Map (m_f f) * u_neg *
        ((p_val i₀) ^ (b_exp f i₀ - 1) * ∏ j ∈ J', (p_val j) ^ (b_exp f j)) *
        (u_pos⁻¹ * ∏ j ∈ J', (v₁Map (δ j) / p_val j) ^ (a_exp f j))
      have hQ_mem : Q_Vx ∈ Vx := by
        refine Vx.toSubring.mul_mem
          (Vx.toSubring.mul_mem
            (Vx.toSubring.mul_mem
              (Vx.toSubring.mul_mem (hS₁ f hfS) (m_f f).2)
              (heval_mem (U_neg f)))
            (Vx.toSubring.mul_mem
              (Vx.toSubring.pow_mem (hp_mem i₀).1 _)
              (Vx.toSubring.prod_mem fun j _ => Vx.toSubring.pow_mem (hp_mem j).1 _)))
          (Vx.toSubring.mul_mem hup_inv
            (Vx.toSubring.prod_mem fun j hj =>
              Vx.toSubring.pow_mem (hδ_props j (hJ'_bdd j hj)).2.1 _))
      have hD_eq : v₁Map D_num = p_val i₀ * Q_Vx := by
        have hf_eq' : v₁Map (n_f f) * u_pos * (∏ j ∈ J', (p_val j) ^ (a_exp f j)) =
            f * (v₁Map (m_f f) * u_neg *
              (p_val i₀ * ((p_val i₀) ^ (b_exp f i₀ - 1) * ∏ j ∈ J', (p_val j) ^ (b_exp f j)))) := by
          have h := hf_eq.symm
          change v₁Map (n_f f) * u_pos * (∏ i : Fin M, (p_val i) ^ (a_exp f i)) =
            f * (v₁Map (m_f f) * u_neg * ∏ i : Fin M, (p_val i) ^ (b_exp f i)) at h
          rw [hprod_a, hprod_b] at h
          exact h
        calc
          v₁Map D_num = v₁Map (n_f f) * v₁Map (∏ j ∈ J', (δ j) ^ (a_exp f j)) :=
            map_mul v₁Map _ _
          _ = v₁Map (n_f f) * (u_pos * u_pos⁻¹) *
              ((∏ j ∈ J', (p_val j) ^ (a_exp f j)) *
                (∏ j ∈ J', (v₁Map (δ j) / p_val j) ^ (a_exp f j))) := by
            rw [mul_inv_cancel₀ hup_ne, mul_one, hδ_cancel]
          _ = (v₁Map (n_f f) * u_pos * (∏ j ∈ J', (p_val j) ^ (a_exp f j))) *
              (u_pos⁻¹ * ∏ j ∈ J', (v₁Map (δ j) / p_val j) ^ (a_exp f j)) := by ring
          _ = p_val i₀ * Q_Vx := by rw [hf_eq']; simp only [Q_Vx]; ring
      have hdiv_mem : v₁Map D_num / p_val i₀ ∈ Vx := by
        rw [hD_eq, mul_div_cancel_left₀ Q_Vx (hp_mem i₀).2]
        exact hQ_mem
      exact hi₀ (Finset.mem_filter.mpr ⟨Finset.mem_univ i₀, D_num, hD_ne, hdiv_mem⟩)
    let term_f : E → ↥V₁ := fun f => m_f f * ∏ i ∈ I_bdd, (δ i) ^ (b_exp f i)
    let W_Δ : ↥V₁ := (∏ i ∈ I_bdd, δ i) * (∏ f ∈ S₁_nz, term_f f)
    let Δ : ↥V₁ := t₀ * W_Δ
    have hW_ne : W_Δ ≠ 0 := by
      refine mul_ne_zero
        (Finset.prod_ne_zero_iff.mpr fun i hi => (hδ_props i hi).1)
        (Finset.prod_ne_zero_iff.mpr fun f hf => ?_)
      obtain ⟨hfS, hf0⟩ := Finset.mem_filter.mp hf
      exact mul_ne_zero (hf_fac f hfS hf0).2.1
        (Finset.prod_ne_zero_iff.mpr fun i hi => pow_ne_zero _ (hδ_props i hi).1)
    have hΔ_ne : Δ ≠ 0 := mul_ne_zero ht₀_ne hW_ne
    have hΔ_nonunit : (v₁Map Δ)⁻¹ ∉ Vx := by
      intro h_in
      have hW_E_ne : v₁Map W_Δ ≠ 0 :=
        (map_ne_zero_iff (algebraMap K E) (RingHom.injective (algebraMap K E))).mpr
          (Subtype.val_injective.ne hW_ne)
      have ht₀_eq : (v₁Map t₀)⁻¹ = v₁Map W_Δ * (v₁Map Δ)⁻¹ := by
        apply inv_eq_of_mul_eq_one_right
        have hΔ_E : v₁Map Δ = v₁Map t₀ * v₁Map W_Δ := map_mul v₁Map t₀ W_Δ
        calc
          v₁Map t₀ * (v₁Map W_Δ * (v₁Map Δ)⁻¹)
              = v₁Map Δ * (v₁Map Δ)⁻¹ := by rw [hΔ_E, mul_assoc]
          _ = 1 := mul_inv_cancel₀ (hΔ_E ▸ mul_ne_zero ht₀_E_ne hW_E_ne)
      exact ht₀_inv_not (ht₀_eq ▸ Vx.toSubring.mul_mem W_Δ.2 h_in)
    
    let ε : ↥V₁ := Δ ^ (2 * (∏ j : Fin M, p_exp ^ (e j)))
    have hε_ne : ε ≠ 0 := pow_ne_zero _ hΔ_ne
    have hε_val : ε.1 ≠ 0 := Subtype.val_injective.ne hε_ne
    have hex_bs : ∀ i : Fin M,
        ∃ bs : ↥V₁ × ↥V₁,
          p_val i = (x₀ - v₁Map bs.1) ^ (p_exp ^ (e i)) - v₁Map (ε * bs.2) := by
      intro i
      change ∃ bs : ↥V₁ × ↥V₁,
        x₀ ^ (p_exp ^ (e i)) - v₁Map (α i) =
          (x₀ - v₁Map bs.1) ^ (p_exp ^ (e i)) - v₁Map (ε * bs.2)
      cases hExp with
      | zero =>
        exact ⟨(α i, 0), by simp⟩
      | prime hprime =>
        have : ExpChar K p_exp := ExpChar.prime hprime
        have : ExpChar E p_exp :=
          expChar_of_injective_algebraMap (RingHom.injective (algebraMap K E)) p_exp
        cases e i with
        | zero =>
          exact ⟨(α i, 0), by simp⟩
        | succ m =>
          let q := p_exp ^ (m + 1)
          have hq2 : 2 ≤ q := le_trans hprime.two_le (Nat.le_self_pow (Nat.succ_ne_zero m) p_exp)
          have hq_cast : (q : K) = 0 := by
            simp only [q, Nat.cast_pow, CharP.cast_eq_zero, zero_pow (Nat.succ_ne_zero m)]
          let H : Polynomial K :=
            Polynomial.X ^ q + (Polynomial.C ε.1 * Polynomial.X - Polynomial.C (α i).1)
          have hderiv : Polynomial.derivative H = Polynomial.C ε.1 := by
            simp only [H, Polynomial.derivative_add, Polynomial.derivative_sub,
              Polynomial.derivative_X_pow, Polynomial.derivative_C_mul, Polynomial.derivative_X,
              Polynomial.derivative_C, hq_cast, map_zero, zero_mul,
              zero_add, mul_one, sub_zero]
          have hSep : H.Separable := by
            show IsCoprime H (Polynomial.derivative H)
            refine ⟨0, Polynomial.C (ε.1)⁻¹, ?_⟩
            rw [hderiv, zero_mul, zero_add, ← map_mul, inv_mul_cancel₀ hε_val, map_one]
          have hDeg_ne : H.degree ≠ 0 := by
            have hlt_deg : (Polynomial.C ε.1 * Polynomial.X - Polynomial.C (α i).1).natDegree <
                (Polynomial.X ^ q : Polynomial K).natDegree := by
              have hle1 : (Polynomial.C ε.1 * Polynomial.X - Polynomial.C (α i).1).natDegree ≤ 1 := by
                refine le_trans (Polynomial.natDegree_sub_le _ _) ?_
                rw [Polynomial.natDegree_C_mul_X _ hε_val, Polynomial.natDegree_C]
                omega
              rw [Polynomial.natDegree_X_pow]
              omega
            have hnat : H.natDegree = q :=
              (Polynomial.natDegree_add_eq_left_of_natDegree_lt hlt_deg).trans
                (Polynomial.natDegree_X_pow q)
            have hH_ne : H ≠ 0 := fun h0 => by rw [h0, Polynomial.natDegree_zero] at hnat; omega
            rw [Polynomial.degree_eq_natDegree hH_ne, hnat]
            exact Nat.cast_ne_zero.mpr (by omega)
          obtain ⟨b, hb_aeval⟩ := IsSepClosed.exists_aeval_eq_zero K H hDeg_ne hSep
          have hb_eq : b ^ q + ε.1 * b = (α i).1 := by
            have h0 : b ^ q + (ε.1 * b - (α i).1) = 0 := by simpa [H] using hb_aeval
            linear_combination h0
          have hb_V₁ : b ∈ V₁ := by
            by_contra hb_not
            have hb_ne : b ≠ 0 := fun h0 => hb_not (h0 ▸ V₁.toSubring.zero_mem)
            have hb_inv : b⁻¹ ∈ V₁ := (V₁.mem_or_inv_mem b).resolve_left hb_not
            let r := q - 2
            have hq_r : q = r + 2 := (Nat.sub_add_cancel hq2).symm
            have hcomb_mem : (α i).1 * (b⁻¹) ^ (r + 1) - ε.1 * (b⁻¹) ^ r ∈ V₁ :=
              V₁.toSubring.sub_mem
                (V₁.toSubring.mul_mem (α i).2 (V₁.toSubring.pow_mem hb_inv _))
                (V₁.toSubring.mul_mem ε.2 (V₁.toSubring.pow_mem hb_inv _))
            have hcomb_eq : (α i).1 * (b⁻¹) ^ (r + 1) - ε.1 * (b⁻¹) ^ r = b := by
              have h1 : b ^ (r + 2) * (b⁻¹) ^ (r + 1) = b := by
                calc
                  b ^ (r + 2) * (b⁻¹) ^ (r + 1)
                      = b * (b ^ (r + 1) * (b⁻¹) ^ (r + 1)) := by rw [pow_succ']; ring
                  _ = b * (b * b⁻¹) ^ (r + 1) := by rw [← mul_pow]
                  _ = b := by rw [mul_inv_cancel₀ hb_ne, one_pow, mul_one]
              have h2 : (ε.1 * b) * (b⁻¹) ^ (r + 1) = ε.1 * (b⁻¹) ^ r := by
                calc
                  (ε.1 * b) * (b⁻¹) ^ (r + 1)
                      = ε.1 * (b * b⁻¹) * (b⁻¹) ^ r := by rw [pow_succ']; ring
                  _ = ε.1 * (b⁻¹) ^ r := by rw [mul_inv_cancel₀ hb_ne, mul_one]
              rw [← hb_eq, hq_r, add_mul, h1, h2, add_sub_cancel_right]
            exact hb_not (hcomb_eq ▸ hcomb_mem)
          let β_i : ↥V₁ := ⟨b, hb_V₁⟩
          refine ⟨(β_i, β_i), ?_⟩
          change x₀ ^ q - v₁Map (α i) = (x₀ - v₁Map β_i) ^ q - v₁Map (ε * β_i)
          have hchar_pow : (x₀ - v₁Map β_i) ^ q = x₀ ^ q - (v₁Map β_i) ^ q :=
            sub_pow_expChar_pow x₀ (v₁Map β_i) (m + 1)
          have hscalar : (v₁Map β_i) ^ q + v₁Map (ε * β_i) = v₁Map (α i) := by
            change (algebraMap K E b) ^ q + algebraMap K E (ε.1 * b) = algebraMap K E (α i).1
            rw [← map_pow, ← map_add, hb_eq]
          rw [hchar_pow, sub_sub, hscalar]
    let β : Fin M → ↥V₁ := fun i => (Classical.choose (hex_bs i)).1
    let s_err : Fin M → ↥V₁ := fun i => (Classical.choose (hex_bs i)).2
    have hp_eq : ∀ i : Fin M,
        p_val i = (x₀ - v₁Map (β i)) ^ (p_exp ^ (e i)) - v₁Map (ε * s_err i) :=
      fun i => Classical.choose_spec (hex_bs i)
    let d_x : Fin M → E := fun i => x₀ - v₁Map (β i)
    have hdx_ne : ∀ i : Fin M, d_x i ≠ 0 := by
      intro i h0
      have hpoly_ne : (Polynomial.X - Polynomial.C (β i).1 : Polynomial K) ≠ 0 := by
        intro hp0
        have hc1 := congrArg (fun Q : Polynomial K => Q.coeff 1) hp0
        simp at hc1
      have hev0 : Polynomial.aeval x₀ (Polynomial.X - Polynomial.C (β i).1) = 0 := by
        simpa [d_x, v₁Map] using h0
      exact hx₀_tr ⟨Polynomial.X - Polynomial.C (β i).1, hpoly_ne, hev0⟩
    have hmax_finset : ∀ (s : Finset (Fin M)), s.Nonempty →
        ∃ k ∈ s, ∀ j ∈ s, d_x k / d_x j ∈ Vx := by
      intro s hs
      induction hs using Finset.Nonempty.cons_induction with
      | singleton a =>
        refine ⟨a, Finset.mem_singleton_self a, fun j hj => ?_⟩
        rw [Finset.mem_singleton.mp hj, div_self (hdx_ne a)]
        exact Vx.toSubring.one_mem
      | cons a s ha _ ih =>
        obtain ⟨k₁, hk₁_mem, hk₁_max⟩ := ih
        rcases Vx.mem_or_inv_mem (d_x a / d_x k₁) with h_ak | h_ka
        · refine ⟨a, Finset.mem_cons_self a s, fun j hj => ?_⟩
          rcases Finset.mem_cons.mp hj with hj_eq | hj_s
          · rw [hj_eq, div_self (hdx_ne a)]
            exact Vx.toSubring.one_mem
          · have hmul : (d_x a / d_x k₁) * (d_x k₁ / d_x j) = d_x a / d_x j :=
              div_mul_div_cancel₀ (hdx_ne k₁)
            exact hmul ▸ Vx.toSubring.mul_mem h_ak (hk₁_max j hj_s)
        · rw [inv_div] at h_ka
          refine ⟨k₁, Finset.mem_cons.mpr (Or.inr hk₁_mem), fun j hj => ?_⟩
          rcases Finset.mem_cons.mp hj with hj_eq | hj_s
          · rw [hj_eq]
            exact h_ka
          · exact hk₁_max j hj_s
    have huniv_ne : (Finset.univ : Finset (Fin M)).Nonempty :=
      ⟨⟨0, by omega⟩, Finset.mem_univ _⟩
    obtain ⟨k₀, _, hk₀_max⟩ := hmax_finset Finset.univ huniv_ne
    
    exact ⟨{
      p_exp := p_exp
      M := M
      hExpChar := hExp
      hp_pos := hp_pos
      hM := hM
      e := e
      p_val := p_val
      β := β
      s_err := s_err
      δ := δ
      Δ := Δ
      I_bdd := I_bdd
      n_f := n_f
      m_f := m_f
      U_pos := U_pos
      U_neg := U_neg
      a_exp := a_exp
      b_exp := b_exp
      k₀ := k₀
      hp_mem := hp_mem
      hΔ_ne := hΔ_ne
      hΔ_nonunit := hΔ_nonunit
      hp_eq := hp_eq
      hδ_bdd := fun i hi =>
        ⟨(hδ_props i hi).1, (hδ_props i hi).2.1, (hδ_props i hi).2.2,
          dvd_mul_of_dvd_right (dvd_mul_of_dvd_left (Finset.dvd_prod_of_mem δ hi) _) t₀⟩
      h_inf := h_inf
      h_inf_subsingleton := h_inf_subsingleton
      hf_rep := fun f hfS hf0 => by
        obtain ⟨h1, h2, h3, h4, h5, h6, h7, h8⟩ := hf_fac f hfS hf0
        have hf_nz : f ∈ S₁_nz := Finset.mem_filter.mpr ⟨hfS, hf0⟩
        exact ⟨h1, h2, h3, h4, h5, h6, h7, hb_inf_zero f hfS hf0,
          dvd_mul_of_dvd_right (dvd_mul_of_dvd_right (Finset.dvd_prod_of_mem term_f hf_nz) _) t₀,
          h8⟩
      hk₀_max := fun i => hk₀_max i (Finset.mem_univ i)
    }⟩

theorem weil_perturbed_factorization_smooth_disk_chart (K : Type u) [Field K]
    (E : Type u) [Field E] [Algebra K E]
    (x₀ : E) (hx₀_tr : Transcendental K x₀)
    (Vx : ValuationSubring E) (hx₀_Vx : x₀ ∈ Vx)
    (S₁ : Finset E) (hS₁ : ∀ z ∈ S₁, z ∈ Vx)
    (D : PerturbedRationalFactorization K E x₀ Vx S₁)
    (hDisk : (∃ i : Fin D.M, i ∉ D.I_bdd) ∨
      ((∀ i : Fin D.M, i ∈ D.I_bdd) ∧
        ∃ π₀ : ↥(Vx.comap (algebraMap K E)), π₀ ≠ 0 ∧
          (x₀ - ((algebraMap K E).comp (Vx.comap (algebraMap K E)).subtype) (D.β D.k₀)) /
            ((algebraMap K E).comp (Vx.comap (algebraMap K E)).subtype) π₀ ∈ Vx ∧
          ((algebraMap K E).comp (Vx.comap (algebraMap K E)).subtype) π₀ /
            (x₀ - ((algebraMap K E).comp (Vx.comap (algebraMap K E)).subtype) (D.β D.k₀)) ∈ Vx)) :
    HasOverringSemistableChartWitness (Vx.comap (algebraMap K E)) Vx S₁ :=
by
  classical
  let _ := hx₀_Vx
  let V₁ : ValuationSubring K := Vx.comap (algebraMap K E)
  let v₁Map : ↥V₁ →+* E := (algebraMap K E).comp V₁.subtype
  have hv₁_inj : Function.Injective v₁Map :=
    (RingHom.injective (algebraMap K E)).comp Subtype.val_injective
  have hv₁_mem : ∀ a : ↥V₁, v₁Map a ∈ Vx := fun a => a.2
  have hv₁_ne : ∀ {a : ↥V₁}, a ≠ 0 → v₁Map a ≠ 0 :=
    fun ha h0 => ha (hv₁_inj (h0.trans v₁Map.map_zero.symm))
  have hcoe_ne : ∀ {a : ↥V₁}, a ≠ 0 → a.1 ≠ 0 :=
    fun ha h0 => ha (Subtype.ext h0)
  have h_div_mem : ∀ (a b : ↥V₁), v₁Map a / v₁Map b ∈ Vx → a.1 / b.1 ∈ V₁ := by
    intro a b h
    change algebraMap K E (a.1 / b.1) ∈ Vx
    rwa [map_div₀]
  have h_quo_mul : ∀ (a b : ↥V₁) (hb : b ≠ 0) (hm : a.1 / b.1 ∈ V₁),
      b * (⟨a.1 / b.1, hm⟩ : ↥V₁) = a := by
    intro a b hb hm
    exact Subtype.ext (mul_div_cancel₀ a.1 (hcoe_ne hb))
  have h_dvd_of_div_Vx : ∀ (a b : ↥V₁), b ≠ 0 → v₁Map a / v₁Map b ∈ Vx → b ∣ a := by
    intro a b hb h
    exact ⟨⟨a.1 / b.1, h_div_mem a b h⟩, (h_quo_mul a b hb (h_div_mem a b h)).symm⟩
  
  have h_one_add_unit : ∀ (η : E), η ∈ Vx → (η = 0 ∨ η⁻¹ ∉ Vx) →
      1 + η ≠ 0 ∧ (1 + η)⁻¹ ∈ Vx := by
    intro η _ hnu
    by_cases hη0 : η = 0
    · subst hη0
      simp [one_mem Vx]
    · have hη_inv : η⁻¹ ∉ Vx := hnu.resolve_left hη0
      have h1η_ne : 1 + η ≠ 0 := by
        intro h0
        have h_eq : η = -1 := by linear_combination h0
        rw [h_eq, inv_neg, inv_one] at hη_inv
        exact hη_inv (neg_mem (one_mem Vx))
      have h_not_mem : (1 + η) / η ∉ Vx := by
        intro hm
        have h_eq : η⁻¹ = (1 + η) / η - 1 := by
          field_simp [hη0]
          ring
        rw [h_eq] at hη_inv
        exact hη_inv (sub_mem hm (one_mem Vx))
      have h_inv_mem : η / (1 + η) ∈ Vx := by
        rcases ValuationSubring.mem_or_inv_mem Vx ((1 + η) / η) with hm | hinv
        · exact absurd hm h_not_mem
        · rwa [inv_div] at hinv
      refine ⟨h1η_ne, ?_⟩
      have h_inv_eq : (1 + η)⁻¹ = 1 - η / (1 + η) := by
        field_simp [h1η_ne]
        ring
      rw [h_inv_eq]
      exact sub_mem (one_mem Vx) h_inv_mem
  have h_nonunit_mul : ∀ (z v : E), z ∈ Vx → z⁻¹ ∉ Vx → v ∈ Vx →
      z * v ∈ Vx ∧ (z * v = 0 ∨ (z * v)⁻¹ ∉ Vx) := by
    intro z v hz hz_inv hv
    refine ⟨mul_mem hz hv, ?_⟩
    by_cases hzv : z * v = 0
    · exact Or.inl hzv
    · right
      intro h_inv
      have hz_ne : z ≠ 0 := left_ne_zero_of_mul hzv
      have hv_ne : v ≠ 0 := right_ne_zero_of_mul hzv
      have hz_eq : z⁻¹ = v * (z * v)⁻¹ := by
        field_simp [hz_ne, hv_ne]
      rw [hz_eq] at hz_inv
      exact hz_inv (mul_mem hv h_inv)
  have h_pow_mem_Vx : ∀ (z : E) (d : ℕ), 1 ≤ d → z ^ d ∈ Vx → z ∈ Vx := by
    intro z d hd hzd
    by_contra hz
    have hz_ne : z ≠ 0 := fun h0 => hz (h0 ▸ zero_mem Vx)
    have hz_inv : z⁻¹ ∈ Vx := (ValuationSubring.mem_or_inv_mem Vx z).resolve_left hz
    have h_eq : z = z ^ d * (z⁻¹) ^ (d - 1) := by
      calc
        z = 1 ^ (d - 1) * z := by rw [one_pow, one_mul]
        _ = (z * z⁻¹) ^ (d - 1) * z := by rw [mul_inv_cancel₀ hz_ne]
        _ = (z ^ (d - 1) * z) * (z⁻¹) ^ (d - 1) := by rw [mul_pow, mul_right_comm]
        _ = z ^ (d - 1 + 1) * (z⁻¹) ^ (d - 1) := by rw [← pow_succ]
        _ = z ^ d * (z⁻¹) ^ (d - 1) := by rw [Nat.sub_add_cancel hd]
    rw [h_eq] at hz
    exact hz (mul_mem hzd (pow_mem hz_inv (d - 1)))
  
  let q : Fin D.M → ℕ := fun i => D.p_exp ^ (D.e i)
  have hq_pos : ∀ i : Fin D.M, 1 ≤ q i := fun i => Nat.one_le_pow (D.e i) D.p_exp D.hp_pos
  have hq_ne : ∀ i : Fin D.M, q i ≠ 0 := fun i => Nat.one_le_iff_ne_zero.mp (hq_pos i)
  let Q_max : ℕ := ∏ j : Fin D.M, q j
  have hQ_pos : 1 ≤ Q_max := Finset.one_le_prod (fun j _ => hq_pos j)
  let ε : ↥V₁ := D.Δ ^ (2 * Q_max)
  let θ : ↥V₁ → Fin D.M → ↥V₁ := fun c j => (c - D.β j) ^ (q j) - ε * D.s_err j
  have : ExpChar K D.p_exp := D.hExpChar
  have : ExpChar E D.p_exp :=
    expChar_of_injective_algebraMap (RingHom.injective (algebraMap K E)) D.p_exp
  have hp_recenter : ∀ (c : ↥V₁) (j : Fin D.M),
      D.p_val j = (x₀ - v₁Map c) ^ (q j) + v₁Map (θ c j) := by
    intro c j
    have h_split : x₀ - v₁Map (D.β j) = (x₀ - v₁Map c) + v₁Map (c - D.β j) := by
      rw [map_sub]
      ring
    have h_pow : (x₀ - v₁Map (D.β j)) ^ (q j) =
        (x₀ - v₁Map c) ^ (q j) + (v₁Map (c - D.β j)) ^ (q j) := by
      rw [h_split]
      exact add_pow_expChar_pow (x₀ - v₁Map c) (v₁Map (c - D.β j)) D.p_exp (D.e j)
    calc
      D.p_val j = (x₀ - v₁Map (D.β j)) ^ (q j) - v₁Map (ε * D.s_err j) := D.hp_eq j
      _ = (x₀ - v₁Map c) ^ (q j) + ((v₁Map (c - D.β j)) ^ (q j) - v₁Map (ε * D.s_err j)) := by
          rw [h_pow]
          ring
      _ = (x₀ - v₁Map c) ^ (q j) + v₁Map (θ c j) := by
          rw [← map_pow, ← map_sub]
  
  have h_assembly : ∀ (c d₀ : ↥V₁) (σ : Fin D.M → ↥V₁) (W : Fin D.M → Polynomial ↥V₁),
      d₀ ≠ 0 →
      (x₀ - v₁Map c) / v₁Map d₀ ∈ Vx →
      (∀ i : Fin D.M, σ i ≠ 0) →
      (∀ i : Fin D.M,
        D.p_val i = v₁Map (σ i) * Polynomial.eval₂ v₁Map ((x₀ - v₁Map c) / v₁Map d₀) (W i)) →
      (∀ i ∈ D.I_bdd,
        Polynomial.eval₂ v₁Map ((x₀ - v₁Map c) / v₁Map d₀) (W i) ≠ 0 ∧
        (Polynomial.eval₂ v₁Map ((x₀ - v₁Map c) / v₁Map d₀) (W i))⁻¹ ∈ Vx) →
      (∀ i : Fin D.M, i ∉ D.I_bdd → D.Δ ∣ σ i ∧ ∀ j ∈ D.I_bdd, σ j ∣ D.δ j) →
      HasOverringSemistableChartWitness V₁ Vx S₁ := by
    intro c d₀ σ W hd₀_ne hu_mem hσ_ne hp_fac hW_unit h_unb_dvd
    let u : E := (x₀ - v₁Map c) / v₁Map d₀
    have hd₀_coe_ne : d₀.1 ≠ 0 := hcoe_ne hd₀_ne
    have hv₁_d₀_ne : v₁Map d₀ ≠ 0 := hv₁_ne hd₀_ne
    
    have hu_tr : Transcendental K u := by
      intro ⟨p, hp_ne, hp_eval⟩
      let L_poly : Polynomial K :=
        Polynomial.C (d₀.1)⁻¹ * Polynomial.X - Polynomial.C (c.1 * (d₀.1)⁻¹)
      let L_inv : Polynomial K :=
        Polynomial.C d₀.1 * Polynomial.X + Polynomial.C c.1
      have hL_eval : Polynomial.aeval x₀ L_poly = u := by
        simp only [L_poly, map_sub, map_mul, Polynomial.aeval_C, Polynomial.aeval_X, map_inv₀]
        change (v₁Map d₀)⁻¹ * x₀ - v₁Map c * (v₁Map d₀)⁻¹ = (x₀ - v₁Map c) / v₁Map d₀
        rw [div_eq_mul_inv]
        ring
      have hL_comp : L_poly.comp L_inv = Polynomial.X := by
        simp only [L_poly, L_inv, Polynomial.sub_comp, Polynomial.mul_comp,
          Polynomial.C_comp, Polynomial.X_comp]
        rw [mul_add, ← mul_assoc, ← Polynomial.C_mul, ← Polynomial.C_mul,
          inv_mul_cancel₀ hd₀_coe_ne, map_one, one_mul, mul_comm (d₀.1)⁻¹ c.1,
          add_sub_cancel_right]
      have hq_eval : Polynomial.aeval x₀ (p.comp L_poly) = 0 := by
        rw [Polynomial.aeval_comp, hL_eval, hp_eval]
      have hq_ne : p.comp L_poly ≠ 0 := by
        intro h0
        apply hp_ne
        calc
          p = p.comp Polynomial.X := Polynomial.comp_X.symm
          _ = p.comp (L_poly.comp L_inv) := by rw [hL_comp]
          _ = (p.comp L_poly).comp L_inv := (Polynomial.comp_assoc p L_poly L_inv).symm
          _ = (0 : Polynomial K).comp L_inv := by rw [h0]
          _ = 0 := Polynomial.zero_comp
      exact hx₀_tr ⟨p.comp L_poly, hq_ne, hq_eval⟩
    
    have heval_Vx : ∀ P : Polynomial ↥V₁, Polynomial.eval₂ v₁Map u P ∈ Vx := by
      intro P
      refine Polynomial.induction_on P (fun a => ?_) (fun p₁ p₂ hp₁ hp₂ => ?_) (fun n a _ => ?_)
      · rw [Polynomial.eval₂_C]
        exact hv₁_mem a
      · rw [Polynomial.eval₂_add]
        exact add_mem hp₁ hp₂
      · rw [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X_pow]
        exact mul_mem (hv₁_mem a) (pow_mem hu_mem (n + 1))
    let X_poly : Polynomial ↥V₁ := Polynomial.C d₀ * Polynomial.X + Polynomial.C c
    have hX_eval : Polynomial.eval₂ v₁Map u X_poly = x₀ := by
      simp only [X_poly, Polynomial.eval₂_add, Polynomial.eval₂_mul,
        Polynomial.eval₂_C, Polynomial.eval₂_X]
      change v₁Map d₀ * ((x₀ - v₁Map c) / v₁Map d₀) + v₁Map c = x₀
      rw [mul_div_cancel₀ _ hv₁_d₀_ne, sub_add_cancel]
    
    let Q_f : E → Polynomial ↥V₁ :=
      fun f => (D.U_neg f).comp X_poly * ∏ i : Fin D.M, (W i) ^ (D.b_exp f i)
    let P_f : E → Polynomial ↥V₁ :=
      fun f => (D.U_pos f).comp X_poly * ∏ i : Fin D.M, (W i) ^ (D.a_exp f i)
    let den_s : E → ↥V₁ := fun f => D.m_f f * ∏ i : Fin D.M, (σ i) ^ (D.b_exp f i)
    let num_s : E → ↥V₁ := fun f => D.n_f f * ∏ i : Fin D.M, (σ i) ^ (D.a_exp f i)
    have h_prod_fac : ∀ (ex : Fin D.M → ℕ),
        (∏ i : Fin D.M, (D.p_val i) ^ (ex i)) =
          v₁Map (∏ i : Fin D.M, (σ i) ^ (ex i)) *
            Polynomial.eval₂ v₁Map u (∏ i : Fin D.M, (W i) ^ (ex i)) := by
      intro ex
      rw [map_prod, Polynomial.eval₂_finsetProd, ← Finset.prod_mul_distrib]
      refine Finset.prod_congr rfl (fun i _ => ?_)
      rw [hp_fac i, mul_pow, map_pow, Polynomial.eval₂_pow]
    have h_Wpow_unit : ∀ (ex : Fin D.M → ℕ),
        (∀ i : Fin D.M, i ∉ D.I_bdd → ex i = 0) →
        Polynomial.eval₂ v₁Map u (∏ i : Fin D.M, (W i) ^ (ex i)) ≠ 0 ∧
        (Polynomial.eval₂ v₁Map u (∏ i : Fin D.M, (W i) ^ (ex i)))⁻¹ ∈ Vx := by
      intro ex hex_unb
      rw [Polynomial.eval₂_finsetProd]
      have h_each : ∀ i ∈ (Finset.univ : Finset (Fin D.M)),
          Polynomial.eval₂ v₁Map u ((W i) ^ (ex i)) ≠ 0 ∧
          (Polynomial.eval₂ v₁Map u ((W i) ^ (ex i)))⁻¹ ∈ Vx := by
        intro i _
        rw [Polynomial.eval₂_pow]
        by_cases hi : i ∈ D.I_bdd
        · obtain ⟨hWi_ne, hWi_inv⟩ := hW_unit i hi
          refine ⟨pow_ne_zero (ex i) hWi_ne, ?_⟩
          rw [← inv_pow]
          exact pow_mem hWi_inv (ex i)
        · rw [hex_unb i hi, pow_zero, inv_one]
          exact ⟨one_ne_zero, one_mem Vx⟩
      refine ⟨Finset.prod_ne_zero_iff.mpr (fun i hi => (h_each i hi).1), ?_⟩
      rw [← Finset.prod_inv_distrib]
      exact prod_mem (fun i hi => (h_each i hi).2)
    have hf_clear : ∀ f ∈ S₁, f ≠ 0 →
        (Polynomial.eval₂ v₁Map u (Q_f f) ≠ 0 ∧ (Polynomial.eval₂ v₁Map u (Q_f f))⁻¹ ∈ Vx) ∧
        ∃ R_num : Polynomial ↥V₁,
          f * Polynomial.eval₂ v₁Map u (Q_f f) = Polynomial.eval₂ v₁Map u R_num := by
      intro f hf_S₁ hf_ne
      obtain ⟨_, hm_ne, hUpos_ne, hUpos_inv, hUneg_ne, hUneg_inv,
        _, hb_unb, hm_dvd_Δ, hf_eq⟩ := D.hf_rep f hf_S₁ hf_ne
      have hQ_eval : Polynomial.eval₂ v₁Map u (Q_f f) =
          Polynomial.eval₂ v₁Map x₀ (D.U_neg f) *
            Polynomial.eval₂ v₁Map u (∏ i : Fin D.M, (W i) ^ (D.b_exp f i)) := by
        simp only [Q_f, Polynomial.eval₂_mul, Polynomial.eval₂_comp, hX_eval]
      have hP_eval : Polynomial.eval₂ v₁Map u (P_f f) =
          Polynomial.eval₂ v₁Map x₀ (D.U_pos f) *
            Polynomial.eval₂ v₁Map u (∏ i : Fin D.M, (W i) ^ (D.a_exp f i)) := by
        simp only [P_f, Polynomial.eval₂_mul, Polynomial.eval₂_comp, hX_eval]
      obtain ⟨hWb_ne, hWb_inv⟩ := h_Wpow_unit (D.b_exp f) hb_unb
      have hQf_ne : Polynomial.eval₂ v₁Map u (Q_f f) ≠ 0 := by
        rw [hQ_eval]
        exact mul_ne_zero hUneg_ne hWb_ne
      have hQf_inv : (Polynomial.eval₂ v₁Map u (Q_f f))⁻¹ ∈ Vx := by
        rw [hQ_eval, mul_inv_rev]
        exact mul_mem hWb_inv hUneg_inv
      have h_rel : f * (v₁Map (den_s f) * Polynomial.eval₂ v₁Map u (Q_f f)) =
          v₁Map (num_s f) * Polynomial.eval₂ v₁Map u (P_f f) := by
        have h1 := hf_eq
        rw [h_prod_fac (D.b_exp f), h_prod_fac (D.a_exp f)] at h1
        simp only [den_s, num_s, map_mul, hQ_eval, hP_eval]
        change f * (v₁Map (D.m_f f) * Polynomial.eval₂ v₁Map x₀ (D.U_neg f) *
            (v₁Map (∏ i, σ i ^ D.b_exp f i) * Polynomial.eval₂ v₁Map u (∏ i, W i ^ D.b_exp f i))) =
          v₁Map (D.n_f f) * Polynomial.eval₂ v₁Map x₀ (D.U_pos f) *
            (v₁Map (∏ i, σ i ^ D.a_exp f i) * Polynomial.eval₂ v₁Map u (∏ i, W i ^ D.a_exp f i)) at h1
        linear_combination h1
      have hden_ne : den_s f ≠ 0 :=
        mul_ne_zero hm_ne (Finset.prod_ne_zero_iff.mpr (fun i _ => pow_ne_zero _ (hσ_ne i)))
      have hden_coe_ne : (den_s f).1 ≠ 0 := hcoe_ne hden_ne
      have hv₁_den_ne : v₁Map (den_s f) ≠ 0 := hv₁_ne hden_ne
      have h_scalar_mem : (num_s f).1 / (den_s f).1 ∈ V₁ := by
        by_cases h_unb_a : ∃ i_inf : Fin D.M, i_inf ∉ D.I_bdd ∧ D.a_exp f i_inf ≠ 0
        · obtain ⟨i_inf, hi_inf, ha_ne⟩ := h_unb_a
          obtain ⟨hΔ_dvd_σ, hσ_dvd_δ⟩ := h_unb_dvd i_inf hi_inf
          have h_prod_eq : (∏ i : Fin D.M, (σ i) ^ (D.b_exp f i)) =
              ∏ i ∈ D.I_bdd, (σ i) ^ (D.b_exp f i) := by
            refine (Finset.prod_subset (Finset.subset_univ D.I_bdd) ?_).symm
            intro i _ hi_not
            rw [hb_unb i hi_not, pow_zero]
          have h_prod_dvd : (∏ i ∈ D.I_bdd, (σ i) ^ (D.b_exp f i)) ∣
              ∏ i ∈ D.I_bdd, (D.δ i) ^ (D.b_exp f i) :=
            Finset.prod_dvd_prod_of_dvd _ _
              (fun j hj => pow_dvd_pow_of_dvd (hσ_dvd_δ j hj) (D.b_exp f j))
          have h_den_dvd_Δ : den_s f ∣ D.Δ := by
            refine dvd_trans ?_ hm_dvd_Δ
            change D.m_f f * (∏ i : Fin D.M, (σ i) ^ (D.b_exp f i)) ∣ _
            rw [h_prod_eq]
            exact mul_dvd_mul_left (D.m_f f) h_prod_dvd
          have h_Δ_dvd_num : D.Δ ∣ num_s f := by
            have h1 : D.Δ ∣ (σ i_inf) ^ (D.a_exp f i_inf) :=
              dvd_trans hΔ_dvd_σ (dvd_pow_self (σ i_inf) ha_ne)
            have h2 : (σ i_inf) ^ (D.a_exp f i_inf) ∣ ∏ i : Fin D.M, (σ i) ^ (D.a_exp f i) :=
              Finset.dvd_prod_of_mem _ (Finset.mem_univ i_inf)
            exact dvd_trans (dvd_trans h1 h2) (dvd_mul_left _ (D.n_f f))
          obtain ⟨c₀, hc₀⟩ := dvd_trans h_den_dvd_Δ h_Δ_dvd_num
          have hc₀_coe : (num_s f).1 = (den_s f).1 * c₀.1 := congrArg Subtype.val hc₀
          rw [hc₀_coe, mul_div_cancel_left₀ c₀.1 hden_coe_ne]
          exact c₀.2
        · have ha_unb : ∀ i : Fin D.M, i ∉ D.I_bdd → D.a_exp f i = 0 := by
            intro i hi
            by_contra ha_ne
            exact h_unb_a ⟨i, hi, ha_ne⟩
          obtain ⟨hWa_ne, hWa_inv⟩ := h_Wpow_unit (D.a_exp f) ha_unb
          have hPf_ne : Polynomial.eval₂ v₁Map u (P_f f) ≠ 0 := by
            rw [hP_eval]
            exact mul_ne_zero hUpos_ne hWa_ne
          have hPf_inv : (Polynomial.eval₂ v₁Map u (P_f f))⁻¹ ∈ Vx := by
            rw [hP_eval, mul_inv_rev]
            exact mul_mem hWa_inv hUpos_inv
          apply h_div_mem
          have h_eq_Vx : v₁Map (num_s f) / v₁Map (den_s f) =
              f * Polynomial.eval₂ v₁Map u (Q_f f) * (Polynomial.eval₂ v₁Map u (P_f f))⁻¹ := by
            field_simp [hv₁_den_ne, hPf_ne]
            linear_combination -h_rel
          rw [h_eq_Vx]
          exact mul_mem (mul_mem (hS₁ f hf_S₁) (heval_Vx (Q_f f))) hPf_inv
      let c_lam : ↥V₁ := ⟨(num_s f).1 / (den_s f).1, h_scalar_mem⟩
      have hc_lam_mul : den_s f * c_lam = num_s f :=
        h_quo_mul (num_s f) (den_s f) hden_ne h_scalar_mem
      refine ⟨⟨hQf_ne, hQf_inv⟩, Polynomial.C c_lam * P_f f, ?_⟩
      apply mul_left_cancel₀ hv₁_den_ne
      calc
        v₁Map (den_s f) * (f * Polynomial.eval₂ v₁Map u (Q_f f))
            = f * (v₁Map (den_s f) * Polynomial.eval₂ v₁Map u (Q_f f)) := by ring
        _ = v₁Map (num_s f) * Polynomial.eval₂ v₁Map u (P_f f) := h_rel
        _ = v₁Map (den_s f * c_lam) * Polynomial.eval₂ v₁Map u (P_f f) := by rw [← hc_lam_mul]
        _ = v₁Map (den_s f) * (v₁Map c_lam * Polynomial.eval₂ v₁Map u (P_f f)) := by
            rw [map_mul]; ring
        _ = v₁Map (den_s f) * Polynomial.eval₂ v₁Map u (Polynomial.C c_lam * P_f f) := by
            simp only [Polynomial.eval₂_mul, Polynomial.eval₂_C]
    
    let S_nz : Finset E := S₁.filter (fun f => f ≠ 0)
    let g₁ : Polynomial ↥V₁ := ∏ f ∈ S_nz, Q_f f
    have hg₁_eval : Polynomial.eval₂ v₁Map u g₁ = ∏ f ∈ S_nz, Polynomial.eval₂ v₁Map u (Q_f f) :=
      Polynomial.eval₂_finsetProd v₁Map S_nz Q_f u
    have hg₁_ne : Polynomial.eval₂ v₁Map u g₁ ≠ 0 := by
      rw [hg₁_eval]
      refine Finset.prod_ne_zero_iff.mpr (fun f hf => ?_)
      obtain ⟨hf_S₁, hf_ne⟩ := Finset.mem_filter.mp hf
      exact (hf_clear f hf_S₁ hf_ne).1.1
    have hg₁_inv : (Polynomial.eval₂ v₁Map u g₁)⁻¹ ∈ Vx := by
      rw [hg₁_eval, ← Finset.prod_inv_distrib]
      refine prod_mem (fun f hf => ?_)
      obtain ⟨hf_S₁, hf_ne⟩ := Finset.mem_filter.mp hf
      exact (hf_clear f hf_S₁ hf_ne).1.2
    refine Or.inl ⟨u, g₁, hu_mem, hu_tr, hg₁_ne, hg₁_inv, ?_⟩
    intro z hz_S₁
    by_cases hz0 : z = 0
    · refine ⟨0, 0, ?_⟩
      simp [hz0]
    · have hz_Snz : z ∈ S_nz := Finset.mem_filter.mpr ⟨hz_S₁, hz0⟩
      obtain ⟨_, R_num, hR_num⟩ := hf_clear z hz_S₁ hz0
      have hg₁_split : g₁ = Q_f z * ∏ h ∈ S_nz.erase z, Q_f h :=
        (Finset.mul_prod_erase S_nz Q_f hz_Snz).symm
      refine ⟨1, R_num * ∏ h ∈ S_nz.erase z, Q_f h, ?_⟩
      calc
        z * (Polynomial.eval₂ v₁Map u g₁) ^ 1
            = z * Polynomial.eval₂ v₁Map u (Q_f z * ∏ h ∈ S_nz.erase z, Q_f h) := by
              rw [pow_one, hg₁_split]
        _ = (z * Polynomial.eval₂ v₁Map u (Q_f z)) *
              Polynomial.eval₂ v₁Map u (∏ h ∈ S_nz.erase z, Q_f h) := by
              rw [Polynomial.eval₂_mul, mul_assoc]
        _ = Polynomial.eval₂ v₁Map u R_num *
              Polynomial.eval₂ v₁Map u (∏ h ∈ S_nz.erase z, Q_f h) := by rw [hR_num]
        _ = Polynomial.eval₂ v₁Map u (R_num * ∏ h ∈ S_nz.erase z, Q_f h) := by
              rw [Polynomial.eval₂_mul]
  
  rcases hDisk with ⟨i_inf, hi_inf⟩ | ⟨hAllBdd, π₀, hπ₀_ne, hy₀_div_π₀, hπ₀_div_y₀⟩
  · 
    let c : ↥V₁ := D.β i_inf
    let d₀ : ↥V₁ := D.Δ
    let u : E := (x₀ - v₁Map c) / v₁Map d₀
    have hv₁_Δ_ne : v₁Map D.Δ ≠ 0 := hv₁_ne D.hΔ_ne
    have hyc_eq : x₀ - v₁Map c = v₁Map D.Δ * u :=
      (mul_div_cancel₀ (x₀ - v₁Map c) hv₁_Δ_ne).symm
    
    have hq_le_Q : q i_inf ≤ Q_max :=
      Nat.le_of_dvd hQ_pos (Finset.dvd_prod_of_mem q (Finset.mem_univ i_inf))
    have hq1_le : q i_inf + 1 ≤ 2 * Q_max := by omega
    let r_exp : ℕ := 2 * Q_max - (q i_inf + 1)
    have h_exp_eq : 2 * Q_max = 1 + q i_inf + r_exp := by omega
    let d_inf : ↥V₁ := D.Δ * D.Δ ^ (q i_inf)
    have hd_inf_ne : d_inf ≠ 0 := mul_ne_zero D.hΔ_ne (pow_ne_zero (q i_inf) D.hΔ_ne)
    have hv₁_dinf_ne : v₁Map d_inf ≠ 0 := hv₁_ne hd_inf_ne
    have hp_div_dinf : D.p_val i_inf / v₁Map d_inf ∈ Vx :=
      (D.h_inf i_inf hi_inf d_inf hd_inf_ne).1
    have hu_pow_mem : u ^ (q i_inf) ∈ Vx := by
      have h_eps_fac : ε = d_inf * D.Δ ^ r_exp := by
        change D.Δ ^ (2 * Q_max) = (D.Δ * D.Δ ^ (q i_inf)) * D.Δ ^ r_exp
        rw [h_exp_eq, pow_add, pow_add, pow_one]
      have hu_pow_eq : u ^ (q i_inf) =
          v₁Map D.Δ * (D.p_val i_inf / v₁Map d_inf + v₁Map (D.Δ ^ r_exp * D.s_err i_inf)) := by
        have hΔq_ne : (v₁Map D.Δ) ^ (q i_inf) ≠ 0 := pow_ne_zero (q i_inf) hv₁_Δ_ne
        apply mul_left_cancel₀ hΔq_ne
        have hp_iinf : D.p_val i_inf =
            (v₁Map D.Δ) ^ (q i_inf) * u ^ (q i_inf) - v₁Map (ε * D.s_err i_inf) := by
          have h0 := D.hp_eq i_inf
          change D.p_val i_inf = (x₀ - v₁Map c) ^ (q i_inf) - v₁Map (ε * D.s_err i_inf) at h0
          rw [hyc_eq, mul_pow] at h0
          exact h0
        have hdinf_map : v₁Map d_inf = v₁Map D.Δ * (v₁Map D.Δ) ^ (q i_inf) := by
          simp only [d_inf, map_mul, map_pow]
        have heps_map : v₁Map (ε * D.s_err i_inf) =
            v₁Map d_inf * v₁Map (D.Δ ^ r_exp * D.s_err i_inf) := by
          rw [h_eps_fac, mul_assoc, map_mul]
        calc
          (v₁Map D.Δ) ^ (q i_inf) * u ^ (q i_inf)
              = D.p_val i_inf + v₁Map (ε * D.s_err i_inf) := by linear_combination -hp_iinf
          _ = v₁Map d_inf * (D.p_val i_inf / v₁Map d_inf) +
                v₁Map d_inf * v₁Map (D.Δ ^ r_exp * D.s_err i_inf) := by
              rw [mul_div_cancel₀ _ hv₁_dinf_ne, heps_map]
          _ = (v₁Map D.Δ) ^ (q i_inf) *
                (v₁Map D.Δ * (D.p_val i_inf / v₁Map d_inf + v₁Map (D.Δ ^ r_exp * D.s_err i_inf))) := by
              rw [hdinf_map]
              ring
      rw [hu_pow_eq]
      exact mul_mem (hv₁_mem D.Δ)
        (add_mem hp_div_dinf (hv₁_mem (D.Δ ^ r_exp * D.s_err i_inf)))
    have hu_mem : u ∈ Vx := h_pow_mem_Vx u (q i_inf) (hq_pos i_inf) hu_pow_mem
    
    have h_bdd : ∀ j ∈ D.I_bdd,
        θ c j ≠ 0 ∧
        (D.Δ ^ (q j)).1 / (θ c j).1 ∈ V₁ ∧
        θ c j ∣ D.δ j ∧
        v₁Map (θ c j) / D.p_val j ∈ Vx := by
      intro j hj
      obtain ⟨hδ_ne, hδ_in, hδ_out, hδ_dvd⟩ := D.hδ_bdd j hj
      have hp_ne : D.p_val j ≠ 0 := (D.hp_mem j).2
      have hδ_dvd_Δq : D.δ j ∣ D.Δ ^ (q j) :=
        dvd_trans hδ_dvd (dvd_pow_self D.Δ (hq_ne j))
      obtain ⟨w', hw'⟩ := hδ_dvd_Δq
      have hΔq_ne : D.Δ ^ (q j) ≠ 0 := pow_ne_zero (q j) D.hΔ_ne
      have hw'_ne : w' ≠ 0 := right_ne_zero_of_mul (hw' ▸ hΔq_ne)
      have hv₁_δ_ne : v₁Map (D.δ j) ≠ 0 := hv₁_ne hδ_ne
      have hv₁_w'_ne : v₁Map w' ≠ 0 := hv₁_ne hw'_ne
      have hz_in : v₁Map (D.Δ ^ (q j)) / D.p_val j ∈ Vx := by
        have h_eq : v₁Map (D.Δ ^ (q j)) / D.p_val j =
            (v₁Map (D.δ j) / D.p_val j) * v₁Map w' := by
          rw [hw', map_mul, mul_div_right_comm]
        rw [h_eq]
        exact mul_mem hδ_in (hv₁_mem w')
      have hz_inv_out : (v₁Map (D.Δ ^ (q j)) / D.p_val j)⁻¹ ∉ Vx := by
        rw [inv_div]
        intro h_bad
        have h_eq : D.p_val j / v₁Map (D.δ j) =
            (D.p_val j / v₁Map (D.Δ ^ (q j))) * v₁Map w' := by
          rw [hw', map_mul]
          field_simp [hv₁_δ_ne, hv₁_w'_ne]
        exact hδ_out (h_eq ▸ mul_mem h_bad (hv₁_mem w'))
      obtain ⟨hη_in, hη_nu⟩ :=
        h_nonunit_mul (v₁Map (D.Δ ^ (q j)) / D.p_val j) (-(u ^ (q j)))
          hz_in hz_inv_out (neg_mem (pow_mem hu_mem (q j)))
      have hθ_div_eq : v₁Map (θ c j) / D.p_val j =
          1 + (v₁Map (D.Δ ^ (q j)) / D.p_val j) * (-(u ^ (q j))) := by
        have hrec := hp_recenter c j
        rw [hyc_eq, mul_pow, ← map_pow] at hrec
        field_simp [hp_ne]
        linear_combination -hrec
      have hθ_in_Vx : v₁Map (θ c j) / D.p_val j ∈ Vx := by
        rw [hθ_div_eq]
        exact add_mem (one_mem Vx) hη_in
      obtain ⟨h1η_ne, h1η_inv⟩ := h_one_add_unit _ hη_in hη_nu
      rw [← hθ_div_eq] at h1η_ne h1η_inv
      have hv₁_θ_ne : v₁Map (θ c j) ≠ 0 := fun h0 => h1η_ne (by simp [h0])
      have hθ_ne : θ c j ≠ 0 := fun h0 => hv₁_θ_ne (by simp [h0])
      have hp_div_θ : D.p_val j / v₁Map (θ c j) ∈ Vx := by
        rwa [inv_div] at h1η_inv
      have hΔq_div_θ : v₁Map (D.Δ ^ (q j)) / v₁Map (θ c j) ∈ Vx := by
        have h_eq : v₁Map (D.Δ ^ (q j)) / v₁Map (θ c j) =
            (v₁Map (D.Δ ^ (q j)) / D.p_val j) * (D.p_val j / v₁Map (θ c j)) := by
          field_simp [hp_ne, hv₁_θ_ne]
        rw [h_eq]
        exact mul_mem hz_in hp_div_θ
      have hδ_div_θ : v₁Map (D.δ j) / v₁Map (θ c j) ∈ Vx := by
        have h_eq : v₁Map (D.δ j) / v₁Map (θ c j) =
            (v₁Map (D.δ j) / D.p_val j) * (D.p_val j / v₁Map (θ c j)) := by
          field_simp [hp_ne, hv₁_θ_ne]
        rw [h_eq]
        exact mul_mem hδ_in hp_div_θ
      exact ⟨hθ_ne, h_div_mem (D.Δ ^ (q j)) (θ c j) hΔq_div_θ,
        h_dvd_of_div_Vx (D.δ j) (θ c j) hθ_ne hδ_div_θ, hθ_in_Vx⟩
    
    let σ : Fin D.M → ↥V₁ := fun i => if i ∈ D.I_bdd then θ c i else D.Δ
    let W : Fin D.M → Polynomial ↥V₁ := fun i =>
      if hi : i ∈ D.I_bdd then
        1 + Polynomial.C (⟨(D.Δ ^ (q i)).1 / (θ c i).1, (h_bdd i hi).2.1⟩ : ↥V₁) *
          Polynomial.X ^ (q i)
      else
        Polynomial.C (D.Δ ^ (q i - 1)) * Polynomial.X ^ (q i) -
          Polynomial.C (D.Δ ^ (2 * Q_max - 1) * D.s_err i)
    refine h_assembly c d₀ σ W D.hΔ_ne hu_mem ?_ ?_ ?_ ?_
    · intro i
      by_cases hi : i ∈ D.I_bdd
      · simp only [σ, hi, ↓reduceIte]
        exact (h_bdd i hi).1
      · simp only [σ, hi, ↓reduceIte]
        exact D.hΔ_ne
    · intro i
      change D.p_val i = v₁Map (σ i) * Polynomial.eval₂ v₁Map u (W i)
      by_cases hi : i ∈ D.I_bdd
      · simp only [σ, W, hi, ↓reduceIte, ↓reduceDIte, Polynomial.eval₂_add, Polynomial.eval₂_one,
          Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X_pow]
        have hmul : θ c i * ⟨(D.Δ ^ (q i)).1 / (θ c i).1, (h_bdd i hi).2.1⟩ = D.Δ ^ (q i) :=
          h_quo_mul (D.Δ ^ (q i)) (θ c i) (h_bdd i hi).1 (h_bdd i hi).2.1
        calc
          D.p_val i = (x₀ - v₁Map c) ^ (q i) + v₁Map (θ c i) := hp_recenter c i
          _ = v₁Map (D.Δ ^ (q i)) * u ^ (q i) + v₁Map (θ c i) := by
              rw [hyc_eq, mul_pow, map_pow]
          _ = v₁Map (θ c i * ⟨(D.Δ ^ (q i)).1 / (θ c i).1, (h_bdd i hi).2.1⟩) * u ^ (q i) +
                v₁Map (θ c i) := by rw [hmul]
          _ = v₁Map (θ c i) *
                (1 + v₁Map (⟨(D.Δ ^ (q i)).1 / (θ c i).1, (h_bdd i hi).2.1⟩ : ↥V₁) * u ^ (q i)) := by
              rw [map_mul]; ring
      · simp only [σ, W, hi, ↓reduceIte, ↓reduceDIte, Polynomial.eval₂_sub, Polynomial.eval₂_mul,
          Polynomial.eval₂_C, Polynomial.eval₂_X_pow]
        have hi_eq : i = i_inf := D.h_inf_subsingleton i i_inf hi hi_inf
        subst hi_eq
        have hΔ1 : D.Δ * D.Δ ^ (q i - 1) = D.Δ ^ (q i) := by
          rw [← pow_succ', Nat.sub_add_cancel (hq_pos i)]
        have hΔ2 : D.Δ * D.Δ ^ (2 * Q_max - 1) = ε := by
          change D.Δ * D.Δ ^ (2 * Q_max - 1) = D.Δ ^ (2 * Q_max)
          rw [← pow_succ', Nat.sub_add_cancel (by omega : 1 ≤ 2 * Q_max)]
        calc
          D.p_val i = (x₀ - v₁Map c) ^ (q i) - v₁Map (ε * D.s_err i) := D.hp_eq i
          _ = v₁Map (D.Δ ^ (q i)) * u ^ (q i) - v₁Map (ε * D.s_err i) := by
              rw [hyc_eq, mul_pow, map_pow]
          _ = v₁Map (D.Δ * D.Δ ^ (q i - 1)) * u ^ (q i) -
                v₁Map ((D.Δ * D.Δ ^ (2 * Q_max - 1)) * D.s_err i) := by
              rw [← hΔ1, ← hΔ2]
          _ = v₁Map D.Δ *
                (v₁Map (D.Δ ^ (q i - 1)) * u ^ (q i) -
                  v₁Map (D.Δ ^ (2 * Q_max - 1) * D.s_err i)) := by
              simp only [mul_assoc, map_mul]
              ring
    · intro i hi
      change Polynomial.eval₂ v₁Map u (W i) ≠ 0 ∧ (Polynomial.eval₂ v₁Map u (W i))⁻¹ ∈ Vx
      have hfac : D.p_val i = v₁Map (θ c i) * Polynomial.eval₂ v₁Map u (W i) := by
        simp only [W, hi, ↓reduceDIte, Polynomial.eval₂_add, Polynomial.eval₂_one,
          Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X_pow]
        have hmul : θ c i * ⟨(D.Δ ^ (q i)).1 / (θ c i).1, (h_bdd i hi).2.1⟩ = D.Δ ^ (q i) :=
          h_quo_mul (D.Δ ^ (q i)) (θ c i) (h_bdd i hi).1 (h_bdd i hi).2.1
        calc
          D.p_val i = (x₀ - v₁Map c) ^ (q i) + v₁Map (θ c i) := hp_recenter c i
          _ = v₁Map (D.Δ ^ (q i)) * u ^ (q i) + v₁Map (θ c i) := by
              rw [hyc_eq, mul_pow, map_pow]
          _ = v₁Map (θ c i * ⟨(D.Δ ^ (q i)).1 / (θ c i).1, (h_bdd i hi).2.1⟩) * u ^ (q i) +
                v₁Map (θ c i) := by rw [hmul]
          _ = v₁Map (θ c i) *
                (1 + v₁Map (⟨(D.Δ ^ (q i)).1 / (θ c i).1, (h_bdd i hi).2.1⟩ : ↥V₁) * u ^ (q i)) := by
              rw [map_mul]; ring
      have hp_ne : D.p_val i ≠ 0 := (D.hp_mem i).2
      have hWi_ne : Polynomial.eval₂ v₁Map u (W i) ≠ 0 :=
        fun h0 => hp_ne (by rw [hfac, h0, mul_zero])
      refine ⟨hWi_ne, ?_⟩
      have h_inv_eq : (Polynomial.eval₂ v₁Map u (W i))⁻¹ = v₁Map (θ c i) / D.p_val i := by
        apply inv_eq_of_mul_eq_one_right
        rw [mul_div_assoc', mul_comm, ← hfac, div_self hp_ne]
      rw [h_inv_eq]
      exact (h_bdd i hi).2.2.2
    · intro i hi
      refine ⟨?_, ?_⟩
      · simp only [σ, hi, ↓reduceIte]
        exact dvd_rfl
      · intro j hj
        simp only [σ, hj, ↓reduceIte]
        exact (h_bdd j hj).2.2.1
  · 
    let c : ↥V₁ := D.β D.k₀
    let d₀ : ↥V₁ := π₀
    let y₀ : E := x₀ - v₁Map c
    let u : E := y₀ / v₁Map π₀
    have hv₁_π₀_ne : v₁Map π₀ ≠ 0 := hv₁_ne hπ₀_ne
    have hx_sub_ne : ∀ b : ↥V₁, x₀ - v₁Map b ≠ 0 := by
      intro b h0
      apply hx₀_tr
      refine ⟨Polynomial.X - Polynomial.C b.1, Polynomial.X_sub_C_ne_zero b.1, ?_⟩
      simp only [map_sub, Polynomial.aeval_X, Polynomial.aeval_C]
      exact h0
    have hy₀_ne : y₀ ≠ 0 := hx_sub_ne c
    have hy₀_eq : y₀ = v₁Map π₀ * u := (mul_div_cancel₀ y₀ hv₁_π₀_ne).symm
    
    have hAB : ∀ i : Fin D.M,
        y₀ ^ (q i) / D.p_val i ∈ Vx ∧ v₁Map (θ c i) / D.p_val i ∈ Vx := by
      intro i
      obtain ⟨_, hδ_in, _, hδ_dvd⟩ := D.hδ_bdd i (hAllBdd i)
      have hp_ne : D.p_val i ≠ 0 := (D.hp_mem i).2
      have hδ_dvd_err : D.δ i ∣ ε * D.s_err i :=
        dvd_mul_of_dvd_left
          (dvd_trans hδ_dvd (dvd_pow_self D.Δ (by omega : 2 * Q_max ≠ 0))) (D.s_err i)
      obtain ⟨w_i, hw_i⟩ := hδ_dvd_err
      have h_pow_div_p : (x₀ - v₁Map (D.β i)) ^ (q i) / D.p_val i ∈ Vx := by
        have h_eq : (x₀ - v₁Map (D.β i)) ^ (q i) / D.p_val i =
            1 + (v₁Map (D.δ i) / D.p_val i) * v₁Map w_i := by
          have hp_i := D.hp_eq i
          change D.p_val i = (x₀ - v₁Map (D.β i)) ^ (q i) - v₁Map (ε * D.s_err i) at hp_i
          rw [hw_i, map_mul] at hp_i
          field_simp [hp_ne]
          linear_combination -hp_i
        rw [h_eq]
        exact add_mem (one_mem Vx) (mul_mem hδ_in (hv₁_mem w_i))
      have hA_in : y₀ ^ (q i) / D.p_val i ∈ Vx := by
        have h_max_pow : (y₀ / (x₀ - v₁Map (D.β i))) ^ (q i) ∈ Vx :=
          pow_mem (D.hk₀_max i) (q i)
        have hxi_pow_ne : (x₀ - v₁Map (D.β i)) ^ (q i) ≠ 0 :=
          pow_ne_zero (q i) (hx_sub_ne (D.β i))
        have h_eq : y₀ ^ (q i) / D.p_val i =
            (y₀ / (x₀ - v₁Map (D.β i))) ^ (q i) *
              ((x₀ - v₁Map (D.β i)) ^ (q i) / D.p_val i) := by
          rw [div_pow]
          field_simp [hxi_pow_ne, hp_ne]
        rw [h_eq]
        exact mul_mem h_max_pow h_pow_div_p
      have hB_in : v₁Map (θ c i) / D.p_val i ∈ Vx := by
        have h_eq : v₁Map (θ c i) / D.p_val i = 1 - y₀ ^ (q i) / D.p_val i := by
          have hrec := hp_recenter c i
          field_simp [hp_ne]
          linear_combination -hrec
        rw [h_eq]
        exact sub_mem (one_mem Vx) hA_in
      exact ⟨hA_in, hB_in⟩
    
    have h_inv_branch : ∀ i : Fin D.M, (θ c i).1 / (π₀ ^ (q i)).1 ∉ V₁ →
        θ c i ≠ 0 ∧ (π₀ ^ (q i)).1 / (θ c i).1 ∈ V₁ := by
      intro i h_not
      have hθ_ne : θ c i ≠ 0 := by
        intro h0
        apply h_not
        rw [h0]
        change (0 : K) / (π₀ ^ (q i)).1 ∈ V₁
        rw [zero_div]
        exact zero_mem V₁
      rcases ValuationSubring.mem_or_inv_mem V₁ ((θ c i).1 / (π₀ ^ (q i)).1) with hm | hinv
      · exact absurd hm h_not
      · rw [inv_div] at hinv
        exact ⟨hθ_ne, hinv⟩
    let σ : Fin D.M → ↥V₁ := fun i =>
      if (θ c i).1 / (π₀ ^ (q i)).1 ∈ V₁ then π₀ ^ (q i) else θ c i
    let W : Fin D.M → Polynomial ↥V₁ := fun i =>
      if h_in : (θ c i).1 / (π₀ ^ (q i)).1 ∈ V₁ then
        Polynomial.X ^ (q i) + Polynomial.C (⟨(θ c i).1 / (π₀ ^ (q i)).1, h_in⟩ : ↥V₁)
      else
        1 + Polynomial.C (⟨(π₀ ^ (q i)).1 / (θ c i).1, (h_inv_branch i h_in).2⟩ : ↥V₁) *
          Polynomial.X ^ (q i)
    have hσ_W_fac : ∀ i : Fin D.M,
        D.p_val i = v₁Map (σ i) * Polynomial.eval₂ v₁Map u (W i) := by
      intro i
      have hπq_ne : π₀ ^ (q i) ≠ 0 := pow_ne_zero (q i) hπ₀_ne
      by_cases h_in : (θ c i).1 / (π₀ ^ (q i)).1 ∈ V₁
      · simp only [σ, W, h_in, ↓reduceIte, ↓reduceDIte, Polynomial.eval₂_add,
          Polynomial.eval₂_X_pow, Polynomial.eval₂_C]
        have hmul : π₀ ^ (q i) * ⟨(θ c i).1 / (π₀ ^ (q i)).1, h_in⟩ = θ c i :=
          h_quo_mul (θ c i) (π₀ ^ (q i)) hπq_ne h_in
        calc
          D.p_val i = y₀ ^ (q i) + v₁Map (θ c i) := hp_recenter c i
          _ = v₁Map (π₀ ^ (q i)) * u ^ (q i) + v₁Map (θ c i) := by
              rw [hy₀_eq, mul_pow, map_pow]
          _ = v₁Map (π₀ ^ (q i)) * u ^ (q i) +
                v₁Map (π₀ ^ (q i) * ⟨(θ c i).1 / (π₀ ^ (q i)).1, h_in⟩) := by rw [hmul]
          _ = v₁Map (π₀ ^ (q i)) *
                (u ^ (q i) + v₁Map (⟨(θ c i).1 / (π₀ ^ (q i)).1, h_in⟩ : ↥V₁)) := by
              rw [map_mul]; ring
      · simp only [σ, W, h_in, ↓reduceIte, ↓reduceDIte, Polynomial.eval₂_add, Polynomial.eval₂_one,
          Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X_pow]
        obtain ⟨hθ_ne, hinv⟩ := h_inv_branch i h_in
        have hmul : θ c i * ⟨(π₀ ^ (q i)).1 / (θ c i).1, hinv⟩ = π₀ ^ (q i) :=
          h_quo_mul (π₀ ^ (q i)) (θ c i) hθ_ne hinv
        calc
          D.p_val i = y₀ ^ (q i) + v₁Map (θ c i) := hp_recenter c i
          _ = v₁Map (π₀ ^ (q i)) * u ^ (q i) + v₁Map (θ c i) := by
              rw [hy₀_eq, mul_pow, map_pow]
          _ = v₁Map (θ c i * ⟨(π₀ ^ (q i)).1 / (θ c i).1, hinv⟩) * u ^ (q i) +
                v₁Map (θ c i) := by rw [hmul]
          _ = v₁Map (θ c i) *
                (1 + v₁Map (⟨(π₀ ^ (q i)).1 / (θ c i).1, hinv⟩ : ↥V₁) * u ^ (q i)) := by
              rw [map_mul]; ring
    refine h_assembly c d₀ σ W hπ₀_ne hy₀_div_π₀ ?_ hσ_W_fac ?_ ?_
    · intro i
      by_cases h_in : (θ c i).1 / (π₀ ^ (q i)).1 ∈ V₁
      · simp only [σ, h_in, ↓reduceIte]
        exact pow_ne_zero (q i) hπ₀_ne
      · simp only [σ, h_in, ↓reduceIte]
        exact (h_inv_branch i h_in).1
    · intro i _
      change Polynomial.eval₂ v₁Map u (W i) ≠ 0 ∧ (Polynomial.eval₂ v₁Map u (W i))⁻¹ ∈ Vx
      have hp_ne : D.p_val i ≠ 0 := (D.hp_mem i).2
      have hfac := hσ_W_fac i
      have hWi_ne : Polynomial.eval₂ v₁Map u (W i) ≠ 0 :=
        fun h0 => hp_ne (by rw [hfac, h0, mul_zero])
      refine ⟨hWi_ne, ?_⟩
      by_cases h_in : (θ c i).1 / (π₀ ^ (q i)).1 ∈ V₁
      · simp only [σ, h_in, ↓reduceIte] at hfac
        have h_inv_eq : (Polynomial.eval₂ v₁Map u (W i))⁻¹ =
            (v₁Map π₀ / y₀) ^ (q i) * (y₀ ^ (q i) / D.p_val i) := by
          apply inv_eq_of_mul_eq_one_right
          have hy₀_pow_ne : y₀ ^ (q i) ≠ 0 := pow_ne_zero (q i) hy₀_ne
          rw [div_pow, ← map_pow]
          field_simp [hy₀_pow_ne, hp_ne]
          linear_combination -hfac
        rw [h_inv_eq]
        exact mul_mem (pow_mem hπ₀_div_y₀ (q i)) (hAB i).1
      · simp only [σ, h_in, ↓reduceIte] at hfac
        have h_inv_eq : (Polynomial.eval₂ v₁Map u (W i))⁻¹ = v₁Map (θ c i) / D.p_val i := by
          apply inv_eq_of_mul_eq_one_right
          rw [mul_div_assoc', mul_comm, ← hfac, div_self hp_ne]
        rw [h_inv_eq]
        exact (hAB i).2
    · intro i hi
      exact absurd (hAllBdd i) hi

theorem weil_perturbed_factorization_nodal_annulus_chart (K : Type u) [Field K]
    (E : Type u) [Field E] [Algebra K E]
    (x₀ : E) (hx₀_tr : Transcendental K x₀)
    (Vx : ValuationSubring E) (hx₀_Vx : x₀ ∈ Vx)
    (S₁ : Finset E) (hS₁ : ∀ z ∈ S₁, z ∈ Vx)
    (hDivV₁ : ∀ (a : K), a ≠ 0 → ∀ (d : ℕ), 1 ≤ d →
      ∃ (b : K) (u : ↥(Vx.comap (algebraMap K E))),
        IsUnit u ∧ b ^ d * (Vx.comap (algebraMap K E)).subtype u = a)
    (D : PerturbedRationalFactorization K E x₀ Vx S₁)
    (hAllBdd : ∀ i : Fin D.M, i ∈ D.I_bdd)
    (hNoEq : ¬ ∃ π₀ : ↥(Vx.comap (algebraMap K E)), π₀ ≠ 0 ∧
      (x₀ - ((algebraMap K E).comp (Vx.comap (algebraMap K E)).subtype) (D.β D.k₀)) /
        ((algebraMap K E).comp (Vx.comap (algebraMap K E)).subtype) π₀ ∈ Vx ∧
      ((algebraMap K E).comp (Vx.comap (algebraMap K E)).subtype) π₀ /
        (x₀ - ((algebraMap K E).comp (Vx.comap (algebraMap K E)).subtype) (D.β D.k₀)) ∈ Vx) :
    HasOverringSemistableChartWitness (Vx.comap (algebraMap K E)) Vx S₁ :=
by
  classical
  let V₁ : ValuationSubring K := Vx.comap (algebraMap K E)
  let v₁Map : ↥V₁ →+* E := (algebraMap K E).comp V₁.subtype
  have hv₁_mem : ∀ z : ↥V₁, v₁Map z ∈ Vx := fun z => z.2
  have halg_inj : Function.Injective (algebraMap K E) := (algebraMap K E).injective
  have halg_ne : ∀ {a : K}, a ≠ 0 → algebraMap K E a ≠ 0 :=
    fun ha h0 => ha (halg_inj (h0.trans (map_zero _).symm))
  have hv₁_ne : ∀ {z : ↥V₁}, z ≠ 0 → v₁Map z ≠ 0 := by
    intro z hz h0
    apply hz
    ext
    exact halg_inj (by simpa [v₁Map] using h0)
  
  let c : ↥V₁ := D.β D.k₀
  let y₀ : E := x₀ - v₁Map c
  have hy₀_Vx : y₀ ∈ Vx := Vx.sub_mem hx₀_Vx (hv₁_mem c)
  have hy₀_ne : y₀ ≠ 0 := by
    intro hy0
    have hx_eq : x₀ = algebraMap K E c.1 := sub_eq_zero.mp hy0
    apply hx₀_tr
    refine ⟨Polynomial.X - Polynomial.C c.1, Polynomial.X_sub_C_ne_zero c.1, ?_⟩
    simp [hx_eq]
  have h_pow_mem : ∀ {L : Type u} [Field L] (W : ValuationSubring L) {z : L} {d : ℕ},
      1 ≤ d → z ^ d ∈ W → z ∈ W := by
    intro L _ W z d hd hzd
    by_contra hz
    have hz_ne : z ≠ 0 := fun h0 => hz (h0 ▸ W.zero_mem)
    have hz_inv : z⁻¹ ∈ W := (ValuationSubring.mem_or_inv_mem W z).resolve_left hz
    have hd_pow : z ^ d = z ^ (d - 1) * z := by
      rw [← pow_succ, Nat.sub_add_cancel hd]
    have h_prod : z ^ d * (z⁻¹) ^ (d - 1) = z := by
      calc z ^ d * (z⁻¹) ^ (d - 1)
        _ = (z ^ (d - 1) * z) * (z⁻¹) ^ (d - 1) := by rw [hd_pow]
        _ = z * (z * z⁻¹) ^ (d - 1) := by rw [mul_pow]; ring
        _ = z := by rw [mul_inv_cancel₀ hz_ne, one_pow, mul_one]
    exact hz (h_prod ▸ W.toSubring.mul_mem hzd (W.toSubring.pow_mem hz_inv (d - 1)))
  have h_one_add_unit : ∀ {η : E}, η ∈ Vx → (η = 0 ∨ η⁻¹ ∉ Vx) →
      1 + η ≠ 0 ∧ (1 + η)⁻¹ ∈ Vx := by
    intro η hη hη_inv
    rcases eq_or_ne η 0 with rfl | hη_ne
    · simp [Vx.one_mem]
    · have hη_not : η⁻¹ ∉ Vx := hη_inv.resolve_left hη_ne
      have h1_ne : 1 + η ≠ 0 := by
        intro h0
        have h_eq : η = -1 := by
          calc η = (1 + η) - 1 := by ring
            _ = 0 - 1 := by rw [h0]
            _ = -1 := by ring
        rw [h_eq, inv_neg, inv_one] at hη_not
        exact hη_not (Vx.toSubring.neg_mem Vx.one_mem)
      refine ⟨h1_ne, ?_⟩
      rcases ValuationSubring.mem_or_inv_mem Vx ((1 + η) / η) with h_mem | h_inv_mem
      · exfalso
        have h_eq : (1 + η) / η - 1 = η⁻¹ := by field_simp; ring
        exact hη_not (h_eq ▸ Vx.sub_mem h_mem Vx.one_mem)
      · rw [inv_div] at h_inv_mem
        have h_eq : 1 - η / (1 + η) = (1 + η)⁻¹ := by field_simp; ring
        exact h_eq ▸ Vx.sub_mem Vx.one_mem h_inv_mem
  
  have h_root_step : ∀ {s : K} {d : ℕ}, s ≠ 0 → 1 ≤ d →
      ∃ (b : K) (u₁ u₁_inv : ↥V₁),
        b ≠ 0 ∧
        b ^ d = s * u₁_inv.1 ∧
        s = b ^ d * u₁.1 ∧
        (y₀ ^ d / algebraMap K E s ∈ Vx → y₀ / algebraMap K E b ∈ Vx) ∧
        (algebraMap K E s / y₀ ^ d ∈ Vx → algebraMap K E b / y₀ ∈ Vx ∧ b ∈ V₁) := by
    intro s d hs hd
    obtain ⟨b, u₁_raw, hu₁, hbu⟩ := hDivV₁ s hs d hd
    rcases hu₁ with ⟨u_unit, rfl⟩
    let u₁ : ↥V₁ := ↑u_unit
    let u₁_inv : ↥V₁ := ↑(u_unit⁻¹)
    have hbu' : b ^ d * u₁.1 = s := hbu
    have hb_ne : b ≠ 0 := by
      intro hb0
      have hd_ne : d ≠ 0 := by omega
      rw [hb0, zero_pow hd_ne, zero_mul] at hbu'
      exact hs hbu'.symm
    have hu_mul : u₁.1 * u₁_inv.1 = 1 := congrArg Subtype.val (Units.mul_inv u_unit)
    have hu₁_ne : u₁.1 ≠ 0 := left_ne_zero_of_mul_eq_one hu_mul
    have h_bd : b ^ d = s * u₁_inv.1 := by
      calc b ^ d = b ^ d * (u₁.1 * u₁_inv.1) := by rw [hu_mul, mul_one]
        _ = (b ^ d * u₁.1) * u₁_inv.1 := by ring
        _ = s * u₁_inv.1 := by rw [hbu']
    have hs_E : algebraMap K E s = (algebraMap K E b) ^ d * v₁Map u₁ := by
      simpa [map_pow, map_mul, v₁Map] using congrArg (algebraMap K E) hbu'.symm
    have h_bd_E : (algebraMap K E b) ^ d = algebraMap K E s * v₁Map u₁_inv := by
      simpa [map_pow, map_mul, v₁Map] using congrArg (algebraMap K E) h_bd
    refine ⟨b, u₁, u₁_inv, hb_ne, h_bd, hbu'.symm, ?_, ?_⟩
    · intro h_low
      have hvu₁_ne : v₁Map u₁ ≠ 0 := halg_ne hu₁_ne
      have h_yb_pow : (y₀ / algebraMap K E b) ^ d = (y₀ ^ d / algebraMap K E s) * v₁Map u₁ := by
        rw [div_pow, hs_E, div_mul_eq_div_div, div_mul_cancel₀ _ hvu₁_ne]
      exact h_pow_mem Vx hd (h_yb_pow ▸ Vx.toSubring.mul_mem h_low (hv₁_mem u₁))
    · intro h_up
      have h_by_pow : (algebraMap K E b / y₀) ^ d = (algebraMap K E s / y₀ ^ d) * v₁Map u₁_inv := by
        rw [div_pow, h_bd_E, mul_div_right_comm]
      have h_by : algebraMap K E b / y₀ ∈ Vx :=
        h_pow_mem Vx hd (h_by_pow ▸ Vx.toSubring.mul_mem h_up (hv₁_mem u₁_inv))
      have hb_V₁ : b ∈ V₁ := by
        rw [ValuationSubring.mem_comap]
        have h_eq : algebraMap K E b = y₀ * (algebraMap K E b / y₀) :=
          (mul_div_cancel₀ _ hy₀_ne).symm
        exact h_eq ▸ Vx.toSubring.mul_mem hy₀_Vx h_by
      exact ⟨h_by, hb_V₁⟩
  have h_low_root : ∀ {s : K} {d : ℕ}, s ≠ 0 → s ∈ V₁ → 1 ≤ d →
      y₀ ^ d / algebraMap K E s ∈ Vx →
      ∃ σ : ↥V₁, σ ≠ 0 ∧ y₀ / v₁Map σ ∈ Vx ∧ (σ.1) ^ d / s ∈ V₁ := by
    intro s d hs hs_V₁ hd h_low
    obtain ⟨b, _, u₁_inv, hb_ne, h_bd, _, h_low_imp, _⟩ := h_root_step hs hd
    have hb_V₁ : b ∈ V₁ := h_pow_mem V₁ hd (h_bd ▸ V₁.toSubring.mul_mem hs_V₁ u₁_inv.2)
    refine ⟨⟨b, hb_V₁⟩, fun h0 => hb_ne (congrArg Subtype.val h0), h_low_imp h_low, ?_⟩
    change b ^ d / s ∈ V₁
    rw [h_bd, mul_div_cancel_left₀ u₁_inv.1 hs]
    exact u₁_inv.2
  have h_up_root : ∀ {s : K} {d : ℕ}, s ≠ 0 → 1 ≤ d →
      algebraMap K E s / y₀ ^ d ∈ Vx →
      ∃ τ : ↥V₁, τ ≠ 0 ∧ v₁Map τ / y₀ ∈ Vx ∧ s / (τ.1) ^ d ∈ V₁ := by
    intro s d hs hd h_up
    obtain ⟨b, u₁, _, hb_ne, _, hs_eq, _, h_up_imp⟩ := h_root_step hs hd
    obtain ⟨h_by, hb_V₁⟩ := h_up_imp h_up
    refine ⟨⟨b, hb_V₁⟩, fun h0 => hb_ne (congrArg Subtype.val h0), h_by, ?_⟩
    change s / b ^ d ∈ V₁
    rw [hs_eq, mul_div_cancel_left₀ u₁.1 (pow_ne_zero d hb_ne)]
    exact u₁.2
  have h_mut_excl : ∀ {s : K} {d : ℕ}, s ≠ 0 → 1 ≤ d →
      y₀ ^ d / algebraMap K E s ∈ Vx → algebraMap K E s / y₀ ^ d ∈ Vx → False := by
    intro s d hs hd h_low h_up
    obtain ⟨b, _, _, hb_ne, _, _, h_low_imp, h_up_imp⟩ := h_root_step hs hd
    obtain ⟨h_by, hb_V₁⟩ := h_up_imp h_up
    exact hNoEq ⟨⟨b, hb_V₁⟩, fun h0 => hb_ne (congrArg Subtype.val h0), h_low_imp h_low, h_by⟩
  
  let q : Fin D.M → ℕ := fun i => D.p_exp ^ (D.e i)
  have hq_pos : ∀ i : Fin D.M, 1 ≤ q i := fun i => Nat.one_le_pow (D.e i) D.p_exp D.hp_pos
  obtain ⟨τ₀, hτ₀_ne, hτ₀_div⟩ : ∃ τ₀ : ↥V₁, τ₀ ≠ 0 ∧ v₁Map τ₀ / y₀ ∈ Vx := by
    obtain ⟨hδ_ne, hδ_div_p, hp_div_δ_not, ⟨w₀, hw₀⟩⟩ := D.hδ_bdd D.k₀ (hAllBdd D.k₀)
    let Q_prod : ℕ := ∏ j : Fin D.M, q j
    have hQ_pos : 0 < Q_prod := Finset.prod_pos (fun j _ => hq_pos j)
    let z₀ : ↥V₁ := w₀ * D.Δ ^ (2 * Q_prod - 1) * D.s_err D.k₀
    have hΔ_pow : D.Δ ^ (2 * Q_prod) * D.s_err D.k₀ = D.δ D.k₀ * z₀ := by
      have hΔ_step : D.Δ ^ (2 * Q_prod) = D.Δ ^ (2 * Q_prod - 1) * D.Δ := by
        rw [← pow_succ, show 2 * Q_prod - 1 + 1 = 2 * Q_prod by omega]
      calc D.Δ ^ (2 * Q_prod) * D.s_err D.k₀
        _ = (D.Δ ^ (2 * Q_prod - 1) * D.Δ) * D.s_err D.k₀ := by rw [hΔ_step]
        _ = (D.Δ ^ (2 * Q_prod - 1) * (D.δ D.k₀ * w₀)) * D.s_err D.k₀ := by rw [hw₀]
        _ = D.δ D.k₀ * z₀ := by dsimp [z₀]; ring
    have hp₀_ne : D.p_val D.k₀ ≠ 0 := (D.hp_mem D.k₀).2
    have hp₀_eq : D.p_val D.k₀ = y₀ ^ (q D.k₀) - v₁Map (D.δ D.k₀) * v₁Map z₀ := by
      have h1 := D.hp_eq D.k₀
      change D.p_val D.k₀ = y₀ ^ (q D.k₀) - v₁Map (D.Δ ^ (2 * Q_prod) * D.s_err D.k₀) at h1
      rw [hΔ_pow, map_mul] at h1
      exact h1
    let η₀ : E := (v₁Map (D.δ D.k₀) / D.p_val D.k₀) * v₁Map z₀
    have hη₀_Vx : η₀ ∈ Vx := Vx.toSubring.mul_mem hδ_div_p (hv₁_mem z₀)
    have hη₀_inv : η₀ = 0 ∨ η₀⁻¹ ∉ Vx := by
      by_cases h0 : η₀ = 0
      · exact Or.inl h0
      · refine Or.inr (fun h_inv => hp_div_δ_not ?_)
        have hvδ_ne : v₁Map (D.δ D.k₀) ≠ 0 := hv₁_ne hδ_ne
        have hvz_ne : v₁Map z₀ ≠ 0 := fun hz0 => h0 (by simp [η₀, hz0])
        have h_eq : v₁Map z₀ * η₀⁻¹ = D.p_val D.k₀ / v₁Map (D.δ D.k₀) := by
          dsimp [η₀]
          field_simp
        exact h_eq ▸ Vx.toSubring.mul_mem (hv₁_mem z₀) h_inv
    have h_ratio_eq : 1 + η₀ = y₀ ^ (q D.k₀) / D.p_val D.k₀ := by
      have hy_eq : y₀ ^ (q D.k₀) = D.p_val D.k₀ + v₁Map (D.δ D.k₀) * v₁Map z₀ := by
        calc y₀ ^ (q D.k₀) = (y₀ ^ (q D.k₀) - v₁Map (D.δ D.k₀) * v₁Map z₀) +
            v₁Map (D.δ D.k₀) * v₁Map z₀ := by ring
          _ = D.p_val D.k₀ + v₁Map (D.δ D.k₀) * v₁Map z₀ := by rw [← hp₀_eq]
      rw [hy_eq]
      dsimp [η₀]
      field_simp
    have hp_div_y : D.p_val D.k₀ / y₀ ^ (q D.k₀) ∈ Vx := by
      have h_inv_mem := (h_one_add_unit hη₀_Vx hη₀_inv).2
      rw [h_ratio_eq, inv_div] at h_inv_mem
      exact h_inv_mem
    have hδ_div_y : algebraMap K E (D.δ D.k₀).1 / y₀ ^ (q D.k₀) ∈ Vx := by
      have h_eq : (v₁Map (D.δ D.k₀) / D.p_val D.k₀) * (D.p_val D.k₀ / y₀ ^ (q D.k₀)) =
          algebraMap K E (D.δ D.k₀).1 / y₀ ^ (q D.k₀) :=
        div_mul_div_cancel₀ hp₀_ne
      exact h_eq ▸ Vx.toSubring.mul_mem hδ_div_p hp_div_y
    obtain ⟨τ₀, hτ₀_ne, hτ₀_div, _⟩ :=
      h_up_root (fun h0 => hδ_ne (Subtype.ext h0)) (hq_pos D.k₀) hδ_div_y
    exact ⟨τ₀, hτ₀_ne, hτ₀_div⟩
  let ε_pert : ↥V₁ := D.Δ ^ (2 * ∏ j : Fin D.M, q j)
  let θ : Fin D.M → ↥V₁ := fun i => (c - D.β i) ^ (q i) - ε_pert * D.s_err i
  have hp_recenter : ∀ i : Fin D.M, D.p_val i = y₀ ^ (q i) + v₁Map (θ i) := by
    haveI : ExpChar K D.p_exp := D.hExpChar
    haveI : ExpChar E D.p_exp := expChar_of_injective_algebraMap halg_inj D.p_exp
    intro i
    have h_shift : x₀ - v₁Map (D.β i) = y₀ + v₁Map (c - D.β i) := by
      dsimp [y₀]
      rw [map_sub]
      ring
    have h_frob : (x₀ - v₁Map (D.β i)) ^ (q i) = y₀ ^ (q i) + v₁Map ((c - D.β i) ^ (q i)) := by
      rw [h_shift, map_pow]
      exact add_pow_expChar_pow y₀ (v₁Map (c - D.β i)) D.p_exp (D.e i)
    have hp_i : D.p_val i = (x₀ - v₁Map (D.β i)) ^ (q i) - v₁Map (ε_pert * D.s_err i) := D.hp_eq i
    rw [hp_i, h_frob]
    dsimp [θ]
    rw [map_sub]
    ring
  let J_out : Finset (Fin D.M) :=
    Finset.univ.filter (fun i => θ i ≠ 0 ∧ y₀ ^ (q i) / v₁Map (θ i) ∈ Vx)
  let J_in : Finset (Fin D.M) := Finset.univ \ J_out
  let V_fac : Fin D.M → E := fun i =>
    if i ∈ J_out then 1 + y₀ ^ (q i) / v₁Map (θ i) else 1 + v₁Map (θ i) / y₀ ^ (q i)
  have hV_fac_props : ∀ i : Fin D.M,
      V_fac i ∈ Vx ∧ V_fac i ≠ 0 ∧ (V_fac i)⁻¹ ∈ Vx ∧
      D.p_val i = (if i ∈ J_out then v₁Map (θ i) else y₀ ^ (q i)) * V_fac i := by
    intro i
    by_cases hi : i ∈ J_out
    · obtain ⟨_, hθ_ne, hyθ_Vx⟩ := Finset.mem_filter.mp hi
      have hs_ne : (θ i).1 ≠ 0 := fun h0 => hθ_ne (Subtype.ext h0)
      have hvθ_ne : v₁Map (θ i) ≠ 0 := hv₁_ne hθ_ne
      have h_not_inv : (y₀ ^ (q i) / v₁Map (θ i))⁻¹ ∉ Vx := by
        rw [inv_div]
        exact fun h_up => h_mut_excl hs_ne (hq_pos i) hyθ_Vx h_up
      obtain ⟨h1_ne, h1_inv⟩ := h_one_add_unit hyθ_Vx (Or.inr h_not_inv)
      have hp_fac : D.p_val i = v₁Map (θ i) * (1 + y₀ ^ (q i) / v₁Map (θ i)) := by
        rw [hp_recenter i]
        field_simp
        ring
      simp only [V_fac, if_pos hi]
      exact ⟨Vx.toSubring.add_mem Vx.one_mem hyθ_Vx, h1_ne, h1_inv, hp_fac⟩
    · have hy_pow_ne : y₀ ^ (q i) ≠ 0 := pow_ne_zero (q i) hy₀_ne
      have hp_fac : D.p_val i = y₀ ^ (q i) * (1 + v₁Map (θ i) / y₀ ^ (q i)) := by
        rw [hp_recenter i]
        field_simp
      simp only [V_fac, if_neg hi]
      by_cases hθ0 : θ i = 0
      · simp [hθ0, Vx.one_mem, hp_fac]
      · have hyθ_not : y₀ ^ (q i) / v₁Map (θ i) ∉ Vx :=
          fun h_in => hi (Finset.mem_filter.mpr ⟨Finset.mem_univ i, hθ0, h_in⟩)
        have hθy_Vx : v₁Map (θ i) / y₀ ^ (q i) ∈ Vx := by
          have h_inv := (ValuationSubring.mem_or_inv_mem Vx (y₀ ^ (q i) / v₁Map (θ i))).resolve_left hyθ_not
          rwa [inv_div] at h_inv
        have hs_ne : (θ i).1 ≠ 0 := fun h0 => hθ0 (Subtype.ext h0)
        have h_not_inv : (v₁Map (θ i) / y₀ ^ (q i))⁻¹ ∉ Vx := by
          rw [inv_div]
          exact fun h_low => h_mut_excl hs_ne (hq_pos i) h_low hθy_Vx
        obtain ⟨h1_ne, h1_inv⟩ := h_one_add_unit hθy_Vx (Or.inr h_not_inv)
        exact ⟨Vx.toSubring.add_mem Vx.one_mem hθy_Vx, h1_ne, h1_inv, hp_fac⟩
  have hp_prod : ∀ exp : Fin D.M → ℕ,
      (∏ i : Fin D.M, (D.p_val i) ^ (exp i)) =
        v₁Map (∏ i ∈ J_out, (θ i) ^ (exp i)) *
          y₀ ^ (∑ i ∈ J_in, q i * exp i) *
          (∏ i : Fin D.M, (V_fac i) ^ (exp i)) := by
    intro exp
    have h_step1 : (∏ i : Fin D.M, (D.p_val i) ^ (exp i)) =
        (∏ i : Fin D.M, (if i ∈ J_out then v₁Map (θ i) else y₀ ^ (q i)) ^ (exp i)) *
          (∏ i : Fin D.M, (V_fac i) ^ (exp i)) := by
      rw [← Finset.prod_mul_distrib]
      refine Finset.prod_congr rfl (fun i _ => ?_)
      rw [(hV_fac_props i).2.2.2, mul_pow]
    rw [h_step1, ← Finset.prod_sdiff (Finset.subset_univ J_out)]
