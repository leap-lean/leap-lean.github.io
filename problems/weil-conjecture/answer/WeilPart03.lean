        have hft_ev : ∀ t : Fin (N + 1), Polynomial.aeval z₀ (f t) = (u t : F) * D_ev := by
          intro t
          simp only [f, map_mul, map_prod]
          have hprod_eq : Polynomial.aeval z₀ (B_p t) *
              (∏ s ∈ Finset.univ.erase t, Polynomial.aeval z₀ (B_p s)) = D_ev :=
            Finset.mul_prod_erase Finset.univ (fun s => Polynomial.aeval z₀ (B_p s)) (Finset.mem_univ t)
