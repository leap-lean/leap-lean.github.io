    have _ : FiniteDimensional κ_L κ_F := by
      classical
      obtain ⟨S₀, hS₀⟩ := Module.Finite.fg_top (R := ↥OL) (M := ↥OF)
      refine Module.finite_def.mpr ⟨S₀.image (IsLocalRing.residue ↥OF), ?_⟩
      rw [Finset.coe_image]
      refine Submodule.eq_top_iff'.mpr fun x => ?_
      obtain ⟨y, rfl⟩ := IsLocalRing.residue_surjective x
      have hy_mem : y ∈ Submodule.span ↥OL (S₀ : Set ↥OF) := by
        rw [hS₀]
        trivial
