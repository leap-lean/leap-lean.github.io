      · refine ⟨π₁', hπ₁'_ne, hπ₁'_Vx, fun q hq => ?_⟩
        rcases Finset.mem_insert.mp hq with hqp | hq'
        · rw [hqp]
          have hc_val : π₁'.1 = σ.1 * c_div.1 := congrArg Subtype.val hc_div
          have h_eq : (π₁'.1) ^ p.2 / p.1 = ((σ.1) ^ p.2 / p.1) * (c_div.1) ^ p.2 := by
