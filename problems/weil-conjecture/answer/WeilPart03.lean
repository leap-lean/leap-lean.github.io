      · intro r; exact ⟨r, rfl⟩
      · intro f g hf hg; rw [map_add]; exact α.range.add_mem hf hg
      · intro n r ih; rw [pow_succ, ← mul_assoc, map_mul]; exact α.range.mul_mem ih hX_range
    exact ⟨hsurj, hker⟩
  
  have hBlowupRingPkg : ∀ (B : Type u) [CommRing B] (s c π : B), IsUnit s →
