      have hqbar_le_Q''bar : q_bar ≤ Q''_bar := by
        by_contra hnot_le
        obtain ⟨z, hz_qbar, hz_not_Q''⟩ := SetLike.not_le_iff_exists.mp hnot_le
        have hez : e₀ * z ∈ Q''_bar := by rw [he₀_ann z hz_qbar]; exact Q''_bar.zero_mem
        have he₀_mem : e₀ ∈ Q''_bar :=
          ‹Q''_bar.IsPrime›.mem_or_mem hez |>.resolve_right hz_not_Q''
        have hθ₀_bar : q_F θ₀ ∈ Q''_bar := by
          change q_F (r_α * r_e) ∈ Q''_bar
          rw [map_mul, hr_e]
          exact Q''_bar.mul_mem_left _ he₀_mem
        have hθ₀_Q'' : θ₀ ∈ Q'' := (SetLike.ext_iff.mp hcomap_Q''bar θ₀).mp hθ₀_bar
