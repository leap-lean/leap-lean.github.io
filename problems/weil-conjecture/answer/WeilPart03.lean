          _ = V.ofPrime P := hOfPrimeCongr (V.idealOfLE U hVU) hIdeal
      refine ⟨hComap, ?_, ?_⟩
      · intro s₀ hs₀
        have hnot : (⟨φ_KF (V.subtype s₀), hV s₀⟩ : ↥W) ∉ IsLocalRing.maximalIdeal ↥W :=
          mt (hCenter s₀).mp hs₀
        rw [ValuationSubring.valuation_lt_one_iff, not_lt] at hnot
        exact le_antisymm (ValuationSubring.valuation_le_one W ⟨φ_KF (V.subtype s₀), hV s₀⟩) hnot
      · intro Q hQ
        let e : ↥W := Polynomial.eval₂ ((φ_KF.comp V.subtype).codRestrict W.toSubring hV) ⟨t, ht⟩ Q
        have hnot : e ∉ IsLocalRing.maximalIdeal ↥W := hPoly Q hQ
        rw [ValuationSubring.valuation_lt_one_iff, not_lt] at hnot
        have hval1 : W.valuation (e : F_ss) = 1 :=
          le_antisymm (ValuationSubring.valuation_le_one W e) hnot
        have he_val : (e : F_ss) = Polynomial.eval₂ (φ_KF.comp V.subtype) t Q := by
          have h1 := Polynomial.hom_eval₂ Q ((φ_KF.comp V.subtype).codRestrict W.toSubring hV)
            W.subtype ⟨t, ht⟩
          have hcomp : W.subtype.comp ((φ_KF.comp V.subtype).codRestrict W.toSubring hV) =
              φ_KF.comp V.subtype := RingHom.ext fun _ => rfl
          rw [hcomp] at h1
          exact h1
        rw [← he_val, hval1]
    
    have hGaussPoly : ∀ (R : Polynomial K), R ≠ 0 →
        ∃ i₀ ∈ R.support, ∀ W ∈ S_Pt,
          W.valuation (Polynomial.aeval t R) = W.valuation (φ_KF (R.coeff i₀)) := by
      intro R hR
      have hRsupp : R.support.Nonempty := Polynomial.support_nonempty.mpr hR
      obtain ⟨i₀, s₀, b, hi₀S, hs₀_notMem, hbi₀, hb_eq⟩ :=
        hClear P R.support hRsupp (fun i => R.coeff i)
          (fun i hi => Polynomial.mem_support_iff.mp hi)
      let Q₀ : Polynomial ↥V := ∑ i ∈ R.support, Polynomial.monomial i (b i)
      have hQ₀_coeff : Q₀.coeff i₀ = s₀ := by
        rw [Polynomial.finsetSum_coeff]
        simp only [Polynomial.coeff_monomial]
        rw [Finset.sum_ite_eq']
        simp only [hi₀S, ↓reduceIte, hbi₀]
      have hQ₀_prim : ∃ i : ℕ, Q₀.coeff i ∉ P := ⟨i₀, hQ₀_coeff ▸ hs₀_notMem⟩
      have hIdent : φ_KF (R.coeff i₀) * Polynomial.eval₂ (φ_KF.comp V.subtype) t Q₀ =
          φ_KF (V.subtype s₀) * Polynomial.aeval t R := by
        have h1 : Polynomial.eval₂ (φ_KF.comp V.subtype) t Q₀ =
            ∑ i ∈ R.support, φ_KF (V.subtype (b i)) * t ^ i := by
          dsimp only [Q₀]
          rw [Polynomial.eval₂_finsetSum]
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [Polynomial.eval₂_monomial, RingHom.comp_apply]
        have h2 : Polynomial.aeval t R =
            ∑ i ∈ R.support, φ_KF (R.coeff i) * t ^ i := by
          conv_lhs => rw [Polynomial.as_sum_support R]
          rw [Polynomial.aeval_def, hAlgMap_eq, Polynomial.eval₂_finsetSum]
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [Polynomial.eval₂_monomial]
        rw [h1, h2, Finset.mul_sum, Finset.mul_sum]
        refine Finset.sum_congr rfl fun i hi => ?_
        rw [← mul_assoc, ← map_mul, hb_eq i hi, map_mul, mul_assoc]
      refine ⟨i₀, hi₀S, ?_⟩
      intro W hW
      obtain ⟨_, hs₀_val, hQ_val⟩ := hComap_and_Gauss W hW
      have hv := congrArg W.valuation hIdent
      rw [map_mul, map_mul, hQ_val Q₀ hQ₀_prim, hs₀_val s₀ hs₀_notMem, mul_one, one_mul] at hv
      exact hv.symm
    by_cases hne : S_Pt.Nonempty
    · obtain ⟨W₀, hW₀⟩ := hne
      have ht_trans : Transcendental K t := by
        rintro ⟨R, hR, hEval⟩
        obtain ⟨i₀, hi₀S, hWval⟩ := hGaussPoly R hR
        have hc₀ : R.coeff i₀ ≠ 0 := Polynomial.mem_support_iff.mp hi₀S
        have hφc₀ : φ_KF (R.coeff i₀) ≠ 0 :=
          map_ne_zero_of_mem_nonZeroDivisors φ_KF φ_KF.injective (mem_nonZeroDivisors_of_ne_zero hc₀)
        have hv := hWval W₀ hW₀
        rw [hEval, map_zero] at hv
        exact hφc₀ ((Valuation.zero_iff W₀.valuation).mp hv.symm)
      let L_t : IntermediateField K F_ss := IntermediateField.adjoin K ({t} : Set F_ss)
      let V₀ : ValuationSubring ↥L_t := W₀.comap (algebraMap ↥L_t F_ss)
      have hUniq : ∀ W ∈ S_Pt, W.comap (algebraMap ↥L_t F_ss) = V₀ := by
        intro W hW
        ext z
        obtain ⟨R₁, R₂, hz_eq⟩ :=
          (IntermediateField.mem_adjoin_simple_iff K (z : F_ss)).mp z.2
        change (z : F_ss) ∈ W ↔ (z : F_ss) ∈ W₀
        by_cases hR0 : R₁ = 0 ∨ R₂ = 0
        · rcases hR0 with rfl | rfl
          · simp [hz_eq, W.zero_mem, W₀.zero_mem]
          · simp [hz_eq, W.zero_mem, W₀.zero_mem]
        · rw [not_or] at hR0
          obtain ⟨hR₁, hR₂⟩ := hR0
          obtain ⟨i₁, _, hval₁⟩ := hGaussPoly R₁ hR₁
          obtain ⟨i₂, _, hval₂⟩ := hGaussPoly R₂ hR₂
          have hmem_iff : ∀ W' ∈ S_Pt, (z : F_ss) ∈ W' ↔
              R₁.coeff i₁ / R₂.coeff i₂ ∈ V.ofPrime P := by
            intro W' hW'
            rw [← ValuationSubring.valuation_le_one_iff, hz_eq, map_div₀,
              hval₁ W' hW', hval₂ W' hW', ← map_div₀, ← map_div₀ φ_KF,
              ValuationSubring.valuation_le_one_iff, ← ValuationSubring.mem_comap,
              (hComap_and_Gauss W' hW').1]
          rw [hmem_iff W hW, hmem_iff W₀ hW₀]
      
      let t_L : ↥L_t := ⟨t, IntermediateField.mem_adjoin_simple_self K t⟩
      have ht_L : Transcendental K t_L := by
        rintro ⟨R, hR, hEval⟩
        apply ht_trans ⟨R, hR, ?_⟩
        have h1 := congrArg L_t.val hEval
        rw [← Polynomial.aeval_algHom_apply, map_zero] at h1
        exact h1
      have hInd : AlgebraicIndependent K ![t_L] :=
        algebraicIndependent_iff_transcendental.mpr ht_L
      have h1 : (1 : Cardinal.{u}) ≤ Algebra.trdeg K ↥L_t := by
        simpa using AlgebraicIndependent.lift_cardinalMk_le_trdeg hInd
      have hAdd : Algebra.trdeg K ↥L_t + Algebra.trdeg ↥L_t F_ss = Algebra.trdeg K F_ss :=
        trdeg_add_eq K ↥L_t
      have h0 : Algebra.trdeg ↥L_t F_ss = 0 := by
        by_contra hb
        have hb1 : (1 : Cardinal.{u}) ≤ Algebra.trdeg ↥L_t F_ss :=
          Cardinal.one_le_iff_ne_zero.mpr hb
        have h2 : ((2 : ℕ) : Cardinal.{u}) ≤ ((1 : ℕ) : Cardinal.{u}) := by
          calc ((2 : ℕ) : Cardinal.{u}) = 1 + 1 := by norm_num
            _ ≤ Algebra.trdeg K ↥L_t + Algebra.trdeg ↥L_t F_ss := add_le_add h1 hb1
            _ = Algebra.trdeg K F_ss := hAdd
            _ ≤ 1 := hTr
            _ = ((1 : ℕ) : Cardinal.{u}) := by norm_num
        exact absurd (Nat.cast_le.mp h2) (by omega)
      have : Algebra.IsAlgebraic ↥L_t F_ss := trdeg_eq_zero_iff.mp h0
      have : Algebra.EssFiniteType ↥L_t F_ss := Algebra.EssFiniteType.of_comp K ↥L_t F_ss
      have : FiniteDimensional ↥L_t F_ss := Algebra.finite_of_essFiniteType_of_isAlgebraic
      obtain ⟨hExtFin, hExtAnti⟩ := hKrullPrufer ↥L_t F_ss V₀
      refine ⟨hExtFin.subset fun W hW => hUniq W hW, ?_⟩
      intro W₁ hW₁ W₂ hW₂ hle
      exact hExtAnti W₁ (hUniq W₁ hW₁) W₂ (hUniq W₂ hW₂) hle
    · have hEmpty : S_Pt = ∅ := Set.not_nonempty_iff_eq_empty.mp hne
      rw [hEmpty]
      exact ⟨Set.finite_empty, fun _ h => False.elim h⟩
  · 
    rintro W hV P _ _hCenter ⟨t₁, t₂, hNoMem⟩
    let x : Fin 2 → F_ss := ![t₁.1, t₂.1]
    have hNotInd : ¬ AlgebraicIndependent K x := by
      intro hInd
      have h := AlgebraicIndependent.lift_cardinalMk_le_trdeg hInd
      simp only [Cardinal.mk_fintype, Fintype.card_fin, Nat.cast_ofNat, Cardinal.lift_ofNat,
        Cardinal.lift_uzero] at h
      have h2 : ((2 : ℕ) : Cardinal.{u}) ≤ ((1 : ℕ) : Cardinal.{u}) := by
        calc ((2 : ℕ) : Cardinal.{u}) = 2 := by norm_num
          _ ≤ Algebra.trdeg K F_ss := h
          _ ≤ 1 := hTr
          _ = ((1 : ℕ) : Cardinal.{u}) := by norm_num
      exact absurd (Nat.cast_le.mp h2) (by omega)
    rw [AlgebraicIndependent, injective_iff_map_eq_zero] at hNotInd
    simp only [not_forall] at hNotInd
    obtain ⟨Q_K, hQK_zero, hQK_ne⟩ := hNotInd
    have hQK_supp : Q_K.support.Nonempty := MvPolynomial.support_nonempty.mpr hQK_ne
    obtain ⟨d₀, s₀, b, hd₀S, hs₀_notMem, hbd₀, hb_eq⟩ :=
      hClear P Q_K.support hQK_supp (fun d => Q_K.coeff d)
        (fun d hd => MvPolynomial.mem_support_iff.mp hd)
    let Q : MvPolynomial (Fin 2) ↥V := ∑ d ∈ Q_K.support, MvPolynomial.monomial d (b d)
    have hQ_coeff : Q.coeff d₀ = s₀ := by
      rw [MvPolynomial.coeff_sum]
      simp only [MvPolynomial.coeff_monomial]
      rw [Finset.sum_ite_eq']
      simp only [hd₀S, ↓reduceIte, hbd₀]
    have hQ_prim : ∃ d : Fin 2 →₀ ℕ, Q.coeff d ∉ P := ⟨d₀, hQ_coeff ▸ hs₀_notMem⟩
    have hIdent : φ_KF (Q_K.coeff d₀) * MvPolynomial.eval₂ (φ_KF.comp V.subtype) x Q =
        φ_KF (V.subtype s₀) * MvPolynomial.aeval x Q_K := by
      have h1 : MvPolynomial.eval₂ (φ_KF.comp V.subtype) x Q =
          ∑ d ∈ Q_K.support, φ_KF (V.subtype (b d)) * d.prod (fun k e => x k ^ e) := by
        dsimp only [Q]
        rw [MvPolynomial.eval₂_sum]
        refine Finset.sum_congr rfl fun d _ => ?_
        rw [MvPolynomial.eval₂_monomial, RingHom.comp_apply]
      have h2 : MvPolynomial.aeval x Q_K =
          ∑ d ∈ Q_K.support, φ_KF (Q_K.coeff d) * d.prod (fun k e => x k ^ e) := by
        conv_lhs => rw [MvPolynomial.as_sum Q_K]
        rw [MvPolynomial.aeval_def, hAlgMap_eq, MvPolynomial.eval₂_sum]
        refine Finset.sum_congr rfl fun d _ => ?_
        rw [MvPolynomial.eval₂_monomial]
      rw [h1, h2, Finset.mul_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl fun d hd => ?_
      rw [← mul_assoc, ← map_mul, hb_eq d hd, map_mul, mul_assoc]
    rw [hQK_zero, mul_zero] at hIdent
    have hc₀ : Q_K.coeff d₀ ≠ 0 := MvPolynomial.mem_support_iff.mp hd₀S
    have hφc₀ : φ_KF (Q_K.coeff d₀) ≠ 0 :=
      map_ne_zero_of_mem_nonZeroDivisors φ_KF φ_KF.injective (mem_nonZeroDivisors_of_ne_zero hc₀)
    have hEvalZero : MvPolynomial.eval₂ (φ_KF.comp V.subtype) x Q = 0 :=
      (mul_eq_zero.mp hIdent).resolve_left hφc₀
    let e : ↥W :=
      MvPolynomial.eval₂ ((φ_KF.comp V.subtype).codRestrict W.toSubring hV) ![t₁, t₂] Q
    have he_zero : e = 0 := by
      apply Subtype.ext
      have hhom := MvPolynomial.hom_eval₂ Q ((φ_KF.comp V.subtype).codRestrict W.toSubring hV)
        W.subtype ![t₁, t₂]
      have hcomp : W.subtype.comp ((φ_KF.comp V.subtype).codRestrict W.toSubring hV) =
          φ_KF.comp V.subtype := RingHom.ext fun _ => rfl
      have hvec : (fun i => W.subtype (![t₁, t₂] i)) = x := by
        funext i
        fin_cases i <;> rfl
      change W.subtype e = 0
      rw [hhom, hcomp, hvec, hEvalZero]
    have he_mem : e ∈ IsLocalRing.maximalIdeal ↥W := he_zero ▸ Ideal.zero_mem _
    exact hNoMem Q hQ_prim he_mem

theorem weil_strictlySemistable_generic_funcField_and_gammaZero_exhaustion (K : Type u) [Field K] (m : ℕ)
    (V : ValuationSubring K)
    (hPkg : IsValuationRingAlgPackage m V)
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (n : ℕ)
    (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (hIntCK : AlgebraicGeometry.IsIntegral C_K)
    (hSmCK : AlgebraicGeometry.SmoothOfRelativeDimension 1 p_K)
    (hStabCK : IsGeometricStablePointedCurve p_K n σ_K)
    (C' : AlgebraicGeometry.Scheme.{u})
    (g' : C' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (τ' : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C'))
    (ι' : C_K ⟶ C')
    (hMod' : IsValuationPointedCurveModel V p_K n σ_K C' g' τ' ι')
    (U' : C'.Opens)
    (hU' : Nonempty ↥U')
    (U_ss : AlgebraicGeometry.Scheme.{u})
    (g_ss : U_ss ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (hAff_ss : AlgebraicGeometry.IsAffine U_ss)
    (hSS : IsStrictlySemistableCurveOverValuation V g_ss)
    (h_mod : U'.toScheme ⟶ U_ss)
    (hProp_mod : AlgebraicGeometry.IsProper h_mod)
    (hComm_mod : h_mod ≫ g_ss = U'.ι ≫ g')
    (ι_U' : AlgebraicGeometry.Scheme.Opens.toScheme
      ((TopologicalSpace.Opens.map ι'.base).obj U') ⟶ U'.toScheme)
    (hPb_U' : CategoryTheory.IsPullback ι_U'
      (AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj U') ≫ p_K)
      (U'.ι ≫ g')
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (hPb_ss : CategoryTheory.IsPullback (ι_U' ≫ h_mod)
      (AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj U') ≫ p_K)
      g_ss
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (hOpenη : AlgebraicGeometry.IsOpenImmersion
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (F_ss : Type u) [Field F_ss]
    (η_ss : AlgebraicGeometry.Spec (CommRingCat.of F_ss) ⟶ U_ss)
    (hFunc_ss : IsSchemeFunctionField U_ss F_ss η_ss)
    (hGaussFin : ∀ (φ_KF : K →+* F_ss),
      (letI : Algebra K F_ss := φ_KF.toAlgebra
       Algebra.EssFiniteType K F_ss ∧ Algebra.trdeg K F_ss ≤ 1) →
      ∀ (P : Ideal ↥V) [P.IsPrime] (t : F_ss),
        let S_Pt : Set (ValuationSubring F_ss) :=
          {W : ValuationSubring F_ss |
            ∃ (hV : ∀ c : ↥V, φ_KF (V.subtype c) ∈ W) (ht : t ∈ W),
              (∀ c : ↥V,
                ((⟨φ_KF (V.subtype c), hV c⟩ : ↥W) ∈ IsLocalRing.maximalIdeal ↥W ↔ c ∈ P)) ∧
              (∀ Q : Polynomial ↥V,
                (∃ i : ℕ, Q.coeff i ∉ P) →
                Polynomial.eval₂ ((φ_KF.comp V.subtype).codRestrict W.toSubring hV) ⟨t, ht⟩ Q ∉
                  IsLocalRing.maximalIdeal ↥W)}
        S_Pt.Finite ∧ (∀ W₁ ∈ S_Pt, ∀ W₂ ∈ S_Pt, W₁ ≤ W₂ → W₁ = W₂)) :
    let U_K : C_K.Opens := (TopologicalSpace.Opens.map ι'.base).obj U'
    ∃ (η_UK : AlgebraicGeometry.Spec (CommRingCat.of F_ss) ⟶ U_K.toScheme)
      (φ_KF : K →+* F_ss)
      (r_val : ℕ)
      (W_list : Fin r_val → ValuationSubring F_ss),
      Nonempty ↥U_K ∧
      η_UK ≫ ι_U' ≫ h_mod = η_ss ∧
      IsSchemeFunctionField U_K.toScheme F_ss η_UK ∧
      IsSchemeFunctionField U'.toScheme F_ss (η_UK ≫ ι_U') ∧
      (∀ c : ↥V,
        φ_KF (V.subtype c) = (AlgebraicGeometry.Spec.preimage (η_ss ≫ g_ss)).hom c) ∧
      (letI : Algebra K F_ss := φ_KF.toAlgebra
       Algebra.EssFiniteType K F_ss ∧ Algebra.trdeg K F_ss ≤ 1) ∧
      (∀ i : Fin r_val, IsDivisorialClosedVal V g_ss η_ss (W_list i)) ∧
      (∀ W : ValuationSubring F_ss,
        IsDivisorialClosedVal V g_ss η_ss W →
        IsValResolvedOnMod V g_ss h_mod (η_UK ≫ ι_U') W →
        ∃ i : Fin r_val, W = W_list i) :=
by
  intro U_K
  obtain ⟨hIntC', _, _, hLFP_g', _, _, _, hPb_gen, _⟩ := hMod'
  have hFinSpec : Set.Finite (Set.univ : Set (PrimeSpectrum ↥V)) := hPkg.1
  have hFrac_equiv : ∀ {A B F : Type u} [CommRing A] [CommRing B] [Field F]
      (e : A ≃+* B) (φ_B : B →+* F),
      @IsFractionRing B _ F _ φ_B.toAlgebra →
      @IsFractionRing A _ F _ (φ_B.comp e.toRingHom).toAlgebra := by
    intro A B F _ _ _ e φ_B hFrac
    letI : Algebra B F := φ_B.toAlgebra
    letI : Algebra A F := (φ_B.comp e.toRingHom).toAlgebra
    have hφB_inj : Function.Injective φ_B :=
      @IsLocalization.injective B _ (nonZeroDivisors B) F _ _ hFrac le_rfl
    have hNontrivB : Nontrivial B := by
      refine ⟨⟨0, 1, fun h01 => zero_ne_one (α := F) ?_⟩⟩
      simpa using congrArg φ_B h01
    haveI hNontrivA : Nontrivial A := by
      refine ⟨⟨0, 1, fun h01 => zero_ne_one (α := B) ?_⟩⟩
      simpa using congrArg e h01
    refine { map_units := ?_, surj := ?_, exists_of_eq := ?_ }
    · intro y
      have hy0 : y.1 ≠ 0 := nonZeroDivisors.ne_zero y.2
      have hey0 : e y.1 ≠ 0 := fun h => hy0 (e.injective (by simpa using h))
      have hφ0 : φ_B (e y.1) ≠ 0 := fun h => hey0 (hφB_inj (by simpa using h))
      exact isUnit_iff_ne_zero.mpr hφ0
    · intro z
      obtain ⟨⟨b, s⟩, hzs⟩ := @IsLocalization.surj B _ (nonZeroDivisors B) F _ _ hFrac z
      have hs_mem : e.symm s.1 ∈ nonZeroDivisors A := by
        rw [mem_nonZeroDivisors_iff]
        have hs_iff := mem_nonZeroDivisors_iff.mp s.2
        refine ⟨fun x hx => ?_, fun x hx => ?_⟩
        · have hex : s.1 * e x = 0 := by
            calc s.1 * e x = e (e.symm s.1) * e x := by rw [e.apply_symm_apply]
              _ = e (e.symm s.1 * x) := (map_mul e _ x).symm
              _ = 0 := by rw [hx, map_zero]
          exact e.injective (by simpa using hs_iff.1 (e x) hex)
        · have hex : e x * s.1 = 0 := by
            calc e x * s.1 = e x * e (e.symm s.1) := by rw [e.apply_symm_apply]
              _ = e (x * e.symm s.1) := (map_mul e x _).symm
              _ = 0 := by rw [hx, map_zero]
          exact e.injective (by simpa using hs_iff.2 (e x) hex)
      refine ⟨⟨e.symm b, ⟨e.symm s.1, hs_mem⟩⟩, ?_⟩
      change z * φ_B (e (e.symm s.1)) = φ_B (e (e.symm b))
      rw [e.apply_symm_apply, e.apply_symm_apply]
      exact hzs
    · intro x y hxy
      have hxy' : x = y := e.injective (hφB_inj hxy)
      exact ⟨⟨1, Submonoid.one_mem _⟩, by simp [hxy']⟩
  have hFrac_away : ∀ {R S F : Type u} [CommRing R] [IsDomain R]
      (r : R), r ≠ 0 → ∀ [CommRing S] (res : R →+* S),
      @IsLocalization.Away R _ r S _ res.toAlgebra →
      ∀ [Field F] (φ_S : S →+* F),
      @IsFractionRing S _ F _ φ_S.toAlgebra →
      @IsFractionRing R _ F _ (φ_S.comp res).toAlgebra := by
    intro R S F _ _ r hr _ res hLoc _ φ_S hFrac
    letI : Algebra R S := res.toAlgebra
    letI : Algebra S F := φ_S.toAlgebra
    letI : Algebra R F := (φ_S.comp res).toAlgebra
    have hφS_inj : Function.Injective φ_S :=
      @IsLocalization.injective S _ (nonZeroDivisors S) F _ _ hFrac le_rfl
    haveI hNontrivS : Nontrivial S := by
      refine ⟨⟨0, 1, fun h01 => zero_ne_one (α := F) ?_⟩⟩
      simpa using congrArg φ_S h01
    have hres_inj : Function.Injective res := by
      intro x y hxy
      obtain ⟨⟨_, k, rfl⟩, hk⟩ :=
        (@IsLocalization.eq_iff_exists R _ (Submonoid.powers r) S _ _ hLoc).mp hxy
      exact mul_left_cancel₀ (pow_ne_zero k hr) hk
    have hφR_inj : Function.Injective (φ_S.comp res) := hφS_inj.comp hres_inj
    refine { map_units := ?_, surj := ?_, exists_of_eq := ?_ }
    · intro y
      have hy0 : y.1 ≠ 0 := nonZeroDivisors.ne_zero y.2
      exact isUnit_iff_ne_zero.mpr (fun h => hy0 (hφR_inj (h.trans (map_zero _).symm)))
    · intro z
