      simp only [CategoryTheory.Category.assoc]
      rw [CategoryTheory.Limits.pullback.lift_fst,
        ← CategoryTheory.Category.assoc (AlgebraicGeometry.pullbackSpecIso A_ss B_1 B_X).inv,
        AlgebraicGeometry.pullbackSpecIso_inv_fst A_ss B_1 B_X,
        ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
    have hsnd_appLE : snd_P.appLE U_X W_P w_X =
        CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom ≫ θ_hom := by
      apply AlgebraicGeometry.Spec.map_injective
      apply (cancel_mono hUX.fromSpec).mp
      rw [AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec snd_P hUX hWP w_X,
        ← hSpec_θ]
      dsimp only [j_T, ι_Q, snd_P, e_T, f_1, f_X]
      simp only [CategoryTheory.Category.assoc]
      rw [CategoryTheory.Limits.pullback.lift_snd,
        ← CategoryTheory.Category.assoc (AlgebraicGeometry.pullbackSpecIso A_ss B_1 B_X).inv,
        AlgebraicGeometry.pullbackSpecIso_inv_snd A_ss B_1 B_X,
        ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
      rfl
    have hπ1_appLE : π_1.appLE U_1 V_C e_1 = fst_P.appLE U_1 W_P w_1 ≫ j_C.app W_P := by
      rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE,
        AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE j_C fst_P U_1 W_P V_C w_1 (le_refl V_C)]
    have hf'_appLE : f'.appLE U_X V_C e_X = snd_P.appLE U_X W_P w_X ≫ j_C.app W_P := by
      rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE,
        AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE j_C snd_P U_X W_P V_C w_X (le_refl V_C)]
    let Ψ : TensorProduct A_ss B_1 B_X →+* ↑(C_bar.presheaf.obj (Opposite.op V_C)) :=
      (θ_hom ≫ j_C.app W_P).hom
    have hSurj_jC : Function.Surjective (j_C.app W_P).hom :=
      AlgebraicGeometry.Scheme.Hom.app_surjective j_C W_P hWP
    have hSurj_θ : Function.Surjective θ_hom.hom :=
      fun y => ⟨θ_inv.hom y, congrArg (fun f => f.hom y) hθ_id⟩
    have hSurj_Ψ : Function.Surjective Ψ := hSurj_jC.comp hSurj_θ
    let β := (π_1.appLE U_1 V_C e_1).hom
    let α := (f'.appLE U_X V_C e_X).hom
    have hβ_eq : ∀ b₁ : B_1, β b₁ = Ψ (b₁ ⊗ₜ[A_ss] (1 : B_X)) := by
      intro b₁
      change (π_1.appLE U_1 V_C e_1).hom b₁ = _
      rw [hπ1_appLE, hfst_appLE]
      rfl
    have hα_eq : ∀ b_X : B_X, α b_X = Ψ ((1 : B_1) ⊗ₜ[A_ss] b_X) := by
      intro b_X
      change (f'.appLE U_X V_C e_X).hom b_X = _
      rw [hf'_appLE, hsnd_appLE]
      rfl
    let S := Subring.closure (Set.range β ∪ Set.range α)
    have hΨ_mem : ∀ t : TensorProduct A_ss B_1 B_X, Ψ t ∈ S := by
      intro t
      induction t using TensorProduct.induction_on with
      | zero =>
        rw [map_zero]
        exact S.zero_mem
      | tmul b₁ b_X =>
        have hmul : (b₁ ⊗ₜ[A_ss] b_X) = (b₁ ⊗ₜ[A_ss] (1 : B_X)) * ((1 : B_1) ⊗ₜ[A_ss] b_X) := by
          rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
        rw [hmul, map_mul, ← hβ_eq, ← hα_eq]
        exact S.mul_mem
          (Subring.subset_closure (Or.inl ⟨b₁, rfl⟩))
          (Subring.subset_closure (Or.inr ⟨b_X, rfl⟩))
      | add x y hx hy =>
        rw [map_add]
        exact S.add_mem hx hy
    rw [eq_top_iff]
    intro c _
    obtain ⟨t, rfl⟩ := hSurj_Ψ c
    exact hΨ_mem t
  exact ⟨C_bar, π_1, f', η_C, q_K, hIntC, hDomC, hFuncC, hFuncX, hProp_f',
    hSq, hηC_π1, hηC_f', hqK_π1, hqK_f', hGenSub, hCover⟩

theorem weil_birational_proper_iso_of_locallyQuasiFinite_normal (C_bar X : AlgebraicGeometry.Scheme.{u})
    (F_ss : Type u) [Field F_ss]
    (f' : C_bar ⟶ X)
    (η_C : AlgebraicGeometry.Spec (CommRingCat.of F_ss) ⟶ C_bar)
    (η_X : AlgebraicGeometry.Spec (CommRingCat.of F_ss) ⟶ X)
    (hIntC : AlgebraicGeometry.IsIntegral C_bar)
    (hIntX : AlgebraicGeometry.IsIntegral X)
    (hNormX : IsAffineNormalScheme X)
    (hProp : AlgebraicGeometry.IsProper f')
    (hDomC : AlgebraicGeometry.IsDominant η_C)
    (hη : η_C ≫ f' = η_X)
    (hFuncC : IsSchemeFunctionField C_bar F_ss η_C)
    (hFuncX : IsSchemeFunctionField X F_ss η_X)
    (hLocQF : ∀ z : C_bar,
      ∃ (U_X : X.Opens) (_ : AlgebraicGeometry.IsAffineOpen U_X)
        (V_C : C_bar.Opens) (_ : AlgebraicGeometry.IsAffineOpen V_C)
        (e_X : V_C ≤ (TopologicalSpace.Opens.map f'.base).obj U_X),
        z ∈ V_C ∧
        (f'.appLE U_X V_C e_X).hom.FiniteType ∧
        (f'.appLE U_X V_C e_X).hom.QuasiFinite) :
    CategoryTheory.IsIso f' :=
by
  have : AlgebraicGeometry.IsIntegral C_bar := hIntC
  have _ : AlgebraicGeometry.IsIntegral X := hIntX
  have : AlgebraicGeometry.IsProper f' := hProp
  have : AlgebraicGeometry.IsDominant η_C := hDomC
  have : AlgebraicGeometry.IsSeparated f' := hProp.toIsSeparated
  have : AlgebraicGeometry.UniversallyClosed f' := hProp.toUniversallyClosed
  have : Unique ↥(AlgebraicGeometry.Spec (CommRingCat.of F_ss)) := PrimeSpectrum.instUnique
  have hη_mem : ∀ (O : C_bar.Opens), Nonempty ↥O →
      Set.range ⇑η_C.base ⊆ Set.range ⇑O.ι.base := by
    intro O ⟨⟨y₀, hy₀⟩⟩
    rw [O.range_ι]
    obtain ⟨w, hwO, pt₀, hpt₀⟩ :=
      hDomC.denseRange.inter_open_nonempty (O : Set ↥C_bar) O.isOpen ⟨y₀, hy₀⟩
    rintro _ ⟨pt, rfl⟩
    rw [Subsingleton.elim pt pt₀]
    exact hpt₀.symm ▸ hwO
  have hLocal : ∀ z : C_bar,
      ∃ W : C_bar.Opens, z ∈ W ∧ AlgebraicGeometry.IsOpenImmersion (W.ι ≫ f') := by
    intro z
    obtain ⟨U_X, hUX, V_C, hVC, e_X, hz, hFT, hQF⟩ := hLocQF z
    have hVC_ne : Nonempty ↥V_C := ⟨⟨z, hz⟩⟩
    have hUX_ne : Nonempty ↥U_X := ⟨⟨f'.base z, e_X hz⟩⟩
    let B_X := ↑(X.presheaf.obj (Opposite.op U_X))
    let B_C := ↑(C_bar.presheaf.obj (Opposite.op V_C))
    let α : B_X →+* B_C := (f'.appLE U_X V_C e_X).hom
    obtain ⟨hDom_BX, hIC_BX⟩ := hNormX U_X hUX hUX_ne
    have : IsDomain B_X := hDom_BX
    have : IsIntegrallyClosed B_X := hIC_BX
    have : IsDomain B_C := @AlgebraicGeometry.IsIntegral.component_integral C_bar hIntC V_C hVC_ne
    obtain ⟨φ_X, hFracX, hφ_X⟩ := hFuncX U_X hUX hUX_ne
    obtain ⟨φ_C, hFracC, hφ_C⟩ := hFuncC V_C hVC hVC_ne
    have hInjC : Function.Injective φ_C.hom := by
      let : Algebra B_C F_ss := φ_C.hom.toAlgebra
      exact @IsFractionRing.injective B_C _ F_ss _ _ hFracC
    have hInjX : Function.Injective φ_X.hom := by
      let : Algebra B_X F_ss := φ_X.hom.toAlgebra
      exact @IsFractionRing.injective B_X _ F_ss _ _ hFracX
    have hCompat_φ : φ_C.hom.comp α = φ_X.hom := by
      have hSpec_comp :
          AlgebraicGeometry.Spec.map (f'.appLE U_X V_C e_X ≫ φ_C) ≫ hUX.fromSpec =
            AlgebraicGeometry.Spec.map φ_X ≫ hUX.fromSpec := by
        calc
          AlgebraicGeometry.Spec.map (f'.appLE U_X V_C e_X ≫ φ_C) ≫ hUX.fromSpec
            = (AlgebraicGeometry.Spec.map φ_C ≫
                AlgebraicGeometry.Spec.map (f'.appLE U_X V_C e_X)) ≫ hUX.fromSpec := by
              rw [AlgebraicGeometry.Spec.map_comp]
          _ = AlgebraicGeometry.Spec.map φ_C ≫
                (AlgebraicGeometry.Spec.map (f'.appLE U_X V_C e_X) ≫ hUX.fromSpec) := by
              rw [CategoryTheory.Category.assoc]
          _ = AlgebraicGeometry.Spec.map φ_C ≫ (hVC.fromSpec ≫ f') := by
              rw [AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec f' hUX hVC e_X]
          _ = (AlgebraicGeometry.Spec.map φ_C ≫ hVC.fromSpec) ≫ f' := by
              rw [CategoryTheory.Category.assoc]
          _ = η_C ≫ f' := by rw [hφ_C]
          _ = η_X := hη
          _ = AlgebraicGeometry.Spec.map φ_X ≫ hUX.fromSpec := hφ_X.symm
      have hSpec_eq :
          AlgebraicGeometry.Spec.map (f'.appLE U_X V_C e_X ≫ φ_C) =
            AlgebraicGeometry.Spec.map φ_X :=
        (CategoryTheory.cancel_mono hUX.fromSpec).mp hSpec_comp
      have hHom := congrArg AlgebraicGeometry.Spec.preimage hSpec_eq
      rw [AlgebraicGeometry.Spec.preimage_map, AlgebraicGeometry.Spec.preimage_map] at hHom
      exact congrArg CommRingCat.Hom.hom hHom
    have hInj_α : Function.Injective α := by
      have h : Function.Injective (φ_C.hom.comp α) := by
        rw [hCompat_φ]
        exact hInjX
      exact Function.Injective.of_comp h
    have hIntDesc : ∀ y : B_C, α.IsIntegralElem y → ∃ x₀ : B_X, α x₀ = y := by
      intro y hy
      have hyF : (φ_C.hom.comp α).IsIntegralElem (φ_C.hom y) := hy.map φ_C.hom
      rw [hCompat_φ] at hyF
      let : Algebra B_X F_ss := φ_X.hom.toAlgebra
      have : IsFractionRing B_X F_ss := hFracX
      have hyInt : @IsIntegral B_X F_ss _ _ φ_X.hom.toAlgebra (φ_C.hom y) := hyF
      obtain ⟨x₀, hx₀⟩ := (isIntegrallyClosed_iff F_ss).mp hIC_BX hyInt
      refine ⟨x₀, hInjC ?_⟩
      change (φ_C.hom.comp α) x₀ = φ_C.hom y
      rw [hCompat_φ]
      exact hx₀
    let : Algebra B_X B_C := α.toAlgebra
    have : Algebra.FiniteType B_X B_C := hFT
    have : Algebra.QuasiFinite B_X B_C := RingHom.QuasiFinite.toAlgebra hQF
    let q : PrimeSpectrum B_C := hVC.primeIdealOf ⟨z, hz⟩
    have : q.asIdeal.IsPrime := q.isPrime
    have hZMT := (Algebra.zariskisMainProperty_iff (R := B_X) (p := q.asIdeal)).mp
      (Algebra.ZariskisMainProperty.of_finiteType (R := B_X) q.asIdeal)
    obtain ⟨r, hr_not_q, hr_int, h_pow_int⟩ := hZMT
    have hr_ne_zero : r ≠ 0 := by
      rintro rfl
      exact hr_not_q q.asIdeal.zero_mem
    obtain ⟨r₀, hr₀⟩ := hIntDesc r hr_int
    have h_num : ∀ b : B_C, ∃ (m : ℕ) (b₀ : B_X), α b₀ = r ^ m * b := by
      intro b
      obtain ⟨m, hm⟩ := h_pow_int b
      obtain ⟨b₀, hb₀⟩ := hIntDesc (r ^ m * b) hm
      exact ⟨m, b₀, hb₀⟩
    let W_z : C_bar.Opens := C_bar.basicOpen r
    have hWz : AlgebraicGeometry.IsAffineOpen W_z := hVC.basicOpen r
    have e_Wz : W_z ≤ (TopologicalSpace.Opens.map f'.base).obj U_X :=
      le_trans (C_bar.basicOpen_le r) e_X
    have hz_Wz : z ∈ W_z := by
      have hzq : hVC.fromSpec.base q = z := hVC.fromSpec_primeIdealOf ⟨z, hz⟩
      rw [← hzq]
      change q ∈ (TopologicalSpace.Opens.map hVC.fromSpec.base).obj (C_bar.basicOpen r)
      rw [hVC.fromSpec_preimage_basicOpen r]
      exact hr_not_q
    let B_r := ↑(C_bar.presheaf.obj (Opposite.op W_z))
    let α_r : B_X →+* B_r := (f'.appLE U_X W_z e_Wz).hom
    have hα_r_eq : ∀ x : B_X, α_r x = algebraMap B_C B_r (α x) := by
      intro x
      have hmap := f'.appLE_map e_X (CategoryTheory.homOfLE (C_bar.basicOpen_le r)).op
      exact (congrArg (fun g => g.hom x) hmap).symm
    have hLoc_r : IsLocalization.Away r B_r := hVC.isLocalization_basicOpen r
    have hInj_Br : Function.Injective (algebraMap B_C B_r) := by
      have hSub : Submonoid.powers r ≤ nonZeroDivisors B_C :=
        Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hr_ne_zero)
      exact @IsLocalization.injective B_C _ (Submonoid.powers r) B_r _ _ hLoc_r hSub
    let : Algebra B_X B_r := α_r.toAlgebra
    have hLoc_r₀ : @IsLocalization.Away B_X _ r₀ B_r _ α_r.toAlgebra := by
      refine
        { map_units := ?_
          surj := ?_
          exists_of_eq := ?_ }
      · rintro ⟨_, k, rfl⟩
        change IsUnit (α_r (r₀ ^ k))
        rw [hα_r_eq, map_pow, hr₀]
        exact @IsLocalization.map_units B_C _ (Submonoid.powers r) B_r _ _ hLoc_r ⟨r ^ k, k, rfl⟩
      · intro w
        obtain ⟨k, b, hwb⟩ := @IsLocalization.Away.surj B_C _ B_r _ _ r hLoc_r w
        obtain ⟨m, b₀, hb₀⟩ := h_num b
        refine ⟨⟨b₀, ⟨r₀ ^ (k + m), k + m, rfl⟩⟩, ?_⟩
        change w * α_r (r₀ ^ (k + m)) = α_r b₀
        rw [hα_r_eq (r₀ ^ (k + m)), map_pow, hr₀, pow_add, map_mul, map_pow,
          ← mul_assoc, hwb, ← map_mul, mul_comm b (r ^ m), ← hb₀, ← hα_r_eq b₀]
      · intro x₁ x₂ hx
        change α_r x₁ = α_r x₂ at hx
        rw [hα_r_eq x₁, hα_r_eq x₂] at hx
        have hx' : x₁ = x₂ := hInj_α (hInj_Br hx)
        exact ⟨⟨1, 0, pow_zero r₀⟩, by simp [hx']⟩
    have : AlgebraicGeometry.IsOpenImmersion
        (AlgebraicGeometry.Spec.map (f'.appLE U_X W_z e_Wz)) :=
      @AlgebraicGeometry.IsOpenImmersion.of_isLocalization B_X B_r _ _ α_r.toAlgebra r₀ hLoc_r₀
    have : AlgebraicGeometry.IsOpenImmersion (hWz.fromSpec ≫ f') := by
      rw [← AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec f' hUX hWz e_Wz]
      exact AlgebraicGeometry.IsOpenImmersion.comp
        (AlgebraicGeometry.Spec.map (f'.appLE U_X W_z e_Wz)) hUX.fromSpec
    have hOpen_ι : AlgebraicGeometry.IsOpenImmersion (W_z.ι ≫ f') := by
      have hIso_open : AlgebraicGeometry.IsOpenImmersion (hWz.isoSpec.hom ≫ (hWz.fromSpec ≫ f')) :=
        AlgebraicGeometry.IsOpenImmersion.comp hWz.isoSpec.hom (hWz.fromSpec ≫ f')
      rwa [← CategoryTheory.Category.assoc, hWz.isoSpec_hom, hWz.toSpecΓ_fromSpec] at hIso_open
    exact ⟨W_z, hz_Wz, hOpen_ι⟩
  choose W hzW hOpenW using hLocal
  have hInj_f' : Function.Injective ⇑f'.base := by
    intro z₁ z₂ hfz
    have : AlgebraicGeometry.IsOpenImmersion ((W z₁).ι ≫ f') := hOpenW z₁
    have : AlgebraicGeometry.IsOpenImmersion ((W z₂).ι ≫ f') := hOpenW z₂
    let O₁ : C_bar.Opens :=
      W z₁ ⊓ (TopologicalSpace.Opens.map f'.base).obj (((W z₂).ι ≫ f').opensRange)
    have hz₁_O₁ : z₁ ∈ O₁ := by
      refine ⟨hzW z₁, ?_⟩
      change f'.base z₁ ∈ (((W z₂).ι ≫ f').opensRange : Set ↥X)
      rw [((W z₂).ι ≫ f').coe_opensRange]
      exact ⟨⟨z₂, hzW z₂⟩, hfz.symm⟩
    have hO₁_ne : Nonempty ↥O₁ := ⟨⟨z₁, hz₁_O₁⟩⟩
    have hW₂_ne : Nonempty ↥(W z₂) := ⟨⟨z₂, hzW z₂⟩⟩
    have hRange_O₁ : Set.range ⇑(O₁.ι ≫ f').base ⊆ Set.range ⇑((W z₂).ι ≫ f').base := by
      rintro _ ⟨⟨w, _, hwPre⟩, rfl⟩
      change f'.base w ∈ (((W z₂).ι ≫ f').opensRange : Set ↥X) at hwPre
      rw [((W z₂).ι ≫ f').coe_opensRange] at hwPre
      exact hwPre
    let τ : O₁.toScheme ⟶ (W z₂).toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift ((W z₂).ι ≫ f') (O₁.ι ≫ f') hRange_O₁
    have hτ_fac : τ ≫ ((W z₂).ι ≫ f') = O₁.ι ≫ f' :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac ((W z₂).ι ≫ f') (O₁.ι ≫ f') hRange_O₁
    let η₁ : AlgebraicGeometry.Spec (CommRingCat.of F_ss) ⟶ O₁.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift O₁.ι η_C (hη_mem O₁ hO₁_ne)
    have hη₁_fac : η₁ ≫ O₁.ι = η_C :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac O₁.ι η_C (hη_mem O₁ hO₁_ne)
    let η₂ : AlgebraicGeometry.Spec (CommRingCat.of F_ss) ⟶ (W z₂).toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift (W z₂).ι η_C (hη_mem (W z₂) hW₂_ne)
    have hη₂_fac : η₂ ≫ (W z₂).ι = η_C :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac (W z₂).ι η_C (hη_mem (W z₂) hW₂_ne)
    have : AlgebraicGeometry.IsDominant η₁ := by
      rw [AlgebraicGeometry.isDominant_iff, denseRange_iff_closure_range, Set.eq_univ_iff_forall]
      intro u
      rw [mem_closure_iff]
      intro V hV_open huV
      let V'_op : C_bar.Opens := ⟨⇑O₁.ι.base '' V, O₁.ι.isOpenEmbedding.isOpenMap V hV_open⟩
      have hV'_ne : Nonempty ↥V'_op := ⟨⟨O₁.ι.base u, u, huV, rfl⟩⟩
      let pt₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of F_ss)) := default
      have hmem : η_C.base pt₀ ∈ Set.range ⇑V'_op.ι.base :=
        hη_mem V'_op hV'_ne ⟨pt₀, rfl⟩
      rw [V'_op.range_ι] at hmem
      obtain ⟨v, hvV, hv_eq⟩ := hmem
      have hv_η₁ : O₁.ι.base v = O₁.ι.base (η₁.base pt₀) := by
        rw [hv_eq, ← hη₁_fac]
        rfl
      have hv_eq' : v = η₁.base pt₀ := O₁.ι.isOpenEmbedding.injective hv_η₁
      exact ⟨η₁.base pt₀, hv_eq' ▸ hvV, pt₀, rfl⟩
    have hη_τ : η₁ ≫ τ = η₂ := by
      apply (CategoryTheory.cancel_mono ((W z₂).ι ≫ f')).mp
      calc
        (η₁ ≫ τ) ≫ ((W z₂).ι ≫ f')
          = η₁ ≫ (τ ≫ ((W z₂).ι ≫ f')) := CategoryTheory.Category.assoc _ _ _
        _ = η₁ ≫ (O₁.ι ≫ f') := by rw [hτ_fac]
        _ = (η₁ ≫ O₁.ι) ≫ f' := (CategoryTheory.Category.assoc _ _ _).symm
        _ = η_C ≫ f' := by rw [hη₁_fac]
        _ = (η₂ ≫ (W z₂).ι) ≫ f' := by rw [hη₂_fac]
        _ = η₂ ≫ ((W z₂).ι ≫ f') := CategoryTheory.Category.assoc _ _ _
    have h_eq_ι : τ ≫ (W z₂).ι = O₁.ι :=
      AlgebraicGeometry.ext_of_isDominant_of_isSeparated f'
        (by rw [CategoryTheory.Category.assoc, hτ_fac]) η₁
        (by rw [← CategoryTheory.Category.assoc, hη_τ, hη₂_fac, hη₁_fac])
    let u₁ : ↥O₁.toScheme := ⟨z₁, hz₁_O₁⟩
    let u₂ : ↥(W z₂).toScheme := ⟨z₂, hzW z₂⟩
    have hτ_u : τ.base u₁ = u₂ := by
      apply ((W z₂).ι ≫ f').isOpenEmbedding.injective
      calc
        ((W z₂).ι ≫ f').base (τ.base u₁)
          = (τ ≫ ((W z₂).ι ≫ f')).base u₁ := rfl
        _ = (O₁.ι ≫ f').base u₁ := by rw [hτ_fac]
        _ = f'.base z₁ := rfl
        _ = f'.base z₂ := hfz
        _ = ((W z₂).ι ≫ f').base u₂ := rfl
    have h_eval : (τ ≫ (W z₂).ι).base u₁ = O₁.ι.base u₁ :=
      congrArg (fun g : O₁.toScheme ⟶ C_bar => g.base u₁) h_eq_ι
    change (W z₂).ι.base (τ.base u₁) = z₁ at h_eval
    rw [hτ_u] at h_eval
    exact h_eval.symm
  have hSup : iSup W = (⊤ : C_bar.Opens) :=
    eq_top_iff.mpr fun z _ => TopologicalSpace.Opens.mem_iSup.mpr ⟨z, hzW z⟩
  have : AlgebraicGeometry.IsOpenImmersion f' :=
    AlgebraicGeometry.IsOpenImmersion.of_openCover_source f'
      (C_bar.openCoverOfIsOpenCover W (TopologicalSpace.IsOpenCover.mk hSup)) hInj_f'
      fun i => hOpenW i
  have : AlgebraicGeometry.IsDominant f' := by
    rw [AlgebraicGeometry.isDominant_iff, denseRange_iff_closure_range, Set.eq_univ_iff_forall]
    intro x
    rw [mem_closure_iff]
    intro o ho_open hxo
    let U_op : X.Opens := ⟨o, ho_open⟩
    have hxU : x ∈ U_op := hxo
    obtain ⟨U₀, hU₀_mem, hxU₀, hU₀_le⟩ :=
      (TopologicalSpace.Opens.isBasis_iff_nbhd.mp (AlgebraicGeometry.Scheme.isBasis_affineOpens X)) hxU
    have hU₀ : AlgebraicGeometry.IsAffineOpen U₀ := hU₀_mem
    obtain ⟨φ₀, _, hφ₀⟩ := hFuncX U₀ hU₀ ⟨⟨x, hxU₀⟩⟩
    let pt₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of F_ss)) := default
    have hfx_eq : f'.base (η_C.base pt₀) =
        hU₀.fromSpec.base ((AlgebraicGeometry.Spec.map φ₀).base pt₀) := by
      change (η_C ≫ f').base pt₀ = (AlgebraicGeometry.Spec.map φ₀ ≫ hU₀.fromSpec).base pt₀
      rw [hη, hφ₀]
    have hfx_mem_U₀ : f'.base (η_C.base pt₀) ∈ (U₀ : Set ↥X) := by
      rw [hfx_eq, ← hU₀.range_fromSpec]
      exact ⟨(AlgebraicGeometry.Spec.map φ₀).base pt₀, rfl⟩
    exact ⟨f'.base (η_C.base pt₀), hU₀_le hfx_mem_U₀, ⟨η_C.base pt₀, rfl⟩⟩
  have : AlgebraicGeometry.Surjective f' :=
    AlgebraicGeometry.Surjective.of_universallyClosed_of_isDominant f'
  exact (AlgebraicGeometry.isIso_iff_isOpenImmersion_and_surjective f').mpr
    ⟨inferInstance, inferInstance⟩

theorem weil_valuation_transfer_contradicts_linear_residue (K : Type u) [Field K]
    (V : ValuationSubring K)
    (Y U_ss X C_bar : AlgebraicGeometry.Scheme.{u})
    (g_ss : U_ss ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (hAff_ss : AlgebraicGeometry.IsAffine U_ss)
    (h_mod : Y ⟶ U_ss)
    (g_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (p_X : X ⟶ U_ss)
    (hProp_pX : AlgebraicGeometry.IsProper p_X)
    (hComm_pX : p_X ≫ g_ss = g_X)
    (π_1 : C_bar ⟶ Y)
    (f' : C_bar ⟶ X)
    (hSq : π_1 ≫ h_mod = f' ≫ p_X)
    (F_ss : Type u) [Field F_ss]
    (η_ss : AlgebraicGeometry.Spec (CommRingCat.of F_ss) ⟶ U_ss)
    (η_Y : AlgebraicGeometry.Spec (CommRingCat.of F_ss) ⟶ Y)
    (η_X : AlgebraicGeometry.Spec (CommRingCat.of F_ss) ⟶ X)
    (η_C : AlgebraicGeometry.Spec (CommRingCat.of F_ss) ⟶ C_bar)
    (hηY_ss : η_Y ≫ h_mod = η_ss)
    (hη_pX : η_X ≫ p_X = η_ss)
    (hηC_Y : η_C ≫ π_1 = η_Y)
    (hηC_X : η_C ≫ f' = η_X)
    (φ_KF : K →+* F_ss)
    (hφ_V : ∀ c : ↥V,
      φ_KF (V.subtype c) = (AlgebraicGeometry.Spec.preimage (η_ss ≫ g_ss)).hom c)
    (hTransfer : ∀ W : ValuationSubring F_ss,
      IsValResolvedOnMod V g_ss h_mod η_Y W →
      (∀ (ψ_ss : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ U_ss)
          (mW : AlgebraicGeometry.Spec (CommRingCat.of ↥W)),
        mW.asIdeal = IsLocalRing.maximalIdeal ↥W →
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype) ≫ ψ_ss = η_ss →
        (g_ss.base (ψ_ss.base mW)).asIdeal ≠ ⊥) →
      IsValResolvedOnMod V g_ss p_X η_X W)
    (U_1 : Y.Opens) (hU₁ : AlgebraicGeometry.IsAffineOpen U_1)
    (U_X : X.Opens) (hUX : AlgebraicGeometry.IsAffineOpen U_X)
    (V_C : C_bar.Opens) (hVC : AlgebraicGeometry.IsAffineOpen V_C)
    (e_1 : V_C ≤ (TopologicalSpace.Opens.map π_1.base).obj U_1)
    (e_X : V_C ≤ (TopologicalSpace.Opens.map f'.base).obj U_X)
    (φ_C : C_bar.presheaf.obj (Opposite.op V_C) ⟶ CommRingCat.of F_ss)
    (hφ_C : AlgebraicGeometry.Spec.map φ_C ≫ hVC.fromSpec = η_C)
    (p : Ideal ↑(X.presheaf.obj (Opposite.op U_X))) [p.IsPrime]
    (hPs_ne : Ideal.comap (AlgebraicGeometry.Spec.preimage (hUX.fromSpec ≫ g_X)).hom p ≠ ⊥)
    (W : ValuationSubring F_ss)
    (hV : ∀ c : ↥V, φ_KF (V.subtype c) ∈ W)
    (ρ_C : ↑(C_bar.presheaf.obj (Opposite.op V_C)) →+* ↥W)
    (c_star : ↑(Y.presheaf.obj (Opposite.op U_1)))
    (hρ_sub : W.subtype.comp ρ_C = φ_C.hom)
    (hρ_comap : Ideal.comap (ρ_C.comp (f'.appLE U_X V_C e_X).hom) (IsLocalRing.maximalIdeal ↥W) = p)
    (hTransU : ∀ P : Polynomial ↥V,
      (∃ i : ℕ, P.coeff i ∉
        Ideal.comap (AlgebraicGeometry.Spec.preimage (hUX.fromSpec ≫ g_X)).hom p) →
      Polynomial.eval₂ ((φ_KF.comp V.subtype).codRestrict W.toSubring hV)
        (ρ_C ((π_1.appLE U_1 V_C e_1).hom c_star)) P ∉ IsLocalRing.maximalIdeal ↥W)
    (hLinX : ∀ (d r : ↑(X.presheaf.obj (Opposite.op U_X))), r ∉ p →
      ∃ (c₀ s₀ : ↥V),
        s₀ ∉ Ideal.comap (AlgebraicGeometry.Spec.preimage (hUX.fromSpec ≫ g_X)).hom p ∧
        (AlgebraicGeometry.Spec.preimage (hUX.fromSpec ≫ g_X)).hom s₀ * d -
          (AlgebraicGeometry.Spec.preimage (hUX.fromSpec ≫ g_X)).hom c₀ * r ∈ p) :
    False :=
by
  have _ := hη_pX
  let B₁ := ↑(Y.presheaf.obj (Opposite.op U_1))
  let B_X := ↑(X.presheaf.obj (Opposite.op U_X))
  let B_C := ↑(C_bar.presheaf.obj (Opposite.op V_C))
  let β : B₁ →+* B_C := (π_1.appLE U_1 V_C e_1).hom
  let α : B_X →+* B_C := (f'.appLE U_X V_C e_X).hom
  let γ_X : ↥V →+* B_X := (AlgebraicGeometry.Spec.preimage (hUX.fromSpec ≫ g_X)).hom
  let P_s : Ideal ↥V := Ideal.comap γ_X p
  let ρ_V : ↥V →+* ↥W := (φ_KF.comp V.subtype).codRestrict W.toSubring hV
  let mW : AlgebraicGeometry.Spec (CommRingCat.of ↥W) :=
    ⟨IsLocalRing.maximalIdeal ↥W, inferInstance⟩
  let ι_W : AlgebraicGeometry.Spec (CommRingCat.of F_ss) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of ↥W) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype)
  let ψ_C : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ C_bar :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_C) ≫ hVC.fromSpec
  let ψ_Y : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ Y := ψ_C ≫ π_1
  let ψ_X : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ X := ψ_C ≫ f'
  let φ_U₁ : Y.presheaf.obj (Opposite.op U_1) ⟶ CommRingCat.of ↥W :=
    CommRingCat.ofHom (ρ_C.comp β)
  let φ_UX : X.presheaf.obj (Opposite.op U_X) ⟶ CommRingCat.of ↥W :=
    CommRingCat.ofHom (ρ_C.comp α)
  
  have hρ_hom : CommRingCat.ofHom ρ_C ≫ CommRingCat.ofHom W.subtype = φ_C :=
    CommRingCat.hom_ext hρ_sub
  have hι_ψC : ι_W ≫ ψ_C = η_C := by
    dsimp only [ι_W, ψ_C]
    rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp, hρ_hom, hφ_C]
  have hι_ψY : ι_W ≫ ψ_Y = η_Y := by
    dsimp only [ψ_Y]
    rw [← CategoryTheory.Category.assoc, hι_ψC, hηC_Y]
  have hι_ψX : ι_W ≫ ψ_X = η_X := by
    dsimp only [ψ_X]
    rw [← CategoryTheory.Category.assoc, hι_ψC, hηC_X]
  have hψ_sq : ψ_Y ≫ h_mod = ψ_X ≫ p_X := by
    dsimp only [ψ_Y, ψ_X]
    rw [CategoryTheory.Category.assoc, hSq, ← CategoryTheory.Category.assoc]
  have hι_ψss : ι_W ≫ (ψ_Y ≫ h_mod) = η_ss := by
    rw [← CategoryTheory.Category.assoc, hι_ψY, hηY_ss]
  
  have hφ_U₁_eq : φ_U₁ = π_1.appLE U_1 V_C e_1 ≫ CommRingCat.ofHom ρ_C :=
    CommRingCat.hom_ext rfl
  have hφ_UX_eq : φ_UX = f'.appLE U_X V_C e_X ≫ CommRingCat.ofHom ρ_C :=
    CommRingCat.hom_ext rfl
  have hφ_U₁_fac : AlgebraicGeometry.Spec.map φ_U₁ ≫ hU₁.fromSpec = ψ_Y := by
    rw [hφ_U₁_eq, AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc,
      AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec π_1 hU₁ hVC e_1,
      ← CategoryTheory.Category.assoc]
  have hφ_UX_fac : AlgebraicGeometry.Spec.map φ_UX ≫ hUX.fromSpec = ψ_X := by
    rw [hφ_UX_eq, AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc,
      AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec f' hUX hVC e_X,
      ← CategoryTheory.Category.assoc]
  have hm_U1 : ψ_Y.base mW ∈ U_1 := by
    rw [← hφ_U₁_fac]
    have hmem : (AlgebraicGeometry.Spec.map φ_U₁ ≫ hU₁.fromSpec).base mW ∈
        Set.range hU₁.fromSpec.base :=
      ⟨(AlgebraicGeometry.Spec.map φ_U₁).base mW, rfl⟩
    rwa [hU₁.range_fromSpec] at hmem
  let pt_p : AlgebraicGeometry.Spec (X.presheaf.obj (Opposite.op U_X)) :=
    ⟨p, inferInstance⟩
  have hSpec_φUX_mW : (AlgebraicGeometry.Spec.map φ_UX).base mW = pt_p := by
    rw [AlgebraicGeometry.Spec.map_base]
    exact PrimeSpectrum.ext hρ_comap
  have hψX_mW : ψ_X.base mW = hUX.fromSpec.base pt_p := by
    rw [← hφ_UX_fac]
    change hUX.fromSpec.base ((AlgebraicGeometry.Spec.map φ_UX).base mW) = hUX.fromSpec.base pt_p
    rw [hSpec_φUX_mW]
  have hψY_gss : ψ_Y ≫ h_mod ≫ g_ss = ψ_X ≫ g_X := by
    calc
      ψ_Y ≫ h_mod ≫ g_ss = (ψ_Y ≫ h_mod) ≫ g_ss := by simp only [CategoryTheory.Category.assoc]
      _ = (ψ_X ≫ p_X) ≫ g_ss := by rw [hψ_sq]
      _ = ψ_X ≫ (p_X ≫ g_ss) := by simp only [CategoryTheory.Category.assoc]
      _ = ψ_X ≫ g_X := by rw [hComm_pX]
  have hcenter : (g_ss.base ((ψ_Y ≫ h_mod).base mW)).asIdeal = P_s := by
    change ((ψ_Y ≫ h_mod ≫ g_ss).base mW).asIdeal = P_s
    rw [hψY_gss]
    change (g_X.base (ψ_X.base mW)).asIdeal = P_s
    rw [hψX_mW]
    change ((hUX.fromSpec ≫ g_X).base pt_p).asIdeal = P_s
    rw [← AlgebraicGeometry.Spec.map_preimage (hUX.fromSpec ≫ g_X),
      AlgebraicGeometry.Spec.map_base]
    rfl
  have hPre_Y : (AlgebraicGeometry.Spec.preimage (ψ_Y ≫ h_mod ≫ g_ss)).hom = ρ_V := by
    have h1 : ι_W ≫ (ψ_Y ≫ h_mod ≫ g_ss) = η_ss ≫ g_ss := by
      calc
        ι_W ≫ (ψ_Y ≫ h_mod ≫ g_ss) = (ι_W ≫ (ψ_Y ≫ h_mod)) ≫ g_ss := by
          simp only [CategoryTheory.Category.assoc]
        _ = η_ss ≫ g_ss := by rw [hι_ψss]
    have h2 := congrArg AlgebraicGeometry.Spec.preimage h1
    rw [AlgebraicGeometry.Spec.preimage_comp, AlgebraicGeometry.Spec.preimage_map] at h2
    ext c
    have h3 : W.subtype ((AlgebraicGeometry.Spec.preimage (ψ_Y ≫ h_mod ≫ g_ss)).hom c) =
        (AlgebraicGeometry.Spec.preimage (η_ss ≫ g_ss)).hom c := by
      rw [← h2]
      rfl
    change W.subtype ((AlgebraicGeometry.Spec.preimage (ψ_Y ≫ h_mod ≫ g_ss)).hom c) =
      φ_KF (V.subtype c)
    rw [h3, hφ_V c]
  have hρV_eq : ρ_V = (ρ_C.comp α).comp γ_X := by
    have h1 : ψ_Y ≫ h_mod ≫ g_ss =
        AlgebraicGeometry.Spec.map φ_UX ≫ (hUX.fromSpec ≫ g_X) := by
      rw [hψY_gss, ← hφ_UX_fac, CategoryTheory.Category.assoc]
    have h2 := congrArg AlgebraicGeometry.Spec.preimage h1
    rw [AlgebraicGeometry.Spec.preimage_comp, AlgebraicGeometry.Spec.preimage_map] at h2
    rw [← hPre_Y, h2]
    rfl
  have hResY : IsValResolvedOnMod V g_ss h_mod η_Y W := by
    refine ⟨ψ_Y, mW, U_1, hU₁, φ_U₁, c_star, rfl, hι_ψY, hm_U1, hφ_U₁_fac, ?_⟩
    intro P hP
    rw [hcenter] at hP
    rw [hPre_Y]
    exact hTransU P hP
  
  have : AlgebraicGeometry.IsAffine U_ss := hAff_ss
  have : AlgebraicGeometry.IsDominant ι_W := by
    rw [AlgebraicGeometry.isDominant_iff]
    dsimp only [ι_W]
    rw [AlgebraicGeometry.Spec.map_base]
    change DenseRange (PrimeSpectrum.comap W.subtype)
    rw [PrimeSpectrum.denseRange_comap_iff_ker_le_nilRadical]
    have hker : RingHom.ker W.subtype = ⊥ :=
      (RingHom.ker_eq_bot_iff_eq_zero W.subtype).mpr (fun x hx => Subtype.val_injective hx)
    rw [hker]
    exact bot_le
  have hNonzero : ∀ (ψ_ss : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ U_ss)
      (mW' : AlgebraicGeometry.Spec (CommRingCat.of ↥W)),
      mW'.asIdeal = IsLocalRing.maximalIdeal ↥W →
      ι_W ≫ ψ_ss = η_ss →
      (g_ss.base (ψ_ss.base mW')).asIdeal ≠ ⊥ := by
    intro ψ_ss mW' hmW' hψ_ss
    have hmW'_eq : mW' = mW := PrimeSpectrum.ext hmW'
    have hψ_ss_eq : ψ_ss = ψ_Y ≫ h_mod :=
      AlgebraicGeometry.ext_of_isDominant ι_W (hψ_ss.trans hι_ψss.symm)
    rw [hmW'_eq, hψ_ss_eq, hcenter]
    exact hPs_ne
  obtain ⟨ψ'_X, mW'', U'_X, hU'_X, φ'_UX, f_1, hmW'', hι_ψ'X, hm_U'X, hφ'_UX_fac, hTransX⟩ :=
    hTransfer W hResY hNonzero
  
  have hpX_eq : ψ'_X ≫ p_X = ψ_X ≫ p_X := by
    apply AlgebraicGeometry.ext_of_isDominant ι_W
    calc
      ι_W ≫ (ψ'_X ≫ p_X) = (ι_W ≫ ψ'_X) ≫ p_X := by simp only [CategoryTheory.Category.assoc]
      _ = η_X ≫ p_X := by rw [hι_ψ'X]
      _ = (ι_W ≫ ψ_X) ≫ p_X := by rw [← hι_ψX]
      _ = ι_W ≫ (ψ_X ≫ p_X) := by simp only [CategoryTheory.Category.assoc]
  have : AlgebraicGeometry.IsSeparated p_X := hProp_pX.toIsSeparated
  have hψ'_eq : ψ'_X = ψ_X :=
    AlgebraicGeometry.ext_of_isDominant_of_isSeparated p_X hpX_eq ι_W (hι_ψ'X.trans hι_ψX.symm)
  have hmW''_eq : mW'' = mW := PrimeSpectrum.ext hmW''
  have hTransX' : ∀ P : Polynomial ↥V,
      (∃ i : ℕ, P.coeff i ∉ P_s) →
      Polynomial.eval₂ ρ_V (φ'_UX.hom f_1) P ∉ IsLocalRing.maximalIdeal ↥W := by
    intro P hP
    have hbase_eq : (g_ss.base ((ψ'_X ≫ p_X).base mW'')).asIdeal = P_s := by
      rw [hpX_eq, hmW''_eq, ← hψ_sq, hcenter]
    have hpre_eq : (AlgebraicGeometry.Spec.preimage (ψ'_X ≫ p_X ≫ g_ss)).hom = ρ_V := by
      have hcomp_eq : ψ'_X ≫ p_X ≫ g_ss = ψ_Y ≫ h_mod ≫ g_ss := by
        calc
          ψ'_X ≫ p_X ≫ g_ss = (ψ'_X ≫ p_X) ≫ g_ss := by simp only [CategoryTheory.Category.assoc]
          _ = (ψ_Y ≫ h_mod) ≫ g_ss := by rw [hpX_eq, ← hψ_sq]
          _ = ψ_Y ≫ h_mod ≫ g_ss := by simp only [CategoryTheory.Category.assoc]
      rw [hcomp_eq, hPre_Y]
    rw [← hpre_eq]
    apply hTransX P
    rwa [hbase_eq]
  
  let x : X := ψ_X.base mW
  have hx_UX : x ∈ U_X := by
    dsimp only [x]
    rw [hψX_mW]
    have hmem : hUX.fromSpec.base pt_p ∈ Set.range hUX.fromSpec.base := ⟨pt_p, rfl⟩
    rwa [hUX.range_fromSpec] at hmem
  have hx_U'X : x ∈ U'_X := by
    dsimp only [x]
    rw [← hψ'_eq, ← hmW''_eq]
    exact hm_U'X
  obtain ⟨r₀, hD_le, hx_D₀⟩ :=
    hUX.exists_basicOpen_le (⟨x, ⟨hx_UX, hx_U'X⟩⟩ : ↥(U_X ⊓ U'_X)) hx_UX
  let D₀ : X.Opens := X.basicOpen r₀
  have eD₁ : D₀ ≤ U_X := X.basicOpen_le r₀
  have eD₂ : D₀ ≤ U'_X := hD_le.trans inf_le_right
  have hD₀ : AlgebraicGeometry.IsAffineOpen D₀ := hUX.basicOpen r₀
  have hr₀_not_p : r₀ ∉ p := by
    let p_spec : PrimeSpectrum ↑(X.presheaf.obj (Opposite.op U_X)) := pt_p
    have hmem_D₀ : hUX.fromSpec.base pt_p ∈ X.basicOpen r₀ := by
      rw [← hψX_mW]
      exact hx_D₀
    have hiff := SetLike.ext_iff.mp (hUX.fromSpec_preimage_basicOpen r₀) p_spec
    exact (PrimeSpectrum.mem_basicOpen r₀ p_spec).mp (hiff.mp hmem_D₀)
  have hRange_D₀ : Set.range ψ_X.base ⊆ Set.range hD₀.fromSpec.base := by
    rw [hD₀.range_fromSpec]
    rintro _ ⟨q, rfl⟩
    let q' : PrimeSpectrum ↥W := q
    let mW₀ : PrimeSpectrum ↥W := mW
    have hle : q' ≤ mW₀ := IsLocalRing.le_maximalIdeal q'.isPrime.ne_top
    have hspec : q ⤳ mW := (PrimeSpectrum.le_iff_specializes q' mW₀).mp hle
    have hspec_X : ψ_X.base q ⤳ x := hspec.map ψ_X.continuous
    exact hspec_X.mem_open D₀.isOpen hx_D₀
  let ℓ := AlgebraicGeometry.IsOpenImmersion.lift hD₀.fromSpec ψ_X hRange_D₀
  let φ_D₀ : X.presheaf.obj (Opposite.op D₀) ⟶ CommRingCat.of ↥W :=
    AlgebraicGeometry.Spec.preimage ℓ
  have hφ_D₀_fac : AlgebraicGeometry.Spec.map φ_D₀ ≫ hD₀.fromSpec = ψ_X := by
    dsimp only [φ_D₀, ℓ]
    rw [AlgebraicGeometry.Spec.map_preimage, AlgebraicGeometry.IsOpenImmersion.lift_fac]
  let res₁ := X.presheaf.map (CategoryTheory.homOfLE eD₁).op
  let res₂ := X.presheaf.map (CategoryTheory.homOfLE eD₂).op
  have hres₁_φ : res₁ ≫ φ_D₀ = φ_UX := by
    have hSpec_eq : AlgebraicGeometry.Spec.map (res₁ ≫ φ_D₀) =
        AlgebraicGeometry.Spec.map φ_UX := by
      rw [← CategoryTheory.cancel_mono hUX.fromSpec, AlgebraicGeometry.Spec.map_comp,
        CategoryTheory.Category.assoc, hUX.map_fromSpec hD₀ (CategoryTheory.homOfLE eD₁).op,
        hφ_D₀_fac, hφ_UX_fac]
    have hpre := congrArg AlgebraicGeometry.Spec.preimage hSpec_eq
    simpa only [AlgebraicGeometry.Spec.preimage_map] using hpre
  have hres₂_φ : res₂ ≫ φ_D₀ = φ'_UX := by
    have hSpec_eq : AlgebraicGeometry.Spec.map (res₂ ≫ φ_D₀) =
        AlgebraicGeometry.Spec.map φ'_UX := by
      rw [← CategoryTheory.cancel_mono hU'_X.fromSpec, AlgebraicGeometry.Spec.map_comp,
        CategoryTheory.Category.assoc, hU'_X.map_fromSpec hD₀ (CategoryTheory.homOfLE eD₂).op,
        hφ_D₀_fac, ← hψ'_eq, hφ'_UX_fac]
    have hpre := congrArg AlgebraicGeometry.Spec.preimage hSpec_eq
    simpa only [AlgebraicGeometry.Spec.preimage_map] using hpre
  have : IsLocalization.Away r₀ ↑(X.presheaf.obj (Opposite.op D₀)) :=
    hUX.isLocalization_basicOpen r₀
  obtain ⟨k, d₀, hsurj⟩ := IsLocalization.Away.surj r₀ (res₂.hom f_1)
  have hsurj' : res₂.hom f_1 * res₁.hom r₀ ^ k = res₁.hom d₀ := hsurj
  have hclear : φ'_UX.hom f_1 * ρ_C (α (r₀ ^ k)) = ρ_C (α d₀) := by
    have hmap := congrArg φ_D₀.hom hsurj'
    have h1 : ∀ b : B_X, φ_D₀.hom (res₁.hom b) = ρ_C (α b) := by
      intro b
      change (res₁ ≫ φ_D₀).hom b = φ_UX.hom b
      rw [hres₁_φ]
    have h2 : φ_D₀.hom (res₂.hom f_1) = φ'_UX.hom f_1 := by
      change (res₂ ≫ φ_D₀).hom f_1 = φ'_UX.hom f_1
      rw [hres₂_φ]
    rw [map_mul, map_pow, h2, h1 r₀, h1 d₀, ← map_pow ρ_C, ← map_pow α] at hmap
    exact hmap
  
  have hr₀k_not_p : r₀ ^ k ∉ p :=
    fun hmem => hr₀_not_p (‹p.IsPrime›.mem_of_pow_mem k hmem)
  obtain ⟨c₀, s₀, hs₀, hlin_p⟩ := hLinX d₀ (r₀ ^ k) hr₀k_not_p
  have hlin_W : ρ_V s₀ * ρ_C (α d₀) - ρ_V c₀ * ρ_C (α (r₀ ^ k)) ∈
      IsLocalRing.maximalIdeal ↥W := by
    rw [← hρ_comap] at hlin_p
    have hmem : (ρ_C.comp α) (γ_X s₀ * d₀ - γ_X c₀ * r₀ ^ k) ∈
        IsLocalRing.maximalIdeal ↥W := hlin_p
    have hγ : ∀ c : ↥V, ρ_C (α (γ_X c)) = ρ_V c := by
      intro c
      rw [hρV_eq]
      rfl
    simpa only [RingHom.comp_apply, map_sub, map_mul, hγ] using hmem
  have hprod_W : ρ_C (α (r₀ ^ k)) * (ρ_V s₀ * φ'_UX.hom f_1 - ρ_V c₀) ∈
      IsLocalRing.maximalIdeal ↥W := by
    have hrew : ρ_C (α (r₀ ^ k)) * (ρ_V s₀ * φ'_UX.hom f_1 - ρ_V c₀) =
        ρ_V s₀ * ρ_C (α d₀) - ρ_V c₀ * ρ_C (α (r₀ ^ k)) := by
      rw [← hclear]
      ring
    rwa [hrew]
  have hr₀k_not_mW : ρ_C (α (r₀ ^ k)) ∉ IsLocalRing.maximalIdeal ↥W := by
    intro hmem
    apply hr₀k_not_p
    rw [← hρ_comap]
    exact hmem
  have hmem_mW : ρ_V s₀ * φ'_UX.hom f_1 - ρ_V c₀ ∈ IsLocalRing.maximalIdeal ↥W := by
    rcases Ideal.IsPrime.mem_or_mem (inferInstance : (IsLocalRing.maximalIdeal ↥W).IsPrime) hprod_W with h1 | h2
    · exact absurd h1 hr₀k_not_mW
    · exact h2
  let P_lin : Polynomial ↥V := Polynomial.C s₀ * Polynomial.X - Polynomial.C c₀
  have hP_coeff : ∃ i : ℕ, P_lin.coeff i ∉ P_s := by
    refine ⟨1, ?_⟩
    dsimp only [P_lin]
    rw [Polynomial.coeff_sub, Polynomial.coeff_C_mul, Polynomial.coeff_X_one,
      Polynomial.coeff_C_succ, mul_one, sub_zero]
    exact hs₀
  have hP_eval : Polynomial.eval₂ ρ_V (φ'_UX.hom f_1) P_lin =
      ρ_V s₀ * φ'_UX.hom f_1 - ρ_V c₀ := by
    dsimp only [P_lin]
    rw [Polynomial.eval₂_sub, Polynomial.eval₂_mul, Polynomial.eval₂_C,
      Polynomial.eval₂_X, Polynomial.eval₂_C]
  have hnot_mW := hTransX' P_lin hP_coeff
  rw [hP_eval] at hnot_mW
  exact hnot_mW hmem_mW

theorem weil_normal_curve_modification_domination_of_val_resolved (K : Type u) [Field K] (m : ℕ)
    (V : ValuationSubring K)
    (hPkg : IsValuationRingAlgPackage m V)
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (hIntCK : AlgebraicGeometry.IsIntegral C_K)
    (C' : AlgebraicGeometry.Scheme.{u})
    (g' : C' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (ι' : C_K ⟶ C')
    (hIntC' : AlgebraicGeometry.IsIntegral C')
    (U' : C'.Opens)
    (U_ss : AlgebraicGeometry.Scheme.{u})
    (g_ss : U_ss ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (hAff_ss : AlgebraicGeometry.IsAffine U_ss)
    (hSS : IsStrictlySemistableCurveOverValuation V g_ss)
    (h_mod : U'.toScheme ⟶ U_ss)
    (hProp_mod : AlgebraicGeometry.IsProper h_mod)
    (hComm_mod : h_mod ≫ g_ss = U'.ι ≫ g')
    (ι_U' : AlgebraicGeometry.Scheme.Opens.toScheme
      ((TopologicalSpace.Opens.map ι'.base).obj U') ⟶ U'.toScheme)
    (hPb_U' : CategoryTheory.IsPullback ι_U'
      (AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj U') ≫ p_K)
      (U'.ι ≫ g')
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (hPb_ss : CategoryTheory.IsPullback (ι_U' ≫ h_mod)
      (AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj U') ≫ p_K)
      g_ss
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (hOpenη : AlgebraicGeometry.IsOpenImmersion
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (F_ss : Type u) [Field F_ss]
    (η_ss : AlgebraicGeometry.Spec (CommRingCat.of F_ss) ⟶ U_ss)
    (hFunc_ss : IsSchemeFunctionField U_ss F_ss η_ss)
    (η_UK : AlgebraicGeometry.Spec (CommRingCat.of F_ss) ⟶
      AlgebraicGeometry.Scheme.Opens.toScheme ((TopologicalSpace.Opens.map ι'.base).obj U'))
    (hUK_ne : Nonempty ↥((TopologicalSpace.Opens.map ι'.base).obj U'))
    (hηUK_ss : η_UK ≫ ι_U' ≫ h_mod = η_ss)
    (hFunc_UK : IsSchemeFunctionField
      (AlgebraicGeometry.Scheme.Opens.toScheme ((TopologicalSpace.Opens.map ι'.base).obj U'))
      F_ss η_UK)
    (φ_KF : K →+* F_ss)
    (hφ_V : ∀ c : ↥V,
      φ_KF (V.subtype c) = (AlgebraicGeometry.Spec.preimage (η_ss ≫ g_ss)).hom c)
    (hTwoVar : ∀ (W : ValuationSubring F_ss)
        (hV : ∀ c : ↥V, φ_KF (V.subtype c) ∈ W)
        (P : Ideal ↥V) [P.IsPrime],
      (∀ c : ↥V,
        ((⟨φ_KF (V.subtype c), hV c⟩ : ↥W) ∈ IsLocalRing.maximalIdeal ↥W ↔ c ∈ P)) →
      ¬ ∃ (t₁ t₂ : ↥W),
        ∀ (Q : MvPolynomial (Fin 2) ↥V),
          (∃ d : Fin 2 →₀ ℕ, Q.coeff d ∉ P) →
          MvPolynomial.eval₂ ((φ_KF.comp V.subtype).codRestrict W.toSubring hV) ![t₁, t₂] Q ∉
            IsLocalRing.maximalIdeal ↥W)
    (X : AlgebraicGeometry.Scheme.{u})
    (g_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (p_X : X ⟶ U_ss)
    (η_X : AlgebraicGeometry.Spec (CommRingCat.of F_ss) ⟶ X)
    (ι_X : AlgebraicGeometry.Scheme.Opens.toScheme
      ((TopologicalSpace.Opens.map ι'.base).obj U') ⟶ X)
    (hSS_X : IsStrictlySemistableCurveOverValuation V g_X)
    (hNorm_X : IsAffineNormalScheme X)
    (hProp_pX : AlgebraicGeometry.IsProper p_X)
    (hComm_pX : p_X ≫ g_ss = g_X)
    (hη_pX : η_X ≫ p_X = η_ss)
    (hι_pX : ι_X ≫ p_X = ι_U' ≫ h_mod)
    (hPb_X : CategoryTheory.IsPullback ι_X
      (AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj U') ≫ p_K)
      g_X
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (hTransfer : ∀ W : ValuationSubring F_ss,
      IsValResolvedOnMod V g_ss h_mod (η_UK ≫ ι_U') W →
      (∀ (ψ_ss : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ U_ss)
          (mW : AlgebraicGeometry.Spec (CommRingCat.of ↥W)),
        mW.asIdeal = IsLocalRing.maximalIdeal ↥W →
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype) ≫ ψ_ss = η_ss →
        (g_ss.base (ψ_ss.base mW)).asIdeal ≠ ⊥) →
      IsValResolvedOnMod V g_ss p_X η_X W) :
    ∃ (f_0 : X ⟶ U'.toScheme),
      AlgebraicGeometry.IsProper f_0 ∧
      f_0 ≫ h_mod = p_X ∧
      f_0 ≫ U'.ι ≫ g' = g_X ∧
      ι_X ≫ f_0 = ι_U' :=
by
  obtain ⟨C_bar, π_1, f', η_C, q_K, hIntC, hDomC, hFuncC, hFuncX,
      hProp_f', hSq, hηC_U', hηC_X, hqK_π1, hqK_f', hGenSub, hCover⟩ :=
    weil_schematic_graph_closure_and_product_cover
      K V C_K p_K hIntCK C' g' ι' U' U_ss g_ss hAff_ss h_mod hProp_mod hComm_mod
      ι_U' hPb_U' hPb_ss hOpenη F_ss η_ss η_UK hUK_ne hηUK_ss hFunc_UK
      X g_X p_X η_X ι_X hSS_X.1 hProp_pX hComm_pX hη_pX hι_pX hPb_X
  have hLocQF : ∀ z : C_bar,
      ∃ (U_X : X.Opens) (_ : AlgebraicGeometry.IsAffineOpen U_X)
        (V_C : C_bar.Opens) (_ : AlgebraicGeometry.IsAffineOpen V_C)
        (e_X : V_C ≤ (TopologicalSpace.Opens.map f'.base).obj U_X),
        z ∈ V_C ∧
        (f'.appLE U_X V_C e_X).hom.FiniteType ∧
        (f'.appLE U_X V_C e_X).hom.QuasiFinite := by
    intro z
    obtain ⟨U_1, hU₁, U_X, hUX, V_C, hVC, e_1, e_X, hz, hFT, hGen⟩ := hCover z
    refine ⟨U_X, hUX, V_C, hVC, e_X, hz, hFT, ?_⟩
    let B_U := ↑(U'.toScheme.presheaf.obj (Opposite.op U_1))
    let B_X := ↑(X.presheaf.obj (Opposite.op U_X))
    let B_C := ↑(C_bar.presheaf.obj (Opposite.op V_C))
    let β : B_U →+* B_C := (π_1.appLE U_1 V_C e_1).hom
    let α : B_X →+* B_C := (f'.appLE U_X V_C e_X).hom
    letI : Algebra B_X B_C := α.toAlgebra
    haveI : Algebra.FiniteType B_X B_C := hFT
    change Algebra.QuasiFinite B_X B_C
    rw [Algebra.QuasiFinite.iff_finite_primesOver]
    intro p hp
    haveI : p.IsPrime := hp
    let γ_X : ↥V →+* B_X := (AlgebraicGeometry.Spec.preimage (hUX.fromSpec ≫ g_X)).hom
    let P_s : Ideal ↥V := Ideal.comap γ_X p
    haveI : P_s.IsPrime := Ideal.IsPrime.comap γ_X
    let x : X := hUX.fromSpec.base ⟨p, hp⟩
    have hx_ideal : (g_X.base x).asIdeal = P_s := by
      change ((hUX.fromSpec ≫ g_X).base ⟨p, hp⟩).asIdeal = P_s
      rw [← AlgebraicGeometry.Spec.map_preimage (hUX.fromSpec ≫ g_X),
        AlgebraicGeometry.Spec.map_base]
      rfl
    by_cases hPs : P_s = ⊥
    · refine Set.Subsingleton.finite ?_
      intro q₁ hq₁ q₂ hq₂
      haveI : q₁.IsPrime := hq₁.1
      haveI : q₂.IsPrime := hq₂.1
      have hq₁_comap : Ideal.comap α q₁ = p := by
        have h := (@Ideal.LiesOver.over _ _ _ _ _ q₁ p hq₁.2).symm
        rwa [Ideal.under_def] at h
      have hq₂_comap : Ideal.comap α q₂ = p := by
        have h := (@Ideal.LiesOver.over _ _ _ _ _ q₂ p hq₂.2).symm
        rwa [Ideal.under_def] at h
      let pt₁ : PrimeSpectrum B_C := ⟨q₁, hq₁.1⟩
      let pt₂ : PrimeSpectrum B_C := ⟨q₂, hq₂.1⟩
      have hmap : ∀ pt : PrimeSpectrum B_C, Ideal.comap α pt.asIdeal = p →
          f'.base (hVC.fromSpec.base pt) = x := by
        intro pt hpt
        change (hVC.fromSpec ≫ f').base pt = hUX.fromSpec.base ⟨p, hp⟩
        rw [← AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec f' hUX hVC e_X]
        change hUX.fromSpec.base ((AlgebraicGeometry.Spec.map (f'.appLE U_X V_C e_X)).base pt) =
          hUX.fromSpec.base ⟨p, hp⟩
        congr 1
        rw [AlgebraicGeometry.Spec.map_base]
        exact PrimeSpectrum.ext hpt
      have hz_eq : hVC.fromSpec.base pt₁ = hVC.fromSpec.base pt₂ :=
        hGenSub x (hx_ideal.trans hPs) (hmap pt₁ hq₁_comap) (hmap pt₂ hq₂_comap)
      have hpt_eq : pt₁ = pt₂ := hVC.fromSpec.isOpenEmbedding.injective hz_eq
      exact congrArg PrimeSpectrum.asIdeal hpt_eq
    · by_contra hInf
      haveI : IsAlgClosed P_s.ResidueField := hPkg.2.2.2.2.1 P_s hPs
      have hV_ne : Nonempty ↥V_C := ⟨⟨z, hz⟩⟩
      haveI : IsDomain B_C :=
        @AlgebraicGeometry.IsIntegral.component_integral C_bar hIntC V_C ⟨⟨z, hz⟩⟩
      obtain ⟨φ_C, hFracC, hφ_C⟩ := hFuncC V_C hVC hV_ne
      have hInjC : Function.Injective φ_C.hom := by
        letI : Algebra B_C F_ss := φ_C.hom.toAlgebra
        exact @IsFractionRing.injective B_C _ F_ss _ _ hFracC
      have hCompat : ∀ c : ↥V, φ_C.hom (α (γ_X c)) = φ_KF (V.subtype c) := by
        have hSpec :
            AlgebraicGeometry.Spec.map
              (AlgebraicGeometry.Spec.preimage (hUX.fromSpec ≫ g_X) ≫
                f'.appLE U_X V_C e_X ≫ φ_C) =
              η_ss ≫ g_ss := by
          rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp,
            AlgebraicGeometry.Spec.map_preimage]
          calc
            AlgebraicGeometry.Spec.map φ_C ≫
                AlgebraicGeometry.Spec.map (f'.appLE U_X V_C e_X) ≫ (hUX.fromSpec ≫ g_X)
              = AlgebraicGeometry.Spec.map φ_C ≫
                  (AlgebraicGeometry.Spec.map (f'.appLE U_X V_C e_X) ≫ hUX.fromSpec) ≫ g_X := by
                simp only [CategoryTheory.Category.assoc]
            _ = AlgebraicGeometry.Spec.map φ_C ≫ (hVC.fromSpec ≫ f') ≫ g_X := by
                rw [AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec f' hUX hVC e_X]
            _ = (AlgebraicGeometry.Spec.map φ_C ≫ hVC.fromSpec) ≫ f' ≫ g_X := by
                simp only [CategoryTheory.Category.assoc]
            _ = η_C ≫ f' ≫ g_X := by rw [hφ_C]
            _ = (η_C ≫ f') ≫ g_X := by simp only [CategoryTheory.Category.assoc]
            _ = η_X ≫ g_X := by rw [hηC_X]
            _ = η_X ≫ (p_X ≫ g_ss) := by rw [← hComm_pX]
            _ = (η_X ≫ p_X) ≫ g_ss := by simp only [CategoryTheory.Category.assoc]
            _ = η_ss ≫ g_ss := by rw [hη_pX]
        have hHom := congrArg AlgebraicGeometry.Spec.preimage hSpec
        rw [AlgebraicGeometry.Spec.preimage_map] at hHom
        intro c
        rw [hφ_V c, ← hHom]
        rfl
      obtain ⟨W, hV, ρ_C, c_star, hρ_sub, hρ_comap, hTransU, hLinX⟩ :=
        weil_fiber_infinite_nested_primes_and_trdeg_dichotomy
          K V F_ss φ_KF hTwoVar P_s B_U B_X B_C β α γ_X φ_C.hom
          hFT hInjC hCompat hGen p rfl hInf
      have hηY_ss : (η_UK ≫ ι_U') ≫ h_mod = η_ss := by
        simpa only [CategoryTheory.Category.assoc] using hηUK_ss
      exact weil_valuation_transfer_contradicts_linear_residue
        K V U'.toScheme U_ss X C_bar g_ss hAff_ss h_mod g_X p_X hProp_pX hComm_pX
        π_1 f' hSq F_ss η_ss (η_UK ≫ ι_U') η_X η_C hηY_ss hη_pX hηC_U' hηC_X
        φ_KF hφ_V hTransfer U_1 hU₁ U_X hUX V_C hVC e_1 e_X φ_C hφ_C p hPs
        W hV ρ_C c_star hρ_sub hρ_comap hTransU hLinX
  haveI : CategoryTheory.IsIso f' :=
    weil_birational_proper_iso_of_locallyQuasiFinite_normal
      C_bar X F_ss f' η_C η_X hIntC hSS_X.1 hNorm_X hProp_f' hDomC hηC_X hFuncC hFuncX hLocQF
  let f_0 : X ⟶ U'.toScheme := CategoryTheory.inv f' ≫ π_1
  have hf0_hmod : f_0 ≫ h_mod = p_X := by
    dsimp only [f_0]
    rw [CategoryTheory.Category.assoc, hSq, CategoryTheory.IsIso.inv_hom_id_assoc]
  have hProp_f0 : AlgebraicGeometry.IsProper f_0 := by
    haveI : AlgebraicGeometry.IsProper (f_0 ≫ h_mod) := by
      rw [hf0_hmod]
      exact hProp_pX
    haveI : AlgebraicGeometry.IsProper h_mod := hProp_mod
    exact AlgebraicGeometry.IsProper.of_comp f_0 h_mod
  refine ⟨f_0, hProp_f0, hf0_hmod, ?_, ?_⟩
  · rw [← hComm_mod, ← CategoryTheory.Category.assoc, hf0_hmod, hComm_pX]
  · dsimp only [f_0]
    rw [← hqK_f', CategoryTheory.Category.assoc, CategoryTheory.IsIso.hom_inv_id_assoc, hqK_π1]

theorem weil_strictlySemistable_gammaZero_domination_criterion (K : Type u) [Field K] [IsSepClosed K] (m : ℕ)
    (V : ValuationSubring K)
    (hPkg : IsValuationRingAlgPackage m V)
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (n : ℕ)
    (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (hIntCK : AlgebraicGeometry.IsIntegral C_K)
    (hSmCK : AlgebraicGeometry.SmoothOfRelativeDimension 1 p_K)
    (hStabCK : IsGeometricStablePointedCurve p_K n σ_K)
    (C' : AlgebraicGeometry.Scheme.{u})
    (g' : C' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (τ' : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C'))
    (ι' : C_K ⟶ C')
    (hMod' : IsValuationPointedCurveModel V p_K n σ_K C' g' τ' ι')
    (U' : C'.Opens)
    (hU' : Nonempty ↥U')
    (U_ss : AlgebraicGeometry.Scheme.{u})
    (g_ss : U_ss ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (hAff_ss : AlgebraicGeometry.IsAffine U_ss)
    (hSS : IsStrictlySemistableCurveOverValuation V g_ss)
    (h_mod : U'.toScheme ⟶ U_ss)
    (hProp_mod : AlgebraicGeometry.IsProper h_mod)
    (hComm_mod : h_mod ≫ g_ss = U'.ι ≫ g')
    (ι_U' : AlgebraicGeometry.Scheme.Opens.toScheme
      ((TopologicalSpace.Opens.map ι'.base).obj U') ⟶ U'.toScheme)
    (hPb_U' : CategoryTheory.IsPullback ι_U'
      (AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj U') ≫ p_K)
      (U'.ι ≫ g')
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (hPb_ss : CategoryTheory.IsPullback (ι_U' ≫ h_mod)
      (AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj U') ≫ p_K)
      g_ss
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (hOpenη : AlgebraicGeometry.IsOpenImmersion
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (F_ss : Type u) [Field F_ss]
    (η_ss : AlgebraicGeometry.Spec (CommRingCat.of F_ss) ⟶ U_ss)
    (hFunc_ss : IsSchemeFunctionField U_ss F_ss η_ss) :
    ∃ (r_val : ℕ) (W_list : Fin r_val → ValuationSubring F_ss),
      (∀ i : Fin r_val, IsDivisorialClosedVal V g_ss η_ss (W_list i)) ∧
      (∀ (X : AlgebraicGeometry.Scheme.{u})
          (g_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
          (p_X : X ⟶ U_ss)
          (η_X : AlgebraicGeometry.Spec (CommRingCat.of F_ss) ⟶ X)
          (ι_X : AlgebraicGeometry.Scheme.Opens.toScheme
            ((TopologicalSpace.Opens.map ι'.base).obj U') ⟶ X),
        IsStrictlySemistableCurveOverValuation V g_X →
        IsAffineNormalScheme X →
        AlgebraicGeometry.IsProper p_X →
        p_X ≫ g_ss = g_X →
        η_X ≫ p_X = η_ss →
        ι_X ≫ p_X = ι_U' ≫ h_mod →
        CategoryTheory.IsPullback ι_X
          (AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj U') ≫ p_K)
          g_X
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)) →
        (∀ i : Fin r_val, IsValResolvedOnMod V g_ss p_X η_X (W_list i)) →
        ∃ (f_0 : X ⟶ U'.toScheme),
          AlgebraicGeometry.IsProper f_0 ∧
          f_0 ≫ h_mod = p_X ∧
          f_0 ≫ U'.ι ≫ g' = g_X ∧
          ι_X ≫ f_0 = ι_U') :=
by
  obtain ⟨η_UK, φ_KF, r_val, W_list, hUK_ne, hηUK_ss, hFunc_UK, hFunc_U', hφ_V,
      ⟨hEssFT, hTrdeg⟩, hW_div, hW_exhaust⟩ :=
    weil_strictlySemistable_generic_funcField_and_gammaZero_exhaustion
      K m V hPkg C_K p_K n σ_K hIntCK hSmCK hStabCK C' g' τ' ι' hMod' U' hU'
      U_ss g_ss hAff_ss hSS h_mod hProp_mod hComm_mod ι_U' hPb_U' hPb_ss hOpenη
      F_ss η_ss hFunc_ss
      (fun φ hAlg =>
        (weil_gauss_divisorial_valuation_finiteness_and_trdeg_bound
          K V F_ss φ hAlg.1 hAlg.2).1)
  have hTwoVar :=
    (weil_gauss_divisorial_valuation_finiteness_and_trdeg_bound
      K V F_ss φ_KF hEssFT hTrdeg).2
  refine ⟨r_val, W_list, hW_div, ?_⟩
  intro X g_X p_X η_X ι_X hSS_X hNorm_X hProp_pX hComm_pX hη_pX hι_pX hPb_X hRes_list
  have hRes_div : ∀ W₀ : ValuationSubring F_ss,
      IsDivisorialClosedVal V g_ss η_ss W₀ →
      IsValResolvedOnMod V g_ss h_mod (η_UK ≫ ι_U') W₀ →
      IsValResolvedOnMod V g_ss p_X η_X W₀ := by
    intro W₀ hDiv₀ hResU₀
    obtain ⟨i, rfl⟩ := hW_exhaust W₀ hDiv₀ hResU₀
    exact hRes_list i
  have hηU'_ss : (η_UK ≫ ι_U') ≫ h_mod = η_ss := by
    simpa only [CategoryTheory.Category.assoc] using hηUK_ss
  have hTransfer : ∀ W : ValuationSubring F_ss,
      IsValResolvedOnMod V g_ss h_mod (η_UK ≫ ι_U') W →
      (∀ (ψ_ss : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ U_ss)
          (mW : AlgebraicGeometry.Spec (CommRingCat.of ↥W)),
        mW.asIdeal = IsLocalRing.maximalIdeal ↥W →
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype) ≫ ψ_ss = η_ss →
        (g_ss.base (ψ_ss.base mW)).asIdeal ≠ ⊥) →
      IsValResolvedOnMod V g_ss p_X η_X W :=
    fun W hRes_U' hNonzero =>
      weil_divisorial_specialization_and_overring_propagation
        K m V hPkg C_K p_K n σ_K C' g' τ' ι' hMod' U' U_ss g_ss hAff_ss hSS
        h_mod hProp_mod hComm_mod F_ss η_ss hFunc_ss (η_UK ≫ ι_U') hηU'_ss hFunc_U'
        X g_X p_X η_X hSS_X hProp_pX hComm_pX hη_pX hRes_div W hRes_U' hNonzero
  exact weil_normal_curve_modification_domination_of_val_resolved
    K m V hPkg C_K p_K hIntCK C' g' ι' hMod'.1 U' U_ss g_ss hAff_ss hSS
    h_mod hProp_mod hComm_mod ι_U' hPb_U' hPb_ss hOpenη F_ss η_ss hFunc_ss
    η_UK hUK_ne hηUK_ss hFunc_UK φ_KF hφ_V hTwoVar
    X g_X p_X η_X ι_X hSS_X hNorm_X hProp_pX hComm_pX hη_pX hι_pX hPb_X hTransfer

theorem weil_valuation_henselian_etale_section_and_nodal_nonsmooth (K : Type u) [Field K] [IsSepClosed K] (m : ℕ)
    (V : ValuationSubring K)
    (hPkg : IsValuationRingAlgPackage m V) :
    (∃ (t₀ : ↥V), t₀ ≠ 0 ∧ ∀ (Q : Ideal ↥V) [Q.IsPrime], t₀ ∉ Q ↔ Q = ⊥) ∧
    (∀ (P : Ideal ↥V) [P.IsPrime], P ≠ ⊥ →
      (∃ (t_z : ↥V), t_z ∉ P ∧ ∀ (Q : Ideal ↥V) [Q.IsPrime], t_z ∉ Q ↔ Q ≤ P) ∧
      ∀ (t_z : ↥V), t_z ∉ P →
        (∀ (Q : Ideal ↥V) [Q.IsPrime], t_z ∉ Q ↔ Q ≤ P) →
        ∀ (R_z : Type u) [CommRing R_z] [Algebra ↥V R_z] [IsLocalization.Away t_z R_z],
          IsLocalization.AtPrime R_z P ∧
          ∀ (I : Ideal R_z), I ≠ ⊤ →
            ∀ (C₀ : Type u) [CommRing C₀]
              [Algebra (R_z ⧸ I) C₀]
              [Algebra.Etale (R_z ⧸ I) C₀]
              (q_z : Ideal C₀) [q_z.IsPrime],
              Ideal.comap (algebraMap ↥V R_z)
                (Ideal.comap (algebraMap R_z (R_z ⧸ I))
                  (Ideal.comap (algebraMap (R_z ⧸ I) C₀) q_z)) = P →
              ∃ (h : C₀), h ∉ q_z ∧
                Function.Bijective (algebraMap (R_z ⧸ I) (Localization.Away h))) ∧
    (∀ (X : AlgebraicGeometry.Scheme.{u})
        (g_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
        (W : X.Opens) (a : ↥V)
        (e : W.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of
          (MvPolynomial (Fin 2) ↥V ⧸ Ideal.span
            {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a})))
        (x : W) (V_sm : X.Opens),
      AlgebraicGeometry.Etale e →
      W.ι ≫ g_X = e ≫ AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) →
      W.ι.base x ∈ V_sm →
      AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ g_X) →
      a ∈ (g_X.base (W.ι.base x)).asIdeal →
      ¬ (∀ i : Fin 2, Ideal.Quotient.mk _ (MvPolynomial.X i) ∈ (e.base x).asIdeal)) :=
by
  have hPart1 :
      (∃ (t₀ : ↥V), t₀ ≠ 0 ∧ ∀ (Q : Ideal ↥V) [Q.IsPrime], t₀ ∉ Q ↔ Q = ⊥) ∧
      (∀ (P : Ideal ↥V) [P.IsPrime], P ≠ ⊥ →
        (∃ (t_z : ↥V), t_z ∉ P ∧ ∀ (Q : Ideal ↥V) [Q.IsPrime], t_z ∉ Q ↔ Q ≤ P) ∧
        ∀ (t_z : ↥V), t_z ∉ P →
          (∀ (Q : Ideal ↥V) [Q.IsPrime], t_z ∉ Q ↔ Q ≤ P) →
          ∀ (R_z : Type u) [CommRing R_z] [Algebra ↥V R_z] [IsLocalization.Away t_z R_z],
            IsLocalization.AtPrime R_z P) := by
    have hFin : Set.Finite (Set.univ : Set (PrimeSpectrum ↥V)) := hPkg.1
    have hAvoid : ∀ (P₀ : Ideal ↥V) [P₀.IsPrime],
        ∃ (t : ↥V), t ∉ P₀ ∧ ∀ (Q : Ideal ↥V) [Q.IsPrime], t ∉ Q ↔ Q ≤ P₀ := by
      intro P₀ hP₀
      classical
      have : Finite (PrimeSpectrum ↥V) := Set.finite_univ_iff.mp hFin
      let _ : Fintype (PrimeSpectrum ↥V) := Fintype.ofFinite (PrimeSpectrum ↥V)
      let F : Finset (PrimeSpectrum ↥V) :=
        Finset.univ.filter (fun q => ¬ (q.asIdeal ≤ P₀))
      have hx : ∀ q : PrimeSpectrum ↥V, ¬ (q.asIdeal ≤ P₀) → ∃ x : ↥V, x ∈ q.asIdeal ∧ x ∉ P₀ :=
        fun _ hnotle => SetLike.not_le_iff_exists.mp hnotle
      let x_fn : PrimeSpectrum ↥V → ↥V := fun q =>
        if h : ¬ (q.asIdeal ≤ P₀) then Classical.choose (hx q h) else 1
      have hx_mem : ∀ q ∈ F, x_fn q ∈ q.asIdeal ∧ x_fn q ∉ P₀ := by
        intro q hq
        have hnotle : ¬ (q.asIdeal ≤ P₀) := (Finset.mem_filter.mp hq).2
        have hfn : x_fn q = Classical.choose (hx q hnotle) := dif_pos hnotle
        rw [hfn]
        exact Classical.choose_spec (hx q hnotle)
      have ht_notMem : (∏ q ∈ F, x_fn q) ∉ P₀ := by
        have hprod : ∀ (S : Finset (PrimeSpectrum ↥V)),
            (∀ q ∈ S, x_fn q ∉ P₀) → (∏ q ∈ S, x_fn q) ∉ P₀ := by
          intro S
          refine Finset.induction_on S ?_ ?_
          · intro _
            simp only [Finset.prod_empty]
            exact fun h1 => hP₀.ne_top (Ideal.eq_top_of_isUnit_mem P₀ h1 isUnit_one)
          · intro a S ha ih hS
            rw [Finset.prod_insert ha]
            exact hP₀.mul_notMem (hS a (Finset.mem_insert_self a S))
              (ih (fun q hq => hS q (Finset.mem_insert_of_mem hq)))
        exact hprod F (fun q hq => (hx_mem q hq).2)
      refine ⟨∏ q ∈ F, x_fn q, ht_notMem, ?_⟩
      intro Q hQ
      constructor
      · intro htQ
        by_contra hnotle
        let qQ : PrimeSpectrum ↥V := ⟨Q, hQ⟩
        have hqF : qQ ∈ F := Finset.mem_filter.mpr ⟨Finset.mem_univ qQ, hnotle⟩
        rcases Finset.dvd_prod_of_mem x_fn hqF with ⟨c, hc⟩
        apply htQ
        rw [hc]
        exact Q.mul_mem_right c (hx_mem qQ hqF).1
      · intro hle htQ
        exact ht_notMem (hle htQ)
    refine ⟨?_, ?_⟩
    · obtain ⟨t₀, ht₀_bot, ht₀_iff⟩ := hAvoid (⊥ : Ideal ↥V)
      refine ⟨t₀, ?_, ?_⟩
      · rwa [Ideal.mem_bot] at ht₀_bot
      · intro Q hQ
        rw [ht₀_iff Q, le_bot_iff]
    · intro P hP _
      refine ⟨hAvoid P, ?_⟩
      intro t_z ht_z ht_z_iff R_z _ _ _
      refine ⟨?_, ?_, ?_⟩
      · rintro ⟨s, hs⟩
        by_contra hnu
        have hne_top : Ideal.span {algebraMap ↥V R_z s} ≠ ⊤ :=
          mt Ideal.span_singleton_eq_top.mp hnu
        obtain ⟨M, hM_max, hle_M⟩ := Ideal.exists_le_maximal _ hne_top
        haveI : M.IsPrime := hM_max.isPrime
        let Q : Ideal ↥V := Ideal.comap (algebraMap ↥V R_z) M
        haveI : Q.IsPrime := Ideal.comap_isPrime (algebraMap ↥V R_z) M
        have htz_unit : IsUnit (algebraMap ↥V R_z t_z) :=
          IsLocalization.Away.algebraMap_isUnit t_z
        have htz_notM : algebraMap ↥V R_z t_z ∉ M :=
          fun hmem => hM_max.ne_top (Ideal.eq_top_of_isUnit_mem M hmem htz_unit)
        have hQ_le_P : Q ≤ P := (ht_z_iff Q).mp htz_notM
        have hs_mem_M : algebraMap ↥V R_z s ∈ M :=
          hle_M (Ideal.mem_span_singleton_self _)
        exact hs (hQ_le_P hs_mem_M)
      · intro z
        obtain ⟨⟨v, ⟨t', ht'⟩⟩, hz⟩ := IsLocalization.surj (Submonoid.powers t_z) z
        rcases ht' with ⟨k, rfl⟩
        exact ⟨⟨v, ⟨t_z ^ k, Submonoid.pow_mem P.primeCompl ht_z k⟩⟩, hz⟩
      · intro x y hxy
        obtain ⟨⟨t', ht'⟩, heq⟩ :=
          (IsLocalization.eq_iff_exists (Submonoid.powers t_z) R_z).mp hxy
        rcases ht' with ⟨k, rfl⟩
        exact ⟨⟨t_z ^ k, Submonoid.pow_mem P.primeCompl ht_z k⟩, heq⟩
  have hPart2 :
      ∀ [HenselianLocalRing ↥V] (P : Ideal ↥V) [hP : P.IsPrime] [IsAlgClosed P.ResidueField]
        (R_z : Type u) [CommRing R_z] [Algebra ↥V R_z] [IsLocalization.AtPrime R_z P]
        (I : Ideal R_z), I ≠ ⊤ →
        ∃ (hHens : HenselianLocalRing (R_z ⧸ I)),
          letI : HenselianLocalRing (R_z ⧸ I) := hHens
          IsAlgClosed (IsLocalRing.ResidueField (R_z ⧸ I)) ∧
          ∀ (C₀ : Type u) [CommRing C₀] [Algebra (R_z ⧸ I) C₀] (q_z : Ideal C₀) [q_z.IsPrime],
            Ideal.comap (algebraMap ↥V R_z)
              (Ideal.comap (algebraMap R_z (R_z ⧸ I))
                (Ideal.comap (algebraMap (R_z ⧸ I) C₀) q_z)) = P →
            Ideal.comap (algebraMap (R_z ⧸ I) C₀) q_z = IsLocalRing.maximalIdeal (R_z ⧸ I) := by
    intro _ P hP _ R_z _ _ _ I hI
    let _ : IsLocalRing R_z := IsLocalization.AtPrime.isLocalRing R_z P
    have hm_pre : ∀ x ∈ IsLocalRing.maximalIdeal R_z, ∃ p ∈ P, algebraMap ↥V R_z p = x := by
      intro x hx
      obtain ⟨⟨v, s⟩, hxs⟩ := IsLocalization.surj P.primeCompl x
      have hv_max : algebraMap ↥V R_z v ∈ IsLocalRing.maximalIdeal R_z := by
        rw [← hxs]
        exact (IsLocalRing.maximalIdeal R_z).mul_mem_right _ hx
      have hv_P : v ∈ P := by
        rw [← IsLocalization.AtPrime.under_maximalIdeal R_z P]
        exact hv_max
      rcases ValuationRing.dvd_total v s.1 with ⟨w, hw⟩ | ⟨p, hp⟩
      · exfalso
        apply s.2
        rw [hw]
        exact P.mul_mem_right w hv_P
      · have hp_P : p ∈ P :=
          (hP.mem_or_mem (hp ▸ hv_P)).resolve_left s.2
        refine ⟨p, hp_P, ?_⟩
        have hs_unit : IsUnit (algebraMap ↥V R_z s.1) := IsLocalization.map_units R_z s
        apply hs_unit.mul_right_cancel
        rw [hxs, hp, map_mul, mul_comm (algebraMap ↥V R_z s.1)]
    have hHensRz : HenselianLocalRing R_z := by
      refine HenselianLocalRing.mk ?_
      intro f hf a₀ hfa₀ hf'a₀
      by_cases hzero : f.eval a₀ = 0
      · exact ⟨a₀, hzero, by simp⟩
      · classical
        let g : Polynomial R_z := f.comp (Polynomial.X + Polynomial.C a₀)
        let d : ℕ := f.natDegree
        have hXC_deg : (Polynomial.X + Polynomial.C a₀).natDegree = 1 :=
          Polynomial.natDegree_X_add_C a₀
        have hg_deg_lt : g.natDegree < d + 1 := by
          have hle : g.natDegree ≤ d * (Polynomial.X + Polynomial.C a₀).natDegree :=
            Polynomial.natDegree_comp_le
          rw [hXC_deg, mul_one] at hle
          exact Nat.lt_succ_of_le hle
        have hd_pos : 1 ≤ d := by
          by_contra hd0
          have hd_eq : f.natDegree = 0 := by omega
          have hf1 : f = 1 := Polynomial.eq_one_of_monic_natDegree_zero hf hd_eq
          rw [hf1, Polynomial.eval_one] at hfa₀
          exact (IsLocalRing.maximalIdeal.isMaximal R_z).ne_top
            (Ideal.eq_top_of_isUnit_mem _ hfa₀ isUnit_one)
        have hc₀_eq : g.coeff 0 = f.eval a₀ := by
          rw [Polynomial.coeff_zero_eq_eval_zero]
          simp [g, Polynomial.eval_comp]
        have hc₁_eq : g.coeff 1 = f.derivative.eval a₀ := by
          have h1 : g.derivative.eval 0 = f.derivative.eval a₀ := by
            simp [g, Polynomial.derivative_comp, Polynomial.eval_comp]
          rw [← h1, ← Polynomial.coeff_zero_eq_eval_zero, Polynomial.coeff_derivative]
          simp
        let u₁ : R_zˣ := hf'a₀.unit
        have hu₁ : (u₁ : R_z) = g.coeff 1 := by simp [u₁, hc₁_eq]
        let ε : R_z := - (g.coeff 0) * ↑(u₁⁻¹)
        have hε_mem : ε ∈ IsLocalRing.maximalIdeal R_z := by
          dsimp [ε]
          rw [hc₀_eq]
          exact (IsLocalRing.maximalIdeal R_z).mul_mem_right _
            ((IsLocalRing.maximalIdeal R_z).neg_mem hfa₀)
        have hc₁ε : g.coeff 1 * ε = - g.coeff 0 := by
          dsimp [ε]
          rw [← hu₁]
          calc (u₁ : R_z) * (- g.coeff 0 * ↑(u₁⁻¹))
              = - g.coeff 0 * ((u₁ : R_z) * ↑(u₁⁻¹)) := by ring
            _ = - g.coeff 0 := by simp
        let w : ℕ → R_z := fun k => - (g.coeff k) * ↑(u₁⁻¹) * ε ^ (k - 1)
        have hw_mem : ∀ k ∈ Finset.Icc 2 d, w k ∈ IsLocalRing.maximalIdeal R_z := by
          intro k hk
          have hk2 : 2 ≤ k := (Finset.mem_Icc.mp hk).1
          have hpow : ε ^ (k - 1) ∈ IsLocalRing.maximalIdeal R_z :=
            Ideal.pow_mem_of_mem _ hε_mem _ (by omega)
          exact (IsLocalRing.maximalIdeal R_z).mul_mem_left _ hpow
        have hw_rel : ∀ k ∈ Finset.Icc 2 d, g.coeff 0 * w k = g.coeff k * ε ^ k := by
          intro k hk
          have hk2 : 2 ≤ k := (Finset.mem_Icc.mp hk).1
          have hpow_eq : ε * ε ^ (k - 1) = ε ^ k := by
            rw [← pow_succ', Nat.sub_add_cancel (by omega)]
          dsimp [w]
          calc g.coeff 0 * (- g.coeff k * ↑(u₁⁻¹) * ε ^ (k - 1))
              = g.coeff k * ((- g.coeff 0 * ↑(u₁⁻¹)) * ε ^ (k - 1)) := by ring
            _ = g.coeff k * (ε * ε ^ (k - 1)) := by rfl
            _ = g.coeff k * ε ^ k := by rw [hpow_eq]
        let b : ℕ → ↥V := fun k =>
          if hk : k ∈ Finset.Icc 2 d then Classical.choose (hm_pre (w k) (hw_mem k hk)) else 0
        have hP_le_mV : P ≤ IsLocalRing.maximalIdeal ↥V := IsLocalRing.le_maximalIdeal hP.ne_top
        have hb_spec : ∀ k ∈ Finset.Icc 2 d,
            b k ∈ IsLocalRing.maximalIdeal ↥V ∧ algebraMap ↥V R_z (b k) = w k := by
          intro k hk
          have hb_eq : b k = Classical.choose (hm_pre (w k) (hw_mem k hk)) := dif_pos hk
          rw [hb_eq]
          obtain ⟨hpP, hp_map⟩ := Classical.choose_spec (hm_pre (w k) (hw_mem k hk))
          exact ⟨hP_le_mV hpP, hp_map⟩
        let q_tail : Polynomial ↥V :=
          - Polynomial.X ^ (d - 1) + ∑ k ∈ Finset.Icc 2 d, Polynomial.C (b k) * Polynomial.X ^ (d - k)
        let H : Polynomial ↥V := Polynomial.X ^ d + q_tail
        have hsum_deg :
            (∑ k ∈ Finset.Icc 2 d, Polynomial.C (b k) * Polynomial.X ^ (d - k)).degree <
              (d : WithBot ℕ) := by
          have haux : ∀ (S : Finset ℕ), (∀ k ∈ S, d - k < d) →
              (∑ k ∈ S, Polynomial.C (b k) * Polynomial.X ^ (d - k)).degree < (d : WithBot ℕ) := by
            intro S
            refine Finset.induction_on S ?_ ?_
            · intro _
              simp only [Finset.sum_empty, Polynomial.degree_zero]
              exact WithBot.bot_lt_coe d
            · intro k S hk ih hS
              rw [Finset.sum_insert hk]
              refine lt_of_le_of_lt (Polynomial.degree_add_le _ _)
                (max_lt ?_ (ih (fun j hj => hS j (Finset.mem_insert_of_mem hj))))
              refine lt_of_le_of_lt (Polynomial.degree_C_mul_X_pow_le (d - k) (b k)) ?_
              exact WithBot.coe_lt_coe.mpr (hS k (Finset.mem_insert_self k S))
          refine haux (Finset.Icc 2 d) ?_
          intro k hk
          exact Nat.sub_lt hd_pos (lt_of_lt_of_le (by decide : 0 < 2) (Finset.mem_Icc.mp hk).1)
        have hH_monic : H.Monic := by
          refine (Polynomial.monic_X_pow d).add_of_left ?_
          rw [Polynomial.degree_X_pow]
          refine lt_of_le_of_lt (Polynomial.degree_add_le _ _) (max_lt ?_ hsum_deg)
          rw [Polynomial.degree_neg, Polynomial.degree_X_pow]
          exact WithBot.coe_lt_coe.mpr (Nat.sub_lt hd_pos zero_lt_one)
        have hH_eval1 : H.eval 1 ∈ IsLocalRing.maximalIdeal ↥V := by
          have hev : H.eval 1 = ∑ k ∈ Finset.Icc 2 d, b k := by
            simp [H, q_tail, Polynomial.eval_add, Polynomial.eval_neg, Polynomial.eval_pow,
              Polynomial.eval_finsetSum]
          rw [hev]
          exact Ideal.sum_mem _ (fun k hk => (hb_spec k hk).1)
        have hH_deriv1 : IsUnit (H.derivative.eval 1) := by
          have hdev : H.derivative.eval 1 =
              1 + ∑ k ∈ Finset.Icc 2 d, b k * ((d - k : ℕ) : ↥V) := by
            simp only [H, q_tail, Polynomial.derivative_add, Polynomial.derivative_neg,
              Polynomial.derivative_X_pow, map_sum, Polynomial.derivative_C_mul_X_pow,
              Polynomial.eval_add, Polynomial.eval_neg, Polynomial.eval_mul,
              Polynomial.eval_natCast, Polynomial.eval_pow, Polynomial.eval_X,
              Polynomial.eval_finsetSum, Polynomial.eval_C, one_pow, mul_one]
            have hd_cast : (d : ↥V) + - ((d - 1 : ℕ) : ↥V) = 1 := by
              have hd1 : d = (d - 1) + 1 := (Nat.sub_add_cancel hd_pos).symm
              conv_lhs => rw [hd1]
              push_cast
              ring
            rw [← add_assoc, hd_cast]
          rw [hdev, ← IsLocalRing.notMem_maximalIdeal]
          intro hmem
          have hsum_m : ∑ k ∈ Finset.Icc 2 d, b k * ((d - k : ℕ) : ↥V) ∈
              IsLocalRing.maximalIdeal ↥V :=
            Ideal.sum_mem _ (fun k hk =>
              (IsLocalRing.maximalIdeal ↥V).mul_mem_right _ (hb_spec k hk).1)
          have h1_m : (1 : ↥V) ∈ IsLocalRing.maximalIdeal ↥V := by
            have hsub := (IsLocalRing.maximalIdeal ↥V).sub_mem hmem hsum_m
            rwa [add_sub_cancel_right] at hsub
          exact (IsLocalRing.maximalIdeal.isMaximal ↥V).ne_top
            (Ideal.eq_top_of_isUnit_mem _ h1_m isUnit_one)
        obtain ⟨u, hu_root, hu_mem⟩ :=
          HenselianLocalRing.is_henselian H hH_monic 1 hH_eval1 hH_deriv1
        have hu_unit : IsUnit u := by
          rw [← IsLocalRing.notMem_maximalIdeal]
          intro hum
          have h1_m : (1 : ↥V) ∈ IsLocalRing.maximalIdeal ↥V := by
            have hsub := (IsLocalRing.maximalIdeal ↥V).sub_mem hum hu_mem
            rwa [sub_sub_cancel] at hsub
          exact (IsLocalRing.maximalIdeal.isMaximal ↥V).ne_top
            (Ideal.eq_top_of_isUnit_mem _ h1_m isUnit_one)
        let v_u : R_zˣ := (hu_unit.map (algebraMap ↥V R_z)).unit
        have hv_u : (v_u : R_z) = algebraMap ↥V R_z u := by simp [v_u]
        let y : R_z := ε * ↑(v_u⁻¹)
        refine ⟨a₀ + y, ?_, ?_⟩
        · have hfa_eq : f.eval (a₀ + y) = g.eval y := by
            simp [g, Polynomial.eval_comp, add_comm]
          rw [Polynomial.IsRoot.def, hfa_eq]
          have hvu_pow_unit : IsUnit ((v_u : R_z) ^ d) := (v_u ^ d).isUnit
          apply hvu_pow_unit.mul_left_cancel
          rw [mul_zero]
          have hgeval : g.eval y = ∑ k ∈ Finset.range (d + 1), g.coeff k * y ^ k :=
            Polynomial.eval_eq_sum_range' hg_deg_lt y
          have hrange_split : Finset.range (d + 1) = insert 0 (insert 1 (Finset.Icc 2 d)) := by
            ext k
            simp only [Finset.mem_range, Finset.mem_insert, Finset.mem_Icc]
            omega
          have h0_not : (0 : ℕ) ∉ insert 1 (Finset.Icc 2 d) := by simp
          have h1_not : (1 : ℕ) ∉ Finset.Icc 2 d := by simp
          have hy_pow : ∀ k ≤ d, (v_u : R_z) ^ d * (g.coeff k * y ^ k) =
              (g.coeff k * ε ^ k) * (algebraMap ↥V R_z u) ^ (d - k) := by
            intro k hk
