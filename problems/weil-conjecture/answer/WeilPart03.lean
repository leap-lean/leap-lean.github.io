        have hck_ne : c k ≠ 0 := by
          intro h0; dsimp [term] at htk_pos; rw [h0, map_zero, zero_mul, norm_zero] at htk_pos; linarith
        have hrest_lt : ∀ j ∈ I.erase k, ‖term j‖ < ‖term k‖ := by
          intro j hj
          have hj_ne : j ≠ k := (Finset.mem_erase.mp hj).1
          have hj_mem : j ∈ I := (Finset.mem_erase.mp hj).2
          apply lt_of_le_of_ne (hk_max j hj_mem)
          intro heq
          by_cases hcj : c j = 0
          · dsimp [term] at heq; rw [hcj, map_zero, zero_mul, norm_zero] at heq; linarith
          · dsimp [term] at heq
