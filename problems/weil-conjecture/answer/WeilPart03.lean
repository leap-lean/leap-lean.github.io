    refine ⟨hiff, ?_⟩
    by_cases hFin₁ : FiniteDimensional ↥L₁ F_hat
    · exact le_antisymm (h21 (h12 hFin₁).1).2 (h12 hFin₁).2
    · have hFin₂ : ¬ FiniteDimensional ↥L₂ F_hat := mt hiff.mpr hFin₁
      rw [Module.finrank_of_not_finite hFin₁, Module.finrank_of_not_finite hFin₂]
  have h_s2 : ∀ (L : Subfield F_hat), (∃ c ∈ L, 1 < ‖c‖) →
      let OF : ValuationSubring F_hat := (NormedField.valuation (K := F_hat)).valuationSubring
