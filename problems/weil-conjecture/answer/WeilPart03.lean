            change ‖algebraMap K_hat F_hat c.1 - algebraMap K_hat F_hat e‖ < 1
            rw [← map_sub, hIsoK]
            exact he_lt
          have hdiff_res : IsLocalRing.residue ↥OF
              (⟨algebraMap K_hat F_hat c.1, c.2⟩ - ⟨z_e.1, (hMemOF _).mpr (hE0x_norm _ z_e.2)⟩) = 0 :=
            (hResZero _).mpr hdiff_lt
          rw [map_sub] at hdiff_res
          exact (sub_eq_zero.mp hdiff_res).symm
        · exact ⟨⟨x, hx_E0x⟩, rfl⟩
    let ψ_to_Kx : ↥E0x →+* ↥Kx_res :=
      ψ_0.codRestrict Kx_res.toSubring (fun z => hψ0_range ▸ ⟨z, rfl⟩)
    have hψ_surj : Function.Surjective ψ_to_Kx := by
      intro y
      have hy_mem : y.1 ∈ ψ_0.fieldRange := hψ0_range.symm ▸ y.2
      obtain ⟨z, hz⟩ := hy_mem
      exact ⟨z, Subtype.ext hz⟩
    let ψ_x : ↥E0x ≃+* ↥Kx_res := RingEquiv.ofBijective ψ_to_Kx ⟨ψ_to_Kx.injective, hψ_surj⟩
    obtain ⟨α_bar, hα_prim⟩ := Field.exists_primitive_element ↥Kx_res κF
    have hInt_α : _root_.IsIntegral ↥Kx_res α_bar := Algebra.IsIntegral.isIntegral α_bar
    let bar_f : Polynomial ↥Kx_res := minpoly ↥Kx_res α_bar
    have hbar_monic : bar_f.Monic := minpoly.monic hInt_α
    have hbar_sep : bar_f.Separable := Algebra.IsSeparable.isSeparable ↥Kx_res α_bar
    let d₀ : ℕ := bar_f.natDegree
    have hd₀_pos : 0 < d₀ := minpoly.natDegree_pos hInt_α
    let f_coeff : Polynomial ↥E0x := bar_f.map ψ_x.symm.toRingHom
    have hfc_monic : f_coeff.Monic := hbar_monic.map ψ_x.symm.toRingHom
    have hfc_sep : f_coeff.Separable := hbar_sep.map
    have hfc_deg : f_coeff.natDegree = d₀ := hbar_monic.natDegree_map ψ_x.symm.toRingHom
    let ι_int : ↥E0x →+* ↥OLx :=
      { toFun := fun z => ⟨⟨z.1, hE0x_le_Lx z.2⟩, (hMemOF z.1).mpr (hE0x_norm z.1 z.2)⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    let φ : ↥OLx →+* ↥OF :=
      (Lx.subtype.comp OLx.subtype).codRestrict OF.toSubring (fun y => y.2)
    let f_int : Polynomial ↥OLx := f_coeff.map ι_int
    have hfi_monic : f_int.Monic := hfc_monic.map ι_int
    have hfi_deg : f_int.natDegree = d₀ := (hfc_monic.natDegree_map ι_int).trans hfc_deg
    let f_OF : Polynomial ↥OF := f_int.map φ
    let F_poly : Polynomial F_hat := f_OF.map OF.subtype
    have hF_coeff : ∀ k : ℕ, ‖F_poly.coeff k‖ ≤ 1 := by
      intro k
      dsimp [F_poly]
      rw [Polynomial.coeff_map]
      exact (hMemOF _).mp (f_OF.coeff k).2
    have hf_OF_res : f_OF.map (IsLocalRing.residue ↥OF) = bar_f.map Kx_res.subtype := by
      dsimp [f_OF, f_int, f_coeff]
      rw [Polynomial.map_map, Polynomial.map_map, Polynomial.map_map]
      congr 1
      ext y
      change ψ_0 (ψ_x.symm y) = y.1
      change (ψ_x (ψ_x.symm y)).1 = y.1
      rw [ψ_x.apply_symm_apply]
    obtain ⟨y₀_OF, hy₀_res⟩ := IsLocalRing.residue_surjective (R := ↥OF) α_bar
    let y₀ : F_hat := y₀_OF.1
    have hy₀_norm : ‖y₀‖ ≤ 1 := (hMemOF y₀).mp y₀_OF.2
    have hFy₀_lt : ‖F_poly.eval y₀‖ < 1 := by
      have hev_coe : F_poly.eval y₀ = ((Polynomial.eval y₀_OF f_OF : ↥OF) : F_hat) := by
        dsimp [F_poly, y₀]
        rw [Polynomial.eval_map]
        exact Polynomial.eval₂_hom OF.subtype y₀_OF
      rw [hev_coe, ← hResZero]
      rw [← Polynomial.eval₂_hom, ← Polynomial.eval_map, hf_OF_res, hy₀_res, Polynomial.eval_map]
      change Polynomial.aeval α_bar bar_f = 0
      exact minpoly.aeval ↥Kx_res α_bar
    have hdFy₀_eq : ‖(Polynomial.derivative F_poly).eval y₀‖ = 1 := by
      let df_val : ↥OF := Polynomial.eval y₀_OF (Polynomial.derivative f_OF)
      have hd_coe : (Polynomial.derivative F_poly).eval y₀ = (df_val : F_hat) := by
        dsimp [F_poly, y₀, df_val]
        rw [Polynomial.derivative_map, Polynomial.eval_map]
        exact Polynomial.eval₂_hom OF.subtype y₀_OF
      rw [hd_coe]
      have hle : ‖(df_val : F_hat)‖ ≤ 1 := (hMemOF _).mp df_val.2
      have hres_ne : IsLocalRing.residue ↥OF df_val ≠ 0 := by
        dsimp [df_val]
        rw [← Polynomial.eval₂_hom, ← Polynomial.eval_map, ← Polynomial.derivative_map,
          hf_OF_res, hy₀_res, Polynomial.derivative_map, Polynomial.eval_map]
        change Polynomial.aeval α_bar (Polynomial.derivative bar_f) ≠ 0
        obtain ⟨u, v, huv⟩ := hbar_sep
        intro hd0
        have h1 := congrArg (Polynomial.aeval α_bar) huv
        rw [map_add, map_mul, map_mul, map_one, minpoly.aeval ↥Kx_res α_bar,
          mul_zero, hd0, mul_zero, add_zero] at h1
        exact zero_ne_one h1
      have hge : 1 ≤ ‖(df_val : F_hat)‖ :=
        not_lt.mp fun hlt => hres_ne ((hResZero _).mpr hlt)
      exact le_antisymm hle hge
    obtain ⟨θ, hθ_le, hθ_dist, hθ_eval, hθ_deriv⟩ :=
      hs3_hensel F_poly hF_coeff y₀ hy₀_norm hFy₀_lt hdFy₀_eq
    have hθ_OF : θ ∈ OF := (hMemOF θ).mpr hθ_le
    let θ_OF : ↥OF := ⟨θ, hθ_OF⟩
    have hθ_res : IsLocalRing.residue ↥OF θ_OF = α_bar := by
      have hdiff : IsLocalRing.residue ↥OF (θ_OF - y₀_OF) = 0 := (hResZero _).mpr hθ_dist
      rw [map_sub] at hdiff
      exact (sub_eq_zero.mp hdiff).trans hy₀_res
    have hf_int_root :
        (letI : Algebra ↥OLx ↥OF := φ.toAlgebra
         Polynomial.aeval θ_OF f_int = 0) := by
      letI : Algebra ↥OLx ↥OF := φ.toAlgebra
      apply Subtype.ext
      have h1 : ((Polynomial.aeval θ_OF f_int : ↥OF) : F_hat) = F_poly.eval θ := by
        dsimp [F_poly, f_OF]
        rw [Polynomial.eval_map, Polynomial.eval₂_map]
        change OF.subtype (Polynomial.eval₂ φ θ_OF f_int) = _
        rw [Polynomial.hom_eval₂]
        rfl
      exact h1.trans hθ_eval
    have hf_int_deriv :
        (letI : Algebra ↥OLx ↥OF := φ.toAlgebra
         ‖((Polynomial.aeval θ_OF (Polynomial.derivative f_int) : ↥OF) : F_hat)‖ = 1) := by
      letI : Algebra ↥OLx ↥OF := φ.toAlgebra
      let df_int : Polynomial ↥OLx := Polynomial.derivative f_int
      have hdf_eq : Polynomial.derivative F_poly = (df_int.map φ).map OF.subtype := by
        dsimp [F_poly, f_OF, df_int]
        rw [Polynomial.derivative_map, Polynomial.derivative_map]
      have h1 : ((Polynomial.aeval θ_OF df_int : ↥OF) : F_hat) =
          ((df_int.map φ).map OF.subtype).eval θ := by
        rw [Polynomial.eval_map, Polynomial.eval₂_map]
        change OF.subtype (Polynomial.eval₂ φ θ_OF df_int) = _
        rw [Polynomial.hom_eval₂]
        rfl
      change ‖((Polynomial.aeval θ_OF df_int : ↥OF) : F_hat)‖ = 1
      rw [h1, ← hdf_eq, hθ_deriv]
    letI : Algebra ↥E0x F_hat := E0x.toAlgebra
    let L_coeff_IF : IntermediateField ↥E0x F_hat := IntermediateField.adjoin ↥E0x ({θ} : Set F_hat)
    let L_coeff : Subfield F_hat := L_coeff_IF.toSubfield
    let K_unr_IF : IntermediateField ↥Lx F_hat := IntermediateField.adjoin ↥Lx ({θ} : Set F_hat)
    let K_unr : Subfield F_hat := K_unr_IF.toSubfield
    have hE0x_le_Lcoeff : E0x ≤ L_coeff := fun z hz => L_coeff_IF.algebraMap_mem ⟨z, hz⟩
    have hLx_le_Kunr : Lx ≤ K_unr := fun z hz => K_unr_IF.algebraMap_mem ⟨z, hz⟩
    have hθ_Lcoeff : θ ∈ L_coeff := IntermediateField.mem_adjoin_simple_self ↥E0x θ
    have hθ_Kunr : θ ∈ K_unr := IntermediateField.mem_adjoin_simple_self ↥Lx θ
    have hLcoeff_le_Kunr : L_coeff ≤ K_unr := by
      let K_unr_over_E0x : IntermediateField ↥E0x F_hat :=
        { K_unr with
          algebraMap_mem' := fun z => hLx_le_Kunr (hE0x_le_Lx z.2) }
      have h_le : L_coeff_IF ≤ K_unr_over_E0x := by
        rw [IntermediateField.adjoin_le_iff]
        rintro z rfl
        exact hθ_Kunr
      exact fun z hz => h_le hz
    have hfc_aeval : Polynomial.aeval θ f_coeff = 0 := by
      have h1 : Polynomial.aeval θ f_coeff = F_poly.eval θ := by
        dsimp [F_poly, f_OF, f_int]
        rw [Polynomial.map_map, Polynomial.map_map, Polynomial.eval_map]
        rfl
      exact h1.trans hθ_eval
    have hInt_E0x : _root_.IsIntegral ↥E0x θ := ⟨f_coeff, hfc_monic, hfc_aeval⟩
    have hLcoeff_norm : ∀ z ∈ L_coeff, ‖z‖ ≤ 1 := by
      intro z hz
      let pb := IntermediateField.adjoin.powerBasis hInt_E0x
      let z' : ↥L_coeff_IF := ⟨z, hz⟩
      have hz_repr := pb.basis.sum_repr z'
      have hz_coe : z = ∑ i : Fin pb.dim, ((pb.basis.repr z' i : ↥E0x) : F_hat) * θ ^ (i : ℕ) := by
        have h1 := congrArg (L_coeff_IF.val : ↥L_coeff_IF →+* F_hat) hz_repr.symm
        rw [map_sum] at h1
        refine h1.trans (Finset.sum_congr rfl fun i _ => ?_)
        rw [pb.basis_eq_pow, IntermediateField.adjoin.powerBasis_gen]
        rfl
      rw [hz_coe]
      refine hSumNormLe Finset.univ _ 1 zero_le_one fun i _ => ?_
      rw [norm_mul, norm_pow]
      have hc_le : ‖((pb.basis.repr z' i : ↥E0x) : F_hat)‖ ≤ 1 :=
        hE0x_norm _ (pb.basis.repr z' i).2
      have ht_le : ‖θ‖ ^ (i : ℕ) ≤ 1 := pow_le_one₀ (norm_nonneg θ) hθ_le
      exact (mul_le_mul hc_le ht_le (pow_nonneg (norm_nonneg θ) _) zero_le_one).trans (by linarith)
    let ρ_res : ↥L_coeff →+* κF :=
      (IsLocalRing.residue ↥OF).comp
        (L_coeff.subtype.codRestrict OF.toSubring (fun z => (hMemOF z.1).mpr (hLcoeff_norm z.1 z.2)))
    have hρ_surj : Function.Surjective ρ_res := by
      have hKx_le : Kx_res ≤ ρ_res.fieldRange := by
        rw [← hψ0_range]
        rintro _ ⟨z, rfl⟩
        exact ⟨⟨z.1, hE0x_le_Lcoeff z.2⟩, rfl⟩
      let R_IF : IntermediateField ↥Kx_res κF :=
        { ρ_res.fieldRange with
          algebraMap_mem' := fun y => hKx_le y.2 }
      have htop_le : (⊤ : IntermediateField ↥Kx_res κF) ≤ R_IF := by
        rw [← hα_prim, IntermediateField.adjoin_le_iff]
        rintro y rfl
        exact ⟨⟨θ, hθ_Lcoeff⟩, hθ_res⟩
      intro y
      exact htop_le (IntermediateField.mem_top (x := y))
    have hResApproxAll : ∀ w : F_hat, ‖w‖ ≤ 1 → ∃ z ∈ L_coeff, ‖w - z‖ < 1 := by
      intro w hw_le
      have hw_OF : w ∈ OF := (hMemOF w).mpr hw_le
      obtain ⟨z, hz_eq⟩ := hρ_surj (IsLocalRing.residue ↥OF ⟨w, hw_OF⟩)
      refine ⟨z.1, z.2, ?_⟩
      have hdiff : IsLocalRing.residue ↥OF
          (⟨w, hw_OF⟩ - ⟨z.1, (hMemOF z.1).mpr (hLcoeff_norm z.1 z.2)⟩) = 0 := by
        rw [map_sub, ← hz_eq]
        exact sub_self _
      exact (hResZero _).mp hdiff
    have hα_pow_ind : LinearIndependent ↥Kx_res (fun i : Fin d₀ => α_bar ^ (i : ℕ)) := by
      let pb_α := IntermediateField.adjoin.powerBasis hInt_α
      have hdim_eq : pb_α.dim = d₀ := IntermediateField.adjoin.powerBasis_dim hInt_α
      let e_fin : Fin d₀ ≃ Fin pb_α.dim := finCongr hdim_eq.symm
      have h_ind1 : LinearIndependent ↥Kx_res
          (fun i : Fin pb_α.dim => ((pb_α.basis i : ↥(IntermediateField.adjoin ↥Kx_res ({α_bar} : Set κF))) : κF)) :=
        pb_α.basis.linearIndependent.map'
          (IntermediateField.adjoin ↥Kx_res ({α_bar} : Set κF)).val.toLinearMap
          (LinearMap.ker_eq_bot.mpr Subtype.val_injective)
      have h_ind2 := h_ind1.comp e_fin e_fin.injective
      have hgen_α : ((pb_α.gen : ↥(IntermediateField.adjoin ↥Kx_res ({α_bar} : Set κF))) : κF) = α_bar := by
        rw [IntermediateField.adjoin.powerBasis_gen]
        rfl
      have h_fn_eq : ((fun i : Fin pb_α.dim =>
            ((pb_α.basis i : ↥(IntermediateField.adjoin ↥Kx_res ({α_bar} : Set κF))) : κF)) ∘ ⇑e_fin) =
          (fun i : Fin d₀ => α_bar ^ (i : ℕ)) := by
        ext i
        simp [Function.comp, pb_α.basis_eq_pow, hgen_α, e_fin]
      rwa [← h_fn_eq]
    let v_θ : Fin d₀ → ↥OF := fun i => θ_OF ^ (i : ℕ)
    have hv_θ_ind : LinearIndependent ↥Kx_res (fun i : Fin d₀ => IsLocalRing.residue ↥OF (v_θ i)) := by
      have h_eq : (fun i : Fin d₀ => IsLocalRing.residue ↥OF (v_θ i)) =
          (fun i : Fin d₀ => α_bar ^ (i : ℕ)) := by
        ext i
        dsimp [v_θ]
        rw [map_pow, hθ_res]
      rwa [h_eq]
    have hOrtho_d₀ : ∀ (a : Fin d₀ → ↥Lx) (j : Fin d₀),
        ‖(a j : F_hat)‖ ≤ ‖∑ i : Fin d₀, (a i : F_hat) * θ ^ (i : ℕ)‖ :=
      fun a j => hOrtho d₀ v_θ hv_θ_ind a j
    have hOrtho_fi : ∀ (a : Fin f_int.natDegree → ↥Lx) (j : Fin f_int.natDegree),
        ‖(a j : F_hat)‖ ≤ ‖∑ i : Fin f_int.natDegree, (a i : F_hat) * θ ^ (i : ℕ)‖ := by
      let e_fi : Fin f_int.natDegree ≃ Fin d₀ := finCongr hfi_deg
      intro a j
      have h1 := hOrtho_d₀ (a ∘ e_fi.symm) (e_fi j)
      simp only [Function.comp_apply, Equiv.symm_apply_apply] at h1
      refine h1.trans_eq ?_
      congr 1
      exact Fintype.sum_equiv e_fi.symm _ _ fun i => by simp [e_fi]
    let f_Lx : Polynomial ↥Lx := f_coeff.map (Subfield.inclusion hE0x_le_Lx)
    have hfLx_monic : f_Lx.Monic := hfc_monic.map (Subfield.inclusion hE0x_le_Lx)
    have hfLx_deg : f_Lx.natDegree = d₀ :=
      (hfc_monic.natDegree_map (Subfield.inclusion hE0x_le_Lx)).trans hfc_deg
    have hfLx_aeval : Polynomial.aeval θ f_Lx = 0 := by
      dsimp [f_Lx]
      rw [Polynomial.aeval_def, Polynomial.eval₂_map]
      exact hfc_aeval
    have hInt_Lx : _root_.IsIntegral ↥Lx θ := ⟨f_Lx, hfLx_monic, hfLx_aeval⟩
    have hmin_Lx_deg : (minpoly ↥Lx θ).natDegree = d₀ := by
      have hdvd : minpoly ↥Lx θ ∣ f_Lx := minpoly.dvd ↥Lx θ hfLx_aeval
      have hle : (minpoly ↥Lx θ).natDegree ≤ d₀ :=
        hfLx_deg ▸ Polynomial.natDegree_le_of_dvd hdvd hfLx_monic.ne_zero
      by_contra hne
      have hlt : (minpoly ↥Lx θ).natDegree < d₀ := lt_of_le_of_ne hle hne
      let M_θ := minpoly ↥Lx θ
      have hM_monic : M_θ.Monic := minpoly.monic hInt_Lx
      have hM_sum : ∑ i : Fin d₀, ((M_θ.coeff (i : ℕ) : ↥Lx) : F_hat) * θ ^ (i : ℕ) = 0 := by
        have h1 := minpoly.aeval ↥Lx θ
        have h2 : Polynomial.aeval θ M_θ =
            ∑ k ∈ Finset.range d₀, ((M_θ.coeff k : ↥Lx) : F_hat) * θ ^ k := by
          rw [Polynomial.aeval_def, Polynomial.eval₂_eq_sum_range' (algebraMap ↥Lx F_hat) hlt θ]
          rfl
        rw [h2, ← Fin.sum_univ_eq_sum_range] at h1
        exact h1
      let j_top : Fin d₀ := ⟨M_θ.natDegree, hlt⟩
      have hnorm0 := hOrtho_d₀ (fun i => M_θ.coeff (i : ℕ)) j_top
      rw [hM_sum, norm_zero] at hnorm0
      have htop1 : ((M_θ.coeff (j_top : ℕ) : ↥Lx) : F_hat) = 1 := by
        change ((M_θ.coeff M_θ.natDegree : ↥Lx) : F_hat) = 1
        rw [hM_monic.coeff_natDegree]
        rfl
      rw [htop1, norm_one] at hnorm0
      linarith
    have hKunr_span : ∀ u ∈ K_unr, ∃ a : Fin d₀ → ↥Lx,
        u = ∑ i : Fin d₀, (a i : F_hat) * θ ^ (i : ℕ) := by
      intro u hu
      let pb_Lx := IntermediateField.adjoin.powerBasis hInt_Lx
      have hdim_Lx : pb_Lx.dim = d₀ :=
        (IntermediateField.adjoin.powerBasis_dim hInt_Lx).trans hmin_Lx_deg
      let e_Lx : Fin d₀ ≃ Fin pb_Lx.dim := finCongr hdim_Lx.symm
      let u' : ↥K_unr_IF := ⟨u, hu⟩
      refine ⟨fun i => pb_Lx.basis.repr u' (e_Lx i), ?_⟩
      have h1 := congrArg (K_unr_IF.val : ↥K_unr_IF →+* F_hat) (pb_Lx.basis.sum_repr u').symm
      rw [map_sum] at h1
      refine h1.trans ?_
      refine (Fintype.sum_equiv e_Lx.symm _ _ fun j => ?_)
      simp only [Equiv.apply_symm_apply, pb_Lx.basis_eq_pow]
      rfl
    have hTopSpan : K_unr = ⊤ → ∀ w : F_hat, ∃ a : Fin f_int.natDegree → ↥Lx,
        w = ∑ i : Fin f_int.natDegree, (a i : F_hat) * θ ^ (i : ℕ) := by
      intro hTop w
      have hw_mem : w ∈ K_unr := by rw [hTop]; trivial
      obtain ⟨a, hw_eq⟩ := hKunr_span w hw_mem
      let e_fi : Fin f_int.natDegree ≃ Fin d₀ := finCongr hfi_deg
      refine ⟨a ∘ e_fi, ?_⟩
      rw [hw_eq]
      exact Fintype.sum_equiv e_fi.symm _ _ fun i => by simp [e_fi]
    have hθ_pow_ind : LinearIndependent ↥Lx (fun i : Fin d₀ => θ ^ (i : ℕ)) := by
      rw [Fintype.linearIndependent_iff]
      intro a ha j
      have ha_sum : ∑ i : Fin d₀, (a i : F_hat) * θ ^ (i : ℕ) = 0 := ha
      have hle0 := hOrtho_d₀ a j
      rw [ha_sum, norm_zero] at hle0
      exact Subtype.ext (norm_eq_zero.mp (le_antisymm hle0 (norm_nonneg _)))
    have hθ_pow_inj : Function.Injective (fun i : Fin d₀ => θ ^ (i : ℕ)) :=
      hθ_pow_ind.injective
    classical
    let B_fin : Finset F_hat := Finset.univ.image (fun i : Fin d₀ => θ ^ (i : ℕ))
    have hBfin_sub : (↑B_fin : Set F_hat) ⊆ (L_coeff : Set F_hat) := by
      intro b hb
      rw [Finset.mem_coe, Finset.mem_image] at hb
      obtain ⟨i, _, rfl⟩ := hb
      exact L_coeff.pow_mem hθ_Lcoeff (i : ℕ)
    have hBfin_span : ∀ u ∈ K_unr, ∃ c : F_hat → F_hat, (∀ b ∈ B_fin, c b ∈ Lx) ∧
        u = ∑ b ∈ B_fin, c b * b := by
      intro u hu
      obtain ⟨a, hu_eq⟩ := hKunr_span u hu
      let c : F_hat → F_hat := fun b =>
        if h : ∃ i : Fin d₀, θ ^ (i : ℕ) = b then (a (Classical.choose h) : F_hat) else 0
      refine ⟨c, ?_, ?_⟩
      · intro b _
        dsimp [c]
        split_ifs with h
        · exact (a (Classical.choose h)).2
        · exact Lx.zero_mem
      · rw [hu_eq]
        dsimp [B_fin]
        rw [Finset.sum_image (fun i₁ _ i₂ _ h => hθ_pow_inj h)]
        refine Finset.sum_congr rfl fun i _ => ?_
        have hex : ∃ k : Fin d₀, θ ^ (k : ℕ) = θ ^ (i : ℕ) := ⟨i, rfl⟩
        have hch : Classical.choose hex = i := hθ_pow_inj (Classical.choose_spec hex)
        simp [c, hex, hch]
    have hLx_closed : IsClosed (Lx : Set F_hat) :=
      Subfield.isClosed_topologicalClosure _
    have hKunr_closed : IsClosed (K_unr : Set F_hat) := by
      refine IsSeqClosed.isClosed fun useq u huseq_mem hu_lim => ?_
      choose aseq haseq using fun n => hKunr_span (useq n) (huseq_mem n)
      have hCauchy_u : CauchySeq useq := hu_lim.cauchySeq
      have hCoordConv : ∀ j : Fin d₀, ∃ lj : ↥Lx,
          Filter.Tendsto (fun n => (aseq n j : F_hat)) Filter.atTop (nhds (lj : F_hat)) := by
        intro j
        have hCauchy_j : CauchySeq (fun n => (aseq n j : F_hat)) := by
          rw [Metric.cauchySeq_iff] at hCauchy_u ⊢
          intro ε hε
          obtain ⟨N, hN⟩ := hCauchy_u ε hε
          refine ⟨N, fun n hn m hm => ?_⟩
          rw [dist_eq_norm]
          have hdiff_eq : useq n - useq m =
              ∑ i : Fin d₀, ((aseq n i - aseq m i : ↥Lx) : F_hat) * θ ^ (i : ℕ) := by
            rw [haseq n, haseq m, ← Finset.sum_sub_distrib]
            refine Finset.sum_congr rfl fun i _ => ?_
            rw [Subfield.coe_sub, sub_mul]
          have hle := hOrtho_d₀ (fun i => aseq n i - aseq m i) j
          rw [← hdiff_eq, Subfield.coe_sub] at hle
          exact hle.trans_lt (by simpa [dist_eq_norm] using hN n hn m hm)
        obtain ⟨l, hl_lim⟩ := cauchySeq_tendsto_of_complete hCauchy_j
        have hl_Lx : l ∈ Lx :=
          hLx_closed.mem_of_tendsto hl_lim (Filter.Eventually.of_forall fun n => (aseq n j).2)
        exact ⟨⟨l, hl_Lx⟩, hl_lim⟩
      choose l hl_lim using hCoordConv
      have hsum_lim : Filter.Tendsto
          (fun n => ∑ i : Fin d₀, (aseq n i : F_hat) * θ ^ (i : ℕ)) Filter.atTop
          (nhds (∑ i : Fin d₀, (l i : F_hat) * θ ^ (i : ℕ))) :=
        tendsto_finsetSum _ fun i _ => (hl_lim i).mul_const _
      have huseq_lim' : Filter.Tendsto useq Filter.atTop
          (nhds (∑ i : Fin d₀, (l i : F_hat) * θ ^ (i : ℕ))) := by
        simpa [← haseq] using hsum_lim
      have hu_eq : u = ∑ i : Fin d₀, (l i : F_hat) * θ ^ (i : ℕ) :=
        tendsto_nhds_unique hu_lim huseq_lim'
      rw [hu_eq]
      exact K_unr.sum_mem fun i _ => K_unr.mul_mem (hLx_le_Kunr (l i).2) (K_unr.pow_mem hθ_Kunr i)
    have hx_Lcoeff : x ∈ L_coeff := hE0x_le_Lcoeff hx_E0x
    have hE_sub_Lcoeff : ∀ e : ↥E_max, algebraMap K_hat F_hat (e : K_hat) ∈ L_coeff :=
      fun e => hE0x_le_Lcoeff (he_E0x e)
    have hLcoeff_min : ∀ (S : Subfield F_hat), E0x ≤ S → θ ∈ S → L_coeff ≤ S := by
      intro S hE_S hθ_S
      let S_IF : IntermediateField ↥E0x F_hat :=
        { S with algebraMap_mem' := fun y => hE_S y.2 }
      have h_le : L_coeff_IF ≤ S_IF := by
        rw [IntermediateField.adjoin_le_iff]
        rintro _ rfl
        exact hθ_S
      exact fun w hw => h_le hw
    have hKt_finSep :=
      hKt_helper θ E0x Φ_x rfl (fun _ => Iff.rfl) f_coeff hfc_monic hfc_sep hfc_aeval
        L_coeff hx_Lcoeff hE_sub_Lcoeff hE0x_le_Lcoeff hθ_Lcoeff hLcoeff_min
    have hRange_sub : Set.range (algebraMap K_hat F_hat) ⊆ (K_unr : Set F_hat) := by
      rintro _ ⟨c, rfl⟩
      exact hLx_le_Kunr (Subfield.le_topologicalClosure _
        ((IntermediateField.adjoin K_hat ({x} : Set F_hat)).algebraMap_mem c))
    have hMod : IsWeilType23ModRamified K_hat F_hat E_max K_unr := by
      refine ⟨hRange_sub, hKunr_closed, Or.inl ⟨x, L_coeff, hx_Lcoeff, hE_sub_Lcoeff,
        hLcoeff_le_Kunr, hGaussE, hLcoeff_norm, ?_, ?_, hKt_finSep, ⟨B_fin, hBfin_sub, hBfin_span⟩⟩⟩
      · intro u _ hu_ne
        exact hValEq u hu_ne
      · intro w _ hw_le
        exact hResApproxAll w hw_le
    have hFinKunr :
        (letI : Algebra ↥K_unr F_hat := K_unr.toAlgebra
         FiniteDimensional ↥K_unr F_hat) := by
      letI : Algebra ↥K_unr F_hat := K_unr.toAlgebra
      letI : Algebra ↥Lx ↥K_unr := (Subfield.inclusion hLx_le_Kunr).toAlgebra
      haveI : IsScalarTower ↥Lx ↥K_unr F_hat := IsScalarTower.of_algebraMap_eq' rfl
      exact Module.Finite.right ↥Lx ↥K_unr F_hat
    refine ⟨K_unr, f_int, θ, hθ_OF, hMod, hFinKunr, ?_, ?_,
      hfi_monic, hfi_deg.symm ▸ hd₀_pos, ⟨hf_int_root, hf_int_deriv⟩, hOrtho_fi, hTopSpan⟩
    · intro w hw_ne
      obtain ⟨c, hc⟩ := hValEq w hw_ne
      exact ⟨algebraMap K_hat F_hat c, hRange_sub ⟨c, rfl⟩, hc.trans (hIsoK c).symm⟩
    · intro w hw_le
      obtain ⟨z, hz_mem, hz_lt⟩ := hResApproxAll w hw_le
      exact ⟨z, hLcoeff_le_Kunr hz_mem, hLcoeff_norm z hz_mem, hz_lt⟩
  
  intro OF OK κF κ_hom K_res
  obtain ⟨E_max, hE_norm, hE_alg, hE_res, hKres_alg, hKres_eq⟩ := hs1_coeff
  refine ⟨E_max, hE_norm, hE_alg, hE_res, hKres_alg, hKres_eq, ?_⟩
  intro x hx x_res Kx_res Lx hTrans hFinLx
  obtain ⟨hGaussE, hValEq, hOrtho, hFinKx⟩ := hs2_gauss E_max hE_norm x hx hTrans hFinLx
  refine ⟨hFinKx, ?_⟩
  intro hSep
  obtain ⟨K_unr, f_int, θ, hθ, hMod, hFinU, hValU, hResU,
    hf_monic, hd₀_pos, ⟨hf_root, hf_deriv⟩, hOrthoθ, hTopSpan⟩ :=
    hs4_lift E_max hE_norm hE_res x hx hFinLx hFinKx hSep hGaussE hValEq hOrtho
  refine ⟨K_unr, hMod, hFinU, hValU, hResU, fun hTop => ?_⟩
  exact hs5_etale x hFinLx f_int θ hθ hf_monic hd₀_pos hf_root hf_deriv hOrthoθ (hTopSpan hTop)

theorem weil_type3_cyclic_valueGroup_generator (K_hat F_hat : Type u)
    [NontriviallyNormedField K_hat] [CompleteSpace K_hat]
    [IsUltrametricDist K_hat] [IsAlgClosed K_hat]
    [NontriviallyNormedField F_hat] [CompleteSpace F_hat]
    [IsUltrametricDist F_hat] [Algebra K_hat F_hat]
    (E_max : Subfield K_hat)
    (hIsoK : ∀ c : K_hat, ‖algebraMap K_hat F_hat c‖ = ‖c‖)
    (hResEq : ∀ z : F_hat, ‖z‖ ≤ 1 → ∃ c : K_hat, ‖z - algebraMap K_hat F_hat c‖ < 1)
    (hFinAll : ∀ z : F_hat, z ∉ Set.range (algebraMap K_hat F_hat) →
      let Lz : Subfield F_hat :=
        (IntermediateField.adjoin K_hat ({z} : Set F_hat)).toSubfield.topologicalClosure
      letI : Algebra ↥Lz F_hat := Lz.toAlgebra
      FiniteDimensional ↥Lz F_hat)
    (hIrr : ∃ w : F_hat, w ≠ 0 ∧ ∀ c : K_hat, ‖w‖ ≠ ‖c‖) :
    ∃ x₀ : F_hat,
      x₀ ∉ Set.range (algebraMap K_hat F_hat) ∧
      let Lx₀ : Subfield F_hat :=
        (IntermediateField.adjoin K_hat ({x₀} : Set F_hat)).toSubfield.topologicalClosure
      IsWeilType23ModRamified K_hat F_hat E_max Lx₀ ∧
      (letI : Algebra ↥Lx₀ F_hat := Lx₀.toAlgebra
       FiniteDimensional ↥Lx₀ F_hat) ∧
      (∀ w : F_hat, w ≠ 0 → ∃ u ∈ Lx₀, ‖w‖ = ‖u‖) ∧
      (∀ w : F_hat, ‖w‖ ≤ 1 → ∃ u ∈ Lx₀, ‖u‖ ≤ 1 ∧ ‖w - u‖ < 1) ∧
      (Lx₀ = ⊤ → IsWeilAnalyticUnramifiedGen K_hat F_hat x₀) :=
by
  
  have hUltraMaxSum : ∀ (ι : Type) [DecidableEq ι] (S : Finset ι) (f : ι → F_hat),
      S.Nonempty →
      (∀ i ∈ S, ∀ j ∈ S, i ≠ j → ‖f i‖ ≠ ‖f j‖) →
      ∃ i_max ∈ S, ‖∑ i ∈ S, f i‖ = ‖f i_max‖ := by
    intro ι _ S f
    induction S using Finset.induction with
    | empty =>
      intro hne
      exact False.elim (Finset.not_nonempty_empty hne)
    | @insert a s ha ih =>
      intro _ hDist
      rcases s.eq_empty_or_nonempty with rfl | hs
      · exact ⟨a, Finset.mem_insert_self a ∅, by simp⟩
      · obtain ⟨b, hb_mem, hb_eq⟩ := ih hs (fun i hi j hj hij =>
          hDist i (Finset.mem_insert_of_mem hi) j (Finset.mem_insert_of_mem hj) hij)
        have hab : a ≠ b := fun h => ha (h ▸ hb_mem)
        have hne_norm : ‖f a‖ ≠ ‖∑ i ∈ s, f i‖ := by
          rw [hb_eq]
          exact hDist a (Finset.mem_insert_self a s) b (Finset.mem_insert_of_mem hb_mem) hab
        have hadd : ‖f a + ∑ i ∈ s, f i‖ = max ‖f a‖ ‖∑ i ∈ s, f i‖ :=
          IsUltrametricDist.norm_add_eq_max_of_norm_ne_norm hne_norm
        rcases max_choice ‖f a‖ ‖f b‖ with hmax | hmax
        · exact ⟨a, Finset.mem_insert_self a s, by rw [Finset.sum_insert ha, hadd, hb_eq, hmax]⟩
        · exact ⟨b, Finset.mem_insert_of_mem hb_mem, by rw [Finset.sum_insert ha, hadd, hb_eq, hmax]⟩
  
  obtain ⟨w, hw_ne, hw_irr⟩ := hIrr
  set r : ℝ := ‖w‖
  have hr_pos : 0 < r := norm_pos_iff.mpr hw_ne
  have hr_ne : r ≠ 0 := ne_of_gt hr_pos
  have hNatIrr : ∀ (n : ℕ), 0 < n → ∀ c : K_hat, r ^ n ≠ ‖c‖ := by
    intro n hn c heq
    obtain ⟨d, hd⟩ := IsAlgClosed.exists_pow_nat_eq c hn
    rw [← hd, norm_pow] at heq
    have hrd : r = ‖d‖ := (pow_left_inj₀ (le_of_lt hr_pos) (norm_nonneg d) (ne_of_gt hn)).mp heq
    exact hw_irr d hrd
  have hZpowIrr : ∀ (k : ℤ), k ≠ 0 → ∀ c : K_hat, r ^ k ≠ ‖c‖ := by
    intro k hk c heq
    rcases lt_or_gt_of_ne hk with hk_neg | hk_pos
    · set n : ℕ := (-k).toNat
      have hn_eq : (n : ℤ) = -k := Int.toNat_of_nonneg (by omega)
      have hn_pos : 0 < n := by omega
      have hk_eq : k = -(n : ℤ) := by omega
      rw [hk_eq, zpow_neg, zpow_natCast] at heq
      have heq' : r ^ n = ‖c⁻¹‖ := by
        rw [norm_inv, ← heq, inv_inv]
      exact hNatIrr n hn_pos c⁻¹ heq'
    · set n : ℕ := k.toNat
      have hn_eq : (n : ℤ) = k := Int.toNat_of_nonneg (by omega)
      have hn_pos : 0 < n := by omega
      rw [← hn_eq, zpow_natCast] at heq
      exact hNatIrr n hn_pos c heq
  have hUniq : ∀ (c₁ c₂ : K_hat) (k₁ k₂ : ℤ),
      c₁ ≠ 0 → c₂ ≠ 0 → ‖c₁‖ * r ^ k₁ = ‖c₂‖ * r ^ k₂ → k₁ = k₂ := by
    intro c₁ c₂ k₁ k₂ hc₁ hc₂ heq
    by_contra hk_ne
    have hc₁_norm : ‖c₁‖ ≠ 0 := norm_ne_zero_iff.mpr hc₁
    have hrk₂ : r ^ k₂ ≠ 0 := zpow_ne_zero k₂ hr_ne
    have hsub : r ^ (k₁ - k₂) = ‖c₂ / c₁‖ := by
      rw [zpow_sub₀ hr_ne, norm_div, div_eq_div_iff hrk₂ hc₁_norm, mul_comm, heq]
    exact hZpowIrr (k₁ - k₂) (sub_ne_zero.mpr hk_ne) (c₂ / c₁) hsub
  
  have hPolyNorm : ∀ (P : Polynomial K_hat), P ≠ 0 →
      ∃ (c : K_hat) (k : ℤ), c ≠ 0 ∧ ‖Polynomial.aeval w P‖ = ‖c‖ * r ^ k ∧ Polynomial.aeval w P ≠ 0 := by
    intro P hP
    let term : ℕ → F_hat := fun i => algebraMap K_hat F_hat (P.coeff i) * w ^ i
    have hsum_eq : Polynomial.aeval w P = ∑ i ∈ P.support, term i := by
      rw [Polynomial.aeval_def, Polynomial.eval₂_def, Polynomial.sum_def]
    have hterm_norm : ∀ i : ℕ, ‖term i‖ = ‖P.coeff i‖ * r ^ (i : ℤ) := by
      intro i
      dsimp [term]
      rw [norm_mul, hIsoK, norm_pow, zpow_natCast]
    have hDist : ∀ i ∈ P.support, ∀ j ∈ P.support, i ≠ j → ‖term i‖ ≠ ‖term j‖ := by
      intro i hi j hj hij hnorm_eq
      rw [hterm_norm i, hterm_norm j] at hnorm_eq
      have hci : P.coeff i ≠ 0 := Polynomial.mem_support_iff.mp hi
      have hcj : P.coeff j ≠ 0 := Polynomial.mem_support_iff.mp hj
      have hij_z : (i : ℤ) = (j : ℤ) := hUniq (P.coeff i) (P.coeff j) (i : ℤ) (j : ℤ) hci hcj hnorm_eq
      exact hij (Nat.cast_injective hij_z)
    obtain ⟨i_max, hi_max, hmax_eq⟩ :=
      hUltraMaxSum ℕ P.support term (Polynomial.support_nonempty.mpr hP) hDist
    have hc_ne : P.coeff i_max ≠ 0 := Polynomial.mem_support_iff.mp hi_max
    have haeval_norm : ‖Polynomial.aeval w P‖ = ‖P.coeff i_max‖ * r ^ (i_max : ℤ) := by
      rw [hsum_eq, hmax_eq, hterm_norm]
    have haeval_pos : 0 < ‖Polynomial.aeval w P‖ := by
      rw [haeval_norm]
      exact mul_pos (norm_pos_iff.mpr hc_ne) (zpow_pos hr_pos (i_max : ℤ))
    exact ⟨P.coeff i_max, (i_max : ℤ), hc_ne, haeval_norm, norm_pos_iff.mp haeval_pos⟩
  
  let E_sub : Subfield F_hat :=
    { carrier := { x : F_hat | ∃ P Q : Polynomial K_hat, Q ≠ 0 ∧ x = Polynomial.aeval w P / Polynomial.aeval w Q }
      mul_mem' := by
        rintro _ _ ⟨P₁, Q₁, hQ₁, rfl⟩ ⟨P₂, Q₂, hQ₂, rfl⟩
        exact ⟨P₁ * P₂, Q₁ * Q₂, mul_ne_zero hQ₁ hQ₂, by rw [map_mul, map_mul, div_mul_div_comm]⟩
      one_mem' := ⟨1, 1, one_ne_zero, by simp⟩
      add_mem' := by
        rintro _ _ ⟨P₁, Q₁, hQ₁, rfl⟩ ⟨P₂, Q₂, hQ₂, rfl⟩
        obtain ⟨_, _, _, _, hQ₁_ev⟩ := hPolyNorm Q₁ hQ₁
        obtain ⟨_, _, _, _, hQ₂_ev⟩ := hPolyNorm Q₂ hQ₂
        refine ⟨P₁ * Q₂ + P₂ * Q₁, Q₁ * Q₂, mul_ne_zero hQ₁ hQ₂, ?_⟩
        rw [div_add_div _ _ hQ₁_ev hQ₂_ev]
        simp only [map_add, map_mul]
        ring
      zero_mem' := ⟨0, 1, one_ne_zero, by simp⟩
      neg_mem' := by
        rintro _ ⟨P, Q, hQ, rfl⟩
        exact ⟨-P, Q, hQ, by rw [map_neg, neg_div]⟩
      inv_mem' := by
        rintro _ ⟨P, Q, hQ, rfl⟩
        by_cases hP : P = 0
        · exact ⟨0, 1, one_ne_zero, by simp [hP]⟩
        · exact ⟨Q, P, hP, by rw [inv_div]⟩ }
  let E_if : IntermediateField K_hat F_hat :=
    { E_sub with
      algebraMap_mem' := fun c => ⟨Polynomial.C c, 1, one_ne_zero, by simp⟩ }
  have hw_E : w ∈ E_if := ⟨Polynomial.X, 1, one_ne_zero, by simp⟩
  have hSw_le : IntermediateField.adjoin K_hat ({w} : Set F_hat) ≤ E_if :=
    IntermediateField.adjoin_le_iff.mpr (Set.singleton_subset_iff.mpr hw_E)
  
  have hUltraEq : ∀ u s : F_hat, ‖u - s‖ < ‖u‖ → ‖u‖ = ‖s‖ := by
    intro u s hlt
    have h1 : ‖u‖ ≤ ‖s‖ := by
      have hmax : ‖u‖ ≤ max ‖u - s‖ ‖s‖ := by
        simpa only [sub_add_cancel] using IsUltrametricDist.norm_add_le_max (u - s) s
      rcases le_max_iff.mp hmax with h | h
      · linarith
      · exact h
    have h2 : ‖s‖ ≤ ‖u‖ := by
      have hmax : ‖s‖ ≤ max ‖u‖ ‖-(u - s)‖ := by
        have hs : u + -(u - s) = s := by ring
        simpa only [hs] using IsUltrametricDist.norm_add_le_max u (-(u - s))
      rw [norm_neg] at hmax
      exact hmax.trans (max_le le_rfl (le_of_lt hlt))
    exact le_antisymm h1 h2
  let S_w : Subfield F_hat := (IntermediateField.adjoin K_hat ({w} : Set F_hat)).toSubfield
  let Lw : Subfield F_hat := S_w.topologicalClosure
  have hVal_w : ∀ u ∈ Lw, u ≠ 0 → ∃ (c : K_hat) (k : ℤ), c ≠ 0 ∧ ‖u‖ = ‖c‖ * r ^ k := by
    intro u hu hu_ne
    have hu_cl : u ∈ closure (S_w : Set F_hat) := hu
    obtain ⟨s, hs_mem, hs_dist⟩ := Metric.mem_closure_iff.mp hu_cl ‖u‖ (norm_pos_iff.mpr hu_ne)
    rw [dist_eq_norm] at hs_dist
    have hus_norm : ‖u‖ = ‖s‖ := hUltraEq u s hs_dist
    have hs_ne : s ≠ 0 := by
      intro hs0
      rw [hs0, norm_zero] at hus_norm
      exact hu_ne (norm_eq_zero.mp hus_norm)
    obtain ⟨P, Q, hQ, hs_eq⟩ := hSw_le hs_mem
    have hP : P ≠ 0 := by
      intro hP0
      apply hs_ne
      simp [hs_eq, hP0]
    obtain ⟨c₁, k₁, hc₁, hP_norm, _⟩ := hPolyNorm P hP
    obtain ⟨c₂, k₂, hc₂, hQ_norm, _⟩ := hPolyNorm Q hQ
    refine ⟨c₁ / c₂, k₁ - k₂, div_ne_zero hc₁ hc₂, ?_⟩
    rw [hus_norm, hs_eq, norm_div, hP_norm, hQ_norm, norm_div, zpow_sub₀ hr_ne, div_mul_div_comm]
  
  have hw_not : w ∉ Set.range (algebraMap K_hat F_hat) := by
    rintro ⟨c, hc⟩
    have hwc : r = ‖c‖ := by
      change ‖w‖ = ‖c‖
      rw [← hc, hIsoK]
    exact hw_irr c hwc
  letI : Algebra ↥Lw F_hat := Lw.toAlgebra
  haveI : FiniteDimensional ↥Lw F_hat := hFinAll w hw_not
  let H_L : Subgroup F_hatˣ :=
    { carrier := { u : F_hatˣ | ∃ v ∈ Lw, v ≠ 0 ∧ ‖(u : F_hat)‖ = ‖v‖ }
      one_mem' := ⟨1, Lw.one_mem, one_ne_zero, rfl⟩
      mul_mem' := by
        rintro u₁ u₂ ⟨v₁, hv₁, hv₁_ne, hu₁⟩ ⟨v₂, hv₂, hv₂_ne, hu₂⟩
        refine ⟨v₁ * v₂, Lw.mul_mem hv₁ hv₂, mul_ne_zero hv₁_ne hv₂_ne, ?_⟩
        rw [Units.val_mul, norm_mul, hu₁, hu₂, norm_mul]
      inv_mem' := by
        rintro u ⟨v, hv, hv_ne, hu⟩
        refine ⟨v⁻¹, Lw.inv_mem hv, inv_ne_zero hv_ne, ?_⟩
        rw [Units.val_inv_eq_inv_val, norm_inv, hu, norm_inv] }
  let m : ℕ := Module.finrank ↥Lw F_hat + 1
  have hNoInj : ∀ g : Fin m → F_hatˣ ⧸ H_L, ¬ Function.Injective g := by
    intro g hg
    let u_rep : Fin m → F_hatˣ := fun i => Quotient.out (g i)
    let b : Fin m → F_hat := fun i => (u_rep i : F_hat)
    have hLin : LinearIndependent ↥Lw b := by
      rw [Fintype.linearIndependent_iff]
      intro a hsum i₀
      by_contra hi₀
      letI : DecidableEq ↥Lw := Classical.decEq ↥Lw
      let S : Finset (Fin m) := Finset.univ.filter (fun i => a i ≠ 0)
      have hS_nonempty : S.Nonempty := ⟨i₀, Finset.mem_filter.mpr ⟨Finset.mem_univ i₀, hi₀⟩⟩
      have hS_sum : ∑ i ∈ S, (a i : F_hat) * b i = 0 := by
        have hsum' : ∑ i : Fin m, (a i : F_hat) * b i = 0 := hsum
        rw [← hsum']
        apply Finset.sum_subset (Finset.subset_univ S)
        intro i _ hi_not
        have hai : a i = 0 := by
          by_contra hne
          exact hi_not (Finset.mem_filter.mpr ⟨Finset.mem_univ i, hne⟩)
        simp [hai]
      have hS_dist : ∀ i ∈ S, ∀ j ∈ S, i ≠ j →
          ‖(a i : F_hat) * b i‖ ≠ ‖(a j : F_hat) * b j‖ := by
        intro i hi j hj hij hnorm_eq
        have hai_ne : (a i : F_hat) ≠ 0 := by
          intro h0
          exact (Finset.mem_filter.mp hi).2 (Subtype.ext h0)
        have haj_ne : (a j : F_hat) ≠ 0 := by
          intro h0
          exact (Finset.mem_filter.mp hj).2 (Subtype.ext h0)
        have hbi_ne : b i ≠ 0 := (u_rep i).ne_zero
        have hbj_ne : b j ≠ 0 := (u_rep j).ne_zero
        have hmem_HL : (u_rep i)⁻¹ * u_rep j ∈ H_L := by
          refine ⟨(a i : F_hat) * (a j : F_hat)⁻¹,
            Lw.mul_mem (a i).2 (Lw.inv_mem (a j).2),
            mul_ne_zero hai_ne (inv_ne_zero haj_ne), ?_⟩
          rw [Units.val_mul, Units.val_inv_eq_inv_val, norm_mul, norm_inv, norm_mul, norm_inv]
          have hbi_norm : ‖b i‖ ≠ 0 := norm_ne_zero_iff.mpr hbi_ne
          have hbj_norm : ‖b j‖ ≠ 0 := norm_ne_zero_iff.mpr hbj_ne
          have hai_norm : ‖(a i : F_hat)‖ ≠ 0 := norm_ne_zero_iff.mpr hai_ne
          have haj_norm : ‖(a j : F_hat)‖ ≠ 0 := norm_ne_zero_iff.mpr haj_ne
          rw [norm_mul, norm_mul] at hnorm_eq
          field_simp
          linarith
        have hq_eq : QuotientGroup.mk (s := H_L) (u_rep i) =
            QuotientGroup.mk (s := H_L) (u_rep j) := QuotientGroup.eq.mpr hmem_HL
        have hgi : QuotientGroup.mk (s := H_L) (u_rep i) = g i := Quotient.out_eq (g i)
        have hgj : QuotientGroup.mk (s := H_L) (u_rep j) = g j := Quotient.out_eq (g j)
        rw [hgi, hgj] at hq_eq
        exact hij (hg hq_eq)
      obtain ⟨i_max, hi_max, hmax_eq⟩ :=
        hUltraMaxSum (Fin m) S (fun i => (a i : F_hat) * b i) hS_nonempty hS_dist
      rw [hS_sum, norm_zero] at hmax_eq
      have hai_ne : (a i_max : F_hat) ≠ 0 := by
        intro h0
        exact (Finset.mem_filter.mp hi_max).2 (Subtype.ext h0)
      exact mul_ne_zero hai_ne (u_rep i_max).ne_zero (norm_eq_zero.mp hmax_eq.symm)
    have hle : Fintype.card (Fin m) ≤ Module.finrank ↥Lw F_hat :=
      hLin.fintype_card_le_finrank
    rw [Fintype.card_fin] at hle
    omega
  haveI : Finite (F_hatˣ ⧸ H_L) := by
    by_contra hInf
    haveI : Infinite (F_hatˣ ⧸ H_L) := not_finite_iff_infinite.mp hInf
    exact hNoInj (fun i : Fin m => Infinite.natEmbedding (F_hatˣ ⧸ H_L) i.1)
      (fun i j hij => Fin.ext ((Infinite.natEmbedding (F_hatˣ ⧸ H_L)).injective hij))
  
  letI : Fintype (F_hatˣ ⧸ H_L) := Fintype.ofFinite (F_hatˣ ⧸ H_L)
  let e₀ : ℕ := Fintype.card (F_hatˣ ⧸ H_L)
  have he₀_pos : 0 < e₀ := Fintype.card_pos
  have hExNu : ∀ z : F_hatˣ, ∃ k : ℤ, ∃ c : K_hat, c ≠ 0 ∧ ‖(z : F_hat)‖ ^ e₀ = ‖c‖ * r ^ k := by
    intro z
    have hpow1 : (QuotientGroup.mk' H_L z) ^ e₀ = 1 := pow_card_eq_one
    rw [← map_pow] at hpow1
    have hmem : z ^ e₀ ∈ H_L := by
      have h1 : (1 : F_hatˣ)⁻¹ * z ^ e₀ ∈ H_L :=
        QuotientGroup.eq.mp hpow1.symm
      simpa using h1
    obtain ⟨v, hv_mem, hv_ne, hv_norm⟩ := hmem
    obtain ⟨c, k, hc_ne, hvc⟩ := hVal_w v hv_mem hv_ne
    refine ⟨k, c, hc_ne, ?_⟩
    rw [Units.val_pow_eq_pow_val, norm_pow] at hv_norm
    rw [hv_norm, hvc]
  let ν : F_hatˣ → ℤ := fun z => Classical.choose (hExNu z)
  have hNuSpec : ∀ z : F_hatˣ, ∃ c : K_hat, c ≠ 0 ∧ ‖(z : F_hat)‖ ^ e₀ = ‖c‖ * r ^ (ν z) :=
    fun z => Classical.choose_spec (hExNu z)
  have hNuIff : ∀ (z : F_hatˣ) (k : ℤ),
      ν z = k ↔ ∃ c : K_hat, c ≠ 0 ∧ ‖(z : F_hat)‖ ^ e₀ = ‖c‖ * r ^ k := by
    intro z k
    constructor
    · rintro rfl
      exact hNuSpec z
    · rintro ⟨c, hc_ne, hnorm⟩
      obtain ⟨c₀, hc₀_ne, hnorm₀⟩ := hNuSpec z
      exact hUniq c₀ c (ν z) k hc₀_ne hc_ne (hnorm₀.symm.trans hnorm)
  have hNuMul : ∀ z₁ z₂ : F_hatˣ, ν (z₁ * z₂) = ν z₁ + ν z₂ := by
    intro z₁ z₂
    rw [hNuIff]
    obtain ⟨c₁, hc₁, hz₁⟩ := hNuSpec z₁
    obtain ⟨c₂, hc₂, hz₂⟩ := hNuSpec z₂
    refine ⟨c₁ * c₂, mul_ne_zero hc₁ hc₂, ?_⟩
    rw [Units.val_mul, norm_mul, mul_pow, hz₁, hz₂, norm_mul, zpow_add₀ hr_ne]
    ring
  have hNuOne : ν 1 = 0 := by
    have h := hNuMul 1 1
    rw [one_mul] at h
    omega
  have hNuInv : ∀ z : F_hatˣ, ν z⁻¹ = -ν z := by
    intro z
    have h := hNuMul z z⁻¹
    rw [mul_inv_cancel, hNuOne] at h
    omega
  have hNuPow : ∀ (z : F_hatˣ) (n : ℕ), ν (z ^ n) = (n : ℤ) * ν z := by
    intro z n
    induction n with
    | zero => simp [hNuOne]
    | succ n ih =>
      rw [pow_succ, hNuMul, ih]
      push_cast
      ring
  have hNuZpow : ∀ (z : F_hatˣ) (q : ℤ), ν (z ^ q) = q * ν z := by
    intro z q
    by_cases hq : 0 ≤ q
    · set n : ℕ := q.toNat
      have hn : (n : ℤ) = q := Int.toNat_of_nonneg hq
      rw [← hn, zpow_natCast, hNuPow]
    · set n : ℕ := (-q).toNat
      have hn : (n : ℤ) = -q := Int.toNat_of_nonneg (by omega)
      have hq_eq : q = -(n : ℤ) := by omega
      rw [hq_eq, zpow_neg, zpow_natCast, hNuInv, hNuPow]
      ring
  have hNuZeroIff : ∀ z : F_hatˣ, ν z = 0 ↔ ∃ c : K_hat, ‖(z : F_hat)‖ = ‖c‖ := by
    intro z
    constructor
    · intro hz0
      obtain ⟨c₀, _, hnorm₀⟩ := (hNuIff z 0).mp hz0
      rw [zpow_zero, mul_one] at hnorm₀
      obtain ⟨c, hc⟩ := IsAlgClosed.exists_pow_nat_eq c₀ he₀_pos
      refine ⟨c, ?_⟩
      rw [← hc, norm_pow] at hnorm₀
      exact (pow_left_inj₀ (norm_nonneg _) (norm_nonneg c) (ne_of_gt he₀_pos)).mp hnorm₀
    · rintro ⟨c, hc_norm⟩
      have hc_ne : c ≠ 0 := by
        intro hc0
        rw [hc0, norm_zero] at hc_norm
        exact z.ne_zero (norm_eq_zero.mp hc_norm)
      rw [hNuIff]
      refine ⟨c ^ e₀, pow_ne_zero e₀ hc_ne, ?_⟩
      rw [hc_norm, norm_pow, zpow_zero, mul_one]
  let w_u : F_hatˣ := Units.mk0 w hw_ne
  have hNuW : ν w_u = (e₀ : ℤ) := by
    rw [hNuIff]
    refine ⟨1, one_ne_zero, ?_⟩
    change r ^ e₀ = ‖(1 : K_hat)‖ * r ^ (e₀ : ℤ)
    rw [norm_one, one_mul, zpow_natCast]
  
  let P_pos : ℕ → Prop := fun n => 0 < n ∧ ∃ z : F_hatˣ, ν z = (n : ℤ)
  letI : DecidablePred P_pos := Classical.decPred P_pos
  have hExP : ∃ n : ℕ, P_pos n := ⟨e₀, he₀_pos, w_u, hNuW⟩
  let k_min : ℕ := Nat.find hExP
  obtain ⟨hk_pos, z₀, hz₀_nu⟩ := Nat.find_spec hExP
  let x₀ : F_hat := (z₀ : F_hat)
  have hx₀_ne : x₀ ≠ 0 := z₀.ne_zero
  have hx₀_irr : ∀ c : K_hat, ‖x₀‖ ≠ ‖c‖ := by
    intro c hc
    have h0 : ν z₀ = 0 := (hNuZeroIff z₀).mpr ⟨c, hc⟩
    omega
  have hx₀_gen : ∀ z : F_hat, z ≠ 0 →
      ∃ (c : K_hat) (q : ℤ), ‖z‖ = ‖algebraMap K_hat F_hat c * x₀ ^ q‖ := by
    intro z hz
    let u_z : F_hatˣ := Units.mk0 z hz
    let k₀ : ℤ := (k_min : ℤ)
    have hk₀_pos : 0 < k₀ := by omega
    let q : ℤ := ν u_z / k₀
    let rem : ℤ := ν u_z % k₀
    let u_rem : F_hatˣ := u_z * z₀ ^ (-q)
    have hdiv : k₀ * q + rem = ν u_z := Int.mul_ediv_add_emod (ν u_z) k₀
    have hrem_nu : ν u_rem = rem := by
      dsimp [u_rem]
      rw [hNuMul, hNuZpow, hz₀_nu]
      change ν u_z + -q * k₀ = rem
      linarith
    have hrem_nonneg : 0 ≤ rem := Int.emod_nonneg (ν u_z) (ne_of_gt hk₀_pos)
    have hrem_lt : rem < k₀ := Int.emod_lt_of_pos (ν u_z) hk₀_pos
    have hrem_zero : rem = 0 := by
      by_contra hrem_ne
      let n_rem : ℕ := rem.toNat
      have hn_eq : (n_rem : ℤ) = rem := Int.toNat_of_nonneg hrem_nonneg
      have hn_pos : 0 < n_rem := by omega
      have hn_lt : n_rem < k_min := by omega
      exact Nat.find_min hExP hn_lt ⟨hn_pos, u_rem, hrem_nu.trans hn_eq.symm⟩
    have hu_rem_zero : ν u_rem = 0 := hrem_nu.trans hrem_zero
    obtain ⟨c, hc_norm⟩ := (hNuZeroIff u_rem).mp hu_rem_zero
    refine ⟨c, q, ?_⟩
    have hu_val : (u_rem : F_hat) = z * x₀ ^ (-q) := by
      change z * ↑(z₀ ^ (-q)) = z * x₀ ^ (-q)
      rw [Units.val_zpow_eq_zpow_val]
    rw [hu_val, norm_mul, norm_zpow, zpow_neg] at hc_norm
    have hx₀_zpow_ne : ‖x₀‖ ^ q ≠ 0 := zpow_ne_zero q (norm_ne_zero_iff.mpr hx₀_ne)
    rw [norm_mul, hIsoK, norm_zpow, ← hc_norm, mul_assoc, inv_mul_cancel₀ hx₀_zpow_ne, mul_one]
  
  let S_x₀ : Subfield F_hat := (IntermediateField.adjoin K_hat ({x₀} : Set F_hat)).toSubfield
  let Lx₀ : Subfield F_hat := S_x₀.topologicalClosure
  have hK_sub : ∀ c : K_hat, algebraMap K_hat F_hat c ∈ Lx₀ :=
    fun c => Subfield.le_topologicalClosure S_x₀ (IntermediateField.algebraMap_mem _ c)
  have hx₀_mem : x₀ ∈ Lx₀ :=
    Subfield.le_topologicalClosure S_x₀ (IntermediateField.mem_adjoin_simple_self K_hat x₀)
  have hx₀_not : x₀ ∉ Set.range (algebraMap K_hat F_hat) := by
    rintro ⟨c, hc⟩
    exact hx₀_irr c (hc ▸ hIsoK c)
  have hFinLx₀ : letI : Algebra ↥Lx₀ F_hat := Lx₀.toAlgebra; FiniteDimensional ↥Lx₀ F_hat :=
    hFinAll x₀ hx₀_not
  refine ⟨x₀, hx₀_not, ?_, hFinLx₀, ?_, ?_, ?_⟩
  · refine ⟨?_, Subfield.isClosed_topologicalClosure S_x₀, Or.inr ⟨x₀, hx₀_mem, hx₀_ne, hx₀_irr, rfl⟩⟩
    rintro _ ⟨c, rfl⟩
    exact hK_sub c
  · intro w' hw'
    obtain ⟨c, q, hq⟩ := hx₀_gen w' hw'
    exact ⟨algebraMap K_hat F_hat c * x₀ ^ q, Lx₀.mul_mem (hK_sub c) (Lx₀.zpow_mem hx₀_mem q), hq⟩
  · intro w' hw'
    obtain ⟨c, hc_lt⟩ := hResEq w' hw'
    let u : F_hat := algebraMap K_hat F_hat c
    refine ⟨u, hK_sub c, ?_, hc_lt⟩
    have hu_eq : w' + -(w' - u) = u := by ring
    have hmax : ‖u‖ ≤ max ‖w'‖ ‖-(w' - u)‖ := by
      simpa only [hu_eq] using IsUltrametricDist.norm_add_le_max w' (-(w' - u))
    rw [norm_neg] at hmax
    exact hmax.trans (max_le hw' (le_of_lt hc_lt))
  · intro hTop
    let OF : ValuationSubring F_hat := (NormedField.valuation (K := F_hat)).valuationSubring
    let OLx₀ : ValuationSubring ↥Lx₀ := OF.comap Lx₀.subtype
    letI : Algebra ↥Lx₀ F_hat := Lx₀.toAlgebra
    let φ : ↥OLx₀ →+* ↥OF :=
      (Lx₀.subtype.comp OLx₀.subtype).codRestrict OF.toSubring (fun y => y.2)
    letI : Algebra ↥OLx₀ ↥OF := φ.toAlgebra
    have hBij : Function.Bijective φ := by
      refine ⟨?_, ?_⟩
      · intro a b hab
        have hval : (φ a : F_hat) = (φ b : F_hat) := congrArg Subtype.val hab
        exact Subtype.ext (Subtype.ext hval)
      · intro y
        have hTop' : Lx₀ = ⊤ := hTop
        have hy_Lx : (y : F_hat) ∈ Lx₀ := by
          rw [hTop']
          exact Subfield.mem_top (y : F_hat)
        refine ⟨⟨⟨(y : F_hat), hy_Lx⟩, y.2⟩, Subtype.ext rfl⟩
    exact ⟨hFinLx₀, RingHom.Finite.of_surjective φ hBij.2, RingHom.Etale.of_bijective hBij⟩

theorem weil_types23_no_immediate_deg_p_extension (K_hat E_hat : Type u)
    [NontriviallyNormedField K_hat] [CompleteSpace K_hat]
    [IsUltrametricDist K_hat] [IsAlgClosed K_hat]
    [NontriviallyNormedField E_hat] [CompleteSpace E_hat]
    [IsUltrametricDist E_hat] [Algebra K_hat E_hat]
    (E_max : Subfield K_hat)
    (hEquiChar : ∀ q : ℕ, q.Prime → (q : K_hat) = 0 ∨ ‖(q : K_hat)‖ = 1)
    (hIsoE : ∀ c : K_hat, ‖algebraMap K_hat E_hat c‖ = ‖c‖)
    (hCP : HasWeilImmediateCosetAndPerturb K_hat E_hat)
    (hE_norm : ∀ c ∈ E_max, ‖c‖ ≤ 1)
    (hE_alg : IsAlgClosed ↥E_max)
    (hE_res : ∀ c : K_hat, ‖c‖ ≤ 1 → ∃ e ∈ E_max, ‖c - e‖ < 1)
    (p : ℕ) (hp : p.Prime) (hp0 : (p : K_hat) = 0)
    (hPBasis : ∀ (L_alg : Type u) [Field L_alg] [Algebra ↥E_max L_alg] (T : L_alg),
      Transcendental ↥E_max T →
      (let Kt := IntermediateField.adjoin ↥E_max ({T} : Set L_alg)
       FiniteDimensional ↥Kt L_alg ∧ Algebra.IsSeparable ↥Kt L_alg) →
      ∃ U : Set L_alg,
        LinearIndependent ↥E_max ((↑) : U → L_alg) ∧
        (∀ u ∈ Submodule.span ↥E_max U, ∀ z : L_alg, u + z ^ p = 0 → u = 0) ∧
        Submodule.span ↥E_max ({1} ∪ ⋃ (n : ℕ), (fun u : L_alg => u ^ (p ^ n)) '' U) = ⊤)
    (L M₂ : Subfield E_hat) (hLE : L ≤ M₂)
    (hMod : IsWeilType23ModRamified K_hat E_hat E_max L)
    (hClM₂ : IsClosed (M₂ : Set E_hat))
    (hFinM₂ :
      letI : Algebra ↥L ↥M₂ := (Subfield.inclusion hLE).toAlgebra
      FiniteDimensional ↥L ↥M₂ ∧ Module.finrank ↥L ↥M₂ = p)
    (hValM₂ : ∀ w ∈ M₂, w ≠ 0 → ∃ u ∈ L, ‖w‖ = ‖u‖)
    (hResM₂ : ∀ w ∈ M₂, ‖w‖ ≤ 1 → ∃ u ∈ L, ‖u‖ ≤ 1 ∧ ‖w - u‖ < 1) :
    False :=
by
  classical
  have _ := hEquiChar
  have _ := hE_norm
  have _ : Fact p.Prime := ⟨hp⟩
  have _ : IsAlgClosed ↥E_max := hE_alg
  have hp2 : 2 ≤ p := hp.two_le
  
  have hCharP_of_zero : ∀ (R : Type u) [Ring R] [Nontrivial R], (p : R) = 0 → CharP R p := by
    intro R _ _ hpR
    have hdvd : ringChar R ∣ p := (ringChar.spec R p).mp hpR
    rcases hp.eq_one_or_self_of_dvd (ringChar R) hdvd with h1 | hpeq
    · exfalso
      have h0 : ((1 : ℕ) : R) = 0 := by
        rw [← h1]
        exact ringChar.Nat.cast_ringChar
      simp at h0
    · exact hpeq ▸ inferInstance
  have _ : CharP K_hat p := hCharP_of_zero K_hat hp0
  have hp0_Emax : (p : ↥E_max) = 0 := by
    apply Subtype.ext; simp [hp0]
  have _ : CharP ↥E_max p := hCharP_of_zero ↥E_max hp0_Emax
  have hp0_E : (p : E_hat) = 0 := by
    have := map_natCast (algebraMap K_hat E_hat) p
    rw [hp0, map_zero] at this
    exact this.symm
  have _ : CharP E_hat p := hCharP_of_zero E_hat hp0_E
  have hMapNeZero : ∀ {A B : Type u} [DivisionRing A] [Ring B] [Nontrivial B]
      (f : A →+* B) {x : A}, x ≠ 0 → f x ≠ 0 := by
    intro A B _ _ _ f x hx h0
    exact hx (f.injective (h0.trans f.map_zero.symm))
  have hUltraEq : ∀ {G : Type u} [SeminormedAddCommGroup G] [IsUltrametricDist G]
      (x y : G), ‖y‖ < ‖x‖ → ‖x + y‖ = ‖x‖ := by
    intro G _ _ x y hlt
    apply le_antisymm
    · exact le_trans (IsUltrametricDist.norm_add_le_max x y) (max_le le_rfl (le_of_lt hlt))
    · have h1 : ‖x‖ ≤ max ‖x + y‖ ‖-y‖ := by
        simpa [add_assoc] using IsUltrametricDist.norm_add_le_max (x + y) (-y)
      rw [norm_neg] at h1
      rcases le_max_iff.mp h1 with hle | hle
      · exact hle
      · linarith
  have hPowRoot : ∀ {F : Type u} [Field F] [IsAlgClosed F] (n : ℕ),
      1 ≤ n → ∀ c : F, ∃ d : F, d ^ n = c := by
    intro F _ _ n hn c
    let P : Polynomial F := Polynomial.X ^ n - Polynomial.C c
    have hdeg : P.degree ≠ 0 := by
      have h1 : P.degree = (n : WithBot ℕ) := by
        dsimp [P]
        rw [Polynomial.degree_sub_eq_left_of_degree_lt]
        · exact Polynomial.degree_X_pow n
        · calc
            (Polynomial.C c).degree ≤ 0 := Polynomial.degree_C_le
            _ < (n : WithBot ℕ) := WithBot.coe_lt_coe.mpr hn
            _ = (Polynomial.X ^ n : Polynomial F).degree := (Polynomial.degree_X_pow n).symm
      rw [h1]
      exact ne_of_gt (WithBot.coe_lt_coe.mpr hn)
    obtain ⟨d, hd⟩ := IsAlgClosed.exists_root P hdeg
    refine ⟨d, ?_⟩
    have hd0 : Polynomial.eval d P = 0 := hd
    simp only [P, Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X,
      Polynomial.eval_C] at hd0
    exact sub_eq_zero.mp hd0
  have hUnitSplitF : ∀ {F : Type u} [NormedField F] [CompleteSpace F]
      [IsUltrametricDist F] [CharP F p] (δ : F), ‖δ‖ < 1 →
      ∃ v₁ : F, v₁ ≠ 0 ∧ ‖v₁‖ = 1 ∧ v₁ ^ (p - 1) = 1 + δ := by
    intro F _ _ _ _ δ hδ
    have hSubPowF : ∀ x y : F, (x - y) ^ p = x ^ p - y ^ p := by
      intro x y
      have hNeg : (-y) ^ p = -(y ^ p) := by
        have h0 : (y + -y) ^ p = 0 ^ p := by rw [add_neg_cancel]
        rw [add_pow_char, zero_pow hp.ne_zero] at h0
        exact eq_neg_of_add_eq_zero_right h0
      rw [sub_eq_add_neg, add_pow_char, hNeg, ← sub_eq_add_neg]
    have h1δ_norm : ‖(1 : F) + δ‖ = 1 := by
      rw [hUltraEq (1 : F) δ (by simpa using hδ), norm_one]
    have h1δ_ne : (1 : F) + δ ≠ 0 := by
      intro h0; rw [h0, norm_zero] at h1δ_norm; norm_num at h1δ_norm
    have h1δ_inv_norm : ‖((1 : F) + δ)⁻¹‖ = 1 := by
      rw [norm_inv, h1δ_norm, inv_one]
    let step : F → F := fun y => (1 + δ)⁻¹ * (y ^ p - δ)
    let yseq : ℕ → F := fun n => step^[n] 0
    have hyseq_succ : ∀ n : ℕ, yseq (n + 1) = step (yseq n) :=
      fun n => Function.iterate_succ_apply' step n 0
    have hyseq_norm : ∀ n : ℕ, ‖yseq n‖ ≤ ‖δ‖ := by
      intro n
      induction n with
      | zero => simp [yseq]
      | succ k ih =>
        rw [hyseq_succ]
        change ‖(1 + δ)⁻¹ * (yseq k ^ p - δ)‖ ≤ ‖δ‖
        rw [norm_mul, h1δ_inv_norm, one_mul, sub_eq_add_neg]
        refine le_trans (IsUltrametricDist.norm_add_le_max _ _) (max_le ?_ (by simp))
        rw [norm_pow]
        calc
          ‖yseq k‖ ^ p ≤ ‖δ‖ ^ p := pow_le_pow_left₀ (norm_nonneg _) ih p
          _ ≤ ‖δ‖ ^ 1 := pow_le_pow_of_le_one (norm_nonneg δ) (le_of_lt hδ) hp.pos
          _ = ‖δ‖ := pow_one _
    have hyseq_diff : ∀ n : ℕ, ‖yseq n - yseq (n + 1)‖ ≤ ‖δ‖ ^ (p ^ n) := by
      intro n
      induction n with
      | zero =>
        rw [hyseq_succ 0]
        change ‖(0 : F) - (1 + δ)⁻¹ * ((0 : F) ^ p - δ)‖ ≤ ‖δ‖ ^ (p ^ 0)
        rw [zero_sub, norm_neg, norm_mul, h1δ_inv_norm, one_mul, zero_pow hp.ne_zero,
