        ‖Polynomial.aeval ζ (s.map (fun γ => Polynomial.X - Polynomial.C γ)).prod‖ := by
      intro s
      induction s using Multiset.induction_on with
      | empty =>
        simp only [Multiset.map_zero, Multiset.prod_zero, map_one, norm_one]
        dsimp [gaussNorm]; simp
      | @cons γ s ih =>
        rw [Multiset.map_cons, Multiset.prod_cons, map_mul, map_mul, hg_mul, norm_mul,
          hΨ_lin γ, ih]
        simp
    have hΨ_iso : ∀ R : Polynomial K_hat, gaussNorm (Ψ₀ R) = ‖Polynomial.aeval ζ R‖ := by
      intro R
      by_cases hR : R = 0
      · subst hR; simp [hg_zero]
      have hSplit : Polynomial.C R.leadingCoeff *
          (R.roots.map (fun γ => Polynomial.X - Polynomial.C γ)).prod = R :=
        Polynomial.C_leadingCoeff_mul_prod_multiset_X_sub_C IsAlgClosed.card_roots_eq_natDegree
      rw [← hSplit, map_mul, map_mul, hg_mul, norm_mul, hΨ_multiset R.roots]
      congr 1
      have hC : Ψ₀ (Polynomial.C R.leadingCoeff) =
          Polynomial.C (algebraMap K_hat E R.leadingCoeff) := by simp [Ψ₀]
      rw [hC, Polynomial.aeval_C]
      dsimp [gaussNorm]
      simp [Polynomial.natDegree_C]
    have hMultisetGe : ∀ s_m : Multiset K_hat,
        ρ ^ s_m.card ≤ ‖Polynomial.aeval ζ (s_m.map (fun γ => Polynomial.X - Polynomial.C γ)).prod‖ := by
      intro s_m
      induction s_m using Multiset.induction_on with
      | empty => simp
      | @cons γ s_m ih =>
        rw [Multiset.card_cons, pow_succ', Multiset.map_cons, Multiset.prod_cons, map_mul, norm_mul]
        have h1 : Polynomial.aeval ζ (Polynomial.X - Polynomial.C γ) =
            ζ - algebraMap K_hat E γ := by simp
        rw [h1]
        exact mul_le_mul (le_of_lt (hρ_gt γ)) ih (pow_nonneg (le_of_lt hρ_pos) _)
          (le_trans (le_of_lt hρ_pos) (le_of_lt (hρ_gt γ)))
    have hStrict627 : ∀ R : Polynomial K_hat, 1 ≤ R.natDegree →
        ‖R.leadingCoeff‖ * ρ ^ R.natDegree < ‖Polynomial.aeval ζ R‖ := by
      intro R hR_deg
      have hR_ne : R ≠ 0 := by intro h0; simp [h0] at hR_deg
      have hlc_pos : 0 < ‖R.leadingCoeff‖ :=
        norm_pos_iff.mpr (Polynomial.leadingCoeff_ne_zero.mpr hR_ne)
      have hSplit : Polynomial.C R.leadingCoeff *
          (R.roots.map (fun γ => Polynomial.X - Polynomial.C γ)).prod = R :=
        Polynomial.C_leadingCoeff_mul_prod_multiset_X_sub_C IsAlgClosed.card_roots_eq_natDegree
      have hcard : R.roots.card = R.natDegree := IsAlgClosed.card_roots_eq_natDegree
      obtain ⟨γ, hγ_mem⟩ := Multiset.card_pos_iff_exists_mem.mp (by omega : 0 < R.roots.card)
      obtain ⟨s', hs'⟩ := Multiset.exists_cons_of_mem hγ_mem
      conv_rhs => rw [← hSplit]
      rw [map_mul, Polynomial.aeval_C, norm_mul, hIsoE, ← hcard, hs',
        Multiset.card_cons, pow_succ', Multiset.map_cons, Multiset.prod_cons, map_mul, norm_mul]
      have h1 : Polynomial.aeval ζ (Polynomial.X - Polynomial.C γ) =
          ζ - algebraMap K_hat E γ := by simp
      rw [h1]
      have hs'_ge := hMultisetGe s'
      have hρ_s'_pos : 0 < ρ ^ s'.card := pow_pos hρ_pos _
      have hprod_lt : ρ * ρ ^ s'.card <
          ‖ζ - algebraMap K_hat E γ‖ *
          ‖Polynomial.aeval ζ (s'.map (fun γ => Polynomial.X - Polynomial.C γ)).prod‖ := by
        have := hρ_gt γ
        nlinarith
      nlinarith
    exact ⟨hg_coeff_le, hΨ_iso, hStrict627⟩
  
  have hOpenBall : ∀ (x₀ : F_hat),
      (IntermediateField.adjoin K_hat ({x₀} : Set F_hat)).toSubfield.topologicalClosure = ⊤ →
      ∃ (ε : ℝ), 0 < ε ∧
        ∀ x' : F_hat, ‖x' - x₀‖ < ε →
          (IntermediateField.adjoin K_hat ({x'} : Set F_hat)).toSubfield.topologicalClosure = ⊤ ∧
          IsWeilAnalyticUnramifiedGen K_hat F_hat x' := by
    intro x₀ hx₀_top
    have hIsoMap : Isometry (algebraMap K_hat F_hat) :=
      Isometry.of_dist_eq fun c₁ c₂ => by
        rw [dist_eq_norm, dist_eq_norm, ← map_sub, hIsoK]
    have hClosedRange : IsClosed (Set.range (algebraMap K_hat F_hat)) :=
      hIsoMap.isUniformInducing.isComplete_range.isClosed
    have hx₀_not : x₀ ∉ Set.range (algebraMap K_hat F_hat) := by
      intro hx₀_mem
      have hSub : (IntermediateField.adjoin K_hat ({x₀} : Set F_hat)).toSubfield ≤
          (algebraMap K_hat F_hat).fieldRange := by
        have hIF : IntermediateField.adjoin K_hat ({x₀} : Set F_hat) ≤
            ((algebraMap K_hat F_hat).fieldRange).toIntermediateField (fun c => ⟨c, rfl⟩) := by
          rw [IntermediateField.adjoin_le_iff]
          intro w hw
          rw [Set.mem_singleton_iff] at hw
          subst hw
          exact hx₀_mem
        exact hIF
      have hClosSub :
          (IntermediateField.adjoin K_hat ({x₀} : Set F_hat)).toSubfield.topologicalClosure ≤
          (algebraMap K_hat F_hat).fieldRange :=
        Subfield.topologicalClosure_minimal _ hSub hClosedRange
      rw [hx₀_top] at hClosSub
      exact hy₀_not (hClosSub (Subfield.mem_top y₀))
    obtain ⟨_, r_x₀, hr_pos, _, _, hFinrank_eq, _⟩ :=
      hCritPerturb.1 y₀ x₀ hx₀_not hy₀_fin
    refine ⟨r_x₀, hr_pos, ?_⟩
    intro x' hx'
    let Lx₀ : Subfield F_hat :=
      (IntermediateField.adjoin K_hat ({x₀} : Set F_hat)).toSubfield.topologicalClosure
    let Lx' : Subfield F_hat :=
      (IntermediateField.adjoin K_hat ({x'} : Set F_hat)).toSubfield.topologicalClosure
    let _ : Algebra ↥Lx₀ F_hat := Lx₀.toAlgebra
    let _ : Algebra ↥Lx' F_hat := Lx'.toAlgebra
    have hBij₀ : Function.Bijective (Algebra.linearMap ↥Lx₀ F_hat) := by
      refine ⟨(algebraMap ↥Lx₀ F_hat).injective, ?_⟩
      intro w
      have hw : w ∈ Lx₀ := by
        change w ∈ (IntermediateField.adjoin K_hat ({x₀} : Set F_hat)).toSubfield.topologicalClosure
        rw [hx₀_top]
        exact Subfield.mem_top w
      exact ⟨⟨w, hw⟩, rfl⟩
    have hFinrank₀ : Module.finrank ↥Lx₀ F_hat = 1 := by
      rw [← (LinearEquiv.ofBijective (Algebra.linearMap ↥Lx₀ F_hat) hBij₀).finrank_eq]
      exact Module.finrank_self ↥Lx₀
    have hDist : ‖x₀ - x'‖ < r_x₀ := by
      rw [norm_sub_rev]
      exact hx'
    have hFinrank' : Module.finrank ↥Lx' F_hat = 1 := by
      have hEq : Module.finrank ↥Lx₀ F_hat = Module.finrank ↥Lx' F_hat := hFinrank_eq x' hDist
      rw [← hEq, hFinrank₀]
    have hFin_x' : FiniteDimensional ↥Lx' F_hat :=
      Module.finite_of_finrank_pos (by omega : 0 < Module.finrank ↥Lx' F_hat)
    have hLx'_top : Lx' = ⊤ := by
      have hSurj' : Function.Surjective (Algebra.linearMap ↥Lx' F_hat) :=
        (LinearMap.injective_iff_surjective_of_finrank_eq_finrank
          (by rw [Module.finrank_self, hFinrank'])).mp (algebraMap ↥Lx' F_hat).injective
      rw [eq_top_iff]
      intro w _
      obtain ⟨y, rfl⟩ := hSurj' w
      exact y.2
    refine ⟨hLx'_top, ?_⟩
    let OF : ValuationSubring F_hat := (NormedField.valuation (K := F_hat)).valuationSubring
    let OLx' : ValuationSubring ↥Lx' := OF.comap Lx'.subtype
    let φ : ↥OLx' →+* ↥OF :=
      (Lx'.subtype.comp OLx'.subtype).codRestrict OF.toSubring (fun y => y.2)
    let _ : Algebra ↥OLx' ↥OF := φ.toAlgebra
    have hφ_bij : Function.Bijective φ := by
      refine ⟨?_, ?_⟩
      · intro y₁ y₂ hy
        apply Subtype.ext
        apply Subtype.ext
        have hval : (φ y₁ : F_hat) = (φ y₂ : F_hat) := congrArg Subtype.val hy
        exact hval
      · intro ⟨w, hw⟩
        have hwL : w ∈ Lx' := by rw [hLx'_top]; exact Subfield.mem_top w
        exact ⟨⟨⟨w, hwL⟩, hw⟩, rfl⟩
    have hFinOF : Module.Finite ↥OLx' ↥OF :=
      Module.Finite.of_surjective (Algebra.linearMap ↥OLx' ↥OF) hφ_bij.2
    exact ⟨hFin_x', hFinOF, RingHom.Etale.of_bijective hφ_bij⟩
  
  have hPolyDensityAndNoRoot : ∀ (z : F_hat) (r : ℝ),
      0 < r →
      (∀ c : K_hat, r ≤ ‖z - algebraMap K_hat F_hat c‖) →
      (∀ ε : ℝ, 0 < ε → ∃ c : K_hat, ‖z - algebraMap K_hat F_hat c‖ < r + ε) →
      let Mz : Subfield F_hat :=
        (IntermediateField.adjoin K_hat ({z} : Set F_hat)).toSubfield.topologicalClosure
      (∀ c : K_hat, r < ‖z - algebraMap K_hat F_hat c‖) ∧
      (∀ u ∈ Mz, ∀ ε : ℝ, 0 < ε → ∃ P : Polynomial K_hat, ‖u - Polynomial.aeval z P‖ < ε) ∧
      (∀ p : ℕ, p.Prime → (p : K_hat) = 0 → ∀ u ∈ Mz, u ^ p ≠ z) := by
    intro z r hr_pos hr_le hr_inf Mz
    have hr_gt : ∀ c : K_hat, r < ‖z - algebraMap K_hat F_hat c‖ := by
      intro c₀
      rcases lt_or_eq_of_le (hr_le c₀) with hlt | heq
      · exact hlt
      · exfalso
        have hz_ne : z - algebraMap K_hat F_hat c₀ ≠ 0 := by
          intro h0; rw [h0, norm_zero] at heq; linarith
        obtain ⟨t, ht⟩ := hValEq (z - algebraMap K_hat F_hat c₀) hz_ne
        have ht_r : ‖t‖ = r := by linarith
        have hιt_norm : ‖algebraMap K_hat F_hat t‖ = r := by rw [hIsoK, ht_r]
        have hιt_ne : algebraMap K_hat F_hat t ≠ 0 := by
          intro h0; rw [h0, norm_zero] at hιt_norm; linarith
        let w : F_hat := (z - algebraMap K_hat F_hat c₀) / algebraMap K_hat F_hat t
        have hw_le : ‖w‖ ≤ 1 := by
          rw [norm_div, ← heq, hιt_norm, div_self (ne_of_gt hr_pos)]
        obtain ⟨c₁, hc₁⟩ := hResEq w hw_le
        have hsub : z - algebraMap K_hat F_hat (c₀ + t * c₁) =
            algebraMap K_hat F_hat t * (w - algebraMap K_hat F_hat c₁) := by
          rw [map_add, map_mul]
          dsimp [w]
          field_simp [hιt_ne]
          ring
        have hlt_r : ‖z - algebraMap K_hat F_hat (c₀ + t * c₁)‖ < r := by
          rw [hsub, norm_mul, hιt_norm]
          nlinarith [norm_nonneg (w - algebraMap K_hat F_hat c₁)]
        linarith [hr_le (c₀ + t * c₁)]
    have hDense : ∀ u ∈ Mz, ∀ ε : ℝ, 0 < ε → ∃ P : Polynomial K_hat, ‖u - Polynomial.aeval z P‖ < ε := by
      let ev : Polynomial K_hat →+* F_hat := (Polynomial.aeval z : Polynomial K_hat →ₐ[K_hat] F_hat).toRingHom
      let S_ring : Subring F_hat := ev.range
      let A_z : Subring F_hat := S_ring.topologicalClosure
      have hAz_coe : (A_z : Set F_hat) = closure (S_ring : Set F_hat) := rfl
      have hLinInv : ∀ γ : K_hat, (z - algebraMap K_hat F_hat γ)⁻¹ ∈ A_z := by
        intro γ
        have hγ_gt : r < ‖z - algebraMap K_hat F_hat γ‖ := hr_gt γ
        have hγ_pos : 0 < ‖z - algebraMap K_hat F_hat γ‖ := lt_trans hr_pos hγ_gt
        have hγ_ne : z - algebraMap K_hat F_hat γ ≠ 0 := norm_ne_zero_iff.mp (ne_of_gt hγ_pos)
        let η : ℝ := (‖z - algebraMap K_hat F_hat γ‖ - r) / 2
        obtain ⟨c₁, hc₁⟩ := hr_inf η (by dsimp [η]; linarith)
        have hc₁_lt : ‖z - algebraMap K_hat F_hat c₁‖ < ‖z - algebraMap K_hat F_hat γ‖ := by
          dsimp [η] at hc₁; linarith
        let δ : F_hat := algebraMap K_hat F_hat (c₁ - γ)
        have hδ_eq : δ = (z - algebraMap K_hat F_hat γ) - (z - algebraMap K_hat F_hat c₁) := by
          dsimp [δ]; rw [map_sub]; ring
        have hδ_norm : ‖δ‖ = ‖z - algebraMap K_hat F_hat γ‖ := by
          rw [hδ_eq]; exact hUltraSubEqLeft hc₁_lt
        have hc₁γ_ne : c₁ - γ ≠ 0 := by
          intro h0
          have : ‖δ‖ = 0 := by dsimp [δ]; rw [h0, map_zero, norm_zero]
          linarith
        let δ_inv : F_hat := algebraMap K_hat F_hat ((c₁ - γ)⁻¹)
        have hδ_mul : δ * δ_inv = 1 := by
          dsimp [δ, δ_inv]; rw [← map_mul, mul_inv_cancel₀ hc₁γ_ne, map_one]
        have hδ_inv_mem : δ_inv ∈ S_ring := ⟨Polynomial.C ((c₁ - γ)⁻¹), by simp [ev, δ_inv]⟩
        let q : F_hat := -(z - algebraMap K_hat F_hat c₁) * δ_inv
        have hq_mem : q ∈ S_ring :=
          ⟨-(Polynomial.X - Polynomial.C c₁) * Polynomial.C ((c₁ - γ)⁻¹), by
            simp [ev, q, δ_inv]; ring⟩
        have hq_norm : ‖q‖ < 1 := by
          dsimp [q, δ_inv]
          rw [norm_mul, norm_neg, hIsoK, norm_inv, ← hIsoK, hδ_norm]
          exact (mul_inv_lt_iff₀ hγ_pos).mpr (by linarith)
        have h_one_sub_q : δ * (1 - q) = z - algebraMap K_hat F_hat γ := by
          calc δ * (1 - q) = δ - δ * (-(z - algebraMap K_hat F_hat c₁) * δ_inv) := by dsimp [q]; ring
            _ = δ + (δ * δ_inv) * (z - algebraMap K_hat F_hat c₁) := by ring
            _ = δ + 1 * (z - algebraMap K_hat F_hat c₁) := by rw [hδ_mul]
            _ = z - algebraMap K_hat F_hat γ := by rw [hδ_eq]; ring
        change (z - algebraMap K_hat F_hat γ)⁻¹ ∈ (A_z : Set F_hat)
        rw [hAz_coe, Metric.mem_closure_iff]
        intro ε₀ hε₀
        have h_inv_pos : 0 < ‖(z - algebraMap K_hat F_hat γ)⁻¹‖ :=
          norm_pos_iff.mpr (inv_ne_zero hγ_ne)
        obtain ⟨n, hn⟩ := exists_pow_lt_of_lt_one (div_pos hε₀ h_inv_pos) hq_norm
        let s_n : F_hat := δ_inv * ∑ k ∈ Finset.range n, q ^ k
        have hs_mem : s_n ∈ S_ring :=
          S_ring.mul_mem hδ_inv_mem (S_ring.sum_mem fun k _ => S_ring.pow_mem hq_mem k)
        refine ⟨s_n, hs_mem, ?_⟩
        rw [dist_eq_norm]
        have hmul_sn : (z - algebraMap K_hat F_hat γ) * s_n = 1 - q ^ n := by
          calc (z - algebraMap K_hat F_hat γ) * s_n
              = δ * (1 - q) * (δ_inv * ∑ k ∈ Finset.range n, q ^ k) := by rw [← h_one_sub_q]
            _ = (δ * δ_inv) * ((∑ k ∈ Finset.range n, q ^ k) * (1 - q)) := by ring
            _ = 1 * (1 - q ^ n) := by rw [hδ_mul, geom_sum_mul_neg]
            _ = 1 - q ^ n := one_mul _
        have hdiff : (z - algebraMap K_hat F_hat γ)⁻¹ - s_n =
            (z - algebraMap K_hat F_hat γ)⁻¹ * q ^ n := by
          apply mul_left_cancel₀ hγ_ne
          calc (z - algebraMap K_hat F_hat γ) * ((z - algebraMap K_hat F_hat γ)⁻¹ - s_n)
              = (z - algebraMap K_hat F_hat γ) * (z - algebraMap K_hat F_hat γ)⁻¹ -
                (z - algebraMap K_hat F_hat γ) * s_n := mul_sub _ _ _
            _ = 1 - (1 - q ^ n) := by rw [mul_inv_cancel₀ hγ_ne, hmul_sn]
            _ = q ^ n := by ring
            _ = (z - algebraMap K_hat F_hat γ) * ((z - algebraMap K_hat F_hat γ)⁻¹ * q ^ n) := by
                rw [← mul_assoc, mul_inv_cancel₀ hγ_ne, one_mul]
        rw [hdiff, norm_mul, norm_pow]
        exact (lt_div_iff₀' h_inv_pos).mp hn
      have hMultisetInv : ∀ s : Multiset K_hat,
          Polynomial.aeval z (s.map (fun γ => Polynomial.X - Polynomial.C γ)).prod ≠ 0 ∧
          (Polynomial.aeval z (s.map (fun γ => Polynomial.X - Polynomial.C γ)).prod)⁻¹ ∈ A_z := by
        intro s
        induction s using Multiset.induction_on with
        | empty =>
          simp only [Multiset.map_zero, Multiset.prod_zero, map_one, ne_eq, one_ne_zero,
            not_false_eq_true, inv_one, A_z.one_mem, and_self]
        | @cons γ s ih =>
          rw [Multiset.map_cons, Multiset.prod_cons, map_mul]
          have h1 : Polynomial.aeval z (Polynomial.X - Polynomial.C γ) =
              z - algebraMap K_hat F_hat γ := by simp
          rw [h1]
          have hγ_ne : z - algebraMap K_hat F_hat γ ≠ 0 :=
            norm_ne_zero_iff.mp (ne_of_gt (lt_trans hr_pos (hr_gt γ)))
          refine ⟨mul_ne_zero hγ_ne ih.1, ?_⟩
          rw [mul_inv]
          exact A_z.mul_mem (hLinInv γ) ih.2
      have hPolyInv : ∀ Q : Polynomial K_hat, Q ≠ 0 →
          Polynomial.aeval z Q ≠ 0 ∧ (Polynomial.aeval z Q)⁻¹ ∈ A_z := by
        intro Q hQ
        have hSplit : Polynomial.C Q.leadingCoeff *
            (Q.roots.map (fun γ => Polynomial.X - Polynomial.C γ)).prod = Q :=
          Polynomial.C_leadingCoeff_mul_prod_multiset_X_sub_C IsAlgClosed.card_roots_eq_natDegree
        rw [← hSplit, map_mul, Polynomial.aeval_C]
        have hlc_ne : Q.leadingCoeff ≠ 0 := Polynomial.leadingCoeff_ne_zero.mpr hQ
        have hιlc_ne : algebraMap K_hat F_hat Q.leadingCoeff ≠ 0 :=
          (map_ne_zero (algebraMap K_hat F_hat)).mpr hlc_ne
        have hιlc_inv : (algebraMap K_hat F_hat Q.leadingCoeff)⁻¹ ∈ A_z := by
          rw [← map_inv₀]
          exact Subring.le_topologicalClosure S_ring ⟨Polynomial.C Q.leadingCoeff⁻¹, by simp [ev]⟩
        obtain ⟨hM_ne, hM_inv⟩ := hMultisetInv Q.roots
        refine ⟨mul_ne_zero hιlc_ne hM_ne, ?_⟩
        rw [mul_inv]
        exact A_z.mul_mem hιlc_inv hM_inv
      let F_sub : Subfield F_hat :=
        { carrier := { x : F_hat | ∃ P Q : Polynomial K_hat,
            Q ≠ 0 ∧ x = Polynomial.aeval z P * (Polynomial.aeval z Q)⁻¹ }
          mul_mem' := by
            rintro _ _ ⟨P₁, Q₁, hQ₁, rfl⟩ ⟨P₂, Q₂, hQ₂, rfl⟩
            refine ⟨P₁ * P₂, Q₁ * Q₂, mul_ne_zero hQ₁ hQ₂, ?_⟩
            simp only [map_mul, mul_inv]; ring
          one_mem' := ⟨1, 1, one_ne_zero, by simp⟩
          add_mem' := by
            rintro _ _ ⟨P₁, Q₁, hQ₁, rfl⟩ ⟨P₂, Q₂, hQ₂, rfl⟩
            have hq₁ : Polynomial.aeval z Q₁ ≠ 0 := (hPolyInv Q₁ hQ₁).1
            have hq₂ : Polynomial.aeval z Q₂ ≠ 0 := (hPolyInv Q₂ hQ₂).1
            refine ⟨P₁ * Q₂ + P₂ * Q₁, Q₁ * Q₂, mul_ne_zero hQ₁ hQ₂, ?_⟩
            simp only [map_add, map_mul]
            field_simp [hq₁, hq₂]
          zero_mem' := ⟨0, 1, one_ne_zero, by simp⟩
          neg_mem' := by
            rintro _ ⟨P, Q, hQ, rfl⟩
            exact ⟨-P, Q, hQ, by simp⟩
          inv_mem' := by
            rintro _ ⟨P, Q, hQ, rfl⟩
            by_cases hP : P = 0
            · subst hP; exact ⟨0, 1, one_ne_zero, by simp⟩
            · exact ⟨Q, P, hP, by rw [mul_inv, inv_inv, mul_comm]⟩ }
      have hF_le_Az : (F_sub : Set F_hat) ⊆ (A_z : Set F_hat) := by
        rintro _ ⟨P, Q, hQ, rfl⟩
        exact A_z.mul_mem (Subring.le_topologicalClosure S_ring ⟨P, rfl⟩) (hPolyInv Q hQ).2
      have hAdjoin_le : (IntermediateField.adjoin K_hat ({z} : Set F_hat)).toSubfield ≤ F_sub := by
        have hIF : IntermediateField.adjoin K_hat ({z} : Set F_hat) ≤
            F_sub.toIntermediateField (fun c => ⟨Polynomial.C c, 1, one_ne_zero, by simp⟩) := by
          rw [IntermediateField.adjoin_le_iff]
          intro w hw
          rw [Set.mem_singleton_iff] at hw
          subst hw
          exact ⟨Polynomial.X, 1, one_ne_zero, by simp⟩
        exact hIF
      have hMz_sub : (Mz : Set F_hat) ⊆ (A_z : Set F_hat) := by
        have hClos : (Mz : Set F_hat) =
            closure ((IntermediateField.adjoin K_hat ({z} : Set F_hat)).toSubfield : Set F_hat) := rfl
        rw [hClos]
        exact closure_minimal (Set.Subset.trans hAdjoin_le hF_le_Az)
          (Subring.isClosed_topologicalClosure S_ring)
      intro u hu ε hε
      have hu_clos : u ∈ closure (S_ring : Set F_hat) := hAz_coe ▸ hMz_sub hu
      rw [Metric.mem_closure_iff] at hu_clos
      obtain ⟨y, ⟨P, rfl⟩, hy⟩ := hu_clos ε hε
      rw [dist_eq_norm] at hy
      exact ⟨P, hy⟩
    refine ⟨hr_gt, hDense, ?_⟩
    intro p hp hp0 u hu hup
    have _ : CharP K_hat p := hCharP hp hp0
