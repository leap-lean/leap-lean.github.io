        · rw [hRhoMul (f a) _ ha_norm hs_norm, hs_rho]
    have hRhoGal : ∀ (σ : N ≃ₐ[↥K_base] N) (z : N), ‖z‖ ≤ 1 → ρ (σ z) = ρ z := by
      intro σ z hz
