              rw [← mul_assoc (x ^ i), ← mul_pow, mul_inv_cancel₀ hx0, one_pow, one_mul]
      have hy_in_q2 : ι_W W₂ hW₂ y_A ∈ IsLocalRing.maximalIdeal ↥W₂ := by
        rw [hy_W₂]
        refine Submodule.neg_mem _ (Ideal.sum_mem _ fun i hi => ?_)
        have hi_lt : i < m := Finset.mem_range.mp hi
        exact Ideal.mul_mem_left _ _
          (Ideal.pow_mem_of_mem _ hx₂_inv_max (m - i) (by omega))
      exact hy_not_q2 hy_in_q2
    have hAntichain : ∀ W₁ ∈ S_ext, ∀ W₂ ∈ S_ext, W₁ ≤ W₂ → W₁ = W₂ := by
      intro W₁ hW₁ W₂ hW₂ hle
      let f₁₂ : ↥W₁ →+* ↥W₂ :=
        { toFun := fun u => ⟨u.1, hle u.2⟩
          map_one' := rfl
          map_mul' := fun _ _ => rfl
          map_zero' := rfl
          map_add' := fun _ _ => rfl }
      have hq21 : q_W W₂ hW₂ ≤ q_W W₁ hW₁ := by
        intro a ha
        change ¬ IsUnit (ι_W W₁ hW₁ a)
        intro hu
        have hu2 : IsUnit (ι_W W₂ hW₂ a) := hu.map f₁₂
        exact ha hu2
      have hq_eq : q_W W₂ hW₂ = q_W W₁ hW₁ :=
        (hq_max W₂ hW₂).eq_of_le (hq_max W₁ hW₁).ne_top hq21
      exact le_antisymm hle (hSep W₂ hW₂ W₁ hW₁ hq_eq.symm.le)
    have hq_inj : ∀ (W₁ : ValuationSubring E) (hW₁ : W₁ ∈ S_ext)
        (W₂ : ValuationSubring E) (hW₂ : W₂ ∈ S_ext),
        q_W W₁ hW₁ = q_W W₂ hW₂ → W₁ = W₂ := by
      intro W₁ hW₁ W₂ hW₂ hq_eq
      exact le_antisymm (hSep W₁ hW₁ W₂ hW₂ hq_eq.symm.le) (hSep W₂ hW₂ W₁ hW₁ hq_eq.le)
    have hFin : S_ext.Finite := by
      by_contra hInf
      have hInf' : S_ext.Infinite := hInf
      have : Infinite ↥S_ext := hInf'.to_subtype
      let d : ℕ := Module.finrank L E
      let w : Fin (d + 1) → ↥S_ext := fun k => Infinite.natEmbedding ↥S_ext k
      have hw_inj : Function.Injective w :=
        (Infinite.natEmbedding ↥S_ext).injective.comp Fin.val_injective
      let f : Fin (d + 1) → Ideal ↥A := fun k => q_W (w k).1 (w k).2
      have hf_max : ∀ k : Fin (d + 1), (f k).IsMaximal := fun k => hq_max (w k).1 (w k).2
      have hf_inj : Function.Injective f := by
        intro k l hkl
        apply hw_inj
        apply Subtype.ext
        exact hq_inj (w k).1 (w k).2 (w l).1 (w l).2 hkl
      have hCop : Pairwise (Function.onFun IsCoprime f) := by
        intro k l hkl
        exact Ideal.isCoprime_iff_sup_eq.mpr
          (Ideal.IsMaximal.coprime_of_ne (hf_max k) (hf_max l) (hf_inj.ne hkl))
      let Φ := Ideal.quotientInfRingEquivPiQuotient f hCop
      classical
      have he_ex : ∀ k : Fin (d + 1), ∃ e : ↥A,
          Ideal.Quotient.mk (⨅ i, f i) e =
            Φ.symm (Pi.single (M := fun i => ↥A ⧸ f i) k 1) :=
        fun k => Ideal.Quotient.mk_surjective
          (Φ.symm (Pi.single (M := fun i => ↥A ⧸ f i) k 1))
      choose e he using he_ex
      have he_same : ∀ k : Fin (d + 1), Ideal.Quotient.mk (f k) (e k) = 1 := by
        intro k
        have h1 := congrArg Φ (he k)
        rw [RingEquiv.apply_symm_apply] at h1
        have h2 := congrFun h1 k
        rw [Pi.single_eq_same] at h2
        exact h2
      have he_ne : ∀ k l : Fin (d + 1), k ≠ l → Ideal.Quotient.mk (f l) (e k) = 0 := by
        intro k l hkl
        have h1 := congrArg Φ (he k)
        rw [RingEquiv.apply_symm_apply] at h1
        have h2 := congrFun h1 l
        rw [Pi.single_eq_of_ne hkl.symm] at h2
        exact h2
      have hLin : LinearIndependent L (fun k : Fin (d + 1) => ((e k : ↥A) : E)) := by
        rw [Fintype.linearIndependent_iff]
        intro g hg_sum
        by_contra hg_not_all
        have hg_ex : ∃ k : Fin (d + 1), g k ≠ 0 := by
          by_contra hnone
          exact hg_not_all fun k => by_contra fun hk => hnone ⟨k, hk⟩
        let S_nz : Finset (Fin (d + 1)) := Finset.univ.filter (fun k => g k ≠ 0)
        have hSnz : S_nz.Nonempty := by
          obtain ⟨k, hk⟩ := hg_ex
          exact ⟨k, Finset.mem_filter.mpr ⟨Finset.mem_univ k, hk⟩⟩
        obtain ⟨k₀, hk₀_mem, hk₀_max⟩ :=
          Finset.exists_max_image S_nz (fun k => V₀.valuation (g k)) hSnz
