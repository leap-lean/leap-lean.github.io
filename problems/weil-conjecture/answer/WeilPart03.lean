        have hKT_le_L : KT_sub ≤ L := by
          intro x hx
          change x ∈ IntermediateField.adjoin K_hat ({T} : Set E_hat) at hx
          rw [IntermediateField.mem_adjoin_simple_iff] at hx
          rcases hx with ⟨P, Q, rfl⟩
          exact L.div_mem (hpoly_T_mem_L P) (hpoly_T_mem_L Q)
        have hLT_le_L : L_T ≤ L := Subfield.topologicalClosure_minimal KT_sub hKT_le_L hClL
        have hPolyMapT : ∀ (R_p : Polynomial K_hat) (hmem : Polynomial.aeval T R_p ∈ L),
