              exact hSep (AlgEquiv.Algebra.isSeparable eS)
            obtain ⟨y, hy_not_S₀⟩ := hEx_not_S
            have _ : CharP ↥S₀ p := (RingHom.charP_iff_charP (algebraMap ↥S₀ L) p).mpr hCharL
            have _ : ExpChar ↥S₀ p := ExpChar.prime hp
            have _ : Algebra.IsIntegral ↥Lw L := Algebra.IsIntegral.of_finite ↥Lw L
            have _ : IsPurelyInseparable ↥S₀ L := separableClosure.isPurelyInseparable ↥Lw L
