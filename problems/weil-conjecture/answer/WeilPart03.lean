    let pbar0 : Ideal A_bar := Ideal.map π.toRingHom p₀
    have hJm_le_p₀ : J_m ≤ p₀ :=
      Ideal.map_le_iff_le_comap.mpr (le_of_eq hp₀_comap.symm)
