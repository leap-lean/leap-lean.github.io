      rw [hu, hφu]
      exact h_div_err _ _ _ _ (h_poly_nz g hg) (h_poly_err f) (h_poly_err g)
    have hφ₀_norm : ∀ u : ↥Kz, ‖(φ₀ u : F_hat)‖ = ‖(u : F_hat)‖ :=
      fun u => h_norm_eq _ _ (hφ₀_err u)
    let Lz : Subfield F_hat := Kz.topologicalClosure
    let Lz' : Subfield F_hat := Kz'.topologicalClosure
    have hcl_Lz : IsClosed (Lz : Set F_hat) := Subfield.isClosed_topologicalClosure Kz
    have hcl_Lz' : IsClosed (Lz' : Set F_hat) := Subfield.isClosed_topologicalClosure Kz'
    have : CompleteSpace ↥Lz := @IsClosed.completeSpace_coe _ _ _ _ hcl_Lz
    have : CompleteSpace ↥Lz' := @IsClosed.completeSpace_coe _ _ _ _ hcl_Lz'
