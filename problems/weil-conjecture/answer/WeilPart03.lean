    have hRhoDivGal : ∀ (σ : N ≃ₐ[↥K_base] N) (z : N), ‖z‖ = 1 → ρ (σ z / z) = 1 := by
      intro σ z hz
      have hz_ne : z ≠ 0 := by
        intro h0
        rw [h0, norm_zero] at hz
        norm_num at hz
      have hdiv_le : ‖σ z / z‖ ≤ 1 := by
        rw [norm_div, hIsoGal, hz, div_one]
      apply hRhoEq (σ z / z) hdiv_le 1
      have h_diff : σ z - z =
          σ (z - algebraMap K_hat N (ρ z : K_hat)) + -(z - algebraMap K_hat N (ρ z : K_hat)) := by
        rw [map_sub, hKhat_gal]
        ring
