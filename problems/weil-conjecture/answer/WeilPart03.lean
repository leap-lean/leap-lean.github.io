        rw [Finset.sum_ite_eq']
        by_cases hij : i < j + 1
        · rw [if_pos (Finset.mem_range.mpr hij)]
        · rw [if_neg (Finset.mem_range.not.mpr hij), Nat.choose_eq_zero_of_lt (by omega),
