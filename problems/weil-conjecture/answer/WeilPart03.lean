    intro E L _ _ _ _ z₀ hTr hFin₀
    classical
    let p := ringChar E
    have hCharE : CharP E p := ringChar.charP E
    rcases CharP.char_is_prime_or_zero E p with hp | hp0
    · have hCharL : CharP L p := (RingHom.charP_iff_charP (algebraMap E L) p).mp hCharE
      have _ : ExpChar L p := ExpChar.prime hp
      suffices h_ind : ∀ (n : ℕ) (w : L),
          Transcendental E w →
          FiniteDimensional ↥(IntermediateField.adjoin E ({w} : Set L)) L →
          Module.finrank ↥(IntermediateField.adjoin E ({w} : Set L)) L = n →
