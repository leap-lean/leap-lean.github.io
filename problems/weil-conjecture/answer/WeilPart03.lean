      have hsub : Set.range iz ⊆ {u : ↥Lz | ‖(φ u : F_hat)‖ = ‖(u : F_hat)‖} := by
        rintro _ ⟨u, rfl⟩
        change ‖((φ_hom (iz u) : ↥Lz') : F_hat)‖ = ‖((iz u : ↥Lz) : F_hat)‖
