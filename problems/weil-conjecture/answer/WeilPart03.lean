              ((∑ i ∈ cw.support, algebraMap K_hat L₁ (cw i) * ((fam i : ↥L1_coeff) : L₁)) -
                (w_res : L₁)) := by ring
        rw [heq]
        exact lt_of_le_of_lt (IsUltrametricDist.norm_add_le_max _ _) (max_lt hw'_dist hdiff_w)
      refine ⟨U, ?_, ?_⟩
      · intro b ε hε
