        intro b
        change b ∈ (C_B : Set L₁)
        obtain ⟨f, rfl⟩ := hSpanL₁ b
        exact C_B.sum_mem fun j _ =>
          C_B.mul_mem (hL_map_CB (f j)) (C_B.pow_mem hwa_CB j)
      have hResL1 : ∀ z_t : L₁, ‖z_t‖ ≤ 1 → ∃ w_res : ↥L1_coeff, ‖z_t - (w_res : L₁)‖ < 1 := by
        intro z_t hzt_le
        have hzt_cl := hL1_in_cl z_t
        rw [Metric.mem_closure_iff] at hzt_cl
