    exact ⟨hTr₀, hFin₀, hSepCrit x₀ hDx₀ hFin₀⟩
  · intro E L _ _ _ _ ⟨z_sep, hTr_sep, hFin_sep, hSep_sep⟩ O hO_ne hEO
