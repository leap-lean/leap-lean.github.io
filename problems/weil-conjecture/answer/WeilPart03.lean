              have hnot : ¬ (isZero i = true) := (Finset.mem_filter.mp hi).2
              rcases i with _ | ⟨n, u⟩
              · simp [shift, fam]
              · rcases n with _ | k
                · exfalso; exact hnot rfl
                · simp only [shift, fam, ← pow_mul, pow_succ]
            let z : ↥L1_coeff := ∑ i ∈ S_pos, r i • fam (shift i)
            have hz_pow : z ^ p = ∑ i ∈ S_pos, g i • fam i := by
