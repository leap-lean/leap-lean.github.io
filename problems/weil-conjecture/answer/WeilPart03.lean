    letI : Algebra ↥S_θ ↥R₁ := (Subalgebra.inclusion hSθ_le).toRingHom.toAlgebra
    haveI : IsScalarTower A₁ ↥S_θ ↥R₁ := IsScalarTower.of_algebraMap_eq' rfl
    haveI : Algebra.IsIntegral ↥S_θ ↥R₁ := Algebra.IsIntegral.tower_top A₁
    let p_θ : Ideal ↥S_θ := Ideal.comap (algebraMap ↥S_θ B_q) m_q
    haveI : p_θ.IsPrime := Ideal.comap_isPrime (algebraMap ↥S_θ B_q) m_q
