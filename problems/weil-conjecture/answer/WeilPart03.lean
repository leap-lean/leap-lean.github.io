      have hM₂_le_top : M₂_int ≤ L_top := by
        rw [← IsGalois.fixedField_fixingSubgroup L_top]
        exact IntermediateField.fixedField_antitone hHtop_le_H₁
      have hLE : K' ≤ M₂ := hLE_int
      have hClM₂ : IsClosed (M₂ : Set N) := by
        haveI : FiniteDimensional ↥K_base ↥M₂_int.toSubmodule :=
          FiniteDimensional.left ↥K_base ↥M₂_int N
        exact Submodule.closed_of_finiteDimensional M₂_int.toSubmodule
      have hFinDegM₂ :
          letI : Algebra ↥K' ↥M₂ := (Subfield.inclusion hLE).toAlgebra
          FiniteDimensional ↥K' ↥M₂ ∧ Module.finrank ↥K' ↥M₂ = p := by
        letI : Algebra ↥K' ↥M₂ := (Subfield.inclusion hLE).toAlgebra
        letI : Algebra ↥K' N := K'.toAlgebra
        letI : Algebra ↥M₂ N := M₂.toAlgebra
        haveI : IsScalarTower ↥K' ↥M₂ N := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
        haveI : FiniteDimensional ↥K' N := FiniteDimensional.right ↥K_base ↥K'_int N
        haveI hFinKM : FiniteDimensional ↥K' ↥M₂ := FiniteDimensional.left ↥K' ↥M₂ N
        haveI : FiniteDimensional ↥M₂ N := FiniteDimensional.right ↥K_base ↥M₂_int N
        have hRankKN : Module.finrank ↥K' N = p ^ k := by
          exact (IntermediateField.finrank_fixedField_eq_card P).trans hk
        have hRankMN : Module.finrank ↥M₂ N = p ^ (k - 1) := by
          exact (IntermediateField.finrank_fixedField_eq_card H₁).trans hH₁_card
        have hMul := Module.finrank_mul_finrank ↥K' ↥M₂ N
        rw [hRankKN, hRankMN] at hMul
        have hpk_eq : p ^ k = p * p ^ (k - 1) := by
          conv_lhs => rw [← Nat.sub_add_cancel hk_pos, pow_succ']
        rw [hpk_eq] at hMul
        have hpow_pos : 0 < p ^ (k - 1) := pow_pos hp.pos _
        exact ⟨hFinKM, Nat.eq_of_mul_eq_mul_right hpow_pos hMul⟩
      exact hNoDegP N hIsoN p hp hp0 K' M₂ hLE hModK' hClM₂ hFinDegM₂
        (fun w hw hne => hValTop w (hM₂_le_top hw) hne)
        (fun w hw hle => hResTop w (hM₂_le_top hw) hle)
  have hRankFsub : Module.finrank ↥K_base ↥F_sub = 1 := by
    rw [hEqTop] at hFinrankMul
    have hK'_pos : 0 < Module.finrank ↥K_base ↥K'_int := Module.finrank_pos
    nlinarith
  have hSepRank : Module.finrank ↥K_base ↥F_sep = 1 := by
    have hEq := LinearEquiv.finrank_eq (R := ↥K_base) (M := ↥F_sep) (N := ↥F_sub)
      (AlgEquiv.ofInjectiveField ι_sep).toLinearEquiv
    exact hEq.trans hRankFsub
  
  let B_sub : Submodule ↥K_base F_hat := (⊥ : IntermediateField ↥K_base F_hat).toSubmodule
  let S_sub : Submodule ↥K_base F_hat := F_sep.toSubmodule
  have hSubEq : B_sub = S_sub := by
    haveI : FiniteDimensional ↥K_base ↥S_sub := FiniteDimensional.left ↥K_base ↥F_sep F_hat
    apply Submodule.eq_of_le_of_finrank_eq (fun z hz => (bot_le : (⊥ : IntermediateField ↥K_base F_hat) ≤ F_sep) hz)
    change Module.finrank ↥K_base ↥(⊥ : IntermediateField ↥K_base F_hat) =
      Module.finrank ↥K_base ↥F_sep
    rw [IntermediateField.finrank_bot, hSepRank]
  rw [eq_top_iff]
  intro y _
  by_contra hy_not
  haveI : IsPurelyInseparable ↥F_sep F_hat := separableClosure.isPurelyInseparable ↥K_base F_hat
  obtain ⟨q, hq_exp⟩ := ExpChar.exists ↥F_sep
  letI : ExpChar ↥F_sep q := hq_exp
  obtain ⟨n, hn_range⟩ := IsPurelyInseparable.pow_mem ↥F_sep q y
  have hn_base : y ^ (q ^ n) ∈ K_base := by
    obtain ⟨z, hz⟩ := hn_range
    have hz_mem : (z : F_hat) ∈ S_sub := z.2
    rw [← hSubEq] at hz_mem
    change (z : F_hat) ∈ (⊥ : IntermediateField ↥K_base F_hat) at hz_mem
    rw [IntermediateField.mem_bot] at hz_mem
    obtain ⟨u, hu⟩ := hz_mem
    rw [← hz]
    change (z : F_hat) ∈ K_base
    rw [← hu]
    exact u.2
  rcases expChar_is_prime_or_one ↥F_sep q with hq_prime | rfl
  · let p : ℕ := q
    have hp : p.Prime := hq_prime
    haveI : Fact p.Prime := ⟨hp⟩
    haveI : CharP ↥F_sep p := by
      cases hq_exp with
      | zero => exact False.elim (hp.ne_one rfl)
      | prime _ => infer_instance
    haveI : CharP F_hat p :=
      (RingHom.charP_iff_charP (algebraMap ↥F_sep F_hat) p).mp inferInstance
    have hpF0 : (p : F_hat) = 0 := CharP.cast_eq_zero F_hat p
    have hp0 : (p : K_hat) = 0 := by
      apply (RingHom.injective (algebraMap K_hat F_hat)).eq_iff.mp
      rw [map_natCast, map_zero]
      exact hpF0
    have hex : ∃ m : ℕ, y ^ (p ^ m) ∈ K_base := ⟨n, hn_base⟩
    classical
    let k : ℕ := Nat.find hex
    have hk_mem : y ^ (p ^ k) ∈ K_base := Nat.find_spec hex
    have hk_pos : 0 < k := by
      by_contra hk0
      have hk_eq0 : k = 0 := Nat.eq_zero_of_not_pos hk0
      rw [hk_eq0, pow_zero, pow_one] at hk_mem
      exact hy_not hk_mem
    let α : F_hat := y ^ (p ^ (k - 1))
    have hα_not : α ∉ K_base := Nat.find_min hex (Nat.sub_lt hk_pos zero_lt_one)
    have hαp_mem : α ^ p ∈ K_base := by
      dsimp [α]
      rw [← pow_mul, ← pow_succ, Nat.sub_add_cancel hk_pos]
      exact hk_mem
    let M₂_int : IntermediateField ↥K_base F_hat :=
      IntermediateField.adjoin ↥K_base ({α} : Set F_hat)
    let M₂ : Subfield F_hat := M₂_int.toSubfield
    have hLE : K_base ≤ M₂ := by
      intro u hu
      exact M₂_int.algebraMap_mem ⟨u, hu⟩
    have hInt_α : IsIntegral ↥K_base α := Algebra.IsIntegral.isIntegral α
    let μ : Polynomial ↥K_base := minpoly ↥K_base α
    let a₀ : ↥K_base := ⟨α ^ p, hαp_mem⟩
    have hμ_dvd : μ ∣ Polynomial.X ^ p - Polynomial.C a₀ := by
      apply minpoly.dvd ↥K_base α
      simp only [map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C]
      exact sub_self (α ^ p)
    let ι_F : ↥K_base →+* F_hat := algebraMap ↥K_base F_hat
    have hmap_dvd : μ.map ι_F ∣ (Polynomial.X - Polynomial.C α) ^ p := by
      have h1 := Polynomial.map_dvd ι_F hμ_dvd
      have h2 : (Polynomial.X ^ p - Polynomial.C a₀).map ι_F =
          (Polynomial.X - Polynomial.C α) ^ p := by
        rw [Polynomial.map_sub, Polynomial.map_pow, Polynomial.map_X, Polynomial.map_C,
          sub_pow_char, ← Polynomial.C_pow]
        rfl
      rwa [h2] at h1
    obtain ⟨j, hj_le, hAssoc⟩ :=
      (dvd_prime_pow (Polynomial.irreducible_X_sub_C α).prime p).mp hmap_dvd
    have hmap_eq : μ.map ι_F = (Polynomial.X - Polynomial.C α) ^ j :=
      Polynomial.eq_of_monic_of_associated ((minpoly.monic hInt_α).map ι_F)
        ((Polynomial.monic_X_sub_C α).pow j) hAssoc
    have hdeg_eq : μ.natDegree = j := by
      have h1 : (μ.map ι_F).natDegree = μ.natDegree :=
        (minpoly.monic hInt_α).natDegree_map ι_F
      rw [hmap_eq, (Polynomial.monic_X_sub_C α).natDegree_pow,
        Polynomial.natDegree_X_sub_C, mul_one] at h1
      exact h1.symm
    have hj_pos : 0 < j := hdeg_eq ▸ minpoly.natDegree_pos hInt_α
    have hj_eq_p : j = p := by
      by_contra hjp
      have hj_lt_p : j < p := lt_of_le_of_ne hj_le hjp
      have hnext_rhs : ((Polynomial.X - Polynomial.C α) ^ j).nextCoeff = -(j : F_hat) * α := by
        rw [(Polynomial.monic_X_sub_C α).nextCoeff_pow j, Polynomial.nextCoeff_X_sub_C,
          nsmul_eq_mul, mul_neg, neg_mul]
      have hnext_lhs : (μ.map ι_F).nextCoeff ∈ K_base := by
        have hdeg_map_pos : 0 < (μ.map ι_F).natDegree := by
          rw [hmap_eq, (Polynomial.monic_X_sub_C α).natDegree_pow,
            Polynomial.natDegree_X_sub_C, mul_one]
          exact hj_pos
        rw [Polynomial.nextCoeff_of_natDegree_pos hdeg_map_pos, Polynomial.coeff_map]
        exact (μ.coeff _).2
      rw [hmap_eq, hnext_rhs] at hnext_lhs
      have hj_ne0 : (j : F_hat) ≠ 0 := by
        intro hj0
        have hdvd_j : p ∣ j := (CharP.cast_eq_zero_iff F_hat p j).mp hj0
        exact Nat.not_dvd_of_pos_of_lt hj_pos hj_lt_p hdvd_j
      have hj_mem : -(j : F_hat) ∈ K_base := neg_mem (natCast_mem K_base j)
      have hα_mem : α ∈ K_base := by
        have hdiv := K_base.div_mem hnext_lhs hj_mem
        rwa [mul_div_cancel_left₀ α (neg_ne_zero.mpr hj_ne0)] at hdiv
      exact hα_not hα_mem
    have hClM₂ : IsClosed (M₂ : Set F_hat) := by
      haveI : FiniteDimensional ↥K_base ↥M₂_int.toSubmodule :=
        FiniteDimensional.left ↥K_base ↥M₂_int F_hat
      exact Submodule.closed_of_finiteDimensional M₂_int.toSubmodule
    have hFinDegM₂ :
        letI : Algebra ↥K_base ↥M₂ := (Subfield.inclusion hLE).toAlgebra
        FiniteDimensional ↥K_base ↥M₂ ∧ Module.finrank ↥K_base ↥M₂ = p := by
      letI : Algebra ↥K_base ↥M₂ := (Subfield.inclusion hLE).toAlgebra
      haveI hFinBM : FiniteDimensional ↥K_base ↥M₂ :=
        FiniteDimensional.left ↥K_base ↥M₂_int F_hat
      have hRankBM : Module.finrank ↥K_base ↥M₂ = p := by
        change Module.finrank ↥K_base ↥M₂_int = p
