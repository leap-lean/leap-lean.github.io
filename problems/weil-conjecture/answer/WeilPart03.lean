              rw [mul_sub, mul_one, inv_mul_cancel_left₀ h1x_ne]
            _ = (1 - x)⁻¹ * x ^ N := by rw [htele N]; ring
        refine ⟨sN, hsN_mem, ?_⟩
        rw [dist_eq_norm, hdiff, norm_mul, h1x_inv_norm, one_mul, norm_pow]
        exact hN
