          apply hL1_coeff_in_VB
          exact hF0_le_L1 ⟨⟨b.1, hB_fin_sub b.2⟩, rfl⟩
        have hwa_CB : w_a ∈ C_B := by
          rw [hwa_eq]
          exact C_B.mul_mem (C_B.mul_mem (hK_CB c_a) (hL_map_CB v₁))
