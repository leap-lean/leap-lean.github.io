      obtain ⟨w, hw⟩ := isUnit_iff_exists_inv.mp hu_T₀
      obtain ⟨⟨u₀, m⟩, hwm⟩ := IsLocalization.surj M_θ w
      have hmul_T₀ : algebraMap ↥R₁ T₀ (t.1 * u₀) = algebraMap ↥R₁ T₀ m.1 := by
        rw [map_mul, ← hwm, ← mul_assoc, hw, one_mul]
