        obtain ⟨d, hd⟩ := IsAlgClosed.exists_root q_d hdeg_d
        rw [Polynomial.IsRoot.def, Polynomial.eval_sub, Polynomial.eval_pow,
          Polynomial.eval_X, Polynomial.eval_C, sub_eq_zero] at hd
        have hgt := hP_good.1 (algebraMap K_hat F_hat d) (hRange₁ ⟨d, rfl⟩)
        rw [ha_zero, zero_mul, sub_zero, ← map_pow, hd, map_neg, neg_add_eq_sub] at hgt
        linarith
      have hbb'_lt_rb : ‖b - b'‖ < r_b := lt_of_lt_of_le hbb'_lt_s hs_le_rb
      have hb'_not : b' ∉ Set.range (algebraMap K_hat F_hat) := by
        rintro ⟨c, hc⟩
        rw [← hc] at hbb'_lt_rb
        linarith [hr_b_le c]
      have hneg_b'_not : -b' ∉ Set.range (algebraMap K_hat F_hat) := by
        rintro ⟨c, hc⟩
        apply hb'_not
        refine ⟨-c, ?_⟩
        rw [map_neg, hc, neg_neg]
      let Lb : Subfield F_hat :=
        (IntermediateField.adjoin K_hat ({b} : Set F_hat)).toSubfield.topologicalClosure
      let Lb' : Subfield F_hat :=
        (IntermediateField.adjoin K_hat ({b'} : Set F_hat)).toSubfield.topologicalClosure
      have hRange_Lb' : Set.range (algebraMap K_hat F_hat) ⊆ (Lb' : Set F_hat) := by
        rintro _ ⟨c, rfl⟩
        exact Subfield.le_topologicalClosure _ (IntermediateField.algebraMap_mem _ c)
      have hLb'_le_M₂ : Lb' ≤ M₂ := by
        apply Subfield.topologicalClosure_minimal
        · have hIF : IntermediateField.adjoin K_hat ({b'} : Set F_hat) ≤
              M₂.toIntermediateField (fun c => hRange₂ ⟨c, rfl⟩) := by
            rw [IntermediateField.adjoin_le_iff]
            intro w hw; rw [Set.mem_singleton_iff] at hw; subst hw; exact hb'_M₂
          exact hIF
        · exact hM₂_closed
      obtain ⟨hFin_b', _, _, _, _, _, _⟩ := hCritPerturb.1 y₀ b' hb'_not hy₀_fin
      have hFinrank_eq :
          (letI : Algebra ↥Lb F_hat := Lb.toAlgebra; Module.finrank ↥Lb F_hat) =
          (letI : Algebra ↥Lb' F_hat := Lb'.toAlgebra; Module.finrank ↥Lb' F_hat) :=
        hFinrank_b b' hbb'_lt_rb
      have hDeg_Lb' :
          letI : Algebra ↥Lb' ↥M₂ := (Subfield.inclusion hLb'_le_M₂).toAlgebra
          FiniteDimensional ↥Lb' ↥M₂ ∧ Module.finrank ↥Lb' ↥M₂ = p := by
        let _ : Algebra ↥M₁ F_hat := M₁.toAlgebra
        let _ : Algebra ↥M₂ F_hat := M₂.toAlgebra
        let _ : Algebra ↥Lb' F_hat := Lb'.toAlgebra
        let _ : Algebra ↥M₁ ↥M₂ := (Subfield.inclusion hLE).toAlgebra
        let _ : Algebra ↥Lb' ↥M₂ := (Subfield.inclusion hLb'_le_M₂).toAlgebra
        have _ : IsScalarTower ↥M₁ ↥M₂ F_hat := IsScalarTower.of_algebraMap_eq fun _ => rfl
        have _ : IsScalarTower ↥Lb' ↥M₂ F_hat := IsScalarTower.of_algebraMap_eq fun _ => rfl
        have _ : FiniteDimensional ↥M₁ F_hat := by
          have hEqSub : Lb = M₁ := hLb_eq_M₁
          subst hEqSub
          exact hFin_b
        have _ : FiniteDimensional ↥M₁ ↥M₂ := hDeg.1
        have _ : FiniteDimensional ↥M₂ F_hat := FiniteDimensional.right ↥M₁ ↥M₂ F_hat
        have _ : FiniteDimensional ↥Lb' F_hat := hFin_b'
        have _ : FiniteDimensional ↥Lb' ↥M₂ := FiniteDimensional.left ↥Lb' ↥M₂ F_hat
        refine ⟨inferInstance, ?_⟩
        have hm2_pos : 0 < Module.finrank ↥M₂ F_hat := Module.finrank_pos
        have ht1 : Module.finrank ↥M₁ ↥M₂ * Module.finrank ↥M₂ F_hat = Module.finrank ↥M₁ F_hat :=
          Module.finrank_mul_finrank ↥M₁ ↥M₂ F_hat
        have ht2 : Module.finrank ↥Lb' ↥M₂ * Module.finrank ↥M₂ F_hat = Module.finrank ↥Lb' F_hat :=
          Module.finrank_mul_finrank ↥Lb' ↥M₂ F_hat
        have hLb_M₁_fin : Module.finrank ↥Lb' F_hat = Module.finrank ↥M₁ F_hat := by
          have hEqSub : Lb = M₁ := hLb_eq_M₁
          subst hEqSub
          exact hFinrank_eq.symm
        rw [hDeg.2] at ht1
        exact Nat.mul_right_cancel hm2_pos (ht2.trans (hLb_M₁_fin.trans ht1.symm))
      have hL_neg_eq : (IntermediateField.adjoin K_hat ({-b'} : Set F_hat)).toSubfield.topologicalClosure = Lb' := by
        congr 2
        apply le_antisymm
        · rw [IntermediateField.adjoin_le_iff]
          intro w hw; rw [Set.mem_singleton_iff] at hw; subst hw
          exact IntermediateField.neg_mem _ (IntermediateField.mem_adjoin_simple_self K_hat b')
        · rw [IntermediateField.adjoin_le_iff]
          intro w hw; rw [Set.mem_singleton_iff] at hw; subst hw
          simpa using IntermediateField.neg_mem _ (IntermediateField.mem_adjoin_simple_self K_hat (-b'))
      have hα_not_Lb' : α ∉ Lb' := by
        intro hα_in
        rw [← hL_neg_eq] at hα_in
        have hne := (hPolyNoRoot (-b') hneg_b'_not).2 α hα_in
        apply hne
        dsimp [b']; ring
      have hLb'_le_Lα : Lb' ≤ (IntermediateField.adjoin K_hat ({α} : Set F_hat)).toSubfield.topologicalClosure := by
        apply Subfield.topologicalClosure_minimal
        · have hIF : IntermediateField.adjoin K_hat ({b'} : Set F_hat) ≤
              ((IntermediateField.adjoin K_hat ({α} : Set F_hat)).toSubfield.topologicalClosure).toIntermediateField
                (fun c => Subfield.le_topologicalClosure _ (IntermediateField.algebraMap_mem _ c)) := by
            rw [IntermediateField.adjoin_le_iff]
            intro w hw; rw [Set.mem_singleton_iff] at hw; subst hw
            apply Subfield.le_topologicalClosure
            change -(α ^ p) ∈ IntermediateField.adjoin K_hat ({α} : Set F_hat)
            exact IntermediateField.neg_mem _
              (pow_mem (IntermediateField.mem_adjoin_simple_self K_hat α) p)
          exact hIF
        · exact Subfield.isClosed_topologicalClosure _
      exact ⟨α, hPrimeStepEq Lb' hLb'_le_M₂ hRange_Lb' hDeg_Lb' α hα_M₂ hα_not_Lb' hLb'_le_Lα⟩
    · have ha_one : a = 1 := ha1
      subst hs1
      obtain ⟨α₁, hα₁_M₂, hα₁_lt⟩ := hP_good.2.2
      rw [ha_one, one_mul] at hα₁_lt
      let δ : F_hat := α₁ ^ p - α₁ + b
      have hδ_M₂ : δ ∈ M₂ :=
        M₂.add_mem (M₂.sub_mem (M₂.pow_mem hα₁_M₂ p) hα₁_M₂) (hLE (hAeval_M₁ P))
      have hδ_lt1 : ‖δ‖ < 1 := hα₁_lt
      let u_seq : ℕ → F_hat := fun n => ∑ k ∈ Finset.range n, δ ^ (p ^ k)
      have hu_mem : ∀ n : ℕ, u_seq n ∈ M₂ :=
        fun n => M₂.sum_mem fun k _ => M₂.pow_mem hδ_M₂ (p ^ k)
      have hu_cauchy : CauchySeq u_seq := by
        apply cauchySeq_of_le_geometric ‖δ‖ 1 hδ_lt1
        intro n
        have hdiff : u_seq n - u_seq (n + 1) = -(δ ^ (p ^ n)) := by
          dsimp [u_seq]
          rw [Finset.sum_range_succ]
          ring
        rw [dist_eq_norm, hdiff, norm_neg, norm_pow, one_mul]
        have hn_le : n ≤ p ^ n := le_of_lt (Nat.lt_pow_self hp.one_lt)
        exact pow_le_pow_of_le_one (norm_nonneg _) (le_of_lt hδ_lt1) hn_le
      obtain ⟨u_inf, hu_inf_M₂, hu_tendsto⟩ :=
        cauchySeq_tendsto_of_isComplete hM₂_closed.isComplete hu_mem hu_cauchy
      have hSumPowF : ∀ (n : ℕ), (u_seq n) ^ p = ∑ k ∈ Finset.range n, δ ^ (p ^ (k + 1)) := by
        intro n
        dsimp [u_seq]
        induction n with
        | zero => simp [zero_pow hp.ne_zero]
        | succ n ih =>
          rw [Finset.sum_range_succ, add_pow_char, ih, ← pow_mul, ← pow_succ, Finset.sum_range_succ]
      have hu_tel : ∀ n : ℕ, 1 ≤ n → (u_seq n) ^ p - u_seq n = δ ^ (p ^ n) - δ := by
        intro n _
        rw [hSumPowF n]
        dsimp [u_seq]
        have h1 : ∑ k ∈ Finset.range (n + 1), δ ^ (p ^ k) =
            (∑ k ∈ Finset.range n, δ ^ (p ^ k)) + δ ^ (p ^ n) :=
          Finset.sum_range_succ (fun k => δ ^ (p ^ k)) n
        have h2 : ∑ k ∈ Finset.range (n + 1), δ ^ (p ^ k) =
            (∑ k ∈ Finset.range n, δ ^ (p ^ (k + 1))) + δ ^ (p ^ 0) :=
          Finset.sum_range_succ' (fun k => δ ^ (p ^ k)) n
        rw [pow_zero, pow_one] at h2
        linear_combination h1 - h2
      have hu_eq : u_inf ^ p - u_inf = -δ := by
        have hcont : Continuous (fun u : F_hat => u ^ p - u) :=
          (continuous_pow p).sub continuous_id
        have ht1 : Filter.Tendsto (fun n => (u_seq (n + 1)) ^ p - u_seq (n + 1)) Filter.atTop
            (nhds (u_inf ^ p - u_inf)) :=
          (hcont.tendsto u_inf).comp ((Filter.tendsto_add_atTop_iff_nat 1).mpr hu_tendsto)
        have ht_pow0 : Filter.Tendsto (fun n : ℕ => δ ^ (p ^ (n + 1))) Filter.atTop (nhds 0) := by
          rw [tendsto_zero_iff_norm_tendsto_zero]
          apply squeeze_zero (g := fun n : ℕ => ‖δ‖ ^ (n + 1)) (fun _ => norm_nonneg _)
          · intro n
            rw [norm_pow]
            exact pow_le_pow_of_le_one (norm_nonneg _) (le_of_lt hδ_lt1)
              (le_of_lt (Nat.lt_pow_self hp.one_lt))
          · exact (tendsto_pow_atTop_nhds_zero_of_lt_one (norm_nonneg _) hδ_lt1).comp
              (Filter.tendsto_add_atTop_nat 1)
        have ht2 : Filter.Tendsto (fun n => (u_seq (n + 1)) ^ p - u_seq (n + 1)) Filter.atTop
            (nhds (-δ)) := by
          have heq_fn : (fun n => (u_seq (n + 1)) ^ p - u_seq (n + 1)) =
              (fun n => δ ^ (p ^ (n + 1)) - δ) := by
            ext n; exact hu_tel (n + 1) (by omega)
          rw [heq_fn]
          simpa using ht_pow0.sub tendsto_const_nhds
        exact tendsto_nhds_unique ht1 ht2
      let β : F_hat := α₁ + u_inf
      have hβ_M₂ : β ∈ M₂ := M₂.add_mem hα₁_M₂ hu_inf_M₂
      have hβ_root : β ^ p - β + b = 0 := by
        dsimp [β]
        rw [add_pow_char]
        calc α₁ ^ p + u_inf ^ p - (α₁ + u_inf) + b
            = (α₁ ^ p - α₁ + b) + (u_inf ^ p - u_inf) := by ring
          _ = δ + (-δ) := by rw [hu_eq]
          _ = 0 := by ring
      have hβ_not_M₁ : β ∉ M₁ := by
        intro hβ_in
        have hgt := hP_good.1 β hβ_in
        rw [ha_one, one_mul, hβ_root, norm_zero] at hgt
        linarith
      have hM₁_le_Lβ : M₁ ≤ (IntermediateField.adjoin K_hat ({β} : Set F_hat)).toSubfield.topologicalClosure := by
        rw [← hLb_eq_M₁]
        apply Subfield.topologicalClosure_minimal
        · have hIF : IntermediateField.adjoin K_hat ({b} : Set F_hat) ≤
              ((IntermediateField.adjoin K_hat ({β} : Set F_hat)).toSubfield.topologicalClosure).toIntermediateField
                (fun c => Subfield.le_topologicalClosure _ (IntermediateField.algebraMap_mem _ c)) := by
            rw [IntermediateField.adjoin_le_iff]
            intro w hw; rw [Set.mem_singleton_iff] at hw; subst hw
            apply Subfield.le_topologicalClosure
            have hb_β : b = β - β ^ p := by linear_combination hβ_root
            rw [hb_β]
            exact IntermediateField.sub_mem _
              (IntermediateField.mem_adjoin_simple_self K_hat β)
              (pow_mem (IntermediateField.mem_adjoin_simple_self K_hat β) p)
          exact hIF
        · exact Subfield.isClosed_topologicalClosure _
      exact ⟨β, hPrimeStepEq M₁ hLE hRange₁ hDeg β hβ_M₂ hβ_not_M₁ hM₁_le_Lβ⟩
  
  let K_init : Subfield F_hat :=
    (IntermediateField.adjoin K_hat ({y₀} : Set F_hat)).toSubfield.topologicalClosure
  have hRange_init : Set.range (algebraMap K_hat F_hat) ⊆ (K_init : Set F_hat) := by
    rintro _ ⟨c, rfl⟩
    exact Subfield.le_topologicalClosure _ (IntermediateField.algebraMap_mem _ c)
  have hClosed_init : IsClosed (K_init : Set F_hat) :=
    Subfield.isClosed_topologicalClosure _
  rcases hTower K_init hRange_init hClosed_init hy₀_fin with
    hInitTop | ⟨p, t, M, hp, hp0, hM0, hMlast, hMstep⟩
  · obtain ⟨ε, hε, hx'⟩ := hOpenBall y₀ hInitTop
    exact ⟨y₀, ε, hε, hx'⟩
  · have hPolyNoRoot : ∀ (w : F_hat), w ∉ Set.range (algebraMap K_hat F_hat) →
        let Mw : Subfield F_hat :=
          (IntermediateField.adjoin K_hat ({w} : Set F_hat)).toSubfield.topologicalClosure
        (∀ u ∈ Mw, ∀ ε : ℝ, 0 < ε → ∃ P : Polynomial K_hat, ‖u - Polynomial.aeval w P‖ < ε) ∧
        (∀ u ∈ Mw, u ^ p ≠ w) := by
      intro w hw_not
      obtain ⟨_, r_w, hr_w_pos, hr_w_le, hr_w_inf, _, _⟩ :=
        hCritPerturb.1 y₀ w hw_not hy₀_fin
      obtain ⟨_, hDense_w, hNoRoot_w⟩ :=
        hPolyDensityAndNoRoot w r_w hr_w_pos hr_w_le hr_w_inf
      exact ⟨hDense_w, hNoRoot_w p hp hp0⟩
    have hInd : ∀ k : ℕ, ∀ hk : k ≤ t,
        ∃ z_k : F_hat,
          z_k ∉ Set.range (algebraMap K_hat F_hat) ∧
          M ⟨k, Nat.lt_succ_of_le hk⟩ =
            (IntermediateField.adjoin K_hat ({z_k} : Set F_hat)).toSubfield.topologicalClosure := by
      intro k
      induction k with
      | zero =>
        intro _
        exact ⟨y₀, hy₀_not, hM0⟩
      | succ k ih =>
        intro hk1
        obtain ⟨z_k, hz_k_not, hz_k_eq⟩ := ih (Nat.le_of_succ_le hk1)
        let j : Fin t := ⟨k, hk1⟩
        obtain ⟨hLE_j, _, hCl_cast, hCl_succ, hDeg_j⟩ := hMstep j
        obtain ⟨_, r_zk, hr_zk_pos, hr_zk_le, hr_zk_inf, _, _⟩ :=
          hCritPerturb.1 y₀ z_k hz_k_not hy₀_fin
        obtain ⟨hr_zk_gt, _, _⟩ :=
          hPolyDensityAndNoRoot z_k r_zk hr_zk_pos hr_zk_le hr_zk_inf
        have hLead_zk := hLeadBound p hp hp0 z_k r_zk hr_zk_pos hr_zk_gt
        exact hStepMono p hp hp0 hPolyNoRoot (M j.castSucc) (M j.succ) hLE_j
          z_k r_zk hz_k_not hz_k_eq hCl_cast hCl_succ hDeg_j
          hr_zk_pos hr_zk_gt hr_zk_inf hLead_zk
    obtain ⟨x₀, _, hx₀_eq⟩ := hInd t le_rfl
    have hx₀_top : (IntermediateField.adjoin K_hat ({x₀} : Set F_hat)).toSubfield.topologicalClosure = ⊤ := by
      have hlast_idx : (⟨t, Nat.lt_succ_of_le le_rfl⟩ : Fin (t + 1)) = Fin.last t := rfl
      rw [hlast_idx, hMlast] at hx₀_eq
      exact hx₀_eq.symm
    obtain ⟨ε, hε, hx'⟩ := hOpenBall x₀ hx₀_top
    exact ⟨x₀, ε, hε, hx'⟩

theorem weil_composed_valuationSubring_etale (L₀ F : Type u) [Field L₀] [Field F] [Algebra L₀ F]
    (W A' : ValuationSubring F)
    (hFinW : Set.Finite (Set.univ : Set (PrimeSpectrum ↥W)))
    (hWA' : W ≤ A')
    (hEtA :
      let A := A'.comap (algebraMap L₀ F)
      RingHom.Etale (((algebraMap L₀ F).comp A.subtype).codRestrict A'.toSubring (fun y => y.2)))
    (hEtRes :
      let V₀ := W.comap (algebraMap L₀ F)
      let A := A'.comap (algebraMap L₀ F)
      let hVA : V₀.toSubring ≤ A.toSubring := fun _ hx => hWA' hx
      let hWA'_sub : W.toSubring ≤ A'.toSubring := fun _ hx => hWA' hx
      let φ_W : ↥V₀ →+* ↥W := (((algebraMap L₀ F).comp V₀.subtype).codRestrict W.toSubring (fun y => y.2))
      let q₀ : Ideal ↥V₀ := (IsLocalRing.maximalIdeal ↥A).comap (Subring.inclusion hVA)
      let q' : Ideal ↥W := (IsLocalRing.maximalIdeal ↥A').comap (Subring.inclusion hWA'_sub)
      ∃ (ψ : (↥V₀ ⧸ q₀) →+* (↥W ⧸ q')),
        (∀ u : ↥V₀, ψ (Ideal.Quotient.mk q₀ u) = Ideal.Quotient.mk q' (φ_W u)) ∧ RingHom.Etale ψ) :
    let V₀ := W.comap (algebraMap L₀ F)
    RingHom.Etale (((algebraMap L₀ F).comp V₀.subtype).codRestrict W.toSubring (fun y => y.2)) :=
by
  classical
  
  have isField_of_etale_domain : ∀ (E D : Type u) [Field E] [CommRing D] [IsDomain D]
      [Algebra E D] [Algebra.Etale E D], IsField D := by
    intro E D _ _ _ _ _
    obtain ⟨I, _, Ai, hFieldAi, hAlgAi, e, _⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod E D).mp inferInstance
    letI := hFieldAi
    letI := hAlgAi
    refine ⟨⟨0, 1, zero_ne_one⟩, mul_comm, fun {d} hd => ?_⟩
    have hcoord : ∀ i : I, e d i ≠ 0 := by
      intro i hi
      let v : ∀ j : I, Ai j := Pi.single i 1
      have hv : v ≠ 0 := by
        intro hv0
        have h1 : v i = 0 := congrFun hv0 i
        simp [v] at h1
      have hmul : e d * v = 0 := by
        ext j
        by_cases hji : j = i
        · subst hji; simp [v, hi]
        · simp [v, Pi.single_eq_of_ne hji]
      have hd0 : d * e.symm v = 0 := by
        apply e.injective
        rw [map_mul, e.apply_symm_apply, map_zero, hmul]
      rcases mul_eq_zero.mp hd0 with rfl | hsymm0
      · exact hd rfl
      · exact hv (by rw [← e.apply_symm_apply v, hsymm0, map_zero])
    refine ⟨e.symm (fun i => (e d i)⁻¹), ?_⟩
    apply e.injective
    rw [map_mul, e.apply_symm_apply, map_one]
    ext i
    exact mul_inv_cancel₀ (hcoord i)

  
  have isSeparable_congr : ∀ (K₁ L₁ K₂ L₂ : Type u)
      [Field K₁] [Field L₁] [Algebra K₁ L₁] [Algebra.IsSeparable K₁ L₁]
      [Field K₂] [Field L₂] [Algebra K₂ L₂]
      (eK : K₁ ≃+* K₂) (eL : L₁ ≃+* L₂),
      (∀ x : K₁, eL (algebraMap K₁ L₁ x) = algebraMap K₂ L₂ (eK x)) →
      Algebra.IsSeparable K₂ L₂ := by
    intro K₁ L₁ K₂ L₂ _ _ _ _ _ _ _ eK eL hcomm
    refine ⟨fun y => ?_⟩
    let y₁ : L₁ := eL.symm y
    have hsep₁ : IsSeparable K₁ y₁ := Algebra.IsSeparable.isSeparable K₁ y₁
    have hint₁ : IsIntegral K₁ y₁ := IsSeparable.isIntegral hsep₁
    let p₁ : Polynomial K₁ := minpoly K₁ y₁
    let p₂ : Polynomial K₂ := p₁.map eK.toRingHom
    have hp₂_sep : p₂.Separable := Polynomial.Separable.map hsep₁
    have hp₂_eval : Polynomial.aeval y p₂ = 0 := by
      rw [Polynomial.aeval_def, Polynomial.eval₂_map]
      have hhom : (algebraMap K₂ L₂).comp eK.toRingHom = eL.toRingHom.comp (algebraMap K₁ L₁) := by
        ext x; exact (hcomm x).symm
      rw [hhom, show y = eL.toRingHom y₁ from (eL.apply_symm_apply y).symm, ← Polynomial.hom_eval₂]
      change eL (Polynomial.aeval y₁ p₁) = 0
      rw [minpoly.aeval, map_zero]
    exact hp₂_sep.of_dvd (minpoly.dvd K₂ y hp₂_eval)

  
  have cotangent_abstract : ∀ (C C' B B' P P_bar K : Type u)
      [CommRing C] [CommRing C'] [IsLocalRing C'] [Algebra C C']
      [CommRing B] [CommRing B'] [IsLocalRing B'] [Algebra B B']
      [CommRing P] [Algebra C P] [Algebra P C'] [IsScalarTower C P C']
      [Algebra.FormallySmooth C P] [Module.Free P Ω[P⁄C]] [Module.Finite P Ω[P⁄C]]
      [CommRing P_bar] [Algebra B P_bar] [Algebra P_bar B'] [IsScalarTower B P_bar B']
      [Algebra.FormallySmooth B P_bar] [Module.Free P_bar Ω[P_bar⁄B]] [Module.Finite P_bar Ω[P_bar⁄B]]
      [Algebra.FormallySmooth B B']
      [Field K] [Algebra C' K] [Algebra P K] [IsScalarTower P C' K]
      [Algebra B' K] [Algebra P_bar K] [IsScalarTower P_bar B' K]
      (q_P : P →+* P_bar), Function.Surjective q_P →
      ∀ (L_Ω : Ω[P⁄C] →+ Ω[P_bar⁄B]),
        (∀ (p : P) (ω : Ω[P⁄C]), L_Ω (p • ω) = q_P p • L_Ω ω) →
        (∀ f : P, L_Ω (KaehlerDifferential.D C P f) = KaehlerDifferential.D B P_bar (q_P f)) →
        (∀ p : P, algebraMap P_bar K (q_P p) = algebraMap P K p) →
        Function.Surjective (algebraMap P C') →
        (RingHom.ker (algebraMap P C')).FG →
        IsLocalRing.maximalIdeal C' ≤ RingHom.ker (algebraMap C' K) →
        Function.Surjective (algebraMap P_bar B') →
        (RingHom.ker (algebraMap P_bar B')).FG →
        IsLocalRing.maximalIdeal B' ≤ RingHom.ker (algebraMap B' K) →
        (∀ f ∈ RingHom.ker (algebraMap P C'), q_P f ∈ RingHom.ker (algebraMap P_bar B')) →
        (∀ fb ∈ RingHom.ker (algebraMap P_bar B'),
          ∃ f ∈ RingHom.ker (algebraMap P C'), q_P f = fb) →
        (∀ d ∈ RingHom.ker (algebraMap P C'), q_P d = 0 →
          ∃ p₀ : P, algebraMap P K p₀ = 0 ∧
            ∃ G ∈ RingHom.ker (algebraMap P C'), d = p₀ * G) →
        Algebra.FormallySmooth C C' := by
    intro C C' B B' P P_bar K _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _
      q_P hq_P_surj L_Ω hL_smul hL_D halgK_comm hπ_surj hI_fg hmC'_le
      hπ_bar_surj hI_bar_fg hmB'_le hqP_ker hLift hFactorK
    set I : Ideal P := RingHom.ker (algebraMap P C')
    set I_bar : Ideal P_bar := RingHom.ker (algebraMap P_bar B')
    have hInj_B : Function.Injective (KaehlerDifferential.cotangentComplexBaseChange B B' P_bar K) :=
      (Algebra.FormallySmooth.iff_injective_cotangentComplexBaseChange P_bar K
        hπ_bar_surj hI_bar_fg hmB'_le).mp inferInstance
    have hEx_α : ∃ α : TensorProduct P K ↥I →+ TensorProduct P_bar K ↥I_bar,
        ∀ (a : K) (f : ↥I), α (a ⊗ₜ[P] f) = a ⊗ₜ[P_bar] ⟨q_P f.1, hqP_ker f.1 f.2⟩ := by
      letI : Module P (TensorProduct P_bar K ↥I_bar) :=
        Module.compHom (TensorProduct P_bar K ↥I_bar) q_P
      haveI : SMulCommClass P P (TensorProduct P_bar K ↥I_bar) :=
        ⟨fun p₁ p₂ z => by rw [← mul_smul, ← mul_smul, mul_comm]⟩
      let bil := LinearMap.mk₂ P
        (fun (a : K) (f : ↥I) => (a ⊗ₜ[P_bar] ⟨q_P f.1, hqP_ker f.1 f.2⟩ : TensorProduct P_bar K ↥I_bar))
        (fun a₁ a₂ _ => TensorProduct.add_tmul a₁ a₂ _)
        (fun p a _ => by
          have hpa : p • a = q_P p • a := by rw [Algebra.smul_def, Algebra.smul_def, halgK_comm]
          rw [hpa, ← TensorProduct.smul_tmul']
          rfl)
        (fun a f₁ f₂ => by
          have h1 : (⟨q_P (f₁ + f₂).1, hqP_ker _ (f₁ + f₂).2⟩ : ↥I_bar) =
              ⟨q_P f₁.1, hqP_ker _ f₁.2⟩ + ⟨q_P f₂.1, hqP_ker _ f₂.2⟩ :=
            Subtype.ext (map_add q_P f₁.1 f₂.1)
          rw [h1, TensorProduct.tmul_add])
        (fun p a f => by
          have h1 : (⟨q_P (p • f).1, hqP_ker _ (p • f).2⟩ : ↥I_bar) =
              q_P p • ⟨q_P f.1, hqP_ker _ f.2⟩ := Subtype.ext (map_mul q_P p f.1)
          rw [h1]
          have h2 : a ⊗ₜ[P_bar] (q_P p • (⟨q_P f.1, hqP_ker _ f.2⟩ : ↥I_bar)) =
              (q_P p • a) ⊗ₜ[P_bar] ⟨q_P f.1, hqP_ker _ f.2⟩ := by
            rw [TensorProduct.smul_tmul]
          rw [h2, ← TensorProduct.smul_tmul']
          rfl)
      refine ⟨(TensorProduct.lift bil).toAddMonoidHom, fun a f => ?_⟩
      change TensorProduct.lift bil (a ⊗ₜ[P] f) = _
      rw [TensorProduct.lift.tmul, LinearMap.mk₂_apply]
    obtain ⟨α, hα_tmul⟩ := hEx_α
    have hLift_indep : ∀ (a : K) (f₁ f₂ : ↥I), q_P f₁.1 = q_P f₂.1 →
        a ⊗ₜ[P] f₁ = a ⊗ₜ[P] f₂ := by
      intro a f₁ f₂ heq
      have hdiff_ker : f₁.1 - f₂.1 ∈ I := I.sub_mem f₁.2 f₂.2
      have hdiff_map : q_P (f₁.1 - f₂.1) = 0 := by rw [map_sub, heq, sub_self]
      obtain ⟨p₀, hp₀K, G, hG, hEqG⟩ := hFactorK (f₁.1 - f₂.1) hdiff_ker hdiff_map
      have hsub_eq : f₁ - f₂ = p₀ • (⟨G, hG⟩ : ↥I) := Subtype.ext hEqG
      rw [← sub_eq_zero, ← TensorProduct.tmul_sub, hsub_eq, ← TensorProduct.smul_tmul]
      have hsmulK : p₀ • a = 0 := by rw [Algebra.smul_def, hp₀K, zero_mul]
      rw [hsmulK, TensorProduct.zero_tmul]
    have hα_inj : Function.Injective α := by
      let liftFn : ↥I_bar → ↥I := fun fb =>
        ⟨Classical.choose (hLift fb.1 fb.2), (Classical.choose_spec (hLift fb.1 fb.2)).1⟩
      have hliftFn : ∀ fb : ↥I_bar, q_P (liftFn fb).1 = fb.1 :=
        fun fb => (Classical.choose_spec (hLift fb.1 fb.2)).2
      let kmul : K → (TensorProduct P K ↥I →ₗ[P] TensorProduct P K ↥I) :=
        fun c => LinearMap.rTensor ↥I (Algebra.lmul P K c)
      have hkmul_tmul : ∀ (c a : K) (f : ↥I), kmul c (a ⊗ₜ[P] f) = (c * a) ⊗ₜ[P] f :=
        fun _ _ _ => rfl
      letI : Module P_bar (TensorProduct P K ↥I) :=
        { smul := fun pb z => kmul (algebraMap P_bar K pb) z
          one_smul := fun z => by
            change kmul (algebraMap P_bar K 1) z = z
            refine TensorProduct.inductionOn z
              (fun a f => by rw [map_one, hkmul_tmul, one_mul])
              (fun x y hx hy => by rw [map_add, hx, hy])
          mul_smul := fun pb₁ pb₂ z => by
            change kmul (algebraMap P_bar K (pb₁ * pb₂)) z =
              kmul (algebraMap P_bar K pb₁) (kmul (algebraMap P_bar K pb₂) z)
            refine TensorProduct.inductionOn z
              (fun a f => by rw [map_mul, hkmul_tmul, hkmul_tmul, hkmul_tmul, mul_assoc])
              (fun x y hx hy => by rw [map_add, map_add, map_add, hx, hy])
          smul_zero := fun pb => map_zero _
          smul_add := fun pb x y => map_add _ x y
          add_smul := fun pb₁ pb₂ z => by
            change kmul (algebraMap P_bar K (pb₁ + pb₂)) z =
              kmul (algebraMap P_bar K pb₁) z + kmul (algebraMap P_bar K pb₂) z
            refine TensorProduct.inductionOn z
              (fun a f => by
                rw [map_add, hkmul_tmul, hkmul_tmul, hkmul_tmul, add_mul, TensorProduct.add_tmul])
              (fun x y hx hy => by rw [map_add, hx, hy, map_add, map_add]; abel)
          zero_smul := fun z => by
            change kmul (algebraMap P_bar K 0) z = 0
            refine TensorProduct.inductionOn z
              (fun a f => by rw [map_zero, hkmul_tmul, zero_mul, TensorProduct.zero_tmul])
              (fun x y hx hy => by rw [map_add, hx, hy, add_zero]) }
      haveI : SMulCommClass P_bar P_bar (TensorProduct P K ↥I) :=
        ⟨fun p₁ p₂ z => by rw [← mul_smul, ← mul_smul, mul_comm]⟩
      let β_bil := LinearMap.mk₂ P_bar
        (fun (a : K) (fb : ↥I_bar) => (a ⊗ₜ[P] liftFn fb : TensorProduct P K ↥I))
        (fun a₁ a₂ _ => TensorProduct.add_tmul a₁ a₂ _)
        (fun pb a _ => by rw [Algebra.smul_def]; rfl)
        (fun a x₁ x₂ => by
          rw [← TensorProduct.tmul_add]
          apply hLift_indep
          change q_P (liftFn (x₁ + x₂)).1 = q_P (liftFn x₁ + liftFn x₂).1
          rw [hliftFn, Submodule.coe_add, Submodule.coe_add, map_add, hliftFn, hliftFn])
        (fun pb a x => by
          obtain ⟨p, rfl⟩ := hq_P_surj pb
          change a ⊗ₜ[P] liftFn (q_P p • x) = (algebraMap P_bar K (q_P p) * a) ⊗ₜ[P] liftFn x
          rw [halgK_comm p, ← Algebra.smul_def, TensorProduct.smul_tmul]
          apply hLift_indep
          change q_P (liftFn (q_P p • x)).1 = q_P (p • liftFn x).1
          rw [hliftFn, Submodule.coe_smul_of_tower, Submodule.coe_smul_of_tower,
            smul_eq_mul, smul_eq_mul, map_mul, hliftFn])
      let β := TensorProduct.lift β_bil
      have hβα : ∀ x : TensorProduct P K ↥I, β (α x) = x := fun x =>
        TensorProduct.inductionOn x
          (fun a f => by
            rw [hα_tmul, TensorProduct.lift.tmul, LinearMap.mk₂_apply]
            exact hLift_indep a (liftFn ⟨q_P f.1, hqP_ker f.1 f.2⟩) f (hliftFn _))
          (fun x y hx hy => by rw [map_add, map_add, hx, hy])
      exact Function.LeftInverse.injective hβα
    have hEx_γ : ∃ γ : TensorProduct P K Ω[P⁄C] →+ TensorProduct P_bar K Ω[P_bar⁄B],
        ∀ (a : K) (ω : Ω[P⁄C]), γ (a ⊗ₜ[P] ω) = a ⊗ₜ[P_bar] L_Ω ω := by
      letI : Module P (TensorProduct P_bar K Ω[P_bar⁄B]) :=
        Module.compHom (TensorProduct P_bar K Ω[P_bar⁄B]) q_P
      haveI : SMulCommClass P P (TensorProduct P_bar K Ω[P_bar⁄B]) :=
        ⟨fun p₁ p₂ z => by rw [← mul_smul, ← mul_smul, mul_comm]⟩
      let γ_bil := LinearMap.mk₂ P
        (fun (a : K) (ω : Ω[P⁄C]) => (a ⊗ₜ[P_bar] L_Ω ω : TensorProduct P_bar K Ω[P_bar⁄B]))
        (fun a₁ a₂ _ => TensorProduct.add_tmul a₁ a₂ _)
        (fun p a _ => by
          have hpa : p • a = q_P p • a := by rw [Algebra.smul_def, Algebra.smul_def, halgK_comm]
          rw [hpa, ← TensorProduct.smul_tmul']
          rfl)
        (fun a ω₁ ω₂ => by rw [map_add, TensorProduct.tmul_add])
        (fun p a ω => by
          rw [hL_smul]
          have h1 : a ⊗ₜ[P_bar] (q_P p • L_Ω ω) = (q_P p • a) ⊗ₜ[P_bar] L_Ω ω := by
            rw [TensorProduct.smul_tmul]
          rw [h1, ← TensorProduct.smul_tmul']
          rfl)
      refine ⟨(TensorProduct.lift γ_bil).toAddMonoidHom, fun a ω => ?_⟩
      change TensorProduct.lift γ_bil (a ⊗ₜ[P] ω) = _
      rw [TensorProduct.lift.tmul, LinearMap.mk₂_apply]
    obtain ⟨γ, hγ_tmul⟩ := hEx_γ
    let Φ_C := KaehlerDifferential.cotangentComplexBaseChange C C' P K
    let Φ_B := KaehlerDifferential.cotangentComplexBaseChange B B' P_bar K
    have hSquare : ∀ x : TensorProduct P K ↥I, γ (Φ_C x) = Φ_B (α x) := fun x =>
      TensorProduct.inductionOn x
        (fun a f => by
          dsimp only [Φ_C, Φ_B]
          rw [hα_tmul, KaehlerDifferential.cotangentComplexBaseChange_tmul,
            KaehlerDifferential.cotangentComplexBaseChange_tmul,
            KaehlerDifferential.kerToTensor_apply, KaehlerDifferential.kerToTensor_apply]
          change γ ((a * 1) ⊗ₜ[P] KaehlerDifferential.D C P f.1) =
            (a * 1) ⊗ₜ[P_bar] KaehlerDifferential.D B P_bar (q_P f.1)
          rw [mul_one, hγ_tmul, hL_D])
        (fun x y hx hy => by rw [map_add, map_add, map_add, map_add, hx, hy])
    have hInj_C : Function.Injective Φ_C := by
      intro x y hxy
      apply hα_inj
      apply hInj_B
      change Φ_B (α x) = Φ_B (α y)
      rw [← hSquare, ← hSquare, hxy]
    exact (Algebra.FormallySmooth.iff_injective_cotangentComplexBaseChange P K
      hπ_surj hI_fg hmC'_le).mpr hInj_C

  
  let V₀ : ValuationSubring L₀ := W.comap (algebraMap L₀ F)
  let A : ValuationSubring L₀ := A'.comap (algebraMap L₀ F)
  let hVA : V₀.toSubring ≤ A.toSubring := fun _ hx => hWA' hx
  let hWA'_sub : W.toSubring ≤ A'.toSubring := fun _ hx => hWA' hx
  let φ_W : ↥V₀ →+* ↥W := (((algebraMap L₀ F).comp V₀.subtype).codRestrict W.toSubring (fun y => y.2))
  let φ_A : ↥A →+* ↥A' := (((algebraMap L₀ F).comp A.subtype).codRestrict A'.toSubring (fun y => y.2))
  let ιA : ↥V₀ →+* ↥A := Subring.inclusion hVA
  let ιA' : ↥W →+* ↥A' := Subring.inclusion hWA'_sub
  let q₀ : Ideal ↥V₀ := (IsLocalRing.maximalIdeal ↥A).comap ιA
  let q' : Ideal ↥W := (IsLocalRing.maximalIdeal ↥A').comap ιA'
  change RingHom.Etale φ_W
  obtain ⟨ψ, hψ_comm, hψ_et⟩ := hEtRes
  have val_isUnit : ∀ {E : Type u} [Field E] (R : ValuationSubring E) (x : ↥R),
      IsUnit x ↔ (x.1 : E) ≠ 0 ∧ (x.1 : E)⁻¹ ∈ R := by
    intro E _ R x
    constructor
    · rintro ⟨u, rfl⟩
      have hm : (u.val.1 : E) * ((↑u⁻¹ : ↥R).1 : E) = 1 := congrArg Subtype.val u.val_inv
      have hne : (u.val.1 : E) ≠ 0 := left_ne_zero_of_mul_eq_one hm
      exact ⟨hne, (inv_eq_of_mul_eq_one_right hm).symm ▸ (↑u⁻¹ : ↥R).2⟩
    · rintro ⟨hne, hinv⟩
      exact ⟨⟨x, ⟨x.1⁻¹, hinv⟩, Subtype.ext (mul_inv_cancel₀ hne),
        Subtype.ext (inv_mul_cancel₀ hne)⟩, rfl⟩
  have hφW_inj : Function.Injective φ_W := fun _ _ h =>
    Subtype.ext ((algebraMap L₀ F).injective (congrArg Subtype.val h))
  have hιA_inj : Function.Injective ιA := Subring.inclusion_injective hVA
  have hιA'_inj : Function.Injective ιA' := Subring.inclusion_injective hWA'_sub
  have hComm : ∀ u : ↥V₀, φ_A (ιA u) = ιA' (φ_W u) := fun _ => rfl
  have hφW_unit : ∀ u : ↥V₀, IsUnit (φ_W u) ↔ IsUnit u := by
    intro u
    rw [val_isUnit W (φ_W u), val_isUnit V₀ u]
    change algebraMap L₀ F u.1 ≠ 0 ∧ (algebraMap L₀ F u.1)⁻¹ ∈ W ↔
      u.1 ≠ 0 ∧ u.1⁻¹ ∈ V₀
    rw [map_ne_zero_iff _ (algebraMap L₀ F).injective, ← map_inv₀]
    rfl
  have hφA_unit : ∀ u : ↥A, IsUnit (φ_A u) ↔ IsUnit u := by
    intro u
    rw [val_isUnit A' (φ_A u), val_isUnit A u]
    change algebraMap L₀ F u.1 ≠ 0 ∧ (algebraMap L₀ F u.1)⁻¹ ∈ A' ↔
      u.1 ≠ 0 ∧ u.1⁻¹ ∈ A
    rw [map_ne_zero_iff _ (algebraMap L₀ F).injective, ← map_inv₀]
    rfl
  haveI hφW_loc : _root_.IsLocalHom φ_W := ⟨fun {_} hu => (hφW_unit _).mp hu⟩
  haveI hφA_loc : _root_.IsLocalHom φ_A := ⟨fun {_} hu => (hφA_unit _).mp hu⟩
  haveI hq₀_prime : q₀.IsPrime := Ideal.IsPrime.comap ιA
  haveI hq'_prime : q'.IsPrime := Ideal.IsPrime.comap ιA'
  have hq_comap : q'.comap φ_W = q₀ := by
    ext u
    simp only [q₀, q', Ideal.mem_comap, IsLocalRing.mem_maximalIdeal,
      mem_nonunits_iff, ← hComm u, hφA_unit]
  have hψ_inj : Function.Injective ψ := by
    intro x₁ x₂ h
    obtain ⟨u₁, rfl⟩ := Ideal.Quotient.mk_surjective x₁
    obtain ⟨u₂, rfl⟩ := Ideal.Quotient.mk_surjective x₂
    rw [hψ_comm, hψ_comm, Ideal.Quotient.eq] at h
    rw [Ideal.Quotient.eq]
    have hmem : u₁ - u₂ ∈ q'.comap φ_W := by
      change φ_W (u₁ - u₂) ∈ q'
      rwa [map_sub]
    rwa [hq_comap] at hmem
  have hmA_range : ∀ m ∈ IsLocalRing.maximalIdeal ↥A, ∃ x ∈ q₀, ιA x = m := by
    intro m hm
    rcases V₀.mem_or_inv_mem m.1 with hmV | hinvV
    · exact ⟨⟨m.1, hmV⟩, hm, Subtype.ext rfl⟩
    · by_cases hm0 : m.1 = 0
      · exact ⟨0, q₀.zero_mem, Subtype.ext hm0.symm⟩
      · exfalso
        exact (IsLocalRing.mem_maximalIdeal _).mp hm ((val_isUnit A m).mpr ⟨hm0, hVA hinvV⟩)
  have map_mem_single : ∀ {R S : Type u} [CommRing R] [IsDomain R] [ValuationRing R] [CommRing S]
      (f : R →+* S) (J : Ideal R) (w : S),
      w ∈ Ideal.map f J → ∃ x ∈ J, ∃ s' : S, w = f x * s' := by
    intro R S _ _ _ _ f J w hw
    let M : Ideal S :=
      { carrier := { z : S | ∃ x ∈ J, ∃ s' : S, z = f x * s' }
        add_mem' := by
          rintro z₁ z₂ ⟨x₁, hx₁, s₁, rfl⟩ ⟨x₂, hx₂, s₂, rfl⟩
          rcases ValuationRing.dvd_total x₁ x₂ with ⟨d, rfl⟩ | ⟨d, rfl⟩
          · exact ⟨x₁, hx₁, s₁ + f d * s₂, by rw [map_mul]; ring⟩
          · exact ⟨x₂, hx₂, f d * s₁ + s₂, by rw [map_mul]; ring⟩
        zero_mem' := ⟨0, J.zero_mem, 0, by simp⟩
        smul_mem' := by
          rintro c z ⟨x, hx, s', rfl⟩
          exact ⟨x, hx, c * s', by rw [smul_eq_mul]; ring⟩ }
    have hle : Ideal.map f J ≤ M :=
      Ideal.map_le_iff_le_comap.mpr fun x hx => ⟨x, hx, 1, (mul_one (f x)).symm⟩
    exact hle hw
  have radical_isPrime : ∀ {R : Type u} [CommRing R] [IsDomain R] [ValuationRing R]
      (J : Ideal R), J ≠ ⊤ → J.radical.IsPrime := by
    intro R _ _ _ J hJ
    refine ⟨?_, ?_⟩
    · intro htop
      have h1 : (1 : R) ∈ J.radical := htop.symm ▸ Submodule.mem_top
      obtain ⟨n, hn⟩ := h1
      rw [one_pow] at hn
      exact hJ (Ideal.eq_top_of_isUnit_mem J hn isUnit_one)
    · intro u v ⟨n, hn⟩
      rcases ValuationRing.dvd_total u v with ⟨d, rfl⟩ | ⟨d, rfl⟩
      · right
        refine ⟨2 * n, ?_⟩
        have hsq : (u * d) ^ 2 = (u * (u * d)) * d := by ring
        rw [pow_mul, hsq, mul_pow]
        exact J.mul_mem_right (d ^ n) hn
      · left
        refine ⟨2 * n, ?_⟩
        have hsq : (v * d) ^ 2 = ((v * d) * v) * d := by ring
        rw [pow_mul, hsq, mul_pow]
        exact J.mul_mem_right (d ^ n) hn

  
  have hFinV₀ : Set.Finite (Set.univ : Set (PrimeSpectrum ↥V₀)) := by
    have hSurj : ∀ P : PrimeSpectrum ↥V₀, ∃ Q : PrimeSpectrum ↥W, PrimeSpectrum.comap φ_W Q = P := by
      intro P
      have hMapNeTop : Ideal.map φ_W P.asIdeal ≠ ⊤ := by
        intro htop
        have hle : Ideal.map φ_W P.asIdeal ≤ IsLocalRing.maximalIdeal ↥W := by
          rw [Ideal.map_le_iff_le_comap]
          intro x hx
          have hx_m : x ∈ IsLocalRing.maximalIdeal ↥V₀ :=
            IsLocalRing.le_maximalIdeal P.isPrime.ne_top hx
          rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hx_m
          rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
          exact fun hu => hx_m ((hφW_unit x).mp hu)
        exact (IsLocalRing.maximalIdeal.isMaximal ↥W).ne_top (top_unique (htop ▸ hle))
      let Q_id : Ideal ↥W := (Ideal.map φ_W P.asIdeal).radical
      have hQ_prime : Q_id.IsPrime := radical_isPrime _ hMapNeTop
      refine ⟨⟨Q_id, hQ_prime⟩, PrimeSpectrum.ext (Ideal.ext fun c => ⟨?_, fun hc =>
        Ideal.le_radical (Ideal.mem_map_of_mem φ_W hc)⟩)⟩
      intro ⟨n, hn⟩
      rw [← map_pow] at hn
      obtain ⟨p₀, hp₀, w', hw'⟩ := map_mem_single φ_W P.asIdeal (φ_W (c ^ n)) hn
      by_cases hp0 : p₀ = 0
      · subst hp0
        rw [map_zero, zero_mul] at hw'
        have hcn : c ^ n = 0 := hφW_inj (hw'.trans (map_zero φ_W).symm)
        exact P.isPrime.mem_of_pow_mem n (hcn.symm ▸ P.asIdeal.zero_mem)
      · have hp0_val : (p₀.1 : L₀) ≠ 0 := fun h => hp0 (Subtype.ext h)
        have hp0_F : algebraMap L₀ F p₀.1 ≠ 0 :=
          (map_ne_zero_iff _ (algebraMap L₀ F).injective).mpr hp0_val
        let d₀ : L₀ := c.1 ^ n * (p₀.1)⁻¹
        have hd₀_F : algebraMap L₀ F d₀ = w'.1 := by
          have hval : algebraMap L₀ F (c.1 ^ n) = algebraMap L₀ F p₀.1 * w'.1 :=
            congrArg Subtype.val hw'
          simp only [d₀, map_mul, map_pow, map_inv₀]
          rw [← map_pow, hval, mul_right_comm, mul_inv_cancel₀ hp0_F, one_mul]
        have hd₀_V₀ : d₀ ∈ V₀ := by
          change algebraMap L₀ F d₀ ∈ W
          rw [hd₀_F]
          exact w'.2
        have hcn_eq : c ^ n = p₀ * ⟨d₀, hd₀_V₀⟩ :=
          Subtype.ext (by
            change c.1 ^ n = p₀.1 * (c.1 ^ n * (p₀.1)⁻¹)
            rw [mul_left_comm, mul_inv_cancel₀ hp0_val, mul_one])
        exact P.isPrime.mem_of_pow_mem n (hcn_eq ▸ P.asIdeal.mul_mem_right _ hp₀)
    exact (hFinW.image (PrimeSpectrum.comap φ_W)).subset fun P _ =>
      let ⟨Q, hQ⟩ := hSurj P; ⟨Q, trivial, hQ⟩

  have hDvd_W_to_V₀ : ∀ t' : ↥W, t' ∉ q' → ∃ t : ↥V₀, t ∉ q₀ ∧ t' ∣ φ_W t := by
    let B := ↥V₀ ⧸ q₀
    let B' := ↥W ⧸ q'
    letI : Algebra B B' := ψ.toAlgebra
    haveI : Algebra.Etale B B' := RingHom.etale_algebraMap.mp hψ_et
    let KB := FractionRing B
    let MB := nonZeroDivisors B
    let T₁ := TensorProduct B KB B'
    let T₂ := TensorProduct B B' KB
    haveI : Algebra.Etale KB T₁ := Algebra.Etale.baseChange B B' KB
    haveI : IsLocalization (Algebra.algebraMapSubmonoid B' MB) T₂ := IsLocalization.tensor KB MB
    have hSubMB : Algebra.algebraMapSubmonoid B' MB ≤ nonZeroDivisors B' := by
      rintro _ ⟨m, hm, rfl⟩
      rw [mem_nonZeroDivisors_iff_ne_zero]
      exact fun h0 => nonZeroDivisors.ne_zero hm (hψ_inj (h0.trans (map_zero ψ).symm))
    haveI : IsDomain T₂ := IsLocalization.isDomain_of_le_nonZeroDivisors T₂ hSubMB
    have hInjT₂ : Function.Injective (algebraMap B' T₂) := IsLocalization.injective T₂ hSubMB
    let eComm : T₁ ≃+* T₂ := (Algebra.TensorProduct.comm B KB B').toRingEquiv
    have hNZD₁ : NoZeroDivisors T₁ :=
      ⟨fun {x y} hxy => by
        have h0 : eComm x * eComm y = 0 := by rw [← map_mul, hxy, map_zero]
        exact (mul_eq_zero.mp h0).imp
          (fun hx => eComm.injective (hx.trans (map_zero _).symm))
          (fun hy => eComm.injective (hy.trans (map_zero _).symm))⟩
    have hNontriv₁ : Nontrivial T₁ :=
      ⟨0, 1, fun h01 =>
        have h01' : (0 : T₂) = 1 := by rw [← map_zero eComm, h01, map_one]
        one_ne_zero (α := B') (hInjT₂ (by rw [map_one, map_zero]; exact h01'.symm))⟩
    haveI : IsDomain T₁ := { hNZD₁, hNontriv₁ with }
    have hFieldT₁ : IsField T₁ := isField_of_etale_domain KB T₁
    intro t' ht'
    let b' : B' := Ideal.Quotient.mk q' t'
    have hb' : b' ≠ 0 := fun h0 => ht' (Ideal.Quotient.eq_zero_iff_mem.mp h0)
    have hb'T : algebraMap B' T₂ b' ≠ 0 := fun h0 => hb' (hInjT₂ (h0.trans (map_zero _).symm))
    have hb'T₁ : eComm.symm (algebraMap B' T₂ b') ≠ 0 :=
      fun h0 => hb'T (by rw [← eComm.apply_symm_apply (algebraMap B' T₂ b'), h0, map_zero])
    obtain ⟨z₁, hz₁⟩ := hFieldT₁.mul_inv_cancel hb'T₁
    let z : T₂ := eComm z₁
    have hz : algebraMap B' T₂ b' * z = 1 := by
      have h1 := congrArg eComm hz₁
      rwa [map_mul, eComm.apply_symm_apply, map_one] at h1
    obtain ⟨⟨c', s₀⟩, hsurj⟩ := IsLocalization.surj (Algebra.algebraMapSubmonoid B' MB) z
    have hbc_eq : b' * c' = s₀.1 := by
      apply hInjT₂
      rw [map_mul, ← hsurj, ← mul_assoc, hz, one_mul]
    obtain ⟨m, hm, hs₀⟩ := s₀.2
    obtain ⟨t, rfl⟩ := Ideal.Quotient.mk_surjective m
    have ht_not_q₀ : t ∉ q₀ := fun ht =>
      nonZeroDivisors.ne_zero hm (Ideal.Quotient.eq_zero_iff_mem.mpr ht)
    obtain ⟨u', rfl⟩ := Ideal.Quotient.mk_surjective c'
    have hmk_eq : Ideal.Quotient.mk q' (φ_W t) = Ideal.Quotient.mk q' (t' * u') := by
      rw [← hψ_comm t, show ψ (Ideal.Quotient.mk q₀ t) = s₀.1 from hs₀, ← hbc_eq, map_mul]
    have hr'_mem : φ_W t - t' * u' ∈ q' := Ideal.Quotient.eq.mp hmk_eq
    rcases ValuationRing.dvd_total t' (φ_W t - t' * u') with ⟨v', hv'⟩ | ⟨v', hv'⟩
    · refine ⟨t, ht_not_q₀, u' + v', ?_⟩
      linear_combination hv'
    · exfalso
      exact ht' (hv' ▸ q'.mul_mem_right v' hr'_mem)

  have hEx_s : ∃ s : ↥V₀, s ∉ q₀ ∧
      (∀ x ∈ q₀, ∀ k : ℕ, ∃ y ∈ q₀, x = s ^ k * y) ∧
      (∀ t : ↥V₀, t ∉ q₀ → ∃ k : ℕ, t ∣ s ^ k) := by
    let S_gt : Set (PrimeSpectrum ↥V₀) := { P | q₀ < P.asIdeal }
    by_cases hS_ne : S_gt.Nonempty
    · obtain ⟨P_next, hP_mem, hP_min⟩ :=
        Set.Finite.exists_minimal (hFinV₀.subset (Set.subset_univ _)) hS_ne
      have hP_least : ∀ Q ∈ S_gt, P_next.asIdeal ≤ Q.asIdeal := by
        intro Q hQ
        rcases (ValuationRing.le_total_ideal ↥V₀).total Q.asIdeal P_next.asIdeal with hQP | hPQ
        · exact hP_min hQ hQP
        · exact hPQ
      obtain ⟨s, hs_P, hs_not_q₀⟩ := SetLike.exists_of_lt (show q₀ < P_next.asIdeal from hP_mem)
      refine ⟨s, hs_not_q₀, ?_, ?_⟩
      · intro x hx k
        have hs_pow : s ^ k ∉ q₀ := fun h => hs_not_q₀ (hq₀_prime.mem_of_pow_mem k h)
        rcases ValuationRing.dvd_total (s ^ k) x with ⟨y, rfl⟩ | ⟨y, hy⟩
        · exact ⟨y, (hq₀_prime.mem_or_mem hx).resolve_left hs_pow, rfl⟩
        · exact absurd (hy ▸ q₀.mul_mem_right y hx) hs_pow
      · intro t ht
        by_cases htu : IsUnit t
        · exact ⟨0, htu.dvd⟩
        · have hspan_ne : Ideal.span ({t} : Set ↥V₀) ≠ ⊤ := by
            intro htop
            have h1 : (1 : ↥V₀) ∈ Ideal.span ({t} : Set ↥V₀) := htop.symm ▸ Submodule.mem_top
            obtain ⟨d, hd⟩ := Ideal.mem_span_singleton.mp h1
            exact htu ⟨⟨t, d, hd.symm, mul_comm t d ▸ hd.symm⟩, rfl⟩
          let Pt := (Ideal.span ({t} : Set ↥V₀)).radical
          have hPt_prime : Pt.IsPrime := radical_isPrime _ hspan_ne
          have ht_Pt : t ∈ Pt := Ideal.le_radical (Ideal.subset_span rfl)
          have hnot_le : ¬ Pt ≤ q₀ := fun hle => ht (hle ht_Pt)
          have hq₀_lt_Pt : q₀ < Pt := by
            rcases (ValuationRing.le_total_ideal ↥V₀).total Pt q₀ with hle | hle
            · exact absurd hle hnot_le
            · exact lt_of_le_of_ne hle fun heq => hnot_le (heq ▸ le_rfl)
          have hs_Pt : s ∈ Pt := hP_least ⟨Pt, hPt_prime⟩ hq₀_lt_Pt hs_P
          obtain ⟨k, hk⟩ := hs_Pt
          exact ⟨k, Ideal.mem_span_singleton.mp hk⟩
    · have hq₀_max : q₀ = IsLocalRing.maximalIdeal ↥V₀ := by
        apply le_antisymm (IsLocalRing.le_maximalIdeal hq₀_prime.ne_top)
        by_contra hnot_le
        have hlt : q₀ < IsLocalRing.maximalIdeal ↥V₀ :=
          lt_of_le_of_ne (IsLocalRing.le_maximalIdeal hq₀_prime.ne_top)
            (fun heq => hnot_le (heq ▸ le_rfl))
        exact hS_ne ⟨⟨IsLocalRing.maximalIdeal ↥V₀, inferInstance⟩, hlt⟩
      refine ⟨1, fun h1 => hq₀_prime.ne_top (Ideal.eq_top_of_isUnit_mem q₀ h1 isUnit_one),
        fun x hx k => ⟨x, hx, by simp⟩, fun t ht => ?_⟩
      rw [hq₀_max, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_not] at ht
      exact ⟨0, ht.dvd⟩
  obtain ⟨s, hs_not_q₀, hq₀_div, hdvd_V₀⟩ := hEx_s

  have hdvd_W : ∀ t' : ↥W, t' ∉ q' → ∃ k : ℕ, t' ∣ φ_W s ^ k := by
    intro t' ht'
    obtain ⟨t, ht, htdvd⟩ := hDvd_W_to_V₀ t' ht'
    obtain ⟨k, hkdvd⟩ := hdvd_V₀ t ht
    exact ⟨k, dvd_trans htdvd (map_pow φ_W s k ▸ map_dvd φ_W hkdvd)⟩

  have clear_of_dvd : ∀ {E : Type u} [Field E] (R S : ValuationSubring E)
      (hRS : R.toSubring ≤ S.toSubring) (r : ↥R),
      (∀ t : ↥R, t ∉ (IsLocalRing.maximalIdeal ↥S).comap (Subring.inclusion hRS) →
        ∃ k : ℕ, t ∣ r ^ k) →
      ∀ z : ↥S, ∃ (k : ℕ) (c : ↥R), z * Subring.inclusion hRS (r ^ k) = Subring.inclusion hRS c := by
    intro E _ R S hRS r hdvd z
    rcases R.mem_or_inv_mem z.1 with hzR | hinvR
    · exact ⟨0, ⟨z.1, hzR⟩, Subtype.ext (by simp)⟩
    · by_cases hz0 : z.1 = 0
      · exact ⟨0, 0, Subtype.ext (by simp [hz0])⟩
      · let t : ↥R := ⟨z.1⁻¹, hinvR⟩
        have hzt : z * Subring.inclusion hRS t = 1 := Subtype.ext (mul_inv_cancel₀ hz0)
        have ht_not_q : t ∉ (IsLocalRing.maximalIdeal ↥S).comap (Subring.inclusion hRS) := by
          rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_not]
          exact ⟨⟨Subring.inclusion hRS t, z, mul_comm z _ ▸ hzt, hzt⟩, rfl⟩
        obtain ⟨k, d, hk⟩ := hdvd t ht_not_q
        refine ⟨k, d, ?_⟩
        rw [hk, map_mul, ← mul_assoc, hzt, one_mul]
  have hClear_A : ∀ z : ↥A, ∃ (k : ℕ) (x : ↥V₀), z * ιA (s ^ k) = ιA x :=
    clear_of_dvd V₀ A hVA s hdvd_V₀
  have hClear_A' : ∀ z : ↥A', ∃ (k : ℕ) (w : ↥W), z * ιA' (φ_W s ^ k) = ιA' w :=
    clear_of_dvd W A' hWA'_sub (φ_W s) hdvd_W

  
  let B := ↥V₀ ⧸ q₀
  let B' := ↥W ⧸ q'
  letI : Algebra ↥V₀ ↥W := φ_W.toAlgebra
  letI : Algebra ↥A ↥A' := φ_A.toAlgebra
  letI : Algebra B B' := ψ.toAlgebra
  haveI hEt_A : Algebra.Etale ↥A ↥A' := RingHom.etale_algebraMap.mp hEtA
  haveI hEt_B : Algebra.Etale B B' := RingHom.etale_algebraMap.mp hψ_et
  have hs_ne : s ≠ 0 := fun h0 => hs_not_q₀ (h0 ▸ q₀.zero_mem)
  have hφs_ne : φ_W s ≠ 0 := fun h0 => hs_ne (hφW_inj (h0.trans (map_zero φ_W).symm))

  have hq_map : Ideal.map φ_W q₀ = q' := by
    apply le_antisymm (Ideal.map_le_iff_le_comap.mpr hq_comap.ge)
    haveI : _root_.IsLocalHom (algebraMap ↥A ↥A') := hφA_loc
    have hmA'_eq : Ideal.map φ_A (IsLocalRing.maximalIdeal ↥A) = IsLocalRing.maximalIdeal ↥A' :=
      Algebra.FormallyUnramified.map_maximalIdeal
    let I_loc : Ideal ↥A' :=
      { carrier := { z : ↥A' | ∃ (k : ℕ) (j : ↥W), j ∈ Ideal.map φ_W q₀ ∧ z * ιA' (φ_W s ^ k) = ιA' j }
        add_mem' := by
          rintro z₁ z₂ ⟨k₁, j₁, hj₁, hz₁⟩ ⟨k₂, j₂, hj₂, hz₂⟩
          refine ⟨k₁ + k₂, j₁ * φ_W s ^ k₂ + j₂ * φ_W s ^ k₁,
            Ideal.add_mem _ (Ideal.mul_mem_right _ _ hj₁) (Ideal.mul_mem_right _ _ hj₂), ?_⟩
          rw [pow_add, map_mul, map_add, map_mul, map_mul]
          linear_combination ιA' (φ_W s ^ k₂) * hz₁ + ιA' (φ_W s ^ k₁) * hz₂
        zero_mem' := ⟨0, 0, Ideal.zero_mem _, by simp⟩
        smul_mem' := by
          rintro a' z ⟨k₁, j₁, hj₁, hz₁⟩
          obtain ⟨k₂, c', hc'⟩ := hClear_A' a'
          refine ⟨k₁ + k₂, c' * j₁, Ideal.mul_mem_left _ c' hj₁, ?_⟩
          rw [smul_eq_mul, pow_add, map_mul, map_mul]
          linear_combination (z * ιA' (φ_W s ^ k₁)) * hc' + ιA' c' * hz₁ }
    have hI_loc_ge : IsLocalRing.maximalIdeal ↥A' ≤ I_loc := by
      rw [← hmA'_eq, Ideal.map_le_iff_le_comap]
      intro m hm
      obtain ⟨x, hxq₀, rfl⟩ := hmA_range m hm
      exact ⟨0, φ_W x, Ideal.mem_map_of_mem φ_W hxq₀, by rw [pow_zero, map_one, mul_one, hComm]⟩
    intro w hw
    obtain ⟨k, j, hj, hw_eq⟩ := hI_loc_ge hw
    have hw_W : w * φ_W s ^ k = j := hιA'_inj (by rwa [map_mul])
    obtain ⟨x, hxq₀, u, rfl⟩ := map_mem_single φ_W q₀ j hj
    obtain ⟨y, hyq₀, rfl⟩ := hq₀_div x hxq₀ k
    have hw_y : w = φ_W y * u :=
      mul_right_cancel₀ (pow_ne_zero k hφs_ne) (by rw [hw_W, map_mul, map_pow]; ring)
    rw [hw_y]
    exact Ideal.mul_mem_right u _ (Ideal.mem_map_of_mem φ_W hyq₀)

  
  obtain ⟨S_A', hS_A'⟩ := (inferInstance : Algebra.FiniteType ↥A ↥A').out
  obtain ⟨S_B', hS_B'⟩ := (inferInstance : Algebra.FiniteType B B').out
  let k_fn : ↥A' → ℕ := fun z => Classical.choose (hClear_A' z)
  let a_fn : ↥A' → ↥W := fun z => Classical.choose (Classical.choose_spec (hClear_A' z))
  have ha_fn : ∀ z : ↥A', z * ιA' (φ_W s ^ k_fn z) = ιA' (a_fn z) :=
    fun z => Classical.choose_spec (Classical.choose_spec (hClear_A' z))
  let b_fn : B' → ↥W := fun zb => Classical.choose (Ideal.Quotient.mk_surjective zb)
  have hb_fn : ∀ zb : B', Ideal.Quotient.mk q' (b_fn zb) = zb :=
    fun zb => Classical.choose_spec (Ideal.Quotient.mk_surjective zb)
  let S_gen : Finset ↥W := S_A'.image a_fn ∪ S_B'.image b_fn
  let C'' : Subalgebra ↥V₀ ↥W := Algebra.adjoin ↥V₀ (S_gen : Set ↥W)
  have hC''_top : C'' = ⊤ := by
    let A''_loc : Subalgebra ↥A ↥A' :=
      { carrier := { z : ↥A' | ∃ k : ℕ, ∃ c ∈ C'', z * ιA' (φ_W s ^ k) = ιA' c }
        mul_mem' := by
          rintro z₁ z₂ ⟨k₁, c₁, hc₁, hz₁⟩ ⟨k₂, c₂, hc₂, hz₂⟩
          refine ⟨k₁ + k₂, c₁ * c₂, C''.mul_mem hc₁ hc₂, ?_⟩
          rw [pow_add, map_mul, map_mul]
          linear_combination (z₂ * ιA' (φ_W s ^ k₂)) * hz₁ + ιA' c₁ * hz₂
        one_mem' := ⟨0, 1, C''.one_mem, by simp⟩
        add_mem' := by
          rintro z₁ z₂ ⟨k₁, c₁, hc₁, hz₁⟩ ⟨k₂, c₂, hc₂, hz₂⟩
          refine ⟨k₁ + k₂, c₁ * φ_W s ^ k₂ + c₂ * φ_W s ^ k₁,
            C''.add_mem (C''.mul_mem hc₁ (by rw [← map_pow]; exact C''.algebraMap_mem (s ^ k₂)))
              (C''.mul_mem hc₂ (by rw [← map_pow]; exact C''.algebraMap_mem (s ^ k₁))), ?_⟩
          rw [pow_add, map_mul, map_add, map_mul, map_mul]
          linear_combination ιA' (φ_W s ^ k₂) * hz₁ + ιA' (φ_W s ^ k₁) * hz₂
        zero_mem' := ⟨0, 0, C''.zero_mem, by simp⟩
        algebraMap_mem' := by
          intro a
          obtain ⟨k, x, hx⟩ := hClear_A a
          refine ⟨k, φ_W x, C''.algebraMap_mem x, ?_⟩
          change φ_A a * ιA' (φ_W s ^ k) = ιA' (φ_W x)
          rw [← map_pow, ← hComm, ← map_mul, hx, hComm] }
    have hA''_top : A''_loc = ⊤ := by
      rw [eq_top_iff, ← hS_A', Algebra.adjoin_le_iff]
      intro z hz
      exact ⟨k_fn z, a_fn z, Algebra.subset_adjoin
        (Finset.mem_coe.mpr (Finset.mem_union_left _ (Finset.mem_image_of_mem a_fn hz))), ha_fn z⟩
    let B'' : Subalgebra B B' :=
      { carrier := { zb : B' | ∃ c ∈ C'', Ideal.Quotient.mk q' c = zb }
        mul_mem' := by
          rintro _ _ ⟨c₁, hc₁, rfl⟩ ⟨c₂, hc₂, rfl⟩
          exact ⟨c₁ * c₂, C''.mul_mem hc₁ hc₂, map_mul _ c₁ c₂⟩
        one_mem' := ⟨1, C''.one_mem, map_one _⟩
        add_mem' := by
          rintro _ _ ⟨c₁, hc₁, rfl⟩ ⟨c₂, hc₂, rfl⟩
          exact ⟨c₁ + c₂, C''.add_mem hc₁ hc₂, map_add _ c₁ c₂⟩
        zero_mem' := ⟨0, C''.zero_mem, map_zero _⟩
        algebraMap_mem' := by
          intro ub
          obtain ⟨u, rfl⟩ := Ideal.Quotient.mk_surjective ub
          exact ⟨φ_W u, C''.algebraMap_mem u, (hψ_comm u).symm⟩ }
    have hB''_top : B'' = ⊤ := by
      rw [eq_top_iff, ← hS_B', Algebra.adjoin_le_iff]
      intro zb hzb
      exact ⟨b_fn zb, Algebra.subset_adjoin
        (Finset.mem_coe.mpr (Finset.mem_union_right _ (Finset.mem_image_of_mem b_fn hzb))), hb_fn zb⟩
    rw [eq_top_iff]
    intro w _
    have hwb : Ideal.Quotient.mk q' w ∈ B'' := hB''_top.symm ▸ Algebra.mem_top
    obtain ⟨c₀, hc₀, hmk_c₀⟩ := hwb
    have hdiff_q' : w - c₀ ∈ q' := Ideal.Quotient.eq.mp hmk_c₀.symm
    rw [← hq_map] at hdiff_q'
    obtain ⟨x, hxq₀, u, hwu⟩ := map_mem_single φ_W q₀ (w - c₀) hdiff_q'
    have hu_A'' : ιA' u ∈ A''_loc := hA''_top.symm ▸ Algebra.mem_top
    obtain ⟨k, c₁, hc₁, hu_eq⟩ := hu_A''
    have hu_W : u * φ_W s ^ k = c₁ := hιA'_inj (by rwa [map_mul])
    obtain ⟨y, _, rfl⟩ := hq₀_div x hxq₀ k
    have hw_eq : w = c₀ + φ_W y * c₁ := by
      have h1 : w - c₀ = φ_W y * (u * φ_W s ^ k) := by
        rw [hwu, map_mul, map_pow]; ring
      rw [hu_W] at h1
      linear_combination h1
    rw [hw_eq]
    exact C''.add_mem hc₀ (C''.mul_mem (C''.algebraMap_mem y) hc₁)

  
  let N : ℕ := Fintype.card ↥S_gen
  let eFin : Fin N ≃ ↥S_gen := (Fintype.equivFin ↥S_gen).symm
  let g : Fin N → ↥W := fun i => (eFin i).1
  let P := MvPolynomial (Fin N) ↥V₀
  let π : P →ₐ[↥V₀] ↥W := MvPolynomial.aeval g
  have hπ_surj : Function.Surjective π := by
    have hrange_top : π.range = ⊤ := by
      rw [eq_top_iff, ← hC''_top, Algebra.adjoin_le_iff]
      intro w hw
      refine ⟨MvPolynomial.X (eFin.symm ⟨w, hw⟩), ?_⟩
      change MvPolynomial.aeval g (MvPolynomial.X (eFin.symm ⟨w, hw⟩)) = w
      rw [MvPolynomial.aeval_X]
      exact congrArg Subtype.val (eFin.apply_symm_apply ⟨w, hw⟩)
    intro w
    have hw_mem : w ∈ π.range := hrange_top.symm ▸ Algebra.mem_top
    exact hw_mem

  let P_bar := MvPolynomial (Fin N) B
  let q_P : P →+* P_bar := MvPolynomial.map (Ideal.Quotient.mk q₀)
  have hq_P_surj : Function.Surjective q_P :=
    MvPolynomial.map_surjective _ Ideal.Quotient.mk_surjective
  let π_bar : P_bar →ₐ[B] B' := MvPolynomial.aeval (fun i => Ideal.Quotient.mk q' (g i))
  have hπ_bar_comm : ∀ f : P, π_bar (q_P f) = Ideal.Quotient.mk q' (π f) := by
    intro f
    induction f using MvPolynomial.induction_on with
    | C c =>
      rw [show q_P (MvPolynomial.C c) = MvPolynomial.C (Ideal.Quotient.mk q₀ c) from
        MvPolynomial.map_C _ c, MvPolynomial.aeval_C, MvPolynomial.aeval_C]
      exact hψ_comm c
    | add p q hp hq =>
      rw [map_add, map_add, map_add, map_add, hp, hq]
    | mul_X p i hp =>
      change π_bar (q_P (p * MvPolynomial.X i)) = Ideal.Quotient.mk q' (π (p * MvPolynomial.X i))
      rw [map_mul, map_mul, map_mul, map_mul, hp]
      have hX1 : q_P (MvPolynomial.X i) = MvPolynomial.X i := MvPolynomial.map_X _ i
      rw [hX1, MvPolynomial.aeval_X, MvPolynomial.aeval_X]
  have hπ_bar_surj : Function.Surjective π_bar := by
    intro b'
    obtain ⟨w, rfl⟩ := Ideal.Quotient.mk_surjective b'
    obtain ⟨f, rfl⟩ := hπ_surj w
    exact ⟨q_P f, hπ_bar_comm f⟩

  have finset_min_dvd : ∀ (S : Finset (Fin N →₀ ℕ)), S.Nonempty → ∀ (fn : (Fin N →₀ ℕ) → ↥V₀),
      ∃ a₀ ∈ S, ∀ a ∈ S, fn a₀ ∣ fn a := by
    intro S hS fn
    induction hS using Finset.Nonempty.cons_induction with
    | singleton x =>
      exact ⟨x, Finset.mem_singleton_self x, fun a ha => by rw [Finset.mem_singleton.mp ha]⟩
    | cons x s _ _ ih =>
      obtain ⟨a₀, ha₀, hmin⟩ := ih
      rcases ValuationRing.dvd_total (fn x) (fn a₀) with hxa₀ | ha₀x
      · refine ⟨x, Finset.mem_cons_self x s, fun a ha => ?_⟩
        rcases Finset.mem_cons.mp ha with rfl | has
        · exact dvd_rfl
        · exact dvd_trans hxa₀ (hmin a has)
      · refine ⟨a₀, Finset.mem_cons_of_mem ha₀, fun a ha => ?_⟩
        rcases Finset.mem_cons.mp ha with rfl | has
        · exact ha₀x
        · exact hmin a has

  have hFactor : ∀ d ∈ RingHom.ker π.toRingHom, q_P d = 0 →
      ∃ c ∈ q₀, ∃ G ∈ RingHom.ker π.toRingHom, d = MvPolynomial.C c * G := by
    intro d hd_ker hd_map
    by_cases hd0 : d = 0
    · exact ⟨0, q₀.zero_mem, 0, Ideal.zero_mem _, by simp [hd0]⟩
    · have hsupp : d.support.Nonempty := MvPolynomial.support_nonempty.mpr hd0
      obtain ⟨μ₀, hμ₀_mem, hμ₀_min⟩ := finset_min_dvd d.support hsupp (fun μ => d.coeff μ)
      let c₀ : ↥V₀ := d.coeff μ₀
      have hc₀_ne : c₀ ≠ 0 := MvPolynomial.mem_support_iff.mp hμ₀_mem
      have hc₀_q₀ : c₀ ∈ q₀ := by
        have hcoeff0 : (q_P d).coeff μ₀ = 0 := by rw [hd_map]; rfl
        rw [MvPolynomial.coeff_map] at hcoeff0
        exact Ideal.Quotient.eq_zero_iff_mem.mp hcoeff0
      let div_fn : (Fin N →₀ ℕ) → ↥V₀ := fun μ =>
        if h : μ ∈ d.support then Classical.choose (hμ₀_min μ h) else 0
      let G : P := ∑ μ ∈ d.support, MvPolynomial.monomial μ (div_fn μ)
      have hd_eq : d = MvPolynomial.C c₀ * G := by
        rw [Finset.mul_sum]
        have hsum_eq : ∑ x ∈ d.support, MvPolynomial.C c₀ * MvPolynomial.monomial x (div_fn x) =
            ∑ x ∈ d.support, MvPolynomial.monomial x (d.coeff x) := by
          refine Finset.sum_congr rfl fun μ hμ => ?_
          rw [MvPolynomial.C_mul_monomial]
          congr 1
          simp only [div_fn, dif_pos hμ]
          exact (Classical.choose_spec (hμ₀_min μ hμ)).symm
        rw [hsum_eq, ← MvPolynomial.as_sum d]
      have hG_ker : G ∈ RingHom.ker π.toRingHom := by
        change π G = 0
        have hπd : π d = 0 := hd_ker
        rw [hd_eq, map_mul, MvPolynomial.aeval_C] at hπd
        have hφc₀_ne : algebraMap ↥V₀ ↥W c₀ ≠ 0 :=
          fun h0 => hc₀_ne (hφW_inj (h0.trans (map_zero φ_W).symm))
        exact (mul_eq_zero.mp hπd).resolve_left hφc₀_ne
      exact ⟨c₀, hc₀_q₀, G, hG_ker, hd_eq⟩

  have hLift : ∀ fb ∈ RingHom.ker π_bar.toRingHom,
      ∃ f ∈ RingHom.ker π.toRingHom, q_P f = fb := by
    intro fb hfb
    obtain ⟨h₀, rfl⟩ := hq_P_surj fb
    have hπh₀_q' : π h₀ ∈ q' := by
      rw [← Ideal.Quotient.eq_zero_iff_mem, ← hπ_bar_comm]
      exact hfb
    rw [← hq_map] at hπh₀_q'
    obtain ⟨x, hxq₀, u', hu'⟩ := map_mem_single φ_W q₀ (π h₀) hπh₀_q'
    obtain ⟨U, rfl⟩ := hπ_surj u'
    refine ⟨h₀ - MvPolynomial.C x * U, ?_, ?_⟩
    · change π (h₀ - MvPolynomial.C x * U) = 0
      rw [map_sub, map_mul, MvPolynomial.aeval_C]
      exact sub_eq_zero.mpr hu'
    · rw [map_sub, map_mul]
      have hx0 : q_P (MvPolynomial.C x) = 0 := by
        change MvPolynomial.map (Ideal.Quotient.mk q₀) (MvPolynomial.C x) = 0
        rw [MvPolynomial.map_C, Ideal.Quotient.eq_zero_iff_mem.mpr hxq₀, map_zero]
      rw [hx0, zero_mul, sub_zero]

  have hI_bar_fg : (RingHom.ker π_bar.toRingHom).FG :=
    Algebra.FinitePresentation.ker_fg_of_mvPolynomial π_bar hπ_bar_surj

  have hI_fg : (RingHom.ker π.toRingHom).FG := by
    let P_A := MvPolynomial (Fin N) ↥A
    let j_P : P →+* P_A := MvPolynomial.map ιA
    have hj_P_inj : Function.Injective j_P := MvPolynomial.map_injective _ hιA_inj
    let π_A : P_A →ₐ[↥A] ↥A' := MvPolynomial.aeval (fun i => ιA' (g i))
    have hπA_comm : ∀ f : P, π_A (j_P f) = ιA' (π f) := by
      intro f
      induction f using MvPolynomial.induction_on with
      | C c =>
        rw [show j_P (MvPolynomial.C c) = MvPolynomial.C (ιA c) from MvPolynomial.map_C _ c,
          MvPolynomial.aeval_C, MvPolynomial.aeval_C]
        exact hComm c
      | add p q hp hq =>
        rw [map_add, map_add, map_add, map_add, hp, hq]
      | mul_X p i hp =>
        change π_A (j_P (p * MvPolynomial.X i)) = ιA' (π (p * MvPolynomial.X i))
        rw [map_mul, map_mul, map_mul, map_mul, hp]
        have hX1 : j_P (MvPolynomial.X i) = MvPolynomial.X i := MvPolynomial.map_X _ i
        rw [hX1, MvPolynomial.aeval_X, MvPolynomial.aeval_X]
    have hs_unitA : IsUnit (ιA s) := by
      by_contra hnu
      exact hs_not_q₀ ((IsLocalRing.mem_maximalIdeal (ιA s)).mpr (mem_nonunits_iff.mpr hnu))
    obtain ⟨u_s_unit, hu_s_val⟩ := hs_unitA
    let u_s : ↥A := ↑u_s_unit⁻¹
    have hu_s_mul : u_s * ιA s = 1 := by
      rw [← hu_s_val]; exact u_s_unit.inv_val
    have hπA_surj : Function.Surjective π_A := by
      intro z
      obtain ⟨k, w, hw⟩ := hClear_A' z
      obtain ⟨U, rfl⟩ := hπ_surj w
      refine ⟨MvPolynomial.C (u_s ^ k) * j_P U, ?_⟩
      rw [map_mul, MvPolynomial.aeval_C, hπA_comm, ← hw]
      have hinv_k : algebraMap ↥A ↥A' (u_s ^ k) * ιA' (φ_W s ^ k) = 1 := by
        change φ_A (u_s ^ k) * ιA' (φ_W s ^ k) = 1
        rw [← map_pow φ_W s k, ← hComm (s ^ k), ← map_mul, map_pow ιA s k, ← mul_pow, hu_s_mul,
          one_pow, map_one]
      linear_combination z * hinv_k
    obtain ⟨S_IA, hS_IA⟩ := Algebra.FinitePresentation.ker_fg_of_mvPolynomial π_A hπA_surj
    have hClear_P : ∀ Q : P_A, ∃ (k : ℕ) (Q₀ : P), MvPolynomial.C (ιA (s ^ k)) * Q = j_P Q₀ := by
      intro Q
      induction Q using MvPolynomial.induction_on with
      | C a =>
        obtain ⟨k, x, hx⟩ := hClear_A a
        refine ⟨k, MvPolynomial.C x, ?_⟩
        rw [← MvPolynomial.C_mul, mul_comm, hx]
        exact (MvPolynomial.map_C ιA x).symm
      | add p q hp hq =>
        obtain ⟨k₁, Q₁, hQ₁⟩ := hp
        obtain ⟨k₂, Q₂, hQ₂⟩ := hq
        refine ⟨k₁ + k₂, MvPolynomial.C (s ^ k₂) * Q₁ + MvPolynomial.C (s ^ k₁) * Q₂, ?_⟩
        rw [map_add, map_mul, map_mul, show j_P (MvPolynomial.C (s ^ k₂)) =
          MvPolynomial.C (ιA (s ^ k₂)) from MvPolynomial.map_C _ _,
          show j_P (MvPolynomial.C (s ^ k₁)) =
          MvPolynomial.C (ιA (s ^ k₁)) from MvPolynomial.map_C _ _,
          ← hQ₁, ← hQ₂, pow_add, map_mul, MvPolynomial.C_mul]
        ring
      | mul_X p i hp =>
        obtain ⟨k, Q₁, hQ₁⟩ := hp
        refine ⟨k, Q₁ * MvPolynomial.X i, ?_⟩
        rw [← mul_assoc, hQ₁, map_mul, show j_P (MvPolynomial.X i) =
          MvPolynomial.X i from MvPolynomial.map_X _ i]
    let f_ker_fn : P_A → P := fun FA => Classical.choose (Classical.choose_spec (hClear_P FA))
    let k_ker_fn : P_A → ℕ := fun FA => Classical.choose (hClear_P FA)
    have hf_ker_eq : ∀ FA : P_A, MvPolynomial.C (ιA (s ^ k_ker_fn FA)) * FA = j_P (f_ker_fn FA) :=
      fun FA => Classical.choose_spec (Classical.choose_spec (hClear_P FA))
    let S_f : Finset P := S_IA.image f_ker_fn
    have hSf_sub : (S_f : Set P) ⊆ RingHom.ker π.toRingHom := by
      intro x hx
      obtain ⟨FA, hFA_mem, rfl⟩ := Finset.mem_image.mp hx
      have hFA_ker : π_A FA = 0 := by
        have : FA ∈ RingHom.ker π_A.toRingHom :=
          hS_IA ▸ Ideal.subset_span (Finset.mem_coe.mpr hFA_mem)
        exact this
      change π (f_ker_fn FA) = 0
      apply hιA'_inj
      rw [map_zero, ← hπA_comm, ← hf_ker_eq, map_mul, hFA_ker, mul_zero]
    have hSpan_f : ∀ G ∈ RingHom.ker π.toRingHom,
        ∃ k : ℕ, MvPolynomial.C (s ^ k) * G ∈ Ideal.span (S_f : Set P) := by
      intro G hG
      have hjG_mem : j_P G ∈ Ideal.span (S_IA : Set P_A) := by
        rw [hS_IA]
        change π_A (j_P G) = 0
        rw [hπA_comm, show π G = 0 from hG, map_zero]
      have hInd : ∃ (k : ℕ) (J₀ : P), J₀ ∈ Ideal.span (S_f : Set P) ∧
          MvPolynomial.C (ιA (s ^ k)) * j_P G = j_P J₀ := by
        refine Submodule.span_induction
          (fun FA hFA => ⟨k_ker_fn FA, f_ker_fn FA,
            Ideal.subset_span (Finset.mem_coe.mpr (Finset.mem_image_of_mem f_ker_fn hFA)),
            hf_ker_eq FA⟩)
          ⟨0, 0, Ideal.zero_mem _, by simp⟩
          (fun x y _ _ ⟨k₁, J₁, hJ₁, hx⟩ ⟨k₂, J₂, hJ₂, hy⟩ => by
            refine ⟨k₁ + k₂, MvPolynomial.C (s ^ k₂) * J₁ + MvPolynomial.C (s ^ k₁) * J₂,
              Ideal.add_mem _ (Ideal.mul_mem_left _ _ hJ₁) (Ideal.mul_mem_left _ _ hJ₂), ?_⟩
            rw [map_add, map_mul, map_mul,
              show j_P (MvPolynomial.C (s ^ k₂)) = MvPolynomial.C (ιA (s ^ k₂)) from
                MvPolynomial.map_C _ _,
              show j_P (MvPolynomial.C (s ^ k₁)) = MvPolynomial.C (ιA (s ^ k₁)) from
                MvPolynomial.map_C _ _,
              ← hx, ← hy, pow_add, map_mul, MvPolynomial.C_mul]
            ring)
          (fun rA x _ ⟨k₁, J₁, hJ₁, hx⟩ => by
            obtain ⟨kr, R₀, hR₀⟩ := hClear_P rA
            refine ⟨kr + k₁, R₀ * J₁, Ideal.mul_mem_left _ R₀ hJ₁, ?_⟩
            rw [smul_eq_mul, map_mul, ← hR₀, ← hx, pow_add, map_mul, MvPolynomial.C_mul]
            ring)
          hjG_mem
      obtain ⟨k, J₀, hJ₀, heq⟩ := hInd
      refine ⟨k, ?_⟩
      have hGJ₀ : MvPolynomial.C (s ^ k) * G = J₀ := by
        apply hj_P_inj
        rw [map_mul, show j_P (MvPolynomial.C (s ^ k)) = MvPolynomial.C (ιA (s ^ k)) from
          MvPolynomial.map_C _ _, heq]
      rwa [hGJ₀]
    obtain ⟨S_Ibar, hS_Ibar⟩ := hI_bar_fg
    let h_ker_fn : P_bar → P := fun fb =>
      if h : fb ∈ RingHom.ker π_bar.toRingHom then Classical.choose (hLift fb h) else 0
    let S_h : Finset P := S_Ibar.image h_ker_fn
    have hSh_sub : (S_h : Set P) ⊆ RingHom.ker π.toRingHom := by
      intro x hx
      obtain ⟨fb, hfb_mem, rfl⟩ := Finset.mem_image.mp hx
      have hfb_ker : fb ∈ RingHom.ker π_bar.toRingHom :=
        hS_Ibar ▸ Ideal.subset_span (Finset.mem_coe.mpr hfb_mem)
      simp only [h_ker_fn, dif_pos hfb_ker]
      exact (Classical.choose_spec (hLift fb hfb_ker)).1
    have hSpan_h : ∀ fb ∈ RingHom.ker π_bar.toRingHom,
        ∃ F₀ ∈ Ideal.span (S_h : Set P), q_P F₀ = fb := by
      intro fb hfb
      have hfb_span : fb ∈ Ideal.span (S_Ibar : Set P_bar) := hS_Ibar.symm ▸ hfb
      refine Submodule.span_induction
        (fun hb hhb => by
          have hhb_ker : hb ∈ RingHom.ker π_bar.toRingHom :=
            hS_Ibar ▸ Ideal.subset_span hhb
          refine ⟨h_ker_fn hb, Ideal.subset_span
            (Finset.mem_coe.mpr (Finset.mem_image_of_mem h_ker_fn hhb)), ?_⟩
          simp only [h_ker_fn, dif_pos hhb_ker]
          exact (Classical.choose_spec (hLift hb hhb_ker)).2)
        ⟨0, Ideal.zero_mem _, map_zero q_P⟩
        (fun _ _ _ _ ⟨F₁, hF₁, hq₁⟩ ⟨F₂, hF₂, hq₂⟩ =>
          ⟨F₁ + F₂, Ideal.add_mem _ hF₁ hF₂, by rw [map_add, hq₁, hq₂]⟩)
        (fun rb _ _ ⟨F₁, hF₁, hq₁⟩ => by
          obtain ⟨R₀, rfl⟩ := hq_P_surj rb
          exact ⟨R₀ * F₁, Ideal.mul_mem_left _ R₀ hF₁, by rw [smul_eq_mul, map_mul, hq₁]⟩)
        hfb_span
    refine ⟨S_f ∪ S_h, le_antisymm ?_ ?_⟩
    · rw [Finset.coe_union, Ideal.span_le]
      exact Set.union_subset hSf_sub hSh_sub
    · intro F hF
      have hqF_ker : q_P F ∈ RingHom.ker π_bar.toRingHom := by
        change π_bar (q_P F) = 0
        rw [hπ_bar_comm, show π F = 0 from hF, map_zero]
      obtain ⟨F₀, hF₀_span, hqF₀⟩ := hSpan_h (q_P F) hqF_ker
      have hF₀_ker : F₀ ∈ RingHom.ker π.toRingHom :=
        (Ideal.span_le.mpr hSh_sub) hF₀_span
      have hdiff_ker : F - F₀ ∈ RingHom.ker π.toRingHom :=
        (RingHom.ker π.toRingHom).sub_mem hF hF₀_ker
      have hdiff_map : q_P (F - F₀) = 0 := by rw [map_sub, hqF₀, sub_self]
      obtain ⟨c₀, hc₀_q₀, G, hG_ker, hdiff_eq⟩ := hFactor (F - F₀) hdiff_ker hdiff_map
      obtain ⟨k, hGk_span⟩ := hSpan_f G hG_ker
      obtain ⟨y, _, rfl⟩ := hq₀_div c₀ hc₀_q₀ k
      have hdiff_Sf : F - F₀ ∈ Ideal.span (S_f : Set P) := by
        have hmul : F - F₀ = MvPolynomial.C y * (MvPolynomial.C (s ^ k) * G) := by
          rw [hdiff_eq, map_mul]; ring
        rw [hmul]
        exact Ideal.mul_mem_left _ (MvPolynomial.C y) hGk_span
      have hF_sum : F = (F - F₀) + F₀ := (sub_add_cancel F F₀).symm
      rw [hF_sum, Finset.coe_union]
      exact Ideal.add_mem _
        (Ideal.span_mono Set.subset_union_left hdiff_Sf)
        (Ideal.span_mono Set.subset_union_right hF₀_span)

  haveI hFP : Algebra.FinitePresentation ↥V₀ ↥W :=
    Algebra.FinitePresentation.of_surjective hπ_surj hI_fg

  
  letI : IsLocalRing B :=
    @IsLocalRing.of_surjective' ↥V₀ B _ _ _ _ (Ideal.Quotient.mk q₀) Ideal.Quotient.mk_surjective
  letI : IsLocalRing B' :=
    @IsLocalRing.of_surjective' ↥W B' _ _ _ _ (Ideal.Quotient.mk q') Ideal.Quotient.mk_surjective
  have unit_quot_iff : ∀ {R : Type u} [CommRing R] [IsLocalRing R] (q : Ideal R) [q.IsPrime]
      (r : R), IsUnit (Ideal.Quotient.mk q r) ↔ IsUnit r := by
    intro R _ _ q _ r
    refine ⟨fun hu => ?_, fun hr => (Ideal.Quotient.mk q).isUnit_map hr⟩
    obtain ⟨u, hu_eq⟩ := hu
    obtain ⟨v, hv⟩ := Ideal.Quotient.mk_surjective (↑u⁻¹ : R ⧸ q)
    have hrv1 : Ideal.Quotient.mk q (r * v - 1) = 0 := by
      rw [map_sub, map_mul, map_one, ← hu_eq, hv, Units.mul_inv, sub_self]
    have hmem_m : r * v - 1 ∈ IsLocalRing.maximalIdeal R :=
      IsLocalRing.le_maximalIdeal (Ideal.IsPrime.ne_top inferInstance)
        (Ideal.Quotient.eq_zero_iff_mem.mp hrv1)
    have hrv_unit : IsUnit (r * v) := by
      by_contra hnu
      have hrv_m : r * v ∈ IsLocalRing.maximalIdeal R :=
        (IsLocalRing.mem_maximalIdeal (r * v)).mpr (mem_nonunits_iff.mpr hnu)
      have h1_m : (1 : R) ∈ IsLocalRing.maximalIdeal R := by
        have heq : (1 : R) = r * v - (r * v - 1) := by ring
        rw [heq]
        exact (IsLocalRing.maximalIdeal R).sub_mem hrv_m hmem_m
      exact (IsLocalRing.maximalIdeal.isMaximal R).ne_top
        (Ideal.eq_top_of_isUnit_mem _ h1_m isUnit_one)
    exact isUnit_of_mul_isUnit_left hrv_unit

  have hmB_eq : IsLocalRing.maximalIdeal B =
      Ideal.map (Ideal.Quotient.mk q₀) (IsLocalRing.maximalIdeal ↥V₀) := by
    ext xb
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective xb
    constructor
    · intro hxb
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, unit_quot_iff] at hxb
      exact Ideal.mem_map_of_mem _ hxb
    · intro hxb
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, unit_quot_iff]
      have hle : Ideal.map (Ideal.Quotient.mk q₀) (IsLocalRing.maximalIdeal ↥V₀) ≤
          IsLocalRing.maximalIdeal B := by
        rw [Ideal.map_le_iff_le_comap]
        intro u hu
        rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, unit_quot_iff]
        exact hu
      have hxb' := hle hxb
      rwa [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, unit_quot_iff] at hxb'

  have hmB'_eq : IsLocalRing.maximalIdeal B' =
      Ideal.map (Ideal.Quotient.mk q') (IsLocalRing.maximalIdeal ↥W) := by
    ext wb
    obtain ⟨w, rfl⟩ := Ideal.Quotient.mk_surjective wb
    constructor
    · intro hwb
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, unit_quot_iff] at hwb
      exact Ideal.mem_map_of_mem _ hwb
    · intro hwb
      have hle : Ideal.map (Ideal.Quotient.mk q') (IsLocalRing.maximalIdeal ↥W) ≤
          IsLocalRing.maximalIdeal B' := by
        rw [Ideal.map_le_iff_le_comap]
        intro u hu
        rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, unit_quot_iff]
        exact hu
      exact hle hwb

  haveI hψ_loc : _root_.IsLocalHom (algebraMap B B') := by
    refine ⟨fun {xb} hxb => ?_⟩
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective xb
    change IsUnit (ψ (Ideal.Quotient.mk q₀ x)) at hxb
    rw [hψ_comm, unit_quot_iff, hφW_unit, ← unit_quot_iff q₀] at hxb
    exact hxb

  obtain ⟨hSep_B, hmB_map⟩ :=
    (Algebra.FormallyUnramified.iff_map_maximalIdeal_eq (R := B) (S := B')).mp inferInstance

  have hmW_map : Ideal.map (algebraMap ↥V₀ ↥W) (IsLocalRing.maximalIdeal ↥V₀) =
      IsLocalRing.maximalIdeal ↥W := by
    apply le_antisymm
    · rw [Ideal.map_le_iff_le_comap]
      intro x hx
      rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      change ¬ IsUnit (φ_W x)
      rw [hφW_unit]
      exact hx
    · intro w hw
      have hwb : Ideal.Quotient.mk q' w ∈ Ideal.map ψ (IsLocalRing.maximalIdeal B) := by
        change Ideal.Quotient.mk q' w ∈ Ideal.map (algebraMap B B') (IsLocalRing.maximalIdeal B)
        rw [hmB_map, hmB'_eq]
        exact Ideal.mem_map_of_mem _ hw
      rw [hmB_eq, Ideal.map_map] at hwb
      have hcomp_eq : ψ.comp (Ideal.Quotient.mk q₀) = (Ideal.Quotient.mk q').comp φ_W := by
        ext u; exact hψ_comm u
      rw [hcomp_eq, ← Ideal.map_map] at hwb
      obtain ⟨m', hm'_mem, hmk_m'⟩ :=
        (Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective).mp hwb
      have hdiff_q' : w - m' ∈ q' := Ideal.Quotient.eq.mp hmk_m'.symm
      have hq'_sub : q' ≤ Ideal.map φ_W (IsLocalRing.maximalIdeal ↥V₀) := by
        rw [← hq_map]
        exact Ideal.map_mono (IsLocalRing.le_maximalIdeal hq₀_prime.ne_top)
      have hw_sum : w = m' + (w - m') := (add_sub_cancel m' w).symm
      rw [hw_sum]
      exact Ideal.add_mem _ hm'_mem (hq'_sub hdiff_q')

  have hRes_equiv : ∀ {R : Type u} [CommRing R] [IsLocalRing R] (q : Ideal R) [q.IsPrime],
      letI : IsLocalRing (R ⧸ q) :=
        @IsLocalRing.of_surjective' R (R ⧸ q) _ _ _ _
          (Ideal.Quotient.mk q) Ideal.Quotient.mk_surjective
      ∃ e : IsLocalRing.ResidueField (R ⧸ q) ≃+* IsLocalRing.ResidueField R,
        ∀ r : R, e (IsLocalRing.residue (R ⧸ q) (Ideal.Quotient.mk q r)) =
          IsLocalRing.residue R r := by
    intro R _ _ q _
    letI : IsLocalRing (R ⧸ q) :=
      @IsLocalRing.of_surjective' R (R ⧸ q) _ _ _ _
        (Ideal.Quotient.mk q) Ideal.Quotient.mk_surjective
    have hq_ker : q ≤ RingHom.ker (IsLocalRing.residue R) := by
      rw [IsLocalRing.ker_residue]
      exact IsLocalRing.le_maximalIdeal (Ideal.IsPrime.ne_top inferInstance)
    let f₁ : (R ⧸ q) →+* IsLocalRing.ResidueField R :=
      Ideal.Quotient.lift q (IsLocalRing.residue R) hq_ker
    have hm_ker : IsLocalRing.maximalIdeal (R ⧸ q) ≤ RingHom.ker f₁ := by
      intro xb hxb
      obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective xb
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, unit_quot_iff] at hxb
      change IsLocalRing.residue R r = 0
      rwa [IsLocalRing.residue_eq_zero_iff]
    let f₂ : IsLocalRing.ResidueField (R ⧸ q) →+* IsLocalRing.ResidueField R :=
      Ideal.Quotient.lift (IsLocalRing.maximalIdeal (R ⧸ q)) f₁ hm_ker
    have hf₂_surj : Function.Surjective f₂ := by
      intro x
      obtain ⟨r, rfl⟩ := IsLocalRing.residue_surjective x
      exact ⟨IsLocalRing.residue (R ⧸ q) (Ideal.Quotient.mk q r), rfl⟩
    exact ⟨RingEquiv.ofBijective f₂ ⟨f₂.injective, hf₂_surj⟩, fun _ => rfl⟩

  obtain ⟨eB, heB⟩ := hRes_equiv q₀
  obtain ⟨eB', heB'⟩ := hRes_equiv q'
  haveI : _root_.IsLocalHom (algebraMap ↥V₀ ↥W) := hφW_loc
  haveI hSep_C : Algebra.IsSeparable (IsLocalRing.ResidueField ↥V₀) (IsLocalRing.ResidueField ↥W) := by
    haveI : Algebra.IsSeparable (IsLocalRing.ResidueField B) (IsLocalRing.ResidueField B') := hSep_B
    refine isSeparable_congr (IsLocalRing.ResidueField B) (IsLocalRing.ResidueField B')
      (IsLocalRing.ResidueField ↥V₀) (IsLocalRing.ResidueField ↥W) eB eB' ?_
    intro x
    obtain ⟨ub, rfl⟩ := IsLocalRing.residue_surjective x
    obtain ⟨u, rfl⟩ := Ideal.Quotient.mk_surjective ub
    change eB' (IsLocalRing.ResidueField.map ψ (IsLocalRing.residue B (Ideal.Quotient.mk q₀ u))) =
      IsLocalRing.ResidueField.map φ_W (eB (IsLocalRing.residue B (Ideal.Quotient.mk q₀ u)))
    rw [IsLocalRing.ResidueField.map_residue, hψ_comm, heB', heB, IsLocalRing.ResidueField.map_residue]

  haveI hUnram_C : Algebra.FormallyUnramified ↥V₀ ↥W :=
    Algebra.FormallyUnramified.of_map_maximalIdeal hmW_map

  
  have hdMap : ∃ L : Ω[P⁄↥V₀] →+ Ω[P_bar⁄B],
      (∀ (p : P) (ω : Ω[P⁄↥V₀]), L (p • ω) = q_P p • L ω) ∧
      (∀ f : P, L (KaehlerDifferential.D ↥V₀ P f) = KaehlerDifferential.D B P_bar (q_P f)) := by
    letI : Algebra P P_bar := q_P.toAlgebra
    haveI : IsScalarTower ↥V₀ P P_bar :=
      IsScalarTower.of_algebraMap_eq fun x => (MvPolynomial.map_C (Ideal.Quotient.mk q₀) x).symm
    haveI : SMulCommClass B P P_bar :=
      ⟨fun b p x => by
        rw [Algebra.smul_def, Algebra.smul_def, Algebra.smul_def, Algebra.smul_def]
        ring⟩
    let M := KaehlerDifferential.map ↥V₀ B P P_bar
    exact ⟨M.toAddMonoidHom, fun p ω => M.map_smul p ω, fun f => KaehlerDifferential.map_D _ _ _ _ f⟩
  obtain ⟨L_Ω, hL_smul, hL_D⟩ := hdMap

  have hSmooth_B : Algebra.FormallySmooth B B' :=
    (Algebra.FormallyEtale.iff_formallyUnramified_and_formallySmooth.mp hEt_B.formallyEtale).2
  haveI hSmooth_C : Algebra.FormallySmooth ↥V₀ ↥W := by
    haveI : Algebra.FormallySmooth B B' := hSmooth_B
    have hq'_ker_res : q' ≤ RingHom.ker (IsLocalRing.residue ↥W) := by
      rw [IsLocalRing.ker_residue]
      exact IsLocalRing.le_maximalIdeal hq'_prime.ne_top
    let ρ_B' : B' →+* IsLocalRing.ResidueField ↥W :=
      Ideal.Quotient.lift q' (IsLocalRing.residue ↥W) hq'_ker_res
    letI : Algebra P ↥W := π.toRingHom.toAlgebra
    letI : Algebra P_bar B' := π_bar.toRingHom.toAlgebra
    letI : Algebra B' (IsLocalRing.ResidueField ↥W) := ρ_B'.toAlgebra
    letI : Algebra P_bar (IsLocalRing.ResidueField ↥W) := (ρ_B'.comp π_bar.toRingHom).toAlgebra
    haveI : IsScalarTower ↥V₀ P ↥W :=
      IsScalarTower.of_algebraMap_eq fun x => (MvPolynomial.aeval_C _ x).symm
    haveI : IsScalarTower B P_bar B' :=
      IsScalarTower.of_algebraMap_eq fun x => (MvPolynomial.aeval_C _ x).symm
    haveI : IsScalarTower P_bar B' (IsLocalRing.ResidueField ↥W) :=
      IsScalarTower.of_algebraMap_eq' rfl
    have halgK_comm : ∀ p : P,
        algebraMap P_bar (IsLocalRing.ResidueField ↥W) (q_P p) =
          algebraMap P (IsLocalRing.ResidueField ↥W) p := fun p => by
      change ρ_B' (π_bar (q_P p)) = IsLocalRing.residue ↥W (π p)
      rw [hπ_bar_comm]; rfl
    have hmW_le : IsLocalRing.maximalIdeal ↥W ≤
        RingHom.ker (algebraMap ↥W (IsLocalRing.ResidueField ↥W)) := by
      rw [← IsLocalRing.ker_residue]; rfl
    have hmB'_le : IsLocalRing.maximalIdeal B' ≤
        RingHom.ker (algebraMap B' (IsLocalRing.ResidueField ↥W)) := by
      intro wb hwb
      obtain ⟨w, rfl⟩ := Ideal.Quotient.mk_surjective wb
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, unit_quot_iff] at hwb
      change IsLocalRing.residue ↥W w = 0
      rwa [IsLocalRing.residue_eq_zero_iff]
    have hqP_ker : ∀ f ∈ RingHom.ker (algebraMap P ↥W), q_P f ∈ RingHom.ker (algebraMap P_bar B') := by
      intro f hf
      change π_bar (q_P f) = 0
      rw [hπ_bar_comm, show π f = 0 from hf, map_zero]
    have hFactorK : ∀ d ∈ RingHom.ker (algebraMap P ↥W), q_P d = 0 →
        ∃ p₀ : P, algebraMap P (IsLocalRing.ResidueField ↥W) p₀ = 0 ∧
          ∃ G ∈ RingHom.ker (algebraMap P ↥W), d = p₀ * G := by
      intro d hd hqd
      obtain ⟨c, hcq₀, G, hG, hd_eq⟩ := hFactor d hd hqd
      refine ⟨MvPolynomial.C c, ?_, G, hG, hd_eq⟩
      change IsLocalRing.residue ↥W (π (MvPolynomial.C c)) = 0
      rw [MvPolynomial.aeval_C, IsLocalRing.residue_eq_zero_iff]
      have hc_q' : φ_W c ∈ q' := hq_map ▸ Ideal.mem_map_of_mem φ_W hcq₀
      exact IsLocalRing.le_maximalIdeal hq'_prime.ne_top hc_q'
    exact cotangent_abstract ↥V₀ ↥W B B' P P_bar (IsLocalRing.ResidueField ↥W)
      q_P hq_P_surj L_Ω hL_smul hL_D halgK_comm hπ_surj hI_fg hmW_le
      hπ_bar_surj hI_bar_fg hmB'_le hqP_ker hLift hFactorK

  haveI hFEt : Algebra.FormallyEtale ↥V₀ ↥W :=
    Algebra.FormallyEtale.iff_formallyUnramified_and_formallySmooth.mpr ⟨hUnram_C, hSmooth_C⟩
  haveI : Algebra.Etale ↥V₀ ↥W := ⟨hFEt, hFP⟩
  exact RingHom.etale_algebraMap.mpr inferInstance

theorem weil_heightOne_decompletion_etale (L₀ F : Type u) [Field L₀] [Field F]
    [Algebra L₀ F] [FiniteDimensional L₀ F] [Algebra.IsSeparable L₀ F]
    (W₁ : ValuationSubring F)
    (F_hat : Type u) [NontriviallyNormedField F_hat] [CompleteSpace F_hat] [IsUltrametricDist F_hat]
    (ι_F : F →+* F_hat)
    (hDense : DenseRange ι_F)
    (hW₁ : ∀ w : F, w ∈ W₁ ↔ ‖ι_F w‖ ≤ 1)
    (hGen :
      let Lx_hat : Subfield F_hat := (ι_F.comp (algebraMap L₀ F)).fieldRange.topologicalClosure
      let OF : ValuationSubring F_hat := (NormedField.valuation (K := F_hat)).valuationSubring
      let OLx : ValuationSubring ↥Lx_hat := OF.comap Lx_hat.subtype
      letI : Algebra ↥Lx_hat F_hat := Lx_hat.toAlgebra
      let φ_hat : ↥OLx →+* ↥OF := (Lx_hat.subtype.comp OLx.subtype).codRestrict OF.toSubring (fun y => y.2)
      letI : Algebra ↥OLx ↥OF := φ_hat.toAlgebra
      FiniteDimensional ↥Lx_hat F_hat ∧ Module.Finite ↥OLx ↥OF ∧ RingHom.Etale φ_hat) :
    let V₁ := W₁.comap (algebraMap L₀ F)
    RingHom.Etale (((algebraMap L₀ F).comp V₁.subtype).codRestrict W₁.toSubring (fun y => y.2)) :=
by
  classical
  have ultrametric_norm_sum_le :
      ∀ {ι : Type} {s : Finset ι} {f : ι → F_hat} {B : ℝ},
        0 ≤ B → (∀ i ∈ s, ‖f i‖ ≤ B) → ‖∑ i ∈ s, f i‖ ≤ B := by
    intro ι s f B hB hf
    induction s using Finset.induction_on with
    | empty => simpa using hB
    | @insert a s ha ih =>
      rw [Finset.sum_insert ha]
      exact (IsUltrametricDist.norm_add_le_max _ _).trans
        (max_le (hf a (Finset.mem_insert_self a s))
          (ih (fun i hi => hf i (Finset.mem_insert_of_mem hi))))
  have ultrametric_norm_sum_lt :
      ∀ {ι : Type} {s : Finset ι} {f : ι → F_hat} {B : ℝ},
        0 < B → (∀ i ∈ s, ‖f i‖ < B) → ‖∑ i ∈ s, f i‖ < B := by
    intro ι s f B hB hf
    induction s using Finset.induction_on with
    | empty => simpa using hB
    | @insert a s ha ih =>
      rw [Finset.sum_insert ha]
      exact (IsUltrametricDist.norm_add_le_max _ _).trans_lt
        (max_lt (hf a (Finset.mem_insert_self a s))
          (ih (fun i hi => hf i (Finset.mem_insert_of_mem hi))))
  let liftPolySubring : ∀ {R : Type u} [CommRing R] (S : Subring R)
      (p : Polynomial R), (∀ i : ℕ, p.coeff i ∈ S) → Polynomial ↥S :=
    fun S p hp => ∑ i ∈ p.support, Polynomial.C ⟨p.coeff i, hp i⟩ * Polynomial.X ^ i
  have liftPolySubring_map : ∀ {R : Type u} [CommRing R] (S : Subring R)
      (p : Polynomial R) (hp : ∀ i : ℕ, p.coeff i ∈ S),
      (liftPolySubring S p hp).map S.subtype = p := by
    intro R _ S p hp
    ext n
    rw [Polynomial.coeff_map]
    dsimp only [liftPolySubring]
    rw [Polynomial.finsetSum_coeff]
    simp only [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, mul_ite, mul_one, mul_zero]
    rw [Finset.sum_ite_eq]
    split_ifs with hn
    · rfl
    · exact (Polynomial.notMem_support_iff.mp hn).symm
  have natDegree_eq_of_map_injective : ∀ {R S : Type u} [Semiring R] [Semiring S]
      {φ : R →+* S}, Function.Injective φ → ∀ (q : Polynomial R),
      (q.map φ).natDegree = q.natDegree := by
    intro R S _ _ φ hφ q
    apply le_antisymm Polynomial.natDegree_map_le
    rw [Polynomial.natDegree_le_iff_coeff_eq_zero]
    intro n hn
    apply hφ
    rw [map_zero, ← Polynomial.coeff_map]
    exact Polynomial.coeff_eq_zero_of_natDegree_lt hn
  have liftPolySubring_monic : ∀ {R : Type u} [CommRing R] (S : Subring R)
      (p : Polynomial R), p.Monic → ∀ (hp : ∀ i : ℕ, p.coeff i ∈ S),
      (liftPolySubring S p hp).Monic := by
    intro R _ S p hp_monic hp
    have hmap := liftPolySubring_map S p hp
    have hdeg : (liftPolySubring S p hp).natDegree = p.natDegree := by
      rw [← natDegree_eq_of_map_injective (φ := S.subtype) Subtype.val_injective
        (liftPolySubring S p hp), hmap]
    rw [Polynomial.Monic, Polynomial.leadingCoeff, hdeg]
    apply Subtype.ext
    have hc : ((liftPolySubring S p hp).map S.subtype).coeff p.natDegree = p.coeff p.natDegree :=
      congrArg (fun f => f.coeff p.natDegree) hmap
    rw [Polynomial.coeff_map] at hc
    exact hc.trans hp_monic.leadingCoeff
  
  have hPart1 : ∃ a₀ : L₀, 1 < ‖ι_F (algebraMap L₀ F a₀)‖ := by
    obtain ⟨z_big, hz_big⟩ := NormedField.exists_one_lt_norm F_hat
    have hε₀ : 0 < (‖z_big‖ - 1) / 2 := by linarith
    obtain ⟨w, hw_dist⟩ := Metric.denseRange_iff.mp hDense z_big ((‖z_big‖ - 1) / 2) hε₀
    rw [dist_eq_norm] at hw_dist
    have hw_gt : 1 < ‖ι_F w‖ := by
      have htri : ‖z_big‖ ≤ ‖z_big - ι_F w‖ + ‖ι_F w‖ := by
        simpa using norm_add_le (z_big - ι_F w) (ι_F w)
      linarith
    have hw_int : IsIntegral L₀ w := Algebra.IsIntegral.isIntegral w
    let p : Polynomial L₀ := minpoly L₀ w
    have hp_monic : p.Monic := minpoly.monic hw_int
    have hp_pos : 0 < p.natDegree := minpoly.natDegree_pos hw_int
    have hp_eval : Polynomial.aeval w p = 0 := minpoly.aeval L₀ w
    by_contra! hle
    have hsum0 : ι_F (Polynomial.aeval w p) = 0 := by rw [hp_eval, map_zero]
    rw [Polynomial.aeval_eq_sum_range, Finset.sum_range_succ, hp_monic.coeff_natDegree] at hsum0
    simp only [Algebra.smul_def, map_one, one_mul, map_add, map_pow, map_sum, map_mul] at hsum0
    have hpow_eq : (ι_F w) ^ p.natDegree =
        - ∑ i ∈ Finset.range p.natDegree, ι_F (algebraMap L₀ F (p.coeff i)) * (ι_F w) ^ i := by
      linear_combination hsum0
    have hbound : ‖∑ i ∈ Finset.range p.natDegree,
        ι_F (algebraMap L₀ F (p.coeff i)) * (ι_F w) ^ i‖ ≤ ‖ι_F w‖ ^ (p.natDegree - 1) := by
      apply ultrametric_norm_sum_le (pow_nonneg (norm_nonneg (ι_F w)) _)
      intro i hi
      rw [Finset.mem_range] at hi
      rw [norm_mul, norm_pow]
      have hi_le : i ≤ p.natDegree - 1 := Nat.le_sub_one_of_lt hi
      have hpow_le : ‖ι_F w‖ ^ i ≤ ‖ι_F w‖ ^ (p.natDegree - 1) :=
        pow_le_pow_right₀ (le_of_lt hw_gt) hi_le
      calc ‖ι_F (algebraMap L₀ F (p.coeff i))‖ * ‖ι_F w‖ ^ i
          ≤ 1 * ‖ι_F w‖ ^ i :=
            mul_le_mul_of_nonneg_right (hle (p.coeff i)) (pow_nonneg (norm_nonneg _) _)
        _ = ‖ι_F w‖ ^ i := one_mul _
        _ ≤ ‖ι_F w‖ ^ (p.natDegree - 1) := hpow_le
    have hpow_le : ‖ι_F w‖ ^ p.natDegree ≤ ‖ι_F w‖ ^ (p.natDegree - 1) := by
      calc ‖ι_F w‖ ^ p.natDegree = ‖(ι_F w) ^ p.natDegree‖ := (norm_pow _ _).symm
        _ = ‖∑ i ∈ Finset.range p.natDegree,
              ι_F (algebraMap L₀ F (p.coeff i)) * (ι_F w) ^ i‖ := by rw [hpow_eq, norm_neg]
        _ ≤ ‖ι_F w‖ ^ (p.natDegree - 1) := hbound
    have hpow_lt : ‖ι_F w‖ ^ (p.natDegree - 1) < ‖ι_F w‖ ^ p.natDegree :=
      pow_lt_pow_right₀ hw_gt (Nat.sub_one_lt_of_lt hp_pos)
    linarith
  
  have hPart2 :
      ∀ (K_sub : Subfield F_hat),
        (∃ π : ↥K_sub, 0 < ‖(π : F_hat)‖ ∧ ‖(π : F_hat)‖ < 1) →
        (let OF : ValuationSubring F_hat := (NormedField.valuation (K := F_hat)).valuationSubring
         let OK : ValuationSubring ↥K_sub := OF.comap K_sub.subtype
         letI : Algebra ↥K_sub F_hat := K_sub.toAlgebra
         let φ_hat : ↥OK →+* ↥OF :=
           (K_sub.subtype.comp OK.subtype).codRestrict OF.toSubring (fun y => y.2)
         letI : Algebra ↥OK ↥OF := φ_hat.toAlgebra
         FiniteDimensional ↥K_sub F_hat ∧ Module.Finite ↥OK ↥OF ∧ RingHom.Etale φ_hat) →
        (let OF : ValuationSubring F_hat := (NormedField.valuation (K := F_hat)).valuationSubring
         let OK : ValuationSubring ↥K_sub := OF.comap K_sub.subtype
         letI : Algebra ↥K_sub F_hat := K_sub.toAlgebra
         ∃ z_hat : F_hat, ‖z_hat‖ = 1 ∧
           ∀ y₁ : F_hat, ‖y₁ - z_hat‖ < 1 →
             ‖y₁‖ = 1 ∧
             (minpoly ↥K_sub y₁).natDegree = Module.finrank ↥K_sub F_hat ∧
             (∀ i : ℕ, (minpoly ↥K_sub y₁).coeff i ∈ OK) ∧
             ‖((Polynomial.derivative (minpoly ↥K_sub y₁)).map K_sub.subtype).eval y₁‖ = 1 ∧
             (∀ z : F_hat, z ∈ OF → ∃ A₁ : Polynomial ↥OK,
               (A₁.map (K_sub.subtype.comp OK.subtype)).eval y₁ = z)) := by
    intro K_sub hNontriv_sub hGen_sub
    dsimp only
    let OF : ValuationSubring F_hat := (NormedField.valuation (K := F_hat)).valuationSubring
    let OK : ValuationSubring ↥K_sub := OF.comap K_sub.subtype
    let _ : Algebra ↥K_sub F_hat := K_sub.toAlgebra
    let φ_hat : ↥OK →+* ↥OF :=
      (K_sub.subtype.comp OK.subtype).codRestrict OF.toSubring (fun y => y.2)
    let _ : Algebra ↥OK ↥OF := φ_hat.toAlgebra
    obtain ⟨hFD, hModFin, hEt_hat⟩ := hGen_sub
    have hMem_OF : ∀ z : F_hat, z ∈ OF ↔ ‖z‖ ≤ 1 := by
      intro z
      rw [Valuation.mem_valuationSubring_iff, NormedField.valuation_apply, ← NNReal.coe_le_one,
        coe_nnnorm]
    have hMem_OK : ∀ u : ↥K_sub, u ∈ OK ↔ ‖(u : F_hat)‖ ≤ 1 := fun u => hMem_OF (u : F_hat)
    have hUnit_OF : ∀ x : ↥OF, IsUnit x ↔ ‖(x.1 : F_hat)‖ = 1 := by
      intro x
      constructor
      · rintro ⟨u, rfl⟩
        have hm : (u.val.1 : F_hat) * ((↑u⁻¹ : ↥OF).1 : F_hat) = 1 :=
          congrArg Subtype.val u.val_inv
        have h1 : ‖(u.val.1 : F_hat)‖ ≤ 1 := (hMem_OF _).mp u.val.2
        have h2 : ‖((↑u⁻¹ : ↥OF).1 : F_hat)‖ ≤ 1 := (hMem_OF _).mp (↑u⁻¹ : ↥OF).2
        have hprod : ‖(u.val.1 : F_hat)‖ * ‖((↑u⁻¹ : ↥OF).1 : F_hat)‖ = 1 := by
          rw [← norm_mul, hm, norm_one]
        by_contra hne
        have hlt : ‖(u.val.1 : F_hat)‖ < 1 := lt_of_le_of_ne h1 hne
        have hle_mul : ‖(u.val.1 : F_hat)‖ * ‖((↑u⁻¹ : ↥OF).1 : F_hat)‖ ≤
            ‖(u.val.1 : F_hat)‖ * 1 :=
          mul_le_mul_of_nonneg_left h2 (norm_nonneg _)
        linarith
      · intro hx1
        have hx_ne : (x.1 : F_hat) ≠ 0 := by
          intro h0
          rw [h0, norm_zero] at hx1
          norm_num at hx1
        have hx_inv : (x.1 : F_hat)⁻¹ ∈ OF := by
          rw [hMem_OF, norm_inv, hx1, inv_one]
        exact ⟨⟨x, ⟨(x.1 : F_hat)⁻¹, hx_inv⟩, Subtype.ext (mul_inv_cancel₀ hx_ne),
          Subtype.ext (inv_mul_cancel₀ hx_ne)⟩, rfl⟩
    have hMax_OF : ∀ x : ↥OF, x ∈ IsLocalRing.maximalIdeal ↥OF ↔ ‖(x.1 : F_hat)‖ < 1 := by
      intro x
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, hUnit_OF]
      exact ⟨fun hne => lt_of_le_of_ne ((hMem_OF _).mp x.2) hne, ne_of_lt⟩
    have hUnit_OK : ∀ u : ↥OK, IsUnit u ↔ ‖((u.1 : ↥K_sub) : F_hat)‖ = 1 := by
      intro u
      constructor
      · rintro ⟨v, rfl⟩
        have hm : ((v.val.1 : ↥K_sub) : F_hat) * (((↑v⁻¹ : ↥OK).1 : ↥K_sub) : F_hat) = 1 :=
          congrArg (fun z : ↥OK => ((z.1 : ↥K_sub) : F_hat)) v.val_inv
        have h1 : ‖((v.val.1 : ↥K_sub) : F_hat)‖ ≤ 1 := (hMem_OK _).mp v.val.2
        have h2 : ‖(((↑v⁻¹ : ↥OK).1 : ↥K_sub) : F_hat)‖ ≤ 1 := (hMem_OK _).mp (↑v⁻¹ : ↥OK).2
        have hprod : ‖((v.val.1 : ↥K_sub) : F_hat)‖ * ‖(((↑v⁻¹ : ↥OK).1 : ↥K_sub) : F_hat)‖ = 1 := by
          rw [← norm_mul, hm, norm_one]
        by_contra hne
        have hlt : ‖((v.val.1 : ↥K_sub) : F_hat)‖ < 1 := lt_of_le_of_ne h1 hne
        have hle_mul : ‖((v.val.1 : ↥K_sub) : F_hat)‖ * ‖(((↑v⁻¹ : ↥OK).1 : ↥K_sub) : F_hat)‖ ≤
            ‖((v.val.1 : ↥K_sub) : F_hat)‖ * 1 :=
          mul_le_mul_of_nonneg_left h2 (norm_nonneg _)
        linarith
      · intro hu1
        have hu_ne : (u.1 : ↥K_sub) ≠ 0 := by
          intro h0
          have : ((u.1 : ↥K_sub) : F_hat) = 0 := by simp [h0]
          rw [this, norm_zero] at hu1
          norm_num at hu1
        have hu_inv : (u.1 : ↥K_sub)⁻¹ ∈ OK := by
          rw [hMem_OK, Subfield.coe_inv, norm_inv, hu1, inv_one]
        exact ⟨⟨u, ⟨(u.1 : ↥K_sub)⁻¹, hu_inv⟩, Subtype.ext (mul_inv_cancel₀ hu_ne),
          Subtype.ext (inv_mul_cancel₀ hu_ne)⟩, rfl⟩
    have _ : IsLocalHom (algebraMap ↥OK ↥OF) :=
      ⟨fun u hu => (hUnit_OK u).mpr ((hUnit_OF (algebraMap ↥OK ↥OF u)).mp hu)⟩
    have _ : Algebra.Etale ↥OK ↥OF := RingHom.etale_algebraMap.mp hEt_hat
    obtain ⟨hSep_res, hMax_map⟩ :=
      (Algebra.FormallyUnramified.iff_map_maximalIdeal_eq (R := ↥OK) (S := ↥OF)).mp inferInstance
    let κ_K := IsLocalRing.ResidueField ↥OK
    let κ_F := IsLocalRing.ResidueField ↥OF
    have _ : Algebra.IsSeparable κ_K κ_F := hSep_res
    have _ : FiniteDimensional κ_K κ_F := by
      obtain ⟨s, hs⟩ := Module.Finite.fg_top (R := ↥OK) (M := ↥OF)
      refine ⟨⟨s.image (IsLocalRing.residue ↥OF), ?_⟩⟩
      rw [eq_top_iff]
      intro x_bar _
      obtain ⟨x, rfl⟩ := IsLocalRing.residue_surjective x_bar
      have hx : x ∈ Submodule.span ↥OK (s : Set ↥OF) := by rw [hs]; trivial
      refine Submodule.span_induction
        (fun a ha => Submodule.subset_span (Finset.mem_coe.mpr (Finset.mem_image_of_mem _ ha)))
        (by simp)
        (fun a b _ _ iha ihb => by rw [map_add]; exact Submodule.add_mem _ iha ihb)
        (fun u a _ iha => ?_) hx
      have hsmul : IsLocalRing.residue ↥OF (u • a) =
          (IsLocalRing.residue ↥OK u) • IsLocalRing.residue ↥OF a := by
        rw [Algebra.smul_def, map_mul, ← IsLocalRing.ResidueField.algebraMap_residue,
          Algebra.smul_def]
      rw [hsmul]
      exact Submodule.smul_mem _ _ iha
    let r : ℕ := Module.finrank κ_K κ_F
    obtain ⟨α_bar, hα_prim⟩ := Field.exists_primitive_element κ_K κ_F
    let z₁_bar : κ_F := if α_bar = 0 then 1 else α_bar
    have hz₁_ne : z₁_bar ≠ 0 := by
      dsimp [z₁_bar]
      split_ifs with h0
      · exact one_ne_zero
      · exact h0
    have hz₁_prim : IntermediateField.adjoin κ_K ({z₁_bar} : Set κ_F) = ⊤ := by
      dsimp [z₁_bar]
      split_ifs with h0
      · subst h0
        apply top_unique
        rw [← hα_prim, IntermediateField.adjoin_le_iff, Set.singleton_subset_iff]
        exact zero_mem _
      · exact hα_prim
    have hz₁_deg : (minpoly κ_K z₁_bar).natDegree = r := by
      have hfin := IntermediateField.adjoin.finrank (Algebra.IsIntegral.isIntegral (R := κ_K) z₁_bar)
      have htop : Module.finrank κ_K ↥(IntermediateField.adjoin κ_K ({z₁_bar} : Set κ_F)) = r := by
        rw [hz₁_prim]
        exact LinearEquiv.finrank_eq IntermediateField.topEquiv.toLinearEquiv
      omega
    obtain ⟨z₀_O, hz₀_res⟩ := IsLocalRing.residue_surjective z₁_bar
    let z_hat : F_hat := z₀_O.1
    have hz_norm : ‖z_hat‖ = 1 := by
      have hnot_max : z₀_O ∉ IsLocalRing.maximalIdeal ↥OF := by
        rw [← IsLocalRing.residue_eq_zero_iff, hz₀_res]
        exact hz₁_ne
      rw [hMax_OF, not_lt] at hnot_max
      exact le_antisymm ((hMem_OF z_hat).mp z₀_O.2) hnot_max
    refine ⟨z_hat, hz_norm, ?_⟩
    intro y₁ hy₁_dist
    have hy₁_norm : ‖y₁‖ = 1 := by
      have hle : ‖y₁‖ ≤ 1 := by
        have heq : y₁ = (y₁ - z_hat) + z_hat := by ring
        rw [heq]
        exact (IsUltrametricDist.norm_add_le_max _ _).trans
          (max_le (le_of_lt hy₁_dist) (le_of_eq hz_norm))
      have hge : 1 ≤ ‖y₁‖ := by
        by_contra! hlt
        have heq : z_hat = (z_hat - y₁) + y₁ := by ring
        have h1 : ‖z_hat‖ < 1 := by
          rw [heq]
          refine (IsUltrametricDist.norm_add_le_max _ _).trans_lt (max_lt ?_ hlt)
          rwa [norm_sub_rev]
        linarith
      exact le_antisymm hle hge
    let y₁_O : ↥OF := ⟨y₁, (hMem_OF y₁).mpr (le_of_eq hy₁_norm)⟩
    have hy₁_res : IsLocalRing.residue ↥OF y₁_O = z₁_bar := by
      have hdiff_max : y₁_O - z₀_O ∈ IsLocalRing.maximalIdeal ↥OF :=
        (hMax_OF (y₁_O - z₀_O)).mpr hy₁_dist
      have hsub0 : IsLocalRing.residue ↥OF (y₁_O - z₀_O) = 0 :=
        (IsLocalRing.residue_eq_zero_iff _).mpr hdiff_max
      rw [map_sub, sub_eq_zero] at hsub0
      exact hsub0.trans hz₀_res
    let m_sub : Submodule ↥OK ↥OF := (IsLocalRing.maximalIdeal ↥OK) • (⊤ : Submodule ↥OK ↥OF)
    let L_pow : (Fin r → ↥OK) →ₗ[↥OK] ↥OF :=
      Fintype.linearCombination ↥OK (fun i : Fin r => y₁_O ^ (i : ℕ))
    let N_r : Submodule ↥OK ↥OF := LinearMap.range L_pow
    have hMap_le_smul : ∀ x ∈ Ideal.map (algebraMap ↥OK ↥OF) (IsLocalRing.maximalIdeal ↥OK),
        x ∈ m_sub := by
      let J : Ideal ↥OF :=
        { carrier := {x : ↥OF | x ∈ m_sub}
          add_mem' := fun ha hb => m_sub.add_mem ha hb
          zero_mem' := m_sub.zero_mem
          smul_mem' := by
            intro s x hx
            change s * x ∈ m_sub
            refine Submodule.smul_induction_on hx (fun u hu t _ => ?_) (fun a b iha ihb => ?_)
            · have heq : s * (u • t) = u • (s * t) := by
                simp only [Algebra.smul_def]
                ring
              rw [heq]
              exact Submodule.smul_mem_smul hu trivial
            · rw [mul_add]
              exact m_sub.add_mem iha ihb }
      intro x hx
      have hle : Ideal.map (algebraMap ↥OK ↥OF) (IsLocalRing.maximalIdeal ↥OK) ≤ J := by
        rw [Ideal.map, Ideal.span_le]
        rintro _ ⟨u, hu, rfl⟩
        change algebraMap ↥OK ↥OF u ∈ m_sub
        have heq : algebraMap ↥OK ↥OF u = u • (1 : ↥OF) := by rw [Algebra.smul_def, mul_one]
        rw [heq]
        exact Submodule.smul_mem_smul hu trivial
      exact hle hx
    have hTop_le_sup : (⊤ : Submodule ↥OK ↥OF) ≤ N_r ⊔ m_sub := by
      intro w _
      let pb := IntermediateField.adjoin.powerBasis (Algebra.IsIntegral.isIntegral (R := κ_K) z₁_bar)
      let w_adj : ↥(IntermediateField.adjoin κ_K ({z₁_bar} : Set κ_F)) :=
        ⟨IsLocalRing.residue ↥OF w, by rw [hz₁_prim]; trivial⟩
      have hw_repr := pb.basis.sum_repr w_adj
      have hpb_dim : pb.dim = r := hz₁_deg
      let c_bar : Fin r → κ_K := fun i => pb.basis.repr w_adj (Fin.cast hpb_dim.symm i)
      let a : Fin r → ↥OK := fun i => Classical.choose (IsLocalRing.residue_surjective (c_bar i))
      have ha_res : ∀ i : Fin r, IsLocalRing.residue ↥OK (a i) = c_bar i :=
        fun i => Classical.choose_spec (IsLocalRing.residue_surjective (c_bar i))
      let v : ↥OF := L_pow a
      have hv_mem : v ∈ N_r := ⟨a, rfl⟩
      have hv_res : IsLocalRing.residue ↥OF v = IsLocalRing.residue ↥OF w := by
        change IsLocalRing.residue ↥OF (∑ i : Fin r, a i • y₁_O ^ (i : ℕ)) = IsLocalRing.residue ↥OF w
        rw [map_sum]
        have hterm : ∀ i : Fin r,
            IsLocalRing.residue ↥OF (a i • y₁_O ^ (i : ℕ)) = c_bar i • z₁_bar ^ (i : ℕ) := by
          intro i
          rw [Algebra.smul_def, map_mul, map_pow, hy₁_res,
            ← IsLocalRing.ResidueField.algebraMap_residue, ha_res, Algebra.smul_def]
        simp_rw [hterm]
        have hw_val : ∑ j : Fin pb.dim, (pb.basis.repr w_adj j) • z₁_bar ^ (j : ℕ) =
            IsLocalRing.residue ↥OF w := by
          have hval := congrArg Subtype.val hw_repr
          rw [AddSubmonoidClass.coe_finsetSum] at hval
          refine (Finset.sum_congr rfl fun j _ => ?_).trans hval
          have hgen : (pb.gen : κ_F) = z₁_bar := by
            rw [IntermediateField.adjoin.powerBasis_gen]
            rfl
          simp [PowerBasis.coe_basis, hgen]
        rw [← hw_val]
        refine Finset.sum_bij (fun (i : Fin r) _ => Fin.cast hpb_dim.symm i)
          (fun _ _ => Finset.mem_univ _)
          (fun i₁ _ i₂ _ h => by simpa using h)
          (fun j _ => ⟨Fin.cast hpb_dim j, Finset.mem_univ _, by simp⟩)
          (fun i _ => rfl)
      have hdiff_max : w - v ∈ IsLocalRing.maximalIdeal ↥OF := by
        rw [← IsLocalRing.residue_eq_zero_iff, map_sub, hv_res, sub_self]
      rw [← hMax_map] at hdiff_max
      have hdiff_smul : w - v ∈ m_sub := hMap_le_smul (w - v) hdiff_max
      have hw_eq : w = v + (w - v) := by abel
      rw [hw_eq]
      exact Submodule.add_mem_sup hv_mem hdiff_smul
    have hJac : IsLocalRing.maximalIdeal ↥OK ≤ (⊥ : Ideal ↥OK).jacobson :=
      le_of_eq (IsLocalRing.jacobson_eq_maximalIdeal (⊥ : Ideal ↥OK) bot_ne_top).symm
    have hNr_top : (⊤ : Submodule ↥OK ↥OF) ≤ N_r :=
      Submodule.le_of_le_smul_of_le_jacobson_bot (Module.Finite.fg_top (R := ↥OK) (M := ↥OF))
        hJac hTop_le_sup
    have hSpan_OF : ∀ z_O : ↥OF, ∃ c : Fin r → ↥OK, ∑ i : Fin r, c i • y₁_O ^ (i : ℕ) = z_O :=
      fun z_O => hNr_top trivial
    have hPoly_OF : ∀ z : F_hat, z ∈ OF → ∃ A₁ : Polynomial ↥OK,
        (A₁.map (K_sub.subtype.comp OK.subtype)).eval y₁ = z := by
      intro z hz
      obtain ⟨c, hc⟩ := hSpan_OF ⟨z, hz⟩
      refine ⟨∑ i : Fin r, Polynomial.C (c i) * Polynomial.X ^ (i : ℕ), ?_⟩
      rw [Polynomial.map_sum, Polynomial.eval_finsetSum]
      have hval : (∑ i : Fin r, c i • y₁_O ^ (i : ℕ) : ↥OF).1 = z := congrArg Subtype.val hc
      rw [AddSubmonoidClass.coe_finsetSum] at hval
      refine (Finset.sum_congr rfl fun i _ => ?_).trans hval
      simp only [Polynomial.map_mul, Polynomial.map_C, Polynomial.map_pow, Polynomial.map_X,
        Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_pow, Polynomial.eval_X,
        Algebra.smul_def]
      rfl
    obtain ⟨c_m, hc_m⟩ := hSpan_OF (y₁_O ^ r)
    let S_low : Polynomial ↥OK := ∑ i : Fin r, Polynomial.C (c_m i) * Polynomial.X ^ (i : ℕ)
    have hS_deg : S_low.degree < (r : WithBot ℕ) := by
      rw [Polynomial.degree_lt_iff_coeff_zero]
      intro m hm
      rw [Polynomial.finsetSum_coeff]
      refine Finset.sum_eq_zero fun i _ => ?_
      rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow]
      split_ifs with hmi
      · exfalso
        exact Nat.not_lt_of_ge hm (hmi ▸ i.isLt)
      · exact mul_zero _
    let M₁ : Polynomial ↥OK := Polynomial.X ^ r - S_low
    have hM₁_monic : M₁.Monic := Polynomial.monic_X_pow_sub hS_deg
    have hM₁_deg : M₁.natDegree = r :=
      Polynomial.natDegree_eq_of_degree_eq_some
        ((Polynomial.degree_sub_eq_left_of_degree_lt
          (by rw [Polynomial.degree_X_pow]; exact hS_deg)).trans (Polynomial.degree_X_pow r))
    have hM₁_eval_O : (M₁.map φ_hat).eval y₁_O = 0 := by
      simp only [M₁, S_low, Polynomial.map_sub, Polynomial.map_pow, Polynomial.map_X,
        Polynomial.map_sum, Polynomial.map_mul, Polynomial.map_C, Polynomial.eval_sub,
        Polynomial.eval_pow, Polynomial.eval_X, Polynomial.eval_finsetSum, Polynomial.eval_mul,
        Polynomial.eval_C]
      rw [sub_eq_zero]
      exact hc_m.symm
    have hEval_OF : ∀ P : Polynomial ↥OK,
        OF.subtype ((P.map φ_hat).eval y₁_O) = Polynomial.aeval y₁ (P.map OK.subtype) := by
      intro P
      have hcomp_OF : OF.subtype.comp φ_hat = K_sub.subtype.comp OK.subtype := by ext; rfl
      rw [Polynomial.eval_map, Polynomial.hom_eval₂, hcomp_OF, Polynomial.aeval_def,
        Polynomial.eval₂_map]
      rfl
    let M₁_K : Polynomial ↥K_sub := M₁.map OK.subtype
    have hM₁_K_monic : M₁_K.Monic := hM₁_monic.map OK.subtype
    have hM₁_K_deg : M₁_K.natDegree = r := (hM₁_monic.natDegree_map OK.subtype).trans hM₁_deg
    have hM₁_K_eval : Polynomial.aeval y₁ M₁_K = 0 := by
      rw [← hEval_OF M₁, hM₁_eval_O, map_zero]
    have hy₁_int : IsIntegral ↥K_sub y₁ := ⟨M₁_K, hM₁_K_monic, hM₁_K_eval⟩
    let f₁ : Polynomial ↥K_sub := minpoly ↥K_sub y₁
    have hf₁_monic : f₁.Monic := minpoly.monic hy₁_int
    have hf₁_dvd : f₁ ∣ M₁_K := minpoly.dvd ↥K_sub y₁ hM₁_K_eval
    have hf₁_le_r : f₁.natDegree ≤ r :=
      hM₁_K_deg ▸ Polynomial.natDegree_le_of_dvd hf₁_dvd hM₁_K_monic.ne_zero
    have hr_le_f₁ : r ≤ f₁.natDegree := by
      have hf₁_supp : f₁.support.Nonempty := Polynomial.support_nonempty.mpr hf₁_monic.ne_zero
      obtain ⟨j_star, hj_supp, hj_max⟩ :=
        Finset.exists_max_image f₁.support (fun j => ‖((f₁.coeff j : ↥K_sub) : F_hat)‖) hf₁_supp
      let b_star : ↥K_sub := f₁.coeff j_star
      have hb_ne : b_star ≠ 0 := Polynomial.mem_support_iff.mp hj_supp
      have hb_norm_pos : 0 < ‖(b_star : F_hat)‖ := norm_pos_iff.mpr (by simpa using hb_ne)
      let q_K : Polynomial ↥K_sub := Polynomial.C b_star⁻¹ * f₁
      have hq_deg : q_K.natDegree = f₁.natDegree := Polynomial.natDegree_C_mul (inv_ne_zero hb_ne)
      have hq_mem : ∀ j : ℕ, q_K.coeff j ∈ OK := by
        intro j
        rw [hMem_OK, Polynomial.coeff_C_mul, Subfield.coe_mul, Subfield.coe_inv, norm_mul, norm_inv]
        by_cases hj : j ∈ f₁.support
        · exact (mul_le_mul_of_nonneg_left (hj_max j hj) (inv_nonneg.mpr (norm_nonneg _))).trans
            (le_of_eq (inv_mul_cancel₀ (ne_of_gt hb_norm_pos)))
        · rw [Polynomial.notMem_support_iff.mp hj, Subfield.coe_zero, norm_zero, mul_zero]
          exact zero_le_one
      let q_O : Polynomial ↥OK := liftPolySubring OK.toSubring q_K hq_mem
      have hq_map : q_O.map OK.subtype = q_K := liftPolySubring_map OK.toSubring q_K hq_mem
      have hq_O_deg : q_O.natDegree = f₁.natDegree := by
        rw [← natDegree_eq_of_map_injective (φ := OK.subtype) Subtype.val_injective q_O,
          hq_map, hq_deg]
      have hq_O_jstar : q_O.coeff j_star = 1 := by
        apply Subtype.ext
        have hc : (q_O.map OK.subtype).coeff j_star = q_K.coeff j_star :=
          congrArg (fun p => p.coeff j_star) hq_map
        rw [Polynomial.coeff_map, Polynomial.coeff_C_mul, inv_mul_cancel₀ hb_ne] at hc
        exact hc
      have hq_O_eval : (q_O.map φ_hat).eval y₁_O = 0 := by
        apply Subtype.ext
        change OF.subtype ((q_O.map φ_hat).eval y₁_O) = 0
        rw [hEval_OF q_O, hq_map]
        dsimp [q_K]
        rw [map_mul, minpoly.aeval ↥K_sub y₁, mul_zero]
      let q_bar : Polynomial κ_K := q_O.map (IsLocalRing.residue ↥OK)
      have hq_bar_ne : q_bar ≠ 0 := by
        intro h0
        have hc : q_bar.coeff j_star = 0 := by rw [h0]; simp
        rw [Polynomial.coeff_map, hq_O_jstar, map_one] at hc
        exact one_ne_zero hc
      have hq_bar_eval : Polynomial.aeval z₁_bar q_bar = 0 := by
        rw [Polynomial.aeval_def, Polynomial.eval₂_map]
        have hcomp : (algebraMap κ_K κ_F).comp (IsLocalRing.residue ↥OK) =
            (IsLocalRing.residue ↥OF).comp φ_hat := by
          ext u
          exact IsLocalRing.ResidueField.algebraMap_residue u
        rw [hcomp, ← hy₁_res, ← Polynomial.hom_eval₂, ← Polynomial.eval_map, hq_O_eval, map_zero]
      have hmin_dvd : minpoly κ_K z₁_bar ∣ q_bar := minpoly.dvd κ_K z₁_bar hq_bar_eval
      calc r = (minpoly κ_K z₁_bar).natDegree := hz₁_deg.symm
        _ ≤ q_bar.natDegree := Polynomial.natDegree_le_of_dvd hmin_dvd hq_bar_ne
        _ ≤ q_O.natDegree := Polynomial.natDegree_map_le
        _ = f₁.natDegree := hq_O_deg
    have hf₁_deg_r : f₁.natDegree = r := le_antisymm hf₁_le_r hr_le_f₁
    have hf₁_eq_M₁ : f₁ = M₁_K := by
      obtain ⟨u_fac, hu_fac⟩ := hf₁_dvd
      have hu_ne : u_fac ≠ 0 := right_ne_zero_of_mul (hu_fac ▸ hM₁_K_monic.ne_zero)
      have hu_monic : u_fac.Monic := by
        rw [Polynomial.Monic]
        have hlead : M₁_K.leadingCoeff = f₁.leadingCoeff * u_fac.leadingCoeff := by
          rw [hu_fac, Polynomial.leadingCoeff_mul]
        rw [hM₁_K_monic.leadingCoeff, hf₁_monic.leadingCoeff, one_mul] at hlead
        exact hlead.symm
      have hu_deg : u_fac.natDegree = 0 := by
        have hdeg := Polynomial.natDegree_mul hf₁_monic.ne_zero hu_ne
        rw [← hu_fac, hM₁_K_deg, hf₁_deg_r] at hdeg
        omega
      have hu_one : u_fac = 1 := Polynomial.eq_one_of_monic_natDegree_zero hu_monic hu_deg
      rw [hu_fac, hu_one, mul_one]
    have hf₁_int : ∀ i : ℕ, f₁.coeff i ∈ OK := by
      intro i
      rw [hf₁_eq_M₁, Polynomial.coeff_map]
      exact (M₁.coeff i).2
    have hadj_top : IntermediateField.adjoin ↥K_sub ({y₁} : Set F_hat) = ⊤ := by
      obtain ⟨π, hπ_pos, hπ_lt⟩ := hNontriv_sub
      have hπ_ne : π ≠ 0 := by
        intro h0
        rw [h0, Subfield.coe_zero, norm_zero] at hπ_pos
        linarith
      apply top_unique
      intro v _
      have hTend : Filter.Tendsto (fun n : ℕ => ‖(π : F_hat)‖ ^ n * ‖v‖) Filter.atTop (nhds 0) := by
        simpa [zero_mul] using
          (tendsto_pow_atTop_nhds_zero_of_lt_one (norm_nonneg _) hπ_lt).mul_const ‖v‖
      obtain ⟨n, hn⟩ := (hTend.eventually (gt_mem_nhds zero_lt_one)).exists
