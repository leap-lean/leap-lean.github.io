        intro t
        by_cases hut0 : u t = 0
        · refine ⟨0, 1, by simp, one_ne_zero, by simp [hut0], fun h => absurd hut0 h⟩
        · have hutF : (u t : F) ≠ 0 := fun h0 => hut0 (Subtype.ext h0)
          obtain ⟨A, B, hdiv_eq⟩ := (IntermediateField.mem_adjoin_simple_iff K (u t : F)).mp (u t).2
