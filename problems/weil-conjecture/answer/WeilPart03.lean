        change V.subtype y ∈ (⊥ : Ideal K) ↔ y = 0
        rw [Ideal.mem_bot, map_eq_zero_iff V.subtype Subtype.val_injective]
      have hle : p₀_ps ≤ q_ps := by
        change p₀_ps.asIdeal ≤ q_ps.asIdeal
        rw [hbot]
        exact bot_le
      have hspec_ps : @Specializes (PrimeSpectrum ↥V) PrimeSpectrum.zariskiTopology p₀_ps q_ps :=
