              dsimp [x]
              rw [map_inv₀]
              have hsub : T₁ - algebraMap K_hat L₁ α =
                  -(algebraMap K_hat L₁ α * (1 - (algebraMap K_hat L₁ α)⁻¹ * T₁)) := by
                rw [mul_sub, mul_one, ← mul_assoc, mul_inv_cancel₀ hα_map_ne, one_mul]; ring
              rw [hsub, inv_neg, mul_inv_rev, mul_comm]
            rw [heq]
            exact C_B.neg_mem (C_B.mul_mem (hK_CB α⁻¹) h1x_CB)
        let KT_sub : Subfield E_hat := (IntermediateField.adjoin K_hat ({T} : Set E_hat)).toSubfield
        let L_T : Subfield E_hat := KT_sub.topologicalClosure
        have hpoly_T_mem_L : ∀ R_p : Polynomial K_hat, Polynomial.aeval T R_p ∈ L := by
          intro R_p
          induction R_p using Polynomial.induction_on' with
          | add R₁ R₂ h₁ h₂ => rw [map_add]; exact L.add_mem h₁ h₂
          | monomial n c =>
