            by_cases hg0 : ν g₁ = 0
            · omega
            · have h2 : 2 * ν g₁ ≤ k :=
                (Nat.mul_le_mul_right (ν g₁) hp.two_le).trans h_pg₁
              omega
          have hg₁_W : g₁ ∈ W := ih (ν g₁) hg₁_lt g₁ rfl
          rw [hf_decomp]
          exact W.add_mem (hU_sub_W hu₀_U) (hW_frob g₁ hg₁_W)
    refine ⟨U, hLI_U, hDisj_U, ?_⟩
    rw [eq_top_iff]
    exact fun f _ => h_span_ind (ν f) f rfl

theorem weil_equichar_coeffField_and_type2_unramified_setup (K_hat F_hat : Type u)
    [NontriviallyNormedField K_hat] [CompleteSpace K_hat]
    [IsUltrametricDist K_hat] [IsAlgClosed K_hat]
    [NontriviallyNormedField F_hat] [CompleteSpace F_hat]
    [IsUltrametricDist F_hat] [Algebra K_hat F_hat]
    (hEquiChar : ∀ p : ℕ, p.Prime → (p : K_hat) = 0 ∨ ‖(p : K_hat)‖ = 1)
    (hIsoK : ∀ c : K_hat, ‖algebraMap K_hat F_hat c‖ = ‖c‖) :
    let OF : ValuationSubring F_hat := (NormedField.valuation (K := F_hat)).valuationSubring
    let OK : ValuationSubring K_hat := OF.comap (algebraMap K_hat F_hat)
    let κF := IsLocalRing.ResidueField ↥OF
    let κ_hom : ↥OK →+* κF :=
      (IsLocalRing.residue ↥OF).comp
        (((algebraMap K_hat F_hat).comp OK.subtype).codRestrict OF.toSubring (fun c => c.2))
    let K_res : Subfield κF := Subfield.closure (Set.range κ_hom)
    letI : Algebra ↥K_res κF := K_res.toAlgebra
    ∃ E_max : Subfield K_hat,
      (∀ c ∈ E_max, ‖c‖ ≤ 1) ∧
      IsAlgClosed ↥E_max ∧
      (∀ c : K_hat, ‖c‖ ≤ 1 → ∃ e ∈ E_max, ‖c - e‖ < 1) ∧
      IsAlgClosed ↥K_res ∧
      (K_res : Set κF) = Set.range κ_hom ∧
      ∀ (x : F_hat) (hx : x ∈ OF),
        let x_res : κF := IsLocalRing.residue ↥OF ⟨x, hx⟩
        let Kx_res : Subfield κF := Subfield.closure (Set.range κ_hom ∪ {x_res})
        letI : Algebra ↥Kx_res κF := Kx_res.toAlgebra
        let Lx : Subfield F_hat :=
          (IntermediateField.adjoin K_hat ({x} : Set F_hat)).toSubfield.topologicalClosure
        letI : Algebra ↥Lx F_hat := Lx.toAlgebra
        Transcendental ↥K_res x_res →
        FiniteDimensional ↥Lx F_hat →
        FiniteDimensional ↥Kx_res κF ∧
        (Algebra.IsSeparable ↥Kx_res κF →
          ∃ K_unr : Subfield F_hat,
            IsWeilType23ModRamified K_hat F_hat E_max K_unr ∧
            (letI : Algebra ↥K_unr F_hat := K_unr.toAlgebra
             FiniteDimensional ↥K_unr F_hat) ∧
            (∀ w : F_hat, w ≠ 0 → ∃ u ∈ K_unr, ‖w‖ = ‖u‖) ∧
            (∀ w : F_hat, ‖w‖ ≤ 1 → ∃ u ∈ K_unr, ‖u‖ ≤ 1 ∧ ‖w - u‖ < 1) ∧
            (K_unr = ⊤ → IsWeilAnalyticUnramifiedGen K_hat F_hat x)) :=
by
  
  have hs3_hensel : ∀ (f : Polynomial F_hat),
      (∀ k : ℕ, ‖f.coeff k‖ ≤ 1) →
      ∀ (y₀ : F_hat),
        ‖y₀‖ ≤ 1 →
        ‖Polynomial.eval y₀ f‖ < 1 →
        ‖Polynomial.eval y₀ (Polynomial.derivative f)‖ = 1 →
        ∃ θ : F_hat,
          ‖θ‖ ≤ 1 ∧
          ‖θ - y₀‖ < 1 ∧
          Polynomial.eval θ f = 0 ∧
          ‖Polynomial.eval θ (Polynomial.derivative f)‖ = 1 := by
    clear hEquiChar hIsoK
    intro f hf_coeff y₀ hy₀ hf_y₀ hdf_y₀
    have hNatNorm : ∀ n : ℕ, ‖(n : F_hat)‖ ≤ 1 := by
      intro n
      induction n with
      | zero => simp
      | succ n ih =>
        rw [Nat.cast_succ]
        exact (IsUltrametricDist.norm_add_le_max (n : F_hat) 1).trans (max_le ih (by simp))
    have hSumNormLe : ∀ (s : Finset ℕ) (g : ℕ → F_hat) (C : ℝ),
        0 ≤ C → (∀ i ∈ s, ‖g i‖ ≤ C) → ‖∑ i ∈ s, g i‖ ≤ C := by
      intro s g C hC hg
      let C_nn : NNReal := ⟨C, hC⟩
      have hg_nn : ∀ i ∈ s, ‖g i‖₊ ≤ C_nn := fun i hi => hg i hi
      exact IsUltrametricDist.nnnorm_sum_le_of_forall_le hg_nn
    have hMonTaylor : ∀ (u h : F_hat), ‖u‖ ≤ 1 → ‖h‖ ≤ 1 → ∀ k : ℕ,
        ‖(u + h) ^ k - u ^ k - (k : F_hat) * u ^ (k - 1) * h‖ ≤ ‖h‖ ^ 2 := by
      intro u h hu hh k
      induction k with
      | zero => simp
      | succ m ih =>
        cases m with
        | zero => simp
        | succ n =>
          simp only [Nat.add_sub_cancel] at ih ⊢
          have h_id : (u + h) ^ (n + 1 + 1) - u ^ (n + 1 + 1) -
              ((n + 1 + 1 : ℕ) : F_hat) * u ^ (n + 1) * h =
              ((u + h) ^ (n + 1) - u ^ (n + 1) - ((n + 1 : ℕ) : F_hat) * u ^ n * h) * (u + h) +
                ((n + 1 : ℕ) : F_hat) * u ^ n * h ^ 2 := by
            push_cast
            ring
          rw [h_id]
          have huh : ‖u + h‖ ≤ 1 :=
            (IsUltrametricDist.norm_add_le_max u h).trans (max_le hu hh)
          have ht1 : ‖((u + h) ^ (n + 1) - u ^ (n + 1) - ((n + 1 : ℕ) : F_hat) * u ^ n * h) * (u + h)‖ ≤ ‖h‖ ^ 2 := by
            rw [norm_mul]
            exact (mul_le_mul ih huh (norm_nonneg _) (sq_nonneg _)).trans (by linarith)
          have ht2 : ‖((n + 1 : ℕ) : F_hat) * u ^ n * h ^ 2‖ ≤ ‖h‖ ^ 2 := by
            rw [norm_mul, norm_mul, norm_pow, norm_pow]
            have h1 : ‖((n + 1 : ℕ) : F_hat)‖ * ‖u‖ ^ n ≤ 1 := by
              have hun : ‖u‖ ^ n ≤ 1 := pow_le_one₀ (norm_nonneg u) hu
              exact (mul_le_mul (hNatNorm (n + 1)) hun (pow_nonneg (norm_nonneg u) n) zero_le_one).trans (by linarith)
            exact (mul_le_mul_of_nonneg_right h1 (sq_nonneg ‖h‖)).trans (by linarith)
          exact (IsUltrametricDist.norm_add_le_max _ _).trans (max_le ht1 ht2)
    have hPolyTaylor : ∀ (u h : F_hat), ‖u‖ ≤ 1 → ‖h‖ ≤ 1 →
        ‖Polynomial.eval (u + h) f - Polynomial.eval u f -
          Polynomial.eval u (Polynomial.derivative f) * h‖ ≤ ‖h‖ ^ 2 := by
      intro u h hu hh
      have hev1 : Polynomial.eval (u + h) f = ∑ k ∈ f.support, f.coeff k * (u + h) ^ k := by
        rw [f.eval_eq_sum, Polynomial.sum_def]
      have hev2 : Polynomial.eval u f = ∑ k ∈ f.support, f.coeff k * u ^ k := by
        rw [f.eval_eq_sum, Polynomial.sum_def]
      have hev3 : Polynomial.eval u (Polynomial.derivative f) * h =
          ∑ k ∈ f.support, f.coeff k * ((k : F_hat) * u ^ (k - 1) * h) := by
        rw [Polynomial.derivative_apply, Polynomial.eval_sum, Polynomial.sum_def, Finset.sum_mul]
        refine Finset.sum_congr rfl fun k _ => ?_
        simp only [Polynomial.eval_mul_X_pow, Polynomial.eval_C]
        ring
      rw [hev1, hev2, hev3, ← Finset.sum_sub_distrib, ← Finset.sum_sub_distrib]
      refine hSumNormLe f.support _ (‖h‖ ^ 2) (sq_nonneg _) fun k _ => ?_
      have h_eq : f.coeff k * (u + h) ^ k - f.coeff k * u ^ k -
          f.coeff k * ((k : F_hat) * u ^ (k - 1) * h) =
          f.coeff k * ((u + h) ^ k - u ^ k - (k : F_hat) * u ^ (k - 1) * h) := by ring
      rw [h_eq, norm_mul]
      exact (mul_le_mul (hf_coeff k) (hMonTaylor u h hu hh k) (norm_nonneg _) zero_le_one).trans (by linarith)
    have hMonLip : ∀ (a b : F_hat), ‖a‖ ≤ 1 → ‖b‖ ≤ 1 → ∀ k : ℕ,
        ‖a ^ k - b ^ k‖ ≤ ‖a - b‖ := by
      intro a b ha hb k
      induction k with
      | zero => simp
      | succ k ih =>
        have h_id : a ^ (k + 1) - b ^ (k + 1) = (a ^ k - b ^ k) * a + b ^ k * (a - b) := by ring
        rw [h_id]
        have ht1 : ‖(a ^ k - b ^ k) * a‖ ≤ ‖a - b‖ := by
          rw [norm_mul]
          exact (mul_le_mul ih ha (norm_nonneg _) (norm_nonneg _)).trans (by linarith)
        have ht2 : ‖b ^ k * (a - b)‖ ≤ ‖a - b‖ := by
          rw [norm_mul, norm_pow]
          exact (mul_le_mul_of_nonneg_right (pow_le_one₀ (norm_nonneg b) hb) (norm_nonneg _)).trans (by linarith)
        exact (IsUltrametricDist.norm_add_le_max _ _).trans (max_le ht1 ht2)
    let f' := Polynomial.derivative f
    have hf'_coeff : ∀ k : ℕ, ‖f'.coeff k‖ ≤ 1 := by
      intro k
      rw [Polynomial.coeff_derivative, ← Nat.cast_succ, norm_mul]
      exact (mul_le_mul (hf_coeff (k + 1)) (hNatNorm (k + 1)) (norm_nonneg _) zero_le_one).trans (by linarith)
    have hDerivLip : ∀ (a b : F_hat), ‖a‖ ≤ 1 → ‖b‖ ≤ 1 →
        ‖Polynomial.eval a f' - Polynomial.eval b f'‖ ≤ ‖a - b‖ := by
      intro a b ha hb
      rw [f'.eval_eq_sum, f'.eval_eq_sum, Polynomial.sum_def, Polynomial.sum_def, ← Finset.sum_sub_distrib]
      refine hSumNormLe f'.support _ ‖a - b‖ (norm_nonneg _) fun k _ => ?_
      rw [← mul_sub, norm_mul]
      exact (mul_le_mul (hf'_coeff k) (hMonLip a b ha hb k) (norm_nonneg _) zero_le_one).trans (by linarith)
    set r₀ : ℝ := ‖Polynomial.eval y₀ f‖
    have hr₀_nonneg : 0 ≤ r₀ := norm_nonneg _
    have hr₀_lt : r₀ < 1 := hf_y₀
    set D₀ : F_hat := Polynomial.eval y₀ f'
    have hD₀_norm : ‖D₀‖ = 1 := hdf_y₀
    have hD₀_ne : D₀ ≠ 0 := by
      intro h0
      rw [h0, norm_zero] at hD₀_norm
      norm_num at hD₀_norm
    have hD₀_inv_norm : ‖D₀⁻¹‖ = 1 := by rw [norm_inv, hD₀_norm, inv_one]
    let y : ℕ → F_hat := fun n => Nat.recOn n y₀ (fun _ yn => yn - D₀⁻¹ * Polynomial.eval yn f)
    have hy_step : ∀ n : ℕ, y (n + 1) = y n - D₀⁻¹ * Polynomial.eval (y n) f := fun _ => rfl
    have hInd : ∀ n : ℕ, ‖y n‖ ≤ 1 ∧ ‖y n - y₀‖ ≤ r₀ ∧ ‖Polynomial.eval (y n) f‖ ≤ r₀ ^ (n + 1) := by
      intro n
      induction n with
      | zero =>
        refine ⟨hy₀, ?_, ?_⟩
        · simpa [y] using hr₀_nonneg
        · simp [y, r₀]
      | succ n ih =>
        obtain ⟨hyn_le, hyn_dist, hfn⟩ := ih
        set h_n : F_hat := - (D₀⁻¹ * Polynomial.eval (y n) f)
        have hyn1 : y (n + 1) = y n + h_n := by
          rw [hy_step, sub_eq_add_neg]
        have hhn_norm : ‖h_n‖ ≤ r₀ ^ (n + 1) := by
          rw [norm_neg, norm_mul, hD₀_inv_norm, one_mul]
          exact hfn
        have hr_pow_le : r₀ ^ (n + 1) ≤ r₀ := by
          simpa using pow_le_pow_of_le_one hr₀_nonneg hr₀_lt.le (Nat.succ_pos n)
        have hhn_le_r₀ : ‖h_n‖ ≤ r₀ := hhn_norm.trans hr_pow_le
        have hhn_le_one : ‖h_n‖ ≤ 1 := hhn_le_r₀.trans hr₀_lt.le
        have hy_next_le : ‖y (n + 1)‖ ≤ 1 := by
          rw [hyn1]
          exact (IsUltrametricDist.norm_add_le_max _ _).trans (max_le hyn_le hhn_le_one)
        have hy_next_dist : ‖y (n + 1) - y₀‖ ≤ r₀ := by
          have h_eq : y (n + 1) - y₀ = (y n - y₀) + h_n := by rw [hyn1]; ring
          rw [h_eq]
          exact (IsUltrametricDist.norm_add_le_max _ _).trans (max_le hyn_dist hhn_le_r₀)
        have h_cancel : Polynomial.eval (y n) f + D₀ * h_n = 0 := by
          dsimp [h_n]
          rw [mul_neg, ← mul_assoc, mul_inv_cancel₀ hD₀_ne, one_mul, add_neg_cancel]
        have h_decomp : Polynomial.eval (y (n + 1)) f =
            (Polynomial.eval (y n + h_n) f - Polynomial.eval (y n) f - Polynomial.eval (y n) f' * h_n) +
              (Polynomial.eval (y n) f' - D₀) * h_n := by
          rw [hyn1]
          linear_combination h_cancel
        have hp1 : ‖Polynomial.eval (y n + h_n) f - Polynomial.eval (y n) f - Polynomial.eval (y n) f' * h_n‖ ≤
            r₀ ^ (n + 2) := by
          have h1 := hPolyTaylor (y n) h_n hyn_le hhn_le_one
          have h2 : ‖h_n‖ ^ 2 ≤ (r₀ ^ (n + 1)) ^ 2 :=
            pow_le_pow_left₀ (norm_nonneg _) hhn_norm 2
          have h3 : (r₀ ^ (n + 1)) ^ 2 ≤ r₀ ^ (n + 2) := by
            rw [← pow_mul]
            exact pow_le_pow_of_le_one hr₀_nonneg hr₀_lt.le (by omega)
          exact h1.trans (h2.trans h3)
        have hp2 : ‖(Polynomial.eval (y n) f' - D₀) * h_n‖ ≤ r₀ ^ (n + 2) := by
          rw [norm_mul]
          have hd : ‖Polynomial.eval (y n) f' - D₀‖ ≤ r₀ :=
            (hDerivLip (y n) y₀ hyn_le hy₀).trans hyn_dist
          have hm := mul_le_mul hd hhn_norm (norm_nonneg _) hr₀_nonneg
          simpa [pow_succ'] using hm
        refine ⟨hy_next_le, hy_next_dist, ?_⟩
        rw [h_decomp]
        exact (IsUltrametricDist.norm_add_le_max _ _).trans (max_le hp1 hp2)
    have hCauchy : CauchySeq y := by
      refine cauchySeq_of_le_geometric r₀ r₀ hr₀_lt fun n => ?_
      rw [dist_eq_norm, hy_step]
      have h_eq : y n - (y n - D₀⁻¹ * Polynomial.eval (y n) f) = D₀⁻¹ * Polynomial.eval (y n) f := by ring
      rw [h_eq, norm_mul, hD₀_inv_norm, one_mul]
      simpa [pow_succ'] using (hInd n).2.2
    obtain ⟨θ, hθ_lim⟩ := cauchySeq_tendsto_of_complete hCauchy
    have hθ_le : ‖θ‖ ≤ 1 :=
      isClosed_le continuous_norm continuous_const |>.mem_of_tendsto hθ_lim
        (Filter.Eventually.of_forall fun n => (hInd n).1)
    have hθ_dist_le : ‖θ - y₀‖ ≤ r₀ :=
      isClosed_le (continuous_norm.comp (continuous_id.sub continuous_const)) continuous_const
        |>.mem_of_tendsto hθ_lim (Filter.Eventually.of_forall fun n => (hInd n).2.1)
    have hθ_root : Polynomial.eval θ f = 0 := by
      have h_cont : Filter.Tendsto (fun n => ‖Polynomial.eval (y n) f‖) Filter.atTop
          (nhds ‖Polynomial.eval θ f‖) :=
        (continuous_norm.comp f.continuous).continuousAt.tendsto.comp hθ_lim
      have h_zero : Filter.Tendsto (fun n => ‖Polynomial.eval (y n) f‖) Filter.atTop (nhds 0) :=
        squeeze_zero (fun _ => norm_nonneg _) (fun n => (hInd n).2.2)
          ((tendsto_pow_atTop_nhds_zero_of_lt_one hr₀_nonneg hr₀_lt).comp
            (Filter.tendsto_add_atTop_nat 1))
      exact norm_eq_zero.mp (tendsto_nhds_unique h_cont h_zero)
    have hθ_deriv : ‖Polynomial.eval θ f'‖ = 1 := by
      have hdiff : ‖Polynomial.eval θ f' - D₀‖ < 1 :=
        ((hDerivLip θ y₀ hθ_le hy₀).trans hθ_dist_le).trans_lt hr₀_lt
      have hle : ‖Polynomial.eval θ f'‖ ≤ 1 := by
        have h_eq : Polynomial.eval θ f' = (Polynomial.eval θ f' - D₀) + D₀ := by ring
        rw [h_eq]
        exact (IsUltrametricDist.norm_add_le_max _ _).trans (max_le hdiff.le hD₀_norm.le)
      have hge : 1 ≤ ‖Polynomial.eval θ f'‖ := by
        by_contra hlt
        push Not at hlt
        have h_eq : D₀ = (D₀ - Polynomial.eval θ f') + Polynomial.eval θ f' := by ring
        have h1 : ‖D₀‖ < 1 := by
          rw [h_eq]
          exact (IsUltrametricDist.norm_add_le_max _ _).trans_lt
            (max_lt (by simpa [norm_sub_rev] using hdiff) hlt)
        linarith [hD₀_norm]
      exact le_antisymm hle hge
    exact ⟨θ, hθ_le, hθ_dist_le.trans_lt hr₀_lt, hθ_root, hθ_deriv⟩
  
  have hs5_etale : ∀ (x : F_hat),
      let Lx : Subfield F_hat :=
        (IntermediateField.adjoin K_hat ({x} : Set F_hat)).toSubfield.topologicalClosure
      let OF : ValuationSubring F_hat := (NormedField.valuation (K := F_hat)).valuationSubring
      let OLx : ValuationSubring ↥Lx := OF.comap Lx.subtype
      letI : Algebra ↥Lx F_hat := Lx.toAlgebra
      let φ : ↥OLx →+* ↥OF :=
        (Lx.subtype.comp OLx.subtype).codRestrict OF.toSubring (fun y => y.2)
      letI : Algebra ↥OLx ↥OF := φ.toAlgebra
      FiniteDimensional ↥Lx F_hat →
      ∀ (f_int : Polynomial ↥OLx) (θ : F_hat) (hθ : θ ∈ OF),
        f_int.Monic →
        0 < f_int.natDegree →
        Polynomial.aeval (⟨θ, hθ⟩ : ↥OF) f_int = 0 →
        ‖((Polynomial.aeval (⟨θ, hθ⟩ : ↥OF) (Polynomial.derivative f_int) : ↥OF) : F_hat)‖ = 1 →
        (∀ (a : Fin f_int.natDegree → ↥Lx) (j : Fin f_int.natDegree),
          ‖(a j : F_hat)‖ ≤ ‖∑ i : Fin f_int.natDegree, (a i : F_hat) * θ ^ (i : ℕ)‖) →
        (∀ w : F_hat, ∃ a : Fin f_int.natDegree → ↥Lx,
          w = ∑ i : Fin f_int.natDegree, (a i : F_hat) * θ ^ (i : ℕ)) →
        IsWeilAnalyticUnramifiedGen K_hat F_hat x := by
    clear hs3_hensel hEquiChar hIsoK
    intro x Lx OF OLx φ hFinLx f_int θ hθ hf_monic _ hf_root hf_deriv hOrtho hSpanF
    letI : Algebra ↥Lx F_hat := Lx.toAlgebra
    letI : Algebra ↥OLx ↥OF := φ.toAlgebra
    have hMemOF : ∀ z : F_hat, z ∈ OF ↔ ‖z‖ ≤ 1 := by
      intro z
      rw [Valuation.mem_valuationSubring_iff, NormedField.valuation_apply,
        ← NNReal.coe_le_coe, NNReal.coe_one, coe_nnnorm]
    let d₀ : ℕ := f_int.natDegree
    let θ_OF : ↥OF := ⟨θ, hθ⟩
    let b_OF : Fin d₀ → ↥OF := fun i => θ_OF ^ (i : ℕ)
    have hsmul_coe : ∀ (c : ↥OLx) (y : ↥OF), ((c • y : ↥OF) : F_hat) = ((c : ↥Lx) : F_hat) * (y : F_hat) :=
      fun _ _ => rfl
    have hLinInd : LinearIndependent ↥OLx b_OF := by
      rw [Fintype.linearIndependent_iff]
      intro c hc j
      have hc_coe : ∑ i : Fin d₀, ((c i : ↥Lx) : F_hat) * θ ^ (i : ℕ) = 0 := by
        have h0 : ((∑ i : Fin d₀, c i • b_OF i : ↥OF) : F_hat) = 0 := by rw [hc]; rfl
        simpa [b_OF, θ_OF, hsmul_coe] using h0
      have hnorm0 : ‖((c j : ↥Lx) : F_hat)‖ ≤ 0 := by
        have h1 := hOrtho (fun i => (c i : ↥Lx)) j
        rw [hc_coe, norm_zero] at h1
        exact h1
      have hcj0 : ((c j : ↥Lx) : F_hat) = 0 :=
        norm_eq_zero.mp (le_antisymm hnorm0 (norm_nonneg _))
      exact Subtype.ext (Subtype.ext hcj0)
    have hSpan : ⊤ ≤ Submodule.span ↥OLx (Set.range b_OF) := by
      intro y _
      obtain ⟨a, hy_eq⟩ := hSpanF (y : F_hat)
      have hy_norm : ‖(y : F_hat)‖ ≤ 1 := (hMemOF (y : F_hat)).mp y.2
      have ha_OLx : ∀ j : Fin d₀, a j ∈ OLx := by
        intro j
        change (a j : F_hat) ∈ OF
        rw [hMemOF]
        have h1 := hOrtho a j
        rw [← hy_eq] at h1
        exact h1.trans hy_norm
      let c : Fin d₀ → ↥OLx := fun j => ⟨a j, ha_OLx j⟩
      have hy_sum : y = ∑ i : Fin d₀, c i • b_OF i := by
        apply Subtype.ext
        simpa [c, b_OF, θ_OF, hsmul_coe] using hy_eq
      rw [hy_sum]
      exact Submodule.sum_mem _ fun i _ =>
        Submodule.smul_mem _ (c i) (Submodule.subset_span ⟨i, rfl⟩)
    let B_basis : Module.Basis (Fin d₀) ↥OLx ↥OF := Module.Basis.mk hLinInd hSpan
    have hModFin : Module.Finite ↥OLx ↥OF := Module.Finite.of_basis B_basis
    have hSurj_aeval : Function.Surjective (Polynomial.aeval θ_OF : Polynomial ↥OLx →ₐ[↥OLx] ↥OF) := by
      intro y
      refine ⟨∑ i : Fin d₀, Polynomial.monomial (i : ℕ) (B_basis.repr y i), ?_⟩
      have hy := B_basis.sum_repr y
      simp only [map_sum, Polynomial.aeval_monomial, Algebra.algebraMap_eq_smul_one,
        smul_mul_assoc, one_mul]
      simpa [B_basis, b_OF] using hy
