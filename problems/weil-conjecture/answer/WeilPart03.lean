    let f_gr : 𝒜_R →+*ᵍ 𝒜_S :=
      { toRingHom := MvPolynomial.map φ_RS
        map_mem := fun hx => (MvPolynomial.mem_homogeneousSubmodule _ _).mpr
          (((MvPolynomial.mem_homogeneousSubmodule _ _).mp hx).map φ_RS) }
    have hfX : ∀ a : Fin (N + 1), f_gr (MvPolynomial.X a) = MvPolynomial.X a :=
      fun a => MvPolynomial.map_X φ_RS a
    have hX_irrel_R : ∀ a : Fin (N + 1),
        MvPolynomial.X a ∈ (HomogeneousIdeal.irrelevant 𝒜_R).toIdeal := by
      intro a
      change MvPolynomial.X a ∈ HomogeneousIdeal.irrelevant 𝒜_R
      rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply]
      exact DirectSum.decompose_of_mem_ne 𝒜_R (hX_mem R N a) (by decide : (1 : ℕ) ≠ 0)
    have hf_irrel : HomogeneousIdeal.irrelevant 𝒜_S ≤
        HomogeneousIdeal.map f_gr (HomogeneousIdeal.irrelevant 𝒜_R) := by
      change (HomogeneousIdeal.irrelevant 𝒜_S).toIdeal ≤
        (HomogeneousIdeal.map f_gr (HomogeneousIdeal.irrelevant 𝒜_R)).toIdeal
      rw [HomogeneousIdeal.toIdeal_map]
      refine le_trans (hProperCover S N).2.1 (Ideal.span_le.mpr ?_)
      rintro y ⟨a, rfl⟩
      rw [← hfX a]
      exact Ideal.mem_map_of_mem f_gr.toRingHom (hX_irrel_R a)
    let Φ : AlgebraicGeometry.Proj 𝒜_S ⟶ AlgebraicGeometry.Proj 𝒜_R :=
      AlgebraicGeometry.Proj.map f_gr hf_irrel
    let p_R : AlgebraicGeometry.Proj 𝒜_R ⟶ AlgebraicGeometry.Spec (CommRingCat.of R) :=
      (weilProjectiveSpaceOver R N).hom
    let p_S : AlgebraicGeometry.Proj 𝒜_S ⟶ AlgebraicGeometry.Spec (CommRingCat.of S) :=
      (weilProjectiveSpaceOver S N).hom
    let s_RS : AlgebraicGeometry.Spec (CommRingCat.of S) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of R) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_RS)
    
    have haway_pR : ∀ a : Fin (N + 1),
        AlgebraicGeometry.Proj.awayι 𝒜_R (MvPolynomial.X a) (hX_mem R N a) zero_lt_one ≫ p_R =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            ((HomogeneousLocalization.fromZeroRingHom 𝒜_R
              (Submonoid.powers (MvPolynomial.X a))).comp (algebraMap R ↥(𝒜_R 0)))) := by
      intro a
      change (AlgebraicGeometry.Proj.awayι 𝒜_R (MvPolynomial.X a) (hX_mem R N a) zero_lt_one ≫
          AlgebraicGeometry.Proj.toSpecZero 𝒜_R) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R ↥(𝒜_R 0))) = _
      rw [AlgebraicGeometry.Proj.awayι_toSpecZero, ← AlgebraicGeometry.Spec.map_comp]
      rfl
    have haway_pS : ∀ (y : MvPolynomial (Fin (N + 1)) S) (hy : y ∈ 𝒜_S 1),
        AlgebraicGeometry.Proj.awayι 𝒜_S y hy zero_lt_one ≫ p_S =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            ((HomogeneousLocalization.fromZeroRingHom 𝒜_S
              (Submonoid.powers y)).comp (algebraMap S ↥(𝒜_S 0)))) := by
      intro y hy
      change (AlgebraicGeometry.Proj.awayι 𝒜_S y hy zero_lt_one ≫
          AlgebraicGeometry.Proj.toSpecZero 𝒜_S) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap S ↥(𝒜_S 0))) = _
      rw [AlgebraicGeometry.Proj.awayι_toSpecZero, ← AlgebraicGeometry.Spec.map_comp]
      rfl
    
    have hAwayMap_zero : ∀ (a : Fin (N + 1)) (r : R),
        HomogeneousLocalization.Away.map f_gr (MvPolynomial.X a)
          (HomogeneousLocalization.fromZeroRingHom 𝒜_R (Submonoid.powers (MvPolynomial.X a))
            (algebraMap R ↥(𝒜_R 0) r)) =
        HomogeneousLocalization.fromZeroRingHom 𝒜_S
          (Submonoid.powers (f_gr (MvPolynomial.X a)))
          (algebraMap S ↥(𝒜_S 0) (φ_RS r)) := by
      intro a r
      apply HomogeneousLocalization.val_injective (Submonoid.powers (f_gr (MvPolynomial.X a)))
      change (HomogeneousLocalization.Away.map f_gr (MvPolynomial.X a)
          (HomogeneousLocalization.mk ⟨0, algebraMap R ↥(𝒜_R 0) r, 1,
            Submonoid.one_mem (Submonoid.powers (MvPolynomial.X a))⟩)).val =
        (HomogeneousLocalization.mk ⟨0, algebraMap S ↥(𝒜_S 0) (φ_RS r), 1,
          Submonoid.one_mem (Submonoid.powers (f_gr (MvPolynomial.X a)))⟩).val
      dsimp only [HomogeneousLocalization.Away.map]
      rw [HomogeneousLocalization.map_mk, HomogeneousLocalization.val_mk,
        HomogeneousLocalization.val_mk]
      congr 1
      · change MvPolynomial.map φ_RS (algebraMap R ↥(𝒜_R 0) r).1 =
          (algebraMap S ↥(𝒜_S 0) (φ_RS r)).1
        rw [halg0 R N r, halg0 S N (φ_RS r), MvPolynomial.map_C]
      · apply Subtype.ext
        exact map_one _
    have hAwayMap_mk : ∀ (a b : Fin (N + 1)),
        HomogeneousLocalization.Away.map f_gr (MvPolynomial.X a)
          (HomogeneousLocalization.Away.mk 𝒜_R (hX_mem R N a) 1
            (MvPolynomial.X b) (hX_mem R N b)) =
        HomogeneousLocalization.Away.mk 𝒜_S (f_gr.map_mem (hX_mem R N a)) 1
          (MvPolynomial.X b) (hX_mem S N b) := by
      intro a b
      apply HomogeneousLocalization.val_injective (Submonoid.powers (f_gr (MvPolynomial.X a)))
      simp [HomogeneousLocalization.Away.map, HomogeneousLocalization.Away.mk,
        HomogeneousLocalization.map_mk, HomogeneousLocalization.val_mk, hfX b]
    
    have hSpecPB : ∀ a : Fin (N + 1),
        CategoryTheory.IsPullback
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (HomogeneousLocalization.Away.map f_gr (MvPolynomial.X a))))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            ((HomogeneousLocalization.fromZeroRingHom 𝒜_S
              (Submonoid.powers (f_gr (MvPolynomial.X a)))).comp (algebraMap S ↥(𝒜_S 0)))))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            ((HomogeneousLocalization.fromZeroRingHom 𝒜_R
              (Submonoid.powers (MvPolynomial.X a))).comp (algebraMap R ↥(𝒜_R 0)))))
          s_RS := by
      intro a
      let τ := {b : Fin (N + 1) // b ≠ a}
      have hPolyComm : CommRingCat.ofHom (MvPolynomial.C : R →+* MvPolynomial τ R) ≫
          CommRingCat.ofHom (MvPolynomial.map φ_RS) =
          CommRingCat.ofHom φ_RS ≫
            CommRingCat.ofHom (MvPolynomial.C : S →+* MvPolynomial τ S) := by
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro r
        exact MvPolynomial.map_C φ_RS r
      have hPolyPush : CategoryTheory.IsPushout
          (CommRingCat.ofHom (MvPolynomial.C : R →+* MvPolynomial τ R))
          (CommRingCat.ofHom φ_RS)
          (CommRingCat.ofHom (MvPolynomial.map φ_RS))
          (CommRingCat.ofHom (MvPolynomial.C : S →+* MvPolynomial τ S)) := by
        refine CategoryTheory.IsPushout.of_isColimit
          (Limits.PushoutCocone.IsColimit.mk hPolyComm
            (fun c => CommRingCat.ofHom
              (MvPolynomial.eval₂Hom c.inr.hom (fun b => c.inl.hom (MvPolynomial.X b))))
            ?_ ?_ ?_)
        · intro c
          apply CommRingCat.hom_ext
          apply MvPolynomial.ringHom_ext'
          · apply RingHom.ext
            intro r
            have hc := RingHom.congr_fun (CommRingCat.Hom.ext_iff.mp c.condition) r
            change (MvPolynomial.eval₂Hom c.inr.hom (fun b => c.inl.hom (MvPolynomial.X b)))
              (MvPolynomial.map φ_RS (MvPolynomial.C r)) = c.inl.hom (MvPolynomial.C r)
            rw [MvPolynomial.map_C, MvPolynomial.eval₂Hom_C]
            exact hc.symm
          · intro b
            change (MvPolynomial.eval₂Hom c.inr.hom (fun b => c.inl.hom (MvPolynomial.X b)))
              (MvPolynomial.map φ_RS (MvPolynomial.X b)) = c.inl.hom (MvPolynomial.X b)
            rw [MvPolynomial.map_X, MvPolynomial.eval₂Hom_X']
        · intro c
          apply CommRingCat.hom_ext
          apply RingHom.ext
          intro s
          exact MvPolynomial.eval₂Hom_C _ _ s
        · intro c m hml hmr
          apply CommRingCat.hom_ext
          apply MvPolynomial.ringHom_ext'
          · apply RingHom.ext
            intro s
            have hms := RingHom.congr_fun (CommRingCat.Hom.ext_iff.mp hmr) s
            change m.hom (MvPolynomial.C s) =
              (MvPolynomial.eval₂Hom c.inr.hom (fun b => c.inl.hom (MvPolynomial.X b)))
                (MvPolynomial.C s)
            rw [MvPolynomial.eval₂Hom_C]
            exact hms
          · intro b
            have hmb := RingHom.congr_fun (CommRingCat.Hom.ext_iff.mp hml) (MvPolynomial.X b)
            change m.hom (MvPolynomial.X b) =
              (MvPolynomial.eval₂Hom c.inr.hom (fun b => c.inl.hom (MvPolynomial.X b)))
                (MvPolynomial.X b)
            rw [MvPolynomial.eval₂Hom_X']
            change m.hom (MvPolynomial.map φ_RS (MvPolynomial.X b)) = c.inl.hom (MvPolynomial.X b) at hmb
            rwa [MvPolynomial.map_X] at hmb
      obtain ⟨e_R, heR_C, heR_X⟩ := hDehom R N a (MvPolynomial.X a) rfl
      obtain ⟨e_S, heS_C, heS_X⟩ := hDehom S N a (f_gr (MvPolynomial.X a)) (hfX a)
      have hPush : CategoryTheory.IsPushout
          (CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom 𝒜_R
            (Submonoid.powers (MvPolynomial.X a))).comp (algebraMap R ↥(𝒜_R 0))))
          (CommRingCat.ofHom φ_RS)
          (CommRingCat.ofHom (HomogeneousLocalization.Away.map f_gr (MvPolynomial.X a)))
          (CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom 𝒜_S
            (Submonoid.powers (f_gr (MvPolynomial.X a)))).comp (algebraMap S ↥(𝒜_S 0)))) := by
        refine hPolyPush.of_iso (Iso.refl _) e_R.toCommRingCatIso (Iso.refl _)
          e_S.toCommRingCatIso ?_ ?_ ?_ ?_
        · apply CommRingCat.hom_ext
          apply RingHom.ext
          intro r
          exact heR_C r
        · simp
        · apply CommRingCat.hom_ext
          apply MvPolynomial.ringHom_ext'
          · apply RingHom.ext
            intro r
            change e_S (MvPolynomial.map φ_RS (MvPolynomial.C r)) =
              HomogeneousLocalization.Away.map f_gr (MvPolynomial.X a) (e_R (MvPolynomial.C r))
            rw [heR_C r, MvPolynomial.map_C, heS_C (φ_RS r), hAwayMap_zero a r]
          · intro b
            change e_S (MvPolynomial.map φ_RS (MvPolynomial.X b)) =
              HomogeneousLocalization.Away.map f_gr (MvPolynomial.X a) (e_R (MvPolynomial.X b))
            rw [heR_X b, MvPolynomial.map_X, heS_X b, hAwayMap_mk a b.1]
        · apply CommRingCat.hom_ext
          apply RingHom.ext
          intro s
          exact heS_C s
      exact AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ hPush
    
    have hB1 : Φ ≫ p_R = p_S ≫ s_RS := by
      apply AlgebraicGeometry.Scheme.hom_ext_of_forall
      intro x
      have hCov_S : (⨆ a : Fin (N + 1), AlgebraicGeometry.Proj.basicOpen 𝒜_S (MvPolynomial.X a)) = ⊤ :=
        (hProperCover S N).2.2
      have hx_top : x ∈ (⊤ : (AlgebraicGeometry.Proj 𝒜_S).Opens) := trivial
      rw [← hCov_S, TopologicalSpace.Opens.mem_iSup] at hx_top
      rcases hx_top with ⟨a, hxa⟩
      rw [← hfX a] at hxa
      refine ⟨AlgebraicGeometry.Proj.basicOpen 𝒜_S (f_gr (MvPolynomial.X a)), hxa, ?_⟩
      have hdeg_fXa : f_gr (MvPolynomial.X a) ∈ 𝒜_S 1 := f_gr.map_mem (hX_mem R N a)
      rw [← cancel_epi (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_S
        (f_gr (MvPolynomial.X a)) hdeg_fXa zero_lt_one).inv]
      simp only [← Category.assoc]
      rw [AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι]
      calc (AlgebraicGeometry.Proj.awayι 𝒜_S (f_gr (MvPolynomial.X a)) hdeg_fXa zero_lt_one ≫ Φ) ≫ p_R
        _ = (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (HomogeneousLocalization.Away.map f_gr (MvPolynomial.X a))) ≫
              AlgebraicGeometry.Proj.awayι 𝒜_R (MvPolynomial.X a) (hX_mem R N a) zero_lt_one) ≫ p_R := by
          rw [AlgebraicGeometry.Proj.awayι_comp_map f_gr hf_irrel zero_lt_one
            (MvPolynomial.X a) (hX_mem R N a)]
        _ = AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (HomogeneousLocalization.Away.map f_gr (MvPolynomial.X a))) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                ((HomogeneousLocalization.fromZeroRingHom 𝒜_R
                  (Submonoid.powers (MvPolynomial.X a))).comp (algebraMap R ↥(𝒜_R 0)))) := by
          rw [Category.assoc, haway_pR a]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              ((HomogeneousLocalization.fromZeroRingHom 𝒜_S
                (Submonoid.powers (f_gr (MvPolynomial.X a)))).comp (algebraMap S ↥(𝒜_S 0)))) ≫
              s_RS := (hSpecPB a).w
        _ = (AlgebraicGeometry.Proj.awayι 𝒜_S (f_gr (MvPolynomial.X a)) hdeg_fXa zero_lt_one ≫
              p_S) ≫ s_RS := by
          rw [haway_pS _ hdeg_fXa]
    
    have hB2 : CategoryTheory.IsPullback Φ p_S p_R s_RS := by
      let PB := Limits.pullback p_R s_RS
      let p₁ : PB ⟶ AlgebraicGeometry.Proj 𝒜_R := Limits.pullback.fst p_R s_RS
      let p₂ : PB ⟶ AlgebraicGeometry.Spec (CommRingCat.of S) := Limits.pullback.snd p_R s_RS
      let Φ_lift : AlgebraicGeometry.Proj 𝒜_S ⟶ PB := Limits.pullback.lift Φ p_S hB1
      let D_R : Fin (N + 1) → (AlgebraicGeometry.Proj 𝒜_R).Opens :=
        fun a => AlgebraicGeometry.Proj.basicOpen 𝒜_R (MvPolynomial.X a)
      let W : Fin (N + 1) → PB.Opens :=
        fun a => (TopologicalSpace.Opens.map p₁.base).obj (D_R a)
      have hW_top : (⨆ a : Fin (N + 1), W a) = ⊤ := by
        have hCov_R : (⨆ a : Fin (N + 1), D_R a) = ⊤ := (hProperCover R N).2.2
        rw [eq_top_iff]
        intro z _
        have hz : p₁.base z ∈ (⊤ : (AlgebraicGeometry.Proj 𝒜_R).Opens) := trivial
        rw [← hCov_R, TopologicalSpace.Opens.mem_iSup] at hz
        exact TopologicalSpace.Opens.mem_iSup.mpr hz
      have hIso_lift : CategoryTheory.IsIso Φ_lift := by
        refine (AlgebraicGeometry.IsZariskiLocalAtTarget.iff_of_iSup_eq_top
          (P := MorphismProperty.isomorphisms AlgebraicGeometry.Scheme) W hW_top).mpr ?_
        intro a
        change CategoryTheory.IsIso (Φ_lift ∣_ W a)
        let V_lift : (AlgebraicGeometry.Proj 𝒜_S).Opens :=
          (TopologicalSpace.Opens.map Φ_lift.base).obj (W a)
        have hPB_A := AlgebraicGeometry.isPullback_morphismRestrict Φ_lift (W a)
        have hPB_B := AlgebraicGeometry.isPullback_morphismRestrict p₁ (D_R a)
        have hPB_Wa : CategoryTheory.IsPullback (p₁ ∣_ D_R a) ((W a).ι ≫ p₂)
            ((D_R a).ι ≫ p_R) s_RS :=
          hPB_B.paste_vert (CategoryTheory.IsPullback.of_hasPullback p_R s_RS)
        have hdeg_fXa : f_gr (MvPolynomial.X a) ∈ 𝒜_S 1 := f_gr.map_mem (hX_mem R N a)
        have heq_V : V_lift = AlgebraicGeometry.Proj.basicOpen 𝒜_S (f_gr (MvPolynomial.X a)) := by
          rw [← AlgebraicGeometry.Proj.map_preimage_basicOpen f_gr hf_irrel (MvPolynomial.X a)]
          ext x
          change p₁.base (Φ_lift.base x) ∈ D_R a ↔ Φ.base x ∈ D_R a
          have hfp : Φ_lift ≫ p₁ = Φ := Limits.pullback.lift_fst Φ p_S hB1
          rw [← hfp]
          rfl
        let isoV : V_lift.toScheme ≅
            AlgebraicGeometry.Spec (CommRingCat.of
              (HomogeneousLocalization.Away 𝒜_S (f_gr (MvPolynomial.X a)))) :=
          AlgebraicGeometry.Scheme.isoOfEq (AlgebraicGeometry.Proj 𝒜_S) heq_V ≪≫
            AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_S (f_gr (MvPolynomial.X a))
              hdeg_fXa zero_lt_one
        let isoDR : (D_R a).toScheme ≅
            AlgebraicGeometry.Spec (CommRingCat.of
              (HomogeneousLocalization.Away 𝒜_R (MvPolynomial.X a))) :=
          AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_R (MvPolynomial.X a)
            (hX_mem R N a) zero_lt_one
        have hisoV_ι : isoV.inv ≫ V_lift.ι =
            AlgebraicGeometry.Proj.awayι 𝒜_S (f_gr (MvPolynomial.X a)) hdeg_fXa zero_lt_one := by
          dsimp [isoV]
          rw [Category.assoc, AlgebraicGeometry.Scheme.isoOfEq_inv_ι,
            AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι]
        have hisoDR_ι : isoDR.inv ≫ (D_R a).ι =
            AlgebraicGeometry.Proj.awayι 𝒜_R (MvPolynomial.X a) (hX_mem R N a) zero_lt_one :=
          AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜_R (MvPolynomial.X a)
            (hX_mem R N a) zero_lt_one
        have htop_sq : isoV.inv ≫ ((Φ_lift ∣_ W a) ≫ (p₁ ∣_ D_R a)) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (HomogeneousLocalization.Away.map f_gr (MvPolynomial.X a))) ≫ isoDR.inv := by
          rw [← cancel_mono (D_R a).ι]
          calc (isoV.inv ≫ ((Φ_lift ∣_ W a) ≫ (p₁ ∣_ D_R a))) ≫ (D_R a).ι
            _ = isoV.inv ≫ (Φ_lift ∣_ W a) ≫ ((p₁ ∣_ D_R a) ≫ (D_R a).ι) := by
              simp only [Category.assoc]
            _ = isoV.inv ≫ ((Φ_lift ∣_ W a) ≫ (W a).ι) ≫ p₁ := by
              rw [hPB_B.w, Category.assoc]
            _ = (isoV.inv ≫ V_lift.ι) ≫ (Φ_lift ≫ p₁) := by
              rw [hPB_A.w, Category.assoc, Category.assoc]
            _ = AlgebraicGeometry.Proj.awayι 𝒜_S (f_gr (MvPolynomial.X a)) hdeg_fXa zero_lt_one ≫
                Φ := by
              rw [hisoV_ι, Limits.pullback.lift_fst]
            _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                  (HomogeneousLocalization.Away.map f_gr (MvPolynomial.X a))) ≫
                (isoDR.inv ≫ (D_R a).ι) := by
              rw [AlgebraicGeometry.Proj.awayι_comp_map f_gr hf_irrel zero_lt_one
                (MvPolynomial.X a) (hX_mem R N a), hisoDR_ι]
            _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                  (HomogeneousLocalization.Away.map f_gr (MvPolynomial.X a))) ≫ isoDR.inv) ≫
                (D_R a).ι := by
              rw [Category.assoc]
        have hPB_Vlift : CategoryTheory.IsPullback
            ((Φ_lift ∣_ W a) ≫ (p₁ ∣_ D_R a))
            ((Φ_lift ∣_ W a) ≫ ((W a).ι ≫ p₂))
            ((D_R a).ι ≫ p_R)
            s_RS := by
          refine (hSpecPB a).of_iso isoV.symm isoDR.symm (Iso.refl _) (Iso.refl _) ?_ ?_ ?_ ?_
          · simp only [Iso.symm_hom]
            exact htop_sq.symm
          · rw [Iso.refl_hom, Category.comp_id, Iso.symm_hom]
            symm
            calc isoV.inv ≫ (Φ_lift ∣_ W a) ≫ ((W a).ι ≫ p₂)
              _ = isoV.inv ≫ ((Φ_lift ∣_ W a) ≫ (W a).ι) ≫ p₂ := by
                simp only [Category.assoc]
              _ = (isoV.inv ≫ V_lift.ι) ≫ (Φ_lift ≫ p₂) := by
                rw [hPB_A.w, Category.assoc, Category.assoc]
              _ = AlgebraicGeometry.Proj.awayι 𝒜_S (f_gr (MvPolynomial.X a))
                    hdeg_fXa zero_lt_one ≫ p_S := by
                rw [hisoV_ι, Limits.pullback.lift_snd]
              _ = _ := haway_pS _ hdeg_fXa
          · rw [Iso.refl_hom, Category.comp_id, Iso.symm_hom, ← Category.assoc,
              hisoDR_ι, haway_pR a]
          · simp
        let isoCmp := CategoryTheory.IsPullback.isoIsPullback _ _ hPB_Vlift hPB_Wa
        have hcmp_eq : Φ_lift ∣_ W a = isoCmp.hom := by
          apply hPB_Wa.hom_ext
          · exact (CategoryTheory.IsPullback.isoIsPullback_hom_fst _ _ hPB_Vlift hPB_Wa).symm
          · exact (CategoryTheory.IsPullback.isoIsPullback_hom_snd _ _ hPB_Vlift hPB_Wa).symm
        rw [hcmp_eq]
        infer_instance
      have _ : CategoryTheory.IsIso Φ_lift := hIso_lift
      refine (CategoryTheory.IsPullback.of_hasPullback p_R s_RS).of_iso
        (asIso Φ_lift).symm (Iso.refl _) (Iso.refl _) (Iso.refl _) ?_ ?_ ?_ ?_
      · rw [Iso.refl_hom, Category.comp_id, Iso.symm_hom, ← cancel_epi (asIso Φ_lift).hom,
          Iso.hom_inv_id_assoc, asIso_hom]
        exact Limits.pullback.lift_fst Φ p_S hB1
      · rw [Iso.refl_hom, Category.comp_id, Iso.symm_hom, ← cancel_epi (asIso Φ_lift).hom,
          Iso.hom_inv_id_assoc, asIso_hom]
        exact Limits.pullback.lift_snd Φ p_S hB1
      · simp
      · simp
    
    refine ⟨Φ, hB1, hB2, ?_⟩
    intro a
    have heq_a : (TopologicalSpace.Opens.map Φ.base).obj (weilProjBasicOpen R N a) =
        weilProjBasicOpen S N a :=
      (AlgebraicGeometry.Proj.map_preimage_basicOpen f_gr hf_irrel (MvPolynomial.X a)).trans
        (congrArg (AlgebraicGeometry.Proj.basicOpen 𝒜_S) (hfX a))
    let U_R : (AlgebraicGeometry.Proj 𝒜_R).Opens :=
      AlgebraicGeometry.Proj.basicOpen 𝒜_R (MvPolynomial.X a)
    have hMapSec : ∀ (y : MvPolynomial (Fin (N + 1)) S) (hy : y = f_gr (MvPolynomial.X a))
        (hy_deg : y ∈ 𝒜_S 1)
        (heq_y : (TopologicalSpace.Opens.map Φ.base).obj U_R =
          AlgebraicGeometry.Proj.basicOpen 𝒜_S y),
        (∀ r : R,
          (Φ.app U_R ≫
            (AlgebraicGeometry.Proj 𝒜_S).presheaf.map (CategoryTheory.eqToHom heq_y.symm).op).hom
              (c_proj R N a r) =
          (AlgebraicGeometry.Proj.awayToSection 𝒜_S y).hom
            (HomogeneousLocalization.fromZeroRingHom 𝒜_S (Submonoid.powers y)
              (algebraMap S ↥(𝒜_S 0) (φ_RS r)))) ∧
        (∀ b : Fin (N + 1),
          (Φ.app U_R ≫
            (AlgebraicGeometry.Proj 𝒜_S).presheaf.map (CategoryTheory.eqToHom heq_y.symm).op).hom
              (t_proj R N a b) =
          (AlgebraicGeometry.Proj.awayToSection 𝒜_S y).hom
            (HomogeneousLocalization.Away.mk 𝒜_S hy_deg 1 (MvPolynomial.X b) (hX_mem S N b))) := by
      intro y hy hy_deg heq_y
      subst hy
      let U_y : (AlgebraicGeometry.Proj 𝒜_S).Opens :=
        AlgebraicGeometry.Proj.basicOpen 𝒜_S (f_gr (MvPolynomial.X a))
      let hU_R : AlgebraicGeometry.IsAffineOpen U_R :=
        AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜_R (MvPolynomial.X a)
          (hX_mem R N a) zero_lt_one
      let hU_y : AlgebraicGeometry.IsAffineOpen U_y :=
        AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜_S (f_gr (MvPolynomial.X a))
          hy_deg zero_lt_one
      let Ψ := Φ.app U_R ≫
        (AlgebraicGeometry.Proj 𝒜_S).presheaf.map (CategoryTheory.eqToHom heq_y.symm).op
      have hΨ_appLE : Ψ = Φ.appLE U_R U_y (le_of_eq heq_y.symm) := by
        dsimp [Ψ]
        rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE, AlgebraicGeometry.Scheme.Hom.appLE_map']
      have hSpec_eq : AlgebraicGeometry.Spec.map
          (AlgebraicGeometry.Proj.awayToSection 𝒜_R (MvPolynomial.X a) ≫ Ψ) ≫
          AlgebraicGeometry.Proj.awayι 𝒜_R (MvPolynomial.X a) (hX_mem R N a) zero_lt_one =
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (HomogeneousLocalization.Away.map f_gr (MvPolynomial.X a)) ≫
              AlgebraicGeometry.Proj.awayToSection 𝒜_S (f_gr (MvPolynomial.X a))) ≫
            AlgebraicGeometry.Proj.awayι 𝒜_R (MvPolynomial.X a) (hX_mem R N a) zero_lt_one := by
        calc AlgebraicGeometry.Spec.map
              (AlgebraicGeometry.Proj.awayToSection 𝒜_R (MvPolynomial.X a) ≫ Ψ) ≫
              AlgebraicGeometry.Proj.awayι 𝒜_R (MvPolynomial.X a) (hX_mem R N a) zero_lt_one
          _ = AlgebraicGeometry.Spec.map Ψ ≫
              (AlgebraicGeometry.Spec.map
                (AlgebraicGeometry.Proj.awayToSection 𝒜_R (MvPolynomial.X a)) ≫
                AlgebraicGeometry.Proj.awayι 𝒜_R (MvPolynomial.X a)
                  (hX_mem R N a) zero_lt_one) := by
            rw [AlgebraicGeometry.Spec.map_comp, Category.assoc]
          _ = AlgebraicGeometry.Spec.map (Φ.appLE U_R U_y (le_of_eq heq_y.symm)) ≫
              hU_R.fromSpec := by
            rw [hΨ_appLE, hBridge R N (MvPolynomial.X a) (hX_mem R N a)]
          _ = hU_y.fromSpec ≫ Φ :=
            AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec Φ hU_R hU_y
              (le_of_eq heq_y.symm)
          _ = (AlgebraicGeometry.Spec.map
                (AlgebraicGeometry.Proj.awayToSection 𝒜_S (f_gr (MvPolynomial.X a))) ≫
                AlgebraicGeometry.Proj.awayι 𝒜_S (f_gr (MvPolynomial.X a)) hy_deg zero_lt_one) ≫
              Φ := by
            rw [← hBridge S N (f_gr (MvPolynomial.X a)) hy_deg]
          _ = AlgebraicGeometry.Spec.map
                (AlgebraicGeometry.Proj.awayToSection 𝒜_S (f_gr (MvPolynomial.X a))) ≫
              (AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (HomogeneousLocalization.Away.map f_gr (MvPolynomial.X a))) ≫
                AlgebraicGeometry.Proj.awayι 𝒜_R (MvPolynomial.X a)
                  (hX_mem R N a) zero_lt_one) := by
            rw [Category.assoc, AlgebraicGeometry.Proj.awayι_comp_map f_gr hf_irrel zero_lt_one
              (MvPolynomial.X a) (hX_mem R N a)]
          _ = _ := by
            rw [← Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
      have hSec_eq : AlgebraicGeometry.Proj.awayToSection 𝒜_R (MvPolynomial.X a) ≫ Ψ =
          CommRingCat.ofHom (HomogeneousLocalization.Away.map f_gr (MvPolynomial.X a)) ≫
            AlgebraicGeometry.Proj.awayToSection 𝒜_S (f_gr (MvPolynomial.X a)) := by
        apply AlgebraicGeometry.Spec.map_injective
        exact (cancel_mono (AlgebraicGeometry.Proj.awayι 𝒜_R (MvPolynomial.X a)
          (hX_mem R N a) zero_lt_one)).mp hSpec_eq
      refine ⟨?_, ?_⟩
      · intro r
        have hr := RingHom.congr_fun (CommRingCat.Hom.ext_iff.mp hSec_eq)
          (HomogeneousLocalization.fromZeroRingHom 𝒜_R (Submonoid.powers (MvPolynomial.X a))
            (algebraMap R ↥(𝒜_R 0) r))
        exact hr.trans (congrArg (AlgebraicGeometry.Proj.awayToSection 𝒜_S _).hom
          (hAwayMap_zero a r))
      · intro b
        have hb := RingHom.congr_fun (CommRingCat.Hom.ext_iff.mp hSec_eq)
          (HomogeneousLocalization.Away.mk 𝒜_R (hX_mem R N a) 1 (MvPolynomial.X b) (hX_mem R N b))
        have hmk : HomogeneousLocalization.Away.map f_gr (MvPolynomial.X a)
            (HomogeneousLocalization.Away.mk 𝒜_R (hX_mem R N a) 1
              (MvPolynomial.X b) (hX_mem R N b)) =
            HomogeneousLocalization.Away.mk 𝒜_S hy_deg 1 (MvPolynomial.X b) (hX_mem S N b) := by
          rw [hAwayMap_mk a b]
        exact hb.trans (congrArg (AlgebraicGeometry.Proj.awayToSection 𝒜_S _).hom hmk)
    exact ⟨heq_a, hMapSec (MvPolynomial.X a) (hfX a).symm (hX_mem S N a) heq_a⟩

theorem weil_generic_curve_coords_and_segre_closedImmersion (K : Type u) [Field K]
    (V : ValuationSubring K)
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (n : ℕ)
    (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (hIntCK : AlgebraicGeometry.IsIntegral C_K)
    (F : Type u) [Field F] [Algebra K F]
    (η_F : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ C_K)
    (hηF_comm : η_F ≫ p_K = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K F)))
    (hFuncF : IsSchemeFunctionField C_K F η_F)
    (hSmPoles : HasSmoothCurveLocalRegularityAndOverringOpen C_K F η_F)
    (C₀ : AlgebraicGeometry.Scheme.{u})
    (g₀ : C₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (τ₀ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C₀))
    (ι₀ : C_K ⟶ C₀)
    (hMod₀ : IsValuationPointedCurveModel V p_K n σ_K C₀ g₀ τ₀ ι₀)
    (hFunc₀ : IsSchemeFunctionField C₀ F (η_F ≫ ι₀))
    (M₀ : ℕ)
    (ιP₀ : C₀ ⟶ (weilProjectiveSpaceOver ↥V M₀).left)
    (hClP₀ : AlgebraicGeometry.IsClosedImmersion ιP₀)
    (hCommP₀ : ιP₀ ≫ (weilProjectiveSpaceOver ↥V M₀).hom = g₀)
    (hAff_proj : ∀ (R : Type u) [CommRing R] (N : ℕ) (a : Fin (N + 1)),
      AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen R N a))
    (c_proj : ∀ (R : Type u) [CommRing R] (N : ℕ) (a : Fin (N + 1)),
      R →+* ↑((weilProjectiveSpaceOver R N).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen R N a))))
    (t_proj : ∀ (R : Type u) [CommRing R] (N : ℕ) (a : Fin (N + 1)), Fin (N + 1) →
      ↑((weilProjectiveSpaceOver R N).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen R N a))))
    (hCoord_proj : ∀ (R : Type u) [CommRing R] (N : ℕ),
      IsCommRingProjCoordSystem R N (hAff_proj R N) (c_proj R N) (t_proj R N))
    (hBase_proj : ∀ (R S : Type u) [CommRing R] [CommRing S] (φ_RS : R →+* S) (N : ℕ),
      ∃ (Φ : (weilProjectiveSpaceOver S N).left ⟶ (weilProjectiveSpaceOver R N).left),
        IsCommRingProjBaseChange R S φ_RS N
          (c_proj R N) (t_proj R N) (c_proj S N) (t_proj S N) Φ) :
    ∃ (ξ : Fin (M₀ + 1) → F) (r_gen : Fin (M₀ + 1)),
      ξ r_gen ≠ 0 ∧
      (∀ r : Fin (M₀ + 1),
        let C₀_r : C₀.Opens :=
          (TopologicalSpace.Opens.map ιP₀.base).obj (weilProjBasicOpen ↥V M₀ r)
        let V_Kr : C_K.Opens :=
          (TopologicalSpace.Opens.map (ι₀ ≫ ιP₀).base).obj (weilProjBasicOpen ↥V M₀ r)
        AlgebraicGeometry.IsAffineOpen C₀_r ∧
        AlgebraicGeometry.IsAffineOpen V_Kr ∧
        (Nonempty ↥C₀_r ↔ ξ r ≠ 0) ∧
        (Nonempty ↥V_Kr ↔ ξ r ≠ 0) ∧
        (ξ r ≠ 0 →
          (∀ (hC₀r : AlgebraicGeometry.IsAffineOpen C₀_r)
              (φ₀ : C₀.presheaf.obj (Opposite.op C₀_r) ⟶ CommRingCat.of F),
            AlgebraicGeometry.Spec.map φ₀ ≫ hC₀r.fromSpec = η_F ≫ ι₀ →
            (∀ s : Fin (M₀ + 1),
              φ₀.hom ((ιP₀.app (weilProjBasicOpen ↥V M₀ r)).hom (t_proj ↥V M₀ r s)) =
                ξ s / ξ r) ∧
            Set.range φ₀.hom =
              (Subring.closure
                (Set.range ((algebraMap K F).comp V.subtype) ∪
                  Set.range (fun s : Fin (M₀ + 1) => ξ s / ξ r)) : Set F)) ∧
          (∀ (hVKr : AlgebraicGeometry.IsAffineOpen V_Kr)
              (φ_K : C_K.presheaf.obj (Opposite.op V_Kr) ⟶ CommRingCat.of F),
            AlgebraicGeometry.Spec.map φ_K ≫ hVKr.fromSpec = η_F →
            Set.range φ_K.hom =
              (Subring.closure
                (Set.range (algebraMap K F) ∪
                  Set.range (fun s : Fin (M₀ + 1) => ξ s / ξ r)) : Set F)))) ∧
      (∀ (L : ℕ) (f : Fin L → F), (∀ γ : Fin L, f γ ≠ 0) →
        ∀ (M : ℕ) (eSeg : Fin (M + 1) ≃ Fin (M₀ + 1) × Finset (Fin L)),
          ∃ (Ψ_K : C_K ⟶ (weilProjectiveSpaceOver K M).left),
            IsSegreGenericClosedImmersion C_K p_K η_F M₀ ξ
              (fun r => (TopologicalSpace.Opens.map (ι₀ ≫ ιP₀).base).obj
                (weilProjBasicOpen ↥V M₀ r))
              L f M eSeg (t_proj K M) Ψ_K) :=
by
  
  have hs1_s2 :
      (∀ (R : Type u) [CommRing R] (F : Type u) [Field F] (ρ : R →+* F)
        (X : AlgebraicGeometry.Scheme.{u})
        (g : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
        (η : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ X),
        η ≫ g = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ) →
        IsSchemeFunctionField X F η →
        ∀ (M₀ : ℕ) (ιP : X ⟶ (weilProjectiveSpaceOver R M₀).left),
        AlgebraicGeometry.IsClosedImmersion ιP →
        ιP ≫ (weilProjectiveSpaceOver R M₀).hom = g →
        ∀ (hAff : ∀ a : Fin (M₀ + 1), AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen R M₀ a))
          (c_R : ∀ a : Fin (M₀ + 1),
            R →+* ↑((weilProjectiveSpaceOver R M₀).left.presheaf.obj
              (Opposite.op (weilProjBasicOpen R M₀ a))))
          (t_R : ∀ a : Fin (M₀ + 1), Fin (M₀ + 1) →
            ↑((weilProjectiveSpaceOver R M₀).left.presheaf.obj
              (Opposite.op (weilProjBasicOpen R M₀ a)))),
        IsCommRingProjCoordSystem R M₀ hAff c_R t_R →
        ∀ (r_gen : Fin (M₀ + 1))
          (θ_gen : ↑((weilProjectiveSpaceOver R M₀).left.presheaf.obj
            (Opposite.op (weilProjBasicOpen R M₀ r_gen))) →+* F),
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ_gen) ≫ (hAff r_gen).fromSpec = η ≫ ιP →
        ∀ (ξ : Fin (M₀ + 1) → F),
        (∀ s : Fin (M₀ + 1), ξ s = θ_gen (t_R r_gen s)) →
        ξ r_gen ≠ 0 ∧
        ((⨆ r : Fin (M₀ + 1),
          (TopologicalSpace.Opens.map ιP.base).obj (weilProjBasicOpen R M₀ r)) = ⊤) ∧
        (∀ r : Fin (M₀ + 1),
          let X_r : X.Opens := (TopologicalSpace.Opens.map ιP.base).obj (weilProjBasicOpen R M₀ r)
          AlgebraicGeometry.IsAffineOpen X_r ∧
          (Nonempty ↥X_r ↔ ξ r ≠ 0) ∧
          (∀ r' : Fin (M₀ + 1),
            X.basicOpen ((ιP.app (weilProjBasicOpen R M₀ r)).hom (t_R r r')) =
              X_r ⊓ (TopologicalSpace.Opens.map ιP.base).obj (weilProjBasicOpen R M₀ r')) ∧
          (ξ r ≠ 0 →
            ∀ (hXr : AlgebraicGeometry.IsAffineOpen X_r)
                (φ : X.presheaf.obj (Opposite.op X_r) ⟶ CommRingCat.of F),
              AlgebraicGeometry.Spec.map φ ≫ hXr.fromSpec = η →
              (∀ s : Fin (M₀ + 1),
                φ.hom ((ιP.app (weilProjBasicOpen R M₀ r)).hom (t_R r s)) = ξ s / ξ r) ∧
              Set.range φ.hom =
                (Subring.closure
                  (Set.range ρ ∪ Set.range (fun s : Fin (M₀ + 1) => ξ s / ξ r)) : Set F)))) ∧
      (∀ (K : Type u) [Field K] (V : ValuationSubring K)
        (C_K C₀ : AlgebraicGeometry.Scheme.{u})
        (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
        (g₀ : C₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
        (ι₀ : C_K ⟶ C₀),
        CategoryTheory.IsPullback ι₀ p_K g₀
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)) →
        ∀ (F : Type u) [Field F] [Algebra K F]
          (η_F : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ C_K),
        η_F ≫ p_K = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K F)) →
        ∀ (M₀ : ℕ) (ιP₀ : C₀ ⟶ (weilProjectiveSpaceOver ↥V M₀).left),
        AlgebraicGeometry.IsClosedImmersion ιP₀ →
        ιP₀ ≫ (weilProjectiveSpaceOver ↥V M₀).hom = g₀ →
        ∀ (hAff_V : ∀ a : Fin (M₀ + 1), AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen ↥V M₀ a))
          (c_V : ∀ a : Fin (M₀ + 1),
            ↥V →+* ↑((weilProjectiveSpaceOver ↥V M₀).left.presheaf.obj
              (Opposite.op (weilProjBasicOpen ↥V M₀ a))))
          (t_V : ∀ a : Fin (M₀ + 1), Fin (M₀ + 1) →
            ↑((weilProjectiveSpaceOver ↥V M₀).left.presheaf.obj
              (Opposite.op (weilProjBasicOpen ↥V M₀ a)))),
        IsCommRingProjCoordSystem ↥V M₀ hAff_V c_V t_V →
        ∀ (hAff_K : ∀ a : Fin (M₀ + 1), AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen K M₀ a))
          (c_K : ∀ a : Fin (M₀ + 1),
            K →+* ↑((weilProjectiveSpaceOver K M₀).left.presheaf.obj
              (Opposite.op (weilProjBasicOpen K M₀ a))))
          (t_K : ∀ a : Fin (M₀ + 1), Fin (M₀ + 1) →
            ↑((weilProjectiveSpaceOver K M₀).left.presheaf.obj
              (Opposite.op (weilProjBasicOpen K M₀ a)))),
        IsCommRingProjCoordSystem K M₀ hAff_K c_K t_K →
        ∀ (Φ₀ : (weilProjectiveSpaceOver K M₀).left ⟶ (weilProjectiveSpaceOver ↥V M₀).left),
        IsCommRingProjBaseChange ↥V K V.subtype M₀ c_V t_V c_K t_K Φ₀ →
        ∃ (ιPK : C_K ⟶ (weilProjectiveSpaceOver K M₀).left)
          (r_gen : Fin (M₀ + 1))
          (θ_V : ↑((weilProjectiveSpaceOver ↥V M₀).left.presheaf.obj
            (Opposite.op (weilProjBasicOpen ↥V M₀ r_gen))) →+* F)
          (θ_K : ↑((weilProjectiveSpaceOver K M₀).left.presheaf.obj
            (Opposite.op (weilProjBasicOpen K M₀ r_gen))) →+* F),
          AlgebraicGeometry.IsClosedImmersion ιPK ∧
          ιPK ≫ (weilProjectiveSpaceOver K M₀).hom = p_K ∧
          ιPK ≫ Φ₀ = ι₀ ≫ ιP₀ ∧
          (∀ r : Fin (M₀ + 1),
            (TopologicalSpace.Opens.map (ι₀ ≫ ιP₀).base).obj (weilProjBasicOpen ↥V M₀ r) =
              (TopologicalSpace.Opens.map ιPK.base).obj (weilProjBasicOpen K M₀ r)) ∧
          (η_F ≫ ι₀) ≫ g₀ =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((algebraMap K F).comp V.subtype)) ∧
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ_V) ≫ (hAff_V r_gen).fromSpec =
            (η_F ≫ ι₀) ≫ ιP₀ ∧
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ_K) ≫ (hAff_K r_gen).fromSpec =
            η_F ≫ ιPK ∧
          (∀ s : Fin (M₀ + 1), θ_K (t_K r_gen s) = θ_V (t_V r_gen s))) := by
    clear * -
    have h_fromSpec_nat : ∀ {A B : Scheme.{u}} (f : A ⟶ B) (V : B.Opens)
        (hV : IsAffineOpen V) (hpre : IsAffineOpen ((TopologicalSpace.Opens.map f.base).obj V)),
        hpre.fromSpec ≫ f = Spec.map (f.app V) ≫ hV.fromSpec := by
      intro A B f V hV hpre
      let W : A.Opens := (TopologicalSpace.Opens.map f.base).obj V
      have h1 := Scheme.Opens.toSpecΓ_SpecMap_appLE f V W (le_refl W)
      have h2 := hpre.isoSpec.inv ≫= h1
      rw [← hpre.isoSpec_hom, Iso.inv_hom_id_assoc] at h2
      have h3 := h2 =≫ hV.fromSpec
      simp only [Category.assoc, hV.toSpecΓ_fromSpec] at h3
      have h4 : f.resLE V W (le_refl W) ≫ V.ι = W.ι ≫ f := by simp
      rw [f.app_eq_appLE]
      change hpre.fromSpec ≫ f = Spec.map (f.appLE V W (le_refl W)) ≫ hV.fromSpec
      rw [h3, h4, ← Category.assoc]
      rfl
    have h_mem_range_fromSpec : ∀ {A : Scheme.{u}} {V : A.Opens} (hV : IsAffineOpen V) {x : A},
        x ∈ V → x ∈ Set.range hV.fromSpec.base := by
      intro A V hV x hx
      refine ⟨hV.isoSpec.hom.base ⟨x, hx⟩, ?_⟩
      change (hV.isoSpec.hom ≫ hV.isoSpec.inv ≫ V.ι).base ⟨x, hx⟩ = x
      rw [Iso.hom_inv_id_assoc]
      rfl
    have h_field_pt_ideal : ∀ (E : Type u) [Field E] (q : Spec (CommRingCat.of E)),
        q.asIdeal = (⊥ : Ideal E) := by
      intro E _ q
      by_contra hne
      obtain ⟨x, hx, hx0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hne
      exact q.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ hx (IsUnit.mk0 x hx0))
    constructor
    · intro R _ F _ ρ X g η hη_comm hFunc M₀ ιP hClP hCommP hAff c_R t_R hCoord
        r_gen θ_gen hθ_gen ξ hξ_def
      have _ : IsClosedImmersion ιP := hClP
      obtain ⟨_hProp, hCover, hc_comm, _hPoly, ht_diag, hGen, _hUniv, hBasic, _hc_res, ht_cocycle⟩ :=
        hCoord
      let pt : Spec (CommRingCat.of F) := default
      have hpt_ideal : pt.asIdeal = (⊥ : Ideal F) := h_field_pt_ideal F pt
      have hξ_gen : ξ r_gen ≠ 0 := by
        rw [hξ_def r_gen, ht_diag r_gen, map_one]
        exact one_ne_zero
      have hX_top : (⨆ r : Fin (M₀ + 1),
          (TopologicalSpace.Opens.map ιP.base).obj (weilProjBasicOpen R M₀ r)) = ⊤ := by
        rw [eq_top_iff]
        intro x _
        have hx : ιP.base x ∈ (⊤ : (weilProjectiveSpaceOver R M₀).left.Opens) := trivial
        rw [← hCover, TopologicalSpace.Opens.mem_iSup] at hx
        obtain ⟨r, hr⟩ := hx
