      have hLaurentMax : ∀ {F : Type u} [NormedField F] [IsUltrametricDist F] [Algebra K_hat F]
          (hIsoF : ∀ c : K_hat, ‖algebraMap K_hat F c‖ = ‖c‖)
          (S : F), S ≠ 0 → (∀ c : K_hat, ‖S‖ ≠ ‖c‖) →
          ∀ (I : Finset ℤ) (c : ℤ → K_hat), (∃ j ∈ I, c j ≠ 0) →
          ∃ k ∈ I, c k ≠ 0 ∧
            ‖∑ j ∈ I, algebraMap K_hat F (c j) * S ^ j‖ = ‖algebraMap K_hat F (c k) * S ^ k‖ ∧
            ‖(∑ j ∈ I, algebraMap K_hat F (c j) * S ^ j) - algebraMap K_hat F (c k) * S ^ k‖ <
              ‖algebraMap K_hat F (c k) * S ^ k‖ := by
