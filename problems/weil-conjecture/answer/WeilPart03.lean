    let p_C_spec := (IsLocalization.orderIsoOfPrime (Submonoid.powers f) C).symm q₀_sub
    let p_C : Ideal C := p_C_spec.1
    have hp_C_prime : p_C.IsPrime := p_C_spec.2
    have hp_C_comap : Ideal.comap (algebraMap C₀ C) p_C = p₀.asIdeal :=
      congrArg Subtype.val
        ((IsLocalization.orderIsoOfPrime (Submonoid.powers f) C).apply_symm_apply q₀_sub)
    haveI : p_C.IsPrime := hp_C_prime
    haveI : Nontrivial C :=
      ⟨⟨0, 1, fun h01 => hp_C_prime.ne_top
        (Ideal.eq_top_of_isUnit_mem p_C (h01 ▸ p_C.zero_mem) isUnit_one)⟩⟩
    letI : Algebra A_nod C₀ := φ_AC₀.hom.toAlgebra
    letI : Algebra A_nod C := ((algebraMap C₀ C).comp φ_AC₀.hom).toAlgebra
    letI : Algebra B C := ((algebraMap C₀ C).comp φ_BC₀.hom).toAlgebra
    haveI : IsScalarTower A_nod C₀ C := IsScalarTower.of_algebraMap_eq' rfl
    haveI : IsScalarTower B A_nod C := ⟨fun b y c => by
      have hb : algebraMap B C b = algebraMap A_nod C (algebraMap B A_nod b) := by
        change (algebraMap C₀ C) (φ_BC₀.hom b) = (algebraMap C₀ C) (φ_AC₀.hom (φ_BA b))
        rw [← hφ_comp]
        rfl
      rw [Algebra.smul_def b y, Algebra.smul_def, Algebra.smul_def, Algebra.smul_def,
        map_mul, hb, mul_assoc]⟩
    have hSm_BC : Algebra.IsStandardSmoothOfRelativeDimension 1 B C :=
      RingHom.IsStandardSmoothOfRelativeDimension.toAlgebra 1 (hs_loc f hf_s C)
    haveI : Algebra.IsStandardSmoothOfRelativeDimension 1 B C := hSm_BC
    haveI : Algebra.IsStandardSmooth B C :=
      Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth 1
    haveI : Algebra.Etale A_nod C₀ := hEt_AC₀.toAlgebra
    haveI : Algebra.Etale C₀ C := Algebra.Etale.of_isLocalizationAway f
    haveI : Algebra.FormallyEtale A_nod C := Algebra.FormallyEtale.comp A_nod C₀ C
    obtain ⟨K_x, instFieldKx, ψ_CK, hψ_ker⟩ :
        ∃ (K_x : Type u) (_ : Field K_x) (ψ_CK : C →+* K_x), ∀ z ∈ p_C, ψ_CK z = 0 :=
      ⟨FractionRing (C ⧸ p_C), inferInstance,
        (algebraMap (C ⧸ p_C) (FractionRing (C ⧸ p_C))).comp (Ideal.Quotient.mk p_C),
        fun z hz => by simp [Ideal.Quotient.eq_zero_iff_mem.mpr hz]⟩
    letI : Field K_x := instFieldKx
    let ψ_AK : A_nod →+* K_x := ψ_CK.comp (algebraMap A_nod C)
    let ψ_PK : MvPolynomial (Fin 2) B →+* K_x := ψ_AK.comp (Ideal.Quotient.mk J_rel)
    let ψ_BK : B →+* K_x := ψ_PK.comp MvPolynomial.C
    letI : Algebra C K_x := ψ_CK.toAlgebra
    letI : Algebra A_nod K_x := ψ_AK.toAlgebra
    letI : Algebra (MvPolynomial (Fin 2) B) K_x := ψ_PK.toAlgebra
    letI : Algebra B K_x := ψ_BK.toAlgebra
    haveI : IsScalarTower B (MvPolynomial (Fin 2) B) (K_x × K_x) :=
      ⟨fun b P ⟨u, v⟩ => by
        rw [Algebra.smul_def b P]
        change (ψ_PK (algebraMap B (MvPolynomial (Fin 2) B) b * P) * u,
            ψ_PK (algebraMap B (MvPolynomial (Fin 2) B) b * P) * v) =
          (ψ_BK b * (ψ_PK P * u), ψ_BK b * (ψ_PK P * v))
        rw [map_mul]
        exact Prod.ext (mul_assoc (ψ_BK b) (ψ_PK P) u) (mul_assoc (ψ_BK b) (ψ_PK P) v)⟩
    haveI : IsScalarTower B A_nod (K_x × K_x) :=
      ⟨fun b y ⟨u, v⟩ => by
        rw [Algebra.smul_def b y]
        change (ψ_AK (algebraMap B A_nod b * y) * u, ψ_AK (algebraMap B A_nod b * y) * v) =
          (ψ_BK b * (ψ_AK y * u), ψ_BK b * (ψ_AK y * v))
        rw [map_mul]
        exact Prod.ext (mul_assoc (ψ_BK b) (ψ_AK y) u) (mul_assoc (ψ_BK b) (ψ_AK y) v)⟩
    haveI : IsScalarTower A_nod C (K_x × K_x) :=
      ⟨fun y c ⟨u, v⟩ => by
        change (ψ_CK (algebraMap A_nod C y * c) * u, ψ_CK (algebraMap A_nod C y * c) * v) =
          (ψ_AK y * (ψ_CK c * u), ψ_AK y * (ψ_CK c * v))
        rw [map_mul]
        exact Prod.ext (mul_assoc (ψ_AK y) (ψ_CK c) u) (mul_assoc (ψ_AK y) (ψ_CK c) v)⟩
    have hX_zero : ∀ i : Fin 2, ψ_PK (MvPolynomial.X i) = 0 := by
      intro i
      apply hψ_ker
      have h1 : Ideal.Quotient.mk J_rel (MvPolynomial.X i) ∈ Ideal.comap φ_AC₀.hom p₀.asIdeal := by
        rw [hp₀_A]
        exact haxes i
      rw [← hp_C_comap] at h1
      exact h1
    let v_dir : Fin 2 → K_x × K_x := ![(1, 0), (0, 1)]
    let D_poly : Derivation B (MvPolynomial (Fin 2) B) (K_x × K_x) :=
      MvPolynomial.mkDerivation B v_dir
    have hDG : D_poly G_rel = 0 := by
      dsimp [G_rel]
      rw [map_sub, D_poly.leibniz]
      have hCa : D_poly (MvPolynomial.C a) = 0 :=
        D_poly.map_algebraMap a
      rw [hCa, sub_zero]
      have hsmul0 : ∀ (i : Fin 2) (w : K_x × K_x),
          (MvPolynomial.X i : MvPolynomial (Fin 2) B) • w = 0 := by
        intro i ⟨u, v⟩
        change (ψ_PK (MvPolynomial.X i) * u, ψ_PK (MvPolynomial.X i) * v) = (0, 0)
        rw [hX_zero i, zero_mul, zero_mul]
      rw [hsmul0 0, hsmul0 1, add_zero]
    have hG_smul : ∀ w : K_x × K_x, G_rel • w = 0 := by
      intro ⟨u, v⟩
      have hG0 : ψ_PK G_rel = 0 := by
        change ψ_AK (Ideal.Quotient.mk J_rel G_rel) = 0
        rw [Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self G_rel), map_zero]
      change (ψ_PK G_rel * u, ψ_PK G_rel * v) = (0, 0)
      rw [hG0, zero_mul, zero_mul]
    have hJ_ker_full : ∀ P ∈ J_rel, D_poly P = 0 := by
      intro P hP
      rcases Ideal.mem_span_singleton.mp hP with ⟨Q, rfl⟩
      rw [D_poly.leibniz, hG_smul, hDG, smul_zero, zero_add]
    let D_nod_lin : A_nod →ₗ[B] (K_x × K_x) :=
      (J_rel.restrictScalars B).liftQ D_poly.toLinearMap (fun P hP => hJ_ker_full P hP)
    let D_nod : Derivation B A_nod (K_x × K_x) :=
      { toLinearMap := D_nod_lin
        map_one_eq_zero' := D_poly.map_one_eq_zero
        leibniz' := fun x y => by
          refine Quotient.inductionOn₂' x y (fun P Q => ?_)
          exact D_poly.leibniz P Q }
    let L₀ : Ω[A_nod⁄B] →ₗ[A_nod] (K_x × K_x) := D_nod.liftKaehlerDifferential
    let L₁ : TensorProduct A_nod C Ω[A_nod⁄B] →ₗ[C] (K_x × K_x) := LinearMap.liftBaseChange C L₀
    let e_et : TensorProduct A_nod C Ω[A_nod⁄B] ≃ₗ[C] Ω[C⁄B] :=
      KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale B A_nod C
    let Φ : Ω[C⁄B] →ₗ[C] (K_x × K_x) := L₁.comp e_et.symm.toLinearMap
    have hΦ_D : ∀ y : A_nod,
        Φ (KaehlerDifferential.D B C (algebraMap A_nod C y)) = D_nod y := by
      intro y
      have he_et : e_et ((1 : C) ⊗ₜ[A_nod] KaehlerDifferential.D B A_nod y) =
          KaehlerDifferential.D B C (algebraMap A_nod C y) := by
        change KaehlerDifferential.mapBaseChange B A_nod C
            ((1 : C) ⊗ₜ[A_nod] KaehlerDifferential.D B A_nod y) =
          KaehlerDifferential.D B C (algebraMap A_nod C y)
        rw [KaehlerDifferential.mapBaseChange_tmul, one_smul, KaehlerDifferential.map_D]
      dsimp [Φ]
      rw [← he_et, e_et.symm_apply_apply]
      simp [L₁, L₀, LinearMap.liftBaseChange_tmul, one_smul]
    let u₀ : A_nod := Ideal.Quotient.mk J_rel (MvPolynomial.X 0)
    let u₁ : A_nod := Ideal.Quotient.mk J_rel (MvPolynomial.X 1)
    have hΦ₀ : Φ (KaehlerDifferential.D B C (algebraMap A_nod C u₀)) = (1, 0) := by
      rw [hΦ_D]
      change D_poly (MvPolynomial.X 0) = (1, 0)
      rw [MvPolynomial.mkDerivation_X]
      simp [v_dir]
    have hΦ₁ : Φ (KaehlerDifferential.D B C (algebraMap A_nod C u₁)) = (0, 1) := by
      rw [hΦ_D]
      change D_poly (MvPolynomial.X 1) = (0, 1)
      rw [MvPolynomial.mkDerivation_X]
      simp [v_dir]
    haveI : Module.Free C Ω[C⁄B] := Algebra.IsStandardSmooth.free_kaehlerDifferential
    let b := Module.Free.chooseBasis C Ω[C⁄B]
    let ι := Module.Free.ChooseBasisIndex C Ω[C⁄B]
    have hcard : Cardinal.mk ι = 1 := by
      rw [← Module.Free.rank_eq_card_chooseBasisIndex C Ω[C⁄B],
        Algebra.IsStandardSmoothOfRelativeDimension.rank_kaehlerDifferential 1]
      simp
    have hne : Nonempty ι := Cardinal.mk_ne_zero_iff.mp (by rw [hcard]; exact one_ne_zero)
    obtain ⟨i₀⟩ := hne
    have _ : Subsingleton ι := Cardinal.le_one_iff_subsingleton.mp (by rw [hcard])
    letI : Unique ι := uniqueOfSubsingleton i₀
    letI : Fintype ι := Unique.fintype
    have hspan_one : ∀ η : Ω[C⁄B], (b.repr η i₀) • b i₀ = η := by
      intro η
      have hsum := b.sum_repr η
      rwa [Fintype.sum_unique] at hsum
    let c₀ : C := b.repr (KaehlerDifferential.D B C (algebraMap A_nod C u₀)) i₀
    let c₁ : C := b.repr (KaehlerDifferential.D B C (algebraMap A_nod C u₁)) i₀
    have h0_eq : c₀ • Φ (b i₀) = (1, 0) := by
      rw [← Φ.map_smul, hspan_one]
      exact hΦ₀
    have h1_eq : c₁ • Φ (b i₀) = (0, 1) := by
      rw [← Φ.map_smul, hspan_one]
      exact hΦ₁
    let u_star : K_x := (Φ (b i₀)).1
    let v_star : K_x := (Φ (b i₀)).2
    have h0_fst : ψ_CK c₀ * u_star = 1 := congrArg Prod.fst h0_eq
    have h0_snd : ψ_CK c₀ * v_star = 0 := congrArg Prod.snd h0_eq
    have h1_snd : ψ_CK c₁ * v_star = 1 := congrArg Prod.snd h1_eq
    have hc₀_ne : ψ_CK c₀ ≠ 0 := fun h0 => one_ne_zero (by rw [← h0_fst, h0, zero_mul])
    have hv_zero : v_star = 0 := (mul_eq_zero.mp h0_snd).resolve_left hc₀_ne
    rw [hv_zero, mul_zero] at h1_snd
    exact zero_ne_one h1_snd
  refine ⟨hPart1.1, ?_, hPart4 ↥V⟩
  intro P hP hP_ne
  obtain ⟨hEx_tz, hAtPrime_fn⟩ := hPart1.2 P hP_ne
  refine ⟨hEx_tz, ?_⟩
  intro t_z ht_z ht_z_iff R_z _ _ _
  have hAtP : IsLocalization.AtPrime R_z P := hAtPrime_fn t_z ht_z ht_z_iff R_z
  refine ⟨hAtP, ?_⟩
  intro I hI C₀ _ _ _ q_z _ hqz_comap
  letI : HenselianLocalRing ↥V := hPkg.2.2.1
  haveI : IsAlgClosed P.ResidueField := hPkg.2.2.2.2.1 P hP_ne
  haveI : IsLocalization.AtPrime R_z P := hAtP
  obtain ⟨hHensQ, hAlgClQ, hComapQ⟩ := hPart2 P R_z I hI
  letI : HenselianLocalRing (R_z ⧸ I) := hHensQ
  haveI : IsAlgClosed (IsLocalRing.ResidueField (R_z ⧸ I)) := hAlgClQ
  exact hPart3 (R_z ⧸ I) C₀ q_z (hComapQ C₀ q_z hqz_comap)

theorem weil_local_linear_p1_smooth_blowup_model (K : Type u) [Field K]
    (V : ValuationSubring K)
    (P : Ideal ↥V) [P.IsPrime]
    (t_z s₁ c₁ π₁ : ↥V)
    (ht_z : t_z ∉ P)
    (R_z : Type u) [CommRing R_z] [Algebra ↥V R_z]
    [IsLocalization.Away t_z R_z] [IsLocalization.AtPrime R_z P]
    (hs₁ : s₁ ∉ P)
    (hπ₁_mem : π₁ ∈ P)
    (hπ₁_ne : π₁ ≠ 0) :
    ((⊥ : Ideal R_z) ≠ ⊤ ∧
      AlgebraicGeometry.IsOpenImmersion
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (Polynomial.mapRingHom (algebraMap ↥V R_z)))) ∧
      Set.range
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (Polynomial.mapRingHom (algebraMap ↥V R_z)))).base =
        {q : PrimeSpectrum (Polynomial ↥V) | Polynomial.C t_z ∉ q.asIdeal} ∧
      Function.Surjective
        ((Ideal.Quotient.mk
          (Ideal.span
            {(Polynomial.mapRingHom (algebraMap ↥V R_z))
              (Polynomial.C s₁ * Polynomial.X - Polynomial.C c₁)})).comp
          (Polynomial.C : R_z →+* Polynomial R_z)) ∧
      RingHom.ker
        ((Ideal.Quotient.mk
          (Ideal.span
            {(Polynomial.mapRingHom (algebraMap ↥V R_z))
              (Polynomial.C s₁ * Polynomial.X - Polynomial.C c₁)})).comp
          (Polynomial.C : R_z →+* Polynomial R_z)) = ⊥) ∧
    ∃ (M_sm : AlgebraicGeometry.Scheme.{u})
      (p_sm : M_sm ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial R_z)))
      (U_sm1 : M_sm.Opens)
      (e_sm1 : U_sm1.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial ↥V))),
      IsLocalSemistableBlowupModel V
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap ↥V R_z) ≫ CommRingCat.ofHom Polynomial.C))
        (Ideal.span
          {(Polynomial.mapRingHom (algebraMap ↥V R_z))
            (Polynomial.C s₁ * Polynomial.X - Polynomial.C c₁)} ⊔
          Ideal.span {Polynomial.C (algebraMap ↥V R_z π₁)})
        p_sm ∧
      AlgebraicGeometry.Etale e_sm1 ∧
      U_sm1.ι ≫ p_sm ≫
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap ↥V R_z) ≫ CommRingCat.ofHom Polynomial.C) =
        e_sm1 ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) ∧
      AlgebraicGeometry.SmoothOfRelativeDimension 1
        (U_sm1.ι ≫ p_sm ≫
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap ↥V R_z) ≫ CommRingCat.ofHom Polynomial.C)) ∧
      (∀ (R : Type u) [CommRing R] [IsDomain R] [IsLocalRing R]
          (ψ_M : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ M_sm)
          (q : R),
        (AlgebraicGeometry.Spec.preimage
          (ψ_M ≫ p_sm ≫
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap ↥V R_z) ≫
                CommRingCat.ofHom Polynomial.C))).hom π₁ ≠ 0 →
        (AlgebraicGeometry.Spec.preimage
          (ψ_M ≫ p_sm ≫
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom
                (Polynomial.mapRingHom (algebraMap ↥V R_z))))).hom
            (Polynomial.C s₁ * Polynomial.X - Polynomial.C c₁) =
          (AlgebraicGeometry.Spec.preimage
            (ψ_M ≫ p_sm ≫
              AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (algebraMap ↥V R_z) ≫
                  CommRingCat.ofHom Polynomial.C))).hom π₁ * q →
        ∃ (ψ_U : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ U_sm1.toScheme),
          ψ_U ≫ U_sm1.ι = ψ_M ∧
          (AlgebraicGeometry.Spec.preimage
            (ψ_M ≫ p_sm ≫
              AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (algebraMap ↥V R_z) ≫
                  CommRingCat.ofHom Polynomial.C))).hom π₁ *
              (AlgebraicGeometry.Spec.preimage (ψ_U ≫ e_sm1)).hom Polynomial.X =
            (AlgebraicGeometry.Spec.preimage
              (ψ_M ≫ p_sm ≫
                AlgebraicGeometry.Spec.map
                  (CommRingCat.ofHom (algebraMap ↥V R_z) ≫
                    CommRingCat.ofHom Polynomial.C))).hom π₁ * q) :=
by
  
  have hPolySmoothPkg : ∀ (B₀ : Type u) [CommRing B₀] (t : B₀)
      (R : Type u) [CommRing R] [Algebra B₀ R] [IsLocalization.Away t R],
      let φ_poly : Polynomial B₀ →+* Polynomial R := Polynomial.mapRingHom (algebraMap B₀ R)
      @IsLocalization.Away (Polynomial B₀) _ (Polynomial.C t) (Polynomial R) _ φ_poly.toAlgebra ∧
      AlgebraicGeometry.IsOpenImmersion (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_poly)) ∧
      Set.range (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_poly)).base =
        {q : PrimeSpectrum (Polynomial B₀) | Polynomial.C t ∉ q.asIdeal} ∧
      AlgebraicGeometry.SmoothOfRelativeDimension 1
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : B₀ →+* Polynomial B₀))) := by
    intro B₀ _ t R _ _ _ φ_poly
    let _ : Algebra (Polynomial B₀) (Polynomial R) := φ_poly.toAlgebra
    have hloc_map : IsLocalization (Submonoid.map Polynomial.C (Submonoid.powers t)) (Polynomial R) := by
      let _ : Algebra (Polynomial B₀) (Polynomial R) := Polynomial.algebra B₀ R
      have h1 : IsLocalization (Submonoid.map Polynomial.C (Submonoid.powers t)) (Polynomial R) :=
        Polynomial.isLocalization (Submonoid.powers t) R
      have halg : Polynomial.algebra B₀ R = φ_poly.toAlgebra := by
        ext p; rfl
      simpa only [halg] using h1
    have hsub_eq : Submonoid.map Polynomial.C (Submonoid.powers t) = Submonoid.powers (Polynomial.C t) := by
      ext x
      simp only [Submonoid.mem_map, Submonoid.mem_powers_iff]
      constructor
      · rintro ⟨y, ⟨n, rfl⟩, rfl⟩
        exact ⟨n, (map_pow Polynomial.C t n).symm⟩
      · rintro ⟨n, rfl⟩
        exact ⟨t ^ n, ⟨n, rfl⟩, map_pow Polynomial.C t n⟩
    have hloc : @IsLocalization.Away (Polynomial B₀) _ (Polynomial.C t) (Polynomial R) _ φ_poly.toAlgebra := by
      dsimp only [IsLocalization.Away]
      rwa [← hsub_eq]
    have hOpen : AlgebraicGeometry.IsOpenImmersion (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_poly)) :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization (Polynomial.C t)
    have hRange : Set.range (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_poly)).base =
        {q : PrimeSpectrum (Polynomial B₀) | Polynomial.C t ∉ q.asIdeal} :=
      @PrimeSpectrum.localization_away_comap_range (Polynomial B₀) _ (Polynomial R) _
        φ_poly.toAlgebra (Polynomial.C t) hloc
    have hSm : AlgebraicGeometry.SmoothOfRelativeDimension 1
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : B₀ →+* Polynomial B₀))) := by
      have hStdMv : Algebra.IsStandardSmoothOfRelativeDimension (Nat.card (Fin 1)) B₀ (MvPolynomial (Fin 1) B₀) :=
        Algebra.IsStandardSmoothOfRelativeDimension.mvPolynomial B₀ (Fin 1)
      rw [Nat.card_fin] at hStdMv
      have hStdPoly : Algebra.IsStandardSmoothOfRelativeDimension 1 B₀ (Polynomial B₀) :=
        Algebra.IsStandardSmoothOfRelativeDimension.of_algEquiv 1
          (MvPolynomial.uniqueAlgEquiv B₀ (Fin 1))
      have hSmHom : RingHom.Locally (RingHom.IsStandardSmoothOfRelativeDimension 1)
          (Polynomial.C : B₀ →+* Polynomial B₀) := by
        rw [RingHom.locally_iff_finite]
        refine ⟨{1}, by simp, ?_⟩
        intro f hf
        simp only [Finset.mem_singleton] at hf
        subst hf
        let e1 : Polynomial B₀ ≃ₐ[Polynomial B₀] Localization.Away (1 : Polynomial B₀) :=
          IsLocalization.atUnits (Polynomial B₀) (Submonoid.powers (1 : Polynomial B₀))
            (by rintro _ ⟨n, rfl⟩; simp)
        letI : Algebra B₀ (Localization.Away (1 : Polynomial B₀)) :=
          ((algebraMap (Polynomial B₀) (Localization.Away (1 : Polynomial B₀))).comp Polynomial.C).toAlgebra
        let e1_B₀ : Polynomial B₀ ≃ₐ[B₀] Localization.Away (1 : Polynomial B₀) :=
          { e1.toRingEquiv with
            commutes' := fun c => by
              change e1 (Polynomial.C c) = (algebraMap (Polynomial B₀) (Localization.Away 1)) (Polynomial.C c)
              exact e1.commutes (Polynomial.C c) }
        haveI := hStdPoly
        exact Algebra.IsStandardSmoothOfRelativeDimension.of_algEquiv 1 e1_B₀
      exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.SmoothOfRelativeDimension 1)).mpr hSmHom
    exact ⟨hloc, hOpen, hRange, hSm⟩
  
  have hNodalLocPkg : ∀ (B₀ : Type u) [CommRing B₀] (t c : B₀)
      (R : Type u) [CommRing R] [Algebra B₀ R] [IsLocalization.Away t R],
      ∃ (e_nod0 : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 2) R ⧸ Ideal.span
            {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C (algebraMap B₀ R c)})) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 2) B₀ ⧸ Ideal.span
