              linarith
            let S_pos := Finset.Icc 1 c.natDegree
            have h1_mem : 1 ∈ S_pos := Finset.mem_Icc.mpr ⟨le_rfl, hc_deg⟩
            have hS_ne : S_pos.Nonempty := ⟨1, h1_mem⟩
            let M_c : ℝ := S_pos.sup' hS_ne (fun i => ‖c.coeff i‖ * r ^ i)
