    let n : ℕ := Module.finrank ↥L F_hat
    have hn_pos : 0 < n := Module.finrank_pos
    let b_res : Module.Basis (Fin d) κ_L κ_F := Module.finBasis κ_L κ_F
    let v : Fin d → ↥OF := fun j => Classical.choose (IsLocalRing.residue_surjective (b_res j))
    have hv_res : ∀ j : Fin d, IsLocalRing.residue ↥OF (v j) = b_res j :=
