    have h_left_inv : (ψ_hom : ↥Lz' → ↥Lz) ∘ (φ_hom : ↥Lz → ↥Lz') = id := by
      refine h_iz_dense.equalizer (hψ_cont.comp hφ_cont) continuous_id ?_
      funext u
