    have hInjBound : ∀ (m : ℕ) (g : Fin m → (↥K'_int)ˣ ⧸ H_val),
        Function.Injective g → m ≤ Module.finrank ↥K_base ↥K'_int := by
      intro m g hg
      let u_rep : Fin m → (↥K'_int)ˣ := fun i => Quotient.out (g i)
      let b : Fin m → ↥K'_int := fun i => (u_rep i : ↥K'_int)
      have hLin : LinearIndependent ↥K_base b := by
        rw [Fintype.linearIndependent_iff]
        intro a hsum i₀
        by_contra hi₀
        let S : Finset (Fin m) := Finset.univ.filter (fun i => a i ≠ 0)
        have hS_nonempty : S.Nonempty := ⟨i₀, Finset.mem_filter.mpr ⟨Finset.mem_univ i₀, hi₀⟩⟩
        have hS_sum : ∑ i ∈ S, algebraMap ↥K_base N (a i) * ((b i : ↥K'_int) : N) = 0 := by
          have hsumN : ((∑ i : Fin m, a i • b i : ↥K'_int) : N) = 0 := by
            rw [hsum]
            rfl
          have hsumN' : ∑ i : Fin m, algebraMap ↥K_base N (a i) * ((b i : ↥K'_int) : N) = 0 := by
            rw [← hsumN, AddSubmonoidClass.coe_finset_sum]
            refine Finset.sum_congr rfl (fun i _ => ?_)
            rw [Algebra.smul_def, MulMemClass.coe_mul]
            rfl
