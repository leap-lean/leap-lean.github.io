    exact Finset.prod_ne_zero_iff.mpr (fun z hz => (hΨ_Gsub z hz).1)
  have hΨ_G₁_inv : (Ψ G₁)⁻¹ ∈ Vx := by
    dsimp [G₁]
    rw [map_prod, ← Finset.prod_inv_distrib]
    exact Vx.toSubring.prod_mem (fun z hz => (hΨ_Gsub z hz).2)
  refine Or.inr ⟨u, w, a₁, G₁, hu_Vx, hw_Vx, hu_tr, ha₁_ne, huw_eq, hΨ_G₁_ne, hΨ_G₁_inv, ?_⟩
  intro z hz_mem
  change ∃ (n : ℕ) (P : MvPolynomial (Fin 2) ↥V₁), z * (Ψ G₁) ^ n = Ψ P
  by_cases hz0 : z = 0
  · refine ⟨0, 0, ?_⟩
    simp [hz0]
  · have hz_nz : z ∈ S₁_nz := Finset.mem_filter.mpr ⟨hz_mem, hz0⟩
    obtain ⟨_, h_eq_z, hlam_ratio⟩ := hS₁_laurent z hz_nz
    have h_monom : ∃ M_z : MvPolynomial (Fin 2) ↥V₁,
        Ψ M_z * y₀ ^ (B_exp z) = algebraMap K E (lam z) * y₀ ^ (A_exp z) := by
      rcases lt_trichotomy (A_exp z) (B_exp z) with hAB | hEq | hBA
      · have hp_mem : (lam z, B_exp z - A_exp z) ∈ U_set :=
          Finset.mem_union_right _
            (Finset.mem_image_of_mem _ (Finset.mem_filter.mpr ⟨hz_nz, hAB⟩))
        let c_z : ↥V₁ := ⟨lam z / (π₂.1) ^ (B_exp z - A_exp z), hπ₂_bound _ hp_mem⟩
        refine ⟨MvPolynomial.C c_z * (MvPolynomial.X 1) ^ (B_exp z - A_exp z), ?_⟩
        have h10 : (1 : Fin 2) ≠ 0 := by decide
        have hΨM : Ψ (MvPolynomial.C c_z * (MvPolynomial.X 1) ^ (B_exp z - A_exp z)) =
            algebraMap K E (lam z) / y₀ ^ (B_exp z - A_exp z) := by
          simp only [Ψ, map_mul, map_pow, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X',
            vars, if_neg h10]
          change algebraMap K E (lam z / (π₂.1) ^ (B_exp z - A_exp z)) *
            (v₁Map π₂ / y₀) ^ (B_exp z - A_exp z) = _
          have h1 : algebraMap K E (lam z / (π₂.1) ^ (B_exp z - A_exp z)) =
              algebraMap K E (lam z) / (v₁Map π₂) ^ (B_exp z - A_exp z) := by
            simp [v₁Map, map_div₀, map_pow]
          rw [h1, div_pow, div_mul_div_cancel₀ (pow_ne_zero _ hvπ₂_ne)]
        have hyB_pow : y₀ ^ (B_exp z) = y₀ ^ (B_exp z - A_exp z) * y₀ ^ (A_exp z) := by
          rw [← pow_add, show B_exp z - A_exp z + A_exp z = B_exp z by omega]
        rw [hΨM, hyB_pow, ← mul_assoc, div_mul_cancel₀ _ (pow_ne_zero _ hy₀_ne)]
      · have hlam_V₁ : lam z ∈ V₁ := by
          rw [ValuationSubring.mem_comap]
          rw [hEq, mul_div_cancel_right₀ _ (pow_ne_zero (B_exp z) hy₀_ne)] at hlam_ratio
          exact hlam_ratio
        let c_z : ↥V₁ := ⟨lam z, hlam_V₁⟩
        refine ⟨MvPolynomial.C c_z, ?_⟩
        simp [Ψ, v₁Map, c_z, hEq]
      · have hc_mem : lam z * (π₁.1) ^ (A_exp z - B_exp z) ∈ V₁ := by
          by_cases hlam_in : lam z ∈ V₁
          · exact V₁.toSubring.mul_mem hlam_in (V₁.toSubring.pow_mem π₁.2 (A_exp z - B_exp z))
          · have hp_mem : ((lam z)⁻¹, A_exp z - B_exp z) ∈ L_set :=
              Finset.mem_union_right _
                (Finset.mem_image_of_mem _ (Finset.mem_filter.mpr ⟨hz_nz, hBA, hlam_in⟩))
            have h_div := hπ₁_bound _ hp_mem
            dsimp at h_div
            rwa [div_inv_eq_mul, mul_comm] at h_div
        let c_z : ↥V₁ := ⟨lam z * (π₁.1) ^ (A_exp z - B_exp z), hc_mem⟩
        refine ⟨MvPolynomial.C c_z * (MvPolynomial.X 0) ^ (A_exp z - B_exp z), ?_⟩
        have hΨM : Ψ (MvPolynomial.C c_z * (MvPolynomial.X 0) ^ (A_exp z - B_exp z)) =
            algebraMap K E (lam z) * y₀ ^ (A_exp z - B_exp z) := by
          simp only [Ψ, map_mul, map_pow, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X',
            vars, ite_true]
          change algebraMap K E (lam z * (π₁.1) ^ (A_exp z - B_exp z)) *
            (y₀ / v₁Map π₁) ^ (A_exp z - B_exp z) = _
          have h1 : algebraMap K E (lam z * (π₁.1) ^ (A_exp z - B_exp z)) =
              algebraMap K E (lam z) * (v₁Map π₁) ^ (A_exp z - B_exp z) := by
            simp [v₁Map, map_mul, map_pow]
          rw [h1, div_pow, mul_assoc, mul_div_cancel₀ _ (pow_ne_zero _ hvπ₁_ne)]
        rw [hΨM, mul_assoc, ← pow_add, show A_exp z - B_exp z + B_exp z = A_exp z by omega]
    obtain ⟨M_z, hM_z⟩ := h_monom
    let N_z : MvPolynomial (Fin 2) ↥V₁ :=
      M_z * liftPoly (D.U_pos z) * ∏ i : Fin D.M, (W_poly i) ^ (D.a_exp z i)
    have hz_sub : z * Ψ (G_sub z) = Ψ N_z := by
      have hG_eval : Ψ (G_sub z) =
          Polynomial.eval₂ v₁Map x₀ (D.U_neg z) * ∏ i : Fin D.M, (V_fac i) ^ (D.b_exp z i) := by
        dsimp [G_sub]
        rw [map_mul, hΨ_lift, map_prod]
        congr 1
        refine Finset.prod_congr rfl (fun i _ => ?_)
        rw [map_pow, hΨ_W i]
      have hN_eval : Ψ N_z = Ψ M_z *
          (Polynomial.eval₂ v₁Map x₀ (D.U_pos z) * ∏ i : Fin D.M, (V_fac i) ^ (D.a_exp z i)) := by
        dsimp [N_z]
        rw [map_mul, map_mul, hΨ_lift, map_prod, mul_assoc]
        congr 2
        refine Finset.prod_congr rfl (fun i _ => ?_)
        rw [map_pow, hΨ_W i]
      apply mul_right_cancel₀ (pow_ne_zero (B_exp z) hy₀_ne)
      rw [hG_eval, hN_eval, h_eq_z]
      calc (algebraMap K E (lam z) * y₀ ^ (A_exp z)) *
            (Polynomial.eval₂ v₁Map x₀ (D.U_pos z) * ∏ i : Fin D.M, (V_fac i) ^ (D.a_exp z i))
        _ = (Ψ M_z * y₀ ^ (B_exp z)) *
            (Polynomial.eval₂ v₁Map x₀ (D.U_pos z) * ∏ i : Fin D.M, (V_fac i) ^ (D.a_exp z i)) := by
          rw [← hM_z]
        _ = Ψ M_z *
            (Polynomial.eval₂ v₁Map x₀ (D.U_pos z) * ∏ i : Fin D.M, (V_fac i) ^ (D.a_exp z i)) *
            y₀ ^ (B_exp z) := by ring
    refine ⟨1, N_z * ∏ z' ∈ S₁_nz.erase z, G_sub z', ?_⟩
    have hG₁_erase : G₁ = G_sub z * ∏ z' ∈ S₁_nz.erase z, G_sub z' :=
      (Finset.mul_prod_erase S₁_nz G_sub hz_nz).symm
    rw [pow_one, hG₁_erase, map_mul, ← mul_assoc, hz_sub, ← map_mul]

theorem weil_rationalFunctionField_valuation_chart_approximation (K : Type u) [Field K] [IsSepClosed K]
    (m : ℕ)
    (V : ValuationSubring K)
    (hPkg : IsValuationRingAlgPackage m V)
    (F : Type u) [Field F] [Algebra K F]
    (x : F)
    (hx_tr : Transcendental K x)
    (Vx : ValuationSubring ↥(IntermediateField.adjoin K ({x} : Set F)))
    (hVVx : ∀ y : ↥V,
      ((algebraMap K ↥(IntermediateField.adjoin K ({x} : Set F))).comp V.subtype) y ∈ Vx)
    (hxVx : (⟨x, IntermediateField.mem_adjoin_simple_self K x⟩ :
      ↥(IntermediateField.adjoin K ({x} : Set F))) ∈ Vx)
    (S₀ : Finset ↥(IntermediateField.adjoin K ({x} : Set F)))
    (hS₀ : ∀ z ∈ S₀, z ∈ Vx) :
    ∃ (R : Subring ↥(IntermediateField.adjoin K ({x} : Set F)))
      (hVR : ∀ y : ↥V,
        ((algebraMap K ↥(IntermediateField.adjoin K ({x} : Set F))).comp V.subtype) y ∈ R),
      (∀ r ∈ R, r ∈ Vx) ∧
      (⟨x, IntermediateField.mem_adjoin_simple_self K x⟩ :
        ↥(IntermediateField.adjoin K ({x} : Set F))) ∈ R ∧
      (∀ z ∈ S₀, z ∈ R) ∧
      HasStandardSemistableLocalizationPresentation V R hVR :=
by
  classical
  let E := ↥(IntermediateField.adjoin K ({x} : Set F))
  let x₀ : E := ⟨x, IntermediateField.mem_adjoin_simple_self K x⟩
  let V₁ : ValuationSubring K := Vx.comap (algebraMap K E)
  let S₁ : Finset E := insert x₀ S₀
  have hx₀_tr : Transcendental K x₀ :=
    (transcendental_algebraMap_iff (RingHom.injective (algebraMap E F))).mp hx_tr
  have hS₁ : ∀ z ∈ S₁, z ∈ Vx := by
    intro z hz
    rcases Finset.mem_insert.mp hz with rfl | hz₀
    · exact hxVx
    · exact hS₀ z hz₀
  have hChart : HasOverringSemistableChartWitness V₁ Vx S₁ := by
    rcases weil_sepClosed_ratFunc_perturbed_factorization K F x hx_tr Vx hxVx S₁ hS₁ with hC | hD
    · exact hC
    · cases hD with
      | intro D =>
        by_cases hAllBdd : ∀ i : Fin D.M, i ∈ D.I_bdd
        · by_cases hEq : ∃ π₀ : ↥V₁, π₀ ≠ 0 ∧
              (x₀ - ((algebraMap K E).comp V₁.subtype) (D.β D.k₀)) /
                ((algebraMap K E).comp V₁.subtype) π₀ ∈ Vx ∧
              ((algebraMap K E).comp V₁.subtype) π₀ /
                (x₀ - ((algebraMap K E).comp V₁.subtype) (D.β D.k₀)) ∈ Vx
          · exact weil_perturbed_factorization_smooth_disk_chart K E x₀ hx₀_tr Vx hxVx S₁ hS₁ D
              (Or.inr ⟨hAllBdd, hEq⟩)
          · have hDivV₁ : ∀ (a : K), a ≠ 0 → ∀ (d : ℕ), 1 ≤ d →
                ∃ (b : K) (u : ↥V₁), IsUnit u ∧ b ^ d * V₁.subtype u = a := by
              intro a ha d hd
              obtain ⟨b, u, hu, hbu⟩ := hPkg.2.2.2.1 a ha d hd
              have hVV₁ : V.toSubring ≤ V₁.toSubring := fun y hy => hVVx ⟨y, hy⟩
              refine ⟨b, Subring.inclusion hVV₁ u, hu.map (Subring.inclusion hVV₁), ?_⟩
              exact hbu
            exact weil_perturbed_factorization_nodal_annulus_chart K E x₀ hx₀_tr Vx hxVx S₁ hS₁
              hDivV₁ D hAllBdd hEq
        · exact weil_perturbed_factorization_smooth_disk_chart K E x₀ hx₀_tr Vx hxVx S₁ hS₁ D
            (Or.inl (not_forall.mp hAllBdd))
  obtain ⟨R, hVR, hRVx, hS₁R, hPres⟩ :=
    weil_overring_chart_witness_to_base_presentation K V hPkg.1 E Vx hVVx S₁ hChart
  exact ⟨R, hVR, hRVx, hS₁R x₀ (Finset.mem_insert_self x₀ S₀),
    fun z hz => hS₁R z (Finset.mem_insert_of_mem hz), hPres⟩

theorem weil_valuation_model_functionField_and_smooth_poles (K : Type u) [Field K]
    (m : ℕ)
    (V : ValuationSubring K)
    (hPkg : IsValuationRingAlgPackage m V)
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (n : ℕ)
    (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (hIntCK : AlgebraicGeometry.IsIntegral C_K)
    (hSmCK : AlgebraicGeometry.SmoothOfRelativeDimension 1 p_K)
    (hStabCK : IsGeometricStablePointedCurve p_K n σ_K)
    (F : Type u) [Field F] [Algebra K F]
    (η_F : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ C_K)
    (hηF_comm : η_F ≫ p_K = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K F)))
    (hFuncF : IsSchemeFunctionField C_K F η_F) :
    (∃ (s₀ : ↥V), s₀ ≠ 0 ∧ @IsLocalization.Away _ _ s₀ K _ V.subtype.toAlgebra) ∧
    (∀ (C : AlgebraicGeometry.Scheme.{u})
        (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
        (τ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C))
        (ι : C_K ⟶ C),
      IsValuationPointedCurveModel V p_K n σ_K C g τ ι →
      IsSchemeFunctionField C F (η_F ≫ ι)) ∧
    HasSmoothCurveLocalRegularityAndOverringOpen C_K F η_F :=
by
  classical
  
  have hPart1 : ∃ (s₀ : ↥V), s₀ ≠ 0 ∧ @IsLocalization.Away _ _ s₀ K _ V.subtype.toAlgebra := by
    have hFin : Set.Finite (Set.univ : Set (PrimeSpectrum ↥V)) := hPkg.1
    have hFinType : Finite (PrimeSpectrum ↥V) := Set.finite_univ_iff.mp hFin
    letI : Fintype (PrimeSpectrum ↥V) := Fintype.ofFinite (PrimeSpectrum ↥V)
    let x_pick : PrimeSpectrum ↥V → ↥V := fun Q =>
      if hQ : Q.asIdeal ≠ ⊥ then Classical.choose ((Submodule.ne_bot_iff Q.asIdeal).mp hQ) else 1
    have hx_mem : ∀ Q : PrimeSpectrum ↥V, Q.asIdeal ≠ ⊥ → x_pick Q ∈ Q.asIdeal ∧ x_pick Q ≠ 0 := by
      intro Q hQ
      simp only [x_pick, dif_pos hQ]
      exact Classical.choose_spec ((Submodule.ne_bot_iff Q.asIdeal).mp hQ)
    let F_primes : Finset (PrimeSpectrum ↥V) :=
      Finset.univ.filter (fun Q : PrimeSpectrum ↥V => Q.asIdeal ≠ ⊥)
    let s₀ : ↥V := ∏ Q ∈ F_primes, x_pick Q
    have hs₀ : s₀ ≠ 0 :=
      Finset.prod_ne_zero_iff.mpr (fun Q hQ => (hx_mem Q (Finset.mem_filter.mp hQ).2).2)
    have hs₀_rad : ∀ b : ↥V, b ≠ 0 → ∃ (k : ℕ) (c : ↥V), b * c = s₀ ^ k := by
      intro b hb
      have hmem_rad : s₀ ∈ (Ideal.span ({b} : Set ↥V)).radical := by
        rw [Ideal.radical_eq_sInf, Submodule.mem_sInf]
        intro P ⟨hbP, hP_prime⟩
        have hP_ne_bot : P ≠ ⊥ := by
          intro hbot
          apply hb
          rw [← Submodule.mem_bot (R := ↥V), ← hbot]
          exact hbP (Ideal.subset_span (Set.mem_singleton b))
        let Q : PrimeSpectrum ↥V := ⟨P, hP_prime⟩
        have hQ_mem : Q ∈ F_primes := Finset.mem_filter.mpr ⟨Finset.mem_univ Q, hP_ne_bot⟩
        obtain ⟨d, hd⟩ := Finset.dvd_prod_of_mem x_pick hQ_mem
        change (∏ Q' ∈ F_primes, x_pick Q') ∈ P
        rw [hd]
        exact Ideal.mul_mem_right d P (hx_mem Q hP_ne_bot).1
      obtain ⟨k, hk⟩ := Ideal.mem_radical_iff.mp hmem_rad
      obtain ⟨c, hc⟩ := Ideal.mem_span_singleton.mp hk
      exact ⟨k, c, hc.symm⟩
    letI : Algebra ↥V K := V.subtype.toAlgebra
    have hLocV : IsLocalization.Away s₀ K := by
      refine { map_units := ?_, surj := ?_, exists_of_eq := ?_ }
      · rintro ⟨y, k, rfl⟩
        exact isUnit_iff_ne_zero.mpr (by
          intro h0
          exact pow_ne_zero k hs₀ (Subtype.ext h0))
      · intro z
        rcases ValuationSubring.mem_or_inv_mem V z with hz | hz_inv
        · exact ⟨(⟨z, hz⟩, ⟨1, 0, pow_zero s₀⟩), by
            change z * (1 : K) = z
            exact mul_one z⟩
        · by_cases hz0 : z = 0
          · subst hz0
            exact ⟨(0, ⟨1, 0, pow_zero s₀⟩), by simp⟩
          · let b : ↥V := ⟨z⁻¹, hz_inv⟩
            have hb : b ≠ 0 := by
              intro hb0
              exact inv_ne_zero hz0 (congrArg Subtype.val hb0)
            obtain ⟨k, c, hbc⟩ := hs₀_rad b hb
            refine ⟨(c, ⟨s₀ ^ k, k, rfl⟩), ?_⟩
            have hbcK : z⁻¹ * (c : K) = ((s₀ ^ k : ↥V) : K) := by
              exact congrArg Subtype.val hbc
            change z * ((s₀ ^ k : ↥V) : K) = (c : K)
            rw [← hbcK, ← mul_assoc, mul_inv_cancel₀ hz0, one_mul]
      · intro x₁ x₂ h
        exact ⟨⟨1, 0, pow_zero s₀⟩, by simp [Subtype.ext h]⟩
    exact ⟨s₀, hs₀, hLocV⟩
  obtain ⟨s₀, hs₀, hLocV⟩ := hPart1
  
  have hPart2 : ∀ (C : AlgebraicGeometry.Scheme.{u})
      (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
      (τ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C))
      (ι : C_K ⟶ C),
      IsValuationPointedCurveModel V p_K n σ_K C g τ ι →
      IsSchemeFunctionField C F (η_F ≫ ι) := by
    intro C g τ ι hMod U hU hUne
    rcases hMod with ⟨hIntC, _hFlat, _hProp, _hLFP, _hSurj, _hProj, _hSec, hPb, _hSecComm⟩
    letI : Algebra ↥V K := V.subtype.toAlgebra
    haveI : IsLocalization.Away s₀ K := hLocV
    haveI : AlgebraicGeometry.IsIntegral C_K := hIntCK
    haveI : AlgebraicGeometry.IsIntegral C := hIntC
    let η_V : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of ↥V) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)
    haveI hOpen_ηV : AlgebraicGeometry.IsOpenImmersion η_V :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization (R := ↥V) (S := K) s₀
    haveI hOpen_ι : AlgebraicGeometry.IsOpenImmersion ι :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (P := @AlgebraicGeometry.IsOpenImmersion) hPb.flip hOpen_ηV
    have hRange_ηV : Set.range η_V.base =
        (PrimeSpectrum.basicOpen s₀ : Set (PrimeSpectrum ↥V)) :=
      PrimeSpectrum.localization_away_comap_range (R := ↥V) K s₀
    have hRange_ι : Set.range ι.base =
        g.base ⁻¹' (PrimeSpectrum.basicOpen s₀ : Set (PrimeSpectrum ↥V)) := by
      have hcomp : hPb.isoPullback.hom ≫ CategoryTheory.Limits.pullback.fst g η_V = ι :=
        hPb.isoPullback_hom_fst
      have hsurj : Function.Surjective hPb.isoPullback.hom.base :=
        (TopCat.homeoOfIso
          (AlgebraicGeometry.Scheme.forgetToTop.mapIso hPb.isoPullback)).surjective
      calc Set.range ι.base
          = Set.range ((hPb.isoPullback.hom ≫ CategoryTheory.Limits.pullback.fst g η_V).base) := by
              rw [hcomp]
        _ = Set.range ((CategoryTheory.Limits.pullback.fst g η_V).base ∘
              hPb.isoPullback.hom.base) := rfl
        _ = Set.range (CategoryTheory.Limits.pullback.fst g η_V).base :=
              hsurj.range_comp (CategoryTheory.Limits.pullback.fst g η_V).base
        _ = g.base ⁻¹' Set.range η_V.base := AlgebraicGeometry.Scheme.Pullback.range_fst g η_V
        _ = g.base ⁻¹' (PrimeSpectrum.basicOpen s₀ : Set (PrimeSpectrum ↥V)) := by rw [hRange_ηV]
    let α : CommRingCat.of ↥V ⟶ C.presheaf.obj (Opposite.op U) :=
      AlgebraicGeometry.Spec.preimage (hU.fromSpec ≫ g)
    have hα : AlgebraicGeometry.Spec.map α = hU.fromSpec ≫ g :=
      AlgebraicGeometry.Spec.map_preimage (hU.fromSpec ≫ g)
    let a₀ : ↑(C.presheaf.obj (Opposite.op U)) := α.hom s₀
    let W : C.Opens := C.basicOpen a₀
    have hWU_le : W ≤ U := C.basicOpen_le a₀
    have hW_set : (W : Set C) = (U : Set C) ∩ Set.range ι.base := by
      ext z
      constructor
      · intro hzW
        have hzU : z ∈ U := hWU_le hzW
        refine ⟨hzU, ?_⟩
        have hz_range : z ∈ Set.range hU.fromSpec.base := by
          rw [hU.range_fromSpec]; exact hzU
        obtain ⟨q, rfl⟩ := hz_range
        have hqW : q ∈ (TopologicalSpace.Opens.map hU.fromSpec.base).obj W := hzW
        rw [hU.fromSpec_preimage_basicOpen a₀] at hqW
        have hq_pre : q ∈ (TopologicalSpace.Opens.map (AlgebraicGeometry.Spec.map α).base).obj
            (PrimeSpectrum.basicOpen s₀) := by
          rw [AlgebraicGeometry.SpecMap_preimage_basicOpen α s₀]; exact hqW
        rw [hα] at hq_pre
        rw [hRange_ι]
        exact hq_pre
      · rintro ⟨hzU, hzRange⟩
        have hz_range : z ∈ Set.range hU.fromSpec.base := by
          rw [hU.range_fromSpec]; exact hzU
        obtain ⟨q, rfl⟩ := hz_range
        rw [hRange_ι] at hzRange
        have hq_pre : q ∈ (TopologicalSpace.Opens.map (AlgebraicGeometry.Spec.map α).base).obj
            (PrimeSpectrum.basicOpen s₀) := by
          rw [hα]; exact hzRange
        rw [AlgebraicGeometry.SpecMap_preimage_basicOpen α s₀] at hq_pre
        have hqW : q ∈ (TopologicalSpace.Opens.map hU.fromSpec.base).obj W := by
          rw [hU.fromSpec_preimage_basicOpen a₀]; exact hq_pre
        exact hqW
    have hIrredCK : IrreducibleSpace ↥C_K := AlgebraicGeometry.irreducibleSpace_of_isIntegral C_K
    have hIrredC : IrreducibleSpace ↥C := AlgebraicGeometry.irreducibleSpace_of_isIntegral C
