              rw [zpow_sub₀ hS_ne, norm_div, norm_div]
              have hcj_pos : 0 < ‖c j‖ := norm_pos_iff.mpr hcj
              have hSk_pos : 0 < ‖S ^ k‖ := norm_pos_iff.mpr (zpow_ne_zero k hS_ne)
