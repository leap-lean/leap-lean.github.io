        have he_max_ne : e_lift i_max ≠ 0 := by
          intro h0
          have hlt1 := he_lift i_max hi_max
          rw [hβ_max, h0, Subfield.coe_zero, sub_zero, norm_one] at hlt1
          linarith
        let x_alg : ↥L1_coeff := ∑ i ∈ S, e_lift i • fam i
        have hx_alg_ne : x_alg ≠ 0 := by
          intro hx0
          have hzero_all := (linearIndependent_iff'.mp hLI_fam) S e_lift hx0
