      rw [AlgebraicGeometry.Spec.preimage_map] at h_pre
      ext c
      have hc := congrArg (fun f => f.hom c) h_pre
      exact hc.trans (hφ_V c).symm
    exact @hChartValFin s.asIdeal s.2 B_i _ α_i hFT_α ψ_hom.hom hSpec_pair.1 hComm_i
  let S_cand : Set (ValuationSubring F_ss) :=
    {W : ValuationSubring F_ss |
      IsDivisorialClosedVal V g_ss η_ss W ∧ IsValResolvedOnMod V g_ss h_mod η_U' W}
  have hCand_fin : S_cand.Finite := by
    refine Set.Finite.subset
      (hs'_fin.biUnion fun i hi => hFinSpec.biUnion fun s _ => hChart_fin i hi s) ?_
    rintro W ⟨_, ⟨ψ_U', mW, U, hU, φ_U, f, hmW, hηW, hyU, hφU, hPoly⟩⟩
    have hy_mem : ψ_U'.base mW ∈
        (((⨆ i ∈ s₀, (i : U'.toScheme.Opens)) : U'.toScheme.Opens) : Set ↥U'.toScheme) := by
      rw [← hs₀_cov]
      trivial
    simp only [TopologicalSpace.Opens.coe_iSup, Set.mem_iUnion] at hy_mem
    obtain ⟨i, hi_s₀, hyi⟩ := hy_mem
    have hne_i : Nonempty ↥i.1 := ⟨⟨ψ_U'.base mW, hyi⟩⟩
    have hi_s' : i ∈ s' := ⟨hi_s₀, hne_i⟩
    let s : PrimeSpectrum ↥V := g_ss.base ((ψ_U' ≫ h_mod).base mW)
    have hRange_open : ∀ (O : U'.toScheme.Opens), ψ_U'.base mW ∈ O →
        Set.range ψ_U'.base ⊆ (O : Set ↥U'.toScheme) := by
      rintro O hyO _ ⟨z, rfl⟩
      have hz_le : z.asIdeal ≤ mW.asIdeal := by
        rw [hmW]
        exact IsLocalRing.le_maximalIdeal z.2.ne_top
      have hz_spec : (z : PrimeSpectrum ↥W) ⤳ (mW : PrimeSpectrum ↥W) :=
        (PrimeSpectrum.le_iff_specializes z mW).mp ((PrimeSpectrum.asIdeal_le_asIdeal z mW).mp hz_le)
      exact hz_spec.mem_open (O.isOpen.preimage ψ_U'.base.hom.continuous) hyO
    have hUi : AlgebraicGeometry.IsAffineOpen i.1 := i.2
    have hRange_i : Set.range ψ_U'.base ⊆ Set.range hUi.fromSpec.base := by
      have h_eq : Set.range hUi.fromSpec.base = (i.1 : Set ↥U'.toScheme) :=
        congrArg SetLike.coe hUi.opensRange_fromSpec
      rw [h_eq]
      exact hRange_open i.1 hyi
    let lift_i := AlgebraicGeometry.IsOpenImmersion.lift hUi.fromSpec ψ_U' hRange_i
    have hlift_i : lift_i ≫ hUi.fromSpec = ψ_U' :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac hUi.fromSpec ψ_U' hRange_i
    let φ_i := AlgebraicGeometry.Spec.preimage lift_i
    let φ_B := φ_i.hom
    have hSpec_φi : AlgebraicGeometry.Spec.map φ_i ≫ hUi.fromSpec = ψ_U' := by
      rw [AlgebraicGeometry.Spec.map_preimage, hlift_i]
    let ψ_hom := (hFunc_U' i.1 i.2 hne_i).choose
    have hSpec_ψ : AlgebraicGeometry.Spec.map ψ_hom ≫ hUi.fromSpec = η_U' :=
      (hFunc_U' i.1 i.2 hne_i).choose_spec.2
    have hφB_ψ : W.subtype.comp φ_B = ψ_hom.hom := by
      have h_cancel : AlgebraicGeometry.Spec.map (φ_i ≫ CommRingCat.ofHom W.subtype) =
          AlgebraicGeometry.Spec.map ψ_hom := by
        apply (cancel_mono hUi.fromSpec).mp
        rw [AlgebraicGeometry.Spec.map_comp, Category.assoc, hSpec_φi, hηW, hSpec_ψ]
      exact congrArg CommRingCat.Hom.hom (AlgebraicGeometry.Spec.map_injective h_cancel)
    let m_i := hUi.fromSpec ≫ U'.ι ≫ g'
    let α_i := (AlgebraicGeometry.Spec.preimage m_i).hom
    have h_pre_ss : AlgebraicGeometry.Spec.preimage (ψ_U' ≫ h_mod ≫ g_ss) =
        AlgebraicGeometry.Spec.preimage m_i ≫ φ_i := by
      have h_eq : ψ_U' ≫ h_mod ≫ g_ss =
          AlgebraicGeometry.Spec.map (AlgebraicGeometry.Spec.preimage m_i ≫ φ_i) := by
        calc ψ_U' ≫ h_mod ≫ g_ss
            = ψ_U' ≫ (U'.ι ≫ g') := by rw [hComm_mod]
          _ = (AlgebraicGeometry.Spec.map φ_i ≫ hUi.fromSpec) ≫ (U'.ι ≫ g') := by rw [hSpec_φi]
          _ = AlgebraicGeometry.Spec.map φ_i ≫ m_i := by simp [m_i, Category.assoc]
          _ = AlgebraicGeometry.Spec.map φ_i ≫ AlgebraicGeometry.Spec.map (AlgebraicGeometry.Spec.preimage m_i) :=
              congrArg (AlgebraicGeometry.Spec.map φ_i ≫ ·) (AlgebraicGeometry.Spec.map_preimage m_i).symm
          _ = AlgebraicGeometry.Spec.map (AlgebraicGeometry.Spec.preimage m_i ≫ φ_i) :=
              (AlgebraicGeometry.Spec.map_comp _ _).symm
      rw [h_eq, AlgebraicGeometry.Spec.preimage_map]
    have hP_center : ∀ c : ↥V, φ_B (α_i c) ∈ IsLocalRing.maximalIdeal ↥W ↔ c ∈ s.asIdeal := by
      intro c
      rw [← hmW]
      have h_spec_eq : ψ_U' ≫ h_mod ≫ g_ss =
          AlgebraicGeometry.Spec.map (AlgebraicGeometry.Spec.preimage m_i ≫ φ_i) := by
        rw [← h_pre_ss, AlgebraicGeometry.Spec.map_preimage]
      have h_pt : ((ψ_U' ≫ h_mod ≫ g_ss).base mW).asIdeal = s.asIdeal := rfl
      rw [← h_pt, h_spec_eq]
      rfl
    obtain ⟨b₀, hV₀_le, hy₀⟩ :=
      hUi.exists_basicOpen_le (V := U ⊓ i.1) ⟨ψ_U'.base mW, ⟨hyU, hyi⟩⟩ hyi
    let V₀ : U'.toScheme.Opens := U'.toScheme.basicOpen b₀
    have hV₀ : AlgebraicGeometry.IsAffineOpen V₀ := hUi.basicOpen b₀
    have hRange_V₀ : Set.range ψ_U'.base ⊆ Set.range hV₀.fromSpec.base := by
      have h_eq : Set.range hV₀.fromSpec.base = (V₀ : Set ↥U'.toScheme) :=
        congrArg SetLike.coe hV₀.opensRange_fromSpec
      rw [h_eq]
      exact hRange_open V₀ hy₀
    let lift_V₀ := AlgebraicGeometry.IsOpenImmersion.lift hV₀.fromSpec ψ_U' hRange_V₀
    let φ_V₀ := AlgebraicGeometry.Spec.preimage lift_V₀
    have hSpec_φV₀ : AlgebraicGeometry.Spec.map φ_V₀ ≫ hV₀.fromSpec = ψ_U' := by
      rw [AlgebraicGeometry.Spec.map_preimage,
        AlgebraicGeometry.IsOpenImmersion.lift_fac hV₀.fromSpec ψ_U' hRange_V₀]
    let res_U := U'.toScheme.presheaf.map (homOfLE (hV₀_le.trans inf_le_left)).op
    let res_i := U'.toScheme.presheaf.map (homOfLE (U'.toScheme.basicOpen_le b₀)).op
    have hφV₀_U : res_U ≫ φ_V₀ = φ_U := by
      apply AlgebraicGeometry.Spec.map_injective
      apply (cancel_mono hU.fromSpec).mp
      rw [AlgebraicGeometry.Spec.map_comp, Category.assoc,
        hU.map_fromSpec hV₀ (homOfLE (hV₀_le.trans inf_le_left)).op, hSpec_φV₀, hφU]
    have hφV₀_i : res_i ≫ φ_V₀ = φ_i := by
      apply AlgebraicGeometry.Spec.map_injective
      apply (cancel_mono hUi.fromSpec).mp
      rw [AlgebraicGeometry.Spec.map_comp, Category.assoc,
        hUi.map_fromSpec hV₀ (homOfLE (U'.toScheme.basicOpen_le b₀)).op, hSpec_φV₀, hSpec_φi]
    letI alg_Bi_V₀ : Algebra ↑(U'.toScheme.presheaf.obj (Opposite.op i.1))
        ↑(U'.toScheme.presheaf.obj (Opposite.op V₀)) := res_i.hom.toAlgebra
    have hLoc_b₀ : @IsLocalization.Away ↑(U'.toScheme.presheaf.obj (Opposite.op i.1)) _ b₀
        ↑(U'.toScheme.presheaf.obj (Opposite.op V₀)) _ alg_Bi_V₀ := hUi.isLocalization_basicOpen b₀
    have hu_b₀ : IsUnit (φ_B b₀) := by
      have hu_V₀ : IsUnit (res_i.hom b₀) :=
        @IsLocalization.map_units _ _ (Submonoid.powers b₀) _ _ alg_Bi_V₀ hLoc_b₀
          ⟨b₀, Submonoid.mem_powers b₀⟩
      have h_eq : φ_V₀.hom (res_i.hom b₀) = φ_B b₀ := congrArg (fun g => g.hom b₀) hφV₀_i
      exact h_eq ▸ hu_V₀.map φ_V₀.hom
    obtain ⟨⟨b₁, ⟨_, r, rfl⟩⟩, hb₁_eq⟩ :=
      @IsLocalization.surj _ _ (Submonoid.powers b₀) _ _ alg_Bi_V₀ hLoc_b₀ (res_U.hom f)
    let b₂ := b₀ ^ r
    have hmul_fb₂ : φ_U.hom f * φ_B b₂ = φ_B b₁ := by
      have h_ap := congrArg φ_V₀.hom hb₁_eq
      have hf_eq : φ_V₀.hom (res_U.hom f) = φ_U.hom f := congrArg (fun g => g.hom f) hφV₀_U
      have hb₂_eq : φ_V₀.hom (res_i.hom b₂) = φ_B b₂ := congrArg (fun g => g.hom b₂) hφV₀_i
      have hb₁_eq' : φ_V₀.hom (res_i.hom b₁) = φ_B b₁ := congrArg (fun g => g.hom b₁) hφV₀_i
      change φ_V₀.hom (res_U.hom f * res_i.hom b₂) = φ_V₀.hom (res_i.hom b₁) at h_ap
      rw [map_mul, hf_eq, hb₂_eq, hb₁_eq'] at h_ap
      exact h_ap
    have hu_b₂ : IsUnit (φ_B b₂) := by
      change IsUnit (φ_B (b₀ ^ r))
      rw [map_pow]
      exact hu_b₀.pow r
    refine Set.mem_biUnion hi_s' (Set.mem_biUnion (Set.mem_univ s) ?_)
    have hS_eq : S_chart_i i s =
        (let B_i := ↑(U'.toScheme.presheaf.obj (Opposite.op i.1))
         let α_i : ↥V →+* B_i := (AlgebraicGeometry.Spec.preimage (i.2.fromSpec ≫ U'.ι ≫ g')).hom
         let ψ_i : B_i →+* F_ss := (hFunc_U' i.1 i.2 hne_i).choose.hom
         {W : ValuationSubring F_ss |
           ∃ (φ_B : B_i →+* ↥W) (b₁ b₂ : B_i),
             W.subtype.comp φ_B = ψ_i ∧
             (∀ c : ↥V, φ_B (α_i c) ∈ IsLocalRing.maximalIdeal ↥W ↔ c ∈ s.asIdeal) ∧
             φ_B b₂ ∉ IsLocalRing.maximalIdeal ↥W ∧
             (∀ Q : Polynomial ↥V,
               (∃ k : ℕ, Q.coeff k ∉ s.asIdeal) →
               (∑ k ∈ Finset.range (Q.natDegree + 1),
                 φ_B (α_i (Q.coeff k) * b₁ ^ k * b₂ ^ (Q.natDegree - k))) ∉
                   IsLocalRing.maximalIdeal ↥W)}) := dite_cond_eq_true (eq_true hne_i)
    rw [hS_eq]
    refine ⟨φ_B, b₁, b₂, hφB_ψ, hP_center, IsLocalRing.notMem_maximalIdeal.mpr hu_b₂, ?_⟩
    intro Q hQ
    let d := Q.natDegree
    have h_sum_eq : (∑ k ∈ Finset.range (d + 1),
          φ_B (α_i (Q.coeff k) * b₁ ^ k * b₂ ^ (d - k))) =
        (φ_B b₂) ^ d * Polynomial.eval₂
          (AlgebraicGeometry.Spec.preimage (ψ_U' ≫ h_mod ≫ g_ss)).hom (φ_U.hom f) Q := by
      rw [Polynomial.eval₂_eq_sum_range, Finset.mul_sum]
      refine Finset.sum_congr rfl fun k hk => ?_
      have hk_le : k ≤ d := Nat.lt_succ_iff.mp (Finset.mem_range.mp hk)
      have h_pow : (φ_B b₂) ^ d = (φ_B b₂) ^ k * (φ_B b₂) ^ (d - k) := by
        rw [← pow_add, Nat.add_sub_of_le hk_le]
      have hc_eq : (AlgebraicGeometry.Spec.preimage (ψ_U' ≫ h_mod ≫ g_ss)).hom (Q.coeff k) =
          φ_B (α_i (Q.coeff k)) := congrArg (fun g => g.hom (Q.coeff k)) h_pre_ss
      rw [hc_eq, map_mul, map_mul, map_pow, map_pow, ← hmul_fb₂, mul_pow, h_pow]
      ring
    intro h_mem
    rw [h_sum_eq] at h_mem
    obtain ⟨u_d, hu_d⟩ := hu_b₂.pow d
    have h_eval_mem : Polynomial.eval₂
        (AlgebraicGeometry.Spec.preimage (ψ_U' ≫ h_mod ≫ g_ss)).hom (φ_U.hom f) Q ∈
        IsLocalRing.maximalIdeal ↥W := by
      have h1 := Ideal.mul_mem_left _ (u_d.inv) h_mem
      have h2 : u_d.inv * ((φ_B b₂) ^ d * Polynomial.eval₂
          (AlgebraicGeometry.Spec.preimage (ψ_U' ≫ h_mod ≫ g_ss)).hom (φ_U.hom f) Q) =
          Polynomial.eval₂
            (AlgebraicGeometry.Spec.preimage (ψ_U' ≫ h_mod ≫ g_ss)).hom (φ_U.hom f) Q := by
        rw [← mul_assoc, ← hu_d, u_d.inv_val, one_mul]
      rwa [h2] at h1
    exact hPoly Q hQ h_eval_mem
  classical
  let F_cand := hCand_fin.toFinset
  let r_val := F_cand.card
  let e_cand : Fin r_val ≃ ↥F_cand := (Finset.equivFin F_cand).symm
  let W_list : Fin r_val → ValuationSubring F_ss := fun i => (e_cand i).1
  refine ⟨η_UK, φ_KF, r_val, W_list, hUK_ne, hηUK_ss, hFunc_UK, hFunc_U', hφ_V, hAlg, ?_, ?_⟩
  · intro i
    exact (hCand_fin.mem_toFinset.mp (e_cand i).2).1
  · intro W hDiv hRes
    have hw : W ∈ F_cand := hCand_fin.mem_toFinset.mpr ⟨hDiv, hRes⟩
    refine ⟨e_cand.symm ⟨W, hw⟩, ?_⟩
    simp [W_list]

theorem weil_valuation_overring_dichotomy_and_vandermonde_avoidance (K : Type u) [Field K]
    (V : ValuationSubring K) :
    (∀ (P : Ideal ↥V) [P.IsPrime],
      IsAlgClosed P.ResidueField →
      ∀ (B : Type u) [CommRing B] (p : Ideal B) [p.IsPrime] (γ_B : ↥V →+* B),
        Ideal.comap γ_B p = P →
        (∃ (b₁ b₂ : B),
          b₂ ∉ p ∧
          ∀ (R : Type u) [CommRing R] [IsLocalRing R] (ρ_B : B →+* R),
            Ideal.comap ρ_B (IsLocalRing.maximalIdeal R) = p →
            ∀ (t : R),
              ρ_B b₂ * t = ρ_B b₁ →
              ∀ (Q : Polynomial ↥V),
                (∃ i : ℕ, Q.coeff i ∉ P) →
                Polynomial.eval₂ (ρ_B.comp γ_B) t Q ∉ IsLocalRing.maximalIdeal R) ∨
        (∃ (hVal : ValuationRing (B ⧸ p)),
          letI : ValuationRing (B ⧸ p) := hVal
          let γ_D : ↥V →+* B ⧸ p := (Ideal.Quotient.mk p).comp γ_B
          let P₀ : Ideal ↥V := Ideal.comap γ_D (IsLocalRing.maximalIdeal (B ⧸ p))
          P ≤ P₀ ∧
          (∀ d : B ⧸ p, (∃ q : ↥V, d = γ_D q) ∨ (∃ q : ↥V, q ∉ P₀ ∧ γ_D q * d = 1)) ∧
          (IsAlgClosed P₀.ResidueField → IsAlgClosed (IsLocalRing.ResidueField (B ⧸ p))))) ∧
    (∀ (P : Ideal ↥V) [P.IsPrime]
       (D : Type u) [CommRing D] [IsDomain D] (γ_D : ↥V →+* D),
      RingHom.ker γ_D = P →
      (∀ d : D, (∃ q : ↥V, d = γ_D q) ∨ (∃ q : ↥V, q ∉ P ∧ γ_D q * d = 1)) →
      ∀ (L : Type u) [Field L] (ι_DL : D →+* L) (t_L : L),
        (∀ Q : Polynomial ↥V,
          (∃ i : ℕ, Q.coeff i ∉ P) →
          Polynomial.eval₂ (ι_DL.comp γ_D) t_L Q ≠ 0) →
        ∀ Q_D : Polynomial D, Q_D ≠ 0 → Polynomial.eval₂ ι_DL t_L Q_D ≠ 0) ∧
    (∀ (P₀ : Ideal ↥V) [P₀.IsPrime],
      IsAlgClosed P₀.ResidueField →
      ∀ (M N : ℕ) (Q : Fin N → Ideal (MvPolynomial (Fin (M + 1)) ↥V)),
        (∀ r : Fin N,
          (Q r).IsPrime ∧
          Ideal.comap MvPolynomial.C (Q r) = P₀ ∧
          (∃ i : Fin (M + 1), MvPolynomial.X i ∉ Q r)) →
        ∃ α : ↥V,
          (∑ i : Fin (M + 1), MvPolynomial.C (α ^ i.1) * MvPolynomial.X i) ∈
            MvPolynomial.homogeneousSubmodule (Fin (M + 1)) ↥V 1 ∧
          ∀ r : Fin N,
            (∑ i : Fin (M + 1), MvPolynomial.C (α ^ i.1) * MvPolynomial.X i) ∉ Q r) :=
by
  refine ⟨?_, ?_, ?_⟩
  · 
    intro P _ hAlgP B _ p _ γ_B hcomap
    have : IsDomain (B ⧸ p) := Ideal.Quotient.isDomain p
    have : IsDomain (↥V ⧸ P) := Ideal.Quotient.isDomain P
    let γ_D : ↥V →+* B ⧸ p := (Ideal.Quotient.mk p).comp γ_B
    have hker_γD : ∀ c : ↥V, γ_D c = 0 ↔ c ∈ P := by
      intro c
      change Ideal.Quotient.mk p (γ_B c) = 0 ↔ c ∈ P
      rw [Ideal.Quotient.eq_zero_iff_mem, ← hcomap, Ideal.mem_comap]
    let ι_VD : (↥V ⧸ P) →+* B ⧸ p :=
      Ideal.Quotient.lift P γ_D (fun c hc => (hker_γD c).mpr hc)
    have hInj_VD : Function.Injective ι_VD := by
      rw [injective_iff_map_eq_zero]
      intro u hu
      obtain ⟨c, rfl⟩ := Ideal.Quotient.mk_surjective u
      exact Ideal.Quotient.eq_zero_iff_mem.mpr ((hker_γD c).mp hu)
    let F_D := FractionRing (B ⧸ p)
    let g_VF : (↥V ⧸ P) →+* F_D := (algebraMap (B ⧸ p) F_D).comp ι_VD
    have hg_VF : Function.Injective g_VF :=
      (IsFractionRing.injective (B ⧸ p) F_D).comp hInj_VD
    let σ_P : P.ResidueField →+* F_D :=
      @IsFractionRing.lift (↥V ⧸ P) _ P.ResidueField _ F_D _ _
        (instIsFractionRingQuotientIdealResidueField P) g_VF hg_VF
    let φ_VP : ↥V →+* P.ResidueField :=
      (algebraMap (↥V ⧸ P) P.ResidueField).comp (Ideal.Quotient.mk P)
    have hσ_φ : ∀ c : ↥V, σ_P (φ_VP c) = algebraMap (B ⧸ p) F_D (γ_D c) := by
      intro c
      change (@IsFractionRing.lift (↥V ⧸ P) _ P.ResidueField _ F_D _ _
        (instIsFractionRingQuotientIdealResidueField P) g_VF hg_VF)
          (algebraMap (↥V ⧸ P) P.ResidueField (Ideal.Quotient.mk P c)) = _
      rw [@IsFractionRing.lift_algebraMap (↥V ⧸ P) _ P.ResidueField _ F_D _ _
        (instIsFractionRingQuotientIdealResidueField P) g_VF hg_VF]
      rfl
    have hφ_VP_zero : ∀ c : ↥V, φ_VP c = 0 ↔ c ∈ P := by
      intro c
      change algebraMap (↥V ⧸ P) P.ResidueField (Ideal.Quotient.mk P c) = 0 ↔ c ∈ P
      have hInj_VP : Function.Injective (algebraMap (↥V ⧸ P) P.ResidueField) :=
        @IsFractionRing.injective (↥V ⧸ P) _ P.ResidueField _ _
          (instIsFractionRingQuotientIdealResidueField P)
      rw [← map_zero (algebraMap (↥V ⧸ P) P.ResidueField), hInj_VP.eq_iff,
        Ideal.Quotient.eq_zero_iff_mem]
    let : Algebra P.ResidueField F_D := σ_P.toAlgebra
    by_cases hAlgFD : Algebra.IsAlgebraic P.ResidueField F_D
    · 
      right
      have : IsAlgClosed P.ResidueField := hAlgP
      have : Algebra.IsAlgebraic P.ResidueField F_D := hAlgFD
      have : Algebra.IsIntegral P.ResidueField F_D := Algebra.IsAlgebraic.isIntegral
      have hBij_σ : Function.Bijective σ_P :=
        IsAlgClosed.algebraMap_bijective_of_isIntegral (k := P.ResidueField) (K := F_D)
      have hRatio : ∀ d : B ⧸ p, d ≠ 0 → ∃ a b : ↥V, a ∉ P ∧ b ∉ P ∧ γ_D b * d = γ_D a := by
        intro d hd
        obtain ⟨z, hz⟩ := hBij_σ.2 (algebraMap (B ⧸ p) F_D d)
        obtain ⟨u, v, hv_nzd, huv⟩ :=
          @IsFractionRing.div_surjective (↥V ⧸ P) _ P.ResidueField _ _
            (instIsFractionRingQuotientIdealResidueField P) z
        have hv_ne : v ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hv_nzd
        obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective u
        obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective v
        have hb_not_P : b ∉ P := fun hbP => hv_ne (Ideal.Quotient.eq_zero_iff_mem.mpr hbP)
        have hφb_ne : φ_VP b ≠ 0 := fun h0 => hb_not_P ((hφ_VP_zero b).mp h0)
        have hbz : φ_VP b * z = φ_VP a := by
          have hdiv : φ_VP a / φ_VP b = z := huv
          rw [← hdiv, mul_div_cancel₀ _ hφb_ne]
        have hFD_eq : algebraMap (B ⧸ p) F_D (γ_D b * d) = algebraMap (B ⧸ p) F_D (γ_D a) := by
          rw [map_mul, ← hσ_φ b, ← hσ_φ a, ← hz, ← map_mul σ_P, hbz]
        have hbd : γ_D b * d = γ_D a := IsFractionRing.injective (B ⧸ p) F_D hFD_eq
        have hγb_ne : γ_D b ≠ 0 := fun h0 => hb_not_P ((hker_γD b).mp h0)
        have hγa_ne : γ_D a ≠ 0 := hbd ▸ mul_ne_zero hγb_ne hd
        have ha_not_P : a ∉ P := fun haP => hγa_ne ((hker_γD a).mpr haP)
        exact ⟨a, b, ha_not_P, hb_not_P, hbd⟩
      have hVal : ValuationRing (B ⧸ p) := by
        rw [ValuationRing.iff_dvd_total]
        refine ⟨fun x y => ?_⟩
        by_cases hx : x = 0
        · exact Or.inr (hx ▸ dvd_zero y)
        by_cases hy : y = 0
        · exact Or.inl (hy ▸ dvd_zero x)
        obtain ⟨a₁, b₁, ha₁, hb₁, hxb₁⟩ := hRatio x hx
        obtain ⟨a₂, b₂, ha₂, hb₂, hyb₂⟩ := hRatio y hy
        have hcross : γ_D (b₁ * a₂) * x = γ_D (a₁ * b₂) * y := by
          calc
            γ_D (b₁ * a₂) * x = (γ_D b₁ * x) * γ_D a₂ := by rw [map_mul]; ring
            _ = γ_D a₁ * γ_D a₂ := by rw [hxb₁]
            _ = γ_D a₁ * (γ_D b₂ * y) := by rw [hyb₂]
            _ = γ_D (a₁ * b₂) * y := by rw [map_mul]; ring
        rcases ValuationRing.dvd_total (b₁ * a₂) (a₁ * b₂) with ⟨q, hq⟩ | ⟨q, hq⟩
        · right
          have hb₁a₂_not_P : b₁ * a₂ ∉ P := P.primeCompl.mul_mem hb₁ ha₂
          have hγ_ne : γ_D (b₁ * a₂) ≠ 0 := fun h0 => hb₁a₂_not_P ((hker_γD _).mp h0)
