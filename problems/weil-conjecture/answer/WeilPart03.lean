    haveI : pbar0.IsPrime := hpbar0_prime
    have hpbar0_max : pbar0.IsMaximal := IsArtinianRing.isMaximal_of_isPrime pbar0
    have hr0_sub_not_pbar0 : π r0_sub ∉ pbar0 := fun h => hr0_sub_not_p₀ (hpbar0_comap ▸ h)
