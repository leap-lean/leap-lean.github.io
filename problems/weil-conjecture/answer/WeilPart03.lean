      ψ w = LaurentPolynomial.T 1 →
      (∀ P : Polynomial R, ∃ x : A_nod, ψ x = Polynomial.toLaurent P) →
      IsIntegrallyClosed (Localization (Submonoid.powers w)) := by
    intro w ψ hInj_ψ hψ_w hPoly_ψ
