            have h1 := h_poly_nz g₁ hg₁
            have h2 := h_poly_nz g₂ hg₂
            simp only [Subfield.coe_add, hu₁, hu₂, map_add, map_mul]
            field_simp
          change (φ₀_fun (u₁ + u₂) : F_hat) = (φ₀_fun u₁ : F_hat) + (φ₀_fun u₂ : F_hat)
          rw [hφ₀_spec (u₁ + u₂) (f₁ * g₂ + f₂ * g₁) (g₁ * g₂) (mul_ne_zero hg₁ hg₂) hadd,
            hφ₀_spec u₁ f₁ g₁ hg₁ hu₁, hφ₀_spec u₂ f₂ g₂ hg₂ hu₂]
          have h1' := h_poly_nz' g₁ hg₁
          have h2' := h_poly_nz' g₂ hg₂
          simp only [map_add, map_mul]
          field_simp }
    have hφ₀_err : ∀ u : ↥Kz, ‖(u : F_hat) - (φ₀ u : F_hat)‖ ≤ θ * ‖(u : F_hat)‖ := by
      intro u
      obtain ⟨⟨f, g⟩, hg, hu⟩ := h_rep_z u
