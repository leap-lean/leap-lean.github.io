          rwa [hnum_eq] at h1
        have h1 : HomogeneousLocalization.mk t_c ∉ ξ.asIdeal ↔ MvPolynomial.C c ∉ Q r := by
          calc HomogeneousLocalization.mk t_c ∉ ξ.asIdeal
            _ ↔ ξ ∈ PrimeSpectrum.basicOpen (HomogeneousLocalization.mk t_c) :=
              (PrimeSpectrum.mem_basicOpen _ _).symm
            _ ↔ p_pt r ∈ ProjectiveSpectrum.basicOpen 𝒜 (MvPolynomial.C c) := hmem_iff
            _ ↔ MvPolynomial.C c ∉ Q r := ProjectiveSpectrum.mem_basicOpen 𝒜 _ _
        exact not_iff_not.mp h1.symm
      exact ⟨hQr_prime, hcomap_C, i_r, hXi_not⟩
    obtain ⟨α, hL_mem, hL_avoid⟩ := hVand N Q hQ_props
    let L_form : MvPolynomial (Fin (M + 1)) ↥V :=
      ∑ i : Fin (M + 1), MvPolynomial.C (α ^ i.1) * MvPolynomial.X i
    let W_L : (weilProjectiveSpaceOver ↥V M).left.Opens :=
      AlgebraicGeometry.Proj.basicOpen 𝒜 L_form
    have hAff_WL : AlgebraicGeometry.IsAffineOpen W_L :=
      AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜 L_form hL_mem Nat.zero_lt_one
    let U_L : Z.Opens := (TopologicalSpace.Opens.map q_P.base).obj W_L
    have hAff_UL : AlgebraicGeometry.IsAffineOpen U_L := hAff_WL.preimage q_P
    have hF0_sub : ∀ z : Z, π_Z.base z = m_D → z ∈ U_L := by
      intro z hz
      let r : Fin N := e_fin ⟨z, hz⟩
      have hz_eq : z_pt r = z := by
        change (e_fin.symm (e_fin ⟨z, hz⟩)).1 = z
        rw [Equiv.symm_apply_apply]
      have hnot : L_form ∉ (q_P.base z).asHomogeneousIdeal.toIdeal := by
        rw [← hz_eq]
        exact hL_avoid r
      exact (AlgebraicGeometry.Proj.mem_basicOpen 𝒜 L_form (q_P.base z)).mpr hnot
    have hUL_top : U_L = ⊤ := by
      ext z_bad
      refine ⟨fun _ => trivial, fun _ => ?_⟩
      by_contra hz_bad
      let C_bad : Set Z := (U_L : Set Z)ᶜ
      have hClosed_C : IsClosed C_bad := U_L.isOpen.isClosed_compl
      have hClosed_img : IsClosed (π_Z.base '' C_bad) :=
        (AlgebraicGeometry.Scheme.Hom.isClosedMap π_Z) C_bad hClosed_C
      let q_bad : AlgebraicGeometry.Spec (CommRingCat.of D_u) := π_Z.base z_bad
      have hq_mem : q_bad ∈ π_Z.base '' C_bad := ⟨z_bad, hz_bad, rfl⟩
      have hmD_cl : m_D ∈ closure ({q_bad} : Set ↥(AlgebraicGeometry.Spec (CommRingCat.of D_u))) := by
        let q_bad' : PrimeSpectrum D_u := q_bad
        let m_D' : PrimeSpectrum D_u := m_D
        change m_D' ∈ closure ({q_bad'} : Set (PrimeSpectrum D_u))
        rw [PrimeSpectrum.closure_singleton]
        change (q_bad.asIdeal : Set D_u) ⊆ (m_D.asIdeal : Set D_u)
        rw [hm_D]
        exact IsLocalRing.le_maximalIdeal q_bad.isPrime.ne_top
      have hmD_img : m_D ∈ π_Z.base '' C_bad :=
        closure_minimal (Set.singleton_subset_iff.mpr hq_mem) hClosed_img hmD_cl
      obtain ⟨z₀, hz₀_not, hz₀_mD⟩ := hmD_img
      exact hz₀_not (hF0_sub z₀ hz₀_mD)
    have hAff_top : AlgebraicGeometry.IsAffine (⊤ : Z.Opens).toScheme := by
      rw [← hUL_top]
      exact hAff_UL
    exact @AlgebraicGeometry.IsAffine.of_isIso Z (⊤ : Z.Opens).toScheme Z.topIso.inv _ hAff_top
  have : AlgebraicGeometry.IsAffine Z := hStep3
  
  let B_Z : Type u := ↑(Z.presheaf.obj (Opposite.op ⊤))
  have hStep4 : ∃ (ρ_L : B_Z →+* L_y) (b₁ b₂ : B_Z),
      ρ_L b₂ ≠ 0 ∧
      ρ_L b₂ * φ_UL f = ρ_L b₁ ∧
      (∀ W' : ValuationSubring L_y,
        (∀ d : D_u, ι_DL d ∈ W') →
        ∀ b : B_Z, ρ_L b ∈ W') := by
    let hAffZ : AlgebraicGeometry.IsAffineOpen (⊤ : Z.Opens) :=
      AlgebraicGeometry.isAffineOpen_top Z
    let ρ_cat : Z.presheaf.obj (Opposite.op ⊤) ⟶ CommRingCat.of L_y :=
      AlgebraicGeometry.Spec.preimage (e_Z ≫ Z.isoSpec.hom)
    let ρ_L : B_Z →+* L_y := ρ_cat.hom
    have hρ_spec : AlgebraicGeometry.Spec.map ρ_cat ≫ hAffZ.fromSpec = e_Z := by
      dsimp [ρ_cat, hAffZ]
      rw [AlgebraicGeometry.Spec.map_preimage, AlgebraicGeometry.IsAffineOpen.fromSpec_top,
        CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id,
        CategoryTheory.Category.comp_id]
    let bot_L : AlgebraicGeometry.Spec (CommRingCat.of L_y) := IsLocalRing.closedPoint L_y
    have hbotL_eq : bot_L.asIdeal = ⊥ := by
      have : bot_L.asIdeal.IsPrime := bot_L.isPrime
      exact Ideal.eq_bot_of_prime bot_L.asIdeal
    have hy_bot : (e_Z ≫ j_Z).base bot_L = y := by
      rw [he_jZ]
      have hmap_eq : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_UL)).base bot_L =
          hU.primeIdealOf ⟨y, hyU⟩ := by
        apply PrimeSpectrum.ext
        change Ideal.comap φ_UL bot_L.asIdeal = (hU.primeIdealOf ⟨y, hyU⟩).asIdeal
        rw [hbotL_eq]
        exact hker_φUL
      change hU.fromSpec.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_UL)).base bot_L) = y
      rw [hmap_eq]
      exact hU.fromSpec_primeIdealOf ⟨y, hyU⟩
    let z_L : Z := e_Z.base bot_L
    let U_Z : Z.Opens := (TopologicalSpace.Opens.map j_Z.base).obj U
    have hz_UZ : z_L ∈ U_Z := by
      change (e_Z ≫ j_Z).base bot_L ∈ U
      rw [hy_bot]
      exact hyU
    obtain ⟨g₀, hle_U, hz_g0⟩ :=
      hAffZ.exists_basicOpen_le (⟨z_L, hz_UZ⟩ : ↥U_Z) (trivial : z_L ∈ (⊤ : Z.Opens))
    have hρ_g0_ne : ρ_L g₀ ≠ 0 := by
      have hmem_pre : (AlgebraicGeometry.Spec.map ρ_cat).base bot_L ∈
          ((TopologicalSpace.Opens.map hAffZ.fromSpec.base).obj (Z.basicOpen g₀)) := by
        change hAffZ.fromSpec.base ((AlgebraicGeometry.Spec.map ρ_cat).base bot_L) ∈ Z.basicOpen g₀
        change (AlgebraicGeometry.Spec.map ρ_cat ≫ hAffZ.fromSpec).base bot_L ∈ Z.basicOpen g₀
        rw [hρ_spec]
        exact hz_g0
      rw [hAffZ.fromSpec_preimage_basicOpen g₀] at hmem_pre
      have hnot : g₀ ∉ ((AlgebraicGeometry.Spec.map ρ_cat).base bot_L).asIdeal :=
        (PrimeSpectrum.mem_basicOpen g₀ _).mp hmem_pre
      intro hzero
      apply hnot
      change g₀ ∈ Ideal.comap ρ_L bot_L.asIdeal
      rw [hbotL_eq]
      exact hzero
    let V_g0 : Z.Opens := Z.basicOpen g₀
    let res_top_g0 : B_Z →+* ↑(Z.presheaf.obj (Opposite.op V_g0)) :=
      (Z.presheaf.map (CategoryTheory.homOfLE (le_top : V_g0 ≤ ⊤)).op).hom
    let _ : Algebra B_Z ↑(Z.presheaf.obj (Opposite.op V_g0)) := res_top_g0.toAlgebra
    have : IsLocalization.Away g₀ ↑(Z.presheaf.obj (Opposite.op V_g0)) :=
      hAffZ.isLocalization_basicOpen g₀
    let f_g0 : ↑(Z.presheaf.obj (Opposite.op V_g0)) := (j_Z.appLE U V_g0 hle_U).hom f
    obtain ⟨k, b₁, hsec_eq⟩ := IsLocalization.Away.surj g₀ f_g0
    let b₂ : B_Z := g₀ ^ k
    have hb₂_ne : ρ_L b₂ ≠ 0 := by
      dsimp [b₂]
      rw [map_pow]
      exact pow_ne_zero k hρ_g0_ne
    let T_L : (AlgebraicGeometry.Spec (CommRingCat.of L_y)).Opens := ⊤
    let hT_L : AlgebraicGeometry.IsAffineOpen T_L :=
      AlgebraicGeometry.isAffineOpen_top (AlgebraicGeometry.Spec (CommRingCat.of L_y))
    have hpt_eq_bot : ∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of L_y)), pt = bot_L := by
      intro pt
      have : pt.asIdeal.IsPrime := pt.isPrime
      apply PrimeSpectrum.ext
      rw [hbotL_eq]
      exact Ideal.eq_bot_of_prime pt.asIdeal
    have he_V : T_L ≤ (TopologicalSpace.Opens.map e_Z.base).obj V_g0 := by
      intro pt _
      rw [hpt_eq_bot pt]
      exact hz_g0
    have he_top : T_L ≤ (TopologicalSpace.Opens.map e_Z.base).obj ⊤ := fun _ _ => trivial
    have hej_U : T_L ≤ (TopologicalSpace.Opens.map (e_Z ≫ j_Z).base).obj U := by
      intro pt _
      rw [hpt_eq_bot pt]
      exact hz_UZ
    have : CategoryTheory.IsIso hT_L.fromSpec := by
      rw [AlgebraicGeometry.IsAffineOpen.fromSpec_top]
      infer_instance
    let θ_cat : CommRingCat.of L_y ⟶
        (AlgebraicGeometry.Spec (CommRingCat.of L_y)).presheaf.obj (Opposite.op T_L) :=
      AlgebraicGeometry.Spec.preimage hT_L.fromSpec
    let θ_inv : (AlgebraicGeometry.Spec (CommRingCat.of L_y)).presheaf.obj (Opposite.op T_L) ⟶
        CommRingCat.of L_y :=
      AlgebraicGeometry.Spec.preimage (CategoryTheory.inv hT_L.fromSpec)
    have hθ_id : θ_cat ≫ θ_inv = 𝟙 (CommRingCat.of L_y) := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        AlgebraicGeometry.Spec.map_preimage, CategoryTheory.IsIso.inv_hom_id,
        AlgebraicGeometry.Spec.map_id]
    have he_app_top : e_Z.appLE ⊤ T_L he_top ≫ θ_inv = ρ_cat := by
      have h1 : e_Z.appLE ⊤ T_L he_top = ρ_cat ≫ θ_cat := by
        apply AlgebraicGeometry.Spec.map_injective
        apply (cancel_mono hAffZ.fromSpec).mp
        rw [hAffZ.SpecMap_appLE_fromSpec e_Z hT_L he_top, AlgebraicGeometry.Spec.map_comp,
          AlgebraicGeometry.Spec.map_preimage, CategoryTheory.Category.assoc, hρ_spec]
      rw [h1, CategoryTheory.Category.assoc, hθ_id, CategoryTheory.Category.comp_id]
    have hej_app_U : (e_Z ≫ j_Z).appLE U T_L hej_U ≫ θ_inv = CommRingCat.ofHom φ_UL := by
      have h1 : (e_Z ≫ j_Z).appLE U T_L hej_U = CommRingCat.ofHom φ_UL ≫ θ_cat := by
        apply AlgebraicGeometry.Spec.map_injective
        apply (cancel_mono hU.fromSpec).mp
        rw [hU.SpecMap_appLE_fromSpec (e_Z ≫ j_Z) hT_L hej_U, AlgebraicGeometry.Spec.map_comp,
          AlgebraicGeometry.Spec.map_preimage, CategoryTheory.Category.assoc, he_jZ]
      rw [h1, CategoryTheory.Category.assoc, hθ_id, CategoryTheory.Category.comp_id]
    let ev_V : ↑(Z.presheaf.obj (Opposite.op V_g0)) →+* L_y :=
      (e_Z.appLE V_g0 T_L he_V ≫ θ_inv).hom
    have hev_res : ∀ b : B_Z, ev_V (res_top_g0 b) = ρ_L b := by
      intro b
      change (Z.presheaf.map (CategoryTheory.homOfLE (le_top : V_g0 ≤ ⊤)).op ≫
        (e_Z.appLE V_g0 T_L he_V ≫ θ_inv)).hom b = ρ_L b
      rw [← CategoryTheory.Category.assoc, e_Z.map_appLE he_V, he_app_top]
    have hev_fg0 : ev_V f_g0 = φ_UL f := by
      change (j_Z.appLE U V_g0 hle_U ≫ (e_Z.appLE V_g0 T_L he_V ≫ θ_inv)).hom f = φ_UL f
      rw [← CategoryTheory.Category.assoc,
        AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE e_Z j_Z U V_g0 T_L hle_U he_V,
        hej_app_U]
      rfl
    have hrel : ρ_L b₂ * φ_UL f = ρ_L b₁ := by
      have hsec' : f_g0 * res_top_g0 b₂ = res_top_g0 b₁ := by
        change f_g0 * res_top_g0 g₀ ^ k = res_top_g0 b₁ at hsec_eq
        dsimp [b₂]
        rw [map_pow]
        exact hsec_eq
      have hmap_eq := congrArg ev_V hsec'
      rw [map_mul, hev_fg0, hev_res b₂, hev_res b₁, mul_comm] at hmap_eq
      exact hmap_eq
    have hValMem : ∀ W' : ValuationSubring L_y,
        (∀ d : D_u, ι_DL d ∈ W') → ∀ b : B_Z, ρ_L b ∈ W' := by
      intro W' hDW' b
      have hUC : AlgebraicGeometry.UniversallyClosed π_Z := inferInstance
      rcases hUC with ⟨hUC_univ⟩
      have hSpec_univ : (AlgebraicGeometry.topologically @SpecializingMap).universally π_Z :=
        CategoryTheory.MorphismProperty.universally_mono
          (fun _ _ _ hf => hf.specializingMap) _ hUC_univ
      have hVC : AlgebraicGeometry.ValuativeCriterion.Existence π_Z :=
        AlgebraicGeometry.ValuativeCriterion.Existence.of_specializingMap π_Z hSpec_univ
      let τ_D : D_u →+* ↥W' := ι_DL.codRestrict W'.toSubring hDW'
      have hcomp_τ : CommRingCat.ofHom τ_D ≫ CommRingCat.ofHom (algebraMap ↥W' L_y) =
          CommRingCat.ofHom ι_DL := by
        ext d; rfl
      have hcomm : e_Z ≫ π_Z =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥W' L_y)) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_D) := by
        rw [he_πZ, ← AlgebraicGeometry.Spec.map_comp, hcomp_τ]
      obtain ⟨⟨l⟩⟩ := hVC
        { R := ↥W'
          K := L_y
          i₁ := e_Z
          i₂ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_D)
          commSq := ⟨hcomm⟩ }
      let ρ_W_cat : Z.presheaf.obj (Opposite.op ⊤) ⟶ CommRingCat.of ↥W' :=
        AlgebraicGeometry.Spec.preimage (l.l ≫ Z.isoSpec.hom)
      have hρW_comp : ρ_W_cat ≫ CommRingCat.ofHom (algebraMap ↥W' L_y) = ρ_cat := by
        apply AlgebraicGeometry.Spec.map_injective
        have hfac : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥W' L_y)) ≫ l.l = e_Z :=
          l.fac_left
        rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
          AlgebraicGeometry.Spec.map_preimage, ← CategoryTheory.Category.assoc, hfac]
      have hb_eq : ρ_L b = algebraMap ↥W' L_y (ρ_W_cat.hom b) := by
        change ρ_cat.hom b = (ρ_W_cat ≫ CommRingCat.ofHom (algebraMap ↥W' L_y)).hom b
        rw [hρW_comp]
      rw [hb_eq]
      exact (ρ_W_cat.hom b).2
    exact ⟨ρ_L, b₁, b₂, hb₂_ne, hrel, hValMem⟩
  obtain ⟨ρ_L, b₁, b₂, hb₂_ne, hrel, hValMem⟩ := hStep4
  
  have hStep5 : ∃ W' : ValuationSubring L_y,
      (∀ d : D_u, ι_DL d ∈ W') ∧
      (∃ b : B_Z, ρ_L b ∉ W') := by
    let t_L : L_y := φ_UL f
    have hιDL_inj : Function.Injective ι_DL := by
      intro d₁ d₂ hd_eq
      by_contra hne
      have hd_sub : d₁ - d₂ ≠ 0 := sub_ne_zero.mpr hne
      have hC_ne : (Polynomial.C (d₁ - d₂) : Polynomial D_u) ≠ 0 :=
        Polynomial.C_ne_zero.mpr hd_sub
      apply hTrans_D (Polynomial.C (d₁ - d₂)) hC_ne
      rw [Polynomial.eval₂_C, map_sub, hd_eq, sub_self]
    let K_D := FractionRing D_u
    let σ_K : K_D →+* L_y := IsFractionRing.lift hιDL_inj
    have hσK_eq : ∀ d : D_u, σ_K (algebraMap D_u K_D d) = ι_DL d :=
      IsFractionRing.lift_algebraMap hιDL_inj
    let _ : Algebra K_D L_y := σ_K.toAlgebra
    have ht_notAlg : ¬ IsAlgebraic K_D t_L := by
      rintro ⟨P, hP_ne, hP_eval⟩
      obtain ⟨s, hs_mult⟩ := IsLocalization.exist_integer_multiples
        (nonZeroDivisors D_u) (Finset.range (P.natDegree + 1)) (fun i => P.coeff i)
      let c : ℕ → D_u := fun i =>
        if hi : i ∈ Finset.range (P.natDegree + 1) then
          Classical.choose (hs_mult i hi)
        else 0
      have hc_spec : ∀ i ∈ Finset.range (P.natDegree + 1),
          algebraMap D_u K_D (c i) = algebraMap D_u K_D s.1 * P.coeff i := by
        intro i hi
        have hc_def : c i = Classical.choose (hs_mult i hi) := by
          dsimp only [c]
          split_ifs
          rfl
        rw [hc_def]
        have hspec : algebraMap D_u K_D (Classical.choose (hs_mult i hi)) =
            (s : D_u) • P.coeff i := Classical.choose_spec (hs_mult i hi)
        rw [hspec, Algebra.smul_def]
      let Q_D : Polynomial D_u :=
        ∑ i ∈ Finset.range (P.natDegree + 1), Polynomial.C (c i) * Polynomial.X ^ i
      have hQD_ne : Q_D ≠ 0 := by
        have hEx_coeff : ∃ i₀ : ℕ, P.coeff i₀ ≠ 0 := by
          by_contra hAll0
          have hAll0' : ∀ i : ℕ, P.coeff i = 0 :=
            fun i => Classical.not_not.mp fun hni => hAll0 ⟨i, hni⟩
          exact hP_ne (Polynomial.ext fun i => (hAll0' i).trans (Polynomial.coeff_zero i).symm)
        obtain ⟨i₀, hi₀_ne⟩ := hEx_coeff
        have hi₀_mem : i₀ ∈ Finset.range (P.natDegree + 1) :=
          Finset.mem_range.mpr (Nat.lt_succ_of_le (Polynomial.le_natDegree_of_ne_zero hi₀_ne))
        have hQD_coeff : Q_D.coeff i₀ = c i₀ := by
          dsimp [Q_D]
          rw [Polynomial.finsetSum_coeff]
          simp only [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, mul_ite, mul_one, mul_zero]
          rw [Finset.sum_ite_eq _ _ _]
          simp [hi₀_mem]
        have hs_ne : (s : D_u) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s.2
        have hmap_s_ne : algebraMap D_u K_D s.1 ≠ 0 :=
          fun h0 => hs_ne (IsFractionRing.injective D_u K_D (h0.trans (map_zero _).symm))
        have hci0_ne : c i₀ ≠ 0 := by
          intro hc0
          have hprod0 : algebraMap D_u K_D s.1 * P.coeff i₀ = 0 := by
            rw [← hc_spec i₀ hi₀_mem, hc0, map_zero]
          exact mul_ne_zero hmap_s_ne hi₀_ne hprod0
        intro hQ0
        rw [hQ0, Polynomial.coeff_zero] at hQD_coeff
        exact hci0_ne hQD_coeff.symm
      apply hTrans_D Q_D hQD_ne
      dsimp [Q_D]
      rw [Polynomial.eval₂_finsetSum]
      have hsum_eq : (∑ i ∈ Finset.range (P.natDegree + 1),
          Polynomial.eval₂ ι_DL t_L (Polynomial.C (c i) * Polynomial.X ^ i)) =
          ι_DL s.1 * (∑ i ∈ Finset.range (P.natDegree + 1), σ_K (P.coeff i) * t_L ^ i) := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun i hi => ?_
        rw [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X_pow]
        have hci_L : ι_DL (c i) = ι_DL s.1 * σ_K (P.coeff i) := by
          rw [← hσK_eq (c i), hc_spec i hi, map_mul, hσK_eq s.1]
        rw [hci_L, mul_assoc]
      rw [hsum_eq]
      have hP_sum : (∑ i ∈ Finset.range (P.natDegree + 1), σ_K (P.coeff i) * t_L ^ i) = 0 := by
        have hev : Polynomial.eval₂ σ_K t_L P =
            ∑ i ∈ Finset.range (P.natDegree + 1), σ_K (P.coeff i) * t_L ^ i :=
          Polynomial.eval₂_eq_sum_range σ_K t_L
        rw [← hev]
        exact hP_eval
      rw [hP_sum, mul_zero]
    have hEx_b : ∃ b : B_Z, ¬ IsAlgebraic K_D (ρ_L b) := by
      by_contra hNo_b
      have hAllAlg : ∀ b : B_Z, IsAlgebraic K_D (ρ_L b) :=
        fun b => Classical.not_not.mp fun hnb => hNo_b ⟨b, hnb⟩
      have ht_eq : t_L = ρ_L b₁ * (ρ_L b₂)⁻¹ := by
        rw [← hrel, mul_comm (ρ_L b₂) t_L, mul_assoc, mul_inv_cancel₀ hb₂_ne, mul_one]
      apply ht_notAlg
      rw [ht_eq]
      exact (hAllAlg b₁).mul (IsAlgebraic.inv_iff.mpr (hAllAlg b₂))
    obtain ⟨b, hb_notAlg⟩ := hEx_b
    let β : L_y := ρ_L b
    have hβ_ne : β ≠ 0 := by
      intro h0
      apply hb_notAlg
      change IsAlgebraic K_D β
      rw [h0]
      exact isAlgebraic_zero
    have hβinv_notAlg : ¬ IsAlgebraic K_D β⁻¹ :=
      fun halg => hb_notAlg (IsAlgebraic.inv_iff.mp halg)
    let φ_ev : Polynomial K_D →ₐ[K_D] L_y := Polynomial.aeval β⁻¹
    let R_β : Subalgebra K_D L_y := φ_ev.range
    have hφ_inj : Function.Injective φ_ev.rangeRestrict := by
      intro P₁ P₂ h12
      have hev_eq : φ_ev P₁ = φ_ev P₂ := congrArg Subtype.val h12
      by_contra hne
      apply hβinv_notAlg
      refine ⟨P₁ - P₂, sub_ne_zero.mpr hne, ?_⟩
      change φ_ev (P₁ - P₂) = 0
      rw [map_sub, hev_eq, sub_self]
    let e_β : Polynomial K_D ≃+* ↥R_β :=
      RingEquiv.ofBijective φ_ev.rangeRestrict.toRingHom
        ⟨hφ_inj, fun ⟨_, P, hP⟩ => ⟨P, Subtype.ext hP⟩⟩
    let u_tilde : ↥R_β := e_β Polynomial.X
    have hu_val : (u_tilde : L_y) = β⁻¹ := by
      change (φ_ev.rangeRestrict Polynomial.X : L_y) = β⁻¹
      exact Polynomial.aeval_X β⁻¹
    have hu_notUnit : ¬ IsUnit u_tilde := by
      intro hU_u
      have hU_X : IsUnit (Polynomial.X : Polynomial K_D) := by
        have hm := hU_u.map e_β.symm.toRingHom
        simpa [u_tilde] using hm
      exact Polynomial.not_isUnit_X hU_X
    have hSpan_ne_top : Ideal.span ({u_tilde} : Set ↥R_β) ≠ ⊤ :=
      Ideal.span_singleton_eq_top.not.mpr hu_notUnit
    obtain ⟨m_β, hm_max, hm_le⟩ := Ideal.exists_le_maximal _ hSpan_ne_top
    have : m_β.IsPrime := hm_max.isPrime
    have hu_mem : u_tilde ∈ m_β := hm_le (Ideal.subset_span (Set.mem_singleton u_tilde))
    let A_β := Localization.AtPrime m_β
    have hCompl_unit : ∀ y : m_β.primeCompl, IsUnit (R_β.val.toRingHom y.1) := by
      intro y
      have hy_ne : y.1 ≠ 0 := fun hy0 => y.2 (hy0 ▸ m_β.zero_mem)
      have hyL_ne : (y.1 : L_y) ≠ 0 := fun h0 => hy_ne (Subtype.ext h0)
      exact IsUnit.mk0 _ hyL_ne
    let lam_β₀ := IsLocalization.lift (M := m_β.primeCompl) (S := A_β) hCompl_unit
    let lam_β : @RingHom A_β L_y
        (inferInstance : CommRing A_β).toCommSemiring.toSemiring.toNonAssocSemiring
        Field.toSemifield.toNonAssocSemiring :=
      { toFun := lam_β₀
        map_one' := lam_β₀.map_one
        map_mul' := lam_β₀.map_mul
        map_zero' := lam_β₀.map_zero
        map_add' := lam_β₀.map_add }
    have hlam_eq : ∀ x : ↥R_β, lam_β (algebraMap ↥R_β A_β x) = (x : L_y) :=
      IsLocalization.lift_eq (M := m_β.primeCompl) (S := A_β) hCompl_unit
    obtain ⟨W', hW', hLoc_W'⟩ := IsLocalRing.exists_factor_valuationRing lam_β
    refine ⟨W', ?_, b, ?_⟩
    · intro d
      let x_d : ↥R_β := algebraMap K_D ↥R_β (algebraMap D_u K_D d)
      have hxd_val : (x_d : L_y) = ι_DL d := by
        change algebraMap K_D L_y (algebraMap D_u K_D d) = ι_DL d
        exact hσK_eq d
      rw [← hxd_val, ← hlam_eq x_d]
      exact hW' (algebraMap ↥R_β A_β x_d)
    · intro hβ_W'
      let u_loc : A_β := algebraMap ↥R_β A_β u_tilde
      have huloc_max : u_loc ∈ IsLocalRing.maximalIdeal A_β :=
        (IsLocalization.AtPrime.to_map_mem_maximal_iff A_β m_β u_tilde).mpr hu_mem
      have huloc_notUnit : ¬ IsUnit u_loc :=
        fun hU => IsLocalRing.notMem_maximalIdeal.mpr hU huloc_max
      let f_W' : A_β →+* ↥W' := lam_β.codRestrict W'.toSubring hW'
      have : IsLocalHom f_W' := hLoc_W'
      have hUnit_fW' : IsUnit (f_W' u_loc) := by
        refine ⟨⟨f_W' u_loc, ⟨β, hβ_W'⟩, ?_, ?_⟩, rfl⟩
        · apply Subtype.ext
          change lam_β u_loc * β = 1
          rw [hlam_eq u_tilde, hu_val]
          exact inv_mul_cancel₀ hβ_ne
        · apply Subtype.ext
          change β * lam_β u_loc = 1
          rw [hlam_eq u_tilde, hu_val]
          exact mul_inv_cancel₀ hβ_ne
      exact huloc_notUnit (isUnit_of_map_unit f_W' u_loc hUnit_fW')
  obtain ⟨W', hDW', b, hb_not⟩ := hStep5
  exact hb_not (hValMem W' hDW' b)

theorem weil_composed_valuation_divisorial_specialization (K : Type u) [Field K]
    (V : ValuationSubring K)
    (Y U_ss : AlgebraicGeometry.Scheme.{u})
    (g_ss : U_ss ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (h_mod : Y ⟶ U_ss)
    (F_ss : Type u) [Field F_ss]
    (η_ss : AlgebraicGeometry.Spec (CommRingCat.of F_ss) ⟶ U_ss)
    (η_Y : AlgebraicGeometry.Spec (CommRingCat.of F_ss) ⟶ Y)
    (W : ValuationSubring F_ss)
    (ψ_Y : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ Y)
    (mW : AlgebraicGeometry.Spec (CommRingCat.of ↥W))
    (y₀ : Y) (V₀ : Y.Opens) (hV₀ : AlgebraicGeometry.IsAffineOpen V₀) (hy₀V₀ : y₀ ∈ V₀)
    (b₁ b₂ : ↑(Y.presheaf.obj (Opposite.op V₀)))
    (hηY_ss : η_Y ≫ h_mod = η_ss)
    (hmW : mW.asIdeal = IsLocalRing.maximalIdeal ↥W)
    (hη_ψY : AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype) ≫ ψ_Y = η_Y)
    (hy₀_cl : y₀ ∈ closure ({ψ_Y.base mW} : Set Y))
    (hz₀_cl : IsClosed ({h_mod.base y₀} : Set U_ss))
    (hP₀_ne : (g_ss.base (h_mod.base y₀)).asIdeal ≠ ⊥)
    (hb₂ : b₂ ∉ (hV₀.primeIdealOf ⟨y₀, hy₀V₀⟩).asIdeal)
    (hb_poly : ∀ (R : Type u) [CommRing R] [IsLocalRing R]
        (ρ_B : ↑(Y.presheaf.obj (Opposite.op V₀)) →+* R),
      Ideal.comap ρ_B (IsLocalRing.maximalIdeal R) =
        (hV₀.primeIdealOf ⟨y₀, hy₀V₀⟩).asIdeal →
      ∀ (t : R),
        ρ_B b₂ * t = ρ_B b₁ →
        ∀ (Q : Polynomial ↥V),
          (∃ i : ℕ, Q.coeff i ∉ (g_ss.base (h_mod.base y₀)).asIdeal) →
          Polynomial.eval₂
            (AlgebraicGeometry.Spec.preimage
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_B) ≫
                hV₀.fromSpec ≫ h_mod ≫ g_ss)).hom
            t Q ∉ IsLocalRing.maximalIdeal R) :
    ∃ (W₀ : ValuationSubring F_ss),
      W₀ ≤ W ∧
      (∀ x : ↥W, x ∈ IsLocalRing.maximalIdeal ↥W →
        ∃ hx₀ : W.subtype x ∈ W₀, (⟨W.subtype x, hx₀⟩ : ↥W₀) ∈ IsLocalRing.maximalIdeal ↥W₀) ∧
      IsDivisorialClosedVal V g_ss η_ss W₀ ∧
      IsValResolvedOnMod V g_ss h_mod η_Y W₀ :=
by
  
  have hyV₀ : ψ_Y.base mW ∈ V₀ := by
    obtain ⟨z, hzV₀, hzeq⟩ := mem_closure_iff.mp hy₀_cl (V₀ : Set Y) V₀.isOpen hy₀V₀
    rw [Set.mem_singleton_iff] at hzeq
    exact hzeq ▸ hzV₀
  have hRange : Set.range ψ_Y.base ⊆ Set.range hV₀.fromSpec.base := by
    rw [hV₀.range_fromSpec]
    rintro _ ⟨q, rfl⟩
    have hq_prime : q.asIdeal.IsPrime := q.isPrime
    have hq_le : q.asIdeal ≤ mW.asIdeal := by
      rw [hmW]
      exact IsLocalRing.le_maximalIdeal_of_isPrime q.asIdeal
    let mW_ps : PrimeSpectrum ↥W := mW
    let q_ps : PrimeSpectrum ↥W := q
    have hmW_zl : mW_ps ∈ PrimeSpectrum.zeroLocus (q_ps.asIdeal : Set ↥W) := hq_le
    have hmW_cl_ps : mW_ps ∈ closure ({q_ps} : Set (PrimeSpectrum ↥W)) :=
      (PrimeSpectrum.closure_singleton q_ps).symm ▸ hmW_zl
    have hmW_cl : mW ∈ closure ({q} : Set (AlgebraicGeometry.Spec (CommRingCat.of ↥W))) :=
      hmW_cl_ps
    obtain ⟨w, hwU, hweq⟩ :=
      mem_closure_iff.mp hmW_cl (ψ_Y.base ⁻¹' (V₀ : Set Y))
        (V₀.isOpen.preimage ψ_Y.continuous) hyV₀
    rw [Set.mem_singleton_iff] at hweq
    exact hweq ▸ hwU
  let ψ_lift := AlgebraicGeometry.IsOpenImmersion.lift hV₀.fromSpec ψ_Y hRange
  let φ₀_cat := AlgebraicGeometry.Spec.preimage ψ_lift
  let B₀ : Type u := ↑(Y.presheaf.obj (Opposite.op V₀))
  let φ₀ : B₀ →+* ↥W := φ₀_cat.hom
  have hφ₀_spec : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀) ≫ hV₀.fromSpec = ψ_Y := by
    change AlgebraicGeometry.Spec.map φ₀_cat ≫ hV₀.fromSpec = ψ_Y
    rw [AlgebraicGeometry.Spec.map_preimage]
    exact AlgebraicGeometry.IsOpenImmersion.lift_fac hV₀.fromSpec ψ_Y hRange
  let q_y : AlgebraicGeometry.Spec (Y.presheaf.obj (Opposite.op V₀)) :=
    hV₀.primeIdealOf ⟨ψ_Y.base mW, hyV₀⟩
  let q_y₀ : AlgebraicGeometry.Spec (Y.presheaf.obj (Opposite.op V₀)) :=
    hV₀.primeIdealOf ⟨y₀, hy₀V₀⟩
  have hqy_eq : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀)).base mW = q_y := by
    apply (AlgebraicGeometry.Scheme.Hom.isOpenEmbedding hV₀.fromSpec).injective
    have hL : hV₀.fromSpec.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀)).base mW) =
        ψ_Y.base mW := by
      change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀) ≫ hV₀.fromSpec).base mW =
        ψ_Y.base mW
      rw [hφ₀_spec]
    exact hL.trans (hV₀.fromSpec_primeIdealOf ⟨ψ_Y.base mW, hyV₀⟩).symm
  let p_y : Ideal B₀ := Ideal.comap φ₀ (IsLocalRing.maximalIdeal ↥W)
  let p_y₀ : Ideal B₀ := q_y₀.asIdeal
  have hp_y_prime : p_y.IsPrime := Ideal.IsPrime.comap φ₀
  have hp_y₀_prime : p_y₀.IsPrime := q_y₀.isPrime
  have hcomap_qy : p_y = q_y.asIdeal := by
    change Ideal.comap φ₀ (IsLocalRing.maximalIdeal ↥W) = q_y.asIdeal
    rw [← hmW, ← hqy_eq]
    rfl
  have hcl_ind :=
    (AlgebraicGeometry.Scheme.Hom.isOpenEmbedding hV₀.fromSpec).isInducing.closure_eq_preimage_closure_image
      ({q_y} : Set (AlgebraicGeometry.Spec (Y.presheaf.obj (Opposite.op V₀))))
  have hqy₀_cl_spec :
      q_y₀ ∈ closure ({q_y} : Set (AlgebraicGeometry.Spec (Y.presheaf.obj (Opposite.op V₀)))) := by
    rw [hcl_ind, Set.image_singleton]
    have h1 : hV₀.fromSpec.base q_y = ψ_Y.base mW :=
      hV₀.fromSpec_primeIdealOf ⟨ψ_Y.base mW, hyV₀⟩
    have h2 : hV₀.fromSpec.base q_y₀ = y₀ := hV₀.fromSpec_primeIdealOf ⟨y₀, hy₀V₀⟩
    change hV₀.fromSpec.base q_y₀ ∈ closure ({hV₀.fromSpec.base q_y} : Set Y)
    rw [h1, h2]
    exact hy₀_cl
  let qy_ps : PrimeSpectrum B₀ := q_y
  let qy₀_ps : PrimeSpectrum B₀ := q_y₀
  have hqy₀_cl_ps : qy₀_ps ∈ closure ({qy_ps} : Set (PrimeSpectrum B₀)) := hqy₀_cl_spec
  have hqy₀_zl : qy₀_ps ∈ PrimeSpectrum.zeroLocus (qy_ps.asIdeal : Set B₀) :=
    (PrimeSpectrum.closure_singleton qy_ps) ▸ hqy₀_cl_ps
  have hp_le : p_y ≤ p_y₀ := by
    rw [hcomap_qy]
    exact hqy₀_zl

  
  let κ_W : Type u := IsLocalRing.ResidueField ↥W
  let res_W : ↥W →+* κ_W := IsLocalRing.residue ↥W
  have hker_py : ∀ b ∈ p_y, (res_W.comp φ₀) b = 0 := by
    intro b hb
    change φ₀ b ∈ IsLocalRing.maximalIdeal ↥W at hb
    rw [← IsLocalRing.ker_residue] at hb
    exact hb
  let D₀ : Type u := B₀ ⧸ p_y
  have : IsDomain D₀ := Ideal.Quotient.isDomain p_y
  let mk_py : B₀ →+* D₀ := Ideal.Quotient.mk p_y
  let φ_bar : D₀ →+* κ_W := Ideal.Quotient.lift p_y (res_W.comp φ₀) hker_py
  have hφ_bar_zero : ∀ d : D₀, φ_bar d = 0 → d = 0 := by
    intro d hd
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective d
    have hres_b : res_W (φ₀ b) = 0 := hd
    have hmem_m : φ₀ b ∈ IsLocalRing.maximalIdeal ↥W := by
      rw [← IsLocalRing.ker_residue]
      exact hres_b
    exact Ideal.Quotient.eq_zero_iff_mem.mpr hmem_m
  let q_bar : Ideal D₀ := Ideal.map mk_py p_y₀
  have hq_bar_prime : q_bar.IsPrime := by
    refine Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective ?_
    rw [Ideal.mk_ker]
    exact hp_le
  have hcomap_q_bar : Ideal.comap mk_py q_bar = p_y₀ := by
    have hc := Ideal.comap_map_of_surjective mk_py Ideal.Quotient.mk_surjective p_y₀
    have hbot : Ideal.comap mk_py ⊥ = p_y := by
      rw [← RingHom.ker_eq_comap_bot, Ideal.mk_ker]
    rw [hbot, sup_eq_left.mpr hp_le] at hc
    exact hc
  let L₀ : Type u := Localization.AtPrime q_bar
  have h_units : ∀ s : q_bar.primeCompl, IsUnit (φ_bar s.1) := by
    intro s
    have hs_ne : s.1 ≠ 0 := by
      intro h0
      apply s.2
      rw [h0]
      exact q_bar.zero_mem
    have hφs_ne : φ_bar s.1 ≠ 0 := fun h0 => hs_ne (hφ_bar_zero s.1 h0)
    exact IsUnit.mk0 (φ_bar s.1) hφs_ne
  let lam₀ : L₀ →+* κ_W := IsLocalization.lift h_units
  obtain ⟨W_bar, h_mem_W_bar, hlam₀'_loc⟩ := IsLocalRing.exists_factor_valuationRing lam₀
  let lam₀' : L₀ →+* ↥W_bar := lam₀.codRestrict W_bar.toSubring h_mem_W_bar
  have : IsLocalHom lam₀' := hlam₀'_loc

  
  let S₀ : Subring F_ss := (W_bar.toSubring.comap res_W).map W.subtype
  have h_tot : ∀ z : F_ss, z ∈ S₀ ∨ z⁻¹ ∈ S₀ := by
    intro z
    by_cases hz0 : z = 0
    · exact Or.inl (hz0 ▸ S₀.zero_mem)
    · by_cases hzW : z ∈ W
      · let x : ↥W := ⟨z, hzW⟩
        by_cases hz_inv : z⁻¹ ∈ W
        · let x' : ↥W := ⟨z⁻¹, hz_inv⟩
          have hxx' : x * x' = 1 := Subtype.ext (mul_inv_cancel₀ hz0)
          have hres_mul : res_W x * res_W x' = 1 := by
            rw [← map_mul, hxx', map_one]
          have hres_ne : res_W x ≠ 0 := by
            intro h0
            rw [h0, zero_mul] at hres_mul
            exact zero_ne_one hres_mul
          have hres_inv : res_W x' = (res_W x)⁻¹ := by
            calc
              res_W x' = (res_W x)⁻¹ * (res_W x * res_W x') := by
                rw [← mul_assoc, inv_mul_cancel₀ hres_ne, one_mul]
              _ = (res_W x)⁻¹ := by rw [hres_mul, mul_one]
          rcases W_bar.mem_or_inv_mem (res_W x) with hmem | hmem_inv
          · exact Or.inl ⟨x, hmem, rfl⟩
          · rw [← hres_inv] at hmem_inv
            exact Or.inr ⟨x', hmem_inv, rfl⟩
        · have hnot_unit : ¬ IsUnit x := by
            rintro ⟨u, hu⟩
            apply hz_inv
            have hu_mul : z * (↑(u⁻¹) : ↥W).1 = 1 := by
              calc
                z * (↑(u⁻¹) : ↥W).1 = (u : ↥W).1 * (↑(u⁻¹) : ↥W).1 := by
                  rw [congrArg Subtype.val hu]
                _ = ((u : ↥W) * ↑(u⁻¹)).1 := rfl
                _ = (1 : ↥W).1 := by rw [Units.mul_inv]
                _ = 1 := rfl
            have h_eq : (↑(u⁻¹) : ↥W).1 = z⁻¹ := by
              calc
                (↑(u⁻¹) : ↥W).1 = z⁻¹ * (z * (↑(u⁻¹) : ↥W).1) := by
                  rw [← mul_assoc, inv_mul_cancel₀ hz0, one_mul]
                _ = z⁻¹ := by rw [hu_mul, mul_one]
            rw [← h_eq]
            exact (↑(u⁻¹) : ↥W).2
          have hx_m : x ∈ IsLocalRing.maximalIdeal ↥W := by
            rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
            exact hnot_unit
          have hx_res : res_W x = 0 := by
            rw [← RingHom.mem_ker, IsLocalRing.ker_residue]
            exact hx_m
          have hx_W_bar : res_W x ∈ W_bar.toSubring := by
            rw [hx_res]
            exact W_bar.toSubring.zero_mem
          exact Or.inl ⟨x, hx_W_bar, rfl⟩
      · have hz_inv : z⁻¹ ∈ W := (W.mem_or_inv_mem z).resolve_left hzW
        let x' : ↥W := ⟨z⁻¹, hz_inv⟩
        have hnot_unit : ¬ IsUnit x' := by
          rintro ⟨u, hu⟩
          apply hzW
          have hu_mul : z⁻¹ * (↑(u⁻¹) : ↥W).1 = 1 := by
            calc
              z⁻¹ * (↑(u⁻¹) : ↥W).1 = (u : ↥W).1 * (↑(u⁻¹) : ↥W).1 := by
                rw [congrArg Subtype.val hu]
              _ = ((u : ↥W) * ↑(u⁻¹)).1 := rfl
              _ = (1 : ↥W).1 := by rw [Units.mul_inv]
              _ = 1 := rfl
          have h_eq : (↑(u⁻¹) : ↥W).1 = z := by
            calc
              (↑(u⁻¹) : ↥W).1 = z * (z⁻¹ * (↑(u⁻¹) : ↥W).1) := by
                rw [← mul_assoc, mul_inv_cancel₀ hz0, one_mul]
              _ = z := by rw [hu_mul, mul_one]
          rw [← h_eq]
          exact (↑(u⁻¹) : ↥W).2
        have hx'_m : x' ∈ IsLocalRing.maximalIdeal ↥W := by
          rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
          exact hnot_unit
        have hx'_res : res_W x' = 0 := by
          rw [← RingHom.mem_ker, IsLocalRing.ker_residue]
          exact hx'_m
        have hx'_W_bar : res_W x' ∈ W_bar.toSubring := by
          rw [hx'_res]
          exact W_bar.toSubring.zero_mem
        exact Or.inr ⟨x', hx'_W_bar, rfl⟩
  let W₀ : ValuationSubring F_ss := ValuationSubring.ofSubring S₀ h_tot
  have hW₀_le : W₀ ≤ W := by
    intro z hz
    rw [ValuationSubring.mem_ofSubring] at hz
    rcases hz with ⟨x, _, rfl⟩
    exact x.2
  let i_W : ↥W₀ →+* ↥W := Subring.inclusion hW₀_le
  have hmW_le : ∀ x : ↥W, x ∈ IsLocalRing.maximalIdeal ↥W →
      ∃ hx₀ : W.subtype x ∈ W₀, (⟨W.subtype x, hx₀⟩ : ↥W₀) ∈ IsLocalRing.maximalIdeal ↥W₀ := by
    intro x hx
    have hx_res : res_W x = 0 := by
      rw [← RingHom.mem_ker, IsLocalRing.ker_residue]
      exact hx
    have hx_W_bar : res_W x ∈ W_bar.toSubring := by
      rw [hx_res]
      exact W_bar.toSubring.zero_mem
    have hx₀ : W.subtype x ∈ W₀ := by
      rw [ValuationSubring.mem_ofSubring]
      exact ⟨x, hx_W_bar, rfl⟩
    refine ⟨hx₀, ?_⟩
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hunit
    have hunit_x : IsUnit x := by
      have hmap : IsUnit (i_W ⟨W.subtype x, hx₀⟩) := hunit.map i_W
      have heq : i_W ⟨W.subtype x, hx₀⟩ = x := Subtype.ext rfl
      rwa [heq] at hmap
    have hx_nu : ¬ IsUnit x := by
      rwa [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hx
    exact hx_nu hunit_x
  have h_res_W₀ : ∀ w : ↥W₀, (res_W.comp i_W) w ∈ W_bar.toSubring := by
    intro w
    have hw : w.1 ∈ S₀ := (ValuationSubring.mem_ofSubring S₀ h_tot w.1).mp w.2
    rcases hw with ⟨x, hx_mem, hx_eq⟩
    have hx_iW : x = i_W w := Subtype.ext hx_eq
    change res_W (i_W w) ∈ W_bar.toSubring
    rw [← hx_iW]
    exact hx_mem
  let π₀ : ↥W₀ →+* ↥W_bar := (res_W.comp i_W).codRestrict W_bar.toSubring h_res_W₀
  have hπ₀_loc : IsLocalHom π₀ := by
    refine ⟨fun w hw => ?_⟩
    rcases hw with ⟨u_bar, hu_bar⟩
    have hu_bar_mul : res_W (i_W w) * (↑(u_bar⁻¹) : ↥W_bar).1 = 1 := by
      calc
        res_W (i_W w) * (↑(u_bar⁻¹) : ↥W_bar).1 =
            (π₀ w).1 * (↑(u_bar⁻¹) : ↥W_bar).1 := rfl
        _ = (u_bar : ↥W_bar).1 * (↑(u_bar⁻¹) : ↥W_bar).1 := by
          rw [congrArg Subtype.val hu_bar]
        _ = ((u_bar : ↥W_bar) * ↑(u_bar⁻¹)).1 := rfl
        _ = (1 : ↥W_bar).1 := by rw [Units.mul_inv]
        _ = 1 := rfl
    have hres_ne : res_W (i_W w) ≠ 0 := by
      intro h0
      rw [h0, zero_mul] at hu_bar_mul
      exact zero_ne_one hu_bar_mul
    have hiW_not_m : i_W w ∉ IsLocalRing.maximalIdeal ↥W := by
      rw [← IsLocalRing.ker_residue, RingHom.mem_ker]
      exact hres_ne
    rcases IsLocalRing.notMem_maximalIdeal.mp hiW_not_m with ⟨u_W, hu_W⟩
    let v_W : ↥W := ↑(u_W⁻¹)
    have hiW_mul : i_W w * v_W = 1 := by
      rw [← hu_W]
      exact Units.mul_inv u_W
    have hres_vW_mul : res_W (i_W w) * res_W v_W = 1 := by
      rw [← map_mul, hiW_mul, map_one]
    have hres_vW_eq : res_W v_W = (↑(u_bar⁻¹) : ↥W_bar).1 :=
      mul_left_cancel₀ hres_ne (hres_vW_mul.trans hu_bar_mul.symm)
    have hvW_mem_bar : res_W v_W ∈ W_bar.toSubring := by
      rw [hres_vW_eq]
      exact (↑(u_bar⁻¹) : ↥W_bar).2
    have hv₀_mem : W.subtype v_W ∈ W₀ := by
      rw [ValuationSubring.mem_ofSubring]
      exact ⟨v_W, hvW_mem_bar, rfl⟩
    let v₀ : ↥W₀ := ⟨W.subtype v_W, hv₀_mem⟩
    have hwv₀ : w * v₀ = 1 := by
      apply Subtype.ext
      change (i_W w * v_W).1 = (1 : ↥W).1
      exact congrArg Subtype.val hiW_mul
    exact ⟨⟨w, v₀, hwv₀, mul_comm w v₀ ▸ hwv₀⟩, rfl⟩
  have : IsLocalHom π₀ := hπ₀_loc
  have hφ₀_W₀ : ∀ b : B₀, (W.subtype.comp φ₀) b ∈ W₀.toSubring := by
    intro b
    change W.subtype (φ₀ b) ∈ W₀
    rw [ValuationSubring.mem_ofSubring]
    let z_b : L₀ := algebraMap D₀ L₀ (mk_py b)
    have h1 : res_W (φ₀ b) = φ_bar (mk_py b) := rfl
    have h2 : φ_bar (mk_py b) = lam₀ z_b := (IsLocalization.lift_eq h_units (mk_py b)).symm
    have h3 : lam₀ z_b = (lam₀' z_b).1 := rfl
    have h_bar : res_W (φ₀ b) ∈ W_bar.toSubring := by
      rw [h1, h2, h3]
      exact (lam₀' z_b).2
    exact ⟨φ₀ b, h_bar, rfl⟩
  let ρ_B : B₀ →+* ↥W₀ := (W.subtype.comp φ₀).codRestrict W₀.toSubring hφ₀_W₀
  have hρ_sub : W₀.subtype.comp ρ_B = W.subtype.comp φ₀ := by
    ext b
    rfl
  have hπ_ρ : π₀.comp ρ_B = lam₀'.comp ((algebraMap D₀ L₀).comp mk_py) := by
    ext b
    change res_W (i_W (ρ_B b)) = (lam₀' (algebraMap D₀ L₀ (mk_py b))).1
    have hiW_ρ : i_W (ρ_B b) = φ₀ b := Subtype.ext rfl
    rw [hiW_ρ]
    have h1 : res_W (φ₀ b) = φ_bar (mk_py b) := rfl
    have h2 : φ_bar (mk_py b) = lam₀ (algebraMap D₀ L₀ (mk_py b)) :=
      (IsLocalization.lift_eq h_units (mk_py b)).symm
    rw [h1, h2]
    rfl
  have hcomap_π₀ :
      Ideal.comap π₀ (IsLocalRing.maximalIdeal ↥W_bar) = IsLocalRing.maximalIdeal ↥W₀ := by
    ext w
    simp only [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, isUnit_map_iff]
  have hcomap_lam₀' :
      Ideal.comap lam₀' (IsLocalRing.maximalIdeal ↥W_bar) = IsLocalRing.maximalIdeal L₀ := by
    ext z
    simp only [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, isUnit_map_iff]
  have hcomap_L₀ : Ideal.comap (algebraMap D₀ L₀) (IsLocalRing.maximalIdeal L₀) = q_bar :=
    IsLocalization.AtPrime.under_maximalIdeal L₀ q_bar
  have hρ_comap : Ideal.comap ρ_B (IsLocalRing.maximalIdeal ↥W₀) = p_y₀ := by
    calc
      Ideal.comap ρ_B (IsLocalRing.maximalIdeal ↥W₀) =
          Ideal.comap ρ_B (Ideal.comap π₀ (IsLocalRing.maximalIdeal ↥W_bar)) := by rw [hcomap_π₀]
      _ = Ideal.comap (π₀.comp ρ_B) (IsLocalRing.maximalIdeal ↥W_bar) := rfl
      _ = Ideal.comap (lam₀'.comp ((algebraMap D₀ L₀).comp mk_py))
            (IsLocalRing.maximalIdeal ↥W_bar) := by rw [hπ_ρ]
      _ = Ideal.comap mk_py (Ideal.comap (algebraMap D₀ L₀)
            (Ideal.comap lam₀' (IsLocalRing.maximalIdeal ↥W_bar))) := rfl
      _ = Ideal.comap mk_py (Ideal.comap (algebraMap D₀ L₀) (IsLocalRing.maximalIdeal L₀)) := by
            rw [hcomap_lam₀']
      _ = Ideal.comap mk_py q_bar := by rw [hcomap_L₀]
      _ = p_y₀ := hcomap_q_bar

  
  let mW₀ : AlgebraicGeometry.Spec (CommRingCat.of ↥W₀) :=
    (⟨IsLocalRing.maximalIdeal ↥W₀, inferInstance⟩ : PrimeSpectrum ↥W₀)
  let ψ_Y0 : AlgebraicGeometry.Spec (CommRingCat.of ↥W₀) ⟶ Y :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_B) ≫ hV₀.fromSpec
  have hspec_mW₀ : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_B)).base mW₀ = q_y₀ := by
    apply PrimeSpectrum.ext
    exact hρ_comap
  have hy₀_eq : ψ_Y0.base mW₀ = y₀ := by
    change hV₀.fromSpec.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_B)).base mW₀) = y₀
    rw [hspec_mW₀, hV₀.fromSpec_primeIdealOf ⟨y₀, hy₀V₀⟩]
  let V₁ : Y.Opens := Y.basicOpen b₂
  let hV₁ : AlgebraicGeometry.IsAffineOpen V₁ := hV₀.basicOpen b₂
  have hy₀V₁ : y₀ ∈ V₁ := by
    have hqb : q_y₀ ∈ PrimeSpectrum.basicOpen b₂ := (PrimeSpectrum.mem_basicOpen b₂ q_y₀).mpr hb₂
    rw [← hV₀.fromSpec_preimage_basicOpen b₂] at hqb
    have hfb : hV₀.fromSpec.base q_y₀ ∈ Y.basicOpen b₂ := hqb
    rwa [hV₀.fromSpec_primeIdealOf ⟨y₀, hy₀V₀⟩] at hfb
  have hb₂_not_m : ρ_B b₂ ∉ IsLocalRing.maximalIdeal ↥W₀ := by
    intro hmem
    apply hb₂
    change b₂ ∈ p_y₀
    rw [← hρ_comap]
    exact hmem
  have hb₂_unit : IsUnit (ρ_B b₂) := IsLocalRing.notMem_maximalIdeal.mp hb₂_not_m
  let B₁ : Type u := ↑(Y.presheaf.obj (Opposite.op V₁))
  have : IsLocalization.Away b₂ B₁ := hV₀.isLocalization_basicOpen b₂
  let φ₁_hom : B₁ →+* ↥W₀ := IsLocalization.Away.lift b₂ hb₂_unit
  let φ₁ : Y.presheaf.obj (Opposite.op V₁) ⟶ CommRingCat.of ↥W₀ := CommRingCat.ofHom φ₁_hom
  let res_b₂ := Y.presheaf.map (CategoryTheory.homOfLE (Y.basicOpen_le b₂)).op
  have hres_φ₁ : res_b₂ ≫ φ₁ = CommRingCat.ofHom ρ_B := by
    ext a
    exact congrArg Subtype.val (IsLocalization.Away.lift_eq (S := B₁) b₂ hb₂_unit a)
  have hφ₁_spec : AlgebraicGeometry.Spec.map φ₁ ≫ hV₁.fromSpec = ψ_Y0 := by
    dsimp only [ψ_Y0]
    rw [← hV₀.map_fromSpec hV₁ (CategoryTheory.homOfLE (Y.basicOpen_le b₂)).op,
      ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp, hres_φ₁]
  let f₁ : B₁ := IsLocalization.mk' B₁ b₁ ⟨b₂, Submonoid.mem_powers b₂⟩
  have hmul_b : ρ_B b₂ * φ₁.hom f₁ = ρ_B b₁ := by
    have hmk := congrArg φ₁_hom (IsLocalization.mk'_spec' B₁ b₁ ⟨b₂, Submonoid.mem_powers b₂⟩)
    rw [map_mul, IsLocalization.Away.lift_eq b₂ hb₂_unit b₂,
      IsLocalization.Away.lift_eq b₂ hb₂_unit b₁] at hmk
    exact hmk
  let ψ_ss0 : AlgebraicGeometry.Spec (CommRingCat.of ↥W₀) ⟶ U_ss := ψ_Y0 ≫ h_mod
  have hhom_sub :
      (CommRingCat.ofHom ρ_B : Y.presheaf.obj (Opposite.op V₀) ⟶ CommRingCat.of ↥W₀) ≫
        CommRingCat.ofHom W₀.subtype =
      (CommRingCat.ofHom φ₀ : Y.presheaf.obj (Opposite.op V₀) ⟶ CommRingCat.of ↥W) ≫
        CommRingCat.ofHom W.subtype := by
    ext b
    exact RingHom.congr_fun hρ_sub b
  have hη_ψY0 : AlgebraicGeometry.Spec.map (CommRingCat.ofHom W₀.subtype) ≫ ψ_Y0 = η_Y := by
    dsimp only [ψ_Y0]
    rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp, hhom_sub,
      AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc, hφ₀_spec, hη_ψY]
  have hη_ψss0 : AlgebraicGeometry.Spec.map (CommRingCat.ofHom W₀.subtype) ≫ ψ_ss0 = η_ss := by
    dsimp only [ψ_ss0]
    rw [← CategoryTheory.Category.assoc, hη_ψY0, hηY_ss]
  have hz₀_eq : ψ_ss0.base mW₀ = h_mod.base y₀ := by
    change h_mod.base (ψ_Y0.base mW₀) = h_mod.base y₀
    rw [hy₀_eq]
  have hpoly₀ := hb_poly ↥W₀ ρ_B hρ_comap (φ₁.hom f₁) hmul_b
  refine ⟨W₀, hW₀_le, hmW_le, ?_, ?_⟩
  · refine ⟨ψ_ss0, mW₀, φ₁.hom f₁, rfl, hη_ψss0, ?_, ?_, ?_⟩
    · rw [hz₀_eq]
      exact hz₀_cl
    · rw [hz₀_eq]
      exact hP₀_ne
    · intro P hP
      rw [hz₀_eq] at hP
      have hmor_eq : ψ_ss0 ≫ g_ss =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_B) ≫ hV₀.fromSpec ≫ h_mod ≫ g_ss := by
        simp only [ψ_ss0, ψ_Y0, CategoryTheory.Category.assoc]
      rw [hmor_eq]
      exact hpoly₀ P hP
  · refine ⟨ψ_Y0, mW₀, V₁, hV₁, φ₁, f₁, rfl, hη_ψY0, hy₀_eq.symm ▸ hy₀V₁, hφ₁_spec, ?_⟩
    · intro P hP
      have hbase_eq : (ψ_Y0 ≫ h_mod).base mW₀ = h_mod.base y₀ := hz₀_eq
      rw [hbase_eq] at hP
      have hmor_eq : ψ_Y0 ≫ h_mod ≫ g_ss =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_B) ≫ hV₀.fromSpec ≫ h_mod ≫ g_ss := by
        simp only [ψ_Y0, CategoryTheory.Category.assoc]
      rw [hmor_eq]
      exact hpoly₀ P hP

theorem weil_val_resolved_base_lift_and_overring_propagation (K : Type u) [Field K]
    (V : ValuationSubring K)
    (U_ss X : AlgebraicGeometry.Scheme.{u})
    (g_ss : U_ss ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (p_X : X ⟶ U_ss)
    (F_ss : Type u) [Field F_ss]
    (η_ss : AlgebraicGeometry.Spec (CommRingCat.of F_ss) ⟶ U_ss)
    (η_X : AlgebraicGeometry.Spec (CommRingCat.of F_ss) ⟶ X)
    (W : ValuationSubring F_ss)
    (hAff_ss : AlgebraicGeometry.IsAffine U_ss)
    (hProp_pX : AlgebraicGeometry.IsProper p_X)
    (hη_pX : η_X ≫ p_X = η_ss) :
    (∀ (ψ_ss : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ U_ss)
       (hT_ss : AlgebraicGeometry.IsAffineOpen (⊤ : U_ss.Opens))
       (φ_ss : U_ss.presheaf.obj (Opposite.op ⊤) ⟶ CommRingCat.of ↥W)
       (mW : AlgebraicGeometry.Spec (CommRingCat.of ↥W))
       (a b : ↑(U_ss.presheaf.obj (Opposite.op ⊤))),
      mW.asIdeal = IsLocalRing.maximalIdeal ↥W →
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype) ≫ ψ_ss = η_ss →
      AlgebraicGeometry.Spec.map φ_ss ≫ hT_ss.fromSpec = ψ_ss →
      ψ_ss.base mW ∈ U_ss.basicOpen b →
      (∀ t : ↥W,
        φ_ss.hom b * t = φ_ss.hom a →
        ∀ Q : Polynomial ↥V,
          (∃ i : ℕ, Q.coeff i ∉ (g_ss.base (ψ_ss.base mW)).asIdeal) →
          Polynomial.eval₂ (AlgebraicGeometry.Spec.preimage (ψ_ss ≫ g_ss)).hom t Q ∉
            IsLocalRing.maximalIdeal ↥W) →
      IsValResolvedOnMod V g_ss p_X η_X W) ∧
    (∀ (W₀ : ValuationSubring F_ss),
      W₀ ≤ W →
      (∀ x : ↥W, x ∈ IsLocalRing.maximalIdeal ↥W →
        ∃ hx₀ : W.subtype x ∈ W₀, (⟨W.subtype x, hx₀⟩ : ↥W₀) ∈ IsLocalRing.maximalIdeal ↥W₀) →
      IsValResolvedOnMod V g_ss p_X η_X W₀ →
      (∀ (ψ_ss : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ U_ss)
          (mW : AlgebraicGeometry.Spec (CommRingCat.of ↥W)),
        mW.asIdeal = IsLocalRing.maximalIdeal ↥W →
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype) ≫ ψ_ss = η_ss →
        (g_ss.base (ψ_ss.base mW)).asIdeal ≠ ⊥) →
      (∀ (P : Ideal ↥V) [P.IsPrime],
        P ≠ ⊥ →
        ∀ (B : Type u) [CommRing B] (p : Ideal B) [p.IsPrime] (γ_B : ↥V →+* B),
          Ideal.comap γ_B p = P →
          (∃ (b₁ b₂ : B),
            b₂ ∉ p ∧
            ∀ (R : Type u) [CommRing R] [IsLocalRing R] (ρ_B : B →+* R),
              Ideal.comap ρ_B (IsLocalRing.maximalIdeal R) = p →
              ∀ (t : R),
                ρ_B b₂ * t = ρ_B b₁ →
                ∀ (Q : Polynomial ↥V),
                  (∃ i : ℕ, Q.coeff i ∉ P) →
                  Polynomial.eval₂ (ρ_B.comp γ_B) t Q ∉ IsLocalRing.maximalIdeal R) ∨
          (∃ (hVal : ValuationRing (B ⧸ p)),
            letI : ValuationRing (B ⧸ p) := hVal
            let γ_D : ↥V →+* B ⧸ p := (Ideal.Quotient.mk p).comp γ_B
            let P₀ : Ideal ↥V := Ideal.comap γ_D (IsLocalRing.maximalIdeal (B ⧸ p))
            P ≤ P₀ ∧
            (∀ d : B ⧸ p, (∃ q : ↥V, d = γ_D q) ∨ (∃ q : ↥V, q ∉ P₀ ∧ γ_D q * d = 1)))) →
      IsValResolvedOnMod V g_ss p_X η_X W) :=
by
  have _ := hAff_ss
  have hPre_comp : ∀ {R₁ R₂ : CommRingCat.{u}} (φ : R₁ ⟶ R₂)
      (α : AlgebraicGeometry.Spec R₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V)),
      (AlgebraicGeometry.Spec.preimage (AlgebraicGeometry.Spec.map φ ≫ α)).hom =
        φ.hom.comp (AlgebraicGeometry.Spec.preimage α).hom := by
    intro R₁ R₂ φ α
    have h1 : AlgebraicGeometry.Spec.map (AlgebraicGeometry.Spec.preimage α ≫ φ) =
        AlgebraicGeometry.Spec.map φ ≫ α := by
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage]
    have h2 := congrArg AlgebraicGeometry.Spec.preimage h1
    rw [AlgebraicGeometry.Spec.preimage_map] at h2
    exact congrArg CommRingCat.Hom.hom h2.symm
  have hPre_comap : ∀ {R₁ : CommRingCat.{u}}
      (α : AlgebraicGeometry.Spec R₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
      (q : AlgebraicGeometry.Spec R₁),
      Ideal.comap (AlgebraicGeometry.Spec.preimage α).hom q.asIdeal = (α.base q).asIdeal := by
    intro R₁ α q
    conv_rhs => rw [← AlgebraicGeometry.Spec.map_preimage α]
    rfl
  refine ⟨?_, ?_⟩
  · intro ψ_ss hT_ss φ_ss mW a b hmW hη_ψss hφss_spec hu_basic hab_poly
    have hUniv : (AlgebraicGeometry.topologically @IsClosedMap).universally p_X := by
      have h := hProp_pX.toUniversallyClosed
      rwa [AlgebraicGeometry.universallyClosed_eq] at h
    have hSpecMap : (AlgebraicGeometry.topologically @SpecializingMap).universally p_X :=
      CategoryTheory.MorphismProperty.universally_mono
        (fun {_ _} _ hg => IsClosedMap.specializingMap hg) p_X hUniv
    have hEx : AlgebraicGeometry.ValuativeCriterion.Existence p_X :=
      AlgebraicGeometry.ValuativeCriterion.Existence.of_specializingMap p_X hSpecMap
    have hw : η_X ≫ p_X =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥W F_ss)) ≫ ψ_ss :=
      hη_pX.trans hη_ψss.symm
    let S_sq : AlgebraicGeometry.ValuativeCommSq p_X :=
      AlgebraicGeometry.ValuativeCommSq.mk ↥W F_ss η_X ψ_ss ⟨hw⟩
    have hHasLift := hEx S_sq
    obtain ⟨ℓ⟩ := hHasLift.exists_lift
    let ψ_X : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ X := ℓ.l
    have hη_ψX : AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype) ≫ ψ_X = η_X :=
      ℓ.fac_left
    have hψX_pX : ψ_X ≫ p_X = ψ_ss := ℓ.fac_right
    let V_b : U_ss.Opens := U_ss.basicOpen b
    have hx_pre : ψ_X.base mW ∈ (TopologicalSpace.Opens.map p_X.base).obj V_b := by
      change p_X.base (ψ_X.base mW) ∈ V_b
      have heq : p_X.base (ψ_X.base mW) = ψ_ss.base mW := by
        change (ψ_X ≫ p_X).base mW = ψ_ss.base mW
        rw [hψX_pX]
      rw [heq]
      exact hu_basic
    obtain ⟨U_X, hUX, hx_UX, hUX_sub_set⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hx_pre
    have hUX_sub : U_X ≤ (TopologicalSpace.Opens.map p_X.base).obj V_b := hUX_sub_set
    have hRange_UX : Set.range ⇑ψ_X ⊆ Set.range ⇑hUX.fromSpec := by
      rw [hUX.range_fromSpec]
      rintro _ ⟨q, rfl⟩
      change ψ_X.base q ∈ U_X
      have hq_le : q.asIdeal ≤ mW.asIdeal := by
        rw [hmW]
        exact IsLocalRing.le_maximalIdeal q.isPrime.ne_top
      have hcl_q : closure ({(q : PrimeSpectrum ↥W)} : Set (PrimeSpectrum ↥W)) =
          PrimeSpectrum.zeroLocus (q.asIdeal : Set ↥W) :=
        PrimeSpectrum.closure_singleton q
      have hmW_cl : mW ∈ closure ({q} : Set (AlgebraicGeometry.Spec (CommRingCat.of ↥W))) := by
        change (mW : PrimeSpectrum ↥W) ∈
          closure ({(q : PrimeSpectrum ↥W)} : Set (PrimeSpectrum ↥W))
        rw [hcl_q]
        exact hq_le
      let U_pre : Set (AlgebraicGeometry.Spec (CommRingCat.of ↥W)) :=
        (⇑ψ_X.base) ⁻¹' (U_X : Set X)
      have hOpen_pre : IsOpen U_pre := U_X.isOpen.preimage ψ_X.continuous
      have hmW_pre : mW ∈ U_pre := hx_UX
      by_contra hq_not
      have hcl_sub : closure ({q} : Set (AlgebraicGeometry.Spec (CommRingCat.of ↥W))) ⊆ U_preᶜ :=
        closure_minimal (Set.singleton_subset_iff.mpr hq_not) hOpen_pre.isClosed_compl
      exact hcl_sub hmW_cl hmW_pre
    have : AlgebraicGeometry.IsOpenImmersion hUX.fromSpec := hUX.isOpenImmersion_fromSpec
    let ψ_UX := AlgebraicGeometry.IsOpenImmersion.lift hUX.fromSpec ψ_X hRange_UX
    let φ_UX : X.presheaf.obj (Opposite.op U_X) ⟶ CommRingCat.of ↥W :=
      AlgebraicGeometry.Spec.preimage ψ_UX
    have hφUX_spec : AlgebraicGeometry.Spec.map φ_UX ≫ hUX.fromSpec = ψ_X := by
      dsimp [φ_UX, ψ_UX]
      rw [AlgebraicGeometry.Spec.map_preimage, AlgebraicGeometry.IsOpenImmersion.lift_fac]
    let res_Vb : U_ss.presheaf.obj (Opposite.op ⊤) ⟶ U_ss.presheaf.obj (Opposite.op V_b) :=
      U_ss.presheaf.map (CategoryTheory.homOfLE (U_ss.basicOpen_le b)).op
    have : IsLocalization.Away b ↑(U_ss.presheaf.obj (Opposite.op V_b)) :=
      hT_ss.isLocalization_basicOpen b
    let s_ab : ↑(U_ss.presheaf.obj (Opposite.op V_b)) :=
      IsLocalization.mk' ↑(U_ss.presheaf.obj (Opposite.op V_b)) a ⟨b, Submonoid.mem_powers b⟩
    have hs_ab : res_Vb.hom b * s_ab = res_Vb.hom a :=
      IsLocalization.mk'_spec' ↑(U_ss.presheaf.obj (Opposite.op V_b)) a ⟨b, Submonoid.mem_powers b⟩
    let α_Vb : U_ss.presheaf.obj (Opposite.op V_b) ⟶ X.presheaf.obj (Opposite.op U_X) :=
      p_X.appLE V_b U_X hUX_sub
    let f_X : ↑(X.presheaf.obj (Opposite.op U_X)) := α_Vb.hom s_ab
    have h_res_app : res_Vb ≫ α_Vb = p_X.appLE ⊤ U_X le_top :=
      p_X.map_appLE hUX_sub (CategoryTheory.homOfLE (U_ss.basicOpen_le b)).op
    have : AlgebraicGeometry.IsOpenImmersion hT_ss.fromSpec := hT_ss.isOpenImmersion_fromSpec
    have hcomp_φss : p_X.appLE ⊤ U_X le_top ≫ φ_UX = φ_ss := by
      apply AlgebraicGeometry.Spec.map_injective
      apply (CategoryTheory.cancel_mono hT_ss.fromSpec).mp
      rw [AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc,
        AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec p_X hT_ss hUX le_top,
        ← CategoryTheory.Category.assoc, hφUX_spec, hψX_pX, ← hφss_spec]
    have hcomp_all : (res_Vb ≫ α_Vb) ≫ φ_UX = φ_ss := by
      rw [h_res_app, hcomp_φss]
    have hmul_ab : φ_ss.hom b * φ_UX.hom f_X = φ_ss.hom a := by
      have hb_eq : φ_ss.hom b = φ_UX.hom (α_Vb.hom (res_Vb.hom b)) := by
        rw [← hcomp_all]
        rfl
      have ha_eq : φ_ss.hom a = φ_UX.hom (α_Vb.hom (res_Vb.hom a)) := by
        rw [← hcomp_all]
        rfl
      rw [hb_eq, ha_eq]
      dsimp [f_X]
      rw [← map_mul, ← map_mul, hs_ab]
    refine ⟨ψ_X, mW, U_X, hUX, φ_UX, f_X, hmW, hη_ψX, hx_UX, hφUX_spec, ?_⟩
    intro Q hQ
    rw [hψX_pX] at hQ
    rw [← CategoryTheory.Category.assoc, hψX_pX]
    exact hab_poly (φ_UX.hom f_X) hmul_ab Q hQ
  · intro W₀ hW₀_le hmW_le hRes_W₀ hNonzero hDicho
    obtain ⟨ψ_X0, mW₀, U_X0, hUX0, φ_X0, f_X0, hmW₀, hη_ψX0, _hx0_mem, hφX0_spec, hfX0_poly⟩ :=
      hRes_W₀
    let i_W : ↥W₀ →+* ↥W := Subring.inclusion hW₀_le
    let ψ_X : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ X :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom i_W) ≫ ψ_X0
    let φ_X1 : ↑(X.presheaf.obj (Opposite.op U_X0)) →+* ↥W := i_W.comp φ_X0.hom
    let mW : AlgebraicGeometry.Spec (CommRingCat.of ↥W) :=
      ⟨IsLocalRing.maximalIdeal ↥W, inferInstance⟩
    have hmW : mW.asIdeal = IsLocalRing.maximalIdeal ↥W := rfl
    have hη_ψX : AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype) ≫ ψ_X = η_X := by
      dsimp [ψ_X]
      rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
      have hcomp_sub : CommRingCat.ofHom i_W ≫ CommRingCat.ofHom W.subtype =
          CommRingCat.ofHom W₀.subtype := by
        ext x
        rfl
      rw [hcomp_sub, hη_ψX0]
    have hφX1_spec : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_X1) ≫ hUX0.fromSpec = ψ_X := by
      have hcomp_φ : CommRingCat.ofHom φ_X1 = φ_X0 ≫ CommRingCat.ofHom i_W := rfl
      rw [hcomp_φ, AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc, hφX0_spec]
    let q₀ : Ideal ↑(X.presheaf.obj (Opposite.op U_X0)) :=
      Ideal.comap φ_X0.hom (IsLocalRing.maximalIdeal ↥W₀)
    let q₁ : Ideal ↑(X.presheaf.obj (Opposite.op U_X0)) :=
      Ideal.comap φ_X1 (IsLocalRing.maximalIdeal ↥W)
    have hq₀_prime : q₀.IsPrime := Ideal.IsPrime.comap φ_X0.hom
    have hq₁_prime : q₁.IsPrime := Ideal.IsPrime.comap φ_X1
    have hq₁_le_q₀ : q₁ ≤ q₀ := by
      intro b hb
      obtain ⟨hx₀, hmem₀⟩ := hmW_le (φ_X1 b) hb
      have heq₀ : (⟨W.subtype (φ_X1 b), hx₀⟩ : ↥W₀) = φ_X0.hom b := Subtype.ext rfl
      rw [heq₀] at hmem₀
      exact hmem₀
    let γ_X : ↥V →+* ↑(X.presheaf.obj (Opposite.op U_X0)) :=
      (AlgebraicGeometry.Spec.preimage (hUX0.fromSpec ≫ p_X ≫ g_ss)).hom
    let P'_0 : Ideal ↥V := Ideal.comap γ_X q₀
    let P'_s : Ideal ↥V := Ideal.comap γ_X q₁
    have hP'0_prime : P'_0.IsPrime := Ideal.IsPrime.comap γ_X
    have hP's_prime : P'_s.IsPrime := Ideal.IsPrime.comap γ_X
    have hPre_X0 : (AlgebraicGeometry.Spec.preimage (ψ_X0 ≫ p_X ≫ g_ss)).hom =
        φ_X0.hom.comp γ_X := by
      conv_lhs => rw [← hφX0_spec, CategoryTheory.Category.assoc]
      exact hPre_comp φ_X0 (hUX0.fromSpec ≫ p_X ≫ g_ss)
    have hP'0_eq : (g_ss.base ((ψ_X0 ≫ p_X).base mW₀)).asIdeal = P'_0 := by
      change ((ψ_X0 ≫ p_X ≫ g_ss).base mW₀).asIdeal = P'_0
      rw [← hPre_comap (ψ_X0 ≫ p_X ≫ g_ss) mW₀, hPre_X0, hmW₀]
      rfl
    have hPre_X1 : (AlgebraicGeometry.Spec.preimage (ψ_X ≫ p_X ≫ g_ss)).hom =
        φ_X1.comp γ_X := by
      conv_lhs => rw [← hφX1_spec, CategoryTheory.Category.assoc]
      exact hPre_comp (CommRingCat.ofHom φ_X1) (hUX0.fromSpec ≫ p_X ≫ g_ss)
    have hP's_eq : (g_ss.base ((ψ_X ≫ p_X).base mW)).asIdeal = P'_s := by
      change ((ψ_X ≫ p_X ≫ g_ss).base mW).asIdeal = P'_s
      rw [← hPre_comap (ψ_X ≫ p_X ≫ g_ss) mW, hPre_X1, hmW]
      rfl
    have hP's_ne : P'_s ≠ ⊥ := by
      have hη_ψss : AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype) ≫ (ψ_X ≫ p_X) =
          η_ss := by
        rw [← CategoryTheory.Category.assoc, hη_ψX, hη_pX]
      rw [← hP's_eq]
      exact hNonzero (ψ_X ≫ p_X) mW hmW hη_ψss
    rcases hDicho P'_s hP's_ne ↑(X.presheaf.obj (Opposite.op U_X0)) q₁ γ_X rfl with
      ⟨b₁, b₂, hb₂_not_q1, hb_poly⟩ | ⟨hVal, _hle, hLin⟩
    · let U_X1 : X.Opens := X.basicOpen b₂
      let hUX1 : AlgebraicGeometry.IsAffineOpen U_X1 := hUX0.basicOpen b₂
      have hx_UX1 : ψ_X.base mW ∈ U_X1 := by
        let q_x1 : AlgebraicGeometry.Spec (X.presheaf.obj (Opposite.op U_X0)) :=
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_X1)).base mW
        have hqx1_mem : q_x1 ∈ PrimeSpectrum.basicOpen b₂ :=
          (PrimeSpectrum.mem_basicOpen b₂ q_x1).mpr hb₂_not_q1
        rw [← hUX0.fromSpec_preimage_basicOpen b₂] at hqx1_mem
        have hfb : hUX0.fromSpec.base q_x1 ∈ U_X1 := hqx1_mem
        have heq_x1 : hUX0.fromSpec.base q_x1 = ψ_X.base mW := by
          change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_X1) ≫ hUX0.fromSpec).base mW =
            ψ_X.base mW
          rw [hφX1_spec]
        rwa [heq_x1] at hfb
      have hb₂_unit : IsUnit (φ_X1 b₂) :=
        IsLocalRing.notMem_maximalIdeal.mp hb₂_not_q1
      have : IsLocalization.Away b₂ ↑(X.presheaf.obj (Opposite.op U_X1)) :=
        hUX0.isLocalization_basicOpen b₂
      let φ_UX1_hom : ↑(X.presheaf.obj (Opposite.op U_X1)) →+* ↥W :=
        IsLocalization.Away.lift b₂ hb₂_unit
      let φ_UX1 : X.presheaf.obj (Opposite.op U_X1) ⟶ CommRingCat.of ↥W :=
        CommRingCat.ofHom φ_UX1_hom
      let res_b₂ : X.presheaf.obj (Opposite.op U_X0) ⟶ X.presheaf.obj (Opposite.op U_X1) :=
        X.presheaf.map (CategoryTheory.homOfLE (X.basicOpen_le b₂)).op
      have hres_φUX1 : res_b₂ ≫ φ_UX1 = CommRingCat.ofHom φ_X1 :=
        CommRingCat.Hom.ext (RingHom.ext fun x =>
          IsLocalization.Away.lift_eq (S := ↑(X.presheaf.obj (Opposite.op U_X1))) b₂ hb₂_unit x)
      have hφUX1_spec : AlgebraicGeometry.Spec.map φ_UX1 ≫ hUX1.fromSpec = ψ_X := by
        have hmap_from := hUX0.map_fromSpec hUX1 (CategoryTheory.homOfLE (X.basicOpen_le b₂)).op
        rw [← hmap_from, ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
          hres_φUX1, hφX1_spec]
      let f_X1 : ↑(X.presheaf.obj (Opposite.op U_X1)) :=
        IsLocalization.mk' ↑(X.presheaf.obj (Opposite.op U_X1)) b₁ ⟨b₂, Submonoid.mem_powers b₂⟩
      have hmul_b : φ_X1 b₂ * φ_UX1.hom f_X1 = φ_X1 b₁ := by
        have hmk : res_b₂.hom b₂ * f_X1 = res_b₂.hom b₁ :=
          IsLocalization.mk'_spec' ↑(X.presheaf.obj (Opposite.op U_X1)) b₁
            ⟨b₂, Submonoid.mem_powers b₂⟩
        have h1 := congrArg φ_UX1.hom hmk
        rw [map_mul] at h1
        have hl : φ_UX1.hom (res_b₂.hom b₂) = φ_X1 b₂ :=
          IsLocalization.Away.lift_eq b₂ hb₂_unit b₂
        have hr : φ_UX1.hom (res_b₂.hom b₁) = φ_X1 b₁ :=
          IsLocalization.Away.lift_eq b₂ hb₂_unit b₁
        rwa [hl, hr] at h1
      refine ⟨ψ_X, mW, U_X1, hUX1, φ_UX1, f_X1, hmW, hη_ψX, hx_UX1, hφUX1_spec, ?_⟩
      intro Q hQ
      rw [hP's_eq] at hQ
      rw [hPre_X1]
      exact hb_poly ↥W φ_X1 rfl (φ_UX1.hom f_X1) hmul_b Q hQ
    · exfalso
      have : ValuationRing (↑(X.presheaf.obj (Opposite.op U_X0)) ⧸ q₁) := hVal
      rcases hLin (Ideal.Quotient.mk q₁ f_X0) with ⟨q, hq_eq⟩ | ⟨q, _hq_not_P0, hqd_one⟩
      · have hsub_q1 : f_X0 - γ_X q ∈ q₁ := Ideal.Quotient.eq.mp hq_eq
        have hmem_1 : φ_X0.hom (f_X0 - γ_X q) ∈ IsLocalRing.maximalIdeal ↥W₀ :=
          hq₁_le_q₀ hsub_q1
        let Q₁ : Polynomial ↥V := Polynomial.X - Polynomial.C q
        have hQ₁_coeff : ∃ i : ℕ, Q₁.coeff i ∉ (g_ss.base ((ψ_X0 ≫ p_X).base mW₀)).asIdeal := by
          refine ⟨1, ?_⟩
          rw [hP'0_eq]
          have hc1 : Q₁.coeff 1 = 1 := by
            simp only [Q₁, Polynomial.coeff_sub, Polynomial.coeff_X_one,
              Polynomial.coeff_C_succ, sub_zero]
          rw [hc1]
          exact fun h1 => hP'0_prime.ne_top ((Ideal.eq_top_iff_one P'_0).mpr h1)
        have heval_1 : Polynomial.eval₂
            (AlgebraicGeometry.Spec.preimage (ψ_X0 ≫ p_X ≫ g_ss)).hom
            (φ_X0.hom f_X0) Q₁ ∈ IsLocalRing.maximalIdeal ↥W₀ := by
          rw [hPre_X0]
          have heq_ev : Polynomial.eval₂ (φ_X0.hom.comp γ_X) (φ_X0.hom f_X0) Q₁ =
              φ_X0.hom (f_X0 - γ_X q) := by
            simp only [Q₁, Polynomial.eval₂_sub, Polynomial.eval₂_X, Polynomial.eval₂_C,
              RingHom.comp_apply, map_sub]
          rw [heq_ev]
          exact hmem_1
        exact hfX0_poly Q₁ hQ₁_coeff heval_1
      · have hqd_mk : Ideal.Quotient.mk q₁ (γ_X q * f_X0) = Ideal.Quotient.mk q₁ 1 := hqd_one
        have hsub_q1 : γ_X q * f_X0 - 1 ∈ q₁ := Ideal.Quotient.eq.mp hqd_mk
        have hsub_q0 : γ_X q * f_X0 - 1 ∈ q₀ := hq₁_le_q₀ hsub_q1
        have hmem_2 : φ_X0.hom (γ_X q * f_X0 - 1) ∈ IsLocalRing.maximalIdeal ↥W₀ := hsub_q0
        have hq_not_P'0 : q ∉ P'_0 := by
          intro hq
          have hmul_q0 : γ_X q * f_X0 ∈ q₀ := q₀.mul_mem_right f_X0 hq
          have hone_q0 : (1 : ↑(X.presheaf.obj (Opposite.op U_X0))) ∈ q₀ := by
            have hdiff := q₀.sub_mem hmul_q0 hsub_q0
            simpa only [sub_sub_cancel] using hdiff
          exact hq₀_prime.ne_top ((Ideal.eq_top_iff_one q₀).mpr hone_q0)
        let Q₂ : Polynomial ↥V := Polynomial.C q * Polynomial.X - 1
        have hQ₂_coeff : ∃ i : ℕ, Q₂.coeff i ∉ (g_ss.base ((ψ_X0 ≫ p_X).base mW₀)).asIdeal := by
          refine ⟨1, ?_⟩
          rw [hP'0_eq]
          have hc2 : Q₂.coeff 1 = q := by
            simp only [Q₂, Polynomial.coeff_sub, Polynomial.coeff_C_mul, Polynomial.coeff_X_one,
              Polynomial.coeff_one, mul_one, one_ne_zero, ↓reduceIte, sub_zero]
          rwa [hc2]
        have heval_2 : Polynomial.eval₂
            (AlgebraicGeometry.Spec.preimage (ψ_X0 ≫ p_X ≫ g_ss)).hom
            (φ_X0.hom f_X0) Q₂ ∈ IsLocalRing.maximalIdeal ↥W₀ := by
          rw [hPre_X0]
          have heq_ev : Polynomial.eval₂ (φ_X0.hom.comp γ_X) (φ_X0.hom f_X0) Q₂ =
              φ_X0.hom (γ_X q * f_X0 - 1) := by
            simp only [Q₂, Polynomial.eval₂_sub, Polynomial.eval₂_mul, Polynomial.eval₂_C,
              Polynomial.eval₂_X, Polynomial.eval₂_one, RingHom.comp_apply, map_sub, map_mul,
              map_one]
          rw [heq_ev]
          exact hmem_2
        exact hfX0_poly Q₂ hQ₂_coeff heval_2

theorem weil_divisorial_specialization_and_overring_propagation (K : Type u) [Field K] (m : ℕ)
    (V : ValuationSubring K)
    (hPkg : IsValuationRingAlgPackage m V)
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (n : ℕ)
    (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (C' : AlgebraicGeometry.Scheme.{u})
    (g' : C' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (τ' : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C'))
    (ι' : C_K ⟶ C')
    (hMod' : IsValuationPointedCurveModel V p_K n σ_K C' g' τ' ι')
    (U' : C'.Opens)
    (U_ss : AlgebraicGeometry.Scheme.{u})
    (g_ss : U_ss ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (hAff_ss : AlgebraicGeometry.IsAffine U_ss)
    (hSS : IsStrictlySemistableCurveOverValuation V g_ss)
    (h_mod : U'.toScheme ⟶ U_ss)
    (hProp_mod : AlgebraicGeometry.IsProper h_mod)
    (hComm_mod : h_mod ≫ g_ss = U'.ι ≫ g')
    (F_ss : Type u) [Field F_ss]
    (η_ss : AlgebraicGeometry.Spec (CommRingCat.of F_ss) ⟶ U_ss)
    (hFunc_ss : IsSchemeFunctionField U_ss F_ss η_ss)
    (η_U' : AlgebraicGeometry.Spec (CommRingCat.of F_ss) ⟶ U'.toScheme)
    (hηU'_ss : η_U' ≫ h_mod = η_ss)
    (hFunc_U' : IsSchemeFunctionField U'.toScheme F_ss η_U')
    (X : AlgebraicGeometry.Scheme.{u})
    (g_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (p_X : X ⟶ U_ss)
    (η_X : AlgebraicGeometry.Spec (CommRingCat.of F_ss) ⟶ X)
    (hSS_X : IsStrictlySemistableCurveOverValuation V g_X)
    (hProp_pX : AlgebraicGeometry.IsProper p_X)
    (hComm_pX : p_X ≫ g_ss = g_X)
    (hη_pX : η_X ≫ p_X = η_ss)
    (hRes_div : ∀ W₀ : ValuationSubring F_ss,
      IsDivisorialClosedVal V g_ss η_ss W₀ →
      IsValResolvedOnMod V g_ss h_mod η_U' W₀ →
      IsValResolvedOnMod V g_ss p_X η_X W₀)
    (W : ValuationSubring F_ss)
    (hRes_U' : IsValResolvedOnMod V g_ss h_mod η_U' W)
    (hNonzero : ∀ (ψ_ss : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ U_ss)
        (mW : AlgebraicGeometry.Spec (CommRingCat.of ↥W)),
      mW.asIdeal = IsLocalRing.maximalIdeal ↥W →
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype) ≫ ψ_ss = η_ss →
      (g_ss.base (ψ_ss.base mW)).asIdeal ≠ ⊥) :
    IsValResolvedOnMod V g_ss p_X η_X W :=
by
  letI : AlgebraicGeometry.IsAffine U_ss := hAff_ss
  obtain ⟨hDicho, hClear, hVand⟩ :=
    weil_valuation_overring_dichotomy_and_vandermonde_avoidance K V
  have hAlgClosed : ∀ (P : Ideal ↥V) [P.IsPrime], P ≠ ⊥ → IsAlgClosed P.ResidueField :=
    hPkg.2.2.2.2.1
  obtain ⟨hLiftBase, hPropOver⟩ :=
    weil_val_resolved_base_lift_and_overring_propagation K V U_ss X g_ss p_X F_ss η_ss η_X W
      hAff_ss hProp_pX hη_pX
  obtain ⟨ψ_U', mW, U, hU, φ_U, f, hmW, hη_ψU', hyU, hφU_spec, hf_poly⟩ := hRes_U'
  let ψ_ss : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ U_ss := ψ_U' ≫ h_mod
  have hη_ψss : AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype) ≫ ψ_ss = η_ss := by
    dsimp [ψ_ss]
    rw [← CategoryTheory.Category.assoc, hη_ψU', hηU'_ss]
  have hPs_ne : (g_ss.base (ψ_ss.base mW)).asIdeal ≠ ⊥ :=
    hNonzero ψ_ss mW hmW hη_ψss
  have hPre_comp : ∀ {R₁ R₂ : CommRingCat.{u}} (φ : R₁ ⟶ R₂)
      (α : AlgebraicGeometry.Spec R₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V)),
      (AlgebraicGeometry.Spec.preimage (AlgebraicGeometry.Spec.map φ ≫ α)).hom =
        φ.hom.comp (AlgebraicGeometry.Spec.preimage α).hom := by
    intro R₁ R₂ φ α
    have h1 : AlgebraicGeometry.Spec.map (AlgebraicGeometry.Spec.preimage α ≫ φ) =
        AlgebraicGeometry.Spec.map φ ≫ α := by
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage]
    have h2 := congrArg AlgebraicGeometry.Spec.preimage h1
    rw [AlgebraicGeometry.Spec.preimage_map] at h2
    exact congrArg CommRingCat.Hom.hom h2.symm
  have hPre_comap : ∀ {R₁ : CommRingCat.{u}}
      (α : AlgebraicGeometry.Spec R₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
      (q : AlgebraicGeometry.Spec R₁),
      Ideal.comap (AlgebraicGeometry.Spec.preimage α).hom q.asIdeal = (α.base q).asIdeal := by
    intro R₁ α q
    conv_rhs => rw [← AlgebraicGeometry.Spec.map_preimage α]
    rfl
  let hT_ss : AlgebraicGeometry.IsAffineOpen (⊤ : U_ss.Opens) :=
    AlgebraicGeometry.isAffineOpen_top U_ss
  let φ_ss : U_ss.presheaf.obj (Opposite.op ⊤) ⟶ CommRingCat.of ↥W :=
    AlgebraicGeometry.Spec.preimage (ψ_ss ≫ U_ss.isoSpec.hom)
  have hφss_spec : AlgebraicGeometry.Spec.map φ_ss ≫ hT_ss.fromSpec = ψ_ss := by
    dsimp [φ_ss, hT_ss]
    rw [AlgebraicGeometry.Spec.map_preimage, AlgebraicGeometry.IsAffineOpen.fromSpec_top,
      CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id,
      CategoryTheory.Category.comp_id]
  let A_ss : Type u := ↑(U_ss.presheaf.obj (Opposite.op ⊤))
  letI : CommRing A_ss := inferInstanceAs (CommRing ↑(U_ss.presheaf.obj (Opposite.op ⊤)))
  let u : U_ss := ψ_ss.base mW
  let q_u : AlgebraicGeometry.Spec (U_ss.presheaf.obj (Opposite.op ⊤)) :=
    hT_ss.primeIdealOf ⟨u, trivial⟩
  let p_u : Ideal A_ss := q_u.asIdeal
  haveI : p_u.IsPrime := q_u.isPrime
  let P_s : Ideal ↥V := (g_ss.base u).asIdeal
  haveI : P_s.IsPrime := (g_ss.base u).isPrime
  let γ_Ass : ↥V →+* A_ss :=
    (AlgebraicGeometry.Spec.preimage (hT_ss.fromSpec ≫ g_ss)).hom
  have hqu_eq : q_u = (AlgebraicGeometry.Spec.map φ_ss).base mW := by
    apply (AlgebraicGeometry.Scheme.Hom.isOpenEmbedding hT_ss.fromSpec).injective
    have hL : hT_ss.fromSpec.base q_u = u := hT_ss.fromSpec_primeIdealOf ⟨u, trivial⟩
    have hR : hT_ss.fromSpec.base ((AlgebraicGeometry.Spec.map φ_ss).base mW) = u := by
      change (AlgebraicGeometry.Spec.map φ_ss ≫ hT_ss.fromSpec).base mW = u
      rw [hφss_spec]
    exact hL.trans hR.symm
  have hpu_comap : Ideal.comap φ_ss.hom (IsLocalRing.maximalIdeal ↥W) = p_u := by
    rw [← hmW]
    change ((AlgebraicGeometry.Spec.map φ_ss).base mW).asIdeal = q_u.asIdeal
    rw [hqu_eq]
  have hγ_Ass_comap : Ideal.comap γ_Ass p_u = P_s := by
    have hc := hPre_comap (hT_ss.fromSpec ≫ g_ss) q_u
    have hbase : ((hT_ss.fromSpec ≫ g_ss).base q_u).asIdeal = P_s := by
      change (g_ss.base (hT_ss.fromSpec.base q_u)).asIdeal = P_s
      rw [hT_ss.fromSpec_primeIdealOf ⟨u, trivial⟩]
    exact hc.trans hbase
  have hPre_ψss : (AlgebraicGeometry.Spec.preimage (ψ_ss ≫ g_ss)).hom =
      φ_ss.hom.comp γ_Ass := by
    conv_lhs => rw [← hφss_spec, CategoryTheory.Category.assoc]
    exact hPre_comp φ_ss (hT_ss.fromSpec ≫ g_ss)
  rcases hDicho P_s (hAlgClosed P_s hPs_ne) A_ss p_u γ_Ass hγ_Ass_comap with
    ⟨a, b, hb_not_pu, ha_poly⟩ | ⟨hValDu, hPs_le_P0, hDu_lin, _⟩
  · have hu_basic : ψ_ss.base mW ∈ U_ss.basicOpen b := by
      have hqb : q_u ∈ PrimeSpectrum.basicOpen b :=
        (PrimeSpectrum.mem_basicOpen b q_u).mpr hb_not_pu
      rw [← hT_ss.fromSpec_preimage_basicOpen b] at hqb
      have hfb : hT_ss.fromSpec.base q_u ∈ U_ss.basicOpen b := hqb
      rwa [hT_ss.fromSpec_primeIdealOf ⟨u, trivial⟩] at hfb
    refine hLiftBase ψ_ss hT_ss φ_ss mW a b hmW hη_ψss hφss_spec hu_basic ?_
    intro t ht Q hQ
    rw [hPre_ψss]
    exact ha_poly ↥W φ_ss.hom hpu_comap t ht Q hQ
  · let D_u : Type u := A_ss ⧸ p_u
    letI : CommRing D_u := inferInstanceAs (CommRing (A_ss ⧸ p_u))
    haveI : IsDomain D_u := Ideal.Quotient.isDomain p_u
    letI : ValuationRing D_u := hValDu
    let mk_pu : A_ss →+* D_u := Ideal.Quotient.mk p_u
    let γ_Du : ↥V →+* D_u := mk_pu.comp γ_Ass
    let ι_D : AlgebraicGeometry.Spec (CommRingCat.of D_u) ⟶ U_ss :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom mk_pu) ≫ hT_ss.fromSpec
    have hCl_mk : AlgebraicGeometry.IsClosedImmersion
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom mk_pu :
          U_ss.presheaf.obj (Opposite.op ⊤) ⟶ CommRingCat.of D_u)) :=
      AlgebraicGeometry.IsClosedImmersion.spec_of_surjective _ Ideal.Quotient.mk_surjective
    have hCl_fromSpec : AlgebraicGeometry.IsClosedImmersion hT_ss.fromSpec := by
      rw [AlgebraicGeometry.IsAffineOpen.fromSpec_top]
      infer_instance
    have hCl_ιD : AlgebraicGeometry.IsClosedImmersion ι_D := by
      haveI := hCl_mk
      haveI := hCl_fromSpec
      dsimp [ι_D]
      infer_instance
    let m_D : AlgebraicGeometry.Spec (CommRingCat.of D_u) :=
      ⟨IsLocalRing.maximalIdeal D_u, inferInstance⟩
    have hm_D : m_D.asIdeal = IsLocalRing.maximalIdeal D_u := rfl
    have hmD_closed : IsClosed ({m_D} : Set (AlgebraicGeometry.Spec (CommRingCat.of D_u))) := by
      rw [← closure_eq_iff_isClosed]
      have hcl : closure ({m_D} : Set (PrimeSpectrum D_u)) =
