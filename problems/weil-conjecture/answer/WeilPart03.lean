    have hv_idem : IsIdempotentElem v_ind := by
      ext I
      change (if I = I₀ then (1 : A_bar ⧸ I.asIdeal) else 0) *
          (if I = I₀ then 1 else 0) = if I = I₀ then 1 else 0
      by_cases h : I = I₀ <;> simp [h]
    let e_quot : A_bar ⧸ nilradical A_bar := eqv.symm v_ind
    have he_quot_idem : IsIdempotentElem e_quot := by
      change eqv.symm v_ind * eqv.symm v_ind = eqv.symm v_ind
      rw [← map_mul, hv_idem.eq]
