    let η_V := AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)
    have hDom_ηV : AlgebraicGeometry.IsDominant η_V := by
      rw [AlgebraicGeometry.isDominant_iff]
      intro q
      rw [mem_closure_iff]
      intro U hU_open hq
      let pt_K : ↥(AlgebraicGeometry.Spec (CommRingCat.of K)) := ⟨⊥, hbot_K⟩
      let p₀_ps : PrimeSpectrum ↥V := η_V pt_K
      let q_ps : PrimeSpectrum ↥V := q
      have hbot : p₀_ps.asIdeal = ⊥ := by
