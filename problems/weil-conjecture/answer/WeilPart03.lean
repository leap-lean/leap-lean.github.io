        rwa [inv_div] at h_inv
      exact ⟨fun h0 => hθ_ne (Subtype.ext h0), hq_pos i, hθy_Vx⟩
    · obtain ⟨f, hf_flt, rfl⟩ := Finset.mem_image.mp hp_S₁
      obtain ⟨hf_nz, hAB⟩ := Finset.mem_filter.mp hf_flt
