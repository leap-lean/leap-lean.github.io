    have hRes : ∀ w : L, w ∈ O → ∃ c : E, w - algebraMap E L c = 0 ∨ (w - algebraMap E L c)⁻¹ ∉ O := by
      let φ_E : E →+* IsLocalRing.ResidueField ↥O :=
