    have hz0_closed : IsClosed ({ι_D.base m_D} : Set U_ss) := by
      rw [← Set.image_singleton]
      exact (AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding ι_D).isClosedMap _ hmD_closed
    let P_0 : Ideal ↥V := Ideal.comap γ_Du (IsLocalRing.maximalIdeal D_u)
    have hP0_eq : (g_ss.base (ι_D.base m_D)).asIdeal = P_0 := by
