        let Kt₁ : IntermediateField ↥E_max ↥L1_coeff :=
          IntermediateField.adjoin ↥E_max ({T_alg} : Set ↥L1_coeff)
        have hFinSep_Kt : FiniteDimensional ↥Kt ↥L_coeff ∧ Algebra.IsSeparable ↥Kt ↥L_coeff := hSepCoeff
        let χ : ↥L_coeff →ₐ[↥E_max] ↥L1_coeff :=
          { toRingHom := inc_F0_L1.comp e_F₀.toRingHom
