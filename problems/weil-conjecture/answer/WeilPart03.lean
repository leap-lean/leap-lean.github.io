        apply top_unique
        rw [← hα₀, IntermediateField.adjoin_simple_le_iff]
        exact zero_mem _
      · simpa [α_bar, h0] using hα₀
    have hα_alg : Algebra.adjoin κ ({α_bar} : Set κ') = ⊤ := by
      have halg : IsAlgebraic κ α_bar := Algebra.IsAlgebraic.isAlgebraic α_bar
      rw [← IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic halg, hα_adjoin]
