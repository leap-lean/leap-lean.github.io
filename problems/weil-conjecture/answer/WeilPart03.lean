    have _ : IsLocalHom (algebraMap ↥OL ↥OF) :=
      ⟨fun b hb => (hUnit_OL b).mpr ((hUnit_OF (algebraMap ↥OL ↥OF b)).mp hb)⟩
    have _ : Algebra.Etale ↥OL ↥OF := RingHom.etale_algebraMap.mp hEt
    obtain ⟨hSep_res, hMap_max⟩ :=
