    refine ⟨AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_nod), hOpen, ?_⟩
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hφ_C, CommRingCat.ofHom_comp]
  
  have hLinQuotPkg : ∀ (B : Type u) [CommRing B] (s c : B), IsUnit s →
