    have hN_top : N = ⊤ := (IsLocalRing.map_mkQ_eq_top (N := N)).mp hN_quot
    let W_F : Submodule ↥L F_hat := Submodule.span ↥L (Set.range fun j : Fin d => (v j : F_hat))
    have hOF_sub : ∀ y : ↥OF, (y : F_hat) ∈ W_F := by
