      have hResX_W₀ : IsValResolvedOnMod V g_ss p_X η_X W₀ :=
        hRes_div W₀ hDiv_W₀ hResU'_W₀
      refine hPropOver W₀ hW₀_le hmW_le hResX_W₀ hNonzero ?_
      intro P _ hP_ne B _ p _ γ_B hcomap_P
      rcases hDicho P (hAlgClosed P hP_ne) B p γ_B hcomap_P with hB1 | ⟨hVal, hle, hlin, _⟩
      · exact Or.inl hB1
      · exact Or.inr ⟨hVal, hle, hlin⟩
    · exfalso
      apply hNotLin
      intro d
      rcases hB0_lin d with ⟨q, hq⟩ | ⟨q, hq_not_P1, hqd⟩
      · exact Or.inl ⟨q, hq⟩
      · have hq_not_mD : q ∉ (g_ss.base (ι_D.base m_D)).asIdeal := by
          rw [hP0_eq]
          exact fun hq_P0 => hq_not_P1 (hP0_le_P1 hq_P0)
        exact Or.inr ⟨q, hq_not_mD, hqd⟩

theorem weil_fiber_infinite_nested_primes_and_trdeg_dichotomy (K : Type u) [Field K]
    (V : ValuationSubring K)
    (F_ss : Type u) [Field F_ss]
    (φ_KF : K →+* F_ss)
    (hTwoVar : ∀ (W : ValuationSubring F_ss)
        (hV : ∀ c : ↥V, φ_KF (V.subtype c) ∈ W)
        (P : Ideal ↥V) [P.IsPrime],
      (∀ c : ↥V,
        ((⟨φ_KF (V.subtype c), hV c⟩ : ↥W) ∈ IsLocalRing.maximalIdeal ↥W ↔ c ∈ P)) →
      ¬ ∃ (t₁ t₂ : ↥W),
        ∀ (Q : MvPolynomial (Fin 2) ↥V),
          (∃ d : Fin 2 →₀ ℕ, Q.coeff d ∉ P) →
          MvPolynomial.eval₂ ((φ_KF.comp V.subtype).codRestrict W.toSubring hV) ![t₁, t₂] Q ∉
            IsLocalRing.maximalIdeal ↥W)
    (P_s : Ideal ↥V) [P_s.IsPrime] [IsAlgClosed P_s.ResidueField]
    (B_U B_X B_C : Type u) [CommRing B_U] [CommRing B_X] [CommRing B_C] [IsDomain B_C]
    (β : B_U →+* B_C)
    (α : B_X →+* B_C)
    (γ_X : ↥V →+* B_X)
    (φ_C : B_C →+* F_ss)
    (hFT : α.FiniteType)
    (hInjC : Function.Injective φ_C)
    (hCompat : ∀ c : ↥V, φ_C (α (γ_X c)) = φ_KF (V.subtype c))
    (hGen : Subring.closure (Set.range β ∪ Set.range α) = ⊤)
    (p : Ideal B_X) [p.IsPrime]
    (hp_comap : Ideal.comap γ_X p = P_s)
    (hInf : letI : Algebra B_X B_C := α.toAlgebra; ¬ (p.primesOver B_C).Finite) :
    ∃ (W : ValuationSubring F_ss)
      (hV : ∀ c : ↥V, φ_KF (V.subtype c) ∈ W)
      (ρ_C : B_C →+* ↥W)
      (c_star : B_U),
      W.subtype.comp ρ_C = φ_C ∧
      Ideal.comap (ρ_C.comp α) (IsLocalRing.maximalIdeal ↥W) = p ∧
      (∀ P : Polynomial ↥V,
        (∃ i : ℕ, P.coeff i ∉ P_s) →
        Polynomial.eval₂ ((φ_KF.comp V.subtype).codRestrict W.toSubring hV)
          (ρ_C (β c_star)) P ∉ IsLocalRing.maximalIdeal ↥W) ∧
      (∀ (d r : B_X), r ∉ p →
        ∃ (c₀ s₀ : ↥V), s₀ ∉ P_s ∧ γ_X s₀ * d - γ_X c₀ * r ∈ p) :=
by
  classical
  
  let _ : Algebra B_X B_C := α.toAlgebra
  have _ : Algebra.FiniteType B_X B_C := hFT
  have _ : IsNoetherianRing (p.Fiber B_C) :=
    Algebra.FiniteType.isNoetherianRing p.ResidueField (p.Fiber B_C)
  let e := PrimeSpectrum.primesOverOrderIsoFiber B_X B_C p
  have _ : Infinite ↑(p.primesOver B_C) := Set.infinite_coe_iff.mpr hInf
  have _ : Infinite (PrimeSpectrum (p.Fiber B_C)) :=
    (Equiv.infinite_iff e.toEquiv).mp inferInstance
  have hFinMin : {y : PrimeSpectrum (p.Fiber B_C) | IsMin y}.Finite := by
    have hsub : {y : PrimeSpectrum (p.Fiber B_C) | IsMin y} =
        PrimeSpectrum.asIdeal ⁻¹' minimalPrimes (p.Fiber B_C) := by
      ext y
      exact PrimeSpectrum.isMin_iff
    rw [hsub]
    exact (minimalPrimes.finite_of_isNoetherianRing (p.Fiber B_C)).preimage
      (fun _ _ _ _ h => PrimeSpectrum.ext h)
  obtain ⟨y₁, hy₁_not_min⟩ := hFinMin.exists_notMem
  change ¬ IsMin y₁ at hy₁_not_min
  rw [not_isMin_iff] at hy₁_not_min
  obtain ⟨y₀, hy₀_lt⟩ := hy₁_not_min
  let Q₀ : ↑(p.primesOver B_C) := e.symm y₀
  let Q₁ : ↑(p.primesOver B_C) := e.symm y₁
  have hQ_lt : Q₀ < Q₁ := e.symm.strictMono hy₀_lt
  let q₀ : Ideal B_C := Q₀.1
  let q₁ : Ideal B_C := Q₁.1
  have hlt : q₀ < q₁ := hQ_lt
  have hq₀_prime : q₀.IsPrime := Q₀.2.1
  have hq₁_prime : q₁.IsPrime := Q₁.2.1
  have hq₀_comap : Ideal.comap α q₀ = p := by
    have h := (@Ideal.LiesOver.over _ _ _ _ _ q₀ p Q₀.2.2).symm
    rwa [Ideal.under_def] at h
  have hq₁_comap : Ideal.comap α q₁ = p := by
    have h := (@Ideal.LiesOver.over _ _ _ _ _ q₁ p Q₁.2.2).symm
    rwa [Ideal.under_def] at h
  obtain ⟨b_tr, hb_q₁, hb_not_q₀⟩ := SetLike.exists_of_lt hlt
  have hPolyC : ∀ P : Polynomial B_X,
      (∃ j : ℕ, P.coeff j ∉ p) → Polynomial.eval₂ α b_tr P ∉ q₀ := by
    intro P h heval
    let j₀ : ℕ := Nat.find h
    have hj₀ : P.coeff j₀ ∉ p := Nat.find_spec h
    have hmin : ∀ j < j₀, P.coeff j ∈ p := fun j hj => not_not.mp (Nat.find_min h hj)
    have hcoeff_ne : P.coeff j₀ ≠ 0 := fun h0 => hj₀ (h0 ▸ p.zero_mem)
    have hj₀_deg : j₀ ≤ P.natDegree := Polynomial.le_natDegree_of_ne_zero hcoeff_ne
    let m : ℕ := P.natDegree - j₀
    have hdeg_eq : P.natDegree + 1 = j₀ + (m + 1) := by omega
    let S_low : B_C := ∑ j ∈ Finset.range j₀, α (P.coeff j) * b_tr ^ j
    let S_high : B_C := ∑ k ∈ Finset.range (m + 1), α (P.coeff (j₀ + k)) * b_tr ^ k
    have heval_split : Polynomial.eval₂ α b_tr P = S_low + b_tr ^ j₀ * S_high := by
      conv_lhs => rw [Polynomial.as_sum_range_C_mul_X_pow P]
      rw [Polynomial.eval₂_finsetSum, hdeg_eq, Finset.sum_range_add]
      simp only [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X_pow]
      congr 1
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun k _ => ?_
      rw [pow_add]
      ring
    have hSlow_mem : S_low ∈ q₀ := by
      refine q₀.sum_mem fun j hj => ?_
      have hj_p : P.coeff j ∈ p := hmin j (Finset.mem_range.mp hj)
      rw [← hq₀_comap, Ideal.mem_comap] at hj_p
      exact q₀.mul_mem_right (b_tr ^ j) hj_p
    have hmul_mem : b_tr ^ j₀ * S_high ∈ q₀ := by
      have hsub := q₀.sub_mem (heval_split ▸ heval) hSlow_mem
      rwa [add_sub_cancel_left] at hsub
    have hb_pow_not : b_tr ^ j₀ ∉ q₀ := fun hpow => hb_not_q₀ (hq₀_prime.mem_of_pow_mem j₀ hpow)
    have hShigh_q₀ : S_high ∈ q₀ := (hq₀_prime.mem_or_mem hmul_mem).resolve_left hb_pow_not
    have hShigh_q₁ : S_high ∈ q₁ := hlt.le hShigh_q₀
    let S_tail : B_C := ∑ k ∈ Finset.range m, α (P.coeff (j₀ + (k + 1))) * b_tr ^ (k + 1)
    have hShigh_split : S_high = S_tail + α (P.coeff j₀) := by
      dsimp only [S_high, S_tail]
      rw [Finset.sum_range_succ']
      simp only [add_zero, pow_zero, mul_one]
    have hStail_q₁ : S_tail ∈ q₁ := by
      refine q₁.sum_mem fun k _ => ?_
      rw [pow_succ]
      exact q₁.mul_mem_left _ (q₁.mul_mem_left _ hb_q₁)
    have hα_q₁ : α (P.coeff j₀) ∈ q₁ := by
      have hsub := q₁.sub_mem (hShigh_split ▸ hShigh_q₁) hStail_q₁
      rwa [add_sub_cancel_left] at hsub
    have h_in_p : P.coeff j₀ ∈ p := by
      rw [← hq₁_comap, Ideal.mem_comap]
      exact hα_q₁
    exact hj₀ h_in_p
  
  have hUnit : ∀ y : q₀.primeCompl, IsUnit (φ_C y) := by
    intro y
    have hy_ne : (y : B_C) ≠ 0 := fun h0 => y.2 (h0 ▸ q₀.zero_mem)
    have hφ_ne : φ_C y ≠ 0 := fun h0 => hy_ne (hInjC (h0.trans (map_zero φ_C).symm))
    exact IsUnit.mk0 (φ_C y) hφ_ne
  let ψ_loc : Localization.AtPrime q₀ →+* F_ss := IsLocalization.lift (M := q₀.primeCompl) hUnit
  obtain ⟨W, hW_loc, hLocal⟩ := IsLocalRing.exists_factor_valuationRing ψ_loc
  let ψ_W : Localization.AtPrime q₀ →+* ↥W := ψ_loc.codRestrict W.toSubring hW_loc
  let ρ_C : B_C →+* ↥W := ψ_W.comp (algebraMap B_C (Localization.AtPrime q₀))
  have hρ_sub : W.subtype.comp ρ_C = φ_C := by
    ext b
    change ψ_loc (algebraMap B_C (Localization.AtPrime q₀) b) = φ_C b
    exact IsLocalization.lift_eq (M := q₀.primeCompl) hUnit b
  have hψ_comap : Ideal.comap ψ_W (IsLocalRing.maximalIdeal ↥W) =
      IsLocalRing.maximalIdeal (Localization.AtPrime q₀) := by
    have _ : IsLocalHom ψ_W := hLocal
    ext x
    simp only [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_iff_not]
    exact ⟨fun h => isUnit_of_map_unit ψ_W x h, fun h => h.map ψ_W⟩
  have hloc_comap : Ideal.comap (algebraMap B_C (Localization.AtPrime q₀))
      (IsLocalRing.maximalIdeal (Localization.AtPrime q₀)) = q₀ := by
    have hlo : (IsLocalRing.maximalIdeal (Localization.AtPrime q₀)).LiesOver q₀ :=
      IsLocalization.AtPrime.liesOver_maximalIdeal (Localization.AtPrime q₀) q₀
    have h := (@Ideal.LiesOver.over _ _ _ _ _
      (IsLocalRing.maximalIdeal (Localization.AtPrime q₀)) q₀ hlo).symm
    rwa [Ideal.under_def] at h
  have hq₀_W : Ideal.comap ρ_C (IsLocalRing.maximalIdeal ↥W) = q₀ := by
    change Ideal.comap (algebraMap B_C (Localization.AtPrime q₀))
      (Ideal.comap ψ_W (IsLocalRing.maximalIdeal ↥W)) = q₀
    rw [hψ_comap, hloc_comap]
  have hp_W : Ideal.comap (ρ_C.comp α) (IsLocalRing.maximalIdeal ↥W) = p := by
    rw [← Ideal.comap_comap, hq₀_W, hq₀_comap]
  have hV : ∀ c : ↥V, φ_KF (V.subtype c) ∈ W := by
    intro c
    rw [← hCompat c, ← hρ_sub]
    exact (ρ_C (α (γ_X c))).2
  have hρ_V_eq : (φ_KF.comp V.subtype).codRestrict W.toSubring hV =
      (ρ_C.comp α).comp γ_X := by
    ext c
    change φ_KF (V.subtype c) = (W.subtype.comp ρ_C) (α (γ_X c))
    rw [hρ_sub, hCompat c]
  have hCenter_V : ∀ c : ↥V,
      ((⟨φ_KF (V.subtype c), hV c⟩ : ↥W) ∈ IsLocalRing.maximalIdeal ↥W ↔ c ∈ P_s) := by
    intro c
    have hc_eq : (⟨φ_KF (V.subtype c), hV c⟩ : ↥W) = ((ρ_C.comp α).comp γ_X) c := by
      rw [← hρ_V_eq]
      rfl
    rw [hc_eq]
    change γ_X c ∈ Ideal.comap (ρ_C.comp α) (IsLocalRing.maximalIdeal ↥W) ↔ c ∈ P_s
    rw [hp_W, ← hp_comap, Ideal.mem_comap]
  
  let κ_W : Type u := IsLocalRing.ResidueField ↥W
  let π_W : ↥W →+* κ_W := IsLocalRing.residue ↥W
  let ρ_B : B_X →+* ↥W := ρ_C.comp α
  let ρ_V : ↥V →+* ↥W := ρ_B.comp γ_X
  let θ_C : B_C →+* κ_W := π_W.comp ρ_C
  let θ_X : B_X →+* κ_W := π_W.comp ρ_B
  let θ_V : ↥V →+* κ_W := π_W.comp ρ_V
  have hθC_zero : ∀ y : B_C, θ_C y = 0 ↔ y ∈ q₀ := by
    intro y
    change π_W (ρ_C y) = 0 ↔ y ∈ q₀
    rw [← RingHom.mem_ker, IsLocalRing.ker_residue, ← hq₀_W, Ideal.mem_comap]
  have hθX_zero : ∀ b : B_X, θ_X b = 0 ↔ b ∈ p := by
    intro b
    change π_W (ρ_B b) = 0 ↔ b ∈ p
    rw [← RingHom.mem_ker, IsLocalRing.ker_residue, ← hp_W, Ideal.mem_comap]
  have hθV_zero : ∀ c : ↥V, θ_V c = 0 ↔ c ∈ P_s := by
    intro c
    change θ_X (γ_X c) = 0 ↔ c ∈ P_s
    rw [hθX_zero, ← hp_comap, Ideal.mem_comap]
  have _ : IsDomain (↥V ⧸ P_s) := Ideal.Quotient.isDomain P_s
  let g₀ : (↥V ⧸ P_s) →+* κ_W :=
    Ideal.Quotient.lift P_s θ_V (fun c hc => (hθV_zero c).mpr hc)
  have hg₀_inj : Function.Injective g₀ := by
    rw [injective_iff_map_eq_zero]
    intro u hu
    obtain ⟨c, rfl⟩ := Ideal.Quotient.mk_surjective u
    exact Ideal.Quotient.eq_zero_iff_mem.mpr ((hθV_zero c).mp hu)
  let ι_sW : P_s.ResidueField →+* κ_W :=
    @IsFractionRing.lift (↥V ⧸ P_s) _ P_s.ResidueField _ κ_W _ _
      (instIsFractionRingQuotientIdealResidueField P_s) g₀ hg₀_inj
  let φ_VP : ↥V →+* P_s.ResidueField :=
    (algebraMap (↥V ⧸ P_s) P_s.ResidueField).comp (Ideal.Quotient.mk P_s)
  have hι_φ : ι_sW.comp φ_VP = θ_V := by
    ext c
    change (@IsFractionRing.lift (↥V ⧸ P_s) _ P_s.ResidueField _ κ_W _ _
      (instIsFractionRingQuotientIdealResidueField P_s) g₀ hg₀_inj)
        (algebraMap (↥V ⧸ P_s) P_s.ResidueField (Ideal.Quotient.mk P_s c)) = θ_V c
    rw [@IsFractionRing.lift_algebraMap (↥V ⧸ P_s) _ P_s.ResidueField _ κ_W _ _
      (instIsFractionRingQuotientIdealResidueField P_s) g₀ hg₀_inj]
    rfl
  have hφ_VP_zero : ∀ c : ↥V, φ_VP c = 0 ↔ c ∈ P_s := by
    intro c
    change algebraMap (↥V ⧸ P_s) P_s.ResidueField (Ideal.Quotient.mk P_s c) = 0 ↔ c ∈ P_s
    have hInj_VP : Function.Injective (algebraMap (↥V ⧸ P_s) P_s.ResidueField) :=
      @IsFractionRing.injective (↥V ⧸ P_s) _ P_s.ResidueField _ _
        (instIsFractionRingQuotientIdealResidueField P_s)
    rw [← map_zero (algebraMap (↥V ⧸ P_s) P_s.ResidueField), hInj_VP.eq_iff,
      Ideal.Quotient.eq_zero_iff_mem]
  let _ : Algebra P_s.ResidueField κ_W := ι_sW.toAlgebra
  have hUnivariate_alg : ∀ (w : ↥W) (P : Polynomial ↥V),
      (∃ i : ℕ, P.coeff i ∉ P_s) →
      Polynomial.eval₂ ρ_V w P ∈ IsLocalRing.maximalIdeal ↥W →
      IsAlgebraic P_s.ResidueField (π_W w) := by
    intro w P ⟨i₀, hi₀⟩ heval_m
    let P_bar : Polynomial P_s.ResidueField := P.map φ_VP
    have hPbar_ne : P_bar ≠ 0 := by
      intro h0
      have hc0 : P_bar.coeff i₀ = 0 := by rw [h0, Polynomial.coeff_zero]
      rw [Polynomial.coeff_map] at hc0
      exact hi₀ ((hφ_VP_zero (P.coeff i₀)).mp hc0)
    have haeval : Polynomial.aeval (π_W w) P_bar = 0 := by
      rw [Polynomial.aeval_def]
      change Polynomial.eval₂ ι_sW (π_W w) (P.map φ_VP) = 0
      rw [Polynomial.eval₂_map, hι_φ]
      change Polynomial.eval₂ (π_W.comp ρ_V) (π_W w) P = 0
      rw [← Polynomial.hom_eval₂]
      rwa [← RingHom.mem_ker, IsLocalRing.ker_residue]
    exact ⟨P_bar, hPbar_ne, haeval⟩
  have hAlgToRange : ∀ x : κ_W, IsAlgebraic P_s.ResidueField x → x ∈ ι_sW.range := by
    intro x hx
    have hx_int : IsIntegral P_s.ResidueField x := hx.isIntegral
    have hdeg : (minpoly P_s.ResidueField x).degree = 1 :=
      IsAlgClosed.degree_eq_one_of_irreducible P_s.ResidueField (minpoly.irreducible hx_int)
    have hform := Polynomial.eq_X_add_C_of_degree_eq_one hdeg
    rw [(minpoly.monic hx_int).leadingCoeff, map_one, one_mul] at hform
    have haev := minpoly.aeval P_s.ResidueField x
    rw [hform, map_add, Polynomial.aeval_X, Polynomial.aeval_C] at haev
    refine ⟨-(minpoly P_s.ResidueField x).coeff 0, ?_⟩
    change (algebraMap P_s.ResidueField κ_W) (-(minpoly P_s.ResidueField x).coeff 0) = x
    rw [map_neg]
    exact (add_eq_zero_iff_neg_eq.mp (add_comm x _ ▸ haev))
  
  have hAllAlgX : ∀ b₁ : B_X, IsAlgebraic P_s.ResidueField (θ_X b₁) := by
    intro b₁
    by_contra hb₁_not_alg
    apply hTwoVar W hV P_s hCenter_V
    refine ⟨ρ_B b₁, ρ_C b_tr, ?_⟩
    intro Q ⟨d₀, hd₀⟩
    rw [hρ_V_eq]
    have hd₀_ne : Q.coeff d₀ ≠ 0 := fun h0 => hd₀ (h0 ▸ P_s.zero_mem)
    have hd₀_supp : d₀ ∈ Q.support := MvPolynomial.mem_support_iff.mpr hd₀_ne
    let D₁ : ℕ := Q.support.sup (fun d => d 1)
    have hmaps : ∀ d ∈ Q.support, d 1 ∈ Finset.range (D₁ + 1) := by
      intro d hd
      exact Finset.mem_range.mpr (Nat.lt_succ_of_le (Finset.le_sup (f := fun d : Fin 2 →₀ ℕ => d 1) hd))
    let S_j : ℕ → Finset (Fin 2 →₀ ℕ) := fun j => Q.support.filter (fun d => d 1 = j)
    let R_j : ℕ → Polynomial ↥V :=
      fun j => ∑ d ∈ S_j j, Polynomial.monomial (d 0) (Q.coeff d)
    let r_j : ℕ → B_X := fun j => Polynomial.eval₂ γ_X b₁ (R_j j)
    let j₀ : ℕ := d₀ 1
    let i₀ : ℕ := d₀ 0
    have hRj₀_coeff : (R_j j₀).coeff i₀ = Q.coeff d₀ := by
      simp only [R_j, Polynomial.finsetSum_coeff, Polynomial.coeff_monomial]
      rw [Finset.sum_eq_single d₀]
      · simp [i₀]
      · intro d hd hne
        have hd1 : d 1 = j₀ := (Finset.mem_filter.mp hd).2
        have hd0_ne : d 0 ≠ i₀ := by
          intro hd0
          apply hne
          exact Finsupp.ext (Fin.forall_fin_two.mpr ⟨hd0, hd1⟩)
        simp [hd0_ne]
      · intro hnot
        exact False.elim (hnot (Finset.mem_filter.mpr ⟨hd₀_supp, rfl⟩))
    have hr_j₀ : r_j j₀ ∉ p := by
      intro hr_mem
      have hρr_mem : ρ_B (r_j j₀) ∈ IsLocalRing.maximalIdeal ↥W := by
        rwa [← hp_W, Ideal.mem_comap] at hr_mem
      have hρr_eq : ρ_B (r_j j₀) = Polynomial.eval₂ ρ_V (ρ_B b₁) (R_j j₀) := by
        dsimp only [r_j, ρ_V]
        exact Polynomial.hom_eval₂ (R_j j₀) γ_X ρ_B b₁
      rw [hρr_eq] at hρr_mem
      exact hb₁_not_alg (hUnivariate_alg (ρ_B b₁) (R_j j₀) ⟨i₀, hRj₀_coeff ▸ hd₀⟩ hρr_mem)
    let P_X : Polynomial B_X :=
      ∑ j ∈ Finset.range (D₁ + 1), Polynomial.monomial j (r_j j)
    have hj₀_mem : j₀ ∈ Finset.range (D₁ + 1) := hmaps d₀ hd₀_supp
    have hPX_coeff : P_X.coeff j₀ ∉ p := by
      have hc : P_X.coeff j₀ = r_j j₀ := by
        simp only [P_X, Polynomial.finsetSum_coeff, Polynomial.coeff_monomial,
          Finset.sum_ite_eq', hj₀_mem, ↓reduceIte]
      rwa [hc]
    have heval_PX_not : ρ_C (Polynomial.eval₂ α b_tr P_X) ∉ IsLocalRing.maximalIdeal ↥W := by
      intro hmem
      have hq : Polynomial.eval₂ α b_tr P_X ∈ q₀ := by
        rwa [← hq₀_W, Ideal.mem_comap]
      exact hPolyC P_X ⟨j₀, hPX_coeff⟩ hq
    have heval_eq : ρ_C (Polynomial.eval₂ α b_tr P_X) =
        MvPolynomial.eval₂ ρ_V ![ρ_B b₁, ρ_C b_tr] Q := by
      rw [Polynomial.hom_eval₂]
      change Polynomial.eval₂ ρ_B (ρ_C b_tr) P_X = _
      simp only [P_X, Polynomial.eval₂_finsetSum, Polynomial.eval₂_monomial]
      have hslice : ∀ j : ℕ,
          ρ_B (r_j j) * (ρ_C b_tr) ^ j =
            ∑ d ∈ S_j j, ρ_V (Q.coeff d) * ((ρ_B b₁) ^ (d 0) * (ρ_C b_tr) ^ (d 1)) := by
        intro j
        have h1 : ρ_B (r_j j) = Polynomial.eval₂ ρ_V (ρ_B b₁) (R_j j) :=
          Polynomial.hom_eval₂ (R_j j) γ_X ρ_B b₁
        rw [h1]
        simp only [R_j, Polynomial.eval₂_finsetSum, Polynomial.eval₂_monomial, Finset.sum_mul]
        refine Finset.sum_congr rfl fun d hd => ?_
        have hd1 : d 1 = j := (Finset.mem_filter.mp hd).2
        rw [hd1, mul_assoc]
      simp_rw [hslice]
      dsimp only [S_j]
      rw [Finset.sum_fiberwise_of_maps_to hmaps]
      rw [MvPolynomial.eval₂_eq']
      refine Finset.sum_congr rfl fun d _ => ?_
      rw [Fin.prod_univ_two]
      rfl
    rwa [← heval_eq]
  have hMemX : ∀ b : B_X, θ_X b ∈ ι_sW.range := fun b => hAlgToRange (θ_X b) (hAllAlgX b)
  have hLinX : ∀ (d r : B_X), r ∉ p →
      ∃ (c₀ s₀ : ↥V), s₀ ∉ P_s ∧ γ_X s₀ * d - γ_X c₀ * r ∈ p := by
    intro d r hr
    obtain ⟨z_d, hz_d⟩ := hMemX d
    obtain ⟨z_r, hz_r⟩ := hMemX r
    have hθr_ne : θ_X r ≠ 0 := fun h0 => hr ((hθX_zero r).mp h0)
    have hzr_ne : z_r ≠ 0 := fun h0 => hθr_ne (hz_r ▸ (h0 ▸ map_zero ι_sW))
    obtain ⟨u, v, hv_nzd, huv⟩ :=
      @IsFractionRing.div_surjective (↥V ⧸ P_s) _ P_s.ResidueField _ _
        (instIsFractionRingQuotientIdealResidueField P_s) (z_d / z_r)
    have hv_ne : v ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hv_nzd
    obtain ⟨c₀, rfl⟩ := Ideal.Quotient.mk_surjective u
    obtain ⟨s₀, rfl⟩ := Ideal.Quotient.mk_surjective v
    have hs₀_not_Ps : s₀ ∉ P_s := fun hsP => hv_ne (Ideal.Quotient.eq_zero_iff_mem.mpr hsP)
    have hφs₀_ne : φ_VP s₀ ≠ 0 := fun h0 => hs₀_not_Ps ((hφ_VP_zero s₀).mp h0)
    have hcross_k : φ_VP s₀ * z_d = φ_VP c₀ * z_r := by
      have hdiv : φ_VP c₀ / φ_VP s₀ = z_d / z_r := huv
      have hmul := (div_eq_div_iff hφs₀_ne hzr_ne).mp hdiv
      rw [mul_comm, ← hmul]
    have hθ_eq : θ_X (γ_X s₀ * d - γ_X c₀ * r) = 0 := by
      have hι := congrArg ι_sW hcross_k
      simp only [map_mul] at hι
      have hs : ι_sW (φ_VP s₀) = θ_X (γ_X s₀) := by
        rw [← RingHom.comp_apply, hι_φ]
        rfl
      have hc : ι_sW (φ_VP c₀) = θ_X (γ_X c₀) := by
        rw [← RingHom.comp_apply, hι_φ]
        rfl
      rw [hs, hc, hz_d, hz_r] at hι
      simp only [map_sub, map_mul]
      exact sub_eq_zero.mpr hι
    exact ⟨c₀, s₀, hs₀_not_Ps, (hθX_zero _).mp hθ_eq⟩
  
  have hex_c_star : ∃ c_star : B_U,
      ∀ P : Polynomial ↥V,
        (∃ i : ℕ, P.coeff i ∉ P_s) →
        Polynomial.eval₂ ρ_V (ρ_C (β c_star)) P ∉ IsLocalRing.maximalIdeal ↥W := by
    by_contra hNo
    let S₀ : Subring B_C := ι_sW.range.comap θ_C
    have hsub_β : Set.range β ⊆ (S₀ : Set B_C) := by
      rintro _ ⟨c, rfl⟩
      have hc_bad : ∃ P : Polynomial ↥V, (∃ i : ℕ, P.coeff i ∉ P_s) ∧
          Polynomial.eval₂ ρ_V (ρ_C (β c)) P ∈ IsLocalRing.maximalIdeal ↥W := by
        by_contra h_ok
        exact hNo ⟨c, fun P hP hev => h_ok ⟨P, hP, hev⟩⟩
      obtain ⟨P, hP, heval_m⟩ := hc_bad
      exact hAlgToRange (θ_C (β c)) (hUnivariate_alg (ρ_C (β c)) P hP heval_m)
    have hsub_α : Set.range α ⊆ (S₀ : Set B_C) := by
      rintro _ ⟨b, rfl⟩
      exact hMemX b
    have htop_le : (⊤ : Subring B_C) ≤ S₀ := by
      rw [← hGen]
      exact Subring.closure_le.mpr (Set.union_subset hsub_β hsub_α)
    have hb_mem : b_tr ∈ S₀ := htop_le trivial
    obtain ⟨z_tr, hz_tr⟩ := hb_mem
    obtain ⟨u, v, hv_nzd, huv⟩ :=
      @IsFractionRing.div_surjective (↥V ⧸ P_s) _ P_s.ResidueField _ _
        (instIsFractionRingQuotientIdealResidueField P_s) z_tr
    have hv_ne : v ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hv_nzd
    obtain ⟨c₀, rfl⟩ := Ideal.Quotient.mk_surjective u
    obtain ⟨s₀, rfl⟩ := Ideal.Quotient.mk_surjective v
    have hs₀_not_Ps : s₀ ∉ P_s := fun hsP => hv_ne (Ideal.Quotient.eq_zero_iff_mem.mpr hsP)
    have hφs₀_ne : φ_VP s₀ ≠ 0 := fun h0 => hs₀_not_Ps ((hφ_VP_zero s₀).mp h0)
    have hsz : φ_VP s₀ * z_tr = φ_VP c₀ := by
      have hdiv : φ_VP c₀ / φ_VP s₀ = z_tr := huv
      rw [← hdiv, mul_div_cancel₀ _ hφs₀_ne]
    have hθ_lin : θ_C (α (γ_X s₀) * b_tr - α (γ_X c₀)) = 0 := by
      have hι := congrArg ι_sW hsz
      rw [map_mul] at hι
      have hs : ι_sW (φ_VP s₀) = θ_C (α (γ_X s₀)) := by
        rw [← RingHom.comp_apply, hι_φ]
        rfl
      have hc : ι_sW (φ_VP c₀) = θ_C (α (γ_X c₀)) := by
        rw [← RingHom.comp_apply, hι_φ]
        rfl
      rw [hs, hc, hz_tr] at hι
      simp only [map_sub, map_mul]
      exact sub_eq_zero.mpr hι
    have hlin_q₀ : α (γ_X s₀) * b_tr - α (γ_X c₀) ∈ q₀ := (hθC_zero _).mp hθ_lin
    let P_lin : Polynomial B_X := Polynomial.C (γ_X s₀) * Polynomial.X - Polynomial.C (γ_X c₀)
    have hPlin_coeff : P_lin.coeff 1 ∉ p := by
      have hc1 : P_lin.coeff 1 = γ_X s₀ := by
        simp [P_lin]
      rw [hc1]
      intro hmem
      apply hs₀_not_Ps
      rwa [← hp_comap, Ideal.mem_comap]
    have hPlin_eval : Polynomial.eval₂ α b_tr P_lin ∈ q₀ := by
      have hev : Polynomial.eval₂ α b_tr P_lin = α (γ_X s₀) * b_tr - α (γ_X c₀) := by
        simp [P_lin]
      rwa [hev]
    exact hPolyC P_lin ⟨1, hPlin_coeff⟩ hPlin_eval
  obtain ⟨c_star, hc_star⟩ := hex_c_star
  refine ⟨W, hV, ρ_C, c_star, hρ_sub, hp_W, ?_, hLinX⟩
  intro P hP
  rw [hρ_V_eq]
  exact hc_star P hP

theorem weil_schematic_graph_closure_and_product_cover (K : Type u) [Field K]
    (V : ValuationSubring K)
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (hIntCK : AlgebraicGeometry.IsIntegral C_K)
    (C' : AlgebraicGeometry.Scheme.{u})
    (g' : C' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (ι' : C_K ⟶ C')
    (U' : C'.Opens)
    (U_ss : AlgebraicGeometry.Scheme.{u})
    (g_ss : U_ss ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (hAff_ss : AlgebraicGeometry.IsAffine U_ss)
    (h_mod : U'.toScheme ⟶ U_ss)
    (hProp_mod : AlgebraicGeometry.IsProper h_mod)
    (hComm_mod : h_mod ≫ g_ss = U'.ι ≫ g')
    (ι_U' : AlgebraicGeometry.Scheme.Opens.toScheme
      ((TopologicalSpace.Opens.map ι'.base).obj U') ⟶ U'.toScheme)
    (hPb_U' : CategoryTheory.IsPullback ι_U'
      (AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj U') ≫ p_K)
      (U'.ι ≫ g')
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (hPb_ss : CategoryTheory.IsPullback (ι_U' ≫ h_mod)
      (AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj U') ≫ p_K)
      g_ss
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (hOpenη : AlgebraicGeometry.IsOpenImmersion
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (F_ss : Type u) [Field F_ss]
    (η_ss : AlgebraicGeometry.Spec (CommRingCat.of F_ss) ⟶ U_ss)
    (η_UK : AlgebraicGeometry.Spec (CommRingCat.of F_ss) ⟶
      AlgebraicGeometry.Scheme.Opens.toScheme ((TopologicalSpace.Opens.map ι'.base).obj U'))
    (hUK_ne : Nonempty ↥((TopologicalSpace.Opens.map ι'.base).obj U'))
    (hηUK_ss : η_UK ≫ ι_U' ≫ h_mod = η_ss)
    (hFunc_UK : IsSchemeFunctionField
      (AlgebraicGeometry.Scheme.Opens.toScheme ((TopologicalSpace.Opens.map ι'.base).obj U'))
      F_ss η_UK)
    (X : AlgebraicGeometry.Scheme.{u})
    (g_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (p_X : X ⟶ U_ss)
    (η_X : AlgebraicGeometry.Spec (CommRingCat.of F_ss) ⟶ X)
    (ι_X : AlgebraicGeometry.Scheme.Opens.toScheme
      ((TopologicalSpace.Opens.map ι'.base).obj U') ⟶ X)
    (hIntX : AlgebraicGeometry.IsIntegral X)
    (hProp_pX : AlgebraicGeometry.IsProper p_X)
    (hComm_pX : p_X ≫ g_ss = g_X)
    (hη_pX : η_X ≫ p_X = η_ss)
    (hι_pX : ι_X ≫ p_X = ι_U' ≫ h_mod)
    (hPb_X : CategoryTheory.IsPullback ι_X
      (AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj U') ≫ p_K)
      g_X
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype))) :
    ∃ (C_bar : AlgebraicGeometry.Scheme.{u})
      (π_1 : C_bar ⟶ U'.toScheme)
      (f' : C_bar ⟶ X)
      (η_C : AlgebraicGeometry.Spec (CommRingCat.of F_ss) ⟶ C_bar)
      (q_K : AlgebraicGeometry.Scheme.Opens.toScheme
        ((TopologicalSpace.Opens.map ι'.base).obj U') ⟶ C_bar),
      AlgebraicGeometry.IsIntegral C_bar ∧
      AlgebraicGeometry.IsDominant η_C ∧
      IsSchemeFunctionField C_bar F_ss η_C ∧
      IsSchemeFunctionField X F_ss η_X ∧
      AlgebraicGeometry.IsProper f' ∧
      π_1 ≫ h_mod = f' ≫ p_X ∧
      η_C ≫ π_1 = η_UK ≫ ι_U' ∧
      η_C ≫ f' = η_X ∧
      q_K ≫ π_1 = ι_U' ∧
      q_K ≫ f' = ι_X ∧
      (∀ x : X, (g_X.base x).asIdeal = ⊥ → Set.Subsingleton (f'.base ⁻¹' {x})) ∧
      (∀ z : C_bar,
        ∃ (U_1 : U'.toScheme.Opens) (_ : AlgebraicGeometry.IsAffineOpen U_1)
          (U_X : X.Opens) (_ : AlgebraicGeometry.IsAffineOpen U_X)
          (V_C : C_bar.Opens) (_ : AlgebraicGeometry.IsAffineOpen V_C)
          (e_1 : V_C ≤ (TopologicalSpace.Opens.map π_1.base).obj U_1)
          (e_X : V_C ≤ (TopologicalSpace.Opens.map f'.base).obj U_X),
          z ∈ V_C ∧
          (f'.appLE U_X V_C e_X).hom.FiniteType ∧
          Subring.closure
            (Set.range (π_1.appLE U_1 V_C e_1).hom ∪
              Set.range (f'.appLE U_X V_C e_X).hom) = ⊤) :=
by
  let U_K : C_K.Opens := (TopologicalSpace.Opens.map ι'.base).obj U'
  let U₀ : AlgebraicGeometry.Scheme.{u} := U_K.toScheme
  let η_V := AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)
  have hUK_sch_ne : Nonempty ↥U₀ := hUK_ne
  have hIntU₀ : AlgebraicGeometry.IsIntegral U₀ :=
    @AlgebraicGeometry.isIntegral_of_isOpenImmersion U₀ C_K U_K.ι inferInstance hIntCK hUK_sch_ne
  have hOpen_ιX : AlgebraicGeometry.IsOpenImmersion ι_X :=
    CategoryTheory.MorphismProperty.of_isPullback
      (P := @AlgebraicGeometry.IsOpenImmersion.{u}) hPb_X.flip hOpenη
  
  have hηUK_X : η_UK ≫ ι_X = η_X := by
    have hηX_gX : η_X ≫ g_X = (η_UK ≫ U_K.ι ≫ p_K) ≫ η_V := by
      calc η_X ≫ g_X = η_X ≫ (p_X ≫ g_ss) := by rw [hComm_pX]
        _ = (η_X ≫ p_X) ≫ g_ss := by rw [CategoryTheory.Category.assoc]
        _ = η_ss ≫ g_ss := by rw [hη_pX]
        _ = (η_UK ≫ ι_U' ≫ h_mod) ≫ g_ss := by rw [hηUK_ss]
        _ = η_UK ≫ ((ι_U' ≫ h_mod) ≫ g_ss) := by simp only [CategoryTheory.Category.assoc]
        _ = η_UK ≫ ((U_K.ι ≫ p_K) ≫ η_V) := by rw [hPb_ss.w]
        _ = (η_UK ≫ U_K.ι ≫ p_K) ≫ η_V := by simp only [CategoryTheory.Category.assoc]
    let l := hPb_X.lift η_X (η_UK ≫ U_K.ι ≫ p_K) hηX_gX
    have hl_eq : l = η_UK := by
      apply hPb_ss.hom_ext
      · calc l ≫ (ι_U' ≫ h_mod) = l ≫ (ι_X ≫ p_X) := by rw [hι_pX]
          _ = (l ≫ ι_X) ≫ p_X := by rw [CategoryTheory.Category.assoc]
          _ = η_X ≫ p_X := by rw [hPb_X.lift_fst]
          _ = η_ss := hη_pX
          _ = η_UK ≫ (ι_U' ≫ h_mod) := hηUK_ss.symm
      · exact hPb_X.lift_snd _ _ _
    calc η_UK ≫ ι_X = l ≫ ι_X := by rw [hl_eq]
      _ = η_X := hPb_X.lift_fst _ _ _
  
  haveI : AlgebraicGeometry.QuasiCompact η_UK :=
    AlgebraicGeometry.QuasiCompact.mk
      (fun _ _ _ => Set.Subsingleton.isCompact fun _ _ _ _ => Subsingleton.elim _ _)
  have hKer_UK : AlgebraicGeometry.Scheme.Hom.ker η_UK = ⊥ := by
    apply AlgebraicGeometry.Scheme.IdealSheafData.ext
    funext U
    rw [AlgebraicGeometry.Scheme.IdealSheafData.ideal_bot, Pi.bot_apply,
      AlgebraicGeometry.Scheme.Hom.ker_apply η_UK U, eq_bot_iff]
    intro a ha
    change (η_UK.app U.1).hom a = 0 at ha
    rw [Ideal.mem_bot]
    by_cases hUne : Nonempty ↥U.1
    · have hU2 : AlgebraicGeometry.IsAffineOpen U.1 := U.2
      haveI : IsDomain ↑(U₀.presheaf.obj (Opposite.op U.1)) :=
        @AlgebraicGeometry.IsIntegral.component_integral U₀ hIntU₀ U.1 hUne
      obtain ⟨φ_U, hFrac_U, hSpec_U⟩ := hFunc_UK U.1 hU2 hUne
      have hInj_φ : Function.Injective φ_U.hom := by
        letI : Algebra ↑(U₀.presheaf.obj (Opposite.op U.1)) F_ss := φ_U.hom.toAlgebra
        exact @IsFractionRing.injective ↑(U₀.presheaf.obj (Opposite.op U.1)) _ F_ss _ _ hFrac_U
      let S_F := AlgebraicGeometry.Spec (CommRingCat.of F_ss)
      have h_top : AlgebraicGeometry.IsAffineOpen (⊤ : S_F.Opens) :=
        AlgebraicGeometry.isAffineOpen_top S_F
      have i_top : (⊤ : S_F.Opens) ≤ (TopologicalSpace.Opens.map η_UK.base).obj U.1 := by
        intro pt _
        change η_UK.base pt ∈ U.1
        rw [← hSpec_U]
        have hmem : (hU2.fromSpec.base ((AlgebraicGeometry.Spec.map φ_U).base pt)) ∈
            Set.range hU2.fromSpec.base := ⟨_, rfl⟩
        have hrng : Set.range hU2.fromSpec.base = (U.1 : Set ↥U₀) :=
          congrArg SetLike.coe hU2.opensRange_fromSpec
        rw [hrng] at hmem
        exact hmem
      haveI : CategoryTheory.IsIso h_top.fromSpec :=
        AlgebraicGeometry.isIso_of_isOpenImmersion_of_opensRange_eq_top
          h_top.fromSpec h_top.opensRange_fromSpec
      let e_hom : CommRingCat.of F_ss ⟶ S_F.presheaf.obj (Opposite.op ⊤) :=
        AlgebraicGeometry.Spec.preimage h_top.fromSpec
      let e_inv : S_F.presheaf.obj (Opposite.op ⊤) ⟶ CommRingCat.of F_ss :=
        AlgebraicGeometry.Spec.preimage (CategoryTheory.inv h_top.fromSpec)
      have he_id : e_hom ≫ e_inv = 𝟙 (CommRingCat.of F_ss) := by
        apply AlgebraicGeometry.Spec.map_injective
        rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_id,
          AlgebraicGeometry.Spec.map_preimage, AlgebraicGeometry.Spec.map_preimage,
          CategoryTheory.IsIso.inv_hom_id]
      have h_appLE_spec :
          AlgebraicGeometry.Spec.map (η_UK.appLE U.1 ⊤ i_top) ≫ hU2.fromSpec =
            AlgebraicGeometry.Spec.map (φ_U ≫ e_hom) ≫ hU2.fromSpec := by
        rw [AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec η_UK hU2 h_top i_top,
          AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
          CategoryTheory.Category.assoc, hSpec_U]
      have h_appLE : η_UK.appLE U.1 ⊤ i_top = φ_U ≫ e_hom :=
        AlgebraicGeometry.Spec.map_injective ((cancel_mono hU2.fromSpec).mp h_appLE_spec)
      have ha_top : (η_UK.appLE U.1 ⊤ i_top).hom a = 0 := by
        change (S_F.presheaf.map (CategoryTheory.homOfLE i_top).op).hom ((η_UK.app U.1).hom a) = 0
        rw [ha, map_zero]
      have ha_ehom : e_hom.hom (φ_U.hom a) = 0 := by
        have h1 := congrArg (fun f => f.hom a) h_appLE
        exact h1.symm.trans ha_top
      have ha_φ : φ_U.hom a = 0 := by
        calc φ_U.hom a = (e_hom ≫ e_inv).hom (φ_U.hom a) := by rw [he_id]; rfl
          _ = e_inv.hom (e_hom.hom (φ_U.hom a)) := rfl
          _ = e_inv.hom 0 := by rw [ha_ehom]
          _ = 0 := map_zero _
      exact hInj_φ (ha_φ.trans (map_zero φ_U.hom).symm)
    · have hEmpSpec : IsEmpty (PrimeSpectrum ↑(U₀.presheaf.obj (Opposite.op U.1))) := by
        refine ⟨fun pt => False.elim (hUne ⟨U.2.fromSpec.base pt, ?_⟩)⟩
        have hmem : U.2.fromSpec.base pt ∈ Set.range U.2.fromSpec.base := ⟨pt, rfl⟩
        have hrng : Set.range U.2.fromSpec.base = (U.1 : Set ↥U₀) :=
          congrArg SetLike.coe U.2.opensRange_fromSpec
        rw [hrng] at hmem
        exact hmem
      haveI : Subsingleton ↑(U₀.presheaf.obj (Opposite.op U.1)) :=
        PrimeSpectrum.isEmpty_iff_subsingleton.mp hEmpSpec
      exact Subsingleton.elim a 0
  have hPushFunc : ∀ (Z : AlgebraicGeometry.Scheme.{u}),
      AlgebraicGeometry.IsIntegral Z →
      ∀ (ι : U₀ ⟶ Z),
        AlgebraicGeometry.IsOpenImmersion ι →
        IsSchemeFunctionField Z F_ss (η_UK ≫ ι) := by
    intro Z hIntZ ι hOpen_ι U hU hUne
    haveI : AlgebraicGeometry.IsOpenImmersion ι := hOpen_ι
    haveI : IrreducibleSpace ↥Z := AlgebraicGeometry.irreducibleSpace_of_isIntegral Z
    have ⟨u_Z⟩ := hUne
    obtain ⟨x₀⟩ := hUK_sch_ne
    have hU_set_ne : (U : Set ↥Z).Nonempty := ⟨u_Z.1, u_Z.2⟩
    have hRange_ne : (ι.opensRange : Set ↥Z).Nonempty := ⟨ι.base x₀, ⟨x₀, rfl⟩⟩
    obtain ⟨y₀, hy₀U, hy₀R⟩ :=
      nonempty_preirreducible_inter U.isOpen ι.opensRange.isOpen hU_set_ne hRange_ne
    obtain ⟨r, hBr_le, hy₀Br⟩ :=
      hU.exists_basicOpen_le (V := U ⊓ ι.opensRange) ⟨y₀, ⟨hy₀U, hy₀R⟩⟩ hy₀U
    let B_r : Z.Opens := Z.basicOpen r
    have hr_ne : r ≠ 0 := by
      intro hr0
      rw [hr0, AlgebraicGeometry.Scheme.basicOpen_zero] at hy₀Br
      exact False.elim hy₀Br
    haveI : IsDomain ↑(Z.presheaf.obj (Opposite.op U)) :=
      @AlgebraicGeometry.IsIntegral.component_integral Z hIntZ U hUne
    have hBr : AlgebraicGeometry.IsAffineOpen B_r := hU.basicOpen r
    let V₀ : U₀.Opens := (TopologicalSpace.Opens.map ι.base).obj B_r
    have hBr_sub_range : B_r ≤ ι.opensRange := le_trans hBr_le inf_le_right
    have hFunctor_V₀ : ι.opensFunctor.obj V₀ = B_r := by
      ext z
      change z ∈ ι.base '' (ι.base ⁻¹' (B_r : Set ↥Z)) ↔ z ∈ B_r
      constructor
      · rintro ⟨u, hu, rfl⟩
        exact hu
      · intro hz
        obtain ⟨u, rfl⟩ := hBr_sub_range hz
        exact ⟨u, hz, rfl⟩
    have hV₀ : AlgebraicGeometry.IsAffineOpen V₀ := by
      rw [← ι.isAffineOpen_iff_of_isOpenImmersion, hFunctor_V₀]
      exact hBr
    obtain ⟨u₀, hu₀_eq⟩ := hBr_sub_range hy₀Br
    have hV₀_ne : Nonempty ↥V₀ := ⟨⟨u₀, by change ι.base u₀ ∈ B_r; rw [hu₀_eq]; exact hy₀Br⟩⟩
    haveI : IsDomain ↑(U₀.presheaf.obj (Opposite.op V₀)) :=
      @AlgebraicGeometry.IsIntegral.component_integral U₀ hIntU₀ V₀ hV₀_ne
    obtain ⟨φ_V₀, hFrac_V₀, hSpec_V₀⟩ := hFunc_UK V₀ hV₀ hV₀_ne
    let res_U : Z.presheaf.obj (Opposite.op U) ⟶ Z.presheaf.obj (Opposite.op B_r) :=
      Z.presheaf.map (CategoryTheory.homOfLE (Z.basicOpen_le r)).op
    let φ : Z.presheaf.obj (Opposite.op U) ⟶ CommRingCat.of F_ss :=
      res_U ≫ ι.app B_r ≫ φ_V₀
    refine ⟨φ, ?_, ?_⟩
    · haveI : CategoryTheory.IsIso (ι.app B_r) := ι.isIso_app B_r hBr_sub_range
      let e_iso := CategoryTheory.asIso (ι.app B_r)
      have hLoc_r : IsLocalization.Away r ↑(Z.presheaf.obj (Opposite.op B_r)) :=
        hU.isLocalization_basicOpen r
      have h_alg_eq : ∀ x : ↑(Z.presheaf.obj (Opposite.op U)),
          algebraMap ↑(Z.presheaf.obj (Opposite.op U)) ↑(Z.presheaf.obj (Opposite.op B_r)) x =
            res_U.hom x := fun _ => rfl
      have hInj_res : Function.Injective res_U.hom := by
        intro x y hxy
        rw [← sub_eq_zero]
        have hz0 : (algebraMap ↑(Z.presheaf.obj (Opposite.op U))
            ↑(Z.presheaf.obj (Opposite.op B_r))) (x - y) = 0 := by
          rw [h_alg_eq, map_sub, hxy, sub_self]
        rw [IsLocalization.map_eq_zero_iff (Submonoid.powers r)] at hz0
        obtain ⟨⟨c, k, rfl⟩, hck⟩ := hz0
        exact (mul_eq_zero.mp hck).resolve_left (pow_ne_zero k hr_ne)
      have hInj_φV₀ : Function.Injective φ_V₀.hom := by
        letI : Algebra ↑(U₀.presheaf.obj (Opposite.op V₀)) F_ss := φ_V₀.hom.toAlgebra
        exact @IsFractionRing.injective ↑(U₀.presheaf.obj (Opposite.op V₀)) _ F_ss _ _ hFrac_V₀
      have hInj_app : Function.Injective (ι.app B_r).hom :=
        e_iso.commRingCatIsoToRingEquiv.injective
      have hInj_φ : Function.Injective φ.hom :=
        hInj_φV₀.comp (hInj_app.comp hInj_res)
      letI : Algebra ↑(Z.presheaf.obj (Opposite.op U)) F_ss := φ.hom.toAlgebra
      refine { map_units := ?_, surj := ?_, exists_of_eq := ?_ }
      · intro y
        have hy0 : (y : ↑(Z.presheaf.obj (Opposite.op U))) ≠ 0 :=
          nonZeroDivisors.ne_zero y.2
        exact IsUnit.mk0 (φ.hom y.1) (fun h => hy0 (hInj_φ (h.trans (map_zero φ.hom).symm)))
      · intro z
        letI : Algebra ↑(U₀.presheaf.obj (Opposite.op V₀)) F_ss := φ_V₀.hom.toAlgebra
        haveI : IsFractionRing ↑(U₀.presheaf.obj (Opposite.op V₀)) F_ss := hFrac_V₀
        obtain ⟨⟨a', s'⟩, hzs'⟩ :=
          IsLocalization.surj (nonZeroDivisors ↑(U₀.presheaf.obj (Opposite.op V₀))) z
        change z * φ_V₀.hom s'.1 = φ_V₀.hom a' at hzs'
        have hs'_ne : (s' : ↑(U₀.presheaf.obj (Opposite.op V₀))) ≠ 0 :=
          nonZeroDivisors.ne_zero s'.2
        let a_S : ↑(Z.presheaf.obj (Opposite.op B_r)) := e_iso.inv.hom a'
        let s_S : ↑(Z.presheaf.obj (Opposite.op B_r)) := e_iso.inv.hom s'.1
        have ha_S : (ι.app B_r).hom a_S = a' :=
          congrArg (fun f => f.hom a') e_iso.inv_hom_id
        have hs_S : (ι.app B_r).hom s_S = s'.1 :=
          congrArg (fun f => f.hom s'.1) e_iso.inv_hom_id
        have hs_S_ne : s_S ≠ 0 := fun h0 => hs'_ne (by rw [← hs_S, h0, map_zero])
        obtain ⟨k, a₀, hk⟩ := @IsLocalization.Away.surj _ _ _ _ _ r hLoc_r a_S
        obtain ⟨l, b₀, hl⟩ := @IsLocalization.Away.surj _ _ _ _ _ r hLoc_r s_S
        simp only [h_alg_eq] at hk hl
        have hb₀_ne : b₀ ≠ 0 := by
          intro hb0
          rw [hb0, map_zero] at hl
          have hunit_r : IsUnit (res_U.hom r) := by
            rw [← h_alg_eq]
            exact IsLocalization.Away.algebraMap_isUnit r
          exact hs_S_ne ((hunit_r.pow l).mul_left_eq_zero.mp hl)
        have hden_ne : b₀ * r ^ k ≠ 0 := mul_ne_zero hb₀_ne (pow_ne_zero k hr_ne)
        refine ⟨⟨a₀ * r ^ l, ⟨b₀ * r ^ k, mem_nonZeroDivisors_of_ne_zero hden_ne⟩⟩, ?_⟩
        let ψ : ↑(Z.presheaf.obj (Opposite.op B_r)) →+* F_ss := (ι.app B_r ≫ φ_V₀).hom
        have hφ_eq : ∀ x, φ.hom x = ψ (res_U.hom x) := fun _ => rfl
        have hzs_S : z * ψ s_S = ψ a_S := by
          change z * φ_V₀.hom ((ι.app B_r).hom s_S) = φ_V₀.hom ((ι.app B_r).hom a_S)
          rw [hs_S, ha_S]
          exact hzs'
        change z * φ.hom (b₀ * r ^ k) = φ.hom (a₀ * r ^ l)
        rw [map_mul, map_pow, map_mul, map_pow, hφ_eq b₀, hφ_eq a₀, hφ_eq r,
          ← hl, ← hk, map_mul, map_pow, map_mul, map_pow]
        calc z * (ψ s_S * ψ (res_U.hom r) ^ l * ψ (res_U.hom r) ^ k)
            = (z * ψ s_S) * (ψ (res_U.hom r) ^ l * ψ (res_U.hom r) ^ k) := by ring
          _ = ψ a_S * (ψ (res_U.hom r) ^ l * ψ (res_U.hom r) ^ k) := by rw [hzs_S]
          _ = ψ a_S * ψ (res_U.hom r) ^ k * ψ (res_U.hom r) ^ l := by ring
      · intro x y hxy
        exact ⟨1, by simp [hInj_φ hxy]⟩
    · dsimp only [φ]
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp,
        CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        hU.map_fromSpec hBr (CategoryTheory.homOfLE (Z.basicOpen_le r)).op,
        AlgebraicGeometry.Scheme.Hom.app_eq_appLE,
        AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec ι hBr hV₀ (le_refl V₀),
        ← CategoryTheory.Category.assoc, hSpec_V₀]
  
  let P := CategoryTheory.Limits.pullback h_mod p_X
  let fst_P : P ⟶ U'.toScheme := CategoryTheory.Limits.pullback.fst h_mod p_X
  let snd_P : P ⟶ X := CategoryTheory.Limits.pullback.snd h_mod p_X
  let Δ_K : U₀ ⟶ P := CategoryTheory.Limits.pullback.lift ι_U' ι_X hι_pX.symm
  let η_P : AlgebraicGeometry.Spec (CommRingCat.of F_ss) ⟶ P := η_UK ≫ Δ_K
  haveI : AlgebraicGeometry.QuasiCompact η_P :=
    AlgebraicGeometry.QuasiCompact.mk
      (fun _ _ _ => Set.Subsingleton.isCompact fun _ _ _ _ => Subsingleton.elim _ _)
  let C_bar : AlgebraicGeometry.Scheme.{u} := η_P.image
  let j_C : C_bar ⟶ P := η_P.imageι
