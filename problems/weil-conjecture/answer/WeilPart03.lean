            fin_cases i
            · refine ⟨n + 1, Polynomial.C π * Q, ?_⟩
              have hevC : ev_s₀ (Polynomial.C π) = ιB₀ π := Polynomial.eval₂_C ιB₀ s₀
              calc s₀ ^ (n + 1) * Ideal.Quotient.mk I₀ (f * MvPolynomial.X 0)
                _ = (s₀ ^ n * Ideal.Quotient.mk I₀ f) * (u_tilde * s₀) := by
                    rw [pow_succ, map_mul]; change (s₀ ^ n * s₀) * (_ * u_tilde) = _; ring
                _ = ev_s₀ Q * ιB₀ π := by rw [hQ, hrel₀]
                _ = ev_s₀ (Polynomial.C π * Q) := by rw [map_mul, hevC, mul_comm]
            · refine ⟨n, Q * Polynomial.X, ?_⟩
              have hevX1 : ev_s₀ Polynomial.X = s₀ := Polynomial.eval₂_X ιB₀ s₀
              change s₀ ^ n * Ideal.Quotient.mk I₀ (f * MvPolynomial.X 1) = ev_s₀ (Q * Polynomial.X)
              rw [map_mul, ← mul_assoc, hQ, map_mul, hevX1]
        obtain ⟨n, Q, hQ⟩ := hs₀_clear (x - y)
        have hfQ0 : f₀₁ (ev_s₀ Q) = 0 := by rw [← hQ, map_mul, hsub0, mul_zero]
        let d := Q.natDegree
        let Q_rev : Polynomial B :=
          ∑ i ∈ Finset.range (d + 1), Polynomial.C (Q.coeff i) * Polynomial.X ^ (d - i)
        have hf10_Qrev : f₁₀ Q_rev = f₁₀ t₁ ^ d * f₀₁ (ev_s₀ Q) := by
          have hQ_sum : Q = ∑ i ∈ Finset.range (d + 1), Polynomial.C (Q.coeff i) * Polynomial.X ^ i :=
            Polynomial.as_sum_range_C_mul_X_pow Q
          conv_rhs => rw [hQ_sum]
          simp only [Q_rev, map_sum, Finset.mul_sum, map_mul, map_pow]
          refine Finset.sum_congr rfl fun i hi => ?_
          have hi_le : i ≤ d := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
          have hevC : f₀₁ (ev_s₀ (Polynomial.C (Q.coeff i))) = f₁₀ (Polynomial.C (Q.coeff i)) := by
            rw [show ev_s₀ (Polynomial.C (Q.coeff i)) = ιB₀ (Q.coeff i) from Polynomial.eval₂_C ιB₀ s₀]
            exact hf₀₁_C (Q.coeff i)
          have hevX : f₀₁ (ev_s₀ Polynomial.X) = f₀₁ s₀ := by
            rw [show ev_s₀ Polynomial.X = s₀ from Polynomial.eval₂_X ιB₀ s₀]
          rw [hevC, hevX]
          have hpow_cancel : f₁₀ t₁ ^ d * f₀₁ s₀ ^ i = f₁₀ Polynomial.X ^ (d - i) := by
            have hd_eq : d = (d - i) + i := (Nat.sub_add_cancel hi_le).symm
            conv_lhs => rw [hd_eq, pow_add]
            rw [mul_assoc, ← mul_pow, hinv, one_pow, mul_one]
          calc f₁₀ (Polynomial.C (Q.coeff i)) * f₁₀ Polynomial.X ^ (d - i)
            _ = f₁₀ (Polynomial.C (Q.coeff i)) * (f₁₀ t₁ ^ d * f₀₁ s₀ ^ i) := by rw [hpow_cancel]
            _ = f₁₀ t₁ ^ d * (f₁₀ (Polynomial.C (Q.coeff i)) * f₀₁ s₀ ^ i) := by ring
        rw [hfQ0, mul_zero] at hf10_Qrev
        obtain ⟨⟨_, m, rfl⟩, hm0⟩ := (IsLocalization.map_eq_zero_iff (Submonoid.powers t₁) C₀₁ Q_rev).mp hf10_Qrev
        dsimp only at hm0
        have hQ_zero : Q = 0 := by
          ext i
          rw [Polynomial.coeff_zero]
          by_cases hi : i ≤ d
          · have hc0 : (Polynomial.X ^ m * Q_rev).coeff ((d - i) + m) = 0 := by
              rw [hm0, Polynomial.coeff_zero]
            rw [mul_comm, Polynomial.coeff_mul_X_pow] at hc0
            simp only [Q_rev, Polynomial.finsetSum_coeff, Polynomial.coeff_C_mul,
              Polynomial.coeff_X_pow] at hc0
            have hmem : i ∈ Finset.range (d + 1) := Finset.mem_range.mpr (Nat.lt_succ_of_le hi)
            rw [Finset.sum_eq_single i] at hc0
            · simpa using hc0
            · intro j hj hji
              have hj_le : j ≤ d := Nat.lt_succ_iff.mp (Finset.mem_range.mp hj)
              have hsub_ne : d - i ≠ d - j := by omega
              simp [hsub_ne]
            · intro hnot; exact (hnot hmem).elim
          · exact Polynomial.coeff_eq_zero_of_natDegree_lt (Nat.lt_of_not_ge hi)
        refine ⟨⟨s₀ ^ n, n, rfl⟩, ?_⟩
        dsimp only
        rw [← sub_eq_zero, ← mul_sub, hQ, hQ_zero, map_zero]
    have hdu_mem : ∀ q : PrimeSpectrum C₁, p₁ u ∉ q.asIdeal → t₁ ∉ q.asIdeal := by
      intro q hqu ht₁q
      apply hqu; rw [hp₁_u]; exact Ideal.mul_mem_left _ _ ht₁q
    let jAu : A →+* Au := algebraMap A Au
    let u_inv : Au := IsLocalization.Away.invSelf (S := Au) u
    have hu_inv : jAu u * u_inv = 1 := IsLocalization.Away.mul_invSelf (S := Au) u
    let ev_u : MvPolynomial (Fin 2) B →+* Au :=
      MvPolynomial.eval₂Hom (jAu.comp Polynomial.C) ![jAu u, jAu (Polynomial.C π) * u_inv]
    have hev_u_rel : ev_u (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C π) = 0 := by
      simp only [ev_u, map_sub, map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C,
        Matrix.cons_val_zero, Matrix.cons_val_one, RingHom.comp_apply]
      rw [← mul_assoc, mul_comm (jAu u), mul_assoc, hu_inv, mul_one, sub_self]
    let ψu : C₀ →+* Au :=
      Ideal.Quotient.lift I₀ ev_u (fun x hx =>
        RingHom.mem_ker.mp (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr
          (RingHom.mem_ker.mpr hev_u_rel)) hx))
    have hψu_C : ∀ r : B, ψu (ιB₀ r) = jAu (Polynomial.C r) := fun r => by
      change ev_u (MvPolynomial.C r) = jAu (Polynomial.C r); simp [ev_u]
    have hψu_u : ψu u_tilde = jAu u := by
      change ev_u (MvPolynomial.X 0) = jAu u; simp [ev_u]
    have hX_id : Polynomial.C s_inv * (u + Polynomial.C c) = Polynomial.X := by
      simp only [u, sub_add_cancel, ← mul_assoc, ← Polynomial.C_mul, hinv_mul_s,
        Polynomial.C_1, one_mul]
    have hψu_p₀ : ψu.comp p₀ = jAu := by
      apply Polynomial.ringHom_ext
      · intro r; rw [RingHom.comp_apply, hp₀_C_app r, hψu_C]
      · rw [RingHom.comp_apply, hp₀_X, map_mul, map_add, hψu_C, hψu_u, hψu_C,
          ← map_add, ← map_mul, hX_id]
    have hdu_loc : @IsLocalization.Away C₀ _ (p₀ u) Au _ ψu.toAlgebra := by
      have hlocAu_std : IsLocalization (Submonoid.powers u) Au := inferInstance
      let _ : Algebra C₀ Au := ψu.toAlgebra
      rw [IsLocalization.Away, isLocalization_iff]
      refine ⟨?_, ?_, ?_⟩
      · rintro ⟨_, n, rfl⟩
        change IsUnit (ψu ((p₀ u) ^ n))
        rw [hp₀_u, map_pow, hψu_u]
        exact IsUnit.pow n (@IsLocalization.map_units A _ (Submonoid.powers u) Au _ _ hlocAu_std ⟨u, 1, pow_one _⟩)
      · intro z
        obtain ⟨⟨F, ⟨_, n, rfl⟩⟩, hzF⟩ := @IsLocalization.surj A _ (Submonoid.powers u) Au _ _ hlocAu_std z
        dsimp only at hzF
        refine ⟨⟨p₀ F, ⟨(p₀ u) ^ n, n, rfl⟩⟩, ?_⟩
        change z * ψu ((p₀ u) ^ n) = ψu (p₀ F)
        rw [← map_pow, ← RingHom.comp_apply, ← RingHom.comp_apply, hψu_p₀]
        exact hzF
      · intro x y hxy
        change ψu x = ψu y at hxy
        have hsub0 : ψu (x - y) = 0 := by rw [map_sub, hxy, sub_self]
        have hu_clear : ∀ z : C₀, ∃ (n : ℕ) (F : A), u_tilde ^ n * z = p₀ F := by
          intro z
          obtain ⟨G, rfl⟩ := Ideal.Quotient.mk_surjective z
          refine MvPolynomial.induction_on (motive := fun H =>
            ∃ (n : ℕ) (F : A), u_tilde ^ n * Ideal.Quotient.mk I₀ H = p₀ F) G ?_ ?_ ?_
          · intro r
            exact ⟨0, Polynomial.C r, by rw [pow_zero, one_mul, hp₀_C_app r]; rfl⟩
          · rintro f g ⟨n₁, F₁, h₁⟩ ⟨n₂, F₂, h₂⟩
            refine ⟨n₁ + n₂, u ^ n₂ * F₁ + u ^ n₁ * F₂, ?_⟩
            rw [map_add, mul_add, pow_add, mul_comm (u_tilde ^ n₁) (u_tilde ^ n₂), mul_assoc, h₁,
              ← mul_comm (u_tilde ^ n₁) (u_tilde ^ n₂), mul_assoc, h₂,
              map_add, map_mul, map_mul, map_pow, map_pow, hp₀_u]
          · rintro f i ⟨n, F, hF⟩
            fin_cases i
            · refine ⟨n, F * u, ?_⟩
              change u_tilde ^ n * Ideal.Quotient.mk I₀ (f * MvPolynomial.X 0) = p₀ (F * u)
              rw [map_mul, ← mul_assoc, hF, map_mul, hp₀_u]
            · refine ⟨n + 1, F * Polynomial.C π, ?_⟩
              calc u_tilde ^ (n + 1) * Ideal.Quotient.mk I₀ (f * MvPolynomial.X 1)
                _ = (u_tilde ^ n * Ideal.Quotient.mk I₀ f) * (u_tilde * s₀) := by
                    rw [pow_succ, map_mul]; change (u_tilde ^ n * u_tilde) * (_ * s₀) = _; ring
                _ = p₀ F * ιB₀ π := by rw [hF, hrel₀]
                _ = p₀ (F * Polynomial.C π) := by rw [map_mul, hp₀_C_app π]
        obtain ⟨n, F, hF⟩ := hu_clear (x - y)
        have hjAu_F : jAu F = 0 := by
          rw [← hψu_p₀, RingHom.comp_apply, ← hF, map_mul, hsub0, mul_zero]
        obtain ⟨⟨_, m, rfl⟩, hm0⟩ := (@IsLocalization.map_eq_zero_iff A _ (Submonoid.powers u) Au _ _ hlocAu_std F).mp hjAu_F
        dsimp only at hm0
        refine ⟨⟨(p₀ u) ^ (m + n), m + n, rfl⟩, ?_⟩
        dsimp only
        rw [← sub_eq_zero, ← mul_sub, hp₀_u, pow_add, mul_assoc, hF, ← hp₀_u, ← map_pow,
          ← map_mul, hm0, map_zero]
    have hdπ_mem : ∀ q : PrimeSpectrum C₀, p₀ (Polynomial.C π) ∉ q.asIdeal → s₀ ∉ q.asIdeal := by
      intro q hqπ hs₀q
      apply hqπ
      have hp₀_π : p₀ (Polynomial.C π) = u_tilde * s₀ := by rw [hp₀_C_app π, ← hrel₀]
      rw [hp₀_π]; exact Ideal.mul_mem_left _ _ hs₀q
    let cπ : A := Polynomial.C π
    let jAπ : A →+* Aπ := algebraMap A Aπ
    let π_inv : Aπ := IsLocalization.Away.invSelf (S := Aπ) cπ
    have hπ_inv : jAπ cπ * π_inv = 1 := IsLocalization.Away.mul_invSelf (S := Aπ) cπ
    let ψπ : C₁ →+* Aπ :=
      Polynomial.eval₂RingHom (jAπ.comp Polynomial.C) (jAπ u * π_inv)
    have hψπ_p₁ : ψπ.comp p₁ = jAπ := by
      apply Polynomial.ringHom_ext
      · intro r
        rw [RingHom.comp_apply, hp₁_C_app r]
        exact Polynomial.eval₂_C (jAπ.comp Polynomial.C) _
      · rw [RingHom.comp_apply, hp₁_X, map_mul, map_add, map_mul]
        have hC_eval : ∀ r : B, ψπ (Polynomial.C r) = jAπ (Polynomial.C r) := fun r =>
          Polynomial.eval₂_C (jAπ.comp Polynomial.C) _
        have hX_eval : ψπ t₁ = jAπ u * π_inv :=
          Polynomial.eval₂_X (jAπ.comp Polynomial.C) _
        rw [hC_eval, hC_eval, hX_eval, hC_eval]
        change jAπ (Polynomial.C s_inv) * (jAπ cπ * (jAπ u * π_inv) + jAπ (Polynomial.C c)) =
          jAπ Polynomial.X
        rw [← mul_assoc (jAπ cπ), mul_comm (jAπ cπ) (jAπ u), mul_assoc (jAπ u),
          hπ_inv, mul_one, ← map_add, ← map_mul, hX_id]
    have hdπ_loc : @IsLocalization.Away C₁ _ (p₁ cπ) Aπ _ ψπ.toAlgebra := by
      have hp₁_cπ : p₁ cπ = Polynomial.C π := hp₁_C_app π
      dsimp only [IsLocalization.Away]
      rw [@isLocalization_iff C₁ _ (Submonoid.powers (p₁ cπ)) Aπ _ ψπ.toAlgebra]
      refine ⟨?_, ?_, ?_⟩
      · rintro ⟨_, n, rfl⟩
        change IsUnit (ψπ ((p₁ cπ) ^ n))
        rw [← map_pow, ← RingHom.comp_apply, hψπ_p₁, map_pow]
        exact IsUnit.pow n (IsUnit.of_mul_eq_one π_inv hπ_inv)
      · intro z
        obtain ⟨⟨F, ⟨_, n, rfl⟩⟩, hzF⟩ := IsLocalization.surj (Submonoid.powers cπ) z
        dsimp only at hzF
        refine ⟨⟨p₁ F, ⟨(p₁ cπ) ^ n, n, rfl⟩⟩, ?_⟩
        change z * ψπ ((p₁ cπ) ^ n) = ψπ (p₁ F)
        rw [← map_pow, ← RingHom.comp_apply, ← RingHom.comp_apply, hψπ_p₁]
        exact hzF
      · intro x y hxy
        change ψπ x = ψπ y at hxy
        have hsub0 : ψπ (x - y) = 0 := by rw [map_sub, hxy, sub_self]
        have hπ_clear : ∀ G : C₁, ∃ (n : ℕ) (F : A), (p₁ cπ) ^ n * G = p₁ F := by
          intro G
          refine Polynomial.induction_on G ?_ ?_ ?_
          · intro r
            exact ⟨0, Polynomial.C r, by rw [pow_zero, one_mul, hp₁_C_app r]⟩
          · rintro f g ⟨n₁, F₁, h₁⟩ ⟨n₂, F₂, h₂⟩
            refine ⟨n₁ + n₂, cπ ^ n₂ * F₁ + cπ ^ n₁ * F₂, ?_⟩
            rw [mul_add, pow_add, mul_comm ((p₁ cπ) ^ n₁) ((p₁ cπ) ^ n₂), mul_assoc, h₁,
              ← mul_comm ((p₁ cπ) ^ n₁) ((p₁ cπ) ^ n₂), mul_assoc, h₂,
              map_add, map_mul, map_mul, map_pow, map_pow]
          · rintro n r ⟨k, F, hF⟩
            refine ⟨k + 1, F * u, ?_⟩
            calc (p₁ cπ) ^ (k + 1) * (Polynomial.C r * Polynomial.X ^ (n + 1))
              _ = ((p₁ cπ) ^ k * (Polynomial.C r * Polynomial.X ^ n)) * (Polynomial.C π * t₁) := by
                  rw [hp₁_cπ, pow_succ, pow_succ]; change (_ * _) * (_ * (_ * t₁)) = _; ring
              _ = p₁ F * p₁ u := by rw [hF, hp₁_u]
              _ = p₁ (F * u) := (map_mul p₁ F u).symm
        obtain ⟨n, F, hF⟩ := hπ_clear (x - y)
        have hjAπ_F : jAπ F = 0 := by
          rw [← hψπ_p₁, RingHom.comp_apply, ← hF, map_mul, hsub0, mul_zero]
        obtain ⟨⟨_, m, rfl⟩, hm0⟩ := (IsLocalization.map_eq_zero_iff (Submonoid.powers cπ) Aπ F).mp hjAπ_F
        dsimp only at hm0
        refine ⟨⟨(p₁ cπ) ^ (m + n), m + n, rfl⟩, ?_⟩
        dsimp only
        rw [← sub_eq_zero, ← mul_sub, pow_add, mul_assoc, hF, ← map_pow, ← map_mul, hm0, map_zero]
    have hloc₁ : @IsLocalization.Away C₁ _ t₁ C₀₁ _ f₁₀.toAlgebra := by
      dsimp only [IsLocalization.Away]
      rw [@isLocalization_iff C₁ _ (Submonoid.powers t₁) C₀₁ _ f₁₀.toAlgebra]
      exact (isLocalization_iff (Submonoid.powers t₁) C₀₁).mp inferInstance
    exact ⟨p₀, p₁, f₀₁, f₁₀, ψu, ψπ, hp₀_C, hp₁_C, hp₀_u, hp₁_u,
      hloc₀, hloc₁, hf_comp, hgen₀, hgen₁, hinv,
      hdu_mem, hψu_p₀, hdu_loc, hdπ_mem, hψπ_p₁, hdπ_loc⟩
  
  have hProjCoordPkg : ∀ (R : Type u) [CommRing R] (N : ℕ),
      ∃ (hAff : ∀ a : Fin (N + 1), AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen R N a))
        (c_R : ∀ a : Fin (N + 1),
          R →+* ↑((weilProjectiveSpaceOver R N).left.presheaf.obj
            (Opposite.op (weilProjBasicOpen R N a))))
        (t_R : ∀ a : Fin (N + 1), Fin (N + 1) →
          ↑((weilProjectiveSpaceOver R N).left.presheaf.obj
            (Opposite.op (weilProjBasicOpen R N a)))),
        IsCommRingProjCoordSystem R N hAff c_R t_R := by
    intro R _ N
    classical
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    let hX_mem : ∀ b : Fin (N + 1), MvPolynomial.X b ∈ 𝒜 1 :=
      fun b => (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X R b)
    let hAff : ∀ a : Fin (N + 1), AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen R N a) :=
      fun a => AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜
        (MvPolynomial.X a) (hX_mem a) zero_lt_one
    let c_R : ∀ a : Fin (N + 1),
        R →+* ↑((weilProjectiveSpaceOver R N).left.presheaf.obj
          (Opposite.op (weilProjBasicOpen R N a))) :=
      fun a =>
        (AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X a)).hom.comp
          ((HomogeneousLocalization.fromZeroRingHom 𝒜
            (Submonoid.powers (MvPolynomial.X a))).comp (algebraMap R ↥(𝒜 0)))
    let t_R : ∀ a : Fin (N + 1), Fin (N + 1) →
        ↑((weilProjectiveSpaceOver R N).left.presheaf.obj
          (Opposite.op (weilProjBasicOpen R N a))) :=
      fun a b =>
        (AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X a)).hom
          (HomogeneousLocalization.Away.mk 𝒜 (hX_mem a) 1 (MvPolynomial.X b) (hX_mem b))
    have halg0 : ∀ r : R,
        (algebraMap R ↥(𝒜 0) r : MvPolynomial (Fin (N + 1)) R) = MvPolynomial.C r := by
      intro r
      rw [Algebra.algebraMap_eq_smul_one]
      change r • (1 : MvPolynomial (Fin (N + 1)) R) = MvPolynomial.C r
      rw [Algebra.smul_def, mul_one, MvPolynomial.algebraMap_eq]
    have hinj0 : Function.Injective (algebraMap R ↥(𝒜 0)) := by
      intro r₁ r₂ h
      have h1 : (algebraMap R ↥(𝒜 0) r₁ : MvPolynomial (Fin (N + 1)) R) =
          (algebraMap R ↥(𝒜 0) r₂ : MvPolynomial (Fin (N + 1)) R) := congrArg Subtype.val h
      rw [halg0, halg0] at h1
      simpa using congrArg MvPolynomial.constantCoeff h1
    have hsurj0 : Function.Surjective (algebraMap R ↥(𝒜 0)) := by
      intro p
      refine ⟨p.1.coeff 0, Subtype.ext ?_⟩
      rw [halg0]
      ext m
      by_cases hm : m = 0
      · subst hm; simp
      · rw [MvPolynomial.coeff_C, if_neg (Ne.symm hm)]
        symm
        by_contra hne
        have hp : p.1.IsHomogeneous 0 := (MvPolynomial.mem_homogeneousSubmodule 0 p.1).mp p.2
        have hdeg := hp hne
        simp only [Finsupp.weight_apply, Finsupp.sum, smul_eq_mul, Pi.one_apply, mul_one] at hdeg
        have hne' : ∃ i : Fin (N + 1), m i ≠ 0 := by
          by_contra hall
          exact hm (Finsupp.ext fun i => Classical.not_not.mp fun h => hall ⟨i, h⟩)
        rcases hne' with ⟨i, hi⟩
        exact hi ((Finset.sum_eq_zero_iff.mp hdeg) i (Finsupp.mem_support_iff.mpr hi))
    let e₀ : R ≃+* ↥(𝒜 0) := RingEquiv.ofBijective (algebraMap R ↥(𝒜 0)) ⟨hinj0, hsurj0⟩
    have he₀ : CommRingCat.ofHom (algebraMap R ↥(𝒜 0)) = e₀.toCommRingCatIso.hom := by
      apply CommRingCat.hom_ext; rfl
    have _ : CategoryTheory.IsIso (CommRingCat.ofHom (algebraMap R ↥(𝒜 0))) := by
      rw [he₀]; infer_instance
    have _ : CategoryTheory.IsIso
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R ↥(𝒜 0)))) := inferInstance
    let _ : IsScalarTower R ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) R) :=
      IsScalarTower.of_algebraMap_eq' (R := R) (S := ↥(𝒜 0))
        (A := MvPolynomial (Fin (N + 1)) R) (RingHom.ext fun r => by
          change algebraMap R (MvPolynomial (Fin (N + 1)) R) r =
            (algebraMap R ↥(𝒜 0) r : MvPolynomial (Fin (N + 1)) R)
