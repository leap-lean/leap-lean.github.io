            have hx_RB : x ∈ R_B := R_B.mul_mem (hK_RB δ_α) hu_α_RB
            have hx_lt : ‖x‖ < 1 := by
              dsimp [x, δ_α]
              rw [norm_mul, hIsoK₁, hu_α_norm, mul_one]
              exact hδ_α
