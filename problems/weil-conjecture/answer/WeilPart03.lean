  let u : E := y₀ / v₁Map π₁
  let w : E := v₁Map π₂ / y₀
  have hπ₁_val_ne : π₁.1 ≠ 0 := fun h0 => hπ₁_ne (Subtype.ext h0)
  have hπ₂_val_ne : π₂.1 ≠ 0 := fun h0 => hπ₂_ne (Subtype.ext h0)
  have hvπ₁_ne : v₁Map π₁ ≠ 0 := hv₁_ne hπ₁_ne
  have hvπ₂_ne : v₁Map π₂ ≠ 0 := hv₁_ne hπ₂_ne
