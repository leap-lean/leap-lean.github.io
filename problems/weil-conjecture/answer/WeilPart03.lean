    haveI : FiniteDimensional ↥K_base ↥K'_int := FiniteDimensional.left ↥K_base ↥K'_int N
    let H_val : Subgroup (↥K'_int)ˣ :=
      { carrier := { w : (↥K'_int)ˣ | ∃ u : ↥K_base, u ≠ 0 ∧ ‖((w : ↥K'_int) : N)‖ = ‖u‖ }
        one_mem' := ⟨1, one_ne_zero, by simp⟩
        mul_mem' := by
          rintro w₁ w₂ ⟨u₁, hu₁_ne, hu₁⟩ ⟨u₂, hu₂_ne, hu₂⟩
          refine ⟨u₁ * u₂, mul_ne_zero hu₁_ne hu₂_ne, ?_⟩
          change ‖K'_int.val ((w₁ * w₂ : (↥K'_int)ˣ) : ↥K'_int)‖ = ‖u₁ * u₂‖
          rw [Units.val_mul, map_mul, norm_mul, norm_mul]
          exact congrArg₂ (· * ·) hu₁ hu₂
        inv_mem' := by
          rintro w ⟨u, hu_ne, hu⟩
          refine ⟨u⁻¹, inv_ne_zero hu_ne, ?_⟩
          change ‖K'_int.val ((w⁻¹ : (↥K'_int)ˣ) : ↥K'_int)‖ = ‖u⁻¹‖
          rw [Units.val_inv_eq_inv_val, map_inv₀, norm_inv, norm_inv]
