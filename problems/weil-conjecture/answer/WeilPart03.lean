  have hs3 :
      ∀ (X Y S : AlgebraicGeometry.Scheme.{u})
        (p : X ⟶ S) (q : Y ⟶ S) (N : ℕ)
        (D : Fin (N + 1) → Y.Opens)
        (U : Fin (N + 1) → X.Opens)
        (hD_aff : ∀ a : Fin (N + 1), AlgebraicGeometry.IsAffineOpen (D a))
        (hU_aff : ∀ a : Fin (N + 1), AlgebraicGeometry.IsAffineOpen (U a)),
        (⨆ a : Fin (N + 1), D a) = ⊤ →
        (⨆ a : Fin (N + 1), U a) = ⊤ →
