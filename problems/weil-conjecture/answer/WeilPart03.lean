          (S : F), S ≠ 0 → (∀ c : K_hat, ‖S‖ ≠ ‖c‖) →
          ∀ (m : ℤ), m ≠ 0 → ∀ (c : K_hat), c ≠ 0 → ‖S ^ m‖ ≠ ‖c‖ := by
        intro F _ _ _ S _hS_ne hS_irr m hm c _hc heq
