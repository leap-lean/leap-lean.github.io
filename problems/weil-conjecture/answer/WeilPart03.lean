        have hKT_map_CB : ∀ (x : E_hat) (hx : x ∈ KT_sub),
            algebraMap ↥L L₁ ⟨x, hKT_le_L hx⟩ ∈ C_B := by
          intro x hx
          change x ∈ IntermediateField.adjoin K_hat ({T} : Set E_hat) at hx
          rw [IntermediateField.mem_adjoin_simple_iff] at hx
          rcases hx with ⟨P, Q, rfl⟩
          have hdiv_L : (⟨Polynomial.aeval T P / Polynomial.aeval T Q, hKT_le_L hx⟩ : ↥L) =
