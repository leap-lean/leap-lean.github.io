      exact ⟨fun hne => lt_of_le_of_ne ((h_mem_OF _).mp y.2) hne, fun hlt => ne_of_lt hlt⟩
    have hRes_OF_ne : ∀ y : ↥OF, IsLocalRing.residue ↥OF y ≠ 0 ↔ ‖(y : F_hat)‖ = 1 := by
      intro y
      rw [ne_eq, hRes_OF_zero]
