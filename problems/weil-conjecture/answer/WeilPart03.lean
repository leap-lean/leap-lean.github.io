          ‖((∑ i : Fin (Module.finrank ↥L F_hat), ι (c i) * w₀ ^ (i : ℕ) : ↥OF) : F_hat)‖ = 1 := by
    intro L hNontriv OF OL
    let _ : Algebra ↥L F_hat := L.toAlgebra
    intro ι
    let _ : Algebra ↥OL ↥OF := ι.toAlgebra
    intro hFin hMod hEt
    have h_mem_OF : ∀ x : F_hat, x ∈ OF ↔ ‖x‖ ≤ 1 := by
      intro x
      rw [Valuation.mem_valuationSubring_iff, NormedField.valuation_apply]
      exact NNReal.coe_le_coe.symm
    have h_mem_OL : ∀ u : ↥L, u ∈ OL ↔ ‖(u : F_hat)‖ ≤ 1 := by
      intro u
      rw [ValuationSubring.mem_comap]
      exact h_mem_OF (u : F_hat)
    have hUnit_OF : ∀ y : ↥OF, IsUnit y ↔ ‖(y : F_hat)‖ = 1 := by
      intro y
      constructor
      · rintro ⟨u, rfl⟩
        have hmul : ((u.val * u.inv : ↥OF) : F_hat) = 1 := congrArg Subtype.val u.val_inv
        have h1 : ‖(u.val : F_hat)‖ * ‖(u.inv : F_hat)‖ = 1 := by
