            exact Finset.card_image_le
        _ = d := Fintype.card_fin d
    have hd_eq_n : d = n := le_antisymm hd_le_n hn_le_d
    obtain ⟨w_bar, hw_prim⟩ := Field.exists_primitive_element κ_L κ_F
    have hInt_w : IsIntegral κ_L w_bar := Algebra.IsIntegral.isIntegral w_bar
