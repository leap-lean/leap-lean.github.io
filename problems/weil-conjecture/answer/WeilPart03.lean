      rw [hcomp_eq]
      change Polynomial.eval₂ (res_W.comp _) (res_W (φ_U.hom f)) Q ≠ 0
      rw [← Polynomial.hom_eval₂]
      intro hzero
      have hmem : Polynomial.eval₂ (AlgebraicGeometry.Spec.preimage (ψ_U' ≫ h_mod ≫ g_ss)).hom
