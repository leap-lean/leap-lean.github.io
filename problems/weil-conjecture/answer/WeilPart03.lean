              rw [Int.toNat_eq_zero, ← WithZero.exp_le_exp, WithZero.exp_log hvf, WithZero.exp_zero]
          have hloc_smul : ∀ (v : IsDedekindDomain.HeightOneSpectrum A) (c : E) (f : L),
