                  ext i
                  simp only [Finset.notMem_empty, iff_false]
                  intro hi
                  exact hnone ((Finset.mem_singleton.mp (hsub_none hi)) ▸ hi)
                rw [hS_pos_empty, Finset.sum_empty]
                simp [z, hnone, zero_pow hp.ne_zero]
            have hu_part_mem : (∑ i ∈ S₀, g i • fam i) ∈ Submodule.span ↥E_max U₀ := by
              refine Submodule.sum_mem _ fun i hi => ?_
              rcases i with _ | ⟨n, u⟩
              · exfalso; exact Bool.false_ne_true (Finset.mem_filter.mp hi).2
              · rcases n with _ | k
                · simp only [fam, pow_zero, pow_one]
                  exact Submodule.smul_mem _ _ (Submodule.subset_span u.2)
                · exfalso; exact Bool.false_ne_true (Finset.mem_filter.mp hi).2
            have hu_zero : ∑ i ∈ S₀, g i • fam i = 0 := by
              rw [hsplit, hS_pos_eq] at hsum
