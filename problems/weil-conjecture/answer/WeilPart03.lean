          apply Finset.sum_eq_zero
          intro j hj
          rw [Nat.choose_eq_zero_of_lt (Finset.mem_range.mp hj), Nat.cast_zero, zero_mul, zero_mul]
        rw [hzero_low, zero_add]
        apply Finset.sum_congr rfl
        intro j _
        rw [Polynomial.aeval_monomial, map_mul, map_natCast]
