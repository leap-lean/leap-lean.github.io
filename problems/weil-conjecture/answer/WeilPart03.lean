    have hRes_OL_ne : ∀ b : ↥OL, IsLocalRing.residue ↥OL b ≠ 0 ↔ ‖((b : ↥OL) : F_hat)‖ = 1 := by
      intro b
      change Ideal.Quotient.mk (IsLocalRing.maximalIdeal ↥OL) b ≠ 0 ↔ _
      rw [ne_eq, Ideal.Quotient.eq_zero_iff_mem, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
