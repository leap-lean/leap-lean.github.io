      have hspec : η_V pt_K ⤳ q := hspec_ps
      exact ⟨η_V pt_K, hspec.mem_open hU_open hq, pt_K, rfl⟩
    have hτ'_π' : ∀ j : Fin n, τ' j ≫ π' = τ₀ j := by
      intro j
      have : AlgebraicGeometry.IsDominant η_V := hDom_ηV
      refine AlgebraicGeometry.ext_of_isDominant_of_isSeparated g₀ ?_ η_V ?_
      · rw [CategoryTheory.Category.assoc, hπ'_g₀, hMod'.2.2.2.2.2.2.1 j,
          hMod₀.2.2.2.2.2.2.1 j]
      · rw [← CategoryTheory.Category.assoc, ← hMod'.2.2.2.2.2.2.2.2 j,
          CategoryTheory.Category.assoc, hι'_π', hMod₀.2.2.2.2.2.2.2.2 j]
    exact ⟨π', hπ'_g₀, hι'_π', hτ'_π'⟩
  
  have h_s34 : ∀ (r_i : Fin (M₀ + 1)), ξ r_i ≠ 0 →
      ∀ (I_i : Finset (Fin L)) (B₀ : Subring F)
        (hVB₀ : ∀ y : ↥V, ((algebraMap K F).comp V.subtype) y ∈ B₀),
        (∀ s : Fin (M₀ + 1), ξ s / ξ r_i ∈ B₀) →
        (∀ γ ∈ I_i, f γ ∈ B₀) →
        Subring.closure
          (Set.range ((algebraMap K F).comp V.subtype) ∪
            Set.range (fun s : Fin (M₀ + 1) => ξ s / ξ r_i) ∪
            (f '' (I_i : Set (Fin L)))) = B₀ →
        let U' : C'.Opens :=
          ⨆ J₀ : {J : Finset (Fin L) // Disjoint J I_i},
            (TopologicalSpace.Opens.map ιP'.base).obj
              (weilProjBasicOpen ↥V M (eSeg.symm (r_i, J₀.1)))
        ∃ (h_mod : U'.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥B₀)),
          AlgebraicGeometry.IsProper h_mod ∧
          h_mod ≫ AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom
              (RingHom.codRestrict ((algebraMap K F).comp V.subtype) B₀ hVB₀)) =
            U'.ι ≫ g' ∧
          ∀ (η_U' : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ U'.toScheme),
            η_U' ≫ U'.ι = η_F ≫ ι' →
            η_U' ≫ h_mod = AlgebraicGeometry.Spec.map (CommRingCat.ofHom B₀.subtype) := by
    intro r_i hξ_ri I_i B₀ hVB₀ hξ_B₀ hf_B₀ hB₀_gen U'
    let ι_idx := {J : Finset (Fin L) // Disjoint J I_i}
    let j_emp : ι_idx := ⟨∅, Finset.disjoint_empty_left I_i⟩
    have hpos : 1 ≤ Fintype.card ι_idx := Fintype.card_pos_iff.mpr ⟨j_emp⟩
    let N_i : ℕ := Fintype.card ι_idx - 1
    have hNi : Fintype.card ι_idx = N_i + 1 := (Nat.sub_add_cancel hpos).symm
    let e_idx : ι_idx ≃ Fin (N_i + 1) := Fintype.equivFinOfCardEq hNi
    let idx : ι_idx → Fin (M + 1) := fun j => eSeg.symm (r_i, j.1)
    let D' : ι_idx → C'.Opens :=
      fun j => (TopologicalSpace.Opens.map ιP'.base).obj (weilProjBasicOpen ↥V M (idx j))
    let P_B := (weilProjectiveSpaceOver ↥B₀ N_i).left
    let π_B := (weilProjectiveSpaceOver ↥B₀ N_i).hom
    let D_B : Fin (N_i + 1) → P_B.Opens := fun b => weilProjBasicOpen ↥B₀ N_i b
    have h_s3 : ∀ j : ι_idx,
        Nonempty ↥(D' j) ∧
        ∃ (χ : ↑(P_B.presheaf.obj (Opposite.op (D_B (e_idx j)))) →+*
              ↑(C'.presheaf.obj (Opposite.op (D' j)))),
          Function.Surjective χ ∧
          (∀ b : Fin (N_i + 1),
            χ (t_proj ↥B₀ N_i (e_idx j) b) =
              (ιP'.app (weilProjBasicOpen ↥V M (idx j))).hom
                (t_proj ↥V M (idx j) (idx (e_idx.symm b)))) ∧
          ((χ.comp (c_proj ↥B₀ N_i (e_idx j))).comp
              (RingHom.codRestrict ((algebraMap K F).comp V.subtype) B₀ hVB₀) =
            ((ιP'.app (weilProjBasicOpen ↥V M (idx j))).hom).comp (c_proj ↥V M (idx j))) ∧
          (∀ (hAff_j : AlgebraicGeometry.IsAffineOpen (D' j))
              (φ' : C'.presheaf.obj (Opposite.op (D' j)) ⟶ CommRingCat.of F),
            AlgebraicGeometry.Spec.map φ' ≫ hAff_j.fromSpec = η_F ≫ ι' →
            φ'.hom.comp (χ.comp (c_proj ↥B₀ N_i (e_idx j))) = B₀.subtype) := by
      intro j
      let α₀ := idx j
      let a₀ := e_idx j
      have he_α₀ : eSeg α₀ = (r_i, j.1) := eSeg.apply_symm_apply (r_i, j.1)
      have hξ_α₀ : ξ (eSeg α₀).1 ≠ 0 := by rw [he_α₀]; exact hξ_ri
      have hne_j : Nonempty ↥(D' j) := (h_s1 α₀).2.1.mpr hξ_α₀
      have hAff_j : AlgebraicGeometry.IsAffineOpen (D' j) := (h_s1 α₀).1
      obtain ⟨φ'₀, hFrac₀, hφ'₀⟩ := hFunc' (D' j) hAff_j hne_j
      let : Algebra ↑(C'.presheaf.obj (Opposite.op (D' j))) F := φ'₀.hom.toAlgebra
      have hinj₀ : Function.Injective φ'₀.hom :=
        @IsFractionRing.injective ↑(C'.presheaf.obj (Opposite.op (D' j))) _ F _ _ hFrac₀
      have hEval₀ := (h_s1 α₀).2.2 hne_j hAff_j φ'₀ hφ'₀
      have hSub₀ : ∀ x : ↥B₀, x.1 ∈ φ'₀.hom.range := by
        intro x
        let x_val : F := x.1
        have hx : x_val ∈ (B₀ : Set F) := x.2
        rw [← hB₀_gen] at hx
        exact Subring.closure_le.mpr (by
          rintro z ((⟨y, rfl⟩ | ⟨s, rfl⟩) | ⟨γ, hγ_set, rfl⟩)
          · exact ⟨(ιP'.app (weilProjBasicOpen ↥V M α₀)).hom (c_proj ↥V M α₀ y), hEval₀.1 y⟩
          · let β_s := eSeg.symm (s, j.1)
            refine ⟨(ιP'.app (weilProjBasicOpen ↥V M α₀)).hom (t_proj ↥V M α₀ β_s), ?_⟩
            have ht := hEval₀.2 β_s
            have heβ : eSeg β_s = (s, j.1) := eSeg.apply_symm_apply (s, j.1)
            have hd1 : (eSeg β_s).2 \ (eSeg α₀).2 = ∅ := by
              rw [heβ, he_α₀]; exact Finset.sdiff_self j.1
            have hd2 : (eSeg α₀).2 \ (eSeg β_s).2 = ∅ := by
              rw [heβ, he_α₀]; exact Finset.sdiff_self j.1
            rw [ht, hd1, hd2, Finset.prod_empty, Finset.prod_empty, mul_one, mul_one, heβ, he_α₀]
          · have hγ : γ ∈ I_i := hγ_set
            have hγ_not : γ ∉ j.1 := Finset.disjoint_right.mp j.2 hγ
            let β_γ := eSeg.symm (r_i, insert γ j.1)
            refine ⟨(ιP'.app (weilProjBasicOpen ↥V M α₀)).hom (t_proj ↥V M α₀ β_γ), ?_⟩
            have ht := hEval₀.2 β_γ
            have heβ : eSeg β_γ = (r_i, insert γ j.1) := eSeg.apply_symm_apply _
            have hd1 : (eSeg β_γ).2 \ (eSeg α₀).2 = {γ} := by
              rw [heβ, he_α₀]
              ext u
              simp only [Finset.mem_sdiff, Finset.mem_insert, Finset.mem_singleton]
              constructor
              · rintro ⟨rfl | hu, hnu⟩
                · rfl
                · exact False.elim (hnu hu)
              · rintro rfl
                exact ⟨Or.inl rfl, hγ_not⟩
            have hd2 : (eSeg α₀).2 \ (eSeg β_γ).2 = ∅ := by
              rw [heβ, he_α₀]
              ext u
              simp only [Finset.mem_sdiff, Finset.mem_insert, Finset.notMem_empty, iff_false, not_and]
              intro hu hnu
              exact hnu (Or.inr hu)
            rw [ht, hd1, hd2, Finset.prod_singleton, Finset.prod_empty, mul_one, heβ, he_α₀]
            simp only [div_self hξ_ri, one_mul]) hx
      let e_rng₀ : ↑(C'.presheaf.obj (Opposite.op (D' j))) ≃+* ↥φ'₀.hom.range :=
        RingEquiv.ofBijective φ'₀.hom.rangeRestrict
          ⟨fun x y h => hinj₀ (congrArg Subtype.val h), fun ⟨_, u, rfl⟩ => ⟨u, rfl⟩⟩
      let ρ₀ : ↥B₀ →+* ↑(C'.presheaf.obj (Opposite.op (D' j))) :=
        e_rng₀.symm.toRingHom.comp (RingHom.codRestrict B₀.subtype φ'₀.hom.range hSub₀)
      have hρ₀ : φ'₀.hom.comp ρ₀ = B₀.subtype := by
        ext x
        change (e_rng₀ (e_rng₀.symm ⟨x.1, hSub₀ x⟩)).1 = x.1
        rw [RingEquiv.apply_symm_apply]
      let w : Fin (N_i + 1) → ↑(C'.presheaf.obj (Opposite.op (D' j))) :=
        fun b => (ιP'.app (weilProjBasicOpen ↥V M α₀)).hom (t_proj ↥V M α₀ (idx (e_idx.symm b)))
      have hw_a₀ : w a₀ = 1 := by
        dsimp only [w, a₀]
        rw [Equiv.symm_apply_apply, (hCoord_proj ↥V M).2.2.2.2.1 α₀, map_one]
      obtain ⟨χ, hχ_c, hχ_t⟩ :=
        (hCoord_proj ↥B₀ N_i).2.2.2.2.2.2.1 a₀ ↑(C'.presheaf.obj (Opposite.op (D' j))) ρ₀ w hw_a₀
      have hχ_V : (χ.comp (c_proj ↥B₀ N_i a₀)).comp
            (RingHom.codRestrict ((algebraMap K F).comp V.subtype) B₀ hVB₀) =
          ((ιP'.app (weilProjBasicOpen ↥V M α₀)).hom).comp (c_proj ↥V M α₀) := by
        ext y
        apply hinj₀
        rw [hχ_c]
        change (φ'₀.hom.comp ρ₀) ⟨((algebraMap K F).comp V.subtype) y, hVB₀ y⟩ =
          φ'₀.hom ((ιP'.app (weilProjBasicOpen ↥V M α₀)).hom (c_proj ↥V M α₀ y))
        rw [hρ₀, hEval₀.1 y]
        rfl
      have hχ_F : ∀ (hAff_j' : AlgebraicGeometry.IsAffineOpen (D' j))
          (φ' : C'.presheaf.obj (Opposite.op (D' j)) ⟶ CommRingCat.of F),
          AlgebraicGeometry.Spec.map φ' ≫ hAff_j'.fromSpec = η_F ≫ ι' →
          φ'.hom.comp (χ.comp (c_proj ↥B₀ N_i a₀)) = B₀.subtype := by
        intro hAff_j' φ' hφ'
        have hc : hAff_j' = hAff_j := Subsingleton.elim _ _
        subst hAff_j'
        have heq : φ' = φ'₀ :=
          AlgebraicGeometry.Spec.map_injective ((cancel_mono hAff_j.fromSpec).mp (hφ'.trans hφ'₀.symm))
        rw [heq, hχ_c, hρ₀]
      have hSurj : Function.Surjective χ := by
        let S_pre := χ.range.comap (ιP'.app (weilProjBasicOpen ↥V M α₀)).hom
        have hS_top : S_pre = ⊤ := by
          rw [eq_top_iff, ← (hCoord_proj ↥V M).2.2.2.2.2.1 α₀, Subring.closure_le]
          rintro z (⟨y, rfl⟩ | ⟨β, rfl⟩)
          · change (ιP'.app (weilProjBasicOpen ↥V M α₀)).hom (c_proj ↥V M α₀ y) ∈ χ.range
            refine ⟨c_proj ↥B₀ N_i a₀ ⟨((algebraMap K F).comp V.subtype) y, hVB₀ y⟩, ?_⟩
            exact congrArg (fun u => u y) hχ_V
          · change (ιP'.app (weilProjBasicOpen ↥V M α₀)).hom (t_proj ↥V M α₀ β) ∈ χ.range
            let s := (eSeg β).1
            let J := (eSeg β).2
            let J_in : Finset (Fin L) := J ∩ I_i
            let J_out : Finset (Fin L) := J \ I_i
            have h_out : Disjoint J_out I_i := Finset.sdiff_disjoint
            let c : Fin (N_i + 1) := e_idx ⟨J_out, h_out⟩
            have hu_in : (ξ s / ξ r_i) * (∏ γ ∈ J_in, f γ) ∈ B₀ :=
              B₀.mul_mem (hξ_B₀ s)
                (B₀.prod_mem fun γ hγ => hf_B₀ γ (Finset.mem_of_mem_inter_right hγ))
            let u_in : ↥B₀ := ⟨(ξ s / ξ r_i) * (∏ γ ∈ J_in, f γ), hu_in⟩
            refine ⟨c_proj ↥B₀ N_i a₀ u_in * t_proj ↥B₀ N_i a₀ c, ?_⟩
            apply hinj₀
            rw [map_mul, map_mul, hχ_t c]
            have h1 : φ'₀.hom (χ (c_proj ↥B₀ N_i a₀ u_in)) = (ξ s / ξ r_i) * (∏ γ ∈ J_in, f γ) := by
              change ((φ'₀.hom.comp (χ.comp (c_proj ↥B₀ N_i a₀))) u_in) = _
              rw [hχ_c, hρ₀]
              rfl
            have hec : (e_idx.symm c).1 = J_out := by
              dsimp only [c]; rw [Equiv.symm_apply_apply]
            have he_wc : eSeg (idx (e_idx.symm c)) = (r_i, J_out) := by
              dsimp only [idx]; rw [hec, eSeg.apply_symm_apply]
            have h2 : φ'₀.hom (w c) =
                (∏ γ ∈ J_out \ j.1, f γ) * (∏ γ ∈ j.1 \ J_out, (f γ)⁻¹) := by
              have ht := hEval₀.2 (idx (e_idx.symm c))
              rw [ht, he_wc, he_α₀, div_self hξ_ri, one_mul]
            have hF1_disj : Disjoint J_in (J_out \ j.1) := by
              rw [Finset.disjoint_left]
              intro x hx_in hx_out
              exact (Finset.mem_sdiff.mp (Finset.mem_sdiff.mp hx_out).1).2
                (Finset.mem_of_mem_inter_right hx_in)
            have hF1_union : J_in ∪ (J_out \ j.1) = J \ j.1 := by
              ext x
              simp only [Finset.mem_union, Finset.mem_inter, Finset.mem_sdiff, J_in, J_out]
              constructor
              · rintro (⟨hxJ, hxI⟩ | ⟨⟨hxJ, _⟩, hnx0⟩)
                · exact ⟨hxJ, Finset.disjoint_right.mp j.2 hxI⟩
                · exact ⟨hxJ, hnx0⟩
              · rintro ⟨hxJ, hnx0⟩
                by_cases hxI : x ∈ I_i
                · exact Or.inl ⟨hxJ, hxI⟩
                · exact Or.inr ⟨⟨hxJ, hxI⟩, hnx0⟩
            have hF2 : j.1 \ J = j.1 \ J_out := by
              ext x
              simp only [Finset.mem_sdiff, J_out]
              constructor
              · rintro ⟨hx0, hnxJ⟩
                exact ⟨hx0, fun h => hnxJ h.1⟩
              · rintro ⟨hx0, hnot⟩
                exact ⟨hx0, fun hxJ => hnot ⟨hxJ, Finset.disjoint_left.mp j.2 hx0⟩⟩
            change φ'₀.hom (χ (c_proj ↥B₀ N_i a₀ u_in)) * φ'₀.hom (w c) =
              φ'₀.hom ((ιP'.app (weilProjBasicOpen ↥V M α₀)).hom (t_proj ↥V M α₀ β))
            rw [h1, h2, hEval₀.2 β, he_α₀]
            change ((ξ s / ξ r_i) * (∏ γ ∈ J_in, f γ)) *
                ((∏ γ ∈ J_out \ j.1, f γ) * (∏ γ ∈ j.1 \ J_out, (f γ)⁻¹)) =
              (ξ s / ξ r_i) * (∏ γ ∈ J \ j.1, f γ) * (∏ γ ∈ j.1 \ J, (f γ)⁻¹)
            rw [← hF1_union, Finset.prod_union hF1_disj, hF2]
            ring
        intro z
        obtain ⟨z₀, rfl⟩ :=
          AlgebraicGeometry.Scheme.Hom.app_surjective ιP' (weilProjBasicOpen ↥V M α₀)
            (hAff_proj ↥V M α₀) z
        have hz₀ : z₀ ∈ S_pre := by rw [hS_top]; trivial
        exact hz₀
      exact ⟨hne_j, χ, hSurj, hχ_t, hχ_V, hχ_F⟩
    choose hne_idx χ hSurj hχ_t hχ_V hχ_F using h_s3
    have hAff_D' : ∀ j : ι_idx, AlgebraicGeometry.IsAffineOpen (D' j) := fun j => (h_s1 (idx j)).1
    let ψ : ∀ j : ι_idx, (D' j).toScheme ⟶ P_B :=
      fun j => (hAff_D' j).isoSpec.hom ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (χ j)) ≫
        (hAff_proj ↥B₀ N_i (e_idx j)).fromSpec
    have h_preimage : ∀ (j : ι_idx) (b : Fin (N_i + 1)) (x : ↥(D' j).toScheme),
        ψ j x ∈ D_B b ↔ x.1 ∈ D' (e_idx.symm b) := by
      intro j b x
      have h_in_ej : ψ j x ∈ D_B (e_idx j) := by
        dsimp only [ψ]
        rw [AlgebraicGeometry.Scheme.Hom.comp_apply, AlgebraicGeometry.Scheme.Hom.comp_apply]
        have hrng : (hAff_proj ↥B₀ N_i (e_idx j)).fromSpec
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (χ j)) ((hAff_D' j).isoSpec.hom x)) ∈
            Set.range ⇑(hAff_proj ↥B₀ N_i (e_idx j)).fromSpec := ⟨_, rfl⟩
        rw [(hAff_proj ↥B₀ N_i (e_idx j)).range_fromSpec] at hrng
        exact hrng
      have h1 : ψ j x ∈ D_B b ↔ ψ j x ∈ D_B (e_idx j) ⊓ D_B b :=
        ⟨fun hb => ⟨h_in_ej, hb⟩, fun h => h.2⟩
      rw [h1, ← (hCoord_proj ↥B₀ N_i).2.2.2.2.2.2.2.1 (e_idx j) b]
      dsimp only [ψ]
      rw [AlgebraicGeometry.Scheme.Hom.comp_apply, AlgebraicGeometry.Scheme.Hom.comp_apply,
        h_mem_ps (hAff_proj ↥B₀ N_i (e_idx j))]
      let q_jb := (ιP'.app (weilProjBasicOpen ↥V M (idx j))).hom
        (t_proj ↥V M (idx j) (idx (e_idx.symm b)))
      have h_spec_b : (t_proj ↥B₀ N_i (e_idx j) b ∉
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (χ j)) ((hAff_D' j).isoSpec.hom x)).asIdeal) ↔
          (q_jb ∉ ((hAff_D' j).isoSpec.hom x).asIdeal) := by
        change t_proj ↥B₀ N_i (e_idx j) b ∉
            Ideal.comap (χ j) ((hAff_D' j).isoSpec.hom x).asIdeal ↔
          q_jb ∉ ((hAff_D' j).isoSpec.hom x).asIdeal
        rw [Ideal.mem_comap, hχ_t j b]
      rw [h_spec_b, ← h_mem_ps (hAff_D' j) q_jb ((hAff_D' j).isoSpec.hom x)]
      have h_fs_x : (hAff_D' j).fromSpec ((hAff_D' j).isoSpec.hom x) = x.1 := by
        rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, ← (hAff_D' j).isoSpec_inv_ι,
          ← CategoryTheory.Category.assoc, Iso.hom_inv_id, CategoryTheory.Category.id_comp]
        rfl
      rw [h_fs_x, ← AlgebraicGeometry.Scheme.Hom.preimage_basicOpen,
        (hCoord_proj ↥V M).2.2.2.2.2.2.2.1 (idx j) (idx (e_idx.symm b))]
      change (x.1 ∈ D' j ∧ x.1 ∈ D' (e_idx.symm b)) ↔ x.1 ∈ D' (e_idx.symm b)
      exact ⟨fun h => h.2, fun h => ⟨x.2, h⟩⟩
