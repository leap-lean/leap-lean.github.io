            _ = ε := add_halves ε
        obtain ⟨B_fin, hB_fin_sub, hB_fin_span⟩ := hSpanLT
        have hL_map_CB : ∀ u : ↥L, algebraMap ↥L L₁ u ∈ C_B := by
          intro u
          obtain ⟨c_fn, hc_LT, hu_sum⟩ := hB_fin_span u.1 u.2
          have hu_L_eq : u = ∑ b ∈ B_fin.attach,
              ⟨c_fn b.1, hLT_le_L (hc_LT b.1 b.2)⟩ * ⟨b.1, hL_sub (hB_fin_sub b.2)⟩ := by
            apply Subtype.ext
            push_cast
            rw [hu_sum, ← Finset.sum_attach B_fin (fun b => c_fn b * b)]
          rw [hu_L_eq, map_sum]
          refine C_B.sum_mem fun b _ => ?_
          rw [map_mul]
          refine C_B.mul_mem (hLT_map_CB (c_fn b.1) (hc_LT b.1 b.2)) ?_
