            · rw [hνA_le_iff]; intro v; rw [hloc_smul v c f hc]; exact hv_le_νA v f
            · rw [hνA_le_iff]; intro v; rw [← hloc_smul v c f hc]; exact hv_le_νA v (c • f)
          · intro f g
