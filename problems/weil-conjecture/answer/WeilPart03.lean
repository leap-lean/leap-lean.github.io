      rw [← Finset.prod_pow_eq_pow_sum]
      refine Finset.prod_congr rfl (fun i hi => ?_)
      have hi_not : i ∉ J_out := (Finset.mem_sdiff.mp hi).2
      rw [if_neg hi_not, ← pow_mul]
    have h_out_prod : (∏ i ∈ J_out, (if i ∈ J_out then v₁Map (θ i) else y₀ ^ (q i)) ^ (exp i)) =
        v₁Map (∏ i ∈ J_out, (θ i) ^ (exp i)) := by
      rw [map_prod]
      refine Finset.prod_congr rfl (fun i hi => ?_)
      rw [if_pos hi, map_pow]
    change (∏ i ∈ J_in, (if i ∈ J_out then v₁Map (θ i) else y₀ ^ (q i)) ^ (exp i)) *
        (∏ i ∈ J_out, (if i ∈ J_out then v₁Map (θ i) else y₀ ^ (q i)) ^ (exp i)) *
        (∏ i : Fin D.M, (V_fac i) ^ (exp i)) = _
    rw [h_in_prod, h_out_prod]
    ring
  
  have heval_Vx : ∀ P : Polynomial ↥V₁, Polynomial.eval₂ v₁Map x₀ P ∈ Vx := by
    intro P
    refine Polynomial.induction_on' P ?_ ?_
    · intro p₁ p₂ hp₁ hp₂
      rw [Polynomial.eval₂_add]
      exact Vx.toSubring.add_mem hp₁ hp₂
    · intro n a
      rw [Polynomial.eval₂_monomial]
      exact Vx.toSubring.mul_mem (hv₁_mem a) (Vx.toSubring.pow_mem hx₀_Vx n)
  let A_exp : E → ℕ := fun f => ∑ i ∈ J_in, q i * D.a_exp f i
  let B_exp : E → ℕ := fun f => ∑ i ∈ J_in, q i * D.b_exp f i
  let n_tilde : E → ↥V₁ := fun f => D.n_f f * ∏ i ∈ J_out, (θ i) ^ (D.a_exp f i)
  let m_tilde : E → ↥V₁ := fun f => D.m_f f * ∏ i ∈ J_out, (θ i) ^ (D.b_exp f i)
  let lam : E → K := fun f => (n_tilde f).1 / (m_tilde f).1
  have hP_out_ne : ∀ exp : Fin D.M → ℕ, (∏ i ∈ J_out, (θ i) ^ (exp i)) ≠ 0 :=
    fun exp => Finset.prod_ne_zero_iff.mpr (fun i hi => pow_ne_zero (exp i) (Finset.mem_filter.mp hi).2.1)
  let S₁_nz : Finset E := S₁.filter (fun z => z ≠ 0)
  have hS₁_laurent : ∀ f ∈ S₁_nz,
      lam f ≠ 0 ∧
      f * (Polynomial.eval₂ v₁Map x₀ (D.U_neg f) * ∏ i : Fin D.M, (V_fac i) ^ (D.b_exp f i)) *
          y₀ ^ (B_exp f) =
        algebraMap K E (lam f) * y₀ ^ (A_exp f) *
          (Polynomial.eval₂ v₁Map x₀ (D.U_pos f) * ∏ i : Fin D.M, (V_fac i) ^ (D.a_exp f i)) ∧
      algebraMap K E (lam f) * y₀ ^ (A_exp f) / y₀ ^ (B_exp f) ∈ Vx := by
    intro f hf_nz
    obtain ⟨hf_mem, hf_ne⟩ := Finset.mem_filter.mp hf_nz
    obtain ⟨hn_ne, hm_ne, hUpos_ne, hUpos_inv, _, _, _, _, _, hf_eq⟩ := D.hf_rep f hf_mem hf_ne
    have hnt_ne : n_tilde f ≠ 0 := mul_ne_zero hn_ne (hP_out_ne (D.a_exp f))
    have hmt_ne : m_tilde f ≠ 0 := mul_ne_zero hm_ne (hP_out_ne (D.b_exp f))
    have hnt_val_ne : (n_tilde f).1 ≠ 0 := fun h0 => hnt_ne (Subtype.ext h0)
    have hmt_val_ne : (m_tilde f).1 ≠ 0 := fun h0 => hmt_ne (Subtype.ext h0)
    have hlam_ne : lam f ≠ 0 := div_ne_zero hnt_val_ne hmt_val_ne
    have hvmt_ne : v₁Map (m_tilde f) ≠ 0 := hv₁_ne hmt_ne
    have hlam_mul : v₁Map (m_tilde f) * algebraMap K E (lam f) = v₁Map (n_tilde f) := by
      change algebraMap K E (m_tilde f).1 * algebraMap K E ((n_tilde f).1 / (m_tilde f).1) =
        algebraMap K E (n_tilde f).1
      rw [← map_mul, mul_div_cancel₀ _ hmt_val_ne]
    have h_eq : f * (Polynomial.eval₂ v₁Map x₀ (D.U_neg f) *
          ∏ i : Fin D.M, (V_fac i) ^ (D.b_exp f i)) * y₀ ^ (B_exp f) =
        algebraMap K E (lam f) * y₀ ^ (A_exp f) *
          (Polynomial.eval₂ v₁Map x₀ (D.U_pos f) *
            ∏ i : Fin D.M, (V_fac i) ^ (D.a_exp f i)) := by
      apply mul_left_cancel₀ hvmt_ne
      rw [hp_prod (D.b_exp f), hp_prod (D.a_exp f)] at hf_eq
      have h_lhs : v₁Map (m_tilde f) * (f * (Polynomial.eval₂ v₁Map x₀ (D.U_neg f) *
            ∏ i : Fin D.M, (V_fac i) ^ (D.b_exp f i)) * y₀ ^ (B_exp f)) =
          f * (v₁Map (D.m_f f) * Polynomial.eval₂ v₁Map x₀ (D.U_neg f) *
            (v₁Map (∏ i ∈ J_out, (θ i) ^ (D.b_exp f i)) * y₀ ^ (B_exp f) *
              ∏ i : Fin D.M, (V_fac i) ^ (D.b_exp f i))) := by
        dsimp [m_tilde]
        rw [map_mul]
        ring
      have h_rhs : v₁Map (m_tilde f) * (algebraMap K E (lam f) * y₀ ^ (A_exp f) *
            (Polynomial.eval₂ v₁Map x₀ (D.U_pos f) *
              ∏ i : Fin D.M, (V_fac i) ^ (D.a_exp f i))) =
          v₁Map (D.n_f f) * Polynomial.eval₂ v₁Map x₀ (D.U_pos f) *
            (v₁Map (∏ i ∈ J_out, (θ i) ^ (D.a_exp f i)) * y₀ ^ (A_exp f) *
              ∏ i : Fin D.M, (V_fac i) ^ (D.a_exp f i)) := by
        calc v₁Map (m_tilde f) * (algebraMap K E (lam f) * y₀ ^ (A_exp f) *
              (Polynomial.eval₂ v₁Map x₀ (D.U_pos f) *
                ∏ i : Fin D.M, (V_fac i) ^ (D.a_exp f i)))
          _ = (v₁Map (m_tilde f) * algebraMap K E (lam f)) * (y₀ ^ (A_exp f) *
              (Polynomial.eval₂ v₁Map x₀ (D.U_pos f) *
                ∏ i : Fin D.M, (V_fac i) ^ (D.a_exp f i))) := by ring
          _ = v₁Map (n_tilde f) * (y₀ ^ (A_exp f) *
              (Polynomial.eval₂ v₁Map x₀ (D.U_pos f) *
                ∏ i : Fin D.M, (V_fac i) ^ (D.a_exp f i))) := by rw [hlam_mul]
          _ = v₁Map (D.n_f f) * Polynomial.eval₂ v₁Map x₀ (D.U_pos f) *
              (v₁Map (∏ i ∈ J_out, (θ i) ^ (D.a_exp f i)) * y₀ ^ (A_exp f) *
                ∏ i : Fin D.M, (V_fac i) ^ (D.a_exp f i)) := by
            dsimp [n_tilde]; rw [map_mul]; ring
      rw [h_lhs, h_rhs]
      exact hf_eq
    refine ⟨hlam_ne, h_eq, ?_⟩
    let Num_neg : E := Polynomial.eval₂ v₁Map x₀ (D.U_neg f) *
      ∏ i : Fin D.M, (V_fac i) ^ (D.b_exp f i)
    let Den_pos : E := Polynomial.eval₂ v₁Map x₀ (D.U_pos f) *
      ∏ i : Fin D.M, (V_fac i) ^ (D.a_exp f i)
    have hNum_Vx : f * Num_neg ∈ Vx :=
      Vx.toSubring.mul_mem (hS₁ f hf_mem)
        (Vx.toSubring.mul_mem (heval_Vx (D.U_neg f))
          (Vx.toSubring.prod_mem (fun i _ => Vx.toSubring.pow_mem (hV_fac_props i).1 (D.b_exp f i))))
    have hDen_ne : Den_pos ≠ 0 :=
      mul_ne_zero hUpos_ne
        (Finset.prod_ne_zero_iff.mpr (fun i _ => pow_ne_zero _ (hV_fac_props i).2.1))
    have hDen_inv_Vx : Den_pos⁻¹ ∈ Vx := by
      dsimp [Den_pos]
      rw [mul_inv, ← Finset.prod_inv_distrib]
      refine Vx.toSubring.mul_mem hUpos_inv (Vx.toSubring.prod_mem (fun i _ => ?_))
      have h_inv_pow : ((V_fac i) ^ (D.a_exp f i))⁻¹ = ((V_fac i)⁻¹) ^ (D.a_exp f i) :=
        (inv_pow (V_fac i) (D.a_exp f i)).symm
      rw [h_inv_pow]
      exact Vx.toSubring.pow_mem (hV_fac_props i).2.2.1 (D.a_exp f i)
    have hyB_ne : y₀ ^ (B_exp f) ≠ 0 := pow_ne_zero (B_exp f) hy₀_ne
    have h_ratio_eq : algebraMap K E (lam f) * y₀ ^ (A_exp f) / y₀ ^ (B_exp f) =
        (f * Num_neg) * Den_pos⁻¹ := by
      have h1 : f * Num_neg * y₀ ^ (B_exp f) = algebraMap K E (lam f) * y₀ ^ (A_exp f) * Den_pos := h_eq
      apply mul_right_cancel₀ hDen_ne
      apply mul_right_cancel₀ hyB_ne
      calc (algebraMap K E (lam f) * y₀ ^ (A_exp f) / y₀ ^ (B_exp f)) * Den_pos * y₀ ^ (B_exp f)
        _ = (algebraMap K E (lam f) * y₀ ^ (A_exp f) / y₀ ^ (B_exp f) * y₀ ^ (B_exp f)) * Den_pos := by ring
        _ = algebraMap K E (lam f) * y₀ ^ (A_exp f) * Den_pos := by rw [div_mul_cancel₀ _ hyB_ne]
        _ = f * Num_neg * y₀ ^ (B_exp f) := h1.symm
        _ = (f * Num_neg) * (Den_pos⁻¹ * Den_pos) * y₀ ^ (B_exp f) := by
          rw [inv_mul_cancel₀ hDen_ne, mul_one]
        _ = ((f * Num_neg) * Den_pos⁻¹) * Den_pos * y₀ ^ (B_exp f) := by ring
    exact h_ratio_eq ▸ Vx.toSubring.mul_mem hNum_Vx hDen_inv_Vx
  
  let L_set : Finset (K × ℕ) :=
    J_out.image (fun i => ((θ i).1, q i)) ∪
      (S₁_nz.filter (fun f => B_exp f < A_exp f ∧ lam f ∉ V₁)).image
