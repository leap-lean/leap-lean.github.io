        have hci_gt : 1 < ‖ι_F (algebraMap L₀ F (P_F.coeff i_star))‖ := hi_eq.symm ▸ hC_le
        have hci_ne : P_F.coeff i_star ≠ 0 := by
          intro h0
          rw [h0, map_zero, map_zero, norm_zero] at hci_gt
          linarith
        refine ⟨(P_F.coeff i_star)⁻¹, inv_ne_zero hci_ne, ?_, fun i => ?_⟩
        · rw [hMem_V₁, map_inv₀, map_inv₀, norm_inv]
          exact le_of_lt (inv_lt_one_of_one_lt₀ hci_gt)
        · rw [hMem_V₁, map_mul, map_mul, map_inv₀, map_inv₀, norm_mul, norm_inv, ← hi_eq]
          exact (mul_le_mul_of_nonneg_left (hCoeff_le_C i)
            (inv_nonneg.mpr (by linarith))).trans
            (le_of_eq (inv_mul_cancel₀ (ne_of_gt (by linarith))))
    obtain ⟨s₀, hs₀_ne, hs₀_V₁, hsP_mem⟩ := hEx_s₀
    let s₀_V : ↥V₁ := ⟨s₀, hs₀_V₁⟩
    have hsP_mem' : ∀ i : ℕ, (Polynomial.C s₀ * P_F).coeff i ∈ V₁ := by
      intro i
      rw [Polynomial.coeff_C_mul]
      exact hsP_mem i
    let P_V : Polynomial ↥V₁ := liftPolySubring V₁.toSubring (Polynomial.C s₀ * P_F) hsP_mem'
    have hP_V_map : P_V.map V₁.subtype = Polynomial.C s₀ * P_F :=
      liftPolySubring_map V₁.toSubring (Polynomial.C s₀ * P_F) hsP_mem'
    have hs₀_w : φ_V s₀_V * w = Polynomial.aeval y_W P_V := by
      apply Subtype.ext
      change algebraMap L₀ F s₀ * (w : F) = ((Polynomial.aeval y_W P_V : ↥W₁) : F)
      rw [hAeval_W P_V, hP_V_map, map_mul, Polynomial.aeval_C, hP_F]
    let s_hat : ↥OK := ι_OK s₀_V
    have hs_hat_pos : 0 < ‖((s_hat.1 : ↥Lx_hat) : F_hat)‖ := by
      change 0 < ‖ι_F (algebraMap L₀ F s₀)‖
      rw [norm_pos_iff]
      simpa using ι_F.injective.ne ((algebraMap L₀ F).injective.ne hs₀_ne)
    let P_hat : Polynomial ↥OK := P_V.map ι_OK
    have hw_OF : ι_F (w : F) ∈ OF := (hMem_OF _).mpr ((hW₁ (w : F)).mp w.2)
    obtain ⟨A₁, hA₁⟩ := hOF_span (ι_F (w : F)) hw_OF
    let D₁ : Polynomial ↥OK := P_hat - Polynomial.C s_hat * A₁
    have hD₁_eval0 : Polynomial.aeval y₁ (D₁.map OK.subtype) = 0 := by
      have hP_hat_eval : Polynomial.aeval y₁ (P_hat.map OK.subtype) =
          ι_F (algebraMap L₀ F s₀ * (w : F)) := by
        have hc1 : OK.subtype.comp ι_OK = ι_K.comp V₁.subtype := by ext; rfl
        have hc2 : (algebraMap ↥Lx_hat F_hat).comp ι_K = ι_F.comp (algebraMap L₀ F) := by ext; rfl
        dsimp [P_hat]
        rw [Polynomial.map_map, hc1, ← Polynomial.map_map, hP_V_map,
          Polynomial.aeval_def, Polynomial.eval₂_map, hc2, ← Polynomial.hom_eval₂]
        change ι_F (Polynomial.aeval y (Polynomial.C s₀ * P_F)) = _
        rw [map_mul, Polynomial.aeval_C, hP_F]
      have hA₁_eval : Polynomial.aeval y₁ (A₁.map OK.subtype) = ι_F (w : F) := by
        rw [Polynomial.aeval_def, ← Polynomial.eval_map, Polynomial.map_map]
        exact hA₁
      simp only [D₁, Polynomial.map_sub, Polynomial.map_mul, Polynomial.map_C,
        map_sub, map_mul, Polynomial.aeval_C, hP_hat_eval, hA₁_eval]
      have hs_val : (algebraMap ↥Lx_hat F_hat) (OK.subtype s_hat) =
          ι_F (algebraMap L₀ F s₀) := rfl
      rw [hs_val, sub_self]
    have hM₁_dvd_D₁ : M₁ ∣ D₁ := by
      have hdvd_K : M₁.map OK.subtype ∣ D₁.map OK.subtype := by
        rw [hM₁_map]
        exact minpoly.dvd ↥Lx_hat y₁ hD₁_eval0
      have hmod_K : (D₁.map OK.subtype) %ₘ (M₁.map OK.subtype) = 0 :=
        (Polynomial.modByMonic_eq_zero_iff_dvd (hM₁_monic.map OK.subtype)).mpr hdvd_K
      rw [← Polynomial.map_modByMonic OK.subtype hM₁_monic] at hmod_K
      have hmod_O : D₁ %ₘ M₁ = 0 :=
        Polynomial.map_injective OK.subtype Subtype.val_injective (by simpa using hmod_K)
      exact (Polynomial.modByMonic_eq_zero_iff_dvd hM₁_monic).mp hmod_O
    obtain ⟨B₁, hD₁_eq⟩ := hM₁_dvd_D₁
    have hP_hat_eq : P_hat = Polynomial.C s_hat * A₁ + M₁ * B₁ := by
      dsimp [D₁] at hD₁_eq
      linear_combination hD₁_eq
    let g_hat : Polynomial ↥OK := (f_V.derivative * Polynomial.X).map ι_OK
    let m₂ : ℕ := g₂.natDegree
    have hNilp : ∃ (N : ℕ) (Q_hat B_hat : Polynomial ↥OK),
        g_hat ^ N * P_hat = Polynomial.C s_hat * Q_hat + (M₁ * M₂) * B_hat := by
      rcases Nat.eq_zero_or_pos m₂ with hm₂0 | hm₂_pos
      · have hM₂_one : M₂ = 1 :=
          Polynomial.eq_one_of_monic_natDegree_zero hM₂_monic (hM₂_deg.trans hm₂0)
        refine ⟨0, A₁, B₁, ?_⟩
        rw [pow_zero, one_mul, hM₂_one, mul_one, hP_hat_eq]
      · let H : Polynomial ↥OK := M₂ - Polynomial.X ^ m₂
        let ρ : ℝ := (Finset.range m₂).sup' (Finset.nonempty_range_iff.mpr (Nat.ne_of_gt hm₂_pos))
          (fun j => ‖((g₂.coeff j : ↥Lx_hat) : F_hat)‖)
        have hρ_nonneg : 0 ≤ ρ := by
          have h0 : 0 ∈ Finset.range m₂ := Finset.mem_range.mpr hm₂_pos
          exact (norm_nonneg _).trans
            (Finset.le_sup' (f := fun j => ‖((g₂.coeff j : ↥Lx_hat) : F_hat)‖) h0)
        have hρ_lt : ρ < 1 := by
          rw [Finset.sup'_lt_iff]
          intro j hj
          exact hg₂_lt j (Finset.mem_range.mp hj)
        have hH_coeff : ∀ j : ℕ, ‖(((H.coeff j).1 : ↥Lx_hat) : F_hat)‖ ≤ ρ := by
          intro j
          have hH_map : H.map OK.subtype = g₂ - Polynomial.X ^ m₂ := by
            simp [H, hM₂_map]
          have hc : ((H.coeff j).1 : ↥Lx_hat) = (g₂ - Polynomial.X ^ m₂).coeff j := by
            rw [← hH_map, Polynomial.coeff_map]
            rfl
          rw [hc, Polynomial.coeff_sub, Polynomial.coeff_X_pow]
          split_ifs with hjm
          · subst hjm
            rw [show g₂.coeff m₂ = 1 from hg₂_monic.coeff_natDegree, sub_self,
              Subfield.coe_zero, norm_zero]
            exact hρ_nonneg
          · rw [sub_zero]
            rcases lt_or_gt_of_ne hjm with hlt | hgt
            · exact Finset.le_sup' (f := fun i => ‖((g₂.coeff i : ↥Lx_hat) : F_hat)‖)
                (Finset.mem_range.mpr hlt)
            · rw [Polynomial.coeff_eq_zero_of_natDegree_lt hgt, Subfield.coe_zero, norm_zero]
              exact hρ_nonneg
        have hHk_coeff : ∀ (k n : ℕ), ‖((((H ^ k).coeff n).1 : ↥Lx_hat) : F_hat)‖ ≤ ρ ^ k := by
          intro k
          induction k with
          | zero =>
            intro n
            rw [pow_zero, pow_zero, Polynomial.coeff_one]
            split_ifs
            · simp
            · simp
          | succ k ih =>
            intro n
            rw [pow_succ, Polynomial.coeff_mul, pow_succ]
            change ‖(Lx_hat.subtype.comp OK.subtype) _‖ ≤ _
            rw [map_sum]
            apply ultrametric_norm_sum_le (mul_nonneg (pow_nonneg hρ_nonneg k) hρ_nonneg)
            intro p _
            rw [map_mul, norm_mul]
            exact mul_le_mul (ih p.1) (hH_coeff p.2) (norm_nonneg _) (pow_nonneg hρ_nonneg k)
        have hTend_ρ : Filter.Tendsto (fun k : ℕ => ρ ^ k) Filter.atTop (nhds 0) :=
          tendsto_pow_atTop_nhds_zero_of_lt_one hρ_nonneg hρ_lt
        obtain ⟨k, hk⟩ := (hTend_ρ.eventually (gt_mem_nhds hs_hat_pos)).exists
        have hs_hat_ne : (s_hat.1 : ↥Lx_hat) ≠ 0 := by
          intro h0
          rw [h0, Subfield.coe_zero, norm_zero] at hs_hat_pos
          linarith
        let H_div_K : Polynomial ↥Lx_hat := Polynomial.C (s_hat.1)⁻¹ * (H ^ k).map OK.subtype
        have hH_div_mem : ∀ n : ℕ, H_div_K.coeff n ∈ OK := by
          intro n
          rw [hMem_OK, Polynomial.coeff_C_mul, Polynomial.coeff_map,
            Subfield.coe_mul, Subfield.coe_inv, norm_mul, norm_inv]
          exact (mul_le_mul_of_nonneg_left ((hHk_coeff k n).trans (le_of_lt hk))
            (inv_nonneg.mpr (norm_nonneg _))).trans
            (le_of_eq (inv_mul_cancel₀ (ne_of_gt hs_hat_pos)))
        let H₀ : Polynomial ↥OK := liftPolySubring OK.toSubring H_div_K hH_div_mem
        have hH₀_map : H₀.map OK.subtype = H_div_K :=
          liftPolySubring_map OK.toSubring H_div_K hH_div_mem
        have hHk_eq : H ^ k = Polynomial.C s_hat * H₀ := by
          apply Polynomial.map_injective OK.subtype Subtype.val_injective
          rw [Polynomial.map_mul, Polynomial.map_C, hH₀_map]
          dsimp [H_div_K]
          rw [← mul_assoc, ← Polynomial.C_mul, mul_inv_cancel₀ hs_hat_ne,
            Polynomial.C_1, one_mul]
        have hdvd_M₂ : M₂ ∣ (M₂ - H) ^ k - (-H) ^ k := by
          have hdvd0 := sub_dvd_pow_sub_pow (M₂ - H) (-H) k
          have hsub : (M₂ - H) - (-H) = M₂ := by ring
          rwa [hsub] at hdvd0
        obtain ⟨V_div, hV_div⟩ := hdvd_M₂
        have hX_pow : (Polynomial.X : Polynomial ↥OK) ^ (m₂ * k) =
            Polynomial.C s_hat * ((-1 : Polynomial ↥OK) ^ k * H₀) + M₂ * V_div := by
          have hMH : M₂ - H = Polynomial.X ^ m₂ := by dsimp [H]; ring
          have hnegH : (-H) ^ k = Polynomial.C s_hat * ((-1 : Polynomial ↥OK) ^ k * H₀) := by
            have hneg1 : -H = (-1 : Polynomial ↥OK) * H := by ring
            rw [hneg1, mul_pow, hHk_eq]
            ring
          rw [hMH, ← pow_mul, hnegH] at hV_div
          linear_combination hV_div
        let N : ℕ := m₂ * k
        let df_OK : Polynomial ↥OK := f_V.derivative.map ι_OK
        let U_N : Polynomial ↥OK := df_OK ^ N * ((-1 : Polynomial ↥OK) ^ k * H₀)
        let V_N : Polynomial ↥OK := df_OK ^ N * V_div
        have hgN_eq : g_hat ^ N = Polynomial.C s_hat * U_N + M₂ * V_N := by
          have hg_def : g_hat = df_OK * Polynomial.X := by
            simp [g_hat, df_OK]
          rw [hg_def, mul_pow, show N = m₂ * k from rfl, hX_pow]
          ring
        refine ⟨N, A₁ * g_hat ^ N + M₁ * B₁ * U_N, B₁ * V_N, ?_⟩
        calc g_hat ^ N * P_hat
            = g_hat ^ N * (Polynomial.C s_hat * A₁) + g_hat ^ N * (M₁ * B₁) := by
              rw [hP_hat_eq, mul_add]
          _ = g_hat ^ N * (Polynomial.C s_hat * A₁) +
                (Polynomial.C s_hat * U_N + M₂ * V_N) * (M₁ * B₁) := by
              rw [hgN_eq]
          _ = Polynomial.C s_hat * (A₁ * g_hat ^ N + M₁ * B₁ * U_N) +
                (M₁ * M₂) * (B₁ * V_N) := by ring
    obtain ⟨N, Q_hat, B_hat, hNilp_eq⟩ := hNilp
    let R_N : Polynomial ↥V₁ := ((f_V.derivative * Polynomial.X) ^ N * P_V) %ₘ f_V
    have hM₁₂_monic : (M₁ * M₂).Monic := hM₁_monic.mul hM₂_monic
    have hRN_map : R_N.map ι_OK = Polynomial.C s_hat * (Q_hat %ₘ (M₁ * M₂)) := by
      dsimp [R_N]
      rw [Polynomial.map_modByMonic ι_OK hf_V_monic, hf_V_map_OK,
        Polynomial.map_mul, Polynomial.map_pow]
      change (g_hat ^ N * P_hat) %ₘ (M₁ * M₂) = _
      rw [hNilp_eq, ← Polynomial.smul_eq_C_mul, ← Polynomial.smul_eq_C_mul]
      change Polynomial.modByMonicHom (M₁ * M₂)
        (s_hat • Q_hat + (M₁ * M₂) * B_hat) =
          s_hat • Polynomial.modByMonicHom (M₁ * M₂) Q_hat
      rw [map_add, LinearMap.map_smul]
      have hzero : Polynomial.modByMonicHom (M₁ * M₂) ((M₁ * M₂) * B_hat) = 0 :=
        (Polynomial.modByMonic_eq_zero_iff_dvd hM₁₂_monic).mpr ⟨B_hat, rfl⟩
      rw [hzero, add_zero]
    let Q_div_L₀ : Polynomial L₀ := Polynomial.C s₀⁻¹ * (R_N.map V₁.subtype)
    have hQ_div_mem : ∀ i : ℕ, Q_div_L₀.coeff i ∈ V₁ := by
      intro i
      rw [hMem_V₁]
      change ‖((ι_K (Q_div_L₀.coeff i) : ↥Lx_hat) : F_hat)‖ ≤ 1
      rw [← hMem_OK]
      have hc : ι_K (Q_div_L₀.coeff i) = ((Q_hat %ₘ (M₁ * M₂)).coeff i).1 := by
        dsimp [Q_div_L₀]
        rw [Polynomial.coeff_C_mul, Polynomial.coeff_map, map_mul, map_inv₀]
        have h1 : ι_K (V₁.subtype (R_N.coeff i)) = ((R_N.map ι_OK).coeff i).1 := by
          rw [Polynomial.coeff_map]
          rfl
        rw [h1, hRN_map, Polynomial.coeff_C_mul]
        change (ι_K s₀)⁻¹ * (s_hat.1 * ((Q_hat %ₘ (M₁ * M₂)).coeff i).1) = _
        have hs_eq : s_hat.1 = ι_K s₀ := rfl
        have hι_ne : ι_K s₀ ≠ 0 := by simpa using ι_K.injective.ne hs₀_ne
        rw [hs_eq, inv_mul_cancel_left₀ hι_ne]
      rw [hc]
      exact ((Q_hat %ₘ (M₁ * M₂)).coeff i).2
    let Q_V : Polynomial ↥V₁ := liftPolySubring V₁.toSubring Q_div_L₀ hQ_div_mem
    have hQ_V_map : Q_V.map V₁.subtype = Q_div_L₀ :=
      liftPolySubring_map V₁.toSubring Q_div_L₀ hQ_div_mem
    have hRN_eq : R_N = Polynomial.C s₀_V * Q_V := by
      apply Polynomial.map_injective V₁.subtype Subtype.val_injective
      rw [Polynomial.map_mul, Polynomial.map_C, hQ_V_map]
      dsimp [Q_div_L₀]
      ext i
      simp only [Polynomial.coeff_C_mul, Polynomial.coeff_map]
      change (R_N.coeff i : L₀) = s₀ * (s₀⁻¹ * (R_N.coeff i : L₀))
      rw [mul_inv_cancel_left₀ hs₀_ne]
    refine ⟨N, Q_V, ?_⟩
    have hdiv_add := Polynomial.modByMonic_add_div ((f_V.derivative * Polynomial.X) ^ N * P_V) f_V
    have heval_div := congrArg (Polynomial.aeval y_W) hdiv_add
    rw [map_add, map_mul, hf_yW, zero_mul, add_zero, map_mul, map_pow] at heval_div
    change Polynomial.aeval y_W R_N = u_W ^ N * Polynomial.aeval y_W P_V at heval_div
    rw [hRN_eq, map_mul, Polynomial.aeval_C, ← hs₀_w] at heval_div
    have hs₀_W_ne : algebraMap ↥V₁ ↥W₁ s₀_V ≠ 0 := by
      intro h0
      have hF : algebraMap L₀ F s₀ = 0 := congrArg Subtype.val h0
      exact hs₀_ne ((map_eq_zero_iff (algebraMap L₀ F) (algebraMap L₀ F).injective).mp hF)
    have hmul_eq : algebraMap ↥V₁ ↥W₁ s₀_V * (u_W ^ N * w) =
        algebraMap ↥V₁ ↥W₁ s₀_V * Polynomial.aeval y_W Q_V := by
      linear_combination -heval_div
    exact mul_left_cancel₀ hs₀_W_ne hmul_eq
  let B₀ := AdjoinRoot f_V
  let g_B : B₀ := AdjoinRoot.mk f_V (f_V.derivative * Polynomial.X)
  let ψ₀ : B₀ →ₐ[↥V₁] ↥W₁ := AdjoinRoot.liftAlgHom f_V (Algebra.ofId ↥V₁ ↥W₁) y_W hf_yW
  have hψ₀_root : ψ₀ (AdjoinRoot.root f_V) = y_W :=
    AdjoinRoot.liftAlgHom_root f_V (Algebra.ofId ↥V₁ ↥W₁) y_W hf_yW
  have hψ₀_mk : ∀ A : Polynomial ↥V₁, ψ₀ (AdjoinRoot.mk f_V A) = Polynomial.aeval y_W A := by
    intro A
    rw [← AdjoinRoot.aeval_eq, ← Polynomial.aeval_algHom_apply, hψ₀_root]
  have hψ₀_inj : Function.Injective ψ₀ := by
    rw [injective_iff_map_eq_zero]
    intro b hb
    obtain ⟨A, rfl⟩ := AdjoinRoot.mk_surjective b
    rw [hψ₀_mk] at hb
    have hA_eval : Polynomial.aeval y (A.map V₁.subtype) = 0 := by
      rw [← hAeval_W A, hb]
      rfl
    have hdvd_L₀ : f ∣ A.map V₁.subtype := minpoly.dvd L₀ y hA_eval
    have hmod_L₀ : (A.map V₁.subtype) %ₘ (f_V.map V₁.subtype) = 0 := by
      rw [hf_V_map]
      exact (Polynomial.modByMonic_eq_zero_iff_dvd hf_monic).mpr hdvd_L₀
    rw [← Polynomial.map_modByMonic V₁.subtype hf_V_monic] at hmod_L₀
    have hmod_V₁ : A %ₘ f_V = 0 :=
      Polynomial.map_injective V₁.subtype Subtype.val_injective (by simpa using hmod_L₀)
    have hdvd_V₁ : f_V ∣ A := (Polynomial.modByMonic_eq_zero_iff_dvd hf_V_monic).mp hmod_V₁
    exact AdjoinRoot.mk_eq_zero.mpr hdvd_V₁
  let algBW : Algebra B₀ ↥W₁ := ψ₀.toRingHom.toAlgebra
