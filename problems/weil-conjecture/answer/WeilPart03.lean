          map_mul' := fun x y => Subtype.ext (map_mul φ_KF x.1 y.1)
          map_zero' := Subtype.ext (map_zero φ_KF)
          map_add' := fun x y => Subtype.ext (map_add φ_KF x.1 y.1) }
