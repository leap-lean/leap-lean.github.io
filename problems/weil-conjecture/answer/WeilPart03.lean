              rw [ha_norm, div_lt_iff₀ (pow_pos hr_pos (p - 1))]
              have hr_pow : r * r ^ (p - 1) = s := by
                dsimp only [s]
                rw [← pow_succ', Nat.sub_add_cancel (by omega : 1 ≤ p)]
              rwa [hr_pow]
            let κ_real : ℝ := (γ₀ / r) ^ (p - 1)
            have hκ_nonneg : 0 ≤ κ_real :=
              pow_nonneg (div_nonneg (le_of_lt hγ₀_pos) (le_of_lt hr_pos)) _
            have hκ_lt_one : κ_real < 1 := by
              dsimp only [κ_real]
              have hdiv_lt : γ₀ / r < 1 := (div_lt_one hr_pos).mpr hγ₀_lt_r
              exact pow_lt_one₀ (div_nonneg (le_of_lt hγ₀_pos) (le_of_lt hr_pos)) hdiv_lt
                (by omega)
            let K_nn : NNReal := ⟨κ_real, hκ_nonneg⟩
            have hK_lt_one : K_nn < 1 := by exact_mod_cast hκ_lt_one
            have hg_mem_M₂ : g_α ∈ M₂ :=
              M₂.add_mem (M₂.sub_mem (M₂.pow_mem hα_mem p) (M₂.mul_mem (hLE ha_mem) hα_mem))
                (hLE hb_mem)
            have ha_inv_M₂ : a⁻¹ ∈ M₂ := M₂.inv_mem (hLE ha_mem)
            let Φ_N : ↥M₂ → ↥M₂ := fun δ =>
              ⟨a⁻¹ * g_α + a⁻¹ * (δ : F_hat) ^ p,
                M₂.add_mem (M₂.mul_mem ha_inv_M₂ hg_mem_M₂)
                  (M₂.mul_mem ha_inv_M₂ (M₂.pow_mem δ.2 p))⟩
            let B_N : Set ↥M₂ := Metric.closedBall (0 : ↥M₂) γ₀
            have : CompleteSpace ↥M₂ := @IsClosed.completeSpace_coe _ _ _ _ hCl₂
            have hB_comp : IsComplete B_N := Metric.isClosed_closedBall.isComplete
            have hMaps : Set.MapsTo Φ_N B_N B_N := by
              intro δ hδ
              rw [Metric.mem_closedBall, dist_zero_right] at hδ ⊢
              change ‖(δ : F_hat)‖ ≤ γ₀ at hδ
              change ‖a⁻¹ * g_α + a⁻¹ * (δ : F_hat) ^ p‖ ≤ γ₀
              refine (IsUltrametricDist.norm_add_le_max _ _).trans (max_le ?_ ?_)
              · rw [norm_mul, norm_inv]
                dsimp only [γ₀]
                rw [div_eq_inv_mul]
              · rw [norm_mul, norm_inv, norm_pow, ha_norm]
                have h1 : ‖(δ : F_hat)‖ ^ p ≤ γ₀ ^ p :=
                  pow_le_pow_left₀ (norm_nonneg _) hδ p
                have h2 : (r ^ (p - 1))⁻¹ * ‖(δ : F_hat)‖ ^ p ≤ (r ^ (p - 1))⁻¹ * γ₀ ^ p :=
                  mul_le_mul_of_nonneg_left h1 (inv_nonneg.mpr (pow_nonneg (le_of_lt hr_pos) _))
                have h3 : (r ^ (p - 1))⁻¹ * γ₀ ^ p = γ₀ * κ_real := by
                  have hpow_γ : γ₀ ^ p = γ₀ * γ₀ ^ (p - 1) := by
                    rw [← pow_succ', Nat.sub_add_cancel (by omega : 1 ≤ p)]
                  have hκ_def : κ_real = (γ₀ / r) ^ (p - 1) := rfl
                  rw [hpow_γ, hκ_def, div_pow, div_eq_mul_inv]
                  ring
                calc (r ^ (p - 1))⁻¹ * ‖(δ : F_hat)‖ ^ p
                    ≤ γ₀ * κ_real := h2.trans_eq h3
                  _ ≤ γ₀ * 1 := mul_le_mul_of_nonneg_left (le_of_lt hκ_lt_one) (le_of_lt hγ₀_pos)
                  _ = γ₀ := mul_one γ₀
            have hContract : ContractingWith K_nn (Set.MapsTo.restrict Φ_N B_N B_N hMaps) := by
              refine ⟨hK_lt_one, ?_⟩
              rw [lipschitzWith_iff_dist_le_mul]
              rintro ⟨δ₁, hδ₁⟩ ⟨δ₂, hδ₂⟩
              rw [Metric.mem_closedBall, dist_zero_right] at hδ₁ hδ₂
              change ‖(δ₁ : F_hat)‖ ≤ γ₀ at hδ₁
              change ‖(δ₂ : F_hat)‖ ≤ γ₀ at hδ₂
              change dist (Φ_N δ₁ : F_hat) (Φ_N δ₂ : F_hat) ≤
                κ_real * dist (δ₁ : F_hat) (δ₂ : F_hat)
              rw [dist_eq_norm, dist_eq_norm]
              have hdiff_le : ‖(δ₁ : F_hat) - (δ₂ : F_hat)‖ ≤ γ₀ := by
                rw [sub_eq_add_neg]
                refine (IsUltrametricDist.norm_add_le_max _ _).trans (max_le hδ₁ ?_)
                rwa [norm_neg]
              have hsub_Φ : (Φ_N δ₁ : F_hat) - (Φ_N δ₂ : F_hat) =
                  a⁻¹ * (((δ₁ : F_hat) - (δ₂ : F_hat)) ^ p) := by
                dsimp only [Φ_N]
                have hchar_sub : ((δ₁ : F_hat) - (δ₂ : F_hat)) ^ p =
                    (δ₁ : F_hat) ^ p - (δ₂ : F_hat) ^ p := sub_pow_char _ _
                rw [hchar_sub]
                ring
              rw [hsub_Φ, norm_mul, norm_inv, norm_pow, ha_norm]
              have hpow_split : ‖(δ₁ : F_hat) - (δ₂ : F_hat)‖ ^ p =
                  ‖(δ₁ : F_hat) - (δ₂ : F_hat)‖ ^ (p - 1) * ‖(δ₁ : F_hat) - (δ₂ : F_hat)‖ := by
                rw [← pow_succ, Nat.sub_add_cancel (by omega : 1 ≤ p)]
              rw [hpow_split, ← mul_assoc]
              refine mul_le_mul_of_nonneg_right ?_ (norm_nonneg _)
              dsimp only [κ_real]
              rw [div_pow, div_eq_inv_mul]
              exact mul_le_mul_of_nonneg_left
                (pow_le_pow_left₀ (norm_nonneg _) hdiff_le (p - 1))
                (inv_nonneg.mpr (pow_nonneg (le_of_lt hr_pos) _))
            have h0_mem : (0 : ↥M₂) ∈ B_N := by
              rw [Metric.mem_closedBall, dist_self]
              exact le_of_lt hγ₀_pos
            obtain ⟨δ_inf, _, hfp, _, _⟩ :=
              ContractingWith.exists_fixedPoint' hB_comp hMaps hContract h0_mem
                (edist_ne_top _ _)
            have hfp_val : a⁻¹ * g_α + a⁻¹ * (δ_inf : F_hat) ^ p = (δ_inf : F_hat) :=
              congrArg Subtype.val hfp
            have h_delta_eq : (δ_inf : F_hat) ^ p - a * (δ_inf : F_hat) + g_α = 0 := by
              have hmul_a := congrArg (fun z : F_hat => a * z) hfp_val
              have ha_cancel₁ : a * (a⁻¹ * g_α + a⁻¹ * (δ_inf : F_hat) ^ p) =
                  g_α + (δ_inf : F_hat) ^ p := by
                field_simp
              rw [ha_cancel₁] at hmul_a
              linear_combination hmul_a
            let β : F_hat := α + (δ_inf : F_hat)
            have hβ_mem : β ∈ M₂ := M₂.add_mem hα_mem δ_inf.2
            have hβ_root : β ^ p - a * β + b = 0 := by
              dsimp only [β]
              rw [add_pow_char α (δ_inf : F_hat) p]
              dsimp only [g_α] at h_delta_eq
              linear_combination h_delta_eq
            exact ⟨β, hβ_mem, hβ_root⟩
      · have ha_all := hRight c hc₀_lt
        let g_α : F_hat := α ^ p - 0 * α + b
        have hg_α_eq : g_α = - ∑ k ∈ Finset.Ico 1 p, ((f_c.coeff k : ↥M₁) : F_hat) * α ^ k := by
          dsimp only [g_α, b]
          linear_combination hf_c_eval
        have hg_α_lt : ‖g_α‖ < s := by
          rw [hg_α_eq, norm_neg]
          refine h_ultra_sum (Finset.Ico 1 p) _ fun k hk => ?_
          rw [Finset.mem_Ico] at hk
          rw [norm_mul, norm_pow]
          exact ha_all k hk.1 hk.2
        have h_coset_eq : ∀ x ∈ M₁, ‖x ^ p - 0 * x + b‖ = ‖x - α‖ ^ p := by
          intro x hx
          have hxr : r < ‖x - α‖ := h_shift_lt c₀ hc₀_mem x hx
          have hid : x ^ p - 0 * x + b = (x - α) ^ p + g_α := by
            have hpow_sub : (x - α) ^ p = x ^ p - α ^ p := sub_pow_char x α
            dsimp only [g_α]
            linear_combination - hpow_sub
          have hgt : ‖g_α‖ < ‖(x - α) ^ p‖ := by
            rw [norm_pow]
            exact hg_α_lt.trans (pow_lt_pow_left₀ hxr (le_of_lt hr_pos) hp_ne)
          rw [hid, h_ultra_eq _ _ hgt, norm_pow]
        refine ⟨0, b, α, s, M₁.zero_mem, hb_mem, hα_mem, hs_pos, Or.inl rfl, ?_, ?_, hg_α_lt, ?_⟩
        · intro x hx
          rw [h_coset_eq x hx]
          exact pow_lt_pow_left₀ (h_shift_lt c₀ hc₀_mem x hx) (le_of_lt hr_pos) hp_ne
        · intro ε hε
          obtain ⟨x, hx_mem, hx_lt⟩ := h_shift_inf c₀ hc₀_mem ε hε
          exact ⟨x, hx_mem, by rwa [h_coset_eq x hx_mem]⟩
        · intro h0
          exact absurd rfl h0
    · have hf₀_deriv : f₀.derivative = 0 :=
        not_ne_iff.mp (mt (Polynomial.separable_iff_derivative_ne_zero hf₀_irred).mpr hSep)
      have hcoeff_mid : ∀ k : ℕ, 1 ≤ k → k < p → f₀.coeff k = 0 := by
        intro k hk1 hkp
        rcases k with _ | m
        · omega
        · have hd := congrArg (fun P : Polynomial ↥M₁ => P.coeff m) hf₀_deriv
          simp only [Polynomial.coeff_zero, Polynomial.coeff_derivative] at hd
          have hm_cast : ((m : ↥M₁) + 1) = ((m + 1 : ℕ) : ↥M₁) := by push_cast; rfl
          rw [hm_cast] at hd
          have hk_ndvd : ¬ (p ∣ (m + 1)) := Nat.not_dvd_of_pos_of_lt hk1 hkp
          have hk_ne : ((m + 1 : ℕ) : ↥M₁) ≠ 0 :=
            mt (CharP.cast_eq_zero_iff ↥M₁ p (m + 1)).mp hk_ndvd
          exact (mul_eq_zero.mp hd).resolve_right hk_ne
      have hf₀_form : f₀ = Polynomial.X ^ p + Polynomial.C (f₀.coeff 0) := by
        apply Polynomial.ext
        intro n
        rw [Polynomial.coeff_add, Polynomial.coeff_X_pow, Polynomial.coeff_C]
        rcases eq_or_ne n 0 with rfl | hn0
        · simp [hp_ne.symm]
        · rcases lt_trichotomy n p with hlt | rfl | hgt
          · have hn1 : 1 ≤ n := Nat.pos_of_ne_zero hn0
            rw [hcoeff_mid n hn1 hlt]
            simp [hn0, ne_of_lt hlt]
          · rw [← hf₀_deg, hf₀_monic.coeff_natDegree]
            simp [hf₀_deg, hn0]
          · rw [Polynomial.coeff_eq_zero_of_natDegree_lt (p := f₀) (by omega)]
            simp [hn0, ne_of_gt hgt]
      have haev₀ := minpoly.aeval ↥M₁ α₀_M₂
      change Polynomial.aeval α₀_M₂ f₀ = 0 at haev₀
      rw [hf₀_form, map_add, map_pow, Polynomial.aeval_X, Polynomial.aeval_C] at haev₀
      have hval₀ : α₀ ^ p + ((f₀.coeff 0 : ↥M₁) : F_hat) = 0 := congrArg Subtype.val haev₀
      let b : F_hat := ((f₀.coeff 0 : ↥M₁) : F_hat)
      have hb_mem : b ∈ M₁ := (f₀.coeff 0).2
      have hb_eq : b = - (α₀ ^ p) := eq_neg_of_add_eq_zero_right hval₀
      have h_coset_eq : ∀ x ∈ M₁, ‖x ^ p - 0 * x + b‖ = ‖x - α₀‖ ^ p := by
        intro x _
        have hid : x ^ p - 0 * x + b = (x - α₀) ^ p := by
          rw [hb_eq, sub_pow_char x α₀]
          ring
        rw [hid, norm_pow]
      have hα₀_sub0 : α₀ - 0 = α₀ := sub_zero α₀
      refine ⟨0, b, α₀, s, M₁.zero_mem, hb_mem, hα₀, hs_pos, Or.inl rfl, ?_, ?_, ?_, ?_⟩
      · intro x hx
        rw [h_coset_eq x hx, ← hα₀_sub0]
        exact pow_lt_pow_left₀ (h_shift_lt 0 M₁.zero_mem x hx) (le_of_lt hr_pos) hp_ne
      · intro ε hε
        obtain ⟨x, hx_mem, hx_lt⟩ := h_shift_inf 0 M₁.zero_mem ε hε
        rw [hα₀_sub0] at hx_lt
        exact ⟨x, hx_mem, by rwa [h_coset_eq x hx_mem]⟩
      · have hid0 : α₀ ^ p - 0 * α₀ + b = 0 := by
          dsimp only [b]
          linear_combination hval₀
        rw [hid0, norm_zero]
        exact hs_pos
      · intro h0
        exact absurd rfl h0

theorem weil_algClosed_functionField_pole_pBasis_and_sepGen : (∀ (E L : Type u) [Field E] [IsAlgClosed E] [Field L] [Algebra E L] (w : L),
      Transcendental E w →
      (let Kw : Subfield L := Subfield.closure (Set.range (algebraMap E L) ∪ {w})
       letI : Algebra ↥Kw L := Kw.toAlgebra
       FiniteDimensional ↥Kw L) →
      ∃ u : L, Transcendental E u ∧
        let Ku : Subfield L := Subfield.closure (Set.range (algebraMap E L) ∪ {u})
        letI : Algebra ↥Ku L := Ku.toAlgebra
        FiniteDimensional ↥Ku L ∧ Algebra.IsSeparable ↥Ku L) ∧
    (∀ (E L : Type u) [Field E] [IsAlgClosed E] [Field L] [Algebra E L] (p : ℕ),
      p.Prime → (p : E) = 0 →
      ∀ (T : L), Transcendental E T →
        (let Kt := IntermediateField.adjoin E ({T} : Set L)
         FiniteDimensional ↥Kt L ∧ Algebra.IsSeparable ↥Kt L) →
        ∃ U : Set L,
          LinearIndependent E ((↑) : U → L) ∧
          (∀ u ∈ Submodule.span E U, ∀ z : L, u + z ^ p = 0 → u = 0) ∧
          Submodule.span E ({1} ∪ ⋃ (n : ℕ), (fun u : L => u ^ (p ^ n)) '' U) = ⊤) :=
by
  classical
  refine ⟨?_, ?_⟩
  · 
    intro E L _ _ _ _ w hw_trans hFin
    let p := ringChar E
    haveI hCharE : CharP E p := ringChar.charP E
    rcases CharP.char_is_prime_or_zero E p with hp | hp0
    · 
      haveI hCharL : CharP L p := (RingHom.charP_iff_charP (algebraMap E L) p).mp hCharE
      haveI hExpL : ExpChar L p := ExpChar.prime hp
      suffices h_ind : ∀ (n : ℕ) (w : L),
          Transcendental E w →
          (let Kw : Subfield L := Subfield.closure (Set.range (algebraMap E L) ∪ {w})
           letI : Algebra ↥Kw L := Kw.toAlgebra
           FiniteDimensional ↥Kw L) →
          (let Kw : Subfield L := Subfield.closure (Set.range (algebraMap E L) ∪ {w})
           letI : Algebra ↥Kw L := Kw.toAlgebra
           Module.finrank ↥Kw L = n) →
          ∃ u : L, Transcendental E u ∧
            let Ku : Subfield L := Subfield.closure (Set.range (algebraMap E L) ∪ {u})
            letI : Algebra ↥Ku L := Ku.toAlgebra
            FiniteDimensional ↥Ku L ∧ Algebra.IsSeparable ↥Ku L by
        let Kw0 : Subfield L := Subfield.closure (Set.range (algebraMap E L) ∪ {w})
        letI : Algebra ↥Kw0 L := Kw0.toAlgebra
        exact h_ind (Module.finrank ↥Kw0 L) w hw_trans hFin rfl
      intro n
      induction n using Nat.strong_induction_on with
      | h n ih =>
        intro w hw_trans hFin_w hn
        let Kw : Subfield L := Subfield.closure (Set.range (algebraMap E L) ∪ {w})
        letI : Algebra ↥Kw L := Kw.toAlgebra
        haveI : FiniteDimensional ↥Kw L := hFin_w
        by_cases hSep : Algebra.IsSeparable ↥Kw L
        · exact ⟨w, hw_trans, hFin_w, hSep⟩
        · let S_int : IntermediateField ↥Kw L := separableClosure ↥Kw L
          let S : Subfield L := S_int.toSubfield
          have hKw_le_S : Kw ≤ S := fun x hx => S_int.algebraMap_mem ⟨x, hx⟩
          have h_exists_not_S : ∃ y : L, y ∉ S := by
            by_contra hAll
            push Not at hAll
            have hTop : S_int = ⊤ := by
              ext y
              simp only [IntermediateField.mem_top, iff_true]
              exact hAll y
            let eS : ↥S_int ≃ₐ[↥Kw] L :=
              (IntermediateField.equivOfEq hTop).trans IntermediateField.topEquiv
            haveI : Algebra.IsSeparable ↥Kw ↥S_int := separableClosure.isSeparable ↥Kw L
            exact hSep (AlgEquiv.Algebra.isSeparable eS)
          obtain ⟨y, hy_not_S⟩ := h_exists_not_S
          haveI hCharSint : CharP ↥S_int p :=
            (RingHom.charP_iff_charP (algebraMap ↥S_int L) p).mpr hCharL
          haveI hExpSint : ExpChar ↥S_int p := ExpChar.prime hp
          haveI : Algebra.IsIntegral ↥Kw L := Algebra.IsIntegral.of_finite ↥Kw L
          haveI : IsPurelyInseparable ↥S_int L := separableClosure.isPurelyInseparable ↥Kw L
          have h_pow_ex : ∃ k : ℕ, y ^ (p ^ k) ∈ S := by
            obtain ⟨k, xS, hxS⟩ := IsPurelyInseparable.pow_mem ↥S_int p y
            refine ⟨k, ?_⟩
            rw [← hxS]
            exact xS.2
          let k₀ := Nat.find h_pow_ex
          have hk₀_ne : k₀ ≠ 0 := by
            intro hk0
            have h0 : y ^ (p ^ k₀) ∈ S := Nat.find_spec h_pow_ex
            rw [hk0, pow_zero, pow_one] at h0
            exact hy_not_S h0
          obtain ⟨m, hm_eq⟩ := Nat.exists_eq_succ_of_ne_zero hk₀_ne
          let α : L := y ^ (p ^ m)
          have hα_not_S : α ∉ S := by
            have hm_lt : m < k₀ := by omega
            exact Nat.find_min h_pow_ex hm_lt
          have hαp_S : α ^ p ∈ S := by
            have hspec : y ^ (p ^ k₀) ∈ S := Nat.find_spec h_pow_ex
            rw [hm_eq, pow_succ, pow_mul] at hspec
            exact hspec
          let M : Subfield L := Subfield.closure ((S : Set L) ∪ {α})
          have hS_le_M : S ≤ M := fun x hx => Subfield.subset_closure (Or.inl hx)
          have hKw_le_M : Kw ≤ M := le_trans hKw_le_S hS_le_M
          letI : Algebra ↥S L := S.toAlgebra
          letI : Algebra ↥M L := M.toAlgebra
          letI : Algebra ↥Kw ↥S := (Subfield.inclusion hKw_le_S).toAlgebra
          letI : Algebra ↥Kw ↥M := (Subfield.inclusion hKw_le_M).toAlgebra
          letI : Algebra ↥S ↥M := (Subfield.inclusion hS_le_M).toAlgebra
          haveI : IsScalarTower ↥Kw ↥S L := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
          haveI : IsScalarTower ↥Kw ↥M L := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
          haveI : IsScalarTower ↥S ↥M L := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
          haveI : IsScalarTower ↥Kw ↥S ↥M := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
          haveI : FiniteDimensional ↥Kw ↥S := FiniteDimensional.left ↥Kw ↥S L
          haveI : FiniteDimensional ↥Kw ↥M := FiniteDimensional.left ↥Kw ↥M L
          haveI : FiniteDimensional ↥S ↥M := FiniteDimensional.right ↥Kw ↥S ↥M
          have h_finrank_SM : Module.finrank ↥S ↥M = p := by
            let I_α : IntermediateField ↥S L := IntermediateField.adjoin ↥S ({α} : Set L)
            have hIα_eq : I_α.toSubfield = M := by
              rw [IntermediateField.adjoin_toSubfield]
              congr 1
              have h_rng : Set.range (algebraMap ↥S L) = (S : Set L) := Subtype.range_coe
              rw [h_rng]
            let eIM : ↥I_α ≃ₐ[↥S] ↥M :=
              { toFun := fun z => ⟨z.1, by rw [← hIα_eq]; exact z.2⟩
                invFun := fun z => ⟨z.1, by change z.1 ∈ I_α.toSubfield; rw [hIα_eq]; exact z.2⟩
                left_inv := fun _ => rfl
                right_inv := fun _ => rfl
                map_mul' := fun _ _ => rfl
                map_add' := fun _ _ => rfl
                commutes' := fun _ => rfl }
            let a_S : ↥S := ⟨α ^ p, hαp_S⟩
            let Q : Polynomial ↥S := Polynomial.X ^ p - Polynomial.C a_S
            have hQ_monic : Q.Monic := Polynomial.monic_X_pow_sub_C a_S hp.ne_zero
            have hQ_aeval : Polynomial.aeval α Q = 0 := by
              simp only [Q, map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C]
              exact sub_self (α ^ p)
            have hα_int : IsIntegral ↥S α := ⟨Q, hQ_monic, hQ_aeval⟩
            have hQ_no_root : ∀ b : ↥S, b ^ p ≠ a_S := by
              intro b hb
              have hbL : (b : L) ^ p = α ^ p := congrArg Subtype.val hb
              have hb_eq : (b : L) = α := frobenius_inj L p hbL
              exact hα_not_S (hb_eq ▸ b.2)
            have hQ_irr : Irreducible Q := X_pow_sub_C_irreducible_of_prime hp hQ_no_root
            have hminQ : Q = minpoly ↥S α :=
              minpoly.eq_of_irreducible_of_monic hQ_irr hQ_aeval hQ_monic
            rw [← LinearEquiv.finrank_eq eIM.toLinearEquiv,
                IntermediateField.adjoin.finrank hα_int, ← hminQ]
            exact Polynomial.natDegree_X_pow_sub_C
          let φ : L →+* L := frobenius L p
          have hφ_inj : Function.Injective φ := frobenius_inj L p
          have hφ_apply : ∀ x : L, φ x = x ^ p := fun _ => rfl
          let Kw_p : Subfield L := Kw.map φ
          let M_p : Subfield L := M.map φ
          have hKwp_le_Kw : Kw_p ≤ Kw := by
            rintro _ ⟨x, hx, rfl⟩
            exact Kw.pow_mem hx p
          have hMp_le_S : M_p ≤ S := by
            rintro _ ⟨x, hx, rfl⟩
            have hM_comap : M ≤ S.comap φ := by
              rw [Subfield.closure_le]
              rintro z (hz | rfl)
              · exact S.pow_mem hz p
              · exact hαp_S
            exact hM_comap hx
