        have hRB_le_CB : R_B ≤ C_B := Subring.le_topologicalClosure R_B
        have hK_RB : ∀ c : K_hat, algebraMap K_hat L₁ c ∈ R_B := by
          intro c
          change algebraMap K_hat L₁ c ∈ V_B
          have : algebraMap K_hat L₁ c = c • (1 : L₁) := by rw [Algebra.smul_def, mul_one]
          rw [this]
