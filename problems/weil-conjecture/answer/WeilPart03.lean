      have hz_span : z ∈ Submodule.span κ (↑S_q : Set F₀) := Submodule.subset_span hz
      rw [hS_q] at hz_span
      exact hz_span
    obtain ⟨s_ann, hs_not, hs_Sq⟩ := hFinAnn S_q hSq_sub
    have hs_all : ∀ z ∈ q_bar, s_ann * z = 0 := by
      intro z hz
      have hz_span : z ∈ Submodule.span κ (↑S_q : Set F₀) := by rw [hS_q]; exact hz
      refine Submodule.span_induction ?_ ?_ ?_ ?_ hz_span
      · intro x hx; exact hs_Sq x hx
      · exact mul_zero s_ann
      · intro x₁ x₂ _ _ h1 h2; rw [mul_add, h1, h2, add_zero]
      · intro c x _ hx
        change s_ann * (algebraMap κ F₀ c * x) = 0
        calc
          s_ann * (algebraMap κ F₀ c * x) = algebraMap κ F₀ c * (s_ann * x) := by ring
          _ = 0 := by rw [hx, mul_zero]
    have hcoprime : q_bar ⊔ Ideal.span ({s_ann} : Set F₀) = ⊤ := by
      by_contra hne
      have heq := hqbar_max.eq_of_le hne le_sup_left
      apply hs_not
      rw [heq]
      exact Ideal.mem_sup_right (Ideal.mem_span_singleton_self s_ann)
    have h1_sup : (1 : F₀) ∈ q_bar ⊔ Ideal.span ({s_ann} : Set F₀) := by rw [hcoprime]; trivial
    obtain ⟨m₀, hm₀, v₀, hv₀, hm₀v₀⟩ := Submodule.mem_sup.mp h1_sup
    obtain ⟨c₀, rfl⟩ := Ideal.mem_span_singleton.mp hv₀
    let e₀ : F₀ := s_ann * c₀
    have he₀_ann : ∀ z ∈ q_bar, e₀ * z = 0 := by
      intro z hz
      calc
        (s_ann * c₀) * z = c₀ * (s_ann * z) := by ring
        _ = 0 := by rw [hs_all z hz, mul_zero]
    have h1_sub_e₀ : 1 - e₀ ∈ q_bar := by
      have heq : 1 - e₀ = m₀ := by rw [← hm₀v₀]; ring
      rw [heq]; exact hm₀
    obtain ⟨r_e, hr_e⟩ := Ideal.Quotient.mk_surjective e₀
    have h1_re_q₀ : 1 - r_e ∈ q₀ := by
      apply (SetLike.ext_iff.mp hcomap_qbar (1 - r_e)).mp
      change q_F (1 - r_e) ∈ q_bar
      rw [map_sub, map_one, hr_e]
      exact h1_sub_e₀
    have hπ_re : π r_e.1 = 1 := by
      have h0 : π ((1 - r_e : ↥R₁).1) = 0 :=
        (IsLocalRing.residue_eq_zero_iff _).mpr h1_re_q₀
      change π (1 - r_e.1) = 0 at h0
      rw [map_sub, map_one, sub_eq_zero] at h0
      exact h0.symm
    obtain ⟨α₀, hα₀⟩ := Field.exists_primitive_element κ κ'
    let α_bar : κ' := if α₀ = 0 then 1 else α₀
    have hα_ne : α_bar ≠ 0 := by
      by_cases h0 : α₀ = 0 <;> simp [α_bar, h0]
    have hα_adjoin : IntermediateField.adjoin κ ({α_bar} : Set κ') = ⊤ := by
      by_cases h0 : α₀ = 0
      · simp only [α_bar, h0, ↓reduceIte]
