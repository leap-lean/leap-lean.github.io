        mul_ne_zero ((hAB_spec t₀).2.2.2 hut₀_ne)
          (Finset.prod_ne_zero_iff.mpr fun s _ => (hAB_spec s).2.1)
      have hsum_f : ∑ t : Fin (N + 1), Polynomial.aeval z₀ (f t) * (w_lift t : F) = 0 := by
