            have hx_RB : x ∈ R_B := R_B.mul_mem (hK_RB α⁻¹) hT₁_RB
            have hx_lt : ‖x‖ < 1 := by
              dsimp [x]
              rw [norm_mul, hIsoK₁, norm_inv]
