      have hOfPrimeCongr : ∀ (Q : Ideal ↥V) [Q.IsPrime], Q = P → V.ofPrime Q = V.ofPrime P := by
        rintro Q _ rfl
        rfl
      have hComap : W.comap φ_KF = V.ofPrime P := by
        calc W.comap φ_KF = U := rfl
