        have hb_mem : ∀ k : Fin (d + 1), g k / g k₀ ∈ V₀ := by
          intro k
          by_cases hk : g k = 0
          · rw [hk, zero_div]; exact V₀.zero_mem
          · exact hValDivMem V₀ (g k) (g k₀) hgk₀
              (hk₀_max k (Finset.mem_filter.mpr ⟨Finset.mem_univ k, hk⟩))
        let b : Fin (d + 1) → ↥V₀ := fun k => ⟨g k / g k₀, hb_mem k⟩
        have hbk₀ : b k₀ = 1 := Subtype.ext (div_self hgk₀)
        have hA_sum : (∑ k : Fin (d + 1), algebraMap ↥V₀ ↥A (b k) * e k : ↥A) = 0 := by
          apply Subtype.ext
          push_cast
          calc ∑ k : Fin (d + 1), algebraMap L E (g k / g k₀) * ((e k : ↥A) : E)
              = (algebraMap L E (g k₀))⁻¹ *
                  ∑ k : Fin (d + 1), g k • ((e k : ↥A) : E) := by
                rw [Finset.mul_sum]
                refine Finset.sum_congr rfl fun k _ => ?_
                rw [div_eq_inv_mul, map_mul, map_inv₀, mul_assoc, Algebra.smul_def]
            _ = 0 := by rw [hg_sum, mul_zero]
        have hQuot := congrArg (Ideal.Quotient.mk (f k₀)) hA_sum
        rw [map_sum, map_zero] at hQuot
        have hSingle : (∑ k : Fin (d + 1),
            (Ideal.Quotient.mk (f k₀)) (algebraMap ↥V₀ ↥A (b k) * e k)) = 1 := by
          rw [Finset.sum_eq_single k₀]
          · rw [map_mul, he_same k₀, hbk₀, map_one, map_one, mul_one]
          · intro k _ hkk₀
            rw [map_mul, he_ne k k₀ hkk₀, mul_zero]
          · intro hk₀_univ
            exact False.elim (hk₀_univ (Finset.mem_univ k₀))
        rw [hSingle] at hQuot
        let _ : Field (↥A ⧸ f k₀) := Ideal.Quotient.field (f k₀)
        exact one_ne_zero hQuot
      have hCard := LinearIndependent.fintype_card_le_finrank hLin
      simp only [Fintype.card_fin] at hCard
      omega
    exact ⟨hFin, hAntichain⟩
  
  constructor
  · 
    intro P _ t S_Pt
    have hComap_and_Gauss : ∀ W ∈ S_Pt,
        W.comap φ_KF = V.ofPrime P ∧
        (∀ s₀ : ↥V, s₀ ∉ P → W.valuation (φ_KF (V.subtype s₀)) = 1) ∧
        (∀ Q : Polynomial ↥V, (∃ i : ℕ, Q.coeff i ∉ P) →
