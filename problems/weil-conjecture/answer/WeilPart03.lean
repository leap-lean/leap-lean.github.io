        Polynomial.eval₂ (ι_DL.comp γ_Du) (φ_UL f) Q ≠ 0 := by
      intro Q hQ
      have hcomp_eq : ι_DL.comp γ_Du =
          res_W.comp (AlgebraicGeometry.Spec.preimage (ψ_U' ≫ h_mod ≫ g_ss)).hom := by
        calc
          ι_DL.comp γ_Du = (ι_DL.comp mk_pu).comp γ_Ass := rfl
          _ = (res_W.comp φ_ss.hom).comp γ_Ass := by rw [hιDL_mk]
          _ = res_W.comp (φ_ss.hom.comp γ_Ass) := rfl
          _ = res_W.comp (AlgebraicGeometry.Spec.preimage (ψ_U' ≫ h_mod ≫ g_ss)).hom := by
