              intro M
              induction M using Multiset.induction_on with
              | empty => simp [C_B.one_mem]
              | @cons a t ih =>
                simp only [Multiset.map_cons, Multiset.prod_cons, mul_inv_rev]
                exact C_B.mul_mem ih (hLinearInv_T₁ a)
            rw [haev, mul_inv_rev, ← map_inv₀]
            exact C_B.mul_mem (hprod_inv Q.roots) (hK_CB Q.leadingCoeff⁻¹)
        have hLT_map_CB : ∀ (x : E_hat) (hx : x ∈ L_T),
            algebraMap ↥L L₁ ⟨x, hLT_le_L hx⟩ ∈ C_B := by
          intro x hx
          have hx_cl : x ∈ closure (KT_sub : Set E_hat) := hx
          change algebraMap ↥L L₁ ⟨x, hLT_le_L hx⟩ ∈ closure (R_B : Set L₁)
          rw [Metric.mem_closure_iff]
          intro ε hε
          rw [Metric.mem_closure_iff] at hx_cl
          obtain ⟨q, hq_KT, hq_dist⟩ := hx_cl (ε / 2) (half_pos hε)
          have hq_CB : algebraMap ↥L L₁ ⟨q, hKT_le_L hq_KT⟩ ∈ closure (R_B : Set L₁) :=
            hKT_map_CB q hq_KT
          rw [Metric.mem_closure_iff] at hq_CB
          obtain ⟨r_b, hrb_RB, hrb_dist⟩ := hq_CB (ε / 2) (half_pos hε)
          refine ⟨r_b, hrb_RB, ?_⟩
          calc
            dist (algebraMap ↥L L₁ ⟨x, hLT_le_L hx⟩) r_b
                ≤ dist (algebraMap ↥L L₁ ⟨x, hLT_le_L hx⟩) (algebraMap ↥L L₁ ⟨q, hKT_le_L hq_KT⟩) +
                    dist (algebraMap ↥L L₁ ⟨q, hKT_le_L hq_KT⟩) r_b := dist_triangle _ _ _
            _ = dist x q + dist (algebraMap ↥L L₁ ⟨q, hKT_le_L hq_KT⟩) r_b := by
                rw [dist_eq_norm, ← map_sub, hIsoL₁, Subfield.coe_sub, ← dist_eq_norm]
