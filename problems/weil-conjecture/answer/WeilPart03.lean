        · rw [max_eq_right h, max_eq_right (Nat.mul_le_mul_left k h)]
        · rw [max_eq_left h, max_eq_left (Nat.mul_le_mul_left k h)]
    obtain ⟨ν, hν_zero, hν_smul, hν_add, hν_pow_all⟩ := hSeminorm
    have hν_pow : ∀ f : L, ν (f ^ p) = p * ν f := fun f => hν_pow_all f p
    
    let q_char := ringChar E
    haveI hCharEq : CharP E q_char := ringChar.charP E
