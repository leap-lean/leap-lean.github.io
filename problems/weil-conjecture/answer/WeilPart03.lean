        Ideal.exists_ideal_over_prime_of_isIntegral_of_isPrime p_θ Q' hQ'_le
      haveI : Q''.IsPrime := hQ''_prime
      have hI₁_le_Q'' : I₁ ≤ Q'' := by
        rw [Ideal.map_le_iff_le_comap]
        intro a ha
        have ha_q₀ : algebraMap A₁ ↥R₁ a ∈ q₀ := by rw [← Ideal.mem_comap, hcomap_q₀]; exact ha
        have ha_pθ : algebraMap A₁ ↥S_θ a ∈ p_θ := ha_q₀
