            simp only [Subfield.coe_mul, hu₁, hu₂, map_mul, div_mul_div_comm]
          change (φ₀_fun (u₁ * u₂) : F_hat) = (φ₀_fun u₁ : F_hat) * (φ₀_fun u₂ : F_hat)
