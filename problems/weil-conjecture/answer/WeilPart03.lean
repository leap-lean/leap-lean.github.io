        have he_comm : ∀ k : ↥Kt, e_F₀ (algebraMap ↥Kt ↥L_coeff k) = algebraMap ↥Kt₁ ↥F₀ (e_Kt k) := by
          intro k
          change e_F₀ k.1 = e_F₀ (e_Kt.symm (e_Kt k)).1
          rw [e_Kt.symm_apply_apply]
        have hFin_Kt₁_F₀ : FiniteDimensional ↥Kt₁ ↥F₀ := by
          have hfin0 : Module.Finite ↥Kt ↥L_coeff := hFinSep_Kt.1
          change Module.Finite ↥Kt₁ ↥F₀
          rw [Module.finite_def] at hfin0 ⊢
          rcases hfin0 with ⟨S₀, hS₀⟩
          refine ⟨S₀.image e_F₀, top_unique fun y _ => ?_⟩
          have hy0 : e_F₀.symm y ∈ Submodule.span ↥Kt (S₀ : Set ↥L_coeff) := by
            rw [hS₀]; trivial
