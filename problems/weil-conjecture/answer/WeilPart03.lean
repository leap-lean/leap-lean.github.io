      rw [hP0_eq]
      exact hVand P_0 (hAlgClosed P_0 hP0_ne) M
    obtain ⟨y₀, V₀, hV₀, hy₀V₀, hy₀_cl, hy₀_z0, hNotLin⟩ :=
      weil_projective_closure_divisorial_point_specialization K V M U'.toScheme U_ss g_ss h_mod
        Γ y U hU hyU f D_u ι_D m_D L_y φ_UL ι_DL
        hProp_mod hCl_Γ hΓ_snd hCl_ιD hm_D hker_φUL hComm_L hTrans_D hVand_mD
    let q_y₀ : AlgebraicGeometry.Spec (U'.toScheme.presheaf.obj (Opposite.op V₀)) :=
      hV₀.primeIdealOf ⟨y₀, hy₀V₀⟩
    let p_y₀ : Ideal ↑(U'.toScheme.presheaf.obj (Opposite.op V₀)) := q_y₀.asIdeal
    haveI : p_y₀.IsPrime := q_y₀.isPrime
    let γ_V₀ : ↥V →+* ↑(U'.toScheme.presheaf.obj (Opposite.op V₀)) :=
      (AlgebraicGeometry.Spec.preimage (hV₀.fromSpec ≫ h_mod ≫ g_ss)).hom
    have hγ_V0_comap : Ideal.comap γ_V₀ p_y₀ = P_0 := by
      have hc := hPre_comap (hV₀.fromSpec ≫ h_mod ≫ g_ss) q_y₀
      have hbase : ((hV₀.fromSpec ≫ h_mod ≫ g_ss).base q_y₀).asIdeal = P_0 := by
        change (g_ss.base (h_mod.base (hV₀.fromSpec.base q_y₀))).asIdeal = P_0
        rw [hV₀.fromSpec_primeIdealOf ⟨y₀, hy₀V₀⟩, hy₀_z0, hP0_eq]
      exact hc.trans hbase
    rcases hDicho P_0 (hAlgClosed P_0 hP0_ne)
        ↑(U'.toScheme.presheaf.obj (Opposite.op V₀)) p_y₀ γ_V₀ hγ_V0_comap with
      ⟨b₁, b₂, hb₂, hb_poly⟩ | ⟨_, hP0_le_P1, hB0_lin, _⟩
    · have hz0_cl_y0 : IsClosed ({h_mod.base y₀} : Set U_ss) := by
        rw [hy₀_z0]
        exact hz0_closed
      have hP0_ne_y0 : (g_ss.base (h_mod.base y₀)).asIdeal ≠ ⊥ := by
        rw [hy₀_z0, hP0_eq]
        exact hP0_ne
      have hb_poly_spec : ∀ (R : Type u) [CommRing R] [IsLocalRing R]
          (ρ_B : ↑(U'.toScheme.presheaf.obj (Opposite.op V₀)) →+* R),
          Ideal.comap ρ_B (IsLocalRing.maximalIdeal R) = p_y₀ →
          ∀ (t : R),
            ρ_B b₂ * t = ρ_B b₁ →
            ∀ (Q : Polynomial ↥V),
