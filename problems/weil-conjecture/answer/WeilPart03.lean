    intro hu0
    have hT0 : (LaurentPolynomial.T 1 : LaurentPolynomial R) = 0 := by
      rw [← hbarΦ_u, hu0, map_zero]
    have h10 : (1 : LaurentPolynomial R) = 0 := by
      calc
        (1 : LaurentPolynomial R) = LaurentPolynomial.T (1 + (-1)) := by
          norm_num [LaurentPolynomial.T_zero]
        _ = LaurentPolynomial.T 1 * LaurentPolynomial.T (-1) := LaurentPolynomial.T_add 1 (-1)
        _ = 0 := by rw [hT0, zero_mul]
    exact one_ne_zero h10
