        have hK_CB : ∀ c : K_hat, algebraMap K_hat L₁ c ∈ C_B := fun c => hRB_le_CB (hK_RB c)
        let T₁ : L₁ := (T_alg : L₁)
        have hT₁_L1coeff : T₁ ∈ L1_coeff := T_alg.2
        have hT₁_RB : T₁ ∈ R_B := hL1_coeff_in_VB hT₁_L1coeff
        have hT₁_CB : T₁ ∈ C_B := hRB_le_CB hT₁_RB
