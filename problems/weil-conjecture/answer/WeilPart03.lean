      · rw [Ideal.map_le_iff_le_comap]
        intro r hr
        change π (algebraMap R ↥R₀ r) = 0
        rw [AlgHom.commutes]
        change (res r) ⊗ₜ[R] (1 : ↥R₀) = 0
        have hres0 : res r = 0 := (IsLocalRing.residue_eq_zero_iff r).mpr hr
