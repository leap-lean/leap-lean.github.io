      let e_rng : ↑(C'.presheaf.obj (Opposite.op (C'_open α))) ≃+* ↥φ'_a.hom.range :=
        RingEquiv.ofBijective φ'_a.hom.rangeRestrict
          ⟨fun x y h => hinj_a (congrArg Subtype.val h), fun ⟨_, u, rfl⟩ => ⟨u, rfl⟩⟩
      let ψ_a : ↑(C₀.presheaf.obj (Opposite.op (C₀_open s₀))) →+*
          ↑(C'.presheaf.obj (Opposite.op (C'_open α))) :=
        e_rng.symm.toRingHom.comp (RingHom.codRestrict φ₀_a.hom φ'_a.hom.range hSub)
      have hψ_comp0 : φ'_a.hom.comp ψ_a = φ₀_a.hom := by
        ext x
        change (e_rng (e_rng.symm ⟨φ₀_a.hom x, hSub x⟩)).1 = φ₀_a.hom x
        rw [RingEquiv.apply_symm_apply]
      let π_a : (C'_open α).toScheme ⟶ C₀ :=
        hAff'_a.isoSpec.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_a) ≫ hAff₀_s₀.fromSpec
      have hψ_uniq : ∀ (hC' : AlgebraicGeometry.IsAffineOpen (C'_open α))
          (φ' : C'.presheaf.obj (Opposite.op (C'_open α)) ⟶ CommRingCat.of F)
          (hC₀r : AlgebraicGeometry.IsAffineOpen (C₀_open s₀))
          (φ₀ : C₀.presheaf.obj (Opposite.op (C₀_open s₀)) ⟶ CommRingCat.of F),
          AlgebraicGeometry.Spec.map φ' ≫ hC'.fromSpec = η_F ≫ ι' →
          AlgebraicGeometry.Spec.map φ₀ ≫ hC₀r.fromSpec = η_F ≫ ι₀ →
          φ'.hom.comp ψ_a = φ₀.hom := by
        intro hC' φ' hC₀r φ₀ hφ' hφ₀
        have hc1 : hC' = hAff'_a := Subsingleton.elim _ _
        subst hC'
        have hc2 : hC₀r = hAff₀_s₀ := Subsingleton.elim _ _
        subst hC₀r
        have heq1 : φ' = φ'_a :=
          AlgebraicGeometry.Spec.map_injective ((cancel_mono hAff'_a.fromSpec).mp (hφ'.trans hφ'_a.symm))
        have heq2 : φ₀ = φ₀_a :=
          AlgebraicGeometry.Spec.map_injective ((cancel_mono hAff₀_s₀.fromSpec).mp (hφ₀.trans hφ₀_a.symm))
        rw [heq1, heq2]
        exact hψ_comp0
      have hπ_gen : ∀ (hC' : AlgebraicGeometry.IsAffineOpen (C'_open α))
          (φ' : C'.presheaf.obj (Opposite.op (C'_open α)) ⟶ CommRingCat.of F),
          AlgebraicGeometry.Spec.map φ' ≫ hC'.fromSpec = η_F ≫ ι' →
          AlgebraicGeometry.Spec.map φ' ≫ hC'.isoSpec.inv ≫ π_a = η_F ≫ ι₀ := by
        intro hC' φ' hφ'
        have hc1 : hC' = hAff'_a := Subsingleton.elim _ _
        subst hC'
        have hcomp := hψ_uniq hAff'_a φ' hAff₀_s₀ φ₀_a hφ' hφ₀_a
        have hcomm_cat : CommRingCat.ofHom ψ_a ≫ φ' = φ₀_a := by
          ext x; exact congrArg (fun u => u x) hcomp
        dsimp only [π_a]
        rw [← CategoryTheory.Category.assoc hAff'_a.isoSpec.inv, Iso.inv_hom_id,
          CategoryTheory.Category.id_comp, ← CategoryTheory.Category.assoc,
          ← AlgebraicGeometry.Spec.map_comp, hcomm_cat, hφ₀_a]
      have hπ_g₀ : π_a ≫ g₀ = (C'_open α).ι ≫ g' := by
        rw [← cancel_epi hAff'_a.isoSpec.inv]
        dsimp only [π_a]
        rw [← CategoryTheory.Category.assoc hAff'_a.isoSpec.inv,
          ← CategoryTheory.Category.assoc hAff'_a.isoSpec.inv, Iso.inv_hom_id,
          CategoryTheory.Category.id_comp,
          ← CategoryTheory.Category.assoc hAff'_a.isoSpec.inv (C'_open α).ι,
          hAff'_a.isoSpec_inv_ι]
        have h_c0 := h_base_eval g₀ ι₀ hMod₀.2.2.2.2.2.2.2.1.w ιP₀ hCommP₀ s₀ hAff₀_s₀ φ₀_a hφ₀_a
        have h_ring_eq : ψ_a.comp (((ιP₀.app (weilProjBasicOpen ↥V M₀ s₀)).hom).comp (c_proj ↥V M₀ s₀)) =
            ((ιP'.app (weilProjBasicOpen ↥V M α)).hom).comp (c_proj ↥V M α) := by
          ext y
          apply hinj_a
          change (φ'_a.hom.comp ψ_a) ((ιP₀.app _).hom (c_proj ↥V M₀ s₀ y)) =
            φ'_a.hom ((ιP'.app _).hom (c_proj ↥V M α y))
          rw [hψ_comp0, h_c0 y, hEval_a.1 y]
        rw [← hCommP₀, ← hCommP',
          CategoryTheory.Category.assoc _ hAff₀_s₀.fromSpec,
          ← CategoryTheory.Category.assoc hAff₀_s₀.fromSpec,
          h_fromSpec_pre ιP₀ (hAff_proj ↥V M₀ s₀) hAff₀_s₀,
          CategoryTheory.Category.assoc, ← (hCoord_proj ↥V M₀).2.2.1 s₀,
          ← CategoryTheory.Category.assoc hAff'_a.fromSpec,
          h_fromSpec_pre ιP' (hAff_proj ↥V M α) hAff'_a,
          CategoryTheory.Category.assoc, ← (hCoord_proj ↥V M).2.2.1 α,
          ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
          ← AlgebraicGeometry.Spec.map_comp]
        congr 1
        ext y
        exact congrArg (fun u => u y) h_ring_eq
      exact ⟨π_a, hπ_g₀, hπ_gen, ψ_a, hψ_uniq, rfl⟩
    choose π_loc hπ_g₀ hπ_gen ψ_loc hψ_uniq hπ_def using h_chart
    have h_glue : ∀ a₀ a₁ : 𝒰.I₀,
        CategoryTheory.Limits.pullback.fst (𝒰.f a₀) (𝒰.f a₁) ≫ π_loc a₀ =
          CategoryTheory.Limits.pullback.snd (𝒰.f a₀) (𝒰.f a₁) ≫ π_loc a₁ := by
      intro a₀ a₁
      let hp := AlgebraicGeometry.isPullback_opens_inf (C'_open a₀.1) (C'_open a₁.1)
      change CategoryTheory.Limits.pullback.fst (C'_open a₀.1).ι (C'_open a₁.1).ι ≫ π_loc a₀ =
        CategoryTheory.Limits.pullback.snd (C'_open a₀.1).ι (C'_open a₁.1).ι ≫ π_loc a₁
      rw [← cancel_epi hp.isoPullback.hom, ← CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc, hp.isoPullback_hom_fst, hp.isoPullback_hom_snd]
      let α₀ := a₀.1
      let α₁ := a₁.1
      let s₀ := (eSeg α₀).1
      let s₁ := (eSeg α₁).1
      let W : C'.Opens := C'_open α₀ ⊓ C'_open α₁
      let V₀₁ : C₀.Opens := C₀_open s₀ ⊓ C₀_open s₁
      have hAffW : AlgebraicGeometry.IsAffineOpen W := by
        have h1 : AlgebraicGeometry.IsAffineOpen
            (weilProjBasicOpen ↥V M α₀ ⊓ weilProjBasicOpen ↥V M α₁) := by
          rw [← (hCoord_proj ↥V M).2.2.2.2.2.2.2.1 α₀ α₁]
          exact (hAff_proj ↥V M α₀).basicOpen (t_proj ↥V M α₀ α₁)
        exact h1.preimage ιP'
      have hAffV₀₁ : AlgebraicGeometry.IsAffineOpen V₀₁ := by
        have h1 : AlgebraicGeometry.IsAffineOpen
            (weilProjBasicOpen ↥V M₀ s₀ ⊓ weilProjBasicOpen ↥V M₀ s₁) := by
          rw [← (hCoord_proj ↥V M₀).2.2.2.2.2.2.2.1 s₀ s₁]
          exact (hAff_proj ↥V M₀ s₀).basicOpen (t_proj ↥V M₀ s₀ s₁)
        exact h1.preimage ιP₀
      have hIrredC' : IrreducibleSpace ↥C' :=
        @AlgebraicGeometry.irreducibleSpace_of_isIntegral C' hMod'.1
      have hneW : Nonempty ↥W := by
        rcases a₀.2 with ⟨⟨z₀, hz₀⟩⟩
        rcases a₁.2 with ⟨⟨z₁, hz₁⟩⟩
        rcases nonempty_preirreducible_inter (C'_open α₀).isOpen (C'_open α₁).isOpen
          ⟨z₀, hz₀⟩ ⟨z₁, hz₁⟩ with ⟨z, hz⟩
        exact ⟨⟨z, hz⟩⟩
      obtain ⟨φ'_W, hFrac'_W, hφ'_W⟩ := hFunc' W hAffW hneW
      let : Algebra ↑(C'.presheaf.obj (Opposite.op W)) F := φ'_W.hom.toAlgebra
      have hinj_W : Function.Injective φ'_W.hom :=
        @IsFractionRing.injective ↑(C'.presheaf.obj (Opposite.op W)) _ F _ _ hFrac'_W
      have h_range_sub : ∀ (b₀ b₁ : 𝒜_pos) (hle₀ : W ≤ C'_open b₀.1) (hle₁ : W ≤ C'_open b₁.1),
          Set.range ⇑(hAffW.isoSpec.inv ≫ C'.homOfLE hle₀ ≫ π_loc b₀) ⊆
            (C₀_open (eSeg b₀.1).1 ⊓ C₀_open (eSeg b₁.1).1 : Set C₀) := by
        intro b₀ b₁ hle₀ hle₁
        let sb₀ := (eSeg b₀.1).1
        let sb₁ := (eSeg b₁.1).1
        let Jb₁ := (eSeg b₁.1).2
        have hξ_b₀ : ξ sb₀ ≠ 0 := (h_s1 b₀.1).2.1.mp b₀.2
        have hξ_b₁ : ξ sb₁ ≠ 0 := (h_s1 b₁.1).2.1.mp b₁.2
        have hAff₀_b₀ : AlgebraicGeometry.IsAffineOpen (C₀_open sb₀) := (hC₀K_charts sb₀).1
        have hne₀_b₀ : Nonempty ↥(C₀_open sb₀) := (hC₀K_charts sb₀).2.2.1.mpr hξ_b₀
        obtain ⟨φ₀_b₀, _, hφ₀_b₀⟩ := hFunc₀ (C₀_open sb₀) hAff₀_b₀ hne₀_b₀
        let res₀ := C'.presheaf.map (CategoryTheory.homOfLE hle₀).op
        let res₁ := C'.presheaf.map (CategoryTheory.homOfLE hle₁).op
        have hφ'_res₀ : AlgebraicGeometry.Spec.map (res₀ ≫ φ'_W) ≫ (h_s1 b₀.1).1.fromSpec = η_F ≫ ι' := by
          rw [AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc,
            h_fromSpec_le (h_s1 b₀.1).1 hAffW hle₀, hφ'_W]
        have hφ'_res₁ : AlgebraicGeometry.Spec.map (res₁ ≫ φ'_W) ≫ (h_s1 b₁.1).1.fromSpec = η_F ≫ ι' := by
          rw [AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc,
            h_fromSpec_le (h_s1 b₁.1).1 hAffW hle₁, hφ'_W]
        let q₀₁ := (ιP₀.app (weilProjBasicOpen ↥V M₀ sb₀)).hom (t_proj ↥V M₀ sb₀ sb₁)
        let u₀₁ := res₀.hom (ψ_loc b₀ q₀₁)
        let u₁₀ := res₁.hom ((ιP'.app (weilProjBasicOpen ↥V M b₁.1)).hom
          (t_proj ↥V M b₁.1 (eSeg.symm (sb₀, Jb₁))))
        have hmul : u₀₁ * u₁₀ = 1 := by
          apply hinj_W
          rw [map_mul, map_one]
          have h1 : φ'_W.hom u₀₁ = ξ sb₁ / ξ sb₀ := by
            change ((res₀ ≫ φ'_W).hom.comp (ψ_loc b₀)) q₀₁ = ξ sb₁ / ξ sb₀
            rw [hψ_uniq b₀ (h_s1 b₀.1).1 (res₀ ≫ φ'_W) hAff₀_b₀ φ₀_b₀ hφ'_res₀ hφ₀_b₀]
            exact (((hC₀K_charts sb₀).2.2.2.2 hξ_b₀).1 hAff₀_b₀ φ₀_b₀ hφ₀_b₀).1 sb₁
          have h2 : φ'_W.hom u₁₀ = ξ sb₀ / ξ sb₁ := by
            change (res₁ ≫ φ'_W).hom
              ((ιP'.app (weilProjBasicOpen ↥V M b₁.1)).hom
                (t_proj ↥V M b₁.1 (eSeg.symm (sb₀, Jb₁)))) = ξ sb₀ / ξ sb₁
            have ht := ((h_s1 b₁.1).2.2 b₁.2 (h_s1 b₁.1).1 (res₁ ≫ φ'_W) hφ'_res₁).2
              (eSeg.symm (sb₀, Jb₁))
            have heβ : eSeg (eSeg.symm (sb₀, Jb₁)) = (sb₀, Jb₁) := eSeg.apply_symm_apply _
            have hd1 : (eSeg (eSeg.symm (sb₀, Jb₁))).2 \ (eSeg b₁.1).2 = ∅ := by
              rw [heβ]; exact Finset.sdiff_self Jb₁
            have hd2 : (eSeg b₁.1).2 \ (eSeg (eSeg.symm (sb₀, Jb₁))).2 = ∅ := by
              rw [heβ]; exact Finset.sdiff_self Jb₁
            rw [ht, hd1, hd2, Finset.prod_empty, Finset.prod_empty, mul_one, mul_one, heβ]
          rw [h1, h2, div_mul_div_cancel₀ hξ_b₀, div_self hξ_b₁]
        have h_iso_hom : hAffW.isoSpec.inv ≫ C'.homOfLE hle₀ ≫ (h_s1 b₀.1).1.isoSpec.hom =
            AlgebraicGeometry.Spec.map res₀ := by
          rw [← cancel_mono (h_s1 b₀.1).1.fromSpec]
          calc
            (hAffW.isoSpec.inv ≫ C'.homOfLE hle₀ ≫ (h_s1 b₀.1).1.isoSpec.hom) ≫
                (h_s1 b₀.1).1.fromSpec
              = hAffW.isoSpec.inv ≫ C'.homOfLE hle₀ ≫
                  ((h_s1 b₀.1).1.isoSpec.hom ≫ (h_s1 b₀.1).1.isoSpec.inv) ≫ (C'_open b₀.1).ι := by
                simp only [← (h_s1 b₀.1).1.isoSpec_inv_ι, CategoryTheory.Category.assoc]
                rfl
            _ = hAffW.fromSpec := by
                rw [Iso.hom_inv_id, CategoryTheory.Category.id_comp,
                  AlgebraicGeometry.Scheme.homOfLE_ι, hAffW.isoSpec_inv_ι]
            _ = AlgebraicGeometry.Spec.map res₀ ≫ (h_s1 b₀.1).1.fromSpec :=
                (h_fromSpec_le (h_s1 b₀.1).1 hAffW hle₀).symm
        have h_fac : hAffW.isoSpec.inv ≫ C'.homOfLE hle₀ ≫ π_loc b₀ =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (res₀.hom.comp (ψ_loc b₀))) ≫
              hAff₀_b₀.fromSpec := by
          rw [hπ_def b₀, ← CategoryTheory.Category.assoc (C'.homOfLE hle₀),
            ← CategoryTheory.Category.assoc hAffW.isoSpec.inv, h_iso_hom,
            ← CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map res₀)
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_loc b₀))),
            ← AlgebraicGeometry.Spec.map_comp]
          rfl
        rintro _ ⟨p, rfl⟩
        rw [h_fac, AlgebraicGeometry.Scheme.Hom.comp_apply]
        have hbasic_eq : C₀_open sb₀ ⊓ C₀_open sb₁ = C₀.basicOpen q₀₁ := by
          change (TopologicalSpace.Opens.map ιP₀.base).obj
              (weilProjBasicOpen ↥V M₀ sb₀ ⊓ weilProjBasicOpen ↥V M₀ sb₁) = C₀.basicOpen q₀₁
          rw [← (hCoord_proj ↥V M₀).2.2.2.2.2.2.2.1 sb₀ sb₁,
            AlgebraicGeometry.Scheme.Hom.preimage_basicOpen]
        change hAff₀_b₀.fromSpec _ ∈ C₀_open sb₀ ⊓ C₀_open sb₁
        rw [hbasic_eq]
        change _ ∈ (TopologicalSpace.Opens.map hAff₀_b₀.fromSpec.base).obj (C₀.basicOpen q₀₁)
        rw [hAff₀_b₀.fromSpec_preimage_basicOpen]
        intro hmem_p
        have hu_mem : u₀₁ ∈ p.asIdeal := hmem_p
        have h1_mem : (1 : ↑(C'.presheaf.obj (Opposite.op W))) ∈ p.asIdeal := by
          rw [← hmul]; exact p.asIdeal.mul_mem_right u₁₀ hu_mem
        exact p.isPrime.ne_top (p.asIdeal.eq_top_iff_one.mpr h1_mem)
      let m₀ := hAffW.isoSpec.inv ≫ C'.homOfLE (inf_le_left : W ≤ C'_open α₀) ≫ π_loc a₀
      let m₁ := hAffW.isoSpec.inv ≫ C'.homOfLE (inf_le_right : W ≤ C'_open α₁) ≫ π_loc a₁
      have hm₀ : Set.range ⇑m₀ ⊆ Set.range ⇑hAffV₀₁.fromSpec := by
        rw [hAffV₀₁.range_fromSpec]
        exact h_range_sub a₀ a₁ inf_le_left inf_le_right
      have hm₁ : Set.range ⇑m₁ ⊆ Set.range ⇑hAffV₀₁.fromSpec := by
        rw [hAffV₀₁.range_fromSpec]
        exact (h_range_sub a₁ a₀ inf_le_right inf_le_left).trans (fun _ hz => ⟨hz.2, hz.1⟩)
      let g_lift₀ := AlgebraicGeometry.IsOpenImmersion.lift hAffV₀₁.fromSpec m₀ hm₀
      let g_lift₁ := AlgebraicGeometry.IsOpenImmersion.lift hAffV₀₁.fromSpec m₁ hm₁
      have hg₀_fac : g_lift₀ ≫ hAffV₀₁.fromSpec = m₀ :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac hAffV₀₁.fromSpec m₀ hm₀
      have hg₁_fac : g_lift₁ ≫ hAffV₀₁.fromSpec = m₁ :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac hAffV₀₁.fromSpec m₁ hm₁
      have h_gen_m : ∀ (b : 𝒜_pos) (hle : W ≤ C'_open b.1),
          AlgebraicGeometry.Spec.map φ'_W ≫ hAffW.isoSpec.inv ≫ C'.homOfLE hle ≫ π_loc b =
            η_F ≫ ι₀ := by
        intro b hle
        let res := C'.presheaf.map (CategoryTheory.homOfLE hle).op
        have hφ'_res : AlgebraicGeometry.Spec.map (res ≫ φ'_W) ≫ (h_s1 b.1).1.fromSpec = η_F ≫ ι' := by
          rw [AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc,
            h_fromSpec_le (h_s1 b.1).1 hAffW hle, hφ'_W]
        have h_iso_inv : hAffW.isoSpec.inv ≫ C'.homOfLE hle =
            AlgebraicGeometry.Spec.map res ≫ (h_s1 b.1).1.isoSpec.inv := by
          rw [← cancel_mono (C'_open b.1).ι, CategoryTheory.Category.assoc,
            AlgebraicGeometry.Scheme.homOfLE_ι, hAffW.isoSpec_inv_ι,
            CategoryTheory.Category.assoc, (h_s1 b.1).1.isoSpec_inv_ι]
          exact (h_fromSpec_le (h_s1 b.1).1 hAffW hle).symm
        rw [← CategoryTheory.Category.assoc hAffW.isoSpec.inv, h_iso_inv,
          CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map φ'_W),
          ← AlgebraicGeometry.Spec.map_comp]
        exact hπ_gen b (h_s1 b.1).1 (res ≫ φ'_W) hφ'_res
      obtain ⟨b₀_op, hb₀_op⟩ := AlgebraicGeometry.Spec.fullyFaithful.map_surjective g_lift₀
      obtain ⟨b₁_op, hb₁_op⟩ := AlgebraicGeometry.Spec.fullyFaithful.map_surjective g_lift₁
      let b₀_hom := b₀_op.unop
      let b₁_hom := b₁_op.unop
      have hb₀_hom : AlgebraicGeometry.Spec.map b₀_hom = g_lift₀ := hb₀_op
      have hb₁_hom : AlgebraicGeometry.Spec.map b₁_hom = g_lift₁ := hb₁_op
      have heq_lifts : AlgebraicGeometry.Spec.map φ'_W ≫ g_lift₀ ≫ hAffV₀₁.fromSpec =
          AlgebraicGeometry.Spec.map φ'_W ≫ g_lift₁ ≫ hAffV₀₁.fromSpec := by
        rw [hg₀_fac, hg₁_fac, h_gen_m a₀ inf_le_left, h_gen_m a₁ inf_le_right]
      have heq_spec : AlgebraicGeometry.Spec.map (b₀_hom ≫ φ'_W) =
          AlgebraicGeometry.Spec.map (b₁_hom ≫ φ'_W) := by
        rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp, hb₀_hom, hb₁_hom]
        exact (cancel_mono hAffV₀₁.fromSpec).mp
          (by simpa only [CategoryTheory.Category.assoc] using heq_lifts)
      have heq_comp := AlgebraicGeometry.Spec.map_injective heq_spec
      have hb_eq : b₀_hom = b₁_hom := by
        ext x
        exact hinj_W (congrArg (fun u => u.hom x) heq_comp)
      have hg_eq : g_lift₀ = g_lift₁ := by rw [← hb₀_hom, ← hb₁_hom, hb_eq]
      have hm_eq : m₀ = m₁ := by rw [← hg₀_fac, ← hg₁_fac, hg_eq]
      exact (cancel_epi hAffW.isoSpec.inv).mp hm_eq
    let π' : C' ⟶ C₀ := 𝒰.glueMorphisms π_loc h_glue
    have hπ'_g₀ : π' ≫ g₀ = g' := by
      refine 𝒰.hom_ext _ _ (fun a => ?_)
      rw [← CategoryTheory.Category.assoc,
        show 𝒰.f a ≫ π' = π_loc a from 𝒰.ι_glueMorphisms π_loc h_glue a]
      exact hπ_g₀ a
    have hDom_ηF : AlgebraicGeometry.IsDominant η_F := by
      rw [AlgebraicGeometry.isDominant_iff]
      intro z
      rw [mem_closure_iff]
      intro U hU_open hz
      let U_op : C_K.Opens := ⟨U, hU_open⟩
      have hz_op : z ∈ U_op := hz
      obtain ⟨U₀, hU₀_aff, hz₀, hU₀_le⟩ :=
        (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
          (AlgebraicGeometry.Scheme.isBasis_affineOpens C_K)) hz_op
      obtain ⟨φ_U₀, _, hφ_U₀⟩ := hFuncF U₀ hU₀_aff ⟨⟨z, hz₀⟩⟩
      let pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of F)) := ⟨⊥, hbot_F⟩
      refine ⟨η_F pt, hU₀_le ?_, pt, rfl⟩
      rw [← hφ_U₀, AlgebraicGeometry.Scheme.Hom.comp_apply]
      have hrng : hU₀_aff.fromSpec (AlgebraicGeometry.Spec.map φ_U₀ pt) ∈
          Set.range ⇑hU₀_aff.fromSpec := ⟨_, rfl⟩
      rw [hU₀_aff.range_fromSpec] at hrng
      exact hrng
    have hIrredC' : IrreducibleSpace ↥C' :=
      @AlgebraicGeometry.irreducibleSpace_of_isIntegral C' hMod'.1
    obtain ⟨z_c'⟩ := hIrredC'.toNonempty
    have hz_c'_top : z_c' ∈ (⊤ : C'.Opens) := trivial
    rw [← hSup_pos, TopologicalSpace.Opens.mem_iSup] at hz_c'_top
    rcases hz_c'_top with ⟨a_wit, _⟩
    have hι'_π' : ι' ≫ π' = ι₀ := by
      have : AlgebraicGeometry.IsDominant η_F := hDom_ηF
      refine AlgebraicGeometry.ext_of_isDominant_of_isSeparated g₀ ?_ η_F ?_
      · rw [CategoryTheory.Category.assoc, hπ'_g₀, hMod'.2.2.2.2.2.2.2.1.w,
          hMod₀.2.2.2.2.2.2.2.1.w]
      · obtain ⟨φ'_w, _, hφ'_w⟩ := hFunc' (C'_open a_wit.1) (h_s1 a_wit.1).1 a_wit.2
        have h1 : (η_F ≫ ι') ≫ π' = η_F ≫ ι₀ := by
          rw [← hφ'_w, ← (h_s1 a_wit.1).1.isoSpec_inv_ι]
          simp only [CategoryTheory.Category.assoc]
