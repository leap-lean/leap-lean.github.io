          let P₀ : Polynomial ↥Kt := minpoly ↥Kt x
          let P₁ : Polynomial ↥Kt₁ := Polynomial.map e_Kt.toRingHom P₀
          have hP₁_sep : P₁.Separable := by
            rcases hx_sep with ⟨u, v, huv⟩
