            · have hi_pos : i ∈ S_pos := Finset.mem_filter.mpr ⟨hi, hi0⟩
              have hle0 : lvl i ≤ 0 := hlvl i hi
              rcases i with _ | ⟨n, u⟩
              · dsimp [z] at hz_zero
                rw [ite_eq_left_iff.mpr (fun h => absurd hi_pos h), Algebra.smul_def, mul_one] at hz_zero
                have hr0 : r_none = 0 :=
