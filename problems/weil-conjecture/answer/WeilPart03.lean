      have hΨP_coeff : ∀ i : ℕ,
          (Ψ₀ P).coeff i = ∑ j ∈ Finset.range (m + 1),
            (j.choose i : l_N) * algebraMap K_hat l_N (P.coeff j) * z_bar ^ (j - i) := by
        intro i
        conv_lhs => rw [Polynomial.as_sum_range_C_mul_X_pow P]
        rw [map_sum, Polynomial.finset_sum_coeff]
        apply Finset.sum_congr rfl
        intro j _
