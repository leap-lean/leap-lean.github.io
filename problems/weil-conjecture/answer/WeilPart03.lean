    have hTrans_D : ∀ Q_D : Polynomial D_u, Q_D ≠ 0 → Polynomial.eval₂ ι_DL (φ_UL f) Q_D ≠ 0 :=
      hClear P_s D_u γ_Du hker_γDu hDu_lin_Ps L_y ι_DL (φ_UL f) hPolyV_L
    have hVand_mD : ∀ (N : ℕ) (Q : Fin N → Ideal (MvPolynomial (Fin (M + 1)) ↥V)),
