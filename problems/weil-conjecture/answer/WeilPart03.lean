        have _ : FiniteDimensional ↥L0 F := hFin_sep
        have _ : Algebra.IsSeparable ↥L0 F := hSep_sep
        let Vx := W.comap L0.val.toRingHom
        let eV : ↥L0 ≃+* ↥Vx :=
          { toFun := fun a => ⟨a, by change (a : F) ∈ W; rw [hW_top]; trivial⟩
            invFun := fun u => u.1
            left_inv := fun _ => rfl
            right_inv := fun u => by ext; rfl
            map_mul' := fun _ _ => by ext; rfl
            map_add' := fun _ _ => by ext; rfl }
        let eW : F ≃+* ↥W :=
          { toFun := fun z => ⟨z, by rw [hW_top]; trivial⟩
            invFun := fun w => w.1
            left_inv := fun _ => rfl
            right_inv := fun w => by ext; rfl
            map_mul' := fun _ _ => by ext; rfl
            map_add' := fun _ _ => by ext; rfl }
        have hEt_Vx : RingHom.Etale ((L0.val.toRingHom.comp Vx.subtype).codRestrict W.toSubring (fun y => y.2)) :=
          etale_congr eV eW (algebraMap ↥L0 F)
            ((L0.val.toRingHom.comp Vx.subtype).codRestrict W.toSubring (fun y => y.2))
            (fun _ => by ext; rfl) (etale_of_sep_finDim ↥L0 F)
        exact ⟨x_sep, by rw [hW_top]; trivial, hTr_sep, hEt_Vx⟩

theorem weil_valued_curve_functionField_uniformization (k : Type u) [Field k] [IsAlgClosed k] (m : ℕ)
    (K : Type u) [Field K] [IsSepClosed K] [Algebra k K]
    (hTrK : Algebra.trdeg k K ≤ (m : Cardinal.{u}))
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (hIntCK : AlgebraicGeometry.IsIntegral C_K)
    (hPropCK : AlgebraicGeometry.IsProper p_K)
    (hSmCK : AlgebraicGeometry.SmoothOfRelativeDimension 1 p_K)
    (F : Type u) [Field F] [Algebra k F] [Algebra K F] [IsScalarTower k K F]
    (η_F : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ C_K)
    (hηF_comm : η_F ≫ p_K = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K F)))
    (hFuncF : IsSchemeFunctionField C_K F η_F)
    (W : ValuationSubring F)
    (hkW : ∀ c : k, algebraMap k F c ∈ W) :
    Set.Finite (Set.univ : Set (PrimeSpectrum ↥(W.comap (algebraMap K F)))) ∧
    Nat.card (PrimeSpectrum ↥(W.comap (algebraMap K F))) ≤ m + 1 ∧
    ∃ (x : F),
      x ∈ W ∧
      Transcendental K x ∧
      let Lx := IntermediateField.adjoin K ({x} : Set F)
      let Vx := W.comap Lx.val.toRingHom
      RingHom.Etale ((Lx.val.toRingHom.comp Vx.subtype).codRestrict W.toSubring (fun y => y.2)) :=
by
  have hkV : ∀ c : k, algebraMap k K c ∈ W.comap (algebraMap K F) := by
    intro c
    rw [ValuationSubring.mem_comap, ← IsScalarTower.algebraMap_apply k K F c]
    exact hkW c
  obtain ⟨hFinV, hCardV⟩ :=
    weil_valuationSubring_abhyankar_primeSpectrum_bound k K m hTrK
      (W.comap (algebraMap K F)) hkV
  obtain ⟨hTrF, hSepF, hUnbCurve⟩ :=
    weil_smooth_proper_curve_unbounded_and_funcField k m K hTrK C_K p_K
      hIntCK hPropCK hSmCK F η_F hηF_comm hFuncF
  obtain ⟨hFinW, _⟩ :=
    weil_valuationSubring_abhyankar_primeSpectrum_bound k F (m + 1) hTrF W hkW
  have hAnalytic : HasWeilAnalyticOneDimUniformization k := by
    intro K_hat F_hat _ _ _ _ _ _ _ _ hEquiChar hIsoK y₀ hy₀_not hy₀_fin
    have hCP_univ : ∀ (E_hat : Type u)
        [NontriviallyNormedField E_hat] [CompleteSpace E_hat]
        [IsUltrametricDist E_hat] [Algebra K_hat E_hat],
        (∀ c : K_hat, ‖algebraMap K_hat E_hat c‖ = ‖c‖) →
        HasWeilImmediateCosetAndPerturb K_hat E_hat :=
      fun E_hat _ _ _ _ hIsoE =>
        weil_analytic_immediate_deg_p_and_perturbation K_hat E_hat hEquiChar hIsoE
    obtain ⟨hT23_ex, hT2_crit⟩ :=
      weil_analytic_types23_ext_uniformization K_hat F_hat hEquiChar hIsoK
        hCP_univ y₀ hy₀_not hy₀_fin
    refine ⟨?_, hT2_crit⟩
    by_cases hRes : ∀ w : F_hat, ‖w‖ ≤ 1 → ∃ c : K_hat, ‖w - algebraMap K_hat F_hat c‖ < 1
    · by_cases hVal : ∀ w : F_hat, w ≠ 0 → ∃ c : K_hat, ‖w‖ = ‖c‖
      · obtain ⟨x₀, ε, hε, hx₀⟩ :=
          weil_analytic_type4_monogenic_uniformization K_hat F_hat hEquiChar hIsoK
            (hCP_univ F_hat hIsoK) y₀ hy₀_not hy₀_fin hRes hVal
        exact ⟨x₀, ε, hε, fun x' hx' => (hx₀ x' hx').2⟩
      · push Not at hVal
        exact hT23_ex (Or.inr hVal)
    · push Not at hRes
      exact hT23_ex (Or.inl hRes)
  have hParam : IsWeilEtaleTranscendenceParam K F W :=
    weil_decompletion_composed_height_induction k K F W hkW hFinV hFinW hSepF hUnbCurve hAnalytic
  exact ⟨hFinV, hCardV, hParam⟩

theorem weil_valuationSubring_initial_projective_pointed_model (k : Type u) [Field k] [IsAlgClosed k] (m : ℕ)
    (K : Type u) [Field K] [IsSepClosed K] [Algebra k K]
    (hTrK : Algebra.trdeg k K ≤ (m : Cardinal.{u}))
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (n : ℕ)
    (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (hIntCK : AlgebraicGeometry.IsIntegral C_K)
    (hPropCK : AlgebraicGeometry.IsProper p_K)
    (hSmCK : AlgebraicGeometry.SmoothOfRelativeDimension 1 p_K)
    (hStabCK : IsGeometricStablePointedCurve p_K n σ_K)
    (M_K : ℕ)
    (ι_proj : C_K ⟶ (weilProjectiveSpaceOver K M_K).left)
    (hClProj : AlgebraicGeometry.IsClosedImmersion ι_proj)
    (hProjComm : ι_proj ≫ (weilProjectiveSpaceOver K M_K).hom = p_K)
    (F : Type u) [Field F] [Algebra k F] [Algebra K F] [IsScalarTower k K F]
    (η_F : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ C_K)
    (hηF_comm : η_F ≫ p_K = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K F)))
    (hFuncF : IsSchemeFunctionField C_K F η_F)
    (hUnif : ∀ (W : ValuationSubring F),
      (∀ c : k, algebraMap k F c ∈ W) →
      Set.Finite (Set.univ : Set (PrimeSpectrum ↥(W.comap (algebraMap K F)))) ∧
      Nat.card (PrimeSpectrum ↥(W.comap (algebraMap K F))) ≤ m + 1 ∧
      ∃ (x : F),
        x ∈ W ∧
        Transcendental K x ∧
        let Lx := IntermediateField.adjoin K ({x} : Set F)
        let Vx := W.comap Lx.val.toRingHom
        RingHom.Etale ((Lx.val.toRingHom.comp Vx.subtype).codRestrict W.toSubring (fun y => y.2)))
    (V : ValuationSubring K)
    (hkV : ∀ c : k, algebraMap k K c ∈ V) :
    IsValuationRingAlgPackage m V ∧
    ∃ (C₀ : AlgebraicGeometry.Scheme.{u})
      (g₀ : C₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
      (τ₀ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C₀))
      (ι₀ : C_K ⟶ C₀),
      IsValuationPointedCurveModel V p_K n σ_K C₀ g₀ τ₀ ι₀ :=
by
  
  have h_s1 : ∀ (k : Type u) [Field k] (m : ℕ)
      (K : Type u) [Field K] [Algebra k K]
      (F : Type u) [Field F] [Algebra k F] [Algebra K F] [IsScalarTower k K F]
      (hUnif_card : ∀ (W : ValuationSubring F),
        (∀ c : k, algebraMap k F c ∈ W) →
        Set.Finite (Set.univ : Set (PrimeSpectrum ↥(W.comap (algebraMap K F)))) ∧
        Nat.card (PrimeSpectrum ↥(W.comap (algebraMap K F))) ≤ m + 1)
      (V : ValuationSubring K)
      (hkV : ∀ c : k, algebraMap k K c ∈ V),
      Set.Finite (Set.univ : Set (PrimeSpectrum ↥V)) ∧
      Nat.card (PrimeSpectrum ↥V) ≤ m + 1 ∧
      AlgebraicGeometry.IsOpenImmersion
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)) := by
    clear * -
    intro k _ m K _ _ F _ _ _ _ hUnif_card V hkV
    classical
    let φ : ↥V →+* F := (algebraMap K F).comp V.subtype
    obtain ⟨W, hW_mem, hLoc⟩ := IsLocalRing.exists_factor_valuationRing φ
    let ψ : ↥V →+* ↥W := φ.codRestrict W.toSubring hW_mem
    have : IsLocalHom ψ := hLoc
    have hComap : W.comap (algebraMap K F) = V := by
      ext a
      constructor
      · intro haW
        by_contra haV
        have ha0 : a ≠ 0 := by
          rintro rfl
          exact haV V.zero_mem
        have ha_inv : a⁻¹ ∈ V := (V.mem_or_inv_mem a).resolve_left haV
        let x : ↥V := ⟨a⁻¹, ha_inv⟩
        have hx_nonunit : ¬ IsUnit x := by
          rintro ⟨u, hu⟩
          have hmul : (u : ↥V) * ↑(u⁻¹) = 1 := Units.mul_inv u
          rw [hu] at hmul
          have hmulK : a⁻¹ * ((↑(u⁻¹) : ↥V) : K) = 1 := congrArg Subtype.val hmul
          have ha_eq : ((↑(u⁻¹) : ↥V) : K) = a := by
            calc
              ((↑(u⁻¹) : ↥V) : K) = a * (a⁻¹ * ((↑(u⁻¹) : ↥V) : K)) := by
                rw [← mul_assoc, mul_inv_cancel₀ ha0, one_mul]
              _ = a := by rw [hmulK, mul_one]
          exact haV (ha_eq ▸ (↑(u⁻¹) : ↥V).2)
        have hψx_unit : IsUnit (ψ x) := by
          let w : ↥W := ⟨algebraMap K F a, haW⟩
          refine isUnit_iff_exists_inv.mpr ⟨w, ?_⟩
          apply Subtype.ext
          change algebraMap K F a⁻¹ * algebraMap K F a = 1
          rw [← map_mul, inv_mul_cancel₀ ha0, map_one]
        exact hx_nonunit ((isUnit_map_iff ψ x).mp hψx_unit)
      · intro haV
        exact hW_mem ⟨a, haV⟩
    have hkW : ∀ c : k, algebraMap k F c ∈ W := by
      intro c
      rw [IsScalarTower.algebraMap_apply k K F c]
      exact hW_mem ⟨algebraMap k K c, hkV c⟩
    have hFinCard := hUnif_card W hkW
    rw [hComap] at hFinCard
    rcases hFinCard with ⟨hFinSpec, hCardSpec⟩
    have hFinType : Finite (PrimeSpectrum ↥V) := Set.finite_univ_iff.mp hFinSpec
    let _ : Fintype (PrimeSpectrum ↥V) := Fintype.ofFinite (PrimeSpectrum ↥V)
    let S_pos : Finset (PrimeSpectrum ↥V) :=
      Finset.univ.filter (fun P : PrimeSpectrum ↥V => P.asIdeal ≠ ⊥)
    have hDvdTotal : Std.Total (fun x y : ↥V => x ∣ y) :=
      (ValuationRing.iff_dvd_total (R := ↥V)).mp inferInstance
    have hTotal : ∀ P Q : PrimeSpectrum ↥V, P.asIdeal ≤ Q.asIdeal ∨ Q.asIdeal ≤ P.asIdeal := by
      intro P Q
      by_cases hPQ : P.asIdeal ≤ Q.asIdeal
      · exact Or.inl hPQ
      · right
        obtain ⟨x, hxP, hxQ⟩ := Set.not_subset.mp hPQ
        intro y hyQ
        rcases hDvdTotal.total x y with ⟨c, rfl⟩ | ⟨c, hxc⟩
        · exact P.asIdeal.mul_mem_right c hxP
        · exfalso
          exact hxQ (hxc ▸ Q.asIdeal.mul_mem_right c hyQ)
    have hMin_of_nonempty : ∀ (T : Finset (PrimeSpectrum ↥V)), T.Nonempty →
        ∃ P₀ ∈ T, ∀ Q ∈ T, P₀.asIdeal ≤ Q.asIdeal := by
      intro T
      induction T using Finset.induction_on with
      | empty =>
        intro hne
        exact (Finset.not_nonempty_empty hne).elim
      | insert P T hPT ih =>
        intro _
        rcases T.eq_empty_or_nonempty with rfl | hTne
        · refine ⟨P, Finset.mem_singleton_self P, ?_⟩
          intro Q hQ
          rw [Finset.mem_singleton.mp hQ]
        · obtain ⟨P₀, hP₀T, hP₀min⟩ := ih hTne
          rcases hTotal P P₀ with hPP₀ | hP₀P
          · refine ⟨P, Finset.mem_insert_self P T, ?_⟩
            intro Q hQ
            rcases Finset.mem_insert.mp hQ with rfl | hQT
            · exact le_rfl
            · exact le_trans hPP₀ (hP₀min Q hQT)
          · refine ⟨P₀, Finset.mem_insert_of_mem hP₀T, ?_⟩
            intro Q hQ
            rcases Finset.mem_insert.mp hQ with rfl | hQT
            · exact hP₀P
            · exact hP₀min Q hQT
    have hExistsAway : ∃ s₀ : ↥V, IsLocalization.Away s₀ K := by
      rcases S_pos.eq_empty_or_nonempty with hEmpty | hNe
      · refine ⟨1, ?_⟩
        refine
          { map_units := by
              rintro ⟨_, k, rfl⟩
              simp
            surj := by
              intro z
              obtain ⟨a, b, hb_nzd, hab⟩ := IsFractionRing.div_surjective (A := ↥V) z
              have hb_ne : b ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hb_nzd
              have hb_unit : IsUnit b := by
                by_contra hb_nu
                have hspan_ne : Ideal.span ({b} : Set ↥V) ≠ ⊤ := by
                  rwa [ne_eq, Ideal.span_singleton_eq_top]
                obtain ⟨M, hMmax, hbM⟩ := Ideal.exists_le_maximal _ hspan_ne
                have hb_in_M : b ∈ M := hbM (Ideal.subset_span rfl)
                let Pm : PrimeSpectrum ↥V := ⟨M, hMmax.isPrime⟩
                have hPm_not : Pm ∉ S_pos := by rw [hEmpty]; simp
                have hM_bot : M = ⊥ := by
                  by_contra hne
                  exact hPm_not (Finset.mem_filter.mpr ⟨Finset.mem_univ Pm, hne⟩)
                rw [hM_bot, Ideal.mem_bot] at hb_in_M
                exact hb_ne hb_in_M
              rcases hb_unit with ⟨u, hu⟩
              refine ⟨⟨a * ↑(u⁻¹), 1⟩, ?_⟩
              have hbq : b * ↑(u⁻¹) = 1 := by rw [← hu, Units.mul_inv]
              have hbK_ne : algebraMap ↥V K b ≠ 0 := by
                intro h0
                exact hb_ne (Subtype.ext h0)
              simp only [Submonoid.coe_one, map_one, mul_one, map_mul]
              rw [← hab, div_eq_iff hbK_ne]
              calc
                algebraMap ↥V K a = algebraMap ↥V K a * 1 := (mul_one _).symm
                _ = algebraMap ↥V K a * algebraMap ↥V K (b * ↑(u⁻¹)) := by
                    rw [hbq, map_one]
                _ = algebraMap ↥V K a * algebraMap ↥V K ↑(u⁻¹) * algebraMap ↥V K b := by
                    rw [map_mul]; ring
            exists_of_eq := by
              intro x y hxy
              exact ⟨1, by simpa using Subtype.ext hxy⟩ }
      · obtain ⟨P₀, hP₀S, hP₀min⟩ := hMin_of_nonempty S_pos hNe
        have hP₀_ne_bot : P₀.asIdeal ≠ ⊥ := (Finset.mem_filter.mp hP₀S).2
        obtain ⟨s₀, hs₀_mem, hs₀_ne⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hP₀_ne_bot
        have hs₀_pow_dvd : ∀ b : ↥V, b ≠ 0 → ∃ (N : ℕ) (q : ↥V), s₀ ^ N = b * q := by
          intro b hb
          have hs₀_rad : s₀ ∈ (Ideal.span ({b} : Set ↥V)).radical := by
            rw [Ideal.radical_eq_sInf, Ideal.mem_sInf]
            rintro Q ⟨hbQ, hQprime⟩
            have hb_in_Q : b ∈ Q := hbQ (Ideal.subset_span rfl)
            have hQ_ne_bot : Q ≠ ⊥ := by
              intro hbot
              rw [hbot, Ideal.mem_bot] at hb_in_Q
              exact hb hb_in_Q
            have hQ_mem : (⟨Q, hQprime⟩ : PrimeSpectrum ↥V) ∈ S_pos :=
              Finset.mem_filter.mpr ⟨Finset.mem_univ _, hQ_ne_bot⟩
            exact hP₀min ⟨Q, hQprime⟩ hQ_mem hs₀_mem
          obtain ⟨N, hN⟩ := Ideal.mem_radical_iff.mp hs₀_rad
          obtain ⟨q, hq⟩ := Ideal.mem_span_singleton.mp hN
          exact ⟨N, q, hq⟩
        refine ⟨s₀, ?_⟩
        refine
          { map_units := by
              rintro ⟨_, k, rfl⟩
              have hpow_ne : s₀ ^ k ≠ 0 := pow_ne_zero k hs₀_ne
              have hK_ne : algebraMap ↥V K (s₀ ^ k) ≠ 0 := by
                intro h0
                exact hpow_ne (Subtype.ext h0)
              exact Ne.isUnit hK_ne
            surj := by
              intro z
              obtain ⟨a, b, hb_nzd, hab⟩ := IsFractionRing.div_surjective (A := ↥V) z
              have hb_ne : b ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hb_nzd
              obtain ⟨N, q, hN⟩ := hs₀_pow_dvd b hb_ne
              refine ⟨⟨a * q, ⟨s₀ ^ N, N, rfl⟩⟩, ?_⟩
              have hbK_ne : algebraMap ↥V K b ≠ 0 := by
                intro h0
                exact hb_ne (Subtype.ext h0)
              change z * algebraMap ↥V K (s₀ ^ N) = algebraMap ↥V K (a * q)
              rw [← hab, hN, map_mul, map_mul, div_mul_eq_mul_div, div_eq_iff hbK_ne]
              ring
            exists_of_eq := by
              intro x y hxy
              exact ⟨1, by simpa using Subtype.ext hxy⟩ }
    obtain ⟨s₀, hLocAway⟩ := hExistsAway
    have hOpen : AlgebraicGeometry.IsOpenImmersion
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V K))) :=
      @AlgebraicGeometry.IsOpenImmersion.of_isLocalization ↥V K _ _ _ s₀ hLocAway
    exact ⟨hFinSpec, hCardSpec, hOpen⟩
  
  have h_s2 : ∀ (K : Type u) [Field K] [IsSepClosed K] (V : ValuationSubring K),
      HenselianLocalRing ↥V ∧
      (∀ (a : K), a ≠ 0 → ∀ (d : ℕ), 1 ≤ d →
        ∃ (b : K) (u : ↥V), IsUnit u ∧ b ^ d * V.subtype u = a) ∧
      (∀ (P : Ideal ↥V) [P.IsPrime], P ≠ ⊥ → IsAlgClosed P.ResidueField) := by
    clear * -
    intro K _ _ V
    classical
    have hMemMaxIff : ∀ {R : Type u} [CommRing R] [IsLocalRing R] (x : R),
        x ∈ IsLocalRing.maximalIdeal R ↔ ¬ IsUnit x := by
      intro R _ _ x
      constructor
      · intro hx hu
        exact (IsLocalRing.maximalIdeal.isMaximal R).ne_top
          (Ideal.eq_top_of_isUnit_mem _ hx hu)
      · intro hnu
        have hne : Ideal.span ({x} : Set R) ≠ ⊤ := by
          rwa [ne_eq, Ideal.span_singleton_eq_top]
        obtain ⟨M, hMmax, hxM⟩ := Ideal.exists_le_maximal _ hne
        rw [← IsLocalRing.eq_maximalIdeal hMmax]
        exact hxM (Ideal.subset_span rfl)
    have hIrredForm : ∀ (n : ℕ) (f : Polynomial K),
        f.natDegree = n → f.Monic → Irreducible f →
        ∃ (q : ℕ) (β : K), 1 ≤ q ∧ (q = 1 ∨ (q : K) = 0) ∧
          f = Polynomial.X ^ q - Polynomial.C β := by
      intro n
      induction n using Nat.strongRecOn with
      | ind n ih =>
        intro f hfn hf_monic hf_irred
        let p := ringChar K
        have : CharP K p := ringChar.charP K
        rcases Polynomial.separable_or p hf_irred with hf_sep | ⟨_, g, hg_irred, hg_exp⟩
        · have hdeg1 : f.degree = 1 :=
            IsSepClosed.degree_eq_one_of_irreducible K hf_irred hf_sep
          refine ⟨1, -f.coeff 0, le_rfl, Or.inl rfl, ?_⟩
          conv_lhs => rw [Polynomial.eq_X_add_C_of_degree_eq_one hdeg1]
          rw [pow_one, hf_monic.leadingCoeff, Polynomial.C_1, one_mul, map_neg, sub_neg_eq_add]
        · have hf_pos : 0 < f.natDegree := hf_irred.natDegree_pos
          have hp_ne_zero : p ≠ 0 := by
            intro hp0
            rw [hp0, Polynomial.expand_zero] at hg_exp
            rw [← hg_exp, Polynomial.natDegree_C] at hf_pos
            omega
          have hp_prime : p.Prime :=
            (CharP.char_is_prime_or_zero K p).resolve_right hp_ne_zero
          have hp_two : 2 ≤ p := hp_prime.two_le
          have hp_pos : 0 < p := by omega
          have hg_pos : 0 < g.natDegree := hg_irred.natDegree_pos
          have hnd_exp : f.natDegree = p * g.natDegree := by
            rw [← hg_exp, Polynomial.natDegree_expand, mul_comm]
          have hg_lt : g.natDegree < n := by
            rw [← hfn, hnd_exp]
            nlinarith
          have hg_monic : g.Monic := by
            rw [Polynomial.Monic.def, ← Polynomial.leadingCoeff_expand hp_pos, hg_exp]
            exact hf_monic.leadingCoeff
          obtain ⟨q₀, β, hq₀_pos, _, hg_eq⟩ := ih g.natDegree hg_lt g rfl hg_monic hg_irred
          have hpK_zero : (p : K) = 0 := CharP.cast_eq_zero K p
          refine ⟨p * q₀, β, by nlinarith, Or.inr ?_, ?_⟩
          · push_cast
            rw [hpK_zero, zero_mul]
          · rw [← hg_exp, hg_eq, map_sub, map_pow, Polynomial.expand_X, Polynomial.expand_C,
              ← pow_mul]
    have hValFactor : ∀ (W : ValuationSubring K) (d : ℕ) (H : Polynomial ↥W),
        H.natDegree = d → H.Monic →
        ∃ (s : ℕ) (q : Fin s → ℕ) (b : Fin s → ↥W),
          (∀ r, 1 ≤ q r ∧ (q r = 1 ∨ (q r : K) = 0)) ∧
