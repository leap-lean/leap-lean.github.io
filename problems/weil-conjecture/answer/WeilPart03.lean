      rw [Submodule.eq_bot_iff]
      intro r hr
      rw [RingHom.mem_ker] at hr
      change Ideal.Quotient.mk (Ideal.span {L}) (Polynomial.C r) = 0 at hr
      rw [Ideal.Quotient.eq_zero_iff_mem] at hr
      have hr0 : (Polynomial.evalRingHom a₀) (Polynomial.C r) = 0 := hspan_le hr
      simpa using hr0
    have hX_sub : Polynomial.X - Polynomial.C a₀ ∈ Ideal.span ({L} : Set (Polynomial B)) := by
      have heq : Polynomial.C (↑u_s⁻¹ : B) * L = Polynomial.X - Polynomial.C a₀ := by
        simp only [L, mul_sub, ← mul_assoc, ← Polynomial.C_mul, ← hu_s, Units.inv_mul,
          Polynomial.C_1, one_mul, a₀]
