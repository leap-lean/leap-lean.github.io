        (∀ P : Ideal ↥O, P.IsPrime → P = ⊥ ∨ P = IsLocalRing.maximalIdeal ↥O) ∧
        IsLocalRing.maximalIdeal ↥O = Ideal.span ({⟨π, hπ⟩} : Set ↥O) ∧
        D π ≠ 0 := by
    intro E L _ _ _ O hDVR hEO hRes u₁ hu₁ S_gen hS_mem hLoc D hDu₁
    letI : IsDiscreteValuationRing ↥O := hDVR
    obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible ↥O
    let π : L := ϖ.1
    let hπ : π ∈ O := ϖ.2
    have hSpan : IsLocalRing.maximalIdeal ↥O = Ideal.span ({⟨π, hπ⟩} : Set ↥O) :=
      Irreducible.maximalIdeal_eq hϖ
    have hπ_max : (⟨π, hπ⟩ : ↥O) ∈ IsLocalRing.maximalIdeal ↥O := by
      rw [hSpan]
      exact Ideal.subset_span (Set.mem_singleton _)
    have hπ_ne : π ≠ 0 := fun h0 => hϖ.ne_zero (Subtype.ext h0)
    have hPrimes : ∀ P : Ideal ↥O, P.IsPrime → P = ⊥ ∨ P = IsLocalRing.maximalIdeal ↥O := by
      intro P hP
      by_cases hP0 : P = ⊥
      · exact Or.inl hP0
      · exact Or.inr (IsLocalRing.eq_maximalIdeal (Ring.DimensionLEOne.maximalOfPrime hP0 hP))
    refine ⟨π, hπ, hπ_max, hπ_ne, hPrimes, hSpan, ?_⟩
    have hPole : ∀ z : L, ∃ k : ℕ, π ^ k * z ∈ O := by
      intro z
      rcases O.mem_or_inv_mem z with hz | hz_inv
      · exact ⟨0, by simpa using hz⟩
      · by_cases hz0 : z = 0
        · subst hz0; exact ⟨0, by simp⟩
        · have hinv_ne : (⟨z⁻¹, hz_inv⟩ : ↥O) ≠ 0 :=
            fun h => inv_ne_zero hz0 (congrArg Subtype.val h)
          obtain ⟨k, v_assoc, hv_eq⟩ := IsDiscreteValuationRing.associated_pow_irreducible hinv_ne hϖ
          refine ⟨k, ?_⟩
          have hL_eq : z⁻¹ * (v_assoc.val : ↥O).1 = π ^ k := congrArg Subtype.val hv_eq
          have hzk : π ^ k * z = (v_assoc.val : ↥O).1 := by
            rw [← hL_eq, mul_comm z⁻¹, mul_assoc, inv_mul_cancel₀ hz0, mul_one]
          rw [hzk]
          exact (v_assoc.val : ↥O).2
    let k_pole : L → ℕ := fun b => Classical.choose (hPole (D b))
    have hk_pole : ∀ b : L, π ^ k_pole b * D b ∈ O :=
      fun b => Classical.choose_spec (hPole (D b))
    let N : ℕ := S_gen.sup k_pole
    let C_N : Subring L :=
      { carrier := { x : L | x ∈ O ∧ π ^ N * D x ∈ O }
        mul_mem' := by
          rintro a b ⟨haO, haD⟩ ⟨hbO, hbD⟩
          refine ⟨O.toSubring.mul_mem haO hbO, ?_⟩
          have hleib : π ^ N * D (a * b) = a * (π ^ N * D b) + b * (π ^ N * D a) := by
            rw [D.leibniz, smul_eq_mul, smul_eq_mul]
            ring
          rw [hleib]
          exact O.toSubring.add_mem (O.toSubring.mul_mem haO hbD) (O.toSubring.mul_mem hbO haD)
        one_mem' := ⟨O.one_mem, by simp⟩
        add_mem' := by
          rintro a b ⟨haO, haD⟩ ⟨hbO, hbD⟩
          refine ⟨O.toSubring.add_mem haO hbO, ?_⟩
          rw [map_add, mul_add]
          exact O.toSubring.add_mem haD hbD
        zero_mem' := ⟨O.zero_mem, by simp⟩
        neg_mem' := by
          rintro a ⟨haO, haD⟩
          refine ⟨O.toSubring.neg_mem haO, ?_⟩
          rw [map_neg, mul_neg]
          exact O.toSubring.neg_mem haD }
    let R_fg : Subring L := Subring.closure (Set.range (algebraMap E L) ∪ insert u₁ (S_gen : Set L))
    have hR_le : R_fg ≤ C_N := by
      rw [Subring.closure_le]
      rintro x (⟨a, rfl⟩ | hx)
      · exact ⟨hEO a, by rw [D.map_algebraMap, mul_zero]; exact O.zero_mem⟩
      · rcases Set.mem_insert_iff.mp hx with rfl | hxS
        · exact ⟨hu₁, by rw [hDu₁, mul_one]; exact O.toSubring.pow_mem hπ N⟩
        · refine ⟨hS_mem x hxS, ?_⟩
          have hle : k_pole x ≤ N := Finset.le_sup (Finset.mem_coe.mp hxS)
          have hpow : π ^ N * D x = π ^ (N - k_pole x) * (π ^ k_pole x * D x) := by
            rw [← mul_assoc, ← pow_add, Nat.sub_add_cancel hle]
          rw [hpow]
          exact O.toSubring.mul_mem (O.toSubring.pow_mem hπ _) (hk_pole x)
    have hBoundO : ∀ w : L, w ∈ O → π ^ N * D w ∈ O := by
      intro w hw
      obtain ⟨s, hs, hs_unit, hs_R, hsw_R⟩ := hLoc w hw
      obtain ⟨u_s, hu_s⟩ := hs_unit
      have hs_val : (u_s.val : ↥O).1 = s := congrArg Subtype.val hu_s
      have hs_mul : s * (↑u_s⁻¹ : ↥O).1 = 1 := by
        have h1 : (u_s.val : ↥O).1 * (↑u_s⁻¹ : ↥O).1 = 1 := congrArg Subtype.val u_s.val_inv
        rwa [hs_val] at h1
      have hs_ne : s ≠ 0 := left_ne_zero_of_mul_eq_one hs_mul
      have hsinv_O : s⁻¹ ∈ O := by
        rw [inv_eq_of_mul_eq_one_right hs_mul]
        exact (↑u_s⁻¹ : ↥O).2
      have hs_D : π ^ N * D s ∈ O := (hR_le hs_R).2
      have hsw_D : π ^ N * D (s * w) ∈ O := (hR_le hsw_R).2
      have hleib : π ^ N * D w = s⁻¹ * (π ^ N * D (s * w) - w * (π ^ N * D s)) := by
        rw [D.leibniz, smul_eq_mul, smul_eq_mul]
        have : s * (π ^ N * D w) = π ^ N * (s * D w + w * D s) - w * (π ^ N * D s) := by ring
        rw [← this, inv_mul_cancel_left₀ hs_ne]
      rw [hleib]
      exact O.toSubring.mul_mem hsinv_O (O.toSubring.sub_mem hsw_D (O.toSubring.mul_mem hw hs_D))
    intro hDπ0
    let K_D : Subring L :=
      { carrier := { x : L | D x = 0 }
        mul_mem' := fun {a b} ha hb => by change D (a * b) = 0; rw [D.leibniz, ha, hb, smul_zero, smul_zero, add_zero]
        one_mem' := D.map_one_eq_zero
        add_mem' := fun {a b} ha hb => by change D (a + b) = 0; rw [map_add, ha, hb, add_zero]
        zero_mem' := map_zero D
        neg_mem' := fun {a} ha => by change D (-a) = 0; rw [map_neg, ha, neg_zero] }
    have hTaylor : ∀ (m : ℕ) (w : L), w ∈ O →
        ∃ u ∈ K_D, ∃ w_m ∈ O, w = u + π ^ m * w_m := by
      intro m
      induction m with
      | zero =>
        intro w hw
        exact ⟨0, K_D.zero_mem, w, hw, by simp⟩
      | succ m ih =>
        intro w hw
        obtain ⟨u, huK, w_m, hwm, rfl⟩ := ih w hw
        obtain ⟨c, hc⟩ := hRes w_m hwm
        set d : L := w_m - algebraMap E L c
        have hdO : d ∈ O := O.toSubring.sub_mem hwm (hEO c)
        have hd_max : (⟨d, hdO⟩ : ↥O) ∈ IsLocalRing.maximalIdeal ↥O := by
          rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
          rintro ⟨v_u, hv_u⟩
          have hm : d * (↑v_u⁻¹ : ↥O).1 = 1 := by
            have h1 : (v_u.val : ↥O).1 * (↑v_u⁻¹ : ↥O).1 = 1 := congrArg Subtype.val v_u.val_inv
            have h2 : (v_u.val : ↥O).1 = d := congrArg Subtype.val hv_u
            rwa [h2] at h1
          have hd_ne : d ≠ 0 := left_ne_zero_of_mul_eq_one hm
          have hd_inv : d⁻¹ ∈ O := by
            rw [inv_eq_of_mul_eq_one_right hm]
            exact (↑v_u⁻¹ : ↥O).2
          exact hc.elim hd_ne (fun h => h hd_inv)
        rw [hSpan, Ideal.mem_span_singleton] at hd_max
        obtain ⟨q_O, hq_O⟩ := hd_max
        have hwm_eq : w_m = algebraMap E L c + π * q_O.1 := by
          have hval : d = π * q_O.1 := congrArg Subtype.val hq_O
          dsimp [d] at hval
          linear_combination hval
        have hcK : algebraMap E L c ∈ K_D := D.map_algebraMap c
        have hπK : π ∈ K_D := hDπ0
        refine ⟨u + algebraMap E L c * π ^ m,
          K_D.add_mem huK (K_D.mul_mem hcK (K_D.pow_mem hπK m)),
          q_O.1, q_O.2, ?_⟩
        rw [hwm_eq]
        ring
    obtain ⟨u, huK, w_N, hw_N, hu₁_eq⟩ := hTaylor (N + 1) u₁ hu₁
    have hπ_pow0 : D (π ^ (N + 1)) = 0 := K_D.pow_mem hDπ0 (N + 1)
    have h1_eq : (1 : L) = π * (π ^ N * D w_N) := by
      have hD_rhs := congrArg D hu₁_eq
      rw [hDu₁, map_add, (huK : D u = 0), zero_add, D.leibniz, hπ_pow0, smul_zero, add_zero,
        smul_eq_mul, pow_succ', mul_assoc] at hD_rhs
      exact hD_rhs
    have hzO : π ^ N * D w_N ∈ O := hBoundO w_N hw_N
    have h1_O : (1 : ↥O) = ⟨π, hπ⟩ * ⟨π ^ N * D w_N, hzO⟩ := Subtype.ext h1_eq
    have h1_max : (1 : ↥O) ∈ IsLocalRing.maximalIdeal ↥O := by
      rw [h1_O]
      exact Ideal.mul_mem_right _ _ hπ_max
    exact (IsLocalRing.maximalIdeal.isMaximal ↥O).ne_top
      (Ideal.eq_top_of_isUnit_mem _ h1_max isUnit_one)
  have hConjunct2 : ∀ (E L : Type u) [Field E] [IsAlgClosed E] [Field L] [Algebra E L] (z₀ : L),
