        have hn_pos : 1 ≤ n := Int.natAbs_pos.mpr hm
        by_cases hm_nonneg : 0 ≤ m
        · have hm_eq : m = (n : ℤ) := (Int.natAbs_of_nonneg hm_nonneg).symm
          rw [hm_eq, zpow_natCast, norm_pow] at heq
          obtain ⟨d, hd⟩ := hPowRoot n hn_pos c
          have hd_pow : ‖d‖ ^ n = ‖S‖ ^ n := by rw [← norm_pow, hd, heq]
          have hd_eq : ‖S‖ = ‖d‖ :=
