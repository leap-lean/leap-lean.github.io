        exact K_x_alg.div_mem (hPolyMem A) (hPolyMem B)
    have hValLx : ∀ u ∈ Lx, u ≠ 0 → ∃ c : K_hat, ‖u‖ = ‖c‖ := by
      intro u hu_Lx hu_ne
      have hu_pos : 0 < ‖u‖ := norm_pos_iff.mpr hu_ne
      have hu_cl : u ∈ closure (K_x_alg : Set F_hat) := hu_Lx
      obtain ⟨y, hy_mem, hy_dist⟩ := Metric.mem_closure_iff.mp hu_cl ‖u‖ hu_pos
      rw [dist_eq_norm] at hy_dist
      have h_norm_eq : ‖u‖ = ‖y‖ := by
        have hle : ‖u‖ ≤ ‖y‖ := by
          by_contra hlt
          push Not at hlt
          have h1 : ‖u‖ ≤ max ‖u - y‖ ‖y‖ := by
            simpa using IsUltrametricDist.norm_add_le_max (u - y) y
          have h2 : max ‖u - y‖ ‖y‖ < ‖u‖ := max_lt hy_dist hlt
          linarith
        have hge : ‖y‖ ≤ ‖u‖ := by
          have h_eq : y = u + (-(u - y)) := by ring
          rw [h_eq]
          exact (IsUltrametricDist.norm_add_le_max _ _).trans
            (max_le (le_refl _) (by rw [norm_neg]; exact hy_dist.le))
        exact le_antisymm hle hge
      have hy_ne : y ≠ 0 := by
        intro h0
        rw [h0, norm_zero] at h_norm_eq
        linarith
      rw [hKx_alg_eq] at hy_mem
      obtain ⟨A, B, hB, rfl⟩ := hy_mem
      have hA : A ≠ 0 := by
        intro h0
        simp [h0] at hy_ne
      obtain ⟨cA, _, _, _, hA_norm, _, _⟩ := hGaussK A hA
      obtain ⟨cB, _, _, _, hB_norm, _, _⟩ := hGaussK B hB
      refine ⟨cA / cB, ?_⟩
      rw [h_norm_eq, norm_div, hA_norm, hB_norm, norm_div]
    have hValEq : ∀ w : F_hat, w ≠ 0 → ∃ c : K_hat, ‖w‖ = ‖c‖ := by
      intro w hw_ne
      have hInt : _root_.IsIntegral ↥Lx w := Algebra.IsIntegral.isIntegral w
      let M : Polynomial ↥Lx := minpoly ↥Lx w
      have hM_monic : M.Monic := minpoly.monic hInt
      have hd_pos : 0 < M.natDegree := minpoly.natDegree_pos hInt
      let d := M.natDegree
      let t : ℕ → F_hat := fun j => ((M.coeff j : ↥Lx) : F_hat) * w ^ j
      have hM_sum : ∑ j ∈ M.support, t j = 0 := by
        have h1 := minpoly.aeval ↥Lx w
        rw [Polynomial.aeval_def, Polynomial.eval₂_eq_sum, Polynomial.sum_def] at h1
        exact h1
      have hd_mem : d ∈ M.support := by
        rw [Polynomial.mem_support_iff]
        exact hM_monic.coeff_natDegree.symm ▸ one_ne_zero
      have htd_pos : 0 < ‖t d‖ := by
        dsimp [t]
        rw [hM_monic.coeff_natDegree]
        simp [pow_pos (norm_pos_iff.mpr hw_ne)]
      obtain ⟨j₁, hj₁_mem, hj₁_max⟩ :=
        Finset.exists_max_image M.support (fun j => ‖t j‖) ⟨d, hd_mem⟩
      have htj₁_pos : 0 < ‖t j₁‖ := htd_pos.trans_le (hj₁_max d hd_mem)
      have hExTie : ∃ j₂ ∈ M.support.erase j₁, ‖t j₁‖ ≤ ‖t j₂‖ := by
        by_contra hAllLt
        push Not at hAllLt
        have h_eq : t j₁ = - ∑ j ∈ M.support.erase j₁, t j := by
          have h1 := Finset.add_sum_erase M.support t hj₁_mem
          rw [hM_sum] at h1
          exact eq_neg_of_add_eq_zero_left h1
        by_cases hErase : (M.support.erase j₁).Nonempty
        · obtain ⟨jm, hjm_mem, hjm_max⟩ :=
            Finset.exists_max_image (M.support.erase j₁) (fun j => ‖t j‖) hErase
          have hsum_le : ‖∑ j ∈ M.support.erase j₁, t j‖ ≤ ‖t jm‖ :=
            hSumNormLe _ _ ‖t jm‖ (norm_nonneg _) hjm_max
          have hlt : ‖t jm‖ < ‖t j₁‖ := hAllLt jm hjm_mem
          have h1 : ‖t j₁‖ ≤ ‖t jm‖ := by
            rw [h_eq, norm_neg]
            exact hsum_le
          linarith
        · rw [Finset.not_nonempty_iff_eq_empty] at hErase
          rw [hErase, Finset.sum_empty, neg_zero] at h_eq
          rw [h_eq, norm_zero] at htj₁_pos
          linarith
      obtain ⟨j₂, hj₂_erase, hj₂_ge⟩ := hExTie
      have hj₂_ne : j₂ ≠ j₁ := (Finset.mem_erase.mp hj₂_erase).1
      have hj₂_mem : j₂ ∈ M.support := (Finset.mem_erase.mp hj₂_erase).2
      have htie : ‖t j₁‖ = ‖t j₂‖ := le_antisymm hj₂_ge (hj₁_max j₂ hj₂_mem)
      let i₁ := min j₁ j₂
      let i₂ := max j₁ j₂
      have hi₁₂_lt : i₁ < i₂ := min_lt_max.mpr hj₂_ne.symm
      have hi_tie : ‖t i₁‖ = ‖t i₂‖ ∧ i₁ ∈ M.support ∧ i₂ ∈ M.support := by
        by_cases hle : j₁ ≤ j₂
        · simp [i₁, i₂, min_eq_left hle, max_eq_right hle, htie, hj₁_mem, hj₂_mem]
        · have hle' : j₂ ≤ j₁ := le_of_not_ge hle
          simp [i₁, i₂, min_eq_right hle', max_eq_left hle', htie.symm, hj₁_mem, hj₂_mem]
      let k := i₂ - i₁
      have hk_pos : 0 < k := Nat.sub_pos_of_lt hi₁₂_lt
      have hi₂_eq : i₂ = i₁ + k := (Nat.add_sub_of_le hi₁₂_lt.le).symm
      have hc₁_ne : M.coeff i₁ ≠ 0 := Polynomial.mem_support_iff.mp hi_tie.2.1
      have hc₂_ne : M.coeff i₂ ≠ 0 := Polynomial.mem_support_iff.mp hi_tie.2.2
      have hc₂_pos : 0 < ‖((M.coeff i₂ : ↥Lx) : F_hat)‖ :=
        norm_pos_iff.mpr fun h0 => hc₂_ne (Subtype.ext h0)
      have hw_i₁_pos : 0 < ‖w‖ ^ i₁ := pow_pos (norm_pos_iff.mpr hw_ne) i₁
      have hwk_eq : ‖w‖ ^ k = ‖((M.coeff i₁ / M.coeff i₂ : ↥Lx) : F_hat)‖ := by
        have h1 : ‖((M.coeff i₁ : ↥Lx) : F_hat)‖ * ‖w‖ ^ i₁ =
            ‖((M.coeff i₂ : ↥Lx) : F_hat)‖ * (‖w‖ ^ i₁ * ‖w‖ ^ k) := by
          have ht := hi_tie.1
          dsimp [t] at ht
          rw [hi₂_eq, pow_add, norm_mul, norm_mul, norm_mul, norm_pow, norm_pow, ← hi₂_eq] at ht
          exact ht
        have h2 : ‖((M.coeff i₁ : ↥Lx) : F_hat)‖ = ‖((M.coeff i₂ : ↥Lx) : F_hat)‖ * ‖w‖ ^ k := by
          nlinarith
        rw [Subfield.coe_div, norm_div, eq_div_iff hc₂_pos.ne']
        linarith
      have hdiv_ne : ((M.coeff i₁ / M.coeff i₂ : ↥Lx) : F_hat) ≠ 0 := by
        rw [Subfield.coe_div]
        exact div_ne_zero (fun h0 => hc₁_ne (Subtype.ext h0)) (fun h0 => hc₂_ne (Subtype.ext h0))
      obtain ⟨c₁, hc₁_norm⟩ := hValLx _ (M.coeff i₁ / M.coeff i₂).2 hdiv_ne
      obtain ⟨c, hc_pow⟩ := IsAlgClosed.exists_pow_nat_eq c₁ hk_pos
      refine ⟨c, ?_⟩
      have hpow_eq : ‖w‖ ^ k = ‖c‖ ^ k := by
        rw [hwk_eq, hc₁_norm, ← hc_pow, norm_pow]
      exact (pow_left_inj₀ (norm_nonneg w) (norm_nonneg c) hk_pos.ne').mp hpow_eq
    have hResPolyOK : ∀ Q : Polynomial K_hat, (∀ i : ℕ, Q.coeff i ∈ OK) →
        ∃ hQ_OF : Polynomial.aeval x Q ∈ OF,
          IsLocalRing.residue ↥OF ⟨Polynomial.aeval x Q, hQ_OF⟩ ∈ Kx_res := by
      intro Q hQ_OK
      let Q_OK : Polynomial ↥OK := ∑ i ∈ Q.support, Polynomial.monomial i ⟨Q.coeff i, hQ_OK i⟩
      have hQ_map : Q_OK.map OK.subtype = Q := by
        apply Polynomial.ext
        intro i
        rw [Polynomial.coeff_map]
        dsimp [Q_OK]
        rw [Polynomial.finsetSum_coeff]
        simp only [Polynomial.coeff_monomial]
        by_cases hi : i ∈ Q.support
        · rw [Finset.sum_eq_single i]
          · simp
          · intro b _ hb; simp [hb]
          · intro hm; exact absurd hi hm
        · rw [Finset.sum_eq_zero, Polynomial.notMem_support_iff.mp hi]
          · rfl
          · intro b hb
            have hne : b ≠ i := fun h => hi (h ▸ hb)
            simp [hne]
      let q_val : ↥OF := Polynomial.eval₂ ι_OK_OF ⟨x, hx⟩ Q_OK
      have hq_coe : (q_val : F_hat) = Polynomial.aeval x Q := by
        have h1 := Polynomial.hom_eval₂ Q_OK ι_OK_OF OF.subtype ⟨x, hx⟩
        change (q_val : F_hat) = _ at h1
        rw [h1, ← hQ_map, Polynomial.aeval_def, Polynomial.eval₂_map]
        rfl
      refine ⟨hq_coe ▸ q_val.2, ?_⟩
      have hq_eq : (⟨Polynomial.aeval x Q, hq_coe ▸ q_val.2⟩ : ↥OF) = q_val :=
        Subtype.ext hq_coe.symm
      rw [hq_eq]
      dsimp [q_val]
      rw [Polynomial.hom_eval₂]
      change Polynomial.eval₂ κ_hom x_res Q_OK ∈ Kx_res
      rw [Polynomial.eval₂_eq_sum, Polynomial.sum_def]
      refine Kx_res.sum_mem fun i _ => Kx_res.mul_mem ?_ ?_
      · exact Subfield.subset_closure (Or.inl ⟨Q_OK.coeff i, rfl⟩)
      · exact Kx_res.pow_mem (Subfield.subset_closure (Or.inr rfl)) i
    have hResLx : ∀ (b : F_hat) (hb_Lx : b ∈ Lx) (hb_OF : b ∈ OF),
        IsLocalRing.residue ↥OF ⟨b, hb_OF⟩ ∈ Kx_res := by
      intro b hb_Lx hb_OF
      by_cases hlt : ‖b‖ < 1
      · rw [(hResZero ⟨b, hb_OF⟩).mpr hlt]
        exact Kx_res.zero_mem
      · have hb_norm : ‖b‖ = 1 := le_antisymm ((hMemOF b).mp hb_OF) (not_lt.mp hlt)
        obtain ⟨y, hy_mem, hy_dist⟩ := Metric.mem_closure_iff.mp hb_Lx 1 zero_lt_one
        rw [dist_eq_norm] at hy_dist
        have hy_le : ‖y‖ ≤ 1 := by
          have h_eq : y = b + (-(b - y)) := by ring
          rw [h_eq]
          exact (IsUltrametricDist.norm_add_le_max _ _).trans
            (max_le hb_norm.le (by rw [norm_neg]; exact hy_dist.le))
        have hy_ge : 1 ≤ ‖y‖ := by
          by_contra hy_lt
          push Not at hy_lt
          have h_eq : b = (b - y) + y := by ring
          have h1 : ‖b‖ < 1 := by
            rw [h_eq]
            exact (IsUltrametricDist.norm_add_le_max _ _).trans_lt (max_lt hy_dist hy_lt)
          linarith [hb_norm]
        have hy_norm : ‖y‖ = 1 := le_antisymm hy_le hy_ge
        have hy_OF : y ∈ OF := (hMemOF y).mpr hy_le
        have hres_eq : IsLocalRing.residue ↥OF ⟨b, hb_OF⟩ = IsLocalRing.residue ↥OF ⟨y, hy_OF⟩ := by
          have hdiff : IsLocalRing.residue ↥OF (⟨b, hb_OF⟩ - ⟨y, hy_OF⟩) = 0 :=
            (hResZero _).mpr hy_dist
          rw [map_sub] at hdiff
          exact sub_eq_zero.mp hdiff
        rw [hres_eq]
        change y ∈ K_x_alg at hy_mem
        rw [hKx_alg_eq] at hy_mem
        obtain ⟨A, B, hB, hy_frac⟩ := hy_mem
        have hA : A ≠ 0 := by
          intro h0
          rw [hy_frac, h0, map_zero, zero_div, norm_zero] at hy_norm
          norm_num at hy_norm
        obtain ⟨cA, hcA_ne, _, _, hA_norm, hQA_norm, hQA_OK⟩ := hGaussK A hA
        obtain ⟨cB, hcB_ne, _, _, hB_norm, hQB_norm, hQB_OK⟩ := hGaussK B hB
        let QA := Polynomial.C cA⁻¹ * A
        let QB := Polynomial.C cB⁻¹ * B
        let c₀ : K_hat := cA / cB
        have hc₀_norm : ‖c₀‖ = 1 := by
          dsimp [c₀]
          rw [norm_div, ← hA_norm, ← hB_norm, ← norm_div, ← hy_frac, hy_norm]
        have hc₀_OK : c₀ ∈ OK := (hMemOK c₀).mpr hc₀_norm.le
        obtain ⟨hQA_OF, hQA_res⟩ := hResPolyOK QA hQA_OK
        obtain ⟨hQB_OF, hQB_res⟩ := hResPolyOK QB hQB_OK
        have hQB_val_ne : Polynomial.aeval x QB ≠ 0 := by
          intro h0
          rw [h0, norm_zero] at hQB_norm
          norm_num at hQB_norm
        have hQB_inv_OF : (Polynomial.aeval x QB)⁻¹ ∈ OF := by
          rw [hMemOF, norm_inv, hQB_norm, inv_one]
        have hy_prod : (⟨y, hy_OF⟩ : ↥OF) =
            ⟨algebraMap K_hat F_hat c₀, hc₀_OK⟩ * ⟨Polynomial.aeval x QA, hQA_OF⟩ *
              ⟨(Polynomial.aeval x QB)⁻¹, hQB_inv_OF⟩ := by
          apply Subtype.ext
          change y = algebraMap K_hat F_hat (cA / cB) * Polynomial.aeval x QA * (Polynomial.aeval x QB)⁻¹
          have hA_eq : Polynomial.aeval x A = algebraMap K_hat F_hat cA * Polynomial.aeval x QA := by
            dsimp [QA]
            rw [map_mul, Polynomial.aeval_C, ← mul_assoc, ← map_mul, mul_inv_cancel₀ hcA_ne, map_one, one_mul]
          have hB_eq : Polynomial.aeval x B = algebraMap K_hat F_hat cB * Polynomial.aeval x QB := by
            dsimp [QB]
            rw [map_mul, Polynomial.aeval_C, ← mul_assoc, ← map_mul, mul_inv_cancel₀ hcB_ne, map_one, one_mul]
          have hcB_map_ne : algebraMap K_hat F_hat cB ≠ 0 := by
            simpa using (RingHom.injective (algebraMap K_hat F_hat)).ne hcB_ne
          rw [hy_frac, hA_eq, hB_eq, map_div₀]
          field_simp [hcB_map_ne, hQB_val_ne]
        rw [hy_prod, map_mul, map_mul]
        refine Kx_res.mul_mem (Kx_res.mul_mem ?_ hQA_res) ?_
        · exact Subfield.subset_closure (Or.inl ⟨⟨c₀, hc₀_OK⟩, rfl⟩)
        · have hmul1 : IsLocalRing.residue ↥OF ⟨Polynomial.aeval x QB, hQB_OF⟩ *
              IsLocalRing.residue ↥OF ⟨(Polynomial.aeval x QB)⁻¹, hQB_inv_OF⟩ = 1 := by
            rw [← map_mul]
            convert map_one (IsLocalRing.residue ↥OF)
            exact Subtype.ext (mul_inv_cancel₀ hQB_val_ne)
          rw [← inv_eq_of_mul_eq_one_right hmul1]
          exact Kx_res.inv_mem hQB_res
    have hOrtho : ∀ (n : ℕ) (v : Fin n → ↥OF),
        LinearIndependent ↥Kx_res (fun i => IsLocalRing.residue ↥OF (v i)) →
        ∀ (a : Fin n → ↥Lx) (j : Fin n),
          ‖(a j : F_hat)‖ ≤ ‖∑ i : Fin n, (a i : F_hat) * ((v i : ↥OF) : F_hat)‖ := by
      intro n v hInd a j
      by_cases haj : a j = 0
      · rw [haj]
        simp
      · obtain ⟨i₀, _, hi₀_max⟩ :=
          Finset.exists_max_image (Finset.univ : Finset (Fin n))
            (fun i => ‖(a i : F_hat)‖) ⟨j, Finset.mem_univ j⟩
        have haj_le : ‖(a j : F_hat)‖ ≤ ‖(a i₀ : F_hat)‖ := hi₀_max j (Finset.mem_univ j)
        have hai₀_pos : 0 < ‖(a i₀ : F_hat)‖ :=
          (norm_pos_iff.mpr fun h0 => haj (Subtype.ext h0)).trans_le haj_le
        have hai₀_ne : (a i₀ : F_hat) ≠ 0 := norm_pos_iff.mp hai₀_pos
        let b : Fin n → ↥Lx := fun i => a i / a i₀
        have hb_OF : ∀ i : Fin n, (b i : F_hat) ∈ OF := by
          intro i
          rw [hMemOF]
          dsimp [b]
          rw [norm_div]
          exact (div_le_one hai₀_pos).mpr (hi₀_max i (Finset.mem_univ i))
        let S_OF : ↥OF := ∑ i : Fin n, ⟨(b i : F_hat), hb_OF i⟩ * v i
        let r : Fin n → ↥Kx_res :=
          fun i => ⟨IsLocalRing.residue ↥OF ⟨(b i : F_hat), hb_OF i⟩, hResLx _ (b i).2 (hb_OF i)⟩
        have hr_i₀ : r i₀ = 1 := by
          apply Subtype.ext
          change IsLocalRing.residue ↥OF ⟨((a i₀ / a i₀ : ↥Lx) : F_hat), _⟩ = 1
          have hb1 : ((a i₀ / a i₀ : ↥Lx) : F_hat) = 1 := by
            rw [Subfield.coe_div]
            exact div_self hai₀_ne
          have hsub1 : (⟨((a i₀ / a i₀ : ↥Lx) : F_hat), hb_OF i₀⟩ : ↥OF) = 1 :=
            Subtype.ext hb1
          rw [hsub1, map_one]
        have hS_res_ne : IsLocalRing.residue ↥OF S_OF ≠ 0 := by
          have hS_res : IsLocalRing.residue ↥OF S_OF =
              ∑ i : Fin n, r i • IsLocalRing.residue ↥OF (v i) := by
            dsimp [S_OF]
            rw [map_sum]
            refine Finset.sum_congr rfl fun i _ => ?_
            rw [map_mul]
            rfl
          rw [hS_res]
          intro hsum0
          have hri0 := Fintype.linearIndependent_iff.mp hInd r hsum0 i₀
          rw [hr_i₀] at hri0
          exact one_ne_zero hri0
        have hS_norm : ‖(S_OF : F_hat)‖ = 1 := by
          have hle : ‖(S_OF : F_hat)‖ ≤ 1 := (hMemOF S_OF.1).mp S_OF.2
          have hge : 1 ≤ ‖(S_OF : F_hat)‖ :=
            not_lt.mp fun hlt => hS_res_ne ((hResZero S_OF).mpr hlt)
          exact le_antisymm hle hge
        have hsum_eq : ∑ i : Fin n, (a i : F_hat) * ((v i : ↥OF) : F_hat) =
            (a i₀ : F_hat) * (S_OF : F_hat) := by
          have hcoe : (S_OF : F_hat) = ∑ i : Fin n, (b i : F_hat) * ((v i : ↥OF) : F_hat) := by
            dsimp [S_OF]
            push_cast
            rfl
          rw [hcoe, Finset.mul_sum]
          refine Finset.sum_congr rfl fun i _ => ?_
          dsimp [b]
          rw [← mul_assoc, mul_div_cancel₀ _ hai₀_ne]
        rw [hsum_eq, norm_mul, hS_norm, mul_one]
        exact haj_le
    have hFinKx : FiniteDimensional ↥Kx_res κF := by
      by_contra hInf
      have hExInd : ∀ k : ℕ, ∃ w : Fin k → κF, LinearIndependent ↥Kx_res w := by
        intro k
        induction k with
        | zero => exact ⟨Fin.elim0, linearIndependent_empty_type⟩
        | succ k ih =>
          obtain ⟨w, hw⟩ := ih
          have hNotSpan : ¬ ⊤ ≤ Submodule.span ↥Kx_res (Set.range w) := by
            intro hSpan
            exact hInf (Module.Finite.of_basis (Module.Basis.mk hw hSpan))
          have hExNew : ∃ w₀ : κF, w₀ ∉ Submodule.span ↥Kx_res (Set.range w) := by
            by_contra hAll
            push Not at hAll
            exact hNotSpan fun y _ => hAll y
          obtain ⟨w₀, hw₀⟩ := hExNew
          exact ⟨Fin.cons w₀ w, linearIndependent_finCons.mpr ⟨hw, hw₀⟩⟩
      let N := Module.finrank ↥Lx F_hat
      obtain ⟨w, hw_ind⟩ := hExInd (N + 1)
      choose v hv using fun i : Fin (N + 1) => IsLocalRing.residue_surjective (R := ↥OF) (w i)
      have hv_ind_res : LinearIndependent ↥Kx_res (fun i => IsLocalRing.residue ↥OF (v i)) := by
        simpa [hv] using hw_ind
      have hv_ind_Lx : LinearIndependent ↥Lx (fun i : Fin (N + 1) => ((v i : ↥OF) : F_hat)) := by
        rw [Fintype.linearIndependent_iff]
        intro a ha j
        have ha_sum : ∑ i : Fin (N + 1), (a i : F_hat) * ((v i : ↥OF) : F_hat) = 0 := ha
        have hle0 : ‖(a j : F_hat)‖ ≤ 0 := by
          have h1 := hOrtho (N + 1) v hv_ind_res a j
          rw [ha_sum, norm_zero] at h1
          exact h1
        have h0 : (a j : F_hat) = 0 := norm_eq_zero.mp (le_antisymm hle0 (norm_nonneg _))
        exact Subtype.ext h0
      have hcard := hv_ind_Lx.fintype_card_le_finrank
      rw [Fintype.card_fin] at hcard
      omega
    exact ⟨hGaussE, hValEq, hOrtho, hFinKx⟩
  
  have hs4_lift : ∀ (E_max : Subfield K_hat)
      (_ : ∀ c ∈ E_max, ‖c‖ ≤ 1)
      (_ : ∀ c : K_hat, ‖c‖ ≤ 1 → ∃ e ∈ E_max, ‖c - e‖ < 1),
      let OF : ValuationSubring F_hat := (NormedField.valuation (K := F_hat)).valuationSubring
      let OK : ValuationSubring K_hat := OF.comap (algebraMap K_hat F_hat)
      let κF := IsLocalRing.ResidueField ↥OF
      let κ_hom : ↥OK →+* κF :=
