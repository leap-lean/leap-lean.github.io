                  · exfalso; exact Bool.false_ne_true (Finset.mem_filter.mp hi).2
                  · rcases n with _ | k
                    · exact ⟨u, ⟨some (0, u), hi, Finset.mem_singleton_self u⟩, rfl⟩
                    · exfalso; exact Bool.false_ne_true (Finset.mem_filter.mp hi).2
                · rintro ⟨u, ⟨j, hj, hu_in⟩, rfl⟩
                  rcases j with _ | ⟨n, u'⟩
                  · simp at hu_in
