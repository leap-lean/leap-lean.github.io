      have h2 : CommRingCat.ofHom φ_UL = φ_U ≫ CommRingCat.ofHom res_W := rfl
      dsimp only [ι_D]
      rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp, h1,
        AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc, hφss_spec]
      dsimp only [ψ_ss]
      rw [h2, AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc,
