                    · simp at hu_in
              have hemb0_inj : Function.Injective emb0 := fun u₁ u₂ h => by injection h with h'; injection h'
              rw [hS₀_img, Finset.sum_image (fun x _ y _ h => hemb0_inj h)] at hu_zero
              have hu_zero' : ∑ u ∈ U_fin, g (emb0 u) • (u : ↥L1_coeff) = 0 := by
                simpa [emb0, fam] using hu_zero
              have hli := (linearIndependent_iff'.mp hLI_U₀) U_fin (fun u => g (emb0 u)) hu_zero'
              intro i hi
              rw [hS₀_img] at hi
              rcases Finset.mem_image.mp hi with ⟨u, hu, rfl⟩
              exact hli u hu
