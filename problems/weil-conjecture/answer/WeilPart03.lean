            have hzV : z ∈ V := (V.mem_or_inv_mem z).resolve_right hz_inv_not_V
            let zV : ↥V := ⟨z, hzV⟩
            have hzV_max : zV ∈ IsLocalRing.maximalIdeal ↥V := by
              rw [hMemMaxIff]
              rintro ⟨u, hu⟩
              have hmul : z * ((↑(u⁻¹) : ↥V) : K) = 1 := by
                have hm := congrArg Subtype.val (Units.mul_inv u)
                simpa [hu, zV] using hm
              have hz_inv_eq : ((↑(u⁻¹) : ↥V) : K) = z⁻¹ := by
                calc
                  ((↑(u⁻¹) : ↥V) : K) = z⁻¹ * (z * ((↑(u⁻¹) : ↥V) : K)) := by
                    rw [← mul_assoc, inv_mul_cancel₀ hz_ne, one_mul]
                  _ = z⁻¹ := by rw [hmul, mul_one]
              exact hz_inv_not_V (hz_inv_eq ▸ (↑(u⁻¹) : ↥V).2)
            let u : ↥V := 1 + zV
            have hu_unit : IsUnit u := by
              by_contra hnu
              have hu_max : u ∈ IsLocalRing.maximalIdeal ↥V := (hMemMaxIff u).mpr hnu
              have h1_max : (1 : ↥V) ∈ IsLocalRing.maximalIdeal ↥V := by
                have hsub : u - zV = 1 := add_sub_cancel_right 1 zV
                rw [← hsub]
                exact (IsLocalRing.maximalIdeal ↥V).sub_mem hu_max hzV_max
              exact (IsLocalRing.maximalIdeal.isMaximal ↥V).ne_top
                ((Ideal.eq_top_iff_one _).mpr h1_max)
            refine ⟨b, u, hu_unit, ?_⟩
            change b ^ ℓ * (1 + δ / b ^ (ℓ - 1)) = a
            have hb_pow_split : b ^ ℓ = b ^ (ℓ - 1) * b := by
              rw [← pow_succ, Nat.sub_add_cancel (by omega)]
            have hbp1_ne : b ^ (ℓ - 1) ≠ 0 := pow_ne_zero _ hb_ne
            calc
              b ^ ℓ * (1 + δ / b ^ (ℓ - 1))
                = b ^ ℓ + b ^ (ℓ - 1) * b * (δ / b ^ (ℓ - 1)) := by
                    rw [mul_add, mul_one, ← hb_pow_split]
              _ = b ^ ℓ + b * (b ^ (ℓ - 1) * (δ / b ^ (ℓ - 1))) := by ring
              _ = b ^ ℓ + δ * b := by rw [mul_div_cancel₀ _ hbp1_ne, mul_comm b δ]
              _ = a := hb_eq
          intro a ha
          by_cases haV : a ∈ V
          · exact hIntCase a ha haV
          · have hainvV : a⁻¹ ∈ V := (V.mem_or_inv_mem a).resolve_left haV
            obtain ⟨b₀, u₀, hu₀, hb₀⟩ := hIntCase a⁻¹ (inv_ne_zero ha) hainvV
            have hb₀_ne : b₀ ≠ 0 := by
              rintro rfl
              rw [zero_pow (by omega), zero_mul] at hb₀
              exact inv_ne_zero ha hb₀.symm
            rcases hu₀ with ⟨u_unit, rfl⟩
            refine ⟨b₀⁻¹, ↑(u_unit⁻¹), Units.isUnit _, ?_⟩
            have hu_mul : V.subtype ↑u_unit * V.subtype ↑(u_unit⁻¹) = 1 := by
              rw [← map_mul, Units.mul_inv, map_one]
            have hprod : (b₀⁻¹ ^ ℓ * V.subtype ↑(u_unit⁻¹)) * (b₀ ^ ℓ * V.subtype ↑u_unit) = 1 := by
              calc
                (b₀⁻¹ ^ ℓ * V.subtype ↑(u_unit⁻¹)) * (b₀ ^ ℓ * V.subtype ↑u_unit)
                  = (b₀⁻¹ * b₀) ^ ℓ * (V.subtype ↑u_unit * V.subtype ↑(u_unit⁻¹)) := by ring
                _ = 1 := by rw [inv_mul_cancel₀ hb₀_ne, one_pow, hu_mul, mul_one]
            rw [hb₀] at hprod
            calc
              b₀⁻¹ ^ ℓ * V.subtype ↑(u_unit⁻¹)
                = (b₀⁻¹ ^ ℓ * V.subtype ↑(u_unit⁻¹) * a⁻¹) * a := by
                    rw [mul_assoc, inv_mul_cancel₀ ha, mul_one]
              _ = a := by rw [hprod, one_mul]
    have hDiv : ∀ (a : K), a ≠ 0 → ∀ (d : ℕ), 1 ≤ d →
        ∃ (b : K) (u : ↥V), IsUnit u ∧ b ^ d * V.subtype u = a := by
      have hDivInd : ∀ (d : ℕ), 1 ≤ d → ∀ (a : K), a ≠ 0 →
          ∃ (b : K) (u : ↥V), IsUnit u ∧ b ^ d * V.subtype u = a := by
        intro d
        induction d using Nat.strongRecOn with
        | ind d ih =>
          intro hd1 a ha
          by_cases hd_eq1 : d = 1
          · subst hd_eq1
            exact ⟨a, 1, isUnit_one, by simp⟩
          · have hd2 : 2 ≤ d := by omega
            let ℓ := d.minFac
            have hℓ_prime : ℓ.Prime := Nat.minFac_prime (by omega)
            have hℓ_dvd : ℓ ∣ d := Nat.minFac_dvd d
            obtain ⟨k, hk⟩ := hℓ_dvd
            by_cases hk1 : k = 1
            · rw [hk1, mul_one] at hk
              rw [hk]
              exact hPrimeDiv ℓ hℓ_prime a ha
            · have hk_pos : 1 ≤ k := by
                by_contra hk0
                have : k = 0 := by omega
                rw [this, mul_zero] at hk
                omega
              have hk2 : 2 ≤ k := by omega
              have hℓ2 : 2 ≤ ℓ := hℓ_prime.two_le
              have hk_lt : k < d := by nlinarith
              obtain ⟨b₁, u₁, hu₁, hb₁⟩ := ih k hk_lt hk_pos a ha
              have hb₁_ne : b₁ ≠ 0 := by
                rintro rfl
                rw [zero_pow (by omega), zero_mul] at hb₁
                exact ha hb₁.symm
              obtain ⟨b₂, u₂, hu₂, hb₂⟩ := hPrimeDiv ℓ hℓ_prime b₁ hb₁_ne
              refine ⟨b₂, u₂ ^ k * u₁, (hu₂.pow k).mul hu₁, ?_⟩
              rw [hk, pow_mul, map_mul, map_pow]
              calc
                (b₂ ^ ℓ) ^ k * ((V.subtype u₂) ^ k * V.subtype u₁)
                  = (b₂ ^ ℓ * V.subtype u₂) ^ k * V.subtype u₁ := by ring
                _ = b₁ ^ k * V.subtype u₁ := by rw [hb₂]
                _ = a := hb₁
      intro a ha d hd
      exact hDivInd d hd a ha
    have hAlgRes : ∀ (P : Ideal ↥V) [P.IsPrime], P ≠ ⊥ → IsAlgClosed P.ResidueField := by
      intro P _ hP_ne_bot
      let W : ValuationSubring K := V.ofPrime P
      have : IsLocalization.AtPrime ↥W P := ValuationSubring.ofPrime_localization V P
      let e_loc : Localization.AtPrime P ≃ₐ[↥V] ↥W :=
        IsLocalization.algEquiv P.primeCompl (Localization.AtPrime P) ↥W
      let e_res : P.ResidueField ≃+* IsLocalRing.ResidueField ↥W :=
        IsLocalRing.ResidueField.mapEquiv e_loc.toRingEquiv
      obtain ⟨x₀, hx₀P, hx₀_ne⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hP_ne_bot
      let δW : ↥W := algebraMap ↥V ↥W x₀
      have hδW_val : W.subtype δW = V.subtype x₀ := rfl
      have hδW_ne : W.subtype δW ≠ 0 := by
        rw [hδW_val]
        exact fun h0 => hx₀_ne (Subtype.ext h0)
      have hδW_max : δW ∈ IsLocalRing.maximalIdeal ↥W := by
        rw [hMemMaxIff]
        rintro ⟨u, hu⟩
        obtain ⟨⟨c, s⟩, hcs⟩ := IsLocalization.surj P.primeCompl (↑(u⁻¹) : ↥W)
        have hmul : δW * (↑(u⁻¹) * algebraMap ↥V ↥W s.1) = δW * algebraMap ↥V ↥W c :=
          congrArg (δW * ·) hcs
        have hu_inv : δW * ↑(u⁻¹) = 1 := by
          rw [← hu, Units.mul_inv]
        rw [← mul_assoc, hu_inv, one_mul, ← map_mul] at hmul
        have hs_eq : s.1 = x₀ * c := by
          apply Subtype.val_injective
          exact congrArg W.subtype hmul
        exact s.2 (hs_eq ▸ P.mul_mem_right c hx₀P)
      refine IsAlgClosed.of_exists_root P.ResidueField ?_
      intro p_res hp_monic hp_irred
      let h_bar : Polynomial (IsLocalRing.ResidueField ↥W) := p_res.map e_res.toRingHom
      have hh_bar_monic : h_bar.Monic := hp_monic.map e_res.toRingHom
      have hh_bar_nd_pos : 0 < h_bar.natDegree := by
        have hnd := Polynomial.natDegree_map_eq_of_injective e_res.toRingHom.injective p_res
        change 0 < (p_res.map e_res.toRingHom).natDegree
        rw [hnd]
        exact hp_irred.natDegree_pos
      let d_h := h_bar.natDegree
      have hResSurj : Function.Surjective (IsLocalRing.residue ↥W) :=
        Ideal.Quotient.mk_surjective
      choose lift_fn hlift_fn using hResSurj
      let h_lift : Polynomial ↥W :=
        Polynomial.X ^ d_h +
          ∑ i ∈ Finset.range d_h, Polynomial.monomial i (lift_fn (h_bar.coeff i))
      have hh_lift_coeff : ∀ j : ℕ, h_lift.coeff j =
          if j = d_h then 1 else if j < d_h then lift_fn (h_bar.coeff j) else 0 := by
        intro j
        simp only [h_lift, Polynomial.coeff_add, Polynomial.coeff_X_pow,
          Polynomial.finsetSum_coeff, Polynomial.coeff_monomial]
        by_cases hj_eq : j = d_h
        · subst hj_eq
          simp only [ite_true]
          rw [Finset.sum_eq_zero, add_zero]
          intro b hb
          exact ite_eq_right_iff.mpr (fun h => absurd h (ne_of_lt (Finset.mem_range.mp hb)))
        · simp only [hj_eq, ite_false, zero_add]
          by_cases hj_lt : j < d_h
          · simp only [hj_lt, ite_true]
            rw [Finset.sum_eq_single j]
            · simp
            · intro b _ hbj
              exact ite_eq_right_iff.mpr (fun h => absurd h hbj)
            · intro hnot
              exact (hnot (Finset.mem_range.mpr hj_lt)).elim
          · simp only [hj_lt, ite_false]
            refine Finset.sum_eq_zero ?_
            intro b hb
            have hb_lt : b < d_h := Finset.mem_range.mp hb
            exact ite_eq_right_iff.mpr (fun h => absurd h (by omega))
      have hh_lift_nd : h_lift.natDegree = d_h := by
        apply Polynomial.natDegree_eq_of_le_of_coeff_ne_zero
        · refine Polynomial.natDegree_le_iff_coeff_eq_zero.mpr ?_
          intro j hj
          rw [hh_lift_coeff j, ite_eq_right_iff.mpr (fun h => absurd h (by omega)),
            ite_eq_right_iff.mpr (fun h => absurd h (by omega))]
        · rw [hh_lift_coeff d_h]
          simp
      have hh_lift_monic : h_lift.Monic := by
        rw [Polynomial.Monic.def, Polynomial.leadingCoeff, hh_lift_nd, hh_lift_coeff d_h]
        simp
      have hh_lift_map : h_lift.map (IsLocalRing.residue ↥W) = h_bar := by
        ext j
        rw [Polynomial.coeff_map, hh_lift_coeff j]
        by_cases hj_eq : j = d_h
        · subst hj_eq
          simp only [ite_true, map_one]
          exact hh_bar_monic.coeff_natDegree.symm
        · simp only [hj_eq, ite_false]
          by_cases hj_lt : j < d_h
          · simp [hj_lt, hlift_fn]
          · simp only [hj_lt, ite_false, map_zero]
            exact (Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)).symm
      obtain ⟨s, q, b, hq_prop, hh_prod⟩ :=
        hValFactor W h_lift.natDegree h_lift rfl hh_lift_monic
      have hs_pos : 0 < s := by
        by_contra hs0
        have hs_eq0 : s = 0 := by omega
        subst hs_eq0
        simp only [Finset.univ_eq_empty, Finset.prod_empty] at hh_prod
        rw [hh_prod, Polynomial.map_one] at hh_lift_map
        rw [← hh_lift_map, Polynomial.natDegree_one] at hh_bar_nd_pos
        omega
      let r₀ : Fin s := ⟨0, hs_pos⟩
      have hex_y : ∃ y : ↥W,
          (IsLocalRing.residue ↥W y) ^ (q r₀) - IsLocalRing.residue ↥W (b r₀) = 0 := by
        rcases (hq_prop r₀).2 with hq1 | hqK0
        · refine ⟨b r₀, ?_⟩
          rw [hq1, pow_one, sub_self]
        · have hqr₀_ge2 : 2 ≤ q r₀ := by
            have h1 := (hq_prop r₀).1
            by_contra hlt2
            have hq_eq1 : q r₀ = 1 := by omega
            rw [hq_eq1, Nat.cast_one] at hqK0
            exact one_ne_zero hqK0
          let Q_poly : Polynomial K :=
            Polynomial.X ^ (q r₀) + Polynomial.C (W.subtype δW) * Polynomial.X -
              Polynomial.C (W.subtype (b r₀))
          have hQ_deriv : Q_poly.derivative = Polynomial.C (W.subtype δW) := by
            change (Polynomial.X ^ (q r₀) + Polynomial.C (W.subtype δW) * Polynomial.X -
              Polynomial.C (W.subtype (b r₀))).derivative = _
            rw [Polynomial.derivative_sub, Polynomial.derivative_add,
              Polynomial.derivative_X_pow, hqK0, map_zero, zero_mul,
              zero_add, Polynomial.derivative_C_mul_X, Polynomial.derivative_C, sub_zero]
          have hQ_sep : Q_poly.Separable :=
            ⟨0, Polynomial.C (W.subtype δW)⁻¹, by
              rw [hQ_deriv, zero_mul, zero_add, ← Polynomial.C_mul,
                inv_mul_cancel₀ hδW_ne, Polynomial.C_1]⟩
          have hQ_nd : Q_poly.natDegree = q r₀ := by
            have hrewrite : Q_poly =
                Polynomial.X ^ (q r₀) +
                  (Polynomial.C (W.subtype δW) * Polynomial.X - Polynomial.C (W.subtype (b r₀))) :=
              add_sub_assoc _ _ _
            rw [hrewrite, Polynomial.natDegree_add_eq_left_of_natDegree_lt]
            · exact Polynomial.natDegree_X_pow (q r₀)
            · rw [Polynomial.natDegree_X_pow]
              refine lt_of_le_of_lt (Polynomial.natDegree_sub_le _ _) (max_lt ?_ ?_)
              · refine lt_of_le_of_lt Polynomial.natDegree_mul_le ?_
                rw [Polynomial.natDegree_C, Polynomial.natDegree_X]
                omega
              · rw [Polynomial.natDegree_C]
                omega
          have hSplits := IsSepClosed.splits_of_separable Q_poly hQ_sep
          have hdeg_pos : 0 < Q_poly.degree :=
            Polynomial.natDegree_pos_iff_degree_pos.mp (by omega)
          have hdeg_ne : Q_poly.degree ≠ 0 := ne_of_gt hdeg_pos
          obtain ⟨α, hα⟩ := hSplits.exists_eval_eq_zero hdeg_ne
          have hα_eq : α ^ (q r₀) + W.subtype δW * α = W.subtype (b r₀) := by
            have h0 : α ^ (q r₀) + W.subtype δW * α - W.subtype (b r₀) = 0 := by
              simpa [Q_poly] using hα
            exact sub_eq_zero.mp h0
          have hαW : α ∈ W := by
            by_contra hα_not
            have hα_ne : α ≠ 0 := by
              rintro rfl
              exact hα_not W.zero_mem
            have hαinvW : α⁻¹ ∈ W := (W.mem_or_inv_mem α).resolve_left hα_not
            let γ : ↥W := ⟨α⁻¹, hαinvW⟩
            have hγ_max : γ ∈ IsLocalRing.maximalIdeal ↥W := by
              rw [hMemMaxIff]
              rintro ⟨u, hu⟩
              have hmul : α⁻¹ * ((↑(u⁻¹) : ↥W) : K) = 1 := by
                have hm := congrArg Subtype.val (Units.mul_inv u)
                simpa [hu, γ] using hm
              have hα_eq_u : ((↑(u⁻¹) : ↥W) : K) = α := by
                calc
                  ((↑(u⁻¹) : ↥W) : K) = α * (α⁻¹ * ((↑(u⁻¹) : ↥W) : K)) := by
                    rw [← mul_assoc, mul_inv_cancel₀ hα_ne, one_mul]
                  _ = α := by rw [hmul, mul_one]
              exact hα_not (hα_eq_u ▸ (↑(u⁻¹) : ↥W).2)
            have hone_K : (1 : K) =
                W.subtype (-δW * γ ^ (q r₀ - 1) + b r₀ * (γ * γ ^ (q r₀ - 1))) := by
              have hγK : W.subtype γ = α⁻¹ := rfl
              have hγ_pow : α ^ (q r₀) * (α⁻¹) ^ (q r₀) = 1 := by
                rw [← mul_pow, mul_inv_cancel₀ hα_ne, one_pow]
              have hγ_pow1 : α * (α⁻¹) ^ (q r₀) = (α⁻¹) ^ (q r₀ - 1) := by
                conv_lhs =>
                  rw [show q r₀ = 1 + (q r₀ - 1) by omega, pow_add, pow_one, ← mul_assoc,
                    mul_inv_cancel₀ hα_ne, one_mul]
              simp only [map_add, map_neg, map_mul, map_pow]
              rw [hγK, ← pow_succ', Nat.sub_add_cancel (by omega)]
              calc
                (1 : K) = (α ^ (q r₀) + W.subtype δW * α - W.subtype δW * α) * (α⁻¹) ^ (q r₀) := by
                    rw [add_sub_cancel_right, hγ_pow]
                _ = (W.subtype (b r₀) - W.subtype δW * α) * (α⁻¹) ^ (q r₀) := by rw [hα_eq]
                _ = -W.subtype δW * (α * (α⁻¹) ^ (q r₀)) + W.subtype (b r₀) * (α⁻¹) ^ (q r₀) := by
                    ring
                _ = -W.subtype δW * (α⁻¹) ^ (q r₀ - 1) + W.subtype (b r₀) * (α⁻¹) ^ (q r₀) := by
                    rw [hγ_pow1]
            have hone_W : (1 : ↥W) = -δW * γ ^ (q r₀ - 1) + b r₀ * (γ * γ ^ (q r₀ - 1)) :=
              Subtype.ext hone_K
            have hone_max : (1 : ↥W) ∈ IsLocalRing.maximalIdeal ↥W := by
              rw [hone_W]
              refine (IsLocalRing.maximalIdeal ↥W).add_mem ?_ ?_
              · rw [neg_mul]
                exact (IsLocalRing.maximalIdeal ↥W).neg_mem
                  ((IsLocalRing.maximalIdeal ↥W).mul_mem_right _ hδW_max)
              · rw [← mul_assoc, mul_comm (b r₀) γ, mul_assoc]
                exact (IsLocalRing.maximalIdeal ↥W).mul_mem_right _ hγ_max
            exact (IsLocalRing.maximalIdeal.isMaximal ↥W).ne_top
              ((Ideal.eq_top_iff_one _).mpr hone_max)
          let y : ↥W := ⟨α, hαW⟩
          have hy_eq : y ^ (q r₀) + δW * y = b r₀ := Subtype.ext hα_eq
          refine ⟨y, ?_⟩
          have hres_eq := congrArg (IsLocalRing.residue ↥W) hy_eq
          have hδ_res0 : IsLocalRing.residue ↥W δW = 0 :=
            Ideal.Quotient.eq_zero_iff_mem.mpr hδW_max
          rw [map_add, map_pow, map_mul, hδ_res0, zero_mul, add_zero] at hres_eq
          exact sub_eq_zero.mpr hres_eq
      obtain ⟨y, hy_root⟩ := hex_y
      let x_res : P.ResidueField := e_res.symm (IsLocalRing.residue ↥W y)
      refine ⟨x_res, ?_⟩
      apply e_res.injective
      rw [map_zero]
      have hev_map : e_res (p_res.eval x_res) = h_bar.eval (e_res x_res) := by
        change e_res.toRingHom (p_res.eval x_res) = (p_res.map e_res.toRingHom).eval (e_res.toRingHom x_res)
        rw [Polynomial.eval_map, Polynomial.eval₂_at_apply]
      rw [hev_map]
      simp only [x_res, RingEquiv.apply_symm_apply]
      rw [← hh_lift_map, hh_prod, Polynomial.map_prod, Polynomial.eval_prod]
      refine Finset.prod_eq_zero (Finset.mem_univ r₀) ?_
      simpa using hy_root
    exact ⟨hHensel, hDiv, hAlgRes⟩
  
  have h_s3 : ∀ (R : Type u) [CommRing R] [IsDomain R] [ValuationRing R]
      (r : ℕ) (J : Ideal (MvPolynomial (Fin r) R)),
      (∀ (c : R) (f : MvPolynomial (Fin r) R),
        c ≠ 0 → MvPolynomial.C c * f ∈ J → f ∈ J) →
      J.FG := by
    clear * -
    intro R _ _ _ r J hSat
    classical
    have hDvdTotal : Std.Total (fun x y : R => x ∣ y) :=
      (ValuationRing.iff_dvd_total (R := R)).mp inferInstance
    have hMinDvd : ∀ {ι : Type} (S : Finset ι) (w : ι → R),
        S.Nonempty → ∃ i₀ ∈ S, ∀ i ∈ S, w i₀ ∣ w i := by
      intro ι S w
      induction S using Finset.induction_on with
      | empty =>
        intro hne
        exact (Finset.not_nonempty_empty hne).elim
      | insert a S haS ih =>
        intro _
        rcases S.eq_empty_or_nonempty with rfl | hSne
        · refine ⟨a, Finset.mem_singleton_self a, ?_⟩
          intro i hi
          rw [Finset.mem_singleton.mp hi]
        · obtain ⟨i₀, hi₀S, hi₀_dvd⟩ := ih hSne
          rcases hDvdTotal.total (w a) (w i₀) with ha_i₀ | hi₀_a
          · refine ⟨a, Finset.mem_insert_self a S, ?_⟩
            intro i hi
            rcases Finset.mem_insert.mp hi with rfl | hiS
            · exact dvd_rfl
            · exact dvd_trans ha_i₀ (hi₀_dvd i hiS)
          · refine ⟨i₀, Finset.mem_insert_of_mem hi₀S, ?_⟩
            intro i hi
            rcases Finset.mem_insert.mp hi with rfl | hiS
            · exact hi₀_a
            · exact hi₀_dvd i hiS
    have hRREF : ∀ (k : ℕ) (ι : Type) [Fintype ι] [DecidableEq ι],
        Fintype.card ι = k →
        ∀ (L : Submodule R (ι → R)),
          (∀ (c : R) (v : ι → R), c ≠ 0 → c • v ∈ L → v ∈ L) →
          ∃ (B : Finset ι) (e : ι → (ι → R)),
            (∀ b ∈ B, e b ∈ L) ∧
            (∀ b ∈ B, ∀ b' ∈ B, e b b' = if b = b' then 1 else 0) ∧
            (∀ v ∈ L, v = ∑ b ∈ B, v b • e b) := by
      intro k
      induction k using Nat.strongRecOn with
      | ind k ih =>
        intro ι _ _ hcard L hSatL
        by_cases hZero : ∀ v ∈ L, v = 0
        · refine ⟨∅, 0, by simp, by simp, ?_⟩
          intro v hv
          simpa using hZero v hv
        · push_neg at hZero
          obtain ⟨w, hwL, hw_ne⟩ := hZero
          let Sw : Finset ι := Finset.univ.filter (fun i : ι => w i ≠ 0)
          have hSw_ne : Sw.Nonempty := by
            have hex : ∃ i : ι, w i ≠ 0 := by
              by_contra hall
              push_neg at hall
              exact hw_ne (funext hall)
            obtain ⟨i, hi⟩ := hex
            exact ⟨i, Finset.mem_filter.mpr ⟨Finset.mem_univ i, hi⟩⟩
          obtain ⟨i₀, hi₀Sw, hi₀_dvd_Sw⟩ := hMinDvd Sw w hSw_ne
          have hwi₀_ne : w i₀ ≠ 0 := (Finset.mem_filter.mp hi₀Sw).2
          have hi₀_dvd : ∀ i : ι, w i₀ ∣ w i := by
            intro i
            by_cases hwi : w i = 0
            · rw [hwi]
              exact dvd_zero _
            · exact hi₀_dvd_Sw i (Finset.mem_filter.mpr ⟨Finset.mem_univ i, hwi⟩)
          choose u_fn hu_fn using hi₀_dvd
          have hui₀ : u_fn i₀ = 1 := by
            apply mul_left_cancel₀ hwi₀_ne
            rw [← hu_fn i₀, mul_one]
          have hw_smul : w i₀ • u_fn = w := by
            ext i
            exact (hu_fn i).symm
          have hu_mem : u_fn ∈ L := hSatL (w i₀) u_fn hwi₀_ne (hw_smul.symm ▸ hwL)
          let ι' := {i : ι // i ≠ i₀}
          have hcard_lt : Fintype.card ι' < k := by
            rw [← hcard]
            exact Fintype.card_lt_of_injective_not_surjective Subtype.val Subtype.val_injective
              (fun hsurj => by obtain ⟨j, hj⟩ := hsurj i₀; exact j.2 hj)
          let extZero : (ι' → R) →ₗ[R] (ι → R) :=
            { toFun := fun v' i => if h : i = i₀ then 0 else v' ⟨i, h⟩
              map_add' := fun x y => by ext i; by_cases h : i = i₀ <;> simp [h]
              map_smul' := fun c x => by ext i; by_cases h : i = i₀ <;> simp [h] }
          let resSub : (ι → R) →ₗ[R] (ι' → R) :=
            { toFun := fun v j => v j.1
              map_add' := fun x y => rfl
              map_smul' := fun c x => rfl }
          have hres_ext : ∀ v' : ι' → R, resSub (extZero v') = v' := by
            intro v'
            ext j
            simp [resSub, extZero, j.2]
          have hext_i₀ : ∀ v' : ι' → R, extZero v' i₀ = 0 := by
            intro v'
            simp [extZero]
          have hext_res_of_zero : ∀ v : ι → R, v i₀ = 0 → extZero (resSub v) = v := by
            intro v hv0
            ext i
            simp only [extZero, resSub, LinearMap.coe_mk, AddHom.coe_mk]
            split_ifs with hi
            · subst hi; exact hv0.symm
            · rfl
          let L' : Submodule R (ι' → R) := Submodule.comap extZero L
          have hSatL' : ∀ (c : R) (v' : ι' → R), c ≠ 0 → c • v' ∈ L' → v' ∈ L' := by
            intro c v' hc hcv'
            change extZero v' ∈ L
            have hmap : c • extZero v' ∈ L := by
              rw [← map_smul]
              exact hcv'
            exact hSatL c (extZero v') hc hmap
          obtain ⟨B', e', he'_mem, he'_kr, he'_span⟩ :=
            ih (Fintype.card ι') hcard_lt ι' rfl L' hSatL'
          let e_tilde : ι' → (ι → R) := fun j => extZero (e' j)
          let e₀ : ι → R := u_fn - ∑ b' ∈ B', u_fn b'.1 • e_tilde b'
          have he₀_mem : e₀ ∈ L := by
            refine L.sub_mem hu_mem (L.sum_mem ?_)
            intro b' hb'
            exact L.smul_mem (u_fn b'.1) (he'_mem b' hb')
          have he₀_i₀ : e₀ i₀ = 1 := by
            simp only [e₀, Pi.sub_apply, Finset.sum_apply, Pi.smul_apply, smul_eq_mul,
              e_tilde, hext_i₀, mul_zero, Finset.sum_const_zero, sub_zero, hui₀]
          have he₀_B' : ∀ b' ∈ B', e₀ b'.1 = 0 := by
            intro b' hb'
            simp only [e₀, Pi.sub_apply, Finset.sum_apply, Pi.smul_apply, smul_eq_mul,
              e_tilde, extZero, LinearMap.coe_mk, AddHom.coe_mk, dif_neg b'.2]
            rw [Finset.sum_eq_single b']
            · rw [he'_kr b' hb' b' hb', if_pos rfl, mul_one, sub_self]
            · intro b'' hb'' hne
              rw [he'_kr b'' hb'' b' hb', if_neg hne, mul_zero]
            · intro hnot
              exact (hnot hb').elim
          let B : Finset ι := insert i₀ (B'.image Subtype.val)
          let e_full : ι → (ι → R) := fun i =>
            if h : i = i₀ then e₀ else e_tilde ⟨i, h⟩
          refine ⟨B, e_full, ?_, ?_, ?_⟩
          · intro b hb
            rcases Finset.mem_insert.mp hb with rfl | hb_im
            · simp [e_full, he₀_mem]
            · obtain ⟨b', hb'B', rfl⟩ := Finset.mem_image.mp hb_im
              simp only [e_full, dif_neg b'.2, e_tilde]
              exact he'_mem b' hb'B'
          · intro b hb b₁ hb₁
            rcases Finset.mem_insert.mp hb with rfl | hb_im
            · simp only [e_full, dif_pos rfl]
              rcases Finset.mem_insert.mp hb₁ with rfl | hb₁_im
              · simp [he₀_i₀]
              · obtain ⟨b₁', hb₁'B', rfl⟩ := Finset.mem_image.mp hb₁_im
                rw [if_neg b₁'.2.symm]
                exact he₀_B' b₁' hb₁'B'
            · obtain ⟨b', hb'B', rfl⟩ := Finset.mem_image.mp hb_im
              simp only [e_full, dif_neg b'.2, e_tilde]
              rcases Finset.mem_insert.mp hb₁ with rfl | hb₁_im
              · rw [if_neg b'.2, hext_i₀]
              · obtain ⟨b₁', hb₁'B', rfl⟩ := Finset.mem_image.mp hb₁_im
                simp only [extZero, LinearMap.coe_mk, AddHom.coe_mk, dif_neg b₁'.2,
                  Subtype.val_inj]
                exact he'_kr b' hb'B' b₁' hb₁'B'
          · intro v hv
            let w_rem : ι → R := v - v i₀ • e₀
            have hw_rem_mem : w_rem ∈ L := L.sub_mem hv (L.smul_mem (v i₀) he₀_mem)
            have hw_rem_i₀ : w_rem i₀ = 0 := by
              simp [w_rem, he₀_i₀]
            have hres_mem : resSub w_rem ∈ L' := by
              change extZero (resSub w_rem) ∈ L
              rw [hext_res_of_zero w_rem hw_rem_i₀]
              exact hw_rem_mem
            have hres_eq := he'_span (resSub w_rem) hres_mem
            have hw_rem_eq : w_rem = ∑ b' ∈ B', v b'.1 • e_tilde b' := by
              calc
                w_rem = extZero (resSub w_rem) := (hext_res_of_zero w_rem hw_rem_i₀).symm
                _ = extZero (∑ b' ∈ B', (resSub w_rem b') • e' b') := by rw [← hres_eq]
                _ = ∑ b' ∈ B', (w_rem b'.1) • e_tilde b' := by
                    rw [map_sum]
                    refine Finset.sum_congr rfl ?_
                    intro b' _
                    rw [map_smul]
                    rfl
                _ = ∑ b' ∈ B', v b'.1 • e_tilde b' := by
                    refine Finset.sum_congr rfl ?_
                    intro b' hb'
                    have hwb' : w_rem b'.1 = v b'.1 := by
                      simp [w_rem, he₀_B' b' hb']
                    rw [hwb']
            have hi₀_not_im : i₀ ∉ B'.image Subtype.val := by
              simp only [Finset.mem_image, not_exists, not_and]
              intro b' _
              exact b'.2
            rw [Finset.sum_insert hi₀_not_im, Finset.sum_image (fun x _ y _ hxy => Subtype.ext hxy)]
            simp only [e_full, dif_pos rfl]
            calc
              v = v i₀ • e₀ + w_rem := by simp [w_rem]
              _ = v i₀ • e₀ + ∑ x ∈ B', v x.1 • (if h : x.1 = i₀ then e₀ else e_tilde ⟨x.1, h⟩) := by
                  rw [hw_rem_eq]
                  congr 1
                  refine Finset.sum_congr rfl ?_
                  intro b' _
                  rw [dif_neg b'.2]
    let SP := MvPolynomial (Fin (r + 1)) R
    let dehom : SP →ₐ[R] MvPolynomial (Fin r) R :=
      MvPolynomial.aeval (Fin.cases 1 MvPolynomial.X)
    let HSub := MvPolynomial.homogeneousSubmodule (Fin (r + 1)) R
    let I_d : ℕ → Submodule R SP := fun d =>
      HSub d ⊓ Submodule.comap dehom.toLinearMap (J.restrictScalars R)
    let Idx : ℕ → Type := fun d =>
      {α : Fin (r + 1) → Fin (d + 1) // (∑ j : Fin (r + 1), (α j : ℕ)) = d}
    let toFS : ∀ {d : ℕ}, Idx d → (Fin (r + 1) →₀ ℕ) := fun α =>
      Finsupp.equivFunOnFinite.symm (fun j => (α.1 j : ℕ))
    have htoFS_apply : ∀ {d : ℕ} (α : Idx d) (j : Fin (r + 1)), toFS α j = (α.1 j : ℕ) := by
      intro d α j
      rfl
    have htoFS_inj : ∀ {d : ℕ}, Function.Injective (@toFS d) := by
      intro d α β hαβ
      apply Subtype.ext
      ext j
      have hj := congrArg (fun m => m j) hαβ
      exact hj
    have htoFS_homog : ∀ {d : ℕ} (α : Idx d) (c : R),
        MvPolynomial.monomial (toFS α) c ∈ HSub d := by
      intro d α c
      rw [MvPolynomial.mem_homogeneousSubmodule]
      refine MvPolynomial.isHomogeneous_monomial c ?_
      rw [Finsupp.degree_eq_sum]
      simpa [htoFS_apply] using α.2
    let toVec : ∀ (d : ℕ), SP →ₗ[R] (Idx d → R) := fun d =>
      LinearMap.pi (fun α => MvPolynomial.lcoeff R (toFS α))
    let fromVec : ∀ (d : ℕ), (Idx d → R) →ₗ[R] SP := fun d =>
      { toFun := fun v => ∑ α : Idx d, MvPolynomial.monomial (toFS α) (v α)
        map_add' := fun v₁ v₂ => by
          simp only [Pi.add_apply, map_add, Finset.sum_add_distrib]
        map_smul' := fun c v => by
          simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply, Finset.smul_sum]
          refine Finset.sum_congr rfl ?_
          intro α _
          exact map_smul (MvPolynomial.monomial (toFS α)) c (v α) }
    have hfromVec_mem : ∀ (d : ℕ) (v : Idx d → R), fromVec d v ∈ HSub d := by
      intro d v
      exact (HSub d).sum_mem (fun α _ => htoFS_homog α (v α))
    have hto_from : ∀ (d : ℕ) (v : Idx d → R), toVec d (fromVec d v) = v := by
      intro d v
      ext α
      change (∑ β : Idx d, MvPolynomial.monomial (toFS β) (v β)).coeff (toFS α) = v α
      rw [MvPolynomial.coeff_sum]
      rw [Finset.sum_eq_single α]
      · simp
      · intro β _ hβα
        rw [MvPolynomial.coeff_monomial, ite_eq_right_iff.mpr (fun h => absurd (htoFS_inj h) hβα)]
      · intro hnot
        exact (hnot (Finset.mem_univ α)).elim
    have hfrom_to : ∀ (d : ℕ) (F : SP), F ∈ HSub d → fromVec d (toVec d F) = F := by
      intro d F hF
      have hF_hom : F.IsHomogeneous d := (MvPolynomial.mem_homogeneousSubmodule d F).mp hF
      ext m
      change (∑ α : Idx d, MvPolynomial.monomial (toFS α) (F.coeff (toFS α))).coeff m = F.coeff m
      rw [MvPolynomial.coeff_sum]
      by_cases hsum : (∑ j : Fin (r + 1), m j) = d
      · have hlt : ∀ j : Fin (r + 1), m j < d + 1 := by
          intro j
          have hle : m j ≤ ∑ j' : Fin (r + 1), m j' :=
            Finset.single_le_sum (fun j' _ => Nat.zero_le (m j')) (Finset.mem_univ j)
          omega
        let α_m : Idx d := ⟨fun j => ⟨m j, hlt j⟩, hsum⟩
        have hα_eq : toFS α_m = m := by
          ext j
          exact htoFS_apply α_m j
        rw [Finset.sum_eq_single α_m]
        · rw [hα_eq, MvPolynomial.coeff_monomial, if_pos rfl]
        · intro β _ hβ
          rw [MvPolynomial.coeff_monomial, if_neg]
          intro hbm
          apply hβ
          apply htoFS_inj
          rw [hbm, hα_eq]
        · intro hnot
          exact (hnot (Finset.mem_univ α_m)).elim
      · rw [Finset.sum_eq_zero]
        · symm
          by_contra hne
          have hdeg := hF_hom hne
          rw [Finsupp.weight_apply, Finsupp.sum_fintype _ _ (fun _ => zero_mul _)] at hdeg
          simp only [Pi.one_apply, nsmul_eq_mul, mul_one] at hdeg
          exact hsum hdeg
        · intro α _
          rw [MvPolynomial.coeff_monomial, if_neg]
          intro hαm
          apply hsum
          rw [← hαm]
          exact α.2
    let res := IsLocalRing.residue R
    let κ := IsLocalRing.ResidueField R
    let π_res : SP →+* MvPolynomial (Fin (r + 1)) κ := MvPolynomial.map res
    have hId_props : ∀ d : ℕ,
        (I_d d).FG ∧
        ∀ F ∈ I_d d, π_res F = 0 → F ∈ (IsLocalRing.maximalIdeal R) • (I_d d) := by
      intro d
      let Ld : Submodule R (Idx d → R) := Submodule.map (toVec d) (I_d d)
      have hSatLd : ∀ (c : R) (v : Idx d → R), c ≠ 0 → c • v ∈ Ld → v ∈ Ld := by
        intro c v hc hcv
        obtain ⟨F, hF_mem, hF_eq⟩ := Submodule.mem_map.mp hcv
        let G : SP := fromVec d v
        have hG_hom : G ∈ HSub d := hfromVec_mem d v
        have hcG_eq : c • G = F := by
          calc
            c • G = fromVec d (c • v) := (map_smul (fromVec d) c v).symm
            _ = fromVec d (toVec d F) := by rw [← hF_eq]
            _ = F := hfrom_to d F hF_mem.1
        have hdehom_cG : MvPolynomial.C c * dehom G ∈ J := by
          have h1 : MvPolynomial.C c * dehom G = dehom (c • G) := by
            rw [Algebra.smul_def, map_mul]
            simp [dehom]
          rw [h1, hcG_eq]
          exact hF_mem.2
        have hG_J : dehom G ∈ J := hSat c (dehom G) hc hdehom_cG
        have hG_Id : G ∈ I_d d := ⟨hG_hom, hG_J⟩
        refine Submodule.mem_map.mpr ⟨G, hG_Id, hto_from d v⟩
      obtain ⟨Bd, e_vec, he_mem, _, he_span⟩ :=
        hRREF (Fintype.card (Idx d)) (Idx d) rfl Ld hSatLd
      let e_poly : Idx d → SP := fun b => fromVec d (e_vec b)
      have he_poly_mem : ∀ b ∈ Bd, e_poly b ∈ I_d d := by
        intro b hb
        obtain ⟨Fb, hFb_Id, hFb_eq⟩ := Submodule.mem_map.mp (he_mem b hb)
        have heq : e_poly b = Fb := by
          change fromVec d (e_vec b) = Fb
          rw [← hFb_eq, hfrom_to d Fb hFb_Id.1]
        exact heq ▸ hFb_Id
      have hF_expand : ∀ F ∈ I_d d, F = ∑ b ∈ Bd, (F.coeff (toFS b)) • e_poly b := by
        intro F hF
        have hv_mem : toVec d F ∈ Ld := Submodule.mem_map_of_mem hF
        have hv_eq := he_span (toVec d F) hv_mem
        calc
          F = fromVec d (toVec d F) := (hfrom_to d F hF.1).symm
          _ = fromVec d (∑ b ∈ Bd, (toVec d F b) • e_vec b) := by rw [← hv_eq]
          _ = ∑ b ∈ Bd, (F.coeff (toFS b)) • e_poly b := by
              rw [map_sum]
              refine Finset.sum_congr rfl ?_
              intro b _
              rw [map_smul]
              rfl
      refine ⟨⟨Bd.image e_poly, ?_⟩, ?_⟩
      · apply le_antisymm
        · rw [Submodule.span_le]
          intro x hx
          obtain ⟨b, hb, rfl⟩ := Finset.mem_image.mp hx
          exact he_poly_mem b hb
        · intro F hF
          rw [hF_expand F hF]
          refine Submodule.sum_mem _ ?_
          intro b hb
          exact Submodule.smul_mem _ _
            (Submodule.subset_span (Finset.mem_image_of_mem e_poly hb))
      · intro F hF hres0
        rw [hF_expand F hF]
        refine Submodule.sum_mem _ ?_
        intro b hb
        have hc_max : F.coeff (toFS b) ∈ IsLocalRing.maximalIdeal R := by
          have hc := congrArg (fun P => P.coeff (toFS b)) hres0
          rw [MvPolynomial.coeff_map, MvPolynomial.coeff_zero] at hc
          exact Ideal.Quotient.eq_zero_iff_mem.mp hc
        exact Submodule.smul_mem_smul hc_max (he_poly_mem b hb)
    let S_hom_res : Set (MvPolynomial (Fin (r + 1)) κ) :=
      { G_bar | ∃ (d : ℕ) (G : SP), G ∈ I_d d ∧ π_res G = G_bar }
    let I_bar : Ideal (MvPolynomial (Fin (r + 1)) κ) := Ideal.span S_hom_res
    have hIbar_fg : I_bar.FG := IsNoetherian.noetherian I_bar
    obtain ⟨T₀, hT₀_span⟩ := hIbar_fg
    have hSubFin : ∀ t ∈ T₀, ∃ U : Finset (MvPolynomial (Fin (r + 1)) κ),
        (↑U : Set (MvPolynomial (Fin (r + 1)) κ)) ⊆ S_hom_res ∧ t ∈ Ideal.span (↑U) := by
      intro t ht
      have ht_mem : t ∈ I_bar := by
        rw [← hT₀_span]
        exact Ideal.subset_span ht
      obtain ⟨U, hU_sub, ht_U⟩ := Submodule.mem_span_finite_of_mem_span ht_mem
      exact ⟨U, hU_sub, ht_U⟩
    choose U_fn hU_sub hU_mem using hSubFin
    let U_fin : Finset (MvPolynomial (Fin (r + 1)) κ) :=
      T₀.attach.biUnion (fun x => U_fn x.1 x.2)
    have hU_fin_sub : (↑U_fin : Set (MvPolynomial (Fin (r + 1)) κ)) ⊆ S_hom_res := by
      intro g hg
      simp only [Finset.mem_coe, U_fin, Finset.mem_biUnion, Finset.mem_attach, true_and,
        Subtype.exists] at hg
      obtain ⟨t, ht, hgU⟩ := hg
      exact hU_sub t ht hgU
    have hU_fin_span : Ideal.span (↑U_fin : Set (MvPolynomial (Fin (r + 1)) κ)) = I_bar := by
      apply le_antisymm
      · exact Ideal.span_mono hU_fin_sub
      · rw [← hT₀_span, Ideal.span_le]
        intro t ht
        refine Ideal.span_mono ?_ (hU_mem t ht)
        intro g hg
        simp only [Finset.mem_coe, U_fin, Finset.mem_biUnion, Finset.mem_attach, true_and,
          Subtype.exists]
        exact ⟨t, ht, hg⟩
    let s := U_fin.card
    let eqv_s : Fin s ≃ ↥U_fin := U_fin.equivFin.symm
    have hex_lift : ∀ k : Fin s, ∃ (d : ℕ) (H : SP),
        H ∈ I_d d ∧ π_res H = (eqv_s k).1 :=
      fun k => hU_fin_sub (eqv_s k).2
    choose d_gen H_gen hH_gen_mem hH_gen_map using hex_lift
    have hIbar_eq_range :
        I_bar = Ideal.span (Set.range (fun k : Fin s => π_res (H_gen k))) := by
      rw [← hU_fin_span]
      congr 1
      ext g
      simp only [Finset.mem_coe, Set.mem_range]
      constructor
      · intro hg
        refine ⟨eqv_s.symm ⟨g, hg⟩, ?_⟩
        rw [hH_gen_map, Equiv.apply_symm_apply]
      · rintro ⟨k, rfl⟩
        rw [hH_gen_map]
        exact (eqv_s k).2
    let J_sub : Ideal (MvPolynomial (Fin r) R) :=
      Ideal.span (Set.range (fun k : Fin s => dehom (H_gen k)))
    let J_sub_d : ℕ → Submodule R SP := fun d =>
      HSub d ⊓ Submodule.comap dehom.toLinearMap (J_sub.restrictScalars R)
    have hHomCompMul : ∀ {d e : ℕ} (P H_bar : MvPolynomial (Fin (r + 1)) κ),
        H_bar.IsHomogeneous e →
        MvPolynomial.homogeneousComponent d (P * H_bar) =
          if e ≤ d then MvPolynomial.homogeneousComponent (d - e) P * H_bar else 0 := by
      intro d e P H_bar hH_bar
      have hcomp_single : ∀ {w t : ℕ} (Q : MvPolynomial (Fin (r + 1)) κ),
          Q.IsHomogeneous w →
          MvPolynomial.homogeneousComponent t Q = if w = t then Q else 0 := by
        intro w t Q hQ
        ext μ
        rw [MvPolynomial.coeff_homogeneousComponent]
        by_cases hwt : w = t
        · subst hwt
          simp only [ite_true]
          by_cases hμ : Finsupp.degree μ = w
          · simp [hμ]
          · simp only [hμ, ite_false]
            symm
            by_contra hne
            have hQw := hQ hne
            rw [Finsupp.weight_apply, Finsupp.sum] at hQw
            simp only [Pi.one_apply, nsmul_eq_mul, mul_one] at hQw
            rw [Finsupp.degree_apply] at hμ
            exact hμ hQw
        · simp only [hwt, ite_false, MvPolynomial.coeff_zero]
          by_cases hμ : Finsupp.degree μ = t
          · simp only [hμ, ite_true]
            by_contra hne
            have hQw := hQ hne
            rw [Finsupp.weight_apply, Finsupp.sum] at hQw
            simp only [Pi.one_apply, nsmul_eq_mul, mul_one] at hQw
            rw [Finsupp.degree_apply] at hμ
            exact hwt (hQw.symm.trans hμ)
          · simp [hμ]
      induction P using MvPolynomial.induction_on' with
      | monomial m c =>
        have hm_hom : (MvPolynomial.monomial m c).IsHomogeneous (∑ i : Fin (r + 1), m i) := by
          refine MvPolynomial.isHomogeneous_monomial c ?_
          exact Finsupp.degree_eq_sum m
