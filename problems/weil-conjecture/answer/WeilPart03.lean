        exact isUnit_iff_exists_inv.mpr ⟨b_inv, Subtype.ext (mul_inv_cancel₀ hne_L)⟩
    have hRes_OF_zero : ∀ y : ↥OF, IsLocalRing.residue ↥OF y = 0 ↔ ‖(y : F_hat)‖ < 1 := by
      intro y
      change Ideal.Quotient.mk (IsLocalRing.maximalIdeal ↥OF) y = 0 ↔ _
      rw [Ideal.Quotient.eq_zero_iff_mem, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
