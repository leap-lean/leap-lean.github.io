          rw [← Finset.add_sum_erase I term hk_mem]
        refine ⟨k, hk_mem, hck_ne, ?_, ?_⟩
        · rw [hsplit]; exact hUltraEq (term k) _ hsum_erase_lt
        · have hsub : (∑ j ∈ I, term j) - term k = ∑ j ∈ I.erase k, term j := by rw [hsplit]; ring
          rwa [hsub]
      have hGeomInvClosure : ∀ {F : Type u} [NormedField F] [IsUltrametricDist F]
          (R : Subring F) (x : F), x ∈ R → ‖x‖ < 1 →
          (1 - x)⁻¹ ∈ R.topologicalClosure := by
        intro F _ _ R x hx_mem hx_lt
        have h1x_norm : ‖(1 : F) - x‖ = 1 := by
          rw [sub_eq_add_neg, hUltraEq (1 : F) (-x) (by simpa using hx_lt), norm_one]
        have h1x_ne : (1 : F) - x ≠ 0 := by
          intro h0; rw [h0, norm_zero] at h1x_norm; norm_num at h1x_norm
        have h1x_inv_norm : ‖((1 : F) - x)⁻¹‖ = 1 := by
          rw [norm_inv, h1x_norm, inv_one]
