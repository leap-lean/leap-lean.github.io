        (ψu : C₀ →+* Au) (ψπ : C₁ →+* Aπ),
        p₀.comp Polynomial.C = (Ideal.Quotient.mk _).comp MvPolynomial.C ∧
        p₁.comp Polynomial.C = Polynomial.C ∧
        p₀ u = u_tilde ∧
        p₁ u = Polynomial.C π * t₁ ∧
        @IsLocalization.Away C₀ _ s₀ C₀₁ _ f₀₁.toAlgebra ∧
        @IsLocalization.Away C₁ _ t₁ C₀₁ _ f₁₀.toAlgebra ∧
