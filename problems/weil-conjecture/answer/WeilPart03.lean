theorem weil_schematicClosure_valuation_pointed_curve_model (K : Type u) [Field K]
    (m : ℕ)
    (V : ValuationSubring K)
    (hPkg : IsValuationRingAlgPackage m V)
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (n : ℕ)
    (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (hIntCK : AlgebraicGeometry.IsIntegral C_K)
    (hStabCK : IsGeometricStablePointedCurve p_K n σ_K)
    (s₀ : ↥V)
    (hs₀ : s₀ ≠ 0)
    (hLocV : @IsLocalization.Away _ _ s₀ K _ V.subtype.toAlgebra)
    (M : ℕ)
    (hAff_V : ∀ a : Fin (M + 1), AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen ↥V M a))
    (c_V : ∀ a : Fin (M + 1),
      ↥V →+* ↑((weilProjectiveSpaceOver ↥V M).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen ↥V M a))))
    (t_V : ∀ a : Fin (M + 1), Fin (M + 1) →
      ↑((weilProjectiveSpaceOver ↥V M).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen ↥V M a))))
    (hCoord_V : IsCommRingProjCoordSystem ↥V M hAff_V c_V t_V)
    (hAff_K : ∀ a : Fin (M + 1), AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen K M a))
    (c_K : ∀ a : Fin (M + 1),
      K →+* ↑((weilProjectiveSpaceOver K M).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen K M a))))
    (t_K : ∀ a : Fin (M + 1), Fin (M + 1) →
      ↑((weilProjectiveSpaceOver K M).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen K M a))))
    (hCoord_K : IsCommRingProjCoordSystem K M hAff_K c_K t_K)
    (Φ_KV : (weilProjectiveSpaceOver K M).left ⟶ (weilProjectiveSpaceOver ↥V M).left)
    (hBase_KV : IsCommRingProjBaseChange ↥V K V.subtype M c_V t_V c_K t_K Φ_KV)
    (Ψ_K : C_K ⟶ (weilProjectiveSpaceOver K M).left)
    (hClΨ : AlgebraicGeometry.IsClosedImmersion Ψ_K)
    (hCommΨ : Ψ_K ≫ (weilProjectiveSpaceOver K M).hom = p_K) :
    ∃ (C' : AlgebraicGeometry.Scheme.{u})
      (g' : C' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
      (τ' : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C'))
      (ι' : C_K ⟶ C')
      (ιP' : C' ⟶ (weilProjectiveSpaceOver ↥V M).left),
      IsValuationPointedCurveModel V p_K n σ_K C' g' τ' ι' ∧
      AlgebraicGeometry.IsClosedImmersion ιP' ∧
      ιP' ≫ (weilProjectiveSpaceOver ↥V M).hom = g' ∧
      ι' ≫ ιP' = Ψ_K ≫ Φ_KV :=
by
  classical
  have h_integral_img : ∀ (C_K P_V : AlgebraicGeometry.Scheme.{u})
      [AlgebraicGeometry.IsIntegral C_K]
      (j : C_K ⟶ P_V) [AlgebraicGeometry.QuasiCompact j],
      AlgebraicGeometry.IsIntegral j.image := by
    intro C_K P_V _ j _
    have hIrredCK : IrreducibleSpace ↥C_K := AlgebraicGeometry.irreducibleSpace_of_isIntegral C_K
    have hRedCK : AlgebraicGeometry.IsReduced C_K := inferInstance
    have hDense : DenseRange j.toImage.base := AlgebraicGeometry.IsDominant.denseRange (f := j.toImage)
    obtain ⟨z₀⟩ := hIrredCK.toNonempty
    have hIrredImg : IrreducibleSpace ↥j.image :=
      { isPreirreducible_univ := by
          rw [← hDense.closure_eq, ← Set.image_univ]
          exact (hIrredCK.isPreirreducible_univ.image j.toImage.base
            j.toImage.continuous.continuousOn).closure
        toNonempty := ⟨j.toImage.base z₀⟩ }
    have hStalkRed : ∀ x : ↥j.image, _root_.IsReduced ↑(j.image.presheaf.stalk x) := by
      intro x
      obtain ⟨_, ⟨U, hU, rfl⟩, hxU, -⟩ :=
        P_V.isBasis_affineOpens.exists_subset_of_mem_open
          (Set.mem_univ (j.imageι.base x)) isOpen_univ
      let U' : j.image.Opens := j.imageι ⁻¹ᵁ U
      have hxU' : x ∈ U' := hxU
      have hU' : AlgebraicGeometry.IsAffineOpen U' := hU.preimage j.imageι
      let e_sub := j.ker.subschemeObjIso ⟨U, hU⟩
      have h_ker_sub : ∀ a ∈ j.ker.ideal ⟨U, hU⟩, (j.app U).hom a = 0 := by
        intro a ha
        rw [AlgebraicGeometry.Scheme.Hom.ker_apply] at ha
        exact ha
      let φ_inj : (↑Γ(P_V, U) ⧸ j.ker.ideal ⟨U, hU⟩) →+* ↑Γ(C_K, j ⁻¹ᵁ U) :=
        Ideal.Quotient.lift (j.ker.ideal ⟨U, hU⟩) (j.app U).hom h_ker_sub
      have hφ_inj : Function.Injective φ_inj := by
        rw [RingHom.injective_iff_ker_eq_bot, eq_bot_iff]
        intro q hq
        obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective q
        rw [RingHom.mem_ker] at hq
        have hq' : (j.app U).hom a = 0 := by
          simpa [φ_inj] using hq
        have ha : a ∈ j.ker.ideal ⟨U, hU⟩ := by
          rw [AlgebraicGeometry.Scheme.Hom.ker_apply]
          exact hq'
        exact (Submodule.mem_bot _).mpr (Ideal.Quotient.eq_zero_iff_mem.mpr ha)
      have hRedΓ : _root_.IsReduced ↑Γ(j.image, U') :=
        isReduced_of_injective (φ_inj.comp e_sub.hom.hom)
          (hφ_inj.comp e_sub.commRingCatIsoToRingEquiv.injective)
      have hRedSpec : AlgebraicGeometry.IsReduced (AlgebraicGeometry.Spec Γ(j.image, U')) :=
        (AlgebraicGeometry.affine_isReduced_iff Γ(j.image, U')).mpr hRedΓ
      have hRedU' : AlgebraicGeometry.IsReduced U'.toScheme :=
        @AlgebraicGeometry.isReduced_of_isOpenImmersion _ _ hU'.isoSpec.hom inferInstance hRedSpec
      have hStalkU' : _root_.IsReduced ↑(U'.toScheme.presheaf.stalk ⟨x, hxU'⟩) :=
        @AlgebraicGeometry.isReduced_stalk_of_isReduced U'.toScheme hRedU' ⟨x, hxU'⟩
      let e_stalk := (U'.stalkIso ⟨x, hxU'⟩).symm
      exact isReduced_of_injective e_stalk.hom.hom e_stalk.commRingCatIsoToRingEquiv.injective
    have hRedImg : AlgebraicGeometry.IsReduced j.image :=
      @AlgebraicGeometry.isReduced_of_isReduced_stalk j.image hStalkRed
    exact (AlgebraicGeometry.isIntegral_iff_irreducibleSpace_and_isReduced j.image).mpr
      ⟨hIrredImg, hRedImg⟩
  have h_pb_img : ∀ (S_K S_V C_K P_K P_V : AlgebraicGeometry.Scheme.{u})
      (η : S_K ⟶ S_V) (p_K : C_K ⟶ S_K) (π_K : P_K ⟶ S_K) (π_V : P_V ⟶ S_V)
      (Φ : P_K ⟶ P_V) [AlgebraicGeometry.IsOpenImmersion Φ]
      (Ψ_K : C_K ⟶ P_K) [AlgebraicGeometry.IsClosedImmersion Ψ_K]
      [AlgebraicGeometry.QuasiCompact (Ψ_K ≫ Φ)],
      CategoryTheory.IsPullback Φ π_K π_V η →
      Ψ_K ≫ π_K = p_K →
      CategoryTheory.IsPullback (Ψ_K ≫ Φ).toImage p_K ((Ψ_K ≫ Φ).imageι ≫ π_V) η := by
    intro S_K S_V C_K P_K P_V η p_K π_K π_V Φ _ Ψ_K _ _ hPbΦ hCommΨ
    let j := Ψ_K ≫ Φ
    have hKerEq : (AlgebraicGeometry.Scheme.Hom.ker j.imageι).comap Φ =
        AlgebraicGeometry.Scheme.Hom.ker Ψ_K := by
      rw [AlgebraicGeometry.Scheme.IdealSheafData.ker_subschemeι]
      ext W x
      rw [AlgebraicGeometry.Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion, Ideal.mem_comap,
        AlgebraicGeometry.Scheme.Hom.ker_apply, AlgebraicGeometry.Scheme.Hom.ker_apply,
        RingHom.mem_ker, RingHom.mem_ker]
      have h_pre : Φ ⁻¹ᵁ Φ ''ᵁ ↑W = ↑W := AlgebraicGeometry.Scheme.Hom.preimage_image_eq Φ ↑W
      have h_j_pre : j ⁻¹ᵁ Φ ''ᵁ ↑W = Ψ_K ⁻¹ᵁ ↑W := by
        change Ψ_K ⁻¹ᵁ (Φ ⁻¹ᵁ Φ ''ᵁ ↑W) = Ψ_K ⁻¹ᵁ ↑W
        rw [h_pre]
      have h_app : (Φ.appIso ↑W).inv ≫ j.app (Φ ''ᵁ ↑W) =
          Ψ_K.app ↑W ≫ C_K.presheaf.map (CategoryTheory.eqToHom h_j_pre).op := by
        change (Φ.appIso ↑W).inv ≫ (Φ.app (Φ ''ᵁ ↑W) ≫ Ψ_K.app (Φ ⁻¹ᵁ Φ ''ᵁ ↑W)) = _
        rw [← Category.assoc, AlgebraicGeometry.Scheme.Hom.appIso_inv_app Φ ↑W]
        have h_nat := AlgebraicGeometry.Scheme.Hom.naturality Ψ_K (CategoryTheory.eqToHom h_pre).op
        rw [Subsingleton.elim
          ((TopologicalSpace.Opens.map Ψ_K.base).map (CategoryTheory.eqToHom h_pre).op.unop)
          (CategoryTheory.eqToHom h_j_pre)] at h_nat
        exact h_nat
      have h_eval : (j.app (Φ ''ᵁ ↑W)).hom ((Φ.appIso ↑W).inv.hom x) =
          (C_K.presheaf.map (CategoryTheory.eqToHom h_j_pre).op).hom ((Ψ_K.app ↑W).hom x) :=
        ConcreteCategory.congr_hom h_app x
      change (j.app (Φ ''ᵁ ↑W)).hom ((Φ.appIso ↑W).inv.hom x) = 0 ↔ (Ψ_K.app ↑W).hom x = 0
      rw [h_eval]
      constructor
      · intro h0
        have h1 := congrArg (C_K.presheaf.map (CategoryTheory.eqToHom h_j_pre.symm).op).hom h0
        rw [map_zero] at h1
        have h_id : C_K.presheaf.map (CategoryTheory.eqToHom h_j_pre).op ≫
            C_K.presheaf.map (CategoryTheory.eqToHom h_j_pre.symm).op = 𝟙 _ := by
          rw [← CategoryTheory.Functor.map_comp, ← CategoryTheory.op_comp, CategoryTheory.eqToHom_trans,
            CategoryTheory.eqToHom_refl, CategoryTheory.op_id, CategoryTheory.Functor.map_id]
        have h2 := ConcreteCategory.congr_hom h_id ((Ψ_K.app ↑W).hom x)
        exact h2.symm.trans h1
      · intro h0
        rw [h0, map_zero]
    have hPb₁ : CategoryTheory.IsPullback Ψ_K j.toImage Φ j.imageι :=
      AlgebraicGeometry.isPullback_of_isClosedImmersion Ψ_K j.imageι j.toImage Φ
        j.toImage_imageι.symm hKerEq
    have hPb₂ := hPb₁.flip.paste_vert hPbΦ
    rwa [hCommΨ] at hPb₂
  have h_flat_lfp : ∀ (K R : Type u) [Field K] [CommRing R] [IsDomain R] [ValuationRing R]
      (ι_RK : R →+* K), Function.Injective ι_RK →
      (∀ (r : ℕ) (J : Ideal (MvPolynomial (Fin r) R)),
        (∀ (c : R) (f : MvPolynomial (Fin r) R), c ≠ 0 → MvPolynomial.C c * f ∈ J → f ∈ J) →
        J.FG) →
      ∀ (C_K P_V : AlgebraicGeometry.Scheme.{u})
        (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
        (π_V : P_V ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
        (j : C_K ⟶ P_V) [AlgebraicGeometry.QuasiCompact j],
        j ≫ π_V = p_K ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_RK) →
        ∀ (M : ℕ) (U : Fin (M + 1) → P_V.Opens),
