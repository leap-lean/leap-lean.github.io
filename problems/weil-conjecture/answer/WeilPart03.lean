            AlgebraicGeometry.Flat (j.imageι ≫ π_V) ∧
              AlgebraicGeometry.LocallyOfFinitePresentation (j.imageι ≫ π_V) := by
    intro K R _ _ _ _ ι_RK hInj hSatFG C_K P_V p_K π_V j _ hj_comm M U hCov hAff c_V hc_V hPoly
    let g' := j.imageι ≫ π_V
