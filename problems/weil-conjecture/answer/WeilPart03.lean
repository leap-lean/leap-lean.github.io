theorem weil_valuationSubring_local_strictlySemistable_cover (k : Type u) [Field k] [IsAlgClosed k] (m : ℕ)
    (K : Type u) [Field K] [IsSepClosed K] [Algebra k K]
    (V : ValuationSubring K)
    (hkV : ∀ c : k, algebraMap k K c ∈ V)
    (hPkg : IsValuationRingAlgPackage m V)
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (n : ℕ)
    (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (hIntCK : AlgebraicGeometry.IsIntegral C_K)
    (hPropCK : AlgebraicGeometry.IsProper p_K)
    (hSmCK : AlgebraicGeometry.SmoothOfRelativeDimension 1 p_K)
    (hStabCK : IsGeometricStablePointedCurve p_K n σ_K)
    (F : Type u) [Field F] [Algebra k F] [Algebra K F] [IsScalarTower k K F]
    (η_F : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ C_K)
    (hηF_comm : η_F ≫ p_K = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K F)))
    (hFuncF : IsSchemeFunctionField C_K F η_F)
    (hUnif : ∀ (W : ValuationSubring F),
      (∀ c : k, algebraMap k F c ∈ W) →
      Set.Finite (Set.univ : Set (PrimeSpectrum ↥(W.comap (algebraMap K F)))) ∧
      Nat.card (PrimeSpectrum ↥(W.comap (algebraMap K F))) ≤ m + 1 ∧
      ∃ (x : F),
        x ∈ W ∧
        Transcendental K x ∧
        let Lx := IntermediateField.adjoin K ({x} : Set F)
        let Vx := W.comap Lx.val.toRingHom
        RingHom.Etale ((Lx.val.toRingHom.comp Vx.subtype).codRestrict W.toSubring (fun y => y.2)))
    (C₀ : AlgebraicGeometry.Scheme.{u})
    (g₀ : C₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (τ₀ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C₀))
    (ι₀ : C_K ⟶ C₀)
    (hMod₀ : IsValuationPointedCurveModel V p_K n σ_K C₀ g₀ τ₀ ι₀) :
    ∃ (C' : AlgebraicGeometry.Scheme.{u})
      (g' : C' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
      (τ' : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C'))
      (ι' : C_K ⟶ C')
      (π' : C' ⟶ C₀)
      (r : ℕ)
      (U_cov : Fin r → C'.Opens)
      (U_ss : Fin r → AlgebraicGeometry.Scheme.{u})
      (g_ss : ∀ a : Fin r, U_ss a ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
      (h_mod : ∀ a : Fin r, (U_cov a).toScheme ⟶ U_ss a)
      (ι_Ucov : ∀ a : Fin r,
        AlgebraicGeometry.Scheme.Opens.toScheme
          ((TopologicalSpace.Opens.map ι'.base).obj (U_cov a)) ⟶ (U_cov a).toScheme),
      IsValuationPointedCurveModel V p_K n σ_K C' g' τ' ι' ∧
      π' ≫ g₀ = g' ∧
      ι' ≫ π' = ι₀ ∧
      (∀ j : Fin n, τ' j ≫ π' = τ₀ j) ∧
      (⋃ a : Fin r, (U_cov a : Set C')) = Set.univ ∧
      (∀ a : Fin r, Nonempty ↥(U_cov a)) ∧
      (∀ a : Fin r,
        let U_K : C_K.Opens := (TopologicalSpace.Opens.map ι'.base).obj (U_cov a)
        let η_V := AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)
        AlgebraicGeometry.IsAffine (U_ss a) ∧
        IsStrictlySemistableCurveOverValuation V (g_ss a) ∧
        AlgebraicGeometry.IsProper (h_mod a) ∧
        h_mod a ≫ g_ss a = (U_cov a).ι ≫ g' ∧
        ι_Ucov a ≫ (U_cov a).ι = U_K.ι ≫ ι' ∧
        CategoryTheory.IsPullback (ι_Ucov a) (U_K.ι ≫ p_K) ((U_cov a).ι ≫ g') η_V ∧
        CategoryTheory.IsPullback (ι_Ucov a ≫ h_mod a) (U_K.ι ≫ p_K) (g_ss a) η_V) :=
by
  obtain ⟨M₀, ιP₀, hClP₀, hCommP₀⟩ := hMod₀.2.2.2.2.2.1
  obtain ⟨⟨s₀, hs₀, hLocV⟩, hFuncModel, hSmPoles⟩ :=
    weil_valuation_model_functionField_and_smooth_poles K m V hPkg C_K p_K n σ_K
      hIntCK hSmCK hStabCK F η_F hηF_comm hFuncF
  have hSubringCover : ∀ (ξ : Fin (M₀ + 1) → F),
      (∃ r_gen : Fin (M₀ + 1), ξ r_gen ≠ 0) →
      IsStrictlySemistableSubringCoverForCoords V M₀ ξ :=
    fun ξ hξ =>
      weil_etale_rz_cover_by_strictlySemistable_subrings k m K V hkV F hUnif
        (fun x hx_tr Vx hVVx hxVx S₀ hS₀ =>
          weil_rationalFunctionField_valuation_chart_approximation K m V hPkg F
            x hx_tr Vx hVVx hxVx S₀ hS₀)
        M₀ ξ hξ
  exact weil_segre_graph_closure_domination_cover K m V hPkg C_K p_K n σ_K
    hIntCK hPropCK hStabCK F η_F hηF_comm hFuncF
    s₀ hs₀ hLocV hFuncModel hSmPoles
    C₀ g₀ τ₀ ι₀ hMod₀ M₀ ιP₀ hClP₀ hCommP₀ hSubringCover

theorem weil_valuationSubring_nodalQuotient_isDomain_and_isIntegrallyClosed (K : Type u) [Field K] (V : ValuationSubring K) (a : ↥V) (ha : a ≠ 0) :
    IsDomain (MvPolynomial (Fin 2) ↥V ⧸ Ideal.span
      {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}) ∧
    IsIntegrallyClosed (MvPolynomial (Fin 2) ↥V ⧸ Ideal.span
      {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}) :=
by
  let R := ↥V
  have hIC_R : IsIntegrallyClosed R := instIsIntegrallyClosedSubtypeMemValuationSubring V
  let g_a : MvPolynomial (Fin 2) R := MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a
  let I_a : Ideal (MvPolynomial (Fin 2) R) := Ideal.span {g_a}
  let A_nod := MvPolynomial (Fin 2) R ⧸ I_a
  let π : MvPolynomial (Fin 2) R →+* A_nod := Ideal.Quotient.mk I_a
  have hg_mem : g_a ∈ I_a := Ideal.subset_span (Set.mem_singleton g_a)
  let ι₀ : Polynomial R →+* MvPolynomial (Fin 2) R :=
    Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.X 0)
  let ι₁ : Polynomial R →+* MvPolynomial (Fin 2) R :=
    Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.X 1)
  
  have hNorm : ∀ F : MvPolynomial (Fin 2) R,
      ∃ P Q : Polynomial R, F - (ι₀ P + MvPolynomial.X 1 * ι₁ Q) ∈ I_a := by
    intro F
    induction F using MvPolynomial.induction_on with
    | C r =>
      refine ⟨Polynomial.C r, 0, ?_⟩
      have hsub : MvPolynomial.C r - (ι₀ (Polynomial.C r) + MvPolynomial.X 1 * ι₁ 0) = 0 := by
        simp [ι₀, ι₁]
      rw [hsub]
      exact I_a.zero_mem
    | add F₁ F₂ ih₁ ih₂ =>
      obtain ⟨P₁, Q₁, h₁⟩ := ih₁
      obtain ⟨P₂, Q₂, h₂⟩ := ih₂
      refine ⟨P₁ + P₂, Q₁ + Q₂, ?_⟩
      have hsub : (F₁ + F₂) - (ι₀ (P₁ + P₂) + MvPolynomial.X 1 * ι₁ (Q₁ + Q₂)) =
          (F₁ - (ι₀ P₁ + MvPolynomial.X 1 * ι₁ Q₁)) +
            (F₂ - (ι₀ P₂ + MvPolynomial.X 1 * ι₁ Q₂)) := by
        simp only [map_add]
        ring
      rw [hsub]
      exact I_a.add_mem h₁ h₂
    | mul_X F₁ i ih =>
      obtain ⟨P₁, Q₁, h₁⟩ := ih
      have hstep₁ : F₁ * MvPolynomial.X i -
          (ι₀ P₁ + MvPolynomial.X 1 * ι₁ Q₁) * MvPolynomial.X i ∈ I_a := by
        have heq : F₁ * MvPolynomial.X i -
            (ι₀ P₁ + MvPolynomial.X 1 * ι₁ Q₁) * MvPolynomial.X i =
            (F₁ - (ι₀ P₁ + MvPolynomial.X 1 * ι₁ Q₁)) * MvPolynomial.X i := by ring
        rw [heq]
        exact I_a.mul_mem_right _ h₁
      have hi01 : i = 0 ∨ i = 1 := by fin_cases i <;> simp
      rcases hi01 with rfl | rfl
      · let q₀ : R := Q₁.coeff 0
        let Q₁' : Polynomial R := Q₁.divX
        have hQ₁_eq : ι₁ Q₁ = ι₁ Q₁' * MvPolynomial.X 1 + MvPolynomial.C q₀ := by
          have hdiv := (Polynomial.divX_mul_X_add Q₁).symm
          simpa [ι₁, q₀, Q₁'] using congrArg ι₁ hdiv
        refine ⟨P₁ * Polynomial.X + Polynomial.C (a * q₀), Polynomial.C a * Q₁', ?_⟩
        have hstep₂ : (ι₀ P₁ + MvPolynomial.X 1 * ι₁ Q₁) * MvPolynomial.X 0 -
            (ι₀ (P₁ * Polynomial.X + Polynomial.C (a * q₀)) +
              MvPolynomial.X 1 * ι₁ (Polynomial.C a * Q₁')) =
            g_a * ι₁ Q₁ := by
          have hι₀ : ι₀ (P₁ * Polynomial.X + Polynomial.C (a * q₀)) =
              ι₀ P₁ * MvPolynomial.X 0 + MvPolynomial.C a * MvPolynomial.C q₀ := by
            simp [ι₀, map_mul]
          have hι₁ : ι₁ (Polynomial.C a * Q₁') = MvPolynomial.C a * ι₁ Q₁' := by
            simp [ι₁]
          rw [hι₀, hι₁, hQ₁_eq]
          dsimp [g_a]
          ring
        have hmem₂ : (ι₀ P₁ + MvPolynomial.X 1 * ι₁ Q₁) * MvPolynomial.X 0 -
            (ι₀ (P₁ * Polynomial.X + Polynomial.C (a * q₀)) +
              MvPolynomial.X 1 * ι₁ (Polynomial.C a * Q₁')) ∈ I_a := by
          rw [hstep₂]
          exact I_a.mul_mem_right _ hg_mem
        simpa only [sub_add_sub_cancel] using I_a.add_mem hstep₁ hmem₂
      · let p₀ : R := P₁.coeff 0
        let P₁' : Polynomial R := P₁.divX
        have hP₁_eq : ι₀ P₁ = ι₀ P₁' * MvPolynomial.X 0 + MvPolynomial.C p₀ := by
          have hdiv := (Polynomial.divX_mul_X_add P₁).symm
          simpa [ι₀, p₀, P₁'] using congrArg ι₀ hdiv
        refine ⟨Polynomial.C a * P₁', Polynomial.C p₀ + Polynomial.X * Q₁, ?_⟩
        have hstep₂ : (ι₀ P₁ + MvPolynomial.X 1 * ι₁ Q₁) * MvPolynomial.X 1 -
            (ι₀ (Polynomial.C a * P₁') +
              MvPolynomial.X 1 * ι₁ (Polynomial.C p₀ + Polynomial.X * Q₁)) =
            g_a * ι₀ P₁' := by
          have hι₀ : ι₀ (Polynomial.C a * P₁') = MvPolynomial.C a * ι₀ P₁' := by
            simp [ι₀]
          have hι₁ : ι₁ (Polynomial.C p₀ + Polynomial.X * Q₁) =
              MvPolynomial.C p₀ + MvPolynomial.X 1 * ι₁ Q₁ := by
            simp [ι₁]
          rw [hι₀, hι₁, hP₁_eq]
          dsimp [g_a]
          ring
        have hmem₂ : (ι₀ P₁ + MvPolynomial.X 1 * ι₁ Q₁) * MvPolynomial.X 1 -
            (ι₀ (Polynomial.C a * P₁') +
              MvPolynomial.X 1 * ι₁ (Polynomial.C p₀ + Polynomial.X * Q₁)) ∈ I_a := by
          rw [hstep₂]
          exact I_a.mul_mem_right _ hg_mem
        simpa only [sub_add_sub_cancel] using I_a.add_mem hstep₁ hmem₂
  
  have hX_nzd : Submonoid.powers (Polynomial.X : Polynomial R) ≤ nonZeroDivisors (Polynomial R) :=
    Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero Polynomial.X_ne_zero)
  have hDom_L : IsDomain (LaurentPolynomial R) := by
    have hDom_Loc : IsDomain (Localization (Submonoid.powers (Polynomial.X : Polynomial R))) :=
      IsLocalization.isDomain_localization hX_nzd
    let eL := IsLocalization.algEquiv (Submonoid.powers (Polynomial.X : Polynomial R))
      (LaurentPolynomial R) (Localization (Submonoid.powers (Polynomial.X : Polynomial R)))
    exact Function.Injective.isDomain eL.toRingHom eL.injective
  have hIC_Poly : IsIntegrallyClosed (Polynomial R) :=
    instIsIntegrallyClosedPolynomialOfIsDomain
  have hIC_L : IsIntegrallyClosed (LaurentPolynomial R) :=
    isIntegrallyClosed_of_isLocalization (M := Submonoid.powers (Polynomial.X : Polynomial R))
      (LaurentPolynomial R) hX_nzd
  let Φ : MvPolynomial (Fin 2) R →+* LaurentPolynomial R :=
    MvPolynomial.eval₂Hom LaurentPolynomial.C
      (fun i : Fin 2 => if i = 0 then LaurentPolynomial.T 1
        else LaurentPolynomial.C a * LaurentPolynomial.T (-1))
  have hΦ_g : Φ g_a = 0 := by
    have hX0 : Φ (MvPolynomial.X 0) = LaurentPolynomial.T 1 := by simp [Φ]
    have hX1 : Φ (MvPolynomial.X 1) = LaurentPolynomial.C a * LaurentPolynomial.T (-1) := by simp [Φ]
    have hCa : Φ (MvPolynomial.C a) = LaurentPolynomial.C a := by simp [Φ]
    change Φ (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a) = 0
    rw [map_sub, map_mul, hX0, hX1, hCa, mul_left_comm, ← LaurentPolynomial.T_add]
    norm_num [LaurentPolynomial.T_zero]
  have hle_ker : I_a ≤ RingHom.ker Φ := by
    rw [Ideal.span_le, Set.singleton_subset_iff]
    exact hΦ_g
  have hΦ_ι₀_hom : Φ.comp ι₀ = Polynomial.toLaurent := by
    apply Polynomial.ringHom_ext'
    · apply RingHom.ext
      intro r
      simp [Φ, ι₀, Polynomial.toLaurent_C]
    · simp [Φ, ι₀, Polynomial.toLaurent_X]
  have hΦ_ι₀ : ∀ P : Polynomial R, Φ (ι₀ P) = Polynomial.toLaurent P :=
    fun P => RingHom.congr_fun hΦ_ι₀_hom P
  have hmonom_eq : ∀ (m : ℕ) (c : R),
      Polynomial.monomial m c = Polynomial.C c * Polynomial.X ^ m := by
    intro m c
    apply Polynomial.ext
    intro j
    rw [Polynomial.coeff_monomial, Polynomial.coeff_C_mul, Polynomial.coeff_X_pow]
    by_cases hmj : m = j
    · subst hmj; simp
    · have hjm : j ≠ m := Ne.symm hmj
      simp [hmj, hjm]
  have hker_le : RingHom.ker Φ ≤ I_a := by
    intro F hF
    change Φ F = 0 at hF
    obtain ⟨P, Q, hPQ⟩ := hNorm F
    have hΦ_diff : Φ (F - (ι₀ P + MvPolynomial.X 1 * ι₁ Q)) = 0 := hle_ker hPQ
    have hΦ_sum : Φ (ι₀ P) + Φ (MvPolynomial.X 1 * ι₁ Q) = 0 := by
      rw [map_sub, hF, zero_sub, neg_eq_zero, map_add] at hΦ_diff
      exact hΦ_diff
    let N : ℕ := Q.natDegree + 1
    have hQ_sum : Q = ∑ m ∈ Finset.range N, Polynomial.C (Q.coeff m) * Polynomial.X ^ m := by
      have h1 := Polynomial.as_sum_range' Q N (Nat.lt_succ_self _)
      conv_lhs => rw [h1]
      refine Finset.sum_congr rfl fun m _ => hmonom_eq m (Q.coeff m)
    have hterm_Q : Φ (MvPolynomial.X 1 * ι₁ Q) * LaurentPolynomial.T (N : ℤ) =
        Polynomial.toLaurent
          (∑ m ∈ Finset.range N,
            Polynomial.C (Q.coeff m * a ^ (m + 1)) * Polynomial.X ^ (N - 1 - m)) := by
      conv_lhs => rw [hQ_sum]
      rw [map_sum, Finset.mul_sum, map_sum, Finset.sum_mul, map_sum]
      refine Finset.sum_congr rfl fun m hm => ?_
      have hm_lt : m < N := Finset.mem_range.mp hm
      have hX1 : Φ (MvPolynomial.X 1) = LaurentPolynomial.C a * LaurentPolynomial.T (-1) := by
        simp [Φ]
      have hι₁_term : Φ (ι₁ (Polynomial.C (Q.coeff m) * Polynomial.X ^ m)) =
          LaurentPolynomial.C (Q.coeff m) *
            (LaurentPolynomial.C a * LaurentPolynomial.T (-1)) ^ m := by
        simp [ι₁, Φ]
      rw [map_mul, hX1, hι₁_term]
      have hpow : (LaurentPolynomial.C a * LaurentPolynomial.T (-1)) *
            (LaurentPolynomial.C (Q.coeff m) *
              (LaurentPolynomial.C a * LaurentPolynomial.T (-1)) ^ m) =
          LaurentPolynomial.C (Q.coeff m * a ^ (m + 1)) *
            LaurentPolynomial.T (-(m + 1 : ℤ)) := by
        calc
          (LaurentPolynomial.C a * LaurentPolynomial.T (-1)) *
              (LaurentPolynomial.C (Q.coeff m) *
                (LaurentPolynomial.C a * LaurentPolynomial.T (-1)) ^ m)
              = LaurentPolynomial.C (Q.coeff m) *
                  (LaurentPolynomial.C a * LaurentPolynomial.T (-1)) ^ (m + 1) := by
                rw [pow_succ]; ring
          _ = LaurentPolynomial.C (Q.coeff m) *
                ((LaurentPolynomial.C a) ^ (m + 1) * (LaurentPolynomial.T (-1)) ^ (m + 1)) := by
                rw [mul_pow]
          _ = (LaurentPolynomial.C (Q.coeff m) * LaurentPolynomial.C (a ^ (m + 1))) *
                LaurentPolynomial.T (↑(m + 1) * (-1)) := by
                rw [← map_pow, LaurentPolynomial.T_pow, mul_assoc]
          _ = LaurentPolynomial.C (Q.coeff m * a ^ (m + 1)) *
                LaurentPolynomial.T (-(m + 1 : ℤ)) := by
                rw [← map_mul]
                congr 2
                push_cast
                ring
      rw [hpow, mul_assoc, ← LaurentPolynomial.T_add]
      have hexp : -(m + 1 : ℤ) + (N : ℤ) = ((N - 1 - m : ℕ) : ℤ) := by omega
      rw [hexp, Polynomial.toLaurent.map_mul, Polynomial.toLaurent_C, Polynomial.toLaurent_X_pow]
    have hL_eq : Polynomial.toLaurent
        (P * Polynomial.X ^ N +
          ∑ m ∈ Finset.range N,
            Polynomial.C (Q.coeff m * a ^ (m + 1)) * Polynomial.X ^ (N - 1 - m)) = 0 := by
      rw [map_add, map_mul, Polynomial.toLaurent_X_pow, ← hΦ_ι₀ P, ← hterm_Q, ← add_mul,
        hΦ_sum, zero_mul]
    have hPoly_eq : P * Polynomial.X ^ N +
        ∑ m ∈ Finset.range N,
          Polynomial.C (Q.coeff m * a ^ (m + 1)) * Polynomial.X ^ (N - 1 - m) = 0 :=
      Polynomial.toLaurent_eq_zero.mp hL_eq
    have hP0 : P = 0 := by
      apply Polynomial.ext
      intro k
      rw [Polynomial.coeff_zero]
      have hc := congrArg (fun f : Polynomial R => f.coeff (k + N)) hPoly_eq
      simp only [Polynomial.coeff_add, Polynomial.coeff_zero, Polynomial.coeff_mul_X_pow,
        Polynomial.finsetSum_coeff, Polynomial.coeff_C_mul, Polynomial.coeff_X_pow] at hc
      have hsum0 : (∑ x ∈ Finset.range N,
          Q.coeff x * a ^ (x + 1) * if k + N = N - 1 - x then 1 else 0) = 0 := by
        refine Finset.sum_eq_zero fun x hx => ?_
        have hx_lt : x < N := Finset.mem_range.mp hx
        have hne : k + N ≠ N - 1 - x := by omega
        simp [hne]
      rw [hsum0, add_zero] at hc
      exact hc
    rw [hP0, zero_mul, zero_add] at hPoly_eq
    have hQ0 : Q = 0 := by
      apply Polynomial.ext
      intro m
      rw [Polynomial.coeff_zero]
      by_cases hm : m < N
      · have hc := congrArg (fun f : Polynomial R => f.coeff (N - 1 - m)) hPoly_eq
        simp only [Polynomial.coeff_zero, Polynomial.finsetSum_coeff,
          Polynomial.coeff_C_mul, Polynomial.coeff_X_pow] at hc
        have hsum_eq : (∑ x ∈ Finset.range N,
            Q.coeff x * a ^ (x + 1) * if N - 1 - m = N - 1 - x then 1 else 0) =
            Q.coeff m * a ^ (m + 1) := by
          rw [Finset.sum_eq_single m]
          · simp
          · intro x hx hxm
            have hx_lt : x < N := Finset.mem_range.mp hx
            have hne : N - 1 - m ≠ N - 1 - x := by omega
            simp [hne]
          · intro hm_not
            exact False.elim (hm_not (Finset.mem_range.mpr hm))
        rw [hsum_eq] at hc
        rcases mul_eq_zero.mp hc with hQm | hapow
        · exact hQm
        · exact False.elim (pow_ne_zero (m + 1) ha hapow)
      · exact Polynomial.coeff_eq_zero_of_natDegree_lt (Nat.lt_of_succ_le (Nat.not_lt.mp hm))
    have hF_eq : F = F - (ι₀ P + MvPolynomial.X 1 * ι₁ Q) := by
      simp [hP0, hQ0]
    rw [hF_eq]
    exact hPQ
  let barΦ : A_nod →+* LaurentPolynomial R :=
    Ideal.Quotient.lift I_a Φ (fun x hx => hle_ker hx)
  have hInj_barΦ : Function.Injective barΦ := by
    rw [injective_iff_map_eq_zero]
    intro x hx
    obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective x
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (hker_le hx)
  have hDom_A : IsDomain A_nod :=
    Function.Injective.isDomain barΦ hInj_barΦ
  
  let u : A_nod := π (MvPolynomial.X 0)
  let v : A_nod := π (MvPolynomial.X 1)
