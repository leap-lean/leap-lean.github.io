      obtain ⟨U₀, hLI_U₀, hOrth_U₀, hSpan_U₀⟩ := hex_U₀
      have hp0_Lalg : (p : ↥L1_coeff) = 0 := by
        apply Subtype.ext; exact hp0_L₁
      have _ : CharP ↥L1_coeff p := hCharP_of_zero ↥L1_coeff hp0_Lalg
      let fam : Option (ℕ × ↥U₀) → ↥L1_coeff := fun idx =>
        match idx with
        | none => 1
        | some (n, u) => (u : ↥L1_coeff) ^ (p ^ n)
      let lvl : Option (ℕ × ↥U₀) → ℕ := fun idx =>
        match idx with
        | none => 0
        | some (n, _) => n
      have hLI_fam : LinearIndependent ↥E_max fam := by
        have hSumPowLalg : ∀ {ι : Type u} (S : Finset ι) (f : ι → ↥L1_coeff),
