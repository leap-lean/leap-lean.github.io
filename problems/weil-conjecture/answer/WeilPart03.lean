      rw [Polynomial.aeval_def, Polynomial.eval₂_map]
      have hcomp : (algebraMap F₂ L').comp e.toRingHom = algebraMap F₁ L' := RingHom.ext hcomm
      rw [hcomp, ← Polynomial.aeval_def]
