        · have hc_val : σ.1 = π₁'.1 * c_div.1 := congrArg Subtype.val hc_div
          have h_eq : (σ.1) ^ q.2 / q.1 = ((π₁'.1) ^ q.2 / q.1) * (c_div.1) ^ q.2 := by
            rw [hc_val, mul_pow, mul_div_right_comm]
