    let g : Polynomial ↥OL :=
      Polynomial.X ^ n + ∑ i ∈ Finset.range n, Polynomial.C (a_coeff i) * Polynomial.X ^ i
    have hsum_coeff : ∀ k : ℕ,
        (∑ i ∈ Finset.range n, Polynomial.C (a_coeff i) * Polynomial.X ^ i).coeff k =
