            rw [norm_mul, norm_mul, hIsoBase (a i), hIsoBase (a j)] at hnorm_eq
            change ‖((b i : ↥K'_int) : N)‖⁻¹ * ‖((b j : ↥K'_int) : N)‖ =
              ‖(a i : F_hat)‖ * ‖(a j : F_hat)‖⁻¹
            have h1 : ‖((b i : ↥K'_int) : N)‖ ≠ 0 := norm_ne_zero_iff.mpr hbi_ne
            have h2 : ‖((b j : ↥K'_int) : N)‖ ≠ 0 := norm_ne_zero_iff.mpr hbj_ne
            have h3 : ‖(a i : F_hat)‖ ≠ 0 := norm_ne_zero_iff.mpr (fun h0 => hai_ne (Subtype.ext h0))
            have h4 : ‖(a j : F_hat)‖ ≠ 0 := norm_ne_zero_iff.mpr (fun h0 => haj_ne (Subtype.ext h0))
            field_simp
            linarith
          have hq_eq : QuotientGroup.mk (s := H_val) (u_rep i) =
              QuotientGroup.mk (s := H_val) (u_rep j) := QuotientGroup.eq.mpr hmem_H
          have hgi : QuotientGroup.mk (s := H_val) (u_rep i) = g i := Quotient.out_eq (g i)
          have hgj : QuotientGroup.mk (s := H_val) (u_rep j) = g j := Quotient.out_eq (g j)
