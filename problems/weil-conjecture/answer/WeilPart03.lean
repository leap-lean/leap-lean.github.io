    (V : ValuationSubring K) (M : ℕ)
    (C' : AlgebraicGeometry.Scheme.{u})
    (g' : C' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (ιP : C' ⟶ (weilProjectiveSpaceOver ↥V M).left)
    (U' : C'.Opens)
    (U_ss : AlgebraicGeometry.Scheme.{u})
    (g_ss : U_ss ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (h_mod : U'.toScheme ⟶ U_ss)
    (hProp_g' : AlgebraicGeometry.IsProper g')
    (hCl_ιP : AlgebraicGeometry.IsClosedImmersion ιP)
    (hιP_comm : ιP ≫ (weilProjectiveSpaceOver ↥V M).hom = g')
    (hSep_ss : AlgebraicGeometry.IsSeparated g_ss)
    (hProp_mod : AlgebraicGeometry.IsProper h_mod)
    (hComm_mod : h_mod ≫ g_ss = U'.ι ≫ g') :
    ∃ (Γ : U'.toScheme ⟶ CategoryTheory.Limits.pullback (weilProjectiveSpaceOver ↥V M).hom g_ss),
      AlgebraicGeometry.IsClosedImmersion Γ ∧
      Γ ≫ CategoryTheory.Limits.pullback.fst (weilProjectiveSpaceOver ↥V M).hom g_ss = U'.ι ≫ ιP ∧
      Γ ≫ CategoryTheory.Limits.pullback.snd (weilProjectiveSpaceOver ↥V M).hom g_ss = h_mod :=
by
  let _ := hSep_ss
  let P_hom := (weilProjectiveSpaceOver ↥V M).hom
  let q₁ := CategoryTheory.Limits.pullback.fst g' g_ss
  let q₂ := CategoryTheory.Limits.pullback.snd g' g_ss
  let Γ₀ : U'.toScheme ⟶ CategoryTheory.Limits.pullback g' g_ss :=
    CategoryTheory.Limits.pullback.lift U'.ι h_mod hComm_mod.symm
  have hΓ₀_fst : Γ₀ ≫ q₁ = U'.ι := CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hΓ₀_snd : Γ₀ ≫ q₂ = h_mod := CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hImm_comp : AlgebraicGeometry.IsImmersion (Γ₀ ≫ q₁) := by
    rw [hΓ₀_fst]
    infer_instance
  have hImm_Γ₀ : AlgebraicGeometry.IsImmersion Γ₀ :=
    @AlgebraicGeometry.IsImmersion.of_comp _ _ _ Γ₀ q₁ hImm_comp
  have hPre_Γ₀ : AlgebraicGeometry.IsPreimmersion Γ₀ := hImm_Γ₀.toIsPreimmersion
  have hSep_g' : AlgebraicGeometry.IsSeparated g' := hProp_g'.toIsSeparated
  have hSep_q₂ : AlgebraicGeometry.IsSeparated q₂ :=
    @AlgebraicGeometry.IsSeparated.instSndScheme _ _ _ g' g_ss hSep_g'
  have hProp_comp : AlgebraicGeometry.IsProper (Γ₀ ≫ q₂) := by
    rw [hΓ₀_snd]
    exact hProp_mod
  have hProp_Γ₀ : AlgebraicGeometry.IsProper Γ₀ :=
    @AlgebraicGeometry.IsProper.of_comp _ _ _ Γ₀ q₂ hProp_comp hSep_q₂
  have hUniv_Γ₀ : AlgebraicGeometry.UniversallyClosed Γ₀ := hProp_Γ₀.toUniversallyClosed
  have hClRange_Γ₀ : IsClosed (Set.range Γ₀.base) :=
    (@AlgebraicGeometry.Scheme.Hom.isClosedMap _ _ Γ₀ hUniv_Γ₀).isClosed_range
  have hCl_Γ₀ : AlgebraicGeometry.IsClosedImmersion Γ₀ :=
    @AlgebraicGeometry.IsClosedImmersion.of_isPreimmersion _ _ Γ₀ hPre_Γ₀ hClRange_Γ₀
  let p₁ := CategoryTheory.Limits.pullback.fst P_hom g_ss
  let p₂ := CategoryTheory.Limits.pullback.snd P_hom g_ss
  have hγ₃_comm : (q₁ ≫ ιP) ≫ P_hom = q₂ ≫ g_ss := by
    rw [CategoryTheory.Category.assoc, hιP_comm, CategoryTheory.Limits.pullback.condition]
  let γ₃ : CategoryTheory.Limits.pullback g' g_ss ⟶ CategoryTheory.Limits.pullback P_hom g_ss :=
    CategoryTheory.Limits.pullback.lift (q₁ ≫ ιP) q₂ hγ₃_comm
  have hγ₃_fst : γ₃ ≫ p₁ = q₁ ≫ ιP := CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hγ₃_snd : γ₃ ≫ p₂ = q₂ := CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hPb_outer : CategoryTheory.IsPullback q₁ (γ₃ ≫ p₂) (ιP ≫ P_hom) g_ss := by
    rw [hγ₃_snd, hιP_comm]
    exact CategoryTheory.IsPullback.of_hasPullback g' g_ss
  have hPb_bot : CategoryTheory.IsPullback p₁ p₂ P_hom g_ss :=
    CategoryTheory.IsPullback.of_hasPullback P_hom g_ss
  have hPb_top : CategoryTheory.IsPullback q₁ γ₃ ιP p₁ :=
    CategoryTheory.IsPullback.of_bot hPb_outer hγ₃_fst.symm hPb_bot
  have hCl_γ₃ : AlgebraicGeometry.IsClosedImmersion γ₃ :=
    AlgebraicGeometry.IsClosedImmersion.isStableUnderBaseChange.of_isPullback hPb_top hCl_ιP
  have hCl_Γ : AlgebraicGeometry.IsClosedImmersion (Γ₀ ≫ γ₃) :=
    @AlgebraicGeometry.IsClosedImmersion.comp _ _ _ Γ₀ γ₃ hCl_Γ₀ hCl_γ₃
  refine ⟨Γ₀ ≫ γ₃, hCl_Γ, ?_, ?_⟩
  · rw [CategoryTheory.Category.assoc, hγ₃_fst, ← CategoryTheory.Category.assoc, hΓ₀_fst]
  · rw [CategoryTheory.Category.assoc, hγ₃_snd, hΓ₀_snd]

theorem weil_projective_closure_divisorial_point_specialization (K : Type u) [Field K]
    (V : ValuationSubring K) (M : ℕ)
    (Y U_ss : AlgebraicGeometry.Scheme.{u})
    (g_ss : U_ss ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (h_mod : Y ⟶ U_ss)
    (Γ : Y ⟶ CategoryTheory.Limits.pullback (weilProjectiveSpaceOver ↥V M).hom g_ss)
    (y : Y) (U : Y.Opens) (hU : AlgebraicGeometry.IsAffineOpen U) (hyU : y ∈ U)
    (f : ↑(Y.presheaf.obj (Opposite.op U)))
    (D_u : Type u) [CommRing D_u] [IsDomain D_u] [ValuationRing D_u]
    (ι_D : AlgebraicGeometry.Spec (CommRingCat.of D_u) ⟶ U_ss)
    (m_D : AlgebraicGeometry.Spec (CommRingCat.of D_u))
    (L_y : Type u) [Field L_y]
    (φ_UL : ↑(Y.presheaf.obj (Opposite.op U)) →+* L_y)
    (ι_DL : D_u →+* L_y)
    (hProp_mod : AlgebraicGeometry.IsProper h_mod)
    (hCl_Γ : AlgebraicGeometry.IsClosedImmersion Γ)
    (hΓ_snd : Γ ≫ CategoryTheory.Limits.pullback.snd (weilProjectiveSpaceOver ↥V M).hom g_ss = h_mod)
    (hCl_ιD : AlgebraicGeometry.IsClosedImmersion ι_D)
    (hm_D : m_D.asIdeal = IsLocalRing.maximalIdeal D_u)
    (hker_φUL : RingHom.ker φ_UL = (hU.primeIdealOf ⟨y, hyU⟩).asIdeal)
    (hComm_L : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_DL) ≫ ι_D =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_UL) ≫ hU.fromSpec ≫ h_mod)
    (hTrans_D : ∀ Q_D : Polynomial D_u, Q_D ≠ 0 → Polynomial.eval₂ ι_DL (φ_UL f) Q_D ≠ 0)
    (hVand : ∀ (N : ℕ) (Q : Fin N → Ideal (MvPolynomial (Fin (M + 1)) ↥V)),
      (∀ r : Fin N,
        (Q r).IsPrime ∧
        Ideal.comap MvPolynomial.C (Q r) = (g_ss.base (ι_D.base m_D)).asIdeal ∧
        (∃ i : Fin (M + 1), MvPolynomial.X i ∉ Q r)) →
      ∃ α : ↥V,
        (∑ i : Fin (M + 1), MvPolynomial.C (α ^ i.1) * MvPolynomial.X i) ∈
          MvPolynomial.homogeneousSubmodule (Fin (M + 1)) ↥V 1 ∧
        ∀ r : Fin N,
          (∑ i : Fin (M + 1), MvPolynomial.C (α ^ i.1) * MvPolynomial.X i) ∉ Q r) :
    ∃ (y₀ : Y) (V₀ : Y.Opens) (hV₀ : AlgebraicGeometry.IsAffineOpen V₀) (hy₀ : y₀ ∈ V₀),
      y₀ ∈ closure ({y} : Set Y) ∧
      h_mod.base y₀ = ι_D.base m_D ∧
      let p_y₀ := (hV₀.primeIdealOf ⟨y₀, hy₀⟩).asIdeal
      let γ_B₀ := (Ideal.Quotient.mk p_y₀).comp
        (AlgebraicGeometry.Spec.preimage (hV₀.fromSpec ≫ h_mod ≫ g_ss)).hom
      ¬ ∀ d : ↑(Y.presheaf.obj (Opposite.op V₀)) ⧸ p_y₀,
          (∃ q : ↥V, d = γ_B₀ q) ∨
          (∃ q : ↥V, q ∉ (g_ss.base (ι_D.base m_D)).asIdeal ∧ γ_B₀ q * d = 1) :=
by
  by_contra hNotEx
  have hAllLin : ∀ (y₀ : Y) (V₀ : Y.Opens) (hV₀ : AlgebraicGeometry.IsAffineOpen V₀)
      (hy₀ : y₀ ∈ V₀),
      y₀ ∈ closure ({y} : Set Y) →
      h_mod.base y₀ = ι_D.base m_D →
      let p_y₀ := (hV₀.primeIdealOf ⟨y₀, hy₀⟩).asIdeal
      let γ_B₀ := (Ideal.Quotient.mk p_y₀).comp
        (AlgebraicGeometry.Spec.preimage (hV₀.fromSpec ≫ h_mod ≫ g_ss)).hom
      ∀ d : ↑(Y.presheaf.obj (Opposite.op V₀)) ⧸ p_y₀,
        (∃ q : ↥V, d = γ_B₀ q) ∨
        (∃ q : ↥V, q ∉ (g_ss.base (ι_D.base m_D)).asIdeal ∧ γ_B₀ q * d = 1) := by
    intro y₀ V₀ hV₀ hy₀ hy₀_cl hy₀_mod
    exact Classical.not_not.mp fun hNot => hNotEx ⟨y₀, V₀, hV₀, hy₀, hy₀_cl, hy₀_mod, hNot⟩
  
  have hStep1 : ∃ (Z : AlgebraicGeometry.Scheme.{u})
      (j_Z : Z ⟶ Y)
      (e_Z : AlgebraicGeometry.Spec (CommRingCat.of L_y) ⟶ Z)
      (π_Z : Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of D_u))
      (q_P : Z ⟶ (weilProjectiveSpaceOver ↥V M).left),
      AlgebraicGeometry.IsClosedImmersion j_Z ∧
      e_Z ≫ j_Z = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_UL) ≫ hU.fromSpec ∧
      Set.range j_Z.base ⊆ closure ({y} : Set Y) ∧
      AlgebraicGeometry.IsProper π_Z ∧
      π_Z ≫ ι_D = j_Z ≫ h_mod ∧
      e_Z ≫ π_Z = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_DL) ∧
      AlgebraicGeometry.IsAffineHom q_P ∧
      q_P ≫ (weilProjectiveSpaceOver ↥V M).hom = π_Z ≫ ι_D ≫ g_ss := by
    let ι_y : AlgebraicGeometry.Spec (CommRingCat.of L_y) ⟶ Y :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_UL) ≫ hU.fromSpec
    have hιy_pt : ∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of L_y)), ι_y.base pt = y := by
      intro pt
      have : pt.asIdeal.IsPrime := pt.isPrime
      have hpt_bot : pt.asIdeal = ⊥ := Ideal.eq_bot_of_prime pt.asIdeal
      have hmap_eq : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_UL)).base pt =
          hU.primeIdealOf ⟨y, hyU⟩ := by
        apply PrimeSpectrum.ext
        change Ideal.comap φ_UL pt.asIdeal = (hU.primeIdealOf ⟨y, hyU⟩).asIdeal
        rw [hpt_bot]
        exact hker_φUL
      change hU.fromSpec.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_UL)).base pt) = y
      rw [hmap_eq]
      exact hU.fromSpec_primeIdealOf ⟨y, hyU⟩
    let Z : AlgebraicGeometry.Scheme.{u} := ι_y.image
    let j_Z : Z ⟶ Y := ι_y.imageι
    let e_Z : AlgebraicGeometry.Spec (CommRingCat.of L_y) ⟶ Z := ι_y.toImage
    have hCl_jZ : AlgebraicGeometry.IsClosedImmersion j_Z := inferInstance
    have he_jZ : e_Z ≫ j_Z = ι_y := ι_y.toImage_imageι
    have : AlgebraicGeometry.QuasiCompact ι_y :=
      ⟨fun _ _ _ => (Set.toFinite _).isCompact⟩
    have hDom_eZ : AlgebraicGeometry.IsDominant e_Z := inferInstance
    have hDense_eZ : DenseRange e_Z.base := (AlgebraicGeometry.isDominant_iff e_Z).mp hDom_eZ
    have hrange_jZ : Set.range j_Z.base ⊆ closure ({y} : Set Y) := by
      rintro _ ⟨z, rfl⟩
      have hz_cl : z ∈ closure (Set.range e_Z.base) := hDense_eZ z
      have himg : j_Z.base z ∈ closure (j_Z.base '' Set.range e_Z.base) :=
        image_closure_subset_closure_image j_Z.base.hom.continuous ⟨z, hz_cl, rfl⟩
      have hsub : j_Z.base '' Set.range e_Z.base ⊆ ({y} : Set Y) := by
        rintro _ ⟨_, ⟨pt, rfl⟩, rfl⟩
        change (e_Z ≫ j_Z).base pt ∈ ({y} : Set Y)
        rw [he_jZ]
        exact Set.mem_singleton_iff.mpr (hιy_pt pt)
      exact closure_mono hsub himg
    let q₁ := CategoryTheory.Limits.pullback.fst h_mod ι_D
    let q₂ := CategoryTheory.Limits.pullback.snd h_mod ι_D
    let ι_tilde := CategoryTheory.Limits.pullback.lift ι_y
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_DL))
      (by simpa only [CategoryTheory.Category.assoc, ι_y] using hComm_L.symm)
    have hker_le : q₁.ker ≤ j_Z.ker := by
      have h1 : q₁.ker ≤ (ι_tilde ≫ q₁).ker := AlgebraicGeometry.Scheme.Hom.le_ker_comp ι_tilde q₁
      have h2 : ι_tilde ≫ q₁ = ι_y := CategoryTheory.Limits.pullback.lift_fst _ _ _
      have h3 : j_Z.ker = ι_y.ker :=
        AlgebraicGeometry.Scheme.IdealSheafData.ker_subschemeι ι_y.ker
      rw [h2] at h1
      rwa [h3]
    let ℓ_D := AlgebraicGeometry.IsClosedImmersion.lift q₁ j_Z hker_le
    have hℓ_fac : ℓ_D ≫ q₁ = j_Z := AlgebraicGeometry.IsClosedImmersion.lift_fac q₁ j_Z hker_le
    let π_Z : Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of D_u) := ℓ_D ≫ q₂
    have hπZ_comm : π_Z ≫ ι_D = j_Z ≫ h_mod := by
      dsimp [π_Z]
      rw [CategoryTheory.Category.assoc, ← CategoryTheory.Limits.pullback.condition,
        ← CategoryTheory.Category.assoc, hℓ_fac]
    have he_πZ : e_Z ≫ π_Z = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_DL) := by
      apply (cancel_mono ι_D).mp
      rw [CategoryTheory.Category.assoc, hπZ_comm, ← CategoryTheory.Category.assoc, he_jZ]
      simpa only [CategoryTheory.Category.assoc, ι_y] using hComm_L.symm
    have hProp_comp : AlgebraicGeometry.IsProper (π_Z ≫ ι_D) := by
      rw [hπZ_comm]
      infer_instance
    have hProp_πZ : AlgebraicGeometry.IsProper π_Z :=
      @AlgebraicGeometry.IsProper.of_comp _ _ _ π_Z ι_D hProp_comp inferInstance
    let P_V := weilProjectiveSpaceOver ↥V M
    let g_D : AlgebraicGeometry.Spec (CommRingCat.of D_u) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of ↥V) := ι_D ≫ g_ss
    let q_P : Z ⟶ P_V.left :=
      j_Z ≫ Γ ≫ CategoryTheory.Limits.pullback.fst P_V.hom g_ss
    have hqP_comm : q_P ≫ P_V.hom = π_Z ≫ g_D := by
      dsimp [q_P, g_D]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        CategoryTheory.Limits.pullback.condition, ← CategoryTheory.Category.assoc Γ, hΓ_snd,
        ← CategoryTheory.Category.assoc j_Z, ← hπZ_comm, CategoryTheory.Category.assoc]
    let j'_Z : Z ⟶ CategoryTheory.Limits.pullback P_V.hom g_D :=
      CategoryTheory.Limits.pullback.lift q_P π_Z hqP_comm
    let β_D : CategoryTheory.Limits.pullback P_V.hom g_D ⟶
        CategoryTheory.Limits.pullback P_V.hom g_ss :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst P_V.hom g_D)
        (CategoryTheory.Limits.pullback.snd P_V.hom g_D ≫ ι_D)
        (by
          rw [CategoryTheory.Category.assoc]
          exact CategoryTheory.Limits.pullback.condition)
    have : CategoryTheory.Mono β_D := by
      refine ⟨fun a b hab => ?_⟩
      apply CategoryTheory.Limits.pullback.hom_ext
      · have hfst := congrArg (· ≫ CategoryTheory.Limits.pullback.fst P_V.hom g_ss) hab
        dsimp only [β_D] at hfst
        rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst] at hfst
        exact hfst
      · have hsnd := congrArg (· ≫ CategoryTheory.Limits.pullback.snd P_V.hom g_ss) hab
        dsimp only [β_D] at hsnd
        rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc] at hsnd
        exact (cancel_mono ι_D).mp hsnd
    have hSep_β : AlgebraicGeometry.IsSeparated β_D :=
      AlgebraicGeometry.IsSeparated.isSeparated_of_mono β_D
    have hj'_β : j'_Z ≫ β_D = j_Z ≫ Γ := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · dsimp only [j'_Z, β_D, q_P]
        rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.assoc]
      · dsimp only [j'_Z, β_D]
        rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          hπZ_comm]
        change j_Z ≫ h_mod = (j_Z ≫ Γ) ≫ CategoryTheory.Limits.pullback.snd
          (weilProjectiveSpaceOver ↥V M).hom g_ss
        rw [CategoryTheory.Category.assoc, hΓ_snd]
    have hCl_j'β : AlgebraicGeometry.IsClosedImmersion (j'_Z ≫ β_D) := by
      rw [hj'_β]
      infer_instance
    have : AlgebraicGeometry.IsClosedImmersion j'_Z :=
      @AlgebraicGeometry.IsClosedImmersion.of_comp _ _ _ j'_Z β_D hCl_j'β hSep_β
    have hgD_aff : AlgebraicGeometry.IsAffineHom g_D := by
      rw [← AlgebraicGeometry.Spec.map_preimage g_D]
      infer_instance
    have : AlgebraicGeometry.IsAffineHom
        (CategoryTheory.Limits.pullback.fst P_V.hom g_D) :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback P_V.hom g_D).flip hgD_aff
    have hAff_qP : AlgebraicGeometry.IsAffineHom q_P := by
      have hfac : j'_Z ≫ CategoryTheory.Limits.pullback.fst P_V.hom g_D = q_P :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      rw [← hfac]
      infer_instance
    exact ⟨Z, j_Z, e_Z, π_Z, q_P, hCl_jZ, he_jZ, hrange_jZ, hProp_πZ, hπZ_comm,
      he_πZ, hAff_qP, hqP_comm⟩
  obtain ⟨Z, j_Z, e_Z, π_Z, q_P, hCl_jZ, he_jZ, hrange_jZ, hProp_πZ, hπZ_comm,
      he_πZ, hAff_qP, hqP_comm⟩ := hStep1
  
  have hStep2 : {z : Z | π_Z.base z = m_D}.Finite := by
    let k_D : Type u := IsLocalRing.ResidueField D_u
    let res_D : D_u →+* k_D := IsLocalRing.residue D_u
    let s_k : AlgebraicGeometry.Spec (CommRingCat.of k_D) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of D_u) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom res_D)
    have : AlgebraicGeometry.IsClosedImmersion s_k :=
      AlgebraicGeometry.IsClosedImmersion.spec_of_surjective
        (CommRingCat.ofHom res_D) IsLocalRing.residue_surjective
    have hsk_pt : ∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of k_D)), s_k.base pt = m_D := by
      intro pt
      have : pt.asIdeal.IsPrime := pt.isPrime
      have hpt_bot : pt.asIdeal = ⊥ := Ideal.eq_bot_of_prime pt.asIdeal
      apply PrimeSpectrum.ext
      change Ideal.comap res_D pt.asIdeal = m_D.asIdeal
      rw [hpt_bot, hm_D]
      exact IsLocalRing.ker_residue
    have hrange_sk : Set.range s_k.base = {m_D} := by
      ext q
      simp only [Set.mem_range, Set.mem_singleton_iff]
      refine ⟨fun ⟨pt, hpt⟩ => hpt ▸ hsk_pt pt, fun hq => ?_⟩
      subst hq
      let pt₀ : AlgebraicGeometry.Spec (CommRingCat.of k_D) := IsLocalRing.closedPoint k_D
      exact ⟨pt₀, hsk_pt pt₀⟩
    let Z₀ : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback π_Z s_k
    let p₁ : Z₀ ⟶ Z := CategoryTheory.Limits.pullback.fst π_Z s_k
    let p₂ : Z₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of k_D) :=
      CategoryTheory.Limits.pullback.snd π_Z s_k
    let f_Z0Y : Z₀ ⟶ Y := p₁ ≫ j_Z
    have : AlgebraicGeometry.IsClosedImmersion f_Z0Y := inferInstance
    have : AlgebraicGeometry.IsAffineHom f_Z0Y := inferInstance
    have : AlgebraicGeometry.IsProper p₂ := inferInstance
    have : CompactSpace ↥Z₀ :=
      AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace p₂
    have hChartFin : ∀ (V₀ : Y.Opens), AlgebraicGeometry.IsAffineOpen V₀ →
        (((TopologicalSpace.Opens.map f_Z0Y.base).obj V₀ : Z₀.Opens) : Set ↥Z₀).Finite := by
      intro V₀ hV₀
      let U'₀ : Z₀.Opens := (TopologicalSpace.Opens.map f_Z0Y.base).obj V₀
      let hU'₀ : AlgebraicGeometry.IsAffineOpen U'₀ := hV₀.preimage f_Z0Y
      let E₀ : Type u := ↑(Z₀.presheaf.obj (Opposite.op U'₀))
      let T_k : (AlgebraicGeometry.Spec (CommRingCat.of k_D)).Opens := ⊤
      let hT_k : AlgebraicGeometry.IsAffineOpen T_k :=
        AlgebraicGeometry.isAffineOpen_top (AlgebraicGeometry.Spec (CommRingCat.of k_D))
      have he_top : U'₀ ≤ (TopologicalSpace.Opens.map p₂.base).obj T_k := fun _ _ => trivial
      have hFT_app : (p₂.appLE T_k U'₀ he_top).hom.FiniteType :=
        AlgebraicGeometry.Scheme.Hom.finiteType_appLE p₂ hT_k hU'₀ he_top
