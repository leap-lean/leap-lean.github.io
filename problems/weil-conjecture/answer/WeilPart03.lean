    refine hChartIC u barΦ hInj_barΦ hbarΦ_u ?_
    intro P
    exact ⟨π (ι₀ P), hΦ_ι₀ P⟩
  let swapHom : MvPolynomial (Fin 2) R →+* MvPolynomial (Fin 2) R :=
