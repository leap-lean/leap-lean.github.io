        rw [map_mul, map_zpow₀, norm_mul, norm_zpow]
        change ‖c'‖ * r ^ m = ‖algebraMap K_hat F_hat c'‖ * r ^ m
        rw [hIsoK]

    let t₀_K' : ↥K'_int := algebraMap ↥K_base ↥K'_int ⟨T₀, hT₀_mem⟩
    have ht₀_K'_ne : t₀_K' ≠ 0 :=
      hMapNeZero (algebraMap ↥K_base ↥K'_int) (fun h0 => hT₀_ne (congrArg Subtype.val h0))
    let w_T₀ : (↥K'_int)ˣ := Units.mk0 t₀_K' ht₀_K'_ne
    have hNu'WT₀ : ν' w_T₀ = (n_tame : ℤ) := by
      rw [hNu'Iff]
      refine ⟨1, one_ne_zero, ?_⟩
      change ‖algebraMap ↥K_base N ⟨T₀, hT₀_mem⟩‖ ^ n_tame = ‖(1 : K_hat)‖ * r ^ (n_tame : ℤ)
      rw [hIsoBase, norm_one, one_mul, zpow_natCast]
    let P_pos : ℕ → Prop := fun n => 0 < n ∧ ∃ w : (↥K'_int)ˣ, ν' w = (n : ℤ)
    have hExP : ∃ n : ℕ, P_pos n := ⟨n_tame, hn_pos, w_T₀, hNu'WT₀⟩
    let k_min : ℕ := Nat.find hExP
    obtain ⟨hk_pos, w₀, hw₀_nu⟩ := Nat.find_spec hExP
    have hk_dvd_all : ∀ w : (↥K'_int)ˣ, ∃ m : ℤ, ν' w = (k_min : ℤ) * m := by
      intro w
      let k₀ : ℤ := (k_min : ℤ)
      have hk₀_pos : 0 < k₀ := by omega
      let q : ℤ := ν' w / k₀
      let rem : ℤ := ν' w % k₀
      have hdiv : k₀ * q + rem = ν' w := Int.mul_ediv_add_emod (ν' w) k₀
      have hrem_nonneg : 0 ≤ rem := Int.emod_nonneg (ν' w) (ne_of_gt hk₀_pos)
      have hrem_lt : rem < k₀ := Int.emod_lt_of_pos (ν' w) hk₀_pos
      have hrem_zero : rem = 0 := by
        by_contra hrem_ne
        let n_rem : ℕ := rem.toNat
        have hn_eq : (n_rem : ℤ) = rem := Int.toNat_of_nonneg hrem_nonneg
        have hn_pos' : 0 < n_rem := by omega
        have hn_lt' : n_rem < k_min := by omega
        have hnu_rem : ν' (w * w₀ ^ (-q)) = (n_rem : ℤ) := by
          rw [hNu'Mul, hNu'Zpow, hw₀_nu]
          change ν' w + -q * k₀ = (n_rem : ℤ)
          linarith
        exact Nat.find_min hExP hn_lt' ⟨hn_pos', w * w₀ ^ (-q), hnu_rem⟩
      exact ⟨q, by linarith⟩
    obtain ⟨m_T₀, hm_T₀⟩ := hk_dvd_all w_T₀
    rw [hNu'WT₀] at hm_T₀
    have hm_T₀_pos : 0 < m_T₀ := by
      by_contra hle
      have h1 : (k_min : ℤ) * m_T₀ ≤ 0 :=
        mul_nonpos_of_nonneg_of_nonpos (by omega) (by omega)
      omega
    set e' : ℕ := m_T₀.toNat
    have he'_eq : (e' : ℤ) = m_T₀ := Int.toNat_of_nonneg (le_of_lt hm_T₀_pos)
    have he'_pos : 0 < e' := by omega
    have hn_eq_ke : n_tame = k_min * e' := by
      apply Nat.cast_injective (R := ℤ)
      rw [Nat.cast_mul, he'_eq, hm_T₀]
    let g_surj : Fin e' → (↥K'_int)ˣ ⧸ H_val :=
      fun j => QuotientGroup.mk (s := H_val) (w₀ ^ (j : ℕ))
    have hg_surj : Function.Surjective g_surj := by
      intro x
      let w : (↥K'_int)ˣ := Quotient.out x
      have hw_out : QuotientGroup.mk (s := H_val) w = x := Quotient.out_eq x
      rw [← hw_out]
      obtain ⟨m, hm⟩ := hk_dvd_all w
      have he'_zpos : 0 < (e' : ℤ) := by omega
      let q : ℤ := m / (e' : ℤ)
      let rem : ℤ := m % (e' : ℤ)
      have hdiv : (e' : ℤ) * q + rem = m := Int.mul_ediv_add_emod m (e' : ℤ)
      have hrem_nonneg : 0 ≤ rem := Int.emod_nonneg m (ne_of_gt he'_zpos)
      have hrem_lt : rem < (e' : ℤ) := Int.emod_lt_of_pos m he'_zpos
      let j₀ : Fin e' := ⟨rem.toNat, by omega⟩
      have hj₀_eq : ((j₀ : ℕ) : ℤ) = rem := Int.toNat_of_nonneg hrem_nonneg
      refine ⟨j₀, ?_⟩
      apply QuotientGroup.eq.mpr
      rw [hMemHvalIff]
      refine ⟨q, ?_⟩
      rw [hNu'Mul, hNu'Inv, hNu'Pow, hw₀_nu, hm, hj₀_eq]
      have hke : (n_tame : ℤ) = (k_min : ℤ) * (e' : ℤ) := by exact_mod_cast hn_eq_ke
      rw [hke]
      linear_combination (k_min : ℤ) * hdiv.symm
    have hn_le_e' : n_tame ≤ e' := by
      have h := Fintype.card_le_of_surjective g_surj hg_surj
      rwa [Fintype.card_fin] at h
    have hk_eq1 : k_min = 1 := by
      by_contra hk_ne1
      have hk_ge2 : 2 ≤ k_min := by omega
      have h2e : 2 * e' ≤ k_min * e' := Nat.mul_le_mul_right e' hk_ge2
      omega
    have hw₀_nu1 : ν' w₀ = 1 := by
      rw [hw₀_nu]
      exact_mod_cast hk_eq1
    let T'_0 : N := ((w₀ : ↥K'_int) : N)
    have hT'0_mem : T'_0 ∈ K'_int := (w₀ : ↥K'_int).2
    have hT'0_ne : T'_0 ≠ 0 := fun h0 => w₀.ne_zero (Subtype.ext h0)
    obtain ⟨c₀, hc₀_ne, hT'0_pow_norm⟩ := (hNu'Iff w₀ 1).mp hw₀_nu1
    rw [zpow_one] at hT'0_pow_norm
    have hK'_decomp : ∀ u ∈ K'_int, u ≠ 0 →
        ∃ (c_u : K_hat) (q : ℤ) (z_u : N),
          c_u ≠ 0 ∧ ‖z_u‖ = 1 ∧ u = algebraMap K_hat N c_u * T'_0 ^ q * z_u := by
      intro u hu hu_ne
      let w_u : (↥K'_int)ˣ := Units.mk0 ⟨u, hu⟩ (fun h0 => hu_ne (congrArg Subtype.val h0))
      let q : ℤ := ν' w_u
      have hnu0 : ν' (w_u * w₀ ^ (-q)) = 0 := by
        rw [hNu'Mul, hNu'Zpow, hw₀_nu1]
        ring
      obtain ⟨c_u, hc_u_ne, hc_u_norm⟩ := (hNu'ZeroIff (w_u * w₀ ^ (-q))).mp hnu0
      have hval_eq : (((w_u * w₀ ^ (-q) : (↥K'_int)ˣ) : ↥K'_int) : N) = u * T'_0 ^ (-q) := by
        change K'_int.val ((w_u * w₀ ^ (-q) : (↥K'_int)ˣ) : ↥K'_int) = u * T'_0 ^ (-q)
        rw [Units.val_mul, map_mul, Units.val_zpow_eq_zpow_val, map_zpow₀]
        rfl
      rw [hval_eq, norm_mul, norm_zpow, zpow_neg] at hc_u_norm
      have hcuN_ne : algebraMap K_hat N c_u ≠ 0 :=
        hMapNeZero (algebraMap K_hat N) hc_u_ne
      have hT'q_ne : T'_0 ^ q ≠ 0 := zpow_ne_zero q hT'0_ne
      let z_u : N := u / (algebraMap K_hat N c_u * T'_0 ^ q)
      refine ⟨c_u, q, z_u, hc_u_ne, ?_, ?_⟩
      · dsimp [z_u]
        rw [norm_div, norm_mul, hIsoN, norm_zpow, ← hc_u_norm]
        have h1 : ‖u‖ ≠ 0 := norm_ne_zero_iff.mpr hu_ne
        have h2 : ‖T'_0‖ ^ q ≠ 0 := zpow_ne_zero q (norm_ne_zero_iff.mpr hT'0_ne)
        field_simp
      · dsimp [z_u]
        rw [mul_div_cancel₀ _ (mul_ne_zero hcuN_ne hT'q_ne)]

    
    let G := (N ≃ₐ[↥K_base] N)
    have hQuoNorm1 : ∀ σ : G, ‖σ T'_0 / T'_0‖ = 1 ∧ ‖T'_0 / σ T'_0‖ = 1 := by
      intro σ
      have h1 : ‖T'_0‖ ≠ 0 := norm_ne_zero_iff.mpr hT'0_ne
      exact ⟨by rw [norm_div, hIsoGal, div_self h1], by rw [norm_div, hIsoGal, div_self h1]⟩
    let χ_fun : G → (↥E_max)ˣ := fun σ =>
      { val := ρ (σ T'_0 / T'_0)
        inv := ρ (T'_0 / σ T'_0)
        val_inv := by
          have hσT_ne : σ T'_0 ≠ 0 := hMapNeZero σ.toRingHom hT'0_ne
          have h_prod : (σ T'_0 / T'_0) * (T'_0 / σ T'_0) = 1 := by field_simp
          rw [← hRhoMul _ _ (hQuoNorm1 σ).1.le (hQuoNorm1 σ).2.le, h_prod, hRhoOne]
        inv_val := by
          have hσT_ne : σ T'_0 ≠ 0 := hMapNeZero σ.toRingHom hT'0_ne
          have h_prod : (T'_0 / σ T'_0) * (σ T'_0 / T'_0) = 1 := by field_simp
          rw [← hRhoMul _ _ (hQuoNorm1 σ).2.le (hQuoNorm1 σ).1.le, h_prod, hRhoOne] }
    let χ : G →* (↥E_max)ˣ :=
      { toFun := χ_fun
        map_one' := by
          apply Units.ext
          change ρ (T'_0 / T'_0) = 1
          rw [div_self hT'0_ne, hRhoOne]
        map_mul' := by
          intro σ τ
          apply Units.ext
          rw [Units.val_mul]
          change ρ ((σ * τ) T'_0 / T'_0) = ρ (σ T'_0 / T'_0) * ρ (τ T'_0 / T'_0)
          have hσT_ne : σ T'_0 ≠ 0 := hMapNeZero σ.toRingHom hT'0_ne
          have h_cocycle : (σ * τ) T'_0 / T'_0 = σ (τ T'_0 / T'_0) * (σ T'_0 / T'_0) := by
            change σ (τ T'_0) / T'_0 = _
            rw [map_div₀]
            field_simp
          have h_norm1 : ‖σ (τ T'_0 / T'_0)‖ ≤ 1 := by
            rw [hIsoGal]
            exact (hQuoNorm1 τ).1.le
          rw [h_cocycle, hRhoMul _ _ h_norm1 (hQuoNorm1 σ).1.le,
            hRhoGal σ _ (hQuoNorm1 τ).1.le, mul_comm] }
    let D₀ : N := algebraMap K_hat N c₀ * algebraMap ↥K_base N ⟨T₀, hT₀_mem⟩
    have hD₀_ne : D₀ ≠ 0 :=
      mul_ne_zero (hMapNeZero (algebraMap K_hat N) hc₀_ne)
        (hMapNeZero (algebraMap ↥K_base N) (fun h0 => hT₀_ne (congrArg Subtype.val h0)))
    let z₀ : N := T'_0 ^ n_tame / D₀
    have hz₀_norm1 : ‖z₀‖ = 1 := by
      dsimp [z₀, D₀]
      rw [norm_div, norm_pow, hT'0_pow_norm, norm_mul, hIsoN, hIsoBase]
      exact div_self (ne_of_gt (mul_pos (norm_pos_iff.mpr hc₀_ne) hr_pos))
    have hχ_pow : ∀ σ : G, (χ σ) ^ n_tame = 1 := by
      intro σ
      apply Units.ext
      rw [Units.val_pow_eq_pow_val, Units.val_one]
      change (ρ (σ T'_0 / T'_0)) ^ n_tame = 1
      rw [← hRhoPow _ (hQuoNorm1 σ).1.le n_tame]
      have hσD₀ : σ D₀ = D₀ := by
        dsimp [D₀]
        rw [map_mul, hKhat_gal, σ.commutes]
      have h_eq : (σ T'_0 / T'_0) ^ n_tame = σ z₀ / z₀ := by
        dsimp [z₀]
        rw [map_div₀, map_pow, hσD₀, div_pow]
        field_simp
      rw [h_eq]
      exact hRhoDivGal σ z₀ hz₀_norm1

    letI : Fintype G := AlgEquiv.fintype ↥K_base N
    letI : Fintype ↥P := Fintype.ofFinite ↥P
    have hKerEq : χ.ker = P := by
      apply le_antisymm
      · intro σ hσ
        have hχ1 : (χ σ : ↥E_max) = 1 := by
          rw [MonoidHom.mem_ker.mp hσ]
          rfl
        have hχ_inv1 : (((χ σ)⁻¹ : (↥E_max)ˣ) : ↥E_max) = 1 := by
          rw [MonoidHom.mem_ker.mp hσ, inv_one]
          rfl
        have hRhoZpow : ∀ q : ℤ, ρ (σ (T'_0 ^ q) / T'_0 ^ q) = 1 := by
          intro q
          by_cases hq : 0 ≤ q
          · set m : ℕ := q.toNat
            have hm : (m : ℤ) = q := Int.toNat_of_nonneg hq
            rw [← hm, zpow_natCast, map_pow, ← div_pow, hRhoPow _ (hQuoNorm1 σ).1.le m]
            change (χ σ : ↥E_max) ^ m = 1
            rw [hχ1, one_pow]
          · set m : ℕ := (-q).toNat
            have hm : (m : ℤ) = -q := Int.toNat_of_nonneg (by omega)
            have hq_eq : q = -(m : ℤ) := by omega
            have hσT_ne : σ T'_0 ≠ 0 := hMapNeZero σ.toRingHom hT'0_ne
            have h_eq : σ (T'_0 ^ q) / T'_0 ^ q = (T'_0 / σ T'_0) ^ m := by
              rw [hq_eq, zpow_neg, zpow_natCast, map_inv₀, map_pow, div_pow]
              field_simp
            rw [h_eq, hRhoPow _ (hQuoNorm1 σ).2.le m]
            change (((χ σ)⁻¹ : (↥E_max)ˣ) : ↥E_max) ^ m = 1
            rw [hχ_inv1, one_pow]
        have hRhoK' : ∀ u ∈ K'_int, u ≠ 0 → ρ (σ u / u) = 1 := by
          intro u hu hu_ne
          obtain ⟨c_u, q, z_u, hc_u_ne, hzu_norm1, rfl⟩ := hK'_decomp u hu hu_ne
          have hcu_ne : algebraMap K_hat N c_u ≠ 0 :=
            hMapNeZero (algebraMap K_hat N) hc_u_ne
          have hTq_ne : T'_0 ^ q ≠ 0 := zpow_ne_zero q hT'0_ne
          have hzu_ne : z_u ≠ 0 := by
            intro h0
            rw [h0, norm_zero] at hzu_norm1
            norm_num at hzu_norm1
          have h_eq : σ (algebraMap K_hat N c_u * T'_0 ^ q * z_u) /
              (algebraMap K_hat N c_u * T'_0 ^ q * z_u) =
              (σ (T'_0 ^ q) / T'_0 ^ q) * (σ z_u / z_u) := by
            rw [map_mul, map_mul, hKhat_gal]
            field_simp
          have h1_le : ‖σ (T'_0 ^ q) / T'_0 ^ q‖ ≤ 1 := by
            rw [norm_div, hIsoGal, div_self (norm_ne_zero_iff.mpr hTq_ne)]
          have h2_le : ‖σ z_u / z_u‖ ≤ 1 := by
            rw [norm_div, hIsoGal, div_self (norm_ne_zero_iff.mpr hzu_ne)]
          rw [h_eq, hRhoMul _ _ h1_le h2_le, hRhoZpow q, hRhoDivGal σ z_u hzu_norm1, mul_one]
        rw [hP_mem]
        intro x hx
        let u : N := ∏ τ : ↥P, (τ : G) x
        have hu_ne : u ≠ 0 :=
          Finset.prod_ne_zero_iff.mpr (fun τ _ => hMapNeZero (τ : G).toRingHom hx)
        have hu_mem : u ∈ K'_int := by
          rw [IntermediateField.mem_fixedField_iff]
          intro τ₀ hτ₀
          dsimp [u]
          rw [map_prod]
          have h_mul : (fun τ : ↥P => τ₀ ((τ : G) x)) =
              (fun τ : ↥P => (((⟨τ₀, hτ₀⟩ * τ : ↥P) : G) x)) := by
            funext τ
            rfl
          rw [h_mul]
          exact Equiv.prod_comp (Equiv.mulLeft (⟨τ₀, hτ₀⟩ : ↥P)) (fun τ : ↥P => (τ : G) x)
        have hRhoU : ρ (σ u / u) = 1 := hRhoK' u hu_mem hu_ne
        let e_σ : ↥P ≃ ↥P :=
          { toFun := fun τ => ⟨σ * τ.1 * σ⁻¹, Subgroup.Normal.conj_mem ‹P.Normal› τ.1 τ.2 σ⟩
            invFun := fun τ =>
              ⟨σ⁻¹ * τ.1 * σ, by simpa using Subgroup.Normal.conj_mem ‹P.Normal› τ.1 τ.2 σ⁻¹⟩
            left_inv := fun τ => Subtype.ext (by group)
            right_inv := fun τ => Subtype.ext (by group) }
        have hσu_eq : σ u = ∏ τ' : ↥P, (τ' : G) (σ x) := by
          dsimp [u]
          rw [map_prod]
          have h_conj : (fun τ : ↥P => σ ((τ : G) x)) =
              (fun τ : ↥P => ((e_σ τ : ↥P) : G) (σ x)) := by
            funext τ
            change (σ * τ.1) x = ((σ * τ.1 * σ⁻¹) * σ) x
            congr 1
            group
          rw [h_conj]
          exact Equiv.prod_comp e_σ (fun τ' : ↥P => (τ' : G) (σ x))
        have h_quo_prod : σ u / u = ∏ τ' : ↥P, (τ' : G) (σ x / x) := by
          rw [hσu_eq]
          dsimp [u]
          rw [← Finset.prod_div_distrib]
          refine Finset.prod_congr rfl (fun τ' _ => ?_)
          rw [map_div₀]
        have hx_quo_le : ‖σ x / x‖ ≤ 1 := by
          rw [norm_div, hIsoGal, div_self (norm_ne_zero_iff.mpr hx)]
        have h_prod_rho : ρ (∏ τ' : ↥P, (τ' : G) (σ x / x)) =
            (ρ (σ x / x)) ^ Fintype.card ↥P := by
          have h1 := (hRhoProd Finset.univ (fun τ' : ↥P => (τ' : G) (σ x / x))
            (fun τ' _ => (hIsoGal (τ' : G) _).trans_le hx_quo_le)).2
          rw [h1]
          have h_const : ∀ τ' : ↥P, ρ ((τ' : G) (σ x / x)) = ρ (σ x / x) :=
            fun τ' => hRhoGal (τ' : G) _ hx_quo_le
          simp only [h_const, Finset.prod_const, Finset.card_univ]
        have hζ_pow : (ρ (σ x / x)) ^ Fintype.card ↥P = 1 := by
          rw [← h_prod_rho, ← h_quo_prod, hRhoU]
        have hζ_eq1 : ρ (σ x / x) = 1 := by
          rcases hP_pGroup with hP_bot | ⟨p, hp, hp0, hP_pg⟩
          · have hcard1 : Fintype.card ↥P = 1 := by
              rw [Fintype.card_eq_one_iff]
              refine ⟨1, fun a => Subtype.ext ?_⟩
              have ha : a.1 ∈ (⊥ : Subgroup G) := hP_bot ▸ a.2
              exact Subgroup.mem_bot.mp ha
            rwa [hcard1, pow_one] at hζ_pow
          · haveI : Fact p.Prime := ⟨hp⟩
            obtain ⟨k, hk⟩ := IsPGroup.iff_card.mp hP_pg
            rw [Nat.card_eq_fintype_card] at hk
            rw [hk] at hζ_pow
            have hp0_E : (p : ↥E_max) = 0 := Subtype.ext (by simpa using hp0)
            haveI : CharP ↥E_max p := (CharP.charP_iff_prime_eq_zero hp).mpr hp0_E
            have hsub0 : (ρ (σ x / x) - 1) ^ (p ^ k) = 0 := by
              rw [sub_pow_char_pow, hζ_pow, one_pow, sub_self]
            by_contra hne
            exact pow_ne_zero (p ^ k) (sub_ne_zero.mpr hne) hsub0
        have hlt1 : ‖σ x / x - 1‖ < 1 := by
          have h1 := hRhoSpec (σ x / x) hx_quo_le
          rw [hζ_eq1] at h1
          simpa using h1
        have h_sub_eq : σ x - x = (σ x / x - 1) * x := by
          rw [sub_one_mul, div_mul_cancel₀ _ hx]
        rw [h_sub_eq, norm_mul]
        exact (mul_lt_mul_of_pos_right hlt1 (norm_pos_iff.mpr hx)).trans_eq (one_mul ‖x‖)
      · intro σ hσ
        rw [MonoidHom.mem_ker]
        apply Units.ext
        change ρ (σ T'_0 / T'_0) = 1
        apply hRhoEq (σ T'_0 / T'_0) (hQuoNorm1 σ).1.le 1
        have h_eq : σ T'_0 / T'_0 - algebraMap K_hat N ((1 : ↥E_max) : K_hat) =
            (σ T'_0 - T'_0) / T'_0 := by
          change σ T'_0 / T'_0 - algebraMap K_hat N 1 = _
          rw [map_one, div_sub_one hT'0_ne]
        rw [h_eq, norm_div, div_lt_one (norm_pos_iff.mpr hT'0_ne)]
        exact (hP_mem σ).mp hσ T'_0 hT'0_ne

    letI : Fintype (G ⧸ χ.ker) := Fintype.ofFinite (G ⧸ χ.ker)
    have hRankEqQuot : Module.finrank ↥K_base ↥K'_int = Fintype.card (G ⧸ χ.ker) := by
      have hMul := Module.finrank_mul_finrank ↥K_base ↥K'_int N
      have hFix : Module.finrank ↥K'_int N = Nat.card ↥P :=
        IntermediateField.finrank_fixedField_eq_card P
      have hGal : Nat.card G = Module.finrank ↥K_base N :=
        IsGalois.card_aut_eq_finrank ↥K_base N
      have hLag : Nat.card G = Nat.card (G ⧸ P) * Nat.card ↥P :=
        Subgroup.card_eq_card_quotient_mul_card_subgroup P
      have hPosP : 0 < Nat.card ↥P := Nat.card_pos
      have hEq1 : Module.finrank ↥K_base ↥K'_int = Nat.card (G ⧸ P) := by
        apply Nat.eq_of_mul_eq_mul_right hPosP
        rw [hFix] at hMul
        exact hMul.trans (hGal.symm.trans hLag)
      rw [hEq1, ← hKerEq, Nat.card_eq_fintype_card]
    let P_uni : Polynomial ↥E_max := Polynomial.X ^ n_tame - Polynomial.C 1
    have hP_uni_ne : P_uni ≠ 0 := Polynomial.X_pow_sub_C_ne_zero hn_pos (1 : ↥E_max)
    let S_roots : Finset ↥E_max := P_uni.roots.toFinset
    have hS_roots_le : S_roots.card ≤ n_tame := by
      have h1 : S_roots.card ≤ P_uni.roots.card := Multiset.toFinset_card_le _
      have h2 : P_uni.roots.card ≤ P_uni.natDegree := Polynomial.card_roots' P_uni
      have h3 : P_uni.natDegree = n_tame := Polynomial.natDegree_X_pow_sub_C
      omega
    let f_emb : G ⧸ χ.ker → ↥S_roots := fun q =>
      ⟨(QuotientGroup.kerLift χ q : ↥E_max), by
        rw [Multiset.mem_toFinset, Polynomial.mem_roots hP_uni_ne, Polynomial.IsRoot.def]
        refine Quotient.inductionOn' q (fun σ => ?_)
        have hkl : QuotientGroup.kerLift χ (Quotient.mk'' σ) = χ σ := rfl
        rw [hkl]
        have hp1 : ((χ σ : ↥E_max)) ^ n_tame = 1 := by
          rw [← Units.val_pow_eq_pow_val, hχ_pow σ]
          rfl
        simp [P_uni, hp1]⟩
    have hf_inj : Function.Injective f_emb := by
      intro q₁ q₂ hq
      have hval : (QuotientGroup.kerLift χ q₁ : ↥E_max) = (QuotientGroup.kerLift χ q₂ : ↥E_max) :=
        congrArg Subtype.val hq
      exact QuotientGroup.kerLift_injective χ (Units.ext hval)
    have hQuot_le_roots : Fintype.card (G ⧸ χ.ker) ≤ S_roots.card := by
      have h := Fintype.card_le_of_injective f_emb hf_inj
      rwa [Fintype.card_coe] at h
    have hRankK' : Module.finrank ↥K_base ↥K'_int = n_tame := by omega
    have hS_roots_eq : S_roots.card = n_tame := by omega

    have hPrimeNorm1 : ∀ q : ℕ, q.Prime → q ∣ n_tame → ‖(q : K_hat)‖ = 1 := by
      intro q hq hq_dvd
      rcases hEquiChar q hq with hq0 | hq1
      · exfalso
        haveI : Fact q.Prime := ⟨hq⟩
        have hq0_E : (q : ↥E_max) = 0 := Subtype.ext (by simpa using hq0)
        haveI : CharP ↥E_max q := (CharP.charP_iff_prime_eq_zero hq).mpr hq0_E
        obtain ⟨m, hm⟩ := hq_dvd
        have hm_pos : 0 < m := by
          by_contra hm0
          have hm_eq0 : m = 0 := Nat.eq_zero_of_not_pos hm0
          rw [hm_eq0, mul_zero] at hm
          omega
        have hm_lt : m < n_tame := by
          rw [hm]
          exact lt_mul_of_one_lt_left hm_pos hq.one_lt
        let P_m : Polynomial ↥E_max := Polynomial.X ^ m - Polynomial.C 1
        have hPm_ne : P_m ≠ 0 := Polynomial.X_pow_sub_C_ne_zero hm_pos (1 : ↥E_max)
        have hSub : S_roots ⊆ P_m.roots.toFinset := by
          intro e he
          rw [Multiset.mem_toFinset, Polynomial.mem_roots hP_uni_ne, Polynomial.IsRoot.def] at he
          have hen : e ^ n_tame = 1 := sub_eq_zero.mp (by simpa [P_uni] using he)
          rw [hm, mul_comm q m, pow_mul] at hen
          have hem0 : (e ^ m - 1) ^ q = 0 := by
            rw [sub_pow_char, hen, one_pow, sub_self]
          have hem1 : e ^ m - 1 = 0 := by
            by_contra hne
            exact pow_ne_zero q hne hem0
          rw [Multiset.mem_toFinset, Polynomial.mem_roots hPm_ne, Polynomial.IsRoot.def]
          simpa [P_m] using hem1
        have h1 : S_roots.card ≤ P_m.roots.toFinset.card := Finset.card_le_card hSub
        have h2 : P_m.roots.toFinset.card ≤ P_m.roots.card := Multiset.toFinset_card_le _
        have h3 : P_m.roots.card ≤ P_m.natDegree := Polynomial.card_roots' P_m
        have h4 : P_m.natDegree = m := Polynomial.natDegree_X_pow_sub_C
        omega
      · exact hq1
    have hNatNorm1 : ∀ k : ℕ, 0 < k →
        (∀ q : ℕ, q.Prime → q ∣ k → ‖(q : K_hat)‖ = 1) → ‖(k : K_hat)‖ = 1 := by
      intro k
      induction k using Nat.strong_induction_on with
      | h k ih =>
        intro hk_pos hk_pr
        by_cases hk1 : k = 1
        · subst hk1
          simp
        · obtain ⟨q, hq, hq_dvd⟩ := Nat.exists_prime_and_dvd hk1
          have hq1 : ‖(q : K_hat)‖ = 1 := hk_pr q hq hq_dvd
          obtain ⟨k', rfl⟩ := hq_dvd
          have hk'_pos : 0 < k' := Nat.pos_of_mul_pos_left hk_pos
          have hk'_lt : k' < q * k' := lt_mul_of_one_lt_left hk'_pos hq.one_lt
          have hk'1 : ‖(k' : K_hat)‖ = 1 := ih k' hk'_lt hk'_pos
            (fun p' hp' hp'_dvd => hk_pr p' hp' (dvd_mul_of_dvd_right hp'_dvd q))
          rw [Nat.cast_mul, norm_mul, hq1, hk'1, mul_one]
    have hn_norm : ‖(n_tame : K_hat)‖ = 1 := hNatNorm1 n_tame hn_pos hPrimeNorm1

    let e₀ : ↥E_max := ρ z₀
    have he₀_ne : e₀ ≠ 0 := hRhoNeZero z₀ hz₀_norm1
    have he₀_val_ne : (e₀ : K_hat) ≠ 0 := fun h0 => he₀_ne (Subtype.ext h0)
    have he₀_norm1 : ‖(e₀ : K_hat)‖ = 1 := hE_unit_norm e₀ he₀_ne
    let c₁ : K_hat := c₀ * (e₀ : K_hat)
    have hc₁_ne : c₁ ≠ 0 := mul_ne_zero hc₀_ne he₀_val_ne
    refine ⟨T'_0, n_tame, c₁, hT'0_mem, hT'0_ne, hn_pos, hRankK', hn_norm, hc₁_ne, ?_⟩
    have he₀N_ne : algebraMap K_hat N (e₀ : K_hat) ≠ 0 :=
      hMapNeZero (algebraMap K_hat N) he₀_val_ne
    have h_rewrite :
        T'_0 ^ n_tame / (algebraMap K_hat N c₁ * algebraMap ↥K_base N ⟨T₀, hT₀_mem⟩) - 1 =
        (z₀ - algebraMap K_hat N (e₀ : K_hat)) / algebraMap K_hat N (e₀ : K_hat) := by
      dsimp [c₁, z₀, D₀]
      rw [map_mul]
      field_simp
    rw [h_rewrite, norm_div, hIsoN, he₀_norm1, div_one]
    exact hRhoSpec z₀ hz₀_norm1.le

  obtain ⟨T'_0, n_tame, c₁, hT'0_mem, hT'0_ne, hn_pos, hRankK', hn_norm, hc₁_ne, hClose⟩ := hTameChar

  
  
  
  have hHenselAndSup :
      IsClosed (K' : Set N) ∧
      (∃ T_tame : N,
        T_tame ∈ K'_int ∧
        T_tame ≠ 0 ∧
        T_tame ^ n_tame = algebraMap ↥K_base N ⟨T₀, hT₀_mem⟩ ∧
        K'_int = IntermediateField.adjoin ↥K_base ({T_tame} : Set N)) ∧
      Module.finrank ↥K_base ↥L_top = Module.finrank ↥K_base ↥F_sub * n_tame ∧
      (∀ w ∈ L_top, w ≠ 0 → ∃ u ∈ K', ‖w‖ = ‖u‖) := by
    letI : NormedSpace ↥K_base N :=
      { (inferInstance : Module ↥K_base N) with
        norm_smul_le := fun a b => by
          rw [Algebra.smul_def, norm_mul, hIsoBase a]
          exact le_rfl }
    haveI : FiniteDimensional ↥K_base ↥K'_int.toSubmodule :=
      FiniteDimensional.left ↥K_base ↥K'_int N
    have hClK' : IsClosed (K' : Set N) :=
      Submodule.closed_of_finiteDimensional K'_int.toSubmodule

    
    have hNatNormLe : ∀ m : ℕ, ‖(m : N)‖ ≤ 1 := by
      intro m
      induction m with
      | zero => simp
      | succ m ih =>
        push_cast
        exact (IsUltrametricDist.norm_add_le_max (m : N) 1).trans (max_le ih norm_one.le)
    have hPowSubOneLe : ∀ (y : N) (m : ℕ), ‖y‖ ≤ 1 → ‖y ^ m - 1‖ ≤ ‖y - 1‖ := by
      intro y m hy
      induction m with
      | zero => simp
      | succ m ih =>
        have h_eq : y ^ (m + 1) - 1 = y * (y ^ m - 1) + (y - 1) := by
          rw [pow_succ']
          ring
        rw [h_eq]
        refine (IsUltrametricDist.norm_add_le_max _ _).trans (max_le ?_ le_rfl)
        rw [norm_mul]
        exact (mul_le_of_le_one_left (norm_nonneg _) hy).trans ih
    have hTaylor : ∀ (n : ℕ) (y h : N), ‖y‖ ≤ 1 → ‖h‖ ≤ 1 →
        ∃ w : N, ‖w‖ ≤ 1 ∧ (y + h) ^ n = y ^ n + (n : N) * y ^ (n - 1) * h + h ^ 2 * w := by
      intro n
      induction n with
      | zero =>
        intro y h _ _
        exact ⟨0, by simp, by simp⟩
      | succ n ih =>
        cases n with
        | zero =>
          intro y h _ _
          exact ⟨0, by simp, by simp⟩
        | succ m =>
          intro y h hy hh
          obtain ⟨w, hw_le, hw_eq⟩ := ih y h hy hh
          let w' : N := ((m + 1 : ℕ) : N) * y ^ m + w * (y + h)
          refine ⟨w', ?_, ?_⟩
          · dsimp [w']
            refine (IsUltrametricDist.norm_add_le_max _ _).trans (max_le ?_ ?_)
            · rw [norm_mul, norm_pow]
              exact mul_le_one₀ (hNatNormLe (m + 1)) (pow_nonneg (norm_nonneg y) m)
                (pow_le_one₀ (norm_nonneg y) hy)
            · rw [norm_mul]
              exact mul_le_one₀ hw_le (norm_nonneg _)
                ((IsUltrametricDist.norm_add_le_max y h).trans (max_le hy hh))
          · change (y + h) ^ (m + 2) =
              y ^ (m + 2) + ((m + 2 : ℕ) : N) * y ^ (m + 1) * h + h ^ 2 * w'
            have hstep : (y + h) ^ (m + 2) = (y + h) ^ (m + 1) * (y + h) := pow_succ (y + h) (m + 1)
            change (y + h) ^ (m + 1) = y ^ (m + 1) + ((m + 1 : ℕ) : N) * y ^ m * h + h ^ 2 * w at hw_eq
            rw [hstep, hw_eq]
            dsimp [w']
            push_cast
            ring

    
    let D₁ : N := algebraMap K_hat N c₁ * algebraMap ↥K_base N ⟨T₀, hT₀_mem⟩
    have hD₁_ne : D₁ ≠ 0 :=
      mul_ne_zero (hMapNeZero (algebraMap K_hat N) hc₁_ne)
        (hMapNeZero (algebraMap ↥K_base N) (fun h0 => hT₀_ne (congrArg Subtype.val h0)))
    let target_unit : N := T'_0 ^ n_tame / D₁
    have htarget_mem : target_unit ∈ K'_int :=
      K'_int.div_mem (pow_mem hT'0_mem n_tame)
        (K'_int.mul_mem (hKhat_memK' c₁) (K'_int.algebraMap_mem _))
    let δ : N := target_unit - 1
    have hδ_mem : δ ∈ K'_int := K'_int.sub_mem htarget_mem K'_int.one_mem
    have h1_add_δ : 1 + δ = target_unit := add_sub_cancel 1 target_unit
    set r₀ : ℝ := ‖δ‖
    have hr₀_nonneg : 0 ≤ r₀ := norm_nonneg δ
    have hr₀_lt : r₀ < 1 := hClose
    have hnN_norm : ‖(n_tame : N)‖ = 1 := by
      rw [← map_natCast (algebraMap K_hat N) n_tame, hIsoN, hn_norm]
    have hnN_ne : (n_tame : N) ≠ 0 := by
      intro h0
      rw [h0, norm_zero] at hnN_norm
      norm_num at hnN_norm
    have hnN_inv_norm : ‖((n_tame : N))⁻¹‖ = 1 := by
      rw [norm_inv, hnN_norm, inv_one]
    let v : ℕ → N := fun k =>
      Nat.rec 1 (fun _ vk => vk - (n_tame : N)⁻¹ * (vk ^ n_tame - (1 + δ))) k
    have hv_ind : ∀ k : ℕ,
        v k ∈ K'_int ∧ ‖v k - 1‖ ≤ r₀ ∧ ‖v k ^ n_tame - (1 + δ)‖ ≤ r₀ ^ (k + 1) := by
      intro k
      induction k with
      | zero =>
        refine ⟨K'_int.one_mem, ?_, ?_⟩
        · change ‖(1 : N) - 1‖ ≤ r₀
          rw [sub_self, norm_zero]
          exact hr₀_nonneg
        · change ‖(1 : N) ^ n_tame - (1 + δ)‖ ≤ r₀ ^ 1
          rw [one_pow, pow_one]
          have h_eq : (1 : N) - (1 + δ) = -δ := by ring
          rw [h_eq, norm_neg]
      | succ k ih =>
        obtain ⟨hvk_mem, hvk_sub, hvk_err⟩ := ih
        let E_k : N := v k ^ n_tame - (1 + δ)
        let h_k : N := -(n_tame : N)⁻¹ * E_k
        have hvk_succ : v (k + 1) = v k + h_k := by
          change v k - (n_tame : N)⁻¹ * E_k = v k + (-(n_tame : N)⁻¹ * E_k)
          ring
        have hhk_le_pow : ‖h_k‖ ≤ r₀ ^ (k + 1) := by
          dsimp [h_k]
          rw [norm_mul, norm_neg, hnN_inv_norm, one_mul]
          exact hvk_err
        have hpow_le_r0 : r₀ ^ (k + 1) ≤ r₀ := by
          have h1 := pow_le_pow_of_le_one hr₀_nonneg hr₀_lt.le (Nat.le_add_left 1 k)
          rwa [pow_one] at h1
        have hhk_le_r0 : ‖h_k‖ ≤ r₀ := hhk_le_pow.trans hpow_le_r0
        have hhk_le1 : ‖h_k‖ ≤ 1 := hhk_le_r0.trans hr₀_lt.le
        have hvk_le1 : ‖v k‖ ≤ 1 := by
          have h_eq : (v k - 1) + 1 = v k := sub_add_cancel (v k) 1
          have hmax : ‖v k‖ ≤ max ‖v k - 1‖ ‖(1 : N)‖ := by
            simpa only [h_eq] using IsUltrametricDist.norm_add_le_max (v k - 1) 1
          exact hmax.trans (max_le (hvk_sub.trans hr₀_lt.le) norm_one.le)
        refine ⟨?_, ?_, ?_⟩
        · change v k - (n_tame : N)⁻¹ * (v k ^ n_tame - (1 + δ)) ∈ K'_int
          exact K'_int.sub_mem hvk_mem (K'_int.mul_mem (K'_int.inv_mem (natCast_mem K'_int n_tame))
            (K'_int.sub_mem (pow_mem hvk_mem n_tame) (K'_int.add_mem K'_int.one_mem hδ_mem)))
        · have h_sub : v (k + 1) - 1 = (v k - 1) + h_k := by
            rw [hvk_succ]
            ring
          rw [h_sub]
          exact (IsUltrametricDist.norm_add_le_max _ _).trans (max_le hvk_sub hhk_le_r0)
        · obtain ⟨w, hw_le1, hw_eq⟩ := hTaylor n_tame (v k) h_k hvk_le1 hhk_le1
          have hnh : (n_tame : N) * h_k = -E_k := by
            dsimp [h_k]
            rw [neg_mul, mul_neg, ← mul_assoc, mul_inv_cancel₀ hnN_ne, one_mul]
          have h_err_eq : v (k + 1) ^ n_tame - (1 + δ) =
              -(v k ^ (n_tame - 1) - 1) * E_k + h_k ^ 2 * w := by
            rw [hvk_succ, hw_eq]
            have hlin : (n_tame : N) * v k ^ (n_tame - 1) * h_k =
                v k ^ (n_tame - 1) * ((n_tame : N) * h_k) := by ring
            rw [hlin, hnh]
            dsimp [E_k]
            ring
          rw [h_err_eq]
          refine (IsUltrametricDist.norm_add_le_max _ _).trans (max_le ?_ ?_)
          · rw [norm_mul, norm_neg]
            have h1 : ‖v k ^ (n_tame - 1) - 1‖ ≤ r₀ :=
              (hPowSubOneLe (v k) (n_tame - 1) hvk_le1).trans hvk_sub
            have h2 := mul_le_mul h1 hvk_err (norm_nonneg _) hr₀_nonneg
            rwa [← pow_succ'] at h2
          · rw [norm_mul, norm_pow]
            have hsq : ‖h_k‖ ^ 2 ≤ r₀ ^ (k + 2) := by
              have h1 : ‖h_k‖ * ‖h_k‖ ≤ r₀ * r₀ ^ (k + 1) :=
                mul_le_mul hhk_le_r0 hhk_le_pow (norm_nonneg _) hr₀_nonneg
              rwa [← sq, ← pow_succ'] at h1
            exact (mul_le_of_le_one_right (sq_nonneg _) hw_le1).trans hsq

    have hv_cauchy : CauchySeq v := by
      refine cauchySeq_of_le_geometric r₀ 1 hr₀_lt (fun k => ?_)
      rw [dist_eq_norm, one_mul]
      have h_diff : v k - v (k + 1) = (n_tame : N)⁻¹ * (v k ^ n_tame - (1 + δ)) := by
        change v k - (v k - (n_tame : N)⁻¹ * (v k ^ n_tame - (1 + δ))) = _
        ring
      rw [h_diff, norm_mul, hnN_inv_norm, one_mul]
      have h1 : r₀ ^ (k + 1) ≤ r₀ ^ k :=
        pow_le_pow_of_le_one hr₀_nonneg hr₀_lt.le (Nat.le_succ k)
      exact (hv_ind k).2.2.trans h1
    obtain ⟨v_lim, hv_tendsto⟩ := cauchySeq_tendsto_of_complete hv_cauchy
    have hvlim_mem : v_lim ∈ K'_int :=
      hClK'.mem_of_tendsto hv_tendsto (Filter.Eventually.of_forall fun k => (hv_ind k).1)
    have hvlim_sub : ‖v_lim - 1‖ ≤ r₀ := by
      have hCl_ball : IsClosed { x : N | ‖x - 1‖ ≤ r₀ } :=
        isClosed_le (continuous_norm.comp (continuous_id.sub continuous_const)) continuous_const
      exact hCl_ball.mem_of_tendsto hv_tendsto (Filter.Eventually.of_forall fun k => (hv_ind k).2.1)
    have hvlim_ne : v_lim ≠ 0 := by
      intro h0
      rw [h0, zero_sub, norm_neg, norm_one] at hvlim_sub
      linarith
    have hvlim_pow : v_lim ^ n_tame = target_unit := by
      have h_tend1 : Filter.Tendsto (fun k => v k ^ n_tame - (1 + δ)) Filter.atTop
          (nhds (v_lim ^ n_tame - (1 + δ))) :=
        (hv_tendsto.pow n_tame).sub tendsto_const_nhds
      have h_tend0 : Filter.Tendsto (fun k => v k ^ n_tame - (1 + δ)) Filter.atTop (nhds 0) := by
        refine squeeze_zero_norm (fun k => (hv_ind k).2.2) ?_
        exact (tendsto_pow_atTop_nhds_zero_of_lt_one hr₀_nonneg hr₀_lt).comp
          (Filter.tendsto_add_atTop_nat 1)
      have h_eq0 : v_lim ^ n_tame - (1 + δ) = 0 := tendsto_nhds_unique h_tend1 h_tend0
      rw [← h1_add_δ]
      exact sub_eq_zero.mp h_eq0

    obtain ⟨γ₁, hγ₁⟩ := IsAlgClosed.exists_pow_nat_eq c₁ hn_pos
    have hγ₁_ne : γ₁ ≠ 0 := by
      intro h0
      rw [h0, zero_pow (ne_of_gt hn_pos)] at hγ₁
      exact hc₁_ne hγ₁.symm
    have hγ₁N_ne : algebraMap K_hat N γ₁ ≠ 0 :=
      hMapNeZero (algebraMap K_hat N) hγ₁_ne
    let T_tame : N := T'_0 / (algebraMap K_hat N γ₁ * v_lim)
    have hTtame_mem : T_tame ∈ K'_int :=
      K'_int.div_mem hT'0_mem (K'_int.mul_mem (hKhat_memK' γ₁) hvlim_mem)
    have hTtame_ne : T_tame ≠ 0 := div_ne_zero hT'0_ne (mul_ne_zero hγ₁N_ne hvlim_ne)
    have hTtame_pow : T_tame ^ n_tame = algebraMap ↥K_base N ⟨T₀, hT₀_mem⟩ := by
      dsimp [T_tame]
      rw [div_pow, mul_pow, ← map_pow, hγ₁, hvlim_pow]
      dsimp [target_unit, D₁]
      have hc₁N_ne : algebraMap K_hat N c₁ ≠ 0 :=
        hMapNeZero (algebraMap K_hat N) hc₁_ne
      have hT₀N_ne : algebraMap ↥K_base N ⟨T₀, hT₀_mem⟩ ≠ 0 :=
        hMapNeZero (algebraMap ↥K_base N) (fun h0 => hT₀_ne (congrArg Subtype.val h0))
      field_simp

    
    have hTtame_norm_pow : ‖T_tame‖ ^ n_tame = r := by
      rw [← norm_pow, hTtame_pow, hIsoBase]
    have hCosetDist : ∀ (i j : Fin n_tame), i ≠ j →
        ∀ (y₁ y₂ : N), y₁ ≠ 0 → y₂ ≠ 0 →
        (∃ u₁ ∈ K_base, ‖y₁‖ = ‖u₁‖) →
        (∃ u₂ ∈ K_base, ‖y₂‖ = ‖u₂‖) →
        ‖y₁ * T_tame ^ (i : ℕ)‖ ≠ ‖y₂ * T_tame ^ (j : ℕ)‖ := by
      intro i j hij y₁ y₂ hy₁ hy₂ ⟨u₁, hu₁_mem, hu₁_norm⟩ ⟨u₂, hu₂_mem, hu₂_norm⟩ heq
      have hu₁_ne : u₁ ≠ 0 := by
        intro h0
        rw [h0, norm_zero] at hu₁_norm
        exact hy₁ (norm_eq_zero.mp hu₁_norm)
      have hu₂_ne : u₂ ≠ 0 := by
        intro h0
        rw [h0, norm_zero] at hu₂_norm
        exact hy₂ (norm_eq_zero.mp hu₂_norm)
      obtain ⟨d₁, m₁, hd₁_ne, hd₁_norm⟩ := hBaseVal u₁ hu₁_mem hu₁_ne
      obtain ⟨d₂, m₂, hd₂_ne, hd₂_norm⟩ := hBaseVal u₂ hu₂_mem hu₂_ne
      rw [norm_mul, norm_mul, norm_pow, norm_pow, hu₁_norm, hu₂_norm, hd₁_norm, hd₂_norm] at heq
      have hpow_eq := congrArg (fun x : ℝ => x ^ n_tame) heq
      have h_side : ∀ (d : K_hat) (m : ℤ) (k : ℕ),
          (‖d‖ * r ^ m * ‖T_tame‖ ^ k) ^ n_tame =
          ‖d ^ n_tame‖ * r ^ ((k : ℤ) + m * (n_tame : ℤ)) := by
        intro d m k
        rw [mul_pow, mul_pow, norm_pow, pow_right_comm ‖T_tame‖ k n_tame, hTtame_norm_pow,
          ← zpow_natCast (r ^ m) n_tame, ← zpow_mul, ← zpow_natCast r k,
          zpow_add₀ hr_ne, mul_comm (r ^ (k : ℤ)), ← mul_assoc]
      rw [h_side d₁ m₁ (i : ℕ), h_side d₂ m₂ (j : ℕ)] at hpow_eq
      have hexp_eq := hExpUniq (d₁ ^ n_tame) (d₂ ^ n_tame)
        (((i : ℕ) : ℤ) + m₁ * (n_tame : ℤ)) (((j : ℕ) : ℤ) + m₂ * (n_tame : ℤ))
        (pow_ne_zero n_tame hd₁_ne) (pow_ne_zero n_tame hd₂_ne) hpow_eq
      have hmod : (((i : ℕ) : ℤ) + m₁ * (n_tame : ℤ)) % (n_tame : ℤ) =
          (((j : ℕ) : ℤ) + m₂ * (n_tame : ℤ)) % (n_tame : ℤ) :=
        congrArg (fun z : ℤ => z % (n_tame : ℤ)) hexp_eq
      rw [mul_comm m₁, mul_comm m₂, Int.add_mul_emod_self_left, Int.add_mul_emod_self_left,
        Int.emod_eq_of_lt (Nat.cast_nonneg _) (Nat.cast_lt.mpr i.2),
        Int.emod_eq_of_lt (Nat.cast_nonneg _) (Nat.cast_lt.mpr j.2)] at hmod
      exact hij (Fin.ext (Nat.cast_injective hmod))

    let K_adj : IntermediateField ↥K_base N := IntermediateField.adjoin ↥K_base ({T_tame} : Set N)
    have hAdj_le : K_adj ≤ K'_int :=
      IntermediateField.adjoin_le_iff.mpr (Set.singleton_subset_iff.mpr hTtame_mem)
    have hK'_adjoin : K'_int = K_adj := by
      let b_K : Fin n_tame → ↥K_adj := fun i =>
        ⟨T_tame ^ (i : ℕ), pow_mem (IntermediateField.mem_adjoin_simple_self ↥K_base T_tame) (i : ℕ)⟩
      have hbK_lin : LinearIndependent ↥K_base b_K := by
        rw [Fintype.linearIndependent_iff]
        intro a hsum i₀
        by_contra hi₀
        classical
        let S : Finset (Fin n_tame) := Finset.univ.filter (fun i => a i ≠ 0)
        have hS_ne : S.Nonempty := ⟨i₀, Finset.mem_filter.mpr ⟨Finset.mem_univ i₀, hi₀⟩⟩
        have hS_sum : ∑ i ∈ S, algebraMap ↥K_base N (a i) * T_tame ^ (i : ℕ) = 0 := by
          have hsumN : ((∑ i : Fin n_tame, a i • b_K i : ↥K_adj) : N) = 0 := by
            rw [hsum]
            rfl
          have hsumN' : ∑ i : Fin n_tame, algebraMap ↥K_base N (a i) * T_tame ^ (i : ℕ) = 0 := by
            rw [← hsumN, AddSubmonoidClass.coe_finset_sum]
            refine Finset.sum_congr rfl (fun i _ => ?_)
            rw [Algebra.smul_def, MulMemClass.coe_mul]
            rfl
          rw [← hsumN']
          apply Finset.sum_subset (Finset.subset_univ S)
          intro i _ hi_not
          have hai : a i = 0 := by
            by_contra hne
            exact hi_not (Finset.mem_filter.mpr ⟨Finset.mem_univ i, hne⟩)
          simp [hai]
        have hS_dist : ∀ i ∈ S, ∀ j ∈ S, i ≠ j →
            ‖algebraMap ↥K_base N (a i) * T_tame ^ (i : ℕ)‖ ≠
            ‖algebraMap ↥K_base N (a j) * T_tame ^ (j : ℕ)‖ := by
          intro i hi j hj hij
          exact hCosetDist i j hij _ _
            (hMapNeZero (algebraMap ↥K_base N) (Finset.mem_filter.mp hi).2)
            (hMapNeZero (algebraMap ↥K_base N) (Finset.mem_filter.mp hj).2)
            ⟨(a i).1, (a i).2, hIsoBase (a i)⟩
            ⟨(a j).1, (a j).2, hIsoBase (a j)⟩
        obtain ⟨i_max, hi_max, hmax_eq, _⟩ :=
          hUltraMaxSum S (fun i => algebraMap ↥K_base N (a i) * T_tame ^ (i : ℕ)) hS_ne hS_dist
        rw [hS_sum, norm_zero] at hmax_eq
        exact mul_ne_zero
          (hMapNeZero (algebraMap ↥K_base N) (Finset.mem_filter.mp hi_max).2)
          (pow_ne_zero (i_max : ℕ) hTtame_ne)
          (norm_eq_zero.mp hmax_eq.symm)
      haveI : FiniteDimensional ↥K_base ↥K_adj := FiniteDimensional.left ↥K_base ↥K_adj N
      have hge : n_tame ≤ Module.finrank ↥K_base ↥K_adj := by
        have h := hbK_lin.fintype_card_le_finrank
        rwa [Fintype.card_fin] at h
      have hsub_le : K_adj.toSubmodule ≤ K'_int.toSubmodule := hAdj_le
      have hle : Module.finrank ↥K_base ↥K_adj ≤ Module.finrank ↥K_base ↥K'_int :=
        Submodule.finrank_mono hsub_le
      have hRankEq : Module.finrank ↥K_base ↥K_adj.toSubmodule =
          Module.finrank ↥K_base ↥K'_int.toSubmodule := by
        change Module.finrank ↥K_base ↥K_adj = Module.finrank ↥K_base ↥K'_int
        omega
      have hSubEq := Submodule.eq_of_le_of_finrank_eq hsub_le hRankEq
      ext x
      exact (Set.ext_iff.mp (congrArg SetLike.coe hSubEq) x).symm

    
    have hK'_le_top : K'_int ≤ L_top := le_sup_left
    have hF_le_top : F_sub ≤ L_top := le_sup_right
    letI : Algebra ↥F_sub ↥L_top := (IntermediateField.inclusion hF_le_top).toAlgebra
    haveI : Module.Free ↥K_base ↥F_sub := Module.Free.of_divisionRing ↥K_base ↥F_sub
    haveI : Module.Free ↥F_sub ↥L_top := Module.Free.of_divisionRing ↥F_sub ↥L_top
    haveI : IsScalarTower ↥K_base ↥F_sub ↥L_top := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    haveI : FiniteDimensional ↥K_base ↥F_sub := FiniteDimensional.left ↥K_base ↥F_sub N
    haveI : FiniteDimensional ↥K_base ↥L_top := FiniteDimensional.left ↥K_base ↥L_top N
    haveI : FiniteDimensional ↥F_sub ↥L_top := FiniteDimensional.right ↥K_base ↥F_sub ↥L_top
    let t_top : ↥L_top := ⟨T_tame, hK'_le_top hTtame_mem⟩
    let E_adj : IntermediateField ↥F_sub ↥L_top := IntermediateField.adjoin ↥F_sub ({t_top} : Set ↥L_top)
    have hE_adj_top : E_adj = ⊤ := by
      let M_sub : Subfield N :=
        { carrier := { x : N | ∃ hx : x ∈ L_top, (⟨x, hx⟩ : ↥L_top) ∈ E_adj }
          zero_mem' := ⟨L_top.zero_mem, E_adj.zero_mem⟩
          one_mem' := ⟨L_top.one_mem, E_adj.one_mem⟩
          add_mem' := fun ⟨hx, hxE⟩ ⟨hy, hyE⟩ => ⟨L_top.add_mem hx hy, E_adj.add_mem hxE hyE⟩
          neg_mem' := fun ⟨hx, hxE⟩ => ⟨L_top.neg_mem hx, E_adj.neg_mem hxE⟩
          mul_mem' := fun ⟨hx, hxE⟩ ⟨hy, hyE⟩ => ⟨L_top.mul_mem hx hy, E_adj.mul_mem hxE hyE⟩
          inv_mem' := fun _ ⟨hx, hxE⟩ => ⟨L_top.inv_mem hx, E_adj.inv_mem hxE⟩ }
      let M_if : IntermediateField ↥K_base N :=
        { M_sub with
          algebraMap_mem' := fun u =>
            ⟨L_top.algebraMap_mem u, by
              have h_eq : (⟨algebraMap ↥K_base N u, L_top.algebraMap_mem u⟩ : ↥L_top) =
                  algebraMap ↥F_sub ↥L_top (algebraMap ↥K_base ↥F_sub u) := rfl
              rw [h_eq]
              exact E_adj.algebraMap_mem _⟩ }
      have hK'_le_M : K'_int ≤ M_if := by
        rw [hK'_adjoin, IntermediateField.adjoin_le_iff, Set.singleton_subset_iff]
        exact ⟨hK'_le_top hTtame_mem, IntermediateField.mem_adjoin_simple_self ↥F_sub t_top⟩
      have hF_le_M : F_sub ≤ M_if := by
        intro x hx
        exact ⟨hF_le_top hx, E_adj.algebraMap_mem ⟨x, hx⟩⟩
      have hL_le_M : L_top ≤ M_if := sup_le hK'_le_M hF_le_M
      rw [eq_top_iff]
      rintro ⟨x, hx⟩ _
      obtain ⟨_, hxE⟩ := hL_le_M hx
      exact hxE
    have hRankFL_le : Module.finrank ↥F_sub ↥L_top ≤ n_tame := by
      have hInt_t : IsIntegral ↥F_sub t_top := Algebra.IsIntegral.isIntegral t_top
      let t₀_F : ↥F_sub := algebraMap ↥K_base ↥F_sub ⟨T₀, hT₀_mem⟩
      let P_rad : Polynomial ↥F_sub := Polynomial.X ^ n_tame - Polynomial.C t₀_F
      have hPrad_ne : P_rad ≠ 0 := Polynomial.X_pow_sub_C_ne_zero hn_pos t₀_F
      have hdvd : minpoly ↥F_sub t_top ∣ P_rad := by
        apply minpoly.dvd ↥F_sub t_top
        simp only [P_rad, map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C]
        apply Subtype.ext
        change T_tame ^ n_tame - algebraMap ↥K_base N ⟨T₀, hT₀_mem⟩ = 0
        exact sub_eq_zero.mpr hTtame_pow
      have hdeg_le : (minpoly ↥F_sub t_top).natDegree ≤ n_tame := by
        have h1 := Polynomial.natDegree_le_of_dvd hdvd hPrad_ne
        have h2 : P_rad.natDegree = n_tame := Polynomial.natDegree_X_pow_sub_C
        omega
      have h_adj_fin := IntermediateField.adjoin.finrank hInt_t
      have hTopEq : IntermediateField.adjoin ↥F_sub ({t_top} : Set ↥L_top) = ⊤ := hE_adj_top
      rw [hTopEq, IntermediateField.finrank_top'] at h_adj_fin
      omega

    let b_F : Fin n_tame → ↥L_top := fun i => t_top ^ (i : ℕ)
    have hbF_lin : LinearIndependent ↥F_sub b_F := by
      rw [Fintype.linearIndependent_iff]
      intro a hsum i₀
      by_contra hi₀
      classical
      let S : Finset (Fin n_tame) := Finset.univ.filter (fun i => a i ≠ 0)
      have hS_ne : S.Nonempty := ⟨i₀, Finset.mem_filter.mpr ⟨Finset.mem_univ i₀, hi₀⟩⟩
      have hS_sum : ∑ i ∈ S, (a i : N) * T_tame ^ (i : ℕ) = 0 := by
        have hsumN : ((∑ i : Fin n_tame, a i • b_F i : ↥L_top) : N) = 0 := by
          rw [hsum]
          rfl
        have hsumN' : ∑ i : Fin n_tame, (a i : N) * T_tame ^ (i : ℕ) = 0 := by
          rw [← hsumN, AddSubmonoidClass.coe_finset_sum]
          refine Finset.sum_congr rfl (fun i _ => ?_)
          rw [Algebra.smul_def, MulMemClass.coe_mul, SubmonoidClass.coe_pow]
          rfl
        rw [← hsumN']
        apply Finset.sum_subset (Finset.subset_univ S)
        intro i _ hi_not
        have hai : a i = 0 := by
          by_contra hne
          exact hi_not (Finset.mem_filter.mpr ⟨Finset.mem_univ i, hne⟩)
        simp [hai]
      have hS_dist : ∀ i ∈ S, ∀ j ∈ S, i ≠ j →
          ‖(a i : N) * T_tame ^ (i : ℕ)‖ ≠ ‖(a j : N) * T_tame ^ (j : ℕ)‖ := by
        intro i hi j hj hij
        have hai_ne : (a i : N) ≠ 0 := fun h0 => (Finset.mem_filter.mp hi).2 (Subtype.ext h0)
        have haj_ne : (a j : N) ≠ 0 := fun h0 => (Finset.mem_filter.mp hj).2 (Subtype.ext h0)
        exact hCosetDist i j hij (a i : N) (a j : N) hai_ne haj_ne
          (hValSub (a i : N) (a i).2 hai_ne)
          (hValSub (a j : N) (a j).2 haj_ne)
      obtain ⟨i_max, hi_max, hmax_eq, _⟩ :=
        hUltraMaxSum S (fun i => (a i : N) * T_tame ^ (i : ℕ)) hS_ne hS_dist
      rw [hS_sum, norm_zero] at hmax_eq
      exact mul_ne_zero (fun h0 => (Finset.mem_filter.mp hi_max).2 (Subtype.ext h0))
        (pow_ne_zero (i_max : ℕ) hTtame_ne) (norm_eq_zero.mp hmax_eq.symm)
    have hRankFL_ge : n_tame ≤ Module.finrank ↥F_sub ↥L_top := by
      have h := hbF_lin.fintype_card_le_finrank
      rwa [Fintype.card_fin] at h
    have hRankFL_eq : Module.finrank ↥F_sub ↥L_top = n_tame := by omega
    have hRankTop : Module.finrank ↥K_base ↥L_top = Module.finrank ↥K_base ↥F_sub * n_tame := by
      rw [← hRankFL_eq, Module.finrank_mul_finrank ↥K_base ↥F_sub ↥L_top]

    have hSpanTop : Submodule.span ↥F_sub (Set.range b_F) = ⊤ := by
      apply Submodule.eq_of_le_of_finrank_eq le_top
      rw [finrank_span_eq_card hbF_lin, Fintype.card_fin, finrank_top, hRankFL_eq]
    have hValTop : ∀ w ∈ L_top, w ≠ 0 → ∃ u ∈ K', ‖w‖ = ‖u‖ := by
      intro w hw hw_ne
      have hw_mem : (⟨w, hw⟩ : ↥L_top) ∈ Submodule.span ↥F_sub (Set.range b_F) := by
        rw [hSpanTop]
        exact Submodule.mem_top
      obtain ⟨y, hy_eq⟩ := (Submodule.mem_span_range_iff_exists_fun ↥F_sub).mp hw_mem
      have hw_sum : ∑ i : Fin n_tame, (y i : N) * T_tame ^ (i : ℕ) = w := by
        have h1 : ((∑ i : Fin n_tame, y i • b_F i : ↥L_top) : N) = w :=
          congrArg Subtype.val hy_eq
        rw [← h1, AddSubmonoidClass.coe_finset_sum]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [Algebra.smul_def, MulMemClass.coe_mul, SubmonoidClass.coe_pow]
        rfl
      classical
      let S : Finset (Fin n_tame) := Finset.univ.filter (fun i => y i ≠ 0)
      have hS_sum : ∑ i ∈ S, (y i : N) * T_tame ^ (i : ℕ) = w := by
        rw [← hw_sum]
        apply Finset.sum_subset (Finset.subset_univ S)
        intro i _ hi_not
        have hyi : y i = 0 := by
          by_contra hne
          exact hi_not (Finset.mem_filter.mpr ⟨Finset.mem_univ i, hne⟩)
        simp [hyi]
      have hS_ne : S.Nonempty := by
        by_contra hEmp
        rw [Finset.not_nonempty_iff_eq_empty.mp hEmp, Finset.sum_empty] at hS_sum
        exact hw_ne hS_sum.symm
      have hS_dist : ∀ i ∈ S, ∀ j ∈ S, i ≠ j →
          ‖(y i : N) * T_tame ^ (i : ℕ)‖ ≠ ‖(y j : N) * T_tame ^ (j : ℕ)‖ := by
        intro i hi j hj hij
        have hyi_ne : (y i : N) ≠ 0 := fun h0 => (Finset.mem_filter.mp hi).2 (Subtype.ext h0)
        have hyj_ne : (y j : N) ≠ 0 := fun h0 => (Finset.mem_filter.mp hj).2 (Subtype.ext h0)
        exact hCosetDist i j hij (y i : N) (y j : N) hyi_ne hyj_ne
          (hValSub (y i : N) (y i).2 hyi_ne)
          (hValSub (y j : N) (y j).2 hyj_ne)
      obtain ⟨j₀, hj₀, hmax_eq, _⟩ :=
        hUltraMaxSum S (fun i => (y i : N) * T_tame ^ (i : ℕ)) hS_ne hS_dist
      have hyj₀_ne : (y j₀ : N) ≠ 0 := fun h0 => (Finset.mem_filter.mp hj₀).2 (Subtype.ext h0)
      obtain ⟨u₀, hu₀_mem, hu₀_norm⟩ := hValSub (y j₀ : N) (y j₀).2 hyj₀_ne
      let u : N := algebraMap ↥K_base N ⟨u₀, hu₀_mem⟩ * T_tame ^ (j₀ : ℕ)
      have hu_memK' : u ∈ K' :=
        K'.mul_mem (K'_int.algebraMap_mem ⟨u₀, hu₀_mem⟩) (K'.pow_mem hTtame_mem (j₀ : ℕ))
      refine ⟨u, hu_memK', ?_⟩
      rw [← hS_sum, hmax_eq, norm_mul, hu₀_norm]
      dsimp [u]
      rw [norm_mul, hIsoBase]

    exact ⟨hClK', ⟨T_tame, hTtame_mem, hTtame_ne, hTtame_pow, hK'_adjoin⟩, hRankTop, hValTop⟩

  obtain ⟨hClK', ⟨T_tame, hTtame_mem, hTtame_ne, hTtame_pow, hK'_adjoin⟩, hRankTop, hValTop⟩ :=
    hHenselAndSup

  
  
  
  refine ⟨?_, ?_, hValTop, ?_⟩
  · refine ⟨?_, hClK', Or.inr ⟨T_tame, hTtame_mem, hTtame_ne, ?_, ?_⟩⟩
    · rintro _ ⟨c, rfl⟩
      exact hKhat_memK' c
    · intro c hc
      apply hT₀_irr (c ^ n_tame)
      have h1 : ‖T_tame‖ ^ n_tame = r := by
        rw [← norm_pow, hTtame_pow, hIsoBase]
      rw [norm_pow, ← hc, h1]
    · let S_tame : Subfield N := (IntermediateField.adjoin K_hat ({T_tame} : Set N)).toSubfield
      let L_tame : Subfield N := S_tame.topologicalClosure
      have hLtame_le_K' : L_tame ≤ K' := by
        let K'_khat : IntermediateField K_hat N :=
          { K' with algebraMap_mem' := hKhat_memK' }
        have hStame_le : S_tame ≤ K' :=
          show IntermediateField.adjoin K_hat ({T_tame} : Set N) ≤ K'_khat from
            IntermediateField.adjoin_le_iff.mpr (Set.singleton_subset_iff.mpr hTtame_mem)
        exact Subfield.topologicalClosure_minimal S_tame hStame_le hClK'
      have hTtame_Ltame : T_tame ∈ L_tame :=
        Subfield.le_topologicalClosure S_tame (IntermediateField.mem_adjoin_simple_self K_hat T_tame)
      have hKhat_Ltame : ∀ c : K_hat, algebraMap K_hat N c ∈ L_tame :=
        fun c => Subfield.le_topologicalClosure S_tame (IntermediateField.algebraMap_mem _ c)
      have hBase_in_Ltame : ∀ u : ↥K_base, algebraMap ↥K_base N u ∈ L_tame := by
        let M₀_sub : Subfield F_hat :=
          { carrier := { x : F_hat | ∃ hx : x ∈ K_base, algebraMap ↥K_base N ⟨x, hx⟩ ∈ L_tame }
            zero_mem' := ⟨K_base.zero_mem, by
              change algebraMap ↥K_base N 0 ∈ L_tame
              rw [map_zero]
              exact L_tame.zero_mem⟩
            one_mem' := ⟨K_base.one_mem, by
              change algebraMap ↥K_base N 1 ∈ L_tame
              rw [map_one]
              exact L_tame.one_mem⟩
            add_mem' := fun ⟨hx, hxL⟩ ⟨hy, hyL⟩ =>
              ⟨K_base.add_mem hx hy, by
                change algebraMap ↥K_base N (⟨_, hx⟩ + ⟨_, hy⟩) ∈ L_tame
                rw [map_add]
                exact L_tame.add_mem hxL hyL⟩
            neg_mem' := fun ⟨hx, hxL⟩ =>
              ⟨K_base.neg_mem hx, by
                change algebraMap ↥K_base N (-⟨_, hx⟩) ∈ L_tame
                rw [map_neg]
                exact L_tame.neg_mem hxL⟩
            mul_mem' := fun ⟨hx, hxL⟩ ⟨hy, hyL⟩ =>
              ⟨K_base.mul_mem hx hy, by
                change algebraMap ↥K_base N (⟨_, hx⟩ * ⟨_, hy⟩) ∈ L_tame
                rw [map_mul]
                exact L_tame.mul_mem hxL hyL⟩
            inv_mem' := fun _ ⟨hx, hxL⟩ =>
              ⟨K_base.inv_mem hx, by
                change algebraMap ↥K_base N ((⟨_, hx⟩)⁻¹) ∈ L_tame
                rw [map_inv₀]
                exact L_tame.inv_mem hxL⟩ }
        let M₀_if : IntermediateField K_hat F_hat :=
          { M₀_sub with
            algebraMap_mem' := fun c =>
              ⟨hRangeBase ⟨c, rfl⟩, by
                rw [← hAlgCompat c]
                exact hKhat_Ltame c⟩ }
        have hT₀_M₀ : T₀ ∈ M₀_if :=
          ⟨hT₀_mem, by
            rw [← hTtame_pow]
            exact L_tame.pow_mem hTtame_Ltame n_tame⟩
        let S_T₀ : Subfield F_hat := (IntermediateField.adjoin K_hat ({T₀} : Set F_hat)).toSubfield
        have hST₀_le_M₀ : S_T₀ ≤ M₀_if.toSubfield :=
          IntermediateField.adjoin_le_iff.mpr (Set.singleton_subset_iff.mpr hT₀_M₀)
        intro u
        have hu_cl : (u : F_hat) ∈ closure (S_T₀ : Set F_hat) :=
          (Set.ext_iff.mp (congrArg SetLike.coe hBase_eq) (u : F_hat)).mp u.2
        have hmap_cl : algebraMap ↥K_base N u ∈ closure (L_tame : Set N) := by
          rw [Metric.mem_closure_iff]
          intro ε hε
          obtain ⟨s, hs_mem, hs_dist⟩ := Metric.mem_closure_iff.mp hu_cl ε hε
          obtain ⟨hs_base, hs_Ltame⟩ := hST₀_le_M₀ hs_mem
          refine ⟨algebraMap ↥K_base N ⟨s, hs_base⟩, hs_Ltame, ?_⟩
          rw [dist_eq_norm, ← map_sub, hIsoBase]
          rwa [dist_eq_norm] at hs_dist
        have hCl_Ltame : IsClosed (L_tame : Set N) := Subfield.isClosed_topologicalClosure S_tame
        rwa [hCl_Ltame.closure_eq] at hmap_cl
      let L_tame_if : IntermediateField ↥K_base N :=
        { L_tame with algebraMap_mem' := hBase_in_Ltame }
      have hK'_le_Ltame : K' ≤ L_tame := by
        show K'_int ≤ L_tame_if
        rw [hK'_adjoin, IntermediateField.adjoin_le_iff, Set.singleton_subset_iff]
        exact hTtame_Ltame
      exact le_antisymm hK'_le_Ltame hLtame_le_K'
  · rw [hRankTop, hRankK']
  · intro w _ hw_le
    obtain ⟨e, he_mem, he_lt⟩ := hN_res w hw_le
    refine ⟨algebraMap K_hat N e, hKhat_memK' e, ?_, he_lt⟩
    rw [hIsoN]
    exact hE_norm e he_mem

theorem weil_types23_immediate_ext_eq_top (K_hat F_hat : Type u)
    [NontriviallyNormedField K_hat] [CompleteSpace K_hat]
    [IsUltrametricDist K_hat] [IsAlgClosed K_hat]
    [NontriviallyNormedField F_hat] [CompleteSpace F_hat]
    [IsUltrametricDist F_hat] [Algebra K_hat F_hat]
    (E_max : Subfield K_hat)
    (hEquiChar : ∀ p : ℕ, p.Prime → (p : K_hat) = 0 ∨ ‖(p : K_hat)‖ = 1)
    (hIsoK : ∀ c : K_hat, ‖algebraMap K_hat F_hat c‖ = ‖c‖)
    (hE_norm : ∀ c ∈ E_max, ‖c‖ ≤ 1)
    (hE_alg : IsAlgClosed ↥E_max)
    (hE_res : ∀ c : K_hat, ‖c‖ ≤ 1 → ∃ e ∈ E_max, ‖c - e‖ < 1)
    (hNoDegP : ∀ (E_hat : Type u)
      [NontriviallyNormedField E_hat] [CompleteSpace E_hat]
      [IsUltrametricDist E_hat] [Algebra K_hat E_hat],
