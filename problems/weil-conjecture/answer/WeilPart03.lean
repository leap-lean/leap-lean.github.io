  let Ψ : ↥W₁ →ₐ[↥V₁] P.Ring :=
    { ψ_inv with
      commutes' := fun v => by
        have hcomm_B : ψ₀ (algebraMap ↥V₁ B₀ v) = algebraMap ↥V₁ ↥W₁ v := ψ₀.commutes v
        change ψ_inv (algebraMap ↥V₁ ↥W₁ v) = algebraMap ↥V₁ P.Ring v
        rw [← hcomm_B]
        change (ψ_inv.comp ψ₀.toRingHom) (algebraMap ↥V₁ B₀ v) = _
        rw [hψ_inv_comp]
        exact α₀.commutes v }
  have hΨΦ : Ψ.comp Φ = AlgHom.id ↥V₁ P.Ring := by
    apply P.homEquiv.injective
    apply Subtype.ext
    simp only [StandardEtalePair.homEquiv_apply_coe, AlgHom.comp_apply, AlgHom.id_apply]
    rw [hΦ_X, ← hψ₀_root]
    change (ψ_inv.comp ψ₀.toRingHom) (AdjoinRoot.root f_V) = P.X
    rw [hψ_inv_comp]
    exact hα₀_root
  have hΦΨ : Φ.toRingHom.comp ψ_inv = RingHom.id ↥W₁ := by
    let _ : Algebra B₀ ↥W₁ := algBW
    have _ : IsLocalization.Away g_B ↥W₁ := locBW
    apply IsLocalization.ringHom_ext (Submonoid.powers g_B)
    change (Φ.toRingHom.comp ψ_inv).comp ψ₀.toRingHom = (RingHom.id ↥W₁).comp ψ₀.toRingHom
    rw [RingHom.comp_assoc, hψ_inv_comp, RingHom.id_comp]
    have halg_eq : Φ.comp α₀ = ψ₀ := by
      apply AdjoinRoot.algHom_ext
      rw [AlgHom.comp_apply, hα₀_root, hΦ_X, hψ₀_root]
    exact congrArg AlgHom.toRingHom halg_eq
  have hΦ_bij : Function.Bijective Φ := by
    refine ⟨?_, ?_⟩
    · intro x₁ x₂ hx
      have h1 := congrArg Ψ hx
      change (Ψ.comp Φ) x₁ = (Ψ.comp Φ) x₂ at h1
      rwa [hΨΦ, AlgHom.id_apply, AlgHom.id_apply] at h1
    · intro w
      refine ⟨Ψ w, ?_⟩
      change (Φ.toRingHom.comp ψ_inv) w = w
      rw [hΦΨ, RingHom.id_apply]
  change RingHom.Etale φ_V
  have hφ_comp : φ_V = Φ.toRingHom.comp (algebraMap ↥V₁ P.Ring) :=
    RingHom.ext fun v => (Φ.commutes v).symm
  rw [hφ_comp]
  exact RingHom.Etale.stableUnderComposition _ _
    (RingHom.etale_algebraMap.mpr inferInstance)
    (RingHom.Etale.of_bijective hΦ_bij)

theorem weil_sepClosed_algClosed_residue_and_completion : (∀ (K : Type u) [Field K] [IsSepClosed K] (R : ValuationSubring K),
      R ≠ ⊤ → IsAlgClosed (IsLocalRing.ResidueField ↥R)) ∧
    (∀ (K K_hat : Type u) [Field K] [IsSepClosed K]
      [NontriviallyNormedField K_hat] [CompleteSpace K_hat] [IsUltrametricDist K_hat]
      (ι_K : K →+* K_hat),
      DenseRange ι_K → IsAlgClosed K_hat) :=
by
  have monic_sum_helper : ∀ {A : Type u} [CommRing A] [Nontrivial A] (n : ℕ) (c : ℕ → A),
      let P : Polynomial A := Polynomial.X ^ n + ∑ i ∈ Finset.range n, Polynomial.C (c i) * Polynomial.X ^ i
      (∀ j < n, P.coeff j = c j) ∧ P.coeff n = 1 ∧ (∀ j, n < j → P.coeff j = 0) ∧
        P.natDegree = n ∧ P.Monic := by
    intro A _ _ n c
    dsimp only
    set P : Polynomial A := Polynomial.X ^ n + ∑ i ∈ Finset.range n, Polynomial.C (c i) * Polynomial.X ^ i
    have hcoeff_sum : ∀ j : ℕ,
        (∑ i ∈ Finset.range n, Polynomial.C (c i) * Polynomial.X ^ i).coeff j =
          ∑ i ∈ Finset.range n, if j = i then c i else 0 := by
      intro j
      rw [Polynomial.finsetSum_coeff]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, mul_ite, mul_one, mul_zero]
    have h_lt : ∀ j < n, P.coeff j = c j := by
      intro j hj
      rw [Polynomial.coeff_add, Polynomial.coeff_X_pow, ite_eq_right_iff.mpr fun h => absurd h (ne_of_lt hj),
        zero_add, hcoeff_sum]
      simp [Finset.mem_range.mpr hj]
    have h_eq : P.coeff n = 1 := by
      rw [Polynomial.coeff_add, Polynomial.coeff_X_pow, ite_eq_left_iff.mpr fun h => absurd rfl h, hcoeff_sum]
      have h0 : (∑ i ∈ Finset.range n, if n = i then c i else (0 : A)) = 0 :=
        Finset.sum_eq_zero fun i hi =>
          ite_eq_right_iff.mpr fun h => absurd h (ne_of_gt (Finset.mem_range.mp hi))
      rw [h0, add_zero]
    have h_gt : ∀ j, n < j → P.coeff j = 0 := by
      intro j hj
      rw [Polynomial.coeff_add, Polynomial.coeff_X_pow, ite_eq_right_iff.mpr fun h => absurd h (ne_of_gt hj),
        zero_add, hcoeff_sum]
      exact Finset.sum_eq_zero fun i hi =>
        ite_eq_right_iff.mpr fun h => absurd h (ne_of_gt (lt_trans (Finset.mem_range.mp hi) hj))
    have h_deg_le : P.natDegree ≤ n :=
      Polynomial.natDegree_le_iff_coeff_eq_zero.mpr fun N hN => h_gt N hN
    have h_deg_ge : n ≤ P.natDegree :=
      Polynomial.le_natDegree_of_ne_zero (by rw [h_eq]; exact one_ne_zero)
    have h_deg : P.natDegree = n := le_antisymm h_deg_le h_deg_ge
    have h_mon : P.Monic := by
      rw [Polynomial.Monic, Polynomial.leadingCoeff, h_deg, h_eq]
    exact ⟨h_lt, h_eq, h_gt, h_deg, h_mon⟩
  have s1_sep_lift : ∀ {R₀ : Type u} [CommRing R₀] [IsLocalRing R₀] (P : Polynomial R₀),
      P.Monic → (P.map (IsLocalRing.residue R₀)).Separable → P.Separable := by
    intro R₀ _ _ P hMon hSep_res
    let res := IsLocalRing.residue R₀
    obtain ⟨U_bar, V_bar, hUV_bar⟩ := (Polynomial.separable_def' (P.map res)).mp hSep_res
    obtain ⟨U, hU⟩ := Polynomial.map_surjective res IsLocalRing.residue_surjective U_bar
    obtain ⟨V, hV⟩ := Polynomial.map_surjective res IsLocalRing.residue_surjective V_bar
    let H : Polynomial R₀ := U * P + V * P.derivative - 1
    have hH_map : H.map res = 0 := by
      simp only [H, Polynomial.map_sub, Polynomial.map_add, Polynomial.map_mul, Polynomial.map_one,
         ← Polynomial.derivative_map, hU, hV, hUV_bar, sub_self]
    have hH_mem : ∀ i : ℕ, H.coeff i ∈ IsLocalRing.maximalIdeal R₀ := by
      intro i
      rw [← IsLocalRing.residue_eq_zero_iff]
      change res (H.coeff i) = 0
      rw [← Polynomial.coeff_map, hH_map, Polynomial.coeff_zero]
    let B := AdjoinRoot P
    let mk : Polynomial R₀ →+* B := AdjoinRoot.mk P
    have _ : Module.Finite R₀ B := (AdjoinRoot.powerBasis' hMon).finite
    have h_mkH : mk H = ∑ i ∈ H.support, (H.coeff i) • mk (Polynomial.X ^ i) := by
      conv_lhs => rw [Polynomial.as_sum_support_C_mul_X_pow H]
      rw [map_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [map_mul, AdjoinRoot.mk_C, Algebra.smul_def]
      rfl
    have h_mul_mem : ∀ b : B, b * mk H ∈ (IsLocalRing.maximalIdeal R₀) • (⊤ : Submodule R₀ B) := by
      intro b
      rw [h_mkH, Finset.mul_sum]
      refine Submodule.sum_mem _ fun i _ => ?_
      rw [mul_smul_comm]
      exact Submodule.smul_mem_smul (hH_mem i) Submodule.mem_top
    have h_rel : mk V * mk P.derivative = mk H + 1 := by
      have hmkP : mk P = 0 := AdjoinRoot.mk_self
      have h1 : U * P + V * P.derivative = H + 1 := by simp [H]
      have h2 := congrArg mk h1
      simpa [map_add, map_mul, hmkP] using h2
    let N : Submodule R₀ B := (Ideal.span ({mk P.derivative} : Set B)).restrictScalars R₀
    have h_le : (⊤ : Submodule R₀ B) ≤ N ⊔ (IsLocalRing.maximalIdeal R₀) • (⊤ : Submodule R₀ B) := by
      intro b _
      have hb1 : (b * mk V) * mk P.derivative ∈ N := by
        change (b * mk V) * mk P.derivative ∈ Ideal.span ({mk P.derivative} : Set B)
        rw [Ideal.mem_span_singleton]
        exact ⟨b * mk V, mul_comm _ _⟩
      have hb2 : -(b * mk H) ∈ (IsLocalRing.maximalIdeal R₀) • (⊤ : Submodule R₀ B) :=
        Submodule.neg_mem _ (h_mul_mem b)
      have hb_eq : (b * mk V) * mk P.derivative + -(b * mk H) = b := by
        calc (b * mk V) * mk P.derivative + -(b * mk H)
            = b * (mk V * mk P.derivative) - b * mk H := by ring
          _ = b * (mk H + 1) - b * mk H := by rw [h_rel]
          _ = b := by ring
      rw [← hb_eq]
      exact Submodule.add_mem_sup hb1 hb2
    have h_jac : IsLocalRing.maximalIdeal R₀ ≤ (⊥ : Ideal R₀).jacobson := by
      rw [IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top]
    have h_top_le : (⊤ : Submodule R₀ B) ≤ N :=
      Submodule.le_of_le_smul_of_le_jacobson_bot Module.Finite.fg_top h_jac h_le
    have h1_in_N : (1 : B) ∈ Ideal.span ({mk P.derivative} : Set B) :=
      h_top_le Submodule.mem_top
    rw [Ideal.mem_span_singleton] at h1_in_N
    obtain ⟨y, hy⟩ := h1_in_N
    obtain ⟨V₁, rfl⟩ := AdjoinRoot.mk_surjective (g := P) y
    have h_dvd : P ∣ (1 - V₁ * P.derivative) := by
      rw [← AdjoinRoot.mk_eq_zero]
      change mk (1 - V₁ * P.derivative) = 0
      rw [map_sub, map_one, map_mul, mul_comm (mk V₁), ← hy, sub_self]
    obtain ⟨U₁, hU₁⟩ := h_dvd
    rw [Polynomial.separable_def']
    refine ⟨U₁, V₁, ?_⟩
    calc U₁ * P + V₁ * P.derivative
        = P * U₁ + V₁ * P.derivative := by ring
      _ = (1 - V₁ * P.derivative) + V₁ * P.derivative := by rw [← hU₁]
      _ = 1 := by ring
  have mem_R_of_monic_root : ∀ {K : Type u} [Field K] (R : ValuationSubring K)
      (f : Polynomial ↥R) (α : K),
      f.Monic → (f.map R.subtype).eval α = 0 →
      ∃ r : ↥R, (f.map (IsLocalRing.residue ↥R)).eval (IsLocalRing.residue ↥R r) = 0 := by
    intro K _ R f α hf_mon h_eval
    have h_int : IsIntegral ↥R α := by
      refine ⟨f, hf_mon, ?_⟩
      change Polynomial.eval₂ R.subtype α f = 0
      rwa [← Polynomial.eval_map]
    obtain ⟨r, hr⟩ := IsIntegrallyClosed.isIntegral_iff.mp h_int
    have hr_eq : (r : K) = α := hr
    have hf_r : f.eval r = 0 := by
      apply Subtype.val_injective
      change R.subtype (f.eval r) = 0
      rw [Polynomial.eval, Polynomial.hom_eval₂, RingHom.comp_id, ← Polynomial.eval_map]
      simpa [hr_eq] using h_eval
    refine ⟨r, ?_⟩
    rw [Polynomial.eval_map]
    change Polynomial.eval₂ ((IsLocalRing.residue ↥R).comp (RingHom.id ↥R))
      (IsLocalRing.residue ↥R r) f = 0
    rw [← Polynomial.hom_eval₂, ← Polynomial.eval, hf_r, map_zero]
  have s2_sep_perturb : ∀ {K K_hat : Type u} [Field K] [NontriviallyNormedField K_hat]
      (ι_K : K →+* K_hat),
      DenseRange ι_K →
      ∀ (P : Polynomial K_hat), P.Monic → 1 ≤ P.natDegree →
      ∀ (η : ℝ), 0 < η →
      ∃ (Q : Polynomial K),
        Q.Monic ∧ Q.natDegree = P.natDegree ∧ Q.Separable ∧
        ∀ i : ℕ, ‖(Q.map ι_K).coeff i - P.coeff i‖ < η := by
    intro K K_hat _ _ ι_K hDense P hP_mon hn_pos η hη
    classical
    set n := P.natDegree
    by_cases hn1 : n = 1
    · obtain ⟨q₀, hq₀_dist⟩ := Metric.denseRange_iff.mp hDense (P.coeff 0) η hη
      have hq₀ : ‖ι_K q₀ - P.coeff 0‖ < η := by rwa [dist_comm, dist_eq_norm] at hq₀_dist
      let Q : Polynomial K := Polynomial.X + Polynomial.C q₀
      have hQ_mon : Q.Monic := Polynomial.monic_X_add_C q₀
      have hQ_deg : Q.natDegree = n := (Polynomial.natDegree_X_add_C q₀).trans hn1.symm
      have hQ_sep : Q.Separable := by
        rw [Polynomial.separable_def']
        refine ⟨0, 1, ?_⟩
        simp [Q]
      refine ⟨Q, hQ_mon, hQ_deg, hQ_sep, fun i => ?_⟩
      rcases eq_or_ne i 0 with rfl | hi0
      · simpa [Q] using hq₀
      · rcases eq_or_ne i 1 with rfl | hi1
        · have hP1 : P.coeff 1 = 1 := by
            rw [← hn1]
            exact hP_mon
          simp [Q, hP1, hη]
        · have hi_gt1 : 1 < i := by omega
          have hQi : (Q.map ι_K).coeff i = 0 := by
            rw [Polynomial.coeff_map, Polynomial.coeff_eq_zero_of_natDegree_lt (by rw [hQ_deg, hn1]; exact hi_gt1), map_zero]
          have hPi : P.coeff i = 0 :=
            Polynomial.coeff_eq_zero_of_natDegree_lt (by change n < i; omega)
          simp [hQi, hPi, hη]
    · have hn2 : 2 ≤ n := by omega
      obtain ⟨y, hy_pos, hy_lt1⟩ := NormedField.exists_norm_lt_one K_hat
      set r_ball : ℝ := min ‖y‖ (1 - ‖y‖) / 2
      have hr_pos : 0 < r_ball := half_pos (lt_min hy_pos (sub_pos.mpr hy_lt1))
      obtain ⟨π, hπ_dist⟩ := Metric.denseRange_iff.mp hDense y r_ball hr_pos
      have hπ_close : ‖ι_K π - y‖ < r_ball := by rwa [dist_comm, dist_eq_norm] at hπ_dist
      have hr_le1 : r_ball ≤ ‖y‖ / 2 := by
        dsimp [r_ball]; linarith [min_le_left ‖y‖ (1 - ‖y‖)]
      have hr_le2 : r_ball ≤ (1 - ‖y‖) / 2 := by
        dsimp [r_ball]; linarith [min_le_right ‖y‖ (1 - ‖y‖)]
      have hπ_pos : 0 < ‖ι_K π‖ := by
        have htri : ‖y‖ ≤ ‖ι_K π‖ + ‖y - ι_K π‖ := norm_le_insert' y (ι_K π)
        rw [norm_sub_rev] at htri
        linarith
      have hπ_lt1 : ‖ι_K π‖ < 1 := by
        have htri : ‖ι_K π‖ ≤ ‖y‖ + ‖ι_K π - y‖ := norm_le_insert' (ι_K π) y
        linarith
      have hπ_ne : π ≠ 0 := fun h0 => by simp [h0] at hπ_pos
      have h_approx_ex : ∀ i : ℕ, ∃ q : K, ‖ι_K q - P.coeff i‖ < η / 2 := by
        intro i
        obtain ⟨q, hq⟩ := Metric.denseRange_iff.mp hDense (P.coeff i) (η / 2) (half_pos hη)
        exact ⟨q, by rwa [dist_comm, dist_eq_norm] at hq⟩
      let q : ℕ → K := fun i => Classical.choose (h_approx_ex i)
      have hq : ∀ i : ℕ, ‖ι_K (q i) - P.coeff i‖ < η / 2 :=
        fun i => Classical.choose_spec (h_approx_ex i)
      have hTend_π : Filter.Tendsto (fun m : ℕ => ‖ι_K π‖ ^ m) Filter.atTop (nhds 0) :=
        tendsto_pow_atTop_nhds_zero_of_lt_one (norm_nonneg _) hπ_lt1
      obtain ⟨m₁, hm₁⟩ := (hTend_π.eventually (gt_mem_nhds (half_pos hη))).exists
      have hm₁_lt : ‖ι_K π‖ ^ m₁ < η / 2 := hm₁
      let h_coeff : ℕ → K := fun i =>
        if i = 1 then (if q 1 = 0 then π ^ m₁ else q 1) else q i
      have hh1_ne : h_coeff 1 ≠ 0 := by
        dsimp [h_coeff]
        split_ifs with hq1
        · exact pow_ne_zero m₁ hπ_ne
        · exact hq1
      have hh0_err : ‖ι_K (h_coeff 0) - P.coeff 0‖ < η / 2 := by
        simpa [h_coeff] using hq 0
      have hhi_err : ∀ i : ℕ, ‖ι_K (h_coeff i) - P.coeff i‖ < η := by
        intro i
        dsimp [h_coeff]
        split_ifs with hi1 hq1
        · subst hi1
          have hP1_norm : ‖P.coeff 1‖ < η / 2 := by
            have := hq 1
            simpa [hq1] using this
          rw [map_pow]
          have htri : ‖ι_K π ^ m₁ - P.coeff 1‖ ≤ ‖ι_K π ^ m₁‖ + ‖P.coeff 1‖ := norm_sub_le _ _
          rw [norm_pow] at htri
          linarith
        · subst hi1
          linarith [hq 1]
        · linarith [hq i]
      let H₁ : Polynomial K := Polynomial.X ^ n + ∑ i ∈ Finset.range n, Polynomial.C (h_coeff i) * Polynomial.X ^ i
      obtain ⟨hH₁_lt, hH₁_eq, hH₁_gt, hH₁_deg, hH₁_mon⟩ := monic_sum_helper n h_coeff
      have hH₁_deriv_ne : H₁.derivative ≠ 0 := by
        intro h0
        have hc0 : (H₁.derivative).coeff 0 = 0 := by rw [h0, Polynomial.coeff_zero]
        rw [Polynomial.coeff_derivative, zero_add, Nat.cast_zero, zero_add, mul_one,
          hH₁_lt 1 (by omega)] at hc0
        exact hh1_ne hc0
      obtain ⟨M₀, hM₀⟩ := (Filter.eventually_atTop.mp (hTend_π.eventually (gt_mem_nhds (half_pos hη))))
      let Ω : Type u := AlgebraicClosure K
      let φ : K →+* Ω := algebraMap K Ω
      let G_Ω : Polynomial Ω := (H₁.derivative).map φ
      have hG_ne : G_Ω ≠ 0 := Polynomial.map_ne_zero hH₁_deriv_ne
      let T_bad : Finset Ω :=
        (G_Ω.roots.toFinset).image (fun ρ => -((H₁.map φ).eval ρ))
      let f_π : ℕ → Ω := fun m => φ (π ^ m)
      have hf_π_inj : Function.Injective f_π := by
        intro a b hab
        have h_eqK : π ^ a = π ^ b := φ.injective hab
        have h_norm : ‖ι_K π‖ ^ a = ‖ι_K π‖ ^ b := by
          have := congrArg (fun x : K => ‖ι_K x‖) h_eqK
          simpa [map_pow, norm_pow] using this
        exact (pow_right_strictAnti₀ hπ_pos hπ_lt1).injective h_norm
      let I_idx : Finset ℕ := Finset.Ico M₀ (M₀ + T_bad.card + 1)
      have hI_card : (I_idx.image f_π).card = T_bad.card + 1 := by
        rw [Finset.card_image_of_injective I_idx hf_π_inj, Nat.card_Ico]
        omega
      have h_not_sub : ¬ (I_idx.image f_π ⊆ T_bad) := by
        intro hsub
        have hle := Finset.card_le_card hsub
        omega
      obtain ⟨y_Ω, hy_in, hy_not_bad⟩ := Finset.not_subset.mp h_not_sub
      obtain ⟨m, hm_in, rfl⟩ := Finset.mem_image.mp hy_in
      have hm_ge : M₀ ≤ m := (Finset.mem_Ico.mp hm_in).1
      have hπm_lt : ‖ι_K (π ^ m)‖ < η / 2 := by
        rw [map_pow, norm_pow]
        exact hM₀ m hm_ge
      let Q : Polynomial K := H₁ + Polynomial.C (π ^ m)
      have hQ_coeff_lt : ∀ j, 1 ≤ j → j < n → Q.coeff j = h_coeff j := by
        intro j hj1 hjn
        rw [Polynomial.coeff_add, hH₁_lt j hjn, Polynomial.coeff_C,
          ite_eq_right_iff.mpr (by omega), add_zero]
      have hQ_coeff_0 : Q.coeff 0 = h_coeff 0 + π ^ m := by
        rw [Polynomial.coeff_add, hH₁_lt 0 (by omega), Polynomial.coeff_C_zero]
      have hQ_coeff_n : Q.coeff n = 1 := by
        rw [Polynomial.coeff_add, hH₁_eq, Polynomial.coeff_C,
          ite_eq_right_iff.mpr (by omega), add_zero]
      have hQ_coeff_gt : ∀ j, n < j → Q.coeff j = 0 := by
        intro j hjn
        rw [Polynomial.coeff_add, hH₁_gt j hjn, Polynomial.coeff_C,
          ite_eq_right_iff.mpr (by omega), add_zero]
      have hQ_deg : Q.natDegree = n :=
        le_antisymm (Polynomial.natDegree_le_iff_coeff_eq_zero.mpr fun N hN => hQ_coeff_gt N hN)
          (Polynomial.le_natDegree_of_ne_zero (by rw [hQ_coeff_n]; exact one_ne_zero))
      have hQ_mon : Q.Monic := by
        rw [Polynomial.Monic, Polynomial.leadingCoeff, hQ_deg, hQ_coeff_n]
      have hQ_sep : Q.Separable := by
        rw [← Polynomial.separable_map φ]
        have hderiv_eq : (Q.map φ).derivative = G_Ω := by
          rw [Polynomial.derivative_map]
          dsimp [Q, G_Ω]
          rw [Polynomial.derivative_add, Polynomial.derivative_C, add_zero]
        change IsCoprime (Q.map φ) (Q.map φ).derivative
        rw [hderiv_eq, ← EuclideanDomain.gcd_isUnit_iff]
        by_contra h_not_unit
        set d := EuclideanDomain.gcd (Q.map φ) G_Ω
        have hd_deg : d.degree ≠ 0 := fun hdeg0 =>
          h_not_unit (Polynomial.isUnit_iff_degree_eq_zero.mpr hdeg0)
        obtain ⟨ρ, hρ_root⟩ := IsAlgClosed.exists_root d hd_deg
        have hd_eval : d.eval ρ = 0 := hρ_root
        have hQ_eval : (Q.map φ).eval ρ = 0 :=
          Polynomial.eval_eq_zero_of_dvd_of_eval_eq_zero (EuclideanDomain.gcd_dvd_left _ _) hd_eval
        have hG_eval : G_Ω.eval ρ = 0 :=
