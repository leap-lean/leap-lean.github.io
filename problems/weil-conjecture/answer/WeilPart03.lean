            have hz_zero : z = 0 := by
              rw [hsplit, hS_pos_eq, hu_zero, zero_add] at hsum
              exact (pow_eq_zero_iff hp.ne_zero).mp hsum
            have hg_S₀ : ∀ i ∈ S₀, g i = 0 := by
              let emb0 : ↥U₀ → Option (ℕ × ↥U₀) := fun u => some (0, u)
              let U_fin : Finset ↥U₀ := S₀.biUnion (fun i =>
                match i with
                | some (0, u) => {u}
                | _ => ∅)
              have hS₀_img : S₀ = U_fin.image emb0 := by
                ext i
                simp only [U_fin, emb0, Finset.mem_biUnion, Finset.mem_image]
                constructor
                · intro hi
                  rcases i with _ | ⟨n, u⟩
                  · exfalso; exact Bool.false_ne_true (Finset.mem_filter.mp hi).2
                  · rcases n with _ | k
                    · exact ⟨u, ⟨some (0, u), hi, Finset.mem_singleton_self u⟩, rfl⟩
                    · exfalso; exact Bool.false_ne_true (Finset.mem_filter.mp hi).2
                · rintro ⟨u, ⟨j, hj, hu_in⟩, rfl⟩
                  rcases j with _ | ⟨n, u'⟩
                  · simp at hu_in
                  · rcases n with _ | k
                    · simp only [Finset.mem_singleton] at hu_in; rwa [hu_in]
                    · simp at hu_in
              have hemb0_inj : Function.Injective emb0 := fun u₁ u₂ h => by injection h with h'; injection h'
              rw [hS₀_img, Finset.sum_image (fun x _ y _ h => hemb0_inj h)] at hu_zero
              have hu_zero' : ∑ u ∈ U_fin, g (emb0 u) • (u : ↥L1_coeff) = 0 := by
