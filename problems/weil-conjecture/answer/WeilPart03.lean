    have hℓ_norm_eq : ‖(ℓ : N)‖ = ‖(ℓ : K_hat)‖ := by
      rw [← map_natCast (algebraMap K_hat N) ℓ, hIsoN]
    rw [hℓ_norm_eq] at h_sum_lt
    have hℓ_lt_one : ‖(ℓ : K_hat)‖ < 1 := by
