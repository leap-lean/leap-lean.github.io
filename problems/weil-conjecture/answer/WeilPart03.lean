      let α : B →+* Polynomial B ⧸ Ideal.span {L} :=
        (Ideal.Quotient.mk (Ideal.span {L})).comp Polynomial.C
      Function.Surjective α ∧ RingHom.ker α = ⊥ := by
    intro B _ s c hs L α
    let u_s : Bˣ := hs.unit
    have hu_s : (u_s : B) = s := IsUnit.unit_spec hs
    let a₀ : B := (↑u_s⁻¹ : B) * c
    have heval_L : (Polynomial.evalRingHom a₀) L = 0 := by
      simp only [L, Polynomial.coe_evalRingHom, Polynomial.eval_sub, Polynomial.eval_mul,
        Polynomial.eval_C, Polynomial.eval_X, a₀]
      rw [← mul_assoc, ← hu_s, Units.mul_inv, one_mul, sub_self]
    have hspan_le : Ideal.span ({L} : Set (Polynomial B)) ≤ RingHom.ker (Polynomial.evalRingHom a₀) := by
      rw [Ideal.span_le, Set.singleton_subset_iff]
      exact heval_L
