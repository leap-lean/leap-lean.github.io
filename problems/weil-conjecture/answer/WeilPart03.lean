      have hRT0_map_in_RT3 : ∀ x ∈ R_T0, ∀ hxL : x ∈ L, algebraMap ↥L L₁ ⟨x, hxL⟩ ∈ R_T3 := by
        intro x hx
        change x ∈ V_T0 at hx
        rw [Finsupp.mem_span_range_iff_exists_finsupp] at hx
        rcases hx with ⟨c, rfl⟩
        intro hxL
        have hsum_L : (⟨(c.sum fun j a => a • T₀ ^ j), hxL⟩ : ↥L) =
            ∑ j ∈ c.support, ⟨algebraMap K_hat E_hat (c j), hRangeL ⟨c j, rfl⟩⟩ * ⟨T₀, hT₀_mem⟩ ^ j := by
          apply Subtype.ext
          change (c.sum fun j a => a • T₀ ^ j) = _
          rw [Finsupp.sum]
          push_cast
          refine Finset.sum_congr rfl fun j _ => ?_
          rw [Algebra.smul_def]; rfl
        rw [hsum_L, map_sum]
        refine R_T3.sum_mem fun j _ => ?_
        rw [map_mul, hAlgEq, map_zpow₀]
        change algebraMap K_hat L₁ (c j) * T₀₁ ^ j ∈ V_T3
        rw [← hT₃_m0, ← zpow_mul, ← Algebra.smul_def]
        exact V_T3.smul_mem (c j) (Submodule.subset_span ⟨(m₀ : ℤ) * j, rfl⟩)
      have hL_map_in_cl : ∀ x : ↥L, algebraMap ↥L L₁ x ∈ R_T3.topologicalClosure := by
        intro x
        change algebraMap ↥L L₁ x ∈ closure (R_T3 : Set L₁)
        rw [Metric.mem_closure_iff]
        intro ε hε
        have hx_cl : (x : E_hat) ∈ closure (R_T0 : Set E_hat) := hL_in_RT0 x.2
        rw [Metric.mem_closure_iff] at hx_cl
        obtain ⟨g0, hg0_R, hg0_dist⟩ := hx_cl ε hε
        have hg0_L : g0 ∈ L := by
          have hRT0_sub_L : (R_T0 : Set E_hat) ⊆ (L : Set E_hat) := by
            intro z hz
            change z ∈ V_T0 at hz
            refine Submodule.span_induction ?_ L.zero_mem (fun _ _ _ _ => L.add_mem) ?_ hz
            · rintro _ ⟨j, rfl⟩; exact L.zpow_mem hT₀_mem j
            · intro c y _ hy; rw [Algebra.smul_def]; exact L.mul_mem (hRangeL ⟨c, rfl⟩) hy
          exact hRT0_sub_L hg0_R
        refine ⟨algebraMap ↥L L₁ ⟨g0, hg0_L⟩, hRT0_map_in_RT3 g0 hg0_R hg0_L, ?_⟩
        rw [dist_eq_norm, ← map_sub, hIsoL₁]
        simpa [dist_eq_norm] using hg0_dist
      have hwa_in_cl : w_a ∈ R_T3.topologicalClosure := by
        rw [hwa_in_T3]
        refine R_T3.topologicalClosure.mul_mem
          (R_T3.topologicalClosure.mul_mem ?_ (hL_map_in_cl v₁)) ?_
        · apply Subring.le_topologicalClosure R_T3
          change algebraMap K_hat L₁ (d_k * ζ) ∈ V_T3
          have : algebraMap K_hat L₁ (d_k * ζ) = (d_k * ζ) • (T₃ ^ (0 : ℤ)) := by
            rw [zpow_zero, Algebra.smul_def, mul_one]
          rw [this]; exact V_T3.smul_mem _ (Submodule.subset_span ⟨0, rfl⟩)
        · apply Subring.le_topologicalClosure R_T3
          change T₃ ^ k₀ ∈ V_T3
          exact Submodule.subset_span ⟨k₀, rfl⟩
      have hL1_in_cl : ∀ b : L₁, b ∈ closure (R_T3 : Set L₁) := by
        intro b
        change b ∈ (R_T3.topologicalClosure : Set L₁)
        obtain ⟨f, rfl⟩ := hSpanL₁ b
        exact R_T3.topologicalClosure.sum_mem fun j _ =>
          R_T3.topologicalClosure.mul_mem (hL_map_in_cl (f j))
            (R_T3.topologicalClosure.pow_mem hwa_in_cl j)
      refine ⟨U, ?_, ?_⟩
      · intro b ε hε
        have hb_cl := hL1_in_cl b
        rw [Metric.mem_closure_iff] at hb_cl
        obtain ⟨b', hb'_RT3, hb'_dist⟩ := hb_cl ε hε
        refine ⟨b', hVT3_le_VB hb'_RT3, ?_⟩
        rwa [dist_eq_norm] at hb'_dist
      · intro u hu z
        by_cases hu0 : u = 0
        · subst hu0; simp
        · by_cases hz0 : z = 0
          · subst hz0; simp [zero_pow hp.ne_zero]
          · let idxU : {j : ℤ // ¬ ((p : ℤ) ∣ j)} → L₁ := fun j => T₃ ^ j.1
            have hU_eq : U = Set.range idxU := by
              ext x
              constructor
              · rintro ⟨j, hj, rfl⟩; exact ⟨⟨j, hj⟩, rfl⟩
              · rintro ⟨⟨j, hj⟩, rfl⟩; exact ⟨j, hj, rfl⟩
            rw [hU_eq, Finsupp.mem_span_range_iff_exists_finsupp] at hu
            obtain ⟨cu, rfl⟩ := hu
            let c_ext : ℤ → K_hat := fun j =>
              if hj : ¬ ((p : ℤ) ∣ j) then cu ⟨j, hj⟩ else 0
            let I_u : Finset ℤ := cu.support.image Subtype.val
            have hu_sum : (cu.sum fun i a => a • idxU i) =
                ∑ j ∈ I_u, algebraMap K_hat L₁ (c_ext j) * T₃ ^ j := by
              rw [Finsupp.sum, Finset.sum_image (fun x _ y _ hxy => Subtype.ext hxy)]
              refine Finset.sum_congr rfl fun i _ => ?_
              have hc_i : c_ext i.1 = cu i := dif_pos i.2
              rw [hc_i, Algebra.smul_def]
            rw [hu_sum] at hu0 ⊢
            have hIu_nonempty : ∃ j ∈ I_u, c_ext j ≠ 0 := by
              by_contra hno; push Not at hno; apply hu0
              exact Finset.sum_eq_zero fun j hj => by rw [hno j hj, map_zero, zero_mul]
            obtain ⟨j_star, hj_mem, hcj_ne, hu_norm_eq, _⟩ :=
              hLaurentMax hIsoK₁ T₃ hT₃_ne hT₃_irr I_u c_ext hIu_nonempty
            have hj_ndvd : ¬ ((p : ℤ) ∣ j_star) := by
              rcases Finset.mem_image.mp hj_mem with ⟨i, _, rfl⟩
              exact i.2
            have hz_pos : 0 < ‖z‖ := norm_pos_iff.mpr hz0
            have hz_cl := hL1_in_cl z
            rw [Metric.mem_closure_iff] at hz_cl
            obtain ⟨Q, hQ_mem, hQ_dist⟩ := hz_cl ‖z‖ hz_pos
            change Q ∈ V_T3 at hQ_mem
            rw [Finsupp.mem_span_range_iff_exists_finsupp] at hQ_mem
            obtain ⟨cQ, rfl⟩ := hQ_mem
            have hQ_sum : (cQ.sum fun m a => a • T₃ ^ m) =
                ∑ m ∈ cQ.support, algebraMap K_hat L₁ (cQ m) * T₃ ^ m := by
              rw [Finsupp.sum]
              refine Finset.sum_congr rfl fun m _ => by rw [Algebra.smul_def]
            rw [hQ_sum] at hQ_dist
            let Q_val := ∑ m ∈ cQ.support, algebraMap K_hat L₁ (cQ m) * T₃ ^ m
            have hQ_ne : Q_val ≠ 0 := by
              intro h0
              rw [dist_eq_norm] at hQ_dist
              change ‖z - Q_val‖ < ‖z‖ at hQ_dist
              rw [h0, sub_zero] at hQ_dist
              linarith
            have hcQ_nonempty : ∃ m ∈ cQ.support, cQ m ≠ 0 := by
              by_contra hno; push Not at hno; apply hQ_ne
              exact Finset.sum_eq_zero fun m hm => by rw [hno m hm, map_zero, zero_mul]
            obtain ⟨m_z, _, hcm_ne, hQ_norm_eq, _⟩ :=
              hLaurentMax hIsoK₁ T₃ hT₃_ne hT₃_irr cQ.support cQ hcQ_nonempty
            have hz_norm_eq : ‖z‖ = ‖algebraMap K_hat L₁ (cQ m_z) * T₃ ^ m_z‖ := by
              have hd : ‖Q_val - z‖ < ‖z‖ := by rwa [dist_comm, dist_eq_norm] at hQ_dist
              have hQz : ‖Q_val‖ = ‖z‖ := by
                have : Q_val = z + (Q_val - z) := by ring
                rw [this, hUltraEq z _ hd]
              exact hQz.symm.trans hQ_norm_eq
            have hzp_norm_eq : ‖z ^ p‖ = ‖algebraMap K_hat L₁ (cQ m_z ^ p) * T₃ ^ ((p : ℤ) * m_z)‖ := by
              rw [norm_pow, hz_norm_eq, norm_mul, hIsoK₁, mul_pow, norm_mul, hIsoK₁, norm_pow,
                mul_comm (p : ℤ) m_z, zpow_mul, zpow_natCast, norm_pow]
            have hnorm_ne : ‖∑ j ∈ I_u, algebraMap K_hat L₁ (c_ext j) * T₃ ^ j‖ ≠ ‖z ^ p‖ := by
              intro heq
              rw [hu_norm_eq, hzp_norm_eq, norm_mul, norm_mul, hIsoK₁, hIsoK₁] at heq
              have hdiff_ne : j_star - (p : ℤ) * m_z ≠ 0 := fun h0 => hj_ndvd ⟨m_z, sub_eq_zero.mp h0⟩
              have hc_div_ne : cQ m_z ^ p / c_ext j_star ≠ 0 :=
                div_ne_zero (pow_ne_zero p hcm_ne) hcj_ne
              have hTzpow : ‖T₃ ^ (j_star - (p : ℤ) * m_z)‖ = ‖cQ m_z ^ p / c_ext j_star‖ := by
                rw [zpow_sub₀ hT₃_ne, norm_div, norm_div]
                have h1 : 0 < ‖c_ext j_star‖ := norm_pos_iff.mpr hcj_ne
                have h2 : 0 < ‖T₃ ^ ((p : ℤ) * m_z)‖ := norm_pos_iff.mpr (zpow_ne_zero _ hT₃_ne)
                rw [div_eq_div_iff (ne_of_gt h2) (ne_of_gt h1)]
                linarith
              exact hIrrZpowNe hIsoK₁ T₃ hT₃_ne hT₃_irr _ hdiff_ne _ hc_div_ne hTzpow
            rcases lt_or_gt_of_ne hnorm_ne with hlt | hgt
            · rw [add_comm, hUltraEq (z ^ p) _ hlt]; exact le_of_lt hlt
            · rw [hUltraEq _ (z ^ p) hgt]
  
  obtain ⟨U, hDenseU, hOrthU⟩ := hex_U
  have hNegPow : ∀ x : L₁, (-x) ^ p = -(x ^ p) := by
    intro x
    have h0 : (x + -x) ^ p = 0 ^ p := by rw [add_neg_cancel]
    rw [add_pow_char, zero_pow hp.ne_zero] at h0
    exact eq_neg_of_add_eq_zero_right h0
  have hSubPow : ∀ x y : L₁, (x - y) ^ p = x ^ p - y ^ p := by
    intro x y
    rw [sub_eq_add_neg, add_pow_char, hNegPow, ← sub_eq_add_neg]
  have hs_pos : 0 < s := by
    rcases hSpec with ⟨_, hs⟩ | ⟨_, rfl⟩
    · exact hs
    · norm_num
  let S_pow : Set L₁ := {1} ∪ ⋃ (n : ℕ), (fun u : L₁ => u ^ (p ^ n)) '' U
  obtain ⟨b', hb'_mem, hb'_dist⟩ := hDenseU b₁ s hs_pos
  have hGt' : ∀ y : L₁, s < ‖y ^ p - algebraMap K_hat L₁ a * y + b'‖ := by
    intro y
    have hy1 : s < ‖y ^ p - algebraMap K_hat L₁ a * y + b₁‖ := hGt₁ y
    have hlt : ‖b' - b₁‖ < ‖y ^ p - algebraMap K_hat L₁ a * y + b₁‖ := by
      rw [norm_sub_rev]
      exact lt_trans hb'_dist hy1
    have heq : y ^ p - algebraMap K_hat L₁ a * y + b' =
        (y ^ p - algebraMap K_hat L₁ a * y + b₁) + (b' - b₁) := by ring
    rw [heq, hUltraEq _ _ hlt]
    exact hy1
  have hInf' : ∀ ε : ℝ, 0 < ε → ∃ y : L₁, ‖y ^ p - algebraMap K_hat L₁ a * y + b'‖ < s + ε := by
    intro ε hε
    obtain ⟨y, hy⟩ := hInf₁ ε hε
    refine ⟨y, ?_⟩
    have heq : y ^ p - algebraMap K_hat L₁ a * y + b' =
        (y ^ p - algebraMap K_hat L₁ a * y + b₁) + (b' - b₁) := by ring
    rw [heq]
    calc
      ‖(y ^ p - algebraMap K_hat L₁ a * y + b₁) + (b' - b₁)‖
          ≤ max ‖y ^ p - algebraMap K_hat L₁ a * y + b₁‖ ‖b' - b₁‖ :=
        IsUltrametricDist.norm_add_le_max _ _
      _ < s + ε := by
        rw [max_lt_iff, norm_sub_rev]
        exact ⟨hy, by linarith⟩
  let M_good : L₁ → Prop := fun x =>
    ∃ u ∈ Submodule.span K_hat U, ∃ w : L₁, x = u + (w ^ p - algebraMap K_hat L₁ a * w)
  have hM_zero : M_good 0 := by
    refine ⟨0, Submodule.zero_mem _, 0, ?_⟩
    simp [zero_pow hp.ne_zero]
  have hM_add : ∀ {x₁ x₂ : L₁}, M_good x₁ → M_good x₂ → M_good (x₁ + x₂) := by
    rintro x₁ x₂ ⟨u₁, hu₁, w₁, rfl⟩ ⟨u₂, hu₂, w₂, rfl⟩
    refine ⟨u₁ + u₂, Submodule.add_mem _ hu₁ hu₂, w₁ + w₂, ?_⟩
    rw [add_pow_char]
    ring
  have hM_one : ∀ c : K_hat, M_good (algebraMap K_hat L₁ c * 1) := by
    intro c
    let P : Polynomial K_hat :=
      Polynomial.X ^ p - (Polynomial.C a * Polynomial.X + Polynomial.C c)
    have hdeg_lt : (Polynomial.C a * Polynomial.X + Polynomial.C c).degree <
        (Polynomial.X ^ p : Polynomial K_hat).degree := by
      rw [Polynomial.degree_X_pow]
      have hle : (Polynomial.C a * Polynomial.X + Polynomial.C c).degree ≤ 1 := by
        refine le_trans (Polynomial.degree_add_le _ _) (max_le ?_ ?_)
        · exact Polynomial.degree_C_mul_X_le a
        · exact le_trans Polynomial.degree_C_le (by decide)
      exact lt_of_le_of_lt hle (WithBot.coe_lt_coe.mpr hp.one_lt)
    have hdeg : P.degree ≠ 0 := by
      dsimp [P]
      rw [Polynomial.degree_sub_eq_left_of_degree_lt hdeg_lt, Polynomial.degree_X_pow]
      exact ne_of_gt (WithBot.coe_lt_coe.mpr hp.pos)
    obtain ⟨w₀, hw₀⟩ := IsAlgClosed.exists_root P hdeg
    have hw₀_eq : w₀ ^ p - a * w₀ = c := by
      have h0 : Polynomial.eval w₀ P = 0 := hw₀
      simp only [P, Polynomial.eval_sub, Polynomial.eval_add, Polynomial.eval_mul,
        Polynomial.eval_pow, Polynomial.eval_X, Polynomial.eval_C] at h0
      linear_combination h0
    refine ⟨0, Submodule.zero_mem _, algebraMap K_hat L₁ w₀, ?_⟩
    have hmap := congrArg (algebraMap K_hat L₁) hw₀_eq
    simp only [map_sub, map_pow, map_mul] at hmap
    rw [mul_one, zero_add, hmap]
  have hM_pow : ∀ (n : ℕ) (u₀ : L₁), u₀ ∈ U → ∀ c : K_hat,
      M_good (algebraMap K_hat L₁ c * u₀ ^ (p ^ n)) := by
    intro n u₀ hu₀
    induction n with
    | zero =>
      intro c
      rw [pow_zero, pow_one]
      refine ⟨c • u₀, Submodule.smul_mem _ c (Submodule.subset_span hu₀), 0, ?_⟩
      simp [Algebra.smul_def, zero_pow hp.ne_zero]
    | succ k ih =>
      intro c
      obtain ⟨d, rfl⟩ := hPowRoot p hp.pos c
      obtain ⟨u₁, hu₁, w₁, hw₁⟩ := ih (a * d)
      let w₂ : L₁ := algebraMap K_hat L₁ d * u₀ ^ (p ^ k)
      have hw₂_pow : w₂ ^ p = algebraMap K_hat L₁ (d ^ p) * u₀ ^ (p ^ (k + 1)) := by
        dsimp [w₂]
        rw [mul_pow, map_pow, ← pow_mul, pow_succ]
      refine ⟨u₁, hu₁, w₁ + w₂, ?_⟩
      rw [add_pow_char]
      have h_step : algebraMap K_hat L₁ (d ^ p) * u₀ ^ (p ^ (k + 1)) =
          algebraMap K_hat L₁ (a * d) * u₀ ^ (p ^ k) + (w₂ ^ p - algebraMap K_hat L₁ a * w₂) := by
        rw [hw₂_pow]
        dsimp [w₂]
        rw [map_mul]
        ring
      rw [h_step, hw₁]
      ring
  have hM_gen : ∀ (g : ↥S_pow) (c : K_hat), M_good (c • (g : L₁)) := by
    rintro ⟨g, hg⟩ c
    rw [Algebra.smul_def]
    dsimp only
    rcases hg with h1 | hU
    · rw [Set.mem_singleton_iff.mp h1]
      exact hM_one c
    · rcases Set.mem_iUnion.mp hU with ⟨n, u₀, hu₀, rfl⟩
      exact hM_pow n u₀ hu₀ c
  obtain ⟨l, hl⟩ := (Finsupp.mem_span_iff_linearCombination K_hat S_pow b').mp hb'_mem
  have hM_b' : M_good b' := by
    rw [← hl, Finsupp.linearCombination_apply, Finsupp.sum]
    have : ∀ (S : Finset ↥S_pow), M_good (∑ g ∈ S, l g • (g : L₁)) := by
      intro S
      induction S using Finset.induction_on with
      | empty => simpa using hM_zero
      | @insert g S hg ih =>
        rw [Finset.sum_insert hg]
        exact hM_add (hM_gen g (l g)) ih
    exact this l.support
  obtain ⟨u_star, hu_star, w_red, hb'_eq⟩ := hM_b'
  have hShift : ∀ z : L₁,
      (z - w_red) ^ p - algebraMap K_hat L₁ a * (z - w_red) + b' =
        z ^ p - algebraMap K_hat L₁ a * z + u_star := by
    intro z
    rw [hSubPow, hb'_eq]
    ring
  have hu_gt_s : s < ‖u_star‖ := by
    have h0 := hGt' (0 - w_red)
    rw [hShift 0] at h0
    simpa [zero_pow hp.ne_zero] using h0
  obtain ⟨y₀, hy₀⟩ := hInf' (‖u_star‖ - s) (sub_pos.mpr hu_gt_s)
  let z₀ : L₁ := y₀ + w_red
  have hz₀_lt : ‖z₀ ^ p - algebraMap K_hat L₁ a * z₀ + u_star‖ < ‖u_star‖ := by
    have heq : y₀ = z₀ - w_red := by dsimp [z₀]; ring
    rw [← hShift z₀, ← heq]
    linarith
  have hOrth_z₀ : ‖u_star‖ ≤ ‖u_star + z₀ ^ p‖ := hOrthU u_star hu_star z₀
  rcases hSpec with ⟨rfl, _⟩ | ⟨rfl, rfl⟩
  · simp only [map_zero, zero_mul, sub_zero, add_comm (z₀ ^ p) u_star] at hz₀_lt
    linarith
  · simp only [map_one, one_mul] at hz₀_lt
    have hz₀_gt_one : 1 < ‖z₀‖ := by
      by_contra hle
      push Not at hle
      have h_sub_le : ‖z₀ ^ p - z₀‖ ≤ 1 := by
        rw [sub_eq_add_neg]
        refine le_trans (IsUltrametricDist.norm_add_le_max _ _) (max_le ?_ ?_)
        · rw [norm_pow]
          exact pow_le_one₀ (norm_nonneg z₀) hle
        · rwa [norm_neg]
      have h_lt_u : ‖z₀ ^ p - z₀‖ < ‖u_star‖ := lt_of_le_of_lt h_sub_le hu_gt_s
      have h_eq : ‖z₀ ^ p - z₀ + u_star‖ = ‖u_star‖ := by
        rw [add_comm, hUltraEq _ _ h_lt_u]
      linarith
    have hz₀_pow_gt : ‖z₀‖ < ‖z₀ ^ p‖ := by
      rw [norm_pow]
      calc
        ‖z₀‖ = ‖z₀‖ ^ 1 := (pow_one _).symm
        _ < ‖z₀‖ ^ p := pow_lt_pow_right₀ hz₀_gt_one hp.one_lt
    have h_diff_eq : ‖z₀ ^ p - z₀‖ = ‖z₀ ^ p‖ := by
      rw [sub_eq_add_neg]
      apply hUltraEq
      rwa [norm_neg]
    have h_u_eq_pow : ‖u_star‖ = ‖z₀ ^ p‖ := by
      have heq : z₀ ^ p - z₀ = (-u_star) + (z₀ ^ p - z₀ + u_star) := by ring
      have hlt : ‖z₀ ^ p - z₀ + u_star‖ < ‖-u_star‖ := by simpa [norm_neg] using hz₀_lt
      have h1 := hUltraEq (-u_star) (z₀ ^ p - z₀ + u_star) hlt
      rw [← heq, norm_neg, h_diff_eq] at h1
      exact h1.symm
    have hz₀_lt_u : ‖z₀‖ < ‖u_star‖ := h_u_eq_pow ▸ hz₀_pow_gt
    have h_contra : ‖u_star + z₀ ^ p‖ < ‖u_star‖ := by
      have heq : u_star + z₀ ^ p = (z₀ ^ p - z₀ + u_star) + z₀ := by ring
      rw [heq]
      exact lt_of_le_of_lt (IsUltrametricDist.norm_add_le_max _ _)
        (max_lt hz₀_lt hz₀_lt_u)
    linarith

theorem weil_type2_wild_fixedField_modRamified_and_immediate (K_hat F_hat N : Type u)
    [NontriviallyNormedField K_hat] [CompleteSpace K_hat]
    [IsUltrametricDist K_hat] [IsAlgClosed K_hat]
    [NontriviallyNormedField F_hat] [CompleteSpace F_hat]
    [IsUltrametricDist F_hat] [Algebra K_hat F_hat]
    [NontriviallyNormedField N] [CompleteSpace N]
    [IsUltrametricDist N] [Algebra K_hat N]
    (E_max : Subfield K_hat)
    (hIsoK : ∀ c : K_hat, ‖algebraMap K_hat F_hat c‖ = ‖c‖)
    (hIsoN : ∀ c : K_hat, ‖algebraMap K_hat N c‖ = ‖c‖)
    (K_base : Subfield F_hat)
    (hRangeBase : Set.range (algebraMap K_hat F_hat) ⊆ (K_base : Set F_hat))
    (hClBase : IsClosed (K_base : Set F_hat))
    (hType2 : ∃ (T : F_hat) (L_coeff : Subfield F_hat)
      (hT : T ∈ L_coeff)
      (hE_sub : ∀ e : ↥E_max, algebraMap K_hat F_hat (e : K_hat) ∈ L_coeff),
      L_coeff ≤ K_base ∧
      (∀ P : Polynomial ↥E_max, P ≠ 0 →
        ‖Polynomial.aeval T (Polynomial.map ((algebraMap K_hat F_hat).comp E_max.subtype) P)‖ = 1) ∧
      (∀ z ∈ L_coeff, ‖z‖ ≤ 1) ∧
      (∀ u ∈ K_base, u ≠ 0 → ∃ c : K_hat, ‖u‖ = ‖c‖) ∧
      (∀ w ∈ K_base, ‖w‖ ≤ 1 → ∃ z ∈ L_coeff, ‖w - z‖ < 1) ∧
      (let ιE : ↥E_max →+* ↥L_coeff :=
         ((algebraMap K_hat F_hat).comp E_max.subtype).codRestrict L_coeff.toSubring hE_sub
       letI : Algebra ↥E_max ↥L_coeff := ιE.toAlgebra
       let Kt : IntermediateField ↥E_max ↥L_coeff :=
         IntermediateField.adjoin ↥E_max ({⟨T, hT⟩} : Set ↥L_coeff)
       FiniteDimensional ↥Kt ↥L_coeff ∧ Algebra.IsSeparable ↥Kt ↥L_coeff) ∧
      (let L_T : Subfield F_hat :=
         (IntermediateField.adjoin K_hat ({T} : Set F_hat)).toSubfield.topologicalClosure
       ∃ B_fin : Finset F_hat, (↑B_fin : Set F_hat) ⊆ (L_coeff : Set F_hat) ∧
         ∀ u ∈ K_base, ∃ c : F_hat → F_hat, (∀ b ∈ B_fin, c b ∈ L_T) ∧
           u = ∑ b ∈ B_fin, c b * b))
    [Algebra ↥K_base N] [FiniteDimensional ↥K_base N] [IsGalois ↥K_base N]
    (hIsoBase : ∀ u : ↥K_base, ‖algebraMap ↥K_base N u‖ = ‖(u : F_hat)‖)
    (hAlgCompat : ∀ c : K_hat,
      algebraMap K_hat N c = algebraMap ↥K_base N ⟨algebraMap K_hat F_hat c, hRangeBase ⟨c, rfl⟩⟩)
    (hIsoGal : ∀ (σ : N ≃ₐ[↥K_base] N) (x : N), ‖σ x‖ = ‖x‖)
    (P : Subgroup (N ≃ₐ[↥K_base] N)) [P.Normal]
    (hP_mem : ∀ σ : N ≃ₐ[↥K_base] N, σ ∈ P ↔ ∀ x : N, x ≠ 0 → ‖σ x - x‖ < ‖x‖)
    (F_sub : IntermediateField ↥K_base N)
    (hResSub : ∀ w ∈ F_sub, ‖w‖ ≤ 1 →
      ∃ u : ↥K_base, ‖(u : F_hat)‖ ≤ 1 ∧ ‖w - algebraMap ↥K_base N u‖ < 1) :
    let K'_int : IntermediateField ↥K_base N := IntermediateField.fixedField P
    let K' : Subfield N := K'_int.toSubfield
    let L_top : IntermediateField ↥K_base N := K'_int ⊔ F_sub
    IsWeilType23ModRamified K_hat N E_max K' ∧
    Module.finrank ↥K_base ↥L_top =
      Module.finrank ↥K_base ↥F_sub * Module.finrank ↥K_base ↥K'_int ∧
    (∀ w ∈ L_top, w ≠ 0 → ∃ u ∈ K', ‖w‖ = ‖u‖) ∧
    (∀ w ∈ L_top, ‖w‖ ≤ 1 → ∃ u ∈ K', ‖u‖ ≤ 1 ∧ ‖w - u‖ < 1) :=
by
  
  have hS1 : ∀ (K₀ : Type u) [Field K₀] [Algebra K₀ N] [FiniteDimensional K₀ N] [IsGalois K₀ N]
      (L₀ : Subfield N)
      (_hKhat_fixed : ∀ (σ : N ≃ₐ[K₀] N) (c : K_hat),
        σ (algebraMap K_hat N c) = algebraMap K_hat N c)
      (_hIsoGal₀ : ∀ (σ : N ≃ₐ[K₀] N) (x : N), ‖σ x‖ = ‖x‖)
      (_hBaseVal₀ : ∀ u : K₀, u ≠ 0 → ∃ c : K_hat, ‖algebraMap K₀ N u‖ = ‖c‖)
      (_hL₀_sub : (L₀ : Set N) ⊆ Set.range (algebraMap K₀ N))
      (_hL₀_norm : ∀ z ∈ L₀, ‖z‖ ≤ 1)
      (_hBaseRes₀ : ∀ u : K₀, ‖algebraMap K₀ N u‖ ≤ 1 → ∃ z ∈ L₀, ‖algebraMap K₀ N u - z‖ < 1)
      (P₀ : Subgroup (N ≃ₐ[K₀] N)) [P₀.Normal]
      (_hP₀_mem : ∀ σ : N ≃ₐ[K₀] N, σ ∈ P₀ ↔ ∀ x : N, x ≠ 0 → ‖σ x - x‖ < ‖x‖),
      let K'₀_int : IntermediateField K₀ N := IntermediateField.fixedField P₀
      let K'₀ : Subfield N := K'₀_int.toSubfield
      let m₀ : ℕ := Module.finrank K₀ ↥K'₀_int
      (∀ w : N, w ≠ 0 → ∃ c : K_hat, ‖w‖ = ‖c‖) ∧
      IsClosed (K'₀ : Set N) ∧
      ∃ (y₀ : N) (f₀ : Polynomial ↥L₀),
        y₀ ∈ K'₀ ∧ ‖y₀‖ ≤ 1 ∧
        f₀.Monic ∧ Irreducible f₀ ∧ f₀.Separable ∧ f₀.natDegree = m₀ ∧
        ‖Polynomial.eval y₀ (f₀.map L₀.subtype)‖ < 1 ∧
        ‖Polynomial.eval y₀ (Polynomial.derivative (f₀.map L₀.subtype))‖ = 1 ∧
        (∀ (θ' : N), ‖θ' - y₀‖ < 1 →
          ∀ (a : Fin m₀ → ↥L₀) (j : Fin m₀),
            ‖(a j : N)‖ ≤ ‖∑ i : Fin m₀, (a i : N) * (θ') ^ (i : ℕ)‖) := by
    intro K₀ _ _ _ _ L₀ hKhat_fixed hIsoGal₀ hBaseVal₀ hL₀_sub hL₀_norm hBaseRes₀ P₀ hP₀_norm hP₀_mem
    classical
    dsimp only
    let K'₀_int : IntermediateField K₀ N := IntermediateField.fixedField P₀
    let K'₀ : Subfield N := K'₀_int.toSubfield
    let m₀ : ℕ := Module.finrank K₀ ↥K'₀_int
    letI : Fintype (N ≃ₐ[K₀] N) := AlgEquiv.fintype K₀ N
    haveI : FiniteDimensional K₀ ↥K'₀_int := FiniteDimensional.left K₀ ↥K'₀_int N

    have hN_val : ∀ w : N, w ≠ 0 → ∃ c : K_hat, ‖w‖ = ‖c‖ := by
      intro w hw
      let y : N := ∏ σ : (N ≃ₐ[K₀] N), σ w
      have hτy : ∀ τ : (N ≃ₐ[K₀] N), τ y = y := by
        intro τ
        dsimp [y]
        rw [map_prod]
        exact Fintype.prod_equiv (Equiv.mulLeft τ) (fun σ => τ (σ w)) (fun σ => σ w) (fun _ => rfl)
      have hy_fix : y ∈ IntermediateField.fixedField (⊤ : Subgroup (N ≃ₐ[K₀] N)) := by
        rw [IntermediateField.mem_fixedField_iff]
        intro τ _
        exact hτy τ
      rw [IsGalois.fixedField_top, IntermediateField.mem_bot] at hy_fix
      obtain ⟨u, hu⟩ := hy_fix
      have hy_norm : ‖y‖ = ‖w‖ ^ Fintype.card (N ≃ₐ[K₀] N) := by
        dsimp [y]
        rw [norm_prod]
        simp_rw [hIsoGal₀]
        rw [Finset.prod_const, Finset.card_univ]
      have hw_pos : 0 < ‖w‖ := norm_pos_iff.mpr hw
      have hy_pos : 0 < ‖y‖ := hy_norm ▸ pow_pos hw_pos _
      have hu_ne : u ≠ 0 := by
        intro hu0
        rw [hu0, map_zero] at hu
        rw [← hu, norm_zero] at hy_pos
        exact lt_irrefl 0 hy_pos
      obtain ⟨c₀, hc₀⟩ := hBaseVal₀ u hu_ne
      obtain ⟨c, hc⟩ := IsAlgClosed.exists_pow_nat_eq c₀ (Fintype.card_pos (α := N ≃ₐ[K₀] N))
      refine ⟨c, ?_⟩
      have hpow_eq : ‖w‖ ^ Fintype.card (N ≃ₐ[K₀] N) = ‖c‖ ^ Fintype.card (N ≃ₐ[K₀] N) := by
        rw [← hy_norm, ← hu, hc₀, ← hc, norm_pow]
      exact (pow_left_inj₀ (norm_nonneg w) (norm_nonneg c)
        (Fintype.card_ne_zero (α := N ≃ₐ[K₀] N))).mp hpow_eq

    have hP_unit : ∀ σ : N ≃ₐ[K₀] N, σ ∈ P₀ ↔ ∀ x : N, ‖x‖ ≤ 1 → ‖σ x - x‖ < 1 := by
      intro σ
      constructor
      · intro hσ x hx_le
        by_cases hx0 : x = 0
        · subst hx0; simp
        · exact ((hP₀_mem σ).mp hσ x hx0).trans_le hx_le
      · intro h
        rw [hP₀_mem]
        intro x hx
        obtain ⟨c, hc⟩ := hN_val x hx
        let cN : N := algebraMap K_hat N c
        have hcN_norm : ‖cN‖ = ‖x‖ := (hIsoN c).trans hc.symm
        have hx_pos : 0 < ‖x‖ := norm_pos_iff.mpr hx
        have hcN_ne : cN ≠ 0 := norm_ne_zero_iff.mp (hcN_norm.symm ▸ hx_pos.ne')
        let y : N := cN⁻¹ * x
        have hy_le : ‖y‖ ≤ 1 := by
          dsimp [y]
          rw [norm_mul, norm_inv, hcN_norm, inv_mul_cancel₀ hx_pos.ne']
        have hxy : x = cN * y := by
          dsimp [y]
          rw [mul_inv_cancel_left₀ hcN_ne]
        have hdiff : σ x - x = cN * (σ y - y) := by
          conv_lhs => rw [hxy]
          rw [map_mul, hKhat_fixed σ c, mul_sub]
        rw [hdiff, norm_mul, hcN_norm]
        exact mul_lt_of_lt_one_right hx_pos (h y hy_le)

    have hClK' : IsClosed (K'₀ : Set N) := by
      have hSet : (K'₀ : Set N) = ⋂ σ ∈ (P₀ : Set (N ≃ₐ[K₀] N)), {x : N | σ x = x} := by
        ext x
        simp only [SetLike.mem_coe, Set.mem_iInter, Set.mem_ofPred_eq]
        exact IntermediateField.mem_fixedField_iff P₀ x
      rw [hSet]
      refine isClosed_biInter fun σ _ => ?_
      have hcont : Continuous (σ : N → N) :=
        (Isometry.of_dist_eq fun x y => by
          rw [dist_eq_norm, dist_eq_norm, ← map_sub, hIsoGal₀]).continuous
      exact isClosed_eq hcont continuous_id

    have hL₀_le_K' : L₀ ≤ K'₀ := by
      intro z hz
      obtain ⟨u, rfl⟩ := hL₀_sub hz
      exact K'₀_int.algebraMap_mem u

    have hUltraSumLt1 : ∀ (s : Finset ℕ) (g : ℕ → N),
        (∀ i ∈ s, ‖g i‖ < 1) → ‖∑ i ∈ s, g i‖ < 1 := by
      intro s g hg
      induction s using Finset.induction_on with
      | empty => simp
      | @insert a t hat ih =>
        rw [Finset.sum_insert hat]
        refine (IsUltrametricDist.norm_add_le_max _ _).trans_lt (max_lt ?_ ?_)
        · exact hg a (Finset.mem_insert_self a t)
        · exact ih (fun i hi => hg i (Finset.mem_insert_of_mem hi))

    let ON : ValuationSubring N := (NormedField.valuation (K := N)).valuationSubring
    let κN := IsLocalRing.ResidueField ↥ON
    let resN : ↥ON →+* κN := IsLocalRing.residue ↥ON
    have hMemON : ∀ x : N, x ∈ ON ↔ ‖x‖ ≤ 1 := by
      intro x
      rw [Valuation.mem_valuationSubring_iff, NormedField.valuation_apply,
        ← NNReal.coe_le_coe, NNReal.coe_one, coe_nnnorm]
    have hResZero : ∀ (x : N) (hx : x ∈ ON), resN ⟨x, hx⟩ = 0 ↔ ‖x‖ < 1 := by
      intro x hx
      rw [IsLocalRing.residue_eq_zero_iff, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      constructor
      · intro hnot
        by_contra hge
        have hle : ‖x‖ ≤ 1 := (hMemON x).mp hx
        have heq : ‖x‖ = 1 := le_antisymm hle (le_of_not_gt hge)
        have hne : x ≠ 0 := by
          intro h0; rw [h0, norm_zero] at heq; norm_num at heq
        have hinvO : x⁻¹ ∈ ON := by
          rw [hMemON, norm_inv, heq, inv_one]
        exact hnot ⟨⟨⟨x, hx⟩, ⟨x⁻¹, hinvO⟩,
          Subtype.ext (mul_inv_cancel₀ hne), Subtype.ext (inv_mul_cancel₀ hne)⟩, rfl⟩
      · intro hlt ⟨u, hu⟩
        have hux : (↑u : ↥ON).1 = x := congrArg Subtype.val hu
        have hmul : x * (↑u⁻¹ : ↥ON).1 = 1 := by
          have h1 : ((↑u * ↑u⁻¹ : ↥ON) : N) = 1 := congrArg Subtype.val u.mul_inv
          change (↑u : ↥ON).1 * (↑u⁻¹ : ↥ON).1 = 1 at h1
          rwa [hux] at h1
        have hinv_le : ‖(↑u⁻¹ : ↥ON).1‖ ≤ 1 := (hMemON _).mp (↑u⁻¹ : ↥ON).2
        have h1_norm : (1 : ℝ) = ‖x‖ * ‖(↑u⁻¹ : ↥ON).1‖ := by
          have := congrArg norm hmul
          rw [norm_one, norm_mul] at this
          exact this.symm
        have hle_prod : ‖x‖ * ‖(↑u⁻¹ : ↥ON).1‖ ≤ ‖x‖ * 1 :=
          mul_le_mul_of_nonneg_left hinv_le (norm_nonneg x)
        linarith
    have hResEq : ∀ (x y : N) (hx : x ∈ ON) (hy : y ∈ ON),
        resN ⟨x, hx⟩ = resN ⟨y, hy⟩ ↔ ‖x - y‖ < 1 := by
      intro x y hx hy
      rw [← sub_eq_zero, ← map_sub]
      exact hResZero (x - y) (sub_mem hx hy)

    let ι_L₀ : ↥L₀ →+* ↥ON :=
      L₀.subtype.codRestrict ON.toSubring (fun z => (hMemON z.1).mpr (hL₀_norm z.1 z.2))
    let ψ₀ : ↥L₀ →+* κN := resN.comp ι_L₀
    let κ_base : Subfield κN := ψ₀.fieldRange
    let ψ₀_cod : ↥L₀ →+* ↥κ_base := ψ₀.codRestrict κ_base.toSubring (fun z => ⟨z, rfl⟩)
    let e_coeff : ↥L₀ ≃+* ↥κ_base :=
      RingEquiv.ofBijective ψ₀_cod ⟨ψ₀_cod.injective, fun ⟨_, ⟨z, rfl⟩⟩ => ⟨z, rfl⟩⟩

    have hBaseResMem : ∀ (u : K₀) (hu : algebraMap K₀ N u ∈ ON),
        resN ⟨algebraMap K₀ N u, hu⟩ ∈ κ_base := by
      intro u hu
      obtain ⟨z, hzL, hz_lt⟩ := hBaseRes₀ u ((hMemON _).mp hu)
      have h_eq : resN ⟨algebraMap K₀ N u, hu⟩ = ψ₀ ⟨z, hzL⟩ :=
        (hResEq _ _ hu ((hMemON z).mpr (hL₀_norm z hzL))).mpr hz_lt
      rw [h_eq]
      exact ⟨⟨z, hzL⟩, rfl⟩

    let κ' : Subfield κN :=
      { carrier := { y : κN | ∃ (w : N) (_ : w ∈ K'₀) (hw : w ∈ ON), resN ⟨w, hw⟩ = y }
        zero_mem' := ⟨0, K'₀.zero_mem, ON.zero_mem, map_zero resN⟩
        one_mem' := ⟨1, K'₀.one_mem, ON.one_mem, map_one resN⟩
        add_mem' := by
          rintro _ _ ⟨w₁, hw₁K, hw₁O, rfl⟩ ⟨w₂, hw₂K, hw₂O, rfl⟩
          exact ⟨w₁ + w₂, K'₀.add_mem hw₁K hw₂K, add_mem hw₁O hw₂O,
            map_add resN ⟨w₁, hw₁O⟩ ⟨w₂, hw₂O⟩⟩
        neg_mem' := by
          rintro _ ⟨w, hwK, hwO, rfl⟩
          exact ⟨-w, K'₀.neg_mem hwK, neg_mem hwO, map_neg resN ⟨w, hwO⟩⟩
        mul_mem' := by
          rintro _ _ ⟨w₁, hw₁K, hw₁O, rfl⟩ ⟨w₂, hw₂K, hw₂O, rfl⟩
          exact ⟨w₁ * w₂, K'₀.mul_mem hw₁K hw₂K, mul_mem hw₁O hw₂O,
            map_mul resN ⟨w₁, hw₁O⟩ ⟨w₂, hw₂O⟩⟩
        inv_mem' := by
          rintro y ⟨w, hwK, hwO, hy⟩
          by_cases hy0 : y = 0
          · rw [hy0, inv_zero]
            exact ⟨0, K'₀.zero_mem, ON.zero_mem, map_zero resN⟩
          · have hw_res_ne : resN ⟨w, hwO⟩ ≠ 0 := hy ▸ hy0
            have hw_not_lt : ¬ ‖w‖ < 1 := mt (hResZero w hwO).mpr hw_res_ne
            have hw_norm1 : ‖w‖ = 1 := le_antisymm ((hMemON w).mp hwO) (le_of_not_gt hw_not_lt)
            have hw_ne : w ≠ 0 := by
              intro h0; rw [h0, norm_zero] at hw_norm1; norm_num at hw_norm1
            have hwinvO : w⁻¹ ∈ ON := by
              rw [hMemON, norm_inv, hw_norm1, inv_one]
            refine ⟨w⁻¹, K'₀.inv_mem hwK, hwinvO, ?_⟩
            apply eq_inv_of_mul_eq_one_right
            rw [← hy, ← map_mul]
            have h1 : (⟨w, hwO⟩ : ↥ON) * ⟨w⁻¹, hwinvO⟩ = 1 := Subtype.ext (mul_inv_cancel₀ hw_ne)
            rw [h1, map_one] }

    have hκ_le : κ_base ≤ κ' := by
      rintro _ ⟨z, rfl⟩
      exact ⟨z.1, hL₀_le_K' z.2, (ι_L₀ z).2, rfl⟩
    letI : Algebra ↥κ_base ↥κ' := (Subfield.inclusion hκ_le).toAlgebra

    have hLI_bound : ∀ (n : ℕ) (bv : Fin n → ↥κ'), LinearIndependent ↥κ_base bv → n ≤ m₀ := by
      intro n bv hLI
      choose v hvK' hvO hv_res using fun i => (bv i).2
      let v_int : Fin n → ↥K'₀_int := fun i => ⟨v i, hvK' i⟩
      have hLI_v : LinearIndependent K₀ v_int := by
        rw [Fintype.linearIndependent_iff]
        intro u hsum0
        by_contra hnot_all
        push Not at hnot_all
        obtain ⟨j₀, hj₀⟩ := hnot_all
        let S : Finset (Fin n) := Finset.univ.filter (fun i => u i ≠ 0)
        have hS_ne : S.Nonempty := ⟨j₀, Finset.mem_filter.mpr ⟨Finset.mem_univ j₀, hj₀⟩⟩
        obtain ⟨i₀, hi₀S, hi₀_max⟩ :=
          Finset.exists_max_image S (fun i => ‖algebraMap K₀ N (u i)‖) hS_ne
        have hu_i₀ : u i₀ ≠ 0 := (Finset.mem_filter.mp hi₀S).2
        have hai₀_ne : algebraMap K₀ N (u i₀) ≠ 0 := by
          intro h0
          exact hu_i₀ ((RingHom.injective (algebraMap K₀ N)) (h0.trans (map_zero _).symm))
        have hai₀_pos : 0 < ‖algebraMap K₀ N (u i₀)‖ := norm_pos_iff.mpr hai₀_ne
        have h_all_le : ∀ i : Fin n, ‖algebraMap K₀ N (u i)‖ ≤ ‖algebraMap K₀ N (u i₀)‖ := by
          intro i
          by_cases hi : u i = 0
          · rw [hi, map_zero, norm_zero]
            exact hai₀_pos.le
          · exact hi₀_max i (Finset.mem_filter.mpr ⟨Finset.mem_univ i, hi⟩)
        let w : Fin n → K₀ := fun i => u i / u i₀
        have hwO : ∀ i : Fin n, algebraMap K₀ N (w i) ∈ ON := by
          intro i
          rw [hMemON]
          dsimp [w]
          rw [map_div₀, norm_div]
          exact div_le_one_of_le₀ (h_all_le i) hai₀_pos.le
        have hsum_N : ∑ i : Fin n, algebraMap K₀ N (u i) * v i = 0 := by
          have h1 := congrArg Subtype.val hsum0
          rw [AddSubmonoidClass.coe_finsetSum] at h1
          simpa [Algebra.smul_def] using h1
        have hsum_w : ∑ i : Fin n, algebraMap K₀ N (w i) * v i = 0 := by
          have h1 : ∑ i : Fin n, algebraMap K₀ N (w i) * v i =
              (algebraMap K₀ N (u i₀))⁻¹ * ∑ i : Fin n, algebraMap K₀ N (u i) * v i := by
            rw [Finset.mul_sum]
            refine Finset.sum_congr rfl fun i _ => ?_
            dsimp [w]
            rw [map_div₀, div_eq_inv_mul, mul_assoc]
          rw [h1, hsum_N, mul_zero]
        let w_bar : Fin n → ↥κ_base := fun i =>
          ⟨resN ⟨algebraMap K₀ N (w i), hwO i⟩, hBaseResMem (w i) (hwO i)⟩
        have hsum_res : ∑ i : Fin n, w_bar i • bv i = 0 := by
          apply Subtype.ext
          rw [AddSubmonoidClass.coe_finsetSum, Subfield.coe_zero]
          have h1 : (∑ i : Fin n, (w_bar i • bv i : ↥κ').1) =
              resN (∑ i : Fin n, ⟨algebraMap K₀ N (w i), hwO i⟩ * ⟨v i, hvO i⟩) := by
            rw [map_sum]
            refine Finset.sum_congr rfl fun i _ => ?_
            rw [map_mul, hv_res i]
            rfl
          rw [h1]
          have h2 : (∑ i : Fin n, (⟨algebraMap K₀ N (w i), hwO i⟩ : ↥ON) * ⟨v i, hvO i⟩) = 0 := by
            apply Subtype.ext
            rw [AddSubmonoidClass.coe_finsetSum]
            exact hsum_w
          rw [h2, map_zero]
        have hw_bar_zero := (Fintype.linearIndependent_iff.mp hLI) w_bar hsum_res i₀
        have hw_bar_one : w_bar i₀ = 1 := by
          apply Subtype.ext
          change resN ⟨algebraMap K₀ N (u i₀ / u i₀), hwO i₀⟩ = 1
          have h_one : (⟨algebraMap K₀ N (u i₀ / u i₀), hwO i₀⟩ : ↥ON) = 1 := by
            apply Subtype.ext
            change algebraMap K₀ N (u i₀ / u i₀) = 1
            rw [div_self hu_i₀, map_one]
          rw [h_one, map_one]
        rw [hw_bar_one] at hw_bar_zero
        exact one_ne_zero hw_bar_zero
      have hcard := hLI_v.fintype_card_le_finrank
      rwa [Fintype.card_fin] at hcard

    haveI hFin_κ' : FiniteDimensional ↥κ_base ↥κ' := by
      let I_V := Module.Basis.ofVectorSpaceIndex ↥κ_base ↥κ'
      let B_V := Module.Basis.ofVectorSpace ↥κ_base ↥κ'
      haveI : Finite ↥I_V := by
        by_contra hInf
        haveI : Infinite ↥I_V := not_finite_iff_infinite.mp hInf
        let emb : Fin (m₀ + 1) ↪ ↥I_V :=
          (Fin.valEmbedding : Fin (m₀ + 1) ↪ ℕ).trans (Infinite.natEmbedding ↥I_V)
        have hLI_sub : LinearIndependent ↥κ_base (fun i : Fin (m₀ + 1) => B_V (emb i)) :=
          B_V.linearIndependent.comp emb emb.injective
        have hle := hLI_bound (m₀ + 1) _ hLI_sub
        omega
      exact Module.Finite.of_basis B_V

    have hRank_κ_le : Module.finrank ↥κ_base ↥κ' ≤ m₀ :=
      hLI_bound (Module.finrank ↥κ_base ↥κ') (Module.finBasis ↥κ_base ↥κ')
        (Module.finBasis ↥κ_base ↥κ').linearIndependent

    let σ_O : (N ≃ₐ[K₀] N) → (↥ON →+* ↥ON) := fun σ =>
      (σ.toRingHom.comp ON.subtype).codRestrict ON.toSubring
        (fun x => (hMemON _).mpr ((hIsoGal₀ σ x.1).trans_le ((hMemON x.1).mp x.2)))
    have hσ_ker : ∀ (σ : N ≃ₐ[K₀] N),
        ∀ a ∈ IsLocalRing.maximalIdeal ↥ON, (resN.comp (σ_O σ)) a = 0 := by
      intro σ a ha
      have ha0 : resN a = 0 := (IsLocalRing.residue_eq_zero_iff a).mpr ha
      rw [RingHom.comp_apply, hResZero]
      rw [hResZero] at ha0
      exact (hIsoGal₀ σ a.1).trans_lt ha0
    let σ_res : (N ≃ₐ[K₀] N) → (κN →+* κN) := fun σ =>
      Ideal.Quotient.lift (IsLocalRing.maximalIdeal ↥ON) (resN.comp (σ_O σ)) (hσ_ker σ)
    have hσ_res_apply : ∀ (σ : N ≃ₐ[K₀] N) (x : ↥ON), σ_res σ (resN x) = resN (σ_O σ x) :=
      fun σ _ => Ideal.Quotient.lift_mk (IsLocalRing.maximalIdeal ↥ON) (resN.comp (σ_O σ)) (hσ_ker σ)
    have hσ_res_one : ∀ y : κN, σ_res 1 y = y := by
      intro y
      obtain ⟨x, rfl⟩ := IsLocalRing.residue_surjective y
      rw [hσ_res_apply]
      rfl
    have hσ_res_mul : ∀ (σ₁ σ₂ : N ≃ₐ[K₀] N) (y : κN),
        σ_res (σ₁ * σ₂) y = σ_res σ₁ (σ_res σ₂ y) := by
      intro σ₁ σ₂ y
      obtain ⟨x, rfl⟩ := IsLocalRing.residue_surjective y
      rw [hσ_res_apply, hσ_res_apply, hσ_res_apply]
      rfl
    have hσ_K' : ∀ (σ : N ≃ₐ[K₀] N), ∀ w ∈ K'₀, σ w ∈ K'₀ := by
      intro σ w hw
      change σ w ∈ K'₀_int
      rw [IntermediateField.mem_fixedField_iff]
      intro τ hτ
      have hconj : σ⁻¹ * τ * σ ∈ P₀ := hP₀_norm.conj_mem' τ hτ σ
      have hfix : (σ⁻¹ * τ * σ) w = w :=
        (IntermediateField.mem_fixedField_iff P₀ w).mp hw (σ⁻¹ * τ * σ) hconj
      have h1 : σ ((σ⁻¹ * τ * σ) w) = σ w := congrArg σ hfix
      simpa [AlgEquiv.mul_apply] using h1
    have hσ_κ' : ∀ (σ : N ≃ₐ[K₀] N), ∀ y ∈ κ', σ_res σ y ∈ κ' := by
      rintro σ _ ⟨w, hwK, hwO, rfl⟩
      exact ⟨σ w, hσ_K' σ w hwK, (σ_O σ ⟨w, hwO⟩).2, (hσ_res_apply σ ⟨w, hwO⟩).symm⟩
    have hσ_κbase : ∀ (σ : N ≃ₐ[K₀] N) (c : ↥κ_base), σ_res σ c.1 = c.1 := by
      rintro σ ⟨_, ⟨z, rfl⟩⟩
      change σ_res σ (resN (ι_L₀ z)) = resN (ι_L₀ z)
      rw [hσ_res_apply]
      congr 1
      apply Subtype.ext
      obtain ⟨u, hu⟩ := hL₀_sub z.2
      change σ z.1 = z.1
      rw [← hu]
      exact AlgEquiv.commutes σ u
    let Φ_fun : (N ≃ₐ[K₀] N) → (↥κ' ≃ₐ[↥κ_base] ↥κ') := fun σ =>
      { toFun := fun y => ⟨σ_res σ y.1, hσ_κ' σ y.1 y.2⟩
        invFun := fun y => ⟨σ_res σ⁻¹ y.1, hσ_κ' σ⁻¹ y.1 y.2⟩
        left_inv := fun y => Subtype.ext (by
          dsimp only
          rw [← hσ_res_mul, inv_mul_cancel, hσ_res_one])
        right_inv := fun y => Subtype.ext (by
          dsimp only
          rw [← hσ_res_mul, mul_inv_cancel, hσ_res_one])
        map_mul' := fun x y => Subtype.ext (map_mul (σ_res σ) x.1 y.1)
        map_add' := fun x y => Subtype.ext (map_add (σ_res σ) x.1 y.1)
        commutes' := fun c => Subtype.ext (hσ_κbase σ c) }
    let Φ : (N ≃ₐ[K₀] N) →* (↥κ' ≃ₐ[↥κ_base] ↥κ') :=
      { toFun := Φ_fun
        map_one' := AlgEquiv.ext fun y => Subtype.ext (hσ_res_one y.1)
        map_mul' := fun σ₁ σ₂ => AlgEquiv.ext fun y => Subtype.ext (hσ_res_mul σ₁ σ₂ y.1) }

    have hΦ_ker : Φ.ker = P₀ := by
      apply le_antisymm
      · intro σ hσ_ker
        have hΦ1 : Φ σ = 1 := hσ_ker
        have hK'_close : ∀ w ∈ K'₀, ‖w‖ ≤ 1 → ‖σ w - w‖ < 1 := by
          intro w hwK hw_le
          have hwO : w ∈ ON := (hMemON w).mpr hw_le
          have hy_mem : resN ⟨w, hwO⟩ ∈ κ' := ⟨w, hwK, hwO, rfl⟩
          have h_eq1 : (Φ σ ⟨resN ⟨w, hwO⟩, hy_mem⟩).1 = resN ⟨w, hwO⟩ := by
            rw [hΦ1]; rfl
          change σ_res σ (resN ⟨w, hwO⟩) = resN ⟨w, hwO⟩ at h_eq1
          rw [hσ_res_apply] at h_eq1
          exact (hResEq (σ w) w (σ_O σ ⟨w, hwO⟩).2 hwO).mp h_eq1
        rw [hP_unit]
        intro x hx_le
        let F_O : Polynomial ↥ON :=
          ∏ τ : ↥P₀, (Polynomial.X - Polynomial.C
            ⟨τ.1 x, (hMemON _).mpr ((hIsoGal₀ τ.1 x).trans_le hx_le)⟩)
        let F_x : Polynomial N := F_O.map ON.subtype
        have hFx_prod : F_x = ∏ τ : ↥P₀, (Polynomial.X - Polynomial.C (τ.1 x)) := by
          dsimp [F_x, F_O]
          rw [Polynomial.map_prod]
          refine Finset.prod_congr rfl fun τ _ => ?_
          rw [Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C]
          rfl
        have hFx_norm : ∀ j : ℕ, ‖F_x.coeff j‖ ≤ 1 := by
          intro j
          dsimp [F_x]
          rw [Polynomial.coeff_map]
          exact (hMemON _).mp (F_O.coeff j).2
        have hFx_K' : ∀ j : ℕ, F_x.coeff j ∈ K'₀ := by
          intro j
          change F_x.coeff j ∈ K'₀_int
          rw [IntermediateField.mem_fixedField_iff]
          intro τ₀ hτ₀
          let g₀ : ↥P₀ := ⟨τ₀, hτ₀⟩
          have hmap_eq : F_x.map τ₀.toRingHom = F_x := by
            rw [hFx_prod, Polynomial.map_prod]
            have h1 : (∏ τ : ↥P₀, Polynomial.map τ₀.toRingHom (Polynomial.X - Polynomial.C (τ.1 x))) =
                ∏ τ : ↥P₀, (Polynomial.X - Polynomial.C ((g₀ * τ).1 x)) := by
              refine Finset.prod_congr rfl fun τ _ => ?_
              rw [Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C]
              rfl
            rw [h1]
            exact Fintype.prod_equiv (Equiv.mulLeft g₀)
              (fun τ => Polynomial.X - Polynomial.C ((g₀ * τ).1 x))
              (fun τ => Polynomial.X - Polynomial.C (τ.1 x)) (fun _ => rfl)
          have hcoeff := congrArg (fun Q : Polynomial N => Q.coeff j) hmap_eq
          rw [Polynomial.coeff_map] at hcoeff
          exact hcoeff
        have hEval_x : Polynomial.eval x F_x = 0 := by
          rw [hFx_prod, Polynomial.eval_prod]
          refine Finset.prod_eq_zero (Finset.mem_univ (1 : ↥P₀)) ?_
          simp
        have hEval_map_σ : Polynomial.eval (σ x) (F_x.map σ.toRingHom) = 0 := by
          change Polynomial.eval (σ.toRingHom x) (F_x.map σ.toRingHom) = 0
          rw [Polynomial.eval_map_apply σ.toRingHom x, hEval_x, map_zero]
        have hEval_diff : Polynomial.eval (σ x) F_x =
            ∑ j ∈ Finset.range (F_x.natDegree + 1),
              (F_x.coeff j - σ (F_x.coeff j)) * (σ x) ^ j := by
          have h1 : Polynomial.eval (σ x) F_x =
              ∑ j ∈ Finset.range (F_x.natDegree + 1), F_x.coeff j * (σ x) ^ j :=
            Polynomial.eval_eq_sum_range (σ x)
          have hdeg_lt : (F_x.map σ.toRingHom).natDegree < F_x.natDegree + 1 :=
            Nat.lt_succ_of_le Polynomial.natDegree_map_le
          have h2 : Polynomial.eval (σ x) (F_x.map σ.toRingHom) =
              ∑ j ∈ Finset.range (F_x.natDegree + 1), σ (F_x.coeff j) * (σ x) ^ j := by
            rw [Polynomial.eval_eq_sum_range' hdeg_lt (σ x)]
            refine Finset.sum_congr rfl fun j _ => ?_
            rw [Polynomial.coeff_map]
            rfl
          calc Polynomial.eval (σ x) F_x
              = Polynomial.eval (σ x) F_x - Polynomial.eval (σ x) (F_x.map σ.toRingHom) := by
                rw [hEval_map_σ, sub_zero]
            _ = ∑ j ∈ Finset.range (F_x.natDegree + 1),
                  (F_x.coeff j - σ (F_x.coeff j)) * (σ x) ^ j := by
                rw [h1, h2, ← Finset.sum_sub_distrib]
                refine Finset.sum_congr rfl fun j _ => ?_
                ring
        have hEval_lt : ‖Polynomial.eval (σ x) F_x‖ < 1 := by
          rw [hEval_diff]
          refine hUltraSumLt1 _ _ fun j _ => ?_
          rw [norm_mul, norm_pow, hIsoGal₀ σ x, norm_sub_rev]
          have hpow_le : ‖x‖ ^ j ≤ 1 := pow_le_one₀ (norm_nonneg x) hx_le
          have hcoeff_lt : ‖σ (F_x.coeff j) - F_x.coeff j‖ < 1 :=
            hK'_close (F_x.coeff j) (hFx_K' j) (hFx_norm j)
          calc ‖σ (F_x.coeff j) - F_x.coeff j‖ * ‖x‖ ^ j
              ≤ ‖σ (F_x.coeff j) - F_x.coeff j‖ * 1 :=
                mul_le_mul_of_nonneg_left hpow_le (norm_nonneg _)
            _ = ‖σ (F_x.coeff j) - F_x.coeff j‖ := mul_one _
            _ < 1 := hcoeff_lt
        have hProd_lt : ∏ τ : ↥P₀, ‖σ x - τ.1 x‖ < 1 := by
          rw [← norm_prod]
          have h1 : Polynomial.eval (σ x) F_x = ∏ τ : ↥P₀, (σ x - τ.1 x) := by
            rw [hFx_prod, Polynomial.eval_prod]
            refine Finset.prod_congr rfl fun τ _ => ?_
            simp
          rwa [← h1]
        have hOneLeProd : ∀ (s : Finset ↥P₀),
            (∀ τ ∈ s, (1 : ℝ) ≤ ‖σ x - τ.1 x‖) → (1 : ℝ) ≤ ∏ τ ∈ s, ‖σ x - τ.1 x‖ := by
          intro s hs
          induction s using Finset.induction_on with
          | empty => simp
          | @insert a t hat ih =>
            rw [Finset.prod_insert hat]
            exact one_le_mul_of_one_le_of_one_le (hs a (Finset.mem_insert_self a t))
              (ih fun τ hτ => hs τ (Finset.mem_insert_of_mem hτ))
        have hEx_τ : ∃ τ : ↥P₀, ‖σ x - τ.1 x‖ < 1 := by
          by_contra! hge
          have h1 : (1 : ℝ) ≤ ∏ τ : ↥P₀, ‖σ x - τ.1 x‖ :=
            hOneLeProd Finset.univ fun τ _ => hge τ
          linarith
        obtain ⟨τ₁, hτ₁_lt⟩ := hEx_τ
        have hτ₁_x : ‖τ₁.1 x - x‖ < 1 := (hP_unit τ₁.1).mp τ₁.2 x hx_le
        have hsplit : σ x - x = (σ x - τ₁.1 x) + (τ₁.1 x - x) := by ring
        rw [hsplit]
        exact (IsUltrametricDist.norm_add_le_max _ _).trans_lt (max_lt hτ₁_lt hτ₁_x)
      · intro σ hσ
        rw [MonoidHom.mem_ker]
        ext ⟨_, ⟨w, hwK, hwO, rfl⟩⟩
        change σ_res σ (resN ⟨w, hwO⟩) = resN ⟨w, hwO⟩
        rw [hσ_res_apply]
        congr 1
        apply Subtype.ext
        exact (IntermediateField.mem_fixedField_iff P₀ w).mp hwK σ hσ

    have hCardQuot : Nat.card ((N ≃ₐ[K₀] N) ⧸ P₀) = m₀ := by
      have hG_card : Nat.card (N ≃ₐ[K₀] N) = Module.finrank K₀ N :=
        IsGalois.card_aut_eq_finrank K₀ N
      have hK'_card : Module.finrank ↥K'₀_int N = Nat.card ↥P₀ :=
        IntermediateField.finrank_fixedField_eq_card P₀
      have hTower := Module.finrank_mul_finrank K₀ ↥K'₀_int N
      have hLagrange := Subgroup.card_eq_card_quotient_mul_card_subgroup P₀
      have hP_pos : 0 < Nat.card ↥P₀ := Nat.card_pos
      apply Nat.eq_of_mul_eq_mul_right hP_pos
      rw [← hLagrange, hG_card, ← hTower, hK'_card]
    have hCardRange : Nat.card ↥Φ.range = m₀ := by
      let e_quot : ((N ≃ₐ[K₀] N) ⧸ Φ.ker) ≃ ↥Φ.range :=
        Equiv.ofBijective (QuotientGroup.rangeKerLift Φ)
          ⟨fun a b hab => by
              obtain ⟨g₁, rfl⟩ := Quotient.exists_rep a
              obtain ⟨g₂, rfl⟩ := Quotient.exists_rep b
              exact QuotientGroup.kerLift_injective Φ (congrArg Subtype.val hab : Φ g₁ = Φ g₂),
            fun ⟨_, ⟨g, rfl⟩⟩ => ⟨QuotientGroup.mk g, rfl⟩⟩
      have h1 : Nat.card ((N ≃ₐ[K₀] N) ⧸ Φ.ker) = Nat.card ↥Φ.range := Nat.card_congr e_quot
      rw [← h1, hΦ_ker, hCardQuot]
    let E_fix : IntermediateField ↥κ_base ↥κ' := IntermediateField.fixedField Φ.range
    haveI : FiniteDimensional ↥κ_base ↥E_fix := FiniteDimensional.left ↥κ_base ↥E_fix ↥κ'
    have hRank_Efix_κ' : Module.finrank ↥E_fix ↥κ' = m₀ :=
      (IntermediateField.finrank_fixedField_eq_card Φ.range).trans hCardRange
    have hTower_κ := Module.finrank_mul_finrank ↥κ_base ↥E_fix ↥κ'
    rw [hRank_Efix_κ'] at hTower_κ
    have hm₀_pos : 0 < m₀ := Module.finrank_pos
    have hEfix_pos : 0 < Module.finrank ↥κ_base ↥E_fix := Module.finrank_pos
    have hMul1 : Module.finrank ↥κ_base ↥E_fix * m₀ = 1 * m₀ :=
      le_antisymm ((hTower_κ.trans_le hRank_κ_le).trans_eq (one_mul m₀).symm)
        (Nat.mul_le_mul_right m₀ (Nat.succ_le_of_lt hEfix_pos))
    have hRank_Efix_one : Module.finrank ↥κ_base ↥E_fix = 1 :=
      Nat.eq_of_mul_eq_mul_right hm₀_pos hMul1
    have hRank_κ_eq : Module.finrank ↥κ_base ↥κ' = m₀ :=
      (hTower_κ.symm.trans (congrArg (· * m₀) hRank_Efix_one)).trans (one_mul m₀)
    have hFixTop_bot :
        IntermediateField.fixedField (⊤ : Subgroup (↥κ' ≃ₐ[↥κ_base] ↥κ')) = ⊥ := by
      let F_top : IntermediateField ↥κ_base ↥κ' :=
        IntermediateField.fixedField (⊤ : Subgroup (↥κ' ≃ₐ[↥κ_base] ↥κ'))
      have hle_E : F_top.toSubmodule ≤ E_fix.toSubmodule :=
        IntermediateField.fixedField_antitone le_top
      have hbot_le_int : (⊥ : IntermediateField ↥κ_base ↥κ') ≤ F_top := bot_le
      have hbot_le : (⊥ : IntermediateField ↥κ_base ↥κ').toSubmodule ≤ F_top.toSubmodule :=
        hbot_le_int
      haveI : FiniteDimensional ↥κ_base ↥F_top.toSubmodule :=
        FiniteDimensional.left ↥κ_base ↥F_top ↥κ'
      have hsub_eq : (⊥ : IntermediateField ↥κ_base ↥κ').toSubmodule = F_top.toSubmodule := by
        apply Submodule.eq_of_le_of_finrank_eq hbot_le
        have hle1 : Module.finrank ↥κ_base ↥F_top.toSubmodule ≤
            Module.finrank ↥κ_base ↥E_fix.toSubmodule :=
          Submodule.finrank_mono hle_E
        have hge1 : Module.finrank ↥κ_base ↥(⊥ : IntermediateField ↥κ_base ↥κ').toSubmodule ≤
            Module.finrank ↥κ_base ↥F_top.toSubmodule :=
          Submodule.finrank_mono hbot_le
        have hle_one : Module.finrank ↥κ_base ↥F_top.toSubmodule ≤ 1 :=
          hle1.trans_eq hRank_Efix_one
        have hge_one : 1 ≤ Module.finrank ↥κ_base ↥F_top.toSubmodule :=
          (IntermediateField.finrank_bot (F := ↥κ_base) (E := ↥κ')).symm.trans_le hge1
        exact (IntermediateField.finrank_bot (F := ↥κ_base) (E := ↥κ')).trans
          (le_antisymm hle_one hge_one).symm
      ext x
      exact SetLike.ext_iff.mp hsub_eq.symm x
    haveI hGal_κ' : IsGalois ↥κ_base ↥κ' := IsGalois.of_fixedField_eq_bot ↥κ_base ↥κ' hFixTop_bot
    haveI hSep_κ' : Algebra.IsSeparable ↥κ_base ↥κ' := IsGalois.to_isSeparable

    obtain ⟨α_bar, hα_top⟩ := Field.exists_primitive_element ↥κ_base ↥κ'
    have hInt_α : IsIntegral ↥κ_base α_bar := Algebra.IsIntegral.isIntegral α_bar
    let f_bar : Polynomial ↥κ_base := minpoly ↥κ_base α_bar
    have hf_bar_monic : f_bar.Monic := minpoly.monic hInt_α
    have hf_bar_irr : Irreducible f_bar := minpoly.irreducible hInt_α
    have hf_bar_sep : f_bar.Separable := Algebra.IsSeparable.isSeparable ↥κ_base α_bar
    have hf_bar_deg : f_bar.natDegree = m₀ := by
      have h1 := IntermediateField.adjoin.finrank hInt_α
      have h2 : Module.finrank ↥κ_base ↥(IntermediateField.adjoin ↥κ_base ({α_bar} : Set ↥κ')) =
          Module.finrank ↥κ_base ↥κ' :=
        LinearEquiv.finrank_eq
          ((IntermediateField.equivOfEq hα_top).trans IntermediateField.topEquiv).toLinearEquiv
      exact h1.symm.trans (h2.trans hRank_κ_eq)
    have hf_bar_aeval0 : Polynomial.aeval α_bar f_bar = 0 := minpoly.aeval ↥κ_base α_bar
    have hf_bar_deriv_ne : Polynomial.aeval α_bar (Polynomial.derivative f_bar) ≠ 0 := by
      obtain ⟨A, B, hBez⟩ := hf_bar_sep
      intro h0
      have h1 := congrArg (Polynomial.aeval α_bar) hBez
      simp only [map_add, map_mul, map_one, hf_bar_aeval0, h0, mul_zero, add_zero] at h1
      exact zero_ne_one h1

    let f₀ : Polynomial ↥L₀ := f_bar.map e_coeff.symm.toRingHom
    have hf₀_eq_equiv : f₀ = Polynomial.mapEquiv e_coeff.symm f_bar := rfl
    have hf₀_monic : f₀.Monic := hf_bar_monic.map e_coeff.symm.toRingHom
    have hf₀_irr : Irreducible f₀ := by
      rw [hf₀_eq_equiv]
      exact (MulEquiv.irreducible_iff (Polynomial.mapEquiv e_coeff.symm).toMulEquiv).mpr hf_bar_irr
    have hf₀_sep : f₀.Separable := hf_bar_sep.map
    have hf₀_deg : f₀.natDegree = m₀ := (hf_bar_monic.natDegree_map _).trans hf_bar_deg

    obtain ⟨y₀, hy₀K', hy₀O, hy₀_res⟩ := α_bar.2
    have hy₀_norm : ‖y₀‖ ≤ 1 := (hMemON y₀).mp hy₀O
    let f_ON : Polynomial ↥ON := f₀.map ι_L₀
    have hmap_N : f₀.map L₀.subtype = f_ON.map ON.subtype :=
      (Polynomial.map_map ι_L₀ ON.subtype f₀).symm
    have hmap_res : f_ON.map resN = f_bar.map κ_base.subtype := by
      dsimp only [f_ON, f₀]
      rw [Polynomial.map_map, Polynomial.map_map]
      congr 1
      ext c
      change ψ₀ (e_coeff.symm c) = c.1
      exact congrArg Subtype.val (e_coeff.apply_symm_apply c)

    have haeval_to_κN : ∀ Q : Polynomial ↥κ_base,
        (Polynomial.aeval α_bar Q : ↥κ').1 = Polynomial.eval α_bar.1 (Q.map κ_base.subtype) := by
      intro Q
      rw [Polynomial.aeval_def, Polynomial.eval_map]
      exact Polynomial.hom_eval₂ Q (Subfield.inclusion hκ_le) κ'.subtype α_bar

    have hf₀_eval_lt : ‖Polynomial.eval y₀ (f₀.map L₀.subtype)‖ < 1 := by
      have hval : Polynomial.eval y₀ (f₀.map L₀.subtype) = (Polynomial.eval ⟨y₀, hy₀O⟩ f_ON).1 := by
        rw [hmap_N]
        exact Polynomial.eval_map_apply ON.subtype ⟨y₀, hy₀O⟩
      rw [hval, ← hResZero _ (Polynomial.eval ⟨y₀, hy₀O⟩ f_ON).2]
      change resN (Polynomial.eval ⟨y₀, hy₀O⟩ f_ON) = 0
      rw [← Polynomial.eval_map_apply resN ⟨y₀, hy₀O⟩, hy₀_res, hmap_res, ← haeval_to_κN,
        hf_bar_aeval0, Subfield.coe_zero]

    have hf₀_deriv_eq : ‖Polynomial.eval y₀ (Polynomial.derivative (f₀.map L₀.subtype))‖ = 1 := by
      have hval : Polynomial.eval y₀ (Polynomial.derivative (f₀.map L₀.subtype)) =
          (Polynomial.eval ⟨y₀, hy₀O⟩ (Polynomial.derivative f_ON)).1 := by
        rw [hmap_N, Polynomial.derivative_map]
        exact Polynomial.eval_map_apply ON.subtype ⟨y₀, hy₀O⟩
      rw [hval]
      let d_ON : ↥ON := Polynomial.eval ⟨y₀, hy₀O⟩ (Polynomial.derivative f_ON)
      have hd_le : ‖d_ON.1‖ ≤ 1 := (hMemON d_ON.1).mp d_ON.2
      have hd_res_ne : resN d_ON ≠ 0 := by
        dsimp only [d_ON]
        rw [← Polynomial.eval_map_apply resN ⟨y₀, hy₀O⟩, ← Polynomial.derivative_map,
          hy₀_res, hmap_res, Polynomial.derivative_map, ← haeval_to_κN]
        exact fun h0 => hf_bar_deriv_ne (Subtype.ext h0)
      have hd_not_lt : ¬ ‖d_ON.1‖ < 1 := mt (hResZero d_ON.1 d_ON.2).mpr hd_res_ne
      exact le_antisymm hd_le (le_of_not_gt hd_not_lt)

    refine ⟨hN_val, hClK', y₀, f₀, hy₀K', hy₀_norm, hf₀_monic, hf₀_irr, hf₀_sep, hf₀_deg,
      hf₀_eval_lt, hf₀_deriv_eq, ?_⟩
    intro θ' hθ'_dist a j
    by_cases haj : a j = 0
    · rw [haj, Subfield.coe_zero, norm_zero]
      exact norm_nonneg _
    · have haj_le : ‖(a j : N)‖ ≤ 1 := hL₀_norm (a j).1 (a j).2
      refine haj_le.trans ?_
      by_contra! hsum_lt
      have hθ'_le : ‖θ'‖ ≤ 1 := by
        have hsplit : θ' = (θ' - y₀) + y₀ := by ring
        rw [hsplit]
        exact (IsUltrametricDist.norm_add_le_max _ _).trans (max_le hθ'_dist.le hy₀_norm)
      have hθ'O : θ' ∈ ON := (hMemON θ').mpr hθ'_le
      have hθ'_res : resN ⟨θ', hθ'O⟩ = α_bar.1 :=
        ((hResEq θ' y₀ hθ'O hy₀O).mpr hθ'_dist).trans hy₀_res
      let s_O : ↥ON := ∑ i : Fin m₀, ι_L₀ (a i) * ⟨θ', hθ'O⟩ ^ (i : ℕ)
      have hs_val : s_O.1 = ∑ i : Fin m₀, (a i : N) * θ' ^ (i : ℕ) := by
        dsimp only [s_O]
        rw [AddSubmonoidClass.coe_finsetSum]
        rfl
      have hs_res0 : resN s_O = 0 := (hResZero s_O.1 s_O.2).mpr (hs_val ▸ hsum_lt)
      let g_bar : Polynomial ↥κ_base :=
        ∑ i : Fin m₀, Polynomial.C (e_coeff (a i)) * Polynomial.X ^ (i : ℕ)
      have hg_coeff_j : g_bar.coeff (j : ℕ) = e_coeff (a j) := by
        dsimp only [g_bar]
        rw [Polynomial.finsetSum_coeff]
        simp_rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, mul_ite, mul_one, mul_zero]
        rw [Finset.sum_eq_single j]
        · simp
        · intro i _ hij
          exact ite_eq_right_iff.mpr fun h => False.elim (hij (Fin.ext h.symm))
        · intro hj_not
          exact False.elim (hj_not (Finset.mem_univ j))
      have hg_ne : g_bar ≠ 0 := by
        intro hg0
        rw [hg0, Polynomial.coeff_zero] at hg_coeff_j
        exact haj (e_coeff.injective (hg_coeff_j.symm.trans (map_zero e_coeff).symm))
      have hg_deg_lt : g_bar.natDegree < m₀ :=
        (Polynomial.natDegree_lt_iff_degree_lt hg_ne).mpr (Polynomial.degree_sum_fin_lt _)
      have hg_aeval0 : Polynomial.aeval α_bar g_bar = 0 := by
        apply Subtype.ext
        rw [Subfield.coe_zero, haeval_to_κN]
        dsimp only [g_bar]
        rw [Polynomial.map_sum, Polynomial.eval_finsetSum]
        have h1 : (∑ i : Fin m₀, Polynomial.eval α_bar.1
            (Polynomial.map κ_base.subtype (Polynomial.C (e_coeff (a i)) * Polynomial.X ^ (i : ℕ)))) =
            resN s_O := by
          dsimp only [s_O]
          rw [map_sum]
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [Polynomial.map_mul, Polynomial.map_C, Polynomial.map_pow, Polynomial.map_X,
            Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_pow, Polynomial.eval_X,
            map_mul, map_pow, hθ'_res]
          rfl
        rw [h1, hs_res0]
      have hdvd : f_bar ∣ g_bar := minpoly.dvd ↥κ_base α_bar hg_aeval0
      have hdeg_le : f_bar.natDegree ≤ g_bar.natDegree := Polynomial.natDegree_le_of_dvd hdvd hg_ne
      omega

  
  have hS2 : ∀ (K'₀ : Subfield N) (_hCl : IsClosed (K'₀ : Set N)) (f : Polynomial N)
      (_hf_mem : ∀ i : ℕ, f.coeff i ∈ K'₀) (_hf_norm : ∀ i : ℕ, ‖f.coeff i‖ ≤ 1)
      (y₀ : N) (_hy₀_mem : y₀ ∈ K'₀) (_hy₀_norm : ‖y₀‖ ≤ 1)
      (_hf_lt : ‖Polynomial.eval y₀ f‖ < 1)
      (_hderiv_eq : ‖Polynomial.eval y₀ (Polynomial.derivative f)‖ = 1),
      ∃ θ' : N, θ' ∈ K'₀ ∧ ‖θ'‖ ≤ 1 ∧ ‖θ' - y₀‖ < 1 ∧ Polynomial.eval θ' f = 0 := by
    intro K'₀ hCl f hf_mem hf_norm y₀ hy₀_mem hy₀_norm hf_lt hderiv_eq
    by_cases h0 : Polynomial.eval y₀ f = 0
    · exact ⟨y₀, hy₀_mem, hy₀_norm, by simp, h0⟩
    · let r₀ : ℝ := ‖Polynomial.eval y₀ f‖
      have hr₀_pos : 0 < r₀ := norm_pos_iff.mpr h0
      have hr₀_lt : r₀ < 1 := hf_lt

      have hNatNorm : ∀ m : ℕ, ‖(m : N)‖ ≤ 1 := by
        intro m
        induction m with
        | zero => simp
        | succ m ih =>
          push_cast
          exact (IsUltrametricDist.norm_add_le_max _ _).trans (max_le ih norm_one.le)

      have hUltraSumLe : ∀ (s : Finset ℕ) (g : ℕ → N) (B : ℝ),
          0 ≤ B → (∀ i ∈ s, ‖g i‖ ≤ B) → ‖∑ i ∈ s, g i‖ ≤ B := by
        intro s g B hB hg
        induction s using Finset.induction_on with
        | empty => simpa using hB
        | @insert a t hat ih =>
          rw [Finset.sum_insert hat]
          refine (IsUltrametricDist.norm_add_le_max _ _).trans (max_le ?_ ?_)
          · exact hg a (Finset.mem_insert_self a t)
          · exact ih (fun i hi => hg i (Finset.mem_insert_of_mem hi))

      have hPowLip : ∀ (k : ℕ) (y h : N), ‖y‖ ≤ 1 → ‖h‖ ≤ 1 → ‖(y + h) ^ k - y ^ k‖ ≤ ‖h‖ := by
        intro k y h hy hh
        have hyh : ‖y + h‖ ≤ 1 :=
          (IsUltrametricDist.norm_add_le_max y h).trans (max_le hy hh)
        induction k with
        | zero => simp
        | succ k ih =>
          have h_id : (y + h) ^ (k + 1) - y ^ (k + 1) =
              ((y + h) ^ k - y ^ k) * (y + h) + y ^ k * h := by ring
          rw [h_id]
          refine (IsUltrametricDist.norm_add_le_max _ _).trans (max_le ?_ ?_)
          · rw [norm_mul]
            calc ‖(y + h) ^ k - y ^ k‖ * ‖y + h‖
                ≤ ‖h‖ * 1 := mul_le_mul ih hyh (norm_nonneg _) (norm_nonneg h)
              _ = ‖h‖ := mul_one _
          · rw [norm_mul, norm_pow]
            calc ‖y‖ ^ k * ‖h‖
                ≤ 1 * ‖h‖ := mul_le_mul_of_nonneg_right (pow_le_one₀ (norm_nonneg y) hy) (norm_nonneg h)
              _ = ‖h‖ := one_mul _

      let Rk : ℕ → N → N → N := fun k y h => (y + h) ^ k - y ^ k - (k : N) * y ^ (k - 1) * h
      have hRk_bound : ∀ (k : ℕ) (y h : N), ‖y‖ ≤ 1 → ‖h‖ ≤ 1 → ‖Rk k y h‖ ≤ ‖h‖ ^ 2 := by
        intro k y h hy hh
        have hyh : ‖y + h‖ ≤ 1 :=
          (IsUltrametricDist.norm_add_le_max y h).trans (max_le hy hh)
        induction k using Nat.strong_induction_on with
        | h k ih =>
          rcases k with _ | _ | m
          · dsimp [Rk]; simp
          · dsimp [Rk]; simp
          · have h_rec : Rk (m + 2) y h =
                Rk (m + 1) y h * (y + h) + ((m + 1 : ℕ) : N) * y ^ m * h ^ 2 := by
              dsimp only [Rk]
              have hs1 : m + 2 - 1 = m + 1 := rfl
              have hs2 : m + 1 - 1 = m := rfl
              rw [hs1, hs2]
              push_cast
              ring
            rw [h_rec]
            refine (IsUltrametricDist.norm_add_le_max _ _).trans (max_le ?_ ?_)
            · rw [norm_mul]
              have h_ih := ih (m + 1) (Nat.lt_succ_self (m + 1))
              calc ‖Rk (m + 1) y h‖ * ‖y + h‖
                  ≤ ‖h‖ ^ 2 * 1 := mul_le_mul h_ih hyh (norm_nonneg _) (sq_nonneg _)
                _ = ‖h‖ ^ 2 := mul_one _
            · rw [norm_mul, norm_mul, norm_pow, norm_pow]
              have h1 : ‖((m + 1 : ℕ) : N)‖ * ‖y‖ ^ m ≤ 1 := by
                calc ‖((m + 1 : ℕ) : N)‖ * ‖y‖ ^ m
                    ≤ 1 * 1 := mul_le_mul (hNatNorm (m + 1)) (pow_le_one₀ (norm_nonneg y) hy)
                      (pow_nonneg (norm_nonneg y) m) zero_le_one
                  _ = 1 := one_mul 1
              calc ‖((m + 1 : ℕ) : N)‖ * ‖y‖ ^ m * ‖h‖ ^ 2
                  ≤ 1 * ‖h‖ ^ 2 := mul_le_mul_of_nonneg_right h1 (sq_nonneg _)
                _ = ‖h‖ ^ 2 := one_mul _

      have hTaylorQuad : ∀ (y h : N), ‖y‖ ≤ 1 → ‖h‖ ≤ 1 →
          ‖Polynomial.eval (y + h) f - Polynomial.eval y f -
            Polynomial.eval y (Polynomial.derivative f) * h‖ ≤ ‖h‖ ^ 2 := by
        intro y h hy hh
        have hderiv_sum : Polynomial.eval y (Polynomial.derivative f) =
            ∑ k ∈ Finset.range (f.natDegree + 1), f.coeff k * ((k : N) * y ^ (k - 1)) := by
          conv_lhs => rw [Polynomial.as_sum_range_C_mul_X_pow f]
          rw [map_sum, Polynomial.eval_finsetSum]
          refine Finset.sum_congr rfl fun k _ => ?_
          rw [Polynomial.derivative_C_mul_X_pow, Polynomial.eval_mul, Polynomial.eval_C,
            Polynomial.eval_pow, Polynomial.eval_X]
          ring
        have h_id : Polynomial.eval (y + h) f - Polynomial.eval y f -
            Polynomial.eval y (Polynomial.derivative f) * h =
            ∑ k ∈ Finset.range (f.natDegree + 1), f.coeff k * Rk k y h := by
          rw [Polynomial.eval_eq_sum_range (y + h), Polynomial.eval_eq_sum_range y,
            hderiv_sum, Finset.sum_mul, ← Finset.sum_sub_distrib, ← Finset.sum_sub_distrib]
          refine Finset.sum_congr rfl fun k _ => ?_
          dsimp [Rk]
          ring
        rw [h_id]
        refine hUltraSumLe _ _ (‖h‖ ^ 2) (sq_nonneg _) fun k _ => ?_
        rw [norm_mul]
        calc ‖f.coeff k‖ * ‖Rk k y h‖
            ≤ 1 * ‖h‖ ^ 2 := mul_le_mul (hf_norm k) (hRk_bound k y h hy hh)
              (norm_nonneg _) zero_le_one
          _ = ‖h‖ ^ 2 := one_mul _

      have hDerivLip : ∀ y : N, ‖y‖ ≤ 1 →
          ‖Polynomial.eval y (Polynomial.derivative f) -
            Polynomial.eval y₀ (Polynomial.derivative f)‖ ≤ ‖y - y₀‖ := by
        intro y hy
        let g : Polynomial N := Polynomial.derivative f
        have hg_norm : ∀ k : ℕ, ‖g.coeff k‖ ≤ 1 := by
          intro k
          dsimp [g]
          rw [Polynomial.coeff_derivative, norm_mul]
          have hcast : ((k : N) + 1) = ((k + 1 : ℕ) : N) := by push_cast; rfl
          rw [hcast]
          calc ‖f.coeff (k + 1)‖ * ‖((k + 1 : ℕ) : N)‖
              ≤ 1 * 1 := mul_le_mul (hf_norm (k + 1)) (hNatNorm (k + 1)) (norm_nonneg _) zero_le_one
            _ = 1 := one_mul 1
        let δ : N := y - y₀
        have hδ_le : ‖δ‖ ≤ 1 := by
          dsimp [δ]
          rw [sub_eq_add_neg]
          refine (IsUltrametricDist.norm_add_le_max y (-y₀)).trans (max_le hy ?_)
          rwa [norm_neg]
        have hy_eq : y = y₀ + δ := by dsimp [δ]; ring
        have h_id : Polynomial.eval y g - Polynomial.eval y₀ g =
            ∑ k ∈ Finset.range (g.natDegree + 1), g.coeff k * ((y₀ + δ) ^ k - y₀ ^ k) := by
          conv_lhs => rw [hy_eq]
          rw [Polynomial.eval_eq_sum_range (y₀ + δ), Polynomial.eval_eq_sum_range y₀,
            ← Finset.sum_sub_distrib]
          refine Finset.sum_congr rfl fun k _ => ?_
          ring
        rw [h_id]
        refine hUltraSumLe _ _ ‖δ‖ (norm_nonneg δ) fun k _ => ?_
        rw [norm_mul]
        calc ‖g.coeff k‖ * ‖(y₀ + δ) ^ k - y₀ ^ k‖
            ≤ 1 * ‖δ‖ := mul_le_mul (hg_norm k) (hPowLip k y₀ δ hy₀_norm hδ_le)
              (norm_nonneg _) zero_le_one
          _ = ‖δ‖ := one_mul _

      have hEvalMem : ∀ (P : Polynomial N),
          (∀ k : ℕ, P.coeff k ∈ K'₀) → ∀ z ∈ K'₀, Polynomial.eval z P ∈ K'₀ := by
        intro P hP z hz
        rw [Polynomial.eval_eq_sum_range]
        exact K'₀.sum_mem fun k _ => K'₀.mul_mem (hP k) (K'₀.pow_mem hz k)

      let D₀ : N := Polynomial.eval y₀ (Polynomial.derivative f)
      have hD₀_mem : D₀ ∈ K'₀ := by
        refine hEvalMem (Polynomial.derivative f) (fun k => ?_) y₀ hy₀_mem
        rw [Polynomial.coeff_derivative]
        exact K'₀.mul_mem (hf_mem (k + 1)) (K'₀.add_mem (natCast_mem K'₀ k) K'₀.one_mem)
      have hD₀_ne : D₀ ≠ 0 := by
        intro hD0
        have h1 : ‖D₀‖ = 1 := hderiv_eq
        rw [hD0, norm_zero] at h1
        norm_num at h1
      have hD₀_inv_mem : D₀⁻¹ ∈ K'₀ := K'₀.inv_mem hD₀_mem
      have hD₀_inv_norm : ‖D₀⁻¹‖ = 1 := by rw [norm_inv, hderiv_eq, inv_one]

      let y : ℕ → N := fun n => Nat.recOn n y₀ (fun _ yn => yn - D₀⁻¹ * Polynomial.eval yn f)
      have hy_zero : y 0 = y₀ := rfl
      have hy_succ : ∀ n : ℕ, y (n + 1) = y n - D₀⁻¹ * Polynomial.eval (y n) f := fun _ => rfl

      have h_iter : ∀ n : ℕ,
          y n ∈ K'₀ ∧ ‖y n‖ ≤ 1 ∧ ‖y n - y₀‖ ≤ r₀ ∧ ‖Polynomial.eval (y n) f‖ ≤ r₀ ^ (n + 1) := by
        intro n
        induction n with
        | zero =>
          rw [hy_zero, sub_self, norm_zero, pow_one]
          exact ⟨hy₀_mem, hy₀_norm, hr₀_pos.le, le_rfl⟩
        | succ n ih =>
          obtain ⟨hyn_mem, hyn_norm, hyn_dist, hyn_eval⟩ := ih
          let hn : N := -(D₀⁻¹ * Polynomial.eval (y n) f)
          have hyn1_eq : y (n + 1) = y n + hn := by
            rw [hy_succ]; dsimp [hn]; ring
          have hhn_mem : hn ∈ K'₀ :=
            K'₀.neg_mem (K'₀.mul_mem hD₀_inv_mem (hEvalMem f hf_mem (y n) hyn_mem))
          have hyn1_mem : y (n + 1) ∈ K'₀ := hyn1_eq ▸ K'₀.add_mem hyn_mem hhn_mem
          have hhn_norm : ‖hn‖ ≤ r₀ ^ (n + 1) := by
            dsimp [hn]
            rw [norm_neg, norm_mul, hD₀_inv_norm, one_mul]
            exact hyn_eval
          have hpow_le_r₀ : r₀ ^ (n + 1) ≤ r₀ := by
            simpa using pow_le_pow_of_le_one hr₀_pos.le hr₀_lt.le (Nat.succ_pos n)
          have hhn_le_r₀ : ‖hn‖ ≤ r₀ := hhn_norm.trans hpow_le_r₀
          have hhn_le_one : ‖hn‖ ≤ 1 := hhn_le_r₀.trans hr₀_lt.le
          have hyn1_norm : ‖y (n + 1)‖ ≤ 1 := by
            rw [hyn1_eq]
            exact (IsUltrametricDist.norm_add_le_max _ _).trans (max_le hyn_norm hhn_le_one)
          have hyn1_dist : ‖y (n + 1) - y₀‖ ≤ r₀ := by
            have hsplit : y (n + 1) - y₀ = (y n - y₀) + hn := by rw [hyn1_eq]; ring
            rw [hsplit]
            exact (IsUltrametricDist.norm_add_le_max _ _).trans (max_le hyn_dist hhn_le_r₀)
          have hcancel : Polynomial.eval (y n) f + D₀ * hn = 0 := by
            dsimp [hn]
            rw [mul_neg, mul_inv_cancel_left₀ hD₀_ne, add_neg_cancel]
          have heval_split : Polynomial.eval (y (n + 1)) f =
              (Polynomial.eval (y n + hn) f - Polynomial.eval (y n) f -
                Polynomial.eval (y n) (Polynomial.derivative f) * hn) +
              (Polynomial.eval (y n) (Polynomial.derivative f) - D₀) * hn := by
            rw [hyn1_eq]
            calc Polynomial.eval (y n + hn) f
                = (Polynomial.eval (y n + hn) f - Polynomial.eval (y n) f -
                    Polynomial.eval (y n) (Polynomial.derivative f) * hn) +
                  (Polynomial.eval (y n) (Polynomial.derivative f) - D₀) * hn +
                  (Polynomial.eval (y n) f + D₀ * hn) := by ring
              _ = _ := by rw [hcancel, add_zero]
          have heval_bound : ‖Polynomial.eval (y (n + 1)) f‖ ≤ r₀ ^ (n + 2) := by
            rw [heval_split]
            refine (IsUltrametricDist.norm_add_le_max _ _).trans (max_le ?_ ?_)
            · have h1 := hTaylorQuad (y n) hn hyn_norm hhn_le_one
              have h2 : ‖hn‖ ^ 2 ≤ (r₀ ^ (n + 1)) ^ 2 :=
                pow_le_pow_left₀ (norm_nonneg hn) hhn_norm 2
              have h3 : (r₀ ^ (n + 1)) ^ 2 = r₀ ^ (2 * n + 2) := by ring
              have h4 : r₀ ^ (2 * n + 2) ≤ r₀ ^ (n + 2) :=
                pow_le_pow_of_le_one hr₀_pos.le hr₀_lt.le (by omega)
              exact h1.trans (h2.trans (h3.trans_le h4))
            · rw [norm_mul]
              have h1 := hDerivLip (y n) hyn_norm
              calc ‖Polynomial.eval (y n) (Polynomial.derivative f) - D₀‖ * ‖hn‖
                  ≤ r₀ * r₀ ^ (n + 1) :=
                    mul_le_mul (h1.trans hyn_dist) hhn_norm (norm_nonneg _) hr₀_pos.le
                _ = r₀ ^ (n + 2) := (pow_succ' r₀ (n + 1)).symm
          exact ⟨hyn1_mem, hyn1_norm, hyn1_dist, heval_bound⟩

      have hCauchy : CauchySeq y := by
        refine SeminormedAddCommGroup.cauchySeq_of_le_geometric (C := r₀) (r := r₀) hr₀_lt fun n => ?_
        have hstep : y n - y (n + 1) = D₀⁻¹ * Polynomial.eval (y n) f := by
          rw [hy_succ]; ring
        rw [hstep, norm_mul, hD₀_inv_norm, one_mul, ← pow_succ']
        exact (h_iter n).2.2.2

      obtain ⟨θ', hy_lim⟩ := cauchySeq_tendsto_of_complete hCauchy
      have hθ'_mem : θ' ∈ K'₀ :=
        hCl.mem_of_tendsto hy_lim (Filter.Eventually.of_forall fun n => (h_iter n).1)
      have hCl_ball1 : IsClosed {z : N | ‖z‖ ≤ 1} := isClosed_le continuous_norm continuous_const
      have hθ'_norm : ‖θ'‖ ≤ 1 :=
        hCl_ball1.mem_of_tendsto hy_lim (Filter.Eventually.of_forall fun n => (h_iter n).2.1)
      have hCl_ballr : IsClosed {z : N | ‖z - y₀‖ ≤ r₀} :=
        isClosed_le (continuous_norm.comp (continuous_id.sub continuous_const)) continuous_const
      have hθ'_dist_le : ‖θ' - y₀‖ ≤ r₀ :=
        hCl_ballr.mem_of_tendsto hy_lim (Filter.Eventually.of_forall fun n => (h_iter n).2.2.1)
      have hθ'_dist : ‖θ' - y₀‖ < 1 := hθ'_dist_le.trans_lt hr₀_lt

      have h_eval_lim1 : Filter.Tendsto (fun n => ‖Polynomial.eval (y n) f‖)
          Filter.atTop (nhds ‖Polynomial.eval θ' f‖) :=
        (continuous_norm.comp f.continuous).continuousAt.tendsto.comp hy_lim
      have h_pow_lim : Filter.Tendsto (fun n => r₀ ^ (n + 1)) Filter.atTop (nhds 0) :=
        (tendsto_pow_atTop_nhds_zero_of_lt_one hr₀_pos.le hr₀_lt).comp (Filter.tendsto_add_atTop_nat 1)
      have h_eval_lim0 : Filter.Tendsto (fun n => ‖Polynomial.eval (y n) f‖)
          Filter.atTop (nhds 0) :=
        tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds h_pow_lim
          (fun n => norm_nonneg _) (fun n => (h_iter n).2.2.2)
      have h_norm0 : ‖Polynomial.eval θ' f‖ = 0 := tendsto_nhds_unique h_eval_lim1 h_eval_lim0
      exact ⟨θ', hθ'_mem, hθ'_norm, hθ'_dist, norm_eq_zero.mp h_norm0⟩

  
  have hS3 : ∀ (K₀ : Type u) [Field K₀] [Algebra K₀ N]
      (L₀ : Subfield N)
      (_hL₀_sub : (L₀ : Set N) ⊆ Set.range (algebraMap K₀ N))
      (_hL₀_norm : ∀ z ∈ L₀, ‖z‖ ≤ 1)
      (_hBaseRes₀ : ∀ u : K₀, ‖algebraMap K₀ N u‖ ≤ 1 → ∃ z ∈ L₀, ‖algebraMap K₀ N u - z‖ < 1)
      (K'₀_int : IntermediateField K₀ N) [FiniteDimensional K₀ ↥K'₀_int]
      (m₀ : ℕ) (_hm₀ : Module.finrank K₀ ↥K'₀_int = m₀)
      (θ' : N) (_hθ'_mem : θ' ∈ K'₀_int) (_hθ'_norm : ‖θ'‖ ≤ 1)
      (f₀ : Polynomial ↥L₀) (_hf₀_monic : f₀.Monic) (_hf₀_deg : f₀.natDegree = m₀)
      (_hθ'_root : Polynomial.eval θ' (f₀.map L₀.subtype) = 0)
      (_hOrthoL₀ : ∀ (a : Fin m₀ → ↥L₀) (j : Fin m₀),
        ‖(a j : N)‖ ≤ ‖∑ i : Fin m₀, (a i : N) * (θ') ^ (i : ℕ)‖)
      (F₀_sub : IntermediateField K₀ N) [FiniteDimensional K₀ ↥F₀_sub]
      (_hResSub₀ : ∀ w ∈ F₀_sub, ‖w‖ ≤ 1 →
        ∃ u : K₀, ‖algebraMap K₀ N u‖ ≤ 1 ∧ ‖w - algebraMap K₀ N u‖ < 1),
      let L₀_top : IntermediateField K₀ N := K'₀_int ⊔ F₀_sub
      (∀ u ∈ K'₀_int, ∃ a : Fin m₀ → K₀,
        u = ∑ i : Fin m₀, algebraMap K₀ N (a i) * (θ') ^ (i : ℕ)) ∧
      (∀ w ∈ K'₀_int, ‖w‖ ≤ 1 → ∃ a : Fin m₀ → ↥L₀,
        ‖w - ∑ i : Fin m₀, (a i : N) * (θ') ^ (i : ℕ)‖ < 1) ∧
      Module.finrank K₀ ↥L₀_top = Module.finrank K₀ ↥F₀_sub * m₀ ∧
      (∀ w ∈ L₀_top, ‖w‖ ≤ 1 → ∃ u ∈ K'₀_int, ‖u‖ ≤ 1 ∧ ‖w - u‖ < 1) := by
    intro K₀ _ _ L₀ hL₀_sub hL₀_norm hBaseRes₀ K'₀_int _ m₀ hm₀ θ' hθ'_mem hθ'_norm
      f₀ hf₀_monic hf₀_deg hθ'_root hOrthoL₀ F₀_sub _ hResSub₀
    classical
    dsimp only
    let L₀_top : IntermediateField K₀ N := K'₀_int ⊔ F₀_sub
    have hm₀_pos : 0 < m₀ := hm₀ ▸ Module.finrank_pos
    haveI : Nonempty (Fin m₀) := ⟨⟨0, hm₀_pos⟩⟩

    have hUltraSumLe1 : ∀ {n : ℕ} (s : Finset (Fin n)) (g : Fin n → N),
        (∀ i ∈ s, ‖g i‖ ≤ 1) → ‖∑ i ∈ s, g i‖ ≤ 1 := by
      intro n s g hg
      induction s using Finset.induction_on with
      | empty => simp
      | @insert a t hat ih =>
        rw [Finset.sum_insert hat]
        refine (IsUltrametricDist.norm_add_le_max _ _).trans (max_le ?_ ?_)
        · exact hg a (Finset.mem_insert_self a t)
        · exact ih (fun i hi => hg i (Finset.mem_insert_of_mem hi))

    have hUltraSumLt1 : ∀ {n : ℕ} (s : Finset (Fin n)) (g : Fin n → N),
        (∀ i ∈ s, ‖g i‖ < 1) → ‖∑ i ∈ s, g i‖ < 1 := by
      intro n s g hg
      induction s using Finset.induction_on with
      | empty => simp
      | @insert a t hat ih =>
        rw [Finset.sum_insert hat]
        refine (IsUltrametricDist.norm_add_le_max _ _).trans_lt (max_lt ?_ ?_)
        · exact hg a (Finset.mem_insert_self a t)
        · exact ih (fun i hi => hg i (Finset.mem_insert_of_mem hi))

    have hMasterOrtho : ∀ (M : Subfield N),
        (∀ w ∈ M, ‖w‖ ≤ 1 → ∃ z ∈ L₀, ‖w - z‖ < 1) →
        ∀ (y : Fin m₀ → N), (∀ i, y i ∈ M) →
        ∀ (j : Fin m₀), ‖y j‖ ≤ ‖∑ i : Fin m₀, y i * θ' ^ (i : ℕ)‖ := by
      intro M hM_res y hy j
      by_cases hyj : y j = 0
      · rw [hyj, norm_zero]
        exact norm_nonneg _
      · let S : Finset (Fin m₀) := Finset.univ.filter (fun i => y i ≠ 0)
        have hS_ne : S.Nonempty := ⟨j, Finset.mem_filter.mpr ⟨Finset.mem_univ j, hyj⟩⟩
        obtain ⟨i₀, hi₀S, hi₀_max⟩ := Finset.exists_max_image S (fun i => ‖y i‖) hS_ne
        have hy_i₀_ne : y i₀ ≠ 0 := (Finset.mem_filter.mp hi₀S).2
        have hy_i₀_pos : 0 < ‖y i₀‖ := norm_pos_iff.mpr hy_i₀_ne
        have hy_le : ∀ i : Fin m₀, ‖y i‖ ≤ ‖y i₀‖ := by
          intro i
          by_cases hi0 : y i = 0
          · rw [hi0, norm_zero]; exact hy_i₀_pos.le
          · exact hi₀_max i (Finset.mem_filter.mpr ⟨Finset.mem_univ i, hi0⟩)
        refine (hy_le j).trans ?_
        by_contra! hsum_lt
        let b : Fin m₀ → N := fun i => y i / y i₀
        have hb_mem : ∀ i : Fin m₀, b i ∈ M := fun i => M.div_mem (hy i) (hy i₀)
        have hb_le : ∀ i : Fin m₀, ‖b i‖ ≤ 1 := by
          intro i
          dsimp [b]
          rw [norm_div]
          exact div_le_one_of_le₀ (hy_le i) hy_i₀_pos.le
        have hb_sum_lt : ‖∑ i : Fin m₀, b i * θ' ^ (i : ℕ)‖ < 1 := by
          have h1 : (∑ i : Fin m₀, b i * θ' ^ (i : ℕ)) =
              (y i₀)⁻¹ * ∑ i : Fin m₀, y i * θ' ^ (i : ℕ) := by
            rw [Finset.mul_sum]
            refine Finset.sum_congr rfl fun i _ => ?_
            dsimp [b]
            rw [div_eq_inv_mul, mul_assoc]
          rw [h1, norm_mul, norm_inv]
          exact (inv_mul_lt_iff₀ hy_i₀_pos).mpr (by simpa using hsum_lt)
        choose z hzL hz_lt using fun i => hM_res (b i) (hb_mem i) (hb_le i)
        let z_sub : Fin m₀ → ↥L₀ := fun i => ⟨z i, hzL i⟩
        have hz_i₀_norm1 : ‖z i₀‖ = 1 := by
          apply le_antisymm (hL₀_norm (z i₀) (hzL i₀))
          by_contra! hlt0
          have hbi₀ : b i₀ = 1 := div_self hy_i₀_ne
          have h1_lt : ‖1 - z i₀‖ < 1 := by
            have := hz_lt i₀
            rwa [hbi₀] at this
          have hsplit : (1 : N) = (1 - z i₀) + z i₀ := (sub_add_cancel 1 (z i₀)).symm
          have h1_norm : ‖(1 : N)‖ < 1 := by
            rw [hsplit]
            exact (IsUltrametricDist.norm_add_le_max _ _).trans_lt (max_lt h1_lt hlt0)
          rw [norm_one] at h1_norm
          exact lt_irrefl 1 h1_norm
        have hz_sum_lt : ‖∑ i : Fin m₀, (z_sub i : N) * θ' ^ (i : ℕ)‖ < 1 := by
          have hsplit : (∑ i : Fin m₀, (z_sub i : N) * θ' ^ (i : ℕ)) =
              (∑ i : Fin m₀, b i * θ' ^ (i : ℕ)) +
              (∑ i : Fin m₀, (z i - b i) * θ' ^ (i : ℕ)) := by
            rw [← Finset.sum_add_distrib]
            refine Finset.sum_congr rfl fun i _ => ?_
            dsimp [z_sub]
            ring
          rw [hsplit]
          refine (IsUltrametricDist.norm_add_le_max _ _).trans_lt (max_lt hb_sum_lt ?_)
          refine hUltraSumLt1 _ _ fun i _ => ?_
          rw [norm_mul, norm_pow, norm_sub_rev]
          calc ‖b i - z i‖ * ‖θ'‖ ^ (i : ℕ)
              ≤ ‖b i - z i‖ * 1 :=
                mul_le_mul_of_nonneg_left (pow_le_one₀ (norm_nonneg θ') hθ'_norm) (norm_nonneg _)
            _ = ‖b i - z i‖ := mul_one _
            _ < 1 := hz_lt i
        have h_ortho := hOrthoL₀ z_sub i₀
        change ‖z i₀‖ ≤ _ at h_ortho
        linarith

    let M₁ : Subfield N := (algebraMap K₀ N).fieldRange
    have hM₁_res : ∀ w ∈ M₁, ‖w‖ ≤ 1 → ∃ z ∈ L₀, ‖w - z‖ < 1 := by
      rintro _ ⟨u, rfl⟩ hw
      exact hBaseRes₀ u hw
    let v_K₀ : Fin m₀ → ↥K'₀_int := fun i => ⟨θ' ^ (i : ℕ), pow_mem hθ'_mem (i : ℕ)⟩
    have hLI_K₀ : LinearIndependent K₀ v_K₀ := by
      rw [Fintype.linearIndependent_iff]
      intro a hsum0 j
      have hsumN : ∑ i : Fin m₀, algebraMap K₀ N (a i) * θ' ^ (i : ℕ) = 0 := by
        have h1 := congrArg Subtype.val hsum0
        rw [AddSubmonoidClass.coe_finsetSum] at h1
        simpa [v_K₀, Algebra.smul_def] using h1
      have hle0 : ‖algebraMap K₀ N (a j)‖ ≤ 0 := by
        have h1 := hMasterOrtho M₁ hM₁_res (fun i => algebraMap K₀ N (a i)) (fun i => ⟨a i, rfl⟩) j
        rwa [hsumN, norm_zero] at h1
      have ha0 : algebraMap K₀ N (a j) = 0 :=
        norm_eq_zero.mp (le_antisymm hle0 (norm_nonneg _))
      exact (RingHom.injective (algebraMap K₀ N)) (ha0.trans (map_zero _).symm)

    let B_K' : Module.Basis (Fin m₀) K₀ ↥K'₀_int :=
      basisOfLinearIndependentOfCardEqFinrank hLI_K₀ (by rw [Fintype.card_fin, hm₀])
    have hB_K'_apply : ∀ i : Fin m₀, B_K' i = v_K₀ i :=
      congrFun (coe_basisOfLinearIndependentOfCardEqFinrank hLI_K₀ _)

    have hOut1 : ∀ u ∈ K'₀_int, ∃ a : Fin m₀ → K₀,
        u = ∑ i : Fin m₀, algebraMap K₀ N (a i) * θ' ^ (i : ℕ) := by
      intro u hu
      refine ⟨B_K'.repr ⟨u, hu⟩, ?_⟩
      have h1 := congrArg Subtype.val (B_K'.sum_repr ⟨u, hu⟩)
      rw [AddSubmonoidClass.coe_finsetSum] at h1
      change ∑ i : Fin m₀, ((B_K'.repr ⟨u, hu⟩ i • B_K' i : ↥K'₀_int) : N) = u at h1
      refine h1.symm.trans (Finset.sum_congr rfl fun i _ => ?_)
      rw [hB_K'_apply i, IntermediateField.coe_smul, Algebra.smul_def]

    have hOut2 : ∀ w ∈ K'₀_int, ‖w‖ ≤ 1 → ∃ a : Fin m₀ → ↥L₀,
        ‖w - ∑ i : Fin m₀, (a i : N) * θ' ^ (i : ℕ)‖ < 1 := by
      intro w hw hw_le
      obtain ⟨a, ha_eq⟩ := hOut1 w hw
      have ha_le : ∀ i : Fin m₀, ‖algebraMap K₀ N (a i)‖ ≤ 1 := by
        intro i
        have h1 := hMasterOrtho M₁ hM₁_res (fun k => algebraMap K₀ N (a k)) (fun k => ⟨a k, rfl⟩) i
        rw [← ha_eq] at h1
        exact h1.trans hw_le
      choose z hzL hz_lt using fun i => hBaseRes₀ (a i) (ha_le i)
      refine ⟨fun i => ⟨z i, hzL i⟩, ?_⟩
      have hdiff : w - ∑ i : Fin m₀, z i * θ' ^ (i : ℕ) =
          ∑ i : Fin m₀, (algebraMap K₀ N (a i) - z i) * θ' ^ (i : ℕ) := by
        conv_lhs => rw [ha_eq]
        rw [← Finset.sum_sub_distrib]
        refine Finset.sum_congr rfl fun i _ => ?_
        ring
      change ‖w - ∑ i : Fin m₀, z i * θ' ^ (i : ℕ)‖ < 1
      rw [hdiff]
      refine hUltraSumLt1 _ _ fun i _ => ?_
      rw [norm_mul, norm_pow]
      calc ‖algebraMap K₀ N (a i) - z i‖ * ‖θ'‖ ^ (i : ℕ)
          ≤ ‖algebraMap K₀ N (a i) - z i‖ * 1 :=
            mul_le_mul_of_nonneg_left (pow_le_one₀ (norm_nonneg θ') hθ'_norm) (norm_nonneg _)
        _ = ‖algebraMap K₀ N (a i) - z i‖ := mul_one _
        _ < 1 := hz_lt i

    let M₂ : Subfield N := F₀_sub.toSubfield
    have hM₂_res : ∀ w ∈ M₂, ‖w‖ ≤ 1 → ∃ z ∈ L₀, ‖w - z‖ < 1 := by
      intro w hw hw_le
      obtain ⟨u, hu_le, hu_lt⟩ := hResSub₀ w hw hw_le
      obtain ⟨z, hzL, hz_lt⟩ := hBaseRes₀ u hu_le
      refine ⟨z, hzL, ?_⟩
      have hsplit : w - z = (w - algebraMap K₀ N u) + (algebraMap K₀ N u - z) := by ring
      rw [hsplit]
      exact (IsUltrametricDist.norm_add_le_max _ _).trans_lt (max_lt hu_lt hz_lt)

    letI : Algebra ↥F₀_sub ↥L₀_top :=
      (IntermediateField.inclusion (le_sup_right : F₀_sub ≤ L₀_top)).toAlgebra
    haveI : IsScalarTower K₀ ↥F₀_sub ↥L₀_top := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    let v_F : Fin m₀ → ↥L₀_top :=
      fun i => ⟨θ' ^ (i : ℕ), pow_mem ((le_sup_left : K'₀_int ≤ L₀_top) hθ'_mem) (i : ℕ)⟩
    have hLI_F : LinearIndependent ↥F₀_sub v_F := by
      rw [Fintype.linearIndependent_iff]
      intro y hsum0 j
      have hsumN : ∑ i : Fin m₀, (y i : N) * θ' ^ (i : ℕ) = 0 := by
        have h1 := congrArg Subtype.val hsum0
        rw [AddSubmonoidClass.coe_finsetSum] at h1
        exact h1
      have hle0 : ‖(y j : N)‖ ≤ 0 := by
        have h1 := hMasterOrtho M₂ hM₂_res (fun i => (y i : N)) (fun i => (y i).2) j
        rwa [hsumN, norm_zero] at h1
      have hy0 : (y j : N) = 0 := norm_eq_zero.mp (le_antisymm hle0 (norm_nonneg _))
      exact Subtype.ext hy0

    have hFinDeg_top : FiniteDimensional ↥F₀_sub ↥L₀_top ∧ Module.finrank ↥F₀_sub ↥L₀_top ≤ m₀ := by
      letI : Algebra ↥F₀_sub N := F₀_sub.toAlgebra
      let E_adj : IntermediateField ↥F₀_sub N := IntermediateField.adjoin ↥F₀_sub ({θ'} : Set N)
      have hL₀_le_F : (L₀ : Set N) ⊆ (F₀_sub : Set N) := by
        intro z hz
        obtain ⟨u, rfl⟩ := hL₀_sub hz
        exact F₀_sub.algebraMap_mem u
      let j_LF : ↥L₀ →+* ↥F₀_sub := L₀.subtype.codRestrict F₀_sub.toSubring (fun z => hL₀_le_F z.2)
      let f_F : Polynomial ↥F₀_sub := f₀.map j_LF
      have hf_F_monic : f_F.Monic := hf₀_monic.map j_LF
      have hf_F_deg : f_F.natDegree = m₀ := (hf₀_monic.natDegree_map j_LF).trans hf₀_deg
      have hf_F_aeval : Polynomial.aeval θ' f_F = 0 := by
        rw [Polynomial.aeval_def, Polynomial.eval₂_map]
        have hcomp : (algebraMap ↥F₀_sub N).comp j_LF = L₀.subtype := rfl
        rw [hcomp, ← Polynomial.eval_map]
        exact hθ'_root
      have hInt_F : IsIntegral ↥F₀_sub θ' := ⟨f_F, hf_F_monic, hf_F_aeval⟩
      haveI : FiniteDimensional ↥F₀_sub ↥E_adj := IntermediateField.adjoin.finiteDimensional hInt_F
      have hRank_Eadj : Module.finrank ↥F₀_sub ↥E_adj ≤ m₀ := by
        rw [IntermediateField.adjoin.finrank hInt_F, ← hf_F_deg]
        exact Polynomial.natDegree_le_of_dvd (minpoly.dvd ↥F₀_sub θ' hf_F_aeval) hf_F_monic.ne_zero
      have hEqSet : ∀ x : N, x ∈ L₀_top ↔ x ∈ E_adj := by
        intro x
        constructor
        · let E_K₀ : IntermediateField K₀ N :=
            { E_adj.toSubfield with
              algebraMap_mem' := fun u =>
                E_adj.algebraMap_mem ⟨algebraMap K₀ N u, F₀_sub.algebraMap_mem u⟩ }
          have hle_EK₀ : L₀_top ≤ E_K₀ := by
            refine sup_le ?_ ?_
            · intro u hu
              obtain ⟨a, rfl⟩ := hOut1 u hu
              exact E_adj.sum_mem fun i _ =>
                E_adj.mul_mem (E_K₀.algebraMap_mem (a i))
                  (pow_mem (IntermediateField.mem_adjoin_simple_self ↥F₀_sub θ') (i : ℕ))
            · intro w hw
              exact E_adj.algebraMap_mem ⟨w, hw⟩
          exact fun hx => hle_EK₀ hx
        · let L_F : IntermediateField ↥F₀_sub N :=
            { L₀_top.toSubfield with
              algebraMap_mem' := fun y => (le_sup_right : F₀_sub ≤ L₀_top) y.2 }
          have hle_LF : E_adj ≤ L_F := by
            rw [IntermediateField.adjoin_le_iff, Set.singleton_subset_iff]
            exact (le_sup_left : K'₀_int ≤ L₀_top) hθ'_mem
          exact fun hx => hle_LF hx
      let e_top : ↥L₀_top ≃ₗ[↥F₀_sub] ↥E_adj :=
        { toFun := fun x => ⟨x.1, (hEqSet x.1).mp x.2⟩
          invFun := fun x => ⟨x.1, (hEqSet x.1).mpr x.2⟩
          map_add' := fun _ _ => rfl
          map_smul' := fun _ _ => rfl
          left_inv := fun _ => rfl
          right_inv := fun _ => rfl }
      exact ⟨Module.Finite.equiv e_top.symm, e_top.finrank_eq.trans_le hRank_Eadj⟩

    haveI : FiniteDimensional ↥F₀_sub ↥L₀_top := hFinDeg_top.1
    have hRank_F_top : Module.finrank ↥F₀_sub ↥L₀_top = m₀ := by
      have hge : m₀ ≤ Module.finrank ↥F₀_sub ↥L₀_top := by
        have h1 := hLI_F.fintype_card_le_finrank
        rwa [Fintype.card_fin] at h1
      exact le_antisymm hFinDeg_top.2 hge

    let B_top : Module.Basis (Fin m₀) ↥F₀_sub ↥L₀_top :=
      basisOfLinearIndependentOfCardEqFinrank hLI_F (by rw [Fintype.card_fin, hRank_F_top])
    have hB_top_apply : ∀ i : Fin m₀, B_top i = v_F i :=
      congrFun (coe_basisOfLinearIndependentOfCardEqFinrank hLI_F _)
    haveI : Module.Free ↥F₀_sub ↥L₀_top := Module.Free.of_basis B_top

    have hOut3 : Module.finrank K₀ ↥L₀_top = Module.finrank K₀ ↥F₀_sub * m₀ := by
      rw [← Module.finrank_mul_finrank K₀ ↥F₀_sub ↥L₀_top, hRank_F_top]

    have hOut4 : ∀ w ∈ L₀_top, ‖w‖ ≤ 1 → ∃ u ∈ K'₀_int, ‖u‖ ≤ 1 ∧ ‖w - u‖ < 1 := by
      intro w hw hw_le
      let y : Fin m₀ → ↥F₀_sub := B_top.repr ⟨w, hw⟩
      have hw_eq : w = ∑ i : Fin m₀, (y i : N) * θ' ^ (i : ℕ) := by
        have h1 := congrArg Subtype.val (B_top.sum_repr ⟨w, hw⟩)
        rw [AddSubmonoidClass.coe_finsetSum] at h1
        change ∑ i : Fin m₀, ((y i • B_top i : ↥L₀_top) : N) = w at h1
        refine h1.symm.trans (Finset.sum_congr rfl fun i _ => ?_)
        rw [hB_top_apply i]
        rfl
      have hy_le : ∀ i : Fin m₀, ‖(y i : N)‖ ≤ 1 := by
        intro i
        have h1 := hMasterOrtho M₂ hM₂_res (fun k => (y k : N)) (fun k => (y k).2) i
        rw [← hw_eq] at h1
        exact h1.trans hw_le
      choose u hu_le hu_lt using fun i => hResSub₀ (y i).1 (y i).2 (hy_le i)
      let u_sum : N := ∑ i : Fin m₀, algebraMap K₀ N (u i) * θ' ^ (i : ℕ)
      have hu_mem : u_sum ∈ K'₀_int :=
        K'₀_int.sum_mem fun i _ =>
          K'₀_int.mul_mem (K'₀_int.algebraMap_mem (u i)) (pow_mem hθ'_mem (i : ℕ))
      have hu_norm : ‖u_sum‖ ≤ 1 := by
        dsimp only [u_sum]
        refine hUltraSumLe1 _ _ fun i _ => ?_
        rw [norm_mul, norm_pow]
        calc ‖algebraMap K₀ N (u i)‖ * ‖θ'‖ ^ (i : ℕ)
            ≤ 1 * 1 := mul_le_mul (hu_le i) (pow_le_one₀ (norm_nonneg θ') hθ'_norm)
              (pow_nonneg (norm_nonneg θ') _) zero_le_one
          _ = 1 := one_mul 1
      have hdiff_lt : ‖w - u_sum‖ < 1 := by
        have hdiff : w - u_sum =
            ∑ i : Fin m₀, ((y i : N) - algebraMap K₀ N (u i)) * θ' ^ (i : ℕ) := by
          dsimp only [u_sum]
          conv_lhs => rw [hw_eq]
          rw [← Finset.sum_sub_distrib]
          refine Finset.sum_congr rfl fun i _ => ?_
          ring
        rw [hdiff]
        refine hUltraSumLt1 _ _ fun i _ => ?_
        rw [norm_mul, norm_pow]
        calc ‖(y i : N) - algebraMap K₀ N (u i)‖ * ‖θ'‖ ^ (i : ℕ)
            ≤ ‖(y i : N) - algebraMap K₀ N (u i)‖ * 1 :=
              mul_le_mul_of_nonneg_left (pow_le_one₀ (norm_nonneg θ') hθ'_norm) (norm_nonneg _)
          _ = ‖(y i : N) - algebraMap K₀ N (u i)‖ := mul_one _
          _ < 1 := hu_lt i
      exact ⟨u_sum, hu_mem, hu_norm, hdiff_lt⟩

    exact ⟨hOut1, hOut2, hOut3, hOut4⟩

  
  have hS4_tower : ∀ (E L₁ L₂ : Type u)
      [Field E] [Field L₁] [Algebra E L₁] [Field L₂] [Algebra E L₂]
      (φ : L₁ →ₐ[E] L₂)
      (t₁ : L₁) (t₂ : L₂) (_hφt : φ t₁ = t₂)
      (_hFin₁ : FiniteDimensional ↥(IntermediateField.adjoin E ({t₁} : Set L₁)) L₁)
      (_hSep₁ : Algebra.IsSeparable ↥(IntermediateField.adjoin E ({t₁} : Set L₁)) L₁)
      (θ₂ : L₂)
      (g : Polynomial ↥φ.fieldRange) (_hg_monic : g.Monic) (_hg_sep : g.Separable)
      (_hg_aeval : Polynomial.aeval θ₂ g = 0)
      (_hSpan₂ : ∀ x : L₂, x ∈ IntermediateField.adjoin ↥φ.fieldRange ({θ₂} : Set L₂)),
      FiniteDimensional ↥(IntermediateField.adjoin E ({t₂} : Set L₂)) L₂ ∧
      Algebra.IsSeparable ↥(IntermediateField.adjoin E ({t₂} : Set L₂)) L₂ := by
    intro E L₁ L₂ _ _ _ _ _ φ t₁ t₂ hφt hFin₁ hSep₁ θ₂ g hg_monic hg_sep hg_aeval hSpan₂
    classical
    let Kt₁ : IntermediateField E L₁ := IntermediateField.adjoin E ({t₁} : Set L₁)
    let Kt₂ : IntermediateField E L₂ := IntermediateField.adjoin E ({t₂} : Set L₂)
    let L₀_int : IntermediateField E L₂ := φ.fieldRange
    haveI : FiniteDimensional ↥Kt₁ L₁ := hFin₁
    haveI : Algebra.IsSeparable ↥Kt₁ L₁ := hSep₁

    have hle1 : Kt₂ ≤ L₀_int := by
      rw [IntermediateField.adjoin_le_iff, Set.singleton_subset_iff]
      exact ⟨t₁, hφt⟩

    have hKt_iff : ∀ x : L₁, x ∈ Kt₁ ↔ φ x ∈ Kt₂ := by
      intro x
      constructor
      · have hle_c : Kt₁ ≤ Kt₂.comap φ := by
          rw [IntermediateField.adjoin_le_iff, Set.singleton_subset_iff]
          change φ t₁ ∈ Kt₂
          rw [hφt]
          exact IntermediateField.mem_adjoin_simple_self E t₂
        exact fun hx => hle_c hx
      · have hle_m : Kt₂ ≤ Kt₁.map φ := by
          rw [IntermediateField.adjoin_le_iff, Set.singleton_subset_iff]
          exact ⟨t₁, IntermediateField.mem_adjoin_simple_self E t₁, hφt⟩
        intro hx₂
        obtain ⟨w, hw, hw_eq⟩ := hle_m hx₂
        exact (φ.injective hw_eq) ▸ hw

    let e_φ : L₁ ≃ₐ[E] ↥L₀_int := AlgEquiv.ofInjectiveField φ
    let e_Kt : ↥Kt₁ ≃+* ↥Kt₂ :=
      { toFun := fun a => ⟨φ a.1, (hKt_iff a.1).mp a.2⟩
        invFun := fun b =>
          ⟨e_φ.symm ⟨b.1, hle1 b.2⟩,
            (hKt_iff _).mpr (by
              have h1 : φ (e_φ.symm ⟨b.1, hle1 b.2⟩) = b.1 :=
                congrArg Subtype.val (e_φ.apply_symm_apply ⟨b.1, hle1 b.2⟩)
              rw [h1]
              exact b.2)⟩
        left_inv := fun a => Subtype.ext (e_φ.symm_apply_apply a.1)
        right_inv := fun b => Subtype.ext (by
          dsimp only
          exact congrArg Subtype.val (e_φ.apply_symm_apply ⟨b.1, hle1 b.2⟩))
        map_mul' := fun a₁ a₂ => Subtype.ext (map_mul φ a₁.1 a₂.1)
        map_add' := fun a₁ a₂ => Subtype.ext (map_add φ a₁.1 a₂.1) }

    letI : Algebra ↥Kt₂ ↥L₀_int := (IntermediateField.inclusion hle1).toAlgebra
    haveI : IsScalarTower ↥Kt₂ ↥L₀_int L₂ := IsScalarTower.of_algebraMap_eq (fun _ => rfl)

    have he_smul : ∀ (a : ↥Kt₁) (x : L₁), e_φ (a • x) = e_Kt a • e_φ x := by
      intro a x
      apply Subtype.ext
      change φ (a.1 * x) = φ a.1 * φ x
      exact map_mul φ a.1 x

    haveI : FiniteDimensional ↥Kt₂ ↥L₀_int := by
      let B_Kt := Module.finBasis ↥Kt₁ L₁
      refine ⟨⟨Finset.univ.image (fun i => e_φ (B_Kt i)), ?_⟩⟩
      rw [eq_top_iff]
      intro y _
      rw [Finset.coe_image, Finset.coe_univ, Set.image_univ]
      have hrepr := congrArg e_φ (B_Kt.sum_repr (e_φ.symm y))
      rw [map_sum, e_φ.apply_symm_apply] at hrepr
      rw [← hrepr]
      refine Submodule.sum_mem _ fun i _ => ?_
      rw [he_smul]
      exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)

    haveI : Algebra.IsSeparable ↥Kt₂ ↥L₀_int := by
      refine ⟨fun y => ?_⟩
      let x : L₁ := e_φ.symm y
      have hsep_x : (minpoly ↥Kt₁ x).Separable := Algebra.IsSeparable.isSeparable ↥Kt₁ x
      let P_y : Polynomial ↥Kt₂ := (minpoly ↥Kt₁ x).map e_Kt.toRingHom
      have hsep_Py : P_y.Separable := hsep_x.map
      have haeval_Py : Polynomial.aeval y P_y = 0 := by
        have h0 : e_φ.toRingHom (Polynomial.aeval x (minpoly ↥Kt₁ x)) = 0 := by
          rw [minpoly.aeval, map_zero]
        rw [Polynomial.aeval_def, Polynomial.hom_eval₂] at h0
        have hex : e_φ.toRingHom x = y := e_φ.apply_symm_apply y
        have hcomp : e_φ.toRingHom.comp (algebraMap ↥Kt₁ L₁) =
            (algebraMap ↥Kt₂ ↥L₀_int).comp e_Kt.toRingHom := by
          ext a
          rfl
        rw [hex, hcomp, ← Polynomial.eval₂_map, ← Polynomial.aeval_def] at h0
        exact h0
      exact hsep_Py.of_dvd (minpoly.dvd ↥Kt₂ y haeval_Py)

    have hInt₂ : IsIntegral ↥L₀_int θ₂ := ⟨g, hg_monic, hg_aeval⟩
    have hSep_θ₂ : IsSeparable ↥L₀_int θ₂ := hg_sep.of_dvd (minpoly.dvd ↥L₀_int θ₂ hg_aeval)
    let E_c : IntermediateField ↥L₀_int L₂ := IntermediateField.adjoin ↥L₀_int ({θ₂} : Set L₂)
    have hEc_top : E_c = ⊤ := eq_top_iff.mpr fun x _ => hSpan₂ x
    haveI : FiniteDimensional ↥L₀_int ↥E_c := IntermediateField.adjoin.finiteDimensional hInt₂
    haveI : Algebra.IsSeparable ↥L₀_int ↥E_c :=
      (IntermediateField.isSeparable_adjoin_simple_iff_isSeparable ↥L₀_int L₂).mpr hSep_θ₂
    let e_Ec : ↥E_c ≃ₐ[↥L₀_int] L₂ :=
      (IntermediateField.equivOfEq hEc_top).trans IntermediateField.topEquiv
    haveI : FiniteDimensional ↥L₀_int L₂ := Module.Finite.equiv e_Ec.toLinearEquiv
    haveI : Algebra.IsSeparable ↥L₀_int L₂ := by
      refine ⟨fun x => ?_⟩
      have hx : x = e_Ec (e_Ec.symm x) := (e_Ec.apply_symm_apply x).symm
      rw [hx]
      change (minpoly ↥L₀_int (e_Ec (e_Ec.symm x))).Separable
      rw [minpoly.algEquiv_eq]
      exact Algebra.IsSeparable.isSeparable ↥L₀_int (e_Ec.symm x)

    exact ⟨Module.Finite.trans ↥L₀_int L₂, Algebra.IsSeparable.trans ↥Kt₂ ↥L₀_int L₂⟩

  
  have hS4 : ∀ (T : F_hat) (L_coeff : Subfield F_hat)
      (hT : T ∈ L_coeff)
      (hE_sub : ∀ e : ↥E_max, algebraMap K_hat F_hat (e : K_hat) ∈ L_coeff)
      (hL_le : L_coeff ≤ K_base)
      (_hGaussT : ∀ P : Polynomial ↥E_max, P ≠ 0 →
        ‖Polynomial.aeval T (Polynomial.map ((algebraMap K_hat F_hat).comp E_max.subtype) P)‖ = 1)
      (_hL_norm : ∀ z ∈ L_coeff, ‖z‖ ≤ 1)
      (_hFinSepKt :
        let ιE : ↥E_max →+* ↥L_coeff :=
          ((algebraMap K_hat F_hat).comp E_max.subtype).codRestrict L_coeff.toSubring hE_sub
        letI : Algebra ↥E_max ↥L_coeff := ιE.toAlgebra
        let Kt : IntermediateField ↥E_max ↥L_coeff :=
          IntermediateField.adjoin ↥E_max ({⟨T, hT⟩} : Set ↥L_coeff)
        FiniteDimensional ↥Kt ↥L_coeff ∧ Algebra.IsSeparable ↥Kt ↥L_coeff)
      (_hSpanBase :
        let L_T : Subfield F_hat :=
          (IntermediateField.adjoin K_hat ({T} : Set F_hat)).toSubfield.topologicalClosure
        ∃ B_fin : Finset F_hat, (↑B_fin : Set F_hat) ⊆ (L_coeff : Set F_hat) ∧
          ∀ u ∈ K_base, ∃ c : F_hat → F_hat, (∀ b ∈ B_fin, c b ∈ L_T) ∧
            u = ∑ b ∈ B_fin, c b * b)
      (L₀ K'₀ : Subfield N)
      (_hL₀_eq : L₀ = ((algebraMap ↥K_base N).comp (Subfield.inclusion hL_le)).fieldRange)
      (_hBaseSubK' : Set.range (algebraMap ↥K_base N) ⊆ (K'₀ : Set N))
      (_hClK' : IsClosed (K'₀ : Set N))
      (_hK'Val : ∀ u ∈ K'₀, u ≠ 0 → ∃ c : K_hat, ‖u‖ = ‖c‖)
      (m₀ : ℕ) (θ' : N) (_hθ'_K' : θ' ∈ K'₀) (_hθ'_norm : ‖θ'‖ ≤ 1)
      (f₀ : Polynomial ↥L₀) (_hf₀_monic : f₀.Monic) (_hf₀_sep : f₀.Separable)
      (_hθ'_root : Polynomial.eval θ' (f₀.map L₀.subtype) = 0)
      (_hK'_basis : ∀ u ∈ K'₀, ∃ a : Fin m₀ → ↥K_base,
        u = ∑ i : Fin m₀, algebraMap ↥K_base N (a i) * (θ') ^ (i : ℕ))
      (_hK'_approx : ∀ w ∈ K'₀, ‖w‖ ≤ 1 → ∃ a : Fin m₀ → ↥L₀,
        ‖w - ∑ i : Fin m₀, (a i : N) * (θ') ^ (i : ℕ)‖ < 1),
      IsWeilType23ModRamified K_hat N E_max K'₀ := by
    intro T L_coeff hT hE_sub hL_le hGaussT hL_norm hFinSepKt hSpanBase
      L₀ K'₀ hL₀_eq hBaseSubK' hClK' hK'Val m₀ θ' hθ'_K' hθ'_norm
      f₀ hf₀_monic hf₀_sep hθ'_root hK'_basis hK'_approx
    classical
    have hUltraSumLe1 : ∀ {n : ℕ} (s : Finset (Fin n)) (g : Fin n → N),
        (∀ i ∈ s, ‖g i‖ ≤ 1) → ‖∑ i ∈ s, g i‖ ≤ 1 := by
      intro n s g hg
      induction s using Finset.induction_on with
      | empty => simp
      | @insert a t hat ih =>
        rw [Finset.sum_insert hat]
        refine (IsUltrametricDist.norm_add_le_max _ _).trans (max_le ?_ ?_)
        · exact hg a (Finset.mem_insert_self a t)
        · exact ih (fun i hi => hg i (Finset.mem_insert_of_mem hi))

    have hRangeN : Set.range (algebraMap K_hat N) ⊆ (K'₀ : Set N) := by
      rintro _ ⟨c, rfl⟩
      rw [hAlgCompat c]
      exact hBaseSubK' ⟨_, rfl⟩

    let j_coeff : ↥L_coeff →+* N := (algebraMap ↥K_base N).comp (Subfield.inclusion hL_le)
    have hL₀_norm : ∀ z ∈ L₀, ‖z‖ ≤ 1 := by
      rw [hL₀_eq]
      rintro _ ⟨z, rfl⟩
      change ‖algebraMap ↥K_base N ⟨z.1, hL_le z.2⟩‖ ≤ 1
      rw [hIsoBase]
      exact hL_norm z.1 z.2

    letI : Algebra ↥L₀ N := L₀.toAlgebra
    let L'_int : IntermediateField ↥L₀ N := IntermediateField.adjoin ↥L₀ ({θ'} : Set N)
    let L'_coeff : Subfield N := L'_int.toSubfield
    let T' : N := j_coeff ⟨T, hT⟩

    have hL₀_le_L' : L₀ ≤ L'_coeff := fun z hz => L'_int.algebraMap_mem ⟨z, hz⟩
    have hL₀_le_K' : L₀ ≤ K'₀ := by
      rw [hL₀_eq]
      rintro _ ⟨z, rfl⟩
      exact hBaseSubK' ⟨⟨z.1, hL_le z.2⟩, rfl⟩

    have hT' : T' ∈ L'_coeff := hL₀_le_L' (hL₀_eq ▸ ⟨⟨T, hT⟩, rfl⟩)
    have hE'_sub : ∀ e : ↥E_max, algebraMap K_hat N (e : K_hat) ∈ L'_coeff := by
      intro e
      rw [hAlgCompat e.1]
      have hmemL₀ : algebraMap ↥K_base N ⟨algebraMap K_hat F_hat e.1, hRangeBase ⟨e.1, rfl⟩⟩ ∈ L₀ := by
        rw [hL₀_eq]
        exact ⟨⟨algebraMap K_hat F_hat e.1, hE_sub e⟩, rfl⟩
      exact hL₀_le_L' hmemL₀

    have hL'_le_K' : L'_coeff ≤ K'₀ := by
      let K'_over_L₀ : IntermediateField ↥L₀ N :=
        { K'₀ with algebraMap_mem' := fun z => hL₀_le_K' z.2 }
      have hle : L'_int ≤ K'_over_L₀ := by
        rw [IntermediateField.adjoin_le_iff, Set.singleton_subset_iff]
        exact hθ'_K'
      exact fun x hx => hle hx

    have hGaussT' : ∀ P : Polynomial ↥E_max, P ≠ 0 →
        ‖Polynomial.aeval T' (Polynomial.map ((algebraMap K_hat N).comp E_max.subtype) P)‖ = 1 := by
      intro P hP
      let φ_KB : ↥E_max →+* ↥K_base :=
        ((algebraMap K_hat F_hat).comp E_max.subtype).codRestrict K_base.toSubring
          (fun e => hL_le (hE_sub e))
      let val_KB : ↥K_base := Polynomial.eval₂ φ_KB ⟨T, hL_le hT⟩ P
      have hval_F : (val_KB : F_hat) =
          Polynomial.aeval T (Polynomial.map ((algebraMap K_hat F_hat).comp E_max.subtype) P) := by
        rw [Polynomial.coe_aeval_eq_eval, Polynomial.eval_map]
        exact Polynomial.hom_eval₂ P φ_KB K_base.subtype ⟨T, hL_le hT⟩
      have hval_N : algebraMap ↥K_base N val_KB =
          Polynomial.aeval T' (Polynomial.map ((algebraMap K_hat N).comp E_max.subtype) P) := by
        dsimp only [val_KB]
        rw [Polynomial.hom_eval₂ P φ_KB (algebraMap ↥K_base N) ⟨T, hL_le hT⟩,
          Polynomial.coe_aeval_eq_eval, Polynomial.eval_map]
        congr 1
        ext e
        exact (hAlgCompat e.1).symm
      rw [← hval_N, hIsoBase, hval_F]
      exact hGaussT P hP

    have hL'_norm : ∀ z ∈ L'_coeff, ‖z‖ ≤ 1 := by
      have haeval0 : Polynomial.aeval θ' f₀ = 0 := by
        rw [Polynomial.aeval_def, ← Polynomial.eval_map]
        exact hθ'_root
      have hInt_L₀ : IsIntegral ↥L₀ θ' := ⟨f₀, hf₀_monic, haeval0⟩
      let pb := IntermediateField.adjoin.powerBasis hInt_L₀
      intro z hz
      have hrepr := congrArg Subtype.val (pb.basis.sum_repr ⟨z, hz⟩)
      rw [AddSubmonoidClass.coe_finsetSum] at hrepr
      change (∑ i : Fin pb.dim, ((pb.basis.repr ⟨z, hz⟩ i • pb.basis i : ↥L'_int) : N)) = z at hrepr
      rw [← hrepr]
      refine hUltraSumLe1 _ _ fun i _ => ?_
      have hbas : (pb.basis i : N) = θ' ^ (i : ℕ) := by
        have h1 := congrArg L'_int.val.toRingHom (pb.basis_eq_pow i)
        rw [map_pow] at h1
        have hgen : L'_int.val.toRingHom pb.gen = θ' :=
          congrArg Subtype.val (IntermediateField.adjoin.powerBasis_gen hInt_L₀)
        rwa [hgen] at h1
      change ‖((pb.basis.repr ⟨z, hz⟩ i : ↥L₀) : N) * (pb.basis i : N)‖ ≤ 1
      rw [hbas, norm_mul, norm_pow]
      calc ‖((pb.basis.repr ⟨z, hz⟩ i : ↥L₀) : N)‖ * ‖θ'‖ ^ (i : ℕ)
          ≤ 1 * 1 := mul_le_mul (hL₀_norm _ (pb.basis.repr ⟨z, hz⟩ i).2)
            (pow_le_one₀ (norm_nonneg θ') hθ'_norm) (pow_nonneg (norm_nonneg θ') _) zero_le_one
        _ = 1 := one_mul 1

    have hL'_approx : ∀ w ∈ K'₀, ‖w‖ ≤ 1 → ∃ z ∈ L'_coeff, ‖w - z‖ < 1 := by
      intro w hw hw_le
      obtain ⟨a, ha_lt⟩ := hK'_approx w hw hw_le
      refine ⟨∑ i : Fin m₀, (a i : N) * θ' ^ (i : ℕ), ?_, ha_lt⟩
      exact L'_coeff.sum_mem fun i _ =>
        L'_coeff.mul_mem (hL₀_le_L' (a i).2)
          (pow_mem (IntermediateField.mem_adjoin_simple_self ↥L₀ θ') (i : ℕ))

    have hKtSep :
        let ιE' : ↥E_max →+* ↥L'_coeff :=
          ((algebraMap K_hat N).comp E_max.subtype).codRestrict L'_coeff.toSubring hE'_sub
        letI : Algebra ↥E_max ↥L'_coeff := ιE'.toAlgebra
        let Kt' : IntermediateField ↥E_max ↥L'_coeff :=
          IntermediateField.adjoin ↥E_max ({⟨T', hT'⟩} : Set ↥L'_coeff)
        FiniteDimensional ↥Kt' ↥L'_coeff ∧ Algebra.IsSeparable ↥Kt' ↥L'_coeff := by
      let ιE : ↥E_max →+* ↥L_coeff :=
        ((algebraMap K_hat F_hat).comp E_max.subtype).codRestrict L_coeff.toSubring hE_sub
      letI : Algebra ↥E_max ↥L_coeff := ιE.toAlgebra
      let ιE' : ↥E_max →+* ↥L'_coeff :=
        ((algebraMap K_hat N).comp E_max.subtype).codRestrict L'_coeff.toSubring hE'_sub
      letI : Algebra ↥E_max ↥L'_coeff := ιE'.toAlgebra
      obtain ⟨hFinKt, hSepKt⟩ := hFinSepKt
      have hj_mem : ∀ z : ↥L_coeff, j_coeff z ∈ L'_coeff :=
        fun z => hL₀_le_L' (hL₀_eq ▸ ⟨z, rfl⟩)
      let φ_L : ↥L_coeff →ₐ[↥E_max] ↥L'_coeff :=
        { toRingHom := j_coeff.codRestrict L'_coeff.toSubring hj_mem
          commutes' := fun e => Subtype.ext (by
            change j_coeff (ιE e) = algebraMap K_hat N e.1
            rw [hAlgCompat e.1]
            rfl) }
      have hRange_iff : ∀ x : ↥L'_coeff, x ∈ φ_L.fieldRange ↔ x.1 ∈ L₀ := by
        intro x
        rw [hL₀_eq]
        constructor
        · rintro ⟨z, rfl⟩; exact ⟨z, rfl⟩
        · rintro ⟨z, hz⟩; exact ⟨z, Subtype.ext hz⟩
      let e_L₀ : ↥L₀ ≃+* ↥φ_L.fieldRange :=
        { toFun := fun z => ⟨⟨z.1, hL₀_le_L' z.2⟩, (hRange_iff _).mpr z.2⟩
          invFun := fun y => ⟨y.1.1, (hRange_iff y.1).mp y.2⟩
          left_inv := fun _ => Subtype.ext rfl
          right_inv := fun _ => Subtype.ext (Subtype.ext rfl)
          map_mul' := fun _ _ => Subtype.ext (Subtype.ext rfl)
          map_add' := fun _ _ => Subtype.ext (Subtype.ext rfl) }
      let θ₂ : ↥L'_coeff := ⟨θ', IntermediateField.mem_adjoin_simple_self ↥L₀ θ'⟩
      let g : Polynomial ↥φ_L.fieldRange := f₀.map e_L₀.toRingHom
      have hg_monic : g.Monic := hf₀_monic.map e_L₀.toRingHom
      have hg_sep : g.Separable := hf₀_sep.map
      have hg_aeval : Polynomial.aeval θ₂ g = 0 := by
        apply Subtype.ext
        rw [Subfield.coe_zero, Polynomial.aeval_def, Polynomial.eval₂_map]
        have h1 := Polynomial.hom_eval₂ f₀
          ((algebraMap ↥φ_L.fieldRange ↥L'_coeff).comp e_L₀.toRingHom)
          L'_coeff.subtype θ₂
        have hcomp :
            L'_coeff.subtype.comp ((algebraMap ↥φ_L.fieldRange ↥L'_coeff).comp e_L₀.toRingHom) =
            L₀.subtype := rfl
        change L'_coeff.subtype
          (Polynomial.eval₂ ((algebraMap ↥φ_L.fieldRange ↥L'_coeff).comp e_L₀.toRingHom) θ₂ f₀) = 0
        rw [h1, hcomp, ← Polynomial.eval_map]
        exact hθ'_root
      have hSpan₂ : ∀ x : ↥L'_coeff,
          x ∈ IntermediateField.adjoin ↥φ_L.fieldRange ({θ₂} : Set ↥L'_coeff) := by
        let E_c := IntermediateField.adjoin ↥φ_L.fieldRange ({θ₂} : Set ↥L'_coeff)
        let S_N : Subfield N := E_c.toSubfield.map L'_coeff.subtype
        let S_int : IntermediateField ↥L₀ N :=
          { S_N with
            algebraMap_mem' := fun z =>
              ⟨algebraMap ↥φ_L.fieldRange ↥L'_coeff (e_L₀ z), E_c.algebraMap_mem (e_L₀ z), rfl⟩ }
        have hle_S : L'_int ≤ S_int := by
          rw [IntermediateField.adjoin_le_iff, Set.singleton_subset_iff]
          exact ⟨θ₂, IntermediateField.mem_adjoin_simple_self ↥φ_L.fieldRange θ₂, rfl⟩
        intro x
        obtain ⟨y, hyEc, hy_eq⟩ := hle_S x.2
        exact (Subtype.ext hy_eq) ▸ hyEc
      exact hS4_tower ↥E_max ↥L_coeff ↥L'_coeff φ_L ⟨T, hT⟩ ⟨T', hT'⟩ (Subtype.ext rfl)
        hFinKt hSepKt θ₂ g hg_monic hg_sep hg_aeval hSpan₂

    let L_T : Subfield F_hat :=
      (IntermediateField.adjoin K_hat ({T} : Set F_hat)).toSubfield.topologicalClosure
    let L_T' : Subfield N :=
      (IntermediateField.adjoin K_hat ({T'} : Set N)).toSubfield.topologicalClosure
    let ι_base : ↥K_base →+* N := algebraMap ↥K_base N

    have hLT_map : ∀ y ∈ L_T, ∃ hy : y ∈ K_base, ι_base ⟨y, hy⟩ ∈ L_T' := by
      have hcont_ι : Continuous ι_base :=
        (Isometry.of_dist_eq fun u v => by
          rw [dist_eq_norm, dist_eq_norm, ← map_sub, hIsoBase]; rfl).continuous
      let S_pre : Subfield ↥K_base := L_T'.comap ι_base
      have hCl_pre : IsClosed (S_pre : Set ↥K_base) :=
        (Subfield.isClosed_topologicalClosure _).preimage hcont_ι
      let S_F : Subfield F_hat := S_pre.map K_base.subtype
      have hCl_SF : IsClosed (S_F : Set F_hat) :=
        (IsClosed.isClosedEmbedding_subtypeVal hClBase).isClosedMap _ hCl_pre
      let S_F_int : IntermediateField K_hat F_hat :=
        { S_F with
          algebraMap_mem' := fun c => by
            refine ⟨⟨algebraMap K_hat F_hat c, hRangeBase ⟨c, rfl⟩⟩, ?_, rfl⟩
            change ι_base _ ∈ L_T'
            rw [← hAlgCompat c]
            exact Subfield.le_topologicalClosure _
              ((IntermediateField.adjoin K_hat ({T'} : Set N)).algebraMap_mem c) }
      have hadj_le : IntermediateField.adjoin K_hat ({T} : Set F_hat) ≤ S_F_int := by
        rw [IntermediateField.adjoin_le_iff, Set.singleton_subset_iff]
        refine ⟨⟨T, hL_le hT⟩, ?_, rfl⟩
        change ι_base ⟨T, hL_le hT⟩ ∈ L_T'
        exact Subfield.le_topologicalClosure _
          (IntermediateField.mem_adjoin_simple_self K_hat T')
      have hLT_le : L_T ≤ S_F :=
        Subfield.topologicalClosure_minimal
          (IntermediateField.adjoin K_hat ({T} : Set F_hat)).toSubfield hadj_le hCl_SF
      intro y hy
      obtain ⟨u, hu_pre, rfl⟩ := hLT_le hy
      exact ⟨u.2, hu_pre⟩

    obtain ⟨B_fin, hB_sub, hB_span⟩ := hSpanBase
    let Idx := ↥B_fin × Fin m₀
    let φ_B : Idx → N := fun p => ι_base ⟨p.1.1, hL_le (hB_sub p.1.2)⟩ * θ' ^ (p.2 : ℕ)
    let B'_fin : Finset N := Finset.univ.image φ_B
    have hB'_sub : (↑B'_fin : Set N) ⊆ (L'_coeff : Set N) := by
      intro x hx
      obtain ⟨p, _, rfl⟩ := Finset.mem_image.mp hx
      refine L'_coeff.mul_mem ?_
        (pow_mem (IntermediateField.mem_adjoin_simple_self ↥L₀ θ') (p.2 : ℕ))
      exact hL₀_le_L' (hL₀_eq ▸ ⟨⟨p.1.1, hB_sub p.1.2⟩, rfl⟩)

    have hSpanK' : ∀ u ∈ K'₀, ∃ c' : N → N, (∀ b' ∈ B'_fin, c' b' ∈ L_T') ∧
        u = ∑ b' ∈ B'_fin, c' b' * b' := by
      intro u hu
      obtain ⟨a, ha_eq⟩ := hK'_basis u hu
      choose ci hci_mem hci_eq using fun i : Fin m₀ => hB_span (a i).1 (a i).2
      let d : Idx → N := fun p =>
        ι_base ⟨ci p.2 p.1.1, (hLT_map _ (hci_mem p.2 p.1.1 p.1.2)).1⟩
      have hd_mem : ∀ p : Idx, d p ∈ L_T' :=
        fun p => (hLT_map _ (hci_mem p.2 p.1.1 p.1.2)).2
      have hu_prod : u = ∑ p : Idx, d p * φ_B p := by
        rw [ha_eq, Fintype.sum_prod_type_right]
        refine Finset.sum_congr rfl fun i _ => ?_
        have hai_KB : a i = ∑ b : ↥B_fin,
            ⟨ci i b.1, (hLT_map _ (hci_mem i b.1 b.2)).1⟩ * ⟨b.1, hL_le (hB_sub b.2)⟩ := by
          apply Subtype.ext
          rw [AddSubmonoidClass.coe_finsetSum]
          exact (hci_eq i).trans (Finset.sum_coe_sort B_fin (fun b => ci i b * b)).symm
        have hai_N : ι_base (a i) = ∑ b : ↥B_fin, d (b, i) * ι_base ⟨b.1, hL_le (hB_sub b.2)⟩ := by
          conv_lhs => rw [hai_KB]
          rw [map_sum]
          refine Finset.sum_congr rfl fun b _ => ?_
          rw [map_mul]
        rw [hai_N, Finset.sum_mul]
        refine Finset.sum_congr rfl fun b _ => ?_
        dsimp [φ_B]
        ring
      let c' : N → N := fun x => ∑ p ∈ Finset.univ.filter (fun p : Idx => φ_B p = x), d p
      refine ⟨c', fun b' _ => L_T'.sum_mem fun p _ => hd_mem p, ?_⟩
      have hfib : (∑ b' ∈ B'_fin, c' b' * b') =
          ∑ b' ∈ B'_fin, ∑ p ∈ Finset.univ.filter (fun p : Idx => φ_B p = b'), d p * φ_B p := by
        refine Finset.sum_congr rfl fun b' _ => ?_
        dsimp [c']
        rw [Finset.sum_mul]
        refine Finset.sum_congr rfl fun p hp => ?_
        rw [(Finset.mem_filter.mp hp).2]
      rw [hfib, Finset.sum_fiberwise_of_maps_to
        (fun p _ => Finset.mem_image_of_mem φ_B (Finset.mem_univ p))]
      exact hu_prod

    refine ⟨hRangeN, hClK', Or.inl ⟨T', L'_coeff, hT', hE'_sub, hL'_le_K', hGaussT',
      hL'_norm, hK'Val, hL'_approx, hKtSep, B'_fin, hB'_sub, hSpanK'⟩⟩

  
  dsimp only
  let K'_int : IntermediateField ↥K_base N := IntermediateField.fixedField P
  let K' : Subfield N := K'_int.toSubfield
  let L_top : IntermediateField ↥K_base N := K'_int ⊔ F_sub
  let m₀ : ℕ := Module.finrank ↥K_base ↥K'_int

  obtain ⟨T, L_coeff, hT, hE_sub, hL_le, hGaussT, hL_norm, hBaseVal, hBaseRes,
    hFinSepKt, hSpanBase⟩ := hType2
  let L₀ : Subfield N := ((algebraMap ↥K_base N).comp (Subfield.inclusion hL_le)).fieldRange

  have hKhat_fixed : ∀ (σ : N ≃ₐ[↥K_base] N) (c : K_hat),
      σ (algebraMap K_hat N c) = algebraMap K_hat N c := by
    intro σ c
    rw [hAlgCompat c]
    exact AlgEquiv.commutes σ _

  have hBaseVal₀ : ∀ u : ↥K_base, u ≠ 0 → ∃ c : K_hat, ‖algebraMap ↥K_base N u‖ = ‖c‖ := by
    intro u hu
    rw [hIsoBase u]
    exact hBaseVal u.1 u.2 (fun h0 => hu (Subtype.ext h0))

  have hL₀_sub : (L₀ : Set N) ⊆ Set.range (algebraMap ↥K_base N) := by
    rintro _ ⟨z, rfl⟩
    exact ⟨⟨z.1, hL_le z.2⟩, rfl⟩

  have hL₀_norm : ∀ z ∈ L₀, ‖z‖ ≤ 1 := by
    rintro _ ⟨z, rfl⟩
    change ‖algebraMap ↥K_base N ⟨z.1, hL_le z.2⟩‖ ≤ 1
    rw [hIsoBase]
    exact hL_norm z.1 z.2

  have hBaseRes₀ : ∀ u : ↥K_base, ‖algebraMap ↥K_base N u‖ ≤ 1 →
      ∃ z ∈ L₀, ‖algebraMap ↥K_base N u - z‖ < 1 := by
    intro u hu_le
    rw [hIsoBase u] at hu_le
    obtain ⟨z, hzL, hz_lt⟩ := hBaseRes u.1 u.2 hu_le
    refine ⟨algebraMap ↥K_base N ⟨z, hL_le hzL⟩, ⟨⟨z, hzL⟩, rfl⟩, ?_⟩
    have hsub : algebraMap ↥K_base N u - algebraMap ↥K_base N ⟨z, hL_le hzL⟩ =
        algebraMap ↥K_base N (u - ⟨z, hL_le hzL⟩) := (map_sub _ _ _).symm
    rw [hsub, hIsoBase]
    exact hz_lt

  obtain ⟨hN_val, hClK', y₀, f₀, hy₀_K', hy₀_norm, hf₀_monic, _hf₀_irr, hf₀_sep, hf₀_deg,
    hf₀_eval_lt, hf₀_deriv_eq, hOrthoL₀_near⟩ :=
    hS1 ↥K_base L₀ hKhat_fixed hIsoGal hBaseVal₀ hL₀_sub hL₀_norm hBaseRes₀ P hP_mem

  have hBaseSubK' : Set.range (algebraMap ↥K_base N) ⊆ (K' : Set N) := by
    rintro _ ⟨u, rfl⟩
    exact K'_int.algebraMap_mem u

  have hL₀_le_K' : L₀ ≤ K' := hL₀_sub.trans hBaseSubK'

  have hf_map_mem : ∀ i : ℕ, (f₀.map L₀.subtype).coeff i ∈ K' := by
    intro i
    rw [Polynomial.coeff_map]
    exact hL₀_le_K' (f₀.coeff i).2

  have hf_map_norm : ∀ i : ℕ, ‖(f₀.map L₀.subtype).coeff i‖ ≤ 1 := by
    intro i
    rw [Polynomial.coeff_map]
    exact hL₀_norm _ (f₀.coeff i).2

  obtain ⟨θ', hθ'_K', hθ'_norm, hθ'_dist, hθ'_root⟩ :=
    hS2 K' hClK' (f₀.map L₀.subtype) hf_map_mem hf_map_norm y₀ hy₀_K' hy₀_norm
      hf₀_eval_lt hf₀_deriv_eq

  haveI : FiniteDimensional ↥K_base ↥K'_int := FiniteDimensional.left ↥K_base ↥K'_int N
  haveI : FiniteDimensional ↥K_base ↥F_sub := FiniteDimensional.left ↥K_base ↥F_sub N

  have hResSub₀ : ∀ w ∈ F_sub, ‖w‖ ≤ 1 →
      ∃ u : ↥K_base, ‖algebraMap ↥K_base N u‖ ≤ 1 ∧ ‖w - algebraMap ↥K_base N u‖ < 1 := by
    intro w hw hw_le
    obtain ⟨u, hu_le, hu_lt⟩ := hResSub w hw hw_le
    rw [← hIsoBase u] at hu_le
    exact ⟨u, hu_le, hu_lt⟩

  obtain ⟨hK'_basis, hK'_approx, hFinrankMul, hResTop⟩ :=
    hS3 ↥K_base L₀ hL₀_sub hL₀_norm hBaseRes₀ K'_int m₀ rfl θ' hθ'_K' hθ'_norm
      f₀ hf₀_monic hf₀_deg hθ'_root (hOrthoL₀_near θ' hθ'_dist) F_sub hResSub₀

  have hK'Val : ∀ u ∈ K', u ≠ 0 → ∃ c : K_hat, ‖u‖ = ‖c‖ :=
    fun u _ hu_ne => hN_val u hu_ne

  have hModK' : IsWeilType23ModRamified K_hat N E_max K' :=
    hS4 T L_coeff hT hE_sub hL_le hGaussT hL_norm hFinSepKt hSpanBase
      L₀ K' rfl hBaseSubK' hClK' hK'Val m₀ θ' hθ'_K' hθ'_norm
      f₀ hf₀_monic hf₀_sep hθ'_root
      (fun u hu => hK'_basis u hu)
      (fun w hw hle => hK'_approx w hw hle)

  have hValTop : ∀ w ∈ L_top, w ≠ 0 → ∃ u ∈ K', ‖w‖ = ‖u‖ := by
    intro w _ hw_ne
    obtain ⟨c, hc⟩ := hN_val w hw_ne
    refine ⟨algebraMap K_hat N c, ?_, hc.trans (hIsoN c).symm⟩
    rw [hAlgCompat c]
    exact K'_int.algebraMap_mem _

  refine ⟨hModK', hFinrankMul, hValTop, ?_⟩
  intro w hw hle
  obtain ⟨u, hu, hu1, hu2⟩ := hResTop w hw hle
  exact ⟨u, hu, hu1, hu2⟩

theorem weil_type3_wild_fixedField_modRamified_and_immediate (K_hat F_hat N : Type u)
    [NontriviallyNormedField K_hat] [CompleteSpace K_hat]
    [IsUltrametricDist K_hat] [IsAlgClosed K_hat]
    [NontriviallyNormedField F_hat] [CompleteSpace F_hat]
    [IsUltrametricDist F_hat] [Algebra K_hat F_hat]
    [NontriviallyNormedField N] [CompleteSpace N]
    [IsUltrametricDist N] [Algebra K_hat N]
    (E_max : Subfield K_hat)
    (hEquiChar : ∀ p : ℕ, p.Prime → (p : K_hat) = 0 ∨ ‖(p : K_hat)‖ = 1)
    (hIsoK : ∀ c : K_hat, ‖algebraMap K_hat F_hat c‖ = ‖c‖)
    (hIsoN : ∀ c : K_hat, ‖algebraMap K_hat N c‖ = ‖c‖)
    (hE_norm : ∀ c ∈ E_max, ‖c‖ ≤ 1)
    (hE_alg : IsAlgClosed ↥E_max)
    (hE_res : ∀ c : K_hat, ‖c‖ ≤ 1 → ∃ e ∈ E_max, ‖c - e‖ < 1)
    (K_base : Subfield F_hat)
    (hRangeBase : Set.range (algebraMap K_hat F_hat) ⊆ (K_base : Set F_hat))
    (hClBase : IsClosed (K_base : Set F_hat))
    (hType3 : ∃ T₀ : F_hat, T₀ ∈ K_base ∧ T₀ ≠ 0 ∧ (∀ c : K_hat, ‖T₀‖ ≠ ‖c‖) ∧
      K_base = (IntermediateField.adjoin K_hat ({T₀} : Set F_hat)).toSubfield.topologicalClosure)
    [Algebra ↥K_base N] [FiniteDimensional ↥K_base N] [IsGalois ↥K_base N]
    (hIsoBase : ∀ u : ↥K_base, ‖algebraMap ↥K_base N u‖ = ‖(u : F_hat)‖)
    (hAlgCompat : ∀ c : K_hat,
      algebraMap K_hat N c = algebraMap ↥K_base N ⟨algebraMap K_hat F_hat c, hRangeBase ⟨c, rfl⟩⟩)
    (hIsoGal : ∀ (σ : N ≃ₐ[↥K_base] N) (x : N), ‖σ x‖ = ‖x‖)
    (P : Subgroup (N ≃ₐ[↥K_base] N)) [P.Normal]
    (hP_mem : ∀ σ : N ≃ₐ[↥K_base] N, σ ∈ P ↔ ∀ x : N, x ≠ 0 → ‖σ x - x‖ < ‖x‖)
    (hP_pGroup : P = ⊥ ∨ ∃ p : ℕ, p.Prime ∧ (p : K_hat) = 0 ∧ IsPGroup p ↥P)
    (F_sub : IntermediateField ↥K_base N)
    (hValSub : ∀ w ∈ F_sub, w ≠ 0 → ∃ u ∈ K_base, ‖w‖ = ‖u‖) :
    let K'_int : IntermediateField ↥K_base N := IntermediateField.fixedField P
    let K' : Subfield N := K'_int.toSubfield
    let L_top : IntermediateField ↥K_base N := K'_int ⊔ F_sub
    IsWeilType23ModRamified K_hat N E_max K' ∧
    Module.finrank ↥K_base ↥L_top =
      Module.finrank ↥K_base ↥F_sub * Module.finrank ↥K_base ↥K'_int ∧
    (∀ w ∈ L_top, w ≠ 0 → ∃ u ∈ K', ‖w‖ = ‖u‖) ∧
    (∀ w ∈ L_top, ‖w‖ ≤ 1 → ∃ u ∈ K', ‖u‖ ≤ 1 ∧ ‖w - u‖ < 1) :=
by
  dsimp only
  set K'_int : IntermediateField ↥K_base N := IntermediateField.fixedField P
  set K' : Subfield N := K'_int.toSubfield
  set L_top : IntermediateField ↥K_base N := K'_int ⊔ F_sub

  
  
  
  have hMapNeZero : ∀ {A B : Type u} [DivisionRing A] [Semiring B] [Nontrivial B]
      (f : A →+* B) {a : A}, a ≠ 0 → f a ≠ 0 := by
    intro A B _ _ _ f a ha h0
    exact ha ((RingHom.injective f) (h0.trans (map_zero f).symm))

  have hUltraMaxSum : ∀ {E : Type u} [SeminormedAddCommGroup E] [IsUltrametricDist E]
      {ι : Type} [DecidableEq ι] (S : Finset ι) (f : ι → E),
      S.Nonempty →
      (∀ i ∈ S, ∀ j ∈ S, i ≠ j → ‖f i‖ ≠ ‖f j‖) →
      ∃ i_max ∈ S, ‖∑ i ∈ S, f i‖ = ‖f i_max‖ ∧ ∀ j ∈ S, ‖f j‖ ≤ ‖f i_max‖ := by
    intro E _ _ ι _ S f
    induction S using Finset.induction with
    | empty =>
      intro hne
      exact False.elim (Finset.not_nonempty_empty hne)
    | @insert a s ha ih =>
      intro _ hDist
      rcases s.eq_empty_or_nonempty with rfl | hs
      · refine ⟨a, Finset.mem_insert_self a ∅, by simp, ?_⟩
        intro j hj
        rw [Finset.mem_singleton.mp hj]
      · obtain ⟨b, hb_mem, hb_eq, hb_le⟩ := ih hs (fun i hi j hj hij =>
          hDist i (Finset.mem_insert_of_mem hi) j (Finset.mem_insert_of_mem hj) hij)
        have hab : a ≠ b := fun h => ha (h ▸ hb_mem)
        have hne_norm : ‖f a‖ ≠ ‖∑ i ∈ s, f i‖ := by
          rw [hb_eq]
          exact hDist a (Finset.mem_insert_self a s) b (Finset.mem_insert_of_mem hb_mem) hab
        have hadd : ‖f a + ∑ i ∈ s, f i‖ = max ‖f a‖ ‖∑ i ∈ s, f i‖ :=
          IsUltrametricDist.norm_add_eq_max_of_norm_ne_norm hne_norm
        rcases max_choice ‖f a‖ ‖f b‖ with hmax | hmax
        · have hba : ‖f b‖ ≤ ‖f a‖ := by
            have h1 : ‖f b‖ ≤ max ‖f a‖ ‖f b‖ := le_max_right _ _
            rwa [hmax] at h1
          refine ⟨a, Finset.mem_insert_self a s, by rw [Finset.sum_insert ha, hadd, hb_eq, hmax], ?_⟩
          intro j hj
          rcases Finset.mem_insert.mp hj with rfl | hjs
          · exact le_rfl
          · exact (hb_le j hjs).trans hba
        · have hab_le : ‖f a‖ ≤ ‖f b‖ := by
            have h1 : ‖f a‖ ≤ max ‖f a‖ ‖f b‖ := le_max_left _ _
            rwa [hmax] at h1
          refine ⟨b, Finset.mem_insert_of_mem hb_mem, by rw [Finset.sum_insert ha, hadd, hb_eq, hmax], ?_⟩
          intro j hj
          rcases Finset.mem_insert.mp hj with rfl | hjs
          · exact hab_le
          · exact hb_le j hjs

  have hUltraSumLt : ∀ {E : Type u} [SeminormedAddCommGroup E] [IsUltrametricDist E]
      {ι : Type} [DecidableEq ι] (S : Finset ι) (f : ι → E) (B : ℝ),
      0 < B → (∀ i ∈ S, ‖f i‖ < B) → ‖∑ i ∈ S, f i‖ < B := by
    intro E _ _ ι _ S f B hB
    induction S using Finset.induction with
    | empty =>
      intro _
      simpa using hB
    | @insert a s ha ih =>
      intro hf
      rw [Finset.sum_insert ha]
      refine (IsUltrametricDist.norm_add_le_max _ _).trans_lt (max_lt ?_ ?_)
      · exact hf a (Finset.mem_insert_self a s)
      · exact ih (fun i hi => hf i (Finset.mem_insert_of_mem hi))

  have hUltraEq : ∀ {E : Type u} [SeminormedAddCommGroup E] [IsUltrametricDist E]
      (u s : E), ‖u - s‖ < ‖u‖ → ‖u‖ = ‖s‖ := by
    intro E _ _ u s hlt
    have h1 : ‖u‖ ≤ ‖s‖ := by
      have hmax : ‖u‖ ≤ max ‖u - s‖ ‖s‖ := by
        simpa only [sub_add_cancel] using IsUltrametricDist.norm_add_le_max (u - s) s
      rcases le_max_iff.mp hmax with h | h
      · linarith
      · exact h
    have h2 : ‖s‖ ≤ ‖u‖ := by
      have hmax : ‖s‖ ≤ max ‖u‖ ‖-(u - s)‖ := by
        have hs : u + -(u - s) = s := by abel
        simpa only [hs] using IsUltrametricDist.norm_add_le_max u (-(u - s))
      rw [norm_neg] at hmax
      exact hmax.trans (max_le le_rfl (le_of_lt hlt))
    exact le_antisymm h1 h2

  haveI hUltraBase : IsUltrametricDist ↥K_base := inferInstance
  letI : NontriviallyNormedField ↥K_base :=
    { (inferInstance : NormedField ↥K_base) with
      non_trivial := by
        obtain ⟨c, hc⟩ := NormedField.exists_one_lt_norm K_hat
        refine ⟨⟨algebraMap K_hat F_hat c, hRangeBase ⟨c, rfl⟩⟩, ?_⟩
        change 1 < ‖algebraMap K_hat F_hat c‖
        rwa [hIsoK c] }
  haveI : CompleteSpace ↥K_base := completeSpace_coe_iff_isComplete.mpr hClBase.isComplete

  have hKhat_gal : ∀ (σ : N ≃ₐ[↥K_base] N) (c : K_hat),
      σ (algebraMap K_hat N c) = algebraMap K_hat N c := by
    intro σ c
    rw [hAlgCompat c]
    exact σ.commutes _

  have hKhat_memK' : ∀ c : K_hat, algebraMap K_hat N c ∈ K'_int := by
    intro c
    rw [hAlgCompat c]
    exact K'_int.algebraMap_mem _

  
  
  
  obtain ⟨T₀, hT₀_mem, hT₀_ne, hT₀_irr, hBase_eq⟩ := hType3
  set r : ℝ := ‖T₀‖
  have hr_pos : 0 < r := norm_pos_iff.mpr hT₀_ne
  have hr_ne : r ≠ 0 := ne_of_gt hr_pos

  have hExpUniq : ∀ (c₁ c₂ : K_hat) (k₁ k₂ : ℤ),
      c₁ ≠ 0 → c₂ ≠ 0 → ‖c₁‖ * r ^ k₁ = ‖c₂‖ * r ^ k₂ → k₁ = k₂ := by
    have hNatIrr : ∀ (n : ℕ), 0 < n → ∀ c : K_hat, r ^ n ≠ ‖c‖ := by
      intro n hn c heq
      obtain ⟨d, hd⟩ := IsAlgClosed.exists_pow_nat_eq c hn
      rw [← hd, norm_pow] at heq
      have hrd : r = ‖d‖ := (pow_left_inj₀ (le_of_lt hr_pos) (norm_nonneg d) (ne_of_gt hn)).mp heq
      exact hT₀_irr d hrd
    have hZpowIrr : ∀ (k : ℤ), k ≠ 0 → ∀ c : K_hat, r ^ k ≠ ‖c‖ := by
      intro k hk c heq
      rcases lt_or_gt_of_ne hk with hk_neg | hk_pos
      · set n : ℕ := (-k).toNat
        have hn_eq : (n : ℤ) = -k := Int.toNat_of_nonneg (by omega)
        have hn_pos : 0 < n := by omega
        have hk_eq : k = -(n : ℤ) := by omega
        rw [hk_eq, zpow_neg, zpow_natCast] at heq
        have heq' : r ^ n = ‖c⁻¹‖ := by
          rw [norm_inv, ← heq, inv_inv]
        exact hNatIrr n hn_pos c⁻¹ heq'
      · set n : ℕ := k.toNat
        have hn_eq : (n : ℤ) = k := Int.toNat_of_nonneg (by omega)
        have hn_pos : 0 < n := by omega
        rw [← hn_eq, zpow_natCast] at heq
        exact hNatIrr n hn_pos c heq
    intro c₁ c₂ k₁ k₂ hc₁ hc₂ heq
    by_contra hk_ne
    have hc₁_norm : ‖c₁‖ ≠ 0 := norm_ne_zero_iff.mpr hc₁
    have hrk₂ : r ^ k₂ ≠ 0 := zpow_ne_zero k₂ hr_ne
    have hsub : r ^ (k₁ - k₂) = ‖c₂ / c₁‖ := by
      rw [zpow_sub₀ hr_ne, norm_div, div_eq_div_iff hrk₂ hc₁_norm, mul_comm, heq]
    exact hZpowIrr (k₁ - k₂) (sub_ne_zero.mpr hk_ne) (c₂ / c₁) hsub

  have hBaseValAndRes :
      (∀ u ∈ K_base, u ≠ 0 → ∃ (c : K_hat) (m : ℤ), c ≠ 0 ∧ ‖u‖ = ‖c‖ * r ^ m) ∧
      (∀ u : ↥K_base, ‖u‖ ≤ 1 →
        ∃ c : K_hat, ‖c‖ ≤ 1 ∧ ‖algebraMap ↥K_base N u - algebraMap K_hat N c‖ < 1) := by
    have hPolyMax : ∀ (P : Polynomial K_hat), P ≠ 0 →
        ∃ j₀ ∈ P.support,
          ‖Polynomial.aeval T₀ P‖ = ‖P.coeff j₀‖ * r ^ j₀ ∧
          Polynomial.aeval T₀ P ≠ 0 ∧
          ∀ i : ℕ, ‖P.coeff i‖ * r ^ i ≤ ‖Polynomial.aeval T₀ P‖ := by
      intro P hP
      let term : ℕ → F_hat := fun i => algebraMap K_hat F_hat (P.coeff i) * T₀ ^ i
      have hsum_eq : Polynomial.aeval T₀ P = ∑ i ∈ P.support, term i := by
        rw [Polynomial.aeval_def, Polynomial.eval₂_def, Polynomial.sum_def]
      have hterm_norm : ∀ i : ℕ, ‖term i‖ = ‖P.coeff i‖ * r ^ i := by
        intro i
        dsimp [term]
        rw [norm_mul, hIsoK, norm_pow]
      have hDist : ∀ i ∈ P.support, ∀ j ∈ P.support, i ≠ j → ‖term i‖ ≠ ‖term j‖ := by
        intro i hi j hj hij hnorm_eq
        rw [hterm_norm i, hterm_norm j, ← zpow_natCast r i, ← zpow_natCast r j] at hnorm_eq
        have hci : P.coeff i ≠ 0 := Polynomial.mem_support_iff.mp hi
        have hcj : P.coeff j ≠ 0 := Polynomial.mem_support_iff.mp hj
        exact hij (Nat.cast_injective (hExpUniq (P.coeff i) (P.coeff j) (i : ℤ) (j : ℤ) hci hcj hnorm_eq))
      obtain ⟨j₀, hj₀, hmax_eq, hmax_le⟩ :=
        hUltraMaxSum P.support term (Polynomial.support_nonempty.mpr hP) hDist
      have haeval_norm : ‖Polynomial.aeval T₀ P‖ = ‖P.coeff j₀‖ * r ^ j₀ := by
        rw [hsum_eq, hmax_eq, hterm_norm]
      have hc_ne : P.coeff j₀ ≠ 0 := Polynomial.mem_support_iff.mp hj₀
      have haeval_pos : 0 < ‖Polynomial.aeval T₀ P‖ := by
        rw [haeval_norm]
        exact mul_pos (norm_pos_iff.mpr hc_ne) (pow_pos hr_pos j₀)
      refine ⟨j₀, hj₀, haeval_norm, norm_pos_iff.mp haeval_pos, ?_⟩
      intro i
      by_cases hi : P.coeff i = 0
      · rw [hi, norm_zero, zero_mul]
        exact norm_nonneg _
      · have hi_mem : i ∈ P.support := Polynomial.mem_support_iff.mpr hi
        have hle := hmax_le i hi_mem
        rwa [hterm_norm i, hterm_norm j₀, ← haeval_norm] at hle
    have hPolyCoeffLe : ∀ (P : Polynomial K_hat) (i : ℕ),
        ‖P.coeff i‖ * r ^ i ≤ ‖Polynomial.aeval T₀ P‖ := by
      intro P i
      by_cases hP : P = 0
      · simp [hP]
      · obtain ⟨_, _, _, _, hle⟩ := hPolyMax P hP
        exact hle i
    let E_sub : Subfield F_hat :=
      { carrier := { x : F_hat | ∃ P Q : Polynomial K_hat, Q ≠ 0 ∧ x = Polynomial.aeval T₀ P / Polynomial.aeval T₀ Q }
        mul_mem' := by
          rintro _ _ ⟨P₁, Q₁, hQ₁, rfl⟩ ⟨P₂, Q₂, hQ₂, rfl⟩
          exact ⟨P₁ * P₂, Q₁ * Q₂, mul_ne_zero hQ₁ hQ₂, by rw [map_mul, map_mul, div_mul_div_comm]⟩
        one_mem' := ⟨1, 1, one_ne_zero, by simp⟩
        add_mem' := by
          rintro _ _ ⟨P₁, Q₁, hQ₁, rfl⟩ ⟨P₂, Q₂, hQ₂, rfl⟩
          obtain ⟨_, _, _, hQ₁_ev, _⟩ := hPolyMax Q₁ hQ₁
          obtain ⟨_, _, _, hQ₂_ev, _⟩ := hPolyMax Q₂ hQ₂
          refine ⟨P₁ * Q₂ + P₂ * Q₁, Q₁ * Q₂, mul_ne_zero hQ₁ hQ₂, ?_⟩
          rw [div_add_div _ _ hQ₁_ev hQ₂_ev]
          simp only [map_add, map_mul]
          ring
        zero_mem' := ⟨0, 1, one_ne_zero, by simp⟩
        neg_mem' := by
          rintro _ ⟨P, Q, hQ, rfl⟩
          exact ⟨-P, Q, hQ, by rw [map_neg, neg_div]⟩
        inv_mem' := by
          rintro _ ⟨P, Q, hQ, rfl⟩
          by_cases hP : P = 0
          · exact ⟨0, 1, one_ne_zero, by simp [hP]⟩
          · exact ⟨Q, P, hP, by rw [inv_div]⟩ }
    let E_if : IntermediateField K_hat F_hat :=
      { E_sub with
        algebraMap_mem' := fun c => ⟨Polynomial.C c, 1, one_ne_zero, by simp⟩ }
    have hT₀_E : T₀ ∈ E_if := ⟨Polynomial.X, 1, one_ne_zero, by simp⟩
    let S_T₀ : Subfield F_hat := (IntermediateField.adjoin K_hat ({T₀} : Set F_hat)).toSubfield
    have hST₀_le : S_T₀ ≤ E_if.toSubfield :=
      IntermediateField.adjoin_le_iff.mpr (Set.singleton_subset_iff.mpr hT₀_E)
    refine ⟨?_, ?_⟩
    · intro u hu hu_ne
      have hu_cl : u ∈ closure (S_T₀ : Set F_hat) := by
        rw [hBase_eq] at hu
        exact hu
      obtain ⟨s, hs_mem, hs_dist⟩ := Metric.mem_closure_iff.mp hu_cl ‖u‖ (norm_pos_iff.mpr hu_ne)
      rw [dist_eq_norm] at hs_dist
      have hus_norm : ‖u‖ = ‖s‖ := hUltraEq u s hs_dist
      have hs_ne : s ≠ 0 := by
        intro hs0
        rw [hs0, norm_zero] at hus_norm
        exact hu_ne (norm_eq_zero.mp hus_norm)
      obtain ⟨P, Q, hQ, hs_eq⟩ := hST₀_le hs_mem
      have hP : P ≠ 0 := by
        intro hP0
        apply hs_ne
        simp [hs_eq, hP0]
      obtain ⟨i₁, hi₁, hP_norm, _, _⟩ := hPolyMax P hP
      obtain ⟨i₂, hi₂, hQ_norm, _, _⟩ := hPolyMax Q hQ
      have hc₁ : P.coeff i₁ ≠ 0 := Polynomial.mem_support_iff.mp hi₁
      have hc₂ : Q.coeff i₂ ≠ 0 := Polynomial.mem_support_iff.mp hi₂
      refine ⟨P.coeff i₁ / Q.coeff i₂, (i₁ : ℤ) - (i₂ : ℤ), div_ne_zero hc₁ hc₂, ?_⟩
      rw [hus_norm, hs_eq, norm_div, hP_norm, hQ_norm, norm_div, zpow_sub₀ hr_ne,
        zpow_natCast, zpow_natCast, div_mul_div_comm]
    · intro u hu_le
      have hu_cl : (u : F_hat) ∈ closure (S_T₀ : Set F_hat) :=
        (Set.ext_iff.mp (congrArg SetLike.coe hBase_eq) (u : F_hat)).mp u.2
      obtain ⟨s, hs_mem, hs_dist⟩ := Metric.mem_closure_iff.mp hu_cl (1 / 2 : ℝ) (by norm_num)
      rw [dist_eq_norm] at hs_dist
      have hus_lt1 : ‖(u : F_hat) - s‖ < 1 := by linarith
      have hs_le1 : ‖s‖ ≤ 1 := by
        have hs_eq' : (u : F_hat) + -((u : F_hat) - s) = s := by ring
        have hmax : ‖s‖ ≤ max ‖(u : F_hat)‖ ‖-((u : F_hat) - s)‖ := by
          simpa only [hs_eq'] using IsUltrametricDist.norm_add_le_max (u : F_hat) (-((u : F_hat) - s))
        rw [norm_neg] at hmax
        exact hmax.trans (max_le hu_le (le_of_lt hus_lt1))
      obtain ⟨P, Q, hQ, hs_eq⟩ := hST₀_le hs_mem
      obtain ⟨j₀, hj₀, hQ_norm, hQ_ev_ne, hQ_le⟩ := hPolyMax Q hQ
      set b₀ : K_hat := Q.coeff j₀
      have hb₀_ne : b₀ ≠ 0 := Polynomial.mem_support_iff.mp hj₀
      have hb₀_pos : 0 < ‖b₀‖ := norm_pos_iff.mpr hb₀_ne
      have hQ_pos : 0 < ‖Polynomial.aeval T₀ Q‖ := norm_pos_iff.mpr hQ_ev_ne
      have hP_ev_le : ‖Polynomial.aeval T₀ P‖ ≤ ‖b₀‖ * r ^ j₀ := by
        rw [hs_eq, norm_div] at hs_le1
        have h1 := (div_le_one hQ_pos).mp hs_le1
        rwa [hQ_norm] at h1
      have hP_le : ∀ i : ℕ, ‖P.coeff i‖ * r ^ i ≤ ‖b₀‖ * r ^ j₀ :=
        fun i => (hPolyCoeffLe P i).trans hP_ev_le
      have hStrictLt : ∀ (a : K_hat) (i : ℕ), i ≠ j₀ → ‖a‖ * r ^ i ≤ ‖b₀‖ * r ^ j₀ →
          ‖a‖ * r ^ i < ‖b₀‖ * r ^ j₀ := by
        intro a i hij hle
        refine lt_of_le_of_ne hle (fun heq => ?_)
        have ha_ne : a ≠ 0 := by
          intro ha0
          rw [ha0, norm_zero, zero_mul] at heq
          exact ne_of_gt (mul_pos hb₀_pos (pow_pos hr_pos j₀)) heq.symm
        rw [← zpow_natCast r i, ← zpow_natCast r j₀] at heq
        exact hij (Nat.cast_injective (hExpUniq a b₀ (i : ℤ) (j₀ : ℤ) ha_ne hb₀_ne heq))
      set c : K_hat := P.coeff j₀ / b₀
      have hc_le1 : ‖c‖ ≤ 1 := by
        rw [norm_div, div_le_one hb₀_pos]
        exact le_of_mul_le_mul_right (hP_le j₀) (pow_pos hr_pos j₀)
      let R : Polynomial K_hat := P - Polynomial.C c * Q
      have hR_j₀ : R.coeff j₀ = 0 := by
        dsimp [R, c]
        rw [Polynomial.coeff_sub, Polynomial.coeff_C_mul, div_mul_cancel₀ _ hb₀_ne, sub_self]
      have hR_sum : Polynomial.aeval T₀ R =
          ∑ i ∈ R.support, algebraMap K_hat F_hat (R.coeff i) * T₀ ^ i := by
        rw [Polynomial.aeval_def, Polynomial.eval₂_def, Polynomial.sum_def]
      have hR_lt : ‖Polynomial.aeval T₀ R‖ < ‖Polynomial.aeval T₀ Q‖ := by
        rw [hR_sum]
        refine hUltraSumLt R.support _ ‖Polynomial.aeval T₀ Q‖ hQ_pos (fun i hi => ?_)
        have hij : i ≠ j₀ := by
          intro heq
          subst heq
          exact Polynomial.mem_support_iff.mp hi hR_j₀
        rw [norm_mul, hIsoK, norm_pow, hQ_norm]
        have hRc : R.coeff i = P.coeff i + -(c * Q.coeff i) := by
          dsimp [R]
          rw [Polynomial.coeff_sub, Polynomial.coeff_C_mul, sub_eq_add_neg]
        have hmax : ‖R.coeff i‖ ≤ max ‖P.coeff i‖ ‖c * Q.coeff i‖ := by
          rw [hRc]
          simpa [norm_neg] using IsUltrametricDist.norm_add_le_max (P.coeff i) (-(c * Q.coeff i))
        have hmul_max : ‖R.coeff i‖ * r ^ i ≤ max (‖P.coeff i‖ * r ^ i) (‖c * Q.coeff i‖ * r ^ i) := by
          rcases le_max_iff.mp hmax with h1 | h2
          · exact le_max_of_le_left (mul_le_mul_of_nonneg_right h1 (le_of_lt (pow_pos hr_pos i)))
          · exact le_max_of_le_right (mul_le_mul_of_nonneg_right h2 (le_of_lt (pow_pos hr_pos i)))
        refine hmul_max.trans_lt (max_lt ?_ ?_)
        · exact hStrictLt (P.coeff i) i hij (hP_le i)
        · rw [norm_mul, mul_assoc]
          have hQ_i_lt : ‖Q.coeff i‖ * r ^ i < ‖b₀‖ * r ^ j₀ := by
            have hQi_le : ‖Q.coeff i‖ * r ^ i ≤ ‖b₀‖ * r ^ j₀ := by
              rw [← hQ_norm]
              exact hQ_le i
            exact hStrictLt (Q.coeff i) i hij hQi_le
          exact (mul_le_of_le_one_left (mul_nonneg (norm_nonneg _) (le_of_lt (pow_pos hr_pos i))) hc_le1).trans_lt hQ_i_lt
      have hs_sub : s - algebraMap K_hat F_hat c = Polynomial.aeval T₀ R / Polynomial.aeval T₀ Q := by
        rw [hs_eq, div_sub' hQ_ev_ne]
        congr 1
        dsimp [R]
        rw [map_sub, map_mul, Polynomial.aeval_C, mul_comm]
      have hs_c_lt1 : ‖s - algebraMap K_hat F_hat c‖ < 1 := by
        rw [hs_sub, norm_div, div_lt_one hQ_pos]
        exact hR_lt
      have hu_c_lt1 : ‖(u : F_hat) - algebraMap K_hat F_hat c‖ < 1 := by
        have h_decomp : (u : F_hat) - algebraMap K_hat F_hat c =
            ((u : F_hat) - s) + (s - algebraMap K_hat F_hat c) := by ring
        rw [h_decomp]
        exact (IsUltrametricDist.norm_add_le_max _ _).trans_lt (max_lt hus_lt1 hs_c_lt1)
      refine ⟨c, hc_le1, ?_⟩
      rw [hAlgCompat c, ← map_sub, hIsoBase]
      exact hu_c_lt1

  obtain ⟨hBaseVal, hBaseRes⟩ := hBaseValAndRes

  
  
  
  have hN_res : ∀ z : N, ‖z‖ ≤ 1 → ∃ e ∈ E_max, ‖z - algebraMap K_hat N e‖ < 1 := by
    haveI : Algebra.IsAlgebraic ↥K_base N := Algebra.IsAlgebraic.of_finite ↥K_base N
    have hSpecN : ∀ w : N, ‖w‖ = spectralNorm ↥K_base N w :=
      spectralNorm_unique_field_norm_ext (K := ↥K_base) (L := N)
        (f := NormedField.toAbsoluteValue N) (fun u => hIsoBase u)
    have hMultisetNormProd : ∀ M : Multiset N, ‖M.prod‖ = (M.map (fun x : N => ‖x‖)).prod :=
      fun M => Multiset.induction_on M (by simp) (fun a s ih => by simp [norm_mul, ih])
    intro z hz
    have hInt : IsIntegral ↥K_base z := Algebra.IsIntegral.isIntegral z
    let μ : Polynomial ↥K_base := minpoly ↥K_base z
    have hMonic : μ.Monic := minpoly.monic hInt
    let d : ℕ := μ.natDegree
    have hSpecLe : spectralValue μ ≤ 1 := by
      have h1 : ‖z‖ ≤ 1 := hz
      rw [hSpecN z] at h1
      exact h1
    have hCoeffLe : ∀ i : ℕ, ‖μ.coeff i‖ ≤ 1 :=
      (spectralValue_le_one_iff hMonic).mp hSpecLe
    let c : ℕ → K_hat := fun i => Classical.choose (hBaseRes (μ.coeff i) (hCoeffLe i))
    have hc_spec : ∀ i : ℕ,
        ‖c i‖ ≤ 1 ∧ ‖algebraMap ↥K_base N (μ.coeff i) - algebraMap K_hat N (c i)‖ < 1 :=
      fun i => Classical.choose_spec (hBaseRes (μ.coeff i) (hCoeffLe i))
    let Q_low : Polynomial K_hat := ∑ i ∈ Finset.range d, Polynomial.C (c i) * Polynomial.X ^ i
    let Q : Polynomial K_hat := Polynomial.X ^ d + Q_low
    have hQ_low_deg : Q_low.degree < (d : WithBot ℕ) := by
      rw [Polynomial.degree_lt_iff_coeff_zero]
      intro m hm
      dsimp [Q_low]
      rw [Polynomial.finset_sum_coeff]
      apply Finset.sum_eq_zero
      intro i hi
      rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow]
      have hmi : m ≠ i := by
        have hid : i < d := Finset.mem_range.mp hi
        omega
      simp [hmi]
    have hQ_monic : Q.Monic := Polynomial.monic_X_pow_add hQ_low_deg
    have hμ_expand : μ = Polynomial.X ^ d +
        ∑ i ∈ Finset.range d, Polynomial.C (μ.coeff i) * Polynomial.X ^ i := by
      have h1 := Polynomial.as_sum_range_C_mul_X_pow μ
      change μ = ∑ i ∈ Finset.range (d + 1), Polynomial.C (μ.coeff i) * Polynomial.X ^ i at h1
      rw [Finset.sum_range_succ, Polynomial.coeff_natDegree, hMonic.leadingCoeff,
        map_one, one_mul, add_comm] at h1
      exact h1
    have hμ_aeval : Polynomial.aeval z μ = 0 := minpoly.aeval ↥K_base z
    have hQ_aeval_eq : Polynomial.aeval z Q =
        ∑ i ∈ Finset.range d,
          (algebraMap K_hat N (c i) - algebraMap ↥K_base N (μ.coeff i)) * z ^ i := by
      have h1 : Polynomial.aeval z Q = z ^ d +
          ∑ i ∈ Finset.range d, algebraMap K_hat N (c i) * z ^ i := by
        dsimp [Q, Q_low]
        simp only [map_add, map_pow, Polynomial.aeval_X, map_sum, map_mul, Polynomial.aeval_C]
      have h2 : (0 : N) = z ^ d +
          ∑ i ∈ Finset.range d, algebraMap ↥K_base N (μ.coeff i) * z ^ i := by
        rw [← hμ_aeval]
        conv_lhs => rw [hμ_expand]
        simp only [map_add, map_pow, Polynomial.aeval_X, map_sum, map_mul, Polynomial.aeval_C]
      have h3 : Polynomial.aeval z Q = Polynomial.aeval z Q - 0 := (sub_zero _).symm
      rw [h3, h1, h2, add_sub_add_left_eq_sub, ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [sub_mul]
    have hQ_aeval_lt : ‖Polynomial.aeval z Q‖ < 1 := by
      rw [hQ_aeval_eq]
      refine hUltraSumLt (Finset.range d) _ 1 zero_lt_one (fun i _ => ?_)
      rw [norm_mul, norm_sub_rev, norm_pow]
      have hz_pow : ‖z‖ ^ i ≤ 1 := pow_le_one₀ (norm_nonneg z) hz
      exact (mul_le_of_le_one_right (norm_nonneg _) hz_pow).trans_lt (hc_spec i).2
    have hQ_fac : (Q.roots.map (fun a : K_hat => Polynomial.X - Polynomial.C a)).prod = Q := by
      have h1 := Polynomial.C_leadingCoeff_mul_prod_multiset_X_sub_C
        (@IsAlgClosed.card_roots_eq_natDegree K_hat _ _ Q)
      rwa [hQ_monic.leadingCoeff, map_one, one_mul] at h1
    have hProd_lt : (Q.roots.map (fun a : K_hat => ‖z - algebraMap K_hat N a‖)).prod < 1 := by
      have h_ev : Polynomial.aeval z Q =
          (Q.roots.map (fun a : K_hat => z - algebraMap K_hat N a)).prod := by
        conv_lhs => rw [← hQ_fac]
        rw [map_multiset_prod, Multiset.map_map]
        congr 1
        refine Multiset.map_congr rfl (fun a _ => ?_)
        simp only [Function.comp_apply, map_sub, Polynomial.aeval_X, Polynomial.aeval_C]
      have h_norm : ‖Polynomial.aeval z Q‖ =
          (Q.roots.map (fun a : K_hat => ‖z - algebraMap K_hat N a‖)).prod := by
        rw [h_ev, hMultisetNormProd, Multiset.map_map]
        rfl
      rwa [← h_norm]
    have hExRoot : ∃ γ₀ ∈ Q.roots, ‖z - algebraMap K_hat N γ₀‖ < 1 := by
      by_contra! hAllGe
      have hge1 : (1 : ℝ) ≤ (Q.roots.map (fun a : K_hat => ‖z - algebraMap K_hat N a‖)).prod := by
        apply Multiset.one_le_prod
        intro x hx
        rw [Multiset.mem_map] at hx
        obtain ⟨a, ha, rfl⟩ := hx
        exact hAllGe a ha
      linarith
    obtain ⟨γ₀, _, hγ₀_lt⟩ := hExRoot
    have hγ₀_le : ‖γ₀‖ ≤ 1 := by
      rw [← hIsoN γ₀]
      have h_eq : z + -(z - algebraMap K_hat N γ₀) = algebraMap K_hat N γ₀ := by ring
      have hmax : ‖algebraMap K_hat N γ₀‖ ≤ max ‖z‖ ‖-(z - algebraMap K_hat N γ₀)‖ := by
        simpa only [h_eq] using IsUltrametricDist.norm_add_le_max z (-(z - algebraMap K_hat N γ₀))
      rw [norm_neg] at hmax
      exact hmax.trans (max_le hz (le_of_lt hγ₀_lt))
    obtain ⟨e, he_mem, he_lt⟩ := hE_res γ₀ hγ₀_le
    refine ⟨e, he_mem, ?_⟩
    have h_decomp : z - algebraMap K_hat N e =
        (z - algebraMap K_hat N γ₀) + algebraMap K_hat N (γ₀ - e) := by
      rw [map_sub]
      ring
    rw [h_decomp]
    refine (IsUltrametricDist.norm_add_le_max _ _).trans_lt (max_lt hγ₀_lt ?_)
    rwa [hIsoN]

  
  
  
  have hTameChar :
      ∃ (T'_0 : N) (n_tame : ℕ) (c₁ : K_hat),
        T'_0 ∈ K'_int ∧
        T'_0 ≠ 0 ∧
        0 < n_tame ∧
        Module.finrank ↥K_base ↥K'_int = n_tame ∧
        ‖(n_tame : K_hat)‖ = 1 ∧
        c₁ ≠ 0 ∧
        ‖T'_0 ^ n_tame / (algebraMap K_hat N c₁ * algebraMap ↥K_base N ⟨T₀, hT₀_mem⟩) - 1‖ < 1 := by
    
    have hE_unit_norm : ∀ d : ↥E_max, d ≠ 0 → ‖(d : K_hat)‖ = 1 := by
      intro d hd
      have hd_val : (d : K_hat) ≠ 0 := fun h0 => hd (Subtype.ext h0)
      have hle1 : ‖(d : K_hat)‖ ≤ 1 := hE_norm d.1 d.2
      have hinv_le1 : ‖(d : K_hat)⁻¹‖ ≤ 1 := hE_norm (d.1)⁻¹ (E_max.inv_mem d.2)
      rw [norm_inv] at hinv_le1
      have hpos : 0 < ‖(d : K_hat)‖ := norm_pos_iff.mpr hd_val
      have hge1 : 1 ≤ ‖(d : K_hat)‖ := by
        have h := mul_le_mul_of_nonneg_right hinv_le1 (le_of_lt hpos)
