    have hδ_pos : 0 < ‖δ‖ := norm_pos_iff.mpr hδ_ne
    have h_iter : ∀ j : ℕ, ‖(σ ^ j) δ - δ‖ < ‖δ‖ := by
      intro j
      induction j with
      | zero =>
        change ‖δ - δ‖ < ‖δ‖
        rwa [sub_self, norm_zero]
