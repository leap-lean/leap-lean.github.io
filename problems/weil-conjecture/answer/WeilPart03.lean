      have huniv : (Set.univ : Set ↥Lz) ⊆ {u : ↥Lz | ‖(φ u : F_hat)‖ = ‖(u : F_hat)‖} := by
        rw [← h_iz_dense.closure_eq]
        exact closure_minimal hsub hcl
      exact fun u => huniv (Set.mem_univ u)
    have hφ_err_all : ∀ u : ↥Lz, ‖(u : F_hat) - (φ u : F_hat)‖ ≤ θ * ‖(u : F_hat)‖ := by
      have hcl : IsClosed {u : ↥Lz | ‖(u : F_hat) - (φ u : F_hat)‖ ≤ θ * ‖(u : F_hat)‖} :=
        isClosed_le
          (continuous_norm.comp (continuous_subtype_val.sub hφ_val_cont))
          (continuous_const.mul (continuous_norm.comp continuous_subtype_val))
      have hsub : Set.range iz ⊆ {u : ↥Lz | ‖(u : F_hat) - (φ u : F_hat)‖ ≤ θ * ‖(u : F_hat)‖} := by
        rintro _ ⟨u, rfl⟩
        change ‖((iz u : ↥Lz) : F_hat) - ((φ_hom (iz u) : ↥Lz') : F_hat)‖ ≤
          θ * ‖((iz u : ↥Lz) : F_hat)‖
        rw [hφ_on u]
        exact hφ₀_err u
      have huniv : (Set.univ : Set ↥Lz) ⊆
          {u : ↥Lz | ‖(u : F_hat) - (φ u : F_hat)‖ ≤ θ * ‖(u : F_hat)‖} := by
        rw [← h_iz_dense.closure_eq]
        exact closure_minimal hsub hcl
      exact fun u => huniv (Set.mem_univ u)
    exact ⟨φ, hφ_norm_all, hφ_err_all⟩
