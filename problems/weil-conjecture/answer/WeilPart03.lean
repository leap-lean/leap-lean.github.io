    obtain ⟨M, ιP, hCl_ιP, hιP_comm⟩ := hMod'.2.2.2.2.2.1
    obtain ⟨Γ, hCl_Γ, _, hΓ_snd⟩ :=
      weil_proper_modification_projective_graph_closedImmersion K V M C' g' ιP U' U_ss g_ss h_mod
        hMod'.2.2.1 hCl_ιP hιP_comm hSS.2.2.1 hProp_mod hComm_mod
    let y : U'.toScheme := ψ_U'.base mW
    let L_y : Type u := IsLocalRing.ResidueField ↥W
    letI : Field L_y := inferInstanceAs (Field (IsLocalRing.ResidueField ↥W))
    let res_W : ↥W →+* L_y := IsLocalRing.residue ↥W
    let φ_UL : ↑(U'.toScheme.presheaf.obj (Opposite.op U)) →+* L_y := res_W.comp φ_U.hom
    have hqy_eq : hU.primeIdealOf ⟨y, hyU⟩ = (AlgebraicGeometry.Spec.map φ_U).base mW := by
