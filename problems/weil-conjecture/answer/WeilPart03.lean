              (Finset.sum_filter_add_sum_filter_not S (fun i => isZero i = true) _).symm
            obtain ⟨r_none, hr_none⟩ := hPowRoot p hp.pos (g none)
            let z : ↥L1_coeff := if none ∈ S_pos then r_none • (1 : ↥L1_coeff) else 0
            have hS_pos_eq : (∑ i ∈ S_pos, g i • fam i) = z ^ p := by
              have hsub_none : S_pos ⊆ {none} := by
                intro i hi
                rcases Finset.mem_filter.mp hi with ⟨hiS, hnot0⟩
                have hle0 : lvl i ≤ 0 := hlvl i hiS
                rcases i with _ | ⟨n, u⟩
                · exact Finset.mem_singleton_self none
                · have hn0 : n = 0 := Nat.le_zero.mp hle0
