  have hDvd1 : ∀ (n : ℕ) (x₀ x₁ : A_nod), x₀ * v ^ n = x₁ * u → ∃ y₀ : A_nod, x₀ = y₀ * u := by
    intro n x₀ x₁ hmul
    obtain ⟨F₀, rfl⟩ := Ideal.Quotient.mk_surjective x₀
    obtain ⟨F₁, rfl⟩ := Ideal.Quotient.mk_surjective x₁
    have hq_mem : F₀ * (MvPolynomial.X 1) ^ n - F₁ * MvPolynomial.X 0 ∈ I_a :=
      Ideal.Quotient.eq.mp hmul
    obtain ⟨Q, hQ⟩ := Ideal.mem_span_singleton.mp hq_mem
    let ε : MvPolynomial (Fin 2) R →+* Polynomial R :=
      MvPolynomial.eval₂Hom Polynomial.C
        (fun i : Fin 2 => if i = 0 then 0 else Polynomial.X)
    have hε_eq : ε F₀ * Polynomial.X ^ n = Polynomial.C a * (-ε Q) := by
      have hε_sub := congrArg ε hQ
      have hε_X0 : ε (MvPolynomial.X 0) = 0 := by simp [ε]
      have hε_X1 : ε (MvPolynomial.X 1) = Polynomial.X := by simp [ε]
      have hε_g : ε g_a = -Polynomial.C a := by
        change ε (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a) = -Polynomial.C a
        simp [ε]
      rw [map_sub, map_mul, map_pow, map_mul, map_mul, hε_X0, hε_X1, hε_g] at hε_sub
      linear_combination hε_sub
    have hShift : ∀ (m : ℕ) (S : Polynomial R),
        ε F₀ * Polynomial.X ^ m = Polynomial.C a * S →
        ∃ H : Polynomial R, ε F₀ = Polynomial.C a * H := by
      intro m
      induction m with
      | zero =>
        intro S hS
        exact ⟨S, by simpa using hS⟩
      | succ m ih =>
        intro S hS
        refine ih S.divX ?_
        apply Polynomial.ext
        intro k
        calc
          (ε F₀ * Polynomial.X ^ m).coeff k
              = (ε F₀ * Polynomial.X ^ m * Polynomial.X).coeff (k + 1) :=
                (Polynomial.coeff_mul_X (ε F₀ * Polynomial.X ^ m) k).symm
          _ = (ε F₀ * Polynomial.X ^ (m + 1)).coeff (k + 1) := by rw [pow_succ, mul_assoc]
          _ = (Polynomial.C a * S).coeff (k + 1) := by rw [hS]
          _ = a * S.coeff (k + 1) := Polynomial.coeff_C_mul _
          _ = a * S.divX.coeff k := by rw [Polynomial.coeff_divX]
          _ = (Polynomial.C a * S.divX).coeff k := (Polynomial.coeff_C_mul _).symm
    obtain ⟨H, hH⟩ := hShift n (-ε Q) hε_eq
    have hDecomp0 : ∀ F : MvPolynomial (Fin 2) R,
        ∃ G : MvPolynomial (Fin 2) R, F = G * MvPolynomial.X 0 + ι₁ (ε F) := by
      intro F
      induction F using MvPolynomial.induction_on with
      | C r =>
        refine ⟨0, ?_⟩
        simp [ι₁, ε]
      | add p q ihp ihq =>
        obtain ⟨Gp, hp⟩ := ihp
        obtain ⟨Gq, hq⟩ := ihq
        refine ⟨Gp + Gq, ?_⟩
        conv_lhs => rw [hp, hq]
        rw [map_add, map_add]
        ring
      | mul_X p i ihp =>
        obtain ⟨Gp, hp⟩ := ihp
        have hi01 : i = 0 ∨ i = 1 := by fin_cases i <;> simp
        rcases hi01 with rfl | rfl
        · refine ⟨p, ?_⟩
          have hε0 : ε (p * MvPolynomial.X 0) = 0 := by simp [ε]
          rw [hε0, map_zero, add_zero]
        · refine ⟨Gp * MvPolynomial.X 1, ?_⟩
          have hε1 : ι₁ (ε (p * MvPolynomial.X 1)) = ι₁ (ε p) * MvPolynomial.X 1 := by
            simp [ε, ι₁]
          rw [hε1]
          conv_lhs => rw [hp]
          ring
    obtain ⟨G, hG⟩ := hDecomp0 F₀
    have hCa_uv : π (MvPolynomial.C a) = u * v := by
      have hg0 : π g_a = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hg_mem
      change π (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a) = 0 at hg0
      rw [map_sub, map_mul, sub_eq_zero] at hg0
      exact hg0.symm
    refine ⟨π G + v * π (ι₁ H), ?_⟩
    have hF₀_eq : F₀ = G * MvPolynomial.X 0 + MvPolynomial.C a * ι₁ H := by
      rw [hG, hH, map_mul]
      have hι₁C : ι₁ (Polynomial.C a) = MvPolynomial.C a := by simp [ι₁]
      rw [hι₁C]
    change π F₀ = (π G + v * π (ι₁ H)) * u
    rw [hF₀_eq, map_add, map_mul, map_mul, hCa_uv]
    change π G * u + (u * v) * π (ι₁ H) = (π G + v * π (ι₁ H)) * u
    ring
  have hDvdN : ∀ (n₀ n₁ : ℕ) (x₀ x₁ : A_nod),
      x₀ * v ^ n₁ = x₁ * u ^ n₀ → ∃ y : A_nod, x₀ = y * u ^ n₀ := by
    intro n₀
    induction n₀ with
    | zero =>
      intro n₁ x₀ x₁ _
      exact ⟨x₀, by simp⟩
    | succ n₀ ih =>
      intro n₁ x₀ x₁ hmul
      have hmul' : x₀ * v ^ n₁ = (x₁ * u ^ n₀) * u := by
        simpa only [pow_succ, mul_assoc] using hmul
      obtain ⟨y₀, hy₀⟩ := hDvd1 n₁ x₀ (x₁ * u ^ n₀) hmul'
      have hy₀_eq : y₀ * v ^ n₁ = x₁ * u ^ n₀ := by
        apply mul_right_cancel₀ hu_ne
        calc
          (y₀ * v ^ n₁) * u = (y₀ * u) * v ^ n₁ := by ring
          _ = x₀ * v ^ n₁ := by rw [← hy₀]
          _ = (x₁ * u ^ n₀) * u := hmul'
      obtain ⟨y, hy⟩ := ih n₁ y₀ x₁ hy₀_eq
      exact ⟨y, by rw [hy₀, hy, pow_succ, mul_assoc]⟩
  have hTwoChart : ∀ (B : Type u) [CommRing B] [IsDomain B] (u_B v_B : B),
      u_B ≠ 0 → v_B ≠ 0 →
      IsIntegrallyClosed (Localization (Submonoid.powers u_B)) →
      IsIntegrallyClosed (Localization (Submonoid.powers v_B)) →
      (∀ (n₀ n₁ : ℕ) (x₀ x₁ : B), x₀ * v_B ^ n₁ = x₁ * u_B ^ n₀ → ∃ y : B, x₀ = y * u_B ^ n₀) →
      IsIntegrallyClosed B := by
    intro B _ _ u_B v_B hu_B hv_B hIC_uB hIC_vB hDvd_B
    let S : Fin 2 → Submonoid B :=
      fun i => if i = 0 then Submonoid.powers u_B else Submonoid.powers v_B
    have hS : ∀ i : Fin 2, S i ≤ nonZeroDivisors B := by
      intro i
      fin_cases i
      · exact Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hu_B)
      · exact Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hv_B)
    apply IsIntegrallyClosed.of_localization_submonoid S hS
    · intro i
      fin_cases i
      · exact hIC_uB
      · exact hIC_vB
    · rw [eq_bot_iff]
      intro z hz
      rw [Algebra.mem_iInf] at hz
      have hz0 := hz 0
      have hz1 := hz 1
      let Sub₀ := Localization.subalgebra (FractionRing B) (S 0) (hS 0)
      let Sub₁ := Localization.subalgebra (FractionRing B) (S 1) (hS 1)
      obtain ⟨⟨x₀, s₀⟩, hx₀⟩ := IsLocalization.surj (S 0) (⟨z, hz0⟩ : ↥Sub₀)
      obtain ⟨⟨x₁, s₁⟩, hx₁⟩ := IsLocalization.surj (S 1) (⟨z, hz1⟩ : ↥Sub₁)
      obtain ⟨n₀, hn₀⟩ := s₀.2
      obtain ⟨n₁, hn₁⟩ := s₁.2
      dsimp [S] at hn₀ hn₁
      have hz0_eq : z * algebraMap B (FractionRing B) (u_B ^ n₀) =
          algebraMap B (FractionRing B) x₀ := by
        have hval : z * algebraMap B (FractionRing B) s₀.1 =
            algebraMap B (FractionRing B) x₀ := congrArg Subtype.val hx₀
        rw [← hn₀] at hval
        exact hval
      have hz1_eq : z * algebraMap B (FractionRing B) (v_B ^ n₁) =
          algebraMap B (FractionRing B) x₁ := by
        have hval : z * algebraMap B (FractionRing B) s₁.1 =
            algebraMap B (FractionRing B) x₁ := congrArg Subtype.val hx₁
        rw [← hn₁] at hval
        exact hval
      have hcross_frac : algebraMap B (FractionRing B) (x₀ * v_B ^ n₁) =
          algebraMap B (FractionRing B) (x₁ * u_B ^ n₀) := by
        calc
          algebraMap B (FractionRing B) (x₀ * v_B ^ n₁)
              = algebraMap B (FractionRing B) x₀ *
                  algebraMap B (FractionRing B) (v_B ^ n₁) := map_mul _ _ _
          _ = (z * algebraMap B (FractionRing B) (u_B ^ n₀)) *
                algebraMap B (FractionRing B) (v_B ^ n₁) := by rw [← hz0_eq]
          _ = (z * algebraMap B (FractionRing B) (v_B ^ n₁)) *
                algebraMap B (FractionRing B) (u_B ^ n₀) := by ring
          _ = algebraMap B (FractionRing B) x₁ *
                algebraMap B (FractionRing B) (u_B ^ n₀) := by rw [hz1_eq]
          _ = algebraMap B (FractionRing B) (x₁ * u_B ^ n₀) := (map_mul _ _ _).symm
      have hcross : x₀ * v_B ^ n₁ = x₁ * u_B ^ n₀ :=
        IsFractionRing.injective B (FractionRing B) hcross_frac
      obtain ⟨y, hy⟩ := hDvd_B n₀ n₁ x₀ x₁ hcross
      have hu_pow_ne : algebraMap B (FractionRing B) (u_B ^ n₀) ≠ 0 := by
        intro h0
        apply pow_ne_zero n₀ hu_B
        exact IsFractionRing.injective B (FractionRing B)
          (h0.trans (map_zero _).symm)
      have hzy : z = algebraMap B (FractionRing B) y := by
        apply mul_right_cancel₀ hu_pow_ne
        rw [hz0_eq, hy, map_mul]
      exact Algebra.mem_bot.mpr ⟨y, hzy.symm⟩
  exact ⟨hDom_A, @hTwoChart A_nod inferInstance hDom_A u v hu_ne hv_ne hIC_u hIC_v hDvdN⟩

theorem weil_etale_domain_over_integrallyClosed_isIntegrallyClosed (A₀ B : Type u) [CommRing A₀] [IsDomain A₀] [IsIntegrallyClosed A₀]
    [CommRing B] [IsDomain B] [Algebra A₀ B] [Algebra.Etale A₀ B] :
    IsIntegrallyClosed B :=
by
  have hStep2 : ∀ (q : Ideal B) [q.IsPrime],
      let p : Ideal A₀ := q.under A₀
      let A₁ : Type u := Localization.AtPrime p
      let B_q : Type u := Localization.AtPrime q
      letI : q.LiesOver p := ⟨rfl⟩
      letI : Algebra A₁ B_q := Localization.AtPrime.algebraOfLiesOver p q
      Algebra.FormallyUnramified A₁ B_q ∧
      IsLocalHom (algebraMap A₁ B_q) ∧
      Module.IsTorsionFree A₁ B_q ∧
      Algebra.IsSeparable (IsLocalRing.ResidueField A₁) (IsLocalRing.ResidueField B_q) ∧
      Ideal.map (algebraMap A₁ B_q) (IsLocalRing.maximalIdeal A₁) = IsLocalRing.maximalIdeal B_q ∧
      ∃ (R₁ : Subalgebra A₁ B_q),
        Module.Finite A₁ ↥R₁ ∧
        Algebra.IsIntegral A₁ ↥R₁ ∧
        IsLocalization (Ideal.comap (algebraMap ↥R₁ B_q) (IsLocalRing.maximalIdeal B_q)).primeCompl B_q := by
    classical
    intro q _ p A₁ B_q
    letI : q.LiesOver p := ⟨rfl⟩
    letI : Algebra A₁ B_q := Localization.AtPrime.algebraOfLiesOver p q
    haveI : IsScalarTower A₀ A₁ B_q := inferInstance
    have hLocHom : IsLocalHom (algebraMap A₁ B_q) := inferInstance
    have hTF : Module.IsTorsionFree A₁ B_q := by
      rw [Module.isTorsionFree_iff_algebraMap_injective]
      haveI : Module.Flat A₀ B := inferInstance
      haveI : Module.IsTorsionFree A₀ B := inferInstance
      have hinj_A₀B : Function.Injective (algebraMap A₀ B) :=
        (Module.isTorsionFree_iff_algebraMap_injective (R := A₀) (A := B)).mp inferInstance
      have hinj_BBq : Function.Injective (algebraMap B B_q) :=
        IsLocalization.injective B_q q.primeCompl_le_nonZeroDivisors
      intro z₁ z₂ hz
      suffices h0 : ∀ z : A₁, algebraMap A₁ B_q z = 0 → z = 0 by
        exact sub_eq_zero.mp (h0 (z₁ - z₂) (by rw [map_sub, hz, sub_self]))
      intro z hz0
      obtain ⟨⟨a, s⟩, hzs⟩ := IsLocalization.surj p.primeCompl z
      have ha0 : algebraMap B B_q (algebraMap A₀ B a) = 0 := by
        calc
          algebraMap B B_q (algebraMap A₀ B a)
              = algebraMap A₀ B_q a := (IsScalarTower.algebraMap_apply A₀ B B_q a).symm
          _ = algebraMap A₁ B_q (algebraMap A₀ A₁ a) := IsScalarTower.algebraMap_apply A₀ A₁ B_q a
          _ = algebraMap A₁ B_q (z * algebraMap A₀ A₁ s.1) := by rw [← hzs]
          _ = algebraMap A₁ B_q z * algebraMap A₁ B_q (algebraMap A₀ A₁ s.1) := map_mul _ _ _
          _ = 0 := by rw [hz0, zero_mul]
      have haB : algebraMap A₀ B a = 0 := hinj_BBq (ha0.trans (map_zero _).symm)
      have ha : a = 0 := hinj_A₀B (haB.trans (map_zero _).symm)
      have hzs0 : z * algebraMap A₀ A₁ s.1 = 0 := by simpa [ha] using hzs
      exact (IsLocalization.map_units A₁ s).mul_left_eq_zero.mp hzs0
    haveI : Algebra.FormallyUnramified B B_q :=
      Algebra.FormallyUnramified.of_isLocalization q.primeCompl
    haveI : Algebra.FormallyUnramified A₀ B_q :=
      Algebra.FormallyUnramified.comp A₀ B B_q
    have hUnram : Algebra.FormallyUnramified A₁ B_q :=
      Algebra.FormallyUnramified.localization_base p.primeCompl
    obtain ⟨G, hG⟩ := (inferInstance : Algebra.FiniteType A₀ B).out
    let ιB : B →+* B_q := algebraMap B B_q
    haveI : Algebra.EssFiniteType A₁ B_q := by
      rw [Algebra.essFiniteType_iff]
      refine ⟨G.image ιB, ?_⟩
      have hB_le : ∀ b : B, ιB b ∈ Algebra.adjoin A₁ (↑(G.image ιB) : Set B_q) := by
        intro b
        have hb_top : b ∈ Algebra.adjoin A₀ (↑G : Set B) := by rw [hG]; trivial
        refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hb_top
        · intro x hx
          exact Algebra.subset_adjoin (Finset.mem_coe.mpr (Finset.mem_image_of_mem ιB hx))
        · intro a
          have h_eq : ιB (algebraMap A₀ B a) = algebraMap A₁ B_q (algebraMap A₀ A₁ a) := by
            rw [← IsScalarTower.algebraMap_apply A₀ B B_q a,
              IsScalarTower.algebraMap_apply A₀ A₁ B_q a]
          rw [h_eq]
          exact Subalgebra.algebraMap_mem _ _
        · intro x₁ x₂ _ _ h1 h2; rw [map_add]; exact Subalgebra.add_mem _ h1 h2
        · intro x₁ x₂ _ _ h1 h2; rw [map_mul]; exact Subalgebra.mul_mem _ h1 h2
      intro s
      obtain ⟨⟨u, v⟩, hsv⟩ := IsLocalization.surj q.primeCompl s
      refine ⟨ιB v.1, hB_le v.1, IsLocalization.map_units B_q v, ?_⟩
      have hsv' : s * ιB v.1 = ιB u := hsv
      rw [hsv']
      exact hB_le u
    obtain ⟨hSep, hMax⟩ :=
      (Algebra.FormallyUnramified.iff_map_maximalIdeal_eq (R := A₁) (S := B_q)).mp hUnram
    refine ⟨hUnram, hLocHom, hTF, hSep, hMax, ?_⟩
    have hZMT : Algebra.ZariskisMainProperty A₀ q :=
      Algebra.ZariskisMainProperty.of_finiteType (R := A₀) q
    obtain ⟨r, hr_not_q, hr_int, hr_mul⟩ := Algebra.zariskisMainProperty_iff.mp hZMT
    choose m hm using hr_mul
    let S_gen : Finset B_q := insert (ιB r) (G.image (fun b => ιB (r ^ m b * b)))
    let R₁ : Subalgebra A₁ B_q := Algebra.adjoin A₁ (S_gen : Set B_q)
    have hR₁_le_ic : R₁ ≤ integralClosure A₁ B_q := by
      rw [Algebra.adjoin_le_iff]
      intro w hw
      change IsIntegral A₁ w
      have hw_fin : w ∈ S_gen := hw
      rcases Finset.mem_insert.mp hw_fin with rfl | hw_img
      · have hrB : IsIntegral A₀ (ιB r) := hr_int.map (IsScalarTower.toAlgHom A₀ B B_q)
        exact hrB.tower_top
      · obtain ⟨b, _, rfl⟩ := Finset.mem_image.mp hw_img
        have hbB : IsIntegral A₀ (ιB (r ^ m b * b)) := (hm b).map (IsScalarTower.toAlgHom A₀ B B_q)
        exact hbB.tower_top
    have hIntR₁ : Algebra.IsIntegral A₁ ↥R₁ := by
      constructor
      rintro ⟨x, hx⟩
      obtain ⟨p_int, hp_mon, hp_eval⟩ := (hR₁_le_ic hx : IsIntegral A₁ x)
      refine ⟨p_int, hp_mon, Subtype.ext ?_⟩
      change R₁.val.toRingHom (Polynomial.eval₂ (algebraMap A₁ ↥R₁) ⟨x, hx⟩ p_int) = 0
      rw [Polynomial.hom_eval₂]
      exact hp_eval
    haveI : Algebra.IsIntegral A₁ ↥R₁ := hIntR₁
    haveI : Algebra.FiniteType A₁ ↥R₁ := Algebra.FiniteType.adjoin_of_finite S_gen.finite_toSet
    have hFinR₁ : Module.Finite A₁ ↥R₁ := Algebra.IsIntegral.finite
    have hr_mem : ιB r ∈ R₁ := Algebra.subset_adjoin (Finset.mem_insert_self _ _)
    have hMulMem : ∀ x : B, ∃ M : ℕ, (ιB r) ^ M * ιB x ∈ R₁ := by
      intro x
      have hx_top : x ∈ Algebra.adjoin A₀ (G : Set B) := by rw [hG]; trivial
      refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hx_top
      · intro b hb
        refine ⟨m b, ?_⟩
        have h_eq : (ιB r) ^ m b * ιB b = ιB (r ^ m b * b) := by rw [map_mul, map_pow]
        rw [h_eq]
        exact Algebra.subset_adjoin (Finset.mem_insert_of_mem (Finset.mem_image_of_mem _ hb))
      · intro a
        refine ⟨0, ?_⟩
        simp only [pow_zero, one_mul]
        have h_eq : ιB (algebraMap A₀ B a) = algebraMap A₁ B_q (algebraMap A₀ A₁ a) := by
          rw [← IsScalarTower.algebraMap_apply A₀ B B_q a, IsScalarTower.algebraMap_apply A₀ A₁ B_q a]
        rw [h_eq]
        exact R₁.algebraMap_mem _
      · intro x₁ x₂ _ _ ⟨M₁, hM₁⟩ ⟨M₂, hM₂⟩
        refine ⟨M₁ + M₂, ?_⟩
        have h_eq : (ιB r) ^ (M₁ + M₂) * ιB (x₁ + x₂) =
            (ιB r) ^ M₂ * ((ιB r) ^ M₁ * ιB x₁) + (ιB r) ^ M₁ * ((ιB r) ^ M₂ * ιB x₂) := by
          rw [map_add, pow_add]; ring
        rw [h_eq]
        exact R₁.add_mem (R₁.mul_mem (R₁.pow_mem hr_mem M₂) hM₁)
          (R₁.mul_mem (R₁.pow_mem hr_mem M₁) hM₂)
      · intro x₁ x₂ _ _ ⟨M₁, hM₁⟩ ⟨M₂, hM₂⟩
        refine ⟨M₁ + M₂, ?_⟩
        have h_eq : (ιB r) ^ (M₁ + M₂) * ιB (x₁ * x₂) =
            ((ιB r) ^ M₁ * ιB x₁) * ((ιB r) ^ M₂ * ιB x₂) := by
          rw [map_mul, pow_add]; ring
        rw [h_eq]
        exact R₁.mul_mem hM₁ hM₂
    let q₀ : Ideal ↥R₁ := Ideal.comap (algebraMap ↥R₁ B_q) (IsLocalRing.maximalIdeal B_q)
    refine ⟨R₁, hFinR₁, hIntR₁, ?_⟩
    refine { map_units := ?_, surj := ?_, exists_of_eq := ?_ }
    · intro t
      exact IsLocalRing.notMem_maximalIdeal.mp t.2
    · intro z
      obtain ⟨⟨u, v⟩, hzv⟩ := IsLocalization.surj q.primeCompl z
      obtain ⟨M₁, hM₁⟩ := hMulMem u
      obtain ⟨M₂, hM₂⟩ := hMulMem v.1
      let x₀ : ↥R₁ := ⟨(ιB r) ^ M₂ * ((ιB r) ^ M₁ * ιB u), R₁.mul_mem (R₁.pow_mem hr_mem M₂) hM₁⟩
      let t₀_elem : ↥R₁ := ⟨(ιB r) ^ M₁ * ((ιB r) ^ M₂ * ιB v.1), R₁.mul_mem (R₁.pow_mem hr_mem M₁) hM₂⟩
      have hr_unit : IsUnit (ιB r) := IsLocalization.map_units B_q (⟨r, hr_not_q⟩ : q.primeCompl)
      have hv_unit : IsUnit (ιB v.1) := IsLocalization.map_units B_q v
      have ht₀_unit : IsUnit (algebraMap ↥R₁ B_q t₀_elem) := by
        change IsUnit ((ιB r) ^ M₁ * ((ιB r) ^ M₂ * ιB v.1))
        exact (hr_unit.pow M₁).mul ((hr_unit.pow M₂).mul hv_unit)
      have ht₀_mem : t₀_elem ∈ q₀.primeCompl :=
        IsLocalRing.notMem_maximalIdeal.mpr ht₀_unit
      refine ⟨⟨x₀, ⟨t₀_elem, ht₀_mem⟩⟩, ?_⟩
      change z * ((ιB r) ^ M₁ * ((ιB r) ^ M₂ * ιB v.1)) = (ιB r) ^ M₂ * ((ιB r) ^ M₁ * ιB u)
      have hzv' : z * ιB v.1 = ιB u := hzv
      calc
        z * ((ιB r) ^ M₁ * ((ιB r) ^ M₂ * ιB v.1))
            = (z * ιB v.1) * ((ιB r) ^ M₁ * (ιB r) ^ M₂) := by ring
        _ = ιB u * ((ιB r) ^ M₁ * (ιB r) ^ M₂) := by rw [hzv']
        _ = (ιB r) ^ M₂ * ((ιB r) ^ M₁ * ιB u) := by ring
    · intro x₁ x₂ hx
      exact ⟨1, by simpa using Subtype.ext hx⟩
  have hStep3 : ∀ (A₁ B_q : Type u) [CommRing A₁] [IsDomain A₁] [IsLocalRing A₁]
      [CommRing B_q] [IsDomain B_q] [IsLocalRing B_q]
      [Algebra A₁ B_q] [IsLocalHom (algebraMap A₁ B_q)]
      (_ : Algebra.IsSeparable (IsLocalRing.ResidueField A₁) (IsLocalRing.ResidueField B_q))
      (_ : Ideal.map (algebraMap A₁ B_q) (IsLocalRing.maximalIdeal A₁) = IsLocalRing.maximalIdeal B_q)
      (R₁ : Subalgebra A₁ B_q) (_ : Module.Finite A₁ ↥R₁) (_ : Algebra.IsIntegral A₁ ↥R₁)
      (_ : IsLocalization (Ideal.comap (algebraMap ↥R₁ B_q) (IsLocalRing.maximalIdeal B_q)).primeCompl B_q),
      ∃ (θ : B_q),
        IsIntegral A₁ θ ∧
        IsLocalization
          (Ideal.comap (algebraMap ↥(Algebra.adjoin A₁ ({θ} : Set B_q)) B_q)
            (IsLocalRing.maximalIdeal B_q)).primeCompl B_q := by
    classical
    intro A₁ B_q _ _ _ _ _ _ _ _ hSep hMax R₁ hFin hInt hLoc
    haveI : Module.Finite A₁ ↥R₁ := hFin
    haveI : Algebra.IsIntegral A₁ ↥R₁ := hInt
    let m₁ : Ideal A₁ := IsLocalRing.maximalIdeal A₁
    let κ : Type u := IsLocalRing.ResidueField A₁
    let m_q : Ideal B_q := IsLocalRing.maximalIdeal B_q
    let κ' : Type u := IsLocalRing.ResidueField B_q
    let π : B_q →+* κ' := IsLocalRing.residue B_q
    let q₀ : Ideal ↥R₁ := Ideal.comap (algebraMap ↥R₁ B_q) m_q
    haveI : q₀.IsPrime := Ideal.comap_isPrime (algebraMap ↥R₁ B_q) m_q
    haveI : IsLocalization q₀.primeCompl B_q := hLoc
    have hcomap_q₀ : Ideal.comap (algebraMap A₁ ↥R₁) q₀ = m₁ := by
      have hle : m₁ ≤ Ideal.comap (algebraMap A₁ ↥R₁) q₀ := by
        intro a ha
        change algebraMap A₁ B_q a ∈ m_q
        by_contra hnot
        have hu : IsUnit (algebraMap A₁ B_q a) := IsLocalRing.notMem_maximalIdeal.mp hnot
        have hu_a : IsUnit a := isUnit_of_map_unit (algebraMap A₁ B_q) a hu
        exact (IsLocalRing.notMem_maximalIdeal.mpr hu_a) ha
      exact ((IsLocalRing.maximalIdeal.isMaximal A₁).eq_of_le
        (Ideal.comap_isPrime (algebraMap A₁ ↥R₁) q₀).ne_top hle).symm
    have hq₀_max : q₀.IsMaximal := by
      have hf_int : (algebraMap A₁ ↥R₁).IsIntegral := fun x => Algebra.IsIntegral.isIntegral x
      exact Ideal.isMaximal_of_isIntegral_of_isMaximal_comap' (algebraMap A₁ ↥R₁) hf_int q₀
        (by rw [hcomap_q₀]; exact IsLocalRing.maximalIdeal.isMaximal A₁)
    have hq₀_field : IsField (↥R₁ ⧸ q₀) :=
      (Ideal.Quotient.maximal_ideal_iff_isField_quotient q₀).mp hq₀_max
    let π_alg : ↥R₁ →ₐ[A₁] κ' := (IsScalarTower.toAlgHom A₁ B_q κ').comp R₁.val
    have hπ_surj : Function.Surjective π_alg := by
      intro y
      obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective y
      obtain ⟨⟨x, t⟩, hzt⟩ := IsLocalization.surj q₀.primeCompl z
      have ht_ne : Ideal.Quotient.mk q₀ t.1 ≠ 0 := by
        intro h0
        exact t.2 (Ideal.Quotient.eq_zero_iff_mem.mp h0)
      obtain ⟨w_bar, hw_bar⟩ := hq₀_field.mul_inv_cancel ht_ne
      obtain ⟨w, rfl⟩ := Ideal.Quotient.mk_surjective w_bar
      have htw_sub : 1 - t.1 * w ∈ q₀ := by
        apply Ideal.Quotient.eq_zero_iff_mem.mp
        rw [map_sub, map_one, map_mul, hw_bar, sub_self]
      have hπ_tw : π (t.1.1 * w.1) = 1 := by
        have h0 : π ((1 - t.1 * w : ↥R₁).1) = 0 :=
          (IsLocalRing.residue_eq_zero_iff _).mpr htw_sub
        change π (1 - t.1.1 * w.1) = 0 at h0
        rw [map_sub, map_one, sub_eq_zero] at h0
        exact h0.symm
      refine ⟨x * w, ?_⟩
      change π (x.1 * w.1) = π z
      have hzt' : z * t.1.1 = x.1 := hzt
      calc
        π (x.1 * w.1) = π (z * t.1.1 * w.1) := by rw [← hzt']
        _ = π z * π (t.1.1 * w.1) := by rw [mul_assoc, map_mul]
        _ = π z := by rw [hπ_tw, mul_one]
    haveI : Module.Finite A₁ κ' := Module.Finite.of_surjective π_alg.toLinearMap hπ_surj
    haveI : IsScalarTower A₁ κ κ' := IsScalarTower.of_algebraMap_eq' rfl
    haveI : Module.Finite κ κ' := Module.Finite.of_restrictScalars_finite A₁ κ κ'
    haveI : Algebra.IsSeparable κ κ' := hSep
    let I₁ : Ideal ↥R₁ := Ideal.map (algebraMap A₁ ↥R₁) m₁
    have hI₁_le_q₀ : I₁ ≤ q₀ := Ideal.map_le_iff_le_comap.mpr (le_of_eq hcomap_q₀.symm)
    let F₀ : Type u := ↥R₁ ⧸ I₁
    let q_F : ↥R₁ →+* F₀ := Ideal.Quotient.mk I₁
    let q_F_alg : ↥R₁ →ₐ[A₁] F₀ := Ideal.Quotient.mkₐ A₁ I₁
    have hker_κF₀ : m₁ ≤ RingHom.ker (q_F.comp (algebraMap A₁ ↥R₁)) := by
      intro a ha
      change q_F (algebraMap A₁ ↥R₁ a) = 0
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem _ ha)
    let φ_κF₀ : κ →+* F₀ := Ideal.Quotient.lift m₁ (q_F.comp (algebraMap A₁ ↥R₁)) hker_κF₀
    letI : Algebra κ F₀ := φ_κF₀.toAlgebra
    haveI : IsScalarTower A₁ κ F₀ := IsScalarTower.of_algebraMap_eq' rfl
    haveI : Module.Finite A₁ F₀ :=
      Module.Finite.of_surjective q_F_alg.toLinearMap Ideal.Quotient.mk_surjective
    haveI : Module.Finite κ F₀ := Module.Finite.of_restrictScalars_finite A₁ κ F₀
    haveI : IsNoetherian κ F₀ := IsNoetherian.iff_fg.mpr inferInstance
    let q_bar : Ideal F₀ := Ideal.map q_F q₀
    have hcomap_qbar : Ideal.comap q_F q_bar = q₀ := by
      rw [Ideal.comap_map_of_surjective q_F Ideal.Quotient.mk_surjective]
      exact sup_eq_left.mpr (fun x hx => hI₁_le_q₀ (Ideal.Quotient.eq_zero_iff_mem.mp hx))
    have hqbar_max : q_bar.IsMaximal := by
      rw [Ideal.isMaximal_iff]
      refine ⟨?_, ?_⟩
      · intro h1
        have h1_q₀ : (1 : ↥R₁) ∈ q₀ := (SetLike.ext_iff.mp hcomap_qbar 1).mp h1
        exact hq₀_max.ne_top ((Ideal.eq_top_iff_one q₀).mpr h1_q₀)
      · intro J x hJ hx_not hxJ
        obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective x
        have hr_not : r ∉ q₀ := fun hr => hx_not (Ideal.mem_map_of_mem q_F hr)
        have hsup_top : q₀ ⊔ Ideal.span ({r} : Set ↥R₁) = ⊤ := by
          by_contra hne
          have heq := hq₀_max.eq_of_le hne le_sup_left
          apply hr_not
          rw [heq]
          exact Ideal.mem_sup_right (Ideal.mem_span_singleton_self r)
        have h1_mem : (1 : ↥R₁) ∈ q₀ ⊔ Ideal.span ({r} : Set ↥R₁) := by rw [hsup_top]; trivial
        obtain ⟨u, hu, v, hv, huv⟩ := Submodule.mem_sup.mp h1_mem
        obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton.mp hv
        have h1_F₀ : q_F u + q_F r * q_F c = 1 := by
          rw [← map_mul, ← map_add, huv, map_one]
        rw [← h1_F₀]
        exact J.add_mem (hJ (Ideal.mem_map_of_mem q_F hu)) (J.mul_mem_right (q_F c) hxJ)
    haveI : q_bar.IsPrime := hqbar_max.isPrime
    have hSpanAnn : ∀ y ∈ Ideal.map (algebraMap A₁ B_q) m₁,
        ∃ (t : q₀.primeCompl) (u : ↥R₁), u ∈ I₁ ∧ y * t.1.1 = u.1 := by
      intro y hy
      refine Submodule.span_induction ?_ ?_ ?_ ?_ hy
      · rintro _ ⟨a, ha, rfl⟩
        refine ⟨1, algebraMap A₁ ↥R₁ a, Ideal.mem_map_of_mem _ ha, ?_⟩
        simp
      · exact ⟨1, 0, I₁.zero_mem, by simp⟩
      · rintro y₁ y₂ _ _ ⟨t₁, u₁, hu₁, hy₁⟩ ⟨t₂, u₂, hu₂, hy₂⟩
        refine ⟨t₁ * t₂, t₂.1 * u₁ + t₁.1 * u₂,
          I₁.add_mem (I₁.mul_mem_left _ hu₁) (I₁.mul_mem_left _ hu₂), ?_⟩
        change (y₁ + y₂) * (t₁.1.1 * t₂.1.1) = t₂.1.1 * u₁.1 + t₁.1.1 * u₂.1
        calc
          (y₁ + y₂) * (t₁.1.1 * t₂.1.1)
              = t₂.1.1 * (y₁ * t₁.1.1) + t₁.1.1 * (y₂ * t₂.1.1) := by ring
          _ = t₂.1.1 * u₁.1 + t₁.1.1 * u₂.1 := by rw [hy₁, hy₂]
      · rintro z y₁ _ ⟨t₁, u₁, hu₁, hy₁⟩
        obtain ⟨⟨x_z, t_z⟩, hzt⟩ := IsLocalization.surj q₀.primeCompl z
        refine ⟨t_z * t₁, x_z * u₁, I₁.mul_mem_left _ hu₁, ?_⟩
        change (z • y₁) * (t_z.1.1 * t₁.1.1) = x_z.1 * u₁.1
        have hzt' : z * t_z.1.1 = x_z.1 := hzt
        calc
          (z * y₁) * (t_z.1.1 * t₁.1.1)
              = (z * t_z.1.1) * (y₁ * t₁.1.1) := by ring
          _ = x_z.1 * u₁.1 := by rw [hzt', hy₁]
    have hSingleAnn : ∀ z ∈ q_bar, ∃ s : F₀, s ∉ q_bar ∧ s * z = 0 := by
      intro z hz
      obtain ⟨w, rfl⟩ := Ideal.Quotient.mk_surjective z
      have hw_q₀ : w ∈ q₀ := (SetLike.ext_iff.mp hcomap_qbar w).mp hz
      have hw_map : w.1 ∈ Ideal.map (algebraMap A₁ B_q) m₁ := by
        rw [hMax]; exact hw_q₀
      obtain ⟨t, u, hu_I₁, hwt⟩ := hSpanAnn w.1 hw_map
      have htw_eq : t.1 * w = u := Subtype.ext (by rw [Subalgebra.coe_mul, mul_comm, hwt])
      refine ⟨q_F t.1, ?_, ?_⟩
      · intro ht_mem
        have ht_q₀ : t.1 ∈ q₀ := (SetLike.ext_iff.mp hcomap_qbar t.1).mp ht_mem
        exact t.2 ht_q₀
      · rw [← map_mul, htw_eq]
        exact Ideal.Quotient.eq_zero_iff_mem.mpr hu_I₁
    obtain ⟨S_q, hS_q⟩ := IsNoetherian.noetherian (q_bar.restrictScalars κ)
    have hFinAnn : ∀ (G : Finset F₀), (↑G : Set F₀) ⊆ (q_bar : Set F₀) →
        ∃ s : F₀, s ∉ q_bar ∧ ∀ z ∈ G, s * z = 0 := by
      intro G
      induction G using Finset.induction with
      | empty =>
        intro _
        refine ⟨1, ?_, fun z hz => False.elim (Finset.notMem_empty z hz)⟩
        intro h1
        exact hqbar_max.ne_top ((Ideal.eq_top_iff_one q_bar).mpr h1)
      | @insert w G _ ih =>
        intro hsub
        have hw : w ∈ q_bar := hsub (Finset.mem_insert_self w G)
        have hG : (↑G : Set F₀) ⊆ (q_bar : Set F₀) :=
