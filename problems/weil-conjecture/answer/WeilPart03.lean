            exact hi_not (Finset.mem_filter.mpr ⟨Finset.mem_univ i, hne⟩)
          simp [hai]
        have hS_dist : ∀ i ∈ S, ∀ j ∈ S, i ≠ j →
            ‖algebraMap ↥K_base N (a i) * ((b i : ↥K'_int) : N)‖ ≠
            ‖algebraMap ↥K_base N (a j) * ((b j : ↥K'_int) : N)‖ := by
          intro i hi j hj hij hnorm_eq
          have hai_ne : a i ≠ 0 := (Finset.mem_filter.mp hi).2
          have haj_ne : a j ≠ 0 := (Finset.mem_filter.mp hj).2
          have hbi_ne : ((b i : ↥K'_int) : N) ≠ 0 :=
            fun h0 => (u_rep i).ne_zero (Subtype.ext h0)
          have hbj_ne : ((b j : ↥K'_int) : N) ≠ 0 :=
            fun h0 => (u_rep j).ne_zero (Subtype.ext h0)
          have hmem_H : (u_rep i)⁻¹ * u_rep j ∈ H_val := by
