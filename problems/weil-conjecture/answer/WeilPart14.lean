          ψ_rel_loc.Etale ∧
          σ_B.comp (algebraMap R₀ R_B) =
            (algebraMap R' R₁).comp (ψ_rel.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)) ∧
