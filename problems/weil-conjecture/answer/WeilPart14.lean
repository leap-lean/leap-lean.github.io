      · apply RingHom.ext; intro r
        change Ψ_2 ((Φ2_hom (algebraMap k M' r)).1) = η' (Ideal.Quotient.mk I_M' (MvPolynomial.C r))
        rw [Φ2_hom.commutes, IsScalarTower.algebraMap_apply k M ↥A_2 r]
        change Ψ_2 (ι_2 (Ideal.Quotient.mk I_M (MvPolynomial.C r))) = _
        rw [hΨ2_alg, hι_MM'_mk]
        simp [ι_MM'_raw]
      · intro s
        rcases s with i | c
        · change Ψ_2 (tilde_Φ2 (Ideal.Quotient.mk I_M' (MvPolynomial.X (Sum.inl i)))) =
            η' (Ideal.Quotient.mk I_M' (MvPolynomial.X (Sum.inl i)))
          rw [show tilde_Φ2 (Ideal.Quotient.mk I_M' (MvPolynomial.X (Sum.inl i))) =
            r_2 (Fin.castSucc i) from congrArg Subtype.val (hΦ2_inl i)]
          have hu_η't : IsUnit (η' t'c₀) := IsLocalization.Away.algebraMap_isUnit t'c₀
          apply hu_η't.mul_left_cancel
          have h1 := congrArg Ψ_2 (hr2_spec (Fin.castSucc i))
          rw [map_mul, hΨ2_alg, hι_MM'_2, hΨ2_alg] at h1
          have h2 : ι_MM' (m_gen (Fin.castSucc i)) =
              t'c₀ * Ideal.Quotient.mk I_M' (MvPolynomial.X (Sum.inl i)) := by
            fin_cases i <;>
              simp [m_gen, hι_MM'_mk, ι_MM'_raw]
          rw [h2, map_mul] at h1
          exact h1
        · change Ψ_2 (tilde_Φ2 (Ideal.Quotient.mk I_M' (MvPolynomial.X (Sum.inr c)))) =
            η' (Ideal.Quotient.mk I_M' (MvPolynomial.X (Sum.inr c)))
          rw [show tilde_Φ2 (Ideal.Quotient.mk I_M' (MvPolynomial.X (Sum.inr c))) =
            ι_2 (Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inr c))) from
            congrArg Subtype.val (hΦ2_inr c), hΨ2_alg, hι_MM'_mk]
