        CategoryTheory.Limits.pullback.fst (𝒰₁₂.f ij) (𝒰₁₂.f i'j')
      let pR : CategoryTheory.Limits.pullback (𝒰₁₂.f ij) (𝒰₁₂.f i'j') ⟶
          CategoryTheory.Limits.pullback (u₁ i' ≫ P₁.hom) (v₂ j' ≫ P₂.hom) :=
        CategoryTheory.Limits.pullback.snd (𝒰₁₂.f ij) (𝒰₁₂.f i'j')
      let fst_ij := CategoryTheory.Limits.pullback.fst (u₁ i ≫ P₁.hom) (v₂ j ≫ P₂.hom)
      let snd_ij := CategoryTheory.Limits.pullback.snd (u₁ i ≫ P₁.hom) (v₂ j ≫ P₂.hom)
      let fst_i'j' := CategoryTheory.Limits.pullback.fst (u₁ i' ≫ P₁.hom) (v₂ j' ≫ P₂.hom)
      let snd_i'j' := CategoryTheory.Limits.pullback.snd (u₁ i' ≫ P₁.hom) (v₂ j' ≫ P₂.hom)
      have h_cond1 : (pL ≫ fst_ij) ≫ u₁ i = (pR ≫ fst_i'j') ≫ u₁ i' := by
        have hc := CategoryTheory.Limits.pullback.condition (f := 𝒰₁₂.f ij) (g := 𝒰₁₂.f i'j')
