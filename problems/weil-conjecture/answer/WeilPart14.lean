            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap _ _)) ≫ (W ν).2.fromSpec) :=
by
  let P_L := weilProjectiveSpaceOver k L
  obtain ⟨hPropPL, U_L, iso_L, hCov_UL, hUL_hom, hUL_pre, hUL_trans⟩ :=
    weil_projSpace_isProper_and_polynomial_charts k L
  have _ : AlgebraicGeometry.IsProper P_L.hom := hPropPL
  have hPropX : AlgebraicGeometry.IsProper X.hom := by
    obtain ⟨N, ι_X, hCl_X⟩ := hProjX
    have _ : AlgebraicGeometry.IsClosedImmersion ι_X.left := hCl_X
    have _ : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver k N).hom :=
      (weil_projSpace_isProper_and_polynomial_charts k N).1
    rw [← CategoryTheory.Over.w ι_X]
    infer_instance
  have _ : AlgebraicGeometry.IsProper X.hom := hPropX
  obtain ⟨U₀, γ, hU₀_eq, hγ_hom, hLoc⟩ :=
    weil_cocycle_generators_open_proj_morphism k X P_L K hClosedK M L W h hCov hSpan hUnit
      U_L iso_L hUL_hom hUL_pre hUL_trans
  have hU₀_ne : Nonempty U₀ := by
    obtain ⟨x, hx⟩ := hNonUniv
    refine ⟨⟨x, ?_⟩⟩
    change x ∈ (U₀ : Set X.left)
    rwa [hU₀_eq]
  have _ : AlgebraicGeometry.IsIntegral X.left := hIntX
  have hIntU₀ : AlgebraicGeometry.IsIntegral (U₀ : AlgebraicGeometry.Scheme.{u}) :=
    AlgebraicGeometry.isIntegral_of_isOpenImmersion U₀.ι
  have _ : TopologicalSpace.NoetherianSpace ↥X.left :=
    (weil_projectiveOverField_noetherianSpace_and_isSeparated k X hProjX).1
  have _ : TopologicalSpace.NoetherianSpace ↥(U₀ : AlgebraicGeometry.Scheme.{u}) :=
    U₀.ι.isOpenEmbedding.toIsInducing.noetherianSpace
  have _ : CompactSpace ↥(U₀ : AlgebraicGeometry.Scheme.{u}) := inferInstance
  let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
  let Q := CategoryTheory.Limits.pullback X.hom P_L.hom
  let δ : (U₀ : AlgebraicGeometry.Scheme.{u}) ⟶ Q :=
    CategoryTheory.Limits.pullback.lift U₀.ι γ hγ_hom
  let Z := AlgebraicGeometry.Scheme.Hom.image δ
  let ι : Z ⟶ Q := AlgebraicGeometry.Scheme.Hom.imageι δ
  let p₁ : Z ⟶ X.left := ι ≫ CategoryTheory.Limits.pullback.fst X.hom P_L.hom
  obtain ⟨hIntZ, hProp_p₁, _hProp_p₂, hKerAll, hIsoU₀, _hInv_g⟩ :=
    weil_schematicImage_graph_openIso_and_isIntegral S_k X.left P_L.left X.hom P_L.hom
      U₀ hIntU₀ γ hγ_hom
  let X' : CategoryTheory.Over S_k := CategoryTheory.Over.mk (p₁ ≫ X.hom)
  let π : X' ⟶ X := CategoryTheory.Over.homMk p₁ rfl
  have hCl_ι : AlgebraicGeometry.IsClosedImmersion ι := by
    dsimp [ι]
    infer_instance
  have hAltπ : IsGenFiniteEtaleAlterationOver k π := by
    have _ : IrreducibleSpace ↥X.left :=
      AlgebraicGeometry.irreducibleSpace_of_isIntegral X.left
    have hU₀_set_ne : (U₀ : Set X.left).Nonempty := by rwa [hU₀_eq]
    have hDenseU₀ : Dense (U₀ : Set X.left) := U₀.isOpen.dense hU₀_set_ne
    have h_toImage_p₁ : AlgebraicGeometry.Scheme.Hom.toImage δ ≫ p₁ = U₀.ι := by
      dsimp [p₁, ι]
      rw [← CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.Hom.toImage_imageι,
        CategoryTheory.Limits.pullback.lift_fst]
    have h_sub_range : (U₀ : Set X.left) ⊆ Set.range p₁.base := by
      have h_rng : Set.range U₀.ι.base = (U₀ : Set X.left) := by
        change (U₀.ι.opensRange : Set X.left) = (U₀ : Set X.left)
        rw [AlgebraicGeometry.Scheme.Opens.opensRange_ι]
      rw [← h_rng, ← h_toImage_p₁]
      rintro _ ⟨u, rfl⟩
      exact ⟨(AlgebraicGeometry.Scheme.Hom.toImage δ).base u, rfl⟩
    have _ : AlgebraicGeometry.IsDominant p₁ := ⟨Dense.mono h_sub_range hDenseU₀⟩
    have _ : AlgebraicGeometry.IsProper p₁ := hProp_p₁
    have hSurj_p₁ : AlgebraicGeometry.Surjective p₁ := inferInstance
    have _ : CategoryTheory.IsIso (π.left ∣_ U₀) := hIsoU₀
    exact ⟨hProp_p₁, hSurj_p₁, U₀, hU₀_ne, inferInstance, inferInstance, inferInstance⟩
  refine ⟨X', π, ι, U₀, hCl_ι, rfl, hIntZ, hAltπ, ⟨hU₀_eq, hU₀_ne, hIsoU₀⟩, ?_⟩
  intro x'
  have hx'_W_top : π.left.base x' ∈ (⊤ : X.left.Opens) := trivial
  rw [← hCov, TopologicalSpace.Opens.mem_iSup] at hx'_W_top
  obtain ⟨ν, hx'_W⟩ := hx'_W_top
  have hx'_U_top :
      (ι ≫ CategoryTheory.Limits.pullback.snd X.hom P_L.hom).base x' ∈ (⊤ : P_L.left.Opens) :=
    trivial
  rw [← hCov_UL, TopologicalSpace.Opens.mem_iSup] at hx'_U_top
  obtain ⟨β, hx'_U⟩ := hx'_U_top
  obtain ⟨e_loc, he_fst, he_snd⟩ := hLoc ν β
  obtain ⟨z₀, j_chart, hhβ, hOpenJ, hz₀, hjComm⟩ :=
    weil_graph_closure_affine_blowup_chart k X P_L U₀ γ hγ_hom (W ν) L (h ν) β
      (U_L β) (iso_L β) (hUL_hom β) e_loc he_fst he_snd Z ι hCl_ι
      (hKerAll _) x' hx'_W hx'_U
  exact ⟨ν, β, z₀, j_chart, hx'_W, hhβ, hOpenJ, hz₀, hjComm⟩

theorem weil_reduced_closed_blowup_etale_charts_of_affine_charts (k : Type u) [Field k]
    (X X' : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (K : Set X.left)
    (π : X' ⟶ X)
    (hIntX : AlgebraicGeometry.IsIntegral X.left)
    (hClosedK : IsClosed K)
    (hIrredK : IsIrreducible K)
    (U₀ : X.left.Opens)
    (hU₀ : (U₀ : Set X.left) = Kᶜ ∧ Nonempty U₀ ∧ CategoryTheory.IsIso (π.left ∣_ U₀))
    (M L : ℕ)
    (W : Fin (M + 1) → X.left.affineOpens)
    (h : ∀ ν : Fin (M + 1), Fin (L + 1) → ↑(X.left.presheaf.obj (Opposite.op (W ν).1)))
    (hSpan : ∀ ν : Fin (M + 1),
      Ideal.span (Set.range (h ν)) =
        (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal ⟨K, hClosedK⟩).ideal (W ν))
    (hCharts : ∀ x' : X'.left,
      ∃ (ν : Fin (M + 1)) (β : Fin (L + 1))
        (z₀ : AlgebraicGeometry.Spec (CommRingCat.of ↥(weilBlowupChartSubalg
          (↑(X.left.presheaf.obj (Opposite.op (W ν).1))) (h ν) β)))
        (j_chart : AlgebraicGeometry.Spec (CommRingCat.of ↥(weilBlowupChartSubalg
          (↑(X.left.presheaf.obj (Opposite.op (W ν).1))) (h ν) β)) ⟶ X'.left),
        π.left.base x' ∈ (W ν).1 ∧
        h ν β ≠ 0 ∧
        AlgebraicGeometry.IsOpenImmersion j_chart ∧
        j_chart.base z₀ = x' ∧
        j_chart ≫ π.left =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap _ _)) ≫ (W ν).2.fromSpec) :
    IsReducedClosedBlowupOver k K π :=
by
  
  have h_step3 : ∀ (R'_ring : Type u) [CommRing R'_ring] (s₀ : R'_ring)
      (h'' : Fin (L + 1) → Localization.Away s₀) (β : Fin (L + 1))
      (r : ℕ) (g : Fin r → R'_ring)
      (_ : h'' β ∈ nonZeroDivisors (Localization.Away s₀))
      (_ : ∀ b : Fin r, algebraMap R'_ring (Localization.Away s₀) (g b) ∈
        nonZeroDivisors (Localization.Away s₀))
      (_ : Ideal.span (Set.range h'') =
        Ideal.span (Set.range (fun a : Fin r => algebraMap R'_ring (Localization.Away s₀) (g a))))
      (I_w : Ideal ↥(weilBlowupChartSubalg (Localization.Away s₀) h'' β))
      (_ : I_w ≠ ⊤),
      ∃ (b : Fin r) (B_alg : Type u) (instB : CommRing B_alg)
        (j_sub : ↥(weilBlowupChartSubalg (Localization.Away s₀) h'' β) →+* B_alg)
        (ξ₀ : ↥(weilBlowupChartSubalg (Localization.Away s₀) h'' β))
        (Ψ_bar : (MvPolynomial (Fin r) R'_ring ⧸
          RingHom.ker ((MvPolynomial.aeval (R := R'_ring)
            (fun a : Fin r =>
              algebraMap R'_ring (Localization.Away (g b)) (g a) *
                IsLocalization.Away.invSelf (S := Localization.Away (g b)) (g b))).toRingHom)) →+*
          B_alg)
        (f_piv : MvPolynomial (Fin r) R'_ring ⧸
          RingHom.ker ((MvPolynomial.aeval (R := R'_ring)
            (fun a : Fin r =>
              algebraMap R'_ring (Localization.Away (g b)) (g a) *
                IsLocalization.Away.invSelf (S := Localization.Away (g b)) (g b))).toRingHom)),
        letI : CommRing B_alg := instB
        ξ₀ ∉ I_w ∧
        @IsLocalization.Away _ _ ξ₀ B_alg _ j_sub.toAlgebra ∧
        @IsLocalization.Away _ _ f_piv B_alg _ Ψ_bar.toAlgebra ∧
        Ψ_bar.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) =
          j_sub.comp ((algebraMap (Localization.Away s₀)
            ↥(weilBlowupChartSubalg (Localization.Away s₀) h'' β)).comp
            (algebraMap R'_ring (Localization.Away s₀))) := by
    clear X X' K π hIntX hClosedK hIrredK U₀ hU₀ M W h hSpan hCharts
    intro R' _ s₀ h'' β r g hh''β hg'' hSpanEq I_w hProper
    let R'' := Localization.Away s₀
    let g'' : Fin r → R'' := fun a => algebraMap R' R'' (g a)
    let B''_β := weilBlowupChartSubalg R'' h'' β
    let t'' : Fin (L + 1) → Localization.Away (h'' β) := fun α =>
      algebraMap R'' (Localization.Away (h'' β)) (h'' α) *
        IsLocalization.Away.invSelf (S := Localization.Away (h'' β)) (h'' β)
    have hc_ex : ∀ b : Fin r, ∃ c : Fin (L + 1) → R'', ∑ α : Fin (L + 1), c α * h'' α = g'' b := by
      intro b
      have hmem : g'' b ∈ Ideal.span (Set.range h'') := by
        rw [hSpanEq]
        exact Ideal.subset_span ⟨b, rfl⟩
      obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun R'').mp hmem
      exact ⟨c, by simpa only [smul_eq_mul] using hc⟩
    choose c hc using hc_ex
    have hd_ex : ∃ d : Fin r → R'', ∑ b : Fin r, d b * g'' b = h'' β := by
      have hmem : h'' β ∈ Ideal.span (Set.range g'') := by
        rw [← hSpanEq]
        exact Ideal.subset_span ⟨β, rfl⟩
      obtain ⟨d, hd⟩ := (Submodule.mem_span_range_iff_exists_fun R'').mp hmem
      exact ⟨d, by simpa only [smul_eq_mul] using hd⟩
    obtain ⟨d, hd⟩ := hd_ex
    let ξ_raw : Fin r → Localization.Away (h'' β) := fun b =>
      algebraMap R'' (Localization.Away (h'' β)) (g'' b) *
        IsLocalization.Away.invSelf (S := Localization.Away (h'' β)) (h'' β)
    have hξ_mem : ∀ b : Fin r, ξ_raw b ∈ B''_β := by
      intro b
      have hsum_eq : ξ_raw b =
          ∑ α : Fin (L + 1), algebraMap R'' (Localization.Away (h'' β)) (c b α) * t'' α := by
        simp only [ξ_raw, t'', ← hc b, map_sum, map_mul, Finset.sum_mul, mul_assoc]
      rw [hsum_eq]
      refine B''_β.sum_mem fun α _ => ?_
      exact B''_β.mul_mem (B''_β.algebraMap_mem (c b α)) (Algebra.subset_adjoin ⟨α, rfl⟩)
    let ξ_sub : Fin r → ↥B''_β := fun b => ⟨ξ_raw b, hξ_mem b⟩
    have hξ_part_of_unity : ∑ b : Fin r, algebraMap R'' ↥B''_β (d b) * ξ_sub b = 1 := by
      apply Subtype.ext
      calc (↑(∑ b : Fin r, algebraMap R'' ↥B''_β (d b) * ξ_sub b) : Localization.Away (h'' β))
          = ∑ b : Fin r, algebraMap R'' (Localization.Away (h'' β)) (d b) * ξ_raw b := by
              simp only [AddSubmonoidClass.coe_finsetSum, MulMemClass.coe_mul]
              rfl
        _ = (∑ b : Fin r, algebraMap R'' (Localization.Away (h'' β)) (d b * g'' b)) *
              IsLocalization.Away.invSelf (S := Localization.Away (h'' β)) (h'' β) := by
              simp only [ξ_raw, map_mul, Finset.sum_mul, mul_assoc]
        _ = algebraMap R'' (Localization.Away (h'' β)) (∑ b : Fin r, d b * g'' b) *
              IsLocalization.Away.invSelf (S := Localization.Away (h'' β)) (h'' β) := by
              rw [map_sum]
        _ = algebraMap R'' (Localization.Away (h'' β)) (h'' β) *
              IsLocalization.Away.invSelf (S := Localization.Away (h'' β)) (h'' β) := by
              rw [hd]
        _ = 1 := IsLocalization.Away.mul_invSelf (h'' β)
    have hb₀_ex : ∃ b₀ : Fin r, ξ_sub b₀ ∉ I_w := by
      by_contra h_none
      apply hProper
      rw [Ideal.eq_top_iff_one, ← hξ_part_of_unity]
      refine I_w.sum_mem fun b _ => I_w.mul_mem_left _ ?_
      by_contra hb
      exact h_none ⟨b, hb⟩
    obtain ⟨b₀, hξ₀⟩ := hb₀_ex
    let ξ₀ : ↥B''_β := ξ_sub b₀
    let p_den : R'' := h'' β * g'' b₀
    have hp_nzd : p_den ∈ nonZeroDivisors R'' := (nonZeroDivisors R'').mul_mem hh''β (hg'' b₀)
    let L_amb := Localization.Away p_den
    have hInj_amb : Function.Injective (algebraMap R'' L_amb) :=
      IsLocalization.injective L_amb (Submonoid.powers_le.mpr hp_nzd)
    let u_amb : L_amb := IsLocalization.Away.invSelf (S := L_amb) p_den
    have hu_amb : algebraMap R'' L_amb p_den * u_amb = 1 :=
      IsLocalization.Away.mul_invSelf p_den
    let inv_h : L_amb := algebraMap R'' L_amb (g'' b₀) * u_amb
    let inv_g : L_amb := algebraMap R'' L_amb (h'' β) * u_amb
    have h_inv_h : algebraMap R'' L_amb (h'' β) * inv_h = 1 := by
      calc algebraMap R'' L_amb (h'' β) * inv_h
          = (algebraMap R'' L_amb (h'' β) * algebraMap R'' L_amb (g'' b₀)) * u_amb := by ring
        _ = algebraMap R'' L_amb p_den * u_amb := by rw [← map_mul]
        _ = 1 := hu_amb
    have h_inv_g : algebraMap R'' L_amb (g'' b₀) * inv_g = 1 := by
      calc algebraMap R'' L_amb (g'' b₀) * inv_g
          = (algebraMap R'' L_amb (h'' β) * algebraMap R'' L_amb (g'' b₀)) * u_amb := by ring
        _ = algebraMap R'' L_amb p_den * u_amb := by rw [← map_mul]
        _ = 1 := hu_amb
    let t : Fin (L + 1) → L_amb := fun α => algebraMap R'' L_amb (h'' α) * inv_h
    let ζ : L_amb := algebraMap R'' L_amb (h'' β) * inv_g
    have ht_β : t β = 1 := h_inv_h
    have ht_ζ : ∀ α : Fin (L + 1), t α * ζ = algebraMap R'' L_amb (h'' α) * inv_g := by
      intro α
      calc t α * ζ
          = algebraMap R'' L_amb (h'' α) * (algebraMap R'' L_amb (h'' β) * inv_h) * inv_g := by ring
        _ = algebraMap R'' L_amb (h'' α) * inv_g := by rw [h_inv_h, mul_one]
    let A_common : Subalgebra R'' L_amb := Algebra.adjoin R'' (Set.insert ζ (Set.range t))
    let B_alg : Type u := ↥A_common
    have hUnit_h : IsUnit (algebraMap R'' L_amb (h'' β)) := IsUnit.of_mul_eq_one inv_h h_inv_h
    let ι_h : Localization.Away (h'' β) →+* L_amb :=
      IsLocalization.Away.lift (h'' β) (g := algebraMap R'' L_amb) hUnit_h
    have hι_h_alg : ∀ r'' : R'', ι_h (algebraMap R'' (Localization.Away (h'' β)) r'') =
        algebraMap R'' L_amb r'' :=
      IsLocalization.Away.lift_eq (h'' β) hUnit_h
    have hι_h_inv : ι_h (IsLocalization.Away.invSelf (S := Localization.Away (h'' β)) (h'' β)) =
        inv_h := by
      have h1 : algebraMap R'' L_amb (h'' β) *
          ι_h (IsLocalization.Away.invSelf (S := Localization.Away (h'' β)) (h'' β)) = 1 := by
        rw [← hι_h_alg (h'' β), ← map_mul, IsLocalization.Away.mul_invSelf, map_one]
      calc ι_h (IsLocalization.Away.invSelf (S := Localization.Away (h'' β)) (h'' β))
          = (inv_h * algebraMap R'' L_amb (h'' β)) *
              ι_h (IsLocalization.Away.invSelf (S := Localization.Away (h'' β)) (h'' β)) := by
              rw [mul_comm inv_h, h_inv_h, one_mul]
        _ = inv_h * (algebraMap R'' L_amb (h'' β) *
              ι_h (IsLocalization.Away.invSelf (S := Localization.Away (h'' β)) (h'' β))) := by ring
        _ = inv_h := by rw [h1, mul_one]
    have hι_h_t : ∀ α : Fin (L + 1), ι_h (t'' α) = t α := by
      intro α
      simp only [t'', t, map_mul, hι_h_alg, hι_h_inv]
    have hι_h_mem : ∀ y ∈ B''_β, ι_h y ∈ A_common := by
      intro y hy
      induction hy using Algebra.adjoin_induction with
      | mem y hy_mem =>
        rcases hy_mem with ⟨α, rfl⟩
        rw [hι_h_t α]
        exact Algebra.subset_adjoin (Set.mem_insert_of_mem _ ⟨α, rfl⟩)
      | algebraMap r'' =>
        rw [hι_h_alg r'']
        exact A_common.algebraMap_mem r''
      | add y₁ y₂ _ _ ih₁ ih₂ =>
        rw [map_add]
        exact A_common.add_mem ih₁ ih₂
      | mul y₁ y₂ _ _ ih₁ ih₂ =>
        rw [map_mul]
        exact A_common.mul_mem ih₁ ih₂
    have hι_h_inj : Function.Injective ι_h := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      obtain ⟨⟨r'', m_pow⟩, hrm⟩ := IsLocalization.surj (Submonoid.powers (h'' β)) x
      have hr''0 : algebraMap R'' L_amb r'' = 0 := by
        calc algebraMap R'' L_amb r''
            = ι_h (algebraMap R'' (Localization.Away (h'' β)) r'') := (hι_h_alg r'').symm
          _ = ι_h (x * algebraMap R'' (Localization.Away (h'' β)) m_pow.1) := by rw [← hrm]
          _ = ι_h x * ι_h (algebraMap R'' (Localization.Away (h'' β)) m_pow.1) := map_mul _ _ _
          _ = 0 := by rw [hx, zero_mul]
      have hr''_eq : r'' = 0 := hInj_amb (hr''0.trans (map_zero _).symm)
      rw [hr''_eq, map_zero] at hrm
      exact (IsLocalization.map_units (Localization.Away (h'' β)) m_pow).mul_left_eq_zero.mp hrm
    let j_sub : ↥B''_β →+* B_alg :=
      { toFun := fun u => ⟨ι_h u.1, hι_h_mem u.1 u.2⟩
        map_one' := Subtype.ext (map_one ι_h)
        map_mul' := fun u₁ u₂ => Subtype.ext (map_mul ι_h u₁.1 u₂.1)
        map_zero' := Subtype.ext (map_zero ι_h)
        map_add' := fun u₁ u₂ => Subtype.ext (map_add ι_h u₁.1 u₂.1) }
    have hj_sub_inj : Function.Injective j_sub := by
      intro u₁ u₂ hu
      apply Subtype.ext
      exact hι_h_inj (congrArg Subtype.val hu)
    let ζ_alg : B_alg := ⟨ζ, Algebra.subset_adjoin (Set.mem_insert ζ _)⟩
    have hξ₀_val : (j_sub ξ₀).1 = algebraMap R'' L_amb (g'' b₀) * inv_h := by
      change ι_h (ξ_raw b₀) = _
      simp only [ξ_raw, map_mul, hι_h_alg, hι_h_inv]
    have hξ_mul_ζ : j_sub ξ₀ * ζ_alg = 1 := by
      apply Subtype.ext
      change (j_sub ξ₀).1 * ζ = 1
      rw [hξ₀_val]
      calc (algebraMap R'' L_amb (g'' b₀) * inv_h) * (algebraMap R'' L_amb (h'' β) * inv_g)
          = (algebraMap R'' L_amb (h'' β) * inv_h) * (algebraMap R'' L_amb (g'' b₀) * inv_g) := by ring
        _ = 1 * 1 := by rw [h_inv_h, h_inv_g]
        _ = 1 := one_mul 1
    have hLoc₁ : @IsLocalization.Away _ _ ξ₀ B_alg _ j_sub.toAlgebra := by
      let _ : Algebra ↥B''_β B_alg := j_sub.toAlgebra
      refine ⟨?_, ?_, ?_⟩
      · intro y
        obtain ⟨n, hn⟩ := y.2
        change IsUnit (j_sub y.1)
        rw [← hn, map_pow]
        exact (IsUnit.of_mul_eq_one ζ_alg hξ_mul_ζ).pow n
      · intro z
        have hsurj_ind : ∀ u ∈ A_common, ∃ (n : ℕ) (x : ↥B''_β),
            u * (j_sub ξ₀).1 ^ n = (j_sub x).1 := by
          intro u hu
          induction hu using Algebra.adjoin_induction with
          | mem u hu_mem =>
            rcases hu_mem with rfl | ⟨α, rfl⟩
            · refine ⟨1, 1, ?_⟩
              rw [pow_one, map_one]
              change ζ * (j_sub ξ₀).1 = 1
              rw [mul_comm]
              exact congrArg Subtype.val hξ_mul_ζ
            · refine ⟨0, ⟨t'' α, Algebra.subset_adjoin ⟨α, rfl⟩⟩, ?_⟩
              rw [pow_zero, mul_one]
              exact (hι_h_t α).symm
          | algebraMap r'' =>
            refine ⟨0, algebraMap R'' ↥B''_β r'', ?_⟩
            rw [pow_zero, mul_one]
            exact (hι_h_alg r'').symm
          | add u₁ u₂ _ _ ih₁ ih₂ =>
            obtain ⟨n₁, x₁, hx₁⟩ := ih₁
            obtain ⟨n₂, x₂, hx₂⟩ := ih₂
            refine ⟨n₁ + n₂, x₁ * ξ₀ ^ n₂ + x₂ * ξ₀ ^ n₁, ?_⟩
            have hgoal : (u₁ + u₂) * (j_sub ξ₀).1 ^ (n₁ + n₂) =
                (j_sub x₁).1 * (j_sub ξ₀).1 ^ n₂ + (j_sub x₂).1 * (j_sub ξ₀).1 ^ n₁ := by
              calc (u₁ + u₂) * (j_sub ξ₀).1 ^ (n₁ + n₂)
                  = (u₁ * (j_sub ξ₀).1 ^ n₁) * (j_sub ξ₀).1 ^ n₂ +
                      (u₂ * (j_sub ξ₀).1 ^ n₂) * (j_sub ξ₀).1 ^ n₁ := by
                      rw [pow_add]
                      ring
                _ = (j_sub x₁).1 * (j_sub ξ₀).1 ^ n₂ + (j_sub x₂).1 * (j_sub ξ₀).1 ^ n₁ := by
                      rw [hx₁, hx₂]
            rw [hgoal]
            change _ = A_common.val.toRingHom (j_sub (x₁ * ξ₀ ^ n₂ + x₂ * ξ₀ ^ n₁))
            simp only [map_add, map_mul, map_pow]
            rfl
          | mul u₁ u₂ _ _ ih₁ ih₂ =>
            obtain ⟨n₁, x₁, hx₁⟩ := ih₁
            obtain ⟨n₂, x₂, hx₂⟩ := ih₂
            refine ⟨n₁ + n₂, x₁ * x₂, ?_⟩
            calc (u₁ * u₂) * (j_sub ξ₀).1 ^ (n₁ + n₂)
                = (u₁ * (j_sub ξ₀).1 ^ n₁) * (u₂ * (j_sub ξ₀).1 ^ n₂) := by
                    rw [pow_add]
                    ring
              _ = (j_sub x₁).1 * (j_sub x₂).1 := by rw [hx₁, hx₂]
              _ = A_common.val.toRingHom (j_sub (x₁ * x₂)) := by simp only [map_mul]; rfl
        obtain ⟨n, x, hnx⟩ := hsurj_ind z.1 z.2
        refine ⟨⟨x, ⟨ξ₀ ^ n, Submonoid.pow_mem _ (Submonoid.mem_powers ξ₀) n⟩⟩, ?_⟩
        apply Subtype.ext
        change z.1 * A_common.val.toRingHom (j_sub (ξ₀ ^ n)) = (j_sub x).1
        rw [map_pow, map_pow]
        exact hnx
      · intro x₁ x₂ hx
        have heq : x₁ = x₂ := hj_sub_inj hx
        exact ⟨1, by rw [heq]⟩
    let θ' : MvPolynomial (Fin r) R' →+* Localization.Away (g b₀) :=
      (MvPolynomial.aeval (R := R') (fun a : Fin r =>
        algebraMap R' (Localization.Away (g b₀)) (g a) *
          IsLocalization.Away.invSelf (S := Localization.Away (g b₀)) (g b₀))).toRingHom
    let Q' := MvPolynomial (Fin r) R' ⧸ RingHom.ker θ'
    let mkQ : MvPolynomial (Fin r) R' →+* Q' := Ideal.Quotient.mk (RingHom.ker θ')
    let σ : R' →+* L_amb := (algebraMap R'' L_amb).comp (algebraMap R' R'')
    have h_σ_g : σ (g b₀) * inv_g = 1 := h_inv_g
    have hUnit_g : IsUnit (σ (g b₀)) := IsUnit.of_mul_eq_one inv_g h_σ_g
    let Λ : Localization.Away (g b₀) →+* L_amb :=
      IsLocalization.Away.lift (g b₀) (g := σ) hUnit_g
    have hΛ_alg : ∀ r' : R', Λ (algebraMap R' (Localization.Away (g b₀)) r') = σ r' :=
      IsLocalization.Away.lift_eq (g b₀) hUnit_g
    have hΛ_inv : Λ (IsLocalization.Away.invSelf (S := Localization.Away (g b₀)) (g b₀)) =
        inv_g := by
      have h1 : σ (g b₀) *
          Λ (IsLocalization.Away.invSelf (S := Localization.Away (g b₀)) (g b₀)) = 1 := by
        rw [← hΛ_alg (g b₀), ← map_mul, IsLocalization.Away.mul_invSelf, map_one]
      calc Λ (IsLocalization.Away.invSelf (S := Localization.Away (g b₀)) (g b₀))
          = (inv_g * σ (g b₀)) *
              Λ (IsLocalization.Away.invSelf (S := Localization.Away (g b₀)) (g b₀)) := by
              rw [mul_comm inv_g, h_σ_g, one_mul]
        _ = inv_g * (σ (g b₀) *
              Λ (IsLocalization.Away.invSelf (S := Localization.Away (g b₀)) (g b₀))) := by ring
        _ = inv_g := by rw [h1, mul_one]
    let Ψ_poly : MvPolynomial (Fin r) R' →+* L_amb := Λ.comp θ'
    have hΨ_C : ∀ r' : R', Ψ_poly (MvPolynomial.C r') = σ r' := by
      intro r'
      change Λ (MvPolynomial.aeval _ (MvPolynomial.C r')) = σ r'
      rw [MvPolynomial.aeval_C]
      exact hΛ_alg r'
    have hΨ_X : ∀ a : Fin r, Ψ_poly (MvPolynomial.X a) =
        algebraMap R'' L_amb (g'' a) * inv_g := by
      intro a
      change Λ (MvPolynomial.aeval _ (MvPolynomial.X a)) = _
      rw [MvPolynomial.aeval_X, map_mul, hΛ_alg, hΛ_inv]
      rfl
    have hΨ_mem : ∀ P : MvPolynomial (Fin r) R', Ψ_poly P ∈ A_common := by
      intro P
      induction P using MvPolynomial.induction_on with
      | C r' =>
        rw [hΨ_C r']
        exact A_common.algebraMap_mem (algebraMap R' R'' r')
      | add P₁ P₂ ih₁ ih₂ =>
        rw [map_add]
        exact A_common.add_mem ih₁ ih₂
      | mul_X P₁ a ih₁ =>
        rw [map_mul, hΨ_X a]
        apply A_common.mul_mem ih₁
        have hga_eq : algebraMap R'' L_amb (g'' a) * inv_g =
            (∑ α : Fin (L + 1), algebraMap R'' L_amb (c a α) * t α) * ζ := by
          calc algebraMap R'' L_amb (g'' a) * inv_g
              = algebraMap R'' L_amb (g'' a) * (algebraMap R'' L_amb (h'' β) * inv_h) * inv_g := by
                  rw [h_inv_h, mul_one]
            _ = (algebraMap R'' L_amb (g'' a) * inv_h) * ζ := by ring
            _ = (algebraMap R'' L_amb (∑ α : Fin (L + 1), c a α * h'' α) * inv_h) * ζ := by
                  rw [hc a]
            _ = (∑ α : Fin (L + 1), algebraMap R'' L_amb (c a α) * t α) * ζ := by
                  simp only [t, map_sum, map_mul, Finset.sum_mul, mul_assoc]
        rw [hga_eq]
        apply A_common.mul_mem
        · refine A_common.sum_mem fun α _ => ?_
          exact A_common.mul_mem (A_common.algebraMap_mem (c a α))
            (Algebra.subset_adjoin (Set.mem_insert_of_mem _ ⟨α, rfl⟩))
        · exact Algebra.subset_adjoin (Set.mem_insert ζ _)
    let Ψ_to_B : MvPolynomial (Fin r) R' →+* B_alg :=
      { toFun := fun P => ⟨Ψ_poly P, hΨ_mem P⟩
        map_one' := Subtype.ext (map_one Ψ_poly)
        map_mul' := fun P₁ P₂ => Subtype.ext (map_mul Ψ_poly P₁ P₂)
        map_zero' := Subtype.ext (map_zero Ψ_poly)
        map_add' := fun P₁ P₂ => Subtype.ext (map_add Ψ_poly P₁ P₂) }
    have hΨ_ker : ∀ P ∈ RingHom.ker θ', Ψ_to_B P = 0 := by
      intro P hP
      apply Subtype.ext
      change Λ (θ' P) = 0
      rw [RingHom.mem_ker.mp hP, map_zero]
    let Ψ_bar : Q' →+* B_alg := Ideal.Quotient.lift (RingHom.ker θ') Ψ_to_B hΨ_ker
    have hΨ_bar_kerLift : ∀ q : Q', (Ψ_bar q).1 = Λ (RingHom.kerLift θ' q) := by
      intro q
      induction q using Quotient.inductionOn' with
      | h P => rfl
    have hKq_ex : ∀ α : Fin (L + 1), ∃ (K : ℕ) (q : Fin r → R'),
        h'' α * algebraMap R' R'' (s₀ ^ K) =
          ∑ a : Fin r, algebraMap R' R'' (q a) * g'' a := by
      intro α
      have hmem : h'' α ∈ Ideal.map (algebraMap R' R'') (Ideal.span (Set.range g)) := by
        have hmap_eq : Ideal.map (algebraMap R' R'') (Ideal.span (Set.range g)) =
            Ideal.span (Set.range g'') := by
          rw [Ideal.map_span, ← Set.range_comp]
          rfl
        rw [hmap_eq, ← hSpanEq]
        exact Ideal.subset_span ⟨α, rfl⟩
      obtain ⟨⟨⟨y, hy⟩, m_s⟩, hmy⟩ :=
        (IsLocalization.mem_map_algebraMap_iff (Submonoid.powers s₀) R'').mp hmem
      obtain ⟨K, hK⟩ := m_s.2
      dsimp only at hK
      obtain ⟨q, hq⟩ := (Submodule.mem_span_range_iff_exists_fun R').mp hy
      refine ⟨K, q, ?_⟩
      calc h'' α * algebraMap R' R'' (s₀ ^ K)
          = h'' α * algebraMap R' R'' m_s.1 := by rw [hK]
        _ = algebraMap R' R'' y := hmy
        _ = algebraMap R' R'' (∑ a : Fin r, q a * g a) := by
              rw [← hq]
              simp only [smul_eq_mul]
        _ = ∑ a : Fin r, algebraMap R' R'' (q a) * g'' a := by
              simp only [g'', map_sum, map_mul]
    choose K q_coeff hK_eq using hKq_ex
    let s_bar : Q' := mkQ (MvPolynomial.C s₀)
    let γ : Fin (L + 1) → Q' := fun α =>
      mkQ (∑ a : Fin r, MvPolynomial.C (q_coeff α a) * MvPolynomial.X a)
    let η : Q' := γ β
    let f_piv : Q' := s_bar * η
    have hΨ_s_bar : (Ψ_bar s_bar).1 = σ s₀ := hΨ_C s₀
    have hΨ_γ : ∀ α : Fin (L + 1), (Ψ_bar (γ α)).1 = (σ s₀) ^ (K α) * (t α * ζ) := by
      intro α
      change Ψ_poly (∑ a : Fin r, MvPolynomial.C (q_coeff α a) * MvPolynomial.X a) = _
      calc Ψ_poly (∑ a : Fin r, MvPolynomial.C (q_coeff α a) * MvPolynomial.X a)
          = ∑ a : Fin r, σ (q_coeff α a) * (algebraMap R'' L_amb (g'' a) * inv_g) := by
              simp only [map_sum, map_mul, hΨ_C, hΨ_X]
        _ = algebraMap R'' L_amb (∑ a : Fin r, algebraMap R' R'' (q_coeff α a) * g'' a) * inv_g := by
              simp only [σ, RingHom.comp_apply, map_sum, map_mul, Finset.sum_mul, mul_assoc]
        _ = algebraMap R'' L_amb (h'' α * algebraMap R' R'' (s₀ ^ K α)) * inv_g := by
              rw [← hK_eq α]
        _ = (σ s₀) ^ (K α) * (algebraMap R'' L_amb (h'' α) * inv_g) := by
              simp only [σ, RingHom.comp_apply, map_mul, map_pow]
              ring
        _ = (σ s₀) ^ (K α) * (t α * ζ) := by rw [ht_ζ α]
    have hΨ_η : (Ψ_bar η).1 = (σ s₀) ^ (K β) * ζ := by
      change (Ψ_bar (γ β)).1 = _
      rw [hΨ_γ β, ht_β, one_mul]
    have hΨ_fpiv : (Ψ_bar f_piv).1 = (σ s₀) ^ (K β + 1) * ζ := by
      change A_common.val.toRingHom (Ψ_bar (s_bar * η)) = _
      rw [map_mul, map_mul]
      change (Ψ_bar s_bar).1 * (Ψ_bar η).1 = _
      rw [hΨ_s_bar, hΨ_η, pow_succ']
      ring
    have hLoc₂ : @IsLocalization.Away _ _ f_piv B_alg _ Ψ_bar.toAlgebra := by
      let _ : Algebra Q' B_alg := Ψ_bar.toAlgebra
      refine ⟨?_, ?_, ?_⟩
      · intro y
        obtain ⟨n, hn⟩ := y.2
        change IsUnit (Ψ_bar y.1)
        rw [← hn, map_pow]
        let s_inv_alg : B_alg := algebraMap R'' B_alg (IsLocalization.Away.invSelf (S := R'') s₀)
        have hs_unit : IsUnit (Ψ_bar s_bar) := by
          refine IsUnit.of_mul_eq_one s_inv_alg ?_
          apply Subtype.ext
          change (Ψ_bar s_bar).1 * algebraMap R'' L_amb (IsLocalization.Away.invSelf (S := R'') s₀) = 1
          rw [hΨ_s_bar]
          change algebraMap R'' L_amb (algebraMap R' R'' s₀) *
            algebraMap R'' L_amb (IsLocalization.Away.invSelf (S := R'') s₀) = 1
          rw [← map_mul, IsLocalization.Away.mul_invSelf, map_one]
        have hζ_unit : IsUnit ζ_alg :=
          IsUnit.of_mul_eq_one (j_sub ξ₀) ((mul_comm ζ_alg (j_sub ξ₀)).trans hξ_mul_ζ)
        have hfpiv_eq : Ψ_bar f_piv = (Ψ_bar s_bar) ^ (K β + 1) * ζ_alg := by
          apply Subtype.ext
          change (Ψ_bar f_piv).1 = ((Ψ_bar s_bar).1) ^ (K β + 1) * ζ
          rw [hΨ_fpiv, hΨ_s_bar]
        rw [hfpiv_eq]
        exact ((hs_unit.pow (K β + 1)).mul hζ_unit).pow n
      · intro z
        have hsurj_ind : ∀ u ∈ A_common, ∃ (n : ℕ) (x : Q'),
            u * (Ψ_bar f_piv).1 ^ n = (Ψ_bar x).1 := by
          intro u hu
          induction hu using Algebra.adjoin_induction with
          | mem u hu_mem =>
            rcases hu_mem with rfl | ⟨α, rfl⟩
            · refine ⟨K β, η ^ (K β + 1), ?_⟩
              have hgoal : ζ * ((σ s₀) ^ (K β + 1) * ζ) ^ (K β) =
                  ((σ s₀) ^ (K β) * ζ) ^ (K β + 1) := by
                calc ζ * ((σ s₀) ^ (K β + 1) * ζ) ^ (K β)
                    = ζ * (((σ s₀) ^ (K β + 1)) ^ (K β) * ζ ^ (K β)) := by rw [mul_pow]
                  _ = (σ s₀) ^ ((K β + 1) * K β) * (ζ * ζ ^ (K β)) := by
                        rw [← pow_mul]
                        ring
                  _ = (σ s₀) ^ (K β * (K β + 1)) * ζ ^ (K β + 1) := by
                        rw [Nat.mul_comm, pow_succ']
                  _ = ((σ s₀) ^ (K β)) ^ (K β + 1) * ζ ^ (K β + 1) := by rw [pow_mul]
                  _ = ((σ s₀) ^ (K β) * ζ) ^ (K β + 1) := by rw [← mul_pow]
              rw [hΨ_fpiv, hgoal]
              change _ = A_common.val.toRingHom (Ψ_bar (η ^ (K β + 1)))
              simp only [map_pow]
              exact congrArg (· ^ (K β + 1)) hΨ_η.symm
            · refine ⟨K α + 1, s_bar ^ (K β + 1) * γ α * η ^ (K α), ?_⟩
              have hexp : (K β + 1) * (K α + 1) = (K β + 1) + K α + K β * K α := by ring
              have hgoal : t α * ((σ s₀) ^ (K β + 1) * ζ) ^ (K α + 1) =
                  (σ s₀) ^ (K β + 1) * ((σ s₀) ^ (K α) * (t α * ζ)) *
                    ((σ s₀) ^ (K β) * ζ) ^ (K α) := by
                calc t α * ((σ s₀) ^ (K β + 1) * ζ) ^ (K α + 1)
                    = t α * (((σ s₀) ^ (K β + 1)) ^ (K α + 1) * ζ ^ (K α + 1)) := by rw [mul_pow]
                  _ = (σ s₀) ^ ((K β + 1) * (K α + 1)) * ((t α * ζ) * ζ ^ (K α)) := by
                        rw [← pow_mul, pow_succ']
                        ring
                  _ = (σ s₀) ^ ((K β + 1) + K α + K β * K α) * ((t α * ζ) * ζ ^ (K α)) := by
                        rw [hexp]
                  _ = ((σ s₀) ^ (K β + 1) * (σ s₀) ^ (K α) * (σ s₀) ^ (K β * K α)) *
                        ((t α * ζ) * ζ ^ (K α)) := by
                        rw [pow_add, pow_add]
                  _ = (σ s₀) ^ (K β + 1) * ((σ s₀) ^ (K α) * (t α * ζ)) *
                        (((σ s₀) ^ (K β)) ^ (K α) * ζ ^ (K α)) := by
                        rw [pow_mul]
                        ring
                  _ = (σ s₀) ^ (K β + 1) * ((σ s₀) ^ (K α) * (t α * ζ)) *
                        ((σ s₀) ^ (K β) * ζ) ^ (K α) := by rw [← mul_pow]
              rw [hΨ_fpiv, hgoal]
              change _ = A_common.val.toRingHom (Ψ_bar (s_bar ^ (K β + 1) * γ α * η ^ (K α)))
              simp only [map_mul, map_pow]
              change _ = (Ψ_bar s_bar).1 ^ (K β + 1) * (Ψ_bar (γ α)).1 * (Ψ_bar η).1 ^ (K α)
              rw [hΨ_s_bar, hΨ_γ, hΨ_η]
          | algebraMap z'' =>
            obtain ⟨⟨r', m_s⟩, hrm⟩ := IsLocalization.surj (Submonoid.powers s₀) z''
            obtain ⟨k, hk⟩ := m_s.2
            dsimp only at hk
            have hz''_mul : algebraMap R'' L_amb z'' * (σ s₀) ^ k = σ r' := by
              calc algebraMap R'' L_amb z'' * (σ s₀) ^ k
                  = algebraMap R'' L_amb (z'' * algebraMap R' R'' m_s.1) := by
                      simp only [σ, RingHom.comp_apply, ← hk, map_mul, map_pow]
                _ = σ r' := by rw [hrm]; rfl
            refine ⟨k, mkQ (MvPolynomial.C r') * η ^ k, ?_⟩
            have hgoal : algebraMap R'' L_amb z'' * ((σ s₀) ^ (K β + 1) * ζ) ^ k =
                σ r' * ((σ s₀) ^ (K β) * ζ) ^ k := by
              calc algebraMap R'' L_amb z'' * ((σ s₀) ^ (K β + 1) * ζ) ^ k
                  = algebraMap R'' L_amb z'' * (((σ s₀) ^ (K β) * σ s₀) ^ k * ζ ^ k) := by
                      rw [pow_succ, mul_pow]
                _ = (algebraMap R'' L_amb z'' * (σ s₀) ^ k) * (((σ s₀) ^ (K β)) ^ k * ζ ^ k) := by
                      rw [mul_pow]
                      ring
                _ = σ r' * ((σ s₀) ^ (K β) * ζ) ^ k := by rw [hz''_mul, ← mul_pow]
            rw [hΨ_fpiv, hgoal]
            change _ = A_common.val.toRingHom (Ψ_bar (mkQ (MvPolynomial.C r') * η ^ k))
            simp only [map_mul, map_pow]
            change _ = Ψ_poly (MvPolynomial.C r') * (Ψ_bar η).1 ^ k
            rw [hΨ_C r', hΨ_η]
          | add u₁ u₂ _ _ ih₁ ih₂ =>
            obtain ⟨n₁, x₁, hx₁⟩ := ih₁
            obtain ⟨n₂, x₂, hx₂⟩ := ih₂
            refine ⟨n₁ + n₂, x₁ * f_piv ^ n₂ + x₂ * f_piv ^ n₁, ?_⟩
            have hgoal : (u₁ + u₂) * (Ψ_bar f_piv).1 ^ (n₁ + n₂) =
                (Ψ_bar x₁).1 * (Ψ_bar f_piv).1 ^ n₂ + (Ψ_bar x₂).1 * (Ψ_bar f_piv).1 ^ n₁ := by
              calc (u₁ + u₂) * (Ψ_bar f_piv).1 ^ (n₁ + n₂)
                  = (u₁ * (Ψ_bar f_piv).1 ^ n₁) * (Ψ_bar f_piv).1 ^ n₂ +
                      (u₂ * (Ψ_bar f_piv).1 ^ n₂) * (Ψ_bar f_piv).1 ^ n₁ := by
                      rw [pow_add]
                      ring
                _ = (Ψ_bar x₁).1 * (Ψ_bar f_piv).1 ^ n₂ + (Ψ_bar x₂).1 * (Ψ_bar f_piv).1 ^ n₁ := by
                      rw [hx₁, hx₂]
            rw [hgoal]
            change _ = A_common.val.toRingHom (Ψ_bar (x₁ * f_piv ^ n₂ + x₂ * f_piv ^ n₁))
            simp only [map_add, map_mul, map_pow]
            rfl
          | mul u₁ u₂ _ _ ih₁ ih₂ =>
            obtain ⟨n₁, x₁, hx₁⟩ := ih₁
            obtain ⟨n₂, x₂, hx₂⟩ := ih₂
            refine ⟨n₁ + n₂, x₁ * x₂, ?_⟩
            calc (u₁ * u₂) * (Ψ_bar f_piv).1 ^ (n₁ + n₂)
