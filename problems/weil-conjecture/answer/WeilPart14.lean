          Spec.map (CommRingCat.ofHom φ₁) ≫
            Spec.map (CommRingCat.ofHom MvPolynomial.C) ≫ e_B1 := by
        rw [← Category.assoc (Spec.map (CommRingCat.ofHom φ₁)), ← Spec.map_comp,
          ← CommRingCat.ofHom_comp, hφ₁_C]
        dsimp only [e_B1, e_C1]
        have hSq_sm : Spec.map ((V.ι ≫ f₁.left).appLE U_sm W_sm he_sm) ≫ hAffU_sm.fromSpec =
            hAffW_sm.fromSpec ≫ (V.ι ≫ f₁.left) :=
          IsAffineOpen.SpecMap_appLE_fromSpec (V.ι ≫ f₁.left) hAffU_sm hAffW_sm he_sm
        change hAffW_sm.fromSpec ≫ V.ι ≫ f₁.left =
          Spec.map ((V.ι ≫ f₁.left).appLE U_sm W_sm he_sm) ≫ hAffU_sm.fromSpec
        rw [hSq_sm]
      exact h_s3 f₁.left (e_C.base v)
        A₁ e_B1 S₁ w₁ e_C1 φ₁ inferInstance inferInstance hEt_φ₁ hw₁_y hComm₁
        R'_B e_B h B' v e_C ψ_nodal hEt_eB hEt_eC hEt_ψnodal rfl hXv hCommC
  have hSupp : ∀ (q : Ideal ↑R'_B), q.IsPrime → q ≤ p_B.asIdeal → h ∈ q →
      ∃ c ∈ I₀, ψ_B (MvPolynomial.X c) ∈ q := by
    intro q hq hq_le hhq
    let pv' : PrimeSpectrum ↑B' := v'
    have hpB_comap : p_B.asIdeal = pv'.asIdeal.comap φ_RB' :=
      (congrArg PrimeSpectrum.asIdeal hv'p).symm
    obtain ⟨P_w, hPw_prime, _, hXw, hPw_comap⟩ :=
      (h_s4 (↑R'_B) h (↑B') ψ_nodal hEt_ψnodal).2 pv'.asIdeal pv'.isPrime hInl
        q hq (hq_le.trans_eq hpB_comap) hhq
    let w : Spec B' := (⟨P_w, hPw_prime⟩ : PrimeSpectrum ↑B')
    have hw_S : e_C.base w ∈ S_rel := by
      change w ∈ e_C.base ⁻¹' S_rel
      rw [hPreS]
      exact hXw
    have hw_notU : f₁.left.base (e_C.base w) ∉ (U_B₁ : Set B₁.left) := by
      intro hwU
      have : AlgebraicGeometry.SmoothOfRelativeDimension 1 (f₁.left ∣_ U_B₁) := hSm_f₁U
      have hSmPre : AlgebraicGeometry.SmoothOfRelativeDimension 1
          ((f₁.left ⁻¹ᵁ U_B₁).ι ≫ f₁.left) := by
        have h10 := AlgebraicGeometry.smoothOfRelativeDimension_comp 1 0
          (f₁.left ∣_ U_B₁) U_B₁.ι
        rwa [Nat.add_zero, AlgebraicGeometry.morphismRestrict_ι] at h10
      exact hw_S ⟨f₁.left ⁻¹ᵁ U_B₁, hwU, hSmPre⟩
    have hw_ZB₁ : f₁.left.base (e_C.base w) ∈ Z_B₁ := by
      rw [hU_B₁_eq] at hw_notU
      exact Set.notMem_compl_iff.mp hw_notU
    have hw_Z₁ : w ∈ e_C.base ⁻¹' (f₁.left.base ⁻¹' Z_B₁ ∪ ⋃ j : Fin n, Set.range (τ₁ j).left.base) :=
      Or.inl hw_ZB₁
    rw [hPreZ₁] at hw_Z₁
    obtain ⟨c, hc, hwc⟩ := hw_Z₁
    refine ⟨c, hc, ?_⟩
    rw [← hPw_comap]
    exact hwc
  exact ⟨R'_B, e_B, ψ_B, p_B, I₀, ρ₀, h, B', v', e_C, ψ_nodal,
    hEt_eB, hEt_ψB, hEt_eC, hEt_ψnodal, hCommB, hCommC, hv'x, hv'p,
    hInl, hI₀_mem, hh_pB, hInj_ρ₀, hSupp, hPreZ₁, hPreDB, hPreS⟩

theorem weil_nodal_datum_to_relative_toroidal_chart (k : Type u) [Field k] (m : ℕ)
    (hEtDom : ∀ (d : ℕ) (B : Type u) [CommRing B] (φ : MvPolynomial (Fin d) k →+* B),
      AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)) →
      ∀ (q : Ideal B) [q.IsPrime], IsDomain (Localization.AtPrime q))
    (B₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (r_B : ℕ) (D_B : Fin r_B → AlgebraicGeometry.Scheme.{u})
    (ιD_B : ∀ i : Fin r_B, D_B i ⟶ B₁.left)
    (C₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (Z₁ : Set C₁.left) (f₁ : C₁ ⟶ B₁) (S_rel : Set C₁.left) (x : C₁.left)
    (R'_B : CommRingCat.{u}) (e_B : AlgebraicGeometry.Spec R'_B ⟶ B₁.left)
    (ψ_B : MvPolynomial (Fin m) k →+* ↑R'_B)
    (p_B : AlgebraicGeometry.Spec R'_B) (I₀ : Finset (Fin m))
    (ρ₀ : {c : Fin m // c ∈ I₀} → Fin r_B) (h : ↑R'_B)
    (B' : CommRingCat.{u}) (v' : AlgebraicGeometry.Spec B')
    (e_C : AlgebraicGeometry.Spec B' ⟶ C₁.left)
    (ψ_nodal : (MvPolynomial (Fin 2) ↑R'_B ⧸ Ideal.span
      {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h}) →+* ↑B')
    (hDatum : IsShrunkNodalSncDatumAt k m B₁ r_B D_B ιD_B C₁ Z₁ f₁ S_rel x
      R'_B e_B ψ_B p_B I₀ ρ₀ h B' v' e_C ψ_nodal)
    (a : Fin m → ℕ) (s : ↑R'_B) (u : (Localization.Away s)ˣ)
    (hs : s ∉ p_B.asIdeal)
    (ha_pos : 1 ≤ ∑ c : Fin m, a c)
    (ha_sub : ∀ c : Fin m, 1 ≤ a c → c ∈ I₀)
    (hu_eq : algebraMap (↑R'_B) (Localization.Away s) h =
      ↑u * ∏ c : Fin m, algebraMap (↑R'_B) (Localization.Away s) (ψ_B (MvPolynomial.X c)) ^ a c) :
    ∃ (R' : CommRingCat.{u}) (v₀ : AlgebraicGeometry.Spec R')
      (e_X : AlgebraicGeometry.Spec R' ⟶ C₁.left)
      (S_bdry : Finset (Fin m))
      (ρ : {c : Fin m // 1 ≤ a c} → Fin r_B)
      (q : AlgebraicGeometry.Spec R' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
        (MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ Ideal.span
          ({MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
            ∏ c : Fin m, MvPolynomial.X (Sum.inr c) ^ a c} :
            Set (MvPolynomial (Fin 2 ⊕ Fin m) k))))),
      IsRelativeToroidalChartAt k m B₁ r_B D_B ιD_B C₁ Z₁ f₁ S_rel x
        R' v₀ e_X a S_bdry ρ q :=
by
  rcases hDatum with ⟨hEt_eB, hEt_ψB, hEt_eC, hEt_ψn, hCommB, hCommC, hv'x, hv'p,
    hInl, hI₀_mem, _hh_mem, hInj_ρ₀, _hSupp, hPreZ₁, hPreDB, hPreS⟩
  
  have hAwayPkg : ∀ {A : Type u} [CommRing A] (r : A),
      ∃ (A_r : CommRingCat.{u}) (lam : A →+* ↑A_r) (e_iso : Localization.Away r ≃+* ↑A_r),
        lam.Etale ∧
        (∀ a_el : A, e_iso (algebraMap A (Localization.Away r) a_el) = lam a_el) ∧
        @IsLocalization.Away A _ r (↑A_r) _ lam.toAlgebra := by
    intro A _ r
    have h_et : (algebraMap A (Localization.Away r)).Etale := by
      rw [RingHom.etale_algebraMap]
      exact Algebra.Etale.of_isLocalizationAway r
    have h_units : ∀ y : Submonoid.powers r, IsUnit (algebraMap A (Localization.Away r) y) :=
      fun y => IsLocalization.map_units (Localization.Away r) y
    have h_surj : ∀ z : Localization.Away r, ∃ x : A × Submonoid.powers r,
        z * algebraMap A (Localization.Away r) x.2 = algebraMap A (Localization.Away r) x.1 :=
      fun z => IsLocalization.surj (Submonoid.powers r) z
    have h_eq : ∀ {x_el y_el : A},
        algebraMap A (Localization.Away r) x_el = algebraMap A (Localization.Away r) y_el →
        ∃ c : Submonoid.powers r, ↑c * x_el = ↑c * y_el :=
      fun hxy => IsLocalization.exists_of_eq (M := Submonoid.powers r) hxy
    let A_r : CommRingCat.{u} := CommRingCat.of (Localization.Away r)
    let e_iso : Localization.Away r ≃+* ↑A_r :=
      { toFun := id, invFun := id, left_inv := fun _ => rfl, right_inv := fun _ => rfl,
        map_mul' := fun _ _ => rfl, map_add' := fun _ _ => rfl }
    let lam : A →+* ↑A_r := e_iso.toRingHom.comp (algebraMap A (Localization.Away r))
    refine ⟨A_r, lam, e_iso, h_et, fun _ => rfl, ?_⟩
    letI : Algebra A (↑A_r) := lam.toAlgebra
    exact
      { map_units := fun y => by
          rcases h_units y with ⟨⟨u₀, v₀, huv, hvu⟩, hu₀⟩
          refine ⟨⟨e_iso u₀, e_iso v₀,
            by rw [← map_mul, huv, map_one],
            by rw [← map_mul, hvu, map_one]⟩, ?_⟩
          simp only [RingHom.algebraMap_toAlgebra, lam, RingHom.comp_apply]
          exact congrArg e_iso hu₀
        surj := fun z => by
          obtain ⟨⟨x_el, s_pow⟩, hxs⟩ := h_surj (e_iso.symm z)
          exact ⟨⟨x_el, s_pow⟩,
            by simpa [RingHom.algebraMap_toAlgebra, lam] using congrArg e_iso hxs⟩
        exists_of_eq := fun {x_el y_el} hxy => h_eq (congrArg e_iso.symm hxy) }
  
  
  
  obtain ⟨R''_B, lam_B, e_s, hEt_lamB_hom, he_s, hLoc_s⟩ := hAwayPkg s
  letI : Algebra (↑R'_B) (↑R''_B) := lam_B.toAlgebra
  haveI : IsLocalization.Away s (↑R''_B) := hLoc_s
  let e''_B : AlgebraicGeometry.Spec R''_B ⟶ B₁.left :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom lam_B) ≫ e_B
  let ψ''_B : MvPolynomial (Fin m) k →+* ↑R''_B := lam_B.comp ψ_B
  have hEt_lamB : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom lam_B)) :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hEt_lamB_hom
  have hEt_ψB_hom : ψ_B.Etale :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hEt_ψB
  have hEt_ψ''B_hom : ψ''_B.Etale :=
    RingHom.Etale.stableUnderComposition ψ_B lam_B hEt_ψB_hom hEt_lamB_hom
  have hEt_ψ''B : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ''_B)) :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hEt_ψ''B_hom
  have hEt_e''B : AlgebraicGeometry.Etale e''_B := inferInstance

  let I₁ : Ideal (MvPolynomial (Fin 2) ↑R'_B) :=
    Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h} :
      Set (MvPolynomial (Fin 2) ↑R'_B))
  let s_Q : MvPolynomial (Fin 2) ↑R'_B ⧸ I₁ := Ideal.Quotient.mk I₁ (MvPolynomial.C s)
  let s_B : ↑B' := ψ_nodal s_Q
  obtain ⟨B'', lam_B', _e_sB, hEt_lamB'_hom, _he_sB, hLoc_sB⟩ := hAwayPkg s_B
  letI : Algebra (↑B') (↑B'') := lam_B'.toAlgebra
  haveI : IsLocalization.Away s_B (↑B'') := hLoc_sB
  have hEt_lamB' : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom lam_B')) :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hEt_lamB'_hom

  
  have hv'p_ideal : Ideal.comap (ψ_nodal.comp ((Ideal.Quotient.mk I₁).comp MvPolynomial.C))
      v'.asIdeal = p_B.asIdeal := by
    have h1 := congrArg PrimeSpectrum.asIdeal hv'p
    rw [AlgebraicGeometry.Spec.map_apply] at h1
    exact h1
  have hs_B_notMem : s_B ∉ v'.asIdeal := by
    intro hs_mem
    apply hs
    rw [← hv'p_ideal]
    exact hs_mem
  have hDisj_sB : Disjoint (Submonoid.powers s_B : Set ↑B') (v'.asIdeal : Set ↑B') := by
    rw [Set.disjoint_left]
    rintro _ ⟨k_pow, rfl⟩ hmem
    exact hs_B_notMem (v'.isPrime.mem_of_pow_mem k_pow hmem)
  let v'' : AlgebraicGeometry.Spec B'' :=
    ⟨Ideal.map lam_B' v'.asIdeal,
      IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers s_B) (↑B'')
        v'.asIdeal v'.isPrime hDisj_sB⟩
  haveI : v''.asIdeal.IsPrime := v''.isPrime
  have hv''_comap : Ideal.comap lam_B' v''.asIdeal = v'.asIdeal :=
    IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers s_B) (↑B'')
      v'.isPrime hDisj_sB
  have hv''_map : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom lam_B')).base v'' = v' := by
    apply PrimeSpectrum.ext
    change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom lam_B') v'').asIdeal = v'.asIdeal
    rw [AlgebraicGeometry.Spec.map_apply]
    exact hv''_comap

  
  let I₂ : Ideal (MvPolynomial (Fin 2) ↑R''_B) :=
    Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C (lam_B h)} :
      Set (MvPolynomial (Fin 2) ↑R''_B))
  let lam_Q : (MvPolynomial (Fin 2) ↑R'_B ⧸ I₁) →+* (MvPolynomial (Fin 2) ↑R''_B ⧸ I₂) :=
    Ideal.Quotient.lift I₁ ((Ideal.Quotient.mk I₂).comp (MvPolynomial.map lam_B)) (by
      intro f hf
      rw [Ideal.mem_span_singleton] at hf
      rcases hf with ⟨g, rfl⟩
      rw [RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton]
      exact ⟨MvPolynomial.map lam_B g, by simp⟩)
  have hlam_Q_C : ∀ r : ↑R'_B,
      lam_Q (Ideal.Quotient.mk I₁ (MvPolynomial.C r)) =
        Ideal.Quotient.mk I₂ (MvPolynomial.C (lam_B r)) := by
    intro r
    simp [lam_Q]
  have hlam_Q_X : ∀ b : Fin 2,
      lam_Q (Ideal.Quotient.mk I₁ (MvPolynomial.X b)) =
        Ideal.Quotient.mk I₂ (MvPolynomial.X b) := by
    intro b
    simp [lam_Q]
  letI : Algebra (MvPolynomial (Fin 2) ↑R'_B ⧸ I₁) (MvPolynomial (Fin 2) ↑R''_B ⧸ I₂) :=
    lam_Q.toAlgebra
  have hIsLoc_Q₂ : IsLocalization.Away s_Q (MvPolynomial (Fin 2) ↑R''_B ⧸ I₂) := by
    obtain ⟨L_cat, lam_L, _e_L, _, _, hLoc_L⟩ := hAwayPkg s_Q
    letI : Algebra (MvPolynomial (Fin 2) ↑R'_B ⧸ I₁) (↑L_cat) := lam_L.toAlgebra
    haveI : IsLocalization.Away s_Q (↑L_cat) := hLoc_L
    have hs_R_unit : IsUnit (lam_B s) :=
      IsLocalization.map_units (↑R''_B) (⟨s, Submonoid.mem_powers s⟩ : Submonoid.powers s)
    have hs_Q_unit : IsUnit (lam_Q s_Q) := by
      change IsUnit (lam_Q (Ideal.Quotient.mk I₁ (MvPolynomial.C s)))
      rw [hlam_Q_C s]
      exact hs_R_unit.map ((Ideal.Quotient.mk I₂).comp MvPolynomial.C)
    let α_loc : (↑L_cat) →+* (MvPolynomial (Fin 2) ↑R''_B ⧸ I₂) :=
      IsLocalization.Away.lift s_Q hs_Q_unit
    let f_R : ↑R'_B →+* ↑L_cat :=
      lam_L.comp ((Ideal.Quotient.mk I₁).comp MvPolynomial.C)
    have hf_R_unit : IsUnit (f_R s) :=
      IsLocalization.map_units (↑L_cat) (⟨s_Q, Submonoid.mem_powers s_Q⟩ : Submonoid.powers s_Q)
    let g_R : ↑R''_B →+* ↑L_cat := IsLocalization.Away.lift s hf_R_unit
    have hg_R_eq : ∀ r : ↑R'_B, g_R (lam_B r) = f_R r :=
      fun r => IsLocalization.Away.lift_eq s hf_R_unit r
    let β_poly : MvPolynomial (Fin 2) ↑R''_B →+* ↑L_cat :=
      MvPolynomial.eval₂Hom g_R (fun b => lam_L (Ideal.Quotient.mk I₁ (MvPolynomial.X b)))
    let β_loc : (MvPolynomial (Fin 2) ↑R''_B ⧸ I₂) →+* ↑L_cat :=
      Ideal.Quotient.lift I₂ β_poly (by
        intro f hf
        rw [Ideal.mem_span_singleton] at hf
        rcases hf with ⟨g, rfl⟩
        simp only [β_poly, map_mul, map_sub, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C,
          hg_R_eq h]
        have hrel : Ideal.Quotient.mk I₁
            (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)
        have hrelL : lam_L (Ideal.Quotient.mk I₁ (MvPolynomial.X 0)) *
            lam_L (Ideal.Quotient.mk I₁ (MvPolynomial.X 1)) - f_R h = 0 := by
          change lam_L (Ideal.Quotient.mk I₁ (MvPolynomial.X 0)) *
              lam_L (Ideal.Quotient.mk I₁ (MvPolynomial.X 1)) -
              lam_L (Ideal.Quotient.mk I₁ (MvPolynomial.C h)) = 0
          rw [← map_mul, ← map_sub, ← map_mul, ← map_sub, hrel, map_zero]
        rw [hrelL, zero_mul])
    have hβ_C_loc : ∀ r₂ : ↑R''_B,
        β_loc (Ideal.Quotient.mk I₂ (MvPolynomial.C r₂)) = g_R r₂ := fun r₂ => by
      simp [β_loc, β_poly]
    have hβ_X_loc : ∀ b : Fin 2,
        β_loc (Ideal.Quotient.mk I₂ (MvPolynomial.X b)) =
          lam_L (Ideal.Quotient.mk I₁ (MvPolynomial.X b)) := fun b => by
      simp [β_loc, β_poly]
    have hα_lamL : ∀ q₁ : MvPolynomial (Fin 2) ↑R'_B ⧸ I₁,
        α_loc (lam_L q₁) = lam_Q q₁ :=
      fun q₁ => IsLocalization.Away.lift_eq s_Q hs_Q_unit q₁
    have h_βα : β_loc.comp α_loc = RingHom.id (↑L_cat) := by
      apply IsLocalization.ringHom_ext (Submonoid.powers s_Q)
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro r
        simp only [RingHom.comp_apply, RingHom.id_apply, RingHom.algebraMap_toAlgebra]
        rw [hα_lamL, hlam_Q_C r, hβ_C_loc, hg_R_eq r]
        rfl
      · intro b
        simp only [RingHom.comp_apply, RingHom.id_apply, RingHom.algebraMap_toAlgebra]
        rw [hα_lamL, hlam_Q_X b, hβ_X_loc]
    have h_R₂_id : (α_loc.comp (β_loc.comp ((Ideal.Quotient.mk I₂).comp MvPolynomial.C))) =
        (Ideal.Quotient.mk I₂).comp MvPolynomial.C := by
      apply IsLocalization.ringHom_ext (Submonoid.powers s)
      ext r
      simp only [RingHom.comp_apply, RingHom.algebraMap_toAlgebra, hβ_C_loc, hg_R_eq r]
      change α_loc (lam_L (Ideal.Quotient.mk I₁ (MvPolynomial.C r))) = _
      rw [hα_lamL, hlam_Q_C r]
    have h_αβ : α_loc.comp β_loc = RingHom.id _ := by
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro r₂
        exact DFunLike.congr_fun h_R₂_id r₂
      · intro b
        simp only [RingHom.comp_apply, RingHom.id_apply, hβ_X_loc, hα_lamL, hlam_Q_X b]
    let α_loc_equiv : (↑L_cat) ≃+* (MvPolynomial (Fin 2) ↑R''_B ⧸ I₂) :=
      { toFun := α_loc
        invFun := β_loc
        left_inv := fun z => DFunLike.congr_fun h_βα z
        right_inv := fun z => DFunLike.congr_fun h_αβ z
        map_mul' := map_mul α_loc
        map_add' := map_add α_loc }
    let e_loc : (↑L_cat) ≃ₐ[MvPolynomial (Fin 2) ↑R'_B ⧸ I₁] (MvPolynomial (Fin 2) ↑R''_B ⧸ I₂) :=
      AlgEquiv.ofRingEquiv (f := α_loc_equiv) hα_lamL
    exact IsLocalization.isLocalization_of_algEquiv (Submonoid.powers s_Q) e_loc
  haveI : IsLocalization.Away s_Q (MvPolynomial (Fin 2) ↑R''_B ⧸ I₂) := hIsLoc_Q₂

  
  have hEt_ψn_hom : ψ_nodal.Etale :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hEt_ψn
  have hIsLoc_B''_map : IsLocalization (Submonoid.map ψ_nodal (Submonoid.powers s_Q)) (↑B'') := by
    rw [Submonoid.map_powers]
    exact inferInstanceAs (IsLocalization (Submonoid.powers s_B) (↑B''))
  haveI : IsLocalization (Submonoid.map ψ_nodal (Submonoid.powers s_Q)) (↑B'') := hIsLoc_B''_map
  let ψ''_nodal : (MvPolynomial (Fin 2) ↑R''_B ⧸ I₂) →+* ↑B'' :=
    IsLocalization.map (↑B'') ψ_nodal (Submonoid.le_comap_map (Submonoid.powers s_Q))
  have hEt_ψ''n_hom : ψ''_nodal.Etale :=
    RingHom.Etale.isStableUnderBaseChange.isLocalization_map
      (Submonoid.powers s_Q) ψ_nodal hEt_ψn_hom
  have hψ''n_eq : ∀ q₁ : MvPolynomial (Fin 2) ↑R'_B ⧸ I₁,
      ψ''_nodal (lam_Q q₁) = lam_B' (ψ_nodal q₁) :=
    fun q₁ => IsLocalization.map_eq (Submonoid.le_comap_map (Submonoid.powers s_Q)) q₁

  
  let P₂ : ↑R''_B := ∏ c : Fin m, ψ''_B (MvPolynomial.X c) ^ a c
  let u_val : ↑R''_B := e_s ↑u
  let u_inv : ↑R''_B := e_s ↑u⁻¹
  have hu_mul_inv : u_val * u_inv = 1 := by
    change e_s ↑u * e_s ↑u⁻¹ = 1
    rw [← map_mul, Units.mul_inv u, map_one]
  have hu_inv_mul : u_inv * u_val = 1 := by
    change e_s ↑u⁻¹ * e_s ↑u = 1
    rw [← map_mul, Units.inv_mul u, map_one]
  have hu_P₂ : lam_B h = u_val * P₂ := by
    rw [← he_s h, hu_eq, map_mul, map_prod]
    congr 1
    refine Finset.prod_congr rfl fun c _ => ?_
    rw [map_pow, he_s]
    rfl
  let I_rel : Ideal (MvPolynomial (Fin 2) ↑R''_B) :=
    Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C P₂} :
      Set (MvPolynomial (Fin 2) ↑R''_B))
  let α_u_hom : (MvPolynomial (Fin 2) ↑R''_B ⧸ I_rel) →+* (MvPolynomial (Fin 2) ↑R''_B ⧸ I₂) :=
    Ideal.Quotient.lift I_rel
      (MvPolynomial.eval₂Hom ((Ideal.Quotient.mk I₂).comp MvPolynomial.C)
        ![Ideal.Quotient.mk I₂ (MvPolynomial.C u_inv * MvPolynomial.X 0),
          Ideal.Quotient.mk I₂ (MvPolynomial.X 1)])
      (by
        intro f hf
        rw [Ideal.mem_span_singleton] at hf
        rcases hf with ⟨g, rfl⟩
        rw [map_mul]
        have hrel : MvPolynomial.eval₂Hom ((Ideal.Quotient.mk I₂).comp MvPolynomial.C)
            ![Ideal.Quotient.mk I₂ (MvPolynomial.C u_inv * MvPolynomial.X 0),
              Ideal.Quotient.mk I₂ (MvPolynomial.X 1)]
            (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C P₂) = 0 := by
          simp only [map_sub, map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C,
            Matrix.cons_val_zero, Matrix.cons_val_one, RingHom.comp_apply]
          rw [← map_mul, ← map_mul, ← map_sub, Ideal.Quotient.eq_zero_iff_mem,
            Ideal.mem_span_singleton]
          refine ⟨MvPolynomial.C u_inv, ?_⟩
          have hC : (MvPolynomial.C P₂ : MvPolynomial (Fin 2) ↑R''_B) =
              MvPolynomial.C (lam_B h) * MvPolynomial.C u_inv := by
            rw [← map_mul, hu_P₂, mul_comm u_val P₂, mul_assoc, hu_mul_inv, mul_one]
          rw [hC]
          ring
        rw [hrel, zero_mul])
  let β_u_hom : (MvPolynomial (Fin 2) ↑R''_B ⧸ I₂) →+* (MvPolynomial (Fin 2) ↑R''_B ⧸ I_rel) :=
    Ideal.Quotient.lift I₂
      (MvPolynomial.eval₂Hom ((Ideal.Quotient.mk I_rel).comp MvPolynomial.C)
        ![Ideal.Quotient.mk I_rel (MvPolynomial.C u_val * MvPolynomial.X 0),
          Ideal.Quotient.mk I_rel (MvPolynomial.X 1)])
      (by
        intro f hf
        rw [Ideal.mem_span_singleton] at hf
        rcases hf with ⟨g, rfl⟩
        rw [map_mul]
        have hrel : MvPolynomial.eval₂Hom ((Ideal.Quotient.mk I_rel).comp MvPolynomial.C)
            ![Ideal.Quotient.mk I_rel (MvPolynomial.C u_val * MvPolynomial.X 0),
              Ideal.Quotient.mk I_rel (MvPolynomial.X 1)]
            (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C (lam_B h)) = 0 := by
          simp only [map_sub, map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C,
            Matrix.cons_val_zero, Matrix.cons_val_one, RingHom.comp_apply]
          rw [← map_mul, ← map_mul, ← map_sub, Ideal.Quotient.eq_zero_iff_mem,
            Ideal.mem_span_singleton]
          refine ⟨MvPolynomial.C u_val, ?_⟩
          have hC : (MvPolynomial.C (lam_B h) : MvPolynomial (Fin 2) ↑R''_B) =
              MvPolynomial.C P₂ * MvPolynomial.C u_val := by
            rw [← map_mul, hu_P₂, mul_comm]
          rw [hC]
          ring
        rw [hrel, zero_mul])
  have hα_C : ∀ r₂ : ↑R''_B,
      α_u_hom (Ideal.Quotient.mk I_rel (MvPolynomial.C r₂)) =
        Ideal.Quotient.mk I₂ (MvPolynomial.C r₂) := fun r₂ => by simp [α_u_hom]
  have hα_X0 : α_u_hom (Ideal.Quotient.mk I_rel (MvPolynomial.X 0)) =
      Ideal.Quotient.mk I₂ (MvPolynomial.C u_inv * MvPolynomial.X 0) := by simp [α_u_hom]
  have hα_X1 : α_u_hom (Ideal.Quotient.mk I_rel (MvPolynomial.X 1)) =
      Ideal.Quotient.mk I₂ (MvPolynomial.X 1) := by simp [α_u_hom]
  have hβ_C : ∀ r₂ : ↑R''_B,
      β_u_hom (Ideal.Quotient.mk I₂ (MvPolynomial.C r₂)) =
        Ideal.Quotient.mk I_rel (MvPolynomial.C r₂) := fun r₂ => by simp [β_u_hom]
  have hβ_X0 : β_u_hom (Ideal.Quotient.mk I₂ (MvPolynomial.X 0)) =
      Ideal.Quotient.mk I_rel (MvPolynomial.C u_val * MvPolynomial.X 0) := by simp [β_u_hom]
  have hβ_X1 : β_u_hom (Ideal.Quotient.mk I₂ (MvPolynomial.X 1)) =
      Ideal.Quotient.mk I_rel (MvPolynomial.X 1) := by simp [β_u_hom]
  have h_βα_u : β_u_hom.comp α_u_hom = RingHom.id _ := by
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext
    · intro r₂
      simp only [RingHom.comp_apply, RingHom.id_apply, hα_C, hβ_C]
    · rw [Fin.forall_fin_two]
      constructor
      · simp only [RingHom.comp_apply, RingHom.id_apply, hα_X0, map_mul, hβ_C, hβ_X0]
        have h1 : Ideal.Quotient.mk I_rel (MvPolynomial.C u_inv) *
            Ideal.Quotient.mk I_rel (MvPolynomial.C u_val) = 1 := by
          rw [← map_mul, ← MvPolynomial.C_mul, hu_inv_mul, MvPolynomial.C_1, map_one]
        rw [← mul_assoc, h1, one_mul]
      · simp only [RingHom.comp_apply, RingHom.id_apply, hα_X1, hβ_X1]
  have h_αβ_u : α_u_hom.comp β_u_hom = RingHom.id _ := by
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext
    · intro r₂
      simp only [RingHom.comp_apply, RingHom.id_apply, hβ_C, hα_C]
    · rw [Fin.forall_fin_two]
      constructor
      · simp only [RingHom.comp_apply, RingHom.id_apply, hβ_X0, map_mul, hα_C, hα_X0]
        have h1 : Ideal.Quotient.mk I₂ (MvPolynomial.C u_val) *
            Ideal.Quotient.mk I₂ (MvPolynomial.C u_inv) = 1 := by
          rw [← map_mul, ← MvPolynomial.C_mul, hu_mul_inv, MvPolynomial.C_1, map_one]
        rw [← mul_assoc, h1, one_mul]
      · simp only [RingHom.comp_apply, RingHom.id_apply, hβ_X1, hα_X1]
  let α_u : (MvPolynomial (Fin 2) ↑R''_B ⧸ I_rel) ≃+* (MvPolynomial (Fin 2) ↑R''_B ⧸ I₂) :=
    { toFun := α_u_hom
      invFun := β_u_hom
      left_inv := fun z => DFunLike.congr_fun h_βα_u z
      right_inv := fun z => DFunLike.congr_fun h_αβ_u z
      map_mul' := map_mul α_u_hom
      map_add' := map_add α_u_hom }
  let ψ_rel₀ : (MvPolynomial (Fin 2) ↑R''_B ⧸ I_rel) →+* ↑B'' := ψ''_nodal.comp α_u.toRingHom
  have hEt_ψrel₀_hom : ψ_rel₀.Etale :=
    RingHom.Etale.stableUnderComposition α_u.toRingHom ψ''_nodal
      (RingHom.Etale.of_bijective α_u.bijective) hEt_ψ''n_hom
  have hBase_ψrel₀ : ∀ r : ↑R'_B,
      ψ_rel₀ (Ideal.Quotient.mk I_rel (MvPolynomial.C (lam_B r))) =
        lam_B' (ψ_nodal (Ideal.Quotient.mk I₁ (MvPolynomial.C r))) := by
    intro r
    change ψ''_nodal (α_u_hom (Ideal.Quotient.mk I_rel (MvPolynomial.C (lam_B r)))) =
      lam_B' (ψ_nodal (Ideal.Quotient.mk I₁ (MvPolynomial.C r)))
    rw [hα_C, ← hlam_Q_C r]
    exact hψ''n_eq (Ideal.Quotient.mk I₁ (MvPolynomial.C r))
  have hInl_ψrel₀ : ∀ (I : Ideal ↑B'') (b : Fin 2),
      ψ_rel₀ (Ideal.Quotient.mk I_rel (MvPolynomial.X b)) ∈ I ↔
        lam_B' (ψ_nodal (Ideal.Quotient.mk I₁ (MvPolynomial.X b))) ∈ I := by
    intro I
    rw [Fin.forall_fin_two]
    constructor
    · change ψ''_nodal (α_u_hom (Ideal.Quotient.mk I_rel (MvPolynomial.X 0))) ∈ I ↔
        lam_B' (ψ_nodal (Ideal.Quotient.mk I₁ (MvPolynomial.X 0))) ∈ I
      rw [hα_X0, map_mul, map_mul, ← hlam_Q_X 0, hψ''n_eq]
      have hu_inv_unit : IsUnit (u_inv : ↑R''_B) :=
        ⟨⟨u_inv, u_val, hu_inv_mul, hu_mul_inv⟩, rfl⟩
      have h_unit_B'' : IsUnit (ψ''_nodal (Ideal.Quotient.mk I₂ (MvPolynomial.C u_inv))) :=
        hu_inv_unit.map (ψ''_nodal.comp ((Ideal.Quotient.mk I₂).comp MvPolynomial.C))
      exact I.unit_mul_mem_iff_mem h_unit_B''
    · change ψ''_nodal (α_u_hom (Ideal.Quotient.mk I_rel (MvPolynomial.X 1))) ∈ I ↔
        lam_B' (ψ_nodal (Ideal.Quotient.mk I₁ (MvPolynomial.X 1))) ∈ I
      rw [hα_X1, ← hlam_Q_X 1, hψ''n_eq]

  
  
  
  let I_M : Ideal (MvPolynomial (Fin 2 ⊕ Fin m) k) :=
    Ideal.span ({MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
      ∏ c : Fin m, MvPolynomial.X (Sum.inr c) ^ a c} :
      Set (MvPolynomial (Fin 2 ⊕ Fin m) k))
  let ι_poly : MvPolynomial (Fin 2 ⊕ Fin m) k →+* (MvPolynomial (Fin 2) ↑R''_B ⧸ I_rel) :=
    MvPolynomial.eval₂Hom
      (((Ideal.Quotient.mk I_rel).comp MvPolynomial.C).comp (ψ''_B.comp MvPolynomial.C))
      (Sum.elim
        (fun b => Ideal.Quotient.mk I_rel (MvPolynomial.X b))
        (fun c => Ideal.Quotient.mk I_rel (MvPolynomial.C (ψ''_B (MvPolynomial.X c)))))
  let ι_tor : (MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ I_M) →+* (MvPolynomial (Fin 2) ↑R''_B ⧸ I_rel) :=
    Ideal.Quotient.lift I_M ι_poly (by
      intro f hf
      rw [Ideal.mem_span_singleton] at hf
      rcases hf with ⟨g, rfl⟩
      simp only [ι_poly, map_mul, map_sub, map_prod, map_pow, MvPolynomial.eval₂Hom_X',
        Sum.elim_inl, Sum.elim_inr]
      have hprod : (∏ c : Fin m,
          Ideal.Quotient.mk I_rel (MvPolynomial.C (ψ''_B (MvPolynomial.X c))) ^ a c) =
          Ideal.Quotient.mk I_rel (MvPolynomial.C P₂) := by
        simp only [P₂, ← map_pow, ← map_prod]
      rw [hprod, ← map_mul, ← map_sub]
      have hrel : Ideal.Quotient.mk I_rel
          (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C P₂) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)
      rw [hrel, zero_mul])
  have hι_inl : ∀ b : Fin 2,
      ι_tor (Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inl b))) =
        Ideal.Quotient.mk I_rel (MvPolynomial.X b) := fun b => by simp [ι_tor, ι_poly]
  have hι_inr : ∀ c : Fin m,
      ι_tor (Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inr c))) =
        Ideal.Quotient.mk I_rel (MvPolynomial.C (ψ''_B (MvPolynomial.X c))) :=
    fun c => by simp [ι_tor, ι_poly]
  have hι_C : ∀ α : k,
      ι_tor (Ideal.Quotient.mk I_M (MvPolynomial.C α)) =
        Ideal.Quotient.mk I_rel (MvPolynomial.C (ψ''_B (MvPolynomial.C α))) := by
    intro α
    simp [ι_tor, ι_poly]

  
  obtain ⟨M_cat, e_M, _⟩ : ∃ (M_cat : CommRingCat.{u})
      (_ : (MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ I_M) ≃+* ↑M_cat), True :=
    ⟨CommRingCat.of _, RingEquiv.refl _, trivial⟩
  obtain ⟨Q_cat, e_Q, _⟩ : ∃ (Q_cat : CommRingCat.{u})
      (_ : (MvPolynomial (Fin 2) ↑R''_B ⧸ I_rel) ≃+* ↑Q_cat), True :=
    ⟨CommRingCat.of _, RingEquiv.refl _, trivial⟩

  
  have hEt_ιtor_hom : ι_tor.Etale := by
    let ι_tor' : (↑M_cat) →+* (↑Q_cat) :=
      e_Q.toRingHom.comp (ι_tor.comp e_M.symm.toRingHom)
    let μ_m : MvPolynomial (Fin m) k →+* (↑M_cat) :=
      e_M.toRingHom.comp (MvPolynomial.eval₂Hom ((Ideal.Quotient.mk I_M).comp MvPolynomial.C)
        (fun c => Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inr c))))
    let μ_Q : MvPolynomial (Fin m) k →+* (↑Q_cat) :=
      e_Q.toRingHom.comp (((Ideal.Quotient.mk I_rel).comp MvPolynomial.C).comp ψ''_B)
    letI : Algebra (MvPolynomial (Fin m) k) (↑M_cat) := μ_m.toAlgebra
    letI : Algebra (MvPolynomial (Fin m) k) (↑R''_B) := ψ''_B.toAlgebra
    letI : Algebra (MvPolynomial (Fin m) k) (↑Q_cat) := μ_Q.toAlgebra
    haveI : Algebra.Etale (MvPolynomial (Fin m) k) (↑R''_B) :=
      RingHom.etale_algebraMap.mp hEt_ψ''B_hom
    have h_comm_Pm : ∀ p : MvPolynomial (Fin m) k, ι_tor' (μ_m p) = μ_Q p := by
      have h_eq_hom : ι_tor'.comp μ_m = μ_Q := by
        apply MvPolynomial.ringHom_ext
        · intro α
          simp only [RingHom.comp_apply, ι_tor', μ_m, μ_Q, MvPolynomial.eval₂Hom_C]
          change e_Q (ι_tor (e_M.symm (e_M (Ideal.Quotient.mk I_M (MvPolynomial.C α))))) = _
          rw [RingEquiv.symm_apply_apply]
          exact congrArg e_Q (hι_C α)
        · intro c
          simp only [RingHom.comp_apply, ι_tor', μ_m, μ_Q, MvPolynomial.eval₂Hom_X']
          change e_Q (ι_tor (e_M.symm (e_M (Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inr c)))))) = _
          rw [RingEquiv.symm_apply_apply]
          exact congrArg e_Q (hι_inr c)
      exact fun p => DFunLike.congr_fun h_eq_hom p
    let ι_tor_alg : (↑M_cat) →ₐ[MvPolynomial (Fin m) k] (↑Q_cat) :=
      { ι_tor' with commutes' := h_comm_Pm }
    let inr_alg : (↑R''_B) →ₐ[MvPolynomial (Fin m) k] (↑Q_cat) :=
      { e_Q.toRingHom.comp ((Ideal.Quotient.mk I_rel).comp MvPolynomial.C) with
        commutes' := fun _ => rfl }
    let Φ_alg : TensorProduct (MvPolynomial (Fin m) k) (↑M_cat) (↑R''_B) →ₐ[MvPolynomial (Fin m) k]
        (↑Q_cat) :=
      Algebra.TensorProduct.lift ι_tor_alg inr_alg (fun _ _ => Commute.all _ _)
    let Ψ_poly : MvPolynomial (Fin 2) (↑R''_B) →+*
        TensorProduct (MvPolynomial (Fin m) k) (↑M_cat) (↑R''_B) :=
      MvPolynomial.eval₂Hom
        (Algebra.TensorProduct.includeRight
          (R := MvPolynomial (Fin m) k) (A := ↑M_cat) (B := ↑R''_B)).toRingHom
        (fun b => (e_M (Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inl b))))
          ⊗ₜ[MvPolynomial (Fin m) k] (1 : ↑R''_B))
    let Ψ_raw : (MvPolynomial (Fin 2) ↑R''_B ⧸ I_rel) →+*
        TensorProduct (MvPolynomial (Fin m) k) (↑M_cat) (↑R''_B) :=
      Ideal.Quotient.lift I_rel Ψ_poly (by
        intro f hf
        rw [Ideal.mem_span_singleton] at hf
        rcases hf with ⟨g, rfl⟩
        simp only [Ψ_poly, map_mul, map_sub, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C,
          AlgHom.toRingHom_eq_coe, RingHom.coe_coe, Algebra.TensorProduct.includeRight_apply]
        have hrel_M : e_M (Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inl 0))) *
            e_M (Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inl 1))) =
            μ_m (∏ c : Fin m, MvPolynomial.X c ^ a c) := by
          have hμ_prod : μ_m (∏ c : Fin m, MvPolynomial.X c ^ a c) =
              e_M (Ideal.Quotient.mk I_M (∏ c : Fin m, MvPolynomial.X (Sum.inr c) ^ a c)) := by
            simp [μ_m]
          rw [hμ_prod, ← map_mul, ← map_mul]
          congr 1
          apply sub_eq_zero.mp
          rw [← map_sub, Ideal.Quotient.eq_zero_iff_mem]
          exact Ideal.mem_span_singleton_self _
        have htmul : ((e_M (Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inl 0))))
              ⊗ₜ[MvPolynomial (Fin m) k] (1 : ↑R''_B)) *
            ((e_M (Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inl 1))))
              ⊗ₜ[MvPolynomial (Fin m) k] (1 : ↑R''_B)) =
            (1 : ↑M_cat) ⊗ₜ[MvPolynomial (Fin m) k] P₂ := by
          rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, hrel_M]
          let mono_P : MvPolynomial (Fin m) k :=
            ∏ c : Fin m, (MvPolynomial.X c : MvPolynomial (Fin m) k) ^ a c
          have hsmul1 : μ_m mono_P = mono_P • (1 : ↑M_cat) := by
            rw [Algebra.smul_def, mul_one]
            rfl
          have hsmul2 : P₂ = mono_P • (1 : ↑R''_B) := by
            rw [Algebra.smul_def, mul_one]
            change P₂ = ψ''_B mono_P
            simp [P₂, mono_P]
          change μ_m mono_P ⊗ₜ[MvPolynomial (Fin m) k] (1 : ↑R''_B) =
            (1 : ↑M_cat) ⊗ₜ[MvPolynomial (Fin m) k] P₂
          rw [hsmul1, hsmul2, TensorProduct.smul_tmul mono_P]
        rw [htmul, sub_self, zero_mul])
    let Ψ_hom : (↑Q_cat) →+* TensorProduct (MvPolynomial (Fin m) k) (↑M_cat) (↑R''_B) :=
      Ψ_raw.comp e_Q.symm.toRingHom
    have h_ΦΨ : Φ_alg.toRingHom.comp Ψ_hom = RingHom.id _ := by
      have h_ΦΨ_raw : (Φ_alg.toRingHom.comp Ψ_raw) = e_Q.toRingHom := by
        apply Ideal.Quotient.ringHom_ext
        apply MvPolynomial.ringHom_ext
        · intro r₂
          simp [Φ_alg, Ψ_raw, Ψ_poly, inr_alg]
        · intro b
          simp only [RingHom.comp_apply, Φ_alg, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
          change Φ_alg (Ψ_raw (Ideal.Quotient.mk I_rel (MvPolynomial.X b))) =
            e_Q (Ideal.Quotient.mk I_rel (MvPolynomial.X b))
          simp only [Ψ_raw, Ideal.Quotient.lift_mk, Ψ_poly, MvPolynomial.eval₂Hom_X',
            Φ_alg, Algebra.TensorProduct.lift_tmul, map_one, mul_one, ι_tor_alg, AlgHom.coe_mk]
          change e_Q (ι_tor (e_M.symm (e_M (Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inl b)))))) =
            e_Q (Ideal.Quotient.mk I_rel (MvPolynomial.X b))
          rw [RingEquiv.symm_apply_apply, hι_inl b]
      apply RingHom.ext
      intro q_el
      simp only [RingHom.comp_apply, RingHom.id_apply, Ψ_hom]
      have h1 := DFunLike.congr_fun h_ΦΨ_raw (e_Q.symm q_el)
      simpa using h1
    let Ψ_alg : (↑Q_cat) →ₐ[MvPolynomial (Fin m) k]
        TensorProduct (MvPolynomial (Fin m) k) (↑M_cat) (↑R''_B) :=
      { Ψ_hom with
        commutes' := fun p => by
          change Ψ_raw (e_Q.symm (e_Q (Ideal.Quotient.mk I_rel (MvPolynomial.C (ψ''_B p))))) =
            algebraMap (MvPolynomial (Fin m) k)
              (TensorProduct (MvPolynomial (Fin m) k) (↑M_cat) (↑R''_B)) p
          rw [RingEquiv.symm_apply_apply]
          simp only [Ψ_raw, Ideal.Quotient.lift_mk, Ψ_poly, MvPolynomial.eval₂Hom_C,
            AlgHom.toRingHom_eq_coe, RingHom.coe_coe, Algebra.TensorProduct.includeRight_apply]
          have hp1 : ψ''_B p = p • (1 : ↑R''_B) := by
            rw [Algebra.smul_def, mul_one]
            rfl
          rw [hp1, ← TensorProduct.smul_tmul p, Algebra.smul_def, mul_one]
          rfl }
    have h_ΨΦ_alg : Ψ_alg.comp Φ_alg = AlgHom.id (MvPolynomial (Fin m) k) _ := by
      apply Algebra.TensorProduct.ext
      · apply AlgHom.coe_ringHom_injective
        have h_left_raw : (Ψ_hom.comp ι_tor').comp e_M.toRingHom =
            (Algebra.TensorProduct.includeLeftRingHom :
              (↑M_cat) →+* TensorProduct (MvPolynomial (Fin m) k) (↑M_cat) (↑R''_B)).comp
              e_M.toRingHom := by
          apply Ideal.Quotient.ringHom_ext
          apply MvPolynomial.ringHom_ext
          · intro α
            change Ψ_raw (e_Q.symm (e_Q (ι_tor (e_M.symm (e_M
              (Ideal.Quotient.mk I_M (MvPolynomial.C α))))))) =
              (e_M (Ideal.Quotient.mk I_M (MvPolynomial.C α)))
                ⊗ₜ[MvPolynomial (Fin m) k] (1 : ↑R''_B)
            rw [RingEquiv.symm_apply_apply, RingEquiv.symm_apply_apply, hι_C α]
            simp only [Ψ_raw, Ideal.Quotient.lift_mk, Ψ_poly, MvPolynomial.eval₂Hom_C,
              AlgHom.toRingHom_eq_coe, RingHom.coe_coe, Algebra.TensorProduct.includeRight_apply]
            have hμ_C : e_M (Ideal.Quotient.mk I_M (MvPolynomial.C α)) =
                μ_m (MvPolynomial.C α) := by simp [μ_m]
            rw [hμ_C]
            have h1 : ψ''_B (MvPolynomial.C α) =
                (MvPolynomial.C α : MvPolynomial (Fin m) k) • (1 : ↑R''_B) := by
              rw [Algebra.smul_def, mul_one]; rfl
            have h2 : μ_m (MvPolynomial.C α) =
                (MvPolynomial.C α : MvPolynomial (Fin m) k) • (1 : ↑M_cat) := by
              rw [Algebra.smul_def, mul_one]; rfl
            rw [h1, h2, TensorProduct.smul_tmul (MvPolynomial.C α : MvPolynomial (Fin m) k)]
          · rintro (b | c)
            · change Ψ_raw (e_Q.symm (e_Q (ι_tor (e_M.symm (e_M
                (Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inl b)))))))) =
                (e_M (Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inl b))))
                  ⊗ₜ[MvPolynomial (Fin m) k] (1 : ↑R''_B)
              rw [RingEquiv.symm_apply_apply, RingEquiv.symm_apply_apply, hι_inl b]
              simp [Ψ_raw, Ψ_poly]
            · change Ψ_raw (e_Q.symm (e_Q (ι_tor (e_M.symm (e_M
                (Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inr c)))))))) =
                (e_M (Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inr c))))
                  ⊗ₜ[MvPolynomial (Fin m) k] (1 : ↑R''_B)
              rw [RingEquiv.symm_apply_apply, RingEquiv.symm_apply_apply, hι_inr c]
              simp only [Ψ_raw, Ideal.Quotient.lift_mk, Ψ_poly, MvPolynomial.eval₂Hom_C,
                AlgHom.toRingHom_eq_coe, RingHom.coe_coe, Algebra.TensorProduct.includeRight_apply]
              have hμ_X : e_M (Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inr c))) =
                  μ_m (MvPolynomial.X c) := by simp [μ_m]
              rw [hμ_X]
              have h1 : ψ''_B (MvPolynomial.X c) =
                  (MvPolynomial.X c : MvPolynomial (Fin m) k) • (1 : ↑R''_B) := by
                rw [Algebra.smul_def, mul_one]; rfl
              have h2 : μ_m (MvPolynomial.X c) =
                  (MvPolynomial.X c : MvPolynomial (Fin m) k) • (1 : ↑M_cat) := by
                rw [Algebra.smul_def, mul_one]; rfl
              rw [h1, h2, TensorProduct.smul_tmul (MvPolynomial.X c : MvPolynomial (Fin m) k)]
        apply RingHom.ext
        intro m_el
        change Ψ_alg (Φ_alg (m_el ⊗ₜ[MvPolynomial (Fin m) k] (1 : ↑R''_B))) =
          m_el ⊗ₜ[MvPolynomial (Fin m) k] (1 : ↑R''_B)
        simp only [Φ_alg, Algebra.TensorProduct.lift_tmul, map_one, mul_one]
        have hm := DFunLike.congr_fun h_left_raw (e_M.symm m_el)
        simpa [Ψ_alg, ι_tor_alg, RingHom.comp_apply] using hm
      · apply AlgHom.coe_ringHom_injective
        apply RingHom.ext
        intro r₂
        change Ψ_alg (Φ_alg ((1 : ↑M_cat) ⊗ₜ[MvPolynomial (Fin m) k] r₂)) =
          (1 : ↑M_cat) ⊗ₜ[MvPolynomial (Fin m) k] r₂
        simp only [Φ_alg, Algebra.TensorProduct.lift_tmul, map_one, one_mul, Ψ_alg, AlgHom.coe_mk]
        change Ψ_raw (e_Q.symm (e_Q (Ideal.Quotient.mk I_rel (MvPolynomial.C r₂)))) =
          (1 : ↑M_cat) ⊗ₜ[MvPolynomial (Fin m) k] r₂
        rw [RingEquiv.symm_apply_apply]
        simp [Ψ_raw, Ψ_poly]
    have h_ΨΦ : Ψ_hom.comp Φ_alg.toRingHom = RingHom.id _ :=
      congrArg AlgHom.toRingHom h_ΨΦ_alg
    let Φ_equiv : TensorProduct (MvPolynomial (Fin m) k) (↑M_cat) (↑R''_B) ≃+* (↑Q_cat) :=
      { toFun := Φ_alg.toRingHom
        invFun := Ψ_hom
        left_inv := fun z => DFunLike.congr_fun h_ΨΦ z
        right_inv := fun z => DFunLike.congr_fun h_ΦΨ z
        map_mul' := map_mul Φ_alg.toRingHom
        map_add' := map_add Φ_alg.toRingHom }
    have h_inl_et : (Algebra.TensorProduct.includeLeftRingHom :
        (↑M_cat) →+* TensorProduct (MvPolynomial (Fin m) k) (↑M_cat) (↑R''_B)).Etale := by
      rw [show (Algebra.TensorProduct.includeLeftRingHom :
          (↑M_cat) →+* TensorProduct (MvPolynomial (Fin m) k) (↑M_cat) (↑R''_B)) =
          algebraMap (↑M_cat) (TensorProduct (MvPolynomial (Fin m) k) (↑M_cat) (↑R''_B)) from rfl,
        RingHom.etale_algebraMap]
      exact Algebra.Etale.baseChange (MvPolynomial (Fin m) k) (↑R''_B) (↑M_cat)
    have hEt_ιtor' : ι_tor'.Etale := by
      have h_comp_ι : Φ_equiv.toRingHom.comp Algebra.TensorProduct.includeLeftRingHom = ι_tor' := by
        apply RingHom.ext
        intro m₀
        simp [Φ_equiv, Φ_alg, ι_tor_alg]
      rw [← h_comp_ι]
      exact RingHom.Etale.stableUnderComposition _ _ h_inl_et
        (RingHom.Etale.of_bijective Φ_equiv.bijective)
    have h_unw : e_Q.symm.toRingHom.comp (ι_tor'.comp e_M.toRingHom) = ι_tor := by
      apply RingHom.ext
      intro x_m
      change e_Q.symm (e_Q (ι_tor (e_M.symm (e_M x_m)))) = ι_tor x_m
      rw [RingEquiv.symm_apply_apply, RingEquiv.symm_apply_apply]
    rw [← h_unw]
    exact RingHom.Etale.stableUnderComposition _ _
      (RingHom.Etale.stableUnderComposition _ _
        (RingHom.Etale.of_bijective e_M.bijective) hEt_ιtor')
      (RingHom.Etale.of_bijective e_Q.symm.bijective)

  
  let φ_q₀ : (MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ I_M) →+* ↑B'' := ψ_rel₀.comp ι_tor
  have hEt_φq₀_hom : φ_q₀.Etale :=
    RingHom.Etale.stableUnderComposition ι_tor ψ_rel₀ hEt_ιtor_hom hEt_ψrel₀_hom
  let φ_q₀' : (↑M_cat) →+* ↑B'' := φ_q₀.comp e_M.symm.toRingHom
  have hEt_φq₀'_hom : φ_q₀'.Etale :=
    RingHom.Etale.stableUnderComposition _ _
      (RingHom.Etale.of_bijective e_M.symm.bijective) hEt_φq₀_hom
  letI : Algebra (↑M_cat) (↑B'') := φ_q₀'.toAlgebra
  haveI : Algebra.Etale (↑M_cat) (↑B'') := RingHom.etale_algebraMap.mp hEt_φq₀'_hom
  haveI : IsNoetherianRing (MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ I_M) :=
    Ideal.Quotient.isNoetherianRing I_M
  haveI : IsNoetherianRing (↑M_cat) :=
    isNoetherianRing_of_ringEquiv (MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ I_M) e_M
  haveI : IsNoetherianRing (↑B'') := Algebra.FiniteType.isNoetherianRing (↑M_cat) (↑B'')

  
  let ι_act := {c : Fin m // 1 ≤ a c}
  let I_br : ι_act → Ideal (MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ I_M) := fun i =>
    Ideal.span ({Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inl 0)),
      Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inl 1)),
      Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inr i.1))} :
      Set (MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ I_M))
  let J_act : ι_act → Ideal (↑B'') := fun i => Ideal.map φ_q₀ (I_br i)

  have hDom_act : ∀ (i : ι_act) (q_p : Ideal (↑B'' ⧸ J_act i)) [q_p.IsPrime],
      IsDomain (Localization.AtPrime q_p) := by
    intro i
    let c₀ : Fin m := i.1
    have hc₀ : 1 ≤ a c₀ := i.2
    have hm : (m - 1) + 1 = m := by
      have := c₀.isLt
      omega
    let e_fin : Fin ((m - 1) + 1) ≃ Fin m := finCongr hm
    let c'₀ : Fin ((m - 1) + 1) := e_fin.symm c₀
    let σ_c : Fin (m - 1) → Fin m := fun j => e_fin (c'₀.succAbove j)
    have hσ_ne : ∀ j : Fin (m - 1), σ_c j ≠ c₀ := by
      intro j hj
      have hj' : c'₀.succAbove j = c'₀ := by
        simpa [σ_c, c'₀] using congrArg e_fin.symm hj
      exact Fin.succAbove_ne c'₀ j hj'
    have hσ_inj : Function.Injective σ_c :=
      e_fin.injective.comp Fin.succAbove_right_injective
    have hσ_surj : ∀ (c : Fin m), c ≠ c₀ → ∃ j : Fin (m - 1), σ_c j = c := by
      intro c hc
      have hc' : e_fin.symm c ≠ c'₀ := fun h_eq => hc (by simpa [c'₀] using congrArg e_fin h_eq)
      obtain ⟨j, hj⟩ := Fin.exists_succAbove_eq hc'
      exact ⟨j, by simpa [σ_c] using congrArg e_fin hj⟩
    let γ_hom : MvPolynomial (Fin (m - 1)) k →+*
        ((MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ I_M) ⧸ I_br i) :=
      MvPolynomial.eval₂Hom
        (((Ideal.Quotient.mk (I_br i)).comp (Ideal.Quotient.mk I_M)).comp MvPolynomial.C)
        (fun j => Ideal.Quotient.mk (I_br i)
          (Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inr (σ_c j)))))
    let var_map : Fin 2 ⊕ Fin m → MvPolynomial (Fin (m - 1)) k :=
      Sum.elim (fun _ => 0) (fun c =>
        if hc : c = c₀ then 0 else MvPolynomial.X (Classical.choose (hσ_surj c hc)))
    let δ₀ : MvPolynomial (Fin 2 ⊕ Fin m) k →+* MvPolynomial (Fin (m - 1)) k :=
      MvPolynomial.eval₂Hom MvPolynomial.C var_map
    let δ₁ : (MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ I_M) →+* MvPolynomial (Fin (m - 1)) k :=
      Ideal.Quotient.lift I_M δ₀ (by
        intro f hf
        rw [Ideal.mem_span_singleton] at hf
        rcases hf with ⟨g, rfl⟩
        simp only [δ₀, map_mul, map_sub, map_prod, map_pow, MvPolynomial.eval₂Hom_X',
          var_map, Sum.elim_inl, Sum.elim_inr, zero_mul]
        have hprod0 : (∏ c : Fin m,
            (if hc : c = c₀ then (0 : MvPolynomial (Fin (m - 1)) k)
              else MvPolynomial.X (Classical.choose (hσ_surj c hc))) ^ a c) = 0 := by
          refine Finset.prod_eq_zero (Finset.mem_univ c₀) ?_
          simp only [dite_true]
          exact zero_pow (Nat.one_le_iff_ne_zero.mp hc₀)
        rw [hprod0, sub_zero, zero_mul])
    let δ_hom : ((MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ I_M) ⧸ I_br i) →+*
        MvPolynomial (Fin (m - 1)) k :=
      Ideal.Quotient.lift (I_br i) δ₁ (by
        intro x_br hx_br
        change x_br ∈ RingHom.ker δ₁
        refine Ideal.span_le.mpr ?_ hx_br
        rintro _ (rfl | rfl | rfl)
        · change δ₀ (MvPolynomial.X (Sum.inl 0)) = 0
          simp [δ₀, var_map]
        · change δ₀ (MvPolynomial.X (Sum.inl 1)) = 0
          simp [δ₀, var_map]
        · change δ₀ (MvPolynomial.X (Sum.inr c₀)) = 0
          simp [δ₀, var_map])
    have h_δγ : δ_hom.comp γ_hom = RingHom.id _ := by
      apply MvPolynomial.ringHom_ext
      · intro α
        simp [γ_hom, δ_hom, δ₁, δ₀]
      · intro j
        simp only [RingHom.comp_apply, RingHom.id_apply, γ_hom, MvPolynomial.eval₂Hom_X',
          δ_hom, δ₁, Ideal.Quotient.lift_mk, δ₀, var_map, Sum.elim_inr]
        simp only [hσ_ne j, dite_false]
        congr 1
        exact hσ_inj (Classical.choose_spec (hσ_surj (σ_c j) (hσ_ne j)))
    have h_γδ : γ_hom.comp δ_hom = RingHom.id _ := by
      apply Ideal.Quotient.ringHom_ext
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro α
        simp [γ_hom, δ_hom, δ₁, δ₀]
      · rintro (b | c)
        · simp only [RingHom.comp_apply, RingHom.id_apply, δ_hom, δ₁,
            Ideal.Quotient.lift_mk, δ₀, MvPolynomial.eval₂Hom_X', var_map, Sum.elim_inl,
            map_zero]
          rw [eq_comm, Ideal.Quotient.eq_zero_iff_mem]
          apply Ideal.subset_span
          fin_cases b <;> simp
        · simp only [RingHom.comp_apply, RingHom.id_apply, δ_hom, δ₁,
            Ideal.Quotient.lift_mk, δ₀, MvPolynomial.eval₂Hom_X', var_map, Sum.elim_inr]
          by_cases hc : c = c₀
          · subst hc
            simp only [dite_true, map_zero]
            symm
            rw [Ideal.Quotient.eq_zero_iff_mem]
            dsimp only [I_br, c₀]
            apply Ideal.subset_span
            simp
          · simp only [hc, dite_false, γ_hom, MvPolynomial.eval₂Hom_X']
            rw [Classical.choose_spec (hσ_surj c hc)]
    let γ_equiv : MvPolynomial (Fin (m - 1)) k ≃+*
        ((MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ I_M) ⧸ I_br i) :=
      { toFun := γ_hom
        invFun := δ_hom
        left_inv := fun z => DFunLike.congr_fun h_δγ z
        right_inv := fun z => DFunLike.congr_fun h_γδ z
        map_mul' := map_mul γ_hom
        map_add' := map_add γ_hom }
    
    let I_br' : Ideal (↑M_cat) := Ideal.map e_M.toRingHom (I_br i)
    let e_quot_M_eq : ((MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ I_M) ⧸ I_br i) ≃+* (↑M_cat ⧸ I_br') :=
      Ideal.quotientEquiv (I_br i) I_br' e_M rfl
    have hJ_map_eq : Ideal.map (algebraMap (↑M_cat) (↑B'')) I_br' = J_act i := by
      dsimp only [I_br', J_act]
      rw [Ideal.map_map]
      congr 1
      apply RingHom.ext
      intro x_m
      change φ_q₀ (e_M.symm (e_M x_m)) = φ_q₀ x_m
      rw [RingEquiv.symm_apply_apply]
    let e_quot_B_eq : (↑B'' ⧸ Ideal.map (algebraMap (↑M_cat) (↑B'')) I_br') ≃+* (↑B'' ⧸ J_act i) :=
      Ideal.quotEquivOfEq hJ_map_eq
    let e_quot_B_hom : (↑B'' ⧸ Ideal.map (algebraMap (↑M_cat) (↑B'')) I_br') →+* (↑B'' ⧸ J_act i) :=
      { toFun := e_quot_B_eq
        map_one' := map_one e_quot_B_eq
        map_mul' := map_mul e_quot_B_eq
        map_zero' := map_zero e_quot_B_eq
        map_add' := map_add e_quot_B_eq }
    let e_comm : TensorProduct (↑M_cat) (↑M_cat ⧸ I_br') (↑B'') ≃+*
        TensorProduct (↑M_cat) (↑B'') (↑M_cat ⧸ I_br') :=
      (Algebra.TensorProduct.comm (↑M_cat) (↑B'') (↑M_cat ⧸ I_br')).symm.toRingEquiv
    let e_quot : TensorProduct (↑M_cat) (↑B'') (↑M_cat ⧸ I_br') ≃+*
        (↑B'' ⧸ Ideal.map (algebraMap (↑M_cat) (↑B'')) I_br') :=
      (Algebra.TensorProduct.quotIdealMapEquivTensorQuot (↑B'') I_br').symm.toRingEquiv
    let e_quot_hom : TensorProduct (↑M_cat) (↑B'') (↑M_cat ⧸ I_br') →+*
        (↑B'' ⧸ Ideal.map (algebraMap (↑M_cat) (↑B'')) I_br') :=
      { toFun := e_quot
        map_one' := map_one e_quot
        map_mul' := map_mul e_quot
        map_zero' := map_zero e_quot
        map_add' := map_add e_quot }
    have h_inl_br : (Algebra.TensorProduct.includeLeftRingHom :
        (↑M_cat ⧸ I_br') →+* TensorProduct (↑M_cat) (↑M_cat ⧸ I_br') (↑B'')).Etale := by
      rw [show (Algebra.TensorProduct.includeLeftRingHom :
          (↑M_cat ⧸ I_br') →+* TensorProduct (↑M_cat) (↑M_cat ⧸ I_br') (↑B'')) =
          algebraMap (↑M_cat ⧸ I_br') (TensorProduct (↑M_cat) (↑M_cat ⧸ I_br') (↑B'')) from rfl,
        RingHom.etale_algebraMap]
      exact Algebra.Etale.baseChange (↑M_cat) (↑B'') (↑M_cat ⧸ I_br')
    let κ_br : (↑M_cat ⧸ I_br') →+* (↑B'' ⧸ J_act i) :=
      e_quot_B_hom.comp
        (e_quot_hom.comp (e_comm.toRingHom.comp Algebra.TensorProduct.includeLeftRingHom))
    have hEt_κ : κ_br.Etale :=
      RingHom.Etale.stableUnderComposition _ _
        (RingHom.Etale.stableUnderComposition _ _
          (RingHom.Etale.stableUnderComposition _ _ h_inl_br
            (RingHom.Etale.of_bijective e_comm.bijective))
          (RingHom.Etale.of_bijective (show Function.Bijective ⇑e_quot_hom from e_quot.bijective)))
        (RingHom.Etale.of_bijective (show Function.Bijective ⇑e_quot_B_hom from e_quot_B_eq.bijective))
    let γ_M_equiv : MvPolynomial (Fin (m - 1)) k ≃+* (↑M_cat ⧸ I_br') :=
      γ_equiv.trans e_quot_M_eq
    let γ_M_hom : MvPolynomial (Fin (m - 1)) k →+* (↑M_cat ⧸ I_br') :=
      { toFun := γ_M_equiv
        map_one' := map_one γ_M_equiv
        map_mul' := map_mul γ_M_equiv
        map_zero' := map_zero γ_M_equiv
        map_add' := map_add γ_M_equiv }
    let θ_i : MvPolynomial (Fin (m - 1)) k →+* (↑B'' ⧸ J_act i) :=
      κ_br.comp γ_M_hom
    have hEt_θ_hom : θ_i.Etale :=
      RingHom.Etale.stableUnderComposition γ_M_hom κ_br
        (RingHom.Etale.of_bijective (show Function.Bijective ⇑γ_M_hom from γ_M_equiv.bijective))
        hEt_κ
    have hEt_θ : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ_i)) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hEt_θ_hom
    exact hEtDom (m - 1) (↑B'' ⧸ J_act i) θ_i hEt_θ

  
  
  
  have hJ_le : ∀ i : ι_act, J_act i ≤ v''.asIdeal := by
    intro i
    dsimp only [J_act, I_br]
    rw [Ideal.map_span, Ideal.span_le]
    rintro _ ⟨x_gen, hx_gen, rfl⟩
    rcases hx_gen with rfl | rfl | rfl
    · change ψ_rel₀ (ι_tor (Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inl 0)))) ∈ v''.asIdeal
      rw [hι_inl 0, hInl_ψrel₀ v''.asIdeal 0]
      change ψ_nodal (Ideal.Quotient.mk I₁ (MvPolynomial.X 0)) ∈ Ideal.comap lam_B' v''.asIdeal
      rw [hv''_comap]
      exact hInl 0
    · change ψ_rel₀ (ι_tor (Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inl 1)))) ∈ v''.asIdeal
      rw [hι_inl 1, hInl_ψrel₀ v''.asIdeal 1]
      change ψ_nodal (Ideal.Quotient.mk I₁ (MvPolynomial.X 1)) ∈ Ideal.comap lam_B' v''.asIdeal
      rw [hv''_comap]
      exact hInl 1
    · change ψ_rel₀ (ι_tor (Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inr i.1)))) ∈ v''.asIdeal
      rw [hι_inr i.1]
      change ψ_rel₀ (Ideal.Quotient.mk I_rel (MvPolynomial.C (lam_B (ψ_B (MvPolynomial.X i.1))))) ∈
        v''.asIdeal
      rw [hBase_ψrel₀]
      change ψ_nodal (Ideal.Quotient.mk I₁ (MvPolynomial.C (ψ_B (MvPolynomial.X i.1)))) ∈
        Ideal.comap lam_B' v''.asIdeal
      rw [hv''_comap]
      have hmem_p : ψ_B (MvPolynomial.X i.1) ∈ p_B.asIdeal := hI₀_mem i.1 (ha_sub i.1 i.2)
      rw [← hv'p_ideal] at hmem_p
      exact hmem_p

  
  have hUniqueMin : ∀ i : ι_act, ∃ r_i : Ideal (↑B''),
      r_i ∈ (J_act i).minimalPrimes ∧ r_i ≤ v''.asIdeal ∧
      ∀ q_min ∈ (J_act i).minimalPrimes, q_min ≤ v''.asIdeal → q_min = r_i := by
    intro i
    let π_i : ↑B'' →+* (↑B'' ⧸ J_act i) := Ideal.Quotient.mk (J_act i)
    let pbar_i : Ideal (↑B'' ⧸ J_act i) := Ideal.map π_i v''.asIdeal
    have hpbar_prime : pbar_i.IsPrime :=
      Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective
        (by rw [Ideal.mk_ker]; exact hJ_le i)
    haveI : pbar_i.IsPrime := hpbar_prime
    have hpbar_comap : Ideal.comap π_i pbar_i = v''.asIdeal := by
      have h1 := Ideal.comap_map_of_surjective π_i Ideal.Quotient.mk_surjective v''.asIdeal
      rw [h1, ← RingHom.ker_eq_comap_bot, Ideal.mk_ker, sup_eq_left.mpr (hJ_le i)]
    haveI : IsDomain (Localization.AtPrime pbar_i) := hDom_act i pbar_i
    let φ_loc : ↑B'' →+* Localization.AtPrime pbar_i :=
      (algebraMap (↑B'' ⧸ J_act i) (Localization.AtPrime pbar_i)).comp π_i
    let r_i : Ideal (↑B'') := Ideal.comap φ_loc ⊥
    haveI : (⊥ : Ideal (Localization.AtPrime pbar_i)).IsPrime :=
      ⟨bot_ne_top, fun {x_d y_d} hxy => by
        rw [Ideal.mem_bot] at hxy
        simp only [Ideal.mem_bot]
        exact mul_eq_zero.mp hxy⟩
    have hr_prime : r_i.IsPrime := Ideal.IsPrime.comap φ_loc
    have hr_ge : J_act i ≤ r_i := by
      intro y hy
      change algebraMap (↑B'' ⧸ J_act i) (Localization.AtPrime pbar_i) (π_i y) ∈ (⊥ : Ideal _)
      rw [Ideal.Quotient.eq_zero_iff_mem.mpr hy, map_zero]
      exact Ideal.zero_mem ⊥
    have hr_sub : ∀ (q_id : Ideal (↑B'')), q_id.IsPrime → J_act i ≤ q_id → q_id ≤ v''.asIdeal →
        r_i ≤ q_id := by
      intro q_id hq_pr hJ_q hq_v y hy
      have hy0 : algebraMap (↑B'' ⧸ J_act i) (Localization.AtPrime pbar_i) (π_i y) = 0 := hy
      rw [IsLocalization.map_eq_zero_iff pbar_i.primeCompl (Localization.AtPrime pbar_i)] at hy0
      obtain ⟨⟨s_bar, hs_bar⟩, hs_mul⟩ := hy0
      obtain ⟨t, rfl⟩ := Ideal.Quotient.mk_surjective s_bar
      have ht_not_v : t ∉ v''.asIdeal := by
        rw [← hpbar_comap]
        exact hs_bar
      have ht_not_q : t ∉ q_id := fun h_in => ht_not_v (hq_v h_in)
      have hty_J : t * y ∈ J_act i := by
        rw [← Ideal.Quotient.eq_zero_iff_mem]
        change π_i t * π_i y = 0 at hs_mul
        rw [← map_mul] at hs_mul
        exact hs_mul
      exact (hq_pr.mem_or_mem (hJ_q hty_J)).resolve_left ht_not_q
    have hr_le_v : r_i ≤ v''.asIdeal := hr_sub v''.asIdeal v''.isPrime (hJ_le i) le_rfl
    have hr_min : r_i ∈ (J_act i).minimalPrimes :=
      ⟨⟨hr_prime, hr_ge⟩, fun q_id hq hq_le => hr_sub q_id hq.1 hq.2 (le_trans hq_le hr_le_v)⟩
    refine ⟨r_i, hr_min, hr_le_v, ?_⟩
    intro q_min hq_min hq_le_v
    exact le_antisymm (hq_min.2 ⟨hr_prime, hr_ge⟩ (hr_sub q_min hq_min.1.1 hq_min.1.2 hq_le_v))
      (hr_sub q_min hq_min.1.1 hq_min.1.2 hq_le_v)

  
  letI := Classical.decPred (fun q_id : Ideal (↑B'') => q_id ≤ v''.asIdeal)
  letI := Classical.decEq (Ideal (↑B''))
  let elem_out : Ideal (↑B'') → ↑B'' := fun q_id =>
    if hle : q_id ≤ v''.asIdeal then 1 else Classical.choose (Set.not_subset.mp hle)
  have helem_not_v : ∀ q_id : Ideal (↑B''), elem_out q_id ∉ v''.asIdeal := by
    intro q_id
    by_cases hle : q_id ≤ v''.asIdeal
    · simp only [elem_out, hle, dite_true]
      exact v''.isPrime.one_notMem
    · simp only [elem_out, hle, dite_false]
      exact (Classical.choose_spec (Set.not_subset.mp hle)).2
  have helem_mem : ∀ q_id : Ideal (↑B''), ¬ (q_id ≤ v''.asIdeal) → elem_out q_id ∈ q_id := by
    intro q_id hnot
    simp only [elem_out, hnot, dite_false]
    exact (Classical.choose_spec (Set.not_subset.mp hnot)).1
  let M_fin : ι_act → Finset (Ideal (↑B'')) := fun i =>
    (Ideal.finite_minimalPrimes_of_isNoetherianRing (↑B'') (J_act i)).toFinset
  let g_sh : ↑B'' := ∏ i : ι_act, ∏ q_id ∈ M_fin i, elem_out q_id
  have hg_sh_not_v : g_sh ∉ v''.asIdeal := by
    have hInner : ∀ i : ι_act, (∏ q_id ∈ M_fin i, elem_out q_id) ∉ v''.asIdeal := by
      intro i
      induction (M_fin i) using Finset.cons_induction with
      | empty =>
        rw [Finset.prod_empty]
        exact v''.isPrime.one_notMem
      | cons a_el s_el _ ih =>
        rw [Finset.prod_cons]
        exact v''.isPrime.mul_notMem (helem_not_v a_el) ih
    change (∏ i ∈ (Finset.univ : Finset ι_act), ∏ q_id ∈ M_fin i, elem_out q_id) ∉ v''.asIdeal
    induction (Finset.univ : Finset ι_act) using Finset.cons_induction with
    | empty =>
      rw [Finset.prod_empty]
      exact v''.isPrime.one_notMem
    | cons a_el s_el _ ih =>
      rw [Finset.prod_cons]
      exact v''.isPrime.mul_notMem (hInner a_el) ih
  have hg_sh_mem : ∀ (i : ι_act) (q_id : Ideal (↑B'')),
      q_id ∈ (J_act i).minimalPrimes → ¬ (q_id ≤ v''.asIdeal) → g_sh ∈ q_id := by
    intro i q_id hq_min hnot
    have hq_M : q_id ∈ M_fin i :=
      (Set.Finite.mem_toFinset _).mpr hq_min
    have hdvd1 : elem_out q_id ∣ ∏ q' ∈ M_fin i, elem_out q' :=
      Finset.dvd_prod_of_mem elem_out hq_M
    have hdvd2 : (∏ q' ∈ M_fin i, elem_out q') ∣ g_sh :=
      Finset.dvd_prod_of_mem (fun i' => ∏ q' ∈ M_fin i', elem_out q') (Finset.mem_univ i)
    exact Ideal.mem_of_dvd q_id (dvd_trans hdvd1 hdvd2) (helem_mem q_id hnot)

  
  obtain ⟨R', lam_sh, _e_gsh, hEt_lamsh_hom, _he_gsh, hLoc_gsh⟩ := hAwayPkg g_sh
  letI : Algebra (↑B'') (↑R') := lam_sh.toAlgebra
  haveI : IsLocalization.Away g_sh (↑R') := hLoc_gsh
  have hEt_lamsh : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom lam_sh)) :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hEt_lamsh_hom

  
  have hIrred_act : ∀ i : ι_act,
      IsIrreducible (PrimeSpectrum.zeroLocus (↑(Ideal.map lam_sh (J_act i)) : Set ↑R')) := by
    intro i
    obtain ⟨r_i, hr_min, hr_le_v, hr_uniq⟩ := hUniqueMin i
    have hr_prime : r_i.IsPrime := hr_min.1.1
    have hg_not_r : g_sh ∉ r_i := fun hg_in => hg_sh_not_v (hr_le_v hg_in)
    have hDisj_r : Disjoint (Submonoid.powers g_sh : Set ↑B'') (r_i : Set ↑B'') := by
      rw [Set.disjoint_left]
      rintro _ ⟨k_pow, rfl⟩ hmem
      exact hg_not_r (hr_prime.mem_of_pow_mem k_pow hmem)
    let P_i : Ideal (↑R') := Ideal.map lam_sh r_i
    have hP_prime : P_i.IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers g_sh) (↑R') r_i hr_prime hDisj_r
    have hP_under : Ideal.under (↑B'') P_i = r_i :=
      IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers g_sh) (↑R') hr_prime hDisj_r
    have hMin_eq : (Ideal.map lam_sh (J_act i)).minimalPrimes = {P_i} := by
      have hMinMap : (Ideal.map lam_sh (J_act i)).minimalPrimes =
          Ideal.under (↑B'') ⁻¹' (J_act i).minimalPrimes :=
        IsLocalization.minimalPrimes_map (Submonoid.powers g_sh) (↑R') (J_act i)
      ext Q_id
      rw [hMinMap]
      simp only [Set.mem_preimage, Set.mem_singleton_iff]
      constructor
      · intro hQ_under
        have hQ_min : Q_id ∈ (Ideal.map lam_sh (J_act i)).minimalPrimes := by
          rwa [hMinMap]
        have hQ_prime : Q_id.IsPrime := Ideal.IsMinimalPrime.isPrime hQ_min
        by_cases hle : Ideal.under (↑B'') Q_id ≤ v''.asIdeal
        · have h_eq_r : Ideal.under (↑B'') Q_id = r_i := hr_uniq _ hQ_under hle
          have hMapUnder : Ideal.map lam_sh (Ideal.under (↑B'') Q_id) = Q_id :=
            IsLocalization.map_under (Submonoid.powers g_sh) (↑R') Q_id
          rw [← hMapUnder, h_eq_r]
        · exfalso
          have hg_in_under : g_sh ∈ Ideal.under (↑B'') Q_id := hg_sh_mem i _ hQ_under hle
          have hg_unit : IsUnit (lam_sh g_sh) :=
            IsLocalization.map_units (↑R') (⟨g_sh, Submonoid.mem_powers g_sh⟩ : Submonoid.powers g_sh)
          exact hQ_prime.ne_top (Q_id.eq_top_of_isUnit_mem hg_in_under hg_unit)
      · rintro rfl
        rwa [hP_under]
    rw [PrimeSpectrum.isIrreducible_zeroLocus_iff, ← Ideal.sInf_minimalPrimes, hMin_eq, sInf_singleton]
    exact hP_prime

  
  
  
  have hDisj_g : Disjoint (Submonoid.powers g_sh : Set ↑B'') (v''.asIdeal : Set ↑B'') := by
    rw [Set.disjoint_left]
    rintro _ ⟨k_pow, rfl⟩ hmem
    exact hg_sh_not_v (v''.isPrime.mem_of_pow_mem k_pow hmem)
  let v₀ : AlgebraicGeometry.Spec R' :=
    ⟨Ideal.map lam_sh v''.asIdeal,
      IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers g_sh) (↑R')
        v''.asIdeal v''.isPrime hDisj_g⟩
  have hv₀_comap : Ideal.comap lam_sh v₀.asIdeal = v''.asIdeal :=
    IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers g_sh) (↑R')
      v''.isPrime hDisj_g
  have hv₀_map : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom lam_sh)).base v₀ = v'' := by
    apply PrimeSpectrum.ext
    change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom lam_sh) v₀).asIdeal = v''.asIdeal
    rw [AlgebraicGeometry.Spec.map_apply]
    exact hv₀_comap

  let e_loc : AlgebraicGeometry.Spec R' ⟶ AlgebraicGeometry.Spec B' :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom lam_sh) ≫
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom lam_B')
  let e_X : AlgebraicGeometry.Spec R' ⟶ C₁.left := e_loc ≫ e_C
  let S_bdry : Finset (Fin m) := I₀
  let ρ : {c : Fin m // 1 ≤ a c} → Fin r_B := fun ⟨c, hc⟩ => ρ₀ ⟨c, ha_sub c hc⟩
  let ψ_rel : (MvPolynomial (Fin 2) ↑R''_B ⧸ I_rel) →+* ↑R' := lam_sh.comp ψ_rel₀
  let φ_q : (MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ I_M) →+* ↑R' := lam_sh.comp φ_q₀
  let q : AlgebraicGeometry.Spec R' ⟶
      AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ I_M)) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_q)

  have hEt_ψrel_hom : ψ_rel.Etale :=
    RingHom.Etale.stableUnderComposition ψ_rel₀ lam_sh hEt_ψrel₀_hom hEt_lamsh_hom
  have hEt_ψrel : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_rel)) :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hEt_ψrel_hom
  have hEt_φq_hom : φ_q.Etale :=
    RingHom.Etale.stableUnderComposition φ_q₀ lam_sh hEt_φq₀_hom hEt_lamsh_hom
  have hEt_q : AlgebraicGeometry.Etale q :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hEt_φq_hom
  have hEt_eX : AlgebraicGeometry.Etale e_X := inferInstance

  have he_loc_v₀ : e_loc.base v₀ = v' := by
    change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom lam_B')).base
      ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom lam_sh)).base v₀) = v'
    rw [hv₀_map, hv''_map]
  have he_loc_ideal : ∀ v : AlgebraicGeometry.Spec R',
      (e_loc.base v).asIdeal = Ideal.comap lam_B' (Ideal.comap lam_sh v.asIdeal) := by
    intro v
    have hcomp : e_loc = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (lam_sh.comp lam_B')) := by
      rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp]
    rw [hcomp]
    change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (lam_sh.comp lam_B')) v).asIdeal = _
    rw [AlgebraicGeometry.Spec.map_apply]
    rfl
  have hq_ideal : ∀ v : AlgebraicGeometry.Spec R',
      (q.base v).asIdeal = Ideal.comap φ_q v.asIdeal := by
    intro v
    change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_q) v).asIdeal = _
    rw [AlgebraicGeometry.Spec.map_apply]
    rfl

  
  have hMaster_inl : ∀ (v : AlgebraicGeometry.Spec R') (b : Fin 2),
      Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inl b)) ∈ (q.base v).asIdeal ↔
        ψ_nodal (Ideal.Quotient.mk I₁ (MvPolynomial.X b)) ∈ (e_loc.base v).asIdeal := by
    intro v b
    rw [hq_ideal v, he_loc_ideal v]
    change lam_sh (ψ_rel₀ (ι_tor (Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inl b))))) ∈ v.asIdeal ↔
      lam_B' (ψ_nodal (Ideal.Quotient.mk I₁ (MvPolynomial.X b))) ∈ Ideal.comap lam_sh v.asIdeal
    rw [hι_inl b, ← hInl_ψrel₀ (Ideal.comap lam_sh v.asIdeal) b]
    rfl
  have hMaster_inr : ∀ (v : AlgebraicGeometry.Spec R') (c : Fin m),
      Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inr c)) ∈ (q.base v).asIdeal ↔
        ψ_nodal (Ideal.Quotient.mk I₁ (MvPolynomial.C (ψ_B (MvPolynomial.X c)))) ∈
          (e_loc.base v).asIdeal := by
    intro v c
    rw [hq_ideal v, he_loc_ideal v]
    change lam_sh (ψ_rel₀ (ι_tor (Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inr c))))) ∈ v.asIdeal ↔
      lam_sh (lam_B' (ψ_nodal (Ideal.Quotient.mk I₁ (MvPolynomial.C (ψ_B (MvPolynomial.X c)))))) ∈
        v.asIdeal
    rw [hι_inr c]
    change lam_sh (ψ_rel₀ (Ideal.Quotient.mk I_rel (MvPolynomial.C (lam_B (ψ_B (MvPolynomial.X c)))))) ∈
        v.asIdeal ↔ _
    rw [hBase_ψrel₀ (ψ_B (MvPolynomial.X c))]

  
  have hComm_rel : e_X ≫ f₁.left =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_rel) ≫
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk I_rel).comp MvPolynomial.C)) ≫ e''_B := by
    dsimp only [e_X, e_loc, e''_B]
    rw [Category.assoc, Category.assoc, hCommC]
    simp only [← Category.assoc]
    congr 1
    simp only [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    congr 2
    apply RingHom.ext
    intro r
    simp only [RingHom.comp_apply, ψ_rel]
    exact (congrArg lam_sh (hBase_ψrel₀ r)).symm

  refine ⟨R', v₀, e_X, S_bdry, ρ, q,
    hEt_eX, hEt_q, ?_, ha_pos, ha_sub, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  
  · change e_C.base (e_loc.base v₀) = x
    rw [he_loc_v₀, hv'x]
  
  · rintro ⟨c₁, hc₁⟩ ⟨c₂, hc₂⟩ hρ_eq
    have hsub := hInj_ρ₀ hρ_eq
    exact Subtype.ext (Subtype.mk.inj hsub)
  
  · rw [← Over.w f₁, ← Category.assoc, hComm_rel]
    dsimp only [e''_B, q]
    rw [Category.assoc, Category.assoc, Category.assoc, ← hCommB]
    simp only [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    congr 2
    ext α
    simp only [RingHom.comp_apply, φ_q, φ_q₀, ψ_rel]
    rw [hι_C α]
    rfl
  
  · intro b
    rw [hMaster_inl v₀ b, he_loc_v₀]
    exact hInl b
  
  · intro c hc
    rw [hMaster_inr v₀ c, he_loc_v₀]
    have hmem_p : ψ_B (MvPolynomial.X c) ∈ p_B.asIdeal := hI₀_mem c hc
    rwa [← hv'p_ideal] at hmem_p
  
  · ext v
    change e_loc.base v ∈ e_C.base ⁻¹' Z₁ ↔ _
    rw [hPreZ₁]
    simp only [Set.mem_setOf_eq, S_bdry]
    exact exists_congr fun c => and_congr_right fun _ => (hMaster_inr v c).symm
  
  · intro c hc
    ext v
    have h_eq_pre : v ∈ (e_X ≫ f₁.left).base ⁻¹' Set.range (ιD_B (ρ ⟨c, hc⟩)).base ↔
        e_loc.base v ∈ (e_C ≫ f₁.left).base ⁻¹' Set.range (ιD_B (ρ₀ ⟨c, ha_sub c hc⟩)).base := by
      dsimp only [e_X, ρ]
      rw [Category.assoc]
      rfl
    rw [Set.mem_preimage] at h_eq_pre ⊢
    erw [h_eq_pre, hPreDB c (ha_sub c hc)]
    simp only [Set.mem_setOf_eq]
    exact (hMaster_inr v c).symm
  
  · ext v
    change e_loc.base v ∈ e_C.base ⁻¹' S_rel ↔ _
    rw [hPreS]
    simp only [Set.mem_setOf_eq]
    exact forall_congr' fun b => (hMaster_inl v b).symm
  
  · intro c hc
    have hSetEq : ({v : AlgebraicGeometry.Spec R' |
        (∀ b : Fin 2, Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inl b)) ∈ (q.base v).asIdeal) ∧
        Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inr c)) ∈ (q.base v).asIdeal} :
        Set (PrimeSpectrum ↑R')) =
        PrimeSpectrum.zeroLocus (↑(Ideal.map lam_sh (J_act ⟨c, hc⟩)) : Set ↑R') := by
      ext v
      have hLHS : ((∀ b : Fin 2, Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inl b)) ∈
            (q.base v).asIdeal) ∧
          Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inr c)) ∈ (q.base v).asIdeal) ↔
          φ_q (Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inl 0))) ∈ v.asIdeal ∧
          φ_q (Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inl 1))) ∈ v.asIdeal ∧
          φ_q (Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inr c))) ∈ v.asIdeal := by
        rw [Fin.forall_fin_two, and_assoc, hq_ideal v]
        rfl
      have hRHS : v ∈ PrimeSpectrum.zeroLocus (↑(Ideal.map lam_sh (J_act ⟨c, hc⟩)) : Set ↑R') ↔
          φ_q (Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inl 0))) ∈ v.asIdeal ∧
          φ_q (Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inl 1))) ∈ v.asIdeal ∧
          φ_q (Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inr c))) ∈ v.asIdeal := by
        dsimp only [J_act, I_br]
        rw [Ideal.map_span, Ideal.map_span, PrimeSpectrum.zeroLocus_span,
          PrimeSpectrum.mem_zeroLocus]
        simp only [Set.image_insert_eq, Set.image_singleton, Set.insert_subset_iff,
          Set.singleton_subset_iff, SetLike.mem_coe, φ_q, RingHom.comp_apply]
      exact hLHS.trans hRHS.symm
    exact hSetEq.symm ▸ hIrred_act ⟨c, hc⟩
  
  · refine ⟨R''_B, e''_B, ψ''_B, ψ_rel, φ_q, rfl, hEt_e''B, hEt_ψ''B, hEt_ψrel, hComm_rel, ?_, ?_⟩
    · intro b
      change lam_sh (ψ_rel₀ (Ideal.Quotient.mk I_rel (MvPolynomial.X b))) =
        lam_sh (ψ_rel₀ (ι_tor (Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inl b)))))
      rw [hι_inl b]
    · intro c
      change lam_sh (ψ_rel₀ (Ideal.Quotient.mk I_rel (MvPolynomial.C (ψ''_B (MvPolynomial.X c))))) =
        lam_sh (ψ_rel₀ (ι_tor (Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inr c)))))
      rw [hι_inr c]

theorem weil_toroidal_model_prime_and_sum_one_elim (k : Type u) [Field k] (m : ℕ)
    (a : Fin m → ℕ) :
    let M₀ := MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ Ideal.span
      ({MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
        ∏ c : Fin m, MvPolynomial.X (Sum.inr c) ^ a c} : Set (MvPolynomial (Fin 2 ⊕ Fin m) k))
