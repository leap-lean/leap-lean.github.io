      haveI : CategoryTheory.IsIso (L_γ ∣_ W_B_pb) := hIsoLγ
      have hu₀_eq_u₀' : u₀ = u₀' := by
        have h_inv_app := congrArg (fun p => (CategoryTheory.inv (L_γ ∣_ W_B_pb)).base p) h_res_L
        simpa only [← hCompBase (L_γ ∣_ W_B_pb) (CategoryTheory.inv (L_γ ∣_ W_B_pb)),
          CategoryTheory.IsIso.hom_inv_id, hIdBase] using h_inv_app
      have hc_eq_c' : c = c' := by
        rw [← hu₀_eq, ← hu₀'_eq, hu₀_eq_u₀']
      exact Set.mem_iUnion.mpr ⟨j, f.left.base c, hc_eq_c'.symm⟩
  · exact Or.inl hcU

theorem weil_algClosed_contraction_lemma_and_alteration_extension (k : Type u) [Field k] [IsAlgClosed k]
    (V : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (U_V : V.left.Opens)
    (B₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (U₂ : B₂.left.Opens)
    (hIntB₂ : AlgebraicGeometry.IsIntegral B₂.left)
    (hProjB₂ : IsProjectiveOverField k B₂)
    (X₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hIntX₂ : AlgebraicGeometry.IsIntegral X₂.left)
    (hProjX₂ : IsProjectiveOverField k X₂)
    (f₂ : X₂ ⟶ B₂)
    (n : ℕ)
    (σ : Fin n → (B₂ ⟶ X₂))
    (hFib₂ : IsThreeSecantPointedCurveFibOver k f₂ U₂ n σ)
    (α₂ : X₂ ⟶ V)
    (hBdry₂ : α₂.left.base ⁻¹' ((U_V : Set V.left)ᶜ) ⊆
      f₂.left.base ⁻¹' ((U₂ : Set B₂.left)ᶜ) ∪
        ⋃ j : Fin n, Set.range (σ j).left.base)
    (B : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (U_B : B.left.Opens)
    (ψ : B ⟶ B₂)
    (hIntB : AlgebraicGeometry.IsIntegral B.left)
    (hProjB : IsProjectiveOverField k B)
    (hUB : Nonempty U_B)
    (hψ : IsGenFiniteEtaleAlterationOver k ψ)
    (hUBSub : (U_B : Set B.left) ⊆ ψ.left.base ⁻¹' (U₂ : Set B₂.left))
    (C X_B T_B : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (f : C ⟶ B)
    (τ : Fin n → (B ⟶ C))
    (hCurve : IsSemistablePointedCurveOver k f U_B n τ)
    (hIntC : AlgebraicGeometry.IsIntegral C.left)
    (hProjC : IsProjectiveOverField k C)
    (f_XB : X_B ⟶ B)
    (σ_B : Fin n → (B ⟶ X_B))
    (qX_B : X_B ⟶ X₂)
    (f_TB : T_B ⟶ B)
    (pr₁ : T_B ⟶ C)
    (pr₂ : T_B ⟶ X_B)
    (hCorr : IsFlattenedNormalPointedCorrespondenceOver k f₂ σ ψ U_B f τ f_XB σ_B qX_B f_TB pr₁ pr₂) :
    ∃ (γ : C ⟶ X₂),
      IsGenFiniteEtaleAlterationOver k γ ∧
      (γ ≫ α₂).left.base ⁻¹' ((U_V : Set V.left)ᶜ) ⊆
        f.left.base ⁻¹' ((U_B : Set B.left)ᶜ) ∪
          ⋃ j : Fin n, Set.range (τ j).left.base :=
by
  have hCorr' := hCorr
  rcases hCorr' with ⟨_hn, _hNormB, hNormC, hIntXB, hProjXB, _hPropXB, _hFlatXB, hSurjXB,
    _hSecXB, _hIsoXB_pb, hNormSmoothXB, _hThreeSecXB, hIntTB, hProjTB, _hFlatTB,
    _hClTB, hIsoPr₁U, hIsoPr₂U, _hLiftTau⟩
  have hSurjC : AlgebraicGeometry.Surjective f.left := hCurve.2.2.2.1
  have hVCB : Nonempty ↥((TopologicalSpace.Opens.map f.left.base).obj U_B) := by
    have : AlgebraicGeometry.Surjective f.left := hSurjC
    obtain ⟨⟨b, hb⟩⟩ := hUB
    obtain ⟨c, rfl⟩ := f.left.surjective b
    exact ⟨⟨c, hb⟩⟩
  have hVXB : Nonempty ↥((TopologicalSpace.Opens.map f_XB.left.base).obj U_B) := by
    have : AlgebraicGeometry.Surjective f_XB.left := hSurjXB
    obtain ⟨⟨b, hb⟩⟩ := hUB
    obtain ⟨x, rfl⟩ := f_XB.left.surjective b
    exact ⟨⟨x, hb⟩⟩
  have hLocIsoC : ∀ (c : C.left),
      (∀ (t₀ t₁ : T_B.left),
        pr₁.left.base t₀ = c → pr₁.left.base t₁ = c →
        t₀ ∈ closure ({t₁} : Set T_B.left) → t₀ = t₁) →
      ∃ (V : C.left.Opens), c ∈ V ∧ CategoryTheory.IsIso (pr₁.left ∣_ V) := by
    intro c hZeroDim
    obtain ⟨U, hAffU, hcU, _⟩ :=
      @AlgebraicGeometry.exists_isAffineOpen_mem_and_subset C.left c ⊤ trivial
    obtain ⟨hDomU, hICU⟩ := hNormC U hAffU ⟨⟨c, hcU⟩⟩
    obtain ⟨V, _hAffV, hcV, _hVtop, hIsoV⟩ :=
      weil_projective_birational_normal_open_iso_of_no_strict_spec k T_B C
        hIntTB hProjTB hIntC hProjC pr₁
        ((TopologicalSpace.Opens.map f.left.base).obj U_B) hVCB hIsoPr₁U
        ⊤ c trivial ⟨U, hAffU, hcU, le_top, hDomU, hICU⟩ hZeroDim
    exact ⟨V, hcV, hIsoV⟩
  have hLocIsoXB : ∀ (W : X_B.left.Opens),
      AlgebraicGeometry.SmoothOfRelativeDimension 1 (W.ι ≫ f_XB.left) →
      ∀ x ∈ W,
      (∀ (t₀ t₁ : T_B.left),
        pr₂.left.base t₀ = x → pr₂.left.base t₁ = x →
        t₀ ∈ closure ({t₁} : Set T_B.left) → t₀ = t₁) →
      ∃ (V : X_B.left.Opens), x ∈ V ∧ V ≤ W ∧ CategoryTheory.IsIso (pr₂.left ∣_ V) := by
    intro W hSmW x hxW hZeroDim
    obtain ⟨V, _hAffV, hxV, hVW, hIsoV⟩ :=
      weil_projective_birational_normal_open_iso_of_no_strict_spec k T_B X_B
        hIntTB hProjTB hIntXB hProjXB pr₂
        ((TopologicalSpace.Opens.map f_XB.left.base).obj U_B) hVXB hIsoPr₂U
        W x hxW (hNormSmoothXB W hSmW x hxW) hZeroDim
    exact ⟨V, hxV, hVW, hIsoV⟩
  have hConnXB : ∀ (x : X_B.left),
      IsClosed ({x} : Set X_B.left) →
      (∃ (U : X_B.left.Opens),
        AlgebraicGeometry.IsAffineOpen U ∧ x ∈ U ∧
        IsDomain ↑(X_B.left.presheaf.obj (Opposite.op U)) ∧
        IsIntegrallyClosed ↑(X_B.left.presheaf.obj (Opposite.op U))) →
      topologicalKrullDim ↥{t : T_B.left | pr₂.left.base t = x} ≤ (1 : WithBot ℕ∞) →
      ConnectedSpace ↥{t : T_B.left | pr₂.left.base t = x} :=
    fun x hClx hNormx hDimFib =>
      weil_projective_birational_normal_closed_fiber_connected k T_B X_B
        hIntTB hProjTB hIntXB hProjXB pr₂
        ((TopologicalSpace.Opens.map f_XB.left.base).obj U_B) hVXB hIsoPr₂U
        x hClx hNormx hDimFib
  have hNoSpec : ∀ (c₀ : C.left) (t₀ t₁ : T_B.left),
      pr₁.left.base t₀ = c₀ → pr₁.left.base t₁ = c₀ →
      t₀ ∈ closure ({t₁} : Set T_B.left) → t₀ = t₁ := by
    intro c₀ t₀ t₁ ht₀ ht₁ hcl
    by_contra hne
    obtain ⟨s₀, s_bar, c₁, w₀, w₁, hCls₀, _hs₀UB, hs_bar_hom, hs_bar_pt,
        hc₁, hw₀, hw₁, hwcl, hwne⟩ :=
      weil_algClosed_positive_fiber_dim_specializes_to_closed_point k B C T_B U_B
        hIntB hProjB hIntC hProjC hIntTB hProjTB f pr₁ hIsoPr₁U c₀ t₀ t₁ ht₀ ht₁ hcl hne
    obtain ⟨hDimC_fib, hTwoBr, hOneBr⟩ :=
      weil_algClosed_semistable_closed_fiber_equidim_and_branch_bounds k B C U_B
