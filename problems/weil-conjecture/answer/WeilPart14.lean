    · ext v
      let v₃_sp : Spec (CommRingCat.of S₃_ring) := PrimeSpectrum.comap loc_S₃ v
      have heX_v_V' : e_X.base v ∈ (V' : Set C₁.left) := by
        apply heS₂_sub
        refine ⟨(Spec.map (CommRingCat.ofHom loc_S₂)).base v₃_sp, ?_⟩
        change e_S₂.base ((Spec.map (CommRingCat.ofHom loc_S₂)).base v₃_sp) =
          e_S₂.base ((Spec.map (CommRingCat.ofHom loc_S₂)).base
            ((Spec.map (CommRingCat.ofHom loc_S₃)).base v))
        rw [Spec.map_apply (CommRingCat.ofHom loc_S₃) v]
        rfl
      have hSec_v : (e_X.base v ∈ ⋃ j : Fin n, Set.range (τ₁ j).left.base) ↔
          ψ (MvPolynomial.X (Fin.last m)) ∈ v.asIdeal := by
        have hOnly_j₀ : (e_X.base v ∈ ⋃ j : Fin n, Set.range (τ₁ j).left.base) ↔
            e_X.base v ∈ Set.range τ.base := by
          rw [Set.mem_iUnion]
          constructor
          · rintro ⟨j, hvj⟩
            by_cases hj : j = j₀
            · subst hj
              exact hvj
            · have hxj_not : x ∉ Set.range (τ₁ j).left.base :=
                fun hxj => Set.disjoint_left.mp (hDisj hj) hxj hxj₀
              exact (hV'_miss heX_v_V' j hxj_not hvj).elim
          · intro hvj₀
            exact ⟨j₀, hvj₀⟩
        rw [hOnly_j₀, hψ_last, hgR_iff v]
        have heX_v_S₃ : e_X.base v = e_S₃.base v₃_sp := by
          change e_S₃.base ((Spec.map (CommRingCat.ofHom loc_S₃)).base v) = e_S₃.base v₃_sp
          rw [Spec.map_apply]
          rfl
        rw [heX_v_S₃]
        change v₃_sp ∈ e_S₃.base ⁻¹' Set.range τ.base ↔ RingHom.ker σ ≤ v₃_sp.asIdeal
        rw [hPre_τ]
        rfl
      have hBase_v : f₁.left.base (e_X.base v) ∈ Z_B₁ ↔
          ∃ c ∈ I_B, ψ (MvPolynomial.X (Fin.castSucc c)) ∈ v.asIdeal := by
        let w_A₁ : Spec A₁ := PrimeSpectrum.comap (φ_R.comp (loc_A₂.comp loc_A₁)) v
        have hf_eq : f₁.left.base (e_X.base v) = e_B₁.base w_A₁ := by
          change (e_X ≫ f₁.left).base v = e_B₁.base w_A₁
          rw [heX_f₁]
          change e_B₁.base ((Spec.map (CommRingCat.ofHom (φ_R.comp (loc_A₂.comp loc_A₁)))).base v) =
            e_B₁.base w_A₁
          rw [Spec.map_apply]
          rfl
        rw [hf_eq]
        change w_A₁ ∈ e_B₁.base ⁻¹' Z_B₁ ↔ _
        rw [hPre_ZB₁]
        change (∃ c ∈ I_B, ψ₁ (MvPolynomial.X c) ∈ w_A₁.asIdeal) ↔ _
        refine ⟨fun ⟨c, hc, hmem⟩ => ⟨c, hc, ?_⟩, fun ⟨c, hc, hmem⟩ => ⟨c, hc, ?_⟩⟩
        · rw [hψ_castSucc c]
          exact hmem
        · rw [hψ_castSucc c] at hmem
          exact hmem
      change (f₁.left.base (e_X.base v) ∈ Z_B₁ ∨
          e_X.base v ∈ ⋃ j : Fin n, Set.range (τ₁ j).left.base) ↔
        ∃ i ∈ I, ψ (MvPolynomial.X i) ∈ v.asIdeal
      rw [hBase_v, hSec_v]
      constructor
      · rintro (⟨c, hc, hmem⟩ | hlast)
        · exact ⟨Fin.castSucc c,
            Finset.mem_insert_of_mem (Finset.mem_map.mpr ⟨c, hc, rfl⟩), hmem⟩
        · exact ⟨Fin.last m, Finset.mem_insert_self _ _, hlast⟩
      · rintro ⟨i, hi, hmem⟩
        rcases Finset.mem_insert.mp hi with rfl | hi_map
        · exact Or.inr hmem
        · rcases Finset.mem_map.mp hi_map with ⟨c, hc, rfl⟩
          exact Or.inl ⟨c, hc, hmem⟩
  · 
    obtain ⟨ψ, hEt_ψ, hψ_C, hψ_castSucc, _hψ_last⟩ :=
      hCombine A₂_ring (↑S₂) ψ_A₂ hEt_ψA₂ φ₂ g₂ hg₂_comp hg₂_et
    let I : Finset (Fin (m + 1)) := I_B.map Fin.castSuccEmb
    refine ⟨S₂, q₂, e_S₂, ψ, I, inferInstance, hEt_ψ, heS₂_q₂, ?_, ?_, ?_⟩
    · have hψ_C' : ψ.comp MvPolynomial.C = (φ₂.comp loc_A₁).comp (ψ₁.comp MvPolynomial.C) := by
        rw [hψ_C]
        ext c
        rfl
      calc
        Spec.map (CommRingCat.ofHom ψ) ≫ Spec.map (CommRingCat.ofHom MvPolynomial.C) =
            Spec.map (CommRingCat.ofHom (ψ.comp MvPolynomial.C)) := by
          rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
        _ = Spec.map (CommRingCat.ofHom φ₂) ≫ Spec.map (CommRingCat.ofHom loc_A₁) ≫
            Spec.map (CommRingCat.ofHom ψ₁) ≫ Spec.map (CommRingCat.ofHom MvPolynomial.C) := by
          rw [hψ_C']
          simp only [CommRingCat.ofHom_comp, Spec.map_comp, Category.assoc]
        _ = Spec.map (CommRingCat.ofHom φ₂) ≫ Spec.map (CommRingCat.ofHom loc_A₁) ≫
            e_B₁ ≫ B₁.hom := by
          rw [hComm_ψ₁]
        _ = (e_S₂ ≫ f₁.left) ≫ B₁.hom := by
          rw [← Category.assoc (Spec.map (CommRingCat.ofHom loc_A₁)),
            ← Category.assoc (Spec.map (CommRingCat.ofHom φ₂)), ← heS₂_f₁]
        _ = e_S₂ ≫ C₁.hom := by rw [Category.assoc, Over.w f₁]
    · intro i hi
      rcases Finset.mem_map.mp hi with ⟨c, hcIB, rfl⟩
      change ψ (MvPolynomial.X (Fin.castSucc c)) ∈ q₂.asIdeal
      rw [hψ_castSucc c]
      have hc_p₁ : ψ₁ (MvPolynomial.X c) ∈ p₁.asIdeal := hIB_p₁ c hcIB
      rw [← hcomap_q₂] at hc_p₁
      exact hc_p₁
    · ext v
      have heS₂_v_V' : e_S₂.base v ∈ (V' : Set C₁.left) := heS₂_sub ⟨v, rfl⟩
      have hNoSec : e_S₂.base v ∉ ⋃ j : Fin n, Set.range (τ₁ j).left.base := by
        rw [Set.mem_iUnion]
        rintro ⟨j, hvj⟩
        exact hV'_miss heS₂_v_V' j (fun hxj => hxSec ⟨j, hxj⟩) hvj
      let w_A₁ : Spec A₁ := PrimeSpectrum.comap (φ₂.comp loc_A₁) v
      have hf_eq : f₁.left.base (e_S₂.base v) = e_B₁.base w_A₁ := by
        change (e_S₂ ≫ f₁.left).base v = e_B₁.base w_A₁
        rw [heS₂_f₁, ← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
        change e_B₁.base ((Spec.map (CommRingCat.ofHom (φ₂.comp loc_A₁))).base v) =
          e_B₁.base w_A₁
        rw [Spec.map_apply]
        rfl
      change (f₁.left.base (e_S₂.base v) ∈ Z_B₁ ∨
          e_S₂.base v ∈ ⋃ j : Fin n, Set.range (τ₁ j).left.base) ↔
        ∃ i ∈ I, ψ (MvPolynomial.X i) ∈ v.asIdeal
      simp only [hNoSec, or_false]
      rw [hf_eq]
      change w_A₁ ∈ e_B₁.base ⁻¹' Z_B₁ ↔ _
      rw [hPre_ZB₁]
      change (∃ c ∈ I_B, ψ₁ (MvPolynomial.X c) ∈ w_A₁.asIdeal) ↔ _
      constructor
      · rintro ⟨c, hc, hmem⟩
        refine ⟨Fin.castSucc c, Finset.mem_map.mpr ⟨c, hc, rfl⟩, ?_⟩
        rw [hψ_castSucc c]
        exact hmem
      · rintro ⟨i, hi, hmem⟩
        rcases Finset.mem_map.mp hi with ⟨c, hc, rfl⟩
        refine ⟨c, hc, ?_⟩
        change ψ (MvPolynomial.X (Fin.castSucc c)) ∈ v.asIdeal at hmem
        rw [hψ_castSucc c] at hmem
        exact hmem

theorem weil_semistable_curve_shrunk_nodal_snc_datum (k : Type u) [Field k] (m : ℕ)
    (B₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (Z_B₁ : Set B₁.left) (U_B₁ : B₁.left.Opens)
    (r_B : ℕ) (D_B : Fin r_B → AlgebraicGeometry.Scheme.{u})
    (ιD_B : ∀ i : Fin r_B, D_B i ⟶ B₁.left)
    (hClD_B : ∀ i : Fin r_B, AlgebraicGeometry.IsClosedImmersion (ιD_B i))
    (hZB₁_eq : Z_B₁ = ⋃ i : Fin r_B, Set.range (ιD_B i).base)
    (hChartsB₁ : ∀ y : B₁.left, ∃ (U : B₁.left.Opens),
      AlgebraicGeometry.IsAffineOpen U ∧ y ∈ U ∧
      ∃ (ψ : MvPolynomial (Fin m) k →+* ↑(B₁.left.presheaf.obj (Opposite.op U))),
        AlgebraicGeometry.Etale (U.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) ∧
        (U.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = U.ι ≫ B₁.hom) ∧
        ∃ (α : {i : Fin r_B // Nonempty ↑((TopologicalSpace.Opens.map (ιD_B i).base).obj U)} → Fin m),
          Function.Injective α ∧
          ∀ (i : Fin r_B) (hi : Nonempty ↑((TopologicalSpace.Opens.map (ιD_B i).base).obj U)),
            RingHom.ker ((ιD_B i).app U).hom =
              Ideal.span {ψ (MvPolynomial.X (α ⟨i, hi⟩))})
    (hU_B₁_eq : (U_B₁ : Set B₁.left) = Z_B₁ᶜ)
    (C₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (f₁ : C₁ ⟶ B₁) (n : ℕ) (τ₁ : Fin n → (B₁ ⟶ C₁))
    (hCurve₁ : IsSemistablePointedCurveOver k f₁ U_B₁ n τ₁)
    (x : C₁.left)
    (hx : ¬ ∃ V : C₁.left.Opens,
      x ∈ V ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V.ι ≫ f₁.left)) :
    ∃ (R'_B : CommRingCat.{u}) (e_B : AlgebraicGeometry.Spec R'_B ⟶ B₁.left)
      (ψ_B : MvPolynomial (Fin m) k →+* ↑R'_B)
      (p_B : AlgebraicGeometry.Spec R'_B) (I₀ : Finset (Fin m))
      (ρ₀ : {c : Fin m // c ∈ I₀} → Fin r_B) (h : ↑R'_B)
      (B' : CommRingCat.{u}) (v' : AlgebraicGeometry.Spec B')
      (e_C : AlgebraicGeometry.Spec B' ⟶ C₁.left)
      (ψ_nodal : (MvPolynomial (Fin 2) ↑R'_B ⧸ Ideal.span
        {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h}) →+* ↑B'),
      IsShrunkNodalSncDatumAt k m B₁ r_B D_B ιD_B C₁
        (f₁.left.base ⁻¹' Z_B₁ ∪ ⋃ j : Fin n, Set.range (τ₁ j).left.base) f₁
        {y : C₁.left | ¬ ∃ V : C₁.left.Opens,
          y ∈ V ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V.ι ≫ f₁.left)}
        x R'_B e_B ψ_B p_B I₀ ρ₀ h B' v' e_C ψ_nodal :=
by
  
  have h_s1 : ∀ (b : B₁.left),
      ∃ (A : CommRingCat.{u}) (j_B : AlgebraicGeometry.Spec A ⟶ B₁.left)
        (ψ_A : MvPolynomial (Fin m) k →+* ↑A)
        (p_A : AlgebraicGeometry.Spec A) (I₀ : Finset (Fin m))
        (ρ₀ : {c : Fin m // c ∈ I₀} → Fin r_B),
        AlgebraicGeometry.IsOpenImmersion j_B ∧
        AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_A)) ∧
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_A) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = j_B ≫ B₁.hom) ∧
        j_B.base p_A = b ∧
        (∀ c ∈ I₀, ψ_A (MvPolynomial.X c) ∈ p_A.asIdeal) ∧
        Function.Injective ρ₀ ∧
        j_B.base ⁻¹' Z_B₁ =
          {w : AlgebraicGeometry.Spec A | ∃ c ∈ I₀, ψ_A (MvPolynomial.X c) ∈ w.asIdeal} ∧
        (∀ (c : Fin m) (hc : c ∈ I₀),
          j_B.base ⁻¹' Set.range (ιD_B (ρ₀ ⟨c, hc⟩)).base =
            {w : AlgebraicGeometry.Spec A | ψ_A (MvPolynomial.X c) ∈ w.asIdeal}) := by
    clear U_B₁ hU_B₁_eq C₁ f₁ n τ₁ hCurve₁ x hx
    intro b
    classical
    obtain ⟨U, hAffU, hbU, ψ₀, hEt₀, hComm₀, α, hInj_α, hKer⟩ := hChartsB₁ b
    let A₀ : CommRingCat.{u} := B₁.left.presheaf.obj (Opposite.op U)
    let i_U : Spec A₀ ⟶ B₁.left := hAffU.fromSpec
    let q_b : Spec A₀ := U.toSpecΓ.base ⟨b, hbU⟩
    have hqb : i_U.base q_b = b := by
      change (U.toSpecΓ ≫ hAffU.fromSpec).base ⟨b, hbU⟩ = b
      rw [hAffU.toSpecΓ_fromSpec]
      rfl
    have hiso_hom : hAffU.isoSpec.hom = U.toSpecΓ := hAffU.isoSpec_hom
    have hiso_inv_ι : hAffU.isoSpec.inv ≫ U.ι = i_U := by
      rw [← hAffU.toSpecΓ_fromSpec, ← hiso_hom, Iso.inv_hom_id_assoc]
    have hEt_ψ₀ : Etale (Spec.map (CommRingCat.ofHom ψ₀)) := by
      have hEq : Spec.map (CommRingCat.ofHom ψ₀) =
          hAffU.isoSpec.inv ≫ (U.toSpecΓ ≫ Spec.map (CommRingCat.ofHom ψ₀)) := by
        rw [← Category.assoc, ← hiso_hom, Iso.inv_hom_id, Category.id_comp]
      rw [hEq]
      exact inferInstance
    have hComm_ψ₀ : Spec.map (CommRingCat.ofHom ψ₀) ≫ Spec.map (CommRingCat.ofHom MvPolynomial.C) =
        i_U ≫ B₁.hom := by
      calc
        Spec.map (CommRingCat.ofHom ψ₀) ≫ Spec.map (CommRingCat.ofHom MvPolynomial.C)
          = hAffU.isoSpec.inv ≫ (U.toSpecΓ ≫ Spec.map (CommRingCat.ofHom ψ₀) ≫
              Spec.map (CommRingCat.ofHom MvPolynomial.C)) := by
            rw [← Category.assoc, ← Category.assoc, ← hiso_hom, Iso.inv_hom_id, Category.id_comp]
        _ = hAffU.isoSpec.inv ≫ (U.ι ≫ B₁.hom) := by rw [hComm₀]
        _ = i_U ≫ B₁.hom := by rw [← Category.assoc, hiso_inv_ι]
    have hDiv_iU : ∀ (i : Fin r_B),
        (∀ (hi : Nonempty ↑((TopologicalSpace.Opens.map (ιD_B i).base).obj U)),
          i_U.base ⁻¹' Set.range (ιD_B i).base =
            {w : Spec A₀ | ψ₀ (MvPolynomial.X (α ⟨i, hi⟩)) ∈ w.asIdeal}) ∧
        (¬ Nonempty ↑((TopologicalSpace.Opens.map (ιD_B i).base).obj U) →
          i_U.base ⁻¹' Set.range (ιD_B i).base = ∅) := by
      intro i
      have : IsClosedImmersion (ιD_B i) := hClD_B i
      let V_i : (D_B i).Opens := (TopologicalSpace.Opens.map (ιD_B i).base).obj U
      refine ⟨fun hi => ?_, fun hni => ?_⟩
      · have hAffV_i : IsAffineOpen V_i := hAffU.preimage (ιD_B i)
        have hSurj_i : Function.Surjective ((ιD_B i).app U).hom :=
          ((AlgebraicGeometry.isClosedImmersion_iff_isAffineHom (f := ιD_B i)).mp inferInstance).2 U hAffU
        have hSq : Spec.map ((ιD_B i).app U) ≫ i_U = hAffV_i.fromSpec ≫ ιD_B i := by
          rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE]
          exact IsAffineOpen.SpecMap_appLE_fromSpec (ιD_B i) hAffU hAffV_i (le_refl V_i)
        ext w
        simp only [Set.mem_preimage, Set.mem_range]
        change (∃ z, (ιD_B i).base z = i_U.base w) ↔
          ψ₀ (MvPolynomial.X (α ⟨i, hi⟩)) ∈ w.asIdeal
        constructor
        · rintro ⟨z, hz⟩
          have hzV : z ∈ V_i := by
            change (ιD_B i).base z ∈ (U : Set B₁.left)
            rw [hz, ← hAffU.range_fromSpec]
            exact ⟨w, rfl⟩
          have hzRange : z ∈ Set.range hAffV_i.fromSpec.base := by
            rw [hAffV_i.range_fromSpec]
            exact hzV
          obtain ⟨z₀, rfl⟩ := hzRange
          have hw_eq : (Spec.map ((ιD_B i).app U)).base z₀ = w := by
            apply i_U.isOpenEmbedding.injective
            change (Spec.map ((ιD_B i).app U) ≫ i_U).base z₀ = i_U.base w
            rw [hSq]
            exact hz
          rw [← hw_eq]
          change ((ιD_B i).app U).hom (ψ₀ (MvPolynomial.X (α ⟨i, hi⟩))) ∈ z₀.asIdeal
          have hMemKer : ψ₀ (MvPolynomial.X (α ⟨i, hi⟩)) ∈ RingHom.ker ((ιD_B i).app U).hom := by
            rw [hKer i hi]
            exact Ideal.subset_span rfl
          rw [RingHom.mem_ker.mp hMemKer]
          exact z₀.asIdeal.zero_mem
        · intro hw
          have hle : RingHom.ker ((ιD_B i).app U).hom ≤ w.asIdeal := by
            rw [hKer i hi, Ideal.span_singleton_le_iff_mem]
            exact hw
          have hw_range : (w : PrimeSpectrum ↑A₀) ∈
              Set.range (PrimeSpectrum.comap ((ιD_B i).app U).hom) := by
            rw [range_comap_of_surjective _ _ hSurj_i]
            exact (PrimeSpectrum.mem_zeroLocus _ _).mpr (SetLike.coe_subset_coe.mpr hle)
          obtain ⟨z₀, hz₀⟩ := hw_range
          refine ⟨hAffV_i.fromSpec.base z₀, ?_⟩
          change (hAffV_i.fromSpec ≫ ιD_B i).base z₀ = i_U.base w
          rw [← hSq]
          change i_U.base ((Spec.map ((ιD_B i).app U)).base z₀) = i_U.base w
          congr 1
      · ext w
        simp only [Set.mem_preimage, Set.mem_range, Set.mem_empty_iff_false, iff_false]
        rintro ⟨z, hz⟩
        apply hni
        refine ⟨⟨z, ?_⟩⟩
        change (ιD_B i).base z ∈ (U : Set B₁.left)
        rw [hz, ← hAffU.range_fromSpec]
        exact ⟨w, rfl⟩
    let Idx := {i : Fin r_B // Nonempty ↑((TopologicalSpace.Opens.map (ιD_B i).base).obj U)}
    let pq_b : PrimeSpectrum ↑A₀ := q_b
    let S_act : Finset Idx := Finset.univ.filter (fun idx => ψ₀ (MvPolynomial.X (α idx)) ∈ pq_b.asIdeal)
    let S_inact : Finset Idx := Finset.univ.filter (fun idx => ψ₀ (MvPolynomial.X (α idx)) ∉ pq_b.asIdeal)
    let g_inact : ↑A₀ := ∏ idx ∈ S_inact, ψ₀ (MvPolynomial.X (α idx))
    have hg_notMem : g_inact ∉ pq_b.asIdeal := by
      intro hg_mem
      obtain ⟨idx, hidx_mem, hfactor_mem⟩ := pq_b.isPrime.prod_mem_iff.mp hg_mem
      exact (Finset.mem_filter.mp hidx_mem).2 hfactor_mem
    let A_ring := Localization.Away g_inact
    let A : CommRingCat.{u} := CommRingCat.of A_ring
    let loc_A : ↑A₀ →+* A_ring := algebraMap ↑A₀ A_ring
    let j_A : Spec A ⟶ Spec A₀ := Spec.map (@CommRingCat.ofHom (↑A₀) A_ring _ _ loc_A)
    have : IsOpenImmersion j_A := AlgebraicGeometry.IsOpenImmersion.of_isLocalization g_inact
    let j_B : Spec A ⟶ B₁.left := j_A ≫ i_U
    let ψ_A : MvPolynomial (Fin m) k →+* ↑A := loc_A.comp ψ₀
    have hSpec_ψA : Spec.map (CommRingCat.ofHom ψ_A) = j_A ≫ Spec.map (CommRingCat.ofHom ψ₀) := by
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    have hEt_ψA : Etale (Spec.map (CommRingCat.ofHom ψ_A)) := by
      rw [hSpec_ψA]
      exact inferInstance
    have hComm_ψA : Spec.map (CommRingCat.ofHom ψ_A) ≫ Spec.map (CommRingCat.ofHom MvPolynomial.C) =
        j_B ≫ B₁.hom := by
      rw [hSpec_ψA, Category.assoc, hComm_ψ₀, ← Category.assoc]
    have hqb_range : pq_b ∈ Set.range (PrimeSpectrum.comap loc_A) := by
      rw [PrimeSpectrum.localization_away_comap_range A_ring g_inact]
      exact hg_notMem
    obtain ⟨p_A, hp_A_eq⟩ := hqb_range
    have hjA_pA : j_A.base p_A = q_b := hp_A_eq
    have hjB_pA : j_B.base p_A = b := by
      change i_U.base (j_A.base p_A) = b
      rw [hjA_pA, hqb]
    have hInact_notMem : ∀ (idx : Idx), idx ∈ S_inact → ∀ (w : Spec A),
        ψ_A (MvPolynomial.X (α idx)) ∉ w.asIdeal := by
      intro idx hidx w hMem
      have hdvd : ψ₀ (MvPolynomial.X (α idx)) ∣ g_inact :=
        Finset.dvd_prod_of_mem _ hidx
      have hUnit_g : IsUnit (loc_A g_inact) :=
        IsLocalization.Away.algebraMap_isUnit g_inact
      have hUnit_x : IsUnit (ψ_A (MvPolynomial.X (α idx))) :=
        isUnit_of_dvd_unit (map_dvd loc_A hdvd) hUnit_g
      let pw : PrimeSpectrum A_ring := w
      exact pw.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem pw.asIdeal hMem hUnit_x)
    let I₀ : Finset (Fin m) := S_act.image α
    let ρ₀ : {c : Fin m // c ∈ I₀} → Fin r_B :=
      fun c => (Classical.choose (Finset.mem_image.mp c.2)).1
    have hρ₀_spec : ∀ (c : {c : Fin m // c ∈ I₀}),
        Classical.choose (Finset.mem_image.mp c.2) ∈ S_act ∧
        α (Classical.choose (Finset.mem_image.mp c.2)) = c.1 :=
      fun c => Classical.choose_spec (Finset.mem_image.mp c.2)
