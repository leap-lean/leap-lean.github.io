theorem weil_toroidal_squarefree_etale_locus_iff (k : Type u) [Field k] (m : ℕ)
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (R' : CommRingCat.{u}) (e_X : AlgebraicGeometry.Spec R' ⟶ X.left)
    (S_exp : Finset (Fin m))
    (q : AlgebraicGeometry.Spec R' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
      (MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ Ideal.span
        {MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
          ∏ i ∈ S_exp, MvPolynomial.X (Sum.inr i)})))
    (hEt_e : AlgebraicGeometry.Etale e_X)
    (hEt_q : AlgebraicGeometry.Etale q)
    (hCard : 2 ≤ S_exp.card)
    (hComm : q ≫ AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) = e_X ≫ X.hom)
    (v : AlgebraicGeometry.Spec R') :
    ¬ HasEtaleSmoothRoofOver k (m + 1) X (e_X.base v) ↔
      ∃ i ∈ S_exp, ∃ j ∈ S_exp, i ≠ j ∧
        (∀ a : Fin 2,
          Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl a)) ∈ (q.base v).asIdeal) ∧
        Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr i)) ∈ (q.base v).asIdeal ∧
        Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr j)) ∈ (q.base v).asIdeal :=
by
  let _ := hCard
  let F : MvPolynomial (Fin 2 ⊕ Fin m) k :=
    MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
      ∏ i ∈ S_exp, MvPolynomial.X (Sum.inr i)
  let I_F : Ideal (MvPolynomial (Fin 2 ⊕ Fin m) k) := Ideal.span {F}
  let π_M : MvPolynomial (Fin 2 ⊕ Fin m) k →+* (MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ I_F) :=
    Ideal.Quotient.mk I_F
  let p_M : PrimeSpectrum (MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ I_F) := q.base v
  have : p_M.asIdeal.IsPrime := p_M.isPrime
  have hcard_compl : ∀ s_star : Fin 2 ⊕ Fin m,
      Fintype.card {s : Fin 2 ⊕ Fin m // s ≠ s_star} = m + 1 := by
    intro s_star
    rw [Fintype.card_subtype_compl, Fintype.card_sum, Fintype.card_fin, Fintype.card_fin,
      Fintype.card_unique]
    omega
  constructor
  · intro hNotRoof
    by_contra hNotPair
    
    have hElim : ∀ (s_star : Fin 2 ⊕ Fin m),
        let e : Fin (m + 1) ≃ {s : Fin 2 ⊕ Fin m // s ≠ s_star} :=
          (Fintype.equivFinOfCardEq (hcard_compl s_star)).symm
        let ι : MvPolynomial (Fin (m + 1)) k →ₐ[k] MvPolynomial (Fin 2 ⊕ Fin m) k :=
          MvPolynomial.rename (Subtype.val ∘ e)
        ∀ (G₀ H₀ : MvPolynomial (Fin (m + 1)) k),
          Ideal.span {ι G₀ * MvPolynomial.X s_star - ι H₀} = I_F →
          π_M (ι G₀) ∉ p_M.asIdeal →
          ∃ (u : MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ I_F)
            (ψ₀ : MvPolynomial (Fin (m + 1)) k →+* Localization.Away u),
            u ∉ p_M.asIdeal ∧
            ψ₀.Etale ∧
            ψ₀.comp MvPolynomial.C =
              (algebraMap (MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ I_F) (Localization.Away u)).comp
                (π_M.comp MvPolynomial.C) := by
      intro s_star e ι G₀ H₀ hSpan hu
      let u : MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ I_F := π_M (ι G₀)
      let α₁ : MvPolynomial (Fin (m + 1)) k →+* Localization.Away G₀ :=
        algebraMap (MvPolynomial (Fin (m + 1)) k) (Localization.Away G₀)
      let α_M : (MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ I_F) →+* Localization.Away u :=
        algebraMap (MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ I_F) (Localization.Away u)
      let ψ₀ : MvPolynomial (Fin (m + 1)) k →+* Localization.Away u :=
        α_M.comp (π_M.comp ι.toRingHom)
      have hUnit_u : IsUnit (ψ₀ G₀) := by
        change IsUnit (α_M u)
        exact IsLocalization.Away.algebraMap_isUnit u
      let φ_fwd : Localization.Away G₀ →+* Localization.Away u :=
        IsLocalization.Away.lift G₀ hUnit_u
      let g_tilde : MvPolynomial (Fin 2 ⊕ Fin m) k →ₐ[k] Localization.Away G₀ :=
        MvPolynomial.aeval fun s : Fin 2 ⊕ Fin m =>
          if hs : s = s_star then α₁ H₀ * IsLocalization.Away.invSelf G₀
          else α₁ (MvPolynomial.X (e.symm ⟨s, hs⟩))
      have hg_iota : ∀ q₁ : MvPolynomial (Fin (m + 1)) k, g_tilde (ι q₁) = α₁ q₁ := by
        have hAlg : g_tilde.comp ι =
            IsScalarTower.toAlgHom k (MvPolynomial (Fin (m + 1)) k) (Localization.Away G₀) := by
          apply MvPolynomial.algHom_ext
          intro r
          change g_tilde ((MvPolynomial.rename (Subtype.val ∘ e)) (MvPolynomial.X r)) =
            α₁ (MvPolynomial.X r)
          rw [MvPolynomial.rename_X]
          dsimp only [g_tilde, Function.comp_apply]
          rw [MvPolynomial.aeval_X]
          have hr : (e r).1 ≠ s_star := (e r).2
          split_ifs with h_eq
          · exact (hr h_eq).elim
          · simp only [Subtype.coe_eta, Equiv.symm_apply_apply]
        intro q₁
        exact AlgHom.congr_fun hAlg q₁
      have hg_rel : g_tilde (ι G₀ * MvPolynomial.X s_star - ι H₀) = 0 := by
        rw [map_sub, map_mul, hg_iota G₀, hg_iota H₀]
        have hX : g_tilde (MvPolynomial.X s_star) = α₁ H₀ * IsLocalization.Away.invSelf G₀ := by
          dsimp only [g_tilde]
          rw [MvPolynomial.aeval_X]
          split_ifs with h_eq
          · rfl
          · exact (h_eq rfl).elim
        rw [hX]
        calc
          α₁ G₀ * (α₁ H₀ * IsLocalization.Away.invSelf G₀) - α₁ H₀
            = (α₁ G₀ * IsLocalization.Away.invSelf G₀) * α₁ H₀ - α₁ H₀ := by ring
          _ = 1 * α₁ H₀ - α₁ H₀ := by rw [IsLocalization.Away.mul_invSelf G₀]
          _ = 0 := by ring
      have hg_ker : ∀ a ∈ I_F, g_tilde.toRingHom a = 0 := by
        intro a ha
        rw [← hSpan, Ideal.mem_span_singleton] at ha
        rcases ha with ⟨b, rfl⟩
        simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, map_mul, hg_rel, zero_mul]
      let g_bar : (MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ I_F) →+* Localization.Away G₀ :=
        Ideal.Quotient.lift I_F g_tilde.toRingHom hg_ker
      have hUnit_G₀ : IsUnit (g_bar u) := by
        have hEq : g_bar u = α₁ G₀ := by
          change Ideal.Quotient.lift I_F g_tilde.toRingHom hg_ker
            (Ideal.Quotient.mk I_F (ι G₀)) = α₁ G₀
          rw [Ideal.Quotient.lift_mk]
          exact hg_iota G₀
        rw [hEq]
        exact IsLocalization.Away.algebraMap_isUnit G₀
      let φ_bwd : Localization.Away u →+* Localization.Away G₀ :=
        IsLocalization.Away.lift u hUnit_G₀
      have h_bwd_fwd : φ_bwd.comp φ_fwd = RingHom.id (Localization.Away G₀) := by
        apply IsLocalization.ringHom_ext (Submonoid.powers G₀)
        apply RingHom.ext
        intro q₁
        simp only [RingHom.comp_apply, RingHom.id_apply]
        change φ_bwd (φ_fwd (α₁ q₁)) = α₁ q₁
        rw [IsLocalization.Away.lift_eq (S := Localization.Away G₀) G₀ hUnit_u q₁]
        change φ_bwd (α_M (Ideal.Quotient.mk I_F (ι q₁))) = α₁ q₁
        rw [IsLocalization.Away.lift_eq (S := Localization.Away u) u hUnit_G₀]
        change Ideal.Quotient.lift I_F g_tilde.toRingHom hg_ker
          (Ideal.Quotient.mk I_F (ι q₁)) = α₁ q₁
        rw [Ideal.Quotient.lift_mk]
        exact hg_iota q₁
      have h_fwd_bwd : φ_fwd.comp φ_bwd = RingHom.id (Localization.Away u) := by
        apply IsLocalization.ringHom_ext (Submonoid.powers u)
        apply Ideal.Quotient.ringHom_ext
        apply MvPolynomial.ringHom_ext'
        · apply RingHom.ext
          intro c
          simp only [RingHom.comp_apply, RingHom.id_apply]
          change φ_fwd (φ_bwd (α_M (Ideal.Quotient.mk I_F (MvPolynomial.C c)))) =
            α_M (π_M (MvPolynomial.C c))
          rw [IsLocalization.Away.lift_eq (S := Localization.Away u) u hUnit_G₀,
            Ideal.Quotient.lift_mk]
          have hιC : ι (MvPolynomial.C c) = MvPolynomial.C c := by
            dsimp only [ι]
            exact MvPolynomial.rename_C _ c
          have hC : g_tilde.toRingHom (MvPolynomial.C c) = α₁ (MvPolynomial.C c) := by
            change g_tilde (MvPolynomial.C c) = α₁ (MvPolynomial.C c)
            rw [← hιC]
            exact hg_iota (MvPolynomial.C c)
          rw [hC, IsLocalization.Away.lift_eq (S := Localization.Away G₀) G₀ hUnit_u]
          change α_M (π_M (ι (MvPolynomial.C c))) = α_M (π_M (MvPolynomial.C c))
          rw [hιC]
        · intro s
          simp only [RingHom.comp_apply, RingHom.id_apply]
          change φ_fwd (φ_bwd (α_M (Ideal.Quotient.mk I_F (MvPolynomial.X s)))) =
            α_M (π_M (MvPolynomial.X s))
          rw [IsLocalization.Away.lift_eq (S := Localization.Away u) u hUnit_G₀,
            Ideal.Quotient.lift_mk]
          change φ_fwd (g_tilde (MvPolynomial.X s)) = α_M (π_M (MvPolynomial.X s))
          by_cases hs : s = s_star
          · subst hs
            have hXs : g_tilde (MvPolynomial.X s) = α₁ H₀ * IsLocalization.Away.invSelf G₀ := by
              dsimp only [g_tilde]
              rw [MvPolynomial.aeval_X]
              split_ifs with h_eq
              · rfl
              · exact (h_eq rfl).elim
            rw [hXs]
            apply (IsLocalization.Away.algebraMap_isUnit u).mul_left_cancel
            have hu_eq : α_M u = φ_fwd (α₁ G₀) :=
              (IsLocalization.Away.lift_eq (S := Localization.Away G₀) G₀ hUnit_u G₀).symm
            have hM_rel : u * π_M (MvPolynomial.X s) = π_M (ι H₀) := by
              have hMem : ι G₀ * MvPolynomial.X s - ι H₀ ∈ I_F := by
                rw [← hSpan]
                exact Ideal.subset_span rfl
              have hZero : π_M (ι G₀ * MvPolynomial.X s - ι H₀) = 0 :=
                Ideal.Quotient.eq_zero_iff_mem.mpr hMem
              rw [map_sub, map_mul] at hZero
              exact sub_eq_zero.mp hZero
            calc
              α_M u * φ_fwd (α₁ H₀ * IsLocalization.Away.invSelf G₀)
                = φ_fwd (α₁ G₀) * φ_fwd (α₁ H₀ * IsLocalization.Away.invSelf G₀) := by rw [hu_eq]
              _ = φ_fwd ((α₁ G₀ * IsLocalization.Away.invSelf G₀) * α₁ H₀) := by
                  rw [← map_mul]
                  congr 1
                  ring
              _ = φ_fwd (1 * α₁ H₀) := by rw [IsLocalization.Away.mul_invSelf G₀]
              _ = φ_fwd (α₁ H₀) := by rw [one_mul]
              _ = α_M (π_M (ι H₀)) :=
                  IsLocalization.Away.lift_eq (S := Localization.Away G₀) G₀ hUnit_u H₀
              _ = α_M (u * π_M (MvPolynomial.X s)) := by rw [hM_rel]
              _ = α_M u * α_M (π_M (MvPolynomial.X s)) := map_mul α_M _ _
          · have hXs : g_tilde (MvPolynomial.X s) = α₁ (MvPolynomial.X (e.symm ⟨s, hs⟩)) := by
              dsimp only [g_tilde]
              rw [MvPolynomial.aeval_X]
              split_ifs
              rfl
            rw [hXs, IsLocalization.Away.lift_eq (S := Localization.Away G₀) G₀ hUnit_u]
            change α_M (π_M ((MvPolynomial.rename (Subtype.val ∘ e))
              (MvPolynomial.X (e.symm ⟨s, hs⟩)))) = α_M (π_M (MvPolynomial.X s))
            rw [MvPolynomial.rename_X]
            simp only [Function.comp_apply, Equiv.apply_symm_apply]
      let _ : Algebra (MvPolynomial (Fin (m + 1)) k) (Localization.Away u) := ψ₀.toAlgebra
      let Φ : Localization.Away G₀ ≃ₐ[MvPolynomial (Fin (m + 1)) k] Localization.Away u :=
        { toFun := φ_fwd
          invFun := φ_bwd
          left_inv := fun x => RingHom.congr_fun h_bwd_fwd x
          right_inv := fun y => RingHom.congr_fun h_fwd_bwd y
          map_mul' := φ_fwd.map_mul
          map_add' := φ_fwd.map_add
          commutes' := fun q₁ =>
            IsLocalization.Away.lift_eq (S := Localization.Away G₀) G₀ hUnit_u q₁ }
      have : Algebra.Etale (MvPolynomial (Fin (m + 1)) k) (Localization.Away G₀) :=
        Algebra.Etale.of_isLocalizationAway G₀
      have hEtAlg : Algebra.Etale (MvPolynomial (Fin (m + 1)) k) (Localization.Away u) :=
        Algebra.Etale.of_equiv Φ
      have hEt_ψ₀ : ψ₀.Etale := RingHom.etale_algebraMap.mpr hEtAlg
      refine ⟨u, ψ₀, hu, hEt_ψ₀, ?_⟩
      apply RingHom.ext
      intro c
      change α_M (π_M ((MvPolynomial.rename (Subtype.val ∘ e)) (MvPolynomial.C c))) =
        α_M (π_M (MvPolynomial.C c))
      rw [MvPolynomial.rename_C]
    
    have hModel : ∃ (u : MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ I_F)
        (ψ₀ : MvPolynomial (Fin (m + 1)) k →+* Localization.Away u),
        u ∉ p_M.asIdeal ∧
        ψ₀.Etale ∧
        ψ₀.comp MvPolynomial.C =
          (algebraMap (MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ I_F) (Localization.Away u)).comp
            (π_M.comp MvPolynomial.C) := by
      by_cases h0 : π_M (MvPolynomial.X (Sum.inl 0)) ∈ p_M.asIdeal
      · by_cases h1 : π_M (MvPolynomial.X (Sum.inl 1)) ∈ p_M.asIdeal
        · 
          have hProdMem : ∏ i ∈ S_exp, π_M (MvPolynomial.X (Sum.inr i)) ∈ p_M.asIdeal := by
            have hF0 : π_M F = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
            have hEq : π_M (MvPolynomial.X (Sum.inl 0)) * π_M (MvPolynomial.X (Sum.inl 1)) =
                ∏ i ∈ S_exp, π_M (MvPolynomial.X (Sum.inr i)) := by
              change π_M (MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
                ∏ i ∈ S_exp, MvPolynomial.X (Sum.inr i)) = 0 at hF0
              rw [map_sub, map_mul, map_prod] at hF0
              exact sub_eq_zero.mp hF0
            rw [← hEq]
            exact p_M.asIdeal.mul_mem_right _ h0
          obtain ⟨i₀, hi₀, hi₀_mem⟩ := (p_M.isPrime.prod_mem_iff).mp hProdMem
          have hEraseNotMem : ∀ j ∈ S_exp.erase i₀,
              π_M (MvPolynomial.X (Sum.inr j)) ∉ p_M.asIdeal := by
            intro j hj hj_mem
            obtain ⟨hj_ne, hj_S⟩ := Finset.mem_erase.mp hj
            refine hNotPair ⟨i₀, hi₀, j, hj_S, hj_ne.symm, ?_, hi₀_mem, hj_mem⟩
            intro a
            fin_cases a
            · exact h0
            · exact h1
          have hProdNotMem :
              (∏ j ∈ S_exp.erase i₀, π_M (MvPolynomial.X (Sum.inr j))) ∉ p_M.asIdeal := by
            intro hMemProd
            obtain ⟨j, hj, hj_mem⟩ := (p_M.isPrime.prod_mem_iff).mp hMemProd
            exact hEraseNotMem j hj hj_mem
          let s_star : Fin 2 ⊕ Fin m := Sum.inr i₀
          let e : Fin (m + 1) ≃ {s : Fin 2 ⊕ Fin m // s ≠ s_star} :=
            (Fintype.equivFinOfCardEq (hcard_compl s_star)).symm
          let ι : MvPolynomial (Fin (m + 1)) k →ₐ[k] MvPolynomial (Fin 2 ⊕ Fin m) k :=
            MvPolynomial.rename (Subtype.val ∘ e)
          let G₀ : MvPolynomial (Fin (m + 1)) k := ∏ j ∈ S_exp.erase i₀,
            if hj : j = i₀ then 1
            else MvPolynomial.X (e.symm ⟨Sum.inr j, fun h => hj (Sum.inr.inj h)⟩)
          let H₀ : MvPolynomial (Fin (m + 1)) k :=
            MvPolynomial.X (e.symm ⟨Sum.inl 0, Sum.inl_ne_inr⟩) *
              MvPolynomial.X (e.symm ⟨Sum.inl 1, Sum.inl_ne_inr⟩)
          have hιG₀ : ι G₀ = ∏ j ∈ S_exp.erase i₀, MvPolynomial.X (Sum.inr j) := by
            dsimp only [G₀, ι]
            rw [map_prod]
            refine Finset.prod_congr rfl fun j hj => ?_
            have hj_ne : j ≠ i₀ := (Finset.mem_erase.mp hj).1
            split_ifs with h_eq
            · exact (hj_ne h_eq).elim
            · rw [MvPolynomial.rename_X]
              simp only [Function.comp_apply, Equiv.apply_symm_apply]
          have hιH₀ : ι H₀ = MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) := by
            dsimp only [H₀, ι]
            rw [map_mul, MvPolynomial.rename_X, MvPolynomial.rename_X]
            simp only [Function.comp_apply, Equiv.apply_symm_apply]
          refine hElim s_star G₀ H₀ ?_ ?_
          · change Ideal.span {ι G₀ * MvPolynomial.X s_star - ι H₀} = Ideal.span {F}
            have hNeg : ι G₀ * MvPolynomial.X s_star - ι H₀ = -F := by
              rw [hιG₀, hιH₀]
              have hProdEq : (∏ j ∈ S_exp.erase i₀,
                  (MvPolynomial.X (Sum.inr j) : MvPolynomial (Fin 2 ⊕ Fin m) k)) *
                  MvPolynomial.X (Sum.inr i₀) =
                  ∏ i ∈ S_exp, MvPolynomial.X (Sum.inr i) := by
                rw [mul_comm]
                exact Finset.mul_prod_erase S_exp
                  (fun i => (MvPolynomial.X (Sum.inr i) : MvPolynomial (Fin 2 ⊕ Fin m) k)) hi₀
              change (∏ j ∈ S_exp.erase i₀,
                  (MvPolynomial.X (Sum.inr j) : MvPolynomial (Fin 2 ⊕ Fin m) k)) *
                  MvPolynomial.X (Sum.inr i₀) -
                  MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) =
                -(MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
                  ∏ i ∈ S_exp, MvPolynomial.X (Sum.inr i))
              rw [hProdEq]
              ring
            rw [hNeg, Ideal.span_singleton_neg]
          · change π_M (ι G₀) ∉ p_M.asIdeal
            rw [hιG₀, map_prod]
            exact hProdNotMem
        · 
          let s_star : Fin 2 ⊕ Fin m := Sum.inl 0
          let e : Fin (m + 1) ≃ {s : Fin 2 ⊕ Fin m // s ≠ s_star} :=
            (Fintype.equivFinOfCardEq (hcard_compl s_star)).symm
          let ι : MvPolynomial (Fin (m + 1)) k →ₐ[k] MvPolynomial (Fin 2 ⊕ Fin m) k :=
            MvPolynomial.rename (Subtype.val ∘ e)
          have hne1 : (Sum.inl 1 : Fin 2 ⊕ Fin m) ≠ s_star :=
            Sum.inl_injective.ne (by decide : (1 : Fin 2) ≠ 0)
          let G₀ : MvPolynomial (Fin (m + 1)) k := MvPolynomial.X (e.symm ⟨Sum.inl 1, hne1⟩)
          let H₀ : MvPolynomial (Fin (m + 1)) k :=
            ∏ i ∈ S_exp, MvPolynomial.X (e.symm ⟨Sum.inr i, Sum.inr_ne_inl⟩)
          have hιG₀ : ι G₀ = MvPolynomial.X (Sum.inl 1) := by
            dsimp only [G₀, ι]
            rw [MvPolynomial.rename_X]
            simp only [Function.comp_apply, Equiv.apply_symm_apply]
          have hιH₀ : ι H₀ = ∏ i ∈ S_exp, MvPolynomial.X (Sum.inr i) := by
            dsimp only [H₀, ι]
            rw [map_prod]
            refine Finset.prod_congr rfl fun i _ => ?_
            rw [MvPolynomial.rename_X]
            simp only [Function.comp_apply, Equiv.apply_symm_apply]
          refine hElim s_star G₀ H₀ ?_ ?_
          · change Ideal.span {ι G₀ * MvPolynomial.X s_star - ι H₀} = Ideal.span {F}
            rw [hιG₀, hιH₀]
            congr 2
            change MvPolynomial.X (Sum.inl 1) * MvPolynomial.X (Sum.inl 0) -
              ∏ i ∈ S_exp, MvPolynomial.X (Sum.inr i) = F
            dsimp only [F]
            ring
          · change π_M (ι G₀) ∉ p_M.asIdeal
            rwa [hιG₀]
      · 
        let s_star : Fin 2 ⊕ Fin m := Sum.inl 1
        let e : Fin (m + 1) ≃ {s : Fin 2 ⊕ Fin m // s ≠ s_star} :=
          (Fintype.equivFinOfCardEq (hcard_compl s_star)).symm
        let ι : MvPolynomial (Fin (m + 1)) k →ₐ[k] MvPolynomial (Fin 2 ⊕ Fin m) k :=
          MvPolynomial.rename (Subtype.val ∘ e)
        have hne0 : (Sum.inl 0 : Fin 2 ⊕ Fin m) ≠ s_star :=
          Sum.inl_injective.ne (by decide : (0 : Fin 2) ≠ 1)
        let G₀ : MvPolynomial (Fin (m + 1)) k := MvPolynomial.X (e.symm ⟨Sum.inl 0, hne0⟩)
        let H₀ : MvPolynomial (Fin (m + 1)) k :=
          ∏ i ∈ S_exp, MvPolynomial.X (e.symm ⟨Sum.inr i, Sum.inr_ne_inl⟩)
        have hιG₀ : ι G₀ = MvPolynomial.X (Sum.inl 0) := by
          dsimp only [G₀, ι]
          rw [MvPolynomial.rename_X]
          simp only [Function.comp_apply, Equiv.apply_symm_apply]
        have hιH₀ : ι H₀ = ∏ i ∈ S_exp, MvPolynomial.X (Sum.inr i) := by
          dsimp only [H₀, ι]
          rw [map_prod]
          refine Finset.prod_congr rfl fun i _ => ?_
          rw [MvPolynomial.rename_X]
          simp only [Function.comp_apply, Equiv.apply_symm_apply]
        refine hElim s_star G₀ H₀ ?_ ?_
        · change Ideal.span {ι G₀ * MvPolynomial.X s_star - ι H₀} = Ideal.span {F}
          rw [hιG₀, hιH₀]
        · change π_M (ι G₀) ∉ p_M.asIdeal
          rwa [hιG₀]
    
    have hLift : ∀ (A : Type u) [CommRing A] (α : k →+* A)
        (qA : AlgebraicGeometry.Spec R' ⟶ AlgebraicGeometry.Spec (CommRingCat.of A))
        (_ : AlgebraicGeometry.Etale qA)
        (_ : qA ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom α) = e_X ≫ X.hom)
        (u : A) (ψ₀ : MvPolynomial (Fin (m + 1)) k →+* Localization.Away u),
        u ∉ (qA.base v).asIdeal →
        ψ₀.Etale →
        ψ₀.comp MvPolynomial.C = (algebraMap A (Localization.Away u)).comp α →
        HasEtaleSmoothRoofOver k (m + 1) X (e_X.base v) := by
      intro A _ α qA hEt_qA hCommA u ψ₀ hu hEt_ψ₀ hComm_ψ₀
      obtain ⟨φ_q, hφ_q⟩ : ∃ φ_q : CommRingCat.of A ⟶ R', AlgebraicGeometry.Spec.map φ_q = qA :=
        ⟨AlgebraicGeometry.Spec.preimage qA, AlgebraicGeometry.Spec.map_preimage qA⟩
      let s : R' := φ_q.hom u
      let p_v : PrimeSpectrum R' := v
      have hs : s ∉ p_v.asIdeal := by
        have hu' : u ∉ ((AlgebraicGeometry.Spec.map φ_q).base v).asIdeal := by
          rwa [hφ_q]
        exact hu'
      let R''_ring : Type u := Localization.Away s
      let R'' : CommRingCat.{u} := CommRingCat.of R''_ring
      let j_s : AlgebraicGeometry.Spec R'' ⟶ AlgebraicGeometry.Spec R' :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (↑R') R''_ring))
      have : AlgebraicGeometry.IsOpenImmersion j_s :=
        AlgebraicGeometry.Scheme.isOpenImmersion_SpecMap_localizationAway s
      let e'_X : AlgebraicGeometry.Spec R'' ⟶ X.left := j_s ≫ e_X
      have hEt_e' : AlgebraicGeometry.Etale e'_X := inferInstance
      have hDisj : Disjoint (Submonoid.powers s : Set R') (p_v.asIdeal : Set R') := by
        rw [Set.disjoint_left]
        rintro _ ⟨n, rfl⟩ hsn
        exact hs (p_v.isPrime.mem_of_pow_mem n hsn)
      let v₀ : AlgebraicGeometry.Spec R'' :=
        ⟨Ideal.map (algebraMap (↑R') R''_ring) p_v.asIdeal,
          IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers s) R''_ring
            p_v.asIdeal p_v.isPrime hDisj⟩
      have hj_v₀ : j_s.base v₀ = v := by
        apply PrimeSpectrum.ext
        exact IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers s) R''_ring
          p_v.isPrime hDisj
      have hv₀ : e'_X.base v₀ = e_X.base v := by
        change e_X.base (j_s.base v₀) = e_X.base v
        rw [hj_v₀]
      let g_A : A →+* R''_ring := (algebraMap (↑R') R''_ring).comp φ_q.hom
      have hu_unit : IsUnit (g_A u) := by
        change IsUnit (algebraMap (↑R') R''_ring s)
        exact IsLocalization.Away.algebraMap_isUnit s
      let φ_tilde : Localization.Away u →+* R''_ring := IsLocalization.Away.lift u hu_unit
      have hφ_tilde_comp : φ_tilde.comp (algebraMap A (Localization.Away u)) = g_A := by
        apply RingHom.ext
