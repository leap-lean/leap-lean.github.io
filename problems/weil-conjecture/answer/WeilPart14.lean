                Ideal.span (MvPolynomial.X '' (I : Set (Fin n))) :=
              Ideal.subset_span ⟨j, hj, rfl⟩
            have hev : ev (p * MvPolynomial.X j) = 0 := by simp [ev, hj]
            rw [hev, map_zero, sub_zero]
            exact Ideal.mul_mem_left _ p hXj
