    obtain ⟨hEt_ψ'', hReesQuot⟩ := hEt_and_Quot
    refine ⟨ψ'', hEt_ψ'', hψ''_C, hψ''_piv, hψ''_other, hψ''_out, ?_, ?_, ?_⟩
