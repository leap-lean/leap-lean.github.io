          rw [hval, hL₂_one]
          dsimp only [G, RingHom.comp_apply]
          rw [MvPolynomial.eval₂Hom_C, h_τLc]
        · change ψ_ov (awayR_N (HomogeneousLocalization.Away.isLocalizationElem (hX_N ν') (hX_N μ))) =
            τ_R (φ i'j' (HomogeneousLocalization.Away.isLocalizationElem (hX_N ν') (hX_N μ)))
          change L₂ (HomogeneousLocalization.val
            (awayR_N (HomogeneousLocalization.Away.isLocalizationElem (hX_N ν') (hX_N μ)))) = _
          have hval : HomogeneousLocalization.val
              (awayR_N (HomogeneousLocalization.Away.isLocalizationElem (hX_N ν') (hX_N μ))) =
              Localization.mk (X_N μ ^ 1 * X_N ν ^ 1)
                ⟨(X_N ν * X_N ν') ^ 1,
                  Submonoid.pow_mem _ (Submonoid.mem_powers _) 1⟩ := by
            dsimp only [awayR_N, HomogeneousLocalization.Away.isLocalizationElem]
            rw [HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.Away.val_mk]
          rw [hval, hL₂_s₁ _ _ rfl, pow_one, pow_one, map_mul, hG_ν, mul_one, hφ_ratio i'j' μ]
          dsimp only [G, τ_L, τ_R, g_poly, u_inv, X_N]
          simp only [RingHom.comp_apply, MvPolynomial.eval₂Hom_X', AlgHom.toRingHom_eq_coe,
