      ∀ {R' B D : Type u} [CommRing R'] [IsDomain R']
        [CommRing B] [Algebra R' B] [CommRing D] [Algebra R' D]
        (ιB : B →ₐ[R'] FractionRing R') (u : B) (hu : ιB u ≠ 0)
