      exact PrimeSpectrum.isClosed_zeroLocus (P'_c : Set M')
    have ha'_c : 1 ≤ a' c := by
      dsimp only [a']
      rwa [Function.update_of_ne hcc₀]
    let πc_raw : MvPolynomial (Fin 2 ⊕ Fin m) k →+* MvPolynomial {j : Fin m // j ≠ c} k :=
      MvPolynomial.eval₂Hom MvPolynomial.C fun s =>
        match s with
        | Sum.inl _ => 0
        | Sum.inr j => if hj : j = c then 0 else MvPolynomial.X ⟨j, hj⟩
    have hπc_rel : ∀ f ∈ I_M', πc_raw f = 0 := by
      intro f hf
      rw [Ideal.mem_span_singleton] at hf
      rcases hf with ⟨h, rfl⟩
      rw [map_mul, map_sub]
      have hprod0 : πc_raw (∏ j : Fin m, MvPolynomial.X (Sum.inr j) ^ a' j) = 0 := by
        rw [map_prod]
        refine Finset.prod_eq_zero (Finset.mem_univ c) ?_
        rw [map_pow]
        have hc0 : πc_raw (MvPolynomial.X (Sum.inr c)) = 0 := by
          simp [πc_raw]
        rw [hc0]
        exact zero_pow (by omega)
      have hinl0 : πc_raw (MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1)) = 0 := by
        simp [πc_raw]
      rw [hinl0, hprod0, sub_zero, zero_mul]
    let π_c : M' →+* MvPolynomial {j : Fin m // j ≠ c} k :=
      Ideal.Quotient.lift I_M' πc_raw hπc_rel
    have hπc_mk : ∀ p, π_c (Ideal.Quotient.mk I_M' p) = πc_raw p := fun _ => rfl
    let σ_c : MvPolynomial {j : Fin m // j ≠ c} k →+* M' :=
      MvPolynomial.eval₂Hom ((Ideal.Quotient.mk I_M').comp MvPolynomial.C)
        (fun j => t' j.1)
    have hMod_Pc : (Ideal.Quotient.mk P'_c).comp (σ_c.comp π_c) = Ideal.Quotient.mk P'_c := by
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext'
      · apply RingHom.ext; intro r
        change Ideal.Quotient.mk P'_c (σ_c (π_c (Ideal.Quotient.mk I_M' (MvPolynomial.C r)))) =
          Ideal.Quotient.mk P'_c (Ideal.Quotient.mk I_M' (MvPolynomial.C r))
        rw [hπc_mk]
        simp [πc_raw, σ_c]
      · intro s
        change Ideal.Quotient.mk P'_c (σ_c (π_c (Ideal.Quotient.mk I_M' (MvPolynomial.X s)))) =
          Ideal.Quotient.mk P'_c (Ideal.Quotient.mk I_M' (MvPolynomial.X s))
        rw [hπc_mk]
        rcases s with i | j
        · fin_cases i
          · have hx0 : Ideal.Quotient.mk P'_c (x' 0) = 0 :=
              Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (by simp))
            simpa [πc_raw, σ_c, x'] using hx0.symm
          · have hx1 : Ideal.Quotient.mk P'_c (x' 1) = 0 :=
              Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (by simp))
            simpa [πc_raw, σ_c, x'] using hx1.symm
        · by_cases hjc : j = c
          · subst hjc
            have htc : Ideal.Quotient.mk P'_c (t' j) = 0 :=
              Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (by simp))
            simpa [πc_raw, σ_c, t'] using htc.symm
          · simp [πc_raw, σ_c, hjc, t']
    have hKer_eq : P'_c = RingHom.ker π_c := by
      apply le_antisymm
      · rw [Ideal.span_le]
        rintro _ (rfl | rfl | rfl)
        · change π_c (x' 0) = 0
          simp [x', hπc_mk, πc_raw]
        · change π_c (x' 1) = 0
          simp [x', hπc_mk, πc_raw]
        · change π_c (t' c) = 0
          simp [t', hπc_mk, πc_raw]
      · intro y hy
        change π_c y = 0 at hy
        have hmk := RingHom.congr_fun hMod_Pc y
        change Ideal.Quotient.mk P'_c (σ_c (π_c y)) = Ideal.Quotient.mk P'_c y at hmk
        rw [hy, map_zero, map_zero] at hmk
        exact Ideal.Quotient.eq_zero_iff_mem.mp hmk.symm
    have hPc_prime : P'_c.IsPrime := by
      rw [hKer_eq]
      exact RingHom.ker_isPrime π_c
    have htc₀_not_Pc : t' c₀ ∉ P'_c := by
      rw [hKer_eq]
      change π_c (t' c₀) ≠ 0
      have hval : π_c (t' c₀) = MvPolynomial.X (⟨c₀, hcc₀.symm⟩ : {j : Fin m // j ≠ c}) := by
        simp [t', hπc_mk, πc_raw, hcc₀.symm]
      rw [hval]
      exact MvPolynomial.X_ne_zero (⟨c₀, hcc₀.symm⟩ : {j : Fin m // j ≠ c})
    let η_c : PrimeSpectrum M' := ⟨P'_c, hPc_prime⟩
    have hη_in_open : (η_c : AlgebraicGeometry.Spec (CommRingCat.of M')) ∈ S_open := by
      refine ⟨?_, Ideal.subset_span (by simp), htc₀_not_Pc⟩
      intro i
      fin_cases i
      · exact Ideal.subset_span (by simp)
      · exact Ideal.subset_span (by simp)
    apply Set.Subset.antisymm
    · exact hClosed_S.closure_subset_iff.mpr fun u hu => ⟨hu.1, hu.2.1⟩
    · rw [← hZeroLocus]
      have hSing : (PrimeSpectrum.zeroLocus (P'_c : Set M') :
          Set (AlgebraicGeometry.Spec (CommRingCat.of M'))) =
          closure ({(η_c : AlgebraicGeometry.Spec (CommRingCat.of M'))} :
            Set (AlgebraicGeometry.Spec (CommRingCat.of M'))) :=
        (PrimeSpectrum.closure_singleton η_c).symm
      rw [hSing]
      exact closure_mono (Set.singleton_subset_iff.mpr hη_in_open)

  have hConj3_6 : 4 ≤ a c₀ →
      ∀ v : AlgebraicGeometry.Spec B',
        (∀ j : Fin 3, g j ∈ v.asIdeal) →
      ∃! w : AlgebraicGeometry.Spec (CommRingCat.of A₂_B),
        (∀ i : Fin 2,
          Ideal.Quotient.mk I_M' (MvPolynomial.X (Sum.inl i)) ∈ (q'_2.base w).asIdeal) ∧
        Ideal.Quotient.mk I_M' (MvPolynomial.X (Sum.inr c₀)) ∈ (q'_2.base w).asIdeal ∧
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_B)).base w = v := by
    intro h4 v hv
    let x' : Fin 2 → M' := fun i => Ideal.Quotient.mk I_M' (MvPolynomial.X (Sum.inl i))
    let t' : Fin m → M' := fun j => Ideal.Quotient.mk I_M' (MvPolynomial.X (Sum.inr j))
    let I_B : Ideal B' := Ideal.span (Set.range g)
    have hIB_le_v : I_B ≤ v.asIdeal := Ideal.span_le.mpr (Set.range_subset_iff.mpr hv)
    let Q := ↥B' ⧸ I_B
    let π_B : B' →+* Q := Ideal.Quotient.mk I_B
    have hπB_g : ∀ j : Fin 3, π_B (g j) = 0 :=
      fun j => Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨j, rfl⟩)
    let c_Q : k →+* Q := π_B.comp (ψ_q.comp ((Ideal.Quotient.mk I_M).comp MvPolynomial.C))
    let α_raw : MvPolynomial (Fin 2 ⊕ Fin m) k →+* Q :=
      MvPolynomial.eval₂Hom c_Q fun s =>
        match s with
        | Sum.inl _ => 0
        | Sum.inr c => π_B (ψ_q (Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inr c))))
    have hα_rel : ∀ f ∈ I_M', α_raw f = 0 := by
      intro f hf
      rw [Ideal.mem_span_singleton] at hf
      rcases hf with ⟨h, rfl⟩
      rw [map_mul, map_sub]
      have hinl0 : α_raw (MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1)) = 0 := by
        simp [α_raw]
      have hprod0 : α_raw (∏ c : Fin m, MvPolynomial.X (Sum.inr c) ^ a' c) = 0 := by
        rw [map_prod]
        refine Finset.prod_eq_zero (Finset.mem_univ c₀) ?_
        rw [map_pow]
        have hc₀_val : α_raw (MvPolynomial.X (Sum.inr c₀)) = 0 := by
          have hval : α_raw (MvPolynomial.X (Sum.inr c₀)) =
              π_B (ψ_q (Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inr c₀)))) := by
            simp [α_raw]
          rw [hval, ← hg2]
          exact hπB_g 2
        have ha'_c₀_ne : a' c₀ ≠ 0 := by
          dsimp only [a']
          rw [Function.update_self]
          omega
        rw [hc₀_val]
        exact zero_pow ha'_c₀_ne
      rw [hinl0, hprod0, sub_zero, zero_mul]
    let α : M' →+* Q := Ideal.Quotient.lift I_M' α_raw hα_rel
    have hα_mk : ∀ p, α (Ideal.Quotient.mk I_M' p) = α_raw p := fun _ => rfl
    let β := α.comp Φ_2.symm.toRingHom
    have hCompat_Q : π_B.comp ψ_q = β.comp (algebraMap M _) := by
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext'
      · apply RingHom.ext; intro r
        change π_B (ψ_q (Ideal.Quotient.mk I_M (MvPolynomial.C r))) =
          α (Φ_2.symm (algebraMap M _ (Ideal.Quotient.mk I_M (MvPolynomial.C r))))
        have hsc : algebraMap M _ (Ideal.Quotient.mk I_M (MvPolynomial.C r)) =
            Φ_2 (algebraMap k M' r) := by
          rw [Φ_2.commutes]
          exact (IsScalarTower.algebraMap_apply k M _ r).symm
        rw [hsc, Φ_2.symm_apply_apply]
        change _ = α (Ideal.Quotient.mk I_M' (MvPolynomial.C r))
        rw [hα_mk]
        simp [α_raw, c_Q]
      · intro s
        rcases s with i | c
        · change π_B (ψ_q (Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inl i)))) =
            α (Φ_2.symm (algebraMap M _ (Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inl i)))))
          have hlhs0 : π_B (ψ_q (Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inl i)))) = 0 := by
            fin_cases i
            · change π_B (ψ_q (m_gen 0)) = 0; rw [← hg_eq 0]; exact hπB_g 0
            · change π_B (ψ_q (m_gen 1)) = 0; rw [← hg_eq 1]; exact hπB_g 1
          have hm_eq : algebraMap M _ (Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inl i))) =
              Φ_2 (t' c₀ * x' i) := by
            have hp := hΦ2_prod i
            have hm2 : algebraMap M _ (m_gen 2) = Φ_2 (t' c₀) := (hΦ2_inr c₀).symm
            rw [hm2, ← map_mul] at hp
            fin_cases i <;> exact hp
          rw [hlhs0, hm_eq, Φ_2.symm_apply_apply, map_mul]
          have hx0 : α (x' i) = 0 := by
            simp [x', hα_mk, α_raw]
          rw [hx0, mul_zero]
        · change π_B (ψ_q (Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inr c)))) =
            α (Φ_2.symm (algebraMap M _ (Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inr c)))))
          rw [← hΦ2_inr c, Φ_2.symm_apply_apply]
          simp [hα_mk, α_raw]
    obtain ⟨G, hG_B, hG_ι2⟩ := hPush_ι2 Q π_B β hCompat_Q
    have hG_ψ'2 : G.comp ψ'_2 = α := by
      change (G.comp ι_2).comp φ_2_hom = α
      rw [hG_ι2]
      apply RingHom.ext; intro y
      change α (Φ_2.symm (φ_2_hom y)) = α y
      rw [hφ2_app, Φ_2.symm_apply_apply]
    let q_B : Ideal Q := Ideal.map π_B v.asIdeal
    have : v.asIdeal.IsPrime := v.2
    have hq_B_prime : q_B.IsPrime := by
      apply Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective
      rw [Ideal.mk_ker]
      exact hIB_le_v
    have : q_B.IsPrime := hq_B_prime
    have hcomap_qB : Ideal.comap π_B q_B = v.asIdeal := by
      rw [Ideal.comap_map_of_surjective' π_B Ideal.Quotient.mk_surjective v.asIdeal,
        Ideal.mk_ker, sup_eq_left.mpr hIB_le_v]
    let w₀ : AlgebraicGeometry.Spec (CommRingCat.of A₂_B) :=
      ⟨Ideal.comap G q_B, Ideal.IsPrime.comap G⟩
    have hw₀_inl : ∀ i : Fin 2, x' i ∈ (q'_2.base w₀).asIdeal := by
      intro i
      change G (ψ'_2 (x' i)) ∈ q_B
      have h0 : G (ψ'_2 (x' i)) = 0 := by
        have happ : G (ψ'_2 (x' i)) = α (x' i) := RingHom.congr_fun hG_ψ'2 (x' i)
        rw [happ]
        simp [x', hα_mk, α_raw]
      rw [h0]
      exact q_B.zero_mem
    have hw₀_inr : t' c₀ ∈ (q'_2.base w₀).asIdeal := by
      change G (ψ'_2 (t' c₀)) ∈ q_B
      have h0 : G (ψ'_2 (t' c₀)) = 0 := by
        have happ : G (ψ'_2 (t' c₀)) = α (t' c₀) := RingHom.congr_fun hG_ψ'2 (t' c₀)
        rw [happ]
        have hval : α (t' c₀) =
            π_B (ψ_q (Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inr c₀)))) := by
          simp [t', hα_mk, α_raw]
        rw [hval, ← hg2]
        exact hπB_g 2
      rw [h0]
      exact q_B.zero_mem
    have hw₀_base : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_B)).base w₀ = v := by
      apply PrimeSpectrum.ext
      apply Ideal.ext
      intro (b₀ : B')
      change G (ι_B b₀) ∈ q_B ↔ b₀ ∈ v.asIdeal
      have hB : G (ι_B b₀) = π_B b₀ := RingHom.congr_fun hG_B b₀
      rw [hB, ← Ideal.mem_comap, hcomap_qB]
    
    let K₂ : Ideal A₂_B := Ideal.span {ψ'_2 (x' 0), ψ'_2 (x' 1), ψ'_2 (t' c₀)}
    let r_B2 : Fin 3 → Localization.Away (g 2) := fun j =>
      IsLocalization.mk' (Localization.Away (g 2)) (g j) ⟨g 2, Submonoid.mem_powers (g 2)⟩
    have hGen_K₂ : ∀ (j : Fin 3) (hj : r_B2 j ∈ Algebra.adjoin B' (Set.range r_B2)),
        Ideal.Quotient.mk K₂ ⟨r_B2 j, hj⟩ ∈ ((Ideal.Quotient.mk K₂).comp ι_B).range := by
      intro j
      fin_cases j
      · dsimp only
        intro hj
        have hgen0 : (⟨r_B2 0, hj⟩ : A₂_B) = ψ'_2 (x' 0) := by
          apply Subtype.ext
          have h1 := congrArg Subtype.val (hι2_gen 0)
          have h2 : φ_2_hom (x' 0) =
              ⟨IsLocalization.mk' (Localization.Away (m_gen 2)) (m_gen 0)
                ⟨m_gen 2, Submonoid.mem_powers (m_gen 2)⟩,
              Algebra.subset_adjoin ⟨0, rfl⟩⟩ := by
            rw [hφ2_app]
            exact hΦ2_inl 0
          change r_B2 0 = (ι_2 (φ_2_hom (x' 0))).1
          rw [h2]
          exact h1.symm
        change Ideal.Quotient.mk K₂ ⟨r_B2 0, hj⟩ ∈ _
        rw [hgen0, Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (by simp))]
        exact Subring.zero_mem _
      · dsimp only
        intro hj
        have hgen1 : (⟨r_B2 1, hj⟩ : A₂_B) = ψ'_2 (x' 1) := by
          apply Subtype.ext
          have h1 := congrArg Subtype.val (hι2_gen 1)
          have h2 : φ_2_hom (x' 1) =
              ⟨IsLocalization.mk' (Localization.Away (m_gen 2)) (m_gen 1)
                ⟨m_gen 2, Submonoid.mem_powers (m_gen 2)⟩,
              Algebra.subset_adjoin ⟨1, rfl⟩⟩ := by
            rw [hφ2_app]
            exact hΦ2_inl 1
          change r_B2 1 = (ι_2 (φ_2_hom (x' 1))).1
          rw [h2]
          exact h1.symm
        change Ideal.Quotient.mk K₂ ⟨r_B2 1, hj⟩ ∈ _
        rw [hgen1, Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (by simp))]
        exact Subring.zero_mem _
      · dsimp only
        intro hj
        have hgen2 : (⟨r_B2 2, hj⟩ : A₂_B) = 1 :=
          Subtype.ext (IsLocalization.mk'_self' (Localization.Away (g 2))
            (x := ⟨g 2, Submonoid.mem_powers (g 2)⟩))
        change Ideal.Quotient.mk K₂ ⟨r_B2 2, hj⟩ ∈ _
        rw [hgen2, map_one]
        exact Subring.one_mem _
    have hMod_K₂ : ∀ z : A₂_B, ∃ b₀ : B', z - ι_B b₀ ∈ K₂ := by
      rintro ⟨z, hz⟩
      suffices Ideal.Quotient.mk K₂ ⟨z, hz⟩ ∈ ((Ideal.Quotient.mk K₂).comp ι_B).range by
        rcases this with ⟨b₀, hb₀⟩
        refine ⟨b₀, ?_⟩
        rw [← Ideal.Quotient.eq]
        exact hb₀.symm
      refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hz
      · intro y hy
        rcases hy with ⟨j, rfl⟩
        exact hGen_K₂ j _
      · intro b₀
        exact ⟨b₀, rfl⟩
      · intro z₁ z₂ hz₁ hz₂ ih₁ ih₂
        change Ideal.Quotient.mk K₂ (⟨z₁, hz₁⟩ + ⟨z₂, hz₂⟩) ∈ _
        rw [map_add]
        exact Subring.add_mem _ ih₁ ih₂
      · intro z₁ z₂ hz₁ hz₂ ih₁ ih₂
        change Ideal.Quotient.mk K₂ (⟨z₁, hz₁⟩ * ⟨z₂, hz₂⟩) ∈ _
        rw [map_mul]
        exact Subring.mul_mem _ ih₁ ih₂
    have hw₀_K₂ : K₂ ≤ w₀.asIdeal := by
      rw [Ideal.span_le]
      rintro _ (rfl | rfl | rfl)
      · exact hw₀_inl 0
      · exact hw₀_inl 1
      · exact hw₀_inr
    refine ⟨w₀, ⟨hw₀_inl, hw₀_inr, hw₀_base⟩, ?_⟩
    rintro w ⟨hw_inl, hw_inr, hw_base⟩
    have hw_K₂ : K₂ ≤ w.asIdeal := by
      rw [Ideal.span_le]
      rintro _ (rfl | rfl | rfl)
      · exact hw_inl 0
      · exact hw_inl 1
      · exact hw_inr
    apply PrimeSpectrum.ext
    ext z
    rcases hMod_K₂ z with ⟨b₀, hb₀⟩
    have hz_w : z ∈ w.asIdeal ↔ ι_B b₀ ∈ w.asIdeal := by
      have hmem : z - ι_B b₀ ∈ w.asIdeal := hw_K₂ hb₀
      exact ⟨fun hz => by simpa using w.asIdeal.sub_mem hz hmem,
        fun hb => by simpa using w.asIdeal.add_mem hmem hb⟩
    have hz_w₀ : z ∈ w₀.asIdeal ↔ ι_B b₀ ∈ w₀.asIdeal := by
      have hmem : z - ι_B b₀ ∈ w₀.asIdeal := hw₀_K₂ hb₀
      exact ⟨fun hz => by simpa using w₀.asIdeal.sub_mem hz hmem,
        fun hb => by simpa using w₀.asIdeal.add_mem hmem hb⟩
    have hb_v : ι_B b₀ ∈ w.asIdeal ↔ b₀ ∈ v.asIdeal := by
      rw [← hw_base]; rfl
    have hb_v₀ : ι_B b₀ ∈ w₀.asIdeal ↔ b₀ ∈ v.asIdeal := by
      rw [← hw₀_base]; rfl
    rw [hz_w, hb_v, hz_w₀, hb_v₀]

  exact ⟨hConj1, hConj2, q'_2, hEt_q'2, hConj3_2, hConj3_3, hConj3_4, hConj3_5, hConj3_6⟩

theorem weil_toroidal_smooth_nc_chart_elimination (k : Type u) [Field k] (m : ℕ)
    (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (Z_Y : Set Y.left) (y : Y.left) :
    (∀ (R' : CommRingCat.{u}) (w₀ : AlgebraicGeometry.Spec R')
        (e_Y : AlgebraicGeometry.Spec R' ⟶ Y.left)
        (a' : Fin m → ℕ)
        (q : AlgebraicGeometry.Spec R' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
          (MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ Ideal.span
            {MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
              ∏ c : Fin m, MvPolynomial.X (Sum.inr c) ^ a' c}))),
      AlgebraicGeometry.Etale e_Y →
      AlgebraicGeometry.Etale q →
      e_Y.base w₀ = y →
      (q ≫ AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) = e_Y ≫ Y.hom) →
      (∃ b : Fin 2,
        Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl b)) ∉ (q.base w₀).asIdeal) →
      ∃ (R₁ : CommRingCat.{u}) (w₁ : AlgebraicGeometry.Spec R₁)
        (e₁ : AlgebraicGeometry.Spec R₁ ⟶ Y.left)
        (ψ₁ : MvPolynomial (Fin (m + 1)) k →+* R₁),
        AlgebraicGeometry.Etale e₁ ∧
        AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁)) ∧
        e₁.base w₁ = y ∧
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = e₁ ≫ Y.hom)) ∧
    (∀ (R' : CommRingCat.{u}) (w₀ : AlgebraicGeometry.Spec R')
        (e_Y : AlgebraicGeometry.Spec R' ⟶ Y.left)
        (ψ : MvPolynomial (Fin (m + 1)) k →+* R')
        (I_raw : Finset (Fin (m + 1))),
      AlgebraicGeometry.Etale e_Y →
      AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) →
      e_Y.base w₀ = y →
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = e_Y ≫ Y.hom) →
      e_Y.base ⁻¹' Z_Y =
        {w : AlgebraicGeometry.Spec R' | ∃ i ∈ I_raw, ψ (MvPolynomial.X i) ∈ w.asIdeal} →
      ∃ (R'' : CommRingCat.{u}) (w'₀ : AlgebraicGeometry.Spec R'')
        (e'_Y : AlgebraicGeometry.Spec R'' ⟶ Y.left)
        (ψ' : MvPolynomial (Fin (m + 1)) k →+* R'')
        (I : Finset (Fin (m + 1))),
        AlgebraicGeometry.Etale e'_Y ∧
        AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ')) ∧
        e'_Y.base w'₀ = y ∧
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ') ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = e'_Y ≫ Y.hom) ∧
        (∀ i ∈ I, ψ' (MvPolynomial.X i) ∈ w'₀.asIdeal) ∧
        e'_Y.base ⁻¹' Z_Y =
          {w : AlgebraicGeometry.Spec R'' | ∃ i ∈ I, ψ' (MvPolynomial.X i) ∈ w.asIdeal}) ∧
    (1 ≤ m →
      ∀ (R' : CommRingCat.{u}) (w₀ : AlgebraicGeometry.Spec R')
        (e_Y : AlgebraicGeometry.Spec R' ⟶ Y.left)
        (a' : Fin m → ℕ) (S_bdry : Finset (Fin m))
        (q : AlgebraicGeometry.Spec R' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
          (MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ Ideal.span
            {MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
              ∏ c : Fin m, MvPolynomial.X (Sum.inr c) ^ a' c}))),
        AlgebraicGeometry.Etale e_Y →
        AlgebraicGeometry.Etale q →
        e_Y.base w₀ = y →
        (q ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) = e_Y ≫ Y.hom) →
        (∀ c : Fin m, 1 ≤ a' c → c ∈ S_bdry) →
        (∀ c ∈ S_bdry,
          Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c)) ∈ (q.base w₀).asIdeal) →
        e_Y.base ⁻¹' Z_Y =
          {w : AlgebraicGeometry.Spec R' |
            ∃ c ∈ S_bdry,
              Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c)) ∈ (q.base w).asIdeal} →
        ¬ ((∀ b : Fin 2,
            Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl b)) ∈ (q.base w₀).asIdeal) ∧
          2 ≤ ∑ c : Fin m, a' c) →
        ∃ (R'' : CommRingCat.{u}) (w'₀ : AlgebraicGeometry.Spec R'')
          (e'_Y : AlgebraicGeometry.Spec R'' ⟶ Y.left)
          (ψ' : MvPolynomial (Fin (m + 1)) k →+* R'')
          (I : Finset (Fin (m + 1))),
          AlgebraicGeometry.Etale e'_Y ∧
          AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ')) ∧
          e'_Y.base w'₀ = y ∧
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ') ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = e'_Y ≫ Y.hom) ∧
          (∀ i ∈ I, ψ' (MvPolynomial.X i) ∈ w'₀.asIdeal) ∧
          e'_Y.base ⁻¹' Z_Y =
            {w : AlgebraicGeometry.Spec R'' | ∃ i ∈ I, ψ' (MvPolynomial.X i) ∈ w.asIdeal}) :=
by
  
  have hAwayElim : ∀ (a' : Fin m → ℕ) (b : Fin 2)
      (I_F : Ideal (MvPolynomial (Fin 2 ⊕ Fin m) k)),
      I_F = Ideal.span {MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
        ∏ c : Fin m, MvPolynomial.X (Sum.inr c) ^ a' c} →
      ∃ (ψ₀ : MvPolynomial (Fin (m + 1)) k →+*
          Localization.Away (Ideal.Quotient.mk I_F (MvPolynomial.X (Sum.inl b)))),
        ψ₀.Etale ∧
        ψ₀.comp MvPolynomial.C =
          (algebraMap (MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ I_F)
            (Localization.Away (Ideal.Quotient.mk I_F (MvPolynomial.X (Sum.inl b))))).comp
            ((Ideal.Quotient.mk I_F).comp MvPolynomial.C) ∧
        (∀ c : Fin m,
          ψ₀ (MvPolynomial.X (Fin.succ c)) =
            algebraMap (MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ I_F)
              (Localization.Away (Ideal.Quotient.mk I_F (MvPolynomial.X (Sum.inl b))))
              (Ideal.Quotient.mk I_F (MvPolynomial.X (Sum.inr c)))) := by
    intro a' b I_F hI_F
    let F_poly : MvPolynomial (Fin 2 ⊕ Fin m) k :=
      MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
        ∏ c : Fin m, MvPolynomial.X (Sum.inr c) ^ a' c
    let M := MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ I_F
    let π_M : MvPolynomial (Fin 2 ⊕ Fin m) k →+* M := Ideal.Quotient.mk I_F
    let u_b : M := π_M (MvPolynomial.X (Sum.inl b))
    let L₁ := Localization.Away (MvPolynomial.X 0 : MvPolynomial (Fin (m + 1)) k)
    let L_M := Localization.Away u_b
    let α₁ : MvPolynomial (Fin (m + 1)) k →+* L₁ :=
      algebraMap (MvPolynomial (Fin (m + 1)) k) L₁
    let α_M : M →+* L_M := algebraMap M L_M
    let c_LM : k →+* L_M := α_M.comp (π_M.comp MvPolynomial.C)
    let ψ₀ : MvPolynomial (Fin (m + 1)) k →+* L_M :=
      MvPolynomial.eval₂Hom c_LM
        (Fin.cases (α_M u_b) (fun c => α_M (π_M (MvPolynomial.X (Sum.inr c)))))
    have hψ₀_C : ψ₀.comp MvPolynomial.C = c_LM := by
      apply RingHom.ext
      intro r
      exact MvPolynomial.eval₂Hom_C _ _ r
    have hψ₀_0 : ψ₀ (MvPolynomial.X 0) = α_M u_b := by
      change MvPolynomial.eval₂Hom c_LM _ (MvPolynomial.X 0) = _
      rw [MvPolynomial.eval₂Hom_X', Fin.cases_zero]
    have hψ₀_succ : ∀ c : Fin m,
        ψ₀ (MvPolynomial.X (Fin.succ c)) = α_M (π_M (MvPolynomial.X (Sum.inr c))) := by
      intro c
      change MvPolynomial.eval₂Hom c_LM _ (MvPolynomial.X (Fin.succ c)) = _
      rw [MvPolynomial.eval₂Hom_X', Fin.cases_succ]
    have hu_unit : IsUnit (ψ₀ (MvPolynomial.X 0)) := by
      rw [hψ₀_0]
      exact IsLocalization.Away.algebraMap_isUnit u_b
    let vec_phi : L₁ →+* L_M :=
      IsLocalization.Away.lift (MvPolynomial.X 0 : MvPolynomial (Fin (m + 1)) k) hu_unit
    have hvec_eq : ∀ p : MvPolynomial (Fin (m + 1)) k, vec_phi (α₁ p) = ψ₀ p :=
      fun p => IsLocalization.Away.lift_eq
        (MvPolynomial.X 0 : MvPolynomial (Fin (m + 1)) k) hu_unit p
    let y₀ : L₁ := α₁ (MvPolynomial.X 0)
    let y₀_inv : L₁ :=
      IsLocalization.Away.invSelf (S := L₁) (MvPolynomial.X 0 : MvPolynomial (Fin (m + 1)) k)
    have hy₀_mul : y₀ * y₀_inv = 1 :=
      IsLocalization.Away.mul_invSelf (S := L₁) (MvPolynomial.X 0 : MvPolynomial (Fin (m + 1)) k)
    let P_rhs : L₁ := ∏ c : Fin m, α₁ (MvPolynomial.X (Fin.succ c)) ^ a' c
    let c_L₁ : k →+* L₁ := α₁.comp MvPolynomial.C
    let g_tilde : MvPolynomial (Fin 2 ⊕ Fin m) k →+* L₁ :=
      MvPolynomial.eval₂Hom c_L₁
        (Sum.elim (fun j : Fin 2 => if j = b then y₀ else y₀_inv * P_rhs)
          (fun c : Fin m => α₁ (MvPolynomial.X (Fin.succ c))))
    have hg_inl : ∀ j : Fin 2,
        g_tilde (MvPolynomial.X (Sum.inl j)) = if j = b then y₀ else y₀_inv * P_rhs := by
      intro j
      change MvPolynomial.eval₂Hom c_L₁ _ (MvPolynomial.X (Sum.inl j)) = _
      rw [MvPolynomial.eval₂Hom_X', Sum.elim_inl]
    have hg_inr : ∀ c : Fin m,
        g_tilde (MvPolynomial.X (Sum.inr c)) = α₁ (MvPolynomial.X (Fin.succ c)) := by
      intro c
      change MvPolynomial.eval₂Hom c_L₁ _ (MvPolynomial.X (Sum.inr c)) = _
      rw [MvPolynomial.eval₂Hom_X', Sum.elim_inr]
    have hg_C : ∀ r : k, g_tilde (MvPolynomial.C r) = c_L₁ r :=
      fun r => MvPolynomial.eval₂Hom_C _ _ r
    have hg_F : g_tilde F_poly = 0 := by
      have hProd : g_tilde (∏ c : Fin m,
          (MvPolynomial.X (Sum.inr c) : MvPolynomial (Fin 2 ⊕ Fin m) k) ^ a' c) = P_rhs := by
        rw [map_prod]
        refine Finset.prod_congr rfl fun c _ => ?_
        rw [map_pow, hg_inr c]
      change g_tilde (MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
        ∏ c : Fin m, MvPolynomial.X (Sum.inr c) ^ a' c) = 0
      rw [map_sub, map_mul, hProd, hg_inl 0, hg_inl 1]
      have hb_cases : b = 0 ∨ b = 1 := by fin_cases b <;> simp
      rcases hb_cases with rfl | rfl
      · rw [if_pos rfl, if_neg (by decide : (1 : Fin 2) ≠ 0), ← mul_assoc, hy₀_mul, one_mul, sub_self]
      · have hmul : (y₀_inv * P_rhs) * y₀ = (y₀ * y₀_inv) * P_rhs := by ring
        rw [if_neg (by decide : (0 : Fin 2) ≠ 1), if_pos rfl, hmul, hy₀_mul, one_mul, sub_self]
    have hg_ker : ∀ z ∈ I_F, g_tilde z = 0 := by
      intro z hz
      rw [hI_F] at hz
      obtain ⟨q_poly, rfl⟩ := Ideal.mem_span_singleton'.mp hz
      rw [map_mul, hg_F, mul_zero]
    let g_bar : M →+* L₁ := Ideal.Quotient.lift I_F g_tilde hg_ker
    have hgbar_ub : g_bar u_b = α₁ (MvPolynomial.X 0) := by
      change g_tilde (MvPolynomial.X (Sum.inl b)) = α₁ (MvPolynomial.X 0)
      rw [hg_inl b, if_pos rfl]
    have hy₀_unit : IsUnit (g_bar u_b) := by
      rw [hgbar_ub]
      exact IsLocalization.Away.algebraMap_isUnit (MvPolynomial.X 0 : MvPolynomial (Fin (m + 1)) k)
    let back_phi : L_M →+* L₁ := IsLocalization.Away.lift u_b hy₀_unit
    have hback_eq : ∀ z : M, back_phi (α_M z) = g_bar z :=
      fun z => IsLocalization.Away.lift_eq u_b hy₀_unit z
    have h_left : back_phi.comp vec_phi = RingHom.id L₁ := by
      apply IsLocalization.ringHom_ext
        (Submonoid.powers (MvPolynomial.X 0 : MvPolynomial (Fin (m + 1)) k))
      have h_comp : (back_phi.comp vec_phi).comp α₁ = back_phi.comp ψ₀ :=
        RingHom.ext fun p => congrArg back_phi (hvec_eq p)
      rw [h_comp, RingHom.id_comp]
      apply MvPolynomial.ringHom_ext'
      · apply RingHom.ext
        intro r
        change back_phi (ψ₀ (MvPolynomial.C r)) = α₁ (MvPolynomial.C r)
        have h1 : ψ₀ (MvPolynomial.C r) = α_M (π_M (MvPolynomial.C r)) :=
          RingHom.congr_fun hψ₀_C r
        rw [h1, hback_eq]
        exact hg_C r
      · intro i
        cases i using Fin.cases with
        | zero =>
          change back_phi (ψ₀ (MvPolynomial.X 0)) = α₁ (MvPolynomial.X 0)
          rw [hψ₀_0, hback_eq, hgbar_ub]
        | succ c =>
          change back_phi (ψ₀ (MvPolynomial.X (Fin.succ c))) = α₁ (MvPolynomial.X (Fin.succ c))
          rw [hψ₀_succ c, hback_eq]
          exact hg_inr c
    have hM_rel : π_M (MvPolynomial.X (Sum.inl 0)) * π_M (MvPolynomial.X (Sum.inl 1)) =
        ∏ c : Fin m, π_M (MvPolynomial.X (Sum.inr c)) ^ a' c := by
      have h0 : π_M F_poly = 0 := by
        refine Ideal.Quotient.eq_zero_iff_mem.mpr ?_
        rw [hI_F]
        exact Ideal.subset_span rfl
      change π_M (MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
        ∏ c : Fin m, MvPolynomial.X (Sum.inr c) ^ a' c) = 0 at h0
      rw [map_sub, map_mul, map_prod] at h0
      simpa only [map_pow] using sub_eq_zero.mp h0
    have h_right : vec_phi.comp back_phi = RingHom.id L_M := by
      apply IsLocalization.ringHom_ext (Submonoid.powers u_b)
      have h_comp : (vec_phi.comp back_phi).comp α_M = vec_phi.comp g_bar :=
        RingHom.ext fun z => congrArg vec_phi (hback_eq z)
      rw [h_comp, RingHom.id_comp]
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext'
      · apply RingHom.ext
        intro r
        change vec_phi (g_tilde (MvPolynomial.C r)) = α_M (π_M (MvPolynomial.C r))
        rw [hg_C r]
        change vec_phi (α₁ (MvPolynomial.C r)) = _
        rw [hvec_eq]
        exact RingHom.congr_fun hψ₀_C r
      · rintro (j | c)
        · change vec_phi (g_tilde (MvPolynomial.X (Sum.inl j))) =
            α_M (π_M (MvPolynomial.X (Sum.inl j)))
          rw [hg_inl j]
          by_cases hjb : j = b
          · subst hjb
            rw [if_pos rfl]
            change vec_phi (α₁ (MvPolynomial.X 0)) = α_M u_b
            rw [hvec_eq, hψ₀_0]
          · rw [if_neg hjb]
            have hub_unit' : IsUnit (α_M u_b) := IsLocalization.Away.algebraMap_isUnit u_b
            apply hub_unit'.mul_left_cancel
            have hlhs : α_M u_b * vec_phi (y₀_inv * P_rhs) = vec_phi P_rhs := by
              have hvy₀ : vec_phi y₀ = α_M u_b := by
                change vec_phi (α₁ (MvPolynomial.X 0)) = α_M u_b
                rw [hvec_eq, hψ₀_0]
              calc
                α_M u_b * vec_phi (y₀_inv * P_rhs)
                  = vec_phi y₀ * vec_phi (y₀_inv * P_rhs) := by rw [hvy₀]
                _ = vec_phi (y₀ * (y₀_inv * P_rhs)) := (map_mul vec_phi _ _).symm
                _ = vec_phi ((y₀ * y₀_inv) * P_rhs) := by rw [← mul_assoc]
                _ = vec_phi P_rhs := by rw [hy₀_mul, one_mul]
            have hrhs : vec_phi P_rhs = α_M u_b * α_M (π_M (MvPolynomial.X (Sum.inl j))) := by
              have h1 : vec_phi P_rhs =
                  ∏ c : Fin m, α_M (π_M (MvPolynomial.X (Sum.inr c))) ^ a' c := by
                change vec_phi (∏ c : Fin m, α₁ (MvPolynomial.X (Fin.succ c)) ^ a' c) = _
                rw [map_prod]
                refine Finset.prod_congr rfl fun c _ => ?_
                rw [map_pow, hvec_eq, hψ₀_succ c]
              rw [h1, ← map_mul]
              have hprod_M : (∏ c : Fin m, α_M (π_M (MvPolynomial.X (Sum.inr c))) ^ a' c) =
                  α_M (∏ c : Fin m, π_M (MvPolynomial.X (Sum.inr c)) ^ a' c) := by
                rw [map_prod]
                refine Finset.prod_congr rfl fun c _ => (map_pow _ _ _).symm
              rw [hprod_M]
              congr 1
              fin_cases b <;> fin_cases j
              · exact (hjb rfl).elim
              · exact hM_rel.symm
              · rw [mul_comm]
                exact hM_rel.symm
              · exact (hjb rfl).elim
            exact hlhs.trans hrhs
        · change vec_phi (g_tilde (MvPolynomial.X (Sum.inr c))) =
            α_M (π_M (MvPolynomial.X (Sum.inr c)))
          rw [hg_inr c, hvec_eq, hψ₀_succ c]
    letI : Algebra (MvPolynomial (Fin (m + 1)) k) L_M := ψ₀.toAlgebra
    let Φ : L₁ ≃ₐ[MvPolynomial (Fin (m + 1)) k] L_M :=
      { toFun := vec_phi
        invFun := back_phi
        left_inv := fun z => RingHom.congr_fun h_left z
        right_inv := fun z => RingHom.congr_fun h_right z
        map_mul' := vec_phi.map_mul
        map_add' := vec_phi.map_add
        commutes' := fun p => hvec_eq p }
    have hEt_L₁ : Algebra.Etale (MvPolynomial (Fin (m + 1)) k) L₁ :=
      Algebra.Etale.of_isLocalizationAway (MvPolynomial.X 0 : MvPolynomial (Fin (m + 1)) k)
    have hEt_LM : Algebra.Etale (MvPolynomial (Fin (m + 1)) k) L_M :=
      Algebra.Etale.of_equiv Φ
    have hEt_ψ₀ : ψ₀.Etale :=
      (RingHom.etale_algebraMap (R := MvPolynomial (Fin (m + 1)) k) (S := L_M)).mpr hEt_LM
    exact ⟨ψ₀, hEt_ψ₀, hψ₀_C, hψ₀_succ⟩

  
  have hRoofLift : ∀ (A : Type u) [CommRing A] (α : k →+* A)
      (R' : CommRingCat.{u}) (w₀ : AlgebraicGeometry.Spec R')
      (e_Y : AlgebraicGeometry.Spec R' ⟶ Y.left)
      (q : AlgebraicGeometry.Spec R' ⟶ AlgebraicGeometry.Spec (CommRingCat.of A)),
      AlgebraicGeometry.Etale e_Y →
      AlgebraicGeometry.Etale q →
      e_Y.base w₀ = y →
      (q ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom α) = e_Y ≫ Y.hom) →
      ∀ (u : A) (ψ₀ : MvPolynomial (Fin (m + 1)) k →+* Localization.Away u),
        u ∉ (q.base w₀).asIdeal →
        ψ₀.Etale →
        ψ₀.comp MvPolynomial.C = (algebraMap A (Localization.Away u)).comp α →
        ∃ (R₁ : CommRingCat.{u}) (w₁ : AlgebraicGeometry.Spec R₁)
          (e₁ : AlgebraicGeometry.Spec R₁ ⟶ Y.left)
          (ι₁ : AlgebraicGeometry.Spec R₁ ⟶ AlgebraicGeometry.Spec R')
          (ψ₁ : MvPolynomial (Fin (m + 1)) k →+* R₁),
          AlgebraicGeometry.Etale e₁ ∧
          AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁)) ∧
          e₁ = ι₁ ≫ e_Y ∧
          ι₁.base w₁ = w₀ ∧
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = e₁ ≫ Y.hom) ∧
          (∀ (x : MvPolynomial (Fin (m + 1)) k) (a : A),
            ψ₀ x = algebraMap A (Localization.Away u) a →
            ∀ w : AlgebraicGeometry.Spec R₁,
              ψ₁ x ∈ w.asIdeal ↔ a ∈ (q.base (ι₁.base w)).asIdeal) := by
    intro A _ α R' w₀ e_Y q hEt_e hEt_q _hw₀ hComm u ψ₀ hu hEt_ψ₀ hC_ψ₀
    have : AlgebraicGeometry.Etale e_Y := hEt_e
    have : AlgebraicGeometry.Etale q := hEt_q
    let φ_q : CommRingCat.of A ⟶ R' := AlgebraicGeometry.Spec.preimage q
    have hφ_q : AlgebraicGeometry.Spec.map φ_q = q := AlgebraicGeometry.Spec.map_preimage q
    have hq_mem : ∀ (v : AlgebraicGeometry.Spec R') (a : A),
        a ∈ (q.base v).asIdeal ↔ φ_q.hom a ∈ v.asIdeal := by
      intro v a
      rw [← hφ_q]
      rfl
    let s : R' := φ_q.hom u
    have hs_notMem : s ∉ w₀.asIdeal := by
      rwa [← hq_mem w₀ u]
    let R₁_ring : Type u := Localization.Away s
    let R₁ : CommRingCat.{u} := CommRingCat.of R₁_ring
    let ι₁ : AlgebraicGeometry.Spec R₁ ⟶ AlgebraicGeometry.Spec R' :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R' R₁_ring))
    have : AlgebraicGeometry.IsOpenImmersion ι₁ :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization s
    let e₁ : AlgebraicGeometry.Spec R₁ ⟶ Y.left := ι₁ ≫ e_Y
    have hEt_e₁ : AlgebraicGeometry.Etale e₁ := inferInstance
    have hw₀_range : (w₀ : PrimeSpectrum R') ∈
        Set.range (PrimeSpectrum.comap (algebraMap R' R₁_ring)) := by
      rw [PrimeSpectrum.localization_away_comap_range R₁_ring s]
      exact hs_notMem
    obtain ⟨w₁, hw₁_base⟩ := hw₀_range
    let g_A : A →+* R₁_ring := (algebraMap R' R₁_ring).comp φ_q.hom
    have hs_unit : IsUnit (g_A u) := by
      change IsUnit (algebraMap R' R₁_ring s)
      exact IsLocalization.Away.algebraMap_isUnit s
    let φ_tilde : Localization.Away u →+* R₁_ring := IsLocalization.Away.lift u hs_unit
    have hφ_tilde_eq : ∀ a : A, φ_tilde (algebraMap A (Localization.Away u) a) = g_A a :=
      fun a => IsLocalization.Away.lift_eq u hs_unit a
    let j_u : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away u)) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of A) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A (Localization.Away u)))
    have : AlgebraicGeometry.IsOpenImmersion j_u :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization u
    have hComp_j : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_tilde) ≫ j_u = ι₁ ≫ q := by
      have h1 : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_tilde) ≫ j_u =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom g_A) := by
        dsimp [j_u]
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        congr 2
        ext a
        exact hφ_tilde_eq a
