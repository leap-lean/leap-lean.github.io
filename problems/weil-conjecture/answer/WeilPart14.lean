          have ha₂_loc : algebraMap (↑R'₀) (Localization.Away u) a₂ = 0 :=
            (IsLocalization.map_eq_zero_iff (Submonoid.powers u) (Localization.Away u) a₂).mpr
              ⟨⟨u ^ r, r, rfl⟩, hur⟩
          have hUnit₂ : IsUnit (algebraMap (↑R'₀) (Localization.Away u) ↑s₂) :=
            IsLocalization.map_units (Localization.Away u) s₂
          exact hUnit₂.mul_left_eq_zero.mp (h₂.trans ha₂_loc)
      exact NoZeroDivisors.to_isDomain (Localization.Away u)
    let locHom : ↑R'₀ →+* ↑R' := algebraMap (↑R'₀) (Localization.Away u)
    let locMap : AlgebraicGeometry.Spec R' ⟶ AlgebraicGeometry.Spec R'₀ :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom locHom)
    have hOpen_loc : AlgebraicGeometry.IsOpenImmersion locMap :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization (S := Localization.Away u) u
    have hEt_loc : AlgebraicGeometry.Etale locMap := inferInstance
    have hv₀_range : (v₀ : PrimeSpectrum ↑R'₀) ∈
        Set.range (PrimeSpectrum.comap (algebraMap (↑R'₀) (Localization.Away u))) := by
      rw [PrimeSpectrum.localization_away_comap_range (Localization.Away u) u]
      exact hu
    obtain ⟨v'_raw, hv'⟩ := hv₀_range
    let v' : AlgebraicGeometry.Spec R' := v'_raw
    have hv'_base : locMap.base v' = v₀ := hv'
    let e_S : AlgebraicGeometry.Spec R' ⟶ S'.left := locMap ≫ e₀
    let ψ : MvPolynomial (Fin (m + 1)) k →+* ↑R' := locHom.comp ψ₀
    have hEt_eS : AlgebraicGeometry.Etale e_S := inferInstance
    have hSpec_ψ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) =
        locMap ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀) := by
      dsimp [ψ, locMap]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    have hEt_ψ : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) := by
      rw [hSpec_ψ]
      infer_instance
    have hv'_x : e_S.base v' = x := by
      change e₀.base (locMap.base v') = x
      rw [hv'_base, hv₀]
    have hComm : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = e_S ≫ S'.hom := by
      rw [hSpec_ψ, CategoryTheory.Category.assoc, hComm₀]
      rfl
    have hVan_α : ∀ a : {a : Fin q // x ∈ Set.range (ιH a).base},
        ψ (MvPolynomial.X (α_snc a)) ∈ v'.asIdeal := by
      intro a
      change ψ₀ (MvPolynomial.X (α_snc a)) ∈
        (PrimeSpectrum.comap (algebraMap (↑R'₀) (Localization.Away u)) v'_raw).asIdeal
      rw [hv']
      exact hVan_α₀ a
    have hVan_I : ∀ j ∈ I_nc, ψ (MvPolynomial.X j) ∈ v'.asIdeal := by
      intro j hj
      change ψ₀ (MvPolynomial.X j) ∈
        (PrimeSpectrum.comap (algebraMap (↑R'₀) (Localization.Away u)) v'_raw).asIdeal
      rw [hv']
      exact hVan_I₀ j hj
    have hPreH_out : ∀ a : Fin q, x ∉ Set.range (ιH a).base →
        e_S.base ⁻¹' Set.range (ιH a).base = ∅ := by
      intro a hax
      change locMap.base ⁻¹' (e₀.base ⁻¹' Set.range (ιH a).base) = ∅
      rw [hPreH_out₀ a hax, Set.preimage_empty]
    have hPreH_in : ∀ a : Fin q, ∀ hax : x ∈ Set.range (ιH a).base,
        e_S.base ⁻¹' Set.range (ιH a).base =
          {v : AlgebraicGeometry.Spec R' | ψ (MvPolynomial.X (α_snc ⟨a, hax⟩)) ∈ v.asIdeal} := by
      intro a hax
      change locMap.base ⁻¹' (e₀.base ⁻¹' Set.range (ιH a).base) = _
      rw [hPreH_in₀ a hax]
      ext w
      rfl
    have hPreZ : e_S.base ⁻¹' Z_nc =
        {v : AlgebraicGeometry.Spec R' | ∃ j ∈ I_nc, ψ (MvPolynomial.X j) ∈ v.asIdeal} := by
      change locMap.base ⁻¹' (e₀.base ⁻¹' Z_nc) = _
      rw [hPreZ₀]
      ext w
      rfl
    have hPreC_out : ∀ β : Fin s, x ∉ Set.range (ιC β).base →
        e_S.base ⁻¹' Set.range (ιC β).base = ∅ := by
      intro β hxβ
      ext w
      simp only [Set.mem_preimage, Set.mem_empty_iff_false, iff_false]
      intro hw
      have hw_range : (locMap.base w : PrimeSpectrum ↑R'₀) ∈
          Set.range (PrimeSpectrum.comap (algebraMap (↑R'₀) (Localization.Away u))) :=
        ⟨w, rfl⟩
      rw [PrimeSpectrum.localization_away_comap_range (Localization.Away u) u] at hw_range
      have hw_u₂ : (locMap.base w : PrimeSpectrum ↑R'₀) ∈ PrimeSpectrum.basicOpen u₂ := by
        have hw_mul : (locMap.base w : PrimeSpectrum ↑R'₀) ∈ PrimeSpectrum.basicOpen (u₁ * u₂) :=
          hw_range
        rw [PrimeSpectrum.basicOpen_mul] at hw_mul
        exact hw_mul.2
      have hw_not_F : e₀.base (locMap.base w) ∉ F_away := hSub_u₂ hw_u₂
      apply hw_not_F
      exact Set.mem_iUnion.mpr ⟨⟨β, hxβ⟩, hw⟩
    have hCh₀ : IsChartAt x R'₀ v₀ e₀ ψ₀ I_nc :=
      ⟨hEt_e₀, hEt_ψ₀, hv₀, hComm₀, hVan_I₀, hPreZ₀⟩
    refine ⟨R', hDom_R', v', e_S, ψ, α_snc, I_nc,
      hEt_eS, hEt_ψ, hv'_x, hComm, hInj_α, hDisj_α,
      hVan_α, hVan_I, hPreH_out, hPreH_in, hPreZ, hPreC_out, ?_⟩
    by_cases hxC : x ∈ C
    · right
      have hCard_eq : I_nc.card = b + 2 := (hMemC_iff hCh₀).mp hxC
      have hxUnion : x ∈ ⋃ β : Fin s, Set.range (ιC β).base := hUnion_ιC.symm ▸ hxC
      obtain ⟨β₀, hxβ₀⟩ := Set.mem_iUnion.mp hxUnion
      refine ⟨β₀, hxβ₀, hCard_eq, ?_⟩
      have hPreC_all : e_S.base ⁻¹' C =
          {v : AlgebraicGeometry.Spec R' | ∀ j ∈ I_nc, ψ (MvPolynomial.X j) ∈ v.asIdeal} :=
        hChartPreC_eq hEt_eS hEt_ψ hComm hPreZ hCard_eq
      rw [← hPreC_all, ← hUnion_ιC, Set.preimage_iUnion]
      ext w
      simp only [Set.mem_iUnion]
      constructor
      · intro hw
        exact ⟨β₀, hw⟩
      · rintro ⟨β₁, hw₁⟩
        by_cases hβ : β₁ = β₀
        · rwa [← hβ]
        · have hx_not_β₁ : x ∉ Set.range (ιC β₁).base :=
            Set.disjoint_left.mp (hDisj_ιC (Ne.symm hβ)) hxβ₀
          have : w ∈ (∅ : Set (AlgebraicGeometry.Spec R')) := by
            rw [← hPreC_out β₁ hx_not_β₁]
            exact hw₁
          exact False.elim this
    · left
      have hNe : I_nc.card ≠ b + 2 := fun hEq => hxC ((hMemC_iff hCh₀).mpr hEq)
      exact ⟨by rwa [hUnion_ιC], by omega⟩

theorem weil_smooth_center_proj_cocycle_generators (k : Type u) [Field k]
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (C : Set X.left)
    (hProjX : IsProjectiveOverField k X)
    (hClosedC : IsClosed C)
    (hProperC : C ≠ Set.univ) :
    TopologicalSpace.NoetherianSpace ↥X.left ∧
    ∃ (M L : ℕ) (W_cov : Fin (M + 1) → X.left.affineOpens)
      (h : ∀ ν : Fin (M + 1), Fin (L + 1) → ↑(X.left.presheaf.obj (Opposite.op (W_cov ν).1))),
      (⨆ ν : Fin (M + 1), (W_cov ν).1) = ⊤ ∧
      (∀ ν : Fin (M + 1),
        (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal ⟨C, hClosedC⟩).ideal (W_cov ν) =
          Ideal.span (Set.range (h ν))) ∧
      (∀ ν μ : Fin (M + 1),
        AlgebraicGeometry.IsAffineOpen ((W_cov ν).1 ⊓ (W_cov μ).1) ∧
        ∃ u : ↑(X.left.presheaf.obj (Opposite.op ((W_cov ν).1 ⊓ (W_cov μ).1))),
          IsUnit u ∧
          ∀ a : Fin (L + 1),
            (X.left.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (h ν a) =
              u * (X.left.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom (h μ a)) :=
by
  let _ := hProperC
  obtain ⟨M, ι_X, hCl⟩ := hProjX
  have _ : AlgebraicGeometry.IsClosedImmersion ι_X.left := hCl
  let A := MvPolynomial (Fin (M + 1)) k
  let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k
  let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
  let ι : X.left ⟶ AlgebraicGeometry.Proj 𝒜 := ι_X.left
  have _ : AlgebraicGeometry.IsClosedImmersion ι := hCl
  
  have _ : IsScalarTower k (↥(𝒜 0)) A := ⟨fun c x p => smul_mul_assoc c (x : A) p⟩
  have _ : Algebra.FiniteType (↥(𝒜 0)) A :=
    Algebra.FiniteType.of_restrictScalars_finiteType k (↥(𝒜 0)) A
  have hSurj0 : Function.Surjective (algebraMap k ↥(𝒜 0)) := by
    intro x
    have hx : (x : A) ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k 0 := x.2
    rw [MvPolynomial.homogeneousSubmodule_zero, Submodule.mem_one] at hx
    rcases hx with ⟨c, hc⟩
    refine ⟨c, Subtype.ext ?_⟩
    rw [Algebra.algebraMap_eq_smul_one, Submodule.coe_smul_of_tower]
    rw [Algebra.algebraMap_eq_smul_one] at hc
    exact hc
  have _ : IsNoetherianRing ↥(𝒜 0) :=
    isNoetherianRing_of_surjective k (↥(𝒜 0)) (algebraMap k ↥(𝒜 0)) hSurj0
  have _ : AlgebraicGeometry.IsLocallyNoetherian (AlgebraicGeometry.Proj 𝒜) :=
    AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian (AlgebraicGeometry.Proj.toSpecZero 𝒜)
  have hX_mem : ∀ ν : Fin (M + 1), (MvPolynomial.X ν : A) ∈ 𝒜 1 :=
    fun ν => (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X k ν)
  let V_cov : Fin (M + 1) → (AlgebraicGeometry.Proj 𝒜).affineOpens := fun ν =>
    ⟨AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X ν),
     AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜 (MvPolynomial.X ν) (hX_mem ν) Nat.zero_lt_one⟩
  have hAdjoin : Algebra.adjoin (↥(𝒜 0)) (Set.range (MvPolynomial.X : Fin (M + 1) → A)) = ⊤ := by
    rw [eq_top_iff]
    intro p _
    have htop : p ∈ (⊤ : Subalgebra k A) := Algebra.mem_top
    rw [← MvPolynomial.adjoin_range_X] at htop
    have hle : Algebra.adjoin k (Set.range (MvPolynomial.X : Fin (M + 1) → A)) ≤
        (Algebra.adjoin (↥(𝒜 0)) (Set.range (MvPolynomial.X : Fin (M + 1) → A))).restrictScalars k :=
      Algebra.adjoin_le (fun _ hx => Algebra.subset_adjoin hx)
    exact hle htop
  have hCovV : (⨆ ν : Fin (M + 1), (V_cov ν).1) = ⊤ :=
    AlgebraicGeometry.Proj.iSup_basicOpen_eq_top' 𝒜 MvPolynomial.X (fun ν => ⟨1, hX_mem ν⟩) hAdjoin
  have _ : CompactSpace ↥(AlgebraicGeometry.Proj 𝒜) := by
    refine ⟨?_⟩
    have hUniv : (⋃ ν : Fin (M + 1), ((V_cov ν).1 : Set ↥(AlgebraicGeometry.Proj 𝒜))) = Set.univ := by
      have h1 := congrArg (fun U : (AlgebraicGeometry.Proj 𝒜).Opens => (U : Set ↥(AlgebraicGeometry.Proj 𝒜))) hCovV
      simpa [TopologicalSpace.Opens.coe_iSup] using h1
    rw [← hUniv]
    exact isCompact_iUnion (fun ν => (V_cov ν).2.isCompact)
  have _ : AlgebraicGeometry.IsNoetherian (AlgebraicGeometry.Proj 𝒜) := {}
  have _ : TopologicalSpace.NoetherianSpace ↥(AlgebraicGeometry.Proj 𝒜) := inferInstance
  have hNoethX : TopologicalSpace.NoetherianSpace ↥X.left :=
    ι.isClosedEmbedding.toIsEmbedding.toIsInducing.noetherianSpace
  
  have h_mem_deg : ∀ {d : ℕ} {F : A}, F.IsHomogeneous d → F ∈ 𝒜 (d • 1) := by
    intro d F hF
    rw [nsmul_one]
    exact (MvPolynomial.mem_homogeneousSubmodule d F).mpr hF
  let dehom : ∀ (ν : Fin (M + 1)) (d : ℕ) (F : A),
      F.IsHomogeneous d → ↑((AlgebraicGeometry.Proj 𝒜).presheaf.obj (Opposite.op (V_cov ν).1)) :=
    fun ν d F hF =>
      (AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X ν)).hom
        (HomogeneousLocalization.Away.mk 𝒜 (hX_mem ν) d F (h_mem_deg hF))
  have dehom_congr : ∀ (ν : Fin (M + 1)) {d₁ d₂ : ℕ} {F₁ F₂ : A}
      (hd : d₁ = d₂) (hF : F₁ = F₂) (h₁ : F₁.IsHomogeneous d₁) (h₂ : F₂.IsHomogeneous d₂),
      dehom ν d₁ F₁ h₁ = dehom ν d₂ F₂ h₂ := by
    intro ν d₁ d₂ F₁ F₂ hd hF h₁ h₂
    subst hd
    subst hF
    rfl
  have dehom_surj : ∀ (ν : Fin (M + 1))
      (s : ↑((AlgebraicGeometry.Proj 𝒜).presheaf.obj (Opposite.op (V_cov ν).1))),
      ∃ (d : ℕ) (F : A) (hF : F.IsHomogeneous d), dehom ν d F hF = s := by
    intro ν s
    let iso := AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜 (MvPolynomial.X ν) (hX_mem ν) Nat.zero_lt_one
    obtain ⟨d, F, hF', hmk⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜 (hX_mem ν) (iso.inv.hom s)
    have hF : F.IsHomogeneous d := by
      rw [nsmul_one] at hF'
      exact (MvPolynomial.mem_homogeneousSubmodule d F).mp hF'
    refine ⟨d, F, hF, ?_⟩
    dsimp only [dehom]
    have h_eq : HomogeneousLocalization.Away.mk 𝒜 (hX_mem ν) d F (h_mem_deg hF) =
        HomogeneousLocalization.Away.mk 𝒜 (hX_mem ν) d F hF' := rfl
    rw [h_eq, hmk, ← AlgebraicGeometry.Proj.basicOpenIsoAway_hom 𝒜 (MvPolynomial.X ν) (hX_mem ν) Nat.zero_lt_one]
    exact ConcreteCategory.congr_hom iso.inv_hom_id s
  have dehom_one : ∀ ν : Fin (M + 1),
      dehom ν 0 1 (MvPolynomial.isHomogeneous_one (Fin (M + 1)) k) = 1 := by
    intro ν
    dsimp only [dehom]
    have h : HomogeneousLocalization.Away.mk 𝒜 (hX_mem ν) 0 (1 : A)
        (h_mem_deg (MvPolynomial.isHomogeneous_one (Fin (M + 1)) k)) = 1 := by
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_one]
      simp
    rw [h, map_one]
  have dehom_mul : ∀ (ν : Fin (M + 1)) (d₁ d₂ : ℕ) (F₁ F₂ : A)
      (hF₁ : F₁.IsHomogeneous d₁) (hF₂ : F₂.IsHomogeneous d₂),
      dehom ν (d₁ + d₂) (F₁ * F₂) (hF₁.mul hF₂) =
        dehom ν d₁ F₁ hF₁ * dehom ν d₂ F₂ hF₂ := by
    intro ν d₁ d₂ F₁ F₂ hF₁ hF₂
    dsimp only [dehom]
    rw [← map_mul]
    congr 1
    apply HomogeneousLocalization.val_injective
    rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_mul,
      HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk, Localization.mk_mul]
    congr 1
    exact Subtype.ext (pow_add (MvPolynomial.X ν) d₁ d₂)
  have dehom_self : ∀ ν : Fin (M + 1),
      dehom ν 1 (MvPolynomial.X ν) (MvPolynomial.isHomogeneous_X k ν) = 1 := by
    intro ν
    dsimp only [dehom]
    have h : HomogeneousLocalization.Away.mk 𝒜 (hX_mem ν) 1 (MvPolynomial.X ν)
        (h_mem_deg (MvPolynomial.isHomogeneous_X k ν)) = 1 := by
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_one]
      have hsub : (⟨(MvPolynomial.X ν : A) ^ 1, ⟨1, rfl⟩⟩ : Submonoid.powers (MvPolynomial.X ν : A)) =
          ⟨MvPolynomial.X ν, Submonoid.mem_powers (MvPolynomial.X ν)⟩ :=
        Subtype.ext (pow_one (MvPolynomial.X ν))
      rw [hsub]
      exact Localization.mk_self ⟨MvPolynomial.X ν, Submonoid.mem_powers (MvPolynomial.X ν)⟩
    rw [h, map_one]
  let t : ∀ (ν _ : Fin (M + 1)),
      ↑((AlgebraicGeometry.Proj 𝒜).presheaf.obj (Opposite.op (V_cov ν).1)) := fun ν μ =>
    dehom ν 1 (MvPolynomial.X μ) (MvPolynomial.isHomogeneous_X k μ)
  have basicOpen_X_eq_inf : ∀ ν μ : Fin (M + 1),
      (AlgebraicGeometry.Proj 𝒜).basicOpen (t ν μ) = (V_cov ν).1 ⊓ (V_cov μ).1 := by
    intro ν μ
    let U := (V_cov ν).1
    let R := CommRingCat.of (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X ν))
    let f_toSpec := AlgebraicGeometry.Proj.basicOpenToSpec 𝒜 (MvPolynomial.X ν)
    let awayι := AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X ν) (hX_mem ν) Nat.zero_lt_one
    let r := HomogeneousLocalization.Away.isLocalizationElem (hX_mem ν) (hX_mem μ)
    have hr_eq : HomogeneousLocalization.Away.mk 𝒜 (hX_mem ν) 1 (MvPolynomial.X μ)
        (h_mem_deg (MvPolynomial.isHomogeneous_X k μ)) = r := by
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.Away.val_mk]
      simp [r, HomogeneousLocalization.Away.isLocalizationElem, HomogeneousLocalization.Away.val_mk]
    have ht_eq : t ν μ = (AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X ν)).hom r := by
      dsimp only [t, dehom]
      rw [hr_eq]
    have happ : U.topIso.inv.hom (t ν μ) =
        (f_toSpec.app ⊤).hom ((AlgebraicGeometry.Scheme.ΓSpecIso R).inv.hom r) := by
      have htop := ConcreteCategory.congr_hom
        (AlgebraicGeometry.Proj.basicOpenToSpec_app_top 𝒜 (MvPolynomial.X ν))
        ((AlgebraicGeometry.Scheme.ΓSpecIso R).inv.hom r)
      have hcancel : (AlgebraicGeometry.Scheme.ΓSpecIso R).hom.hom
          ((AlgebraicGeometry.Scheme.ΓSpecIso R).inv.hom r) = r :=
        ConcreteCategory.congr_hom (AlgebraicGeometry.Scheme.ΓSpecIso R).inv_hom_id r
      have htop' : (f_toSpec.app ⊤).hom ((AlgebraicGeometry.Scheme.ΓSpecIso R).inv.hom r) =
          U.topIso.inv.hom ((AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X ν)).hom
            ((AlgebraicGeometry.Scheme.ΓSpecIso R).hom.hom
              ((AlgebraicGeometry.Scheme.ΓSpecIso R).inv.hom r))) := htop
      rw [hcancel, ← ht_eq] at htop'
      exact htop'.symm
    have hSpecBasic : (AlgebraicGeometry.Spec R).basicOpen ((AlgebraicGeometry.Scheme.ΓSpecIso R).inv.hom r) =
        PrimeSpectrum.basicOpen r := by
      rw [AlgebraicGeometry.basicOpen_eq_of_affine]
    calc (AlgebraicGeometry.Proj 𝒜).basicOpen (t ν μ)
        = U.ι ''ᵁ U.toScheme.basicOpen (U.topIso.inv.hom (t ν μ)) :=
            (AlgebraicGeometry.Scheme.Opens.ι_image_basicOpen_topIso_inv U (t ν μ)).symm
      _ = U.ι ''ᵁ U.toScheme.basicOpen
            ((f_toSpec.app ⊤).hom ((AlgebraicGeometry.Scheme.ΓSpecIso R).inv.hom r)) := by
            rw [happ]
            rfl
      _ = U.ι ''ᵁ (f_toSpec ⁻¹ᵁ
            (AlgebraicGeometry.Spec R).basicOpen ((AlgebraicGeometry.Scheme.ΓSpecIso R).inv.hom r)) := by
            rw [AlgebraicGeometry.Scheme.Hom.preimage_basicOpen]
      _ = U.ι ''ᵁ (f_toSpec ⁻¹ᵁ PrimeSpectrum.basicOpen r) := by
            rw [hSpecBasic]
      _ = U.ι ''ᵁ (f_toSpec ⁻¹ᵁ (awayι ⁻¹ᵁ (V_cov μ).1)) := by
            rw [AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜 (hX_mem ν) Nat.zero_lt_one (hX_mem μ) Nat.zero_lt_one]
      _ = U.ι ''ᵁ (U.ι ⁻¹ᵁ (V_cov μ).1) := by
            congr 1
            have hcomp : f_toSpec ≫ awayι = U.ι := by
              dsimp only [f_toSpec, awayι, U, V_cov]
              rw [← AlgebraicGeometry.Proj.basicOpenIsoSpec_hom 𝒜 (MvPolynomial.X ν) (hX_mem ν) Nat.zero_lt_one,
                ← AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜 (MvPolynomial.X ν) (hX_mem ν) Nat.zero_lt_one,
                CategoryTheory.Iso.hom_inv_id_assoc]
            ext y
            have hy : (f_toSpec ≫ awayι).base y = U.ι.base y := by rw [hcomp]
            change awayι.base (f_toSpec.base y) ∈ (V_cov μ).1 ↔ U.ι.base y ∈ (V_cov μ).1
            rw [← hy]
            rfl
      _ = (V_cov ν).1 ⊓ (V_cov μ).1 := by
            ext x
            change (∃ y : ↥U, y.1 ∈ (V_cov μ).1 ∧ y.1 = x) ↔ x ∈ U ∧ x ∈ (V_cov μ).1
            constructor
            · rintro ⟨y, hyμ, rfl⟩
              exact ⟨y.2, hyμ⟩
            · rintro ⟨hxU, hxμ⟩
              exact ⟨⟨x, hxU⟩, hxμ, rfl⟩
