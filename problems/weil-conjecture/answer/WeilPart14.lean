        have hRHS : CommRingCat.ofHom (β_cat.hom.comp (f.appLE U_Y U_X hUX_le).hom) =
            f.appLE U_Y U_X hUX_le ≫ β_cat :=
          CommRingCat.ofHom_comp (f.appLE U_Y U_X hUX_le).hom β_cat.hom
        rw [hLHS, hRHS, AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp,
          hSpec_α, hSpec_β, Category.assoc, hg_Y_fac, ← Category.assoc, hSpec_sq,
          Category.assoc, ← hComm_f, ← Category.assoc, ← hg_X_fac, Category.assoc,
          ← hAff_UY.SpecMap_appLE_fromSpec f hAff_UX hUX_le, Category.assoc]
      have hMapEq := (cancel_mono hAff_UY.fromSpec).mp hPost
      exact congrArg CommRingCat.Hom.hom (by
        have hPre := congrArg AlgebraicGeometry.Spec.preimage hMapEq
        rwa [AlgebraicGeometry.Spec.preimage_map, AlgebraicGeometry.Spec.preimage_map] at hPre)
    
    intro η₀ x₁ x₂ R'_1 v₀_1 e_X1 a₁ S_bdry1 ρ₁ q₁ c₁ u₁
      R'_2 v₀_2 e_X2 a₂ S_bdry2 ρ₂ q₂ c₂ u₂
      hChart1 hu1_eta hu1_ideal hChart2 hu2_eta hu2_ideal
    obtain ⟨U_B, hAff_UB, hη₀_fUB, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
        (show f₁.left.base η₀ ∈ (⊤ : B₁.left.Opens) from trivial)
    obtain ⟨U_C, hAff_UC, hη₀_UC, hUC_sub⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
        (show η₀ ∈ (TopologicalSpace.Opens.map f₁.left.base).obj U_B from hη₀_fUB)
    have hUC_le : U_C ≤ (TopologicalSpace.Opens.map f₁.left.base).obj U_B := hUC_sub
    let A₀ : Type u := ↑(B₁.left.presheaf.obj (Opposite.op U_B))
    let C₀ : Type u := ↑(C₁.left.presheaf.obj (Opposite.op U_C))
    let f₀ : A₀ →+* C₀ := (f₁.left.appLE U_B U_C hUC_le).hom
    
    obtain ⟨hEt_e1, hEt_q1, _, _, _, _, _, _, _, _, _, _, _,
      R'_B1, e_B1, ψ_B1, ψ_rel1_0, φ_q1, hq1_eq, hEt_eB1, _, hEt_ψrel1_0,
      hComm_f1, hψrel_X1, _⟩ := hChart1
    let h₀_1 : ↑R'_B1 := ∏ c : Fin m, ψ_B1 (MvPolynomial.X c) ^ a₁ c
    let π_rel1 : ↑R'_B1 →+* ↑R'_1 :=
      ψ_rel1_0.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)
    have hComm_π1 : e_X1 ≫ f₁.left =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_rel1) ≫ e_B1 := by
      rw [hComm_f1, ← Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp]
    obtain ⟨s_B1, t_X1, R_B1, R₁, instCR_B1, instCR_1, instAlg_B1, instLoc_B1,
      instAlg_1, instLoc_1, α₁, β₁, u_loc1, hu_loc1, hEt_α1, hEt_β1,
      hu_loc1_comap, hu_loc1_fromSpec, hComm_αβ1⟩ :=
      hRoofLoc f₁.left η₀ U_B hAff_UB U_C hAff_UC hη₀_UC hUC_le
        R'_B1 R'_1 e_B1 e_X1 π_rel1 u₁ hEt_eB1 hEt_e1 hu1_eta hComm_π1
    letI : CommRing R_B1 := instCR_B1
    letI : CommRing R₁ := instCR_1
    letI : Algebra (↑R'_B1) R_B1 := instAlg_B1
    letI : IsLocalization.Away s_B1 R_B1 := instLoc_B1
    letI : Algebra (↑R'_1) R₁ := instAlg_1
    letI : IsLocalization.Away (π_rel1 s_B1 * t_X1) R₁ := instLoc_1
    have hEt_ψrel1_hom : ψ_rel1_0.Etale :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
        hEt_ψrel1_0
    obtain ⟨σ_B1, ψ_rel1, hEt_ψrel1, hσ_B1_comp, hψrel1_C, hψrel1_X⟩ :=
      hNodalLift (↑R'_B1) (↑R'_1) R_B1 R₁ h₀_1 s_B1 t_X1 ψ_rel1_0 hEt_ψrel1_hom
    let φ₁ := (algebraMap (↑R'_1) R₁).comp φ_q1
    have hEt_φq1 : φ_q1.Etale :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
        (hq1_eq ▸ hEt_q1)
    have : Algebra.Etale (↑R'_1) R₁ :=
      Algebra.Etale.of_isLocalizationAway (π_rel1 s_B1 * t_X1)
    have hEt_φ1 : φ₁.Etale :=
      RingHom.Etale.stableUnderComposition _ _ hEt_φq1
        (RingHom.etale_algebraMap.mpr inferInstance)
    have hComm_base1 :
        ψ_rel1.comp ((Ideal.Quotient.mk _).comp (MvPolynomial.C.comp α₁)) = β₁.comp f₀ := by
      change (ψ_rel1.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)).comp α₁ = β₁.comp f₀
      rw [hψrel1_C]
      exact hComm_αβ1 σ_B1 hσ_B1_comp
    have hMatch_X1 : ∀ b : Fin 2, ψ_rel1 (Ideal.Quotient.mk _ (MvPolynomial.X b)) =
        φ₁ (Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl b))) := by
      intro b
      rw [hψrel1_X b, hψrel_X1 b]
      rfl
    have hIdeal_φ1 : u_loc1.comap φ₁ = Ideal.span
        {Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl 0)),
         Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl 1)),
         Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c₁))} := by
      change u_loc1.comap ((algebraMap (↑R'_1) R₁).comp φ_q1) = _
      rw [← Ideal.comap_comap, hu_loc1_comap, ← hu1_ideal, hq1_eq,
        AlgebraicGeometry.Spec.map_apply]
      rfl
    
    obtain ⟨hEt_e2, hEt_q2, _, _, _, _, _, _, _, _, _, _, _,
      R'_B2, e_B2, ψ_B2, ψ_rel2_0, φ_q2, hq2_eq, hEt_eB2, _, hEt_ψrel2_0,
      hComm_f2, hψrel_X2, _⟩ := hChart2
    let h₀_2 : ↑R'_B2 := ∏ c : Fin m, ψ_B2 (MvPolynomial.X c) ^ a₂ c
    let π_rel2 : ↑R'_B2 →+* ↑R'_2 :=
      ψ_rel2_0.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)
    have hComm_π2 : e_X2 ≫ f₁.left =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_rel2) ≫ e_B2 := by
      rw [hComm_f2, ← Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp]
    obtain ⟨s_B2, t_X2, R_B2, R₂, instCR_B2, instCR_2, instAlg_B2, instLoc_B2,
      instAlg_2, instLoc_2, α₂, β₂, u_loc2, hu_loc2, hEt_α2, hEt_β2,
      hu_loc2_comap, hu_loc2_fromSpec, hComm_αβ2⟩ :=
      hRoofLoc f₁.left η₀ U_B hAff_UB U_C hAff_UC hη₀_UC hUC_le
        R'_B2 R'_2 e_B2 e_X2 π_rel2 u₂ hEt_eB2 hEt_e2 hu2_eta hComm_π2
    letI : CommRing R_B2 := instCR_B2
    letI : CommRing R₂ := instCR_2
    letI : Algebra (↑R'_B2) R_B2 := instAlg_B2
    letI : IsLocalization.Away s_B2 R_B2 := instLoc_B2
    letI : Algebra (↑R'_2) R₂ := instAlg_2
    letI : IsLocalization.Away (π_rel2 s_B2 * t_X2) R₂ := instLoc_2
    have hEt_ψrel2_hom : ψ_rel2_0.Etale :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
        hEt_ψrel2_0
    obtain ⟨σ_B2, ψ_rel2, hEt_ψrel2, hσ_B2_comp, hψrel2_C, hψrel2_X⟩ :=
      hNodalLift (↑R'_B2) (↑R'_2) R_B2 R₂ h₀_2 s_B2 t_X2 ψ_rel2_0 hEt_ψrel2_hom
    let φ₂ := (algebraMap (↑R'_2) R₂).comp φ_q2
    have hEt_φq2 : φ_q2.Etale :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
        (hq2_eq ▸ hEt_q2)
    have : Algebra.Etale (↑R'_2) R₂ :=
      Algebra.Etale.of_isLocalizationAway (π_rel2 s_B2 * t_X2)
    have hEt_φ2 : φ₂.Etale :=
      RingHom.Etale.stableUnderComposition _ _ hEt_φq2
        (RingHom.etale_algebraMap.mpr inferInstance)
    have hComm_base2 :
        ψ_rel2.comp ((Ideal.Quotient.mk _).comp (MvPolynomial.C.comp α₂)) = β₂.comp f₀ := by
      change (ψ_rel2.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)).comp α₂ = β₂.comp f₀
      rw [hψrel2_C]
      exact hComm_αβ2 σ_B2 hσ_B2_comp
    have hMatch_X2 : ∀ b : Fin 2, ψ_rel2 (Ideal.Quotient.mk _ (MvPolynomial.X b)) =
        φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl b))) := by
      intro b
      rw [hψrel2_X b, hψrel_X2 b]
      rfl
    have hIdeal_φ2 : u_loc2.comap φ₂ = Ideal.span
        {Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl 0)),
         Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl 1)),
         Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c₂))} := by
      change u_loc2.comap ((algebraMap (↑R'_2) R₂).comp φ_q2) = _
      rw [← Ideal.comap_comap, hu_loc2_comap, ← hu2_ideal, hq2_eq,
        AlgebraicGeometry.Spec.map_apply]
      rfl
    have hComap_β_eq : u_loc1.comap β₁ = u_loc2.comap β₂ := by
      letI : u_loc1.IsPrime := hu_loc1
      letI : u_loc2.IsPrime := hu_loc2
      have hPtEq : (⟨u_loc1.comap β₁, Ideal.IsPrime.comap β₁⟩ :
          AlgebraicGeometry.Spec (C₁.left.presheaf.obj (Opposite.op U_C))) =
          ⟨u_loc2.comap β₂, Ideal.IsPrime.comap β₂⟩ :=
        hAff_UC.fromSpec.isOpenEmbedding.injective
          (hu_loc1_fromSpec.trans hu_loc2_fromSpec.symm)
      exact congrArg PrimeSpectrum.asIdeal hPtEq
    exact ⟨A₀, C₀, inferInstance, inferInstance, f₀,
      R_B1, R_B2, R₁, R₂, instCR_B1, instCR_B2, instCR_1, instCR_2,
      α₁, α₂, β₁, β₂, u_loc1, hu_loc1, u_loc2, hu_loc2,
      algebraMap (↑R'_B1) R_B1 h₀_1, algebraMap (↑R'_B2) R_B2 h₀_2,
      ψ_rel1, ψ_rel2, φ₁, φ₂,
      hEt_α1, hEt_α2, hEt_β1, hEt_β2,
      hEt_ψrel1, hEt_ψrel2, hEt_φ1, hEt_φ2,
      hComap_β_eq, hComm_base1, hComm_base2,
      hMatch_X1, hMatch_X2, hIdeal_φ1, hIdeal_φ2⟩

theorem weil_relative_toroidal_components_and_state_assembly (k : Type u) [Field k] (m : ℕ)
    (B₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (Z_B₁ : Set B₁.left)
    (r_B : ℕ) (D_B : Fin r_B → AlgebraicGeometry.Scheme.{u})
    (ιD_B : ∀ i : Fin r_B, D_B i ⟶ B₁.left)
    (hClD_B : ∀ i : Fin r_B, AlgebraicGeometry.IsClosedImmersion (ιD_B i))
    (hIntD_B : ∀ i : Fin r_B, AlgebraicGeometry.IsIntegral (D_B i))
    (hPairD_B : _root_.Pairwise fun i j : Fin r_B => Set.range (ιD_B i).base ≠ Set.range (ιD_B j).base)
    (hZB₁_eq : Z_B₁ = ⋃ i : Fin r_B, Set.range (ιD_B i).base)
    (hChartsB₁ : ∀ y : B₁.left, ∃ (U : B₁.left.Opens),
      AlgebraicGeometry.IsAffineOpen U ∧ y ∈ U ∧
      ∃ (ψ : MvPolynomial (Fin m) k →+* ↑(B₁.left.presheaf.obj (Opposite.op U))),
        AlgebraicGeometry.Etale (U.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) ∧
        (U.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = U.ι ≫ B₁.hom) ∧
        ∃ (α : {i : Fin r_B // Nonempty ↑((TopologicalSpace.Opens.map (ιD_B i).base).obj U)} → Fin m),
          Function.Injective α ∧
          ∀ (i : Fin r_B) (hi : Nonempty ↑((TopologicalSpace.Opens.map (ιD_B i).base).obj U)),
            RingHom.ker ((ιD_B i).app U).hom =
              Ideal.span {ψ (MvPolynomial.X (α ⟨i, hi⟩))})
    (C₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (Z₁ : Set C₁.left) (f₁ : C₁ ⟶ B₁)
    (hClosedZ₁ : IsClosed Z₁)
    (hProjC₁ : IsProjectiveOverField k C₁)
    (hSmOpen : ∃ (x₀ : C₁.left) (V₀ : C₁.left.Opens),
      x₀ ∈ V₀ ∧ AlgebraicGeometry.SmoothOfRelativeDimension (m + 1) (V₀.ι ≫ C₁.hom))
    (S_rel : Set C₁.left)
    (hClosedS : IsClosed S_rel)
    (hSmCharts : ∀ x : C₁.left, x ∉ S_rel →
      ∃ (R' : CommRingCat.{u}) (v₀ : AlgebraicGeometry.Spec R')
        (e_X : AlgebraicGeometry.Spec R' ⟶ C₁.left)
        (ψ : MvPolynomial (Fin (m + 1)) k →+* ↑R')
        (I : Finset (Fin (m + 1))),
        AlgebraicGeometry.Etale e_X ∧
        AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) ∧
        e_X.base v₀ = x ∧
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = e_X ≫ C₁.hom) ∧
        (∀ i ∈ I, ψ (MvPolynomial.X i) ∈ v₀.asIdeal) ∧
        e_X.base ⁻¹' Z₁ =
          {v : AlgebraicGeometry.Spec R' | ∃ i ∈ I, ψ (MvPolynomial.X i) ∈ v.asIdeal})
    (hTorCharts : ∀ x : C₁.left, x ∈ S_rel →
      ∃ (R' : CommRingCat.{u}) (v₀ : AlgebraicGeometry.Spec R')
        (e_X : AlgebraicGeometry.Spec R' ⟶ C₁.left)
        (a : Fin m → ℕ) (S_bdry : Finset (Fin m))
        (ρ : {c : Fin m // 1 ≤ a c} → Fin r_B)
        (q : AlgebraicGeometry.Spec R' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
          (MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ Ideal.span
            ({MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
              ∏ c : Fin m, MvPolynomial.X (Sum.inr c) ^ a c} :
              Set (MvPolynomial (Fin 2 ⊕ Fin m) k))))),
        IsRelativeToroidalChartAt k m B₁ r_B D_B ιD_B C₁ Z₁ f₁ S_rel x
          R' v₀ e_X a S_bdry ρ q) :
    ∃ (K₀ : ℕ) (T₀ : Fin K₀ → TopologicalSpace.Closeds ↥C₁.left) (n_T₀ : Fin K₀ → ℕ),
      IsToroidalResolutionState k m B₁ Z_B₁ C₁ Z₁ f₁ K₀ T₀ n_T₀ :=
by
  classical
  obtain ⟨L, Z, η, hZ_sub, hZ_irred, hη, hIncomp, _hCov, hMax⟩ :=
    weil_projective_closed_irreducible_components k C₁ hProjC₁ S_rel hClosedS
  have hModel := fun a : Fin m → ℕ => weil_toroidal_model_prime_and_sum_one_elim k m a
  obtain ⟨hBranch, hMakeOverlap⟩ :=
    weil_relative_toroidal_branch_matching_and_overlap k m B₁ r_B D_B ιD_B hClD_B
      C₁ Z₁ f₁ S_rel hClosedS L Z η hZ_sub hη hIncomp hMax
      (fun a => (hModel a).1)
      (fun a c₀ hc₀ => ⟨((hModel a).2.1 c₀ hc₀).1, ((hModel a).2.1 c₀ hc₀).2.1⟩)
  have hExistExp : ∀ γ : Fin L, ∃ n : ℕ, 1 ≤ n ∧
      ∀ (x : C₁.left) (R' : CommRingCat.{u}) (v₀ : AlgebraicGeometry.Spec R')
        (e_X : AlgebraicGeometry.Spec R' ⟶ C₁.left)
        (a : Fin m → ℕ) (S_bdry : Finset (Fin m))
        (ρ : {c : Fin m // 1 ≤ a c} → Fin r_B)
        (q : AlgebraicGeometry.Spec R' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
          (MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ Ideal.span
            ({MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
              ∏ c : Fin m, MvPolynomial.X (Sum.inr c) ^ a c} :
              Set (MvPolynomial (Fin 2 ⊕ Fin m) k)))))
        (c₀ : Fin m) (u₀ : AlgebraicGeometry.Spec R'),
        IsRelativeToroidalChartAt k m B₁ r_B D_B ιD_B C₁ Z₁ f₁ S_rel x
          R' v₀ e_X a S_bdry ρ q →
        1 ≤ a c₀ →
        e_X.base u₀ = η γ →
        (q.base u₀).asIdeal = Ideal.span
          {Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl 0)),
           Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl 1)),
           Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c₀))} →
        a c₀ = n := by
    intro γ
    obtain ⟨R'_r, v₀_r, e_Xr, a_r, S_r, ρ_r, q_r, hChart_r⟩ :=
      hTorCharts (η γ) (hZ_sub γ (hη γ).1)
    obtain ⟨c_r, hc_r, u_r, _, hu_eta, hu_ideal⟩ :=
      (hBranch (η γ) R'_r v₀_r e_Xr a_r S_r ρ_r q_r hChart_r).1 γ (hη γ).1
    refine ⟨a_r c_r, hc_r, ?_⟩
    intro x R' v₀ e_X a S_bdry ρ q c₀ u₀ hChart hc₀ hu₀_eta hu₀_ideal
    have hOv := hMakeOverlap (η γ) x (η γ)
      R' v₀ e_X a S_bdry ρ q c₀ u₀
      R'_r v₀_r e_Xr a_r S_r ρ_r q_r c_r u_r
      hChart hu₀_eta hu₀_ideal hChart_r hu_eta hu_ideal
    exact weil_nodal_kaehler_adjugate_exponent_eq k m a a_r c₀ c_r hOv
      (((hModel a).2.1 c₀ hc₀).2.2) (((hModel a_r).2.1 c_r hc_r).2.2)
  let n_comp : Fin L → ℕ := fun γ => Classical.choose (hExistExp γ)
  have hn_comp : ∀ γ : Fin L, 1 ≤ n_comp γ ∧
      ∀ (x : C₁.left) (R' : CommRingCat.{u}) (v₀ : AlgebraicGeometry.Spec R')
        (e_X : AlgebraicGeometry.Spec R' ⟶ C₁.left)
        (a : Fin m → ℕ) (S_bdry : Finset (Fin m))
        (ρ : {c : Fin m // 1 ≤ a c} → Fin r_B)
        (q : AlgebraicGeometry.Spec R' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
          (MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ Ideal.span
            ({MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
              ∏ c : Fin m, MvPolynomial.X (Sum.inr c) ^ a c} :
              Set (MvPolynomial (Fin 2 ⊕ Fin m) k)))))
        (c₀ : Fin m) (u₀ : AlgebraicGeometry.Spec R'),
        IsRelativeToroidalChartAt k m B₁ r_B D_B ιD_B C₁ Z₁ f₁ S_rel x
          R' v₀ e_X a S_bdry ρ q →
        1 ≤ a c₀ →
        e_X.base u₀ = η γ →
        (q.base u₀).asIdeal = Ideal.span
          {Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl 0)),
           Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl 1)),
           Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c₀))} →
        a c₀ = n_comp γ :=
    fun γ => Classical.choose_spec (hExistExp γ)
  let S_high : Finset (Fin L) := Finset.univ.filter fun γ => 2 ≤ n_comp γ
  let K₀ : ℕ := Fintype.card ↥S_high
  let emb : Fin K₀ ≃ ↥S_high := (Fintype.equivFin ↥S_high).symm
  let T₀ : Fin K₀ → TopologicalSpace.Closeds ↥C₁.left := fun α => Z (emb α).1
  let n_T₀ : Fin K₀ → ℕ := fun α => n_comp (emb α).1
  have hn_T₀_ge : ∀ α : Fin K₀, 2 ≤ n_T₀ α := by
    intro α
    exact (Finset.mem_filter.mp (emb α).2).2
  refine ⟨K₀, T₀, n_T₀, hClosedZ₁, hSmOpen, hn_T₀_ge, ?_, ?_,
    r_B, D_B, ιD_B, hClD_B, hIntD_B, hPairD_B, hZB₁_eq, hChartsB₁, ?_⟩
  · intro α
    exact hZ_irred (emb α).1
  · intro α β hne hEq
    have hne' : (emb α).1 ≠ (emb β).1 := fun h => hne (emb.injective (Subtype.ext h))
    apply hIncomp hne'
    change (T₀ α : Set C₁.left) ⊆ (T₀ β : Set C₁.left)
    rw [hEq]
  · intro x
    by_cases hxS : x ∈ S_rel
    · obtain ⟨R', v₀, e_X, a, S_bdry, ρ, q, hChart⟩ := hTorCharts x hxS
      have hChart' := hChart
      obtain ⟨hEt_e, hEt_q, hv₀_x, ha_pos, hSub_bdry, hInj_ρ, hComm_X,
        hInl_v₀, hInr_v₀, hPreZ₁, hPreDB, _hPreS, _hIrred_br,
        _R'_B, _e_B, _ψ_B, _ψ_rel, φ_q, hq_eq, _⟩ := hChart'
      by_cases hSum1 : (∑ c : Fin m, a c) = 1
      · refine Or.inl ⟨?_, ?_⟩
        · intro α hxT
          obtain ⟨c₀, hc₀, u₀, _, hu₀_eta, hu₀_ideal⟩ :=
            (hBranch x R' v₀ e_X a S_bdry ρ q hChart).1 (emb α).1 hxT
          have ha_eq : a c₀ = n_T₀ α :=
            (hn_comp (emb α).1).2 x R' v₀ e_X a S_bdry ρ q c₀ u₀ hChart hc₀ hu₀_eta hu₀_ideal
          have h2 : 2 ≤ a c₀ := by
            rw [ha_eq]
            exact hn_T₀_ge α
          have hle1 : a c₀ ≤ ∑ c : Fin m, a c :=
            Finset.single_le_sum (fun _ _ => Nat.zero_le _) (Finset.mem_univ c₀)
          omega
        · have hq_mem : ∀ (v : AlgebraicGeometry.Spec R')
              (z : MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ Ideal.span
                ({MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
                  ∏ c : Fin m, MvPolynomial.X (Sum.inr c) ^ a c} :
                  Set (MvPolynomial (Fin 2 ⊕ Fin m) k))),
              z ∈ (q.base v).asIdeal ↔ φ_q z ∈ v.asIdeal := by
            intro v z
            rw [hq_eq, AlgebraicGeometry.Spec.map_apply]
            rfl
          have : v₀.asIdeal.IsPrime := v₀.isPrime
          have hInl_φ : ∀ b : Fin 2,
              φ_q (Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl b))) ∈ v₀.asIdeal :=
            fun b => (hq_mem v₀ _).mp (hInl_v₀ b)
          have hInr_φ : ∀ c ∈ S_bdry,
              φ_q (Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c))) ∈ v₀.asIdeal :=
            fun c hc => (hq_mem v₀ _).mp (hInr_v₀ c hc)
          obtain ⟨Θ, I_elim, hv₀_I, hCut_I⟩ :=
            (hModel a).2.2 hSum1 (↑R') v₀.asIdeal S_bdry φ_q hSub_bdry hInl_φ hInr_φ
          let ψ : MvPolynomial (Fin (m + 1)) k →+* ↑R' := φ_q.comp Θ.toRingHom
          let isoSpecΘ : AlgebraicGeometry.Spec (CommRingCat.of _) ≅
              AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin (m + 1)) k)) :=
            { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom Θ.toRingHom)
              inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom Θ.symm.toRingHom)
              hom_inv_id := by
                rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
                have hId : Θ.toRingHom.comp Θ.symm.toRingHom = RingHom.id _ :=
                  RingHom.ext fun z => Θ.apply_symm_apply z
                rw [hId, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
              inv_hom_id := by
                rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
                have hId : Θ.symm.toRingHom.comp Θ.toRingHom = RingHom.id _ :=
                  RingHom.ext fun z => Θ.symm_apply_apply z
                rw [hId, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id] }
          have : CategoryTheory.IsIso isoSpecΘ.hom := isoSpecΘ.isIso_hom
          have hSpecψ_eq : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) =
              q ≫ isoSpecΘ.hom := by
            dsimp [ψ, isoSpecΘ]
            rw [hq_eq, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          have hEt_ψ : AlgebraicGeometry.Etale
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) := by
            rw [hSpecψ_eq]
            exact inferInstance
          have hComm_ψ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) =
              e_X ≫ C₁.hom := by
            have hRing : ψ.comp MvPolynomial.C =
                φ_q.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) :=
              RingHom.ext fun r => congrArg φ_q (Θ.commutes r)
            rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hRing,
              CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, ← hq_eq, hComm_X]
          refine ⟨R', v₀, e_X, ψ, I_elim, hEt_e, hEt_ψ, hv₀_x, hComm_ψ, hv₀_I, ?_⟩
          rw [hPreZ₁]
          ext v
          change (∃ c ∈ S_bdry, _ ∈ (q.base v).asIdeal) ↔
            ∃ i ∈ I_elim, ψ (MvPolynomial.X i) ∈ v.asIdeal
          simp only [hq_mem v]
          exact hCut_I v.asIdeal v.isPrime
      · have hSum2 : 2 ≤ ∑ c : Fin m, a c := by omega
        let S_miss : Finset (Fin K₀) :=
          Finset.univ.filter fun α => x ∉ (T₀ α : Set C₁.left)
        let F_miss : Set (AlgebraicGeometry.Spec R') :=
          ⋃ α ∈ S_miss, e_X.base ⁻¹' (T₀ α : Set C₁.left)
        have hClosed_F : IsClosed F_miss :=
          S_miss.finite_toSet.isClosed_biUnion fun α _ =>
            (T₀ α).isClosed.preimage e_X.continuous
        have hv₀_compl : v₀ ∈ F_missᶜ := by
          intro hv₀_in
          rcases Set.mem_iUnion₂.mp hv₀_in with ⟨α, hα_mem, hv₀_pre⟩
          have hx_not : x ∉ (T₀ α : Set C₁.left) := (Finset.mem_filter.mp hα_mem).2
          apply hx_not
          change x ∈ (T₀ α : Set C₁.left)
          rw [← hv₀_x]
          exact hv₀_pre
        obtain ⟨_, ⟨g, rfl⟩, hv₀_bg, hbg_sub⟩ :=
          PrimeSpectrum.isTopologicalBasis_basic_opens.exists_subset_of_mem_open
            hv₀_compl hClosed_F.isOpen_compl
        have hg_not_mem : g ∉ v₀.asIdeal := hv₀_bg
        have hDisj_g : Disjoint (Submonoid.powers g : Set ↑R') (v₀.asIdeal : Set ↑R') := by
          rw [Set.disjoint_left]
          rintro _ ⟨n, rfl⟩ hn_mem
          exact hg_not_mem (v₀.isPrime.mem_of_pow_mem n hn_mem)
        let p'₀ : Ideal (Localization.Away g) :=
          Ideal.map (algebraMap (↑R') (Localization.Away g)) v₀.asIdeal
        have hp'₀ : p'₀.IsPrime :=
          IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers g)
            (Localization.Away g) v₀.asIdeal v₀.isPrime hDisj_g
        let R'' : CommRingCat.{u} := CommRingCat.of (Localization.Away g)
        let v'₀ : AlgebraicGeometry.Spec R'' := ⟨p'₀, hp'₀⟩
        let j_g : AlgebraicGeometry.Spec R'' ⟶ AlgebraicGeometry.Spec R' :=
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap (↑R') (Localization.Away g)))
        have : AlgebraicGeometry.IsOpenImmersion j_g :=
          AlgebraicGeometry.IsOpenImmersion.of_isLocalization g
        have hj_g_v₀ : j_g.base v'₀ = v₀ := by
          rw [AlgebraicGeometry.Spec.map_apply]
          exact PrimeSpectrum.ext (IsLocalization.under_map_of_isPrime_disjoint
            (Submonoid.powers g) (Localization.Away g) v₀.isPrime hDisj_g)
        have hj_g_mem_bg : ∀ v : AlgebraicGeometry.Spec R'',
            j_g.base v ∈ (PrimeSpectrum.basicOpen g : Set (PrimeSpectrum ↑R')) := by
          intro v
          rw [AlgebraicGeometry.Spec.map_apply]
          change g ∉ Ideal.comap (algebraMap (↑R') (Localization.Away g)) v.asIdeal
          rw [Ideal.mem_comap]
          intro hg_mem
          exact v.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem v.asIdeal hg_mem
            (IsLocalization.Away.algebraMap_isUnit g))
        let e'_X : AlgebraicGeometry.Spec R'' ⟶ C₁.left := j_g ≫ e_X
        let q' : AlgebraicGeometry.Spec R'' ⟶ _ := j_g ≫ q
        have hq'_base : ∀ v : AlgebraicGeometry.Spec R'',
            q'.base v = q.base (j_g.base v) := fun _ => rfl
        have he'_base : ∀ v : AlgebraicGeometry.Spec R'',
            e'_X.base v = e_X.base (j_g.base v) := fun _ => rfl
        refine Or.inr ⟨R'', v'₀, e'_X, a, S_bdry, ρ, q', inferInstance, inferInstance,
          ?_, hSum2, hSub_bdry, hInj_ρ, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
        · rw [he'_base, hj_g_v₀, hv₀_x]
        · change (j_g ≫ q) ≫ _ = (j_g ≫ e_X) ≫ C₁.hom
          rw [Category.assoc, Category.assoc, hComm_X]
        · intro b
          rw [hq'_base, hj_g_v₀]
          exact hInl_v₀ b
        · intro c hc
          rw [hq'_base, hj_g_v₀]
          exact hInr_v₀ c hc
        · change j_g.base ⁻¹' (e_X.base ⁻¹' Z₁) = _
          rw [hPreZ₁]
          rfl
        · intro c hc
          have hComp_f : (e'_X ≫ f₁.left).base = (e_X ≫ f₁.left).base ∘ j_g.base := rfl
          rw [hComp_f, Set.preimage_comp, hPreDB c hc]
          rfl
        · intro α hxNotT
          ext v
          simp only [Set.mem_empty_iff_false, iff_false]
          intro hv_mem
          have hv_j : j_g.base v ∈ e_X.base ⁻¹' (T₀ α : Set C₁.left) := hv_mem
          have hα_miss : α ∈ S_miss := Finset.mem_filter.mpr ⟨Finset.mem_univ α, hxNotT⟩
          have hv_F : j_g.base v ∈ F_miss := Set.mem_biUnion hα_miss hv_j
          exact hbg_sub (hj_g_mem_bg v) hv_F
        · intro α hxT
          obtain ⟨c₀, hc₀, u₀, hPre_T, hu₀_eta, hu₀_ideal⟩ :=
            (hBranch x R' v₀ e_X a S_bdry ρ q hChart).1 (emb α).1 hxT
          have ha_eq : a c₀ = n_T₀ α :=
            (hn_comp (emb α).1).2 x R' v₀ e_X a S_bdry ρ q c₀ u₀ hChart hc₀ hu₀_eta hu₀_ideal
          refine ⟨c₀, ha_eq, ?_⟩
          change j_g.base ⁻¹' (e_X.base ⁻¹' (Z (emb α).1 : Set C₁.left)) = _
          rw [hPre_T]
          rfl
        · intro c hc2
          have hc1 : 1 ≤ a c := by omega
          obtain ⟨γ, hxZ, hPreZ_c⟩ :=
            (hBranch x R' v₀ e_X a S_bdry ρ q hChart).2 c hc1
          obtain ⟨c₀, hc₀, u₀, hPreZ_c₀, hu₀_eta, hu₀_ideal⟩ :=
            (hBranch x R' v₀ e_X a S_bdry ρ q hChart).1 γ hxZ
          have hu₀_in_c₀ : u₀ ∈ {v : AlgebraicGeometry.Spec R' |
              (∀ b : Fin 2,
                Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl b)) ∈ (q.base v).asIdeal) ∧
              Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c₀)) ∈ (q.base v).asIdeal} := by
            refine ⟨fun b => ?_, ?_⟩
            · rw [hu₀_ideal]
              fin_cases b
              · exact Ideal.subset_span (by simp)
              · exact Ideal.subset_span (by simp)
            · rw [hu₀_ideal]
              exact Ideal.subset_span (by simp)
          rw [← hPreZ_c₀, hPreZ_c] at hu₀_in_c₀
          have hc_mem_P : Ideal.Quotient.mk
              (Ideal.span ({MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
                ∏ c' : Fin m, MvPolynomial.X (Sum.inr c') ^ a c'} :
                Set (MvPolynomial (Fin 2 ⊕ Fin m) k)))
              (MvPolynomial.X (Sum.inr c)) ∈
              Ideal.span
                {Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl 0)),
                 Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl 1)),
                 Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c₀))} := by
            rw [← hu₀_ideal]
            exact hu₀_in_c₀.2
          have hc_eq : c = c₀ := (((hModel a).2.1 c₀ hc₀).2.1 c).mp hc_mem_P
          have ha_eq : a c₀ = n_comp γ :=
            (hn_comp γ).2 x R' v₀ e_X a S_bdry ρ q c₀ u₀ hChart hc₀ hu₀_eta hu₀_ideal
          have hγ_ge2 : 2 ≤ n_comp γ := by
            rw [← ha_eq, ← hc_eq]
            exact hc2
          have hγ_high : γ ∈ S_high := Finset.mem_filter.mpr ⟨Finset.mem_univ γ, hγ_ge2⟩
          let α : Fin K₀ := emb.symm ⟨γ, hγ_high⟩
          have hemb_α : (emb α).1 = γ := congrArg Subtype.val (emb.apply_symm_apply ⟨γ, hγ_high⟩)
          refine ⟨α, ?_, ?_⟩
          · change x ∈ (Z (emb α).1 : Set C₁.left)
            rwa [hemb_α]
          · change j_g.base ⁻¹' (e_X.base ⁻¹' (Z (emb α).1 : Set C₁.left)) = _
            rw [hemb_α, hPreZ_c]
            rfl
    · refine Or.inl ⟨?_, hSmCharts x hxS⟩
      intro α hxT
      exact hxS (hZ_sub (emb α).1 hxT)

theorem weil_semistable_curve_initial_toroidal_state (k : Type u) [Field k] [IsAlgClosed k] (m : ℕ)
    (B₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (Z_B₁ : Set B₁.left) (U_B₁ : B₁.left.Opens)
    (hIntB₁ : AlgebraicGeometry.IsIntegral B₁.left)
    (hProjB₁ : IsProjectiveOverField k B₁)
    (hSmB₁ : AlgebraicGeometry.SmoothOfRelativeDimension m B₁.hom)
    (hSncB₁ : IsSncDivisorSupport k m B₁ Z_B₁)
    (hU_B₁_eq : (U_B₁ : Set B₁.left) = Z_B₁ᶜ)
    (hU_B₁ : Nonempty U_B₁)
    (C₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (f₁ : C₁ ⟶ B₁) (n : ℕ) (τ₁ : Fin n → (B₁ ⟶ C₁))
    (hCurve₁ : IsSemistablePointedCurveOver k f₁ U_B₁ n τ₁)
    (hIntC₁ : AlgebraicGeometry.IsIntegral C₁.left)
    (hProjC₁ : IsProjectiveOverField k C₁) :
    ∃ (K₀ : ℕ) (T₀ : Fin K₀ → TopologicalSpace.Closeds ↥C₁.left) (n_T₀ : Fin K₀ → ℕ),
      IsToroidalResolutionState k m B₁ Z_B₁ C₁
        (f₁.left.base ⁻¹' Z_B₁ ∪ ⋃ j : Fin n, Set.range (τ₁ j).left.base)
        f₁ K₀ T₀ n_T₀ :=
by
  rcases hSncB₁ with ⟨r_B, D_B, ιD_B, hClD_B, hIntD_B, hPairD_B, hZB₁_eq, hChartsB₁⟩
  have hProp_f₁ : AlgebraicGeometry.IsProper f₁.left := hCurve₁.2.1
  have hSurj_f₁ : AlgebraicGeometry.Surjective f₁.left := hCurve₁.2.2.2.1
  have hSm_f₁U : AlgebraicGeometry.SmoothOfRelativeDimension 1 (f₁.left ∣_ U_B₁) :=
    hCurve₁.2.2.2.2.2.1
  have hSec_τ₁ : ∀ j : Fin n, τ₁ j ≫ f₁ = 𝟙 B₁ := hCurve₁.2.2.2.2.2.2.1
  have hDisj_τ₁ : _root_.Pairwise fun i j : Fin n =>
      Disjoint (Set.range (τ₁ i).left.base) (Set.range (τ₁ j).left.base) :=
    hCurve₁.2.2.2.2.2.2.2.1
  let Z₁ : Set C₁.left :=
    f₁.left.base ⁻¹' Z_B₁ ∪ ⋃ j : Fin n, Set.range (τ₁ j).left.base
  have hClosedZ₁ : IsClosed Z₁ := by
    have hClosedZB₁ : IsClosed Z_B₁ := by
      have hZB₁_compl : Z_B₁ = (U_B₁ : Set B₁.left)ᶜ := by
        rw [← compl_compl Z_B₁, ← hU_B₁_eq]
      rw [hZB₁_compl]
      exact U_B₁.isOpen.isClosed_compl
    have hClosedPre : IsClosed (f₁.left.base ⁻¹' Z_B₁) :=
      hClosedZB₁.preimage f₁.left.continuous
    have hClosedSec : IsClosed (⋃ j : Fin n, Set.range (τ₁ j).left.base) := by
      refine isClosed_iUnion_of_finite fun j => ?_
      have hComp_j : (τ₁ j).left ≫ f₁.left = 𝟙 B₁.left :=
        congrArg CategoryTheory.CommaMorphism.left (hSec_τ₁ j)
      have : AlgebraicGeometry.IsClosedImmersion ((τ₁ j).left ≫ f₁.left) := by
        rw [hComp_j]
        exact inferInstance
      have hCl_j : AlgebraicGeometry.IsClosedImmersion (τ₁ j).left :=
        AlgebraicGeometry.IsClosedImmersion.of_comp (τ₁ j).left f₁.left
      exact hCl_j.isClosedEmbedding.isClosed_range
    exact hClosedPre.union hClosedSec
  let V₀ : C₁.left.Opens := f₁.left ⁻¹ᵁ U_B₁
  have hSm_UB₁ : AlgebraicGeometry.SmoothOfRelativeDimension m (U_B₁.ι ≫ B₁.hom) := by
    have h0m := AlgebraicGeometry.smoothOfRelativeDimension_comp 0 m U_B₁.ι B₁.hom
    simpa [Nat.zero_add] using h0m
  have hV₀_sm : AlgebraicGeometry.SmoothOfRelativeDimension (m + 1) (V₀.ι ≫ C₁.hom) := by
    have h1m := AlgebraicGeometry.smoothOfRelativeDimension_comp 1 m
      (f₁.left ∣_ U_B₁) (U_B₁.ι ≫ B₁.hom)
    have hEq : (f₁.left ∣_ U_B₁) ≫ (U_B₁.ι ≫ B₁.hom) = V₀.ι ≫ C₁.hom := by
      rw [← Category.assoc, AlgebraicGeometry.morphismRestrict_ι, Category.assoc, Over.w f₁]
    rw [Nat.add_comm 1 m, hEq] at h1m
    exact h1m
  have hSmOpen : ∃ (x₀ : C₁.left) (V₀ : C₁.left.Opens),
      x₀ ∈ V₀ ∧ AlgebraicGeometry.SmoothOfRelativeDimension (m + 1) (V₀.ι ≫ C₁.hom) := by
    obtain ⟨⟨y₀, hy₀⟩⟩ := hU_B₁
    obtain ⟨x₀, hx₀⟩ := hSurj_f₁.surj y₀
    refine ⟨x₀, V₀, ?_, hV₀_sm⟩
    change f₁.left.base x₀ ∈ U_B₁
    rwa [hx₀]
  let S_rel : Set C₁.left :=
    {y : C₁.left | ¬ ∃ V : C₁.left.Opens,
      y ∈ V ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V.ι ≫ f₁.left)}
  have hClosedS : IsClosed S_rel := by
    have hEqS : S_rel = (⋃ (V : C₁.left.Opens)
        (_ : AlgebraicGeometry.SmoothOfRelativeDimension 1 (V.ι ≫ f₁.left)),
        (V : Set C₁.left))ᶜ := by
      ext y
      simp only [S_rel, Set.mem_compl_iff, Set.mem_iUnion, SetLike.mem_coe]
      exact ⟨fun h ⟨V, hSm, hy⟩ => h ⟨V, hy, hSm⟩, fun h ⟨V, hy, hSm⟩ => h ⟨V, hSm, hy⟩⟩
    rw [hEqS]
    exact (isOpen_iUnion fun V => isOpen_iUnion fun _ => V.isOpen).isClosed_compl
  obtain ⟨hEtDom, hPrimeFact⟩ := weil_etale_mvPolynomial_prime_factorization k
  have hSmCharts : ∀ x : C₁.left, x ∉ S_rel →
      ∃ (R' : CommRingCat.{u}) (v₀ : AlgebraicGeometry.Spec R')
        (e_X : AlgebraicGeometry.Spec R' ⟶ C₁.left)
        (ψ : MvPolynomial (Fin (m + 1)) k →+* ↑R')
        (I : Finset (Fin (m + 1))),
        AlgebraicGeometry.Etale e_X ∧
        AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) ∧
        e_X.base v₀ = x ∧
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = e_X ≫ C₁.hom) ∧
        (∀ i ∈ I, ψ (MvPolynomial.X i) ∈ v₀.asIdeal) ∧
        e_X.base ⁻¹' Z₁ =
          {v : AlgebraicGeometry.Spec R' | ∃ i ∈ I, ψ (MvPolynomial.X i) ∈ v.asIdeal} := by
    intro x hxNotMem
    have hxSm : ∃ V : C₁.left.Opens,
        x ∈ V ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V.ι ≫ f₁.left) :=
      Classical.not_not.mp hxNotMem
    exact weil_semistable_curve_smooth_and_section_nc_chart k m B₁ Z_B₁ r_B D_B ιD_B
      hClD_B hZB₁_eq hChartsB₁ C₁ f₁ n τ₁ hProp_f₁ hSec_τ₁ hDisj_τ₁ x hxSm
  have hTorCharts : ∀ x : C₁.left, x ∈ S_rel →
      ∃ (R' : CommRingCat.{u}) (v₀ : AlgebraicGeometry.Spec R')
        (e_X : AlgebraicGeometry.Spec R' ⟶ C₁.left)
        (a : Fin m → ℕ) (S_bdry : Finset (Fin m))
        (ρ : {c : Fin m // 1 ≤ a c} → Fin r_B)
        (q : AlgebraicGeometry.Spec R' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
          (MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ Ideal.span
            ({MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
              ∏ c : Fin m, MvPolynomial.X (Sum.inr c) ^ a c} :
              Set (MvPolynomial (Fin 2 ⊕ Fin m) k))))),
        IsRelativeToroidalChartAt k m B₁ r_B D_B ιD_B C₁ Z₁ f₁ S_rel x
          R' v₀ e_X a S_bdry ρ q := by
    intro x hxMem
    obtain ⟨R'_B, e_B, ψ_B, p_B, I₀, ρ₀, h, B', v', e_C, ψ_nodal, hDatum⟩ :=
      weil_semistable_curve_shrunk_nodal_snc_datum k m B₁ Z_B₁ U_B₁ r_B D_B ιD_B
        hClD_B hZB₁_eq hChartsB₁ hU_B₁_eq C₁ f₁ n τ₁ hCurve₁ x hxMem
    rcases hDatum with ⟨hEt_eB, hEt_ψB, hEt_eC, hEt_ψn, hCommB, hCommC, hv'x, hv'p,
      hInl, hI₀_mem, hh_mem, hInj_ρ₀, hSupp, hPreZ₁, hPreDB, hPreS⟩
    have : p_B.asIdeal.IsPrime := p_B.isPrime
    obtain ⟨a, s, u, hs, ha_pos, ha_sub, hu_eq⟩ :=
      hPrimeFact m (↑R'_B) ψ_B hEt_ψB p_B.asIdeal I₀ hI₀_mem h hh_mem hSupp
    have hDatum' : IsShrunkNodalSncDatumAt k m B₁ r_B D_B ιD_B C₁ Z₁ f₁ S_rel x
        R'_B e_B ψ_B p_B I₀ ρ₀ h B' v' e_C ψ_nodal :=
      ⟨hEt_eB, hEt_ψB, hEt_eC, hEt_ψn, hCommB, hCommC, hv'x, hv'p,
        hInl, hI₀_mem, hh_mem, hInj_ρ₀, hSupp, hPreZ₁, hPreDB, hPreS⟩
    obtain ⟨R', v₀, e_X, S_bdry, ρ, q, hRelChart⟩ :=
      weil_nodal_datum_to_relative_toroidal_chart k m hEtDom B₁ r_B D_B ιD_B C₁ Z₁ f₁ S_rel x
        R'_B e_B ψ_B p_B I₀ ρ₀ h B' v' e_C ψ_nodal hDatum' a s u hs ha_pos ha_sub hu_eq
    exact ⟨R', v₀, e_X, a, S_bdry, ρ, q, hRelChart⟩
  exact weil_relative_toroidal_components_and_state_assembly k m B₁ Z_B₁ r_B D_B ιD_B
    hClD_B hIntD_B hPairD_B hZB₁_eq hChartsB₁ C₁ Z₁ f₁ hClosedZ₁ hProjC₁ hSmOpen
    S_rel hClosedS hSmCharts hTorCharts

theorem weil_toroidal_rees_model_algebra (k : Type u) [Field k] (m : ℕ)
    (a : Fin m → ℕ) (c₀ : Fin m) (hc₀ : 2 ≤ a c₀)
    (B' : CommRingCat.{u})
    (ψ_q : (MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ Ideal.span
      {MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
        ∏ c : Fin m, MvPolynomial.X (Sum.inr c) ^ a c}) →+* B')
    (g : Fin 3 → B')
    (hEt : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_q)))
    (hg0 : g 0 = ψ_q (Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl 0))))
    (hg1 : g 1 = ψ_q (Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl 1))))
    (hg2 : g 2 = ψ_q (Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c₀)))) :
    (∀ b : Fin 3, g b ∈ nonZeroDivisors B') ∧
    (∀ b : Fin 2,
      ∃ (ψ'_b : MvPolynomial (Fin (m + 1)) k →+*
          ↥(Algebra.adjoin B' (Set.range fun j : Fin 3 =>
            IsLocalization.mk' (Localization.Away (g (Fin.castSucc b))) (g j)
              ⟨g (Fin.castSucc b), Submonoid.mem_powers (g (Fin.castSucc b))⟩))),
        AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ'_b)) ∧
        ψ'_b.comp MvPolynomial.C =
          (algebraMap B' _).comp (ψ_q.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)) ∧
        ψ'_b (MvPolynomial.X 0) = algebraMap B' _ (g (Fin.castSucc b)) ∧
        algebraMap B' _ (g 2) =
          ψ'_b (MvPolynomial.X 0) * ψ'_b (MvPolynomial.X (Fin.succ c₀)) ∧
        (∀ c : Fin m, c ≠ c₀ →
          ψ'_b (MvPolynomial.X (Fin.succ c)) =
            algebraMap B' _ (ψ_q (Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c)))))) ∧
    (∃ (q'_2 : AlgebraicGeometry.Spec (CommRingCat.of
          ↥(Algebra.adjoin B' (Set.range fun j : Fin 3 =>
            IsLocalization.mk' (Localization.Away (g 2)) (g j)
              ⟨g 2, Submonoid.mem_powers (g 2)⟩))) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of
          (MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ Ideal.span
            {MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
              ∏ c : Fin m, MvPolynomial.X (Sum.inr c) ^
                (Function.update a c₀ (a c₀ - 2) c)}))),
      AlgebraicGeometry.Etale q'_2 ∧
      (q'_2 ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B' _)) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_q) ≫
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C))) ∧
      (∀ w,
        (∀ i : Fin 2,
          g (Fin.castSucc i) ∈
            ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B' _))).base w).asIdeal) ↔
        (g 2 ∈ ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B' _))).base w).asIdeal ∨
          ∀ i : Fin 2,
            Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl i)) ∈ (q'_2.base w).asIdeal)) ∧
      (∀ (c : Fin m) (w),
        Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c)) ∈ (q'_2.base w).asIdeal ↔
          ψ_q (Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c))) ∈
            ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B' _))).base w).asIdeal) ∧
      (∀ c : Fin m, c ≠ c₀ → 1 ≤ a c →
        closure {w |
            (∀ i : Fin 2,
              Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl i)) ∈ (q'_2.base w).asIdeal) ∧
            Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c)) ∈ (q'_2.base w).asIdeal ∧
            Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c₀)) ∉ (q'_2.base w).asIdeal} =
          {w |
            (∀ i : Fin 2,
              Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl i)) ∈ (q'_2.base w).asIdeal) ∧
            Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c)) ∈ (q'_2.base w).asIdeal}) ∧
      (4 ≤ a c₀ →
        ∀ v : AlgebraicGeometry.Spec B',
          (∀ j : Fin 3, g j ∈ v.asIdeal) →
        ∃! w,
          (∀ i : Fin 2,
            Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl i)) ∈ (q'_2.base w).asIdeal) ∧
          Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c₀)) ∈ (q'_2.base w).asIdeal ∧
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B' _))).base w = v)) :=
by
  
  
  
  have hPillar1 : ∀ (a_exp : Fin m → ℕ),
      IsDomain (MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ Ideal.span
        ({MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
          ∏ c : Fin m, MvPolynomial.X (Sum.inr c) ^ a_exp c} :
          Set (MvPolynomial (Fin 2 ⊕ Fin m) k))) ∧
      (∀ s : Fin 2 ⊕ Fin m,
        (Ideal.Quotient.mk (Ideal.span
          ({MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
            ∏ c : Fin m, MvPolynomial.X (Sum.inr c) ^ a_exp c} :
            Set (MvPolynomial (Fin 2 ⊕ Fin m) k))) (MvPolynomial.X s)) ≠ 0) := by
    intro a_exp
    let F : MvPolynomial (Fin 2 ⊕ Fin m) k :=
      MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
        ∏ c : Fin m, MvPolynomial.X (Sum.inr c) ^ a_exp c
    let I_F : Ideal (MvPolynomial (Fin 2 ⊕ Fin m) k) :=
      Ideal.span ({F} : Set (MvPolynomial (Fin 2 ⊕ Fin m) k))
    have hVarNeZero : ∀ s : Fin 2 ⊕ Fin m, Ideal.Quotient.mk I_F (MvPolynomial.X s) ≠ 0 := by
      intro s hs0
      have hMem : MvPolynomial.X s ∈ I_F := Ideal.Quotient.eq_zero_iff_mem.mp hs0
      rw [Ideal.mem_span_singleton] at hMem
      rcases hMem with ⟨h, hh⟩
      let ev1 : MvPolynomial (Fin 2 ⊕ Fin m) k →ₐ[k] k := MvPolynomial.aeval (fun _ => (1 : k))
      have hevF : ev1 F = 0 := by simp [ev1, F]
      have hevX : ev1 (MvPolynomial.X s) = 1 := by simp [ev1]
      have h10 : (1 : k) = 0 := by rw [← hevX, hh, map_mul, hevF, zero_mul]
      exact one_ne_zero h10
    let P₀ : MvPolynomial (Fin m) k := ∏ c : Fin m, (MvPolynomial.X c : MvPolynomial (Fin m) k) ^ a_exp c
    have hP₀_ne : P₀ ≠ 0 :=
      Finset.prod_ne_zero_iff.mpr fun c _ => pow_ne_zero (a_exp c) (MvPolynomial.X_ne_zero c)
    let c_E : k →+* Polynomial (Polynomial (MvPolynomial (Fin m) k)) :=
      Polynomial.C.comp (Polynomial.C.comp MvPolynomial.C)
    let φ : MvPolynomial (Fin 2 ⊕ Fin m) k →+* Polynomial (Polynomial (MvPolynomial (Fin m) k)) :=
      MvPolynomial.eval₂Hom c_E (fun s : Fin 2 ⊕ Fin m =>
        match s with
        | Sum.inl i => if i = 0 then Polynomial.C Polynomial.X else Polynomial.X
        | Sum.inr c => Polynomial.C (Polynomial.C (MvPolynomial.X c)))
    let ψ_T : MvPolynomial (Fin m) k →+* MvPolynomial (Fin 2 ⊕ Fin m) k :=
      MvPolynomial.eval₂Hom MvPolynomial.C (fun c => MvPolynomial.X (Sum.inr c))
    let ψ_D : Polynomial (MvPolynomial (Fin m) k) →+* MvPolynomial (Fin 2 ⊕ Fin m) k :=
      Polynomial.eval₂RingHom ψ_T (MvPolynomial.X (Sum.inl 0))
    let ψ : Polynomial (Polynomial (MvPolynomial (Fin m) k)) →+* MvPolynomial (Fin 2 ⊕ Fin m) k :=
      Polynomial.eval₂RingHom ψ_D (MvPolynomial.X (Sum.inl 1))
    have h_ψφ : ψ.comp φ = RingHom.id (MvPolynomial (Fin 2 ⊕ Fin m) k) := by
      apply MvPolynomial.ringHom_ext'
      · apply RingHom.ext; intro r
        simp [φ, c_E, ψ, ψ_D, ψ_T]
      · intro s
        rcases s with i | c
        · fin_cases i <;> simp [φ, ψ, ψ_D, ψ_T]
        · simp [φ, ψ, ψ_D, ψ_T]
    have h_comp_T : φ.comp ψ_T = Polynomial.C.comp Polynomial.C := by
      apply MvPolynomial.ringHom_ext'
      · apply RingHom.ext; intro r
        simp [φ, c_E, ψ_T]
      · intro c
        simp [φ, ψ_T]
    have h_comp_D : φ.comp ψ_D = Polynomial.C := by
      apply Polynomial.ringHom_ext'
      · apply RingHom.ext; intro r
        simpa [ψ_D] using RingHom.congr_fun h_comp_T r
      · simp [φ, ψ_D]
    have h_φψ : φ.comp ψ = RingHom.id (Polynomial (Polynomial (MvPolynomial (Fin m) k))) := by
      apply Polynomial.ringHom_ext'
      · apply RingHom.ext; intro d
        simpa [ψ] using RingHom.congr_fun h_comp_D d
      · simp [φ, ψ]
    let e_PE : MvPolynomial (Fin 2 ⊕ Fin m) k ≃+*
        Polynomial (Polynomial (MvPolynomial (Fin m) k)) :=
      { toFun := φ
        invFun := ψ
        left_inv := fun x => RingHom.congr_fun h_ψφ x
        right_inv := fun y => RingHom.congr_fun h_φψ y
        map_mul' := φ.map_mul
        map_add' := φ.map_add }
    let q : Polynomial (Polynomial (MvPolynomial (Fin m) k)) :=
      Polynomial.C Polynomial.X * Polynomial.X - Polynomial.C (Polynomial.C P₀)
    have he_F : e_PE F = q := by
      change φ F = q
      dsimp only [F]
      simp only [map_sub, map_mul, map_prod, map_pow]
      simp [φ, P₀, q, map_prod, map_pow]
    have hq_c1 : q.coeff 1 = (Polynomial.X : Polynomial (MvPolynomial (Fin m) k)) := by
      simp [q]
    have hq_c0 : q.coeff 0 = -(Polynomial.C P₀ : Polynomial (MvPolynomial (Fin m) k)) := by
      simp [q]
    have hX_D_ne : (Polynomial.X : Polynomial (MvPolynomial (Fin m) k)) ≠ 0 :=
      Polynomial.X_ne_zero
    have hq_ne : q ≠ 0 := by
      intro h0; apply hX_D_ne; rw [← hq_c1, h0, Polynomial.coeff_zero]
    have hq_deg_le : q.natDegree ≤ 1 := by
      refine le_trans (Polynomial.natDegree_sub_le _ _) (max_le ?_ (by simp))
      exact le_trans (Polynomial.natDegree_C_mul_le _ _) Polynomial.natDegree_X_le
    have hq_deg : q.natDegree = 1 :=
      le_antisymm hq_deg_le (Polynomial.le_natDegree_of_ne_zero (by rw [hq_c1]; exact hX_D_ne))
    have hq_not_unit : ¬ IsUnit q := by
      rintro ⟨u, hu⟩
      have hu0 : (u : Polynomial (Polynomial (MvPolynomial (Fin m) k))) ≠ 0 := u.ne_zero
      have hiu0 : (↑u⁻¹ : Polynomial (Polynomial (MvPolynomial (Fin m) k))) ≠ 0 := u⁻¹.ne_zero
      have hmul := Polynomial.natDegree_mul hu0 hiu0
      have hu_deg : (u : Polynomial (Polynomial (MvPolynomial (Fin m) k))).natDegree = 1 := by
        rw [hu, hq_deg]
      rw [Units.mul_inv, Polynomial.natDegree_one, hu_deg] at hmul
      omega
    have hUnit_left : ∀ f₁ f₂ : Polynomial (Polynomial (MvPolynomial (Fin m) k)),
        q = f₁ * f₂ → f₁.natDegree = 0 → IsUnit f₁ := by
      intro f₁ f₂ hfg hf_deg
      have hf_eq : f₁ = Polynomial.C (f₁.coeff 0) := Polynomial.eq_C_of_natDegree_eq_zero hf_deg
      set d₀ : Polynomial (MvPolynomial (Fin m) k) := f₁.coeff 0
      have hc1 : (Polynomial.X : Polynomial (MvPolynomial (Fin m) k)) = d₀ * f₂.coeff 1 := by
        have := congrArg (fun p => p.coeff 1) hfg
        rwa [hq_c1, hf_eq, Polynomial.coeff_C_mul] at this
      have hc0 : -(Polynomial.C P₀ : Polynomial (MvPolynomial (Fin m) k)) = d₀ * f₂.coeff 0 := by
        have := congrArg (fun p => p.coeff 0) hfg
        rwa [hq_c0, hf_eq, Polynomial.coeff_C_mul] at this
      have hd₀_ne : d₀ ≠ 0 := fun h0 => hX_D_ne (by rw [hc1, h0, zero_mul])
      have hg1_ne : f₂.coeff 1 ≠ 0 := fun h0 => hX_D_ne (by rw [hc1, h0, mul_zero])
      have hdeg_D : d₀.natDegree + (f₂.coeff 1).natDegree = 1 := by
        rw [← Polynomial.natDegree_mul hd₀_ne hg1_ne, ← hc1, Polynomial.natDegree_X]
      by_cases hd₀_deg : d₀.natDegree = 0
      · have hd₀_C : d₀ = Polynomial.C (d₀.coeff 0) :=
          Polynomial.eq_C_of_natDegree_eq_zero hd₀_deg
        have h1_R : (1 : MvPolynomial (Fin m) k) = d₀.coeff 0 * (f₂.coeff 1).coeff 1 := by
          have := congrArg (fun p => p.coeff 1) hc1
          rwa [Polynomial.coeff_X_one, hd₀_C, Polynomial.coeff_C_mul] at this
        have h1_R' : (f₂.coeff 1).coeff 1 * d₀.coeff 0 = 1 := by
          rw [mul_comm]
          exact h1_R.symm
        have hu_R : IsUnit (d₀.coeff 0) :=
          ⟨⟨d₀.coeff 0, (f₂.coeff 1).coeff 1, h1_R.symm, h1_R'⟩, rfl⟩
        rw [hf_eq, hd₀_C]
        exact (hu_R.map Polynomial.C).map Polynomial.C
      · have hg1_deg : (f₂.coeff 1).natDegree = 0 := by omega
        have hg1_C : f₂.coeff 1 = Polynomial.C ((f₂.coeff 1).coeff 0) :=
          Polynomial.eq_C_of_natDegree_eq_zero hg1_deg
        have hr1_ne : (f₂.coeff 1).coeff 0 ≠ 0 :=
          fun h0 => hg1_ne (by rw [hg1_C, h0, map_zero])
        have hd₀_0 : d₀.coeff 0 = 0 := by
          have := congrArg (fun p => p.coeff 0) hc1
          rw [Polynomial.coeff_X_zero, hg1_C, mul_comm d₀, Polynomial.coeff_C_mul, mul_comm] at this
          exact (mul_eq_zero.mp this.symm).resolve_right hr1_ne
        have hP₀_zero : -P₀ = 0 := by
          have := congrArg (fun p => p.coeff 0) hc0
          rwa [Polynomial.coeff_neg, Polynomial.coeff_C_zero, Polynomial.mul_coeff_zero,
            hd₀_0, zero_mul] at this
        exact False.elim (hP₀_ne (neg_eq_zero.mp hP₀_zero))
    have hq_irred : Irreducible q := by
      refine ⟨hq_not_unit, fun f₁ f₂ hfg => ?_⟩
      have hf0 : f₁ ≠ 0 := fun h => hq_ne (by rw [hfg, h, zero_mul])
      have hg0 : f₂ ≠ 0 := fun h => hq_ne (by rw [hfg, h, mul_zero])
      have hsum : f₁.natDegree + f₂.natDegree = 1 := by
        rw [← Polynomial.natDegree_mul hf0 hg0, ← hfg, hq_deg]
      by_cases hf_deg : f₁.natDegree = 0
      · exact Or.inl (hUnit_left f₁ f₂ hfg hf_deg)
      · have hg_deg : f₂.natDegree = 0 := by omega
        exact Or.inr (hUnit_left f₂ f₁ (hfg.trans (mul_comm f₁ f₂)) hg_deg)
    have hq_prime : Prime q := UniqueFactorizationMonoid.irreducible_iff_prime.mp hq_irred
    have hF_prime : Prime F := by
      refine ⟨?_, ?_, ?_⟩
      · intro h0
        exact hq_prime.ne_zero (by rw [← he_F, h0, map_zero])
      · intro hu
        exact hq_prime.not_isUnit (by rw [← he_F]; exact hu.map e_PE.toRingHom)
      · rintro a₁ b₁ ⟨c₁, hc₁⟩
        have hdvd : q ∣ e_PE a₁ * e_PE b₁ := by
          refine ⟨e_PE c₁, ?_⟩
          rw [← he_F, ← map_mul, ← map_mul, hc₁]
        rcases hq_prime.dvd_or_dvd hdvd with ⟨u₁, hu₁⟩ | ⟨u₁, hu₁⟩
        · left
          refine ⟨e_PE.symm u₁, ?_⟩
          apply e_PE.injective
          rw [map_mul, he_F, e_PE.apply_symm_apply, hu₁]
        · right
          refine ⟨e_PE.symm u₁, ?_⟩
          apply e_PE.injective
          rw [map_mul, he_F, e_PE.apply_symm_apply, hu₁]
    have : I_F.IsPrime := (Ideal.span_singleton_prime hF_prime.ne_zero).mpr hF_prime
    exact ⟨Ideal.Quotient.isDomain I_F, hVarNeZero⟩

  
  
  
  have hPillar2 : ∀ (M_r B_r : Type u) [CommRing M_r] [CommRing B_r]
      (ψ : M_r →+* B_r) (_ : RingHom.Etale ψ)
      (m_gen : Fin 3 → M_r) (g_gen : Fin 3 → B_r) (_ : ∀ j : Fin 3, g_gen j = ψ (m_gen j))
      (b : Fin 3)
      (L_M L_B : Type u) [CommRing L_M] [CommRing L_B]
      [Algebra M_r L_M] [Algebra B_r L_B]
      [IsLocalization.Away (m_gen b) L_M] [IsLocalization.Away (g_gen b) L_B],
      ∃ (ι_b : ↥(Algebra.adjoin M_r (Set.range fun j : Fin 3 =>
            IsLocalization.mk' L_M (m_gen j) ⟨m_gen b, Submonoid.mem_powers (m_gen b)⟩)) →+*
          ↥(Algebra.adjoin B_r (Set.range fun j : Fin 3 =>
            IsLocalization.mk' L_B (g_gen j) ⟨g_gen b, Submonoid.mem_powers (g_gen b)⟩))),
        RingHom.Etale ι_b ∧
        ι_b.comp (algebraMap M_r _) = (algebraMap B_r _).comp ψ ∧
        (∀ j : Fin 3,
          ι_b ⟨IsLocalization.mk' L_M (m_gen j) ⟨m_gen b, Submonoid.mem_powers (m_gen b)⟩,
              Algebra.subset_adjoin ⟨j, rfl⟩⟩ =
            ⟨IsLocalization.mk' L_B (g_gen j) ⟨g_gen b, Submonoid.mem_powers (g_gen b)⟩,
              Algebra.subset_adjoin ⟨j, rfl⟩⟩) ∧
        (∀ (Q : Type u) [CommRing Q] (π_B : B_r →+* Q)
            (β : ↥(Algebra.adjoin M_r (Set.range fun j : Fin 3 =>
              IsLocalization.mk' L_M (m_gen j) ⟨m_gen b, Submonoid.mem_powers (m_gen b)⟩)) →+* Q),
          π_B.comp ψ = β.comp (algebraMap M_r _) →
          ∃ (G : ↥(Algebra.adjoin B_r (Set.range fun j : Fin 3 =>
              IsLocalization.mk' L_B (g_gen j) ⟨g_gen b, Submonoid.mem_powers (g_gen b)⟩)) →+* Q),
            G.comp (algebraMap B_r _) = π_B ∧ G.comp ι_b = β) := by
    intro M_r B_r _ _ ψ hEt_ψ m_gen g_gen hg_eq b L_M L_B _ _ _ _ _ _
    let _ : Algebra M_r B_r := ψ.toAlgebra
    have : Algebra.Etale M_r B_r := RingHom.Etale.toAlgebra hEt_ψ
    have : Module.Flat M_r B_r := inferInstance
    let r_M : Fin 3 → L_M := fun j =>
      IsLocalization.mk' L_M (m_gen j) ⟨m_gen b, Submonoid.mem_powers (m_gen b)⟩
    let r_B : Fin 3 → L_B := fun j =>
      IsLocalization.mk' L_B (g_gen j) ⟨g_gen b, Submonoid.mem_powers (g_gen b)⟩
    let A_M : Subalgebra M_r L_M := Algebra.adjoin M_r (Set.range r_M)
    let A_B : Subalgebra B_r L_B := Algebra.adjoin B_r (Set.range r_B)
    have hu_gB : IsUnit (algebraMap B_r L_B (g_gen b)) :=
      IsLocalization.Away.algebraMap_isUnit (g_gen b)
    have hu_ψm : IsUnit (((algebraMap B_r L_B).comp ψ) (m_gen b)) := by
      change IsUnit (algebraMap B_r L_B (ψ (m_gen b)))
      rw [← hg_eq b]
      exact hu_gB
    let μ_loc : L_M →+* L_B := IsLocalization.Away.lift (m_gen b) hu_ψm
    have hμ_alg : ∀ x : M_r, μ_loc (algebraMap M_r L_M x) = algebraMap B_r L_B (ψ x) :=
      fun x => IsLocalization.Away.lift_eq (m_gen b) hu_ψm x
    have hμ_r : ∀ j : Fin 3, μ_loc (r_M j) = r_B j := by
      intro j
      apply hu_gB.mul_left_cancel
      have h1 := congrArg μ_loc
        (IsLocalization.mk'_spec' L_M (m_gen j) ⟨m_gen b, Submonoid.mem_powers (m_gen b)⟩)
      rw [map_mul, hμ_alg, hμ_alg, ← hg_eq b, ← hg_eq j] at h1
      exact h1.trans
        (IsLocalization.mk'_spec' L_B (g_gen j) ⟨g_gen b, Submonoid.mem_powers (g_gen b)⟩).symm
    have hμ_mem : ∀ x : L_M, x ∈ A_M → μ_loc x ∈ A_B := by
      intro x hx
      refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hx
      · rintro _ ⟨j, rfl⟩
        rw [hμ_r j]
        exact Algebra.subset_adjoin ⟨j, rfl⟩
      · intro x₀
        rw [hμ_alg x₀]
        exact A_B.algebraMap_mem (ψ x₀)
      · intro x₁ x₂ _ _ hx₁ hx₂
        rw [map_add]
        exact A_B.add_mem hx₁ hx₂
      · intro x₁ x₂ _ _ hx₁ hx₂
        rw [map_mul]
        exact A_B.mul_mem hx₁ hx₂
    let ι_b : ↥A_M →+* ↥A_B :=
      { toFun := fun x => ⟨μ_loc x.1, hμ_mem x.1 x.2⟩
        map_one' := Subtype.ext (map_one μ_loc)
        map_mul' := fun x y => Subtype.ext (map_mul μ_loc x.1 y.1)
        map_zero' := Subtype.ext (map_zero μ_loc)
        map_add' := fun x y => Subtype.ext (map_add μ_loc x.1 y.1) }
    have hι_comp : ι_b.comp (algebraMap M_r ↥A_M) = (algebraMap B_r ↥A_B).comp ψ := by
      apply RingHom.ext; intro x
      exact Subtype.ext (hμ_alg x)
    have hι_gen : ∀ j : Fin 3,
        ι_b ⟨r_M j, Algebra.subset_adjoin ⟨j, rfl⟩⟩ =
          ⟨r_B j, Algebra.subset_adjoin ⟨j, rfl⟩⟩ :=
      fun j => Subtype.ext (hμ_r j)
    let _ : Algebra M_r ↥A_B := ((algebraMap B_r ↥A_B).comp ψ).toAlgebra
    let α_B : B_r →ₐ[M_r] ↥A_B :=
      { toRingHom := algebraMap B_r ↥A_B
        commutes' := fun _ => rfl }
    let α_A : ↥A_M →ₐ[M_r] ↥A_B :=
      { toRingHom := ι_b
        commutes' := fun x => RingHom.congr_fun hι_comp x }
    let Φ_push : TensorProduct M_r B_r ↥A_M →+* ↥A_B :=
      (Algebra.TensorProduct.lift α_B α_A (fun _ _ => mul_comm _ _)).toRingHom
    have hΦ_tmul : ∀ (b₀ : B_r) (x : ↥A_M),
        Φ_push (TensorProduct.tmul M_r b₀ x) = algebraMap B_r ↥A_B b₀ * ι_b x :=
      fun _ _ => rfl
    have hLocTensor : IsLocalization.Away (g_gen b) (TensorProduct M_r B_r L_M) := by
      have hT : IsLocalization.Away (algebraMap M_r B_r (m_gen b)) (TensorProduct M_r B_r L_M) :=
        IsLocalization.Away.tensor (m_gen b) L_M
      change IsLocalization (Submonoid.powers (ψ (m_gen b))) (TensorProduct M_r B_r L_M) at hT
      rwa [← hg_eq b] at hT
    let E_loc : TensorProduct M_r B_r L_M ≃ₐ[B_r] L_B :=
      IsLocalization.algEquiv (Submonoid.powers (g_gen b)) (TensorProduct M_r B_r L_M) L_B
    have hE_right : ∀ z : L_M, E_loc (TensorProduct.tmul M_r (1 : B_r) z) = μ_loc z := by
      intro z
      let ν : L_M →+* L_B := E_loc.toRingHom.comp Algebra.TensorProduct.includeRight.toRingHom
      have hν_eq : ν = μ_loc := by
        apply IsLocalization.ringHom_ext (Submonoid.powers (m_gen b))
        apply RingHom.ext; intro x
        change E_loc (TensorProduct.tmul M_r (1 : B_r) (algebraMap M_r L_M x)) =
          μ_loc (algebraMap M_r L_M x)
        have htm : TensorProduct.tmul M_r (1 : B_r) (algebraMap M_r L_M x) =
            algebraMap B_r (TensorProduct M_r B_r L_M) (ψ x) := by
          rw [Algebra.algebraMap_eq_smul_one x, ← TensorProduct.smul_tmul]
          change TensorProduct.tmul M_r (ψ x * 1) (1 : L_M) =
            TensorProduct.tmul M_r (ψ x) (1 : L_M)
          rw [mul_one]
        rw [htm, E_loc.commutes, hμ_alg]
      exact RingHom.congr_fun hν_eq z
    let f_lin : TensorProduct M_r B_r ↥A_M →ₗ[M_r] TensorProduct M_r B_r L_M :=
      LinearMap.lTensor B_r A_M.toSubmodule.subtype
    have hf_lin_inj : Function.Injective f_lin :=
      Module.Flat.lTensor_preserves_injective_linearMap A_M.toSubmodule.subtype Subtype.val_injective
    have hΦ_eq_Eloc : ∀ t : TensorProduct M_r B_r ↥A_M, (Φ_push t).1 = E_loc (f_lin t) := by
      intro t
      refine TensorProduct.induction_on (motive := fun t => (Φ_push t).1 = E_loc (f_lin t)) t ?_ ?_ ?_
      · simp
      · intro b₀ x
        rw [hΦ_tmul]
        change algebraMap B_r L_B b₀ * μ_loc x.1 = E_loc (TensorProduct.tmul M_r b₀ x.1)
        have hsplit : TensorProduct.tmul M_r b₀ x.1 =
            algebraMap B_r (TensorProduct M_r B_r L_M) b₀ * TensorProduct.tmul M_r (1 : B_r) x.1 := by
          change TensorProduct.tmul M_r b₀ x.1 =
            TensorProduct.tmul M_r b₀ (1 : L_M) * TensorProduct.tmul M_r (1 : B_r) x.1
          rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
        rw [hsplit, map_mul, E_loc.commutes, hE_right]
      · intro t₁ t₂ ih₁ ih₂
        rw [map_add, Subalgebra.coe_add, ih₁, ih₂, map_add, map_add]
    have hΦ_inj : Function.Injective Φ_push := by
      intro t₁ t₂ hEq
      apply hf_lin_inj
      apply E_loc.injective
      rw [← hΦ_eq_Eloc t₁, ← hΦ_eq_Eloc t₂, hEq]
    have hΦ_surj : Function.Surjective Φ_push := by
      rintro ⟨z, hz⟩
      suffices z ∈ (A_B.val.toRingHom.comp Φ_push).range by
        rcases this with ⟨t, ht⟩
        exact ⟨t, Subtype.ext ht⟩
      refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hz
      · rintro _ ⟨j, rfl⟩
        refine ⟨TensorProduct.tmul M_r (1 : B_r) ⟨r_M j, Algebra.subset_adjoin ⟨j, rfl⟩⟩, ?_⟩
        change (Φ_push (TensorProduct.tmul M_r (1 : B_r) ⟨r_M j, _⟩)).1 = r_B j
        rw [hΦ_tmul, map_one, one_mul, hι_gen]
      · intro b₀
        refine ⟨TensorProduct.tmul M_r b₀ 1, ?_⟩
        change (Φ_push (TensorProduct.tmul M_r b₀ 1)).1 = algebraMap B_r L_B b₀
        rw [hΦ_tmul, map_one, mul_one]
        rfl
      · intro z₁ z₂ _ _ hz₁ hz₂
        exact Subring.add_mem _ hz₁ hz₂
      · intro z₁ z₂ _ _ hz₁ hz₂
        exact Subring.mul_mem _ hz₁ hz₂
    let Θ_b : TensorProduct M_r B_r ↥A_M ≃+* ↥A_B :=
      RingEquiv.ofBijective Φ_push ⟨hΦ_inj, hΦ_surj⟩
    have hΘ_tmul : ∀ (b₀ : B_r) (x : ↥A_M),
        Θ_b (TensorProduct.tmul M_r b₀ x) = algebraMap B_r ↥A_B b₀ * ι_b x :=
      hΦ_tmul
    have hEt_ι : RingHom.Etale ι_b := by
      have : Algebra.Etale ↥A_M (TensorProduct M_r ↥A_M B_r) :=
        Algebra.Etale.baseChange M_r B_r ↥A_M
      have hEt_alg : RingHom.Etale (algebraMap ↥A_M (TensorProduct M_r ↥A_M B_r)) :=
        RingHom.etale_algebraMap.mpr inferInstance
      let e_tot : TensorProduct M_r ↥A_M B_r ≃+* ↥A_B :=
        (Algebra.TensorProduct.comm M_r ↥A_M B_r).toRingEquiv.trans Θ_b
      have hEt_etot : RingHom.Etale e_tot.toRingHom :=
        RingHom.Etale.of_bijective e_tot.bijective
      have hComp : e_tot.toRingHom.comp (algebraMap ↥A_M (TensorProduct M_r ↥A_M B_r)) = ι_b := by
        apply RingHom.ext; intro x
        change Θ_b ((Algebra.TensorProduct.comm M_r ↥A_M B_r) (TensorProduct.tmul M_r x (1 : B_r))) = ι_b x
        rw [Algebra.TensorProduct.comm_tmul, hΘ_tmul, map_one, one_mul]
      rw [← hComp]
      exact RingHom.Etale.stableUnderComposition _ _ hEt_alg hEt_etot
    refine ⟨ι_b, hEt_ι, hι_comp, hι_gen, ?_⟩
    intro Q _ π_B β hCompat
    let _ : Algebra M_r Q := (π_B.comp ψ).toAlgebra
    let π_B_alg : B_r →ₐ[M_r] Q :=
      { toRingHom := π_B
        commutes' := fun _ => rfl }
    let β_alg : ↥A_M →ₐ[M_r] Q :=
      { toRingHom := β
        commutes' := fun x => (RingHom.congr_fun hCompat x).symm }
    let G_tp : TensorProduct M_r B_r ↥A_M →+* Q :=
      (Algebra.TensorProduct.lift π_B_alg β_alg (fun _ _ => mul_comm _ _)).toRingHom
    let G : ↥A_B →+* Q := G_tp.comp Θ_b.symm.toRingHom
    refine ⟨G, ?_, ?_⟩
    · apply RingHom.ext; intro b₀
      have hsymm : Θ_b.symm (algebraMap B_r ↥A_B b₀) = TensorProduct.tmul M_r b₀ 1 := by
        apply Θ_b.injective
        rw [Θ_b.apply_symm_apply, hΘ_tmul, map_one, mul_one]
      change G_tp (Θ_b.symm (algebraMap B_r ↥A_B b₀)) = π_B b₀
      rw [hsymm]
      change π_B b₀ * β 1 = π_B b₀
      rw [map_one, mul_one]
    · apply RingHom.ext; intro x
      have hsymm : Θ_b.symm (ι_b x) = TensorProduct.tmul M_r (1 : B_r) x := by
        apply Θ_b.injective
        rw [Θ_b.apply_symm_apply, hΘ_tmul, map_one, one_mul]
      change G_tp (Θ_b.symm (ι_b x)) = β x
      rw [hsymm]
      change π_B 1 * β x = β x
      rw [map_one, one_mul]

  
  
  
  let I_M : Ideal (MvPolynomial (Fin 2 ⊕ Fin m) k) := Ideal.span
    ({MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
      ∏ c : Fin m, MvPolynomial.X (Sum.inr c) ^ a c} : Set (MvPolynomial (Fin 2 ⊕ Fin m) k))
  let M := MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ I_M
  let m_gen : Fin 3 → M :=
    ![Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inl 0)),
      Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inl 1)),
      Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inr c₀))]
  have hg_eq : ∀ j : Fin 3, g j = ψ_q (m_gen j) := by
    intro j
    fin_cases j
    · exact hg0
    · exact hg1
    · exact hg2
  have hEt_ψq : RingHom.Etale ψ_q :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)
      (Q := @RingHom.Etale) (φ := CommRingCat.ofHom ψ_q)).mp hEt
  have hConj1 : ∀ b : Fin 3, g b ∈ nonZeroDivisors B' := by
    obtain ⟨hDomM, hVarM⟩ := hPillar1 a
    have : IsDomain M := hDomM
    let _ : Algebra M B' := ψ_q.toAlgebra
    have : Algebra.Etale M B' := RingHom.Etale.toAlgebra hEt_ψq
    have : Module.Flat M B' := inferInstance
    intro b
    have hm_ne : m_gen b ≠ 0 := by
      fin_cases b
      · exact hVarM (Sum.inl 0)
      · exact hVarM (Sum.inl 1)
      · exact hVarM (Sum.inr c₀)
    have hm_nzd : m_gen b ∈ nonZeroDivisors M := mem_nonZeroDivisors_of_ne_zero hm_ne
    have hReg : IsSMulRegular B' (m_gen b) :=
      Module.Flat.isSMulRegular_of_nonZeroDivisors hm_nzd
    rw [mem_nonZeroDivisors_iff_right]
    intro x hx
    apply hReg
    dsimp only
    rw [smul_zero]
    change ψ_q (m_gen b) * x = 0
    rw [← hg_eq b, mul_comm]
    exact hx

  have hRelM : Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inl 0)) *
      Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inl 1)) =
      ∏ c : Fin m, Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inr c)) ^ a c := by
    have h0 : Ideal.Quotient.mk I_M
        (MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
          ∏ c : Fin m, MvPolynomial.X (Sum.inr c) ^ a c) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
    simp only [map_sub, map_mul, map_prod, map_pow] at h0
    exact sub_eq_zero.mp h0

  
  
  
  have hPillar3 : ∀ (b : Fin 2)
      (L_u L_poly : Type u) [CommRing L_u] [CommRing L_poly]
      [Algebra k L_u] [Algebra M L_u] [IsScalarTower k M L_u]
      [IsLocalization.Away (m_gen (Fin.castSucc b)) L_u]
      [Algebra (MvPolynomial (Fin (m + 1)) k) L_poly]
      [IsLocalization.Away (MvPolynomial.X 0 : MvPolynomial (Fin (m + 1)) k) L_poly],
      ∃ (Φ_b : MvPolynomial (Fin (m + 1)) k ≃ₐ[k]
          ↥(Algebra.adjoin M (Set.range fun j : Fin 3 =>
            IsLocalization.mk' L_u (m_gen j)
              ⟨m_gen (Fin.castSucc b), Submonoid.mem_powers (m_gen (Fin.castSucc b))⟩))),
        Φ_b (MvPolynomial.X 0) = algebraMap M _ (m_gen (Fin.castSucc b)) ∧
        algebraMap M _ (m_gen 2) = Φ_b (MvPolynomial.X 0) * Φ_b (MvPolynomial.X (Fin.succ c₀)) ∧
        (∀ c : Fin m, c ≠ c₀ →
          Φ_b (MvPolynomial.X (Fin.succ c)) =
            algebraMap M _ (Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inr c)))) := by
    intro b L_u L_poly _ _ _ _ _ _ _ _
    let m_u : M := m_gen (Fin.castSucc b)
    let b' : Fin 2 := Fin.cases 1 (fun _ => 0) b
    let t_M : Fin m → M := fun c => Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inr c))
    let ι_u : M →+* L_u := algebraMap M L_u
    let r_u : Fin 3 → L_u := fun j =>
      IsLocalization.mk' L_u (m_gen j) ⟨m_u, Submonoid.mem_powers m_u⟩
    let A_u : Subalgebra M L_u := Algebra.adjoin M (Set.range r_u)
    have hu_u : IsUnit (ι_u m_u) := IsLocalization.Away.algebraMap_isUnit m_u
    have hr_spec : ∀ j : Fin 3, ι_u m_u * r_u j = ι_u (m_gen j) :=
      fun j => IsLocalization.mk'_spec' L_u (m_gen j) ⟨m_u, Submonoid.mem_powers m_u⟩
    have h_uv : m_u * m_gen (Fin.castSucc b') = ∏ c : Fin m, t_M c ^ a c := by
      fin_cases b
      · exact hRelM
      · change m_gen 1 * m_gen 0 = _
        rw [mul_comm]
        exact hRelM
    let val_sub : Fin (m + 1) → ↥A_u :=
      Fin.cases (algebraMap M ↥A_u m_u) fun c =>
        if c = c₀ then ⟨r_u 2, Algebra.subset_adjoin ⟨2, rfl⟩⟩
        else algebraMap M ↥A_u (t_M c)
    let Φ_hom : MvPolynomial (Fin (m + 1)) k →ₐ[k] ↥A_u := MvPolynomial.aeval val_sub
    let tilde_Φ : MvPolynomial (Fin (m + 1)) k →+* L_u := A_u.val.toRingHom.comp Φ_hom.toRingHom
    have hΦ_X0 : Φ_hom (MvPolynomial.X 0) = algebraMap M ↥A_u m_u := by
      simp [Φ_hom, val_sub]
    have hΦ_Xc₀ : Φ_hom (MvPolynomial.X (Fin.succ c₀)) = ⟨r_u 2, Algebra.subset_adjoin ⟨2, rfl⟩⟩ := by
      simp [Φ_hom, val_sub]
    have hΦ_Xc : ∀ c : Fin m, c ≠ c₀ →
        Φ_hom (MvPolynomial.X (Fin.succ c)) = algebraMap M ↥A_u (t_M c) := by
      intro c hcc₀
      simp [Φ_hom, val_sub, hcc₀]
    have hΦ_g2 : algebraMap M ↥A_u (m_gen 2) =
        Φ_hom (MvPolynomial.X 0) * Φ_hom (MvPolynomial.X (Fin.succ c₀)) := by
      rw [hΦ_X0, hΦ_Xc₀]
      exact Subtype.ext (hr_spec 2).symm
    let Q_oth : MvPolynomial (Fin (m + 1)) k :=
      MvPolynomial.X 0 ^ (a c₀ - 2) * MvPolynomial.X (Fin.succ c₀) ^ a c₀ *
        ∏ c ∈ Finset.univ.erase c₀, MvPolynomial.X (Fin.succ c) ^ a c
    have htilde_Q : tilde_Φ Q_oth = r_u (Fin.castSucc b') := by
      have hval_Q : tilde_Φ Q_oth =
          ι_u m_u ^ (a c₀ - 2) * r_u 2 ^ a c₀ *
            ∏ c ∈ Finset.univ.erase c₀, ι_u (t_M c) ^ a c := by
        simp only [Q_oth, map_mul, map_pow, map_prod]
        have h0 : tilde_Φ (MvPolynomial.X 0) = ι_u m_u := congrArg Subtype.val hΦ_X0
        have hc0 : tilde_Φ (MvPolynomial.X (Fin.succ c₀)) = r_u 2 := congrArg Subtype.val hΦ_Xc₀
        rw [h0, hc0]
        congr 1
        refine Finset.prod_congr rfl fun c hc => ?_
        have hne : c ≠ c₀ := Finset.ne_of_mem_erase hc
        have hcc : tilde_Φ (MvPolynomial.X (Fin.succ c)) = ι_u (t_M c) :=
          congrArg Subtype.val (hΦ_Xc c hne)
        rw [hcc]
      apply (hu_u.pow 2).mul_left_cancel
      have hpow : ι_u m_u ^ a c₀ = ι_u m_u ^ 2 * ι_u m_u ^ (a c₀ - 2) := by
        rw [← pow_add]; congr 1; omega
      have hrhs : ι_u m_u ^ 2 * r_u (Fin.castSucc b') =
          ∏ c : Fin m, ι_u (t_M c) ^ a c := by
        calc
          ι_u m_u ^ 2 * r_u (Fin.castSucc b')
            = ι_u m_u * (ι_u m_u * r_u (Fin.castSucc b')) := by ring
          _ = ι_u m_u * ι_u (m_gen (Fin.castSucc b')) := by rw [hr_spec]
          _ = ι_u (m_u * m_gen (Fin.castSucc b')) := (map_mul ι_u _ _).symm
          _ = ι_u (∏ c : Fin m, t_M c ^ a c) := by rw [h_uv]
          _ = ∏ c : Fin m, ι_u (t_M c) ^ a c := by simp [map_prod, map_pow]
      rw [hrhs, ← Finset.mul_prod_erase Finset.univ (fun c => ι_u (t_M c) ^ a c) (Finset.mem_univ c₀)]
      have ht_c₀ : ι_u (t_M c₀) = ι_u m_u * r_u 2 := (hr_spec 2).symm
      rw [ht_c₀, mul_pow, hpow, hval_Q]
      ring
    have hM_in_range : ∀ y : M, ι_u y ∈ tilde_Φ.range := by
      intro y
      rcases Ideal.Quotient.mk_surjective y with ⟨p, rfl⟩
      refine MvPolynomial.induction_on
        (motive := fun p => ι_u (Ideal.Quotient.mk I_M p) ∈ tilde_Φ.range) p ?_ ?_ ?_
      · intro r
        refine ⟨MvPolynomial.C r, ?_⟩
        change (Φ_hom (algebraMap k _ r)).1 = ι_u (Ideal.Quotient.mk I_M (MvPolynomial.C r))
        rw [Φ_hom.commutes, IsScalarTower.algebraMap_apply k M ↥A_u r]
        rfl
      · intro p₁ p₂ ih₁ ih₂
        simp only [map_add]
        exact tilde_Φ.range.add_mem ih₁ ih₂
      · intro p₁ s ih
        simp only [map_mul]
        refine tilde_Φ.range.mul_mem ih ?_
        rcases s with i | c
        · fin_cases b <;> fin_cases i
          · exact ⟨MvPolynomial.X 0, congrArg Subtype.val hΦ_X0⟩
          · refine ⟨MvPolynomial.X 0 * Q_oth, ?_⟩
            rw [map_mul, show tilde_Φ (MvPolynomial.X 0) = ι_u m_u from congrArg Subtype.val hΦ_X0,
              htilde_Q]
            exact hr_spec (Fin.castSucc b')
          · refine ⟨MvPolynomial.X 0 * Q_oth, ?_⟩
            rw [map_mul, show tilde_Φ (MvPolynomial.X 0) = ι_u m_u from congrArg Subtype.val hΦ_X0,
              htilde_Q]
            exact hr_spec (Fin.castSucc b')
          · exact ⟨MvPolynomial.X 0, congrArg Subtype.val hΦ_X0⟩
        · by_cases hcc₀ : c = c₀
          · subst hcc₀
            refine ⟨MvPolynomial.X 0 * MvPolynomial.X (Fin.succ c), ?_⟩
            rw [map_mul, show tilde_Φ (MvPolynomial.X 0) = ι_u m_u from congrArg Subtype.val hΦ_X0,
              show tilde_Φ (MvPolynomial.X (Fin.succ c)) = r_u 2 from congrArg Subtype.val hΦ_Xc₀]
            exact hr_spec 2
          · exact ⟨MvPolynomial.X (Fin.succ c), congrArg Subtype.val (hΦ_Xc c hcc₀)⟩
    have hΦ_surj : Function.Surjective Φ_hom := by
      rintro ⟨z, hz⟩
      suffices z ∈ tilde_Φ.range by
        rcases this with ⟨p, hp⟩
        exact ⟨p, Subtype.ext hp⟩
      refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hz
      · rintro _ ⟨j, rfl⟩
        fin_cases b <;> fin_cases j
        · refine ⟨1, ?_⟩
          rw [map_one]
          exact (IsLocalization.mk'_self' L_u (x := ⟨m_u, Submonoid.mem_powers m_u⟩)).symm
        · exact ⟨Q_oth, htilde_Q⟩
        · exact ⟨MvPolynomial.X (Fin.succ c₀), congrArg Subtype.val hΦ_Xc₀⟩
        · exact ⟨Q_oth, htilde_Q⟩
        · refine ⟨1, ?_⟩
          rw [map_one]
          exact (IsLocalization.mk'_self' L_u (x := ⟨m_u, Submonoid.mem_powers m_u⟩)).symm
        · exact ⟨MvPolynomial.X (Fin.succ c₀), congrArg Subtype.val hΦ_Xc₀⟩
      · intro y
        exact hM_in_range y
      · intro z₁ z₂ _ _ hz₁ hz₂
        exact tilde_Φ.range.add_mem hz₁ hz₂
      · intro z₁ z₂ _ _ hz₁ hz₂
        exact tilde_Φ.range.mul_mem hz₁ hz₂
    
    let η : MvPolynomial (Fin (m + 1)) k →+* L_poly := algebraMap _ L_poly
    have hη_inj : Function.Injective η := by
      apply IsLocalization.injective L_poly (M := Submonoid.powers (MvPolynomial.X 0))
      rw [Submonoid.powers_le]
      exact mem_nonZeroDivisors_of_ne_zero (MvPolynomial.X_ne_zero 0)
    let ψ_raw : MvPolynomial (Fin 2 ⊕ Fin m) k →+* MvPolynomial (Fin (m + 1)) k :=
      MvPolynomial.eval₂Hom MvPolynomial.C fun s =>
        match s with
        | Sum.inl i => if i = b then MvPolynomial.X 0 else MvPolynomial.X 0 * Q_oth
        | Sum.inr c =>
            if c = c₀ then MvPolynomial.X 0 * MvPolynomial.X (Fin.succ c₀)
            else MvPolynomial.X (Fin.succ c)
    have hψ_raw_rel : ∀ f ∈ I_M, ψ_raw f = 0 := by
      intro f hf
      rw [Ideal.mem_span_singleton] at hf
      rcases hf with ⟨h, rfl⟩
      rw [map_mul]
      suffices ψ_raw (MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1)) =
          ψ_raw (∏ c : Fin m, MvPolynomial.X (Sum.inr c) ^ a c) by
        rw [map_sub, this, sub_self, zero_mul]
      have hlhs : ψ_raw (MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1)) =
          MvPolynomial.X 0 ^ 2 * Q_oth := by
        fin_cases b <;> simp [ψ_raw] <;> ring
      have hrhs : ψ_raw (∏ c : Fin m, MvPolynomial.X (Sum.inr c) ^ a c) =
          MvPolynomial.X 0 ^ 2 * Q_oth := by
        simp only [map_prod, map_pow]
        rw [← Finset.mul_prod_erase Finset.univ (fun c => ψ_raw (MvPolynomial.X (Sum.inr c)) ^ a c)
          (Finset.mem_univ c₀)]
        have hc₀_val : ψ_raw (MvPolynomial.X (Sum.inr c₀)) =
            MvPolynomial.X 0 * MvPolynomial.X (Fin.succ c₀) := by
          simp [ψ_raw]
        have herase : (∏ c ∈ Finset.univ.erase c₀, ψ_raw (MvPolynomial.X (Sum.inr c)) ^ a c) =
            ∏ c ∈ Finset.univ.erase c₀, MvPolynomial.X (Fin.succ c) ^ a c := by
          refine Finset.prod_congr rfl fun c hc => ?_
          have hne : c ≠ c₀ := Finset.ne_of_mem_erase hc
          simp [ψ_raw, hne]
        have hpowX0 : (MvPolynomial.X 0 : MvPolynomial (Fin (m + 1)) k) ^ a c₀ =
            MvPolynomial.X 0 ^ 2 * MvPolynomial.X 0 ^ (a c₀ - 2) := by
          rw [← pow_add]; congr 1; omega
        rw [hc₀_val, herase, mul_pow, hpowX0]
        dsimp only [Q_oth]
        ring
      rw [hlhs, hrhs]
    let ψ_bar : M →+* MvPolynomial (Fin (m + 1)) k := Ideal.Quotient.lift I_M ψ_raw hψ_raw_rel
    have hψ_bar_mk : ∀ p, ψ_bar (Ideal.Quotient.mk I_M p) = ψ_raw p := fun _ => rfl
    have hψ_bar_mu : ψ_bar m_u = MvPolynomial.X 0 := by
      fin_cases b <;> simp [m_u, m_gen, hψ_bar_mk, ψ_raw]
    have hu_X0 : IsUnit ((η.comp ψ_bar) m_u) := by
      change IsUnit (η (ψ_bar m_u))
      rw [hψ_bar_mu]
      exact IsLocalization.Away.algebraMap_isUnit (MvPolynomial.X 0)
    let Ψ_b : L_u →+* L_poly := IsLocalization.Away.lift m_u hu_X0
    have hΨ_alg : ∀ y : M, Ψ_b (ι_u y) = η (ψ_bar y) :=
      fun y => IsLocalization.Away.lift_eq m_u hu_X0 y
    have hΨ_comp : Ψ_b.comp tilde_Φ = η := by
      apply MvPolynomial.ringHom_ext'
      · apply RingHom.ext; intro r
        change Ψ_b ((Φ_hom (algebraMap k _ r)).1) = η (MvPolynomial.C r)
        rw [Φ_hom.commutes, IsScalarTower.algebraMap_apply k M ↥A_u r]
        change Ψ_b (ι_u (Ideal.Quotient.mk I_M (MvPolynomial.C r))) = η (MvPolynomial.C r)
        rw [hΨ_alg, hψ_bar_mk]
        simp [ψ_raw]
      · intro i
        refine Fin.cases ?_ ?_ i
        · change Ψ_b (tilde_Φ (MvPolynomial.X 0)) = η (MvPolynomial.X 0)
          rw [show tilde_Φ (MvPolynomial.X 0) = ι_u m_u from congrArg Subtype.val hΦ_X0,
            hΨ_alg, hψ_bar_mu]
        · intro c
          by_cases hcc₀ : c = c₀
          · subst hcc₀
            change Ψ_b (tilde_Φ (MvPolynomial.X (Fin.succ c))) = η (MvPolynomial.X (Fin.succ c))
            rw [show tilde_Φ (MvPolynomial.X (Fin.succ c)) = r_u 2 from congrArg Subtype.val hΦ_Xc₀]
            have hu_ηX0 : IsUnit (η (MvPolynomial.X 0)) :=
              IsLocalization.Away.algebraMap_isUnit (MvPolynomial.X 0)
            apply hu_ηX0.mul_left_cancel
            have h1 := congrArg Ψ_b (hr_spec 2)
            rw [map_mul, hΨ_alg, hψ_bar_mu, hΨ_alg] at h1
            have h2 : ψ_bar (m_gen 2) = MvPolynomial.X 0 * MvPolynomial.X (Fin.succ c) := by
              simp [m_gen, hψ_bar_mk, ψ_raw]
            rw [h2, map_mul] at h1
            exact h1
          · change Ψ_b (tilde_Φ (MvPolynomial.X (Fin.succ c))) = η (MvPolynomial.X (Fin.succ c))
            rw [show tilde_Φ (MvPolynomial.X (Fin.succ c)) = ι_u (t_M c) from
              congrArg Subtype.val (hΦ_Xc c hcc₀), hΨ_alg]
            simp [t_M, hψ_bar_mk, ψ_raw, hcc₀]
    have hΦ_inj : Function.Injective Φ_hom := by
      intro p₁ p₂ hEq
      apply hη_inj
      have h1 : (Ψ_b.comp tilde_Φ) p₁ = (Ψ_b.comp tilde_Φ) p₂ := by
        change Ψ_b (Φ_hom p₁).1 = Ψ_b (Φ_hom p₂).1
        rw [hEq]
      rwa [hΨ_comp] at h1
    exact ⟨AlgEquiv.ofBijective Φ_hom ⟨hΦ_inj, hΦ_surj⟩, hΦ_X0, hΦ_g2, hΦ_Xc⟩

  have hEt_of_equiv : ∀ (R₁ R₂ : Type u) [CommRing R₁] [CommRing R₂]
      (f : R₁ → R₂), Function.Bijective f → f 1 = 1 →
      (∀ x y, f (x * y) = f x * f y) → f 0 = 0 →
      (∀ x y, f (x + y) = f x + f y) →
      ∃ (φ_hom : R₁ →+* R₂), (∀ x, φ_hom x = f x) ∧ RingHom.Etale φ_hom := by
    intro R₁ R₂ _ _ f hbij h1 hmul h0 hadd
    let φ_hom : R₁ →+* R₂ :=
      { toFun := f, map_one' := h1, map_mul' := hmul, map_zero' := h0, map_add' := hadd }
    exact ⟨φ_hom, fun _ => rfl, RingHom.Etale.of_bijective (f := φ_hom) hbij⟩

  
  
  
  have hConj2 : ∀ b : Fin 2,
      ∃ (ψ'_b : MvPolynomial (Fin (m + 1)) k →+*
          ↥(Algebra.adjoin B' (Set.range fun j : Fin 3 =>
            IsLocalization.mk' (Localization.Away (g (Fin.castSucc b))) (g j)
              ⟨g (Fin.castSucc b), Submonoid.mem_powers (g (Fin.castSucc b))⟩))),
        AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ'_b)) ∧
        ψ'_b.comp MvPolynomial.C =
          (algebraMap B' _).comp (ψ_q.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)) ∧
        ψ'_b (MvPolynomial.X 0) = algebraMap B' _ (g (Fin.castSucc b)) ∧
        algebraMap B' _ (g 2) =
          ψ'_b (MvPolynomial.X 0) * ψ'_b (MvPolynomial.X (Fin.succ c₀)) ∧
        (∀ c : Fin m, c ≠ c₀ →
          ψ'_b (MvPolynomial.X (Fin.succ c)) =
            algebraMap B' _ (ψ_q (Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c))))) := by
    intro b
    obtain ⟨ι_b, hEt_ιb, hιb_comp, _, _⟩ := hPillar2 M B' ψ_q hEt_ψq m_gen g hg_eq
      (Fin.castSucc b)
      (Localization.Away (m_gen (Fin.castSucc b)))
      (Localization.Away (g (Fin.castSucc b)))
    obtain ⟨Φ_b, hΦb_X0, hΦb_g2, hΦb_Xc⟩ := hPillar3 b
      (Localization.Away (m_gen (Fin.castSucc b)))
      (Localization.Away (MvPolynomial.X 0 : MvPolynomial (Fin (m + 1)) k))
    obtain ⟨φ_b_hom, hφb_app, hEt_Φb⟩ := hEt_of_equiv _ _ (⇑Φ_b) Φ_b.bijective
      (map_one Φ_b) (map_mul Φ_b) (map_zero Φ_b) (map_add Φ_b)
    let ψ'_b := ι_b.comp φ_b_hom
    have hEt_ψ'b : RingHom.Etale ψ'_b :=
      RingHom.Etale.stableUnderComposition _ _ hEt_Φb hEt_ιb
    refine ⟨ψ'_b, ?_, ?_, ?_, ?_, ?_⟩
    · exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)
        (Q := @RingHom.Etale) (φ := CommRingCat.ofHom ψ'_b)).mpr hEt_ψ'b
    · apply RingHom.ext; intro r
      change ι_b (φ_b_hom (algebraMap k _ r)) =
        algebraMap B' _ (ψ_q (Ideal.Quotient.mk I_M (MvPolynomial.C r)))
      rw [hφb_app, Φ_b.commutes, IsScalarTower.algebraMap_apply k M _ r]
      exact RingHom.congr_fun hιb_comp (Ideal.Quotient.mk I_M (MvPolynomial.C r))
    · change ι_b (φ_b_hom (MvPolynomial.X 0)) = algebraMap B' _ (g (Fin.castSucc b))
      rw [hφb_app, hΦb_X0,
        show algebraMap B' _ (g (Fin.castSucc b)) =
          algebraMap B' _ (ψ_q (m_gen (Fin.castSucc b))) from
          congrArg (algebraMap B' _) (hg_eq (Fin.castSucc b))]
      exact RingHom.congr_fun hιb_comp (m_gen (Fin.castSucc b))
    · change algebraMap B' _ (g 2) =
        ι_b (φ_b_hom (MvPolynomial.X 0)) * ι_b (φ_b_hom (MvPolynomial.X (Fin.succ c₀)))
      rw [hφb_app, hφb_app, ← map_mul, ← hΦb_g2,
        show algebraMap B' _ (g 2) = algebraMap B' _ (ψ_q (m_gen 2)) from
          congrArg (algebraMap B' _) (hg_eq 2)]
      exact (RingHom.congr_fun hιb_comp (m_gen 2)).symm
    · intro c hcc₀
      change ι_b (φ_b_hom (MvPolynomial.X (Fin.succ c))) =
        algebraMap B' _ (ψ_q (Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inr c))))
      rw [hφb_app, hΦb_Xc c hcc₀]
      exact RingHom.congr_fun hιb_comp (Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inr c)))

  
  
  
  let a' : Fin m → ℕ := Function.update a c₀ (a c₀ - 2)
  let I_M' : Ideal (MvPolynomial (Fin 2 ⊕ Fin m) k) := Ideal.span
    ({MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
      ∏ c : Fin m, MvPolynomial.X (Sum.inr c) ^ a' c} : Set (MvPolynomial (Fin 2 ⊕ Fin m) k))
  let M' := MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ I_M'
  obtain ⟨hDomM', hVarM'⟩ := hPillar1 a'
  have : IsDomain M' := hDomM'
  have ht'c₀_ne : (Ideal.Quotient.mk I_M' (MvPolynomial.X (Sum.inr c₀)) : M') ≠ 0 :=
    hVarM' (Sum.inr c₀)
  have hRelM' : Ideal.Quotient.mk I_M' (MvPolynomial.X (Sum.inl 0)) *
      Ideal.Quotient.mk I_M' (MvPolynomial.X (Sum.inl 1)) =
      ∏ c : Fin m, Ideal.Quotient.mk I_M' (MvPolynomial.X (Sum.inr c)) ^ a' c := by
    have h0 : Ideal.Quotient.mk I_M'
        (MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
          ∏ c : Fin m, MvPolynomial.X (Sum.inr c) ^ a' c) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
    simp only [map_sub, map_mul, map_prod, map_pow] at h0
    exact sub_eq_zero.mp h0

  have hPillar4 : ∀ (L_2 L' : Type u) [CommRing L_2] [CommRing L']
      [Algebra k L_2] [Algebra M L_2] [IsScalarTower k M L_2]
      [IsLocalization.Away (m_gen 2) L_2]
      [Algebra M' L']
      [IsLocalization.Away (Ideal.Quotient.mk I_M' (MvPolynomial.X (Sum.inr c₀)) : M') L'],
      ∃ (Φ_2 : M' ≃ₐ[k]
          ↥(Algebra.adjoin M (Set.range fun j : Fin 3 =>
            IsLocalization.mk' L_2 (m_gen j) ⟨m_gen 2, Submonoid.mem_powers (m_gen 2)⟩))),
        (∀ i : Fin 2,
          Φ_2 (Ideal.Quotient.mk I_M' (MvPolynomial.X (Sum.inl i))) =
            ⟨IsLocalization.mk' L_2 (m_gen (Fin.castSucc i))
                ⟨m_gen 2, Submonoid.mem_powers (m_gen 2)⟩,
              Algebra.subset_adjoin ⟨Fin.castSucc i, rfl⟩⟩) ∧
        (∀ c : Fin m,
          Φ_2 (Ideal.Quotient.mk I_M' (MvPolynomial.X (Sum.inr c))) =
            algebraMap M _ (Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inr c)))) ∧
        (∀ i : Fin 2,
          algebraMap M _ (m_gen (Fin.castSucc i)) =
            algebraMap M _ (m_gen 2) *
              Φ_2 (Ideal.Quotient.mk I_M' (MvPolynomial.X (Sum.inl i)))) := by
    intro L_2 L' _ _ _ _ _ _ _ _
    let ι_2 : M →+* L_2 := algebraMap M L_2
    let r_2 : Fin 3 → L_2 := fun j =>
      IsLocalization.mk' L_2 (m_gen j) ⟨m_gen 2, Submonoid.mem_powers (m_gen 2)⟩
    let A_2 : Subalgebra M L_2 := Algebra.adjoin M (Set.range r_2)
    have hu_2 : IsUnit (ι_2 (m_gen 2)) := IsLocalization.Away.algebraMap_isUnit (m_gen 2)
    have hr2_spec : ∀ j : Fin 3, ι_2 (m_gen 2) * r_2 j = ι_2 (m_gen j) :=
      fun j => IsLocalization.mk'_spec' L_2 (m_gen j) ⟨m_gen 2, Submonoid.mem_powers (m_gen 2)⟩
    let φ2_raw : MvPolynomial (Fin 2 ⊕ Fin m) k →ₐ[k] ↥A_2 :=
      MvPolynomial.aeval fun s =>
        match s with
        | Sum.inl i => ⟨r_2 (Fin.castSucc i), Algebra.subset_adjoin ⟨Fin.castSucc i, rfl⟩⟩
        | Sum.inr c => algebraMap M ↥A_2 (Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inr c)))
    have hφ2_rel : ∀ f ∈ I_M', φ2_raw f = 0 := by
      intro f hf
      rw [Ideal.mem_span_singleton] at hf
      rcases hf with ⟨h, rfl⟩
      rw [map_mul]
      suffices φ2_raw (MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1)) =
          φ2_raw (∏ c : Fin m, MvPolynomial.X (Sum.inr c) ^ a' c) by
        rw [map_sub, this, sub_self, zero_mul]
      apply Subtype.ext
      apply (hu_2.pow 2).mul_left_cancel
      have hlhs : ι_2 (m_gen 2) ^ 2 *
          (φ2_raw (MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1))).1 =
          ∏ c : Fin m, ι_2 (Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inr c))) ^ a c := by
        have hx0 : (φ2_raw (MvPolynomial.X (Sum.inl 0))).1 = r_2 0 := by
          simp [φ2_raw]
        have hx1 : (φ2_raw (MvPolynomial.X (Sum.inl 1))).1 = r_2 1 := by
          simp [φ2_raw]
        rw [map_mul, Subalgebra.coe_mul, hx0, hx1]
        calc
          ι_2 (m_gen 2) ^ 2 * (r_2 0 * r_2 1)
            = (ι_2 (m_gen 2) * r_2 0) * (ι_2 (m_gen 2) * r_2 1) := by ring
          _ = ι_2 (m_gen 0) * ι_2 (m_gen 1) := by rw [hr2_spec 0, hr2_spec 1]
          _ = ι_2 (m_gen 0 * m_gen 1) := (map_mul ι_2 _ _).symm
          _ = ι_2 (∏ c : Fin m, Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inr c)) ^ a c) :=
                congrArg ι_2 hRelM
          _ = ∏ c : Fin m, ι_2 (Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inr c))) ^ a c := by
                simp [map_prod, map_pow]
      have hrhs_val : (φ2_raw (∏ c : Fin m, MvPolynomial.X (Sum.inr c) ^ a' c)).1 =
          ∏ c : Fin m, ι_2 (Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inr c))) ^ a' c := by
        have hhom := map_prod (A_2.val.toRingHom.comp φ2_raw.toRingHom)
          (fun c : Fin m => MvPolynomial.X (Sum.inr c) ^ a' c) Finset.univ
        change ((A_2.val.toRingHom.comp φ2_raw.toRingHom)
            (∏ c : Fin m, MvPolynomial.X (Sum.inr c) ^ a' c)) = _
        rw [hhom]
        simp [φ2_raw, map_pow, ι_2]
      rw [hlhs, hrhs_val,
        ← Finset.mul_prod_erase Finset.univ
          (fun c => ι_2 (Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inr c))) ^ a c)
          (Finset.mem_univ c₀),
        ← Finset.mul_prod_erase Finset.univ
          (fun c => ι_2 (Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inr c))) ^ a' c)
          (Finset.mem_univ c₀)]
      have ha'_c₀ : a' c₀ = a c₀ - 2 := Function.update_self c₀ (a c₀ - 2) a
      have herase : (∏ c ∈ Finset.univ.erase c₀,
            ι_2 (Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inr c))) ^ a' c) =
          ∏ c ∈ Finset.univ.erase c₀,
            ι_2 (Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inr c))) ^ a c := by
        refine Finset.prod_congr rfl fun c hc => ?_
        dsimp only [a']
        rw [Function.update_of_ne (Finset.ne_of_mem_erase hc)]
      have hpow : ι_2 (m_gen 2) ^ a c₀ = ι_2 (m_gen 2) ^ 2 * ι_2 (m_gen 2) ^ (a c₀ - 2) := by
        rw [← pow_add]; congr 1; omega
      rw [ha'_c₀, herase]
      change ι_2 (m_gen 2) ^ a c₀ * _ = ι_2 (m_gen 2) ^ 2 * (ι_2 (m_gen 2) ^ (a c₀ - 2) * _)
      rw [hpow, mul_assoc]
    let Φ2_hom : M' →ₐ[k] ↥A_2 := Ideal.Quotient.liftₐ I_M' φ2_raw hφ2_rel
    have hΦ2_mk : ∀ p, Φ2_hom (Ideal.Quotient.mk I_M' p) = φ2_raw p := fun _ => rfl
    let tilde_Φ2 : M' →+* L_2 := A_2.val.toRingHom.comp Φ2_hom.toRingHom
    have hΦ2_inl : ∀ i : Fin 2,
        Φ2_hom (Ideal.Quotient.mk I_M' (MvPolynomial.X (Sum.inl i))) =
          ⟨r_2 (Fin.castSucc i), Algebra.subset_adjoin ⟨Fin.castSucc i, rfl⟩⟩ :=
      fun i => by rw [hΦ2_mk]; simp [φ2_raw]
    have hΦ2_inr : ∀ c : Fin m,
        Φ2_hom (Ideal.Quotient.mk I_M' (MvPolynomial.X (Sum.inr c))) =
          algebraMap M ↥A_2 (Ideal.Quotient.mk I_M (MvPolynomial.X (Sum.inr c))) :=
      fun c => by rw [hΦ2_mk]; simp [φ2_raw]
    have hΦ2_prod : ∀ i : Fin 2,
        algebraMap M ↥A_2 (m_gen (Fin.castSucc i)) =
          algebraMap M ↥A_2 (m_gen 2) *
            Φ2_hom (Ideal.Quotient.mk I_M' (MvPolynomial.X (Sum.inl i))) := by
      intro i
      rw [hΦ2_inl i]
      exact Subtype.ext (hr2_spec (Fin.castSucc i)).symm
    have hM_in_range2 : ∀ y : M, ι_2 y ∈ tilde_Φ2.range := by
      intro y
      rcases Ideal.Quotient.mk_surjective y with ⟨p, rfl⟩
      refine MvPolynomial.induction_on
        (motive := fun p => ι_2 (Ideal.Quotient.mk I_M p) ∈ tilde_Φ2.range) p ?_ ?_ ?_
      · intro r
        refine ⟨Ideal.Quotient.mk I_M' (MvPolynomial.C r), ?_⟩
        change (Φ2_hom (algebraMap k M' r)).1 = ι_2 (Ideal.Quotient.mk I_M (MvPolynomial.C r))
        rw [Φ2_hom.commutes, IsScalarTower.algebraMap_apply k M ↥A_2 r]
        rfl
      · intro p₁ p₂ ih₁ ih₂
        simp only [map_add]
        exact tilde_Φ2.range.add_mem ih₁ ih₂
      · intro p₁ s ih
        simp only [map_mul]
        refine tilde_Φ2.range.mul_mem ih ?_
        rcases s with i | c
        · refine ⟨Ideal.Quotient.mk I_M'
            (MvPolynomial.X (Sum.inr c₀) * MvPolynomial.X (Sum.inl i)), ?_⟩
