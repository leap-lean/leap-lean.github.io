        intro e he x g hprod
        have hne : ∑ c ∈ I₀, e c ≠ 0 := by omega
        obtain ⟨c₀, hc₀, hec₀⟩ := Finset.exists_ne_zero_of_sum_ne_zero hne
        let e' : Fin m → ℕ := Function.update e c₀ (e c₀ - 1)
        have he' : (∑ c ∈ I₀, e' c) = N := by
          have hsum_eq : (∑ c ∈ I₀, e c) = e c₀ + ∑ c ∈ I₀.erase c₀, e c :=
            (Finset.add_sum_erase I₀ e hc₀).symm
          have hsum_eq' : (∑ c ∈ I₀, e' c) = e' c₀ + ∑ c ∈ I₀.erase c₀, e' c :=
            (Finset.add_sum_erase I₀ e' hc₀).symm
          have herase : (∑ c ∈ I₀.erase c₀, e' c) = ∑ c ∈ I₀.erase c₀, e c := by
            refine Finset.sum_congr rfl fun c hc => ?_
            have hne_c : c ≠ c₀ := Finset.ne_of_mem_erase hc
            simp [e', hne_c]
          have he'c₀ : e' c₀ = e c₀ - 1 := by simp [e']
          rw [hsum_eq', herase, he'c₀]
          omega
        have hprod_split : (∏ c ∈ I₀, tL c ^ e c) = tL c₀ * ∏ c ∈ I₀, tL c ^ e' c := by
          rw [← Finset.mul_prod_erase I₀ _ hc₀,
              ← Finset.mul_prod_erase I₀ (fun c => tL c ^ e' c) hc₀]
          have herase : (∏ c ∈ I₀.erase c₀, tL c ^ e c) = ∏ c ∈ I₀.erase c₀, tL c ^ e' c := by
            refine Finset.prod_congr rfl fun c hc => ?_
            have hne_c : c ≠ c₀ := Finset.ne_of_mem_erase hc
            simp [e', hne_c]
          have hec₀_eq : e c₀ = (e c₀ - 1) + 1 := by omega
          have hpow : tL c₀ ^ e c₀ = tL c₀ * tL c₀ ^ (e' c₀) := by
            simp only [e', Function.update_self]
            conv_lhs => rw [hec₀_eq]
            rw [pow_succ, mul_comm]
          rw [hpow, herase, mul_assoc]
        rw [hprod_split] at hprod
        have hprime : Prime (tL c₀) := ht_prime c₀ hc₀
        have htc₀_ne : tL c₀ ≠ 0 := hprime.ne_zero
        have hdvd : tL c₀ ∣ g * x := ⟨∏ c ∈ I₀, tL c ^ e' c, hprod.symm⟩
        rcases hprime.dvd_or_dvd hdvd with ⟨g', rfl⟩ | ⟨x', rfl⟩
        · have hprod' : (∏ c ∈ I₀, tL c ^ e' c) = g' * x :=
            mul_left_cancel₀ htc₀_ne (by linear_combination hprod)
          exact ih e' he' x g' hprod'
        · have hprod' : (∏ c ∈ I₀, tL c ^ e' c) = g * x' :=
            mul_left_cancel₀ htc₀_ne (by linear_combination hprod)
          obtain ⟨a', ε, ha'_supp, hx'⟩ := ih e' he' x' g hprod'
          let a : Fin m → ℕ := Function.update a' c₀ (a' c₀ + 1)
          refine ⟨a, ε, ?_, ?_⟩
          · intro c hc
            by_cases hcc₀ : c = c₀
            · subst hcc₀; exact hc₀
            · simp only [a, Function.update_of_ne hcc₀] at hc
              exact ha'_supp c hc
          · have hprod_a : (∏ c : Fin m, tL c ^ a c) = tL c₀ * ∏ c : Fin m, tL c ^ a' c := by
              rw [← Finset.mul_prod_erase Finset.univ _ (Finset.mem_univ c₀),
                  ← Finset.mul_prod_erase Finset.univ (fun c => tL c ^ a' c) (Finset.mem_univ c₀)]
              have herase : (∏ c ∈ Finset.univ.erase c₀, tL c ^ a c) =
                  ∏ c ∈ Finset.univ.erase c₀, tL c ^ a' c := by
                refine Finset.prod_congr rfl fun c hc => ?_
                have hne_c : c ≠ c₀ := Finset.ne_of_mem_erase hc
                simp [a, hne_c]
              simp only [a, Function.update_self, pow_succ, herase]
              ring
            rw [hprod_a, hx']
            ring
    have hprod_M : (∏ c ∈ I₀, tL c ^ M) = g₀ * hL := by
      rw [← Finset.prod_pow] at hg₀
      exact hg₀.trans (mul_comm hL g₀)
    obtain ⟨a, ε, ha_supp, hhL⟩ := h_ind (∑ _c ∈ I₀, M) (fun _ => M) rfl hL g₀ hprod_M
    have ha_pos : 1 ≤ ∑ c : Fin m, a c := by
      by_contra hnot
      have hsum0 : ∑ c : Fin m, a c = 0 := by omega
      have ha0 : ∀ c : Fin m, a c = 0 := fun c =>
        Finset.sum_eq_zero_iff.mp hsum0 c (Finset.mem_univ c)
      have hprod1 : (∏ c : Fin m, tL c ^ a c) = 1 := by
        refine Finset.prod_eq_one fun c _ => ?_
        rw [ha0 c, pow_zero]
      rw [hprod1, mul_one] at hhL
      have hisu : IsUnit (algebraMap R L h) := by
        change IsUnit hL
        rw [hhL]
        exact ε.isUnit
      have hnotmem : h ∈ p.primeCompl :=
        (IsLocalization.AtPrime.isUnit_to_map_iff L p h).mp hisu
      exact hnotmem hp
    obtain ⟨⟨r₁, s₁⟩, hr₁s₁⟩ := IsLocalization.surj p.primeCompl (↑ε : L)
    have hs₁_unit : IsUnit (algebraMap R L s₁.1) := IsLocalization.map_units L s₁
    have hr₁_unit : IsUnit (algebraMap R L r₁) := by
      rw [← hr₁s₁]
      exact ε.isUnit.mul hs₁_unit
    have hr₁_not_p : r₁ ∉ p :=
      (IsLocalization.AtPrime.isUnit_to_map_iff L p r₁).mp hr₁_unit
    have heq_L : algebraMap R L (s₁.1 * h) = algebraMap R L (r₁ * ∏ c : Fin m, t c ^ a c) := by
      simp only [map_mul, map_prod, map_pow]
      change algebraMap R L s₁.1 * hL = algebraMap R L r₁ * ∏ c : Fin m, tL c ^ a c
      rw [hhL, ← hr₁s₁]
      ring
    obtain ⟨s₂, hs₂_eq⟩ := IsLocalization.exists_of_eq (M := p.primeCompl) heq_L
    let s : R := r₁ * s₁.1 * s₂.1
    have hs_not_p : s ∉ p := by
      have h12 : r₁ * s₁.1 ∉ p := ‹p.IsPrime›.mul_notMem hr₁_not_p s₁.2
      exact ‹p.IsPrime›.mul_notMem h12 s₂.2
    let As := Localization.Away s
    let ι : R →+* As := algebraMap R As
    obtain ⟨u_s, hu_s⟩ := IsLocalization.Away.algebraMap_isUnit (S := As) s
    have hmul1 : (ι r₁ * ι s₁.1 * ι s₂.1) * ↑u_s⁻¹ = 1 := by
      have hs_map : algebraMap R As s = ι r₁ * ι s₁.1 * ι s₂.1 := by simp [s, ι, map_mul]
      rw [← hs_map, ← hu_s, Units.mul_inv]
    let u_r₁ : Asˣ := Units.mkOfMulEqOne (ι r₁) (ι s₁.1 * ι s₂.1 * ↑u_s⁻¹) (by linear_combination hmul1)
    let u_s₁ : Asˣ := Units.mkOfMulEqOne (ι s₁.1) (ι r₁ * ι s₂.1 * ↑u_s⁻¹) (by linear_combination hmul1)
    let u_s₂ : Asˣ := Units.mkOfMulEqOne (ι s₂.1) (ι r₁ * ι s₁.1 * ↑u_s⁻¹) (by linear_combination hmul1)
    let u : Asˣ := u_r₁ * u_s₁⁻¹
    have hAs_eq : ι s₂.1 * (ι s₁.1 * ι h) = ι s₂.1 * (ι r₁ * ∏ c : Fin m, ι (t c) ^ a c) := by
      have := congrArg ι hs₂_eq
      simpa only [map_mul, map_prod, map_pow] using this
    have h_ur₁ : (↑u_r₁ : As) = ι r₁ := rfl
    have h_us₁ : (↑u_s₁ : As) = ι s₁.1 := rfl
    have h_us₂ : (↑u_s₂ : As) = ι s₂.1 := rfl
    refine ⟨a, s, u, hs_not_p, ha_pos, ha_supp, ?_⟩
    change ι h = ↑u * ∏ c : Fin m, ι (t c) ^ a c
    have hstep1 : ι s₁.1 * ι h = ι r₁ * ∏ c : Fin m, ι (t c) ^ a c := by
      calc ι s₁.1 * ι h
        _ = ↑u_s₂⁻¹ * (↑u_s₂ * (ι s₁.1 * ι h)) := by simp
        _ = ↑u_s₂⁻¹ * (↑u_s₂ * (ι r₁ * ∏ c : Fin m, ι (t c) ^ a c)) := by
            rw [h_us₂, hAs_eq]
        _ = ι r₁ * ∏ c : Fin m, ι (t c) ^ a c := by simp
    calc ι h
      _ = ↑u_s₁⁻¹ * (↑u_s₁ * ι h) := by simp
      _ = ↑u_s₁⁻¹ * (ι r₁ * ∏ c : Fin m, ι (t c) ^ a c) := by rw [h_us₁, hstep1]
      _ = (↑u_r₁ * ↑u_s₁⁻¹) * ∏ c : Fin m, ι (t c) ^ a c := by rw [h_ur₁]; ring
      _ = ↑u * ∏ c : Fin m, ι (t c) ^ a c := by simp [u, Units.val_mul]

theorem weil_semistable_curve_smooth_and_section_nc_chart (k : Type u) [Field k] (m : ℕ)
    (B₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (Z_B₁ : Set B₁.left)
    (r_B : ℕ) (D_B : Fin r_B → AlgebraicGeometry.Scheme.{u})
    (ιD_B : ∀ i : Fin r_B, D_B i ⟶ B₁.left)
    (hClD_B : ∀ i : Fin r_B, AlgebraicGeometry.IsClosedImmersion (ιD_B i))
    (hZB₁_eq : Z_B₁ = ⋃ i : Fin r_B, Set.range (ιD_B i).base)
    (hChartsB₁ : ∀ y : B₁.left, ∃ (U : B₁.left.Opens),
      AlgebraicGeometry.IsAffineOpen U ∧ y ∈ U ∧
      ∃ (ψ : MvPolynomial (Fin m) k →+* ↑(B₁.left.presheaf.obj (Opposite.op U))),
        AlgebraicGeometry.Etale (U.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) ∧
        (U.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = U.ι ≫ B₁.hom) ∧
        ∃ (α : {i : Fin r_B // Nonempty ↑((TopologicalSpace.Opens.map (ιD_B i).base).obj U)} → Fin m),
          Function.Injective α ∧
          ∀ (i : Fin r_B) (hi : Nonempty ↑((TopologicalSpace.Opens.map (ιD_B i).base).obj U)),
            RingHom.ker ((ιD_B i).app U).hom =
              Ideal.span {ψ (MvPolynomial.X (α ⟨i, hi⟩))})
    (C₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (f₁ : C₁ ⟶ B₁) (n : ℕ) (τ₁ : Fin n → (B₁ ⟶ C₁))
    (hProp : AlgebraicGeometry.IsProper f₁.left)
    (hSec : ∀ j : Fin n, τ₁ j ≫ f₁ = 𝟙 B₁)
    (hDisj : _root_.Pairwise fun i j : Fin n =>
      Disjoint (Set.range (τ₁ i).left.base) (Set.range (τ₁ j).left.base))
    (x : C₁.left)
    (hSm : ∃ V : C₁.left.Opens,
      x ∈ V ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V.ι ≫ f₁.left)) :
    ∃ (R' : CommRingCat.{u}) (v₀ : AlgebraicGeometry.Spec R')
      (e_X : AlgebraicGeometry.Spec R' ⟶ C₁.left)
      (ψ : MvPolynomial (Fin (m + 1)) k →+* ↑R')
      (I : Finset (Fin (m + 1))),
      AlgebraicGeometry.Etale e_X ∧
      AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) ∧
      e_X.base v₀ = x ∧
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = e_X ≫ C₁.hom) ∧
      (∀ i ∈ I, ψ (MvPolynomial.X i) ∈ v₀.asIdeal) ∧
      e_X.base ⁻¹' (f₁.left.base ⁻¹' Z_B₁ ∪ ⋃ j : Fin n, Set.range (τ₁ j).left.base) =
        {v : AlgebraicGeometry.Spec R' | ∃ i ∈ I, ψ (MvPolynomial.X i) ∈ v.asIdeal} :=
by
  classical
  
  have hMapEt : ∀ {R₁ R₂ : Type u} [CommRing R₁] [CommRing R₂]
      (σ : Type) (β : R₁ →+* R₂), β.Etale → (MvPolynomial.map (σ := σ) β).Etale := by
    intro R₁ R₂ _ _ σ β hβ
    let _ : Algebra R₁ R₂ := β.toAlgebra
    have _ : Algebra.Etale R₁ R₂ := RingHom.etale_algebraMap.mp hβ
    have hBase : Algebra.Etale (MvPolynomial σ R₁)
        (TensorProduct R₁ (MvPolynomial σ R₁) R₂) :=
      Algebra.Etale.baseChange R₁ R₂ (MvPolynomial σ R₁)
    let e : TensorProduct R₁ (MvPolynomial σ R₁) R₂ ≃+* MvPolynomial σ R₂ :=
      (Algebra.TensorProduct.comm R₁ (MvPolynomial σ R₁) R₂).toRingEquiv.trans
        (MvPolynomial.algebraTensorAlgEquiv R₁ R₂).toRingEquiv
    have hEq : e.toRingHom.comp
        (algebraMap (MvPolynomial σ R₁) (TensorProduct R₁ (MvPolynomial σ R₁) R₂)) =
        MvPolynomial.map β := by
      apply MvPolynomial.ringHom_ext
      · intro r
        simp [e, Algebra.TensorProduct.algebraMap_apply]
        rfl
      · intro i
        simp [e, Algebra.TensorProduct.algebraMap_apply]
    rw [← hEq]
    exact RingHom.Etale.stableUnderComposition _ _
      (RingHom.etale_algebraMap.mpr hBase)
      (RingHom.Etale.of_bijective (f := e.toRingHom) e.bijective)
  
  have hCombine : ∀ (A R' : Type u) [CommRing A] [CommRing R']
      (ψ_A : MvPolynomial (Fin m) k →+* A),
      Etale (Spec.map (CommRingCat.ofHom ψ_A)) →
      ∀ (φ : A →+* R') (g_R : MvPolynomial (Fin 1) A →+* R'),
      g_R.comp MvPolynomial.C = φ →
      g_R.Etale →
      ∃ (ψ : MvPolynomial (Fin (m + 1)) k →+* R'),
        Etale (Spec.map (CommRingCat.ofHom ψ)) ∧
        ψ.comp MvPolynomial.C = φ.comp (ψ_A.comp MvPolynomial.C) ∧
        (∀ c : Fin m, ψ (MvPolynomial.X (Fin.castSucc c)) = φ (ψ_A (MvPolynomial.X c))) ∧
        ψ (MvPolynomial.X (Fin.last m)) = g_R (MvPolynomial.X 0) := by
    intro A R' _ _ ψ_A hEt_A φ g_R hg_comp hg_et
    let ε : Fin (m + 1) ≃ Fin 1 ⊕ Fin m :=
      finSumFinEquiv.symm.trans (Equiv.sumComm (Fin m) (Fin 1))
    let e₁ : MvPolynomial (Fin (m + 1)) k ≃+* MvPolynomial (Fin 1 ⊕ Fin m) k :=
      (MvPolynomial.renameEquiv k ε).toRingEquiv
    let e₂ : MvPolynomial (Fin 1 ⊕ Fin m) k ≃+*
        MvPolynomial (Fin 1) (MvPolynomial (Fin m) k) :=
      MvPolynomial.sumRingEquiv k (Fin 1) (Fin m)
    let ψ : MvPolynomial (Fin (m + 1)) k →+* R' :=
      g_R.comp ((MvPolynomial.map ψ_A).comp (e₂.toRingHom.comp e₁.toRingHom))
    have hψA_et : ψ_A.Etale :=
      (HasRingHomProperty.Spec_iff (P := @Etale) (Q := @RingHom.Etale)).mp hEt_A
    have hMap_et : (MvPolynomial.map (σ := Fin 1) ψ_A).Etale :=
      hMapEt (Fin 1) ψ_A hψA_et
    have hψ_et : ψ.Etale :=
      RingHom.Etale.stableUnderComposition _ _
        (RingHom.Etale.stableUnderComposition _ _
          (RingHom.Etale.stableUnderComposition _ _
            (RingHom.Etale.of_bijective (f := e₁.toRingHom) e₁.bijective)
            (RingHom.Etale.of_bijective (f := e₂.toRingHom) e₂.bijective))
          hMap_et)
        hg_et
    have hg_C : ∀ a : A, g_R (MvPolynomial.C a) = φ a := RingHom.congr_fun hg_comp
    refine ⟨ψ, (HasRingHomProperty.Spec_iff (P := @Etale) (Q := @RingHom.Etale)).mpr hψ_et,
      ?_, ?_, ?_⟩
    · ext c
      simp [ψ, e₁, e₂, MvPolynomial.sumRingEquiv_C, hg_C]
    · intro c
      have hε : ε (Fin.castSucc c) = Sum.inr c := by
        have hc : Fin.castSucc c = finSumFinEquiv (Sum.inl c) := by
          rw [finSumFinEquiv_apply_left]
          rfl
        simp [ε, hc]
      simp [ψ, e₁, e₂, hε, MvPolynomial.sumRingEquiv_X_inr, hg_C]
    · have hε : ε (Fin.last m) = Sum.inl 0 := by
        have hl : Fin.last m = finSumFinEquiv (Sum.inr (0 : Fin 1)) := by
          rw [finSumFinEquiv_apply_right]
          ext
          simp
        simp [ε, hl]
      simp [ψ, e₁, e₂, hε, MvPolynomial.sumRingEquiv_X_inl]
  
  have hRectify : ∀ (A S_ring : Type u) [CommRing A] [CommRing S_ring]
      (φ : A →+* S_ring) (σ : S_ring →+* A),
      σ.comp φ = RingHom.id A →
      ∀ (g : MvPolynomial (Fin 1) A →+* S_ring),
      g.comp MvPolynomial.C = φ →
      g.Etale →
      ∀ (q_S : PrimeSpectrum S_ring),
      RingHom.ker σ ≤ q_S.asIdeal →
      ∃ (g_S : S_ring) (g' : MvPolynomial (Fin 1) A →+* Localization.Away g_S),
        g_S ∉ q_S.asIdeal ∧
        g'.comp MvPolynomial.C = (algebraMap S_ring (Localization.Away g_S)).comp φ ∧
        g'.Etale ∧
        ∀ v : PrimeSpectrum (Localization.Away g_S),
          g' (MvPolynomial.X 0) ∈ v.asIdeal ↔
            RingHom.ker σ ≤
              (PrimeSpectrum.comap (algebraMap S_ring (Localization.Away g_S)) v).asIdeal := by
    intro A S_ring _ _ φ σ hσ g hg_comp hg_et q_S hq_sec
    let w₀ : S_ring := g (MvPolynomial.X 0)
    let a₀ : A := σ w₀
    let u₀ : S_ring := w₀ - φ a₀
    have hσφ_apply : ∀ a : A, σ (φ a) = a := RingHom.congr_fun hσ
    have hg_C : ∀ a : A, g (MvPolynomial.C a) = φ a := RingHom.congr_fun hg_comp
    have hu₀_ker : u₀ ∈ RingHom.ker σ := by
      change σ (w₀ - φ a₀) = 0
      rw [map_sub, hσφ_apply, sub_self]
    let P₁ := MvPolynomial (Fin 1) A
    let τ_minus : P₁ →+* P₁ :=
      MvPolynomial.eval₂Hom MvPolynomial.C (fun _ : Fin 1 => MvPolynomial.X 0 - MvPolynomial.C a₀)
    let τ_plus : P₁ →+* P₁ :=
      MvPolynomial.eval₂Hom MvPolynomial.C (fun _ : Fin 1 => MvPolynomial.X 0 + MvPolynomial.C a₀)
    have hτ_inv₁ : τ_minus.comp τ_plus = RingHom.id P₁ := by
      apply MvPolynomial.ringHom_ext
      · intro a
        change τ_minus (τ_plus (MvPolynomial.C a)) = MvPolynomial.C a
        rw [MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_C]
      · intro i
        fin_cases i
        change τ_minus (τ_plus (MvPolynomial.X 0)) = MvPolynomial.X 0
        rw [MvPolynomial.eval₂Hom_X', map_add, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C]
        exact sub_add_cancel _ _
    have hτ_inv₂ : τ_plus.comp τ_minus = RingHom.id P₁ := by
      apply MvPolynomial.ringHom_ext
      · intro a
        change τ_plus (τ_minus (MvPolynomial.C a)) = MvPolynomial.C a
        rw [MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_C]
      · intro i
        fin_cases i
        change τ_plus (τ_minus (MvPolynomial.X 0)) = MvPolynomial.X 0
        rw [MvPolynomial.eval₂Hom_X', map_sub, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C]
        exact add_sub_cancel_right _ _
    have hτ_bij : Function.Bijective ⇑τ_minus := by
      refine ⟨fun p q hpq => ?_, fun p => ⟨τ_plus p, ?_⟩⟩
      · have h1 : τ_plus (τ_minus p) = τ_plus (τ_minus q) := congrArg τ_plus hpq
        have h2 : τ_plus (τ_minus p) = p := RingHom.congr_fun hτ_inv₂ p
        have h3 : τ_plus (τ_minus q) = q := RingHom.congr_fun hτ_inv₂ q
        exact h2.symm.trans (h1.trans h3)
      · exact RingHom.congr_fun hτ_inv₁ p
    let g₀ : P₁ →+* S_ring := g.comp τ_minus
    have hg₀_et : g₀.Etale :=
      RingHom.Etale.stableUnderComposition _ _
        (RingHom.Etale.of_bijective (f := τ_minus) hτ_bij) hg_et
    have hg₀_comp : g₀.comp MvPolynomial.C = φ := by
      ext a
      change g (τ_minus (MvPolynomial.C a)) = φ a
      rw [MvPolynomial.eval₂Hom_C, hg_C]
    have hg₀_C : ∀ a : A, g₀ (MvPolynomial.C a) = φ a := RingHom.congr_fun hg₀_comp
    have hg₀_X0 : g₀ (MvPolynomial.X 0) = u₀ := by
      change g (τ_minus (MvPolynomial.X 0)) = w₀ - φ a₀
      rw [MvPolynomial.eval₂Hom_X', map_sub, hg_C]
    let I₀ : Ideal S_ring := Ideal.span ({u₀} : Set S_ring)
    let B₀ := S_ring ⧸ I₀
    let π₀ : S_ring →+* B₀ := Ideal.Quotient.mk I₀
    let φ_bar : A →+* B₀ := π₀.comp φ
    have hπ₀_u₀ : π₀ u₀ = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
    have hφ_bar_et : φ_bar.Etale := by
      let eval₀ : P₁ →+* A := MvPolynomial.eval₂Hom (RingHom.id A) (fun _ : Fin 1 => 0)
      letI : Algebra P₁ A := eval₀.toAlgebra
