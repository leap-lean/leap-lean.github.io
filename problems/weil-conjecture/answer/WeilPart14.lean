      AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ_surj)
    have hOpens : (TopologicalSpace.Opens.map δ₀.base).obj Ω.opensRange = ι_U.opensRange := by
      ext x
      exact Set.ext_iff.mp hPre x
    have hPb : CategoryTheory.IsPullback f_θ ι_U Ω δ₀ :=
      AlgebraicGeometry.IsOpenImmersion.isPullback f_θ ι_U Ω δ₀ hComm hOpens
    let Z_loc := CategoryTheory.Limits.pullback Ω δ₀.imageι
    let i_Z : Z_loc ⟶ AlgebraicGeometry.Spec (CommRingCat.of A) :=
      CategoryTheory.Limits.pullback.fst Ω δ₀.imageι
    let u_Z : Z_loc ⟶ δ₀.image :=
      CategoryTheory.Limits.pullback.snd Ω δ₀.imageι
    have hKer₁ : i_Z.ker = f_θ.ker := by
      have h1 : i_Z.ker = (δ₀.imageι.ker).comap Ω :=
        AlgebraicGeometry.Scheme.IdealSheafData.ker_fst_of_isClosedImmersion δ₀.imageι Ω
      have h2 : δ₀.imageι.ker = δ₀.ker :=
        AlgebraicGeometry.Scheme.IdealSheafData.ker_subschemeι δ₀.ker
      rw [h1, h2]
      ext W : 2
      rw [AlgebraicGeometry.Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion δ₀.ker Ω W,
        AlgebraicGeometry.Scheme.ker_ideal_of_isPullback_of_isOpenImmersion δ₀ f_θ ι_U Ω hPb W]
    have hKer₂ : f_θ.ker = i_R.ker := by
      rw [AlgebraicGeometry.Scheme.ker_of_isAffine f_θ,
        AlgebraicGeometry.Scheme.ker_of_isAffine i_R]
      congr 1
      ext x
      simp only [RingHom.mem_ker]
      let isoA := AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A)
      let isoS := AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of S)
      let isoL := AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of L_ring)
      have hNat_θ := AlgebraicGeometry.Scheme.ΓSpecIso_naturality
        (CommRingCat.ofHom (ι_sub.comp θ_surj))
      have hNat_R := AlgebraicGeometry.Scheme.ΓSpecIso_naturality (CommRingCat.ofHom θ_surj)
      have hApp_θ : isoL.hom.hom (f_θ.appTop.hom x) = ι_sub (θ_surj (isoA.hom.hom x)) :=
        congrArg (fun φ => φ.hom x) hNat_θ
      have hApp_R : isoS.hom.hom (i_R.appTop.hom x) = θ_surj (isoA.hom.hom x) :=
        congrArg (fun φ => φ.hom x) hNat_R
      have hIsoInj : ∀ {R_cat : CommRingCat.{u}}
          (e : ↑((AlgebraicGeometry.Spec R_cat).presheaf.obj (Opposite.op ⊤))),
          (AlgebraicGeometry.Scheme.ΓSpecIso R_cat).hom.hom e = 0 ↔ e = 0 := by
        intro R_cat e
        constructor
        · intro h0
          have hinv := congrArg (AlgebraicGeometry.Scheme.ΓSpecIso R_cat).inv.hom h0
          rw [map_zero] at hinv
          have hid : (AlgebraicGeometry.Scheme.ΓSpecIso R_cat).inv.hom
              ((AlgebraicGeometry.Scheme.ΓSpecIso R_cat).hom.hom e) = e :=
            congrArg (fun φ => φ.hom e) (AlgebraicGeometry.Scheme.ΓSpecIso R_cat).hom_inv_id
          rwa [hid] at hinv
        · intro h0
          rw [h0, map_zero]
      rw [← hIsoInj (f_θ.appTop.hom x), ← hIsoInj (i_R.appTop.hom x), hApp_θ, hApp_R]
      exact ⟨fun h0 => hInj (h0.trans (map_zero ι_sub).symm), fun h0 => by rw [h0, map_zero]⟩
    have hKer : i_Z.ker = i_R.ker := hKer₁.trans hKer₂
    have : AlgebraicGeometry.IsClosedImmersion i_R :=
      AlgebraicGeometry.IsClosedImmersion.spec_of_surjective (CommRingCat.ofHom θ_surj) hSurj
    let e_Z : AlgebraicGeometry.Spec (CommRingCat.of S) ⟶ Z_loc :=
      AlgebraicGeometry.IsClosedImmersion.lift i_Z i_R (le_of_eq hKer)
    have : CategoryTheory.IsIso e_Z :=
      AlgebraicGeometry.IsClosedImmersion.isIso_lift i_Z i_R hKer
    have he_fac : e_Z ≫ i_Z = i_R :=
      AlgebraicGeometry.IsClosedImmersion.lift_fac i_Z i_R (le_of_eq hKer)
    let ι_img : AlgebraicGeometry.Spec (CommRingCat.of S) ⟶ δ₀.image := e_Z ≫ u_Z
    refine ⟨ι_img, inferInstance, ?_, ?_⟩
    · dsimp [ι_img, u_Z, i_Z]
      rw [Category.assoc, ← CategoryTheory.Limits.pullback.condition, ← Category.assoc, he_fac]
    · have hSurj_e : Function.Surjective e_Z.base := by
        intro z
        refine ⟨(CategoryTheory.inv e_Z).base z, ?_⟩
        change ((CategoryTheory.inv e_Z) ≫ e_Z).base z = z
        rw [CategoryTheory.IsIso.inv_hom_id]
        rfl
      dsimp [ι_img, u_Z]
      change Set.range ((CategoryTheory.Limits.pullback.snd Ω δ₀.imageι).base ∘ e_Z.base) = _
      rw [hSurj_e.range_comp, AlgebraicGeometry.Scheme.Pullback.range_snd]
  
  have : TopologicalSpace.NoetherianSpace ↥U_compl.toScheme :=
    U_compl.ι.isOpenEmbedding.toIsEmbedding.toIsInducing.noetherianSpace
  have : AlgebraicGeometry.QuasiCompact δ :=
    AlgebraicGeometry.quasiCompact_of_noetherianSpace_source δ
  refine ⟨hCov, ?_⟩
  intro i V hi α R_V h_V C_α w_α R_Vα ι_Vα ψ_Vα hOpen_Vα hU_Vα hΦ_Vα hPre_Vα hPsi_Vα
  have : AlgebraicGeometry.IsOpenImmersion ι_Vα := hOpen_Vα
  let L_α := Localization.Away (h_V α)
  let loc_α : R_V →+* L_α := algebraMap R_V L_α
  let φ_k : k →+* R_V :=
    (AlgebraicGeometry.Spec.fullyFaithful.preimage (V.2.fromSpec ≫ X.hom)).unop.hom
  have hv₁ : V.2.fromSpec ≫ X.hom = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_k) := by
    simp [φ_k]
  let γ_k : k →+* C_α :=
    (HomogeneousLocalization.fromZeroRingHom 𝒜_L
      (Submonoid.powers (MvPolynomial.X α))).comp (algebraMap k ↥(𝒜_L 0))
  have hv₂ : w_α ≫ P_L.hom = AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ_k) := by
    have h_away : AlgebraicGeometry.Proj.awayι 𝒜_L (MvPolynomial.X α)
          (MvPolynomial.isHomogeneous_X k α) zero_lt_one ≫
        AlgebraicGeometry.Proj.toSpecZero 𝒜_L =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (HomogeneousLocalization.fromZeroRingHom 𝒜_L
            (Submonoid.powers (MvPolynomial.X α)))) :=
      AlgebraicGeometry.Proj.awayι_toSpecZero 𝒜_L (MvPolynomial.X α)
        (MvPolynomial.isHomogeneous_X k α) zero_lt_one
    have h1 : w_α ≫ P_L.hom =
        (AlgebraicGeometry.Proj.awayι 𝒜_L (MvPolynomial.X α)
            (MvPolynomial.isHomogeneous_X k α) zero_lt_one ≫
          AlgebraicGeometry.Proj.toSpecZero 𝒜_L) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜_L 0))) := by
      dsimp [w_α, P_L, weilProjectiveSpaceOver, 𝒜_L]
      rw [Category.assoc]
    rw [h1, h_away, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
  have hScalar : ψ_Vα.comp γ_k = loc_α.comp φ_k := by
    have hMapEq : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_Vα.comp γ_k)) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (loc_α.comp φ_k)) := by
      calc
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_Vα.comp γ_k))
            = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_Vα) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ_k) := by
              rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_Vα) ≫ w_α) ≫ P_L.hom := by
              rw [Category.assoc, hv₂]
        _ = ι_Vα ≫ (Φ₀ ≫ P_L.hom) := by rw [← hΦ_Vα, Category.assoc]
        _ = (ι_Vα ≫ U_compl.ι) ≫ X.hom := by rw [hΦ₀, Category.assoc]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom loc_α) ≫ (V.2.fromSpec ≫ X.hom) := by
              rw [hU_Vα, Category.assoc]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (loc_α.comp φ_k)) := by
              rw [hv₁, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    have hCat := AlgebraicGeometry.Spec.map_injective hMapEq
    ext c
    exact congrArg (fun f => f.hom c) hCat
  have hMem_ψ : ∀ x : C_α, ψ_Vα x ∈ R_Vα.toSubring := by
    refine hHomSub α L_α R_Vα.toSubring ψ_Vα (fun c => ?_) (fun β => ?_)
    · have hc_eq : ψ_Vα (γ_k c) = loc_α (φ_k c) := DFunLike.congr_fun hScalar c
      change ψ_Vα (γ_k c) ∈ R_Vα
      rw [hc_eq]
      exact R_Vα.algebraMap_mem (φ_k c)
    · rw [hPsi_Vα β]
      exact Algebra.subset_adjoin ⟨β, rfl⟩
  let ψ_sub : C_α →+* ↥R_Vα := ψ_Vα.codRestrict R_Vα.toSubring hMem_ψ
  let _ : Algebra k R_V := φ_k.toAlgebra
  let _ : Algebra k C_α := γ_k.toAlgebra
  let _ : Algebra k ↥R_Vα := ((algebraMap R_V ↥R_Vα).comp φ_k).toAlgebra
  have : IsScalarTower k R_V ↥R_Vα := IsScalarTower.of_algebraMap_eq' rfl
  let ψ_sub_alg : C_α →ₐ[k] ↥R_Vα :=
    { ψ_sub with
      commutes' := fun c => by
        apply Subtype.ext
        change ψ_Vα (γ_k c) = (algebraMap R_V ↥R_Vα (φ_k c)).1
        exact DFunLike.congr_fun hScalar c }
  let θ_surj_alg : TensorProduct k R_V C_α →ₐ[k] ↥R_Vα :=
    Algebra.TensorProduct.productMap (IsScalarTower.toAlgHom k R_V ↥R_Vα) ψ_sub_alg
  let θ_surj : TensorProduct k R_V C_α →+* ↥R_Vα := θ_surj_alg.toRingHom
  let ι_sub : ↥R_Vα →+* L_α := R_Vα.val.toRingHom
  have hSurj_θ : Function.Surjective θ_surj := by
    intro y
    have hy : ∃ t : TensorProduct k R_V C_α, (θ_surj t).1 = y.1 := by
      refine Algebra.adjoin_induction (p := fun v _ => ∃ t : TensorProduct k R_V C_α,
        (θ_surj t).1 = v) ?_ ?_ ?_ ?_ y.2
      · rintro v ⟨β, rfl⟩
        refine ⟨(1 : R_V) ⊗ₜ[k] HomogeneousLocalization.Away.isLocalizationElem (𝒜 := 𝒜_L)
          (hX α) (hX β), ?_⟩
        change (algebraMap R_V ↥R_Vα 1 * ψ_sub _).1 = _
        rw [map_one, one_mul]
        exact hPsi_Vα β
      · intro r
        refine ⟨r ⊗ₜ[k] (1 : C_α), ?_⟩
        change (algebraMap R_V ↥R_Vα r * ψ_sub 1).1 = _
        rw [map_one, mul_one]
        rfl
      · rintro v₁ v₂ _ _ ⟨t₁, ht₁⟩ ⟨t₂, ht₂⟩
        refine ⟨t₁ + t₂, ?_⟩
        rw [map_add, Subalgebra.coe_add, ht₁, ht₂]
      · rintro v₁ v₂ _ _ ⟨t₁, ht₁⟩ ⟨t₂, ht₂⟩
        refine ⟨t₁ * t₂, ?_⟩
        rw [map_mul, Subalgebra.coe_mul, ht₁, ht₂]
    obtain ⟨t, ht⟩ := hy
    exact ⟨t, Subtype.ext ht⟩
  have : AlgebraicGeometry.IsOpenImmersion
      (V.2.fromSpec : AlgebraicGeometry.Spec (CommRingCat.of R_V) ⟶ X.left) :=
    V.2.isOpenImmersion_fromSpec
  have : AlgebraicGeometry.IsOpenImmersion w_α :=
    AlgebraicGeometry.Proj.instIsOpenImmersionAwayι 𝒜_L (MvPolynomial.X α)
      (MvPolynomial.isHomogeneous_X k α) zero_lt_one
  obtain ⟨Ω, hOpen_Ω, hFst_Ω, hSnd_Ω, hRange_Ω⟩ :=
    hTensorChart X.hom P_L.hom R_V C_α V.2.fromSpec w_α hv₁ hv₂
  have : AlgebraicGeometry.IsOpenImmersion Ω := hOpen_Ω
  have hθ_left : θ_surj.comp Algebra.TensorProduct.includeLeftRingHom = algebraMap R_V ↥R_Vα := by
    apply RingHom.ext
    intro r
    change algebraMap R_V ↥R_Vα r * ψ_sub 1 = algebraMap R_V ↥R_Vα r
    rw [map_one, mul_one]
  have hθ_right : θ_surj.comp Algebra.TensorProduct.includeRight.toRingHom = ψ_sub := by
    apply RingHom.ext
    intro x
    change algebraMap R_V ↥R_Vα 1 * ψ_sub x = ψ_sub x
    rw [map_one, one_mul]
  have hComm_δ : ι_Vα ≫ δ =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_sub.comp θ_surj)) ≫ Ω := by
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_fst, Category.assoc, hFst_Ω,
        ← Category.assoc, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
        RingHom.comp_assoc, hθ_left]
      exact hU_Vα
    · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_snd, Category.assoc, hSnd_Ω,
        ← Category.assoc, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
        RingHom.comp_assoc, hθ_right]
      exact hΦ_Vα
  have hRange_V : Set.range V.2.fromSpec.base = (V.1 : Set X.left) := V.2.range_fromSpec
  have hPre_δ : δ.base ⁻¹' Set.range Ω.base = Set.range ι_Vα.base := by
    rw [hRange_Ω, hRange_V, Set.preimage_inter]
    have hpre₁ : δ.base ⁻¹' ((CategoryTheory.Limits.pullback.fst X.hom P_L.hom).base ⁻¹'
        (V.1 : Set X.left)) = U_compl.ι.base ⁻¹' (V.1 : Set X.left) := by
      change (δ ≫ CategoryTheory.Limits.pullback.fst X.hom P_L.hom).base ⁻¹'
        (V.1 : Set X.left) = _
      rw [CategoryTheory.Limits.pullback.lift_fst]
    have hpre₂ : δ.base ⁻¹' ((CategoryTheory.Limits.pullback.snd X.hom P_L.hom).base ⁻¹'
        Set.range w_α.base) = Φ₀.base ⁻¹' Set.range w_α.base := by
      change (δ ≫ CategoryTheory.Limits.pullback.snd X.hom P_L.hom).base ⁻¹'
        Set.range w_α.base = _
      rw [CategoryTheory.Limits.pullback.lift_snd]
    rw [hpre₁, hpre₂]
    exact hPre_Vα
  obtain ⟨ι_img, hOpen_img, hFac_img, hRange_img⟩ :=
    hImageChart δ (TensorProduct k R_V C_α) ↥R_Vα L_α θ_surj ι_sub Ω ι_Vα
      hSurj_θ Subtype.val_injective hComm_δ hPre_δ
  refine ⟨ι_img, ψ_sub, hOpen_img, ?_, ?_, ?_, ?_⟩
  · dsimp [π_left]
    rw [← Category.assoc, hFac_img, Category.assoc, hFst_Ω, ← Category.assoc,
      ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hθ_left]
  · rw [← Category.assoc, hFac_img, Category.assoc, hSnd_Ω, ← Category.assoc,
      ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hθ_right]
  · rw [hRange_img, hRange_Ω, hRange_V, Set.preimage_inter]
    rfl
  · intro β
    exact hPsi_Vα β

theorem weil_separated_generic_iso_gluing_of_away_openImmersions (B' : CommRingCat.{u}) (Q : AlgebraicGeometry.Scheme.{u})
    (q_snd : Q ⟶ AlgebraicGeometry.Spec B')
    [AlgebraicGeometry.IsSeparated q_snd]
    (U_B : (AlgebraicGeometry.Spec B').Opens)
    [CategoryTheory.IsIso (q_snd ∣_ U_B)]
    (A L_ring : Type u) [CommRing A] [CommRing L_ring]
    (φ_A : ↑B' →+* A) (ι_L : A →+* L_ring)
    {ι : Type u} [Fintype ι] (θ : ι → A)
    (j_loc : ∀ p : ι, AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (θ p))) ⟶ Q)
    (W_cov : ι → Q.Opens)
    (hInj : Function.Injective ι_L)
    (hRangeL : Set.range (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_L.comp φ_A))).base ⊆
      (U_B : Set ↥(AlgebraicGeometry.Spec B')))
    (hSpan : Ideal.span (Set.range θ) = ⊤)
    (hComm : ∀ p : ι, (j_loc p ≫ q_snd) =
      AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom ((algebraMap A (Localization.Away (θ p))).comp φ_A)))
    (hCov : (⨆ p : ι, W_cov p) = ⊤)
    (hOpen : ∀ p : ι, AlgebraicGeometry.IsOpenImmersion (j_loc p))
    (hPre : ∀ (j : AlgebraicGeometry.Spec (CommRingCat.of A) ⟶ Q),
      (j ≫ q_snd) = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_A) →
      (∀ p : ι, (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap A (Localization.Away (θ p)))) ≫ j) = j_loc p) →
      ∀ p : ι, j.base ⁻¹' (W_cov p : Set ↥Q) =
        Set.range (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap A (Localization.Away (θ p))))).base) :
    ∃ (j : AlgebraicGeometry.Spec (CommRingCat.of A) ⟶ Q),
      AlgebraicGeometry.IsOpenImmersion j ∧
      (j ≫ q_snd) = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_A) ∧
      (∀ p : ι, (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap A (Localization.Away (θ p)))) ≫ j) = j_loc p) ∧
      (∀ p : ι, Set.range j.base ∩ (W_cov p : Set ↥Q) = Set.range (j_loc p).base) :=
by
  
  have hOpen_α : ∀ p : ι, AlgebraicGeometry.IsOpenImmersion
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap A (Localization.Away (θ p))))) :=
    fun _ => inferInstance
  have hCovers_A : ∀ x : ↥(AlgebraicGeometry.Spec (CommRingCat.of A)),
      ∃ p : ι, ∃ y : ↥(AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (θ p)))),
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap A (Localization.Away (θ p))))) y = x := by
    intro x
    have hx1 : (1 : A) ∉ x.asIdeal :=
      fun h1 => x.isPrime.ne_top ((Ideal.eq_top_iff_one x.asIdeal).mpr h1)
    have h1_span : (1 : A) ∈ Ideal.span (Set.range θ) := by
      rw [hSpan]; trivial
    have hex : ∃ p : ι, θ p ∉ x.asIdeal := by
      refine Classical.byContradiction fun hNot => hx1 ?_
      have hle : Ideal.span (Set.range θ) ≤ x.asIdeal := by
        rw [Ideal.span_le]
        rintro _ ⟨p, rfl⟩
        exact Classical.not_not.mp (fun hp => hNot ⟨p, hp⟩)
      exact hle h1_span
    obtain ⟨p, hp⟩ := hex
    have hx_basic : x ∈ (PrimeSpectrum.basicOpen (θ p) : Set (PrimeSpectrum A)) := hp
    rw [← PrimeSpectrum.localization_away_comap_range (Localization.Away (θ p)) (θ p)] at hx_basic
    obtain ⟨y, hy⟩ := hx_basic
    exact ⟨p, y, hy⟩
  let 𝒰_A : (AlgebraicGeometry.Spec (CommRingCat.of A)).OpenCover :=
    AlgebraicGeometry.Scheme.Cover.mkOfCovers (P := @AlgebraicGeometry.IsOpenImmersion)
      ι
      (fun p => AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (θ p))))
      (fun p => AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap A (Localization.Away (θ p)))))
      hCovers_A hOpen_α

  
  have hOverlap : ∀ p p' : ι,
      CategoryTheory.Limits.pullback.fst
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap A (Localization.Away (θ p)))))
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap A (Localization.Away (θ p'))))) ≫ j_loc p =
        CategoryTheory.Limits.pullback.snd
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap A (Localization.Away (θ p)))))
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap A (Localization.Away (θ p'))))) ≫ j_loc p' := by
    intro p p'
    let α_p := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap A (Localization.Away (θ p))))
    let α_p' := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap A (Localization.Away (θ p'))))
    change CategoryTheory.Limits.pullback.fst α_p α_p' ≫ j_loc p =
      CategoryTheory.Limits.pullback.snd α_p α_p' ≫ j_loc p'
    have hEx_β : ∃ (β₁ : Localization.Away (θ p) →+* Localization.Away (θ p * θ p'))
        (β₂ : Localization.Away (θ p') →+* Localization.Away (θ p * θ p')),
        β₁.comp (algebraMap A (Localization.Away (θ p))) =
          algebraMap A (Localization.Away (θ p * θ p')) ∧
        β₂.comp (algebraMap A (Localization.Away (θ p'))) =
          algebraMap A (Localization.Away (θ p * θ p')) := by
      have hu_t : IsUnit (algebraMap A (Localization.Away (θ p * θ p')) (θ p * θ p')) :=
        IsLocalization.map_units (Localization.Away (θ p * θ p'))
          ⟨θ p * θ p', Submonoid.mem_powers (θ p * θ p')⟩
      rw [map_mul] at hu_t
      have hu_p : IsUnit (algebraMap A (Localization.Away (θ p * θ p')) (θ p)) :=
        isUnit_of_mul_isUnit_left hu_t
      have hu_p' : IsUnit (algebraMap A (Localization.Away (θ p * θ p')) (θ p')) :=
        isUnit_of_mul_isUnit_right hu_t
      refine ⟨IsLocalization.Away.lift (S := Localization.Away (θ p)) (θ p) hu_p,
        IsLocalization.Away.lift (S := Localization.Away (θ p')) (θ p') hu_p', ?_, ?_⟩
      · apply RingHom.ext
        intro a
        rw [RingHom.comp_apply]
        exact IsLocalization.Away.lift_eq (S := Localization.Away (θ p)) (θ p) hu_p a
      · apply RingHom.ext
        intro a
        rw [RingHom.comp_apply]
        exact IsLocalization.Away.lift_eq (S := Localization.Away (θ p')) (θ p') hu_p' a
    obtain ⟨β₁, β₂, hβ₁, hβ₂⟩ := hEx_β
    let α₂ := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap A (Localization.Away (θ p * θ p'))))
    let b₁ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom β₁)
    let b₂ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom β₂)
    have hb₁_α : b₁ ≫ α_p = α₂ := by
      dsimp only [b₁, α_p, α₂]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hβ₁]
    have hb₂_α : b₂ ≫ α_p' = α₂ := by
      dsimp only [b₂, α_p', α₂]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hβ₂]
    have hb_comm : b₂ ≫ α_p' = b₁ ≫ α_p := hb₂_α.trans hb₁_α.symm
    have _ : AlgebraicGeometry.IsOpenImmersion (b₂ ≫ α_p') := by
      rw [hb₂_α]; infer_instance
    have _ : AlgebraicGeometry.IsOpenImmersion b₂ :=
      AlgebraicGeometry.IsOpenImmersion.of_comp b₂ α_p'
    have hrange_ov : α_p' ⁻¹ᵁ α_p.opensRange = b₂.opensRange := by
      ext y
      simp only [TopologicalSpace.Opens.map_coe, Set.mem_preimage,
        AlgebraicGeometry.Scheme.Hom.coe_opensRange]
      constructor
      · intro hy
        have hy_inter : α_p' y ∈ Set.range ⇑α_p ∩ Set.range ⇑α_p' := ⟨hy, ⟨y, rfl⟩⟩
        have hEq_p : Set.range ⇑α_p = (PrimeSpectrum.basicOpen (θ p) : Set (PrimeSpectrum A)) :=
          PrimeSpectrum.localization_away_comap_range (Localization.Away (θ p)) (θ p)
        have hEq_p' : Set.range ⇑α_p' = (PrimeSpectrum.basicOpen (θ p') : Set (PrimeSpectrum A)) :=
          PrimeSpectrum.localization_away_comap_range (Localization.Away (θ p')) (θ p')
        have hEq_2 : Set.range ⇑α₂ =
            (PrimeSpectrum.basicOpen (θ p * θ p') : Set (PrimeSpectrum A)) :=
          PrimeSpectrum.localization_away_comap_range (Localization.Away (θ p * θ p')) (θ p * θ p')
        rw [hEq_p, hEq_p'] at hy_inter
        have hy_t : α_p' y ∈ (PrimeSpectrum.basicOpen (θ p * θ p') : Set (PrimeSpectrum A)) := by
          change α_p' y ∈ ((PrimeSpectrum.basicOpen (θ p) ⊓ PrimeSpectrum.basicOpen (θ p') :
            TopologicalSpace.Opens (PrimeSpectrum A)) : Set (PrimeSpectrum A)) at hy_inter
          rwa [← PrimeSpectrum.basicOpen_mul] at hy_inter
        rw [← hEq_2] at hy_t
        obtain ⟨w, hw⟩ := hy_t
        refine ⟨w, ?_⟩
        apply (AlgebraicGeometry.Scheme.Hom.isOpenEmbedding α_p').injective
        change (b₂ ≫ α_p') w = α_p' y
        rwa [hb₂_α]
      · rintro ⟨w, rfl⟩
        refine ⟨b₁ w, ?_⟩
        change (b₁ ≫ α_p) w = (b₂ ≫ α_p') w
        rw [hb₁_α, hb₂_α]
    have hPb_ov : CategoryTheory.IsPullback b₁ b₂ α_p α_p' :=
      AlgebraicGeometry.IsOpenImmersion.isPullback b₁ b₂ α_p α_p' hb_comm hrange_ov

    
    have hEx_ι₂ : ∃ ι₂ : Localization.Away (θ p * θ p') →+*
          Localization.Away (ι_L (θ p * θ p')),
        Function.Injective ι₂ ∧
        ι₂.comp (algebraMap A (Localization.Away (θ p * θ p'))) =
          (algebraMap L_ring (Localization.Away (ι_L (θ p * θ p')))).comp ι_L := by
      let f₂ : Localization.Away (θ p * θ p') →+* Localization.Away (ι_L (θ p * θ p')) :=
        IsLocalization.Away.map (Localization.Away (θ p * θ p'))
          (Localization.Away (ι_L (θ p * θ p'))) ι_L (θ p * θ p')
      refine ⟨f₂, ?_, IsLocalization.map_comp _⟩
      intro x₁ x₂ hx
      rw [← sub_eq_zero]
      obtain ⟨⟨a, s⟩, hs_eq⟩ :=
        IsLocalization.mk'_surjective (Submonoid.powers (θ p * θ p')) (x₁ - x₂)
      have hs_eq' : IsLocalization.mk' (Localization.Away (θ p * θ p')) a s = x₁ - x₂ := hs_eq
      rw [← hs_eq']
      have hd : f₂ (IsLocalization.mk' (Localization.Away (θ p * θ p')) a s) = 0 := by
        rw [hs_eq', map_sub, hx, sub_self]
      have h_map_a : algebraMap L_ring (Localization.Away (ι_L (θ p * θ p'))) (ι_L a) = 0 := by
        calc
          algebraMap L_ring (Localization.Away (ι_L (θ p * θ p'))) (ι_L a)
            = f₂ (algebraMap A (Localization.Away (θ p * θ p')) a) :=
              (IsLocalization.map_eq _ a).symm
          _ = f₂ (algebraMap A (Localization.Away (θ p * θ p')) (s : A) *
                IsLocalization.mk' (Localization.Away (θ p * θ p')) a s) :=
              congrArg f₂
                (IsLocalization.mk'_spec' (Localization.Away (θ p * θ p')) a s).symm
          _ = f₂ (algebraMap A (Localization.Away (θ p * θ p')) (s : A)) *
                f₂ (IsLocalization.mk' (Localization.Away (θ p * θ p')) a s) :=
              map_mul f₂ _ _
          _ = 0 := by rw [hd, mul_zero]
      rw [← IsLocalization.mk'_one (M := Submonoid.powers (ι_L (θ p * θ p')))
          (Localization.Away (ι_L (θ p * θ p'))) (ι_L a),
        IsLocalization.mk'_eq_zero_iff] at h_map_a
      obtain ⟨⟨m', k, hk_eq⟩, hm'_zero⟩ := h_map_a
      dsimp only at hk_eq hm'_zero
      have htka : (θ p * θ p') ^ k * a = 0 := by
        apply hInj
        rw [map_mul, map_pow, hk_eq, hm'_zero, map_zero]
      exact (IsLocalization.mk'_eq_zero_iff a s).mpr ⟨⟨(θ p * θ p') ^ k, k, rfl⟩, htka⟩
    obtain ⟨ι₂, hInj₂, hι₂_comp⟩ := hEx_ι₂
    let q_ov := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₂)
    have hInj_qov : Function.Injective q_ov.appTop.hom := by
      intro u₁ u₂ hu
      have hnat := AlgebraicGeometry.Scheme.ΓSpecIso_naturality (CommRingCat.ofHom ι₂)
      have hu' : (q_ov.appTop ≫
          (AlgebraicGeometry.Scheme.ΓSpecIso
            (CommRingCat.of (Localization.Away (ι_L (θ p * θ p'))))).hom).hom u₁ =
          (q_ov.appTop ≫
            (AlgebraicGeometry.Scheme.ΓSpecIso
              (CommRingCat.of (Localization.Away (ι_L (θ p * θ p'))))).hom).hom u₂ :=
        congrArg
          (AlgebraicGeometry.Scheme.ΓSpecIso
            (CommRingCat.of (Localization.Away (ι_L (θ p * θ p'))))).hom.hom hu
      rw [hnat] at hu'
      have h_isoA :
          (AlgebraicGeometry.Scheme.ΓSpecIso
            (CommRingCat.of (Localization.Away (θ p * θ p')))).hom.hom u₁ =
          (AlgebraicGeometry.Scheme.ΓSpecIso
            (CommRingCat.of (Localization.Away (θ p * θ p')))).hom.hom u₂ :=
        hInj₂ hu'
      have h_inv := congrArg
        (AlgebraicGeometry.Scheme.ΓSpecIso
          (CommRingCat.of (Localization.Away (θ p * θ p')))).inv.hom h_isoA
      change ((AlgebraicGeometry.Scheme.ΓSpecIso
          (CommRingCat.of (Localization.Away (θ p * θ p')))).hom ≫
        (AlgebraicGeometry.Scheme.ΓSpecIso
          (CommRingCat.of (Localization.Away (θ p * θ p')))).inv).hom u₁ =
        ((AlgebraicGeometry.Scheme.ΓSpecIso
            (CommRingCat.of (Localization.Away (θ p * θ p')))).hom ≫
          (AlgebraicGeometry.Scheme.ΓSpecIso
            (CommRingCat.of (Localization.Away (θ p * θ p')))).inv).hom u₂ at h_inv
      rw [CategoryTheory.Iso.hom_inv_id] at h_inv
      exact h_inv

    
    let z₁ := b₁ ≫ j_loc p
    let z₂ := b₂ ≫ j_loc p'
    have hz₁_snd : z₁ ≫ q_snd = AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom ((algebraMap A (Localization.Away (θ p * θ p'))).comp φ_A)) := by
      dsimp only [z₁, b₁]
      rw [Category.assoc, hComm p, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
        ← RingHom.comp_assoc, hβ₁]
    have hz₂_snd : z₂ ≫ q_snd = AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom ((algebraMap A (Localization.Away (θ p * θ p'))).comp φ_A)) := by
      dsimp only [z₂, b₂]
      rw [Category.assoc, hComm p', ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
        ← RingHom.comp_assoc, hβ₂]
    have hz12_snd : z₁ ≫ q_snd = z₂ ≫ q_snd := hz₁_snd.trans hz₂_snd.symm
    have hq_z₁_snd : (q_ov ≫ z₁) ≫ q_snd =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap L_ring (Localization.Away (ι_L (θ p * θ p'))))) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_L.comp φ_A)) := by
      rw [Category.assoc, hz₁_snd]
      dsimp only [q_ov]
      rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp,
        ← RingHom.comp_assoc, hι₂_comp, RingHom.comp_assoc]
    have hq_z₂_snd : (q_ov ≫ z₂) ≫ q_snd = (q_ov ≫ z₁) ≫ q_snd := by
      rw [Category.assoc, ← hz12_snd, ← Category.assoc]
    have hq_eq : q_ov ≫ z₁ = q_ov ≫ z₂ := by
      let Q_open : Q.Opens := q_snd ⁻¹ᵁ U_B
      have hRange_qz₁ : Set.range ⇑(q_ov ≫ z₁) ⊆ Set.range ⇑Q_open.ι := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        rintro _ ⟨y, rfl⟩
        change ((q_ov ≫ z₁) ≫ q_snd) y ∈ (U_B : Set ↥(AlgebraicGeometry.Spec B'))
        rw [hq_z₁_snd]
        exact hRangeL ⟨_, rfl⟩
      have hRange_qz₂ : Set.range ⇑(q_ov ≫ z₂) ⊆ Set.range ⇑Q_open.ι := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        rintro _ ⟨y, rfl⟩
        change ((q_ov ≫ z₂) ≫ q_snd) y ∈ (U_B : Set ↥(AlgebraicGeometry.Spec B'))
        rw [hq_z₂_snd, hq_z₁_snd]
        exact hRangeL ⟨_, rfl⟩
      obtain ⟨w₁, hw₁⟩ : ∃ w₁ : _ ⟶ Q_open.toScheme, w₁ ≫ Q_open.ι = q_ov ≫ z₁ :=
        ⟨AlgebraicGeometry.IsOpenImmersion.lift Q_open.ι (q_ov ≫ z₁) hRange_qz₁,
          AlgebraicGeometry.IsOpenImmersion.lift_fac Q_open.ι (q_ov ≫ z₁) hRange_qz₁⟩
      obtain ⟨w₂, hw₂⟩ : ∃ w₂ : _ ⟶ Q_open.toScheme, w₂ ≫ Q_open.ι = q_ov ≫ z₂ :=
        ⟨AlgebraicGeometry.IsOpenImmersion.lift Q_open.ι (q_ov ≫ z₂) hRange_qz₂,
          AlgebraicGeometry.IsOpenImmersion.lift_fac Q_open.ι (q_ov ≫ z₂) hRange_qz₂⟩
      have hw_eq : w₁ = w₂ := by
        apply (cancel_mono (q_snd ∣_ U_B)).mp
        apply (cancel_mono U_B.ι).mp
        rw [Category.assoc, Category.assoc, AlgebraicGeometry.morphismRestrict_ι]
        change w₁ ≫ Q_open.ι ≫ q_snd = w₂ ≫ Q_open.ι ≫ q_snd
        rw [← Category.assoc, ← Category.assoc, hw₁, hw₂, hq_z₂_snd]
      rw [← hw₁, ← hw₂, hw_eq]

    
    let Δ : Q ⟶ CategoryTheory.Limits.pullback q_snd q_snd :=
      CategoryTheory.Limits.pullback.diagonal q_snd
    have _ : AlgebraicGeometry.IsClosedImmersion Δ :=
      AlgebraicGeometry.IsSeparated.isClosedImmersion_diagonal
    let δ_z := CategoryTheory.Limits.pullback.lift z₁ z₂ hz12_snd
    have h_qov_δ : q_ov ≫ δ_z = (q_ov ≫ z₁) ≫ Δ := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_fst, Category.assoc,
          CategoryTheory.Limits.pullback.diagonal_fst, Category.comp_id]
      · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_snd, Category.assoc,
          CategoryTheory.Limits.pullback.diagonal_snd, Category.comp_id, hq_eq]
    let p₁ := CategoryTheory.Limits.pullback.fst δ_z Δ
    let p₂ := CategoryTheory.Limits.pullback.snd δ_z Δ
    let ℓ := CategoryTheory.Limits.pullback.lift q_ov (q_ov ≫ z₁) h_qov_δ
    have hℓ_p₁ : ℓ ≫ p₁ = q_ov := CategoryTheory.Limits.pullback.lift_fst q_ov (q_ov ≫ z₁) h_qov_δ
    let id_S₂ : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (θ p * θ p'))) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (θ p * θ p'))) :=
      𝟙 (AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (θ p * θ p'))))
    have hKer_eq : AlgebraicGeometry.Scheme.Hom.ker p₁ =
        AlgebraicGeometry.Scheme.Hom.ker id_S₂ := by
      apply AlgebraicGeometry.Scheme.IdealSheafData.ext_of_isAffine
      rw [AlgebraicGeometry.Scheme.Hom.ker_apply, AlgebraicGeometry.Scheme.Hom.ker_apply]
      change RingHom.ker p₁.appTop.hom = RingHom.ker id_S₂.appTop.hom
      dsimp only [id_S₂]
      rw [AlgebraicGeometry.Scheme.Hom.id_appTop]
      ext x
      simp only [RingHom.mem_ker]
      change p₁.appTop.hom x = 0 ↔ x = 0
      constructor
      · intro hx0
        apply hInj_qov
        have hcomp_app : q_ov.appTop = p₁.appTop ≫ ℓ.appTop := by
          rw [← hℓ_p₁, AlgebraicGeometry.Scheme.Hom.comp_appTop]
        calc
          q_ov.appTop.hom x = ℓ.appTop.hom (p₁.appTop.hom x) := by
            rw [hcomp_app]; rfl
          _ = 0 := by rw [hx0, map_zero]
          _ = q_ov.appTop.hom 0 := (map_zero q_ov.appTop.hom).symm
      · rintro rfl
        exact map_zero p₁.appTop.hom
    obtain ⟨r, hr_p₁⟩ : ∃ r, r ≫ p₁ = id_S₂ :=
      ⟨AlgebraicGeometry.IsClosedImmersion.lift p₁ id_S₂ (le_of_eq hKer_eq),
        AlgebraicGeometry.IsClosedImmersion.lift_fac p₁ id_S₂ (le_of_eq hKer_eq)⟩
    let s := r ≫ p₂
    have hs_Δ : s ≫ Δ = δ_z := by
      dsimp only [s]
      rw [Category.assoc, ← CategoryTheory.Limits.pullback.condition, ← Category.assoc, hr_p₁]
      exact Category.id_comp δ_z
    have hz_eq : z₁ = z₂ := by
      have hz₁_s : s = z₁ := by
        calc
          s = s ≫ 𝟙 Q := (Category.comp_id s).symm
          _ = s ≫ Δ ≫ CategoryTheory.Limits.pullback.fst q_snd q_snd := by
            rw [CategoryTheory.Limits.pullback.diagonal_fst]
          _ = δ_z ≫ CategoryTheory.Limits.pullback.fst q_snd q_snd := by
            rw [← Category.assoc, hs_Δ]
          _ = z₁ := CategoryTheory.Limits.pullback.lift_fst z₁ z₂ hz12_snd
      have hz₂_s : s = z₂ := by
        calc
          s = s ≫ 𝟙 Q := (Category.comp_id s).symm
          _ = s ≫ Δ ≫ CategoryTheory.Limits.pullback.snd q_snd q_snd := by
            rw [CategoryTheory.Limits.pullback.diagonal_snd]
          _ = δ_z ≫ CategoryTheory.Limits.pullback.snd q_snd q_snd := by
            rw [← Category.assoc, hs_Δ]
          _ = z₂ := CategoryTheory.Limits.pullback.lift_snd z₁ z₂ hz12_snd
      exact hz₁_s.symm.trans hz₂_s
    apply (cancel_epi hPb_ov.isoPullback.hom).mp
    rw [← Category.assoc, ← Category.assoc, hPb_ov.isoPullback_hom_fst, hPb_ov.isoPullback_hom_snd]
    exact hz_eq

  
  obtain ⟨j, hj_loc, hj_snd⟩ :
      ∃ j : AlgebraicGeometry.Spec (CommRingCat.of A) ⟶ Q,
        (∀ p : ι, (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap A (Localization.Away (θ p)))) ≫ j) = j_loc p) ∧
        (j ≫ q_snd) = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_A) := by
    let j₀ := 𝒰_A.glueMorphisms j_loc hOverlap
    have hj₀_loc : ∀ p : ι,
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap A (Localization.Away (θ p)))) ≫ j₀) = j_loc p :=
      fun p => 𝒰_A.ι_glueMorphisms j_loc hOverlap p
    have hj₀_snd : j₀ ≫ q_snd = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_A) := by
      apply 𝒰_A.hom_ext
      intro p
      change AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap A (Localization.Away (θ p)))) ≫ (j₀ ≫ q_snd) =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap A (Localization.Away (θ p)))) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_A)
      rw [← Category.assoc, hj₀_loc p, hComm p,
        ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    exact ⟨j₀, hj₀_loc, hj₀_snd⟩
  have hPre_j : ∀ p : ι, j.base ⁻¹' (W_cov p : Set ↥Q) =
      Set.range (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap A (Localization.Away (θ p))))).base :=
    hPre j hj_snd hj_loc
  have hj_inter : ∀ p : ι, Set.range j.base ∩ (W_cov p : Set ↥Q) = Set.range (j_loc p).base := by
    intro p
    let α_p := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap A (Localization.Away (θ p))))
    ext z
    constructor
    · rintro ⟨⟨x, rfl⟩, hzW⟩
      have hx : x ∈ j.base ⁻¹' (W_cov p : Set ↥Q) := hzW
      rw [hPre_j p] at hx
      obtain ⟨y, rfl⟩ := hx
      refine ⟨y, ?_⟩
      change (j_loc p).base y = (α_p ≫ j).base y
      rw [hj_loc p]
    · rintro ⟨y, rfl⟩
      have h_eq : (j_loc p).base y = j.base (α_p.base y) := by
        rw [← hj_loc p]; rfl
      rw [h_eq]
      refine ⟨⟨α_p.base y, rfl⟩, ?_⟩
      change α_p.base y ∈ j.base ⁻¹' (W_cov p : Set ↥Q)
      rw [hPre_j p]
      exact ⟨y, rfl⟩
  have hOpen_j : AlgebraicGeometry.IsOpenImmersion j := by
    refine AlgebraicGeometry.IsZariskiLocalAtTarget.of_iSup_eq_top
      (P := @AlgebraicGeometry.IsOpenImmersion) W_cov hCov (fun p => ?_)
    let α_p := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap A (Localization.Away (θ p))))
    have _ : AlgebraicGeometry.IsOpenImmersion (j_loc p) := hOpen p
    have hSub_W : Set.range ⇑(j_loc p) ⊆ Set.range ⇑(W_cov p).ι := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι, ← hj_inter p]
      exact Set.inter_subset_right
    obtain ⟨g_p, hg_fac⟩ : ∃ g_p : _ ⟶ (W_cov p).toScheme, g_p ≫ (W_cov p).ι = j_loc p :=
      ⟨AlgebraicGeometry.IsOpenImmersion.lift (W_cov p).ι (j_loc p) hSub_W,
        AlgebraicGeometry.IsOpenImmersion.lift_fac (W_cov p).ι (j_loc p) hSub_W⟩
    have _ : AlgebraicGeometry.IsOpenImmersion (g_p ≫ (W_cov p).ι) := by
      rw [hg_fac]; exact hOpen p
    have _ : AlgebraicGeometry.IsOpenImmersion g_p :=
      AlgebraicGeometry.IsOpenImmersion.of_comp g_p (W_cov p).ι
    have hg_comm : α_p ≫ j = g_p ≫ (W_cov p).ι := (hj_loc p).trans hg_fac.symm
    have hg_range : j ⁻¹ᵁ (W_cov p).ι.opensRange = α_p.opensRange := by
      ext x
      simp only [TopologicalSpace.Opens.map_coe, Set.mem_preimage,
        AlgebraicGeometry.Scheme.Hom.coe_opensRange, AlgebraicGeometry.Scheme.Opens.range_ι]
      change x ∈ j.base ⁻¹' (W_cov p : Set ↥Q) ↔ x ∈ Set.range α_p.base
      rw [hPre_j p]
    have hPb₁ : CategoryTheory.IsPullback g_p α_p (W_cov p).ι j :=
      AlgebraicGeometry.IsOpenImmersion.isPullback g_p α_p (W_cov p).ι j hg_comm hg_range
    have hPb₂ : CategoryTheory.IsPullback (j ∣_ W_cov p) (j ⁻¹ᵁ W_cov p).ι (W_cov p).ι j :=
      AlgebraicGeometry.isPullback_morphismRestrict j (W_cov p)
    let e_p := CategoryTheory.IsPullback.isoIsPullback _ _ hPb₁ hPb₂
    have he_p : e_p.inv ≫ g_p = j ∣_ W_cov p :=
      CategoryTheory.IsPullback.isoIsPullback_inv_fst _ _ hPb₁ hPb₂
    rw [← he_p]
    infer_instance
  exact ⟨j, hOpen_j, hj_snd, hj_loc, hj_inter⟩

theorem weil_affine_basicOpen_refinement_and_pullback_charts (Y D : AlgebraicGeometry.Scheme.{u}) (π : D ⟶ Y)
    (U_compl : Y.Opens) [CategoryTheory.IsIso (π ∣_ U_compl)] :
    (∀ {m : ℕ} (U : Y.affineOpens) (U_cov : Fin m → Y.affineOpens),
      Nontrivial ↑(Y.presheaf.obj (Opposite.op U.1)) →
      (⨆ i : Fin m, (U_cov i).1) = ⊤ →
      ∃ (q : ℕ) (s : Fin q → ↑(Y.presheaf.obj (Opposite.op U.1))) (idx : Fin q → Fin m),
        (∀ ℓ : Fin q, s ℓ ≠ 0) ∧
        Ideal.span (Set.range s) = ⊤ ∧
        (∀ ℓ : Fin q, (Y.affineBasicOpen (s ℓ)).1 ≤ (U_cov (idx ℓ)).1)) ∧
    (∀ (V : Y.affineOpens) (B_V : CommRingCat.{u})
        (φ_V : ↑(Y.presheaf.obj (Opposite.op V.1)) →+* B_V),
      CategoryTheory.IsIso
        ((CategoryTheory.Limits.pullback.snd π
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_V) ≫ V.2.fromSpec)) ∣_
