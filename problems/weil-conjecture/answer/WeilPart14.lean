      fun _ => rfl
    let α : MvPolynomial τ K →+* HomogeneousLocalization.Away 𝒜 X_a :=
      MvPolynomial.eval₂Hom ι_K u
    let dehom : MvPolynomial (Fin (N + 1)) K →+* MvPolynomial τ K :=
