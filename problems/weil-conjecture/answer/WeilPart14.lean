    let Ψ_2 : L_2 →+* L' := IsLocalization.Away.lift (m_gen 2) hu_t'c₀
    have hΨ2_alg : ∀ y : M, Ψ_2 (ι_2 y) = η' (ι_MM' y) :=
      fun y => IsLocalization.Away.lift_eq (m_gen 2) hu_t'c₀ y
    have hΨ2_comp : Ψ_2.comp tilde_Φ2 = η' := by
