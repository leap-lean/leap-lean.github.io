  exact weil_algClosed_alteration_and_bdry_of_correspondence_iso k V U_V
    B₂ U₂ hIntB₂ hProjB₂ X₂ hIntX₂ hProjX₂ f₂ n σ hFib₂ α₂ hBdry₂
    B U_B ψ hIntB hProjB hUB hψ hUBSub
    C X_B T_B f τ hCurve hIntC hProjC
    f_XB σ_B qX_B f_TB pr₁ pr₂ hCorr hIsoPr₁

theorem weil_algClosed_pointed_curve_contraction_extension (k : Type u) [Field k] [IsAlgClosed k] (m : ℕ)
