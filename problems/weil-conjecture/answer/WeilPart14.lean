      have h1 : (Ψ_2.comp tilde_Φ2) y₁ = (Ψ_2.comp tilde_Φ2) y₂ := by
        change Ψ_2 (Φ2_hom y₁).1 = Ψ_2 (Φ2_hom y₂).1
        rw [hEq]
      rwa [hΨ2_comp] at h1
    exact ⟨AlgEquiv.ofBijective Φ2_hom ⟨hΦ2_inj, hΦ2_surj⟩, hΦ2_inl, hΦ2_inr, hΦ2_prod⟩

  
  
  
  obtain ⟨ι_2, hEt_ι2, hι2_comp, hι2_gen, hPush_ι2⟩ := hPillar2 M B' ψ_q hEt_ψq m_gen g hg_eq 2
    (Localization.Away (m_gen 2))
    (Localization.Away (g 2))
  obtain ⟨Φ_2, hΦ2_inl, hΦ2_inr, hΦ2_prod⟩ := hPillar4
    (Localization.Away (m_gen 2))
    (Localization.Away (Ideal.Quotient.mk I_M' (MvPolynomial.X (Sum.inr c₀)) : M'))
  let A₂_B := ↥(Algebra.adjoin B' (Set.range fun j : Fin 3 =>
