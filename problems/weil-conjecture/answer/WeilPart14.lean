      have hg₃_et : @RingHom.Etale (MvPolynomial (Fin 1) A₃_ring) S₃_ring _ _ g₃ :=
        (HasRingHomProperty.Spec_iff (P := @Etale) (Q := @RingHom.Etale)
          (φ := hom_g₃)).mp hSpec_g₃_et
      exact ⟨r₂, φ₃, σ, g₃, q₃_raw, hp₂_r₂, hq₃, hφ₃_comp, hσφ₃, hg₃_comp, hg₃_et,
        hq₃_sec, hPre_eq⟩
    obtain ⟨r₂, φ₃, σ, g₃, q₃, _hr₂_not, hq₃_comap, hφ₃_comp, hσφ₃, hg₃_comp, hg₃_et,
        hq₃_sec, hPre_τ⟩ := hSecRetr
    let A₃_ring := Localization.Away r₂
    let S₃_ring := Localization.Away (φ₂ r₂)
    let loc_A₂ : A₂_ring →+* A₃_ring := algebraMap A₂_ring A₃_ring
    let loc_S₂ : ↑S₂ →+* S₃_ring := algebraMap (↑S₂) S₃_ring
    haveI : IsOpenImmersion (Spec.map (CommRingCat.ofHom loc_A₂)) :=
