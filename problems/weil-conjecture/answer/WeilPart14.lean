          MvPolynomial.C (Ideal.Quotient.mk I a))
        (R₁ : CommRingCat.{u}) (φ₁ : CommRingCat.of B ⟶ R₁) (_ : Etale (Spec.map φ₁))
        (w₁ : Spec R₁) (v_star : PrimeSpectrum A)
        (_ : I ≤ v_star.asIdeal)
        (_ : v_star.asIdeal ≤ Ideal.comap (φ₁.hom.comp f) w₁.asIdeal),
