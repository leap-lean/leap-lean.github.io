    clear B₁ Z_B₁ U_B₁ r_B D_B ιD_B hClD_B hZB₁_eq hChartsB₁ hU_B₁_eq C₁ f₁ n τ₁ hCurve₁ x hx h_s1 h_s2 h_s4
    let linearEquivOfAddEquiv : ∀ {κ M N : Type u} [Semiring κ] [AddCommMonoid M]
