      have hEt_comp : AlgebraicGeometry.Etale (g_lift ≫ hAffU₁.fromSpec) := by
        rwa [AlgebraicGeometry.IsOpenImmersion.lift_fac hAffU₁.fromSpec (e_B ≫ e_W) hRange_eB]
      have hEt_glift : AlgebraicGeometry.Etale g_lift :=
        AlgebraicGeometry.Etale.of_comp g_lift hAffU₁.fromSpec
      rw [← hSpec_φ_eq] at hEt_glift
      exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
        hEt_glift
    have hEt_ψet : ψ_et.Etale := by
      have h_comp : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_et) =
