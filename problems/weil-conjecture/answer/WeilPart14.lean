    have hVanMap : Ideal.map φ_ν (PrimeSpectrum.vanishingIdeal (g_ν '' S_W)) =
        PrimeSpectrum.vanishingIdeal S_W := by
      apply le_antisymm
      · rw [Ideal.map_le_iff_le_comap]
        intro a ha
        rw [Ideal.mem_comap, PrimeSpectrum.mem_vanishingIdeal]
        intro q hqS
        exact (PrimeSpectrum.mem_vanishingIdeal (g_ν '' S_W) a).mp ha (g_ν q) ⟨q, hqS, rfl⟩
      · intro b hb
        obtain ⟨a, rfl⟩ := hSurj_φ b
        refine Ideal.mem_map_of_mem φ_ν ?_
        rw [PrimeSpectrum.mem_vanishingIdeal]
        rintro _ ⟨q, hqS, rfl⟩
        exact (PrimeSpectrum.mem_vanishingIdeal S_W (φ_ν a)).mp hb q hqS
    have hIC_eq : (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal ⟨C, hClosedC⟩).ideal (W_cov ν) =
        PrimeSpectrum.vanishingIdeal S_W :=
      AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal_ideal ⟨C, hClosedC⟩ (W_cov ν)
    have hIP_eq : I_P.ideal (V_cov ν) = PrimeSpectrum.vanishingIdeal S_V :=
      AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal_ideal ⟨ι.base '' C, hClosedCP⟩ (V_cov ν)
    rw [hIC_eq, ← hVanMap, ← hPreEq, ← hIP_eq, hSpanP ν, Ideal.map_span, ← Set.range_comp]
    rfl
  · 
    intro ν μ
    refine ⟨(hAffP ν μ).preimage ι, ?_⟩
    obtain ⟨U_u, hUnitP, hEqP⟩ := hCocycleP ν μ
    let φ_νμ := (ι.app ((V_cov ν).1 ⊓ (V_cov μ).1)).hom
    refine ⟨φ_νμ U_u, hUnitP.map φ_νμ, ?_⟩
    intro a
    have h_nat_left :
        (X.left.presheaf.map (CategoryTheory.homOfLE
          (inf_le_left : (W_cov ν).1 ⊓ (W_cov μ).1 ≤ (W_cov ν).1)).op).hom (h ν a) =
        φ_νμ (((AlgebraicGeometry.Proj 𝒜).presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (H ν a)) := by
      dsimp only [h, φ_νμ]
      have hnat := ι.naturality (CategoryTheory.homOfLE (inf_le_left : (V_cov ν).1 ⊓ (V_cov μ).1 ≤ (V_cov ν).1)).op
      exact (ConcreteCategory.congr_hom hnat (H ν a)).symm
    have h_nat_right :
        (X.left.presheaf.map (CategoryTheory.homOfLE
          (inf_le_right : (W_cov ν).1 ⊓ (W_cov μ).1 ≤ (W_cov μ).1)).op).hom (h μ a) =
        φ_νμ (((AlgebraicGeometry.Proj 𝒜).presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom (H μ a)) := by
      dsimp only [h, φ_νμ]
      have hnat := ι.naturality (CategoryTheory.homOfLE (inf_le_right : (V_cov ν).1 ⊓ (V_cov μ).1 ≤ (V_cov μ).1)).op
      exact (ConcreteCategory.congr_hom hnat (H μ a)).symm
    rw [h_nat_left, h_nat_right, hEqP a, map_mul]
    rfl

theorem weil_smooth_center_graph_closure_zariski_blowup (k : Type u) [Field k]
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hIntX : AlgebraicGeometry.IsIntegral X.left)
    (hProjX : IsProjectiveOverField k X)
    [TopologicalSpace.NoetherianSpace ↥X.left]
    (C : Set X.left) (hClosedC : IsClosed C) (hProperC : C ≠ Set.univ)
    (M L : ℕ) (W_cov : Fin (M + 1) → X.left.affineOpens)
    (h : ∀ ν : Fin (M + 1), Fin (L + 1) → ↑(X.left.presheaf.obj (Opposite.op (W_cov ν).1)))
    (hCov : (⨆ ν : Fin (M + 1), (W_cov ν).1) = ⊤)
    (hSpan : ∀ ν : Fin (M + 1),
      (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal ⟨C, hClosedC⟩).ideal (W_cov ν) =
        Ideal.span (Set.range (h ν)))
    (hCocycle : ∀ ν μ : Fin (M + 1),
      AlgebraicGeometry.IsAffineOpen ((W_cov ν).1 ⊓ (W_cov μ).1) ∧
      ∃ u : ↑(X.left.presheaf.obj (Opposite.op ((W_cov ν).1 ⊓ (W_cov μ).1))),
        IsUnit u ∧
        ∀ a : Fin (L + 1),
          (X.left.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (h ν a) =
            u * (X.left.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom (h μ a)) :
    ∃ (X' : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (π : X' ⟶ X),
      AlgebraicGeometry.IsIntegral X'.left ∧
      IsProjectiveOverField k X' ∧
      IsGenFiniteEtaleAlterationOver k π ∧
      IsSmoothCenterZariskiBlowup k C W_cov h π :=
by
  
  let I : X.left.IdealSheafData :=
    AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal ⟨C, hClosedC⟩
  let U_compl : X.left.Opens := ⟨Cᶜ, hClosedC.isOpen_compl⟩
  have hSupp_eq : (I.support : Set X.left) = C :=
    AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal ⟨C, hClosedC⟩
  have hSupp : (I.support : Set X.left) ≠ Set.univ := hSupp_eq.symm ▸ hProperC
  have hU_compl : (U_compl : Set X.left) = (I.support : Set X.left)ᶜ :=
    congrArg compl hSupp_eq.symm
  have hCocycle' : ∀ ν μ : Fin (M + 1),
      AlgebraicGeometry.IsAffineOpen ((W_cov ν).1 ⊓ (W_cov μ).1) ∧
      ∃ u : ↑(X.left.presheaf.obj (Opposite.op ((W_cov ν).1 ⊓ (W_cov μ).1))),
        IsUnit u ∧
        ∀ a : Fin (L + 1),
          X.left.presheaf.map (CategoryTheory.homOfLE inf_le_left).op (h ν a) =
            u * X.left.presheaf.map (CategoryTheory.homOfLE inf_le_right).op (h μ a) := by
    intro ν μ
    obtain ⟨hAff, u, hu, hEq⟩ := hCocycle ν μ
    exact ⟨hAff, u, hu, fun a => hEq a⟩
  obtain ⟨Φ₀, hRat⟩ :=
    weil_cocycle_rational_map_to_proj k X I U_compl hU_compl (M + 1) W_cov L h hCov hSpan hCocycle'
  have hΦ₀ : Φ₀ ≫ (weilProjectiveSpaceOver k L).hom = U_compl.ι ≫ X.hom := hRat.2.2.2.2.1
  let P_L := weilProjectiveSpaceOver k L
  let δ : U_compl.toScheme ⟶ CategoryTheory.Limits.pullback X.hom P_L.hom :=
    CategoryTheory.Limits.pullback.lift U_compl.ι Φ₀ hΦ₀.symm
  let π_left : δ.image ⟶ X.left :=
    δ.imageι ≫ CategoryTheory.Limits.pullback.fst X.hom P_L.hom
  let X' : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    CategoryTheory.Over.mk (π_left ≫ X.hom)
  let π : X' ⟶ X := CategoryTheory.Over.homMk π_left rfl
  obtain ⟨hIntX', hPropπ, hSurjπ, hIsoDisj⟩ :=
    weil_graph_closure_blowup_proper_surj_iso k X hIntX I hSupp U_compl hU_compl L Φ₀ hΦ₀
  have hZar_open : ∀ U₀ : X.left.Opens, Disjoint (U₀ : Set X.left) C →
      CategoryTheory.IsIso (π.left ∣_ U₀) := by
    intro U₀ hDisj
    exact hIsoDisj U₀ (hSupp_eq.symm ▸ hDisj)
  have hAltπ : IsGenFiniteEtaleAlterationOver k π := by
    obtain ⟨x₀, hx₀⟩ := Set.nonempty_compl.mpr hProperC
    have hNeU : Nonempty U_compl := ⟨⟨x₀, hx₀⟩⟩
    have : CategoryTheory.IsIso (π.left ∣_ U_compl) := hZar_open U_compl disjoint_compl_left
    exact ⟨hPropπ, hSurjπ, U_compl, hNeU, inferInstance, inferInstance, inferInstance⟩
  
  let B₀ := weilProjectiveSpaceOver k 0
  have hB₀ := weil_projectiveSpace_integral_krullDim_and_dim_zero_iso k 0
  have hProjB₀ : IsProjectiveOverField k B₀ := hB₀.2.1
  have : CategoryTheory.IsIso B₀.hom := hB₀.2.2.2 rfl
  have hProjPL : IsProjectiveOverField k P_L :=
    (weil_projectiveSpace_integral_krullDim_and_dim_zero_iso k L).2.1
  let P_XL : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    CategoryTheory.Over.mk (CategoryTheory.Limits.pullback.fst X.hom P_L.hom ≫ X.hom)
  let f_X : X ⟶ B₀ := CategoryTheory.Over.homMk (X.hom ≫ CategoryTheory.inv B₀.hom) (by
    rw [CategoryTheory.Category.assoc, CategoryTheory.IsIso.inv_hom_id,
      CategoryTheory.Category.comp_id])
  let f_P : P_L ⟶ B₀ := CategoryTheory.Over.homMk (P_L.hom ≫ CategoryTheory.inv B₀.hom) (by
    rw [CategoryTheory.Category.assoc, CategoryTheory.IsIso.inv_hom_id,
      CategoryTheory.Category.comp_id])
  let p_fst : P_XL ⟶ X :=
    CategoryTheory.Over.homMk (CategoryTheory.Limits.pullback.fst X.hom P_L.hom) rfl
  let p_snd : P_XL ⟶ P_L :=
    CategoryTheory.Over.homMk (CategoryTheory.Limits.pullback.snd X.hom P_L.hom)
      CategoryTheory.Limits.pullback.condition.symm
  have hPb_XL : CategoryTheory.IsPullback p_fst.left p_snd.left f_X.left f_P.left :=
    CategoryTheory.IsPullback.of_isLimit
      (CategoryTheory.Limits.pullbackIsPullbackOfCompMono X.hom P_L.hom (CategoryTheory.inv B₀.hom))
  obtain ⟨N_pb, ι_pb, hCl_pb⟩ :=
    weil_projectiveOverField_pullback k f_X f_P p_snd p_fst hPb_XL hProjB₀ hProjX hProjPL
  let j_X' : X' ⟶ P_XL :=
    CategoryTheory.Over.homMk δ.imageι (CategoryTheory.Category.assoc _ _ _).symm
  have hProjX' : IsProjectiveOverField k X' := by
    have : AlgebraicGeometry.IsClosedImmersion ι_pb.left := hCl_pb
    refine ⟨N_pb, j_X' ≫ ι_pb, ?_⟩
    change AlgebraicGeometry.IsClosedImmersion (δ.imageι ≫ ι_pb.left)
    infer_instance
  
  let 𝒜_L := MvPolynomial.homogeneousSubmodule (Fin (L + 1)) k
  let _ : GradedAlgebra 𝒜_L := MvPolynomial.gradedAlgebra
  let C_L : Fin (L + 1) → Type u := fun a => HomogeneousLocalization.Away 𝒜_L (MvPolynomial.X a)
  let w_L : ∀ a : Fin (L + 1),
      AlgebraicGeometry.Spec (CommRingCat.of (C_L a)) ⟶ P_L.left :=
    fun a => AlgebraicGeometry.Proj.awayι 𝒜_L (MvPolynomial.X a)
      (MvPolynomial.isHomogeneous_X k a) zero_lt_one
  let p₂_left : δ.image ⟶ P_L.left :=
    δ.imageι ≫ CategoryTheory.Limits.pullback.snd X.hom P_L.hom
  obtain ⟨hCov_w, hLocalRees⟩ :=
    weil_graph_closure_local_rees_charts k X U_compl W_cov L h Φ₀ hΦ₀
  refine ⟨X', π, hIntX', hProjX', hAltπ, hZar_open, ?_⟩
  intro ν
  let R_ν := ↑(X.left.presheaf.obj (Opposite.op (W_cov ν).1))
  let P_chart : Fin (L + 1) → (Fin (L + 1) → R_ν) → Prop := fun a f =>
    ∃ (ι_img : AlgebraicGeometry.Spec
          (CommRingCat.of ↥(weilSmoothCenterReesSubalg R_ν f a)) ⟶ δ.image)
      (ψ_sub : C_L a →+* ↥(weilSmoothCenterReesSubalg R_ν f a)),
      AlgebraicGeometry.IsOpenImmersion ι_img ∧
      (ι_img ≫ π_left =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap R_ν ↥(weilSmoothCenterReesSubalg R_ν f a))) ≫
          (W_cov ν).2.fromSpec) ∧
      (ι_img ≫ p₂_left = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_sub) ≫ w_L a) ∧
      ((π_left.base ⁻¹' ((W_cov ν).1 : Set X.left)) ∩
        (p₂_left.base ⁻¹' Set.range (w_L a).base) = Set.range ι_img.base) ∧
      (∀ a' : Fin (L + 1),
        (ψ_sub (HomogeneousLocalization.Away.isLocalizationElem (𝒜 := 𝒜_L)
          (MvPolynomial.isHomogeneous_X k a) (MvPolynomial.isHomogeneous_X k a'))).1 =
        weilSmoothCenterReesRatio R_ν f a a')
  have hCharts_ν : ∀ a : Fin (L + 1), P_chart a (h ν) := by
    intro a
    let h_V : Fin (L + 1) → R_ν :=
      fun β => X.left.presheaf.map (CategoryTheory.homOfLE (le_rfl : (W_cov ν).1 ≤ (W_cov ν).1)).op
        (h ν β)
    obtain ⟨ι_Va, ψ_Va, hOpen_Va, hU_Va, hΦ_Va, hPre_Va, hPsi_Va⟩ :=
      hRat.2.2.2.2.2 ν (W_cov ν) le_rfl a
    have hP_id : P_chart a h_V :=
      hLocalRees ν (W_cov ν) le_rfl a ι_Va ψ_Va hOpen_Va hU_Va hΦ_Va hPre_Va hPsi_Va
    have hh_V : h_V = h ν := by
      funext β
      dsimp [h_V]
      rw [X.left.presheaf.map_id]
      rfl
    exact hh_V ▸ hP_id
  choose ι_img ψ_sub hOpen_img hFst_img hSnd_img hRange_img hPsi_img using hCharts_ν
  have : ∀ a : Fin (L + 1), AlgebraicGeometry.IsOpenImmersion (ι_img a) := hOpen_img
  let O_chart : Fin (L + 1) → X'.left.Opens := fun a => (ι_img a).opensRange
  refine ⟨O_chart, ?_, ?_, ?_⟩
  · apply TopologicalSpace.Opens.ext
    ext x'
    rw [TopologicalSpace.Opens.coe_iSup, Set.mem_iUnion]
    change (∃ a : Fin (L + 1), x' ∈ Set.range (ι_img a).base) ↔
      π_left.base x' ∈ ((W_cov ν).1 : Set X.left)
    constructor
    · rintro ⟨a, hx'⟩
      rw [← hRange_img a] at hx'
      exact hx'.1
    · intro hx'W
      have hx'P : p₂_left.base x' ∈ (⋃ a : Fin (L + 1), Set.range (w_L a).base) := by
        change p₂_left.base x' ∈
          (⋃ a : Fin (L + 1), Set.range (AlgebraicGeometry.Proj.awayι 𝒜_L (MvPolynomial.X a)
            (MvPolynomial.isHomogeneous_X k a) zero_lt_one).base)
        rw [hCov_w]
        exact Set.mem_univ _
      rw [Set.mem_iUnion] at hx'P
      obtain ⟨a, hx'a⟩ := hx'P
      refine ⟨a, ?_⟩
      rw [← hRange_img a]
      exact ⟨hx'W, hx'a⟩
  · intro a hh0
    have h0mem : (0 : R_ν) ∈ Submonoid.powers (h ν a) := ⟨1, by dsimp; rw [pow_one, hh0]⟩
    have : Subsingleton (Localization.Away (h ν a)) :=
      IsLocalization.subsingleton (R := R_ν) (M := Submonoid.powers (h ν a))
        (S := Localization.Away (h ν a)) h0mem
    have : Subsingleton ↥(weilSmoothCenterReesSubalg R_ν (h ν) a) :=
      ⟨fun x y => Subtype.ext (Subsingleton.elim x.1 y.1)⟩
    apply TopologicalSpace.Opens.ext
    ext x'
    simp only [TopologicalSpace.Opens.coe_bot, Set.mem_empty_iff_false, iff_false]
    rintro ⟨z, _⟩
    exact z.isPrime.ne_top (Subsingleton.elim z.asIdeal ⊤)
  · intro a _hne
    let B_a := weilSmoothCenterReesSubalg R_ν (h ν) a
    let isoO : (O_chart a).toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of ↥B_a) :=
      ((ι_img a).isoOpensRange).symm
    have h_ι_iso : (O_chart a).ι = isoO.hom ≫ ι_img a := by
      have h1 := congrArg (fun f => ((ι_img a).isoOpensRange).inv ≫ f)
        (AlgebraicGeometry.Scheme.Hom.isoOpensRange_hom_ι (ι_img a)).symm
      exact (h1.trans
        (CategoryTheory.Iso.inv_hom_id_assoc ((ι_img a).isoOpensRange) (O_chart a).ι)).symm
    refine ⟨isoO, ?_, ?_⟩
    · change (O_chart a).ι ≫ π_left = _
      rw [h_ι_iso, CategoryTheory.Category.assoc, hFst_img a]
    · intro a'
      let r_aa' : ↥B_a :=
        ⟨weilSmoothCenterReesRatio R_ν (h ν) a a', Algebra.subset_adjoin ⟨a', rfl⟩⟩
      let z_aa' : C_L a :=
        HomogeneousLocalization.Away.isLocalizationElem (𝒜 := 𝒜_L)
          (MvPolynomial.isHomogeneous_X k a) (MvPolynomial.isHomogeneous_X k a')
      have hψ_r : ψ_sub a z_aa' = r_aa' := Subtype.ext (hPsi_img a a')
      have hR_wa' := AlgebraicGeometry.Proj.opensRange_awayι 𝒜_L (MvPolynomial.X a')
        (MvPolynomial.isHomogeneous_X k a') zero_lt_one
      have hComp_p₂ : (O_chart a).ι ≫ p₂_left =
          isoO.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_sub a)) ≫ w_L a := by
        rw [h_ι_iso, CategoryTheory.Category.assoc, hSnd_img a]
      have hPre_w : (TopologicalSpace.Opens.map (w_L a).base).obj
          (AlgebraicGeometry.Proj.basicOpen 𝒜_L (MvPolynomial.X a')) =
          PrimeSpectrum.basicOpen z_aa' :=
        AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜_L
          (MvPolynomial.isHomogeneous_X k a) zero_lt_one
          (MvPolynomial.isHomogeneous_X k a') zero_lt_one
      have hPre_spec : (TopologicalSpace.Opens.map
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_sub a))).base).obj
          (PrimeSpectrum.basicOpen z_aa') = PrimeSpectrum.basicOpen r_aa' := by
        rw [AlgebraicGeometry.SpecMap_preimage_basicOpen]
        change PrimeSpectrum.basicOpen (ψ_sub a z_aa') = PrimeSpectrum.basicOpen r_aa'
        rw [hψ_r]
      ext y
      have hy_O : (O_chart a).ι.base y ∈ Set.range (ι_img a).base := y.2
      rw [← hRange_img a] at hy_O
      have hy_W : π_left.base ((O_chart a).ι.base y) ∈ ((W_cov ν).1 : Set X.left) := hy_O.1
      let v : PrimeSpectrum ↥B_a := isoO.hom.base y
      let u : PrimeSpectrum (C_L a) :=
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_sub a))).base v
      have h1 : r_aa' ∉ v.asIdeal ↔ v ∈ PrimeSpectrum.basicOpen r_aa' :=
        (PrimeSpectrum.mem_basicOpen r_aa' v).symm
      have h2 : v ∈ PrimeSpectrum.basicOpen r_aa' ↔ u ∈ PrimeSpectrum.basicOpen z_aa' := by
        rw [← hPre_spec]
        rfl
      have h3 : u ∈ PrimeSpectrum.basicOpen z_aa' ↔
          (w_L a).base u ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_L (MvPolynomial.X a') := by
        rw [← hPre_w]
        rfl
      have hPt : (w_L a).base u = p₂_left.base ((O_chart a).ι.base y) := by
        change (isoO.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_sub a)) ≫ w_L a).base y =
          ((O_chart a).ι ≫ p₂_left).base y
        rw [hComp_p₂]
      have h4 : p₂_left.base ((O_chart a).ι.base y) ∈
            AlgebraicGeometry.Proj.basicOpen 𝒜_L (MvPolynomial.X a') ↔
          p₂_left.base ((O_chart a).ι.base y) ∈ Set.range (w_L a').base :=
        Set.ext_iff.mp (congrArg TopologicalSpace.Opens.carrier hR_wa').symm
          (p₂_left.base ((O_chart a).ι.base y))
      change r_aa' ∉ v.asIdeal ↔ (O_chart a).ι.base y ∈ Set.range (ι_img a').base
      rw [h1, h2, h3, hPt, h4, ← hRange_img a']
      exact ⟨fun hp₂ => ⟨hy_W, hp₂⟩, fun h => h.2⟩

theorem weil_smooth_center_etale_rees_nc_transfer (k : Type u) [Field k]
    (m b : ℕ) (hb : b + 1 ≤ m)
    (S' : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hIntS' : AlgebraicGeometry.IsIntegral S'.left)
    (q : ℕ) (H : Fin q → AlgebraicGeometry.Scheme.{u})
    (ιH : ∀ a : Fin q, H a ⟶ S'.left) (Z_nc : Set S'.left)
    (s : ℕ) (hs : 0 < s) (C_comp : Fin s → AlgebraicGeometry.Scheme.{u})
    (ιC : ∀ β : Fin s, C_comp β ⟶ S'.left)
    (hCenter : IsMaxMultiplicityNcCenter k m b S' q H ιH Z_nc s C_comp ιC) :
    let C : Set S'.left := ⋃ β : Fin s, Set.range (ιC β).base
    (IsClosed C ∧ C ≠ Set.univ) ∧
    ∀ (hClosedC : IsClosed C) (M L : ℕ)
      (W_cov : Fin (M + 1) → S'.left.affineOpens)
      (h : ∀ ν : Fin (M + 1), Fin (L + 1) → ↑(S'.left.presheaf.obj (Opposite.op (W_cov ν).1)))
      (_ : (⨆ ν : Fin (M + 1), (W_cov ν).1) = ⊤)
      (_ : ∀ ν : Fin (M + 1),
        (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal ⟨C, hClosedC⟩).ideal (W_cov ν) =
          Ideal.span (Set.range (h ν)))
      (S'' : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (π : S'' ⟶ S')
      (_ : IsSmoothCenterZariskiBlowup k C W_cov h π),
      let K_comb : Fin (q + s) → Set S''.left := fun c =>
        match finSumFinEquiv.symm c with
        | Sum.inl a => π.left.base ⁻¹' Set.range (ιH a).base
        | Sum.inr β => π.left.base ⁻¹' Set.range (ιC β).base
      let Z'_nc : Set S''.left := closure (π.left.base ⁻¹' (Z_nc \ C))
      (∀ a : Fin q, ¬ Set.range (ιH a).base ⊆ C) ∧
      (∀ c : Fin (q + s), IsIrreducible (K_comb c)) ∧
      (∀ w : S''.left,
        ∃ (R'' : CommRingCat.{u}) (_ : IsDomain R'')
          (w₀ : AlgebraicGeometry.Spec R'')
          (e''_S : AlgebraicGeometry.Spec R'' ⟶ S''.left)
          (ψ'' : MvPolynomial (Fin (m + 1)) k →+* R'')
          (α''_snc : {c : Fin (q + s) // w ∈ K_comb c} → Fin (m + 1))
          (I''_nc : Finset (Fin (m + 1))),
          AlgebraicGeometry.Etale e''_S ∧
