          (w₀ : Spec R'')
          (φ_out : R₁ ⟶ R'')
          (ψ''_out : MvPolynomial (Fin (m₀ + 1)) k₀ →+* R'')
          (I''_nc : Finset (Fin (m₀ + 1))),
          IsOpenImmersion (Spec.map φ_out) ∧
          Etale (Spec.map (CommRingCat.ofHom ψ''_out)) ∧
          (∀ p, ψ''_out p = φ_out.hom (ψ_loc p)) ∧
          (Spec.map φ_out).base w₀ = w₁ ∧
          I''_nc ⊆ I_nc.erase j_piv ∧
          (∀ j ∈ I''_nc, ψ''_out (MvPolynomial.X j) ∈ w₀.asIdeal) ∧
          {p : Spec R'' | ∃ j ∈ I_nc.erase j_piv, ψ''_out (MvPolynomial.X j) ∈ p.asIdeal} =
            {p : Spec R'' | ∃ j ∈ I''_nc, ψ''_out (MvPolynomial.X j) ∈ p.asIdeal} := by
    clear * - filter_away_commRingCat
    intro k _ m R' B₀ _ _ f ψ ψ'' hEt_ψ'' I_nc j_piv hjpiv_mem hpiv_eq hother_mul R₁ _ φ₁ hEt_φ₁ w₁
    intro ψ_loc
    have _ : Etale (Spec.map (CommRingCat.ofHom ψ'')) :=
      (HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hEt_ψ''
    have hEt_Spec_loc : Etale (Spec.map (CommRingCat.ofHom ψ_loc)) := by
      have hComp : Spec.map (CommRingCat.ofHom ψ_loc) =
