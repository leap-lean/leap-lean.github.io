  have hIrrel : ∀ (K : Type u) [Field K],
      let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K
      let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
      (HomogeneousIdeal.irrelevant 𝒜).toIdeal ≤
        Ideal.span (Set.range (MvPolynomial.X : Fin (N + 1) → MvPolynomial (Fin (N + 1)) K)) := by
    intro K _
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    change (HomogeneousIdeal.irrelevant 𝒜).toIdeal ≤
      Ideal.span (Set.range (MvPolynomial.X : Fin (N + 1) → MvPolynomial (Fin (N + 1)) K))
    intro p hp
    have hp0 : MvPolynomial.homogeneousComponent 0 p = 0 := by
      have hmem : p ∈ HomogeneousIdeal.irrelevant 𝒜 := hp
      rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply] at hmem
      exact (MvPolynomial.decompose'_apply K (1 : Fin (N + 1) → ℕ) p 0).symm.trans hmem
    have hcoeff0 : p.coeff 0 = 0 := by
      have h0 := congrArg (fun q : MvPolynomial (Fin (N + 1)) K => q.coeff 0) hp0
      simpa [MvPolynomial.coeff_homogeneousComponent] using h0
    rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
    intro m hm
    have hm_ne : m ≠ 0 := by
      intro h
      subst h
      exact (MvPolynomial.mem_support_iff.mp hm) hcoeff0
    by_contra! h_all
    apply hm_ne
    ext i
    exact h_all i (Set.mem_univ i)
  have hPowDegEq : ∀ (K : Type u) [Field K] (a : Fin (N + 1)) (n d : ℕ),
      ((MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K) ^ n).IsHomogeneous d → d = n := by
    intro K _ a n d hd
    have hn : ((MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K) ^ n).IsHomogeneous n := by
      simpa using (MvPolynomial.isHomogeneous_X K a).pow n
