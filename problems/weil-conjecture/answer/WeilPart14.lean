            (Algebra.TensorProduct.map awayL₁ awayL₂).commutes c
          rw [h_τc]
          change L₂ (HomogeneousLocalization.val (algebraMap k C₂ c)) = _
          have hval : HomogeneousLocalization.val (algebraMap k C₂ c) =
              Localization.mk (MvPolynomial.C c) 1 := rfl
          rw [hval, hL₂_one]
          dsimp only [G, RingHom.comp_apply]
          rw [MvPolynomial.eval₂Hom_C, h_τc]
        · change ψ_ov (awayL_N (HomogeneousLocalization.Away.isLocalizationElem (hX_N ν) (hX_N μ))) =
            τ_L (φ ij (HomogeneousLocalization.Away.isLocalizationElem (hX_N ν) (hX_N μ)))
          change L₂ (HomogeneousLocalization.val
            (awayL_N (HomogeneousLocalization.Away.isLocalizationElem (hX_N ν) (hX_N μ)))) = _
          have hval : HomogeneousLocalization.val
              (awayL_N (HomogeneousLocalization.Away.isLocalizationElem (hX_N ν) (hX_N μ))) =
              Localization.mk (X_N μ ^ 1 * X_N ν' ^ 1)
                ⟨(X_N ν * X_N ν') ^ 1,
                  Submonoid.pow_mem _ (Submonoid.mem_powers _) 1⟩ := by
            dsimp only [awayL_N, HomogeneousLocalization.Away.isLocalizationElem]
            rw [HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.Away.val_mk]
          rw [hval, hL₂_s₁ _ _ rfl, pow_one, pow_one, map_mul]
