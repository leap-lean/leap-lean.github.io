              rw [map_mul, map_mul, hXeq, sub_mul]
            rw [hmul]
            exact Ideal.mul_mem_right _ _ hp
      intro f hf
      change ev f = 0 at hf
      have hSubf := hSub f
      rw [hf, map_zero, sub_zero] at hSubf
      exact hSubf
  
