            ∀ j ∈ I_nc, ψ (MvPolynomial.X j) ∈ v.asIdeal := by
          dsimp only [I_rhs]
          rw [PrimeSpectrum.zeroLocus_span, PrimeSpectrum.mem_zeroLocus]
          simp [Set.subset_def]
        rw [hv_lhs, hv_rhs]
        change (v : Spec (CommRingCat.of R')) ∈ e_loc.base ⁻¹' (e_S₀.base ⁻¹' Set.range (ιC β₁).base) ↔ _
        rw [hPreCβ₁]
        rfl
      change I_lhs = I_rhs
      rw [← hLhs_rad.radical, ← hRhs_rad.radical]
      exact PrimeSpectrum.zeroLocus_eq_iff.mp hZL
  
  have goingDown_loc_of_quot_equiv :
