        have hφ_q : AlgebraicGeometry.Spec.map φ_q = q := AlgebraicGeometry.Spec.map_preimage q
        have hq_mem : ∀ (w : AlgebraicGeometry.Spec R') (m₀ : M),
            m₀ ∈ (q.base w).asIdeal ↔ φ_q.hom m₀ ∈ w.asIdeal := by
          intro w m₀
          rw [← hφ_q]
          rfl
        let ψ' : MvPolynomial (Fin (m + 1)) k →+* R' := φ_q.hom.comp Θ.toRingHom
        have : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom Θ.toRingHom)) :=
          (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
            (RingHom.Etale.of_bijective Θ.bijective)
        have hSpec_ψ' : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ') =
            q ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Θ.toRingHom) := by
          rw [← hφ_q]
          dsimp [ψ']
          rw [← AlgebraicGeometry.Spec.map_comp]
        have hEt_ψ' : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ')) := by
          rw [hSpec_ψ']
          exact inferInstance
        have hComm_ψ' : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ') ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = e_Y ≫ Y.hom := by
          rw [hSpec_ψ', Category.assoc]
          have hΘ_C : AlgebraicGeometry.Spec.map (CommRingCat.ofHom Θ.toRingHom) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) =
              AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom ((Ideal.Quotient.mk I_F).comp MvPolynomial.C)) := by
            rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
            congr 2
            exact RingHom.ext Θ.commutes
          rw [hΘ_C, hComm]
        let I : Finset (Fin (m + 1)) :=
          insert 0 (insert (Fin.succ c₁) ((S_bdry.erase c₁).image Fin.succ))
        have hc₁_bdry : c₁ ∈ S_bdry := hSubBdry c₁ (by omega)
        refine ⟨R', w₀, e_Y, ψ', I, hEt_e, hEt_ψ', hw₀, hComm_ψ', ?_, ?_⟩
        · intro i hi
          simp only [I, Finset.mem_insert, Finset.mem_image, Finset.mem_erase] at hi
          rcases hi with rfl | rfl | ⟨c, ⟨hcc₁, hcS⟩, rfl⟩
          · change φ_q.hom (Θ (MvPolynomial.X 0)) ∈ w₀.asIdeal
            rw [hΘ0, ← hq_mem]
            exact hAllInl 0
          · change φ_q.hom (Θ (MvPolynomial.X (Fin.succ c₁))) ∈ w₀.asIdeal
            rw [hΘc₁, ← hq_mem]
            exact hAllInl 1
          · change φ_q.hom (Θ (MvPolynomial.X (Fin.succ c))) ∈ w₀.asIdeal
            rw [hΘother c hcc₁, ← hq_mem]
            exact hInr_w₀ c hcS
        · rw [hZ_Y]
          ext w
          have : w.asIdeal.IsPrime := w.isPrime
          simp only [Set.mem_setOf_eq, I, Finset.mem_insert, Finset.mem_image, Finset.mem_erase]
          constructor
          · rintro ⟨c, hcS, hcMem⟩
            rw [hq_mem] at hcMem
            by_cases hcc₁ : c = c₁
            · subst hcc₁
              rw [hProd_c₁, map_mul] at hcMem
              rcases w.isPrime.mem_or_mem hcMem with h0 | h1
              · exact ⟨0, Or.inl rfl, h0⟩
              · exact ⟨Fin.succ c, Or.inr (Or.inl rfl), h1⟩
            · refine ⟨Fin.succ c, Or.inr (Or.inr ⟨c, ⟨hcc₁, hcS⟩, rfl⟩), ?_⟩
              change φ_q.hom (Θ (MvPolynomial.X (Fin.succ c))) ∈ w.asIdeal
              rwa [hΘother c hcc₁]
          · rintro ⟨i, rfl | rfl | ⟨c, ⟨hcc₁, hcS⟩, rfl⟩, hiMem⟩
            · refine ⟨c₁, hc₁_bdry, ?_⟩
              rw [hq_mem, hProd_c₁, map_mul]
              exact Ideal.mul_mem_right _ w.asIdeal hiMem
            · refine ⟨c₁, hc₁_bdry, ?_⟩
              rw [hq_mem, hProd_c₁, map_mul]
              exact Ideal.mul_mem_left w.asIdeal _ hiMem
            · refine ⟨c, hcS, ?_⟩
              rw [hq_mem, ← hΘother c hcc₁]
              exact hiMem
    · 
      push_neg at hAllInl
      obtain ⟨b, hb⟩ := hAllInl
      let u_b : M := Ideal.Quotient.mk I_F (MvPolynomial.X (Sum.inl b))
      obtain ⟨ψ₀, hEt_ψ₀, hC_ψ₀, hInr_ψ₀⟩ := hAwayElim a' b I_F rfl
      obtain ⟨R₁, w₁, e₁, ι₁, ψ₁, hEt_e₁, hEt_ψ₁, rfl, hw₁_base, hComm₁, hMem_iff⟩ :=
        hRoofLift M ((Ideal.Quotient.mk I_F).comp MvPolynomial.C) R' w₀ e_Y q
          hEt_e hEt_q hw₀ hComm u_b ψ₀ hb hEt_ψ₀ hC_ψ₀
      refine ⟨R₁, w₁, ι₁ ≫ e_Y, ψ₁, S_bdry.image Fin.succ, hEt_e₁, hEt_ψ₁, ?_, hComm₁, ?_, ?_⟩
      · change e_Y.base (ι₁.base w₁) = y
        rw [hw₁_base, hw₀]
      · intro i hi
        obtain ⟨c, hcS, rfl⟩ := Finset.mem_image.mp hi
        rw [hMem_iff (MvPolynomial.X (Fin.succ c)) _ (hInr_ψ₀ c) w₁, hw₁_base]
        exact hInr_w₀ c hcS
      · have hEqPre : (ι₁ ≫ e_Y).base ⁻¹' Z_Y = ι₁.base ⁻¹' (e_Y.base ⁻¹' Z_Y) := rfl
        rw [hEqPre, hZ_Y]
        ext w
        simp only [Set.mem_preimage, Set.mem_setOf_eq, Finset.mem_image]
        constructor
        · rintro ⟨c, hcS, hcMem⟩
          refine ⟨Fin.succ c, ⟨c, hcS, rfl⟩, ?_⟩
          exact (hMem_iff (MvPolynomial.X (Fin.succ c)) _ (hInr_ψ₀ c) w).mpr hcMem
        · rintro ⟨_, ⟨c, hcS, rfl⟩, hiMem⟩
          refine ⟨c, hcS, ?_⟩
          exact (hMem_iff (MvPolynomial.X (Fin.succ c)) _ (hInr_ψ₀ c) w).mp hiMem

theorem weil_toroidal_state_noncontainment_and_vanishingIdeal_pullback (k : Type u) [Field k] (m : ℕ)
    (X : AlgebraicGeometry.Scheme.{u})
    (K_pred : ℕ) (T : Fin (K_pred + 1) → TopologicalSpace.Closeds ↥X)
    (n_T : Fin (K_pred + 1) → ℕ)
    (hnT : ∀ α : Fin (K_pred + 1), 2 ≤ n_T α)
    (hIrred : ∀ α : Fin (K_pred + 1), IsIrreducible (T α : Set X))
    (hPairwise : _root_.Pairwise fun α β : Fin (K_pred + 1) => T α ≠ T β)
    (hCharts : ∀ x : X, (∃ α : Fin (K_pred + 1), x ∈ (T α : Set X)) →
      ∃ (R' : CommRingCat.{u}) (v₀ : AlgebraicGeometry.Spec R')
        (e_X : AlgebraicGeometry.Spec R' ⟶ X)
        (a : Fin m → ℕ)
        (q : AlgebraicGeometry.Spec R' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
          (MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ Ideal.span
            {MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
              ∏ c : Fin m, MvPolynomial.X (Sum.inr c) ^ a c}))),
        AlgebraicGeometry.Etale e_X ∧
        AlgebraicGeometry.Etale q ∧
        e_X.base v₀ = x ∧
        (∀ b : Fin 2,
          Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl b)) ∈ (q.base v₀).asIdeal) ∧
        (∀ α : Fin (K_pred + 1), x ∈ (T α : Set X) →
          ∃ c : Fin m, a c = n_T α ∧
            Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c)) ∈ (q.base v₀).asIdeal ∧
            e_X.base ⁻¹' (T α : Set X) =
              {v : AlgebraicGeometry.Spec R' |
                (∀ b : Fin 2,
                  Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl b)) ∈ (q.base v).asIdeal) ∧
                Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c)) ∈ (q.base v).asIdeal})) :
    1 ≤ m ∧
    (∀ α β : Fin (K_pred + 1), α ≠ β → ¬ ((T α : Set X) ⊆ (T β : Set X))) ∧
    (∀ (x : X) (R' : CommRingCat.{u}) (v₀ : AlgebraicGeometry.Spec R')
        (e_X : AlgebraicGeometry.Spec R' ⟶ X)
        (a : Fin m → ℕ)
        (q : AlgebraicGeometry.Spec R' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
          (MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ Ideal.span
            {MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
              ∏ c : Fin m, MvPolynomial.X (Sum.inr c) ^ a c}))),
      AlgebraicGeometry.Etale e_X →
      AlgebraicGeometry.Etale q →
      e_X.base v₀ = x →
      (∀ c₁ c₂ : Fin m, c₁ ≠ c₂ → 1 ≤ a c₁ →
        (∀ b : Fin 2,
          Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl b)) ∈ (q.base v₀).asIdeal) →
        Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c₁)) ∈ (q.base v₀).asIdeal →
        ¬ ({v : AlgebraicGeometry.Spec R' |
              (∀ b : Fin 2,
                Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl b)) ∈ (q.base v).asIdeal) ∧
              Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c₁)) ∈ (q.base v).asIdeal} ⊆
            {v : AlgebraicGeometry.Spec R' |
              (∀ b : Fin 2,
                Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl b)) ∈ (q.base v).asIdeal) ∧
              Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c₂)) ∈ (q.base v).asIdeal})) ∧
      (∀ α β : Fin (K_pred + 1), α ≠ β →
        ∀ c₁ c₂ : Fin m,
          x ∈ (T α : Set X) → x ∈ (T β : Set X) →
          e_X.base ⁻¹' (T α : Set X) =
            {v : AlgebraicGeometry.Spec R' |
              (∀ b : Fin 2,
                Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl b)) ∈ (q.base v).asIdeal) ∧
              Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c₁)) ∈ (q.base v).asIdeal} →
          e_X.base ⁻¹' (T β : Set X) =
            {v : AlgebraicGeometry.Spec R' |
              (∀ b : Fin 2,
                Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl b)) ∈ (q.base v).asIdeal) ∧
              Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c₂)) ∈ (q.base v).asIdeal} →
          c₁ ≠ c₂) ∧
      (x ∈ (T 0 : Set X) →
        ∀ c₀ : Fin m,
          1 ≤ a c₀ →
          e_X.base ⁻¹' (T 0 : Set X) =
            {v : AlgebraicGeometry.Spec R' |
              (∀ b : Fin 2,
                Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl b)) ∈ (q.base v).asIdeal) ∧
              Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c₀)) ∈ (q.base v).asIdeal} →
          ∃ (U : X.affineOpens) (B' : CommRingCat.{u}) (v'₀ : AlgebraicGeometry.Spec B')
            (ι_B : AlgebraicGeometry.Spec B' ⟶ AlgebraicGeometry.Spec R')
            (φ_U : ↑(X.presheaf.obj (Opposite.op U.1)) →+* B')
            (ψ_q : (MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ Ideal.span
              {MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
                ∏ c : Fin m, MvPolynomial.X (Sum.inr c) ^ a c}) →+* B'),
            x ∈ U.1 ∧
            ι_B.base v'₀ = v₀ ∧
            AlgebraicGeometry.IsOpenImmersion ι_B ∧
            AlgebraicGeometry.Flat (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_U)) ∧
            AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_q)) ∧
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_U) ≫ U.2.fromSpec = ι_B ≫ e_X) ∧
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_q) = ι_B ≫ q) ∧
            Ideal.map φ_U ((AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal (T 0)).ideal U) =
              Ideal.span
                {ψ_q (Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl 0))),
                 ψ_q (Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl 1))),
                 ψ_q (Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c₀)))})) :=
by
  
  have hBranch : ∀ (a : Fin m → ℕ) (c₁ : Fin m), 1 ≤ a c₁ →
      let M := MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ Ideal.span
        ({MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
          ∏ c : Fin m, MvPolynomial.X (Sum.inr c) ^ a c} :
          Set (MvPolynomial (Fin 2 ⊕ Fin m) k))
      let P_c₁ : Ideal M := Ideal.span
        {Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl 0)),
         Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl 1)),
         Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c₁))}
      P_c₁.IsPrime ∧
      (∀ (R' : Type u) [CommRing R'] (ψ : M →+* R'),
        ψ.Flat →
        ∀ (v₀ : PrimeSpectrum R') (c₂ : Fin m),
          c₁ ≠ c₂ →
          (∀ b : Fin 2,
            Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl b)) ∈ Ideal.comap ψ v₀.asIdeal) →
          Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c₁)) ∈ Ideal.comap ψ v₀.asIdeal →
          ¬ ({v : PrimeSpectrum R' |
                (∀ b : Fin 2,
                  Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl b)) ∈ Ideal.comap ψ v.asIdeal) ∧
                Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c₁)) ∈ Ideal.comap ψ v.asIdeal} ⊆
              {v : PrimeSpectrum R' |
                (∀ b : Fin 2,
                  Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl b)) ∈ Ideal.comap ψ v.asIdeal) ∧
                Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c₂)) ∈ Ideal.comap ψ v.asIdeal})) := by
    intro a c₁ hc₁
    dsimp only
    set I_rel : Ideal (MvPolynomial (Fin 2 ⊕ Fin m) k) := Ideal.span
      {MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
        ∏ c : Fin m, MvPolynomial.X (Sum.inr c) ^ a c}
    set M := MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ I_rel
    set P_c₁ : Ideal M := Ideal.span
      {Ideal.Quotient.mk I_rel (MvPolynomial.X (Sum.inl 0)),
       Ideal.Quotient.mk I_rel (MvPolynomial.X (Sum.inl 1)),
       Ideal.Quotient.mk I_rel (MvPolynomial.X (Sum.inr c₁))}
    let f₀ : Fin 2 ⊕ Fin m → MvPolynomial (Fin m) k :=
      Sum.elim (fun _ => 0) (fun c => if c = c₁ then 0 else MvPolynomial.X c)
    let ev : MvPolynomial (Fin 2 ⊕ Fin m) k →+* MvPolynomial (Fin m) k :=
      MvPolynomial.eval₂Hom MvPolynomial.C f₀
    have hev_C : ∀ r : k, ev (MvPolynomial.C r) = MvPolynomial.C r :=
      fun r => MvPolynomial.eval₂Hom_C MvPolynomial.C f₀ r
    have hev_X : ∀ s : Fin 2 ⊕ Fin m, ev (MvPolynomial.X s) = f₀ s :=
      fun s => MvPolynomial.eval₂Hom_X' MvPolynomial.C f₀ s
    have h_rel_zero : ∀ p ∈ I_rel, ev p = 0 := by
      intro p hp
      have hle : I_rel ≤ RingHom.ker ev := by
        rw [Ideal.span_le, Set.singleton_subset_iff]
        change ev (MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
          ∏ c : Fin m, MvPolynomial.X (Sum.inr c) ^ a c) = 0
        rw [map_sub, map_mul, map_prod, hev_X]
        have h0 : f₀ (Sum.inl 0) = 0 := rfl
        have hProd : (∏ c : Fin m, ev (MvPolynomial.X (Sum.inr c) ^ a c)) = 0 := by
          refine Finset.prod_eq_zero (Finset.mem_univ c₁) ?_
          rw [map_pow, hev_X]
          have hc₁_0 : f₀ (Sum.inr c₁) = 0 := by simp [f₀]
          rw [hc₁_0]
          exact zero_pow (by omega)
        rw [h0, zero_mul, hProd, sub_self]
      exact hle hp
    let π_c₁ : M →+* MvPolynomial (Fin m) k := Ideal.Quotient.lift I_rel ev h_rel_zero
    have hπ_mk : ∀ p, π_c₁ (Ideal.Quotient.mk I_rel p) = ev p := fun _ => rfl
    have hP_le_ker : P_c₁ ≤ RingHom.ker π_c₁ := by
      rw [Ideal.span_le]
      rintro y (rfl | rfl | rfl)
      · change π_c₁ (Ideal.Quotient.mk I_rel (MvPolynomial.X (Sum.inl 0))) = 0
        rw [hπ_mk, hev_X]
        rfl
      · change π_c₁ (Ideal.Quotient.mk I_rel (MvPolynomial.X (Sum.inl 1))) = 0
        rw [hπ_mk, hev_X]
        rfl
      · change π_c₁ (Ideal.Quotient.mk I_rel (MvPolynomial.X (Sum.inr c₁))) = 0
        rw [hπ_mk, hev_X]
        simp [f₀]
    let cMap : k →+* M ⧸ P_c₁ :=
      (Ideal.Quotient.mk P_c₁).comp ((Ideal.Quotient.mk I_rel).comp MvPolynomial.C)
    let g₀ : Fin m → M ⧸ P_c₁ :=
      fun c => Ideal.Quotient.mk P_c₁ (Ideal.Quotient.mk I_rel (MvPolynomial.X (Sum.inr c)))
    let σ_c₁ : MvPolynomial (Fin m) k →+* M ⧸ P_c₁ := MvPolynomial.eval₂Hom cMap g₀
    have hσ_C : ∀ r : k, σ_c₁ (MvPolynomial.C r) = cMap r :=
      fun r => MvPolynomial.eval₂Hom_C cMap g₀ r
    have hσ_X : ∀ c : Fin m, σ_c₁ (MvPolynomial.X c) = g₀ c :=
      fun c => MvPolynomial.eval₂Hom_X' cMap g₀ c
    have hComp_eq : (σ_c₁.comp π_c₁).comp (Ideal.Quotient.mk I_rel) =
        (Ideal.Quotient.mk P_c₁).comp (Ideal.Quotient.mk I_rel) := by
      apply MvPolynomial.ringHom_ext'
      · ext r
        change σ_c₁ (π_c₁ (Ideal.Quotient.mk I_rel (MvPolynomial.C r))) =
          Ideal.Quotient.mk P_c₁ (Ideal.Quotient.mk I_rel (MvPolynomial.C r))
        rw [hπ_mk, hev_C, hσ_C]
        rfl
      · intro s
        change σ_c₁ (π_c₁ (Ideal.Quotient.mk I_rel (MvPolynomial.X s))) =
          Ideal.Quotient.mk P_c₁ (Ideal.Quotient.mk I_rel (MvPolynomial.X s))
        rw [hπ_mk, hev_X]
        cases s with
        | inl b =>
          have hfb : f₀ (Sum.inl b) = 0 := rfl
          rw [hfb, map_zero, eq_comm, Ideal.Quotient.eq_zero_iff_mem]
          fin_cases b <;> exact Ideal.subset_span (by simp)
        | inr c =>
          by_cases hc : c = c₁
          · subst hc
            have hfc : f₀ (Sum.inr c) = 0 := by simp [f₀]
            rw [hfc, map_zero, eq_comm, Ideal.Quotient.eq_zero_iff_mem]
            exact Ideal.subset_span (by simp)
          · have hfc : f₀ (Sum.inr c) = MvPolynomial.X c := by simp [f₀, hc]
            rw [hfc, hσ_X]
    have hP_eq_ker : P_c₁ = RingHom.ker π_c₁ := by
      refine le_antisymm hP_le_ker ?_
      intro y hy
      obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective y
      have hApp := RingHom.congr_fun hComp_eq p
      change σ_c₁ (π_c₁ (Ideal.Quotient.mk I_rel p)) =
        Ideal.Quotient.mk P_c₁ (Ideal.Quotient.mk I_rel p) at hApp
      have hπ0 : π_c₁ (Ideal.Quotient.mk I_rel p) = 0 := hy
      rw [hπ0, map_zero] at hApp
      exact Ideal.Quotient.eq_zero_iff_mem.mp hApp.symm
    have hPrimeP : P_c₁.IsPrime := by
      rw [hP_eq_ker]
      exact RingHom.ker_isPrime π_c₁
    have hMemInr : ∀ c : Fin m,
        Ideal.Quotient.mk I_rel (MvPolynomial.X (Sum.inr c)) ∈ P_c₁ ↔ c = c₁ := by
      intro c
      constructor
      · intro hMem
        by_contra hc
        rw [hP_eq_ker] at hMem
        have h0 : π_c₁ (Ideal.Quotient.mk I_rel (MvPolynomial.X (Sum.inr c))) = 0 := hMem
        have hfc : f₀ (Sum.inr c) = MvPolynomial.X c := by simp [f₀, hc]
        rw [hπ_mk, hev_X, hfc] at h0
        exact MvPolynomial.X_ne_zero c h0
      · rintro rfl
        exact Ideal.subset_span (by simp)
    refine ⟨hPrimeP, ?_⟩
    intro R' _ ψ hFlat v₀ c₂ hne hInl hc₁_v₀ hSub
    let _ : Algebra M R' := ψ.toAlgebra
    have : Module.Flat M R' := RingHom.flat_algebraMap_iff.mp hFlat
    have : Algebra.HasGoingDown M R' := Algebra.HasGoingDown.of_flat
    let q₀ : Ideal M := Ideal.comap ψ v₀.asIdeal
    have : q₀.IsPrime := v₀.isPrime.comap ψ
    have : v₀.asIdeal.IsPrime := v₀.isPrime
    have : P_c₁.IsPrime := hPrimeP
    have : v₀.asIdeal.LiesOver q₀ := ⟨rfl⟩
    have hLe : P_c₁ ≤ q₀ := by
      rw [Ideal.span_le]
      rintro y (rfl | rfl | rfl)
      · exact hInl 0
      · exact hInl 1
      · exact hc₁_v₀
    obtain ⟨P, _hP_le, hP_prime, hP_lies⟩ :=
      Ideal.exists_ideal_le_liesOver_of_le (p := P_c₁) (q := q₀) v₀.asIdeal hLe
    have hOver : P_c₁ = Ideal.comap ψ P := hP_lies.over
    let v₁ : PrimeSpectrum R' := ⟨P, hP_prime⟩
    have hv₁_lhs : v₁ ∈ {v : PrimeSpectrum R' |
        (∀ b : Fin 2,
          Ideal.Quotient.mk I_rel (MvPolynomial.X (Sum.inl b)) ∈ Ideal.comap ψ v.asIdeal) ∧
        Ideal.Quotient.mk I_rel (MvPolynomial.X (Sum.inr c₁)) ∈ Ideal.comap ψ v.asIdeal} := by
      change (∀ b : Fin 2, Ideal.Quotient.mk I_rel (MvPolynomial.X (Sum.inl b)) ∈ Ideal.comap ψ P) ∧
        Ideal.Quotient.mk I_rel (MvPolynomial.X (Sum.inr c₁)) ∈ Ideal.comap ψ P
      rw [← hOver]
      refine ⟨fun b => ?_, Ideal.subset_span (by simp)⟩
      fin_cases b <;> exact Ideal.subset_span (by simp)
    have hv₁_rhs := hSub hv₁_lhs
    have hc₂_mem : Ideal.Quotient.mk I_rel (MvPolynomial.X (Sum.inr c₂)) ∈ P_c₁ := by
      rw [hOver]
      exact hv₁_rhs.2
    exact hne ((hMemInr c₂).mp hc₂_mem).symm

  
  have hEtalePrimeRad : ∀ {A B : Type u} [CommRing A] [CommRing B]
      (φ : A →+* B) (P : Ideal A),
      φ.Etale → P.IsPrime → (Ideal.map φ P).IsRadical := by
    intro A B _ _ φ P hEt hP
    let _ : Algebra A B := φ.toAlgebra
    have : Algebra.Etale A B := RingHom.etale_algebraMap.mp hEt
    have : P.IsPrime := hP
    let D := A ⧸ P
    have : IsDomain D := Ideal.Quotient.isDomain P
    let C := TensorProduct A D B
    have : Algebra.Etale D C := Algebra.Etale.baseChange A B D
    let K := FractionRing D
    let C_K := TensorProduct D K C
    have : Algebra.Etale K C_K := Algebra.Etale.baseChange D C K
    have : _root_.IsReduced C_K := Algebra.FormallyUnramified.isReduced_of_field K C_K
    have hInj_lin : Function.Injective ⇑(Algebra.linearMap D K) :=
      IsFractionRing.injective D K
    have hInj_rTensor : Function.Injective ⇑(LinearMap.rTensor C (Algebra.linearMap D K)) :=
      Module.Flat.rTensor_preserves_injective_linearMap (Algebra.linearMap D K) hInj_lin
    have hInj_inc : Function.Injective ⇑(Algebra.TensorProduct.includeRight : C →ₐ[D] C_K) := by
      intro c₁ c₂ hEq
      apply (Algebra.TensorProduct.lid D C).symm.injective
      apply hInj_rTensor
      have hApp : ∀ c : C,
          LinearMap.rTensor C (Algebra.linearMap D K) ((Algebra.TensorProduct.lid D C).symm c) =
            (Algebra.TensorProduct.includeRight : C →ₐ[D] C_K) c := by
        intro c
        rw [Algebra.TensorProduct.lid_symm_apply, Algebra.TensorProduct.includeRight_apply]
        simp [LinearMap.rTensor_tmul]
      rw [hApp c₁, hApp c₂]
      exact hEq
    have : _root_.IsReduced C :=
      _root_.isReduced_of_injective (Algebra.TensorProduct.includeRight : C →ₐ[D] C_K) hInj_inc
    let e : (B ⧸ Ideal.map φ P) ≃+* C :=
      ((Algebra.TensorProduct.quotIdealMapEquivTensorQuot B P).toRingEquiv).trans
        ((Algebra.TensorProduct.comm A B D).toRingEquiv)
    have : _root_.IsReduced (B ⧸ Ideal.map φ P) :=
      _root_.isReduced_of_injective e e.injective
    exact (Ideal.isRadical_iff_quotient_reduced (Ideal.map φ P)).mpr inferInstance

  have hEtaleEqOfZeroLocus : ∀ {R₁ R₂ B : Type u} [CommRing R₁] [CommRing R₂] [CommRing B]
      (φ₁ : R₁ →+* B) (φ₂ : R₂ →+* B) (P₁ : Ideal R₁) (P₂ : Ideal R₂),
      φ₁.Etale → φ₂.Etale → P₁.IsPrime → P₂.IsPrime →
      PrimeSpectrum.zeroLocus (Ideal.map φ₁ P₁ : Set B) =
        PrimeSpectrum.zeroLocus (Ideal.map φ₂ P₂ : Set B) →
      Ideal.map φ₁ P₁ = Ideal.map φ₂ P₂ := by
    intro R₁ R₂ B _ _ _ φ₁ φ₂ P₁ P₂ hEt₁ hEt₂ hP₁ hP₂ hZero
    have hRad₁ : (Ideal.map φ₁ P₁).IsRadical := hEtalePrimeRad φ₁ P₁ hEt₁ hP₁
    have hRad₂ : (Ideal.map φ₂ P₂).IsRadical := hEtalePrimeRad φ₂ P₂ hEt₂ hP₂
    have hRadEq : (Ideal.map φ₁ P₁).radical = (Ideal.map φ₂ P₂).radical :=
      PrimeSpectrum.zeroLocus_eq_iff.mp hZero
    rwa [hRad₁.radical, hRad₂.radical] at hRadEq

  
  have hIrredEq : ∀ (Z₁ Z₂ : TopologicalSpace.Closeds ↥X),
      IsIrreducible (Z₁ : Set X) →
      IsIrreducible (Z₂ : Set X) →
      ∀ (W : AlgebraicGeometry.Scheme.{u}) (v₀ : W) (e_X : W ⟶ X),
        AlgebraicGeometry.Etale e_X →
        e_X.base v₀ ∈ (Z₁ : Set X) →
        e_X.base v₀ ∈ (Z₂ : Set X) →
        e_X.base ⁻¹' (Z₁ : Set X) = e_X.base ⁻¹' (Z₂ : Set X) →
        Z₁ = Z₂ := by
    intro Z₁ Z₂ hIrred₁ hIrred₂ W v₀ e_X hEt hv₁ hv₂ hPre
    have : AlgebraicGeometry.Etale e_X := hEt
    have hOpenU : IsOpen (Set.range e_X.base) :=
      (AlgebraicGeometry.Scheme.Hom.isOpenMap e_X).isOpen_range
    have hClos : ∀ (Z : TopologicalSpace.Closeds ↥X),
        IsIrreducible (Z : Set X) → e_X.base v₀ ∈ (Z : Set X) →
        closure ((Z : Set X) ∩ Set.range e_X.base) = (Z : Set X) := by
      intro Z hIrred hv
      refine Set.Subset.antisymm (Z.2.closure_subset_iff.mpr Set.inter_subset_left) ?_
      intro y hyZ
      by_contra hyNotClos
      let V : Set X := (closure ((Z : Set X) ∩ Set.range e_X.base))ᶜ
      obtain ⟨z, hzZ, hzV, hzU⟩ := hIrred.isPreirreducible V (Set.range e_X.base)
        isClosed_closure.isOpen_compl hOpenU ⟨y, hyZ, hyNotClos⟩ ⟨e_X.base v₀, hv, v₀, rfl⟩
      exact hzV (subset_closure ⟨hzZ, hzU⟩)
    have hInterEq : (Z₁ : Set X) ∩ Set.range e_X.base =
        (Z₂ : Set X) ∩ Set.range e_X.base := by
      ext y
      constructor
      · rintro ⟨hy₁, w, rfl⟩
        have hw₁ : w ∈ e_X.base ⁻¹' (Z₁ : Set X) := hy₁
        rw [hPre] at hw₁
        exact ⟨hw₁, w, rfl⟩
      · rintro ⟨hy₂, w, rfl⟩
        have hw₂ : w ∈ e_X.base ⁻¹' (Z₂ : Set X) := hy₂
        rw [← hPre] at hw₂
        exact ⟨hw₂, w, rfl⟩
    apply SetLike.ext'
    rw [← hClos Z₁ hIrred₁ hv₁, ← hClos Z₂ hIrred₂ hv₂, hInterEq]

  have hRoofShrink : ∀ (Z₀ : TopologicalSpace.Closeds ↥X),
      IsIrreducible (Z₀ : Set X) →
      ∀ (x : X), x ∈ (Z₀ : Set X) →
      ∀ (R' S : CommRingCat.{u}) (v₀ : AlgebraicGeometry.Spec R')
        (e_X : AlgebraicGeometry.Spec R' ⟶ X)
        (q : AlgebraicGeometry.Spec R' ⟶ AlgebraicGeometry.Spec S),
        AlgebraicGeometry.Etale e_X →
        AlgebraicGeometry.Etale q →
        e_X.base v₀ = x →
        ∃ (U : X.affineOpens) (B' : CommRingCat.{u}) (v'₀ : AlgebraicGeometry.Spec B')
          (ι_B : AlgebraicGeometry.Spec B' ⟶ AlgebraicGeometry.Spec R')
          (φ_U : ↑(X.presheaf.obj (Opposite.op U.1)) →+* B')
          (ψ_q : ↑S →+* B'),
          x ∈ U.1 ∧
          ι_B.base v'₀ = v₀ ∧
          AlgebraicGeometry.IsOpenImmersion ι_B ∧
          AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_U)) ∧
          AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_q)) ∧
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_U) ≫ U.2.fromSpec = ι_B ≫ e_X) ∧
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_q) = ι_B ≫ q) ∧
          ((AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal Z₀).ideal U).IsPrime ∧
          (PrimeSpectrum.zeroLocus
              (Ideal.map φ_U ((AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal Z₀).ideal U) :
                Set B') : Set (PrimeSpectrum B')) =
            {w : AlgebraicGeometry.Spec B' | ι_B.base w ∈ e_X.base ⁻¹' (Z₀ : Set X)} := by
    intro Z₀ hIrred₀ x hx₀ R' S v₀ e_X q hEt_e hEt_q hv₀
    have : AlgebraicGeometry.Etale e_X := hEt_e
    have : AlgebraicGeometry.Etale q := hEt_q
    obtain ⟨U₀, hAffU₀, hxU₀, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := x) (U := (⊤ : X.Opens)) trivial
    let U : X.affineOpens := ⟨U₀, hAffU₀⟩
    have : AlgebraicGeometry.IsOpenImmersion U.2.fromSpec := U.2.isOpenImmersion_fromSpec
    have hv₀_pre : v₀ ∈ e_X.base ⁻¹' (U.1 : Set X) := by
      change e_X.base v₀ ∈ (U.1 : Set X)
      rw [hv₀]
      exact hxU₀
    have hOpen_pre : IsOpen (e_X.base ⁻¹' (U.1 : Set X)) :=
      U.1.2.preimage e_X.continuous
    obtain ⟨_, ⟨h_sh, rfl⟩, hv₀_basic, hSub_basic⟩ :=
      PrimeSpectrum.isTopologicalBasis_basic_opens.exists_subset_of_mem_open hv₀_pre hOpen_pre
    let B' : CommRingCat.{u} := CommRingCat.of (Localization.Away h_sh)
    let ι_B : AlgebraicGeometry.Spec B' ⟶ AlgebraicGeometry.Spec R' :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R' (Localization.Away h_sh)))
    have hOpen_ιB : AlgebraicGeometry.IsOpenImmersion ι_B :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization h_sh
    have : AlgebraicGeometry.IsOpenImmersion ι_B := hOpen_ιB
    have hRange_ιB : Set.range ι_B.base = (PrimeSpectrum.basicOpen h_sh : Set (PrimeSpectrum R')) := by
      change Set.range (PrimeSpectrum.comap (algebraMap R' (Localization.Away h_sh))) = _
      exact PrimeSpectrum.localization_away_comap_range (Localization.Away h_sh) h_sh
    have hv₀_range : v₀ ∈ Set.range ι_B.base := by
      rw [hRange_ιB]
      exact hv₀_basic
    obtain ⟨v'₀, hv'₀⟩ := hv₀_range
    have hRange_lift : Set.range (ι_B ≫ e_X).base ⊆ Set.range U.2.fromSpec.base := by
      rw [U.2.range_fromSpec]
      rintro _ ⟨w, rfl⟩
      have hw_basic : ι_B.base w ∈ (PrimeSpectrum.basicOpen h_sh : Set (PrimeSpectrum R')) := by
        rw [← hRange_ιB]
        exact ⟨w, rfl⟩
      exact hSub_basic hw_basic
    let g_U : AlgebraicGeometry.Spec B' ⟶
        AlgebraicGeometry.Spec (X.presheaf.obj (Opposite.op U.1)) :=
      AlgebraicGeometry.IsOpenImmersion.lift U.2.fromSpec (ι_B ≫ e_X) hRange_lift
    have hg_U_fac : g_U ≫ U.2.fromSpec = ι_B ≫ e_X :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac U.2.fromSpec (ι_B ≫ e_X) hRange_lift
    have hEt_gU : AlgebraicGeometry.Etale g_U := by
      have : AlgebraicGeometry.Etale (g_U ≫ U.2.fromSpec) := by
        rw [hg_U_fac]
        exact inferInstance
      exact AlgebraicGeometry.Etale.of_comp g_U U.2.fromSpec
    let φ_U : ↑(X.presheaf.obj (Opposite.op U.1)) →+* B' :=
      (AlgebraicGeometry.Spec.preimage g_U).hom
    have hSpec_φU : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_U) = g_U :=
      AlgebraicGeometry.Spec.map_preimage g_U
    let g_q : AlgebraicGeometry.Spec B' ⟶ AlgebraicGeometry.Spec S := ι_B ≫ q
    have hEt_gq : AlgebraicGeometry.Etale g_q := inferInstance
    let ψ_q : ↑S →+* B' := (AlgebraicGeometry.Spec.preimage g_q).hom
    have hSpec_ψq : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_q) = ι_B ≫ q :=
      AlgebraicGeometry.Spec.map_preimage g_q
    let S_U : Set (PrimeSpectrum ↑(X.presheaf.obj (Opposite.op U.1))) :=
      U.2.fromSpec.base ⁻¹' (Z₀ : Set X)
    have hSU_nonempty : S_U.Nonempty := by
      have hx_range : x ∈ Set.range U.2.fromSpec.base := by
        rw [U.2.range_fromSpec]
        exact hxU₀
      obtain ⟨u₀, hu₀⟩ := hx_range
      refine ⟨u₀, ?_⟩
      change U.2.fromSpec.base u₀ ∈ (Z₀ : Set X)
      rwa [hu₀]
    have hSU_preirred : IsPreirreducible S_U :=
      hIrred₀.isPreirreducible.preimage (AlgebraicGeometry.Scheme.Hom.isOpenEmbedding U.2.fromSpec)
    have hIU_eq : (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal Z₀).ideal U =
        PrimeSpectrum.vanishingIdeal S_U :=
      AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal_ideal Z₀ U
    have hIU_prime : ((AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal Z₀).ideal U).IsPrime := by
      rw [hIU_eq]
      exact PrimeSpectrum.isIrreducible_iff_vanishingIdeal_isPrime.mp ⟨hSU_nonempty, hSU_preirred⟩
    have hSU_closed : IsClosed S_U := Z₀.2.preimage U.2.fromSpec.continuous
    have hZero_IU_base : PrimeSpectrum.zeroLocus
        (((AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal Z₀).ideal U) :
          Set ↑(X.presheaf.obj (Opposite.op U.1))) = S_U := by
      rw [hIU_eq, PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure, hSU_closed.closure_eq]
    have hZero_map : (PrimeSpectrum.zeroLocus
        (Ideal.map φ_U ((AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal Z₀).ideal U) :
          Set B') : Set (PrimeSpectrum B')) =
        {w : AlgebraicGeometry.Spec B' | ι_B.base w ∈ e_X.base ⁻¹' (Z₀ : Set X)} := by
      ext w
      rw [PrimeSpectrum.mem_zeroLocus, SetLike.coe_subset_coe, Ideal.map_le_iff_le_comap]
      change ((AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal Z₀).ideal U :
          Set ↑(X.presheaf.obj (Opposite.op U.1))) ⊆
          ((PrimeSpectrum.comap φ_U w).asIdeal : Set _) ↔ _
      rw [← PrimeSpectrum.mem_zeroLocus, hZero_IU_base]
      have hBaseEq : U.2.fromSpec.base (PrimeSpectrum.comap φ_U w) =
          (ι_B ≫ e_X).base w := by
        have hComp : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_U) ≫ U.2.fromSpec =
            ι_B ≫ e_X := by
          rw [hSpec_φU, hg_U_fac]
        exact congrArg (fun f => f.base w) hComp
      change U.2.fromSpec.base (PrimeSpectrum.comap φ_U w) ∈ (Z₀ : Set X) ↔ _
      rw [hBaseEq]
      rfl
    refine ⟨U, B', v'₀, ι_B, φ_U, ψ_q, hxU₀, hv'₀, hOpen_ιB, ?_, ?_, ?_, hSpec_ψq,
      hIU_prime, hZero_map⟩
    · rwa [hSpec_φU]
    · rwa [hSpec_ψq]
    · rwa [hSpec_φU]

  
  have hm1 : 1 ≤ m := by
    obtain ⟨x₀, hx₀⟩ := (hIrred 0).nonempty
    obtain ⟨_, _, _, _, _, _, _, _, _, hT_in⟩ := hCharts x₀ ⟨0, hx₀⟩
    obtain ⟨c₀, _, _, _⟩ := hT_in 0 hx₀
    exact Nat.succ_le_of_lt c₀.pos

  have hLocal : ∀ (x : X) (R' : CommRingCat.{u}) (v₀ : AlgebraicGeometry.Spec R')
      (e_X : AlgebraicGeometry.Spec R' ⟶ X)
      (a : Fin m → ℕ)
      (q : AlgebraicGeometry.Spec R' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
        (MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ Ideal.span
          {MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
            ∏ c : Fin m, MvPolynomial.X (Sum.inr c) ^ a c}))),
      AlgebraicGeometry.Etale e_X →
      AlgebraicGeometry.Etale q →
      e_X.base v₀ = x →
      (∀ c₁ c₂ : Fin m, c₁ ≠ c₂ → 1 ≤ a c₁ →
        (∀ b : Fin 2,
          Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl b)) ∈ (q.base v₀).asIdeal) →
        Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c₁)) ∈ (q.base v₀).asIdeal →
        ¬ ({v : AlgebraicGeometry.Spec R' |
              (∀ b : Fin 2,
                Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl b)) ∈ (q.base v).asIdeal) ∧
              Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c₁)) ∈ (q.base v).asIdeal} ⊆
            {v : AlgebraicGeometry.Spec R' |
              (∀ b : Fin 2,
                Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl b)) ∈ (q.base v).asIdeal) ∧
              Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c₂)) ∈ (q.base v).asIdeal})) ∧
      (∀ α β : Fin (K_pred + 1), α ≠ β →
        ∀ c₁ c₂ : Fin m,
          x ∈ (T α : Set X) → x ∈ (T β : Set X) →
          e_X.base ⁻¹' (T α : Set X) =
            {v : AlgebraicGeometry.Spec R' |
              (∀ b : Fin 2,
                Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl b)) ∈ (q.base v).asIdeal) ∧
              Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c₁)) ∈ (q.base v).asIdeal} →
          e_X.base ⁻¹' (T β : Set X) =
            {v : AlgebraicGeometry.Spec R' |
              (∀ b : Fin 2,
                Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl b)) ∈ (q.base v).asIdeal) ∧
              Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c₂)) ∈ (q.base v).asIdeal} →
          c₁ ≠ c₂) ∧
      (x ∈ (T 0 : Set X) →
        ∀ c₀ : Fin m,
          1 ≤ a c₀ →
          e_X.base ⁻¹' (T 0 : Set X) =
            {v : AlgebraicGeometry.Spec R' |
              (∀ b : Fin 2,
                Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl b)) ∈ (q.base v).asIdeal) ∧
              Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c₀)) ∈ (q.base v).asIdeal} →
          ∃ (U : X.affineOpens) (B' : CommRingCat.{u}) (v'₀ : AlgebraicGeometry.Spec B')
            (ι_B : AlgebraicGeometry.Spec B' ⟶ AlgebraicGeometry.Spec R')
            (φ_U : ↑(X.presheaf.obj (Opposite.op U.1)) →+* B')
            (ψ_q : (MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ Ideal.span
              {MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
                ∏ c : Fin m, MvPolynomial.X (Sum.inr c) ^ a c}) →+* B'),
            x ∈ U.1 ∧
            ι_B.base v'₀ = v₀ ∧
            AlgebraicGeometry.IsOpenImmersion ι_B ∧
            AlgebraicGeometry.Flat (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_U)) ∧
            AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_q)) ∧
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_U) ≫ U.2.fromSpec = ι_B ≫ e_X) ∧
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_q) = ι_B ≫ q) ∧
            Ideal.map φ_U ((AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal (T 0)).ideal U) =
              Ideal.span
                {ψ_q (Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl 0))),
                 ψ_q (Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl 1))),
                 ψ_q (Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c₀)))}) := by
    intro x R' v₀ e_X a q hEt_e hEt_q hv₀
    refine ⟨?_, ?_, ?_⟩
    · intro c₁ c₂ hne hc₁ hInl hc₁_v₀
      have : AlgebraicGeometry.Etale q := hEt_q
      let f_q := AlgebraicGeometry.Spec.preimage q
      let ψ := f_q.hom
      have hSpec_fq : AlgebraicGeometry.Spec.map f_q = q :=
        AlgebraicGeometry.Spec.map_preimage q
      have hFlat_fq : AlgebraicGeometry.Flat (AlgebraicGeometry.Spec.map f_q) := by
        rw [hSpec_fq]
        exact inferInstance
      have hFlat_ψ : ψ.Flat :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Flat)).mp hFlat_fq
      have hIdealEq : ∀ v : AlgebraicGeometry.Spec R',
          (q.base v).asIdeal = Ideal.comap ψ v.asIdeal := by
        intro v
        rw [← hSpec_fq]
        rfl
      simp_rw [hIdealEq] at hInl hc₁_v₀ ⊢
      exact (hBranch a c₁ hc₁).2 R' ψ hFlat_ψ v₀ c₂ hne hInl hc₁_v₀
    · intro α β hne_αβ c₁ c₂ hxα hxβ hPreα hPreβ hEq_c
      subst hEq_c
      have hPreEq : e_X.base ⁻¹' (T α : Set X) = e_X.base ⁻¹' (T β : Set X) :=
        hPreα.trans hPreβ.symm
      have hv_α : e_X.base v₀ ∈ (T α : Set X) := by rwa [hv₀]
      have hv_β : e_X.base v₀ ∈ (T β : Set X) := by rwa [hv₀]
      exact hPairwise hne_αβ
        (hIrredEq (T α) (T β) (hIrred α) (hIrred β) (AlgebraicGeometry.Spec R')
          v₀ e_X hEt_e hv_α hv_β hPreEq)
    · intro hx0 c₀ hc₀ hPreT0
      let M := MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ Ideal.span
        ({MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
          ∏ c : Fin m, MvPolynomial.X (Sum.inr c) ^ a c} :
          Set (MvPolynomial (Fin 2 ⊕ Fin m) k))
      obtain ⟨U, B', v'₀, ι_B, φ_U, ψ_q, hxU, hv'₀, hOpen_ιB, hEt_φU, hEt_ψq,
        hFac_φU, hFac_ψq, hPrime_IU, hZero_IU⟩ :=
        hRoofShrink (T 0) (hIrred 0) x hx0 R' _ v₀ e_X q hEt_e hEt_q hv₀
      have : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_U)) :=
        hEt_φU
      have hFlat_φU :
          AlgebraicGeometry.Flat (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_U)) :=
        inferInstance
      have hRingEt_φU : φ_U.Etale :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hEt_φU
      have hRingEt_ψq : ψ_q.Etale :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hEt_ψq
      let P_c₀ : Ideal M := Ideal.span
        {Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl 0)),
         Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl 1)),
         Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c₀))}
      have hPrime_Pc₀ : P_c₀.IsPrime := (hBranch a c₀ hc₀).1
      have hZero_Pc₀ : (PrimeSpectrum.zeroLocus (Ideal.map ψ_q P_c₀ : Set B') :
          Set (PrimeSpectrum B')) =
          {w : AlgebraicGeometry.Spec B' | ι_B.base w ∈ e_X.base ⁻¹' (T 0 : Set X)} := by
        ext w
        rw [PrimeSpectrum.mem_zeroLocus, SetLike.coe_subset_coe, Ideal.map_le_iff_le_comap]
        dsimp only [P_c₀]
        rw [Ideal.span_le]
        have hComapEq : Ideal.comap ψ_q w.asIdeal = (q.base (ι_B.base w)).asIdeal := by
          have h1 : Ideal.comap ψ_q w.asIdeal =
              ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_q)).base w).asIdeal := rfl
          rw [h1, hFac_ψq]
          rfl
        have hPreIff : ι_B.base w ∈ e_X.base ⁻¹' (T 0 : Set X) ↔
            (∀ b : Fin 2,
              Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl b)) ∈
                (q.base (ι_B.base w)).asIdeal) ∧
            Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c₀)) ∈
              (q.base (ι_B.base w)).asIdeal := by
          rw [hPreT0]
          rfl
        constructor
        · intro hSub
          change ι_B.base w ∈ e_X.base ⁻¹' (T 0 : Set X)
          rw [hPreIff]
          refine ⟨fun b => ?_, ?_⟩
          · rw [← hComapEq]
            fin_cases b
            · exact hSub (by simp)
            · exact hSub (by simp)
          · rw [← hComapEq]
            exact hSub (by simp)
        · intro hw
          have hw' : ι_B.base w ∈ e_X.base ⁻¹' (T 0 : Set X) := hw
          rw [hPreIff] at hw'
          rcases hw' with ⟨hInl, hInr⟩
          intro y hy
          change y ∈ Ideal.comap ψ_q w.asIdeal
          rw [hComapEq]
          rcases hy with rfl | rfl | rfl
          · exact hInl 0
          · exact hInl 1
          · exact hInr
      have hEqMap : Ideal.map φ_U
          ((AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal (T 0)).ideal U) =
          Ideal.map ψ_q P_c₀ :=
        hEtaleEqOfZeroLocus φ_U ψ_q _ P_c₀ hRingEt_φU hRingEt_ψq hPrime_IU hPrime_Pc₀
          (hZero_IU.trans hZero_Pc₀.symm)
      have hMapSpan : Ideal.map ψ_q P_c₀ = Ideal.span
          {ψ_q (Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl 0))),
           ψ_q (Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl 1))),
           ψ_q (Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c₀)))} := by
        dsimp only [P_c₀]
        rw [Ideal.map_span]
        simp
      exact ⟨U, B', v'₀, ι_B, φ_U, ψ_q, hxU, hv'₀, hOpen_ιB, hFlat_φU, hEt_ψq,
        hFac_φU, hFac_ψq, hEqMap.trans hMapSpan⟩

  refine ⟨hm1, ?_, hLocal⟩
  intro α β hne hSub
  obtain ⟨x, hxα⟩ := (hIrred α).nonempty
  have hxβ : x ∈ (T β : Set X) := hSub hxα
  obtain ⟨R', v₀, e_X, a, q, hEt_e, hEt_q, hv₀, hInl, hT_in⟩ := hCharts x ⟨α, hxα⟩
  obtain ⟨c₁, hac₁, hc₁_v₀, hPreα⟩ := hT_in α hxα
  obtain ⟨c₂, _, _, hPreβ⟩ := hT_in β hxβ
  obtain ⟨hGD_loc, hDist_loc, _⟩ := hLocal x R' v₀ e_X a q hEt_e hEt_q hv₀
  have hc_ne : c₁ ≠ c₂ := hDist_loc α β hne c₁ c₂ hxα hxβ hPreα hPreβ
  have hc₁_ge1 : 1 ≤ a c₁ := by
    have := hnT α
    omega
  have hPreSub : e_X.base ⁻¹' (T α : Set X) ⊆ e_X.base ⁻¹' (T β : Set X) :=
    Set.preimage_mono hSub
  rw [hPreα, hPreβ] at hPreSub
  exact hGD_loc c₁ c₂ hc_ne hc₁_ge1 hInl hc₁_v₀ hPreSub

theorem weil_blowup_open_iso_strict_transform_and_closed_bijection (X X' : AlgebraicGeometry.Scheme.{u}) (π : X' ⟶ X)
    (T₀ : TopologicalSpace.Closeds ↥X)
    [AlgebraicGeometry.IsProper π] [AlgebraicGeometry.Surjective π]
    (hIso : CategoryTheory.IsIso (π ∣_ ⟨(T₀ : Set X)ᶜ, T₀.2.isOpen_compl⟩)) :
    (∀ (Z : TopologicalSpace.Closeds ↥X),
      IsIrreducible (Z : Set X) →
      ¬ ((Z : Set X) ⊆ (T₀ : Set X)) →
      let Z_tilde : Set X' := closure (π.base ⁻¹' ((Z : Set X) \ (T₀ : Set X)))
      IsIrreducible Z_tilde ∧
      Z_tilde ⊆ π.base ⁻¹' (Z : Set X) ∧
      Z_tilde ∩ π.base ⁻¹' (T₀ : Set X)ᶜ = π.base ⁻¹' ((Z : Set X) \ (T₀ : Set X)) ∧
      ¬ (Z_tilde ⊆ π.base ⁻¹' (T₀ : Set X)) ∧
      (∀ (W : AlgebraicGeometry.Scheme.{u}) (e_W : W ⟶ X'),
        IsOpenMap e_W.base →
        e_W.base ⁻¹' Z_tilde =
          closure ((e_W ≫ π).base ⁻¹' ((Z : Set X) \ (T₀ : Set X))))) ∧
    (∀ (Z₁ Z₂ : TopologicalSpace.Closeds ↥X),
      IsIrreducible (Z₁ : Set X) →
      IsIrreducible (Z₂ : Set X) →
      ¬ ((Z₁ : Set X) ⊆ (T₀ : Set X)) →
      ¬ ((Z₂ : Set X) ⊆ (T₀ : Set X)) →
      Z₁ ≠ Z₂ →
      closure (π.base ⁻¹' ((Z₁ : Set X) \ (T₀ : Set X))) ≠
        closure (π.base ⁻¹' ((Z₂ : Set X) \ (T₀ : Set X)))) ∧
    (∀ (W : AlgebraicGeometry.Scheme.{u}) (w₀ : W) (x' : X') (e_X : W ⟶ X),
      AlgebraicGeometry.Etale e_X →
      e_X.base w₀ = π.base x' →
      e_X.base ⁻¹' (T₀ : Set X) = ∅ →
      ∃ e_X' : W ⟶ X',
        AlgebraicGeometry.Etale e_X' ∧
        e_X'.base w₀ = x' ∧
        (e_X' ≫ π = e_X)) ∧
    (∀ (T'_set : Set X'),
      IsClosed T'_set →
      T'_set ⊆ π.base ⁻¹' (T₀ : Set X) →
      IsIrreducible (T₀ : Set X) →
      (∀ x ∈ (T₀ : Set X), ∃! x' : X', x' ∈ T'_set ∧ π.base x' = x) →
      IsIrreducible T'_set) :=
by
  let U_c : X.Opens := ⟨(T₀ : Set X)ᶜ, T₀.2.isOpen_compl⟩
  let V_c : X'.Opens := (TopologicalSpace.Opens.map π.base).obj U_c
  have _ : CategoryTheory.IsIso (π ∣_ U_c) := hIso
  let σ : (U_c : AlgebraicGeometry.Scheme.{u}) ⟶ X' := CategoryTheory.inv (π ∣_ U_c) ≫ V_c.ι
  have hσ_π : σ ≫ π = U_c.ι := by
    dsimp [σ, V_c]
    rw [Category.assoc, ← AlgebraicGeometry.morphismRestrict_ι π U_c,
      CategoryTheory.IsIso.inv_hom_id_assoc]
  have hπ_σ : (π ∣_ U_c) ≫ σ = V_c.ι := by
    dsimp [σ]
    exact CategoryTheory.IsIso.hom_inv_id_assoc (π ∣_ U_c) V_c.ι
  have hσ_π_apply :
      ∀ u : (U_c : AlgebraicGeometry.Scheme.{u}), π.base (σ.base u) = U_c.ι.base u := by
    intro u
    have h := congrArg (fun φ => φ.base u) hσ_π
    simpa only [Scheme.Hom.comp_base, TopCat.coe_comp, Function.comp_apply] using h
  have hσ_retract :
      ∀ v : (V_c : AlgebraicGeometry.Scheme.{u}), σ.base ((π ∣_ U_c).base v) = V_c.ι.base v := by
    intro v
    have h := congrArg (fun φ => φ.base v) hπ_σ
    simpa only [Scheme.Hom.comp_base, TopCat.coe_comp, Function.comp_apply] using h
  have hπ_Vc :
      ∀ v : (V_c : AlgebraicGeometry.Scheme.{u}),
        U_c.ι.base ((π ∣_ U_c).base v) = π.base (V_c.ι.base v) := by
    intro v
    have h := congrArg (fun φ => φ.base v) (AlgebraicGeometry.morphismRestrict_ι π U_c)
    simpa only [Scheme.Hom.comp_base, TopCat.coe_comp, Function.comp_apply] using h
  have hPart1 : ∀ (Z : TopologicalSpace.Closeds ↥X),
      IsIrreducible (Z : Set X) →
      ¬ ((Z : Set X) ⊆ (T₀ : Set X)) →
      let Z_tilde : Set X' := closure (π.base ⁻¹' ((Z : Set X) \ (T₀ : Set X)))
      IsIrreducible Z_tilde ∧
      Z_tilde ⊆ π.base ⁻¹' (Z : Set X) ∧
      Z_tilde ∩ π.base ⁻¹' (T₀ : Set X)ᶜ = π.base ⁻¹' ((Z : Set X) \ (T₀ : Set X)) ∧
      ¬ (Z_tilde ⊆ π.base ⁻¹' (T₀ : Set X)) ∧
      (∀ (W : AlgebraicGeometry.Scheme.{u}) (e_W : W ⟶ X'),
        IsOpenMap e_W.base →
        e_W.base ⁻¹' Z_tilde =
          closure ((e_W ≫ π).base ⁻¹' ((Z : Set X) \ (T₀ : Set X)))) := by
    intro Z hIrredZ hNotSub
    dsimp only
    let Z_tilde : Set X' := closure (π.base ⁻¹' ((Z : Set X) \ (T₀ : Set X)))
    let S_U : Set (U_c : AlgebraicGeometry.Scheme.{u}) := U_c.ι.base ⁻¹' (Z : Set X)
    have hRangeUc : Set.range U_c.ι.base = (T₀ : Set X)ᶜ := U_c.range_ι
    have hRangeVc : Set.range V_c.ι.base = π.base ⁻¹' (T₀ : Set X)ᶜ := V_c.range_ι
    obtain ⟨x, hxZ, hxNot0⟩ := Set.not_subset.mp hNotSub
    have hxRange : x ∈ Set.range U_c.ι.base := by
      rw [hRangeUc]
      exact hxNot0
    obtain ⟨u₀, hu₀⟩ := hxRange
    have hSU_ne : S_U.Nonempty := ⟨u₀, by change U_c.ι.base u₀ ∈ (Z : Set X); rwa [hu₀]⟩
    have hSU_irred : IsIrreducible S_U :=
      ⟨hSU_ne, hIrredZ.isPreirreducible.preimage U_c.ι.isOpenEmbedding⟩
    have hImgEq : σ.base '' S_U = π.base ⁻¹' ((Z : Set X) \ (T₀ : Set X)) := by
      apply Set.Subset.antisymm
      · rintro _ ⟨u, huZ, rfl⟩
        have hπu : π.base (σ.base u) = U_c.ι.base u := hσ_π_apply u
        have huNot0 : U_c.ι.base u ∈ (T₀ : Set X)ᶜ := by
          rw [← hRangeUc]
          exact ⟨u, rfl⟩
        exact ⟨by rwa [hπu], by rwa [hπu]⟩
      · rintro x' ⟨hx'Z, hx'Not0⟩
        have hx'Vc : x' ∈ Set.range V_c.ι.base := by
          rw [hRangeVc]
          exact hx'Not0
        obtain ⟨v, hv⟩ := hx'Vc
        refine ⟨(π ∣_ U_c).base v, ?_, ?_⟩
        · change U_c.ι.base ((π ∣_ U_c).base v) ∈ (Z : Set X)
          rw [hπ_Vc v, hv]
          exact hx'Z
        · rw [hσ_retract v, hv]
    have hIrredPre : IsIrreducible (π.base ⁻¹' ((Z : Set X) \ (T₀ : Set X))) := by
      rw [← hImgEq]
      exact hSU_irred.image σ.base σ.continuous.continuousOn
    have hIrredTilde : IsIrreducible Z_tilde := hIrredPre.closure
    have hSubPreZ : Z_tilde ⊆ π.base ⁻¹' (Z : Set X) :=
      closure_minimal (Set.preimage_mono fun _ hx => hx.1) (Z.isClosed.preimage π.continuous)
    have hInterCompl :
        Z_tilde ∩ π.base ⁻¹' (T₀ : Set X)ᶜ = π.base ⁻¹' ((Z : Set X) \ (T₀ : Set X)) := by
      apply Set.Subset.antisymm
      · rintro x' ⟨hx'Tilde, hx'Compl⟩
        exact ⟨hSubPreZ hx'Tilde, hx'Compl⟩
      · rintro x' hx'
        exact ⟨subset_closure hx', hx'.2⟩
    have hNotSubTilde : ¬ (Z_tilde ⊆ π.base ⁻¹' (T₀ : Set X)) := by
      intro hSub0
      obtain ⟨x', hx'⟩ := π.surjective x
      have hx'Mem : x' ∈ π.base ⁻¹' ((Z : Set X) \ (T₀ : Set X)) := ⟨by rwa [hx'], by rwa [hx']⟩
      have hx0 : π.base x' ∈ (T₀ : Set X) := hSub0 (subset_closure hx'Mem)
      rw [hx'] at hx0
      exact hxNot0 hx0
    refine ⟨hIrredTilde, hSubPreZ, hInterCompl, hNotSubTilde, ?_⟩
    intro W e_W hOpen
    change e_W.base ⁻¹' closure (π.base ⁻¹' ((Z : Set X) \ (T₀ : Set X))) =
      closure ((e_W ≫ π).base ⁻¹' ((Z : Set X) \ (T₀ : Set X)))
    rw [IsOpenMap.preimage_closure_eq_closure_preimage hOpen e_W.continuous,
      Scheme.Hom.comp_base, TopCat.coe_comp, Set.preimage_comp]
  have hClosDiff : ∀ (Z : TopologicalSpace.Closeds ↥X),
      IsIrreducible (Z : Set X) → ¬ ((Z : Set X) ⊆ (T₀ : Set X)) →
      closure ((Z : Set X) \ (T₀ : Set X)) = (Z : Set X) := by
    intro Z hIrred hNotSub
    apply Set.Subset.antisymm
    · exact closure_minimal (fun _ hx => hx.1) Z.isClosed
    · obtain ⟨x, hxZ, hxNot0⟩ := Set.not_subset.mp hNotSub
      exact subset_closure_inter_of_isPreirreducible_of_isOpen
        hIrred.isPreirreducible T₀.2.isOpen_compl ⟨x, hxZ, hxNot0⟩
  refine ⟨hPart1, ?_, ?_, ?_⟩
  · intro Z₁ Z₂ hIrred₁ hIrred₂ hNotSub₁ hNotSub₂ hNe hEqClos
    have hEqInter :
        closure (π.base ⁻¹' ((Z₁ : Set X) \ (T₀ : Set X))) ∩ π.base ⁻¹' (T₀ : Set X)ᶜ =
        closure (π.base ⁻¹' ((Z₂ : Set X) \ (T₀ : Set X))) ∩ π.base ⁻¹' (T₀ : Set X)ᶜ :=
      congrArg (· ∩ π.base ⁻¹' (T₀ : Set X)ᶜ) hEqClos
    rw [(hPart1 Z₁ hIrred₁ hNotSub₁).2.2.1, (hPart1 Z₂ hIrred₂ hNotSub₂).2.2.1] at hEqInter
    have hEqDiff : (Z₁ : Set X) \ (T₀ : Set X) = (Z₂ : Set X) \ (T₀ : Set X) :=
      π.surjective.preimage_injective hEqInter
    have hEqSet : (Z₁ : Set X) = (Z₂ : Set X) := by
      rw [← hClosDiff Z₁ hIrred₁ hNotSub₁, ← hClosDiff Z₂ hIrred₂ hNotSub₂, hEqDiff]
    exact hNe (SetLike.coe_injective hEqSet)
  · intro W w₀ x' e_X hEt_e hw₀ hEmpty
    have _ : AlgebraicGeometry.Etale e_X := hEt_e
    have hRange : Set.range ⇑e_X ⊆ Set.range ⇑U_c.ι := by
      rw [U_c.range_ι]
      rintro _ ⟨w, rfl⟩
      intro hwT0
      have hwMem : w ∈ e_X.base ⁻¹' (T₀ : Set X) := hwT0
      rw [hEmpty] at hwMem
      exact hwMem
    let f_W : W ⟶ (U_c : AlgebraicGeometry.Scheme.{u}) :=
      AlgebraicGeometry.IsOpenImmersion.lift U_c.ι e_X hRange
    have hf_W : f_W ≫ U_c.ι = e_X :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac U_c.ι e_X hRange
    have _ : AlgebraicGeometry.Etale f_W :=
      CategoryTheory.MorphismProperty.of_postcomp
        (W := @AlgebraicGeometry.Etale) (W' := @AlgebraicGeometry.Etale)
        f_W U_c.ι inferInstance (by rwa [hf_W])
    have _ : AlgebraicGeometry.Etale σ := by
      dsimp [σ]
      exact inferInstance
    refine ⟨f_W ≫ σ, inferInstance, ?_, ?_⟩
    · have hx'Not0 : π.base x' ∉ (T₀ : Set X) := by
        intro hx'T0
        have hw₀Mem : w₀ ∈ e_X.base ⁻¹' (T₀ : Set X) := by
          change e_X.base w₀ ∈ (T₀ : Set X)
          rwa [hw₀]
        rw [hEmpty] at hw₀Mem
        exact hw₀Mem
      have hx'Vc : x' ∈ Set.range V_c.ι.base := by
        rw [V_c.range_ι]
        exact hx'Not0
      obtain ⟨v₀, hv₀⟩ := hx'Vc
      have hf_w₀ : f_W.base w₀ = (π ∣_ U_c).base v₀ := by
        apply (AlgebraicGeometry.Scheme.Hom.isOpenEmbedding U_c.ι).injective
        have hfac_w₀ : U_c.ι.base (f_W.base w₀) = e_X.base w₀ := by
          have h := congrArg (fun φ => φ.base w₀) hf_W
          simpa only [Scheme.Hom.comp_base, TopCat.coe_comp, Function.comp_apply] using h
        rw [hfac_w₀, hw₀, ← hv₀, hπ_Vc v₀]
      calc
        (f_W ≫ σ).base w₀ = σ.base (f_W.base w₀) := by
          simp only [Scheme.Hom.comp_base, TopCat.coe_comp, Function.comp_apply]
        _ = σ.base ((π ∣_ U_c).base v₀) := by rw [hf_w₀]
        _ = V_c.ι.base v₀ := hσ_retract v₀
        _ = x' := hv₀
    · rw [Category.assoc, hσ_π, hf_W]
  · intro T'_set hClT' hSubT' hIrred0 hBij
    obtain ⟨x₀, hx₀⟩ := hIrred0.nonempty
    obtain ⟨x'₀, hx'₀_mem, _⟩ := (hBij x₀ hx₀).exists
    have hPull : ∀ C : Set X', (T₀ : Set X) ⊆ π.base '' (T'_set ∩ C) → T'_set ⊆ C := by
      intro C hSubF x' hx'
      have hx : π.base x' ∈ (T₀ : Set X) := hSubT' hx'
      obtain ⟨x'', ⟨hx''_T', hx''_C⟩, hx''_eq⟩ := hSubF hx
      have hEq : x' = x'' :=
        (hBij (π.base x') hx).unique ⟨hx', rfl⟩ ⟨hx''_T', hx''_eq⟩
      rwa [hEq]
    refine ⟨⟨x'₀, hx'₀_mem⟩, isPreirreducible_iff_isClosed_union_isClosed.mpr ?_⟩
    intro C₁ C₂ hCl₁ hCl₂ hCov
    let F₁ : Set X := π.base '' (T'_set ∩ C₁)
    let F₂ : Set X := π.base '' (T'_set ∩ C₂)
    have hClF₁ : IsClosed F₁ := π.isClosedMap _ (hClT'.inter hCl₁)
    have hClF₂ : IsClosed F₂ := π.isClosedMap _ (hClT'.inter hCl₂)
    have hCov0 : (T₀ : Set X) ⊆ F₁ ∪ F₂ := by
      intro x hx
      obtain ⟨x', hx'_T', hx'_π⟩ := (hBij x hx).exists
      rcases hCov hx'_T' with hx'₁ | hx'₂
      · exact Or.inl ⟨x', ⟨hx'_T', hx'₁⟩, hx'_π⟩
      · exact Or.inr ⟨x', ⟨hx'_T', hx'₂⟩, hx'_π⟩
    rcases isPreirreducible_iff_isClosed_union_isClosed.mp hIrred0.isPreirreducible
        F₁ F₂ hClF₁ hClF₂ hCov0 with h₁ | h₂
    · exact Or.inl (hPull C₁ h₁)
    · exact Or.inr (hPull C₂ h₂)

theorem weil_toroidal_state_codim2_blowup_step (k : Type u) [Field k] [IsAlgClosed k] (m : ℕ)
    (B₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (Z_B₁ : Set B₁.left)
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (Z_X : Set X.left) (f : X ⟶ B₁)
    (K_pred : ℕ) (T : Fin (K_pred + 1) → TopologicalSpace.Closeds ↥X.left)
    (n_T : Fin (K_pred + 1) → ℕ)
    (hIntX : AlgebraicGeometry.IsIntegral X.left)
    (hProjX : IsProjectiveOverField k X)
    (hState : IsToroidalResolutionState k m B₁ Z_B₁ X Z_X f (K_pred + 1) T n_T)
    (X' : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (π : X' ⟶ X)
    (hBlowup : IsProjectiveIdealBlowupOver k
      (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal (T 0)) π) :
    ∃ (K' : ℕ) (T' : Fin K' → TopologicalSpace.Closeds ↥X'.left) (n_T' : Fin K' → ℕ),
