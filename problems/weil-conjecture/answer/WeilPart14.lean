        CategoryTheory.eqToIso (congrArg (fun ν => AlgebraicGeometry.Spec (CommRingCat.of (C ν))) he_ij₀)
      let g₀_raw : CategoryTheory.Limits.pullback (u₁ ij₀.1 ≫ P₁.hom) (v₂ ij₀.2 ≫ P₂.hom) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of (C ν₀)) :=
        (θ ij₀).hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ ij₀)) ≫ eqIso₀.hom
      let g₀ : 𝒰₁₂.X ij₀ ⟶ 𝒰_N.X ν₀_idx := g₀_raw
      have h_sq : 𝒰₁₂.f ij₀ ≫ σ = g₀ ≫ w_N ν₀ := by
        erw [hσ_loc ij₀]
        change (θ ij₀).hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ ij₀)) ≫
          w_N (e.symm ij₀) = g₀_raw ≫ w_N ν₀
        dsimp only [g₀_raw, eqIso₀, CategoryTheory.eqToIso.hom]
        rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, h_eqToHom_w he_ij₀]
      have h_range : σ ⁻¹ᵁ AlgebraicGeometry.Scheme.Hom.opensRange (w_N ν₀) =
          AlgebraicGeometry.Scheme.Hom.opensRange (𝒰₁₂.f ij₀) := by
        ext p
        constructor
        · intro hp
          let ij : Fin (N₁ + 1) × Fin (N₂ + 1) := 𝒰₁₂.idx p
          obtain ⟨x, hx⟩ := 𝒰₁₂.covers p
          have hx_mem : x ∈ (𝒰₁₂.f ij ≫ σ) ⁻¹ᵁ
              AlgebraicGeometry.Scheme.Hom.opensRange (w_N ν₀) := by
            change σ.base ((𝒰₁₂.f ij).base x) ∈ Set.range (w_N ν₀).base
            rw [hx]
            exact hp
          erw [hσ_loc ij] at hx_mem
          change ((θ ij).hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ ij)) ≫
            w_N (e.symm ij)).base x ∈ Set.range (w_N ν₀).base at hx_mem
          have h_open_N : Set.range (w_N ν₀).base =
              (AlgebraicGeometry.Proj.basicOpen 𝒜_N (X_N ν₀) : Set (AlgebraicGeometry.Proj 𝒜_N)) :=
            congrArg SetLike.coe
              (AlgebraicGeometry.Proj.opensRange_awayι 𝒜_N (X_N ν₀) (hX_N ν₀) zero_lt_one)
          rw [h_open_N] at hx_mem
          let q := (θ ij).hom.base x
          have hq_pre : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ ij))).base q ∈
              PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.isLocalizationElem
                (hX_N (e.symm ij)) (hX_N ν₀)) := by
            rw [← AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜_N
              (hX_N (e.symm ij)) zero_lt_one (hX_N ν₀) zero_lt_one]
            exact hx_mem
          have h_not_mem : φ ij (HomogeneousLocalization.Away.isLocalizationElem
              (hX_N (e.symm ij)) (hX_N ν₀)) ∉ q.asIdeal := hq_pre
          rw [hφ_ratio ij ν₀] at h_not_mem
          have h_prod_tmul :
              (HomogeneousLocalization.Away.isLocalizationElem (hX₁ ij.1) (hX₁ ij₀.1)) ⊗ₜ[k]
                (HomogeneousLocalization.Away.isLocalizationElem (hX₂ ij.2) (hX₂ ij₀.2)) =
              Algebra.TensorProduct.includeLeftRingHom
                (HomogeneousLocalization.Away.isLocalizationElem (hX₁ ij.1) (hX₁ ij₀.1)) *
              Algebra.TensorProduct.includeRight
                (HomogeneousLocalization.Away.isLocalizationElem (hX₂ ij.2) (hX₂ ij₀.2)) := by
            simp [Algebra.TensorProduct.includeLeftRingHom_apply,
              Algebra.TensorProduct.tmul_mul_tmul]
          rw [h_prod_tmul] at h_not_mem
          have h_not_L : Algebra.TensorProduct.includeLeftRingHom
              (HomogeneousLocalization.Away.isLocalizationElem (hX₁ ij.1) (hX₁ ij₀.1)) ∉
              q.asIdeal := fun hL => h_not_mem (Ideal.mul_mem_right _ _ hL)
          have h_not_R : Algebra.TensorProduct.includeRight
              (HomogeneousLocalization.Away.isLocalizationElem (hX₂ ij.2) (hX₂ ij₀.2)) ∉
              q.asIdeal := fun hR => h_not_mem (Ideal.mul_mem_left _ _ hR)
          let x_pb : ↥(CategoryTheory.Limits.pullback (u₁ ij.1 ≫ P₁.hom) (v₂ ij.2 ≫ P₂.hom)) := x
          have h_fst_mem : (CategoryTheory.Limits.pullback.fst P₁.hom P₂.hom).base p ∈
              Set.range (u₁ ij₀.1).base := by
            have hq₁_mem : ((θ ij).hom ≫ AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom)).base x_pb ∈
                PrimeSpectrum.basicOpen
                  (HomogeneousLocalization.Away.isLocalizationElem (hX₁ ij.1) (hX₁ ij₀.1)) :=
              h_not_L
            rw [hθ_fst ij, ← AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜₁
              (hX₁ ij.1) zero_lt_one (hX₁ ij₀.1) zero_lt_one] at hq₁_mem
            have hp1 : (CategoryTheory.Limits.pullback.fst P₁.hom P₂.hom).base p ∈
                (AlgebraicGeometry.Proj.basicOpen 𝒜₁ (X₁ ij₀.1) : Set (AlgebraicGeometry.Proj 𝒜₁)) := by
              rw [← hx]
              change (𝒰₁₂.f ij ≫ CategoryTheory.Limits.pullback.fst P₁.hom P₂.hom).base x ∈ _
              erw [h𝒰₁₂_fst ij]
              exact hq₁_mem
            rwa [← congrArg SetLike.coe (AlgebraicGeometry.Proj.opensRange_awayι 𝒜₁
              (X₁ ij₀.1) (hX₁ ij₀.1) zero_lt_one)] at hp1
          have h_snd_mem : (CategoryTheory.Limits.pullback.snd P₁.hom P₂.hom).base p ∈
              Set.range (v₂ ij₀.2).base := by
            let incR_ij : B ij.2 →+* TensorProduct k (A ij.1) (B ij.2) :=
              (Algebra.TensorProduct.includeRight :
                B ij.2 →ₐ[k] TensorProduct k (A ij.1) (B ij.2))
            have hq₂_mem : ((θ ij).hom ≫ AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom incR_ij)).base x_pb ∈
                PrimeSpectrum.basicOpen
                  (HomogeneousLocalization.Away.isLocalizationElem (hX₂ ij.2) (hX₂ ij₀.2)) :=
              h_not_R
            dsimp only [incR_ij] at hq₂_mem
            rw [hθ_snd ij, ← AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜₂
              (hX₂ ij.2) zero_lt_one (hX₂ ij₀.2) zero_lt_one] at hq₂_mem
            have hp2 : (CategoryTheory.Limits.pullback.snd P₁.hom P₂.hom).base p ∈
                (AlgebraicGeometry.Proj.basicOpen 𝒜₂ (X₂ ij₀.2) : Set (AlgebraicGeometry.Proj 𝒜₂)) := by
              rw [← hx]
              change (𝒰₁₂.f ij ≫ CategoryTheory.Limits.pullback.snd P₁.hom P₂.hom).base x ∈ _
              erw [h𝒰₁₂_snd ij]
              exact hq₂_mem
            rwa [← congrArg SetLike.coe (AlgebraicGeometry.Proj.opensRange_awayι 𝒜₂
              (X₂ ij₀.2) (hX₂ ij₀.2) zero_lt_one)] at hp2
          obtain ⟨x₁, hx₁⟩ := h_fst_mem
          obtain ⟨x₂, hx₂⟩ := h_snd_mem
          let M₀ := CategoryTheory.Limits.pullback (u₁ ij₀.1 ≫ P₁.hom) P₂.hom
          let β : M₀ ⟶ CategoryTheory.Limits.pullback P₁.hom P₂.hom :=
            CategoryTheory.Limits.pullback.map (u₁ ij₀.1 ≫ P₁.hom) P₂.hom P₁.hom P₂.hom
              (u₁ ij₀.1) (𝟙 P₂.left) (𝟙 _)
              (by rw [CategoryTheory.Category.comp_id])
              (by rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
          have hβ_fst : β ≫ CategoryTheory.Limits.pullback.fst P₁.hom P₂.hom =
              CategoryTheory.Limits.pullback.fst (u₁ ij₀.1 ≫ P₁.hom) P₂.hom ≫ u₁ ij₀.1 :=
            CategoryTheory.Limits.pullback.lift_fst _ _ _
          have hβ_snd : β ≫ CategoryTheory.Limits.pullback.snd P₁.hom P₂.hom =
              CategoryTheory.Limits.pullback.snd (u₁ ij₀.1 ≫ P₁.hom) P₂.hom := by
            erw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.comp_id]
          have hPb_β : CategoryTheory.IsPullback
              (CategoryTheory.Limits.pullback.fst (u₁ ij₀.1 ≫ P₁.hom) P₂.hom) β
              (u₁ ij₀.1) (CategoryTheory.Limits.pullback.fst P₁.hom P₂.hom) := by
            refine CategoryTheory.IsPullback.of_bot ?_ hβ_fst.symm
              (CategoryTheory.IsPullback.of_hasPullback P₁.hom P₂.hom)
            have h0 := CategoryTheory.IsPullback.of_hasPullback (u₁ ij₀.1 ≫ P₁.hom) P₂.hom
            rwa [hβ_snd]
          obtain ⟨m₀, _, hm₀⟩ :=
            AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hPb_β x₁ p hx₁
          let α : CategoryTheory.Limits.pullback (u₁ ij₀.1 ≫ P₁.hom) (v₂ ij₀.2 ≫ P₂.hom) ⟶ M₀ :=
            CategoryTheory.Limits.pullback.map
              (u₁ ij₀.1 ≫ P₁.hom) (v₂ ij₀.2 ≫ P₂.hom)
              (u₁ ij₀.1 ≫ P₁.hom) P₂.hom
              (𝟙 _) (v₂ ij₀.2) (𝟙 _)
              (by rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
              (by rw [CategoryTheory.Category.comp_id])
          have hα_fst : α ≫ CategoryTheory.Limits.pullback.fst (u₁ ij₀.1 ≫ P₁.hom) P₂.hom =
              CategoryTheory.Limits.pullback.fst (u₁ ij₀.1 ≫ P₁.hom) (v₂ ij₀.2 ≫ P₂.hom) := by
            erw [CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.comp_id]
          have hα_snd : α ≫ CategoryTheory.Limits.pullback.snd (u₁ ij₀.1 ≫ P₁.hom) P₂.hom =
              CategoryTheory.Limits.pullback.snd
                (u₁ ij₀.1 ≫ P₁.hom) (v₂ ij₀.2 ≫ P₂.hom) ≫ v₂ ij₀.2 :=
            CategoryTheory.Limits.pullback.lift_snd _ _ _
          have hPb_α : CategoryTheory.IsPullback
              (CategoryTheory.Limits.pullback.snd (u₁ ij₀.1 ≫ P₁.hom) (v₂ ij₀.2 ≫ P₂.hom)) α
              (v₂ ij₀.2) (CategoryTheory.Limits.pullback.snd (u₁ ij₀.1 ≫ P₁.hom) P₂.hom) := by
            refine CategoryTheory.IsPullback.of_bot ?_ hα_snd.symm
              (CategoryTheory.IsPullback.of_hasPullback (u₁ ij₀.1 ≫ P₁.hom) P₂.hom).flip
            have h0 := (CategoryTheory.IsPullback.of_hasPullback
              (u₁ ij₀.1 ≫ P₁.hom) (v₂ ij₀.2 ≫ P₂.hom)).flip
            rwa [hα_fst]
          have hm₀_snd : (CategoryTheory.Limits.pullback.snd (u₁ ij₀.1 ≫ P₁.hom) P₂.hom).base m₀ =
              (v₂ ij₀.2).base x₂ := by
            rw [← hβ_snd]
            change (CategoryTheory.Limits.pullback.snd P₁.hom P₂.hom).base (β.base m₀) = _
            rw [hm₀, hx₂]
          obtain ⟨z₀, _, hz₀⟩ :=
            AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hPb_α x₂ m₀ hm₀_snd.symm
          let f_ij₀ : CategoryTheory.Limits.pullback (u₁ ij₀.1 ≫ P₁.hom) (v₂ ij₀.2 ≫ P₂.hom) ⟶
              CategoryTheory.Limits.pullback P₁.hom P₂.hom := 𝒰₁₂.f ij₀
          have hαβ : α ≫ β = f_ij₀ := by
            apply CategoryTheory.Limits.pullback.hom_ext
            · rw [CategoryTheory.Category.assoc, hβ_fst, ← CategoryTheory.Category.assoc, hα_fst]
              exact (h𝒰₁₂_fst ij₀).symm
            · rw [CategoryTheory.Category.assoc, hβ_snd, hα_snd]
              exact (h𝒰₁₂_snd ij₀).symm
          refine ⟨z₀, ?_⟩
          change f_ij₀.base z₀ = p
          rw [← hαβ]
          change β.base (α.base z₀) = p
          rw [hz₀, hm₀]
        · rintro ⟨z₀, rfl⟩
          change (𝒰₁₂.f ij₀ ≫ σ).base z₀ ∈ Set.range (w_N ν₀).base
          rw [h_sq]
          exact ⟨g₀.base z₀, rfl⟩
      have h_pb₀ : CategoryTheory.IsPullback (𝒰₁₂.f ij₀) g₀ σ (𝒰_N.f ν₀_idx) :=
        (@AlgebraicGeometry.IsOpenImmersion.isPullback _ _ _ _ g₀ (𝒰₁₂.f ij₀) (w_N ν₀) σ
          hOpen_f hOpen_w h_sq h_range).flip
      have h_pbHom : AlgebraicGeometry.Scheme.Cover.pullbackHom 𝒰_N σ ν₀_idx =
          h_pb₀.isoPullback.inv ≫ g₀ :=
        h_pb₀.isoPullback_inv_snd.symm
      rw [h_pbHom]
      have hCl_1 : AlgebraicGeometry.IsClosedImmersion (θ ij₀).hom := inferInstance
      have hCl_2 : AlgebraicGeometry.IsClosedImmersion
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ ij₀))) :=
        AlgebraicGeometry.IsClosedImmersion.spec_of_surjective
          (CommRingCat.ofHom (φ ij₀)) (hφ_surj ij₀)
      have hCl_3 : AlgebraicGeometry.IsClosedImmersion eqIso₀.hom := inferInstance
      have hCl_4 : AlgebraicGeometry.IsClosedImmersion h_pb₀.isoPullback.inv := inferInstance
      have hCl_23 : AlgebraicGeometry.IsClosedImmersion
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ ij₀)) ≫ eqIso₀.hom) :=
        @AlgebraicGeometry.IsClosedImmersion.comp _ _ _ _ _ hCl_2 hCl_3
      have hCl_g₀ : AlgebraicGeometry.IsClosedImmersion g₀ :=
        @AlgebraicGeometry.IsClosedImmersion.comp _ _ _ _ _ hCl_1 hCl_23
      exact @AlgebraicGeometry.IsClosedImmersion.comp _ _ _ _ _ hCl_4 hCl_g₀
    exact ⟨σ, hCl_σ, hσ_hom⟩
  
  obtain ⟨j, hCl_j, hj_hom⟩ := hPart1
  obtain ⟨σ, hCl_σ, hσ_hom⟩ := hSegre
  have hCl_comp : AlgebraicGeometry.IsClosedImmersion (j ≫ σ) :=
    @AlgebraicGeometry.IsClosedImmersion.comp _ _ _ j σ hCl_j hCl_σ
  have h_over : (j ≫ σ) ≫ (weilProjectiveSpaceOver k N).hom = X'.hom := by
    rw [CategoryTheory.Category.assoc, hσ_hom, hj_hom]
  exact ⟨N, CategoryTheory.Over.homMk (j ≫ σ) h_over, hCl_comp⟩

theorem weil_projSpace_isProper_and_polynomial_charts (k : Type u) [Field k] (L : ℕ) :
    AlgebraicGeometry.IsProper (weilProjectiveSpaceOver k L).hom ∧
    ∃ (U_L : Fin (L + 1) → (weilProjectiveSpaceOver k L).left.Opens)
      (iso_L : ∀ β : Fin (L + 1),
        (U_L β : AlgebraicGeometry.Scheme.{u}) ≅
          AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial {α : Fin (L + 1) // α ≠ β} k))),
      ((⨆ β : Fin (L + 1), U_L β) = ⊤) ∧
      (∀ β : Fin (L + 1),
        (U_L β).ι ≫ (weilProjectiveSpaceOver k L).hom =
          (iso_L β).hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C)) ∧
      (∀ (β β' : Fin (L + 1)) (hβ' : β' ≠ β),
        ((iso_L β).inv ≫ (U_L β).ι) ⁻¹ᵁ U_L β' =
