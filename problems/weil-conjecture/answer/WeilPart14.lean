          (Spec.map hom_map_A₂)
          ((HasRingHomProperty.Spec_iff (P := @Etale) (Q := @RingHom.Etale)
            (φ := hom_map_A₂)).mpr hMap_locA₂_et)
          (by
            rw [hCompSpec]
            exact (HasRingHomProperty.Spec_iff (P := @Etale) (Q := @RingHom.Etale)
