    suffices hKer : Ideal.span (MvPolynomial.X '' (I : Set (Fin n))) = RingHom.ker ev.toRingHom by
      rw [hKer]
      exact RingHom.ker_isPrime ev.toRingHom
    apply le_antisymm
    · rw [Ideal.span_le]
      rintro _ ⟨j, hj, rfl⟩
      have hj' : j ∈ I := hj
      change ev (MvPolynomial.X j) = 0
      simp [ev, hj']
    · let liftBack : MvPolynomial {j : Fin n // j ∉ I} k →ₐ[k] MvPolynomial (Fin n) k :=
        MvPolynomial.aeval (fun j : {j : Fin n // j ∉ I} => MvPolynomial.X j.1)
      have hSub : ∀ f : MvPolynomial (Fin n) k,
          f - liftBack (ev f) ∈ Ideal.span (MvPolynomial.X '' (I : Set (Fin n))) := by
        intro f
        induction f using MvPolynomial.induction_on with
        | C a =>
          simp [ev, liftBack]
        | add p q hp hq =>
          simpa [map_add, sub_add_sub_comm] using Ideal.add_mem _ hp hq
        | mul_X p j hp =>
          by_cases hj : j ∈ I
