      · subst hℓ
        simp only [↓reduceIte, map_mul]
        rw [show mk_M' (MvPolynomial.X (Sum.inr c_div)) = y_div from rfl, hφ_div]
        change ι_M (toroidalCenterGen k S_exp i₀ j₀ b) * φ_tilde (MvPolynomial.X (Sum.inr ℓ)) = _
        rw [hφ_tilde_X]
        simp only [f_φ, ↓reduceIte]
        rw [hMul_W b_oth]
        exact congrArg ι_M hg_oth
      · simp only [hℓ, ↓reduceIte]
        change φ_tilde (MvPolynomial.X (Sum.inr ℓ)) = _
        rw [hφ_tilde_X]
        simp [f_φ, hℓ]
    have hConst_ι : ∀ c : k, ι_M (mk_M (MvPolynomial.C c)) = φ_b (mk_M' (MvPolynomial.C c)) := by
      intro c
      change ι_M (algebraMap k (toroidalModelRing k m S_exp) c) =
        φ_tilde (algebraMap k P c)
      rw [AlgHom.commutes]
      exact hι_alg c
    have hSurj : Function.Surjective ⇑φ_b := by
      apply hGen φ_b.toRingHom.range
      · intro m₀
        obtain ⟨p₀, rfl⟩ := Ideal.Quotient.mk_surjective m₀
        change ι_M (mk_M p₀) ∈ φ_b.toRingHom.range
        induction p₀ using MvPolynomial.induction_on with
        | C c => exact ⟨mk_M' (MvPolynomial.C c), (hConst_ι c).symm⟩
        | add p₁ p₂ hp₁ hp₂ =>
          rw [map_add, map_add]
          exact φ_b.toRingHom.range.add_mem hp₁ hp₂
        | mul_X q v hq =>
          rw [map_mul, map_mul]
          refine φ_b.toRingHom.range.mul_mem hq ?_
          rcases v with a | ℓ
          · exact ⟨_, hφ_inl a⟩
          · exact ⟨_, hφ_inr ℓ⟩
      · intro d
        rcases hb with ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩
        · fin_cases d
          · exact ⟨mk_M' (MvPolynomial.X (Sum.inl 0)), by
              change φ_tilde _ = _; rw [hφ_tilde_X]; rfl⟩
          · exact ⟨mk_M' (MvPolynomial.X (Sum.inl 1)), by
              change φ_tilde _ = _; rw [hφ_tilde_X]
              have h10 : ((1 : Fin 2) = 0) = False := by decide
              simp [f_φ, h10]⟩
          · exact ⟨1, by simp [hWb_one]⟩
          · exact ⟨mk_M' (MvPolynomial.X (Sum.inr c_oth)), by
              change φ_tilde _ = _; rw [hφ_tilde_X]
              simp [f_φ, b_oth]⟩
        · fin_cases d
          · exact ⟨mk_M' (MvPolynomial.X (Sum.inl 0)), by
              change φ_tilde _ = _; rw [hφ_tilde_X]; rfl⟩
          · exact ⟨mk_M' (MvPolynomial.X (Sum.inl 1)), by
              change φ_tilde _ = _; rw [hφ_tilde_X]
              have h10 : ((1 : Fin 2) = 0) = False := by decide
              simp [f_φ, h10]⟩
          · exact ⟨mk_M' (MvPolynomial.X (Sum.inr c_oth)), by
              change φ_tilde _ = _; rw [hφ_tilde_X]
              have h32 : ((3 : Fin 4) = 2) = False := by decide
              simp [f_φ, b_oth, h32]⟩
          · exact ⟨1, by simp [hWb_one]⟩
    let f_ψ : Fin 2 ⊕ Fin m → toroidalModelRing k m S₁ := fun v => match v with
      | Sum.inl a => mk_M' (MvPolynomial.X (Sum.inr c_div) * MvPolynomial.X (Sum.inl a))
      | Sum.inr ℓ =>
        if ℓ = c_oth then
          mk_M' (MvPolynomial.X (Sum.inr c_div) * MvPolynomial.X (Sum.inr c_oth))
        else mk_M' (MvPolynomial.X (Sum.inr ℓ))
    let ψ₀ : P →ₐ[k] toroidalModelRing k m S₁ := MvPolynomial.aeval f_ψ
    have hψ₀_X : ∀ v : Fin 2 ⊕ Fin m, ψ₀ (MvPolynomial.X v) = f_ψ v :=
      fun v => MvPolynomial.aeval_X f_ψ v
    have hψ₀_ker : ∀ x ∈ I_S, ψ₀ x = 0 := by
      have hFS_0 : ψ₀ F_S = 0 := by
        dsimp [F_S]
        rw [map_sub, map_mul, map_prod]
        let fnInrM' : Fin m → toroidalModelRing k m S₁ :=
          fun i => mk_M' (MvPolynomial.X (Sum.inr i))
        have hLHS : ψ₀ (MvPolynomial.X (Sum.inl 0)) * ψ₀ (MvPolynomial.X (Sum.inl 1)) =
            y_div * (y_div * ∏ i ∈ S₁, fnInrM' i) := by
          rw [hψ₀_X, hψ₀_X]
          dsimp [f_ψ, fnInrM']
          rw [map_mul, map_mul]
          calc
            (y_div * mk_M' (MvPolynomial.X (Sum.inl 0))) *
                (y_div * mk_M' (MvPolynomial.X (Sum.inl 1)))
              = y_div * (y_div *
                  (mk_M' (MvPolynomial.X (Sum.inl 0)) *
                    mk_M' (MvPolynomial.X (Sum.inl 1)))) := by ring
            _ = y_div * (y_div * ∏ i ∈ S₁, mk_M' (MvPolynomial.X (Sum.inr i))) := by rw [hRel_M']
        let fnPsi : Fin m → toroidalModelRing k m S₁ := fun i => ψ₀ (MvPolynomial.X (Sum.inr i))
        have hRHS : (∏ i ∈ S_exp, fnPsi i) =
            y_div * (y_div * ∏ i ∈ S₁, fnInrM' i) := by
          rw [← Finset.mul_prod_erase S_exp fnPsi hc_div_mem]
          change fnPsi c_div * (∏ x ∈ S₁, fnPsi x) = _
          rw [← Finset.mul_prod_erase S₁ fnPsi hc_oth_S₁]
          have hDiv : fnPsi c_div = y_div := by
            dsimp [fnPsi]; rw [hψ₀_X]; simp [f_ψ, hc_ne, y_div]
          have hOth : fnPsi c_oth = y_div * fnInrM' c_oth := by
            dsimp [fnPsi, fnInrM']; rw [hψ₀_X]; simp [f_ψ, map_mul, y_div]
          have hRest : (∏ x ∈ S₁.erase c_oth, fnPsi x) =
              ∏ x ∈ S₁.erase c_oth, fnInrM' x := by
            refine Finset.prod_congr rfl fun x hx => ?_
            have hxc : x ≠ c_oth := (Finset.mem_erase.mp hx).1
            dsimp [fnPsi, fnInrM']; rw [hψ₀_X]; simp [f_ψ, hxc]
          rw [hDiv, hOth, hRest]
          calc
            y_div * ((y_div * fnInrM' c_oth) * ∏ x ∈ S₁.erase c_oth, fnInrM' x)
              = y_div * (y_div * (fnInrM' c_oth * ∏ x ∈ S₁.erase c_oth, fnInrM' x)) := by ring
            _ = y_div * (y_div * ∏ i ∈ S₁, fnInrM' i) := by
                  rw [Finset.mul_prod_erase S₁ fnInrM' hc_oth_S₁]
        rw [hLHS]
        exact sub_eq_zero.mpr hRHS.symm
      have hle : I_S ≤ RingHom.ker ψ₀.toRingHom :=
        Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hFS_0)
      intro x hx
      exact hle hx
    let ψ_bar : toroidalModelRing k m S_exp →ₐ[k] toroidalModelRing k m S₁ :=
      Ideal.Quotient.liftₐ I_S ψ₀ hψ₀_ker
    let locMap := algebraMap (toroidalModelRing k m S₁) (Localization.Away y_div)
    have hψ_gb : ψ_bar (g_M b) = y_div := by
      rw [hg_div]
      change ψ₀ (MvPolynomial.X (Sum.inr c_div)) = y_div
      rw [hψ₀_X]; simp [f_ψ, hc_ne, y_div]
    have hUnit_gb : IsUnit ((locMap.comp ψ_bar.toRingHom) (g_M b)) := by
      change IsUnit (locMap (ψ_bar (g_M b)))
      rw [hψ_gb]
      exact IsLocalization.Away.algebraMap_isUnit y_div
    let Ψ_b : L_b →+* Localization.Away y_div := IsLocalization.Away.lift (g_M b) hUnit_gb
    have hΨ_alg : ∀ x : toroidalModelRing k m S_exp,
        Ψ_b (algebraMap (toroidalModelRing k m S_exp) L_b x) = locMap (ψ_bar x) :=
      fun x => IsLocalization.Away.lift_eq (g_M b) hUnit_gb x
    have hΨ_cancel : locMap y_div *
        Ψ_b (IsLocalization.Away.invSelf (S := L_b) (g_M b)) = 1 := by
      have hMapEq : locMap y_div = locMap (ψ_bar (g_M b)) := congrArg locMap hψ_gb.symm
      calc
        locMap y_div * Ψ_b (IsLocalization.Away.invSelf (S := L_b) (g_M b))
          = locMap (ψ_bar (g_M b)) * Ψ_b (IsLocalization.Away.invSelf (S := L_b) (g_M b)) := by
              rw [hMapEq]
        _ = Ψ_b (algebraMap (toroidalModelRing k m S_exp) L_b (g_M b)) *
              Ψ_b (IsLocalization.Away.invSelf (S := L_b) (g_M b)) := by rw [hΨ_alg]
        _ = Ψ_b (algebraMap (toroidalModelRing k m S_exp) L_b (g_M b) *
              IsLocalization.Away.invSelf (S := L_b) (g_M b)) := (map_mul Ψ_b _ _).symm
        _ = 1 := by rw [IsLocalization.Away.mul_invSelf (S := L_b) (g_M b), map_one]
    have hLeftComp : (Ψ_b.comp θ_lift).comp φ_b.toRingHom = locMap := by
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro c
        change Ψ_b (θ_lift (φ_b (mk_M' (MvPolynomial.C c)))) = locMap (mk_M' (MvPolynomial.C c))
        rw [← hConst_ι c, hθ_ι, hΨ_alg]
        congr 1
        change ψ₀ (MvPolynomial.C c) = mk_M' (MvPolynomial.C c)
        exact ψ₀.commutes c
      · intro v
        change Ψ_b (θ_lift (φ_tilde (MvPolynomial.X v))) = locMap (mk_M' (MvPolynomial.X v))
        rw [hφ_tilde_X]
        rcases v with a | ℓ
        · by_cases ha0 : a = 0
          · subst ha0
            simp only [f_φ, ↓reduceIte, hθ_W, map_mul, hΨ_alg]
            have hψ0 : ψ_bar (toroidalCenterGen k S_exp i₀ j₀ 0) =
                y_div * mk_M' (MvPolynomial.X (Sum.inl 0)) := by
              change ψ_bar (g_M 0) = _
              rw [hg_0]
              change ψ₀ (MvPolynomial.X (Sum.inl 0)) = _
              rw [hψ₀_X]; simp [f_ψ, map_mul, y_div]
            change locMap (ψ_bar (toroidalCenterGen k S_exp i₀ j₀ 0)) *
                Ψ_b (IsLocalization.Away.invSelf (S := L_b) (g_M b)) = _
            rw [hψ0, map_mul]
            calc
              (locMap y_div * locMap (mk_M' (MvPolynomial.X (Sum.inl 0)))) *
                  Ψ_b (IsLocalization.Away.invSelf (S := L_b) (g_M b))
                = locMap (mk_M' (MvPolynomial.X (Sum.inl 0))) *
                    (locMap y_div * Ψ_b (IsLocalization.Away.invSelf (S := L_b) (g_M b))) := by
                    ring
              _ = locMap (mk_M' (MvPolynomial.X (Sum.inl 0))) := by rw [hΨ_cancel, mul_one]
          · have ha1 : a = 1 := by omega
            subst ha1
            simp only [f_φ, ha0, ↓reduceIte, hθ_W, map_mul, hΨ_alg]
            have hψ1 : ψ_bar (toroidalCenterGen k S_exp i₀ j₀ 1) =
                y_div * mk_M' (MvPolynomial.X (Sum.inl 1)) := by
              change ψ_bar (g_M 1) = _
              rw [hg_1]
              change ψ₀ (MvPolynomial.X (Sum.inl 1)) = _
              rw [hψ₀_X]; simp [f_ψ, map_mul, y_div]
            change locMap (ψ_bar (toroidalCenterGen k S_exp i₀ j₀ 1)) *
                Ψ_b (IsLocalization.Away.invSelf (S := L_b) (g_M b)) = _
            rw [hψ1, map_mul]
            calc
              (locMap y_div * locMap (mk_M' (MvPolynomial.X (Sum.inl 1)))) *
                  Ψ_b (IsLocalization.Away.invSelf (S := L_b) (g_M b))
                = locMap (mk_M' (MvPolynomial.X (Sum.inl 1))) *
                    (locMap y_div * Ψ_b (IsLocalization.Away.invSelf (S := L_b) (g_M b))) := by
                    ring
              _ = locMap (mk_M' (MvPolynomial.X (Sum.inl 1))) := by rw [hΨ_cancel, mul_one]
        · by_cases hℓ : ℓ = c_oth
          · subst hℓ
            simp only [f_φ, ↓reduceIte, hθ_W, map_mul, hΨ_alg]
            have hψc : ψ_bar (toroidalCenterGen k S_exp i₀ j₀ b_oth) =
                y_div * mk_M' (MvPolynomial.X (Sum.inr ℓ)) := by
              change ψ_bar (g_M b_oth) = _
              rw [hg_oth]
              change ψ₀ (MvPolynomial.X (Sum.inr ℓ)) = _
              rw [hψ₀_X]; simp [f_ψ, map_mul, y_div]
            change locMap (ψ_bar (toroidalCenterGen k S_exp i₀ j₀ b_oth)) *
                Ψ_b (IsLocalization.Away.invSelf (S := L_b) (g_M b)) = _
            rw [hψc, map_mul]
            calc
              (locMap y_div * locMap (mk_M' (MvPolynomial.X (Sum.inr ℓ)))) *
                  Ψ_b (IsLocalization.Away.invSelf (S := L_b) (g_M b))
                = locMap (mk_M' (MvPolynomial.X (Sum.inr ℓ))) *
                    (locMap y_div * Ψ_b (IsLocalization.Away.invSelf (S := L_b) (g_M b))) := by
                    ring
              _ = locMap (mk_M' (MvPolynomial.X (Sum.inr ℓ))) := by rw [hΨ_cancel, mul_one]
          · simp only [f_φ, hℓ, ↓reduceIte, hθ_ι, hΨ_alg]
            congr 1
            change ψ₀ (MvPolynomial.X (Sum.inr ℓ)) = mk_M' (MvPolynomial.X (Sum.inr ℓ))
            rw [hψ₀_X]; simp [f_ψ, hℓ]
    have hInjAlg : Function.Injective ⇑locMap := by
      apply IsLocalization.injective (M := Submonoid.powers y_div) (Localization.Away y_div)
      rw [Submonoid.powers_le]
      exact mem_nonZeroDivisors_of_ne_zero hDivNe
    have hInj : Function.Injective ⇑φ_b := by
      intro x y hxy
      apply hInjAlg
      rw [← hLeftComp]
      change Ψ_b (θ_lift (φ_b x)) = Ψ_b (θ_lift (φ_b y))
      rw [hxy]
    let Φ_b : toroidalModelRing k m S₁ ≃ₐ[k] C_b := AlgEquiv.ofBijective φ_b ⟨hInj, hSurj⟩
    refine ⟨Φ_b, ?_, ?_⟩
    · intro a
      rw [AlgEquiv.symm_apply_eq]
      exact (hφ_inl a).symm
    · intro ℓ
      rw [AlgEquiv.symm_apply_eq]
      exact (hφ_inr ℓ).symm
  refine ⟨hPillar2, ?_⟩
  intro S_exp _hCard i₀ j₀ hi₀ hj₀ hij
  dsimp only
  refine ⟨?_, ?_, ?_⟩
  · intro R' _ _ _
    obtain ⟨hDomM, hVarNeM⟩ := hPillar1 S_exp
    have hg_M : ∀ d : Fin 4, toroidalCenterGen k S_exp i₀ j₀ d ≠ 0 := by
      intro d
      fin_cases d
      · exact hVarNeM (Sum.inl 0)
      · exact hVarNeM (Sum.inl 1)
      · exact hVarNeM (Sum.inr i₀)
      · exact hVarNeM (Sum.inr j₀)
    have hRange_gM : Set.range (toroidalCenterGen k S_exp i₀ j₀) =
        {Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl 0)),
         Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl 1)),
         Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr i₀)),
         Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr j₀))} := by
      ext x
      simp only [Set.mem_range, Set.mem_insert_iff, Set.mem_singleton_iff]
      constructor
      · rintro ⟨d, rfl⟩
        fin_cases d
        · exact Or.inl rfl
        · exact Or.inr (Or.inl rfl)
        · exact Or.inr (Or.inr (Or.inl rfl))
        · exact Or.inr (Or.inr (Or.inr rfl))
      · rintro (rfl | rfl | rfl | rfl)
        · exact ⟨0, rfl⟩
        · exact ⟨1, rfl⟩
        · exact ⟨2, rfl⟩
        · exact ⟨3, rfl⟩
    have hSpanEq : Ideal.span (Set.range fun b : Fin 4 =>
        algebraMap (toroidalModelRing k m S_exp) R' (toroidalCenterGen k S_exp i₀ j₀ b)) =
        Ideal.map (algebraMap (toroidalModelRing k m S_exp) R') (Ideal.span
          {Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl 0)),
           Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl 1)),
           Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr i₀)),
           Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr j₀))}) := by
      rw [Ideal.map_span, ← hRange_gM, ← Set.range_comp]
      rfl
    have hRad : (Ideal.span (Set.range fun b : Fin 4 =>
        algebraMap (toroidalModelRing k m S_exp) R'
          (toroidalCenterGen k S_exp i₀ j₀ b))).IsRadical := by
      rw [hSpanEq]
      exact (hPillar2 S_exp i₀ j₀ hi₀ hj₀ hij).2.2.2 R'
    have hBase := @hPillar3 (toroidalModelRing k m S_exp) R' _ hDomM _ _ _ 4
      (toroidalCenterGen k S_exp i₀ j₀) hg_M
    exact ⟨hRad, hBase.1, hBase.2⟩
  · intro b a_div a_oth hb
    obtain ⟨hAlg, θ_lift, hθ_inj, hθ_ι, hθ_W, hWb_one, hMul_W, hGen⟩ :=
      hBlowupSpec (toroidalModelRing k m S_exp) (toroidalCenterGen k S_exp i₀ j₀) b
    exact hPillar4Abs S_exp i₀ j₀ hi₀ hj₀ hij b a_div a_oth hb
      (affineBlowupRatioRing (toroidalModelRing k m S_exp) (toroidalCenterGen k S_exp i₀ j₀) b)
      (Localization.Away (toroidalCenterGen k S_exp i₀ j₀ b))
      ((Ideal.Quotient.mk _).comp MvPolynomial.C)
      (fun d => Ideal.Quotient.mk _ (MvPolynomial.X d))
      hAlg θ_lift hθ_inj hθ_ι hθ_W hWb_one hMul_W hGen
  · intro b c_div c_oth hb
    obtain ⟨hDom', hVarNe'⟩ := hPillar1 (S_exp.erase c_div)
    obtain ⟨hAlg, θ_lift, hθ_inj, hθ_ι, hθ_W, hWb_one, hMul_W, hGen⟩ :=
      hBlowupSpec (toroidalModelRing k m S_exp) (toroidalCenterGen k S_exp i₀ j₀) b
    exact hPillar5Abs S_exp i₀ j₀ hi₀ hj₀ hij b c_div c_oth hb hDom'
      (hVarNe' (Sum.inr c_div))
      (affineBlowupRatioRing (toroidalModelRing k m S_exp) (toroidalCenterGen k S_exp i₀ j₀) b)
      (Localization.Away (toroidalCenterGen k S_exp i₀ j₀ b))
      ((Ideal.Quotient.mk _).comp MvPolynomial.C)
      (fun d => Ideal.Quotient.mk _ (MvPolynomial.X d))
      hAlg θ_lift hθ_inj hθ_ι hθ_W hWb_one hMul_W hGen

theorem weil_toroidal_codim3_center_and_local_bijection (k : Type u) [Field k] (m N : ℕ)
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (Z : Set X.left)
    (E : Fin (N + 1) → AlgebraicGeometry.Scheme.{u})
    (ιE : ∀ α : Fin (N + 1), E α ⟶ X.left)
    (hWit : IsToroidalSquarefreeWitness k m (N + 1) X Z E ιE)
    (hSingPair : ∀ (y : X.left) (R' : CommRingCat.{u}) (v : AlgebraicGeometry.Spec R')
        (e_X : AlgebraicGeometry.Spec R' ⟶ X.left)
        (S_exp : Finset (Fin m)) (a b : Fin m)
        (q : AlgebraicGeometry.Spec R' ⟶ AlgebraicGeometry.Spec
          (CommRingCat.of (toroidalModelRing k m S_exp))),
      AlgebraicGeometry.Etale e_X →
      AlgebraicGeometry.Etale q →
      e_X.base v = y →
      q ≫ AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) = e_X ≫ X.hom →
      (∀ c : Fin 2,
        Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl c)) ∈ (q.base v).asIdeal) →
      a ∈ S_exp →
      b ∈ S_exp →
      a ≠ b →
      Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr a)) ∈ (q.base v).asIdeal →
      Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr b)) ∈ (q.base v).asIdeal →
      ¬ ∃ V : X.left.Opens,
        y ∈ V ∧ AlgebraicGeometry.SmoothOfRelativeDimension (m + 1) (V.ι ≫ X.hom)) :
    let K : Set X.left := Set.range (ιE (Fin.last N)).base
    IsClosed K ∧
    IsIrreducible K ∧
    Kᶜ.Nonempty ∧
    (∀ α : Fin N, (Set.range (ιE α.castSucc).base \ K).Nonempty) ∧
    (∀ (x : X.left) (R' : CommRingCat.{u}) (v₀ : AlgebraicGeometry.Spec R')
        (e_X : AlgebraicGeometry.Spec R' ⟶ X.left)
        (S_exp S_bdry : Finset (Fin m))
        (q : AlgebraicGeometry.Spec R' ⟶ AlgebraicGeometry.Spec
          (CommRingCat.of (toroidalModelRing k m S_exp))),
      AlgebraicGeometry.Etale e_X →
      AlgebraicGeometry.Etale q →
      e_X.base v₀ = x →
      2 ≤ S_exp.card →
      S_exp ⊆ S_bdry →
      q ≫ AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) = e_X ≫ X.hom →
      (∀ a : Fin 2,
        Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl a)) ∈ (q.base v₀).asIdeal) →
      (∀ i ∈ S_bdry,
        Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr i)) ∈ (q.base v₀).asIdeal) →
      (∀ α : Fin (N + 1), x ∉ Set.range (ιE α).base →
        e_X.base ⁻¹' Set.range (ιE α).base = ∅) →
      (∀ α : Fin (N + 1), x ∈ Set.range (ιE α).base →
        ∃ i ∈ S_exp, ∃ j ∈ S_exp, i ≠ j ∧
          e_X.base ⁻¹' Set.range (ιE α).base =
            {v : AlgebraicGeometry.Spec R' |
              (∀ a : Fin 2,
                Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl a)) ∈ (q.base v).asIdeal) ∧
              Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr i)) ∈ (q.base v).asIdeal ∧
              Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr j)) ∈ (q.base v).asIdeal}) →
      ∀ a ∈ S_exp, ∀ b ∈ S_exp, a ≠ b →
        ∃ β : Fin (N + 1), x ∈ Set.range (ιE β).base ∧
          e_X.base ⁻¹' Set.range (ιE β).base =
            {v : AlgebraicGeometry.Spec R' |
              (∀ c : Fin 2,
                Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl c)) ∈ (q.base v).asIdeal) ∧
              Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr a)) ∈ (q.base v).asIdeal ∧
              Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr b)) ∈ (q.base v).asIdeal}) :=
by
  intro K
  have hKillPrime :
      ∀ (S_exp : Finset (Fin m)) (K_kill : Finset (Fin 2 ⊕ Fin m)),
        (Sum.inl 0 ∈ K_kill ∨ Sum.inl 1 ∈ K_kill) →
        (∃ i ∈ S_exp, Sum.inr i ∈ K_kill) →
        ∃ 𝔮 : Ideal (toroidalModelRing k m S_exp),
          𝔮.IsPrime ∧
          (∀ s : Fin 2 ⊕ Fin m,
            Ideal.Quotient.mk _ (MvPolynomial.X s) ∈ 𝔮 ↔ s ∈ K_kill) ∧
          (∀ I : Ideal (toroidalModelRing k m S_exp),
            (∀ s ∈ K_kill, Ideal.Quotient.mk _ (MvPolynomial.X s) ∈ I) → 𝔮 ≤ I) := by
    intro S_exp K_kill hInl_kill hInr_kill
    let P := MvPolynomial (Fin 2 ⊕ Fin m) k
    let F : P := MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
      ∏ i ∈ S_exp, MvPolynomial.X (Sum.inr i)
    let J_F : Ideal P := Ideal.span ({F} : Set P)
    let ev_K : P →+* P := MvPolynomial.eval₂Hom MvPolynomial.C
      (fun s : Fin 2 ⊕ Fin m => if s ∈ K_kill then (0 : P) else MvPolynomial.X s)
    have hevX : ∀ s : Fin 2 ⊕ Fin m,
        ev_K (MvPolynomial.X s) = if s ∈ K_kill then (0 : P) else MvPolynomial.X s :=
      fun s => MvPolynomial.eval₂Hom_X' _ _ s
    have hevC : ∀ c : k, ev_K (MvPolynomial.C c) = MvPolynomial.C c :=
      fun c => MvPolynomial.eval₂Hom_C _ _ c
    have hInl_zero : ev_K (MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1)) = 0 := by
      rw [map_mul, hevX, hevX]
      rcases hInl_kill with h0 | h1
      · simp [h0]
      · simp [h1]
    have hInr_zero : ev_K (∏ i ∈ S_exp, MvPolynomial.X (Sum.inr i)) = 0 := by
      obtain ⟨i₀, hi₀, hi₀_kill⟩ := hInr_kill
      rw [map_prod]
      refine Finset.prod_eq_zero hi₀ ?_
      rw [hevX]
      simp only [hi₀_kill, ↓reduceIte]
    have hF_ker : ∀ a ∈ J_F, ev_K a = 0 := by
      have hle : J_F ≤ RingHom.ker ev_K := by
        rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
        change ev_K (MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
          ∏ i ∈ S_exp, MvPolynomial.X (Sum.inr i)) = 0
        rw [map_sub, hInl_zero, hInr_zero, sub_self]
      intro a ha
      exact hle ha
    let evBar : toroidalModelRing k m S_exp →+* P := Ideal.Quotient.lift J_F ev_K hF_ker
    let 𝔮 : Ideal (toroidalModelRing k m S_exp) := RingHom.ker evBar
    refine ⟨𝔮, RingHom.ker_isPrime evBar, ?_, ?_⟩
    · intro s
      change evBar (Ideal.Quotient.mk J_F (MvPolynomial.X s)) = 0 ↔ s ∈ K_kill
      rw [Ideal.Quotient.lift_mk, hevX]
      by_cases hs : s ∈ K_kill
      · simp [hs]
      · simp [hs, MvPolynomial.X_ne_zero s]
    · intro I hI
      let f₁ : P →+* (toroidalModelRing k m S_exp ⧸ I) :=
        (Ideal.Quotient.mk I).comp (Ideal.Quotient.mk J_F)
      let f₂ : P →+* (toroidalModelRing k m S_exp ⧸ I) := f₁.comp ev_K
      have hf : f₁ = f₂ := by
        apply MvPolynomial.ringHom_ext'
        · ext c
          change f₁ (MvPolynomial.C c) = f₁ (ev_K (MvPolynomial.C c))
          rw [hevC]
        · intro s
          change f₁ (MvPolynomial.X s) = f₁ (ev_K (MvPolynomial.X s))
          rw [hevX]
          by_cases hs : s ∈ K_kill
          · simp only [hs, ↓reduceIte, map_zero]
            exact Ideal.Quotient.eq_zero_iff_mem.mpr (hI s hs)
          · simp only [hs, ↓reduceIte]
      intro z hz
      obtain ⟨G, rfl⟩ := Ideal.Quotient.mk_surjective z
      have hG : ev_K G = 0 := hz
      apply Ideal.Quotient.eq_zero_iff_mem.mp
      change f₁ G = 0
      rw [hf]
      change f₁ (ev_K G) = 0
      rw [hG, map_zero]
  have hGoingDown :
      ∀ (A R' : CommRingCat.{u})
        (q : AlgebraicGeometry.Spec R' ⟶ AlgebraicGeometry.Spec A),
        AlgebraicGeometry.Etale q →
        ∀ (v₀ : AlgebraicGeometry.Spec R') (𝔮 : Ideal A),
          𝔮.IsPrime →
          𝔮 ≤ (q.base v₀).asIdeal →
          ∃ v : AlgebraicGeometry.Spec R',
            v.asIdeal ≤ v₀.asIdeal ∧ (q.base v).asIdeal = 𝔮 := by
    intro A R' q hEt v₀ 𝔮 hPrime hle
    let φ_cat : A ⟶ R' := AlgebraicGeometry.Spec.preimage q
    have hq : AlgebraicGeometry.Spec.map φ_cat = q := AlgebraicGeometry.Spec.map_preimage q
    let φ : A →+* R' := φ_cat.hom
    have hComap : ∀ w : AlgebraicGeometry.Spec R',
        (q.base w).asIdeal = Ideal.comap φ w.asIdeal := by
      intro w
      rw [← hq, AlgebraicGeometry.Spec.map_apply]
      rfl
    have : AlgebraicGeometry.Etale q := hEt
    have hFlat_q : AlgebraicGeometry.Flat q := inferInstance
    rw [← hq] at hFlat_q
    have hFlat_φ : RingHom.Flat φ :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Flat)).mp hFlat_q
    let : Algebra A R' := φ.toAlgebra
    have hAlgEq : algebraMap A R' = φ := rfl
    have : Module.Flat A R' := RingHom.flat_algebraMap_iff.mp (hAlgEq.symm ▸ hFlat_φ)
    have : Algebra.HasGoingDown A R' := Algebra.HasGoingDown.of_flat
    let Q₀ : PrimeSpectrum R' := v₀
    let q₀ : PrimeSpectrum A := q.base v₀
    have : Q₀.asIdeal.IsPrime := Q₀.isPrime
    have : q₀.asIdeal.IsPrime := q₀.isPrime
    have : 𝔮.IsPrime := hPrime
    have : Q₀.asIdeal.LiesOver q₀.asIdeal := by
      refine ⟨?_⟩
      rw [Ideal.under_def, hAlgEq]
      exact hComap v₀
    obtain ⟨P, hPle, hPprime, hPover⟩ :=
      Ideal.exists_ideal_le_liesOver_of_le (R := A) (S := R') (p := 𝔮) (q := q₀.asIdeal)
        Q₀.asIdeal hle
    let v : AlgebraicGeometry.Spec R' := (⟨P, hPprime⟩ : PrimeSpectrum R')
    refine ⟨v, hPle, ?_⟩
    rw [hComap v]
    have hover := hPover.over
    rw [Ideal.under_def, hAlgEq] at hover
    exact hover.symm
  have hEtaleIrredEq :
      ∀ (S W : AlgebraicGeometry.Scheme.{u}) (e : W ⟶ S),
        AlgebraicGeometry.Etale e →
        ∀ (v₀ : W) (A B : Set S),
          IsClosed A → IsIrreducible A →
          IsClosed B → IsIrreducible B →
          e.base v₀ ∈ A → e.base v₀ ∈ B →
          e.base ⁻¹' A = e.base ⁻¹' B →
          A = B := by
    intro S W e hEt v₀ A B hClA hIrredA hClB hIrredB hvA hvB hPre
    have : AlgebraicGeometry.Etale e := hEt
    have hOpenMap : IsOpenMap e.base := AlgebraicGeometry.Scheme.Hom.isOpenMap e
    let O : Set S := Set.range e.base
    have hOpenO : IsOpen O := hOpenMap.isOpen_range
    have hvO : e.base v₀ ∈ O := ⟨v₀, rfl⟩
    have hInterEq : A ∩ O = B ∩ O := by
      simpa only [O, Set.image_preimage_eq_inter_range] using congrArg (e.base '' ·) hPre
    have hClInter : ∀ (T : Set S), IsClosed T → IsIrreducible T → e.base v₀ ∈ T →
        closure (T ∩ O) = T := by
      intro T hClT hIrredT hvT
      apply Set.Subset.antisymm
      · exact closure_minimal Set.inter_subset_left hClT
      · exact subset_closure_inter_of_isPreirreducible_of_isOpen
          hIrredT.2 hOpenO ⟨e.base v₀, hvT, hvO⟩
    rw [← hClInter A hClA hIrredA hvA, hInterEq, hClInter B hClB hIrredB hvB]
  rcases hWit with ⟨hClE, hIntE, _hSmE, hPairE, hSingEq, hCharts⟩
  have hClosedE : ∀ γ : Fin (N + 1), IsClosed (Set.range (ιE γ).base) := by
    intro γ
    have : AlgebraicGeometry.IsClosedImmersion (ιE γ) := hClE γ
    exact (ιE γ).isClosedEmbedding.isClosed_range
  have hIrredE : ∀ γ : Fin (N + 1), IsIrreducible (Set.range (ιE γ).base) := by
    intro γ
    have : AlgebraicGeometry.IsIntegral (E γ) := hIntE γ
    have : IrreducibleSpace ↥(E γ) := AlgebraicGeometry.irreducibleSpace_of_isIntegral (E γ)
    rw [← Set.image_univ]
    have hUniv : IsIrreducible (Set.univ : Set ↥(E γ)) :=
      ⟨Set.univ_nonempty, PreirreducibleSpace.isPreirreducible_univ⟩
    exact hUniv.image (ιE γ).base (ιE γ).continuous.continuousOn
  have hSing_of_mem : ∀ (γ : Fin (N + 1)) (y : X.left),
      y ∈ Set.range (ιE γ).base →
      ¬ ∃ V : X.left.Opens,
        y ∈ V ∧ AlgebraicGeometry.SmoothOfRelativeDimension (m + 1) (V.ι ≫ X.hom) := by
    intro γ y hy
    have hyUnion : y ∈ ⋃ β : Fin (N + 1), Set.range (ιE β).base := Set.mem_iUnion.mpr ⟨γ, hy⟩
    rw [← hSingEq] at hyUnion
    exact hyUnion
  have hNonUnivK : Kᶜ.Nonempty := by
    obtain ⟨x₀, hx₀K⟩ := (hIrredE (Fin.last N)).1
    rcases hCharts x₀ with ⟨hSm, _⟩ |
      ⟨R', v₀, e_X, S_exp, S_bdry, q, _hEt_e, hEt_q, _hv₀, _hCard, hSub, _hComm,
        hInl, hInr, _hZ, _hEmpty, hStrata⟩
    · exact (hSing_of_mem (Fin.last N) x₀ hx₀K hSm).elim
    · obtain ⟨i₀, hi₀, j₀, _hj₀, _hij₀, hPreK⟩ := hStrata (Fin.last N) hx₀K
      let K_kill₀ : Finset (Fin 2 ⊕ Fin m) := {Sum.inl 1, Sum.inr i₀}
      obtain ⟨𝔮₀, hPrime₀, hMem₀, hMin₀⟩ :=
        hKillPrime S_exp K_kill₀ (Or.inr (by simp [K_kill₀])) ⟨i₀, hi₀, by simp [K_kill₀]⟩
      have hle₀ : 𝔮₀ ≤ (q.base v₀).asIdeal := by
        apply hMin₀
        intro s hs
        simp only [K_kill₀, Finset.mem_insert, Finset.mem_singleton] at hs
        rcases hs with rfl | rfl
        · exact hInl 1
        · exact hInr i₀ (hSub hi₀)
      obtain ⟨v₁, _hv₁_le, hv₁_eq⟩ :=
        hGoingDown (CommRingCat.of (toroidalModelRing k m S_exp)) R' q hEt_q v₀ 𝔮₀
          hPrime₀ hle₀
      have hNotKill0 : (Sum.inl (0 : Fin 2) : Fin 2 ⊕ Fin m) ∉ K_kill₀ := by simp [K_kill₀]
      have hX0_not :
          Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl 0)) ∉ (q.base v₁).asIdeal := by
        rw [hv₁_eq, hMem₀]
        exact hNotKill0
      refine ⟨e_X.base v₁, ?_⟩
      intro hv₁K
      have hv₁Pre : v₁ ∈ e_X.base ⁻¹' K := hv₁K
      dsimp only [K] at hv₁Pre
      rw [hPreK] at hv₁Pre
      exact hX0_not (hv₁Pre.1 0)
  have hNonCont : ∀ α : Fin N, (Set.range (ιE α.castSucc).base \ K).Nonempty := by
    intro α
    obtain ⟨x_α, hx_α⟩ := (hIrredE α.castSucc).1
    by_cases hxK : x_α ∈ K
    · rcases hCharts x_α with ⟨hSm, _⟩ |
        ⟨R', v₀, e_X, S_exp, S_bdry, q, hEt_e, hEt_q, hv₀, _hCard, hSub, _hComm,
          hInl, hInr, _hZ, _hEmpty, hStrata⟩
      · exact (hSing_of_mem (Fin.last N) x_α hxK hSm).elim
      · obtain ⟨i_α, hi_α, j_α, hj_α, _hij_α, hPre_α⟩ := hStrata α.castSucc hx_α
        obtain ⟨i_0, _hi_0, j_0, _hj_0, hij_0, hPre_K⟩ := hStrata (Fin.last N) hxK
        let K_kill_α : Finset (Fin 2 ⊕ Fin m) :=
          {Sum.inl 0, Sum.inl 1, Sum.inr i_α, Sum.inr j_α}
        obtain ⟨𝔮_α, hPrime_α, hMem_α, hMin_α⟩ :=
          hKillPrime S_exp K_kill_α (Or.inl (by simp [K_kill_α]))
            ⟨i_α, hi_α, by simp [K_kill_α]⟩
        have hle_α : 𝔮_α ≤ (q.base v₀).asIdeal := by
          apply hMin_α
          intro s hs
          simp only [K_kill_α, Finset.mem_insert, Finset.mem_singleton] at hs
          rcases hs with rfl | rfl | rfl | rfl
          · exact hInl 0
          · exact hInl 1
          · exact hInr i_α (hSub hi_α)
          · exact hInr j_α (hSub hj_α)
        obtain ⟨v_α, _hv_α_le, hv_α_eq⟩ :=
          hGoingDown (CommRingCat.of (toroidalModelRing k m S_exp)) R' q hEt_q v₀ 𝔮_α
            hPrime_α hle_α
        have hv_α_mem : e_X.base v_α ∈ Set.range (ιE α.castSucc).base := by
          change v_α ∈ e_X.base ⁻¹' Set.range (ιE α.castSucc).base
          rw [hPre_α]
          refine ⟨?_, ?_, ?_⟩
          · refine Fin.forall_fin_two.mpr ⟨?_, ?_⟩
            · rw [hv_α_eq, hMem_α]; simp [K_kill_α]
            · rw [hv_α_eq, hMem_α]; simp [K_kill_α]
          · rw [hv_α_eq, hMem_α]; simp [K_kill_α]
          · rw [hv_α_eq, hMem_α]; simp [K_kill_α]
        have hv_α_notK : e_X.base v_α ∉ K := by
          intro hvK
          have hvPreK : v_α ∈ e_X.base ⁻¹' K := hvK
          dsimp only [K] at hvPreK
          rw [hPre_K] at hvPreK
          have hi0_mem : (Sum.inr i_0 : Fin 2 ⊕ Fin m) ∈ K_kill_α := by
            rw [← hMem_α, ← hv_α_eq]
            exact hvPreK.2.1
          have hj0_mem : (Sum.inr j_0 : Fin 2 ⊕ Fin m) ∈ K_kill_α := by
            rw [← hMem_α, ← hv_α_eq]
            exact hvPreK.2.2
          have hi0_eq : i_0 = i_α ∨ i_0 = j_α := by simpa [K_kill_α] using hi0_mem
          have hj0_eq : j_0 = i_α ∨ j_0 = j_α := by simpa [K_kill_α] using hj0_mem
          have hPair_eq : (i_0 = i_α ∧ j_0 = j_α) ∨ (i_0 = j_α ∧ j_0 = i_α) := by
            rcases hi0_eq with rfl | rfl <;> rcases hj0_eq with rfl | rfl
            · exact (hij_0 rfl).elim
            · exact Or.inl ⟨rfl, rfl⟩
            · exact Or.inr ⟨rfl, rfl⟩
            · exact (hij_0 rfl).elim
          have hPreEq : e_X.base ⁻¹' Set.range (ιE α.castSucc).base = e_X.base ⁻¹' K := by
            dsimp only [K]
            rw [hPre_α, hPre_K]
            rcases hPair_eq with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
            · rfl
            · ext v
              exact and_congr_right' and_comm
          have hEqSet : Set.range (ιE α.castSucc).base = K :=
            hEtaleIrredEq X.left (AlgebraicGeometry.Spec R') e_X hEt_e v₀
              (Set.range (ιE α.castSucc).base) K
              (hClosedE α.castSucc) (hIrredE α.castSucc)
              (hClosedE (Fin.last N)) (hIrredE (Fin.last N))
              (hv₀.symm ▸ hx_α) (hv₀.symm ▸ hxK) hPreEq
          exact hPairE (Fin.castSucc_ne_last α) hEqSet
        exact ⟨e_X.base v_α, hv_α_mem, hv_α_notK⟩
    · exact ⟨x_α, hx_α, hxK⟩
  refine ⟨hClosedE (Fin.last N), hIrredE (Fin.last N), hNonUnivK, hNonCont, ?_⟩
  intro x R' v₀ e_X S_exp S_bdry q hEt_e hEt_q _hv₀ _hCard hSub hComm hInl hInr hEmpty hStrata
    a ha b hb hab
  let K_kill_ab : Finset (Fin 2 ⊕ Fin m) := {Sum.inl 0, Sum.inl 1, Sum.inr a, Sum.inr b}
  obtain ⟨𝔮_ab, hPrime_ab, hMem_ab, hMin_ab⟩ :=
    hKillPrime S_exp K_kill_ab (Or.inl (by simp [K_kill_ab])) ⟨a, ha, by simp [K_kill_ab]⟩
  have hle_ab : 𝔮_ab ≤ (q.base v₀).asIdeal := by
    apply hMin_ab
    intro s hs
    simp only [K_kill_ab, Finset.mem_insert, Finset.mem_singleton] at hs
    rcases hs with rfl | rfl | rfl | rfl
    · exact hInl 0
    · exact hInl 1
    · exact hInr a (hSub ha)
    · exact hInr b (hSub hb)
  obtain ⟨v_ab, _hv_ab_le, hv_ab_eq⟩ :=
    hGoingDown (CommRingCat.of (toroidalModelRing k m S_exp)) R' q hEt_q v₀ 𝔮_ab
      hPrime_ab hle_ab
  have hInl_ab : ∀ c : Fin 2,
      Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl c)) ∈ (q.base v_ab).asIdeal := by
    refine Fin.forall_fin_two.mpr ⟨?_, ?_⟩
    · rw [hv_ab_eq, hMem_ab]; simp [K_kill_ab]
    · rw [hv_ab_eq, hMem_ab]; simp [K_kill_ab]
  have ha_ab : Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr a)) ∈ (q.base v_ab).asIdeal := by
    rw [hv_ab_eq, hMem_ab]; simp [K_kill_ab]
  have hb_ab : Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr b)) ∈ (q.base v_ab).asIdeal := by
    rw [hv_ab_eq, hMem_ab]; simp [K_kill_ab]
  have hNotSm : ¬ ∃ V : X.left.Opens,
      e_X.base v_ab ∈ V ∧
      AlgebraicGeometry.SmoothOfRelativeDimension (m + 1) (V.ι ≫ X.hom) :=
    hSingPair (e_X.base v_ab) R' v_ab e_X S_exp a b q hEt_e hEt_q rfl hComm
      hInl_ab ha hb hab ha_ab hb_ab
  have hv_union : e_X.base v_ab ∈ ⋃ β : Fin (N + 1), Set.range (ιE β).base := by
    rw [← hSingEq]
    exact hNotSm
  obtain ⟨β, hv_β⟩ := Set.mem_iUnion.mp hv_union
  have hx_β : x ∈ Set.range (ιE β).base := by
    by_contra hx_not
    have hv_pre : v_ab ∈ e_X.base ⁻¹' Set.range (ιE β).base := hv_β
    rw [hEmpty β hx_not] at hv_pre
    exact hv_pre
  obtain ⟨i, _hi, j, _hj, hij, hPre_β⟩ := hStrata β hx_β
  have hv_pre_β : v_ab ∈ e_X.base ⁻¹' Set.range (ιE β).base := hv_β
  rw [hPre_β] at hv_pre_β
  have hi_mem : (Sum.inr i : Fin 2 ⊕ Fin m) ∈ K_kill_ab := by
    rw [← hMem_ab, ← hv_ab_eq]
    exact hv_pre_β.2.1
  have hj_mem : (Sum.inr j : Fin 2 ⊕ Fin m) ∈ K_kill_ab := by
    rw [← hMem_ab, ← hv_ab_eq]
    exact hv_pre_β.2.2
  have hi_eq : i = a ∨ i = b := by simpa [K_kill_ab] using hi_mem
  have hj_eq : j = a ∨ j = b := by simpa [K_kill_ab] using hj_mem
  have hPair_ab : (i = a ∧ j = b) ∨ (i = b ∧ j = a) := by
    rcases hi_eq with rfl | rfl <;> rcases hj_eq with rfl | rfl
    · exact (hij rfl).elim
    · exact Or.inl ⟨rfl, rfl⟩
    · exact Or.inr ⟨rfl, rfl⟩
    · exact (hij rfl).elim
  refine ⟨β, hx_β, ?_⟩
  rw [hPre_β]
  rcases hPair_ab with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
  · rfl
  · ext v
    exact and_congr_right' and_comm

theorem weil_reduced_subscheme_integral_and_etale_lift (k : Type u) [Field k]
    (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (S : Set Y.left)
    (hClosedS : IsClosed S)
    (hIrredS : IsIrreducible S) :
    let ℐ := AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal ⟨S, hClosedS⟩
    AlgebraicGeometry.IsClosedImmersion ℐ.subschemeι ∧
    Set.range ℐ.subschemeι.base = S ∧
    AlgebraicGeometry.IsIntegral ℐ.subscheme ∧
