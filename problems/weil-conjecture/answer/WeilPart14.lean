      intro h0
      have hev : MvPolynomial.eval (fun _ => (1 : K))
          ((MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K) ^ n) = 0 := by
        rw [h0, map_zero]
      simp at hev
    obtain ⟨m, hm⟩ := MvPolynomial.support_nonempty.mpr hne
    have hcoeff : ((MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K) ^ n).coeff m ≠ 0 :=
      MvPolynomial.mem_support_iff.mp hm
    exact (hd hcoeff).symm.trans (hn hcoeff)
  have hDehomEquiv : ∀ (K : Type u) [Field K] (a : Fin (N + 1))
      (x : MvPolynomial (Fin (N + 1)) K) (_ : x = MvPolynomial.X a),
      let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K
      let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
      ∃ e : MvPolynomial {b : Fin (N + 1) // b ≠ a} K ≃+* HomogeneousLocalization.Away 𝒜 x,
        (∀ c : K, (e (MvPolynomial.C c)).val = Localization.mk (MvPolynomial.C c) 1) ∧
