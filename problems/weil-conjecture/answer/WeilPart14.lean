        (φ₁ : CommRingCat.of B₀ ⟶ R₁) (_ : Etale (Spec.map φ₁))
        (w₁ : Spec R₁),
        let ψ_loc : MvPolynomial (Fin (m₀ + 1)) k₀ →+* R₁ := φ₁.hom.comp ψ''
        (∀ p : Spec R₁,
          (∀ j ∈ I_nc, φ₁.hom (f (ψ (MvPolynomial.X j))) ∈ p.asIdeal) ↔
            ψ_loc (MvPolynomial.X j_piv) ∈ p.asIdeal) ∧
        closure {p : Spec R₁ |
            ψ_loc (MvPolynomial.X j_piv) ∉ p.asIdeal ∧
            ∃ j ∈ I_nc.erase j_piv, ψ_loc (MvPolynomial.X j) ∈ p.asIdeal} =
          {p : Spec R₁ |
            ∃ j ∈ I_nc.erase j_piv, ψ_loc (MvPolynomial.X j) ∈ p.asIdeal} ∧
