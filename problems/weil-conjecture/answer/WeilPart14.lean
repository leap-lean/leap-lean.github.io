      haveI : Algebra.Etale Q B := hEt_ψ
      haveI : Module.Flat Q B := Algebra.Smooth.flat Q B
      haveI : Algebra.HasGoingDown Q B := Algebra.HasGoingDown.of_flat
      haveI : (P_v.comap ψ).IsPrime := P_v.comap_isPrime ψ
      haveI : P_v.LiesOver (P_v.comap ψ) := ⟨rfl⟩
