    | succ b ih =>
      intro hb S' Z_total hIntS' hProjS' hSmS' hPair
      obtain ⟨q, H, ιH, Z_nc, s, C_comp, ιC, hZ_eq, hCenter⟩ :=
        weil_etale_nc_max_multiplicity_stratum k m b hb S' Z_total hIntS' hProjS' hSmS' hPair
      obtain ⟨S'', Z''_total, π_step, hIntS'', hProjS'', hSmS'', hπ_step, hBdry_step, hPair'⟩ :=
        weil_smooth_center_blowup_etale_nc_step k m b hb S' Z_total hIntS' hProjS' hSmS'
          q H ιH Z_nc s C_comp ιC hZ_eq hCenter
      obtain ⟨W, Z_W, π_rec, hIntW, hProjW, hSmW, hPair1, hπ_rec, hBdry_rec⟩ :=
        ih (Nat.le_of_succ_le hb) S'' Z''_total hIntS'' hProjS'' hSmS'' hPair'
      have hπ : IsGenFiniteEtaleAlterationOver k (π_rec ≫ π_step) :=
        weil_gen_finite_etale_alteration_comp k π_rec π_step hIntS'' hπ_rec hπ_step
      refine ⟨W, Z_W, π_rec ≫ π_step, hIntW, hProjW, hSmW, hPair1, hπ, ?_⟩
      intro x hx
      apply hBdry_rec
      apply hBdry_step
      simpa using hx
  obtain ⟨W, Z_W, π₄, hIntW, hProjW, hSmW, hPair1, hπ₄, hBdry₄⟩ :=
    hInd m le_rfl S Z_S hIntS hProjS hSmS hInit
  have hSncW : IsSncDivisorSupport k (m + 1) W Z_W :=
    weil_split_etale_nc_level_one_to_strict_snc k m W Z_W hIntW hProjW hSmW hPair1
  exact ⟨W, Z_W, π₄, hIntW, hProjW, hSmW, hSncW, hπ₄, hBdry₄⟩

theorem weil_snc_base_semistable_curve_toroidal_resolution (k : Type u) [Field k] [IsAlgClosed k] (m : ℕ)
    (V : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (U_V : V.left.Opens) (hUV : Nonempty U_V)
    (B : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (U_B : B.left.Opens)
    (hIntB : AlgebraicGeometry.IsIntegral B.left)
    (hProjB : IsProjectiveOverField k B)
    (hDimB : topologicalKrullDim B.left = (m : WithBot ℕ∞))
    (hUB : Nonempty U_B)
    (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (f : C ⟶ B) (n : ℕ) (τ : Fin n → (B ⟶ C))
    (hCurve : IsSemistablePointedCurveOver k f U_B n τ)
    (hIntC : AlgebraicGeometry.IsIntegral C.left)
    (hProjC : IsProjectiveOverField k C)
    (β : C ⟶ V) (hβ : IsGenFiniteEtaleAlterationOver k β)
    (hBdry : β.left.base ⁻¹' ((U_V : Set V.left)ᶜ) ⊆
      f.left.base ⁻¹' ((U_B : Set B.left)ᶜ) ∪
        ⋃ j : Fin n, Set.range (τ j).left.base)
    (B₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (Z_B₁ : Set B₁.left) (ψ : B₁ ⟶ B)
    (hIntB₁ : AlgebraicGeometry.IsIntegral B₁.left)
    (hProjB₁ : IsProjectiveOverField k B₁)
    (hSmB₁ : AlgebraicGeometry.SmoothOfRelativeDimension m B₁.hom)
    (hSncB₁ : IsSncDivisorSupport k m B₁ Z_B₁)
    (hψ : IsGenFiniteEtaleAlterationOver k ψ)
    (hψBdry : ψ.left.base ⁻¹' ((U_B : Set B.left)ᶜ) ⊆ Z_B₁) :
    ∃ (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (Z_W : Set W.left) (φ : W ⟶ V),
      AlgebraicGeometry.IsIntegral W.left ∧
      IsProjectiveOverField k W ∧
      AlgebraicGeometry.SmoothOfRelativeDimension (m + 1) W.hom ∧
      IsSncDivisorSupport k (m + 1) W Z_W ∧
      IsGenFiniteEtaleAlterationOver k φ ∧
      φ.left.base ⁻¹' ((U_V : Set V.left)ᶜ) ⊆ Z_W :=
by
  obtain ⟨U_B₁, C₁, f₁, τ₁, ψ_C, hU_B₁_eq, hU_B₁, hIntC₁, hProjC₁, hCurve₁, hψ_C, hBdry₁⟩ :=
    weil_semistable_curve_pullback_snc_base k m B U_B hProjB C f n τ hCurve hProjC
      B₁ Z_B₁ ψ hIntB₁ hProjB₁ hSncB₁ hψ hψBdry
  obtain ⟨C₂, Z₂, π₂, N, hIntC₂, hProjC₂, hπ₂, hBdry₂, hTor₂⟩ :=
    weil_semistable_curve_codim2_toroidal_blowup k m B₁ Z_B₁ U_B₁ hIntB₁ hProjB₁ hSmB₁ hSncB₁
      hU_B₁_eq hU_B₁ C₁ f₁ n τ₁ hCurve₁ hIntC₁ hProjC₁
  obtain ⟨C_reg, Z_reg, π₃, hIntCreg, hProjCreg, hSmCreg, hNcCreg, hπ₃, hBdry₃⟩ :=
    weil_toroidal_codim3_strata_desingularization k m N C₂ Z₂ hIntC₂ hProjC₂ hTor₂
  obtain ⟨W, Z_W, π₄, hIntW, hProjW, hSmW, hSncW, hπ₄, hBdry₄⟩ :=
    weil_etale_nc_to_strict_snc_blowup k m C_reg Z_reg hIntCreg hProjCreg hSmCreg hNcCreg
  let φ : W ⟶ V := π₄ ≫ π₃ ≫ π₂ ≫ ψ_C ≫ β
  have h_C_V : IsGenFiniteEtaleAlterationOver k (ψ_C ≫ β) :=
    weil_gen_finite_etale_alteration_comp k ψ_C β hIntC hψ_C hβ
  have h_C₂_V : IsGenFiniteEtaleAlterationOver k (π₂ ≫ ψ_C ≫ β) :=
    weil_gen_finite_etale_alteration_comp k π₂ (ψ_C ≫ β) hIntC₁ hπ₂ h_C_V
  have h_Creg_V : IsGenFiniteEtaleAlterationOver k (π₃ ≫ π₂ ≫ ψ_C ≫ β) :=
    weil_gen_finite_etale_alteration_comp k π₃ (π₂ ≫ ψ_C ≫ β) hIntC₂ hπ₃ h_C₂_V
  have hφ : IsGenFiniteEtaleAlterationOver k φ :=
    weil_gen_finite_etale_alteration_comp k π₄ (π₃ ≫ π₂ ≫ ψ_C ≫ β) hIntCreg hπ₄ h_Creg_V
  refine ⟨W, Z_W, φ, hIntW, hProjW, hSmW, hSncW, hφ, ?_⟩
  intro x hx
  have hx' : ψ_C.left.base (π₂.left.base (π₃.left.base (π₄.left.base x))) ∈
      β.left.base ⁻¹' ((U_V : Set V.left)ᶜ) := by
    simpa [φ] using hx
  exact hBdry₄ (hBdry₃ (hBdry₂ (hBdry₁ (hBdry hx'))))

theorem weil_comp_isGenFiniteEtaleAlterationOver (k : Type u) [Field k]
    (X_bar V₀ W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (π₀ : V₀ ⟶ X_bar) (hIntV₀ : AlgebraicGeometry.IsIntegral V₀.left)
    (hπ₀ : IsGenFiniteEtaleAlterationOver k π₀)
    (φ_V : W ⟶ V₀) (hφ_V : IsGenFiniteEtaleAlterationOver k φ_V) :
    IsGenFiniteEtaleAlterationOver k (φ_V ≫ π₀) :=
by
  obtain ⟨hProp₀, hSurj₀, U₀, hU₀, hFin₀, hEt₀, hSurjU₀⟩ := hπ₀
  obtain ⟨hProp₁, hSurj₁, U₁, hU₁, hFin₁, hEt₁, hSurjU₁⟩ := hφ_V
  have : IsProper π₀.left := hProp₀
  have : Surjective π₀.left := hSurj₀
  have : IsIntegral V₀.left := hIntV₀
  let Z₁ : Set ↥V₀.left := (U₁ : Set ↥V₀.left)ᶜ
  have hZ₁ : IsClosed Z₁ := U₁.isOpen.isClosed_compl
  let K₀ : Set ↥X_bar.left := ⇑π₀.left '' Z₁
  have hK₀ : IsClosed K₀ := (Scheme.Hom.isClosedMap π₀.left) Z₁ hZ₁
  let U_bar : X_bar.left.Opens := U₀ ⊓ ⟨K₀ᶜ, hK₀.isOpen_compl⟩
  have hU_bar_le : U_bar ≤ U₀ := inf_le_left
  have hPre_le : π₀.left ⁻¹ᵁ U_bar ≤ U₁ := by
    intro v hv
    have hv' : π₀.left v ∈ U_bar := (Scheme.Hom.mem_preimage π₀.left).mp hv
    change π₀.left v ∈ (U₀ : Set ↥X_bar.left) ∧ π₀.left v ∈ K₀ᶜ at hv'
    by_contra hvU₁
    exact hv'.2 ⟨v, hvU₁, rfl⟩
  have : IrreducibleSpace ↥V₀.left :=
    @AlgebraicGeometry.irreducibleSpace_of_isIntegral V₀.left hIntV₀
  let η : ↥V₀.left := genericPoint ↥V₀.left
  have hη : IsGenericPoint η Set.univ := genericPoint_spec ↥V₀.left
  obtain ⟨⟨u₁, hu₁⟩⟩ := hU₁
  have hηU₁ : η ∈ U₁ := (hη.mem_open_set_iff U₁.isOpen).mpr ⟨u₁, trivial, hu₁⟩
  let V₁ : V₀.left.Opens := π₀.left ⁻¹ᵁ U₀
  obtain ⟨⟨x₀, hx₀⟩⟩ := hU₀
  obtain ⟨v₀, hv₀⟩ := (Scheme.Hom.surjective π₀.left) x₀
  have hv₀V₁ : v₀ ∈ V₁ := (Scheme.Hom.mem_preimage π₀.left).mpr (hv₀.symm ▸ hx₀)
  have hηV₁ : η ∈ V₁ := (hη.mem_open_set_iff V₁.isOpen).mpr ⟨v₀, trivial, hv₀V₁⟩
  have hπ₀η : π₀.left η ∈ U₀ := (Scheme.Hom.mem_preimage π₀.left).mp hηV₁
  have hFibUnique : ∀ z : ↥V₀.left, π₀.left z = π₀.left η → z = η := by
    intro z hz
    have hzV₁ : z ∈ V₁ := (Scheme.Hom.mem_preimage π₀.left).mpr (hz.symm ▸ hπ₀η)
    let g : (V₁ : Scheme.{u}) ⟶ (U₀ : Scheme.{u}) := π₀.left ∣_ U₀
    have : IsFinite g := hFin₀
    let η_V : ↥(V₁ : Scheme.{u}) := ⟨η, hηV₁⟩
    let z_V : ↥(V₁ : Scheme.{u}) := ⟨z, hzV₁⟩
    have hgz : g z_V = g η_V := by
      apply Subtype.ext
      calc (g z_V).1
        _ = π₀.left z := morphismRestrict_base_coe π₀.left U₀ z_V
        _ = π₀.left η := hz
        _ = (g η_V).1 := (morphismRestrict_base_coe π₀.left U₀ η_V).symm
    let y_U : ↥(U₀ : Scheme.{u}) := g η_V
    let F := ↑(⇑g ⁻¹' {y_U})
    have : DiscreteTopology F := (Scheme.Hom.fiberHomeo g y_U).discreteTopology
    let p₀ : F := ⟨η_V, rfl⟩
    let p₁ : F := ⟨z_V, hgz⟩
    obtain ⟨C, hC_closed, hC_pre⟩ :=
      isClosed_induced_iff.mp (isClosed_discrete ({p₀} : Set F))
    have hη_C : η_V ∈ C := by
      have hp₀ : p₀ ∈ (Subtype.val : F → ↥(V₁ : Scheme.{u})) ⁻¹' C := by
        rw [hC_pre]
        exact Set.mem_singleton p₀
      exact hp₀
    have hz_C : z_V ∈ C := by
      by_contra hz_not_C
      let U' : Set ↥(V₁ : Scheme.{u}) := Cᶜ
      have hU'_open : IsOpen U' := hC_closed.isOpen_compl
      have hImgOpen : IsOpen (⇑V₁.ι '' U') :=
        (Scheme.Hom.isOpenEmbedding V₁.ι).isOpenMap U' hU'_open
      have hηImg : η ∈ ⇑V₁.ι '' U' :=
        (hη.mem_open_set_iff hImgOpen).mpr ⟨V₁.ι z_V, trivial, ⟨z_V, hz_not_C, rfl⟩⟩
      obtain ⟨w_V, hw_U', hw_eq⟩ := hηImg
      have hw_η : w_V = η_V := by
        apply Subtype.ext
        have hι : V₁.ι w_V = w_V.1 := Scheme.Opens.ι_apply V₁ w_V
        exact hι.symm.trans hw_eq
      exact hw_U' (hw_η ▸ hη_C)
    have hp₁ : p₁ ∈ ({p₀} : Set F) := by
      rw [← hC_pre]
      exact hz_C
    have hp₁_eq : p₁ = p₀ := Set.mem_singleton_iff.mp hp₁
    exact congrArg (fun p : F => p.1.1) hp₁_eq
  have h_not_K₀ : π₀.left η ∉ K₀ := by
    rintro ⟨z, hzZ₁, hz_eq⟩
    have hzeq : z = η := hFibUnique z hz_eq
    exact hzZ₁ (hzeq ▸ hηU₁)
  have hU_bar : Nonempty U_bar := ⟨⟨π₀.left η, ⟨hπ₀η, h_not_K₀⟩⟩⟩
  have hPull : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) {U' U : Y.Opens} (h : U' ≤ U),
      ∃ g' : (f ⁻¹ᵁ U' : Scheme.{u}) ⟶ (f ⁻¹ᵁ U : Scheme.{u}),
        IsPullback g' (f ∣_ U') (f ∣_ U) (Y.homOfLE h) := by
    intro X Y f U' U h
    have hs : IsPullback (f ⁻¹ᵁ U').ι (f ∣_ U') f (Y.homOfLE h ≫ U.ι) := by
      rw [Y.homOfLE_ι h]
      exact (isPullback_morphismRestrict f U').flip
    have ht : IsPullback (f ⁻¹ᵁ U).ι (f ∣_ U) f U.ι :=
      (isPullback_morphismRestrict f U).flip
    exact ⟨_, IsPullback.of_right' hs ht⟩
  obtain ⟨g₀, hp₀⟩ := hPull π₀.left hU_bar_le
  have hFin_π : IsFinite (π₀.left ∣_ U_bar) :=
    MorphismProperty.of_isPullback (P := @IsFinite) hp₀ hFin₀
  have hEt_π : Etale (π₀.left ∣_ U_bar) :=
    MorphismProperty.of_isPullback (P := @Etale) hp₀ hEt₀
  have hSurj_π : Surjective (π₀.left ∣_ U_bar) :=
    MorphismProperty.of_isPullback (P := @Surjective) hp₀ hSurjU₀
  obtain ⟨g₁, hp₁⟩ := hPull φ_V.left hPre_le
  have hFin_φ : IsFinite (φ_V.left ∣_ (π₀.left ⁻¹ᵁ U_bar)) :=
    MorphismProperty.of_isPullback (P := @IsFinite) hp₁ hFin₁
  have hEt_φ : Etale (φ_V.left ∣_ (π₀.left ⁻¹ᵁ U_bar)) :=
    MorphismProperty.of_isPullback (P := @Etale) hp₁ hEt₁
  have hSurj_φ : Surjective (φ_V.left ∣_ (π₀.left ⁻¹ᵁ U_bar)) :=
    MorphismProperty.of_isPullback (P := @Surjective) hp₁ hSurjU₁
  have hCompProp : ∀ {A B C : Scheme.{u}} (f : A ⟶ B) (g : B ⟶ C)
      [IsProper f] [IsProper g], IsProper (f ≫ g) := fun _ _ => inferInstance
  have hCompSurj : ∀ {A B C : Scheme.{u}} (f : A ⟶ B) (g : B ⟶ C)
      [Surjective f] [Surjective g], Surjective (f ≫ g) := fun _ _ => inferInstance
  have hCompFin : ∀ {A B C : Scheme.{u}} (f : A ⟶ B) (g : B ⟶ C)
      [IsFinite f] [IsFinite g], IsFinite (f ≫ g) := fun _ _ => inferInstance
  have hCompEt : ∀ {A B C : Scheme.{u}} (f : A ⟶ B) (g : B ⟶ C)
      [Etale f] [Etale g], Etale (f ≫ g) := fun _ _ => inferInstance
  refine ⟨?_, ?_, U_bar, hU_bar, ?_, ?_, ?_⟩
  · exact @hCompProp _ _ _ φ_V.left π₀.left hProp₁ hProp₀
  · exact @hCompSurj _ _ _ φ_V.left π₀.left hSurj₁ hSurj₀
  · change IsFinite ((φ_V.left ≫ π₀.left) ∣_ U_bar)
    rw [morphismRestrict_comp]
    exact @hCompFin _ _ _ _ _ hFin_φ hFin_π
  · change Etale ((φ_V.left ≫ π₀.left) ∣_ U_bar)
    rw [morphismRestrict_comp]
    exact @hCompEt _ _ _ _ _ hEt_φ hEt_π
  · change Surjective ((φ_V.left ≫ π₀.left) ∣_ U_bar)
    rw [morphismRestrict_comp]
    exact @hCompSurj _ _ _ _ _ hSurj_φ hSurj_π

theorem weil_spread_out_projective_scheme_over_algClosure (F : Type u) [Field F]
    (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F))))
    (hProjW : IsProjectiveOverField (AlgebraicClosure F) W) :
    ∃ (L_W : IntermediateField F (AlgebraicClosure F)) (_ : FiniteDimensional F ↥L_W)
      (Y_W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of ↥L_W)))
      (p_W : W.left ⟶ Y_W.left),
      IsProjectiveOverField ↥L_W Y_W ∧
      CategoryTheory.IsPullback p_W W.hom Y_W.hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥L_W (AlgebraicClosure F)))) :=
by
  obtain ⟨N, ι_W, hClosedW⟩ := hProjW
  
  have hAppTopEq : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Y)
      (htop : (⊤ : X.Opens) ≤ f ⁻¹ᵁ ⊤),
      f.appLE ⊤ ⊤ htop = f.appTop := by
    intro X Y f htop
    change f.appLE ⊤ ⊤ htop = f.app ⊤
    rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE]
    rfl
  have hCongrAppLE : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (f₁ f₂ : X ⟶ Y) (_ : f₁ = f₂)
      (U : Y.Opens) (V : X.Opens) (h₁ : V ≤ f₁ ⁻¹ᵁ U) (h₂ : V ≤ f₂ ⁻¹ᵁ U),
      f₁.appLE U V h₁ = f₂.appLE U V h₂ := by
    intro X Y f₁ f₂ hf U V h₁ h₂
    subst hf
    rfl
  have hIsoTransHom : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (U : Y.Opens)
      (e : (↑U : AlgebraicGeometry.Scheme.{u}) ≅ X)
      {R : CommRingCat.{u}} (g : AlgebraicGeometry.Scheme.Γ.obj (Opposite.op X) ≅ R),
      U.topIso.inv ≫ (e.inv.appTop ≫ g.hom) =
        (U.topIso.symm ≪≫ AlgebraicGeometry.Scheme.Γ.mapIso e.symm.op ≪≫ g).hom := by
    intro X Y U e R g
    rfl
  have hEquivApply : ∀ {R S : CommRingCat.{u}} (e : R ≅ S) (x : ↑R),
      (CategoryTheory.Iso.commRingCatIsoToRingEquiv e) x = e.hom.hom x := by
    intro R S e x
    rfl
  have hOfHomApply : ∀ {R S : Type u} [CommRing R] [CommRing S] (f : R →+* S) (z : R),
      (CommRingCat.ofHom f).hom z = f z := by
    intro R S _ _ f z
    rfl
  
  have hClosedDescent : ∀ {W_left P₁ P₀ S₁ S₀ : AlgebraicGeometry.Scheme.{u}}
      (ι_W : W_left ⟶ P₁) [AlgebraicGeometry.IsClosedImmersion ι_W]
      (π : P₁ ⟶ P₀) [AlgebraicGeometry.IsAffineHom π]
      (p₁_hom : P₁ ⟶ S₁) (p₀_hom : P₀ ⟶ S₀) (s : S₁ ⟶ S₀)
      (_ : CategoryTheory.IsPullback π p₁_hom p₀_hom s)
      {ι : Type} (U₀ : ι → ↑P₀.affineOpens) (U₁ : ι → ↑P₁.affineOpens)
      (_ : ⨆ i : ι, (U₁ i : P₁.Opens) = ⊤)
      (hPre : ∀ i : ι, (TopologicalSpace.Opens.map π.base).obj (U₀ i : P₀.Opens) = (U₁ i : P₁.Opens))
      (_ : ∀ i : ι,
        ∃ G : Set ↑(P₁.presheaf.obj (Opposite.op (U₁ i : P₁.Opens))),
          Ideal.span G = (AlgebraicGeometry.Scheme.Hom.ker ι_W).ideal (U₁ i) ∧
          G ⊆ Set.range (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appLE π
            (U₀ i : P₀.Opens) (U₁ i : P₁.Opens) (hPre i).ge))),
      ∃ (Y₀_left : AlgebraicGeometry.Scheme.{u}) (ι₀ : Y₀_left ⟶ P₀)
        (_ : AlgebraicGeometry.IsClosedImmersion ι₀) (p_W : W_left ⟶ Y₀_left),
        CategoryTheory.IsPullback p_W (ι_W ≫ p₁_hom) (ι₀ ≫ p₀_hom) s := by
    intro W_left P₁ P₀ S₁ S₀ ι_W _ π _ p₁_hom p₀_hom s hPB ι U₀ U₁ hCov₁ hPre hLift
    have hKerTransport : ∀ {Z₁ Z₀ : AlgebraicGeometry.Scheme.{u}}
        (μ : Z₁ ⟶ Z₀) (ι₀ : Z₀ ⟶ P₀) (ι₁ : Z₁ ⟶ P₁)
        (_ : μ ≫ ι₀ = ι₁ ≫ π)
        (V₀ : P₀.Opens) (V₁ : P₁.Opens) (hV : V₁ ≤ π ⁻¹ᵁ V₀)
        (s₀ : ↑(P₀.presheaf.obj (Opposite.op V₀)))
        (g_sec : ↑(P₁.presheaf.obj (Opposite.op V₁))),
        (ι₀.app V₀).hom s₀ = 0 →
        (π.appLE V₀ V₁ hV).hom s₀ = g_sec →
        (ι₁.app V₁).hom g_sec = 0 := by
      intro Z₁ Z₀ μ ι₀ ι₁ hcomm V₀ V₁ hV s₀ g_sec hs₀_zero hs₀_map
      have hSub₂ : ι₁ ⁻¹ᵁ V₁ ≤ (ι₁ ≫ π) ⁻¹ᵁ V₀ :=
        (TopologicalSpace.Opens.map ι₁.base).monotone hV
      have hSub₁ : ι₁ ⁻¹ᵁ V₁ ≤ (μ ≫ ι₀) ⁻¹ᵁ V₀ := by
        rwa [hcomm]
      have hSub₁' : ι₁ ⁻¹ᵁ V₁ ≤ μ ⁻¹ᵁ (ι₀ ⁻¹ᵁ V₀) := hSub₁
      have happ_eq : ((μ ≫ ι₀).appLE V₀ (ι₁ ⁻¹ᵁ V₁) hSub₁).hom s₀ =
          ((ι₁ ≫ π).appLE V₀ (ι₁ ⁻¹ᵁ V₁) hSub₂).hom s₀ :=
