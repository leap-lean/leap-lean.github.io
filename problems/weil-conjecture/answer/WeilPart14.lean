          rw [h1]
          change f₁.left.base (e_S₂.base z₀) = e_A₂.base w₀
          rw [hz₀]
          change (e_A₂ ≫ τ ≫ f₁.left).base w₀ = e_A₂.base w₀
          rw [hτ, Category.comp_id]
        have hz₀_range : z₀ ∈ Set.range (PrimeSpectrum.comap loc_S₂) := by
          rw [PrimeSpectrum.localization_away_comap_range S₃_ring (φ₂ r₂)]
          change φ₂ r₂ ∉ z₀.asIdeal
          change r₂ ∉ w_z₀.asIdeal
          rw [hz₀_comap]
          exact hw₀_basic
        rcases hz₀_range with ⟨z₃_raw, hz₃⟩
        let z₃ : Spec S₃ := z₃_raw
        refine ⟨z₃, ?_⟩
        change e_S₂.base ((Spec.map (CommRingCat.ofHom loc_S₂)).base z₃) =
          τ.base (e_A₂.base ((Spec.map (CommRingCat.ofHom loc_A₂)).base w))
        rw [Spec.map_apply, Spec.map_apply]
        exact (congrArg e_S₂.base hz₃).trans hz₀
      let lift_τ : Spec A₃ ⟶ Spec S₃ := IsOpenImmersion.lift e_S₃ (e_A₃ ≫ τ) he_A₃_τ_range
      let σ : S₃_ring →+* A₃_ring := (Spec.preimage lift_τ).hom
      have hσ_fac : Spec.map (CommRingCat.ofHom σ) ≫ e_S₃ = e_A₃ ≫ τ := by
        have hSpec_σ : Spec.map (CommRingCat.ofHom σ) = lift_τ :=
          Spec.map_preimage lift_τ
        rw [hSpec_σ]
        exact IsOpenImmersion.lift_fac e_S₃ (e_A₃ ≫ τ) he_A₃_τ_range
      have he_S₃_f : e_S₃ ≫ f₁.left = Spec.map (CommRingCat.ofHom φ₃) ≫ e_A₃ := by
        calc
          e_S₃ ≫ f₁.left = Spec.map (CommRingCat.ofHom loc_S₂) ≫ (e_S₂ ≫ f₁.left) :=
            Category.assoc _ _ _
          _ = Spec.map (CommRingCat.ofHom loc_S₂) ≫ Spec.map (CommRingCat.ofHom φ₂) ≫ e_A₂ := by
            rw [heS₂_f₁]
          _ = Spec.map (CommRingCat.ofHom (loc_S₂.comp φ₂)) ≫ e_A₂ := by
            rw [← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
          _ = Spec.map (CommRingCat.ofHom (φ₃.comp loc_A₂)) ≫ e_A₂ := by rw [hφ₃_comp]
          _ = Spec.map (CommRingCat.ofHom φ₃) ≫ e_A₃ := by
            rw [CommRingCat.ofHom_comp, Spec.map_comp, Category.assoc]
