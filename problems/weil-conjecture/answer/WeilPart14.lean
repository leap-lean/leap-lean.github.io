          _ = L₂ (algebraMap _ _ P) * u_inv := by rw [IsLocalization.mk'_spec']
          _ = G P * u_inv := by rw [IsLocalization.Away.lift_eq]
      have h_cocycle_L : ψ_ov.comp awayL_N = τ_L.comp (φ ij) := by
        let E_L : Subring (C ν) := RingHom.eqLocus (ψ_ov.comp awayL_N) (τ_L.comp (φ ij))
        suffices hE : (⊤ : Subring (C ν)) ≤ E_L by
          ext x; exact hE (Subring.mem_top x)
        rw [← ((hHomLoc N).2 ν).2, Subring.closure_le]
        rintro _ (⟨c, rfl⟩ | ⟨μ, rfl⟩)
        · change ψ_ov (awayL_N (algebraMap k (C ν) c)) = τ_L (φ ij (algebraMap k (C ν) c))
          have h_aw : awayL_N (algebraMap k (C ν) c) = algebraMap k C₂ c :=
            HomogeneousLocalization.awayMap_fromZeroRingHom 𝒜_N (hX_N ν') rfl (algebraMap k _ c)
          rw [h_aw, hφ_alg ij c]
          have h_τc : τ_L (algebraMap k (TensorProduct k (A i) (B j)) c) =
