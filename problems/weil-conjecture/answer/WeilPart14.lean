    have hC_eq : ψ_et.comp MvPolynomial.C = φ.comp (θ.comp MvPolynomial.C) := by
      have hSpec_C : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_et.comp MvPolynomial.C)) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ.comp (θ.comp MvPolynomial.C))) := by
        have hL : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_et.comp MvPolynomial.C)) =
            e_B ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_et₀) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
          rfl
        have hR : AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (φ.comp (θ.comp MvPolynomial.C))) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ.comp MvPolynomial.C)) := by
          rw [← AlgebraicGeometry.Spec.map_comp]
