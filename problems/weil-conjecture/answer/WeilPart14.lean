      _ = AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((θ_bar i b μ).comp
              (Algebra.TensorProduct.map L₀.val (AlgHom.id F (R b))).toRingHom)) ≫ j₀ b := by
          rw [hlam_θ i b μ]
      _ = m_bar i b μ ≫
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (Algebra.TensorProduct.map L₀.val (AlgHom.id F (R b))).toRingHom) ≫
              j₀ b) := by
          rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp,
            CategoryTheory.Category.assoc, hm_bar_eq i b μ]
      _ = (m_bar i b μ ≫ j_k b) ≫ p_X := by
          rw [← hj_comm b, CategoryTheory.Category.assoc]
      _ = (ℓ_bar i b μ ≫ α_k i) ≫ φ_bar.left ≫ p_X := by
          rw [AlgebraicGeometry.IsOpenImmersion.lift_fac]
          simp [CategoryTheory.Category.assoc]
  obtain ⟨φ₀, hComm₀⟩ :=
    s5_glue_over_morphism_of_field_pullback ↥L₀ k Y₀ X₀ W.left X_bar.left W.hom φ_bar.left
      p_W₀ p_X hpW₀ S S_bar u u_bar q_loc φ_loc hCov hq_comm hq_range hφ_over hφ_comm
  exact ⟨φ₀, p_W₀, hpW₀, hComm₀⟩

theorem weil_spread_out_projective_alteration_model (F : Type u) [Field F]
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    [AlgebraicGeometry.IsProper X.hom]
    (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F))))
    (hProjW : IsProjectiveOverField (AlgebraicClosure F) W)
    (φ_bar : W ⟶ weilBaseChangeOver F (AlgebraicClosure F) X)
    (U_bar : (weilBaseChangeOver F (AlgebraicClosure F) X).left.Opens) :
    ∃ (L₀ : IntermediateField F (AlgebraicClosure F)) (_ : FiniteDimensional F ↥L₀)
      (Y₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of ↥L₀)))
      (φ₀ : Y₀ ⟶ weilBaseChangeOver F ↥L₀ X)
      (U₀ : (weilBaseChangeOver F ↥L₀ X).left.Opens),
      IsProjectiveOverField ↥L₀ Y₀ ∧
      IsBaseChangeAlterationModel F X W φ_bar U_bar L₀ Y₀ φ₀ U₀ :=
by
  obtain ⟨L_W, hFD_W, Y_W, p_W, hProj_W, hp_W⟩ :=
    weil_spread_out_projective_scheme_over_algClosure F W hProjW
  obtain ⟨L_U, hFD_U, U_L, hU_L⟩ :=
    weil_spread_out_open_of_baseChange F X U_bar
  have : FiniteDimensional F ↥L_W := hFD_W
  have : FiniteDimensional F ↥L_U := hFD_U
  let L₁ : IntermediateField F (AlgebraicClosure F) := L_W ⊔ L_U
  have hFD₁ : FiniteDimensional F ↥L₁ := inferInstance
  let : Algebra ↥L_W ↥L₁ := (IntermediateField.inclusion (le_sup_left : L_W ≤ L₁)).toRingHom.toAlgebra
  have : IsScalarTower ↥L_W ↥L₁ (AlgebraicClosure F) :=
    IsScalarTower.of_algebraMap_eq' (RingHom.ext fun _ => rfl)
  let Y₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of ↥L₁)) :=
    weilBaseChangeOver ↥L_W ↥L₁ Y_W
  have hProj₁ : IsProjectiveOverField ↥L₁ Y₁ :=
    weil_isProjectiveOverField_baseChange ↥L_W ↥L₁ Y_W hProj_W
  let s_LW_k := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥L_W (AlgebraicClosure F)))
  let s_L1_k := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥L₁ (AlgebraicClosure F)))
  have hs_W1 : s_L1_k ≫
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥L_W ↥L₁)) = s_LW_k := by
    dsimp [s_LW_k, s_L1_k]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
      ← IsScalarTower.algebraMap_eq ↥L_W ↥L₁ (AlgebraicClosure F)]
  have h_comm_W1 : p_W ≫ Y_W.hom = (W.hom ≫ s_L1_k) ≫
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥L_W ↥L₁)) := by
    rw [CategoryTheory.Category.assoc, hs_W1]
    exact hp_W.w
  let p_W₁ : W.left ⟶ Y₁.left :=
    CategoryTheory.Limits.pullback.lift p_W (W.hom ≫ s_L1_k) h_comm_W1
  have hpW₁ : CategoryTheory.IsPullback p_W₁ W.hom Y₁.hom s_L1_k := by
    dsimp [p_W₁, Y₁, weilBaseChangeOver]
    have hOuter : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.lift p_W (W.hom ≫ s_L1_k) h_comm_W1 ≫
          CategoryTheory.Limits.pullback.fst Y_W.hom
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥L_W ↥L₁))))
        W.hom Y_W.hom
        (s_L1_k ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥L_W ↥L₁))) := by
      rw [CategoryTheory.Limits.pullback.lift_fst, hs_W1]
      exact hp_W
    exact CategoryTheory.IsPullback.of_right hOuter
      (CategoryTheory.Limits.pullback.lift_snd _ _ _)
      (CategoryTheory.IsPullback.of_hasPullback Y_W.hom _)
  obtain ⟨L₀, hLE, hFD₀, hMor⟩ :=
    weil_spread_out_morphism_of_baseChange_model F X W φ_bar L₁ Y₁ hProj₁ p_W₁ hpW₁
  let : Algebra ↥L₁ ↥L₀ := (IntermediateField.inclusion hLE).toRingHom.toAlgebra
  obtain ⟨φ₀, p_W₀, hpW₀, hComm₀⟩ := hMor
  let Y₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of ↥L₀)) :=
    weilBaseChangeOver ↥L₁ ↥L₀ Y₁
  have hProj₀ : IsProjectiveOverField ↥L₀ Y₀ :=
    weil_isProjectiveOverField_baseChange ↥L₁ ↥L₀ Y₁ hProj₁
  have hLE_U : L_U ≤ L₀ := le_trans le_sup_right hLE
  let : Algebra ↥L_U ↥L₀ := (IntermediateField.inclusion hLE_U).toRingHom.toAlgebra
  have : IsScalarTower F ↥L_U ↥L₀ :=
    IsScalarTower.of_algebraMap_eq' (RingHom.ext fun _ => Subtype.ext rfl)
  have : IsScalarTower ↥L_U ↥L₀ (AlgebraicClosure F) :=
    IsScalarTower.of_algebraMap_eq' (RingHom.ext fun _ => rfl)
  let q_U : (weilBaseChangeOver F ↥L₀ X).left ⟶ (weilBaseChangeOver F ↥L_U X).left :=
    weilBaseChangeMap F ↥L_U ↥L₀ X
  let U₀ : (weilBaseChangeOver F ↥L₀ X).left.Opens :=
    (TopologicalSpace.Opens.map q_U.base).obj U_L
  let p_X : (weilBaseChangeOver F (AlgebraicClosure F) X).left ⟶
      (weilBaseChangeOver F ↥L₀ X).left :=
    weilBaseChangeMap F ↥L₀ (AlgebraicClosure F) X
  let s_L0_k := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥L₀ (AlgebraicClosure F)))
  have hs_X0 : s_L0_k ≫
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F ↥L₀)) =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))) := by
    dsimp [s_L0_k]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
      ← IsScalarTower.algebraMap_eq F ↥L₀ (AlgebraicClosure F)]
  have hpX₀ : CategoryTheory.IsPullback p_X
      (weilBaseChangeOver F (AlgebraicClosure F) X).hom
      (weilBaseChangeOver F ↥L₀ X).hom s_L0_k := by
    dsimp [p_X, weilBaseChangeMap, weilBaseChangeOver]
    have hOuterX : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.lift
          (CategoryTheory.Limits.pullback.fst X.hom
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
          (CategoryTheory.Limits.pullback.snd X.hom
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) ≫
            s_L0_k)
          (by rw [CategoryTheory.Category.assoc, hs_X0]; exact CategoryTheory.Limits.pullback.condition) ≫
          CategoryTheory.Limits.pullback.fst X.hom
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F ↥L₀))))
        (CategoryTheory.Limits.pullback.snd X.hom
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
        X.hom
        (s_L0_k ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F ↥L₀))) := by
      rw [CategoryTheory.Limits.pullback.lift_fst, hs_X0]
      exact CategoryTheory.IsPullback.of_hasPullback X.hom _
    exact CategoryTheory.IsPullback.of_right hOuterX
      (CategoryTheory.Limits.pullback.lift_snd _ _ _)
      (CategoryTheory.IsPullback.of_hasPullback X.hom _)
  have hComp : p_X ≫ q_U = weilBaseChangeMap F ↥L_U (AlgebraicClosure F) X := by
    dsimp [p_X, q_U, weilBaseChangeMap, weilBaseChangeOver]
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
        CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Limits.pullback.lift_fst]
    · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
        CategoryTheory.Limits.pullback.lift_snd,
        ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
        CategoryTheory.Category.assoc,
        ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
        ← IsScalarTower.algebraMap_eq ↥L_U ↥L₀ (AlgebraicClosure F)]
  have hOpen₀ : (TopologicalSpace.Opens.map p_X.base).obj U₀ = U_bar := by
    change (TopologicalSpace.Opens.map (p_X ≫ q_U).base).obj U_L = U_bar
    rw [hComp, hU_L]
  exact ⟨L₀, hFD₀, Y₀, φ₀, U₀, hProj₀, ⟨p_W₀, p_X, hpW₀, hpX₀, hComm₀, hOpen₀⟩⟩

