      rw [← AlgebraicGeometry.Spec.map_preimage ψ_res]
      infer_instance
    let φ₁ := f₀.left.residueFieldMap c_pt
    have hFactor : AlgebraicGeometry.Spec.map φ₁ ≫
        (B₀.left.fromSpecResidueField (f₀.left.base c_pt) ≫ B₀.hom) = ψ_res := by
      rw [← CategoryTheory.Category.assoc,
        AlgebraicGeometry.Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField,
        CategoryTheory.Category.assoc, CategoryTheory.Over.w f₀]
    have hSplit : AlgebraicGeometry.Spec.map φ₁ ≫
        ((B₀.left.fromSpecResidueField (f₀.left.base c_pt) ≫ B₀.hom) ≫ CategoryTheory.inv ψ_res) =
        𝟙 _ := by
      rw [← CategoryTheory.Category.assoc, hFactor, CategoryTheory.IsIso.hom_inv_id]
    have hSurj_φ₁ : Function.Surjective φ₁.hom := by
      intro y
      let ρ := AlgebraicGeometry.Spec.preimage
        ((B₀.left.fromSpecResidueField (f₀.left.base c_pt) ≫ B₀.hom) ≫ CategoryTheory.inv ψ_res)
      have hρ : ρ ≫ φ₁ = 𝟙 _ := by
        apply AlgebraicGeometry.Spec.map_injective
        rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
          AlgebraicGeometry.Spec.map_id]
        exact hSplit
      exact ⟨ρ.hom y, congrArg (fun g => g.hom y) hρ⟩
    haveI : CategoryTheory.IsIso φ₁ :=
      (ConcreteCategory.isIso_iff_bijective φ₁).mpr ⟨φ₁.hom.injective, hSurj_φ₁⟩
    let ι_TB := CategoryTheory.Limits.pullback.lift p₁.left p₂.left hcomm
    apply hClImm.isClosedEmbedding.injective
    let q₀ := ι_TB.base w₀
    let q₁ := ι_TB.base w₁
    have hq₀_fst : (CategoryTheory.Limits.pullback.fst f₀.left f_X.left).base q₀ = c_pt := by
      change (ι_TB ≫ CategoryTheory.Limits.pullback.fst f₀.left f_X.left).base w₀ = c_pt
      rw [CategoryTheory.Limits.pullback.lift_fst]
      exact hc₀
    have hq₁_fst : (CategoryTheory.Limits.pullback.fst f₀.left f_X.left).base q₁ = c_pt := by
      change (ι_TB ≫ CategoryTheory.Limits.pullback.fst f₀.left f_X.left).base w₁ = c_pt
      rw [CategoryTheory.Limits.pullback.lift_fst]
      exact hc₁
    have hq₀_snd : (CategoryTheory.Limits.pullback.snd f₀.left f_X.left).base q₀ = x_pt := by
      change (ι_TB ≫ CategoryTheory.Limits.pullback.snd f₀.left f_X.left).base w₀ = x_pt
      rw [CategoryTheory.Limits.pullback.lift_snd]
      exact hx₀
    have hq₁_snd : (CategoryTheory.Limits.pullback.snd f₀.left f_X.left).base q₁ = x_pt := by
      change (ι_TB ≫ CategoryTheory.Limits.pullback.snd f₀.left f_X.left).base w₁ = x_pt
      rw [CategoryTheory.Limits.pullback.lift_snd]
      exact hx₁
    let e := AlgebraicGeometry.Scheme.Pullback.carrierEquiv (f := f₀.left) (g := f_X.left)
    apply e.injective
    rcases h0 : e q₀ with ⟨T_a, z_a⟩
    rcases h1 : e q₁ with ⟨T_b, z_b⟩
    have hq₀_symm : e.symm ⟨T_a, z_a⟩ = q₀ := by rw [← h0, Equiv.symm_apply_apply]
    have hq₁_symm : e.symm ⟨T_b, z_b⟩ = q₁ := by rw [← h1, Equiv.symm_apply_apply]
    have hTa_x : T_a.x = c_pt := by
      have := AlgebraicGeometry.Scheme.Pullback.carrierEquiv_symm_fst T_a z_a
      rw [hq₀_symm] at this
      exact this.symm.trans hq₀_fst
    have hTb_x : T_b.x = c_pt := by
      have := AlgebraicGeometry.Scheme.Pullback.carrierEquiv_symm_fst T_b z_b
      rw [hq₁_symm] at this
      exact this.symm.trans hq₁_fst
    have hTa_y : T_a.y = x_pt := by
      have := AlgebraicGeometry.Scheme.Pullback.carrierEquiv_symm_snd T_a z_a
      rw [hq₀_symm] at this
      exact this.symm.trans hq₀_snd
    have hTb_y : T_b.y = x_pt := by
      have := AlgebraicGeometry.Scheme.Pullback.carrierEquiv_symm_snd T_b z_b
      rw [hq₁_symm] at this
      exact this.symm.trans hq₁_snd
    have hT_eq : T_a = T_b := by
      rcases T_a with ⟨tx₀, ty₀, ts₀, htx₀, hty₀⟩
      rcases T_b with ⟨tx₁, ty₁, ts₁, htx₁, hty₁⟩
      dsimp at hTa_x hTb_x hTa_y hTb_y
      subst hTa_x hTb_x hTa_y hTb_y
      have hts : ts₀ = ts₁ := htx₀.symm.trans htx₁
      subst hts
      rfl
    subst hT_eq
    congr 1
    have hPb := T_a.isPullback_SpecMap_tensor
    haveI : CategoryTheory.IsIso (f₀.left.residueFieldMap T_a.x) := by
      subst hTa_x
      exact ‹CategoryTheory.IsIso φ₁›
    haveI : CategoryTheory.IsIso (AlgebraicGeometry.Spec.map
        ((B₀.left.residueFieldCongr T_a.hx).inv ≫ f₀.left.residueFieldMap T_a.x)) := inferInstance
    haveI : CategoryTheory.IsIso (AlgebraicGeometry.Spec.map T_a.tensorInr) :=
      CategoryTheory.IsPullback.isIso_snd_of_isIso hPb
    have hHomeo := AlgebraicGeometry.Scheme.homeoOfIso
      (CategoryTheory.asIso (AlgebraicGeometry.Spec.map T_a.tensorInr))
    exact hHomeo.injective (Subsingleton.elim _ _)
  
  have noether_dim_pkg : ∀ (R : Type u) [CommRing R] [IsDomain R] [Algebra k R]
      [Algebra.FiniteType k R] (K : Type u) [Field K] [Algebra k K] [Algebra R K]
      [IsScalarTower k R K] [IsFractionRing R K],
      ∃ (s : ℕ) (g : MvPolynomial (Fin s) k →ₐ[k] R),
        Function.Injective g ∧ g.IsIntegral ∧
        ((s : ℕ) : Cardinal.{u}) = Algebra.trdeg k K ∧
        ringKrullDim R ≤ ((s : ℕ) : WithBot ℕ∞) := by
    clear hPillar4 hPillar3 hPillar2 hPillar1 hProjProps sub_univ_isIrreducible
      hOneBr hTwoBr hDimC_fib hs_bar_pt hs_bar_hom s_bar hCls₀ s₀
      hConnXB hLocIsoXB hLocIsoC hCorr pr₂ pr₁ f_TB qX_B σ_B f_XB hProjC hIntC hCurve τ f
      T_B X_B C hUB hProjB hIntB ψ U_B B σ n f₂ X₂ U₂ B₂
    intro R _ _ _ _ K _ _ _ _ _
    obtain ⟨s, g, hg_inj, hg_int⟩ := exists_integral_inj_algHom_of_fg k R
    have hTrdegRK : Algebra.trdeg k R = Algebra.trdeg k K := by
      haveI : Algebra.IsAlgebraic R K := IsLocalization.isAlgebraic K (nonZeroDivisors R)
      have hAdd : Algebra.trdeg k R + Algebra.trdeg R K = Algebra.trdeg k K := trdeg_add_eq k R
      rw [trdeg_eq_zero (R := R) (A := K), add_zero] at hAdd
      exact hAdd
    have hDimP : ringKrullDim (MvPolynomial (Fin s) k) = ((s : ℕ) : WithBot ℕ∞) := by
      rw [MvPolynomial.ringKrullDim_of_isNoetherianRing,
        ringKrullDim_eq_zero_of_isField (Field.toIsField k), zero_add,
        ENat.card_eq_coe_fintype_card, Fintype.card_fin]
      rfl
    have hTrdegP : ((s : ℕ) : Cardinal.{u}) = Algebra.trdeg k K := by
      letI : Algebra (MvPolynomial (Fin s) k) R := g.toRingHom.toAlgebra
      haveI : IsScalarTower k (MvPolynomial (Fin s) k) R :=
        IsScalarTower.of_algebraMap_eq (fun c => (g.commutes c).symm)
      haveI : FaithfulSMul (MvPolynomial (Fin s) k) R :=
        (faithfulSMul_iff_algebraMap_injective (MvPolynomial (Fin s) k) R).mpr hg_inj
      haveI : Algebra.IsIntegral (MvPolynomial (Fin s) k) R := ⟨hg_int⟩
      haveI : Algebra.IsAlgebraic (MvPolynomial (Fin s) k) R := Algebra.IsIntegral.isAlgebraic
      have hAdd : Algebra.trdeg k (MvPolynomial (Fin s) k) +
          Algebra.trdeg (MvPolynomial (Fin s) k) R = Algebra.trdeg k R :=
        trdeg_add_eq k (MvPolynomial (Fin s) k)
      rw [trdeg_eq_zero (R := MvPolynomial (Fin s) k) (A := R), add_zero,
        MvPolynomial.trdeg_of_isDomain, Cardinal.mk_fintype, Fintype.card_fin,
        Cardinal.lift_natCast] at hAdd
      exact hAdd.trans hTrdegRK
    have hDimR : ringKrullDim R ≤ ((s : ℕ) : WithBot ℕ∞) := by
      letI : Algebra (MvPolynomial (Fin s) k) R := g.toRingHom.toAlgebra
      haveI : Algebra.IsIntegral (MvPolynomial (Fin s) k) R := ⟨hg_int⟩
      rw [← hDimP]
      refine iSup_le fun q => ?_
      let q' : LTSeries (PrimeSpectrum (MvPolynomial (Fin s) k)) :=
        { length := q.length
          toFun := fun i => PrimeSpectrum.comap g.toRingHom (q i)
          step := fun i => by
            have hlt : (q i.castSucc).asIdeal < (q i.succ).asIdeal := q.step i
            obtain ⟨x, hx_succ, hx_not⟩ := SetLike.exists_of_lt hlt
            exact Ideal.under_lt_under_of_integral_mem_sdiff (R := MvPolynomial (Fin s) k)
              (le_of_lt hlt) ⟨hx_succ, hx_not⟩ (hg_int x) }
      exact le_iSup (fun (l : LTSeries (PrimeSpectrum (MvPolynomial (Fin s) k))) =>
        (l.length : WithBot ℕ∞)) q'
    exact ⟨s, g, hg_inj, hg_int, hTrdegP, hDimR⟩
  
  have noether_max_chain : ∀ (s : ℕ) (R : Type u) [CommRing R] [IsDomain R] [Algebra k R]
      (g : MvPolynomial (Fin s) k →ₐ[k] R),
      Function.Injective g → g.IsIntegral →
      ∀ (m : Ideal R) [hm : m.IsMaximal],
      ∃ (a : Fin s → k) (L : LTSeries (PrimeSpectrum R)),
        L.length = s ∧
        L.last = ⟨m, hm.isPrime⟩ ∧
        Ideal.comap g.toRingHom m =
          Ideal.span (Set.range fun i : Fin s => MvPolynomial.X i - MvPolynomial.C (a i)) := by
    clear noether_dim_pkg hPillar4 hPillar3 hPillar2 hPillar1 hProjProps sub_univ_isIrreducible
      hOneBr hTwoBr hDimC_fib hs_bar_pt hs_bar_hom s_bar hCls₀ s₀
      hConnXB hLocIsoXB hLocIsoC hCorr pr₂ pr₁ f_TB qX_B σ_B f_XB hProjC hIntC hCurve τ f
      T_B X_B C hUB hProjB hIntB ψ U_B B σ n f₂ X₂ U₂ B₂
    intro s R _ _ _ g hg_inj hg_int m hm
    letI : Algebra (MvPolynomial (Fin s) k) R := g.toRingHom.toAlgebra
    haveI : Algebra.IsIntegral (MvPolynomial (Fin s) k) R := ⟨hg_int⟩
    haveI : FaithfulSMul (MvPolynomial (Fin s) k) R :=
      (faithfulSMul_iff_algebraMap_injective (MvPolynomial (Fin s) k) R).mpr hg_inj
    haveI : Algebra.HasGoingDown (MvPolynomial (Fin s) k) R := inferInstance
    have hmP : (Ideal.comap g.toRingHom m).IsMaximal :=
      Ideal.isMaximal_comap_of_isIntegral_of_isMaximal g.toRingHom hg_int m
    obtain ⟨a, ha⟩ := MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton.mp hmP
    let π : ℕ → (MvPolynomial (Fin s) k →ₐ[k] MvPolynomial (Fin s) k) := fun r =>
      MvPolynomial.aeval (fun i : Fin s => if i.1 < r then MvPolynomial.C (a i) else MvPolynomial.X i)
    let ψ : Fin s → (MvPolynomial (Fin s) k →ₐ[k] MvPolynomial (Fin s) k) := fun r =>
      MvPolynomial.aeval (fun i : Fin s => if i = r then MvPolynomial.C (a i) else MvPolynomial.X i)
    have hπ_X : ∀ (r : ℕ) (i : Fin s),
        π r (MvPolynomial.X i) = if i.1 < r then MvPolynomial.C (a i) else MvPolynomial.X i :=
      fun r i => MvPolynomial.aeval_X _ i
    have hψ_X : ∀ (r i : Fin s),
        ψ r (MvPolynomial.X i) = if i = r then MvPolynomial.C (a i) else MvPolynomial.X i :=
      fun r i => MvPolynomial.aeval_X _ i
    have hπ_succ : ∀ r : Fin s, (ψ r).comp (π r.1) = π (r.1 + 1) := by
      intro r
      apply MvPolynomial.algHom_ext
      intro i
      rw [AlgHom.comp_apply, hπ_X, hπ_X]
      by_cases h1 : i.1 < r.1
      · have h2 : i.1 < r.1 + 1 := Nat.lt_succ_of_lt h1
        rw [if_pos h1, if_pos h2, ← MvPolynomial.algebraMap_eq, AlgHom.commutes]
      · rw [if_neg h1, hψ_X]
        by_cases h2 : i = r
        · subst h2
          rw [if_pos rfl, if_pos (Nat.lt_succ_self i.1)]
        · have h3 : ¬(i.1 < r.1 + 1) := by
            intro hlt
            exact h2 (Fin.ext (by omega))
          rw [if_neg h2, if_neg h3]
    have hDiff_mem : ∀ (r : Fin s) (f_p : MvPolynomial (Fin s) k),
        f_p - ψ r f_p ∈
          Ideal.span ({MvPolynomial.X r - MvPolynomial.C (a r)} : Set (MvPolynomial (Fin s) k)) := by
      intro r f_p
      induction f_p using MvPolynomial.induction_on with
      | C c =>
        rw [← MvPolynomial.algebraMap_eq, AlgHom.commutes, sub_self]
        exact Submodule.zero_mem _
      | add p q hp hq =>
        have : (p + q) - ψ r (p + q) = (p - ψ r p) + (q - ψ r q) := by
          rw [map_add]; ring
        rw [this]
        exact Ideal.add_mem _ hp hq
      | mul_X p i hp =>
        rw [map_mul]
        by_cases hi : i = r
        · subst hi
          have hψX : ψ i (MvPolynomial.X i) = MvPolynomial.C (a i) := by
            rw [hψ_X, if_pos rfl]
          rw [hψX]
          have hId : p * MvPolynomial.X i - ψ i p * MvPolynomial.C (a i) =
              (p - ψ i p) * MvPolynomial.X i + ψ i p * (MvPolynomial.X i - MvPolynomial.C (a i)) := by
            ring
          rw [hId]
          exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ hp)
            (Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_singleton _)))
        · have hψX : ψ r (MvPolynomial.X i) = MvPolynomial.X i := by
            rw [hψ_X, if_neg hi]
          rw [hψX]
          have hId : p * MvPolynomial.X i - ψ r p * MvPolynomial.X i =
              (p - ψ r p) * MvPolynomial.X i := by ring
          rw [hId]
          exact Ideal.mul_mem_right _ _ hp
    have hπ0 : ∀ f_p : MvPolynomial (Fin s) k, π 0 f_p = f_p := by
      intro f_p
      have hEq : π 0 = AlgHom.id k (MvPolynomial (Fin s) k) := by
        apply MvPolynomial.algHom_ext
        intro i
        rw [hπ_X, if_neg (Nat.not_lt_zero i.1), AlgHom.id_apply]
      rw [hEq, AlgHom.id_apply]
    have hπs : ∀ f_p : MvPolynomial (Fin s) k, π s f_p = MvPolynomial.C ((MvPolynomial.aeval a) f_p) := by
      intro f_p
      have hcomp : π s = (Algebra.ofId k (MvPolynomial (Fin s) k)).comp (MvPolynomial.aeval a) := by
        apply MvPolynomial.algHom_ext
        intro i
        rw [hπ_X, if_pos i.isLt, AlgHom.comp_apply, MvPolynomial.aeval_X,
          Algebra.ofId_apply, MvPolynomial.algebraMap_eq]
      have := congrArg (fun φ : MvPolynomial (Fin s) k →ₐ[k] MvPolynomial (Fin s) k => φ f_p) hcomp
      simpa [MvPolynomial.algebraMap_eq] using this
    let I_span : Ideal (MvPolynomial (Fin s) k) :=
      Ideal.span (Set.range fun i : Fin s => MvPolynomial.X i - MvPolynomial.C (a i))
    have hTel : ∀ (r : ℕ), r ≤ s → ∀ f_p : MvPolynomial (Fin s) k, π 0 f_p - π r f_p ∈ I_span := by
      intro r hr f_p
      induction r with
      | zero => simp
      | succ r ih =>
        have hr' : r < s := Nat.lt_of_succ_le hr
        let rf : Fin s := ⟨r, hr'⟩
        have hStep : π r f_p - π (r + 1) f_p = π r f_p - ψ rf (π r f_p) := by
          have := congrArg (fun φ => φ f_p) (hπ_succ rf)
          dsimp at this
          rw [← this]
        have hSubRange : ({MvPolynomial.X rf - MvPolynomial.C (a rf)} : Set (MvPolynomial (Fin s) k)) ⊆
            Set.range (fun i : Fin s => MvPolynomial.X i - MvPolynomial.C (a i)) :=
          Set.singleton_subset_iff.mpr ⟨rf, rfl⟩
        have hMemStep : π r f_p - π (r + 1) f_p ∈ I_span := by
          rw [hStep]
          exact Ideal.span_mono hSubRange (hDiff_mem rf (π r f_p))
        have hEq : π 0 f_p - π (r + 1) f_p = (π 0 f_p - π r f_p) + (π r f_p - π (r + 1) f_p) := by ring
        rw [hEq]
        exact Ideal.add_mem _ (ih (Nat.le_of_lt hr')) hMemStep
    have hmP_eq_span : Ideal.comap g.toRingHom m = I_span := by
      rw [ha]
      refine le_antisymm ?_ ?_
      · intro f_p hf
        rw [MvPolynomial.mem_vanishingIdeal_singleton_iff] at hf
        have h0s := hTel s (le_refl s) f_p
        rw [hπ0, hπs, hf, map_zero, sub_zero] at h0s
        exact h0s
      · rw [Ideal.span_le]
        rintro _ ⟨i, rfl⟩
        rw [SetLike.mem_coe, MvPolynomial.mem_vanishingIdeal_singleton_iff]
        simp
    let lP : LTSeries (PrimeSpectrum (MvPolynomial (Fin s) k)) :=
      { length := s
        toFun := fun j => ⟨RingHom.ker (π j.1).toRingHom, RingHom.ker_isPrime (π j.1).toRingHom⟩
        step := fun i => by
          change RingHom.ker (π i.1).toRingHom < RingHom.ker (π (i.1 + 1)).toRingHom
          refine lt_of_le_of_ne ?_ ?_
          · intro f_p hf
            rw [RingHom.mem_ker] at hf ⊢
            have := congrArg (fun φ => φ f_p) (hπ_succ i)
            dsimp at this
            change (π (i.1 + 1)) f_p = 0
            rw [← this]
            change ψ i (π i.1 f_p) = 0
            have hf' : π i.1 f_p = 0 := hf
            rw [hf', map_zero]
          · intro hEq
            have hmem : MvPolynomial.X i - MvPolynomial.C (a i) ∈
                RingHom.ker (π (i.1 + 1)).toRingHom := by
              rw [RingHom.mem_ker]
              change π (i.1 + 1) (MvPolynomial.X i - MvPolynomial.C (a i)) = 0
              rw [map_sub]
              have h1 : π (i.1 + 1) (MvPolynomial.X i) = MvPolynomial.C (a i) := by
                rw [hπ_X, if_pos (Nat.lt_succ_self i.1)]
              have h2 : π (i.1 + 1) (MvPolynomial.C (a i)) = MvPolynomial.C (a i) := by
                rw [← MvPolynomial.algebraMap_eq, AlgHom.commutes]
              rw [h1, h2, sub_self]
            rw [← hEq, RingHom.mem_ker] at hmem
            change π i.1 (MvPolynomial.X i - MvPolynomial.C (a i)) = 0 at hmem
            rw [map_sub] at hmem
            have hXi : π i.1 (MvPolynomial.X i) = MvPolynomial.X i := by
              rw [hπ_X, if_neg (lt_irrefl i.1)]
            have hCi : π i.1 (MvPolynomial.C (a i)) = MvPolynomial.C (a i) := by
              rw [← MvPolynomial.algebraMap_eq, AlgHom.commutes]
            rw [hXi, hCi, sub_eq_zero] at hmem
            have hdeg := congrArg MvPolynomial.totalDegree hmem
            simp [MvPolynomial.totalDegree_X, MvPolynomial.totalDegree_C] at hdeg }
    have hlP_last : (lP.last).asIdeal = Ideal.comap g.toRingHom m := by
      change RingHom.ker (π s).toRingHom = Ideal.comap g.toRingHom m
      rw [ha]
      ext f_p
      rw [RingHom.mem_ker, MvPolynomial.mem_vanishingIdeal_singleton_iff]
      change π s f_p = 0 ↔ (MvPolynomial.aeval a) f_p = 0
      rw [hπs]
      exact ⟨fun h => MvPolynomial.C_injective _ _ (h.trans (map_zero _).symm),
        fun h => by rw [h, map_zero]⟩
    haveI : m.LiesOver (lP.last).asIdeal := ⟨hlP_last⟩
    obtain ⟨L, hL_len, hL_last, _⟩ := Ideal.exists_ltSeries_of_hasGoingDown lP m
    exact ⟨a, L, hL_len, hL_last, hmP_eq_span⟩
  
  have affine_appLE_fromSpec_comm : ∀ {X Y : AlgebraicGeometry.Scheme.{u}}
      (g : X ⟶ Y) {U : Y.Opens} {W : X.Opens}
      (hAffU : AlgebraicGeometry.IsAffineOpen U)
      (hAffW : AlgebraicGeometry.IsAffineOpen W)
      (hW : W ≤ (TopologicalSpace.Opens.map g.base).obj U),
      AlgebraicGeometry.Spec.map (g.appLE U W hW) ≫ hAffU.fromSpec =
        hAffW.fromSpec ≫ g := by
    clear noether_max_chain noether_dim_pkg hPillar4 hPillar3 hPillar2 hPillar1
      hProjProps sub_univ_isIrreducible
      hOneBr hTwoBr hDimC_fib hs_bar_pt hs_bar_hom s_bar hCls₀ s₀
      hConnXB hLocIsoXB hLocIsoC hCorr pr₂ pr₁ f_TB qX_B σ_B f_XB hProjC hIntC hCurve τ f
      T_B X_B C hUB hProjB hIntB ψ U_B B σ n f₂ X₂ U₂ B₂
    intro X Y g U W hAffU hAffW hW
    have h1 := AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_appLE g U W hW
