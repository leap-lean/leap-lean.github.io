      ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X k a))
      zero_lt_one
  let U_k_aff : Fin (N + 1) → ↑P_k.affineOpens := fun a => ⟨U_k a, hAff_k a⟩
  have hCov_k : ⨆ a : Fin (N + 1), U_k a = ⊤ :=
    AlgebraicGeometry.Proj.iSup_basicOpen_eq_top 𝒜_k MvPolynomial.X (hIrrel k)
  let θ_k : ∀ a : Fin (N + 1),
      ↑(P_k.presheaf.obj (Opposite.op (U_k a))) ≃+*
        HomogeneousLocalization.Away 𝒜_k (MvPolynomial.X a) :=
    fun a => CategoryTheory.Iso.commRingCatIsoToRingEquiv
      ((U_k a).topIso.symm ≪≫
        AlgebraicGeometry.Scheme.Γ.mapIso
          (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_k (MvPolynomial.X a)
            ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X k a))
            zero_lt_one).symm.op ≪≫
        AlgebraicGeometry.Scheme.ΓSpecIso
          (CommRingCat.of (HomogeneousLocalization.Away 𝒜_k (MvPolynomial.X a))))
  
  obtain ⟨L_W, hFD_W, hGenLifted⟩ :
      ∃ (L_W : IntermediateField F k) (_ : FiniteDimensional F ↥L_W),
        ∀ a : Fin (N + 1),
          ∃ (r : ℕ) (s_gen : Fin r → ↑(P_k.presheaf.obj (Opposite.op (U_k a))))
            (n_gen : Fin r → ℕ)
            (p₀_gen : Fin r → MvPolynomial (Fin (N + 1)) ↥L_W),
            Ideal.span (Set.range s_gen) =
              (AlgebraicGeometry.Scheme.Hom.ker ι_Wk).ideal (U_k_aff a) ∧
            ∀ ν : Fin r,
              (p₀_gen ν).IsHomogeneous (n_gen ν) ∧
              (θ_k a (s_gen ν)).val =
                Localization.mk (MvPolynomial.map (algebraMap ↥L_W k) (p₀_gen ν))
                  ⟨MvPolynomial.X a ^ (n_gen ν),
                    pow_mem (Submonoid.mem_powers (MvPolynomial.X a)) (n_gen ν)⟩ := by
    have hNoeth_sec : ∀ a : Fin (N + 1),
        IsNoetherianRing ↑(P_k.presheaf.obj (Opposite.op (U_k a))) := by
      intro a
      obtain ⟨e_a, _, _⟩ := hDehomEquiv k a (MvPolynomial.X a) rfl
      have : IsNoetherianRing (HomogeneousLocalization.Away 𝒜_k (MvPolynomial.X a)) :=
        isNoetherianRing_of_ringEquiv _ e_a
      exact isNoetherianRing_of_ringEquiv _ (θ_k a).symm
    have hFinGen : ∀ a : Fin (N + 1),
        ∃ (r : ℕ) (s_gen : Fin r → ↑(P_k.presheaf.obj (Opposite.op (U_k a)))),
          Ideal.span (Set.range s_gen) =
            (AlgebraicGeometry.Scheme.Hom.ker ι_Wk).ideal (U_k_aff a) := by
      intro a
      have := hNoeth_sec a
      have hfg : ((AlgebraicGeometry.Scheme.Hom.ker ι_Wk).ideal (U_k_aff a)).FG :=
        Ideal.FG.of_isNoetherianRing _
      exact (Submodule.fg_iff_exists_fin_generating_family).mp hfg
    choose r_gen s_gen hs_gen using hFinGen
    have hRep : ∀ (a : Fin (N + 1)) (ν : Fin (r_gen a)),
        ∃ (n : ℕ) (p : MvPolynomial (Fin (N + 1)) k),
          p.IsHomogeneous n ∧
          (θ_k a (s_gen a ν)).val =
            Localization.mk p
              ⟨MvPolynomial.X a ^ n, pow_mem (Submonoid.mem_powers (MvPolynomial.X a)) n⟩ := by
      intro a ν
      obtain ⟨nd, hnd⟩ := Quotient.exists_rep (θ_k a (s_gen a ν))
      obtain ⟨n, hn⟩ := nd.den_mem
      have hd_hom : ((MvPolynomial.X a : MvPolynomial (Fin (N + 1)) k) ^ n).IsHomogeneous nd.deg := by
        have hmem := nd.den.2
        rw [← hn] at hmem
        exact (MvPolynomial.mem_homogeneousSubmodule nd.deg _).mp hmem
      have hdeg : nd.deg = n := hPowDegEq k a n nd.deg hd_hom
      refine ⟨n, (nd.num : MvPolynomial (Fin (N + 1)) k), ?_, ?_⟩
      · rw [← hdeg]
        exact (MvPolynomial.mem_homogeneousSubmodule nd.deg _).mp nd.num.2
      · rw [← hnd, HomogeneousLocalization.val_mk]
        congr 1
        exact Subtype.ext hn.symm
    choose n_gen p_gen hp_homog hp_val using hRep
    let S_proj : Set k :=
      ⋃ (a : Fin (N + 1)) (ν : Fin (r_gen a)), ((p_gen a ν).coeffs : Set k)
    have hFinS : S_proj.Finite :=
      Set.finite_iUnion fun a => Set.finite_iUnion fun ν => Finset.finite_toSet _
    have _ : Finite ↑S_proj := hFinS.to_subtype
    have _ : Algebra.IsAlgebraic F k := AlgebraicClosure.isAlgebraic F
    have _ : Algebra.IsIntegral F k := Algebra.IsAlgebraic.isIntegral
    let L₀ : IntermediateField F k := IntermediateField.adjoin F S_proj
    have hFD₀ : FiniteDimensional F ↥L₀ :=
      IntermediateField.finiteDimensional_adjoin fun x _ => Algebra.IsIntegral.isIntegral x
    have hSub_S : S_proj ⊆ (L₀ : Set k) := IntermediateField.subset_adjoin F S_proj
    refine ⟨L₀, hFD₀, ?_⟩
    intro a
    have hLiftPoly : ∀ ν : Fin (r_gen a),
        ∃ p₀ : MvPolynomial (Fin (N + 1)) ↥L₀,
          p₀.IsHomogeneous (n_gen a ν) ∧
          MvPolynomial.map (algebraMap ↥L₀ k) p₀ = p_gen a ν := by
      intro ν
      have hsub_coeffs : ((p_gen a ν).coeffs : Set k) ⊆ Set.range ⇑(algebraMap ↥L₀ k) := by
        intro c hc
        have hcS : c ∈ S_proj := Set.mem_iUnion.mpr ⟨a, Set.mem_iUnion.mpr ⟨ν, hc⟩⟩
        exact ⟨⟨c, hSub_S hcS⟩, rfl⟩
      obtain ⟨p₀, hp₀_map⟩ := (MvPolynomial.mem_range_map_iff_coeffs_subset).mpr hsub_coeffs
      refine ⟨p₀, ?_, hp₀_map⟩
      intro m hm_ne
      have hmap_ne : (algebraMap ↥L₀ k) (p₀.coeff m) ≠ 0 :=
        (map_ne_zero_iff _ (RingHom.injective (algebraMap ↥L₀ k))).mpr hm_ne
      have hp_ne : (p_gen a ν).coeff m ≠ 0 := by
        rwa [← hp₀_map, MvPolynomial.coeff_map]
      exact hp_homog a ν hp_ne
    choose p₀_gen hp₀_hom hp₀_map using hLiftPoly
    refine ⟨r_gen a, s_gen a, n_gen a, p₀_gen, hs_gen a, ?_⟩
    intro ν
    refine ⟨hp₀_hom ν, ?_⟩
    rw [hp₀_map ν]
    exact hp_val a ν
  
  let 𝒜₀ := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥L_W
  let _ : GradedAlgebra 𝒜₀ := MvPolynomial.gradedAlgebra
  obtain ⟨π, hPB_π, hAff_π, hChartLift⟩ := hProjPBAndLift ↥L_W k
  let P₀ : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Proj 𝒜₀
  let U₀ : Fin (N + 1) → P₀.Opens :=
    fun a => AlgebraicGeometry.Proj.basicOpen 𝒜₀ (MvPolynomial.X a)
  have hAff₀ : ∀ a : Fin (N + 1), AlgebraicGeometry.IsAffineOpen (U₀ a) :=
    fun a => AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜₀ (MvPolynomial.X a)
      ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X ↥L_W a))
      zero_lt_one
  let U₀_aff : Fin (N + 1) → ↑P₀.affineOpens := fun a => ⟨U₀ a, hAff₀ a⟩
  choose hPre hSecLift using hChartLift
  have hLift : ∀ a : Fin (N + 1),
      ∃ G : Set ↑(P_k.presheaf.obj (Opposite.op (U_k a))),
        Ideal.span G = (AlgebraicGeometry.Scheme.Hom.ker ι_Wk).ideal (U_k_aff a) ∧
        G ⊆ Set.range (CommRingCat.Hom.hom
          (AlgebraicGeometry.Scheme.Hom.appLE π (U₀ a) (U_k a) (hPre a).ge)) := by
    intro a
    obtain ⟨r, s_gen, n_gen, p₀_gen, hs_span, h_spec⟩ := hGenLifted a
    refine ⟨Set.range s_gen, hs_span, ?_⟩
    rintro _ ⟨ν, rfl⟩
    obtain ⟨hp₀_hom, hval_eq⟩ := h_spec ν
    have hp₀_mem : p₀_gen ν ∈ 𝒜₀ (n_gen ν) :=
      (MvPolynomial.mem_homogeneousSubmodule (n_gen ν) _).mpr hp₀_hom
    obtain ⟨s₀, hs₀_val⟩ := hSecLift a (n_gen ν) (p₀_gen ν) hp₀_mem
    refine ⟨s₀, ?_⟩
    apply (θ_k a).injective
    apply HomogeneousLocalization.val_injective
    exact hs₀_val.trans hval_eq.symm
  
  obtain ⟨Y₀_left, ι₀, hClosed_ι₀, p_W, hPB_pasted⟩ :=
    hClosedDescent ι_Wk π
      (AlgebraicGeometry.Proj.toSpecZero 𝒜_k ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜_k 0))))
      (AlgebraicGeometry.Proj.toSpecZero 𝒜₀ ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥L_W ↥(𝒜₀ 0))))
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥L_W k)))
      hPB_π U₀_aff U_k_aff hCov_k hPre hLift
  let Y_W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of ↥L_W)) :=
    CategoryTheory.Over.mk (ι₀ ≫ (weilProjectiveSpaceOver ↥L_W N).hom)
  let ι_YW : Y_W ⟶ weilProjectiveSpaceOver ↥L_W N :=
    CategoryTheory.Over.homMk ι₀ rfl
  have hClosedY : AlgebraicGeometry.IsClosedImmersion ι_YW.left := hClosed_ι₀
  have hProjY : IsProjectiveOverField ↥L_W Y_W := ⟨N, ι_YW, hClosedY⟩
  have hWhom : ι_Wk ≫ (AlgebraicGeometry.Proj.toSpecZero 𝒜_k ≫
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜_k 0)))) = W.hom :=
    CategoryTheory.Over.w ι_W
  have hPB_final : CategoryTheory.IsPullback p_W W.hom Y_W.hom
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥L_W k))) := by
    rw [← hWhom]
    exact hPB_pasted
  exact ⟨L_W, hFD_W, Y_W, p_W, hProjY, hPB_final⟩

theorem weil_spread_out_open_of_baseChange (F : Type u) [Field F]
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    [AlgebraicGeometry.IsProper X.hom]
    (U_bar : (weilBaseChangeOver F (AlgebraicClosure F) X).left.Opens) :
    ∃ (L_U : IntermediateField F (AlgebraicClosure F)) (_ : FiniteDimensional F ↥L_U)
      (U_L : (weilBaseChangeOver F ↥L_U X).left.Opens),
      (TopologicalSpace.Opens.map
        (weilBaseChangeMap F ↥L_U (AlgebraicClosure F) X).base).obj U_L = U_bar :=
by
  
  have hS1 : ∃ (s : ℕ) (R : Fin s → Type u)
      (_ : ∀ b, CommRing (R b)) (_ : ∀ b, Algebra F (R b)) (_ : ∀ b, Algebra.FiniteType F (R b))
      (e : ∀ b, AlgebraicGeometry.Spec (CommRingCat.of (R b)) ⟶ X.left)
      (_ : ∀ b, AlgebraicGeometry.IsOpenImmersion (e b)),
      (∀ b, e b ≫ X.hom = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (R b)))) ∧
      (⨆ b : Fin s, AlgebraicGeometry.Scheme.Hom.opensRange (e b)) = ⊤ := by
    have : CompactSpace ↥X.left :=
      AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace X.hom
    obtain ⟨Us, hUs_sub, hUs_fin, hUs_top⟩ :=
      TopologicalSpace.Opens.IsBasis.exists_finite_of_isCompact
        (AlgebraicGeometry.Scheme.isBasis_affineOpens X.left)
        (U := (⊤ : X.left.Opens)) isCompact_univ
    letI : Fintype ↑Us := hUs_fin.fintype
    let s : ℕ := Fintype.card ↑Us
    let σ : Fin s ≃ ↑Us := (Fintype.equivFin ↑Us).symm
    let V : Fin s → X.left.Opens := fun b => (σ b).1
    have hV : ∀ b : Fin s, AlgebraicGeometry.IsAffineOpen (V b) :=
      fun b => hUs_sub (σ b).2
    let R_cat : Fin s → CommRingCat.{u} :=
      fun b => X.left.presheaf.obj (Opposite.op (V b))
    let R : Fin s → Type u := fun b => ↑(R_cat b)
    let instCR : ∀ b : Fin s, CommRing (R b) :=
      fun b => inferInstanceAs (CommRing ↑(R_cat b))
    letI := instCR
    have hTop : AlgebraicGeometry.IsAffineOpen
        (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of F)).Opens) :=
      AlgebraicGeometry.isAffineOpen_top (AlgebraicGeometry.Spec (CommRingCat.of F))
    let φ_F : ∀ b : Fin s, CommRingCat.of F ⟶ R_cat b :=
      fun b => (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of F)).inv ≫
        X.hom.appLE ⊤ (V b) le_top
    let instAlg : ∀ b : Fin s, Algebra F (R b) :=
      fun b => (φ_F b).hom.toAlgebra
    letI := instAlg
    have hFT : ∀ b : Fin s, Algebra.FiniteType F (R b) := by
      intro b
      rw [← RingHom.finiteType_algebraMap]
      have h_app : (X.hom.appLE ⊤ (V b) le_top).hom.FiniteType :=
        AlgebraicGeometry.LocallyOfFiniteType.finiteType_appLE X.hom hTop (hV b) le_top
      have h_inv_surj : Function.Surjective
          ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of F)).inv).hom :=
        (ConcreteCategory.bijective_of_isIso
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of F)).inv).2
      have h_inv : ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of F)).inv).hom.FiniteType :=
        RingHom.FiniteType.of_surjective _ h_inv_surj
      change ((φ_F b).hom).FiniteType
      rw [CommRingCat.hom_comp]
      exact h_app.comp h_inv
    let e : ∀ b : Fin s, AlgebraicGeometry.Spec (CommRingCat.of (R b)) ⟶ X.left :=
      fun b => (hV b).fromSpec
    have hOpen : ∀ b : Fin s, AlgebraicGeometry.IsOpenImmersion (e b) :=
      fun b => inferInstanceAs (AlgebraicGeometry.IsOpenImmersion (hV b).fromSpec)
    refine ⟨s, R, instCR, instAlg, hFT, e, hOpen, ?_, ?_⟩
    · intro b
      have h1 := (AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec
        X.hom hTop (hV b) le_top).symm
      change (hV b).fromSpec ≫ X.hom = _
      rw [h1, AlgebraicGeometry.IsAffineOpen.fromSpec_top,
        AlgebraicGeometry.Scheme.isoSpec_Spec]
      have h_iso_inv :
          (AlgebraicGeometry.Scheme.Spec.mapIso
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of F)).op).inv =
          AlgebraicGeometry.Spec.map
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of F)).inv := rfl
      rw [h_iso_inv, ← AlgebraicGeometry.Spec.map_comp]
      congr 1
    · have hRange : ∀ b : Fin s, AlgebraicGeometry.Scheme.Hom.opensRange (e b) = (σ b).1 :=
        fun b => (hV b).opensRange_fromSpec
      refine (iSup_congr hRange).trans ?_
      rw [σ.iSup_comp (g := fun u : ↑Us => u.1), ← sSup_eq_iSup', ← hUs_top]
  
  have hChartCond : ∀ (K : Type u) [CommRing K] [Algebra F K]
      (R : Type u) [CommRing R] [Algebra F R]
      (e : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ X.left),
      (e ≫ X.hom = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F R))) →
      (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (Algebra.TensorProduct.includeRight (R := F) (A := K) (B := R)).toRingHom) ≫ e) ≫ X.hom =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom : K →+* TensorProduct F K R)) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F K)) := by
    intro K _ _ R _ _ e he
    rw [CategoryTheory.Category.assoc, he, ← AlgebraicGeometry.Spec.map_comp,
      ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
    apply congrArg AlgebraicGeometry.Spec.map
    apply congrArg CommRingCat.ofHom
    ext c
    exact ((congrArg ((1 : K) ⊗ₜ[F] ·) (Algebra.algebraMap_eq_smul_one c)).trans
      ((TensorProduct.tmul_smul c (1 : K) (1 : R)).trans
        ((TensorProduct.smul_tmul' c (1 : K) (1 : R)).trans
          (congrArg (· ⊗ₜ[F] (1 : R)) (Algebra.algebraMap_eq_smul_one c).symm))))
  let chart : ∀ (K : Type u) [CommRing K] [Algebra F K]
      (R : Type u) [CommRing R] [Algebra F R]
      (e : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ X.left),
      (e ≫ X.hom = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F R))) →
      (AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct F K R)) ⟶
        (weilBaseChangeOver F K X).left) :=
    fun K _ _ R _ _ e he =>
      (CategoryTheory.Limits.pullback.lift
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom) ≫ e)
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom))
        (hChartCond K R e he) :
        AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct F K R)) ⟶
          CategoryTheory.Limits.pullback X.hom
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F K))))
  
  have hS2 : ∀ (E K : Type u) [CommRing E] [CommRing K]
      [Algebra F E] [Algebra E K] [Algebra F K] [IsScalarTower F E K]
      (R : Type u) [CommRing R] [Algebra F R]
      (e : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ X.left)
      [AlgebraicGeometry.IsOpenImmersion e]
      (he : e ≫ X.hom = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F R))),
      ∃ (hOE : AlgebraicGeometry.IsOpenImmersion (chart E R e he))
        (hOK : AlgebraicGeometry.IsOpenImmersion (chart K R e he)),
        AlgebraicGeometry.Scheme.Hom.opensRange (chart K R e he) =
          (TopologicalSpace.Opens.map
            (CategoryTheory.Limits.pullback.fst X.hom
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F K)))).base).obj
            (AlgebraicGeometry.Scheme.Hom.opensRange e) ∧
        ∀ (g : TensorProduct F E R),
          (TopologicalSpace.Opens.map (weilBaseChangeMap F E K X).base).obj
            ((@AlgebraicGeometry.Scheme.Hom.opensFunctor _ _ (chart E R e he) hOE).obj
              (_root_.PrimeSpectrum.basicOpen g)) =
          (@AlgebraicGeometry.Scheme.Hom.opensFunctor _ _ (chart K R e he) hOK).obj
            (_root_.PrimeSpectrum.basicOpen
              (Algebra.TensorProduct.map (IsScalarTower.toAlgHom F E K) (AlgHom.id F R) g)) := by
    intro E K _ _ _ _ _ _ R _ _ e _ he
    have hpChart : ∀ (A : Type u) [CommRing A] [Algebra F A],
        CategoryTheory.IsPullback
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (Algebra.TensorProduct.includeRight (R := F) (A := A) (B := R)).toRingHom))
          (chart A R e he)
          e
          (CategoryTheory.Limits.pullback.fst X.hom
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F A)))) := by
      intro A _ _
      let s_FA := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F A))
      have hSpecPush :=
        AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _
          (CommRingCat.isPushout_tensorProduct F A R)
      have hOuter : CategoryTheory.IsPullback
          (chart A R e he ≫ CategoryTheory.Limits.pullback.snd X.hom s_FA)
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (Algebra.TensorProduct.includeRight (R := F) (A := A) (B := R)).toRingHom))
          s_FA
          (e ≫ X.hom) := by
        dsimp only [chart, weilBaseChangeOver, s_FA]
        rw [CategoryTheory.Limits.pullback.lift_snd, he]
        exact hSpecPush
      have hLeftComm : chart A R e he ≫ CategoryTheory.Limits.pullback.fst X.hom s_FA =
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (Algebra.TensorProduct.includeRight (R := F) (A := A) (B := R)).toRingHom) ≫ e := by
        dsimp only [chart, weilBaseChangeOver, s_FA]
        exact CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hRight : CategoryTheory.IsPullback
          (CategoryTheory.Limits.pullback.snd X.hom s_FA)
          (CategoryTheory.Limits.pullback.fst X.hom s_FA)
          s_FA X.hom :=
        (CategoryTheory.IsPullback.of_hasPullback X.hom s_FA).flip
      exact (CategoryTheory.IsPullback.of_right hOuter hLeftComm hRight).flip
    have hpE := hpChart E
    have hpK := hpChart K
    have hOE : AlgebraicGeometry.IsOpenImmersion (chart E R e he) :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpE inferInstance
    have hOK : AlgebraicGeometry.IsOpenImmersion (chart K R e he) :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpK inferInstance
    refine ⟨hOE, hOK, ?_, ?_⟩
    · have hTopEq := AlgebraicGeometry.IsOpenImmersion.image_preimage_eq_preimage_image_of_isPullback
        hpK (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of R)).Opens)
      rw [TopologicalSpace.Opens.map_top, AlgebraicGeometry.Scheme.Hom.image_top_eq_opensRange,
        AlgebraicGeometry.Scheme.Hom.image_top_eq_opensRange] at hTopEq
      exact hTopEq
    · intro g
      let τ_EK : TensorProduct F E R →+* TensorProduct F K R :=
        (Algebra.TensorProduct.map (IsScalarTower.toAlgHom F E K) (AlgHom.id F R)).toRingHom
      let q_EK : AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct F K R)) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct F E R)) :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_EK)
      let p_EK := weilBaseChangeMap F E K X
      have h_incR : q_EK ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (Algebra.TensorProduct.includeRight (R := F) (A := E) (B := R)).toRingHom) =
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (Algebra.TensorProduct.includeRight (R := F) (A := K) (B := R)).toRingHom) := by
        dsimp only [q_EK, τ_EK]
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        congr 1
        ext r
        simp
      have h_fst_EK : p_EK ≫ CategoryTheory.Limits.pullback.fst X.hom
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F E))) =
          CategoryTheory.Limits.pullback.fst X.hom
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F K))) := by
        dsimp only [p_EK, weilBaseChangeMap]
        exact CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hComm_EK : q_EK ≫ chart E R e he = chart K R e he ≫ p_EK := by
        dsimp only [chart, p_EK, weilBaseChangeMap, weilBaseChangeOver]
        apply CategoryTheory.Limits.pullback.hom_ext
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
            CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
            CategoryTheory.Limits.pullback.lift_fst, ← CategoryTheory.Category.assoc, h_incR]
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
            CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
            ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd]
          dsimp only [q_EK, τ_EK]
          rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
            ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
          congr 1
      have hOuter_EK : CategoryTheory.IsPullback
          (q_EK ≫ AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (Algebra.TensorProduct.includeRight (R := F) (A := E) (B := R)).toRingHom))
          (chart K R e he)
          e
          (p_EK ≫ CategoryTheory.Limits.pullback.fst X.hom
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F E)))) := by
        rw [h_incR, h_fst_EK]
        exact hpK
      have hp_EK : CategoryTheory.IsPullback q_EK (chart K R e he) (chart E R e he) p_EK :=
        CategoryTheory.IsPullback.of_right hOuter_EK hComm_EK hpE
      have hImg := (AlgebraicGeometry.IsOpenImmersion.image_preimage_eq_preimage_image_of_isPullback
        hp_EK (_root_.PrimeSpectrum.basicOpen g :
          (AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct F E R))).Opens)).symm
      rw [hImg, AlgebraicGeometry.SpecMap_preimage_basicOpen (CommRingCat.ofHom τ_EK) g]
      rfl
  
  have hS3 : ∀ (R : Type u) [CommRing R] [Algebra F R] [Algebra.FiniteType F R]
      (W_bar : TopologicalSpace.Opens (_root_.PrimeSpectrum (TensorProduct F (AlgebraicClosure F) R))),
      ∃ (S : Set (AlgebraicClosure F)), S.Finite ∧
        ∀ (L : IntermediateField F (AlgebraicClosure F)),
          S ⊆ (L : Set (AlgebraicClosure F)) →
          ∃ (m : ℕ) (g : Fin m → TensorProduct F ↥L R),
            W_bar = ⨆ ν : Fin m,
              _root_.PrimeSpectrum.basicOpen
                (Algebra.TensorProduct.map (IsScalarTower.toAlgHom F ↥L (AlgebraicClosure F))
                  (AlgHom.id F R) (g ν)) := by
    intro R _ _ _ W_bar
    let k : Type u := AlgebraicClosure F
    have : Algebra.FiniteType k (TensorProduct F k R) :=
      Algebra.FiniteType.baseChange k
    have : IsNoetherianRing (TensorProduct F k R) :=
      Algebra.FiniteType.isNoetherianRing k (TensorProduct F k R)
    have hComp : IsCompact W_bar.carrier :=
      TopologicalSpace.NoetherianSpace.isCompact W_bar.carrier
    obtain ⟨Bs, hBs_sub, hBs_fin, hBs_eq⟩ :=
      TopologicalSpace.Opens.IsBasis.exists_finite_of_isCompact
        _root_.PrimeSpectrum.isBasis_basic_opens hComp
    letI : Fintype ↑Bs := hBs_fin.fintype
    let m : ℕ := Fintype.card ↑Bs
    let τ : Fin m ≃ ↑Bs := (Fintype.equivFin ↑Bs).symm
    have h_mem_range : ∀ ν : Fin m, (τ ν).1 ∈ Set.range _root_.PrimeSpectrum.basicOpen :=
      fun ν => hBs_sub (τ ν).2
    choose g_bar hg_bar using h_mem_range
    have hW_eq : W_bar = ⨆ ν : Fin m, _root_.PrimeSpectrum.basicOpen (g_bar ν) := by
      rw [hBs_eq, sSup_eq_iSup', ← τ.iSup_comp (g := fun u : ↑Bs => u.1)]
      exact iSup_congr fun ν => (hg_bar ν).symm
    choose T hT using fun ν : Fin m => TensorProduct.exists_finset (g_bar ν)
    let S : Set k := ⋃ ν : Fin m, Prod.fst '' (↑(T ν) : Set (k × R))
    have hS_fin : S.Finite :=
      Set.finite_iUnion fun ν => (T ν).finite_toSet.image Prod.fst
    refine ⟨S, hS_fin, ?_⟩
    intro L hSL
    have h_mem_L : ∀ (ν : Fin m) (q : {p // p ∈ T ν}), q.1.1 ∈ L := by
      intro ν q
      apply hSL
      exact Set.mem_iUnion.mpr ⟨ν, q.1, q.2, rfl⟩
    let g : Fin m → TensorProduct F ↥L R :=
      fun ν => ∑ q ∈ (T ν).attach,
        (⟨q.1.1, h_mem_L ν q⟩ : ↥L) ⊗ₜ[F] q.1.2
    refine ⟨m, g, ?_⟩
    rw [hW_eq]
    refine iSup_congr fun ν => ?_
    congr 1
    rw [hT ν]
    dsimp only [g]
    rw [map_sum]
    conv_lhs => rw [← Finset.sum_attach (T ν)]
    refine Finset.sum_congr rfl fun q _ => ?_
    simp [Algebra.TensorProduct.map_tmul]
  
  let k : Type u := AlgebraicClosure F
  obtain ⟨s, R, instCR, instAlg, instFT, e, instOpen_e, he, hCover⟩ := hS1
  letI := instCR
  letI := instAlg
  have := instFT
  have := instOpen_e
  let j_k : ∀ b : Fin s,
      AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct F k (R b))) ⟶
        (weilBaseChangeOver F k X).left :=
    fun b => chart k (R b) (e b) (he b)
  let W_bar : ∀ b : Fin s,
      TopologicalSpace.Opens (_root_.PrimeSpectrum (TensorProduct F k (R b))) :=
    fun b => (TopologicalSpace.Opens.map (j_k b).base).obj U_bar
  choose S hFinS hDesc using fun b : Fin s => hS3 (R b) (W_bar b)
  let S_all : Set k := ⋃ b : Fin s, S b
  have hFinAll : S_all.Finite := Set.finite_iUnion hFinS
  have : Finite ↑S_all := hFinAll.to_subtype
  let L_U : IntermediateField F k := IntermediateField.adjoin F S_all
  have hFD_U : FiniteDimensional F ↥L_U :=
    IntermediateField.finiteDimensional_adjoin fun x _ => Algebra.IsIntegral.isIntegral x
  have hSub_L : ∀ b : Fin s, S b ⊆ (L_U : Set k) :=
    fun b => Set.Subset.trans (Set.subset_iUnion S b) (IntermediateField.subset_adjoin F S_all)
  choose m g hg using fun b : Fin s => hDesc b L_U (hSub_L b)
  let j_L : ∀ b : Fin s,
      AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct F ↥L_U (R b))) ⟶
        (weilBaseChangeOver F ↥L_U X).left :=
    fun b => chart ↥L_U (R b) (e b) (he b)
  have hChartProps := fun b : Fin s => hS2 ↥L_U k (R b) (e b) (he b)
  have hOpen_L : ∀ b : Fin s, AlgebraicGeometry.IsOpenImmersion (j_L b) :=
    fun b => (hChartProps b).1
  have hOpen_k : ∀ b : Fin s, AlgebraicGeometry.IsOpenImmersion (j_k b) :=
    fun b => (hChartProps b).2.1
  let fst_k : (weilBaseChangeOver F k X).left ⟶ X.left :=
    CategoryTheory.Limits.pullback.fst X.hom
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F k)))
  have hRange_k : ∀ b : Fin s,
      AlgebraicGeometry.Scheme.Hom.opensRange (j_k b) =
        (TopologicalSpace.Opens.map fst_k.base).obj
          (AlgebraicGeometry.Scheme.Hom.opensRange (e b)) :=
    fun b => (hChartProps b).2.2.1
  let B_L : ∀ (b : Fin s), Fin (m b) →
      (AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct F ↥L_U (R b)))).Opens :=
    fun b ν => _root_.PrimeSpectrum.basicOpen (g b ν)
  let B_k : ∀ (b : Fin s), Fin (m b) →
      (AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct F k (R b)))).Opens :=
    fun b ν => _root_.PrimeSpectrum.basicOpen
      (Algebra.TensorProduct.map (IsScalarTower.toAlgHom F ↥L_U k)
        (AlgHom.id F (R b)) (g b ν))
  have hPre_g : ∀ (b : Fin s) (ν : Fin (m b)),
      (TopologicalSpace.Opens.map (weilBaseChangeMap F ↥L_U k X).base).obj
        ((@AlgebraicGeometry.Scheme.Hom.opensFunctor _ _ (j_L b) (hOpen_L b)).obj (B_L b ν)) =
      (@AlgebraicGeometry.Scheme.Hom.opensFunctor _ _ (j_k b) (hOpen_k b)).obj (B_k b ν) :=
    fun b ν => (hChartProps b).2.2.2 (g b ν)
  let U_L : (weilBaseChangeOver F ↥L_U X).left.Opens :=
    ⨆ b : Fin s, ⨆ ν : Fin (m b),
      (@AlgebraicGeometry.Scheme.Hom.opensFunctor _ _ (j_L b) (hOpen_L b)).obj (B_L b ν)
  refine ⟨L_U, hFD_U, U_L, ?_⟩
  let p_X := weilBaseChangeMap F ↥L_U k X
  have h_each : ∀ b : Fin s,
      (TopologicalSpace.Opens.map p_X.base).obj
        (⨆ ν : Fin (m b),
          (@AlgebraicGeometry.Scheme.Hom.opensFunctor _ _ (j_L b) (hOpen_L b)).obj (B_L b ν)) =
      AlgebraicGeometry.Scheme.Hom.opensRange (j_k b) ⊓ U_bar := by
    intro b
    have : AlgebraicGeometry.IsOpenImmersion (j_k b) := hOpen_k b
    have hW_b : (⨆ ν : Fin (m b), B_k b ν) = (TopologicalSpace.Opens.map (j_k b).base).obj U_bar :=
      (hg b).symm
    exact (TopologicalSpace.Opens.map_iSup p_X.base _).trans
      ((iSup_congr fun ν => hPre_g b ν).trans
        ((AlgebraicGeometry.Scheme.Hom.image_iSup (j_k b) (B_k b)).symm.trans
          ((congrArg (AlgebraicGeometry.Scheme.Hom.opensFunctor (j_k b)).obj hW_b).trans
            (AlgebraicGeometry.Scheme.Hom.image_preimage_eq_opensRange_inf (j_k b) U_bar))))
  have hSupRange :
      (⨆ b : Fin s, AlgebraicGeometry.Scheme.Hom.opensRange (j_k b)) = ⊤ :=
    (iSup_congr hRange_k).trans
      ((TopologicalSpace.Opens.map_iSup fst_k.base
        (fun b : Fin s => AlgebraicGeometry.Scheme.Hom.opensRange (e b))).symm.trans
        ((congrArg (TopologicalSpace.Opens.map fst_k.base).obj hCover).trans
          (TopologicalSpace.Opens.map_top fst_k.base)))
  exact (TopologicalSpace.Opens.map_iSup p_X.base _).trans
    ((iSup_congr h_each).trans
      ((@iSup_inf_eq _ _ _ (fun b : Fin s => AlgebraicGeometry.Scheme.Hom.opensRange (j_k b)) U_bar).symm.trans
        ((congrArg (· ⊓ U_bar) hSupRange).trans (top_inf_eq U_bar))))

theorem weil_spread_out_morphism_of_baseChange_model (F : Type u) [Field F]
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    [AlgebraicGeometry.IsProper X.hom]
    (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure F))))
    (φ_bar : W ⟶ weilBaseChangeOver F (AlgebraicClosure F) X)
    (L₁ : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F ↥L₁]
    (Y₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of ↥L₁)))
    (hProj₁ : IsProjectiveOverField ↥L₁ Y₁)
    (p_W₁ : W.left ⟶ Y₁.left)
    (hpW₁ : CategoryTheory.IsPullback p_W₁ W.hom Y₁.hom
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥L₁ (AlgebraicClosure F))))) :
    ∃ (L₀ : IntermediateField F (AlgebraicClosure F))
      (hLE : L₁ ≤ L₀)
      (_ : FiniteDimensional F ↥L₀),
      letI : Algebra ↥L₁ ↥L₀ := (IntermediateField.inclusion hLE).toRingHom.toAlgebra
      ∃ (φ₀ : weilBaseChangeOver ↥L₁ ↥L₀ Y₁ ⟶ weilBaseChangeOver F ↥L₀ X)
        (p_W₀ : W.left ⟶ (weilBaseChangeOver ↥L₁ ↥L₀ Y₁).left),
        CategoryTheory.IsPullback p_W₀ W.hom (weilBaseChangeOver ↥L₁ ↥L₀ Y₁).hom
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥L₀ (AlgebraicClosure F)))) ∧
        p_W₀ ≫ φ₀.left = φ_bar.left ≫ weilBaseChangeMap F ↥L₀ (AlgebraicClosure F) X :=
by
  
  have s1_isProper_of_isProjectiveOverField :
      ∀ (E : Type u) [Field E]
        (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of E))),
        IsProjectiveOverField E Y → AlgebraicGeometry.IsProper Y.hom := by
    intro E _ Y hProj
    obtain ⟨N, ι, hClosed⟩ := hProj
    have : AlgebraicGeometry.IsClosedImmersion ι.left := hClosed
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E
    letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have : IsScalarTower E ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) E) :=
      ⟨fun c x p => smul_mul_assoc c (x : MvPolynomial (Fin (N + 1)) E) p⟩
    have : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) E) :=
      Algebra.FiniteType.of_restrictScalars_finiteType E ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) E)
    let f₀ : CommRingCat.of E ⟶ CommRingCat.of ↥(𝒜 0) :=
      CommRingCat.ofHom (algebraMap E ↥(𝒜 0))
    have hf₀_bij : Function.Bijective f₀.hom := by
      have : Nontrivial ↥(𝒜 0) := ⟨⟨0, 1, fun h => zero_ne_one (congrArg Subtype.val h)⟩⟩
      refine ⟨(algebraMap E ↥(𝒜 0)).injective, fun p => ?_⟩
      have hp : (p : MvPolynomial (Fin (N + 1)) E) ∈
          (1 : Submodule E (MvPolynomial (Fin (N + 1)) E)) := by
        rw [← MvPolynomial.homogeneousSubmodule_zero (Fin (N + 1))]
        exact p.2
      obtain ⟨c, hc⟩ := Submodule.mem_one.mp hp
      refine ⟨c, Subtype.ext ?_⟩
      have h_alg : f₀.hom c = c • (1 : ↥(𝒜 0)) := Algebra.algebraMap_eq_smul_one c
      rw [h_alg]
      change c • (1 : MvPolynomial (Fin (N + 1)) E) = p.1
      rw [Algebra.smul_def, mul_one]
      exact hc
    have : CategoryTheory.IsIso f₀ := (ConcreteCategory.isIso_iff_bijective f₀).mpr hf₀_bij
    have hProp1 : AlgebraicGeometry.IsProper ι.left := inferInstance
    have hProp2 : AlgebraicGeometry.IsProper (AlgebraicGeometry.Proj.toSpecZero 𝒜) :=
      AlgebraicGeometry.Proj.instIsProperToSpecZeroOfFiniteTypeSubtypeMemOfNatNat 𝒜
    have hProp3 : AlgebraicGeometry.IsProper (AlgebraicGeometry.Spec.map f₀) := inferInstance
    have h_eq : Y.hom = ι.left ≫ AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
        AlgebraicGeometry.Spec.map f₀ :=
      (CategoryTheory.Over.w ι).symm
    rw [h_eq]
    exact MorphismProperty.comp_mem @AlgebraicGeometry.IsProper _ _ hProp1
      (MorphismProperty.comp_mem @AlgebraicGeometry.IsProper _ _ hProp2 hProp3)

  
  have s2_finite_spec_cover_of_isProper :
      ∀ (B₀ : Type u) [CommRing B₀]
        (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of B₀)))
        [AlgebraicGeometry.IsProper Z.hom],
        ∃ (n : ℕ) (R : Fin n → CommRingCat.{u})
          (ρ : ∀ a : Fin n, CommRingCat.of B₀ ⟶ R a)
          (ι₀ : ∀ a : Fin n, AlgebraicGeometry.Spec (R a) ⟶ Z.left)
          (hOpen : ∀ a : Fin n, AlgebraicGeometry.IsOpenImmersion (ι₀ a)),
          (∀ a : Fin n, ((ρ a).hom).FiniteType) ∧
          (∀ a : Fin n, ι₀ a ≫ Z.hom = AlgebraicGeometry.Spec.map (ρ a)) ∧
          (⨆ a : Fin n, @AlgebraicGeometry.Scheme.Hom.opensRange _ _ (ι₀ a) (hOpen a)) = ⊤ := by
    intro B₀ _ Z _
    have : CompactSpace ↥Z.left :=
      AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace Z.hom
    have hCompTop : IsCompact (((⊤ : Z.left.Opens) : Set ↥Z.left)) := isCompact_univ
    obtain ⟨S, hS_fin, hS_eq⟩ :=
      AlgebraicGeometry.isCompact_iff_finite_and_eq_biUnion_affineOpens.mp hCompTop
    letI : Fintype S := hS_fin.fintype
    let n : ℕ := Fintype.card S
    let e : Fin n ≃ S := (Fintype.equivFin S).symm
    let U : Fin n → Z.left.Opens := fun a => (e a).1.1
    have hAff : ∀ a : Fin n, AlgebraicGeometry.IsAffineOpen (U a) := fun a => (e a).1.2
    let R : Fin n → CommRingCat.{u} := fun a => Z.left.presheaf.obj (Opposite.op (U a))
    let ι₀ : ∀ a : Fin n, AlgebraicGeometry.Spec (R a) ⟶ Z.left := fun a => (hAff a).fromSpec
    have hOpen : ∀ a : Fin n, AlgebraicGeometry.IsOpenImmersion (ι₀ a) := fun a => inferInstance
    let ρ : ∀ a : Fin n, CommRingCat.of B₀ ⟶ R a :=
      fun a => AlgebraicGeometry.Spec.preimage (ι₀ a ≫ Z.hom)
    have hComm : ∀ a : Fin n, ι₀ a ≫ Z.hom = AlgebraicGeometry.Spec.map (ρ a) :=
      fun a => (AlgebraicGeometry.Spec.map_preimage (ι₀ a ≫ Z.hom)).symm
    have hFT : ∀ a : Fin n, ((ρ a).hom).FiniteType := by
      intro a
      have hLFT : AlgebraicGeometry.LocallyOfFiniteType (AlgebraicGeometry.Spec.map (ρ a)) := by
        rw [← hComm a]
        exact MorphismProperty.comp_mem @AlgebraicGeometry.LocallyOfFiniteType _ _
          inferInstance inferInstance
      exact (@AlgebraicGeometry.HasRingHomProperty.Spec_iff
        @AlgebraicGeometry.LocallyOfFiniteType _
        AlgebraicGeometry.instHasRingHomPropertyLocallyOfFiniteTypeFiniteType _ _ (ρ a)).mp hLFT
    have hSup : (⨆ a : Fin n, @AlgebraicGeometry.Scheme.Hom.opensRange _ _ (ι₀ a) (hOpen a)) = ⊤ := by
      apply eq_top_iff.mpr
      intro z hz
      have hz' : z ∈ (⨆ i ∈ S, (i : Z.left.Opens)) := by
        rw [← hS_eq]
        exact hz
      rw [TopologicalSpace.Opens.mem_iSup] at hz' ⊢
      obtain ⟨u, hz'⟩ := hz'
      rw [TopologicalSpace.Opens.mem_iSup] at hz'
      obtain ⟨huS, hzu⟩ := hz'
      refine ⟨e.symm ⟨u, huS⟩, ?_⟩
      have h_range : @AlgebraicGeometry.Scheme.Hom.opensRange _ _
          (ι₀ (e.symm ⟨u, huS⟩)) (hOpen (e.symm ⟨u, huS⟩)) = u.1 := by
        simp [ι₀, U, AlgebraicGeometry.IsAffineOpen.opensRange_fromSpec]
      rw [h_range]
      exact hzu
    exact ⟨n, R, ρ, ι₀, hOpen, hFT, hComm, hSup⟩

  
  have s3_pullback_spec_tensor_openImmersion :
      ∀ (B₀ E R : Type u) [CommRing B₀] [CommRing E] [CommRing R]
        [Algebra B₀ E] [Algebra B₀ R]
        (Z Z_E : AlgebraicGeometry.Scheme.{u})
        (g : Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of B₀))
        (g_E : Z_E ⟶ AlgebraicGeometry.Spec (CommRingCat.of E))
        (q_E : Z_E ⟶ Z)
        (_hqE : CategoryTheory.IsPullback q_E g_E g
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀ E))))
        (ι₀ : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ Z)
        [AlgebraicGeometry.IsOpenImmersion ι₀]
        (_hι₀ : ι₀ ≫ g = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀ R))),
        ∃ (ι_E : AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct B₀ E R)) ⟶ Z_E)
          (hOpenE : AlgebraicGeometry.IsOpenImmersion ι_E),
          @AlgebraicGeometry.Scheme.Hom.opensRange _ _ ι_E hOpenE =
            (TopologicalSpace.Opens.map q_E.base).obj ι₀.opensRange ∧
          ι_E ≫ q_E =
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (Algebra.TensorProduct.includeRight (R := B₀) (A := E) (B := R)).toRingHom) ≫
              ι₀ ∧
          ι_E ≫ g_E =
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom (R := B₀) (A := E) (B := R))) := by
    intro B₀ E R _ _ _ _ _ Z Z_E g g_E q_E hqE ι₀ _ hι₀
    let U : Z.Opens := ι₀.opensRange
    let U_E : Z_E.Opens := (TopologicalSpace.Opens.map q_E.base).obj U
    let e₀ : AlgebraicGeometry.Spec (CommRingCat.of R) ≅ (U : AlgebraicGeometry.Scheme.{u}) :=
      ι₀.isoOpensRange
    have he₀ : e₀.hom ≫ U.ι = ι₀ := ι₀.isoOpensRange_hom_ι
    have hp_res : CategoryTheory.IsPullback (q_E ∣_ U) U_E.ι U.ι q_E :=
      AlgebraicGeometry.isPullback_morphismRestrict q_E U
    have hp_vert : CategoryTheory.IsPullback (q_E ∣_ U) (U_E.ι ≫ g_E) (U.ι ≫ g)
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀ E))) :=
      hp_res.paste_vert hqE
    have hp_e₀ : CategoryTheory.IsPullback e₀.inv (U.ι ≫ g)
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀ R))) (𝟙 _) := by
      refine CategoryTheory.IsPullback.of_horiz_isIso ⟨?_⟩
      rw [CategoryTheory.Category.comp_id]
      exact (Iso.inv_comp_eq e₀).mpr (by rw [← CategoryTheory.Category.assoc, he₀, hι₀])
    have hp_geom : CategoryTheory.IsPullback ((q_E ∣_ U) ≫ e₀.inv) (U_E.ι ≫ g_E)
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀ R)))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀ E))) := by
      simpa [CategoryTheory.Category.comp_id] using hp_vert.paste_horiz hp_e₀
    have hp_alg : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (Algebra.TensorProduct.includeRight (R := B₀) (A := E) (B := R)).toRingHom))
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom (R := B₀) (A := E) (B := R))))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀ R)))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀ E))) :=
      (AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _
        (CommRingCat.isPushout_tensorProduct B₀ E R)).flip
    let iso_E : AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct B₀ E R)) ≅
        (U_E : AlgebraicGeometry.Scheme.{u}) :=
      CategoryTheory.IsPullback.isoIsPullback _ _ hp_alg hp_geom
    let ι_E : AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct B₀ E R)) ⟶ Z_E :=
      iso_E.hom ≫ U_E.ι
    have hOpenE : AlgebraicGeometry.IsOpenImmersion ι_E :=
      MorphismProperty.comp_mem @AlgebraicGeometry.IsOpenImmersion _ _ inferInstance inferInstance
    have hRange : @AlgebraicGeometry.Scheme.Hom.opensRange _ _ ι_E hOpenE = U_E := by
      ext x
      change x ∈ Set.range (iso_E.hom ≫ U_E.ι).base ↔ x ∈ U_E
      rw [AlgebraicGeometry.Scheme.Hom.comp_base, TopCat.coe_comp, Set.range_comp,
        (ConcreteCategory.bijective_of_isIso iso_E.hom.base).2.range_eq, Set.image_univ,
        AlgebraicGeometry.Scheme.Opens.range_ι]
      rfl
    have hq : ι_E ≫ q_E =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (Algebra.TensorProduct.includeRight (R := B₀) (A := E) (B := R)).toRingHom) ≫
          ι₀ := by
      dsimp [ι_E]
      rw [CategoryTheory.Category.assoc, ← AlgebraicGeometry.morphismRestrict_ι q_E U]
      calc
        iso_E.hom ≫ (q_E ∣_ U) ≫ U.ι
          = (iso_E.hom ≫ ((q_E ∣_ U) ≫ e₀.inv)) ≫ (e₀.hom ≫ U.ι) := by
            simp [CategoryTheory.Category.assoc]
        _ = AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (Algebra.TensorProduct.includeRight (R := B₀) (A := E) (B := R)).toRingHom) ≫
              ι₀ := by
            rw [CategoryTheory.IsPullback.isoIsPullback_hom_fst _ _ hp_alg hp_geom, he₀]
    have hg : ι_E ≫ g_E =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom (R := B₀) (A := E) (B := R))) := by
      dsimp [ι_E]
      rw [CategoryTheory.Category.assoc]
      exact CategoryTheory.IsPullback.isoIsPullback_hom_snd _ _ hp_alg hp_geom
    exact ⟨ι_E, hOpenE, hRange, hq, hg⟩

  
  have s4_algebraic_descent_localized_ringHoms :
      ∀ {r s : ℕ}
        (A : Fin r → Type u) [∀ i, CommRing (A i)] [∀ i, Algebra ↥L₁ (A i)]
        (R : Fin s → Type u) [∀ b, CommRing (R b)] [∀ b, Algebra F (R b)]
        [∀ b, Algebra.FiniteType F (R b)]
        (q : Fin r → Fin s → ℕ)
        (h_bar : ∀ (i : Fin r) (b : Fin s),
          Fin (q i b) → TensorProduct ↥L₁ (AlgebraicClosure F) (A i))
        (_hSpan_bar : ∀ i : Fin r,
          Ideal.span (Set.range fun p : Σ b : Fin s, Fin (q i b) => h_bar i p.1 p.2) = ⊤)
        (θ_bar : ∀ (i : Fin r) (b : Fin s) (μ : Fin (q i b)),
          TensorProduct F (AlgebraicClosure F) (R b) →+* Localization.Away (h_bar i b μ))
        (_hθ_bar_alg : ∀ (i : Fin r) (b : Fin s) (μ : Fin (q i b)),
          (θ_bar i b μ).comp Algebra.TensorProduct.includeLeftRingHom =
            (algebraMap (TensorProduct ↥L₁ (AlgebraicClosure F) (A i))
              (Localization.Away (h_bar i b μ))).comp Algebra.TensorProduct.includeLeftRingHom),
        ∃ (L₀ : IntermediateField F (AlgebraicClosure F))
          (hLE : L₁ ≤ L₀)
          (_ : FiniteDimensional F ↥L₀),
          letI : Algebra ↥L₁ ↥L₀ := (IntermediateField.inclusion hLE).toRingHom.toAlgebra
          let ψ : ∀ i : Fin r,
              TensorProduct ↥L₁ ↥L₀ (A i) →+* TensorProduct ↥L₁ (AlgebraicClosure F) (A i) :=
            fun i => (Algebra.TensorProduct.map
              ({ toRingHom := algebraMap ↥L₀ (AlgebraicClosure F), commutes' := fun _ => rfl } :
                ↥L₀ →ₐ[↥L₁] AlgebraicClosure F)
              (AlgHom.id ↥L₁ (A i))).toRingHom
          ∃ (h₀ : ∀ (i : Fin r) (b : Fin s), Fin (q i b) → TensorProduct ↥L₁ ↥L₀ (A i))
            (θ₀ : ∀ (i : Fin r) (b : Fin s) (μ : Fin (q i b)),
              TensorProduct F ↥L₀ (R b) →+* Localization.Away (h₀ i b μ))
            (lam : ∀ (i : Fin r) (b : Fin s) (μ : Fin (q i b)),
              Localization.Away (h₀ i b μ) →+* Localization.Away (h_bar i b μ)),
            (∀ i b μ, ψ i (h₀ i b μ) = h_bar i b μ) ∧
            (∀ i : Fin r,
              Ideal.span (Set.range fun p : Σ b : Fin s, Fin (q i b) => h₀ i p.1 p.2) = ⊤) ∧
            (∀ i b μ,
              (θ₀ i b μ).comp Algebra.TensorProduct.includeLeftRingHom =
                (algebraMap (TensorProduct ↥L₁ ↥L₀ (A i))
                  (Localization.Away (h₀ i b μ))).comp Algebra.TensorProduct.includeLeftRingHom) ∧
            (∀ i b μ,
              (lam i b μ).comp (algebraMap (TensorProduct ↥L₁ ↥L₀ (A i)) (Localization.Away (h₀ i b μ))) =
                (algebraMap (TensorProduct ↥L₁ (AlgebraicClosure F) (A i))
                  (Localization.Away (h_bar i b μ))).comp (ψ i)) ∧
            (∀ i b μ,
              (lam i b μ).comp (θ₀ i b μ) =
                (θ_bar i b μ).comp (Algebra.TensorProduct.map L₀.val (AlgHom.id F (R b))).toRingHom) := by
    intro r s A _ _ R _ _ _ q h_bar hSpan_bar θ_bar hθ_bar_alg
    classical
    let k : Type u := AlgebraicClosure F
    have h_pres : ∀ b : Fin s, ∃ (t : ℕ) (π : MvPolynomial (Fin t) F →ₐ[F] R b),
        Function.Surjective π :=
      fun b => (Algebra.FiniteType.iff_quotient_mvPolynomial'' (R := F) (S := R b)).mp inferInstance
    choose t π_R hπ_surj using h_pres
    let gen : ∀ b : Fin s, Fin (t b) → R b := fun b τ => π_R b (MvPolynomial.X τ)
    let P : Fin r → Type := fun i => Σ b : Fin s, Fin (q i b)
    have h_bezout : ∀ i : Fin r, ∃ c : P i → TensorProduct ↥L₁ k (A i),
        ∑ p : P i, c p * h_bar i p.1 p.2 = 1 := by
      intro i
      have h1 : (1 : TensorProduct ↥L₁ k (A i)) ∈
          Ideal.span (Set.range fun p : P i => h_bar i p.1 p.2) := by
        rw [hSpan_bar i]; trivial
      exact Ideal.mem_span_range_iff_exists_fun.mp h1
    choose c_bar hc_bar using h_bezout
    let sec_pair := fun (i : Fin r) (b : Fin s) (μ : Fin (q i b)) (τ : Fin (t b)) =>
      IsLocalization.Away.sec (h_bar i b μ) (θ_bar i b μ ((1 : k) ⊗ₜ[F] gen b τ))
    let w_bar := fun i b μ τ => (sec_pair i b μ τ).1
    let e_exp := fun i b μ τ => (sec_pair i b μ τ).2
    let S_repr : ∀ {i : Fin r}, TensorProduct ↥L₁ k (A i) → Finset (k × A i) :=
      fun z => (TensorProduct.exists_finset (R := ↥L₁) z).choose
    have hS_repr : ∀ {i : Fin r} (z : TensorProduct ↥L₁ k (A i)),
        z = ∑ x ∈ S_repr z, x.1 ⊗ₜ[↥L₁] x.2 :=
      fun z => (TensorProduct.exists_finset (R := ↥L₁) z).choose_spec
    let k_supp : ∀ {i : Fin r}, TensorProduct ↥L₁ k (A i) → Finset k :=
      fun z => (S_repr z).image Prod.fst
    let S_hc : Finset k :=
      Finset.univ.biUnion fun i : Fin r =>
        Finset.univ.biUnion fun p : P i =>
          k_supp (h_bar i p.1 p.2) ∪ k_supp (c_bar i p)
    let S_w : Finset k :=
      Finset.univ.biUnion fun i : Fin r =>
        Finset.univ.biUnion fun b : Fin s =>
          Finset.univ.biUnion fun μ : Fin (q i b) =>
            Finset.univ.biUnion fun τ : Fin (t b) =>
              k_supp (w_bar i b μ τ)
    let S_fin : Finset k := S_hc ∪ S_w
    let L₀ : IntermediateField F k := L₁ ⊔ IntermediateField.adjoin F (S_fin : Set k)
    have hLE : L₁ ≤ L₀ := le_sup_left
    have : Finite ↥(S_fin : Set k) := S_fin.finite_toSet
    have : FiniteDimensional F ↥(IntermediateField.adjoin F (S_fin : Set k)) :=
      IntermediateField.finiteDimensional_adjoin fun x _ =>
        Algebra.IsIntegral.isIntegral (R := F) x
    have hFD₀ : FiniteDimensional F ↥L₀ :=
      IntermediateField.finiteDimensional_sup L₁ (IntermediateField.adjoin F (S_fin : Set k))
    refine ⟨L₀, hLE, hFD₀, ?_⟩
    letI : Algebra ↥L₁ ↥L₀ := (IntermediateField.inclusion hLE).toRingHom.toAlgebra
    let ψ : ∀ i : Fin r,
        TensorProduct ↥L₁ ↥L₀ (A i) →+* TensorProduct ↥L₁ k (A i) :=
      fun i => (Algebra.TensorProduct.map
        ({ toRingHom := algebraMap ↥L₀ k, commutes' := fun _ => rfl } :
          ↥L₀ →ₐ[↥L₁] k)
        (AlgHom.id ↥L₁ (A i))).toRingHom
    have hLE_adj : IntermediateField.adjoin F (S_fin : Set k) ≤ L₀ := le_sup_right
    have hS_sub : ∀ {x : k}, x ∈ (S_fin : Set k) → x ∈ L₀ :=
      fun hx => hLE_adj (IntermediateField.subset_adjoin F (S_fin : Set k) hx)
    let lift_elem : ∀ {i : Fin r} (z : TensorProduct ↥L₁ k (A i)),
        (k_supp z ⊆ S_fin) → TensorProduct ↥L₁ ↥L₀ (A i) :=
      fun {i} z hz =>
        ∑ x ∈ (S_repr z).attach,
          (⟨x.1.1, hS_sub (hz (Finset.mem_image_of_mem Prod.fst x.2))⟩ : ↥L₀) ⊗ₜ[↥L₁] x.1.2
    have h_lift_spec : ∀ {i : Fin r} (z : TensorProduct ↥L₁ k (A i)) (hz : k_supp z ⊆ S_fin),
        ψ i (lift_elem z hz) = z := by
      intro i z hz
      dsimp [lift_elem, ψ]
      rw [map_sum]
      conv_rhs => rw [hS_repr z, ← Finset.sum_attach (S_repr z)]
      refine Finset.sum_congr rfl fun x _ => ?_
      rfl
    have hh_sub : ∀ (i : Fin r) (b : Fin s) (μ : Fin (q i b)),
        k_supp (h_bar i b μ) ⊆ S_fin := by
      intro i b μ x hx
      refine Finset.mem_union_left _ ?_
      refine Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ _, ?_⟩
      exact Finset.mem_biUnion.mpr ⟨⟨b, μ⟩, Finset.mem_univ _, Finset.mem_union_left _ hx⟩
    have hc_sub : ∀ (i : Fin r) (p : P i),
        k_supp (c_bar i p) ⊆ S_fin := by
      intro i p x hx
      refine Finset.mem_union_left _ ?_
      refine Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ _, ?_⟩
      exact Finset.mem_biUnion.mpr ⟨p, Finset.mem_univ _, Finset.mem_union_right _ hx⟩
    have hw_sub : ∀ (i : Fin r) (b : Fin s) (μ : Fin (q i b)) (τ : Fin (t b)),
        k_supp (w_bar i b μ τ) ⊆ S_fin := by
      intro i b μ τ x hx
      refine Finset.mem_union_right _ ?_
      refine Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ _, ?_⟩
      refine Finset.mem_biUnion.mpr ⟨b, Finset.mem_univ _, ?_⟩
      refine Finset.mem_biUnion.mpr ⟨μ, Finset.mem_univ _, ?_⟩
      exact Finset.mem_biUnion.mpr ⟨τ, Finset.mem_univ _, hx⟩
    let h₀ : ∀ (i : Fin r) (b : Fin s), Fin (q i b) → TensorProduct ↥L₁ ↥L₀ (A i) :=
      fun i b μ => lift_elem (h_bar i b μ) (hh_sub i b μ)
    let c₀ : ∀ (i : Fin r), P i → TensorProduct ↥L₁ ↥L₀ (A i) :=
      fun i p => lift_elem (c_bar i p) (hc_sub i p)
    let w₀ : ∀ (i : Fin r) (b : Fin s) (μ : Fin (q i b)) (τ : Fin (t b)),
        TensorProduct ↥L₁ ↥L₀ (A i) :=
      fun i b μ τ => lift_elem (w_bar i b μ τ) (hw_sub i b μ τ)
    have h_eq : ∀ i b μ, ψ i (h₀ i b μ) = h_bar i b μ :=
      fun i b μ => h_lift_spec (h_bar i b μ) (hh_sub i b μ)
    have hc_eq : ∀ i p, ψ i (c₀ i p) = c_bar i p :=
      fun i p => h_lift_spec (c_bar i p) (hc_sub i p)
    have hw_eq : ∀ i b μ τ, ψ i (w₀ i b μ τ) = w_bar i b μ τ :=
      fun i b μ τ => h_lift_spec (w_bar i b μ τ) (hw_sub i b μ τ)
    let f_incl : ↥L₀ →ₗ[↥L₁] k :=
      { toFun := algebraMap ↥L₀ k
        map_add' := map_add (algebraMap ↥L₀ k)
        map_smul' := fun _ _ => rfl }
    have hψ_inj : ∀ i : Fin r, Function.Injective (ψ i) := by
      intro i
      have h_eq_rTensor : (ψ i : TensorProduct ↥L₁ ↥L₀ (A i) → TensorProduct ↥L₁ k (A i)) =
          LinearMap.rTensor (A i) f_incl := by
        funext z
        refine TensorProduct.inductionOn (motive := fun z =>
          ψ i z = LinearMap.rTensor (A i) f_incl z) z ?_ ?_
        · intro x a; rfl
        · intro z₁ z₂ h₁ h₂; simp [map_add, h₁, h₂]
      rw [h_eq_rTensor]
      exact Module.Flat.rTensor_preserves_injective_linearMap f_incl (algebraMap ↥L₀ k).injective
    have hSpan₀ : ∀ i : Fin r,
        Ideal.span (Set.range fun p : P i => h₀ i p.1 p.2) = ⊤ := by
      intro i
      rw [Ideal.eq_top_iff_one, Ideal.mem_span_range_iff_exists_fun]
      refine ⟨c₀ i, hψ_inj i ?_⟩
      rw [map_sum, map_one, ← hc_bar i]
      refine Finset.sum_congr rfl fun p _ => ?_
      rw [map_mul, hc_eq i p, h_eq i p.1 p.2]
    have h_sub_pow : ∀ i b μ,
        Submonoid.powers (h₀ i b μ) ≤
          (Submonoid.powers (h_bar i b μ)).comap (ψ i) := by
      intro i b μ
      refine Submonoid.powers_le.mpr ?_
      change ψ i (h₀ i b μ) ∈ Submonoid.powers (h_bar i b μ)
      rw [h_eq i b μ]
      exact Submonoid.mem_powers _
    let lam : ∀ (i : Fin r) (b : Fin s) (μ : Fin (q i b)),
        Localization.Away (h₀ i b μ) →+* Localization.Away (h_bar i b μ) :=
      fun i b μ => IsLocalization.map (Localization.Away (h_bar i b μ)) (ψ i) (h_sub_pow i b μ)
    have hlam_alg : ∀ i b μ,
        (lam i b μ).comp (algebraMap (TensorProduct ↥L₁ ↥L₀ (A i)) (Localization.Away (h₀ i b μ))) =
          (algebraMap (TensorProduct ↥L₁ k (A i))
            (Localization.Away (h_bar i b μ))).comp (ψ i) :=
      fun i b μ => IsLocalization.map_comp (h_sub_pow i b μ)
    have hlam_inj : ∀ i b μ, Function.Injective (lam i b μ) := by
      intro i b μ
      rw [RingHom.injective_iff_ker_eq_bot, eq_bot_iff]
      intro z hz_ker
      have hz : lam i b μ z = 0 := RingHom.mem_ker.mp hz_ker
      change z = 0
      obtain ⟨⟨x, s_pow⟩, hzs⟩ := IsLocalization.surj (Submonoid.powers (h₀ i b μ)) z
      have h_map_x : algebraMap (TensorProduct ↥L₁ k (A i)) (Localization.Away (h_bar i b μ))
          (ψ i x) = 0 := by
        have h1 : lam i b μ (z * algebraMap _ _ s_pow.1) = lam i b μ (algebraMap _ _ x) :=
          congrArg (lam i b μ) hzs
        rw [map_mul, hz, zero_mul] at h1
        have h2 := RingHom.congr_fun (hlam_alg i b μ) x
        dsimp at h2
        rw [h2] at h1
        exact h1.symm
      obtain ⟨⟨m_bar, N, rfl⟩, hm_eq⟩ :=
        (IsLocalization.map_eq_zero_iff (Submonoid.powers (h_bar i b μ))
          (Localization.Away (h_bar i b μ)) (ψ i x)).mp h_map_x
      have hx0 : h₀ i b μ ^ N * x = 0 := by
        apply hψ_inj i
        rw [map_mul, map_pow, h_eq i b μ, map_zero]
        exact hm_eq
      have hz_unit : (algebraMap _ (Localization.Away (h₀ i b μ)) (h₀ i b μ ^ N) * z) *
          algebraMap _ (Localization.Away (h₀ i b μ)) s_pow.1 = 0 := by
        rw [mul_assoc, hzs, ← map_mul, hx0, map_zero]
      have hu1 : IsUnit (algebraMap _ (Localization.Away (h₀ i b μ)) s_pow.1) :=
        IsLocalization.map_units (Localization.Away (h₀ i b μ)) s_pow
      have hu2 : IsUnit (algebraMap _ (Localization.Away (h₀ i b μ)) (h₀ i b μ ^ N)) :=
        IsLocalization.map_units (Localization.Away (h₀ i b μ))
          ⟨h₀ i b μ ^ N, Submonoid.pow_mem _ (Submonoid.mem_powers _) N⟩
      have hz1 : algebraMap _ (Localization.Away (h₀ i b μ)) (h₀ i b μ ^ N) * z = 0 :=
        hu1.mul_right_cancel (by rw [hz_unit, zero_mul])
      exact hu2.mul_left_cancel (by rw [hz1, mul_zero])
    have hθ_ex : ∀ (i : Fin r) (b : Fin s) (μ : Fin (q i b)),
        ∃ θ : TensorProduct F ↥L₀ (R b) →+* Localization.Away (h₀ i b μ),
          θ.comp Algebra.TensorProduct.includeLeftRingHom =
            (algebraMap (TensorProduct ↥L₁ ↥L₀ (A i))
              (Localization.Away (h₀ i b μ))).comp Algebra.TensorProduct.includeLeftRingHom ∧
          (lam i b μ).comp θ =
            (θ_bar i b μ).comp (Algebra.TensorProduct.map L₀.val (AlgHom.id F (R b))).toRingHom := by
      intro i b μ
      let Loc₀ := Localization.Away (h₀ i b μ)
      let Loc_bar := Localization.Away (h_bar i b μ)
      let α₀ : ↥L₀ →+* Loc₀ :=
        (algebraMap (TensorProduct ↥L₁ ↥L₀ (A i)) Loc₀).comp
          Algebra.TensorProduct.includeLeftRingHom
      let u₀ : Fin (t b) → Loc₀ := fun τ =>
        IsLocalization.mk' Loc₀ (w₀ i b μ τ)
          ⟨h₀ i b μ ^ e_exp i b μ τ, Submonoid.pow_mem _ (Submonoid.mem_powers _) _⟩
      let θ_poly : MvPolynomial (Fin (t b)) F →+* Loc₀ :=
        MvPolynomial.eval₂Hom (α₀.comp (algebraMap F ↥L₀)) u₀
      have h_poly_comm : (lam i b μ).comp θ_poly =
          (θ_bar i b μ).comp
            ((Algebra.TensorProduct.includeRight (R := F) (A := k) (B := R b)).toRingHom.comp
              (π_R b).toRingHom) := by
        apply MvPolynomial.ringHom_ext
        · intro c
          simp only [RingHom.comp_apply, θ_poly, MvPolynomial.eval₂Hom_C, α₀]
          have h1 := RingHom.congr_fun (hlam_alg i b μ)
            (Algebra.TensorProduct.includeLeftRingHom (algebraMap F ↥L₀ c))
          dsimp at h1
          rw [h1]
          have hψ_c : ψ i (Algebra.TensorProduct.includeLeftRingHom (algebraMap F ↥L₀ c)) =
              Algebra.TensorProduct.includeLeftRingHom (algebraMap F k c) := rfl
          rw [hψ_c]
          have h2 := RingHom.congr_fun (hθ_bar_alg i b μ) (algebraMap F k c)
          dsimp at h2
          rw [← h2]
          congr 1
          have h_comm_c : (π_R b).toRingHom (MvPolynomial.C c) = algebraMap F (R b) c :=
            (π_R b).commutes c
          rw [h_comm_c]
          exact Algebra.TensorProduct.tmul_one_eq_one_tmul (R := F) (A := k) (B := R b) c
        · intro τ
          simp only [RingHom.comp_apply, θ_poly, MvPolynomial.eval₂Hom_X']
          have h_u0_spec : u₀ τ * algebraMap (TensorProduct ↥L₁ ↥L₀ (A i)) Loc₀
              (h₀ i b μ ^ e_exp i b μ τ) =
              algebraMap (TensorProduct ↥L₁ ↥L₀ (A i)) Loc₀ (w₀ i b μ τ) :=
            IsLocalization.mk'_spec Loc₀ (w₀ i b μ τ)
              ⟨h₀ i b μ ^ e_exp i b μ τ, Submonoid.pow_mem _ (Submonoid.mem_powers _) _⟩
          have h_lam_u0 := congrArg (lam i b μ) h_u0_spec
          rw [map_mul] at h_lam_u0
          have hl1 := RingHom.congr_fun (hlam_alg i b μ) (h₀ i b μ ^ e_exp i b μ τ)
          have hl2 := RingHom.congr_fun (hlam_alg i b μ) (w₀ i b μ τ)
          dsimp at hl1 hl2
          rw [hl1, hl2, map_pow, h_eq i b μ, hw_eq i b μ τ] at h_lam_u0
          have h_sec := IsLocalization.Away.sec_spec (h_bar i b μ)
            (θ_bar i b μ ((1 : k) ⊗ₜ[F] gen b τ))
          have hu_bar : IsUnit (algebraMap (TensorProduct ↥L₁ k (A i)) Loc_bar
              (h_bar i b μ ^ e_exp i b μ τ)) :=
            IsLocalization.map_units Loc_bar
              ⟨h_bar i b μ ^ e_exp i b μ τ, Submonoid.pow_mem _ (Submonoid.mem_powers _) _⟩
          exact hu_bar.mul_right_cancel (h_lam_u0.trans h_sec.symm)
      have h_ker : ∀ y ∈ RingHom.ker (π_R b).toRingHom, θ_poly y = 0 := by
        intro y hy
        apply hlam_inj i b μ
        rw [map_zero]
        have hcy := RingHom.congr_fun h_poly_comm y
        simp only [RingHom.comp_apply] at hcy
        rw [hcy, RingHom.mem_ker.mp hy, map_zero, map_zero]
      let e_quot := RingHom.quotientKerEquivOfSurjective (hπ_surj b)
      let θ_R : R b →+* Loc₀ :=
        (Ideal.Quotient.lift (RingHom.ker (π_R b).toRingHom) θ_poly h_ker).comp
          e_quot.symm.toRingHom
      have hθ_R_π : ∀ y : MvPolynomial (Fin (t b)) F, θ_R (π_R b y) = θ_poly y := by
        intro y
        have he : e_quot.symm (π_R b y) = Ideal.Quotient.mk (RingHom.ker (π_R b).toRingHom) y := by
          apply e_quot.injective
          rw [RingEquiv.apply_symm_apply]
          rfl
