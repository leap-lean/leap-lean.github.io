        (u : ↥(weilSmoothCenterReesSubalg R' f a)),
        ∃ d : D, L_D d = toK_A u := by
    clear * -
    intro R' K' D _ _ _ _ _ L_D n f a toK_A hRatios
    let S := weilSmoothCenterReesSubalg R' f a
    let E : Subalgebra R' (Localization.Away (f a)) :=
      { carrier := {z | ∃ hz : z ∈ S, ∃ d : D, L_D d = toK_A ⟨z, hz⟩}
        mul_mem' := fun ⟨hx, d₁, h1⟩ ⟨hy, d₂, h2⟩ =>
          ⟨S.mul_mem hx hy, d₁ * d₂, by
