theorem weil_semistable_curve_pullback_snc_base (k : Type u) [Field k] (m : ℕ)
    (B : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (U_B : B.left.Opens)
    (hProjB : IsProjectiveOverField k B)
    (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (f : C ⟶ B) (n : ℕ) (τ : Fin n → (B ⟶ C))
    (hCurve : IsSemistablePointedCurveOver k f U_B n τ)
    (hProjC : IsProjectiveOverField k C)
    (B₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (Z_B₁ : Set B₁.left) (ψ : B₁ ⟶ B)
    (hIntB₁ : AlgebraicGeometry.IsIntegral B₁.left)
    (hProjB₁ : IsProjectiveOverField k B₁)
    (hSncB₁ : IsSncDivisorSupport k m B₁ Z_B₁)
    (hψ : IsGenFiniteEtaleAlterationOver k ψ)
    (hψBdry : ψ.left.base ⁻¹' ((U_B : Set B.left)ᶜ) ⊆ Z_B₁) :
    ∃ (U_B₁ : B₁.left.Opens)
      (C₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (f₁ : C₁ ⟶ B₁) (τ₁ : Fin n → (B₁ ⟶ C₁)) (ψ_C : C₁ ⟶ C),
      (U_B₁ : Set B₁.left) = Z_B₁ᶜ ∧
      Nonempty U_B₁ ∧
      AlgebraicGeometry.IsIntegral C₁.left ∧
      IsProjectiveOverField k C₁ ∧
      IsSemistablePointedCurveOver k f₁ U_B₁ n τ₁ ∧
      IsGenFiniteEtaleAlterationOver k ψ_C ∧
      ψ_C.left.base ⁻¹' (f.left.base ⁻¹' ((U_B : Set B.left)ᶜ) ∪
        ⋃ j : Fin n, Set.range (τ j).left.base) ⊆
        f₁.left.base ⁻¹' Z_B₁ ∪ ⋃ j : Fin n, Set.range (τ₁ j).left.base :=
by
  
  obtain ⟨r, D, ιD, hClosedD, _hIntD, _hPairwise, hZ_eq, hCharts⟩ := hSncB₁
  have hClosedZ : IsClosed Z_B₁ := by
    rw [hZ_eq]
    refine isClosed_iUnion_of_finite fun i => ?_
    have := hClosedD i
    exact (ιD i).isClosedEmbedding.isClosed_range
  let U_B₁ : B₁.left.Opens := ⟨Z_B₁ᶜ, hClosedZ.isOpen_compl⟩
  have hU_B₁ : Nonempty U_B₁ := by
    have : AlgebraicGeometry.IsIntegral B₁.left := hIntB₁
    have : IrreducibleSpace ↥B₁.left := AlgebraicGeometry.irreducibleSpace_of_isIntegral B₁.left
    obtain ⟨x₀⟩ := (inferInstance : Nonempty ↥B₁.left)
    obtain ⟨U, hAffU, hx₀U, ψ_U, hEt_U, _hOver_U, α, _hInj_α, hKer_U⟩ := hCharts x₀
    let R_U := B₁.left.presheaf.obj (Opposite.op U)
    have : IsDomain R_U :=
      @AlgebraicGeometry.IsIntegral.component_integral B₁.left hIntB₁ U ⟨⟨x₀, hx₀U⟩⟩
    let p₀ : AlgebraicGeometry.Spec R_U := ⟨⊥, Ideal.isPrime_bot⟩
    let u₀ : ↥U := hAffU.isoSpec.inv.base p₀
    have hu₀_spec : U.toSpecΓ.base u₀ = p₀ := by
      rw [← hAffU.isoSpec_hom]
      change (hAffU.isoSpec.inv ≫ hAffU.isoSpec.hom).base p₀ = p₀
      rw [hAffU.isoSpec.inv_hom_id]
      rfl
    refine ⟨⟨u₀.1, fun hmem => ?_⟩⟩
    rw [hZ_eq, Set.mem_iUnion] at hmem
    obtain ⟨i, d, hd_eq⟩ := hmem
    let W_i : (D i).Opens := (TopologicalSpace.Opens.map (ιD i).base).obj U
    have hdU : (ιD i).base d ∈ U := by
      rw [hd_eq]
      exact u₀.2
    have hi : Nonempty ↥W_i := ⟨⟨d, hdU⟩⟩
    have hnat := AlgebraicGeometry.Scheme.Opens.toSpecΓ_naturality (ιD i) U
    have hnat_pt :
        (W_i.toSpecΓ ≫ AlgebraicGeometry.Spec.map ((ιD i).app U)).base ⟨d, hdU⟩ =
        (((ιD i) ∣_ U) ≫ U.toSpecΓ).base ⟨d, hdU⟩ := by
      rw [hnat]
    have hres_pt : ((ιD i) ∣_ U).base ⟨d, hdU⟩ = u₀ := by
      apply Subtype.ext
      calc (((ιD i) ∣_ U).base ⟨d, hdU⟩).1
          = (((ιD i) ∣_ U) ≫ U.ι).base ⟨d, hdU⟩ := rfl
        _ = ((ιD i ⁻¹ᵁ U).ι ≫ ιD i).base ⟨d, hdU⟩ := by
            rw [AlgebraicGeometry.morphismRestrict_ι]
        _ = (ιD i).base d := rfl
        _ = u₀.1 := hd_eq
    have hmap_pt :
        (AlgebraicGeometry.Spec.map ((ιD i).app U)).base (W_i.toSpecΓ.base ⟨d, hdU⟩) = p₀ := by
      calc (AlgebraicGeometry.Spec.map ((ιD i).app U)).base (W_i.toSpecΓ.base ⟨d, hdU⟩)
          = (W_i.toSpecΓ ≫ AlgebraicGeometry.Spec.map ((ιD i).app U)).base ⟨d, hdU⟩ := rfl
        _ = (((ιD i) ∣_ U) ≫ U.toSpecΓ).base ⟨d, hdU⟩ := hnat_pt
        _ = U.toSpecΓ.base (((ιD i) ∣_ U).base ⟨d, hdU⟩) := rfl
        _ = U.toSpecΓ.base u₀ := by rw [hres_pt]
        _ = p₀ := hu₀_spec
    have hcomap_bot :
        Ideal.comap ((ιD i).app U).hom (W_i.toSpecΓ.base ⟨d, hdU⟩).asIdeal = ⊥ :=
      congrArg PrimeSpectrum.asIdeal hmap_pt
    have hker_le_bot : RingHom.ker ((ιD i).app U).hom ≤ ⊥ := by
      intro a ha
      rw [← hcomap_bot]
      change ((ιD i).app U).hom a ∈ (W_i.toSpecΓ.base ⟨d, hdU⟩).asIdeal
      rw [RingHom.mem_ker.mp ha]
      exact Ideal.zero_mem _
    rw [hKer_U i hi] at hker_le_bot
    have hψX_zero : ψ_U (MvPolynomial.X (α ⟨i, hi⟩)) = 0 := by
      have hmem_bot : ψ_U (MvPolynomial.X (α ⟨i, hi⟩)) ∈ (⊥ : Ideal R_U) :=
        hker_le_bot (Ideal.subset_span rfl)
      exact Ideal.mem_bot.mp hmem_bot
    let g_Et := U.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_U)
    have : AlgebraicGeometry.Etale g_Et := hEt_U
    have : AlgebraicGeometry.UniversallyOpen g_Et := AlgebraicGeometry.UniversallyOpen.of_flat g_Et
    have hOpenRange : IsOpen (Set.range g_Et.base) := g_Et.isOpenMap.isOpen_range
    have hDomPm : IsDomain (CommRingCat.of (MvPolynomial (Fin m) k)) :=
      inferInstanceAs (IsDomain (MvPolynomial (Fin m) k))
    have hGenBot :=
      @AlgebraicGeometry.genericPoint_eq_bot_of_affine
        (CommRingCat.of (MvPolynomial (Fin m) k)) hDomPm
    have hGenMem :
        genericPoint ↥(AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin m) k))) ∈
          Set.range g_Et.base := by
      rw [(genericPoint_spec
        ↥(AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin m) k)))).mem_open_set_iff
        hOpenRange]
      exact ⟨g_Et.base ⟨x₀, hx₀U⟩, trivial, ⟨x₀, hx₀U⟩, rfl⟩
    rw [hGenBot] at hGenMem
    obtain ⟨u₁, hu₁⟩ := hGenMem
    have hcomap_ψ_bot : Ideal.comap ψ_U (U.toSpecΓ.base u₁).asIdeal = ⊥ :=
      congrArg PrimeSpectrum.asIdeal hu₁
    have hX_mem_bot : MvPolynomial.X (α ⟨i, hi⟩) ∈ (⊥ : Ideal (MvPolynomial (Fin m) k)) := by
      rw [← hcomap_ψ_bot]
      change ψ_U (MvPolynomial.X (α ⟨i, hi⟩)) ∈ (U.toSpecΓ.base u₁).asIdeal
      rw [hψX_zero]
      exact Ideal.zero_mem _
    exact MvPolynomial.X_ne_zero (α ⟨i, hi⟩) (Ideal.mem_bot.mp hX_mem_bot)
  
  let C₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    CategoryTheory.Over.mk (CategoryTheory.Limits.pullback.snd f.left ψ.left ≫ B₁.hom)
  let f₁ : C₁ ⟶ B₁ :=
    CategoryTheory.Over.homMk (CategoryTheory.Limits.pullback.snd f.left ψ.left) rfl
  let ψ_C : C₁ ⟶ C :=
    CategoryTheory.Over.homMk (CategoryTheory.Limits.pullback.fst f.left ψ.left) (by
      dsimp [C₁]
      rw [← CategoryTheory.Over.w f, CategoryTheory.Limits.pullback.condition_assoc,
        CategoryTheory.Over.w ψ])
  have hτ_f : ∀ j : Fin n, (τ j).left ≫ f.left = 𝟙 B.left := fun j =>
    congrArg CategoryTheory.CommaMorphism.left (hCurve.2.2.2.2.2.2.1 j)
  let τ₁ : Fin n → (B₁ ⟶ C₁) := fun j =>
    CategoryTheory.Over.homMk
      (CategoryTheory.Limits.pullback.lift (ψ.left ≫ (τ j).left) (𝟙 B₁.left) (by
        rw [CategoryTheory.Category.assoc, hτ_f j, CategoryTheory.Category.comp_id,
          CategoryTheory.Category.id_comp]))
      (by
        dsimp [C₁]
        rw [CategoryTheory.Limits.pullback.lift_snd_assoc, CategoryTheory.Category.id_comp])
  have hPb : CategoryTheory.IsPullback ψ_C.left f₁.left f.left ψ.left :=
    CategoryTheory.IsPullback.of_hasPullback f.left ψ.left
  have hτ₁_f₁ : ∀ j : Fin n, τ₁ j ≫ f₁ = 𝟙 B₁ := by
    intro j
    ext1
    exact CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hτ₁_ψ : ∀ j : Fin n, τ₁ j ≫ ψ_C = ψ ≫ τ j := by
    intro j
    ext1
    exact CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hU_sub : (U_B₁ : Set B₁.left) ⊆ ψ.left.base ⁻¹' (U_B : Set B.left) := by
    intro b₁ hb₁
    by_contra hb₁_not
    have hb₁_Z : b₁ ∈ Z_B₁ := hψBdry hb₁_not
    exact hb₁ hb₁_Z
  
  have hCurve₁ : IsSemistablePointedCurveOver k f₁ U_B₁ n τ₁ :=
    weil_semistable_pointed_curve_pullback k U_B U_B₁ f ψ f₁ ψ_C n τ τ₁
      hCurve hPb hU_sub hτ₁_f₁ hτ₁_ψ
  have hIntC₁ : AlgebraicGeometry.IsIntegral C₁.left :=
    weil_semistable_curve_isIntegral_of_integral_base k U_B₁ f₁ n τ₁ hIntB₁ hU_B₁ hCurve₁
  have hProjC₁ : IsProjectiveOverField k C₁ :=
    weil_projectiveOverField_pullback k f ψ f₁ ψ_C hPb hProjB hProjC hProjB₁
  
  have hψ_C : IsGenFiniteEtaleAlterationOver k ψ_C := by
    obtain ⟨hProp_ψ, hSurj_ψ, U_ψ, hU_ψ, hFin_U, hEt_Uψ, hSurj_U⟩ := hψ
    have hProp_ψC : AlgebraicGeometry.IsProper ψ_C.left :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb.flip hProp_ψ
    have hSurj_ψC : AlgebraicGeometry.Surjective ψ_C.left :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb.flip hSurj_ψ
    let U_C : C.left.Opens := (TopologicalSpace.Opens.map f.left.base).obj U_ψ
    have hU_C : Nonempty U_C := by
      obtain ⟨⟨y, hy⟩⟩ := hU_ψ
      obtain ⟨c, rfl⟩ := hCurve.2.2.2.1.surj y
      exact ⟨⟨c, hy⟩⟩
    let W₁ : C₁.left.Opens := ψ_C.left ⁻¹ᵁ U_C
    have hPb_outer :
        CategoryTheory.IsPullback (ψ_C.left ∣_ U_C)
          (W₁.ι ≫ f₁.left)
          ((f.left ∣_ U_ψ) ≫ U_ψ.ι) ψ.left := by
      have hp := (AlgebraicGeometry.isPullback_morphismRestrict ψ_C.left U_C).paste_vert hPb
      rwa [← AlgebraicGeometry.morphismRestrict_ι f.left U_ψ] at hp
    have hPb_Uψ := AlgebraicGeometry.isPullback_morphismRestrict ψ.left U_ψ
    let g₁ := hPb_Uψ.lift ((ψ_C.left ∣_ U_C) ≫ (f.left ∣_ U_ψ))
      (W₁.ι ≫ f₁.left) (by
        rw [CategoryTheory.Category.assoc]
        exact hPb_outer.w)
    have hPb_res :
        CategoryTheory.IsPullback (ψ_C.left ∣_ U_C) g₁ (f.left ∣_ U_ψ) (ψ.left ∣_ U_ψ) := by
      refine CategoryTheory.IsPullback.of_bot ?_ ?_ hPb_Uψ
      · simpa [g₁, hPb_Uψ.lift_snd] using hPb_outer
      · exact (hPb_Uψ.lift_fst _ _ _).symm
    refine ⟨hProp_ψC, hSurj_ψC, U_C, hU_C, ?_, ?_, ?_⟩
    · exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_res.flip hFin_U
    · exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_res.flip hEt_Uψ
    · exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_res.flip hSurj_U
  
  refine ⟨U_B₁, C₁, f₁, τ₁, ψ_C, rfl, hU_B₁, hIntC₁, hProjC₁, hCurve₁, hψ_C, ?_⟩
  intro x₁ hx₁
  rcases hx₁ with hx₁_base | hx₁_sec
  · left
    apply hψBdry
    have hcomm_pt : f.left.base (ψ_C.left.base x₁) = ψ.left.base (f₁.left.base x₁) := by
      change (ψ_C.left ≫ f.left).base x₁ = (f₁.left ≫ ψ.left).base x₁
      rw [hPb.w]
    change ψ.left.base (f₁.left.base x₁) ∈ (U_B : Set B.left)ᶜ
    rw [← hcomm_pt]
    exact hx₁_base
  · right
    rw [Set.mem_iUnion] at hx₁_sec ⊢
    obtain ⟨j, b, hb⟩ := hx₁_sec
    have hPb_id : CategoryTheory.IsPullback ψ.left (𝟙 B₁.left) (𝟙 B.left) ψ.left :=
      CategoryTheory.IsPullback.of_vert_isIso ⟨by simp⟩
    have hτ₁_left : (τ₁ j).left ≫ f₁.left = 𝟙 B₁.left :=
      congrArg CategoryTheory.CommaMorphism.left (hτ₁_f₁ j)
    have hPb_sec : CategoryTheory.IsPullback ψ.left (τ₁ j).left (τ j).left ψ_C.left := by
      refine CategoryTheory.IsPullback.of_bot ?_ ?_ hPb
      · rwa [hτ₁_left, hτ_f j]
      · exact congrArg CategoryTheory.CommaMorphism.left (hτ₁_ψ j).symm
    obtain ⟨b₁, _hb₁_ψ, hb₁_τ⟩ :=
      AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hPb_sec b x₁ hb
    exact ⟨j, b₁, hb₁_τ⟩

theorem weil_idealSheaf_proj_chart_cocycle_generators (k : Type u) [Field k]
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hProjX : IsProjectiveOverField k X)
    (I : X.left.IdealSheafData)
    (hSupp : (I.support : Set X.left) ≠ Set.univ) :
    TopologicalSpace.NoetherianSpace ↥X.left ∧
    ∃ (m : ℕ) (U_cov : Fin m → X.left.affineOpens) (L : ℕ)
      (h : ∀ i : Fin m, Fin (L + 1) → ↑(X.left.presheaf.obj (Opposite.op (U_cov i).1))),
      (⨆ i : Fin m, (U_cov i).1) = ⊤ ∧
      (∀ i : Fin m, I.ideal (U_cov i) = Ideal.span (Set.range (h i))) ∧
      (∀ i j : Fin m,
        AlgebraicGeometry.IsAffineOpen ((U_cov i).1 ⊓ (U_cov j).1) ∧
        ∃ u : ↑(X.left.presheaf.obj (Opposite.op ((U_cov i).1 ⊓ (U_cov j).1))),
          IsUnit u ∧
          ∀ a : Fin (L + 1),
            X.left.presheaf.map (CategoryTheory.homOfLE inf_le_left).op (h i a) =
              u * X.left.presheaf.map (CategoryTheory.homOfLE inf_le_right).op (h j a)) :=
by
  rcases hProjX with ⟨M, ι_X, hCl_X⟩
  let S := MvPolynomial (Fin (M + 1)) k
  let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k
  let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
  have hX : ∀ i : Fin (M + 1), MvPolynomial.X i ∈ 𝒜 1 :=
    fun i => (MvPolynomial.mem_homogeneousSubmodule 1 (MvPolynomial.X i)).mpr
      (MvPolynomial.isHomogeneous_X k i)

  
  have hPadMem : ∀ (ν : Fin (M + 1)) (d D : ℕ), d ≤ D → ∀ (P : S), P ∈ 𝒜 (d • 1) →
      (MvPolynomial.X ν) ^ (D - d) * P ∈ 𝒜 (D • 1) := by
    intro ν d D hdD P hP
    have hPow : (MvPolynomial.X ν : S) ^ (D - d) ∈ 𝒜 ((D - d) • 1) :=
      SetLike.pow_mem_graded (D - d) (hX ν)
    have hMul : (MvPolynomial.X ν : S) ^ (D - d) * P ∈ 𝒜 ((D - d) • 1 + d • 1) :=
      SetLike.mul_mem_graded hPow hP
    have hDeg : (D - d) • (1 : ℕ) + d • 1 = D • 1 := by
      rw [← add_smul, Nat.sub_add_cancel hdD]
    rwa [hDeg] at hMul

  have hCrossShift : ∀ (ν l : Fin (M + 1)) (d : ℕ) (P : S) (hP : P ∈ 𝒜 (d • 1)),
      (HomogeneousLocalization.awayMap 𝒜 (hX ν) rfl
        (HomogeneousLocalization.Away.isLocalizationElem (hX l) (hX ν))) ^ d *
        HomogeneousLocalization.awayMap 𝒜 (hX l) (mul_comm (MvPolynomial.X l) (MvPolynomial.X ν))
          (HomogeneousLocalization.Away.mk 𝒜 (hX ν) d P hP) =
        HomogeneousLocalization.awayMap 𝒜 (hX ν) rfl
          (HomogeneousLocalization.Away.mk 𝒜 (hX l) d P hP) := by
    intro ν l d P hP
    simp only [HomogeneousLocalization.Away.isLocalizationElem, HomogeneousLocalization.awayMap_mk]
    apply HomogeneousLocalization.val_injective
    simp only [HomogeneousLocalization.Away.mk, HomogeneousLocalization.val_mul,
      HomogeneousLocalization.val_pow, HomogeneousLocalization.val_mk,
      Localization.mk_pow, Localization.mk_mul]
    rw [Localization.mk_eq_mk_iff, Localization.r_iff_exists]
    refine ⟨1, ?_⟩
    simp only [OneMemClass.coe_one, Submonoid.coe_mul, SubmonoidClass.coe_pow]
    ring

  have hHomeRec : ∀ (ν : Fin (M + 1)) (d D : ℕ), d ≤ D →
      ∀ (P : S) (hP : P ∈ 𝒜 (d • 1)) (hF : (MvPolynomial.X ν) ^ (D - d) * P ∈ 𝒜 (D • 1)),
        HomogeneousLocalization.Away.mk 𝒜 (hX ν) D ((MvPolynomial.X ν) ^ (D - d) * P) hF =
          HomogeneousLocalization.Away.mk 𝒜 (hX ν) d P hP := by
    intro ν d D hdD P hP hF
    apply HomogeneousLocalization.val_injective
    simp only [HomogeneousLocalization.Away.mk, HomogeneousLocalization.val_mk]
    rw [Localization.mk_eq_mk_iff, Localization.r_iff_exists]
    refine ⟨1, ?_⟩
    simp only [OneMemClass.coe_one, one_mul]
    rw [← mul_assoc, ← pow_add, Nat.add_sub_of_le hdD]

  have hOffFact : ∀ (ν i : Fin (M + 1)) (d e D : ℕ), e + d ≤ D →
      ∀ (P : S) (hP : P ∈ 𝒜 (d • 1)) (hF : (MvPolynomial.X ν) ^ (D - d) * P ∈ 𝒜 (D • 1)),
        HomogeneousLocalization.Away.mk 𝒜 (hX i) D ((MvPolynomial.X ν) ^ (D - d) * P) hF =
          (HomogeneousLocalization.Away.isLocalizationElem (hX i) (hX ν)) ^ (D - (e + d)) *
            ((HomogeneousLocalization.Away.isLocalizationElem (hX i) (hX ν)) ^ e *
              HomogeneousLocalization.Away.mk 𝒜 (hX i) d P hP) := by
    intro ν i d e D heD P hP hF
    have hExp1 : (D - (e + d)) + e = D - d := by omega
    have hExp2 : (D - (e + d)) + (e + d) = D := by omega
    apply HomogeneousLocalization.val_injective
    simp only [HomogeneousLocalization.Away.isLocalizationElem, HomogeneousLocalization.Away.mk,
      HomogeneousLocalization.val_mul, HomogeneousLocalization.val_pow,
      HomogeneousLocalization.val_mk, Localization.mk_pow, Localization.mk_mul]
    rw [Localization.mk_eq_mk_iff, Localization.r_iff_exists]
    refine ⟨1, ?_⟩
    simp only [OneMemClass.coe_one, Submonoid.coe_mul, SubmonoidClass.coe_pow, pow_one, one_mul]
    have hNum : (MvPolynomial.X ν : S) ^ (D - (e + d)) * ((MvPolynomial.X ν : S) ^ e * P) =
        (MvPolynomial.X ν : S) ^ (D - d) * P := by
      rw [← mul_assoc, ← pow_add, hExp1]
    have hDen : (MvPolynomial.X i : S) ^ (D - (e + d)) *
        ((MvPolynomial.X i : S) ^ e * (MvPolynomial.X i : S) ^ d) =
        (MvPolynomial.X i : S) ^ D := by
      rw [← pow_add, ← pow_add, hExp2]
    rw [hNum, hDen]

  have hUnitCocycle : ∀ (i j : Fin (M + 1)) (D : ℕ),
      ∃ u₀ : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i * MvPolynomial.X j),
        IsUnit u₀ ∧
        ∀ (F : S) (hF : F ∈ 𝒜 (D • 1)),
          HomogeneousLocalization.awayMap 𝒜 (hX j) rfl
            (HomogeneousLocalization.Away.mk 𝒜 (hX i) D F hF) =
            u₀ * HomogeneousLocalization.awayMap 𝒜 (hX i)
              (mul_comm (MvPolynomial.X i) (MvPolynomial.X j))
              (HomogeneousLocalization.Away.mk 𝒜 (hX j) D F hF) := by
    intro i j D
    let w_ij : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i * MvPolynomial.X j) :=
      HomogeneousLocalization.awayMap 𝒜 (hX j) rfl
        (HomogeneousLocalization.Away.isLocalizationElem (hX i) (hX j))
    let w_ji : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i * MvPolynomial.X j) :=
      HomogeneousLocalization.awayMap 𝒜 (hX i) (mul_comm (MvPolynomial.X i) (MvPolynomial.X j))
        (HomogeneousLocalization.Away.isLocalizationElem (hX j) (hX i))
    have hw_inv : w_ij * w_ji = 1 := by
      simp only [w_ij, w_ji, HomogeneousLocalization.awayMap_mk]
      apply HomogeneousLocalization.val_injective
      simp only [HomogeneousLocalization.Away.mk, HomogeneousLocalization.val_mul,
        HomogeneousLocalization.val_one, HomogeneousLocalization.val_mk,
        Localization.mk_mul, ← Localization.mk_one]
      rw [Localization.mk_eq_mk_iff, Localization.r_iff_exists]
      refine ⟨1, ?_⟩
      simp only [OneMemClass.coe_one, Submonoid.coe_mul]
      ring
    have hw_unit : IsUnit w_ij := isUnit_iff_exists_inv.mpr ⟨w_ji, hw_inv⟩
    refine ⟨w_ij ^ D, hw_unit.pow D, ?_⟩
    intro F hF
    simp only [w_ij, HomogeneousLocalization.awayMap_mk]
    apply HomogeneousLocalization.val_injective
    simp only [HomogeneousLocalization.Away.mk, HomogeneousLocalization.val_mul,
      HomogeneousLocalization.val_pow, HomogeneousLocalization.val_mk,
      Localization.mk_pow, Localization.mk_mul]
    rw [Localization.mk_eq_mk_iff, Localization.r_iff_exists]
    refine ⟨1, ?_⟩
    simp only [OneMemClass.coe_one, Submonoid.coe_mul, SubmonoidClass.coe_pow]
    ring

  
  let P := AlgebraicGeometry.Proj 𝒜
  let ι : X.left ⟶ P := ι_X.left
  have _ : AlgebraicGeometry.IsClosedImmersion ι := hCl_X

  have _ : AlgebraicGeometry.IsLocallyNoetherian X.left := by
    let _ : IsScalarTower k ↥(𝒜 0) S :=
      ⟨fun c a p => smul_mul_assoc c a.1 p⟩
    have _ : Algebra.FiniteType ↥(𝒜 0) S :=
      Algebra.FiniteType.of_restrictScalars_finiteType k ↥(𝒜 0) S
    have hSurj0 : Function.Surjective (algebraMap k ↥(𝒜 0)) := by
      rintro ⟨p, hp⟩
      change p ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k 0 at hp
      rw [MvPolynomial.homogeneousSubmodule_zero, Submodule.mem_one] at hp
      rcases hp with ⟨c, rfl⟩
      refine ⟨c, Subtype.ext ?_⟩
      rw [Algebra.algebraMap_eq_smul_one]
      change c • (1 : S) = (algebraMap k S) c
      exact (Algebra.algebraMap_eq_smul_one c).symm
    have _ : IsNoetherianRing ↥(𝒜 0) := isNoetherianRing_of_surjective k ↥(𝒜 0) _ hSurj0
    have _ : AlgebraicGeometry.IsLocallyNoetherian
        (AlgebraicGeometry.Spec (CommRingCat.of ↥(𝒜 0))) := inferInstance
    have _ : AlgebraicGeometry.IsLocallyNoetherian P :=
      AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian
        (AlgebraicGeometry.Proj.toSpecZero 𝒜)
    exact AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian ι

  have hIrrel : (HomogeneousIdeal.irrelevant 𝒜).toIdeal ≤
      Ideal.span (Set.range (MvPolynomial.X : Fin (M + 1) → S)) := by
    classical
    intro p hp
    have hp0 : GradedRing.proj 𝒜 0 p = 0 := (HomogeneousIdeal.mem_irrelevant_iff 𝒜 p).mp hp
    have hConst0 : MvPolynomial.constantCoeff p = 0 := by
      have hDecomp : p = ∑ d ∈ (DirectSum.decompose 𝒜 p).support,
          (DirectSum.decompose 𝒜 p d : MvPolynomial (Fin (M + 1)) k) :=
        (DirectSum.sum_support_decompose 𝒜 p).symm
      rw [hDecomp, map_sum]
      refine Finset.sum_eq_zero fun d hd => ?_
      by_cases hd0 : d = 0
      · subst hd0
        change MvPolynomial.constantCoeff (GradedRing.proj 𝒜 0 p) = 0
        rw [hp0, map_zero]
      · have hHomog : MvPolynomial.IsHomogeneous (DirectSum.decompose 𝒜 p d : S) d :=
          (MvPolynomial.mem_homogeneousSubmodule d _).mp (DirectSum.decompose 𝒜 p d).2
        rw [MvPolynomial.constantCoeff_eq]
        by_contra hNe
        have hW := hHomog hNe
        simp only [map_zero] at hW
        exact hd0 hW.symm
    rw [MvPolynomial.constantCoeff_eq] at hConst0
    rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
    intro m hm
    have hm_ne : m ≠ 0 := by
      intro hm0
      rw [hm0] at hm
      exact (MvPolynomial.mem_support_iff.mp hm) hConst0
    obtain ⟨j, hj⟩ := Finsupp.ne_iff.mp hm_ne
    exact ⟨j, Set.mem_univ j, hj⟩

  let V : Fin (M + 1) → P.Opens := fun i => AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X i)
  have hAffV : ∀ i : Fin (M + 1), AlgebraicGeometry.IsAffineOpen (V i) :=
    fun i => AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜 (MvPolynomial.X i) (hX i) zero_lt_one
  let U_cov : Fin (M + 1) → X.left.affineOpens :=
    fun i => ⟨(TopologicalSpace.Opens.map ι.base).obj (V i), (hAffV i).preimage ι⟩

  have hCovP : (⨆ i : Fin (M + 1), V i) = ⊤ :=
    AlgebraicGeometry.Proj.iSup_basicOpen_eq_top 𝒜 MvPolynomial.X hIrrel
  have hCov : (⨆ i : Fin (M + 1), (U_cov i).1) = ⊤ := by
    rw [eq_top_iff]
    intro x _
    have hxP : ι.base x ∈ (⨆ i : Fin (M + 1), V i) := by
      rw [hCovP]
      trivial
    rw [TopologicalSpace.Opens.mem_iSup] at hxP ⊢
    rcases hxP with ⟨i, hi⟩
    exact ⟨i, hi⟩

  have hNoethSpace : TopologicalSpace.NoetherianSpace ↥X.left := by
    have hCompactUniv : IsCompact (Set.univ : Set ↥X.left) := by
      have hUnivEq : (Set.univ : Set ↥X.left) = ⋃ i : Fin (M + 1), ((U_cov i).1 : Set ↥X.left) := by
        ext x
        simp only [Set.mem_univ, Set.mem_iUnion, SetLike.mem_coe, true_iff]
        have hx : x ∈ (⨆ i : Fin (M + 1), (U_cov i).1) := by
          rw [hCov]
          trivial
        exact TopologicalSpace.Opens.mem_iSup.mp hx
      rw [hUnivEq]
      exact isCompact_iUnion fun i => (U_cov i).2.isCompact
    have _ : CompactSpace ↥X.left := ⟨hCompactUniv⟩
    have _ : AlgebraicGeometry.IsNoetherian X.left := {}
    exact AlgebraicGeometry.IsNoetherian.noetherianSpace

  refine ⟨hNoethSpace, ?_⟩

  let Φ : ∀ i : Fin (M + 1),
      CommRingCat.of (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i)) ⟶
        X.left.presheaf.obj (Opposite.op (U_cov i).1) :=
    fun i => AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X i) ≫
      ι.appLE (V i) (U_cov i).1 le_rfl
  let q : ∀ i : Fin (M + 1),
      HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i) →+*
        ↑(X.left.presheaf.obj (Opposite.op (U_cov i).1)) :=
    fun i => (Φ i).hom

  have hq_surj : ∀ i : Fin (M + 1), Function.Surjective (q i) := by
    intro i
    have hAppEq : ι.appLE (V i) (U_cov i).1 le_rfl = ι.app (V i) :=
      AlgebraicGeometry.Scheme.Hom.appLE_eq_app ι
    have hAppSurj : Function.Surjective (ι.appLE (V i) (U_cov i).1 le_rfl).hom := by
      rw [hAppEq]
      exact AlgebraicGeometry.Scheme.Hom.app_surjective ι (V i) (hAffV i)
    let iso_i := AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜 (MvPolynomial.X i) (hX i) zero_lt_one
    have hIsoEq : AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X i) = iso_i.hom :=
      (AlgebraicGeometry.Proj.basicOpenIsoAway_hom 𝒜 (MvPolynomial.X i) (hX i) zero_lt_one).symm
    have hAwaySurj : Function.Surjective
        (AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X i)).hom := by
      rw [hIsoEq]
      intro y
      exact ⟨iso_i.inv.hom y, CategoryTheory.ConcreteCategory.congr_hom iso_i.inv_hom_id y⟩
    exact hAppSurj.comp hAwaySurj

  have hXij : ∀ i j : Fin (M + 1), MvPolynomial.X i * MvPolynomial.X j ∈ 𝒜 2 :=
    fun i j => SetLike.mul_mem_graded (hX i) (hX j)
  have hV_ij : ∀ i j : Fin (M + 1),
      AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X i * MvPolynomial.X j) = V i ⊓ V j :=
    fun i j => AlgebraicGeometry.Proj.basicOpen_mul 𝒜 (MvPolynomial.X i) (MvPolynomial.X j)
  have hAffV_ij : ∀ i j : Fin (M + 1), AlgebraicGeometry.IsAffineOpen (V i ⊓ V j) :=
    fun i j => hV_ij i j ▸ AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜
      (MvPolynomial.X i * MvPolynomial.X j) (hXij i j) (by omega)
  have hAffOv : ∀ i j : Fin (M + 1), AlgebraicGeometry.IsAffineOpen ((U_cov i).1 ⊓ (U_cov j).1) :=
    fun i j => (hAffV_ij i j).preimage ι

  let Φ_ov : ∀ i j : Fin (M + 1),
      CommRingCat.of (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i * MvPolynomial.X j)) ⟶
        X.left.presheaf.obj (Opposite.op ((U_cov i).1 ⊓ (U_cov j).1)) :=
    fun i j =>
      AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X i * MvPolynomial.X j) ≫
        ι.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X i * MvPolynomial.X j))
          ((U_cov i).1 ⊓ (U_cov j).1) (by rw [hV_ij i j]; exact le_rfl)
  let φ_ov : ∀ i j : Fin (M + 1),
      HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i * MvPolynomial.X j) →+*
        ↑(X.left.presheaf.obj (Opposite.op ((U_cov i).1 ⊓ (U_cov j).1))) :=
    fun i j => (Φ_ov i j).hom

  have hResL : ∀ (i j : Fin (M + 1)) (z : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i)),
      X.left.presheaf.map (CategoryTheory.homOfLE inf_le_left).op (q i z) =
        φ_ov i j (HomogeneousLocalization.awayMap 𝒜 (hX j) rfl z) := by
    intro i j z
    have h1 : CommRingCat.ofHom (HomogeneousLocalization.awayMap 𝒜 (hX j) rfl) ≫ Φ_ov i j =
        Φ i ≫ X.left.presheaf.map (CategoryTheory.homOfLE inf_le_left).op := by
      dsimp only [Φ_ov, Φ]
      rw [AlgebraicGeometry.Proj.awayMap_awayToSection_assoc 𝒜 (hX j) rfl,
        AlgebraicGeometry.Scheme.Hom.map_appLE, Category.assoc,
        AlgebraicGeometry.Scheme.Hom.appLE_map]
    exact (CategoryTheory.ConcreteCategory.congr_hom h1 z).symm

  have hResR : ∀ (i j : Fin (M + 1)) (z : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X j)),
      X.left.presheaf.map (CategoryTheory.homOfLE inf_le_right).op (q j z) =
        φ_ov i j (HomogeneousLocalization.awayMap 𝒜 (hX i)
          (mul_comm (MvPolynomial.X i) (MvPolynomial.X j)) z) := by
    intro i j z
    have h1 : CommRingCat.ofHom (HomogeneousLocalization.awayMap 𝒜 (hX i)
          (mul_comm (MvPolynomial.X i) (MvPolynomial.X j))) ≫ Φ_ov i j =
        Φ j ≫ X.left.presheaf.map (CategoryTheory.homOfLE inf_le_right).op := by
      dsimp only [Φ_ov, Φ]
      rw [AlgebraicGeometry.Proj.awayMap_awayToSection_assoc 𝒜 (hX i)
        (mul_comm (MvPolynomial.X i) (MvPolynomial.X j)),
        AlgebraicGeometry.Scheme.Hom.map_appLE, Category.assoc,
        AlgebraicGeometry.Scheme.Hom.appLE_map]
    exact (CategoryTheory.ConcreteCategory.congr_hom h1 z).symm

  have hBasicLe : ∀ i j : Fin (M + 1),
      X.left.basicOpen (q i (HomogeneousLocalization.Away.isLocalizationElem (hX i) (hX j))) ≤
        (U_cov i).1 ⊓ (U_cov j).1 := by
    intro i j
    refine le_inf (X.left.basicOpen_le _) ?_
    let u_ji := HomogeneousLocalization.Away.isLocalizationElem (hX i) (hX j)
    let s_ij := (AlgebraicGeometry.Proj.awayToSection 𝒜 (MvPolynomial.X i)).hom u_ji
    have hAppEq : ι.appLE (V i) (U_cov i).1 le_rfl = ι.app (V i) :=
      AlgebraicGeometry.Scheme.Hom.appLE_eq_app ι
    have hqEq : q i u_ji = (ι.app (V i)).hom s_ij := by
      dsimp only [q, Φ, s_ij]
      rw [hAppEq]
      rfl
    have hPre : X.left.basicOpen (q i u_ji) =
        (TopologicalSpace.Opens.map ι.base).obj (P.basicOpen s_ij) := by
      rw [hqEq]
      exact (AlgebraicGeometry.Scheme.Hom.preimage_basicOpen ι s_ij).symm
    rw [hPre]
    refine (TopologicalSpace.Opens.map ι.base).monotone ?_
    intro p hp
    have hp_i : p ∈ V i := P.basicOpen_le s_ij hp
    have hXi_not_mem : MvPolynomial.X i ∉ p.asHomogeneousIdeal :=
      (AlgebraicGeometry.Proj.mem_basicOpen 𝒜 (MvPolynomial.X i) p).mp hp_i
    rw [AlgebraicGeometry.Proj.mem_basicOpen 𝒜 (MvPolynomial.X j) p]
    intro hXj_mem
    have hUnitSec : IsUnit (P.presheaf.map (CategoryTheory.homOfLE (P.basicOpen_le s_ij)).op s_ij) :=
      P.toRingedSpace.isUnit_res_basicOpen s_ij
    have _ : p.asHomogeneousIdeal.toIdeal.IsPrime := p.isPrime
    let evalAtP : ↑(P.presheaf.obj (Opposite.op (P.basicOpen s_ij))) →+*
        Localization p.asHomogeneousIdeal.toIdeal.primeCompl :=
      { toFun := fun t => (t.1 ⟨p, hp⟩).val
        map_one' := HomogeneousLocalization.val_one
        map_mul' := fun x y => HomogeneousLocalization.val_mul _ _
        map_zero' := HomogeneousLocalization.val_zero
        map_add' := fun x y => HomogeneousLocalization.val_add _ _ }
    have hUnitLoc : IsUnit (evalAtP
        (P.presheaf.map (CategoryTheory.homOfLE (P.basicOpen_le s_ij)).op s_ij)) :=
      hUnitSec.map evalAtP
    have hEvalEq : evalAtP
        (P.presheaf.map (CategoryTheory.homOfLE (P.basicOpen_le s_ij)).op s_ij) =
        Localization.mk (MvPolynomial.X j) ⟨MvPolynomial.X i, hXi_not_mem⟩ := by
      change (s_ij.1 ⟨p, hp_i⟩).val = _
      refine (AlgebraicGeometry.ProjectiveSpectrum.Proj.awayToSection_apply
        𝒜 (MvPolynomial.X i) u_ji ⟨p, hp_i⟩).trans ?_
      simp only [u_ji, HomogeneousLocalization.Away.mk, HomogeneousLocalization.val_mk,
        Localization.mk_eq_mk', IsLocalization.map_mk', RingHom.id_apply, pow_one]
    rw [hEvalEq] at hUnitLoc
    obtain ⟨inv, hInv⟩ := isUnit_iff_exists_inv.mp hUnitLoc
    induction inv using Localization.induction_on with
    | H data =>
      rcases data with ⟨a, b, hb⟩
      rw [Localization.mk_mul, ← Localization.mk_one, Localization.mk_eq_mk_iff,
        Localization.r_iff_exists] at hInv
      rcases hInv with ⟨⟨c, hc⟩, hcEq⟩
      simp only [OneMemClass.coe_one, Submonoid.coe_mul, mul_one, one_mul] at hcEq
      have hLhsMem : c * (MvPolynomial.X j * a) ∈ p.asHomogeneousIdeal.toIdeal :=
        Ideal.mul_mem_left _ c (Ideal.mul_mem_right a _ hXj_mem)
      have hRhsMem : c * (MvPolynomial.X i * b) ∈ p.asHomogeneousIdeal.toIdeal :=
        hcEq ▸ hLhsMem
      rcases p.isPrime.mul_mem_iff_mem_or_mem.mp hRhsMem with hc_mem | hXib_mem
      · exact hc hc_mem
      · rcases p.isPrime.mul_mem_iff_mem_or_mem.mp hXib_mem with hXi_mem | hb_mem
        · exact hXi_not_mem hXi_mem
        · exact hb hb_mem

  
  have hNonBot : ∃ i₀ : Fin (M + 1), I.ideal (U_cov i₀) ≠ ⊥ := by
    have hx₀_ex : ∃ x₀ : X.left, x₀ ∉ (I.support : Set X.left) := by
      by_contra! hAll
      exact hSupp (Set.eq_univ_of_forall hAll)
    obtain ⟨x₀, hx₀_not_supp⟩ := hx₀_ex
    have hx₀_cov : x₀ ∈ (⨆ i : Fin (M + 1), (U_cov i).1) := by
      rw [hCov]
      trivial
    rw [TopologicalSpace.Opens.mem_iSup] at hx₀_cov
    rcases hx₀_cov with ⟨i₀, hx₀_U⟩
    refine ⟨i₀, fun hBot => hx₀_not_supp ?_⟩
    change x₀ ∈ I.support
    rw [AlgebraicGeometry.Scheme.IdealSheafData.mem_support_iff_of_mem hx₀_U, hBot,
      AlgebraicGeometry.Scheme.zeroLocus_def]
    simp only [Set.mem_iInter, Set.mem_compl_iff, SetLike.mem_coe]
    intro g hg
    rw [Ideal.mem_bot.mp hg]
    intro hx₀_zero
    have hZeroOpen :
        X.left.basicOpen (0 : ↑(X.left.presheaf.obj (Opposite.op (U_cov i₀).1))) = ⊥ :=
      X.left.toLocallyRingedSpace.basicOpen_zero (U_cov i₀).1
    rw [hZeroOpen] at hx₀_zero
    exact hx₀_zero

  have hClear : ∀ (U V_aff : X.left.affineOpens)
      (f z_U : ↑(X.left.presheaf.obj (Opposite.op U.1)))
      (g_V : ↑(X.left.presheaf.obj (Opposite.op V_aff.1)))
      (d : ℕ),
      X.left.basicOpen f ≤ U.1 ⊓ V_aff.1 →
      g_V ∈ I.ideal V_aff →
      (X.left.presheaf.map (CategoryTheory.homOfLE inf_le_left).op f) ^ d *
          X.left.presheaf.map (CategoryTheory.homOfLE inf_le_right).op g_V =
        X.left.presheaf.map (CategoryTheory.homOfLE inf_le_left).op z_U →
      ∃ e : ℕ, f ^ e * z_U ∈ I.ideal U := by
    intro U V_aff f z_U g_V d hf hg_V hEq
    let B_f : X.left.affineOpens := X.left.affineBasicOpen f
    have hBf_le : B_f.1 ≤ U.1 ⊓ V_aff.1 := hf
    have hBU : B_f ≤ U := show B_f.1 ≤ U.1 from le_trans hBf_le inf_le_left
    have hBV : B_f ≤ V_aff := show B_f.1 ≤ V_aff.1 from le_trans hBf_le inf_le_right
    have hEqB := congrArg (X.left.presheaf.map (CategoryTheory.homOfLE hBf_le).op) hEq
    simp only [map_mul, map_pow] at hEqB
    have hCompL : ∀ (x : ↑(X.left.presheaf.obj (Opposite.op U.1))),
        X.left.presheaf.map (CategoryTheory.homOfLE hBf_le).op
          (X.left.presheaf.map (CategoryTheory.homOfLE inf_le_left).op x) =
          X.left.presheaf.map (CategoryTheory.homOfLE hBU).op x := by
      intro x
      rw [← CategoryTheory.ConcreteCategory.comp_apply, ← X.left.presheaf.map_comp, ← op_comp]
      rfl
    have hCompR : ∀ (y : ↑(X.left.presheaf.obj (Opposite.op V_aff.1))),
        X.left.presheaf.map (CategoryTheory.homOfLE hBf_le).op
          (X.left.presheaf.map (CategoryTheory.homOfLE inf_le_right).op y) =
          X.left.presheaf.map (CategoryTheory.homOfLE hBV).op y := by
      intro y
      rw [← CategoryTheory.ConcreteCategory.comp_apply, ← X.left.presheaf.map_comp, ← op_comp]
      rfl
    have hEqB' : (X.left.presheaf.map (CategoryTheory.homOfLE hBU).op f) ^ d *
        X.left.presheaf.map (CategoryTheory.homOfLE hBV).op g_V =
        X.left.presheaf.map (CategoryTheory.homOfLE hBU).op z_U := by
      have h1 := hEqB
      rw [hCompL f, hCompR g_V, hCompL z_U] at h1
      exact h1
    have hg_B : X.left.presheaf.map (CategoryTheory.homOfLE hBV).op g_V ∈ I.ideal B_f := by
      rw [← AlgebraicGeometry.Scheme.IdealSheafData.map_ideal I hBV]
      exact Ideal.mem_map_of_mem _ hg_V
    have hz_B : X.left.presheaf.map (CategoryTheory.homOfLE hBU).op z_U ∈ I.ideal B_f :=
      hEqB' ▸ Ideal.mul_mem_left _ _ hg_B
    rw [← AlgebraicGeometry.Scheme.IdealSheafData.map_ideal_basicOpen I U f] at hz_B
    let _ : Algebra ↑(X.left.presheaf.obj (Opposite.op U.1))
        ↑(X.left.presheaf.obj (Opposite.op (X.left.basicOpen f))) :=
      (X.left.presheaf.map (CategoryTheory.homOfLE (X.left.basicOpen_le f)).op).hom.toAlgebra
    have _ : IsLocalization.Away f
        ↑(X.left.presheaf.obj (Opposite.op (X.left.basicOpen f))) :=
      U.2.isLocalization_basicOpen f
    obtain ⟨m, hm_pow, hm_mem⟩ :=
      (IsLocalization.algebraMap_mem_map_algebraMap_iff (Submonoid.powers f)
        ↑(X.left.presheaf.obj (Opposite.op (X.left.basicOpen f))) (I.ideal U) z_U).mp hz_B
    rcases hm_pow with ⟨e, rfl⟩
    exact ⟨e, hm_mem⟩

  
  have hExGen : ∀ ν : Fin (M + 1),
      ∃ (n_ν : ℕ) (g_ν : Fin n_ν → ↑(X.left.presheaf.obj (Opposite.op (U_cov ν).1))),
        Ideal.span (Set.range g_ν) = I.ideal (U_cov ν) := by
    intro ν
    have _ : IsNoetherianRing ↑(X.left.presheaf.obj (Opposite.op (U_cov ν).1)) :=
      AlgebraicGeometry.IsLocallyNoetherian.component_noetherian (U_cov ν)
    obtain ⟨G_ν, hSpan_ν⟩ := IsNoetherian.noetherian (I.ideal (U_cov ν))
    let eqv := G_ν.equivFin.symm
    refine ⟨G_ν.card, fun r => (eqv r).1, ?_⟩
    have hRangeEq : Set.range (fun r : Fin G_ν.card => (eqv r).1) = (↑G_ν : Set _) := by
      ext x
      constructor
      · rintro ⟨r, rfl⟩
        exact (eqv r).2
      · intro hx
        exact ⟨eqv.symm ⟨x, hx⟩, congrArg Subtype.val (eqv.apply_symm_apply ⟨x, hx⟩)⟩
    rw [hRangeEq]
    exact hSpan_ν

  obtain ⟨n_G, hExGen'⟩ := Classical.axiomOfChoice hExGen
  obtain ⟨g_G, hSpanG⟩ := Classical.axiomOfChoice hExGen'

  obtain ⟨i₀, hNeBot_i₀⟩ := hNonBot
  have hn_i₀ : 0 < n_G i₀ := by
    refine Nat.pos_of_ne_zero fun hZero => hNeBot_i₀ ?_
    rw [← hSpanG i₀]
    have hEmptyRange : Set.range (g_G i₀) = ∅ := by
      ext x
      simp only [Set.mem_range, Set.mem_empty_iff_false, iff_false, not_exists]
      rintro ⟨r, hlt⟩ _
      omega
    rw [hEmptyRange, Ideal.span_empty]

  let J : Type := Σ ν : Fin (M + 1), Fin (n_G ν)
  have _ : Nonempty J := ⟨⟨i₀, ⟨0, hn_i₀⟩⟩⟩
  have hCardPos : 0 < Fintype.card J := Fintype.card_pos
  let L : ℕ := Fintype.card J - 1
  have hCardEq : Fintype.card J = L + 1 := (Nat.sub_add_cancel hCardPos).symm
  let equivJ : Fin (L + 1) ≃ J := (Fintype.equivFinOfCardEq hCardEq).symm

  have hLift : ∀ p : J, ∃ (d : ℕ) (P_pol : S),
      ∃ hP : P_pol ∈ 𝒜 (d • 1),
        q p.1 (HomogeneousLocalization.Away.mk 𝒜 (hX p.1) d P_pol hP) = g_G p.1 p.2 := by
    intro p
    obtain ⟨z, hz⟩ := hq_surj p.1 (g_G p.1 p.2)
    obtain ⟨d, P_pol, hP, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜 (hX p.1) z
    exact ⟨d, P_pol, hP, hz⟩

  obtain ⟨d_p, hLift1⟩ := Classical.axiomOfChoice hLift
  obtain ⟨P_p, hLift2⟩ := Classical.axiomOfChoice hLift1
  obtain ⟨hP_p, hq_p⟩ := Classical.axiomOfChoice hLift2

  have hClearPair : ∀ pl : J × Fin (M + 1), ∃ e : ℕ,
      (q pl.2 (HomogeneousLocalization.Away.isLocalizationElem (hX pl.2) (hX pl.1.1))) ^ e *
        q pl.2 (HomogeneousLocalization.Away.mk 𝒜 (hX pl.2) (d_p pl.1) (P_p pl.1) (hP_p pl.1)) ∈
        I.ideal (U_cov pl.2) := by
    rintro ⟨p, l⟩
    have hg_mem : g_G p.1 p.2 ∈ I.ideal (U_cov p.1) := by
      rw [← hSpanG p.1]
      exact Ideal.subset_span ⟨p.2, rfl⟩
    have hOvEq :
        (X.left.presheaf.map (CategoryTheory.homOfLE inf_le_left).op
          (q l (HomogeneousLocalization.Away.isLocalizationElem (hX l) (hX p.1)))) ^ (d_p p) *
        X.left.presheaf.map (CategoryTheory.homOfLE inf_le_right).op (g_G p.1 p.2) =
        X.left.presheaf.map (CategoryTheory.homOfLE inf_le_left).op
          (q l (HomogeneousLocalization.Away.mk 𝒜 (hX l) (d_p p) (P_p p) (hP_p p))) := by
      conv_lhs => rw [← hq_p p]
      rw [hResL l p.1, hResR l p.1, hResL l p.1, ← map_pow, ← map_mul]
      exact congrArg (φ_ov l p.1) (hCrossShift p.1 l (d_p p) (P_p p) (hP_p p))
    exact hClear (U_cov l) (U_cov p.1)
      (q l (HomogeneousLocalization.Away.isLocalizationElem (hX l) (hX p.1)))
      (q l (HomogeneousLocalization.Away.mk 𝒜 (hX l) (d_p p) (P_p p) (hP_p p)))
      (g_G p.1 p.2) (d_p p) (hBasicLe l p.1) hg_mem hOvEq

  obtain ⟨e_pl, he_pl⟩ := Classical.axiomOfChoice hClearPair

  let D : ℕ := max 1 (Finset.univ.sup fun pl : J × Fin (M + 1) => e_pl pl + d_p pl.1)
  have hed_le_D : ∀ (p : J) (l : Fin (M + 1)), e_pl (p, l) + d_p p ≤ D := by
    intro p l
    exact le_trans
      (Finset.le_sup (f := fun pl : J × Fin (M + 1) => e_pl pl + d_p pl.1)
        (Finset.mem_univ (p, l)))
      (le_max_right _ _)
  have hd_le_D : ∀ p : J, d_p p ≤ D :=
    fun p => le_trans (Nat.le_add_left _ _) (hed_le_D p p.1)

  let F_a : Fin (L + 1) → S :=
    fun a => (MvPolynomial.X (equivJ a).1) ^ (D - d_p (equivJ a)) * P_p (equivJ a)
  have hF_a : ∀ a : Fin (L + 1), F_a a ∈ 𝒜 (D • 1) :=
    fun a => hPadMem (equivJ a).1 (d_p (equivJ a)) D (hd_le_D (equivJ a))
      (P_p (equivJ a)) (hP_p (equivJ a))

  let h : ∀ i : Fin (M + 1), Fin (L + 1) →
      ↑(X.left.presheaf.obj (Opposite.op (U_cov i).1)) :=
    fun i a => q i (HomogeneousLocalization.Away.mk 𝒜 (hX i) D (F_a a) (hF_a a))

  refine ⟨M + 1, U_cov, L, h, hCov, ?_, ?_⟩
  · intro i
    apply le_antisymm
    · rw [← hSpanG i]
      refine Ideal.span_mono ?_
      rintro _ ⟨r, rfl⟩
      let p₀ : J := ⟨i, r⟩
      let a₀ : Fin (L + 1) := equivJ.symm p₀
      refine ⟨a₀, ?_⟩
      have ha₀ : equivJ a₀ = p₀ := equivJ.apply_symm_apply p₀
      dsimp [h, F_a]
      have hEqMk : ∀ (q₀ : J) (_ : q₀ = p₀)
          (hFq : MvPolynomial.X q₀.1 ^ (D - d_p q₀) * P_p q₀ ∈ 𝒜 (D • 1)),
          HomogeneousLocalization.Away.mk 𝒜 (hX i) D
            (MvPolynomial.X q₀.1 ^ (D - d_p q₀) * P_p q₀) hFq =
          HomogeneousLocalization.Away.mk 𝒜 (hX i) (d_p p₀) (P_p p₀) (hP_p p₀) := by
        rintro _ rfl hFq
        exact hHomeRec i (d_p p₀) D (hd_le_D p₀) (P_p p₀) (hP_p p₀) hFq
      rw [hEqMk (equivJ a₀) ha₀ (hF_a a₀)]
      exact hq_p p₀
    · rw [Ideal.span_le]
      rintro _ ⟨a, rfl⟩
      let p := equivJ a
      dsimp [h, F_a]
      rw [hOffFact p.1 i (d_p p) (e_pl (p, i)) D (hed_le_D p i) (P_p p) (hP_p p) (hF_a a)]
      simp only [map_mul, map_pow]
      exact Ideal.mul_mem_left _ _ (he_pl (p, i))
  · intro i j
    refine ⟨hAffOv i j, ?_⟩
    obtain ⟨u₀, hu₀, hCoc₀⟩ := hUnitCocycle i j D
    refine ⟨φ_ov i j u₀, hu₀.map (φ_ov i j), ?_⟩
    intro a
    dsimp [h]
    rw [hResL i j, hResR i j, hCoc₀ (F_a a) (hF_a a), map_mul]

theorem weil_cocycle_rational_map_to_proj (k : Type u) [Field k]
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (I : X.left.IdealSheafData)
    (U_compl : X.left.Opens)
    (hU_compl : (U_compl : Set X.left) = (I.support : Set X.left)ᶜ)
    (m : ℕ) (U_cov : Fin m → X.left.affineOpens) (L : ℕ)
    (h : ∀ i : Fin m, Fin (L + 1) → ↑(X.left.presheaf.obj (Opposite.op (U_cov i).1)))
    (hCov : (⨆ i : Fin m, (U_cov i).1) = ⊤)
    (hSpan : ∀ i : Fin m, I.ideal (U_cov i) = Ideal.span (Set.range (h i)))
    (hCocycle : ∀ i j : Fin m,
      AlgebraicGeometry.IsAffineOpen ((U_cov i).1 ⊓ (U_cov j).1) ∧
      ∃ u : ↑(X.left.presheaf.obj (Opposite.op ((U_cov i).1 ⊓ (U_cov j).1))),
        IsUnit u ∧
        ∀ a : Fin (L + 1),
          X.left.presheaf.map (CategoryTheory.homOfLE inf_le_left).op (h i a) =
            u * X.left.presheaf.map (CategoryTheory.homOfLE inf_le_right).op (h j a)) :
    ∃ (Φ₀ : U_compl.toScheme ⟶ (weilProjectiveSpaceOver k L).left),
      IsIdealCocycleRationalMapToProj k I U_compl U_cov L h Φ₀ :=
by
  let 𝒜_L := MvPolynomial.homogeneousSubmodule (Fin (L + 1)) k
  letI : GradedAlgebra 𝒜_L := MvPolynomial.gradedAlgebra
  let P_L := weilProjectiveSpaceOver k L
  let X_v : Fin (L + 1) → MvPolynomial (Fin (L + 1)) k := MvPolynomial.X
  let hX : ∀ α : Fin (L + 1), X_v α ∈ 𝒜_L 1 :=
    fun α => MvPolynomial.isHomogeneous_X k α
  let w_α : ∀ α : Fin (L + 1),
      AlgebraicGeometry.Spec
        (CommRingCat.of (HomogeneousLocalization.Away 𝒜_L (X_v α))) ⟶ P_L.left :=
    fun α => AlgebraicGeometry.Proj.awayι 𝒜_L (X_v α) (hX α) zero_lt_one

  
  let α_k : ∀ V : X.left.affineOpens, CommRingCat.of k ⟶ X.left.presheaf.obj (Opposite.op V.1) :=
    fun V => AlgebraicGeometry.Spec.preimage (V.2.fromSpec ≫ X.hom)
  have hα_k_spec : ∀ V : X.left.affineOpens,
      AlgebraicGeometry.Spec.map (α_k V) = V.2.fromSpec ≫ X.hom :=
    fun V => AlgebraicGeometry.Spec.map_preimage (V.2.fromSpec ≫ X.hom)
  let φ_k : ∀ V : X.left.affineOpens, k →+* ↑(X.left.presheaf.obj (Opposite.op V.1)) :=
    fun V => (α_k V).hom
  have hφ_k_res : ∀ (V W : X.left.affineOpens) (hVW : V.1 ≤ W.1),
      (X.left.presheaf.map (CategoryTheory.homOfLE hVW).op).hom.comp (φ_k W) = φ_k V := by
    intro V W hVW
    have hMap : AlgebraicGeometry.Spec.map
          (α_k W ≫ X.left.presheaf.map (CategoryTheory.homOfLE hVW).op) =
        AlgebraicGeometry.Spec.map (α_k V) := by
      rw [AlgebraicGeometry.Spec.map_comp, hα_k_spec W, hα_k_spec V, ← Category.assoc,
        AlgebraicGeometry.IsAffineOpen.map_fromSpec W.2 V.2 (CategoryTheory.homOfLE hVW).op]
    have hEq := AlgebraicGeometry.Spec.map_injective hMap
    exact congrArg CommRingCat.Hom.hom hEq

  
  have hLift_mk : ∀ {T : Type u} [CommRing T]
      (G : MvPolynomial (Fin (L + 1)) k →+* T)
      {d : ℕ} {f : MvPolynomial (Fin (L + 1)) k} (hf : f ∈ 𝒜_L d)
      (hGf : IsUnit (G f)) (n : ℕ) (a : MvPolynomial (Fin (L + 1)) k) (ha : a ∈ 𝒜_L (n • d)),
      IsLocalization.Away.lift f hGf
        (algebraMap (HomogeneousLocalization.Away 𝒜_L f) (Localization.Away f)
          (HomogeneousLocalization.Away.mk 𝒜_L hf n a ha)) * G (f ^ n) = G a := by
    intro T _ G d f hf hGf n a ha
    rw [HomogeneousLocalization.algebraMap_apply, HomogeneousLocalization.Away.val_mk,
      Localization.mk_eq_mk', ← IsLocalization.Away.lift_eq (S := Localization.Away f) f hGf (f ^ n),
      ← map_mul, IsLocalization.mk'_spec, IsLocalization.Away.lift_eq (S := Localization.Away f) f hGf a]

  have hLift_awayMap : ∀ {T : Type u} [CommRing T]
      (G : MvPolynomial (Fin (L + 1)) k →+* T)
      {d e : ℕ} {f g x : MvPolynomial (Fin (L + 1)) k}
      (hf : f ∈ 𝒜_L d) (hg : g ∈ 𝒜_L e) (hx : x = f * g)
      (hGx : IsUnit (G x)) (hGf : IsUnit (G f))
      (z : HomogeneousLocalization.Away 𝒜_L f),
      IsLocalization.Away.lift x hGx
        (algebraMap (HomogeneousLocalization.Away 𝒜_L x) (Localization.Away x)
          (HomogeneousLocalization.awayMap 𝒜_L hg hx z)) =
      IsLocalization.Away.lift f hGf
        (algebraMap (HomogeneousLocalization.Away 𝒜_L f) (Localization.Away f) z) := by
    intro T _ G d e f g x hf hg hx hGx hGf z
    obtain ⟨n, a, ha, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜_L hf z
    have hUnit_xn : IsUnit (G (x ^ n)) := by
      rw [map_pow]
      exact hGx.pow n
    apply hUnit_xn.mul_right_cancel
    rw [HomogeneousLocalization.awayMap_mk, hLift_mk G _ hGx n (a * g ^ n) _,
      hx, mul_pow, map_mul G a (g ^ n), map_mul G (f ^ n) (g ^ n), ← mul_assoc,
      hLift_mk G hf hGf n a ha]

  have hHomog_scale : ∀ {T : Type u} [CommRing T]
      (F₁ F₂ : MvPolynomial (Fin (L + 1)) k →+* T) (s : T),
      (∀ c : k, F₁ (MvPolynomial.C c) = F₂ (MvPolynomial.C c)) →
      (∀ β : Fin (L + 1), F₁ (MvPolynomial.X β) = F₂ (MvPolynomial.X β) * s) →
      ∀ (n : ℕ) (a : MvPolynomial (Fin (L + 1)) k),
        a.IsHomogeneous n → F₁ a = F₂ a * s ^ n := by
    intro T _ F₁ F₂ s hC hX_sc n a ha
    conv_lhs => rw [a.as_sum]
    conv_rhs => rw [a.as_sum]
    rw [map_sum, map_sum, Finset.sum_mul]
    refine Finset.sum_congr rfl fun d hd => ?_
    have hd_ne : a.coeff d ≠ 0 := MvPolynomial.mem_support_iff.mp hd
    have hdeg_d : Finsupp.degree d = n := by
      by_contra hne
      exact hd_ne (ha.coeff_eq_zero hne)
    have hsum_d : (∑ β : Fin (L + 1), d β) = n := by
      have hsub : d.support ⊆ Finset.univ := Finset.subset_univ d.support
      have hsup : (∑ β ∈ d.support, d β) = ∑ β : Fin (L + 1), d β :=
        Finset.sum_subset hsub (fun β _ hnot => Finsupp.notMem_support_iff.mp hnot)
      change (∑ β ∈ d.support, d β) = n at hdeg_d
      rw [← hsup, hdeg_d]
    have hmon : MvPolynomial.monomial d (a.coeff d) =
        MvPolynomial.C (a.coeff d) * ∏ β : Fin (L + 1), MvPolynomial.X β ^ d β := by
      rw [MvPolynomial.monomial_eq,
        Finsupp.prod_fintype d (fun β e => MvPolynomial.X β ^ e) (fun _ => pow_zero _)]
    rw [hmon, map_mul, map_mul, map_prod, map_prod, hC (a.coeff d), mul_assoc]
    congr 1
    calc
      (∏ β : Fin (L + 1), F₁ (MvPolynomial.X β ^ d β))
        = ∏ β : Fin (L + 1), (F₂ (MvPolynomial.X β) ^ d β * s ^ d β) := by
          refine Finset.prod_congr rfl fun β _ => ?_
          rw [map_pow, hX_sc β, mul_pow]
      _ = (∏ β : Fin (L + 1), F₂ (MvPolynomial.X β ^ d β)) * ∏ β : Fin (L + 1), s ^ d β := by
          rw [Finset.prod_mul_distrib]
          congr 1
          refine Finset.prod_congr rfl fun β _ => (map_pow F₂ _ _).symm
      _ = (∏ β : Fin (L + 1), F₂ (MvPolynomial.X β ^ d β)) * s ^ n := by
          rw [Finset.prod_pow_eq_pow_sum, hsum_d]

  
  let ev_poly : ∀ {R : Type u} [CommRing R] (φ : k →+* R) (f : Fin (L + 1) → R)
      (α : Fin (L + 1)), MvPolynomial (Fin (L + 1)) k →+* Localization.Away (f α) :=
    fun {R} [CommRing R] φ f α =>
      MvPolynomial.eval₂Hom ((algebraMap R (Localization.Away (f α))).comp φ)
        (fun β => IsLocalization.mk' (Localization.Away (f α)) (f β)
          ⟨f α, Submonoid.mem_powers (f α)⟩)
  have hev_X : ∀ {R : Type u} [CommRing R] (φ : k →+* R) (f : Fin (L + 1) → R)
      (α β : Fin (L + 1)),
      ev_poly φ f α (X_v β) =
        IsLocalization.mk' (Localization.Away (f α)) (f β) ⟨f α, Submonoid.mem_powers (f α)⟩ := by
    intro R _ φ f α β
    exact MvPolynomial.eval₂Hom_X' ((algebraMap R (Localization.Away (f α))).comp φ) _ β
  have hev_self : ∀ {R : Type u} [CommRing R] (φ : k →+* R) (f : Fin (L + 1) → R)
      (α : Fin (L + 1)), ev_poly φ f α (X_v α) = 1 := by
    intro R _ φ f α
    rw [hev_X, IsLocalization.mk'_self]
  have hev_unit : ∀ {R : Type u} [CommRing R] (φ : k →+* R) (f : Fin (L + 1) → R)
      (α : Fin (L + 1)), IsUnit (ev_poly φ f α (X_v α)) := by
    intro R _ φ f α
    rw [hev_self]
    exact isUnit_one
  let ψ_of : ∀ {R : Type u} [CommRing R] (φ : k →+* R) (f : Fin (L + 1) → R)
      (α : Fin (L + 1)),
      HomogeneousLocalization.Away 𝒜_L (X_v α) →+* Localization.Away (f α) :=
    fun {R} [CommRing R] φ f α =>
      (IsLocalization.Away.lift (S := Localization.Away (X_v α))
        (g := ev_poly φ f α) (X_v α) (hev_unit φ f α)).comp
        (algebraMap (HomogeneousLocalization.Away 𝒜_L (X_v α))
          (Localization.Away (X_v α)))

  have hψ_of_ratio : ∀ {R : Type u} [CommRing R] (φ : k →+* R) (f : Fin (L + 1) → R)
      (α β : Fin (L + 1)),
      ψ_of φ f α (HomogeneousLocalization.Away.isLocalizationElem (𝒜 := 𝒜_L) (hX α) (hX β)) =
        IsLocalization.mk' (Localization.Away (f α)) (f β) ⟨f α, Submonoid.mem_powers (f α)⟩ := by
    intro R _ φ f α β
    have h1 := hLift_mk (ev_poly φ f α) (hX α) (hev_unit φ f α) 1 (X_v β ^ 1)
      (by simpa [one_nsmul, pow_one] using hX β)
    have h2 : ev_poly φ f α (X_v α ^ 1) = 1 := by
      rw [pow_one, hev_self]
    have h3 : ev_poly φ f α (X_v β ^ 1) =
        IsLocalization.mk' (Localization.Away (f α)) (f β) ⟨f α, Submonoid.mem_powers (f α)⟩ := by
      rw [pow_one, hev_X]
    rw [h2, mul_one, h3] at h1
    change IsLocalization.Away.lift (S := Localization.Away (X_v α))
      (g := ev_poly φ f α) (X_v α) (hev_unit φ f α)
      (algebraMap _ _ (HomogeneousLocalization.Away.isLocalizationElem (𝒜 := 𝒜_L) (hX α) (hX β))) = _
    have hisLoc : HomogeneousLocalization.Away.isLocalizationElem (𝒜 := 𝒜_L) (hX α) (hX β) =
        HomogeneousLocalization.Away.mk 𝒜_L (hX α) 1 (X_v β ^ 1)
          (by simpa [one_nsmul, pow_one] using hX β) := rfl
    rw [hisLoc]
    exact h1

  have hψ_of_hom : ∀ {R : Type u} [CommRing R] (φ : k →+* R) (f : Fin (L + 1) → R)
      (α : Fin (L + 1)),
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_of φ f α)) ≫ w_α α) ≫ P_L.hom =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((algebraMap R (Localization.Away (f α))).comp φ)) := by
    intro R _ φ f α
    have h_away : AlgebraicGeometry.Proj.awayι 𝒜_L (X_v α) (hX α) zero_lt_one ≫
          AlgebraicGeometry.Proj.toSpecZero 𝒜_L =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (HomogeneousLocalization.fromZeroRingHom 𝒜_L
            (Submonoid.powers (X_v α)))) :=
      AlgebraicGeometry.Proj.awayι_toSpecZero 𝒜_L (X_v α) (hX α) zero_lt_one
    have hAssoc : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_of φ f α)) ≫ w_α α) ≫
        P_L.hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_of φ f α)) ≫
          ((AlgebraicGeometry.Proj.awayι 𝒜_L (X_v α) (hX α) zero_lt_one ≫
              AlgebraicGeometry.Proj.toSpecZero 𝒜_L) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜_L 0)))) := by
      change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_of φ f α)) ≫
        AlgebraicGeometry.Proj.awayι 𝒜_L (X_v α) (hX α) zero_lt_one) ≫
        (AlgebraicGeometry.Proj.toSpecZero 𝒜_L ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜_L 0)))) = _
      simp only [Category.assoc]
    have hStep : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_of φ f α)) ≫
        ((AlgebraicGeometry.Proj.awayι 𝒜_L (X_v α) (hX α) zero_lt_one ≫
            AlgebraicGeometry.Proj.toSpecZero 𝒜_L) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜_L 0)))) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_of φ f α)) ≫
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (HomogeneousLocalization.fromZeroRingHom 𝒜_L (Submonoid.powers (X_v α)))) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜_L 0)))) :=
      congrArg (fun m => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_of φ f α)) ≫
        (m ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜_L 0))))) h_away
    rw [hAssoc, hStep, ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
    congr 2
    ext c
    change IsLocalization.Away.lift (S := Localization.Away (X_v α))
      (g := ev_poly φ f α) (X_v α) (hev_unit φ f α)
      ((HomogeneousLocalization.mk
        { deg := 0
          num := (algebraMap k ↥(𝒜_L 0)) c
          den := ⟨1, SetLike.one_mem_graded 𝒜_L⟩
          den_mem := Submonoid.one_mem _ }).val) =
      algebraMap R (Localization.Away (f α)) (φ c)
    rw [HomogeneousLocalization.val_mk]
    change IsLocalization.Away.lift (S := Localization.Away (X_v α))
      (g := ev_poly φ f α) (X_v α) (hev_unit φ f α)
      (Localization.mk ((algebraMap k ↥(𝒜_L 0)) c).1 1) = _
    rw [Localization.mk_one_eq_algebraMap, IsLocalization.Away.lift_eq,
      Algebra.algebraMap_eq_smul_one]
    simp [ev_poly, MvPolynomial.smul_eq_C_mul]

  have hProjPre : ∀ {S : Type u} [CommRing S] (α γ : Fin (L + 1))
      (ψ : HomogeneousLocalization.Away 𝒜_L (X_v γ) →+* S)
      (z : AlgebraicGeometry.Spec (CommRingCat.of S)),
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫ w_α γ).base z ∈
        Set.range (w_α α).base ↔
      z ∈ PrimeSpectrum.basicOpen
        (ψ (HomogeneousLocalization.Away.isLocalizationElem (𝒜 := 𝒜_L) (hX γ) (hX α))) := by
    intro S _ α γ ψ z
    let w_proj : ∀ δ : Fin (L + 1),
        AlgebraicGeometry.Spec (CommRingCat.of (HomogeneousLocalization.Away 𝒜_L (X_v δ))) ⟶
          AlgebraicGeometry.Proj 𝒜_L :=
      fun δ => AlgebraicGeometry.Proj.awayι 𝒜_L (X_v δ) (hX δ) zero_lt_one
    change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫ w_proj γ).base z ∈
      Set.range (w_proj α).base ↔ _
    have hRange : Set.range (w_proj α).base =
        (AlgebraicGeometry.Proj.basicOpen 𝒜_L (X_v α) : Set (AlgebraicGeometry.Proj 𝒜_L)) := by
      have hOpen := AlgebraicGeometry.Proj.opensRange_awayι 𝒜_L (X_v α) (hX α) zero_lt_one
      exact congrArg (fun U : (AlgebraicGeometry.Proj 𝒜_L).Opens =>
        (U : Set (AlgebraicGeometry.Proj 𝒜_L))) hOpen
    rw [hRange]
    change (w_proj γ).base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)).base z) ∈
      AlgebraicGeometry.Proj.basicOpen 𝒜_L (X_v α) ↔ _
    change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)).base z ∈
      (w_proj γ ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen 𝒜_L (X_v α)) ↔ _
    rw [AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜_L (hX γ) zero_lt_one (hX α) zero_lt_one]
    change z ∈ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ⁻¹ᵁ
      PrimeSpectrum.basicOpen
        (HomogeneousLocalization.Away.isLocalizationElem (𝒜 := 𝒜_L) (hX γ) (hX α))) ↔ _
    rw [AlgebraicGeometry.SpecMap_preimage_basicOpen (CommRingCat.ofHom ψ)]
    rfl

  
  have hRange_fromSpec_away : ∀ (V : X.left.affineOpens)
      (g : ↑(X.left.presheaf.obj (Opposite.op V.1))),
      Set.range (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom
          (algebraMap ↑(X.left.presheaf.obj (Opposite.op V.1)) (Localization.Away g))) ≫
          V.2.fromSpec).base = (X.left.basicOpen g : Set X.left) := by
    intro V g
    let R_V := ↑(X.left.presheaf.obj (Opposite.op V.1))
    let f_away : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away g)) ⟶
        AlgebraicGeometry.Spec (X.left.presheaf.obj (Opposite.op V.1)) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_V (Localization.Away g)))
    have hComp : Set.range (f_away ≫ V.2.fromSpec).base =
        V.2.fromSpec.base '' Set.range f_away.base :=
      Set.range_comp V.2.fromSpec.base f_away.base
    have hComap : Set.range f_away.base =
        (PrimeSpectrum.basicOpen g : Set (PrimeSpectrum R_V)) :=
      PrimeSpectrum.localization_away_comap_range (Localization.Away g) g
    have hImg : V.2.fromSpec.base '' (PrimeSpectrum.basicOpen g : Set (PrimeSpectrum R_V)) =
        (X.left.basicOpen g : Set X.left) :=
      congrArg (fun U : X.left.Opens => (U : Set X.left)) (V.2.fromSpec_image_basicOpen g)
    exact (hComp.trans (congrArg (Set.image V.2.fromSpec.base) hComap)).trans hImg

  have hLiftSub : ∀ (i : Fin m) (V : X.left.affineOpens) (hi : V.1 ≤ (U_cov i).1)
      (f_V : Fin (L + 1) → ↑(X.left.presheaf.obj (Opposite.op V.1))),
      (∀ β : Fin (L + 1), f_V β = X.left.presheaf.map (CategoryTheory.homOfLE hi).op (h i β)) →
      ∀ (α : Fin (L + 1)),
        ∃ ι_Vα : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (f_V α))) ⟶
            U_compl.toScheme,
          AlgebraicGeometry.IsOpenImmersion ι_Vα ∧
          (ι_Vα ≫ U_compl.ι =
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom
                (algebraMap ↑(X.left.presheaf.obj (Opposite.op V.1)) (Localization.Away (f_V α)))) ≫
              V.2.fromSpec) ∧
          (∀ y : U_compl.toScheme,
            y ∈ Set.range ι_Vα.base ↔ U_compl.ι.base y ∈ X.left.basicOpen (f_V α)) := by
    intro i V hi f_V hf_V α
    let R_V := ↑(X.left.presheaf.obj (Opposite.op V.1))
    have hIdealV : I.ideal V = Ideal.span (Set.range f_V) := by
      have hMap := AlgebraicGeometry.Scheme.IdealSheafData.map_ideal I
        (show V ≤ U_cov i from hi)
      rw [← hMap, hSpan i, Ideal.map_span]
      congr 1
      ext s
      simp only [Set.mem_image, Set.mem_range]
      constructor
      · rintro ⟨x, ⟨β, rfl⟩, rfl⟩
        exact ⟨β, hf_V β⟩
      · rintro ⟨β, rfl⟩
        exact ⟨h i β, ⟨β, rfl⟩, (hf_V β).symm⟩
    let g_Vα : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (f_V α))) ⟶ X.left :=
      AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap R_V (Localization.Away (f_V α)))) ≫ V.2.fromSpec
    have : AlgebraicGeometry.IsOpenImmersion
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap R_V (Localization.Away (f_V α))))) :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization (f_V α)
    have : AlgebraicGeometry.IsOpenImmersion V.2.fromSpec := V.2.isOpenImmersion_fromSpec
    have : AlgebraicGeometry.IsOpenImmersion g_Vα := inferInstance
    have hRange_g : Set.range g_Vα.base = (X.left.basicOpen (f_V α) : Set X.left) :=
      hRange_fromSpec_away V (f_V α)
    have hSub : Set.range g_Vα.base ⊆ Set.range U_compl.ι.base := by
      rw [hRange_g]
      intro x hxBasic
      have hxV : x ∈ V.1 := X.left.basicOpen_le (f_V α) hxBasic
      have hxNotSupp : x ∉ (I.support : Set X.left) := by
        intro hxSupp
        have hxZero : x ∈ X.left.zeroLocus (I.ideal V : Set R_V) :=
          (AlgebraicGeometry.Scheme.IdealSheafData.mem_support_iff_of_mem
            (I := I) (U := V) hxV).mp hxSupp
        have hfMem : f_V α ∈ (I.ideal V : Set R_V) := by
          rw [hIdealV]
          exact Ideal.subset_span ⟨α, rfl⟩
        exact (AlgebraicGeometry.RingedSpace.mem_zeroLocus_iff X.left.toRingedSpace
          (I.ideal V : Set R_V) x).mp hxZero (f_V α) hfMem hxBasic
      have hxU : x ∈ (U_compl : Set X.left) := by
        rw [hU_compl]
        exact hxNotSupp
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      exact hxU
    let ι_Vα := AlgebraicGeometry.IsOpenImmersion.lift U_compl.ι g_Vα hSub
    have hFac : ι_Vα ≫ U_compl.ι = g_Vα :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac U_compl.ι g_Vα hSub
    have : AlgebraicGeometry.IsOpenImmersion (ι_Vα ≫ U_compl.ι) := by
      rw [hFac]; infer_instance
    have hOpen_ι : AlgebraicGeometry.IsOpenImmersion ι_Vα :=
      AlgebraicGeometry.IsOpenImmersion.of_comp ι_Vα U_compl.ι
    refine ⟨ι_Vα, hOpen_ι, hFac, ?_⟩
    intro y
    constructor
    · rintro ⟨z, rfl⟩
      have hz : g_Vα.base z ∈ Set.range g_Vα.base := ⟨z, rfl⟩
      rw [hRange_g] at hz
      have hCompz : U_compl.ι.base (ι_Vα.base z) = g_Vα.base z :=
        congrFun (congrArg (fun f => (f.base : _ → _)) hFac) z
      rwa [hCompz]
    · intro hyBasic
      have hyRange : U_compl.ι.base y ∈ Set.range g_Vα.base := by
        rwa [hRange_g]
      obtain ⟨z, hz⟩ := hyRange
      refine ⟨z, U_compl.ι.isOpenEmbedding.injective ?_⟩
      have hCompz : U_compl.ι.base (ι_Vα.base z) = g_Vα.base z :=
        congrFun (congrArg (fun f => (f.base : _ → _)) hFac) z
      rw [hCompz, hz]

  have hCovSub : ∀ (i : Fin m) (V : X.left.affineOpens) (hi : V.1 ≤ (U_cov i).1)
      (y : U_compl.toScheme),
      U_compl.ι.base y ∈ V.1 →
      ∃ γ : Fin (L + 1),
        U_compl.ι.base y ∈
          X.left.basicOpen (X.left.presheaf.map (CategoryTheory.homOfLE hi).op (h i γ)) := by
    intro i V hi y hyV
    let h_V : Fin (L + 1) → ↑(X.left.presheaf.obj (Opposite.op V.1)) :=
      fun β => X.left.presheaf.map (CategoryTheory.homOfLE hi).op (h i β)
    have hIdealV : I.ideal V = Ideal.span (Set.range h_V) := by
      have hMap := AlgebraicGeometry.Scheme.IdealSheafData.map_ideal I
        (show V ≤ U_cov i from hi)
      rw [← hMap, hSpan i, Ideal.map_span]
      congr 1
      ext s
      simp only [Set.mem_image, Set.mem_range]
      constructor
      · rintro ⟨x, ⟨β, rfl⟩, rfl⟩
        exact ⟨β, rfl⟩
      · rintro ⟨β, rfl⟩
        exact ⟨h i β, ⟨β, rfl⟩, rfl⟩
    have hyCompl : U_compl.ι.base y ∈ (U_compl : Set X.left) := by
      rw [← AlgebraicGeometry.Scheme.Opens.range_ι]
      exact ⟨y, rfl⟩
    have hyNotSupp : U_compl.ι.base y ∉ (I.support : Set X.left) := by
      rwa [hU_compl] at hyCompl
    have hyNotZero : U_compl.ι.base y ∉
        X.left.zeroLocus (I.ideal V : Set ↑(X.left.presheaf.obj (Opposite.op V.1))) :=
      mt (AlgebraicGeometry.Scheme.IdealSheafData.mem_support_iff_of_mem
        (I := I) (U := V) hyV).mpr hyNotSupp
    rw [hIdealV, AlgebraicGeometry.Scheme.zeroLocus_span X.left (Set.range h_V)] at hyNotZero
    have hyNotAll : ¬ ∀ s ∈ Set.range h_V, U_compl.ι.base y ∉ X.left.basicOpen s :=
      mt (AlgebraicGeometry.RingedSpace.mem_zeroLocus_iff X.left.toRingedSpace
        (Set.range h_V) (U_compl.ι.base y)).mpr hyNotZero
    by_contra hNoγ
    exact hyNotAll fun s hs hyBasic => by
      rcases hs with ⟨γ, rfl⟩
      exact hNoγ ⟨γ, hyBasic⟩

  have hCovGlob : ∀ y : U_compl.toScheme,
      ∃ (i : Fin m) (α : Fin (L + 1)), U_compl.ι.base y ∈ X.left.basicOpen (h i α) := by
    intro y
    have hyTop : U_compl.ι.base y ∈ (⊤ : X.left.Opens) := trivial
    rw [← hCov, TopologicalSpace.Opens.mem_iSup] at hyTop
    obtain ⟨i, hyUi⟩ := hyTop
    obtain ⟨α, hyBasic⟩ := hCovSub i (U_cov i) le_rfl y hyUi
    refine ⟨i, α, ?_⟩
    have hid : X.left.presheaf.map
        (CategoryTheory.homOfLE (le_rfl : (U_cov i).1 ≤ (U_cov i).1)).op (h i α) = h i α := by
      simp
    rwa [hid] at hyBasic

  have hBasicMk : ∀ (V : X.left.affineOpens) (f g : ↑(X.left.presheaf.obj (Opposite.op V.1)))
      (z : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away g))),
      z ∈ PrimeSpectrum.basicOpen
        (IsLocalization.mk' (Localization.Away g) f ⟨g, Submonoid.mem_powers g⟩) ↔
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom
          (algebraMap ↑(X.left.presheaf.obj (Opposite.op V.1)) (Localization.Away g))) ≫
        V.2.fromSpec).base z ∈ X.left.basicOpen f := by
    intro V f g z
    let R_V := ↑(X.left.presheaf.obj (Opposite.op V.1))
    let S := Localization.Away g
    have hu_g : IsUnit (algebraMap R_V S g) := IsLocalization.Away.algebraMap_isUnit g
    obtain ⟨u_g, hu_g_eq⟩ := hu_g
    have hSpec_mk : IsLocalization.mk' S f ⟨g, Submonoid.mem_powers g⟩ * ↑u_g =
        algebraMap R_V S f := by
      rw [hu_g_eq]
      exact IsLocalization.mk'_spec S f ⟨g, Submonoid.mem_powers g⟩
    have hIff : z ∈ PrimeSpectrum.basicOpen (IsLocalization.mk' S f ⟨g, Submonoid.mem_powers g⟩) ↔
        z ∈ PrimeSpectrum.basicOpen (algebraMap R_V S f) := by
      change IsLocalization.mk' S f ⟨g, Submonoid.mem_powers g⟩ ∉ (z : PrimeSpectrum S).asIdeal ↔
        algebraMap R_V S f ∉ (z : PrimeSpectrum S).asIdeal
      rw [← hSpec_mk]
      constructor
      · intro hNotMem hProdMem
        apply hNotMem
        have h1 : (IsLocalization.mk' S f ⟨g, Submonoid.mem_powers g⟩ * ↑u_g) * ↑(u_g⁻¹) ∈
            (z : PrimeSpectrum S).asIdeal :=
          Ideal.mul_mem_right _ (z : PrimeSpectrum S).asIdeal hProdMem
        simpa [mul_assoc] using h1
      · intro hNotMem hMem
        exact hNotMem (Ideal.mul_mem_right _ (z : PrimeSpectrum S).asIdeal hMem)
    rw [hIff]
    change z ∈ PrimeSpectrum.basicOpen
      ((CommRingCat.ofHom (algebraMap R_V S)).hom f) ↔ _
    rw [← AlgebraicGeometry.SpecMap_preimage_basicOpen (CommRingCat.ofHom (algebraMap R_V S)) f,
      ← V.2.fromSpec_preimage_basicOpen f]
    rfl

  
  let ψ_chart : ∀ (i : Fin m) (α : Fin (L + 1)),
      HomogeneousLocalization.Away 𝒜_L (MvPolynomial.X α) →+* Localization.Away (h i α) :=
    fun i α => ψ_of (φ_k (U_cov i)) (h i) α
  have hChart_ex : ∀ (i : Fin m) (α : Fin (L + 1)),
      ∃ ι_ia : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (h i α))) ⟶
          U_compl.toScheme,
        AlgebraicGeometry.IsOpenImmersion ι_ia ∧
        (ι_ia ≫ U_compl.ι =
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap _ (Localization.Away (h i α)))) ≫
            (U_cov i).2.fromSpec) ∧
        (∀ y : U_compl.toScheme,
          y ∈ Set.range ι_ia.base ↔ U_compl.ι.base y ∈ X.left.basicOpen (h i α)) := by
    intro i α
    exact hLiftSub i (U_cov i) le_rfl (h i) (by intro β; simp) α
  let ι_chart : ∀ (i : Fin m) (α : Fin (L + 1)),
      AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (h i α))) ⟶ U_compl.toScheme :=
    fun i α => Classical.choose (hChart_ex i α)
  have hOpen_chart : ∀ (i : Fin m) (α : Fin (L + 1)),
      AlgebraicGeometry.IsOpenImmersion (ι_chart i α) :=
    fun i α => (Classical.choose_spec (hChart_ex i α)).1
  have hFac_chart : ∀ (i : Fin m) (α : Fin (L + 1)),
      ι_chart i α ≫ U_compl.ι =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap _ (Localization.Away (h i α)))) ≫
          (U_cov i).2.fromSpec :=
    fun i α => (Classical.choose_spec (hChart_ex i α)).2.1
  have hRange_chart : ∀ (i : Fin m) (α : Fin (L + 1)) (y : U_compl.toScheme),
      y ∈ Set.range (ι_chart i α).base ↔ U_compl.ι.base y ∈ X.left.basicOpen (h i α) :=
    fun i α => (Classical.choose_spec (hChart_ex i α)).2.2

  let J := ULift.{u} (Fin m × Fin (L + 1))
  have hCovers_J : ∀ y : ↥U_compl.toScheme,
      ∃ (p : J) (z : ↥(AlgebraicGeometry.Spec
        (CommRingCat.of (Localization.Away (h p.down.1 p.down.2))))),
        (ι_chart p.down.1 p.down.2).base z = y := by
    intro y
    obtain ⟨i, α, hyBasic⟩ := hCovGlob y
    obtain ⟨z, hz⟩ := (hRange_chart i α y).mpr hyBasic
    exact ⟨⟨(i, α)⟩, z, hz⟩

  let 𝒰 : U_compl.toScheme.OpenCover :=
    AlgebraicGeometry.Scheme.Cover.mkOfCovers J
      (fun p => AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (h p.down.1 p.down.2))))
      (fun p => ι_chart p.down.1 p.down.2)
      hCovers_J
      (fun p => hOpen_chart p.down.1 p.down.2)

  
  let Φ_loc : ∀ p : 𝒰.I₀, 𝒰.X p ⟶ P_L.left :=
    fun p => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_chart p.down.1 p.down.2)) ≫
      w_α p.down.2

  have hGlue : ∀ p q : 𝒰.I₀,
      CategoryTheory.Limits.pullback.fst (𝒰.f p) (𝒰.f q) ≫ Φ_loc p =
        CategoryTheory.Limits.pullback.snd (𝒰.f p) (𝒰.f q) ≫ Φ_loc q := by
    intro p q
    let i := p.down.1
    let α := p.down.2
    let j := q.down.1
    let γ := q.down.2
    obtain ⟨hAff_ij, u, hu_unit, hu_eq⟩ := hCocycle i j
    let U_ij : X.left.affineOpens := ⟨(U_cov i).1 ⊓ (U_cov j).1, hAff_ij⟩
    let R_i := ↑(X.left.presheaf.obj (Opposite.op (U_cov i).1))
    let R_j := ↑(X.left.presheaf.obj (Opposite.op (U_cov j).1))
    let R_ij := ↑(X.left.presheaf.obj (Opposite.op U_ij.1))
    let res₁ : R_i →+* R_ij := (X.left.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom
    let res₂ : R_j →+* R_ij := (X.left.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom
    let s_ij : R_ij := res₁ (h i α) * res₂ (h j γ)
    let T_ij := Localization.Away s_ij

    
    have hUnit_s : IsUnit (algebraMap R_ij T_ij s_ij) :=
      IsLocalization.Away.algebraMap_isUnit s_ij
    have hUnit_prod : IsUnit (algebraMap R_ij T_ij (res₁ (h i α)) *
        algebraMap R_ij T_ij (res₂ (h j γ))) := by
      simpa only [s_ij, map_mul] using hUnit_s
    obtain ⟨u_prod, hu_prod_eq⟩ := hUnit_prod
    have hu₁_mul : ((algebraMap R_ij T_ij).comp res₁) (h i α) *
        (algebraMap R_ij T_ij (res₂ (h j γ)) * ↑(u_prod⁻¹)) = 1 := by
      change algebraMap R_ij T_ij (res₁ (h i α)) *
        (algebraMap R_ij T_ij (res₂ (h j γ)) * ↑(u_prod⁻¹)) = 1
      rw [← mul_assoc, ← hu_prod_eq, Units.mul_inv]
    have hu₁ : IsUnit (((algebraMap R_ij T_ij).comp res₁) (h i α)) :=
      ⟨⟨_, _, hu₁_mul, by rw [mul_comm, hu₁_mul]⟩, rfl⟩
    have hu₂_mul : ((algebraMap R_ij T_ij).comp res₂) (h j γ) *
        (algebraMap R_ij T_ij (res₁ (h i α)) * ↑(u_prod⁻¹)) = 1 := by
      change algebraMap R_ij T_ij (res₂ (h j γ)) *
        (algebraMap R_ij T_ij (res₁ (h i α)) * ↑(u_prod⁻¹)) = 1
      rw [← mul_assoc, mul_comm (algebraMap R_ij T_ij (res₂ (h j γ))), ← hu_prod_eq,
        Units.mul_inv]
    have hu₂ : IsUnit (((algebraMap R_ij T_ij).comp res₂) (h j γ)) :=
      ⟨⟨_, _, hu₂_mul, by rw [mul_comm, hu₂_mul]⟩, rfl⟩
    let ρ₁ : Localization.Away (h i α) →+* T_ij := IsLocalization.Away.lift (h i α) hu₁
    let ρ₂ : Localization.Away (h j γ) →+* T_ij := IsLocalization.Away.lift (h j γ) hu₂
    let g₁ : AlgebraicGeometry.Spec (CommRingCat.of T_ij) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (h i α))) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ₁)
    let g₂ : AlgebraicGeometry.Spec (CommRingCat.of T_ij) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (h j γ))) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ₂)

    have hρ₁_comp : ρ₁.comp (algebraMap R_i (Localization.Away (h i α))) =
        (algebraMap R_ij T_ij).comp res₁ := by
      ext r; exact IsLocalization.Away.lift_eq (S := Localization.Away (h i α)) (h i α) hu₁ r
    have hρ₂_comp : ρ₂.comp (algebraMap R_j (Localization.Away (h j γ))) =
        (algebraMap R_ij T_ij).comp res₂ := by
      ext r; exact IsLocalization.Away.lift_eq (S := Localization.Away (h j γ)) (h j γ) hu₂ r

    have hg₁_comp : g₁ ≫ (ι_chart i α ≫ U_compl.ι) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_ij T_ij)) ≫
          hAff_ij.fromSpec := by
      rw [hFac_chart i α, ← Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, hρ₁_comp, CommRingCat.ofHom_comp,
        AlgebraicGeometry.Spec.map_comp, Category.assoc]
      exact congrArg
        (fun m => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_ij T_ij)) ≫ m)
        (AlgebraicGeometry.IsAffineOpen.map_fromSpec (U_cov i).2 hAff_ij
          (CategoryTheory.homOfLE inf_le_left).op)

    have hg₂_comp : g₂ ≫ (ι_chart j γ ≫ U_compl.ι) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_ij T_ij)) ≫
          hAff_ij.fromSpec := by
      rw [hFac_chart j γ, ← Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, hρ₂_comp, CommRingCat.ofHom_comp,
        AlgebraicGeometry.Spec.map_comp, Category.assoc]
      exact congrArg
        (fun m => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_ij T_ij)) ≫ m)
        (AlgebraicGeometry.IsAffineOpen.map_fromSpec (U_cov j).2 hAff_ij
          (CategoryTheory.homOfLE inf_le_right).op)

    have h_sq_chart : g₁ ≫ ι_chart i α = g₂ ≫ ι_chart j γ := by
      apply (cancel_mono U_compl.ι).mp
      rw [Category.assoc, Category.assoc, hg₁_comp, hg₂_comp]

    have : AlgebraicGeometry.IsOpenImmersion (ι_chart i α) := hOpen_chart i α
    have : AlgebraicGeometry.IsOpenImmersion (ι_chart j γ) := hOpen_chart j γ
    have : AlgebraicGeometry.IsOpenImmersion (ι_chart j γ ≫ U_compl.ι) := inferInstance
    have : AlgebraicGeometry.IsOpenImmersion
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_ij T_ij))) :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization s_ij
    have : AlgebraicGeometry.IsOpenImmersion hAff_ij.fromSpec := hAff_ij.isOpenImmersion_fromSpec
    have : AlgebraicGeometry.IsOpenImmersion (g₂ ≫ (ι_chart j γ ≫ U_compl.ι)) := by
      rw [hg₂_comp]; infer_instance
    have : AlgebraicGeometry.IsOpenImmersion g₂ :=
      AlgebraicGeometry.IsOpenImmersion.of_comp g₂ (ι_chart j γ ≫ U_compl.ι)

    have hBasic_s : X.left.basicOpen s_ij = X.left.basicOpen (h i α) ⊓ X.left.basicOpen (h j γ) := by
      have hMul : X.left.basicOpen s_ij =
          X.left.basicOpen (res₁ (h i α)) ⊓ X.left.basicOpen (res₂ (h j γ)) :=
        AlgebraicGeometry.RingedSpace.basicOpen_mul X.left.toRingedSpace
          (res₁ (h i α)) (res₂ (h j γ))
      have hRes₁ : X.left.basicOpen (res₁ (h i α)) = U_ij.1 ⊓ X.left.basicOpen (h i α) :=
        AlgebraicGeometry.RingedSpace.basicOpen_res X.left.toRingedSpace
          (CategoryTheory.homOfLE inf_le_left).op (h i α)
      have hRes₂ : X.left.basicOpen (res₂ (h j γ)) = U_ij.1 ⊓ X.left.basicOpen (h j γ) :=
        AlgebraicGeometry.RingedSpace.basicOpen_res X.left.toRingedSpace
          (CategoryTheory.homOfLE inf_le_right).op (h j γ)
      rw [hMul, hRes₁, hRes₂]
      have hle₁ : X.left.basicOpen (h i α) ≤ (U_cov i).1 := X.left.basicOpen_le (h i α)
      have hle₂ : X.left.basicOpen (h j γ) ≤ (U_cov j).1 := X.left.basicOpen_le (h j γ)
      ext x
      change x ∈ (U_ij.1 ⊓ X.left.basicOpen (h i α)) ⊓ (U_ij.1 ⊓ X.left.basicOpen (h j γ)) ↔
        x ∈ X.left.basicOpen (h i α) ⊓ X.left.basicOpen (h j γ)
      exact ⟨fun ⟨⟨_, hx₁⟩, ⟨_, hx₂⟩⟩ => ⟨hx₁, hx₂⟩,
        fun ⟨hx₁, hx₂⟩ => ⟨⟨⟨hle₁ hx₁, hle₂ hx₂⟩, hx₁⟩, ⟨⟨hle₁ hx₁, hle₂ hx₂⟩, hx₂⟩⟩⟩

    have hOpensEq : (ι_chart j γ ⁻¹ᵁ AlgebraicGeometry.Scheme.Hom.opensRange (ι_chart i α)) =
        AlgebraicGeometry.Scheme.Hom.opensRange g₂ := by
      ext z
      change (ι_chart j γ).base z ∈ Set.range (ι_chart i α).base ↔ z ∈ Set.range g₂.base
      rw [hRange_chart i α ((ι_chart j γ).base z)]
      have hz_j : U_compl.ι.base ((ι_chart j γ).base z) ∈ X.left.basicOpen (h j γ) :=
        (hRange_chart j γ ((ι_chart j γ).base z)).mp ⟨z, rfl⟩
      have hRange_s : Set.range (g₂ ≫ (ι_chart j γ ≫ U_compl.ι)).base =
          (X.left.basicOpen s_ij : Set X.left) := by
        rw [hg₂_comp]
        exact hRange_fromSpec_away U_ij s_ij
      constructor
      · intro hz_i
        have hz_s : (ι_chart j γ ≫ U_compl.ι).base z ∈
            Set.range (g₂ ≫ (ι_chart j γ ≫ U_compl.ι)).base := by
          rw [hRange_s, hBasic_s]
          exact ⟨hz_i, hz_j⟩
        obtain ⟨w, hw⟩ := hz_s
        exact ⟨w, (ι_chart j γ ≫ U_compl.ι).isOpenEmbedding.injective hw⟩
      · rintro ⟨w, rfl⟩
        have hw_s : (g₂ ≫ (ι_chart j γ ≫ U_compl.ι)).base w ∈
            Set.range (g₂ ≫ (ι_chart j γ ≫ U_compl.ι)).base :=
          ⟨w, rfl⟩
        rw [hRange_s, hBasic_s] at hw_s
        exact hw_s.1

    have hPb_chart : CategoryTheory.IsPullback g₁ g₂ (ι_chart i α) (ι_chart j γ) :=
      AlgebraicGeometry.IsOpenImmersion.isPullback g₁ g₂ (ι_chart i α) (ι_chart j γ)
        h_sq_chart.symm hOpensEq
    let g₁' : AlgebraicGeometry.Spec (CommRingCat.of T_ij) ⟶ 𝒰.X p := g₁
    let g₂' : AlgebraicGeometry.Spec (CommRingCat.of T_ij) ⟶ 𝒰.X q := g₂
    have hPb : CategoryTheory.IsPullback g₁' g₂' (𝒰.f p) (𝒰.f q) := hPb_chart
    let eIso := hPb.isoPullback
    have he_fst : eIso.hom ≫ CategoryTheory.Limits.pullback.fst (𝒰.f p) (𝒰.f q) = g₁' :=
      CategoryTheory.IsPullback.isoPullback_hom_fst hPb
    have he_snd : eIso.hom ≫ CategoryTheory.Limits.pullback.snd (𝒰.f p) (𝒰.f q) = g₂' :=
      CategoryTheory.IsPullback.isoPullback_hom_snd hPb

    
    let τ₁ : R_i →+* T_ij := (algebraMap R_ij T_ij).comp res₁
    let τ₂ : R_j →+* T_ij := (algebraMap R_ij T_ij).comp res₂
    have hτ_k : τ₁.comp (φ_k (U_cov i)) = τ₂.comp (φ_k (U_cov j)) := by
      have hk₁ : res₁.comp (φ_k (U_cov i)) = φ_k U_ij :=
        hφ_k_res U_ij (U_cov i) inf_le_left
      have hk₂ : res₂.comp (φ_k (U_cov j)) = φ_k U_ij :=
        hφ_k_res U_ij (U_cov j) inf_le_right
      rw [RingHom.comp_assoc, hk₁, RingHom.comp_assoc, hk₂]
    obtain ⟨u_r, hu_r_eq⟩ := hu_unit
    let u_t : T_ijˣ := Units.map (algebraMap R_ij T_ij).toMonoidHom u_r
    have hu_T : ∀ β : Fin (L + 1), τ₁ (h i β) = ↑u_t * τ₂ (h j β) := by
      intro β
      change algebraMap R_ij T_ij (X.left.presheaf.map (CategoryTheory.homOfLE inf_le_left).op (h i β)) =
        algebraMap R_ij T_ij ↑u_r *
          algebraMap R_ij T_ij (X.left.presheaf.map (CategoryTheory.homOfLE inf_le_right).op (h j β))
      rw [← map_mul, hu_r_eq]
      exact congrArg (algebraMap R_ij T_ij) (hu_eq β)

    obtain ⟨v₁, hv₁⟩ := id hu₁
    obtain ⟨v₂, hv₂⟩ := id hu₂
    let w₂ : T_ijˣ := u_t⁻¹ * v₁
    have hw₂ : (w₂ : T_ij) = τ₂ (h j α) := by
      change ↑u_t⁻¹ * ↑v₁ = τ₂ (h j α)
      rw [hv₁]
      change ↑u_t⁻¹ * τ₁ (h i α) = τ₂ (h j α)
      rw [hu_T α, ← mul_assoc, Units.inv_mul, one_mul]

    let G : MvPolynomial (Fin (L + 1)) k →+* T_ij :=
      MvPolynomial.eval₂Hom (τ₂.comp (φ_k (U_cov j))) (fun β => τ₂ (h j β) * ↑(w₂⁻¹))
    have hG_α : G (X_v α) = 1 := by
      have h1 : G (X_v α) = τ₂ (h j α) * ↑(w₂⁻¹) := MvPolynomial.eval₂Hom_X' _ _ α
      rw [h1, ← hw₂, Units.mul_inv]
    have hG_γ : G (X_v γ) = ↑(v₂ * w₂⁻¹) := by
      have h1 : G (X_v γ) = τ₂ (h j γ) * ↑(w₂⁻¹) := MvPolynomial.eval₂Hom_X' _ _ γ
      rw [h1, ← hv₂, Units.val_mul]
    have hG_αγ : IsUnit (G (X_v α * X_v γ)) := by
      rw [map_mul, hG_α, one_mul, hG_γ]
      exact Units.isUnit (v₂ * w₂⁻¹)
    have hG_α_unit : IsUnit (G (X_v α)) := by
      rw [hG_α]; exact isUnit_one
    have hG_γ_unit : IsUnit (G (X_v γ)) := by
      rw [hG_γ]; exact Units.isUnit (v₂ * w₂⁻¹)

    let aw_L := HomogeneousLocalization.awayMap 𝒜_L (hX γ)
      (rfl : X_v α * X_v γ = X_v α * X_v γ)
    let aw_R := HomogeneousLocalization.awayMap 𝒜_L (hX α)
      (mul_comm (X_v α) (X_v γ) : X_v α * X_v γ = X_v γ * X_v α)
    let θ : HomogeneousLocalization.Away 𝒜_L (X_v α * X_v γ) →+* T_ij :=
      (IsLocalization.Away.lift (S := Localization.Away (X_v α * X_v γ))
        (g := G) (X_v α * X_v γ) hG_αγ).comp
        (algebraMap (HomogeneousLocalization.Away 𝒜_L (X_v α * X_v γ))
          (Localization.Away (X_v α * X_v γ)))

    have hθ_L : θ.comp aw_L = ρ₁.comp (ψ_chart i α) := by
      have hLocEq : IsLocalization.Away.lift (S := Localization.Away (X_v α))
          (g := G) (X_v α) hG_α_unit =
          ρ₁.comp (IsLocalization.Away.lift (S := Localization.Away (X_v α))
            (g := ev_poly (φ_k (U_cov i)) (h i) α)
            (X_v α) (hev_unit (φ_k (U_cov i)) (h i) α)) := by
        apply IsLocalization.ringHom_ext (Submonoid.powers (X_v α))
        apply MvPolynomial.ringHom_ext'
        · ext c
          simp only [RingHom.comp_apply, IsLocalization.Away.lift_eq, G, ev_poly,
            MvPolynomial.eval₂Hom_C]
          have hc₁ : ρ₁ (algebraMap R_i (Localization.Away (h i α)) (φ_k (U_cov i) c)) =
              (τ₁.comp (φ_k (U_cov i))) c :=
            congrFun (congrArg DFunLike.coe hρ₁_comp) (φ_k (U_cov i) c)
          rw [hc₁, hτ_k]
          rfl
        · intro β
          change IsLocalization.Away.lift (S := Localization.Away (X_v α))
              (g := G) (X_v α) hG_α_unit (algebraMap _ _ (X_v β)) =
            ρ₁ (IsLocalization.Away.lift (S := Localization.Away (X_v α))
              (g := ev_poly (φ_k (U_cov i)) (h i) α) (X_v α)
              (hev_unit (φ_k (U_cov i)) (h i) α) (algebraMap _ _ (X_v β)))
          rw [IsLocalization.Away.lift_eq, IsLocalization.Away.lift_eq, hev_X]
          have hGβ : G (X_v β) = τ₂ (h j β) * ↑(w₂⁻¹) :=
            MvPolynomial.eval₂Hom_X' _ _ β
          rw [hGβ]
          apply hu₁.mul_right_cancel
          have hRhs : ρ₁ (IsLocalization.mk' (Localization.Away (h i α)) (h i β)
              ⟨h i α, Submonoid.mem_powers (h i α)⟩) * τ₁ (h i α) = τ₁ (h i β) := by
            have hτ_α : τ₁ (h i α) = ρ₁ (algebraMap R_i _ (h i α)) :=
              (congrFun (congrArg DFunLike.coe hρ₁_comp) (h i α)).symm
            have hτ_β : τ₁ (h i β) = ρ₁ (algebraMap R_i _ (h i β)) :=
              (congrFun (congrArg DFunLike.coe hρ₁_comp) (h i β)).symm
            rw [hτ_α, hτ_β, ← map_mul, IsLocalization.mk'_spec]
          change (τ₂ (h j β) * ↑(w₂⁻¹)) * τ₁ (h i α) = _
          rw [hRhs, hu_T β, ← hv₁]
          have hw_v : (w₂⁻¹ : T_ijˣ) * v₁ = u_t := by
            dsimp [w₂]
            rw [mul_inv_rev, inv_inv, mul_comm v₁⁻¹ u_t, mul_assoc, inv_mul_cancel, mul_one]
          calc
            (τ₂ (h j β) * ↑(w₂⁻¹)) * ↑v₁ = τ₂ (h j β) * ↑(w₂⁻¹ * v₁) := by
              rw [mul_assoc, Units.val_mul]
            _ = τ₂ (h j β) * ↑u_t := by rw [hw_v]
            _ = ↑u_t * τ₂ (h j β) := mul_comm _ _
      ext z
      change IsLocalization.Away.lift (S := Localization.Away (X_v α * X_v γ))
          (g := G) (X_v α * X_v γ) hG_αγ (algebraMap _ _ (aw_L z)) =
        (ρ₁.comp (IsLocalization.Away.lift (S := Localization.Away (X_v α))
          (g := ev_poly (φ_k (U_cov i)) (h i) α)
          (X_v α) (hev_unit (φ_k (U_cov i)) (h i) α))) (algebraMap _ _ z)
      rw [hLift_awayMap G (hX α) (hX γ) rfl hG_αγ hG_α_unit z, hLocEq]

    have hθ_R : θ.comp aw_R = ρ₂.comp (ψ_chart j γ) := by
      let ev₂ := ev_poly (φ_k (U_cov j)) (h j) γ
      have hScale_R : ∀ (n : ℕ) (a : MvPolynomial (Fin (L + 1)) k),
          a.IsHomogeneous n → G a = ρ₂ (ev₂ a) * G (X_v γ) ^ n := by
        refine hHomog_scale G (ρ₂.comp ev₂) (G (X_v γ)) ?_ ?_
        · intro c
          simp only [RingHom.comp_apply, G, ev₂, ev_poly, MvPolynomial.eval₂Hom_C]
          exact (congrFun (congrArg DFunLike.coe hρ₂_comp) (φ_k (U_cov j) c)).symm
        · intro β
          simp only [RingHom.comp_apply, G, ev₂, ev_poly, MvPolynomial.eval₂Hom_X']
          have hMk₂ : ρ₂ (IsLocalization.mk' (Localization.Away (h j γ)) (h j β)
              ⟨h j γ, Submonoid.mem_powers (h j γ)⟩) * τ₂ (h j γ) = τ₂ (h j β) := by
            have hτ_γ : τ₂ (h j γ) = ρ₂ (algebraMap R_j _ (h j γ)) :=
              (congrFun (congrArg DFunLike.coe hρ₂_comp) (h j γ)).symm
            have hτ_β : τ₂ (h j β) = ρ₂ (algebraMap R_j _ (h j β)) :=
              (congrFun (congrArg DFunLike.coe hρ₂_comp) (h j β)).symm
            rw [hτ_γ, hτ_β, ← map_mul, IsLocalization.mk'_spec]
          have hGγ_eq : G (X_v γ) = τ₂ (h j γ) * ↑(w₂⁻¹) :=
            MvPolynomial.eval₂Hom_X' _ _ γ
          rw [hGγ_eq, ← mul_assoc, hMk₂]
      ext z
      obtain ⟨n, a, ha, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜_L (hX γ) z
      have ha_hom : a.IsHomogeneous n := by
        have ha' : a ∈ 𝒜_L n := by simpa [nsmul_one] using ha
        exact (MvPolynomial.mem_homogeneousSubmodule n a).mp ha'
      have hUnit_γn : IsUnit (G (X_v γ ^ n)) := by
        rw [map_pow]
        exact hG_γ_unit.pow n
      apply hUnit_γn.mul_right_cancel
      change IsLocalization.Away.lift (S := Localization.Away (X_v α * X_v γ))
          (g := G) (X_v α * X_v γ) hG_αγ
          (algebraMap _ _ (aw_R (HomogeneousLocalization.Away.mk 𝒜_L (hX γ) n a ha))) *
          G (X_v γ ^ n) =
        ρ₂ (IsLocalization.Away.lift (S := Localization.Away (X_v γ))
          (g := ev₂) (X_v γ) (hev_unit (φ_k (U_cov j)) (h j) γ)
          (algebraMap _ _ (HomogeneousLocalization.Away.mk 𝒜_L (hX γ) n a ha))) *
          G (X_v γ ^ n)
      rw [hLift_awayMap G (hX γ) (hX α) (mul_comm _ _) hG_αγ hG_γ_unit,
        hLift_mk G (hX γ) hG_γ_unit n a ha]
      have hev₂_mk : IsLocalization.Away.lift (S := Localization.Away (X_v γ))
          (g := ev₂) (X_v γ) (hev_unit (φ_k (U_cov j)) (h j) γ)
          (algebraMap _ _ (HomogeneousLocalization.Away.mk 𝒜_L (hX γ) n a ha)) = ev₂ a := by
        have hm := hLift_mk ev₂ (hX γ) (hev_unit (φ_k (U_cov j)) (h j) γ) n a ha
        have h1 : ev₂ (X_v γ ^ n) = 1 := by
          rw [map_pow, hev_self, one_pow]
        simpa [h1] using hm
      rw [hev₂_mk, map_pow G (X_v γ) n, hScale_R n a ha_hom]

    have hProjEq : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ρ₁.comp (ψ_chart i α))) ≫ w_α α =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ρ₂.comp (ψ_chart j γ))) ≫ w_α γ := by
      have hw_L := AlgebraicGeometry.Proj.SpecMap_awayMap_awayι 𝒜_L (hX α) zero_lt_one (hX γ)
        (rfl : X_v α * X_v γ = X_v α * X_v γ)
      have hw_R := AlgebraicGeometry.Proj.SpecMap_awayMap_awayι 𝒜_L (hX γ) zero_lt_one (hX α)
        (mul_comm (X_v α) (X_v γ) : X_v α * X_v γ = X_v γ * X_v α)
      have hEqProj : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ.comp aw_L)) ≫
            AlgebraicGeometry.Proj.awayι 𝒜_L (X_v α) (hX α) zero_lt_one =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ.comp aw_R)) ≫
            AlgebraicGeometry.Proj.awayι 𝒜_L (X_v γ) (hX γ) zero_lt_one := by
        rw [CommRingCat.ofHom_comp aw_L θ, CommRingCat.ofHom_comp aw_R θ,
          AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp,
          Category.assoc, Category.assoc, hw_L, hw_R]
      rw [← hθ_L, ← hθ_R]
      exact hEqProj

    apply (cancel_epi eIso.hom).mp
    rw [← Category.assoc, he_fst, ← Category.assoc, he_snd]
    change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ₁) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_chart i α))) ≫ w_α α =
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ₂) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_chart j γ))) ≫ w_α γ
    rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
    exact hProjEq

  let Φ₀ : U_compl.toScheme ⟶ P_L.left :=
    AlgebraicGeometry.Scheme.Cover.glueMorphisms 𝒰 Φ_loc hGlue

  
  have hΦ₀_hom : Φ₀ ≫ P_L.hom = U_compl.ι ≫ X.hom := by
    apply AlgebraicGeometry.Scheme.Cover.hom_ext 𝒰
    intro p
    let i := p.down.1
    let α := p.down.2
    rw [← Category.assoc, AlgebraicGeometry.Scheme.Cover.ι_glueMorphisms 𝒰 Φ_loc hGlue p]
    change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_chart i α)) ≫ w_α α) ≫ P_L.hom =
      ι_chart i α ≫ U_compl.ι ≫ X.hom
    rw [hψ_of_hom (φ_k (U_cov i)) (h i) α]
    have hSplit : CommRingCat.ofHom
        ((algebraMap ↑(X.left.presheaf.obj (Opposite.op (U_cov i).1))
          (Localization.Away (h i α))).comp (φ_k (U_cov i))) =
        α_k (U_cov i) ≫
          CommRingCat.ofHom
            (algebraMap ↑(X.left.presheaf.obj (Opposite.op (U_cov i).1))
              (Localization.Away (h i α))) := by
      ext c; rfl
    rw [hSplit, AlgebraicGeometry.Spec.map_comp, hα_k_spec (U_cov i), ← Category.assoc,
      ← hFac_chart i α, Category.assoc]

  
  refine ⟨Φ₀, hU_compl, hCov, hSpan, hCocycle, hΦ₀_hom, ?_⟩
  intro i V hi α
  let R_i := ↑(X.left.presheaf.obj (Opposite.op (U_cov i).1))
  let R_V := ↑(X.left.presheaf.obj (Opposite.op V.1))
  let res_V : R_i →+* R_V := (X.left.presheaf.map (CategoryTheory.homOfLE hi).op).hom
  let h_V : Fin (L + 1) → R_V :=
    fun β => X.left.presheaf.map (CategoryTheory.homOfLE hi).op (h i β)

  have hSub_ex : ∀ δ : Fin (L + 1),
      ∃ ι_Vδ : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (h_V δ))) ⟶
          U_compl.toScheme,
        AlgebraicGeometry.IsOpenImmersion ι_Vδ ∧
        (ι_Vδ ≫ U_compl.ι =
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap R_V (Localization.Away (h_V δ)))) ≫ V.2.fromSpec) ∧
        (∀ y : U_compl.toScheme,
          y ∈ Set.range ι_Vδ.base ↔ U_compl.ι.base y ∈ X.left.basicOpen (h_V δ)) :=
    fun δ => hLiftSub i V hi h_V (fun _ => rfl) δ

  let ι_V : ∀ δ : Fin (L + 1),
      AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (h_V δ))) ⟶ U_compl.toScheme :=
    fun δ => Classical.choose (hSub_ex δ)
  have hOpen_V : ∀ δ : Fin (L + 1), AlgebraicGeometry.IsOpenImmersion (ι_V δ) :=
    fun δ => (Classical.choose_spec (hSub_ex δ)).1
  have hFac_V : ∀ δ : Fin (L + 1),
      ι_V δ ≫ U_compl.ι =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap R_V (Localization.Away (h_V δ)))) ≫ V.2.fromSpec :=
    fun δ => (Classical.choose_spec (hSub_ex δ)).2.1
  have hRange_V : ∀ (δ : Fin (L + 1)) (y : U_compl.toScheme),
      y ∈ Set.range (ι_V δ).base ↔ U_compl.ι.base y ∈ X.left.basicOpen (h_V δ) :=
    fun δ => (Classical.choose_spec (hSub_ex δ)).2.2

  let ψ_V : ∀ δ : Fin (L + 1),
      HomogeneousLocalization.Away 𝒜_L (MvPolynomial.X δ) →+* Localization.Away (h_V δ) :=
    fun δ => (Localization.awayMap res_V (h i δ)).comp (ψ_chart i δ)

  have hFactor_V : ∀ δ : Fin (L + 1),
      ι_V δ = AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (Localization.awayMap res_V (h i δ))) ≫ ι_chart i δ := by
    intro δ
    apply (cancel_mono U_compl.ι).mp
    rw [Category.assoc, hFac_V δ, hFac_chart i δ, ← Category.assoc,
      ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    have hAwayComp : (Localization.awayMap res_V (h i δ)).comp
        (algebraMap R_i (Localization.Away (h i δ))) =
        (algebraMap R_V (Localization.Away (h_V δ))).comp res_V := by
      exact IsLocalization.map_comp _
    rw [hAwayComp, CommRingCat.ofHom_comp res_V (algebraMap R_V (Localization.Away (h_V δ))),
      AlgebraicGeometry.Spec.map_comp, Category.assoc]
    exact congrArg
      (fun m => AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap R_V (Localization.Away (h_V δ)))) ≫ m)
      (AlgebraicGeometry.IsAffineOpen.map_fromSpec (U_cov i).2 V.2
        (CategoryTheory.homOfLE hi).op).symm

  have hComp_V : ∀ δ : Fin (L + 1),
      ι_V δ ≫ Φ₀ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_V δ)) ≫ w_α δ := by
    intro δ
    have hGlue_iδ : ι_chart i δ ≫ Φ₀ =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_chart i δ)) ≫ w_α δ :=
      AlgebraicGeometry.Scheme.Cover.ι_glueMorphisms 𝒰 Φ_loc hGlue ⟨(i, δ)⟩
    rw [hFactor_V δ, Category.assoc, hGlue_iδ, ← Category.assoc,
      ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]

  have hRatio_V : ∀ δ β : Fin (L + 1),
      ψ_V δ (HomogeneousLocalization.Away.isLocalizationElem (𝒜 := 𝒜_L) (hX δ) (hX β)) =
        IsLocalization.mk' (Localization.Away (h_V δ)) (h_V β)
          ⟨h_V δ, Submonoid.mem_powers (h_V δ)⟩ := by
    intro δ β
    dsimp [ψ_V, ψ_chart]
    rw [hψ_of_ratio (φ_k (U_cov i)) (h i) δ β]
    exact IsLocalization.map_mk' _ (h i β) ⟨h i δ, Submonoid.mem_powers (h i δ)⟩

  refine ⟨ι_V α, ψ_V α, hOpen_V α, hFac_V α, hComp_V α, ?_, hRatio_V α⟩
  ext y
  constructor
  · rintro ⟨hyV, hyΦ⟩
    obtain ⟨γ, hyBasic_γ⟩ := hCovSub i V hi y hyV
    obtain ⟨z, rfl⟩ := (hRange_V γ y).mpr hyBasic_γ
    have hz_pre : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_V γ)) ≫ w_α γ).base z ∈
        Set.range (w_α α).base := by
      rw [← hComp_V γ]
      exact hyΦ
    have hz_basic : z ∈ PrimeSpectrum.basicOpen
        (IsLocalization.mk' (Localization.Away (h_V γ)) (h_V α)
          ⟨h_V γ, Submonoid.mem_powers (h_V γ)⟩) := by
      rw [← hRatio_V γ α]
      exact (hProjPre α γ (ψ_V γ) z).mp hz_pre
    have hyBasic_α : U_compl.ι.base ((ι_V γ).base z) ∈ X.left.basicOpen (h_V α) := by
      have h1 := (hBasicMk V (h_V α) (h_V γ) z).mp hz_basic
      rwa [← hFac_V γ] at h1
    exact (hRange_V α ((ι_V γ).base z)).mpr hyBasic_α
  · rintro ⟨z, rfl⟩
    have hyBasic_α : U_compl.ι.base ((ι_V α).base z) ∈ X.left.basicOpen (h_V α) :=
      (hRange_V α ((ι_V α).base z)).mp ⟨z, rfl⟩
    refine ⟨X.left.basicOpen_le (h_V α) hyBasic_α, ?_⟩
    change (ι_V α ≫ Φ₀).base z ∈ Set.range (w_α α).base
    rw [hComp_V α]
    exact ⟨(AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_V α))).base z, rfl⟩

theorem weil_graph_closure_blowup_proper_surj_iso (k : Type u) [Field k]
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hIntX : AlgebraicGeometry.IsIntegral X.left)
    [TopologicalSpace.NoetherianSpace ↥X.left]
    (I : X.left.IdealSheafData)
    (hSupp : (I.support : Set X.left) ≠ Set.univ)
    (U_compl : X.left.Opens)
    (hU_compl : (U_compl : Set X.left) = (I.support : Set X.left)ᶜ)
    (L : ℕ)
    (Φ₀ : U_compl.toScheme ⟶ (weilProjectiveSpaceOver k L).left)
    (hΦ₀ : Φ₀ ≫ (weilProjectiveSpaceOver k L).hom = U_compl.ι ≫ X.hom) :
    let P_L := weilProjectiveSpaceOver k L
    let δ : U_compl.toScheme ⟶ CategoryTheory.Limits.pullback X.hom P_L.hom :=
      CategoryTheory.Limits.pullback.lift U_compl.ι Φ₀ hΦ₀.symm
    let π_left : δ.image ⟶ X.left :=
      δ.imageι ≫ CategoryTheory.Limits.pullback.fst X.hom P_L.hom
    AlgebraicGeometry.IsIntegral δ.image ∧
    AlgebraicGeometry.IsProper π_left ∧
    AlgebraicGeometry.Surjective π_left ∧
    (∀ (U₀ : X.left.Opens),
      Disjoint (U₀ : Set X.left) (I.support : Set X.left) →
      CategoryTheory.IsIso (π_left ∣_ U₀)) :=
by
  intro P_L δ π_left
  have hx₀_compl : ((I.support : Set X.left)ᶜ).Nonempty := Set.nonempty_compl.mpr hSupp
  rw [← hU_compl] at hx₀_compl
  obtain ⟨x₀, hx₀⟩ := hx₀_compl
  have _ : Nonempty ↥U_compl.toScheme := ⟨⟨x₀, hx₀⟩⟩
  have _ : AlgebraicGeometry.IsIntegral X.left := hIntX
  have _ : AlgebraicGeometry.IsIntegral U_compl.toScheme :=
    AlgebraicGeometry.isIntegral_of_isOpenImmersion U_compl.ι
  have _ : TopologicalSpace.NoetherianSpace ↥U_compl.toScheme :=
    U_compl.ι.isOpenEmbedding.toIsEmbedding.toIsInducing.noetherianSpace
  have _ : AlgebraicGeometry.QuasiCompact δ :=
    AlgebraicGeometry.quasiCompact_of_noetherianSpace_source δ
  have hDom : AlgebraicGeometry.IsDominant δ.toImage := inferInstance
  have _ : AlgebraicGeometry.IsClosedImmersion δ.imageι := inferInstance
  have h_toImage_π : δ.toImage ≫ π_left = U_compl.ι := by
    dsimp only [π_left, δ]
    rw [← Category.assoc, AlgebraicGeometry.Scheme.Hom.toImage_imageι,
      CategoryTheory.Limits.pullback.lift_fst]
  have _ : AlgebraicGeometry.IsReduced U_compl.toScheme :=
    AlgebraicGeometry.isReduced_of_isIntegral U_compl.toScheme
  have _ : AlgebraicGeometry.IsReduced δ.image := by
    let 𝒰 : δ.image.OpenCover := δ.ker.subschemeCover.openCover
    have hChart : ∀ V_aff : 𝒰.I₀, AlgebraicGeometry.IsReduced (𝒰.X V_aff) := by
      intro V_aff
      change AlgebraicGeometry.IsReduced
        (AlgebraicGeometry.Spec (CommRingCat.of
          (↑((CategoryTheory.Limits.pullback X.hom P_L.hom).presheaf.obj (Opposite.op V_aff.1)) ⧸
            δ.ker.ideal V_aff)))
      rw [AlgebraicGeometry.affine_isReduced_iff]
      dsimp only [CommRingCat.coe_of]
      rw [δ.ker_apply V_aff]
      exact isReduced_of_injective _ (RingHom.kerLift_injective (δ.app V_aff.1).hom)
    exact @AlgebraicGeometry.IsReduced.of_openCover δ.image 𝒰 hChart
  have hIrrU : IrreducibleSpace ↥U_compl.toScheme :=
    AlgebraicGeometry.irreducibleSpace_of_isIntegral U_compl.toScheme
  have hPreUniv : IsPreirreducible (Set.univ : Set ↥δ.image) := by
    have hPreRange : IsPreirreducible (Set.range δ.toImage.base) := by
      rw [← Set.image_univ]
      exact hIrrU.isPreirreducible_univ.image _ δ.toImage.continuous.continuousOn
    have hCl := hPreRange.closure
    rwa [hDom.denseRange.closure_range] at hCl
  have _ : IrreducibleSpace ↥δ.image :=
    { toPreirreducibleSpace := ⟨hPreUniv⟩
      toNonempty := ⟨δ.toImage.base hIrrU.toNonempty.some⟩ }
  have hInt_im : AlgebraicGeometry.IsIntegral δ.image :=
    AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced δ.image
  let 𝒜_L := MvPolynomial.homogeneousSubmodule (Fin (L + 1)) k
  let _ : GradedAlgebra 𝒜_L := MvPolynomial.gradedAlgebra
  have _ : IsScalarTower k (↥(𝒜_L 0)) (MvPolynomial (Fin (L + 1)) k) :=
    ⟨fun c x p => smul_mul_assoc c (x : MvPolynomial (Fin (L + 1)) k) p⟩
  have _ : Algebra.FiniteType (↥(𝒜_L 0)) (MvPolynomial (Fin (L + 1)) k) :=
    Algebra.FiniteType.of_restrictScalars_finiteType k (↥(𝒜_L 0)) (MvPolynomial (Fin (L + 1)) k)
  have _ : AlgebraicGeometry.IsProper (AlgebraicGeometry.Proj.toSpecZero 𝒜_L) := inferInstance
  have hBij : Function.Bijective (algebraMap k ↥(𝒜_L 0)) := by
    refine ⟨?_, ?_⟩
    · intro c₁ c₂ h
      rw [Algebra.algebraMap_eq_smul_one, Algebra.algebraMap_eq_smul_one] at h
      have h1 : (c₁ • (1 : ↥(𝒜_L 0))).1 = (c₂ • (1 : ↥(𝒜_L 0))).1 :=
        congrArg Subtype.val h
      change c₁ • (1 : MvPolynomial (Fin (L + 1)) k) =
          c₂ • (1 : MvPolynomial (Fin (L + 1)) k) at h1
      rw [← Algebra.algebraMap_eq_smul_one, ← Algebra.algebraMap_eq_smul_one,
        MvPolynomial.algebraMap_eq] at h1
      exact MvPolynomial.C_injective (Fin (L + 1)) k h1
    · intro x
      have hx : x.1 ∈ (1 : Submodule k (MvPolynomial (Fin (L + 1)) k)) := by
        simpa [𝒜_L, MvPolynomial.homogeneousSubmodule_zero] using x.2
      rw [Submodule.mem_one] at hx
      obtain ⟨c, hc⟩ := hx
      refine ⟨c, ?_⟩
      rw [Algebra.algebraMap_eq_smul_one]
      apply Subtype.ext
      change c • (1 : MvPolynomial (Fin (L + 1)) k) = x.1
      rwa [← Algebra.algebraMap_eq_smul_one]
  have _ : CategoryTheory.IsIso
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜_L 0)))) :=
    (AlgebraicGeometry.isIso_SpecMap_iff (f := CommRingCat.ofHom (algebraMap k ↥(𝒜_L 0)))).mpr hBij
  have _ : AlgebraicGeometry.IsProper P_L.hom := by
    change AlgebraicGeometry.IsProper
      (AlgebraicGeometry.Proj.toSpecZero 𝒜_L ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜_L 0))))
    exact inferInstance
  have hProp_π : AlgebraicGeometry.IsProper π_left := by
    dsimp only [π_left]
    exact inferInstance
  have hSurj_π : AlgebraicGeometry.Surjective π_left := by
    have hCl_range : IsClosed (Set.range ⇑π_left) :=
      π_left.isClosedMap.isClosed_range
    have hSub_range : (U_compl : Set X.left) ⊆ Set.range ⇑π_left := by
      intro x hx
      refine ⟨δ.toImage ⟨x, hx⟩, ?_⟩
      change (δ.toImage ≫ π_left) ⟨x, hx⟩ = U_compl.ι ⟨x, hx⟩
      rw [h_toImage_π]
    have _ : IrreducibleSpace ↥X.left :=
      @AlgebraicGeometry.irreducibleSpace_of_isIntegral X.left hIntX
    have hDense_U : Dense (U_compl : Set X.left) :=
      U_compl.isOpen.dense ⟨x₀, hx₀⟩
    have hUniv : (Set.univ : Set X.left) ⊆ Set.range ⇑π_left := by
      rw [← hDense_U.closure_eq]
      exact closure_minimal hSub_range hCl_range
    exact AlgebraicGeometry.Surjective.mk (fun x => hUniv (Set.mem_univ x))
  let V' : δ.image.Opens := (TopologicalSpace.Opens.map π_left.base).obj U_compl
  let g_U : V'.toScheme ⟶ U_compl.toScheme := π_left ∣_ U_compl
  have hPb_U : CategoryTheory.IsPullback g_U V'.ι U_compl.ι π_left :=
    AlgebraicGeometry.isPullback_morphismRestrict π_left U_compl
  have w_t : 𝟙 U_compl.toScheme ≫ U_compl.ι = δ.toImage ≫ π_left :=
    (Category.id_comp U_compl.ι).trans h_toImage_π.symm
  let t : U_compl.toScheme ⟶ V'.toScheme := hPb_U.lift (𝟙 U_compl.toScheme) δ.toImage w_t
  have ht_g : t ≫ g_U = 𝟙 U_compl.toScheme := hPb_U.lift_fst (𝟙 U_compl.toScheme) δ.toImage w_t
  have ht_ι : t ≫ V'.ι = δ.toImage := hPb_U.lift_snd (𝟙 U_compl.toScheme) δ.toImage w_t
  have _ : AlgebraicGeometry.IsDominant (t ≫ V'.ι) := by
    rwa [ht_ι]
  have _ : AlgebraicGeometry.IsDominant t :=
    AlgebraicGeometry.IsDominant.of_comp_of_isOpenImmersion t V'.ι
  have _ : AlgebraicGeometry.IsReduced V'.toScheme :=
    AlgebraicGeometry.isReduced_of_isOpenImmersion V'.ι
  have _ : AlgebraicGeometry.IsSeparated g_U := inferInstance
  have hg_t : g_U ≫ t = 𝟙 V'.toScheme := by
    refine AlgebraicGeometry.ext_of_isDominant_of_isSeparated g_U ?_ t ?_
    · rw [Category.assoc, ht_g, Category.comp_id, Category.id_comp]
    · rw [← Category.assoc, ht_g, Category.id_comp, Category.comp_id]
  have _ : CategoryTheory.IsIso g_U := ⟨⟨t, hg_t, ht_g⟩⟩
  refine ⟨hInt_im, hProp_π, hSurj_π, ?_⟩
  intro U₀ hDisj
  have hLE : U₀ ≤ U_compl := by
    change (U₀ : Set X.left) ⊆ (U_compl : Set X.left)
    rw [hU_compl]
    exact Set.subset_compl_iff_disjoint_right.mpr hDisj
  let V₀' : δ.image.Opens := (TopologicalSpace.Opens.map π_left.base).obj U₀
  have hLE' : V₀' ≤ V' := (TopologicalSpace.Opens.map π_left.base).monotone hLE
  let g₀ : V₀'.toScheme ⟶ U₀.toScheme := π_left ∣_ U₀
  let j_X : U₀.toScheme ⟶ U_compl.toScheme := X.left.homOfLE hLE
  let j_V : V₀'.toScheme ⟶ V'.toScheme := δ.image.homOfLE hLE'
  have hSq : j_V ≫ g_U = g₀ ≫ j_X := by
    rw [← CategoryTheory.cancel_mono U_compl.ι]
    calc
      (j_V ≫ g_U) ≫ U_compl.ι = j_V ≫ (g_U ≫ U_compl.ι) := Category.assoc _ _ _
      _ = j_V ≫ (V'.ι ≫ π_left) := by rw [AlgebraicGeometry.morphismRestrict_ι]
      _ = (j_V ≫ V'.ι) ≫ π_left := (Category.assoc _ _ _).symm
      _ = V₀'.ι ≫ π_left := by rw [δ.image.homOfLE_ι hLE']
      _ = g₀ ≫ U₀.ι := (AlgebraicGeometry.morphismRestrict_ι π_left U₀).symm
      _ = g₀ ≫ (j_X ≫ U_compl.ι) := by rw [X.left.homOfLE_ι hLE]
      _ = (g₀ ≫ j_X) ≫ U_compl.ι := (Category.assoc _ _ _).symm
  have hPb_outer : CategoryTheory.IsPullback (j_V ≫ V'.ι) g₀ π_left (j_X ≫ U_compl.ι) := by
    rw [δ.image.homOfLE_ι hLE', X.left.homOfLE_ι hLE]
    exact (AlgebraicGeometry.isPullback_morphismRestrict π_left U₀).flip
  have hPb_left : CategoryTheory.IsPullback g₀ j_V j_X g_U :=
    (CategoryTheory.IsPullback.of_right hPb_outer hSq hPb_U.flip).flip
  exact hPb_left.isIso_fst_of_isIso

theorem weil_flat_domain_localization_rees_equiv (R B' : Type u) [CommRing R] [IsDomain R] [CommRing B'] [Nontrivial B']
    (φ : R →+* B') (hFlat : φ.Flat)
    (s : R) (hs : s ≠ 0)
    (R_s : Type u) [CommRing R_s] [Algebra R R_s] [IsLocalization.Away s R_s]
    (r : ℕ) (g : Fin r → B') (hg_nzd : ∀ b : Fin r, g b ∈ nonZeroDivisors B') :
    let φ_s : R_s →+* Localization.Away (φ s) :=
      IsLocalization.Away.map R_s (Localization.Away (φ s)) φ s
    let g_s : Fin r → Localization.Away (φ s) :=
      fun a => algebraMap B' (Localization.Away (φ s)) (g a)
    IsDomain R_s ∧
    Nontrivial (Localization.Away (φ s)) ∧
    φ s ∈ nonZeroDivisors B' ∧
    φ_s.Flat ∧
    (∀ b : Fin r, g_s b ∈ nonZeroDivisors (Localization.Away (φ s))) ∧
    ∀ b : Fin r,
      let A_b := Algebra.adjoin B' (Set.range fun a : Fin r =>
        IsLocalization.mk' (Localization.Away (g b)) (g a) ⟨g b, Submonoid.mem_powers (g b)⟩)
      let A_sb := Algebra.adjoin (Localization.Away (φ s)) (Set.range fun a : Fin r =>
        IsLocalization.mk' (Localization.Away (g_s b)) (g_s a) ⟨g_s b, Submonoid.mem_powers (g_s b)⟩)
      ∃ e_sb : Localization.Away (algebraMap B' ↥A_b (φ s)) ≃+* ↥A_sb,
        ∀ x : B', e_sb (algebraMap ↥A_b _ (algebraMap B' ↥A_b x)) =
          algebraMap (Localization.Away (φ s)) ↥A_sb (algebraMap B' (Localization.Away (φ s)) x) :=
by
  intro φ_s g_s
  have hs_nzd : s ∈ nonZeroDivisors R := mem_nonZeroDivisors_of_ne_zero hs
  have hDom_Rs : IsDomain R_s :=
    IsLocalization.isDomain_of_le_nonZeroDivisors R_s (Submonoid.powers_le.mpr hs_nzd)
  have hφs_nzd : φ s ∈ nonZeroDivisors B' := by
    let _ : Algebra R B' := φ.toAlgebra
    have _ : Module.Flat R B' := RingHom.flat_algebraMap_iff.mp hFlat
    have hReg : IsSMulRegular B' s :=
      Module.Flat.isSMulRegular_of_nonZeroDivisors hs_nzd
    rw [mem_nonZeroDivisors_iff_left]
    intro x hx
    have hsmul : s • x = 0 := by
      rw [Algebra.smul_def, RingHom.algebraMap_toAlgebra]
      exact hx
    exact hReg.right_eq_zero_of_smul hsmul
  let B'_s := Localization.Away (φ s)
  have hInj_Bs : Function.Injective (algebraMap B' B'_s) :=
    IsLocalization.injective B'_s (Submonoid.powers_le.mpr hφs_nzd)
  have hNontriv_Bs : Nontrivial B'_s := hInj_Bs.nontrivial
  have hFlat_φs : φ_s.Flat := by
    have hFlat_locB : (algebraMap B' B'_s).Flat := by
      rw [RingHom.flat_algebraMap_iff]
      exact IsLocalization.flat B'_s (Submonoid.powers (φ s))
    let θ_RB : R →+* B'_s := (algebraMap B' B'_s).comp φ
    have hFlat_RB : θ_RB.Flat := RingHom.Flat.comp hFlat hFlat_locB
    have h_comp : φ_s.comp (algebraMap R R_s) = θ_RB := by
      dsimp only [φ_s, θ_RB, B'_s, IsLocalization.Away.map]
      exact IsLocalization.map_comp _
    let _ : Algebra R B'_s := θ_RB.toAlgebra
    have hModFlat_R : Module.Flat R B'_s := RingHom.flat_algebraMap_iff.mp hFlat_RB
    let _ : Algebra R_s B'_s := φ_s.toAlgebra
    have _ : IsScalarTower R R_s B'_s := IsScalarTower.of_algebraMap_eq' (by
      rw [RingHom.algebraMap_toAlgebra, RingHom.algebraMap_toAlgebra, h_comp])
    exact RingHom.flat_algebraMap_iff.mpr
      ((Module.flat_iff_of_isLocalization R_s (Submonoid.powers s) B'_s).mpr hModFlat_R)
  have hg_s_nzd : ∀ b : Fin r, g_s b ∈ nonZeroDivisors B'_s := by
    intro b
    rw [mem_nonZeroDivisors_iff_right]
    intro z hz
    obtain ⟨⟨y, m⟩, hzm⟩ := IsLocalization.surj (Submonoid.powers (φ s)) z
    have hy0 : y * g b = 0 := by
      apply hInj_Bs
      calc
        algebraMap B' B'_s (y * g b)
            = algebraMap B' B'_s y * g_s b := map_mul _ y (g b)
        _ = (z * algebraMap B' B'_s ↑m) * g_s b := by rw [← hzm]
        _ = (z * g_s b) * algebraMap B' B'_s ↑m := by ring
        _ = 0 * algebraMap B' B'_s ↑m := by rw [hz]
        _ = 0 := zero_mul _
        _ = algebraMap B' B'_s 0 := (map_zero _).symm
    have hy : y = 0 := (mem_nonZeroDivisors_iff_right.mp (hg_nzd b)) y hy0
    rw [hy, map_zero] at hzm
    exact (IsUnit.mul_left_eq_zero (IsLocalization.map_units B'_s m)).mp hzm
  refine ⟨hDom_Rs, hNontriv_Bs, hφs_nzd, hFlat_φs, hg_s_nzd, ?_⟩
  intro b A_b A_sb
  let L_b := Localization.Away (g b)
  let L_sb := Localization.Away (g_s b)
  let u_gen : Fin r → L_b := fun a =>
    IsLocalization.mk' L_b (g a) ⟨g b, Submonoid.mem_powers (g b)⟩
  let v_gen : Fin r → L_sb := fun a =>
    IsLocalization.mk' L_sb (g_s a) ⟨g_s b, Submonoid.mem_powers (g_s b)⟩
  have hInj_Lsb : Function.Injective (algebraMap B'_s L_sb) :=
    IsLocalization.injective L_sb (Submonoid.powers_le.mpr (hg_s_nzd b))
  let θ₀ : B' →+* L_sb := (algebraMap B'_s L_sb).comp (algebraMap B' B'_s)
  have hInj_θ₀ : Function.Injective θ₀ := hInj_Lsb.comp hInj_Bs
  have hUnit_gb : IsUnit (θ₀ (g b)) := by
    change IsUnit (algebraMap B'_s L_sb (g_s b))
    exact IsLocalization.Away.algebraMap_isUnit (g_s b)
  let Ψ_amb : L_b →+* L_sb := IsLocalization.Away.lift (g b) hUnit_gb
  have hΨ_ugen : ∀ a : Fin r, Ψ_amb (u_gen a) = v_gen a := by
    intro a
    rw [IsLocalization.eq_mk'_iff_mul_eq]
    have hspec := congrArg Ψ_amb
      (IsLocalization.mk'_spec L_b (g a) ⟨g b, Submonoid.mem_powers (g b)⟩)
    rw [map_mul] at hspec
    dsimp only [Ψ_amb] at hspec ⊢
    rw [IsLocalization.Away.lift_eq (g b) hUnit_gb (g b),
      IsLocalization.Away.lift_eq (g b) hUnit_gb (g a)] at hspec
    exact hspec
  have hInj_Ψ : Function.Injective Ψ_amb := by
    rw [injective_iff_map_eq_zero]
    intro z hz
    obtain ⟨⟨x₀, m⟩, hzm⟩ := IsLocalization.surj (Submonoid.powers (g b)) z
    have hx₀ : x₀ = 0 := by
      apply hInj_θ₀
      have hmap := congrArg Ψ_amb hzm
      rw [map_mul, hz, zero_mul] at hmap
      dsimp only [Ψ_amb] at hmap
      rw [IsLocalization.Away.lift_eq (g b) hUnit_gb x₀] at hmap
      rw [← hmap, map_zero]
    rw [hx₀, map_zero] at hzm
    exact (IsUnit.mul_left_eq_zero (IsLocalization.map_units L_b m)).mp hzm
  have hMem_Asb : ∀ w ∈ A_b, Ψ_amb w ∈ A_sb := by
    intro w hw
    change w ∈ Algebra.adjoin B' (Set.range u_gen) at hw
    rw [Algebra.mem_adjoin_iff] at hw
    have hle : Subring.closure (Set.range (algebraMap B' L_b) ∪ Set.range u_gen) ≤
        A_sb.toSubring.comap Ψ_amb := by
      rw [Subring.closure_le, Set.union_subset_iff]
      refine ⟨?_, ?_⟩
      · rintro _ ⟨x, rfl⟩
        rw [SetLike.mem_coe, Subring.mem_comap]
        change Ψ_amb (algebraMap B' L_b x) ∈ A_sb
        dsimp only [Ψ_amb]
        rw [IsLocalization.Away.lift_eq (g b) hUnit_gb x]
        exact A_sb.algebraMap_mem (algebraMap B' B'_s x)
      · rintro _ ⟨a, rfl⟩
        rw [SetLike.mem_coe, Subring.mem_comap]
        change Ψ_amb (u_gen a) ∈ A_sb
        rw [hΨ_ugen a]
        exact Algebra.subset_adjoin ⟨a, rfl⟩
    exact Subring.mem_comap.mp (hle hw)
  let _ : CommRing ↥A_b := A_b.toCommRing
  let _ : CommRing ↥A_sb := A_sb.toCommRing
  let ψ : ↥A_b →+* ↥A_sb :=
    (Ψ_amb.comp A_b.val.toRingHom).codRestrict A_sb.toSubring (fun y => hMem_Asb y.1 y.2)
  have hψ_val : ∀ y : ↥A_b, (ψ y).1 = Ψ_amb y.1 := fun y =>
    RingHom.codRestrict_apply _ A_sb.toSubring _ y
  have hInj_ψ : Function.Injective ψ := by
    intro y₁ y₂ hy
    apply Subtype.ext
    apply hInj_Ψ
    rw [← hψ_val y₁, ← hψ_val y₂, hy]
  have hψ_B : ∀ x : B', ψ (algebraMap B' ↥A_b x) =
      algebraMap B'_s ↥A_sb (algebraMap B' B'_s x) := by
    intro x
    apply Subtype.ext
    rw [hψ_val]
    change Ψ_amb ((algebraMap B' ↥A_b x).1) = (algebraMap B'_s ↥A_sb (algebraMap B' B'_s x)).1
    rw [Subalgebra.coe_algebraMap, Subalgebra.coe_algebraMap]
    dsimp only [Ψ_amb]
    exact IsLocalization.Away.lift_eq (g b) hUnit_gb x
  let t_s : ↥A_b := algebraMap B' ↥A_b (φ s)
  have hUnit_ts : IsUnit (ψ t_s) := by
    dsimp only [t_s]
    rw [hψ_B (φ s)]
    exact IsUnit.map (algebraMap B'_s ↥A_sb)
      (IsLocalization.Away.algebraMap_isUnit (S := B'_s) (φ s))
  let F : Localization.Away t_s →+* ↥A_sb := IsLocalization.Away.lift t_s hUnit_ts
  have hInj_F : Function.Injective F := by
    rw [injective_iff_map_eq_zero]
    intro z hz
    obtain ⟨⟨y, m⟩, hzm⟩ := IsLocalization.surj (Submonoid.powers t_s) z
    have hy : y = 0 := by
      apply hInj_ψ
      have hmap := congrArg F hzm
      rw [map_mul, hz, zero_mul] at hmap
      dsimp only [F] at hmap
      rw [IsLocalization.Away.lift_eq t_s hUnit_ts y] at hmap
      rw [← hmap, map_zero]
    rw [hy, map_zero] at hzm
    exact (IsUnit.mul_left_eq_zero
      (IsLocalization.map_units (Localization.Away t_s) m)).mp hzm
  have hSurj_F : Function.Surjective F := by
    let S_img : Subring L_sb := (A_sb.val.toRingHom.comp F).range
    have hSub : Subring.closure (Set.range (algebraMap B'_s L_sb) ∪ Set.range v_gen) ≤ S_img := by
      rw [Subring.closure_le, Set.union_subset_iff]
      refine ⟨?_, ?_⟩
      · rintro _ ⟨q, rfl⟩
        rw [SetLike.mem_coe, RingHom.mem_range]
        obtain ⟨⟨x₀, m₀⟩, hqm⟩ := IsLocalization.surj (Submonoid.powers (φ s)) q
        obtain ⟨n, hn⟩ := (Submonoid.mem_powers_iff m₀.1 (φ s)).mp m₀.2
        let w_q : Localization.Away t_s :=
          IsLocalization.mk' (Localization.Away t_s) (algebraMap B' ↥A_b x₀)
            ⟨t_s ^ n, Submonoid.pow_mem _ (Submonoid.mem_powers t_s) n⟩
        refine ⟨w_q, ?_⟩
        have hspec := congrArg (A_sb.val.toRingHom.comp F)
          (IsLocalization.mk'_spec (Localization.Away t_s) (algebraMap B' ↥A_b x₀)
            ⟨t_s ^ n, Submonoid.pow_mem _ (Submonoid.mem_powers t_s) n⟩)
        rw [map_mul] at hspec
        have hF_num : (A_sb.val.toRingHom.comp F)
            (algebraMap ↥A_b (Localization.Away t_s) (algebraMap B' ↥A_b x₀)) =
            algebraMap B'_s L_sb (algebraMap B' B'_s x₀) := by
          change (F (algebraMap ↥A_b (Localization.Away t_s) (algebraMap B' ↥A_b x₀))).1 = _
          dsimp only [F]
          rw [IsLocalization.Away.lift_eq t_s hUnit_ts, hψ_B x₀, Subalgebra.coe_algebraMap]
        have hF_den : (A_sb.val.toRingHom.comp F)
            (algebraMap ↥A_b (Localization.Away t_s) (t_s ^ n)) =
            algebraMap B'_s L_sb (algebraMap B' B'_s m₀.1) := by
          have hpow : t_s ^ n = algebraMap B' ↥A_b m₀.1 := by
            dsimp only [t_s]
            rw [← map_pow, hn]
          rw [hpow]
          change (F (algebraMap ↥A_b (Localization.Away t_s) (algebraMap B' ↥A_b m₀.1))).1 = _
          dsimp only [F]
          rw [IsLocalization.Away.lift_eq t_s hUnit_ts, hψ_B m₀.1, Subalgebra.coe_algebraMap]
        change (A_sb.val.toRingHom.comp F) w_q *
            (A_sb.val.toRingHom.comp F) (algebraMap ↥A_b (Localization.Away t_s) (t_s ^ n)) =
          (A_sb.val.toRingHom.comp F)
            (algebraMap ↥A_b (Localization.Away t_s) (algebraMap B' ↥A_b x₀)) at hspec
        rw [hF_den, hF_num, ← hqm, map_mul] at hspec
        have hUnit_m₀ : IsUnit (algebraMap B'_s L_sb (algebraMap B' B'_s m₀.1)) :=
          IsUnit.map (algebraMap B'_s L_sb) (IsLocalization.map_units B'_s m₀)
        exact IsUnit.mul_right_cancel hUnit_m₀ hspec
      · rintro _ ⟨a, rfl⟩
        rw [SetLike.mem_coe, RingHom.mem_range]
        let y_a : ↥A_b := ⟨u_gen a, Algebra.subset_adjoin ⟨a, rfl⟩⟩
        refine ⟨algebraMap ↥A_b (Localization.Away t_s) y_a, ?_⟩
        change (F (algebraMap ↥A_b (Localization.Away t_s) y_a)).1 = v_gen a
        dsimp only [F]
        rw [IsLocalization.Away.lift_eq t_s hUnit_ts y_a, hψ_val y_a]
        exact hΨ_ugen a
    intro z
    have hz_mem : z.1 ∈ A_sb := z.2
    change z.1 ∈ Algebra.adjoin B'_s (Set.range v_gen) at hz_mem
    rw [Algebra.mem_adjoin_iff] at hz_mem
    have hz_img : z.1 ∈ S_img := hSub hz_mem
    rw [RingHom.mem_range] at hz_img
    obtain ⟨w, hw⟩ := hz_img
    exact ⟨w, Subtype.ext hw⟩
  let e_sb : Localization.Away t_s ≃+* ↥A_sb := RingEquiv.ofBijective F ⟨hInj_F, hSurj_F⟩
  refine ⟨e_sb, fun x => ?_⟩
  change F (algebraMap ↥A_b (Localization.Away t_s) (algebraMap B' ↥A_b x)) = _
  dsimp only [F]
  rw [IsLocalization.Away.lift_eq t_s hUnit_ts, hψ_B x]

theorem weil_flat_rees_tensor_and_generator_swap (R B' : Type u) [CommRing R] [IsDomain R] [CommRing B'] [Nontrivial B']
    [Algebra R B'] [Module.Flat R B']
    (L r : ℕ) (h_R : Fin (L + 1) → R) (g : Fin r → B')
    (hg_nzd : ∀ b : Fin r, g b ∈ nonZeroDivisors B')
    (hSpan : Ideal.span (Set.range (algebraMap R B' ∘ h_R)) = Ideal.span (Set.range g)) :
    let R_chart : ∀ α : Fin (L + 1), Subalgebra R (Localization.Away (h_R α)) := fun α =>
      Algebra.adjoin R (Set.range fun β : Fin (L + 1) =>
        IsLocalization.mk' (Localization.Away (h_R α)) (h_R β) ⟨h_R α, Submonoid.mem_powers (h_R α)⟩)
    let B_chart : ∀ α : Fin (L + 1), Subalgebra B' (Localization.Away (algebraMap R B' (h_R α))) := fun α =>
      Algebra.adjoin B' (Set.range fun β : Fin (L + 1) =>
        IsLocalization.mk' (Localization.Away (algebraMap R B' (h_R α)))
          (algebraMap R B' (h_R β))
          ⟨algebraMap R B' (h_R α), Submonoid.mem_powers (algebraMap R B' (h_R α))⟩)
    let A_rees : ∀ b : Fin r, Subalgebra B' (Localization.Away (g b)) := fun b =>
      Algebra.adjoin B' (Set.range fun a : Fin r =>
        IsLocalization.mk' (Localization.Away (g b)) (g a) ⟨g b, Submonoid.mem_powers (g b)⟩)
    (∀ α : Fin (L + 1), h_R α = 0 → Subsingleton (TensorProduct R B' ↥(R_chart α))) ∧
    ∃ (η : ∀ b : Fin r, Fin (L + 1) → ↥(A_rees b)),
      (∀ b : Fin r,
        Ideal.span (Set.range fun p : {α : Fin (L + 1) // h_R α ≠ 0} => η b p.1) = ⊤) ∧
      ∀ (α : Fin (L + 1)), h_R α ≠ 0 →
        ∃ (τ_α : TensorProduct R B' ↥(R_chart α) ≃ₐ[B'] ↥(B_chart α))
          (ξ_α : Fin r → ↥(B_chart α)),
          (∀ (x : B') (y : ↥(R_chart α)),
            (τ_α (x ⊗ₜ[R] y)).1 =
              algebraMap B' (Localization.Away (algebraMap R B' (h_R α))) x *
                IsLocalization.Away.map (Localization.Away (h_R α))
                  (Localization.Away (algebraMap R B' (h_R α))) (algebraMap R B') (h_R α) y.1) ∧
          Ideal.span (Set.range ξ_α) = ⊤ ∧
          ∀ b : Fin r,
            ∃ ϕ : Localization.Away (ξ_α b) ≃+* Localization.Away (η b α),
              (∀ x : B',
                ϕ (algebraMap ↥(B_chart α) (Localization.Away (ξ_α b))
                  (algebraMap B' ↥(B_chart α) x)) =
                algebraMap ↥(A_rees b) (Localization.Away (η b α))
                  (algebraMap B' ↥(A_rees b) x)) ∧
              ∀ (β : Fin (L + 1)) (y : ↥(B_chart α)),
                y.1 = IsLocalization.mk' (Localization.Away (algebraMap R B' (h_R α)))
                  (algebraMap R B' (h_R β))
                  ⟨algebraMap R B' (h_R α), Submonoid.mem_powers (algebraMap R B' (h_R α))⟩ →
                ϕ (algebraMap ↥(B_chart α) (Localization.Away (ξ_α b)) y) =
                  IsLocalization.mk' (Localization.Away (η b α)) (η b β)
                    ⟨η b α, Submonoid.mem_powers (η b α)⟩ :=
by
  intro R_chart B_chart A_rees
  
  have hSubZero : ∀ α : Fin (L + 1), h_R α = 0 →
      Subsingleton (TensorProduct R B' ↥(R_chart α)) := by
    intro α hα0
    have h0_mem : (0 : R) ∈ Submonoid.powers (h_R α) := ⟨1, by simp [hα0]⟩
    have : Subsingleton (Localization.Away (h_R α)) :=
      IsLocalization.subsingleton h0_mem
    have : Subsingleton ↥(R_chart α) := Subtype.val_injective.subsingleton
    have hid0 : (LinearMap.id : TensorProduct R B' ↥(R_chart α) →ₗ[R]
        TensorProduct R B' ↥(R_chart α)) = 0 := by
      apply TensorProduct.ext'
      intro x y
      change x ⊗ₜ[R] y = 0
      rw [Subsingleton.elim y 0, TensorProduct.tmul_zero]
    refine ⟨fun z₁ z₂ => ?_⟩
    have hz0 : ∀ z : TensorProduct R B' ↥(R_chart α), z = 0 := fun z => by
      have hz := LinearMap.ext_iff.mp hid0 z
      rwa [LinearMap.id_apply, LinearMap.zero_apply] at hz
    rw [hz0 z₁, hz0 z₂]

  
  have h_nzd_hR : ∀ α : Fin (L + 1), h_R α ≠ 0 →
      algebraMap R B' (h_R α) ∈ nonZeroDivisors B' := by
    intro α hα
    rw [mem_nonZeroDivisors_iff_right]
    intro x hx
    let f : R →ₗ[R] R := LinearMap.mulLeft R (h_R α)
    have hf_inj : Function.Injective f := fun r₁ r₂ hr => mul_right_injective₀ hα hr
    have hlT_inj : Function.Injective (LinearMap.lTensor B' f) :=
      Module.Flat.lTensor_preserves_injective_linearMap f hf_inj
    have h0 : LinearMap.lTensor B' f (x ⊗ₜ[R] (1 : R)) = 0 := by
      rw [LinearMap.lTensor_tmul]
      change x ⊗ₜ[R] (h_R α * (1 : R)) = 0
      rw [← smul_eq_mul (h_R α) (1 : R), ← TensorProduct.smul_tmul,
        Algebra.smul_def, mul_comm, hx, TensorProduct.zero_tmul]
    have hx1 : x ⊗ₜ[R] (1 : R) = 0 := hlT_inj (h0.trans (map_zero _).symm)
    have hrid := congrArg (TensorProduct.rid R B') hx1
    simpa using hrid

  
  have hTensor : ∀ α : Fin (L + 1),
      ∃ τ_α : TensorProduct R B' ↥(R_chart α) ≃ₐ[B'] ↥(B_chart α),
        ∀ (x : B') (y : ↥(R_chart α)),
          (τ_α (x ⊗ₜ[R] y)).1 =
            algebraMap B' (Localization.Away (algebraMap R B' (h_R α))) x *
              IsLocalization.Away.map (Localization.Away (h_R α))
                (Localization.Away (algebraMap R B' (h_R α))) (algebraMap R B') (h_R α) y.1 := by
    intro α
    let S_R := Localization.Away (h_R α)
    let S_B := Localization.Away (algebraMap R B' (h_R α))
    let M_α : TensorProduct R B' ↥(R_chart α) →ₐ[B'] TensorProduct R B' S_R :=
      Algebra.TensorProduct.map (AlgHom.id B' B') (R_chart α).val
    have hM_eq : M_α.toLinearMap.restrictScalars R =
        LinearMap.lTensor B' (R_chart α).val.toLinearMap := by
      apply TensorProduct.ext'
      intro x y
      rfl
    have hM_inj : Function.Injective M_α := by
      have hlin : Function.Injective (M_α.toLinearMap.restrictScalars R) := by
        rw [hM_eq]
        exact Module.Flat.lTensor_preserves_injective_linearMap
          (R_chart α).val.toLinearMap Subtype.val_injective
      exact hlin
    let E_α : TensorProduct R B' S_R ≃ₐ[B'] S_B :=
      IsLocalization.Away.tensorEquiv B' (h_R α) S_R
    let T_α : TensorProduct R B' ↥(R_chart α) →ₐ[B'] S_B := E_α.toAlgHom.comp M_α
    have hT_inj : Function.Injective T_α := E_α.injective.comp hM_inj
    let g₁ : S_R →+* S_B :=
      E_α.toAlgHom.toRingHom.comp Algebra.TensorProduct.includeRight.toRingHom
    let g₂ : S_R →+* S_B :=
      IsLocalization.Away.map S_R S_B (algebraMap R B') (h_R α)
    have hg_eq : g₁ = g₂ := by
      apply IsLocalization.ringHom_ext (Submonoid.powers (h_R α))
      ext r
      simp only [RingHom.comp_apply, g₁]
      have h1 : E_α (Algebra.TensorProduct.includeRight (algebraMap R S_R r)) =
          algebraMap B' S_B (algebraMap R B' r) := by
        change E_α ((1 : B') ⊗ₜ[R] algebraMap R S_R r) = _
        rw [Algebra.algebraMap_eq_smul_one (A := S_R) r, ← TensorProduct.smul_tmul,
          Algebra.smul_def, mul_one]
        exact E_α.commutes (algebraMap R B' r)
      have h2 : g₂ (algebraMap R S_R r) = algebraMap B' S_B (algebraMap R B' r) := by
        dsimp [g₂, IsLocalization.Away.map]
        exact IsLocalization.map_eq _ r
      exact h1.trans h2.symm
    have hT_tmul : ∀ (x : B') (y : ↥(R_chart α)),
        T_α (x ⊗ₜ[R] y) = algebraMap B' S_B x * g₂ y.1 := by
      intro x y
      have hmul : (x ⊗ₜ[R] y.1 : TensorProduct R B' S_R) =
          (x ⊗ₜ[R] (1 : S_R)) * ((1 : B') ⊗ₜ[R] y.1) := by
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      change E_α (x ⊗ₜ[R] y.1) = _
      rw [hmul, map_mul]
      have hx_eq : E_α (x ⊗ₜ[R] (1 : S_R)) = algebraMap B' S_B x := E_α.commutes x
      have hy_eq : E_α ((1 : B') ⊗ₜ[R] y.1) = g₂ y.1 := by
        rw [← hg_eq]; rfl
      rw [hx_eq, hy_eq]
    have hg₂_mem : ∀ z ∈ R_chart α, g₂ z ∈ B_chart α := by
      intro z hz
      refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hz
      · rintro u ⟨β, rfl⟩
        have hmk : g₂ (IsLocalization.mk' S_R (h_R β) ⟨h_R α, Submonoid.mem_powers (h_R α)⟩) =
            IsLocalization.mk' S_B (algebraMap R B' (h_R β))
              ⟨algebraMap R B' (h_R α), Submonoid.mem_powers (algebraMap R B' (h_R α))⟩ := by
          dsimp [g₂, IsLocalization.Away.map]
          exact IsLocalization.map_mk' _ (h_R β) ⟨h_R α, Submonoid.mem_powers (h_R α)⟩
        rw [hmk]
        exact Algebra.subset_adjoin ⟨β, rfl⟩
      · intro r
        have h2 : g₂ (algebraMap R S_R r) = algebraMap B' S_B (algebraMap R B' r) := by
          dsimp [g₂, IsLocalization.Away.map]
          exact IsLocalization.map_eq _ r
        rw [h2]
        exact (B_chart α).algebraMap_mem (algebraMap R B' r)
      · intro u v _ _ hu hv
        rw [map_add]
        exact (B_chart α).add_mem hu hv
      · intro u v _ _ hu hv
        rw [map_mul]
        exact (B_chart α).mul_mem hu hv
    have hRange : T_α.range = B_chart α := by
      apply le_antisymm
      · let P : Submodule R (TensorProduct R B' ↥(R_chart α)) :=
          { carrier := {z | T_α z ∈ B_chart α}
            zero_mem' := by
              change T_α 0 ∈ B_chart α
              rw [map_zero]
              exact (B_chart α).zero_mem
            add_mem' := fun {u v} hu hv => by
              change T_α (u + v) ∈ B_chart α
              rw [map_add]
              exact (B_chart α).add_mem hu hv
            smul_mem' := fun r {u} hu => by
              change T_α (r • u) ∈ B_chart α
              have hsmul : (r • u : TensorProduct R B' ↥(R_chart α)) = (algebraMap R B' r) • u :=
                (IsScalarTower.algebraMap_smul B' r u).symm
              rw [hsmul, map_smul]
              exact (B_chart α).toSubmodule.smul_mem (algebraMap R B' r) hu }
        have hmkQ : P.mkQ = 0 := by
          apply TensorProduct.ext'
          intro x y
          rw [LinearMap.zero_apply, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
          change T_α (x ⊗ₜ[R] y) ∈ B_chart α
          rw [hT_tmul x y]
          exact (B_chart α).mul_mem ((B_chart α).algebraMap_mem x) (hg₂_mem y.1 y.2)
        rintro w ⟨z, rfl⟩
        have hzP : z ∈ P := by
          rw [← Submodule.Quotient.mk_eq_zero, ← Submodule.mkQ_apply]
          simpa using LinearMap.ext_iff.mp hmkQ z
        exact hzP
      · dsimp [B_chart]
        rw [Algebra.adjoin_le_iff]
        rintro w ⟨β, rfl⟩
        let y_β : ↥(R_chart α) :=
          ⟨IsLocalization.mk' S_R (h_R β) ⟨h_R α, Submonoid.mem_powers (h_R α)⟩,
            Algebra.subset_adjoin ⟨β, rfl⟩⟩
        refine ⟨(1 : B') ⊗ₜ[R] y_β, ?_⟩
        change T_α (1 ⊗ₜ[R] y_β) = _
        rw [hT_tmul 1 y_β, map_one, one_mul]
        dsimp [y_β, g₂, IsLocalization.Away.map]
        exact IsLocalization.map_mk' _ (h_R β) ⟨h_R α, Submonoid.mem_powers (h_R α)⟩
    have hEquivVal : ∀ (S T : Subalgebra B' S_B) (h : S = T) (u : ↥S),
        (Subalgebra.equivOfEq S T h u).1 = u.1 := by
      rintro S _ rfl u; rfl
    let τ_α : TensorProduct R B' ↥(R_chart α) ≃ₐ[B'] ↥(B_chart α) :=
      (AlgEquiv.ofInjective T_α hT_inj).trans (Subalgebra.equivOfEq T_α.range (B_chart α) hRange)
    refine ⟨τ_α, fun x y => ?_⟩
    dsimp [τ_α]
    rw [hEquivVal, AlgEquiv.ofInjective_apply, hT_tmul]

  
  have hTransition : ∀ {ι κ : Type} [Fintype ι] [Fintype κ]
      (u : ι → B') (v : κ → B')
      (_hSpan_uv : Ideal.span (Set.range u) = Ideal.span (Set.range v))
      (P : ι → Prop) (_hZero : ∀ i : ι, ¬ P i → u i = 0)
      (j : κ) (A_j : Subalgebra B' (Localization.Away (v j))),
      A_j = Algebra.adjoin B' (Set.range fun k : κ =>
        IsLocalization.mk' (Localization.Away (v j)) (v k) ⟨v j, Submonoid.mem_powers (v j)⟩) →
      ∃ θ : ι → ↥A_j,
        (∀ i : ι, (θ i).1 =
          IsLocalization.mk' (Localization.Away (v j)) (u i) ⟨v j, Submonoid.mem_powers (v j)⟩) ∧
        Ideal.span (Set.range fun p : {i : ι // P i} => θ p.1) = ⊤ := by
    intro ι κ _ _ u v hSpan_uv P hZero j A_j hA_j
    have hu_mem : ∀ i : ι, ∃ d_i : κ → B', ∑ k : κ, d_i k * v k = u i := by
      intro i
      rw [← Ideal.mem_span_range_iff_exists_fun, ← hSpan_uv]
      exact Ideal.subset_span ⟨i, rfl⟩
    choose d hd using hu_mem
    let gen_v : κ → ↥A_j := fun k =>
      ⟨IsLocalization.mk' (Localization.Away (v j)) (v k) ⟨v j, Submonoid.mem_powers (v j)⟩, by
        rw [hA_j]; exact Algebra.subset_adjoin ⟨k, rfl⟩⟩
    let θ : ι → ↥A_j := fun i => ∑ k : κ, algebraMap B' ↥A_j (d i k) * gen_v k
    have hθ_val : ∀ i : ι, (θ i).1 =
        IsLocalization.mk' (Localization.Away (v j)) (u i) ⟨v j, Submonoid.mem_powers (v j)⟩ := by
      intro i
      change A_j.val (∑ k : κ, algebraMap B' ↥A_j (d i k) * gen_v k) = _
      rw [map_sum]
      have hterm : ∀ k : κ, A_j.val (algebraMap B' ↥A_j (d i k) * gen_v k) =
          algebraMap B' (Localization.Away (v j)) (d i k * v k) *
            IsLocalization.mk' (Localization.Away (v j)) 1 ⟨v j, Submonoid.mem_powers (v j)⟩ := by
        intro k
        rw [map_mul, AlgHom.commutes]
        change algebraMap B' _ (d i k) *
            IsLocalization.mk' (Localization.Away (v j)) (v k) ⟨v j, Submonoid.mem_powers (v j)⟩ = _
        rw [IsLocalization.mk'_eq_mul_mk'_one, ← mul_assoc, ← map_mul]
      simp_rw [hterm, ← Finset.sum_mul, ← map_sum, hd i, ← IsLocalization.mk'_eq_mul_mk'_one]
    have hv_mem : ∃ c : ι → B', ∑ i : ι, c i * u i = v j := by
      rw [← Ideal.mem_span_range_iff_exists_fun, hSpan_uv]
      exact Ideal.subset_span ⟨j, rfl⟩
    obtain ⟨c, hc⟩ := hv_mem
    refine ⟨θ, hθ_val, ?_⟩
    rw [Ideal.eq_top_iff_one]
    let S_one : ↥A_j := ∑ i : ι, algebraMap B' ↥A_j (c i) * θ i
    have hS_mem : S_one ∈ Ideal.span (Set.range fun p : {i : ι // P i} => θ p.1) := by
      refine Submodule.sum_mem _ fun i _ => ?_
      by_cases hPi : P i
      · exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨⟨i, hPi⟩, rfl⟩)
      · have hu0 : u i = 0 := hZero i hPi
        have hθ0 : θ i = 0 := by
          apply Subtype.ext
          rw [hθ_val i, hu0, IsLocalization.mk'_zero]
          rfl
        rw [hθ0, mul_zero]
        exact Submodule.zero_mem _
    have hS_eq_one : S_one = 1 := by
      apply Subtype.ext
      change A_j.val (∑ i : ι, algebraMap B' ↥A_j (c i) * θ i) = 1
      rw [map_sum]
      have hterm : ∀ i : ι, A_j.val (algebraMap B' ↥A_j (c i) * θ i) =
          algebraMap B' (Localization.Away (v j)) (c i * u i) *
            IsLocalization.mk' (Localization.Away (v j)) 1 ⟨v j, Submonoid.mem_powers (v j)⟩ := by
        intro i
        rw [map_mul, AlgHom.commutes]
        change algebraMap B' _ (c i) * (θ i).1 = _
        rw [hθ_val i, IsLocalization.mk'_eq_mul_mk'_one, ← mul_assoc, ← map_mul]
      simp_rw [hterm, ← Finset.sum_mul, ← map_sum, hc, ← IsLocalization.mk'_eq_mul_mk'_one]
      exact IsLocalization.mk'_self (Localization.Away (v j)) (Submonoid.mem_powers (v j))
    rwa [← hS_eq_one]

  
  have hSwapCore : ∀ (B_α A_b : Type u) [CommRing B_α] [Algebra B' B_α]
      [CommRing A_b] [Algebra B' A_b]
      (α : Fin (L + 1)) (b : Fin r)
      (_hf_α : algebraMap R B' (h_R α) ∈ nonZeroDivisors B')
      (_hg_b : g b ∈ nonZeroDivisors B')
      (ι_B : B_α →ₐ[B'] Localization.Away (algebraMap R B' (h_R α)))
      (ι_A : A_b →ₐ[B'] Localization.Away (g b)),
      Function.Injective ι_B →
      Function.Injective ι_A →
      ι_B.range = Algebra.adjoin B' (Set.range fun β : Fin (L + 1) =>
        IsLocalization.mk' (Localization.Away (algebraMap R B' (h_R α)))
          (algebraMap R B' (h_R β))
          ⟨algebraMap R B' (h_R α), Submonoid.mem_powers (algebraMap R B' (h_R α))⟩) →
      ι_A.range = Algebra.adjoin B' (Set.range fun a : Fin r =>
        IsLocalization.mk' (Localization.Away (g b)) (g a) ⟨g b, Submonoid.mem_powers (g b)⟩) →
      ∀ (ξ : Fin r → B_α) (η_b : Fin (L + 1) → A_b),
        (∀ a : Fin r, ι_B (ξ a) =
          IsLocalization.mk' (Localization.Away (algebraMap R B' (h_R α))) (g a)
            ⟨algebraMap R B' (h_R α), Submonoid.mem_powers (algebraMap R B' (h_R α))⟩) →
        (∀ β : Fin (L + 1), ι_A (η_b β) =
          IsLocalization.mk' (Localization.Away (g b)) (algebraMap R B' (h_R β))
            ⟨g b, Submonoid.mem_powers (g b)⟩) →
        ∃ ϕ : Localization.Away (ξ b) ≃+* Localization.Away (η_b α),
          (∀ x : B',
            ϕ (algebraMap B_α (Localization.Away (ξ b)) (algebraMap B' B_α x)) =
            algebraMap A_b (Localization.Away (η_b α)) (algebraMap B' A_b x)) ∧
          ∀ (β : Fin (L + 1)) (y : B_α),
            ι_B y = IsLocalization.mk' (Localization.Away (algebraMap R B' (h_R α)))
              (algebraMap R B' (h_R β))
              ⟨algebraMap R B' (h_R α), Submonoid.mem_powers (algebraMap R B' (h_R α))⟩ →
            ϕ (algebraMap B_α (Localization.Away (ξ b)) y) =
              IsLocalization.mk' (Localization.Away (η_b α)) (η_b β)
                ⟨η_b α, Submonoid.mem_powers (η_b α)⟩ := by
    clear R_chart B_chart A_rees hSubZero h_nzd_hR hTensor hTransition
    intro B_α A_b _ _ _ _ α b hf_α hg_b ι_B ι_A hιB_inj hιA_inj hB_range hA_range ξ η_b hξ hη
    let M₀ : Submonoid B' := nonZeroDivisors B'
    let K' := Localization M₀
    have hK_inj : Function.Injective (algebraMap B' K') := IsLocalization.injective K' le_rfl
    have away_lift_injective : ∀ {A : Type u} [CommRing A] (ψ : A →+* K'),
        Function.Injective ψ → ∀ (t : A) (ht : IsUnit (ψ t)),
          Function.Injective (IsLocalization.Away.lift t ht : Localization.Away t →+* K') := by
      intro A _ ψ hψ t ht z₁ z₂ hz
      apply sub_eq_zero.mp
      have hz0 : IsLocalization.Away.lift t ht (z₁ - z₂) = 0 := by
        rw [map_sub, hz, sub_self]
      obtain ⟨⟨a, s⟩, has⟩ := IsLocalization.mk'_surjective (Submonoid.powers t) (z₁ - z₂)
      dsimp only at has
      rw [← has] at hz0 ⊢
      have hspec := congrArg (IsLocalization.Away.lift t ht)
        (IsLocalization.mk'_spec' (Localization.Away t) a s)
      rw [map_mul, hz0, mul_zero, IsLocalization.Away.lift_eq] at hspec
      have ha0 : a = 0 := hψ (hspec.symm.trans (map_zero ψ).symm)
      rw [ha0, IsLocalization.mk'_zero]
    let f_α : B' := algebraMap R B' (h_R α)
    have hu_f : IsUnit ((algebraMap B' K') f_α) := IsLocalization.map_units K' ⟨f_α, hf_α⟩
    have hu_g : IsUnit ((algebraMap B' K') (g b)) := IsLocalization.map_units K' ⟨g b, hg_b⟩
    let j_B : Localization.Away f_α →+* K' := IsLocalization.Away.lift f_α hu_f
    let j_A : Localization.Away (g b) →+* K' := IsLocalization.Away.lift (g b) hu_g
    have hjB_inj : Function.Injective j_B := away_lift_injective (algebraMap B' K') hK_inj f_α hu_f
    have hjA_inj : Function.Injective j_A := away_lift_injective (algebraMap B' K') hK_inj (g b) hu_g
    have hjB_mk : ∀ z : B',
        j_B (IsLocalization.mk' (Localization.Away f_α) z ⟨f_α, Submonoid.mem_powers f_α⟩) =
        IsLocalization.mk' K' z ⟨f_α, hf_α⟩ := by
      intro z
      apply hu_f.mul_right_inj.mp
      have h1 : algebraMap B' K' f_α *
          j_B (IsLocalization.mk' (Localization.Away f_α) z ⟨f_α, Submonoid.mem_powers f_α⟩) =
          algebraMap B' K' z := by
        calc
          algebraMap B' K' f_α * j_B (IsLocalization.mk' _ z _)
            = j_B (algebraMap B' _ f_α) * j_B (IsLocalization.mk' _ z _) := by
                rw [IsLocalization.Away.lift_eq]
          _ = j_B (algebraMap B' _ f_α * IsLocalization.mk' _ z _) := by
                rw [← map_mul]
          _ = j_B (algebraMap B' _ z) :=
                congrArg j_B (IsLocalization.mk'_spec' (Localization.Away f_α) z
                  ⟨f_α, Submonoid.mem_powers f_α⟩)
          _ = algebraMap B' K' z := IsLocalization.Away.lift_eq f_α hu_f z
      exact h1.trans (IsLocalization.mk'_spec' K' z ⟨f_α, hf_α⟩).symm
    have hjA_mk : ∀ z : B',
        j_A (IsLocalization.mk' (Localization.Away (g b)) z ⟨g b, Submonoid.mem_powers (g b)⟩) =
        IsLocalization.mk' K' z ⟨g b, hg_b⟩ := by
      intro z
      apply hu_g.mul_right_inj.mp
      have h1 : algebraMap B' K' (g b) *
          j_A (IsLocalization.mk' (Localization.Away (g b)) z ⟨g b, Submonoid.mem_powers (g b)⟩) =
          algebraMap B' K' z := by
        calc
          algebraMap B' K' (g b) * j_A (IsLocalization.mk' _ z _)
            = j_A (algebraMap B' _ (g b)) * j_A (IsLocalization.mk' _ z _) := by
                rw [IsLocalization.Away.lift_eq]
          _ = j_A (algebraMap B' _ (g b) * IsLocalization.mk' _ z _) := by
                rw [← map_mul]
          _ = j_A (algebraMap B' _ z) :=
                congrArg j_A (IsLocalization.mk'_spec' (Localization.Away (g b)) z
                  ⟨g b, Submonoid.mem_powers (g b)⟩)
          _ = algebraMap B' K' z := IsLocalization.Away.lift_eq (g b) hu_g z
      exact h1.trans (IsLocalization.mk'_spec' K' z ⟨g b, hg_b⟩).symm
    let g_B : B_α →+* K' := j_B.comp ι_B.toRingHom
    let g_A : A_b →+* K' := j_A.comp ι_A.toRingHom
    have hgB_inj : Function.Injective g_B := hjB_inj.comp hιB_inj
    have hgA_inj : Function.Injective g_A := hjA_inj.comp hιA_inj
    have hgB_ξ : ∀ a : Fin r, g_B (ξ a) = IsLocalization.mk' K' (g a) ⟨f_α, hf_α⟩ := by
      intro a
      change j_B (ι_B (ξ a)) = _
      rw [hξ a, hjB_mk]
    have hgA_η : ∀ β : Fin (L + 1),
        g_A (η_b β) = IsLocalization.mk' K' (algebraMap R B' (h_R β)) ⟨g b, hg_b⟩ := by
      intro β
      change j_A (ι_A (η_b β)) = _
      rw [hη β, hjA_mk]
    have h_mul_one : g_B (ξ b) * g_A (η_b α) = 1 := by
      rw [hgB_ξ b, hgA_η α, ← IsLocalization.mk'_mul]
      have hsub : (⟨f_α, hf_α⟩ : M₀) * ⟨g b, hg_b⟩ =
          ⟨g b * f_α, M₀.mul_mem hg_b hf_α⟩ := by
        ext
        exact mul_comm f_α (g b)
      rw [hsub]
      exact IsLocalization.mk'_self K' (M₀.mul_mem hg_b hf_α)
    have hξ_u : IsUnit (g_B (ξ b)) := IsUnit.of_mul_eq_one (g_A (η_b α)) h_mul_one
    have hη_u : IsUnit (g_A (η_b α)) :=
      IsUnit.of_mul_eq_one (g_B (ξ b)) (by rw [mul_comm, h_mul_one])
    let J_B : Localization.Away (ξ b) →+* K' := IsLocalization.Away.lift (ξ b) hξ_u
    let J_A : Localization.Away (η_b α) →+* K' := IsLocalization.Away.lift (η_b α) hη_u
    have hJB_inj : Function.Injective J_B := away_lift_injective g_B hgB_inj (ξ b) hξ_u
    have hJA_inj : Function.Injective J_A := away_lift_injective g_A hgA_inj (η_b α) hη_u
    have hJB_inv : ∀ (s : Submonoid.powers (ξ b)) (n : ℕ), (ξ b) ^ n = s.1 →
        J_B (IsLocalization.mk' (Localization.Away (ξ b)) 1 s) = (g_A (η_b α)) ^ n := by
      intro s n hn
      apply (hξ_u.pow n).mul_right_inj.mp
      have h1 : (g_B (ξ b)) ^ n * J_B (IsLocalization.mk' (Localization.Away (ξ b)) 1 s) = 1 := by
        calc
          (g_B (ξ b)) ^ n * J_B (IsLocalization.mk' _ 1 s)
            = g_B ((ξ b) ^ n) * J_B (IsLocalization.mk' _ 1 s) := by rw [map_pow]
          _ = J_B (algebraMap B_α _ s.1) * J_B (IsLocalization.mk' _ 1 s) := by
                rw [hn, IsLocalization.Away.lift_eq]
          _ = J_B (algebraMap B_α _ s.1 * IsLocalization.mk' _ 1 s) := by rw [← map_mul]
          _ = J_B (algebraMap B_α _ 1) := by rw [IsLocalization.mk'_spec']
          _ = 1 := by rw [map_one, map_one]
      rw [h1, ← mul_pow, h_mul_one, one_pow]
    have hJA_inv : ∀ (s : Submonoid.powers (η_b α)) (n : ℕ), (η_b α) ^ n = s.1 →
        J_A (IsLocalization.mk' (Localization.Away (η_b α)) 1 s) = (g_B (ξ b)) ^ n := by
      intro s n hn
      apply (hη_u.pow n).mul_right_inj.mp
      have h1 : (g_A (η_b α)) ^ n *
          J_A (IsLocalization.mk' (Localization.Away (η_b α)) 1 s) = 1 := by
        calc
          (g_A (η_b α)) ^ n * J_A (IsLocalization.mk' _ 1 s)
            = g_A ((η_b α) ^ n) * J_A (IsLocalization.mk' _ 1 s) := by rw [map_pow]
          _ = J_A (algebraMap A_b _ s.1) * J_A (IsLocalization.mk' _ 1 s) := by
                rw [hn, IsLocalization.Away.lift_eq]
          _ = J_A (algebraMap A_b _ s.1 * IsLocalization.mk' _ 1 s) := by rw [← map_mul]
          _ = J_A (algebraMap A_b _ 1) := by rw [IsLocalization.mk'_spec']
          _ = 1 := by rw [map_one, map_one]
      rw [h1, ← mul_pow, mul_comm (g_A (η_b α)) (g_B (ξ b)), h_mul_one, one_pow]
    have hSwap_β : ∀ β : Fin (L + 1),
        J_A (IsLocalization.mk' (Localization.Away (η_b α)) (η_b β)
          ⟨η_b α, Submonoid.mem_powers (η_b α)⟩) =
        j_B (IsLocalization.mk' (Localization.Away f_α) (algebraMap R B' (h_R β))
          ⟨f_α, Submonoid.mem_powers f_α⟩) := by
      intro β
      rw [IsLocalization.mk'_eq_mul_mk'_one (S := Localization.Away (η_b α)) (η_b β),
        map_mul, IsLocalization.Away.lift_eq,
        hJA_inv ⟨η_b α, Submonoid.mem_powers (η_b α)⟩ 1 (pow_one (η_b α)), pow_one,
        hgA_η β, hgB_ξ b, hjB_mk, ← IsLocalization.mk'_mul]
      apply (hu_g.mul hu_f).mul_right_inj.mp
      have hL : (algebraMap B' K' (g b) * algebraMap B' K' f_α) *
          IsLocalization.mk' K' (algebraMap R B' (h_R β) * g b)
            (⟨g b, hg_b⟩ * ⟨f_α, hf_α⟩) =
          algebraMap B' K' (algebraMap R B' (h_R β) * g b) := by
        rw [← map_mul]
        exact IsLocalization.mk'_spec' K' (algebraMap R B' (h_R β) * g b)
          (⟨g b, hg_b⟩ * ⟨f_α, hf_α⟩)
      have hR : (algebraMap B' K' (g b) * algebraMap B' K' f_α) *
          IsLocalization.mk' K' (algebraMap R B' (h_R β)) ⟨f_α, hf_α⟩ =
          algebraMap B' K' (algebraMap R B' (h_R β) * g b) := by
        rw [mul_assoc, IsLocalization.mk'_spec' K' (algebraMap R B' (h_R β)) ⟨f_α, hf_α⟩,
          ← map_mul, mul_comm]
      exact hL.trans hR.symm
    have hSwap_a : ∀ a : Fin r,
        J_B (IsLocalization.mk' (Localization.Away (ξ b)) (ξ a)
          ⟨ξ b, Submonoid.mem_powers (ξ b)⟩) =
        j_A (IsLocalization.mk' (Localization.Away (g b)) (g a)
          ⟨g b, Submonoid.mem_powers (g b)⟩) := by
      intro a
      rw [IsLocalization.mk'_eq_mul_mk'_one (S := Localization.Away (ξ b)) (ξ a),
        map_mul, IsLocalization.Away.lift_eq,
        hJB_inv ⟨ξ b, Submonoid.mem_powers (ξ b)⟩ 1 (pow_one (ξ b)), pow_one,
        hgB_ξ a, hgA_η α, hjA_mk, ← IsLocalization.mk'_mul]
      apply (hu_f.mul hu_g).mul_right_inj.mp
      have hL : (algebraMap B' K' f_α * algebraMap B' K' (g b)) *
          IsLocalization.mk' K' (g a * f_α) (⟨f_α, hf_α⟩ * ⟨g b, hg_b⟩) =
          algebraMap B' K' (g a * f_α) := by
        rw [← map_mul]
        exact IsLocalization.mk'_spec' K' (g a * f_α) (⟨f_α, hf_α⟩ * ⟨g b, hg_b⟩)
      have hR : (algebraMap B' K' f_α * algebraMap B' K' (g b)) *
          IsLocalization.mk' K' (g a) ⟨g b, hg_b⟩ =
          algebraMap B' K' (g a * f_α) := by
        rw [mul_assoc, IsLocalization.mk'_spec' K' (g a) ⟨g b, hg_b⟩, ← map_mul, mul_comm]
      exact hL.trans hR.symm
    have hjB_mem_JA : ∀ z ∈ ι_B.range, j_B z ∈ J_A.range := by
      intro z hz
      rw [hB_range] at hz
      refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hz
      · rintro u ⟨β, rfl⟩
        rw [← hSwap_β β]
        exact ⟨_, rfl⟩
      · intro x
        have hx : j_B (algebraMap B' (Localization.Away f_α) x) =
            J_A (algebraMap A_b (Localization.Away (η_b α)) (algebraMap B' A_b x)) := by
          rw [IsLocalization.Away.lift_eq, IsLocalization.Away.lift_eq]
          change algebraMap B' K' x = j_A (ι_A (algebraMap B' A_b x))
          rw [AlgHom.commutes, IsLocalization.Away.lift_eq]
        rw [hx]
        exact ⟨_, rfl⟩
      · intro u v _ _ hu hv
        rw [map_add]
        exact J_A.range.add_mem hu hv
      · intro u v _ _ hu hv
        rw [map_mul]
        exact J_A.range.mul_mem hu hv
    have hjA_mem_JB : ∀ z ∈ ι_A.range, j_A z ∈ J_B.range := by
      intro z hz
      rw [hA_range] at hz
      refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hz
      · rintro u ⟨a, rfl⟩
        rw [← hSwap_a a]
        exact ⟨_, rfl⟩
      · intro x
        have hx : j_A (algebraMap B' (Localization.Away (g b)) x) =
            J_B (algebraMap B_α (Localization.Away (ξ b)) (algebraMap B' B_α x)) := by
          rw [IsLocalization.Away.lift_eq, IsLocalization.Away.lift_eq]
          change algebraMap B' K' x = j_B (ι_B (algebraMap B' B_α x))
          rw [AlgHom.commutes, IsLocalization.Away.lift_eq]
        rw [hx]
        exact ⟨_, rfl⟩
      · intro u v _ _ hu hv
        rw [map_add]
        exact J_B.range.add_mem hu hv
      · intro u v _ _ hu hv
        rw [map_mul]
        exact J_B.range.mul_mem hu hv
    have hRange : J_B.range = J_A.range := by
      apply le_antisymm
      · rintro _ ⟨w, rfl⟩
        obtain ⟨⟨y, s⟩, hys⟩ := IsLocalization.mk'_surjective (Submonoid.powers (ξ b)) w
        dsimp only at hys
        obtain ⟨n, hn⟩ := s.2
        rw [← hys, IsLocalization.mk'_eq_mul_mk'_one, map_mul, IsLocalization.Away.lift_eq,
          hJB_inv s n hn]
        have hy_mem : g_B y ∈ J_A.range := hjB_mem_JA (ι_B y) ⟨y, rfl⟩
        have hpow_mem : (g_A (η_b α)) ^ n ∈ J_A.range := by
          refine ⟨(algebraMap A_b (Localization.Away (η_b α)) (η_b α)) ^ n, ?_⟩
          rw [map_pow, IsLocalization.Away.lift_eq]
        exact J_A.range.mul_mem hy_mem hpow_mem
      · rintro _ ⟨w, rfl⟩
        obtain ⟨⟨y, s⟩, hys⟩ := IsLocalization.mk'_surjective (Submonoid.powers (η_b α)) w
        dsimp only at hys
        obtain ⟨n, hn⟩ := s.2
        rw [← hys, IsLocalization.mk'_eq_mul_mk'_one, map_mul, IsLocalization.Away.lift_eq,
          hJA_inv s n hn]
        have hy_mem : g_A y ∈ J_B.range := hjA_mem_JB (ι_A y) ⟨y, rfl⟩
        have hpow_mem : (g_B (ξ b)) ^ n ∈ J_B.range := by
          refine ⟨(algebraMap B_α (Localization.Away (ξ b)) (ξ b)) ^ n, ?_⟩
          rw [map_pow, IsLocalization.Away.lift_eq]
        exact J_B.range.mul_mem hy_mem hpow_mem
    let e_B : Localization.Away (ξ b) ≃+* ↥J_B.range :=
      RingEquiv.ofBijective J_B.rangeRestrict
        ⟨fun _ _ h => hJB_inj (congrArg Subtype.val h), J_B.rangeRestrict_surjective⟩
    let e_A : Localization.Away (η_b α) ≃+* ↥J_A.range :=
      RingEquiv.ofBijective J_A.rangeRestrict
        ⟨fun _ _ h => hJA_inj (congrArg Subtype.val h), J_A.rangeRestrict_surjective⟩
    let ϕ : Localization.Away (ξ b) ≃+* Localization.Away (η_b α) :=
      e_B.trans ((RingEquiv.subringCongr hRange).trans e_A.symm)
    have hJA_ϕ : ∀ w : Localization.Away (ξ b), J_A (ϕ w) = J_B w := by
      intro w
      change (e_A (e_A.symm (RingEquiv.subringCongr hRange (e_B w)))).1 = (e_B w).1
      rw [RingEquiv.apply_symm_apply]
      rfl
    refine ⟨ϕ, ?_, ?_⟩
    · intro x
      apply hJA_inj
      rw [hJA_ϕ, IsLocalization.Away.lift_eq, IsLocalization.Away.lift_eq]
      change j_B (ι_B (algebraMap B' B_α x)) = j_A (ι_A (algebraMap B' A_b x))
      rw [AlgHom.commutes, AlgHom.commutes, IsLocalization.Away.lift_eq, IsLocalization.Away.lift_eq]
    · intro β y hy
      apply hJA_inj
      rw [hJA_ϕ, IsLocalization.Away.lift_eq]
      change j_B (ι_B y) = _
      rw [hy, hSwap_β β]

  
  refine ⟨hSubZero, ?_⟩
  have hη_all : ∀ b : Fin r,
      ∃ η_b : Fin (L + 1) → ↥(A_rees b),
        (∀ α : Fin (L + 1), (η_b α).1 =
          IsLocalization.mk' (Localization.Away (g b)) (algebraMap R B' (h_R α))
            ⟨g b, Submonoid.mem_powers (g b)⟩) ∧
        Ideal.span (Set.range fun p : {α : Fin (L + 1) // h_R α ≠ 0} => η_b p.1) = ⊤ := by
    intro b
    exact hTransition (algebraMap R B' ∘ h_R) g hSpan (fun α => h_R α ≠ 0)
      (fun α hnot => by simp [Classical.not_not.mp hnot]) b (A_rees b) rfl
  choose η hη_val hη_span using hη_all
  refine ⟨η, hη_span, ?_⟩
  intro α hα
  have hf_α : algebraMap R B' (h_R α) ∈ nonZeroDivisors B' := h_nzd_hR α hα
  obtain ⟨τ_α, hτ_α⟩ := hTensor α
  obtain ⟨ξ_α, hξ_val, hξ_span_sub⟩ :=
    hTransition g (algebraMap R B' ∘ h_R) hSpan.symm (fun _ : Fin r => True)
      (fun _ hnot => (hnot trivial).elim) α (B_chart α) rfl
  have hξ_span : Ideal.span (Set.range ξ_α) = ⊤ := by
    have hEqRange : (Set.range fun p : {b : Fin r // True} => ξ_α p.1) = Set.range ξ_α := by
      ext z
      exact ⟨fun ⟨p, hp⟩ => ⟨p.1, hp⟩, fun ⟨b, hb⟩ => ⟨⟨b, trivial⟩, hb⟩⟩
    rwa [← hEqRange]
  refine ⟨τ_α, ξ_α, hτ_α, hξ_span, ?_⟩
  intro b
  exact hSwapCore ↥(B_chart α) ↥(A_rees b) α b hf_α (hg_nzd b)
    (B_chart α).val (A_rees b).val Subtype.val_injective Subtype.val_injective
    (Subalgebra.range_val (B_chart α)) (Subalgebra.range_val (A_rees b))
    ξ_α (η b) hξ_val (hη_val b)

theorem weil_graph_closure_local_rees_charts (k : Type u) [Field k]
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [TopologicalSpace.NoetherianSpace ↥X.left]
    (U_compl : X.left.Opens)
    {m : ℕ} (U_cov : Fin m → X.left.affineOpens) (L : ℕ)
    (h : ∀ i : Fin m, Fin (L + 1) → ↑(X.left.presheaf.obj (Opposite.op (U_cov i).1)))
    (Φ₀ : U_compl.toScheme ⟶ (weilProjectiveSpaceOver k L).left)
    (hΦ₀ : Φ₀ ≫ (weilProjectiveSpaceOver k L).hom = U_compl.ι ≫ X.hom) :
    let 𝒜_L := MvPolynomial.homogeneousSubmodule (Fin (L + 1)) k
    letI : GradedAlgebra 𝒜_L := MvPolynomial.gradedAlgebra
    let P_L := weilProjectiveSpaceOver k L
    let δ : U_compl.toScheme ⟶ CategoryTheory.Limits.pullback X.hom P_L.hom :=
      CategoryTheory.Limits.pullback.lift U_compl.ι Φ₀ hΦ₀.symm
    let π_left : δ.image ⟶ X.left :=
      δ.imageι ≫ CategoryTheory.Limits.pullback.fst X.hom P_L.hom
    (⋃ α : Fin (L + 1),
      Set.range (AlgebraicGeometry.Proj.awayι 𝒜_L (MvPolynomial.X α)
        (MvPolynomial.isHomogeneous_X k α) zero_lt_one).base) = Set.univ ∧
    ∀ (i : Fin m) (V : X.left.affineOpens) (hi : V.1 ≤ (U_cov i).1) (α : Fin (L + 1)),
      let R_V := ↑(X.left.presheaf.obj (Opposite.op V.1))
      let h_V : Fin (L + 1) → R_V :=
        fun β => X.left.presheaf.map (CategoryTheory.homOfLE hi).op (h i β)
      let C_α := HomogeneousLocalization.Away 𝒜_L (MvPolynomial.X α)
      let w_α : AlgebraicGeometry.Spec (CommRingCat.of C_α) ⟶ P_L.left :=
        AlgebraicGeometry.Proj.awayι 𝒜_L (MvPolynomial.X α)
          (MvPolynomial.isHomogeneous_X k α) zero_lt_one
      let R_Vα := Algebra.adjoin R_V (Set.range fun β : Fin (L + 1) =>
        IsLocalization.mk' (Localization.Away (h_V α)) (h_V β)
          ⟨h_V α, Submonoid.mem_powers (h_V α)⟩)
      ∀ (ι_Vα : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (h_V α))) ⟶
            U_compl.toScheme)
        (ψ_Vα : C_α →+* Localization.Away (h_V α)),
        AlgebraicGeometry.IsOpenImmersion ι_Vα →
        (ι_Vα ≫ U_compl.ι =
          AlgebraicGeometry.Spec.map
