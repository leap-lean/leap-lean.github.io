      have hEt_spec : AlgebraicGeometry.Etale
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_et)) := by
        rw [h_comp]
        infer_instance
      exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
        hEt_spec
    have hm_le_q₀ : m_max ≤ q₀.asIdeal.comap φ := by
      have h_base : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)).base q₀_spec = p₀ := by
