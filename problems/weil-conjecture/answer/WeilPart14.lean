    refine ⟨hCollapse, ?_, filter_away_commRingCat R₁ ψ_loc hEt_ψloc w₁ (I_nc.erase j_piv)⟩
    let S_open : Set (Spec R₁) :=
      {p | ψ_loc (MvPolynomial.X j_piv) ∉ p.asIdeal ∧
        ∃ j ∈ I_nc.erase j_piv, ψ_loc (MvPolynomial.X j) ∈ p.asIdeal}
    let V_er : Set (Spec R₁) :=
      {p | ∃ j ∈ I_nc.erase j_piv, ψ_loc (MvPolynomial.X j) ∈ p.asIdeal}
    have hClosed_Ver : IsClosed V_er := by
      have hUnion : V_er = ⋃ j ∈ (I_nc.erase j_piv : Set (Fin (m + 1))),
