        IsProjectiveOverField k W ∧
        AlgebraicGeometry.SmoothOfRelativeDimension (m + 1) W.hom ∧
        IsSplitEtaleNcPair k m 1 W Z_W ∧
        IsGenFiniteEtaleAlterationOver k π ∧
        π.left.base ⁻¹' Z_total ⊆ Z_W := by
    intro b
    induction b with
    | zero =>
      intro _ S' Z_total hIntS' hProjS' hSmS' hPair
      have hIrred : IrreducibleSpace ↥S'.left :=
        @AlgebraicGeometry.irreducibleSpace_of_isIntegral S'.left hIntS'
      obtain ⟨x₀⟩ := hIrred.toNonempty
