          congr 1
          · exact h_away_mul i i' (e μ).1
          · exact h_away_mul j j' (e μ).2
      let pL : CategoryTheory.Limits.pullback (𝒰₁₂.f ij) (𝒰₁₂.f i'j') ⟶
