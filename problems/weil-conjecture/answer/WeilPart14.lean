    have _ : v_star.asIdeal.IsPrime := v_star.isPrime
    have _ : w₁.asIdeal.IsPrime := w₁.isPrime
    let p_bar : Ideal (A ⧸ I) := Ideal.map (Ideal.Quotient.mk I) v_star.asIdeal
    have _ : p_bar.IsPrime :=
      Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective (by rwa [Ideal.mk_ker])
    let W_bar : Ideal (R₁ ⧸ Q_loc) := Ideal.map (Ideal.Quotient.mk Q_loc) w₁.asIdeal
    have _ : W_bar.IsPrime :=
      Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective (by rwa [Ideal.mk_ker])
    let q_bar : Ideal (A ⧸ I) := Ideal.comap (algebraMap (A ⧸ I) (R₁ ⧸ Q_loc)) W_bar
    have _ : q_bar.IsPrime :=
