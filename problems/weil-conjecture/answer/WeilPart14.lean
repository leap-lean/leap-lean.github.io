  have hUbase : Nonempty U_base := ⟨⟨ψ.left.base z₂, ⟨hz₂Uψ, hz₂W₁⟩⟩⟩
  have hPreLe : (TopologicalSpace.Opens.map ψ.left.base).obj U_base ≤ U_B := by
    intro x hx
    by_contra hx_not_UB
    exact hx.2 ⟨x, hx_not_UB, rfl⟩
  obtain ⟨_, hPbUbase⟩ := hPbRestrictLE ψ.left (inf_le_left : U_base ≤ U_ψ)
  have hFin_base : AlgebraicGeometry.IsFinite (ψ.left ∣_ U_base) :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPbUbase hFinψ
  have hEt_base : AlgebraicGeometry.Etale (ψ.left ∣_ U_base) :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPbUbase hEtψ
  have hSurj_base : AlgebraicGeometry.Surjective (ψ.left ∣_ U_base) :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPbUbase hSurjψU
  
  let U_X₂ : X₂.left.Opens := (TopologicalSpace.Opens.map f₂.left.base).obj U_base
  haveI : AlgebraicGeometry.Surjective f₂.left := hFib₂.2.1.2.1
  have hUX₂ : Nonempty U_X₂ := by
    obtain ⟨⟨b₂, hb₂⟩⟩ := hUbase
    obtain ⟨x₂, hx₂⟩ := f₂.left.surjective b₂
    exact ⟨⟨x₂, by change f₂.left.base x₂ ∈ U_base; rw [hx₂]; exact hb₂⟩⟩
  have hPb_outer : CategoryTheory.IsPullback
      ((fst ⁻¹ᵁ U_X₂).ι ≫ snd)
      (fst ∣_ U_X₂) ψ.left ((f₂.left ∣_ U_base) ≫ U_base.ι) := by
    rw [AlgebraicGeometry.morphismRestrict_ι f₂.left U_base]
    exact (AlgebraicGeometry.isPullback_morphismRestrict fst U_X₂).flip.paste_horiz
      (CategoryTheory.IsPullback.of_hasPullback f₂.left ψ.left).flip
  have hPb_fst := CategoryTheory.IsPullback.of_right' hPb_outer
    (AlgebraicGeometry.isPullback_morphismRestrict ψ.left U_base).flip
  have hFin_fst : AlgebraicGeometry.IsFinite (fst ∣_ U_X₂) :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_fst hFin_base
  have hEt_fst : AlgebraicGeometry.Etale (fst ∣_ U_X₂) :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_fst hEt_base
  have hSurj_fst : AlgebraicGeometry.Surjective (fst ∣_ U_X₂) :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_fst hSurj_base
  have h_fst_le_W : fst ⁻¹ᵁ U_X₂ ≤ W_B_pb := by
    intro p hp
    apply hPreLe
    change ψ.left.base (snd.base p) ∈ U_base
    rw [← hCompBase snd ψ.left p, ← CategoryTheory.Limits.pullback.condition,
      hCompBase fst f₂.left p]
    exact hp
  obtain ⟨_, hPb_Lγ⟩ := hPbRestrictLE L_γ h_fst_le_W
  have hIso_L_UX₂ : CategoryTheory.IsIso (L_γ ∣_ (fst ⁻¹ᵁ U_X₂)) :=
    @CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback _ _
      (CategoryTheory.MorphismProperty.isomorphisms AlgebraicGeometry.Scheme) inferInstance
      _ _ _ _ _ _ _ _ hPb_Lγ hIsoLγ
  have hγ_eq_L : γ.left = L_γ ≫ fst :=
    (CategoryTheory.Limits.pullback.lift_fst γ.left f.left hcomm_γ).symm
  have hFin_γ : AlgebraicGeometry.IsFinite (γ.left ∣_ U_X₂) := by
    rw [hγ_eq_L, AlgebraicGeometry.morphismRestrict_comp]
    exact hFinOfIsoComp _ _ hIso_L_UX₂ hFin_fst
  have hEt_γ : AlgebraicGeometry.Etale (γ.left ∣_ U_X₂) := by
    rw [hγ_eq_L, AlgebraicGeometry.morphismRestrict_comp]
    exact hEtOfIsoComp _ _ hIso_L_UX₂ hEt_fst
  have hSurj_γU : AlgebraicGeometry.Surjective (γ.left ∣_ U_X₂) := by
    rw [hγ_eq_L, AlgebraicGeometry.morphismRestrict_comp]
    exact hSurjOfIsoComp _ _ hIso_L_UX₂ hSurj_fst
  have hUX₂_sub_range : (U_X₂ : Set X₂.left) ⊆ Set.range γ.left.base := by
    intro x hx
    have hx_range : x ∈ Set.range ⇑U_X₂.ι := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      exact hx
    obtain ⟨u, hu_eq⟩ := hx_range
    haveI : AlgebraicGeometry.Surjective (γ.left ∣_ U_X₂) := hSurj_γU
    obtain ⟨v, hv_eq⟩ := (γ.left ∣_ U_X₂).surjective u
    refine ⟨(γ.left ⁻¹ᵁ U_X₂).ι.base v, ?_⟩
    rw [← hCompBase (γ.left ⁻¹ᵁ U_X₂).ι γ.left v,
      ← AlgebraicGeometry.morphismRestrict_ι γ.left U_X₂,
      hCompBase (γ.left ∣_ U_X₂) U_X₂.ι v, hv_eq]
    exact hu_eq
  have hSurj_γ : AlgebraicGeometry.Surjective γ.left := by
    refine ⟨fun y => ?_⟩
    by_contra hy
    haveI : AlgebraicGeometry.IsProper γ.left := hProp_γ
    have hClRange : IsClosed (Set.range γ.left.base) := by
      rw [← Set.image_univ]
      exact γ.left.isClosedMap Set.univ isClosed_univ
    haveI : AlgebraicGeometry.IsIntegral X₂.left := hIntX₂
    haveI : IrreducibleSpace X₂.left :=
      AlgebraicGeometry.irreducibleSpace_of_isIntegral X₂.left
    obtain ⟨⟨x₀, hx₀⟩⟩ := hUX₂
    obtain ⟨z, hz_not_range, hz_UX₂⟩ := nonempty_preirreducible_inter
      hClRange.isOpen_compl U_X₂.isOpen ⟨y, hy⟩ ⟨x₀, hx₀⟩
    exact hz_not_range (hUX₂_sub_range hz_UX₂)
  
  refine ⟨γ, ⟨hProp_γ, hSurj_γ, U_X₂, hUX₂, hFin_γ, hEt_γ, hSurj_γU⟩, ?_⟩
  intro c hc_bdry
  by_cases hcU : f.left.base c ∈ (U_B : Set B.left)
  · right
    have hc_α₂ : α₂.left.base (γ.left.base c) ∈ (U_V : Set V.left)ᶜ := by
      have hcomp_c : (γ ≫ α₂).left.base c = α₂.left.base (γ.left.base c) :=
        hCompBase γ.left α₂.left c
      rwa [← hcomp_c]
    rcases hBdry₂ hc_α₂ with hc_not_U₂ | hc_sec
    · exfalso
      have hf₂_eq : f₂.left.base (γ.left.base c) = ψ.left.base (f.left.base c) := by
        rw [← hCompBase γ.left f₂.left c, hcomm_γ, hCompBase f.left ψ.left c]
      exact hc_not_U₂ (hf₂_eq ▸ hUBSub hcU)
    · obtain ⟨j, hcRange⟩ := Set.mem_iUnion.mp hc_sec
      let s : B₂.left ⟶ X₂.left := (σ j).left
      let t : B.left ⟶ C.left := (τ j).left
      have hs : s ≫ f₂.left = 𝟙 B₂.left := congrArg CommaMorphism.left (hFib₂.2.2.1 j)
      have ht : t ≫ f.left = 𝟙 B.left := congrArg CommaMorphism.left (hCurve.2.2.2.2.2.2.1 j)
      have htγ : t ≫ γ.left = ψ.left ≫ s := hτγ j
      have hcomm_σ : (ψ.left ≫ s) ≫ f₂.left = 𝟙 B.left ≫ ψ.left := by
        rw [Category.assoc, hs, Category.comp_id, Category.id_comp]
      let σ_ψ : B.left ⟶ P :=
        CategoryTheory.Limits.pullback.lift (ψ.left ≫ s) (𝟙 B.left) hcomm_σ
      have hPb_σ : CategoryTheory.IsPullback ψ.left σ_ψ s fst :=
        { w := (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm
          isLimit' := ⟨CategoryTheory.Limits.PullbackCone.IsLimit.mk _
            (fun cone => cone.snd ≫ snd)
            (fun cone => by
              calc (cone.snd ≫ snd) ≫ ψ.left
                _ = cone.snd ≫ (snd ≫ ψ.left) := by simp only [Category.assoc]
                _ = (cone.snd ≫ fst) ≫ f₂.left := by
                  rw [← CategoryTheory.Limits.pullback.condition, Category.assoc]
                _ = (cone.fst ≫ s) ≫ f₂.left := by rw [cone.condition]
                _ = cone.fst := by rw [Category.assoc, hs, Category.comp_id])
            (fun cone => by
              apply CategoryTheory.Limits.pullback.hom_ext
              · simp only [σ_ψ, fst, snd, Category.assoc,
                  CategoryTheory.Limits.pullback.lift_fst]
                calc cone.snd ≫ CategoryTheory.Limits.pullback.snd f₂.left ψ.left ≫ ψ.left ≫ s
                  _ = cone.snd ≫ (CategoryTheory.Limits.pullback.snd f₂.left ψ.left ≫ ψ.left) ≫ s := by
                    simp only [Category.assoc]
                  _ = cone.snd ≫ (CategoryTheory.Limits.pullback.fst f₂.left ψ.left ≫ f₂.left) ≫ s := by
                    rw [CategoryTheory.Limits.pullback.condition]
                  _ = ((cone.snd ≫ fst) ≫ f₂.left) ≫ s := by
                    simp only [fst, Category.assoc]
                  _ = ((cone.fst ≫ s) ≫ f₂.left) ≫ s := by rw [cone.condition]
                  _ = cone.snd ≫ CategoryTheory.Limits.pullback.fst f₂.left ψ.left := by
                    rw [Category.assoc cone.fst, hs, Category.comp_id, cone.condition]
              · simp only [σ_ψ, snd, Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
                  Category.comp_id])
            (fun cone m _ hm2 => by
              calc m
                _ = m ≫ 𝟙 B.left := (Category.comp_id m).symm
                _ = m ≫ (σ_ψ ≫ snd) := by
                  rw [CategoryTheory.Limits.pullback.lift_snd]
                _ = cone.snd ≫ snd := by rw [← Category.assoc, hm2])⟩ }
      have htL : t ≫ L_γ = σ_ψ := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · simp only [L_γ, σ_ψ, Category.assoc, CategoryTheory.Limits.pullback.lift_fst, htγ]
        · simp only [L_γ, σ_ψ, Category.assoc, CategoryTheory.Limits.pullback.lift_snd, ht]
      have hp_range : L_γ.base c ∈ Set.range ⇑(CategoryTheory.Limits.pullback.snd s fst) := by
        rw [AlgebraicGeometry.Scheme.Pullback.range_snd]
        change fst.base (L_γ.base c) ∈ Set.range ⇑s
        rw [← hCompBase L_γ fst c, CategoryTheory.Limits.pullback.lift_fst]
        exact hcRange
      obtain ⟨w, hw_eq⟩ := hp_range
      let b' : B.left := hPb_σ.isoPullback.inv.base w
      have hb'_σ : σ_ψ.base b' = L_γ.base c := by
        dsimp only [b']
        rw [← hCompBase hPb_σ.isoPullback.inv σ_ψ w, hPb_σ.isoPullback_inv_snd]
        exact hw_eq
      have hb'_eq : b' = f.left.base c := by
        calc b'
          _ = (𝟙 B.left : B.left ⟶ B.left).base b' := (hIdBase b').symm
          _ = (σ_ψ ≫ snd).base b' := by rw [CategoryTheory.Limits.pullback.lift_snd]
          _ = snd.base (L_γ.base c) := by rw [hCompBase σ_ψ snd b', hb'_σ]
          _ = f.left.base c := by
            rw [← hCompBase L_γ snd c, CategoryTheory.Limits.pullback.lift_snd]
      let c' : C.left := t.base (f.left.base c)
      have hLc_eq : L_γ.base c = L_γ.base c' := by
        calc L_γ.base c
          _ = σ_ψ.base (f.left.base c) := by rw [← hb'_eq, hb'_σ]
          _ = (t ≫ L_γ).base (f.left.base c) := by rw [htL]
          _ = L_γ.base c' := hCompBase t L_γ (f.left.base c)
      let V_L : C.left.Opens := (TopologicalSpace.Opens.map L_γ.base).obj W_B_pb
      have hc_VL : c ∈ (V_L : Set C.left) := by
        change snd.base (L_γ.base c) ∈ U_B
        rw [← hCompBase L_γ snd c, CategoryTheory.Limits.pullback.lift_snd]
        exact hcU
      have hc'_VL : c' ∈ (V_L : Set C.left) := by
        change snd.base (L_γ.base c') ∈ U_B
        rw [← hLc_eq]
        exact hc_VL
      have hc_r : c ∈ Set.range ⇑V_L.ι := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        exact hc_VL
      have hc'_r : c' ∈ Set.range ⇑V_L.ι := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        exact hc'_VL
      obtain ⟨u₀, hu₀_eq⟩ := hc_r
      obtain ⟨u₀', hu₀'_eq⟩ := hc'_r
      have h_res_L : (L_γ ∣_ W_B_pb).base u₀ = (L_γ ∣_ W_B_pb).base u₀' := by
        apply W_B_pb.ι.isOpenEmbedding.injective
        change W_B_pb.ι.base ((L_γ ∣_ W_B_pb).base u₀) =
          W_B_pb.ι.base ((L_γ ∣_ W_B_pb).base u₀')
        rw [← hCompBase (L_γ ∣_ W_B_pb) W_B_pb.ι u₀,
          ← hCompBase (L_γ ∣_ W_B_pb) W_B_pb.ι u₀',
          AlgebraicGeometry.morphismRestrict_ι,
          hCompBase V_L.ι L_γ u₀, hCompBase V_L.ι L_γ u₀']
        change L_γ.base (⇑V_L.ι u₀) = L_γ.base (⇑V_L.ι u₀')
