    have hEqRank : m + 1 = 2 + m := by
      rw [← hRank_P₁, ← hRank_M]
      exact LinearEquiv.finrank_eq e_P₁_M
    omega

theorem weil_projective_closed_irreducible_subschemes (k : Type u) [Field k]
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hProjX : IsProjectiveOverField k X)
    (S : Set X.left) (hClosedS : IsClosed S) :
    ∃ (N : ℕ) (E : Fin N → AlgebraicGeometry.Scheme.{u})
      (ιE : ∀ α : Fin N, E α ⟶ X.left),
      (∀ α : Fin N, AlgebraicGeometry.IsClosedImmersion (ιE α)) ∧
      (∀ α : Fin N, AlgebraicGeometry.IsIntegral (E α)) ∧
      (_root_.Pairwise fun α β : Fin N =>
        ¬ Set.range (ιE α).base ⊆ Set.range (ιE β).base) ∧
      S = ⋃ α : Fin N, Set.range (ιE α).base :=
by
  obtain ⟨M, ι, hCl⟩ := hProjX
  have _ : AlgebraicGeometry.IsClosedImmersion ι.left := hCl
  let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k
  let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
  have _ : IsScalarTower k (↥(𝒜 0)) (MvPolynomial (Fin (M + 1)) k) :=
    ⟨fun c x p => smul_mul_assoc c (x : MvPolynomial (Fin (M + 1)) k) p⟩
  have _ : Algebra.FiniteType (↥(𝒜 0)) (MvPolynomial (Fin (M + 1)) k) :=
    Algebra.FiniteType.of_restrictScalars_finiteType k (↥(𝒜 0)) (MvPolynomial (Fin (M + 1)) k)
  have h_surj : Function.Surjective (algebraMap k ↥(𝒜 0)) := by
    intro x
    have hx : (x : MvPolynomial (Fin (M + 1)) k) ∈
        (1 : Submodule k (MvPolynomial (Fin (M + 1)) k)) := by
      rw [← MvPolynomial.homogeneousSubmodule_zero (Fin (M + 1))]
      exact x.2
    obtain ⟨c, hc⟩ := Submodule.mem_one.mp hx
    refine ⟨c, Subtype.ext ?_⟩
    rw [Algebra.algebraMap_eq_smul_one]
    change c • (1 : MvPolynomial (Fin (M + 1)) k) = ↑x
    rwa [← Algebra.algebraMap_eq_smul_one]
  have _ : IsNoetherianRing ↥(𝒜 0) :=
    isNoetherianRing_of_surjective k (↥(𝒜 0)) (algebraMap k ↥(𝒜 0)) h_surj
  have _ : CompactSpace ↥(AlgebraicGeometry.Proj 𝒜) :=
    AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace
      (AlgebraicGeometry.Proj.toSpecZero 𝒜)
  have _ : AlgebraicGeometry.IsLocallyNoetherian (AlgebraicGeometry.Proj 𝒜) :=
    AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian
      (AlgebraicGeometry.Proj.toSpecZero 𝒜)
  have _ : AlgebraicGeometry.IsNoetherian (AlgebraicGeometry.Proj 𝒜) := {}
  have _ : TopologicalSpace.NoetherianSpace ↥(weilProjectiveSpaceOver k M).left := by
    change TopologicalSpace.NoetherianSpace ↥(AlgebraicGeometry.Proj 𝒜)
    exact AlgebraicGeometry.IsNoetherian.noetherianSpace
  have _ : TopologicalSpace.NoetherianSpace ↥X.left :=
    ι.left.isClosedEmbedding.toIsEmbedding.toIsInducing.noetherianSpace
  have _ : TopologicalSpace.NoetherianSpace ↥S :=
    Topology.IsInducing.subtypeVal.noetherianSpace
  have hFinComp : (irreducibleComponents ↥S).Finite :=
    TopologicalSpace.NoetherianSpace.finite_irreducibleComponents
  have _ : Finite ↥(irreducibleComponents ↥S) := hFinComp.to_subtype
  obtain ⟨N, ⟨e_inv⟩⟩ := Finite.exists_equiv_fin ↥(irreducibleComponents ↥S)
  let e_comp : Fin N ≃ ↥(irreducibleComponents ↥S) := e_inv.symm
  let C : Fin N → Set ↥S := fun α => (e_comp α).1
  let F : Fin N → Set X.left := fun α => (Subtype.val : ↥S → X.left) '' C α
  have hMax : ∀ α : Fin N, Maximal (fun x : Set ↥S => IsClosed x ∧ IsIrreducible x) (C α) := by
    intro α
    have hMem : C α ∈ irreducibleComponents ↥S := (e_comp α).2
    rwa [irreducibleComponents_eq_maximals_closed] at hMem
  have hClF : ∀ α : Fin N, IsClosed (F α) :=
    fun α => hClosedS.isClosedEmbedding_subtypeVal.isClosedMap (C α) (hMax α).prop.1
  have hIrrF : ∀ α : Fin N, IsIrreducible (F α) :=
    fun α => (hMax α).prop.2.image Subtype.val continuous_subtype_val.continuousOn
  have hIncompF : _root_.Pairwise fun α β : Fin N => ¬ F α ⊆ F β := by
    intro α β hne hSub
    have hSubC : C α ⊆ C β := (Set.image_subset_image_iff Subtype.val_injective).mp hSub
    have hEqC : C α = C β := (hMax α).eq_of_le (hMax β).prop hSubC
    exact hne (e_comp.injective (Subtype.ext hEqC))
  have hUnionF : S = ⋃ α : Fin N, F α := by
    refine Set.Subset.antisymm ?_ ?_
    · intro x hx
      let y : ↥S := ⟨x, hx⟩
      let c_y : ↥(irreducibleComponents ↥S) :=
        ⟨irreducibleComponent y, irreducibleComponent_mem_irreducibleComponents y⟩
      refine Set.mem_iUnion.mpr ⟨e_inv c_y, y, ?_, rfl⟩
      have h_eq : C (e_inv c_y) = irreducibleComponent y :=
        congrArg Subtype.val (e_inv.symm_apply_apply c_y)
      rw [h_eq]
      exact mem_irreducibleComponent
    · rintro x hx
      rcases Set.mem_iUnion.mp hx with ⟨α, y, _, rfl⟩
      exact y.2
  let Z : Fin N → TopologicalSpace.Closeds ↥X.left := fun α => ⟨F α, hClF α⟩
  let I : Fin N → X.left.IdealSheafData :=
    fun α => AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal (Z α)
  let E : Fin N → AlgebraicGeometry.Scheme.{u} := fun α => (I α).subscheme
  let ιE : ∀ α : Fin N, E α ⟶ X.left := fun α => (I α).subschemeι
  have hClE : ∀ α : Fin N, AlgebraicGeometry.IsClosedImmersion (ιE α) := fun _ => inferInstance
  have h_range : ∀ α : Fin N, Set.range (ιE α).base = F α := by
    intro α
    change Set.range ((I α).subschemeι).base = F α
    erw [AlgebraicGeometry.Scheme.IdealSheafData.range_subschemeι]
    exact AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal (Z α)
  have hIntE : ∀ α : Fin N, AlgebraicGeometry.IsIntegral (E α) := by
    intro α
    have hSuppEq : (I α).support = Z α :=
      SetLike.coe_injective
        (AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal (Z α))
    have hRadEq : (I α).radical = I α := by
      rw [← AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal_support, hSuppEq]
    have hRedCover : ∀ U : ↥X.left.affineOpens,
        AlgebraicGeometry.IsReduced (((I α).subschemeCover.openCover).X U) := by
      intro U
      have hIdEq : ((I α).ideal U).radical = (I α).ideal U := by
        rw [← AlgebraicGeometry.Scheme.IdealSheafData.radical_ideal (I α) U, hRadEq]
      have hIsRad : ((I α).ideal U).IsRadical := by
        rw [← hIdEq]
        exact Ideal.radical_isRadical _
      have _ : _root_.IsReduced
          (↑(X.left.presheaf.obj (Opposite.op U.1)) ⧸ (I α).ideal U) :=
        (Ideal.isRadical_iff_quotient_reduced ((I α).ideal U)).mp hIsRad
      change AlgebraicGeometry.IsReduced
        (AlgebraicGeometry.Spec (CommRingCat.of
          (↑(X.left.presheaf.obj (Opposite.op U.1)) ⧸ (I α).ideal U)))
      exact inferInstance
    have _ : AlgebraicGeometry.IsReduced (E α) :=
      @AlgebraicGeometry.IsReduced.of_openCover (E α) (I α).subschemeCover.openCover hRedCover
    have hEmb : Topology.IsClosedEmbedding (ιE α).base := (ιE α).isClosedEmbedding
    have hNe : Nonempty ↥(E α) := by
      have hRangeNe : (Set.range (ιE α).base).Nonempty := by
        rw [h_range α]
        exact (hIrrF α).nonempty
      rcases hRangeNe with ⟨_, z₀, rfl⟩
      exact ⟨z₀⟩
    have _ : PreirreducibleSpace ↥(E α) := by
      refine ⟨?_⟩
      rw [isPreirreducible_iff_isClosed_union_isClosed]
      intro z₁ z₂ hz₁ hz₂ hUniv
      have hCl₁ : IsClosed ((ιE α).base '' z₁) := hEmb.isClosedMap z₁ hz₁
      have hCl₂ : IsClosed ((ιE α).base '' z₂) := hEmb.isClosedMap z₂ hz₂
      have hImgUniv : (ιE α).base '' (Set.univ : Set ↥(E α)) = F α := by
        rw [Set.image_univ, h_range α]
      have hSubF : F α ⊆ ((ιE α).base '' z₁) ∪ ((ιE α).base '' z₂) := by
        rw [← hImgUniv, ← Set.image_union]
        exact Set.image_mono hUniv
      rcases isPreirreducible_iff_isClosed_union_isClosed.mp
          (hIrrF α).isPreirreducible ((ιE α).base '' z₁) ((ιE α).base '' z₂) hCl₁ hCl₂ hSubF with
        h₁ | h₂
      · rw [← hImgUniv] at h₁
        exact Or.inl ((Set.image_subset_image_iff hEmb.toIsEmbedding.injective).mp h₁)
      · rw [← hImgUniv] at h₂
        exact Or.inr ((Set.image_subset_image_iff hEmb.toIsEmbedding.injective).mp h₂)
    have _ : IrreducibleSpace ↥(E α) := IrreducibleSpace.mk hNe
    exact AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced (E α)
  refine ⟨N, E, ιE, hClE, hIntE, ?_, ?_⟩
  · intro α β hne
    rw [h_range α, h_range β]
    exact hIncompF hne
  · simp_rw [h_range]
    exact hUnionF

theorem weil_toroidal_chart_stratum_shrinking (k : Type u) [Field k] (m r_B N : ℕ)
    (B₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (D_B : Fin r_B → AlgebraicGeometry.Scheme.{u})
    (ιD_B : ∀ i : Fin r_B, D_B i ⟶ B₁.left)
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (Z_X : Set X.left) (f : X ⟶ B₁)
    (E : Fin N → AlgebraicGeometry.Scheme.{u})
    (ιE : ∀ α : Fin N, E α ⟶ X.left)
    (hClE : ∀ α : Fin N, AlgebraicGeometry.IsClosedImmersion (ιE α))
    (hIntE : ∀ α : Fin N, AlgebraicGeometry.IsIntegral (E α))
    (hIncompE : _root_.Pairwise fun α β : Fin N =>
      ¬ Set.range (ιE α).base ⊆ Set.range (ιE β).base)
    (x : X.left)
    (R'₀ : CommRingCat.{u}) (v₀ : AlgebraicGeometry.Spec R'₀)
    (e_X₀ : AlgebraicGeometry.Spec R'₀ ⟶ X.left)
    (S_exp S_bdry : Finset (Fin m))
    (ρ : ↥S_exp → Fin r_B)
    (q₀ : AlgebraicGeometry.Spec R'₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of
      (MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ Ideal.span
        {MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
          ∏ i ∈ S_exp, MvPolynomial.X (Sum.inr i)})))
    (hEt_e₀ : AlgebraicGeometry.Etale e_X₀)
    (hEt_q₀ : AlgebraicGeometry.Etale q₀)
    (hv₀ : e_X₀.base v₀ = x)
    (hCard : 2 ≤ S_exp.card)
    (hSub : S_exp ⊆ S_bdry)
    (hComm₀ : q₀ ≫ AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) = e_X₀ ≫ X.hom)
    (hInl₀ : ∀ a : Fin 2,
      Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl a)) ∈ (q₀.base v₀).asIdeal)
    (hInr₀ : ∀ i ∈ S_bdry,
      Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr i)) ∈ (q₀.base v₀).asIdeal)
    (hZ₀ : e_X₀.base ⁻¹' Z_X =
      {v : AlgebraicGeometry.Spec R'₀ |
        ∃ i ∈ S_bdry,
          Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr i)) ∈ (q₀.base v).asIdeal})
    (hDiv₀ : ∀ c : ↥S_exp,
      (e_X₀ ≫ f.left).base ⁻¹' Set.range (ιD_B (ρ c)).base =
        {v : AlgebraicGeometry.Spec R'₀ |
          Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c.1)) ∈ (q₀.base v).asIdeal})
    (hSing₀ : e_X₀.base ⁻¹' (⋃ α : Fin N, Set.range (ιE α).base) =
      {v : AlgebraicGeometry.Spec R'₀ |
        ∃ i ∈ S_exp, ∃ j ∈ S_exp, i ≠ j ∧
          (∀ a : Fin 2,
            Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl a)) ∈ (q₀.base v).asIdeal) ∧
          Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr i)) ∈ (q₀.base v).asIdeal ∧
          Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr j)) ∈ (q₀.base v).asIdeal}) :
    ∃ (R' : CommRingCat.{u}) (v'₀ : AlgebraicGeometry.Spec R')
      (e_X : AlgebraicGeometry.Spec R' ⟶ X.left)
      (q : AlgebraicGeometry.Spec R' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
        (MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ Ideal.span
          {MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
            ∏ i ∈ S_exp, MvPolynomial.X (Sum.inr i)}))),
      AlgebraicGeometry.Etale e_X ∧
      AlgebraicGeometry.Etale q ∧
      e_X.base v'₀ = x ∧
      (q ≫ AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) = e_X ≫ X.hom) ∧
      (∀ a : Fin 2,
        Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl a)) ∈ (q.base v'₀).asIdeal) ∧
      (∀ i ∈ S_bdry,
        Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr i)) ∈ (q.base v'₀).asIdeal) ∧
      e_X.base ⁻¹' Z_X =
        {v : AlgebraicGeometry.Spec R' |
          ∃ i ∈ S_bdry,
            Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr i)) ∈ (q.base v).asIdeal} ∧
      (∀ α : Fin N, x ∉ Set.range (ιE α).base →
        e_X.base ⁻¹' Set.range (ιE α).base = ∅) ∧
      (∀ α : Fin N, x ∈ Set.range (ιE α).base →
        ∃ i ∈ S_exp, ∃ j ∈ S_exp, i ≠ j ∧
          e_X.base ⁻¹' Set.range (ιE α).base =
            {v : AlgebraicGeometry.Spec R' |
              (∀ a : Fin 2,
                Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl a)) ∈ (q.base v).asIdeal) ∧
              Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr i)) ∈ (q.base v).asIdeal ∧
              Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr j)) ∈ (q.base v).asIdeal}) :=
by
  have local_domain_of_prime_regular : ∀ (L : Type u) [CommRing L] [IsNoetherianRing L]
      [IsLocalRing L] (ϖ : L), (Ideal.span ({ϖ} : Set L)).IsPrime →
      (∀ z : L, ϖ * z = 0 → z = 0) → IsDomain L := by
    intro L _ _ _ ϖ hϖ_prime hReg
    let I : Ideal L := Ideal.span ({ϖ} : Set L)
    have hDivStep : ∀ (N_step : ℕ) (u v : L), u * v = 0 →
        ∀ a b : ℕ, a + b = N_step → u ∈ I ^ a ∨ v ∈ I ^ b := by
      intro N_step
      induction N_step with
      | zero =>
        intro u v _ a b hab
        have ha0 : a = 0 := by omega
        subst ha0
        left
        rw [pow_zero, Ideal.one_eq_top]
        exact Submodule.mem_top
      | succ N_step ih =>
        intro u v huv a b hab
        cases a with
        | zero =>
          left
          rw [pow_zero, Ideal.one_eq_top]
          exact Submodule.mem_top
        | succ a' =>
          cases b with
          | zero =>
            right
            rw [pow_zero, Ideal.one_eq_top]
            exact Submodule.mem_top
          | succ b' =>
            have huv_I : u * v ∈ I := by
              rw [huv]
              exact Submodule.zero_mem I
            rcases hϖ_prime.mem_or_mem huv_I with hu_I | hv_I
            · obtain ⟨u', rfl⟩ := Ideal.mem_span_singleton'.mp hu_I
              have hu'v : u' * v = 0 := by
                apply hReg
                calc
                  ϖ * (u' * v) = (u' * ϖ) * v := by ring
                  _ = 0 := huv
              rcases ih u' v hu'v a' (b' + 1) (by omega) with hu'_pow | hv_pow
              · left
                rw [pow_succ]
                exact Ideal.mul_mem_mul hu'_pow (Ideal.subset_span rfl)
              · exact Or.inr hv_pow
            · obtain ⟨v', rfl⟩ := Ideal.mem_span_singleton'.mp hv_I
              have hvu' : u * v' = 0 := by
                apply hReg
                calc
                  ϖ * (u * v') = u * (v' * ϖ) := by ring
                  _ = 0 := huv
              rcases ih u v' hvu' (a' + 1) b' (by omega) with hu_pow | hv'_pow
              · exact Or.inl hu_pow
              · right
                rw [pow_succ]
                exact Ideal.mul_mem_mul hv'_pow (Ideal.subset_span rfl)
    have hInf : (⨅ n : ℕ, I ^ n) = ⊥ :=
      Ideal.iInf_pow_eq_bot_of_isLocalRing I hϖ_prime.ne_top
    haveI : Nontrivial L := by
      refine ⟨⟨1, 0, fun h10 => hϖ_prime.ne_top ?_⟩⟩
      rw [Ideal.eq_top_iff_one, h10]
      exact Submodule.zero_mem I
    haveI : NoZeroDivisors L := by
      refine ⟨fun {u v} huv => ?_⟩
      by_contra hnot
      have hu_ne : u ≠ 0 := fun h => hnot (Or.inl h)
      have hv_ne : v ≠ 0 := fun h => hnot (Or.inr h)
      have hu_not_inf : u ∉ (⨅ n : ℕ, I ^ n) := by
        rw [hInf, Ideal.mem_bot]
        exact hu_ne
      have hv_not_inf : v ∉ (⨅ n : ℕ, I ^ n) := by
        rw [hInf, Ideal.mem_bot]
        exact hv_ne
      rw [Ideal.mem_iInf] at hu_not_inf hv_not_inf
      push Not at hu_not_inf hv_not_inf
      obtain ⟨a, hua⟩ := hu_not_inf
      obtain ⟨b, hvb⟩ := hv_not_inf
      rcases hDivStep (a + b) u v huv a b rfl with ha | hb
      · exact hua ha
      · exact hvb hb
    exact NoZeroDivisors.to_isDomain L
  have etale_zero_atPrime_isDomain : ∀ (K B : Type u) [Field K] [CommRing B]
      (φ : MvPolynomial (Fin 0) K →+* B), φ.Etale →
      ∀ (q : Ideal B) [q.IsPrime], IsDomain (Localization.AtPrime q) := by
    intro K B _ _ φ hφ q _
    let e₀ : K ≃ₐ[K] MvPolynomial (Fin 0) K := (MvPolynomial.isEmptyAlgEquiv K (Fin 0)).symm
    let φ₀ : K →+* B := φ.comp e₀.toRingHom
    have hφ₀ : φ₀.Etale :=
      RingHom.Etale.stableUnderComposition _ _ (RingHom.Etale.of_bijective e₀.bijective) hφ
    letI : Algebra K B := φ₀.toAlgebra
    haveI : Algebra.Etale K B := RingHom.etale_algebraMap.mp hφ₀
    let L := Localization.AtPrime q
    haveI : Algebra.FormallyUnramified K B := inferInstance
    haveI : Algebra.EssFiniteType K B := inferInstance
    haveI : Algebra.FormallyUnramified B L :=
      Algebra.FormallyUnramified.of_isLocalization q.primeCompl
    haveI : Algebra.EssFiniteType B L :=
      Algebra.EssFiniteType.of_isLocalization L q.primeCompl
    haveI : Algebra.FormallyUnramified K L := Algebra.FormallyUnramified.comp K B L
    haveI : Algebra.EssFiniteType K L := Algebra.EssFiniteType.comp K B L
    haveI : IsLocalHom (algebraMap K L) := by
      refine ⟨fun a ha => ?_⟩
      by_cases ha0 : a = 0
      · subst ha0
        rw [map_zero] at ha
        exact (not_isUnit_zero ha).elim
      · exact isUnit_iff_ne_zero.mpr ha0
    have hMaxL : IsLocalRing.maximalIdeal L =
        Ideal.map (algebraMap K L) (IsLocalRing.maximalIdeal K) :=
      (Algebra.FormallyUnramified.map_maximalIdeal (R := K) (S := L)).symm
    have hMaxK : IsLocalRing.maximalIdeal K = ⊥ :=
      IsLocalRing.isField_iff_maximalIdeal_eq.mp (Field.toIsField K)
    rw [hMaxK, Ideal.map_bot] at hMaxL
    have hFieldL : IsField L := IsLocalRing.isField_iff_maximalIdeal_eq.mpr hMaxL
    letI : Field L := hFieldL.toField
    exact inferInstance
  have etale_poly_baseChange_aux : ∀ (R₀ K' : Type u) [CommRing R₀] [Field K'] [Algebra R₀ K']
      (d : ℕ) (B : Type u) [CommRing B] [Algebra R₀ B]
      [Algebra (MvPolynomial (Fin d) R₀) B]
      [IsScalarTower R₀ (MvPolynomial (Fin d) R₀) B]
      [Algebra.Etale (MvPolynomial (Fin d) R₀) B]
      (B' : Type u) [CommRing B'],
      (TensorProduct R₀ B K' ≃+* B') →
      ∃ ψ' : MvPolynomial (Fin d) K' →+* B', ψ'.Etale := by
    intro R₀ K' _ _ _ d B _ _ _ _ _ B' _ eB
    let φ_map : MvPolynomial (Fin d) R₀ →+* MvPolynomial (Fin d) K' :=
      MvPolynomial.map (algebraMap R₀ K')
    letI : Algebra (MvPolynomial (Fin d) R₀) (MvPolynomial (Fin d) K') := φ_map.toAlgebra
    have hEtBC : Algebra.Etale (MvPolynomial (Fin d) K')
        (TensorProduct (MvPolynomial (Fin d) R₀) (MvPolynomial (Fin d) K') B) :=
      Algebra.Etale.baseChange (MvPolynomial (Fin d) R₀) B (MvPolynomial (Fin d) K')
    let ιB_BK : B →+* TensorProduct R₀ B K' :=
      (Algebra.TensorProduct.includeLeft : B →ₐ[R₀] TensorProduct R₀ B K').toRingHom
    let ιK_BK : K' →+* TensorProduct R₀ B K' :=
      (Algebra.TensorProduct.includeRight (R := R₀) (A := B)).toRingHom
    let g_P_hom : MvPolynomial (Fin d) K' →+* TensorProduct R₀ B K' :=
      MvPolynomial.eval₂Hom ιK_BK
        (fun i => TensorProduct.tmul R₀ (algebraMap (MvPolynomial (Fin d) R₀) B (MvPolynomial.X i)) 1)
    have hg_comm : g_P_hom.comp φ_map = ιB_BK.comp (algebraMap (MvPolynomial (Fin d) R₀) B) := by
      apply MvPolynomial.ringHom_ext
      · intro r
        rw [RingHom.comp_apply, RingHom.comp_apply]
        change MvPolynomial.eval₂ ιK_BK _ (φ_map (MvPolynomial.C r)) = _
        rw [MvPolynomial.map_C, MvPolynomial.eval₂_C]
        have hC : algebraMap (MvPolynomial (Fin d) R₀) B (MvPolynomial.C r) = algebraMap R₀ B r :=
          (IsScalarTower.algebraMap_apply R₀ (MvPolynomial (Fin d) R₀) B r).symm
        rw [hC]
        change TensorProduct.tmul R₀ (1 : B) (algebraMap R₀ K' r) =
          TensorProduct.tmul R₀ (algebraMap R₀ B r) (1 : K')
        have h1 : algebraMap R₀ B r = r • (1 : B) := by rw [Algebra.smul_def, mul_one]
        have h2 : algebraMap R₀ K' r = r • (1 : K') := by rw [Algebra.smul_def, mul_one]
        rw [h1, h2, TensorProduct.smul_tmul]
      · intro i
        rw [RingHom.comp_apply, RingHom.comp_apply]
        change MvPolynomial.eval₂ ιK_BK _ (φ_map (MvPolynomial.X i)) = _
        rw [MvPolynomial.map_X, MvPolynomial.eval₂_X]
        rfl
    let g_P : MvPolynomial (Fin d) K' →ₐ[MvPolynomial (Fin d) R₀] TensorProduct R₀ B K' :=
      { g_P_hom with commutes' := fun p => RingHom.congr_fun hg_comm p }
    let g_B : B →ₐ[MvPolynomial (Fin d) R₀] TensorProduct R₀ B K' :=
      { ιB_BK with commutes' := fun _ => rfl }
    let α_PB : TensorProduct (MvPolynomial (Fin d) R₀) (MvPolynomial (Fin d) K') B →ₐ[MvPolynomial (Fin d) R₀]
        TensorProduct R₀ B K' :=
      Algebra.TensorProduct.lift g_P g_B (fun _ _ => mul_comm _ _)
    have hα_tmul : ∀ (p : MvPolynomial (Fin d) K') (b : B),
        α_PB (TensorProduct.tmul (MvPolynomial (Fin d) R₀) p b) = g_P_hom p * ιB_BK b :=
      fun p b => Algebra.TensorProduct.lift_tmul g_P g_B (fun _ _ => mul_comm _ _) p b
    let ιP_PB : MvPolynomial (Fin d) K' →+*
        TensorProduct (MvPolynomial (Fin d) R₀) (MvPolynomial (Fin d) K') B :=
      (Algebra.TensorProduct.includeLeft :
        MvPolynomial (Fin d) K' →ₐ[MvPolynomial (Fin d) R₀]
          TensorProduct (MvPolynomial (Fin d) R₀) (MvPolynomial (Fin d) K') B).toRingHom
    let ιB_PB : B →+* TensorProduct (MvPolynomial (Fin d) R₀) (MvPolynomial (Fin d) K') B :=
      (Algebra.TensorProduct.includeRight (R := MvPolynomial (Fin d) R₀)
        (A := MvPolynomial (Fin d) K')).toRingHom
    letI : Algebra R₀ (TensorProduct (MvPolynomial (Fin d) R₀) (MvPolynomial (Fin d) K') B) :=
      (ιB_PB.comp (algebraMap R₀ B)).toAlgebra
    let h_B : B →ₐ[R₀] TensorProduct (MvPolynomial (Fin d) R₀) (MvPolynomial (Fin d) K') B :=
      { ιB_PB with commutes' := fun _ => rfl }
    have hhK_comm : ∀ r : R₀,
        (ιP_PB.comp MvPolynomial.C) (algebraMap R₀ K' r) = (ιB_PB.comp (algebraMap R₀ B)) r := by
      intro r
      rw [RingHom.comp_apply, RingHom.comp_apply]
      have hC1 : MvPolynomial.C (algebraMap R₀ K' r) = φ_map (MvPolynomial.C r) :=
        (MvPolynomial.map_C (algebraMap R₀ K') r).symm
      have hC2 : algebraMap R₀ B r = algebraMap (MvPolynomial (Fin d) R₀) B (MvPolynomial.C r) :=
        IsScalarTower.algebraMap_apply R₀ (MvPolynomial (Fin d) R₀) B r
      rw [hC1, hC2]
      change TensorProduct.tmul (MvPolynomial (Fin d) R₀) (φ_map (MvPolynomial.C r)) (1 : B) =
        TensorProduct.tmul (MvPolynomial (Fin d) R₀) (1 : MvPolynomial (Fin d) K')
          (algebraMap (MvPolynomial (Fin d) R₀) B (MvPolynomial.C r))
      have hs1 : φ_map (MvPolynomial.C r) =
          (MvPolynomial.C r : MvPolynomial (Fin d) R₀) • (1 : MvPolynomial (Fin d) K') := by
        rw [Algebra.smul_def, mul_one]
        rfl
      have hs2 : algebraMap (MvPolynomial (Fin d) R₀) B (MvPolynomial.C r) =
          (MvPolynomial.C r : MvPolynomial (Fin d) R₀) • (1 : B) := by
        rw [Algebra.smul_def, mul_one]
      rw [hs1, hs2, TensorProduct.smul_tmul]
    let h_K : K' →ₐ[R₀] TensorProduct (MvPolynomial (Fin d) R₀) (MvPolynomial (Fin d) K') B :=
      { ιP_PB.comp MvPolynomial.C with commutes' := hhK_comm }
    let β_PB : TensorProduct R₀ B K' →ₐ[R₀]
        TensorProduct (MvPolynomial (Fin d) R₀) (MvPolynomial (Fin d) K') B :=
      Algebra.TensorProduct.lift h_B h_K (fun _ _ => mul_comm _ _)
    have hβ_tmul : ∀ (b : B) (x_k : K'),
        β_PB (TensorProduct.tmul R₀ b x_k) = ιB_PB b * ιP_PB (MvPolynomial.C x_k) :=
      fun b x_k => Algebra.TensorProduct.lift_tmul h_B h_K (fun _ _ => mul_comm _ _) b x_k
    have h_ab : α_PB.toRingHom.comp β_PB.toRingHom = RingHom.id (TensorProduct R₀ B K') := by
      have h_alg : AlgHom.mk (α_PB.toRingHom.comp β_PB.toRingHom) (fun r => by
          change α_PB (β_PB (algebraMap R₀ (TensorProduct R₀ B K') r)) =
            algebraMap R₀ (TensorProduct R₀ B K') r
          rw [β_PB.commutes]
          change α_PB (TensorProduct.tmul (MvPolynomial (Fin d) R₀) 1 (algebraMap R₀ B r)) = _
          rw [hα_tmul, map_one, one_mul]
          rfl) = AlgHom.id R₀ (TensorProduct R₀ B K') := by
        apply Algebra.TensorProduct.ext
        · apply AlgHom.ext
          intro b
          change α_PB (β_PB (TensorProduct.tmul R₀ b 1)) = TensorProduct.tmul R₀ b 1
          rw [hβ_tmul, map_one, map_one, mul_one]
          change α_PB (TensorProduct.tmul (MvPolynomial (Fin d) R₀) 1 b) = _
          rw [hα_tmul, map_one, one_mul]
          rfl
        · apply AlgHom.ext
          intro x_k
          change α_PB (β_PB (TensorProduct.tmul R₀ 1 x_k)) = TensorProduct.tmul R₀ 1 x_k
          rw [hβ_tmul, map_one, one_mul]
          change α_PB (TensorProduct.tmul (MvPolynomial (Fin d) R₀) (MvPolynomial.C x_k) 1) = _
          rw [hα_tmul, map_one, mul_one]
          change MvPolynomial.eval₂ ιK_BK _ (MvPolynomial.C x_k) = _
          rw [MvPolynomial.eval₂_C]
          rfl
      exact congrArg AlgHom.toRingHom h_alg
    have h_ba : β_PB.toRingHom.comp α_PB.toRingHom =
        RingHom.id (TensorProduct (MvPolynomial (Fin d) R₀) (MvPolynomial (Fin d) K') B) := by
      have h_alg : AlgHom.mk (β_PB.toRingHom.comp α_PB.toRingHom) (fun p => by
          change β_PB (α_PB (algebraMap (MvPolynomial (Fin d) R₀)
            (TensorProduct (MvPolynomial (Fin d) R₀) (MvPolynomial (Fin d) K') B) p)) = _
          rw [α_PB.commutes]
          change β_PB (TensorProduct.tmul R₀ (algebraMap (MvPolynomial (Fin d) R₀) B p) 1) =
            TensorProduct.tmul (MvPolynomial (Fin d) R₀) (φ_map p) 1
          rw [hβ_tmul, map_one, map_one, mul_one]
          change TensorProduct.tmul (MvPolynomial (Fin d) R₀) 1
            (algebraMap (MvPolynomial (Fin d) R₀) B p) =
            TensorProduct.tmul (MvPolynomial (Fin d) R₀) (φ_map p) 1
          have hs1 : φ_map p = p • (1 : MvPolynomial (Fin d) K') := by
            rw [Algebra.smul_def, mul_one]
            rfl
          have hs2 : algebraMap (MvPolynomial (Fin d) R₀) B p = p • (1 : B) := by
            rw [Algebra.smul_def, mul_one]
          rw [hs1, hs2, TensorProduct.smul_tmul]) =
          AlgHom.id (MvPolynomial (Fin d) R₀)
            (TensorProduct (MvPolynomial (Fin d) R₀) (MvPolynomial (Fin d) K') B) := by
        apply Algebra.TensorProduct.ext
        · apply AlgHom.coe_ringHom_injective
          apply MvPolynomial.ringHom_ext
          · intro x_k
            change β_PB (α_PB (TensorProduct.tmul (MvPolynomial (Fin d) R₀) (MvPolynomial.C x_k) 1)) =
              TensorProduct.tmul (MvPolynomial (Fin d) R₀) (MvPolynomial.C x_k) 1
            rw [hα_tmul, map_one, mul_one]
            change β_PB (MvPolynomial.eval₂ ιK_BK _ (MvPolynomial.C x_k)) = _
            rw [MvPolynomial.eval₂_C]
            change β_PB (TensorProduct.tmul R₀ 1 x_k) = _
            rw [hβ_tmul, map_one, one_mul]
            rfl
          · intro i
            change β_PB (α_PB (TensorProduct.tmul (MvPolynomial (Fin d) R₀) (MvPolynomial.X i) 1)) =
              TensorProduct.tmul (MvPolynomial (Fin d) R₀) (MvPolynomial.X i) 1
            rw [hα_tmul, map_one, mul_one]
            change β_PB (MvPolynomial.eval₂ ιK_BK _ (MvPolynomial.X i)) = _
            rw [MvPolynomial.eval₂_X]
            rw [hβ_tmul, map_one, map_one, mul_one]
            change TensorProduct.tmul (MvPolynomial (Fin d) R₀) 1
              (algebraMap (MvPolynomial (Fin d) R₀) B (MvPolynomial.X i)) =
              TensorProduct.tmul (MvPolynomial (Fin d) R₀) (MvPolynomial.X i) 1
            have hx1 : (MvPolynomial.X i : MvPolynomial (Fin d) K') =
                (MvPolynomial.X i : MvPolynomial (Fin d) R₀) • (1 : MvPolynomial (Fin d) K') := by
              rw [Algebra.smul_def, mul_one]
              exact (MvPolynomial.map_X (algebraMap R₀ K') i).symm
            have hx2 : algebraMap (MvPolynomial (Fin d) R₀) B (MvPolynomial.X i) =
                (MvPolynomial.X i : MvPolynomial (Fin d) R₀) • (1 : B) := by
              rw [Algebra.smul_def, mul_one]
            rw [hx1, hx2, TensorProduct.smul_tmul]
        · apply AlgHom.ext
          intro b
          change β_PB (α_PB (TensorProduct.tmul (MvPolynomial (Fin d) R₀) 1 b)) =
            TensorProduct.tmul (MvPolynomial (Fin d) R₀) 1 b
          rw [hα_tmul, map_one, one_mul]
          change β_PB (TensorProduct.tmul R₀ b 1) = _
          rw [hβ_tmul, map_one, map_one, mul_one]
          rfl
      exact congrArg AlgHom.toRingHom h_alg
    let e_PB : TensorProduct (MvPolynomial (Fin d) R₀) (MvPolynomial (Fin d) K') B ≃+*
        TensorProduct R₀ B K' :=
      { α_PB.toRingHom with
        invFun := β_PB.toRingHom
        left_inv := RingHom.congr_fun h_ba
        right_inv := RingHom.congr_fun h_ab }
    let e_tot : TensorProduct (MvPolynomial (Fin d) R₀) (MvPolynomial (Fin d) K') B ≃+* B' :=
      e_PB.trans eB
    refine ⟨e_tot.toRingHom.comp (algebraMap (MvPolynomial (Fin d) K')
      (TensorProduct (MvPolynomial (Fin d) R₀) (MvPolynomial (Fin d) K') B)), ?_⟩
    have h1 : (algebraMap (MvPolynomial (Fin d) K')
        (TensorProduct (MvPolynomial (Fin d) R₀) (MvPolynomial (Fin d) K') B)).Etale :=
      RingHom.etale_algebraMap.mpr hEtBC
    have h2 : e_tot.toRingHom.Etale := RingHom.Etale.of_bijective e_tot.bijective
    exact RingHom.Etale.stableUnderComposition _ _ h1 h2
  have tensor_fractionRing_equiv : ∀ (R₀ B : Type u) [CommRing R₀] [IsDomain R₀]
      [CommRing B] [Algebra R₀ B],
      Nonempty (TensorProduct R₀ B (FractionRing R₀) ≃+*
        Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors R₀))) := by
    intro R₀ B _ _ _ _
    let K' := FractionRing R₀
    let S₀ : Submonoid B := Algebra.algebraMapSubmonoid B (nonZeroDivisors R₀)
    let B' := Localization S₀
    have hK'_units : ∀ y : nonZeroDivisors R₀,
        IsUnit (((algebraMap B B').comp (algebraMap R₀ B)) y) := by
      intro y
      have hy_mem : algebraMap R₀ B y.1 ∈ S₀ := ⟨y.1, y.2, rfl⟩
      exact IsLocalization.map_units B' ⟨algebraMap R₀ B y.1, hy_mem⟩
    let f_K' : K' →ₐ[R₀] B' :=
      { IsLocalization.lift (M := nonZeroDivisors R₀) (S := K') hK'_units with
        commutes' := fun r => IsLocalization.lift_eq (M := nonZeroDivisors R₀) hK'_units r }
    let f_B : B →ₐ[R₀] B' := IsScalarTower.toAlgHom R₀ B B'
    let α : TensorProduct R₀ B K' →ₐ[R₀] B' :=
      Algebra.TensorProduct.lift f_B f_K' (fun _ _ => mul_comm _ _)
    have hα_tmul : ∀ (b : B) (x_k : K'),
        α (TensorProduct.tmul R₀ b x_k) = f_B b * f_K' x_k :=
      fun b x_k => Algebra.TensorProduct.lift_tmul f_B f_K' (fun _ _ => mul_comm _ _) b x_k
    let ι_left : B →+* TensorProduct R₀ B K' :=
      (Algebra.TensorProduct.includeLeft : B →ₐ[R₀] TensorProduct R₀ B K').toRingHom
    have hS₀_units : ∀ y : S₀, IsUnit (ι_left y) := by
      rintro ⟨_, ⟨r, hr, rfl⟩⟩
      have hr_unit : IsUnit (algebraMap R₀ K' r) :=
        IsLocalization.map_units K' ⟨r, hr⟩
      have h_eq : ι_left (algebraMap R₀ B r) =
          Algebra.TensorProduct.includeRight (R := R₀) (A := B) (algebraMap R₀ K' r) := by
        change TensorProduct.tmul R₀ (algebraMap R₀ B r) (1 : K') =
          TensorProduct.tmul R₀ (1 : B) (algebraMap R₀ K' r)
        have h1 : algebraMap R₀ B r = r • (1 : B) := by rw [Algebra.smul_def, mul_one]
        have h2 : algebraMap R₀ K' r = r • (1 : K') := by rw [Algebra.smul_def, mul_one]
        rw [h1, h2, TensorProduct.smul_tmul]
      rw [h_eq]
      exact hr_unit.map (Algebra.TensorProduct.includeRight (R := R₀) (A := B)).toRingHom
    let β : B' →+* TensorProduct R₀ B K' := IsLocalization.lift (M := S₀) hS₀_units
    have h_ab : α.toRingHom.comp β = RingHom.id B' := by
      refine IsLocalization.ringHom_ext S₀ ?_
      apply RingHom.ext
      intro b
      rw [RingHom.comp_apply, RingHom.comp_apply, RingHom.id_comp]
      change α (β (algebraMap B B' b)) = algebraMap B B' b
      rw [IsLocalization.lift_eq (M := S₀) hS₀_units b]
      change α (TensorProduct.tmul R₀ b 1) = algebraMap B B' b
      rw [hα_tmul, map_one, mul_one]
      rfl
    have h_ba : β.comp α.toRingHom = RingHom.id (TensorProduct R₀ B K') := by
      have h_alg : AlgHom.mk (β.comp α.toRingHom) (fun r => by
          change β (α (algebraMap R₀ (TensorProduct R₀ B K') r)) = _
          rw [α.commutes]
          change β (algebraMap B B' (algebraMap R₀ B r)) = _
          rw [IsLocalization.lift_eq]
          rfl) = AlgHom.id R₀ (TensorProduct R₀ B K') := by
        apply Algebra.TensorProduct.ext
        · apply AlgHom.ext
          intro b
          change β (α (TensorProduct.tmul R₀ b 1)) = TensorProduct.tmul R₀ b 1
          rw [hα_tmul, map_one, mul_one]
          exact IsLocalization.lift_eq (M := S₀) hS₀_units b
        · apply AlgHom.coe_ringHom_injective
          refine IsLocalization.ringHom_ext (nonZeroDivisors R₀) ?_
          apply RingHom.ext
          intro r
          change β (α (TensorProduct.tmul R₀ 1 (algebraMap R₀ K' r))) =
            TensorProduct.tmul R₀ 1 (algebraMap R₀ K' r)
          rw [hα_tmul, map_one, one_mul]
          have hfk : f_K' (algebraMap R₀ K' r) = algebraMap B B' (algebraMap R₀ B r) :=
            IsLocalization.lift_eq (M := nonZeroDivisors R₀) hK'_units r
          rw [hfk, IsLocalization.lift_eq (M := S₀) hS₀_units (algebraMap R₀ B r)]
          change TensorProduct.tmul R₀ (algebraMap R₀ B r) (1 : K') =
            TensorProduct.tmul R₀ (1 : B) (algebraMap R₀ K' r)
          have h1 : algebraMap R₀ B r = r • (1 : B) := by rw [Algebra.smul_def, mul_one]
          have h2 : algebraMap R₀ K' r = r • (1 : K') := by rw [Algebra.smul_def, mul_one]
          rw [h1, h2, TensorProduct.smul_tmul]
      exact congrArg AlgHom.toRingHom h_alg
    exact ⟨{ α.toRingHom with
      invFun := β
      left_inv := RingHom.congr_fun h_ba
      right_inv := RingHom.congr_fun h_ab }⟩
  have etale_mvPolynomial_atPrime_isDomain : ∀ (d : ℕ) (K : Type u) [Field K]
      (B : Type u) [CommRing B] (φ : MvPolynomial (Fin d) K →+* B), φ.Etale →
      ∀ (q : Ideal B) [q.IsPrime], IsDomain (Localization.AtPrime q) := by
    intro d
    induction d with
    | zero =>
      intro K _ B _ φ hφ q _
      exact etale_zero_atPrime_isDomain K B φ hφ q
    | succ d ih =>
      intro K _ B _ φ hφ q _
      let R₀ : Type u := Polynomial K
      let A_d : Type u := MvPolynomial (Fin d) R₀
      let e_step : A_d ≃ₐ[K] MvPolynomial (Fin (d + 1)) K :=
        ((MvPolynomial.renameEquiv K (finSuccEquiv d)).trans
          (MvPolynomial.optionEquivRight K (Fin d))).symm
      let φ_d : A_d →+* B := φ.comp e_step.toRingHom
      have hφ_d : φ_d.Etale :=
        RingHom.Etale.stableUnderComposition _ _ (RingHom.Etale.of_bijective e_step.bijective) hφ
      have hStepAlg : ∀ [Algebra R₀ B] [Algebra A_d B] [IsScalarTower R₀ A_d B]
          [Algebra.Etale A_d B], IsDomain (Localization.AtPrime q) := by
        intro _ _ _ _
        let q₀ : Ideal R₀ := q.comap (algebraMap R₀ B)
        haveI hq₀_prime : q₀.IsPrime := Ideal.comap_isPrime (algebraMap R₀ B) q
        by_cases hq₀_bot : q₀ = ⊥
        · let K' : Type u := FractionRing R₀
          let S₀ : Submonoid B := Algebra.algebraMapSubmonoid B (nonZeroDivisors R₀)
          let B' : Type u := Localization S₀
          haveI : IsLocalization S₀ B' := Localization.isLocalization
          obtain ⟨eB⟩ := tensor_fractionRing_equiv R₀ B
          obtain ⟨ψ', hψ'⟩ := etale_poly_baseChange_aux R₀ K' d B B' eB
          have hS₀_le : S₀ ≤ q.primeCompl := by
            rintro _ ⟨r, hr, rfl⟩ hmem
            have hr_q₀ : r ∈ q₀ := hmem
            rw [hq₀_bot, Ideal.mem_bot] at hr_q₀
            exact nonZeroDivisors.ne_zero hr hr_q₀
          have hDisj : Disjoint (S₀ : Set B) (q : Set B) :=
            Set.disjoint_left.mpr fun s hs hsq => hS₀_le hs hsq
          let q' : Ideal B' := Ideal.map (algebraMap B B') q
          haveI hq'_prime : q'.IsPrime :=
            IsLocalization.isPrime_of_isPrime_disjoint S₀ B' q inferInstance hDisj
          have hq'_comap : q'.comap (algebraMap B B') = q :=
            IsLocalization.comap_map_of_isPrime_disjoint S₀ B' inferInstance hDisj
          haveI hDomL' : IsDomain (Localization.AtPrime q') := ih K' B' ψ' hψ' q'
          let L := Localization.AtPrime q
          let L' := Localization.AtPrime q'
          have hΦ_units : ∀ y : q.primeCompl,
              IsUnit (((algebraMap B' L').comp (algebraMap B B')) y) := by
            intro y
            have hy' : algebraMap B B' y.1 ∈ q'.primeCompl := by
              intro hmem
              have hmem' : y.1 ∈ q'.comap (algebraMap B B') := hmem
              rw [hq'_comap] at hmem'
              exact y.2 hmem'
            exact IsLocalization.map_units L' (⟨algebraMap B B' y.1, hy'⟩ : q'.primeCompl)
          let Φ : L →+* L' := IsLocalization.lift (M := q.primeCompl) hΦ_units
          have hB'_units : ∀ y : S₀, IsUnit (algebraMap B L y) :=
            fun y => IsLocalization.map_units L (⟨y.1, hS₀_le y.2⟩ : q.primeCompl)
          let g_B' : B' →+* L := IsLocalization.lift (M := S₀) hB'_units
          have hΨ_units : ∀ y : q'.primeCompl, IsUnit (g_B' y) := by
            intro y
            obtain ⟨⟨b, s⟩, hbs⟩ := IsLocalization.surj S₀ y.1
            dsimp at hbs
            have hb_not_q : b ∉ q := by
              intro hbq
              have hb_q' : algebraMap B B' b ∈ q' := Ideal.mem_map_of_mem _ hbq
              rw [← hbs] at hb_q'
              rcases hq'_prime.mem_or_mem hb_q' with hy_q' | hs_q'
              · exact y.2 hy_q'
              · have hs_q : s.1 ∈ q'.comap (algebraMap B B') := hs_q'
                rw [hq'_comap] at hs_q
                exact hS₀_le s.2 hs_q
            have hb_unit : IsUnit (g_B' (algebraMap B B' b)) := by
              rw [IsLocalization.lift_eq (M := S₀) hB'_units b]
              exact IsLocalization.map_units L (⟨b, hb_not_q⟩ : q.primeCompl)
            have hs_unit : IsUnit (g_B' (algebraMap B B' s.1)) := by
              rw [IsLocalization.lift_eq (M := S₀) hB'_units s.1]
              exact hB'_units s
            have hmul_unit : IsUnit (g_B' y.1 * g_B' (algebraMap B B' s.1)) := by
              rw [← map_mul, hbs]
              exact hb_unit
            exact isUnit_of_mul_isUnit_left hmul_unit
          let Ψ : L' →+* L := IsLocalization.lift (M := q'.primeCompl) hΨ_units
          have h_left : Ψ.comp Φ = RingHom.id L := by
            refine IsLocalization.ringHom_ext q.primeCompl ?_
            apply RingHom.ext
            intro b
            rw [RingHom.comp_apply, RingHom.comp_apply, RingHom.comp_apply, RingHom.id_apply]
            change Ψ (Φ (algebraMap B L b)) = algebraMap B L b
            rw [IsLocalization.lift_eq (M := q.primeCompl) hΦ_units b]
            change Ψ (algebraMap B' L' (algebraMap B B' b)) = algebraMap B L b
            rw [IsLocalization.lift_eq (M := q'.primeCompl) hΨ_units (algebraMap B B' b)]
