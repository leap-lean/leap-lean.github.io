    let I : Finset (Fin (m + 1)) := insert (Fin.last m) (I_B.map Fin.castSuccEmb)
    have hφR_loc : φ_R.comp (loc_A₂.comp loc_A₁) =
        (loc_S₃.comp loc_S₂).comp (φ₂.comp loc_A₁) := by
      ext a
      exact congrArg loc_S₃ (RingHom.congr_fun hφ₃_comp (loc_A₁ a))
    have heX_f₁ : e_X ≫ f₁.left =
        Spec.map (CommRingCat.ofHom (φ_R.comp (loc_A₂.comp loc_A₁))) ≫ e_B₁ := by
      calc
        e_X ≫ f₁.left = Spec.map (CommRingCat.ofHom loc_S₃) ≫
            Spec.map (CommRingCat.ofHom loc_S₂) ≫ (e_S₂ ≫ f₁.left) := by
