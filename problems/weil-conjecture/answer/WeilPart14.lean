          simp only [Submonoid.coe_one, map_one, one_mul, hκ₀_val]
          dsimp only [δ, dehom]
          rw [RingHom.comp_apply, MvPolynomial.eval₂Hom_C]
        · intro r
          simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe]
          rw [heX β' r.1 r.2]
          unfold HomogeneousLocalization.Away.isLocalizationElem
          rw [HomogeneousLocalization.awayMap_mk, hω_apply, HomogeneousLocalization.Away.val_mk]
          apply hδ_loc_spec
          have hδ_Xβ : δ (MvPolynomial.X β) = 1 := by
            dsimp only [δ, dehom]
            rw [RingHom.comp_apply, MvPolynomial.eval₂Hom_X']
            simp only [↓reduceDIte, map_one]
          have hδ_Xβ' : δ (MvPolynomial.X β') = algebraMap P_β L_loc x_β' := by
            dsimp only [δ, dehom, x_β']
            rw [RingHom.comp_apply, MvPolynomial.eval₂Hom_X']
            simp only [hβ', ↓reduceDIte]
          simp only [pow_one, map_mul, hδ_Xβ, hδ_Xβ', one_mul, mul_one]
          dsimp only [τ_ββ', δ, dehom]
          rw [RingHom.comp_apply, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X']
          by_cases hαβ : r.1 = β
          · simp only [hαβ, ↓reduceDIte, map_one]
            exact (IsLocalization.Away.mul_invSelf (S := L_loc) x_β').symm
          · simp only [hαβ, ↓reduceDIte]
            calc
              algebraMap P_β L_loc (MvPolynomial.X ⟨r.1, hαβ⟩)
                = algebraMap P_β L_loc (MvPolynomial.X ⟨r.1, hαβ⟩) * 1 := (mul_one _).symm
              _ = algebraMap P_β L_loc (MvPolynomial.X ⟨r.1, hαβ⟩) *
                    (algebraMap P_β L_loc x_β' * IsLocalization.Away.invSelf x_β') := by
                    rw [IsLocalization.Away.mul_invSelf]
              _ = algebraMap P_β L_loc x_β' *
                    (algebraMap P_β L_loc (MvPolynomial.X ⟨r.1, hαβ⟩) *
                      IsLocalization.Away.invSelf x_β') := by ring
      apply RingHom.ext
      intro z
      simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe]
      have hz := RingHom.congr_fun h₂ ((e β').symm z)
      simpa only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe,
        RingEquiv.apply_symm_apply] using hz
  
  let iso_raw : ∀ β : Fin (L + 1),
      (U_raw β : AlgebraicGeometry.Scheme.{u}) ≅
        AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial {α : Fin (L + 1) // α ≠ β} k)) :=
    fun β =>
      (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 (MvPolynomial.X β) (hX β) zero_lt_one) ≪≫
        { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (e β).toRingHom)
          inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (e β).symm.toRingHom)
          hom_inv_id := by
            rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
            have hcomp : (e β).toRingHom.comp (e β).symm.toRingHom = RingHom.id _ := by
              apply RingHom.ext
              intro z
              exact (e β).apply_symm_apply z
            rw [hcomp, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
          inv_hom_id := by
            rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
            have hcomp : (e β).symm.toRingHom.comp (e β).toRingHom = RingHom.id _ := by
              apply RingHom.ext
              intro z
              exact (e β).symm_apply_apply z
            rw [hcomp, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id] }
  have hiso_inv_ι : ∀ β : Fin (L + 1),
      (iso_raw β).inv ≫ (U_raw β).ι =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (e β).symm.toRingHom) ≫
          AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X β) (hX β) zero_lt_one := by
    intro β
    dsimp only [iso_raw, CategoryTheory.Iso.trans_inv]
    rw [CategoryTheory.Category.assoc, AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι]
  have hiso_hom : ∀ β : Fin (L + 1),
      (U_raw β).ι ≫
        (AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom κ₀)) =
        (iso_raw β).hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) := by
    intro β
    rw [← CategoryTheory.Iso.cancel_iso_inv_left (iso_raw β)]
    rw [← CategoryTheory.Category.assoc ((iso_raw β).inv), hiso_inv_ι β,
      CategoryTheory.Category.assoc, AlgebraicGeometry.Proj.awayι_toSpecZero_assoc,
      ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
      ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp,
      CategoryTheory.Iso.inv_hom_id_assoc]
    congr 2
    apply RingHom.ext
    intro c
    exact heC_symm β c
  have hiso_pre : ∀ (β β' : Fin (L + 1)) (hβ' : β' ≠ β),
      ((iso_raw β).inv ≫ (U_raw β).ι) ⁻¹ᵁ U_raw β' =
        PrimeSpectrum.basicOpen (MvPolynomial.X ⟨β', hβ'⟩) := by
    intro β β' hβ'
    rw [hiso_inv_ι β, AlgebraicGeometry.Scheme.Hom.comp_preimage,
      AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜 (hX β) zero_lt_one (hX β') zero_lt_one,
      AlgebraicGeometry.SpecMap_preimage_basicOpen]
    change PrimeSpectrum.basicOpen
        ((e β).symm (HomogeneousLocalization.Away.isLocalizationElem (hX β) (hX β'))) =
      PrimeSpectrum.basicOpen (MvPolynomial.X ⟨β', hβ'⟩)
    rw [heX_symm β β' hβ']
  have hiso_trans : ∀ (β β' : Fin (L + 1)) (hβ' : β' ≠ β),
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (algebraMap (MvPolynomial {α : Fin (L + 1) // α ≠ β} k)
            (Localization.Away (MvPolynomial.X ⟨β', hβ'⟩ :
              MvPolynomial {α : Fin (L + 1) // α ≠ β} k)))) ≫
          (iso_raw β).inv ≫ (U_raw β).ι =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (MvPolynomial.eval₂Hom
            ((algebraMap (MvPolynomial {α : Fin (L + 1) // α ≠ β} k)
              (Localization.Away (MvPolynomial.X ⟨β', hβ'⟩ :
                MvPolynomial {α : Fin (L + 1) // α ≠ β} k))).comp MvPolynomial.C)
            (fun α : {α : Fin (L + 1) // α ≠ β'} =>
              if h : α.1 = β then
                IsLocalization.Away.invSelf
                  (MvPolynomial.X ⟨β', hβ'⟩ : MvPolynomial {α : Fin (L + 1) // α ≠ β} k)
              else
                algebraMap (MvPolynomial {α : Fin (L + 1) // α ≠ β} k) _
                  (MvPolynomial.X ⟨α.1, h⟩) *
                IsLocalization.Away.invSelf
                  (MvPolynomial.X ⟨β', hβ'⟩ : MvPolynomial {α : Fin (L + 1) // α ≠ β} k)))) ≫
          (iso_raw β').inv ≫ (U_raw β').ι := by
    intro β β' hβ'
    obtain ⟨ω, hω₁, hω₂⟩ := h_roof β β' hβ'
    rw [hiso_inv_ι β, hiso_inv_ι β',
      ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp, ← hω₁, CommRingCat.ofHom_comp,
      AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc,
      AlgebraicGeometry.Proj.SpecMap_awayMap_awayι 𝒜 (hX β) zero_lt_one (hX β') rfl]
    symm
    rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp, ← hω₂, CommRingCat.ofHom_comp,
      AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc,
      AlgebraicGeometry.Proj.SpecMap_awayMap_awayι 𝒜 (hX β') zero_lt_one (hX β)
        (mul_comm (MvPolynomial.X β) (MvPolynomial.X β'))]
  exact ⟨hProp, U_raw, iso_raw, hCov, hiso_hom, hiso_pre, hiso_trans⟩

theorem weil_cocycle_generators_open_proj_morphism (k : Type u) [Field k]
    (X P : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (K : Set X.left)
    (hClosedK : IsClosed K)
    (M L : ℕ)
    (W : Fin (M + 1) → X.left.affineOpens)
    (h : ∀ ν : Fin (M + 1), Fin (L + 1) → ↑(X.left.presheaf.obj (Opposite.op (W ν).1)))
    (hCov : (⨆ ν : Fin (M + 1), (W ν).1) = ⊤)
    (hSpan : ∀ ν : Fin (M + 1),
      Ideal.span (Set.range (h ν)) =
        (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal ⟨K, hClosedK⟩).ideal (W ν))
    (hUnit : ∀ ν μ : Fin (M + 1),
      ∃ u : ↑(X.left.presheaf.obj (Opposite.op ((W ν).1 ⊓ (W μ).1))),
        IsUnit u ∧
        ∀ β : Fin (L + 1),
          (X.left.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (h ν β) =
            u * (X.left.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom (h μ β))
    (U_L : Fin (L + 1) → P.left.Opens)
    (iso_L : ∀ β : Fin (L + 1),
      (U_L β : AlgebraicGeometry.Scheme.{u}) ≅
        AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial {α : Fin (L + 1) // α ≠ β} k)))
    (hUL_hom : ∀ β : Fin (L + 1),
      (U_L β).ι ≫ P.hom =
        (iso_L β).hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C))
    (hUL_pre : ∀ (β β' : Fin (L + 1)) (hβ' : β' ≠ β),
      ((iso_L β).inv ≫ (U_L β).ι) ⁻¹ᵁ U_L β' =
        PrimeSpectrum.basicOpen (MvPolynomial.X ⟨β', hβ'⟩))
    (hUL_trans : ∀ (β β' : Fin (L + 1)) (hβ' : β' ≠ β),
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (algebraMap (MvPolynomial {α : Fin (L + 1) // α ≠ β} k)
            (Localization.Away (MvPolynomial.X ⟨β', hβ'⟩ :
              MvPolynomial {α : Fin (L + 1) // α ≠ β} k)))) ≫
          (iso_L β).inv ≫ (U_L β).ι =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (MvPolynomial.eval₂Hom
            ((algebraMap (MvPolynomial {α : Fin (L + 1) // α ≠ β} k)
              (Localization.Away (MvPolynomial.X ⟨β', hβ'⟩ :
                MvPolynomial {α : Fin (L + 1) // α ≠ β} k))).comp MvPolynomial.C)
            (fun α : {α : Fin (L + 1) // α ≠ β'} =>
              if h : α.1 = β then
                IsLocalization.Away.invSelf
                  (MvPolynomial.X ⟨β', hβ'⟩ : MvPolynomial {α : Fin (L + 1) // α ≠ β} k)
              else
                algebraMap (MvPolynomial {α : Fin (L + 1) // α ≠ β} k) _
                  (MvPolynomial.X ⟨α.1, h⟩) *
                IsLocalization.Away.invSelf
                  (MvPolynomial.X ⟨β', hβ'⟩ : MvPolynomial {α : Fin (L + 1) // α ≠ β} k)))) ≫
          (iso_L β').inv ≫ (U_L β').ι) :
    ∃ (U₀ : X.left.Opens)
      (γ : (U₀ : AlgebraicGeometry.Scheme.{u}) ⟶ P.left),
      (U₀ : Set X.left) = Kᶜ ∧
      (U₀.ι ≫ X.hom = γ ≫ P.hom) ∧
      (∀ (ν : Fin (M + 1)) (β : Fin (L + 1)),
        ∃ (e_loc :
            ((((U₀.ι ⁻¹ᵁ (W ν).1) ⊓ (γ ⁻¹ᵁ U_L β) : (U₀ : AlgebraicGeometry.Scheme.{u}).Opens) :
              AlgebraicGeometry.Scheme.{u}) ≅
              AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (h ν β))))),
          (e_loc.inv ≫ ((U₀.ι ⁻¹ᵁ (W ν).1) ⊓ (γ ⁻¹ᵁ U_L β)).ι ≫ U₀.ι =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (algebraMap (↑(X.left.presheaf.obj (Opposite.op (W ν).1)))
                (Localization.Away (h ν β)))) ≫ (W ν).2.fromSpec) ∧
          (e_loc.inv ≫ ((U₀.ι ⁻¹ᵁ (W ν).1) ⊓ (γ ⁻¹ᵁ U_L β)).ι ≫ γ =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (MvPolynomial.eval₂Hom
                ((algebraMap (↑(X.left.presheaf.obj (Opposite.op (W ν).1)))
                  (Localization.Away (h ν β))).comp
                  (AlgebraicGeometry.Spec.preimage ((W ν).2.fromSpec ≫ X.hom)).hom)
                (fun α : {α : Fin (L + 1) // α ≠ β} =>
                  algebraMap (↑(X.left.presheaf.obj (Opposite.op (W ν).1)))
                    (Localization.Away (h ν β)) (h ν α.1) *
                  IsLocalization.Away.invSelf (S := Localization.Away (h ν β)) (h ν β)))) ≫
              (iso_L β).inv ≫ (U_L β).ι)) :=
by
  
  let U₀ : X.left.Opens := ⟨Kᶜ, hClosedK.isOpen_compl⟩
  let V : Fin (M + 1) → Fin (L + 1) → X.left.Opens :=
    fun ν α => X.left.basicOpen (h ν α)
  have hLocalCov : ∀ ν : Fin (M + 1), (W ν).1 ⊓ U₀ = ⨆ α : Fin (L + 1), V ν α := by
    intro ν
    set S_ν : Set (PrimeSpectrum ↑(X.left.presheaf.obj (Opposite.op (W ν).1))) :=
      (W ν).2.fromSpec.base ⁻¹' K
    have hClosedS : IsClosed S_ν := hClosedK.preimage (W ν).2.fromSpec.continuous
    have hIdeal_eq : Ideal.span (Set.range (h ν)) = PrimeSpectrum.vanishingIdeal S_ν := by
      rw [hSpan ν, AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal_ideal]
      rfl
    have hZL : PrimeSpectrum.zeroLocus (Set.range (h ν)) = S_ν := by
      have h0 := congrArg (fun I : Ideal ↑(X.left.presheaf.obj (Opposite.op (W ν).1)) =>
        PrimeSpectrum.zeroLocus (I : Set ↑(X.left.presheaf.obj (Opposite.op (W ν).1)))) hIdeal_eq
      rw [PrimeSpectrum.zeroLocus_span, PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure,
        hClosedS.closure_eq] at h0
      exact h0
    apply le_antisymm
    · intro x hx
      rcases hx with ⟨hxW, hxU₀⟩
      have hxW_range : x ∈ Set.range (W ν).2.fromSpec.base := by
        rw [(W ν).2.range_fromSpec]
        exact hxW
      rcases hxW_range with ⟨q : PrimeSpectrum ↑(X.left.presheaf.obj (Opposite.op (W ν).1)), hq⟩
      have hq_not_S : q ∉ S_ν := by
        intro hqS
        apply hxU₀
        rw [← hq]
        exact hqS
      rw [← hZL, PrimeSpectrum.mem_zeroLocus, Set.not_subset] at hq_not_S
      rcases hq_not_S with ⟨_, ⟨α, rfl⟩, hqα⟩
      have hq_bo : (q : ↥(AlgebraicGeometry.Spec (X.left.presheaf.obj (Opposite.op (W ν).1)))) ∈
          (W ν).2.fromSpec ⁻¹ᵁ V ν α := by
        rw [(W ν).2.fromSpec_preimage_basicOpen (h ν α)]
        exact (PrimeSpectrum.mem_basicOpen _ _).mpr hqα
      have hxV : x ∈ V ν α := by
        change (W ν).2.fromSpec.base q ∈ V ν α at hq_bo
        rwa [hq] at hq_bo
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨α, hxV⟩
    · refine iSup_le fun α x hx => ⟨X.left.basicOpen_le (h ν α) hx, ?_⟩
      have hxW_range : x ∈ Set.range (W ν).2.fromSpec.base := by
        rw [(W ν).2.range_fromSpec]
        exact X.left.basicOpen_le (h ν α) hx
      rcases hxW_range with ⟨q : PrimeSpectrum ↑(X.left.presheaf.obj (Opposite.op (W ν).1)), hq⟩
      have hq_pre : (q : ↥(AlgebraicGeometry.Spec (X.left.presheaf.obj (Opposite.op (W ν).1)))) ∈
          (W ν).2.fromSpec ⁻¹ᵁ V ν α := by
        change (W ν).2.fromSpec.base q ∈ V ν α
        rwa [hq]
      rw [(W ν).2.fromSpec_preimage_basicOpen (h ν α)] at hq_pre
      have hq_bo : h ν α ∉ q.asIdeal := (PrimeSpectrum.mem_basicOpen _ _).mp hq_pre
      change x ∉ K
      intro hxK
      have hqS : q ∈ S_ν := by
        change (W ν).2.fromSpec.base q ∈ K
        rwa [hq]
      rw [← hZL, PrimeSpectrum.mem_zeroLocus] at hqS
      exact hq_bo (hqS ⟨α, rfl⟩)
  have hV_sub_U₀ : ∀ (ν : Fin (M + 1)) (α : Fin (L + 1)), V ν α ≤ U₀ := fun ν α =>
    (le_iSup (V ν) α).trans ((hLocalCov ν).symm.le.trans inf_le_right)
  let Idx : Type u := ULift.{u} (Fin (M + 1) × Fin (L + 1))
  let W_U : Idx → (U₀ : AlgebraicGeometry.Scheme.{u}).Opens :=
    fun p => U₀.ι ⁻¹ᵁ V p.down.1 p.down.2
  have hSup_WU : (⨆ p : Idx, W_U p) = ⊤ := by
    rw [eq_top_iff]
    intro u _
    have hu_top : u.1 ∈ (⊤ : X.left.Opens) := trivial
    rw [← hCov, TopologicalSpace.Opens.mem_iSup] at hu_top
    rcases hu_top with ⟨ν, huW⟩
    have huWU : u.1 ∈ (W ν).1 ⊓ U₀ := ⟨huW, u.2⟩
    rw [hLocalCov ν, TopologicalSpace.Opens.mem_iSup] at huWU
    rcases huWU with ⟨α, huV⟩
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨ULift.up (ν, α), huV⟩
  have hCov_WU : TopologicalSpace.IsOpenCover W_U := TopologicalSpace.IsOpenCover.mk hSup_WU
  let 𝒰 : (U₀ : AlgebraicGeometry.Scheme.{u}).OpenCover :=
    (U₀ : AlgebraicGeometry.Scheme.{u}).openCoverOfIsOpenCover W_U hCov_WU

  
  let j_loc : ∀ (ν : Fin (M + 1)) (α : Fin (L + 1)),
      AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (h ν α))) ⟶ X.left :=
    fun ν α =>
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap (↑(X.left.presheaf.obj (Opposite.op (W ν).1)))
          (Localization.Away (h ν α)))) ≫ (W ν).2.fromSpec
  have hj_open : ∀ (ν : Fin (M + 1)) (α : Fin (L + 1)),
      AlgebraicGeometry.IsOpenImmersion (j_loc ν α) := by
    intro ν α
    have _ : AlgebraicGeometry.IsOpenImmersion
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (algebraMap (↑(X.left.presheaf.obj (Opposite.op (W ν).1)))
            (Localization.Away (h ν α))))) :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization
        (S := Localization.Away (h ν α)) (h ν α)
    have _ : AlgebraicGeometry.IsOpenImmersion (W ν).2.fromSpec :=
      (W ν).2.isOpenImmersion_fromSpec
    dsimp only [j_loc]
    infer_instance
  have hRange_eq : ∀ (ν : Fin (M + 1)) (α : Fin (L + 1)),
      Set.range ((U₀.ι ⁻¹ᵁ V ν α).ι ≫ U₀.ι).base = Set.range (j_loc ν α).base := by
    intro ν α
    have h1 : Set.range ((U₀.ι ⁻¹ᵁ V ν α).ι ≫ U₀.ι).base = (V ν α : Set X.left) := by
      ext x
      constructor
      · rintro ⟨w, rfl⟩
        exact w.2
      · intro hx
        exact ⟨⟨⟨x, hV_sub_U₀ ν α hx⟩, hx⟩, rfl⟩
    have h2 : Set.range (j_loc ν α).base = (V ν α : Set X.left) := by
      have hloc_rng : Set.range (PrimeSpectrum.comap
          (algebraMap (↑(X.left.presheaf.obj (Opposite.op (W ν).1)))
            (Localization.Away (h ν α)))) =
          (PrimeSpectrum.basicOpen (h ν α) :
            Set (PrimeSpectrum ↑(X.left.presheaf.obj (Opposite.op (W ν).1)))) :=
        PrimeSpectrum.localization_away_comap_range (Localization.Away (h ν α)) (h ν α)
      ext x
      constructor
      · rintro ⟨z, rfl⟩
        let q : PrimeSpectrum ↑(X.left.presheaf.obj (Opposite.op (W ν).1)) :=
          PrimeSpectrum.comap
            (algebraMap (↑(X.left.presheaf.obj (Opposite.op (W ν).1)))
              (Localization.Away (h ν α))) z
        have hz_bo : q ∈ (PrimeSpectrum.basicOpen (h ν α) :
            Set (PrimeSpectrum ↑(X.left.presheaf.obj (Opposite.op (W ν).1)))) := by
          rw [← hloc_rng]
          exact ⟨z, rfl⟩
        have hz_pre : (q : ↥(AlgebraicGeometry.Spec (X.left.presheaf.obj (Opposite.op (W ν).1)))) ∈
            (W ν).2.fromSpec ⁻¹ᵁ V ν α := by
          rw [(W ν).2.fromSpec_preimage_basicOpen (h ν α)]
          exact hz_bo
        exact hz_pre
      · intro hx
        have hxW_rng : x ∈ Set.range (W ν).2.fromSpec.base := by
          rw [(W ν).2.range_fromSpec]
          exact X.left.basicOpen_le (h ν α) hx
        rcases hxW_rng with ⟨q : PrimeSpectrum ↑(X.left.presheaf.obj (Opposite.op (W ν).1)), hq⟩
        have hq_pre : (q : ↥(AlgebraicGeometry.Spec (X.left.presheaf.obj (Opposite.op (W ν).1)))) ∈
            (W ν).2.fromSpec ⁻¹ᵁ V ν α := by
          change (W ν).2.fromSpec.base q ∈ V ν α
          rwa [hq]
        rw [(W ν).2.fromSpec_preimage_basicOpen (h ν α)] at hq_pre
        have hq_bo_set : q ∈ (PrimeSpectrum.basicOpen (h ν α) :
            Set (PrimeSpectrum ↑(X.left.presheaf.obj (Opposite.op (W ν).1)))) := hq_pre
        rw [← hloc_rng] at hq_bo_set
        rcases hq_bo_set with ⟨z, hz⟩
        exact ⟨z, (congrArg (W ν).2.fromSpec.base hz).trans hq⟩
    exact h1.trans h2.symm
  obtain ⟨e_W, heW_inv, heW_hom⟩ :
      ∃ e_W : ∀ (ν : Fin (M + 1)) (α : Fin (L + 1)),
        ((U₀.ι ⁻¹ᵁ V ν α : (U₀ : AlgebraicGeometry.Scheme.{u}).Opens) :
          AlgebraicGeometry.Scheme.{u}) ≅
          AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (h ν α))),
        (∀ ν α, (e_W ν α).inv ≫ (U₀.ι ⁻¹ᵁ V ν α).ι ≫ U₀.ι = j_loc ν α) ∧
        (∀ ν α, (e_W ν α).hom ≫ j_loc ν α = (U₀.ι ⁻¹ᵁ V ν α).ι ≫ U₀.ι) := by
    refine ⟨fun ν α =>
      letI := hj_open ν α
      AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq
        ((U₀.ι ⁻¹ᵁ V ν α).ι ≫ U₀.ι) (j_loc ν α) (hRange_eq ν α), ?_, ?_⟩
    · intro ν α
      have _ := hj_open ν α
      exact AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_inv_fac
        ((U₀.ι ⁻¹ᵁ V ν α).ι ≫ U₀.ι) (j_loc ν α) (hRange_eq ν α)
    · intro ν α
      have _ := hj_open ν α
      exact AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac
        ((U₀.ι ⁻¹ᵁ V ν α).ι ≫ U₀.ι) (j_loc ν α) (hRange_eq ν α)
  let κ_ν : ∀ ν : Fin (M + 1), k →+* ↑(X.left.presheaf.obj (Opposite.op (W ν).1)) :=
    fun ν => (AlgebraicGeometry.Spec.preimage ((W ν).2.fromSpec ≫ X.hom)).hom
  let ψ_loc : ∀ (ν : Fin (M + 1)) (α : Fin (L + 1)),
      MvPolynomial {α' : Fin (L + 1) // α' ≠ α} k →+* Localization.Away (h ν α) :=
    fun ν α =>
      MvPolynomial.eval₂Hom
        ((algebraMap (↑(X.left.presheaf.obj (Opposite.op (W ν).1)))
          (Localization.Away (h ν α))).comp (κ_ν ν))
        (fun α' : {α' : Fin (L + 1) // α' ≠ α} =>
          algebraMap (↑(X.left.presheaf.obj (Opposite.op (W ν).1)))
            (Localization.Away (h ν α)) (h ν α'.1) *
          IsLocalization.Away.invSelf (S := Localization.Away (h ν α)) (h ν α))
  let γ_loc : ∀ (ν : Fin (M + 1)) (α : Fin (L + 1)),
      ((U₀.ι ⁻¹ᵁ V ν α : (U₀ : AlgebraicGeometry.Scheme.{u}).Opens) :
        AlgebraicGeometry.Scheme.{u}) ⟶ P.left :=
    fun ν α =>
      (e_W ν α).hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_loc ν α)) ≫
        (iso_L α).inv ≫ (U_L α).ι
  have hγ_loc_hom : ∀ (ν : Fin (M + 1)) (α : Fin (L + 1)),
      γ_loc ν α ≫ P.hom = (U₀.ι ⁻¹ᵁ V ν α).ι ≫ U₀.ι ≫ X.hom := by
    intro ν α
    dsimp only [γ_loc]
    rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
      CategoryTheory.Category.assoc, hUL_hom α, Iso.inv_hom_id_assoc,
      ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    have hcomp_C : (ψ_loc ν α).comp MvPolynomial.C =
        (algebraMap (↑(X.left.presheaf.obj (Opposite.op (W ν).1)))
          (Localization.Away (h ν α))).comp (κ_ν ν) := by
      ext c
      exact MvPolynomial.eval₂Hom_C _ _ c
    rw [hcomp_C, CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp]
    have hκ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (κ_ν ν)) =
        (W ν).2.fromSpec ≫ X.hom :=
      AlgebraicGeometry.Spec.map_preimage ((W ν).2.fromSpec ≫ X.hom)
    rw [hκ, ← CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map _),
      ← CategoryTheory.Category.assoc (e_W ν α).hom]
    change ((e_W ν α).hom ≫ j_loc ν α) ≫ X.hom = _
    rw [heW_hom ν α, CategoryTheory.Category.assoc]

  
  have hUnit_of_le : ∀ (ν₀ : Fin (M + 1)) (α₀ : Fin (L + 1)) (B : X.left.affineOpens)
      (hB_le : B.1 ≤ V ν₀ α₀),
      IsUnit ((X.left.presheaf.map
        (CategoryTheory.homOfLE (hB_le.trans (X.left.basicOpen_le (h ν₀ α₀)))).op).hom
          (h ν₀ α₀)) := by
    intro ν₀ α₀ B hB_le
    set r_B := (X.left.presheaf.map
      (CategoryTheory.homOfLE (hB_le.trans (X.left.basicOpen_le (h ν₀ α₀)))).op).hom (h ν₀ α₀)
    have hbo_eq : X.left.basicOpen r_B = B.1 := by
      rw [X.left.basicOpen_res, inf_eq_left.mpr hB_le]
    by_contra hnu
    have hne_top : Ideal.span {r_B} ≠ ⊤ := by
      rwa [Ne, Ideal.span_singleton_eq_top]
    rcases Ideal.exists_le_maximal _ hne_top with ⟨𝔪, h𝔪_max, hle_𝔪⟩
    let q_𝔪 : PrimeSpectrum ↑(X.left.presheaf.obj (Opposite.op B.1)) := ⟨𝔪, h𝔪_max.isPrime⟩
    have hq_in_Bset : B.2.fromSpec.base q_𝔪 ∈ (B.1 : Set X.left) := by
      rw [← B.2.range_fromSpec]
      exact ⟨q_𝔪, rfl⟩
    have hq_in_bo : B.2.fromSpec.base q_𝔪 ∈ X.left.basicOpen r_B := by
      rw [hbo_eq]
      exact hq_in_Bset
    have hq_pre : (q_𝔪 : ↥(AlgebraicGeometry.Spec (X.left.presheaf.obj (Opposite.op B.1)))) ∈
        B.2.fromSpec ⁻¹ᵁ X.left.basicOpen r_B := hq_in_bo
    rw [B.2.fromSpec_preimage_basicOpen r_B] at hq_pre
    have hq_bo : r_B ∉ q_𝔪.asIdeal := (PrimeSpectrum.mem_basicOpen _ _).mp hq_pre
    exact hq_bo (hle_𝔪 (Ideal.subset_span rfl))

  
  have hGlue : ∀ p₁ p₂ : Idx,
      CategoryTheory.Limits.pullback.fst (𝒰.f p₁) (𝒰.f p₂) ≫ γ_loc p₁.down.1 p₁.down.2 =
        CategoryTheory.Limits.pullback.snd (𝒰.f p₁) (𝒰.f p₂) ≫ γ_loc p₂.down.1 p₂.down.2 := by
    rintro ⟨⟨ν, β⟩⟩ ⟨⟨μ, β'⟩⟩
    let p₁ : Idx := ULift.up (ν, β)
    let p₂ : Idx := ULift.up (μ, β')
    change CategoryTheory.Limits.pullback.fst (W_U p₁).ι (W_U p₂).ι ≫ γ_loc ν β =
      CategoryTheory.Limits.pullback.snd (W_U p₁).ι (W_U p₂).ι ≫ γ_loc μ β'
    let O₁₂ : (U₀ : AlgebraicGeometry.Scheme.{u}).Opens := W_U p₁ ⊓ W_U p₂
    let fst₁₂ := CategoryTheory.Limits.pullback.fst (W_U p₁).ι (W_U p₂).ι
    let snd₁₂ := CategoryTheory.Limits.pullback.snd (W_U p₁).ι (W_U p₂).ι
    let q₁₂ := fst₁₂ ≫ (W_U p₁).ι
    have hSub₁₂ : Set.range q₁₂.base ⊆ Set.range O₁₂.ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rintro _ ⟨z, rfl⟩
      have h1 : q₁₂.base z ∈ (W_U p₁ : Set ↥(U₀ : AlgebraicGeometry.Scheme.{u})) := by
        rw [← AlgebraicGeometry.Scheme.Opens.range_ι]
        exact ⟨fst₁₂.base z, rfl⟩
      have h2 : q₁₂.base z ∈ (W_U p₂ : Set ↥(U₀ : AlgebraicGeometry.Scheme.{u})) := by
        have hcond : q₁₂ = snd₁₂ ≫ (W_U p₂).ι := CategoryTheory.Limits.pullback.condition
        rw [hcond, ← AlgebraicGeometry.Scheme.Opens.range_ι]
        exact ⟨snd₁₂.base z, rfl⟩
      exact ⟨h1, h2⟩
    let L₁₂ := AlgebraicGeometry.IsOpenImmersion.lift O₁₂.ι q₁₂ hSub₁₂
    let inc₁ : (O₁₂ : AlgebraicGeometry.Scheme.{u}) ⟶ (W_U p₁ : AlgebraicGeometry.Scheme.{u}) :=
      (U₀ : AlgebraicGeometry.Scheme.{u}).homOfLE inf_le_left
    let inc₂ : (O₁₂ : AlgebraicGeometry.Scheme.{u}) ⟶ (W_U p₂ : AlgebraicGeometry.Scheme.{u}) :=
      (U₀ : AlgebraicGeometry.Scheme.{u}).homOfLE inf_le_right
    have hfst : fst₁₂ = L₁₂ ≫ inc₁ := by
      apply (cancel_mono (W_U p₁).ι).mp
      rw [CategoryTheory.Category.assoc, (U₀ : AlgebraicGeometry.Scheme.{u}).homOfLE_ι,
        AlgebraicGeometry.IsOpenImmersion.lift_fac]
    have hsnd : snd₁₂ = L₁₂ ≫ inc₂ := by
      apply (cancel_mono (W_U p₂).ι).mp
      rw [CategoryTheory.Category.assoc, (U₀ : AlgebraicGeometry.Scheme.{u}).homOfLE_ι,
        AlgebraicGeometry.IsOpenImmersion.lift_fac]
      exact CategoryTheory.Limits.pullback.condition.symm
    change fst₁₂ ≫ γ_loc ν β = snd₁₂ ≫ γ_loc μ β'
    rw [hfst, hsnd, CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]
    congr 1
    
    let Idx_A : Type u := {A : X.left.affineOpens // A.1 ≤ V ν β ⊓ V μ β'}
    let W_A : Idx_A → (O₁₂ : AlgebraicGeometry.Scheme.{u}).Opens :=
      fun A => (O₁₂.ι ≫ U₀.ι) ⁻¹ᵁ A.1.1
    have hSup_WA : (⨆ A : Idx_A, W_A A) = ⊤ := by
      rw [eq_top_iff]
      intro z _
      have hz : (O₁₂.ι ≫ U₀.ι).base z ∈ V ν β ⊓ V μ β' := ⟨z.2.1, z.2.2⟩
      rcases (TopologicalSpace.Opens.isBasis_iff_nbhd.mp X.left.isBasis_affineOpens) hz with
        ⟨A₀, hA₀_aff, hzA₀, hA₀_le⟩
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨⟨A₀, hA₀_aff⟩, hA₀_le⟩, hzA₀⟩
    let 𝒰_A : (O₁₂ : AlgebraicGeometry.Scheme.{u}).OpenCover :=
      (O₁₂ : AlgebraicGeometry.Scheme.{u}).openCoverOfIsOpenCover W_A
        (TopologicalSpace.IsOpenCover.mk hSup_WA)
    apply 𝒰_A.hom_ext
    intro (A : Idx_A)
    change (W_A A).ι ≫ inc₁ ≫ γ_loc ν β = (W_A A).ι ≫ inc₂ ≫ γ_loc μ β'
    have hRange_A : Set.range ((W_A A).ι ≫ O₁₂.ι ≫ U₀.ι).base =
        Set.range A.1.2.fromSpec.base := by
      rw [A.1.2.range_fromSpec]
      ext x
      constructor
      · rintro ⟨w, rfl⟩
        exact w.2
      · intro hx
        have hx_νβ : x ∈ V ν β := (A.2 hx).1
        have hx_μβ' : x ∈ V μ β' := (A.2 hx).2
        exact ⟨⟨⟨⟨x, hV_sub_U₀ ν β hx_νβ⟩, ⟨hx_νβ, hx_μβ'⟩⟩, hx⟩, rfl⟩
    obtain ⟨e_A, heA_inv⟩ :
        ∃ e_A : ((W_A A : (O₁₂ : AlgebraicGeometry.Scheme.{u}).Opens) :
          AlgebraicGeometry.Scheme.{u}) ≅
          AlgebraicGeometry.Spec (X.left.presheaf.obj (Opposite.op A.1.1)),
          e_A.inv ≫ (W_A A).ι ≫ O₁₂.ι ≫ U₀.ι = A.1.2.fromSpec := by
      have _ : AlgebraicGeometry.IsOpenImmersion A.1.2.fromSpec := A.1.2.isOpenImmersion_fromSpec
      exact ⟨AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq
          ((W_A A).ι ≫ O₁₂.ι ≫ U₀.ι) A.1.2.fromSpec hRange_A,
        AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_inv_fac
          ((W_A A).ι ≫ O₁₂.ι ≫ U₀.ι) A.1.2.fromSpec hRange_A⟩
    apply (cancel_epi e_A.inv).mp
    let f_A1 := e_A.inv ≫ (W_A A).ι ≫ inc₁
    let f_A2 := e_A.inv ≫ (W_A A).ι ≫ inc₂
    change f_A1 ≫ γ_loc ν β = f_A2 ≫ γ_loc μ β'
    have hfA1 : f_A1 ≫ (W_U p₁).ι ≫ U₀.ι = A.1.2.fromSpec := by
      dsimp only [f_A1]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc inc₁, (U₀ : AlgebraicGeometry.Scheme.{u}).homOfLE_ι]
      exact heA_inv
    have hfA2 : f_A2 ≫ (W_U p₂).ι ≫ U₀.ι = A.1.2.fromSpec := by
      dsimp only [f_A2]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc inc₂, (U₀ : AlgebraicGeometry.Scheme.{u}).homOfLE_ι]
      exact heA_inv
    
    have hA_νβ : A.1.1 ≤ V ν β := A.2.trans inf_le_left
    have hA_μβ' : A.1.1 ≤ V μ β' := A.2.trans inf_le_right
    have hA_ν : A.1.1 ≤ (W ν).1 := hA_νβ.trans (X.left.basicOpen_le (h ν β))
    have hA_μ : A.1.1 ≤ (W μ).1 := hA_μβ'.trans (X.left.basicOpen_le (h μ β'))
    have hA_νμ : A.1.1 ≤ (W ν).1 ⊓ (W μ).1 := le_inf hA_ν hA_μ
    set ρ_ν := (X.left.presheaf.map (CategoryTheory.homOfLE hA_ν).op).hom
    set ρ_μ := (X.left.presheaf.map (CategoryTheory.homOfLE hA_μ).op).hom
    set ρ_νμ := (X.left.presheaf.map (CategoryTheory.homOfLE hA_νμ).op).hom
    have hu_νβ : IsUnit (ρ_ν (h ν β)) := hUnit_of_le ν β A.1 hA_νβ
    have hu_μβ' : IsUnit (ρ_μ (h μ β')) := hUnit_of_le μ β' A.1 hA_μβ'
    obtain ⟨lam₁, hlam₁⟩ :
        ∃ lam₁ : Localization.Away (h ν β) →+* ↑(X.left.presheaf.obj (Opposite.op A.1.1)),
          ∀ r, lam₁ (algebraMap (↑(X.left.presheaf.obj (Opposite.op (W ν).1)))
            (Localization.Away (h ν β)) r) = ρ_ν r :=
      ⟨IsLocalization.Away.lift (S := Localization.Away (h ν β)) (h ν β) (g := ρ_ν) hu_νβ,
       IsLocalization.Away.lift_eq (S := Localization.Away (h ν β)) (h ν β) (g := ρ_ν) hu_νβ⟩
    obtain ⟨lam₂, hlam₂⟩ :
        ∃ lam₂ : Localization.Away (h μ β') →+* ↑(X.left.presheaf.obj (Opposite.op A.1.1)),
          ∀ r, lam₂ (algebraMap (↑(X.left.presheaf.obj (Opposite.op (W μ).1)))
            (Localization.Away (h μ β')) r) = ρ_μ r :=
      ⟨IsLocalization.Away.lift (S := Localization.Away (h μ β')) (h μ β') (g := ρ_μ) hu_μβ',
       IsLocalization.Away.lift_eq (S := Localization.Away (h μ β')) (h μ β') (g := ρ_μ) hu_μβ'⟩
    have hf1_eW : f_A1 ≫ (e_W ν β).hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom lam₁) := by
      have _ := hj_open ν β
      apply (cancel_mono (j_loc ν β)).mp
      rw [CategoryTheory.Category.assoc, heW_hom ν β]
      change f_A1 ≫ (W_U p₁).ι ≫ U₀.ι =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom lam₁) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (algebraMap (↑(X.left.presheaf.obj (Opposite.op (W ν).1)))
              (Localization.Away (h ν β)))) ≫ (W ν).2.fromSpec
      rw [hfA1, ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp]
      have hlift₁ : lam₁.comp (algebraMap (↑(X.left.presheaf.obj (Opposite.op (W ν).1)))
          (Localization.Away (h ν β))) = ρ_ν := RingHom.ext hlam₁
      rw [hlift₁]
      exact ((W ν).2.map_fromSpec A.1.2 (CategoryTheory.homOfLE hA_ν).op).symm
    have hf2_eW : f_A2 ≫ (e_W μ β').hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom lam₂) := by
      have _ := hj_open μ β'
      apply (cancel_mono (j_loc μ β')).mp
      rw [CategoryTheory.Category.assoc, heW_hom μ β']
      change f_A2 ≫ (W_U p₂).ι ≫ U₀.ι =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom lam₂) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (algebraMap (↑(X.left.presheaf.obj (Opposite.op (W μ).1)))
              (Localization.Away (h μ β')))) ≫ (W μ).2.fromSpec
      rw [hfA2, ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp]
      have hlift₂ : lam₂.comp (algebraMap (↑(X.left.presheaf.obj (Opposite.op (W μ).1)))
          (Localization.Away (h μ β'))) = ρ_μ := RingHom.ext hlam₂
      rw [hlift₂]
      exact ((W μ).2.map_fromSpec A.1.2 (CategoryTheory.homOfLE hA_μ).op).symm
    let κ_A : k →+* ↑(X.left.presheaf.obj (Opposite.op A.1.1)) :=
      (AlgebraicGeometry.Spec.preimage (A.1.2.fromSpec ≫ X.hom)).hom
    have hκ_A_map : AlgebraicGeometry.Spec.map (CommRingCat.ofHom κ_A) =
        A.1.2.fromSpec ≫ X.hom :=
      AlgebraicGeometry.Spec.map_preimage (A.1.2.fromSpec ≫ X.hom)
    have hκ_ν_eq : ρ_ν.comp (κ_ν ν) = κ_A := by
      have hκ_ν_map : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (κ_ν ν)) =
          (W ν).2.fromSpec ≫ X.hom :=
        AlgebraicGeometry.Spec.map_preimage ((W ν).2.fromSpec ≫ X.hom)
      have hinj : CommRingCat.ofHom (ρ_ν.comp (κ_ν ν)) = CommRingCat.ofHom κ_A := by
        apply AlgebraicGeometry.Spec.map_injective
        rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, hκ_ν_map, hκ_A_map,
          ← CategoryTheory.Category.assoc]
        change (AlgebraicGeometry.Spec.map
            (X.left.presheaf.map (CategoryTheory.homOfLE hA_ν).op) ≫
          (W ν).2.fromSpec) ≫ X.hom = A.1.2.fromSpec ≫ X.hom
        rw [(W ν).2.map_fromSpec A.1.2 (CategoryTheory.homOfLE hA_ν).op]
      exact congrArg CommRingCat.Hom.hom hinj
    have hκ_μ_eq : ρ_μ.comp (κ_ν μ) = κ_A := by
      have hκ_μ_map : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (κ_ν μ)) =
          (W μ).2.fromSpec ≫ X.hom :=
        AlgebraicGeometry.Spec.map_preimage ((W μ).2.fromSpec ≫ X.hom)
      have hinj : CommRingCat.ofHom (ρ_μ.comp (κ_ν μ)) = CommRingCat.ofHom κ_A := by
        apply AlgebraicGeometry.Spec.map_injective
        rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, hκ_μ_map, hκ_A_map,
          ← CategoryTheory.Category.assoc]
        change (AlgebraicGeometry.Spec.map
            (X.left.presheaf.map (CategoryTheory.homOfLE hA_μ).op) ≫
          (W μ).2.fromSpec) ≫ X.hom = A.1.2.fromSpec ≫ X.hom
        rw [(W μ).2.map_fromSpec A.1.2 (CategoryTheory.homOfLE hA_μ).op]
      exact congrArg CommRingCat.Hom.hom hinj
    dsimp only [γ_loc]
    rw [← CategoryTheory.Category.assoc f_A1, hf1_eW,
      ← CategoryTheory.Category.assoc f_A2, hf2_eW,
      ← CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map (CommRingCat.ofHom lam₁)),
      ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
      ← CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map (CommRingCat.ofHom lam₂)),
      ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    set Φ₁ := lam₁.comp (ψ_loc ν β)
    set Φ₂ := lam₂.comp (ψ_loc μ β')
    
    rcases hUnit ν μ with ⟨u₀, hu₀, hCoc⟩
    set u := ρ_νμ u₀
    have hu : IsUnit u := hu₀.map ρ_νμ
    have h_rel : ∀ α₀ : Fin (L + 1), ρ_ν (h ν α₀) = u * ρ_μ (h μ α₀) := by
      intro α₀
      have h1 : ρ_ν (h ν α₀) =
          ρ_νμ ((X.left.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (h ν α₀)) := by
        have hcomp : (CategoryTheory.homOfLE inf_le_left : (W ν).1 ⊓ (W μ).1 ⟶ (W ν).1).op ≫
            (CategoryTheory.homOfLE hA_νμ).op = (CategoryTheory.homOfLE hA_ν).op :=
          Subsingleton.elim _ _
        dsimp only [ρ_ν, ρ_νμ]
        rw [← hcomp, X.left.presheaf.map_comp]
        rfl
      have h2 : ρ_μ (h μ α₀) =
          ρ_νμ ((X.left.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom (h μ α₀)) := by
        have hcomp : (CategoryTheory.homOfLE inf_le_right : (W ν).1 ⊓ (W μ).1 ⟶ (W μ).1).op ≫
            (CategoryTheory.homOfLE hA_νμ).op = (CategoryTheory.homOfLE hA_μ).op :=
          Subsingleton.elim _ _
        dsimp only [ρ_μ, ρ_νμ]
        rw [← hcomp, X.left.presheaf.map_comp]
        rfl
      rw [h1, hCoc α₀, map_mul, ← h2]
    set v₁ := lam₁ (IsLocalization.Away.invSelf (S := Localization.Away (h ν β)) (h ν β))
    set v₂ := lam₂ (IsLocalization.Away.invSelf (S := Localization.Away (h μ β')) (h μ β'))
    have hv₁ : ρ_ν (h ν β) * v₁ = 1 := by
      have hm := congrArg lam₁
        (IsLocalization.Away.mul_invSelf (S := Localization.Away (h ν β)) (h ν β))
      rw [map_mul, map_one, hlam₁] at hm
      exact hm
    have hv₂ : ρ_μ (h μ β') * v₂ = 1 := by
      have hm := congrArg lam₂
        (IsLocalization.Away.mul_invSelf (S := Localization.Away (h μ β')) (h μ β'))
      rw [map_mul, map_one, hlam₂] at hm
      exact hm
    have hΦ₁_C : ∀ c : k, Φ₁ (MvPolynomial.C c) = κ_A c := by
      intro c
      change lam₁ (ψ_loc ν β (MvPolynomial.C c)) = κ_A c
      rw [MvPolynomial.eval₂Hom_C, RingHom.comp_apply, hlam₁]
      exact congrFun (congrArg DFunLike.coe hκ_ν_eq) c
    have hΦ₂_C : ∀ c : k, Φ₂ (MvPolynomial.C c) = κ_A c := by
      intro c
      change lam₂ (ψ_loc μ β' (MvPolynomial.C c)) = κ_A c
      rw [MvPolynomial.eval₂Hom_C, RingHom.comp_apply, hlam₂]
      exact congrFun (congrArg DFunLike.coe hκ_μ_eq) c
    have hΦ₁_X : ∀ α₀ : {α₀ : Fin (L + 1) // α₀ ≠ β},
        Φ₁ (MvPolynomial.X α₀) = ρ_ν (h ν α₀.1) * v₁ := by
      intro α₀
      change lam₁ (ψ_loc ν β (MvPolynomial.X α₀)) = ρ_ν (h ν α₀.1) * v₁
      rw [MvPolynomial.eval₂Hom_X', map_mul, hlam₁]
    have hΦ₂_X : ∀ α₀ : {α₀ : Fin (L + 1) // α₀ ≠ β'},
        Φ₂ (MvPolynomial.X α₀) = ρ_μ (h μ α₀.1) * v₂ := by
      intro α₀
      change lam₂ (ψ_loc μ β' (MvPolynomial.X α₀)) = ρ_μ (h μ α₀.1) * v₂
      rw [MvPolynomial.eval₂Hom_X', map_mul, hlam₂]
    by_cases hβ' : β' = β
    · 
      subst β'
      have hv_eq : v₂ = u * v₁ := by
        calc v₂ = 1 * v₂ := (one_mul v₂).symm
          _ = (ρ_ν (h ν β) * v₁) * v₂ := by rw [hv₁]
          _ = (u * ρ_μ (h μ β) * v₁) * v₂ := by rw [h_rel β]
          _ = u * v₁ * (ρ_μ (h μ β) * v₂) := by ring
          _ = u * v₁ * 1 := by rw [hv₂]
          _ = u * v₁ := mul_one _
      have hΦ_eq : Φ₁ = Φ₂ := by
        apply MvPolynomial.ringHom_ext'
        · ext c
          change Φ₁ (MvPolynomial.C c) = Φ₂ (MvPolynomial.C c)
          rw [hΦ₁_C, hΦ₂_C]
        · intro α₀
          rw [hΦ₁_X, hΦ₂_X, h_rel α₀.1, hv_eq]
          ring
      rw [hΦ_eq]
    · 
      let Y_β' : MvPolynomial {α₀ : Fin (L + 1) // α₀ ≠ β} k := MvPolynomial.X ⟨β', hβ'⟩
      have hv₁_unit : IsUnit v₁ :=
        ⟨⟨v₁, ρ_ν (h ν β), by rw [mul_comm, hv₁], hv₁⟩, rfl⟩
      have hY_unit : IsUnit (Φ₁ Y_β') := by
        rw [hΦ₁_X ⟨β', hβ'⟩, h_rel β']
        exact (hu.mul hu_μβ').mul hv₁_unit
      obtain ⟨Ω, hΩ⟩ :
          ∃ Ω : Localization.Away Y_β' →+* ↑(X.left.presheaf.obj (Opposite.op A.1.1)),
            ∀ p, Ω (algebraMap (MvPolynomial {α₀ : Fin (L + 1) // α₀ ≠ β} k)
              (Localization.Away Y_β') p) = Φ₁ p :=
        ⟨IsLocalization.Away.lift (S := Localization.Away Y_β') Y_β' (g := Φ₁) hY_unit,
         IsLocalization.Away.lift_eq (S := Localization.Away Y_β') Y_β' (g := Φ₁) hY_unit⟩
      have hΩ_comp : Ω.comp (algebraMap (MvPolynomial {α₀ : Fin (L + 1) // α₀ ≠ β} k)
          (Localization.Away Y_β')) = Φ₁ := RingHom.ext hΩ
      rw [← hΩ_comp, CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp,
        CategoryTheory.Category.assoc]
      change AlgebraicGeometry.Spec.map (CommRingCat.ofHom Ω) ≫
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (algebraMap (MvPolynomial {α₀ : Fin (L + 1) // α₀ ≠ β} k)
            (Localization.Away Y_β'))) ≫ (iso_L β).inv ≫ (U_L β).ι) = _
      rw [hUL_trans β β' hβ', ← CategoryTheory.Category.assoc,
        ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      set τ_ββ' := MvPolynomial.eval₂Hom
        ((algebraMap (MvPolynomial {α₀ : Fin (L + 1) // α₀ ≠ β} k)
          (Localization.Away Y_β')).comp MvPolynomial.C)
        (fun α₀ : {α₀ : Fin (L + 1) // α₀ ≠ β'} =>
          if h : α₀.1 = β then
            IsLocalization.Away.invSelf Y_β'
          else
            algebraMap (MvPolynomial {α₀ : Fin (L + 1) // α₀ ≠ β} k) _
              (MvPolynomial.X ⟨α₀.1, h⟩) *
            IsLocalization.Away.invSelf Y_β')
      have hΩτ : Ω.comp τ_ββ' = Φ₂ := by
        set w := Ω (IsLocalization.Away.invSelf (S := Localization.Away Y_β') Y_β')
        have hw : (ρ_ν (h ν β') * v₁) * w = 1 := by
          have hm := congrArg Ω
            (IsLocalization.Away.mul_invSelf (S := Localization.Away Y_β') Y_β')
          rw [map_mul, map_one, hΩ Y_β', hΦ₁_X ⟨β', hβ'⟩] at hm
          exact hm
        have hv₂_eq : v₂ = u * v₁ * w := by
          calc v₂ = 1 * v₂ := (one_mul v₂).symm
            _ = ((ρ_ν (h ν β') * v₁) * w) * v₂ := by rw [hw]
            _ = ((u * ρ_μ (h μ β') * v₁) * w) * v₂ := by rw [h_rel β']
            _ = u * v₁ * w * (ρ_μ (h μ β') * v₂) := by ring
            _ = u * v₁ * w * 1 := by rw [hv₂]
            _ = u * v₁ * w := mul_one _
        apply MvPolynomial.ringHom_ext'
        · ext c
          rw [RingHom.comp_apply, RingHom.comp_apply, RingHom.comp_apply,
            MvPolynomial.eval₂Hom_C, RingHom.comp_apply, hΩ, hΦ₁_C, hΦ₂_C]
        · intro α₀
          rw [RingHom.comp_apply, MvPolynomial.eval₂Hom_X', hΦ₂_X]
          split_ifs with hαβ
          · change w = ρ_μ (h μ α₀.1) * v₂
            rw [hαβ, hv₂_eq]
            calc w = 1 * w := (one_mul w).symm
              _ = (ρ_ν (h ν β) * v₁) * w := by rw [hv₁]
              _ = (u * ρ_μ (h μ β) * v₁) * w := by rw [h_rel β]
              _ = ρ_μ (h μ β) * (u * v₁ * w) := by ring
          · rw [map_mul, hΩ, hΦ₁_X ⟨α₀.1, hαβ⟩, h_rel α₀.1, hv₂_eq]
            change (u * ρ_μ (h μ α₀.1) * v₁) * w = ρ_μ (h μ α₀.1) * (u * v₁ * w)
            ring
      rw [hΩτ]

  
  obtain ⟨γ, hγ_res, hγ_hom⟩ :
      ∃ γ : (U₀ : AlgebraicGeometry.Scheme.{u}) ⟶ P.left,
        (∀ (ν : Fin (M + 1)) (α : Fin (L + 1)), (U₀.ι ⁻¹ᵁ V ν α).ι ≫ γ = γ_loc ν α) ∧
        (U₀.ι ≫ X.hom = γ ≫ P.hom) := by
    let γ₀ : (U₀ : AlgebraicGeometry.Scheme.{u}) ⟶ P.left :=
      𝒰.glueMorphisms (fun p => γ_loc p.down.1 p.down.2) hGlue
    have hres₀ : ∀ (ν : Fin (M + 1)) (α : Fin (L + 1)),
        (U₀.ι ⁻¹ᵁ V ν α).ι ≫ γ₀ = γ_loc ν α :=
      fun ν α => 𝒰.ι_glueMorphisms (fun p => γ_loc p.down.1 p.down.2) hGlue (ULift.up (ν, α))
    refine ⟨γ₀, hres₀, ?_⟩
    apply 𝒰.hom_ext
    intro p
    change (U₀.ι ⁻¹ᵁ V p.down.1 p.down.2).ι ≫ (U₀.ι ≫ X.hom) =
      (U₀.ι ⁻¹ᵁ V p.down.1 p.down.2).ι ≫ (γ₀ ≫ P.hom)
    rw [← hγ_loc_hom p.down.1 p.down.2, ← CategoryTheory.Category.assoc,
      hres₀ p.down.1 p.down.2]
  refine ⟨U₀, γ, rfl, hγ_hom, fun ν β => ?_⟩
  let O_loc : (U₀ : AlgebraicGeometry.Scheme.{u}).Opens :=
    (U₀.ι ⁻¹ᵁ (W ν).1) ⊓ (γ ⁻¹ᵁ U_L β)
  have hPre_eq : O_loc = U₀.ι ⁻¹ᵁ V ν β := by
    apply le_antisymm
    · intro u hu
      rcases hu with ⟨huW, huγ⟩
      have huWU : u.1 ∈ (W ν).1 ⊓ U₀ := ⟨huW, u.2⟩
      rw [hLocalCov ν, TopologicalSpace.Opens.mem_iSup] at huWU
      rcases huWU with ⟨α, hu_α⟩
      by_cases hβα : β = α
      · exact hβα ▸ hu_α
      · let w : ↥((U₀.ι ⁻¹ᵁ V ν α : (U₀ : AlgebraicGeometry.Scheme.{u}).Opens) :
            AlgebraicGeometry.Scheme.{u}) := ⟨u, hu_α⟩
        let q_loc : PrimeSpectrum (Localization.Away (h ν α)) := (e_W ν α).hom.base w
        have hγ_eq : γ.base u = (γ_loc ν α).base w :=
          congrArg (fun (f : ((U₀.ι ⁻¹ᵁ V ν α :
              (U₀ : AlgebraicGeometry.Scheme.{u}).Opens) :
              AlgebraicGeometry.Scheme.{u}) ⟶ P.left) => f.base w) (hγ_res ν α)
        have hq_pre : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_loc ν α))).base q_loc ∈
            ((iso_L α).inv ≫ (U_L α).ι) ⁻¹ᵁ U_L β := by
          change ((iso_L α).inv ≫ (U_L α).ι).base
            ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_loc ν α))).base q_loc) ∈ U_L β
          have h2 : ((iso_L α).inv ≫ (U_L α).ι).base
              ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_loc ν α))).base q_loc) =
              (γ_loc ν α).base w := rfl
          rw [h2, ← hγ_eq]
          exact huγ
        rw [hUL_pre α β hβα] at hq_pre
        have hq_bo1 : (q_loc : ↥(AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (h ν α))))) ∈
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_loc ν α))) ⁻¹ᵁ
              PrimeSpectrum.basicOpen (MvPolynomial.X ⟨β, hβα⟩) := hq_pre
        rw [AlgebraicGeometry.SpecMap_preimage_basicOpen] at hq_bo1
        have hq_bo : ψ_loc ν α (MvPolynomial.X ⟨β, hβα⟩) ∉ q_loc.asIdeal :=
          (PrimeSpectrum.mem_basicOpen _ _).mp hq_bo1
        rw [MvPolynomial.eval₂Hom_X'] at hq_bo
        have h_not_mem : algebraMap (↑(X.left.presheaf.obj (Opposite.op (W ν).1)))
            (Localization.Away (h ν α)) (h ν β) ∉ q_loc.asIdeal := by
          intro hmem
          exact hq_bo (Ideal.mul_mem_right _ _ hmem)
        let q_ν : PrimeSpectrum ↑(X.left.presheaf.obj (Opposite.op (W ν).1)) :=
          PrimeSpectrum.comap
            (algebraMap (↑(X.left.presheaf.obj (Opposite.op (W ν).1)))
              (Localization.Away (h ν α))) q_loc
        have hq_ν_pre : (q_ν : ↥(AlgebraicGeometry.Spec (X.left.presheaf.obj (Opposite.op (W ν).1)))) ∈
            (W ν).2.fromSpec ⁻¹ᵁ V ν β := by
          rw [(W ν).2.fromSpec_preimage_basicOpen (h ν β)]
          exact (PrimeSpectrum.mem_basicOpen _ _).mpr h_not_mem
        have hq_ν_eq : (W ν).2.fromSpec.base q_ν = u.1 := by
          have h3 := congrArg (fun f => f.base w) (heW_hom ν α)
          exact h3
        change (W ν).2.fromSpec.base q_ν ∈ V ν β at hq_ν_pre
        rw [hq_ν_eq] at hq_ν_pre
        exact hq_ν_pre
    · intro u hu
      refine ⟨X.left.basicOpen_le (h ν β) hu, ?_⟩
      let w : ↥((U₀.ι ⁻¹ᵁ V ν β : (U₀ : AlgebraicGeometry.Scheme.{u}).Opens) :
          AlgebraicGeometry.Scheme.{u}) := ⟨u, hu⟩
      have hγ_eq : γ.base u = (γ_loc ν β).base w :=
        congrArg (fun f => f.base w) (hγ_res ν β)
      change γ.base u ∈ (U_L β : Set P.left)
      rw [hγ_eq, ← AlgebraicGeometry.Scheme.Opens.range_ι]
      exact ⟨((e_W ν β).hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_loc ν β)) ≫
        (iso_L β).inv).base w, rfl⟩
  let e_loc := ((U₀ : AlgebraicGeometry.Scheme.{u}).isoOfEq hPre_eq) ≪≫ e_W ν β
  refine ⟨e_loc, ?_, ?_⟩
  · rw [Iso.trans_inv, CategoryTheory.Category.assoc,
      ← CategoryTheory.Category.assoc ((U₀ : AlgebraicGeometry.Scheme.{u}).isoOfEq hPre_eq).inv,
      (U₀ : AlgebraicGeometry.Scheme.{u}).isoOfEq_inv_ι hPre_eq]
    exact heW_inv ν β
  · rw [Iso.trans_inv, CategoryTheory.Category.assoc,
      ← CategoryTheory.Category.assoc ((U₀ : AlgebraicGeometry.Scheme.{u}).isoOfEq hPre_eq).inv,
      (U₀ : AlgebraicGeometry.Scheme.{u}).isoOfEq_inv_ι hPre_eq,
      hγ_res ν β]
    dsimp only [γ_loc, ψ_loc, κ_ν]
    rw [Iso.inv_hom_id_assoc]

theorem weil_graph_closure_affine_blowup_chart (k : Type u) [Field k]
    (X P : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (U₀ : X.left.Opens)
    (γ : (U₀ : AlgebraicGeometry.Scheme.{u}) ⟶ P.left)
    (hγ : U₀.ι ≫ X.hom = γ ≫ P.hom)
    (W₀ : X.left.affineOpens)
    (L : ℕ)
    (h₀ : Fin (L + 1) → ↑(X.left.presheaf.obj (Opposite.op W₀.1)))
    (β : Fin (L + 1))
    (U_β : P.left.Opens)
    (iso_β : (U_β : AlgebraicGeometry.Scheme.{u}) ≅
      AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial {α : Fin (L + 1) // α ≠ β} k)))
    (hUβ_hom : U_β.ι ≫ P.hom =
      iso_β.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C))
    (e_loc :
      ((((U₀.ι ⁻¹ᵁ W₀.1) ⊓ (γ ⁻¹ᵁ U_β) : (U₀ : AlgebraicGeometry.Scheme.{u}).Opens) :
        AlgebraicGeometry.Scheme.{u}) ≅
        AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (h₀ β)))))
    (he_fst : e_loc.inv ≫ ((U₀.ι ⁻¹ᵁ W₀.1) ⊓ (γ ⁻¹ᵁ U_β)).ι ≫ U₀.ι =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap (↑(X.left.presheaf.obj (Opposite.op W₀.1)))
          (Localization.Away (h₀ β)))) ≫ W₀.2.fromSpec)
    (he_snd : e_loc.inv ≫ ((U₀.ι ⁻¹ᵁ W₀.1) ⊓ (γ ⁻¹ᵁ U_β)).ι ≫ γ =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (MvPolynomial.eval₂Hom
          ((algebraMap (↑(X.left.presheaf.obj (Opposite.op W₀.1)))
            (Localization.Away (h₀ β))).comp
            (AlgebraicGeometry.Spec.preimage (W₀.2.fromSpec ≫ X.hom)).hom)
          (fun α : {α : Fin (L + 1) // α ≠ β} =>
            algebraMap (↑(X.left.presheaf.obj (Opposite.op W₀.1)))
              (Localization.Away (h₀ β)) (h₀ α.1) *
            IsLocalization.Away.invSelf (S := Localization.Away (h₀ β)) (h₀ β)))) ≫
        iso_β.inv ≫ U_β.ι)
    (Z : AlgebraicGeometry.Scheme.{u})
    (ι : Z ⟶ CategoryTheory.Limits.pullback X.hom P.hom)
    (hCl_ι : AlgebraicGeometry.IsClosedImmersion ι)
    (hKer : AlgebraicGeometry.Scheme.Hom.ker
        (ι ∣_ ((CategoryTheory.Limits.pullback.fst X.hom P.hom ⁻¹ᵁ W₀.1) ⊓
          (CategoryTheory.Limits.pullback.snd X.hom P.hom ⁻¹ᵁ U_β))) =
      AlgebraicGeometry.Scheme.Hom.ker
        ((CategoryTheory.Limits.pullback.lift U₀.ι γ hγ) ∣_
          ((CategoryTheory.Limits.pullback.fst X.hom P.hom ⁻¹ᵁ W₀.1) ⊓
            (CategoryTheory.Limits.pullback.snd X.hom P.hom ⁻¹ᵁ U_β))))
    (x' : Z)
    (hx'_W : (ι ≫ CategoryTheory.Limits.pullback.fst X.hom P.hom).base x' ∈ W₀.1)
    (hx'_U : (ι ≫ CategoryTheory.Limits.pullback.snd X.hom P.hom).base x' ∈ U_β) :
    ∃ (z₀ : AlgebraicGeometry.Spec (CommRingCat.of ↥(weilBlowupChartSubalg
        (↑(X.left.presheaf.obj (Opposite.op W₀.1))) h₀ β)))
      (j_chart : AlgebraicGeometry.Spec (CommRingCat.of ↥(weilBlowupChartSubalg
        (↑(X.left.presheaf.obj (Opposite.op W₀.1))) h₀ β)) ⟶ Z),
      h₀ β ≠ 0 ∧
      AlgebraicGeometry.IsOpenImmersion j_chart ∧
      j_chart.base z₀ = x' ∧
      j_chart ≫ ι ≫ CategoryTheory.Limits.pullback.fst X.hom P.hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap _ _)) ≫ W₀.2.fromSpec :=
by
  let R₀ : Type u := ↑(X.left.presheaf.obj (Opposite.op W₀.1))
  let I_β : Type := {α : Fin (L + 1) // α ≠ β}
  let P_β : Type u := MvPolynomial I_β k
  let A : Type u := MvPolynomial I_β R₀
  let L_β : Type u := Localization.Away (h₀ β)
  let B_sub : Subalgebra R₀ L_β := weilBlowupChartSubalg R₀ h₀ β
  let B : Type u := ↥B_sub
  let Q : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback X.hom P.hom
  let fst : Q ⟶ X.left := CategoryTheory.Limits.pullback.fst X.hom P.hom
  let snd : Q ⟶ P.left := CategoryTheory.Limits.pullback.snd X.hom P.hom
  let δ : (U₀ : AlgebraicGeometry.Scheme.{u}) ⟶ Q :=
    CategoryTheory.Limits.pullback.lift U₀.ι γ hγ
  let O₀ : Q.Opens := (fst ⁻¹ᵁ W₀.1) ⊓ (snd ⁻¹ᵁ U_β)
  let U_loc : (U₀ : AlgebraicGeometry.Scheme.{u}).Opens := (U₀.ι ⁻¹ᵁ W₀.1) ⊓ (γ ⁻¹ᵁ U_β)
  
  let x'_O : ↥((ι ⁻¹ᵁ O₀ : Z.Opens) : AlgebraicGeometry.Scheme.{u}) :=
    ⟨x', ⟨hx'_W, hx'_U⟩⟩
  have h_pre_δ : δ ⁻¹ᵁ O₀ = U_loc := by
    ext u
    change (δ ≫ fst).base u ∈ W₀.1 ∧ (δ ≫ snd).base u ∈ U_β ↔
      U₀.ι.base u ∈ W₀.1 ∧ γ.base u ∈ U_β
    rw [CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Limits.pullback.lift_snd]
  let e_δ : ((δ ⁻¹ᵁ O₀ : (U₀ : AlgebraicGeometry.Scheme.{u}).Opens) :
      AlgebraicGeometry.Scheme.{u}) ≅ AlgebraicGeometry.Spec (CommRingCat.of L_β) :=
    ((U₀ : AlgebraicGeometry.Scheme.{u}).isoOfEq h_pre_δ) ≪≫ e_loc
  have he_δ_ι : e_δ.inv ≫ (δ ⁻¹ᵁ O₀).ι = e_loc.inv ≫ U_loc.ι := by
    dsimp only [e_δ, CategoryTheory.Iso.trans_inv]
    rw [CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.isoOfEq_inv_ι]
  
  have hh₀_ne : h₀ β ≠ 0 := by
    intro hh₀
    have h0_mem : (0 : R₀) ∈ Submonoid.powers (h₀ β) := ⟨1, by dsimp; rw [pow_one, hh₀]⟩
    have _ : Subsingleton L_β :=
      IsLocalization.subsingleton (M := Submonoid.powers (h₀ β)) (S := L_β) h0_mem
    have h_emp_spec : IsEmpty ↥(AlgebraicGeometry.Spec (CommRingCat.of L_β)) :=
      PrimeSpectrum.isEmpty_iff_subsingleton.mpr inferInstance
    have h_emp_δ : IsEmpty ↥((δ ⁻¹ᵁ O₀ : (U₀ : AlgebraicGeometry.Scheme.{u}).Opens) :
        AlgebraicGeometry.Scheme.{u}) :=
      ⟨fun y => h_emp_spec.false (e_δ.hom.base y)⟩
    have h_ker_top : (δ ∣_ O₀).ker = ⊤ :=
      (AlgebraicGeometry.Scheme.Hom.ker_eq_top_iff_isEmpty (δ ∣_ O₀)).mpr h_emp_δ
    have h_ker_ι_top : (ι ∣_ O₀).ker = ⊤ := hKer.trans h_ker_top
    have h_emp_ι : IsEmpty ↥((ι ⁻¹ᵁ O₀ : Z.Opens) : AlgebraicGeometry.Scheme.{u}) :=
      (AlgebraicGeometry.Scheme.Hom.ker_eq_top_iff_isEmpty (ι ∣_ O₀)).mp h_ker_ι_top
    exact h_emp_ι.false x'_O
  
  let κ₀ : k →+* R₀ := (AlgebraicGeometry.Spec.preimage (W₀.2.fromSpec ≫ X.hom)).hom
  have hChartO :
      ∃ (e_O : (O₀ : AlgebraicGeometry.Scheme.{u}) ≅ AlgebraicGeometry.Spec (CommRingCat.of A)),
        (e_O.inv ≫ O₀.ι ≫ fst =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) ≫ W₀.2.fromSpec) ∧
        (e_O.inv ≫ O₀.ι ≫ snd =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (MvPolynomial.map κ₀)) ≫
            iso_β.inv ≫ U_β.ι) := by
    let _ : Algebra k R₀ := RingHom.toAlgebra κ₀
    let f₁ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k R₀))
    let f₂ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k P_β))
    have h_f1 : f₁ = W₀.2.fromSpec ≫ X.hom :=
      AlgebraicGeometry.Spec.map_preimage (W₀.2.fromSpec ≫ X.hom)
    have h_f2 : iso_β.inv ≫ U_β.ι ≫ P.hom = f₂ := by
      rw [hUβ_hom, CategoryTheory.Iso.inv_hom_id_assoc]
      rfl
    let Q_aff := CategoryTheory.Limits.pullback f₁ f₂
    let π₁ := CategoryTheory.Limits.pullback.fst f₁ f₂
    let π₂ := CategoryTheory.Limits.pullback.snd f₁ f₂
    let p_W : (O₀ : AlgebraicGeometry.Scheme.{u}) ⟶ AlgebraicGeometry.Spec (CommRingCat.of R₀) :=
      Q.homOfLE inf_le_left ≫ (fst ∣_ W₀.1) ≫ W₀.2.isoSpec.hom
    let p_U : (O₀ : AlgebraicGeometry.Scheme.{u}) ⟶ AlgebraicGeometry.Spec (CommRingCat.of P_β) :=
      Q.homOfLE inf_le_right ≫ (snd ∣_ U_β) ≫ iso_β.hom
    have hp_W : p_W ≫ W₀.2.fromSpec = O₀.ι ≫ fst := by
      dsimp only [p_W]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        ← W₀.2.isoSpec_inv_ι, CategoryTheory.Iso.hom_inv_id_assoc,
        AlgebraicGeometry.morphismRestrict_ι, ← CategoryTheory.Category.assoc,
        AlgebraicGeometry.Scheme.homOfLE_ι]
    have hp_U : p_U ≫ iso_β.inv ≫ U_β.ι = O₀.ι ≫ snd := by
      dsimp only [p_U]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        CategoryTheory.Iso.hom_inv_id_assoc,
        AlgebraicGeometry.morphismRestrict_ι, ← CategoryTheory.Category.assoc,
        AlgebraicGeometry.Scheme.homOfLE_ι]
    have h_comm_pb : p_W ≫ f₁ = p_U ≫ f₂ := by
      calc
        p_W ≫ f₁ = (p_W ≫ W₀.2.fromSpec) ≫ X.hom := by
          rw [h_f1, ← CategoryTheory.Category.assoc]
        _ = O₀.ι ≫ (fst ≫ X.hom) := by
          rw [hp_W, CategoryTheory.Category.assoc]
        _ = (O₀.ι ≫ snd) ≫ P.hom := by
          rw [CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc]
        _ = p_U ≫ (iso_β.inv ≫ U_β.ι ≫ P.hom) := by
          rw [← hp_U, CategoryTheory.Category.assoc p_U, CategoryTheory.Category.assoc iso_β.inv]
        _ = p_U ≫ f₂ := by rw [h_f2]
    let hom_pb : (O₀ : AlgebraicGeometry.Scheme.{u}) ⟶ Q_aff :=
      CategoryTheory.Limits.pullback.lift p_W p_U h_comm_pb
    have h_m : (π₁ ≫ W₀.2.fromSpec) ≫ X.hom = (π₂ ≫ iso_β.inv ≫ U_β.ι) ≫ P.hom := by
      rw [CategoryTheory.Category.assoc, ← h_f1, CategoryTheory.Limits.pullback.condition,
        CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, h_f2]
    let m_aff : Q_aff ⟶ Q :=
      CategoryTheory.Limits.pullback.lift (π₁ ≫ W₀.2.fromSpec) (π₂ ≫ iso_β.inv ≫ U_β.ι) h_m
    have h_rng_m : Set.range m_aff.base ⊆ Set.range O₀.ι.base := by
      have hO₀_rng : Set.range O₀.ι.base = (O₀ : Set Q) := by
        change (O₀.ι.opensRange : Set Q) = (O₀ : Set Q)
        rw [AlgebraicGeometry.Scheme.Opens.opensRange_ι]
      rw [hO₀_rng]
      rintro _ ⟨z, rfl⟩
      have hzW : (m_aff ≫ fst).base z ∈ (W₀.1 : Set X.left) := by
        rw [CategoryTheory.Limits.pullback.lift_fst, ← W₀.2.isoSpec_inv_ι]
        have hW_rng : Set.range W₀.1.ι.base = (W₀.1 : Set X.left) := by
          change (W₀.1.ι.opensRange : Set X.left) = (W₀.1 : Set X.left)
          rw [AlgebraicGeometry.Scheme.Opens.opensRange_ι]
        rw [← hW_rng]
        exact ⟨(π₁ ≫ W₀.2.isoSpec.inv).base z, rfl⟩
      have hzU : (m_aff ≫ snd).base z ∈ (U_β : Set P.left) := by
        rw [CategoryTheory.Limits.pullback.lift_snd]
        have hU_rng : Set.range U_β.ι.base = (U_β : Set P.left) := by
          change (U_β.ι.opensRange : Set P.left) = (U_β : Set P.left)
          rw [AlgebraicGeometry.Scheme.Opens.opensRange_ι]
        rw [← hU_rng]
        exact ⟨(π₂ ≫ iso_β.inv).base z, rfl⟩
      exact ⟨hzW, hzU⟩
    let inv_pb : Q_aff ⟶ (O₀ : AlgebraicGeometry.Scheme.{u}) :=
      AlgebraicGeometry.IsOpenImmersion.lift O₀.ι m_aff h_rng_m
    have h_inv_pb : inv_pb ≫ O₀.ι = m_aff :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac O₀.ι m_aff h_rng_m
    have h_hom_inv : hom_pb ≫ inv_pb = 𝟙 (O₀ : AlgebraicGeometry.Scheme.{u}) := by
      apply (CategoryTheory.cancel_mono O₀.ι).mp
      rw [CategoryTheory.Category.assoc, h_inv_pb, CategoryTheory.Category.id_comp]
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst, hp_W]
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd, hp_U]
    have h_inv_hom : inv_pb ≫ hom_pb = 𝟙 Q_aff := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · apply (CategoryTheory.cancel_mono (W₀.2.isoSpec.inv ≫ W₀.1.ι)).mp
        calc
          ((inv_pb ≫ hom_pb) ≫ π₁) ≫ (W₀.2.isoSpec.inv ≫ W₀.1.ι)
            = inv_pb ≫ (hom_pb ≫ π₁) ≫ W₀.2.fromSpec := by
              rw [W₀.2.isoSpec_inv_ι, CategoryTheory.Category.assoc,
                CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc hom_pb]
          _ = inv_pb ≫ p_W ≫ W₀.2.fromSpec := by
              rw [CategoryTheory.Limits.pullback.lift_fst]
          _ = (inv_pb ≫ O₀.ι) ≫ fst := by
              rw [hp_W, CategoryTheory.Category.assoc]
          _ = π₁ ≫ (W₀.2.isoSpec.inv ≫ W₀.1.ι) := by
              rw [h_inv_pb, CategoryTheory.Limits.pullback.lift_fst, W₀.2.isoSpec_inv_ι]
          _ = (𝟙 Q_aff ≫ π₁) ≫ (W₀.2.isoSpec.inv ≫ W₀.1.ι) := by
              rw [CategoryTheory.Category.id_comp]
      · apply (CategoryTheory.cancel_mono (iso_β.inv ≫ U_β.ι)).mp
        calc
          ((inv_pb ≫ hom_pb) ≫ π₂) ≫ (iso_β.inv ≫ U_β.ι)
            = inv_pb ≫ (hom_pb ≫ π₂) ≫ (iso_β.inv ≫ U_β.ι) := by
              rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
                ← CategoryTheory.Category.assoc hom_pb]
          _ = inv_pb ≫ p_U ≫ (iso_β.inv ≫ U_β.ι) := by
              rw [CategoryTheory.Limits.pullback.lift_snd]
          _ = (inv_pb ≫ O₀.ι) ≫ snd := by
              rw [hp_U, CategoryTheory.Category.assoc]
          _ = π₂ ≫ (iso_β.inv ≫ U_β.ι) := by
              rw [h_inv_pb, CategoryTheory.Limits.pullback.lift_snd]
          _ = (𝟙 Q_aff ≫ π₂) ≫ (iso_β.inv ≫ U_β.ι) := by
              rw [CategoryTheory.Category.id_comp]
    let iso_pb : (O₀ : AlgebraicGeometry.Scheme.{u}) ≅ Q_aff :=
      { hom := hom_pb, inv := inv_pb, hom_inv_id := h_hom_inv, inv_hom_id := h_inv_hom }
    let e_tens : TensorProduct k R₀ P_β ≃ₐ[R₀] A := MvPolynomial.algebraTensorAlgEquiv k R₀
    let iso_alg :
        AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct k R₀ P_β)) ≅
          AlgebraicGeometry.Spec (CommRingCat.of A) :=
      { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_tens.symm.toRingHom)
        inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_tens.toRingHom)
        hom_inv_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          have h_id : e_tens.symm.toRingHom.comp e_tens.toRingHom =
              RingHom.id (TensorProduct k R₀ P_β) :=
            RingHom.ext fun x => e_tens.symm_apply_apply x
          rw [h_id, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
        inv_hom_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          have h_id : e_tens.toRingHom.comp e_tens.symm.toRingHom = RingHom.id A :=
            RingHom.ext fun x => e_tens.apply_symm_apply x
          rw [h_id, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id] }
    let e_O : (O₀ : AlgebraicGeometry.Scheme.{u}) ≅ AlgebraicGeometry.Spec (CommRingCat.of A) :=
      iso_pb ≪≫ AlgebraicGeometry.pullbackSpecIso k R₀ P_β ≪≫ iso_alg
    refine ⟨e_O, ?_, ?_⟩
    · dsimp only [e_O, iso_pb, iso_alg, CategoryTheory.Iso.trans_inv]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc inv_pb, h_inv_pb,
        CategoryTheory.Limits.pullback.lift_fst]
      rw [← CategoryTheory.Category.assoc (AlgebraicGeometry.pullbackSpecIso k R₀ P_β).inv,
        AlgebraicGeometry.pullbackSpecIso_inv_fst k R₀ P_β]
      rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp]
      have h_left : e_tens.toRingHom.comp Algebra.TensorProduct.includeLeftRingHom =
          (MvPolynomial.C : R₀ →+* A) :=
        RingHom.ext fun r => by
          change e_tens (r ⊗ₜ[k] (1 : P_β)) = MvPolynomial.C r
          rw [MvPolynomial.algebraTensorAlgEquiv_tmul, map_one, Algebra.smul_def, mul_one]
          rfl
      rw [h_left]
    · dsimp only [e_O, iso_pb, iso_alg, CategoryTheory.Iso.trans_inv]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc inv_pb, h_inv_pb,
        CategoryTheory.Limits.pullback.lift_snd]
      rw [← CategoryTheory.Category.assoc (AlgebraicGeometry.pullbackSpecIso k R₀ P_β).inv,
        AlgebraicGeometry.pullbackSpecIso_inv_snd k R₀ P_β]
      rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp]
      congr 1
      congr 1
      congr 1
      refine RingHom.ext fun p => ?_
      change e_tens ((1 : R₀) ⊗ₜ[k] p) = MvPolynomial.map κ₀ p
      rw [MvPolynomial.algebraTensorAlgEquiv_tmul, one_smul]
      rfl
  obtain ⟨e_O, heO_fst, heO_snd⟩ := hChartO
  
  let w : I_β → L_β := fun α =>
    algebraMap R₀ L_β (h₀ α.1) * IsLocalization.Away.invSelf (S := L_β) (h₀ β)
  let Θ : A →ₐ[R₀] L_β := MvPolynomial.aeval w
  let ψ_snd : P_β →+* L_β := MvPolynomial.eval₂Hom ((algebraMap R₀ L_β).comp κ₀) w
  have hΘ_C : Θ.toRingHom.comp MvPolynomial.C = algebraMap R₀ L_β :=
    RingHom.ext fun r => Θ.commutes r
  have hΘ_map : Θ.toRingHom.comp (MvPolynomial.map κ₀) = ψ_snd := by
    apply MvPolynomial.ringHom_ext'
    · refine RingHom.ext fun c => ?_
      change Θ (MvPolynomial.map κ₀ (MvPolynomial.C c)) = ψ_snd (MvPolynomial.C c)
      rw [MvPolynomial.map_C]
      exact (Θ.commutes (κ₀ c)).trans (MvPolynomial.eval₂Hom_C ((algebraMap R₀ L_β).comp κ₀) w c).symm
    · intro α
      change Θ (MvPolynomial.map κ₀ (MvPolynomial.X α)) = ψ_snd (MvPolynomial.X α)
      rw [MvPolynomial.map_X, MvPolynomial.aeval_X]
      dsimp only [ψ_snd]
      rw [MvPolynomial.eval₂Hom_X']
  have h_δ_spec :
      e_δ.inv ≫ (δ ∣_ O₀) ≫ e_O.hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom Θ.toRingHom) := by
    apply (CategoryTheory.cancel_mono (e_O.inv ≫ O₀.ι)).mp
    have h_lhs : (e_δ.inv ≫ (δ ∣_ O₀) ≫ e_O.hom) ≫ (e_O.inv ≫ O₀.ι) =
        e_loc.inv ≫ U_loc.ι ≫ δ := by
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        CategoryTheory.Iso.hom_inv_id_assoc, AlgebraicGeometry.morphismRestrict_ι,
        ← CategoryTheory.Category.assoc, he_δ_ι, CategoryTheory.Category.assoc]
    rw [h_lhs]
    apply CategoryTheory.Limits.pullback.hom_ext
    · calc
        (e_loc.inv ≫ U_loc.ι ≫ δ) ≫ fst
          = e_loc.inv ≫ U_loc.ι ≫ U₀.ι := by
            rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pullback.lift_fst]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ L_β)) ≫
              W₀.2.fromSpec := he_fst
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom Θ.toRingHom) ≫
              (e_O.inv ≫ O₀.ι ≫ fst) := by
            rw [heO_fst,
              ← CategoryTheory.Category.assoc
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom Θ.toRingHom)),
              ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hΘ_C]
        _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom Θ.toRingHom) ≫
              (e_O.inv ≫ O₀.ι)) ≫ fst := by
            rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]
    · calc
        (e_loc.inv ≫ U_loc.ι ≫ δ) ≫ snd
          = e_loc.inv ≫ U_loc.ι ≫ γ := by
            rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pullback.lift_snd]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_snd) ≫
              iso_β.inv ≫ U_β.ι := he_snd
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom Θ.toRingHom) ≫
              (e_O.inv ≫ O₀.ι ≫ snd) := by
            rw [heO_snd,
              ← CategoryTheory.Category.assoc
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom Θ.toRingHom)),
              ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hΘ_map]
        _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom Θ.toRingHom) ≫
              (e_O.inv ≫ O₀.ι)) ≫ snd := by
            rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]
  
  have h_range : Θ.range = B_sub := by
    change (MvPolynomial.aeval w).range = B_sub
    rw [MvPolynomial.aeval_range]
    apply le_antisymm
    · rw [Algebra.adjoin_le_iff]
      rintro _ ⟨α, rfl⟩
      exact Algebra.subset_adjoin ⟨α.1, rfl⟩
    · dsimp only [B_sub, weilBlowupChartSubalg]
      rw [Algebra.adjoin_le_iff]
      rintro _ ⟨α, rfl⟩
      by_cases hα : α = β
      · subst hα
        change algebraMap R₀ L_β (h₀ α) * IsLocalization.Away.invSelf (S := L_β) (h₀ α) ∈
          Algebra.adjoin R₀ (Set.range w)
        rw [IsLocalization.Away.mul_invSelf]
        exact Subalgebra.one_mem _
      · exact Algebra.subset_adjoin ⟨⟨α, hα⟩, rfl⟩
  let q_alg : A →ₐ[R₀] B :=
    (Subalgebra.equivOfEq Θ.range B_sub h_range).toAlgHom.comp Θ.rangeRestrict
  let q : A →+* B := q_alg.toRingHom
  have hq_surj : Function.Surjective q :=
    (Subalgebra.equivOfEq Θ.range B_sub h_range).surjective.comp
      (AlgHom.rangeRestrict_surjective Θ)
  have hq_val : B_sub.val.toRingHom.comp q = Θ.toRingHom :=
    RingHom.ext fun _ => rfl
  have hq_C : q.comp MvPolynomial.C = algebraMap R₀ B :=
    RingHom.ext fun r => q_alg.commutes r
  
  have _ : AlgebraicGeometry.IsClosedImmersion ι := hCl_ι
  let S_A := AlgebraicGeometry.Spec (CommRingCat.of A)
  let i₁ : ((ι ⁻¹ᵁ O₀ : Z.Opens) : AlgebraicGeometry.Scheme.{u}) ⟶ S_A :=
    (ι ∣_ O₀) ≫ e_O.hom
  let i₂ : AlgebraicGeometry.Spec (CommRingCat.of B) ⟶ S_A :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom q)
  have _ : AlgebraicGeometry.IsClosedImmersion i₂ :=
    AlgebraicGeometry.IsClosedImmersion.spec_of_surjective (CommRingCat.ofHom q) hq_surj
  have h_ker_spec : ∀ {C : Type u} [CommRing C] (φ : A →+* C),
      RingHom.ker (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)).appTop.hom =
        Ideal.comap (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A)).hom.hom
          (RingHom.ker φ) := by
    intro C _ φ
    have h_inj : Function.Injective
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of C)).hom.hom :=
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of C)).commRingCatIsoToRingEquiv.injective
    calc
      RingHom.ker (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)).appTop.hom
        = RingHom.ker ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of C)).hom.hom.comp
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)).appTop.hom) :=
          (RingHom.ker_comp_of_injective _ h_inj).symm
      _ = RingHom.ker
            (φ.comp (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A)).hom.hom) := by
          congr 1
          exact congrArg CommRingCat.Hom.hom
            (AlgebraicGeometry.Scheme.ΓSpecIso_naturality (CommRingCat.ofHom φ))
      _ = Ideal.comap (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A)).hom.hom
            (RingHom.ker φ) := by
          rw [← RingHom.comap_ker]
  have h_ker_ring : RingHom.ker Θ.toRingHom = RingHom.ker q := by
    rw [← hq_val]
    exact RingHom.ker_comp_of_injective q Subtype.val_injective
  have h_ker_θ_i2 :
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom Θ.toRingHom)).ker = i₂.ker := by
    rw [AlgebraicGeometry.Scheme.ker_of_isAffine
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom Θ.toRingHom)),
        AlgebraicGeometry.Scheme.ker_of_isAffine i₂]
    congr 1
    dsimp only [i₂]
    rw [h_ker_spec Θ.toRingHom, h_ker_spec q, h_ker_ring]
  have h_ker : i₁.ker = i₂.ker := by
    calc
      i₁.ker = ((ι ∣_ O₀).ker).map e_O.hom :=
        AlgebraicGeometry.Scheme.Hom.ker_comp (ι ∣_ O₀) e_O.hom
      _ = ((δ ∣_ O₀).ker).map e_O.hom := by rw [hKer]
      _ = ((δ ∣_ O₀) ≫ e_O.hom).ker :=
        AlgebraicGeometry.Scheme.IdealSheafData.map_ker (δ ∣_ O₀) e_O.hom
      _ = (e_δ.inv ≫ ((δ ∣_ O₀) ≫ e_O.hom)).ker :=
        (AlgebraicGeometry.Scheme.Hom.ker_comp_of_isIso e_δ.inv ((δ ∣_ O₀) ≫ e_O.hom)).symm
      _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom Θ.toRingHom)).ker := by
        rw [h_δ_spec]
      _ = i₂.ker := h_ker_θ_i2
  
  let L_chart : AlgebraicGeometry.Spec (CommRingCat.of B) ⟶
      ((ι ⁻¹ᵁ O₀ : Z.Opens) : AlgebraicGeometry.Scheme.{u}) :=
    AlgebraicGeometry.IsClosedImmersion.lift i₁ i₂ h_ker.le
  have _ : CategoryTheory.IsIso L_chart :=
    AlgebraicGeometry.IsClosedImmersion.isIso_lift i₁ i₂ h_ker
  have h_L_ι : L_chart ≫ (ι ∣_ O₀) = i₂ ≫ e_O.inv := by
    have h_fac := AlgebraicGeometry.IsClosedImmersion.lift_fac i₁ i₂ h_ker.le
    dsimp only [L_chart, i₁] at h_fac ⊢
    calc
      AlgebraicGeometry.IsClosedImmersion.lift ((ι ∣_ O₀) ≫ e_O.hom) i₂ h_ker.le ≫ (ι ∣_ O₀)
        = (AlgebraicGeometry.IsClosedImmersion.lift ((ι ∣_ O₀) ≫ e_O.hom) i₂ h_ker.le ≫
            ((ι ∣_ O₀) ≫ e_O.hom)) ≫ e_O.inv := by
          rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
            CategoryTheory.Iso.hom_inv_id, CategoryTheory.Category.comp_id]
      _ = i₂ ≫ e_O.inv := by rw [h_fac]
  let j_chart : AlgebraicGeometry.Spec (CommRingCat.of B) ⟶ Z := L_chart ≫ (ι ⁻¹ᵁ O₀).ι
  let z₀ : AlgebraicGeometry.Spec (CommRingCat.of B) := (CategoryTheory.inv L_chart).base x'_O
  refine ⟨z₀, j_chart, hh₀_ne, inferInstance, ?_, ?_⟩
  · change ((CategoryTheory.inv L_chart ≫ L_chart) ≫ (ι ⁻¹ᵁ O₀).ι).base x'_O = x'
    rw [CategoryTheory.IsIso.inv_hom_id, CategoryTheory.Category.id_comp]
    rfl
  · calc
      j_chart ≫ ι ≫ fst
        = L_chart ≫ ((ι ⁻¹ᵁ O₀).ι ≫ ι) ≫ fst := by
          dsimp only [j_chart]
          rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]
      _ = (L_chart ≫ (ι ∣_ O₀)) ≫ O₀.ι ≫ fst := by
          rw [← AlgebraicGeometry.morphismRestrict_ι ι O₀,
            CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]
      _ = i₂ ≫ (e_O.inv ≫ O₀.ι ≫ fst) := by
          rw [h_L_ι, CategoryTheory.Category.assoc]
      _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom q) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C)) ≫
            W₀.2.fromSpec := by
          dsimp only [i₂]
          rw [heO_fst, CategoryTheory.Category.assoc]
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ B)) ≫
            W₀.2.fromSpec := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hq_C]

theorem weil_blowup_graph_closure_scheme_and_charts (k : Type u) [Field k]
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (K : Set X.left)
    (hIntX : AlgebraicGeometry.IsIntegral X.left)
    (hProjX : IsProjectiveOverField k X)
    (hClosedK : IsClosed K)
    (hNonUniv : Kᶜ.Nonempty)
    (M L : ℕ)
    (W : Fin (M + 1) → X.left.affineOpens)
    (h : ∀ ν : Fin (M + 1), Fin (L + 1) → ↑(X.left.presheaf.obj (Opposite.op (W ν).1)))
    (hCov : (⨆ ν : Fin (M + 1), (W ν).1) = ⊤)
    (hSpan : ∀ ν : Fin (M + 1),
      Ideal.span (Set.range (h ν)) =
        (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal ⟨K, hClosedK⟩).ideal (W ν))
    (hUnit : ∀ ν μ : Fin (M + 1),
      ∃ u : ↑(X.left.presheaf.obj (Opposite.op ((W ν).1 ⊓ (W μ).1))),
        IsUnit u ∧
        ∀ β : Fin (L + 1),
          (X.left.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (h ν β) =
            u * (X.left.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom (h μ β)) :
    ∃ (X' : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (π : X' ⟶ X)
      (ι : X'.left ⟶ CategoryTheory.Limits.pullback X.hom (weilProjectiveSpaceOver k L).hom)
      (U₀ : X.left.Opens),
      AlgebraicGeometry.IsClosedImmersion ι ∧
      ι ≫ CategoryTheory.Limits.pullback.fst X.hom (weilProjectiveSpaceOver k L).hom = π.left ∧
      AlgebraicGeometry.IsIntegral X'.left ∧
      IsGenFiniteEtaleAlterationOver k π ∧
      ((U₀ : Set X.left) = Kᶜ ∧ Nonempty U₀ ∧ CategoryTheory.IsIso (π.left ∣_ U₀)) ∧
      (∀ x' : X'.left,
        ∃ (ν : Fin (M + 1)) (β : Fin (L + 1))
          (z₀ : AlgebraicGeometry.Spec (CommRingCat.of ↥(weilBlowupChartSubalg
            (↑(X.left.presheaf.obj (Opposite.op (W ν).1))) (h ν) β)))
          (j_chart : AlgebraicGeometry.Spec (CommRingCat.of ↥(weilBlowupChartSubalg
            (↑(X.left.presheaf.obj (Opposite.op (W ν).1))) (h ν) β)) ⟶ X'.left),
          π.left.base x' ∈ (W ν).1 ∧
          h ν β ≠ 0 ∧
          AlgebraicGeometry.IsOpenImmersion j_chart ∧
          j_chart.base z₀ = x' ∧
