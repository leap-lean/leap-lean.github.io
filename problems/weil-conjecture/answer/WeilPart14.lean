    refine ⟨B', inferInstance, q₀, φ, ψ_et, e_B,
      hEt_φ, hEt_ψet, hm_le_q₀, heB_q₀, hC_eq, hSpec_φ, ?_⟩
    intro q j
    rfl

  
  · intro h ψ_zar α_x hh_px hEt_zar hC_zar hInj_αx hMap_ker
    let U : W.left.Opens := W.left.basicOpen h
    have hAffU : AlgebraicGeometry.IsAffineOpen U := hAffU₁.basicOpen h
    have hxU : x ∈ U := by
      have hp_bo : p_x ∈ PrimeSpectrum.basicOpen h := hh_px
      rw [← hAffU₁.fromSpec_preimage_basicOpen h] at hp_bo
      change hAffU₁.fromSpec.base p_x ∈ U at hp_bo
      rwa [hp_x] at hp_bo
    let R₁ := ↑(W.left.presheaf.obj (Opposite.op U₁))
    let R_U := ↑(W.left.presheaf.obj (Opposite.op U))
    have : IsLocalization.Away h R_U := hAffU₁.isLocalization_basicOpen h
    let e_loc : Localization.Away h ≃ₐ[R₁] R_U :=
      IsLocalization.algEquiv (Submonoid.powers h) (Localization.Away h) R_U
    let ψ : MvPolynomial (Fin (m + 1)) k →+* R_U := e_loc.toRingHom.comp ψ_zar
    have hEt_U : AlgebraicGeometry.Etale
        (U.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) := by
      have hEt_ψ : ψ.Etale :=
        RingHom.Etale.respectsIso.left ψ_zar e_loc.toRingEquiv hEt_zar
      have : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hEt_ψ
      have : AlgebraicGeometry.IsOpenImmersion U.toSpecΓ := by
        rw [← hAffU.isoSpec_hom]
        infer_instance
      have : AlgebraicGeometry.Etale U.toSpecΓ :=
        AlgebraicGeometry.Etale.instOfIsOpenImmersion U.toSpecΓ
      infer_instance
    have hComm_U : U.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = U.ι ≫ W.hom := by
      have hC_ψ : CommRingCat.ofHom (ψ.comp MvPolynomial.C) =
          CommRingCat.ofHom (θ.comp MvPolynomial.C) ≫
            W.left.presheaf.map (homOfLE (W.left.basicOpen_le h)).op := by
        ext c
        change e_loc ((ψ_zar.comp MvPolynomial.C) c) =
          algebraMap R₁ R_U ((θ.comp MvPolynomial.C) c)
        rw [hC_zar]
        exact e_loc.commutes ((θ.comp MvPolynomial.C) c)
      have h_comp : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ.comp MvPolynomial.C)) := by
        rw [← AlgebraicGeometry.Spec.map_comp]
        rfl
      rw [h_comp, hC_ψ, AlgebraicGeometry.Spec.map_comp, hComm_θ]
      rw [← Category.assoc (AlgebraicGeometry.Spec.map _),
        hAffU₁.map_fromSpec hAffU (homOfLE (W.left.basicOpen_le h)).op,
        ← Category.assoc, hAffU.toSpecΓ_fromSpec]
    have hix_of : ∀ (i : Fin r),
        Nonempty ↑((TopologicalSpace.Opens.map (ιD i).base).obj U) →
        x ∈ Set.range (ιD i).base := by
      intro i ⟨⟨z, hz⟩⟩
      by_contra hni
      have hzU₁ : (ιD i).base z ∈ (U₁ : Set W.left) := W.left.basicOpen_le h hz
      have h_mem : (ιD i).base z ∈ (U₁ : Set W.left) ∩ Set.range (ιD i).base :=
        ⟨hzU₁, ⟨z, rfl⟩⟩
      rw [hDisj_out i hni] at h_mem
      exact h_mem
    let α : {i : Fin r // Nonempty ↑((TopologicalSpace.Opens.map (ιD i).base).obj U)} →
        Fin (m + 1) :=
      fun sub => α_x ⟨sub.1, hix_of sub.1 sub.2⟩
    have hInj_α : Function.Injective α := by
      intro sub₁ sub₂ h_eq
      exact Subtype.ext (Subtype.mk.inj (hInj_αx h_eq))
    refine ⟨U, hAffU, hxU, ψ, hEt_U, hComm_U, α, hInj_α, ?_⟩
    intro i hi
    have := _hClD i
    let V_i : (D i).Opens := (TopologicalSpace.Opens.map (ιD i).base).obj U₁
    have hAffVi : AlgebraicGeometry.IsAffineOpen V_i := hAffU₁.preimage (ιD i)
    let f₁ := ((ιD i).app U₁).hom
    let S_V' := ↑((D i).presheaf.obj (Opposite.op ((D i).basicOpen (f₁ h))))
    have : IsLocalization.Away (f₁ h) S_V' := hAffVi.isLocalization_basicOpen (f₁ h)
    have hApp_eq := AlgebraicGeometry.IsAffineOpen.app_basicOpen_eq_away_map (ιD i) hAffU₁ hAffVi h
    let e_open := Scheme.Hom.preimage_basicOpen (ιD i) h
    have hApp_inv : (ιD i).app (W.left.basicOpen h) ≫
          (D i).presheaf.map (eqToHom e_open.symm).op =
        CommRingCat.ofHom (IsLocalization.Away.map R_U S_V' f₁ h) := by
      rw [hApp_eq, Category.assoc, ← Functor.map_comp, ← op_comp,
        eqToHom_trans, eqToHom_refl, op_id, CategoryTheory.Functor.map_id]
      exact Category.comp_id _
    have hKer_eq : RingHom.ker ((ιD i).app U).hom =
        RingHom.ker (IsLocalization.Away.map R_U S_V' f₁ h) := by
      ext y
      simp only [RingHom.mem_ker]
      constructor
      · intro hy
        have h_eval : (((ιD i).app (W.left.basicOpen h) ≫
            (D i).presheaf.map (eqToHom e_open.symm).op).hom) y =
            (IsLocalization.Away.map R_U S_V' f₁ h) y := by
          rw [hApp_inv]
          rfl
        rw [← h_eval, CommRingCat.hom_comp, RingHom.coe_comp, Function.comp_apply]
        change ((D i).presheaf.map (eqToHom e_open.symm).op).hom (((ιD i).app U).hom y) = 0
        rw [hy, map_zero]
      · intro hy
        have h_eval : ((ιD i).app U).hom y =
            (CommRingCat.ofHom (IsLocalization.Away.map R_U S_V' f₁ h) ≫
              (D i).presheaf.map (eqToHom e_open).op).hom y := by
          change ((ιD i).app (W.left.basicOpen h)).hom y = _
          rw [hApp_eq]
        rw [h_eval, CommRingCat.hom_comp, RingHom.coe_comp, Function.comp_apply]
        change ((D i).presheaf.map (eqToHom e_open).op).hom
          ((IsLocalization.Away.map R_U S_V' f₁ h) y) = 0
        rw [hy, map_zero]
    have hKer_loc : RingHom.ker (IsLocalization.Away.map R_U S_V' f₁ h) =
        Ideal.map (algebraMap R₁ R_U) (RingHom.ker f₁) :=
      IsLocalization.ker_map S_V' f₁ (Submonoid.map_powers f₁ h)
    rw [hKer_eq, hKer_loc]
    have h_alg_eq : algebraMap R₁ R_U =
        e_loc.toRingHom.comp (algebraMap R₁ (Localization.Away h)) := by
      ext r
      exact (e_loc.commutes r).symm
    rw [h_alg_eq, ← Ideal.map_map, hMap_ker i (hix_of i hi), Ideal.map_span, Set.image_singleton]
    rfl

theorem weil_split_etale_nc_level_one_to_strict_snc (k : Type u) [Field k] [IsAlgClosed k]
    (m : ℕ)
    (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (Z_W : Set W.left)
    (hIntW : AlgebraicGeometry.IsIntegral W.left)
    (hProjW : IsProjectiveOverField k W)
    (hSmW : AlgebraicGeometry.SmoothOfRelativeDimension (m + 1) W.hom)
    (hPair1 : IsSplitEtaleNcPair k m 1 W Z_W) :
    IsSncDivisorSupport k (m + 1) W Z_W :=
by
  let _ := hIntW
  have : AlgebraicGeometry.LocallyOfFiniteType W.hom := by
    obtain ⟨N_p, ι_p, hCl_p⟩ := hProjW
    have : AlgebraicGeometry.IsClosedImmersion ι_p.left := hCl_p
    rw [← CategoryTheory.Over.w ι_p]
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N_p + 1)) k
    let : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have : IsScalarTower k ↥(𝒜 0) (MvPolynomial (Fin (N_p + 1)) k) :=
      ⟨fun c x p => smul_mul_assoc c (x : MvPolynomial (Fin (N_p + 1)) k) p⟩
    have : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (N_p + 1)) k) :=
      Algebra.FiniteType.of_restrictScalars_finiteType k ↥(𝒜 0) (MvPolynomial (Fin (N_p + 1)) k)
    have hSurj : Function.Surjective (algebraMap k ↥(𝒜 0)) := by
      intro x
      have hx : x.1 ∈ MvPolynomial.homogeneousSubmodule (Fin (N_p + 1)) k 0 := x.2
      rw [MvPolynomial.homogeneousSubmodule_zero, Submodule.mem_one] at hx
      rcases hx with ⟨c, hc⟩
      exact ⟨c, Subtype.ext hc⟩
    have hFT_zero : (algebraMap k ↥(𝒜 0)).FiniteType :=
      RingHom.FiniteType.of_surjective _ hSurj
    have hLFT_spec : AlgebraicGeometry.LocallyOfFiniteType
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType)).mpr hFT_zero
    have hLFT_proj : AlgebraicGeometry.LocallyOfFiniteType (AlgebraicGeometry.Proj.toSpecZero 𝒜) :=
      @AlgebraicGeometry.Proj.instLocallyOfFiniteTypeToSpecZeroOfFiniteTypeSubtypeMemOfNatNat
        _ _ _ _ _ 𝒜 _ _
    have : AlgebraicGeometry.LocallyOfFiniteType (weilProjectiveSpaceOver k N_p).hom :=
      MorphismProperty.comp_mem _ _ _ hLFT_proj hLFT_spec
    infer_instance
  obtain ⟨q, H, ιH, Z_nc, hClH, hIntH, _hSmH, hPairH, hClosedZnc, hZW_eq, hCharts⟩ := hPair1
  let Z_nc_cl : TopologicalSpace.Closeds ↥W.left := ⟨Z_nc, hClosedZnc⟩
  let I_nc_sheaf : W.left.IdealSheafData :=
    AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal Z_nc_cl
  let Y_nc : AlgebraicGeometry.Scheme.{u} := I_nc_sheaf.subscheme
  let ι_nc : Y_nc ⟶ W.left := I_nc_sheaf.subschemeι
  have hCl_nc : AlgebraicGeometry.IsClosedImmersion ι_nc := inferInstance
  have hRange_nc : Set.range ι_nc.base = Z_nc := by
    change Set.range ⇑I_nc_sheaf.subschemeι = Z_nc
    rw [AlgebraicGeometry.Scheme.IdealSheafData.range_subschemeι,
      AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal]
    rfl
  let Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    CategoryTheory.Over.mk (ι_nc ≫ W.hom)
  have hProjY : IsProjectiveOverField k Y := by
    obtain ⟨N_proj, ι_proj, hCl_proj⟩ := hProjW
    refine ⟨N_proj, CategoryTheory.Over.homMk (ι_nc ≫ ι_proj.left) ?_, ?_⟩
    · simp [Y, CategoryTheory.Over.w ι_proj]
    · change AlgebraicGeometry.IsClosedImmersion (ι_nc ≫ ι_proj.left)
      have := hCl_proj
      infer_instance
  
  have hSmY_loc : ∀ y : Y.left, ∃ V_y : Y.left.Opens,
      y ∈ V_y ∧ AlgebraicGeometry.SmoothOfRelativeDimension m (V_y.ι ≫ Y.hom) := by
    intro y
    have hy_Znc : ι_nc.base y ∈ Z_nc := by
      rw [← hRange_nc]
      exact ⟨y, rfl⟩
    obtain ⟨R', v₀, e_W, ψ, _α_snc, I_nc, hEt_e, hEt_ψ, hv₀, hComm,
      _hInj, _hDisj, hCard, _hVan_α, _hVan_nc, _hOut, _hIn, hPre_Znc⟩ := hCharts (ι_nc.base y)
    have hv₀_Znc : v₀ ∈ e_W.base ⁻¹' Z_nc := by
      change e_W.base v₀ ∈ Z_nc
      rw [hv₀]
      exact hy_Znc
    rw [hPre_Znc] at hv₀_Znc
    obtain ⟨j₀, hj₀_mem, _hj₀_van⟩ := hv₀_Znc
    have hPre_single : e_W.base ⁻¹' Z_nc =
        {v : AlgebraicGeometry.Spec R' | ψ (MvPolynomial.X j₀) ∈ v.asIdeal} := by
      rw [hPre_Znc]
      ext v
      simp only [Set.mem_setOf_eq]
      constructor
      · rintro ⟨j, hj_mem, hj_van⟩
        have hjeq : j = j₀ := Finset.card_le_one.mp hCard j hj_mem j₀ hj₀_mem
        rwa [← hjeq]
      · intro hj₀_v
        exact ⟨j₀, hj₀_mem, hj₀_v⟩
    obtain ⟨R'_Y, w₀, e_Y, ψ_Y, hEt_eY, hEt_ψY, hw₀, hCommY⟩ :=
      weil_vanishingIdeal_codim_one_etale_roof k m W Z_nc hClosedZnc y R' v₀ e_W ψ j₀
        hEt_e hEt_ψ hv₀ hComm hPre_single
    exact (weil_smoothOfRelativeDimension_and_toroidal_sing_of_etale k Y hProjY y).1
      m R'_Y w₀ e_Y ψ_Y hEt_eY hEt_ψY hw₀ hCommY
  have hSmY : AlgebraicGeometry.SmoothOfRelativeDimension m Y.hom := by
    rw [AlgebraicGeometry.smoothOfRelativeDimension_iff]
    intro y
    obtain ⟨V_y, hyV, hSmVy⟩ := hSmY_loc y
    rw [AlgebraicGeometry.smoothOfRelativeDimension_iff] at hSmVy
    obtain ⟨U_k, hAffUk, W_sub, hAffW, hyW, he_sub, hStd_sub⟩ := hSmVy ⟨y, hyV⟩
    let V₀ : Y.left.Opens := V_y.ι ''ᵁ W_sub
    have hAffV₀ : AlgebraicGeometry.IsAffineOpen V₀ := hAffW.image_of_isOpenImmersion V_y.ι
    have hyV₀ : y ∈ V₀ := ⟨⟨y, hyV⟩, hyW, rfl⟩
    have he₀ : V₀ ≤ Y.hom ⁻¹ᵁ U_k := by
      rintro _ ⟨w, hw, rfl⟩
      exact he_sub hw
    refine ⟨U_k, hAffUk, V₀, hAffV₀, hyV₀, he₀, ?_⟩
    have hRange_WV : Set.range (hAffW.fromSpec ≫ V_y.ι).base =
        Set.range hAffV₀.fromSpec.base := by
      rw [hAffV₀.range_fromSpec]
      ext z
      constructor
      · rintro ⟨p, rfl⟩
        have hp : hAffW.fromSpec.base p ∈ (W_sub : Set ↥V_y.toScheme) := by
          rw [← hAffW.range_fromSpec]
          exact ⟨p, rfl⟩
        exact ⟨hAffW.fromSpec.base p, hp, rfl⟩
      · rintro ⟨w, hw, rfl⟩
        have hw_r : w ∈ Set.range hAffW.fromSpec.base := by
          rwa [hAffW.range_fromSpec]
        obtain ⟨p, rfl⟩ := hw_r
        exact ⟨p, rfl⟩
    let iso_WV : AlgebraicGeometry.Spec (V_y.toScheme.presheaf.obj (Opposite.op W_sub)) ≅
        AlgebraicGeometry.Spec (Y.left.presheaf.obj (Opposite.op V₀)) :=
      AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq
        (hAffW.fromSpec ≫ V_y.ι) hAffV₀.fromSpec hRange_WV
    have hFac_WV : iso_WV.hom ≫ hAffV₀.fromSpec = hAffW.fromSpec ≫ V_y.ι :=
      AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac _ _ hRange_WV
    let e_WV : Y.left.presheaf.obj (Opposite.op V₀) ≅
        V_y.toScheme.presheaf.obj (Opposite.op W_sub) :=
      { hom := AlgebraicGeometry.Spec.preimage iso_WV.hom
        inv := AlgebraicGeometry.Spec.preimage iso_WV.inv
