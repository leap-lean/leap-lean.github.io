              rw [h_cocycle_R]
        _ = (q_O ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_R)) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ i'j')) ≫ w_N ν' := by
              rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp]
              simp only [CategoryTheory.Category.assoc]
        _ = pR ≫ σ_loc i'j' := by
              rw [hqO_R]
              exact CategoryTheory.Category.assoc _ _ _
    let σ : CategoryTheory.Limits.pullback P₁.hom P₂.hom ⟶ P_N.left :=
      AlgebraicGeometry.Scheme.Cover.glueMorphisms 𝒰₁₂ σ_loc h_glue
    have hσ_loc : ∀ ij : 𝒰₁₂.I₀, 𝒰₁₂.f ij ≫ σ = σ_loc ij :=
      AlgebraicGeometry.Scheme.Cover.ι_glueMorphisms 𝒰₁₂ σ_loc h_glue
    have hσ_hom : σ ≫ P_N.hom =
        CategoryTheory.Limits.pullback.fst P₁.hom P₂.hom ≫ P₁.hom := by
      refine AlgebraicGeometry.Scheme.Cover.hom_ext 𝒰₁₂ _ _ fun ij₀ => ?_
      let ij : Fin (N₁ + 1) × Fin (N₂ + 1) := ij₀
      rw [← CategoryTheory.Category.assoc, hσ_loc ij₀]
      change ((θ ij).hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ ij)) ≫
        w_N (e.symm ij)) ≫ P_N.hom = _
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hw_hom,
        ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      have hcomp1 : (φ ij).comp (algebraMap k (C (e.symm ij))) =
          Algebra.TensorProduct.includeLeftRingHom.comp (algebraMap k (A ij.1)) := by
        ext c
        rw [RingHom.comp_apply, hφ_alg ij c, RingHom.comp_apply]
        exact ((Algebra.TensorProduct.includeLeft : A ij.1 →ₐ[k]
          TensorProduct k (A ij.1) (B ij.2)).commutes c).symm
      rw [hcomp1, CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp,
        ← CategoryTheory.Category.assoc, hθ_fst ij, ← hu_hom ij.1,
        ← CategoryTheory.Category.assoc]
      exact (congrArg (· ≫ P₁.hom) (h𝒰₁₂_fst ij₀).symm).trans
        (CategoryTheory.Category.assoc _ _ _)
    have h_eqToHom_w : ∀ {ν₁ ν₂ : Fin (N + 1)} (h : ν₁ = ν₂),
        CategoryTheory.eqToHom
            (congrArg (fun ν => AlgebraicGeometry.Spec (CommRingCat.of (C ν))) h) ≫
          w_N ν₂ = w_N ν₁ := by
      rintro _ _ rfl
      simp
    have hCl_σ : AlgebraicGeometry.IsClosedImmersion σ := by
      rw [AlgebraicGeometry.IsZariskiLocalAtTarget.iff_of_openCover
        (P := @AlgebraicGeometry.IsClosedImmersion) 𝒰_N]
      intro ν₀_idx
      let ν₀ : Fin (N + 1) := ν₀_idx
      let ij₀ : Fin (N₁ + 1) × Fin (N₂ + 1) := e ν₀
      have he_ij₀ : e.symm ij₀ = ν₀ := e.symm_apply_apply ν₀
      have hOpen_w : AlgebraicGeometry.IsOpenImmersion (w_N ν₀) := 𝒰_N.map_prop ν₀_idx
      have hOpen_f : AlgebraicGeometry.IsOpenImmersion (𝒰₁₂.f ij₀) := 𝒰₁₂.map_prop ij₀
      have _ := hOpen_w
      have _ := hOpen_f
      let eqIso₀ : AlgebraicGeometry.Spec (CommRingCat.of (C (e.symm ij₀))) ≅
