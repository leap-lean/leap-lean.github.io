      let q₁ := CategoryTheory.Limits.pullback.lift (pL ≫ fst_ij) (pR ≫ fst_i'j') h_cond1 ≫
        (AlgebraicGeometry.Proj.pullbackAwayιIso 𝒜₁ (hX₁ i) zero_lt_one (hX₁ i') zero_lt_one rfl).hom
      let q₂ := CategoryTheory.Limits.pullback.lift (pL ≫ snd_ij) (pR ≫ snd_i'j') h_cond2 ≫
        (AlgebraicGeometry.Proj.pullbackAwayιIso 𝒜₂ (hX₂ j) zero_lt_one (hX₂ j') zero_lt_one rfl).hom
      have hq₁_L : q₁ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom awayL₁.toRingHom) =
