        rw [← ((hHomLoc N).2 ν').2, Subring.closure_le]
        rintro _ (⟨c, rfl⟩ | ⟨μ, rfl⟩)
        · change ψ_ov (awayR_N (algebraMap k (C ν') c)) = τ_R (φ i'j' (algebraMap k (C ν') c))
          have h_aw : awayR_N (algebraMap k (C ν') c) = algebraMap k C₂ c :=
            HomogeneousLocalization.awayMap_fromZeroRingHom 𝒜_N (hX_N ν) (mul_comm _ _)
