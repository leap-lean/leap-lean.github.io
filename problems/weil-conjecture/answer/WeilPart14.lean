        rw [hL, hComm₀, hR, hComm_θ, ← Category.assoc, ← hSpec_φ, Category.assoc]
      have h_hom : CommRingCat.ofHom (ψ_et.comp MvPolynomial.C) =
          CommRingCat.ofHom (φ.comp (θ.comp MvPolynomial.C)) := by
