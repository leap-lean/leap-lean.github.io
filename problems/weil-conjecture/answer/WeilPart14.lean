    have hx_ndvd : ∀ i₁ ∈ I₁, ∀ i₂ ∈ I₁, i₁ ≠ i₂ → ¬ (x i₂ ∣ x i₁) :=
      fun i₁ _ i₂ hi₂ hne => hNdvd₁ i₁ i₂ hne (hVan₁ i₂ hi₂)
    have hy_ndvd : ∀ j₁ ∈ I₂, ∀ j₂ ∈ I₂, j₁ ≠ j₂ → ¬ (y j₂ ∣ y j₁) :=
      fun j₁ _ j₂ hj₂ hne => hNdvd₂ j₁ j₂ hne (hVan₂ j₂ hj₂)
    have hxy := hTrans φ₁ φ₂ I₁ I₂ hEt₂ hVan₁ hVan₂ (fun _ hv => hSetEq ▸ hv)
    have hyx := hTrans φ₂ φ₁ I₂ I₁ hEt₁ hVan₂ hVan₁ (fun _ hv => hSetEq.symm ▸ hv)
    exact le_antisymm
      (hCardLe d L x y I₁ I₂ hx_unit hx_ndvd hxy hyx)
      (hCardLe d L y x I₂ I₁ hy_unit hy_ndvd hyx hxy)

theorem weil_vanishingIdeal_etale_mvPolynomial_quotient_roof (k : Type u) [Field k] (m b : ℕ) (hb : b + 1 ≤ m)
    (S' : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.LocallyOfFiniteType S'.hom]
    (C : Set S'.left) (hClosedC : IsClosed C)
    (y : (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal ⟨C, hClosedC⟩).subscheme)
    (R' : CommRingCat.{u}) (v₀ : AlgebraicGeometry.Spec R')
    (e_S : AlgebraicGeometry.Spec R' ⟶ S'.left)
    (ψ : MvPolynomial (Fin (m + 1)) k →+* R')
    (I_nc : Finset (Fin (m + 1)))
    (hEt_e : AlgebraicGeometry.Etale e_S)
    (hEt_ψ : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)))
    (hv₀ : e_S.base v₀ =
      (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal ⟨C, hClosedC⟩).subschemeι.base y)
    (hComm : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = e_S ≫ S'.hom)
    (hCard : I_nc.card = b + 2)
    (hPreC : e_S.base ⁻¹' C =
      {v : AlgebraicGeometry.Spec R' | ∀ j ∈ I_nc, ψ (MvPolynomial.X j) ∈ v.asIdeal}) :
    ∃ (R'_Y : CommRingCat.{u}) (w₀ : AlgebraicGeometry.Spec R'_Y)
      (e_Y : AlgebraicGeometry.Spec R'_Y ⟶
        (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal ⟨C, hClosedC⟩).subscheme)
      (ψ_Y : MvPolynomial (Fin (m - 1 - b)) k →+* R'_Y),
      AlgebraicGeometry.Etale e_Y ∧
      AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_Y)) ∧
      e_Y.base w₀ = y ∧
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_Y) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) =
        e_Y ≫ (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal ⟨C, hClosedC⟩).subschemeι ≫ S'.hom) :=
by
  
  have hLocalEtaleRed :
      ∀ (A B₀ : Type u) [CommRing A] [_root_.IsReduced A] [IsNoetherianRing A]
        [CommRing B₀] [Algebra A B₀] [Algebra.Etale A B₀],
        _root_.IsReduced B₀ := by
    intro A B₀ _ _ _ _ _ _
    have hFieldFiber :
        ∀ (F₀ : Type u) [Field F₀] [Algebra A F₀] (x : B₀),
          IsNilpotent x → (x ⊗ₜ[A] (1 : F₀) : TensorProduct A B₀ F₀) = 0 := by
      intro F₀ _ _ x hx
      have _ : Algebra.Etale F₀ (TensorProduct A F₀ B₀) := Algebra.Etale.baseChange A B₀ F₀
      have _ : _root_.IsReduced (TensorProduct A F₀ B₀) :=
        Algebra.FormallyUnramified.isReduced_of_field F₀ (TensorProduct A F₀ B₀)
      have hNil : IsNilpotent ((1 : F₀) ⊗ₜ[A] x : TensorProduct A F₀ B₀) := by
        change IsNilpotent ((Algebra.TensorProduct.includeRight : B₀ →ₐ[A] TensorProduct A F₀ B₀) x)
        exact hx.map _
      have hZero : ((1 : F₀) ⊗ₜ[A] x : TensorProduct A F₀ B₀) = 0 := hNil.eq_zero
      simpa using congrArg (TensorProduct.comm A F₀ B₀) hZero
    refine ⟨fun b₀ hb₀ => ?_⟩
    let M_min : Set (Ideal A) := (⊥ : Ideal A).minimalPrimes
    let _ : Fintype ↥M_min := (Ideal.finite_minimalPrimes_of_isNoetherianRing A ⊥).fintype
    let _ : DecidableEq ↥M_min := Classical.decEq ↥M_min
    have _ : ∀ p : ↥M_min, IsDomain (A ⧸ p.1) :=
      fun p => (Ideal.Quotient.isDomain_iff_prime p.1).mpr p.2.1.1
    let K : ↥M_min → Type u := fun p => FractionRing (A ⧸ p.1)
    let δ : A →ₗ[A] (∀ p : ↥M_min, K p) :=
      LinearMap.pi fun p => Algebra.linearMap A (K p)
    have hInj_δ : Function.Injective δ := by
      rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
      intro a ha
      have ha_min : ∀ p : ↥M_min, a ∈ p.1 := by
        intro p
        have hap : algebraMap A (K p) a = 0 := congrFun ha p
        rw [IsScalarTower.algebraMap_apply A (A ⧸ p.1) (K p)] at hap
        have hmk0 : Ideal.Quotient.mk p.1 a = 0 :=
          (IsFractionRing.injective (A ⧸ p.1) (K p)).eq_iff.mp (hap.trans (map_zero _).symm)
        exact Ideal.Quotient.eq_zero_iff_mem.mp hmk0
      have ha_nil : a ∈ nilradical A := by
        rw [nilradical_eq_sInf A, Ideal.mem_sInf]
        intro q hq
        have _ : q.IsPrime := hq
        obtain ⟨p₀, hp₀_min, hp₀_le⟩ :=
          @Ideal.exists_minimalPrimes_le A _ ⊥ q hq bot_le
        exact hp₀_le (ha_min ⟨p₀, hp₀_min⟩)
      exact (mem_nilradical.mp ha_nil).eq_zero
    let e_pi : TensorProduct A B₀ (∀ p : ↥M_min, K p) ≃ₗ[A] (∀ p : ↥M_min, TensorProduct A B₀ (K p)) :=
      TensorProduct.piRight A A B₀ K
    have hPiZero : e_pi (b₀ ⊗ₜ[A] δ 1) = 0 := by
      ext p
      have hEval : e_pi (b₀ ⊗ₜ[A] δ 1) p = b₀ ⊗ₜ[A] (δ 1 p) := rfl
      rw [hEval]
      change b₀ ⊗ₜ[A] (algebraMap A (K p) 1) = 0
      rw [map_one]
      exact hFieldFiber (K p) b₀ hb₀
    have hTmulδ : (b₀ ⊗ₜ[A] δ 1 : TensorProduct A B₀ (∀ p : ↥M_min, K p)) = 0 :=
      e_pi.injective (hPiZero.trans (map_zero e_pi).symm)
    have _ : Module.Flat A B₀ := Algebra.Smooth.flat A B₀
    have hInj_lTensor : Function.Injective (LinearMap.lTensor B₀ δ) :=
      (Module.Flat.iff_lTensor_preserves_injective_linearMapₛ (R := A) (M := B₀)).mp
        inferInstance δ hInj_δ
    have hTmul1 : (b₀ ⊗ₜ[A] (1 : A) : TensorProduct A B₀ A) = 0 := by
      apply hInj_lTensor
      rw [LinearMap.lTensor_tmul, map_zero]
      exact hTmulδ
    have hRid := congrArg (TensorProduct.rid A B₀) hTmul1
    simpa [TensorProduct.rid_tmul] using hRid
  have hRingHomEtaleRed :
      ∀ {A B₀ : Type u} [CommRing A] [_root_.IsReduced A] [IsNoetherianRing A]
        [CommRing B₀] (φ : A →+* B₀), φ.Etale → _root_.IsReduced B₀ := by
    intro A B₀ _ _ _ _ φ hφ
    let _ : Algebra A B₀ := φ.toAlgebra
    have _ : Algebra.Etale A B₀ := RingHom.etale_algebraMap.mp hφ
    exact hLocalEtaleRed A B₀
  
  have hSpecEtaleRed :
      ∀ (E : AlgebraicGeometry.Scheme.{u})
        [AlgebraicGeometry.IsReduced E] [AlgebraicGeometry.IsLocallyNoetherian E]
        (B : CommRingCat.{u}) (f : AlgebraicGeometry.Spec B ⟶ E),
        AlgebraicGeometry.Etale f → _root_.IsReduced B := by
    intro E _ _ B f hEt
    refine ⟨fun c hc => ?_⟩
    let W : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec B
    let s : ↑(W.presheaf.obj (Opposite.op ⊤)) := (AlgebraicGeometry.Scheme.ΓSpecIso B).inv.hom c
    have hs : IsNilpotent s := hc.map (AlgebraicGeometry.Scheme.ΓSpecIso B).inv.hom
    have hLocalZero : ∀ z : ↥W, ∃ V_z : W.Opens,
        z ∈ V_z ∧ (W.presheaf.map (CategoryTheory.homOfLE (le_top : V_z ≤ ⊤)).op).hom s = 0 := by
      intro z
      obtain ⟨U_z, hAffU, hzU, _⟩ :=
        (TopologicalSpace.Opens.isBasis_iff_nbhd.mp E.isBasis_affineOpens)
          (show f.base z ∈ (⊤ : E.Opens) from trivial)
      obtain ⟨V_z, hAffV, hzV, hle_z⟩ :=
        (TopologicalSpace.Opens.isBasis_iff_nbhd.mp W.isBasis_affineOpens)
          (show z ∈ f ⁻¹ᵁ U_z from hzU)
      let A_z := ↑(E.presheaf.obj (Opposite.op U_z))
      let B_z := ↑(W.presheaf.obj (Opposite.op V_z))
      have _ : _root_.IsReduced A_z := @AlgebraicGeometry.IsReduced.component_reduced E _ U_z
      have _ : IsNoetherianRing A_z :=
        @AlgebraicGeometry.IsLocallyNoetherian.component_noetherian E _ ⟨U_z, hAffU⟩
      have hEt_app : RingHom.Etale (f.appLE U_z V_z hle_z).hom :=
        (AlgebraicGeometry.HasRingHomProperty.iff_appLE (P := @AlgebraicGeometry.Etale)).mp
          hEt ⟨U_z, hAffU⟩ ⟨V_z, hAffV⟩ hle_z
      have _ : _root_.IsReduced B_z := hRingHomEtaleRed (f.appLE U_z V_z hle_z).hom hEt_app
      let res_z := (W.presheaf.map (CategoryTheory.homOfLE (le_top : V_z ≤ ⊤)).op).hom
      exact ⟨V_z, hzV, (hs.map res_z).eq_zero⟩
    choose V_z hzV hsV using hLocalZero
    have hCov : (⊤ : W.Opens) ≤ ⨆ z : ↥W, V_z z :=
      fun z _ => TopologicalSpace.Opens.mem_iSup.mpr ⟨z, hzV z⟩
    have hs0 : s = 0 :=
      TopCat.Sheaf.eq_of_locally_eq' W.sheaf V_z ⊤ (fun z => CategoryTheory.homOfLE le_top) hCov
        s 0 (fun z => by
          change (W.presheaf.map (CategoryTheory.homOfLE (le_top : V_z z ≤ ⊤)).op).hom s =
            (W.presheaf.map (CategoryTheory.homOfLE (le_top : V_z z ≤ ⊤)).op).hom 0
          rw [map_zero]
          exact hsV z)
    have hc0 := congrArg (AlgebraicGeometry.Scheme.ΓSpecIso B).hom.hom hs0
    rw [map_zero] at hc0
    simpa [s, ← CommRingCat.comp_apply] using hc0
  
  let Z_cl : TopologicalSpace.Closeds ↥S'.left := ⟨C, hClosedC⟩
  let ℐ : S'.left.IdealSheafData := AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal Z_cl
  have hRange_ι : Set.range ℐ.subschemeι.base = C := by
    rw [AlgebraicGeometry.Scheme.IdealSheafData.range_subschemeι,
      AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal]
    rfl
  have hSupp_ℐ : ℐ.support = Z_cl := by
    apply SetLike.coe_injective
    exact AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal Z_cl
  have hRad_ℐ : ℐ.radical = ℐ := by
    rw [← AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal_support, hSupp_ℐ]
  have hRedY : AlgebraicGeometry.IsReduced ℐ.subscheme := by
    have hChartRed : ∀ U : ↥S'.left.affineOpens,
        AlgebraicGeometry.IsReduced
          (AlgebraicGeometry.Spec (CommRingCat.of
            (↑(S'.left.presheaf.obj (Opposite.op U.1)) ⧸ ℐ.ideal U))) := by
      intro U
      have hEqRad : (ℐ.ideal U).radical = ℐ.ideal U := by
        rw [← AlgebraicGeometry.Scheme.IdealSheafData.radical_ideal, hRad_ℐ]
      have hIsRadU : (ℐ.ideal U).IsRadical := by
        rw [← hEqRad]
        exact Ideal.radical_isRadical (ℐ.ideal U)
      have _ : _root_.IsReduced (↑(S'.left.presheaf.obj (Opposite.op U.1)) ⧸ ℐ.ideal U) :=
        (Ideal.isRadical_iff_quotient_reduced (ℐ.ideal U)).mp hIsRadU
      infer_instance
    exact @AlgebraicGeometry.IsReduced.of_openCover ℐ.subscheme ℐ.subschemeCover.openCover hChartRed
  have _ : AlgebraicGeometry.IsLocallyNoetherian S'.left :=
    AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian S'.hom
  have hNoethY : AlgebraicGeometry.IsLocallyNoetherian ℐ.subscheme :=
    AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian ℐ.subschemeι
  have _ : AlgebraicGeometry.Etale e_S := hEt_e
  let P := CategoryTheory.Limits.pullback ℐ.subschemeι e_S
  let fst : P ⟶ ℐ.subscheme := CategoryTheory.Limits.pullback.fst ℐ.subschemeι e_S
  let snd : P ⟶ AlgebraicGeometry.Spec R' := CategoryTheory.Limits.pullback.snd ℐ.subschemeι e_S
  have hCl_snd : AlgebraicGeometry.IsClosedImmersion snd := inferInstance
  have _ : AlgebraicGeometry.Etale fst := inferInstance
  obtain ⟨I, e_iso, he_snd⟩ := AlgebraicGeometry.IsClosedImmersion.Spec_iff.mp hCl_snd
  let e_Y : AlgebraicGeometry.Spec (CommRingCat.of (↥R' ⧸ I)) ⟶ ℐ.subscheme := e_iso.inv ≫ fst
  have hEt_eY : AlgebraicGeometry.Etale e_Y := inferInstance
  obtain ⟨p₀, hp₀_fst, _⟩ :=
    AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y v₀ hv₀.symm
  let w₀ : AlgebraicGeometry.Spec (CommRingCat.of (↥R' ⧸ I)) := e_iso.hom.base p₀
  have hw₀ : e_Y.base w₀ = y := by
    change (e_iso.hom ≫ e_iso.inv ≫ fst).base p₀ = y
    rw [e_iso.hom_inv_id_assoc]
    exact hp₀_fst
  have hComm_I :
      e_Y ≫ ℐ.subschemeι =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) ≫ e_S := by
    dsimp [e_Y, fst]
    rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition]
    have he_snd' : CategoryTheory.Limits.pullback.snd ℐ.subschemeι e_S =
        e_iso.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) := he_snd
    rw [reassoc_of% he_snd', e_iso.inv_hom_id_assoc]
  have hZero_I :
      (PrimeSpectrum.zeroLocus (I : Set R') : Set (AlgebraicGeometry.Spec R')) =
        e_S.base ⁻¹' C := by
    have hRange_snd : Set.range ⇑snd = e_S.base ⁻¹' C := by
      rw [AlgebraicGeometry.Scheme.Pullback.range_snd, hRange_ι]
    have hSurj_iso : Function.Surjective ⇑e_iso.hom :=
      Function.RightInverse.surjective (g := ⇑e_iso.inv) fun z => by
        change (e_iso.inv ≫ e_iso.hom) z = z
        rw [e_iso.inv_hom_id]
        rfl
    have hZero_mk :
        (PrimeSpectrum.zeroLocus (I : Set R') : Set (PrimeSpectrum ↥R')) =
          Set.range (PrimeSpectrum.comap (Ideal.Quotient.mk I)) := by
      rw [range_comap_of_surjective (↥R' ⧸ I) (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective,
        Ideal.mk_ker]
    change (PrimeSpectrum.zeroLocus (I : Set R') : Set (PrimeSpectrum ↥R')) = e_S.base ⁻¹' C
    rw [← hRange_snd, hZero_mk]
    ext v
    simp only [Set.mem_range]
    constructor
    · rintro ⟨w, rfl⟩
      obtain ⟨p, rfl⟩ := hSurj_iso w
      refine ⟨p, ?_⟩
      rw [he_snd]
      change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))) (e_iso.hom p) = _
      exact AlgebraicGeometry.Spec.map_apply (CommRingCat.ofHom (Ideal.Quotient.mk I)) (e_iso.hom p)
    · rintro ⟨p, rfl⟩
      refine ⟨e_iso.hom p, ?_⟩
      rw [he_snd]
      change _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))) (e_iso.hom p)
      exact (AlgebraicGeometry.Spec.map_apply (CommRingCat.ofHom (Ideal.Quotient.mk I)) (e_iso.hom p)).symm
  have hRed_quotI : _root_.IsReduced (↥R' ⧸ I) :=
    hSpecEtaleRed ℐ.subscheme (CommRingCat.of (↥R' ⧸ I)) e_Y hEt_eY
  have hRad_I : I.IsRadical := (Ideal.isRadical_iff_quotient_reduced I).mpr hRed_quotI
  
  let J₀ : Ideal (MvPolynomial (Fin (m + 1)) k) :=
    Ideal.span (MvPolynomial.X '' (I_nc : Set (Fin (m + 1))))
  let I_compl : Finset (Fin (m + 1)) := Finset.univ \ I_nc
  have hCardCompl : Fintype.card (Fin (m - 1 - b)) = Fintype.card ↥I_compl := by
    rw [Fintype.card_fin, Fintype.card_coe]
    have hSub : I_nc ⊆ Finset.univ := Finset.subset_univ I_nc
    have hSdiff := Finset.card_sdiff_of_subset hSub
    rw [Finset.card_univ, Fintype.card_fin, hCard] at hSdiff
    dsimp [I_compl]
    omega
  let e_idx : Fin (m - 1 - b) ≃ ↥I_compl := Fintype.equivOfCardEq hCardCompl
  let π_kill : MvPolynomial (Fin (m + 1)) k →ₐ[k] MvPolynomial (Fin (m - 1 - b)) k :=
    MvPolynomial.aeval fun j =>
      if hj : j ∈ I_compl then MvPolynomial.X (e_idx.symm ⟨j, hj⟩) else 0
  let ι_ren : MvPolynomial (Fin (m - 1 - b)) k →ₐ[k] MvPolynomial (Fin (m + 1)) k :=
    MvPolynomial.rename fun i => (e_idx i).1
  have hCompId : π_kill.comp ι_ren = AlgHom.id k (MvPolynomial (Fin (m - 1 - b)) k) := by
    apply MvPolynomial.algHom_ext
    intro i
    dsimp only [AlgHom.comp_apply, AlgHom.id_apply, ι_ren, π_kill]
    rw [MvPolynomial.rename_X, MvPolynomial.aeval_X]
    simp [(e_idx i).2]
  have hModJ₀ :
      (Ideal.Quotient.mkₐ k J₀).comp (ι_ren.comp π_kill) = Ideal.Quotient.mkₐ k J₀ := by
    apply MvPolynomial.algHom_ext
    intro j
    dsimp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk, ι_ren, π_kill]
    rw [MvPolynomial.aeval_X]
    by_cases hj : j ∈ I_compl
    · simp [hj]
    · simp only [hj, ↓reduceDIte, map_zero]
      have hj_nc : j ∈ I_nc := by
        simpa [I_compl, Finset.mem_sdiff] using hj
      symm
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨j, hj_nc, rfl⟩)
  have hJ₀_le_ker : J₀ ≤ RingHom.ker π_kill.toRingHom := by
    rw [Ideal.span_le]
    rintro _ ⟨j, hj_nc_set, rfl⟩
    have hj_nc : j ∈ I_nc := Finset.mem_coe.mp hj_nc_set
    have hj_not : j ∉ I_compl := by
      simp [I_compl, hj_nc]
    change π_kill (MvPolynomial.X j) = 0
    dsimp only [π_kill]
    rw [MvPolynomial.aeval_X]
    simp [hj_not]
  let Φ_hom : (MvPolynomial (Fin (m + 1)) k ⧸ J₀) →+* MvPolynomial (Fin (m - 1 - b)) k :=
    Ideal.Quotient.lift J₀ π_kill.toRingHom hJ₀_le_ker
  let Φ_inv : MvPolynomial (Fin (m - 1 - b)) k →+* (MvPolynomial (Fin (m + 1)) k ⧸ J₀) :=
    (Ideal.Quotient.mk J₀).comp ι_ren.toRingHom
  have hLeftInv_Φ : Function.LeftInverse Φ_inv Φ_hom := by
    intro x
    obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective x
    have hEqMk := AlgHom.congr_fun hModJ₀ f
    simpa [Φ_inv, Φ_hom, Ideal.Quotient.mkₐ_eq_mk] using hEqMk
  have hRightInv_Φ : Function.RightInverse Φ_inv Φ_hom := by
    intro g
    have hEqId := AlgHom.congr_fun hCompId g
    simpa [Φ_inv, Φ_hom] using hEqId
  let Φ_ring : (MvPolynomial (Fin (m + 1)) k ⧸ J₀) ≃+* MvPolynomial (Fin (m - 1 - b)) k :=
    { Φ_hom with
      invFun := Φ_inv
      left_inv := hLeftInv_Φ
      right_inv := hRightInv_Φ }
  have hΦ_symm_C :
      ∀ c : k, Φ_ring.symm (MvPolynomial.C c) = Ideal.Quotient.mk J₀ (MvPolynomial.C c) := by
    intro c
    change Ideal.Quotient.mk J₀ (ι_ren (MvPolynomial.C c)) = Ideal.Quotient.mk J₀ (MvPolynomial.C c)
    dsimp only [ι_ren]
    rw [MvPolynomial.rename_C]
  let J_nc : Ideal R' := Ideal.map ψ J₀
  have hZero_J :
      (PrimeSpectrum.zeroLocus (J_nc : Set R') : Set (AlgebraicGeometry.Spec R')) =
        {v : AlgebraicGeometry.Spec R' | ∀ j ∈ I_nc, ψ (MvPolynomial.X j) ∈ v.asIdeal} := by
    ext v
    change J_nc ≤ v.asIdeal ↔ ∀ j ∈ I_nc, ψ (MvPolynomial.X j) ∈ v.asIdeal
    dsimp [J_nc, J₀]
    rw [Ideal.map_span, Ideal.span_le]
    simp [Set.subset_def]
  let ψ_bar : (MvPolynomial (Fin (m + 1)) k ⧸ J₀) →+* (↥R' ⧸ J_nc) :=
    Ideal.quotientMap J_nc ψ Ideal.le_comap_map
  let ψ_Y : MvPolynomial (Fin (m - 1 - b)) k →+* (↥R' ⧸ J_nc) :=
    ψ_bar.comp Φ_ring.symm.toRingHom
  have hAlg_ψY : ψ_Y.comp MvPolynomial.C = (Ideal.Quotient.mk J_nc).comp (ψ.comp MvPolynomial.C) := by
    ext c
    dsimp only [RingHom.comp_apply, ψ_Y, ψ_bar]
    change Ideal.quotientMap J_nc ψ Ideal.le_comap_map (Φ_ring.symm (MvPolynomial.C c)) = _
    rw [hΦ_symm_C c, Ideal.quotientMap_mk]
  have hEtaleOfFactor :
      ∀ {R₀ S₀ T₀ : Type u} [CommRing R₀] [CommRing S₀] [CommRing T₀]
        (f : R₀ →+* S₀) (h : R₀ →+* T₀) (e : S₀ ≃ T₀),
        (∀ x y : S₀, e (x * y) = e x * e y) →
        (∀ x y : S₀, e (x + y) = e x + e y) →
        (∀ r : R₀, e (f r) = h r) →
        f.Etale → h.Etale := by
    intro R₀ S₀ T₀ _ _ _ f h e hmul hadd hcomp hf
    let e_ring : S₀ ≃+* T₀ := { e with map_mul' := hmul, map_add' := hadd }
    have hEq : e_ring.toRingHom.comp f = h := by
      ext r
      exact hcomp r
    rw [← hEq]
    exact RingHom.Etale.respectsIso.left f e_ring hf
  have hQuotMapEtale :
      ∀ (A₀ : Type u) [CommRing A₀] [Algebra (MvPolynomial (Fin (m + 1)) k) A₀]
        [Algebra.Etale (MvPolynomial (Fin (m + 1)) k) A₀],
        RingHom.Etale (Ideal.quotientMap
          (Ideal.map (algebraMap (MvPolynomial (Fin (m + 1)) k) A₀) J₀)
          (algebraMap (MvPolynomial (Fin (m + 1)) k) A₀) Ideal.le_comap_map) := by
    intro A₀ _ _ _
    have _ : Algebra.Etale (MvPolynomial (Fin (m + 1)) k ⧸ J₀)
        (TensorProduct (MvPolynomial (Fin (m + 1)) k)
          (MvPolynomial (Fin (m + 1)) k ⧸ J₀) A₀) :=
      Algebra.Etale.baseChange (MvPolynomial (Fin (m + 1)) k) A₀
        (MvPolynomial (Fin (m + 1)) k ⧸ J₀)
    have hAlgEt :
        (algebraMap (MvPolynomial (Fin (m + 1)) k ⧸ J₀)
          (TensorProduct (MvPolynomial (Fin (m + 1)) k)
            (MvPolynomial (Fin (m + 1)) k ⧸ J₀) A₀)).Etale :=
      RingHom.etale_algebraMap.mpr inferInstance
    let e_raw :=
      ((Algebra.TensorProduct.quotIdealMapEquivTensorQuot A₀ J₀).toRingEquiv).trans
        (Algebra.TensorProduct.comm (MvPolynomial (Fin (m + 1)) k) A₀
          (MvPolynomial (Fin (m + 1)) k ⧸ J₀)).toRingEquiv
    refine hEtaleOfFactor
      (algebraMap (MvPolynomial (Fin (m + 1)) k ⧸ J₀)
        (TensorProduct (MvPolynomial (Fin (m + 1)) k)
          (MvPolynomial (Fin (m + 1)) k ⧸ J₀) A₀))
      (Ideal.quotientMap
        (Ideal.map (algebraMap (MvPolynomial (Fin (m + 1)) k) A₀) J₀)
        (algebraMap (MvPolynomial (Fin (m + 1)) k) A₀) Ideal.le_comap_map)
      e_raw.symm.toEquiv
      (fun x y => map_mul e_raw.symm x y)
      (fun x y => map_add e_raw.symm x y)
      (fun x => ?_)
      hAlgEt
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
    apply e_raw.injective
    change e_raw (e_raw.symm ((algebraMap (MvPolynomial (Fin (m + 1)) k ⧸ J₀)
        (TensorProduct (MvPolynomial (Fin (m + 1)) k)
          (MvPolynomial (Fin (m + 1)) k ⧸ J₀) A₀)) (Ideal.Quotient.mk J₀ p))) =
      e_raw (Ideal.quotientMap
        (Ideal.map (algebraMap (MvPolynomial (Fin (m + 1)) k) A₀) J₀)
        (algebraMap (MvPolynomial (Fin (m + 1)) k) A₀) Ideal.le_comap_map
        (Ideal.Quotient.mk J₀ p))
    rw [e_raw.apply_symm_apply, Ideal.quotientMap_mk]
    symm
    dsimp only [e_raw, RingEquiv.trans_apply]
    change (Algebra.TensorProduct.comm (MvPolynomial (Fin (m + 1)) k) A₀
        (MvPolynomial (Fin (m + 1)) k ⧸ J₀))
      ((Algebra.TensorProduct.quotIdealMapEquivTensorQuot A₀ J₀)
        (Ideal.Quotient.mk (Ideal.map (algebraMap (MvPolynomial (Fin (m + 1)) k) A₀) J₀)
          (algebraMap (MvPolynomial (Fin (m + 1)) k) A₀ p))) = _
    rw [Algebra.TensorProduct.quotIdealMapEquivTensorQuot_mk]
    have h_smul :
        (algebraMap (MvPolynomial (Fin (m + 1)) k) A₀ p) ⊗ₜ[MvPolynomial (Fin (m + 1)) k]
          (1 : MvPolynomial (Fin (m + 1)) k ⧸ J₀) =
        (1 : A₀) ⊗ₜ[MvPolynomial (Fin (m + 1)) k] (Ideal.Quotient.mk J₀ p) := by
      have hpA : algebraMap (MvPolynomial (Fin (m + 1)) k) A₀ p = p • (1 : A₀) := by
        rw [Algebra.smul_def, mul_one]
      have hpQ : p • (1 : MvPolynomial (Fin (m + 1)) k ⧸ J₀) = Ideal.Quotient.mk J₀ p := by
        change Ideal.Quotient.mk J₀ p * 1 = Ideal.Quotient.mk J₀ p
        exact mul_one _
      rw [hpA, TensorProduct.smul_tmul, hpQ]
    rw [h_smul]
    rfl
  have hEt_ψ_ring : ψ.Etale :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hEt_ψ
  have hEt_ψbar : ψ_bar.Etale := by
    let _ : Algebra (MvPolynomial (Fin (m + 1)) k) ↥R' := ψ.toAlgebra
    have _ : Algebra.Etale (MvPolynomial (Fin (m + 1)) k) ↥R' :=
      RingHom.etale_algebraMap.mp hEt_ψ_ring
    exact hQuotMapEtale ↥R'
  have hEt_ψY_ring : ψ_Y.Etale :=
    RingHom.Etale.respectsIso.right ψ_bar Φ_ring.symm hEt_ψbar
  have hEt_ψY : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_Y)) :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hEt_ψY_ring
  have _ : _root_.IsReduced (MvPolynomial (Fin (m - 1 - b)) k) := by
    refine ⟨fun p ⟨n, hn⟩ => ?_⟩
    induction n with
    | zero =>
      rw [pow_zero] at hn
      exact absurd hn.symm zero_ne_one
    | succ n ih =>
      rw [pow_succ] at hn
      rcases mul_eq_zero.mp hn with h1 | h2
      · exact ih h1
      · exact h2
  have hRed_quotJ : _root_.IsReduced (↥R' ⧸ J_nc) :=
    hRingHomEtaleRed ψ_Y hEt_ψY_ring
  have hRad_J : J_nc.IsRadical := (Ideal.isRadical_iff_quotient_reduced J_nc).mpr hRed_quotJ
  
  have hZeroEq : PrimeSpectrum.zeroLocus (I : Set R') = PrimeSpectrum.zeroLocus (J_nc : Set R') :=
    hZero_I.trans (hPreC.trans hZero_J.symm)
  have hIJ : I = J_nc := by
    have hRadEq : I.radical = J_nc.radical :=
      (@PrimeSpectrum.zeroLocus_eq_iff ↥R' _ I J_nc).mp hZeroEq
    rwa [hRad_I.radical, hRad_J.radical] at hRadEq
  subst hIJ
  refine ⟨CommRingCat.of (↥R' ⧸ J_nc), w₀, e_Y, ψ_Y, hEt_eY, hEt_ψY, hw₀, ?_⟩
  calc
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_Y) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C)
        = AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom MvPolynomial.C ≫ CommRingCat.ofHom ψ_Y) :=
          (AlgebraicGeometry.Spec.map_comp _ _).symm
    _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_Y.comp MvPolynomial.C)) := by
          rw [← CommRingCat.ofHom_comp]
    _ = AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk J_nc).comp (ψ.comp MvPolynomial.C))) := by
          rw [hAlg_ψY]
    _ = AlgebraicGeometry.Spec.map
          ((CommRingCat.ofHom MvPolynomial.C ≫ CommRingCat.ofHom ψ) ≫
            CommRingCat.ofHom (Ideal.Quotient.mk J_nc)) := by
          rw [CommRingCat.ofHom_comp, CommRingCat.ofHom_comp]
    _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J_nc)) ≫
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C)) := by
          rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp]
    _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J_nc)) ≫ e_S ≫ S'.hom := by
          rw [hComm]
    _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J_nc)) ≫ e_S) ≫ S'.hom := by
          rw [CategoryTheory.Category.assoc]
    _ = (e_Y ≫ ℐ.subschemeι) ≫ S'.hom := by
          rw [← hComm_I]
    _ = e_Y ≫ ℐ.subschemeι ≫ S'.hom := by
          rw [CategoryTheory.Category.assoc]

theorem weil_projective_locally_domain_disjoint_integral_components (k : Type u) [Field k] (d : ℕ)
    (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hProjY : IsProjectiveOverField k Y)
    (hSmY : AlgebraicGeometry.SmoothOfRelativeDimension d Y.hom)
    (hLocalDom : ∀ y : Y.left, ∃ U : Y.left.Opens,
      AlgebraicGeometry.IsAffineOpen U ∧ y ∈ U ∧ IsDomain ↑(Y.left.presheaf.obj (Opposite.op U))) :
    ∃ (s : ℕ) (C_comp : Fin s → AlgebraicGeometry.Scheme.{u})
      (j_C : ∀ β : Fin s, C_comp β ⟶ Y.left),
      (∀ β : Fin s, AlgebraicGeometry.IsClosedImmersion (j_C β)) ∧
      (∀ β : Fin s, AlgebraicGeometry.IsIntegral (C_comp β)) ∧
      (∀ β : Fin s, AlgebraicGeometry.SmoothOfRelativeDimension d (j_C β ≫ Y.hom)) ∧
      (_root_.Pairwise fun β₁ β₂ : Fin s =>
        Disjoint (Set.range (j_C β₁).base) (Set.range (j_C β₂).base)) ∧
      (⋃ β : Fin s, Set.range (j_C β).base) = Set.univ :=
by
  obtain ⟨M, ι_proj, hCl_proj⟩ := hProjY
  have _ : AlgebraicGeometry.IsClosedImmersion ι_proj.left := hCl_proj
  let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k
  let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
  have _ : IsScalarTower k (↥(𝒜 0)) (MvPolynomial (Fin (M + 1)) k) :=
    ⟨fun c x p => smul_mul_assoc c (x : MvPolynomial (Fin (M + 1)) k) p⟩
  have _ : Algebra.FiniteType (↥(𝒜 0)) (MvPolynomial (Fin (M + 1)) k) :=
    Algebra.FiniteType.of_restrictScalars_finiteType k (↥(𝒜 0)) (MvPolynomial (Fin (M + 1)) k)
  have h_surj : Function.Surjective (algebraMap k ↥(𝒜 0)) := by
    intro x
    have hx : (x : MvPolynomial (Fin (M + 1)) k) ∈
        (1 : Submodule k (MvPolynomial (Fin (M + 1)) k)) := by
      rw [← MvPolynomial.homogeneousSubmodule_zero (Fin (M + 1))]
      exact x.2
    obtain ⟨c, hc⟩ := Submodule.mem_one.mp hx
    refine ⟨c, Subtype.ext ?_⟩
    rw [Algebra.algebraMap_eq_smul_one]
    change c • (1 : MvPolynomial (Fin (M + 1)) k) = ↑x
    rwa [← Algebra.algebraMap_eq_smul_one]
  have _ : IsNoetherianRing ↥(𝒜 0) :=
    isNoetherianRing_of_surjective k (↥(𝒜 0)) (algebraMap k ↥(𝒜 0)) h_surj
  have _ : CompactSpace ↥(AlgebraicGeometry.Proj 𝒜) :=
    AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace
      (AlgebraicGeometry.Proj.toSpecZero 𝒜)
  have _ : AlgebraicGeometry.IsLocallyNoetherian (AlgebraicGeometry.Proj 𝒜) :=
    AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian
      (AlgebraicGeometry.Proj.toSpecZero 𝒜)
  have _ : AlgebraicGeometry.IsNoetherian (AlgebraicGeometry.Proj 𝒜) := {}
  have _ : TopologicalSpace.NoetherianSpace ↥(weilProjectiveSpaceOver k M).left := by
    change TopologicalSpace.NoetherianSpace ↥(AlgebraicGeometry.Proj 𝒜)
    exact AlgebraicGeometry.IsNoetherian.noetherianSpace
  have _ : TopologicalSpace.NoetherianSpace ↥Y.left :=
    ι_proj.left.isClosedEmbedding.toIsEmbedding.toIsInducing.noetherianSpace
  have hFinComp : (irreducibleComponents ↥Y.left).Finite :=
    TopologicalSpace.NoetherianSpace.finite_irreducibleComponents
  have _ : Finite ↥(irreducibleComponents ↥Y.left) := hFinComp.to_subtype
  obtain ⟨s, ⟨e_inv⟩⟩ := Finite.exists_equiv_fin ↥(irreducibleComponents ↥Y.left)
  let e_comp : Fin s ≃ ↥(irreducibleComponents ↥Y.left) := e_inv.symm
  let F : Fin s → Set Y.left := fun β => (e_comp β).1
  have hMax : ∀ β : Fin s, Maximal (fun x : Set Y.left => IsClosed x ∧ IsIrreducible x) (F β) := by
    intro β
    have hMem : F β ∈ irreducibleComponents ↥Y.left := (e_comp β).2
    rwa [irreducibleComponents_eq_maximals_closed] at hMem
  have hClosedF : ∀ β : Fin s, IsClosed (F β) := fun β => (hMax β).prop.1
  have hIrredF : ∀ β : Fin s, IsIrreducible (F β) := fun β => (hMax β).prop.2
  have hIncomp : _root_.Pairwise fun α β : Fin s => ¬ F α ⊆ F β := by
    intro α β hne hSub
    have hEqF : F α = F β := (hMax α).eq_of_le (hMax β).prop hSub
    exact hne (e_comp.injective (Subtype.ext hEqF))
  have hCovF : (⋃ β : Fin s, F β) = Set.univ := by
    refine Set.Subset.antisymm (Set.subset_univ _) ?_
    intro y _
    let c_y : ↥(irreducibleComponents ↥Y.left) :=
      ⟨irreducibleComponent y, irreducibleComponent_mem_irreducibleComponents y⟩
    refine Set.mem_iUnion.mpr ⟨e_inv c_y, ?_⟩
    have h_eq : F (e_inv c_y) = irreducibleComponent y :=
      congrArg Subtype.val (e_inv.symm_apply_apply c_y)
    rw [h_eq]
    exact mem_irreducibleComponent
  let U_loc : ↥Y.left → Y.left.Opens := fun y => Classical.choose (hLocalDom y)
  have hAff_loc : ∀ y : ↥Y.left, AlgebraicGeometry.IsAffineOpen (U_loc y) :=
    fun y => (Classical.choose_spec (hLocalDom y)).1
  have hy_loc : ∀ y : ↥Y.left, y ∈ U_loc y :=
    fun y => (Classical.choose_spec (hLocalDom y)).2.1
  have hDom_loc : ∀ y : ↥Y.left, IsDomain ↑(Y.left.presheaf.obj (Opposite.op (U_loc y))) :=
    fun y => (Classical.choose_spec (hLocalDom y)).2.2
  have hIrredU : ∀ y : ↥Y.left, IsIrreducible (U_loc y : Set Y.left) := by
    intro y
    let R_y := Y.left.presheaf.obj (Opposite.op (U_loc y))
    have _ : IsDomain ↑R_y := hDom_loc y
    have _ : AlgebraicGeometry.IsIntegral (AlgebraicGeometry.Spec R_y) := inferInstance
    have _ : IrreducibleSpace ↥(AlgebraicGeometry.Spec R_y) :=
      AlgebraicGeometry.irreducibleSpace_of_isIntegral (AlgebraicGeometry.Spec R_y)
    have hImg := (IrreducibleSpace.isIrreducible_univ ↥(AlgebraicGeometry.Spec R_y)).image
      (hAff_loc y).fromSpec.base (hAff_loc y).fromSpec.base.hom.continuous.continuousOn
    rw [Set.image_univ] at hImg
    change IsIrreducible (Set.range ⇑(hAff_loc y).fromSpec) at hImg
    rwa [(hAff_loc y).range_fromSpec] at hImg
  have hRedU : ∀ y : ↥Y.left, AlgebraicGeometry.IsReduced (U_loc y).toScheme := by
    intro y
    let R_y := Y.left.presheaf.obj (Opposite.op (U_loc y))
    have _ : IsDomain ↑R_y := hDom_loc y
    have _ : AlgebraicGeometry.IsIntegral (AlgebraicGeometry.Spec R_y) := inferInstance
    have _ : AlgebraicGeometry.IsReduced (AlgebraicGeometry.Spec R_y) := inferInstance
    exact AlgebraicGeometry.isReduced_of_isOpenImmersion (hAff_loc y).isoSpec.hom
  have hCovU : TopologicalSpace.IsOpenCover U_loc :=
    TopologicalSpace.IsOpenCover.mk
      (eq_top_iff.mpr fun y _ => TopologicalSpace.Opens.mem_iSup.mpr ⟨y, hy_loc y⟩)
  have hRedY : AlgebraicGeometry.IsReduced Y.left :=
    @AlgebraicGeometry.IsReduced.of_openCover Y.left
      (Y.left.openCoverOfIsOpenCover U_loc hCovU) hRedU
  have hSubExists : ∀ y : ↥Y.left, ∃ γ₀ : Fin s, (U_loc y : Set Y.left) ⊆ F γ₀ := by
    intro y
    classical
    let t : Finset (Set Y.left) := Finset.univ.image F
    have ht_closed : ∀ z ∈ t, IsClosed z := by
      intro z hz
      obtain ⟨γ, _, rfl⟩ := Finset.mem_image.mp hz
      exact hClosedF γ
    have ht_sub : (U_loc y : Set Y.left) ⊆ ⋃₀ (t : Set (Set Y.left)) := by
      have hUnion : ⋃₀ (t : Set (Set Y.left)) = Set.univ := by
        dsimp [t]
        rw [Finset.coe_image, Finset.coe_univ, Set.image_univ, Set.sUnion_range, hCovF]
      rw [hUnion]
      exact Set.subset_univ _
    obtain ⟨z, hz_mem, hSub_z⟩ :=
      (isIrreducible_iff_sUnion_isClosed.mp (hIrredU y)) t ht_closed ht_sub
    obtain ⟨γ₀, _, rfl⟩ := Finset.mem_image.mp hz_mem
    exact ⟨γ₀, hSub_z⟩
  have hEqComp : ∀ (y : ↥Y.left) (β γ₀ : Fin s),
      y ∈ F β → (U_loc y : Set Y.left) ⊆ F γ₀ → β = γ₀ := by
    intro y β γ₀ hyβ hSub
    by_contra hne
    have hNotSub : ¬ F β ⊆ F γ₀ := hIncomp hne
    obtain ⟨z, hzβ, hzNot⟩ := Set.not_subset.mp hNotSub
    have h1 : (F β ∩ (U_loc y : Set Y.left)).Nonempty := ⟨y, hyβ, hy_loc y⟩
    have h2 : (F β ∩ (F γ₀)ᶜ).Nonempty := ⟨z, hzβ, hzNot⟩
    obtain ⟨w, _, hwU, hwNot⟩ :=
      (hIrredF β).isPreirreducible (U_loc y : Set Y.left) (F γ₀)ᶜ
        (U_loc y).isOpen (hClosedF γ₀).isOpen_compl h1 h2
    exact hwNot (hSub hwU)
  have hOpenF : ∀ β : Fin s, IsOpen (F β) := by
    intro β
    rw [isOpen_iff_forall_mem_open]
    intro y hyβ
    obtain ⟨γ₀, hSub⟩ := hSubExists y
    have hEq : β = γ₀ := hEqComp y β γ₀ hyβ hSub
    subst hEq
    exact ⟨(U_loc y : Set Y.left), hSub, (U_loc y).isOpen, hy_loc y⟩
  have hDisjF : _root_.Pairwise fun β₁ β₂ : Fin s => Disjoint (F β₁) (F β₂) := by
    intro β₁ β₂ hne
    rw [Set.disjoint_left]
    intro y hy₁ hy₂
    obtain ⟨γ₀, hSub⟩ := hSubExists y
    have h1 : β₁ = γ₀ := hEqComp y β₁ γ₀ hy₁ hSub
    have h2 : β₂ = γ₀ := hEqComp y β₂ γ₀ hy₂ hSub
    exact hne (h1.trans h2.symm)
  let W : Fin s → Y.left.Opens := fun β => ⟨F β, hOpenF β⟩
  let C_comp : Fin s → AlgebraicGeometry.Scheme.{u} := fun β => (W β).toScheme
  let j_C : ∀ β : Fin s, C_comp β ⟶ Y.left := fun β => (W β).ι
  have hRange_jC : ∀ β : Fin s, Set.range (j_C β).base = F β := by
    intro β
    change Set.range ⇑(W β).ι = F β
    exact AlgebraicGeometry.Scheme.Opens.range_ι (W β)
  have hCl_jC : ∀ β : Fin s, AlgebraicGeometry.IsClosedImmersion (j_C β) := by
    intro β
    have hClRange : IsClosed (Set.range ⇑(W β).ι) := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι (W β)]
      exact hClosedF β
    exact AlgebraicGeometry.IsClosedImmersion.of_isPreimmersion (W β).ι hClRange
  have hInt_C : ∀ β : Fin s, AlgebraicGeometry.IsIntegral (C_comp β) := by
    intro β
    have _ : AlgebraicGeometry.IsReduced Y.left := hRedY
    have _ : AlgebraicGeometry.IsReduced (C_comp β) :=
      AlgebraicGeometry.isReduced_of_isOpenImmersion (W β).ι
    let e_homeo : ↥(C_comp β) ≃ₜ ↥(Set.range ⇑(W β).ι) :=
      (W β).ι.isOpenEmbedding.isEmbedding.toHomeomorph
    have hIrredRange : IsIrreducible (Set.range ⇑(W β).ι) := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι (W β)]
      exact hIrredF β
    have _ : IrreducibleSpace ↥(Set.range ⇑(W β).ι) := Subtype.irreducibleSpace hIrredRange
    have hIrredUniv : IsIrreducible (Set.univ : Set ↥(C_comp β)) := by
      have hImg := (IrreducibleSpace.isIrreducible_univ ↥(Set.range ⇑(W β).ι)).image
        e_homeo.symm e_homeo.symm.continuous.continuousOn
      rwa [Set.image_univ, e_homeo.symm.surjective.range_eq] at hImg
    have _ : IrreducibleSpace ↥(C_comp β) := by
      rw [irreducibleSpace_def]
      simpa only [Set.top_eq_univ] using hIrredUniv
    exact AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced (C_comp β)
  have hSm_jC : ∀ β : Fin s, AlgebraicGeometry.SmoothOfRelativeDimension d (j_C β ≫ Y.hom) := by
    intro β
    have _ : AlgebraicGeometry.SmoothOfRelativeDimension 0 (W β).ι := inferInstance
    have _ : AlgebraicGeometry.SmoothOfRelativeDimension d Y.hom := hSmY
    have hComp : AlgebraicGeometry.SmoothOfRelativeDimension (0 + d) ((W β).ι ≫ Y.hom) :=
      AlgebraicGeometry.smoothOfRelativeDimension_comp 0 d (W β).ι Y.hom
    rwa [Nat.zero_add] at hComp
  refine ⟨s, C_comp, j_C, hCl_jC, hInt_C, hSm_jC, ?_, ?_⟩
  · intro β₁ β₂ hne
    rw [hRange_jC β₁, hRange_jC β₂]
    exact hDisjF hne
  · simp_rw [hRange_jC]
    exact hCovF

theorem weil_etale_nc_chart_pullback_and_filter_away (k : Type u) [Field k] (d : ℕ)
    (S' : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (Z_nc : Set S'.left) :
    (∀ (x : S'.left)
        (R'₁ : CommRingCat.{u}) (v₁ : AlgebraicGeometry.Spec R'₁)
        (e₁ : AlgebraicGeometry.Spec R'₁ ⟶ S'.left)
        (ψ₁ : MvPolynomial (Fin d) k →+* R'₁) (I₁ : Finset (Fin d))
        (R'₂ : CommRingCat.{u}) (v₂ : AlgebraicGeometry.Spec R'₂)
        (e₂ : AlgebraicGeometry.Spec R'₂ ⟶ S'.left)
        (ψ₂ : MvPolynomial (Fin d) k →+* R'₂) (I₂ : Finset (Fin d)),
      AlgebraicGeometry.Etale e₁ →
      AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁)) →
      e₁.base v₁ = x →
      (∀ i ∈ I₁, ψ₁ (MvPolynomial.X i) ∈ v₁.asIdeal) →
      e₁.base ⁻¹' Z_nc = {v : AlgebraicGeometry.Spec R'₁ | ∃ i ∈ I₁, ψ₁ (MvPolynomial.X i) ∈ v.asIdeal} →
      AlgebraicGeometry.Etale e₂ →
      AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₂)) →
      e₂.base v₂ = x →
      (∀ j ∈ I₂, ψ₂ (MvPolynomial.X j) ∈ v₂.asIdeal) →
      e₂.base ⁻¹' Z_nc = {v : AlgebraicGeometry.Spec R'₂ | ∃ j ∈ I₂, ψ₂ (MvPolynomial.X j) ∈ v.asIdeal} →
      ∃ (B : Type u) (_ : CommRing B) (q₀ : PrimeSpectrum B)
        (φ₁ φ₂ : MvPolynomial (Fin d) k →+* B),
        φ₁.Etale ∧ φ₂.Etale ∧
        (∀ i ∈ I₁, φ₁ (MvPolynomial.X i) ∈ q₀.asIdeal) ∧
        (∀ j ∈ I₂, φ₂ (MvPolynomial.X j) ∈ q₀.asIdeal) ∧
        ({p : PrimeSpectrum B | ∃ i ∈ I₁, φ₁ (MvPolynomial.X i) ∈ p.asIdeal} =
          {p : PrimeSpectrum B | ∃ j ∈ I₂, φ₂ (MvPolynomial.X j) ∈ p.asIdeal})) ∧
    (∀ (R' : CommRingCat.{u}) (e_S : AlgebraicGeometry.Spec R' ⟶ S'.left)
        (ψ : MvPolynomial (Fin d) k →+* R') (I_nc : Finset (Fin d))
        (v : AlgebraicGeometry.Spec R'),
      AlgebraicGeometry.Etale e_S →
      AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) →
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = e_S ≫ S'.hom) →
      e_S.base ⁻¹' Z_nc = {w : AlgebraicGeometry.Spec R' | ∃ j ∈ I_nc, ψ (MvPolynomial.X j) ∈ w.asIdeal} →
      ∃ (R'_v : CommRingCat.{u}) (w₀ : AlgebraicGeometry.Spec R'_v)
        (e_v : AlgebraicGeometry.Spec R'_v ⟶ S'.left)
        (ψ_v : MvPolynomial (Fin d) k →+* R'_v)
        (I_v : Finset (Fin d)),
        I_v ⊆ I_nc ∧
        (∀ j ∈ I_nc, j ∈ I_v ↔ ψ (MvPolynomial.X j) ∈ v.asIdeal) ∧
        AlgebraicGeometry.Etale e_v ∧
        AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_v)) ∧
        e_v.base w₀ = e_S.base v ∧
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_v) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = e_v ≫ S'.hom) ∧
        (∀ j ∈ I_v, ψ_v (MvPolynomial.X j) ∈ w₀.asIdeal) ∧
        e_v.base ⁻¹' Z_nc = {w : AlgebraicGeometry.Spec R'_v | ∃ j ∈ I_v, ψ_v (MvPolynomial.X j) ∈ w.asIdeal}) :=
by
  constructor
  · intro x R'₁ v₁ e₁ ψ₁ I₁ R'₂ v₂ e₂ ψ₂ I₂
      hEt_e₁ hEt_ψ₁ hv₁ hVan₁ hPre₁ hEt_e₂ hEt_ψ₂ hv₂ hVan₂ hPre₂
    let P : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback e₁ e₂
    let fst : P ⟶ AlgebraicGeometry.Spec R'₁ := CategoryTheory.Limits.pullback.fst e₁ e₂
    let snd : P ⟶ AlgebraicGeometry.Spec R'₂ := CategoryTheory.Limits.pullback.snd e₁ e₂
    have hv₁₂ : e₁ v₁ = e₂ v₂ := hv₁.trans hv₂.symm
    obtain ⟨z, hz₁, hz₂⟩ :=
      AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback (f := e₁) (g := e₂) v₁ v₂ hv₁₂
    obtain ⟨B_cat, f_B, hOpen_fB, ⟨q₀_spec, hq₀_z⟩, _⟩ :=
      @AlgebraicGeometry.Scheme.exists_affine_mem_range_and_range_subset P z ⊤ trivial
    let B : Type u := ↑B_cat
    let q₀ : PrimeSpectrum B := q₀_spec
    have := hEt_e₁
    have := hEt_e₂
    have := hEt_ψ₁
    have := hEt_ψ₂
    have := hOpen_fB
    let f₁ : AlgebraicGeometry.Spec B_cat ⟶ AlgebraicGeometry.Spec R'₁ := f_B ≫ fst
    let f₂ : AlgebraicGeometry.Spec B_cat ⟶ AlgebraicGeometry.Spec R'₂ := f_B ≫ snd
    have hEt_f₁ : AlgebraicGeometry.Etale f₁ := inferInstance
    have hEt_f₂ : AlgebraicGeometry.Etale f₂ := inferInstance
    let g₁_cat : R'₁ ⟶ B_cat := AlgebraicGeometry.Spec.preimage f₁
    let g₂_cat : R'₂ ⟶ B_cat := AlgebraicGeometry.Spec.preimage f₂
    have hg₁_map : AlgebraicGeometry.Spec.map g₁_cat = f₁ := AlgebraicGeometry.Spec.map_preimage f₁
    have hg₂_map : AlgebraicGeometry.Spec.map g₂_cat = f₂ := AlgebraicGeometry.Spec.map_preimage f₂
    let φ₁ : MvPolynomial (Fin d) k →+* B := g₁_cat.hom.comp ψ₁
    let φ₂ : MvPolynomial (Fin d) k →+* B := g₂_cat.hom.comp ψ₂
    have hSpec_φ₁ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁) =
        f₁ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁) := by
      have hcomp₁ : CommRingCat.ofHom φ₁ = CommRingCat.ofHom ψ₁ ≫ g₁_cat :=
        CommRingCat.ofHom_comp ψ₁ g₁_cat.hom
      rw [hcomp₁, AlgebraicGeometry.Spec.map_comp, hg₁_map]
    have hSpec_φ₂ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₂) =
        f₂ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₂) := by
      have hcomp₂ : CommRingCat.ofHom φ₂ = CommRingCat.ofHom ψ₂ ≫ g₂_cat :=
        CommRingCat.ofHom_comp ψ₂ g₂_cat.hom
      rw [hcomp₂, AlgebraicGeometry.Spec.map_comp, hg₂_map]
    have hEt_Spec_φ₁ : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁)) := by
      rw [hSpec_φ₁]
      infer_instance
    have hEt_Spec_φ₂ : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₂)) := by
      rw [hSpec_φ₂]
      infer_instance
    have hφ₁_et : φ₁.Etale :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hEt_Spec_φ₁
    have hφ₂_et : φ₂.Etale :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hEt_Spec_φ₂
    have hmem₁ : ∀ (p : PrimeSpectrum B) (i : Fin d),
        φ₁ (MvPolynomial.X i) ∈ p.asIdeal ↔ ψ₁ (MvPolynomial.X i) ∈ (f₁.base p).asIdeal := by
      intro p i
      let p' : AlgebraicGeometry.Spec B_cat := p
      have hp₁ : (f₁.base p' : PrimeSpectrum ↑R'₁) = PrimeSpectrum.comap g₁_cat.hom p :=
        (congrFun (congrArg (fun h : AlgebraicGeometry.Spec B_cat ⟶ AlgebraicGeometry.Spec R'₁ =>
          (h : AlgebraicGeometry.Spec B_cat → AlgebraicGeometry.Spec R'₁)) hg₁_map.symm) p').trans
          (AlgebraicGeometry.Spec.map_apply g₁_cat p')
      have hideal₁ : (f₁.base p).asIdeal = Ideal.comap g₁_cat.hom p.asIdeal :=
        congrArg PrimeSpectrum.asIdeal hp₁
      rw [hideal₁]
      rfl
    have hmem₂ : ∀ (p : PrimeSpectrum B) (j : Fin d),
        φ₂ (MvPolynomial.X j) ∈ p.asIdeal ↔ ψ₂ (MvPolynomial.X j) ∈ (f₂.base p).asIdeal := by
      intro p j
      let p' : AlgebraicGeometry.Spec B_cat := p
      have hp₂ : (f₂.base p' : PrimeSpectrum ↑R'₂) = PrimeSpectrum.comap g₂_cat.hom p :=
        (congrFun (congrArg (fun h : AlgebraicGeometry.Spec B_cat ⟶ AlgebraicGeometry.Spec R'₂ =>
          (h : AlgebraicGeometry.Spec B_cat → AlgebraicGeometry.Spec R'₂)) hg₂_map.symm) p').trans
          (AlgebraicGeometry.Spec.map_apply g₂_cat p')
      have hideal₂ : (f₂.base p).asIdeal = Ideal.comap g₂_cat.hom p.asIdeal :=
        congrArg PrimeSpectrum.asIdeal hp₂
      rw [hideal₂]
      rfl
    have hq₀_f₁ : f₁.base q₀ = v₁ := by
      change fst (f_B q₀_spec) = v₁
      rw [hq₀_z, hz₁]
    have hq₀_f₂ : f₂.base q₀ = v₂ := by
      change snd (f_B q₀_spec) = v₂
      rw [hq₀_z, hz₂]
    refine ⟨B, inferInstance, q₀, φ₁, φ₂, hφ₁_et, hφ₂_et, ?_, ?_, ?_⟩
    · intro i hi
      rw [hmem₁ q₀ i, hq₀_f₁]
      exact hVan₁ i hi
    · intro j hj
      rw [hmem₂ q₀ j, hq₀_f₂]
      exact hVan₂ j hj
    · have hcond : f₁ ≫ e₁ = f₂ ≫ e₂ := by
        simp only [f₁, f₂, CategoryTheory.Category.assoc]
        congr 1
        exact CategoryTheory.Limits.pullback.condition
      ext p
      change (∃ i ∈ I₁, φ₁ (MvPolynomial.X i) ∈ p.asIdeal) ↔
        (∃ j ∈ I₂, φ₂ (MvPolynomial.X j) ∈ p.asIdeal)
      have hp_eq : e₁.base (f₁.base p) = e₂.base (f₂.base p) := by
        change (f₁ ≫ e₁) p = (f₂ ≫ e₂) p
        rw [hcond]
      have h1 : (∃ i ∈ I₁, φ₁ (MvPolynomial.X i) ∈ p.asIdeal) ↔
          e₁.base (f₁.base p) ∈ Z_nc := by
        calc
          (∃ i ∈ I₁, φ₁ (MvPolynomial.X i) ∈ p.asIdeal)
              ↔ (∃ i ∈ I₁, ψ₁ (MvPolynomial.X i) ∈ (f₁.base p).asIdeal) := by
                simp_rw [hmem₁ p]
          _ ↔ f₁.base p ∈ {v : AlgebraicGeometry.Spec R'₁ | ∃ i ∈ I₁, ψ₁ (MvPolynomial.X i) ∈ v.asIdeal} :=
                Iff.rfl
          _ ↔ f₁.base p ∈ e₁.base ⁻¹' Z_nc := by rw [← hPre₁]
          _ ↔ e₁.base (f₁.base p) ∈ Z_nc := Iff.rfl
      have h2 : (∃ j ∈ I₂, φ₂ (MvPolynomial.X j) ∈ p.asIdeal) ↔
          e₂.base (f₂.base p) ∈ Z_nc := by
        calc
          (∃ j ∈ I₂, φ₂ (MvPolynomial.X j) ∈ p.asIdeal)
              ↔ (∃ j ∈ I₂, ψ₂ (MvPolynomial.X j) ∈ (f₂.base p).asIdeal) := by
                simp_rw [hmem₂ p]
          _ ↔ f₂.base p ∈ {v : AlgebraicGeometry.Spec R'₂ | ∃ j ∈ I₂, ψ₂ (MvPolynomial.X j) ∈ v.asIdeal} :=
                Iff.rfl
          _ ↔ f₂.base p ∈ e₂.base ⁻¹' Z_nc := by rw [← hPre₂]
          _ ↔ e₂.base (f₂.base p) ∈ Z_nc := Iff.rfl
      rw [h1, h2, hp_eq]
  · intro R' e_S ψ I_nc v hEt_e hEt_ψ hComm hPre
    classical
    let I_v : Finset (Fin d) := I_nc.filter (fun j => ψ (MvPolynomial.X j) ∈ v.asIdeal)
    let J_out : Finset (Fin d) := I_nc.filter (fun j => ψ (MvPolynomial.X j) ∉ v.asIdeal)
    let s_v : ↑R' := ∏ j ∈ J_out, ψ (MvPolynomial.X j)
    have hSub_v : I_v ⊆ I_nc := Finset.filter_subset _ I_nc
    have hMem_v : ∀ j ∈ I_nc, j ∈ I_v ↔ ψ (MvPolynomial.X j) ∈ v.asIdeal := by
      intro j hj
      simp [I_v, hj]
    have : v.asIdeal.IsPrime := v.isPrime
    have hs_v : s_v ∉ v.asIdeal := by
      intro hs_in
      obtain ⟨j, hj_out, hj_mem⟩ := Ideal.IsPrime.prod_mem_iff.mp hs_in
      exact (Finset.mem_filter.mp hj_out).2 hj_mem
    have := hEt_e
    have := hEt_ψ
    let R'_v : CommRingCat.{u} := CommRingCat.of (Localization.Away s_v)
    let locHom : ↑R' →+* ↑R'_v := algebraMap (↑R') (Localization.Away s_v)
    let locMap : AlgebraicGeometry.Spec R'_v ⟶ AlgebraicGeometry.Spec R' :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom locHom)
    have hOpen_loc : AlgebraicGeometry.IsOpenImmersion locMap :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization (S := Localization.Away s_v) s_v
    have hEt_loc : AlgebraicGeometry.Etale locMap := inferInstance
    let e_v : AlgebraicGeometry.Spec R'_v ⟶ S'.left := locMap ≫ e_S
    let ψ_v : MvPolynomial (Fin d) k →+* ↑R'_v := locHom.comp ψ
    have hEt_ev : AlgebraicGeometry.Etale e_v := inferInstance
    have hSpec_ψv : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_v) =
        locMap ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) := by
      dsimp [ψ_v, locMap]
      rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp]
    have hEt_ψv : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_v)) := by
      rw [hSpec_ψv]
      infer_instance
    have hv_range : (v : PrimeSpectrum ↑R') ∈
        Set.range (PrimeSpectrum.comap (algebraMap (↑R') (Localization.Away s_v))) := by
      rw [PrimeSpectrum.localization_away_comap_range (Localization.Away s_v) s_v]
      exact hs_v
    obtain ⟨w₀_raw, hw₀⟩ := hv_range
    let w₀ : AlgebraicGeometry.Spec R'_v := w₀_raw
    have hw₀_base : locMap.base w₀ = v := hw₀
    have hw₀_eq : e_v.base w₀ = e_S.base v := by
      change e_S.base (locMap.base w₀) = e_S.base v
      rw [hw₀_base]
    have hComm_v : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_v) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = e_v ≫ S'.hom := by
      rw [hSpec_ψv, CategoryTheory.Category.assoc, hComm]
      rfl
    have hVan_v : ∀ j ∈ I_v, ψ_v (MvPolynomial.X j) ∈ w₀.asIdeal := by
      intro j hj
      change ψ (MvPolynomial.X j) ∈
        (PrimeSpectrum.comap (algebraMap (↑R') (Localization.Away s_v)) w₀_raw).asIdeal
      rw [hw₀]
      exact (Finset.mem_filter.mp hj).2
    have hNotMem_out : ∀ (w : AlgebraicGeometry.Spec R'_v) {j : Fin d},
        j ∈ J_out → ψ_v (MvPolynomial.X j) ∉ w.asIdeal := by
      intro w j hj hmem
      have hdvd : ψ (MvPolynomial.X j) ∣ s_v :=
        Finset.dvd_prod_of_mem (fun i => ψ (MvPolynomial.X i)) hj
      have hdvd_loc : ψ_v (MvPolynomial.X j) ∣ locHom s_v :=
        _root_.map_dvd locHom hdvd
      have hUnit_s : IsUnit (locHom s_v) :=
        IsLocalization.Away.algebraMap_isUnit s_v
      have hUnit_j : IsUnit (ψ_v (MvPolynomial.X j)) :=
        isUnit_of_dvd_unit hdvd_loc hUnit_s
      exact w.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem w.asIdeal hmem hUnit_j)
    have hPre_v : e_v.base ⁻¹' Z_nc =
        {w : AlgebraicGeometry.Spec R'_v | ∃ j ∈ I_v, ψ_v (MvPolynomial.X j) ∈ w.asIdeal} := by
      have hPre_nc : e_v.base ⁻¹' Z_nc =
          {w : AlgebraicGeometry.Spec R'_v | ∃ j ∈ I_nc, ψ_v (MvPolynomial.X j) ∈ w.asIdeal} := by
        change locMap.base ⁻¹' (e_S.base ⁻¹' Z_nc) = _
        rw [hPre]
        ext w
        rfl
      rw [hPre_nc]
      ext w
      change (∃ j ∈ I_nc, ψ_v (MvPolynomial.X j) ∈ w.asIdeal) ↔
        (∃ j ∈ I_v, ψ_v (MvPolynomial.X j) ∈ w.asIdeal)
      constructor
      · rintro ⟨j, hj_nc, hj_w⟩
        refine ⟨j, ?_, hj_w⟩
        rw [Finset.mem_filter]
        refine ⟨hj_nc, ?_⟩
        by_contra hj_not_v
        exact hNotMem_out w (Finset.mem_filter.mpr ⟨hj_nc, hj_not_v⟩) hj_w
      · rintro ⟨j, hj_iv, hj_w⟩
        exact ⟨j, hSub_v hj_iv, hj_w⟩
    exact ⟨R'_v, w₀, e_v, ψ_v, I_v,
      hSub_v, hMem_v, hEt_ev, hEt_ψv, hw₀_eq, hComm_v, hVan_v, hPre_v⟩

theorem weil_etale_nc_max_multiplicity_stratum (k : Type u) [Field k] [IsAlgClosed k]
    (m b : ℕ) (hb : b + 1 ≤ m)
    (S' : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (Z_total : Set S'.left)
    (hIntS' : AlgebraicGeometry.IsIntegral S'.left)
    (hProjS' : IsProjectiveOverField k S')
    (hSmS' : AlgebraicGeometry.SmoothOfRelativeDimension (m + 1) S'.hom)
    (hPair : IsSplitEtaleNcPair k m (b + 2) S' Z_total) :
    ∃ (q : ℕ) (H : Fin q → AlgebraicGeometry.Scheme.{u})
      (ιH : ∀ a : Fin q, H a ⟶ S'.left) (Z_nc : Set S'.left)
      (s : ℕ) (C_comp : Fin s → AlgebraicGeometry.Scheme.{u})
      (ιC : ∀ β : Fin s, C_comp β ⟶ S'.left),
      Z_total = (⋃ a : Fin q, Set.range (ιH a).base) ∪ Z_nc ∧
      IsMaxMultiplicityNcCenter k m b S' q H ιH Z_nc s C_comp ιC :=
by
  obtain ⟨q, H, ιH, Z_nc, hClH, hIntH, hSmH, hPairH, hClosedZnc, hZ_eq, hCharts⟩ := hPair
  have hAlg := weil_algClosed_etale_mvPolynomial_domain_and_card_eq k
  have hPull := weil_etale_nc_chart_pullback_and_filter_away k (m + 1) S' Z_nc
  let IsChartAt (x : S'.left) (R' : CommRingCat.{u}) (v₀ : AlgebraicGeometry.Spec R')
      (e_S : AlgebraicGeometry.Spec R' ⟶ S'.left)
      (ψ : MvPolynomial (Fin (m + 1)) k →+* R')
      (I_nc : Finset (Fin (m + 1))) : Prop :=
    AlgebraicGeometry.Etale e_S ∧
    AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) ∧
    e_S.base v₀ = x ∧
    (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = e_S ≫ S'.hom) ∧
    (∀ j ∈ I_nc, ψ (MvPolynomial.X j) ∈ v₀.asIdeal) ∧
    e_S.base ⁻¹' Z_nc =
      {v : AlgebraicGeometry.Spec R' | ∃ j ∈ I_nc, ψ (MvPolynomial.X j) ∈ v.asIdeal}
  let C : Set S'.left :=
    {x : S'.left | ∃ (R' : CommRingCat.{u}) (v₀ : AlgebraicGeometry.Spec R')
      (e_S : AlgebraicGeometry.Spec R' ⟶ S'.left)
      (ψ : MvPolynomial (Fin (m + 1)) k →+* R')
      (I_nc : Finset (Fin (m + 1))),
      IsChartAt x R' v₀ e_S ψ I_nc ∧ I_nc.card = b + 2}
  have hCardEq : ∀ {x : S'.left}
      {R'₁ : CommRingCat.{u}} {v₁ : AlgebraicGeometry.Spec R'₁}
      {e₁ : AlgebraicGeometry.Spec R'₁ ⟶ S'.left}
      {ψ₁ : MvPolynomial (Fin (m + 1)) k →+* R'₁} {I₁ : Finset (Fin (m + 1))}
      {R'₂ : CommRingCat.{u}} {v₂ : AlgebraicGeometry.Spec R'₂}
      {e₂ : AlgebraicGeometry.Spec R'₂ ⟶ S'.left}
      {ψ₂ : MvPolynomial (Fin (m + 1)) k →+* R'₂} {I₂ : Finset (Fin (m + 1))},
      IsChartAt x R'₁ v₁ e₁ ψ₁ I₁ →
      IsChartAt x R'₂ v₂ e₂ ψ₂ I₂ →
      I₁.card = I₂.card := by
    intro x R'₁ v₁ e₁ ψ₁ I₁ R'₂ v₂ e₂ ψ₂ I₂ h₁ h₂
    obtain ⟨hEt_e₁, hEt_ψ₁, hv₁, _, hVan₁, hPre₁⟩ := h₁
    obtain ⟨hEt_e₂, hEt_ψ₂, hv₂, _, hVan₂, hPre₂⟩ := h₂
    obtain ⟨B, instB, q₀, φ₁, φ₂, hφ₁, hφ₂, hq₁, hq₂, hSetEq⟩ :=
      hPull.1 x R'₁ v₁ e₁ ψ₁ I₁ R'₂ v₂ e₂ ψ₂ I₂
        hEt_e₁ hEt_ψ₁ hv₁ hVan₁ hPre₁ hEt_e₂ hEt_ψ₂ hv₂ hVan₂ hPre₂
    exact @hAlg.2 (m + 1) B instB q₀ φ₁ φ₂ I₁ I₂ hφ₁ hφ₂ hq₁ hq₂ hSetEq
  have hMemC_iff : ∀ {x : S'.left}
      {R' : CommRingCat.{u}} {v₀ : AlgebraicGeometry.Spec R'}
      {e_S : AlgebraicGeometry.Spec R' ⟶ S'.left}
      {ψ : MvPolynomial (Fin (m + 1)) k →+* R'} {I_nc : Finset (Fin (m + 1))},
      IsChartAt x R' v₀ e_S ψ I_nc →
      (x ∈ C ↔ I_nc.card = b + 2) := by
