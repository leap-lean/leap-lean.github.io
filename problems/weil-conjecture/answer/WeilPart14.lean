          have h1 : tilde_Φ2 (Ideal.Quotient.mk I_M' (MvPolynomial.X (Sum.inr c₀))) =
              ι_2 (m_gen 2) := congrArg Subtype.val (hΦ2_inr c₀)
          have h2 : tilde_Φ2 (Ideal.Quotient.mk I_M' (MvPolynomial.X (Sum.inl i))) =
              r_2 (Fin.castSucc i) := congrArg Subtype.val (hΦ2_inl i)
          rw [h1, h2, hr2_spec (Fin.castSucc i)]
          fin_cases i <;> rfl
        · exact ⟨Ideal.Quotient.mk I_M' (MvPolynomial.X (Sum.inr c)),
            congrArg Subtype.val (hΦ2_inr c)⟩
    have hΦ2_surj : Function.Surjective Φ2_hom := by
      rintro ⟨z, hz⟩
      suffices z ∈ tilde_Φ2.range by
        rcases this with ⟨y, hy⟩
        exact ⟨y, Subtype.ext hy⟩
      refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hz
      · rintro _ ⟨j, rfl⟩
        fin_cases j
        · exact ⟨Ideal.Quotient.mk I_M' (MvPolynomial.X (Sum.inl 0)),
            congrArg Subtype.val (hΦ2_inl 0)⟩
        · exact ⟨Ideal.Quotient.mk I_M' (MvPolynomial.X (Sum.inl 1)),
            congrArg Subtype.val (hΦ2_inl 1)⟩
        · refine ⟨1, ?_⟩
          rw [map_one]
          exact (IsLocalization.mk'_self' L_2 (x := ⟨m_gen 2, Submonoid.mem_powers (m_gen 2)⟩)).symm
      · intro y
        exact hM_in_range2 y
      · intro z₁ z₂ _ _ hz₁ hz₂
        exact tilde_Φ2.range.add_mem hz₁ hz₂
      · intro z₁ z₂ _ _ hz₁ hz₂
        exact tilde_Φ2.range.mul_mem hz₁ hz₂
    
    let t'c₀ : M' := Ideal.Quotient.mk I_M' (MvPolynomial.X (Sum.inr c₀))
    let η' : M' →+* L' := algebraMap M' L'
    have hη'_inj : Function.Injective η' := by
      apply IsLocalization.injective L' (M := Submonoid.powers t'c₀)
      rw [Submonoid.powers_le]
      exact mem_nonZeroDivisors_of_ne_zero ht'c₀_ne
    let ι_MM'_raw : MvPolynomial (Fin 2 ⊕ Fin m) k →+* M' :=
      MvPolynomial.eval₂Hom ((Ideal.Quotient.mk I_M').comp MvPolynomial.C) fun s =>
        match s with
        | Sum.inl i => t'c₀ * Ideal.Quotient.mk I_M' (MvPolynomial.X (Sum.inl i))
        | Sum.inr c => Ideal.Quotient.mk I_M' (MvPolynomial.X (Sum.inr c))
    have hι_MM'_rel : ∀ f ∈ I_M, ι_MM'_raw f = 0 := by
      intro f hf
      rw [Ideal.mem_span_singleton] at hf
      rcases hf with ⟨h, rfl⟩
      rw [map_mul]
      suffices ι_MM'_raw (MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1)) =
          ι_MM'_raw (∏ c : Fin m, MvPolynomial.X (Sum.inr c) ^ a c) by
        rw [map_sub, this, sub_self, zero_mul]
      have hlhs : ι_MM'_raw (MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1)) =
          t'c₀ ^ 2 * ∏ c : Fin m, Ideal.Quotient.mk I_M' (MvPolynomial.X (Sum.inr c)) ^ a' c := by
        have hx0 : ι_MM'_raw (MvPolynomial.X (Sum.inl 0)) =
            t'c₀ * Ideal.Quotient.mk I_M' (MvPolynomial.X (Sum.inl 0)) := by
          simp [ι_MM'_raw]
        have hx1 : ι_MM'_raw (MvPolynomial.X (Sum.inl 1)) =
            t'c₀ * Ideal.Quotient.mk I_M' (MvPolynomial.X (Sum.inl 1)) := by
          simp [ι_MM'_raw]
        rw [map_mul, hx0, hx1]
        calc
          (t'c₀ * Ideal.Quotient.mk I_M' (MvPolynomial.X (Sum.inl 0))) *
              (t'c₀ * Ideal.Quotient.mk I_M' (MvPolynomial.X (Sum.inl 1)))
            = t'c₀ ^ 2 * (Ideal.Quotient.mk I_M' (MvPolynomial.X (Sum.inl 0)) *
                Ideal.Quotient.mk I_M' (MvPolynomial.X (Sum.inl 1))) := by ring
          _ = t'c₀ ^ 2 *
                ∏ c : Fin m, Ideal.Quotient.mk I_M' (MvPolynomial.X (Sum.inr c)) ^ a' c := by
              rw [hRelM']
      have hrhs : ι_MM'_raw (∏ c : Fin m, MvPolynomial.X (Sum.inr c) ^ a c) =
          ∏ c : Fin m, Ideal.Quotient.mk I_M' (MvPolynomial.X (Sum.inr c)) ^ a c := by
        simp [ι_MM'_raw, map_prod, map_pow]
      rw [hlhs, hrhs,
        ← Finset.mul_prod_erase Finset.univ
          (fun c => Ideal.Quotient.mk I_M' (MvPolynomial.X (Sum.inr c)) ^ a' c)
          (Finset.mem_univ c₀),
        ← Finset.mul_prod_erase Finset.univ
          (fun c => Ideal.Quotient.mk I_M' (MvPolynomial.X (Sum.inr c)) ^ a c)
          (Finset.mem_univ c₀)]
      have ha'_c₀ : a' c₀ = a c₀ - 2 := Function.update_self c₀ (a c₀ - 2) a
      have herase : (∏ c ∈ Finset.univ.erase c₀,
            Ideal.Quotient.mk I_M' (MvPolynomial.X (Sum.inr c)) ^ a' c) =
          ∏ c ∈ Finset.univ.erase c₀,
            Ideal.Quotient.mk I_M' (MvPolynomial.X (Sum.inr c)) ^ a c := by
        refine Finset.prod_congr rfl fun c hc => ?_
        dsimp only [a']
        rw [Function.update_of_ne (Finset.ne_of_mem_erase hc)]
      have hpow : t'c₀ ^ a c₀ = t'c₀ ^ 2 * t'c₀ ^ (a c₀ - 2) := by
        rw [← pow_add]; congr 1; omega
      rw [ha'_c₀, herase]
      change t'c₀ ^ 2 * (t'c₀ ^ (a c₀ - 2) * _) = t'c₀ ^ a c₀ * _
      rw [hpow, mul_assoc]
    let ι_MM' : M →+* M' := Ideal.Quotient.lift I_M ι_MM'_raw hι_MM'_rel
    have hι_MM'_mk : ∀ p, ι_MM' (Ideal.Quotient.mk I_M p) = ι_MM'_raw p := fun _ => rfl
    have hι_MM'_2 : ι_MM' (m_gen 2) = t'c₀ := by
