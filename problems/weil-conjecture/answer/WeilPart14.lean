      let s_X : R' := ψ_rel (Ideal.Quotient.mk I₀ (MvPolynomial.C s_B)) * t_X
      have hUnit_sX : IsUnit (algebraMap R' R₁ s_X) :=
        IsLocalization.Away.algebraMap_isUnit (S := R₁) s_X
      have hUnit_sB : IsUnit (((algebraMap R' R₁).comp π_rel) s_B) := by
        change IsUnit (algebraMap R' R₁ (ψ_rel (Ideal.Quotient.mk I₀ (MvPolynomial.C s_B))))
        have hMul : algebraMap R' R₁ s_X =
            algebraMap R' R₁ (ψ_rel (Ideal.Quotient.mk I₀ (MvPolynomial.C s_B))) *
