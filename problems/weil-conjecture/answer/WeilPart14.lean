          ⟨S.add_mem hx hy, d₁ + d₂, by
            change L_D (d₁ + d₂) = toK_A (⟨_, hx⟩ + ⟨_, hy⟩)
            rw [map_add, map_add, h1, h2]⟩
        zero_mem' := ⟨S.zero_mem, 0, by change L_D 0 = toK_A 0; rw [map_zero, map_zero]⟩
