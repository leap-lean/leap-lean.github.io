      have hAltId : IsGenFiniteEtaleAlterationOver k (𝟙 S') := by
        unfold IsGenFiniteEtaleAlterationOver
        rw [CategoryTheory.Over.id_left]
        exact ⟨inferInstance, inferInstance, ⊤, hTop, inferInstance, inferInstance, inferInstance⟩
      refine ⟨S', Z_total, 𝟙 S', hIntS', hProjS', hSmS', hPair, hAltId, ?_⟩
      intro x hx
