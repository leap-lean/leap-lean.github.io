        have hEqSpec : Spec.map (CommRingCat.ofHom (σ.comp φ₃)) ≫ e_A₃ =
            Spec.map (CommRingCat.ofHom (RingHom.id A₃_ring)) ≫ e_A₃ := by
          have hc : CommRingCat.ofHom (σ.comp φ₃) =
            CommRingCat.ofHom φ₃ ≫ CommRingCat.ofHom σ := rfl
          rw [hc, Spec.map_comp, Category.assoc, ← he_S₃_f, ← Category.assoc, hσ_fac,
            Category.assoc, hτ, Category.comp_id, CommRingCat.ofHom_id, Spec.map_id,
            Category.id_comp]
        have hMapEq := (cancel_mono e_A₃).mp hEqSpec
        have hHomEq := Spec.fullyFaithful.map_injective hMapEq
        exact congrArg (fun z => z.unop.hom) hHomEq
      have hPre_eq : e_S₃.base ⁻¹' Set.range τ.base =
          {v : Spec S₃ | RingHom.ker σ ≤ v.asIdeal} := by
        have hSurj_σ : Function.Surjective σ :=
          Function.RightInverse.surjective (RingHom.congr_fun hσφ₃)
        ext v
        constructor
        · rintro ⟨y, hy⟩
          let w_v : Spec A₃ := PrimeSpectrum.comap φ₃ v
          have hy_eq : y = e_A₃.base w_v := by
            calc
              y = (τ ≫ f₁.left).base y := by rw [hτ]; rfl
              _ = f₁.left.base (τ.base y) := rfl
              _ = (e_S₃ ≫ f₁.left).base v := by rw [hy]; rfl
              _ = (Spec.map (CommRingCat.ofHom φ₃) ≫ e_A₃).base v := by rw [he_S₃_f]
              _ = e_A₃.base w_v := by
                change e_A₃.base ((Spec.map (CommRingCat.ofHom φ₃)).base v) = e_A₃.base w_v
                rw [Spec.map_apply]
                rfl
          have hv_eq : e_S₃.base ((Spec.map (CommRingCat.ofHom σ)).base w_v) = e_S₃.base v := by
            change (Spec.map (CommRingCat.ofHom σ) ≫ e_S₃).base w_v = e_S₃.base v
            rw [hσ_fac]
            change τ.base (e_A₃.base w_v) = e_S₃.base v
            rw [← hy_eq, hy]
          have hv_comap : PrimeSpectrum.comap σ w_v = v := by
            have h1 := e_S₃.isOpenEmbedding.injective hv_eq
            rwa [Spec.map_apply] at h1
