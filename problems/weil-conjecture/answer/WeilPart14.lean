    let e_κ₁_M : TensorProduct p.asIdeal.ResidueField q_B.asIdeal.ResidueField
          (TensorProduct M p.asIdeal.ResidueField Ω[M⁄k]) ≃ₗ[q_B.asIdeal.ResidueField]
        TensorProduct (Localization.Away s) q_B.asIdeal.ResidueField Ω[Localization.Away s⁄k] :=
      (TensorProduct.AlgebraTensorModule.cancelBaseChange M p.asIdeal.ResidueField
        q_B.asIdeal.ResidueField q_B.asIdeal.ResidueField Ω[M⁄k]).trans
        ((TensorProduct.AlgebraTensorModule.cancelBaseChange M (Localization.Away s)
          q_B.asIdeal.ResidueField q_B.asIdeal.ResidueField Ω[M⁄k]).symm.trans
          (e_MB.baseChange (Localization.Away s) q_B.asIdeal.ResidueField))
    let b₀ := Module.Free.chooseBasis p.asIdeal.ResidueField
      (TensorProduct M p.asIdeal.ResidueField Ω[M⁄k])
    let b₁_left : Module.Basis
        (Module.Free.ChooseBasisIndex p.asIdeal.ResidueField
          (TensorProduct M p.asIdeal.ResidueField Ω[M⁄k]))
        q_B.asIdeal.ResidueField
        (TensorProduct (Localization.Away s) q_B.asIdeal.ResidueField Ω[Localization.Away s⁄k]) :=
      (b₀.baseChange q_B.asIdeal.ResidueField).map e_κ₁_M
    let b₁_right : Module.Basis I_W q_B.asIdeal.ResidueField
        (TensorProduct (Localization.Away s) q_B.asIdeal.ResidueField Ω[Localization.Away s⁄k]) :=
      b_B.baseChange q_B.asIdeal.ResidueField
    have hCard_J : Cardinal.mk
        (Module.Free.ChooseBasisIndex p.asIdeal.ResidueField
          (TensorProduct M p.asIdeal.ResidueField Ω[M⁄k])) = (d : Cardinal) := by
      rw [b₁_left.mk_eq_rank'', ← b₁_right.mk_eq_rank'', hCard_IW]
    have : Finite (Module.Free.ChooseBasisIndex p.asIdeal.ResidueField
        (TensorProduct M p.asIdeal.ResidueField Ω[M⁄k])) :=
      Cardinal.lt_aleph0_iff_finite.mp (by rw [hCard_J]; exact Cardinal.natCast_lt_aleph0)
    let : Fintype (Module.Free.ChooseBasisIndex p.asIdeal.ResidueField
        (TensorProduct M p.asIdeal.ResidueField Ω[M⁄k])) := Fintype.ofFinite _
    have hFinCard : Fintype.card (Module.Free.ChooseBasisIndex p.asIdeal.ResidueField
        (TensorProduct M p.asIdeal.ResidueField Ω[M⁄k])) = d := by
      have hCast : (Fintype.card (Module.Free.ChooseBasisIndex p.asIdeal.ResidueField
          (TensorProduct M p.asIdeal.ResidueField Ω[M⁄k])) : Cardinal) = (d : Cardinal) := by
        rwa [← Cardinal.mk_fintype]
      exact Nat.cast_injective hCast
    have hFinrank_V : Module.finrank p.asIdeal.ResidueField
        (TensorProduct M p.asIdeal.ResidueField Ω[M⁄k]) = d := by
      rw [Module.finrank_eq_card_basis b₀, hFinCard]
    let e_dual : ((TensorProduct M p.asIdeal.ResidueField Ω[M⁄k]) →ₗ[p.asIdeal.ResidueField]
        p.asIdeal.ResidueField) ≃ₗ[p.asIdeal.ResidueField]
        (Ω[M⁄k] →ₗ[M] p.asIdeal.ResidueField) :=
      (LinearMap.liftBaseChangeEquiv p.asIdeal.ResidueField).symm
    let e_der_M : (Ω[M⁄k] →ₗ[M] p.asIdeal.ResidueField) ≃ₗ[M]
        Derivation k M p.asIdeal.ResidueField :=
      KaehlerDifferential.linearMapEquivDerivation k M
    let e_der_κ₀ : (Ω[M⁄k] →ₗ[M] p.asIdeal.ResidueField) ≃ₗ[p.asIdeal.ResidueField]
        Derivation k M p.asIdeal.ResidueField :=
      { e_der_M with
        map_smul' := fun c f => by
          ext x
          rfl }
    let e_der_dual : Derivation k M p.asIdeal.ResidueField ≃ₗ[p.asIdeal.ResidueField]
        Module.Dual p.asIdeal.ResidueField (TensorProduct M p.asIdeal.ResidueField Ω[M⁄k]) :=
      e_der_κ₀.symm.trans e_dual.symm
    have : Module.Finite p.asIdeal.ResidueField (TensorProduct M p.asIdeal.ResidueField Ω[M⁄k]) :=
      Module.Finite.of_basis b₀
    rw [LinearEquiv.finrank_eq e_der_dual, Subspace.dual_finrank_eq, hFinrank_V]
  
  refine ⟨?_, ?_⟩
  · intro d R' v₀ e_Y ψ he_Y hψ hv₀ hComm
    obtain ⟨A, B, α_A, φ, ψ_B, q, hFT, hEt_φ, hEt_ψ, hComm_AB, hLift⟩ :=
      h_s2 d R' v₀ e_Y ψ he_Y hψ hv₀ hComm
    have : q.asIdeal.IsPrime := q.isPrime
    obtain ⟨f, hf, hStd⟩ :=
      h_s3 A B α_A φ d ψ_B hFT hEt_φ hEt_ψ hComm_AB q.asIdeal
    exact hLift f hf hStd
  · intro m R' v₀ e_Y a S₀ q he_Y hq hv₀ hComm hInl hInr hSum ⟨V, hyV, hSmV⟩
    let F_tor : MvPolynomial (Fin 2 ⊕ Fin m) k :=
      MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
        ∏ c : Fin m, MvPolynomial.X (Sum.inr c) ^ a c
    let I_F : Ideal (MvPolynomial (Fin 2 ⊕ Fin m) k) := Ideal.span {F_tor}
    let M_tor := MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ I_F
    let W₀ : (AlgebraicGeometry.Spec R').Opens :=
      (TopologicalSpace.Opens.map e_Y.base).obj V
    have hv₀W : v₀ ∈ W₀ := by
      change e_Y.base v₀ ∈ V
      rwa [hv₀]
    have : AlgebraicGeometry.Etale e_Y := he_Y
    have : AlgebraicGeometry.SmoothOfRelativeDimension (m + 1) (V.ι ≫ Y.hom) := hSmV
    have hCompSm := AlgebraicGeometry.smoothOfRelativeDimension_comp 0 (m + 1)
      (e_Y ∣_ V) (V.ι ≫ Y.hom)
    have hEqMor : (e_Y ∣_ V) ≫ (V.ι ≫ Y.hom) =
        W₀.ι ≫ q ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k M_tor)) := by
      rw [← Category.assoc, AlgebraicGeometry.morphismRestrict_ι, Category.assoc, ← hComm]
      rfl
    rw [Nat.zero_add, hEqMor] at hCompSm
    let p_tor : PrimeSpectrum M_tor := q.base v₀
    have hRank₁ : Module.finrank p_tor.asIdeal.ResidueField
        (Derivation k M_tor p_tor.asIdeal.ResidueField) = m + 1 :=
      h_s4 M_tor (m + 1) R' v₀ W₀ hv₀W q p_tor rfl hq hCompSm
    
    have hRank₂ : Module.finrank p_tor.asIdeal.ResidueField
        (Derivation k M_tor p_tor.asIdeal.ResidueField) = m + 2 := by
      let π_M : MvPolynomial (Fin 2 ⊕ Fin m) k →ₐ[k] M_tor :=
        Ideal.Quotient.mkₐ k I_F
      let ev : MvPolynomial (Fin 2 ⊕ Fin m) k →+* p_tor.asIdeal.ResidueField :=
        (algebraMap M_tor p_tor.asIdeal.ResidueField).comp π_M.toRingHom
      let ℑ : Ideal (MvPolynomial (Fin 2 ⊕ Fin m) k) := RingHom.ker ev
      have hKerAlg : RingHom.ker (algebraMap M_tor p_tor.asIdeal.ResidueField) = p_tor.asIdeal :=
        Ideal.ker_algebraMap_residueField p_tor.asIdeal
      have hMemℑ : ∀ g : MvPolynomial (Fin 2 ⊕ Fin m) k,
          g ∈ ℑ ↔ Ideal.Quotient.mk I_F g ∈ p_tor.asIdeal := by
        intro g
        rw [RingHom.mem_ker, RingHom.comp_apply, ← RingHom.mem_ker, hKerAlg]
        rfl
      have hInl0 : (MvPolynomial.X (Sum.inl 0) : MvPolynomial (Fin 2 ⊕ Fin m) k) ∈ ℑ :=
        (hMemℑ _).mpr (hInl 0)
      have hInl1 : (MvPolynomial.X (Sum.inl 1) : MvPolynomial (Fin 2 ⊕ Fin m) k) ∈ ℑ :=
        (hMemℑ _).mpr (hInl 1)
      have hTerm1 : (MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) :
          MvPolynomial (Fin 2 ⊕ Fin m) k) ∈ ℑ ^ 2 := by
        rw [sq]
        exact Ideal.mul_mem_mul hInl0 hInl1
      have hProdSub : ∀ (S : Finset (Fin m)), S ⊆ S₀ →
          (∏ c ∈ S, (MvPolynomial.X (Sum.inr c) : MvPolynomial (Fin 2 ⊕ Fin m) k) ^ a c) ∈
            ℑ ^ (∑ c ∈ S, a c) := by
        intro S
        refine Finset.induction_on S ?_ ?_
        · intro _
          simp [Ideal.one_eq_top]
        · intro c S hcNotMem ih hSub
          rw [Finset.prod_insert hcNotMem, Finset.sum_insert hcNotMem, pow_add]
          have hcS₀ : c ∈ S₀ := hSub (Finset.mem_insert_self c S)
          have hcℑ : (MvPolynomial.X (Sum.inr c) : MvPolynomial (Fin 2 ⊕ Fin m) k) ∈ ℑ :=
            (hMemℑ _).mpr (hInr c hcS₀)
          exact Ideal.mul_mem_mul (Ideal.pow_mem_pow hcℑ (a c))
            (ih (Finset.Subset.trans (Finset.subset_insert c S) hSub))
      have hProdS₀ : (∏ c ∈ S₀, (MvPolynomial.X (Sum.inr c) :
          MvPolynomial (Fin 2 ⊕ Fin m) k) ^ a c) ∈ ℑ ^ 2 :=
        Ideal.pow_le_pow_right hSum (hProdSub S₀ Finset.Subset.rfl)
      have hTerm2 : (∏ c : Fin m, (MvPolynomial.X (Sum.inr c) :
          MvPolynomial (Fin 2 ⊕ Fin m) k) ^ a c) ∈ ℑ ^ 2 := by
        rw [← Finset.prod_sdiff (Finset.subset_univ S₀)]
        exact Ideal.mul_mem_left _ _ hProdS₀
      have hF_sq : F_tor ∈ ℑ ^ 2 := Ideal.sub_mem _ hTerm1 hTerm2
      have hF_ℑ : F_tor ∈ ℑ := (hMemℑ F_tor).mpr (by
        have hz : Ideal.Quotient.mk I_F F_tor = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
        rw [hz]
        exact p_tor.asIdeal.zero_mem)
      have hSmulEq : ∀ (g : MvPolynomial (Fin 2 ⊕ Fin m) k) (z : p_tor.asIdeal.ResidueField),
          g • z = ev g * z := by
        intro g z
        rw [← IsScalarTower.algebraMap_smul M_tor g z, Algebra.smul_def]
        rfl
      have hVanishSq : ∀ (D : Derivation k (MvPolynomial (Fin 2 ⊕ Fin m) k) p_tor.asIdeal.ResidueField)
          {z : MvPolynomial (Fin 2 ⊕ Fin m) k}, z ∈ ℑ ^ 2 → D z = 0 := by
        intro D z hz
        rw [sq] at hz
        refine Submodule.mul_induction_on hz ?_ ?_
        · intro x hx y hy
          have hx0 : ev x = 0 := hx
          have hy0 : ev y = 0 := hy
          rw [D.leibniz, hSmulEq, hSmulEq, hx0, hy0, zero_mul, zero_mul, add_zero]
        · intro x y hx hy
          rw [map_add, hx, hy, add_zero]
      have hVanishSpan : ∀ (D : Derivation k (MvPolynomial (Fin 2 ⊕ Fin m) k) p_tor.asIdeal.ResidueField)
          {h : MvPolynomial (Fin 2 ⊕ Fin m) k}, h ∈ I_F → D h = 0 := by
        intro D h hh
        rw [Ideal.mem_span_singleton'] at hh
        rcases hh with ⟨g, rfl⟩
        have hDF : D F_tor = 0 := hVanishSq D hF_sq
        have hF0 : ev F_tor = 0 := hF_ℑ
        rw [D.leibniz, hSmulEq, hSmulEq, hDF, hF0, mul_zero, zero_mul, add_zero]
      let liftDer : (Fin 2 ⊕ Fin m → p_tor.asIdeal.ResidueField) →
          Derivation k M_tor p_tor.asIdeal.ResidueField := fun v =>
        let Dv : Derivation k (MvPolynomial (Fin 2 ⊕ Fin m) k) p_tor.asIdeal.ResidueField :=
          MvPolynomial.mkDerivation k v
        { toLinearMap :=
            Submodule.liftQ (I_F.restrictScalars k) Dv.toLinearMap
              (fun h hh => hVanishSpan Dv hh)
          map_one_eq_zero' := Dv.map_one_eq_zero
          leibniz' := fun x y => by
            induction x using Quotient.inductionOn' with | h gx =>
            induction y using Quotient.inductionOn' with | h gy =>
            change Dv (gx * gy) =
              (Ideal.Quotient.mk I_F gx) • Dv gy + (Ideal.Quotient.mk I_F gy) • Dv gx
            rw [Dv.leibniz gx gy,
              ← IsScalarTower.algebraMap_smul M_tor gx,
              ← IsScalarTower.algebraMap_smul M_tor gy]
            rfl }
      let equivDer : Derivation k M_tor p_tor.asIdeal.ResidueField
          ≃ₗ[p_tor.asIdeal.ResidueField] (Fin 2 ⊕ Fin m → p_tor.asIdeal.ResidueField) :=
        { toFun := fun D i => D (Ideal.Quotient.mk I_F (MvPolynomial.X i))
          map_add' := fun D₁ D₂ => by ext i; rfl
          map_smul' := fun c D => by ext i; rfl
          invFun := liftDer
          left_inv := fun D => by
            ext x
            induction x using Quotient.inductionOn' with | h g =>
            let D_comp : Derivation k (MvPolynomial (Fin 2 ⊕ Fin m) k) p_tor.asIdeal.ResidueField :=
              D.compAlgebraMap (MvPolynomial (Fin 2 ⊕ Fin m) k)
            have hEq : MvPolynomial.mkDerivation k
                (fun i => D (Ideal.Quotient.mk I_F (MvPolynomial.X i))) = D_comp := by
              ext i
              rw [MvPolynomial.mkDerivation_X]
              rfl
            change (MvPolynomial.mkDerivation k
              (fun i => D (Ideal.Quotient.mk I_F (MvPolynomial.X i)))) g =
                D (Ideal.Quotient.mk I_F g)
            rw [hEq]
            rfl
          right_inv := fun v => by
            ext i
            change (MvPolynomial.mkDerivation k v) (MvPolynomial.X i) = v i
            exact MvPolynomial.mkDerivation_X k v i }
      rw [LinearEquiv.finrank_eq equivDer, Module.finrank_pi, Fintype.card_sum,
        Fintype.card_fin, Fintype.card_fin, Nat.add_comm 2 m]
    omega

theorem weil_etale_mvPolynomial_prime_factorization (k : Type u) [Field k] :
    (∀ (d : ℕ) (B : Type u) [CommRing B] (φ : MvPolynomial (Fin d) k →+* B),
      AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)) →
      ∀ (q : Ideal B) [q.IsPrime], IsDomain (Localization.AtPrime q)) ∧
    (∀ (m : ℕ) (R : Type u) [CommRing R] (ψ : MvPolynomial (Fin m) k →+* R),
      AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) →
      ∀ (p : Ideal R) [p.IsPrime] (I₀ : Finset (Fin m)),
        (∀ c ∈ I₀, ψ (MvPolynomial.X c) ∈ p) →
        ∀ (h : R), h ∈ p →
          (∀ (q : Ideal R), q.IsPrime → q ≤ p → h ∈ q → ∃ c ∈ I₀, ψ (MvPolynomial.X c) ∈ q) →
          ∃ (a : Fin m → ℕ) (s : R) (u : (Localization.Away s)ˣ),
            s ∉ p ∧
            1 ≤ (∑ c : Fin m, a c) ∧
            (∀ c : Fin m, 1 ≤ a c → c ∈ I₀) ∧
            algebraMap R (Localization.Away s) h =
              ↑u * ∏ c : Fin m, algebraMap R (Localization.Away s) (ψ (MvPolynomial.X c)) ^ a c) :=
by
  have hEt_comp_left : ∀ {A B C : Type u} [CommRing A] [CommRing B] [CommRing C]
      (f : A →+* B) (e : B ≃+* C), RingHom.Etale f → RingHom.Etale (e.toRingHom.comp f) :=
    fun f e hf => RingHom.Etale.respectsIso.1 f e hf
  have hEt_comp_right : ∀ {A B C : Type u} [CommRing A] [CommRing B] [CommRing C]
      (f : B →+* C) (e : A ≃+* B), RingHom.Etale f → RingHom.Etale (f.comp e.toRingHom) :=
    fun f e hf => RingHom.Etale.respectsIso.2 f e hf
  have hBaseChangeAux : ∀ (R₀ A_d B K' : Type u) [CommRing R₀] [CommRing A_d] [Algebra R₀ A_d]
      [CommRing B] [Algebra R₀ B] [Algebra A_d B] [IsScalarTower R₀ A_d B]
      [Algebra.Etale A_d B] [Field K'] [Algebra R₀ K'],
      ∃ φ_bc : TensorProduct R₀ K' A_d →+* TensorProduct R₀ B K', RingHom.Etale φ_bc := by
    intro R₀ A_d B K' _ _ _ _ _ _ _ _ _ _
    haveI : Algebra.Etale (TensorProduct R₀ A_d K')
        (TensorProduct A_d (TensorProduct R₀ A_d K') B) :=
      Algebra.Etale.baseChange A_d B (TensorProduct R₀ A_d K')
    have hEt0 : RingHom.Etale (algebraMap (TensorProduct R₀ A_d K')
        (TensorProduct A_d (TensorProduct R₀ A_d K') B)) :=
      RingHom.etale_algebraMap.mpr inferInstance
    let e_canc : TensorProduct A_d (TensorProduct R₀ A_d K') B ≃+* TensorProduct R₀ B K' :=
      (Algebra.TensorProduct.comm A_d (TensorProduct R₀ A_d K') B).toRingEquiv.trans
        (Algebra.TensorProduct.cancelBaseChange R₀ A_d A_d B K').toRingEquiv
    let e_comm : TensorProduct R₀ K' A_d ≃+* TensorProduct R₀ A_d K' :=
      (Algebra.TensorProduct.comm R₀ K' A_d).toRingEquiv
    refine ⟨(e_canc.toRingHom.comp (algebraMap _ _)).comp e_comm.toRingHom, ?_⟩
    exact hEt_comp_right _ e_comm (hEt_comp_left _ e_canc hEt0)
  have hCoordQuotAux : ∀ (A_m R : Type u) [CommRing A_m] [CommRing R] [Algebra A_m R]
      [Algebra.Etale A_m R] (x : A_m) (t : R), algebraMap A_m R x = t →
      ∃ ψ_bc : (A_m ⧸ Ideal.span {x}) →+* (R ⧸ Ideal.span {t}), RingHom.Etale ψ_bc := by
    intro A_m R _ _ _ _ x t hxt
    haveI : Algebra.Etale (A_m ⧸ Ideal.span {x})
        (TensorProduct A_m (A_m ⧸ Ideal.span {x}) R) :=
      Algebra.Etale.baseChange A_m R (A_m ⧸ Ideal.span {x})
    have hEtQ : RingHom.Etale (algebraMap (A_m ⧸ Ideal.span {x})
        (TensorProduct A_m (A_m ⧸ Ideal.span {x}) R)) :=
      RingHom.etale_algebraMap.mpr inferInstance
    have hmap : Ideal.map (algebraMap A_m R) (Ideal.span {x}) = Ideal.span {t} := by
      rw [Ideal.map_span, Set.image_singleton, hxt]
    let e_Rbar : TensorProduct A_m (A_m ⧸ Ideal.span {x}) R ≃+* (R ⧸ Ideal.span {t}) :=
      (Algebra.TensorProduct.comm A_m (A_m ⧸ Ideal.span {x}) R).toRingEquiv.trans
        ((Algebra.TensorProduct.quotIdealMapEquivTensorQuot R (Ideal.span {x})).symm.toRingEquiv.trans
          (Ideal.quotEquivOfEq hmap))
    refine ⟨e_Rbar.toRingHom.comp (algebraMap _ _), ?_⟩
    exact hEt_comp_left _ e_Rbar hEtQ
  have hQuotDom : ∀ (R : Type u) [CommRing R] (J p : Ideal R) [p.IsPrime] (hJp : J ≤ p),
      letI : (Ideal.map (Ideal.Quotient.mk J) p).IsPrime :=
        Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective
          (by simpa [Ideal.mk_ker] using hJp)
      IsDomain (Localization.AtPrime (Ideal.map (Ideal.Quotient.mk J) p)) →
      IsDomain (Localization.AtPrime p ⧸ Ideal.map (algebraMap R (Localization.AtPrime p)) J) := by
    intro R _ J p _ hJp
    let mkJ : R →+* R ⧸ J := Ideal.Quotient.mk J
    letI hp_bar : (Ideal.map mkJ p).IsPrime :=
      Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective
        (by simpa [mkJ, Ideal.mk_ker] using hJp)
    intro hDomBar
    let L := Localization.AtPrime p
    let JL : Ideal L := Ideal.map (algebraMap R L) J
    let Lbar := Localization.AtPrime (Ideal.map mkJ p)
    have hcomap : Ideal.comap mkJ (Ideal.map mkJ p) = p := Ideal.comap_map_mk hJp
    let g₁ : R →+* Lbar := (algebraMap (R ⧸ J) Lbar).comp mkJ
    have hu₁ : ∀ y : p.primeCompl, IsUnit (g₁ y.1) := by
      intro y
      have hy : mkJ y.1 ∈ (Ideal.map mkJ p).primeCompl := by
        change mkJ y.1 ∉ Ideal.map mkJ p
        intro hmem
        have : y.1 ∈ Ideal.comap mkJ (Ideal.map mkJ p) := hmem
        rw [hcomap] at this
        exact y.2 this
      exact IsLocalization.map_units Lbar ⟨mkJ y.1, hy⟩
    let lift₁ : L →+* Lbar := IsLocalization.lift hu₁
    have hker₁ : ∀ z ∈ JL, lift₁ z = 0 := by
      intro z hz
      have hle : JL ≤ RingHom.ker lift₁ := by
        rw [Ideal.map_le_iff_le_comap]
        intro r hr
        change lift₁ (algebraMap R L r) = 0
        rw [IsLocalization.lift_eq]
        simp only [g₁, RingHom.comp_apply, mkJ]
        rw [Ideal.Quotient.eq_zero_iff_mem.mpr hr, map_zero]
      exact hle hz
    let Φ : L ⧸ JL →+* Lbar := Ideal.Quotient.lift JL lift₁ hker₁
    let g₂ : R →+* L ⧸ JL := (Ideal.Quotient.mk JL).comp (algebraMap R L)
    have hker₂ : ∀ r ∈ J, g₂ r = 0 := by
      intro r hr
      simp only [g₂, RingHom.comp_apply]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem _ hr)
    let desc₂ : R ⧸ J →+* L ⧸ JL := Ideal.Quotient.lift J g₂ hker₂
    have hu₂ : ∀ y : (Ideal.map mkJ p).primeCompl, IsUnit (desc₂ y.1) := by
      intro y
      obtain ⟨r, hr_eq⟩ := Ideal.Quotient.mk_surjective y.1
      have hr : r ∈ p.primeCompl := by
        change r ∉ p
        intro hrp
        apply y.2
        rw [← hr_eq]
        exact Ideal.mem_map_of_mem mkJ hrp
      rw [← hr_eq]
      change IsUnit ((Ideal.Quotient.mk JL) (algebraMap R L r))
      exact (IsLocalization.map_units L ⟨r, hr⟩).map (Ideal.Quotient.mk JL)
    let Ψ : Lbar →+* L ⧸ JL := IsLocalization.lift hu₂
    have hΨΦ : Ψ.comp Φ = RingHom.id (L ⧸ JL) := by
      apply Ideal.Quotient.ringHom_ext
      apply IsLocalization.ringHom_ext p.primeCompl
      ext r
