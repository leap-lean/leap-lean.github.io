by
  obtain ⟨X₃, T₃, pX₃, qX₃, pT₃, rC₃, rX₃, hPair⟩ :=
    weil_algClosed_open_iso_strict_transform_correspondence k
      B₂ U₂ hProjB₂ X₂ hProjX₂ f₂ n σ hFib₂
      B₃ U₃ ψ₃ hProjB₃ hU₃ C₃ g₃ τ₃ hCurve₃ hIntC₃ hProjC₃ hIso₃
  have hPair' := hPair
  obtain ⟨hIntX₃, hProjX₃, hFlatX₃, hSurjX₃, hIntT₃, hProjT₃, hFlatT₃, hSurjT₃, _⟩ := hPair'
  obtain ⟨B, U_good, ψ₄, X_B, T_B, f_XB, q_XB, f_TB, q_TB, hcomm_XB, hcomm_TB,
      hIntB, hProjB, hNormB, hDimB, hUgood, hUgoodSub, hPropψ₄, hSurjψ₄, hIsoψ₄,
      hIntXB, hProjXB, hFlatXB, hClXB, hIsoXB,
      hIntTB, hProjTB, hFlatTB, hClTB, hIsoTB⟩ :=
    weil_algClosed_projective_pair_flattening_normal_base k m
      B₃ U₃ hIntB₃ hProjB₃ hDimB₃ hU₃
      X₃ T₃ pX₃ pT₃
      hIntX₃ hProjX₃ hFlatX₃ hSurjX₃
      hIntT₃ hProjT₃ hFlatT₃ hSurjT₃
  obtain ⟨U_B, C, f, τ, σ_B, pr₁, pr₂, hUB_eq, hUB, hCurve, hIntC, hProjC, hCorr⟩ :=
    weil_algClosed_semistable_pullback_normality_and_threeSecant_lift k
      B₂ U₂ hProjB₂ X₂ hProjX₂ f₂ n σ hFib₂
      B₃ U₃ ψ₃ hProjB₃ C₃ g₃ τ₃ hCurve₃ hIntC₃ hProjC₃
      X₃ T₃ pX₃ qX₃ pT₃ rC₃ rX₃ hPair
      B U_good ψ₄ hIntB hProjB hNormB hUgood hUgoodSub hIsoψ₄
      X_B T_B f_XB q_XB f_TB q_TB hcomm_XB hcomm_TB
      hIntXB hProjXB hFlatXB hClXB hIsoXB
      hIntTB hProjTB hFlatTB hClTB hIsoTB
  have hψ₄ : IsGenFiniteEtaleAlterationOver k ψ₄ := by
    haveI : CategoryTheory.IsIso (ψ₄.left ∣_ U_good) := hIsoψ₄
    exact ⟨hPropψ₄, hSurjψ₄, U_good, hUgood, inferInstance, inferInstance, inferInstance⟩
  have hψ : IsGenFiniteEtaleAlterationOver k (ψ₄ ≫ ψ₃) :=
    weil_gen_finite_etale_alteration_comp k ψ₄ ψ₃ hIntB₃ hψ₄ hψ₃
  have hUBSub : (U_B : Set B.left) ⊆ (ψ₄ ≫ ψ₃).left.base ⁻¹' (U₂ : Set B₂.left) := by
    intro x hx
    have hx_good : ψ₄.left.base x ∈ (U_good : Set B₃.left) := by
      rw [hUB_eq] at hx
      exact hx
    have hx_U₃ : ψ₄.left.base x ∈ (U₃ : Set B₃.left) := hUgoodSub hx_good
    have hx_U₂ : ψ₃.left.base (ψ₄.left.base x) ∈ (U₂ : Set B₂.left) := hU₃Sub hx_U₃
    simpa using hx_U₂
  obtain ⟨γ, hγ, hBdry⟩ :=
    weil_algClosed_contraction_lemma_and_alteration_extension k V U_V
      B₂ U₂ hIntB₂ hProjB₂ X₂ hIntX₂ hProjX₂ f₂ n σ hFib₂ α₂ hBdry₂
      B U_B (ψ₄ ≫ ψ₃) hIntB hProjB hUB hψ hUBSub
      C X_B T_B f τ hCurve hIntC hProjC
      f_XB σ_B (q_XB ≫ qX₃) f_TB pr₁ pr₂ hCorr
  have hβ : IsGenFiniteEtaleAlterationOver k (γ ≫ α₂) :=
    weil_gen_finite_etale_alteration_comp k γ α₂ hIntX₂ hγ hα₂
  exact ⟨B, U_B, hIntB, hProjB, hDimB, hUB, C, f, n, τ, hCurve, hIntC, hProjC, γ ≫ α₂, hβ, hBdry⟩

