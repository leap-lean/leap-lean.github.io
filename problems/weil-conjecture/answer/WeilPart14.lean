import WeilPart13
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem weil_algClosed_correspondence_contraction_no_strict_spec (k : Type u) [Field k] [IsAlgClosed k]
    (B₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (U₂ : B₂.left.Opens)
    (X₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (f₂ : X₂ ⟶ B₂)
    (n : ℕ)
    (σ : Fin n → (B₂ ⟶ X₂))
    (B : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (U_B : B.left.Opens)
    (ψ : B ⟶ B₂)
    (hIntB : AlgebraicGeometry.IsIntegral B.left)
    (hProjB : IsProjectiveOverField k B)
    (hUB : Nonempty U_B)
    (C X_B T_B : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (f : C ⟶ B)
    (τ : Fin n → (B ⟶ C))
    (hCurve : IsSemistablePointedCurveOver k f U_B n τ)
    (hIntC : AlgebraicGeometry.IsIntegral C.left)
    (hProjC : IsProjectiveOverField k C)
    (f_XB : X_B ⟶ B)
    (σ_B : Fin n → (B ⟶ X_B))
    (qX_B : X_B ⟶ X₂)
    (f_TB : T_B ⟶ B)
    (pr₁ : T_B ⟶ C)
    (pr₂ : T_B ⟶ X_B)
    (hCorr : IsFlattenedNormalPointedCorrespondenceOver k f₂ σ ψ U_B f τ f_XB σ_B qX_B f_TB pr₁ pr₂)
    (hLocIsoC : ∀ (c : C.left),
      (∀ (t₀ t₁ : T_B.left),
        pr₁.left.base t₀ = c → pr₁.left.base t₁ = c →
        t₀ ∈ closure ({t₁} : Set T_B.left) → t₀ = t₁) →
      ∃ (V : C.left.Opens), c ∈ V ∧ CategoryTheory.IsIso (pr₁.left ∣_ V))
    (hLocIsoXB : ∀ (W : X_B.left.Opens),
      AlgebraicGeometry.SmoothOfRelativeDimension 1 (W.ι ≫ f_XB.left) →
      ∀ x ∈ W,
      (∀ (t₀ t₁ : T_B.left),
        pr₂.left.base t₀ = x → pr₂.left.base t₁ = x →
        t₀ ∈ closure ({t₁} : Set T_B.left) → t₀ = t₁) →
      ∃ (V : X_B.left.Opens), x ∈ V ∧ V ≤ W ∧ CategoryTheory.IsIso (pr₂.left ∣_ V))
    (hConnXB : ∀ (x : X_B.left),
      IsClosed ({x} : Set X_B.left) →
      (∃ (U : X_B.left.Opens),
        AlgebraicGeometry.IsAffineOpen U ∧ x ∈ U ∧
        IsDomain ↑(X_B.left.presheaf.obj (Opposite.op U)) ∧
        IsIntegrallyClosed ↑(X_B.left.presheaf.obj (Opposite.op U))) →
      topologicalKrullDim ↥{t : T_B.left | pr₂.left.base t = x} ≤ (1 : WithBot ℕ∞) →
      ConnectedSpace ↥{t : T_B.left | pr₂.left.base t = x})
    (s₀ : B.left)
    (hCls₀ : IsClosed ({s₀} : Set B.left))
    (s_bar : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ B.left)
    (hs_bar_hom : s_bar ≫ B.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hs_bar_pt : ∀ pt, s_bar.base pt = s₀)
    (hDimC_fib : ∀ E ∈ irreducibleComponents ↥{c : C.left | f.left.base c = s₀},
      topologicalKrullDim ↥E = (1 : WithBot ℕ∞))
    (hTwoBr : ∀ (c : C.left) (hc : f.left.base c = s₀)
        (E₁ E₂ E₃ : Set ↥{y : C.left | f.left.base y = s₀}),
      E₁ ∈ irreducibleComponents ↥{y : C.left | f.left.base y = s₀} →
      E₂ ∈ irreducibleComponents ↥{y : C.left | f.left.base y = s₀} →
      E₃ ∈ irreducibleComponents ↥{y : C.left | f.left.base y = s₀} →
      (⟨c, hc⟩ : ↥{y : C.left | f.left.base y = s₀}) ∈ E₁ →
      (⟨c, hc⟩ : ↥{y : C.left | f.left.base y = s₀}) ∈ E₂ →
      (⟨c, hc⟩ : ↥{y : C.left | f.left.base y = s₀}) ∈ E₃ →
      ¬(E₁ ≠ E₂ ∧ E₁ ≠ E₃ ∧ E₂ ≠ E₃))
    (hOneBr : ∀ (j : Fin n) (hs_tau : f.left.base ((τ j).left.base s₀) = s₀)
        (E₁ E₂ : Set ↥{y : C.left | f.left.base y = s₀}),
      E₁ ∈ irreducibleComponents ↥{y : C.left | f.left.base y = s₀} →
      E₂ ∈ irreducibleComponents ↥{y : C.left | f.left.base y = s₀} →
      (⟨(τ j).left.base s₀, hs_tau⟩ : ↥{y : C.left | f.left.base y = s₀}) ∈ E₁ →
      (⟨(τ j).left.base s₀, hs_tau⟩ : ↥{y : C.left | f.left.base y = s₀}) ∈ E₂ →
      E₁ = E₂) :
    ∀ (c₁ : C.left) (w₀ w₁ : T_B.left),
      f.left.base c₁ = s₀ →
      pr₁.left.base w₀ = c₁ →
      pr₁.left.base w₁ = c₁ →
      w₀ ∈ closure ({w₁} : Set T_B.left) →
      w₀ = w₁ :=
by
  
  have sub_univ_isIrreducible : ∀ {α : Type u} [TopologicalSpace α] {S : Set α},
      IsIrreducible S → IsIrreducible (Set.univ : Set ↥S) := by
    clear hOneBr hTwoBr hDimC_fib hs_bar_pt hs_bar_hom s_bar hCls₀ s₀ hConnXB hLocIsoXB hLocIsoC
      hCorr pr₂ pr₁ f_TB qX_B σ_B f_XB hProjC hIntC hCurve τ f T_B X_B C hUB hProjB hIntB ψ U_B B
      σ n f₂ X₂ U₂ B₂
    intro α _ S hS
    obtain ⟨x₀, hx₀⟩ := hS.1
    refine ⟨⟨⟨x₀, hx₀⟩, trivial⟩, fun U V hU hV hU_ne hV_ne => ?_⟩
    obtain ⟨U', hU', rfl⟩ := isOpen_induced_iff.mp hU
    obtain ⟨V', hV', rfl⟩ := isOpen_induced_iff.mp hV
    obtain ⟨⟨a, haS⟩, _, haU⟩ := hU_ne
    obtain ⟨⟨b, hbS⟩, _, hbV⟩ := hV_ne
    obtain ⟨c, hcS, hcU, hcV⟩ := hS.2 U' V' hU' hV' ⟨a, haS, haU⟩ ⟨b, hbS, hbV⟩
    exact ⟨⟨c, hcS⟩, trivial, hcU, hcV⟩
  
  have hProjProps : ∀ (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))),
      IsProjectiveOverField k Y →
      TopologicalSpace.NoetherianSpace ↥Y.left ∧
      AlgebraicGeometry.IsSeparated Y.hom ∧
      AlgebraicGeometry.IsProper Y.hom ∧
      AlgebraicGeometry.LocallyOfFiniteType Y.hom := by
    clear sub_univ_isIrreducible hOneBr hTwoBr hDimC_fib hs_bar_pt hs_bar_hom s_bar hCls₀ s₀
      hConnXB hLocIsoXB hLocIsoC hCorr pr₂ pr₁ f_TB qX_B σ_B f_XB hProjC hIntC hCurve τ f
      T_B X_B C hUB hProjB hIntB ψ U_B B σ n f₂ X₂ U₂ B₂
    intro Y hProj
    obtain ⟨N, ι, hCl⟩ := hProj
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    haveI : IsScalarTower k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
      ⟨fun c a p => smul_mul_assoc c a.1 p⟩
    haveI : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
      Algebra.FiniteType.of_restrictScalars_finiteType k _ _
    have hVal0 : ∀ c : k, (algebraMap k ↥(𝒜 0) c).1 = MvPolynomial.C c := fun _ => rfl
    have hBij0 : Function.Bijective (algebraMap k ↥(𝒜 0)) := by
      refine ⟨fun a b hab => ?_, fun x => ⟨MvPolynomial.constantCoeff x.1, Subtype.ext ?_⟩⟩
      · have := congrArg (fun z : ↥(𝒜 0) => MvPolynomial.constantCoeff z.1) hab
        simpa [hVal0] using this
      · rw [hVal0]
        ext d
        by_cases hd : d = 0
        · subst hd
          simp [MvPolynomial.constantCoeff_eq]
        · have h0 : x.1.coeff d = 0 := by
            by_contra hne
            have hw := (MvPolynomial.mem_homogeneousSubmodule 0 x.1).mp x.2 hne
            apply hd
            ext i
            have hsum : (∑ j : Fin (N + 1), d j) = 0 := by
              simpa [Finsupp.weight_apply, Finsupp.linearCombination_apply, Finsupp.sum_fintype] using hw
            exact Finset.sum_eq_zero_iff.mp hsum i (Finset.mem_univ i)
          rw [MvPolynomial.coeff_C, if_neg (Ne.symm hd), h0]
    haveI : IsNoetherianRing ↥(𝒜 0) :=
      isNoetherianRing_of_surjective k ↥(𝒜 0) (algebraMap k ↥(𝒜 0)) hBij0.2
    haveI : CategoryTheory.IsIso (CommRingCat.ofHom (algebraMap k ↥(𝒜 0))) :=
      (ConcreteCategory.isIso_iff_bijective (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))).mpr hBij0
    haveI : AlgebraicGeometry.IsProper (AlgebraicGeometry.Proj.toSpecZero 𝒜) :=
      AlgebraicGeometry.Proj.instIsProperToSpecZeroOfFiniteTypeSubtypeMemOfNatNat 𝒜
    haveI : AlgebraicGeometry.LocallyOfFiniteType (AlgebraicGeometry.Proj.toSpecZero 𝒜) :=
      AlgebraicGeometry.Proj.instLocallyOfFiniteTypeToSpecZeroOfFiniteTypeSubtypeMemOfNatNat 𝒜
    haveI : CompactSpace ↥(AlgebraicGeometry.Proj 𝒜) :=
      AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace (AlgebraicGeometry.Proj.toSpecZero 𝒜)
    haveI : AlgebraicGeometry.IsLocallyNoetherian (AlgebraicGeometry.Proj 𝒜) :=
      AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian (AlgebraicGeometry.Proj.toSpecZero 𝒜)
    haveI : AlgebraicGeometry.IsNoetherian (AlgebraicGeometry.Proj 𝒜) := {}
    haveI : TopologicalSpace.NoetherianSpace ↥(weilProjectiveSpaceOver k N).left := by
      change TopologicalSpace.NoetherianSpace ↥(AlgebraicGeometry.Proj 𝒜)
      exact AlgebraicGeometry.IsNoetherian.noetherianSpace
    have hNoethY : TopologicalSpace.NoetherianSpace ↥Y.left :=
      ι.left.isClosedEmbedding.toIsEmbedding.toIsInducing.noetherianSpace
    haveI : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver k N).hom := by
      change AlgebraicGeometry.IsProper (AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0))))
      infer_instance
    haveI : AlgebraicGeometry.LocallyOfFiniteType (weilProjectiveSpaceOver k N).hom := by
      change AlgebraicGeometry.LocallyOfFiniteType (AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0))))
      infer_instance
    have hEq : ι.left ≫ (weilProjectiveSpaceOver k N).hom = Y.hom := CategoryTheory.Over.w ι
    have hPropY : AlgebraicGeometry.IsProper Y.hom := by rw [← hEq]; infer_instance
    have hFTY : AlgebraicGeometry.LocallyOfFiniteType Y.hom := by rw [← hEq]; infer_instance
    haveI := hPropY
    exact ⟨hNoethY, inferInstance, hPropY, hFTY⟩
  
  have hPillar1 : ∀ (X Y : Type u) [TopologicalSpace X] [T0Space X] [TopologicalSpace.NoetherianSpace X]
      [TopologicalSpace Y] [T0Space Y],
      topologicalKrullDim X ≤ (1 : WithBot ℕ∞) →
      (∀ E ∈ irreducibleComponents Y, topologicalKrullDim ↥E = (1 : WithBot ℕ∞)) →
      ∀ (p : X → Y), Continuous p → IsClosedMap p →
      ∀ (F : Set X), IsClosed F → ConnectedSpace ↥F →
      ∀ (y₀ y₁ : Y), IsClosed ({y₀} : Set Y) → y₀ ≠ y₁ → y₀ ∈ p '' F → y₁ ∈ p '' F →
      ∃ (T : Set X) (C : Set Y),
        T ∈ irreducibleComponents X ∧
        C ∈ irreducibleComponents Y ∧
        T ⊆ F ∧
        p '' T = C ∧
        y₀ ∈ C := by
    clear hProjProps hOneBr hTwoBr hDimC_fib hs_bar_pt hs_bar_hom s_bar hCls₀ s₀
      hConnXB hLocIsoXB hLocIsoC hCorr pr₂ pr₁ f_TB qX_B σ_B f_XB hProjC hIntC hCurve τ f
      T_B X_B C hUB hProjB hIntB ψ U_B B σ n f₂ X₂ U₂ B₂
    intro X Y _ _ _ _ _ hDimX hDimY p hp_cont hp_closed F hF_closed hF_conn
      y₀ y₁ hy₀_cl hne hy₀ hy₁
    obtain ⟨S, hS_fin, hS_cl, hS_irr, hF_eq⟩ :=
      TopologicalSpace.NoetherianSpace.exists_finite_set_isClosed_irreducible hF_closed
    have hS_sub : ∀ B ∈ S, B ⊆ F := fun B hB x hx => hF_eq ▸ Set.mem_sUnion.mpr ⟨B, hB, hx⟩
    let S₁ := {B ∈ S | y₀ ∈ p '' B}
    let S₂ := {B ∈ S | y₀ ∉ p '' B}
    have hS₁_fin : S₁.Finite := hS_fin.subset (fun _ h => h.1)
    have hS₂_fin : S₂.Finite := hS_fin.subset (fun _ h => h.1)
    let A₁ := ⋃ B ∈ S₁, p '' B
    let A₂ := ⋃ B ∈ S₂, p '' B
    have hA₁_cl : IsClosed A₁ :=
      hS₁_fin.isClosed_biUnion (fun B hB => hp_closed B (hS_cl B hB.1))
    have hA₂_cl : IsClosed A₂ :=
      hS₂_fin.isClosed_biUnion (fun B hB => hp_closed B (hS_cl B hB.1))
    have hpF_union : p '' F ⊆ A₁ ∪ A₂ := by
      rintro z ⟨x, hxF, rfl⟩
      rw [hF_eq, Set.mem_sUnion] at hxF
      obtain ⟨B, hBS, hxB⟩ := hxF
      by_cases hyB : y₀ ∈ p '' B
      · exact Or.inl (Set.mem_biUnion (show B ∈ S₁ from ⟨hBS, hyB⟩) ⟨x, hxB, rfl⟩)
      · exact Or.inr (Set.mem_biUnion (show B ∈ S₂ from ⟨hBS, hyB⟩) ⟨x, hxB, rfl⟩)
    have hy₀_not_A₂ : y₀ ∉ A₂ := by
      intro hmem
      obtain ⟨B, hB₂, hyB⟩ := Set.mem_iUnion₂.mp hmem
      exact hB₂.2 hyB
    have hpF_preconn : IsPreconnected (p '' F) := by
      have hEq : p '' F = (p ∘ (Subtype.val : ↥F → X)) '' Set.univ := by
        ext z; simp
      rw [hEq]
      exact isConnected_univ.isPreconnected.image _ (hp_cont.comp continuous_subtype_val).continuousOn
    have hExistsB₀ : ∃ B₀ ∈ S₁, ∃ z₁ ∈ p '' B₀, z₁ ≠ y₀ := by
      by_contra hAll
      push_neg at hAll
      have hA₁_sub : A₁ ⊆ {y₀} := by
        rintro z hz
        obtain ⟨B, hB₁, hzB⟩ := Set.mem_iUnion₂.mp hz
        exact Set.mem_singleton_iff.mpr (hAll B hB₁ z hzB)
      have hInterEmpty : p '' F ∩ (A₁ ∩ A₂) = ∅ := by
        ext z
        simp only [Set.mem_inter_iff, Set.mem_empty_iff_false, iff_false]
        rintro ⟨_, hz1, hz2⟩
        have hzy : z = y₀ := Set.mem_singleton_iff.mp (hA₁_sub hz1)
        subst hzy
        exact hy₀_not_A₂ hz2
      cases isPreconnected_iff_subset_of_disjoint_closed.mp hpF_preconn A₁ A₂ hA₁_cl hA₂_cl
        hpF_union hInterEmpty with
      | inl hSub1 =>
        have hy₁_eq : y₁ = y₀ := Set.mem_singleton_iff.mp (hA₁_sub (hSub1 hy₁))
        exact hne hy₁_eq.symm
      | inr hSub2 =>
        exact hy₀_not_A₂ (hSub2 hy₀)
    obtain ⟨B₀, ⟨hB₀_S, hy₀_B₀⟩, z₁, hz₁_B₀, hz₁_ne⟩ := hExistsB₀
    have hClB₀ : IsClosed B₀ := hS_cl B₀ hB₀_S
    have hIrrB₀ : IsIrreducible B₀ := hS_irr B₀ hB₀_S
    have hIrr_pB₀ : IsIrreducible (p '' B₀) := hIrrB₀.image p hp_cont.continuousOn
    have hCl_pB₀ : IsClosed (p '' B₀) := hp_closed B₀ hClB₀
    obtain ⟨C, hC_comp, hpB₀_sub_C⟩ :=
      exists_mem_irreducibleComponents_subset_of_isIrreducible _ hIrr_pB₀
    have hIrrC : IsIrreducible C := hC_comp.1
    have hy₀_C : y₀ ∈ C := hpB₀_sub_C hy₀_B₀
    have hz₁_C : z₁ ∈ C := hpB₀_sub_C hz₁_B₀
    have hpB₀_eq_C : p '' B₀ = C := by
      by_contra hne_C
      have hStrict : ∃ w ∈ C, w ∉ p '' B₀ := by
        by_contra hall; push_neg at hall
        exact hne_C (Set.Subset.antisymm hpB₀_sub_C hall)
      obtain ⟨w, hwC, hw_not⟩ := hStrict
      let K₀ : TopologicalSpace.IrreducibleCloseds ↥C :=
        { carrier := {(⟨y₀, hy₀_C⟩ : ↥C)}
          isIrreducible' := isIrreducible_singleton
          isClosed' := by
            have : ({(⟨y₀, hy₀_C⟩ : ↥C)} : Set ↥C) = Subtype.val ⁻¹' ({y₀} : Set Y) := by
              ext u; simp [Subtype.ext_iff]
            rw [this]
            exact hy₀_cl.preimage continuous_subtype_val }
      let K₁ : TopologicalSpace.IrreducibleCloseds ↥C :=
        { carrier := Subtype.val ⁻¹' (p '' B₀)
          isIrreducible' := by
            let incl : ↥(p '' B₀) → ↥C := fun x => ⟨x.1, hpB₀_sub_C x.2⟩
            have hContIncl : Continuous incl := Continuous.subtype_mk continuous_subtype_val _
            have hEqIm : Subtype.val ⁻¹' (p '' B₀) = incl '' (Set.univ : Set ↥(p '' B₀)) := by
              ext ⟨z, hzC⟩
              simp only [Set.mem_preimage, Set.mem_image, Set.mem_univ, true_and, incl]
              exact ⟨fun hz => ⟨⟨z, hz⟩, rfl⟩, fun ⟨⟨z', hz'⟩, h⟩ => by cases h; exact hz'⟩
            rw [hEqIm]
            exact (sub_univ_isIrreducible hIrr_pB₀).image incl hContIncl.continuousOn
          isClosed' := hCl_pB₀.preimage continuous_subtype_val }
      let K₂ : TopologicalSpace.IrreducibleCloseds ↥C :=
        { carrier := Set.univ
          isIrreducible' := sub_univ_isIrreducible hIrrC
          isClosed' := isClosed_univ }
      have h01 : K₀ < K₁ := by
        refine lt_of_le_of_ne (fun u hu => ?_) (fun hEq => ?_)
        · rw [Set.mem_singleton_iff.mp hu]; exact hy₀_B₀
        · have hz_mem : (⟨z₁, hz₁_C⟩ : ↥C) ∈ K₁.carrier := hz₁_B₀
          rw [← congrArg TopologicalSpace.IrreducibleCloseds.carrier hEq] at hz_mem
          exact hz₁_ne (congrArg Subtype.val (Set.mem_singleton_iff.mp hz_mem))
      have h12 : K₁ < K₂ := by
        refine lt_of_le_of_ne (fun _ _ => trivial) (fun hEq => hw_not ?_)
        have hw_mem : (⟨w, hwC⟩ : ↥C) ∈ K₂.carrier := trivial
        rwa [← congrArg TopologicalSpace.IrreducibleCloseds.carrier hEq] at hw_mem
      let s : LTSeries (TopologicalSpace.IrreducibleCloseds ↥C) :=
        RelSeries.snoc (RelSeries.snoc (RelSeries.singleton _ K₀) K₁ h01) K₂ h12
      have hlen : ((2 : ℕ) : WithBot ℕ∞) ≤ topologicalKrullDim ↥C :=
        le_iSup (fun (q : LTSeries (TopologicalSpace.IrreducibleCloseds ↥C)) =>
          (q.length : WithBot ℕ∞)) s
      rw [hDimY C hC_comp] at hlen
      norm_cast at hlen
    obtain ⟨T, hT_comp, hB₀_sub_T⟩ :=
      exists_mem_irreducibleComponents_subset_of_isIrreducible _ hIrrB₀
    have hB₀_eq_T : B₀ = T := by
      by_contra hne_T
      have hStrictT : ∃ u ∈ T, u ∉ B₀ := by
        by_contra hall; push_neg at hall
        exact hne_T (Set.Subset.antisymm hB₀_sub_T hall)
      obtain ⟨u, huT, hu_not⟩ := hStrictT
      obtain ⟨x₀, hx₀B₀, hx₀_eq⟩ := hy₀_B₀
      obtain ⟨x₁, hx₁B₀, hx₁_eq⟩ := hz₁_B₀
      let L₀ : TopologicalSpace.IrreducibleCloseds X :=
        { carrier := closure ({x₀} : Set X)
          isIrreducible' := isIrreducible_singleton.closure
          isClosed' := isClosed_closure }
      let L₁ : TopologicalSpace.IrreducibleCloseds X :=
        { carrier := B₀
          isIrreducible' := hIrrB₀
          isClosed' := hClB₀ }
      let L₂ : TopologicalSpace.IrreducibleCloseds X :=
        { carrier := T
          isIrreducible' := hT_comp.1
          isClosed' := isClosed_of_mem_irreducibleComponents T hT_comp }
      have hL01 : L₀ < L₁ := by
        refine lt_of_le_of_ne (closure_minimal (Set.singleton_subset_iff.mpr hx₀B₀) hClB₀) (fun hEq => ?_)
        have hx₁_cl : x₁ ∈ closure ({x₀} : Set X) := by
          have : x₁ ∈ L₁.carrier := hx₁B₀
          rwa [← congrArg TopologicalSpace.IrreducibleCloseds.carrier hEq] at this
        have hSub_pre : closure ({x₀} : Set X) ⊆ p ⁻¹' ({y₀} : Set Y) :=
          closure_minimal (Set.singleton_subset_iff.mpr hx₀_eq) (hy₀_cl.preimage hp_cont)
        exact hz₁_ne (hx₁_eq.symm.trans (Set.mem_singleton_iff.mp (hSub_pre hx₁_cl)))
      have hL12 : L₁ < L₂ := by
        refine lt_of_le_of_ne hB₀_sub_T (fun hEq => hu_not ?_)
        have : u ∈ L₂.carrier := huT
        rwa [← congrArg TopologicalSpace.IrreducibleCloseds.carrier hEq] at this
      let sX : LTSeries (TopologicalSpace.IrreducibleCloseds X) :=
