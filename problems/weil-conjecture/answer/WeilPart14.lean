    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hIntX : AlgebraicGeometry.IsIntegral X.left)
    [TopologicalSpace.NoetherianSpace ↥X.left]
    (I : X.left.IdealSheafData)
    (hSupp : (I.support : Set X.left) ≠ Set.univ)
    (U_compl : X.left.Opens)
    {m : ℕ} (U_cov : Fin m → X.left.affineOpens) (L : ℕ)
    (h : ∀ i : Fin m, Fin (L + 1) → ↑(X.left.presheaf.obj (Opposite.op (U_cov i).1)))
    (Φ₀ : U_compl.toScheme ⟶ (weilProjectiveSpaceOver k L).left)
    (hΦ₀ : Φ₀ ≫ (weilProjectiveSpaceOver k L).hom = U_compl.ι ≫ X.hom)
    (hRat : IsIdealCocycleRationalMapToProj k I U_compl U_cov L h Φ₀)
    (U : X.left.affineOpens) (B' : CommRingCat.{u})
    (φ_U : ↑(X.left.presheaf.obj (Opposite.op U.1)) →+* B')
    (r : ℕ) (g : Fin r → B')
    (hFlat : AlgebraicGeometry.Flat (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_U)))
    (hg_nzd : ∀ b : Fin r, g b ∈ nonZeroDivisors B')
    (hSpan : Ideal.map φ_U (I.ideal U) = Ideal.span (Set.range g)) :
    let P_L := weilProjectiveSpaceOver k L
    let δ : U_compl.toScheme ⟶ CategoryTheory.Limits.pullback X.hom P_L.hom :=
