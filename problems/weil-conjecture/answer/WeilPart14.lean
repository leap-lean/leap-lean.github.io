          exact ((CategoryTheory.Category.assoc (pR ≫ (θ (i', j')).hom) _ _).trans
            ((congrArg ((pR ≫ (θ (i', j')).hom) ≫ ·)
              (AlgebraicGeometry.pullbackSpecIso_inv_snd k (A i') (B j'))).trans
              ((CategoryTheory.Category.assoc pR (θ (i', j')).hom _).trans
                (congrArg (pR ≫ ·) (hθ_snd (i', j')))))).symm
      have hqO_R : q_O ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_R) =
          pR ≫ (θ i'j').hom := hqO_R'
      have hw_eq : AlgebraicGeometry.Spec.map (CommRingCat.ofHom awayL_N) ≫ w_N ν =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom awayR_N) ≫ w_N ν' :=
        (AlgebraicGeometry.Proj.SpecMap_awayMap_awayι 𝒜_N (hX_N ν) zero_lt_one (hX_N ν') rfl).trans
