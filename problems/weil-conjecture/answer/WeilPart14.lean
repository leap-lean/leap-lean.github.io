    · intro p ⟨j, hj_er, hjp_mem⟩
      have hj_ne : j ≠ j_piv := Finset.ne_of_mem_erase hj_er
      let _ : Algebra (MvPolynomial (Fin (m + 1)) k) R₁ := ψ_loc.toAlgebra
      have _ : Algebra.Etale (MvPolynomial (Fin (m + 1)) k) R₁ :=
