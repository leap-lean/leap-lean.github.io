      obtain ⟨T₁, C₁, hT₁, hC₁, hConst₁, hIm₁, hc₁_C₁⟩ :=
        hMakeBranch j₁ W₁ hx₁ hx₁_Xi hCl_x₁ hx₁W₁ hSmW₁ hc1'
      obtain ⟨T₃, C₃, hT₃, hC₃, hConst₃, hIm₃, hc₁_C₃⟩ :=
        hMakeBranch j₃ W₃ hx₃ hx₃_Xi hCl_x₃ hx₃W₃ hSmW₃ hc3
      have hne13 : C₁ ≠ C₃ := hDistComp hx13 hT₁ hT₃ hC₁ hConst₁ hConst₃ hIm₁ hIm₃
      have hSubEq : (⟨(τ j₂).left.base s₀, hTau_s j₂⟩ :
          ↥{y : C.left | f.left.base y = s₀}) = ⟨c₁, hc₁⟩ := Subtype.ext h2.symm
      exact hne13 (hOneBr j₂ (hTau_s j₂) C₁ C₃ hC₁ hC₃ (hSubEq.symm ▸ hc₁_C₁) (hSubEq.symm ▸ hc₁_C₃))
    · by_cases h3 : c₁ = (τ j₃).left.base s₀
      · have hc1' : c₁ ≠ (τ j₁).left.base s₀ := h3 ▸ hTau_ne hj13.symm
        have hc2' : c₁ ≠ (τ j₂).left.base s₀ := h3 ▸ hTau_ne hj23.symm
        obtain ⟨T₁, C₁, hT₁, hC₁, hConst₁, hIm₁, hc₁_C₁⟩ :=
          hMakeBranch j₁ W₁ hx₁ hx₁_Xi hCl_x₁ hx₁W₁ hSmW₁ hc1'
        obtain ⟨T₂, C₂, hT₂, hC₂, hConst₂, hIm₂, hc₁_C₂⟩ :=
          hMakeBranch j₂ W₂ hx₂ hx₂_Xi hCl_x₂ hx₂W₂ hSmW₂ hc2'
        have hne12 : C₁ ≠ C₂ := hDistComp hx12 hT₁ hT₂ hC₁ hConst₁ hConst₂ hIm₁ hIm₂
        have hSubEq : (⟨(τ j₃).left.base s₀, hTau_s j₃⟩ :
            ↥{y : C.left | f.left.base y = s₀}) = ⟨c₁, hc₁⟩ := Subtype.ext h3.symm
        exact hne12 (hOneBr j₃ (hTau_s j₃) C₁ C₂ hC₁ hC₂ (hSubEq.symm ▸ hc₁_C₁) (hSubEq.symm ▸ hc₁_C₂))
      · obtain ⟨T₁, C₁, hT₁, hC₁, hConst₁, hIm₁, hc₁_C₁⟩ :=
          hMakeBranch j₁ W₁ hx₁ hx₁_Xi hCl_x₁ hx₁W₁ hSmW₁ h1
        obtain ⟨T₂, C₂, hT₂, hC₂, hConst₂, hIm₂, hc₁_C₂⟩ :=
          hMakeBranch j₂ W₂ hx₂ hx₂_Xi hCl_x₂ hx₂W₂ hSmW₂ h2
        obtain ⟨T₃, C₃, hT₃, hC₃, hConst₃, hIm₃, hc₁_C₃⟩ :=
          hMakeBranch j₃ W₃ hx₃ hx₃_Xi hCl_x₃ hx₃W₃ hSmW₃ h3
        exact hTwoBr c₁ hc₁ C₁ C₂ C₃ hC₁ hC₂ hC₃ hc₁_C₁ hc₁_C₂ hc₁_C₃
          ⟨hDistComp hx12 hT₁ hT₂ hC₁ hConst₁ hConst₂ hIm₁ hIm₂,
           hDistComp hx13 hT₁ hT₃ hC₁ hConst₁ hConst₃ hIm₁ hIm₃,
           hDistComp hx23 hT₂ hT₃ hC₂ hConst₂ hConst₃ hIm₂ hIm₃⟩

theorem weil_algClosed_alteration_and_bdry_of_correspondence_iso (k : Type u) [Field k] [IsAlgClosed k]
    (V : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (U_V : V.left.Opens)
    (B₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (U₂ : B₂.left.Opens)
    (hIntB₂ : AlgebraicGeometry.IsIntegral B₂.left)
    (hProjB₂ : IsProjectiveOverField k B₂)
    (X₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hIntX₂ : AlgebraicGeometry.IsIntegral X₂.left)
    (hProjX₂ : IsProjectiveOverField k X₂)
    (f₂ : X₂ ⟶ B₂)
    (n : ℕ)
    (σ : Fin n → (B₂ ⟶ X₂))
    (hFib₂ : IsThreeSecantPointedCurveFibOver k f₂ U₂ n σ)
    (α₂ : X₂ ⟶ V)
    (hBdry₂ : α₂.left.base ⁻¹' ((U_V : Set V.left)ᶜ) ⊆
      f₂.left.base ⁻¹' ((U₂ : Set B₂.left)ᶜ) ∪
        ⋃ j : Fin n, Set.range (σ j).left.base)
    (B : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (U_B : B.left.Opens)
    (ψ : B ⟶ B₂)
    (hIntB : AlgebraicGeometry.IsIntegral B.left)
    (hProjB : IsProjectiveOverField k B)
    (hUB : Nonempty U_B)
    (hψ : IsGenFiniteEtaleAlterationOver k ψ)
    (hUBSub : (U_B : Set B.left) ⊆ ψ.left.base ⁻¹' (U₂ : Set B₂.left))
    (C X_B T_B : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (f : C ⟶ B)
    (τ : Fin n → (B ⟶ C))
    (hCurve : IsSemistablePointedCurveOver k f U_B n τ)
    (hIntC : AlgebraicGeometry.IsIntegral C.left)
    (hProjC : IsProjectiveOverField k C)
    (f_XB : X_B ⟶ B)
    (σ_B : Fin n → (B ⟶ X_B))
    (qX_B : X_B ⟶ X₂)
    (f_TB : T_B ⟶ B)
    (pr₁ : T_B ⟶ C)
    (pr₂ : T_B ⟶ X_B)
    (hCorr : IsFlattenedNormalPointedCorrespondenceOver k f₂ σ ψ U_B f τ f_XB σ_B qX_B f_TB pr₁ pr₂)
    (hIsoPr₁ : CategoryTheory.IsIso pr₁.left) :
    ∃ (γ : C ⟶ X₂),
      IsGenFiniteEtaleAlterationOver k γ ∧
      (γ ≫ α₂).left.base ⁻¹' ((U_V : Set V.left)ᶜ) ⊆
        f.left.base ⁻¹' ((U_B : Set B.left)ᶜ) ∪
          ⋃ j : Fin n, Set.range (τ j).left.base :=
by
  have hCompBase : ∀ {X Y Z : AlgebraicGeometry.Scheme.{u}} (u : X ⟶ Y) (v : Y ⟶ Z) (x : X),
      (u ≫ v).base x = v.base (u.base x) := by
    intro X Y Z u v x
    exact AlgebraicGeometry.Scheme.Hom.comp_apply u v x
  have hIdBase : ∀ {X : AlgebraicGeometry.Scheme.{u}} (x : X),
      (𝟙 X : X ⟶ X).base x = x := by
    intro X x
    simp
  have hCompIso : ∀ {X Y Z : AlgebraicGeometry.Scheme.{u}} (u : X ⟶ Y) (v : Y ⟶ Z),
      CategoryTheory.IsIso u → CategoryTheory.IsIso v → CategoryTheory.IsIso (u ≫ v) := by
    intro X Y Z u v hu hv
    haveI := hu; haveI := hv
    infer_instance
  have hIsoRestrict : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (u : X ⟶ Y) (U : Y.Opens),
      CategoryTheory.IsIso u → CategoryTheory.IsIso (u ∣_ U) := by
    intro X Y u U hu
    haveI := hu
    infer_instance
  have hFinOfIsoComp : ∀ {X Y Z : AlgebraicGeometry.Scheme.{u}} (u : X ⟶ Y) (v : Y ⟶ Z),
      CategoryTheory.IsIso u → AlgebraicGeometry.IsFinite v →
      AlgebraicGeometry.IsFinite (u ≫ v) := by
    intro X Y Z u v hu hv
    haveI := hu; haveI := hv
    infer_instance
  have hEtOfIsoComp : ∀ {X Y Z : AlgebraicGeometry.Scheme.{u}} (u : X ⟶ Y) (v : Y ⟶ Z),
      CategoryTheory.IsIso u → AlgebraicGeometry.Etale v →
      AlgebraicGeometry.Etale (u ≫ v) := by
    intro X Y Z u v hu hv
    haveI := hu; haveI := hv
    infer_instance
  have hSurjOfIsoComp : ∀ {X Y Z : AlgebraicGeometry.Scheme.{u}} (u : X ⟶ Y) (v : Y ⟶ Z),
      CategoryTheory.IsIso u → AlgebraicGeometry.Surjective v →
      AlgebraicGeometry.Surjective (u ≫ v) := by
    intro X Y Z u v hu hv
    haveI := hu; haveI := hv
    infer_instance
  have hPbRestrictLE : ∀ {Y₂ Y₁ : AlgebraicGeometry.Scheme.{u}} (g : Y₂ ⟶ Y₁)
      {W U : Y₁.Opens} (hWU : W ≤ U),
      ∃ top_hom : ↑(g ⁻¹ᵁ W) ⟶ ↑(g ⁻¹ᵁ U),
        CategoryTheory.IsPullback top_hom (g ∣_ W) (g ∣_ U) (Y₁.homOfLE hWU) := by
    intro Y₂ Y₁ g W U hWU
    have hs : CategoryTheory.IsPullback
        (g ⁻¹ᵁ W).ι (g ∣_ W) g (Y₁.homOfLE hWU ≫ U.ι) := by
      rw [Y₁.homOfLE_ι hWU]
      exact (AlgebraicGeometry.isPullback_morphismRestrict g W).flip
    exact ⟨_, CategoryTheory.IsPullback.of_right' hs
      (AlgebraicGeometry.isPullback_morphismRestrict g U).flip⟩
  
  haveI : CategoryTheory.IsIso pr₁.left := hIsoPr₁
  let inv_pr₁_left : C.left ⟶ T_B.left := CategoryTheory.inv pr₁.left
  have h_inv_over : inv_pr₁_left ≫ T_B.hom = C.hom := by
    rw [← CategoryTheory.Over.w pr₁]
    exact CategoryTheory.IsIso.inv_hom_id_assoc pr₁.left C.hom
  let inv_pr₁ : C ⟶ T_B := CategoryTheory.Over.homMk inv_pr₁_left h_inv_over
  have h_pr₁_inv : pr₁ ≫ inv_pr₁ = 𝟙 T_B := by
    apply CategoryTheory.Over.OverMorphism.ext
    change pr₁.left ≫ inv_pr₁_left = 𝟙 T_B.left
    exact CategoryTheory.IsIso.hom_inv_id pr₁.left
  let γ : C ⟶ X₂ := inv_pr₁ ≫ pr₂ ≫ qX_B
  rcases hCorr with ⟨_hn, _hNormB, _hNormC, _hIntXB, _hProjXB, _hPropXB, _hFlatXB, _hSurjXB,
    hSecXB, ⟨hcommXB, hIsoXB_pb⟩, _hNormSmoothXB, _hThreeSecXB, _hIntTB, _hProjTB, _hFlatTB,
    ⟨hcommTB, _, _, _⟩, _hIsoPr₁U, hIsoPr₂U, hLiftTau⟩
  have hf_eq : inv_pr₁_left ≫ pr₂.left ≫ f_XB.left = f.left := by
    rw [← hcommTB]
    exact CategoryTheory.IsIso.inv_hom_id_assoc pr₁.left f.left
  have hcomm_γ : γ.left ≫ f₂.left = f.left ≫ ψ.left := by
    change (inv_pr₁_left ≫ pr₂.left ≫ qX_B.left) ≫ f₂.left = f.left ≫ ψ.left
    calc (inv_pr₁_left ≫ pr₂.left ≫ qX_B.left) ≫ f₂.left
      _ = inv_pr₁_left ≫ pr₂.left ≫ (qX_B.left ≫ f₂.left) := by simp only [Category.assoc]
      _ = inv_pr₁_left ≫ pr₂.left ≫ (f_XB.left ≫ ψ.left) := by rw [hcommXB]
      _ = (inv_pr₁_left ≫ pr₂.left ≫ f_XB.left) ≫ ψ.left := by simp only [Category.assoc]
      _ = f.left ≫ ψ.left := by rw [hf_eq]
  have hτγ : ∀ j : Fin n, (τ j).left ≫ γ.left = ψ.left ≫ (σ j).left := by
    intro j
    obtain ⟨τ_tilde, hτ₁, hτ₂⟩ := hLiftTau j
    have h_over : τ j ≫ γ = ψ ≫ σ j := by
      calc τ j ≫ γ
        _ = (τ_tilde ≫ pr₁) ≫ inv_pr₁ ≫ pr₂ ≫ qX_B := by rw [← hτ₁]
        _ = τ_tilde ≫ (pr₁ ≫ inv_pr₁) ≫ pr₂ ≫ qX_B := by simp only [Category.assoc]
        _ = (τ_tilde ≫ pr₂) ≫ qX_B := by rw [h_pr₁_inv, Category.id_comp, Category.assoc]
        _ = σ_B j ≫ qX_B := by rw [hτ₂]
        _ = ψ ≫ σ j := (hSecXB j).2
    exact congrArg CommaMorphism.left h_over
  have hProp_γ : AlgebraicGeometry.IsProper γ.left := by
    haveI : AlgebraicGeometry.IsProper f.left := hCurve.2.1
    haveI : AlgebraicGeometry.IsProper ψ.left := hψ.1
    haveI : AlgebraicGeometry.IsProper f₂.left := hFib₂.2.1.1
    have hPropComp : AlgebraicGeometry.IsProper (γ.left ≫ f₂.left) := by
      rw [hcomm_γ]
      infer_instance
    exact (AlgebraicGeometry.IsProper.comp_iff (f := γ.left) (g := f₂.left)).mp hPropComp
  let P := CategoryTheory.Limits.pullback f₂.left ψ.left
  let fst : P ⟶ X₂.left := CategoryTheory.Limits.pullback.fst f₂.left ψ.left
  let snd : P ⟶ B.left := CategoryTheory.Limits.pullback.snd f₂.left ψ.left
  let W_B_pb : P.Opens := (TopologicalSpace.Opens.map snd.base).obj U_B
  let V_XB : X_B.left.Opens := (TopologicalSpace.Opens.map f_XB.left.base).obj U_B
  let g₃ : X_B.left ⟶ P := CategoryTheory.Limits.pullback.lift qX_B.left f_XB.left hcommXB
  let L_γ : C.left ⟶ P := CategoryTheory.Limits.pullback.lift γ.left f.left hcomm_γ
  have hL_eq : L_γ = inv_pr₁_left ≫ pr₂.left ≫ g₃ := by
    apply CategoryTheory.Limits.pullback.hom_ext
    · simp only [L_γ, g₃, Category.assoc, CategoryTheory.Limits.pullback.lift_fst]
      rfl
    · simp only [L_γ, g₃, Category.assoc, CategoryTheory.Limits.pullback.lift_snd]
      exact hf_eq.symm
  have hOpenEq : g₃ ⁻¹ᵁ W_B_pb = V_XB := by
    ext x
    change snd.base (g₃.base x) ∈ U_B ↔ f_XB.left.base x ∈ U_B
    rw [← hCompBase g₃ snd x, CategoryTheory.Limits.pullback.lift_snd]
  have hIsoLγ : CategoryTheory.IsIso (L_γ ∣_ W_B_pb) := by
    have hIso₂ : CategoryTheory.IsIso (pr₂.left ∣_ (g₃ ⁻¹ᵁ W_B_pb)) := by
      rw [hOpenEq]
      exact hIsoPr₂U
    rw [hL_eq, AlgebraicGeometry.morphismRestrict_comp, AlgebraicGeometry.morphismRestrict_comp]
    exact hCompIso _ _ (hIsoRestrict inv_pr₁_left _ inferInstance)
      (hCompIso _ _ hIso₂ hIsoXB_pb)
  
  rcases hψ with ⟨hPropψ, hSurjψ, U_ψ, hUψ, hFinψ, hEtψ, hSurjψU⟩
  obtain ⟨⟨y₁, hy₁⟩⟩ := hUψ
  obtain ⟨V₁, hAffV₁, hy₁V₁, hV₁_le⟩ :=
    AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hy₁
  let V₂ : B.left.Opens := (TopologicalSpace.Opens.map ψ.left.base).obj V₁
  have hFinV₁ : AlgebraicGeometry.IsFinite (ψ.left ∣_ V₁) := by
    obtain ⟨_, hPbV₁⟩ := hPbRestrictLE ψ.left (show V₁ ≤ U_ψ from hV₁_le)
    exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPbV₁ hFinψ
  haveI : AlgebraicGeometry.IsFinite (ψ.left ∣_ V₁) := hFinV₁
  haveI : AlgebraicGeometry.IsAffine V₁.toScheme := hAffV₁
  haveI : AlgebraicGeometry.IsAffine V₂.toScheme :=
    AlgebraicGeometry.isAffine_of_isAffineHom (ψ.left ∣_ V₁)
  haveI : AlgebraicGeometry.Surjective ψ.left := hSurjψ
  obtain ⟨y₂, hy₂_eq⟩ := ψ.left.surjective y₁
  have hy₂V₂ : y₂ ∈ (V₂ : Set B.left) := by
    change ψ.left.base y₂ ∈ V₁
    rw [hy₂_eq]
    exact hy₁V₁
  have hy₂_range : y₂ ∈ Set.range ⇑V₂.ι := by
    rw [AlgebraicGeometry.Scheme.Opens.range_ι]
    exact hy₂V₂
  obtain ⟨y₂_pt, _⟩ := hy₂_range
  haveI : Nonempty V₂.toScheme := ⟨y₂_pt⟩
  haveI : AlgebraicGeometry.IsIntegral B.left := hIntB
  haveI : AlgebraicGeometry.IsIntegral V₂.toScheme :=
    AlgebraicGeometry.isIntegral_of_isOpenImmersion V₂.ι
  let A₁ := V₁.toScheme.presheaf.obj (Opposite.op ⊤)
  let A₂ := V₂.toScheme.presheaf.obj (Opposite.op ⊤)
  let p_bot : PrimeSpectrum ↑A₂ := ⊥
  let p_bot_pt : AlgebraicGeometry.Spec (V₂.toScheme.presheaf.obj (Opposite.op ⊤)) := p_bot
  let z₀ : V₂.toScheme := V₂.toScheme.isoSpec.inv.base p_bot_pt
  let z₂ : B.left := V₂.ι.base z₀
  have hz₂V₂ : z₂ ∈ (V₂ : Set B.left) := by
    rw [← AlgebraicGeometry.Scheme.Opens.range_ι]
    exact ⟨z₀, rfl⟩
  have hz₂Uψ : ψ.left.base z₂ ∈ U_ψ := hV₁_le hz₂V₂
  have hz₂UB : z₂ ∈ U_B := by
    haveI : IrreducibleSpace B.left :=
      AlgebraicGeometry.irreducibleSpace_of_isIntegral B.left
    obtain ⟨⟨b₀, hb₀⟩⟩ := hUB
    obtain ⟨w₂, hw₂V₂, hw₂UB⟩ := nonempty_preirreducible_inter
      V₂.isOpen U_B.isOpen ⟨y₂, hy₂V₂⟩ ⟨b₀, hb₀⟩
    have hw₂_range : w₂ ∈ Set.range ⇑V₂.ι := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      exact hw₂V₂
    obtain ⟨w₀, hw₀_eq⟩ := hw₂_range
    have h_spec₀ : p_bot ⤳ V₂.toScheme.isoSpec.hom.base w₀ :=
      (PrimeSpectrum.le_iff_specializes p_bot (V₂.toScheme.isoSpec.hom.base w₀)).mp bot_le
    have h_spec₁ : z₀ ⤳ V₂.toScheme.isoSpec.inv.base (V₂.toScheme.isoSpec.hom.base w₀) :=
      h_spec₀.map V₂.toScheme.isoSpec.inv.continuous
    have h_inv_hom : V₂.toScheme.isoSpec.inv.base (V₂.toScheme.isoSpec.hom.base w₀) = w₀ := by
      rw [← hCompBase V₂.toScheme.isoSpec.hom V₂.toScheme.isoSpec.inv w₀,
        V₂.toScheme.isoSpec.hom_inv_id, hIdBase]
    rw [h_inv_hom] at h_spec₁
    have h_spec₂ : z₂ ⤳ w₂ := hw₀_eq ▸ (h_spec₁.map V₂.ι.continuous)
    exact h_spec₂.mem_open U_B.isOpen hw₂UB
  have h_fib_z₂ : ∀ x : B.left, ψ.left.base x = ψ.left.base z₂ → x = z₂ := by
    intro x hx_eq
    have hxV₂ : x ∈ (V₂ : Set B.left) := by
      change ψ.left.base x ∈ V₁
      rw [hx_eq]
      exact hz₂V₂
    have hx_range : x ∈ Set.range ⇑V₂.ι := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      exact hxV₂
    obtain ⟨x₀, hx₀_eq⟩ := hx_range
    have h_res_eq : (ψ.left ∣_ V₁).base x₀ = (ψ.left ∣_ V₁).base z₀ := by
      apply V₁.ι.isOpenEmbedding.injective
      change V₁.ι.base ((ψ.left ∣_ V₁).base x₀) = V₁.ι.base ((ψ.left ∣_ V₁).base z₀)
      rw [← hCompBase (ψ.left ∣_ V₁) V₁.ι x₀, ← hCompBase (ψ.left ∣_ V₁) V₁.ι z₀,
        AlgebraicGeometry.morphismRestrict_ι,
        hCompBase V₂.ι ψ.left x₀, hCompBase V₂.ι ψ.left z₀]
      change ψ.left.base (⇑V₂.ι x₀) = ψ.left.base z₂
      rw [hx₀_eq, hx_eq]
    let q_pt : AlgebraicGeometry.Spec (V₂.toScheme.presheaf.obj (Opposite.op ⊤)) :=
      V₂.toScheme.isoSpec.hom.base x₀
    let q : PrimeSpectrum ↑A₂ := q_pt
    have hz₀_hom : V₂.toScheme.isoSpec.hom.base z₀ = p_bot_pt := by
      dsimp only [z₀]
      rw [← hCompBase V₂.toScheme.isoSpec.inv V₂.toScheme.isoSpec.hom p_bot_pt,
        V₂.toScheme.isoSpec.inv_hom_id, hIdBase]
    have h_spec_eq : (AlgebraicGeometry.Spec.map (ψ.left ∣_ V₁).appTop).base q_pt =
        (AlgebraicGeometry.Spec.map (ψ.left ∣_ V₁).appTop).base p_bot_pt := by
      dsimp only [q_pt]
      rw [← hz₀_hom,
        ← hCompBase V₂.toScheme.isoSpec.hom (AlgebraicGeometry.Spec.map (ψ.left ∣_ V₁).appTop) x₀,
        ← hCompBase V₂.toScheme.isoSpec.hom (AlgebraicGeometry.Spec.map (ψ.left ∣_ V₁).appTop) z₀,
        AlgebraicGeometry.Scheme.isoSpec_hom_naturality (ψ.left ∣_ V₁),
        hCompBase (ψ.left ∣_ V₁) V₁.toScheme.isoSpec.hom x₀,
        hCompBase (ψ.left ∣_ V₁) V₁.toScheme.isoSpec.hom z₀,
        h_res_eq]
    have h_spec_eq' :
        ((AlgebraicGeometry.Spec.map (ψ.left ∣_ V₁).appTop).base q_pt : PrimeSpectrum ↑A₁) =
        ((AlgebraicGeometry.Spec.map (ψ.left ∣_ V₁).appTop).base p_bot_pt : PrimeSpectrum ↑A₁) :=
      h_spec_eq
    have h_comap_eq : PrimeSpectrum.comap (ψ.left ∣_ V₁).appTop.hom q =
        PrimeSpectrum.comap (ψ.left ∣_ V₁).appTop.hom p_bot :=
      (AlgebraicGeometry.Spec.map_apply (ψ.left ∣_ V₁).appTop q_pt).symm.trans
        (h_spec_eq'.trans (AlgebraicGeometry.Spec.map_apply (ψ.left ∣_ V₁).appTop p_bot_pt))
    let φ : ↑A₁ →+* ↑A₂ := (ψ.left ∣_ V₁).appTop.hom
    letI : Algebra ↑A₁ ↑A₂ := φ.toAlgebra
    have hInt_φ : φ.IsIntegral :=
      AlgebraicGeometry.IsIntegralHom.isIntegral_app (ψ.left ∣_ V₁) ⊤
        (AlgebraicGeometry.isAffineOpen_top V₁.toScheme)
    have hq_bot : q = p_bot := by
      by_contra hq_ne
      have h_not_le : ¬ (q.asIdeal ≤ p_bot.asIdeal) := by
        intro hle
        exact hq_ne (PrimeSpectrum.ext (le_antisymm hle (show p_bot ≤ q from bot_le)))
      obtain ⟨s, hs_q, hs_not_bot⟩ := Set.not_subset.mp h_not_le
      haveI : p_bot.asIdeal.IsPrime := p_bot.isPrime
      have h_lt : Ideal.under ↑A₁ p_bot.asIdeal < Ideal.under ↑A₁ q.asIdeal :=
        Ideal.under_lt_under_of_integral_mem_sdiff (R := ↑A₁)
          (show p_bot.asIdeal ≤ q.asIdeal from (bot_le : p_bot ≤ q))
          ⟨hs_q, hs_not_bot⟩ (hInt_φ s)
      have h_eq_under : Ideal.under ↑A₁ q.asIdeal = Ideal.under ↑A₁ p_bot.asIdeal :=
        congrArg PrimeSpectrum.asIdeal h_comap_eq
      exact (ne_of_lt h_lt) h_eq_under.symm
    have hx₀_z₀ : x₀ = z₀ := by
      have hq_pt_eq : q_pt = p_bot_pt := hq_bot
      have h1 := congrArg (fun p => V₂.toScheme.isoSpec.inv.base p) hq_pt_eq
      dsimp only [q_pt, z₀] at h1
      rwa [← hCompBase V₂.toScheme.isoSpec.hom V₂.toScheme.isoSpec.inv x₀,
        V₂.toScheme.isoSpec.hom_inv_id, hIdBase] at h1
    calc x
      _ = ⇑V₂.ι x₀ := hx₀_eq.symm
      _ = z₂ := by rw [hx₀_z₀]
  haveI : AlgebraicGeometry.IsProper ψ.left := hPropψ
  let W₁ : B₂.left.Opens := ⟨(ψ.left.base '' ((U_B : Set B.left)ᶜ))ᶜ,
    (ψ.left.isClosedMap _ U_B.isOpen.isClosed_compl).isOpen_compl⟩
  let U_base : B₂.left.Opens := U_ψ ⊓ W₁
  have hz₂W₁ : ψ.left.base z₂ ∈ W₁ := by
    intro ⟨x, hx_not_UB, hx_eq⟩
