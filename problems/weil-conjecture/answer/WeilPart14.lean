                change e'_X.base w₀ ∈ S_α α; rwa [hw₀_x']
              rcases he'X_S_q1 α with hEmpty | ⟨i_α, hi_α, j_α, hj_α, hij_α, hSet_α⟩
              · rw [hEmpty] at hw₀_in; exact hw₀_in.elim
              · rw [hSet_α] at hw₀_in
                have hi_exp' : i_α ∈ S'_exp := (hS'_exp_iff i_α).mpr ⟨hi_α, hw₀_in.2.1⟩
                have hj_exp' : j_α ∈ S'_exp := (hS'_exp_iff j_α).mpr ⟨hj_α, hw₀_in.2.2⟩
                refine ⟨i_α, hi_exp', j_α, hj_exp', hij_α, ?_⟩
                ext u
                let v := j_sep.base u
                change j.base v ∈ e'_X.base ⁻¹' (S_α α) ↔
                  (∀ a_idx : Fin 2,
                    Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl a_idx)) ∈ (q'.base v).asIdeal) ∧
                  Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr i_α)) ∈ (q'.base v).asIdeal ∧
                  Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr j_α)) ∈ (q'.base v).asIdeal
                rw [hSet_α]
                simp only [Set.mem_setOf_eq, (hMem_iffs v).1, (hMem_iffs v).2.1]
    · exact weil_toroidal_open_iso_etale_chart_transfer U₀ hU₀_eq x' hxK
  refine ⟨?_, hPart2⟩
  intro α x' hx'S
  have hx'Union : x' ∈ ⋃ γ : Fin N, S_α γ := Set.mem_iUnion.mpr ⟨α, hx'S⟩
  rcases hPart2 x' with ⟨hx'NotUnion, _⟩ |
    ⟨_, B', w₀, e'_X, S'_exp, _S'_bdry, q', hEt_e'X, hEt_q', hw₀, _hCard', _hSub',
      hComm', _hInl', _hInr', _hZ', _hEmpty', hPair'⟩
  · exact (hx'NotUnion hx'Union).elim
  · obtain ⟨i, hi, j, hj, hij, hPre⟩ := hPair' α hx'S
    obtain ⟨J', ψ_E, hRadJ', hZeroJ', hEt_ψE, hComm_E⟩ :=
      weil_toroidal_stratum_etale_quotient_roof_of_chart S'_exp i j hi hj hij
        (hAlg.1 S'_exp i j hi hj hij).2.2 X' (S_α α) B' e'_X q' hEt_e'X hEt_q' hComm' hPre
    exact ⟨B', w₀, e'_X, J', ψ_E, hEt_e'X, hw₀, hRadJ', hZeroJ', hEt_ψE, hComm_E⟩

theorem weil_toroidal_codim3_stratum_blowup_transfer (k : Type u) [Field k] [IsAlgClosed k] (m N : ℕ)
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (Z : Set X.left)
    (hIntX : AlgebraicGeometry.IsIntegral X.left)
    (hProjX : IsProjectiveOverField k X)
    (hTor : IsToroidalSquarefreePair k m (N + 1) X Z) :
    ∃ (K : Set X.left),
      IsClosed K ∧
      IsIrreducible K ∧
      Kᶜ.Nonempty ∧
      ∀ (X' : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (π : X' ⟶ X),
        AlgebraicGeometry.IsIntegral X'.left →
        IsProjectiveOverField k X' →
        IsReducedClosedBlowupOver k K π →
        IsToroidalSquarefreePair k m N X' (π.left.base ⁻¹' Z) :=
by
  let _ := hIntX
  rcases hTor with ⟨hClosedZ, E, ιE, hClE, hIntE, hSmE, hPairE, hSingEq, hCharts⟩
  have hWit : IsToroidalSquarefreeWitness k m (N + 1) X Z E ιE :=
    ⟨hClE, hIntE, hSmE, hPairE, hSingEq, hCharts⟩
  let K : Set X.left := Set.range (ιE (Fin.last N)).base
  have hTorSingBridge :
      ∀ (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (_ : IsProjectiveOverField k Y) (y : Y.left)
        (R' : CommRingCat.{u}) (v : AlgebraicGeometry.Spec R')
        (e_Y : AlgebraicGeometry.Spec R' ⟶ Y.left)
        (S_exp S₀ : Finset (Fin m))
        (q : AlgebraicGeometry.Spec R' ⟶ AlgebraicGeometry.Spec
          (CommRingCat.of (toroidalModelRing k m S_exp))),
        AlgebraicGeometry.Etale e_Y →
        AlgebraicGeometry.Etale q →
        e_Y.base v = y →
        q ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) = e_Y ≫ Y.hom →
        (∀ b : Fin 2,
          Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl b)) ∈ (q.base v).asIdeal) →
        S₀ ⊆ S_exp →
        2 ≤ S₀.card →
        (∀ c ∈ S₀,
          Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c)) ∈ (q.base v).asIdeal) →
        ¬ ∃ V : Y.left.Opens,
          y ∈ V ∧ AlgebraicGeometry.SmoothOfRelativeDimension (m + 1) (V.ι ≫ Y.hom) := by
    intro Y hProjY y R' v e_Y S_exp S₀ q hEt_e hEt_q hv hComm hInl hS₀_sub hS₀_card hInr
    let a_exp : Fin m → ℕ := fun c => if c ∈ S_exp then 1 else 0
    have hProd : (∏ i ∈ S_exp,
        (MvPolynomial.X (Sum.inr i) : MvPolynomial (Fin 2 ⊕ Fin m) k)) =
        ∏ c : Fin m, MvPolynomial.X (Sum.inr c) ^ a_exp c := by
      have hEach : ∀ c : Fin m,
          (MvPolynomial.X (Sum.inr c) : MvPolynomial (Fin 2 ⊕ Fin m) k) ^ a_exp c =
          if c ∈ S_exp then MvPolynomial.X (Sum.inr c) else 1 := by
        intro c
        dsimp [a_exp]
        split_ifs <;> simp
      simp_rw [hEach, Finset.prod_ite, Finset.prod_const_one, mul_one,
        Finset.filter_mem_eq_inter, Finset.univ_inter]
    have hSum : 2 ≤ ∑ c ∈ S₀, a_exp c := by
      have hEqCard : (∑ c ∈ S₀, a_exp c) = S₀.card := by
        calc
          (∑ c ∈ S₀, a_exp c) = ∑ _c ∈ S₀, 1 := by
            refine Finset.sum_congr rfl fun c hc => ?_
            have hcExp : c ∈ S_exp := hS₀_sub hc
            simp [a_exp, hcExp]
          _ = S₀.card := by simp
      rwa [hEqCard]
    have hGen : ∀ (P_rhs : MvPolynomial (Fin 2 ⊕ Fin m) k)
        (_ : P_rhs = ∏ c : Fin m, MvPolynomial.X (Sum.inr c) ^ a_exp c)
        (q' : AlgebraicGeometry.Spec R' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
          (MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ Ideal.span
            {MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) - P_rhs}))),
        AlgebraicGeometry.Etale q' →
        (q' ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) = e_Y ≫ Y.hom) →
        (∀ b : Fin 2,
          Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl b)) ∈ (q'.base v).asIdeal) →
        (∀ c ∈ S₀,
          Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c)) ∈ (q'.base v).asIdeal) →
        ¬ ∃ V : Y.left.Opens,
          y ∈ V ∧ AlgebraicGeometry.SmoothOfRelativeDimension (m + 1) (V.ι ≫ Y.hom) := by
      rintro _ rfl q' hEt_q' hComm' hInl' hInr'
      exact (weil_smoothOfRelativeDimension_and_toroidal_sing_of_etale
        k Y hProjY y).2 m R' v e_Y a_exp S₀ q' hEt_e hEt_q' hv hComm' hInl' hInr' hSum
    exact hGen _ hProd q hEt_q hComm hInl hInr
  have hSingPair :
      ∀ (y : X.left) (R' : CommRingCat.{u}) (v : AlgebraicGeometry.Spec R')
        (e_X : AlgebraicGeometry.Spec R' ⟶ X.left)
        (S_exp : Finset (Fin m)) (a b : Fin m)
        (q : AlgebraicGeometry.Spec R' ⟶ AlgebraicGeometry.Spec
          (CommRingCat.of (toroidalModelRing k m S_exp))),
        AlgebraicGeometry.Etale e_X →
        AlgebraicGeometry.Etale q →
        e_X.base v = y →
        q ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) = e_X ≫ X.hom →
        (∀ c : Fin 2,
          Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl c)) ∈ (q.base v).asIdeal) →
        a ∈ S_exp →
        b ∈ S_exp →
        a ≠ b →
        Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr a)) ∈ (q.base v).asIdeal →
        Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr b)) ∈ (q.base v).asIdeal →
        ¬ ∃ V : X.left.Opens,
          y ∈ V ∧ AlgebraicGeometry.SmoothOfRelativeDimension (m + 1) (V.ι ≫ X.hom) := by
    intro y R' v e_X S_exp a b q hEt_e hEt_q hv hComm hInl haExp hbExp hab haMem hbMem
    let S₀ : Finset (Fin m) := {a, b}
    have hS₀_sub : S₀ ⊆ S_exp := by
      intro c hc
      simp only [S₀, Finset.mem_insert, Finset.mem_singleton] at hc
      rcases hc with rfl | rfl <;> assumption
    have hS₀_card : 2 ≤ S₀.card := by
      simp [S₀, Finset.card_pair hab]
    have hS₀_mem : ∀ c ∈ S₀,
        Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c)) ∈ (q.base v).asIdeal := by
      intro c hc
      simp only [S₀, Finset.mem_insert, Finset.mem_singleton] at hc
      rcases hc with rfl | rfl <;> assumption
    exact hTorSingBridge X hProjX y R' v e_X S_exp S₀ q
      hEt_e hEt_q hv hComm hInl hS₀_sub hS₀_card hS₀_mem
  have hSingOnX :
      ∀ (y : X.left) (R' : CommRingCat.{u}) (v₀ : AlgebraicGeometry.Spec R')
        (e_X : AlgebraicGeometry.Spec R' ⟶ X.left)
        (S_exp S_bdry : Finset (Fin m))
        (q : AlgebraicGeometry.Spec R' ⟶ AlgebraicGeometry.Spec
          (CommRingCat.of (toroidalModelRing k m S_exp))),
        AlgebraicGeometry.Etale e_X →
        AlgebraicGeometry.Etale q →
        e_X.base v₀ = y →
        2 ≤ S_exp.card →
        S_exp ⊆ S_bdry →
        q ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) = e_X ≫ X.hom →
        (∀ a : Fin 2,
          Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl a)) ∈ (q.base v₀).asIdeal) →
        (∀ i ∈ S_bdry,
          Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr i)) ∈ (q.base v₀).asIdeal) →
        ¬ ∃ V : X.left.Opens,
          y ∈ V ∧ AlgebraicGeometry.SmoothOfRelativeDimension (m + 1) (V.ι ≫ X.hom) := by
    intro y R' v₀ e_X S_exp S_bdry q hEt_e hEt_q hv₀ hCard hSub hComm hInl hInr
    exact hTorSingBridge X hProjX y R' v₀ e_X S_exp S_exp q
      hEt_e hEt_q hv₀ hComm hInl (Finset.Subset.refl _) hCard (fun c hc => hInr c (hSub hc))
  obtain ⟨hClosedK, hIrredK, hNonUnivK, hNonCont, hLocalSurj⟩ :=
    weil_toroidal_codim3_center_and_local_bijection k m N X Z E ιE hWit hSingPair
  refine ⟨K, hClosedK, hIrredK, hNonUnivK, ?_⟩
  intro X' π hIntX' hProjX' hBlowup
  let _ := hIntX'
  rcases hBlowup.2.1 with ⟨U₀, hU₀_eq, _hU₀_ne, hIsoU₀⟩
  have : CategoryTheory.IsIso (π.left ∣_ U₀) := hIsoU₀
  let E_set : Fin N → Set X.left := fun α => Set.range (ιE α.castSucc).base
  let S_α : Fin N → Set X'.left :=
    fun α => closure (π.left.base ⁻¹' (E_set α \ K))
  let V'₀ : X'.left.Opens := π.left ⁻¹ᵁ U₀
  let f₀ : V'₀.toScheme ⟶ U₀.toScheme := π.left ∣_ U₀
  let g_open : U₀.toScheme ⟶ X'.left := CategoryTheory.inv f₀ ≫ V'₀.ι
  have h_g_π : g_open ≫ π.left = U₀.ι := by
    dsimp [g_open, f₀, V'₀]
    rw [Category.assoc, ← AlgebraicGeometry.morphismRestrict_ι π.left U₀,
      CategoryTheory.IsIso.inv_hom_id_assoc]
  have h_π_g : ∀ u : ↥U₀.toScheme, π.left.base (g_open.base u) = u.1 := by
    intro u
    change (g_open ≫ π.left).base u = U₀.ι.base u
    rw [h_g_π]
  have h_g_f₀ : ∀ (x' : X'.left) (hx' : π.left.base x' ∈ U₀),
      g_open.base (f₀.base ⟨x', hx'⟩) = x' := by
    intro x' hx'
    change (f₀ ≫ CategoryTheory.inv f₀ ≫ V'₀.ι).base ⟨x', hx'⟩ = V'₀.ι.base ⟨x', hx'⟩
    rw [CategoryTheory.IsIso.hom_inv_id_assoc]
  have hClosedE : ∀ α : Fin N, IsClosed (E_set α) := by
    intro α
    have : AlgebraicGeometry.IsClosedImmersion (ιE α.castSucc) := hClE α.castSucc
    exact (ιE α.castSucc).isClosedEmbedding.isClosed_range
  have hIrredE : ∀ α : Fin N, IsIrreducible (E_set α) := by
    intro α
    have : AlgebraicGeometry.IsIntegral (E α.castSucc) := hIntE α.castSucc
    have : IrreducibleSpace ↥(E α.castSucc) :=
      AlgebraicGeometry.irreducibleSpace_of_isIntegral (E α.castSucc)
    dsimp [E_set]
    rw [← Set.image_univ]
    have hCont : Continuous (ιE α.castSucc).base := (ιE α.castSucc).continuous
    have hUniv : IsIrreducible (Set.univ : Set ↥(E α.castSucc)) :=
      ⟨Set.univ_nonempty, PreirreducibleSpace.isPreirreducible_univ⟩
    exact hUniv.image (ιE α.castSucc).base hCont.continuousOn
  have hEqImg : ∀ α : Fin N,
      π.left.base ⁻¹' (E_set α \ K) = g_open.base '' (U₀.ι.base ⁻¹' E_set α) := by
    intro α
    ext x'
    constructor
    · rintro ⟨hx'E, hx'NotK⟩
      have hx'U₀ : π.left.base x' ∈ U₀ := by
        change π.left.base x' ∈ (U₀ : Set X.left)
        rw [hU₀_eq]
        exact hx'NotK
      refine ⟨f₀.base ⟨x', hx'U₀⟩, ?_, h_g_f₀ x' hx'U₀⟩
      change (f₀ ≫ U₀.ι).base ⟨x', hx'U₀⟩ ∈ E_set α
      rw [AlgebraicGeometry.morphismRestrict_ι π.left U₀]
      exact hx'E
    · rintro ⟨u, huE, rfl⟩
      refine ⟨?_, ?_⟩
      · rw [h_π_g u]
        exact huE
      · rw [h_π_g u]
        have huU₀ : u.1 ∈ (U₀ : Set X.left) := u.2
        rwa [hU₀_eq] at huU₀
  have hIrredS : ∀ α : Fin N, IsIrreducible (S_α α) := by
    intro α
    have hOpenEmb : Topology.IsOpenEmbedding U₀.ι.base := U₀.ι.isOpenEmbedding
    have hPreU₀ : IsPreirreducible (U₀.ι.base ⁻¹' E_set α) :=
      (hIrredE α).2.preimage hOpenEmb
    obtain ⟨x₀, hx₀E, hx₀NotK⟩ := hNonCont α
    have hx₀U₀ : x₀ ∈ U₀ := by
      change x₀ ∈ (U₀ : Set X.left)
      rw [hU₀_eq]
      exact hx₀NotK
    have hNeU₀ : (U₀.ι.base ⁻¹' E_set α).Nonempty := ⟨⟨x₀, hx₀U₀⟩, hx₀E⟩
    have hContG : Continuous g_open.base := g_open.continuous
    have hIrredPre : IsIrreducible (π.left.base ⁻¹' (E_set α \ K)) := by
      rw [hEqImg α]
      exact IsIrreducible.image ⟨hNeU₀, hPreU₀⟩ g_open.base hContG.continuousOn
    exact hIrredPre.closure
  have hPairS : _root_.Pairwise fun α β : Fin N => S_α α ≠ S_α β := by
    have hContπ : Continuous π.left.base := π.left.continuous
    have hSubF : ∀ α : Fin N, S_α α ⊆ π.left.base ⁻¹' E_set α := fun α =>
      closure_minimal (fun _ hx' => hx'.1) ((hClosedE α).preimage hContπ)
    have hTraceU₀ : ∀ (α : Fin N) (u : ↥U₀.toScheme),
        g_open.base u ∈ S_α α ↔ u.1 ∈ E_set α := by
      intro α u
      constructor
      · intro hMem
        have hPre : π.left.base (g_open.base u) ∈ E_set α := hSubF α hMem
        rwa [h_π_g u] at hPre
      · intro huE
        apply subset_closure
        change π.left.base (g_open.base u) ∈ E_set α \ K
        rw [h_π_g u]
        have huU₀ : u.1 ∈ (U₀ : Set X.left) := u.2
        rw [hU₀_eq] at huU₀
        exact ⟨huE, huU₀⟩
    have hClEq : ∀ γ : Fin N, closure (E_set γ ∩ (U₀ : Set X.left)) = E_set γ := by
      intro γ
      apply Set.Subset.antisymm
      · exact closure_minimal Set.inter_subset_left (hClosedE γ)
      · refine subset_closure_inter_of_isPreirreducible_of_isOpen (hIrredE γ).2 U₀.2 ?_
        rw [hU₀_eq]
        exact hNonCont γ
    intro α β hne hEqS
    have hInterEq : E_set α ∩ (U₀ : Set X.left) = E_set β ∩ (U₀ : Set X.left) := by
      ext x
      constructor
      · rintro ⟨hxE, hxU₀⟩
        have hMemα : g_open.base ⟨x, hxU₀⟩ ∈ S_α α := (hTraceU₀ α ⟨x, hxU₀⟩).mpr hxE
        rw [hEqS] at hMemα
        exact ⟨(hTraceU₀ β ⟨x, hxU₀⟩).mp hMemα, hxU₀⟩
      · rintro ⟨hxE, hxU₀⟩
        have hMemβ : g_open.base ⟨x, hxU₀⟩ ∈ S_α β := (hTraceU₀ β ⟨x, hxU₀⟩).mpr hxE
        rw [← hEqS] at hMemβ
        exact ⟨(hTraceU₀ α ⟨x, hxU₀⟩).mp hMemβ, hxU₀⟩
    have hEqE : E_set α = E_set β := by
      rw [← hClEq α, hInterEq, hClEq β]
    exact hPairE (Fin.castSucc_inj.not.mpr hne) hEqE
  have hAlg : HasFourChartToroidalBlowupAlgebra k m :=
    weil_toroidal_four_chart_blowup_algebra k m
  have hEtCharts : HasToroidalBlowupEtaleCharts k m N X' (π.left.base ⁻¹' Z) S_α :=
    weil_toroidal_blowup_etale_chart_transfer k m N X Z E ιE hWit hAlg hSingOnX hLocalSurj X' π hBlowup
  let I_str : Fin N → X'.left.IdealSheafData :=
    fun α => AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal ⟨S_α α, isClosed_closure⟩
  let E_tilde : Fin N → AlgebraicGeometry.Scheme.{u} := fun α => (I_str α).subscheme
  let ιE_tilde : ∀ α : Fin N, E_tilde α ⟶ X'.left := fun α => (I_str α).subschemeι
  have hSub := fun α : Fin N =>
    weil_reduced_subscheme_integral_and_etale_lift k X' (S_α α) isClosed_closure (hIrredS α)
  have hClE_tilde : ∀ α : Fin N, AlgebraicGeometry.IsClosedImmersion (ιE_tilde α) :=
    fun α => (hSub α).1
  have hRangeE : ∀ α : Fin N, Set.range (ιE_tilde α).base = S_α α :=
    fun α => (hSub α).2.1
  have hIntE_tilde : ∀ α : Fin N, AlgebraicGeometry.IsIntegral (E_tilde α) :=
    fun α => (hSub α).2.2.1
  have hSmE_tilde : ∀ α : Fin N,
      AlgebraicGeometry.SmoothOfRelativeDimension (m - 2) (ιE_tilde α ≫ X'.hom) := by
    intro α
    let Y_α : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
      CategoryTheory.Over.mk (ιE_tilde α ≫ X'.hom)
    have hProjY_α : IsProjectiveOverField k Y_α := by
      obtain ⟨M_proj, ι_proj, hCl_proj⟩ := hProjX'
      have : AlgebraicGeometry.IsClosedImmersion (ιE_tilde α) := hClE_tilde α
      have : AlgebraicGeometry.IsClosedImmersion ι_proj.left := hCl_proj
      refine ⟨M_proj, CategoryTheory.Over.homMk (ιE_tilde α ≫ ι_proj.left) ?_, ?_⟩
      · dsimp [Y_α]
        rw [Category.assoc, Over.w ι_proj]
      · change AlgebraicGeometry.IsClosedImmersion (ιE_tilde α ≫ ι_proj.left)
        exact inferInstance
    have hLoc : ∀ z : E_tilde α, ∃ V : (E_tilde α).Opens,
        z ∈ V ∧ AlgebraicGeometry.SmoothOfRelativeDimension (m - 2)
          (V.ι ≫ (ιE_tilde α ≫ X'.hom)) := by
      intro z
      have hzS : (ιE_tilde α).base z ∈ S_α α := by
        rw [← hRangeE α]
        exact ⟨z, rfl⟩
      obtain ⟨B', w₀, e'_X, J', ψ_E, hEt_e', hw₀, hRadJ', hZeroJ', hEt_ψE, hComm_ψE⟩ :=
        hEtCharts.1 α ((ιE_tilde α).base z) hzS
      obtain ⟨R_E, u₀, e_E, ψ'_E, hEt_eE, hEt_ψ'E, hu₀, hComm_E⟩ :=
        (hSub α).2.2.2 z (m - 2) B' w₀ e'_X J' ψ_E hEt_e' hw₀ hRadJ' hZeroJ' hEt_ψE hComm_ψE
      exact (weil_smoothOfRelativeDimension_and_toroidal_sing_of_etale
        k Y_α hProjY_α z).1 (m - 2) R_E u₀ e_E ψ'_E hEt_eE hEt_ψ'E hu₀ hComm_E
    rw [AlgebraicGeometry.smoothOfRelativeDimension_iff]
    intro z
    obtain ⟨V, hzV, hSmV⟩ := hLoc z
    rw [AlgebraicGeometry.smoothOfRelativeDimension_iff] at hSmV
    obtain ⟨U_k, hAffU_k, W, hAffW, hzW, he, hStd⟩ := hSmV ⟨z, hzV⟩
    let W' : (E_tilde α).Opens := (AlgebraicGeometry.Scheme.Hom.opensFunctor V.ι).obj W
    have hAffW' : AlgebraicGeometry.IsAffineOpen W' := hAffW.image_of_isOpenImmersion V.ι
    have hzW' : z ∈ W' := ⟨⟨z, hzV⟩, hzW, rfl⟩
    have he' : W' ≤ (TopologicalSpace.Opens.map (ιE_tilde α ≫ X'.hom).base).obj U_k := by
      rintro _ ⟨w, hw, rfl⟩
      exact he hw
    have he₂ : W ≤ (TopologicalSpace.Opens.map V.ι.base).obj W' :=
      fun w hw => ⟨w, hw, rfl⟩
    refine ⟨U_k, hAffU_k, W', hAffW', hzW', he', ?_⟩
    have hAppEq : (ιE_tilde α ≫ X'.hom).appLE U_k W' he' =
        (V.ι ≫ (ιE_tilde α ≫ X'.hom)).appLE U_k W he := by
      rw [← AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE V.ι (ιE_tilde α ≫ X'.hom)
        U_k W' W he' he₂, AlgebraicGeometry.Scheme.Opens.ι_appLE]
      have hRefl : CategoryTheory.homOfLE
          (show (AlgebraicGeometry.Scheme.Hom.opensFunctor V.ι).obj W ≤ W' from le_rfl) =
          𝟙 W' := rfl
      erw [hRefl, CategoryTheory.op_id, (E_tilde α).presheaf.map_id, Category.comp_id]
    rwa [hAppEq]
  have hPairE_tilde : _root_.Pairwise fun α β : Fin N =>
      Set.range (ιE_tilde α).base ≠ Set.range (ιE_tilde β).base := by
    intro α β hne
    rw [hRangeE α, hRangeE β]
    exact hPairS hne
  have hSm_of_notMem : ∀ x' : X'.left,
      x' ∉ (⋃ α : Fin N, S_α α) →
      ∃ V : X'.left.Opens,
        x' ∈ V ∧ AlgebraicGeometry.SmoothOfRelativeDimension (m + 1) (V.ι ≫ X'.hom) := by
    intro x' hx'NotMem
    rcases hEtCharts.2 x' with ⟨_, R', v₀, e'_X, ψ, _I, hEt_e', hEt_ψ, hv₀, hComm, _, _⟩ |
      ⟨hx'Mem, _⟩
    · exact (weil_smoothOfRelativeDimension_and_toroidal_sing_of_etale
        k X' hProjX' x').1 (m + 1) R' v₀ e'_X ψ hEt_e' hEt_ψ hv₀ hComm
    · exact (hx'NotMem hx'Mem).elim
  have hNotSm_of_mem : ∀ x' : X'.left,
      x' ∈ (⋃ α : Fin N, S_α α) →
      ¬ ∃ V : X'.left.Opens,
        x' ∈ V ∧ AlgebraicGeometry.SmoothOfRelativeDimension (m + 1) (V.ι ≫ X'.hom) := by
    intro x' hx'Mem
    rcases hEtCharts.2 x' with ⟨hx'NotMem, _⟩ |
      ⟨_, R', v₀, e'_X, S'_exp, S'_bdry, q', hEt_e', hEt_q', hv₀, hCard', hSub',
        hComm', hInl', hInr', _, _, _⟩
    · exact (hx'NotMem hx'Mem).elim
    · exact hTorSingBridge X' hProjX' x' R' v₀ e'_X S'_exp S'_exp q'
        hEt_e' hEt_q' hv₀ hComm' hInl' (Finset.Subset.refl _) hCard'
        (fun c hc => hInr' c (hSub' hc))
  have hUnionEq : (⋃ α : Fin N, Set.range (ιE_tilde α).base) = ⋃ α : Fin N, S_α α :=
    Set.iUnion_congr hRangeE
  have hClosedZ' : IsClosed (π.left.base ⁻¹' Z) := by
    have hContπ : Continuous π.left.base := π.left.continuous
    exact hClosedZ.preimage hContπ
  refine ⟨hClosedZ', E_tilde, ιE_tilde, hClE_tilde, hIntE_tilde, hSmE_tilde,
    hPairE_tilde, ?_, ?_⟩
  · rw [hUnionEq]
    ext x'
    exact ⟨fun hNotSm => Classical.byContradiction fun hx'NotMem =>
        hNotSm (hSm_of_notMem x' hx'NotMem),
      fun hx'Mem => hNotSm_of_mem x' hx'Mem⟩
  · intro x'
    rcases hEtCharts.2 x' with ⟨hx'NotMem, hLeft⟩ |
      ⟨_hx'Mem, R', v₀, e'_X, S'_exp, S'_bdry, q', hEt_e', hEt_q', hv₀, hCard', hSub',
        hComm', hInl', hInr', hZ', hEmpty', hPair'⟩
    · exact Or.inl ⟨hSm_of_notMem x' hx'NotMem, hLeft⟩
    · refine Or.inr ⟨R', v₀, e'_X, S'_exp, S'_bdry, q', hEt_e', hEt_q', hv₀, hCard',
        hSub', hComm', hInl', hInr', hZ', ?_, ?_⟩
      · intro α hx'NotE
        rw [hRangeE α] at hx'NotE ⊢
        exact hEmpty' α hx'NotE
      · intro α hx'MemE
        rw [hRangeE α] at hx'MemE ⊢
        exact hPair' α hx'MemE

theorem weil_toroidal_codim3_strata_desingularization (k : Type u) [Field k] [IsAlgClosed k] (m N : ℕ)
    (C₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (Z₂ : Set C₂.left)
    (hIntC₂ : AlgebraicGeometry.IsIntegral C₂.left)
    (hProjC₂ : IsProjectiveOverField k C₂)
    (hTor₂ : IsToroidalSquarefreePair k m N C₂ Z₂) :
    ∃ (C_reg : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (Z_reg : Set C_reg.left) (π₃ : C_reg ⟶ C₂),
      AlgebraicGeometry.IsIntegral C_reg.left ∧
      IsProjectiveOverField k C_reg ∧
      AlgebraicGeometry.SmoothOfRelativeDimension (m + 1) C_reg.hom ∧
      IsEtaleLocalNcDivisor k (m + 1) C_reg Z_reg ∧
      IsGenFiniteEtaleAlterationOver k π₃ ∧
      π₃.left.base ⁻¹' Z₂ ⊆ Z_reg :=
by
  induction N generalizing C₂ Z₂ with
  | zero =>
    obtain ⟨hSmC₂, hNcC₂⟩ :=
      weil_toroidal_squarefree_zero_strata_smooth_nc k m C₂ Z₂ hTor₂
    have hIrred : IrreducibleSpace ↥C₂.left :=
      @AlgebraicGeometry.irreducibleSpace_of_isIntegral C₂.left hIntC₂
    obtain ⟨x₀⟩ := hIrred.toNonempty
    have hTop : Nonempty (⊤ : C₂.left.Opens) := ⟨⟨x₀, trivial⟩⟩
    have hIdAlt : IsGenFiniteEtaleAlterationOver k (𝟙 C₂) := by
      refine ⟨?_, ?_, ⊤, hTop, ?_, ?_, ?_⟩
      · change AlgebraicGeometry.IsProper (𝟙 C₂.left)
        infer_instance
      · change AlgebraicGeometry.Surjective (𝟙 C₂.left)
        infer_instance
      · change AlgebraicGeometry.IsFinite ((𝟙 C₂.left) ∣_ ⊤)
        infer_instance
      · change AlgebraicGeometry.Etale ((𝟙 C₂.left) ∣_ ⊤)
        infer_instance
      · change AlgebraicGeometry.Surjective ((𝟙 C₂.left) ∣_ ⊤)
        infer_instance
    refine ⟨C₂, Z₂, 𝟙 C₂, hIntC₂, hProjC₂, hSmC₂, hNcC₂, hIdAlt, ?_⟩
    intro x hx
    simpa using hx
  | succ N ih =>
    obtain ⟨K, hClosedK, hIrredK, hNonUnivK, hTransfer⟩ :=
      weil_toroidal_codim3_stratum_blowup_transfer k m N C₂ Z₂ hIntC₂ hProjC₂ hTor₂
    obtain ⟨X', π, hIntX', hProjX', hAltπ, hBlowupπ⟩ :=
      weil_projective_integral_reduced_closed_blowup k C₂ K hIntC₂ hProjC₂ hClosedK hIrredK hNonUnivK
    have hTor' : IsToroidalSquarefreePair k m N X' (π.left.base ⁻¹' Z₂) :=
      hTransfer X' π hIntX' hProjX' hBlowupπ
    obtain ⟨C_reg, Z_reg, π'_3, hIntCreg, hProjCreg, hSmCreg, hNcCreg, hAltπ'_3, hBdry'_3⟩ :=
      ih X' (π.left.base ⁻¹' Z₂) hIntX' hProjX' hTor'
    have hAlt₃ : IsGenFiniteEtaleAlterationOver k (π'_3 ≫ π) :=
      weil_gen_finite_etale_alteration_comp k π'_3 π hIntX' hAltπ'_3 hAltπ
    refine ⟨C_reg, Z_reg, π'_3 ≫ π, hIntCreg, hProjCreg, hSmCreg, hNcCreg, hAlt₃, ?_⟩
    intro x hx
    have hx' : π'_3.left.base x ∈ π.left.base ⁻¹' Z₂ := by
      simpa using hx
    exact hBdry'_3 hx'

theorem weil_algClosed_etale_mvPolynomial_domain_and_card_eq (k : Type u) [Field k] [IsAlgClosed k] :
    (∀ (n : ℕ) (R' : Type u) [CommRing R'] (ψ : MvPolynomial (Fin n) k →+* R')
        (v₀ : PrimeSpectrum R'),
      ψ.Etale →
      ∃ u : R', u ∉ v₀.asIdeal ∧ IsDomain (Localization.Away u)) ∧
    (∀ (d : ℕ) (B : Type u) [CommRing B] (q₀ : PrimeSpectrum B)
        (φ₁ φ₂ : MvPolynomial (Fin d) k →+* B)
        (I₁ I₂ : Finset (Fin d)),
      φ₁.Etale →
      φ₂.Etale →
      (∀ i ∈ I₁, φ₁ (MvPolynomial.X i) ∈ q₀.asIdeal) →
      (∀ j ∈ I₂, φ₂ (MvPolynomial.X j) ∈ q₀.asIdeal) →
      ({p : PrimeSpectrum B | ∃ i ∈ I₁, φ₁ (MvPolynomial.X i) ∈ p.asIdeal} =
        {p : PrimeSpectrum B | ∃ j ∈ I₂, φ₂ (MvPolynomial.X j) ∈ p.asIdeal}) →
      I₁.card = I₂.card) :=
by
  have hNoethK : IsNoetherianRing k := inferInstance
  have hPF := weil_etale_mvPolynomial_prime_factorization k
  have hNoethAux : ∀ (A S : Type u) [CommRing A] [CommRing S]
      (_ : IsNoetherianRing A) (ψ : A →+* S), ψ.Etale → IsNoetherianRing S := by
    intro A S _ _ _ ψ hψ
    let _ : Algebra A S := ψ.toAlgebra
    have _ : Algebra.Etale A S := RingHom.etale_algebraMap.mp hψ
    exact Algebra.FiniteType.isNoetherianRing A S
  have hAwayDom : ∀ (R : Type u) [CommRing R] [IsNoetherianRing R]
      (p : Ideal R) [p.IsPrime],
      IsDomain (Localization.AtPrime p) →
      ∃ u : R, u ∉ p ∧ IsDomain (Localization.Away u) := by
    intro R _ _ p _ hDom
    have _ : IsDomain (Localization.AtPrime p) := hDom
    let f : R →+* Localization.AtPrime p := algebraMap R (Localization.AtPrime p)
    let K : Ideal R := RingHom.ker f
    have hK_prime : K.IsPrime := RingHom.ker_isPrime f
    obtain ⟨S, hS_span⟩ := IsNoetherian.noetherian K
    have hKillGen : ∀ x : ↥S, ∃ s : p.primeCompl, (s : R) * x.1 = 0 := by
      intro x
      have hxK : x.1 ∈ K := by
        rw [← hS_span]
        exact Submodule.subset_span x.2
      have hfx : algebraMap R (Localization.AtPrime p) x.1 = 0 := hxK
      obtain ⟨s, hs⟩ :=
        (IsLocalization.map_eq_zero_iff p.primeCompl (Localization.AtPrime p) x.1).mp hfx
      exact ⟨s, hs⟩
    choose s_fn hs_fn using hKillGen
    let s_prod : p.primeCompl := ∏ x ∈ S.attach, s_fn x
    let u : R := s_prod.1
    have hu : u ∉ p := s_prod.2
    have hu_eq : u = ∏ x ∈ S.attach, (s_fn x : R) :=
      Submonoid.coe_finsetProd p.primeCompl s_fn S.attach
    have hu_gen : ∀ g ∈ S, u * g = 0 := by
      intro g hg
      have hdvd : (s_fn ⟨g, hg⟩ : R) ∣ u := by
        rw [hu_eq]
        exact Finset.dvd_prod_of_mem (fun x => (s_fn x : R)) (Finset.mem_attach S ⟨g, hg⟩)
      obtain ⟨q, hq⟩ := hdvd
      calc
        u * g = ((s_fn ⟨g, hg⟩ : R) * q) * g := by rw [hq]
        _ = q * ((s_fn ⟨g, hg⟩ : R) * g) := by ring
        _ = 0 := by rw [hs_fn ⟨g, hg⟩, mul_zero]
    let M_u : Submodule R R :=
      { carrier := {x : R | u * x = 0}
        zero_mem' := mul_zero u
        add_mem' := fun {a b} ha hb => by change u * (a + b) = 0; rw [mul_add, ha, hb, add_zero]
        smul_mem' := fun r {a} ha => by
          change u * (r * a) = 0
          calc
            u * (r * a) = r * (u * a) := by ring
            _ = 0 := by rw [ha, mul_zero] }
    have hK_le : (K : Submodule R R) ≤ M_u := by
      rw [← hS_span, Submodule.span_le]
      intro g hg
      exact hu_gen g hg
    have huK : ∀ x ∈ K, u * x = 0 := fun x hx => hK_le hx
    have hu_pow : ∀ m : ℕ, u ^ m ∉ p := fun m hm => hu (‹p.IsPrime›.mem_of_pow_mem m hm)
    refine ⟨u, hu, ?_⟩
    have hNontriv : Nontrivial (Localization.Away u) := by
      refine ⟨⟨0, 1, fun h01 => ?_⟩⟩
      have h10 : algebraMap R (Localization.Away u) 1 = 0 := by simpa using h01.symm
      obtain ⟨⟨m_val, m, hm_eq⟩, hm0⟩ :=
        (IsLocalization.map_eq_zero_iff (Submonoid.powers u) (Localization.Away u) 1).mp h10
      change u ^ m = m_val at hm_eq
      change m_val * 1 = 0 at hm0
      rw [mul_one, ← hm_eq] at hm0
      exact hu_pow m (hm0 ▸ p.zero_mem)
    have hNoZero : NoZeroDivisors (Localization.Away u) := by
      refine ⟨fun {z₁ z₂} hz => ?_⟩
      obtain ⟨⟨a₁, t₁⟩, h₁⟩ := IsLocalization.surj (Submonoid.powers u) z₁
      obtain ⟨⟨a₂, t₂⟩, h₂⟩ := IsLocalization.surj (Submonoid.powers u) z₂
      have ha12 : algebraMap R (Localization.Away u) (a₁ * a₂) = 0 := by
        rw [map_mul, ← h₁, ← h₂]
        calc
          z₁ * algebraMap R (Localization.Away u) ↑t₁ *
              (z₂ * algebraMap R (Localization.Away u) ↑t₂)
              = (z₁ * z₂) * (algebraMap R (Localization.Away u) ↑t₁ *
                  algebraMap R (Localization.Away u) ↑t₂) := by ring
          _ = 0 := by rw [hz, zero_mul]
      obtain ⟨⟨m_val, m, hm_eq⟩, hm0⟩ :=
        (IsLocalization.map_eq_zero_iff (Submonoid.powers u) (Localization.Away u) (a₁ * a₂)).mp ha12
      change u ^ m = m_val at hm_eq
      change m_val * (a₁ * a₂) = 0 at hm0
      rw [← hm_eq] at hm0
      have hf12 : f (a₁ * a₂) = 0 :=
        (IsLocalization.map_eq_zero_iff p.primeCompl (Localization.AtPrime p) (a₁ * a₂)).mpr
          ⟨⟨u ^ m, hu_pow m⟩, hm0⟩
      rcases hK_prime.mem_or_mem hf12 with ha₁ | ha₂
      · left
        have ha₁_loc : algebraMap R (Localization.Away u) a₁ = 0 :=
          (IsLocalization.map_eq_zero_iff (Submonoid.powers u) (Localization.Away u) a₁).mpr
            ⟨⟨u, 1, pow_one u⟩, huK a₁ ha₁⟩
        exact (IsLocalization.map_units (Localization.Away u) t₁).mul_left_eq_zero.mp
          (h₁.trans ha₁_loc)
      · right
        have ha₂_loc : algebraMap R (Localization.Away u) a₂ = 0 :=
          (IsLocalization.map_eq_zero_iff (Submonoid.powers u) (Localization.Away u) a₂).mpr
            ⟨⟨u, 1, pow_one u⟩, huK a₂ ha₂⟩
        exact (IsLocalization.map_units (Localization.Away u) t₂).mul_left_eq_zero.mp
          (h₂.trans ha₂_loc)
    exact @NoZeroDivisors.to_isDomain (Localization.Away u) _ hNontriv hNoZero
  have hQuotFlatAux : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B]
      [Algebra.Etale A B] (I : Ideal A),
      Module.Flat (A ⧸ I) (B ⧸ Ideal.map (algebraMap A B) I) := by
    intro A B _ _ _ _ I
    let e₁ : TensorProduct A (A ⧸ I) B ≃+* TensorProduct A B (A ⧸ I) :=
      (Algebra.TensorProduct.comm A (A ⧸ I) B).toRingEquiv
    let e₂ : TensorProduct A B (A ⧸ I) ≃+* (B ⧸ Ideal.map (algebraMap A B) I) :=
      (Algebra.TensorProduct.quotIdealMapEquivTensorQuot B I).symm.toRingEquiv
    let e_tp : TensorProduct A (A ⧸ I) B ≃+* (B ⧸ Ideal.map (algebraMap A B) I) := e₁.trans e₂
    have hEt_tp : (algebraMap (A ⧸ I) (TensorProduct A (A ⧸ I) B)).Etale :=
      RingHom.etale_algebraMap.mpr inferInstance
    have hEt_comp : (e_tp.toRingHom.comp (algebraMap (A ⧸ I) (TensorProduct A (A ⧸ I) B))).Etale :=
      RingHom.Etale.respectsIso.left (algebraMap (A ⧸ I) (TensorProduct A (A ⧸ I) B)) e_tp hEt_tp
    have hEqHom : algebraMap (A ⧸ I) (B ⧸ Ideal.map (algebraMap A B) I) =
        e_tp.toRingHom.comp (algebraMap (A ⧸ I) (TensorProduct A (A ⧸ I) B)) := by
      apply Ideal.Quotient.ringHom_ext
      ext r
      simp only [RingHom.comp_apply, Ideal.Quotient.algebraMap_quotient_map_quotient]
      have hAlgMap : algebraMap (A ⧸ I) (TensorProduct A (A ⧸ I) B) (Ideal.Quotient.mk I r) =
          (Ideal.Quotient.mk I r) ⊗ₜ[A] (1 : B) := rfl
      rw [hAlgMap]
      change Ideal.Quotient.mk (Ideal.map (algebraMap A B) I) (algebraMap A B r) =
        (Algebra.TensorProduct.quotIdealMapEquivTensorQuot B I).symm
          ((Algebra.TensorProduct.comm A (A ⧸ I) B) ((Ideal.Quotient.mk I r) ⊗ₜ[A] (1 : B)))
      rw [Algebra.TensorProduct.comm_tmul]
      have hTmul : (1 : B) ⊗ₜ[A] (Ideal.Quotient.mk I r) = (algebraMap A B r) ⊗ₜ[A] (1 : A ⧸ I) := by
        have hmk : Ideal.Quotient.mk I r = r • (1 : A ⧸ I) := by
          rw [Algebra.smul_def, mul_one]
          rfl
        rw [hmk, TensorProduct.tmul_smul, TensorProduct.smul_tmul', Algebra.smul_def, mul_one]
      rw [hTmul]
      apply (Algebra.TensorProduct.quotIdealMapEquivTensorQuot B I).injective
      rw [AlgEquiv.apply_symm_apply, Algebra.TensorProduct.quotIdealMapEquivTensorQuot_mk]
    rw [← hEqHom] at hEt_comp
    have _ : Algebra.Etale (A ⧸ I) (B ⧸ Ideal.map (algebraMap A B) I) :=
      RingHom.etale_algebraMap.mp hEt_comp
    exact inferInstance
  have hFlatRegAux : ∀ (A B : Type u) [CommRing A] [IsDomain A] [CommRing B]
      (φ : A →+* B), φ.Etale →
      ∀ (a : A) (b : B), a ≠ 0 → φ a * b = 0 → b = 0 := by
    intro A B _ _ _ φ hφ a b ha hab
    let _ : Algebra A B := φ.toAlgebra
    have _ : Algebra.Etale A B := RingHom.etale_algebraMap.mp hφ
    have ha_nzd : a ∈ nonZeroDivisors A := mem_nonZeroDivisors_of_ne_zero ha
    have hReg : IsSMulRegular B a := Module.Flat.isSMulRegular_of_nonZeroDivisors ha_nzd
    have hsmul : a • b = a • (0 : B) := by
      rw [smul_zero, Algebra.smul_def]
      exact hab
    exact hReg hsmul
  have hCoordReg : ∀ (d : ℕ) (B : Type u) [CommRing B] (φ : MvPolynomial (Fin d) k →+* B)
      (p : Ideal B) [p.IsPrime],
      φ.Etale →
      (∀ i : Fin d, algebraMap B (Localization.AtPrime p) (φ (MvPolynomial.X i)) ≠ 0) ∧
      (∀ i₁ i₂ : Fin d, i₁ ≠ i₂ → φ (MvPolynomial.X i₂) ∈ p →
        ¬ (algebraMap B (Localization.AtPrime p) (φ (MvPolynomial.X i₂)) ∣
            algebraMap B (Localization.AtPrime p) (φ (MvPolynomial.X i₁)))) := by
    intro d B _ φ p _ hφ
    let P := MvPolynomial (Fin d) k
    let L := Localization.AtPrime p
    refine ⟨?_, ?_⟩
    · intro i h0
      obtain ⟨s, hs⟩ :=
        (IsLocalization.map_eq_zero_iff p.primeCompl L (φ (MvPolynomial.X i))).mp h0
      have hs0 : (s : B) = 0 :=
        hFlatRegAux P B φ hφ (MvPolynomial.X i) (s : B) (MvPolynomial.X_ne_zero i)
          (by rw [mul_comm]; exact hs)
      exact s.2 (hs0 ▸ p.zero_mem)
    · intro i₁ i₂ hne hi₂ hdvd
      obtain ⟨z, hz⟩ := hdvd
      obtain ⟨⟨r, s⟩, hzs⟩ := IsLocalization.surj p.primeCompl z
      have hEqL : algebraMap B L (φ (MvPolynomial.X i₁) * s.1) =
          algebraMap B L (φ (MvPolynomial.X i₂) * r) := by
        rw [map_mul, map_mul, hz, mul_assoc, hzs]
      obtain ⟨t, hts⟩ := IsLocalization.exists_of_eq (M := p.primeCompl) hEqL
      have hRelB : φ (MvPolynomial.X i₁) * ((t : B) * s.1) =
          φ (MvPolynomial.X i₂) * ((t : B) * r) := by
        calc
          φ (MvPolynomial.X i₁) * ((t : B) * s.1) = (t : B) * (φ (MvPolynomial.X i₁) * s.1) := by ring
          _ = (t : B) * (φ (MvPolynomial.X i₂) * r) := hts
          _ = φ (MvPolynomial.X i₂) * ((t : B) * r) := by ring
      let σ' := {c : Fin d // c ≠ i₂}
      let P' := MvPolynomial σ' k
      let e_opt : Fin d ≃ Option σ' :=
        { toFun := fun c => if h : c = i₂ then none else some ⟨c, h⟩
          invFun := fun o => match o with | none => i₂ | some c => c.1
          left_inv := fun c => by by_cases h : c = i₂ <;> simp [h]
          right_inv := fun o => by cases o with | none => simp | some c => simp [c.2] }
      let e_pol : P ≃+* Polynomial P' :=
        (MvPolynomial.renameEquiv k e_opt).toRingEquiv.trans
          (MvPolynomial.optionEquivLeft k σ').toRingEquiv
      have he_i₂ : e_pol (MvPolynomial.X i₂) = Polynomial.X := by
        change (MvPolynomial.optionEquivLeft k σ')
          ((MvPolynomial.renameEquiv k e_opt) (MvPolynomial.X i₂)) = Polynomial.X
