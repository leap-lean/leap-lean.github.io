        rw [map_one, one_mul] at h1
        exact h1
      have hΦΨ : Φ.comp Ψ = RingHom.id Q_loc :=
        (hUniv Q_loc μ_Q ι_B hComm_AB).2 (Φ.comp Ψ) (RingHom.id Q_loc)
          (by rw [RingHom.comp_assoc, hΨ_Q, hΦ_Q])
          (by rw [RingHom.comp_assoc, hΨ_B, hΦ_B])
          (RingHom.id_comp μ_Q)
          (RingHom.id_comp ι_B)
      let Ψ_alg : Q_loc →ₐ[A] TensorProduct A Q₀ B :=
        ⟨Ψ, fun a => by
