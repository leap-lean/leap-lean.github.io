            rfl
          · have h10 : (1 : Fin 2) ≠ 0 := by decide
            simp [Θ_hom, g_hom, ev_inv, g_inv, h10]
            rfl
        · by_cases h : c = c₁
          · subst h
            simp only [AlgHom.comp_apply, ev_inv, g_inv, MvPolynomial.aeval_X,
              Sum.elim_inr, ite_true, map_mul, Θ_hom, g_hom, Fin.cases_zero,
              Fin.cases_succ]
            exact hProdM₀
          · simp [Θ_hom, g_hom, ev_inv, g_inv, h]
            rfl
      ext z
      obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective z
      exact AlgHom.congr_fun hPoly P
    let Θ : MvPolynomial (Fin (m + 1)) k ≃ₐ[k] M₀ :=
      AlgEquiv.ofAlgHom Θ_hom Θ_inv h_comp₂ h_comp₁
    have hΘ_X : ∀ i : Fin (m + 1), Θ (MvPolynomial.X i) = g_hom i :=
      fun i => MvPolynomial.aeval_X g_hom i
    let I_elim : Finset (Fin (m + 1)) := insert 0 (S_bdry.image Fin.succ)
    have hc₁_bdry : c₁ ∈ S_bdry := hSub c₁ (by omega)
    refine ⟨Θ, I_elim, ?_, ?_⟩
    · intro i hi
      rw [hΘ_X]
      rcases Finset.mem_insert.mp hi with rfl | hi_img
      · simp only [g_hom, Fin.cases_zero]
        exact hInl 0
      · rcases Finset.mem_image.mp hi_img with ⟨c, hc_bdry, rfl⟩
        simp only [g_hom, Fin.cases_succ]
        by_cases h : c = c₁
        · rw [if_pos h]
          exact hInl 1
        · rw [if_neg h]
          exact hInr c hc_bdry
    · intro p hp
      letI : p.IsPrime := hp
      have hφ_prod : φ_q (t c₁) = φ_q (x 0) * φ_q (x 1) := by
        rw [← hProdM₀, map_mul]
      constructor
      · rintro ⟨c, hc_bdry, hc_mem⟩
        by_cases h : c = c₁
        · subst h
          rw [hφ_prod] at hc_mem
          rcases hp.mul_mem_iff_mem_or_mem.mp hc_mem with hx0_p | hx1_p
          · refine ⟨0, Finset.mem_insert_self 0 _, ?_⟩
            rw [hΘ_X]
            simpa [g_hom] using hx0_p
          · refine ⟨c.succ, Finset.mem_insert_of_mem (Finset.mem_image_of_mem Fin.succ hc_bdry), ?_⟩
            rw [hΘ_X]
            simpa [g_hom] using hx1_p
        · refine ⟨c.succ, Finset.mem_insert_of_mem (Finset.mem_image_of_mem Fin.succ hc_bdry), ?_⟩
          rw [hΘ_X]
          simpa [g_hom, h] using hc_mem
      · rintro ⟨i, hi_elim, hi_mem⟩
        rw [hΘ_X] at hi_mem
        rcases Finset.mem_insert.mp hi_elim with rfl | hi_img
        · simp only [g_hom, Fin.cases_zero] at hi_mem
          refine ⟨c₁, hc₁_bdry, ?_⟩
          rw [hφ_prod]
          exact p.mul_mem_right _ hi_mem
        · rcases Finset.mem_image.mp hi_img with ⟨c, hc_bdry, rfl⟩
          simp only [g_hom, Fin.cases_succ] at hi_mem
          by_cases h : c = c₁
          · subst h
            rw [if_pos rfl] at hi_mem
            refine ⟨c, hc_bdry, ?_⟩
            rw [hφ_prod]
            exact p.mul_mem_left _ hi_mem
          · rw [if_neg h] at hi_mem
            exact ⟨c, hc_bdry, hi_mem⟩

theorem weil_nodal_kaehler_adjugate_exponent_eq (k : Type u) [Field k] (m : ℕ)
    (a₁ a₂ : Fin m → ℕ) (c₁ c₂ : Fin m) :
    let M₁ := MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ Ideal.span
      ({MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
        ∏ c : Fin m, MvPolynomial.X (Sum.inr c) ^ a₁ c} : Set (MvPolynomial (Fin 2 ⊕ Fin m) k))
    let M₂ := MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ Ideal.span
      ({MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
        ∏ c : Fin m, MvPolynomial.X (Sum.inr c) ^ a₂ c} : Set (MvPolynomial (Fin 2 ⊕ Fin m) k))
    let P₁ : Ideal M₁ := Ideal.span
      {Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl 0)),
       Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl 1)),
       Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c₁))}
    let P₂ : Ideal M₂ := Ideal.span
      {Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl 0)),
       Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl 1)),
       Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c₂))}
    IsAffineNodalOverlapAt k m a₁ a₂ c₁ c₂ →
    (∀ (hp₁ : P₁.IsPrime) (r : ℕ),
      letI : P₁.IsPrime := hp₁
      algebraMap M₁ (Localization.AtPrime P₁)
          (Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c₁))) ^ r ∈
        Ideal.span {algebraMap M₁ (Localization.AtPrime P₁)
                      (Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl 0))),
                    algebraMap M₁ (Localization.AtPrime P₁)
                      (Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl 1)))} ↔
        a₁ c₁ ≤ r) →
    (∀ (hp₂ : P₂.IsPrime) (r : ℕ),
      letI : P₂.IsPrime := hp₂
      algebraMap M₂ (Localization.AtPrime P₂)
          (Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c₂))) ^ r ∈
        Ideal.span {algebraMap M₂ (Localization.AtPrime P₂)
                      (Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl 0))),
                    algebraMap M₂ (Localization.AtPrime P₂)
                      (Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl 1)))} ↔
        a₂ c₂ ≤ r) →
    a₁ c₁ = a₂ c₂ :=
by
  have h_s1 : ∀ (C₀ R₁ R₂ : Type u) [CommRing C₀] [CommRing R₁] [CommRing R₂]
      [Algebra C₀ R₁] [Algebra C₀ R₂]
      (u₁ : Ideal R₁) [u₁.IsPrime] (u₂ : Ideal R₂) [u₂.IsPrime],
      u₁.comap (algebraMap C₀ R₁) = u₂.comap (algebraMap C₀ R₂) →
      ∃ (z₀ : Ideal (TensorProduct C₀ R₁ R₂)),
        z₀.IsPrime ∧
        z₀.comap Algebra.TensorProduct.includeLeftRingHom = u₁ ∧
        z₀.comap (Algebra.TensorProduct.includeRight :
          R₂ →ₐ[C₀] TensorProduct C₀ R₁ R₂).toRingHom = u₂ := by
    intro C₀ R₁ R₂ _ _ _ _ _ u₁ _ u₂ _ h_comap
    let p₀ : Ideal C₀ := u₁.comap (algebraMap C₀ R₁)
    haveI : p₀.IsPrime := Ideal.IsPrime.comap (algebraMap C₀ R₁)
    let κ₀ := p₀.ResidueField
    let κ₁ := u₁.ResidueField
    let κ₂ := u₂.ResidueField
    let f₁ : κ₀ →+* κ₁ := Ideal.ResidueField.map p₀ u₁ (algebraMap C₀ R₁) rfl
    let f₂ : κ₀ →+* κ₂ := Ideal.ResidueField.map p₀ u₂ (algebraMap C₀ R₂) h_comap
    letI : Algebra κ₀ κ₁ := f₁.toAlgebra
    letI : Algebra κ₀ κ₂ := f₂.toAlgebra
    haveI : Nontrivial (TensorProduct κ₀ κ₁ κ₂) :=
      Algebra.TensorProduct.nontrivial_of_algebraMap_injective_of_isDomain
        (R := κ₀) (A := κ₁) (B := κ₂)
        (RingHom.injective (algebraMap κ₀ κ₁)) (RingHom.injective (algebraMap κ₀ κ₂))
    let T_κ := TensorProduct κ₀ κ₁ κ₂
    let ψ₁ : R₁ →ₐ[C₀] T_κ :=
      { (Algebra.TensorProduct.includeLeft : κ₁ →ₐ[κ₀] T_κ).toRingHom.comp (algebraMap R₁ κ₁) with
        commutes' := fun c => by
          dsimp
          change (Algebra.TensorProduct.includeLeft : κ₁ →ₐ[κ₀] T_κ)
              (algebraMap R₁ κ₁ (algebraMap C₀ R₁ c)) =
            (Algebra.TensorProduct.includeLeft : κ₁ →ₐ[κ₀] T_κ) (algebraMap C₀ κ₁ c)
          rw [IsScalarTower.algebraMap_apply C₀ R₁ κ₁ c] }
    let ψ₂ : R₂ →ₐ[C₀] T_κ :=
      { (Algebra.TensorProduct.includeRight : κ₂ →ₐ[κ₀] T_κ).toRingHom.comp (algebraMap R₂ κ₂) with
        commutes' := fun c => by
          dsimp
          rw [← Ideal.ResidueField.map_algebraMap p₀ u₂ (algebraMap C₀ R₂) h_comap c]
          change (Algebra.TensorProduct.includeRight : κ₂ →ₐ[κ₀] T_κ)
              (algebraMap κ₀ κ₂ (algebraMap C₀ κ₀ c)) =
            (Algebra.TensorProduct.includeLeft : κ₁ →ₐ[κ₀] T_κ) (algebraMap C₀ κ₁ c)
          rw [(Algebra.TensorProduct.includeRight : κ₂ →ₐ[κ₀] T_κ).commutes,
            ← (Algebra.TensorProduct.includeLeft : κ₁ →ₐ[κ₀] T_κ).commutes]
          congr 1
          change f₁ (algebraMap C₀ κ₀ c) = algebraMap C₀ κ₁ c
          rw [Ideal.ResidueField.map_algebraMap p₀ u₁ (algebraMap C₀ R₁) rfl c,
            IsScalarTower.algebraMap_apply C₀ R₁ κ₁ c] }
    let Φ : TensorProduct C₀ R₁ R₂ →ₐ[C₀] T_κ :=
      Algebra.TensorProduct.lift ψ₁ ψ₂ (fun _ _ => Commute.all _ _)
    obtain ⟨m_T, hm_T⟩ := Ideal.exists_maximal T_κ
    haveI : m_T.IsPrime := hm_T.isPrime
    haveI : Nontrivial (T_κ ⧸ m_T) := Ideal.Quotient.nontrivial_iff.mpr hm_T.ne_top
    refine ⟨m_T.comap Φ.toRingHom, Ideal.IsPrime.comap Φ.toRingHom, ?_, ?_⟩
    · ext r₁
      change Φ (r₁ ⊗ₜ[C₀] 1) ∈ m_T ↔ r₁ ∈ u₁
      dsimp only [Φ]
      rw [Algebra.TensorProduct.lift_tmul, map_one, mul_one, ← Ideal.Quotient.eq_zero_iff_mem]
      let q₁ : κ₁ →+* T_κ ⧸ m_T :=
        (Ideal.Quotient.mk m_T).comp (Algebra.TensorProduct.includeLeft : κ₁ →ₐ[κ₀] T_κ).toRingHom
      change q₁ (algebraMap R₁ κ₁ r₁) = 0 ↔ r₁ ∈ u₁
      rw [map_eq_zero_iff q₁ q₁.injective, ← RingHom.mem_ker, Ideal.ker_algebraMap_residueField]
    · ext r₂
      change Φ (1 ⊗ₜ[C₀] r₂) ∈ m_T ↔ r₂ ∈ u₂
      dsimp only [Φ]
      rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul, ← Ideal.Quotient.eq_zero_iff_mem]
      let q₂ : κ₂ →+* T_κ ⧸ m_T :=
        (Ideal.Quotient.mk m_T).comp (Algebra.TensorProduct.includeRight : κ₂ →ₐ[κ₀] T_κ).toRingHom
      change q₂ (algebraMap R₂ κ₂ r₂) = 0 ↔ r₂ ∈ u₂
      rw [map_eq_zero_iff q₂ q₂.injective, ← RingHom.mem_ker, Ideal.ker_algebraMap_residueField]
  have h_s2 : ∀ (A₀ R_B B : Type u) [CommRing A₀] [CommRing R_B] [CommRing B]
      [Algebra A₀ R_B] [Algebra A₀ B] [Algebra.FormallyUnramified A₀ R_B]
      (h : R_B)
      (σ : (MvPolynomial (Fin 2) R_B ⧸ Ideal.span
        ({MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h} :
          Set (MvPolynomial (Fin 2) R_B))) →+* B),
      (∀ a : A₀, σ (algebraMap A₀ _ a) = algebraMap A₀ B a) →
      σ.FormallyEtale →
      let v : Fin 2 → B := fun b =>
        if b = 0 then σ (Ideal.Quotient.mk _ (MvPolynomial.X 1))
        else σ (Ideal.Quotient.mk _ (MvPolynomial.X 0))
      Nonempty (((Fin 2 → B) ⧸ Submodule.span B ({v} : Set (Fin 2 → B))) ≃ₗ[B] Ω[B⁄A₀]) := by
    intro A₀ R_B B _ _ _ _ _ _ h σ hAlg hFE
    let P := MvPolynomial (Fin 2) R_B
    let g : P := MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h
    let J : Ideal P := Ideal.span ({g} : Set P)
    let Q := P ⧸ J
    let π_Q : P →+* Q := Ideal.Quotient.mk J
    letI : Algebra Q B := σ.toAlgebra
    letI : Algebra R_B B := (σ.comp (algebraMap R_B Q)).toAlgebra
    haveI : IsScalarTower A₀ Q B := ⟨fun a q b => by
      rw [Algebra.smul_def a q]
      change σ (algebraMap A₀ Q a * q) * b = a • (σ q * b)
      rw [map_mul, hAlg a, Algebra.smul_def, mul_assoc]⟩
    haveI : IsScalarTower R_B Q B := ⟨fun r q b => by
      rw [Algebra.smul_def r q]
      change σ (algebraMap R_B Q r * q) * b = σ (algebraMap R_B Q r) * (σ q * b)
      rw [map_mul, mul_assoc]⟩
    haveI : Algebra.FormallyEtale Q B :=
      (RingHom.formallyEtale_algebraMap (R := Q) (S := B)).mp hFE
    let e₁ : TensorProduct Q B Ω[Q⁄A₀] ≃ₗ[B] Ω[B⁄A₀] :=
      KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale A₀ Q B
    let p_Q : Ω[Q⁄A₀] →ₗ[Q] Ω[Q⁄R_B] := KaehlerDifferential.map A₀ R_B Q Q
    have h_surj : Function.Surjective p_Q := KaehlerDifferential.map_surjective A₀ R_B Q
    haveI : Subsingleton Ω[R_B⁄A₀] := inferInstance
    have h_zero_tp : ∀ z : TensorProduct R_B Q Ω[R_B⁄A₀], z = 0 := by
      intro z
      induction z using TensorProduct.inductionOn with
      | tmul _ ω => rw [Subsingleton.elim ω 0, TensorProduct.tmul_zero]
      | add _ _ hx hy => rw [hx, hy, add_zero]
    have h_inj : Function.Injective p_Q := by
      rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
      intro x hx
      obtain ⟨u, rfl⟩ := (KaehlerDifferential.exact_mapBaseChange_map A₀ R_B Q x).mp hx
      rw [h_zero_tp u, map_zero]
    let e₂_Q : Ω[Q⁄A₀] ≃ₗ[Q] Ω[Q⁄R_B] := LinearEquiv.ofBijective p_Q ⟨h_inj, h_surj⟩
    let e₂ : TensorProduct Q B Ω[Q⁄A₀] ≃ₗ[B] TensorProduct Q B Ω[Q⁄R_B] :=
      LinearEquiv.baseChange Q B Ω[Q⁄A₀] Ω[Q⁄R_B] e₂_Q
    intro v
    let S_v : Submodule B (Fin 2 → B) := Submodule.span B ({v} : Set (Fin 2 → B))
    let V := (Fin 2 → B) ⧸ S_v
    let W := TensorProduct Q B Ω[Q⁄R_B]
    let qX₀ : Q := π_Q (MvPolynomial.X 0)
    let qX₁ : Q := π_Q (MvPolynomial.X 1)
    let ω₀ : W := (1 : B) ⊗ₜ[Q] KaehlerDifferential.D R_B Q qX₀
    let ω₁ : W := (1 : B) ⊗ₜ[Q] KaehlerDifferential.D R_B Q qX₁
    let α_tilde : (Fin 2 → B) →ₗ[B] W :=
      (LinearMap.proj (R := B) (φ := fun _ : Fin 2 => B) 0).smulRight ω₀ +
      (LinearMap.proj (R := B) (φ := fun _ : Fin 2 => B) 1).smulRight ω₁
    have h_smul_one : ∀ (q : Q) (d : Ω[Q⁄R_B]),
        σ q • ((1 : B) ⊗ₜ[Q] d) = (1 : B) ⊗ₜ[Q] (q • d) := by
      intro q d
      calc σ q • ((1 : B) ⊗ₜ[Q] d)
        _ = (σ q * 1) ⊗ₜ[Q] d := TensorProduct.smul_tmul' (σ q) (1 : B) d
        _ = (q • (1 : B)) ⊗ₜ[Q] d := by
            have hq1 : q • (1 : B) = σ q * 1 := Algebra.smul_def q (1 : B)
            rw [hq1]
        _ = (1 : B) ⊗ₜ[Q] (q • d) := TensorProduct.smul_tmul q (1 : B) d
    have h_qprod : qX₀ * qX₁ = algebraMap R_B Q h := by
      have hg0 : π_Q g = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
      dsimp [g, qX₀, qX₁] at hg0 ⊢
      rw [map_sub, map_mul, sub_eq_zero] at hg0
      rw [hg0]
      rfl
    have h_αv : α_tilde v = 0 := by
      change v 0 • ω₀ + v 1 • ω₁ = 0
      have hv0 : v 0 = σ qX₁ := rfl
      have hv1 : v 1 = σ qX₀ := rfl
      rw [hv0, hv1, h_smul_one, h_smul_one, ← TensorProduct.tmul_add, add_comm,
        ← (KaehlerDifferential.D R_B Q).leibniz qX₀ qX₁, h_qprod,
        Derivation.map_algebraMap, TensorProduct.tmul_zero]
    let α_fwd : V →ₗ[B] W :=
      Submodule.liftQ S_v α_tilde ((Submodule.span_singleton_le_iff_mem v _).mpr h_αv)
    letI : Module Q V := Module.compHom V σ
    letI : Module P V := Module.compHom V (σ.comp π_Q)
    letI : Module R_B V := Module.compHom V (σ.comp (algebraMap R_B Q))
    haveI : IsScalarTower Q B V :=
      ⟨fun q b x => by change (σ q * b) • x = σ q • (b • x); exact mul_smul (σ q) b x⟩
    haveI : IsScalarTower R_B P V :=
      ⟨fun r p x => by
        rw [Algebra.smul_def r p]
        change σ (π_Q (algebraMap R_B P r * p)) • x = σ (algebraMap R_B Q r) • (σ (π_Q p) • x)
        rw [map_mul, map_mul, mul_smul]
        rfl⟩
    haveI : IsScalarTower R_B Q V :=
      ⟨fun r q x => by
        rw [Algebra.smul_def r q]
        change σ (algebraMap R_B Q r * q) • x = σ (algebraMap R_B Q r) • (σ q • x)
        rw [map_mul, mul_smul]⟩
    let e_vec : Fin 2 → (Fin 2 → B) := fun b => Pi.single b (1 : B)
    let e_bar : Fin 2 → V := fun b => Submodule.Quotient.mk (e_vec b)
    let d_P : Derivation R_B P V := MvPolynomial.mkDerivation R_B e_bar
    have hd_g : d_P g = 0 := by
      dsimp [g]
      rw [map_sub, Derivation.leibniz, MvPolynomial.mkDerivation_X, MvPolynomial.mkDerivation_X]
      have hCh : (MvPolynomial.C h : P) = algebraMap R_B P h := rfl
      rw [hCh, Derivation.map_algebraMap, sub_zero]
      change σ qX₀ • Submodule.Quotient.mk (p := S_v) (e_vec 1) +
        σ qX₁ • Submodule.Quotient.mk (p := S_v) (e_vec 0) = 0
      rw [← Submodule.Quotient.mk_smul, ← Submodule.Quotient.mk_smul, ← Submodule.Quotient.mk_add]
      have hv_eq : σ qX₀ • e_vec 1 + σ qX₁ • e_vec 0 = v := by
        ext b; fin_cases b <;> simp [e_vec, v, qX₀, qX₁, π_Q, J, g] <;> rfl
      rw [hv_eq]
      exact (Submodule.Quotient.mk_eq_zero S_v).mpr (Submodule.subset_span rfl)
    have hJ_ker : J.restrictScalars R_B ≤ LinearMap.ker d_P.toLinearMap := by
      intro z hz
      obtain ⟨p, rfl⟩ := Ideal.mem_span_singleton.mp hz
      change d_P (g * p) = 0
      rw [Derivation.leibniz, hd_g, smul_zero, add_zero]
      change σ (π_Q g) • d_P p = 0
      have hg0 : π_Q g = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
      rw [hg0, map_zero, zero_smul]
    let d_Q_lin : Q →ₗ[R_B] V := Submodule.liftQ (J.restrictScalars R_B) d_P.toLinearMap hJ_ker
    have hd_Q_lin : ∀ p : P, d_Q_lin (π_Q p) = d_P p := fun _ => rfl
    let d_Q : Derivation R_B Q V :=
      { d_Q_lin with
        map_one_eq_zero' := by
          change d_Q_lin (π_Q 1) = 0
          rw [hd_Q_lin]
          exact d_P.map_one_eq_zero
        leibniz' := fun q₁ q₂ => by
          obtain ⟨p₁, rfl⟩ := Ideal.Quotient.mk_surjective q₁
          obtain ⟨p₂, rfl⟩ := Ideal.Quotient.mk_surjective q₂
          change d_Q_lin (π_Q (p₁ * p₂)) =
            π_Q p₁ • d_Q_lin (π_Q p₂) + π_Q p₂ • d_Q_lin (π_Q p₁)
          rw [hd_Q_lin, hd_Q_lin, hd_Q_lin]
          exact d_P.leibniz p₁ p₂ }
    let β_Q : Ω[Q⁄R_B] →ₗ[Q] V := (KaehlerDifferential.linearMapEquivDerivation R_B Q).symm d_Q
    have hβ_D : ∀ q : Q, β_Q (KaehlerDifferential.D R_B Q q) = d_Q q := by
      intro q
      have h1 := KaehlerDifferential.linearMapEquivDerivation_apply_apply R_B Q β_Q q
      rw [LinearEquiv.apply_symm_apply] at h1
      exact h1.symm
    let α_bwd : W →ₗ[B] V := LinearMap.liftBaseChange B β_Q
    have h_fwd_bar : ∀ b : Fin 2,
        α_fwd (e_bar b) = (1 : B) ⊗ₜ[Q] KaehlerDifferential.D R_B Q (π_Q (MvPolynomial.X b)) := by
      intro b
      fin_cases b
      · change e_vec 0 0 • ω₀ + e_vec 0 1 • ω₁ = ω₀
        simp [e_vec]
      · change e_vec 1 0 • ω₀ + e_vec 1 1 • ω₁ = ω₁
        simp [e_vec]
    have h_eb : ∀ b : Fin 2, α_bwd (α_fwd (e_bar b)) = e_bar b := by
      intro b
      rw [h_fwd_bar b]
      dsimp [α_bwd]
      rw [LinearMap.liftBaseChange_tmul, one_smul, hβ_D]
      change d_Q_lin (π_Q (MvPolynomial.X b)) = e_bar b
      rw [hd_Q_lin]
      exact MvPolynomial.mkDerivation_X R_B e_bar b
    have h_left : ∀ x : V, α_bwd (α_fwd x) = x := by
      intro x
      obtain ⟨u, rfl⟩ := Submodule.Quotient.mk_surjective S_v x
      have hu : u = u 0 • e_vec 0 + u 1 • e_vec 1 := by
        ext i; fin_cases i <;> simp [e_vec]
      have hu_bar : Submodule.Quotient.mk (p := S_v) u = u 0 • e_bar 0 + u 1 • e_bar 1 := by
        conv_lhs => rw [hu]
        rw [Submodule.Quotient.mk_add, Submodule.Quotient.mk_smul, Submodule.Quotient.mk_smul]
      rw [hu_bar, map_add, map_smul, map_smul, map_add, map_smul, map_smul, h_eb 0, h_eb 1]
    have h_dP_eq : ∀ p : P,
        α_fwd (d_P p) = (1 : B) ⊗ₜ[Q] KaehlerDifferential.D R_B Q (π_Q p) := by
      intro p
      induction p using MvPolynomial.induction_on with
      | C r =>
        have hCr : (MvPolynomial.C r : P) = algebraMap R_B P r := rfl
        have hQr : π_Q (MvPolynomial.C r) = algebraMap R_B Q r := rfl
        rw [hQr, Derivation.map_algebraMap, TensorProduct.tmul_zero, hCr,
          Derivation.map_algebraMap, map_zero]
      | add p₁ p₂ hp₁ hp₂ =>
        rw [map_add, map_add, hp₁, hp₂, map_add, map_add, TensorProduct.tmul_add]
      | mul_X p₁ b hp₁ =>
        rw [Derivation.leibniz, map_add]
        change α_fwd (σ (π_Q p₁) • d_P (MvPolynomial.X b)) +
            α_fwd (σ (π_Q (MvPolynomial.X b)) • d_P p₁) =
          (1 : B) ⊗ₜ[Q] KaehlerDifferential.D R_B Q (π_Q (p₁ * MvPolynomial.X b))
        rw [α_fwd.map_smul, α_fwd.map_smul, MvPolynomial.mkDerivation_X, h_fwd_bar b, hp₁,
          h_smul_one, h_smul_one, ← TensorProduct.tmul_add,
          map_mul, (KaehlerDifferential.D R_B Q).leibniz]
    have h_on_ω : ∀ ω : Ω[Q⁄R_B], α_fwd (β_Q ω) = (1 : B) ⊗ₜ[Q] ω := by
      intro ω
      have hmem : ω ∈ Submodule.span Q (Set.range (KaehlerDifferential.D R_B Q)) := by
        rw [KaehlerDifferential.span_range_derivation R_B Q]
        trivial
      refine Submodule.span_induction (p := fun ω _ => α_fwd (β_Q ω) = (1 : B) ⊗ₜ[Q] ω)
        (fun _ h => ?_) ?_ (fun _ _ _ _ hx hy => ?_) (fun q x _ hx => ?_) hmem
      · rcases h with ⟨q, rfl⟩
        obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective q
        rw [hβ_D]
        change α_fwd (d_Q_lin (π_Q p)) = (1 : B) ⊗ₜ[Q] KaehlerDifferential.D R_B Q (π_Q p)
        rw [hd_Q_lin]
        exact h_dP_eq p
      · rw [map_zero, map_zero, TensorProduct.tmul_zero]
      · rw [map_add, map_add, hx, hy, TensorProduct.tmul_add]
      · rw [β_Q.map_smul]
        change α_fwd (σ q • β_Q x) = (1 : B) ⊗ₜ[Q] (q • x)
        rw [α_fwd.map_smul, hx, h_smul_one]
    have h_right : ∀ w : W, α_fwd (α_bwd w) = w := by
      intro w
      induction w using TensorProduct.inductionOn with
      | tmul b ω =>
        change α_fwd (LinearMap.liftBaseChange B β_Q (b ⊗ₜ[Q] ω)) = b ⊗ₜ[Q] ω
        rw [LinearMap.liftBaseChange_tmul, map_smul, h_on_ω ω, TensorProduct.smul_tmul',
          smul_eq_mul, mul_one]
      | add _ _ hx hy => rw [map_add, map_add, hx, hy]
    let e₃ : V ≃ₗ[B] W :=
      LinearEquiv.ofLinearMap α_fwd α_bwd (LinearMap.ext h_right) (LinearMap.ext h_left)
    exact ⟨(e₃.trans e₂.symm).trans e₁⟩
  have h_s3 : ∀ (B : Type u) [CommRing B] [IsLocalRing B]
      (x₀ x₁ y₀ y₁ : B),
      x₀ ∈ IsLocalRing.maximalIdeal B →
      x₁ ∈ IsLocalRing.maximalIdeal B →
      y₀ ∈ IsLocalRing.maximalIdeal B →
      y₁ ∈ IsLocalRing.maximalIdeal B →
      let v₁ : Fin 2 → B := fun b => if b = 0 then x₁ else x₀
      let v₂ : Fin 2 → B := fun b => if b = 0 then y₁ else y₀
      Nonempty (((Fin 2 → B) ⧸ Submodule.span B ({v₁} : Set (Fin 2 → B))) ≃ₗ[B]
                ((Fin 2 → B) ⧸ Submodule.span B ({v₂} : Set (Fin 2 → B)))) →
      Ideal.span ({x₀, x₁} : Set B) = Ideal.span ({y₀, y₁} : Set B) := by
    intro B _ _ x₀ x₁ y₀ y₁ hx₀ hx₁ hy₀ hy₁
    have hSub : ∀ (a₀ a₁ b₀ b₁ : B),
        a₀ ∈ IsLocalRing.maximalIdeal B →
        a₁ ∈ IsLocalRing.maximalIdeal B →
        let u₁ : Fin 2 → B := fun b => if b = 0 then a₁ else a₀
        let u₂ : Fin 2 → B := fun b => if b = 0 then b₁ else b₀
        (((Fin 2 → B) ⧸ Submodule.span B ({u₁} : Set (Fin 2 → B))) ≃ₗ[B]
         ((Fin 2 → B) ⧸ Submodule.span B ({u₂} : Set (Fin 2 → B)))) →
        Ideal.span ({a₀, a₁} : Set B) ≤ Ideal.span ({b₀, b₁} : Set B) := by
      intro a₀ a₁ b₀ b₁ ha₀ ha₁ u₁ u₂ Ψ
      let S₁ := Submodule.span B ({u₁} : Set (Fin 2 → B))
      let S₂ := Submodule.span B ({u₂} : Set (Fin 2 → B))
      let e_vec : Fin 2 → (Fin 2 → B) := fun b => Pi.single b (1 : B)
      choose w hw using fun b : Fin 2 =>
        Submodule.Quotient.mk_surjective S₂ (Ψ (Submodule.Quotient.mk (e_vec b)))
      choose w' hw' using fun b : Fin 2 =>
        Submodule.Quotient.mk_surjective S₁ (Ψ.symm (Submodule.Quotient.mk (e_vec b)))
      let M : Matrix (Fin 2) (Fin 2) B := fun r b => w b r
      let M' : Matrix (Fin 2) (Fin 2) B := fun r b => w' b r
      have hM_mul : ∀ z : Fin 2 → B,
          Submodule.Quotient.mk (p := S₂) (M.mulVec z) = Ψ (Submodule.Quotient.mk (p := S₁) z) := by
        intro z
        have hz_eq : z = z 0 • e_vec 0 + z 1 • e_vec 1 := by
          ext r; fin_cases r <;> simp [e_vec]
        have hMz_eq : M.mulVec z = z 0 • w 0 + z 1 • w 1 := by
          ext r; simp [M, Matrix.mulVec, dotProduct, Fin.sum_univ_two, mul_comm]
        rw [hMz_eq, Submodule.Quotient.mk_add, Submodule.Quotient.mk_smul,
          Submodule.Quotient.mk_smul, hw 0, hw 1]
        conv_rhs => rw [hz_eq]
        rw [Submodule.Quotient.mk_add, Submodule.Quotient.mk_smul, Submodule.Quotient.mk_smul,
          map_add, map_smul, map_smul]
      have hM'_mul : ∀ z : Fin 2 → B,
          Submodule.Quotient.mk (p := S₁) (M'.mulVec z) =
            Ψ.symm (Submodule.Quotient.mk (p := S₂) z) := by
        intro z
        have hz_eq : z = z 0 • e_vec 0 + z 1 • e_vec 1 := by
          ext r; fin_cases r <;> simp [e_vec]
        have hM'z_eq : M'.mulVec z = z 0 • w' 0 + z 1 • w' 1 := by
          ext r; simp [M', Matrix.mulVec, dotProduct, Fin.sum_univ_two, mul_comm]
        rw [hM'z_eq, Submodule.Quotient.mk_add, Submodule.Quotient.mk_smul,
          Submodule.Quotient.mk_smul, hw' 0, hw' 1]
        conv_rhs => rw [hz_eq]
        rw [Submodule.Quotient.mk_add, Submodule.Quotient.mk_smul, Submodule.Quotient.mk_smul,
          map_add, map_smul, map_smul]
      let N : Matrix (Fin 2) (Fin 2) B := M' * M
      have hN_mod : ∀ r b : Fin 2,
          N r b - (1 : Matrix (Fin 2) (Fin 2) B) r b ∈ IsLocalRing.maximalIdeal B := by
        intro r b
        have hq : Submodule.Quotient.mk (p := S₁) (N.mulVec (e_vec b)) =
            Submodule.Quotient.mk (p := S₁) (e_vec b) := by
          dsimp [N]
          rw [← Matrix.mulVec_mulVec, hM'_mul, hM_mul, LinearEquiv.symm_apply_apply]
        have hmem : N.mulVec (e_vec b) - e_vec b ∈ S₁ :=
          (Submodule.Quotient.eq S₁).mp hq
        obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp hmem
        have hrc : (N.mulVec (e_vec b) - e_vec b) r = (c • u₁) r :=
          congrFun hc.symm r
        have hNrb : (N.mulVec (e_vec b)) r = N r b := by
          simp [e_vec, Matrix.mulVec, dotProduct, Fin.sum_univ_two]
          fin_cases b <;> simp
        have herb : e_vec b r = (1 : Matrix (Fin 2) (Fin 2) B) r b := by
          fin_cases r <;> fin_cases b <;> rfl
        have hu₁r : u₁ r ∈ IsLocalRing.maximalIdeal B := by
          fin_cases r
          · exact ha₁
          · exact ha₀
        change (N r b - (1 : Matrix (Fin 2) (Fin 2) B) r b) ∈ IsLocalRing.maximalIdeal B
        rw [← hNrb, ← herb]
        change (N.mulVec (e_vec b) - e_vec b) r ∈ IsLocalRing.maximalIdeal B
        rw [hrc]
        exact Ideal.mul_mem_left _ c hu₁r
      have hdetN_mod : N.det - 1 ∈ IsLocalRing.maximalIdeal B := by
        let m_B := IsLocalRing.maximalIdeal B
        have h00 : N 0 0 - 1 ∈ m_B := hN_mod 0 0
        have h11 : N 1 1 - 1 ∈ m_B := hN_mod 1 1
        have h01 : N 0 1 ∈ m_B := by
          have h := hN_mod 0 1
          rwa [Matrix.one_apply_ne (by decide : (0 : Fin 2) ≠ 1), sub_zero] at h
        have h10 : N 1 0 ∈ m_B := by
          have h := hN_mod 1 0
          rwa [Matrix.one_apply_ne (by decide : (1 : Fin 2) ≠ 0), sub_zero] at h
        have h_id : N.det - 1 =
            (N 0 0 - 1) + (N 1 1 - 1) + (N 0 0 - 1) * (N 1 1 - 1) - N 0 1 * N 1 0 := by
          rw [Matrix.det_fin_two]
          ring
        rw [h_id]
        exact m_B.sub_mem
          (m_B.add_mem (m_B.add_mem h00 h11) (m_B.mul_mem_left _ h11))
          (m_B.mul_mem_left _ h10)
      have hdetN_not_mem : N.det ∉ IsLocalRing.maximalIdeal B := by
        intro hmem
        have h1 : (1 : B) ∈ IsLocalRing.maximalIdeal B := by
          have hsub := (IsLocalRing.maximalIdeal B).sub_mem hmem hdetN_mod
          have heq : N.det - (N.det - 1) = 1 := by ring
          rwa [heq] at hsub
        exact (IsLocalRing.maximalIdeal.isMaximal B).ne_top
          ((Ideal.eq_top_iff_one _).mpr h1)
      have hu_N : IsUnit N.det := IsLocalRing.notMem_maximalIdeal.mp hdetN_not_mem
      obtain ⟨uM, huM⟩ : IsUnit M.det := by
        dsimp [N] at hu_N
        rw [Matrix.det_mul] at hu_N
        exact isUnit_of_mul_isUnit_right hu_N
      have hMu₁_zero : Submodule.Quotient.mk (p := S₂) (M.mulVec u₁) = 0 := by
        rw [hM_mul]
        have hu₁_zero : Submodule.Quotient.mk (p := S₁) u₁ = 0 :=
          (Submodule.Quotient.mk_eq_zero S₁).mpr (Submodule.subset_span rfl)
        rw [hu₁_zero, map_zero]
      obtain ⟨μ, hμ⟩ := Submodule.mem_span_singleton.mp
        ((Submodule.Quotient.mk_eq_zero S₂).mp hMu₁_zero)
      have hadj : M.det • u₁ = M.adjugate.mulVec (μ • u₂) := by
        calc M.det • u₁
          _ = (M.det • (1 : Matrix (Fin 2) (Fin 2) B)).mulVec u₁ := by
              rw [Matrix.smul_mulVec, Matrix.one_mulVec]
          _ = (M.adjugate * M).mulVec u₁ := by rw [Matrix.adjugate_mul]
          _ = M.adjugate.mulVec (M.mulVec u₁) := by rw [Matrix.mulVec_mulVec]
          _ = M.adjugate.mulVec (μ • u₂) := by rw [← hμ]
      let I_b := Ideal.span ({b₀, b₁} : Set B)
      have hb₀_mem : b₀ ∈ I_b := Ideal.subset_span (Set.mem_insert b₀ {b₁})
      have hb₁_mem : b₁ ∈ I_b := Ideal.subset_span (Set.mem_insert_of_mem b₀ rfl)
      have hdet_u₁ : ∀ r : Fin 2, M.det * u₁ r ∈ I_b := by
        intro r
        have hr : (M.det • u₁) r = (M.adjugate.mulVec (μ • u₂)) r := congrFun hadj r
        change (M.det • u₁) r ∈ I_b
        rw [hr]
        simp only [Matrix.mulVec, dotProduct, Fin.sum_univ_two, Pi.smul_apply, smul_eq_mul]
        have hu₂0 : u₂ 0 = b₁ := rfl
        have hu₂1 : u₂ 1 = b₀ := rfl
        rw [hu₂0, hu₂1]
        exact I_b.add_mem
          (I_b.mul_mem_left _ (I_b.mul_mem_left _ hb₁_mem))
          (I_b.mul_mem_left _ (I_b.mul_mem_left _ hb₀_mem))
      have ha₁_mem : a₁ ∈ I_b := by
        have h0 : M.det * a₁ ∈ I_b := hdet_u₁ 0
        have hinv := I_b.mul_mem_left (↑uM⁻¹ : B) h0
        rwa [← huM, Units.inv_mul_cancel_left] at hinv
      have ha₀_mem : a₀ ∈ I_b := by
        have h1 : M.det * a₀ ∈ I_b := hdet_u₁ 1
        have hinv := I_b.mul_mem_left (↑uM⁻¹ : B) h1
        rwa [← huM, Units.inv_mul_cancel_left] at hinv
      rw [Ideal.span_le]
      rintro z (rfl | rfl)
      · exact ha₀_mem
      · exact ha₁_mem
    rintro v₁ v₂ ⟨Ψ⟩
    exact le_antisymm (hSub x₀ x₁ y₀ y₁ hx₀ hx₁ Ψ) (hSub y₀ y₁ x₀ x₁ hy₀ hy₁ Ψ.symm)
  have h_sup_pow_iff : ∀ {R : Type u} [CommRing R] (I : Ideal R) (τ : R) (r : ℕ),
      (I ⊔ Ideal.span ({τ} : Set R)) ^ r ≤ I ↔ τ ^ r ∈ I := by
    intro R _ I τ r
    have h_pow_sup : ∀ n : ℕ,
        (I ⊔ Ideal.span ({τ} : Set R)) ^ n ≤ I ⊔ Ideal.span ({τ ^ n} : Set R) := by
      intro n
      induction n with
      | zero =>
        rw [pow_zero, pow_zero, Ideal.span_singleton_one, sup_top_eq]
        exact le_top
      | succ n ih =>
        rw [pow_succ]
        refine le_trans (Ideal.mul_mono_left ih) ?_
        rw [Ideal.mul_le]
        intro a ha b hb
        rcases Submodule.mem_sup.mp ha with ⟨i₁, hi₁, j₁, hj₁, rfl⟩
        rcases Submodule.mem_sup.mp hb with ⟨i₂, hi₂, j₂, hj₂, rfl⟩
        rcases Ideal.mem_span_singleton.mp hj₁ with ⟨c₁, rfl⟩
        rcases Ideal.mem_span_singleton.mp hj₂ with ⟨c₂, rfl⟩
        have h_id : (i₁ + τ ^ n * c₁) * (i₂ + τ * c₂) =
            (i₁ * (i₂ + τ * c₂) + (τ ^ n * c₁) * i₂) + τ ^ (n + 1) * (c₁ * c₂) := by
          rw [pow_succ]; ring
        rw [h_id]
        exact Submodule.add_mem_sup
          (I.add_mem (I.mul_mem_right _ hi₁) (I.mul_mem_left _ hi₂))
          (Ideal.mem_span_singleton.mpr ⟨c₁ * c₂, rfl⟩)
    constructor
    · intro hle
      apply hle
      have hmem_τ : τ ∈ I ⊔ Ideal.span ({τ} : Set R) :=
        Ideal.mem_sup_right (Ideal.subset_span rfl)
      exact Ideal.pow_mem_pow hmem_τ r
    · intro hmem
      exact le_trans (h_pow_sup r) (sup_le le_rfl ((Ideal.span_singleton_le_iff_mem I).mpr hmem))
  have h_s4 : ∀ (M C' : Type u) [CommRing M] [CommRing C']
      (θ : M →+* C'),
      θ.Etale →
      ∀ (z₀ : Ideal C') [z₀.IsPrime]
        (P : Ideal M) (hp : P.IsPrime),
        P = z₀.comap θ →
        ∀ (x₀ x₁ t : M),
          P = Ideal.span ({x₀, x₁, t} : Set M) →
          letI : P.IsPrime := hp
          let B_w := Localization.AtPrime z₀
          let f_B : M →+* B_w := (algebraMap C' B_w).comp θ
          ∀ (r : ℕ),
            (IsLocalRing.maximalIdeal B_w) ^ r ≤
                Ideal.span ({f_B x₀, f_B x₁} : Set B_w) ↔
              (algebraMap M (Localization.AtPrime P) t) ^ r ∈
                Ideal.span ({algebraMap M (Localization.AtPrime P) x₀,
                             algebraMap M (Localization.AtPrime P) x₁} :
                  Set (Localization.AtPrime P)) := by
    intro M C' _ _ θ hEt z₀ _ P hp hP x₀ x₁ t hP_span
    letI : P.IsPrime := hp
    intro B_w f_B r
    let A_loc := Localization.AtPrime P
    let lam : A_loc →+* B_w := Localization.localRingHom P z₀ θ hP
    let I_B : Ideal B_w := Ideal.span ({f_B x₀, f_B x₁} : Set B_w)
    let τ : B_w := f_B t
    let x₀_A : A_loc := algebraMap M A_loc x₀
    let x₁_A : A_loc := algebraMap M A_loc x₁
    let t_A : A_loc := algebraMap M A_loc t
    let I_A : Ideal A_loc := Ideal.span ({x₀_A, x₁_A} : Set A_loc)
    have h_alg_facts : IsLocalRing.maximalIdeal B_w = I_B ⊔ Ideal.span ({τ} : Set B_w) ∧
        Ideal.comap lam I_B = I_A := by
      letI : Algebra M C' := θ.toAlgebra
      letI : Algebra A_loc B_w := lam.toAlgebra
      have h_lam_comp : lam.comp (algebraMap M A_loc) = f_B :=
        RingHom.ext fun m => Localization.localRingHom_to_map P z₀ θ hP m
      haveI : IsScalarTower M A_loc B_w := ⟨fun x y z => by
        rw [Algebra.smul_def x y, Algebra.smul_def, Algebra.smul_def x, Algebra.smul_def, map_mul]
        have hx_eq : algebraMap A_loc B_w (algebraMap M A_loc x) = algebraMap M B_w x := by
          change lam (algebraMap M A_loc x) = algebraMap M B_w x
          rw [Localization.localRingHom_to_map P z₀ θ hP x,
            IsScalarTower.algebraMap_apply M C' B_w x]
          rfl
        rw [hx_eq, mul_assoc]⟩
      haveI : IsLocalHom (algebraMap A_loc B_w) := Localization.isLocalHom_localRingHom P z₀ θ hP
      haveI : Algebra.Etale M C' := hEt.toAlgebra
      have h_flat_θ : θ.Flat := (RingHom.flat_algebraMap_iff (R := M) (S := C')).mpr inferInstance
      have h_flat_lam : lam.Flat := RingHom.Flat.localRingHom h_flat_θ z₀ P hP
      haveI : Module.Flat A_loc B_w :=
        (RingHom.flat_algebraMap_iff (R := A_loc) (S := B_w)).mp h_flat_lam
      haveI : Module.FaithfullyFlat A_loc B_w := Module.FaithfullyFlat.of_flat_of_isLocalHom
      haveI : Algebra.EssFiniteType M B_w := Algebra.EssFiniteType.comp M C' B_w
      haveI : Algebra.EssFiniteType A_loc B_w := Algebra.EssFiniteType.of_comp M A_loc B_w
      haveI : Algebra.FormallyUnramified M B_w := Algebra.FormallyUnramified.comp M C' B_w
      haveI : Subsingleton Ω[B_w⁄M] := inferInstance
      haveI : Subsingleton Ω[B_w⁄A_loc] :=
        (KaehlerDifferential.map_surjective M A_loc B_w).subsingleton
      haveI : Algebra.FormallyUnramified A_loc B_w := ⟨inferInstance⟩
      refine ⟨?_, ?_⟩
      · have hset_M : ({x₀, x₁, t} : Set M) = ({x₀, x₁} : Set M) ∪ {t} := by
          ext w
          simp only [Set.mem_insert_iff, Set.mem_union, Set.mem_singleton_iff]
          exact ⟨fun h => h.elim (fun h0 => Or.inl (Or.inl h0))
              (fun h1 => h1.elim (fun h1' => Or.inl (Or.inr h1')) Or.inr),
            fun h => h.elim (fun h01 => h01.elim Or.inl (fun h1 => Or.inr (Or.inl h1)))
              (fun ht => Or.inr (Or.inr ht))⟩
        calc IsLocalRing.maximalIdeal B_w
          _ = Ideal.map (algebraMap A_loc B_w) (IsLocalRing.maximalIdeal A_loc) :=
              (Algebra.FormallyUnramified.map_maximalIdeal (R := A_loc) (S := B_w)).symm
          _ = Ideal.map lam (Ideal.map (algebraMap M A_loc) P) := by
              rw [← IsLocalization.AtPrime.map_eq_maximalIdeal P A_loc]; rfl
          _ = Ideal.map f_B P := by rw [Ideal.map_map, h_lam_comp]
          _ = Ideal.span (f_B '' ({x₀, x₁, t} : Set M)) := by rw [hP_span, Ideal.map_span]
          _ = I_B ⊔ Ideal.span ({τ} : Set B_w) := by
              rw [hset_M, Set.image_union, Set.image_pair, Set.image_singleton, Ideal.span_union]
      · have h_map_IA : Ideal.map (algebraMap A_loc B_w) I_A = I_B := by
          dsimp only [I_A, I_B]
          rw [Ideal.map_span, Set.image_pair]
          have hx0 : algebraMap A_loc B_w x₀_A = f_B x₀ :=
            Localization.localRingHom_to_map P z₀ θ hP x₀
          have hx1 : algebraMap A_loc B_w x₁_A = f_B x₁ :=
            Localization.localRingHom_to_map P z₀ θ hP x₁
          rw [hx0, hx1]
        change Ideal.comap (algebraMap A_loc B_w) I_B = I_A
        rw [← h_map_IA]
        exact Ideal.comap_map_eq_self_of_faithfullyFlat I_A
    have h_tau : lam (t_A ^ r) = τ ^ r := by
      rw [map_pow]
      congr 1
      exact Localization.localRingHom_to_map P z₀ θ hP t
    rw [h_alg_facts.1, h_sup_pow_iff, ← h_tau, ← Ideal.mem_comap, h_alg_facts.2]
  intro M₁ M₂ P₁ P₂ hOv hOrd₁ hOrd₂
  rcases hOv with ⟨A₀, C₀, _, _, f₀, R_B1, R_B2, R₁, R₂, _, _, _, _,
    α₁, α₂, β₁, β₂, u₁, hu₁, u₂, hu₂, h₁, h₂, ψ_rel1, ψ_rel2, φ₁, φ₂,
    hEt_α₁, hEt_α₂, hEt_β₁, hEt_β₂, hEt_ψ₁, hEt_ψ₂, hEt_φ₁, hEt_φ₂,
    hu_comap, hComm₁, hComm₂, hX₁, hX₂, hu₁_φ, hu₂_φ⟩
  letI : Algebra C₀ R₁ := β₁.toAlgebra
  letI : Algebra C₀ R₂ := β₂.toAlgebra
  let C' := TensorProduct C₀ R₁ R₂
  let ι₁ : R₁ →+* C' := Algebra.TensorProduct.includeLeftRingHom
  let ι₂ : R₂ →+* C' := (Algebra.TensorProduct.includeRight : R₂ →ₐ[C₀] C').toRingHom
  obtain ⟨z₀, hz₀, hz₁, hz₂⟩ := h_s1 C₀ R₁ R₂ u₁ u₂ hu_comap
  letI : z₀.IsPrime := hz₀
  let B_w := Localization.AtPrime z₀
  letI : Algebra A₀ B_w :=
    ((algebraMap C' B_w).comp ((algebraMap C₀ C').comp f₀)).toAlgebra
  have hEt_ι₁ : ι₁.Etale := by
    letI : Algebra.Etale C₀ R₂ := hEt_β₂.toAlgebra
    haveI : Algebra.Etale R₁ C' := Algebra.Etale.baseChange (R := C₀) (A := R₂) R₁
    exact (RingHom.etale_algebraMap (R := R₁) (S := C')).mpr inferInstance
  have hEt_ι₂ : ι₂.Etale := by
    letI : Algebra.Etale C₀ R₁ := hEt_β₁.toAlgebra
    haveI : Algebra.Etale R₂ (TensorProduct C₀ R₂ R₁) :=
      Algebra.Etale.baseChange (R := C₀) (A := R₁) R₂
    letI : Algebra R₂ C' := ι₂.toAlgebra
    let e_comm : TensorProduct C₀ R₂ R₁ ≃ₐ[R₂] C' :=
      { Algebra.TensorProduct.comm C₀ R₂ R₁ with commutes' := fun _ => rfl }
    haveI : Algebra.Etale R₂ C' := Algebra.Etale.of_equiv e_comm
    exact (RingHom.etale_algebraMap (R := R₂) (S := C')).mpr inferInstance
  let σ₁ := (algebraMap C' B_w).comp (ι₁.comp ψ_rel1)
  let σ₂ := (algebraMap C' B_w).comp (ι₂.comp ψ_rel2)
  let θ₁ : M₁ →+* C' := ι₁.comp φ₁
  let θ₂ : M₂ →+* C' := ι₂.comp φ₂
  let f_B1 : M₁ →+* B_w := (algebraMap C' B_w).comp θ₁
  let f_B2 : M₂ →+* B_w := (algebraMap C' B_w).comp θ₂
  have hEt_θ₁ : θ₁.Etale := RingHom.Etale.stableUnderComposition φ₁ ι₁ hEt_φ₁ hEt_ι₁
  have hEt_θ₂ : θ₂.Etale := RingHom.Etale.stableUnderComposition φ₂ ι₂ hEt_φ₂ hEt_ι₂
  have hFE_σ₁ : σ₁.FormallyEtale := by
    let Q₁ := MvPolynomial (Fin 2) R_B1 ⧸ Ideal.span
      ({MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h₁} :
        Set (MvPolynomial (Fin 2) R_B1))
    have hEt_ψι₁ : (ι₁.comp ψ_rel1).Etale :=
      RingHom.Etale.stableUnderComposition ψ_rel1 ι₁ hEt_ψ₁ hEt_ι₁
    letI : Algebra Q₁ C' := (ι₁.comp ψ_rel1).toAlgebra
    haveI : Algebra.Etale Q₁ C' := hEt_ψι₁.toAlgebra
    haveI : Algebra.FormallyEtale Q₁ B_w := Algebra.FormallyEtale.comp Q₁ C' B_w
    have h_eq : algebraMap Q₁ B_w = σ₁ := IsScalarTower.algebraMap_eq Q₁ C' B_w
    rw [← h_eq]
    exact (RingHom.formallyEtale_algebraMap (R := Q₁) (S := B_w)).mpr inferInstance
  have hFE_σ₂ : σ₂.FormallyEtale := by
    let Q₂ := MvPolynomial (Fin 2) R_B2 ⧸ Ideal.span
      ({MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C h₂} :
        Set (MvPolynomial (Fin 2) R_B2))
    have hEt_ψι₂ : (ι₂.comp ψ_rel2).Etale :=
      RingHom.Etale.stableUnderComposition ψ_rel2 ι₂ hEt_ψ₂ hEt_ι₂
    letI : Algebra Q₂ C' := (ι₂.comp ψ_rel2).toAlgebra
    haveI : Algebra.Etale Q₂ C' := hEt_ψι₂.toAlgebra
    haveI : Algebra.FormallyEtale Q₂ B_w := Algebra.FormallyEtale.comp Q₂ C' B_w
    have h_eq : algebraMap Q₂ B_w = σ₂ := IsScalarTower.algebraMap_eq Q₂ C' B_w
    rw [← h_eq]
    exact (RingHom.formallyEtale_algebraMap (R := Q₂) (S := B_w)).mpr inferInstance
  obtain ⟨Φ₁⟩ : Nonempty (((Fin 2 → B_w) ⧸ Submodule.span B_w
      ({fun b : Fin 2 => if b = 0 then σ₁ (Ideal.Quotient.mk _ (MvPolynomial.X 1))
        else σ₁ (Ideal.Quotient.mk _ (MvPolynomial.X 0))} : Set (Fin 2 → B_w))) ≃ₗ[B_w]
      Ω[B_w⁄A₀]) := by
    letI : Algebra A₀ R_B1 := α₁.toAlgebra
    haveI : Algebra.Etale A₀ R_B1 := hEt_α₁.toAlgebra
    refine h_s2 A₀ R_B1 B_w h₁ σ₁ (fun a => ?_) hFE_σ₁
    have h1 := RingHom.congr_fun hComm₁ a
    dsimp [σ₁]
    change algebraMap C' B_w (ι₁ ((ψ_rel1.comp ((Ideal.Quotient.mk _).comp
      (MvPolynomial.C.comp α₁))) a)) =
      algebraMap C' B_w (algebraMap C₀ C' (f₀ a))
    rw [h1]
    exact congrArg (algebraMap C' B_w)
      ((Algebra.TensorProduct.includeLeft : R₁ →ₐ[C₀] C').commutes (f₀ a))
  obtain ⟨Φ₂⟩ : Nonempty (((Fin 2 → B_w) ⧸ Submodule.span B_w
      ({fun b : Fin 2 => if b = 0 then σ₂ (Ideal.Quotient.mk _ (MvPolynomial.X 1))
        else σ₂ (Ideal.Quotient.mk _ (MvPolynomial.X 0))} : Set (Fin 2 → B_w))) ≃ₗ[B_w]
      Ω[B_w⁄A₀]) := by
    letI : Algebra A₀ R_B2 := α₂.toAlgebra
    haveI : Algebra.Etale A₀ R_B2 := hEt_α₂.toAlgebra
    refine h_s2 A₀ R_B2 B_w h₂ σ₂ (fun a => ?_) hFE_σ₂
    have h2 := RingHom.congr_fun hComm₂ a
    dsimp [σ₂]
    change algebraMap C' B_w (ι₂ ((ψ_rel2.comp ((Ideal.Quotient.mk _).comp
      (MvPolynomial.C.comp α₂))) a)) =
      algebraMap C' B_w (algebraMap C₀ C' (f₀ a))
    rw [h2]
    exact congrArg (algebraMap C' B_w)
      ((Algebra.TensorProduct.includeRight : R₂ →ₐ[C₀] C').commutes (f₀ a))
  let x₁₀ : M₁ := Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl 0))
  let x₁₁ : M₁ := Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl 1))
  let t₁ : M₁ := Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c₁))
  let x₂₀ : M₂ := Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl 0))
  let x₂₁ : M₂ := Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl 1))
  let t₂ : M₂ := Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c₂))
  have hv₁_eq : (fun b : Fin 2 =>
      if b = 0 then σ₁ (Ideal.Quotient.mk _ (MvPolynomial.X 1))
      else σ₁ (Ideal.Quotient.mk _ (MvPolynomial.X 0))) =
      (fun b : Fin 2 => if b = 0 then f_B1 x₁₁ else f_B1 x₁₀) := by
    ext b
    fin_cases b
    · dsimp [σ₁, f_B1, θ₁, x₁₁]
      rw [hX₁ 1]
    · dsimp [σ₁, f_B1, θ₁, x₁₀]
      rw [hX₁ 0]
  have hv₂_eq : (fun b : Fin 2 =>
      if b = 0 then σ₂ (Ideal.Quotient.mk _ (MvPolynomial.X 1))
      else σ₂ (Ideal.Quotient.mk _ (MvPolynomial.X 0))) =
      (fun b : Fin 2 => if b = 0 then f_B2 x₂₁ else f_B2 x₂₀) := by
    ext b
    fin_cases b
    · dsimp [σ₂, f_B2, θ₂, x₂₁]
      rw [hX₂ 1]
    · dsimp [σ₂, f_B2, θ₂, x₂₀]
      rw [hX₂ 0]
  have hP₁_comap : P₁ = z₀.comap θ₁ := by
    dsimp [θ₁, P₁]
    rw [← Ideal.comap_comap, hz₁, hu₁_φ]
  have hP₂_comap : P₂ = z₀.comap θ₂ := by
    dsimp [θ₂, P₂]
    rw [← Ideal.comap_comap, hz₂, hu₂_φ]
  have hp₁ : P₁.IsPrime := hP₁_comap ▸ Ideal.IsPrime.comap θ₁
  have hp₂ : P₂.IsPrime := hP₂_comap ▸ Ideal.IsPrime.comap θ₂
  have hx₁₀_m : f_B1 x₁₀ ∈ IsLocalRing.maximalIdeal B_w := by
    refine (IsLocalization.AtPrime.to_map_mem_maximal_iff B_w z₀ (θ₁ x₁₀)).mpr ?_
    change x₁₀ ∈ z₀.comap θ₁
    rw [← hP₁_comap]
    exact Ideal.subset_span (by simp [x₁₀])
  have hx₁₁_m : f_B1 x₁₁ ∈ IsLocalRing.maximalIdeal B_w := by
    refine (IsLocalization.AtPrime.to_map_mem_maximal_iff B_w z₀ (θ₁ x₁₁)).mpr ?_
    change x₁₁ ∈ z₀.comap θ₁
    rw [← hP₁_comap]
    exact Ideal.subset_span (by simp [x₁₁])
  have hx₂₀_m : f_B2 x₂₀ ∈ IsLocalRing.maximalIdeal B_w := by
    refine (IsLocalization.AtPrime.to_map_mem_maximal_iff B_w z₀ (θ₂ x₂₀)).mpr ?_
    change x₂₀ ∈ z₀.comap θ₂
    rw [← hP₂_comap]
    exact Ideal.subset_span (by simp [x₂₀])
  have hx₂₁_m : f_B2 x₂₁ ∈ IsLocalRing.maximalIdeal B_w := by
    refine (IsLocalization.AtPrime.to_map_mem_maximal_iff B_w z₀ (θ₂ x₂₁)).mpr ?_
    change x₂₁ ∈ z₀.comap θ₂
    rw [← hP₂_comap]
    exact Ideal.subset_span (by simp [x₂₁])
  have h_equiv_12 : Nonempty (((Fin 2 → B_w) ⧸ Submodule.span B_w
      ({fun b : Fin 2 => if b = 0 then f_B1 x₁₁ else f_B1 x₁₀} : Set (Fin 2 → B_w))) ≃ₗ[B_w]
      ((Fin 2 → B_w) ⧸ Submodule.span B_w
      ({fun b : Fin 2 => if b = 0 then f_B2 x₂₁ else f_B2 x₂₀} : Set (Fin 2 → B_w)))) := by
    rw [← hv₁_eq, ← hv₂_eq]
    exact ⟨Φ₁.trans Φ₂.symm⟩
  have hI_eq : Ideal.span ({f_B1 x₁₀, f_B1 x₁₁} : Set B_w) =
      Ideal.span ({f_B2 x₂₀, f_B2 x₂₁} : Set B_w) :=
    h_s3 B_w (f_B1 x₁₀) (f_B1 x₁₁) (f_B2 x₂₀) (f_B2 x₂₁)
      hx₁₀_m hx₁₁_m hx₂₀_m hx₂₁_m h_equiv_12
  have h_iff_all : ∀ r : ℕ, a₁ c₁ ≤ r ↔ a₂ c₂ ≤ r := by
    intro r
    have h1 := h_s4 M₁ C' θ₁ hEt_θ₁ z₀ P₁ hp₁ hP₁_comap x₁₀ x₁₁ t₁ rfl r
    have h2 := h_s4 M₂ C' θ₂ hEt_θ₂ z₀ P₂ hp₂ hP₂_comap x₂₀ x₂₁ t₂ rfl r
    rw [← hOrd₁ hp₁ r, ← h1, hI_eq, h2, hOrd₂ hp₂ r]
  exact le_antisymm ((h_iff_all (a₂ c₂)).mpr le_rfl) ((h_iff_all (a₁ c₁)).mp le_rfl)

theorem weil_projective_closed_irreducible_components (k : Type u) [Field k]
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hProj : IsProjectiveOverField k X)
    (S : Set X.left) (hClosedS : IsClosed S) :
    ∃ (L : ℕ) (Z : Fin L → TopologicalSpace.Closeds ↥X.left) (η : Fin L → ↥X.left),
      (∀ γ : Fin L, (Z γ : Set X.left) ⊆ S) ∧
      (∀ γ : Fin L, IsIrreducible (Z γ : Set X.left)) ∧
      (∀ γ : Fin L, η γ ∈ (Z γ : Set X.left) ∧ closure {η γ} = (Z γ : Set X.left)) ∧
      (_root_.Pairwise fun γ₁ γ₂ : Fin L => ¬ ((Z γ₁ : Set X.left) ⊆ (Z γ₂ : Set X.left))) ∧
      (S = ⋃ γ : Fin L, (Z γ : Set X.left)) ∧
      (∀ (Y : Set X.left), Y ⊆ S → IsClosed Y → IsIrreducible Y →
        ∃ γ : Fin L, Y ⊆ (Z γ : Set X.left)) :=
by
  classical
  obtain ⟨M, ι, hCl⟩ := hProj
  have _ : AlgebraicGeometry.IsClosedImmersion ι.left := hCl
  let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k
  let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
  have _ : IsScalarTower k (↥(𝒜 0)) (MvPolynomial (Fin (M + 1)) k) :=
    ⟨fun c x p => smul_mul_assoc c (x : MvPolynomial (Fin (M + 1)) k) p⟩
  have _ : Algebra.FiniteType (↥(𝒜 0)) (MvPolynomial (Fin (M + 1)) k) :=
    Algebra.FiniteType.of_restrictScalars_finiteType k (↥(𝒜 0)) (MvPolynomial (Fin (M + 1)) k)
  have h_surj : Function.Surjective (algebraMap k ↥(𝒜 0)) := by
    intro x
    have hx : (x : MvPolynomial (Fin (M + 1)) k) ∈
        (1 : Submodule k (MvPolynomial (Fin (M + 1)) k)) := by
      rw [← MvPolynomial.homogeneousSubmodule_zero (Fin (M + 1))]
      exact x.2
    obtain ⟨c, hc⟩ := Submodule.mem_one.mp hx
    refine ⟨c, Subtype.ext ?_⟩
    rw [Algebra.algebraMap_eq_smul_one]
    change c • (1 : MvPolynomial (Fin (M + 1)) k) = ↑x
    rwa [← Algebra.algebraMap_eq_smul_one]
  have _ : IsNoetherianRing ↥(𝒜 0) :=
    isNoetherianRing_of_surjective k (↥(𝒜 0)) (algebraMap k ↥(𝒜 0)) h_surj
  have _ : CompactSpace ↥(AlgebraicGeometry.Proj 𝒜) :=
    AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace
      (AlgebraicGeometry.Proj.toSpecZero 𝒜)
  have _ : AlgebraicGeometry.IsLocallyNoetherian (AlgebraicGeometry.Proj 𝒜) :=
    AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian
      (AlgebraicGeometry.Proj.toSpecZero 𝒜)
  have _ : AlgebraicGeometry.IsNoetherian (AlgebraicGeometry.Proj 𝒜) := {}
  have _ : TopologicalSpace.NoetherianSpace ↥(weilProjectiveSpaceOver k M).left := by
    change TopologicalSpace.NoetherianSpace ↥(AlgebraicGeometry.Proj 𝒜)
    exact AlgebraicGeometry.IsNoetherian.noetherianSpace
  have _ : TopologicalSpace.NoetherianSpace ↥X.left :=
    ι.left.isClosedEmbedding.toIsEmbedding.toIsInducing.noetherianSpace
  have _ : TopologicalSpace.NoetherianSpace ↥S :=
    Topology.IsInducing.subtypeVal.noetherianSpace
  have hFinComp : (irreducibleComponents ↥S).Finite :=
    TopologicalSpace.NoetherianSpace.finite_irreducibleComponents
  have _ : Finite ↥(irreducibleComponents ↥S) := hFinComp.to_subtype
  obtain ⟨L, ⟨e_inv⟩⟩ := Finite.exists_equiv_fin ↥(irreducibleComponents ↥S)
  let e_comp : Fin L ≃ ↥(irreducibleComponents ↥S) := e_inv.symm
  let C : Fin L → Set ↥S := fun γ => (e_comp γ).1
  let F : Fin L → Set X.left := fun γ => (Subtype.val : ↥S → X.left) '' C γ
  have hMaxC : ∀ γ : Fin L, Maximal (fun x : Set ↥S => IsClosed x ∧ IsIrreducible x) (C γ) := by
    intro γ
    have hMem : C γ ∈ irreducibleComponents ↥S := (e_comp γ).2
    rwa [irreducibleComponents_eq_maximals_closed] at hMem
  have hClF : ∀ γ : Fin L, IsClosed (F γ) :=
    fun γ => hClosedS.isClosedEmbedding_subtypeVal.isClosedMap (C γ) (hMaxC γ).prop.1
  let Z : Fin L → TopologicalSpace.Closeds ↥X.left := fun γ => ⟨F γ, hClF γ⟩
  have hZSub : ∀ γ : Fin L, (Z γ : Set X.left) ⊆ S := by
    rintro γ x ⟨y, _, rfl⟩
    exact y.2
  have hIrredZ : ∀ γ : Fin L, IsIrreducible (Z γ : Set X.left) :=
    fun γ => (hMaxC γ).prop.2.image Subtype.val continuous_subtype_val.continuousOn
  let η : Fin L → ↥X.left := fun γ => (hIrredZ γ).genericPoint
  have hClos : ∀ γ : Fin L, closure {η γ} = (Z γ : Set X.left) := fun γ =>
    (hIrredZ γ).closure_genericPoint (Z γ).isClosed
  have hη : ∀ γ : Fin L, η γ ∈ (Z γ : Set X.left) ∧ closure {η γ} = (Z γ : Set X.left) := by
    intro γ
    refine ⟨?_, hClos γ⟩
    rw [← hClos γ]
    exact subset_closure (Set.mem_singleton (η γ))
  have hPairZ : _root_.Pairwise fun γ₁ γ₂ : Fin L => ¬ ((Z γ₁ : Set X.left) ⊆ (Z γ₂ : Set X.left)) := by
    intro γ₁ γ₂ hne hSub
    have hSubC : C γ₁ ⊆ C γ₂ := (Set.image_subset_image_iff Subtype.val_injective).mp hSub
    have hEqC : C γ₁ = C γ₂ := (hMaxC γ₁).eq_of_le (hMaxC γ₂).prop hSubC
    exact hne (e_comp.injective (Subtype.ext hEqC))
  have hUnionZ : S = ⋃ γ : Fin L, (Z γ : Set X.left) := by
    refine Set.Subset.antisymm ?_ (Set.iUnion_subset hZSub)
    intro x hx
    let y : ↥S := ⟨x, hx⟩
    let c_y : ↥(irreducibleComponents ↥S) :=
      ⟨irreducibleComponent y, irreducibleComponent_mem_irreducibleComponents y⟩
    refine Set.mem_iUnion.mpr ⟨e_inv c_y, y, ?_, rfl⟩
    have h_eq : C (e_inv c_y) = irreducibleComponent y :=
      congrArg Subtype.val (e_inv.symm_apply_apply c_y)
    rw [h_eq]
    exact mem_irreducibleComponent
  have hMax : ∀ (Y : Set X.left), Y ⊆ S → IsClosed Y → IsIrreducible Y →
      ∃ γ : Fin L, Y ⊆ (Z γ : Set X.left) := by
    intro Y hYS _hClosedY hIrredY
    let t : Finset (Set X.left) := Finset.univ.image (fun γ : Fin L => (Z γ : Set X.left))
    have hCl_t : ∀ z ∈ t, IsClosed z := by
      intro z hz
      obtain ⟨γ, _, rfl⟩ := Finset.mem_image.mp hz
      exact (Z γ).isClosed
    have hSub_t : Y ⊆ ⋃₀ (↑t : Set (Set X.left)) := by
      intro y hy
      have hyS : y ∈ S := hYS hy
      rw [hUnionZ] at hyS
      obtain ⟨γ, hyZ⟩ := Set.mem_iUnion.mp hyS
      exact Set.mem_sUnion.mpr ⟨(Z γ : Set X.left),
        Finset.mem_coe.mpr (Finset.mem_image_of_mem _ (Finset.mem_univ γ)), hyZ⟩
    obtain ⟨z, hz_mem, hYz⟩ := (isIrreducible_iff_sUnion_isClosed.mp hIrredY) t hCl_t hSub_t
    obtain ⟨γ, _, rfl⟩ := Finset.mem_image.mp hz_mem
    exact ⟨γ, hYz⟩
  exact ⟨L, Z, η, hZSub, hIrredZ, hη, hPairZ, hUnionZ, hMax⟩

theorem weil_relative_toroidal_branch_matching_and_overlap (k : Type u) [Field k] (m : ℕ)
    (B₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (r_B : ℕ) (D_B : Fin r_B → AlgebraicGeometry.Scheme.{u})
    (ιD_B : ∀ i : Fin r_B, D_B i ⟶ B₁.left)
    (hClD_B : ∀ i : Fin r_B, AlgebraicGeometry.IsClosedImmersion (ιD_B i))
    (C₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (Z₁ : Set C₁.left) (f₁ : C₁ ⟶ B₁)
    (S_rel : Set C₁.left) (hClosedS : IsClosed S_rel)
    (L : ℕ) (Z : Fin L → TopologicalSpace.Closeds ↥C₁.left) (η : Fin L → ↥C₁.left)
    (hZ_sub : ∀ γ : Fin L, (Z γ : Set C₁.left) ⊆ S_rel)
    (hη : ∀ γ : Fin L, η γ ∈ (Z γ : Set C₁.left) ∧ closure {η γ} = (Z γ : Set C₁.left))
    (hIncomp : _root_.Pairwise fun γ₁ γ₂ : Fin L => ¬ ((Z γ₁ : Set C₁.left) ⊆ (Z γ₂ : Set C₁.left)))
    (hMax : ∀ Y : Set C₁.left, Y ⊆ S_rel → IsClosed Y → IsIrreducible Y →
      ∃ γ : Fin L, Y ⊆ (Z γ : Set C₁.left))
    (hPrimeExist : ∀ (a : Fin m → ℕ),
      let M₀ := MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ Ideal.span
        ({MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
          ∏ c : Fin m, MvPolynomial.X (Sum.inr c) ^ a c} : Set (MvPolynomial (Fin 2 ⊕ Fin m) k))
      ∀ (Q : Ideal M₀), Q.IsPrime →
        Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl 0)) ∈ Q →
        ∃ c : Fin m, 1 ≤ a c ∧ Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c)) ∈ Q)
    (hBranchPrime : ∀ (a : Fin m → ℕ) (c₀ : Fin m), 1 ≤ a c₀ →
      let M₀ := MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ Ideal.span
        ({MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
