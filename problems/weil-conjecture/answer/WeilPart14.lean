      have hSpec_g₃_et : Etale (Spec.map hom_g₃) := by
        have hHom_comp : hom_map_A₂ ≫ hom_g₃ = hom_RHS :=
          congrArg (@CommRingCat.ofHom (MvPolynomial (Fin 1) A₂_ring) S₃_ring _ _) hg₃_comm
        have hCompSpec : Spec.map hom_g₃ ≫ Spec.map hom_map_A₂ = Spec.map hom_RHS := by
          rw [← Spec.map_comp, hHom_comp]
        exact @CategoryTheory.MorphismProperty.of_postcomp _ _ (@Etale) (@Etale) _ _ _ _
