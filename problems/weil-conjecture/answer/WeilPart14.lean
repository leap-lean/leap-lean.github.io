      calc pL ≫ σ_loc ij
          = (pL ≫ (θ ij).hom) ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ ij)) ≫ w_N ν :=
              (CategoryTheory.Category.assoc _ _ _).symm
        _ = q_O ≫ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_L) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ ij))) ≫ w_N ν := by
