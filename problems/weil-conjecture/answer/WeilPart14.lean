    have hw_star_prime : w_star_id.IsPrime := hP_prime.comap (Ideal.Quotient.mk Q_loc)
    have hw_star_le : w_star_id ≤ w₁.asIdeal := by
      intro z hz
      have hz_W : Ideal.Quotient.mk Q_loc z ∈ W_bar := hP_le_W hz
