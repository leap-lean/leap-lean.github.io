      exact Algebra.Etale.comp R₁ R₂ R₃
    have hEtaleOfFactor : ∀ {R₁ R₂ R₃ R₄ : Type u}
        [CommRing R₁] [CommRing R₂] [CommRing R₃] [CommRing R₄]
        (f₁ : R₁ →+* R₂) (f₂ : R₂ →+* R₃) (e₃ : R₃ → R₄) (g : R₁ →+* R₄),
        f₁.Etale → f₂.Etale → Function.Bijective e₃ →
        e₃ 1 = 1 → (∀ x y, e₃ (x * y) = e₃ x * e₃ y) →
        e₃ 0 = 0 → (∀ x y, e₃ (x + y) = e₃ x + e₃ y) →
        (∀ x, g x = e₃ (f₂ (f₁ x))) → g.Etale := by
      intro R₁ R₂ R₃ R₄ _ _ _ _ f₁ f₂ e₃ g hf₁ hf₂ he₃_bij he₃_1 he₃_mul he₃_0 he₃_add h_eq
      let f₃ : R₃ →+* R₄ :=
        { toFun := e₃
          map_one' := he₃_1
          map_mul' := he₃_mul
          map_zero' := he₃_0
          map_add' := he₃_add }
      have hf₃ : f₃.Etale := RingHom.Etale.of_bijective he₃_bij
      have hCompEt : (f₃.comp (f₂.comp f₁)).Etale :=
        hEtaleComp f₁ (f₃.comp f₂) hf₁ (hEtaleComp f₂ f₃ hf₂ hf₃)
      have hg_eq : g = f₃.comp (f₂.comp f₁) := RingHom.ext h_eq
      rwa [hg_eq]
    let P_m1 := MvPolynomial (Fin (m + 1)) k
    let P_m := MvPolynomial (Fin m) k
    let J₀ : Ideal P_m1 := Ideal.span {MvPolynomial.X j₀}
    let ι_skip : P_m →ₐ[k] P_m1 := MvPolynomial.rename j₀.succAbove
    let π_kill : P_m1 →ₐ[k] P_m :=
      MvPolynomial.aeval (j₀.insertNth (α := fun _ => P_m) 0 MvPolynomial.X)
    have hLeftInv : π_kill.comp ι_skip = AlgHom.id k P_m := by
      apply MvPolynomial.algHom_ext
      intro i
      change π_kill (ι_skip (MvPolynomial.X i)) = MvPolynomial.X i
      dsimp only [π_kill, ι_skip]
      rw [MvPolynomial.rename_X, MvPolynomial.aeval_X, Fin.insertNth_apply_succAbove]
    have hKerKill : ∀ p ∈ J₀, π_kill p = 0 := by
      intro p hp
      rw [Ideal.mem_span_singleton] at hp
      rcases hp with ⟨q, rfl⟩
      rw [map_mul]
      have hX0 : π_kill (MvPolynomial.X j₀) = 0 := by
        dsimp only [π_kill]
        rw [MvPolynomial.aeval_X, Fin.insertNth_apply_same]
      rw [hX0, zero_mul]
    let lift_kill : (P_m1 ⧸ J₀) →ₐ[k] P_m := Ideal.Quotient.liftₐ J₀ π_kill hKerKill
    let fwd : P_m →ₐ[k] (P_m1 ⧸ J₀) := (Ideal.Quotient.mkₐ k J₀).comp ι_skip
    have hComp1 : lift_kill.comp fwd = AlgHom.id k P_m :=
      AlgHom.ext fun x => AlgHom.congr_fun hLeftInv x
    have hComp2 : fwd.comp lift_kill = AlgHom.id k (P_m1 ⧸ J₀) := by
      apply Ideal.Quotient.algHom_ext
      apply MvPolynomial.algHom_ext
      intro r
      rcases Fin.eq_self_or_eq_succAbove j₀ r with hr | ⟨i, rfl⟩
      · subst hr
        change fwd (π_kill (MvPolynomial.X r)) = Ideal.Quotient.mk J₀ (MvPolynomial.X r)
        have h1 : π_kill (MvPolynomial.X r) = 0 := by
          dsimp only [π_kill]
          rw [MvPolynomial.aeval_X, Fin.insertNth_apply_same]
        have h2 : Ideal.Quotient.mk J₀ (MvPolynomial.X r) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
        rw [h1, map_zero, h2]
      · change fwd (π_kill (MvPolynomial.X (j₀.succAbove i))) =
          Ideal.Quotient.mk J₀ (MvPolynomial.X (j₀.succAbove i))
        dsimp only [fwd, π_kill, ι_skip]
        rw [MvPolynomial.aeval_X, Fin.insertNth_apply_succAbove, AlgHom.comp_apply,
          MvPolynomial.rename_X]
        rfl
    let Φ_j₀ : P_m ≃ₐ[k] (P_m1 ⧸ J₀) := AlgEquiv.ofAlgHom fwd lift_kill hComp2 hComp1
    let J : Ideal R'' := Ideal.span {ψ'' (MvPolynomial.X j₀)}
    let ψ_J : P_m →+* (↑R'' ⧸ J) := (Ideal.Quotient.mk J).comp (ψ''.comp ι_skip.toRingHom)
    have hEt_ψ''_ring : ψ''.Etale :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hEt_ψ
    have hEt_ψJ : ψ_J.Etale := by
      let _ : Algebra P_m1 R'' := ψ''.toAlgebra
      have : Algebra.Etale P_m1 R'' := hEt_ψ''_ring
      have : Algebra.Etale (P_m1 ⧸ J₀) (TensorProduct P_m1 (P_m1 ⧸ J₀) R'') :=
        Algebra.Etale.baseChange (R := P_m1) (A := R'') (B := P_m1 ⧸ J₀)
      have hMapJ : Ideal.map (algebraMap P_m1 R'') J₀ = J := by
        change Ideal.map ψ'' (Ideal.span {MvPolynomial.X j₀}) = Ideal.span {ψ'' (MvPolynomial.X j₀)}
        rw [Ideal.map_span, Set.image_singleton]
      let e_raw := (Algebra.TensorProduct.comm P_m1 (P_m1 ⧸ J₀) R'').toRingEquiv.trans
        ((Algebra.TensorProduct.quotIdealMapEquivTensorQuot R'' J₀).symm.toRingEquiv.trans
          (Ideal.quotEquivOfEq hMapJ))
      have hEt1 : Φ_j₀.toAlgHom.toRingHom.Etale := RingHom.Etale.of_bijective Φ_j₀.bijective
      have hEt2 : (algebraMap (P_m1 ⧸ J₀) (TensorProduct P_m1 (P_m1 ⧸ J₀) R'')).Etale :=
        RingHom.etale_algebraMap.mpr inferInstance
      refine hEtaleOfFactor Φ_j₀.toAlgHom.toRingHom
        (algebraMap (P_m1 ⧸ J₀) (TensorProduct P_m1 (P_m1 ⧸ J₀) R''))
        (fun x => e_raw x) ψ_J hEt1 hEt2 e_raw.bijective
        (map_one e_raw) (map_mul e_raw) (map_zero e_raw) (map_add e_raw) ?_
      intro p
      change Ideal.Quotient.mk J (ψ'' (ι_skip p)) =
        (Ideal.quotEquivOfEq hMapJ)
          ((Algebra.TensorProduct.quotIdealMapEquivTensorQuot R'' J₀).symm
            ((1 : R'') ⊗ₜ[P_m1] Ideal.Quotient.mk J₀ (ι_skip p)))
      have hTmulEq : ((1 : R'') ⊗ₜ[P_m1] Ideal.Quotient.mk J₀ (ι_skip p)) =
          (ψ'' (ι_skip p)) ⊗ₜ[P_m1] (1 : P_m1 ⧸ J₀) := by
        have hSmulQ : Ideal.Quotient.mk J₀ (ι_skip p) = (ι_skip p) • (1 : P_m1 ⧸ J₀) := by
          change Ideal.Quotient.mk J₀ (ι_skip p) = Ideal.Quotient.mk J₀ (ι_skip p * 1)
          rw [mul_one]
        rw [hSmulQ, ← TensorProduct.smul_tmul, Algebra.smul_def, mul_one]
        rfl
      have hSymmEq : (Algebra.TensorProduct.quotIdealMapEquivTensorQuot R'' J₀).symm
          ((ψ'' (ι_skip p)) ⊗ₜ[P_m1] (1 : P_m1 ⧸ J₀)) =
          Ideal.Quotient.mk (Ideal.map (algebraMap P_m1 R'') J₀) (ψ'' (ι_skip p)) := by
        apply (Algebra.TensorProduct.quotIdealMapEquivTensorQuot R'' J₀).injective
        rw [AlgEquiv.apply_symm_apply, Algebra.TensorProduct.quotIdealMapEquivTensorQuot_mk]
      rw [hTmulEq, hSymmEq]
      rfl
    let P_D := CategoryTheory.Limits.pullback ι_D e_Y
    let p₁ : P_D ⟶ D := CategoryTheory.Limits.pullback.fst ι_D e_Y
    let p₂ : P_D ⟶ AlgebraicGeometry.Spec R'' := CategoryTheory.Limits.pullback.snd ι_D e_Y
    have hEt_p₁ : AlgebraicGeometry.Etale p₁ :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback ι_D e_Y).flip hEt_e
    have hCl_p₂ : AlgebraicGeometry.IsClosedImmersion p₂ := inferInstance
    obtain ⟨I, e_iso, he_iso⟩ := AlgebraicGeometry.IsClosedImmersion.Spec_iff.mp hCl_p₂
    let e_D : AlgebraicGeometry.Spec (CommRingCat.of (↑R'' ⧸ I)) ⟶ D := e_iso.inv ≫ p₁
    have hEt_eD : AlgebraicGeometry.Etale e_D := by
      have : AlgebraicGeometry.Etale p₁ := hEt_p₁
      infer_instance
    obtain ⟨p₀, hp₀_1, _hp₀_2⟩ :=
      AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback z w₀ hw₀.symm
    let u₀ : AlgebraicGeometry.Spec (CommRingCat.of (↑R'' ⧸ I)) := e_iso.hom.base p₀
    have hu₀ : e_D.base u₀ = z := by
      change p₁.base ((e_iso.hom ≫ e_iso.inv).base p₀) = z
      rw [e_iso.hom_inv_id]
      exact hp₀_1
    have hRedI : _root_.IsReduced (↑R'' ⧸ I) :=
      hRed_of_etale D hIntD (↑R'' ⧸ I) e_D hEt_eD
    have hRadI : I.IsRadical := (Ideal.isRadical_iff_quotient_reduced I).mpr hRedI
    have hEt_ψJ_spec : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_J)) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hEt_ψJ
    have hIntPm : AlgebraicGeometry.IsIntegral (AlgebraicGeometry.Spec (CommRingCat.of P_m)) :=
      @AlgebraicGeometry.instIsIntegralSpecOfIsDomainCarrier (CommRingCat.of P_m) inferInstance
    have hRedJ : _root_.IsReduced (↑R'' ⧸ J) :=
      hRed_of_etale (AlgebraicGeometry.Spec (CommRingCat.of P_m)) hIntPm (↑R'' ⧸ J)
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_J)) hEt_ψJ_spec
    have hRadJ : J.IsRadical := (Ideal.isRadical_iff_quotient_reduced J).mpr hRedJ
    have hZeroLocus : PrimeSpectrum.zeroLocus (I : Set R'') = PrimeSpectrum.zeroLocus (J : Set R'') := by
      ext v
      let v_spec : AlgebraicGeometry.Spec R'' := v
      have hRangeSnd : Set.range p₂.base = e_Y.base ⁻¹' Set.range ι_D.base :=
        AlgebraicGeometry.Scheme.Pullback.range_snd ι_D e_Y
      have hRangeIso : Set.range p₂.base =
          Set.range (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))).base := by
        rw [he_iso]
        ext q
        constructor
        · rintro ⟨x, rfl⟩
          exact ⟨e_iso.hom.base x, rfl⟩
        · rintro ⟨y, rfl⟩
          refine ⟨e_iso.inv.base y, ?_⟩
          change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))).base
            ((e_iso.inv ≫ e_iso.hom).base y) = _
          rw [e_iso.inv_hom_id]
          rfl
      have h1 : v ∈ PrimeSpectrum.zeroLocus (I : Set R'') ↔
          v ∈ Set.range (PrimeSpectrum.comap (Ideal.Quotient.mk I)) := by
        rw [@range_comap_of_surjective _ _ _ _ (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective,
          Ideal.mk_ker]
      have h2 : v ∈ Set.range (PrimeSpectrum.comap (Ideal.Quotient.mk I)) ↔
          v_spec ∈ Set.range (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))).base :=
        Iff.rfl
      have h3 : v_spec ∈ Set.range (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))).base ↔
          v_spec ∈ {w : AlgebraicGeometry.Spec R'' | ψ'' (MvPolynomial.X j₀) ∈ w.asIdeal} := by
        rw [← hRangeIso, hRangeSnd, hPre]
      have h4 : v_spec ∈ {w : AlgebraicGeometry.Spec R'' | ψ'' (MvPolynomial.X j₀) ∈ w.asIdeal} ↔
          ψ'' (MvPolynomial.X j₀) ∈ v.asIdeal := Iff.rfl
      have h5 : ψ'' (MvPolynomial.X j₀) ∈ v.asIdeal ↔ v ∈ PrimeSpectrum.zeroLocus (J : Set R'') := by
        rw [PrimeSpectrum.mem_zeroLocus, SetLike.coe_subset_coe, Ideal.span_singleton_le_iff_mem]
      exact h1.trans (h2.trans (h3.trans (h4.trans h5)))
    have hRadEqIJ : I.radical = J.radical := PrimeSpectrum.zeroLocus_eq_iff.mp hZeroLocus
    have hIJ : I = J := by
      calc
        I = I.radical := hRadI.radical.symm
        _ = J.radical := hRadEqIJ
        _ = J := hRadJ.radical
    subst hIJ
    refine ⟨CommRingCat.of (↑R'' ⧸ J), u₀, e_D, ψ_J, hEt_eD, hEt_ψJ_spec, hu₀, ?_⟩
    have hCompC : ψ_J.comp MvPolynomial.C = ((Ideal.Quotient.mk J).comp ψ'').comp MvPolynomial.C := by
      ext c
      change Ideal.Quotient.mk J (ψ'' (ι_skip (MvPolynomial.C c))) =
        Ideal.Quotient.mk J (ψ'' (MvPolynomial.C c))
      rw [show ι_skip (MvPolynomial.C c) = MvPolynomial.C c from ι_skip.commutes c]
    have hInvP2 : e_iso.inv ≫ p₂ =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J)) := by
      rw [he_iso, ← Category.assoc, e_iso.inv_hom_id, Category.id_comp]
    calc
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_J) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C)
        = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_J.comp MvPolynomial.C)) := by
            rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J)) ≫
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ'') ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C)) := by
            rw [hCompC, CommRingCat.ofHom_comp, CommRingCat.ofHom_comp,
              AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp, Category.assoc]
      _ = (e_iso.inv ≫ p₂) ≫ (e_Y ≫ Y.hom) := by rw [hInvP2, hComm]
      _ = e_iso.inv ≫ (p₂ ≫ e_Y) ≫ Y.hom := by simp only [Category.assoc]
      _ = e_iso.inv ≫ (p₁ ≫ ι_D) ≫ Y.hom := by
            rw [← CategoryTheory.Limits.pullback.condition]
      _ = e_D ≫ (ι_D ≫ Y.hom) := by simp only [e_D, Category.assoc]
  exact ⟨hClD, hRangeD, hIntD, hSmD⟩

theorem weil_smooth_center_blowup_etale_nc_step (k : Type u) [Field k] [IsAlgClosed k]
    (m b : ℕ) (hb : b + 1 ≤ m)
    (S' : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (Z_total : Set S'.left)
    (hIntS' : AlgebraicGeometry.IsIntegral S'.left)
    (hProjS' : IsProjectiveOverField k S')
    (hSmS' : AlgebraicGeometry.SmoothOfRelativeDimension (m + 1) S'.hom)
    (q : ℕ) (H : Fin q → AlgebraicGeometry.Scheme.{u})
    (ιH : ∀ a : Fin q, H a ⟶ S'.left) (Z_nc : Set S'.left)
    (s : ℕ) (C_comp : Fin s → AlgebraicGeometry.Scheme.{u})
    (ιC : ∀ β : Fin s, C_comp β ⟶ S'.left)
    (hZ_eq : Z_total = (⋃ a : Fin q, Set.range (ιH a).base) ∪ Z_nc)
    (hCenter : IsMaxMultiplicityNcCenter k m b S' q H ιH Z_nc s C_comp ιC) :
    ∃ (S'' : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (Z''_total : Set S''.left) (π : S'' ⟶ S'),
      AlgebraicGeometry.IsIntegral S''.left ∧
      IsProjectiveOverField k S'' ∧
      AlgebraicGeometry.SmoothOfRelativeDimension (m + 1) S''.hom ∧
      IsGenFiniteEtaleAlterationOver k π ∧
      π.left.base ⁻¹' Z_total ⊆ Z''_total ∧
      IsSplitEtaleNcPair k m (b + 1) S'' Z''_total :=
by
  have ⟨hClH, hIntH, hSmH, hPairH, hClosedZnc, hClC, hIntC, _hSmC, hDisjC, _hSubC, hCharts⟩ :=
    hCenter
  rcases Nat.eq_zero_or_pos s with rfl | hs
  · have hIrredS' : IrreducibleSpace ↥S'.left :=
      @AlgebraicGeometry.irreducibleSpace_of_isIntegral S'.left hIntS'
    obtain ⟨x₀⟩ := hIrredS'.toNonempty
    have hTopS' : Nonempty (⊤ : S'.left.Opens) := ⟨⟨x₀, trivial⟩⟩
    have hAltId : IsGenFiniteEtaleAlterationOver k (𝟙 S') := by
      unfold IsGenFiniteEtaleAlterationOver
      rw [CategoryTheory.Over.id_left]
      exact ⟨inferInstance, inferInstance, ⊤, hTopS', inferInstance, inferInstance, inferInstance⟩
    refine ⟨S', Z_total, 𝟙 S', hIntS', hProjS', hSmS', hAltId, ?_, ?_⟩
    · intro x hx
      simpa using hx
    · refine ⟨q, H, ιH, Z_nc, hClH, hIntH, hSmH, hPairH, hClosedZnc, hZ_eq, ?_⟩
      intro x
      obtain ⟨R', _hDomR', v₀, e_S, ψ, α_snc, I_nc,
        hEt_e, hEt_ψ, hv₀, hComm, hInj, hDisj, hVanH, hVanI,
        hPreHEmpty, hPreH, hPreZnc, _hPreCEmpty, hCardOr⟩ := hCharts x
      have hCard : I_nc.card ≤ b + 1 := by
        rcases hCardOr with ⟨_, hle⟩ | ⟨β, _⟩
        · exact hle
        · exact Fin.elim0 β
      exact ⟨R', v₀, e_S, ψ, α_snc, I_nc, hEt_e, hEt_ψ, hv₀, hComm, hInj, hDisj, hCard,
        hVanH, hVanI, hPreHEmpty, hPreH, hPreZnc⟩
  · let C : Set S'.left := ⋃ β : Fin s, Set.range (ιC β).base
    have hTrans :=
      weil_smooth_center_etale_rees_nc_transfer k m b hb S' hIntS' q H ιH Z_nc s hs C_comp ιC
        hCenter
    obtain ⟨hClosedC, hProperC⟩ := hTrans.1
    obtain ⟨hNoethS', M, L, W_cov, h, hCov, hSpan, hCocycle⟩ :=
      weil_smooth_center_proj_cocycle_generators k S' C hProjS' hClosedC hProperC
    letI : TopologicalSpace.NoetherianSpace ↥S'.left := hNoethS'
    obtain ⟨S'', π, hIntS'', hProjS'', hAltπ, hZar⟩ :=
      weil_smooth_center_graph_closure_zariski_blowup k S' hIntS' hProjS' C hClosedC hProperC
        M L W_cov h hCov hSpan hCocycle
    obtain ⟨hNotSubC, hIrredK, hLocalCharts⟩ :=
      hTrans.2 hClosedC M L W_cov h hCov hSpan S'' π hZar
    let K_comb : Fin (q + s) → Set S''.left := fun c =>
      match finSumFinEquiv.symm c with
      | Sum.inl a => π.left.base ⁻¹' Set.range (ιH a).base
      | Sum.inr β => π.left.base ⁻¹' Set.range (ιC β).base
    let Z'_nc : Set S''.left := closure (π.left.base ⁻¹' (Z_nc \ C))
    have hSmS'' : AlgebraicGeometry.SmoothOfRelativeDimension (m + 1) S''.hom := by
      apply (weil_vanishingIdeal_irreducible_etale_coord_divisor k).1 (m + 1) S'' hProjS''
      intro y
      obtain ⟨R'', _hDomR'', w₀, e''_S, ψ'', _α''_snc, _I''_nc,
        hEt_e, hEt_ψ, hw₀, hComm, _⟩ := hLocalCharts y
      exact ⟨R'', w₀, e''_S, ψ'', hEt_e, hEt_ψ, hw₀, hComm⟩
    have hClosedK : ∀ c : Fin (q + s), IsClosed (K_comb c) := by
      intro c
      dsimp only [K_comb]
      rcases finSumFinEquiv.symm c with a | β
      · haveI : AlgebraicGeometry.IsClosedImmersion (ιH a) := hClH a
        exact (ιH a).isClosedEmbedding.isClosed_range.preimage π.left.continuous
      · haveI : AlgebraicGeometry.IsClosedImmersion (ιC β) := hClC β
        exact (ιC β).isClosedEmbedding.isClosed_range.preimage π.left.continuous
    let I_K : Fin (q + s) → S''.left.IdealSheafData := fun c =>
      AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal ⟨K_comb c, hClosedK c⟩
    let H'' : Fin (q + s) → AlgebraicGeometry.Scheme.{u} := fun c => (I_K c).subscheme
    let ιH'' : ∀ c : Fin (q + s), H'' c ⟶ S''.left := fun c => (I_K c).subschemeι
    have hDivProps : ∀ c : Fin (q + s),
        AlgebraicGeometry.IsClosedImmersion (ιH'' c) ∧
        Set.range (ιH'' c).base = K_comb c ∧
        AlgebraicGeometry.IsIntegral (H'' c) ∧
        AlgebraicGeometry.SmoothOfRelativeDimension m (ιH'' c ≫ S''.hom) := by
      intro c
      apply (weil_vanishingIdeal_irreducible_etale_coord_divisor k).2 m S'' hProjS''
        (K_comb c) (hClosedK c) (hIrredK c)
      intro w hwc
      obtain ⟨R'', hDomR'', w₀, e''_S, ψ'', α''_snc, _I''_nc,
        hEt_e, hEt_ψ, hw₀, hComm, _hInj, _hDisj, _hCard, _hVanSnc, _hVanI,
        _hPreEmpty, hPreSnc, _hPreZ⟩ := hLocalCharts w
      exact ⟨R'', hDomR'', w₀, e''_S, ψ'', α''_snc ⟨c, hwc⟩,
        hEt_e, hEt_ψ, hw₀, hComm, hPreSnc c hwc⟩
    have hSurjπ : Function.Surjective π.left.base := by
      haveI : AlgebraicGeometry.Surjective π.left := hAltπ.2.1
      exact π.left.surjective
    have hPreInj : Function.Injective (Set.preimage π.left.base) :=
      Set.preimage_injective.mpr hSurjπ
    have hPairH'' : _root_.Pairwise fun c₁ c₂ : Fin (q + s) =>
        Set.range (ιH'' c₁).base ≠ Set.range (ιH'' c₂).base := by
      intro c₁ c₂ hne heq
      rw [(hDivProps c₁).2.1, (hDivProps c₂).2.1] at heq
      dsimp only [K_comb] at heq
      rcases h1 : finSumFinEquiv.symm c₁ with a₁ | β₁ <;>
        rcases h2 : finSumFinEquiv.symm c₂ with a₂ | β₂ <;>
        rw [h1, h2] at heq
      · have ha_ne : a₁ ≠ a₂ := by
          intro ha_eq
          apply hne
          apply finSumFinEquiv.symm.injective
          rw [h1, h2, ha_eq]
        exact hPairH ha_ne (hPreInj heq)
      · have hEqSet : Set.range (ιH a₁).base = Set.range (ιC β₂).base := hPreInj heq
        apply hNotSubC a₁
        rw [hEqSet]
        exact Set.subset_iUnion (fun β => Set.range (ιC β).base) β₂
      · have hEqSet : Set.range (ιC β₁).base = Set.range (ιH a₂).base := hPreInj heq
        apply hNotSubC a₂
        rw [← hEqSet]
        exact Set.subset_iUnion (fun β => Set.range (ιC β).base) β₁
      · have hβ_ne : β₁ ≠ β₂ := by
          intro hβ_eq
          apply hne
          apply finSumFinEquiv.symm.injective
          rw [h1, h2, hβ_eq]
        have hEqSet : Set.range (ιC β₁).base = Set.range (ιC β₂).base := hPreInj heq
        have hDisj12 : Disjoint (Set.range (ιC β₁).base) (Set.range (ιC β₂).base) := hDisjC hβ_ne
        have hIrredC1 : IrreducibleSpace ↥(C_comp β₁) :=
          @AlgebraicGeometry.irreducibleSpace_of_isIntegral (C_comp β₁) (hIntC β₁)
        obtain ⟨z₀⟩ := hIrredC1.toNonempty
        have hz₀ : (ιC β₁).base z₀ ∈ Set.range (ιC β₁).base := ⟨z₀, rfl⟩
        exact hDisj12.le_bot ⟨hz₀, hEqSet ▸ hz₀⟩
    let Z''_total : Set S''.left := (⋃ c : Fin (q + s), Set.range (ιH'' c).base) ∪ Z'_nc
    refine ⟨S'', Z''_total, π, hIntS'', hProjS'', hSmS'', hAltπ, ?_, ?_⟩
    · intro w hw
      change π.left.base w ∈ Z_total at hw
      rw [hZ_eq] at hw
      rcases hw with hwH | hwZ
      · rcases Set.mem_iUnion.mp hwH with ⟨a, ha⟩
        left
        refine Set.mem_iUnion.mpr ⟨finSumFinEquiv (Sum.inl a), ?_⟩
        rw [(hDivProps (finSumFinEquiv (Sum.inl a))).2.1]
        dsimp only [K_comb]
        rw [Equiv.symm_apply_apply]
        exact ha
      · by_cases hwC : π.left.base w ∈ C
        · rcases Set.mem_iUnion.mp hwC with ⟨β, hβ⟩
          left
          refine Set.mem_iUnion.mpr ⟨finSumFinEquiv (Sum.inr β), ?_⟩
          rw [(hDivProps (finSumFinEquiv (Sum.inr β))).2.1]
          dsimp only [K_comb]
          rw [Equiv.symm_apply_apply]
          exact hβ
        · right
          exact subset_closure ⟨hwZ, hwC⟩
    · refine ⟨q + s, H'', ιH'', Z'_nc,
        fun c => (hDivProps c).1,
        fun c => (hDivProps c).2.2.1,
        fun c => (hDivProps c).2.2.2,
        hPairH'',
        isClosed_closure,
        rfl,
        ?_⟩
      intro w
      obtain ⟨R'', _hDomR'', w₀, e''_S, ψ'', α''_snc, I''_nc,
        hEt_e, hEt_ψ, hw₀, hComm, hInj, hDisj, hCard, hVanSnc, hVanI,
        hPreEmpty, hPreSnc, hPreZ⟩ := hLocalCharts w
      have hMemK : ∀ c : {c : Fin (q + s) // w ∈ Set.range (ιH'' c).base}, w ∈ K_comb c.1 := by
        intro c
        rw [← (hDivProps c.1).2.1]
        exact c.2
      let α_new : {c : Fin (q + s) // w ∈ Set.range (ιH'' c).base} → Fin (m + 1) :=
        fun c => α''_snc ⟨c.1, hMemK c⟩
      refine ⟨R'', w₀, e''_S, ψ'', α_new, I''_nc,
        hEt_e, hEt_ψ, hw₀, hComm, ?_, ?_, hCard, ?_, hVanI, ?_, ?_, hPreZ⟩
      · intro c₁ c₂ hEq
        have hSub := hInj hEq
        exact Subtype.ext (congrArg (fun x => x.1) hSub)
      · intro c j hj
        exact hDisj ⟨c.1, hMemK c⟩ j hj
      · intro c
        exact hVanSnc ⟨c.1, hMemK c⟩
      · intro c hwnot
        rw [(hDivProps c).2.1] at hwnot ⊢
        exact hPreEmpty c hwnot
      · intro c hwc
        have hwc' : w ∈ K_comb c := by rw [← (hDivProps c).2.1]; exact hwc
        rw [(hDivProps c).2.1]
        exact hPreSnc c hwc'

theorem weil_vanishingIdeal_codim_one_etale_roof (k : Type u) [Field k] (m : ℕ)
    (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.LocallyOfFiniteType W.hom]
    (Z_nc : Set W.left) (hClosed : IsClosed Z_nc)
    (y : (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal ⟨Z_nc, hClosed⟩).subscheme)
    (R' : CommRingCat.{u}) (v₀ : AlgebraicGeometry.Spec R')
    (e_W : AlgebraicGeometry.Spec R' ⟶ W.left)
    (ψ : MvPolynomial (Fin (m + 1)) k →+* R')
    (j₀ : Fin (m + 1))
    (hEt_e : AlgebraicGeometry.Etale e_W)
    (hEt_ψ : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)))
    (hv₀ : e_W.base v₀ =
      (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal ⟨Z_nc, hClosed⟩).subschemeι.base y)
    (hComm : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = e_W ≫ W.hom)
    (hPre : e_W.base ⁻¹' Z_nc =
      {v : AlgebraicGeometry.Spec R' | ψ (MvPolynomial.X j₀) ∈ v.asIdeal}) :
    ∃ (R'_Y : CommRingCat.{u}) (w₀ : AlgebraicGeometry.Spec R'_Y)
      (e_Y : AlgebraicGeometry.Spec R'_Y ⟶
        (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal ⟨Z_nc, hClosed⟩).subscheme)
      (ψ_Y : MvPolynomial (Fin m) k →+* R'_Y),
      AlgebraicGeometry.Etale e_Y ∧
      AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_Y)) ∧
      e_Y.base w₀ = y ∧
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_Y) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) =
        e_Y ≫ (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal ⟨Z_nc, hClosed⟩).subschemeι ≫
          W.hom) :=
by
  
  have hLocalEtaleRed :
      ∀ (A B₀ : Type u) [CommRing A] [_root_.IsReduced A] [IsNoetherianRing A]
        [CommRing B₀] [Algebra A B₀] [Algebra.Etale A B₀],
        _root_.IsReduced B₀ := by
    intro A B₀ _ _ _ _ _ _
    have hFieldFiber :
        ∀ (F₀ : Type u) [Field F₀] [Algebra A F₀] (x : B₀),
          IsNilpotent x → (x ⊗ₜ[A] (1 : F₀) : TensorProduct A B₀ F₀) = 0 := by
      intro F₀ _ _ x hx
      have _ : Algebra.Etale F₀ (TensorProduct A F₀ B₀) := Algebra.Etale.baseChange A B₀ F₀
      have _ : _root_.IsReduced (TensorProduct A F₀ B₀) :=
        Algebra.FormallyUnramified.isReduced_of_field F₀ (TensorProduct A F₀ B₀)
      have hNil : IsNilpotent ((1 : F₀) ⊗ₜ[A] x : TensorProduct A F₀ B₀) := by
        change IsNilpotent ((Algebra.TensorProduct.includeRight : B₀ →ₐ[A] TensorProduct A F₀ B₀) x)
        exact hx.map _
      have hZero : ((1 : F₀) ⊗ₜ[A] x : TensorProduct A F₀ B₀) = 0 := hNil.eq_zero
      simpa using congrArg (TensorProduct.comm A F₀ B₀) hZero
    refine ⟨fun b₀ hb₀ => ?_⟩
    let M_min : Set (Ideal A) := (⊥ : Ideal A).minimalPrimes
    let _ : Fintype ↥M_min := (Ideal.finite_minimalPrimes_of_isNoetherianRing A ⊥).fintype
    let _ : DecidableEq ↥M_min := Classical.decEq ↥M_min
    have _ : ∀ p : ↥M_min, IsDomain (A ⧸ p.1) :=
      fun p => (Ideal.Quotient.isDomain_iff_prime p.1).mpr p.2.1.1
    let K : ↥M_min → Type u := fun p => FractionRing (A ⧸ p.1)
    let δ : A →ₗ[A] (∀ p : ↥M_min, K p) :=
      LinearMap.pi fun p => Algebra.linearMap A (K p)
    have hInj_δ : Function.Injective δ := by
      rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
      intro a ha
      have ha_min : ∀ p : ↥M_min, a ∈ p.1 := by
        intro p
        have hap : algebraMap A (K p) a = 0 := congrFun ha p
        rw [IsScalarTower.algebraMap_apply A (A ⧸ p.1) (K p)] at hap
        have hmk0 : Ideal.Quotient.mk p.1 a = 0 :=
          (IsFractionRing.injective (A ⧸ p.1) (K p)).eq_iff.mp (hap.trans (map_zero _).symm)
        exact Ideal.Quotient.eq_zero_iff_mem.mp hmk0
      have ha_nil : a ∈ nilradical A := by
        rw [nilradical_eq_sInf A, Ideal.mem_sInf]
        intro q hq
        have _ : q.IsPrime := hq
        obtain ⟨p₀, hp₀_min, hp₀_le⟩ :=
          @Ideal.exists_minimalPrimes_le A _ ⊥ q hq bot_le
        exact hp₀_le (ha_min ⟨p₀, hp₀_min⟩)
      exact (mem_nilradical.mp ha_nil).eq_zero
    let e_pi : TensorProduct A B₀ (∀ p : ↥M_min, K p) ≃ₗ[A] (∀ p : ↥M_min, TensorProduct A B₀ (K p)) :=
      TensorProduct.piRight A A B₀ K
    have hPiZero : e_pi (b₀ ⊗ₜ[A] δ 1) = 0 := by
      ext p
      have hEval : e_pi (b₀ ⊗ₜ[A] δ 1) p = b₀ ⊗ₜ[A] (δ 1 p) := rfl
      rw [hEval]
      change b₀ ⊗ₜ[A] (algebraMap A (K p) 1) = 0
      rw [map_one]
      exact hFieldFiber (K p) b₀ hb₀
    have hTmulδ : (b₀ ⊗ₜ[A] δ 1 : TensorProduct A B₀ (∀ p : ↥M_min, K p)) = 0 :=
      e_pi.injective (hPiZero.trans (map_zero e_pi).symm)
    have _ : Module.Flat A B₀ := Algebra.Smooth.flat A B₀
    have hInj_lTensor : Function.Injective (LinearMap.lTensor B₀ δ) :=
      (Module.Flat.iff_lTensor_preserves_injective_linearMapₛ (R := A) (M := B₀)).mp
        inferInstance δ hInj_δ
    have hTmul1 : (b₀ ⊗ₜ[A] (1 : A) : TensorProduct A B₀ A) = 0 := by
      apply hInj_lTensor
      rw [LinearMap.lTensor_tmul, map_zero]
      exact hTmulδ
    have hRid := congrArg (TensorProduct.rid A B₀) hTmul1
    simpa [TensorProduct.rid_tmul] using hRid
  have hRingHomEtaleRed :
      ∀ {A B₀ : Type u} [CommRing A] [_root_.IsReduced A] [IsNoetherianRing A]
        [CommRing B₀] (φ : A →+* B₀), φ.Etale → _root_.IsReduced B₀ := by
    intro A B₀ _ _ _ _ φ hφ
    let _ : Algebra A B₀ := φ.toAlgebra
    have _ : Algebra.Etale A B₀ := RingHom.etale_algebraMap.mp hφ
    exact hLocalEtaleRed A B₀
  
  have hSpecEtaleRed :
      ∀ (E : AlgebraicGeometry.Scheme.{u})
        [AlgebraicGeometry.IsReduced E] [AlgebraicGeometry.IsLocallyNoetherian E]
        (B : CommRingCat.{u}) (f : AlgebraicGeometry.Spec B ⟶ E),
        AlgebraicGeometry.Etale f → _root_.IsReduced B := by
    intro E _ _ B f hEt
    refine ⟨fun c hc => ?_⟩
    let X_B : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec B
    let s : ↑(X_B.presheaf.obj (Opposite.op ⊤)) := (AlgebraicGeometry.Scheme.ΓSpecIso B).inv.hom c
    have hs : IsNilpotent s := hc.map (AlgebraicGeometry.Scheme.ΓSpecIso B).inv.hom
    have hLocalZero : ∀ z : ↥X_B, ∃ V_z : X_B.Opens,
        z ∈ V_z ∧ (X_B.presheaf.map (CategoryTheory.homOfLE (le_top : V_z ≤ ⊤)).op).hom s = 0 := by
      intro z
      obtain ⟨U_z, hAffU, hzU, _⟩ :=
        (TopologicalSpace.Opens.isBasis_iff_nbhd.mp E.isBasis_affineOpens)
          (show f.base z ∈ (⊤ : E.Opens) from trivial)
      obtain ⟨V_z, hAffV, hzV, hle_z⟩ :=
        (TopologicalSpace.Opens.isBasis_iff_nbhd.mp X_B.isBasis_affineOpens)
          (show z ∈ f ⁻¹ᵁ U_z from hzU)
      let A_z := ↑(E.presheaf.obj (Opposite.op U_z))
      let B_z := ↑(X_B.presheaf.obj (Opposite.op V_z))
      have _ : _root_.IsReduced A_z := @AlgebraicGeometry.IsReduced.component_reduced E _ U_z
      have _ : IsNoetherianRing A_z :=
        @AlgebraicGeometry.IsLocallyNoetherian.component_noetherian E _ ⟨U_z, hAffU⟩
      have hEt_app : RingHom.Etale (f.appLE U_z V_z hle_z).hom :=
        (AlgebraicGeometry.HasRingHomProperty.iff_appLE (P := @AlgebraicGeometry.Etale)).mp
          hEt ⟨U_z, hAffU⟩ ⟨V_z, hAffV⟩ hle_z
      have _ : _root_.IsReduced B_z := hRingHomEtaleRed (f.appLE U_z V_z hle_z).hom hEt_app
      let res_z := (X_B.presheaf.map (CategoryTheory.homOfLE (le_top : V_z ≤ ⊤)).op).hom
      exact ⟨V_z, hzV, (hs.map res_z).eq_zero⟩
    choose V_z hzV hsV using hLocalZero
    have hCov : (⊤ : X_B.Opens) ≤ ⨆ z : ↥X_B, V_z z :=
      fun z _ => TopologicalSpace.Opens.mem_iSup.mpr ⟨z, hzV z⟩
    have hs0 : s = 0 :=
      TopCat.Sheaf.eq_of_locally_eq' X_B.sheaf V_z ⊤ (fun z => CategoryTheory.homOfLE le_top) hCov
        s 0 (fun z => by
          change (X_B.presheaf.map (CategoryTheory.homOfLE (le_top : V_z z ≤ ⊤)).op).hom s =
            (X_B.presheaf.map (CategoryTheory.homOfLE (le_top : V_z z ≤ ⊤)).op).hom 0
          rw [map_zero]
          exact hsV z)
    have hc0 := congrArg (AlgebraicGeometry.Scheme.ΓSpecIso B).hom.hom hs0
    rw [map_zero] at hc0
    simpa [s, ← CommRingCat.comp_apply] using hc0
  
  let Z_cl : TopologicalSpace.Closeds ↥W.left := ⟨Z_nc, hClosed⟩
  let ℐ : W.left.IdealSheafData := AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal Z_cl
  have hRange_ι : Set.range ℐ.subschemeι.base = Z_nc := by
    rw [AlgebraicGeometry.Scheme.IdealSheafData.range_subschemeι,
      AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal]
    rfl
  have hSupp_ℐ : ℐ.support = Z_cl := by
    apply SetLike.coe_injective
    exact AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal Z_cl
  have hRad_ℐ : ℐ.radical = ℐ := by
    rw [← AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal_support, hSupp_ℐ]
  have hRedY : AlgebraicGeometry.IsReduced ℐ.subscheme := by
    have hChartRed : ∀ U : ↥W.left.affineOpens,
        AlgebraicGeometry.IsReduced
          (AlgebraicGeometry.Spec (CommRingCat.of
            (↑(W.left.presheaf.obj (Opposite.op U.1)) ⧸ ℐ.ideal U))) := by
      intro U
      have hEqRad : (ℐ.ideal U).radical = ℐ.ideal U := by
        rw [← AlgebraicGeometry.Scheme.IdealSheafData.radical_ideal, hRad_ℐ]
      have hIsRadU : (ℐ.ideal U).IsRadical := by
        rw [← hEqRad]
        exact Ideal.radical_isRadical (ℐ.ideal U)
      have _ : _root_.IsReduced (↑(W.left.presheaf.obj (Opposite.op U.1)) ⧸ ℐ.ideal U) :=
        (Ideal.isRadical_iff_quotient_reduced (ℐ.ideal U)).mp hIsRadU
      infer_instance
    exact @AlgebraicGeometry.IsReduced.of_openCover ℐ.subscheme ℐ.subschemeCover.openCover hChartRed
  have _ : AlgebraicGeometry.IsLocallyNoetherian W.left :=
    AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian W.hom
  have hNoethY : AlgebraicGeometry.IsLocallyNoetherian ℐ.subscheme :=
    AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian ℐ.subschemeι
  have _ : AlgebraicGeometry.Etale e_W := hEt_e
  let P := CategoryTheory.Limits.pullback ℐ.subschemeι e_W
  let fst : P ⟶ ℐ.subscheme := CategoryTheory.Limits.pullback.fst ℐ.subschemeι e_W
  let snd : P ⟶ AlgebraicGeometry.Spec R' := CategoryTheory.Limits.pullback.snd ℐ.subschemeι e_W
  have hCl_snd : AlgebraicGeometry.IsClosedImmersion snd := inferInstance
  have _ : AlgebraicGeometry.Etale fst := inferInstance
  obtain ⟨I, e_iso, he_snd⟩ := AlgebraicGeometry.IsClosedImmersion.Spec_iff.mp hCl_snd
  let e_Y : AlgebraicGeometry.Spec (CommRingCat.of (↥R' ⧸ I)) ⟶ ℐ.subscheme := e_iso.inv ≫ fst
  have hEt_eY : AlgebraicGeometry.Etale e_Y := inferInstance
  obtain ⟨p₀, hp₀_fst, _⟩ :=
    AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y v₀ hv₀.symm
  let w₀ : AlgebraicGeometry.Spec (CommRingCat.of (↥R' ⧸ I)) := e_iso.hom.base p₀
  have hw₀ : e_Y.base w₀ = y := by
    change (e_iso.hom ≫ e_iso.inv ≫ fst).base p₀ = y
    rw [e_iso.hom_inv_id_assoc]
    exact hp₀_fst
  have hComm_I :
      e_Y ≫ ℐ.subschemeι =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) ≫ e_W := by
    dsimp [e_Y, fst]
    rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition]
    have he_snd' : CategoryTheory.Limits.pullback.snd ℐ.subschemeι e_W =
        e_iso.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) := he_snd
    rw [reassoc_of% he_snd', e_iso.inv_hom_id_assoc]
  have hZero_I :
      (PrimeSpectrum.zeroLocus (I : Set R') : Set (AlgebraicGeometry.Spec R')) =
        e_W.base ⁻¹' Z_nc := by
    have hRange_snd : Set.range ⇑snd = e_W.base ⁻¹' Z_nc := by
      rw [AlgebraicGeometry.Scheme.Pullback.range_snd, hRange_ι]
    have hSurj_iso : Function.Surjective ⇑e_iso.hom :=
      Function.RightInverse.surjective (g := ⇑e_iso.inv) fun z => by
        change (e_iso.inv ≫ e_iso.hom) z = z
        rw [e_iso.inv_hom_id]
        rfl
    have hZero_mk :
        (PrimeSpectrum.zeroLocus (I : Set R') : Set (PrimeSpectrum ↥R')) =
          Set.range (PrimeSpectrum.comap (Ideal.Quotient.mk I)) := by
      rw [range_comap_of_surjective (↥R' ⧸ I) (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective,
        Ideal.mk_ker]
    change (PrimeSpectrum.zeroLocus (I : Set R') : Set (PrimeSpectrum ↥R')) = e_W.base ⁻¹' Z_nc
    rw [← hRange_snd, hZero_mk]
    ext v
    simp only [Set.mem_range]
    constructor
    · rintro ⟨w, rfl⟩
      obtain ⟨p, rfl⟩ := hSurj_iso w
      refine ⟨p, ?_⟩
      rw [he_snd]
      change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))) (e_iso.hom p) = _
      exact AlgebraicGeometry.Spec.map_apply (CommRingCat.ofHom (Ideal.Quotient.mk I)) (e_iso.hom p)
    · rintro ⟨p, rfl⟩
      refine ⟨e_iso.hom p, ?_⟩
      rw [he_snd]
      change _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))) (e_iso.hom p)
      exact (AlgebraicGeometry.Spec.map_apply (CommRingCat.ofHom (Ideal.Quotient.mk I)) (e_iso.hom p)).symm
  have hRed_quotI : _root_.IsReduced (↥R' ⧸ I) :=
    hSpecEtaleRed ℐ.subscheme (CommRingCat.of (↥R' ⧸ I)) e_Y hEt_eY
  have hRad_I : I.IsRadical := (Ideal.isRadical_iff_quotient_reduced I).mpr hRed_quotI
  
  let J₀ : Ideal (MvPolynomial (Fin (m + 1)) k) := Ideal.span {MvPolynomial.X j₀}
  let e_compl : Fin m ≃ {j : Fin (m + 1) // j ≠ j₀} :=
    Equiv.ofBijective (fun i => ⟨j₀.succAbove i, Fin.succAbove_ne j₀ i⟩)
      ⟨fun i₁ i₂ h => Fin.succAbove_right_injective (Subtype.mk.inj h),
       fun ⟨j, hj⟩ => let ⟨i, hi⟩ := Fin.exists_succAbove_eq hj; ⟨i, Subtype.ext hi⟩⟩
  let π_kill : MvPolynomial (Fin (m + 1)) k →ₐ[k] MvPolynomial (Fin m) k :=
    MvPolynomial.aeval fun j =>
      if hj : j ≠ j₀ then MvPolynomial.X (e_compl.symm ⟨j, hj⟩) else 0
  let ι_ren : MvPolynomial (Fin m) k →ₐ[k] MvPolynomial (Fin (m + 1)) k :=
    MvPolynomial.rename j₀.succAbove
  have hCompId : π_kill.comp ι_ren = AlgHom.id k (MvPolynomial (Fin m) k) := by
    apply MvPolynomial.algHom_ext
    intro i
    dsimp only [AlgHom.comp_apply, AlgHom.id_apply, ι_ren, π_kill]
    rw [MvPolynomial.rename_X, MvPolynomial.aeval_X,
      dite_cond_eq_true (eq_true (Fin.succAbove_ne j₀ i))]
    have he : (⟨j₀.succAbove i, Fin.succAbove_ne j₀ i⟩ : {j : Fin (m + 1) // j ≠ j₀}) = e_compl i := rfl
    rw [he, e_compl.symm_apply_apply]
  have hModJ₀ :
      (Ideal.Quotient.mkₐ k J₀).comp (ι_ren.comp π_kill) = Ideal.Quotient.mkₐ k J₀ := by
    apply MvPolynomial.algHom_ext
    intro j
    dsimp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk, ι_ren, π_kill]
    rw [MvPolynomial.aeval_X]
    by_cases hj : j ≠ j₀
    · rw [dite_cond_eq_true (eq_true hj), MvPolynomial.rename_X]
      have hj_eq : j₀.succAbove (e_compl.symm ⟨j, hj⟩) = j :=
        congrArg Subtype.val (e_compl.apply_symm_apply ⟨j, hj⟩)
      rw [hj_eq]
    · simp only [hj, ↓reduceDIte, map_zero]
      have hj0 : j = j₀ := not_not.mp hj
      subst hj0
      symm
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
  have hJ₀_le_ker : J₀ ≤ RingHom.ker π_kill.toRingHom := by
    rw [Ideal.span_singleton_le_iff_mem]
    change π_kill (MvPolynomial.X j₀) = 0
    dsimp only [π_kill]
    rw [MvPolynomial.aeval_X]
    simp only [ne_eq, not_true_eq_false, ↓reduceDIte]
  let Φ_hom : (MvPolynomial (Fin (m + 1)) k ⧸ J₀) →+* MvPolynomial (Fin m) k :=
    Ideal.Quotient.lift J₀ π_kill.toRingHom hJ₀_le_ker
  let Φ_inv : MvPolynomial (Fin m) k →+* (MvPolynomial (Fin (m + 1)) k ⧸ J₀) :=
    (Ideal.Quotient.mk J₀).comp ι_ren.toRingHom
  have hLeftInv_Φ : Function.LeftInverse Φ_inv Φ_hom := by
    intro x
    obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective x
    have hEqMk := AlgHom.congr_fun hModJ₀ f
    simpa [Φ_inv, Φ_hom, Ideal.Quotient.mkₐ_eq_mk] using hEqMk
  have hRightInv_Φ : Function.RightInverse Φ_inv Φ_hom := by
    intro g
    have hEqId := AlgHom.congr_fun hCompId g
    simpa [Φ_inv, Φ_hom] using hEqId
  let Φ_ring : (MvPolynomial (Fin (m + 1)) k ⧸ J₀) ≃+* MvPolynomial (Fin m) k :=
    { Φ_hom with
      invFun := Φ_inv
      left_inv := hLeftInv_Φ
      right_inv := hRightInv_Φ }
  have hΦ_symm_C :
      ∀ c : k, Φ_ring.symm (MvPolynomial.C c) = Ideal.Quotient.mk J₀ (MvPolynomial.C c) := by
    intro c
    change Ideal.Quotient.mk J₀ (ι_ren (MvPolynomial.C c)) = Ideal.Quotient.mk J₀ (MvPolynomial.C c)
    dsimp only [ι_ren]
    rw [MvPolynomial.rename_C]
  let J_nc : Ideal R' := Ideal.map ψ J₀
  have hZero_J :
      (PrimeSpectrum.zeroLocus (J_nc : Set R') : Set (AlgebraicGeometry.Spec R')) =
        {v : AlgebraicGeometry.Spec R' | ψ (MvPolynomial.X j₀) ∈ v.asIdeal} := by
    ext v
    change J_nc ≤ v.asIdeal ↔ ψ (MvPolynomial.X j₀) ∈ v.asIdeal
    dsimp [J_nc, J₀]
    rw [Ideal.map_span, Set.image_singleton, Ideal.span_singleton_le_iff_mem]
  let ψ_bar : (MvPolynomial (Fin (m + 1)) k ⧸ J₀) →+* (↥R' ⧸ J_nc) :=
    Ideal.quotientMap J_nc ψ Ideal.le_comap_map
  let ψ_Y : MvPolynomial (Fin m) k →+* (↥R' ⧸ J_nc) :=
    ψ_bar.comp Φ_ring.symm.toRingHom
  have hAlg_ψY : ψ_Y.comp MvPolynomial.C = (Ideal.Quotient.mk J_nc).comp (ψ.comp MvPolynomial.C) := by
    ext c
    dsimp only [RingHom.comp_apply, ψ_Y, ψ_bar]
    change Ideal.quotientMap J_nc ψ Ideal.le_comap_map (Φ_ring.symm (MvPolynomial.C c)) = _
    rw [hΦ_symm_C c, Ideal.quotientMap_mk]
  have hEtaleOfFactor :
      ∀ {R₀ S₀ T₀ : Type u} [CommRing R₀] [CommRing S₀] [CommRing T₀]
        (f : R₀ →+* S₀) (h : R₀ →+* T₀) (e : S₀ ≃ T₀),
        (∀ x y : S₀, e (x * y) = e x * e y) →
        (∀ x y : S₀, e (x + y) = e x + e y) →
        (∀ r : R₀, e (f r) = h r) →
        f.Etale → h.Etale := by
    intro R₀ S₀ T₀ _ _ _ f h e hmul hadd hcomp hf
    let e_ring : S₀ ≃+* T₀ := { e with map_mul' := hmul, map_add' := hadd }
    have hEq : e_ring.toRingHom.comp f = h := by
      ext r
      exact hcomp r
    rw [← hEq]
    exact RingHom.Etale.respectsIso.left f e_ring hf
  have hQuotMapEtale :
      ∀ (A₀ : Type u) [CommRing A₀] [Algebra (MvPolynomial (Fin (m + 1)) k) A₀]
        [Algebra.Etale (MvPolynomial (Fin (m + 1)) k) A₀],
        RingHom.Etale (Ideal.quotientMap
          (Ideal.map (algebraMap (MvPolynomial (Fin (m + 1)) k) A₀) J₀)
          (algebraMap (MvPolynomial (Fin (m + 1)) k) A₀) Ideal.le_comap_map) := by
    intro A₀ _ _ _
    have _ : Algebra.Etale (MvPolynomial (Fin (m + 1)) k ⧸ J₀)
        (TensorProduct (MvPolynomial (Fin (m + 1)) k)
          (MvPolynomial (Fin (m + 1)) k ⧸ J₀) A₀) :=
      Algebra.Etale.baseChange (MvPolynomial (Fin (m + 1)) k) A₀
        (MvPolynomial (Fin (m + 1)) k ⧸ J₀)
    have hAlgEt :
        (algebraMap (MvPolynomial (Fin (m + 1)) k ⧸ J₀)
          (TensorProduct (MvPolynomial (Fin (m + 1)) k)
            (MvPolynomial (Fin (m + 1)) k ⧸ J₀) A₀)).Etale :=
      RingHom.etale_algebraMap.mpr inferInstance
    let e_raw :=
      ((Algebra.TensorProduct.quotIdealMapEquivTensorQuot A₀ J₀).toRingEquiv).trans
        (Algebra.TensorProduct.comm (MvPolynomial (Fin (m + 1)) k) A₀
          (MvPolynomial (Fin (m + 1)) k ⧸ J₀)).toRingEquiv
    refine hEtaleOfFactor
      (algebraMap (MvPolynomial (Fin (m + 1)) k ⧸ J₀)
        (TensorProduct (MvPolynomial (Fin (m + 1)) k)
          (MvPolynomial (Fin (m + 1)) k ⧸ J₀) A₀))
      (Ideal.quotientMap
        (Ideal.map (algebraMap (MvPolynomial (Fin (m + 1)) k) A₀) J₀)
        (algebraMap (MvPolynomial (Fin (m + 1)) k) A₀) Ideal.le_comap_map)
      e_raw.symm.toEquiv
      (fun x y => map_mul e_raw.symm x y)
      (fun x y => map_add e_raw.symm x y)
      (fun x => ?_)
      hAlgEt
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
    apply e_raw.injective
    change e_raw (e_raw.symm ((algebraMap (MvPolynomial (Fin (m + 1)) k ⧸ J₀)
        (TensorProduct (MvPolynomial (Fin (m + 1)) k)
          (MvPolynomial (Fin (m + 1)) k ⧸ J₀) A₀)) (Ideal.Quotient.mk J₀ p))) =
      e_raw (Ideal.quotientMap
        (Ideal.map (algebraMap (MvPolynomial (Fin (m + 1)) k) A₀) J₀)
        (algebraMap (MvPolynomial (Fin (m + 1)) k) A₀) Ideal.le_comap_map
        (Ideal.Quotient.mk J₀ p))
    rw [e_raw.apply_symm_apply, Ideal.quotientMap_mk]
    symm
    dsimp only [e_raw, RingEquiv.trans_apply]
    change (Algebra.TensorProduct.comm (MvPolynomial (Fin (m + 1)) k) A₀
        (MvPolynomial (Fin (m + 1)) k ⧸ J₀))
      ((Algebra.TensorProduct.quotIdealMapEquivTensorQuot A₀ J₀)
        (Ideal.Quotient.mk (Ideal.map (algebraMap (MvPolynomial (Fin (m + 1)) k) A₀) J₀)
          (algebraMap (MvPolynomial (Fin (m + 1)) k) A₀ p))) = _
    rw [Algebra.TensorProduct.quotIdealMapEquivTensorQuot_mk]
    have h_smul :
        (algebraMap (MvPolynomial (Fin (m + 1)) k) A₀ p) ⊗ₜ[MvPolynomial (Fin (m + 1)) k]
          (1 : MvPolynomial (Fin (m + 1)) k ⧸ J₀) =
        (1 : A₀) ⊗ₜ[MvPolynomial (Fin (m + 1)) k] (Ideal.Quotient.mk J₀ p) := by
      have hpA : algebraMap (MvPolynomial (Fin (m + 1)) k) A₀ p = p • (1 : A₀) := by
        rw [Algebra.smul_def, mul_one]
      have hpQ : p • (1 : MvPolynomial (Fin (m + 1)) k ⧸ J₀) = Ideal.Quotient.mk J₀ p := by
        change Ideal.Quotient.mk J₀ p * 1 = Ideal.Quotient.mk J₀ p
        exact mul_one _
      rw [hpA, TensorProduct.smul_tmul, hpQ]
    rw [h_smul]
    rfl
  have hEt_ψ_ring : ψ.Etale :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hEt_ψ
  have hEt_ψbar : ψ_bar.Etale := by
    let _ : Algebra (MvPolynomial (Fin (m + 1)) k) ↥R' := ψ.toAlgebra
    have _ : Algebra.Etale (MvPolynomial (Fin (m + 1)) k) ↥R' :=
      RingHom.etale_algebraMap.mp hEt_ψ_ring
    exact hQuotMapEtale ↥R'
  have hEt_ψY_ring : ψ_Y.Etale :=
    RingHom.Etale.respectsIso.right ψ_bar Φ_ring.symm hEt_ψbar
  have hEt_ψY : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_Y)) :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hEt_ψY_ring
  have _ : _root_.IsReduced (MvPolynomial (Fin m) k) := by
    refine ⟨fun p ⟨n, hn⟩ => ?_⟩
    induction n with
    | zero =>
      rw [pow_zero] at hn
      exact absurd hn.symm zero_ne_one
    | succ n ih =>
      rw [pow_succ] at hn
      rcases mul_eq_zero.mp hn with h1 | h2
      · exact ih h1
      · exact h2
  have hRed_quotJ : _root_.IsReduced (↥R' ⧸ J_nc) :=
    hRingHomEtaleRed ψ_Y hEt_ψY_ring
  have hRad_J : J_nc.IsRadical := (Ideal.isRadical_iff_quotient_reduced J_nc).mpr hRed_quotJ
  
  have hZeroEq : PrimeSpectrum.zeroLocus (I : Set R') = PrimeSpectrum.zeroLocus (J_nc : Set R') :=
    hZero_I.trans (hPre.trans hZero_J.symm)
  have hIJ : I = J_nc := by
    have hRadEq : I.radical = J_nc.radical :=
      (@PrimeSpectrum.zeroLocus_eq_iff ↥R' _ I J_nc).mp hZeroEq
    rwa [hRad_I.radical, hRad_J.radical] at hRadEq
  subst hIJ
  refine ⟨CommRingCat.of (↥R' ⧸ J_nc), w₀, e_Y, ψ_Y, hEt_eY, hEt_ψY, hw₀, ?_⟩
  calc
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_Y) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C)
        = AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom MvPolynomial.C ≫ CommRingCat.ofHom ψ_Y) :=
          (AlgebraicGeometry.Spec.map_comp _ _).symm
    _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_Y.comp MvPolynomial.C)) := by
          rw [← CommRingCat.ofHom_comp]
    _ = AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk J_nc).comp (ψ.comp MvPolynomial.C))) := by
          rw [hAlg_ψY]
    _ = AlgebraicGeometry.Spec.map
          ((CommRingCat.ofHom MvPolynomial.C ≫ CommRingCat.ofHom ψ) ≫
            CommRingCat.ofHom (Ideal.Quotient.mk J_nc)) := by
          rw [CommRingCat.ofHom_comp, CommRingCat.ofHom_comp]
    _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J_nc)) ≫
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C)) := by
          rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp]
    _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J_nc)) ≫ e_W ≫ W.hom := by
          rw [hComm]
    _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J_nc)) ≫ e_W) ≫ W.hom := by
          rw [CategoryTheory.Category.assoc]
    _ = (e_Y ≫ ℐ.subschemeι) ≫ W.hom := by
          rw [← hComm_I]
    _ = e_Y ≫ ℐ.subschemeι ≫ W.hom := by
          rw [CategoryTheory.Category.assoc]

theorem weil_projective_smooth_locally_domain_components (k : Type u) [Field k] (d : ℕ)
    (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hProjY : IsProjectiveOverField k Y)
    (hSmY : AlgebraicGeometry.SmoothOfRelativeDimension d Y.hom)
    (hLocalDom : ∀ y : Y.left, ∃ U : Y.left.Opens,
      AlgebraicGeometry.IsAffineOpen U ∧ y ∈ U ∧
      IsDomain ↑(Y.left.presheaf.obj (Opposite.op U))) :
    ∃ (t : ℕ) (F : Fin t → AlgebraicGeometry.Scheme.{u})
      (j_F : ∀ γ : Fin t, F γ ⟶ Y.left),
      (∀ γ : Fin t, AlgebraicGeometry.IsClosedImmersion (j_F γ)) ∧
      (∀ γ : Fin t, AlgebraicGeometry.IsIntegral (F γ)) ∧
      (∀ γ : Fin t, AlgebraicGeometry.SmoothOfRelativeDimension d (j_F γ ≫ Y.hom)) ∧
      (_root_.Pairwise fun γ₁ γ₂ : Fin t =>
        Disjoint (Set.range (j_F γ₁).base) (Set.range (j_F γ₂).base)) ∧
      (⋃ γ : Fin t, Set.range (j_F γ).base) = Set.univ :=
by
  obtain ⟨M, ι_proj, hCl_proj⟩ := hProjY
  have : AlgebraicGeometry.IsClosedImmersion ι_proj.left := hCl_proj
  have hNoethY : TopologicalSpace.NoetherianSpace ↥Y.left := by
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k
    let : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have : IsScalarTower k ↥(𝒜 0) (MvPolynomial (Fin (M + 1)) k) :=
      ⟨fun c x p => smul_mul_assoc c (x : MvPolynomial (Fin (M + 1)) k) p⟩
    have : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (M + 1)) k) :=
      Algebra.FiniteType.of_restrictScalars_finiteType k ↥(𝒜 0) (MvPolynomial (Fin (M + 1)) k)
    have hSurj : Function.Surjective (algebraMap k ↥(𝒜 0)) := by
      intro x
      have hx : x.1 ∈ MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k 0 := x.2
      rw [MvPolynomial.homogeneousSubmodule_zero, Submodule.mem_one] at hx
      rcases hx with ⟨c, hc⟩
      exact ⟨c, Subtype.ext hc⟩
    have : IsNoetherianRing ↥(𝒜 0) :=
      isNoetherianRing_of_surjective k ↥(𝒜 0) (algebraMap k ↥(𝒜 0)) hSurj
    have hLFT_proj : AlgebraicGeometry.LocallyOfFiniteType (AlgebraicGeometry.Proj.toSpecZero 𝒜) :=
      @AlgebraicGeometry.Proj.instLocallyOfFiniteTypeToSpecZeroOfFiniteTypeSubtypeMemOfNatNat
        _ _ _ _ _ 𝒜 _ _
    have : CompactSpace ↥(AlgebraicGeometry.Proj 𝒜) :=
      AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace
        (AlgebraicGeometry.Proj.toSpecZero 𝒜)
    have : AlgebraicGeometry.IsLocallyNoetherian (AlgebraicGeometry.Proj 𝒜) :=
      AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian
        (AlgebraicGeometry.Proj.toSpecZero 𝒜)
    have : AlgebraicGeometry.IsNoetherian (AlgebraicGeometry.Proj 𝒜) := {}
    have : TopologicalSpace.NoetherianSpace ↥(weilProjectiveSpaceOver k M).left :=
      @AlgebraicGeometry.IsNoetherian.noetherianSpace (AlgebraicGeometry.Proj 𝒜) _
    exact ι_proj.left.isClosedEmbedding.toIsEmbedding.toIsInducing.noetherianSpace
  have hFinComp : (irreducibleComponents ↥Y.left).Finite :=
    TopologicalSpace.NoetherianSpace.finite_irreducibleComponents
  have : Finite ↥(irreducibleComponents ↥Y.left) := hFinComp.to_subtype
  obtain ⟨t, ⟨e_inv⟩⟩ := Finite.exists_equiv_fin ↥(irreducibleComponents ↥Y.left)
  let e_comp : Fin t ≃ ↥(irreducibleComponents ↥Y.left) := e_inv.symm
  let F_set : Fin t → Set Y.left := fun γ => (e_comp γ).1
  have hMax : ∀ γ : Fin t, Maximal (fun x : Set Y.left => IsClosed x ∧ IsIrreducible x) (F_set γ) :=
    fun γ => (Set.ext_iff.mp (irreducibleComponents_eq_maximals_closed ↥Y.left) (F_set γ)).mp
      (e_comp γ).2
  have hClosedF : ∀ γ : Fin t, IsClosed (F_set γ) := fun γ => (hMax γ).prop.1
  have hIrredF : ∀ γ : Fin t, IsIrreducible (F_set γ) := fun γ => (hMax γ).prop.2
  have hIncomp : _root_.Pairwise fun α β : Fin t => ¬ F_set α ⊆ F_set β := by
    intro α β hne hSub
    have hEq : F_set α = F_set β := (hMax α).eq_of_le (hMax β).prop hSub
    exact hne (e_comp.injective (Subtype.ext hEq))
  have hCovF : (⋃ γ : Fin t, F_set γ) = Set.univ := by
    apply Set.Subset.antisymm (Set.subset_univ _)
    intro y _
    let c_y : ↥(irreducibleComponents ↥Y.left) :=
      ⟨irreducibleComponent y, irreducibleComponent_mem_irreducibleComponents y⟩
    refine Set.mem_iUnion.mpr ⟨e_inv c_y, ?_⟩
    have hEq : F_set (e_inv c_y) = irreducibleComponent y :=
      congrArg Subtype.val (e_inv.symm_apply_apply c_y)
    rw [hEq]
    exact mem_irreducibleComponent
  let U_loc : ↥Y.left → Y.left.Opens := fun y => Classical.choose (hLocalDom y)
  have hAff_loc : ∀ y : ↥Y.left, AlgebraicGeometry.IsAffineOpen (U_loc y) :=
    fun y => (Classical.choose_spec (hLocalDom y)).1
  have hy_loc : ∀ y : ↥Y.left, y ∈ U_loc y :=
    fun y => (Classical.choose_spec (hLocalDom y)).2.1
  have hDom_loc : ∀ y : ↥Y.left, IsDomain ↑(Y.left.presheaf.obj (Opposite.op (U_loc y))) :=
    fun y => (Classical.choose_spec (hLocalDom y)).2.2
  have hIrredU : ∀ y : ↥Y.left, IsIrreducible (U_loc y : Set Y.left) := by
    intro y
    let R_y := Y.left.presheaf.obj (Opposite.op (U_loc y))
    have : IsDomain ↑R_y := hDom_loc y
    have : AlgebraicGeometry.IsIntegral (AlgebraicGeometry.Spec R_y) := inferInstance
    have : IrreducibleSpace ↥(AlgebraicGeometry.Spec R_y) :=
      AlgebraicGeometry.irreducibleSpace_of_isIntegral (AlgebraicGeometry.Spec R_y)
    have hImg := (IrreducibleSpace.isIrreducible_univ ↥(AlgebraicGeometry.Spec R_y)).image
      (hAff_loc y).fromSpec.base (hAff_loc y).fromSpec.continuous.continuousOn
    rw [Set.image_univ] at hImg
    change IsIrreducible (Set.range ⇑(hAff_loc y).fromSpec) at hImg
    rwa [(hAff_loc y).range_fromSpec] at hImg
  have hRedY : AlgebraicGeometry.IsReduced Y.left := by
    have hRedU : ∀ y : ↥Y.left, AlgebraicGeometry.IsReduced (U_loc y).toScheme := by
      intro y
      let R_y := Y.left.presheaf.obj (Opposite.op (U_loc y))
      have : IsDomain ↑R_y := hDom_loc y
      have : AlgebraicGeometry.IsIntegral (AlgebraicGeometry.Spec R_y) := inferInstance
      exact AlgebraicGeometry.isReduced_of_isOpenImmersion (hAff_loc y).isoSpec.hom
    have hCovU : TopologicalSpace.IsOpenCover U_loc :=
      TopologicalSpace.IsOpenCover.mk
        (eq_top_iff.mpr fun y _ => TopologicalSpace.Opens.mem_iSup.mpr ⟨y, hy_loc y⟩)
    exact @AlgebraicGeometry.IsReduced.of_openCover Y.left
      (Y.left.openCoverOfIsOpenCover U_loc hCovU) hRedU
  have hSubExists : ∀ y : ↥Y.left, ∃ γ₀ : Fin t, (U_loc y : Set Y.left) ⊆ F_set γ₀ := by
    intro y
    classical
    let S_fin : Finset (Set Y.left) := Finset.univ.image F_set
    have hS_closed : ∀ z ∈ S_fin, IsClosed z := by
      intro z hz
      rcases Finset.mem_image.mp hz with ⟨γ, _, rfl⟩
      exact hClosedF γ
    have hS_cov : (U_loc y : Set Y.left) ⊆ ⋃₀ (S_fin : Set (Set Y.left)) := by
      have hEq : ⋃₀ (S_fin : Set (Set Y.left)) = Set.univ := by
        rw [Finset.coe_image, Finset.coe_univ, Set.image_univ, Set.sUnion_range, hCovF]
      rw [hEq]
      exact Set.subset_univ _
    obtain ⟨z, hz_mem, hSub_z⟩ :=
      (isIrreducible_iff_sUnion_isClosed.mp (hIrredU y)) S_fin hS_closed hS_cov
    rcases Finset.mem_image.mp hz_mem with ⟨γ₀, _, rfl⟩
    exact ⟨γ₀, hSub_z⟩
  have hEqComp : ∀ (y : ↥Y.left) (γ γ₀ : Fin t),
      y ∈ F_set γ → (U_loc y : Set Y.left) ⊆ F_set γ₀ → γ = γ₀ := by
    intro y γ γ₀ hyγ hSub
    by_contra hne
    obtain ⟨z, hzγ, hzNot⟩ := Set.not_subset.mp (hIncomp hne)
    obtain ⟨w, _, hwU, hwNot⟩ := (hIrredF γ).isPreirreducible
      (U_loc y : Set Y.left) (F_set γ₀)ᶜ
      (U_loc y).isOpen (hClosedF γ₀).isOpen_compl
      ⟨y, hyγ, hy_loc y⟩ ⟨z, hzγ, hzNot⟩
    exact hwNot (hSub hwU)
  have hOpenF : ∀ γ : Fin t, IsOpen (F_set γ) := by
    intro γ
    rw [isOpen_iff_forall_mem_open]
    intro y hyγ
    obtain ⟨γ₀, hSub⟩ := hSubExists y
    have hEq := hEqComp y γ γ₀ hyγ hSub
    subst hEq
    exact ⟨(U_loc y : Set Y.left), hSub, (U_loc y).isOpen, hy_loc y⟩
  have hDisjF : _root_.Pairwise fun γ₁ γ₂ : Fin t => Disjoint (F_set γ₁) (F_set γ₂) := by
    intro γ₁ γ₂ hne
    rw [Set.disjoint_left]
    intro y hy₁ hy₂
    obtain ⟨γ₀, hSub⟩ := hSubExists y
    have h₁ := hEqComp y γ₁ γ₀ hy₁ hSub
    have h₂ := hEqComp y γ₂ γ₀ hy₂ hSub
    exact hne (h₁.trans h₂.symm)
  let W : Fin t → Y.left.Opens := fun γ => ⟨F_set γ, hOpenF γ⟩
  let F : Fin t → AlgebraicGeometry.Scheme.{u} := fun γ => (W γ).toScheme
  let j_F : ∀ γ : Fin t, F γ ⟶ Y.left := fun γ => (W γ).ι
  have hRange_jF : ∀ γ : Fin t, Set.range (j_F γ).base = F_set γ := by
    intro γ
    change Set.range ⇑(W γ).ι = F_set γ
    exact AlgebraicGeometry.Scheme.Opens.range_ι (W γ)
  have hCl_jF : ∀ γ : Fin t, AlgebraicGeometry.IsClosedImmersion (j_F γ) := by
    intro γ
    have hClRange : IsClosed (Set.range ⇑(W γ).ι) := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι (W γ)]
      exact hClosedF γ
    exact AlgebraicGeometry.IsClosedImmersion.of_isPreimmersion (W γ).ι hClRange
  have hInt_F : ∀ γ : Fin t, AlgebraicGeometry.IsIntegral (F γ) := by
    intro γ
    have : AlgebraicGeometry.IsReduced Y.left := hRedY
    have : AlgebraicGeometry.IsReduced (F γ) :=
      AlgebraicGeometry.isReduced_of_isOpenImmersion (W γ).ι
    let e_homeo : ↥(F γ) ≃ₜ ↥(Set.range ⇑(W γ).ι) :=
      (W γ).ι.isOpenEmbedding.isEmbedding.toHomeomorph
    have hIrredRange : IsIrreducible (Set.range ⇑(W γ).ι) := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι (W γ)]
      exact hIrredF γ
    have : IrreducibleSpace ↥(Set.range ⇑(W γ).ι) := Subtype.irreducibleSpace hIrredRange
    have hIrredUniv : IsIrreducible (Set.univ : Set ↥(F γ)) := by
      have hImg := (IrreducibleSpace.isIrreducible_univ ↥(Set.range ⇑(W γ).ι)).image
        e_homeo.symm e_homeo.symm.continuous.continuousOn
      rwa [Set.image_univ, e_homeo.symm.surjective.range_eq] at hImg
    have : IrreducibleSpace ↥(F γ) := by
      rwa [irreducibleSpace_def, Set.top_eq_univ]
    exact AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced (F γ)
  have hSm_jF : ∀ γ : Fin t, AlgebraicGeometry.SmoothOfRelativeDimension d (j_F γ ≫ Y.hom) := by
    intro γ
    have : AlgebraicGeometry.SmoothOfRelativeDimension 0 (W γ).ι := inferInstance
    have : AlgebraicGeometry.SmoothOfRelativeDimension d Y.hom := hSmY
    have hComp := AlgebraicGeometry.smoothOfRelativeDimension_comp 0 d (W γ).ι Y.hom
    rwa [Nat.zero_add] at hComp
  refine ⟨t, F, j_F, hCl_jF, hInt_F, hSm_jF, ?_, ?_⟩
  · intro γ₁ γ₂ hne
    rw [hRange_jF γ₁, hRange_jF γ₂]
    exact hDisjF hne
  · simp_rw [hRange_jF]
    exact hCovF

theorem weil_algClosed_etale_local_principal_and_cotangent_basis (k : Type u) [Field k] [IsAlgClosed k] :
    (∀ (n : ℕ) (R' : Type u) [CommRing R'] (ψ : MvPolynomial (Fin n) k →+* R')
        (v₀ : PrimeSpectrum R'),
      ψ.Etale → ∃ u : R', u ∉ v₀.asIdeal ∧ IsDomain (Localization.Away u)) ∧
    (∀ (m s₀ : ℕ) (R₁ B' : Type u) [CommRing R₁] [CommRing B']
        (θ : MvPolynomial (Fin (m + 1)) k →+* R₁)
        (m_max : Ideal R₁) [m_max.IsMaximal]
        (P : Fin s₀ → Ideal R₁)
        (φ : R₁ →+* B')
        (q₀ : PrimeSpectrum B')
        (ψ_et : MvPolynomial (Fin (m + 1)) k →+* B')
        (α₀ : Fin s₀ → Fin (m + 1)),
      θ.Etale →
      (∀ c : Fin s₀, (P c).IsRadical) →
      (∀ c : Fin s₀, P c ≤ m_max) →
      φ.Etale →
      m_max ≤ q₀.asIdeal.comap φ →
      ψ_et.Etale →
      ψ_et.comp MvPolynomial.C = φ.comp (θ.comp MvPolynomial.C) →
      Function.Injective α₀ →
      (∀ c : Fin s₀, ψ_et (MvPolynomial.X (α₀ c)) ∈ q₀.asIdeal) →
      (∀ c : Fin s₀, {q : PrimeSpectrum B' | P c ≤ q.asIdeal.comap φ} =
        {q : PrimeSpectrum B' | ψ_et (MvPolynomial.X (α₀ c)) ∈ q.asIdeal}) →
      ∃ (θ' : MvPolynomial (Fin (m + 1)) k →+* R₁)
        (g : Fin (m + 1) → R₁)
        (M : Matrix (Fin (m + 1)) (Fin (m + 1)) k)
        (s_lin s_ideal : R₁),
        θ'.Etale ∧
        θ'.comp MvPolynomial.C = θ.comp MvPolynomial.C ∧
        (∀ b : Fin (m + 1), θ' (MvPolynomial.X b) ∈ m_max) ∧
        (∀ a : Fin (m + 1), g a ∈ m_max) ∧
        (∀ c : Fin s₀, g (α₀ c) ∈ P c) ∧
        IsUnit M.det ∧
        s_lin ∉ m_max ∧
        s_ideal ∉ m_max ∧
        (∀ c : Fin s₀, ∀ x ∈ P c, s_ideal * x ∈ Ideal.span {g (α₀ c)}) ∧
        (∀ a : Fin (m + 1),
          s_lin * (g a - ∑ b : Fin (m + 1), θ' (MvPolynomial.C (M a b) * MvPolynomial.X b)) ∈
            m_max ^ 2)) :=
by
  have hRed_MvPoly : ∀ n : ℕ, _root_.IsReduced (MvPolynomial (Fin n) k) :=
    fun _ => inferInstance
  
  have hNullstellensatzBij : ∀ (R₁ : Type u) [CommRing R₁] [Algebra k R₁] [Algebra.FiniteType k R₁]
      (m_max : Ideal R₁) [m_max.IsMaximal],
      Function.Bijective (algebraMap k (R₁ ⧸ m_max)) := by
    intro R₁ _ _ _ m_max _
    let _ : Field (R₁ ⧸ m_max) := Ideal.Quotient.field m_max
    have hFT_Q : Algebra.FiniteType k (R₁ ⧸ m_max) :=
      Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ k m_max)
        (fun x => Quotient.inductionOn' x fun r => ⟨r, rfl⟩)
    obtain ⟨s, hs⟩ := @Algebra.FiniteType.out k (R₁ ⧸ m_max) _ _ _ hFT_Q
    let n : ℕ := Fintype.card ↥s
    let e_fin : Fin n ≃ ↥s := (Fintype.equivFin ↥s).symm
    let π_K : MvPolynomial (Fin n) k →ₐ[k] (R₁ ⧸ m_max) :=
      MvPolynomial.aeval (fun i : Fin n => (e_fin i).1)
    have hSurj_π : Function.Surjective π_K := by
      intro y
      have h_range : Set.range (fun i : Fin n => (e_fin i).1) = (↑s : Set (R₁ ⧸ m_max)) := by
        ext z
        simp only [Set.mem_range, Finset.mem_coe]
        exact ⟨fun ⟨i, hi⟩ => hi ▸ (e_fin i).2, fun hz => ⟨e_fin.symm ⟨z, hz⟩, by simp⟩⟩
      have hy : y ∈ π_K.range := by
        rw [MvPolynomial.aeval_range, h_range, hs]
        exact Algebra.mem_top
      exact hy
    let p_K : Ideal (MvPolynomial (Fin n) k) := RingHom.ker π_K.toRingHom
    have _ : p_K.IsMaximal :=
      RingHom.ker_isMaximal_of_surjective π_K.toRingHom hSurj_π
    have hInt_quot : ((Ideal.Quotient.mk p_K).comp MvPolynomial.C).IsIntegral :=
      MvPolynomial.quotient_mk_comp_C_isIntegral_of_isJacobsonRing p_K
    let e_K : (MvPolynomial (Fin n) k ⧸ p_K) ≃ₐ[k] (R₁ ⧸ m_max) :=
      Ideal.quotientKerAlgEquivOfSurjective hSurj_π
    have _ : Algebra.IsIntegral k (R₁ ⧸ m_max) := by
      refine ⟨fun y => ?_⟩
      have hy₀ : IsIntegral k (e_K.symm y) := hInt_quot (e_K.symm y)
      simpa using hy₀.map e_K
    exact IsAlgClosed.algebraMap_bijective_of_isIntegral

  
  have hUnramifiedOfCoordsZero : ∀ (d : ℕ) (Q : Type u) [CommRing Q]
      [Algebra k Q] [Algebra (MvPolynomial (Fin d) k) Q]
      [IsScalarTower k (MvPolynomial (Fin d) k) Q]
      [Algebra.FormallyUnramified (MvPolynomial (Fin d) k) Q],
      (∀ b : Fin d, algebraMap (MvPolynomial (Fin d) k) Q (MvPolynomial.X b) = 0) →
      Algebra.FormallyUnramified k Q := by
    intro d Q _ _ _ _ _ hX_zero
    let P_d := MvPolynomial (Fin d) k
    have hD_zero : ∀ p : P_d, KaehlerDifferential.D k Q (algebraMap P_d Q p) = 0 := by
      intro p
      induction p using MvPolynomial.induction_on with
      | C c =>
        change KaehlerDifferential.D k Q (algebraMap P_d Q (algebraMap k P_d c)) = 0
        rw [← IsScalarTower.algebraMap_apply k P_d Q]
        exact (KaehlerDifferential.D k Q).map_algebraMap c
      | add f₁ f₂ ih₁ ih₂ =>
        rw [map_add, map_add, ih₁, ih₂, add_zero]
      | mul_X f₁ b _ =>
        rw [map_mul, hX_zero b, mul_zero, map_zero]
    have hMapBC_zero : KaehlerDifferential.mapBaseChange k P_d Q = 0 := by
      apply LinearMap.ext
      intro x
      change (KaehlerDifferential.mapBaseChange k P_d Q) x = 0
      induction x using TensorProduct.induction_on with
      | zero => exact map_zero _
      | tmul q ω =>
        have h1_zero : (KaehlerDifferential.mapBaseChange k P_d Q) ((1 : Q) ⊗ₜ[P_d] ω) = 0 := by
          have hω_mem : ω ∈ Submodule.span P_d (Set.range (KaehlerDifferential.D k P_d)) := by
            rw [KaehlerDifferential.span_range_derivation]
            trivial
          refine Submodule.span_induction
            (fun z hz => by
              obtain ⟨p, rfl⟩ := hz
              rw [KaehlerDifferential.mapBaseChange_tmul, KaehlerDifferential.map_D,
                hD_zero p, smul_zero])
            (by rw [TensorProduct.tmul_zero, map_zero])
            (fun y₁ y₂ _ _ hy₁ hy₂ => by rw [TensorProduct.tmul_add, map_add, hy₁, hy₂, add_zero])
            (fun a y _ hy => by
              have h_sm : (1 : Q) ⊗ₜ[P_d] (a • y) = algebraMap P_d Q a • ((1 : Q) ⊗ₜ[P_d] y) := by
                rw [← TensorProduct.smul_tmul, Algebra.smul_def, ← smul_eq_mul,
                  ← TensorProduct.smul_tmul']
              rw [h_sm, LinearMap.map_smul, hy, smul_zero]) hω_mem
        have hq_sm : q ⊗ₜ[P_d] ω = q • ((1 : Q) ⊗ₜ[P_d] ω) := by
          rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
        rw [hq_sm, LinearMap.map_smul, h1_zero, smul_zero]
      | add u v hu hv =>
        rw [map_add, hu, hv, add_zero]
    have hSub_kQ : Subsingleton (KaehlerDifferential k Q) := by
      refine ⟨fun ω₁ ω₂ => sub_eq_zero.mp ?_⟩
      have _ : Subsingleton (KaehlerDifferential P_d Q) :=
        Algebra.FormallyUnramified.subsingleton_kaehlerDifferential
      have hker : KaehlerDifferential.map k P_d Q Q (ω₁ - ω₂) = 0 :=
        Subsingleton.elim _ _
      obtain ⟨z, hz⟩ := (KaehlerDifferential.exact_mapBaseChange_map k P_d Q) (ω₁ - ω₂) |>.mp hker
      rw [← hz, hMapBC_zero, LinearMap.zero_apply]
    exact ⟨hSub_kQ⟩

  
  have hUnramifiedLocalQuot : ∀ (d : ℕ) (R₁ : Type u) [CommRing R₁]
      [Algebra k R₁] [Algebra (MvPolynomial (Fin d) k) R₁]
      [IsScalarTower k (MvPolynomial (Fin d) k) R₁]
      [Algebra.Etale (MvPolynomial (Fin d) k) R₁]
      (m_max : Ideal R₁) [m_max.IsMaximal],
      (∀ b : Fin d, algebraMap (MvPolynomial (Fin d) k) R₁ (MvPolynomial.X b) ∈ m_max) →
      let A := Localization.AtPrime m_max
      let J₁ : Ideal R₁ := Ideal.span (Set.range fun b : Fin d =>
        algebraMap (MvPolynomial (Fin d) k) R₁ (MvPolynomial.X b))
      let I_A : Ideal A := Ideal.map (algebraMap R₁ A) J₁
      Function.Bijective (algebraMap k (A ⧸ I_A)) ∧
      I_A = IsLocalRing.maximalIdeal A := by
    intro d R₁ _ _ _ _ _ m_max _ hX
    let P_d := MvPolynomial (Fin d) k
    have _ : m_max.IsPrime := Ideal.IsMaximal.isPrime inferInstance
    let A := Localization.AtPrime m_max
    let J₁ : Ideal R₁ := Ideal.span (Set.range fun b : Fin d => algebraMap P_d R₁ (MvPolynomial.X b))
    let I_A : Ideal A := Ideal.map (algebraMap R₁ A) J₁
    let Q := A ⧸ I_A
    have hJ₁_le : J₁ ≤ m_max := Ideal.span_le.mpr (Set.range_subset_iff.mpr hX)
    have hm_A : Ideal.map (algebraMap R₁ A) m_max = IsLocalRing.maximalIdeal A :=
      Localization.AtPrime.map_eq_maximalIdeal
    have hIA_le : I_A ≤ IsLocalRing.maximalIdeal A :=
      hm_A ▸ Ideal.map_mono hJ₁_le
    have hIA_ne_top : I_A ≠ ⊤ :=
      fun h => (IsLocalRing.maximalIdeal.isMaximal A).ne_top (top_unique (h ▸ hIA_le))
    have _ : Nontrivial Q := Ideal.Quotient.nontrivial_iff.mpr hIA_ne_top
    have _ : IsLocalRing Q :=
      IsLocalRing.of_surjective' (Ideal.Quotient.mk I_A) Ideal.Quotient.mk_surjective
    have _ : IsScalarTower k P_d A :=
      @IsScalarTower.of_algebraMap_eq k P_d A _ _ _ _ _ _ fun c => by
        rw [IsScalarTower.algebraMap_apply k R₁ A, IsScalarTower.algebraMap_apply k P_d R₁,
          ← IsScalarTower.algebraMap_apply P_d R₁ A]
    have _ : IsScalarTower k P_d Q :=
      @IsScalarTower.of_algebraMap_eq k P_d Q _ _ _ _ _ _ fun c => by
        rw [IsScalarTower.algebraMap_apply k A Q, IsScalarTower.algebraMap_apply k P_d A,
          ← IsScalarTower.algebraMap_apply P_d A Q]
    have _ : Algebra.FormallyUnramified R₁ A :=
      Algebra.FormallyUnramified.of_isLocalization m_max.primeCompl
    have _ : Algebra.FormallyUnramified P_d A :=
      Algebra.FormallyUnramified.comp P_d R₁ A
    have _ : Algebra.FormallyUnramified A Q :=
      Algebra.FormallyUnramified.quotient I_A
    have _ : Algebra.FormallyUnramified P_d Q :=
      Algebra.FormallyUnramified.comp P_d A Q
    have _ : Algebra.FiniteType k R₁ :=
      Algebra.FiniteType.trans (S := P_d) inferInstance inferInstance
    have _ : Algebra.EssFiniteType k R₁ := Algebra.EssFiniteType.of_finiteType k R₁
    have _ : Algebra.EssFiniteType k A :=
      Algebra.instEssFiniteTypeLocalization k R₁ m_max.primeCompl
    have _ : Algebra.EssFiniteType k Q :=
      Algebra.instEssFiniteTypeQuotientIdeal k A I_A
    have hX_zero : ∀ b : Fin d, algebraMap P_d Q (MvPolynomial.X b) = 0 := by
      intro b
      rw [IsScalarTower.algebraMap_apply P_d A Q, IsScalarTower.algebraMap_apply P_d R₁ A]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr
        (Ideal.mem_map_of_mem _ (Ideal.subset_span ⟨b, rfl⟩))
    have _ : Algebra.FormallyUnramified k Q :=
      hUnramifiedOfCoordsZero d Q hX_zero
    have hBij : Function.Bijective (algebraMap k Q) :=
      Algebra.FormallyUnramified.bijective_of_isAlgClosed_of_isLocalRing k Q
    refine ⟨hBij, ?_⟩
    let e_kQ : k ≃+* Q := RingEquiv.ofBijective (algebraMap k Q) hBij
    have hIsFieldQ : IsField Q := e_kQ.symm.toMulEquiv.isField (Field.toIsField k)
    have hMax_IA : I_A.IsMaximal := Ideal.Quotient.maximal_of_isField I_A hIsFieldQ
    exact IsLocalRing.eq_maximalIdeal hMax_IA

  
  have hCoordShiftAndLinearApprox : ∀ (d : ℕ) (R₁ : Type u) [CommRing R₁]
      (θ : MvPolynomial (Fin d) k →+* R₁)
      (m_max : Ideal R₁) [m_max.IsMaximal],
      θ.Etale →
      ∃ θ' : MvPolynomial (Fin d) k →+* R₁,
        θ'.Etale ∧
        θ'.comp MvPolynomial.C = θ.comp MvPolynomial.C ∧
        (∀ b : Fin d, θ' (MvPolynomial.X b) ∈ m_max) ∧
        (d = 0 → IsDomain (Localization.AtPrime m_max)) ∧
        (∀ f ∈ m_max, ∃ v : Fin d → k,
          f - ∑ b : Fin d, θ' (MvPolynomial.C (v b) * MvPolynomial.X b) ∈ m_max ^ 2) := by
    intro d R₁ _ θ m_max _ hEt
    let P_d := MvPolynomial (Fin d) k
    have hShift : ∃ θ' : P_d →+* R₁,
        θ'.Etale ∧ θ'.comp MvPolynomial.C = θ.comp MvPolynomial.C ∧
        ∀ b : Fin d, θ' (MvPolynomial.X b) ∈ m_max := by
      let _ : Algebra k R₁ := (θ.comp MvPolynomial.C).toAlgebra
      let _ : Algebra P_d R₁ := θ.toAlgebra
      have _ : IsScalarTower k P_d R₁ := IsScalarTower.of_algebraMap_eq' rfl
      have _ : Algebra.Etale P_d R₁ := hEt
      have _ : Algebra.FiniteType k R₁ :=
        Algebra.FiniteType.trans (S := P_d) inferInstance inferInstance
      have hBijK := hNullstellensatzBij R₁ m_max
      choose c hc using fun b : Fin d =>
        hBijK.2 (Ideal.Quotient.mk m_max (θ (MvPolynomial.X b)))
      let φ₁ : P_d →ₐ[k] P_d :=
        MvPolynomial.aeval (fun b : Fin d => MvPolynomial.X b - MvPolynomial.C (c b))
      let φ₂ : P_d →ₐ[k] P_d :=
        MvPolynomial.aeval (fun b : Fin d => MvPolynomial.X b + MvPolynomial.C (c b))
      have h₁₂ : φ₁.comp φ₂ = AlgHom.id k P_d := by
        apply MvPolynomial.algHom_ext
        intro b
        dsimp only [AlgHom.comp_apply, AlgHom.id_apply, φ₁, φ₂]
        rw [MvPolynomial.aeval_X, map_add, MvPolynomial.aeval_X, MvPolynomial.aeval_C]
        change MvPolynomial.X b - MvPolynomial.C (c b) + MvPolynomial.C (c b) = MvPolynomial.X b
        ring
      have h₂₁ : φ₂.comp φ₁ = AlgHom.id k P_d := by
        apply MvPolynomial.algHom_ext
        intro b
        dsimp only [AlgHom.comp_apply, AlgHom.id_apply, φ₁, φ₂]
        rw [MvPolynomial.aeval_X, map_sub, MvPolynomial.aeval_X, MvPolynomial.aeval_C]
        change MvPolynomial.X b + MvPolynomial.C (c b) - MvPolynomial.C (c b) = MvPolynomial.X b
        ring
      let σ_c : P_d ≃ₐ[k] P_d := AlgEquiv.ofAlgHom φ₁ φ₂ h₁₂ h₂₁
      let θ' : P_d →+* R₁ := θ.comp σ_c.toRingEquiv.toRingHom
      have hEt' : θ'.Etale :=
        RingHom.Etale.respectsIso.right θ σ_c.toRingEquiv hEt
      refine ⟨θ', hEt', ?_, ?_⟩
      · ext a
        change θ (σ_c (algebraMap k P_d a)) = θ (MvPolynomial.C a)
        rw [σ_c.commutes]
        rfl
      · intro b
        change θ (φ₁ (MvPolynomial.X b)) ∈ m_max
        rw [MvPolynomial.aeval_X, map_sub, ← Ideal.Quotient.eq]
        exact (hc b).symm
    obtain ⟨θ', hEt', hC', hX'⟩ := hShift
    refine ⟨θ', hEt', hC', hX', ?_, ?_⟩
    · intro hd0
      subst hd0
      let _ : Algebra k R₁ := (θ'.comp MvPolynomial.C).toAlgebra
      let _ : Algebra (MvPolynomial (Fin 0) k) R₁ := θ'.toAlgebra
      have _ : IsScalarTower k (MvPolynomial (Fin 0) k) R₁ := IsScalarTower.of_algebraMap_eq' rfl
      have _ : Algebra.Etale (MvPolynomial (Fin 0) k) R₁ := hEt'
      have _ : m_max.IsPrime := Ideal.IsMaximal.isPrime inferInstance
      obtain ⟨hBijQ, _⟩ := hUnramifiedLocalQuot 0 R₁ m_max hX'
      let A := Localization.AtPrime m_max
      let J₁ : Ideal R₁ := Ideal.span (Set.range fun b : Fin 0 => θ' (MvPolynomial.X b))
      let I_A : Ideal A := Ideal.map (algebraMap R₁ A) J₁
      have hRange0 : (Set.range fun b : Fin 0 => θ' (MvPolynomial.X b)) = ∅ := by
        ext x
        exact ⟨fun ⟨b, _⟩ => Fin.elim0 b, False.elim⟩
      have hIA_bot : I_A = ⊥ := by
        dsimp only [I_A, J₁]
        rw [hRange0, Ideal.span_empty, Ideal.map_bot]
      let e_bot : (A ⧸ I_A) ≃+* A :=
        (Ideal.quotEquivOfEq hIA_bot).trans (RingEquiv.quotientBot A)
      let e_kA : k ≃+* A := (RingEquiv.ofBijective (algebraMap k (A ⧸ I_A)) hBijQ).trans e_bot
      exact Function.Injective.isDomain e_kA.symm.toRingHom e_kA.symm.injective
    · intro f hf
      let _ : Algebra k R₁ := (θ'.comp MvPolynomial.C).toAlgebra
      let _ : Algebra P_d R₁ := θ'.toAlgebra
      have _ : IsScalarTower k P_d R₁ := IsScalarTower.of_algebraMap_eq' rfl
      have _ : Algebra.Etale P_d R₁ := hEt'
      have _ : m_max.IsPrime := Ideal.IsMaximal.isPrime inferInstance
      obtain ⟨hBijQ, hIA_eq⟩ := hUnramifiedLocalQuot d R₁ m_max hX'
      let A := Localization.AtPrime m_max
      let J₁ : Ideal R₁ := Ideal.span (Set.range fun b : Fin d => algebraMap P_d R₁ (MvPolynomial.X b))
      let I_A : Ideal A := Ideal.map (algebraMap R₁ A) J₁
      have hm_A : Ideal.map (algebraMap R₁ A) m_max = IsLocalRing.maximalIdeal A :=
        Localization.AtPrime.map_eq_maximalIdeal
      have hf_IA : algebraMap R₁ A f ∈ I_A := by
        dsimp only [I_A, J₁]
        rw [hIA_eq, ← hm_A]
        exact Ideal.mem_map_of_mem _ hf
      have hIA_span : I_A = Ideal.span (Set.range fun b : Fin d => algebraMap R₁ A (θ' (MvPolynomial.X b))) := by
        dsimp only [I_A, J₁]
        rw [Ideal.map_span, ← Set.range_comp]
        rfl
      rw [hIA_span, Submodule.mem_span_range_iff_exists_fun] at hf_IA
      obtain ⟨a, ha⟩ := hf_IA
      choose v hv using fun b : Fin d => hBijQ.2 (Ideal.Quotient.mk I_A (a b))
      refine ⟨v, ?_⟩
      let r : R₁ := f - ∑ b : Fin d, θ' (MvPolynomial.C (v b) * MvPolynomial.X b)
      have hr_A : algebraMap R₁ A r ∈ Ideal.map (algebraMap R₁ A) (m_max ^ 2) := by
        rw [Ideal.map_pow, sq]
        have hr_eq : algebraMap R₁ A r =
            ∑ b : Fin d, (a b - algebraMap k A (v b)) * algebraMap R₁ A (θ' (MvPolynomial.X b)) := by
          dsimp only [r]
          rw [map_sub, ← ha, map_sum]
          simp only [smul_eq_mul, map_mul, sub_mul, Finset.sum_sub_distrib]
          rfl
        rw [hr_eq]
        refine Ideal.sum_mem _ fun b _ => Submodule.mul_mem_mul ?_ (Ideal.mem_map_of_mem _ (hX' b))
        rw [hm_A, ← hIA_eq, ← Ideal.Quotient.eq]
        exact (hv b).symm
      rw [IsLocalization.mem_map_algebraMap_iff m_max.primeCompl A] at hr_A
      obtain ⟨⟨⟨c_sq, hc_sq⟩, s₁⟩, hs₁⟩ := hr_A
      have hs₁' : algebraMap R₁ A (r * s₁.1) = algebraMap R₁ A c_sq := by
        simpa [map_mul] using hs₁
      obtain ⟨s₂, hs₂⟩ := IsLocalization.exists_of_eq (M := m_max.primeCompl) hs₁'
      let s : m_max.primeCompl := s₂ * s₁
      have hsr : s.1 * r ∈ m_max ^ 2 := by
        have h_eq : s.1 * r = s₂.1 * c_sq := by
          calc s.1 * r = s₂.1 * (r * s₁.1) := by change (s₂.1 * s₁.1) * r = _; ring
            _ = s₂.1 * c_sq := hs₂
        rw [h_eq]
        exact Ideal.mul_mem_left _ s₂.1 hc_sq
      have h_sup : m_max ⊔ Ideal.span {s.1} = ⊤ := by
        by_contra h_ne_top
        have h_eq := Ideal.IsMaximal.eq_of_le (inferInstance : m_max.IsMaximal) h_ne_top le_sup_left
        have hs_mem : s.1 ∈ m_max ⊔ Ideal.span {s.1} := Ideal.mem_sup_right (Ideal.subset_span rfl)
        rw [← h_eq] at hs_mem
        exact s.2 hs_mem
      have h_one : (1 : R₁) ∈ m_max ⊔ Ideal.span {s.1} := by
        rw [h_sup]
        trivial
      rw [Submodule.mem_sup] at h_one
      obtain ⟨m_el, hm_el, z_el, hz_el, h_sum⟩ := h_one
      rw [Ideal.mem_span_singleton] at hz_el
      obtain ⟨y, rfl⟩ := hz_el
      have hr_decomp : r = m_el ^ 2 * r + (2 * m_el * y + y ^ 2 * s.1) * (s.1 * r) := by
        calc r = 1 ^ 2 * r := by ring
          _ = (m_el + s.1 * y) ^ 2 * r := by rw [h_sum]
          _ = m_el ^ 2 * r + (2 * m_el * y + y ^ 2 * s.1) * (s.1 * r) := by ring
      change r ∈ m_max ^ 2
      rw [hr_decomp]
      exact Ideal.add_mem _ (Ideal.mul_mem_right r _ (Ideal.pow_mem_pow hm_el 2))
        (Ideal.mul_mem_left _ _ hsr)

  
  have hEtaleQuotBaseChange : ∀ (A₀ : Type u) [CommRing A₀]
      (R' : Type u) [CommRing R'] [Algebra A₀ R'] [Algebra.Etale A₀ R']
      (J₀ : Ideal A₀),
      ∃ φ_q : (A₀ ⧸ J₀) →+* (R' ⧸ Ideal.map (algebraMap A₀ R') J₀), φ_q.Etale := by
    intro A₀ _ R' _ _ _ J₀
    have _ : Algebra.Etale (A₀ ⧸ J₀) (TensorProduct A₀ (A₀ ⧸ J₀) R') :=
      Algebra.Etale.baseChange A₀ R' (A₀ ⧸ J₀)
    let e₁ : TensorProduct A₀ (A₀ ⧸ J₀) R' ≃+* TensorProduct A₀ R' (A₀ ⧸ J₀) :=
      (Algebra.TensorProduct.comm A₀ (A₀ ⧸ J₀) R').toRingEquiv
    let e₂ : TensorProduct A₀ R' (A₀ ⧸ J₀) ≃+* (R' ⧸ Ideal.map (algebraMap A₀ R') J₀) :=
      (Algebra.TensorProduct.quotIdealMapEquivTensorQuot R' J₀).symm.toRingEquiv
    let e : TensorProduct A₀ (A₀ ⧸ J₀) R' ≃+* (R' ⧸ Ideal.map (algebraMap A₀ R') J₀) :=
      e₁.trans e₂
    have h_et : (algebraMap (A₀ ⧸ J₀) (TensorProduct A₀ (A₀ ⧸ J₀) R')).Etale :=
      RingHom.etale_algebraMap.mpr inferInstance
    exact ⟨e.toRingHom.comp (algebraMap (A₀ ⧸ J₀) (TensorProduct A₀ (A₀ ⧸ J₀) R')),
      RingHom.Etale.respectsIso.left _ e h_et⟩

  
  have hCoordQuotEtale : ∀ (n : ℕ) (R' : Type u) [CommRing R']
      (ψ : MvPolynomial (Fin (n + 1)) k →+* R') (j₀ : Fin (n + 1)),
      ψ.Etale →
      ∃ ψ_bar : MvPolynomial (Fin n) k →+*
          (R' ⧸ Ideal.span ({ψ (MvPolynomial.X j₀)} : Set R')),
        ψ_bar.Etale := by
    intro n R' _ ψ j₀ hEt
    let P₁ := MvPolynomial (Fin (n + 1)) k
    let P₀ := MvPolynomial (Fin n) k
    let g_var : Fin (n + 1) → P₀ := fun i =>
      if hi : i = j₀ then 0 else MvPolynomial.X (Classical.choose (Fin.exists_succAbove_eq hi))
    let κ : P₁ →ₐ[k] P₀ := MvPolynomial.aeval g_var
    let ρ : P₀ →ₐ[k] P₁ := MvPolynomial.rename (Fin.succAbove j₀)
    have hκρ : κ.comp ρ = AlgHom.id k P₀ := by
      apply MvPolynomial.algHom_ext
      intro r
      dsimp only [AlgHom.comp_apply, AlgHom.id_apply, ρ, κ]
      rw [MvPolynomial.rename_X, MvPolynomial.aeval_X]
      dsimp only [g_var]
      have hr : j₀.succAbove r ≠ j₀ := Fin.succAbove_ne j₀ r
      simp only [hr, ↓reduceDIte]
      congr 1
      exact Fin.succAbove_right_injective (Classical.choose_spec (Fin.exists_succAbove_eq hr))
    have hSurj_κ : Function.Surjective κ := fun f => ⟨ρ f, AlgHom.congr_fun hκρ f⟩
    let J₀ : Ideal P₁ := Ideal.span ({MvPolynomial.X j₀} : Set P₁)
    have h_sub_J₀ : ∀ f : P₁, f - ρ (κ f) ∈ J₀ := by
      intro f
      induction f using MvPolynomial.induction_on with
      | C c =>
        have h1 : κ (MvPolynomial.C c) = MvPolynomial.C c := MvPolynomial.aeval_C g_var c
        have h2 : ρ (MvPolynomial.C c) = MvPolynomial.C c := MvPolynomial.rename_C j₀.succAbove c
        rw [h1, h2, sub_self]
        exact J₀.zero_mem
      | add f₁ f₂ ih₁ ih₂ =>
        have h_eq : f₁ + f₂ - ρ (κ (f₁ + f₂)) = (f₁ - ρ (κ f₁)) + (f₂ - ρ (κ f₂)) := by
          simp only [map_add]
          ring
        rw [h_eq]
        exact Ideal.add_mem J₀ ih₁ ih₂
      | mul_X f₁ i ih =>
        by_cases hi : i = j₀
        · rw [hi]
          have hX0 : κ (MvPolynomial.X j₀) = 0 := by
            change MvPolynomial.aeval g_var (MvPolynomial.X j₀) = 0
            rw [MvPolynomial.aeval_X]
            simp [g_var]
          rw [map_mul, hX0, mul_zero, map_zero, sub_zero, mul_comm]
          exact Ideal.mul_mem_right f₁ J₀ (Ideal.subset_span rfl)
        · obtain ⟨r, rfl⟩ := Fin.exists_succAbove_eq hi
          have h_ren : MvPolynomial.X (j₀.succAbove r) = ρ (MvPolynomial.X r) :=
            (MvPolynomial.rename_X j₀.succAbove r).symm
          have hκρ_r : κ (ρ (MvPolynomial.X r)) = MvPolynomial.X r :=
            AlgHom.congr_fun hκρ (MvPolynomial.X r)
          have hXr : ρ (κ (MvPolynomial.X (j₀.succAbove r))) = MvPolynomial.X (j₀.succAbove r) := by
            rw [h_ren, hκρ_r]
          rw [map_mul, map_mul, hXr, ← sub_mul]
          exact Ideal.mul_mem_right _ J₀ ih
    have h_ker : RingHom.ker κ.toRingHom = J₀ := by
      apply le_antisymm
      · intro f hf
        rw [RingHom.mem_ker] at hf
        have hf' : κ f = 0 := hf
        simpa [hf'] using h_sub_J₀ f
      · rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
        change MvPolynomial.aeval g_var (MvPolynomial.X j₀) = 0
        rw [MvPolynomial.aeval_X]
        simp [g_var]
    let e_left : P₀ ≃+* (P₁ ⧸ J₀) :=
      (Ideal.quotientKerAlgEquivOfSurjective hSurj_κ).symm.toRingEquiv.trans
        (Ideal.quotEquivOfEq h_ker)
    let _ : Algebra P₁ R' := ψ.toAlgebra
    have _ : Algebra.Etale P₁ R' := hEt
    obtain ⟨φ_q, hEt_q⟩ := hEtaleQuotBaseChange P₁ R' J₀
    have hMap_J₀ : Ideal.map ψ J₀ = Ideal.span ({ψ (MvPolynomial.X j₀)} : Set R') := by
      dsimp only [J₀]
      rw [Ideal.map_span, Set.image_singleton]
    let e_right : (R' ⧸ Ideal.map ψ J₀) ≃+*
        (R' ⧸ Ideal.span ({ψ (MvPolynomial.X j₀)} : Set R')) :=
      Ideal.quotEquivOfEq hMap_J₀
    have hEt_r : (e_right.toRingHom.comp φ_q).Etale :=
      RingHom.Etale.respectsIso.left φ_q e_right hEt_q
    exact ⟨(e_right.toRingHom.comp φ_q).comp e_left.toRingHom,
      RingHom.Etale.respectsIso.right (e_right.toRingHom.comp φ_q) e_left hEt_r⟩

  
  have hConj1 : ∀ (n : ℕ) (R' : Type u) [CommRing R'] (ψ : MvPolynomial (Fin n) k →+* R')
      (v₀ : PrimeSpectrum R'),
      ψ.Etale → ∃ u : R', u ∉ v₀.asIdeal ∧ IsDomain (Localization.Away u) := by
    have hAtMaxDom : ∀ (n : ℕ) (R' : Type u) [CommRing R']
        (ψ : MvPolynomial (Fin n) k →+* R') (m : Ideal R') [m.IsMaximal],
        ψ.Etale → IsDomain (Localization.AtPrime m) := by
      intro n
      induction n with
      | zero =>
        intro R' _ ψ m _ hEt
        obtain ⟨_, _, _, _, hDom0, _⟩ := hCoordShiftAndLinearApprox 0 R' ψ m hEt
        exact hDom0 rfl
      | succ n ih =>
        intro R' _ ψ m _ hEt
        obtain ⟨ψ', hEt', _, hX', _, _⟩ :=
          hCoordShiftAndLinearApprox (n + 1) R' ψ m hEt
        have _ : m.IsPrime := Ideal.IsMaximal.isPrime inferInstance
        let t₀ : R' := ψ' (MvPolynomial.X 0)
        have ht₀_mem : t₀ ∈ m := hX' 0
        let Rbar := R' ⧸ Ideal.span ({t₀} : Set R')
        let π : R' →+* Rbar := Ideal.Quotient.mk (Ideal.span ({t₀} : Set R'))
        let mbar : Ideal Rbar := Ideal.map π m
        have hmbar_comap : mbar.comap π = m := by
          dsimp only [mbar, π]
          rw [Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective]
          refine sup_eq_left.mpr fun x hx => ?_
          rw [Ideal.mem_comap, Ideal.mem_bot, Ideal.Quotient.eq_zero_iff_mem,
            Ideal.mem_span_singleton] at hx
          obtain ⟨c, rfl⟩ := hx
          exact m.mul_mem_right c ht₀_mem
        have hmbar_max : mbar.IsMaximal := by
          let φ_f : Rbar →+* (R' ⧸ m) :=
            Ideal.Quotient.lift (Ideal.span ({t₀} : Set R')) (Ideal.Quotient.mk m)
              (fun x hx => by
                rw [Ideal.mem_span_singleton] at hx
                obtain ⟨c, rfl⟩ := hx
                exact Ideal.Quotient.eq_zero_iff_mem.mpr (m.mul_mem_right c ht₀_mem))
          have hSurj_f : Function.Surjective φ_f := fun z =>
            Quotient.inductionOn' z fun r => ⟨π r, rfl⟩
          have hKer_f : RingHom.ker φ_f = mbar := by
            ext z
            refine Quotient.inductionOn' z fun r => ?_
            change Ideal.Quotient.mk m r = 0 ↔ π r ∈ mbar
            rw [Ideal.Quotient.eq_zero_iff_mem, ← Ideal.mem_comap, hmbar_comap]
          let _ : Field (R' ⧸ m) := Ideal.Quotient.field m
          rw [← hKer_f]
          exact RingHom.ker_isMaximal_of_surjective φ_f hSurj_f
        obtain ⟨ψ_bar, hEt_bar⟩ := hCoordQuotEtale n R' ψ' 0 hEt'
        have hDom_bar : IsDomain (Localization.AtPrime mbar) :=
          @ih Rbar _ ψ_bar mbar hmbar_max hEt_bar
        have _ : mbar.IsPrime := Ideal.IsMaximal.isPrime hmbar_max
        let A := Localization.AtPrime m
        let tbar₀ : A := algebraMap R' A t₀
        let J_A : Ideal A := Ideal.span ({tbar₀} : Set A)
        let Lbar := Localization.AtPrime mbar
        let φ₀ : A →+* Lbar :=
          IsLocalization.lift (M := m.primeCompl) (g := (algebraMap Rbar Lbar).comp π) fun s => by
            change IsUnit (algebraMap Rbar Lbar (π s.1))
            rw [IsLocalization.AtPrime.isUnit_to_map_iff Lbar mbar (π s.1)]
            intro hs_mem
            have : s.1 ∈ mbar.comap π := hs_mem
            rw [hmbar_comap] at this
            exact s.2 this
        have hφ₀_ker : J_A ≤ RingHom.ker φ₀ := by
          rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
          dsimp only [tbar₀, φ₀]
          rw [IsLocalization.lift_eq]
          change algebraMap Rbar Lbar (π t₀) = 0
          have hπ0 : π t₀ = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
          rw [hπ0, map_zero]
        let Φ : (A ⧸ J_A) →+* Lbar := Ideal.Quotient.lift J_A φ₀ hφ₀_ker
        let ψ₀_bar : Rbar →+* (A ⧸ J_A) :=
          Ideal.Quotient.lift (Ideal.span ({t₀} : Set R'))
            ((Ideal.Quotient.mk J_A).comp (algebraMap R' A)) fun x hx => by
              rw [Ideal.mem_span_singleton] at hx
              obtain ⟨c, rfl⟩ := hx
              change Ideal.Quotient.mk J_A (algebraMap R' A (t₀ * c)) = 0
              rw [map_mul, Ideal.Quotient.eq_zero_iff_mem]
              exact Ideal.mul_mem_right _ J_A (Ideal.subset_span rfl)
        let Ψ : Lbar →+* (A ⧸ J_A) :=
          IsLocalization.lift (M := mbar.primeCompl) (g := ψ₀_bar) fun s => by
            obtain ⟨r, hr⟩ := Ideal.Quotient.mk_surjective s.1
            change IsUnit (ψ₀_bar s.1)
            rw [← hr]
            have hr_notMem : r ∉ m := by
              intro hrm
              exact s.2 (hr ▸ Ideal.mem_map_of_mem π hrm)
            have hUnitA : IsUnit (algebraMap R' A r) :=
              IsLocalization.map_units A (⟨r, hr_notMem⟩ : m.primeCompl)
            exact hUnitA.map (Ideal.Quotient.mk J_A)
        have hInj_Φ : Function.Injective Φ := by
          intro z₁ z₂ hz
          have hΨΦ : ∀ z : A ⧸ J_A, Ψ (Φ z) = z := by
            intro z
            refine Quotient.inductionOn' z fun a => ?_
            obtain ⟨⟨r, s⟩, hrs⟩ := IsLocalization.surj m.primeCompl a
            have hs_unit : IsUnit (algebraMap R' A s.1) := IsLocalization.map_units A s
            obtain ⟨u_s, hu_s⟩ := hs_unit
            have h_a_eq : a = algebraMap R' A r * ↑u_s⁻¹ := by
              apply u_s.isUnit.mul_right_cancel
              rw [mul_assoc, Units.inv_mul, mul_one, hu_s]
              exact hrs
            rw [h_a_eq]
            change Ψ (φ₀ (algebraMap R' A r * ↑u_s⁻¹)) =
              Ideal.Quotient.mk J_A (algebraMap R' A r * ↑u_s⁻¹)
            have h_r : Ψ (φ₀ (algebraMap R' A r)) = Ideal.Quotient.mk J_A (algebraMap R' A r) := by
              dsimp only [φ₀, Ψ]
              rw [IsLocalization.lift_eq, RingHom.comp_apply, IsLocalization.lift_eq]
              rfl
            have h_s : Ψ (φ₀ ↑u_s) = Ideal.Quotient.mk J_A ↑u_s := by
              rw [hu_s]
              dsimp only [φ₀, Ψ]
              rw [IsLocalization.lift_eq, RingHom.comp_apply, IsLocalization.lift_eq]
              rfl
            have h_inv : Ψ (φ₀ ↑u_s⁻¹) * Ideal.Quotient.mk J_A ↑u_s = 1 := by
              rw [← h_s, ← map_mul, ← map_mul, Units.inv_mul, map_one, map_one]
            have h_inv2 : Ideal.Quotient.mk J_A ↑u_s⁻¹ * Ideal.Quotient.mk J_A ↑u_s = 1 := by
              rw [← map_mul, Units.inv_mul, map_one]
            have h_eq_inv : Ψ (φ₀ ↑u_s⁻¹) = Ideal.Quotient.mk J_A ↑u_s⁻¹ := by
              exact (u_s.isUnit.map (Ideal.Quotient.mk J_A)).mul_right_cancel (h_inv.trans h_inv2.symm)
            rw [map_mul, map_mul, map_mul, h_r, h_eq_inv]
          rw [← hΨΦ z₁, ← hΨΦ z₂, hz]
        have hDom_quot : IsDomain (A ⧸ J_A) :=
          @Function.Injective.isDomain Lbar (A ⧸ J_A) _ hDom_bar _ _ _ _ Φ hInj_Φ
        have hPrime_JA : J_A.IsPrime := (Ideal.Quotient.isDomain_iff_prime J_A).mp hDom_quot
        let P₁ := MvPolynomial (Fin (n + 1)) k
        let _ : Algebra P₁ R' := ψ'.toAlgebra
        have _ : Algebra.Etale P₁ R' := hEt'
        have _ : Module.Flat P₁ R' := Algebra.Smooth.flat P₁ R'
        have _ : Module.Flat R' A := IsLocalization.flat A m.primeCompl
        have _ : Module.Flat P₁ A := Module.Flat.trans P₁ R' A
        have hX0_nzd : (MvPolynomial.X 0 : P₁) ∈ nonZeroDivisors P₁ :=
          mem_nonZeroDivisors_of_ne_zero (MvPolynomial.X_ne_zero 0)
        have hReg_X0 : IsSMulRegular A (MvPolynomial.X 0 : P₁) :=
          Module.Flat.isSMulRegular_of_nonZeroDivisors hX0_nzd
        have hReg_tbar : ∀ x y : A, tbar₀ * x = tbar₀ * y → x = y := by
          intro x y hxy
          apply hReg_X0
          change (MvPolynomial.X 0 : P₁) • x = (MvPolynomial.X 0 : P₁) • y
          rw [Algebra.smul_def, Algebra.smul_def]
          exact hxy
        have _ : IsNoetherianRing R' := Algebra.FiniteType.isNoetherianRing P₁ R'
        have _ : IsNoetherianRing A := IsLocalization.isNoetherianRing m.primeCompl A inferInstance
        have hJA_ne_top : J_A ≠ ⊤ := hPrime_JA.ne_top
        have hKrull : ⨅ i : ℕ, J_A ^ i = ⊥ :=
          Ideal.iInf_pow_eq_bot_of_isLocalRing J_A hJA_ne_top
        have hDiv : ∀ (N : ℕ) (u v : A), u * v = 0 → ∀ a b : ℕ, a + b = N →
            u ∈ J_A ^ a ∨ v ∈ J_A ^ b := by
          intro N
          induction N with
          | zero =>
            intro u v _ a b hab
            have ha0 : a = 0 := Nat.eq_zero_of_add_eq_zero_right hab
            subst ha0
            left
            rw [pow_zero, Ideal.one_eq_top]
            trivial
          | succ N ihN =>
            intro u v huv a b hab
            cases a with
            | zero =>
              left
              rw [pow_zero, Ideal.one_eq_top]
              trivial
            | succ a' =>
              cases b with
              | zero =>
                right
                rw [pow_zero, Ideal.one_eq_top]
                trivial
              | succ b' =>
                have huv_JA : u * v ∈ J_A := by
                  rw [huv]
                  exact J_A.zero_mem
                rcases hPrime_JA.mem_or_mem huv_JA with huJ | hvJ
                · rw [Ideal.mem_span_singleton] at huJ
                  obtain ⟨u', rfl⟩ := huJ
                  have hu'v : u' * v = 0 := by
                    apply hReg_tbar
                    calc tbar₀ * (u' * v) = (tbar₀ * u') * v := (mul_assoc _ _ _).symm
                      _ = 0 := huv
                      _ = tbar₀ * 0 := (mul_zero _).symm
                  rcases ihN u' v hu'v a' (b' + 1) (by omega) with hu' | hv'
                  · left
                    rw [pow_succ']
                    exact Submodule.mul_mem_mul (Ideal.subset_span rfl) hu'
                  · exact Or.inr hv'
                · rw [Ideal.mem_span_singleton] at hvJ
                  obtain ⟨v', rfl⟩ := hvJ
                  have huv' : u * v' = 0 := by
                    apply hReg_tbar
                    calc tbar₀ * (u * v') = u * (tbar₀ * v') := by ring
                      _ = 0 := huv
                      _ = tbar₀ * 0 := (mul_zero _).symm
                  rcases ihN u v' huv' (a' + 1) b' (by omega) with hu' | hv'
                  · exact Or.inl hu'
                  · right
                    rw [pow_succ']
                    exact Submodule.mul_mem_mul (Ideal.subset_span rfl) hv'
        have _ : NoZeroDivisors A := ⟨fun {u v} huv => by
          by_contra h_both
          rw [not_or] at h_both
          obtain ⟨hu0, hv0⟩ := h_both
          have hu_not : ¬ ∀ a : ℕ, u ∈ J_A ^ a := by
            intro hall
            exact hu0 (Ideal.mem_bot.mp (hKrull ▸ Ideal.mem_iInf.mpr hall))
          have hv_not : ¬ ∀ b : ℕ, v ∈ J_A ^ b := by
            intro hall
            exact hv0 (Ideal.mem_bot.mp (hKrull ▸ Ideal.mem_iInf.mpr hall))
          rw [Classical.not_forall] at hu_not hv_not
          obtain ⟨a, ha⟩ := hu_not
          obtain ⟨b, hb⟩ := hv_not
          rcases hDiv (a + b) u v huv a b rfl with ha' | hb'
          · exact ha ha'
          · exact hb hb'⟩
        exact NoZeroDivisors.to_isDomain A
    intro n R' _ ψ v₀ hEt
    obtain ⟨m, hm_max, hv₀_le⟩ := Ideal.exists_le_maximal v₀.asIdeal v₀.isPrime.ne_top
    have _ : m.IsMaximal := hm_max
    have _ : m.IsPrime := Ideal.IsMaximal.isPrime hm_max
    have hDom_m : IsDomain (Localization.AtPrime m) := hAtMaxDom n R' ψ m hEt
    let _ : Algebra (MvPolynomial (Fin n) k) R' := ψ.toAlgebra
    have _ : Algebra.Etale (MvPolynomial (Fin n) k) R' := hEt
    have _ : IsNoetherianRing R' := Algebra.FiniteType.isNoetherianRing (MvPolynomial (Fin n) k) R'
    let A := Localization.AtPrime m
    let K_ker : Ideal R' := RingHom.ker (algebraMap R' A)
    obtain ⟨G, hG⟩ := IsNoetherian.noetherian K_ker
    have h_ann : ∀ z : ↥G, ∃ s : m.primeCompl, s.1 * z.1 = 0 := by
      intro z
      have hz : z.1 ∈ K_ker := hG ▸ Ideal.subset_span z.2
      rw [RingHom.mem_ker, ← map_zero (algebraMap R' A)] at hz
      obtain ⟨s, hs⟩ := IsLocalization.exists_of_eq (M := m.primeCompl) hz
      exact ⟨s, by simpa using hs⟩
    choose s_fn hs_fn using h_ann
    let u_sub : m.primeCompl := ∏ z ∈ G.attach, s_fn z
    let u : R' := u_sub.1
    have hu_not_m : u ∉ m := u_sub.2
    have hu_not_v₀ : u ∉ v₀.asIdeal := fun hu => hu_not_m (hv₀_le hu)
    have hu_kill : ∀ x ∈ K_ker, u * x = 0 := by
      intro x hx
      rw [← hG] at hx
      refine Submodule.span_induction (fun y hy => ?_) (mul_zero u)
        (fun x₁ x₂ _ _ hx₁ hx₂ => by rw [mul_add, hx₁, hx₂, add_zero])
        (fun r x₁ _ hx₁ => by rw [smul_eq_mul, ← mul_left_comm, hx₁, mul_zero]) hx
      have h_dvd : s_fn ⟨y, hy⟩ ∣ u_sub := Finset.dvd_prod_of_mem s_fn (Finset.mem_attach G ⟨y, hy⟩)
      obtain ⟨q_sub, hq_sub⟩ := h_dvd
      have hu_eq : u = q_sub.1 * (s_fn ⟨y, hy⟩).1 := by
        simpa [u, mul_comm] using congrArg Subtype.val hq_sub
      rw [hu_eq, mul_assoc, hs_fn ⟨y, hy⟩, mul_zero]
    have hu_unit_A : IsUnit (algebraMap R' A u) := IsLocalization.map_units A u_sub
    let ι_u : Localization.Away u →+* A := IsLocalization.Away.lift u hu_unit_A
    have hInj_u : Function.Injective ι_u := by
      rw [injective_iff_map_eq_zero]
      intro w hw
      obtain ⟨⟨x, ⟨_, e_pow, rfl⟩⟩, hwx⟩ := IsLocalization.surj (Submonoid.powers u) w
      have hx_A : algebraMap R' A x = 0 := by
        have h1 := congrArg ι_u hwx
        rw [map_mul, hw, zero_mul] at h1
        simpa [ι_u, IsLocalization.Away.lift_eq] using h1.symm
      have hux : u * x = 0 := hu_kill x hx_A
      have hu_unit_loc : IsUnit (algebraMap R' (Localization.Away u) u) :=
        IsLocalization.Away.algebraMap_isUnit u
      have hx_loc : algebraMap R' (Localization.Away u) x = 0 := by
        apply hu_unit_loc.mul_left_cancel
        rw [← map_mul, hux, map_zero, mul_zero]
      have hpow_unit : IsUnit (algebraMap R' (Localization.Away u) (u ^ e_pow)) := by
        rw [map_pow]
        exact hu_unit_loc.pow e_pow
      apply hpow_unit.mul_right_cancel
      rw [hwx, hx_loc, zero_mul]
    exact ⟨u, hu_not_v₀, @Function.Injective.isDomain A (Localization.Away u) _ hDom_m _ _ _ _ ι_u hInj_u⟩

  
  have hEtaleReduced : ∀ (A₀ B₀ : Type u) [CommRing A₀] [IsReduced A₀] [IsNoetherianRing A₀]
      [CommRing B₀] [Algebra A₀ B₀] [Algebra.Etale A₀ B₀],
      IsReduced B₀ := by
    intro A₀ B₀ _ _ _ _ _ _
    let _ := Classical.propDecidable
    let F : Finset (Ideal A₀) := (minimalPrimes.finite_of_isNoetherianRing A₀).toFinset
    have hp_prime : ∀ p : ↥F, p.1.IsPrime := fun p =>
      ((Set.Finite.mem_toFinset _).mp p.2).1.1
    have _ : ∀ p : ↥F, (p.1).IsPrime := hp_prime
    have _ : ∀ p : ↥F, IsDomain (A₀ ⧸ p.1) := fun p => Ideal.Quotient.isDomain p.1
    let K_p : ↥F → Type u := fun p => FractionRing (A₀ ⧸ p.1)
    let ι : A₀ →ₗ[A₀] (∀ p : ↥F, K_p p) :=
      LinearMap.pi fun p => Algebra.linearMap A₀ (K_p p)
    have hInj_ι : Function.Injective ι := by
      rw [injective_iff_map_eq_zero]
      intro a ha
      have ha_nil : a ∈ nilradical A₀ := by
        rw [nilradical_eq_sInf, Ideal.mem_sInf]
        intro J hJ_prime
        have _ : J.IsPrime := hJ_prime
        obtain ⟨q, hq_min, hq_le⟩ := Ideal.exists_minimalPrimes_le (bot_le : (⊥ : Ideal A₀) ≤ J)
        have hqF : q ∈ F := (Set.Finite.mem_toFinset _).mpr hq_min
        have ha_q : algebraMap A₀ (K_p ⟨q, hqF⟩) a = 0 := congrFun ha ⟨q, hqF⟩
        rw [IsScalarTower.algebraMap_apply A₀ (A₀ ⧸ q) (K_p ⟨q, hqF⟩)] at ha_q
        have hmk0 : Ideal.Quotient.mk q a = 0 :=
          IsFractionRing.injective (A₀ ⧸ q) (K_p ⟨q, hqF⟩) (by simpa using ha_q)
        exact hq_le (Ideal.Quotient.eq_zero_iff_mem.mp hmk0)
      rwa [nilradical_eq_zero, Ideal.zero_eq_bot, Ideal.mem_bot] at ha_nil
    have _ : Module.Flat A₀ B₀ := Algebra.Smooth.flat A₀ B₀
    have hInj_lT : Function.Injective (LinearMap.lTensor B₀ ι) :=
      Module.Flat.lTensor_preserves_injective_linearMap ι hInj_ι
    let e_pi := TensorProduct.piRight A₀ A₀ B₀ K_p
    let ρ : B₀ →+* (∀ p : ↥F, TensorProduct A₀ B₀ (K_p p)) :=
      RingHom.pi fun p => (Algebra.TensorProduct.includeLeft : B₀ →ₐ[A₀] TensorProduct A₀ B₀ (K_p p)).toRingHom
    have hρ_eq : ∀ b : B₀, ρ b = e_pi (LinearMap.lTensor B₀ ι ((TensorProduct.rid A₀ B₀).symm b)) := by
      intro b
      ext p
      simp [e_pi, TensorProduct.piRight_apply, ι, ρ, RingHom.pi_apply]
    have hInj_ρ : Function.Injective ρ := by
      intro b₁ b₂ hb
      rw [hρ_eq b₁, hρ_eq b₂] at hb
      exact (TensorProduct.rid A₀ B₀).symm.injective (hInj_lT (e_pi.injective hb))
    have hRed_factor : ∀ p : ↥F, IsReduced (TensorProduct A₀ B₀ (K_p p)) := by
      intro p
      let _ : Field (K_p p) := inferInstance
      have _ : Algebra.Etale (K_p p) (TensorProduct A₀ (K_p p) B₀) :=
        Algebra.Etale.baseChange A₀ B₀ (K_p p)
      have _ : Algebra.EssFiniteType (K_p p) (TensorProduct A₀ (K_p p) B₀) :=
        Algebra.EssFiniteType.of_finiteType (K_p p) (TensorProduct A₀ (K_p p) B₀)
      have _ : IsReduced (TensorProduct A₀ (K_p p) B₀) :=
        Algebra.FormallyUnramified.isReduced_of_field (K_p p) (TensorProduct A₀ (K_p p) B₀)
      let e_comm := (Algebra.TensorProduct.comm A₀ (K_p p) B₀).toRingEquiv
      exact isReduced_of_injective e_comm.symm.toRingHom e_comm.symm.injective
    have _ : ∀ p : ↥F, IsReduced (TensorProduct A₀ B₀ (K_p p)) := hRed_factor
    exact isReduced_of_injective ρ hInj_ρ

  have hEtaleRadicalIdealEqSpan : ∀ (m : ℕ) (R₁ B' : Type u) [CommRing R₁] [CommRing B']
      (θ : MvPolynomial (Fin (m + 1)) k →+* R₁)
      (I : Ideal R₁)
      (φ : R₁ →+* B')
      (ψ_et : MvPolynomial (Fin (m + 1)) k →+* B')
      (j₀ : Fin (m + 1)),
      θ.Etale →
      I.IsRadical →
      φ.Etale →
      ψ_et.Etale →
      ({q : PrimeSpectrum B' | I ≤ q.asIdeal.comap φ} =
        {q : PrimeSpectrum B' | ψ_et (MvPolynomial.X j₀) ∈ q.asIdeal}) →
      Ideal.map φ I = Ideal.span {ψ_et (MvPolynomial.X j₀)} := by
    intro m R₁ B' _ _ θ I φ ψ_et j₀ hEt_θ hRad_I hEt_φ hEt_ψ hZero
    have hRad_lhs : (Ideal.map φ I).IsRadical := by
      let _ : Algebra (MvPolynomial (Fin (m + 1)) k) R₁ := θ.toAlgebra
      have _ : Algebra.Etale (MvPolynomial (Fin (m + 1)) k) R₁ := hEt_θ
      have _ : IsNoetherianRing R₁ :=
        Algebra.FiniteType.isNoetherianRing (MvPolynomial (Fin (m + 1)) k) R₁
      have _ : IsNoetherianRing (R₁ ⧸ I) := Ideal.Quotient.isNoetherianRing I
      have _ : IsReduced (R₁ ⧸ I) := (Ideal.isRadical_iff_quotient_reduced I).mp hRad_I
      let _ : Algebra R₁ B' := φ.toAlgebra
      have _ : Algebra.Etale R₁ B' := hEt_φ
      obtain ⟨φ_q, hEt_q⟩ := hEtaleQuotBaseChange R₁ B' I
      let _ : Algebra (R₁ ⧸ I) (B' ⧸ Ideal.map φ I) := φ_q.toAlgebra
      have _ : Algebra.Etale (R₁ ⧸ I) (B' ⧸ Ideal.map φ I) := hEt_q
      have _ : IsReduced (B' ⧸ Ideal.map φ I) :=
        hEtaleReduced (R₁ ⧸ I) (B' ⧸ Ideal.map φ I)
      exact (Ideal.isRadical_iff_quotient_reduced (Ideal.map φ I)).mpr inferInstance
    have hRad_rhs : (Ideal.span ({ψ_et (MvPolynomial.X j₀)} : Set B')).IsRadical := by
      obtain ⟨ψ_bar, hEt_bar⟩ := hCoordQuotEtale m B' ψ_et j₀ hEt_ψ
      let _ : Algebra (MvPolynomial (Fin m) k) (B' ⧸ Ideal.span ({ψ_et (MvPolynomial.X j₀)} : Set B')) :=
        ψ_bar.toAlgebra
      have _ : Algebra.Etale (MvPolynomial (Fin m) k)
          (B' ⧸ Ideal.span ({ψ_et (MvPolynomial.X j₀)} : Set B')) := hEt_bar
      have _ : _root_.IsReduced (MvPolynomial (Fin m) k) := hRed_MvPoly m
      have _ : _root_.IsReduced (B' ⧸ Ideal.span ({ψ_et (MvPolynomial.X j₀)} : Set B')) :=
        hEtaleReduced (MvPolynomial (Fin m) k) _
      exact (Ideal.isRadical_iff_quotient_reduced _).mpr inferInstance
    have hZL : PrimeSpectrum.zeroLocus (Ideal.map φ I : Set B') =
        PrimeSpectrum.zeroLocus (Ideal.span ({ψ_et (MvPolynomial.X j₀)} : Set B') : Set B') := by
      ext q
      simp only [PrimeSpectrum.mem_zeroLocus, SetLike.coe_subset_coe, Ideal.map_le_iff_le_comap,
        Ideal.span_singleton_le_iff_mem]
      exact Set.ext_iff.mp hZero q
    have hRadEq := PrimeSpectrum.zeroLocus_eq_iff.mp hZL
    rwa [hRad_lhs.radical, hRad_rhs.radical] at hRadEq

  
  have hQ0IsMaximal : ∀ (d : ℕ) (R₁ B' : Type u) [CommRing R₁] [CommRing B']
      [Algebra k R₁] [Algebra (MvPolynomial (Fin d) k) R₁]
      [IsScalarTower k (MvPolynomial (Fin d) k) R₁]
      [Algebra.Etale (MvPolynomial (Fin d) k) R₁]
      [Algebra R₁ B'] [Algebra.Etale R₁ B']
      (q₀ : Ideal B') [q₀.IsPrime],
      (∀ b : Fin d,
        algebraMap R₁ B' (algebraMap (MvPolynomial (Fin d) k) R₁ (MvPolynomial.X b)) ∈ q₀) →
      q₀.IsMaximal := by
    intro d R₁ B' _ _ _ _ _ _ _ _ q₀ _ hX_q₀
    let P_d := MvPolynomial (Fin d) k
    let D := B' ⧸ q₀
    have _ : IsDomain D := Ideal.Quotient.isDomain q₀
    let F := FractionRing D
    let _ : Algebra k B' := ((algebraMap R₁ B').comp (algebraMap k R₁)).toAlgebra
    let _ : Algebra P_d B' := ((algebraMap R₁ B').comp (algebraMap P_d R₁)).toAlgebra
    have _ : IsScalarTower k R₁ B' := IsScalarTower.of_algebraMap_eq' rfl
    have _ : IsScalarTower P_d R₁ B' := IsScalarTower.of_algebraMap_eq' rfl
    have _ : IsScalarTower k P_d B' :=
      @IsScalarTower.of_algebraMap_eq k P_d B' _ _ _ _ _ _ fun c => by
        rw [IsScalarTower.algebraMap_apply k R₁ B', IsScalarTower.algebraMap_apply k P_d R₁,
          ← IsScalarTower.algebraMap_apply P_d R₁ B']
    have _ : IsScalarTower k P_d D :=
      @IsScalarTower.of_algebraMap_eq k P_d D _ _ _ _ _ _ fun c => by
        rw [IsScalarTower.algebraMap_apply k B' D, IsScalarTower.algebraMap_apply k P_d B',
          ← IsScalarTower.algebraMap_apply P_d B' D]
    have _ : IsScalarTower k P_d F :=
      @IsScalarTower.of_algebraMap_eq k P_d F _ _ _ _ _ _ fun c => by
        rw [IsScalarTower.algebraMap_apply k D F, IsScalarTower.algebraMap_apply k P_d D,
          ← IsScalarTower.algebraMap_apply P_d D F]
    have _ : Algebra.FormallyUnramified P_d B' :=
      Algebra.FormallyUnramified.comp P_d R₁ B'
    have _ : Algebra.FormallyUnramified B' D :=
      Algebra.FormallyUnramified.quotient q₀
    have _ : Algebra.FormallyUnramified P_d D :=
      Algebra.FormallyUnramified.comp P_d B' D
    have _ : Algebra.FormallyUnramified D F :=
      Algebra.FormallyUnramified.of_isLocalization (nonZeroDivisors D)
    have _ : Algebra.FormallyUnramified P_d F :=
      Algebra.FormallyUnramified.comp P_d D F
    have _ : Algebra.FiniteType k R₁ :=
      Algebra.FiniteType.trans (S := P_d) inferInstance inferInstance
    have _ : Algebra.FiniteType k B' :=
      Algebra.FiniteType.trans (S := R₁) inferInstance inferInstance
    have _ : Algebra.FiniteType B' D :=
      Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ B' q₀) Ideal.Quotient.mk_surjective
    have _ : Algebra.FiniteType k D :=
      Algebra.FiniteType.trans (S := B') inferInstance inferInstance
    have _ : Algebra.EssFiniteType k D := Algebra.EssFiniteType.of_finiteType k D
    have _ : Algebra.EssFiniteType k F :=
      Algebra.instEssFiniteTypeLocalization k D (nonZeroDivisors D)
    have hX_F : ∀ b : Fin d, algebraMap P_d F (MvPolynomial.X b) = 0 := by
      intro b
      rw [IsScalarTower.algebraMap_apply P_d D F, IsScalarTower.algebraMap_apply P_d B' D,
        IsScalarTower.algebraMap_apply P_d R₁ B']
      have h0 : Ideal.Quotient.mk q₀ (algebraMap R₁ B' (algebraMap P_d R₁ (MvPolynomial.X b))) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (hX_q₀ b)
      change algebraMap D F (Ideal.Quotient.mk q₀ _) = 0
      rw [h0, map_zero]
    have _ : Algebra.FormallyUnramified k F :=
      hUnramifiedOfCoordsZero d F hX_F
    have hBij_F : Function.Bijective (algebraMap k F) :=
      Algebra.FormallyUnramified.bijective_of_isAlgClosed_of_isLocalRing k F
    have hSurj_D : Function.Surjective (algebraMap k D) := by
      intro x
      obtain ⟨c, hc⟩ := hBij_F.2 (algebraMap D F x)
      rw [IsScalarTower.algebraMap_apply k D F] at hc
      exact ⟨c, IsFractionRing.injective D F hc⟩
    let e_kD : k ≃+* D :=
      RingEquiv.ofBijective (algebraMap k D) ⟨(algebraMap k D).injective, hSurj_D⟩
    exact Ideal.Quotient.maximal_of_isField q₀ (e_kD.symm.toMulEquiv.isField (Field.toIsField k))

  have hKaehlerCoordDeriv : ∀ (d : ℕ) (B' : Type u) [CommRing B']
      [Algebra k B'] [Algebra (MvPolynomial (Fin d) k) B']
      [IsScalarTower k (MvPolynomial (Fin d) k) B']
      [Algebra.Etale (MvPolynomial (Fin d) k) B']
      (q₀ : Ideal B') [q₀.IsMaximal],
      ∃ δ : Fin d → B' → (B' ⧸ q₀),
        (∀ j : Fin d, δ j 0 = 0) ∧
        (∀ (j : Fin d) (x y : B'), δ j (x + y) = δ j x + δ j y) ∧
        (∀ (j : Fin d) (x y : B'), δ j (x - y) = δ j x - δ j y) ∧
        (∀ (j : Fin d) (s : Finset (Fin d)) (f : Fin d → B'),
          δ j (∑ b ∈ s, f b) = ∑ b ∈ s, δ j (f b)) ∧
        (∀ (j : Fin d) (a : k) (x : B'),
          δ j (algebraMap k B' a * x) =
            Ideal.Quotient.mk q₀ (algebraMap k B' a) * δ j x) ∧
        (∀ (j : Fin d) (x y : B'),
          δ j (x * y) =
            Ideal.Quotient.mk q₀ x * δ j y + Ideal.Quotient.mk q₀ y * δ j x) ∧
        (∀ (j : Fin d) (z : B'), z ∈ q₀ ^ 2 → δ j z = 0) ∧
        (∀ j j' : Fin d,
          δ j (algebraMap (MvPolynomial (Fin d) k) B' (MvPolynomial.X j')) =
            if j' = j then 1 else 0) := by
    intro d B' _ _ _ _ _ q₀ _
    let P_d := MvPolynomial (Fin d) k
    let β_P : Module.Basis (Fin d) P_d (KaehlerDifferential k P_d) :=
      KaehlerDifferential.mvPolynomialBasis k (Fin d)
    let e_K : TensorProduct P_d B' (KaehlerDifferential k P_d) ≃ₗ[B'] KaehlerDifferential k B' :=
      KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale k P_d B'
    let β_B : Module.Basis (Fin d) B' (KaehlerDifferential k B') :=
      (β_P.baseChange B').map e_K
    let coord : Fin d → (KaehlerDifferential k B' →ₗ[B'] B') :=
      fun j => (Finsupp.lapply j).comp β_B.repr.toLinearMap
    let δ : Fin d → B' → (B' ⧸ q₀) :=
      fun j x => Ideal.Quotient.mk q₀ (coord j (KaehlerDifferential.D k B' x))
    have hβ_P_apply : ∀ j' : Fin d, β_P j' = KaehlerDifferential.D k P_d (MvPolynomial.X j') := by
      intro j'
      apply β_P.repr.injective
      ext j
      rw [β_P.repr_self, Finsupp.single_apply]
      dsimp only [β_P]
      rw [KaehlerDifferential.mvPolynomialBasis_repr_apply, MvPolynomial.pderiv_X, Pi.single_apply]
    have hβ_B_apply : ∀ j' : Fin d,
        β_B j' = KaehlerDifferential.D k B' (algebraMap P_d B' (MvPolynomial.X j')) := by
      intro j'
      apply e_K.symm.injective
      dsimp only [β_B, e_K]
      rw [Module.Basis.map_apply, LinearEquiv.symm_apply_apply, Module.Basis.baseChange_apply,
        hβ_P_apply j', KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale_symm_D_algebraMap]
    have hδ_zero : ∀ j : Fin d, δ j 0 = 0 := fun j => by simp [δ]
    have hδ_add : ∀ (j : Fin d) (x y : B'), δ j (x + y) = δ j x + δ j y := fun j x y => by
      simp [δ, map_add]
    have hδ_sub : ∀ (j : Fin d) (x y : B'), δ j (x - y) = δ j x - δ j y := fun j x y => by
      simp [δ, map_sub]
    have hδ_sum : ∀ (j : Fin d) (s : Finset (Fin d)) (f : Fin d → B'),
        δ j (∑ b ∈ s, f b) = ∑ b ∈ s, δ j (f b) := by
      intro j s f
      simp [δ, map_sum]
    have hδ_smul : ∀ (j : Fin d) (a : k) (x : B'),
        δ j (algebraMap k B' a * x) =
          Ideal.Quotient.mk q₀ (algebraMap k B' a) * δ j x := by
      intro j a x
      dsimp only [δ]
      have h_sm : algebraMap k B' a * x = algebraMap k B' a • x := (smul_eq_mul _ _).symm
      have h_smk : algebraMap k B' a • x = a • x := algebraMap_smul B' a x
      rw [h_sm, h_smk, (KaehlerDifferential.D k B').map_smul,
        ← algebraMap_smul B' a (KaehlerDifferential.D k B' x),
        LinearMap.map_smul, smul_eq_mul, map_mul]
    have hδ_mul : ∀ (j : Fin d) (x y : B'),
        δ j (x * y) =
          Ideal.Quotient.mk q₀ x * δ j y + Ideal.Quotient.mk q₀ y * δ j x := by
      intro j x y
      dsimp only [δ]
      rw [(KaehlerDifferential.D k B').leibniz, map_add, LinearMap.map_smul, LinearMap.map_smul,
        smul_eq_mul, smul_eq_mul, map_add, map_mul, map_mul]
    have hδ_sq : ∀ (j : Fin d) (z : B'), z ∈ q₀ ^ 2 → δ j z = 0 := by
      intro j z hz
      rw [sq] at hz
      refine Submodule.mul_induction_on hz (fun x hx y hy => ?_) (fun z₁ z₂ hz₁ hz₂ => by
        rw [hδ_add, hz₁, hz₂, add_zero])
      rw [hδ_mul, Ideal.Quotient.eq_zero_iff_mem.mpr hx, Ideal.Quotient.eq_zero_iff_mem.mpr hy,
        zero_mul, zero_mul, add_zero]
    have hδ_X : ∀ j j' : Fin d,
        δ j (algebraMap P_d B' (MvPolynomial.X j')) = if j' = j then 1 else 0 := by
      intro j j'
      dsimp only [δ, coord]
      rw [← hβ_B_apply j', LinearMap.comp_apply, LinearEquiv.coe_toLinearMap, β_B.repr_self,
        Finsupp.lapply_apply, Finsupp.single_apply]
      split_ifs <;> simp
    exact ⟨δ, hδ_zero, hδ_add, hδ_sub, hδ_sum, hδ_smul, hδ_mul, hδ_sq, hδ_X⟩

  have hLocalRingHomFaithfullyFlat : ∀ (R₁ B' : Type u) [CommRing R₁] [CommRing B']
      (m_max : Ideal R₁) [m_max.IsPrime]
      (q₀ : Ideal B') [q₀.IsPrime]
      (φ : R₁ →+* B') (hm_eq : m_max = q₀.comap φ),
      φ.Etale →
      ∀ (I₁ I₂ : Ideal (Localization.AtPrime m_max)),
        Ideal.map (Localization.localRingHom m_max q₀ φ hm_eq) I₁ =
          Ideal.map (Localization.localRingHom m_max q₀ φ hm_eq) I₂ →
        I₁ = I₂ := by
    intro R₁ B' _ _ m_max _ q₀ _ φ hm_eq hEt_φ I₁ I₂ hMapEq
    let A := Localization.AtPrime m_max
    let B := Localization.AtPrime q₀
    let φ_loc : A →+* B := Localization.localRingHom m_max q₀ φ hm_eq
    have _ : IsLocalHom φ_loc := Localization.isLocalHom_localRingHom m_max q₀ φ hm_eq
    let _ : Algebra R₁ B' := φ.toAlgebra
    have _ : Algebra.Etale R₁ B' := hEt_φ
    have _ : Module.Flat R₁ B' := Algebra.Smooth.flat R₁ B'
    have _ : Module.Flat B' B := IsLocalization.flat B q₀.primeCompl
    have _ : Module.Flat R₁ B := Module.Flat.trans R₁ B' B
    let _ : Algebra A B := φ_loc.toAlgebra
    have _ : IsScalarTower R₁ A B :=
      @IsScalarTower.of_algebraMap_eq R₁ A B _ _ _ _ _ _ fun r => by
        rw [IsScalarTower.algebraMap_apply R₁ B' B r]
        exact (Localization.localRingHom_to_map m_max q₀ φ hm_eq r).symm
    have hLocMod : IsLocalizedModule m_max.primeCompl (LinearMap.id : B →ₗ[R₁] B) := by
      refine IsLocalizedModule.mk (fun s => ?_) (fun y => ⟨(y, 1), one_smul _ y⟩)
        (fun {x₁ x₂} h => ⟨1, by simpa using h⟩)
      have hs_not : φ s.1 ∉ q₀ := by
        intro hmem
        have : s.1 ∈ q₀.comap φ := hmem
        rw [← hm_eq] at this
        exact s.2 this
      have hu : IsUnit (algebraMap B' B (φ s.1)) :=
        IsLocalization.map_units B (⟨φ s.1, hs_not⟩ : q₀.primeCompl)
      obtain ⟨u_b, hu_b⟩ := hu
      let f_inv : Module.End R₁ B :=
        { toFun := fun b => ↑u_b⁻¹ * b
          map_add' := fun x y => mul_add _ x y
          map_smul' := fun r x => by
            simp only [RingHom.id_apply, Algebra.smul_def]
            ring }
      refine isUnit_iff_exists.mpr ⟨f_inv, ?_, ?_⟩
      · ext b
        change s.1 • (↑u_b⁻¹ * b) = b
        rw [Algebra.smul_def, IsScalarTower.algebraMap_apply R₁ B' B]
        change algebraMap B' B (φ s.1) * (↑u_b⁻¹ * b) = b
        rw [← hu_b, ← mul_assoc, Units.mul_inv, one_mul]
      · ext b
        change ↑u_b⁻¹ * (s.1 • b) = b
        rw [Algebra.smul_def, IsScalarTower.algebraMap_apply R₁ B' B]
        change ↑u_b⁻¹ * (algebraMap B' B (φ s.1) * b) = b
        rw [← hu_b, ← mul_assoc, Units.inv_mul, one_mul]
    have _ : Module.Flat A B :=
      @Module.Flat.of_isLocalizedModule R₁ B B A _ _ _ _ _ _ _ _ _ _ m_max.primeCompl _
        (LinearMap.id : B →ₗ[R₁] B) hLocMod
    have _ : Module.FaithfullyFlat A B :=
      Module.FaithfullyFlat.of_flat_of_isLocalHom
    have h₁ : Ideal.comap φ_loc (Ideal.map φ_loc I₁) = I₁ :=
      Ideal.comap_map_eq_self_of_faithfullyFlat I₁
    have h₂ : Ideal.comap φ_loc (Ideal.map φ_loc I₂) = I₂ :=
      Ideal.comap_map_eq_self_of_faithfullyFlat I₂
    rw [← h₁, hMapEq, h₂]

  have hCruxPrincipalAndLinIndep : ∀ (d s₀ : ℕ)
      (R₁ B' : Type u) [CommRing R₁] [CommRing B']
      (θ' : MvPolynomial (Fin d) k →+* R₁)
      (m_max : Ideal R₁) [m_max.IsMaximal]
      (P : Fin s₀ → Ideal R₁)
      (φ : R₁ →+* B')
      (q₀ : PrimeSpectrum B')
      (ψ_et : MvPolynomial (Fin d) k →+* B')
      (α₀ : Fin s₀ → Fin d),
      θ'.Etale →
      (∀ b : Fin d, θ' (MvPolynomial.X b) ∈ m_max) →
      (∀ c : Fin s₀, P c ≤ m_max) →
      φ.Etale →
      m_max ≤ q₀.asIdeal.comap φ →
      ψ_et.Etale →
      ψ_et.comp MvPolynomial.C = φ.comp (θ'.comp MvPolynomial.C) →
      Function.Injective α₀ →
      (∀ c : Fin s₀, ψ_et (MvPolynomial.X (α₀ c)) ∈ q₀.asIdeal) →
      (∀ c : Fin s₀, Ideal.map φ (P c) = Ideal.span {ψ_et (MvPolynomial.X (α₀ c))}) →
      (∀ f ∈ m_max, ∃ v : Fin d → k,
        f - ∑ b : Fin d, θ' (MvPolynomial.C (v b) * MvPolynomial.X b) ∈ m_max ^ 2) →
      ∃ (g_raw : Fin s₀ → R₁)
        (v : Fin s₀ → (Fin d → k))
        (s_ideal : R₁),
        (∀ c : Fin s₀, g_raw c ∈ P c) ∧
        LinearIndependent k v ∧
        s_ideal ∉ m_max ∧
        (∀ c : Fin s₀, ∀ x ∈ P c, s_ideal * x ∈ Ideal.span {g_raw c}) ∧
        (∀ c : Fin s₀,
          g_raw c - ∑ b : Fin d, θ' (MvPolynomial.C (v c b) * MvPolynomial.X b) ∈ m_max ^ 2) := by
    intro d s₀ R₁ B' _ _ θ' m_max _ P φ q₀ ψ_et α₀ hEt_θ' hX_θ' hP_le_m hEt_φ hm_le_q₀
      hEt_ψ hC_eq hInj_α₀ hψ_q₀ hMap_Pc hApprox
    have _ : m_max.IsPrime := Ideal.IsMaximal.isPrime inferInstance
    have _ : q₀.asIdeal.IsPrime := q₀.isPrime
    have hm_eq : m_max = q₀.asIdeal.comap φ :=
      Ideal.IsMaximal.eq_of_le inferInstance (Ideal.IsPrime.ne_top inferInstance) hm_le_q₀
    have hMax_q₀ : q₀.asIdeal.IsMaximal := by
      let _ : Algebra k R₁ := (θ'.comp MvPolynomial.C).toAlgebra
      let _ : Algebra (MvPolynomial (Fin d) k) R₁ := θ'.toAlgebra
      have _ : IsScalarTower k (MvPolynomial (Fin d) k) R₁ := IsScalarTower.of_algebraMap_eq' rfl
      have _ : Algebra.Etale (MvPolynomial (Fin d) k) R₁ := hEt_θ'
      let _ : Algebra R₁ B' := φ.toAlgebra
      have _ : Algebra.Etale R₁ B' := hEt_φ
      exact hQ0IsMaximal d R₁ B' q₀.asIdeal fun b => hm_le_q₀ (hX_θ' b)
    have _ : q₀.asIdeal.IsMaximal := hMax_q₀
    let K_B := B' ⧸ q₀.asIdeal
    let _ : Field K_B := Ideal.Quotient.field q₀.asIdeal
    let q_B : B' →+* K_B := Ideal.Quotient.mk q₀.asIdeal
    have hDerivPkg : ∃ δ : Fin d → B' → K_B,
        (∀ j : Fin d, δ j 0 = 0) ∧
        (∀ (j : Fin d) (x y : B'), δ j (x + y) = δ j x + δ j y) ∧
        (∀ (j : Fin d) (x y : B'), δ j (x - y) = δ j x - δ j y) ∧
        (∀ (j : Fin d) (s : Finset (Fin d)) (f : Fin d → B'),
          δ j (∑ b ∈ s, f b) = ∑ b ∈ s, δ j (f b)) ∧
        (∀ (j : Fin d) (a : k) (x : B'),
          δ j (ψ_et (MvPolynomial.C a) * x) = q_B (ψ_et (MvPolynomial.C a)) * δ j x) ∧
        (∀ (j : Fin d) (x y : B'), δ j (x * y) = q_B x * δ j y + q_B y * δ j x) ∧
        (∀ (j : Fin d) (z : B'), z ∈ q₀.asIdeal ^ 2 → δ j z = 0) ∧
        (∀ j j' : Fin d, δ j (ψ_et (MvPolynomial.X j')) = if j' = j then 1 else 0) := by
      let _ : Algebra k B' := (ψ_et.comp MvPolynomial.C).toAlgebra
      let _ : Algebra (MvPolynomial (Fin d) k) B' := ψ_et.toAlgebra
      have _ : IsScalarTower k (MvPolynomial (Fin d) k) B' := IsScalarTower.of_algebraMap_eq' rfl
      have _ : Algebra.Etale (MvPolynomial (Fin d) k) B' := hEt_ψ
      exact hKaehlerCoordDeriv d B' q₀.asIdeal
    obtain ⟨δ, hδ_zero, hδ_add, hδ_sub, hδ_sum, hδ_smul, hδ_mul, hδ_sq, hδ_X⟩ := hDerivPkg
    have hExists_g : ∀ c : Fin s₀, ∃ g₀ ∈ P c, δ (α₀ c) (φ g₀) ≠ 0 := by
      intro c
      by_contra h_none
      have h_all : ∀ x ∈ P c, δ (α₀ c) (φ x) = 0 := fun x hx =>
        Classical.not_not.mp fun hne => h_none ⟨x, hx, hne⟩
      let L_c : Ideal B' :=
        { carrier := {w : B' | w ∈ q₀.asIdeal ∧ δ (α₀ c) w = 0}
          zero_mem' := ⟨q₀.asIdeal.zero_mem, hδ_zero (α₀ c)⟩
          add_mem' := fun {x y} hx hy =>
            ⟨q₀.asIdeal.add_mem hx.1 hy.1, by rw [hδ_add, hx.2, hy.2, add_zero]⟩
          smul_mem' := fun b {w} hw =>
            ⟨q₀.asIdeal.mul_mem_left b hw.1, by
              rw [smul_eq_mul, hδ_mul, Ideal.Quotient.eq_zero_iff_mem.mpr hw.1, hw.2,
                mul_zero, zero_mul, add_zero]⟩ }
      have hPc_le_Lc : P c ≤ L_c.comap φ := fun x hx =>
        ⟨hm_le_q₀ (hP_le_m c hx), h_all x hx⟩
      have hMap_le_Lc : Ideal.map φ (P c) ≤ L_c := Ideal.map_le_iff_le_comap.mpr hPc_le_Lc
      rw [hMap_Pc c, Ideal.span_singleton_le_iff_mem] at hMap_le_Lc
      have h1_zero : δ (α₀ c) (ψ_et (MvPolynomial.X (α₀ c))) = 0 := hMap_le_Lc.2
      rw [hδ_X (α₀ c) (α₀ c), ite_eq_left_iff.mpr fun h => absurd rfl h] at h1_zero
      exact one_ne_zero h1_zero
    choose g_raw hg_raw_P hδ_g_ne using hExists_g
    have hFactor : ∀ c : Fin s₀, ∃ u' : B', φ (g_raw c) = ψ_et (MvPolynomial.X (α₀ c)) * u' := by
      intro c
      have hmem : φ (g_raw c) ∈ Ideal.span ({ψ_et (MvPolynomial.X (α₀ c))} : Set B') := by
        rw [← hMap_Pc c]
        exact Ideal.mem_map_of_mem φ (hg_raw_P c)
      exact Ideal.mem_span_singleton.mp hmem
    choose u' hu' using hFactor
    have hδ_g_eval : ∀ (c : Fin s₀) (j : Fin d),
        δ j (φ (g_raw c)) = if α₀ c = j then q_B (u' c) else 0 := by
      intro c j
      rw [hu' c, hδ_mul, Ideal.Quotient.eq_zero_iff_mem.mpr (hψ_q₀ c), zero_mul, zero_add, hδ_X]
      split_ifs <;> ring
    have hqB_u'_ne : ∀ c : Fin s₀, q_B (u' c) ≠ 0 := by
      intro c
      have h1 := hδ_g_eval c (α₀ c)
      simp only [↓reduceIte] at h1
      rw [← h1]
      exact hδ_g_ne c
    have hu'_notMem : ∀ c : Fin s₀, u' c ∉ q₀.asIdeal := fun c hmem =>
      hqB_u'_ne c (Ideal.Quotient.eq_zero_iff_mem.mpr hmem)
    let A := Localization.AtPrime m_max
    let B := Localization.AtPrime q₀.asIdeal
    let φ_loc : A →+* B := Localization.localRingHom m_max q₀.asIdeal φ hm_eq
    have hSpanEq_A : ∀ c : Fin s₀,
        Ideal.span ({algebraMap R₁ A (g_raw c)} : Set A) =
          Ideal.map (algebraMap R₁ A) (P c) := by
      intro c
      apply hLocalRingHomFaithfullyFlat R₁ B' m_max q₀.asIdeal φ hm_eq hEt_φ
      have h_lhs : Ideal.map φ_loc (Ideal.span ({algebraMap R₁ A (g_raw c)} : Set A)) =
          Ideal.span ({algebraMap B' B (ψ_et (MvPolynomial.X (α₀ c)))} : Set B) := by
        rw [Ideal.map_span, Set.image_singleton, Localization.localRingHom_to_map, hu' c, map_mul]
        have hu_unit : IsUnit (algebraMap B' B (u' c)) :=
          IsLocalization.map_units B (⟨u' c, hu'_notMem c⟩ : q₀.asIdeal.primeCompl)
        exact Ideal.span_singleton_mul_right_unit hu_unit _
      have h_rhs : Ideal.map φ_loc (Ideal.map (algebraMap R₁ A) (P c)) =
          Ideal.span ({algebraMap B' B (ψ_et (MvPolynomial.X (α₀ c)))} : Set B) := by
        rw [Ideal.map_map]
        have h_comp : φ_loc.comp (algebraMap R₁ A) = (algebraMap B' B).comp φ := by
          ext r
          exact Localization.localRingHom_to_map m_max q₀.asIdeal φ hm_eq r
        rw [h_comp, ← Ideal.map_map, hMap_Pc c, Ideal.map_span, Set.image_singleton]
      rw [h_lhs, h_rhs]
    let _ : Algebra (MvPolynomial (Fin d) k) R₁ := θ'.toAlgebra
    have _ : Algebra.Etale (MvPolynomial (Fin d) k) R₁ := hEt_θ'
    have _ : IsNoetherianRing R₁ :=
      Algebra.FiniteType.isNoetherianRing (MvPolynomial (Fin d) k) R₁
    choose G hG using fun c : Fin s₀ => IsNoetherian.noetherian (P c)
    have h_gen_s : ∀ (c : Fin s₀) (z : ↥(G c)),
        ∃ s : m_max.primeCompl, s.1 * z.1 ∈ Ideal.span ({g_raw c} : Set R₁) := by
      intro c z
      have hz_P : z.1 ∈ P c := hG c ▸ Ideal.subset_span z.2
      have hz_A : algebraMap R₁ A z.1 ∈ Ideal.map (algebraMap R₁ A) (Ideal.span ({g_raw c} : Set R₁)) := by
        rw [Ideal.map_span, Set.image_singleton, hSpanEq_A c]
        exact Ideal.mem_map_of_mem _ hz_P
      rw [IsLocalization.mem_map_algebraMap_iff m_max.primeCompl A] at hz_A
      obtain ⟨⟨⟨w, hw⟩, s₁⟩, hs₁⟩ := hz_A
      have hs₁' : algebraMap R₁ A (z.1 * s₁.1) = algebraMap R₁ A w := by
        simpa [map_mul] using hs₁
      obtain ⟨s₂, hs₂⟩ := IsLocalization.exists_of_eq (M := m_max.primeCompl) hs₁'
      refine ⟨s₂ * s₁, ?_⟩
      have h_eq : (s₂ * s₁).1 * z.1 = s₂.1 * w := by
        calc (s₂ * s₁).1 * z.1 = s₂.1 * (z.1 * s₁.1) := by change (s₂.1 * s₁.1) * z.1 = _; ring
          _ = s₂.1 * w := hs₂
      rw [h_eq]
      exact Ideal.mul_mem_left _ s₂.1 hw
    choose s_cz hs_cz using h_gen_s
    let s_sub : m_max.primeCompl := ∏ c : Fin s₀, ∏ z ∈ (G c).attach, s_cz c z
    let s_ideal : R₁ := s_sub.1
    have hs_ideal_notMem : s_ideal ∉ m_max := s_sub.2
    have hSpan_s : ∀ (c : Fin s₀) (x : R₁), x ∈ P c →
        s_ideal * x ∈ Ideal.span ({g_raw c} : Set R₁) := by
      intro c x hx
      rw [← hG c] at hx
      refine Submodule.span_induction (fun y hy => ?_)
        (by rw [mul_zero]; exact Ideal.zero_mem _)
        (fun x₁ x₂ _ _ hx₁ hx₂ => by rw [mul_add]; exact Ideal.add_mem _ hx₁ hx₂)
        (fun r x₁ _ hx₁ => by
          rw [smul_eq_mul, ← mul_left_comm]
          exact Ideal.mul_mem_left _ r hx₁) hx
      have h_dvd₁ : (∏ z ∈ (G c).attach, s_cz c z) ∣ s_sub :=
        Finset.dvd_prod_of_mem _ (Finset.mem_univ c)
      have h_dvd₂ : s_cz c ⟨y, hy⟩ ∣ (∏ z ∈ (G c).attach, s_cz c z) :=
        Finset.dvd_prod_of_mem _ (Finset.mem_attach _ ⟨y, hy⟩)
      obtain ⟨q_sub, hq_sub⟩ := dvd_trans h_dvd₂ h_dvd₁
      have hs_eq : s_ideal = q_sub.1 * (s_cz c ⟨y, hy⟩).1 := by
        simpa [s_ideal, mul_comm] using congrArg Subtype.val hq_sub
      rw [hs_eq, mul_assoc]
      exact Ideal.mul_mem_left _ q_sub.1 (hs_cz c ⟨y, hy⟩)
    choose v hv_cong using fun c : Fin s₀ => hApprox (g_raw c) (hP_le_m c (hg_raw_P c))
    let ι_k : k →+* K_B := q_B.comp (ψ_et.comp MvPolynomial.C)
    have hC_apply : ∀ a : k, φ (θ' (MvPolynomial.C a)) = ψ_et (MvPolynomial.C a) := fun a =>
      (RingHom.congr_fun hC_eq a).symm
    have hδ_lin : ∀ (c : Fin s₀) (j : Fin d),
        (if α₀ c = j then q_B (u' c) else 0) =
          ∑ b : Fin d, ι_k (v c b) * δ j (φ (θ' (MvPolynomial.X b))) := by
      intro c j
      rw [← hδ_g_eval c j]
      let r_c : R₁ := g_raw c - ∑ b : Fin d, θ' (MvPolynomial.C (v c b) * MvPolynomial.X b)
      have hφ_rc : φ r_c ∈ q₀.asIdeal ^ 2 := by
        have h1 : φ r_c ∈ Ideal.map φ (m_max ^ 2) := Ideal.mem_map_of_mem φ (hv_cong c)
        rw [Ideal.map_pow] at h1
        exact Ideal.pow_right_mono (Ideal.map_le_iff_le_comap.mpr hm_le_q₀) 2 h1
      have hδ_rc : δ j (φ r_c) = 0 := hδ_sq j (φ r_c) hφ_rc
      dsimp only [r_c] at hδ_rc
      rw [map_sub, hδ_sub, sub_eq_zero] at hδ_rc
      rw [hδ_rc, map_sum, hδ_sum]
      refine Finset.sum_congr rfl fun b _ => ?_
      rw [map_mul, map_mul, hC_apply (v c b), hδ_smul]
      rfl
    have hLI_v : LinearIndependent k v := by
      rw [Fintype.linearIndependent_iff]
      intro w hw c₀
      have hw_b : ∀ b : Fin d, ∑ c : Fin s₀, w c * v c b = 0 := fun b => by
        simpa [Finset.sum_apply, Pi.smul_apply, smul_eq_mul] using congrFun hw b
      have h_eval : (0 : K_B) = ι_k (w c₀) * q_B (u' c₀) := by
        calc (0 : K_B)
            = ∑ b : Fin d, ι_k (∑ c : Fin s₀, w c * v c b) *
                δ (α₀ c₀) (φ (θ' (MvPolynomial.X b))) := by
                simp [hw_b]
          _ = ∑ b : Fin d, ∑ c : Fin s₀,
                ι_k (w c) * (ι_k (v c b) * δ (α₀ c₀) (φ (θ' (MvPolynomial.X b)))) := by
                refine Finset.sum_congr rfl fun b _ => ?_
                rw [map_sum, Finset.sum_mul]
                refine Finset.sum_congr rfl fun c _ => ?_
                rw [map_mul, mul_assoc]
          _ = ∑ c : Fin s₀,
                ι_k (w c) * ∑ b : Fin d, ι_k (v c b) * δ (α₀ c₀) (φ (θ' (MvPolynomial.X b))) := by
                rw [Finset.sum_comm]
                refine Finset.sum_congr rfl fun c _ => (Finset.mul_sum _ _ _).symm
          _ = ∑ c : Fin s₀, ι_k (w c) * (if α₀ c = α₀ c₀ then q_B (u' c) else 0) := by
                refine Finset.sum_congr rfl fun c _ => ?_
                rw [← hδ_lin c (α₀ c₀)]
          _ = ∑ c : Fin s₀, (if c = c₀ then ι_k (w c) * q_B (u' c) else 0) := by
                refine Finset.sum_congr rfl fun c _ => ?_
                by_cases hcc : c = c₀
                · subst hcc; simp
                · have h_ne : α₀ c ≠ α₀ c₀ := fun h => hcc (hInj_α₀ h)
                  simp [hcc, h_ne]
          _ = ι_k (w c₀) * q_B (u' c₀) := by simp
      rcases mul_eq_zero.mp h_eval.symm with hw0 | hu0
      · exact ι_k.injective (by simpa using hw0)
      · exact False.elim (hqB_u'_ne c₀ hu0)
    exact ⟨g_raw, v, s_ideal, hg_raw_P, hLI_v, hs_ideal_notMem, hSpan_s, hv_cong⟩

  
  have hExtendMatrixAlongInj : ∀ (d s₀ : ℕ) (α₀ : Fin s₀ → Fin d)
      (v : Fin s₀ → (Fin d → k)),
      Function.Injective α₀ →
      LinearIndependent k v →
      ∃ M : Matrix (Fin d) (Fin d) k,
        IsUnit M.det ∧ ∀ c : Fin s₀, M (α₀ c) = v c := by
    intro d s₀ α₀ v hInj hLI
    by_cases hd : d = 0
    · subst hd
      refine ⟨1, by rw [Matrix.det_one]; exact isUnit_one, fun c => Fin.elim0 (α₀ c)⟩
    · have hd_pos : 0 < d := Nat.pos_of_ne_zero hd
      have _ : Nonempty (Fin d) := ⟨⟨0, hd_pos⟩⟩
      have hs₀ : s₀ ≤ d := by
        have hcard := Fintype.card_le_of_injective α₀ hInj
        simpa only [Fintype.card_fin] using hcard
      have h_rank : Module.finrank k (Fin d → k) = d := by
        rw [Module.finrank_pi, Fintype.card_fin]
      have h_ext : ∀ (k₀ r : ℕ) (hr : r + k₀ = d) (w : Fin r → (Fin d → k)),
          LinearIndependent k w →
          ∃ w' : Fin d → (Fin d → k),
            LinearIndependent k w' ∧ ∀ i : Fin r, w' (Fin.castLE (by omega) i) = w i := by
        intro k₀
        induction k₀ with
        | zero =>
          intro r hr w hw
          have h_eq : r = d := by omega
          refine ⟨w ∘ Fin.cast h_eq.symm, hw.comp _ (Fin.castOrderIso h_eq.symm).toEquiv.injective, ?_⟩
          intro i
          rfl
        | succ k₀ ih =>
          intro r hr w hw
          have hr_lt : r < Module.finrank k (Fin d → k) := by omega
          have hr1 : r ≤ d := by omega
          have hr2 : r + 1 ≤ d := by omega
          obtain ⟨x, hx⟩ := exists_linearIndependent_snoc_of_lt_finrank hw hr_lt
          obtain ⟨w', hw', hw'_eq⟩ := ih (r + 1) (by omega) (Fin.snoc w x) hx
          refine ⟨w', hw', fun i => ?_⟩
          have h_cast : Fin.castLE hr1 i = Fin.castLE hr2 (Fin.castSucc i) := rfl
          rw [h_cast, hw'_eq (Fin.castSucc i), Fin.snoc_castSucc]
      obtain ⟨w', hw', hw'_eq⟩ := h_ext (d - s₀) s₀ (Nat.add_sub_of_le hs₀) v hLI
      let S₁ : Finset (Fin d) := Finset.univ.image (Fin.castLE hs₀)
      let S₂ : Finset (Fin d) := Finset.univ.image α₀
      have hInj_cast : Function.Injective (Fin.castLE hs₀) := Fin.castLE_injective hs₀
      have hCard_c : (S₁ᶜ).card = (S₂ᶜ).card := by
        rw [Finset.card_compl, Finset.card_compl, Finset.card_image_of_injective _ hInj_cast,
          Finset.card_image_of_injective _ hInj]
      let e_compl : ↥(S₁ᶜ) ≃ ↥(S₂ᶜ) :=
        Fintype.equivOfCardEq (by rw [Fintype.card_coe, Fintype.card_coe, hCard_c])
      have hmem_S₁ : ∀ i : Fin d, i ∈ S₁ ↔ i.val < s₀ := by
        intro i
        simp only [S₁, Finset.mem_image, Finset.mem_univ, true_and]
        constructor
        · rintro ⟨c, rfl⟩
          exact c.isLt
        · intro hi
          exact ⟨⟨i.val, hi⟩, Fin.ext rfl⟩
      let f_perm : Fin d → Fin d := fun i =>
        if hi : i.val < s₀ then α₀ ⟨i.val, hi⟩
        else (e_compl ⟨i, Finset.mem_compl.mpr ((hmem_S₁ i).not.mpr hi)⟩).1
      have hInj_f : Function.Injective f_perm := by
        intro i₁ i₂ hf
        dsimp only [f_perm] at hf
        by_cases h₁ : i₁.val < s₀ <;> by_cases h₂ : i₂.val < s₀
        · simp only [h₁, h₂, ↓reduceDIte] at hf
          have hc := hInj hf
          exact Fin.ext (Fin.mk.inj hc)
        · have hi₂ : i₂ ∈ S₁ᶜ := Finset.mem_compl.mpr ((hmem_S₁ i₂).not.mpr h₂)
          simp only [h₁, h₂, ↓reduceDIte] at hf
          exfalso
          have h_in : α₀ ⟨i₁.val, h₁⟩ ∈ S₂ := Finset.mem_image_of_mem α₀ (Finset.mem_univ _)
          have h_out : (e_compl ⟨i₂, hi₂⟩).1 ∈ S₂ᶜ := (e_compl ⟨i₂, hi₂⟩).2
          rw [← hf] at h_out
          exact Finset.mem_compl.mp h_out h_in
        · have hi₁ : i₁ ∈ S₁ᶜ := Finset.mem_compl.mpr ((hmem_S₁ i₁).not.mpr h₁)
          simp only [h₁, h₂, ↓reduceDIte] at hf
          exfalso
          have h_in : α₀ ⟨i₂.val, h₂⟩ ∈ S₂ := Finset.mem_image_of_mem α₀ (Finset.mem_univ _)
          have h_out : (e_compl ⟨i₁, hi₁⟩).1 ∈ S₂ᶜ := (e_compl ⟨i₁, hi₁⟩).2
          rw [hf] at h_out
          exact Finset.mem_compl.mp h_out h_in
        · simp only [h₁, h₂, ↓reduceDIte] at hf
          have he := e_compl.injective (Subtype.ext hf)
          exact Subtype.mk.inj he
      let e : Fin d ≃ Fin d := Equiv.ofBijective f_perm (Finite.injective_iff_bijective.mp hInj_f)
      have he_cast : ∀ c : Fin s₀, e (Fin.castLE hs₀ c) = α₀ c := by
        intro c
        change f_perm (Fin.castLE hs₀ c) = α₀ c
        dsimp only [f_perm, Fin.val_castLE]
        simp only [c.isLt, ↓reduceDIte]
      let b_fn : Fin d → (Fin d → k) := w' ∘ e.symm
      have hb_li : LinearIndependent k b_fn := hw'.comp e.symm e.symm.injective
      let B_M : Module.Basis (Fin d) k (Fin d → k) :=
        basisOfLinearIndependentOfCardEqFinrank hb_li (by rw [h_rank, Fintype.card_fin])
      have hB_coe : ⇑B_M = b_fn := coe_basisOfLinearIndependentOfCardEqFinrank hb_li _
      let M : Matrix (Fin d) (Fin d) k := fun a b => B_M a b
      have hM_eq : M = ((Pi.basisFun k (Fin d)).toMatrix B_M).transpose := by
        ext a b
        simp [M, Matrix.transpose_apply, Module.Basis.toMatrix_apply, Pi.basisFun_repr]
      have hDet : IsUnit M.det := by
        rw [hM_eq, Matrix.det_transpose, ← Module.Basis.det_apply]
        exact (Pi.basisFun k (Fin d)).isUnit_det B_M
      refine ⟨M, hDet, fun c => ?_⟩
      ext b
      change B_M (α₀ c) b = v c b
      rw [hB_coe]
      change w' (e.symm (α₀ c)) b = v c b
      rw [← he_cast c, e.symm_apply_apply, hw'_eq c]

  
  refine ⟨hConj1, ?_⟩
  intro m s₀ R₁ B' _ _ θ m_max _ P φ q₀ ψ_et α₀ hEt_θ hP_rad hP_le_m hEt_φ hm_le_q₀
    hEt_ψ hC_eq hInj_α₀ hψ_q₀ hZero_eq
  obtain ⟨θ', hEt_θ', hC_θ', hX_θ', _, hApprox⟩ :=
    hCoordShiftAndLinearApprox (m + 1) R₁ θ m_max hEt_θ
  have hMap_Pc : ∀ c : Fin s₀, Ideal.map φ (P c) = Ideal.span {ψ_et (MvPolynomial.X (α₀ c))} :=
    fun c => hEtaleRadicalIdealEqSpan m R₁ B' θ (P c) φ ψ_et (α₀ c)
      hEt_θ (hP_rad c) hEt_φ hEt_ψ (hZero_eq c)
  have hC_eq' : ψ_et.comp MvPolynomial.C = φ.comp (θ'.comp MvPolynomial.C) := by
    rw [hC_θ', hC_eq]
  obtain ⟨g_raw, v, s_ideal, hg_raw_P, hLI_v, hs_ideal, hSpan_s, hCong_raw⟩ :=
    hCruxPrincipalAndLinIndep (m + 1) s₀ R₁ B' θ' m_max P φ q₀ ψ_et α₀
      hEt_θ' hX_θ' hP_le_m hEt_φ hm_le_q₀ hEt_ψ hC_eq' hInj_α₀ hψ_q₀ hMap_Pc hApprox
  obtain ⟨M, hDet, hM_row⟩ :=
    hExtendMatrixAlongInj (m + 1) s₀ α₀ v hInj_α₀ hLI_v
  let _ := Classical.propDecidable
  let g : Fin (m + 1) → R₁ := fun a =>
    if h : ∃ c : Fin s₀, α₀ c = a then g_raw (Classical.choose h)
    else ∑ b : Fin (m + 1), θ' (MvPolynomial.C (M a b) * MvPolynomial.X b)
  have hg_α₀ : ∀ c : Fin s₀, g (α₀ c) = g_raw c := by
    intro c
    have h_ex : ∃ c' : Fin s₀, α₀ c' = α₀ c := ⟨c, rfl⟩
    dsimp only [g]
    simp only [h_ex, ↓reduceDIte]
    rw [hInj_α₀ (Classical.choose_spec h_ex)]
  have h1_notMem : (1 : R₁) ∉ m_max :=
    m_max.ne_top_iff_one.mp (Ideal.IsMaximal.ne_top inferInstance)
  refine ⟨θ', g, M, 1, s_ideal, hEt_θ', hC_θ', hX_θ', ?_, ?_, hDet, h1_notMem, hs_ideal, ?_, ?_⟩
  · intro a
    dsimp only [g]
    by_cases h : ∃ c : Fin s₀, α₀ c = a
    · simp only [h, ↓reduceDIte]
      exact hP_le_m _ (hg_raw_P _)
    · simp only [h, ↓reduceDIte]
      refine Ideal.sum_mem m_max fun b _ => ?_
      rw [map_mul]
      exact Ideal.mul_mem_left m_max _ (hX_θ' b)
  · intro c
    rw [hg_α₀ c]
    exact hg_raw_P c
  · intro c x hx
    rw [hg_α₀ c]
    exact hSpan_s c x hx
  · intro a
    rw [one_mul]
    by_cases h : ∃ c : Fin s₀, α₀ c = a
    · let c := Classical.choose h
      have hc : α₀ c = a := Classical.choose_spec h
      rw [← hc, hg_α₀ c, hM_row c]
      exact hCong_raw c
    · dsimp only [g]
      simp only [h, ↓reduceDIte, sub_self]
      exact (m_max ^ 2).zero_mem

theorem weil_etale_mvPolynomial_of_jacobian_mod_maxIdeal_sq (k : Type u) [Field k]
    (d : ℕ) (R₁ : Type u) [CommRing R₁]
    (θ' : MvPolynomial (Fin d) k →+* R₁)
    (m_max : Ideal R₁) [m_max.IsMaximal]
    (g : Fin d → R₁)
    (M : Matrix (Fin d) (Fin d) k)
    (s_lin s₁ : R₁)
    (hEt_θ' : θ'.Etale)
    (hθ'_mem : ∀ b : Fin d, θ' (MvPolynomial.X b) ∈ m_max)
    (hg_mem : ∀ a : Fin d, g a ∈ m_max)
    (hDet : IsUnit M.det)
    (hs_lin : s_lin ∉ m_max)
    (hs₁ : s₁ ∉ m_max)
    (hLin : ∀ a : Fin d,
      s_lin * (g a - ∑ b : Fin d, θ' (MvPolynomial.C (M a b) * MvPolynomial.X b)) ∈
        m_max ^ 2) :
    ∃ (h : R₁) (ψ_zar : MvPolynomial (Fin d) k →+* Localization.Away h),
      h ∉ m_max ∧
      s₁ ∣ h ∧
      ψ_zar.Etale ∧
      ψ_zar.comp MvPolynomial.C =
        (algebraMap R₁ (Localization.Away h)).comp (θ'.comp MvPolynomial.C) ∧
      (∀ a : Fin d, ψ_zar (MvPolynomial.X a) = algebraMap R₁ (Localization.Away h) (g a)) :=
by
  let _ := hθ'_mem
  let _ := hg_mem
  let _ : Algebra k R₁ := (θ'.comp MvPolynomial.C).toAlgebra
  have hC : θ'.comp MvPolynomial.C = algebraMap k R₁ := rfl
  have h_s1 : ∃ (b₁ : Module.Basis (Fin d) R₁ Ω[R₁⁄k]),
      (∀ b : Fin d, b₁ b = KaehlerDifferential.D k R₁ (θ' (MvPolynomial.X b))) ∧
      (∀ h : R₁,
        Algebra.FormallySmooth k (Localization.Away h) ∧
        Algebra.FinitePresentation k (Localization.Away h) ∧
        ∃ (b_T : Module.Basis (Fin d) (Localization.Away h) Ω[Localization.Away h⁄k]),
          ∀ (r : R₁) (c : Fin d),
            b_T.repr (KaehlerDifferential.D k (Localization.Away h)
              (algebraMap R₁ (Localization.Away h) r)) c =
              algebraMap R₁ (Localization.Away h) (b₁.repr (KaehlerDifferential.D k R₁ r) c)) := by
    have h_R₁ : Algebra.FormallySmooth k R₁ ∧ Algebra.FinitePresentation k R₁ ∧
        ∃ (b₁ : Module.Basis (Fin d) R₁ Ω[R₁⁄k]),
          ∀ b : Fin d, b₁ b = KaehlerDifferential.D k R₁ (θ' (MvPolynomial.X b)) := by
      let _ : Algebra (MvPolynomial (Fin d) k) R₁ := θ'.toAlgebra
      have h_alg_P : algebraMap (MvPolynomial (Fin d) k) R₁ = θ' := rfl
      have _ : IsScalarTower k (MvPolynomial (Fin d) k) R₁ :=
        IsScalarTower.of_algebraMap_eq' hC.symm
      have _ : Algebra.Etale (MvPolynomial (Fin d) k) R₁ := hEt_θ'.toAlgebra
      have hFS₁ : Algebra.FormallySmooth k R₁ :=
        Algebra.FormallySmooth.comp k (MvPolynomial (Fin d) k) R₁
      have hFP₁ : Algebra.FinitePresentation k R₁ :=
        Algebra.FinitePresentation.trans k (MvPolynomial (Fin d) k) R₁
      let b_P : Module.Basis (Fin d) (MvPolynomial (Fin d) k) Ω[MvPolynomial (Fin d) k⁄k] :=
        KaehlerDifferential.mvPolynomialBasis k (Fin d)
      let e₁ : TensorProduct (MvPolynomial (Fin d) k) R₁ Ω[MvPolynomial (Fin d) k⁄k] ≃ₗ[R₁] Ω[R₁⁄k] :=
        KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale k (MvPolynomial (Fin d) k) R₁
      let b₁ : Module.Basis (Fin d) R₁ Ω[R₁⁄k] := (b_P.baseChange R₁).map e₁
      refine ⟨hFS₁, hFP₁, b₁, fun b => ?_⟩
      dsimp only [b₁, e₁, b_P]
      rw [Module.Basis.map_apply, Module.Basis.baseChange_apply,
        KaehlerDifferential.mvPolynomialBasis_apply,
        KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale_apply,
        KaehlerDifferential.mapBaseChange_tmul, one_smul,
        KaehlerDifferential.map_D k k (MvPolynomial (Fin d) k) R₁ (MvPolynomial.X b), h_alg_P]
    obtain ⟨hFS₁, hFP₁, b₁, hb₁⟩ := h_R₁
    let _ := hFS₁
    let _ := hFP₁
    refine ⟨b₁, hb₁, fun h => ?_⟩
    let T := Localization.Away h
    have _ : Algebra.FormallyEtale R₁ T :=
      Algebra.FormallyEtale.of_isLocalization (Submonoid.powers h)
    have hFS_T : Algebra.FormallySmooth k T := Algebra.FormallySmooth.comp k R₁ T
    have hFP_T : Algebra.FinitePresentation k T :=
      Algebra.FinitePresentation.of_isLocalizationAway (R := k) h
    let e_T : TensorProduct R₁ T Ω[R₁⁄k] ≃ₗ[T] Ω[T⁄k] :=
      KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale k R₁ T
    let b_T : Module.Basis (Fin d) T Ω[T⁄k] := (b₁.baseChange T).map e_T
    refine ⟨hFS_T, hFP_T, b_T, fun r c => ?_⟩
    have hb_T_apply : ∀ i : Fin d, b_T i = e_T ((1 : T) ⊗ₜ[R₁] b₁ i) := fun i => by
      simp [b_T]
    have hD_eq : KaehlerDifferential.D k T (algebraMap R₁ T r) =
        e_T ((1 : T) ⊗ₜ[R₁] KaehlerDifferential.D k R₁ r) := by
      rw [KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale_apply,
        KaehlerDifferential.mapBaseChange_tmul, one_smul,
        KaehlerDifferential.map_D k k R₁ T r]
    have h_tmul : ((1 : T) ⊗ₜ[R₁] KaehlerDifferential.D k R₁ r) =
        ∑ i : Fin d, algebraMap R₁ T (b₁.repr (KaehlerDifferential.D k R₁ r) i) •
          ((1 : T) ⊗ₜ[R₁] b₁ i) := by
      conv_lhs => rw [← b₁.sum_repr (KaehlerDifferential.D k R₁ r)]
      rw [TensorProduct.tmul_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [← TensorProduct.smul_tmul, Algebra.smul_def, mul_one,
        TensorProduct.smul_tmul', smul_eq_mul, mul_one]
    rw [hD_eq, h_tmul, map_sum]
    have h_sum_bT : (∑ i : Fin d, e_T (algebraMap R₁ T (b₁.repr (KaehlerDifferential.D k R₁ r) i) •
          ((1 : T) ⊗ₜ[R₁] b₁ i))) =
        ∑ i : Fin d, algebraMap R₁ T (b₁.repr (KaehlerDifferential.D k R₁ r) i) • b_T i := by
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [map_smul, hb_T_apply]
    rw [h_sum_bT, map_sum, Finsupp.finsetSum_apply]
    have h_repr_term : ∀ i : Fin d,
        b_T.repr (algebraMap R₁ T (b₁.repr (KaehlerDifferential.D k R₁ r) i) • b_T i) c =
          if i = c then algebraMap R₁ T (b₁.repr (KaehlerDifferential.D k R₁ r) i) else 0 := by
      intro i
      rw [LinearEquiv.map_smul, b_T.repr_self, Finsupp.smul_single, smul_eq_mul, mul_one,
        Finsupp.single_apply]
    simp only [h_repr_term, Finset.sum_ite_eq', Finset.mem_univ, ↓reduceIte]
    rfl
  obtain ⟨b₁, hb₁, hAway⟩ := h_s1
  let J : Matrix (Fin d) (Fin d) R₁ :=
    Matrix.of fun a c => b₁.repr (KaehlerDifferential.D k R₁ (g a)) c
  have hm_prime : m_max.IsPrime := Ideal.IsMaximal.isPrime inferInstance
  have hDetJ : J.det ∉ m_max := by
    let δ : Fin d → Derivation k R₁ R₁ :=
      fun c => (b₁.coord c).compDer (KaehlerDifferential.D k R₁)
    have hδ_apply : ∀ (c : Fin d) (r : R₁),
        δ c r = b₁.repr (KaehlerDifferential.D k R₁ r) c := fun _ _ => rfl
    have hSq : ∀ (c : Fin d) {z : R₁}, z ∈ m_max ^ 2 → δ c z ∈ m_max := by
      intro c z hz
      rw [pow_two] at hz
      refine Submodule.mul_induction_on hz ?_ ?_
      · intro u hu v hv
        rw [(δ c).leibniz u v, smul_eq_mul, smul_eq_mul]
        exact m_max.add_mem (Ideal.mul_mem_right _ m_max hu) (Ideal.mul_mem_right _ m_max hv)
      · intro z₁ z₂ hz₁ hz₂
        rw [map_add]
        exact m_max.add_mem hz₁ hz₂
    have hJ_mod : ∀ a c : Fin d, J a c - algebraMap k R₁ (M a c) ∈ m_max := by
      intro a c
      let r_a : R₁ := g a - ∑ b : Fin d, algebraMap k R₁ (M a b) * θ' (MvPolynomial.X b)
      have hLin_a : s_lin * r_a ∈ m_max ^ 2 := by
        have h_eq : r_a = g a - ∑ b : Fin d, θ' (MvPolynomial.C (M a b) * MvPolynomial.X b) := by
          simp only [r_a, map_mul]
          rfl
        rw [h_eq]
        exact hLin a
      have hsr_mem : s_lin * r_a ∈ m_max := by
        have h_le : m_max ^ 2 ≤ m_max := by
          rw [pow_two]
          exact Ideal.mul_le_right
        exact h_le hLin_a
      have hr_mem : r_a ∈ m_max := (hm_prime.mem_or_mem hsr_mem).resolve_left hs_lin
      have hδ_sr : δ c (s_lin * r_a) ∈ m_max := hSq c hLin_a
      rw [(δ c).leibniz s_lin r_a, smul_eq_mul, smul_eq_mul] at hδ_sr
      have hr_δs : r_a * δ c s_lin ∈ m_max := Ideal.mul_mem_right _ m_max hr_mem
      have hs_δr : s_lin * δ c r_a ∈ m_max := by
        have h_sub := m_max.sub_mem hδ_sr hr_δs
        rwa [add_sub_cancel_right] at h_sub
      have hδr : δ c r_a ∈ m_max := (hm_prime.mem_or_mem hs_δr).resolve_left hs_lin
      have hδr_eq : δ c r_a = J a c - algebraMap k R₁ (M a c) := by
        simp only [r_a, map_sub, map_sum]
        have h_sum_eq : (∑ b : Fin d, δ c (algebraMap k R₁ (M a b) * θ' (MvPolynomial.X b))) =
            algebraMap k R₁ (M a c) := by
          have h_term : ∀ b : Fin d,
              δ c (algebraMap k R₁ (M a b) * θ' (MvPolynomial.X b)) =
                if b = c then algebraMap k R₁ (M a b) else 0 := by
            intro b
            rw [← Algebra.smul_def (M a b) (θ' (MvPolynomial.X b)),
              (δ c).map_smul (M a b) (θ' (MvPolynomial.X b)),
              Algebra.smul_def, hδ_apply, ← hb₁ b, b₁.repr_self, Finsupp.single_apply]
            split_ifs <;> simp
          simp [h_term]
        rw [h_sum_eq, hδ_apply]
        rfl
      rwa [hδr_eq] at hδr
    let q_m : R₁ →+* (R₁ ⧸ m_max) := Ideal.Quotient.mk m_max
    let _ : Field (R₁ ⧸ m_max) := Ideal.Quotient.field m_max
    have hMat_eq : q_m.mapMatrix J = (q_m.comp (algebraMap k R₁)).mapMatrix M := by
      ext a c
      simp only [RingHom.mapMatrix_apply, Matrix.map_apply, RingHom.comp_apply]
      exact Ideal.Quotient.eq.mpr (hJ_mod a c)
    have hDet_eq : q_m J.det = (q_m.comp (algebraMap k R₁)) M.det := by
      rw [RingHom.map_det, RingHom.map_det, hMat_eq]
    have hUnit_q : IsUnit (q_m J.det) := by
      rw [hDet_eq]
      exact hDet.map (q_m.comp (algebraMap k R₁))
    intro hMem
    exact hUnit_q.ne_zero (Ideal.Quotient.eq_zero_iff_mem.mpr hMem)
  let h : R₁ := J.det * s₁
  let T := Localization.Away h
  let ψ_zar : MvPolynomial (Fin d) k →+* T :=
    MvPolynomial.eval₂Hom (algebraMap k T) (fun a => algebraMap R₁ T (g a))
  have hh_notMem : h ∉ m_max := hm_prime.mul_notMem hDetJ hs₁
  have hs₁_dvd : s₁ ∣ h := ⟨J.det, mul_comm J.det s₁⟩
  have hC_zar : ψ_zar.comp MvPolynomial.C =
      (algebraMap R₁ T).comp (θ'.comp MvPolynomial.C) := by
    ext c
    simp only [ψ_zar, RingHom.comp_apply, MvPolynomial.eval₂Hom_C]
    exact IsScalarTower.algebraMap_apply k R₁ T c
  have hX_zar : ∀ a : Fin d, ψ_zar (MvPolynomial.X a) = algebraMap R₁ T (g a) :=
    fun a => MvPolynomial.eval₂Hom_X' (algebraMap k T) (fun a => algebraMap R₁ T (g a)) a
  have hEt_zar : ψ_zar.Etale := by
    obtain ⟨hFS_T, hFP_T, b_T, hb_T⟩ := hAway h
    let _ := hFS_T
    let _ := hFP_T
    let y : Fin d → T := fun a => algebraMap R₁ T (g a)
    let J_T : Matrix (Fin d) (Fin d) T :=
      Matrix.of fun a c => b_T.repr (KaehlerDifferential.D k T (y a)) c
    have hJT_eq : J_T = (algebraMap R₁ T).mapMatrix J := by
      ext a c
      simp only [J_T, J, y, Matrix.of_apply, RingHom.mapMatrix_apply, Matrix.map_apply]
      exact hb_T (g a) c
    have hDet_JT : IsUnit J_T.det := by
      have h_det_map : J_T.det = algebraMap R₁ T J.det := by
        rw [hJT_eq, ← RingHom.map_det]
      rw [h_det_map]
      have hUnit_h : IsUnit (algebraMap R₁ T h) := IsLocalization.Away.algebraMap_isUnit h
      dsimp only [h] at hUnit_h
      rw [map_mul] at hUnit_h
      exact isUnit_of_mul_isUnit_left hUnit_h
    let _ : Algebra (MvPolynomial (Fin d) k) T := ψ_zar.toAlgebra
    have h_alg_Px : algebraMap (MvPolynomial (Fin d) k) T = ψ_zar := rfl
    have _ : IsScalarTower k (MvPolynomial (Fin d) k) T := by
      apply IsScalarTower.of_algebraMap_eq'
      ext c
      exact (MvPolynomial.eval₂Hom_C (algebraMap k T) y c).symm
    let L : TensorProduct (MvPolynomial (Fin d) k) T Ω[MvPolynomial (Fin d) k⁄k] →ₗ[T] Ω[T⁄k] :=
      KaehlerDifferential.mapBaseChange k (MvPolynomial (Fin d) k) T
    let b_dom : Module.Basis (Fin d) T
        (TensorProduct (MvPolynomial (Fin d) k) T Ω[MvPolynomial (Fin d) k⁄k]) :=
      (KaehlerDifferential.mvPolynomialBasis k (Fin d)).baseChange T
    have hMat_L : LinearMap.toMatrix b_dom b_T L = J_T.transpose := by
      ext c a
      rw [LinearMap.toMatrix_apply]
      have hL_bdom : L (b_dom a) = KaehlerDifferential.D k T (y a) := by
        dsimp only [b_dom, L]
        rw [Module.Basis.baseChange_apply,
          KaehlerDifferential.mvPolynomialBasis_apply,
          KaehlerDifferential.mapBaseChange_tmul, one_smul,
          KaehlerDifferential.map_D k k (MvPolynomial (Fin d) k) T (MvPolynomial.X a),
          h_alg_Px, hX_zar a]
      rw [hL_bdom]
      rfl
    have hUnit_matL : IsUnit (LinearMap.toMatrix b_dom b_T L) := by
      rw [Matrix.isUnit_iff_isUnit_det, hMat_L, Matrix.det_transpose]
      exact hDet_JT
    obtain ⟨u, hu⟩ := hUnit_matL
    let L_inv : Ω[T⁄k] →ₗ[T]
        TensorProduct (MvPolynomial (Fin d) k) T Ω[MvPolynomial (Fin d) k⁄k] :=
      Matrix.toLin b_T b_dom (↑u⁻¹ : Matrix (Fin d) (Fin d) T)
    have hL_toLin : L = Matrix.toLin b_dom b_T (↑u : Matrix (Fin d) (Fin d) T) := by
      rw [hu, ← LinearMap.toMatrix_symm, LinearEquiv.symm_apply_apply]
    have h_left : L_inv.comp L = LinearMap.id := by
      rw [hL_toLin, ← Matrix.toLin_mul b_dom b_T b_dom, Units.inv_mul, Matrix.toLin_one]
    have h_right : L.comp L_inv = LinearMap.id := by
      rw [hL_toLin, ← Matrix.toLin_mul b_T b_dom b_T, Units.mul_inv, Matrix.toLin_one]
    have h_left_inv : Function.LeftInverse L_inv L := fun x => LinearMap.congr_fun h_left x
    have h_right_inv : Function.RightInverse L_inv L := fun x => LinearMap.congr_fun h_right x
    have hBij : Function.Bijective L := ⟨h_left_inv.injective, h_right_inv.surjective⟩
    have hSub_kaehler : Subsingleton Ω[T⁄MvPolynomial (Fin d) k] := by
      apply subsingleton_of_forall_eq 0
      intro ω
      obtain ⟨η, rfl⟩ := KaehlerDifferential.map_surjective k (MvPolynomial (Fin d) k) T ω
      obtain ⟨z, rfl⟩ := hBij.2 η
      exact (KaehlerDifferential.exact_mapBaseChange_map k (MvPolynomial (Fin d) k) T (L z)).mpr
        ⟨z, rfl⟩
    have hSub_h1 : Subsingleton (Algebra.H1Cotangent (MvPolynomial (Fin d) k) T) := by
      apply subsingleton_of_forall_eq 0
      intro x
      have hL_δ : L (Algebra.H1Cotangent.δ k (MvPolynomial (Fin d) k) T x) = 0 :=
        (Algebra.H1Cotangent.exact_δ_mapBaseChange k (MvPolynomial (Fin d) k) T _).mpr ⟨x, rfl⟩
      have hδ_zero : Algebra.H1Cotangent.δ k (MvPolynomial (Fin d) k) T x = 0 :=
        hBij.1 (hL_δ.trans (map_zero L).symm)
      obtain ⟨w, rfl⟩ :=
        (Algebra.H1Cotangent.exact_map_δ k (MvPolynomial (Fin d) k) T x).mp hδ_zero
      have _ : Subsingleton (Algebra.H1Cotangent k T) :=
        Algebra.FormallySmooth.subsingleton_h1Cotangent
      rw [Subsingleton.elim w 0, map_zero]
    have hFE : Algebra.FormallyEtale (MvPolynomial (Fin d) k) T :=
      { subsingleton_kaehlerDifferential := hSub_kaehler
        subsingleton_h1Cotangent := hSub_h1 }
    have hFP : Algebra.FinitePresentation (MvPolynomial (Fin d) k) T :=
      Algebra.FinitePresentation.of_restrict_scalars_finitePresentation k
        (MvPolynomial (Fin d) k) T
    have hEt_alg : Algebra.Etale (MvPolynomial (Fin d) k) T := ⟨hFE, hFP⟩
    exact (RingHom.etale_algebraMap (R := MvPolynomial (Fin d) k) (S := T)).mpr hEt_alg
  exact ⟨h, ψ_zar, hh_notMem, hs₁_dvd, hEt_zar, hC_zar, hX_zar⟩

theorem weil_snc_divisor_affine_open_bridge (k : Type u) [Field k] (m r : ℕ)
    (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (_hSmW : AlgebraicGeometry.SmoothOfRelativeDimension (m + 1) W.hom)
    (D : Fin r → AlgebraicGeometry.Scheme.{u})
    (ιD : ∀ i : Fin r, D i ⟶ W.left)
    (_hClD : ∀ i : Fin r, AlgebraicGeometry.IsClosedImmersion (ιD i))
    (_hIntD : ∀ i : Fin r, AlgebraicGeometry.IsIntegral (D i))
    (x : W.left) :
    ∃ (U₁ : W.left.Opens) (hAffU₁ : AlgebraicGeometry.IsAffineOpen U₁)
      (θ : MvPolynomial (Fin (m + 1)) k →+* ↑(W.left.presheaf.obj (Opposite.op U₁)))
      (p_x : PrimeSpectrum ↑(W.left.presheaf.obj (Opposite.op U₁)))
      (m_max : Ideal ↑(W.left.presheaf.obj (Opposite.op U₁)))
      (_ : m_max.IsMaximal)
      (x₀ : W.left),
      x ∈ U₁ ∧
      θ.Etale ∧
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ.comp MvPolynomial.C)) =
        hAffU₁.fromSpec ≫ W.hom) ∧
      hAffU₁.fromSpec.base p_x = x ∧
      p_x.asIdeal ≤ m_max ∧
      (∀ i : Fin r, x₀ ∈ Set.range (ιD i).base ↔ x ∈ Set.range (ιD i).base) ∧
      (∀ i : Fin r, x ∉ Set.range (ιD i).base →
        (U₁ : Set W.left) ∩ Set.range (ιD i).base = ∅) ∧
      (∀ i : Fin r, x ∈ Set.range (ιD i).base →
        (RingHom.ker ((ιD i).app U₁).hom).IsRadical ∧
        RingHom.ker ((ιD i).app U₁).hom ≤ p_x.asIdeal ∧
        hAffU₁.fromSpec.base ⁻¹' Set.range (ιD i).base =
          {p : PrimeSpectrum ↑(W.left.presheaf.obj (Opposite.op U₁)) |
            RingHom.ker ((ιD i).app U₁).hom ≤ p.asIdeal}) ∧
      (∀ (R' : CommRingCat.{u}) (v₀ : AlgebraicGeometry.Spec R')
          (e_W : AlgebraicGeometry.Spec R' ⟶ W.left)
          (ψ_et₀ : MvPolynomial (Fin (m + 1)) k →+* R'),
        AlgebraicGeometry.Etale e_W →
        AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_et₀)) →
        e_W.base v₀ = x₀ →
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_et₀) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = e_W ≫ W.hom) →
        ∃ (B' : Type u) (_ : CommRing B') (q₀ : PrimeSpectrum B')
          (φ : ↑(W.left.presheaf.obj (Opposite.op U₁)) →+* B')
          (ψ_et : MvPolynomial (Fin (m + 1)) k →+* B')
          (e_B : AlgebraicGeometry.Spec (CommRingCat.of B') ⟶ AlgebraicGeometry.Spec R'),
          φ.Etale ∧
          ψ_et.Etale ∧
          m_max ≤ q₀.asIdeal.comap φ ∧
          e_B.base q₀ = v₀ ∧
          ψ_et.comp MvPolynomial.C = φ.comp (θ.comp MvPolynomial.C) ∧
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ) ≫ hAffU₁.fromSpec = e_B ≫ e_W) ∧
          (∀ (q : PrimeSpectrum B') (j : Fin (m + 1)),
            ψ_et (MvPolynomial.X j) ∈ q.asIdeal ↔
              ψ_et₀ (MvPolynomial.X j) ∈ (e_B.base q).asIdeal)) ∧
      (∀ (h : ↑(W.left.presheaf.obj (Opposite.op U₁)))
          (ψ_zar : MvPolynomial (Fin (m + 1)) k →+* Localization.Away h)
          (α_x : {i : Fin r // x ∈ Set.range (ιD i).base} → Fin (m + 1)),
        h ∉ p_x.asIdeal →
        ψ_zar.Etale →
        ψ_zar.comp MvPolynomial.C =
          (algebraMap ↑(W.left.presheaf.obj (Opposite.op U₁)) (Localization.Away h)).comp
            (θ.comp MvPolynomial.C) →
        Function.Injective α_x →
        (∀ (i : Fin r) (hix : x ∈ Set.range (ιD i).base),
          Ideal.map (algebraMap ↑(W.left.presheaf.obj (Opposite.op U₁)) (Localization.Away h))
            (RingHom.ker ((ιD i).app U₁).hom) =
            Ideal.span {ψ_zar (MvPolynomial.X (α_x ⟨i, hix⟩))}) →
        ∃ (U : W.left.Opens),
          AlgebraicGeometry.IsAffineOpen U ∧ x ∈ U ∧
          ∃ (ψ : MvPolynomial (Fin (m + 1)) k →+* ↑(W.left.presheaf.obj (Opposite.op U))),
            AlgebraicGeometry.Etale
              (U.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) ∧
            (U.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = U.ι ≫ W.hom) ∧
            ∃ (α : {i : Fin r // Nonempty ↑((TopologicalSpace.Opens.map (ιD i).base).obj U)} →
                Fin (m + 1)),
              Function.Injective α ∧
              ∀ (i : Fin r)
                (hi : Nonempty ↑((TopologicalSpace.Opens.map (ιD i).base).obj U)),
                RingHom.ker ((ιD i).app U).hom =
                  Ideal.span {ψ (MvPolynomial.X (α ⟨i, hi⟩))}) :=
by
  
  let F_out : Set W.left :=
    ⋃ (i : Fin r) (_ : x ∉ Set.range (ιD i).base), Set.range (ιD i).base
  have hClosed_out : IsClosed F_out := by
    refine Set.Finite.isClosed_biUnion (Set.toFinite _) (fun i _ => ?_)
    exact (AlgebraicGeometry.IsClosedImmersion.iff_isPreimmersion.mp (_hClD i)).2
  have hx_not_out : x ∉ F_out := by
    simp only [F_out, Set.mem_iUnion, not_exists]
    intro i hni hmem
    exact hni hmem
  have hSmW' := _hSmW
  rw [AlgebraicGeometry.smoothOfRelativeDimension_iff] at hSmW'
  obtain ⟨U_k, hAffUk, V₀, hAffV₀, hxV₀, e_UV, hStd_x⟩ := hSmW' x
  have hUk_top : U_k = ⊤ := top_unique fun z _ => by
    have hz : W.hom.base x ∈ U_k := e_UV hxV₀
    have hEq : z = W.hom.base x := Subsingleton.elim (α := PrimeSpectrum k) _ _
    rwa [hEq]
  subst hUk_top
  have hRangeUk : Set.range ⇑hAffUk.fromSpec =
      Set.range ⇑(𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k))) := by
    rw [hAffUk.range_fromSpec]
    ext z
    exact ⟨fun _ => ⟨z, rfl⟩, fun _ => trivial⟩
  let isoUk : AlgebraicGeometry.Spec
      ((AlgebraicGeometry.Spec (CommRingCat.of k)).presheaf.obj (Opposite.op ⊤)) ≅
      AlgebraicGeometry.Spec (CommRingCat.of k) :=
    AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq hAffUk.fromSpec
      (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k))) hRangeUk
  have hFacUk : isoUk.hom = hAffUk.fromSpec := by
    simpa using AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac
      hAffUk.fromSpec (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k))) hRangeUk
  let eUk : CommRingCat.of k ≅
      (AlgebraicGeometry.Spec (CommRingCat.of k)).presheaf.obj (Opposite.op ⊤) :=
    { hom := AlgebraicGeometry.Spec.preimage isoUk.hom
      inv := AlgebraicGeometry.Spec.preimage isoUk.inv
      hom_inv_id := by rw [← Spec.preimage_comp, Iso.inv_hom_id, Spec.preimage_id]
      inv_hom_id := by rw [← Spec.preimage_comp, Iso.hom_inv_id, Spec.preimage_id] }
  have hStd_k : RingHom.IsStandardSmoothOfRelativeDimension (m + 1)
      (eUk.hom ≫ W.hom.appLE ⊤ V₀ e_UV).hom :=
    (@RingHom.isStandardSmoothOfRelativeDimension_respectsIso (m + 1)).right
      (W.hom.appLE ⊤ V₀ e_UV).hom eUk.commRingCatIsoToRingEquiv hStd_x
  obtain ⟨θ₀, hθ₀_C, hEt_θ₀⟩ := hStd_k.exists_etale_mvPolynomial
  have hComm_θ₀ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ₀.comp MvPolynomial.C)) =
      hAffV₀.fromSpec ≫ W.hom := by
    have h_ofHom : CommRingCat.ofHom (θ₀.comp MvPolynomial.C) =
        eUk.hom ≫ W.hom.appLE ⊤ V₀ e_UV := by
      ext a
      exact RingHom.congr_fun hθ₀_C a
    rw [h_ofHom, AlgebraicGeometry.Spec.map_comp]
    have h_pre : AlgebraicGeometry.Spec.map eUk.hom = hAffUk.fromSpec := by
      dsimp [eUk]
      rw [AlgebraicGeometry.Spec.map_preimage, hFacUk]
    rw [h_pre, AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec W.hom hAffUk hAffV₀ e_UV]
  let V_x : W.left.Opens := ⟨F_outᶜ, hClosed_out.isOpen_compl⟩
  have hx_rangeV₀ : x ∈ Set.range hAffV₀.fromSpec.base := by
    rwa [hAffV₀.range_fromSpec]
  obtain ⟨p₀_V, hp₀_V⟩ := hx_rangeV₀
  have hp₀_Vx : p₀_V ∈ (TopologicalSpace.Opens.map hAffV₀.fromSpec.base).obj V_x := by
    change hAffV₀.fromSpec.base p₀_V ∈ F_outᶜ
    rw [hp₀_V]
    exact hx_not_out
  obtain ⟨_, ⟨s₀, rfl⟩, hp₀_s₀, hs₀_le⟩ :=
    TopologicalSpace.Opens.isBasis_iff_nbhd.mp PrimeSpectrum.isBasis_basic_opens hp₀_Vx
  let U₁ : W.left.Opens := W.left.basicOpen s₀
  have hAffU₁ : AlgebraicGeometry.IsAffineOpen U₁ := hAffV₀.basicOpen s₀
  have hxU₁ : x ∈ U₁ := by
    have hp_bo : p₀_V ∈ PrimeSpectrum.basicOpen s₀ := hp₀_s₀
    rw [← hAffV₀.fromSpec_preimage_basicOpen s₀] at hp_bo
    change hAffV₀.fromSpec.base p₀_V ∈ U₁ at hp_bo
    rwa [hp₀_V] at hp_bo
  have hDisj_F : (U₁ : Set W.left) ∩ F_out = ∅ := by
    rw [Set.eq_empty_iff_forall_notMem]
    rintro z ⟨hzU₁, hzF⟩
    have hzV₀ : z ∈ Set.range hAffV₀.fromSpec.base := by
      rw [hAffV₀.range_fromSpec]
      exact W.left.basicOpen_le s₀ hzU₁
    obtain ⟨q, rfl⟩ := hzV₀
    have hq_bo : q ∈ PrimeSpectrum.basicOpen s₀ := by
      rw [← hAffV₀.fromSpec_preimage_basicOpen s₀]
      exact hzU₁
    exact hs₀_le hq_bo hzF
  let res₁ := W.left.presheaf.map (homOfLE (W.left.basicOpen_le s₀)).op
  let θ : MvPolynomial (Fin (m + 1)) k →+* ↑(W.left.presheaf.obj (Opposite.op U₁)) :=
    res₁.hom.comp θ₀
  have hEt_θ : θ.Etale := by
    have : IsLocalization.Away s₀ ↑(W.left.presheaf.obj (Opposite.op U₁)) :=
      hAffV₀.isLocalization_basicOpen s₀
    have hEt_res : (algebraMap ↑(W.left.presheaf.obj (Opposite.op V₀))
        ↑(W.left.presheaf.obj (Opposite.op U₁))).Etale :=
      Algebra.Etale.of_isLocalizationAway s₀
    exact RingHom.Etale.stableUnderComposition _ _ hEt_θ₀ hEt_res
  have hComm_θ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ.comp MvPolynomial.C)) =
      hAffU₁.fromSpec ≫ W.hom := by
    have hC_eq : CommRingCat.ofHom (θ.comp MvPolynomial.C) =
        CommRingCat.ofHom (θ₀.comp MvPolynomial.C) ≫ res₁ := by
      ext a
      rfl
    rw [hC_eq, AlgebraicGeometry.Spec.map_comp, hComm_θ₀, ← Category.assoc,
      hAffV₀.map_fromSpec hAffU₁ (homOfLE (W.left.basicOpen_le s₀)).op]

  
  have hx_rangeU₁ : x ∈ Set.range hAffU₁.fromSpec.base := by
    rwa [hAffU₁.range_fromSpec]
  obtain ⟨p_x, hp_x⟩ := hx_rangeU₁
  obtain ⟨m_max, hm_max, hp_le_m⟩ :=
    Ideal.exists_le_maximal p_x.asIdeal p_x.isPrime.ne_top
  let p₀ : PrimeSpectrum ↑(W.left.presheaf.obj (Opposite.op U₁)) :=
    ⟨m_max, hm_max.isPrime⟩
  let x₀ : W.left := hAffU₁.fromSpec.base p₀
  have hDisj_out : ∀ i : Fin r, x ∉ Set.range (ιD i).base →
      (U₁ : Set W.left) ∩ Set.range (ιD i).base = ∅ := by
    intro i hni
    rw [← Set.subset_empty_iff, ← hDisj_F]
    rintro z ⟨hzU₁, hzi⟩
    exact ⟨hzU₁, Set.mem_iUnion₂.mpr ⟨i, hni, hzi⟩⟩
  have hPre_D : ∀ i : Fin r,
      hAffU₁.fromSpec.base ⁻¹' Set.range (ιD i).base =
        {p : PrimeSpectrum ↑(W.left.presheaf.obj (Opposite.op U₁)) |
          RingHom.ker ((ιD i).app U₁).hom ≤ p.asIdeal} := by
    intro i
    have := _hClD i
    let V_i : (D i).Opens := (TopologicalSpace.Opens.map (ιD i).base).obj U₁
    have hAffVi : AlgebraicGeometry.IsAffineOpen V_i := hAffU₁.preimage (ιD i)
    have hSq : AlgebraicGeometry.Spec.map ((ιD i).app U₁) ≫ hAffU₁.fromSpec =
        hAffVi.fromSpec ≫ ιD i := by
      rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE]
      exact AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec (ιD i) hAffU₁ hAffVi le_rfl
    have hRange_eq : hAffU₁.fromSpec.base ⁻¹' Set.range (ιD i).base =
        Set.range (PrimeSpectrum.comap ((ιD i).app U₁).hom) := by
      ext p
      simp only [Set.mem_preimage, Set.mem_range]
      constructor
      · rintro ⟨z, hz⟩
        have hzVi : z ∈ Set.range hAffVi.fromSpec.base := by
          rw [hAffVi.range_fromSpec]
          change (ιD i).base z ∈ (U₁ : Set W.left)
          rw [hz, ← hAffU₁.range_fromSpec]
          exact ⟨p, rfl⟩
        obtain ⟨q, rfl⟩ := hzVi
        refine ⟨q, ?_⟩
        apply hAffU₁.fromSpec.isOpenEmbedding.injective
        have hq_eq : (AlgebraicGeometry.Spec.map ((ιD i).app U₁) ≫ hAffU₁.fromSpec).base q =
            (hAffVi.fromSpec ≫ ιD i).base q := by
          rw [hSq]
        exact hq_eq.trans hz
      · rintro ⟨q, rfl⟩
        have hq_eq : (AlgebraicGeometry.Spec.map ((ιD i).app U₁) ≫ hAffU₁.fromSpec).base q =
            (hAffVi.fromSpec ≫ ιD i).base q := by
          rw [hSq]
        exact ⟨hAffVi.fromSpec.base q, hq_eq.symm⟩
    rw [hRange_eq, range_comap_of_surjective _ ((ιD i).app U₁).hom
      (AlgebraicGeometry.Scheme.Hom.app_surjective (ιD i) U₁ hAffU₁)]
    ext p
    simp [PrimeSpectrum.mem_zeroLocus, SetLike.coe_subset_coe]
  have hKer_in : ∀ i : Fin r, x ∈ Set.range (ιD i).base →
      (RingHom.ker ((ιD i).app U₁).hom).IsRadical ∧
      RingHom.ker ((ιD i).app U₁).hom ≤ p_x.asIdeal ∧
      hAffU₁.fromSpec.base ⁻¹' Set.range (ιD i).base =
        {p : PrimeSpectrum ↑(W.left.presheaf.obj (Opposite.op U₁)) |
          RingHom.ker ((ιD i).app U₁).hom ≤ p.asIdeal} := by
    intro i hix
    refine ⟨?_, ?_, hPre_D i⟩
    · obtain ⟨z, hz⟩ := hix
      have hz_mem : z ∈ ((TopologicalSpace.Opens.map (ιD i).base).obj U₁ : Set (D i)) := by
        change (ιD i).base z ∈ U₁
        rwa [hz]
      have : IsDomain ↑((D i).presheaf.obj
          (Opposite.op ((TopologicalSpace.Opens.map (ιD i).base).obj U₁))) :=
        @AlgebraicGeometry.IsIntegral.component_integral (D i) (_hIntD i)
          ((TopologicalSpace.Opens.map (ιD i).base).obj U₁) ⟨⟨z, hz_mem⟩⟩
      exact (RingHom.ker_isPrime ((ιD i).app U₁).hom).isRadical
    · have hp_mem : p_x ∈ hAffU₁.fromSpec.base ⁻¹' Set.range (ιD i).base := by
        change hAffU₁.fromSpec.base p_x ∈ Set.range (ιD i).base
        rwa [hp_x]
      rwa [hPre_D i] at hp_mem
  have hActive_iff : ∀ i : Fin r, x₀ ∈ Set.range (ιD i).base ↔ x ∈ Set.range (ιD i).base := by
    intro i
    constructor
    · intro hx₀_in
      by_contra hni
      have hx₀_U₁ : x₀ ∈ (U₁ : Set W.left) := by
        rw [← hAffU₁.range_fromSpec]
        exact ⟨p₀, rfl⟩
      have h_mem : x₀ ∈ (U₁ : Set W.left) ∩ Set.range (ιD i).base := ⟨hx₀_U₁, hx₀_in⟩
      rw [hDisj_out i hni] at h_mem
      exact h_mem
    · intro hix
      have h_le : RingHom.ker ((ιD i).app U₁).hom ≤ p₀.asIdeal :=
        (hKer_in i hix).2.1.trans hp_le_m
      have hp₀_mem : p₀ ∈ hAffU₁.fromSpec.base ⁻¹' Set.range (ιD i).base := by
        rw [hPre_D i]
        exact h_le
      exact hp₀_mem

  refine ⟨U₁, hAffU₁, θ, p_x, m_max, hm_max, x₀,
    hxU₁, hEt_θ, hComm_θ, hp_x, hp_le_m, hActive_iff, hDisj_out, hKer_in, ?_, ?_⟩

  
  · intro R' v₀ e_W ψ_et₀ hEt_eW hEt_ψ₀ hv₀ hComm₀
    have hv₀_U₁ : (v₀ : PrimeSpectrum R') ∈ (TopologicalSpace.Opens.map e_W.base).obj U₁ := by
      change e_W.base v₀ ∈ (U₁ : Set W.left)
      rw [hv₀, ← hAffU₁.range_fromSpec]
      exact ⟨p₀, rfl⟩
    obtain ⟨_, ⟨f, rfl⟩, hv₀_f, hf_le⟩ :=
      TopologicalSpace.Opens.isBasis_iff_nbhd.mp PrimeSpectrum.isBasis_basic_opens hv₀_U₁
    let B' : Type u := Localization.Away f
    let loc_f : R' ⟶ CommRingCat.of B' := CommRingCat.ofHom (algebraMap R' B')
    let e_B : AlgebraicGeometry.Spec (CommRingCat.of B') ⟶ AlgebraicGeometry.Spec R' :=
      AlgebraicGeometry.Spec.map loc_f
    let ψ_et : MvPolynomial (Fin (m + 1)) k →+* B' := (algebraMap R' B').comp ψ_et₀
    have hv₀_range : (v₀ : PrimeSpectrum R') ∈
        Set.range (PrimeSpectrum.comap (algebraMap R' B')) := by
      rw [PrimeSpectrum.localization_away_comap_range B' f]
      exact hv₀_f
    obtain ⟨q₀, hq₀⟩ := hv₀_range
    let q₀_spec : AlgebraicGeometry.Spec (CommRingCat.of B') := q₀
    have heB_q₀ : e_B.base q₀_spec = v₀ := hq₀
    have hRange_eB : Set.range (e_B ≫ e_W).base ⊆ Set.range hAffU₁.fromSpec.base := by
      rw [hAffU₁.range_fromSpec]
      rintro _ ⟨q, rfl⟩
      have hq_f : (e_B.base q : PrimeSpectrum R') ∈ PrimeSpectrum.basicOpen f := by
        intro hf_mem
        exact (q : PrimeSpectrum B').isPrime.ne_top
          (Ideal.eq_top_of_isUnit_mem _ hf_mem (IsLocalization.Away.algebraMap_isUnit f))
      exact hf_le hq_f
    let g_lift : AlgebraicGeometry.Spec (CommRingCat.of B') ⟶
        AlgebraicGeometry.Spec (W.left.presheaf.obj (Opposite.op U₁)) :=
      AlgebraicGeometry.IsOpenImmersion.lift hAffU₁.fromSpec (e_B ≫ e_W) hRange_eB
    let φ : ↑(W.left.presheaf.obj (Opposite.op U₁)) →+* B' :=
      (AlgebraicGeometry.Spec.preimage g_lift).hom
    have hSpec_φ_eq : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ) = g_lift := by
      change AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (AlgebraicGeometry.Spec.preimage g_lift).hom) = g_lift
      rw [CommRingCat.ofHom_hom, AlgebraicGeometry.Spec.map_preimage]
