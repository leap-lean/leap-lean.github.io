            (Algebra.TensorProduct.map awayL₁ awayL₂).commutes c
          rw [h_τRc]
          change L₂ (HomogeneousLocalization.val (algebraMap k C₂ c)) = _
          have hval : HomogeneousLocalization.val (algebraMap k C₂ c) =
