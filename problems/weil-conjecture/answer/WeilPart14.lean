  have eq_of_comp_algebraMap_rees :
      ∀ {R T : Type u} [CommRing R] [CommRing T] [IsDomain T]
        {n : ℕ} (f : Fin n → R) (a₀ : Fin n)
        (Φ₁ Φ₂ : ↥(weilSmoothCenterReesSubalg R f a₀) →+* T)
        (_ : Φ₁.comp (algebraMap R ↥(weilSmoothCenterReesSubalg R f a₀)) =
          Φ₂.comp (algebraMap R ↥(weilSmoothCenterReesSubalg R f a₀)))
        (_ : Φ₁ (algebraMap R ↥(weilSmoothCenterReesSubalg R f a₀) (f a₀)) ≠ 0),
        Φ₁ = Φ₂ := by
    clear * -
    intro R T _ _ _ n f a₀ Φ₁ Φ₂ hComp hne
    let S := weilSmoothCenterReesSubalg R f a₀
    let E : Subalgebra R (Localization.Away (f a₀)) :=
      { carrier := {z | ∃ hz : z ∈ S, Φ₁ ⟨z, hz⟩ = Φ₂ ⟨z, hz⟩}
        mul_mem' := fun {x y} ⟨hx, h1⟩ ⟨hy, h2⟩ =>
          ⟨S.mul_mem hx hy, by
            change Φ₁ (⟨x, hx⟩ * ⟨y, hy⟩) = Φ₂ (⟨x, hx⟩ * ⟨y, hy⟩)
            rw [map_mul, map_mul, h1, h2]⟩
        one_mem' := ⟨S.one_mem, by change Φ₁ 1 = Φ₂ 1; rw [map_one, map_one]⟩
        add_mem' := fun {x y} ⟨hx, h1⟩ ⟨hy, h2⟩ =>
          ⟨S.add_mem hx hy, by
            change Φ₁ (⟨x, hx⟩ + ⟨y, hy⟩) = Φ₂ (⟨x, hx⟩ + ⟨y, hy⟩)
            rw [map_add, map_add, h1, h2]⟩
        zero_mem' := ⟨S.zero_mem, by change Φ₁ 0 = Φ₂ 0; rw [map_zero, map_zero]⟩
        algebraMap_mem' := fun r =>
          ⟨S.algebraMap_mem r, RingHom.congr_fun hComp r⟩ }
    have hLe : S ≤ E := by
      apply Algebra.adjoin_le
      rintro _ ⟨b, rfl⟩
      let r_b : ↥S := ⟨weilSmoothCenterReesRatio R f a₀ b, Algebra.subset_adjoin ⟨b, rfl⟩⟩
      refine ⟨r_b.2, ?_⟩
      have hmul_S : algebraMap R ↥S (f a₀) * r_b = algebraMap R ↥S (f b) := by
        apply Subtype.ext
        exact IsLocalization.mk'_spec' (Localization.Away (f a₀)) (f b)
          ⟨f a₀, Submonoid.mem_powers (f a₀)⟩
      apply mul_left_cancel₀ hne
      calc
        Φ₁ (algebraMap R ↥S (f a₀)) * Φ₁ r_b
          = Φ₁ (algebraMap R ↥S (f a₀) * r_b) := (map_mul Φ₁ _ _).symm
        _ = Φ₁ (algebraMap R ↥S (f b)) := by rw [hmul_S]
        _ = Φ₂ (algebraMap R ↥S (f b)) := RingHom.congr_fun hComp (f b)
        _ = Φ₂ (algebraMap R ↥S (f a₀) * r_b) := by rw [hmul_S]
        _ = Φ₂ (algebraMap R ↥S (f a₀)) * Φ₂ r_b := map_mul Φ₂ _ _
        _ = Φ₁ (algebraMap R ↥S (f a₀)) * Φ₂ r_b := by
          have hfa₀ : Φ₁ (algebraMap R ↥S (f a₀)) = Φ₂ (algebraMap R ↥S (f a₀)) :=
            RingHom.congr_fun hComp (f a₀)
          rw [hfa₀]
    apply RingHom.ext
    rintro ⟨z, hz⟩
    exact (hLe hz).2
  
  have awayToFractionRing_algebraMap :
      ∀ {R' B : Type u} [CommRing R'] [IsDomain R'] [CommRing B] [Algebra R' B]
        (ιB : B →ₐ[R'] FractionRing R') (u : B) (hu : ιB u ≠ 0) (b : B),
        weilSmoothCenterAwayToFrac ιB u hu (algebraMap B (Localization.Away u) b) = ιB b :=
    fun ιB u hu b => IsLocalization.Away.lift_eq u (IsUnit.mk0 (ιB u) hu) b
  have awayToFractionRing_invSelf :
      ∀ {R' B : Type u} [CommRing R'] [IsDomain R'] [CommRing B] [Algebra R' B]
        (ιB : B →ₐ[R'] FractionRing R') (u : B) (hu : ιB u ≠ 0),
        weilSmoothCenterAwayToFrac ιB u hu (IsLocalization.Away.invSelf (S := Localization.Away u) u) =
          (ιB u)⁻¹ := by
    clear * - awayToFractionRing_algebraMap
    intro R' B _ _ _ _ ιB u hu
    apply mul_left_cancel₀ hu
    calc
      ιB u * weilSmoothCenterAwayToFrac ιB u hu (IsLocalization.Away.invSelf u)
        = weilSmoothCenterAwayToFrac ιB u hu
            (algebraMap B (Localization.Away u) u * IsLocalization.Away.invSelf u) := by
          rw [map_mul, awayToFractionRing_algebraMap]
      _ = 1 := by rw [IsLocalization.Away.mul_invSelf, map_one]
      _ = ιB u * (ιB u)⁻¹ := (mul_inv_cancel₀ hu).symm
  have awayToFractionRing_injective :
      ∀ {R' B : Type u} [CommRing R'] [IsDomain R'] [CommRing B] [Algebra R' B]
        (ιB : B →ₐ[R'] FractionRing R') (_ : Function.Injective ιB)
        (u : B) (hu : ιB u ≠ 0),
        Function.Injective (weilSmoothCenterAwayToFrac ιB u hu) := by
    clear * - awayToFractionRing_algebraMap
    intro R' B _ _ _ _ ιB hInj u hu
    rw [injective_iff_map_eq_zero]
    intro z hz
    obtain ⟨⟨b, _, n, rfl⟩, hmul⟩ := IsLocalization.surj (Submonoid.powers u) z
    dsimp only at hmul
    have hb0 : ιB b = 0 := by
      calc
        ιB b = weilSmoothCenterAwayToFrac ιB u hu (algebraMap B (Localization.Away u) b) :=
          (awayToFractionRing_algebraMap ιB u hu b).symm
        _ = weilSmoothCenterAwayToFrac ιB u hu (z * algebraMap B (Localization.Away u) (u ^ n)) := by
          rw [hmul]
        _ = 0 := by rw [map_mul, hz, zero_mul]
    have hb_eq : b = 0 := hInj (hb0.trans (map_zero ιB).symm)
    rw [hb_eq, map_zero, map_pow] at hmul
    have hUnit_pow : IsUnit ((algebraMap B (Localization.Away u) u) ^ n) :=
      IsUnit.pow n (IsLocalization.Away.algebraMap_isUnit u)
    exact hUnit_pow.mul_left_eq_zero.mp hmul
  have rees_to_other_exists :
      ∀ {R' K' D : Type u} [CommRing R'] [CommRing K'] [Algebra R' K']
        [CommRing D] [Algebra R' D] (L_D : D →ₐ[R'] K')
        {n : ℕ} (f : Fin n → R') (a : Fin n)
