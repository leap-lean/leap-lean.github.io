            rw [map_mul, awayToFractionRing_algebraMap, map_pow]
        _ = ιB b := by rw [hmul, awayToFractionRing_algebraMap]
    rw [map_mul, map_pow, hd_b, hd_inv, ← h1, mul_assoc, ← mul_pow,
      mul_inv_cancel₀ hu, one_pow, mul_one]
