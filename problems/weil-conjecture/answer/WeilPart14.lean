          rw [← hσ_fac]
          change e_S₃.base ((Spec.map (CommRingCat.ofHom σ)).base w) = e_S₃.base v
          rw [Spec.map_apply]
          exact congrArg e_S₃.base hw
      have hq₃_sec : RingHom.ker σ ≤ q₃.asIdeal := by
        change (q₃ : Spec S₃) ∈ {v : Spec S₃ | RingHom.ker σ ≤ v.asIdeal}
        rw [← hPre_eq]
        change e_S₂.base ((Spec.map (CommRingCat.ofHom loc_S₂)).base q₃) ∈ Set.range τ.base
        rw [Spec.map_apply]
        change e_S₂.base (PrimeSpectrum.comap loc_S₂ q₃_raw) ∈ Set.range τ.base
        rwa [hq₃, heS₂_q₂]
      let g₃ : MvPolynomial (Fin 1) A₃_ring →+* S₃_ring :=
        MvPolynomial.eval₂Hom φ₃ (fun i => loc_S₂ (g₂ (MvPolynomial.X i)))
      have hg₃_comp : g₃.comp MvPolynomial.C = φ₃ := by
        ext a
        simp [g₃]
      have hg₂_C : ∀ a : A₂_ring, g₂ (MvPolynomial.C a) = φ₂ a := RingHom.congr_fun hg₂_comp
      have hφ₃_loc : ∀ a : A₂_ring, φ₃ (loc_A₂ a) = loc_S₂ (φ₂ a) := RingHom.congr_fun hφ₃_comp
      have hg₃_comm : g₃.comp (MvPolynomial.map loc_A₂) = loc_S₂.comp g₂ := by
        apply MvPolynomial.ringHom_ext
        · intro a
          simp [g₃, hg₂_C, hφ₃_loc]
        · intro i
          simp [g₃]
      have hSpec_locA₂_et : Etale (Spec.map (CommRingCat.ofHom loc_A₂)) := inferInstance
      have hSpec_locS₂_et : Etale (Spec.map (CommRingCat.ofHom loc_S₂)) := inferInstance
      have hlocA₂_et : loc_A₂.Etale :=
        (HasRingHomProperty.Spec_iff (P := @Etale) (Q := @RingHom.Etale)).mp hSpec_locA₂_et
      have hlocS₂_et : loc_S₂.Etale :=
        (HasRingHomProperty.Spec_iff (P := @Etale) (Q := @RingHom.Etale)).mp hSpec_locS₂_et
      have hMap_locA₂_et : @RingHom.Etale (MvPolynomial (Fin 1) A₂_ring)
          (MvPolynomial (Fin 1) A₃_ring) _ _ (MvPolynomial.map loc_A₂) :=
        hMapEt (Fin 1) loc_A₂ hlocA₂_et
      have hRHS_et : (loc_S₂.comp g₂).Etale :=
        RingHom.Etale.stableUnderComposition _ _ hg₂_et hlocS₂_et
      let hom_g₃ : CommRingCat.of (MvPolynomial (Fin 1) A₃_ring) ⟶ S₃ :=
        @CommRingCat.ofHom (MvPolynomial (Fin 1) A₃_ring) S₃_ring _ _ g₃
      let hom_map_A₂ :
          CommRingCat.of (MvPolynomial (Fin 1) A₂_ring) ⟶
            CommRingCat.of (MvPolynomial (Fin 1) A₃_ring) :=
