    have h_dehom_pow : ∀ y : Submonoid.powers X_a, dehom y.1 = 1 := by
      rintro ⟨y, hy⟩
      obtain ⟨n, rfl⟩ := hy
      simp [dehom, X_a]
    have h_units : ∀ y : Submonoid.powers X_a, IsUnit (dehom y.1) := by
      intro y
      rw [h_dehom_pow y]
      exact isUnit_one
    let β_loc : Localization (Submonoid.powers X_a) →+* MvPolynomial τ K :=
      IsLocalization.lift (M := Submonoid.powers X_a) h_units
    have h_β_loc_mk : ∀ (p : MvPolynomial (Fin (N + 1)) K) (y : Submonoid.powers X_a),
