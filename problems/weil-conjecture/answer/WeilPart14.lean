      let I_B : Ideal (MvPolynomial (Fin 2) R_B) :=
        Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1 -
          MvPolynomial.C (algebraMap R₀ R_B h₀)} : Set (MvPolynomial (Fin 2) R_B))
      let Q_loc := MvPolynomial (Fin 2) R_B ⧸ I_B
