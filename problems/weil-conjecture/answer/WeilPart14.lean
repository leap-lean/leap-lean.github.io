        change v_star.asIdeal ⊔ RingHom.ker (Ideal.Quotient.mk I) = v_star.asIdeal
        rw [Ideal.mk_ker, sup_eq_left.mpr hIv]
      rw [← hComapP, ← hOverEq]
      rfl
    exact ⟨⟨w_star_id, hw_star_prime⟩, hw_star_le, hw_star_comap⟩
  
  have filter_away_commRingCat :
      ∀ {k₀ : Type u} [Field k₀] {m₀ : ℕ}
        (R₁ : CommRingCat.{u}) [IsDomain R₁]
        (ψ_loc : MvPolynomial (Fin (m₀ + 1)) k₀ →+* R₁) (_ : ψ_loc.Etale)
        (w₁ : Spec R₁) (J_cand : Finset (Fin (m₀ + 1))),
        ∃ (R'' : CommRingCat.{u}) (_ : IsDomain R'')
          (w₀ : Spec R'')
          (φ_out : R₁ ⟶ R'')
          (ψ''_out : MvPolynomial (Fin (m₀ + 1)) k₀ →+* R'')
          (I''_nc : Finset (Fin (m₀ + 1))),
          IsOpenImmersion (Spec.map φ_out) ∧
          Etale (Spec.map (CommRingCat.ofHom ψ''_out)) ∧
          (∀ p, ψ''_out p = φ_out.hom (ψ_loc p)) ∧
          (Spec.map φ_out).base w₀ = w₁ ∧
          I''_nc ⊆ J_cand ∧
          (∀ j ∈ I''_nc, ψ''_out (MvPolynomial.X j) ∈ w₀.asIdeal) ∧
          {p : Spec R'' | ∃ j ∈ J_cand, ψ''_out (MvPolynomial.X j) ∈ p.asIdeal} =
            {p : Spec R'' | ∃ j ∈ I''_nc, ψ''_out (MvPolynomial.X j) ∈ p.asIdeal} := by
    clear * -
    intro k _ m R₁ _ ψ_loc hEt_ψloc w₁ J_cand
    let _ := Classical.decPred (fun j : Fin (m + 1) => ψ_loc (MvPolynomial.X j) ∈ w₁.asIdeal)
    let I''_nc : Finset (Fin (m + 1)) :=
      J_cand.filter (fun j => ψ_loc (MvPolynomial.X j) ∈ w₁.asIdeal)
    let J_out : Finset (Fin (m + 1)) :=
      J_cand.filter (fun j => ψ_loc (MvPolynomial.X j) ∉ w₁.asIdeal)
    obtain ⟨s_out, hs_def⟩ : ∃ s : R₁, s = ∏ j ∈ J_out, ψ_loc (MvPolynomial.X j) := ⟨_, rfl⟩
    have hs_not_w₁ : s_out ∉ w₁.asIdeal := by
      rw [hs_def]
      intro hmem
      obtain ⟨j, hj_out, hj_mem⟩ := w₁.isPrime.prod_mem_iff.mp hmem
      exact (Finset.mem_filter.mp hj_out).2 hj_mem
    have hs_ne : s_out ≠ 0 := fun h0 => hs_not_w₁ (h0 ▸ w₁.asIdeal.zero_mem)
    have hDomOut : IsDomain (Localization.Away s_out) :=
      IsLocalization.isDomain_localization (M := Submonoid.powers s_out)
        (Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hs_ne))
    have hw₁_range : w₁ ∈ Set.range (PrimeSpectrum.comap (algebraMap R₁ (Localization.Away s_out))) := by
      rw [PrimeSpectrum.localization_away_comap_range (Localization.Away s_out) s_out]
      exact hs_not_w₁
    obtain ⟨w₀, hw₀⟩ := hw₁_range
    let R'' : CommRingCat.{u} := CommRingCat.of (Localization.Away s_out)
    let φ_out : R₁ ⟶ R'' :=
      CommRingCat.ofHom (algebraMap R₁ (Localization.Away s_out))
    let ψ''_out : MvPolynomial (Fin (m + 1)) k →+* R'' := φ_out.hom.comp ψ_loc
    have _ : IsOpenImmersion (Spec.map φ_out) :=
      IsOpenImmersion.of_isLocalization s_out
    have _ : Etale (Spec.map (CommRingCat.ofHom ψ_loc)) :=
      (HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hEt_ψloc
    have hEt_out : Etale (Spec.map (CommRingCat.ofHom ψ''_out)) := by
      have hComp : Spec.map (CommRingCat.ofHom ψ''_out) =
          Spec.map φ_out ≫ Spec.map (CommRingCat.ofHom ψ_loc) := by
        rw [← Spec.map_comp]; rfl
      rw [hComp]; exact inferInstance
    refine ⟨R'', hDomOut, w₀, φ_out, ψ''_out, I''_nc, inferInstance, hEt_out, fun _ => rfl, hw₀,
      Finset.filter_subset _ _, ?_, ?_⟩
    · intro j hj
      have hj_w₁ : ψ_loc (MvPolynomial.X j) ∈ w₁.asIdeal := (Finset.mem_filter.mp hj).2
      rw [← hw₀] at hj_w₁
      exact hj_w₁
    · ext p
      constructor
      · rintro ⟨j, hj_cand, hjp⟩
        by_cases hj_in : ψ_loc (MvPolynomial.X j) ∈ w₁.asIdeal
        · exact ⟨j, Finset.mem_filter.mpr ⟨hj_cand, hj_in⟩, hjp⟩
        · exfalso
          have hj_out : j ∈ J_out := Finset.mem_filter.mpr ⟨hj_cand, hj_in⟩
          have hdvd : ψ_loc (MvPolynomial.X j) ∣ s_out := by
            rw [hs_def]; exact Finset.dvd_prod_of_mem _ hj_out
          have hUnit_j : IsUnit (φ_out.hom (ψ_loc (MvPolynomial.X j))) :=
            isUnit_of_dvd_unit (map_dvd _ hdvd) (IsLocalization.Away.algebraMap_isUnit s_out)
          exact p.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem p.asIdeal hjp hUnit_j)
      · rintro ⟨j, hj_in, hjp⟩
        exact ⟨j, (Finset.mem_filter.mp hj_in).1, hjp⟩
  
  have coord_loc_collapse_and_closure :
      ∀ {k₀ : Type u} [Field k₀] {m₀ : ℕ}
        {R' B₀ : Type u} [CommRing R'] [CommRing B₀]
        (f : R' →+* B₀) (ψ : MvPolynomial (Fin (m₀ + 1)) k₀ →+* R')
        (ψ'' : MvPolynomial (Fin (m₀ + 1)) k₀ →+* B₀) (_ : ψ''.Etale)
        (I_nc : Finset (Fin (m₀ + 1))) (j_piv : Fin (m₀ + 1)) (_ : j_piv ∈ I_nc)
        (_ : ψ'' (MvPolynomial.X j_piv) = f (ψ (MvPolynomial.X j_piv)))
        (_ : ∀ j ∈ I_nc, j ≠ j_piv →
          f (ψ (MvPolynomial.X j)) = ψ'' (MvPolynomial.X j_piv) * ψ'' (MvPolynomial.X j))
