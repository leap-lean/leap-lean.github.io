    ∃ (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (Z_W : Set W.left) (π₄ : W ⟶ S),
      AlgebraicGeometry.IsIntegral W.left ∧
      IsProjectiveOverField k W ∧
      AlgebraicGeometry.SmoothOfRelativeDimension (m + 1) W.hom ∧
      IsSncDivisorSupport k (m + 1) W Z_W ∧
      IsGenFiniteEtaleAlterationOver k π₄ ∧
      π₄.left.base ⁻¹' Z_S ⊆ Z_W :=
by
  obtain ⟨hClosedZ, hCharts⟩ := hNc
  have hInit : IsSplitEtaleNcPair k m (m + 1) S Z_S := by
    refine ⟨0, Fin.elim0, fun a => Fin.elim0 a, Z_S, ?_, ?_, ?_, ?_, hClosedZ, ?_, ?_⟩
    · intro a; exact Fin.elim0 a
    · intro a; exact Fin.elim0 a
    · intro a; exact Fin.elim0 a
    · intro a₁; exact Fin.elim0 a₁
    · simp
    · intro x
      obtain ⟨R', v₀, e_S, ψ, I, hEt_e, hEt_ψ, hv₀, hComm, hVan_I, hPre_Z⟩ := hCharts x
      refine ⟨R', v₀, e_S, ψ, fun a => Fin.elim0 a.1, I,
        hEt_e, hEt_ψ, hv₀, hComm, ?_, ?_, ?_, ?_, hVan_I, ?_, ?_, hPre_Z⟩
      · intro a; exact Fin.elim0 a.1
      · intro a; exact Fin.elim0 a.1
      · exact (Finset.card_le_univ I).trans_eq (Fintype.card_fin (m + 1))
      · intro a; exact Fin.elim0 a.1
      · intro a; exact Fin.elim0 a
      · intro a; exact Fin.elim0 a
  have hInd : ∀ (b : ℕ) (_ : b ≤ m)
      (S' : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (Z_total : Set S'.left)
      (_ : AlgebraicGeometry.IsIntegral S'.left)
      (_ : IsProjectiveOverField k S')
      (_ : AlgebraicGeometry.SmoothOfRelativeDimension (m + 1) S'.hom)
      (_ : IsSplitEtaleNcPair k m (b + 1) S' Z_total),
      ∃ (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (Z_W : Set W.left) (π : W ⟶ S'),
