        rfl
      obtain ⟨j_ℓ, hOpen_jℓ, hComm_jℓ, hCov_jℓ⟩ :=
        hSingleChart (U_ℓ ℓ) (idx ℓ) (hU_le ℓ) (B'_ℓ ℓ) (φ_ℓ ℓ) hFlat_ℓ
          (g_ℓ ℓ) hg_nzd_ℓ hMapIdeal_ℓ
      exact ⟨e_ℓ, j_ℓ, he_ℓ, hOpen_jℓ, hComm_jℓ, hCov_jℓ⟩
    choose e_ℓ j_ℓ he_ℓ hOpen_jℓ hComm_jℓ hCov_jℓ using hStage1
    
    have hPull_ℓ : ∀ ℓ : Fin q,
        ∃ v_ℓ : Q_ℓ ℓ ⟶ Q,
          AlgebraicGeometry.IsOpenImmersion v_ℓ ∧
          (v_ℓ ≫ q_snd = q_snd_ℓ ℓ ≫ AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap (↑B') (B'_ℓ ℓ)))) ∧
          Set.range v_ℓ.base = q_snd.base ⁻¹'
            Set.range (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap (↑B') (B'_ℓ ℓ)))).base :=
      fun ℓ => hBasicPull U B' φ_U (s ℓ)
    choose v_ℓ hOpen_vℓ hComm_vℓ hRange_vℓ using hPull_ℓ
    let ι_q := ULift.{u} (Fin q)
    let W_U : ι_q → Q.Opens := fun p =>
      letI := hOpen_vℓ p.down
      (v_ℓ p.down).opensRange
    have hSpan_φs : Ideal.span (Set.range fun ℓ : Fin q => φ_U (s ℓ)) = ⊤ := by
      have hEq : (Set.range fun ℓ : Fin q => φ_U (s ℓ)) = φ_U '' Set.range s := by
        ext x
        exact ⟨fun ⟨ℓ, hℓ⟩ => ⟨s ℓ, ⟨ℓ, rfl⟩, hℓ⟩,
          fun ⟨_, ⟨ℓ, rfl⟩, hℓ⟩ => ⟨ℓ, hℓ⟩⟩
      rw [hEq, ← Ideal.map_span, hs_span, Ideal.map_top]
    have hCov_WU : (⨆ p : ι_q, W_U p) = ⊤ := by
      rw [eq_top_iff]
      intro z _
      rw [TopologicalSpace.Opens.mem_iSup]
      let p_B := q_snd.base z
      have h1_B : (1 : ↑B') ∈ Ideal.span (Set.range fun ℓ : Fin q => φ_U (s ℓ)) := by
        rw [hSpan_φs]; trivial
      have hEx_ℓ : ∃ ℓ : Fin q, φ_U (s ℓ) ∉ p_B.asIdeal := by
        by_contra hAllMem
        push_neg at hAllMem
        have hSpanLe : Ideal.span (Set.range fun ℓ : Fin q => φ_U (s ℓ)) ≤ p_B.asIdeal := by
          rw [Ideal.span_le]
          rintro _ ⟨ℓ, rfl⟩
          exact hAllMem ℓ
        exact p_B.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr (hSpanLe h1_B))
      obtain ⟨ℓ, hℓ_not⟩ := hEx_ℓ
      have hp_basic : p_B ∈ (PrimeSpectrum.basicOpen (φ_U (s ℓ)) : Set (PrimeSpectrum ↑B')) :=
        hℓ_not
      rw [← PrimeSpectrum.localization_away_comap_range (B'_ℓ ℓ) (φ_U (s ℓ))] at hp_basic
      refine ⟨ULift.up ℓ, ?_⟩
      change z ∈ Set.range (v_ℓ ℓ).base
      rw [hRange_vℓ ℓ]
      exact hp_basic
    haveI : CategoryTheory.IsIso (q_snd ∣_ (f_U ⁻¹ᵁ U_compl)) := hIsoPull U B' φ_U
    haveI : AlgebraicGeometry.IsSeparated q_snd := inferInstance
    letI : ∀ b : Fin r, CommRing ↥(A_b b) := fun b => (A_b b).toCommRing
    let θ_U : ∀ (b : Fin r) (p : ι_q), ↥(A_b b) :=
      fun b p => algebraMap (↑B') ↥(A_b b) (φ_U (s p.down))
    letI : ∀ (b : Fin r) (p : ι_q), CommRing (Localization.Away (θ_U b p)) :=
      fun _ _ => OreLocalization.instCommRing
    letI : ∀ (ℓ : Fin q) (b : Fin r), CommRing ↥(A_ℓ ℓ b) :=
      fun ℓ b => (A_ℓ ℓ b).toCommRing
    let loc_θ : ∀ (b : Fin r) (p : ι_q),
        CommRingCat.of ↥(A_b b) ⟶ CommRingCat.of (Localization.Away (θ_U b p)) :=
      fun b p => CommRingCat.ofHom (algebraMap ↥(A_b b) (Localization.Away (θ_U b p)))
    let hom_e : ∀ (b : Fin r) (p : ι_q),
        CommRingCat.of (Localization.Away (θ_U b p)) ⟶ CommRingCat.of ↥(A_ℓ p.down b) :=
      fun b p => CommRingCat.ofHom (e_ℓ p.down b).toRingHom
    let inv_e : ∀ (b : Fin r) (p : ι_q),
        CommRingCat.of ↥(A_ℓ p.down b) ⟶ CommRingCat.of (Localization.Away (θ_U b p)) :=
      fun b p => CommRingCat.ofHom (e_ℓ p.down b).symm.toRingHom
    let J_loc : ∀ (b : Fin r) (p : ι_q),
        AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (θ_U b p))) ⟶ Q :=
      fun b p =>
        AlgebraicGeometry.Spec.map (inv_e b p) ≫ j_ℓ p.down b ≫ v_ℓ p.down
    have hIso_e : ∀ (b : Fin r) (p : ι_q),
        CategoryTheory.IsIso (AlgebraicGeometry.Spec.map (inv_e b p)) := by
      intro b p
      refine ⟨⟨AlgebraicGeometry.Spec.map (hom_e b p), ?_, ?_⟩⟩
      · rw [← AlgebraicGeometry.Spec.map_comp]
        have h1 : hom_e b p ≫ inv_e b p = 𝟙 _ := by
          apply CommRingCat.hom_ext; apply RingHom.ext; intro x
          exact (e_ℓ p.down b).symm_apply_apply x
        rw [h1, AlgebraicGeometry.Spec.map_id]
      · rw [← AlgebraicGeometry.Spec.map_comp]
        have h1 : inv_e b p ≫ hom_e b p = 𝟙 _ := by
          apply CommRingCat.hom_ext; apply RingHom.ext; intro x
          exact (e_ℓ p.down b).apply_symm_apply x
        rw [h1, AlgebraicGeometry.Spec.map_id]
    have hStage2 : ∀ b : Fin r,
        ∃ j_b : AlgebraicGeometry.Spec (CommRingCat.of ↥(A_b b)) ⟶ Q,
          AlgebraicGeometry.IsOpenImmersion j_b ∧
          (j_b ≫ q_snd = AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap (↑B') ↥(A_b b)) :
              B' ⟶ CommRingCat.of ↥(A_b b))) ∧
          (∀ p : ι_q, Set.range j_b.base ∩ (W_U p : Set ↥Q) = Set.range (J_loc b p).base) := by
      intro b
      have hRangeL_U : Set.range (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          ((A_b b).val.toRingHom.comp (algebraMap (↑B') ↥(A_b b))) :
            B' ⟶ CommRingCat.of (Localization.Away (g b)))).base ⊆
          ((f_U ⁻¹ᵁ U_compl : (AlgebraicGeometry.Spec B').Opens) :
            Set ↥(AlgebraicGeometry.Spec B')) := by
        have hgb_mem : g b ∈ Ideal.map φ_U (I.ideal U) := by
          rw [hSpan]
          exact Ideal.subset_span ⟨b, rfl⟩
        exact hGenSupport U B' φ_U (g b) hgb_mem
      have hSpanθ_U : Ideal.span (Set.range (θ_U b)) = ⊤ := by
        have hEqRange : Set.range (θ_U b) =
            algebraMap (↑B') ↥(A_b b) '' (Set.range fun ℓ : Fin q => φ_U (s ℓ)) := by
          ext x
          simp only [Set.mem_range, Set.mem_image, θ_U]
          exact ⟨fun ⟨p, hp⟩ => ⟨_, ⟨p.down, rfl⟩, hp⟩,
            fun ⟨_, ⟨ℓ, rfl⟩, hp⟩ => ⟨ULift.up ℓ, hp⟩⟩
        rw [hEqRange, ← Ideal.map_span, hSpan_φs, Ideal.map_top]
      have hComm_J : ∀ p : ι_q, J_loc b p ≫ q_snd =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            ((algebraMap ↥(A_b b) (Localization.Away (θ_U b p))).comp
              (algebraMap (↑B') ↥(A_b b))) :
            B' ⟶ CommRingCat.of (Localization.Away (θ_U b p))) := by
        intro p
        dsimp [J_loc]
        rw [Category.assoc, Category.assoc, hComm_vℓ p.down,
          ← Category.assoc (j_ℓ p.down b), hComm_jℓ p.down b]
        rw [← Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
          ← AlgebraicGeometry.Spec.map_comp]
        congr 1
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro x
        change (e_ℓ p.down b).symm (algebraMap (B'_ℓ p.down) ↥(A_ℓ p.down b)
          (algebraMap (↑B') (B'_ℓ p.down) x)) = _
        rw [← he_ℓ p.down b x, RingEquiv.symm_apply_apply]
        rfl
      have hOpen_J : ∀ p : ι_q, AlgebraicGeometry.IsOpenImmersion (J_loc b p) := by
        intro p
        haveI := hIso_e b p
        haveI := hOpen_jℓ p.down b
        haveI := hOpen_vℓ p.down
        dsimp [J_loc]
        infer_instance
      have hPre_J : ∀ (j : AlgebraicGeometry.Spec (CommRingCat.of ↥(A_b b)) ⟶ Q),
          (j ≫ q_snd) = AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap (↑B') ↥(A_b b)) :
              B' ⟶ CommRingCat.of ↥(A_b b)) →
          (∀ p : ι_q, (AlgebraicGeometry.Spec.map (loc_θ b p) ≫ j) = J_loc b p) →
          ∀ p : ι_q, j.base ⁻¹' (W_U p : Set ↥Q) =
            Set.range (AlgebraicGeometry.Spec.map (loc_θ b p)).base := by
        intro j hj_snd _ p
        ext x
        change j.base x ∈ Set.range (v_ℓ p.down).base ↔ _
        rw [hRange_vℓ p.down]
        have h_lhs : q_snd.base (j.base x) =
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap (↑B') ↥(A_b b)) :
                B' ⟶ CommRingCat.of ↥(A_b b))).base x :=
          congrArg (fun m => m.base x) hj_snd
        change q_snd.base (j.base x) ∈
            Set.range (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap (↑B') (B'_ℓ p.down)))).base ↔ _
        rw [h_lhs]
        change (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap (↑B') ↥(A_b b)) :
              B' ⟶ CommRingCat.of ↥(A_b b))).base x ∈
          Set.range (PrimeSpectrum.comap (algebraMap (↑B') (B'_ℓ p.down))) ↔
          x ∈ Set.range (PrimeSpectrum.comap
            (algebraMap ↥(A_b b) (Localization.Away (θ_U b p))))
        rw [PrimeSpectrum.localization_away_comap_range (B'_ℓ p.down) (φ_U (s p.down)),
          PrimeSpectrum.localization_away_comap_range
            (Localization.Away (θ_U b p)) (θ_U b p)]
        rfl
      obtain ⟨j_b, hOpen_jb, hComm_jb, _, hInter_jb⟩ :=
        weil_separated_generic_iso_gluing_of_away_openImmersions
          B' Q q_snd (f_U ⁻¹ᵁ U_compl)
          ↥(A_b b) (Localization.Away (g b))
          (algebraMap (↑B') ↥(A_b b)) (A_b b).val.toRingHom
          (θ_U b) (J_loc b) W_U
          Subtype.val_injective hRangeL_U hSpanθ_U hComm_J hCov_WU hOpen_J hPre_J
      exact ⟨j_b, hOpen_jb, hComm_jb, hInter_jb⟩
    choose j_b hOpen_jb hComm_jb hInter_jb using hStage2
    let W : Fin r → Q.Opens := fun b =>
      letI := hOpen_jb b
      (j_b b).opensRange
    let isoW : ∀ b : Fin r, (W b).toScheme ≅
        AlgebraicGeometry.Spec (CommRingCat.of ↥(A_b b)) := fun b =>
      letI := hOpen_jb b
      (j_b b).isoOpensRange.symm
    refine ⟨W, isoW, ?_, ?_⟩
    · rw [eq_top_iff]
      intro z _
      rw [TopologicalSpace.Opens.mem_iSup]
      have hz_WU : z ∈ (⨆ p : ι_q, W_U p) := by
        rw [hCov_WU]; trivial
      rw [TopologicalSpace.Opens.mem_iSup] at hz_WU
      obtain ⟨p, hz_p⟩ := hz_WU
      obtain ⟨z_ℓ, hz_ℓ⟩ : z ∈ Set.range (v_ℓ p.down).base := hz_p
      rw [← hz_ℓ]
      have hz_jℓ : z_ℓ ∈ (Set.univ : Set ↥(Q_ℓ p.down)) := Set.mem_univ _
      rw [← hCov_jℓ p.down, Set.mem_iUnion] at hz_jℓ
      obtain ⟨b, y, hy⟩ := hz_jℓ
      rw [← hy]
      refine ⟨b, ?_⟩
      change (v_ℓ p.down).base ((j_ℓ p.down b).base y) ∈ Set.range (j_b b).base
      have hz_J : (v_ℓ p.down).base ((j_ℓ p.down b).base y) ∈ Set.range (J_loc b p).base := by
        refine ⟨(AlgebraicGeometry.Spec.map (hom_e b p)).base y, ?_⟩
        have hy_eq : (AlgebraicGeometry.Spec.map (inv_e b p)).base
            ((AlgebraicGeometry.Spec.map (hom_e b p)).base y) = y := by
          change (AlgebraicGeometry.Spec.map (hom_e b p) ≫
            AlgebraicGeometry.Spec.map (inv_e b p)).base y = y
          rw [← AlgebraicGeometry.Spec.map_comp]
          have h1 : inv_e b p ≫ hom_e b p = 𝟙 _ := by
            apply CommRingCat.hom_ext; apply RingHom.ext; intro x
            exact (e_ℓ p.down b).apply_symm_apply x
          rw [h1, AlgebraicGeometry.Spec.map_id]
          rfl
        dsimp [J_loc]
        change (v_ℓ p.down).base ((j_ℓ p.down b).base
          ((AlgebraicGeometry.Spec.map (inv_e b p)).base _)) = _
        rw [hy_eq]
      rw [← hInter_jb b p] at hz_J
      exact hz_J.1
    · intro b
      letI := hOpen_jb b
      have h_ι : (W b).ι = (isoW b).hom ≫ j_b b := by
        dsimp [W, isoW]
        calc
          (j_b b).opensRange.ι = 𝟙 _ ≫ (j_b b).opensRange.ι := (Category.id_comp _).symm
          _ = ((j_b b).isoOpensRange.inv ≫ (j_b b).isoOpensRange.hom) ≫
              (j_b b).opensRange.ι := by rw [CategoryTheory.Iso.inv_hom_id]
          _ = (j_b b).isoOpensRange.inv ≫
              ((j_b b).isoOpensRange.hom ≫ (j_b b).opensRange.ι) := Category.assoc _ _ _
          _ = (j_b b).isoOpensRange.inv ≫ j_b b := by
            rw [AlgebraicGeometry.Scheme.Hom.isoOpensRange_hom_ι]
      rw [h_ι, Category.assoc, hComm_jb b]

theorem weil_projective_blowup_of_idealSheaf (k : Type u) [Field k]
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hIntX : AlgebraicGeometry.IsIntegral X.left)
    (hProjX : IsProjectiveOverField k X)
    (I : X.left.IdealSheafData)
    (hSupp : (I.support : Set X.left) ≠ Set.univ) :
    ∃ (X' : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (π : X' ⟶ X),
      IsProjectiveIdealBlowupOver k I π :=
by
  obtain ⟨hNoethX, m, U_cov, L, h, hCov, hSpan, hCocycle⟩ :=
    weil_idealSheaf_proj_chart_cocycle_generators k X hProjX I hSupp
  have : TopologicalSpace.NoetherianSpace ↥X.left := hNoethX
  let U_compl : X.left.Opens := ⟨(I.support : Set X.left)ᶜ, (I.support).2.isOpen_compl⟩
  obtain ⟨Φ₀, hRat⟩ :=
    weil_cocycle_rational_map_to_proj k X I U_compl rfl m U_cov L h hCov hSpan hCocycle
  have hΦ₀ : Φ₀ ≫ (weilProjectiveSpaceOver k L).hom = U_compl.ι ≫ X.hom := hRat.2.2.2.2.1
  let P_L := weilProjectiveSpaceOver k L
  let δ : U_compl.toScheme ⟶ CategoryTheory.Limits.pullback X.hom P_L.hom :=
    CategoryTheory.Limits.pullback.lift U_compl.ι Φ₀ hΦ₀.symm
  let π_left : δ.image ⟶ X.left :=
    δ.imageι ≫ CategoryTheory.Limits.pullback.fst X.hom P_L.hom
  let X' : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    CategoryTheory.Over.mk (π_left ≫ X.hom)
  let π : X' ⟶ X := CategoryTheory.Over.homMk π_left rfl
  
  let S_k : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    CategoryTheory.Over.mk (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)))
  have hProjSk : IsProjectiveOverField k S_k := by
    let 𝒜₀ := MvPolynomial.homogeneousSubmodule (Fin (0 + 1)) k
    let inst₀ : GradedAlgebra 𝒜₀ := MvPolynomial.gradedAlgebra
    let ev : MvPolynomial (Fin (0 + 1)) k →+* k := MvPolynomial.eval (fun _ => (1 : k))
    have hev : IsUnit (ev (MvPolynomial.X 0)) := by
      simp [ev]
    let lift_ev :
        Localization.Away (MvPolynomial.X (0 : Fin (0 + 1)) : MvPolynomial (Fin (0 + 1)) k) →+* k :=
      IsLocalization.Away.lift (MvPolynomial.X 0) hev
    let valHom : @HomogeneousLocalization.Away _ _ _ _ _ 𝒜₀ (MvPolynomial.X 0) →+*
        Localization.Away (MvPolynomial.X (0 : Fin (0 + 1)) : MvPolynomial (Fin (0 + 1)) k) :=
      @RingHom.mk _ _ (@HomogeneousLocalization.homogeneousLocalizationCommRing _ _ _ _ _ _ _ _ 𝒜₀
          inst₀ _).toSemiring.toNonAssocSemiring _
        (@MonoidHom.mk _ _ _ _ (@OneHom.mk _ _ _ _ HomogeneousLocalization.val
          (@HomogeneousLocalization.val_one _ _ _ _ _ _ _ _ 𝒜₀ inst₀ _))
          (@HomogeneousLocalization.val_mul _ _ _ _ _ _ _ _ 𝒜₀ inst₀ _))
        (@HomogeneousLocalization.val_zero _ _ _ _ _ _ _ _ 𝒜₀ inst₀ _)
        (@HomogeneousLocalization.val_add _ _ _ _ _ _ _ _ 𝒜₀ inst₀ _)
    let θ := lift_ev.comp valHom
    let w₀ : AlgebraicGeometry.Spec (CommRingCat.of
        (@HomogeneousLocalization.Away _ _ _ _ _ 𝒜₀ (MvPolynomial.X 0))) ⟶
        @AlgebraicGeometry.Proj _ _ _ _ _ 𝒜₀ inst₀ :=
      @AlgebraicGeometry.Proj.awayι _ _ _ _ _ 𝒜₀ inst₀ (MvPolynomial.X 0) 1
        (MvPolynomial.isHomogeneous_X k 0) zero_lt_one
    let s_left : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ (weilProjectiveSpaceOver k 0).left :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ) ≫ w₀
    have hs_comp : s_left ≫ (weilProjectiveSpaceOver k 0).hom =
        𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) := by
      have h_away : w₀ ≫ @AlgebraicGeometry.Proj.toSpecZero _ _ _ _ _ 𝒜₀ inst₀ =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (@HomogeneousLocalization.fromZeroRingHom _ _ _ _ _ _ _ _ 𝒜₀ inst₀
              (Submonoid.powers (MvPolynomial.X 0)))) :=
        @AlgebraicGeometry.Proj.awayι_toSpecZero _ _ _ _ _ 𝒜₀ inst₀
          (MvPolynomial.X 0) 1 (MvPolynomial.isHomogeneous_X k 0) zero_lt_one
      have h1 : s_left ≫ (weilProjectiveSpaceOver k 0).hom =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ) ≫
            ((w₀ ≫ @AlgebraicGeometry.Proj.toSpecZero _ _ _ _ _ 𝒜₀ inst₀) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜₀ 0)))) := by
        change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ) ≫ w₀) ≫
          (@AlgebraicGeometry.Proj.toSpecZero _ _ _ _ _ 𝒜₀ inst₀ ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜₀ 0)))) = _
        simp only [Category.assoc]
      have h2 : AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ) ≫
          ((w₀ ≫ @AlgebraicGeometry.Proj.toSpecZero _ _ _ _ _ 𝒜₀ inst₀) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜₀ 0)))) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ) ≫
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (@HomogeneousLocalization.fromZeroRingHom _ _ _ _ _ _ _ _ 𝒜₀ inst₀
                (Submonoid.powers (MvPolynomial.X 0)))) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜₀ 0)))) :=
        congrArg (fun f => AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ) ≫
          (f ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜₀ 0))))) h_away
      rw [h1, h2, ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
      have hid : (θ.comp ((@HomogeneousLocalization.fromZeroRingHom _ _ _ _ _ _ _ _ 𝒜₀
          inst₀ (Submonoid.powers (MvPolynomial.X 0))).comp (algebraMap k ↥(𝒜₀ 0)))) =
          RingHom.id k := by
        ext c
        change lift_ev (@HomogeneousLocalization.val _ _ _ _ _ 𝒜₀ _
          (HomogeneousLocalization.mk
            { deg := 0
              num := (algebraMap k ↥(𝒜₀ 0)) c
              den := ⟨1, SetLike.one_mem_graded 𝒜₀⟩
              den_mem := Submonoid.one_mem _ })) = c
        rw [HomogeneousLocalization.val_mk]
        change lift_ev (Localization.mk ((algebraMap k ↥(𝒜₀ 0)) c).1 1) = c
        rw [Localization.mk_one_eq_algebraMap, IsLocalization.Away.lift_eq]
        rw [Algebra.algebraMap_eq_smul_one]
        simp [ev, MvPolynomial.smul_eq_C_mul]
      change AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (θ.comp ((@HomogeneousLocalization.fromZeroRingHom _ _ _ _ _ _ _ _ 𝒜₀
          inst₀ (Submonoid.powers (MvPolynomial.X 0))).comp (algebraMap k ↥(𝒜₀ 0))))) = _
      rw [hid, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
    have hSep : AlgebraicGeometry.IsSeparated (weilProjectiveSpaceOver k 0).hom :=
      MorphismProperty.comp_mem _ _ _ (@AlgebraicGeometry.Proj.isSeparated _ _ _ _ _ 𝒜₀ inst₀)
        inferInstance
    have hCl_comp : AlgebraicGeometry.IsClosedImmersion
        (s_left ≫ (weilProjectiveSpaceOver k 0).hom) := by
      rw [hs_comp]
      infer_instance
    have hCl_s : AlgebraicGeometry.IsClosedImmersion s_left :=
      @AlgebraicGeometry.IsClosedImmersion.of_comp _ _ _ s_left
        (weilProjectiveSpaceOver k 0).hom hCl_comp hSep
    exact ⟨0, CategoryTheory.Over.homMk s_left hs_comp, hCl_s⟩
  
  have hProjPL : IsProjectiveOverField k P_L :=
    ⟨L, 𝟙 P_L, by change AlgebraicGeometry.IsClosedImmersion (𝟙 P_L.left); infer_instance⟩
  let f_X : X ⟶ S_k := CategoryTheory.Over.homMk X.hom (Category.comp_id _)
  let ψ_PL : P_L ⟶ S_k := CategoryTheory.Over.homMk P_L.hom (Category.comp_id _)
  let P_prod : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    CategoryTheory.Over.mk (CategoryTheory.Limits.pullback.fst X.hom P_L.hom ≫ X.hom)
  let ψ_prod : P_prod ⟶ X :=
    CategoryTheory.Over.homMk (CategoryTheory.Limits.pullback.fst X.hom P_L.hom) rfl
  let f_prod : P_prod ⟶ P_L :=
    CategoryTheory.Over.homMk (CategoryTheory.Limits.pullback.snd X.hom P_L.hom)
      CategoryTheory.Limits.pullback.condition.symm
  have hPb : CategoryTheory.IsPullback ψ_prod.left f_prod.left f_X.left ψ_PL.left :=
    CategoryTheory.IsPullback.of_hasPullback X.hom P_L.hom
  obtain ⟨N_P, ι_P, hCl_P⟩ :=
    weil_projectiveOverField_pullback k f_X ψ_PL f_prod ψ_prod hPb hProjSk hProjX hProjPL
  let j_X' : X' ⟶ P_prod :=
    CategoryTheory.Over.homMk δ.imageι (Category.assoc _ _ _).symm
  have hProjX' : IsProjectiveOverField k X' := by
    refine ⟨N_P, j_X' ≫ ι_P, ?_⟩
    change AlgebraicGeometry.IsClosedImmersion (δ.imageι ≫ ι_P.left)
    have : AlgebraicGeometry.IsClosedImmersion ι_P.left := hCl_P
    infer_instance
  
  obtain ⟨hIntX', hPropπ, hSurjπ, hIsoπ⟩ :=
    weil_graph_closure_blowup_proper_surj_iso k X hIntX I hSupp U_compl rfl L Φ₀ hΦ₀
  refine ⟨X', π, hIntX', hProjX', hPropπ, hSurjπ, hIsoπ, ?_⟩
  intro U B' φ_U r g hFlat hg_nzd hSpan_g
  exact weil_graph_closure_flat_rees_pullback_charts k X hIntX I hSupp U_compl U_cov L h
    Φ₀ hΦ₀ hRat U B' φ_U r g hFlat hg_nzd hSpan_g

theorem weil_smoothOfRelativeDimension_and_toroidal_sing_of_etale (k : Type u) [Field k] [IsAlgClosed k]
    (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hProjY : IsProjectiveOverField k Y) (y : Y.left) :
    (∀ (d : ℕ) (R' : CommRingCat.{u}) (v₀ : AlgebraicGeometry.Spec R')
        (e_Y : AlgebraicGeometry.Spec R' ⟶ Y.left)
        (ψ : MvPolynomial (Fin d) k →+* R'),
      AlgebraicGeometry.Etale e_Y →
      AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) →
      e_Y.base v₀ = y →
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = e_Y ≫ Y.hom →
      ∃ V : Y.left.Opens,
        y ∈ V ∧ AlgebraicGeometry.SmoothOfRelativeDimension d (V.ι ≫ Y.hom)) ∧
    (∀ (m : ℕ) (R' : CommRingCat.{u}) (v₀ : AlgebraicGeometry.Spec R')
        (e_Y : AlgebraicGeometry.Spec R' ⟶ Y.left)
        (a : Fin m → ℕ) (S₀ : Finset (Fin m))
        (q : AlgebraicGeometry.Spec R' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
          (MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ Ideal.span
            {MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
              ∏ c : Fin m, MvPolynomial.X (Sum.inr c) ^ a c}))),
      AlgebraicGeometry.Etale e_Y →
      AlgebraicGeometry.Etale q →
      e_Y.base v₀ = y →
      q ≫ AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) = e_Y ≫ Y.hom →
      (∀ b : Fin 2,
        Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl b)) ∈ (q.base v₀).asIdeal) →
      (∀ c ∈ S₀,
        Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c)) ∈ (q.base v₀).asIdeal) →
      2 ≤ (∑ c ∈ S₀, a c) →
      ¬ ∃ V : Y.left.Opens,
        y ∈ V ∧ AlgebraicGeometry.SmoothOfRelativeDimension (m + 1) (V.ι ≫ Y.hom)) :=
by
  
  have h_s1 : AlgebraicGeometry.LocallyOfFiniteType Y.hom := by
    obtain ⟨N, ι, hCl⟩ := hProjY
    have : AlgebraicGeometry.IsClosedImmersion ι.left := hCl
    rw [← CategoryTheory.Over.w ι]
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    let : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have : IsScalarTower k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
      ⟨fun c x p => smul_mul_assoc c (x : MvPolynomial (Fin (N + 1)) k) p⟩
    have : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
      Algebra.FiniteType.of_restrictScalars_finiteType k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k)
    have hSurj : Function.Surjective (algebraMap k ↥(𝒜 0)) := by
      intro x
      have hx : x.1 ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0 := x.2
      rw [MvPolynomial.homogeneousSubmodule_zero, Submodule.mem_one] at hx
      rcases hx with ⟨c, hc⟩
      exact ⟨c, Subtype.ext hc⟩
    have hFT_zero : (algebraMap k ↥(𝒜 0)).FiniteType :=
      RingHom.FiniteType.of_surjective _ hSurj
    have hLFT_spec : AlgebraicGeometry.LocallyOfFiniteType
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType)).mpr hFT_zero
    have hLFT_proj : AlgebraicGeometry.LocallyOfFiniteType (AlgebraicGeometry.Proj.toSpecZero 𝒜) :=
      @AlgebraicGeometry.Proj.instLocallyOfFiniteTypeToSpecZeroOfFiniteTypeSubtypeMemOfNatNat
        _ _ _ _ _ 𝒜 _ _
    have : AlgebraicGeometry.LocallyOfFiniteType (weilProjectiveSpaceOver k N).hom :=
      MorphismProperty.comp_mem _ _ _ hLFT_proj hLFT_spec
    infer_instance
  
  have h_spec_sm : ∀ {R S : CommRingCat.{u}} (f : R ⟶ S) (d : ℕ),
      RingHom.IsStandardSmoothOfRelativeDimension d f.hom →
      AlgebraicGeometry.SmoothOfRelativeDimension d (AlgebraicGeometry.Spec.map f) := by
    intro R S f d hStd
    rw [AlgebraicGeometry.smoothOfRelativeDimension_iff]
    intro x
    let hU : IsAffineOpen (⊤ : (Spec R).Opens) := isAffineOpen_top (Spec R)
    let hV : IsAffineOpen (⊤ : (Spec S).Opens) := isAffineOpen_top (Spec S)
    have he : (⊤ : (Spec S).Opens) ≤ (Spec.map f) ⁻¹ᵁ ⊤ := fun _ _ => trivial
    refine ⟨⊤, hU, ⊤, hV, trivial, he, ?_⟩
    have hSq := IsAffineOpen.SpecMap_appLE_fromSpec (Spec.map f) hU hV he
    let isoU : Spec ((Spec R).presheaf.obj (Opposite.op ⊤)) ≅ Spec R :=
      IsOpenImmersion.isoOfRangeEq hU.fromSpec (𝟙 (Spec R)) (by
        rw [hU.range_fromSpec]
        ext z
        exact ⟨fun _ => ⟨z, rfl⟩, fun _ => trivial⟩)
    have hisoU_hom : isoU.hom = hU.fromSpec := by
      simpa using IsOpenImmersion.isoOfRangeEq_hom_fac hU.fromSpec (𝟙 (Spec R)) _
    let isoV : Spec ((Spec S).presheaf.obj (Opposite.op ⊤)) ≅ Spec S :=
      IsOpenImmersion.isoOfRangeEq hV.fromSpec (𝟙 (Spec S)) (by
        rw [hV.range_fromSpec]
        ext z
        exact ⟨fun _ => ⟨z, rfl⟩, fun _ => trivial⟩)
    have hisoV_hom : isoV.hom = hV.fromSpec := by
      simpa using IsOpenImmersion.isoOfRangeEq_hom_fac hV.fromSpec (𝟙 (Spec S)) _
    let eU : (Spec R).presheaf.obj (Opposite.op ⊤) ≅ R :=
      { hom := Spec.preimage isoU.inv
        inv := Spec.preimage isoU.hom
        hom_inv_id := by rw [← Spec.preimage_comp, Iso.hom_inv_id, Spec.preimage_id]
        inv_hom_id := by rw [← Spec.preimage_comp, Iso.inv_hom_id, Spec.preimage_id] }
    let eV : (Spec S).presheaf.obj (Opposite.op ⊤) ≅ S :=
      { hom := Spec.preimage isoV.inv
        inv := Spec.preimage isoV.hom
        hom_inv_id := by rw [← Spec.preimage_comp, Iso.hom_inv_id, Spec.preimage_id]
        inv_hom_id := by rw [← Spec.preimage_comp, Iso.inv_hom_id, Spec.preimage_id] }
    have hCommIso : eU.inv ≫ (Spec.map f).appLE ⊤ ⊤ he = f ≫ eV.inv := by
      have hSpecEq : Spec.map (eU.inv ≫ (Spec.map f).appLE ⊤ ⊤ he) =
          Spec.map (f ≫ eV.inv) := by
        rw [Spec.map_comp, Spec.map_comp, Spec.map_preimage, Spec.map_preimage,
          hisoU_hom, hisoV_hom]
        exact hSq
      rw [← Spec.preimage_map (eU.inv ≫ (Spec.map f).appLE ⊤ ⊤ he), hSpecEq, Spec.preimage_map]
    have hAppEq : (Spec.map f).appLE ⊤ ⊤ he = eU.hom ≫ (f ≫ eV.inv) := by
      rw [← Iso.inv_comp_eq]
      exact hCommIso
    rw [hAppEq]
    have h1 : RingHom.IsStandardSmoothOfRelativeDimension d (f ≫ eV.inv).hom :=
      (@RingHom.isStandardSmoothOfRelativeDimension_respectsIso d).left
        f.hom eV.symm.commRingCatIsoToRingEquiv hStd
    exact (@RingHom.isStandardSmoothOfRelativeDimension_respectsIso d).right
      (f ≫ eV.inv).hom eU.commRingCatIsoToRingEquiv h1
  
  have h_s2 : ∀ (d : ℕ) (R' : CommRingCat.{u}) (v₀ : AlgebraicGeometry.Spec R')
      (e_Y : AlgebraicGeometry.Spec R' ⟶ Y.left) (ψ : MvPolynomial (Fin d) k →+* R'),
      AlgebraicGeometry.Etale e_Y →
      AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) →
      e_Y.base v₀ = y →
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = e_Y ≫ Y.hom →
      ∃ (A B : CommRingCat.{u}) (α_A : k →+* A) (φ : A →+* B)
        (ψ_B : MvPolynomial (Fin d) k →+* B) (q : PrimeSpectrum B),
        α_A.FiniteType ∧ φ.Etale ∧ ψ_B.Etale ∧
        ψ_B.comp MvPolynomial.C = φ.comp α_A ∧
        ∀ f : A, f ∉ q.asIdeal.comap φ →
          RingHom.IsStandardSmoothOfRelativeDimension d
            ((algebraMap A (Localization.Away f)).comp α_A) →
          ∃ V : Y.left.Opens,
            y ∈ V ∧ AlgebraicGeometry.SmoothOfRelativeDimension d (V.ι ≫ Y.hom) := by
    intro d R' v₀ e_Y ψ he_Y hψ hv₀ hComm
    have : AlgebraicGeometry.LocallyOfFiniteType Y.hom := h_s1
    have : AlgebraicGeometry.Etale e_Y := he_Y
    have : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) := hψ
    obtain ⟨U_Y, hAffU, hyU, -⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := ⊤) (x := y) trivial
    let A : CommRingCat.{u} := Y.left.presheaf.obj (Opposite.op U_Y)
    let i_U : Spec A ⟶ Y.left := hAffU.fromSpec
    let α_cat : CommRingCat.of k ⟶ A := Spec.preimage (i_U ≫ Y.hom)
    have hα_map : Spec.map α_cat = i_U ≫ Y.hom := Spec.map_preimage _
    have hFT_α : α_cat.hom.FiniteType := by
      apply (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mp
      rw [hα_map]
      infer_instance
    have hv₀_pre : v₀ ∈ (e_Y ⁻¹ᵁ U_Y : (Spec R').Opens) := by
      change e_Y.base v₀ ∈ U_Y
      rwa [hv₀]
    obtain ⟨_, ⟨s, rfl⟩, hv₀_s, hs_sub⟩ :=
      PrimeSpectrum.isTopologicalBasis_basic_opens.exists_subset_of_mem_open
        hv₀_pre (e_Y ⁻¹ᵁ U_Y).isOpen
    have hs_notMem : s ∉ (v₀ : PrimeSpectrum R').asIdeal := hv₀_s
    let B_ring := Localization.Away s
    let B : CommRingCat.{u} := CommRingCat.of B_ring
    let j_s : Spec B ⟶ Spec R' := Spec.map (CommRingCat.ofHom (algebraMap R' B_ring))
    have : IsOpenImmersion j_s := IsOpenImmersion.of_isLocalization s
    have hDisj_s : Disjoint ((Submonoid.powers s : Submonoid R') : Set R')
        ((v₀ : PrimeSpectrum R').asIdeal : Set R') := by
      rw [Set.disjoint_left]
      rintro x ⟨n, rfl⟩ hx
      exact hs_notMem ((v₀ : PrimeSpectrum R').isPrime.mem_of_pow_mem n hx)
    have hPrime_q : (Ideal.map (algebraMap R' B_ring) (v₀ : PrimeSpectrum R').asIdeal).IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers s) B_ring
        (v₀ : PrimeSpectrum R').asIdeal (v₀ : PrimeSpectrum R').isPrime hDisj_s
    let q : PrimeSpectrum B := ⟨Ideal.map (algebraMap R' B_ring) (v₀ : PrimeSpectrum R').asIdeal, hPrime_q⟩
    have hq_v₀ : j_s.base q = v₀ :=
      PrimeSpectrum.ext (IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers s) B_ring
        (v₀ : PrimeSpectrum R').isPrime hDisj_s)
    have hRange_s : Set.range (j_s ≫ e_Y).base ⊆ Set.range i_U.base := by
      rw [hAffU.range_fromSpec]
      rintro _ ⟨w, rfl⟩
      apply hs_sub
      change s ∉ ((j_s.base w : PrimeSpectrum R').asIdeal)
      intro hs_w
      have hUnit : IsUnit (algebraMap R' B_ring s) := IsLocalization.Away.algebraMap_isUnit s
      exact (w : PrimeSpectrum B).isPrime.ne_top
        (Ideal.eq_top_of_isUnit_mem _ hs_w hUnit)
    let g_AB : Spec B ⟶ Spec A := IsOpenImmersion.lift i_U (j_s ≫ e_Y) hRange_s
    have hg_AB : g_AB ≫ i_U = j_s ≫ e_Y := IsOpenImmersion.lift_fac i_U (j_s ≫ e_Y) hRange_s
    have hEt_gAB : Etale g_AB := by
      have : Etale (g_AB ≫ i_U) := by rw [hg_AB]; infer_instance
      exact Etale.of_comp g_AB i_U
    let φ_cat : A ⟶ B := Spec.preimage g_AB
    have hφ_map : Spec.map φ_cat = g_AB := Spec.map_preimage g_AB
    have hEt_φ : φ_cat.hom.Etale := by
      apply (HasRingHomProperty.Spec_iff (P := @Etale)).mp
      rwa [hφ_map]
    let ψ_B : MvPolynomial (Fin d) k →+* B := (algebraMap R' B_ring).comp ψ
    have hψB_map : Spec.map (CommRingCat.ofHom ψ_B) =
        j_s ≫ Spec.map (CommRingCat.ofHom ψ) := by
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    have hEt_ψB : ψ_B.Etale := by
      change (CommRingCat.ofHom ψ_B).hom.Etale
      apply (HasRingHomProperty.Spec_iff (P := @Etale)).mp
      rw [hψB_map]
      infer_instance
    have hComm_AB : ψ_B.comp MvPolynomial.C = φ_cat.hom.comp α_cat.hom := by
      have hSpecEq : Spec.map (CommRingCat.ofHom (ψ_B.comp MvPolynomial.C)) =
          Spec.map (CommRingCat.ofHom (φ_cat.hom.comp α_cat.hom)) := by
        rw [CommRingCat.ofHom_comp, Spec.map_comp, hψB_map, Category.assoc, hComm,
          ← Category.assoc, ← hg_AB, Category.assoc, ← hα_map, ← hφ_map,
          ← Spec.map_comp]
        rfl
      have hCatEq : CommRingCat.ofHom (ψ_B.comp MvPolynomial.C) =
          CommRingCat.ofHom (φ_cat.hom.comp α_cat.hom) := by
        rw [← Spec.preimage_map (CommRingCat.ofHom (ψ_B.comp MvPolynomial.C)),
          hSpecEq, Spec.preimage_map]
      exact congrArg CommRingCat.Hom.hom hCatEq
    refine ⟨A, B, α_cat.hom, φ_cat.hom, ψ_B, q, hFT_α, hEt_φ, hEt_ψB, hComm_AB, ?_⟩
    intro f hf hStd
    let S_ring := Localization.Away f
    let S : CommRingCat.{u} := CommRingCat.of S_ring
    let j_f : Spec S ⟶ Spec A := Spec.map (CommRingCat.ofHom (algebraMap A S_ring))
    have : IsOpenImmersion j_f := IsOpenImmersion.of_isLocalization f
    let ι_f : Spec S ⟶ Y.left := j_f ≫ i_U
    let V : Y.left.Opens := ι_f.opensRange
    let p_A : PrimeSpectrum A := (Spec.map φ_cat).base q
    have hf_notMem : f ∉ p_A.asIdeal := hf
    have hDisj_f : Disjoint ((Submonoid.powers f : Submonoid A) : Set A) (p_A.asIdeal : Set A) := by
      rw [Set.disjoint_left]
      rintro x ⟨n, rfl⟩ hx
      exact hf_notMem (p_A.isPrime.mem_of_pow_mem n hx)
    let p_f : PrimeSpectrum S_ring :=
      ⟨Ideal.map (algebraMap A S_ring) p_A.asIdeal,
        IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers f) S_ring
          p_A.asIdeal p_A.isPrime hDisj_f⟩
    have hp_f : j_f.base p_f = p_A :=
      PrimeSpectrum.ext (IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers f) S_ring
        p_A.isPrime hDisj_f)
    have hyV : y ∈ V := by
      refine ⟨p_f, ?_⟩
      calc
        ι_f.base p_f = i_U.base (j_f.base p_f) := rfl
        _ = i_U.base ((Spec.map φ_cat).base q) := by rw [hp_f]
        _ = (g_AB ≫ i_U).base q := by rw [hφ_map]; rfl
        _ = (j_s ≫ e_Y).base q := by rw [hg_AB]
        _ = e_Y.base (j_s.base q) := rfl
        _ = y := by rw [hq_v₀, hv₀]
    let iso_V : Spec S ≅ V.toScheme :=
      IsOpenImmersion.isoOfRangeEq ι_f V.ι Subtype.range_coe.symm
    have hFac_V : iso_V.hom ≫ V.ι = ι_f :=
      IsOpenImmersion.isoOfRangeEq_hom_fac ι_f V.ι Subtype.range_coe.symm
    have hEqHom : V.ι ≫ Y.hom =
        iso_V.inv ≫ Spec.map (CommRingCat.ofHom ((algebraMap A S_ring).comp α_cat.hom)) := by
      apply (Iso.eq_inv_comp iso_V).mpr
      rw [← Category.assoc, hFac_V]
      calc
        (j_f ≫ i_U) ≫ Y.hom = j_f ≫ (i_U ≫ Y.hom) := Category.assoc _ _ _
        _ = j_f ≫ Spec.map α_cat := by rw [hα_map]
        _ = Spec.map (CommRingCat.ofHom ((algebraMap A S_ring).comp α_cat.hom)) := by
          rw [← Spec.map_comp]
          rfl
    have : SmoothOfRelativeDimension d
        (Spec.map (CommRingCat.ofHom ((algebraMap A S_ring).comp α_cat.hom))) :=
      h_spec_sm _ d hStd
    refine ⟨V, hyV, ?_⟩
    rw [hEqHom]
    have hComp := AlgebraicGeometry.smoothOfRelativeDimension_comp 0 d iso_V.inv
      (Spec.map (CommRingCat.ofHom ((algebraMap A S_ring).comp α_cat.hom)))
    simpa [Nat.zero_add] using hComp
  
  have h_s3 : ∀ (A B : Type u) [CommRing A] [CommRing B]
      (α_A : k →+* A) (φ : A →+* B) (d : ℕ) (ψ_B : MvPolynomial (Fin d) k →+* B),
      α_A.FiniteType → φ.Etale → ψ_B.Etale →
      ψ_B.comp MvPolynomial.C = φ.comp α_A →
      ∀ (q : Ideal B) [q.IsPrime],
        ∃ f : A, f ∉ q.comap φ ∧
          RingHom.IsStandardSmoothOfRelativeDimension d
            ((algebraMap A (Localization.Away f)).comp α_A) := by
    intro A B _ _ α_A φ d ψ_B hFT hEt_φ hEt_ψ hComm q _
    let : Algebra k A := α_A.toAlgebra
    let : Algebra A B := φ.toAlgebra
    let : Algebra k B := (φ.comp α_A).toAlgebra
    have : IsScalarTower k A B := IsScalarTower.of_algebraMap_eq' rfl
    let : Algebra (MvPolynomial (Fin d) k) B := ψ_B.toAlgebra
    have : IsScalarTower k (MvPolynomial (Fin d) k) B :=
      IsScalarTower.of_algebraMap_eq fun c => (RingHom.congr_fun hComm c).symm
    have : Algebra.FiniteType k A := hFT
    have : Algebra.FinitePresentation k A := Algebra.FinitePresentation.of_finiteType.mp hFT
    have : Algebra.Etale A B := hEt_φ
    have : Algebra.Etale (MvPolynomial (Fin d) k) B := hEt_ψ
    have : Algebra.FormallySmooth k B :=
      Algebra.FormallySmooth.comp k (MvPolynomial (Fin d) k) B
    let p : Ideal A := q.comap φ
    have : p.IsPrime := Ideal.IsPrime.comap φ
    let φ_loc : Localization.AtPrime p →+* Localization.AtPrime q :=
      Localization.localRingHom p q φ rfl
    let : Algebra (Localization.AtPrime p) (Localization.AtPrime q) := φ_loc.toAlgebra
    have : IsScalarTower A (Localization.AtPrime p) (Localization.AtPrime q) :=
      ⟨fun a x y => by
        change φ_loc (a • x) * y = a • (φ_loc x * y)
        rw [Algebra.smul_def a x, map_mul, mul_assoc,
          Localization.localRingHom_to_map p q φ rfl a,
          ← IsScalarTower.algebraMap_smul B a, Algebra.smul_def]
        rfl⟩
    have : IsScalarTower k (Localization.AtPrime p) (Localization.AtPrime q) :=
      ⟨fun c x y => by
        rw [← IsScalarTower.algebraMap_smul A c x, smul_assoc,
          IsScalarTower.algebraMap_smul A c (x • y)]⟩
    have : IsLocalHom (algebraMap (Localization.AtPrime p) (Localization.AtPrime q)) :=
      Localization.isLocalHom_localRingHom p q φ rfl
    have : Module.Flat A (Localization.AtPrime q) :=
      Module.Flat.trans A B (Localization.AtPrime q)
    have : Module.Flat (Localization.AtPrime p) (Localization.AtPrime q) :=
      (Module.flat_iff_of_isLocalization (Localization.AtPrime p) p.primeCompl
        (Localization.AtPrime q)).mpr inferInstance
    have : Module.FaithfullyFlat (Localization.AtPrime p) (Localization.AtPrime q) :=
