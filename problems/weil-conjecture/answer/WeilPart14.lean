      IsReduced.eq_zero _ ⟨n_b, hmap_pow⟩
    obtain ⟨⟨s, hs⟩, hsx⟩ :=
      (IsLocalization.map_eq_zero_iff P.primeCompl (Localization.AtPrime P) x_b).mp hmap_zero
    exact hs (hIP hsx)
