    (∀ (d : ℕ)
        (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (_ : IsProjectiveOverField k Y)
        (_ : ∀ y : Y.left, ∃ (R'' : CommRingCat.{u})
          (w₀ : AlgebraicGeometry.Spec R'')
          (e_Y : AlgebraicGeometry.Spec R'' ⟶ Y.left)
          (ψ'' : MvPolynomial (Fin d) k →+* R''),
          AlgebraicGeometry.Etale e_Y ∧
