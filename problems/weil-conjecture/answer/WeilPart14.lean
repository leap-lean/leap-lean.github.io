            ((Ideal.Quotient.mk _).comp MvPolynomial.C)) ≫ e_X := by
            rw [← h_qb_proj, CategoryTheory.Category.assoc]
  exact ⟨b₀, B', w₀, e'_X, q_b, hEt_e'_X, hEt_qb, hw₀_x', hw₀_v₀, hRoofComm⟩

theorem weil_projective_integral_reduced_closed_blowup (k : Type u) [Field k]
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (K : Set X.left)
    (hIntX : AlgebraicGeometry.IsIntegral X.left)
    (hProjX : IsProjectiveOverField k X)
    (hClosedK : IsClosed K)
    (hIrredK : IsIrreducible K)
    (hNonUniv : Kᶜ.Nonempty) :
    ∃ (X' : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (π : X' ⟶ X),
      AlgebraicGeometry.IsIntegral X'.left ∧
      IsProjectiveOverField k X' ∧
      IsGenFiniteEtaleAlterationOver k π ∧
      IsReducedClosedBlowupOver k K π :=
by
  obtain ⟨M, L, W, h, hCov, hSpan, hUnit⟩ :=
    weil_projective_uniform_vanishing_generators k X K hProjX hClosedK hNonUniv
  obtain ⟨X', π, ι, U₀, hClι, hιFst, hIntX', hAltπ, hU₀, hCharts⟩ :=
    weil_blowup_graph_closure_scheme_and_charts k X K hIntX hProjX hClosedK hNonUniv
      M L W h hCov hSpan hUnit
  have hHom : ι ≫ CategoryTheory.Limits.pullback.fst X.hom (weilProjectiveSpaceOver k L).hom ≫ X.hom = X'.hom := by
    rw [← CategoryTheory.Category.assoc, hιFst, CategoryTheory.Over.w π]
  have hProjX' : IsProjectiveOverField k X' :=
    weil_isProjectiveOverField_of_closedImmersion_pullback_proj k X X' L hProjX ι hClι hHom
  have hBlowupπ : IsReducedClosedBlowupOver k K π :=
    weil_reduced_closed_blowup_etale_charts_of_affine_charts k X X' K π hIntX hClosedK hIrredK
      U₀ hU₀ M L W h hSpan hCharts
  exact ⟨X', π, hIntX', hProjX', hAltπ, hBlowupπ⟩

theorem weil_toroidal_four_chart_blowup_algebra (k : Type u) [Field k] (m : ℕ) :
    HasFourChartToroidalBlowupAlgebra k m :=
by
  have hPillar1 : ∀ (S : Finset (Fin m)),
      IsDomain (toroidalModelRing k m S) ∧
      ∀ v : Fin 2 ⊕ Fin m,
        (Ideal.Quotient.mk _ (MvPolynomial.X v) : toroidalModelRing k m S) ≠ 0 := by
    intro S
    let P := MvPolynomial (Fin 2 ⊕ Fin m) k
    let F_S : P := MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
      ∏ i ∈ S, MvPolynomial.X (Sum.inr i)
    have hVarNe : ∀ v : Fin 2 ⊕ Fin m,
        (Ideal.Quotient.mk (Ideal.span ({F_S} : Set P)) (MvPolynomial.X v)) ≠ 0 := by
      intro v hZero
      let f_one : Fin 2 ⊕ Fin m → k := fun _ => 1
      let ev₁ : P →ₐ[k] k := MvPolynomial.aeval f_one
      have hEvX_all : ∀ w : Fin 2 ⊕ Fin m, ev₁ (MvPolynomial.X w) = 1 :=
        fun w => MvPolynomial.aeval_X f_one w
      have hFS_ker : F_S ∈ RingHom.ker ev₁.toRingHom := by
        change ev₁ F_S = 0
        dsimp [F_S]
        rw [map_sub, map_mul, map_prod, hEvX_all, hEvX_all]
        have hProd1 : (∏ i ∈ S, ev₁ (MvPolynomial.X (Sum.inr i))) = 1 :=
          Finset.prod_eq_one fun i _ => hEvX_all (Sum.inr i)
        rw [hProd1, mul_one, sub_self]
      have hSpan_le : Ideal.span ({F_S} : Set P) ≤ RingHom.ker ev₁.toRingHom :=
        Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hFS_ker)
      have hMem : MvPolynomial.X v ∈ Ideal.span ({F_S} : Set P) :=
        Ideal.Quotient.eq_zero_iff_mem.mp hZero
      have h10 : (1 : k) = 0 := by
        have hEvX : ev₁ (MvPolynomial.X v) = 0 := hSpan_le hMem
        rwa [hEvX_all v] at hEvX
      exact one_ne_zero h10
    have hDom : IsDomain (toroidalModelRing k m S) := by
      have h10_fin2 : (1 : Fin 2) ≠ 0 := by decide
      let e_var : (Fin 2 ⊕ Fin m) ≃ Option (Option (Fin m)) :=
        { toFun := fun x => match x with
            | Sum.inl a => if a = 0 then some none else none
            | Sum.inr i => some (some i)
          invFun := fun y => match y with
            | none => Sum.inl 1
            | some none => Sum.inl 0
            | some (some i) => Sum.inr i
          left_inv := by
            intro x
            rcases x with a | i
            · by_cases ha : a = 0
              · subst ha; rfl
              · have ha1 : a = 1 := by omega
                subst ha1
                simp [h10_fin2]
            · rfl
          right_inv := by
            intro y
            rcases y with _ | (_ | i)
            · simp [h10_fin2]
            · rfl
            · rfl }
      let E : MvPolynomial (Fin 2 ⊕ Fin m) k ≃ₐ[k] Polynomial (MvPolynomial (Option (Fin m)) k) :=
        (MvPolynomial.renameEquiv k e_var).trans (MvPolynomial.optionEquivLeft k (Option (Fin m)))
      let u₀ : MvPolynomial (Option (Fin m)) k := MvPolynomial.X none
      let prod_S : MvPolynomial (Option (Fin m)) k := ∏ i ∈ S, MvPolynomial.X (some i)
      let L : Polynomial (MvPolynomial (Option (Fin m)) k) :=
        Polynomial.C u₀ * Polynomial.X - Polynomial.C prod_S
      have hE_inl0 : E (MvPolynomial.X (Sum.inl 0)) = Polynomial.C u₀ := by
        dsimp [E, e_var, u₀]
        rw [MvPolynomial.renameEquiv_apply, MvPolynomial.rename_X]
        exact MvPolynomial.optionEquivLeft_X_some k (Option (Fin m)) none
      have hE_inl1 : E (MvPolynomial.X (Sum.inl 1)) = Polynomial.X := by
        have he1 : e_var (Sum.inl 1) = none := by
          change (if (1 : Fin 2) = 0 then some none else none) = none
          simp [h10_fin2]
        dsimp only [E, AlgEquiv.trans_apply]
        rw [MvPolynomial.renameEquiv_apply, MvPolynomial.rename_X, he1]
        exact MvPolynomial.optionEquivLeft_X_none k (Option (Fin m))
      have hE_inr : ∀ i : Fin m,
          E (MvPolynomial.X (Sum.inr i)) = Polynomial.C (MvPolynomial.X (some i)) := by
        intro i
        dsimp [E, e_var]
        rw [MvPolynomial.renameEquiv_apply, MvPolynomial.rename_X]
        exact MvPolynomial.optionEquivLeft_X_some k (Option (Fin m)) (some i)
      have hE_FS : E F_S = L := by
        dsimp [F_S, L, prod_S]
        rw [map_sub, map_mul, hE_inl0, hE_inl1, map_prod]
        congr 1
        rw [map_prod]
        exact Finset.prod_congr rfl fun i _ => hE_inr i
      have hu₀_ne : u₀ ≠ 0 := MvPolynomial.X_ne_zero none
      have hL_coeff1 : L.coeff 1 = u₀ := by
        simp [L]
      have hL_coeff0 : L.coeff 0 = -prod_S := by
        simp [L]
      have hL_ne : L ≠ 0 := by
        intro h0
        apply hu₀_ne
        rw [← hL_coeff1, h0, Polynomial.coeff_zero]
      have hL_deg : L.natDegree = 1 := by
        apply le_antisymm
        · refine Polynomial.natDegree_le_iff_coeff_eq_zero.mpr ?_
          intro n hn
          have hn1 : (1 : ℕ) ≠ n := by omega
          have hn0 : n ≠ 0 := by omega
          simp [L, Polynomial.coeff_C, Polynomial.coeff_X, hn0, hn1]
        · exact Polynomial.le_natDegree_of_ne_zero (by rw [hL_coeff1]; exact hu₀_ne)
      have hNotUnitL : ¬ IsUnit L := by
        intro hU
        have h0 := Polynomial.natDegree_eq_zero_of_isUnit hU
        omega
      have hUnitOfDeg0 : ∀ (p q : Polynomial (MvPolynomial (Option (Fin m)) k)),
          p * q = L → p.natDegree = 0 → IsUnit p := by
        intro p q hpq hp0
        have hp_eq : p = Polynomial.C (p.coeff 0) := Polynomial.eq_C_of_natDegree_eq_zero hp0
        let a : MvPolynomial (Option (Fin m)) k := p.coeff 0
        have hp_Ca : p = Polynomial.C a := hp_eq
        have h_c1 : a * q.coeff 1 = u₀ := by
          have := congrArg (fun f => f.coeff 1) hpq
          simpa [hp_Ca, Polynomial.coeff_C_mul, hL_coeff1] using this
        have h_c0 : a * q.coeff 0 = -prod_S := by
          have := congrArg (fun f => f.coeff 0) hpq
          simpa [hp_Ca, Polynomial.coeff_C_mul, hL_coeff0] using this
        have hu₀_prime : Prime u₀ := MvPolynomial.X_prime
        have hu₀_irr : Irreducible u₀ := hu₀_prime.irreducible
        rcases hu₀_irr.isUnit_or_isUnit h_c1.symm with haU | hq1U
        · rw [hp_Ca]
          exact haU.map Polynomial.C
        · exfalso
          obtain ⟨u_unit, hu_eq⟩ := hq1U
          have ha_div : a = u₀ * ↑(u_unit⁻¹) := by
            calc
              a = a * (q.coeff 1 * ↑(u_unit⁻¹)) := by
                rw [← hu_eq, Units.mul_inv, mul_one]
              _ = (a * q.coeff 1) * ↑(u_unit⁻¹) := by ring
              _ = u₀ * ↑(u_unit⁻¹) := by rw [h_c1]
          let f_kill : Option (Fin m) → MvPolynomial (Fin m) k :=
            fun o => Option.elim o 0 MvPolynomial.X
          let kill_u : MvPolynomial (Option (Fin m)) k →ₐ[k] MvPolynomial (Fin m) k :=
            MvPolynomial.bind₁ f_kill
          have hKill_lhs : kill_u (a * q.coeff 0) = 0 := by
            rw [ha_div, mul_assoc, map_mul]
            have hku0 : kill_u u₀ = 0 := by
              dsimp [kill_u, u₀]
              rw [MvPolynomial.bind₁_X_right]
              rfl
            rw [hku0, zero_mul]
          have hKill_rhs :
              kill_u (-prod_S) = - ∏ i ∈ S, (MvPolynomial.X i : MvPolynomial (Fin m) k) := by
            dsimp [prod_S]
            rw [map_neg, map_prod]
            congr 1
            refine Finset.prod_congr rfl fun i _ => ?_
            dsimp [kill_u]
            rw [MvPolynomial.bind₁_X_right]
            rfl
          have hProdZero : (∏ i ∈ S, (MvPolynomial.X i : MvPolynomial (Fin m) k)) = 0 := by
            have hEq := congrArg kill_u h_c0
            rw [hKill_lhs, hKill_rhs] at hEq
            exact neg_eq_zero.mp hEq.symm
          have hProdNe : (∏ i ∈ S, (MvPolynomial.X i : MvPolynomial (Fin m) k)) ≠ 0 := by
            rw [Finset.prod_ne_zero_iff]
            intro i _
            exact MvPolynomial.X_ne_zero i
          exact hProdNe hProdZero
      have hIrrL : Irreducible L := by
        refine ⟨hNotUnitL, ?_⟩
        intro p q hpq
        have hp_ne : p ≠ 0 := by
          rintro rfl
          rw [zero_mul] at hpq
          exact hL_ne hpq
        have hq_ne : q ≠ 0 := by
          rintro rfl
          rw [mul_zero] at hpq
          exact hL_ne hpq
        have hdeg_sum : p.natDegree + q.natDegree = 1 := by
          rw [← Polynomial.natDegree_mul hp_ne hq_ne, hpq.symm, hL_deg]
        rcases (show p.natDegree = 0 ∨ q.natDegree = 0 by omega) with hp0 | hq0
        · exact Or.inl (hUnitOfDeg0 p q hpq.symm hp0)
        · exact Or.inr (hUnitOfDeg0 q p (by rw [mul_comm, ← hpq]) hq0)
      have hIrrFS : Irreducible F_S := by
        rw [← MulEquiv.irreducible_iff E.toRingEquiv.toMulEquiv]
        change Irreducible (E F_S)
        rwa [hE_FS]
      have hFS_ne : F_S ≠ 0 := hIrrFS.ne_zero
      have hPrimeFS : Prime F_S := UniqueFactorizationMonoid.irreducible_iff_prime.mp hIrrFS
      have hSpanPrime : (Ideal.span ({F_S} : Set P)).IsPrime :=
        (Ideal.span_singleton_prime hFS_ne).mpr hPrimeFS
      exact (Ideal.Quotient.isDomain_iff_prime (Ideal.span ({F_S} : Set P))).mpr hSpanPrime
    exact ⟨hDom, hVarNe⟩
  have hPillar2 : ∀ (S : Finset (Fin m)) (a b : Fin m),
      a ∈ S → b ∈ S → a ≠ b →
      let M_S := toroidalModelRing k m S
      let J_M : Ideal M_S := Ideal.span
        {Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl 0)),
         Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl 1)),
         Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr a)),
         Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr b))}
      J_M.IsPrime ∧
      (∀ c : Fin m, c ≠ a → c ≠ b →
        Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c)) ∉ J_M) ∧
      Nonempty ((M_S ⧸ J_M) ≃ₐ[k] MvPolynomial (Fin (m - 2)) k) ∧
      (∀ (B : Type u) [CommRing B] [Algebra M_S B] [Algebra.Etale M_S B],
        (Ideal.map (algebraMap M_S B) J_M).IsRadical) := by
    intro S a b ha _hb hab
    dsimp only
    let P := MvPolynomial (Fin 2 ⊕ Fin m) k
    let F_S : P := MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
      ∏ i ∈ S, MvPolynomial.X (Sum.inr i)
    let I_S : Ideal P := Ideal.span {F_S}
    let J_M : Ideal (toroidalModelRing k m S) := Ideal.span
      {Ideal.Quotient.mk I_S (MvPolynomial.X (Sum.inl 0)),
       Ideal.Quotient.mk I_S (MvPolynomial.X (Sum.inl 1)),
       Ideal.Quotient.mk I_S (MvPolynomial.X (Sum.inr a)),
       Ideal.Quotient.mk I_S (MvPolynomial.X (Sum.inr b))}
    let T : Finset (Fin m) := (Finset.univ.erase a).erase b
    have ha_not_T : a ∉ T := by simp [T]
    have hb_not_T : b ∉ T := by simp [T]
    have hT_card : Fintype.card ↥T = m - 2 := by
      rw [Fintype.card_coe]
      have hb_mem : b ∈ (Finset.univ : Finset (Fin m)).erase a :=
        Finset.mem_erase.mpr ⟨hab.symm, Finset.mem_univ b⟩
      have ha_mem : a ∈ (Finset.univ : Finset (Fin m)) := Finset.mem_univ a
      dsimp [T]
      rw [Finset.card_erase_of_mem hb_mem, Finset.card_erase_of_mem ha_mem, Finset.card_fin]
      omega
    let e_idx : ↥T ≃ Fin (m - 2) := Fintype.equivFinOfCardEq hT_card
    let f_α : Fin 2 ⊕ Fin m → MvPolynomial ↥T k := fun v => match v with
      | Sum.inl _ => 0
      | Sum.inr c => if hc : c ∈ T then MvPolynomial.X ⟨c, hc⟩ else 0
    let α₀ : P →ₐ[k] MvPolynomial ↥T k := MvPolynomial.aeval f_α
    have hα₀_X : ∀ v : Fin 2 ⊕ Fin m, α₀ (MvPolynomial.X v) = f_α v :=
      fun v => MvPolynomial.aeval_X f_α v
    have hα₀_FS : ∀ x ∈ I_S, α₀ x = 0 := by
      intro x hx
      have hFS0 : α₀ F_S = 0 := by
        dsimp [F_S]
        rw [map_sub, map_mul, map_prod, hα₀_X (Sum.inl 0)]
        have h0 : f_α (Sum.inl 0) = 0 := rfl
        have ha0 : α₀ (MvPolynomial.X (Sum.inr a)) = 0 := by
          rw [hα₀_X]
          dsimp [f_α]
          exact dite_eq_right_iff.mpr fun h => (ha_not_T h).elim
        rw [h0, zero_mul, ← Finset.mul_prod_erase S _ ha, ha0, zero_mul, sub_self]
      have hle : I_S ≤ RingHom.ker α₀.toRingHom :=
        Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hFS0)
      exact hle hx
    let α₁ : toroidalModelRing k m S →ₐ[k] MvPolynomial ↥T k :=
      Ideal.Quotient.liftₐ I_S α₀ hα₀_FS
    have hα₁_JM : ∀ y ∈ J_M, α₁ y = 0 := by
      have hle : J_M ≤ RingHom.ker α₁.toRingHom := by
        rw [Ideal.span_le]
        intro y hy
        simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hy
        rcases hy with rfl | rfl | rfl | rfl
        · change α₀ (MvPolynomial.X (Sum.inl 0)) = 0
          rw [hα₀_X]
        · change α₀ (MvPolynomial.X (Sum.inl 1)) = 0
          rw [hα₀_X]
        · change α₀ (MvPolynomial.X (Sum.inr a)) = 0
          rw [hα₀_X]; dsimp [f_α]
          exact dite_eq_right_iff.mpr fun h => (ha_not_T h).elim
        · change α₀ (MvPolynomial.X (Sum.inr b)) = 0
          rw [hα₀_X]; dsimp [f_α]
          exact dite_eq_right_iff.mpr fun h => (hb_not_T h).elim
      intro y hy
      exact hle hy
    let α : (toroidalModelRing k m S ⧸ J_M) →ₐ[k] MvPolynomial ↥T k :=
      Ideal.Quotient.liftₐ J_M α₁ hα₁_JM
    let f_β : ↥T → (toroidalModelRing k m S ⧸ J_M) := fun t =>
      Ideal.Quotient.mk J_M (Ideal.Quotient.mk I_S (MvPolynomial.X (Sum.inr t.1)))
    let β : MvPolynomial ↥T k →ₐ[k] (toroidalModelRing k m S ⧸ J_M) := MvPolynomial.aeval f_β
    have hβ_X : ∀ t : ↥T, β (MvPolynomial.X t) = f_β t :=
      fun t => MvPolynomial.aeval_X f_β t
    have hαβ : α.comp β = AlgHom.id k (MvPolynomial ↥T k) := by
      apply MvPolynomial.algHom_ext
      intro t
      change α (β (MvPolynomial.X t)) = MvPolynomial.X t
      rw [hβ_X t]
      change α₀ (MvPolynomial.X (Sum.inr t.1)) = MvPolynomial.X t
      rw [hα₀_X]
      dsimp [f_α]
      exact ite_eq_left_iff.mpr fun h => (h t.2).elim
    have hβα : β.comp α = AlgHom.id k (toroidalModelRing k m S ⧸ J_M) := by
      ext z
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective z
      obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective y
      let qMap : P →ₐ[k] (toroidalModelRing k m S ⧸ J_M) :=
        (Ideal.Quotient.mkₐ k J_M).comp (Ideal.Quotient.mkₐ k I_S)
      have hComp : (β.comp α).comp qMap = qMap := by
        apply MvPolynomial.algHom_ext
        intro v
        rcases v with j | c
        · fin_cases j
          · change β (α₀ (MvPolynomial.X (Sum.inl 0))) =
              Ideal.Quotient.mk J_M (Ideal.Quotient.mk I_S (MvPolynomial.X (Sum.inl 0)))
            rw [hα₀_X]; dsimp [f_α]; rw [map_zero]
            symm
            exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Or.inl rfl))
          · change β (α₀ (MvPolynomial.X (Sum.inl 1))) =
              Ideal.Quotient.mk J_M (Ideal.Quotient.mk I_S (MvPolynomial.X (Sum.inl 1)))
            rw [hα₀_X]; dsimp [f_α]; rw [map_zero]
            symm
            exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Or.inr (Or.inl rfl)))
        · change β (α₀ (MvPolynomial.X (Sum.inr c))) =
            Ideal.Quotient.mk J_M (Ideal.Quotient.mk I_S (MvPolynomial.X (Sum.inr c)))
          rw [hα₀_X]
          dsimp [f_α]
          by_cases hc : c ∈ T
          · rw [dite_cond_eq_true (eq_true hc), hβ_X]
          · rw [dite_cond_eq_false (eq_false hc), map_zero]
            symm
            have hcab : c = b ∨ c = a := by
              simp only [T, Finset.mem_erase, Finset.mem_univ, and_true, not_and_or, not_not] at hc
              exact hc
            rcases hcab with rfl | rfl
            · exact Ideal.Quotient.eq_zero_iff_mem.mpr
                (Ideal.subset_span (Or.inr (Or.inr (Or.inr rfl))))
            · exact Ideal.Quotient.eq_zero_iff_mem.mpr
                (Ideal.subset_span (Or.inr (Or.inr (Or.inl rfl))))
      exact AlgHom.congr_fun hComp p
    let E_JM : (toroidalModelRing k m S ⧸ J_M) ≃ₐ[k] MvPolynomial (Fin (m - 2)) k :=
      (AlgEquiv.ofAlgHom α β hαβ hβα).trans (MvPolynomial.renameEquiv k e_idx)
    have hDomQuot : IsDomain (toroidalModelRing k m S ⧸ J_M) :=
      Function.Injective.isDomain E_JM.toRingHom E_JM.injective
    have hPrimeJM : J_M.IsPrime := (Ideal.Quotient.isDomain_iff_prime J_M).mp hDomQuot
    have hNotMem : ∀ c : Fin m, c ≠ a → c ≠ b →
        Ideal.Quotient.mk I_S (MvPolynomial.X (Sum.inr c)) ∉ J_M := by
      intro c hca hcb hMem
      have hcT : c ∈ T := by simp [T, hca, hcb]
      have hZero : α₁ (Ideal.Quotient.mk I_S (MvPolynomial.X (Sum.inr c))) = 0 := hα₁_JM _ hMem
      have hNe : α₁ (Ideal.Quotient.mk I_S (MvPolynomial.X (Sum.inr c))) ≠ 0 := by
        change α₀ (MvPolynomial.X (Sum.inr c)) ≠ 0
        rw [hα₀_X]
        dsimp [f_α]
        rw [dite_cond_eq_true (eq_true hcT)]
        exact MvPolynomial.X_ne_zero (⟨c, hcT⟩ : ↥T)
      exact hNe hZero
    have hRedOfEtaleDomain : ∀ (D₀ : Type u) [CommRing D₀] [IsDomain D₀]
        (C₀ : Type u) [CommRing C₀] [Algebra D₀ C₀] [Algebra.Etale D₀ C₀],
        _root_.IsReduced C₀ := by
      intro D₀ _ _ C₀ _ _ _
      have : Algebra.Etale (FractionRing D₀) (TensorProduct D₀ (FractionRing D₀) C₀) :=
        Algebra.Etale.baseChange D₀ C₀ (FractionRing D₀)
      have hRedK : _root_.IsReduced (TensorProduct D₀ (FractionRing D₀) C₀) :=
        Algebra.FormallyUnramified.isReduced_of_field (FractionRing D₀)
          (TensorProduct D₀ (FractionRing D₀) C₀)
      let linDK := Algebra.linearMap D₀ (FractionRing D₀)
      have hInjDK : Function.Injective ⇑linDK :=
        IsFractionRing.injective D₀ (FractionRing D₀)
      have hInjRTensor : Function.Injective ⇑(LinearMap.rTensor C₀ linDK) :=
        Module.Flat.rTensor_preserves_injective_linearMap linDK hInjDK
      let ιC₀ : C₀ →+* TensorProduct D₀ (FractionRing D₀) C₀ :=
        Algebra.TensorProduct.includeRight.toRingHom
      have hInjC₀ : Function.Injective ⇑ιC₀ := by
        intro x y hxy
        let lidEquiv := TensorProduct.lid D₀ C₀
        have hEq : LinearMap.rTensor C₀ linDK (lidEquiv.symm x) =
            LinearMap.rTensor C₀ linDK (lidEquiv.symm y) := by
          simpa [ιC₀, lidEquiv, linDK] using hxy
        exact lidEquiv.symm.injective (hInjRTensor hEq)
      exact isReduced_of_injective ιC₀ hInjC₀
    have hGenEtRad : ∀ (R₀ : Type u) [CommRing R₀] (I₀ : Ideal R₀),
        IsDomain (R₀ ⧸ I₀) →
        ∀ (B₀ : Type u) [CommRing B₀] [Algebra R₀ B₀] [Algebra.Etale R₀ B₀],
          (Ideal.map (algebraMap R₀ B₀) I₀).IsRadical := by
      intro R₀ _ I₀ hDomI₀ B₀ _ _ _
      have : Algebra.Etale (R₀ ⧸ I₀) (TensorProduct R₀ (R₀ ⧸ I₀) B₀) :=
        Algebra.Etale.baseChange R₀ B₀ (R₀ ⧸ I₀)
      have hRedC₀ : _root_.IsReduced (TensorProduct R₀ (R₀ ⧸ I₀) B₀) :=
        @hRedOfEtaleDomain (R₀ ⧸ I₀) _ hDomI₀ (TensorProduct R₀ (R₀ ⧸ I₀) B₀) _ _ this
      let eQuot : (B₀ ⧸ Ideal.map (algebraMap R₀ B₀) I₀) ≃+* TensorProduct R₀ (R₀ ⧸ I₀) B₀ :=
        (Algebra.TensorProduct.quotIdealMapEquivTensorQuot B₀ I₀).toRingEquiv.trans
          (Algebra.TensorProduct.comm R₀ B₀ (R₀ ⧸ I₀)).toRingEquiv
      have hRedQuot : _root_.IsReduced (B₀ ⧸ Ideal.map (algebraMap R₀ B₀) I₀) :=
        isReduced_of_injective eQuot.toRingHom eQuot.injective
      exact (Ideal.isRadical_iff_quotient_reduced _).mpr hRedQuot
    have hEtRad : ∀ (B : Type u) [CommRing B] [Algebra (toroidalModelRing k m S) B]
        [Algebra.Etale (toroidalModelRing k m S) B],
        (Ideal.map (algebraMap (toroidalModelRing k m S) B) J_M).IsRadical :=
      fun B _ _ _ => hGenEtRad (toroidalModelRing k m S) J_M hDomQuot B
    exact ⟨hPrimeJM, hNotMem, ⟨E_JM⟩, hEtRad⟩
  have hPillar3 : ∀ (A B : Type u) [CommRing A] [IsDomain A] [CommRing B] [Algebra A B]
      [Algebra.Etale A B] {r : ℕ} (g_A : Fin r → A),
      (∀ d : Fin r, g_A d ≠ 0) →
      let g_B : Fin r → B := fun d => algebraMap A B (g_A d)
      (∀ d : Fin r, g_B d ∈ nonZeroDivisors B) ∧
      (∀ b : Fin r, ∃ φ_b : affineBlowupRatioRing A g_A b →+* affineBlowupRatioRing B g_B b,
        AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_b)) ∧
        φ_b.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) =
          ((Ideal.Quotient.mk _).comp MvPolynomial.C).comp (algebraMap A B)) := by
    intro A B _ _ _ _ _ r g_A hg_A g_B
    have hNZD : ∀ d : Fin r, g_B d ∈ nonZeroDivisors B := by
      intro d
      let μ_d : A →ₗ[A] A := LinearMap.mulLeft A (g_A d)
      have hInj_μ : Function.Injective ⇑μ_d := mul_right_injective₀ (hg_A d)
      have hInj_lT : Function.Injective ⇑(LinearMap.lTensor B μ_d) :=
        Module.Flat.lTensor_preserves_injective_linearMap μ_d hInj_μ
      have hMulLeft : ∀ x : B, g_B d * x = 0 → x = 0 := by
        intro x hx
        have hApp : ∀ y : B,
            (TensorProduct.rid A B) (LinearMap.lTensor B μ_d ((TensorProduct.rid A B).symm y)) =
              g_B d * y := by
          intro y
          change (TensorProduct.rid A B) (y ⊗ₜ[A] (g_A d * 1)) = g_B d * y
          rw [mul_one, TensorProduct.rid_tmul, Algebra.smul_def]
        apply (TensorProduct.rid A B).symm.injective
        apply hInj_lT
        apply (TensorProduct.rid A B).injective
        rw [hApp x, hApp 0, mul_zero, hx]
      rw [mem_nonZeroDivisors_iff]
      exact ⟨hMulLeft, fun x hx => hMulLeft x (by rwa [mul_comm])⟩
    refine ⟨hNZD, ?_⟩
    intro b
    let f : A →+* B := algebraMap A B
    let P_A := MvPolynomial (Fin r) A
    let P_B := MvPolynomial (Fin r) B
    let L_A := Localization.Away (g_A b)
    let L_B := Localization.Away (g_B b)
    let θ_A : P_A →ₐ[A] L_A := MvPolynomial.aeval (R := A)
      (fun a : Fin r => algebraMap A L_A (g_A a) * IsLocalization.Away.invSelf (S := L_A) (g_A b))
    let θ_B : P_B →ₐ[B] L_B := MvPolynomial.aeval (R := B)
      (fun a : Fin r => algebraMap B L_B (g_B a) * IsLocalization.Away.invSelf (S := L_B) (g_B b))
    let I_A : Ideal P_A := RingHom.ker θ_A.toRingHom
    let I_B : Ideal P_B := RingHom.ker θ_B.toRingHom
    let e_P : TensorProduct A B P_A ≃ₐ[B] P_B := MvPolynomial.algebraTensorAlgEquiv A B
    let e_L : TensorProduct A B L_A ≃ₐ[B] L_B := IsLocalization.Away.tensorEquiv B (g_A b) L_A
    have he_P_one_tmul : ∀ p : P_A, e_P ((1 : B) ⊗ₜ[A] p) = MvPolynomial.map f p := by
      intro p
      rw [MvPolynomial.algebraTensorAlgEquiv_tmul, one_smul]
    have he_P_C : ∀ b₀ : B, e_P (b₀ ⊗ₜ[A] (1 : P_A)) = MvPolynomial.C b₀ := by
      intro b₀
      change e_P (algebraMap B (TensorProduct A B P_A) b₀) = algebraMap B P_B b₀
      exact e_P.commutes b₀
    have he_L_alg : ∀ a : A,
        e_L ((1 : B) ⊗ₜ[A] algebraMap A L_A a) = algebraMap B L_B (f a) := by
      intro a
      have htmul : ((1 : B) ⊗ₜ[A] algebraMap A L_A a) =
          algebraMap B (TensorProduct A B L_A) (f a) := by
        calc
          ((1 : B) ⊗ₜ[A] algebraMap A L_A a) = (1 : B) ⊗ₜ[A] (a • (1 : L_A)) := by
            rw [Algebra.smul_def, mul_one]
          _ = (a • (1 : B)) ⊗ₜ[A] (1 : L_A) := (TensorProduct.smul_tmul a (1 : B) (1 : L_A)).symm
          _ = (f a) ⊗ₜ[A] (1 : L_A) := by
            rw [Algebra.smul_def, mul_one]
          _ = algebraMap B (TensorProduct A B L_A) (f a) := rfl
      rw [htmul]
      exact e_L.commutes (f a)
    have he_L_inv : e_L ((1 : B) ⊗ₜ[A] IsLocalization.Away.invSelf (S := L_A) (g_A b)) =
        IsLocalization.Away.invSelf (S := L_B) (g_B b) := by
      have hUnit : IsUnit (algebraMap B L_B (g_B b)) :=
        IsLocalization.Away.algebraMap_isUnit (g_B b)
      apply hUnit.mul_left_cancel
      rw [IsLocalization.Away.mul_invSelf (S := L_B) (g_B b)]
      calc
        algebraMap B L_B (g_B b) *
            e_L ((1 : B) ⊗ₜ[A] IsLocalization.Away.invSelf (S := L_A) (g_A b))
          = e_L ((1 : B) ⊗ₜ[A] algebraMap A L_A (g_A b)) *
              e_L ((1 : B) ⊗ₜ[A] IsLocalization.Away.invSelf (S := L_A) (g_A b)) := by
              rw [he_L_alg (g_A b)]
        _ = e_L (((1 : B) ⊗ₜ[A] algebraMap A L_A (g_A b)) *
              ((1 : B) ⊗ₜ[A] IsLocalization.Away.invSelf (S := L_A) (g_A b))) :=
              (map_mul e_L _ _).symm
        _ = e_L ((1 : B) ⊗ₜ[A]
              (algebraMap A L_A (g_A b) * IsLocalization.Away.invSelf (S := L_A) (g_A b))) := by
              rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one]
        _ = e_L ((1 : B) ⊗ₜ[A] (1 : L_A)) := by
              rw [IsLocalization.Away.mul_invSelf (S := L_A) (g_A b)]
        _ = 1 := map_one e_L
    let Θ_tensor : TensorProduct A B P_A →ₐ[B] TensorProduct A B L_A :=
      Algebra.TensorProduct.map (AlgHom.id B B) θ_A
    have hΘ_comm : e_L.toAlgHom.comp Θ_tensor = θ_B.comp e_P.toAlgHom := by
      apply AlgHom.restrictScalars_injective A
      apply Algebra.TensorProduct.ext
      · ext b₀
        change e_L (Θ_tensor (algebraMap B _ b₀)) = θ_B (e_P (algebraMap B _ b₀))
        rw [AlgHom.commutes, AlgEquiv.commutes, AlgEquiv.commutes, AlgHom.commutes]
      · apply MvPolynomial.algHom_ext
        intro d
        change e_L ((1 : B) ⊗ₜ[A] θ_A (MvPolynomial.X d)) =
          θ_B (e_P ((1 : B) ⊗ₜ[A] MvPolynomial.X d))
        rw [he_P_one_tmul, MvPolynomial.map_X]
        dsimp only [θ_A, θ_B]
        rw [MvPolynomial.aeval_X, MvPolynomial.aeval_X]
        have hmul : ((1 : B) ⊗ₜ[A]
            (algebraMap A L_A (g_A d) * IsLocalization.Away.invSelf (S := L_A) (g_A b))) =
            ((1 : B) ⊗ₜ[A] algebraMap A L_A (g_A d)) *
              ((1 : B) ⊗ₜ[A] IsLocalization.Away.invSelf (S := L_A) (g_A b)) := by
          rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one]
        rw [hmul, map_mul, he_L_alg (g_A d), he_L_inv]
    have hΘ_eq_lT : ∀ z : TensorProduct A B P_A,
        Θ_tensor z = (TensorProduct.AlgebraTensorModule.lTensor B B θ_A.toLinearMap) z := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => simp
      | tmul b₀ p => rfl
      | add x y hx hy => rw [map_add, map_add, hx, hy]
    have hKer_le : I_A ≤ Ideal.comap (MvPolynomial.map f) I_B := by
      intro p hp
      change θ_B (MvPolynomial.map f p) = 0
      have hp0 : θ_A p = 0 := hp
      rw [← he_P_one_tmul p]
      have hEq := AlgHom.congr_fun hΘ_comm ((1 : B) ⊗ₜ[A] p)
      change e_L ((1 : B) ⊗ₜ[A] θ_A p) = θ_B (e_P ((1 : B) ⊗ₜ[A] p)) at hEq
      rw [← hEq, hp0, TensorProduct.tmul_zero, map_zero]
    have hIB_eq : I_B = Ideal.map (MvPolynomial.map f) I_A := by
      apply le_antisymm
      · intro Q hQ
        let z : TensorProduct A B P_A := e_P.symm Q
        have hz_ker : z ∈ (TensorProduct.AlgebraTensorModule.lTensor B B θ_A.toLinearMap).ker := by
          rw [LinearMap.mem_ker, ← hΘ_eq_lT z]
          apply e_L.injective
          rw [map_zero]
          have hEq := AlgHom.congr_fun hΘ_comm z
          change e_L (Θ_tensor z) = θ_B (e_P z) at hEq
          rw [hEq]
          have hez : e_P z = Q := e_P.apply_symm_apply Q
          rw [hez]
          exact hQ
        rw [Module.Flat.ker_lTensor_eq B B θ_A.toLinearMap] at hz_ker
        rcases hz_ker with ⟨w, hw⟩
        have hw_mem : ∀ u : TensorProduct A B ↥(LinearMap.ker θ_A.toLinearMap),
            e_P ((TensorProduct.AlgebraTensorModule.lTensor B B
              (LinearMap.ker θ_A.toLinearMap).subtype) u) ∈ Ideal.map (MvPolynomial.map f) I_A := by
          intro u
          induction u using TensorProduct.induction_on with
          | zero => simp
          | tmul b₀ x =>
            have htmul : (TensorProduct.AlgebraTensorModule.lTensor B B
                (LinearMap.ker θ_A.toLinearMap).subtype) (b₀ ⊗ₜ[A] x) = b₀ ⊗ₜ[A] x.1 := rfl
            rw [htmul]
            have hsplit : (b₀ ⊗ₜ[A] x.1) = (b₀ ⊗ₜ[A] (1 : P_A)) * ((1 : B) ⊗ₜ[A] x.1) := by
              rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
            rw [hsplit, map_mul, he_P_C, he_P_one_tmul]
            exact Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem _ x.2)
          | add u₁ u₂ hu₁ hu₂ =>
            rw [map_add, map_add]
            exact Ideal.add_mem _ hu₁ hu₂
        have hQz : e_P ((TensorProduct.AlgebraTensorModule.lTensor B B
            (LinearMap.ker θ_A.toLinearMap).subtype) w) = Q := by
          rw [hw]
          exact e_P.apply_symm_apply Q
        rw [← hQz]
        exact hw_mem w
      · exact Ideal.map_le_iff_le_comap.mpr hKer_le
    let φ_b : affineBlowupRatioRing A g_A b →+* affineBlowupRatioRing B g_B b :=
      Ideal.Quotient.lift I_A ((Ideal.Quotient.mk I_B).comp (MvPolynomial.map f)) (fun p hp => by
        change Ideal.Quotient.mk I_B (MvPolynomial.map f p) = 0
        exact Ideal.Quotient.eq_zero_iff_mem.mpr (hKer_le hp))
    have hφ_comp : φ_b.comp ((Ideal.Quotient.mk I_A).comp MvPolynomial.C) =
        ((Ideal.Quotient.mk I_B).comp MvPolynomial.C).comp f := by
      ext a
      change Ideal.Quotient.mk I_B (MvPolynomial.map f (MvPolynomial.C a)) =
        Ideal.Quotient.mk I_B (MvPolynomial.C (f a))
      rw [MvPolynomial.map_C]
    let φ_b_alg : affineBlowupRatioRing A g_A b →ₐ[A] affineBlowupRatioRing B g_B b :=
      { φ_b with
        commutes' := fun a => by
          change Ideal.Quotient.mk I_B (MvPolynomial.map f (MvPolynomial.C a)) =
            Ideal.Quotient.mk I_B (MvPolynomial.C (f a))
          rw [MvPolynomial.map_C] }
    let ι_B_alg : B →ₐ[A] affineBlowupRatioRing B g_B b :=
      { toRingHom := (Ideal.Quotient.mk I_B).comp MvPolynomial.C
        commutes' := fun _ => rfl }
    let α_A : TensorProduct A (affineBlowupRatioRing A g_A b) B →ₐ[A]
        affineBlowupRatioRing B g_B b :=
      Algebra.TensorProduct.lift φ_b_alg ι_B_alg (fun _ _ => Commute.all _ _)
    have hα_tmul : ∀ (c : affineBlowupRatioRing A g_A b) (b₀ : B),
        α_A (c ⊗ₜ[A] b₀) = φ_b c * Ideal.Quotient.mk I_B (MvPolynomial.C b₀) := by
      intro c b₀
      rfl
    let q₀ : P_B →ₐ[B] TensorProduct A B (affineBlowupRatioRing A g_A b) :=
      (Algebra.TensorProduct.map (AlgHom.id B B) (Ideal.Quotient.mkₐ A I_A)).comp e_P.symm.toAlgHom
    let q₁ : P_B →+* TensorProduct A (affineBlowupRatioRing A g_A b) B :=
      (Algebra.TensorProduct.comm A B (affineBlowupRatioRing A g_A b)).toRingHom.comp q₀.toRingHom
    have hq₁_ker : ∀ Q ∈ I_B, q₁ Q = 0 := by
      have hle : I_B ≤ RingHom.ker q₁ := by
        rw [hIB_eq, Ideal.map_le_iff_le_comap]
        intro p hp
        change (Algebra.TensorProduct.comm A B _) (q₀ (MvPolynomial.map f p)) = 0
        have he_symm : e_P.symm (MvPolynomial.map f p) = (1 : B) ⊗ₜ[A] p := by
          apply e_P.injective
          rw [e_P.apply_symm_apply, he_P_one_tmul]
        dsimp [q₀]
        rw [he_symm]
        have hmk0 : Ideal.Quotient.mkₐ A I_A p = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hp
        change (Algebra.TensorProduct.comm A B _) ((1 : B) ⊗ₜ[A] Ideal.Quotient.mkₐ A I_A p) = 0
        rw [hmk0, TensorProduct.tmul_zero, map_zero]
      intro Q hQ
      exact hle hQ
    let β_BC : affineBlowupRatioRing B g_B b →+*
        TensorProduct A (affineBlowupRatioRing A g_A b) B :=
      Ideal.Quotient.lift I_B q₁ hq₁_ker
    have hRightInv : ∀ y : affineBlowupRatioRing B g_B b, α_A (β_BC y) = y := by
      have hHom : α_A.toRingHom.comp β_BC = RingHom.id _ := by
        apply Ideal.Quotient.ringHom_ext
        apply MvPolynomial.ringHom_ext
        · intro b₀
          change α_A (q₁ (MvPolynomial.C b₀)) = Ideal.Quotient.mk I_B (MvPolynomial.C b₀)
          have hsymmC : e_P.symm (MvPolynomial.C b₀) = b₀ ⊗ₜ[A] (1 : P_A) := by
            apply e_P.injective
            rw [e_P.apply_symm_apply, he_P_C]
          dsimp [q₁, q₀]
          rw [hsymmC]
          change α_A ((1 : affineBlowupRatioRing A g_A b) ⊗ₜ[A] b₀) =
            Ideal.Quotient.mk I_B (MvPolynomial.C b₀)
          rw [hα_tmul, map_one, one_mul]
        · intro d
          change α_A (q₁ (MvPolynomial.X d)) = Ideal.Quotient.mk I_B (MvPolynomial.X d)
          have hsymmX : e_P.symm (MvPolynomial.X d) = (1 : B) ⊗ₜ[A] (MvPolynomial.X d : P_A) := by
            apply e_P.injective
            rw [e_P.apply_symm_apply, he_P_one_tmul, MvPolynomial.map_X]
          dsimp [q₁, q₀]
          rw [hsymmX]
          change α_A ((Ideal.Quotient.mk I_A (MvPolynomial.X d)) ⊗ₜ[A] (1 : B)) =
            Ideal.Quotient.mk I_B (MvPolynomial.X d)
          rw [hα_tmul, map_one, map_one, mul_one]
          change Ideal.Quotient.mk I_B (MvPolynomial.map f (MvPolynomial.X d)) = _
          rw [MvPolynomial.map_X]
      intro y
      exact RingHom.congr_fun hHom y
    have hLeftInv : ∀ z : TensorProduct A (affineBlowupRatioRing A g_A b) B, β_BC (α_A z) = z := by
      let compHom := β_BC.comp α_A.toRingHom
      have hOnLeft : ∀ p : P_A,
          compHom ((Ideal.Quotient.mk I_A p) ⊗ₜ[A] (1 : B)) =
            (Ideal.Quotient.mk I_A p) ⊗ₜ[A] (1 : B) := by
        intro p
        have hα : α_A ((Ideal.Quotient.mk I_A p) ⊗ₜ[A] (1 : B)) =
            Ideal.Quotient.mk I_B (MvPolynomial.map f p) := by
          rw [hα_tmul, map_one, map_one, mul_one]
          rfl
        have hsymm : e_P.symm (MvPolynomial.map f p) = (1 : B) ⊗ₜ[A] p := by
          apply e_P.injective
          rw [e_P.apply_symm_apply, he_P_one_tmul]
        change β_BC (α_A ((Ideal.Quotient.mk I_A p) ⊗ₜ[A] (1 : B))) = _
        rw [hα]
        change q₁ (MvPolynomial.map f p) = _
        dsimp [q₁, q₀]
        rw [hsymm]
        rfl
      have hOnRight : ∀ b₀ : B,
          compHom ((1 : affineBlowupRatioRing A g_A b) ⊗ₜ[A] b₀) =
            (1 : affineBlowupRatioRing A g_A b) ⊗ₜ[A] b₀ := by
        intro b₀
        have hα : α_A ((1 : affineBlowupRatioRing A g_A b) ⊗ₜ[A] b₀) =
            Ideal.Quotient.mk I_B (MvPolynomial.C b₀) := by
          rw [hα_tmul, map_one, one_mul]
        have hsymmC : e_P.symm (MvPolynomial.C b₀) = b₀ ⊗ₜ[A] (1 : P_A) := by
          apply e_P.injective
          rw [e_P.apply_symm_apply, he_P_C]
        change β_BC (α_A ((1 : affineBlowupRatioRing A g_A b) ⊗ₜ[A] b₀)) = _
        rw [hα]
        change q₁ (MvPolynomial.C b₀) = _
        dsimp [q₁, q₀]
        rw [hsymmC]
        rfl
      intro z
      change compHom z = z
      induction z using TensorProduct.induction_on with
      | zero => exact map_zero compHom
      | tmul c b₀ =>
        obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective c
        have hsplit : ((Ideal.Quotient.mk I_A p) ⊗ₜ[A] b₀) =
            ((Ideal.Quotient.mk I_A p) ⊗ₜ[A] (1 : B)) *
              ((1 : affineBlowupRatioRing A g_A b) ⊗ₜ[A] b₀) := by
          rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
        rw [hsplit, map_mul, hOnLeft p, hOnRight b₀]
      | add x y hx hy =>
        rw [map_add, hx, hy]
    let e_ring : TensorProduct A (affineBlowupRatioRing A g_A b) B ≃+*
        affineBlowupRatioRing B g_B b :=
      { α_A.toRingHom with
        invFun := β_BC
        left_inv := hLeftInv
        right_inv := hRightInv }
    have hEtBase : Algebra.Etale (affineBlowupRatioRing A g_A b)
        (TensorProduct A (affineBlowupRatioRing A g_A b) B) :=
      Algebra.Etale.baseChange A B (affineBlowupRatioRing A g_A b)
    have hEtRing : φ_b.Etale := by
      let _alg : Algebra (affineBlowupRatioRing A g_A b) (affineBlowupRatioRing B g_B b) :=
        φ_b.toAlgebra
