    exact hwne (weil_algClosed_correspondence_contraction_no_strict_spec k
      B₂ U₂ X₂ f₂ n σ B U_B ψ hIntB hProjB hUB C X_B T_B f τ hCurve hIntC hProjC
      f_XB σ_B qX_B f_TB pr₁ pr₂ hCorr hLocIsoC hLocIsoXB hConnXB
      s₀ hCls₀ s_bar hs_bar_hom hs_bar_pt hDimC_fib hTwoBr hOneBr
      c₁ w₀ w₁ hc₁ hw₀ hw₁ hwcl)
  have hLocAll : ∀ c : C.left, ∃ V : C.left.Opens, c ∈ V ∧ CategoryTheory.IsIso (pr₁.left ∣_ V) :=
    fun c => hLocIsoC c (hNoSpec c)
  choose V_cov hVmem hViso using hLocAll
  have hSup : iSup V_cov = ⊤ :=
    eq_top_iff.mpr fun c _ => TopologicalSpace.Opens.mem_iSup.mpr ⟨c, hVmem c⟩
  have hIsoPr₁ : CategoryTheory.IsIso pr₁.left :=
    @AlgebraicGeometry.IsZariskiLocalAtTarget.of_iSup_eq_top
      (CategoryTheory.MorphismProperty.isomorphisms AlgebraicGeometry.Scheme) inferInstance
