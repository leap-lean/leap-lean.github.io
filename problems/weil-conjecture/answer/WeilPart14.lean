      intro hTop
      have h1 : (1 : B) ∈ I := hTop ▸ Submodule.mem_top
      dsimp [I] at h1
      exact hx0 (by simpa using h1)
    obtain ⟨P, hP_max, hIP⟩ := Ideal.exists_le_maximal I hI_ne
    haveI : P.IsPrime := hP_max.isPrime
    haveI : IsDomain (Localization.AtPrime P) := hLoc P
    have hmap_pow : (algebraMap B (Localization.AtPrime P) x_b) ^ n_b = 0 := by
