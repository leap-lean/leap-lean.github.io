    clear * - awayToFractionRing_algebraMap
    intro R' B D _ _ _ _ _ _ ιB u hu L_D hBase hInv z
    obtain ⟨d_inv, hd_inv⟩ := hInv
    obtain ⟨⟨b, _, n, rfl⟩, hmul⟩ := IsLocalization.surj (Submonoid.powers u) z
    dsimp only at hmul
