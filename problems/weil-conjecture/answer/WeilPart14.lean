    let R'_ring := Localization.Away g_S
    let R' : CommRingCat.{u} := CommRingCat.of R'_ring
    let loc_S₃ : S₃_ring →+* R'_ring := algebraMap S₃_ring R'_ring
    haveI : IsOpenImmersion (Spec.map (CommRingCat.ofHom loc_S₃)) :=
      IsOpenImmersion.of_isLocalization g_S
    have hq₃_range : q₃ ∈ Set.range (PrimeSpectrum.comap loc_S₃) := by
      rw [PrimeSpectrum.localization_away_comap_range R'_ring g_S]
      exact hgS_not_q₃
    rcases hq₃_range with ⟨v₀_raw, hv₀_comap⟩
    let v₀ : Spec R' := v₀_raw
    let e_S₃ : Spec (CommRingCat.of S₃_ring) ⟶ C₁.left :=
      Spec.map (CommRingCat.ofHom loc_S₂) ≫ e_S₂
    let e_X : Spec R' ⟶ C₁.left := Spec.map (CommRingCat.ofHom loc_S₃) ≫ e_S₃
    
    let ψ_A₃ : MvPolynomial (Fin m) k →+* A₃_ring := loc_A₂.comp ψ_A₂
    have hEt_ψA₃ : Etale (Spec.map (CommRingCat.ofHom ψ_A₃)) := by
      have hEq : Spec.map (CommRingCat.ofHom ψ_A₃) =
          Spec.map (CommRingCat.ofHom loc_A₂) ≫ Spec.map (CommRingCat.ofHom ψ_A₂) := by
        rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
