          ((TopologicalSpace.Opens.map (e_A₂ ≫ τ).base).obj e_S₂.opensRange :
            Set (Spec A₂)) := by
        rcases hxj₀ with ⟨y, hy⟩
        have hy_eq : y = e_A₂.base p₂ := by
          calc
            y = (τ ≫ f₁.left).base y := by rw [hτ]; rfl
            _ = f₁.left.base (τ.base y) := rfl
            _ = f₁.left.base (e_S₂.base q₂) := by rw [hy, heS₂_q₂]
            _ = (e_S₂ ≫ f₁.left).base q₂ := rfl
            _ = (Spec.map (CommRingCat.ofHom φ₂) ≫ e_A₂).base q₂ := by
              rw [heS₂_f₁]
            _ = e_A₂.base p₂ := by
              change e_A₂.base ((Spec.map (CommRingCat.ofHom φ₂)).base q₂) = e_A₂.base p₂
              rw [Spec.map_apply]
              rfl
        change τ.base (e_A₂.base p₂) ∈ Set.range e_S₂.base
        rw [← hy_eq, hy, ← heS₂_q₂]
        exact ⟨q₂, rfl⟩
      obtain ⟨_, ⟨_, ⟨r₂_raw, rfl⟩, rfl⟩, hp₂_r₂, hr₂_sub⟩ :=
        PrimeSpectrum.isBasis_basic_opens.exists_subset_of_mem_open hp₂_pre
          ((TopologicalSpace.Opens.map (e_A₂ ≫ τ).base).obj e_S₂.opensRange).isOpen
      let r₂ : A₂_ring := r₂_raw
      let A₃_ring := Localization.Away r₂
      let S₃_ring := Localization.Away (φ₂ r₂)
      let A₃ : CommRingCat.{u} := CommRingCat.of A₃_ring
      let S₃ : CommRingCat.{u} := CommRingCat.of S₃_ring
      let loc_A₂ : A₂_ring →+* A₃_ring := algebraMap A₂_ring A₃_ring
      let loc_S₂ : ↑S₂ →+* S₃_ring := algebraMap (↑S₂) S₃_ring
      haveI : IsOpenImmersion (Spec.map (CommRingCat.ofHom loc_A₂)) :=
        IsOpenImmersion.of_isLocalization r₂
      haveI : IsOpenImmersion (Spec.map (CommRingCat.ofHom loc_S₂)) :=
        IsOpenImmersion.of_isLocalization (φ₂ r₂)
      let e_A₃ : Spec A₃ ⟶ B₁.left := Spec.map (CommRingCat.ofHom loc_A₂) ≫ e_A₂
      let e_S₃ : Spec S₃ ⟶ C₁.left := Spec.map (CommRingCat.ofHom loc_S₂) ≫ e_S₂
      have hy_r₂ : Submonoid.powers r₂ ≤ Submonoid.comap φ₂ (Submonoid.powers (φ₂ r₂)) :=
        Submonoid.powers_le.mpr (Submonoid.mem_powers (φ₂ r₂))
      let φ₃ : A₃_ring →+* S₃_ring := IsLocalization.map S₃_ring φ₂ hy_r₂
      have hφ₃_comp : φ₃.comp loc_A₂ = loc_S₂.comp φ₂ :=
        IsLocalization.map_comp hy_r₂
      have hq₂_range : q₂ ∈ Set.range (PrimeSpectrum.comap loc_S₂) := by
        rw [PrimeSpectrum.localization_away_comap_range S₃_ring (φ₂ r₂)]
        exact hp₂_r₂
      rcases hq₂_range with ⟨q₃_raw, hq₃⟩
      let q₃ : Spec S₃ := q₃_raw
      have he_A₃_τ_range : Set.range (e_A₃ ≫ τ).base ⊆ Set.range e_S₃.base := by
        rintro _ ⟨w, rfl⟩
        let w₀ : Spec A₂ := PrimeSpectrum.comap loc_A₂ w
        have hw₀_basic : w₀ ∈ (PrimeSpectrum.basicOpen r₂ : Set (PrimeSpectrum A₂_ring)) := by
          rw [← PrimeSpectrum.localization_away_comap_range A₃_ring r₂]
          exact ⟨w, rfl⟩
        have hw₀_in : (e_A₂ ≫ τ).base w₀ ∈ Set.range e_S₂.base := hr₂_sub hw₀_basic
        rcases hw₀_in with ⟨z₀, hz₀⟩
        let w_z₀ : Spec A₂ := PrimeSpectrum.comap φ₂ z₀
        have hz₀_comap : w_z₀ = w₀ := by
          apply e_A₂.isOpenEmbedding.injective
          have h1 : e_A₂.base w_z₀ = (e_S₂ ≫ f₁.left).base z₀ := by
            rw [heS₂_f₁]
            change e_A₂.base w_z₀ =
