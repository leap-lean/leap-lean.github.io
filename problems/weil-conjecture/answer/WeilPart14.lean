      rw [hwpα_η, hwp_η]
    have h_div_transfer : ∀ (c : Fin m) (hc : c ∈ S_exp),
        Ideal.Quotient.mk (Ideal.span {F}) (MvPolynomial.X (Sum.inr c)) ∈ P_fam p →
        Ideal.Quotient.mk (Ideal.span {F}) (MvPolynomial.X (Sum.inr c)) ∈ P_fam p_α := by
      intro c hc hmem_p
      have hmem_wp : w p ∈ {v' : AlgebraicGeometry.Spec R' |
          Ideal.Quotient.mk (Ideal.span {F}) (MvPolynomial.X (Sum.inr c)) ∈
            (q.base v').asIdeal} := by
        change Ideal.Quotient.mk (Ideal.span {F}) (MvPolynomial.X (Sum.inr c)) ∈
          (q.base (w p) : PrimeSpectrum M_ring).asIdeal
        rwa [hw_q_ideal p]
      rw [← hDiv ⟨c, hc⟩] at hmem_wp
      have hmem_wpα : w p_α ∈ (e_X ≫ f.left).base ⁻¹' Set.range (ιD_B (ρ ⟨c, hc⟩)).base := by
        change (e_X ≫ f.left).base (w p_α) ∈ Set.range (ιD_B (ρ ⟨c, hc⟩)).base
        rw [hf_eq]
        exact hmem_wp
      rw [hDiv ⟨c, hc⟩] at hmem_wpα
      change Ideal.Quotient.mk (Ideal.span {F}) (MvPolynomial.X (Sum.inr c)) ∈
        (q.base (w p_α) : PrimeSpectrum M_ring).asIdeal at hmem_wpα
      rwa [hw_q_ideal p_α] at hmem_wpα
    have hP_le_pα : P_fam p ≤ P_fam p_α := by
      rw [hP_fam_le_iff]
      refine ⟨?_, ?_, ?_⟩
      · intro a
        fin_cases a
        · exact Ideal.subset_span (by simp)
        · exact Ideal.subset_span (by simp)
      · exact h_div_transfer p.1.1 p.2.1 (Ideal.subset_span (by simp))
      · exact h_div_transfer p.1.2 p.2.2.1 (Ideal.subset_span (by simp))
    have hwp_eq : w p = w p_α := hw_eq_of_le p_α p hP_le_pα
    rw [← hwp_eq]
    exact hwp_le_u.trans hu_le_v
  · intro hwpα_le_v
    have hwpα_mem : e_X.base (w p_α) ∈ Set.range (ιE α).base :=
      hwpα_η ▸ (hη_spec α hxα).1
    exact (hη_spec α hxα).2.2.2 (w p_α) v hwpα_le_v hwpα_mem

theorem weil_etale_roof_of_toroidal_stratum_pullback (k : Type u) [Field k] (m : ℕ)
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (E : AlgebraicGeometry.Scheme.{u}) (ι_E : E ⟶ X.left)
    (hCl : AlgebraicGeometry.IsClosedImmersion ι_E)
    (hInt : AlgebraicGeometry.IsIntegral E)
    (z : E)
    (R' : CommRingCat.{u}) (v₀ : AlgebraicGeometry.Spec R')
    (e_X : AlgebraicGeometry.Spec R' ⟶ X.left)
    (S_exp : Finset (Fin m))
    (q : AlgebraicGeometry.Spec R' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
      (MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ Ideal.span
        {MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
          ∏ c ∈ S_exp, MvPolynomial.X (Sum.inr c)})))
    (i j : Fin m)
    (hEt_e : AlgebraicGeometry.Etale e_X)
    (hEt_q : AlgebraicGeometry.Etale q)
    (hv₀ : e_X.base v₀ = ι_E.base z)
    (hCard : 2 ≤ S_exp.card)
    (hi : i ∈ S_exp) (hj : j ∈ S_exp) (hij : i ≠ j)
    (hComm : q ≫ AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) = e_X ≫ X.hom)
    (hInl : ∀ a : Fin 2,
      Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl a)) ∈ (q.base v₀).asIdeal)
    (hInr_i : Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr i)) ∈ (q.base v₀).asIdeal)
    (hInr_j : Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr j)) ∈ (q.base v₀).asIdeal)
    (hPre : e_X.base ⁻¹' Set.range ι_E.base =
      {v : AlgebraicGeometry.Spec R' |
        (∀ a : Fin 2,
          Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl a)) ∈ (q.base v).asIdeal) ∧
        Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr i)) ∈ (q.base v).asIdeal ∧
        Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr j)) ∈ (q.base v).asIdeal}) :
    HasEtaleSmoothRoofOver k (m - 2) (CategoryTheory.Over.mk (ι_E ≫ X.hom)) z :=
by
  
  have hRed_of_etale : ∀ (S : AlgebraicGeometry.Scheme.{u})
      (_ : AlgebraicGeometry.IsIntegral S) (C : CommRingCat.{u})
      (f : AlgebraicGeometry.Spec C ⟶ S) (_ : AlgebraicGeometry.Etale f),
      _root_.IsReduced C := by
    intro S hIntS C f hEt_f
    have hRed_dom : ∀ (D B : Type u) [CommRing D] [IsDomain D] [CommRing B]
        [Algebra D B] [Algebra.Etale D B], _root_.IsReduced B := by
      intro D B _ _ _ _ _
      let K : Type u := FractionRing D
      have : Algebra.Etale K (TensorProduct D K B) := inferInstance
      have : _root_.IsReduced (TensorProduct D K B) :=
        Algebra.FormallyUnramified.isReduced_of_field K (TensorProduct D K B)
      have : Module.Flat D B := inferInstance
      have hInjLin : Function.Injective (LinearMap.rTensor B (Algebra.linearMap D K)) :=
        (Module.Flat.iff_rTensor_preserves_injective_linearMapₛ (R := D) (M := B)).mp inferInstance
          (Algebra.linearMap D K) (IsFractionRing.injective D K)
      have hInj : Function.Injective
          (Algebra.TensorProduct.includeRight : B →ₐ[D] TensorProduct D K B) := by
        intro b₁ b₂ hb
        have hb' : LinearMap.rTensor B (Algebra.linearMap D K) ((1 : D) ⊗ₜ[D] b₁) =
            LinearMap.rTensor B (Algebra.linearMap D K) ((1 : D) ⊗ₜ[D] b₂) := by
          simpa using hb
        simpa using congrArg (Algebra.TensorProduct.lid D B) (hInjLin hb')
      refine ⟨fun b ⟨n, hn⟩ => hInj ?_⟩
      rw [map_zero]
      exact eq_zero_of_pow_eq_zero (by rw [← map_pow, hn, map_zero])
    let Y := AlgebraicGeometry.Spec C
    refine ⟨fun c hc => ?_⟩
    let s := (AlgebraicGeometry.Scheme.ΓSpecIso C).inv c
    have hs_nil : IsNilpotent s := hc.map (AlgebraicGeometry.Scheme.ΓSpecIso C).inv.hom
    have hLoc : ∀ y : Y, ∃ V : Y.Opens, y ∈ V ∧
        Y.presheaf.map (CategoryTheory.homOfLE (le_top : V ≤ ⊤)).op s =
          Y.presheaf.map (CategoryTheory.homOfLE (le_top : V ≤ ⊤)).op 0 := by
      intro y
      obtain ⟨U_y, hAffU, hfyU, _⟩ :=
        (TopologicalSpace.Opens.isBasis_iff_nbhd.mp S.isBasis_affineOpens)
          (show f.base y ∈ (⊤ : S.Opens) from trivial)
      have hNeU : Nonempty ↥U_y := ⟨⟨f.base y, hfyU⟩⟩
      have : IsDomain ↑(S.presheaf.obj (Opposite.op U_y)) :=
        @AlgebraicGeometry.IsIntegral.component_integral S hIntS U_y hNeU
      obtain ⟨V_y, hAffV, hyV, e_y⟩ :=
        (TopologicalSpace.Opens.isBasis_iff_nbhd.mp Y.isBasis_affineOpens)
          (show y ∈ (TopologicalSpace.Opens.map f.base).obj U_y from hfyU)
      have hEt_app : (f.appLE U_y V_y e_y).hom.Etale :=
        (AlgebraicGeometry.HasRingHomProperty.iff_appLE (P := @AlgebraicGeometry.Etale)).mp
          hEt_f ⟨U_y, hAffU⟩ ⟨V_y, hAffV⟩ e_y
      let _ : Algebra ↑(S.presheaf.obj (Opposite.op U_y)) ↑(Y.presheaf.obj (Opposite.op V_y)) :=
        (f.appLE U_y V_y e_y).hom.toAlgebra
      have : Algebra.Etale ↑(S.presheaf.obj (Opposite.op U_y))
          ↑(Y.presheaf.obj (Opposite.op V_y)) :=
        RingHom.etale_algebraMap.mp hEt_app
      have : _root_.IsReduced ↑(Y.presheaf.obj (Opposite.op V_y)) :=
        hRed_dom ↑(S.presheaf.obj (Opposite.op U_y)) ↑(Y.presheaf.obj (Opposite.op V_y))
      refine ⟨V_y, hyV, ?_⟩
      rw [map_zero]
      exact (hs_nil.map (Y.presheaf.map (CategoryTheory.homOfLE (le_top : V_y ≤ ⊤)).op).hom).eq_zero
    choose V hV_mem hV_eq using hLoc
    have hSup : (⊤ : Y.Opens) ≤ ⨆ y : Y, V y := by
      intro y _
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨y, hV_mem y⟩
    have hs0 : s = 0 :=
      TopCat.Sheaf.eq_of_locally_eq' Y.sheaf V (⊤ : Y.Opens)
        (fun _ => CategoryTheory.homOfLE le_top) hSup s 0 hV_eq
    have hc_eq : (AlgebraicGeometry.Scheme.ΓSpecIso C).hom s = c :=
      Iso.inv_hom_id_apply (AlgebraicGeometry.Scheme.ΓSpecIso C) c
    rw [← hc_eq, hs0, map_zero]
  
  have hPull_E : ∃ (I : Ideal R') (w₀ : AlgebraicGeometry.Spec (CommRingCat.of (R' ⧸ I)))
      (e_E : AlgebraicGeometry.Spec (CommRingCat.of (R' ⧸ I)) ⟶ E),
      AlgebraicGeometry.Etale e_E ∧
      e_E.base w₀ = z ∧
      e_E ≫ ι_E = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) ≫ e_X ∧
      (∀ v : AlgebraicGeometry.Spec R',
        I ≤ v.asIdeal ↔ v ∈ e_X.base ⁻¹' Set.range ι_E.base) := by
    have : AlgebraicGeometry.IsClosedImmersion ι_E := hCl
    have : AlgebraicGeometry.Etale e_X := hEt_e
    have hCl_snd : AlgebraicGeometry.IsClosedImmersion
        (CategoryTheory.Limits.pullback.snd ι_E e_X) := inferInstance
    have _hEt_fst : AlgebraicGeometry.Etale
        (CategoryTheory.Limits.pullback.fst ι_E e_X) := inferInstance
    obtain ⟨I, e_iso, he_snd⟩ := AlgebraicGeometry.IsClosedImmersion.Spec_iff.mp hCl_snd
    let e_E : AlgebraicGeometry.Spec (CommRingCat.of (R' ⧸ I)) ⟶ E :=
      e_iso.inv ≫ CategoryTheory.Limits.pullback.fst ι_E e_X
    have hEt_eE : AlgebraicGeometry.Etale e_E := inferInstance
    obtain ⟨p₀, hp_fst, _hp_snd⟩ :=
      AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback z v₀ hv₀.symm
    let w₀ : AlgebraicGeometry.Spec (CommRingCat.of (R' ⧸ I)) := e_iso.hom.base p₀
    have hw₀ : e_E.base w₀ = z := by
      change (e_iso.hom ≫ e_iso.inv ≫ CategoryTheory.Limits.pullback.fst ι_E e_X).base p₀ = z
      rw [e_iso.hom_inv_id_assoc]
      exact hp_fst
    have hComm_I : e_E ≫ ι_E =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) ≫ e_X := by
      dsimp [e_E]
      rw [Category.assoc, CategoryTheory.Limits.pullback.condition, he_snd,
        Category.assoc, e_iso.inv_hom_id_assoc]
    have hZero_I : ∀ v : AlgebraicGeometry.Spec R',
        I ≤ v.asIdeal ↔ v ∈ e_X.base ⁻¹' Set.range ι_E.base := by
      have hPreRange : e_X.base ⁻¹' Set.range ι_E.base =
          Set.range (CategoryTheory.Limits.pullback.snd ι_E e_X).base :=
        (AlgebraicGeometry.Scheme.Pullback.range_snd ι_E e_X).symm
      rw [hPreRange, he_snd]
      have hSurj_iso : Function.Surjective e_iso.hom.base := by
        intro q_pt
        refine ⟨e_iso.inv.base q_pt, ?_⟩
        change (e_iso.inv ≫ e_iso.hom).base q_pt = q_pt
        rw [e_iso.inv_hom_id]
        rfl
      have hRange_eq : Set.range (e_iso.hom ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))).base =
          Set.range (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))).base := by
        change Set.range ((AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (Ideal.Quotient.mk I))).base ∘ e_iso.hom.base) = _
        exact hSurj_iso.range_comp _
      rw [hRange_eq]
      intro v
      rw [Set.mem_range]
      constructor
      · intro hle
        let v_ps : PrimeSpectrum R' := v
        have : v_ps.asIdeal.IsPrime := v_ps.isPrime
        have hker : RingHom.ker (Ideal.Quotient.mk I) ≤ v_ps.asIdeal := by
          rwa [Ideal.mk_ker]
        refine ⟨(⟨Ideal.map (Ideal.Quotient.mk I) v_ps.asIdeal,
          Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective hker⟩ :
          PrimeSpectrum (R' ⧸ I)), ?_⟩
        apply PrimeSpectrum.ext
        ext x
        change x ∈ Ideal.comap (Ideal.Quotient.mk I)
          (Ideal.map (Ideal.Quotient.mk I) v_ps.asIdeal) ↔ x ∈ v_ps.asIdeal
        rw [Ideal.comap_map_of_surjective (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective,
          ← RingHom.ker_eq_comap_bot, sup_eq_left.mpr hker]
      · rintro ⟨w, rfl⟩
        intro x hx
        change (Ideal.Quotient.mk I) x ∈ w.asIdeal
        rw [Ideal.Quotient.eq_zero_iff_mem.mpr hx]
        exact w.asIdeal.zero_mem
    exact ⟨I, w₀, e_E, hEt_eE, hw₀, hComm_I, hZero_I⟩
  
  let F : MvPolynomial (Fin 2 ⊕ Fin m) k :=
    MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
      ∏ c ∈ S_exp, MvPolynomial.X (Sum.inr c)
  let M := MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ Ideal.span {F}
  let P_ij : Ideal M := Ideal.span
    {Ideal.Quotient.mk (Ideal.span {F}) (MvPolynomial.X (Sum.inl 0)),
     Ideal.Quotient.mk (Ideal.span {F}) (MvPolynomial.X (Sum.inl 1)),
     Ideal.Quotient.mk (Ideal.span {F}) (MvPolynomial.X (Sum.inr i)),
     Ideal.Quotient.mk (Ideal.span {F}) (MvPolynomial.X (Sum.inr j))}
  have hTorEquiv : Nonempty (MvPolynomial (Fin (m - 2)) k ≃ₐ[k] (M ⧸ P_ij)) := by
    classical
    let S_rem : Finset (Fin m) := (Finset.univ.erase j).erase i
    have hj_univ : j ∈ (Finset.univ : Finset (Fin m)) := Finset.mem_univ j
    have hi_er : i ∈ (Finset.univ : Finset (Fin m)).erase j :=
      Finset.mem_erase.mpr ⟨hij, Finset.mem_univ i⟩
    have hCard_rem : Fintype.card ↥S_rem = m - 2 := by
      rw [Fintype.card_coe]
      dsimp [S_rem]
      rw [Finset.card_erase_of_mem hi_er, Finset.card_erase_of_mem hj_univ, Finset.card_univ,
        Fintype.card_fin]
      omega
    let e_rem : Fin (m - 2) ≃ ↥S_rem := (Fintype.equivFinOfCardEq hCard_rem).symm
    let φ_fwd : MvPolynomial (Fin (m - 2)) k →ₐ[k] (M ⧸ P_ij) :=
      MvPolynomial.aeval (fun r : Fin (m - 2) =>
        Ideal.Quotient.mk P_ij (Ideal.Quotient.mk (Ideal.span {F})
          (MvPolynomial.X (Sum.inr (e_rem r).1))))
    let w : Fin 2 ⊕ Fin m → MvPolynomial (Fin (m - 2)) k := fun s =>
      match s with
      | Sum.inl _ => 0
      | Sum.inr c =>
        if hc : c ∈ S_rem then MvPolynomial.X (e_rem.symm ⟨c, hc⟩) else 0
    let ev₀ : MvPolynomial (Fin 2 ⊕ Fin m) k →ₐ[k] MvPolynomial (Fin (m - 2)) k :=
      MvPolynomial.aeval w
    have hi_not : i ∉ S_rem := by simp [S_rem]
    have hj_not : j ∉ S_rem := by simp [S_rem]
    have hev₀_F : ∀ x ∈ Ideal.span {F}, ev₀ x = 0 := by
      intro x hx
      rw [Ideal.mem_span_singleton] at hx
      rcases hx with ⟨q_pol, rfl⟩
      rw [map_mul]
      have hF0 : ev₀ F = 0 := by
        dsimp [F]
        rw [map_sub, map_mul, map_prod]
        have hwi : w (Sum.inr i) = 0 := by simp [w, hi_not]
        have hprod0 : (∏ c ∈ S_exp, ev₀ (MvPolynomial.X (Sum.inr c))) = 0 := by
          refine Finset.prod_eq_zero hi ?_
          simp [ev₀, hwi]
        rw [hprod0]
        simp [ev₀, w]
      rw [hF0, zero_mul]
    let ev₁ : M →ₐ[k] MvPolynomial (Fin (m - 2)) k :=
      Ideal.Quotient.liftₐ (Ideal.span {F}) ev₀ hev₀_F
    have hev₁_P : ∀ y ∈ P_ij, ev₁ y = 0 := by
      intro y hy
      have hle : P_ij ≤ RingHom.ker ev₁.toRingHom := by
        rw [Ideal.span_le]
        intro z hz
        simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
        rcases hz with rfl | rfl | rfl | rfl
        · change ev₀ (MvPolynomial.X (Sum.inl 0)) = 0
          simp [ev₀, w]
        · change ev₀ (MvPolynomial.X (Sum.inl 1)) = 0
          simp [ev₀, w]
        · change ev₀ (MvPolynomial.X (Sum.inr i)) = 0
          simp [ev₀, w, hi_not]
        · change ev₀ (MvPolynomial.X (Sum.inr j)) = 0
          simp [ev₀, w, hj_not]
      exact hle hy
    let φ_inv : (M ⧸ P_ij) →ₐ[k] MvPolynomial (Fin (m - 2)) k :=
      Ideal.Quotient.liftₐ P_ij ev₁ hev₁_P
    have h_left : φ_inv.comp φ_fwd = AlgHom.id k (MvPolynomial (Fin (m - 2)) k) := by
      apply MvPolynomial.algHom_ext
      intro r
      change φ_inv (φ_fwd (MvPolynomial.X r)) = MvPolynomial.X r
      have hfwd : φ_fwd (MvPolynomial.X r) =
          Ideal.Quotient.mk P_ij (Ideal.Quotient.mk (Ideal.span {F})
            (MvPolynomial.X (Sum.inr (e_rem r).1))) := MvPolynomial.aeval_X _ r
      rw [hfwd]
      change ev₀ (MvPolynomial.X (Sum.inr (e_rem r).1)) = MvPolynomial.X r
      simp [ev₀, w]
    have h_right : φ_fwd.comp φ_inv = AlgHom.id k (M ⧸ P_ij) := by
      ext x
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective x
      obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective y
      let lhs : MvPolynomial (Fin 2 ⊕ Fin m) k →ₐ[k] (M ⧸ P_ij) := φ_fwd.comp ev₀
      let rhs : MvPolynomial (Fin 2 ⊕ Fin m) k →ₐ[k] (M ⧸ P_ij) :=
        (IsScalarTower.toAlgHom k M (M ⧸ P_ij)).comp
          (IsScalarTower.toAlgHom k (MvPolynomial (Fin 2 ⊕ Fin m) k) M)
      have hEqAlg : lhs = rhs := by
        apply MvPolynomial.algHom_ext
        intro s
        cases s with
        | inl a =>
          fin_cases a
          · have hmem : Ideal.Quotient.mk (Ideal.span {F}) (MvPolynomial.X (Sum.inl 0)) ∈ P_ij :=
              Ideal.subset_span (by simp)
            change lhs (MvPolynomial.X (Sum.inl 0)) =
              Ideal.Quotient.mk P_ij (Ideal.Quotient.mk (Ideal.span {F})
                (MvPolynomial.X (Sum.inl 0)))
            rw [Ideal.Quotient.eq_zero_iff_mem.mpr hmem]
            simp [lhs, ev₀, w]
          · have hmem : Ideal.Quotient.mk (Ideal.span {F}) (MvPolynomial.X (Sum.inl 1)) ∈ P_ij :=
              Ideal.subset_span (by simp)
            change lhs (MvPolynomial.X (Sum.inl 1)) =
              Ideal.Quotient.mk P_ij (Ideal.Quotient.mk (Ideal.span {F})
                (MvPolynomial.X (Sum.inl 1)))
            rw [Ideal.Quotient.eq_zero_iff_mem.mpr hmem]
            simp [lhs, ev₀, w]
        | inr c =>
          by_cases hc : c ∈ S_rem
          · change lhs (MvPolynomial.X (Sum.inr c)) =
              Ideal.Quotient.mk P_ij (Ideal.Quotient.mk (Ideal.span {F})
                (MvPolynomial.X (Sum.inr c)))
            simp [lhs, φ_fwd, ev₀, w, hc]
          · have hcij : c = i ∨ c = j := by
              simp only [S_rem, Finset.mem_erase, Finset.mem_univ, and_true] at hc
              tauto
            rcases hcij with rfl | rfl
            · have hmem : Ideal.Quotient.mk (Ideal.span {F})
                  (MvPolynomial.X (Sum.inr c)) ∈ P_ij :=
                Ideal.subset_span (by simp)
              change lhs (MvPolynomial.X (Sum.inr c)) =
                Ideal.Quotient.mk P_ij (Ideal.Quotient.mk (Ideal.span {F})
                  (MvPolynomial.X (Sum.inr c)))
              rw [Ideal.Quotient.eq_zero_iff_mem.mpr hmem]
              simp [lhs, ev₀, w, hc]
            · have hmem : Ideal.Quotient.mk (Ideal.span {F})
                  (MvPolynomial.X (Sum.inr c)) ∈ P_ij :=
                Ideal.subset_span (by simp)
              change lhs (MvPolynomial.X (Sum.inr c)) =
                Ideal.Quotient.mk P_ij (Ideal.Quotient.mk (Ideal.span {F})
                  (MvPolynomial.X (Sum.inr c)))
              rw [Ideal.Quotient.eq_zero_iff_mem.mpr hmem]
              simp [lhs, ev₀, w, hc]
      exact AlgHom.congr_fun hEqAlg p
    exact ⟨AlgEquiv.ofAlgHom φ_fwd φ_inv h_right h_left⟩
  obtain ⟨θ⟩ := hTorEquiv
  
  have hBaseChangeGen : ∀ (M₀ : Type u) [CommRing M₀] [Algebra k M₀]
      (P₀ : Ideal M₀) (_ : MvPolynomial (Fin (m - 2)) k ≃ₐ[k] (M₀ ⧸ P₀))
      (q₀ : AlgebraicGeometry.Spec R' ⟶ AlgebraicGeometry.Spec (CommRingCat.of M₀)),
      AlgebraicGeometry.Etale q₀ →
      ∃ (J : Ideal R') (ψ : MvPolynomial (Fin (m - 2)) k →+* R' ⧸ J),
        AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) ∧
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J)) ≫
            q₀ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k M₀)) ∧
        (∀ v : AlgebraicGeometry.Spec R',
          J ≤ v.asIdeal ↔ P₀ ≤ (q₀.base v).asIdeal) := by
    intro M₀ _ _ P₀ θ₀ q₀ hEt_q₀
    let φ_cat : CommRingCat.of M₀ ⟶ R' := AlgebraicGeometry.Spec.preimage q₀
    let φ : M₀ →+* R' := φ_cat.hom
    have hq_eq : AlgebraicGeometry.Spec.map φ_cat = q₀ := AlgebraicGeometry.Spec.map_preimage q₀
    have hEt_spec : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map φ_cat) := by rwa [hq_eq]
    have hEt_φ : φ.Etale :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hEt_spec
    letI : Algebra M₀ R' := φ.toAlgebra
    have : Algebra.Etale M₀ R' := RingHom.etale_algebraMap.mp hEt_φ
    let J : Ideal R' := Ideal.map (algebraMap M₀ R') P₀
    have : Algebra.Etale (M₀ ⧸ P₀) (TensorProduct M₀ (M₀ ⧸ P₀) R') := inferInstance
    let e_ring : TensorProduct M₀ (M₀ ⧸ P₀) R' ≃+* (R' ⧸ J) :=
      (Algebra.TensorProduct.comm M₀ (M₀ ⧸ P₀) R').toRingEquiv.trans
        (Algebra.TensorProduct.quotIdealMapEquivTensorQuot R' P₀).symm.toRingEquiv
    have he_alg : ∀ x : M₀ ⧸ P₀,
        e_ring (algebraMap (M₀ ⧸ P₀) (TensorProduct M₀ (M₀ ⧸ P₀) R') x) =
          algebraMap (M₀ ⧸ P₀) (R' ⧸ J) x := by
      intro x
      obtain ⟨m₀, rfl⟩ := Ideal.Quotient.mk_surjective x
      rw [Ideal.Quotient.algebraMap_quotient_map_quotient]
      have hcomm_x : (Algebra.TensorProduct.comm M₀ (M₀ ⧸ P₀) R')
          (algebraMap (M₀ ⧸ P₀) (TensorProduct M₀ (M₀ ⧸ P₀) R') (Ideal.Quotient.mk P₀ m₀)) =
          (algebraMap M₀ R' m₀) ⊗ₜ[M₀] (1 : M₀ ⧸ P₀) := by
        calc
          (Algebra.TensorProduct.comm M₀ (M₀ ⧸ P₀) R') ((Ideal.Quotient.mk P₀ m₀) ⊗ₜ[M₀] (1 : R'))
            = (1 : R') ⊗ₜ[M₀] (m₀ • (1 : M₀ ⧸ P₀)) := by
              simp [Algebra.smul_def]
          _ = (m₀ • (1 : R')) ⊗ₜ[M₀] (1 : M₀ ⧸ P₀) :=
              (TensorProduct.smul_tmul m₀ (1 : R') (1 : M₀ ⧸ P₀)).symm
          _ = (algebraMap M₀ R' m₀) ⊗ₜ[M₀] (1 : M₀ ⧸ P₀) := by
              rw [Algebra.smul_def, mul_one]
      change (Algebra.TensorProduct.quotIdealMapEquivTensorQuot R' P₀).symm
        ((Algebra.TensorProduct.comm M₀ (M₀ ⧸ P₀) R')
          (algebraMap (M₀ ⧸ P₀) (TensorProduct M₀ (M₀ ⧸ P₀) R') (Ideal.Quotient.mk P₀ m₀))) = _
      rw [hcomm_x, ← Algebra.TensorProduct.quotIdealMapEquivTensorQuot_mk R' P₀ (algebraMap M₀ R' m₀)]
      exact (Algebra.TensorProduct.quotIdealMapEquivTensorQuot R' P₀).symm_apply_apply _
    let e_alg : TensorProduct M₀ (M₀ ⧸ P₀) R' ≃ₐ[M₀ ⧸ P₀] (R' ⧸ J) := AlgEquiv.ofRingEquiv he_alg
    have : Algebra.Etale (M₀ ⧸ P₀) (R' ⧸ J) := Algebra.Etale.of_equiv e_alg
    have hEt_quot : (algebraMap (M₀ ⧸ P₀) (R' ⧸ J)).Etale :=
      RingHom.etale_algebraMap.mpr inferInstance
    let ψ : MvPolynomial (Fin (m - 2)) k →+* R' ⧸ J :=
      (algebraMap (M₀ ⧸ P₀) (R' ⧸ J)).comp θ₀.toRingHom
    have hEt_θ : θ₀.toRingHom.Etale := RingHom.Etale.of_bijective θ₀.bijective
    have hEt_ψ : ψ.Etale :=
      RingHom.Etale.stableUnderComposition θ₀.toRingHom (algebraMap (M₀ ⧸ P₀) (R' ⧸ J))
        hEt_θ hEt_quot
    have hEt_spec_ψ : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hEt_ψ
    have hRingComm : ψ.comp MvPolynomial.C =
        ((Ideal.Quotient.mk J).comp φ).comp (algebraMap k M₀) := by
      ext c
      dsimp [ψ]
      rw [← MvPolynomial.algebraMap_eq, θ₀.commutes c,
        IsScalarTower.algebraMap_apply k M₀ (M₀ ⧸ P₀) c,
        ← IsScalarTower.algebraMap_apply M₀ (M₀ ⧸ P₀) (R' ⧸ J)]
      rfl
    have hSpecComm : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J)) ≫
          q₀ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k M₀)) := by
      have h1 : CommRingCat.ofHom MvPolynomial.C ≫ CommRingCat.ofHom ψ =
          CommRingCat.ofHom (algebraMap k M₀) ≫ φ_cat ≫ CommRingCat.ofHom (Ideal.Quotient.mk J) := by
        have hφ_cat : φ_cat = CommRingCat.ofHom φ := rfl
        rw [hφ_cat, ← Category.assoc, ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp,
          ← CommRingCat.ofHom_comp, hRingComm, RingHom.comp_assoc]
      rw [← AlgebraicGeometry.Spec.map_comp, h1, AlgebraicGeometry.Spec.map_comp,
        AlgebraicGeometry.Spec.map_comp, hq_eq, Category.assoc]
    have hZero : ∀ v : AlgebraicGeometry.Spec R',
        J ≤ v.asIdeal ↔ P₀ ≤ (q₀.base v).asIdeal := by
      intro v
      have hqv : (q₀.base v).asIdeal = Ideal.comap φ v.asIdeal := by
        rw [← hq_eq]
        rfl
      rw [hqv]
      exact Ideal.map_le_iff_le_comap
    exact ⟨J, ψ, hEt_spec_ψ, hSpecComm, hZero⟩
  
  obtain ⟨I, w₀, e_E, hEt_eE, hw₀, hComm_I, hZero_I⟩ := hPull_E
  obtain ⟨J, ψ_E, hEt_ψE, hComm_J, hZero_J⟩ := hBaseChangeGen M P_ij θ q hEt_q
  have hRed_I : _root_.IsReduced (R' ⧸ I) :=
    hRed_of_etale E hInt (CommRingCat.of (R' ⧸ I)) e_E hEt_eE
  have hRad_I : I.IsRadical := (Ideal.isRadical_iff_quotient_reduced I).mpr hRed_I
  have hInt_A : AlgebraicGeometry.IsIntegral
      (AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin (m - 2)) k))) :=
    (AlgebraicGeometry.affine_isIntegral_iff
      (CommRingCat.of (MvPolynomial (Fin (m - 2)) k))).mpr inferInstance
  have hRed_J : _root_.IsReduced (R' ⧸ J) :=
    hRed_of_etale _ hInt_A (CommRingCat.of (R' ⧸ J))
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_E)) hEt_ψE
  have hRad_J : J.IsRadical := (Ideal.isRadical_iff_quotient_reduced J).mpr hRed_J
  have hZeroEq : PrimeSpectrum.zeroLocus (I : Set R') = PrimeSpectrum.zeroLocus (J : Set R') := by
    ext v
    have hvI : I ≤ v.asIdeal ↔ v ∈ e_X.base ⁻¹' Set.range ι_E.base := hZero_I v
    have hvJ : J ≤ v.asIdeal ↔ P_ij ≤ (q.base v).asIdeal := hZero_J v
    have hvP : P_ij ≤ (q.base v).asIdeal ↔
        v ∈ ({w : AlgebraicGeometry.Spec R' |
          (∀ a : Fin 2,
            Ideal.Quotient.mk (Ideal.span {F}) (MvPolynomial.X (Sum.inl a)) ∈ (q.base w).asIdeal) ∧
          Ideal.Quotient.mk (Ideal.span {F}) (MvPolynomial.X (Sum.inr i)) ∈ (q.base w).asIdeal ∧
          Ideal.Quotient.mk (Ideal.span {F}) (MvPolynomial.X (Sum.inr j)) ∈ (q.base w).asIdeal}) := by
      simp only [P_ij, Ideal.span_le, Set.insert_subset_iff, Set.singleton_subset_iff,
        SetLike.mem_coe, Fin.forall_fin_two]
      exact ⟨fun ⟨h0, h1, hi', hj'⟩ => ⟨⟨h0, h1⟩, hi', hj'⟩,
        fun ⟨⟨h0, h1⟩, hi', hj'⟩ => ⟨h0, h1, hi', hj'⟩⟩
    change I ≤ v.asIdeal ↔ J ≤ v.asIdeal
    rw [hvI, hPre, hvJ, hvP]
  have hIJ : I = J := by
    have hRadEq := PrimeSpectrum.zeroLocus_eq_iff.mp hZeroEq
    rwa [hRad_I.radical, hRad_J.radical] at hRadEq
  subst hIJ
  have hAlgMap : algebraMap k M = (Ideal.Quotient.mk (Ideal.span {F})).comp MvPolynomial.C := by
    rw [IsScalarTower.algebraMap_eq k (MvPolynomial (Fin 2 ⊕ Fin m) k) M,
      MvPolynomial.algebraMap_eq]
    rfl
  refine ⟨CommRingCat.of (R' ⧸ I), w₀, e_E, ψ_E, hEt_eE, hEt_ψE, hw₀, ?_⟩
  change AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_E) ≫
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) =
    e_E ≫ (ι_E ≫ X.hom)
  rw [hComm_J, hAlgMap, hComm, ← Category.assoc, ← hComm_I, Category.assoc]

theorem weil_toroidal_squarefree_pair_of_weight_zero (k : Type u) [Field k] [IsAlgClosed k] (m : ℕ)
    (B₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (Z_B₁ : Set B₁.left)
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (Z_X : Set X.left) (f : X ⟶ B₁)
    (T : Fin 0 → TopologicalSpace.Closeds ↥X.left) (n_T : Fin 0 → ℕ)
    (hIntX : AlgebraicGeometry.IsIntegral X.left)
    (hProjX : IsProjectiveOverField k X)
    (hState : IsToroidalResolutionState k m B₁ Z_B₁ X Z_X f 0 T n_T) :
    ∃ N : ℕ, IsEtaleToroidalSquarefreeData k m N X Z_X :=
by
  rcases hState with ⟨hClosedZ, _, _, _, _, r_B, D_B, ιD_B, _, _, _, _, _, hChartsX⟩
  let S_tor : Set X.left := {x : X.left | ¬ HasEtaleSmoothRoofOver k (m + 1) X x}
  have hClosedS : IsClosed S_tor := by
    rw [← isOpen_compl_iff, isOpen_iff_forall_mem_open]
    intro x hx
    have hRoof : HasEtaleSmoothRoofOver k (m + 1) X x := by
      dsimp [S_tor] at hx
      exact not_not.mp hx
    rcases hRoof with ⟨R', v₀, e_X, ψ, hEt_e, hEt_ψ, hv₀, hComm⟩
    have : AlgebraicGeometry.Etale e_X := hEt_e
    have : AlgebraicGeometry.UniversallyOpen e_X :=
      AlgebraicGeometry.UniversallyOpen.of_flat e_X
    refine ⟨Set.range e_X.base, ?_, e_X.isOpenMap.isOpen_range, ⟨v₀, hv₀⟩⟩
    rintro _ ⟨v, rfl⟩
    dsimp [S_tor]
    exact not_not.mpr ⟨R', v, e_X, ψ, hEt_e, hEt_ψ, rfl, hComm⟩
  obtain ⟨N, E, ιE, hClE, hIntE, hIncompE, hEqS⟩ :=
    weil_projective_closed_irreducible_subschemes k X hProjX S_tor hClosedS
  have hPairE : _root_.Pairwise fun α β : Fin N =>
      Set.range (ιE α).base ≠ Set.range (ιE β).base :=
    fun α β hne hEq => hIncompE hne hEq.le
  have hDichotomy : ∀ x : X.left,
      ((x ∉ ⋃ α : Fin N, Set.range (ιE α).base) ∧
        ∃ (R' : CommRingCat.{u}) (v₀ : AlgebraicGeometry.Spec R')
          (e_X : AlgebraicGeometry.Spec R' ⟶ X.left)
          (ψ : MvPolynomial (Fin (m + 1)) k →+* R')
          (I : Finset (Fin (m + 1))),
          AlgebraicGeometry.Etale e_X ∧
          AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) ∧
          e_X.base v₀ = x ∧
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = e_X ≫ X.hom) ∧
          (∀ i ∈ I, ψ (MvPolynomial.X i) ∈ v₀.asIdeal) ∧
          e_X.base ⁻¹' Z_X =
            {v : AlgebraicGeometry.Spec R' | ∃ i ∈ I, ψ (MvPolynomial.X i) ∈ v.asIdeal}) ∨
      ((x ∈ ⋃ α : Fin N, Set.range (ιE α).base) ∧
        ∃ (R' : CommRingCat.{u}) (v₀ : AlgebraicGeometry.Spec R')
          (e_X : AlgebraicGeometry.Spec R' ⟶ X.left)
          (S_exp S_bdry : Finset (Fin m))
          (q : AlgebraicGeometry.Spec R' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
            (MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ Ideal.span
              {MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
                ∏ i ∈ S_exp, MvPolynomial.X (Sum.inr i)}))),
          AlgebraicGeometry.Etale e_X ∧
          AlgebraicGeometry.Etale q ∧
          e_X.base v₀ = x ∧
          2 ≤ S_exp.card ∧
          S_exp ⊆ S_bdry ∧
          (q ≫ AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) = e_X ≫ X.hom) ∧
          (∀ a : Fin 2,
            Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl a)) ∈ (q.base v₀).asIdeal) ∧
          (∀ i ∈ S_bdry,
            Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr i)) ∈ (q.base v₀).asIdeal) ∧
          e_X.base ⁻¹' Z_X =
            {v : AlgebraicGeometry.Spec R' |
              ∃ i ∈ S_bdry,
                Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr i)) ∈ (q.base v).asIdeal} ∧
          (∀ α : Fin N, x ∉ Set.range (ιE α).base →
            e_X.base ⁻¹' Set.range (ιE α).base = ∅) ∧
          (∀ α : Fin N, x ∈ Set.range (ιE α).base →
            ∃ i ∈ S_exp, ∃ j ∈ S_exp, i ≠ j ∧
              e_X.base ⁻¹' Set.range (ιE α).base =
                {v : AlgebraicGeometry.Spec R' |
                  (∀ a : Fin 2,
                    Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl a)) ∈ (q.base v).asIdeal) ∧
                  Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr i)) ∈ (q.base v).asIdeal ∧
                  Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr j)) ∈ (q.base v).asIdeal})) := by
    intro x
    rcases hChartsX x with ⟨_, R', v₀, e_X, ψ, I, hEt_e, hEt_ψ, hv₀, hComm, hMemI, hZ⟩ |
      ⟨R'₀, v₀, e_X₀, a, S_bdry, ρ_a, q_a, hEt_e₀, hEt_qa, hv₀, hSum_a, hSub_a,
        _, hComm_a, hInl_a, hInr_a, hZ_a, hDiv_a, _, _, hAll2⟩
    · refine Or.inl ⟨?_, R', v₀, e_X, ψ, I, hEt_e, hEt_ψ, hv₀, hComm, hMemI, hZ⟩
      rw [← hEqS]
      intro hxS
      exact hxS ⟨R', v₀, e_X, ψ, hEt_e, hEt_ψ, hv₀, hComm⟩
    · have ha_le : ∀ c : Fin m, a c ≤ 1 := by
        intro c
        by_contra hlt
        have h2 : 2 ≤ a c := by omega
        rcases hAll2 c h2 with ⟨α, _⟩
        exact Fin.elim0 α
      let S_exp : Finset (Fin m) := Finset.univ.filter (fun c => a c = 1)
      have hSub : S_exp ⊆ S_bdry := by
        intro c hc
        have hc1 : a c = 1 := (Finset.mem_filter.mp hc).2
        exact hSub_a c (by omega)
      have ha_eq : ∀ c : Fin m, a c = if c ∈ S_exp then 1 else 0 := by
        intro c
        have hle := ha_le c
        by_cases hc1 : a c = 1
        · have hmem : c ∈ S_exp := Finset.mem_filter.mpr ⟨Finset.mem_univ c, hc1⟩
          simp [hmem, hc1]
        · have hnot : c ∉ S_exp := fun hmem => hc1 (Finset.mem_filter.mp hmem).2
          simp [hnot]
          omega
      have hCard : 2 ≤ S_exp.card := by
        have hEqSum : (∑ c : Fin m, a c) = S_exp.card := by
          calc
            (∑ c : Fin m, a c) = ∑ c : Fin m, (if c ∈ S_exp then 1 else 0) :=
              Finset.sum_congr rfl (fun c _ => ha_eq c)
            _ = S_exp.card := by simp
        rwa [← hEqSum]
      have hProd : (∏ c : Fin m,
          (MvPolynomial.X (Sum.inr c) : MvPolynomial (Fin 2 ⊕ Fin m) k) ^ a c) =
          ∏ i ∈ S_exp, MvPolynomial.X (Sum.inr i) := by
        have hEach : ∀ c : Fin m,
            (MvPolynomial.X (Sum.inr c) : MvPolynomial (Fin 2 ⊕ Fin m) k) ^ a c =
            if c ∈ S_exp then MvPolynomial.X (Sum.inr c) else 1 := by
          intro c
          rw [ha_eq c]
          split_ifs <;> simp
        simp_rw [hEach, Finset.prod_ite, Finset.prod_const_one, mul_one,
          Finset.filter_mem_eq_inter, Finset.univ_inter]
      let ρ' : ↥S_exp → Fin r_B := fun c =>
        ρ_a ⟨c.1, by have := (Finset.mem_filter.mp c.2).2; omega⟩
      have hConv : ∀ (P_rhs : MvPolynomial (Fin 2 ⊕ Fin m) k)
          (_ : P_rhs = ∏ i ∈ S_exp, MvPolynomial.X (Sum.inr i))
          (q₀ : AlgebraicGeometry.Spec R'₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of
            (MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ Ideal.span
              {MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) - P_rhs}))),
          AlgebraicGeometry.Etale q₀ →
          (q₀ ≫ AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) = e_X₀ ≫ X.hom) →
          (∀ b : Fin 2,
            Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl b)) ∈ (q₀.base v₀).asIdeal) →
          (∀ c ∈ S_bdry,
            Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c)) ∈ (q₀.base v₀).asIdeal) →
          (e_X₀.base ⁻¹' Z_X =
            {v : AlgebraicGeometry.Spec R'₀ |
              ∃ c ∈ S_bdry,
                Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c)) ∈ (q₀.base v).asIdeal}) →
          (∀ c : ↥S_exp,
            (e_X₀ ≫ f.left).base ⁻¹' Set.range (ιD_B (ρ' c)).base =
              {v : AlgebraicGeometry.Spec R'₀ |
                Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c.1)) ∈ (q₀.base v).asIdeal}) →
          (x ∈ ⋃ α : Fin N, Set.range (ιE α).base) ∧
            ∃ (R' : CommRingCat.{u}) (v'₀ : AlgebraicGeometry.Spec R')
              (e_X : AlgebraicGeometry.Spec R' ⟶ X.left)
              (S_exp' S_bdry' : Finset (Fin m))
              (q : AlgebraicGeometry.Spec R' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
                (MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ Ideal.span
                  {MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
                    ∏ i ∈ S_exp', MvPolynomial.X (Sum.inr i)}))),
              AlgebraicGeometry.Etale e_X ∧
              AlgebraicGeometry.Etale q ∧
              e_X.base v'₀ = x ∧
              2 ≤ S_exp'.card ∧
              S_exp' ⊆ S_bdry' ∧
              (q ≫ AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) = e_X ≫ X.hom) ∧
              (∀ a : Fin 2,
                Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl a)) ∈ (q.base v'₀).asIdeal) ∧
              (∀ i ∈ S_bdry',
                Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr i)) ∈ (q.base v'₀).asIdeal) ∧
              e_X.base ⁻¹' Z_X =
                {v : AlgebraicGeometry.Spec R' |
                  ∃ i ∈ S_bdry',
                    Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr i)) ∈ (q.base v).asIdeal} ∧
              (∀ α : Fin N, x ∉ Set.range (ιE α).base →
                e_X.base ⁻¹' Set.range (ιE α).base = ∅) ∧
              (∀ α : Fin N, x ∈ Set.range (ιE α).base →
                ∃ i ∈ S_exp', ∃ j ∈ S_exp', i ≠ j ∧
                  e_X.base ⁻¹' Set.range (ιE α).base =
                    {v : AlgebraicGeometry.Spec R' |
                      (∀ a : Fin 2,
                        Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl a)) ∈ (q.base v).asIdeal) ∧
                      Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr i)) ∈ (q.base v).asIdeal ∧
                      Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr j)) ∈ (q.base v).asIdeal}) := by
        rintro _ rfl q₀ hEt_q₀ hComm₀ hInl₀ hInr₀ hZ₀ hDiv₀
        have hxMem : x ∈ ⋃ α : Fin N, Set.range (ιE α).base := by
          rw [← hEqS]
          dsimp [S_tor]
          rw [← hv₀]
          have h1lt : 1 < S_exp.card := by omega
          obtain ⟨i₀, j₀, hi₀, hj₀, hij₀⟩ := Finset.one_lt_card_iff.mp h1lt
          exact (weil_toroidal_squarefree_etale_locus_iff k m X R'₀ e_X₀ S_exp q₀
            hEt_e₀ hEt_q₀ hCard hComm₀ v₀).mpr
            ⟨i₀, hi₀, j₀, hj₀, hij₀, hInl₀, hInr₀ i₀ (hSub hi₀), hInr₀ j₀ (hSub hj₀)⟩
        have hSing₀ : e_X₀.base ⁻¹' (⋃ α : Fin N, Set.range (ιE α).base) =
            {v : AlgebraicGeometry.Spec R'₀ |
              ∃ i ∈ S_exp, ∃ j ∈ S_exp, i ≠ j ∧
                (∀ a : Fin 2,
                  Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl a)) ∈ (q₀.base v).asIdeal) ∧
                Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr i)) ∈ (q₀.base v).asIdeal ∧
                Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr j)) ∈ (q₀.base v).asIdeal} := by
          rw [← hEqS]
          ext v
          exact weil_toroidal_squarefree_etale_locus_iff k m X R'₀ e_X₀ S_exp q₀
            hEt_e₀ hEt_q₀ hCard hComm₀ v
        obtain ⟨R', v'₀, e_X, q, hEt_e, hEt_q, hv'₀, hComm, hInl, hInr, hZ, hAvoid, hHit⟩ :=
          weil_toroidal_chart_stratum_shrinking k m r_B N B₁ D_B ιD_B X Z_X f E ιE
            hClE hIntE hIncompE x R'₀ v₀ e_X₀ S_exp S_bdry ρ' q₀
            hEt_e₀ hEt_q₀ hv₀ hCard hSub hComm₀ hInl₀ hInr₀ hZ₀ hDiv₀ hSing₀
        exact ⟨hxMem, R', v'₀, e_X, S_exp, S_bdry, q, hEt_e, hEt_q, hv'₀, hCard, hSub,
          hComm, hInl, hInr, hZ, hAvoid, hHit⟩
      exact Or.inr (hConv _ hProd q_a hEt_qa hComm_a hInl_a hInr_a hZ_a
        (fun c => hDiv_a c.1 (by have := (Finset.mem_filter.mp c.2).2; omega)))
  refine ⟨N, hClosedZ, E, ιE, hClE, hIntE, ?_, hPairE, hDichotomy⟩
  intro α z
  have hxα : (ιE α).base z ∈ Set.range (ιE α).base := ⟨z, rfl⟩
  have hxUnion : (ιE α).base z ∈ ⋃ β : Fin N, Set.range (ιE β).base :=
    Set.mem_iUnion.mpr ⟨α, hxα⟩
  rcases hDichotomy ((ιE α).base z) with ⟨hxNotUnion, _⟩ |
    ⟨_, R', v'₀, e_X, S_exp, S_bdry, q, hEt_e, hEt_q, hv'₀, hCard, hSub,
      hComm, hInl, hInr, _, _, hHit⟩
  · exact (hxNotUnion hxUnion).elim
  · obtain ⟨i, hi, j, hj, hij, hPre⟩ := hHit α hxα
    exact weil_etale_roof_of_toroidal_stratum_pullback k m X (E α) (ιE α)
      (hClE α) (hIntE α) z R' v'₀ e_X S_exp q i j
      hEt_e hEt_q hv'₀ hCard hi hj hij hComm hInl
      (hInr i (hSub hi)) (hInr j (hSub hj)) hPre

theorem weil_semistable_curve_codim2_toroidal_blowup (k : Type u) [Field k] [IsAlgClosed k] (m : ℕ)
    (B₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (Z_B₁ : Set B₁.left) (U_B₁ : B₁.left.Opens)
    (hIntB₁ : AlgebraicGeometry.IsIntegral B₁.left)
    (hProjB₁ : IsProjectiveOverField k B₁)
    (hSmB₁ : AlgebraicGeometry.SmoothOfRelativeDimension m B₁.hom)
    (hSncB₁ : IsSncDivisorSupport k m B₁ Z_B₁)
    (hU_B₁_eq : (U_B₁ : Set B₁.left) = Z_B₁ᶜ)
    (hU_B₁ : Nonempty U_B₁)
    (C₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (f₁ : C₁ ⟶ B₁) (n : ℕ) (τ₁ : Fin n → (B₁ ⟶ C₁))
    (hCurve₁ : IsSemistablePointedCurveOver k f₁ U_B₁ n τ₁)
    (hIntC₁ : AlgebraicGeometry.IsIntegral C₁.left)
    (hProjC₁ : IsProjectiveOverField k C₁) :
    ∃ (C₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (Z₂ : Set C₂.left) (π₂ : C₂ ⟶ C₁) (N : ℕ),
      AlgebraicGeometry.IsIntegral C₂.left ∧
      IsProjectiveOverField k C₂ ∧
      IsGenFiniteEtaleAlterationOver k π₂ ∧
      π₂.left.base ⁻¹' (f₁.left.base ⁻¹' Z_B₁ ∪
        ⋃ j : Fin n, Set.range (τ₁ j).left.base) ⊆ Z₂ ∧
      IsToroidalSquarefreePair k m N C₂ Z₂ :=
by
  let Z₁ : Set C₁.left :=
    f₁.left.base ⁻¹' Z_B₁ ∪ ⋃ j : Fin n, Set.range (τ₁ j).left.base
  let W₁ : C₁.left.Opens := f₁.left ⁻¹ᵁ U_B₁
  have hSurj_f₁ : AlgebraicGeometry.Surjective f₁.left := hCurve₁.2.2.2.1
  have hSm_f₁U : AlgebraicGeometry.SmoothOfRelativeDimension 1 (f₁.left ∣_ U_B₁) :=
    hCurve₁.2.2.2.2.2.1
  have hW₁_ne : Nonempty W₁ := by
    obtain ⟨⟨y₀, hy₀⟩⟩ := hU_B₁
    obtain ⟨x₀, hx₀⟩ := hSurj_f₁.surj y₀
    refine ⟨⟨x₀, ?_⟩⟩
    change f₁.left.base x₀ ∈ U_B₁
    rwa [hx₀]
  have hSm_UB₁ : AlgebraicGeometry.SmoothOfRelativeDimension m (U_B₁.ι ≫ B₁.hom) := by
    have h0m := AlgebraicGeometry.smoothOfRelativeDimension_comp 0 m U_B₁.ι B₁.hom
    simpa [Nat.zero_add] using h0m
  have hW₁_sm : AlgebraicGeometry.SmoothOfRelativeDimension (m + 1) (W₁.ι ≫ C₁.hom) := by
    have h1m := AlgebraicGeometry.smoothOfRelativeDimension_comp 1 m
      (f₁.left ∣_ U_B₁) (U_B₁.ι ≫ B₁.hom)
    have hEq : (f₁.left ∣_ U_B₁) ≫ (U_B₁.ι ≫ B₁.hom) = W₁.ι ≫ C₁.hom := by
      rw [← Category.assoc, AlgebraicGeometry.morphismRestrict_ι, Category.assoc, Over.w f₁]
    rw [Nat.add_comm 1 m, hEq] at h1m
    exact h1m
  obtain ⟨K₀, T₀, n_T₀, hState₀⟩ :=
    weil_semistable_curve_initial_toroidal_state k m B₁ Z_B₁ U_B₁
      hIntB₁ hProjB₁ hSmB₁ hSncB₁ hU_B₁_eq hU_B₁ C₁ f₁ n τ₁
      hCurve₁ hIntC₁ hProjC₁
  have hMain : ∀ (Φ : ℕ)
      (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (Z_X : Set X.left) (f : X ⟶ B₁)
      (K : ℕ) (T : Fin K → TopologicalSpace.Closeds ↥X.left) (n_T : Fin K → ℕ),
      Φ = (∑ α : Fin K, n_T α) →
      AlgebraicGeometry.IsIntegral X.left →
      IsProjectiveOverField k X →
      IsToroidalResolutionState k m B₁ Z_B₁ X Z_X f K T n_T →
      ∃ (C₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (Z₂ : Set C₂.left) (π : C₂ ⟶ X) (N : ℕ),
        AlgebraicGeometry.IsIntegral C₂.left ∧
        IsProjectiveOverField k C₂ ∧
        AlgebraicGeometry.IsProper π.left ∧
        AlgebraicGeometry.Surjective π.left ∧
        (∀ U₀ : X.left.Opens,
          (∀ x ∈ U₀, ∃ V : X.left.Opens,
            x ∈ V ∧ AlgebraicGeometry.SmoothOfRelativeDimension (m + 1) (V.ι ≫ X.hom)) →
          CategoryTheory.IsIso (π.left ∣_ U₀)) ∧
        Z₂ = π.left.base ⁻¹' Z_X ∧
        IsToroidalSquarefreePair k m N C₂ Z₂ := by
    intro Φ
    refine Nat.strongRecOn Φ (fun Φ ih X Z_X f K T n_T hΦ hIntX hProjX hState => ?_)
    cases K with
    | zero =>
      obtain ⟨N, hEtSq⟩ :=
        weil_toroidal_squarefree_pair_of_weight_zero k m B₁ Z_B₁ X Z_X f T n_T hIntX hProjX hState
      rcases hEtSq with ⟨hClosedZ, E, ιE, hClE, hIntE, hEtE, hPairE, hCharts⟩
      have hSmE : ∀ α : Fin N,
          AlgebraicGeometry.SmoothOfRelativeDimension (m - 2) (ιE α ≫ X.hom) := by
        intro α
        let Y_α : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
          CategoryTheory.Over.mk (ιE α ≫ X.hom)
        have hProjY_α : IsProjectiveOverField k Y_α := by
          obtain ⟨M_X, ι_X, hCl_X⟩ := hProjX
          have : AlgebraicGeometry.IsClosedImmersion (ιE α) := hClE α
          have : AlgebraicGeometry.IsClosedImmersion ι_X.left := hCl_X
          refine ⟨M_X, CategoryTheory.Over.homMk (ιE α ≫ ι_X.left) ?_, ?_⟩
          · dsimp [Y_α]
            rw [Category.assoc, Over.w ι_X]
          · change AlgebraicGeometry.IsClosedImmersion (ιE α ≫ ι_X.left)
            exact inferInstance
        have hLoc : ∀ z : E α, ∃ V : (E α).Opens,
            z ∈ V ∧ AlgebraicGeometry.SmoothOfRelativeDimension (m - 2)
              (V.ι ≫ (ιE α ≫ X.hom)) := by
          intro z
          obtain ⟨R', w₀, e_E, ψ_E, hEt_e, hEt_ψ, hw₀, hComm⟩ := hEtE α z
          exact (weil_smoothOfRelativeDimension_and_toroidal_sing_of_etale
            k Y_α hProjY_α z).1 (m - 2) R' w₀ e_E ψ_E hEt_e hEt_ψ hw₀ hComm
        rw [AlgebraicGeometry.smoothOfRelativeDimension_iff]
        intro z
        obtain ⟨V, hzV, hSmV⟩ := hLoc z
        rw [AlgebraicGeometry.smoothOfRelativeDimension_iff] at hSmV
        obtain ⟨U_k, hAffU_k, W, hAffW, hzW, he, hStd⟩ := hSmV ⟨z, hzV⟩
        let W' : (E α).Opens := (AlgebraicGeometry.Scheme.Hom.opensFunctor V.ι).obj W
        have hAffW' : AlgebraicGeometry.IsAffineOpen W' := hAffW.image_of_isOpenImmersion V.ι
        have hzW' : z ∈ W' := ⟨⟨z, hzV⟩, hzW, rfl⟩
        have he' : W' ≤ (TopologicalSpace.Opens.map (ιE α ≫ X.hom).base).obj U_k := by
          rintro _ ⟨w, hw, rfl⟩
          exact he hw
        have he₂ : W ≤ (TopologicalSpace.Opens.map V.ι.base).obj W' :=
          fun w hw => ⟨w, hw, rfl⟩
        refine ⟨U_k, hAffU_k, W', hAffW', hzW', he', ?_⟩
        have hAppEq : (ιE α ≫ X.hom).appLE U_k W' he' =
            (V.ι ≫ (ιE α ≫ X.hom)).appLE U_k W he := by
          rw [← AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE V.ι (ιE α ≫ X.hom)
            U_k W' W he' he₂, AlgebraicGeometry.Scheme.Opens.ι_appLE]
          have hRefl : CategoryTheory.homOfLE
              (show (AlgebraicGeometry.Scheme.Hom.opensFunctor V.ι).obj W ≤ W' from le_rfl) =
              𝟙 W' := rfl
          erw [hRefl, CategoryTheory.op_id, (E α).presheaf.map_id, Category.comp_id]
        rwa [hAppEq]
      have hNotSm_of_mem : ∀ x : X.left,
          x ∈ (⋃ α : Fin N, Set.range (ιE α).base) →
          ¬ ∃ V : X.left.Opens,
            x ∈ V ∧ AlgebraicGeometry.SmoothOfRelativeDimension (m + 1) (V.ι ≫ X.hom) := by
        intro x hxMem
        rcases hCharts x with ⟨hxNotMem, _⟩ | ⟨_, R', v₀, e_X, S_exp, S_bdry, q,
            hEt_e, hEt_q, hv₀, hCard, hSub, hComm, hInl, hInr, _, _, _⟩
        · exact (hxNotMem hxMem).elim
        · let a : Fin m → ℕ := fun c => if c ∈ S_exp then 1 else 0
          have hProd : (∏ i ∈ S_exp,
              (MvPolynomial.X (Sum.inr i) : MvPolynomial (Fin 2 ⊕ Fin m) k)) =
              ∏ c : Fin m, MvPolynomial.X (Sum.inr c) ^ a c := by
            have hEach : ∀ c : Fin m,
                (MvPolynomial.X (Sum.inr c) : MvPolynomial (Fin 2 ⊕ Fin m) k) ^ a c =
                if c ∈ S_exp then MvPolynomial.X (Sum.inr c) else 1 := by
              intro c
              dsimp [a]
              split_ifs <;> simp
            simp_rw [hEach, Finset.prod_ite, Finset.prod_const_one, mul_one,
              Finset.filter_mem_eq_inter, Finset.univ_inter]
          have hSum : 2 ≤ ∑ c ∈ S_exp, a c := by
            have hEqCard : (∑ c ∈ S_exp, a c) = S_exp.card := by
              calc
                (∑ c ∈ S_exp, a c) = ∑ _c ∈ S_exp, 1 := by
                  refine Finset.sum_congr rfl fun c hc => ?_
                  simp [a, hc]
                _ = S_exp.card := by simp
            rwa [hEqCard]
          have hInr_exp : ∀ c ∈ S_exp,
              Ideal.Quotient.mk
                (Ideal.span {MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
                  ∏ i ∈ S_exp, MvPolynomial.X (Sum.inr i)})
                (MvPolynomial.X (Sum.inr c)) ∈ (q.base v₀).asIdeal :=
            fun c hc => hInr c (hSub hc)
          have hGen : ∀ (P_rhs : MvPolynomial (Fin 2 ⊕ Fin m) k)
              (_ : P_rhs = ∏ c : Fin m, MvPolynomial.X (Sum.inr c) ^ a c)
              (q' : AlgebraicGeometry.Spec R' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
                (MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ Ideal.span
                  {MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) - P_rhs}))),
              AlgebraicGeometry.Etale q' →
              (q' ≫ AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) = e_X ≫ X.hom) →
              (∀ b : Fin 2,
                Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl b)) ∈ (q'.base v₀).asIdeal) →
              (∀ c ∈ S_exp,
                Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr c)) ∈ (q'.base v₀).asIdeal) →
              ¬ ∃ V : X.left.Opens,
                x ∈ V ∧ AlgebraicGeometry.SmoothOfRelativeDimension (m + 1) (V.ι ≫ X.hom) := by
            rintro _ rfl q' hEt_q' hComm' hInl' hInr'
            exact (weil_smoothOfRelativeDimension_and_toroidal_sing_of_etale
              k X hProjX x).2 m R' v₀ e_X a S_exp q' hEt_e hEt_q' hv₀ hComm' hInl' hInr' hSum
          exact hGen _ hProd q hEt_q hComm hInl hInr_exp
      have hSm_of_notMem : ∀ x : X.left,
          x ∉ (⋃ α : Fin N, Set.range (ιE α).base) →
          ∃ V : X.left.Opens,
            x ∈ V ∧ AlgebraicGeometry.SmoothOfRelativeDimension (m + 1) (V.ι ≫ X.hom) := by
        intro x hxNotMem
        rcases hCharts x with ⟨_, R', v₀, e_X, ψ, I, hEt_e, hEt_ψ, hv₀, hComm, _, _⟩ | ⟨hxMem, _⟩
        · exact (weil_smoothOfRelativeDimension_and_toroidal_sing_of_etale
            k X hProjX x).1 (m + 1) R' v₀ e_X ψ hEt_e hEt_ψ hv₀ hComm
        · exact (hxNotMem hxMem).elim
      have hTorPair : IsToroidalSquarefreePair k m N X Z_X := by
        refine ⟨hClosedZ, E, ιE, hClE, hIntE, hSmE, hPairE, ?_, ?_⟩
        · ext x
          exact ⟨fun hNotSm => Classical.byContradiction fun hxNotMem =>
              hNotSm (hSm_of_notMem x hxNotMem),
            fun hxMem => hNotSm_of_mem x hxMem⟩
        · intro x
          rcases hCharts x with ⟨hxNotMem, hLeft⟩ | ⟨_, hRight⟩
          · exact Or.inl ⟨hSm_of_notMem x hxNotMem, hLeft⟩
          · exact Or.inr hRight
      refine ⟨X, Z_X, 𝟙 X, N, hIntX, hProjX, ?_, ?_, ?_, ?_, hTorPair⟩
      · change AlgebraicGeometry.IsProper (𝟙 X.left)
        exact inferInstance
      · change AlgebraicGeometry.Surjective (𝟙 X.left)
        exact inferInstance
      · intro U₀ _
        change CategoryTheory.IsIso ((𝟙 X.left) ∣_ U₀)
        exact inferInstance
      · simp
    | succ K_pred =>
      have hNotSm_T0 : ∀ x ∈ (T 0 : Set X.left),
          ¬ ∃ V : X.left.Opens,
            x ∈ V ∧ AlgebraicGeometry.SmoothOfRelativeDimension (m + 1) (V.ι ≫ X.hom) := by
        intro x hxT0
        rcases hState with ⟨_, _, _, _, _, r_B, D_B, ιD_B, _, _, _, _, _, hChartsX⟩
        rcases hChartsX x with ⟨hNotMemT, _⟩ |
          ⟨R', v₀, e_X, a, S_bdry, _ρ, q, hEt_e, hEt_q, hv₀, hSumAll, hSubBdry,
            _, hComm, hInl, hInr, _, _, _, _, _⟩
        · exact (hNotMemT 0 hxT0).elim
        · have hSumBdry : 2 ≤ ∑ c ∈ S_bdry, a c := by
            have hEqSum : (∑ c ∈ S_bdry, a c) = ∑ c : Fin m, a c := by
              symm
              rw [← Finset.sum_add_sum_compl S_bdry]
              have hZeroCompl : (∑ c ∈ S_bdryᶜ, a c) = 0 := by
                refine Finset.sum_eq_zero fun c hc => ?_
                have hcNot : c ∉ S_bdry := Finset.mem_compl.mp hc
                by_contra hNe
                exact hcNot (hSubBdry c (Nat.one_le_iff_ne_zero.mpr hNe))
              rw [hZeroCompl, add_zero]
            rwa [hEqSum]
          exact (weil_smoothOfRelativeDimension_and_toroidal_sing_of_etale
            k X hProjX x).2 m R' v₀ e_X a S_bdry q hEt_e hEt_q hv₀ hComm hInl hInr hSumBdry
      let I₀ : X.left.IdealSheafData :=
        AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal (T 0)
      have hSuppI₀ : (I₀.support : Set X.left) ≠ Set.univ := by
        rcases hState.2.1 with ⟨x₀, V₀, hx₀, hSmV₀⟩
        intro hUniv
        have hx₀_T0 : x₀ ∈ (T 0 : Set X.left) := by
          rw [← AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal (T 0)]
          change x₀ ∈ (I₀.support : Set X.left)
          rw [hUniv]
          trivial
        exact hNotSm_T0 x₀ hx₀_T0 ⟨V₀, hx₀, hSmV₀⟩
      obtain ⟨X', π₁, hBlowup⟩ :=
        weil_projective_blowup_of_idealSheaf k X hIntX hProjX I₀ hSuppI₀
      obtain ⟨K', T', n_T', hlt_sum, hState'⟩ :=
        weil_toroidal_state_codim2_blowup_step k m B₁ Z_B₁ X Z_X f K_pred T n_T
          hIntX hProjX hState X' π₁ hBlowup
      rcases hBlowup with ⟨hIntX', hProjX', hProp₁, hSurj₁, hIso₁, _⟩
      have hlt_Φ : (∑ α : Fin K', n_T' α) < Φ := by
        rwa [hΦ]
      obtain ⟨C₂, Z₂, π', N, hInt₂, hProj₂, hProp', hSurj', hIso', hZ₂_eq, hTor₂⟩ :=
        ih (∑ α : Fin K', n_T' α) hlt_Φ X' (π₁.left.base ⁻¹' Z_X) (π₁ ≫ f)
          K' T' n_T' rfl hIntX' hProjX' hState'
      refine ⟨C₂, Z₂, π' ≫ π₁, N, hInt₂, hProj₂, ?_, ?_, ?_, ?_, hTor₂⟩
      · change AlgebraicGeometry.IsProper (π'.left ≫ π₁.left)
        exact inferInstance
      · change AlgebraicGeometry.Surjective (π'.left ≫ π₁.left)
        exact inferInstance
      · intro U₀ hU₀_sm
        have hDisjU₀ : Disjoint (U₀ : Set X.left) (I₀.support : Set X.left) := by
          rw [Set.disjoint_left]
          intro x hxU₀ hxSupp
          have hxT0 : x ∈ (T 0 : Set X.left) := by
            rwa [← AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal (T 0)]
          exact hNotSm_T0 x hxT0 (hU₀_sm x hxU₀)
        have hIso_π₁_U₀ : CategoryTheory.IsIso (π₁.left ∣_ U₀) := hIso₁ U₀ hDisjU₀
        have hPre_sm : ∀ x' ∈ (π₁.left ⁻¹ᵁ U₀ : X'.left.Opens),
            ∃ V' : X'.left.Opens,
              x' ∈ V' ∧ AlgebraicGeometry.SmoothOfRelativeDimension (m + 1) (V'.ι ≫ X'.hom) := by
          intro x' hx'
          have hxU₀ : π₁.left.base x' ∈ U₀ := hx'
          obtain ⟨V, hxV, hSmV⟩ := hU₀_sm (π₁.left.base x') hxU₀
          have hDisjV : Disjoint (V : Set X.left) (I₀.support : Set X.left) := by
            rw [Set.disjoint_left]
            intro y hyV hySupp
            have hyT0 : y ∈ (T 0 : Set X.left) := by
              rwa [← AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal (T 0)]
            exact hNotSm_T0 y hyT0 ⟨V, hyV, hSmV⟩
          have : CategoryTheory.IsIso (π₁.left ∣_ V) := hIso₁ V hDisjV
          let V' : X'.left.Opens := π₁.left ⁻¹ᵁ V
          refine ⟨V', hxV, ?_⟩
          have h0Sm := AlgebraicGeometry.smoothOfRelativeDimension_comp 0 (m + 1)
            (π₁.left ∣_ V) (V.ι ≫ X.hom)
          have hEqV' : (π₁.left ∣_ V) ≫ (V.ι ≫ X.hom) = V'.ι ≫ X'.hom := by
            rw [← Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
              Category.assoc, Over.w π₁]
          rw [Nat.zero_add, hEqV'] at h0Sm
          exact h0Sm
        have hIso_π'_pre : CategoryTheory.IsIso (π'.left ∣_ (π₁.left ⁻¹ᵁ U₀)) :=
          hIso' (π₁.left ⁻¹ᵁ U₀) hPre_sm
        change CategoryTheory.IsIso ((π'.left ≫ π₁.left) ∣_ U₀)
        rw [AlgebraicGeometry.morphismRestrict_comp]
        exact @CategoryTheory.IsIso.comp_isIso _ _ _ _ _
          (π'.left ∣_ (π₁.left ⁻¹ᵁ U₀)) (π₁.left ∣_ U₀) hIso_π'_pre hIso_π₁_U₀
      · rw [hZ₂_eq]
        rfl
  obtain ⟨C₂, Z₂, π₂, N, hInt₂, hProj₂, hProp₂, hSurj₂, hIso₂, hZ₂_eq, hTor₂⟩ :=
    hMain (∑ α : Fin K₀, n_T₀ α) C₁ Z₁ f₁ K₀ T₀ n_T₀ rfl hIntC₁ hProjC₁ hState₀
  have : CategoryTheory.IsIso (π₂.left ∣_ W₁) :=
    hIso₂ W₁ (fun x hx => ⟨W₁, hx, hW₁_sm⟩)
  have hAlt₂ : IsGenFiniteEtaleAlterationOver k π₂ :=
    ⟨hProp₂, hSurj₂, W₁, hW₁_ne, inferInstance, inferInstance, inferInstance⟩
  refine ⟨C₂, Z₂, π₂, N, hInt₂, hProj₂, hAlt₂, ?_, hTor₂⟩
  rw [hZ₂_eq]

theorem weil_toroidal_squarefree_zero_strata_smooth_nc (k : Type u) [Field k] (m : ℕ)
    (C₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (Z₂ : Set C₂.left)
    (hTor₀ : IsToroidalSquarefreePair k m 0 C₂ Z₂) :
    AlgebraicGeometry.SmoothOfRelativeDimension (m + 1) C₂.hom ∧
    IsEtaleLocalNcDivisor k (m + 1) C₂ Z₂ :=
by
  have hFE_comp : ∀ {A B C : Type u} [CommRing A] [CommRing B] [CommRing C]
      {f : A →+* B} {g : B →+* C},
      f.FormallyEtale → g.FormallyEtale → (g.comp f).FormallyEtale := by
    intro A B C _ _ _ f g hf hg
    let _ : Algebra A B := f.toAlgebra
    let _ : Algebra B C := g.toAlgebra
    let _ : Algebra A C := (g.comp f).toAlgebra
    have _ : IsScalarTower A B C := IsScalarTower.of_algebraMap_eq' rfl
    have _ : Algebra.FormallyEtale A B := RingHom.formallyEtale_algebraMap.mp hf
    have _ : Algebra.FormallyEtale B C := RingHom.formallyEtale_algebraMap.mp hg
    exact RingHom.formallyEtale_algebraMap.mpr (Algebra.FormallyEtale.comp A B C)
  have hFE_equiv : ∀ {A B : Type u} [CommRing A] [CommRing B] (e : A ≃+* B),
      e.toRingHom.FormallyEtale := by
    intro A B _ _ e
    let _ : Algebra A B := e.toRingHom.toAlgebra
    let eAlg : A ≃ₐ[A] B := { e with commutes' := fun _ => rfl }
    exact RingHom.formallyEtale_algebraMap.mpr (Algebra.FormallyEtale.of_equiv eAlg)
  have hFE_etale : ∀ {A B : Type u} [CommRing A] [CommRing B] {f : A →+* B},
      f.Etale → f.FormallyEtale := by
    intro A B _ _ f hf
    let _ : Algebra A B := f.toAlgebra
    have _ : Algebra.Etale A B := RingHom.etale_algebraMap.mp hf
    exact RingHom.formallyEtale_algebraMap.mpr Algebra.Etale.formallyEtale
  
  have hPart1 : ∀ (d : ℕ) {X Y : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Y),
      (∀ x : X, ∃ V : X.Opens,
        x ∈ V ∧ AlgebraicGeometry.SmoothOfRelativeDimension d (V.ι ≫ f)) →
      AlgebraicGeometry.SmoothOfRelativeDimension d f := by
    intro d X Y f hOpen
    refine ⟨fun x => ?_⟩
    obtain ⟨V, hxV, hSmV⟩ := hOpen x
    obtain ⟨U, hAffU, W', hAffW', hxW', e', hStd'⟩ :=
      (AlgebraicGeometry.smoothOfRelativeDimension_iff d (V.ι ≫ f)).mp hSmV ⟨x, hxV⟩
    let W : X.Opens := V.ι ''ᵁ W'
    have hAffW : AlgebraicGeometry.IsAffineOpen W :=
      hAffW'.image_of_isOpenImmersion V.ι
    have hxW : x ∈ W := ⟨⟨x, hxV⟩, hxW', rfl⟩
    have e : W ≤ (TopologicalSpace.Opens.map f.base).obj U := by
      rintro _ ⟨z, hz, rfl⟩
      exact e' hz
    have e₂ : W' ≤ (TopologicalSpace.Opens.map V.ι.base).obj W := by
      intro z hz
      exact ⟨z, hz, rfl⟩
    have hComp := AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE V.ι f U W W' e e₂
    have hAppId : V.ι.appLE W W' e₂ = 𝟙 (X.presheaf.obj (Opposite.op W)) := by
      rw [AlgebraicGeometry.Scheme.Opens.ι_appLE]
      have hHom : CategoryTheory.homOfLE (le_rfl : V.ι ''ᵁ W' ≤ W) = 𝟙 W :=
        Subsingleton.elim _ _
      exact (congrArg (fun g => X.presheaf.map g.op) hHom).trans (X.presheaf.map_id _)
    refine ⟨U, hAffU, W, hAffW, hxW, e, ?_⟩
    have hEqApp : (f.appLE U W e).hom = ((V.ι ≫ f).appLE U W' e').hom := by
      rw [← hComp]
      ext z
      change (f.appLE U W e).hom z = (V.ι.appLE W W' e₂).hom ((f.appLE U W e).hom z)
      rw [hAppId]
      rfl
    rw [hEqApp]
    exact hStd'
  
  have hPart2 : ∀ (d : ℕ) (M R' : CommRingCat.{u}) (φ_k : CommRingCat.of k ⟶ M)
      (v₀ : AlgebraicGeometry.Spec R')
      (q : AlgebraicGeometry.Spec R' ⟶ AlgebraicGeometry.Spec M),
      AlgebraicGeometry.Etale q →
      AlgebraicGeometry.SmoothOfRelativeDimension d (q ≫ AlgebraicGeometry.Spec.map φ_k) →
      ∃ (T : Type u) (_ : CommRing T) (κ : Type u) (_ : Field κ)
        (ψ_poly : MvPolynomial (Fin d) k →+* T)
        (ψ_M : M →+* T)
        (ev : T →+* κ),
        ψ_poly.FormallyEtale ∧
        ψ_M.FormallyEtale ∧
        ψ_poly.comp MvPolynomial.C = ψ_M.comp φ_k.hom ∧
        ∀ m₀ : M, m₀ ∈ (q.base v₀).asIdeal → ev (ψ_M m₀) = 0 := by
    intro d M R' φ_k v₀ q hEt_q hSm
    let φ_q : M ⟶ R' := (AlgebraicGeometry.Spec.fullyFaithful.preimage q).unop
    have hq : AlgebraicGeometry.Spec.map φ_q = q :=
      AlgebraicGeometry.Spec.fullyFaithful.map_preimage q
    have hEt_φq : RingHom.Etale φ_q.hom :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.Etale) (Q := @RingHom.Etale)).mp (hq.symm ▸ hEt_q)
    have hFE_φq : φ_q.hom.FormallyEtale := hFE_etale hEt_φq
    let φ_tot : CommRingCat.of k ⟶ R' := φ_k ≫ φ_q
    have hSmTot : AlgebraicGeometry.SmoothOfRelativeDimension d
        (AlgebraicGeometry.Spec.map φ_tot) := by
      have hEq : q ≫ AlgebraicGeometry.Spec.map φ_k = AlgebraicGeometry.Spec.map φ_tot := by
        rw [← hq, ← AlgebraicGeometry.Spec.map_comp]
      exact hEq ▸ hSm
    obtain ⟨U, _, V, hAffV, hv₀V, e, hStdV⟩ :=
      (AlgebraicGeometry.smoothOfRelativeDimension_iff d
        (AlgebraicGeometry.Spec.map φ_tot)).mp hSmTot v₀
    have hU_top : U = ⊤ := by
      ext y
      refine ⟨fun _ => trivial, fun _ => ?_⟩
      have hy : y = (AlgebraicGeometry.Spec.map φ_tot).base v₀ := Subsingleton.elim _ _
      rw [hy]
      exact e hv₀V
    have e_top : V ≤ (TopologicalSpace.Opens.map
        (AlgebraicGeometry.Spec.map φ_tot).base).obj ⊤ := fun _ _ => trivial
    have hStdTop : RingHom.IsStandardSmoothOfRelativeDimension d
        (((AlgebraicGeometry.Spec.map φ_tot).appLE ⊤ V e_top).hom) :=
      (AlgebraicGeometry.Scheme.Hom.appLE_congr
        (AlgebraicGeometry.Spec.map φ_tot) e hU_top rfl
        (fun g => RingHom.IsStandardSmoothOfRelativeDimension d g.hom)).mp hStdV
    let isoK := AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)
    let α_V : k →+* ↑((AlgebraicGeometry.Spec R').presheaf.obj (Opposite.op V)) :=
      (isoK.inv ≫ (AlgebraicGeometry.Spec.map φ_tot).appLE ⊤ V e_top).hom
    have hStd_αV : RingHom.IsStandardSmoothOfRelativeDimension d α_V := by
      change RingHom.IsStandardSmoothOfRelativeDimension d
        (((AlgebraicGeometry.Spec.map φ_tot).appLE ⊤ V e_top).hom.comp
          isoK.commRingCatIsoToRingEquiv.symm.toRingHom)
      exact (RingHom.isStandardSmoothOfRelativeDimension_respectsIso (n := d)).right
        (((AlgebraicGeometry.Spec.map φ_tot).appLE ⊤ V e_top).hom)
        isoK.commRingCatIsoToRingEquiv.symm hStdTop
    obtain ⟨ψ_V, hψV_C, hψV_et⟩ := hStd_αV.exists_etale_mvPolynomial
    have hFE_ψV : ψ_V.FormallyEtale := hFE_etale hψV_et
    obtain ⟨_, ⟨_, ⟨f, rfl⟩, rfl⟩, hv₀B, hBV⟩ :=
      (AlgebraicGeometry.isBasis_basicOpen (AlgebraicGeometry.Spec R')).exists_subset_of_mem_open
        hv₀V V.isOpen
    let B₀ : (AlgebraicGeometry.Spec R').Opens := (AlgebraicGeometry.Spec R').basicOpen f
    have hBV_le : B₀ ≤ V := hBV
    let T : Type u := ↑((AlgebraicGeometry.Spec R').presheaf.obj (Opposite.op B₀))
    let res_top_V := (AlgebraicGeometry.Spec R').presheaf.map
      (CategoryTheory.homOfLE (le_top : V ≤ ⊤)).op
    let f_V : ↑((AlgebraicGeometry.Spec R').presheaf.obj (Opposite.op V)) := res_top_V.hom f
    let B₁ : (AlgebraicGeometry.Spec R').Opens := (AlgebraicGeometry.Spec R').basicOpen f_V
    have hB₁_eq : B₁ = B₀ := by
      change (AlgebraicGeometry.Spec R').basicOpen (res_top_V.hom f) = B₀
      rw [AlgebraicGeometry.Scheme.basicOpen_res]
      exact inf_of_le_right hBV_le
    have _ : IsLocalization.Away f_V
        ↑((AlgebraicGeometry.Spec R').presheaf.obj (Opposite.op B₁)) :=
      hAffV.isLocalization_basicOpen f_V
    let res_V_B₁ := (AlgebraicGeometry.Spec R').presheaf.map
      (CategoryTheory.homOfLE ((AlgebraicGeometry.Spec R').basicOpen_le f_V)).op
    have hFE_resVB₁ : res_V_B₁.hom.FormallyEtale :=
      RingHom.formallyEtale_algebraMap.mpr
        (Algebra.FormallyEtale.of_isLocalization (Submonoid.powers f_V))
    let isoB : (AlgebraicGeometry.Spec R').presheaf.obj (Opposite.op B₀) ≅
        (AlgebraicGeometry.Spec R').presheaf.obj (Opposite.op B₁) :=
      (AlgebraicGeometry.Spec R').presheaf.mapIso (CategoryTheory.eqToIso hB₁_eq).op
    have hFE_isoB : isoB.inv.hom.FormallyEtale :=
      hFE_equiv isoB.commRingCatIsoToRingEquiv.symm
    let res_V_B₀ := (AlgebraicGeometry.Spec R').presheaf.map (CategoryTheory.homOfLE hBV_le).op
    have hResEq : res_V_B₀ = res_V_B₁ ≫ isoB.inv := by
      dsimp [res_V_B₀, res_V_B₁, isoB]
      rw [← CategoryTheory.Functor.map_comp]
      rfl
    have hFE_resVB₀ : res_V_B₀.hom.FormallyEtale := by
      rw [hResEq]
      exact hFE_comp hFE_resVB₁ hFE_isoB
    let ψ_poly : MvPolynomial (Fin d) k →+* T := res_V_B₀.hom.comp ψ_V
    have hFE_poly : ψ_poly.FormallyEtale := hFE_comp hFE_ψV hFE_resVB₀
    let isoR' := AlgebraicGeometry.Scheme.ΓSpecIso R'
    let res_top_B₀ := (AlgebraicGeometry.Spec R').presheaf.map
      (CategoryTheory.homOfLE (le_top : B₀ ≤ ⊤)).op
    have hLocTop : IsLocalization.Away f T :=
      (AlgebraicGeometry.isAffineOpen_top (AlgebraicGeometry.Spec R')).isLocalization_basicOpen f
    have hFE_resTopB₀ : res_top_B₀.hom.FormallyEtale :=
      RingHom.formallyEtale_algebraMap.mpr
        (Algebra.FormallyEtale.of_isLocalization (Submonoid.powers f))
    have hFE_isoR' : isoR'.inv.hom.FormallyEtale :=
      hFE_equiv isoR'.commRingCatIsoToRingEquiv.symm
    let ι_R' : R' →+* T := res_top_B₀.hom.comp isoR'.inv.hom
    have hFE_ιR' : ι_R'.FormallyEtale := hFE_comp hFE_isoR' hFE_resTopB₀
    let ψ_M : M →+* T := ι_R'.comp φ_q.hom
    have hFE_M : ψ_M.FormallyEtale := hFE_comp hFE_φq hFE_ιR'
    have hAlg : ψ_poly.comp MvPolynomial.C = ψ_M.comp φ_k.hom := by
      have h1 : ψ_poly.comp MvPolynomial.C = res_V_B₀.hom.comp α_V := by
        dsimp [ψ_poly]
        rw [RingHom.comp_assoc, hψV_C]
      rw [h1]
      have hNat : isoK.inv ≫ (AlgebraicGeometry.Spec.map φ_tot).appTop =
          φ_tot ≫ isoR'.inv := by
        rw [CategoryTheory.Iso.inv_comp_eq, ← CategoryTheory.Category.assoc,
          ← AlgebraicGeometry.Scheme.ΓSpecIso_naturality φ_tot,
          CategoryTheory.Category.assoc, isoR'.hom_inv_id, CategoryTheory.Category.comp_id]
      have hApp : (AlgebraicGeometry.Spec.map φ_tot).appLE ⊤ V e_top ≫ res_V_B₀ =
          (AlgebraicGeometry.Spec.map φ_tot).appTop ≫ res_top_B₀ := by
        rw [AlgebraicGeometry.Scheme.Hom.appLE_map]
        rfl
      have hCat : (isoK.inv ≫ (AlgebraicGeometry.Spec.map φ_tot).appLE ⊤ V e_top) ≫ res_V_B₀ =
          φ_k ≫ φ_q ≫ isoR'.inv ≫ res_top_B₀ := by
        rw [CategoryTheory.Category.assoc, hApp, ← CategoryTheory.Category.assoc, hNat]
        simp [φ_tot, CategoryTheory.Category.assoc]
      exact congrArg CommRingCat.Hom.hom hCat
    have _ : v₀.asIdeal.IsPrime := v₀.isPrime
    let κ : Type u := v₀.asIdeal.ResidueField
    let g_top : ↑((AlgebraicGeometry.Spec R').presheaf.obj (Opposite.op ⊤)) →+* κ :=
      (algebraMap R' κ).comp isoR'.hom.hom
    have hv₀_notMem : isoR'.hom.hom f ∉ v₀.asIdeal := by
      have hMem : v₀ ∈ PrimeSpectrum.basicOpen (isoR'.hom.hom f) := by
        rwa [← AlgebraicGeometry.basicOpen_eq_of_affine']
      exact hMem
    have hNeZero : g_top f ≠ 0 := by
      change algebraMap R' κ (isoR'.hom.hom f) ≠ 0
      intro hZero
      exact hv₀_notMem (Ideal.algebraMap_residueField_eq_zero.mp hZero)
    have hUnit : IsUnit (g_top f) := Ne.isUnit hNeZero
    let ev : T →+* κ := @IsLocalization.Away.lift _ _ T _ _ κ _ f hLocTop g_top hUnit
    have hev_ι : ∀ r : R', ev (ι_R' r) = algebraMap R' κ r := by
      intro r
      change (@IsLocalization.Away.lift _ _ T _ _ κ _ f hLocTop g_top hUnit)
        (res_top_B₀.hom (isoR'.inv.hom r)) = algebraMap R' κ r
      have hLift := @IsLocalization.Away.lift_eq _ _ T _ _ κ _ f hLocTop g_top hUnit
        (isoR'.inv.hom r)
      exact hLift.trans (by
        change algebraMap R' κ ((isoR'.inv ≫ isoR'.hom).hom r) = algebraMap R' κ r
        simp)
    refine ⟨T, inferInstance, κ, inferInstance, ψ_poly, ψ_M, ev, hFE_poly, hFE_M, hAlg, ?_⟩
    intro m₀ hm₀
    have hm₀' : φ_q.hom m₀ ∈ v₀.asIdeal := by
      rw [← hq] at hm₀
      exact hm₀
    change ev (ι_R' (φ_q.hom m₀)) = 0
    rw [hev_ι]
    exact Ideal.algebraMap_residueField_eq_zero.mpr hm₀'
  
  have hPart3 : ∀ (S_exp : Finset (Fin m)) (T : Type u) [CommRing T] (κ : Type u) [Field κ]
      (ψ_poly : MvPolynomial (Fin (m + 1)) k →+* T)
      (ψ_M : (MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ Ideal.span
        {MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
          ∏ i ∈ S_exp, MvPolynomial.X (Sum.inr i)}) →+* T)
      (ev : T →+* κ),
      2 ≤ S_exp.card →
      ψ_poly.FormallyEtale →
      ψ_M.FormallyEtale →
      ψ_poly.comp MvPolynomial.C = ψ_M.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) →
      (∀ a : Fin 2, ev (ψ_M (Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl a)))) = 0) →
      (∀ i ∈ S_exp, ev (ψ_M (Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inr i)))) = 0) →
      False := by
    clear C₂ Z₂ hTor₀ hFE_comp hFE_equiv hFE_etale hPart1 hPart2
    intro S_exp T _ κ _ ψ_poly ψ_M ev hCard hFE_poly hFE_M hAlg hVanInl hVanInr
    let P₁ := MvPolynomial (Fin (m + 1)) k
    let P₂ := MvPolynomial (Fin 2 ⊕ Fin m) k
    let F : P₂ := MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
      ∏ i ∈ S_exp, MvPolynomial.X (Sum.inr i)
    let I_F : Ideal P₂ := Ideal.span {F}
    let M := P₂ ⧸ I_F
    change M →+* T at ψ_M
    let _ : Algebra P₁ T := ψ_poly.toAlgebra
    let _ : Algebra M T := ψ_M.toAlgebra
    let _ : Algebra k T := (ψ_poly.comp MvPolynomial.C).toAlgebra
    let _ : Algebra T κ := ev.toAlgebra
    let _ : Algebra P₁ κ := (ev.comp ψ_poly).toAlgebra
    let _ : Algebra M κ := (ev.comp ψ_M).toAlgebra
    let _ : Algebra P₂ κ := ((ev.comp ψ_M).comp (Ideal.Quotient.mk I_F)).toAlgebra
    let _ : Algebra k κ := (ev.comp (ψ_poly.comp MvPolynomial.C)).toAlgebra
    have _ : IsScalarTower k P₁ T := IsScalarTower.of_algebraMap_eq' rfl
    have _ : IsScalarTower k M T :=
      ⟨fun c x y => by
        rw [Algebra.smul_def, Algebra.smul_def c x, map_mul, Algebra.smul_def x y,
          Algebra.smul_def c (algebraMap M T x * y), ← mul_assoc]
        congr 2
        exact (RingHom.congr_fun hAlg c).symm⟩
    have _ : IsScalarTower k T κ := IsScalarTower.of_algebraMap_eq' rfl
    have _ : IsScalarTower P₁ T κ := IsScalarTower.of_algebraMap_eq' rfl
    have _ : IsScalarTower M T κ := IsScalarTower.of_algebraMap_eq' rfl
    have _ : IsScalarTower k P₁ κ := IsScalarTower.of_algebraMap_eq' rfl
    have _ : IsScalarTower k M κ :=
      ⟨fun c x y => by
        rw [Algebra.smul_def, Algebra.smul_def c x, map_mul, Algebra.smul_def x y,
          Algebra.smul_def c (algebraMap M κ x * y), ← mul_assoc]
        congr 2
        exact congrArg ev (RingHom.congr_fun hAlg c).symm⟩
    have _ : IsScalarTower P₂ M κ :=
      ⟨fun p x y => by
        rw [Algebra.smul_def, Algebra.smul_def p x, map_mul, Algebra.smul_def x y,
          Algebra.smul_def p (algebraMap M κ x * y), ← mul_assoc]
        rfl⟩
    have _ : IsScalarTower k P₂ κ :=
      ⟨fun c p y => by
        rw [Algebra.smul_def, Algebra.smul_def c p, map_mul, Algebra.smul_def p y,
          Algebra.smul_def c (algebraMap P₂ κ p * y), ← mul_assoc]
        congr 2
        exact congrArg ev (RingHom.congr_fun hAlg c).symm⟩
    have _ : SMulCommClass T κ κ := Algebra.to_smulCommClass
    have _ : SMulCommClass P₁ κ κ := Algebra.to_smulCommClass
    have _ : SMulCommClass M κ κ := Algebra.to_smulCommClass
    have _ : SMulCommClass P₂ κ κ := Algebra.to_smulCommClass
    have _ : Algebra.FormallyEtale P₁ T := RingHom.formallyEtale_algebraMap.mp hFE_poly
    have _ : Algebra.FormallyEtale M T := RingHom.formallyEtale_algebraMap.mp hFE_M
    have feEquiv : ∀ (S : Type u) [CommRing S] [Algebra k S] [Algebra S T] [Algebra S κ]
        [IsScalarTower k S T] [IsScalarTower S T κ] [IsScalarTower k S κ]
        [SMulCommClass S κ κ] [Algebra.FormallyEtale S T],
        Nonempty (Derivation k T κ ≃ₗ[κ] Derivation k S κ) := by
      intro S _ _ _ _ _ _ _ _ _
      let Φ : Derivation k T κ →ₗ[κ] Derivation k S κ :=
        { toFun := fun D => D.compAlgebraMap S
          map_add' := fun _ _ => by ext; rfl
          map_smul' := fun _ _ => by ext; rfl }
      refine ⟨LinearEquiv.ofBijective Φ ⟨?_, ?_⟩⟩
      · intro D₁ D₂ hEq
        have hSub : Φ (D₁ - D₂) = 0 := by rw [map_sub, hEq, sub_self]
        suffices hZero : ∀ D : Derivation k T κ, Φ D = 0 → D = 0 by
          exact sub_eq_zero.mp (hZero (D₁ - D₂) hSub)
        intro D hD
        let eS := KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale k S T
        let ℓT : Ω[T⁄k] →ₗ[T] κ := (KaehlerDifferential.linearMapEquivDerivation k T).symm D
        have hCompZero : ℓT.comp eS.toLinearMap = 0 := by
          refine LinearMap.ext fun x => ?_
          change ℓT (eS x) = 0
          refine TensorProduct.induction_on (motive := fun x => ℓT (eS x) = 0) x
            (by simp) (fun t ω => ?_) (fun x y hx hy => by simp [hx, hy])
          have hmem : ω ∈ (⊤ : Submodule S Ω[S⁄k]) := Submodule.mem_top
          rw [← KaehlerDifferential.span_range_derivation k S] at hmem
          refine Submodule.span_induction (p := fun u _ => ℓT (eS (t ⊗ₜ[S] u)) = 0)
            (fun y hy => ?_) (by simp)
            (fun u v _ _ hu hv => by simp [TensorProduct.tmul_add, hu, hv])
            (fun s u _ hu => ?_) hmem
          · rcases hy with ⟨s, rfl⟩
            have he : eS (t ⊗ₜ[S] KaehlerDifferential.D k S s) =
                t • KaehlerDifferential.D k T (algebraMap S T s) := by
              have h1 : eS ((1 : T) ⊗ₜ[S] KaehlerDifferential.D k S s) =
                  KaehlerDifferential.D k T (algebraMap S T s) := by
                rw [← KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale_symm_D_algebraMap k S T s]
                exact eS.apply_symm_apply _
              have hsmul : t ⊗ₜ[S] KaehlerDifferential.D k S s =
                  t • ((1 : T) ⊗ₜ[S] KaehlerDifferential.D k S s) := by
                simp [TensorProduct.smul_tmul']
              rw [hsmul, map_smul, h1]
            rw [he, map_smul]
            have hDs : ℓT (KaehlerDifferential.D k T (algebraMap S T s)) = (Φ D) s := by
              change ((KaehlerDifferential.linearMapEquivDerivation k T) ℓT) (algebraMap S T s) = _
              rw [LinearEquiv.apply_symm_apply]
              rfl
            rw [hDs, hD]
            simp
          · have h2 : (t ⊗ₜ[S] (s • u) : TensorProduct S T Ω[S⁄k]) =
                (algebraMap S T s) • (t ⊗ₜ[S] u) := by
              rw [← TensorProduct.smul_tmul]
              simp [TensorProduct.smul_tmul', Algebra.smul_def]
            rw [h2, map_smul, map_smul, hu, smul_zero]
        have hℓT : ℓT = 0 := by
          refine LinearMap.ext fun z => ?_
          have hz := LinearMap.congr_fun hCompZero (eS.symm z)
          simpa using hz
        exact (KaehlerDifferential.linearMapEquivDerivation k T).symm.injective
          (hℓT.trans (map_zero _).symm)
      · intro d
        let eS := KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale k S T
        let ℓS : Ω[S⁄k] →ₗ[S] κ := (KaehlerDifferential.linearMapEquivDerivation k S).symm d
        let B : T →ₗ[S] (Ω[S⁄k] →ₗ[S] κ) :=
          { toFun := fun t =>
              { toFun := fun ω => t • ℓS ω
                map_add' := fun ω₁ ω₂ => by simp [smul_add]
                map_smul' := fun s ω => by
                  simp only [RingHom.id_apply, map_smul]
                  rw [← IsScalarTower.algebraMap_smul T s (ℓS ω), smul_smul, mul_comm, ← smul_smul,
                    IsScalarTower.algebraMap_smul] }
            map_add' := fun t₁ t₂ => LinearMap.ext fun ω => by simp [add_smul]
            map_smul' := fun s t => LinearMap.ext fun ω => by
              change (s • t) • ℓS ω = s • (t • ℓS ω)
              rw [Algebra.smul_def s t, mul_smul, IsScalarTower.algebraMap_smul] }
        let f₀ : TensorProduct S T Ω[S⁄k] →ₗ[S] κ := TensorProduct.lift B
        let ℓ_tilde : TensorProduct S T Ω[S⁄k] →ₗ[T] κ :=
          { toFun := f₀
            map_add' := f₀.map_add
            map_smul' := fun t₁ x => by
              change f₀ (t₁ • x) = t₁ • f₀ x
              refine TensorProduct.induction_on (motive := fun x => f₀ (t₁ • x) = t₁ • f₀ x) x
                (by simp [map_zero]) (fun t₂ ω => ?_)
                (fun x y hx hy => by rw [smul_add, map_add, map_add, hx, hy, smul_add])
              have hsmul : t₁ • (t₂ ⊗ₜ[S] ω) = (t₁ * t₂) ⊗ₜ[S] ω := by
                simp [TensorProduct.smul_tmul']
              rw [hsmul]
              change (t₁ * t₂) • ℓS ω = t₁ • (t₂ • ℓS ω)
              exact mul_smul t₁ t₂ (ℓS ω) }
        let D : Derivation k T κ :=
          (KaehlerDifferential.linearMapEquivDerivation k T) (ℓ_tilde.comp eS.symm.toLinearMap)
        refine ⟨D, ?_⟩
        ext s
        change ((KaehlerDifferential.linearMapEquivDerivation k T)
          (ℓ_tilde.comp eS.symm.toLinearMap)) (algebraMap S T s) = d s
        have hD_apply : ((KaehlerDifferential.linearMapEquivDerivation k T)
            (ℓ_tilde.comp eS.symm.toLinearMap)) (algebraMap S T s) =
            (ℓ_tilde.comp eS.symm.toLinearMap) (KaehlerDifferential.D k T (algebraMap S T s)) := rfl
        rw [hD_apply, LinearMap.comp_apply, LinearEquiv.coe_coe,
          KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale_symm_D_algebraMap]
        change (1 : T) • ℓS (KaehlerDifferential.D k S s) = d s
        rw [one_smul]
        change ((KaehlerDifferential.linearMapEquivDerivation k S) ℓS) s = d s
        rw [LinearEquiv.apply_symm_apply]
    obtain ⟨EP₁⟩ := feEquiv P₁
    obtain ⟨EM⟩ := feEquiv M
    have hDF_zero : ∀ D₀ : Derivation k P₂ κ, D₀ F = 0 := by
      intro D₀
      have hInl : ∀ a : Fin 2, algebraMap P₂ κ (MvPolynomial.X (Sum.inl a)) = 0 := hVanInl
      have hInr : ∀ i ∈ S_exp, algebraMap P₂ κ (MvPolynomial.X (Sum.inr i)) = 0 := hVanInr
      have hMul : D₀ (MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1)) = 0 := by
        rw [Derivation.leibniz]
        simp [Algebra.smul_def, hInl 0, hInl 1]
      have hProdLeib : ∀ (s : Finset (Fin m)),
          D₀ (∏ i ∈ s, (MvPolynomial.X (Sum.inr i) : P₂)) =
            ∑ j ∈ s, (∏ i ∈ s.erase j, (MvPolynomial.X (Sum.inr i) : P₂)) •
              D₀ (MvPolynomial.X (Sum.inr j)) := by
        intro s
        induction s using Finset.induction_on with
        | empty => simp
        | @insert a s' ha ih =>
          rw [Finset.prod_insert ha, Derivation.leibniz, ih, Finset.smul_sum, add_comm,
            Finset.sum_insert ha, Finset.erase_insert ha]
          congr 1
          refine Finset.sum_congr rfl fun j hj => ?_
          have hja : j ≠ a := fun h => ha (h ▸ hj)
          have ha_erase : a ∉ s'.erase j := fun h => ha (Finset.mem_of_mem_erase h)
          rw [Finset.erase_insert_of_ne hja.symm, Finset.prod_insert ha_erase, mul_smul]
      have hProd : D₀ (∏ i ∈ S_exp, MvPolynomial.X (Sum.inr i)) = 0 := by
        rw [hProdLeib S_exp]
        refine Finset.sum_eq_zero fun j hj => ?_
        have hErasePos : 0 < (S_exp.erase j).card := by
          rw [Finset.card_erase_of_mem hj]
          omega
        obtain ⟨i₁, hi₁⟩ := Finset.card_pos.mp hErasePos
        have hi₁_mem : i₁ ∈ S_exp := Finset.mem_of_mem_erase hi₁
        have hProdZero : algebraMap P₂ κ (∏ i ∈ S_exp.erase j, MvPolynomial.X (Sum.inr i)) = 0 := by
          rw [map_prod]
          exact Finset.prod_eq_zero hi₁ (hInr i₁ hi₁_mem)
        rw [Algebra.smul_def, hProdZero, zero_mul]
      change D₀ (MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
        ∏ i ∈ S_exp, MvPolynomial.X (Sum.inr i)) = 0
      rw [map_sub, hMul, hProd, sub_zero]
    let Ψ : Derivation k M κ →ₗ[κ] Derivation k P₂ κ :=
      { toFun := fun D => D.compAlgebraMap P₂
        map_add' := fun _ _ => by ext; rfl
        map_smul' := fun _ _ => by ext; rfl }
    have hΨ_bij : Function.Bijective Ψ := by
      refine ⟨?_, ?_⟩
      · intro D₁ D₂ hEq
        ext x
        obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
        exact Derivation.congr_fun hEq p
      · intro D₀
        have hF_quot : Ideal.Quotient.mk I_F F = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
        have hF_alg : algebraMap P₂ κ F = 0 := by
          change ev (ψ_M (Ideal.Quotient.mk I_F F)) = 0
          rw [hF_quot, map_zero, map_zero]
        have hKer : I_F.restrictScalars k ≤ LinearMap.ker D₀.toLinearMap := by
          intro g hg
          rw [Submodule.restrictScalars_mem, Ideal.mem_span_singleton] at hg
          rcases hg with ⟨q, rfl⟩
          change D₀ (F * q) = 0
          rw [Derivation.leibniz, hDF_zero D₀, smul_zero, add_zero, Algebra.smul_def, hF_alg, zero_mul]
        let barL : M →ₗ[k] κ := Submodule.liftQ (I_F.restrictScalars k) D₀.toLinearMap hKer
        have hbarL : ∀ p : P₂, barL (Ideal.Quotient.mk I_F p) = D₀ p := fun p => rfl
        let D : Derivation k M κ :=
          { toLinearMap := barL
            map_one_eq_zero' := by
              change barL (Ideal.Quotient.mk I_F 1) = 0
              rw [hbarL, Derivation.map_one_eq_zero]
            leibniz' := fun x y => by
              obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
              obtain ⟨q, rfl⟩ := Ideal.Quotient.mk_surjective y
              change barL (Ideal.Quotient.mk I_F (p * q)) =
                (Ideal.Quotient.mk I_F p) • barL (Ideal.Quotient.mk I_F q) +
                  (Ideal.Quotient.mk I_F q) • barL (Ideal.Quotient.mk I_F p)
              rw [hbarL, hbarL, hbarL, Derivation.leibniz]
              rfl }
        refine ⟨D, ?_⟩
        exact Derivation.ext fun p => hbarL p
    let Equot : Derivation k M κ ≃ₗ[κ] Derivation k P₂ κ := LinearEquiv.ofBijective Ψ hΨ_bij
    have polyEquiv : ∀ (σ : Type) [Fintype σ],
        ∀ [Algebra (MvPolynomial σ k) κ] [IsScalarTower k (MvPolynomial σ k) κ]
          [SMulCommClass (MvPolynomial σ k) κ κ],
        Nonempty (Derivation k (MvPolynomial σ k) κ ≃ₗ[κ] (σ → κ)) := by
      intro σ _ _ _ _
      let evalMap : Derivation k (MvPolynomial σ k) κ →ₗ[κ] (σ → κ) :=
        { toFun := fun D z => D (MvPolynomial.X z)
          map_add' := fun _ _ => rfl
          map_smul' := fun _ _ => rfl }
      refine ⟨LinearEquiv.ofBijective evalMap ⟨?_, ?_⟩⟩
      · intro D₁ D₂ hEq
        exact MvPolynomial.derivation_ext (fun z => congrFun hEq z)
      · intro f
        refine ⟨MvPolynomial.mkDerivation k f, ?_⟩
        ext z
        exact MvPolynomial.mkDerivation_X k f z
    obtain ⟨Epoly₁⟩ := polyEquiv (Fin (m + 1))
    obtain ⟨Epoly₂⟩ := polyEquiv (Fin 2 ⊕ Fin m)
    let L : (Fin (m + 1) → κ) ≃ₗ[κ] (Fin 2 ⊕ Fin m → κ) :=
      Epoly₁.symm.trans (EP₁.symm.trans (EM.trans (Equot.trans Epoly₂)))
    have hRank := LinearEquiv.finrank_eq L
    rw [Module.finrank_pi κ, Module.finrank_pi κ, Fintype.card_sum, Fintype.card_fin,
      Fintype.card_fin, Fintype.card_fin] at hRank
    omega
  
  obtain ⟨hClosedZ₂, E, ιE, _, _, _, _, hSingEq, hCharts⟩ := hTor₀
  have hOpenC₂ : ∀ x : C₂.left, ∃ V : C₂.left.Opens,
      x ∈ V ∧ AlgebraicGeometry.SmoothOfRelativeDimension (m + 1) (V.ι ≫ C₂.hom) := by
    intro x
    by_contra hNot
    have hxMem : x ∈ {y : C₂.left | ¬ ∃ V : C₂.left.Opens,
        y ∈ V ∧ AlgebraicGeometry.SmoothOfRelativeDimension (m + 1) (V.ι ≫ C₂.hom)} := hNot
    rw [hSingEq] at hxMem
    rcases Set.mem_iUnion.mp hxMem with ⟨α, _⟩
    exact Fin.elim0 α
  have hSmC₂ : AlgebraicGeometry.SmoothOfRelativeDimension (m + 1) C₂.hom :=
    hPart1 (m + 1) C₂.hom hOpenC₂
  refine ⟨hSmC₂, hClosedZ₂, fun x => ?_⟩
  rcases hCharts x with ⟨_, hNc_x⟩ | hSing_x
  · exact hNc_x
  · rcases hSing_x with ⟨R', v₀, e_X, S_exp, S_bdry, q, hEt_e, hEt_q, _,
      hCard, hSub, hComm, hVanInl, hVanInr, _⟩
    have _ : AlgebraicGeometry.SmoothOfRelativeDimension 0 e_X := inferInstance
    have hSmComp0 : AlgebraicGeometry.SmoothOfRelativeDimension (0 + (m + 1)) (e_X ≫ C₂.hom) :=
      inferInstance
    have hSmComp : AlgebraicGeometry.SmoothOfRelativeDimension (m + 1)
        (q ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C))) := by
      rw [zero_add] at hSmComp0
      rwa [hComm]
    obtain ⟨T, hCommT, κ, hFieldκ, ψ_poly, ψ_M, ev, hFE_poly, hFE_M, hAlg, hZero⟩ :=
      hPart2 (m + 1)
        (CommRingCat.of (MvPolynomial (Fin 2 ⊕ Fin m) k ⧸ Ideal.span
          {MvPolynomial.X (Sum.inl 0) * MvPolynomial.X (Sum.inl 1) -
            ∏ i ∈ S_exp, MvPolynomial.X (Sum.inr i)}))
        R'
        (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C))
        v₀ q hEt_q hSmComp
    exact False.elim (@hPart3 S_exp T hCommT κ hFieldκ ψ_poly ψ_M ev hCard hFE_poly hFE_M hAlg
      (fun a => hZero _ (hVanInl a))
      (fun i hi => hZero _ (hVanInr i (hSub hi))))

theorem weil_projective_uniform_vanishing_generators (k : Type u) [Field k]
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (K : Set X.left)
    (hProjX : IsProjectiveOverField k X)
    (hClosedK : IsClosed K)
    (hNonUniv : Kᶜ.Nonempty) :
    ∃ (M L : ℕ) (W : Fin (M + 1) → X.left.affineOpens)
      (h : ∀ ν : Fin (M + 1), Fin (L + 1) → ↑(X.left.presheaf.obj (Opposite.op (W ν).1))),
      (⨆ ν : Fin (M + 1), (W ν).1) = ⊤ ∧
      (∀ ν : Fin (M + 1),
        Ideal.span (Set.range (h ν)) =
          (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal ⟨K, hClosedK⟩).ideal (W ν)) ∧
      (∀ ν μ : Fin (M + 1),
        ∃ u : ↑(X.left.presheaf.obj (Opposite.op ((W ν).1 ⊓ (W μ).1))),
          IsUnit u ∧
          ∀ β : Fin (L + 1),
            (X.left.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (h ν β) =
              u * (X.left.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom (h μ β)) :=
by
  obtain ⟨M, ι, hCl⟩ := hProjX
  have _ := hNonUniv
  let S := MvPolynomial (Fin (M + 1)) k
  let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k
  let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
  let P_proj : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Proj 𝒜
  let ι_X : X.left ⟶ P_proj := ι.left
  have _ : AlgebraicGeometry.IsClosedImmersion ι_X := hCl
  have hX : ∀ ν : Fin (M + 1), (MvPolynomial.X ν : S) ∈ 𝒜 1 :=
    fun ν => MvPolynomial.isHomogeneous_X k ν
  let P_ν : Fin (M + 1) → P_proj.Opens :=
    fun ν => AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X ν)
  have hP_aff : ∀ ν : Fin (M + 1), AlgebraicGeometry.IsAffineOpen (P_ν ν) :=
    fun ν => AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜 (MvPolynomial.X ν) (hX ν) zero_lt_one
  let W : Fin (M + 1) → X.left.affineOpens :=
    fun ν => ⟨(TopologicalSpace.Opens.map ι_X.base).obj (P_ν ν), (hP_aff ν).preimage ι_X⟩
  
  have h_adjoin : Algebra.adjoin (↥(𝒜 0)) (Set.range (MvPolynomial.X : Fin (M + 1) → S)) = ⊤ := by
    have h_mem : ∀ p : S, p ∈ Algebra.adjoin (↥(𝒜 0)) (Set.range (MvPolynomial.X : Fin (M + 1) → S)) := by
      intro p
      induction p using MvPolynomial.induction_on with
      | C a =>
        let c₀ : ↥(𝒜 0) := ⟨MvPolynomial.C a, MvPolynomial.isHomogeneous_C (Fin (M + 1)) a⟩
        exact (Algebra.adjoin (↥(𝒜 0)) (Set.range (MvPolynomial.X : Fin (M + 1) → S))).algebraMap_mem c₀
      | add p q hp hq => exact add_mem hp hq
      | mul_X p ν hp => exact mul_mem hp (Algebra.subset_adjoin ⟨ν, rfl⟩)
    rw [eq_top_iff]
    intro p _
    exact h_mem p
  have hCov_P : (⨆ ν : Fin (M + 1), P_ν ν) = ⊤ :=
    AlgebraicGeometry.Proj.iSup_basicOpen_eq_top' 𝒜 (MvPolynomial.X : Fin (M + 1) → S)
      (fun ν => ⟨1, hX ν⟩) h_adjoin
  have hCov : (⨆ ν : Fin (M + 1), (W ν).1) = ⊤ := by
    apply le_antisymm le_top
    intro x _
    have hxP : ι_X.base x ∈ (⨆ ν : Fin (M + 1), P_ν ν) := by
      rw [hCov_P]
      trivial
    rw [TopologicalSpace.Opens.mem_iSup] at hxP ⊢
    exact hxP
  
  let K_ℙ : Set (ProjectiveSpectrum 𝒜) := ι_X.base '' K
  let I_hom : HomogeneousIdeal 𝒜 := ProjectiveSpectrum.vanishingIdeal K_ℙ
  obtain ⟨s₀, hs₀⟩ : I_hom.toIdeal.FG := IsNoetherian.noetherian I_hom.toIdeal
  let D : ℕ := s₀.sup MvPolynomial.totalDegree + 1
  have hCompMem : ∀ {f : S}, f ∈ I_hom.toIdeal → ∀ d : ℕ,
      MvPolynomial.homogeneousComponent d f ∈ I_hom.toIdeal := by
    classical
    intro f hf d
    have h_decomp := DirectSum.sum_support_decompose 𝒜 f
    have h_apply := congrArg (MvPolynomial.homogeneousComponent d) h_decomp
    rw [map_sum] at h_apply
    have h_sum_eq :
        (∑ i ∈ (DirectSum.decompose 𝒜 f).support,
          MvPolynomial.homogeneousComponent d (DirectSum.decompose 𝒜 f i : S)) =
        (DirectSum.decompose 𝒜 f d : S) := by
      have h_ite : ∀ i ∈ (DirectSum.decompose 𝒜 f).support,
          MvPolynomial.homogeneousComponent d (DirectSum.decompose 𝒜 f i : S) =
            if d = i then (DirectSum.decompose 𝒜 f i : S) else 0 := by
        intro i _
        exact MvPolynomial.homogeneousComponent_of_mem (DirectSum.decompose 𝒜 f i).2
      rw [Finset.sum_congr rfl h_ite]
      by_cases hd : d ∈ (DirectSum.decompose 𝒜 f).support
      · rw [Finset.sum_eq_single d]
        · simp
        · intro b _ hbd
          have hne : d ≠ b := Ne.symm hbd
          simp [hne]
        · intro hd'
          exact absurd hd hd'
      · rw [Finset.sum_eq_zero]
        · have hzero : DirectSum.decompose 𝒜 f d = 0 :=
            DFinsupp.notMem_support_iff.mp hd
          simp [hzero]
        · intro b hb
          have hdb : d ≠ b := fun h => hd (h ▸ hb)
          simp [hdb]
    rw [← h_apply, h_sum_eq]
    exact I_hom.isHomogeneous d hf
  have hCompMul : ∀ (q H : S) (d m : ℕ), H ∈ 𝒜 d →
      MvPolynomial.homogeneousComponent m (q * H) =
        if d ≤ m then MvPolynomial.homogeneousComponent (m - d) q * H else 0 := by
    intro q H d m hH
    conv_lhs => rw [← MvPolynomial.sum_homogeneousComponent q]
    rw [Finset.sum_mul, map_sum]
    have h_summand : ∀ j ∈ Finset.range (q.totalDegree + 1),
        MvPolynomial.homogeneousComponent m (MvPolynomial.homogeneousComponent j q * H) =
          if m = j + d then MvPolynomial.homogeneousComponent j q * H else 0 := by
      intro j _
      have h_mem_jd : MvPolynomial.homogeneousComponent j q * H ∈ 𝒜 (j + d) :=
        SetLike.GradedMonoid.toGradedMul.mul_mem (MvPolynomial.homogeneousComponent_mem j q) hH
      exact MvPolynomial.homogeneousComponent_of_mem h_mem_jd
    rw [Finset.sum_congr rfl h_summand]
    split_ifs with hdm
    · by_cases hlt : m - d < q.totalDegree + 1
      · rw [Finset.sum_eq_single (m - d)]
        · split_ifs with heq
          · rfl
          · omega
        · intro j _ hj
          have hne : m ≠ j + d := by omega
          simp [hne]
        · intro hmem
          exact absurd (Finset.mem_range.mpr hlt) hmem
      · rw [Finset.sum_eq_zero]
        · rw [MvPolynomial.homogeneousComponent_eq_zero (m - d) q (by omega), zero_mul]
        · intro j hj
          rw [Finset.mem_range] at hj
          have hne : m ≠ j + d := by omega
          simp [hne]
    · apply Finset.sum_eq_zero
      intro j _
      have hne : m ≠ j + d := by omega
      simp [hne]
  let ι₀ := Fin s₀.card × Fin (D + 1) × Fin (M + 1)
  let L : ℕ := Fintype.card ι₀
  let e₀ : ι₀ ≃ Fin L := Fintype.equivFin ι₀
  let F : Fin (L + 1) → S :=
    Fin.lastCases (0 : S) (fun i =>
      let p := e₀.symm i
      (MvPolynomial.X p.2.2 : S) ^ (D - p.2.1.1) *
        MvPolynomial.homogeneousComponent p.2.1.1 (s₀.equivFin.symm p.1).1)
  have hF_deg : ∀ β : Fin (L + 1), F β ∈ 𝒜 (D • 1) := by
    intro β
    have hD1 : D • (1 : ℕ) = D := by simp
    rw [hD1]
    refine Fin.lastCases ?_ ?_ β
    · simp [F]
    · intro i
      simp only [F, Fin.lastCases_castSucc]
      set p := e₀.symm i
      have hd_le : p.2.1.1 ≤ D := Nat.le_of_lt_succ p.2.1.2
      have h1 : ((MvPolynomial.X p.2.2 : S) ^ (D - p.2.1.1)).IsHomogeneous (D - p.2.1.1) := by
        simpa using (MvPolynomial.isHomogeneous_X k p.2.2).pow (D - p.2.1.1)
