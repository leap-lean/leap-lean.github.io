    rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hΦ_def]
    simp only [CategoryTheory.Category.assoc]
  change ev_Sky (((CategoryTheory.Abelian.Ext.mk₀ Θ_hat).postcomp Fℤ_Sk (Nat.add_zero 0))
    (((CategoryTheory.Abelian.Ext.mk₀ (pb_σ.map γ)).postcomp Fℤ_Sk (Nat.add_zero 0)) u₀)) =
    p_ισ c_Y
  rw [h_ext_eq, hev_Sky]
  have haddEquiv_mk₀ : CategoryTheory.Abelian.Ext.addEquiv₀
      (CategoryTheory.Abelian.Ext.mk₀ (C_k.map z_to_m ≫ Φ)) = C_k.map z_to_m ≫ Φ := by
    apply CategoryTheory.Abelian.Ext.addEquiv₀.symm.injective
    rw [AddEquiv.symm_apply_apply, CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply]
  rw [haddEquiv_mk₀]

  let adj₀ := CategoryTheory.constantSheafAdj S.smallEtaleTopology AddCommGrpCat.{u} hT₀
  let τ_σ : B_σ.obj T₀ ⟶ T_k := hT_k.from (B_σ.obj T₀)
  have hπΦ : πM_σ ≫ Φ = pb_σ.map γ ≫ Θ_hat := by
    rw [hΦ_def, ← CategoryTheory.Category.assoc πM_σ inv_πM_σ,
      @CategoryTheory.IsIso.hom_inv_id _ _ _ _ πM_σ _hIsoConst_σ,
      CategoryTheory.Category.id_comp]
  have hmate1 : adj_σ.homEquiv _ S_Sky (πM_σ ≫ Φ) =
      adj_σ.homEquiv _ S_Sky (pb_σ.map γ ≫ Θ_hat) := congrArg _ hπΦ
  rw [CategoryTheory.Adjunction.homEquiv_naturality_right,
    CategoryTheory.Adjunction.homEquiv_naturality_left] at hmate1
  have hπM_eq : adj_σ.homEquiv (weilEtaleTorsionSheaf S m) (C_k.obj (AM m)) πM_σ =
      (adj₀.homEquiv (AM m) (pf_σ.obj (C_k.obj (AM m)))).symm
        (adj_k.unit.app (AM m) ≫ (C_k.obj (AM m)).obj.map τ_σ.op) :=
    Equiv.apply_symm_apply _ _
  rw [hΘ_hat_eq, hπM_eq] at hmate1
  have hmate2 := congrArg (adj₀.homEquiv (AM m) (pf_σ.obj S_Sky)) hmate1
  rw [CategoryTheory.Adjunction.homEquiv_naturality_right, Equiv.apply_symm_apply,
    CategoryTheory.Adjunction.homEquiv_naturality_right] at hmate2
  have hα₀_τ : α₀ ≫ τ_σ = 𝟙 T_k := hT_k.hom_ext _ _
  have hev_mate := congrFun
    (congrArg (fun g : AM m ⟶ (pf_σ.obj S_Sky).obj.obj (Opposite.op T₀) =>
      g.hom (ULift.up (1 : ZMod m))) hmate2) α₀
  have h_to_mate :
      ((adj_k.homEquiv Aℤ S_Sky (C_k.map z_to_m ≫ Φ)).hom (ULift.up (1 : ℤ))) (𝟙 T_k) =
      (((adj₀.homEquiv (AM m) R2 γ) ≫
        ((CategoryTheory.sheafSections S.smallEtaleTopology AddCommGrpCat.{u}).obj
          (Opposite.op T₀)).map Θ_tilde).hom (ULift.up (1 : ZMod m))) α₀ := by
    have hz_nat : adj_k.homEquiv Aℤ S_Sky (C_k.map z_to_m ≫ Φ) =
        z_to_m ≫ adj_k.unit.app (AM m) ≫ Φ.hom.app (Opposite.op T_k) := by
      rw [CategoryTheory.Adjunction.homEquiv_naturality_left]; rfl
    have hz1 : z_to_m.hom (ULift.up (1 : ℤ)) = ULift.up (1 : ZMod m) :=
      congrArg ULift.up Int.cast_one
    have hstep1 :
        ((adj_k.homEquiv Aℤ S_Sky (C_k.map z_to_m ≫ Φ)).hom (ULift.up (1 : ℤ))) (𝟙 T_k) =
        ((adj_k.unit.app (AM m) ≫ Φ.hom.app (Opposite.op T_k)).hom
          (ULift.up (1 : ZMod m))) (α₀ ≫ τ_σ) :=
      (congrFun (congrArg (fun g : Aℤ ⟶ S_Sky.obj.obj (Opposite.op T_k) =>
        g.hom (ULift.up (1 : ℤ))) hz_nat) (𝟙 T_k)).trans
        ((congrFun (congrArg (fun u =>
          ((adj_k.unit.app (AM m) ≫ Φ.hom.app (Opposite.op T_k)).hom u)) hz1) (𝟙 T_k)).trans
          (congrArg (((adj_k.unit.app (AM m) ≫ Φ.hom.app (Opposite.op T_k)).hom
            (ULift.up (1 : ZMod m)))) hα₀_τ.symm))
    have hstep2 :
        ((adj_k.unit.app (AM m) ≫ Φ.hom.app (Opposite.op T_k)).hom
          (ULift.up (1 : ZMod m))) (α₀ ≫ τ_σ) =
        ((adj_k.unit.app (AM m) ≫
          ((C_k.obj (AM m)).obj.map τ_σ.op ≫ Φ.hom.app (Opposite.op (B_σ.obj T₀)))).hom
          (ULift.up (1 : ZMod m))) α₀ :=
      congrFun (congrArg (fun h => ((adj_k.unit.app (AM m) ≫ h).hom
        (ULift.up (1 : ZMod m)))) (Φ.hom.naturality τ_σ.op).symm) α₀
    exact hstep1.trans (hstep2.trans hev_mate)
  refine h_to_mate.trans ?_
  change ((Θ_tilde.hom.app (Opposite.op T₀)).hom
      ((adj₀.homEquiv (AM m) R2 γ).hom (ULift.up 1))) α₀ = p_ισ c_Y
  have hΘ_sh : (((CategoryTheory.sheafificationAdjunction S.smallEtaleTopology
        AddCommGrpCat.{u}).unit.app P_rel).app (Opposite.op T₀)) ≫
      Θ_tilde.hom.app (Opposite.op T₀) = θ_σ.app (Opposite.op T₀) := by
    have h := ((CategoryTheory.sheafificationAdjunction S.smallEtaleTopology
      AddCommGrpCat.{u}).homEquiv_unit P_rel (pf_σ.obj S_Sky) Θ_tilde).symm
    exact NatTrans.congr_app (h.trans hΘ_tilde_eq) (Opposite.op T₀)
  let c_Y_pre : ↑(P_rel.obj (Opposite.op T₀)) :=
    weilPolyP1CohomologyTermToPresheaf Y W₀ hT₀_top (weilEtaleTorsionSheaf Y m) 2 c_Y
  let η_sh₀_hom : ↑(P_rel.obj (Opposite.op T₀)) →+ ↑(R2.obj.obj (Opposite.op T₀)) :=
    (((CategoryTheory.sheafificationAdjunction S.smallEtaleTopology
      AddCommGrpCat.{u}).unit.app P_rel).app (Opposite.op T₀)).hom
  have hPin₀ : (adj₀.homEquiv (AM m) R2 γ).hom (ULift.up 1) = η_sh₀_hom c_Y_pre :=
