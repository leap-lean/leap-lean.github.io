  have : CategoryTheory.Limits.PreservesLimitsOfShape CategoryTheory.Limits.WalkingCospan G := by
    refine ⟨fun {K} => ?_⟩
    have := hPresCospan (K.map CategoryTheory.Limits.WalkingCospan.Hom.inl)
