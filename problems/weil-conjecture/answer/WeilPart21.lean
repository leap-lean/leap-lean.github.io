      congrArg (fun m => m ι₁)
        ((adj_Y.unit.app R₁).hom.naturality (Opposite.op (B_f.map v)))
    have h_rhs_eq : ((pb_Y.obj R₁).obj.map (Opposite.op (e_fun.inv.app V₂)))
          (((adj_Y.unit.app R₁).hom.app (Opposite.op (B_f.obj V₂)))
            ((R₁.obj.map (Opposite.op (B_f.map v))) ι₁)) =
        ((pb_Y.obj R₁).obj.map (Opposite.op (e_fun.inv.app V₂)))
          (((pb_Y.obj R₁).obj.map (Opposite.op (B_Y.map (B_f.map v)))) s₁) :=
      congrArg ((pb_Y.obj R₁).obj.map (Opposite.op (e_fun.inv.app V₂))) h_unit
    refine Eq.trans ?_ h_rhs_eq.symm
    have h_efun : B_f.map (B_S.map v) ≫ e_fun.inv.app V₁ =
        e_fun.inv.app V₂ ≫ B_Y.map (B_f.map v) :=
      e_fun.inv.naturality v
    have h_map_eq : (pb_Y.obj R₁).obj.map (B_f.map (B_S.map v) ≫ e_fun.inv.app V₁).op =
        (pb_Y.obj R₁).obj.map (e_fun.inv.app V₂ ≫ B_Y.map (B_f.map v)).op :=
      congrArg (fun k => (pb_Y.obj R₁).obj.map k.op) h_efun
    rw [CategoryTheory.op_comp, CategoryTheory.op_comp,
      (pb_Y.obj R₁).obj.map_comp, (pb_Y.obj R₁).obj.map_comp] at h_map_eq
