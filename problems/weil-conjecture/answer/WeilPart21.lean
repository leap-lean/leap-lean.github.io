import WeilPart20
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem weil_alt_cd_split_adjoinRoot_shapiro_base_change_exact (F L : Type u) [Field F] [Field L] (ι_EL : F →+* L)
    (d : ℕ) (hd : 1 ≤ d)
    (g' : Polynomial F) (hg'_monic : g'.Monic) (hg'_deg : g'.natDegree = d)
    (hIrr' : Fact (Irreducible g')) (hg'_sep : g'.Separable)
    (hIrr : Fact (Irreducible (g'.map ι_EL)))
    (φ_K : AdjoinRoot g' →+* AdjoinRoot (g'.map ι_EL))
    (hφ_comp : φ_K.comp (algebraMap F (AdjoinRoot g')) =
      (algebraMap L (AdjoinRoot (g'.map ι_EL))).comp ι_EL)
    (hφ_root : φ_K (AdjoinRoot.root g') = AdjoinRoot.root (g'.map ι_EL))
    (r' : Fin d → AdjoinRoot g')
    (hr'_dist : _root_.Pairwise (fun i j : Fin d => r' i ≠ r' j))
    (hr'_split : g'.map (algebraMap F (AdjoinRoot g')) =
      ∏ i : Fin d, (Polynomial.X - Polynomial.C (r' i)))
    (ℱ' : CategoryTheory.Sheaf
      (AlgebraicGeometry.Spec (CommRingCat.of F)).smallEtaleTopology AddCommGrpCat.{u}) :
    ∃ (ℳ' 𝒞' : CategoryTheory.Sheaf
        (AlgebraicGeometry.Spec (CommRingCat.of F)).smallEtaleTopology AddCommGrpCat.{u})
      (ι_ℱ : ℱ' ⟶ ℳ') (π_ℱ : ℳ' ⟶ 𝒞')
      (h0 : CategoryTheory.CategoryStruct.comp ι_ℱ π_ℱ = 0),
      (CategoryTheory.ShortComplex.mk ι_ℱ π_ℱ h0).ShortExact ∧
      let h'_L := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_EL)
      let u_L := AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap L (AdjoinRoot (g'.map ι_EL))))
      ∀ [_hCont_L : (weilAltCdSitePullback h'_L).IsContinuous
          (AlgebraicGeometry.Spec (CommRingCat.of F)).smallEtaleTopology
          (AlgebraicGeometry.Spec (CommRingCat.of L)).smallEtaleTopology]
        [_hAdj_L : ((weilAltCdSitePullback h'_L).sheafPushforwardContinuous AddCommGrpCat.{u}
          (AlgebraicGeometry.Spec (CommRingCat.of F)).smallEtaleTopology
          (AlgebraicGeometry.Spec (CommRingCat.of L)).smallEtaleTopology).IsRightAdjoint]
        [_hCont_u : (weilAltCdSitePullback u_L).IsContinuous
          (AlgebraicGeometry.Spec (CommRingCat.of L)).smallEtaleTopology
          (AlgebraicGeometry.Spec
            (CommRingCat.of (AdjoinRoot (g'.map ι_EL)))).smallEtaleTopology]
        [_hAdj_u : ((weilAltCdSitePullback u_L).sheafPushforwardContinuous AddCommGrpCat.{u}
          (AlgebraicGeometry.Spec (CommRingCat.of L)).smallEtaleTopology
          (AlgebraicGeometry.Spec
            (CommRingCat.of (AdjoinRoot (g'.map ι_EL)))).smallEtaleTopology).IsRightAdjoint]
        (r : ℕ)
        (ζ' : (((weilAltCdSitePullback h'_L).sheafPullback AddCommGrpCat.{u}
          (AlgebraicGeometry.Spec (CommRingCat.of F)).smallEtaleTopology
          (AlgebraicGeometry.Spec (CommRingCat.of L)).smallEtaleTopology).obj ℱ').H r)
        (p_u : (((weilAltCdSitePullback h'_L).sheafPullback AddCommGrpCat.{u}
            (AlgebraicGeometry.Spec (CommRingCat.of F)).smallEtaleTopology
            (AlgebraicGeometry.Spec (CommRingCat.of L)).smallEtaleTopology).obj ℱ').H r →+
          (((weilAltCdSitePullback u_L).sheafPullback AddCommGrpCat.{u}
            (AlgebraicGeometry.Spec (CommRingCat.of L)).smallEtaleTopology
            (AlgebraicGeometry.Spec
              (CommRingCat.of (AdjoinRoot (g'.map ι_EL)))).smallEtaleTopology).obj
            (((weilAltCdSitePullback h'_L).sheafPullback AddCommGrpCat.{u}
              (AlgebraicGeometry.Spec (CommRingCat.of F)).smallEtaleTopology
              (AlgebraicGeometry.Spec (CommRingCat.of L)).smallEtaleTopology).obj ℱ')).H r),
        WeilHasGeneralEtalePullH u_L _ r p_u →
        p_u ζ' = 0 →
        ((CategoryTheory.Abelian.Ext.mk₀
          (((weilAltCdSitePullback h'_L).sheafPullback AddCommGrpCat.{u}
            (AlgebraicGeometry.Spec (CommRingCat.of F)).smallEtaleTopology
            (AlgebraicGeometry.Spec (CommRingCat.of L)).smallEtaleTopology).map ι_ℱ)).postcomp
          ((CategoryTheory.constantSheaf
            (AlgebraicGeometry.Spec (CommRingCat.of L)).smallEtaleTopology
            AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ)))
          (Nat.add_zero r)) ζ' = 0 :=
by
  letI : Fact (Irreducible g') := hIrr'
  letI : Fact (Irreducible (g'.map ι_EL)) := hIrr
  letI : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
    ⟨fun _ _ hf hg => by haveI := hf; haveI := hg; infer_instance⟩
  let Aℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
  let zHom : ∀ (M : AddCommGrpCat.{u}), ↑M → (Aℤ ⟶ M) := fun M m =>
    AddCommGrpCat.ofHom
      { toFun := fun z => z.down • m
        map_zero' := zero_zsmul m
        map_add' := fun a b => add_zsmul m a.down b.down }
  have hzHom_eval : ∀ (M : AddCommGrpCat.{u}) (m : ↑M), zHom M m (ULift.up 1) = m :=
    fun _ m => one_zsmul m
  have hzHom_comp : ∀ {M N : AddCommGrpCat.{u}} (f : M ⟶ N) (m : ↑M),
      CategoryTheory.CategoryStruct.comp (zHom M m) f = zHom N (f m) := by
    intro M N f m
    ext z
    exact map_zsmul f.hom z.down m
  have hSheafExt : ∀ {C : Type (u + 1)} [CategoryTheory.Category.{u} C]
      {J : CategoryTheory.GrothendieckTopology C}
      {ℱ₁ ℱ₂ : CategoryTheory.Sheaf J AddCommGrpCat.{u}}
      (α β : ℱ₁ ⟶ ℱ₂),
      (∀ W : C, α.hom.app (Opposite.op W) = β.hom.app (Opposite.op W)) → α = β := by
    intro C _ J ℱ₁ ℱ₂ α β h
    exact congrArg (fun k : ℱ₁.obj ⟶ ℱ₂.obj => ({ hom := k } : ℱ₁ ⟶ ℱ₂))
      (CategoryTheory.NatTrans.ext (funext fun ⟨W⟩ => h W))
  have hComp2 : ∀ {X₀ X₁ X₂ Y : AlgebraicGeometry.Scheme.{u}}
      (f₁ : X₀ ⟶ X₁) (f₂ : X₁ ⟶ X₂)
      (p₂ : X₂ ⟶ Y) (p₁ : X₁ ⟶ Y) (p₀ : X₀ ⟶ Y),
      CategoryTheory.CategoryStruct.comp f₂ p₂ = p₁ →
      CategoryTheory.CategoryStruct.comp f₁ p₁ = p₀ →
      CategoryTheory.CategoryStruct.comp (CategoryTheory.CategoryStruct.comp f₁ f₂) p₂ = p₀ := by
    intro X₀ X₁ X₂ Y f₁ f₂ p₂ p₁ p₀ h₂ h₁
    rw [CategoryTheory.Category.assoc, h₂, h₁]
  have hComp3 : ∀ {X₀ X₁ X₂ X₃ Y : AlgebraicGeometry.Scheme.{u}}
      (f₁ : X₀ ⟶ X₁) (f₂ : X₁ ⟶ X₂) (f₃ : X₂ ⟶ X₃)
      (p₃ : X₃ ⟶ Y) (p₂ : X₂ ⟶ Y) (p₁ : X₁ ⟶ Y) (p₀ : X₀ ⟶ Y),
      CategoryTheory.CategoryStruct.comp f₃ p₃ = p₂ →
      CategoryTheory.CategoryStruct.comp f₂ p₂ = p₁ →
      CategoryTheory.CategoryStruct.comp f₁ p₁ = p₀ →
      CategoryTheory.CategoryStruct.comp
        (CategoryTheory.CategoryStruct.comp f₁ (CategoryTheory.CategoryStruct.comp f₂ f₃)) p₃ = p₀ := by
    intro X₀ X₁ X₂ X₃ Y f₁ f₂ f₃ p₃ p₂ p₁ p₀ h₃ h₂ h₁
    exact hComp2 f₁ (CategoryTheory.CategoryStruct.comp f₂ f₃) p₃ p₁ p₀
      (hComp2 f₂ f₃ p₃ p₂ p₁ h₃ h₂) h₁
  have hComp4 : ∀ {X₀ X₁ X₂ X₃ X₄ Y : AlgebraicGeometry.Scheme.{u}}
      (f₁ : X₀ ⟶ X₁) (f₂ : X₁ ⟶ X₂) (f₃ : X₂ ⟶ X₃) (f₄ : X₃ ⟶ X₄)
      (p₄ : X₄ ⟶ Y) (p₃ : X₃ ⟶ Y) (p₂ : X₂ ⟶ Y) (p₁ : X₁ ⟶ Y) (p₀ : X₀ ⟶ Y),
      CategoryTheory.CategoryStruct.comp f₄ p₄ = p₃ →
      CategoryTheory.CategoryStruct.comp f₃ p₃ = p₂ →
      CategoryTheory.CategoryStruct.comp f₂ p₂ = p₁ →
      CategoryTheory.CategoryStruct.comp f₁ p₁ = p₀ →
      CategoryTheory.CategoryStruct.comp
        (CategoryTheory.CategoryStruct.comp f₁
          (CategoryTheory.CategoryStruct.comp f₂
            (CategoryTheory.CategoryStruct.comp f₃ f₄))) p₄ = p₀ := by
    intro X₀ X₁ X₂ X₃ X₄ Y f₁ f₂ f₃ f₄ p₄ p₃ p₂ p₁ p₀ h₄ h₃ h₂ h₁
    exact hComp2 f₁ _ p₄ p₁ p₀ (hComp3 f₂ f₃ f₄ p₄ p₃ p₂ p₁ h₄ h₃ h₂) h₁
  have hOfNatIsoRight_homEquiv :
      ∀ {C₁ C₂ : Type (u + 1)} [CategoryTheory.Category.{u + 1} C₁]
        [CategoryTheory.Category.{u + 1} C₂]
        {F : C₁ ⥤ C₂} {G G' : C₂ ⥤ C₁} (adj : F ⊣ G) (e : G ≅ G')
        (X : C₁) (Y : C₂) (g : F.obj X ⟶ Y),
        ((adj.ofNatIsoRight e).homEquiv X Y) g =
          CategoryTheory.CategoryStruct.comp ((adj.homEquiv X Y) g) (e.hom.app Y) := by
    intro C₁ C₂ _ _ F G G' adj e X Y g
    rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Adjunction.homEquiv_unit]
    change CategoryTheory.CategoryStruct.comp
        (CategoryTheory.CategoryStruct.comp (adj.unit.app X) (e.hom.app (F.obj X)))
        (G'.map g) =
      CategoryTheory.CategoryStruct.comp
        (CategoryTheory.CategoryStruct.comp (adj.unit.app X) (G.map g))
        (e.hom.app Y)
    rw [CategoryTheory.Category.assoc, ← e.hom.naturality g,
      ← CategoryTheory.Category.assoc]

  
  have hSmallTopMem : ∀ {S : AlgebraicGeometry.Scheme.{u}} (X : S.Etale)
      (R : CategoryTheory.Sieve X),
      R ∈ S.smallEtaleTopology X ↔
        ∀ x : ↥X.left, ∃ (Y : S.Etale) (f : Y ⟶ X) (y : ↥Y.left),
          R.arrows f ∧ AlgebraicGeometry.Etale f.left ∧ f.left.base y = x := by
    intro S X R
    change R ∈ S.smallGrothendieckTopology (@AlgebraicGeometry.Etale) X ↔ _
    rw [AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      S (le_refl (@AlgebraicGeometry.Etale))]
    exact AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology X R

  let etMap : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} {v : S₁ ⟶ S₂},
      AlgebraicGeometry.Etale v → CategoryTheory.Functor S₁.Etale S₂.Etale :=
    fun hv => CategoryTheory.MorphismProperty.Over.map (P := @AlgebraicGeometry.Etale) ⊤ hv

  
  have hMapCont : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (v : S₁ ⟶ S₂)
      (hv : AlgebraicGeometry.Etale v),
      (etMap hv).IsContinuous S₁.smallEtaleTopology S₂.smallEtaleTopology := by
    intro S₁ S₂ v hv
    let M_v : CategoryTheory.Functor S₁.Etale S₂.Etale := etMap hv
    refine CategoryTheory.Functor.isContinuous_of_coverPreserving ?_ ?_
    · refine CategoryTheory.CompatiblePreserving.mk ?_
      intro ℱ Z T x hx Y₁ Y₂ X f₁ f₂ g₁ g₂ hg₁ hg₂ hcomm
      have hcomm_left : CategoryTheory.CategoryStruct.comp f₁.left g₁.left =
          CategoryTheory.CategoryStruct.comp f₂.left g₂.left :=
        congrArg (fun m => m.left) hcomm
      have hX_eq : CategoryTheory.CategoryStruct.comp
          (CategoryTheory.CategoryStruct.comp f₁.left Y₁.hom) v = X.hom :=
        (CategoryTheory.Category.assoc f₁.left Y₁.hom v).trans
          (CategoryTheory.MorphismProperty.Over.w f₁)
      have hEt_X' : AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.comp f₁.left Y₁.hom) :=
        @CategoryTheory.MorphismProperty.of_postcomp _ _ (@AlgebraicGeometry.Etale)
          (@AlgebraicGeometry.Etale) _ _ _ _
          (CategoryTheory.CategoryStruct.comp f₁.left Y₁.hom) v hv
          (by rw [hX_eq]; exact X.prop)
      let X' : S₁.Etale :=
        CategoryTheory.MorphismProperty.Over.mk ⊤
          (CategoryTheory.CategoryStruct.comp f₁.left Y₁.hom) hEt_X'
      let f₁' : X' ⟶ Y₁ := CategoryTheory.MorphismProperty.Over.homMk f₁.left rfl
      let f₂' : X' ⟶ Y₂ := CategoryTheory.MorphismProperty.Over.homMk f₂.left
        ((congrArg (CategoryTheory.CategoryStruct.comp f₂.left)
          (CategoryTheory.MorphismProperty.Over.w g₂).symm).trans
          ((CategoryTheory.Category.assoc f₂.left g₂.left Z.hom).symm.trans
            ((congrArg (fun k => CategoryTheory.CategoryStruct.comp k Z.hom)
              hcomm_left.symm).trans
              ((CategoryTheory.Category.assoc f₁.left g₁.left Z.hom).trans
                (congrArg (CategoryTheory.CategoryStruct.comp f₁.left)
                  (CategoryTheory.MorphismProperty.Over.w g₁))))))
      have hcomm' : CategoryTheory.CategoryStruct.comp f₁' g₁ =
          CategoryTheory.CategoryStruct.comp f₂' g₂ :=
        CategoryTheory.MorphismProperty.Over.Hom.ext hcomm_left
      have hx' := hx f₁' f₂' hg₁ hg₂ hcomm'
      let eX : X ⟶ M_v.obj X' :=
        CategoryTheory.MorphismProperty.Over.homMk (CategoryTheory.CategoryStruct.id X.left) (by
          change CategoryTheory.CategoryStruct.comp (CategoryTheory.CategoryStruct.id X.left)
            (CategoryTheory.CategoryStruct.comp (CategoryTheory.CategoryStruct.comp f₁.left Y₁.hom) v) =
            X.hom
          rw [CategoryTheory.Category.id_comp, hX_eq])
      have he₁ : CategoryTheory.CategoryStruct.comp eX (M_v.map f₁') = f₁ :=
        CategoryTheory.MorphismProperty.Over.Hom.ext (CategoryTheory.Category.id_comp f₁.left)
      have he₂ : CategoryTheory.CategoryStruct.comp eX (M_v.map f₂') = f₂ :=
        CategoryTheory.MorphismProperty.Over.Hom.ext (CategoryTheory.Category.id_comp f₂.left)
      have hmap := congrArg (ℱ.obj.map eX.op) hx'
      have h₁ : ℱ.obj.map eX.op (ℱ.obj.map (M_v.map f₁').op (x g₁ hg₁)) =
          ℱ.obj.map f₁.op (x g₁ hg₁) := by
        change (CategoryTheory.CategoryStruct.comp
          (ℱ.obj.map (M_v.map f₁').op) (ℱ.obj.map eX.op)) (x g₁ hg₁) = _
        rw [← ℱ.obj.map_comp, ← op_comp, he₁]
      have h₂ : ℱ.obj.map eX.op (ℱ.obj.map (M_v.map f₂').op (x g₂ hg₂)) =
          ℱ.obj.map f₂.op (x g₂ hg₂) := by
        change (CategoryTheory.CategoryStruct.comp
          (ℱ.obj.map (M_v.map f₂').op) (ℱ.obj.map eX.op)) (x g₂ hg₂) = _
        rw [← ℱ.obj.map_comp, ← op_comp, he₂]
      exact h₁.symm.trans (hmap.trans h₂)
    · refine CategoryTheory.CoverPreserving.mk ?_
      intro U S hS
      rw [hSmallTopMem] at hS ⊢
      intro x
      obtain ⟨Y, f, y, hfS, hfEt, hy⟩ := hS x
      refine ⟨M_v.obj Y, M_v.map f, y, ?_, hfEt, hy⟩
      exact ⟨Y, f, CategoryTheory.CategoryStruct.id (M_v.obj Y), hfS,
        (CategoryTheory.Category.id_comp _).symm⟩

  
  have hEtalePkg : ∀ (E : Type u) [Field E] (g : Polynomial E),
      g.Monic → [Fact (Irreducible g)] → g.Separable →
      let u := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E (AdjoinRoot g)))
      FiniteDimensional E (AdjoinRoot g) ∧
      AlgebraicGeometry.Etale u ∧
      AlgebraicGeometry.Surjective u := by
    intro E _ g hg_monic _ hg_sep u
    have h_ne0 : g ≠ 0 := hg_monic.ne_zero
    haveI : FiniteDimensional E (AdjoinRoot g) := (AdjoinRoot.powerBasis h_ne0).finite
    have hmin : minpoly E (AdjoinRoot.root g) = g := by
      rw [AdjoinRoot.minpoly_root h_ne0, hg_monic.leadingCoeff, inv_one, map_one, mul_one]
    have hRootSep : IsSeparable E (AdjoinRoot.root g) := by
      rw [IsSeparable, hmin]
      exact hg_sep
    have hPrim : IntermediateField.adjoin E ({AdjoinRoot.root g} : Set (AdjoinRoot g)) = ⊤ :=
      (AdjoinRoot.isAdjoinRoot g).primitive_element_root
    haveI : Algebra.IsSeparable E
        ↥(IntermediateField.adjoin E ({AdjoinRoot.root g} : Set (AdjoinRoot g))) :=
      (IntermediateField.isSeparable_adjoin_simple_iff_isSeparable E (AdjoinRoot g)).mpr
        hRootSep
    haveI : Algebra.IsSeparable E (AdjoinRoot g) :=
      AlgEquiv.Algebra.isSeparable
        ((IntermediateField.equivOfEq hPrim).trans IntermediateField.topEquiv)
    haveI : Algebra.FormallyEtale E (AdjoinRoot g) :=
      Algebra.FormallyEtale.of_isSeparable E (AdjoinRoot g)
    have hFT : Algebra.FiniteType E (AdjoinRoot g) :=
      ⟨⟨{AdjoinRoot.root g}, by simpa using AdjoinRoot.adjoinRoot_eq_top (f := g)⟩⟩
    haveI : Algebra.FinitePresentation E (AdjoinRoot g) :=
      Algebra.FinitePresentation.of_finiteType.mp hFT
    haveI : Algebra.Etale E (AdjoinRoot g) := Algebra.Etale.mk
    have hu_et : AlgebraicGeometry.Etale u :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
        (RingHom.etale_algebraMap.mpr inferInstance)
    have hu_surj : AlgebraicGeometry.Surjective u := by
      refine ⟨fun x => ?_⟩
      obtain ⟨y⟩ : Nonempty ↥(AlgebraicGeometry.Spec (CommRingCat.of (AdjoinRoot g))) :=
        inferInstance
      exact ⟨y, Subsingleton.elim _ _⟩
    exact ⟨inferInstance, hu_et, hu_surj⟩

  
  have hDirectAdj : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (u : S₁ ⟶ S₂)
      (hu : AlgebraicGeometry.Etale u) (hu_surj : AlgebraicGeometry.Surjective u)
      [hCont_M : (etMap hu).IsContinuous S₁.smallEtaleTopology S₂.smallEtaleTopology]
      [hCont_B : (weilAltCdSitePullback u).IsContinuous
        S₂.smallEtaleTopology S₁.smallEtaleTopology],
      let M_u := etMap hu
      let B_u := weilAltCdSitePullback u
      let M_pull := M_u.sheafPushforwardContinuous AddCommGrpCat.{u}
        S₁.smallEtaleTopology S₂.smallEtaleTopology
      let u_push := B_u.sheafPushforwardContinuous AddCommGrpCat.{u}
        S₂.smallEtaleTopology S₁.smallEtaleTopology
      let adj_site : M_u ⊣ B_u :=
        letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) u :=
          CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
        letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
            (@AlgebraicGeometry.Etale) u :=
          CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
            (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
        CategoryTheory.MorphismProperty.Over.mapPullbackAdj
          (@AlgebraicGeometry.Etale) ⊤ u hu trivial
      ∃ (adj_MB : M_pull ⊣ u_push),
        (∀ (ℋ : CategoryTheory.Sheaf S₂.smallEtaleTopology AddCommGrpCat.{u}) (W : S₂.Etale),
          (adj_MB.unit.app ℋ).hom.app (Opposite.op W) =
            ℋ.obj.map (adj_site.counit.app W).op) ∧
        (∀ (𝒢 : CategoryTheory.Sheaf S₁.smallEtaleTopology AddCommGrpCat.{u}) (V : S₁.Etale),
          (adj_MB.counit.app 𝒢).hom.app (Opposite.op V) =
            𝒢.obj.map (adj_site.unit.app V).op) ∧
        (∀ (ℋ : CategoryTheory.Sheaf S₂.smallEtaleTopology AddCommGrpCat.{u}),
          CategoryTheory.Mono (adj_MB.unit.app ℋ)) ∧
        M_pull.Faithful := by
    intro S₁ S₂ u hu hu_surj hCont_M hCont_B M_u B_u M_pull u_push adj_site
    letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) u :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
        (@AlgebraicGeometry.Etale) u :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let adj_MB : M_pull ⊣ u_push :=
      CategoryTheory.Adjunction.mkOfUnitCounit
        { unit :=
            { app := fun ℋ =>
                { hom :=
                    { app := fun W => ℋ.obj.map (adj_site.counit.app W.unop).op
                      naturality := fun {W₁ W₂} f => by
                        rcases W₁ with ⟨W₁⟩; rcases W₂ with ⟨W₂⟩; rcases f with ⟨f⟩
                        change CategoryTheory.CategoryStruct.comp (ℋ.obj.map f.op)
                            (ℋ.obj.map (adj_site.counit.app W₂).op) =
                          CategoryTheory.CategoryStruct.comp
                            (ℋ.obj.map (adj_site.counit.app W₁).op)
                            (ℋ.obj.map (M_u.map (B_u.map f)).op)
                        rw [← ℋ.obj.map_comp, ← ℋ.obj.map_comp, ← op_comp, ← op_comp]
                        exact congrArg (fun k => ℋ.obj.map k.op)
                          (adj_site.counit.naturality f).symm } }
              naturality := fun {ℋ₁ ℋ₂} α => by
                apply hSheafExt
                intro W
                exact (α.hom.naturality (adj_site.counit.app W).op).symm }
          counit :=
            { app := fun 𝒢 =>
                { hom :=
                    { app := fun V => 𝒢.obj.map (adj_site.unit.app V.unop).op
                      naturality := fun {V₁ V₂} f => by
                        rcases V₁ with ⟨V₁⟩; rcases V₂ with ⟨V₂⟩; rcases f with ⟨f⟩
                        change CategoryTheory.CategoryStruct.comp
                            (𝒢.obj.map (B_u.map (M_u.map f)).op)
                            (𝒢.obj.map (adj_site.unit.app V₂).op) =
                          CategoryTheory.CategoryStruct.comp
                            (𝒢.obj.map (adj_site.unit.app V₁).op) (𝒢.obj.map f.op)
                        rw [← 𝒢.obj.map_comp, ← 𝒢.obj.map_comp, ← op_comp, ← op_comp]
                        exact congrArg (fun k => 𝒢.obj.map k.op)
                          (adj_site.unit.naturality f).symm } }
              naturality := fun {𝒢₁ 𝒢₂} β => by
                apply hSheafExt
                intro V
                exact (β.hom.naturality (adj_site.unit.app V).op).symm }
          left_triangle := by
            apply CategoryTheory.NatTrans.ext
            funext ℋ
            apply hSheafExt
            intro V
            change CategoryTheory.CategoryStruct.comp
                (ℋ.obj.map (adj_site.counit.app (M_u.obj V)).op)
                (ℋ.obj.map (M_u.map (adj_site.unit.app V)).op) =
              CategoryTheory.CategoryStruct.id _
            rw [← ℋ.obj.map_comp, ← op_comp, adj_site.left_triangle_components V]
            dsimp only [CategoryTheory.Functor.id_obj]
            rw [op_id, ℋ.obj.map_id]
          right_triangle := by
            apply CategoryTheory.NatTrans.ext
            funext 𝒢
            apply hSheafExt
            intro W
            change CategoryTheory.CategoryStruct.comp
                (𝒢.obj.map (B_u.map (adj_site.counit.app W)).op)
                (𝒢.obj.map (adj_site.unit.app (B_u.obj W)).op) =
              CategoryTheory.CategoryStruct.id _
            rw [← 𝒢.obj.map_comp, ← op_comp, adj_site.right_triangle_components W]
            dsimp only [CategoryTheory.Functor.id_obj]
            rw [op_id, 𝒢.obj.map_id] }
    have hMonoUnit : ∀ (ℋ : CategoryTheory.Sheaf S₂.smallEtaleTopology AddCommGrpCat.{u}),
        CategoryTheory.Mono (adj_MB.unit.app ℋ) := by
      intro ℋ
      refine ⟨fun {𝒦} α β hαβ => ?_⟩
      apply hSheafExt
      intro W
      ext x
      have hEqMap : ℋ.obj.map (adj_site.counit.app W).op ((α.hom.app (Opposite.op W)) x) =
          ℋ.obj.map (adj_site.counit.app W).op ((β.hom.app (Opposite.op W)) x) := by
        have happ := congrArg (fun m : 𝒦 ⟶ u_push.obj (M_pull.obj ℋ) =>
          (m.hom.app (Opposite.op W)) x) hαβ
        exact happ
      let c_W : M_u.obj (B_u.obj W) ⟶ W := adj_site.counit.app W
      have hcW_left : c_W.left = CategoryTheory.Limits.pullback.fst W.hom u :=
        congrArg (fun m => m.left)
          (CategoryTheory.MorphismProperty.Over.mapPullbackAdj_counit_app
            (@AlgebraicGeometry.Etale) ⊤ u hu trivial W)
      have hcW_et : AlgebraicGeometry.Etale c_W.left := by
        rw [hcW_left]
        exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (CategoryTheory.IsPullback.of_hasPullback W.hom u).flip hu
      have hcW_surj : AlgebraicGeometry.Surjective c_W.left := by
        rw [hcW_left]
        exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (CategoryTheory.IsPullback.of_hasPullback W.hom u).flip hu_surj
      have hCov : CategoryTheory.Sieve.generate (CategoryTheory.Presieve.singleton c_W) ∈
          S₂.smallEtaleTopology W := by
        rw [hSmallTopMem]
        intro w
        obtain ⟨y, hy⟩ := hcW_surj.surj w
        exact ⟨M_u.obj (B_u.obj W), c_W, y,
          ⟨M_u.obj (B_u.obj W), CategoryTheory.CategoryStruct.id _, c_W,
            CategoryTheory.Presieve.singleton_self c_W,
            CategoryTheory.Category.id_comp c_W⟩,
          hcW_et, hy⟩
      have hSep := ((ℋ.cond Aℤ).isSheafFor (CategoryTheory.Presieve.singleton c_W) hCov).isSeparatedFor
      let fam : CategoryTheory.Presieve.FamilyOfElements
          (ℋ.obj ⋙ CategoryTheory.coyoneda.obj (Opposite.op Aℤ))
          (CategoryTheory.Presieve.singleton c_W) :=
        fun Y g hg => by
          cases hg
          exact zHom _ (ℋ.obj.map c_W.op ((α.hom.app (Opposite.op W)) x))
      have hHomEq : zHom _ ((α.hom.app (Opposite.op W)) x) =
          zHom _ ((β.hom.app (Opposite.op W)) x) := by
        refine hSep fam _ _ ?_ ?_
        · rintro Y g ⟨⟩
          exact hzHom_comp (ℋ.obj.map c_W.op) _
        · rintro Y g ⟨⟩
          exact (hzHom_comp (ℋ.obj.map c_W.op) _).trans
            (congrArg (zHom _) hEqMap.symm)
      have heval := congrArg (fun φ : Aℤ ⟶ ℋ.obj.obj (Opposite.op W) => φ (ULift.up 1)) hHomEq
      exact (hzHom_eval _ _).symm.trans (heval.trans (hzHom_eval _ _))
    have hFaithful : M_pull.Faithful := by
      refine ⟨fun {ℋ₁ ℋ₂} f₁ f₂ hf => ?_⟩
      haveI : CategoryTheory.Mono (adj_MB.unit.app ℋ₂) := hMonoUnit ℋ₂
      rw [← CategoryTheory.cancel_mono (adj_MB.unit.app ℋ₂)]
      have hn₁ := adj_MB.unit.naturality f₁
      have hn₂ := adj_MB.unit.naturality f₂
      change CategoryTheory.CategoryStruct.comp f₁ (adj_MB.unit.app ℋ₂) =
        CategoryTheory.CategoryStruct.comp (adj_MB.unit.app ℋ₁) (u_push.map (M_pull.map f₁)) at hn₁
      change CategoryTheory.CategoryStruct.comp f₂ (adj_MB.unit.app ℋ₂) =
        CategoryTheory.CategoryStruct.comp (adj_MB.unit.app ℋ₁) (u_push.map (M_pull.map f₂)) at hn₂
      rw [hn₁, hn₂, hf]
    exact ⟨adj_MB, fun _ _ => rfl, fun _ _ => rfl, hMonoUnit, hFaithful⟩

  
  have hAutAdj : ∀ {S : AlgebraicGeometry.Scheme.{u}} (τ : S ≅ S)
      (hτ_hom : AlgebraicGeometry.Etale τ.hom) (hτ_inv : AlgebraicGeometry.Etale τ.inv)
      [hCont_hom : (etMap hτ_hom).IsContinuous S.smallEtaleTopology S.smallEtaleTopology]
      [hCont_inv : (etMap hτ_inv).IsContinuous S.smallEtaleTopology S.smallEtaleTopology],
      let M_hom := etMap hτ_hom
      let M_inv := etMap hτ_inv
      let T_hom := M_hom.sheafPushforwardContinuous AddCommGrpCat.{u}
        S.smallEtaleTopology S.smallEtaleTopology
      let T_inv := M_inv.sheafPushforwardContinuous AddCommGrpCat.{u}
        S.smallEtaleTopology S.smallEtaleTopology
      ∃ (adj_T : T_hom ⊣ T_inv),
        ∀ (𝒢 : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}) (V : S.Etale),
          (adj_T.unit.app 𝒢).hom.app (Opposite.op V) =
            𝒢.obj.map (show M_hom.obj (M_inv.obj V) ⟶ V from
              CategoryTheory.MorphismProperty.Over.homMk
                (CategoryTheory.CategoryStruct.id V.left) (by
                  change CategoryTheory.CategoryStruct.comp (CategoryTheory.CategoryStruct.id V.left) V.hom =
                    CategoryTheory.CategoryStruct.comp (CategoryTheory.CategoryStruct.comp V.hom τ.inv) τ.hom
                  rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc,
                    τ.inv_hom_id]
                  exact (CategoryTheory.Category.comp_id V.hom).symm)).op := by
    intro S τ hτ_hom hτ_inv hCont_hom hCont_inv M_hom M_inv T_hom T_inv
    let u_V : ∀ V : S.Etale, M_hom.obj (M_inv.obj V) ⟶ V := fun V =>
      show M_hom.obj (M_inv.obj V) ⟶ V from
        CategoryTheory.MorphismProperty.Over.homMk (CategoryTheory.CategoryStruct.id V.left) (by
          change CategoryTheory.CategoryStruct.comp (CategoryTheory.CategoryStruct.id V.left) V.hom =
            CategoryTheory.CategoryStruct.comp (CategoryTheory.CategoryStruct.comp V.hom τ.inv) τ.hom
          rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc,
            τ.inv_hom_id]
          exact (CategoryTheory.Category.comp_id V.hom).symm)
    let c_V : ∀ V : S.Etale, V ⟶ M_inv.obj (M_hom.obj V) := fun V =>
      show V ⟶ M_inv.obj (M_hom.obj V) from
        CategoryTheory.MorphismProperty.Over.homMk (CategoryTheory.CategoryStruct.id V.left) (by
          change CategoryTheory.CategoryStruct.comp (CategoryTheory.CategoryStruct.id V.left)
            (CategoryTheory.CategoryStruct.comp (CategoryTheory.CategoryStruct.comp V.hom τ.hom) τ.inv) = V.hom
          rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc,
            τ.hom_inv_id]
          exact CategoryTheory.Category.comp_id V.hom)
    let adj_T : T_hom ⊣ T_inv :=
      CategoryTheory.Adjunction.mkOfUnitCounit
        { unit :=
            { app := fun 𝒢 =>
                { hom :=
                    { app := fun V => 𝒢.obj.map (u_V V.unop).op
                      naturality := fun {V₁ V₂} f => by
                        rcases V₁ with ⟨V₁⟩; rcases V₂ with ⟨V₂⟩; rcases f with ⟨f⟩
                        change CategoryTheory.CategoryStruct.comp (𝒢.obj.map f.op)
                            (𝒢.obj.map (u_V V₂).op) =
                          CategoryTheory.CategoryStruct.comp (𝒢.obj.map (u_V V₁).op)
                            (𝒢.obj.map (M_hom.map (M_inv.map f)).op)
                        rw [← 𝒢.obj.map_comp, ← 𝒢.obj.map_comp, ← op_comp, ← op_comp]
                        refine congrArg (fun k : _ ⟶ _ => 𝒢.obj.map k.op) ?_
                        apply CategoryTheory.MorphismProperty.Over.Hom.ext
                        change CategoryTheory.CategoryStruct.comp
                            (CategoryTheory.CategoryStruct.id V₂.left) f.left =
                          CategoryTheory.CategoryStruct.comp f.left
                            (CategoryTheory.CategoryStruct.id V₁.left)
                        rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id] } }
              naturality := fun {𝒢₁ 𝒢₂} α => by
                apply hSheafExt
                intro V
                exact (α.hom.naturality (u_V V).op).symm }
          counit :=
            { app := fun 𝒢 =>
                { hom :=
                    { app := fun V => 𝒢.obj.map (c_V V.unop).op
                      naturality := fun {V₁ V₂} f => by
                        rcases V₁ with ⟨V₁⟩; rcases V₂ with ⟨V₂⟩; rcases f with ⟨f⟩
                        change CategoryTheory.CategoryStruct.comp
                            (𝒢.obj.map (M_inv.map (M_hom.map f)).op)
                            (𝒢.obj.map (c_V V₂).op) =
                          CategoryTheory.CategoryStruct.comp (𝒢.obj.map (c_V V₁).op)
                            (𝒢.obj.map f.op)
                        rw [← 𝒢.obj.map_comp, ← 𝒢.obj.map_comp, ← op_comp, ← op_comp]
                        refine congrArg (fun k : _ ⟶ _ => 𝒢.obj.map k.op) ?_
                        apply CategoryTheory.MorphismProperty.Over.Hom.ext
                        change CategoryTheory.CategoryStruct.comp
                            (CategoryTheory.CategoryStruct.id V₂.left) f.left =
                          CategoryTheory.CategoryStruct.comp f.left
                            (CategoryTheory.CategoryStruct.id V₁.left)
                        rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id] } }
              naturality := fun {𝒢₁ 𝒢₂} β => by
                apply hSheafExt
                intro V
                exact (β.hom.naturality (c_V V).op).symm }
          left_triangle := by
            apply CategoryTheory.NatTrans.ext
            funext 𝒢
            apply hSheafExt
            intro V
            change CategoryTheory.CategoryStruct.comp (𝒢.obj.map (u_V (M_hom.obj V)).op)
                (𝒢.obj.map (M_hom.map (c_V V)).op) =
              CategoryTheory.CategoryStruct.id _
            rw [← 𝒢.obj.map_comp, ← op_comp]
            have hid : CategoryTheory.CategoryStruct.comp (M_hom.map (c_V V))
                (u_V (M_hom.obj V)) = CategoryTheory.CategoryStruct.id (M_hom.obj V) := by
              apply CategoryTheory.MorphismProperty.Over.Hom.ext
              exact CategoryTheory.Category.id_comp (CategoryTheory.CategoryStruct.id V.left)
            rw [hid, op_id, 𝒢.obj.map_id]
          right_triangle := by
            apply CategoryTheory.NatTrans.ext
            funext 𝒢
            apply hSheafExt
            intro V
            change CategoryTheory.CategoryStruct.comp (𝒢.obj.map (M_inv.map (u_V V)).op)
                (𝒢.obj.map (c_V (M_inv.obj V)).op) =
              CategoryTheory.CategoryStruct.id _
            rw [← 𝒢.obj.map_comp, ← op_comp]
            have hid : CategoryTheory.CategoryStruct.comp (c_V (M_inv.obj V))
                (M_inv.map (u_V V)) = CategoryTheory.CategoryStruct.id (M_inv.obj V) := by
              apply CategoryTheory.MorphismProperty.Over.Hom.ext
              exact CategoryTheory.Category.id_comp (CategoryTheory.CategoryStruct.id V.left)
            rw [hid, op_id, 𝒢.obj.map_id] }
    exact ⟨adj_T, fun _ _ => rfl⟩

  
  have hSplitFan : ∀ (E : Type u) [Field E]
      (g : Polynomial E) (hg_monic : g.Monic) [Fact (Irreducible g)] (hg_sep : g.Separable)
      (r_E : Fin d → AdjoinRoot g)
      (hr_dist : _root_.Pairwise (fun i j : Fin d => r_E i ≠ r_E j))
      (hr_split : g.map (algebraMap E (AdjoinRoot g)) =
        ∏ i : Fin d, (Polynomial.X - Polynomial.C (r_E i)))
      (hu : AlgebraicGeometry.Etale
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E (AdjoinRoot g)))))
      [hCont_M : (etMap hu).IsContinuous
        (AlgebraicGeometry.Spec (CommRingCat.of (AdjoinRoot g))).smallEtaleTopology
        (AlgebraicGeometry.Spec (CommRingCat.of E)).smallEtaleTopology]
      [hCont_B : (weilAltCdSitePullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E (AdjoinRoot g))))).IsContinuous
        (AlgebraicGeometry.Spec (CommRingCat.of E)).smallEtaleTopology
        (AlgebraicGeometry.Spec (CommRingCat.of (AdjoinRoot g))).smallEtaleTopology]
      [Limits.HasFiniteBiproducts
        (CategoryTheory.Sheaf
          (AlgebraicGeometry.Spec (CommRingCat.of (AdjoinRoot g))).smallEtaleTopology
          AddCommGrpCat.{u})],
      let K := AdjoinRoot g
      let S_E := AlgebraicGeometry.Spec (CommRingCat.of E)
      let S_K := AlgebraicGeometry.Spec (CommRingCat.of K)
      let u := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E K))
      let M_u := etMap hu
      let B_u := weilAltCdSitePullback u
      let M_pull := M_u.sheafPushforwardContinuous AddCommGrpCat.{u}
        S_K.smallEtaleTopology S_E.smallEtaleTopology
      let u_push := B_u.sheafPushforwardContinuous AddCommGrpCat.{u}
        S_E.smallEtaleTopology S_K.smallEtaleTopology
      ∃ (σ : Fin d → (K ≃ₐ[E] K)),
        (∀ i : Fin d, σ i (AdjoinRoot.root g) = r_E i) ∧
        let τ : Fin d → (S_K ≅ S_K) := fun i =>
          { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (σ i).toRingHom)
            inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (σ i).symm.toRingHom)
            hom_inv_id := by
              rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
              have heq : (σ i).toRingHom.comp (σ i).symm.toRingHom = RingHom.id K :=
                RingHom.ext (fun x => by
                  simp only [RingHom.comp_apply, RingHom.id_apply]
                  exact (σ i).apply_symm_apply x)
              rw [heq]
              exact AlgebraicGeometry.Spec.map_id (CommRingCat.of K)
            inv_hom_id := by
              rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
              have heq : (σ i).symm.toRingHom.comp (σ i).toRingHom = RingHom.id K :=
                RingHom.ext (fun x => by
                  simp only [RingHom.comp_apply, RingHom.id_apply]
                  exact (σ i).symm_apply_apply x)
              rw [heq]
              exact AlgebraicGeometry.Spec.map_id (CommRingCat.of K) }
        ∀ (hτ_hom : ∀ i : Fin d, AlgebraicGeometry.Etale (τ i).hom)
          [hCont_τ : ∀ i : Fin d,
            (etMap (hτ_hom i)).IsContinuous S_K.smallEtaleTopology S_K.smallEtaleTopology],
          let M_τ := fun i : Fin d => etMap (hτ_hom i)
          let T_τ := fun i : Fin d =>
            (M_τ i).sheafPushforwardContinuous AddCommGrpCat.{u}
              S_K.smallEtaleTopology S_K.smallEtaleTopology
          ∃ (hτ_u : ∀ i : Fin d, CategoryTheory.CategoryStruct.comp (τ i).hom u = u)
            (Ψ : ∀ 𝒢 : CategoryTheory.Sheaf S_K.smallEtaleTopology AddCommGrpCat.{u},
              M_pull.obj (u_push.obj 𝒢) ≅
                CategoryTheory.Limits.piObj (fun j : ULift.{u} (Fin d) => (T_τ j.down).obj 𝒢)),
            ∀ (𝒢 : CategoryTheory.Sheaf S_K.smallEtaleTopology AddCommGrpCat.{u})
              (j : ULift.{u} (Fin d)) (V : S_K.Etale),
              ((CategoryTheory.CategoryStruct.comp (Ψ 𝒢).hom
                (CategoryTheory.Limits.Pi.π
                  (fun k : ULift.{u} (Fin d) => (T_τ k.down).obj 𝒢) j)).hom.app (Opposite.op V)) =
                𝒢.obj.map (show (M_τ j.down).obj V ⟶ B_u.obj (M_u.obj V) from
                  CategoryTheory.MorphismProperty.Over.homMk
                    (CategoryTheory.Limits.pullback.lift
                      (CategoryTheory.CategoryStruct.id V.left)
                      (CategoryTheory.CategoryStruct.comp V.hom (τ j.down).hom)
                      (by
                        change CategoryTheory.CategoryStruct.comp (CategoryTheory.CategoryStruct.id V.left)
                            (CategoryTheory.CategoryStruct.comp V.hom u) =
                          CategoryTheory.CategoryStruct.comp
                            (CategoryTheory.CategoryStruct.comp V.hom (τ j.down).hom) u
                        rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc,
                          hτ_u j.down]))
                    (CategoryTheory.Limits.pullback.lift_snd _ _ _)).op := by
    intro E _ g hg_monic _ hg_sep r_E hr_dist hr_split hu hCont_M hCont_B _ K S_E S_K u M_u B_u M_pull u_push
    haveI : FiniteDimensional E K := (hEtalePkg E g hg_monic hg_sep).1
    letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) u :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
        (@AlgebraicGeometry.Etale) u :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    have hEvalRoot : ∀ i : Fin d, Polynomial.eval₂ (algebraMap E K) (r_E i) g = 0 := by
      intro i
      rw [← Polynomial.eval_map, hr_split, Polynomial.eval_prod]
      refine Finset.prod_eq_zero (Finset.mem_univ i) ?_
      simp
    let σ_hom : ∀ i : Fin d, K →ₐ[E] K := fun i =>
      AdjoinRoot.liftAlgHom g (Algebra.ofId E K) (r_E i) (hEvalRoot i)
    let σ : Fin d → (K ≃ₐ[E] K) := fun i =>
      have hinj : Function.Injective (σ_hom i).toLinearMap := (σ_hom i).toRingHom.injective
      AlgEquiv.ofBijective (σ_hom i)
        ⟨hinj,
         (LinearMap.injective_iff_surjective_of_finrank_eq_finrank
           (f := (σ_hom i).toLinearMap) rfl).mp hinj⟩
    have hσ_root : ∀ i : Fin d, σ i (AdjoinRoot.root g) = r_E i := fun i =>
      AdjoinRoot.liftAlgHom_root g (Algebra.ofId E K) (r_E i) (hEvalRoot i)
    refine ⟨σ, hσ_root, ?_⟩
    intro τ hτ_hom hCont_τ M_τ T_τ
    have hτ_u : ∀ i : Fin d, CategoryTheory.CategoryStruct.comp (τ i).hom u = u := by
      intro i
      dsimp [τ, u]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      congr 2
      ext e
      exact (σ i).commutes e
    refine ⟨hτ_u, ?_⟩
    let ι : ∀ (V : S_K.Etale) (i : Fin d), (M_τ i).obj V ⟶ B_u.obj (M_u.obj V) := fun V i =>
      have hcomm_i : CategoryTheory.CategoryStruct.comp (CategoryTheory.CategoryStruct.id V.left)
          (CategoryTheory.CategoryStruct.comp V.hom u) =
          CategoryTheory.CategoryStruct.comp
            (CategoryTheory.CategoryStruct.comp V.hom (τ i).hom) u := by
        rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc, hτ_u i]
      CategoryTheory.MorphismProperty.Over.homMk
        (CategoryTheory.Limits.pullback.lift
          (CategoryTheory.CategoryStruct.id V.left)
          (CategoryTheory.CategoryStruct.comp V.hom (τ i).hom) hcomm_i)
        (CategoryTheory.Limits.pullback.lift_snd _ _ _)
    have hι_fst : ∀ (V : S_K.Etale) (i : Fin d),
        CategoryTheory.CategoryStruct.comp (ι V i).left
          (CategoryTheory.Limits.pullback.fst (M_u.obj V).hom u) =
          CategoryTheory.CategoryStruct.id V.left :=
      fun V i => CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hι_snd : ∀ (V : S_K.Etale) (i : Fin d),
        CategoryTheory.CategoryStruct.comp (ι V i).left
          (CategoryTheory.Limits.pullback.snd (M_u.obj V).hom u) =
          CategoryTheory.CategoryStruct.comp V.hom (τ i).hom :=
      fun V i => CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hι_et : ∀ (V : S_K.Etale) (i : Fin d), AlgebraicGeometry.Etale (ι V i).left := by
      intro V i
      have hfst := hι_fst V i
      have hp_et : AlgebraicGeometry.Etale
          (CategoryTheory.Limits.pullback.fst (M_u.obj V).hom u) :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (CategoryTheory.IsPullback.of_hasPullback (M_u.obj V).hom u).flip hu
      have hid_et : AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.id V.left) :=
        inferInstance
      exact @CategoryTheory.MorphismProperty.of_postcomp _ _ (@AlgebraicGeometry.Etale)
        (@AlgebraicGeometry.Etale) _ _ _ _ (ι V i).left
        (CategoryTheory.Limits.pullback.fst (M_u.obj V).hom u)
        hp_et (by rwa [hfst])
    have hι_nat : ∀ {V₁ V₂ : S_K.Etale} (f : V₁ ⟶ V₂) (i : Fin d),
        CategoryTheory.CategoryStruct.comp ((M_τ i).map f) (ι V₂ i) =
          CategoryTheory.CategoryStruct.comp (ι V₁ i) (B_u.map (M_u.map f)) := by
      intro V₁ V₂ f i
      apply CategoryTheory.MorphismProperty.Over.Hom.ext
      apply CategoryTheory.Limits.pullback.hom_ext
      · change CategoryTheory.CategoryStruct.comp f.left
            (CategoryTheory.CategoryStruct.comp (ι V₂ i).left
              (CategoryTheory.Limits.pullback.fst (M_u.obj V₂).hom u)) =
          CategoryTheory.CategoryStruct.comp (ι V₁ i).left
            (CategoryTheory.CategoryStruct.comp (B_u.map (M_u.map f)).left
              (CategoryTheory.Limits.pullback.fst (M_u.obj V₂).hom u))
        have hB_fst : CategoryTheory.CategoryStruct.comp (B_u.map (M_u.map f)).left
            (CategoryTheory.Limits.pullback.fst (M_u.obj V₂).hom u) =
            CategoryTheory.CategoryStruct.comp
              (CategoryTheory.Limits.pullback.fst (M_u.obj V₁).hom u) f.left :=
          CategoryTheory.Limits.pullback.lift_fst _ _ _
        have hL : CategoryTheory.CategoryStruct.comp f.left
            (CategoryTheory.CategoryStruct.comp (ι V₂ i).left
              (CategoryTheory.Limits.pullback.fst (M_u.obj V₂).hom u)) = f.left :=
          (congrArg (CategoryTheory.CategoryStruct.comp f.left) (hι_fst V₂ i)).trans
            (CategoryTheory.Category.comp_id f.left)
        have hR : CategoryTheory.CategoryStruct.comp (ι V₁ i).left
            (CategoryTheory.CategoryStruct.comp (B_u.map (M_u.map f)).left
              (CategoryTheory.Limits.pullback.fst (M_u.obj V₂).hom u)) = f.left :=
          (congrArg (CategoryTheory.CategoryStruct.comp (ι V₁ i).left) hB_fst).trans
            ((CategoryTheory.Category.assoc (ι V₁ i).left _ f.left).symm.trans
              ((congrArg (fun k => CategoryTheory.CategoryStruct.comp k f.left)
                (hι_fst V₁ i)).trans (CategoryTheory.Category.id_comp f.left)))
        exact hL.trans hR.symm
      · change CategoryTheory.CategoryStruct.comp f.left
            (CategoryTheory.CategoryStruct.comp (ι V₂ i).left
              (CategoryTheory.Limits.pullback.snd (M_u.obj V₂).hom u)) =
          CategoryTheory.CategoryStruct.comp (ι V₁ i).left
            (CategoryTheory.CategoryStruct.comp (B_u.map (M_u.map f)).left
              (CategoryTheory.Limits.pullback.snd (M_u.obj V₂).hom u))
        have hB_snd : CategoryTheory.CategoryStruct.comp (B_u.map (M_u.map f)).left
            (CategoryTheory.Limits.pullback.snd (M_u.obj V₂).hom u) =
            CategoryTheory.Limits.pullback.snd (M_u.obj V₁).hom u :=
          CategoryTheory.Limits.pullback.lift_snd _ _ _
        have hL : CategoryTheory.CategoryStruct.comp f.left
            (CategoryTheory.CategoryStruct.comp (ι V₂ i).left
              (CategoryTheory.Limits.pullback.snd (M_u.obj V₂).hom u)) =
            CategoryTheory.CategoryStruct.comp V₁.hom (τ i).hom :=
          (congrArg (CategoryTheory.CategoryStruct.comp f.left) (hι_snd V₂ i)).trans
            ((CategoryTheory.Category.assoc f.left V₂.hom (τ i).hom).symm.trans
              (congrArg (fun k => CategoryTheory.CategoryStruct.comp k (τ i).hom)
                (CategoryTheory.MorphismProperty.Over.w f)))
        have hR : CategoryTheory.CategoryStruct.comp (ι V₁ i).left
            (CategoryTheory.CategoryStruct.comp (B_u.map (M_u.map f)).left
              (CategoryTheory.Limits.pullback.snd (M_u.obj V₂).hom u)) =
            CategoryTheory.CategoryStruct.comp V₁.hom (τ i).hom :=
          (congrArg (CategoryTheory.CategoryStruct.comp (ι V₁ i).left) hB_snd).trans
            (hι_snd V₁ i)
        exact hL.trans hR.symm
    have hCovV : ∀ V : S_K.Etale,
        CategoryTheory.Sieve.generate
          (CategoryTheory.Presieve.ofArrows
            (fun j : ULift.{u} (Fin d) => (M_τ j.down).obj V)
            (fun j : ULift.{u} (Fin d) => ι V j.down)) ∈
          S_K.smallEtaleTopology (B_u.obj (M_u.obj V)) := by
      intro V
      let P := B_u.obj (M_u.obj V)
      rw [hSmallTopMem]
      intro z
      let ξ_z : AlgebraicGeometry.Spec (P.left.residueField z) ⟶ P.left :=
        P.left.fromSpecResidueField z
      let pr₁ : P.left ⟶ V.left :=
        CategoryTheory.Limits.pullback.fst (M_u.obj V).hom u
      let pr₂ : P.left ⟶ S_K :=
        CategoryTheory.Limits.pullback.snd (M_u.obj V).hom u
      let γ₁ : AlgebraicGeometry.Spec (P.left.residueField z) ⟶ V.left :=
        CategoryTheory.CategoryStruct.comp ξ_z pr₁
      let f₁ : K →+* ↑(P.left.residueField z) :=
        (AlgebraicGeometry.Spec.preimage (CategoryTheory.CategoryStruct.comp γ₁ V.hom)).hom
      let f₂ : K →+* ↑(P.left.residueField z) :=
        (AlgebraicGeometry.Spec.preimage (CategoryTheory.CategoryStruct.comp ξ_z pr₂)).hom
      have hf_eq : f₁.comp (algebraMap E K) = f₂.comp (algebraMap E K) := by
        have hsq : CategoryTheory.CategoryStruct.comp (CategoryTheory.CategoryStruct.comp γ₁ V.hom) u =
            CategoryTheory.CategoryStruct.comp (CategoryTheory.CategoryStruct.comp ξ_z pr₂) u :=
          (CategoryTheory.Category.assoc γ₁ V.hom u).trans
            ((CategoryTheory.Category.assoc ξ_z pr₁ (M_u.obj V).hom).trans
              ((congrArg (CategoryTheory.CategoryStruct.comp ξ_z)
                CategoryTheory.Limits.pullback.condition).trans
                (CategoryTheory.Category.assoc ξ_z pr₂ u).symm))
        have hpre := congrArg AlgebraicGeometry.Spec.preimage hsq
        rw [AlgebraicGeometry.Spec.preimage_comp, AlgebraicGeometry.Spec.preimage_comp,
          AlgebraicGeometry.Spec.preimage_map] at hpre
        exact congrArg CommRingCat.Hom.hom hpre
      have hProdZero : (∏ i : Fin d, (f₂ (AdjoinRoot.root g) - f₁ (r_E i))) = 0 := by
        have h1 : Polynomial.eval (f₂ (AdjoinRoot.root g))
            ((g.map (algebraMap E K)).map f₁) = 0 := by
          rw [Polynomial.map_map, hf_eq, ← Polynomial.map_map, Polynomial.eval_map,
            Polynomial.eval₂_hom, Polynomial.eval_map]
          change f₂ (Polynomial.eval₂ (AdjoinRoot.of g) (AdjoinRoot.root g) g) = 0
          rw [AdjoinRoot.eval₂_root, map_zero]
        rw [hr_split, Polynomial.map_prod, Polynomial.eval_prod] at h1
        simpa only [Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C,
          Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C] using h1
      obtain ⟨i₀, _, hi₀⟩ := Finset.prod_eq_zero_iff.mp hProdZero
      have hroot_eq : f₂ (AdjoinRoot.root g) =
          (f₁.comp (σ i₀).toRingHom) (AdjoinRoot.root g) := by
        change f₂ (AdjoinRoot.root g) = f₁ ((σ i₀) (AdjoinRoot.root g))
        rw [hσ_root i₀]
        exact sub_eq_zero.mp hi₀
      have hf₂_eq : f₂ = f₁.comp (σ i₀).toRingHom := by
        apply AdjoinRoot.ringHom_ext
        · ext e
          change f₂ (algebraMap E K e) = f₁ ((σ i₀) (algebraMap E K e))
          rw [(σ i₀).commutes e]
          exact DFunLike.congr_fun hf_eq.symm e
        · exact hroot_eq
      have hξ_snd : CategoryTheory.CategoryStruct.comp ξ_z pr₂ =
          CategoryTheory.CategoryStruct.comp γ₁
            (CategoryTheory.CategoryStruct.comp V.hom (τ i₀).hom) := by
        have hm₁ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₁) =
            CategoryTheory.CategoryStruct.comp γ₁ V.hom :=
          AlgebraicGeometry.Spec.map_preimage _
        have hm₂ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₂) =
            CategoryTheory.CategoryStruct.comp ξ_z pr₂ :=
          AlgebraicGeometry.Spec.map_preimage _
        rw [← hm₂, hf₂_eq, CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, hm₁]
        exact CategoryTheory.Category.assoc _ _ _
      have hξ_lift : CategoryTheory.CategoryStruct.comp γ₁ (ι V i₀).left = ξ_z := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · exact (CategoryTheory.Category.assoc γ₁ (ι V i₀).left pr₁).trans
            ((congrArg (CategoryTheory.CategoryStruct.comp γ₁) (hι_fst V i₀)).trans
              (CategoryTheory.Category.comp_id γ₁))
        · exact (CategoryTheory.Category.assoc γ₁ (ι V i₀).left pr₂).trans
            ((congrArg (CategoryTheory.CategoryStruct.comp γ₁) (hι_snd V i₀)).trans
              hξ_snd.symm)
      obtain ⟨pt₀⟩ : Nonempty ↥(AlgebraicGeometry.Spec (P.left.residueField z)) := inferInstance
      refine ⟨(M_τ i₀).obj V, ι V i₀, γ₁.base pt₀, ?_, hι_et V i₀, ?_⟩
      · exact ⟨(M_τ i₀).obj V, CategoryTheory.CategoryStruct.id _, ι V i₀,
          CategoryTheory.Presieve.ofArrows.mk (ULift.up.{u} i₀),
          CategoryTheory.Category.id_comp _⟩
      · have hpt := congrArg (fun m => m.base pt₀) hξ_lift
        exact hpt.trans (AlgebraicGeometry.Scheme.fromSpecResidueField_apply z pt₀)
    have hSubEmpty : ∀ (𝒢 : CategoryTheory.Sheaf S_K.smallEtaleTopology AddCommGrpCat.{u})
        (W : S_K.Etale), IsEmpty ↥W.left → Subsingleton ↥(𝒢.obj.obj (Opposite.op W)) := by
      intro 𝒢 W hEmp
      have hCovE : CategoryTheory.Sieve.generate
          (CategoryTheory.Presieve.ofArrows (Empty.elim : Empty → S_K.Etale)
            (fun e => Empty.elim e)) ∈ S_K.smallEtaleTopology W := by
        rw [hSmallTopMem]
        intro w
        exact IsEmpty.elim hEmp w
      have hShE := (CategoryTheory.Presieve.isSheafFor_arrows_iff
        (𝒢.obj ⋙ CategoryTheory.coyoneda.obj (Opposite.op Aℤ))
        (fun e : Empty => Empty.elim e)).mp
        ((𝒢.cond Aℤ).isSheafFor _ hCovE)
      obtain ⟨ψ, _, hψ_uniq⟩ := hShE (fun e => Empty.elim e) (fun i => Empty.elim i)
      refine ⟨fun a b => ?_⟩
      have ha : zHom _ a = ψ := hψ_uniq (zHom _ a) (fun e => Empty.elim e)
      have hb : zHom _ b = ψ := hψ_uniq (zHom _ b) (fun e => Empty.elim e)
      have hab := congrArg (fun φ : Aℤ ⟶ 𝒢.obj.obj (Opposite.op W) => φ (ULift.up 1))
        (ha.trans hb.symm)
      exact (hzHom_eval _ a).symm.trans (hab.trans (hzHom_eval _ b))
    have hCompatAll : ∀ (𝒢 : CategoryTheory.Sheaf S_K.smallEtaleTopology AddCommGrpCat.{u})
        (V : S_K.Etale)
        (x : ∀ j : ULift.{u} (Fin d), Aℤ ⟶ 𝒢.obj.obj (Opposite.op ((M_τ j.down).obj V))),
        CategoryTheory.Presieve.Arrows.Compatible
          (𝒢.obj ⋙ CategoryTheory.coyoneda.obj (Opposite.op Aℤ))
          (fun j : ULift.{u} (Fin d) => ι V j.down) x := by
      intro 𝒢 V x j₁ j₂ W q₁ q₂ hq
      have hq_left : q₁.left = q₂.left := by
        have h1 : CategoryTheory.CategoryStruct.comp
            (CategoryTheory.CategoryStruct.comp q₁.left (ι V j₁.down).left)
            (CategoryTheory.Limits.pullback.fst (M_u.obj V).hom u) =
            CategoryTheory.CategoryStruct.comp
              (CategoryTheory.CategoryStruct.comp q₂.left (ι V j₂.down).left)
              (CategoryTheory.Limits.pullback.fst (M_u.obj V).hom u) :=
          congrArg (fun m => CategoryTheory.CategoryStruct.comp m.left
            (CategoryTheory.Limits.pullback.fst (M_u.obj V).hom u)) hq
        have hL := (CategoryTheory.Category.assoc q₁.left (ι V j₁.down).left _).symm.trans
          (h1.trans (CategoryTheory.Category.assoc q₂.left (ι V j₂.down).left _))
        rw [hι_fst V j₁.down, hι_fst V j₂.down] at hL
        exact (CategoryTheory.Category.comp_id q₁.left).symm.trans
          (hL.trans (CategoryTheory.Category.comp_id q₂.left))
      by_cases hj : j₁ = j₂
      · subst hj
        have hq_eq : q₁ = q₂ := CategoryTheory.MorphismProperty.Over.Hom.ext hq_left
        rw [hq_eq]
      · have hne : j₁.down ≠ j₂.down := fun h => hj (ULift.ext _ _ h)
        have hEmp : IsEmpty ↥W.left := by
          refine ⟨fun w₀ => ?_⟩
          have hsnd : CategoryTheory.CategoryStruct.comp q₁.left
              (CategoryTheory.CategoryStruct.comp V.hom (τ j₁.down).hom) =
              CategoryTheory.CategoryStruct.comp q₁.left
                (CategoryTheory.CategoryStruct.comp V.hom (τ j₂.down).hom) := by
            have h2 : CategoryTheory.CategoryStruct.comp
                (CategoryTheory.CategoryStruct.comp q₁.left (ι V j₁.down).left)
                (CategoryTheory.Limits.pullback.snd (M_u.obj V).hom u) =
                CategoryTheory.CategoryStruct.comp
                  (CategoryTheory.CategoryStruct.comp q₂.left (ι V j₂.down).left)
                  (CategoryTheory.Limits.pullback.snd (M_u.obj V).hom u) :=
              congrArg (fun m => CategoryTheory.CategoryStruct.comp m.left
                (CategoryTheory.Limits.pullback.snd (M_u.obj V).hom u)) hq
            have hS := (CategoryTheory.Category.assoc q₁.left (ι V j₁.down).left _).symm.trans
              (h2.trans (CategoryTheory.Category.assoc q₂.left (ι V j₂.down).left _))
            rw [hι_snd V j₁.down, hι_snd V j₂.down, ← hq_left] at hS
            exact hS
          let ξ_w := W.left.fromSpecResidueField w₀
          have hξ_eq : CategoryTheory.CategoryStruct.comp
              (CategoryTheory.CategoryStruct.comp ξ_w (CategoryTheory.CategoryStruct.comp q₁.left V.hom))
              (τ j₁.down).hom =
              CategoryTheory.CategoryStruct.comp
                (CategoryTheory.CategoryStruct.comp ξ_w (CategoryTheory.CategoryStruct.comp q₁.left V.hom))
                (τ j₂.down).hom := by
            have ha₁ : CategoryTheory.CategoryStruct.comp
                (CategoryTheory.CategoryStruct.comp q₁.left V.hom) (τ j₁.down).hom =
                CategoryTheory.CategoryStruct.comp q₁.left
                  (CategoryTheory.CategoryStruct.comp V.hom (τ j₁.down).hom) :=
              CategoryTheory.Category.assoc q₁.left V.hom (τ j₁.down).hom
            have ha₂ : CategoryTheory.CategoryStruct.comp
                (CategoryTheory.CategoryStruct.comp q₁.left V.hom) (τ j₂.down).hom =
                CategoryTheory.CategoryStruct.comp q₁.left
                  (CategoryTheory.CategoryStruct.comp V.hom (τ j₂.down).hom) :=
              CategoryTheory.Category.assoc q₁.left V.hom (τ j₂.down).hom
            exact (CategoryTheory.Category.assoc ξ_w _ _).trans
              ((congrArg (CategoryTheory.CategoryStruct.comp ξ_w)
                (ha₁.trans (hsnd.trans ha₂.symm))).trans
                (CategoryTheory.Category.assoc ξ_w _ _).symm)
          have hpre := congrArg AlgebraicGeometry.Spec.preimage hξ_eq
          rw [AlgebraicGeometry.Spec.preimage_comp, AlgebraicGeometry.Spec.preimage_comp,
            AlgebraicGeometry.Spec.preimage_map, AlgebraicGeometry.Spec.preimage_map] at hpre
          let ψ : K →+* ↑(W.left.residueField w₀) :=
            (AlgebraicGeometry.Spec.preimage
              (CategoryTheory.CategoryStruct.comp ξ_w
                (CategoryTheory.CategoryStruct.comp q₁.left V.hom))).hom
          have hψ_comp : ψ.comp (σ j₁.down).toRingHom = ψ.comp (σ j₂.down).toRingHom :=
            congrArg CommRingCat.Hom.hom hpre
          have hr_eq : ψ (r_E j₁.down) = ψ (r_E j₂.down) := by
            have hroot : ψ ((σ j₁.down) (AdjoinRoot.root g)) =
                ψ ((σ j₂.down) (AdjoinRoot.root g)) :=
              DFunLike.congr_fun hψ_comp (AdjoinRoot.root g)
            rwa [hσ_root j₁.down, hσ_root j₂.down] at hroot
          exact hr_dist hne (ψ.injective hr_eq)
        haveI : Subsingleton ↥(𝒢.obj.obj (Opposite.op W)) := hSubEmpty 𝒢 W hEmp
        change (_ : Aℤ ⟶ 𝒢.obj.obj (Opposite.op W)) = _
        ext z
        exact Subsingleton.elim _ _
    let π_fan : ∀ (𝒢 : CategoryTheory.Sheaf S_K.smallEtaleTopology AddCommGrpCat.{u})
        (j : ULift.{u} (Fin d)), M_pull.obj (u_push.obj 𝒢) ⟶ (T_τ j.down).obj 𝒢 := fun 𝒢 j =>
      { hom :=
          { app := fun V => 𝒢.obj.map (ι V.unop j.down).op
            naturality := fun {V₁ V₂} f => by
              rcases V₁ with ⟨V₁⟩; rcases V₂ with ⟨V₂⟩; rcases f with ⟨f⟩
              change CategoryTheory.CategoryStruct.comp
                  (𝒢.obj.map (B_u.map (M_u.map f)).op)
                  (𝒢.obj.map (ι V₂ j.down).op) =
                CategoryTheory.CategoryStruct.comp (𝒢.obj.map (ι V₁ j.down).op)
                  (𝒢.obj.map ((M_τ j.down).map f).op)
              rw [← 𝒢.obj.map_comp, ← 𝒢.obj.map_comp, ← op_comp, ← op_comp,
                hι_nat f j.down] } }
    have hUniqueSec : ∀ (𝒢 : CategoryTheory.Sheaf S_K.smallEtaleTopology AddCommGrpCat.{u})
        (V : S_K.Etale)
        (x : ∀ j : ULift.{u} (Fin d), 𝒢.obj.obj (Opposite.op ((M_τ j.down).obj V))),
        ∃! t : 𝒢.obj.obj (Opposite.op (B_u.obj (M_u.obj V))),
          ∀ j : ULift.{u} (Fin d), 𝒢.obj.map (ι V j.down).op t = x j := by
      intro 𝒢 V x
      have hShV := (CategoryTheory.Presieve.isSheafFor_arrows_iff
        (𝒢.obj ⋙ CategoryTheory.coyoneda.obj (Opposite.op Aℤ))
        (fun j : ULift.{u} (Fin d) => ι V j.down)).mp
        ((𝒢.cond Aℤ).isSheafFor _ (hCovV V))
      obtain ⟨ψ, hψ, hψ_uniq⟩ := hShV (fun j => zHom _ (x j))
        (hCompatAll 𝒢 V (fun j => zHom _ (x j)))
      let ψ_hom : Aℤ ⟶ 𝒢.obj.obj (Opposite.op (B_u.obj (M_u.obj V))) := ψ
      refine ⟨ψ_hom (ULift.up 1), fun j => ?_, fun t' ht' => ?_⟩
      · have hj : 𝒢.obj.map (ι V j.down).op (ψ_hom (ULift.up 1)) = zHom _ (x j) (ULift.up 1) :=
          congrArg (fun φ : Aℤ ⟶ _ => φ (ULift.up 1)) (hψ j)
        exact hj.trans (hzHom_eval _ (x j))
      · have ht'_hom : zHom _ t' = ψ_hom := by
          refine hψ_uniq (zHom _ t') (fun j => ?_)
          change CategoryTheory.CategoryStruct.comp (zHom _ t') (𝒢.obj.map (ι V j.down).op) =
            zHom _ (x j)
          rw [hzHom_comp, ht' j]
        have heval := congrArg (fun φ : Aℤ ⟶ _ => φ (ULift.up 1)) ht'_hom
        exact (hzHom_eval _ t').symm.trans heval
    have hIsLim : ∀ 𝒢 : CategoryTheory.Sheaf S_K.smallEtaleTopology AddCommGrpCat.{u},
        CategoryTheory.Limits.IsLimit
          (CategoryTheory.Limits.Fan.mk (M_pull.obj (u_push.obj 𝒢)) (π_fan 𝒢)) := by
      intro 𝒢
      refine CategoryTheory.Limits.mkFanLimit
        (CategoryTheory.Limits.Fan.mk (M_pull.obj (u_push.obj 𝒢)) (π_fan 𝒢))
        (fun s =>
          { hom :=
              { app := fun V =>
                  AddCommGrpCat.ofHom
                    { toFun := fun y =>
                        Classical.choose (hUniqueSec 𝒢 V.unop
                          (fun j => ((s.proj j).hom.app V) y))
                      map_zero' := by
                        apply (hUniqueSec 𝒢 V.unop _).unique
                        · exact (Classical.choose_spec (hUniqueSec 𝒢 V.unop _)).1
                        · intro j
                          simp only [map_zero]
                          rfl
                      map_add' := fun y₁ y₂ => by
                        apply (hUniqueSec 𝒢 V.unop _).unique
                        · exact (Classical.choose_spec (hUniqueSec 𝒢 V.unop _)).1
                        · intro j
                          have h₁ := (Classical.choose_spec
                            (hUniqueSec 𝒢 V.unop (fun k => ((s.proj k).hom.app V) y₁))).1 j
                          have h₂ := (Classical.choose_spec
                            (hUniqueSec 𝒢 V.unop (fun k => ((s.proj k).hom.app V) y₂))).1 j
                          simp only [map_add, h₁, h₂]
                          rfl }
                naturality := fun {V₁ V₂} f => by
                  rcases V₁ with ⟨V₁⟩; rcases V₂ with ⟨V₂⟩; rcases f with ⟨f⟩
                  ext y
                  apply (hUniqueSec 𝒢 V₂ _).unique
                  · exact (Classical.choose_spec (hUniqueSec 𝒢 V₂ _)).1
                  · intro j
                    let t₁ := Classical.choose
                      (hUniqueSec 𝒢 V₁ (fun k => ((s.proj k).hom.app (Opposite.op V₁)) y))
                    have h₁ : 𝒢.obj.map (ι V₁ j.down).op t₁ =
                        ((s.proj j).hom.app (Opposite.op V₁)) y :=
                      (Classical.choose_spec
                        (hUniqueSec 𝒢 V₁ (fun k => ((s.proj k).hom.app (Opposite.op V₁)) y))).1 j
                    have hmap_eq : CategoryTheory.CategoryStruct.comp
                        (𝒢.obj.map (B_u.map (M_u.map f)).op)
                        (𝒢.obj.map (ι V₂ j.down).op) =
                        CategoryTheory.CategoryStruct.comp
                          (𝒢.obj.map (ι V₁ j.down).op)
                          (((T_τ j.down).obj 𝒢).obj.map f.op) :=
                      (𝒢.obj.map_comp _ _).symm.trans
                        ((congrArg (fun k => 𝒢.obj.map k.op) (hι_nat f j.down).symm).trans
                          (𝒢.obj.map_comp _ _))
                    change (CategoryTheory.CategoryStruct.comp
                        (𝒢.obj.map (B_u.map (M_u.map f)).op)
                        (𝒢.obj.map (ι V₂ j.down).op)) t₁ =
                      (CategoryTheory.CategoryStruct.comp (s.pt.obj.map f.op)
                        ((s.proj j).hom.app (Opposite.op V₂))) y
                    exact (congrArg (fun φ => φ t₁) hmap_eq).trans
                      ((congrArg (((T_τ j.down).obj 𝒢).obj.map f.op) h₁).trans
                        (congrArg (fun φ => φ y) ((s.proj j).hom.naturality f.op).symm)) } })
        (fun s j => by
          apply hSheafExt
          intro V
          ext y
          exact (Classical.choose_spec
            (hUniqueSec 𝒢 V (fun k => ((s.proj k).hom.app (Opposite.op V)) y))).1 j)
        (fun s m hm => by
          apply hSheafExt
          intro V
          ext y
          apply (hUniqueSec 𝒢 V (fun k => ((s.proj k).hom.app (Opposite.op V)) y)).unique
          · intro j
            have hmj := congrArg (fun q => (q.hom.app (Opposite.op V)) y) (hm j)
            exact hmj
