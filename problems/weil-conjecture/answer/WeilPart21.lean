        (κ_lan (G_K.op ⋙ 𝒢.obj) M₀ hFD₀ A₀ M hFD hle)
  refine ⟨ι_model, ?_, ?_, ?_, ?_⟩
  · intro 𝒢₁ 𝒢₂ φ M₀ hFD₀ A₀ _ _ _ M hFD hle hEtSpec F_M W_M x
    let Y_L := mkY_L M₀ A₀
