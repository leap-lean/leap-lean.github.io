          ⦃f₁ : V₁ ⟶ U⦄ ⦃f₂ : V₂ ⟶ U⦄ (hf₁ : (S_lvl U g).arrows f₁) (hf₂ : (S_lvl U g).arrows f₂),
          g₁ ≫ f₁ = g₂ ≫ f₂ →
          ((C.obj AM).obj.map g₁.op).hom (σ f₁ hf₁) =
            ((C.obj AM).obj.map g₂.op).hom (σ f₂ hf₂) := by
        intro V₁ V₂ W g₁ g₂ f₁ f₂ hf₁ hf₂ hcomm
        dsimp [σ]
        rw [hη_nat_apply g₁, hη_nat_apply g₂]
        have ha₁ : ∀ z : ↥W.left, g ((g₁ ≫ f₁).left z) = Classical.choose hf₁ := by
          intro z
          change g ((g₁.left ≫ f₁.left) z) = _
          rw [AlgebraicGeometry.Scheme.Hom.comp_apply]
