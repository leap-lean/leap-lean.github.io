                ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ pb_f _ _ _ _ _
                  Fℤ_S (pf_f.obj G) q) z)
                (Nat.zero_add q))))
          (Nat.zero_add q) := by
    intro G q z z_bc
    let e_pf₁ := CategoryTheory.Functor.sheafPushforwardContinuousIso e_B₁
