    have hc : ∀ a : SimplexCategory, CategoryTheory.Limits.IsLimit (c a) := by
      intro a
      let mkLift : ∀ (s : CategoryTheory.Limits.Cone
          (CategoryTheory.Limits.WidePullbackShape.wideCospan U_K
            (fun _ : Fin (a.len + 1) => W_K) (fun _ : Fin (a.len + 1) => f_K))),
          { l : s.pt ⟶ X a.len // ∀ i : Fin (a.len + 1),
