      m • CategoryTheory.CategoryStruct.id (weilEtaleTorsionSheaf S m) = 0 := by
    intro S m
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
    have hAM : m • CategoryTheory.CategoryStruct.id AM = 0 := by
      ext ⟨x⟩
      change ULift.up (m • x) = ULift.up 0
