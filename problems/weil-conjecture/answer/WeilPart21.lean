          (IntermediateField.inclusion hle α_init_el * algebraMap P ↥E_fin h_S)
        = IntermediateField.inclusion hle α_init_el *
            (algebraMap P ↥E_fin h_S * ι_fin (↑(hu_hS.unit⁻¹) : P_fin)) := by ring
      _ = IntermediateField.inclusion hle α_init_el * 1 := by rw [hunit_mul]
      _ = IntermediateField.inclusion hle α_init_el := mul_one _

  let inc_P : ↥E_init →ₐ[P] ↥E_fin :=
    { (IntermediateField.inclusion hle).toRingHom with
      commutes' := fun h => by
        change IntermediateField.inclusion hle (algebraMap F₀ ↥E_init (algebraMap P F₀ h)) =
          algebraMap F₀ ↥E_fin (algebraMap P F₀ h)
        exact (IntermediateField.inclusion hle).commutes (algebraMap P F₀ h) }

  have hMap_x_init : pair_init.HasMap x_init := by
    refine ⟨?_, ?_⟩
    · apply hInj_ι_fin
      rw [map_zero, ← Polynomial.aeval_algHom_apply ι_fin x_init pair_init.f,
