      (π_fst c).base ((F₀.map g).left.base z') =
        (G_K.map g).left.base ((π_fst d).base z') := by
    intro d c g z'
    have hcomm : (F₀.map g).left ≫ π_fst c = π_fst d ≫ (G_K.map g).left :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    exact congrArg (fun m : (F₀.obj d).left ⟶ (G_K.obj c).left => m.base z') hcomm
  let K_aff := G_K.inducedTopology J_K
  have hTopEq : F₀.inducedTopology J_K' = K_aff := by
    ext c S
    rw [← CategoryTheory.Functor.IsDenseSubsite.functorPushforward_mem_iff (G := F₀) (K := J_K'),
      ← CategoryTheory.Functor.IsDenseSubsite.functorPushforward_mem_iff (G := G_K) (K := J_K),
      hMemSmallEt, hMemSmallEt]
    constructor
    · intro hF' x
      obtain ⟨x', rfl⟩ := (hπ_bij c).2 x
      obtain ⟨Y', f', y', hf', hy'⟩ := hF' x'
      rcases hf' with ⟨d, g, u', hgS, rfl⟩
      refine ⟨G_K.obj d, G_K.map g, (π_fst d).base (u'.left.base y'),
        ⟨d, g, 𝟙 (G_K.obj d), hgS, (CategoryTheory.Category.id_comp _).symm⟩, ?_⟩
      rw [← hπ_nat g (u'.left.base y')]
      congr 1
    · intro hG x'
      obtain ⟨Y, f, y, hf, hy⟩ := hG ((π_fst c).base x')
      rcases hf with ⟨d, g, u, hgS, rfl⟩
      obtain ⟨z', hz'⟩ := (hπ_bij d).2 (u.left.base y)
      refine ⟨F₀.obj d, F₀.map g, z',
        ⟨d, g, 𝟙 (F₀.obj d), hgS, (CategoryTheory.Category.id_comp _).symm⟩, ?_⟩
      apply (hπ_bij c).1
      rw [hπ_nat g z', hz']
      exact hy
  have : CategoryTheory.Functor.IsDenseSubsite K_aff J_K G_K := inferInstance
  have : CategoryTheory.Functor.IsDenseSubsite K_aff J_K' F₀ := by
    rw [← hTopEq]
    exact inferInstance
  let E_K := G_K.sheafPushforwardContinuous AddCommGrpCat.{u} K_aff J_K
  let E_K' := F₀.sheafPushforwardContinuous AddCommGrpCat.{u} K_aff J_K'
  have : E_K.IsEquivalence := inferInstance
  have : E_K'.IsEquivalence := inferInstance

  
  let e_EK := E_K.asEquivalence
  let e_EK' := E_K'.asEquivalence
  let Φ : CategoryTheory.Sheaf J_K AddCommGrpCat.{u} ⥤
      CategoryTheory.Sheaf J_K' AddCommGrpCat.{u} :=
    E_K.comp e_EK'.inverse
  have : Φ.IsEquivalence := inferInstance
  have : CategoryTheory.Limits.PreservesFiniteLimits Φ := inferInstance
  have : CategoryTheory.Limits.PreservesFiniteColimits Φ := inferInstance
  have : CategoryTheory.Limits.PreservesBinaryBiproducts Φ :=
    CategoryTheory.Limits.preservesBinaryBiproducts_of_preservesBinaryProducts Φ
  have : Φ.Additive := CategoryTheory.Functor.additive_of_preservesBinaryBiproducts Φ
  
  let e_unitK : K ≃ₐ[K] (PUnit.{u + 1} → K) :=
    { toFun := fun e _ => e
      invFun := fun f => f PUnit.unit
      left_inv := fun _ => rfl
      right_inv := fun f => funext fun ⟨⟩ => rfl
      map_mul' := fun _ _ => rfl
      map_add' := fun _ _ => rfl
      commutes' := fun _ => rfl }
  have : Algebra.Etale K K :=
    (Algebra.Etale.iff_exists_algEquiv_prod K K).mpr
      ⟨PUnit.{u + 1}, inferInstance, fun _ => K, fun _ => inferInstance,
       fun _ => inferInstance, e_unitK, fun _ => ⟨inferInstance, inferInstance⟩⟩
  obtain ⟨n₀, g₀_t, hg₀_t, ⟨e_t₀_tens⟩⟩ := hAlgDesc K K K
  let t₀ : D_K := ⟨n₀, fun i => ⟨g₀_t i, hg₀_t i⟩⟩
  let e_t₀ : A_K t₀ ≃ₐ[K] K :=
    (Algebra.TensorProduct.lid K (A_K t₀)).symm.trans e_t₀_tens
  let iso_tK_left : (G_K.obj t₀).left ≅ S_K :=
    { hom := (G_K.obj t₀).hom
      inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_t₀.toRingHom)
      hom_inv_id := by
        change AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K (A_K t₀))) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_t₀.toRingHom) = _
        rw [← AlgebraicGeometry.Spec.map_comp]
        have hring : CommRingCat.ofHom e_t₀.toRingHom ≫
            CommRingCat.ofHom (algebraMap K (A_K t₀)) = 𝟙 (CommRingCat.of (A_K t₀)) := by
          apply CommRingCat.hom_ext
          apply RingHom.ext
          intro x
          change algebraMap K (A_K t₀) (e_t₀ x) = x
          simpa using (e_t₀.symm.commutes (e_t₀ x)).symm
        rw [hring, AlgebraicGeometry.Spec.map_id]
        rfl
      inv_hom_id := by
        change AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_t₀.toRingHom) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K (A_K t₀))) = _
        rw [← AlgebraicGeometry.Spec.map_comp]
        have hring : CommRingCat.ofHom (algebraMap K (A_K t₀)) ≫
            CommRingCat.ofHom e_t₀.toRingHom = 𝟙 (CommRingCat.of K) := by
          apply CommRingCat.hom_ext
          apply RingHom.ext
          intro c
          exact e_t₀.commutes c
        rw [hring, AlgebraicGeometry.Spec.map_id] }
  let iso_tK : G_K.obj t₀ ≅ weilEtaleIdTerminal.{u} S_K :=
    CategoryTheory.MorphismProperty.Over.isoMk iso_tK_left
      (CategoryTheory.Category.comp_id _)
  let hT_K : CategoryTheory.Limits.IsTerminal (G_K.obj t₀) :=
    CategoryTheory.Limits.IsTerminal.ofIso (weilEtaleIdTerminalIsTerminal.{u} S_K) iso_tK.symm
  let hT_D : CategoryTheory.Limits.IsTerminal t₀ :=
    CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun d => CategoryTheory.InducedCategory.homMk (hT_K.from (G_K.obj d)))
      (fun d m => CategoryTheory.InducedCategory.hom_ext (hT_K.hom_ext m.hom _))
  let p_snd_id : (B_h.obj (weilEtaleIdTerminal.{u} S_K)).left ⟶ S_K' :=
    CategoryTheory.Limits.pullback.snd (CategoryTheory.CategoryStruct.id S_K) h
  have hp_snd_id : CategoryTheory.IsIso p_snd_id :=
    CategoryTheory.Limits.pullback_snd_iso_of_left_iso (CategoryTheory.CategoryStruct.id S_K) h
  let iso_pb_id : B_h.obj (weilEtaleIdTerminal.{u} S_K) ≅ weilEtaleIdTerminal.{u} S_K' :=
    CategoryTheory.MorphismProperty.Over.isoMk (@CategoryTheory.asIso _ _ _ _ p_snd_id hp_snd_id)
      (CategoryTheory.Category.comp_id p_snd_id)
  let iso_tK' : F₀.obj t₀ ≅ weilEtaleIdTerminal.{u} S_K' :=
    (B_h.mapIso iso_tK).trans iso_pb_id
  let hT_K' : CategoryTheory.Limits.IsTerminal (F₀.obj t₀) :=
    CategoryTheory.Limits.IsTerminal.ofIso (weilEtaleIdTerminalIsTerminal.{u} S_K') iso_tK'.symm
  
  let C_K := CategoryTheory.constantSheaf J_K AddCommGrpCat.{u}
  let C_K' := CategoryTheory.constantSheaf J_K' AddCommGrpCat.{u}
  let C_D := CategoryTheory.constantSheaf K_aff AddCommGrpCat.{u}
  let Γ_K := (CategoryTheory.sheafSections J_K AddCommGrpCat.{u}).obj (Opposite.op (G_K.obj t₀))
  let Γ_K' := (CategoryTheory.sheafSections J_K' AddCommGrpCat.{u}).obj (Opposite.op (F₀.obj t₀))
  let Γ_D := (CategoryTheory.sheafSections K_aff AddCommGrpCat.{u}).obj (Opposite.op t₀)
  let adj_K := CategoryTheory.constantSheafAdj J_K AddCommGrpCat.{u} hT_K
  let adj_K' := CategoryTheory.constantSheafAdj J_K' AddCommGrpCat.{u} hT_K'
  let adj_D := CategoryTheory.constantSheafAdj K_aff AddCommGrpCat.{u} hT_D
  let θ_K : Γ_K ≅ E_K.comp Γ_D :=
    CategoryTheory.NatIso.ofComponents (fun _ => Iso.refl _)
      (fun _ => (CategoryTheory.Category.comp_id _).trans (CategoryTheory.Category.id_comp _).symm)
  let θ_K' : Γ_K' ≅ E_K'.comp Γ_D :=
    CategoryTheory.NatIso.ofComponents (fun _ => Iso.refl _)
      (fun _ => (CategoryTheory.Category.comp_id _).trans (CategoryTheory.Category.id_comp _).symm)
  let iso_CK : C_D.comp e_EK.inverse ≅ C_K :=
    (adj_D.comp e_EK.symm.toAdjunction).leftAdjointUniq (adj_K.ofNatIsoRight θ_K)
  let iso_CK' : C_D.comp e_EK'.inverse ≅ C_K' :=
    (adj_D.comp e_EK'.symm.toAdjunction).leftAdjointUniq (adj_K'.ofNatIsoRight θ_K')
  let isoConst : ∀ A : AddCommGrpCat.{u}, Φ.obj (C_K.obj A) ≅ C_K'.obj A := fun A =>
    (e_EK'.inverse.mapIso
      ((E_K.mapIso (iso_CK.symm.app A)).trans (e_EK.counitIso.app (C_D.obj A)))).trans
      (iso_CK'.app A)
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
  let eℤ := isoConst Aℤ
  let eM := isoConst AM
  refine subsingleton_of_forall_eq 0 (fun x => ?_)
  let y : weilEtaleTorsionH S_K' m s :=
    ((CategoryTheory.Abelian.Ext.mk₀ eℤ.inv).comp
      ((Φ.mapExtAddHom (C_K.obj Aℤ) (C_K.obj AM) s) x) (Nat.zero_add s)).comp
      (CategoryTheory.Abelian.Ext.mk₀ eM.hom) (Nat.add_zero s)
  have hy0 : y = 0 := @Subsingleton.elim _ hSub y 0
  have h1 := congrArg
    (fun w => w.comp (CategoryTheory.Abelian.Ext.mk₀ eM.inv) (Nat.add_zero s)) hy0
  simp only [CategoryTheory.Abelian.Ext.zero_comp] at h1
  dsimp only [y] at h1
  rw [CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero s) (Nat.add_zero 0) (by omega),
    CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, eM.hom_inv_id,
    CategoryTheory.Abelian.Ext.comp_mk₀_id] at h1
  have h2 := congrArg
    (fun w => (CategoryTheory.Abelian.Ext.mk₀ eℤ.hom).comp w (Nat.zero_add s)) h1
  simp only [CategoryTheory.Abelian.Ext.comp_zero] at h2
  rw [← CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ eℤ.hom)
    (CategoryTheory.Abelian.Ext.mk₀ eℤ.inv) _ (Nat.zero_add 0) (Nat.zero_add s) (by omega),
    CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, eℤ.hom_inv_id,
    CategoryTheory.Abelian.Ext.mk₀_id_comp] at h2
  apply hExtInj Φ (C_K.obj Aℤ) (C_K.obj AM) s
  rw [h2, map_zero]

theorem weil_alt_cd_insep_upgrade_and_subfield_colimit : (∀ (L : Type u) [Field L] (𝒟 : Set (Subfield L)),
      𝒟.Nonempty → DirectedOn (· ≤ ·) 𝒟 → (∀ x : L, ∃ E ∈ 𝒟, x ∈ E) →
      ∀ (m q : ℕ) (E₀ : Subfield L), E₀ ∈ 𝒟 →
        Subsingleton (weilEtaleTorsionH (AlgebraicGeometry.Spec (CommRingCat.of L)) m q) →
        ∀ (ξ : weilEtaleTorsionH (AlgebraicGeometry.Spec (CommRingCat.of ↥E₀)) m q),
          ∃ (E₁ : Subfield L) (hE₁ : E₁ ∈ 𝒟) (hle : E₀ ≤ E₁),
            ∀ (p : weilEtaleTorsionH (AlgebraicGeometry.Spec (CommRingCat.of ↥E₀)) m q →+
                weilEtaleTorsionH (AlgebraicGeometry.Spec (CommRingCat.of ↥E₁)) m q),
              WeilIsTorsionEtalePullback
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Subfield.inclusion hle))) m q p →
              p ξ = 0) ∧
    (∀ (e ℓ s : ℕ) [Fact (Nat.Prime ℓ)],
      (∀ (κ_alg F : Type u) [Field κ_alg] [IsAlgClosed κ_alg] [Field F] [Algebra κ_alg F],
        (ℓ : κ_alg) ≠ 0 →
        (∃ S : Finset F, IntermediateField.adjoin κ_alg (S : Set F) = ⊤) →
        Algebra.trdeg κ_alg F ≤ (e : Cardinal.{u}) →
        Subsingleton (weilEtaleTorsionH (AlgebraicGeometry.Spec (CommRingCat.of F)) ℓ s)) →
      ∀ (κ K : Type u) [Field κ] [IsSepClosed κ] [Field K] [Algebra κ K],
        (ℓ : κ) ≠ 0 →
        Algebra.trdeg κ K ≤ (e : Cardinal.{u}) →
        Subsingleton (weilEtaleTorsionH (AlgebraicGeometry.Spec (CommRingCat.of K)) ℓ s)) :=
by
  obtain ⟨hPullEx, hPullId, hPullComp, _, _⟩ :=
    weil_etale_torsion_pullback_functoriality.{u}
  have hColim : ∀ q : ℕ, WeilSubfieldSheafColimitAt.{u} q := by
    intro q
    induction q with
    | zero => exact weil_alt_cd_subfield_colimit_deg_zero.{u}
    | succ q ih => exact weil_alt_cd_subfield_colimit_succ_step.{u} q ih
  have hPostInv : ∀ {𝒞 : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} 𝒞]
      [CategoryTheory.Abelian 𝒞] [CategoryTheory.HasExt.{u} 𝒞]
      {X Y Z : 𝒞} (f : Quiver.Hom Y Z) (g : Quiver.Hom Z Y) (q : ℕ),
      CategoryTheory.CategoryStruct.comp f g = CategoryTheory.CategoryStruct.id Y →
      ∀ y : CategoryTheory.Abelian.Ext.{u} X Y q,
        ((CategoryTheory.Abelian.Ext.mk₀ g).postcomp X (Nat.add_zero q))
          (((CategoryTheory.Abelian.Ext.mk₀ f).postcomp X (Nat.add_zero q)) y) = y := by
    intro 𝒞 _ _ _ X Y Z f g q hfg y
    change (y.comp (CategoryTheory.Abelian.Ext.mk₀ f) (Nat.add_zero q)).comp
      (CategoryTheory.Abelian.Ext.mk₀ g) (Nat.add_zero q) = y
    rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hfg,
      CategoryTheory.Abelian.Ext.comp_mk₀_id]
  have hPullUniq : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (h : S₁ ⟶ S₂) (m q : ℕ)
      (p p' : weilEtaleTorsionH S₂ m q →+ weilEtaleTorsionH S₁ m q),
      WeilIsTorsionEtalePullback h m q p →
      WeilIsTorsionEtalePullback h m q p' →
      p' = p := by
    intro S₁ S₂ h m q p p' hp hp'
    obtain ⟨pid, hpid⟩ := hPullEx (CategoryTheory.CategoryStruct.id S₁) m q
    have hpid_eq : pid = AddMonoidHom.id _ := hPullId m q pid hpid
    have hp'_comp : WeilIsTorsionEtalePullback
        (CategoryTheory.CategoryStruct.comp (CategoryTheory.CategoryStruct.id S₁) h) m q p' := by
      rwa [CategoryTheory.Category.id_comp]
    have heq := hPullComp (CategoryTheory.CategoryStruct.id S₁) h m q pid p p' hpid hp hp'_comp
    rw [heq, hpid_eq, AddMonoidHom.id_comp]
  have hConstIso : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom S₁ S₂)
      [_hCont : (weilAltCdSitePullback h).IsContinuous S₂.smallEtaleTopology S₁.smallEtaleTopology]
      [_hAdj : ((weilAltCdSitePullback h).sheafPushforwardContinuous
        AddCommGrpCat.{u} S₂.smallEtaleTopology S₁.smallEtaleTopology).IsRightAdjoint]
      (T₁ : S₁.Etale) (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
      (T₂ : S₂.Etale) (hT₂ : CategoryTheory.Limits.IsTerminal T₂)
      (A : AddCommGrpCat.{u}),
      let B := weilAltCdSitePullback h
      let J₁ := S₁.smallEtaleTopology
      let J₂ := S₂.smallEtaleTopology
      let C₁ := CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}
      let C₂ := CategoryTheory.constantSheaf J₂ AddCommGrpCat.{u}
      let P_push := B.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
      let P_pull := B.sheafPullback AddCommGrpCat.{u} J₂ J₁
      let adj_pull := B.sheafAdjunctionContinuous AddCommGrpCat.{u} J₂ J₁
      let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
      let adj₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
      let τ : Quiver.Hom (B.obj T₂) T₁ := hT₁.from (B.obj T₂)
      let πA : Quiver.Hom (P_pull.obj (C₂.obj A)) (C₁.obj A) :=
        (adj_pull.homEquiv (C₂.obj A) (C₁.obj A)).symm
          ((adj₂.homEquiv A (P_push.obj (C₁.obj A))).symm
            (CategoryTheory.CategoryStruct.comp (adj₁.unit.app A)
              ((C₁.obj A).obj.map τ.op)))
      ∃ (ιA : Quiver.Hom (C₁.obj A) (P_pull.obj (C₂.obj A))),
        CategoryTheory.CategoryStruct.comp ιA πA = CategoryTheory.CategoryStruct.id (C₁.obj A) ∧
        CategoryTheory.CategoryStruct.comp πA ιA =
          CategoryTheory.CategoryStruct.id (P_pull.obj (C₂.obj A)) := by
    intro S₁ S₂ h _hCont _hAdj T₁ hT₁ T₂ hT₂ A
    let B := weilAltCdSitePullback h
    let J₁ := S₁.smallEtaleTopology
    let J₂ := S₂.smallEtaleTopology
    let C₁ := CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}
    let C₂ := CategoryTheory.constantSheaf J₂ AddCommGrpCat.{u}
    let P_push := B.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
    let P_pull := B.sheafPullback AddCommGrpCat.{u} J₂ J₁
    let adj_pull := B.sheafAdjunctionContinuous AddCommGrpCat.{u} J₂ J₁
    let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
    let adj₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
    let τ : Quiver.Hom (B.obj T₂) T₁ := hT₁.from (B.obj T₂)
    let Tid₁ := weilEtaleIdTerminal.{u} S₁
    let hTid₁ := weilEtaleIdTerminalIsTerminal.{u} S₁
    let Tid₂ := weilEtaleIdTerminal.{u} S₂
    let hTid₂ := weilEtaleIdTerminalIsTerminal.{u} S₂
    let e₂ : T₂ ≅ Tid₂ := hT₂.uniqueUpToIso hTid₂
    let p_snd : Quiver.Hom (B.obj Tid₂).left S₁ :=
      CategoryTheory.Limits.pullback.snd (CategoryTheory.CategoryStruct.id S₂) h
    have hp_snd : CategoryTheory.IsIso p_snd :=
      CategoryTheory.Limits.pullback_snd_iso_of_left_iso (CategoryTheory.CategoryStruct.id S₂) h
    let e_pb : B.obj Tid₂ ≅ Tid₁ :=
      CategoryTheory.MorphismProperty.Over.isoMk (@CategoryTheory.asIso _ _ _ _ p_snd hp_snd)
        (CategoryTheory.Category.comp_id p_snd)
    let e₁ : Tid₁ ≅ T₁ := hTid₁.uniqueUpToIso hT₁
    let e_τ : B.obj T₂ ≅ T₁ := (B.mapIso e₂).trans (e_pb.trans e₁)
    have hτ_eq : τ = e_τ.hom := hT₁.hom_ext τ e_τ.hom
    let Γ₁ := (CategoryTheory.sheafSections J₁ AddCommGrpCat.{u}).obj (Opposite.op T₁)
    let Γ₂ := (CategoryTheory.sheafSections J₂ AddCommGrpCat.{u}).obj (Opposite.op T₂)
    let θ : Γ₁ ≅ P_push.comp Γ₂ :=
      CategoryTheory.NatIso.ofComponents
        (fun ℱ =>
          { hom := ℱ.obj.map τ.op
            inv := ℱ.obj.map e_τ.inv.op
            hom_inv_id := by
              change CategoryTheory.CategoryStruct.comp (ℱ.obj.map τ.op) (ℱ.obj.map e_τ.inv.op) =
                CategoryTheory.CategoryStruct.id (ℱ.obj.obj (Opposite.op T₁))
              rw [← ℱ.obj.map_comp, ← op_comp, hτ_eq, e_τ.inv_hom_id, op_id, ℱ.obj.map_id]
            inv_hom_id := by
              change CategoryTheory.CategoryStruct.comp (ℱ.obj.map e_τ.inv.op) (ℱ.obj.map τ.op) =
                CategoryTheory.CategoryStruct.id (ℱ.obj.obj (Opposite.op (B.obj T₂)))
              rw [← ℱ.obj.map_comp, ← op_comp, hτ_eq, e_τ.hom_inv_id, op_id, ℱ.obj.map_id] })
        (fun {ℱ₁ ℱ₂} u => (u.hom.naturality τ.op).symm)
    let adjL := adj₂.comp adj_pull
    let adjR := adj₁.ofNatIsoRight θ
    let α_uniq := adjL.leftAdjointUniq adjR
    let πA : Quiver.Hom (P_pull.obj (C₂.obj A)) (C₁.obj A) :=
      (adj_pull.homEquiv (C₂.obj A) (C₁.obj A)).symm
        ((adj₂.homEquiv A (P_push.obj (C₁.obj A))).symm
          (CategoryTheory.CategoryStruct.comp (adj₁.unit.app A)
            ((C₁.obj A).obj.map τ.op)))
    have hAdjUniqEq : ∀ {C D E : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C]
        [CategoryTheory.Category.{u + 1, u + 1} D] [CategoryTheory.Category.{u + 1, u + 1} E]
        {F₁ : C ⥤ D} {G₁ : D ⥤ C} {F₂ : D ⥤ E} {G₂ : E ⥤ D}
        {F₃ : C ⥤ E} {G₃ : E ⥤ C}
        (a₁ : F₃ ⊣ G₃) (a₂ : F₁ ⊣ G₁) (ap : F₂ ⊣ G₂)
        (θ₀ : G₃ ≅ G₂.comp G₁) (X₀ : C),
        ((a₂.comp ap).leftAdjointUniq (a₁.ofNatIsoRight θ₀)).hom.app X₀ =
          (ap.homEquiv (F₁.obj X₀) (F₃.obj X₀)).symm
