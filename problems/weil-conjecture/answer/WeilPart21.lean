      let O : U.left.Opens := ⟨g ⁻¹' {g x}, g.isLocallyConstant {g x}⟩
      refine ⟨openSub U O, openSubHom U O, ⟨x, rfl⟩, ⟨g x, fun y => y.2⟩, ?_, rfl⟩
      change AlgebraicGeometry.Etale O.ι
