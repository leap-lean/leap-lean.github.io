        res_fst a b j (τ_B a hij x) = τ_C a b hij (res_fst a b i x)) →
      (∀ (a b : Fin m) {i j : I} (hij : i ≤ j) (x : G_B b i),
        res_snd a b j (τ_B b hij x) = τ_C a b hij (res_snd a b i x)) →
      (∀ {i j : I} (hij : i ≤ j) (z : G_A i), κ_A j (τ_A hij z) = κ_A i z) →
      (∀ (a : Fin m) {i j : I} (hij : i ≤ j) (x : G_B a i),
        κ_B a j (τ_B a hij x) = κ_B a i x) →
      (∀ (a : Fin m) (i : I) (z : G_A i), q_φ a (κ_A i z) = κ_B a i (res_φ a i z)) →
      (∀ (a b : Fin m) (i : I) (x : G_B a i),
        q_fst a b (κ_B a i x) = κ_C a b i (res_fst a b i x)) →
      (∀ (a b : Fin m) (i : I) (x : G_B b i),
        q_snd a b (κ_B b i x) = κ_C a b i (res_snd a b i x)) →
      (∀ s : Q_A, ∃ i : I, ∃ z : G_A i, κ_A i z = s) →
      (∀ (a : Fin m) (y : Q_B a), ∃ i : I, ∃ x : G_B a i, κ_B a i x = y) →
