  have hI_dim : CategoryTheory.HasInjectiveDimensionLT ℐ 1 := inferInstance
  have hξ_i : ξ.comp (CategoryTheory.Abelian.Ext.mk₀ i) (Nat.add_zero 1) = 0 :=
    (CategoryTheory.hasInjectiveDimensionLT_iff ℐ 1).mp hI_dim 1 (Nat.le_refl 1)
      (ξ.comp (CategoryTheory.Abelian.Ext.mk₀ i) (Nat.add_zero 1))
  obtain ⟨c, hc⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁
    (C_const.obj Aℤ) hSES ξ hξ_i (Nat.zero_add 1)
  let φ : C_const.obj Aℤ ⟶ 𝒬 := CategoryTheory.Abelian.Ext.addEquiv₀ c
  have hmk_φ : CategoryTheory.Abelian.Ext.mk₀ φ = c :=
    CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply c
  let φ₀ : Aℤ ⟶ 𝒬.obj.obj (Opposite.op T_F) := (adj.homEquiv Aℤ 𝒬) φ
  obtain ⟨y₀, hy₀⟩ := hGlobalSurj (φ₀.hom (ULift.up 1))
  let ψ₀ : Aℤ ⟶ ℐ.obj.obj (Opposite.op T_F) :=
    AddCommGrpCat.ofHom
      { toFun := fun n => n.down • y₀
        map_zero' := zero_zsmul y₀
        map_add' := fun a b => add_zsmul y₀ a.down b.down }
  have hψ₀_comp : ψ₀ ≫ ((CategoryTheory.sheafSections J AddCommGrpCat.{u}).obj (Opposite.op T_F)).map p = φ₀ := by
    ext ⟨n⟩
    have hn : (⟨n⟩ : ULift.{u} ℤ) = n • ULift.up (1 : ℤ) :=
      ULift.ext _ _ (mul_one n).symm
    change (p.hom.app (Opposite.op T_F)).hom (n • y₀) = φ₀.hom ⟨n⟩
    rw [hn, map_zsmul, map_zsmul, hy₀]
  let ψ : C_const.obj Aℤ ⟶ ℐ := (adj.homEquiv Aℤ ℐ).symm ψ₀
  have hψ_p : ψ ≫ p = φ := by
    calc
      ψ ≫ p = (adj.homEquiv Aℤ 𝒬).symm
          (ψ₀ ≫ ((CategoryTheory.sheafSections J AddCommGrpCat.{u}).obj (Opposite.op T_F)).map p) :=
        (adj.homEquiv_naturality_right_symm ψ₀ p).symm
      _ = (adj.homEquiv Aℤ 𝒬).symm φ₀ := by rw [hψ₀_comp]
      _ = φ := (adj.homEquiv Aℤ 𝒬).left_inv φ
  have hc_comp : c = (CategoryTheory.Abelian.Ext.mk₀ ψ).comp
      (CategoryTheory.Abelian.Ext.mk₀ p) (Nat.add_zero 0) := by
    rw [← hmk_φ, ← hψ_p, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
  rw [← hc, hc_comp,
    CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero 0) (Nat.zero_add 1) (Nat.zero_add 1),
    hSES.comp_extClass]
  exact CategoryTheory.Abelian.Ext.comp_zero _ Gm_F 1 1 (Nat.zero_add 1)

theorem weil_c1_affEt_sep_site_adjunction_and_continuity (E₁ E₂ : Type u) [Field E₁] [Field E₂] [Algebra E₁ E₂]
    [FiniteDimensional E₁ E₂] [Algebra.IsSeparable E₁ E₂] :
    (weilC1AffEtForgetSite E₁ E₂).IsContinuous (weilC1AffEtTop E₂) (weilC1AffEtTop E₁) ∧
    (weilC1AffEtBaseChangeSite E₁ E₂).IsContinuous (weilC1AffEtTop E₁) (weilC1AffEtTop E₂) ∧
    ∃ (adjSite : weilC1AffEtForgetSite E₁ E₂ ⊣ weilC1AffEtBaseChangeSite E₁ E₂),
      ∀ (U : (AlgebraicGeometry.Spec (CommRingCat.of E₁)).AffineEtale),
        letI : Algebra E₁ ↑U.left.unop := weilC1AffEtAlg E₁ U
        ((adjSite.counit.app U).left.unop).hom =
          (Algebra.TensorProduct.includeRight :
            ↑U.left.unop →ₐ[E₁] TensorProduct E₁ E₂ ↑U.left.unop).toRingHom :=
by
  have hArrowEtale : ∀ (F : Type u) [Field F]
      {Y U : (AlgebraicGeometry.Spec (CommRingCat.of F)).AffineEtale} (g : Y ⟶ U),
      AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map g.left.unop) ∧
      RingHom.Etale (g.left.unop).hom := by
    intro F _ Y U g
    have hEtU : AlgebraicGeometry.Etale U.hom := U.prop
    have hEtY : AlgebraicGeometry.Etale Y.hom := Y.prop
    have hComp : AlgebraicGeometry.Etale
        (CategoryTheory.CategoryStruct.comp (AlgebraicGeometry.Spec.map g.left.unop) U.hom) :=
      g.w.symm ▸ hEtY
    have hEtMap : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map g.left.unop) :=
      CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
        (AlgebraicGeometry.Spec.map g.left.unop) U.hom hEtU hComp
    exact ⟨hEtMap, (AlgebraicGeometry.HasRingHomProperty.Spec_iff
      (P := @AlgebraicGeometry.Etale)).mp hEtMap⟩

  have hTopMem : ∀ (F : Type u) [Field F]
      (U : (AlgebraicGeometry.Spec (CommRingCat.of F)).AffineEtale)
      (S : CategoryTheory.Sieve U),
      S ∈ weilC1AffEtTop F U ↔
        ∀ p : PrimeSpectrum ↑U.left.unop,
          ∃ (Y : (AlgebraicGeometry.Spec (CommRingCat.of F)).AffineEtale)
            (g : Y ⟶ U) (q : PrimeSpectrum ↑Y.left.unop),
            S.arrows g ∧ PrimeSpectrum.comap (g.left.unop).hom q = p := by
    intro F _ U S
    let S_F := AlgebraicGeometry.Spec (CommRingCat.of F)
    let Φ := AlgebraicGeometry.Scheme.AffineEtale.Spec S_F
    let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
      @AlgebraicGeometry.Etale
    have hDense : CategoryTheory.Sieve.functorPushforward Φ S ∈
        S_F.smallEtaleTopology (Φ.obj U) ↔ S ∈ weilC1AffEtTop F U :=
      CategoryTheory.Functor.IsDenseSubsite.functorPushforward_mem_iff
    have hEqTop : S_F.smallEtaleTopology =
        (AlgebraicGeometry.Scheme.smallPretopology P_et P_et (S := S_F)).toGrothendieck :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) S_F le_rfl
    have hPreIff : CategoryTheory.Sieve.functorPushforward Φ S ∈
        (AlgebraicGeometry.Scheme.smallPretopology P_et P_et (S := S_F)).toGrothendieck (Φ.obj U) ↔
        ∀ (x : ↥(Φ.obj U).left), ∃ Y f y,
          (CategoryTheory.Sieve.functorPushforward Φ S).arrows f ∧ P_et f.left ∧ f.left.base y = x :=
      AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) (S := S_F) (Φ.obj U) (CategoryTheory.Sieve.functorPushforward Φ S)
    constructor
    · intro hS p
      have hPush : CategoryTheory.Sieve.functorPushforward Φ S ∈
          (AlgebraicGeometry.Scheme.smallPretopology P_et P_et (S := S_F)).toGrothendieck (Φ.obj U) :=
        hEqTop ▸ hDense.mpr hS
      obtain ⟨W, u, z, hu_push, _, hz⟩ := hPreIff.mp hPush p
      rcases hu_push with ⟨Y, g, k, hg_S, rfl⟩
      exact ⟨Y, g, k.left.base z, hg_S, hz⟩
    · intro hCov
      refine hDense.mp (hEqTop.symm ▸ hPreIff.mpr ?_)
      intro p
      obtain ⟨Y, g, q, hg_S, hq⟩ := hCov p
      exact ⟨Φ.obj Y, Φ.map g, q,
        ⟨Y, g, CategoryTheory.CategoryStruct.id (Φ.obj Y), hg_S,
          (CategoryTheory.Category.id_comp (Φ.map g)).symm⟩,
        (hArrowEtale F g).1, hq⟩

  let L := weilC1AffEtForgetSite E₁ E₂
  let R := weilC1AffEtBaseChangeSite E₁ E₂

  have hCont₁ : L.IsContinuous (weilC1AffEtTop E₂) (weilC1AffEtTop E₁) := by
    let π := weilC1AffEtSepHom E₁ E₂
    have _ : Algebra.Etale E₁ E₂ :=
      @Algebra.Etale.mk E₁ E₂ _ _ _ (Algebra.FormallyEtale.of_isSeparable E₁ E₂)
        (Algebra.FinitePresentation.of_finiteType.mp inferInstance)
    have hEtπ : AlgebraicGeometry.Etale π :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
        (RingHom.etale_algebraMap.mpr inferInstance)
    have hCov : CategoryTheory.CoverPreserving (weilC1AffEtTop E₂) (weilC1AffEtTop E₁) L := by
      refine ⟨fun {V} {S} hS => (hTopMem E₁ (L.obj V) (CategoryTheory.Sieve.functorPushforward L S)).mpr ?_⟩
      intro p
      obtain ⟨Y, g, q, hg_S, hq⟩ := (hTopMem E₂ V S).mp hS p
      refine ⟨L.obj Y, L.map g, q, ?_, hq⟩
      exact ⟨Y, g, CategoryTheory.CategoryStruct.id (L.obj Y), hg_S,
        (CategoryTheory.Category.id_comp (L.map g)).symm⟩
    have hCompat : CategoryTheory.CompatiblePreserving (weilC1AffEtTop E₁) L := by
      refine CategoryTheory.CompatiblePreserving.mk ?_
      intro ℱ Z T x hx Y₁ Y₂ X f₁ f₂ g₁ g₂ hg₁ hg₂ heq
      let h_W : AlgebraicGeometry.Spec X.left.unop ⟶ AlgebraicGeometry.Spec (CommRingCat.of E₂) :=
        CategoryTheory.CategoryStruct.comp (AlgebraicGeometry.Scheme.Spec.map f₁.left) Y₁.hom
      have hhW_comp : CategoryTheory.CategoryStruct.comp h_W π = X.hom :=
        (CategoryTheory.Category.assoc _ _ _).trans f₁.w
      have _ : AlgebraicGeometry.Etale h_W :=
        CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
          h_W π hEtπ (hhW_comp.symm ▸ X.prop)
      let W : (AlgebraicGeometry.Spec (CommRingCat.of E₂)).AffineEtale :=
        AlgebraicGeometry.Scheme.AffineEtale.mk (R := X.left.unop) h_W
      have hLeftEq : CategoryTheory.CategoryStruct.comp f₁.left g₁.left =
          CategoryTheory.CategoryStruct.comp f₂.left g₂.left :=
        congrArg (fun m => m.left) heq
      have hp₂_w : CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Scheme.Spec.map f₂.left) Y₂.hom = h_W := by
        calc
          CategoryTheory.CategoryStruct.comp (AlgebraicGeometry.Scheme.Spec.map f₂.left) Y₂.hom
            = CategoryTheory.CategoryStruct.comp (AlgebraicGeometry.Scheme.Spec.map f₂.left)
                (CategoryTheory.CategoryStruct.comp (AlgebraicGeometry.Scheme.Spec.map g₂.left) Z.hom) :=
              congrArg (CategoryTheory.CategoryStruct.comp _) g₂.w.symm
          _ = CategoryTheory.CategoryStruct.comp
                (AlgebraicGeometry.Scheme.Spec.map (CategoryTheory.CategoryStruct.comp f₂.left g₂.left))
                Z.hom :=
              (CategoryTheory.Category.assoc _ _ _).symm.trans
                (congrArg (fun k => CategoryTheory.CategoryStruct.comp k Z.hom)
                  (AlgebraicGeometry.Scheme.Spec.map_comp f₂.left g₂.left).symm)
          _ = CategoryTheory.CategoryStruct.comp
                (AlgebraicGeometry.Scheme.Spec.map (CategoryTheory.CategoryStruct.comp f₁.left g₁.left))
                Z.hom :=
              congrArg (fun k => CategoryTheory.CategoryStruct.comp (AlgebraicGeometry.Scheme.Spec.map k) Z.hom)
                hLeftEq.symm
          _ = CategoryTheory.CategoryStruct.comp (AlgebraicGeometry.Scheme.Spec.map f₁.left)
                (CategoryTheory.CategoryStruct.comp (AlgebraicGeometry.Scheme.Spec.map g₁.left) Z.hom) :=
              (congrArg (fun k => CategoryTheory.CategoryStruct.comp k Z.hom)
                (AlgebraicGeometry.Scheme.Spec.map_comp f₁.left g₁.left)).trans
                (CategoryTheory.Category.assoc _ _ _)
          _ = h_W := congrArg (CategoryTheory.CategoryStruct.comp _) g₁.w
      let p₁ : W ⟶ Y₁ := CategoryTheory.MorphismProperty.CostructuredArrow.homMk f₁.left trivial rfl
      let p₂ : W ⟶ Y₂ := CategoryTheory.MorphismProperty.CostructuredArrow.homMk f₂.left trivial hp₂_w
      have hp_eq : CategoryTheory.CategoryStruct.comp p₁ g₁ = CategoryTheory.CategoryStruct.comp p₂ g₂ :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext hLeftEq (Subsingleton.elim _ _)
      have hxW := hx p₁ p₂ hg₁ hg₂ hp_eq
      let u : X ⟶ L.obj W := CategoryTheory.MorphismProperty.CostructuredArrow.homMk
        (CategoryTheory.CategoryStruct.id X.left) trivial
        ((congrArg (fun k => CategoryTheory.CategoryStruct.comp k _)
          (AlgebraicGeometry.Scheme.Spec.map_id X.left)).trans
          ((CategoryTheory.Category.id_comp _).trans hhW_comp))
      have hu₁ : CategoryTheory.CategoryStruct.comp u (L.map p₁) = f₁ :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext (CategoryTheory.Category.id_comp f₁.left)
          (Subsingleton.elim _ _)
      have hu₂ : CategoryTheory.CategoryStruct.comp u (L.map p₂) = f₂ :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext (CategoryTheory.Category.id_comp f₂.left)
          (Subsingleton.elim _ _)
      have hMap := congrArg (CategoryTheory.ConcreteCategory.hom (ℱ.obj.map u.op)) hxW
      have hLHS : (CategoryTheory.ConcreteCategory.hom (ℱ.obj.map u.op))
          ((CategoryTheory.ConcreteCategory.hom (ℱ.obj.map (L.map p₁).op)) (x g₁ hg₁)) =
          (CategoryTheory.ConcreteCategory.hom (ℱ.obj.map f₁.op)) (x g₁ hg₁) := by
        rw [← CategoryTheory.ConcreteCategory.comp_apply, ← ℱ.obj.map_comp, ← CategoryTheory.op_comp, hu₁]
      have hRHS : (CategoryTheory.ConcreteCategory.hom (ℱ.obj.map u.op))
          ((CategoryTheory.ConcreteCategory.hom (ℱ.obj.map (L.map p₂).op)) (x g₂ hg₂)) =
          (CategoryTheory.ConcreteCategory.hom (ℱ.obj.map f₂.op)) (x g₂ hg₂) := by
        rw [← CategoryTheory.ConcreteCategory.comp_apply, ← ℱ.obj.map_comp, ← CategoryTheory.op_comp, hu₂]
      exact hLHS.symm.trans (hMap.trans hRHS)
    exact CategoryTheory.Functor.isContinuous_of_coverPreserving hCompat hCov

  have hPreL : ∀ (V : (AlgebraicGeometry.Spec (CommRingCat.of E₂)).AffineEtale),
      (((AlgebraicGeometry.Scheme.Spec.preimage (L.obj V).hom).unop).hom : E₁ →+* ↑V.left.unop) =
        (((AlgebraicGeometry.Scheme.Spec.preimage V.hom).unop).hom).comp (algebraMap E₁ E₂) := by
    intro V
    have h1 : AlgebraicGeometry.Scheme.Spec.map (AlgebraicGeometry.Scheme.Spec.preimage (L.obj V).hom) =
        CategoryTheory.CategoryStruct.comp V.hom (weilC1AffEtSepHom E₁ E₂) :=
      AlgebraicGeometry.Scheme.Spec.map_preimage (L.obj V).hom
    have h2 : CategoryTheory.CategoryStruct.comp V.hom (weilC1AffEtSepHom E₁ E₂) =
        AlgebraicGeometry.Scheme.Spec.map
          (CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Scheme.Spec.preimage V.hom)
            (Opposite.op (CommRingCat.ofHom (algebraMap E₁ E₂)))) :=
      (congrArg (fun k => CategoryTheory.CategoryStruct.comp k (weilC1AffEtSepHom E₁ E₂))
        (AlgebraicGeometry.Scheme.Spec.map_preimage V.hom).symm).trans
        (AlgebraicGeometry.Scheme.Spec.map_comp
          (AlgebraicGeometry.Scheme.Spec.preimage V.hom)
          (Opposite.op (CommRingCat.ofHom (algebraMap E₁ E₂)))).symm
    exact congrArg (fun k => k.unop.hom)
      (AlgebraicGeometry.Scheme.Spec.map_injective (h1.trans h2))

  have hPreR : ∀ (U : (AlgebraicGeometry.Spec (CommRingCat.of E₁)).AffineEtale),
      letI : Algebra E₁ ↑U.left.unop := weilC1AffEtAlg E₁ U
      (((AlgebraicGeometry.Scheme.Spec.preimage (R.obj U).hom).unop).hom :
          E₂ →+* TensorProduct E₁ E₂ ↑U.left.unop) =
        algebraMap E₂ (TensorProduct E₁ E₂ ↑U.left.unop) := by
    intro U
    let _ : Algebra E₁ ↑U.left.unop := weilC1AffEtAlg E₁ U
    have hSpec : AlgebraicGeometry.Scheme.Spec.map
        (AlgebraicGeometry.Scheme.Spec.preimage (R.obj U).hom) =
        AlgebraicGeometry.Scheme.Spec.map
          (Opposite.op (CommRingCat.ofHom
            (algebraMap E₂ (TensorProduct E₁ E₂ ↑U.left.unop)))) :=
      AlgebraicGeometry.Scheme.Spec.map_preimage (R.obj U).hom
    exact congrArg (fun k => k.unop.hom) (AlgebraicGeometry.Scheme.Spec.map_injective hSpec)

  have hHomComm : ∀ (F : Type u) [Field F]
      {U₁ U₂ : (AlgebraicGeometry.Spec (CommRingCat.of F)).AffineEtale} (g : U₁ ⟶ U₂),
      ((g.left.unop).hom).comp ((AlgebraicGeometry.Scheme.Spec.preimage U₂.hom).unop).hom =
        ((AlgebraicGeometry.Scheme.Spec.preimage U₁.hom).unop).hom := by
    intro F _ U₁ U₂ g
    have hSpec : AlgebraicGeometry.Scheme.Spec.map
        (CategoryTheory.CategoryStruct.comp g.left
          (AlgebraicGeometry.Scheme.Spec.preimage U₂.hom)) =
        AlgebraicGeometry.Scheme.Spec.map (AlgebraicGeometry.Scheme.Spec.preimage U₁.hom) :=
      (AlgebraicGeometry.Scheme.Spec.map_comp g.left
        (AlgebraicGeometry.Scheme.Spec.preimage U₂.hom)).trans
        ((congrArg (CategoryTheory.CategoryStruct.comp (AlgebraicGeometry.Scheme.Spec.map g.left))
          (AlgebraicGeometry.Scheme.Spec.map_preimage U₂.hom)).trans
          (g.w.trans (AlgebraicGeometry.Scheme.Spec.map_preimage U₁.hom).symm))
    exact congrArg (fun k => k.unop.hom) (AlgebraicGeometry.Scheme.Spec.map_injective hSpec)

  let homEquiv : ∀ (V : (AlgebraicGeometry.Spec (CommRingCat.of E₂)).AffineEtale)
      (U : (AlgebraicGeometry.Spec (CommRingCat.of E₁)).AffineEtale),
      (L.obj V ⟶ U) ≃ (V ⟶ R.obj U) := fun V U =>
    let A : Type u := ↑U.left.unop
    let B : Type u := ↑V.left.unop
    letI algA : Algebra E₁ A := weilC1AffEtAlg E₁ U
    let σ₂ : E₂ →+* B := ((AlgebraicGeometry.Scheme.Spec.preimage V.hom).unop).hom
    let algB₁ : Algebra E₁ B := (σ₂.comp (algebraMap E₁ E₂)).toAlgebra
    haveI : @IsScalarTower E₁ E₁ B _ algB₁.toSMul algB₁.toSMul :=
      @IsScalarTower.of_algebraMap_eq' E₁ E₁ B _ _ _ (Algebra.id E₁) algB₁ algB₁ rfl
    { toFun := fun f =>
        let φ : @AlgHom E₁ A B _ _ _ algA algB₁ :=
          { toRingHom := (f.left.unop).hom
            commutes' := fun c =>
              (RingHom.congr_fun (hHomComm E₁ f) c).trans (RingHom.congr_fun (hPreL V) c) }
        let eHom : @AlgHom E₁ E₂ B _ _ _ _ algB₁ :=
          { toRingHom := σ₂, commutes' := fun _ => rfl }
        let ψ : @AlgHom E₁ (TensorProduct E₁ E₂ A) B _ _ _ _ algB₁ :=
          @Algebra.TensorProduct.lift E₁ E₁ E₂ A B _ _ (Algebra.id E₁) _ _ _
            (@IsScalarTower.of_algebraMap_eq' E₁ E₁ E₂ _ _ _ (Algebra.id E₁) _ _ rfl)
            _ algA _ algB₁ algB₁ inferInstance
            eHom φ (fun _ _ => mul_comm _ _)
        CategoryTheory.MorphismProperty.CostructuredArrow.homMk
          (Opposite.op (CommRingCat.ofHom ψ.toRingHom)) trivial
          (by
            have hcomp : CategoryTheory.CategoryStruct.comp
                (CommRingCat.ofHom (algebraMap E₂ (TensorProduct E₁ E₂ A)))
                (CommRingCat.ofHom ψ.toRingHom) =
                (AlgebraicGeometry.Scheme.Spec.preimage V.hom).unop := by
              apply CommRingCat.hom_ext
              apply RingHom.ext
              intro e
              simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply]
              change σ₂ e * φ 1 = σ₂ e
              exact (congrArg (σ₂ e * ·) (map_one φ)).trans (mul_one (σ₂ e))
            exact (AlgebraicGeometry.Scheme.Spec.map_comp _ _).symm.trans
              ((congrArg AlgebraicGeometry.Spec.map hcomp).trans
                (AlgebraicGeometry.Scheme.Spec.map_preimage V.hom)))
      invFun := fun g =>
        let ψ : TensorProduct E₁ E₂ A →+* B := (g.left.unop).hom
        let φ : A →+* B :=
          ψ.comp (Algebra.TensorProduct.includeRight :
            A →ₐ[E₁] TensorProduct E₁ E₂ A).toRingHom
        CategoryTheory.MorphismProperty.CostructuredArrow.homMk
          (Opposite.op (CommRingCat.ofHom φ)) trivial
          (by
            have hψ_e : ∀ e : E₂, ψ (e ⊗ₜ[E₁] (1 : A)) = σ₂ e := fun e =>
              (congrArg ψ (RingHom.congr_fun (hPreR U) e)).symm.trans
                (RingHom.congr_fun (hHomComm E₂ g) e)
            have hcomp : CategoryTheory.CategoryStruct.comp
                (Opposite.op (CommRingCat.ofHom φ))
                (AlgebraicGeometry.Scheme.Spec.preimage U.hom) =
                AlgebraicGeometry.Scheme.Spec.preimage (L.obj V).hom := by
              apply Opposite.unop_injective
              apply CommRingCat.hom_ext
              apply RingHom.ext
              intro (c : E₁)
              have htmul : ((1 : E₂) ⊗ₜ[E₁] (@algebraMap E₁ A _ _ algA c)) =
                  ((algebraMap E₁ E₂ c) ⊗ₜ[E₁] (1 : A)) :=
                (congrArg ((1 : E₂) ⊗ₜ[E₁] ·) (@Algebra.algebraMap_eq_smul_one E₁ A _ _ algA c)).trans
                  ((TensorProduct.tmul_smul c (1 : E₂) (1 : A)).trans
                    (congrArg (· ⊗ₜ[E₁] (1 : A)) (Algebra.algebraMap_eq_smul_one c).symm))
              change ψ ((1 : E₂) ⊗ₜ[E₁] (@algebraMap E₁ A _ _ algA c)) = _
              exact (congrArg ψ htmul).trans ((hψ_e (algebraMap E₁ E₂ c)).trans
                (RingHom.congr_fun (hPreL V) c).symm)
            exact (congrArg
                (CategoryTheory.CategoryStruct.comp
                  (AlgebraicGeometry.Scheme.Spec.map (Opposite.op (CommRingCat.ofHom φ))))
                (AlgebraicGeometry.Scheme.Spec.map_preimage U.hom).symm).trans
              ((AlgebraicGeometry.Scheme.Spec.map_comp _ _).symm.trans
                ((congrArg AlgebraicGeometry.Scheme.Spec.map hcomp).trans
                  (AlgebraicGeometry.Scheme.Spec.map_preimage (L.obj V).hom))))
      left_inv := fun f => by
        refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
        apply Opposite.unop_injective
        apply CommRingCat.hom_ext
        let φ_f : A →+* B := (f.left.unop).hom
        apply RingHom.ext
        intro a
        change σ₂ 1 * φ_f a = φ_f a
        exact (congrArg (· * φ_f a) (map_one σ₂)).trans (one_mul (φ_f a))
      right_inv := fun g => by
        refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
        apply Opposite.unop_injective
        apply CommRingCat.hom_ext
        let ψ_g : TensorProduct E₁ E₂ A →+* B := (g.left.unop).hom
        have hψ_e : ∀ e : E₂, ψ_g (e ⊗ₜ[E₁] (1 : A)) = σ₂ e := fun e =>
          (congrArg ψ_g (RingHom.congr_fun (hPreR U) e)).symm.trans
            (RingHom.congr_fun (hHomComm E₂ g) e)
        apply RingHom.ext
        intro z
        change (@Algebra.TensorProduct.lift E₁ E₁ E₂ A B _ _ (Algebra.id E₁) _ _ _
            (@IsScalarTower.of_algebraMap_eq' E₁ E₁ E₂ _ _ _ (Algebra.id E₁) _ _ rfl)
            _ algA _ algB₁ algB₁ inferInstance
            { toRingHom := σ₂, commutes' := fun _ => rfl }
            { toRingHom := ψ_g.comp (Algebra.TensorProduct.includeRight :
                A →ₐ[E₁] TensorProduct E₁ E₂ A).toRingHom
              commutes' := _ }
            (fun _ _ => mul_comm _ _)).toRingHom z = ψ_g z
        induction z using TensorProduct.induction_on with
        | zero => exact (RingHom.map_zero _).trans (RingHom.map_zero ψ_g).symm
        | tmul e a =>
          change σ₂ e * ψ_g (1 ⊗ₜ[E₁] a) = ψ_g (e ⊗ₜ[E₁] a)
          exact (congrArg (· * ψ_g (1 ⊗ₜ[E₁] a)) (hψ_e e).symm).trans
            ((RingHom.map_mul ψ_g _ _).symm.trans
              (congrArg ψ_g
                ((Algebra.TensorProduct.tmul_mul_tmul e 1 (1 : A) a).trans
                  (congrArg₂ (· ⊗ₜ[E₁] ·) (mul_one e) (one_mul a)))))
        | add x y ihx ihy =>
          exact (RingHom.map_add _ x y).trans
            ((congrArg₂ (· + ·) ihx ihy).trans (RingHom.map_add ψ_g x y).symm) }

  let adjSite : L ⊣ R := CategoryTheory.Adjunction.mkOfHomEquiv
    { homEquiv := homEquiv
      homEquiv_naturality_left_symm := fun {_ _ _} _ _ => by
        refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
        apply Opposite.unop_injective
        apply CommRingCat.hom_ext
        rfl
      homEquiv_naturality_right := fun {_ U U'} _ _ => by
        refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
        apply Opposite.unop_injective
        apply CommRingCat.hom_ext
        let _ : Algebra E₁ ↑U.left.unop := weilC1AffEtAlg E₁ U
        let _ : Algebra E₁ ↑U'.left.unop := weilC1AffEtAlg E₁ U'
        apply RingHom.ext
        intro z
        induction z using TensorProduct.induction_on with
        | zero => exact (RingHom.map_zero _).trans (RingHom.map_zero _).symm
        | tmul _ _ => rfl
        | add x y ihx ihy =>
          exact (RingHom.map_add _ x y).trans
            ((congrArg₂ (· + ·) ihx ihy).trans (RingHom.map_add _ x y).symm) }

  have hCounit : ∀ (U : (AlgebraicGeometry.Spec (CommRingCat.of E₁)).AffineEtale),
      letI : Algebra E₁ ↑U.left.unop := weilC1AffEtAlg E₁ U
      ((adjSite.counit.app U).left.unop).hom =
        (Algebra.TensorProduct.includeRight :
          ↑U.left.unop →ₐ[E₁] TensorProduct E₁ E₂ ↑U.left.unop).toRingHom := by
    intro U
    let _ : Algebra E₁ ↑U.left.unop := weilC1AffEtAlg E₁ U
    have hEq : adjSite.counit.app U = (homEquiv (R.obj U) U).symm
        (CategoryTheory.CategoryStruct.id (R.obj U)) :=
      CategoryTheory.Adjunction.mkOfHomEquiv_counit_app _ U
    exact (congrArg (fun m => (m.left.unop).hom) hEq).trans (RingHom.ext fun _ => rfl)

  have _ : R.IsRightAdjoint := adjSite.isRightAdjoint
  have hCompatR : CategoryTheory.CompatiblePreserving (weilC1AffEtTop E₂) R :=
    CategoryTheory.compatiblePreservingOfFlat (weilC1AffEtTop E₂) R
  have hCovR : CategoryTheory.CoverPreserving (weilC1AffEtTop E₁) (weilC1AffEtTop E₂) R := by
    refine ⟨fun {U} {S} hS => (hTopMem E₂ (R.obj U) (CategoryTheory.Sieve.functorPushforward R S)).mpr ?_⟩
    intro q
    let A : Type u := ↑U.left.unop
    let algA : Algebra E₁ A := weilC1AffEtAlg E₁ U
    let _ : Algebra E₁ A := algA
    let q₀ : PrimeSpectrum (TensorProduct E₁ E₂ A) := q
    let ι_R : A →+* TensorProduct E₁ E₂ A :=
      (Algebra.TensorProduct.includeRight : A →ₐ[E₁] TensorProduct E₁ E₂ A).toRingHom
    let p : PrimeSpectrum A := PrimeSpectrum.comap ι_R q₀
    obtain ⟨Y, f, p'_raw, hf_S, hp'⟩ := (hTopMem E₁ U S).mp hS p
    let A' : Type u := ↑Y.left.unop
    let algA' : Algebra E₁ A' := weilC1AffEtAlg E₁ Y
    let _ : Algebra E₁ A' := algA'
    let p' : PrimeSpectrum A' := p'_raw
    let φ_f : A →ₐ[E₁] A' :=
      { toRingHom := (f.left.unop).hom
        commutes' := fun c => RingHom.congr_fun (hHomComm E₁ f) c }
    let ρ_f : TensorProduct E₁ E₂ A →+* TensorProduct E₁ E₂ A' :=
      ((R.map f).left.unop).hom
    have hρ_tmul : ∀ (e : E₂) (a : A), ρ_f (e ⊗ₜ[E₁] a) = e ⊗ₜ[E₁] (φ_f a) :=
      fun _ _ => rfl
    let κ := FractionRing (A ⧸ p.asIdeal)
    let K₁ := FractionRing ((TensorProduct E₁ E₂ A) ⧸ q₀.asIdeal)
    let K₂ := FractionRing (A' ⧸ p'.asIdeal)
    let q_A : A →+* κ := (algebraMap (A ⧸ p.asIdeal) κ).comp (Ideal.Quotient.mk p.asIdeal)
    let q_1 : TensorProduct E₁ E₂ A →+* K₁ :=
      (algebraMap ((TensorProduct E₁ E₂ A) ⧸ q₀.asIdeal) K₁).comp (Ideal.Quotient.mk q₀.asIdeal)
    let q_2 : A' →+* K₂ := (algebraMap (A' ⧸ p'.asIdeal) K₂).comp (Ideal.Quotient.mk p'.asIdeal)
    let bar_1 : (A ⧸ p.asIdeal) →+* K₁ :=
      Ideal.Quotient.lift p.asIdeal (q_1.comp ι_R) (fun a ha => by
        have hq_mem : ι_R a ∈ q₀.asIdeal := ha
        have hmk0 : Ideal.Quotient.mk q₀.asIdeal (ι_R a) = 0 :=
          (@Ideal.Quotient.eq_zero_iff_mem (TensorProduct E₁ E₂ A) _ q₀.asIdeal _).mpr hq_mem
        exact (congrArg (algebraMap _ K₁) hmk0).trans (map_zero _))
    have hInj_bar1 : Function.Injective bar_1 := by
      intro x₁ x₂ hx
      rcases Ideal.Quotient.mk_surjective x₁ with ⟨a₁, rfl⟩
      rcases Ideal.Quotient.mk_surjective x₂ with ⟨a₂, rfl⟩
      apply sub_eq_zero.mp
      have hsub : bar_1 (Ideal.Quotient.mk p.asIdeal (a₁ - a₂)) = 0 :=
        (RingHom.map_sub bar_1 _ _).trans (sub_eq_zero.mpr hx)
      have hq0 : Ideal.Quotient.mk q₀.asIdeal (ι_R (a₁ - a₂)) = 0 :=
        IsFractionRing.injective ((TensorProduct E₁ E₂ A) ⧸ q₀.asIdeal) K₁
          (hsub.trans (map_zero _).symm)
      have hmem_q : ι_R (a₁ - a₂) ∈ q₀.asIdeal :=
        (@Ideal.Quotient.eq_zero_iff_mem (TensorProduct E₁ E₂ A) _ q₀.asIdeal _).mp hq0
      have hmem_p : a₁ - a₂ ∈ p.asIdeal := hmem_q
      exact (RingHom.map_sub (Ideal.Quotient.mk p.asIdeal) a₁ a₂).symm.trans
        ((@Ideal.Quotient.eq_zero_iff_mem A _ p.asIdeal _).mpr hmem_p)
    let α₁ : κ →+* K₁ := IsLocalization.lift (M := nonZeroDivisors (A ⧸ p.asIdeal)) (g := bar_1)
      (fun s => IsUnit.mk0 (bar_1 s.1) (fun h0 =>
        mem_nonZeroDivisors_iff_ne_zero.mp s.2 (hInj_bar1 (h0.trans (map_zero _).symm))))
    have hα₁ : ∀ a : A, α₁ (q_A a) = q_1 (ι_R a) := fun a =>
      IsLocalization.lift_eq (M := nonZeroDivisors (A ⧸ p.asIdeal)) _ (Ideal.Quotient.mk p.asIdeal a)
    have hp'_ideal : p'.asIdeal.comap φ_f.toRingHom = p.asIdeal :=
      congrArg PrimeSpectrum.asIdeal hp'
    let bar_2 : (A ⧸ p.asIdeal) →+* K₂ :=
      Ideal.Quotient.lift p.asIdeal (q_2.comp φ_f.toRingHom) (fun a ha => by
        have hp'_mem : φ_f a ∈ p'.asIdeal :=
          show a ∈ p'.asIdeal.comap φ_f.toRingHom from hp'_ideal.symm ▸ ha
        have hmk0 : Ideal.Quotient.mk p'.asIdeal (φ_f a) = 0 :=
          (@Ideal.Quotient.eq_zero_iff_mem A' _ p'.asIdeal _).mpr hp'_mem
        exact (congrArg (algebraMap _ K₂) hmk0).trans (map_zero _))
    have hInj_bar2 : Function.Injective bar_2 := by
      intro x₁ x₂ hx
      rcases Ideal.Quotient.mk_surjective x₁ with ⟨a₁, rfl⟩
      rcases Ideal.Quotient.mk_surjective x₂ with ⟨a₂, rfl⟩
      apply sub_eq_zero.mp
      have hsub : bar_2 (Ideal.Quotient.mk p.asIdeal (a₁ - a₂)) = 0 :=
        (RingHom.map_sub bar_2 _ _).trans (sub_eq_zero.mpr hx)
      have hp'0 : Ideal.Quotient.mk p'.asIdeal (φ_f (a₁ - a₂)) = 0 :=
        IsFractionRing.injective (A' ⧸ p'.asIdeal) K₂ (hsub.trans (map_zero _).symm)
      have hmem_p' : φ_f (a₁ - a₂) ∈ p'.asIdeal :=
        (@Ideal.Quotient.eq_zero_iff_mem A' _ p'.asIdeal _).mp hp'0
      have ha_mem : a₁ - a₂ ∈ p.asIdeal :=
        hp'_ideal ▸ (show a₁ - a₂ ∈ p'.asIdeal.comap φ_f.toRingHom from hmem_p')
      exact (RingHom.map_sub (Ideal.Quotient.mk p.asIdeal) a₁ a₂).symm.trans
        ((@Ideal.Quotient.eq_zero_iff_mem A _ p.asIdeal _).mpr ha_mem)
    let α₂ : κ →+* K₂ := IsLocalization.lift (M := nonZeroDivisors (A ⧸ p.asIdeal)) (g := bar_2)
      (fun s => IsUnit.mk0 (bar_2 s.1) (fun h0 =>
        mem_nonZeroDivisors_iff_ne_zero.mp s.2 (hInj_bar2 (h0.trans (map_zero _).symm))))
    have hα₂ : ∀ a : A, α₂ (q_A a) = q_2 (φ_f a) := fun a =>
      IsLocalization.lift_eq (M := nonZeroDivisors (A ⧸ p.asIdeal)) _ (Ideal.Quotient.mk p.asIdeal a)
    let algκK₁ : Algebra κ K₁ := α₁.toAlgebra
    let algκK₂ : Algebra κ K₂ := α₂.toAlgebra
    let _ : Algebra κ K₁ := algκK₁
    let _ : Algebra κ K₂ := algκK₂
    have _ : Module.Free κ K₂ := Module.Free.of_divisionRing κ K₂
    have _ : Module.FaithfullyFlat κ K₂ :=
      @Module.FaithfullyFlat.instOfNontrivialOfFree κ K₂ _ _ _ inferInstance inferInstance
    let T := TensorProduct κ K₁ K₂
    have _ : Nontrivial T := Module.FaithfullyFlat.rTensor_nontrivial κ K₂ K₁
    let ι_T1 : K₁ →+* T := Algebra.TensorProduct.includeLeftRingHom
    let ι_T2 : K₂ →+* T := (Algebra.TensorProduct.includeRight : K₂ →ₐ[κ] T).toRingHom
    let β₁ : E₂ →+* T := ι_T1.comp (q_1.comp Algebra.TensorProduct.includeLeftRingHom)
    let β₂ : A' →+* T := ι_T2.comp q_2
    let algET : Algebra E₁ T := (β₁.comp (algebraMap E₁ E₂)).toAlgebra
    have _ : @IsScalarTower E₁ E₁ T _ algET.toSMul algET.toSMul :=
      @IsScalarTower.of_algebraMap_eq' E₁ E₁ T _ _ _ (Algebra.id E₁) algET algET rfl
    have hκ_tmul : ∀ r₀ : κ, (1 : K₁) ⊗ₜ[κ] (α₂ r₀) = (α₁ r₀) ⊗ₜ[κ] (1 : K₂) := fun r₀ =>
      (congrArg ((1 : K₁) ⊗ₜ[κ] ·) (@Algebra.algebraMap_eq_smul_one κ K₂ _ _ algκK₂ r₀)).trans
        ((TensorProduct.tmul_smul r₀ (1 : K₁) (1 : K₂)).trans
          (congrArg (· ⊗ₜ[κ] (1 : K₂))
            (@Algebra.algebraMap_eq_smul_one κ K₁ _ _ algκK₁ r₀).symm))
    have hAgree : ∀ c : E₁, β₂ (algebraMap E₁ A' c) = β₁ (algebraMap E₁ E₂ c) := by
      intro c
      have htmul : ((algebraMap E₁ E₂ c) ⊗ₜ[E₁] (1 : A)) = ((1 : E₂) ⊗ₜ[E₁] (algebraMap E₁ A c)) :=
        (congrArg (· ⊗ₜ[E₁] (1 : A)) (Algebra.algebraMap_eq_smul_one c)).trans
          ((TensorProduct.smul_tmul c (1 : E₂) (1 : A)).trans
            (congrArg ((1 : E₂) ⊗ₜ[E₁] ·) (@Algebra.algebraMap_eq_smul_one E₁ A _ _ algA c).symm))
      have h1 : β₁ (algebraMap E₁ E₂ c) = (α₁ (q_A (algebraMap E₁ A c))) ⊗ₜ[κ] (1 : K₂) :=
        (congrArg (fun x => (q_1 x) ⊗ₜ[κ] (1 : K₂)) htmul).trans
          (congrArg (· ⊗ₜ[κ] (1 : K₂)) (hα₁ (algebraMap E₁ A c)).symm)
      have h2 : β₂ (algebraMap E₁ A' c) = (1 : K₁) ⊗ₜ[κ] (α₂ (q_A (algebraMap E₁ A c))) :=
        (congrArg (fun x => (1 : K₁) ⊗ₜ[κ] (q_2 x)) (φ_f.commutes c).symm).trans
          (congrArg ((1 : K₁) ⊗ₜ[κ] ·) (hα₂ (algebraMap E₁ A c)).symm)
      exact h2.trans ((hκ_tmul (q_A (algebraMap E₁ A c))).trans h1.symm)
    let b₁_alg : @AlgHom E₁ E₂ T _ _ _ _ algET := { toRingHom := β₁, commutes' := fun _ => rfl }
    let b₂_alg : @AlgHom E₁ A' T _ _ _ _ algET := { toRingHom := β₂, commutes' := hAgree }
    let Θ : TensorProduct E₁ E₂ A' →+* T :=
      (@Algebra.TensorProduct.lift E₁ E₁ E₂ A' T _ _ (Algebra.id E₁) _ _ _
        (@IsScalarTower.of_algebraMap_eq' E₁ E₁ E₂ _ _ _ (Algebra.id E₁) _ _ rfl)
        _ algA' _ algET algET inferInstance b₁_alg b₂_alg
        (fun _ _ => mul_comm _ _)).toRingHom
    obtain ⟨m, hm_max⟩ := Ideal.exists_maximal T
    have _ : m.IsPrime := hm_max.isPrime
    let q' : PrimeSpectrum (TensorProduct E₁ E₂ A') := PrimeSpectrum.comap Θ ⟨m, inferInstance⟩
    have hΘ_map : ∀ z : TensorProduct E₁ E₂ A, Θ (ρ_f z) = ι_T1 (q_1 z) := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero =>
        exact (congrArg Θ (RingHom.map_zero ρ_f)).trans
          ((RingHom.map_zero Θ).trans
            ((RingHom.map_zero ι_T1).symm.trans
              (congrArg ι_T1 (RingHom.map_zero q_1).symm)))
      | tmul e a =>
        have hβ₂ : β₂ (φ_f a) = (q_1 (ι_R a)) ⊗ₜ[κ] (1 : K₂) :=
          (congrArg ((1 : K₁) ⊗ₜ[κ] ·) (hα₂ a).symm).trans
            ((hκ_tmul (q_A a)).trans (congrArg (· ⊗ₜ[κ] (1 : K₂)) (hα₁ a)))
        have hstep1 : Θ (ρ_f (e ⊗ₜ[E₁] a)) = β₁ e * β₂ (φ_f a) :=
          congrArg Θ (hρ_tmul e a)
        have hstep2 : β₁ e * β₂ (φ_f a) =
            ((q_1 (e ⊗ₜ[E₁] 1)) ⊗ₜ[κ] (1 : K₂)) * ((q_1 (1 ⊗ₜ[E₁] a)) ⊗ₜ[κ] (1 : K₂)) :=
          congrArg (β₁ e * ·) hβ₂
        have hstep3 : ((q_1 (e ⊗ₜ[E₁] 1)) ⊗ₜ[κ] (1 : K₂)) * ((q_1 (1 ⊗ₜ[E₁] a)) ⊗ₜ[κ] (1 : K₂)) =
            (q_1 (e ⊗ₜ[E₁] a)) ⊗ₜ[κ] (1 : K₂) :=
          (Algebra.TensorProduct.tmul_mul_tmul _ _ _ _).trans
            ((congrArg₂ (· ⊗ₜ[κ] ·) (RingHom.map_mul q_1 _ _).symm (mul_one (1 : K₂))).trans
              (congrArg (fun x => (q_1 x) ⊗ₜ[κ] (1 : K₂))
                ((Algebra.TensorProduct.tmul_mul_tmul e 1 (1 : A) a).trans
                  (congrArg₂ (· ⊗ₜ[E₁] ·) (mul_one e) (one_mul a)))))
        exact hstep1.trans (hstep2.trans hstep3)
      | add x y ihx ihy =>
        exact (congrArg Θ (RingHom.map_add ρ_f x y)).trans
          ((RingHom.map_add Θ _ _).trans
            ((congrArg₂ (· + ·) ihx ihy).trans
              ((RingHom.map_add ι_T1 _ _).symm.trans
                (congrArg ι_T1 (RingHom.map_add q_1 x y).symm))))
    refine ⟨R.obj Y, R.map f, q', ?_, ?_⟩
    · exact ⟨Y, f, CategoryTheory.CategoryStruct.id (R.obj Y), hf_S,
        (CategoryTheory.Category.id_comp (R.map f)).symm⟩
    · apply PrimeSpectrum.ext
      ext z
      change Θ (ρ_f z) ∈ m ↔ z ∈ q₀.asIdeal
      constructor
      · intro hm
        have hm' : ι_T1 (q_1 z) ∈ m := (hΘ_map z) ▸ hm
        have hq1_0 : q_1 z = 0 := by
          by_contra hne
          have hu : IsUnit (ι_T1 (q_1 z)) := (IsUnit.mk0 (q_1 z) hne).map ι_T1
          exact hm_max.ne_top (Ideal.eq_top_of_isUnit_mem m hm' hu)
        have hmk0 : Ideal.Quotient.mk q₀.asIdeal z = 0 :=
          IsFractionRing.injective ((TensorProduct E₁ E₂ A) ⧸ q₀.asIdeal) K₁
            (hq1_0.trans (map_zero _).symm)
        exact (@Ideal.Quotient.eq_zero_iff_mem (TensorProduct E₁ E₂ A) _ q₀.asIdeal _).mp hmk0
      · intro hz
        have hmk0 : Ideal.Quotient.mk q₀.asIdeal z = 0 :=
          (@Ideal.Quotient.eq_zero_iff_mem (TensorProduct E₁ E₂ A) _ q₀.asIdeal _).mpr hz
        have hq1_0 : q_1 z = 0 :=
          (congrArg (algebraMap _ K₁) hmk0).trans (map_zero _)
        have h0 : Θ (ρ_f z) = 0 :=
          (hΘ_map z).trans ((congrArg ι_T1 hq1_0).trans (map_zero ι_T1))
        exact h0.symm ▸ m.zero_mem
  have hCont₂ : R.IsContinuous (weilC1AffEtTop E₁) (weilC1AffEtTop E₂) :=
    CategoryTheory.Functor.isContinuous_of_coverPreserving hCompatR hCovR
  exact ⟨hCont₁, hCont₂, ⟨adjSite, hCounit⟩⟩

theorem weil_c1_affEt_sep_pushforward_preservesFiniteColimits (E₁ E₂ : Type u) [Field E₁] [Field E₂] [Algebra E₁ E₂]
    [FiniteDimensional E₁ E₂] [Algebra.IsSeparable E₁ E₂]
    (hCont₂ : (weilC1AffEtBaseChangeSite E₁ E₂).IsContinuous
      (weilC1AffEtTop E₁) (weilC1AffEtTop E₂)) :
    letI := hCont₂
    CategoryTheory.Limits.PreservesFiniteColimits
      ((weilC1AffEtBaseChangeSite E₁ E₂).sheafPushforwardContinuous
        AddCommGrpCat.{u} (weilC1AffEtTop E₁) (weilC1AffEtTop E₂)) :=
by
  
  have hArrowEtale : ∀ (F : Type u) [Field F]
      {Y U : (AlgebraicGeometry.Spec (CommRingCat.of F)).AffineEtale} (g : Y ⟶ U),
      AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map g.left.unop) ∧
      RingHom.Etale (g.left.unop).hom := by
    intro F _ Y U g
    have hEtU : AlgebraicGeometry.Etale U.hom := U.prop
    have hEtY : AlgebraicGeometry.Etale Y.hom := Y.prop
    have hComp : AlgebraicGeometry.Etale
        (CategoryTheory.CategoryStruct.comp (AlgebraicGeometry.Spec.map g.left.unop) U.hom) :=
      g.w.symm ▸ hEtY
    have hEtMap : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map g.left.unop) :=
      CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
        (AlgebraicGeometry.Spec.map g.left.unop) U.hom hEtU hComp
    exact ⟨hEtMap, (AlgebraicGeometry.HasRingHomProperty.Spec_iff
      (P := @AlgebraicGeometry.Etale)).mp hEtMap⟩

  have hTopMem : ∀ (F : Type u) [Field F]
      (U : (AlgebraicGeometry.Spec (CommRingCat.of F)).AffineEtale)
      (S : CategoryTheory.Sieve U),
      S ∈ weilC1AffEtTop F U ↔
        ∀ p : PrimeSpectrum ↑U.left.unop,
          ∃ (Y : (AlgebraicGeometry.Spec (CommRingCat.of F)).AffineEtale)
            (g : Y ⟶ U) (q : PrimeSpectrum ↑Y.left.unop),
            S.arrows g ∧ PrimeSpectrum.comap (g.left.unop).hom q = p := by
    intro F _ U S
    let S_F := AlgebraicGeometry.Spec (CommRingCat.of F)
    let Φ := AlgebraicGeometry.Scheme.AffineEtale.Spec S_F
    let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
      @AlgebraicGeometry.Etale
    have hDense : CategoryTheory.Sieve.functorPushforward Φ S ∈
        S_F.smallEtaleTopology (Φ.obj U) ↔ S ∈ weilC1AffEtTop F U :=
      CategoryTheory.Functor.IsDenseSubsite.functorPushforward_mem_iff
    have hEqTop : S_F.smallEtaleTopology =
        (AlgebraicGeometry.Scheme.smallPretopology P_et P_et (S := S_F)).toGrothendieck :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) S_F le_rfl
    have hPreIff : CategoryTheory.Sieve.functorPushforward Φ S ∈
        (AlgebraicGeometry.Scheme.smallPretopology P_et P_et (S := S_F)).toGrothendieck (Φ.obj U) ↔
        ∀ (x : ↥(Φ.obj U).left), ∃ Y f y,
          (CategoryTheory.Sieve.functorPushforward Φ S).arrows f ∧ P_et f.left ∧ f.left.base y = x :=
      AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) (S := S_F) (Φ.obj U) (CategoryTheory.Sieve.functorPushforward Φ S)
    constructor
    · intro hS p
      have hPush : CategoryTheory.Sieve.functorPushforward Φ S ∈
          (AlgebraicGeometry.Scheme.smallPretopology P_et P_et (S := S_F)).toGrothendieck (Φ.obj U) :=
        hEqTop ▸ hDense.mpr hS
      obtain ⟨W, u, z, hu_push, _, hz⟩ := hPreIff.mp hPush p
      rcases hu_push with ⟨Y, g, k, hg_S, rfl⟩
      exact ⟨Y, g, k.left.base z, hg_S, hz⟩
    · intro hCov
      refine hDense.mp (hEqTop.symm ▸ hPreIff.mpr ?_)
      intro p
      obtain ⟨Y, g, q, hg_S, hq⟩ := hCov p
      exact ⟨Φ.obj Y, Φ.map g, q,
        ⟨Y, g, CategoryTheory.CategoryStruct.id (Φ.obj Y), hg_S,
          (CategoryTheory.Category.id_comp (Φ.map g)).symm⟩,
        (hArrowEtale F g).1, hq⟩

  
  have hPrimeLiftRed :
      (∀ {ℱ 𝒢 : CategoryTheory.Sheaf (weilC1AffEtTop E₂) AddCommGrpCat.{u}} (g : ℱ ⟶ 𝒢),
        (∀ (V : (AlgebraicGeometry.Spec (CommRingCat.of E₂)).AffineEtale)
           (y' : ↑(𝒢.obj.obj (Opposite.op V)))
           (q : PrimeSpectrum ↑V.left.unop),
          ∃ (Y : (AlgebraicGeometry.Spec (CommRingCat.of E₂)).AffineEtale)
            (u : Y ⟶ V) (w : ↑(ℱ.obj.obj (Opposite.op Y))),
            RingHom.Etale (u.left.unop).hom ∧
            Nontrivial ↑Y.left.unop ∧
