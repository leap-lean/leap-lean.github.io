      z = preZ (𝟙 X) := (CategoryTheory.Abelian.Ext.mk₀_id_comp z).symm
      _ = preZ (∑ j : Fin n, a j ≫ b j) := congrArg preZ hId
      _ = ∑ j : Fin n, preZ (a j ≫ b j) := map_sum preZ _ Finset.univ
      _ = 0 := by
        refine Finset.sum_eq_zero fun j _ => ?_
        change (CategoryTheory.Abelian.Ext.mk₀ (a j ≫ b j)).comp z (Nat.zero_add q) = 0
        rw [← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
          CategoryTheory.Abelian.Ext.comp_assoc _ (CategoryTheory.Abelian.Ext.mk₀ (b j))
            z (Nat.zero_add 0) (Nat.zero_add q) (Nat.zero_add q),
          hbz j, CategoryTheory.Abelian.Ext.comp_zero]

  have hExtShift : ∀ {C_ab : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} C_ab]
      [CategoryTheory.Abelian C_ab] [CategoryTheory.HasExt.{u} C_ab]
      [CategoryTheory.EnoughInjectives C_ab]
      (X Y : C_ab) (k : ℕ) (x : CategoryTheory.Abelian.Ext.{u} X Y (k + 1)),
      let I := CategoryTheory.Injective.under Y
      let ι : Y ⟶ I := CategoryTheory.Injective.ι Y
      let Q := CategoryTheory.Limits.cokernel ι
      let π : I ⟶ Q := CategoryTheory.Limits.cokernel.π ι
      let S_c := CategoryTheory.ShortComplex.mk ι π (CategoryTheory.Limits.cokernel.condition ι)
      ∃ (hS : S_c.ShortExact) (z : CategoryTheory.Abelian.Ext.{u} X Q k),
        z.comp hS.extClass (rfl : k + 1 = k + 1) = x := by
    intro C_ab _ _ _ _ X Y k x I ι Q π S_c
    have hS : S_c.ShortExact :=
      CategoryTheory.ShortComplex.ShortExact.mk'
        (CategoryTheory.ShortComplex.exact_of_g_is_cokernel S_c
          (CategoryTheory.Limits.cokernelIsCokernel ι))
        inferInstance inferInstance
    have hx₀ : x.comp (CategoryTheory.Abelian.Ext.mk₀ S_c.f) (Nat.add_zero (k + 1)) = 0 :=
      CategoryTheory.Abelian.Ext.eq_zero_of_injective _
    obtain ⟨z, hz⟩ :=
      CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ X hS x hx₀ (rfl : k + 1 = k + 1)
    exact ⟨hS, z, hz⟩

  have hExtNatIso : ∀ {C_ab D_ab : Type (u + 1)}
      [CategoryTheory.Category.{u + 1, u + 1} C_ab] [CategoryTheory.Abelian C_ab]
      [CategoryTheory.HasExt.{u} C_ab] [CategoryTheory.EnoughInjectives C_ab]
      [CategoryTheory.Category.{u + 1, u + 1} D_ab] [CategoryTheory.Abelian D_ab]
      [CategoryTheory.HasExt.{u} D_ab]
      (F G : CategoryTheory.Functor C_ab D_ab)
      [F.Additive] [CategoryTheory.Limits.PreservesFiniteLimits F]
      [CategoryTheory.Limits.PreservesFiniteColimits F]
      [G.Additive] [CategoryTheory.Limits.PreservesFiniteLimits G]
      [CategoryTheory.Limits.PreservesFiniteColimits G]
      (η : F ≅ G) (q : ℕ) (X Y : C_ab) (x : CategoryTheory.Abelian.Ext.{u} X Y q),
      (G.mapExtAddHom X Y q) x =
        (CategoryTheory.Abelian.Ext.mk₀ (η.inv.app X)).comp
          (((F.mapExtAddHom X Y q) x).comp
            (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app Y)) (Nat.add_zero q))
          (Nat.zero_add q) := by
    intro C_ab D_ab _ _ _ _ _ _ _ F G _ _ _ _ _ _ η q
    induction q with
    | zero =>
      intro X Y x
      rw [← CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply x]
      set f := CategoryTheory.Abelian.Ext.addEquiv₀ x
      rw [CategoryTheory.Functor.mapExtAddHom_apply, CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
      congr 1
      rw [η.hom.naturality f, ← CategoryTheory.Category.assoc, η.inv_hom_id_app,
        CategoryTheory.Category.id_comp]
    | succ k ih =>
      intro X Y x
      obtain ⟨hS, z, rfl⟩ := hExtShift X Y k x
      let S_c := CategoryTheory.ShortComplex.mk (CategoryTheory.Injective.ι Y)
        (CategoryTheory.Limits.cokernel.π (CategoryTheory.Injective.ι Y))
        (CategoryTheory.Limits.cokernel.condition (CategoryTheory.Injective.ι Y))
      have hSF : (S_c.map F).ShortExact := hS.map_of_exact F
      have hSG : (S_c.map G).ShortExact := hS.map_of_exact G
      let τ_FG : S_c.map F ⟶ S_c.map G :=
        { τ₁ := η.hom.app S_c.X₁
          τ₂ := η.hom.app S_c.X₂
          τ₃ := η.hom.app S_c.X₃
          comm₁₂ := (η.hom.naturality S_c.f).symm
          comm₂₃ := (η.hom.naturality S_c.g).symm }
      have hNatExt := CategoryTheory.ShortComplex.ShortExact.extClass_naturality hSF hSG τ_FG
      change hSF.extClass.comp (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app Y)) (Nat.add_zero 1) =
        (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app S_c.X₃)).comp hSG.extClass (Nat.zero_add 1) at hNatExt
      rw [CategoryTheory.Functor.mapExtAddHom_apply G,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass G hS,
        ← CategoryTheory.Functor.mapExtAddHom_apply G,
        ih X S_c.X₃ z,
        CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ (η.inv.app X))
          (((F.mapExtAddHom X S_c.X₃ k) z).comp
            (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app S_c.X₃)) (Nat.add_zero k))
          hSG.extClass (Nat.zero_add k) (rfl : k + 1 = k + 1) (Nat.zero_add (k + 1)),
        CategoryTheory.Abelian.Ext.comp_assoc ((F.mapExtAddHom X S_c.X₃ k) z)
          (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app S_c.X₃)) hSG.extClass
          (Nat.add_zero k) (Nat.zero_add 1) (rfl : k + 0 + 1 = k + 1),
        ← hNatExt,
        ← CategoryTheory.Abelian.Ext.comp_assoc ((F.mapExtAddHom X S_c.X₃ k) z)
          hSF.extClass (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app Y))
          (rfl : k + 1 = k + 1) (Nat.add_zero 1) (rfl : k + 1 + 0 = k + 1)]
      congr 2
      rw [CategoryTheory.Functor.mapExtAddHom_apply F X Y (k + 1),
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass F hS,
        ← CategoryTheory.Functor.mapExtAddHom_apply F]

  have hExtComp : ∀ {C_ab D_ab E_ab : Type (u + 1)}
      [CategoryTheory.Category.{u + 1, u + 1} C_ab] [CategoryTheory.Abelian C_ab]
      [CategoryTheory.HasExt.{u} C_ab] [CategoryTheory.EnoughInjectives C_ab]
      [CategoryTheory.Category.{u + 1, u + 1} D_ab] [CategoryTheory.Abelian D_ab]
      [CategoryTheory.HasExt.{u} D_ab]
      [CategoryTheory.Category.{u + 1, u + 1} E_ab] [CategoryTheory.Abelian E_ab]
      [CategoryTheory.HasExt.{u} E_ab]
      (F : CategoryTheory.Functor C_ab D_ab) [F.Additive]
      [CategoryTheory.Limits.PreservesFiniteLimits F]
      [CategoryTheory.Limits.PreservesFiniteColimits F]
      (G : CategoryTheory.Functor D_ab E_ab) [G.Additive]
      [CategoryTheory.Limits.PreservesFiniteLimits G]
      [CategoryTheory.Limits.PreservesFiniteColimits G]
      (q : ℕ) (X Y : C_ab) (x : CategoryTheory.Abelian.Ext.{u} X Y q),
      ((F.comp G).mapExtAddHom X Y q) x =
        (G.mapExtAddHom (F.obj X) (F.obj Y) q) ((F.mapExtAddHom X Y q) x) := by
    intro C_ab D_ab E_ab _ _ _ _ _ _ _ _ _ _ F _ _ _ G _ _ _ q
    induction q with
    | zero =>
      intro X Y x
      rw [← CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply x]
      rw [CategoryTheory.Functor.mapExtAddHom_apply, CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀]
      rfl
    | succ k ih =>
      intro X Y x
      obtain ⟨hS, z, rfl⟩ := hExtShift X Y k x
      let S_c := CategoryTheory.ShortComplex.mk (CategoryTheory.Injective.ι Y)
        (CategoryTheory.Limits.cokernel.π (CategoryTheory.Injective.ι Y))
        (CategoryTheory.Limits.cokernel.condition (CategoryTheory.Injective.ι Y))
      have hSFG : (S_c.map (F.comp G)).ShortExact := hS.map_of_exact (F.comp G)
      have hS_iter : ((S_c.map F).map G).ShortExact := (hS.map_of_exact F).map_of_exact G
      have hExtEq : hSFG.extClass = hS_iter.extClass := rfl
      rw [CategoryTheory.Functor.mapExtAddHom_apply (F.comp G) X Y (k + 1),
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass (F.comp G) hS,
        ← CategoryTheory.Functor.mapExtAddHom_apply (F.comp G) X S_c.X₃ k,
        ih X S_c.X₃ z, hExtEq,
        CategoryTheory.Functor.mapExtAddHom_apply F X Y (k + 1),
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass F hS,
        ← CategoryTheory.Functor.mapExtAddHom_apply F X S_c.X₃ k,
        CategoryTheory.Functor.mapExtAddHom_apply G (F.obj X) (F.obj Y) (k + 1),
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass G (hS.map_of_exact F),
        ← CategoryTheory.Functor.mapExtAddHom_apply G (F.obj X) (F.obj S_c.X₃) k]

  have hCoverMem : ∀ (S : AlgebraicGeometry.Scheme.{u}) (U : S.Etale) (I : Type u)
      (V : I → S.Etale) (v : ∀ i : I, V i ⟶ U),
      (∀ y : ↥U.left, ∃ (i : I) (x : ↥(V i).left), (v i).left.base x = y) →
      CategoryTheory.Sieve.ofArrows V v ∈ S.smallEtaleTopology U := by
    intro S U I V v hsurj
    let P : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
      @AlgebraicGeometry.Etale
    let U' : P.Over ⊤ S := U
    let V' : I → P.Over ⊤ S := V
    let v' : ∀ i : I, V' i ⟶ U' := v
    change CategoryTheory.Sieve.ofArrows V' v' ∈
      (AlgebraicGeometry.Scheme.smallGrothendieckTopology P S) U'
    rw [AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        S (le_rfl : P ≤ P),
      CategoryTheory.Pretopology.mem_toGrothendieck]
    refine ⟨CategoryTheory.Presieve.ofArrows V' v', ?_,
      CategoryTheory.Sieve.le_generate (CategoryTheory.Presieve.ofArrows V' v')⟩
    change CategoryTheory.Presieve.ofArrows V' v' ∈
      (CategoryTheory.Precoverage.comap (CategoryTheory.MorphismProperty.Over.forget P ⊤ S)
        (CategoryTheory.Precoverage.over S (AlgebraicGeometry.Scheme.precoverage P))).coverings U'
    rw [CategoryTheory.Precoverage.mem_comap_iff, CategoryTheory.Presieve.map_ofArrows,
      CategoryTheory.Precoverage.over, CategoryTheory.Precoverage.mem_comap_iff,
      CategoryTheory.Presieve.map_ofArrows]
    refine ⟨?_, ?_⟩
    · rw [AlgebraicGeometry.Scheme.jointlySurjectivePrecoverage,
        CategoryTheory.Precoverage.mem_comap_iff, CategoryTheory.Presieve.map_ofArrows,
        CategoryTheory.Types.mem_jointlySurjectivePrecoverage_iff]
      intro y
      obtain ⟨i, x, hx⟩ := hsurj y
      exact ⟨_, _, CategoryTheory.Presieve.ofArrows.mk i, x, hx⟩
    · rintro _ _ ⟨i⟩
      exact CategoryTheory.MorphismProperty.of_postcomp P (v' i).left U'.hom
        U'.prop (by rw [CategoryTheory.MorphismProperty.Over.w (v' i)]; exact (V' i).prop)

  let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
    @AlgebraicGeometry.Etale

  let sliceMap : ∀ {X S : AlgebraicGeometry.Scheme.{u}} (w : Quiver.Hom X S),
      AlgebraicGeometry.Etale w → CategoryTheory.Functor X.Etale S.Etale :=
    fun {_ _} _ hw => CategoryTheory.MorphismProperty.Over.map (P := P_et) ⊤ hw

  have hSliceCont : ∀ {X S : AlgebraicGeometry.Scheme.{u}} (w : Quiver.Hom X S)
      (hw : AlgebraicGeometry.Etale w),
      (sliceMap w hw).IsContinuous X.smallEtaleTopology S.smallEtaleTopology := by
    intro X S w hw
    let j_w := sliceMap w hw
    have hCompat : CategoryTheory.CompatiblePreserving S.smallEtaleTopology j_w := by
      refine ⟨fun ℱ {Z} {T_pr} {x} hx {Y₁ Y₂ W_ov} f₁ f₂ {g₁ g₂} hg₁ hg₂ hcomm => ?_⟩
      let f₁_l : W_ov.left ⟶ Y₁.left := f₁.left
      let f₂_l : W_ov.left ⟶ Y₂.left := f₂.left
      let g₁_l : Y₁.left ⟶ Z.left := g₁.left
      let g₂_l : Y₂.left ⟶ Z.left := g₂.left
      let y₁_h : Y₁.left ⟶ X := Y₁.hom
      let y₂_h : Y₂.left ⟶ X := Y₂.hom
      let z_h : Z.left ⟶ X := Z.hom
      let wov_h : W_ov.left ⟶ S := W_ov.hom
      have hleft : f₁_l ≫ g₁_l = f₂_l ≫ g₂_l :=
        congrArg (fun k => k.left) hcomm
      have hEt_comp : (f₁_l ≫ y₁_h) ≫ w = wov_h :=
        (CategoryTheory.Category.assoc f₁_l y₁_h w).trans
          (CategoryTheory.MorphismProperty.Over.w f₁)
      have hEt' : AlgebraicGeometry.Etale (f₁_l ≫ y₁_h) :=
        CategoryTheory.MorphismProperty.of_postcomp P_et
          (f₁_l ≫ y₁_h) w hw (hEt_comp.symm ▸ W_ov.prop)
      let W' : X.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (f₁_l ≫ y₁_h) hEt'
      have hf₂_w : f₂_l ≫ y₂_h = f₁_l ≫ y₁_h := by
        have hg₁_w : g₁_l ≫ z_h = y₁_h := CategoryTheory.MorphismProperty.Over.w g₁
        have hg₂_w : g₂_l ≫ z_h = y₂_h := CategoryTheory.MorphismProperty.Over.w g₂
        rw [← hg₂_w, ← CategoryTheory.Category.assoc, ← hleft, CategoryTheory.Category.assoc, hg₁_w]
      let f₁_lift : W' ⟶ Y₁ :=
        CategoryTheory.MorphismProperty.Over.homMk (f₁_l : W'.left ⟶ Y₁.left) rfl trivial
      let f₂_lift : W' ⟶ Y₂ :=
        CategoryTheory.MorphismProperty.Over.homMk (f₂_l : W'.left ⟶ Y₂.left) hf₂_w trivial
      have hcomm' : f₁_lift ≫ g₁ = f₂_lift ≫ g₂ :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext hleft (Subsingleton.elim _ _)
      have hx_eq := hx f₁_lift f₂_lift hg₁ hg₂ hcomm'
      let ε_W : W_ov ⟶ j_w.obj W' :=
        CategoryTheory.MorphismProperty.Over.homMk (𝟙 W_ov.left : W_ov.left ⟶ (j_w.obj W').left)
          ((CategoryTheory.Category.id_comp ((f₁_l ≫ y₁_h) ≫ w)).trans hEt_comp)
          trivial
      have hε₁ : ε_W ≫ j_w.map f₁_lift = f₁ :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext
          (CategoryTheory.Category.id_comp f₁_l) (Subsingleton.elim _ _)
      have hε₂ : ε_W ≫ j_w.map f₂_lift = f₂ :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext
          (CategoryTheory.Category.id_comp f₂_l) (Subsingleton.elim _ _)
      have hmap := congrArg (CategoryTheory.ConcreteCategory.hom (ℱ.obj.map ε_W.op)) hx_eq
      change (CategoryTheory.ConcreteCategory.hom (ℱ.obj.map (j_w.map f₁_lift).op ≫ ℱ.obj.map ε_W.op))
          (x g₁ hg₁) =
        (CategoryTheory.ConcreteCategory.hom (ℱ.obj.map (j_w.map f₂_lift).op ≫ ℱ.obj.map ε_W.op))
          (x g₂ hg₂) at hmap
      rw [← ℱ.obj.map_comp, ← ℱ.obj.map_comp, ← hop_comp, ← hop_comp, hε₁, hε₂] at hmap
      exact hmap
    have hCov : CategoryTheory.CoverPreserving X.smallEtaleTopology S.smallEtaleTopology j_w := by
      refine ⟨fun {U} {S_cov} hS => ?_⟩
      let U' : P_et.Over ⊤ X := U
      let S_cov' : CategoryTheory.Sieve U' := S_cov
      have hS' : S_cov' ∈ (AlgebraicGeometry.Scheme.smallGrothendieckTopology P_et X) U' := hS
      rw [AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
          X (le_rfl : P_et ≤ P_et),
        CategoryTheory.Pretopology.mem_toGrothendieck] at hS'
      obtain ⟨R, hR, hRS⟩ := hS'
      change R ∈ (CategoryTheory.Precoverage.comap (CategoryTheory.MorphismProperty.Over.forget P_et ⊤ X)
        (CategoryTheory.Precoverage.over X (AlgebraicGeometry.Scheme.precoverage P_et))).coverings U' at hR
      rw [CategoryTheory.Precoverage.mem_comap_iff, CategoryTheory.Precoverage.over,
        CategoryTheory.Precoverage.mem_comap_iff] at hR
      have hSurjR := hR.1
      rw [AlgebraicGeometry.Scheme.jointlySurjectivePrecoverage,
        CategoryTheory.Precoverage.mem_comap_iff,
        CategoryTheory.Types.mem_jointlySurjectivePrecoverage_iff] at hSurjR
      have hExY : ∀ y : ↥U.left, ∃ (W_y : X.Etale) (f_y : W_y ⟶ U) (x_y : ↥W_y.left),
          S_cov.arrows f_y ∧ f_y.left.base x_y = y := by
        intro y
        obtain ⟨_, _, ⟨⟨⟨hf_y⟩⟩⟩, x_y, hx_y⟩ := hSurjR y
        exact ⟨_, _, x_y, hRS _ _ hf_y, hx_y⟩
      choose W_y f_y x_y hf_cov hx_eq using hExY
      have hMemPush : CategoryTheory.Sieve.ofArrows (fun y => j_w.obj (W_y y))
          (fun y => j_w.map (f_y y)) ∈ S.smallEtaleTopology (j_w.obj U) :=
        hCoverMem S (j_w.obj U) ↥U.left (fun y => j_w.obj (W_y y)) (fun y => j_w.map (f_y y))
          (fun y => ⟨y, x_y y, hx_eq y⟩)
      refine S.smallEtaleTopology.superset_covering ?_ hMemPush
      rintro Z g ⟨Z₀, hZ₀, _, ⟨y⟩, rfl⟩
      exact ⟨W_y y, f_y y, hZ₀, hf_cov y, rfl⟩
    exact CategoryTheory.Functor.isContinuous_of_coverPreserving hCompat hCov

  have hPullbackContEtale : ∀ {X S : AlgebraicGeometry.Scheme.{u}} (w : Quiver.Hom X S)
      (_hw : AlgebraicGeometry.Etale w),
      (weilAltCdSitePullback w).IsContinuous S.smallEtaleTopology X.smallEtaleTopology := by
    intro X S w hw
    have : CategoryTheory.MorphismProperty.HasPullbacksAlong P_et w :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    have : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong P_et w :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let j_w := sliceMap w hw
    let B_w := weilAltCdSitePullback w
    let adj_site : j_w ⊣ B_w :=
      CategoryTheory.MorphismProperty.Over.mapPullbackAdj P_et ⊤ w hw trivial
    have hCompat : CategoryTheory.CompatiblePreserving X.smallEtaleTopology B_w := by
      refine ⟨fun ℱ {Z} {T_pr} {x} hx {Y₁ Y₂ W_ov} f₁ f₂ {g₁ g₂} hg₁ hg₂ hcomm => ?_⟩
      let f₁' : j_w.obj W_ov ⟶ Y₁ := (adj_site.homEquiv W_ov Y₁).symm f₁
      let f₂' : j_w.obj W_ov ⟶ Y₂ := (adj_site.homEquiv W_ov Y₂).symm f₂
      have hcomm' : f₁' ≫ g₁ = f₂' ≫ g₂ := by
        apply (adj_site.homEquiv W_ov Z).injective
        rw [adj_site.homEquiv_naturality_right, adj_site.homEquiv_naturality_right,
          Equiv.apply_symm_apply, Equiv.apply_symm_apply]
        exact hcomm
      have hx_eq := hx f₁' f₂' hg₁ hg₂ hcomm'
      have hmap := congrArg
        (CategoryTheory.ConcreteCategory.hom (ℱ.obj.map (adj_site.unit.app W_ov).op)) hx_eq
      change (CategoryTheory.ConcreteCategory.hom
          (ℱ.obj.map (B_w.map f₁').op ≫ ℱ.obj.map (adj_site.unit.app W_ov).op)) (x g₁ hg₁) =
        (CategoryTheory.ConcreteCategory.hom
          (ℱ.obj.map (B_w.map f₂').op ≫ ℱ.obj.map (adj_site.unit.app W_ov).op)) (x g₂ hg₂) at hmap
      have hu₁ : adj_site.unit.app W_ov ≫ B_w.map f₁' = f₁ :=
        (adj_site.homEquiv_unit W_ov Y₁ f₁').symm.trans (Equiv.apply_symm_apply _ _)
      have hu₂ : adj_site.unit.app W_ov ≫ B_w.map f₂' = f₂ :=
        (adj_site.homEquiv_unit W_ov Y₂ f₂').symm.trans (Equiv.apply_symm_apply _ _)
      rw [← ℱ.obj.map_comp, ← ℱ.obj.map_comp, ← hop_comp, ← hop_comp, hu₁, hu₂] at hmap
      exact hmap
    have hCov : CategoryTheory.CoverPreserving S.smallEtaleTopology X.smallEtaleTopology B_w := by
      refine ⟨fun {U} {S_cov} hS => ?_⟩
      let U' : P_et.Over ⊤ S := U
      let S_cov' : CategoryTheory.Sieve U' := S_cov
      have hS' : S_cov' ∈ (AlgebraicGeometry.Scheme.smallGrothendieckTopology P_et S) U' := hS
      rw [AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
          S (le_rfl : P_et ≤ P_et),
        CategoryTheory.Pretopology.mem_toGrothendieck] at hS'
      obtain ⟨R, hR, hRS⟩ := hS'
      change R ∈ (CategoryTheory.Precoverage.comap (CategoryTheory.MorphismProperty.Over.forget P_et ⊤ S)
        (CategoryTheory.Precoverage.over S (AlgebraicGeometry.Scheme.precoverage P_et))).coverings U' at hR
      rw [CategoryTheory.Precoverage.mem_comap_iff, CategoryTheory.Precoverage.over,
        CategoryTheory.Precoverage.mem_comap_iff] at hR
      have hSurjR := hR.1
      rw [AlgebraicGeometry.Scheme.jointlySurjectivePrecoverage,
        CategoryTheory.Precoverage.mem_comap_iff,
        CategoryTheory.Types.mem_jointlySurjectivePrecoverage_iff] at hSurjR
      have hExY : ∀ y : ↥U.left, ∃ (W_y : S.Etale) (f_y : W_y ⟶ U) (x_y : ↥W_y.left),
          S_cov.arrows f_y ∧ f_y.left.base x_y = y := by
        intro y
        obtain ⟨_, _, ⟨⟨⟨hf_y⟩⟩⟩, x_y, hx_y⟩ := hSurjR y
        exact ⟨_, _, x_y, hRS _ _ hf_y, hx_y⟩
      choose W_y f_y x_y hf_cov hx_eq using hExY
      have hMemPush : CategoryTheory.Sieve.ofArrows (fun y : ↥U.left => B_w.obj (W_y y))
          (fun y : ↥U.left => B_w.map (f_y y)) ∈ X.smallEtaleTopology (B_w.obj U) := by
        refine hCoverMem X (B_w.obj U) ↥U.left (fun y => B_w.obj (W_y y))
          (fun y => B_w.map (f_y y)) (fun p => ?_)
        let u_hom : U.left ⟶ S := U.hom
        let fst_U : CategoryTheory.Limits.pullback u_hom w ⟶ U.left :=
          CategoryTheory.Limits.pullback.fst u_hom w
        let snd_U : CategoryTheory.Limits.pullback u_hom w ⟶ X :=
          CategoryTheory.Limits.pullback.snd u_hom w
        let y : ↥U.left := fst_U.base p
        let W := W_y y
        let f := f_y y
        let w_hom : W.left ⟶ S := W.hom
        let fst_W : CategoryTheory.Limits.pullback w_hom w ⟶ W.left :=
          CategoryTheory.Limits.pullback.fst w_hom w
        let snd_W : CategoryTheory.Limits.pullback w_hom w ⟶ X :=
          CategoryTheory.Limits.pullback.snd w_hom w
        let map_f : CategoryTheory.Limits.pullback w_hom w ⟶ CategoryTheory.Limits.pullback u_hom w :=
          (B_w.map f).left
        have hBottom : CategoryTheory.IsPullback fst_U snd_U u_hom w :=
          CategoryTheory.IsPullback.of_hasPullback u_hom w
        have hMapEq : map_f =
            CategoryTheory.Limits.pullback.lift (fst_W ≫ f.left) snd_W
              ((CategoryTheory.Category.assoc fst_W f.left u_hom).trans
                ((congrArg (fst_W ≫ ·) (CategoryTheory.MorphismProperty.Over.w f)).trans
                  (CategoryTheory.Limits.pullback.condition (f := w_hom) (g := w)))) :=
          CategoryTheory.MorphismProperty.Over.pullback_map_left P_et ⊤ w f
        have hTopComm : fst_W ≫ f.left = map_f ≫ fst_U :=
          ((congrArg (· ≫ fst_U) hMapEq).trans
            (CategoryTheory.Limits.pullback.lift_fst _ _ _)).symm
        have hSndComm : map_f ≫ snd_U = snd_W :=
          (congrArg (· ≫ snd_U) hMapEq).trans
            (CategoryTheory.Limits.pullback.lift_snd _ _ _)
        have hOuter : CategoryTheory.IsPullback fst_W (map_f ≫ snd_U)
            (f.left ≫ u_hom) w :=
          Eq.ndrec
            (motive := fun k₁ => CategoryTheory.IsPullback fst_W k₁ (f.left ≫ u_hom) w)
            (Eq.ndrec
              (motive := fun k₂ => CategoryTheory.IsPullback fst_W snd_W k₂ w)
              (CategoryTheory.IsPullback.of_hasPullback w_hom w)
              (CategoryTheory.MorphismProperty.Over.w f).symm)
            hSndComm.symm
        have hTopPb : CategoryTheory.IsPullback fst_W map_f f.left fst_U :=
          (CategoryTheory.IsPullback.paste_vert_iff hBottom hTopComm).mp hOuter
        obtain ⟨q, _, hq_p⟩ :=
          AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hTopPb (x_y y) p (hx_eq y)
        exact ⟨y, q, hq_p⟩
      refine X.smallEtaleTopology.superset_covering ?_ hMemPush
      rintro Z g ⟨Z₀, hZ₀, _, ⟨y⟩, rfl⟩
      exact ⟨W_y y, f_y y, hZ₀, hf_cov y, rfl⟩
    exact CategoryTheory.Functor.isContinuous_of_coverPreserving hCompat hCov

  have hSlicePkg : ∀ {X S : AlgebraicGeometry.Scheme.{u}} (w : Quiver.Hom X S)
      (hw : AlgebraicGeometry.Etale w),
      letI : (sliceMap w hw).IsContinuous X.smallEtaleTopology S.smallEtaleTopology :=
        hSliceCont w hw
      let J_X := X.smallEtaleTopology
      let J_S := S.smallEtaleTopology
      let R_w := (sliceMap w hw).sheafPushforwardContinuous AddCommGrpCat.{u} J_X J_S
      ∃ (_ : R_w.Additive)
        (_ : CategoryTheory.Limits.PreservesFiniteLimits R_w)
        (_ : CategoryTheory.Limits.PreservesFiniteColimits R_w),
        (∀ (I : CategoryTheory.Sheaf J_S AddCommGrpCat.{u}),
          CategoryTheory.Injective I → CategoryTheory.Injective (R_w.obj I)) ∧
        ∀ [hContB : (weilAltCdSitePullback w).IsContinuous J_S J_X],
          let P_push := (weilAltCdSitePullback w).sheafPushforwardContinuous
            AddCommGrpCat.{u} J_S J_X
          ∃ (adj_w : R_w ⊣ P_push),
            ∀ (A : AddCommGrpCat.{u})
              {T_X : X.Etale} (hT_X : CategoryTheory.Limits.IsTerminal T_X)
              {T_S : S.Etale} (hT_S : CategoryTheory.Limits.IsTerminal T_S),
              let C_X := CategoryTheory.constantSheaf J_X AddCommGrpCat.{u}
              let C_S := CategoryTheory.constantSheaf J_S AddCommGrpCat.{u}
              let adj_X := CategoryTheory.constantSheafAdj J_X AddCommGrpCat.{u} hT_X
              let adj_S := CategoryTheory.constantSheafAdj J_S AddCommGrpCat.{u} hT_S
              let shAdj_X := CategoryTheory.sheafificationAdjunction J_X AddCommGrpCat.{u}
              let shAdj_S := CategoryTheory.sheafificationAdjunction J_S AddCommGrpCat.{u}
              let τ_w : Quiver.Hom ((weilAltCdSitePullback w).obj T_S) T_X :=
                hT_X.from ((weilAltCdSitePullback w).obj T_S)
              let ρ_A : Quiver.Hom (R_w.obj (C_S.obj A)) (C_X.obj A) :=
                (adj_w.homEquiv (C_S.obj A) (C_X.obj A)).symm
                  ((adj_S.homEquiv A (P_push.obj (C_X.obj A))).symm
                    (CategoryTheory.CategoryStruct.comp (adj_X.unit.app A)
                      ((C_X.obj A).obj.map τ_w.op)))
              let σ_A : Quiver.Hom (C_X.obj A) (R_w.obj (C_S.obj A)) :=
                (shAdj_X.homEquiv
                  ((CategoryTheory.Functor.const (X.Etale)ᵒᵖ).obj A)
                  (R_w.obj (C_S.obj A))).symm
                  ((sliceMap w hw).op.whiskerLeft
                    (shAdj_S.unit.app ((CategoryTheory.Functor.const (S.Etale)ᵒᵖ).obj A)))
              CategoryTheory.CategoryStruct.comp σ_A ρ_A =
                CategoryTheory.CategoryStruct.id (C_X.obj A) ∧
              CategoryTheory.CategoryStruct.comp ρ_A σ_A =
                CategoryTheory.CategoryStruct.id (R_w.obj (C_S.obj A)) := by
    intro X S w hw
    have : (sliceMap w hw).IsContinuous X.smallEtaleTopology S.smallEtaleTopology :=
      hSliceCont w hw
    let J_X := X.smallEtaleTopology
    let J_S := S.smallEtaleTopology
    let j_w := sliceMap w hw
    let R_w := j_w.sheafPushforwardContinuous AddCommGrpCat.{u} J_X J_S
    have : CategoryTheory.MorphismProperty.HasPullbacksAlong P_et w :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    have : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong P_et w :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let adj_site : j_w ⊣ weilAltCdSitePullback w :=
      CategoryTheory.MorphismProperty.Over.mapPullbackAdj P_et ⊤ w hw trivial

    let hMkAdj : ∀ [hContB : (weilAltCdSitePullback w).IsContinuous J_S J_X],
        R_w ⊣ (weilAltCdSitePullback w).sheafPushforwardContinuous AddCommGrpCat.{u} J_S J_X := by
      intro hContB
      let B_w := weilAltCdSitePullback w
      refine CategoryTheory.Adjunction.mkOfUnitCounit
        { unit :=
            { app := fun ℱ =>
                { hom :=
                    { app := fun U => ℱ.obj.map (adj_site.counit.app U.unop).op
                      naturality := fun {U₁ U₂} f => by
                        change ℱ.obj.map f.unop.op ≫ ℱ.obj.map (adj_site.counit.app U₂.unop).op =
                          ℱ.obj.map (adj_site.counit.app U₁.unop).op ≫
                            ℱ.obj.map (j_w.map (B_w.map f.unop)).op
                        rw [← ℱ.obj.map_comp, ← ℱ.obj.map_comp, ← hop_comp, ← hop_comp]
                        exact congrArg (fun k => ℱ.obj.map k.op)
                          (adj_site.counit.naturality f.unop).symm } }
              naturality := fun {ℱ₁ ℱ₂} α =>
                hSheafHomExt (CategoryTheory.NatTrans.ext (funext fun U =>
                  (α.hom.naturality (adj_site.counit.app U.unop).op).symm)) }
          counit :=
            { app := fun 𝒢 =>
                { hom :=
                    { app := fun V => 𝒢.obj.map (adj_site.unit.app V.unop).op
                      naturality := fun {V₁ V₂} g => by
                        change 𝒢.obj.map (B_w.map (j_w.map g.unop)).op ≫
                            𝒢.obj.map (adj_site.unit.app V₂.unop).op =
                          𝒢.obj.map (adj_site.unit.app V₁.unop).op ≫ 𝒢.obj.map g.unop.op
                        rw [← 𝒢.obj.map_comp, ← 𝒢.obj.map_comp, ← hop_comp, ← hop_comp]
                        exact congrArg (fun k => 𝒢.obj.map k.op)
                          (adj_site.unit.naturality g.unop).symm } }
              naturality := fun {𝒢₁ 𝒢₂} β =>
                hSheafHomExt (CategoryTheory.NatTrans.ext (funext fun V =>
                  (β.hom.naturality (adj_site.unit.app V.unop).op).symm)) }
          left_triangle := by
            refine CategoryTheory.NatTrans.ext (funext fun ℱ =>
              hSheafHomExt (CategoryTheory.NatTrans.ext (funext fun V => ?_)))
            exact (ℱ.obj.map_comp _ _).symm.trans
              ((congrArg (fun k => ℱ.obj.map k.op)
                  (adj_site.left_triangle_components V.unop)).trans
                (ℱ.obj.map_id _))
          right_triangle := by
            refine CategoryTheory.NatTrans.ext (funext fun 𝒢 =>
              hSheafHomExt (CategoryTheory.NatTrans.ext (funext fun U => ?_)))
            exact (𝒢.obj.map_comp _ _).symm.trans
              ((congrArg (fun k => 𝒢.obj.map k.op)
                  (adj_site.right_triangle_components U.unop)).trans
                (𝒢.obj.map_id _)) }

    let W_w : S.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ w hw
    letI : ∀ Z : S.Etale, DecidableEq (Z ⟶ W_w) := fun _ => Classical.decEq _
    let Z_σ : ∀ (Z : S.Etale), (Z ⟶ W_w) → X.Etale := fun Z σ =>
      CategoryTheory.MorphismProperty.Over.mk ⊤ σ.left
        (CategoryTheory.MorphismProperty.of_postcomp P_et σ.left w hw
          ((CategoryTheory.MorphismProperty.Over.w σ).symm ▸ Z.prop))
    let u_σ : ∀ {Z' Z : S.Etale} (u : Z' ⟶ Z) (σ : Z ⟶ W_w), Z_σ Z' (u ≫ σ) ⟶ Z_σ Z σ :=
      fun {Z' Z} u σ =>
        CategoryTheory.MorphismProperty.Over.homMk
          (u.left : (Z_σ Z' (u ≫ σ)).left ⟶ (Z_σ Z σ).left) rfl trivial

    let cast_σ : ∀ {Z : S.Etale} {σ₁ σ₂ : Z ⟶ W_w}, σ₁ = σ₂ → (Z_σ Z σ₂ ⟶ Z_σ Z σ₁) :=
      fun {Z σ₁ σ₂} h =>
        CategoryTheory.MorphismProperty.Over.homMk
          (𝟙 Z.left : (Z_σ Z σ₂).left ⟶ (Z_σ Z σ₁).left)
          ((CategoryTheory.Category.id_comp σ₁.left).trans
            (congrArg (fun k => k.left) h))
          trivial

    have hSingleEq : ∀ (P : CategoryTheory.Functor (X.Etale)ᵒᵖ AddCommGrpCat.{u})
        {Z : S.Etale} {σ₁ σ₂ : Z ⟶ W_w} (h : σ₁ = σ₂)
        (y₁ : ↥(P.obj (Opposite.op (Z_σ Z σ₁))))
        (y₂ : ↥(P.obj (Opposite.op (Z_σ Z σ₂)))),
        (P.map (cast_σ h).op).hom y₁ = y₂ →
        DFinsupp.single (β := fun τ : Z ⟶ W_w => ↥(P.obj (Opposite.op (Z_σ Z τ)))) σ₁ y₁ =
          DFinsupp.single σ₂ y₂ := by
      intro P Z σ₁ σ₂ h y₁ y₂ hy
      subst h
      have hid : cast_σ (rfl : σ₁ = σ₁) = 𝟙 (Z_σ Z σ₁) :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext rfl (Subsingleton.elim _ _)
      rw [hid, hop_id, P.map_id, AddCommGrpCat.hom_id, AddMonoidHom.id_apply] at hy
      rw [hy]

    let L_pre : CategoryTheory.Functor
        (CategoryTheory.Functor (X.Etale)ᵒᵖ AddCommGrpCat.{u})
        (CategoryTheory.Functor (S.Etale)ᵒᵖ AddCommGrpCat.{u}) :=
      { obj := fun P =>
          { obj := fun Z =>
              AddCommGrpCat.of (Π₀ (σ : Z.unop ⟶ W_w), ↥(P.obj (Opposite.op (Z_σ Z.unop σ))))
            map := fun {Z₁ Z₂} f =>
              AddCommGrpCat.ofHom (DFinsupp.liftAddHom fun σ : Z₁.unop ⟶ W_w =>
                (DFinsupp.singleAddHom
                  (fun τ : Z₂.unop ⟶ W_w => ↥(P.obj (Opposite.op (Z_σ Z₂.unop τ))))
                  (f.unop ≫ σ)).comp (P.map (u_σ f.unop σ).op).hom)
            map_id := fun Z => by
              apply AddCommGrpCat.hom_ext
              refine DFinsupp.addHom_ext' fun σ => AddMonoidHom.ext fun x => ?_
              simp only [AddCommGrpCat.hom_ofHom, AddCommGrpCat.hom_id, AddMonoidHom.comp_apply,
                DFinsupp.singleAddHom_apply, DFinsupp.liftAddHom_apply_single,
                AddMonoidHom.id_apply]
              refine hSingleEq P (CategoryTheory.Category.id_comp σ) _ x ?_
              rw [← AddMonoidHom.comp_apply, ← AddCommGrpCat.hom_comp, ← P.map_comp, ← hop_comp]
              change ((P.map (cast_σ (CategoryTheory.Category.id_comp σ) ≫
                  u_σ (𝟙 Z.unop) σ).op).hom) x = x
              have heq : cast_σ (CategoryTheory.Category.id_comp σ) ≫
                  u_σ (𝟙 Z.unop) σ = 𝟙 (Z_σ Z.unop σ) :=
                CategoryTheory.MorphismProperty.Comma.Hom.ext
                  (CategoryTheory.Category.id_comp _) (Subsingleton.elim _ _)
              rw [heq, hop_id, P.map_id, AddCommGrpCat.hom_id, AddMonoidHom.id_apply]
            map_comp := fun {Z₁ Z₂ Z₃} f g => by
              apply AddCommGrpCat.hom_ext
              refine DFinsupp.addHom_ext' fun σ => AddMonoidHom.ext fun x => ?_
              simp only [AddCommGrpCat.hom_ofHom, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply,
                DFinsupp.singleAddHom_apply, DFinsupp.liftAddHom_apply_single]
              refine hSingleEq P (CategoryTheory.Category.assoc g.unop f.unop σ) _ _ ?_
              rw [← AddMonoidHom.comp_apply, ← AddCommGrpCat.hom_comp, ← P.map_comp, ← hop_comp,
                ← AddMonoidHom.comp_apply, ← AddCommGrpCat.hom_comp, ← P.map_comp, ← hop_comp]
              have heq : cast_σ (CategoryTheory.Category.assoc g.unop f.unop σ) ≫
                  u_σ (f ≫ g).unop σ = u_σ g.unop (f.unop ≫ σ) ≫ u_σ f.unop σ :=
                CategoryTheory.MorphismProperty.Comma.Hom.ext
                  (CategoryTheory.Category.id_comp _) (Subsingleton.elim _ _)
              rw [heq] }
        map := fun {P₁ P₂} α =>
          { app := fun Z =>
              AddCommGrpCat.ofHom (DFinsupp.mapRange.addMonoidHom
                fun σ : Z.unop ⟶ W_w => (α.app (Opposite.op (Z_σ Z.unop σ))).hom)
            naturality := fun {Z₁ Z₂} f => by
              apply AddCommGrpCat.hom_ext
              refine DFinsupp.addHom_ext' fun σ => AddMonoidHom.ext fun x => ?_
              simp only [AddCommGrpCat.hom_comp, AddCommGrpCat.hom_ofHom, AddMonoidHom.comp_apply,
                DFinsupp.singleAddHom_apply, DFinsupp.liftAddHom_apply_single,
                DFinsupp.mapRange.addMonoidHom_apply, DFinsupp.mapRange_single]
              have hnat := congrArg (fun φ : P₁.obj _ ⟶ P₂.obj _ => φ.hom x)
                (α.naturality (u_σ f.unop σ).op)
              dsimp at hnat
              rw [hnat] }
        map_id := fun P => by
          ext Z : 2
          apply AddCommGrpCat.hom_ext
          refine DFinsupp.addHom_ext' fun σ => AddMonoidHom.ext fun x => ?_
          simp
        map_comp := fun α β => by
          ext Z : 2
          apply AddCommGrpCat.hom_ext
          refine DFinsupp.addHom_ext' fun σ => AddMonoidHom.ext fun x => ?_
          simp }

    let π_V : ∀ V : X.Etale, j_w.obj V ⟶ W_w :=
      fun V => CategoryTheory.MorphismProperty.Over.homMk
        (V.hom : (j_w.obj V).left ⟶ W_w.left) rfl trivial
    let κ_inv : ∀ V : X.Etale, Z_σ (j_w.obj V) (π_V V) ⟶ V :=
      fun V => CategoryTheory.MorphismProperty.Over.homMk
        (𝟙 V.left : (Z_σ (j_w.obj V) (π_V V)).left ⟶ V.left)
        (CategoryTheory.Category.id_comp V.hom) trivial
    let lam_σ : ∀ (Z : S.Etale) (σ : Z ⟶ W_w), Z ⟶ j_w.obj (Z_σ Z σ) :=
      fun Z σ => CategoryTheory.MorphismProperty.Over.homMk
        (𝟙 Z.left : Z.left ⟶ (j_w.obj (Z_σ Z σ)).left)
        ((CategoryTheory.Category.id_comp _).trans (CategoryTheory.MorphismProperty.Over.w σ))
        trivial

    let adj_pre : L_pre ⊣ (CategoryTheory.Functor.whiskeringLeft _ _ AddCommGrpCat.{u}).obj j_w.op :=
      CategoryTheory.Adjunction.mkOfUnitCounit
        { unit :=
            { app := fun P =>
                { app := fun V =>
                    AddCommGrpCat.ofHom
                      ((DFinsupp.singleAddHom
                        (fun τ : j_w.obj V.unop ⟶ W_w =>
                          ↥(P.obj (Opposite.op (Z_σ (j_w.obj V.unop) τ))))
                        (π_V V.unop)).comp (P.map (κ_inv V.unop).op).hom)
                  naturality := fun {V₁ V₂} g => by
                    apply AddCommGrpCat.hom_ext
                    refine AddMonoidHom.ext fun x => ?_
                    dsimp [L_pre]
                    simp only [DFinsupp.singleAddHom_apply, DFinsupp.liftAddHom_apply_single,
                      AddMonoidHom.comp_apply]
                    have hπ : j_w.map g.unop ≫ π_V V₁.unop = π_V V₂.unop :=
                      CategoryTheory.MorphismProperty.Comma.Hom.ext
                        (CategoryTheory.MorphismProperty.Over.w g.unop) (Subsingleton.elim _ _)
                    refine (hSingleEq P hπ _ _ ?_).symm
                    rw [← AddMonoidHom.comp_apply, ← AddCommGrpCat.hom_comp, ← P.map_comp,
                      ← hop_comp, ← AddMonoidHom.comp_apply, ← AddCommGrpCat.hom_comp,
                      ← P.map_comp, ← hop_comp, ← AddMonoidHom.comp_apply,
                      ← AddCommGrpCat.hom_comp, ← P.map_comp]
                    have heq : ((cast_σ hπ ≫ u_σ (j_w.map g.unop) (π_V V₁.unop)) ≫
                        κ_inv V₁.unop).op = g ≫ (κ_inv V₂.unop).op := by
                      change _ = (κ_inv V₂.unop ≫ g.unop).op
                      exact congrArg Opposite.op
                        (CategoryTheory.MorphismProperty.Comma.Hom.ext
                          (CategoryTheory.Category.comp_id (𝟙 V₂.unop.left ≫ g.unop.left))
                          (Subsingleton.elim _ _))
                    rw [heq] }
              naturality := fun {P₁ P₂} α => by
                ext V : 2
                apply AddCommGrpCat.hom_ext
                refine AddMonoidHom.ext fun x => ?_
                dsimp [L_pre]
                simp only [DFinsupp.singleAddHom_apply, DFinsupp.mapRange.addMonoidHom_apply,
                  DFinsupp.mapRange_single]
                have hnat := congrArg (fun φ : P₁.obj _ ⟶ P₂.obj _ => φ.hom x)
                  (α.naturality (κ_inv V.unop).op)
                dsimp at hnat
                exact congrArg (DFinsupp.single (π_V V.unop)) hnat.symm }
          counit :=
            { app := fun Q =>
                { app := fun Z =>
                    AddCommGrpCat.ofHom (DFinsupp.liftAddHom
                      fun σ : Z.unop ⟶ W_w => (Q.map (lam_σ Z.unop σ).op).hom)
                  naturality := fun {Z₁ Z₂} f => by
                    apply AddCommGrpCat.hom_ext
                    refine DFinsupp.addHom_ext' fun σ => AddMonoidHom.ext fun x => ?_
                    dsimp [L_pre]
                    simp only [DFinsupp.singleAddHom_apply, DFinsupp.liftAddHom_apply_single,
                      AddMonoidHom.comp_apply]
                    rw [← AddMonoidHom.comp_apply, ← AddCommGrpCat.hom_comp, ← Q.map_comp,
                      ← hop_comp, ← AddMonoidHom.comp_apply, ← AddCommGrpCat.hom_comp, ← Q.map_comp]
                    have heq : (lam_σ Z₂.unop (f.unop ≫ σ) ≫ j_w.map (u_σ f.unop σ)).op =
                        (lam_σ Z₁.unop σ).op ≫ f := by
                      change _ = (f.unop ≫ lam_σ Z₁.unop σ).op
                      exact congrArg Opposite.op
                        (CategoryTheory.MorphismProperty.Comma.Hom.ext
                          ((CategoryTheory.Category.id_comp _).trans
                            (CategoryTheory.Category.comp_id _).symm)
                          (Subsingleton.elim _ _))
                    rw [heq] }
              naturality := fun {Q₁ Q₂} β => by
                ext Z : 2
                apply AddCommGrpCat.hom_ext
                refine DFinsupp.addHom_ext' fun σ => AddMonoidHom.ext fun x => ?_
                dsimp [L_pre]
                simp only [DFinsupp.singleAddHom_apply, DFinsupp.mapRange.addMonoidHom_apply,
                  DFinsupp.mapRange_single, DFinsupp.liftAddHom_apply_single]
                have hnat := congrArg (fun φ : Q₁.obj _ ⟶ Q₂.obj _ => φ.hom x)
                  (β.naturality (lam_σ Z.unop σ).op)
                dsimp at hnat
                exact hnat.symm }
          left_triangle := by
            refine CategoryTheory.NatTrans.ext (funext fun P =>
              CategoryTheory.NatTrans.ext (funext fun Z => ?_))
            apply AddCommGrpCat.hom_ext
            refine DFinsupp.addHom_ext' fun σ => AddMonoidHom.ext fun x => ?_
            dsimp [L_pre]
            simp only [DFinsupp.singleAddHom_apply, DFinsupp.mapRange.addMonoidHom_apply,
              DFinsupp.mapRange_single, DFinsupp.liftAddHom_apply_single, AddMonoidHom.comp_apply]
            have hlam : lam_σ Z.unop σ ≫ π_V (Z_σ Z.unop σ) = σ :=
              CategoryTheory.MorphismProperty.Comma.Hom.ext
                (CategoryTheory.Category.id_comp _) (Subsingleton.elim _ _)
            refine hSingleEq P hlam _ x ?_
            rw [← AddMonoidHom.comp_apply, ← AddCommGrpCat.hom_comp, ← P.map_comp,
              ← hop_comp, ← AddMonoidHom.comp_apply, ← AddCommGrpCat.hom_comp,
              ← P.map_comp, ← hop_comp]
            have hid : (cast_σ hlam ≫ u_σ (lam_σ Z.unop σ) (π_V (Z_σ Z.unop σ))) ≫
                κ_inv (Z_σ Z.unop σ) = 𝟙 (Z_σ Z.unop σ) :=
              CategoryTheory.MorphismProperty.Comma.Hom.ext
                ((CategoryTheory.Category.comp_id (𝟙 Z.unop.left ≫ 𝟙 Z.unop.left)).trans
                  (CategoryTheory.Category.id_comp (𝟙 Z.unop.left)))
                (Subsingleton.elim _ _)
            rw [hid, hop_id, P.map_id, AddCommGrpCat.hom_id, AddMonoidHom.id_apply]
          right_triangle := by
            refine CategoryTheory.NatTrans.ext (funext fun Q =>
              CategoryTheory.NatTrans.ext (funext fun V => ?_))
            apply AddCommGrpCat.hom_ext
            refine AddMonoidHom.ext fun y => ?_
            dsimp [L_pre]
            simp only [DFinsupp.singleAddHom_apply, DFinsupp.liftAddHom_apply_single]
            rw [← AddMonoidHom.comp_apply, ← AddCommGrpCat.hom_comp, ← Q.map_comp, ← hop_comp]
            have hid : lam_σ (j_w.obj V.unop) (π_V V.unop) ≫ j_w.map (κ_inv V.unop) =
                𝟙 (j_w.obj V.unop) :=
              CategoryTheory.MorphismProperty.Comma.Hom.ext
                (CategoryTheory.Category.id_comp (𝟙 V.unop.left)) (Subsingleton.elim _ _)
            rw [hid, hop_id, Q.map_id, AddCommGrpCat.hom_id, AddMonoidHom.id_apply] }

    have : L_pre.PreservesMonomorphisms := by
      refine ⟨fun {P₁ P₂} α hMono => ?_⟩
      rw [CategoryTheory.NatTrans.mono_iff_mono_app] at hMono ⊢
      intro Z
      rw [AddCommGrpCat.mono_iff_injective]
      intro f₁ f₂ hf
      ext σ
      have hInj : Function.Injective (α.app (Opposite.op (Z_σ Z.unop σ))).hom :=
        (AddCommGrpCat.mono_iff_injective _).mp (hMono _)
      apply hInj
      exact DFunLike.congr_fun hf σ

    let j_shriek := (CategoryTheory.sheafToPresheaf J_X AddCommGrpCat.{u}).comp
      (L_pre.comp (CategoryTheory.presheafToSheaf J_S AddCommGrpCat.{u}))
    let shAdj_S := CategoryTheory.sheafificationAdjunction J_S AddCommGrpCat.{u}
    let adj_shriek : j_shriek ⊣ R_w :=
      CategoryTheory.Adjunction.mkOfHomEquiv
        { homEquiv := fun 𝒢 ℱ =>
            { toFun := fun φ => ⟨adj_pre.homEquiv 𝒢.obj ℱ.obj (shAdj_S.homEquiv (L_pre.obj 𝒢.obj) ℱ φ)⟩
              invFun := fun ψ => (shAdj_S.homEquiv (L_pre.obj 𝒢.obj) ℱ).symm
                ((adj_pre.homEquiv 𝒢.obj ℱ.obj).symm ψ.hom)
              left_inv := fun φ => by simp
              right_inv := fun ψ =>
                hSheafHomExt
                  ((congrArg (adj_pre.homEquiv 𝒢.obj ℱ.obj)
                      (Equiv.apply_symm_apply (shAdj_S.homEquiv (L_pre.obj 𝒢.obj) ℱ) _)).trans
                    (Equiv.apply_symm_apply (adj_pre.homEquiv 𝒢.obj ℱ.obj) ψ.hom)) }
          homEquiv_naturality_left_symm := fun {𝒢' 𝒢 ℱ} u v => by
            apply (shAdj_S.homEquiv (L_pre.obj 𝒢'.obj) ℱ).injective
            change shAdj_S.homEquiv (L_pre.obj 𝒢'.obj) ℱ
                ((shAdj_S.homEquiv (L_pre.obj 𝒢'.obj) ℱ).symm
                  ((adj_pre.homEquiv 𝒢'.obj ℱ.obj).symm (u.hom ≫ v.hom))) =
              shAdj_S.homEquiv (L_pre.obj 𝒢'.obj) ℱ
                ((CategoryTheory.presheafToSheaf J_S AddCommGrpCat.{u}).map (L_pre.map u.hom) ≫
                  (shAdj_S.homEquiv (L_pre.obj 𝒢.obj) ℱ).symm
                    ((adj_pre.homEquiv 𝒢.obj ℱ.obj).symm v.hom))
            rw [shAdj_S.homEquiv_naturality_left, Equiv.apply_symm_apply, Equiv.apply_symm_apply]
            exact adj_pre.homEquiv_naturality_left_symm u.hom v.hom
          homEquiv_naturality_right := fun {𝒢 ℱ ℱ'} u v => by
            apply hSheafHomExt
            change adj_pre.homEquiv 𝒢.obj ℱ'.obj (shAdj_S.homEquiv (L_pre.obj 𝒢.obj) ℱ' (u ≫ v)) =
              adj_pre.homEquiv 𝒢.obj ℱ.obj (shAdj_S.homEquiv (L_pre.obj 𝒢.obj) ℱ u) ≫
                (R_w.map v).hom
            rw [shAdj_S.homEquiv_naturality_right, adj_pre.homEquiv_naturality_right]
            rfl }

    have : (CategoryTheory.presheafToSheaf J_S AddCommGrpCat.{u}).PreservesMonomorphisms :=
      inferInstance
    have : (L_pre.comp (CategoryTheory.presheafToSheaf J_S AddCommGrpCat.{u})).PreservesMonomorphisms :=
      CategoryTheory.Functor.preservesMonomorphisms_comp L_pre _
    have : j_shriek.PreservesMonomorphisms :=
      CategoryTheory.Functor.preservesMonomorphisms_comp
        (CategoryTheory.sheafToPresheaf J_X AddCommGrpCat.{u}) _

    have hContB₀ : (weilAltCdSitePullback w).IsContinuous J_S J_X :=
