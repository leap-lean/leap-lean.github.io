    let M : Matrix (Fin d) (Fin d) L := Matrix.of fun r k => (eG r) (b k)
    have hVecMul_inj : Function.Injective (fun w : Fin d → L => Matrix.vecMul w M) := by
      intro w₁ w₂ hw
