    have hσρ : σ_A ≫ ρ_A = 𝟙 (C_X.obj A) := by
      apply (shAdj_X.homEquiv P_A_X F_AX).injective
      have hL_eq : shAdj_X.homEquiv P_A_X F_AX (σ_A ≫ ρ_A) =
