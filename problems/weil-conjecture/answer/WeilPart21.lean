    have : R_w.IsRightAdjoint := adj_shriek.isRightAdjoint
    have hLim_Rw : CategoryTheory.Limits.PreservesFiniteLimits R_w := inferInstance
    have : R_w.IsLeftAdjoint := adj_w₀.isLeftAdjoint
    have hColim_Rw : CategoryTheory.Limits.PreservesFiniteColimits R_w := inferInstance

    refine ⟨hAdd_Rw, hLim_Rw, hColim_Rw, fun I hInjI => adj_shriek.map_injective I hInjI, ?_⟩
    intro hContB
    let B_w := weilAltCdSitePullback w
    let P_push := B_w.sheafPushforwardContinuous AddCommGrpCat.{u} J_S J_X
    let adj_w := @hMkAdj hContB
    refine ⟨adj_w, fun A {T_X} hT_X {T_S} hT_S => ?_⟩
    let C_X := CategoryTheory.constantSheaf J_X AddCommGrpCat.{u}
    let C_S := CategoryTheory.constantSheaf J_S AddCommGrpCat.{u}
    let adj_X := CategoryTheory.constantSheafAdj J_X AddCommGrpCat.{u} hT_X
    let adj_S := CategoryTheory.constantSheafAdj J_S AddCommGrpCat.{u} hT_S
    let shAdj_X := CategoryTheory.sheafificationAdjunction J_X AddCommGrpCat.{u}
    let τ_w : B_w.obj T_S ⟶ T_X := hT_X.from (B_w.obj T_S)
    have hTermBTS : CategoryTheory.Limits.IsTerminal (B_w.obj T_S) :=
      CategoryTheory.Limits.IsTerminal.ofUniqueHom
        (fun V => adj_site.homEquiv V T_S (hT_S.from (j_w.obj V)))
        (fun V m => (adj_site.homEquiv V T_S).symm.injective (by
          rw [Equiv.symm_apply_apply]
          exact hT_S.hom_ext _ _))
    let τ_w_iso : B_w.obj T_S ≅ T_X :=
      { hom := τ_w
        inv := hTermBTS.from T_X
        hom_inv_id := hTermBTS.hom_ext _ _
        inv_hom_id := hT_X.hom_ext _ _ }
    let α_R : (CategoryTheory.sheafSections J_X AddCommGrpCat.{u}).obj (Opposite.op T_X) ≅
        P_push.comp ((CategoryTheory.sheafSections J_S AddCommGrpCat.{u}).obj (Opposite.op T_S)) :=
      CategoryTheory.NatIso.ofComponents
        (fun 𝒢 =>
          { hom := 𝒢.obj.map τ_w_iso.hom.op
            inv := 𝒢.obj.map τ_w_iso.inv.op
            hom_inv_id := by
              change 𝒢.obj.map τ_w_iso.hom.op ≫ 𝒢.obj.map τ_w_iso.inv.op =
                𝟙 (𝒢.obj.obj (Opposite.op T_X))
              rw [← 𝒢.obj.map_comp, ← hop_comp, τ_w_iso.inv_hom_id, hop_id, 𝒢.obj.map_id]
            inv_hom_id := by
              change 𝒢.obj.map τ_w_iso.inv.op ≫ 𝒢.obj.map τ_w_iso.hom.op =
                𝟙 (𝒢.obj.obj (Opposite.op (B_w.obj T_S)))
              rw [← 𝒢.obj.map_comp, ← hop_comp, τ_w_iso.hom_inv_id, hop_id, 𝒢.obj.map_id] })
