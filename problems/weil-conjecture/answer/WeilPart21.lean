  have hm : ∀ r : ℕ, 1 ≤ ℓ ^ r := fun r => Nat.one_le_pow r ℓ hPrime.pos
  obtain ⟨hPull_ex, hPull_id, hPull_comp, _, _⟩ := weil_etale_torsion_pullback_functoriality.{u}
