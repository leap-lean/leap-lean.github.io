    have : CategoryTheory.Limits.PreservesLimitsOfShape J
        (W_proj.comp (CategoryTheory.Limits.colim (J := Idx) (C := A))) :=
      CategoryTheory.Limits.comp_preservesLimitsOfShape W_proj CategoryTheory.Limits.colim
    let cAt : ∀ P : CategoryTheory.Functor Dᵒᵖ A, CategoryTheory.Limits.Cocone (W_proj.obj P) :=
      fun P => (CategoryTheory.Functor.LeftExtension.mk
        ((F₀.op.lan (H := A)).obj P) ((F₀.op.lanUnit (H := A)).app P)).coconeAt K
    let hcAt : ∀ P : CategoryTheory.Functor Dᵒᵖ A, CategoryTheory.Limits.IsColimit (cAt P) :=
      fun P => CategoryTheory.Functor.isPointwiseLeftKanExtensionOfIsLeftKanExtension
        ((F₀.op.lan (H := A)).obj P) ((F₀.op.lanUnit (H := A)).app P) K
    let isoAt : ∀ P : CategoryTheory.Functor Dᵒᵖ A,
        ((F₀.op.lan (H := A)).obj P).obj K ≅ CategoryTheory.Limits.colimit (W_proj.obj P) :=
      fun P => (hcAt P).coconePointUniqueUpToIso (CategoryTheory.Limits.colimit.isColimit (W_proj.obj P))
    let e_eval : (F₀.op.lan (H := A)).comp ((CategoryTheory.evaluation (S₁.Etale)ᵒᵖ A).obj K) ≅
        W_proj.comp CategoryTheory.Limits.colim := by
      refine CategoryTheory.NatIso.ofComponents isoAt (fun {P₁ P₂} φ => ?_)
      apply (hcAt P₁).hom_ext
      intro j
      have h_cocone_nat : (cAt P₁).ι.app j ≫ ((F₀.op.lan (H := A)).map φ).app K =
          (W_proj.map φ).app j ≫ (cAt P₂).ι.app j := by
        dsimp [cAt, W_proj, CategoryTheory.Functor.LeftExtension.coconeAt]
        rw [CategoryTheory.Category.assoc, ((F₀.op.lan (H := A)).map φ).naturality j.hom,
          ← CategoryTheory.Category.assoc]
        have h_unit : ((F₀.op.lanUnit (H := A)).app P₁).app j.left ≫
            ((F₀.op.lan (H := A)).map φ).app (F₀.op.obj j.left) =
            φ.app j.left ≫ ((F₀.op.lanUnit (H := A)).app P₂).app j.left :=
          (congrArg (fun τ => τ.app j.left) ((F₀.op.lanUnit (H := A)).naturality φ)).symm
        rw [h_unit, CategoryTheory.Category.assoc]
      have h_iso₁ : (cAt P₁).ι.app j ≫ (isoAt P₁).hom =
          CategoryTheory.Limits.colimit.ι (W_proj.obj P₁) j :=
        (hcAt P₁).comp_coconePointUniqueUpToIso_hom
          (CategoryTheory.Limits.colimit.isColimit (W_proj.obj P₁)) j
      have h_iso₂ : (cAt P₂).ι.app j ≫ (isoAt P₂).hom =
          CategoryTheory.Limits.colimit.ι (W_proj.obj P₂) j :=
        (hcAt P₂).comp_coconePointUniqueUpToIso_hom
          (CategoryTheory.Limits.colimit.isColimit (W_proj.obj P₂)) j
      change (cAt P₁).ι.app j ≫ (((F₀.op.lan (H := A)).map φ).app K ≫ (isoAt P₂).hom) =
        (cAt P₁).ι.app j ≫ ((isoAt P₁).hom ≫ CategoryTheory.Limits.colim.map (W_proj.map φ))
      calc
        (cAt P₁).ι.app j ≫ (((F₀.op.lan (H := A)).map φ).app K ≫ (isoAt P₂).hom)
          = ((cAt P₁).ι.app j ≫ ((F₀.op.lan (H := A)).map φ).app K) ≫ (isoAt P₂).hom :=
            (CategoryTheory.Category.assoc _ _ _).symm
        _ = ((W_proj.map φ).app j ≫ (cAt P₂).ι.app j) ≫ (isoAt P₂).hom := by rw [h_cocone_nat]
        _ = (W_proj.map φ).app j ≫ ((cAt P₂).ι.app j ≫ (isoAt P₂).hom) :=
            CategoryTheory.Category.assoc _ _ _
        _ = (W_proj.map φ).app j ≫ CategoryTheory.Limits.colimit.ι (W_proj.obj P₂) j := by
            rw [h_iso₂]
        _ = CategoryTheory.Limits.colimit.ι (W_proj.obj P₁) j ≫
              CategoryTheory.Limits.colim.map (W_proj.map φ) :=
            (CategoryTheory.Limits.colimit.ι_map (W_proj.map φ) j).symm
        _ = ((cAt P₁).ι.app j ≫ (isoAt P₁).hom) ≫
              CategoryTheory.Limits.colim.map (W_proj.map φ) := by rw [h_iso₁]
        _ = (cAt P₁).ι.app j ≫ ((isoAt P₁).hom ≫
              CategoryTheory.Limits.colim.map (W_proj.map φ)) :=
            CategoryTheory.Category.assoc _ _ _
    exact CategoryTheory.Limits.preservesLimitsOfShape_of_natIso e_eval.symm

