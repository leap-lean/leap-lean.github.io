        let φ_lhs : (Fgt.obj (B.obj T₂)).left ⟶ (Fgt.obj T_Y).left :=
          CategoryTheory.Limits.pullback.fst (Fgt.obj T₂).hom g ≫ (Fgt.map w₂).left
        let φ_rhs : (Fgt.obj (B.obj T₂)).left ⟶ (Fgt.obj T_Y).left := (Fgt.map w₁).left
        have hφ_over : φ_lhs ≫ (Fgt.obj T_Y).hom ≫ Y.hom =
            φ_rhs ≫ (Fgt.obj T_Y).hom ≫ Y.hom := by
          have hw₁_over : (Fgt.map w₁).left ≫ (Fgt.obj T_Y).hom = (Fgt.obj (B.obj T₂)).hom :=
            (Fgt.map w₁).w
          have hw₂_over : (Fgt.map w₂).left ≫ (Fgt.obj T_Y).hom = (Fgt.obj T₂).hom :=
            (Fgt.map w₂).w
          have h1 : φ_lhs ≫ (Fgt.obj T_Y).hom ≫ Y.hom =
              CategoryTheory.Limits.pullback.snd (Fgt.obj T₂).hom g ≫ Y.hom :=
            (CategoryTheory.Category.assoc _ _ _).symm.trans
              ((congrArg (· ≫ Y.hom)
                ((CategoryTheory.Category.assoc
                  (CategoryTheory.Limits.pullback.fst (Fgt.obj T₂).hom g)
                  (Fgt.map w₂).left (Fgt.obj T_Y).hom).trans
                  ((congrArg (CategoryTheory.Limits.pullback.fst (Fgt.obj T₂).hom g ≫ ·)
                    hw₂_over).trans
                    (CategoryTheory.Limits.pullback.condition
                      (f := (Fgt.obj T₂).hom) (g := g))))).trans
                ((CategoryTheory.Category.assoc
                  (CategoryTheory.Limits.pullback.snd (Fgt.obj T₂).hom g) g Y.hom).trans
                  (congrArg (CategoryTheory.Limits.pullback.snd (Fgt.obj T₂).hom g ≫ ·) hg_hom)))
          have h2 : φ_rhs ≫ (Fgt.obj T_Y).hom ≫ Y.hom =
              (Fgt.obj (B.obj T₂)).hom ≫ Y.hom := by
            dsimp only [φ_rhs]
            exact (CategoryTheory.Category.assoc _ _ _).symm.trans
              (congrArg (fun (f : (Fgt.obj (B.obj T₂)).left ⟶ Z) => f ≫ Y.hom) hw₁_over)
          exact h1.trans h2.symm
        let r_TY : ↑(((Fgt.obj T_Y).left).presheaf.obj (Opposite.op ⊤)) :=
          ((Additive.toMul u_pre : Units _) :
            ↑(((Fgt.obj T_Y).left).presheaf.obj (Opposite.op ⊤)))
        have hlhs_val :
            Units.val (Additive.toMul
              ((θ_g0.app (Opposite.op T₂)).hom
                (((weilEtaleGmPresheaf Z).map w₂.op).hom u_pre)) :
              Units ↑(((Fgt.obj (B.obj T₂)).left).presheaf.obj (Opposite.op ⊤))) =
            (φ_lhs.appTop).hom r_TY :=
          (ConcreteCategory.congr_hom
            (AlgebraicGeometry.Scheme.Hom.comp_appTop
              (CategoryTheory.Limits.pullback.fst (Fgt.obj T₂).hom g)
              (Fgt.map w₂).left)
            r_TY).symm
        have hrhs_val :
            Units.val (Additive.toMul (((weilEtaleGmPresheaf Z).map w₁.op).hom u_pre) :
              Units ↑(((Fgt.obj (B.obj T₂)).left).presheaf.obj (Opposite.op ⊤))) =
            (φ_rhs.appTop).hom r_TY := rfl
        have h_mid : (φ_lhs.appTop).hom r_TY = (φ_rhs.appTop).hom r_TY := by
          dsimp only [r_TY]
          rw [hu_pre_val, map_pow, map_pow]
          congr 1
          have hmap_lhs :
              ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
                ((Fgt.obj T_Y).hom ≫ Y.hom).appTop) ≫ φ_lhs.appTop =
              (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
                (φ_lhs ≫ (Fgt.obj T_Y).hom ≫ Y.hom).appTop := by
            rw [CategoryTheory.Category.assoc, ← AlgebraicGeometry.Scheme.Hom.comp_appTop]
          have hmap_rhs :
              ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
                ((Fgt.obj T_Y).hom ≫ Y.hom).appTop) ≫ φ_rhs.appTop =
              (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
                (φ_rhs ≫ (Fgt.obj T_Y).hom ≫ Y.hom).appTop := by
            rw [CategoryTheory.Category.assoc, ← AlgebraicGeometry.Scheme.Hom.comp_appTop]
          change (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
              ((Fgt.obj T_Y).hom ≫ Y.hom).appTop) ≫ φ_lhs.appTop).hom ((ζ₀ : kˣ) : k) =
            (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
              ((Fgt.obj T_Y).hom ≫ Y.hom).appTop) ≫ φ_rhs.appTop).hom ((ζ₀ : kˣ) : k)
          rw [hmap_lhs, hmap_rhs, hφ_over]
        exact hlhs_val.trans (h_mid.trans hrhs_val.symm)
      let hEx_pull := hEx_kum.map_of_exact P_pull
      have h_nat_kum :
          hEx_pull.extClass.comp (CategoryTheory.Abelian.Ext.mk₀ πM) (Nat.add_zero 1) =
            (CategoryTheory.Abelian.Ext.mk₀ θ_g).comp hEx_kum.extClass (Nat.zero_add 1) :=
        CategoryTheory.ShortComplex.ShortExact.extClass_naturality hEx_pull hEx_kum
          (CategoryTheory.ShortComplex.homMk πM θ_g θ_g h_left_kum.symm h_right_kum.symm)
      rw [hp_g_eq (weilKummerPointClass ξ hEx_kum)]
      dsimp only [weilKummerPointClass, pull_Gm]
      change ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
          ((P_pull.mapExtAddHom Fℤ (C.obj AM) 2)
            (ξ.comp hEx_kum.extClass (Nat.one_add 1)))
          (Nat.zero_add 2)).comp (CategoryTheory.Abelian.Ext.mk₀ πM) (Nat.add_zero 2) =
        (((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
          ((P_pull.mapExtAddHom Fℤ G_gm 1) ξ) (Nat.zero_add 1)).comp
          (CategoryTheory.Abelian.Ext.mk₀ θ_g) (Nat.add_zero 1)).comp
          hEx_kum.extClass (Nat.one_add 1)
      rw [CategoryTheory.Functor.mapExtAddHom_apply, CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass P_pull hEx_kum,
        ← CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.zero_add 1) (Nat.one_add 1) (Nat.zero_add 2),
        CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.one_add 1) (Nat.add_zero 1) (Nat.add_zero 2),
        h_nat_kum,
        ← CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero 1) (Nat.zero_add 1) (Nat.one_add 1)]

theorem weil_etale_gm_degree_iso_and_kummer_cohomology_bij (X : AlgebraicGeometry.Scheme.{u}) :
    let G := weilEtaleGmSheaf X
    (∀ (K Q : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u})
      (ι_0 : G ⟶ K) (π_0 : K ⟶ Q) (h0_0 : ι_0 ≫ π_0 = 0)
      (hSE_0 : (CategoryTheory.ShortComplex.mk ι_0 π_0 h0_0).ShortExact)
      (d_Q : Q.H 0 →+ ℤ) (ξ₁ : G.H 1) (q₁ : Q.H 0),
      Subsingleton (K.H 1) →
      Nonempty (G.H 1 ≃+ ℤ) →
      (∀ k₀ : K.H 0, d_Q (k₀.comp (CategoryTheory.Abelian.Ext.mk₀ π_0) (Nat.add_zero 0)) = 0) →
      ξ₁ = q₁.comp hSE_0.extClass (Nat.zero_add 1) →
      d_Q q₁ = 1 →
      ∃ d_G : G.H 1 →+ ℤ,
        (∀ q : Q.H 0, d_G (q.comp hSE_0.extClass (Nat.zero_add 1)) = d_Q q) ∧
        d_G ξ₁ = 1 ∧
        Function.Bijective d_G ∧
        Function.Bijective (fun z : ℤ => z • ξ₁) ∧
        (∀ x : G.H 1, d_G x • ξ₁ = x)) ∧
    (∀ (ξ₁ : G.H 1),
      Function.Bijective (fun z : ℤ => z • ξ₁) →
      (∀ (m : ℕ), 1 ≤ m → ∀ x : G.H 0, ∃ y : G.H 0, m • y = x) →
      Subsingleton (G.H 2) →
      ∀ (m : ℕ), 1 ≤ m →
      ∀ (ι_kum : Quiver.Hom (weilEtaleTorsionSheaf X m) G)
        (p_kum : Quiver.Hom G G)
        (h0_kum : CategoryTheory.CategoryStruct.comp ι_kum p_kum = 0)
        (hEx_kum : (CategoryTheory.ShortComplex.mk ι_kum p_kum h0_kum).ShortExact),
        p_kum = m • CategoryTheory.CategoryStruct.id G →
        Subsingleton (weilEtaleTorsionH X m 1) ∧
        Function.Bijective (fun c : ZMod m => c.val • weilKummerPointClass ξ₁ hEx_kum)) :=
by
  classical
  let G := weilEtaleGmSheaf X
  let Fℤ := (CategoryTheory.constantSheaf X.smallEtaleTopology AddCommGrpCat.{u}).obj
    (AddCommGrpCat.of (ULift.{u} ℤ))
  have hmk₀_eq : ∀ {M : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
      (u : M ⟶ M),
      CategoryTheory.Abelian.Ext.mk₀ u = CategoryTheory.Abelian.Ext.addEquiv₀.symm u := by
    intro M u
    apply CategoryTheory.Abelian.Ext.addEquiv₀.injective
    rw [AddEquiv.apply_symm_apply]
    exact CategoryTheory.Abelian.Ext.addEquiv₀.right_inv u
  have hnsmul_ext : ∀ (q n : ℕ) (u : G.H q),
      u.comp (CategoryTheory.Abelian.Ext.mk₀ (n • CategoryTheory.CategoryStruct.id G))
        (Nat.add_zero q) = n • u := by
    intro q n u
    induction n with
    | zero =>
      rw [zero_nsmul, zero_nsmul, CategoryTheory.Abelian.Ext.mk₀_zero,
        CategoryTheory.Abelian.Ext.comp_zero]
    | succ k ih =>
      rw [succ_nsmul, succ_nsmul,
        hmk₀_eq (k • CategoryTheory.CategoryStruct.id G + CategoryTheory.CategoryStruct.id G),
        map_add, ← hmk₀_eq (k • CategoryTheory.CategoryStruct.id G),
        ← hmk₀_eq (CategoryTheory.CategoryStruct.id G),
        CategoryTheory.Abelian.Ext.comp_add, ih, CategoryTheory.Abelian.Ext.comp_mk₀_id]
  refine ⟨?_, ?_⟩
  · intro K Q ι_0 π_0 h0_0 hSE_0 d_Q ξ₁ q₁ hK1 ⟨ψ_abs⟩ hd_ker hξ₁ hdq₁
    let δ₀ : Q.H 0 →+ G.H 1 := hSE_0.extClass.postcomp Fℤ (Nat.zero_add 1)
    have hδ₀_surj : Function.Surjective δ₀ := by
      intro x
      have hx0 : x.comp (CategoryTheory.Abelian.Ext.mk₀ ι_0) (Nat.add_zero 1) = 0 :=
        @Subsingleton.elim _ hK1 _ _
      exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ hSE_0 x hx0 (Nat.zero_add 1)
    have hker_le : ∀ q : Q.H 0, δ₀ q = 0 → d_Q q = 0 := by
      intro q hq0
      obtain ⟨k₀, hk₀⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ Fℤ hSE_0 q (Nat.zero_add 1) hq0
      rw [← hk₀]
      exact hd_ker k₀
    let s_δ : G.H 1 → Q.H 0 := Function.surjInv hδ₀_surj
    have hs_δ : Function.RightInverse s_δ δ₀ := Function.rightInverse_surjInv hδ₀_surj
    let d_G : G.H 1 →+ ℤ := AddMonoidHom.liftOfRightInverse δ₀ s_δ hs_δ ⟨d_Q, hker_le⟩
    have hd_G_eval : ∀ q : Q.H 0, d_G (q.comp hSE_0.extClass (Nat.zero_add 1)) = d_Q q :=
      fun q => DFunLike.congr_fun
        (AddMonoidHom.liftOfRightInverse_comp δ₀ s_δ hs_δ ⟨d_Q, hker_le⟩) q
    have hd_G_ξ₁ : d_G ξ₁ = 1 := by
      rw [hξ₁, hd_G_eval q₁, hdq₁]
    let g₀ : G.H 1 := ψ_abs.symm 1
    let a : ℤ := ψ_abs ξ₁
    have hξ₁_g₀ : ξ₁ = a • g₀ := by
      apply ψ_abs.injective
      rw [map_zsmul, ψ_abs.apply_symm_apply]
      simp [a]
    have hab1 : a * d_G g₀ = 1 := by
      calc a * d_G g₀ = a • d_G g₀ := (zsmul_eq_mul _ _).symm
        _ = d_G (a • g₀) := (map_zsmul d_G a g₀).symm
        _ = d_G ξ₁ := by rw [← hξ₁_g₀]
        _ = 1 := hd_G_ξ₁
    have ha2 : a * a = 1 := by
      rcases Int.eq_one_or_neg_one_of_mul_eq_one hab1 with ha | ha <;> rw [ha] <;> norm_num
    have hg₀_ξ₁ : g₀ = a • ξ₁ := by
      rw [hξ₁_g₀, smul_smul, ha2, one_smul]
    have h_inv_left : ∀ x : G.H 1, d_G x • ξ₁ = x := by
      intro x
      have hx_g₀ : x = ψ_abs x • g₀ := by
        apply ψ_abs.injective
        rw [map_zsmul, ψ_abs.apply_symm_apply]
        simp
      have hx_ξ₁ : x = (ψ_abs x * a) • ξ₁ := by
        rw [hg₀_ξ₁, smul_smul] at hx_g₀
        exact hx_g₀
      have hdx : d_G x = ψ_abs x * a := by
        conv_lhs => rw [hx_ξ₁]
        rw [map_zsmul, hd_G_ξ₁]
        simp
      rw [hdx, ← hx_ξ₁]
    have h_inv_right : ∀ z : ℤ, d_G (z • ξ₁) = z := by
      intro z
      rw [map_zsmul, hd_G_ξ₁]
      simp
    exact ⟨d_G, hd_G_eval, hd_G_ξ₁,
      ⟨fun x y hxy => by rw [← h_inv_left x, ← h_inv_left y, hxy],
       fun z => ⟨z • ξ₁, h_inv_right z⟩⟩,
      ⟨fun z₁ z₂ hz => by
        rw [← h_inv_right z₁, ← h_inv_right z₂]
        exact congrArg d_G hz,
       fun x => ⟨d_G x, h_inv_left x⟩⟩,
      h_inv_left⟩
  · intro ξ₁ hBij_ξ₁ hDiv0 hVan2 m hm ι_kum p_kum h0_kum hEx_kum hp_kum
    have : NeZero m := ⟨by omega⟩
    let η_m : weilEtaleTorsionH X m 2 := weilKummerPointClass ξ₁ hEx_kum
    let Δ₁ : G.H 1 →+ weilEtaleTorsionH X m 2 := hEx_kum.extClass.postcomp Fℤ (Nat.one_add 1)
    have hΔ₁_ξ₁ : Δ₁ ξ₁ = η_m := rfl
    have hΔ₁_m0 : ∀ u : G.H 1, Δ₁ (m • u) = 0 := by
      intro u
      change (m • u).comp hEx_kum.extClass (Nat.one_add 1) = 0
      rw [← hnsmul_ext 1 m u, ← hp_kum,
        CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero 1) (Nat.zero_add 1) (Nat.one_add 1),
        hEx_kum.comp_extClass, CategoryTheory.Abelian.Ext.comp_zero]
    refine ⟨⟨fun w₁ w₂ => ?_⟩, ?_⟩
    · have hw0 : ∀ w : weilEtaleTorsionH X m 1, w = 0 := by
        intro w
        let u : G.H 1 := w.comp (CategoryTheory.Abelian.Ext.mk₀ ι_kum) (Nat.add_zero 1)
        have hmu0 : m • u = 0 := by
          rw [← hnsmul_ext 1 m u, ← hp_kum]
          dsimp only [u]
          rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ (Nat.add_zero 1),
            CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, h0_kum,
            CategoryTheory.Abelian.Ext.mk₀_zero, CategoryTheory.Abelian.Ext.comp_zero]
        obtain ⟨z, hz⟩ := hBij_ξ₁.2 u
        dsimp only at hz
        have hz0 : z = 0 := by
          have hm_z : ((m : ℤ) * z) • ξ₁ = (0 : ℤ) • ξ₁ := by
            rw [zero_smul, mul_smul, hz, natCast_zsmul, hmu0]
          have hmz0 : (m : ℤ) * z = 0 := hBij_ξ₁.1 hm_z
          rcases mul_eq_zero.mp hmz0 with hm0 | hz0
          · exfalso; omega
          · exact hz0
        have hu0 : u = 0 := by rw [← hz, hz0, zero_smul]
        obtain ⟨x, hx⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ hEx_kum w hu0 (Nat.zero_add 1)
        obtain ⟨y, hy⟩ := hDiv0 m hm x
        rw [← hx, ← hy, ← hnsmul_ext 0 m y, ← hp_kum,
          CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero 0) (Nat.zero_add 1) (Nat.zero_add 1),
          hEx_kum.comp_extClass, CategoryTheory.Abelian.Ext.comp_zero]
      rw [hw0 w₁, hw0 w₂]
    · refine ⟨fun c₁ c₂ hc => ?_, fun v => ?_⟩
      · let d : ℤ := (c₁.val : ℤ) - (c₂.val : ℤ)
        dsimp only at hc
        have hd_η : Δ₁ (d • ξ₁) = 0 := by
          rw [map_zsmul, hΔ₁_ξ₁]
          dsimp only [d]
          rw [sub_smul, natCast_zsmul, natCast_zsmul]
          exact sub_eq_zero.mpr hc
        obtain ⟨w, hw⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ Fℤ hEx_kum (d • ξ₁) (Nat.one_add 1) hd_η
        have hmw : m • w = d • ξ₁ := by
          rw [← hnsmul_ext 1 m w, ← hp_kum]
          exact hw
        obtain ⟨q, hq⟩ := hBij_ξ₁.2 w
        dsimp only at hq
        have hd_eq : d = (m : ℤ) * q := by
          apply hBij_ξ₁.1
          change d • ξ₁ = ((m : ℤ) * q) • ξ₁
          rw [mul_smul, hq, natCast_zsmul, hmw]
        have hdvd : (m : ℤ) ∣ d := ⟨q, hd_eq⟩
        have hcast0 : ((d : ℤ) : ZMod m) = 0 :=
          (ZMod.intCast_zmod_eq_zero_iff_dvd d m).mpr hdvd
        dsimp only [d] at hcast0
        rw [Int.cast_sub, Int.cast_natCast, Int.cast_natCast,
          ZMod.natCast_zmod_val, ZMod.natCast_zmod_val, sub_eq_zero] at hcast0
        exact hcast0
      · have hv0 : v.comp (CategoryTheory.Abelian.Ext.mk₀ ι_kum) (Nat.add_zero 2) = 0 :=
          @Subsingleton.elim _ hVan2 _ _
        obtain ⟨u, hu⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ hEx_kum v hv0 (Nat.one_add 1)
        obtain ⟨z, hz⟩ := hBij_ξ₁.2 u
        dsimp only at hz
        let c : ZMod m := (z : ZMod m)
        have hcast_diff : (((z - (c.val : ℤ)) : ℤ) : ZMod m) = 0 := by
          rw [Int.cast_sub, Int.cast_natCast, ZMod.natCast_zmod_val]
          exact sub_self c
        obtain ⟨q, hq⟩ :=
          (ZMod.intCast_zmod_eq_zero_iff_dvd (z - (c.val : ℤ)) m).mp hcast_diff
        have hz_eq : z = (c.val : ℤ) + (m : ℤ) * q := by linarith
        refine ⟨c, ?_⟩
        calc c.val • η_m
            = (c.val : ℤ) • Δ₁ ξ₁ + q • Δ₁ ((m : ℤ) • ξ₁) := by
              rw [natCast_zsmul ξ₁ m, hΔ₁_m0 ξ₁, smul_zero, add_zero,
                natCast_zsmul (Δ₁ ξ₁) c.val, hΔ₁_ξ₁]
          _ = Δ₁ (((c.val : ℤ) + (m : ℤ) * q) • ξ₁) := by
              rw [add_zsmul, map_add, map_zsmul Δ₁ (c.val : ℤ) ξ₁,
                mul_comm (m : ℤ) q, mul_smul, map_zsmul Δ₁ q ((m : ℤ) • ξ₁)]
          _ = Δ₁ (z • ξ₁) := by rw [← hz_eq]
          _ = Δ₁ u := by rw [hz]
          _ = v := hu

theorem weil_polyP1_p1_picard_generator_and_aut_invariance (k : Type u) [Field k] [IsAlgClosed k]
    (ι_P1 : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)))
      (weilProjectiveSpaceOver k 1).left)
    (hPropP1 : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver k 1).hom)
    (hIntP1₀ : AlgebraicGeometry.IsIntegral (weilProjectiveSpaceOver k 1).left)
    (hProjP1 : IsProjectiveOverField k (weilProjectiveSpaceOver k 1))
    (hSmP1 : AlgebraicGeometry.SmoothOfRelativeDimension 1 (weilProjectiveSpaceOver k 1).hom)
    (hOpen_ι : AlgebraicGeometry.IsOpenImmersion ι_P1)
    (hComp_ι : CategoryTheory.CategoryStruct.comp ι_P1 (weilProjectiveSpaceOver k 1).hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k)))
    (hInf_ex : ∃ s_inf : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k))
        (weilProjectiveSpaceOver k 1).left,
      CategoryTheory.CategoryStruct.comp s_inf (weilProjectiveSpaceOver k 1).hom =
        CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)) ∧
      Disjoint (Set.range ι_P1.base) (Set.range s_inf.base) ∧
      Set.range ι_P1.base ∪ Set.range s_inf.base = Set.univ) :
    ∃ ξ₁ : (weilEtaleGmSheaf (weilProjectiveSpaceOver k 1).left).H 1,
      WeilIsP1PicardGeneratorPkg k ξ₁ :=
by
  classical
  
  let P1_ov := weilProjectiveSpaceOver k 1
  let P1 := P1_ov.left
  let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
  letI : AlgebraicGeometry.IsProper P1_ov.hom := hPropP1
  letI : AlgebraicGeometry.IsIntegral P1 := hIntP1₀
  letI : AlgebraicGeometry.SmoothOfRelativeDimension 1 P1_ov.hom := hSmP1
  letI : AlgebraicGeometry.IsOpenImmersion ι_P1 := hOpen_ι
  haveI : CompactSpace ↥P1 :=
    AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace P1_ov.hom
  haveI : P1.IsSeparated := by
    have hSpecSep : S_k.IsSeparated := inferInstance
    have : AlgebraicGeometry.IsSeparated (CategoryTheory.Limits.terminal.from S_k) :=
      hSpecSep.isSeparated_terminal_from
