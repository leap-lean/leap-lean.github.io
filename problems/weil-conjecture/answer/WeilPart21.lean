        (𝒢₀.obj.map (f ≫ g).op).hom z =
          (𝒢₀.obj.map f.op).hom ((𝒢₀.obj.map g.op).hom z) :=
      fun f g z => congrArg (fun m => m.hom z) (𝒢₀.obj.map_comp g.op f.op)
    refine ⟨?_, ?_⟩
    · intro x_sec hx_sec
      have h_compat : CategoryTheory.Presieve.Arrows.PullbackCompatible 𝒢_type p_KE x_sec := by
        intro a b
        rcases hPb_K a b with ⟨e_pb_K, he_fst_K, he_snd_K⟩
        change (𝒢₀.obj.map (CategoryTheory.Limits.pullback.fst (p_KE a) (p_KE b)).op).hom
