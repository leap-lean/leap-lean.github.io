      intro k i
      change (F.map (weilAltCdSpecEtaleMap E (ι_E k i)) ≫ e_WK.inv) ≫ f_K =
        F.map (weilAltCdSpecEtaleMap E (α_E k)) ≫ e_UK.inv
      rw [Category.assoc, hf_inv, ← Category.assoc, ← F.map_comp,
