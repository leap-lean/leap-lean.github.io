  let P_fin : Type u := pair_fin.Ring

  have hu_Hfin : IsUnit (algebraMap P P_fin H_fin) := by
    have h1 : IsUnit (Polynomial.aeval pair_fin.X pair_fin.g) := pair_fin.hasMap_X.2
    rwa [hpair_fin_g, Polynomial.aeval_C] at h1

  have hu_hS : IsUnit (algebraMap P P_fin h_S) := by
    have hmul : H_fin = (h_left_fin * H_init) * h_S := by rw [hH_fin_eq]; ring
    have hu_mul : IsUnit (algebraMap P P_fin (h_left_fin * H_init) * algebraMap P P_fin h_S) := by
      rwa [← map_mul, ← hmul]
    exact isUnit_of_mul_isUnit_right hu_mul

  have hu_Hinit : IsUnit (algebraMap P P_fin H_init) := by
    have hmul : H_fin = (h_left_fin * h_S) * H_init := by rw [hH_fin_eq]; ring
    have hu_mul : IsUnit (algebraMap P P_fin (h_left_fin * h_S) * algebraMap P P_fin H_init) := by
      rwa [← map_mul, ← hmul]
    exact isUnit_of_mul_isUnit_right hu_mul

  have hInj_ι_fin : Function.Injective ι_fin := by
    have hInjLin : Function.Injective (Algebra.linearMap P F₀) := hInjPF
    have hInjRT : Function.Injective (LinearMap.rTensor P_fin (Algebra.linearMap P F₀)) :=
