        (CategoryTheory.Abelian.Ext.mk₀ ιℤ_gπ)
        (CategoryTheory.Abelian.Ext.mk₀ (η_hom Fℤ_Z)) _
        (Nat.zero_add 0) (Nat.zero_add q) (Nat.zero_add q),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hιℤ_coh,
      CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
        (CategoryTheory.Abelian.Ext.mk₀ (ιℤ_g ≫ pb_g.map ιℤ_π)) _ _,
      CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
        (CategoryTheory.Abelian.Ext.mapExactFunctor pb_g
          (CategoryTheory.Abelian.Ext.mapExactFunctor pb_π w))
        (CategoryTheory.Abelian.Ext.mk₀ (η_inv G_Z)) _,
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
      ← CategoryTheory.Category.assoc (η_inv G_Z),
      hη_inv_hom G_Z, CategoryTheory.Category.id_comp,
      ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ ιℤ_g (pb_g.map ιℤ_π),
      ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ (pb_g.map α_π_adj) α_g_adj,
      CategoryTheory.Abelian.Ext.comp_assoc
        (CategoryTheory.Abelian.Ext.mk₀ ιℤ_g)
        (CategoryTheory.Abelian.Ext.mk₀ (pb_g.map ιℤ_π)) _
        (Nat.zero_add 0) (Nat.zero_add q) (Nat.zero_add q),
      ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
        (CategoryTheory.Abelian.Ext.mapExactFunctor pb_g
          (CategoryTheory.Abelian.Ext.mapExactFunctor pb_π w))
        (CategoryTheory.Abelian.Ext.mk₀ (pb_g.map α_π_adj))
        (CategoryTheory.Abelian.Ext.mk₀ α_g_adj) (Nat.add_zero q),
      ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
        (CategoryTheory.Abelian.Ext.mk₀ (pb_g.map ιℤ_π)) _
        (CategoryTheory.Abelian.Ext.mk₀ α_g_adj) (Nat.zero_add q),
      CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
        (CategoryTheory.Abelian.Ext.mk₀ ιℤ_g) _
        (CategoryTheory.Abelian.Ext.mk₀ α_g_adj) (Nat.zero_add q)]
    congr 2
    rw [← CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀ pb_g ιℤ_π,
      ← CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀ pb_g α_π_adj,
      ← CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
      ← CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
      ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero]

  
  have hCongrCoh :
      ∀ (k₁ k₂ : Y ⟶ S) (heq : k₁ = k₂)
        (G_S : CategoryTheory.Sheaf J_S AddCommGrpCat.{u})
        (G_Y : 𝒞_Y)
        (α₁ : G_S ⟶ ((weilEtaleSitePullback k₁).sheafPushforwardContinuous
          AddCommGrpCat.{u} J_S J_Y).obj G_Y)
        (α₂ : G_S ⟶ ((weilEtaleSitePullback k₂).sheafPushforwardContinuous
          AddCommGrpCat.{u} J_S J_Y).obj G_Y),
        let e_c : weilEtaleSitePullback k₁ ≅ weilEtaleSitePullback k₂ :=
          CategoryTheory.MorphismProperty.Over.pullbackCongr heq
        α₂ = α₁ ≫ (CategoryTheory.Functor.sheafPushforwardContinuousIso e_c
          AddCommGrpCat.{u} J_S J_Y).hom.app G_Y →
        ∀ (q : ℕ) (w : G_S.H q),
          let pb₁ := (weilEtaleSitePullback k₁).sheafPullback AddCommGrpCat.{u} J_S J_Y
          let adj₁ := (weilEtaleSitePullback k₁).sheafAdjunctionContinuous
            AddCommGrpCat.{u} J_S J_Y
          let pb₂ := (weilEtaleSitePullback k₂).sheafPullback AddCommGrpCat.{u} J_S J_Y
          let adj₂ := (weilEtaleSitePullback k₂).sheafAdjunctionContinuous
            AddCommGrpCat.{u} J_S J_Y
          let ιℤ₁ := @CategoryTheory.inv _ _ _ _
            (weilEtaleConstPullbackHom k₁ hT_Y hT_S Aℤ) ((sys k₁).hConstIso hT_Y hT_S Aℤ)
          let ιℤ₂ := @CategoryTheory.inv _ _ _ _
            (weilEtaleConstPullbackHom k₂ hT_Y hT_S Aℤ) ((sys k₂).hConstIso hT_Y hT_S Aℤ)
          ((CategoryTheory.Abelian.Ext.mk₀ ιℤ₁).comp
              (CategoryTheory.Abelian.Ext.mapExactFunctor pb₁ w) (Nat.zero_add q)).comp
              (CategoryTheory.Abelian.Ext.mk₀ ((adj₁.homEquiv G_S G_Y).symm α₁))
              (Nat.add_zero q) =
            ((CategoryTheory.Abelian.Ext.mk₀ ιℤ₂).comp
              (CategoryTheory.Abelian.Ext.mapExactFunctor pb₂ w) (Nat.zero_add q)).comp
              (CategoryTheory.Abelian.Ext.mk₀ ((adj₂.homEquiv G_S G_Y).symm α₂))
              (Nat.add_zero q) := by
    intro k₁ k₂ heq G_S G_Y α₁ α₂ e_c hα₂ q w
    subst heq
    have he_hom_id : ∀ V : S.Etale, e_c.hom.app V = 𝟙 ((weilEtaleSitePullback k₁).obj V) := by
      intro V
      refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
      apply CategoryTheory.Limits.pullback.hom_ext
      · exact (CategoryTheory.MorphismProperty.Over.pullbackCongr_hom_app_left_fst
          (P := @AlgebraicGeometry.Etale) (Q := ⊤) (rfl : k₁ = k₁) V).trans
          (CategoryTheory.Category.id_comp _).symm
      · exact (CategoryTheory.Over.w
          ((AlgebraicGeometry.Scheme.Etale.forget Y).map (e_c.hom.app V))).trans
          (CategoryTheory.Category.id_comp _).symm
    have he_id : ∀ V : S.Etale, e_c.inv.app V = 𝟙 ((weilEtaleSitePullback k₁).obj V) := by
      intro V
      exact ((CategoryTheory.Category.comp_id (e_c.inv.app V)).symm.trans
        (congrArg (fun m => e_c.inv.app V ≫ m) (he_hom_id V).symm)).trans
        (e_c.inv_hom_id_app V)
    have h_iso_id : (CategoryTheory.Functor.sheafPushforwardContinuousIso e_c
        AddCommGrpCat.{u} J_S J_Y).hom.app G_Y = 𝟙 _ := by
      apply CategoryTheory.Sheaf.hom_ext
      apply CategoryTheory.NatTrans.ext
      funext W
      change G_Y.obj.map (Opposite.op (e_c.inv.app (Opposite.unop W))) = 𝟙 _
      rw [he_id (Opposite.unop W)]
      exact G_Y.obj.map_id _
    rw [h_iso_id, CategoryTheory.Category.comp_id] at hα₂
    subst hα₂
    rfl

  let e_B₁ : weilEtaleSitePullback (g_Y ≫ f) ≅ B_f.comp B_Y :=
    CategoryTheory.MorphismProperty.Over.pullbackComp g_Y f
  let e_congr : weilEtaleSitePullback (g_Y ≫ f) ≅ weilEtaleSitePullback (f ≫ g_S) :=
