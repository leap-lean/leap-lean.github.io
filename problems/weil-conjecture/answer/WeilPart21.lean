      (CategoryTheory.Abelian.Ext.mk₀ (adj_f.counit.app (pb_Y.obj G))).postcomp Fℤ_Y
          (Nat.add_zero q)
          ((CategoryTheory.Abelian.Ext.mk₀ ιℤ_f).comp
            ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ pb_f _ _ _ _ _
              Fℤ_S (pf_f.obj (pb_Y.obj G)) q) z_bc)
            (Nat.zero_add q)) =
