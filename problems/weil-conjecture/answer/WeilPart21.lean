    let e_pf₂ := CategoryTheory.Functor.sheafPushforwardContinuousIso e_B₂
      AddCommGrpCat.{u} J_S J_Y
    let e_pf_c := CategoryTheory.Functor.sheafPushforwardContinuousIso e_congr
