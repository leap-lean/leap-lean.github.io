  let F_η := fiberFun S_η g_0
  let skyPre : AddCommGrpCat.{u} → CategoryTheory.Functor (S_η.Etale)ᵒᵖ AddCommGrpCat.{u} :=
    fun A =>
      { obj := fun U => AddCommGrpCat.of (F_η.obj U.unop → ↥A)
        map := fun f => AddCommGrpCat.ofHom
          { toFun := fun φ w => φ (F_η.map f.unop w)
            map_zero' := rfl
            map_add' := fun _ _ => rfl }
        map_id := fun _ => rfl
        map_comp := fun _ _ => rfl }

  have hSkySheaf :
      ∀ A : AddCommGrpCat.{u},
        CategoryTheory.Presheaf.IsSheaf S_η.smallEtaleTopology (skyPre A) := by
    intro A E
    let X_set : Type u := ↥E →+ ↥A
    let F_set : CategoryTheory.Functor (S_η.Etale)ᵒᵖ (Type u) :=
      skyPre (AddCommGrpCat.of X_set) ⋙ CategoryTheory.forget AddCommGrpCat.{u}
    let iso_curry : (skyPre A ⋙ CategoryTheory.coyoneda.obj (Opposite.op E)) ≅ F_set :=
      CategoryTheory.NatIso.ofComponents
        (fun U =>
          { hom := CategoryTheory.ConcreteCategory.ofHom
              ⟨fun (ψ : E ⟶ AddCommGrpCat.of (F_η.obj U.unop → ↥A)) (w : F_η.obj U.unop) =>
                { toFun := fun e => ψ.hom e w
                  map_zero' := congrFun (map_zero ψ.hom) w
                  map_add' := fun e₁ e₂ => congrFun (map_add ψ.hom e₁ e₂) w }⟩
            inv := CategoryTheory.ConcreteCategory.ofHom
              ⟨fun (θ : F_η.obj U.unop → X_set) =>
                (AddCommGrpCat.ofHom
                  { toFun := fun e w => θ w e
                    map_zero' := funext fun w => map_zero (θ w)
                    map_add' := fun e₁ e₂ => funext fun w => map_add (θ w) e₁ e₂ } :
                  E ⟶ AddCommGrpCat.of (F_η.obj U.unop → ↥A))⟩
            hom_inv_id := by
              ext ψ
              apply AddCommGrpCat.hom_ext
              ext e w
              rfl
            inv_hom_id := by
              ext θ
              funext w
              ext e
              rfl })
        (fun _ => by
          ext ψ
          funext w
          ext e
          rfl)
    refine CategoryTheory.Presieve.isSheaf_iso S_η.smallEtaleTopology iso_curry.symm ?_
    intro Y R hR x hx
    have hLift : ∀ w : F_η.obj Y,
        ∃ (Z : S_η.Etale) (f : Z ⟶ Y) (_ : R.arrows f) (w' : F_η.obj Z),
          F_η.map f w' = w := by
      intro w
      obtain ⟨Z, f, w', hf, hw'⟩ := hLiftGeomPt S_η g_0 Y R hR w
      exact ⟨Z, f, hf, w', hw'⟩
    let Z_w : F_η.obj Y → S_η.Etale := fun w => (hLift w).choose
    let f_w : ∀ w : F_η.obj Y, Z_w w ⟶ Y := fun w => (hLift w).choose_spec.choose
    have hf_w : ∀ w : F_η.obj Y, R.arrows (f_w w) :=
      fun w => (hLift w).choose_spec.choose_spec.choose
    let lift_w : ∀ w : F_η.obj Y, F_η.obj (Z_w w) :=
      fun w => (hLift w).choose_spec.choose_spec.choose_spec.choose
    have hlift_eq : ∀ w : F_η.obj Y, F_η.map (f_w w) (lift_w w) = w :=
      fun w => (hLift w).choose_spec.choose_spec.choose_spec.choose_spec
    let t : F_set.obj (Opposite.op Y) := fun w => x (f_w w) (hf_w w) (lift_w w)
    refine ⟨t, ?_, ?_⟩
    · intro Z₁ f₁ hf₁
      funext w₁
      let w : F_η.obj Y := F_η.map f₁ w₁
      have _ : AlgebraicGeometry.Etale Y.hom := Y.prop
      have hEt_f₁ : AlgebraicGeometry.Etale f₁.left := by
        have hc : AlgebraicGeometry.Etale (f₁.left ≫ Y.hom) :=
          Eq.mpr (congrArg AlgebraicGeometry.Etale
            (CategoryTheory.MorphismProperty.Over.w f₁)) Z₁.prop
        exact @CategoryTheory.MorphismProperty.of_postcomp _ _
          (@AlgebraicGeometry.Etale) (@AlgebraicGeometry.Etale) _ _ _ _ f₁.left Y.hom Y.prop hc
      have hEt_fw : AlgebraicGeometry.Etale (f_w w).left := by
        have hc : AlgebraicGeometry.Etale ((f_w w).left ≫ Y.hom) :=
          Eq.mpr (congrArg AlgebraicGeometry.Etale
            (CategoryTheory.MorphismProperty.Over.w (f_w w))) (Z_w w).prop
        exact @CategoryTheory.MorphismProperty.of_postcomp _ _
          (@AlgebraicGeometry.Etale) (@AlgebraicGeometry.Etale) _ _ _ _
          (f_w w).left Y.hom Y.prop hc
      have _ : AlgebraicGeometry.Etale Z₁.hom := Z₁.prop
      have hEt_pb : AlgebraicGeometry.Etale
          (CategoryTheory.Limits.pullback.fst f₁.left (f_w w).left ≫ Z₁.hom) := inferInstance
      let P_et : S_η.Etale :=
        CategoryTheory.MorphismProperty.Over.mk ⊤
          (CategoryTheory.Limits.pullback.fst f₁.left (f_w w).left ≫ Z₁.hom) hEt_pb
      let π₁ : P_et ⟶ Z₁ :=
        CategoryTheory.MorphismProperty.Over.homMk
          (CategoryTheory.Limits.pullback.fst f₁.left (f_w w).left) rfl
      let π₂ : P_et ⟶ Z_w w :=
        CategoryTheory.MorphismProperty.Over.homMk
          (CategoryTheory.Limits.pullback.snd f₁.left (f_w w).left)
          (by
            have h1 : f₁.left ≫ Y.hom = Z₁.hom := f₁.w
            have h2 : (f_w w).left ≫ Y.hom = (Z_w w).hom := (f_w w).w
            calc
              CategoryTheory.Limits.pullback.snd f₁.left (f_w w).left ≫ (Z_w w).hom
                  = CategoryTheory.Limits.pullback.snd f₁.left (f_w w).left ≫
                      ((f_w w).left ≫ Y.hom) := by rw [h2]
              _ = (CategoryTheory.Limits.pullback.snd f₁.left (f_w w).left ≫ (f_w w).left) ≫
                    Y.hom := (Category.assoc _ _ _).symm
              _ = (CategoryTheory.Limits.pullback.fst f₁.left (f_w w).left ≫ f₁.left) ≫
                    Y.hom := by rw [CategoryTheory.Limits.pullback.condition]
              _ = CategoryTheory.Limits.pullback.fst f₁.left (f_w w).left ≫ Z₁.hom := by
                    rw [Category.assoc, h1])
      have hcomm_π : π₁ ≫ f₁ = π₂ ≫ f_w w := by
        apply CategoryTheory.MorphismProperty.Over.Hom.ext
        exact CategoryTheory.Limits.pullback.condition
      have hw_left : w₁.left ≫ f₁.left = (lift_w w).left ≫ (f_w w).left := by
        have h1 : (F_η.map (f_w w) (lift_w w)).left = w.left :=
          congrArg CategoryTheory.CommaMorphism.left (hlift_eq w)
        exact h1.symm
      let w_P : F_η.obj P_et :=
        CategoryTheory.Over.homMk
          (CategoryTheory.Limits.pullback.lift w₁.left (lift_w w).left hw_left)
          (by
            dsimp [P_et, F_η, fiberFun]
            exact (Category.assoc _ _ Z₁.hom).symm.trans
              ((congrArg (fun k => k ≫ Z₁.hom)
                (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans w₁.w))
      have hπ₁_wP : F_η.map π₁ w_P = w₁ := by
        apply CategoryTheory.Over.OverMorphism.ext
        exact CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hπ₂_wP : F_η.map π₂ w_P = lift_w w := by
        apply CategoryTheory.Over.OverMorphism.ext
        exact CategoryTheory.Limits.pullback.lift_snd _ _ _
      have hcompat := congrFun (hx π₁ π₂ hf₁ (hf_w w) hcomm_π) w_P
      change x f₁ hf₁ (F_η.map π₁ w_P) = x (f_w w) (hf_w w) (F_η.map π₂ w_P) at hcompat
      rw [hπ₁_wP, hπ₂_wP] at hcompat
      exact hcompat.symm
    · intro t' ht'
      funext w
      calc
        t' w = t' (F_η.map (f_w w) (lift_w w)) := by rw [hlift_eq w]
        _ = (F_set.map (f_w w).op t') (lift_w w) := rfl
        _ = x (f_w w) (hf_w w) (lift_w w) := congrFun (ht' (f_w w) (hf_w w)) (lift_w w)
        _ = t w := rfl

  
