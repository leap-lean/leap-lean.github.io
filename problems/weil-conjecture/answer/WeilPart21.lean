  have hDescent : ∀ (A : Type u) [CommRing A] (ι : Type u) [Fintype ι]
      (B : ι → Type u) [∀ i : ι, CommRing (B i)] [∀ i : ι, Algebra A (B i)]
      [∀ i : ι, Module.Flat A (B i)],
      (∀ p : PrimeSpectrum A,
        ∃ (i : ι) (q : PrimeSpectrum (B i)), PrimeSpectrum.comap (algebraMap A (B i)) q = p) →
      (∀ (M : Type u) [AddCommGroup M] [Module A M] (m₁ m₂ : M),
        (∀ i : ι, (1 : B i) ⊗ₜ[A] m₁ = (1 : B i) ⊗ₜ[A] m₂) → m₁ = m₂) ∧
      (∀ (u : ∀ i : ι, (B i)ˣ),
        (∀ i j : ι, ((u i : B i) ⊗ₜ[A] (1 : B j)) = ((1 : B i) ⊗ₜ[A] (u j : B j))) →
        ∃ u₀ : Aˣ, ∀ i : ι, Units.map (algebraMap A (B i)).toMonoidHom u₀ = u i) := by
    intro A _ ι _ B _ _ _ hSurj
    classical
    let P_prod : Type u := ∀ i : ι, B i
    have : Module.Flat A (DirectSum ι fun i => B i) := Module.Flat.directSum
    let eDS : P_prod ≃ₗ[A] DirectSum ι (fun i => B i) :=
      (DirectSum.linearEquivFunOnFintype A ι B).symm
    have : Module.Flat A P_prod := Module.Flat.of_linearEquiv eDS
    have hComapSurj : Function.Surjective (PrimeSpectrum.comap (algebraMap A P_prod)) := by
      intro p
