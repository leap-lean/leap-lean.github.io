              ((congrArg (adj_E.unit.app A ≫ ·) (η_i.hom.naturality τ_f.op)).trans
                ((CategoryTheory.Category.assoc _ _ _).symm.trans
                  ((congrArg (· ≫ (C_P.obj A).obj.map (B_i.map τ_f).op) h_ηi).trans
                    ((CategoryTheory.Category.assoc _ _ _).trans
                      (congrArg (adj_P.unit.app A ≫ ·)
                        (((C_P.obj A).obj.map_comp τ_i.op (B_i.map τ_f).op).symm.trans
                          (congrArg (C_P.obj A).obj.map op_comp.symm)))))))))
      have hLHS2 : adj_B.homEquiv A (pf_s.obj (pf_g.obj (C_P.obj A)))
            ((η_f ≫ pf_f.map η_i) ≫ e_pf_hom (C_P.obj A)) =
          adj_P.unit.app A ≫
            (C_P.obj A).obj.map (e_fun.inv.app T_B ≫ B_i.map τ_f ≫ τ_i).op :=
        (adj_B.homEquiv_naturality_right (η_f ≫ pf_f.map η_i) (e_pf_hom (C_P.obj A))).trans
          ((congrArg (· ≫ (C_P.obj A).obj.map (e_fun.inv.app T_B).op) hStep_f).trans
            ((CategoryTheory.Category.assoc _ _ _).trans
              (congrArg (adj_P.unit.app A ≫ ·)
                (((C_P.obj A).obj.map_comp _ _).symm.trans
                  (congrArg (C_P.obj A).obj.map op_comp.symm)))))
      have h_ηg : adj_S.unit.app A ≫ η_g.hom.app (Opposite.op T_S) =
          adj_P.unit.app A ≫ (C_P.obj A).obj.map τ_g.op :=
        (adj_S.homEquiv_unit A (pf_g.obj (C_P.obj A)) η_g).symm.trans
          (Equiv.apply_symm_apply _ _)
      have hRHS2 : adj_B.homEquiv A (pf_s.obj (pf_g.obj (C_P.obj A))) (η_s ≫ pf_s.map η_g) =
          adj_P.unit.app A ≫ (C_P.obj A).obj.map (B_g.map τ_s ≫ τ_g).op :=
        (adj_B.homEquiv_naturality_right η_s (pf_s.map η_g)).trans
          ((congrArg (· ≫ η_g.hom.app (Opposite.op (B_s.obj T_B)))
              (Equiv.apply_symm_apply _ _)).trans
            ((CategoryTheory.Category.assoc _ _ _).trans
              ((congrArg (adj_S.unit.app A ≫ ·) (η_g.hom.naturality τ_s.op)).trans
                ((CategoryTheory.Category.assoc _ _ _).symm.trans
                  ((congrArg (· ≫ (C_P.obj A).obj.map (B_g.map τ_s).op) h_ηg).trans
                    ((CategoryTheory.Category.assoc _ _ _).trans
                      (congrArg (adj_P.unit.app A ≫ ·)
                        (((C_P.obj A).obj.map_comp τ_g.op (B_g.map τ_s).op).symm.trans
                          (congrArg (C_P.obj A).obj.map op_comp.symm)))))))))
      have hμ : e_fun.inv.app T_B ≫ B_i.map τ_f ≫ τ_i = B_g.map τ_s ≫ τ_g :=
        hT_P.hom_ext _ _
      exact hLHS2.trans ((congrArg (fun ν => adj_P.unit.app A ≫ (C_P.obj A).obj.map ν.op) hμ).trans
        hRHS2.symm)

  
  
  
  refine ⟨?_, ?_, ?_⟩
  · intro X₁ X₂ h A
    obtain ⟨hc, hr, -⟩ := hSite h
    have : (weilEtaleSitePullback h).IsContinuous
        X₂.smallEtaleTopology X₁.smallEtaleTopology := hc
    have : ((weilEtaleSitePullback h).sheafPushforwardContinuous AddCommGrpCat.{u}
        X₂.smallEtaleTopology X₁.smallEtaleTopology).IsRightAdjoint := hr
    let hT₁ := weilEtaleIdTerminalIsTerminal.{u} X₁
    let hT₂ := weilEtaleIdTerminalIsTerminal.{u} X₂
    have hIso : CategoryTheory.IsIso (weilEtaleConstPullbackHom h hT₁ hT₂ A) :=
      (hConstPull h hT₁ hT₂).1 A
    exact ⟨hc, hr, ⟨@CategoryTheory.asIso _ _ _ _ _ hIso⟩⟩
  · intro X₁ X₂ h _hc _hr T₁ hT₁ T₂ hT₂ A
    exact (hConstPull h hT₁ hT₂).1 A
  · intro P₀ E B₀ S₀ i₀ f g₀ s₀ hcomm _hc_f _hc_s _hr_s _hc_i _hr_i _hc_g
      T_E hT_E T_B hT_B T_P hT_P T_S hT_S m
      pf_f pb_s pb_i pf_g Aℤ AM z_to_m C_E C_B C_P C_S adj_E adj_B η_F
      ιM_s ιℤ_i hιM_s hιℤ_i
    let adj_P := CategoryTheory.constantSheafAdj P₀.smallEtaleTopology AddCommGrpCat.{u} hT_P
    let adj_S := CategoryTheory.constantSheafAdj S₀.smallEtaleTopology AddCommGrpCat.{u} hT_S
    obtain ⟨bc₀, hbc_nat, hbc_const⟩ := hBCMate i₀ f g₀ s₀ hcomm hT_E hT_B hT_P hT_S
    obtain ⟨e₀, he₀_nat, he₀_mk₀⟩ := hPushH0 g₀ hT_P hT_S
    refine ⟨bc₀, e₀, @hbc_nat, @he₀_nat, ?_⟩
    rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
    let N₀ := pb_i.obj (C_E.obj AM)
    let Φ : C_S.obj Aℤ ⟶ pf_g.obj N₀ :=
      (C_S.map z_to_m ≫ ιM_s) ≫ (pb_s.map η_F ≫ bc₀ (C_E.obj AM))
    let Ψ : C_P.obj Aℤ ⟶ N₀ := ιℤ_i ≫ pb_i.map (C_E.map z_to_m)
    let τ_g : (weilEtaleSitePullback g₀).obj T_S ⟶ T_P :=
      hT_P.from ((weilEtaleSitePullback g₀).obj T_S)
    apply he₀_mk₀ N₀ Φ Ψ
    let πM_i := weilEtaleConstPullbackHom i₀ hT_P hT_E AM
    let πℤ_i := weilEtaleConstPullbackHom i₀ hT_P hT_E Aℤ
    let πM_s := weilEtaleConstPullbackHom s₀ hT_S hT_B AM
    have hIso_πMi : CategoryTheory.IsIso πM_i := (hConstPull i₀ hT_P hT_E).1 AM
    let e_πMi : N₀ ≅ C_P.obj AM := @CategoryTheory.asIso _ _ _ _ πM_i hIso_πMi
    let e_γ := ((CategoryTheory.sheafToPresheaf P₀.smallEtaleTopology AddCommGrpCat.{u}).mapIso
        e_πMi).app (Opposite.op ((weilEtaleSitePullback g₀).obj T_S))
    suffices h_post :
        adj_S.homEquiv Aℤ (pf_g.obj N₀) Φ ≫ e_γ.hom =
          (adj_P.homEquiv Aℤ N₀ Ψ ≫ N₀.obj.map τ_g.op) ≫ e_γ.hom by
      exact (CategoryTheory.Category.comp_id _).symm.trans
        ((congrArg (adj_S.homEquiv Aℤ (pf_g.obj N₀) Φ ≫ ·) e_γ.hom_inv_id.symm).trans
          ((CategoryTheory.Category.assoc _ _ _).symm.trans
            ((congrArg (· ≫ e_γ.inv) h_post).trans
              ((CategoryTheory.Category.assoc _ _ _).trans
                ((congrArg ((adj_P.homEquiv Aℤ N₀ Ψ ≫ N₀.obj.map τ_g.op) ≫ ·)
                    e_γ.hom_inv_id).trans
                  (CategoryTheory.Category.comp_id _))))))
    let η_g : C_S.obj AM ⟶ pf_g.obj (C_P.obj AM) :=
      (adj_S.homEquiv AM (pf_g.obj (C_P.obj AM))).symm
        (adj_P.unit.app AM ≫ (C_P.obj AM).obj.map τ_g.op)
    have hΦ_post : Φ ≫ pf_g.map πM_i = C_S.map z_to_m ≫ η_g := by
      calc
        Φ ≫ pf_g.map πM_i
            = C_S.map z_to_m ≫ ιM_s ≫ ((pb_s.map η_F ≫ bc₀ (C_E.obj AM)) ≫ pf_g.map πM_i) := by
              dsimp only [Φ]
              rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]
        _ = C_S.map z_to_m ≫ ιM_s ≫ (πM_s ≫ η_g) :=
              congrArg (fun x => C_S.map z_to_m ≫ ιM_s ≫ x) (hbc_const AM)
        _ = C_S.map z_to_m ≫ (ιM_s ≫ πM_s) ≫ η_g :=
              congrArg (C_S.map z_to_m ≫ ·) (CategoryTheory.Category.assoc _ _ _).symm
        _ = C_S.map z_to_m ≫ 𝟙 (C_S.obj AM) ≫ η_g :=
              congrArg (fun x => C_S.map z_to_m ≫ x ≫ η_g) hιM_s
        _ = C_S.map z_to_m ≫ η_g :=
              congrArg (C_S.map z_to_m ≫ ·) (CategoryTheory.Category.id_comp _)
    have hL_post : adj_S.homEquiv Aℤ (pf_g.obj N₀) Φ ≫ e_γ.hom =
        z_to_m ≫ adj_P.unit.app AM ≫ (C_P.obj AM).obj.map τ_g.op :=
      (adj_S.homEquiv_naturality_right Φ (pf_g.map πM_i)).symm.trans
        ((congrArg (adj_S.homEquiv Aℤ (pf_g.obj (C_P.obj AM))) hΦ_post).trans
          ((adj_S.homEquiv_naturality_left z_to_m η_g).trans
            (congrArg (z_to_m ≫ ·) (Equiv.apply_symm_apply _ _))))
    have hΨ_post : Ψ ≫ πM_i = C_P.map z_to_m := by
      calc
        Ψ ≫ πM_i
            = ιℤ_i ≫ (pb_i.map (C_E.map z_to_m) ≫ πM_i) :=
              CategoryTheory.Category.assoc _ _ _
        _ = ιℤ_i ≫ (πℤ_i ≫ C_P.map z_to_m) :=
              congrArg (ιℤ_i ≫ ·) ((hConstPull i₀ hT_P hT_E).2 z_to_m)
        _ = (ιℤ_i ≫ πℤ_i) ≫ C_P.map z_to_m :=
              (CategoryTheory.Category.assoc _ _ _).symm
        _ = 𝟙 (C_P.obj Aℤ) ≫ C_P.map z_to_m :=
              congrArg (· ≫ C_P.map z_to_m) hιℤ_i
        _ = C_P.map z_to_m :=
              CategoryTheory.Category.id_comp _
    have h_z_homEquiv : adj_P.homEquiv Aℤ (C_P.obj AM) (C_P.map z_to_m) =
        z_to_m ≫ adj_P.unit.app AM :=
      (adj_P.homEquiv_unit Aℤ (C_P.obj AM) (C_P.map z_to_m)).trans
        (adj_P.unit.naturality z_to_m).symm
    have hR_post : (adj_P.homEquiv Aℤ N₀ Ψ ≫ N₀.obj.map τ_g.op) ≫ e_γ.hom =
        z_to_m ≫ adj_P.unit.app AM ≫ (C_P.obj AM).obj.map τ_g.op :=
      (CategoryTheory.Category.assoc _ _ _).trans
        ((congrArg (adj_P.homEquiv Aℤ N₀ Ψ ≫ ·)
            (πM_i.hom.naturality τ_g.op :
              N₀.obj.map τ_g.op ≫
                πM_i.hom.app (Opposite.op ((weilEtaleSitePullback g₀).obj T_S)) =
              πM_i.hom.app (Opposite.op T_P) ≫ (C_P.obj AM).obj.map τ_g.op)).trans
          ((CategoryTheory.Category.assoc _ _ _).symm.trans
            ((congrArg (· ≫ (C_P.obj AM).obj.map τ_g.op)
                (adj_P.homEquiv_naturality_right Ψ πM_i).symm).trans
              ((congrArg (fun x =>
                  adj_P.homEquiv Aℤ (C_P.obj AM) x ≫ (C_P.obj AM).obj.map τ_g.op)
                  hΨ_post).trans
                ((congrArg (· ≫ (C_P.obj AM).obj.map τ_g.op) h_z_homEquiv).trans
                  (CategoryTheory.Category.assoc _ _ _))))))
    exact hL_post.trans hR_post.symm

theorem weil_algClosed_locallyFiniteType_kpoint_stalk_conservative (k : Type u) [Field k] [IsAlgClosed k]
    (hc_all : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      (weilEtaleSitePullback h).IsContinuous Z₂.smallEtaleTopology Z₁.smallEtaleTopology)
    (hr_all : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _ (weilEtaleSitePullback h)
        AddCommGrpCat.{u} _ Z₂.smallEtaleTopology Z₁.smallEtaleTopology
        (@hc_all Z₁ Z₂ h)).IsRightAdjoint)
    (hLim_all : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      CategoryTheory.Limits.PreservesFiniteLimits
        (@CategoryTheory.Functor.sheafPullback _ _ _ _ (weilEtaleSitePullback h)
          AddCommGrpCat.{u} _ Z₂.smallEtaleTopology Z₁.smallEtaleTopology
          (@hc_all Z₁ Z₂ h) (@hr_all Z₁ Z₂ h)))
    (hAdd_all : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      (@CategoryTheory.Functor.sheafPullback _ _ _ _ (weilEtaleSitePullback h)
        AddCommGrpCat.{u} _ Z₂.smallEtaleTopology Z₁.smallEtaleTopology
        (@hc_all Z₁ Z₂ h) (@hr_all Z₁ Z₂ h)).Additive)
    (S : AlgebraicGeometry.Scheme.{u})
    (f_S : Quiver.Hom S (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.LocallyOfFiniteType f_S] :
    let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
    let T_k := weilEtaleIdTerminal S_k
    let pb_of := fun {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂) =>
      @CategoryTheory.Functor.sheafPullback _ _ _ _ (weilEtaleSitePullback h)
        AddCommGrpCat.{u} _ Z₂.smallEtaleTopology Z₁.smallEtaleTopology
        (@hc_all Z₁ Z₂ h) (@hr_all Z₁ Z₂ h)
    (∀ (G : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}),
      (∀ (σ : Quiver.Hom S_k S),
        CategoryTheory.CategoryStruct.comp σ f_S = CategoryTheory.CategoryStruct.id S_k →
        Subsingleton ↑(((pb_of σ).obj G).obj.obj (Opposite.op T_k))) →
      CategoryTheory.Limits.IsZero G) ∧
    (∀ (G H : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
        (Φ : Quiver.Hom G H),
      (∀ (σ : Quiver.Hom S_k S),
        CategoryTheory.CategoryStruct.comp σ f_S = CategoryTheory.CategoryStruct.id S_k →
        Function.Bijective (((pb_of σ).map Φ).hom.app (Opposite.op T_k))) →
      CategoryTheory.IsIso Φ) :=
by
  let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
  let T_k := weilEtaleIdTerminal S_k
  let pb_of := fun {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂) =>
    @CategoryTheory.Functor.sheafPullback _ _ _ _ (weilEtaleSitePullback h)
      AddCommGrpCat.{u} _ Z₂.smallEtaleTopology Z₁.smallEtaleTopology
      (@hc_all Z₁ Z₂ h) (@hr_all Z₁ Z₂ h)
  let pf_of := fun {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂) =>
    @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _ (weilEtaleSitePullback h)
      AddCommGrpCat.{u} _ Z₂.smallEtaleTopology Z₁.smallEtaleTopology
      (@hc_all Z₁ Z₂ h)
  let adj_of := fun {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂) =>
    @CategoryTheory.Functor.sheafAdjunctionContinuous _ _ _ _ (weilEtaleSitePullback h)
      AddCommGrpCat.{u} _ Z₂.smallEtaleTopology Z₁.smallEtaleTopology
      (@hc_all Z₁ Z₂ h) (@hr_all Z₁ Z₂ h)

  
  
  have hSpec : ∀ (W : AlgebraicGeometry.Scheme.{u})
      (g_W : Quiver.Hom W S_k) [AlgebraicGeometry.LocallyOfFiniteType g_W]
      (y : ↥W),
      ∃ (s_W : Quiver.Hom S_k W),
        CategoryTheory.CategoryStruct.comp s_W g_W = CategoryTheory.CategoryStruct.id S_k ∧
        ∀ (pt : ↥S_k), y ⤳ s_W.base pt := by
    intro W g_W _ y
    obtain ⟨A, hAff_A, hy_A, -⟩ :=
      @AlgebraicGeometry.exists_isAffineOpen_mem_and_subset W y ⊤ trivial
    let R_A : CommRingCat.{u} := W.presheaf.obj (Opposite.op A)
    let ι_A : AlgebraicGeometry.Spec R_A ⟶ W := hAff_A.fromSpec
    have : AlgebraicGeometry.IsOpenImmersion ι_A := inferInstance
    have hy_range : y ∈ Set.range ⇑ι_A.base := by
      rw [hAff_A.range_fromSpec]
      exact hy_A
    obtain ⟨z, hz_y⟩ := hy_range
    let h_A : AlgebraicGeometry.Spec R_A ⟶ S_k := ι_A ≫ g_W
    have hLFT_hA : AlgebraicGeometry.LocallyOfFiniteType h_A := inferInstance
    let φ_k : CommRingCat.of k ⟶ R_A := AlgebraicGeometry.Spec.preimage h_A
    have h_map_φk : AlgebraicGeometry.Spec.map φ_k = h_A :=
      AlgebraicGeometry.Spec.map_preimage h_A
    have hFT_φk : RingHom.FiniteType (CommRingCat.Hom.hom φ_k) := by
      rw [← h_map_φk] at hLFT_hA
      exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp hLFT_hA
    let E_A : Type u := ↑R_A
    let : Algebra k E_A := (CommRingCat.Hom.hom φ_k).toAlgebra
    have hAlg_eq : algebraMap k E_A = CommRingCat.Hom.hom φ_k := rfl
    have : Algebra.FiniteType k E_A := by
      rw [← RingHom.finiteType_algebraMap, hAlg_eq]
      exact hFT_φk
    let z_spec : PrimeSpectrum E_A := z
    obtain ⟨𝔫, h𝔫_max, hz_le⟩ :=
      Ideal.exists_le_maximal z_spec.asIdeal z_spec.isPrime.ne_top
    have : 𝔫.IsMaximal := h𝔫_max
    let : Field (E_A ⧸ 𝔫) := Ideal.Quotient.field 𝔫
    let q_𝔫 : E_A →ₐ[k] (E_A ⧸ 𝔫) := Ideal.Quotient.mkₐ k 𝔫
    have : Algebra.FiniteType k (E_A ⧸ 𝔫) :=
      Algebra.FiniteType.of_surjective q_𝔫 (Ideal.Quotient.mkₐ_surjective k 𝔫)
    have : Module.Finite k (E_A ⧸ 𝔫) := finite_of_finite_type_of_isJacobsonRing k (E_A ⧸ 𝔫)
    have : Algebra.IsIntegral k (E_A ⧸ 𝔫) := Algebra.IsIntegral.of_finite k (E_A ⧸ 𝔫)
    have h_bij : Function.Bijective ⇑(algebraMap k (E_A ⧸ 𝔫)) :=
      IsAlgClosed.algebraMap_bijective_of_isIntegral (k := k) (K := E_A ⧸ 𝔫)
    let e_k : (E_A ⧸ 𝔫) ≃ₐ[k] k :=
      (AlgEquiv.ofBijective (Algebra.ofId k (E_A ⧸ 𝔫)) h_bij).symm
    let τ : E_A →ₐ[k] k := e_k.toAlgHom.comp q_𝔫
    let ψ_τ : R_A ⟶ CommRingCat.of k := CommRingCat.ofHom τ.toRingHom
    have h_retract : φ_k ≫ ψ_τ = 𝟙 (CommRingCat.of k) := by
      apply CommRingCat.hom_ext
      ext c
      change τ (algebraMap k E_A c) = c
      exact τ.commutes c
    let s_A : S_k ⟶ AlgebraicGeometry.Spec R_A := AlgebraicGeometry.Spec.map ψ_τ
    let s_W : S_k ⟶ W := s_A ≫ ι_A
    refine ⟨s_W, ?_, ?_⟩
    · calc
        s_W ≫ g_W = s_A ≫ (ι_A ≫ g_W) := CategoryTheory.Category.assoc s_A ι_A g_W
        _ = AlgebraicGeometry.Spec.map ψ_τ ≫ AlgebraicGeometry.Spec.map φ_k :=
          congrArg (s_A ≫ ·) h_map_φk.symm
        _ = AlgebraicGeometry.Spec.map (φ_k ≫ ψ_τ) :=
          (AlgebraicGeometry.Spec.map_comp φ_k ψ_τ).symm
        _ = AlgebraicGeometry.Spec.map (𝟙 (CommRingCat.of k)) := by rw [h_retract]
        _ = 𝟙 S_k := AlgebraicGeometry.Spec.map_id (CommRingCat.of k)
    · intro pt
      let z₀ : ↥(AlgebraicGeometry.Spec R_A) := s_A.base pt
      have hz_z0 : z_spec.asIdeal ≤ (z₀ : PrimeSpectrum E_A).asIdeal := by
        intro r hr
        have hq0 : q_𝔫 r = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr (hz_le hr)
        have hτ0 : τ r = 0 := by
          change e_k (q_𝔫 r) = 0
          rw [hq0, map_zero]
        change τ r ∈ (pt : PrimeSpectrum k).asIdeal
        rw [hτ0]
        exact (pt : PrimeSpectrum k).asIdeal.zero_mem
      have hz_spec : z ⤳ z₀ :=
        (PrimeSpectrum.le_iff_specializes z_spec (z₀ : PrimeSpectrum E_A)).mp hz_z0
      have hy_spec : ι_A.base z ⤳ ι_A.base z₀ :=
        Specializes.map hz_spec ι_A.continuous
      rw [hz_y] at hy_spec
      have hcomp_pt : s_W.base pt = ι_A.base z₀ :=
        AlgebraicGeometry.Scheme.Hom.comp_apply s_A ι_A pt
      rwa [← hcomp_pt] at hy_spec

  
  
  
  let fibOf : ∀ (W : AlgebraicGeometry.Scheme.{u}) (_w : S_k ⟶ W),
      CategoryTheory.Functor W.Etale (Type u) :=
    fun W w =>
      { obj := fun E => { e : S_k ⟶ E.left // e ≫ E.hom = w }
        map := fun {_ _} u =>
          TypeCat.ofHom fun e =>
            ⟨e.1 ≫ u.left,
              ((CategoryTheory.Category.assoc e.1 u.left _).trans
                (congrArg (e.1 ≫ ·) (CategoryTheory.MorphismProperty.Over.w u))).trans e.2⟩
        map_id := fun _ => by
          ext ⟨e, _⟩
          exact CategoryTheory.Category.comp_id e
        map_comp := fun u v => by
          ext ⟨e, _⟩
          exact (CategoryTheory.Category.assoc e u.left v.left).symm }
  let pt : ∀ (W : AlgebraicGeometry.Scheme.{u}) (_w : S_k ⟶ W),
      CategoryTheory.GrothendieckTopology.Point.{u} W.smallEtaleTopology :=
    fun W w => by
      letI : Unique ↥S_k := PrimeSpectrum.instUnique
      have : IsSepClosed k := inferInstance
      let fib_w := fibOf W w
      have hJoint : ∀ {E : W.Etale}, ∀ R ∈ W.smallEtaleTopology E,
          ∀ (e : fib_w.obj E),
            ∃ (Y : W.Etale) (u : Y ⟶ E) (_ : R.arrows u) (e' : fib_w.obj Y),
              fib_w.map u e' = e := by
        intro E R hR e
        let P : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme :=
          @AlgebraicGeometry.Etale
        have hR' : R ∈ (AlgebraicGeometry.Scheme.smallPretopology P P).toGrothendieck E := by
          rwa [← AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
            (P := P) (Q := P) W (le_refl P)]
        obtain ⟨Y, u, y₀, huR, huP, hy₀⟩ :=
          (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
            (P := P) (Q := P) (S := W) E R).mp hR' (e.1 default)
        have : AlgebraicGeometry.Etale u.left := huP
        let Z₀ := CategoryTheory.Limits.pullback u.left e.1
        let p : Z₀ ⟶ Y.left := CategoryTheory.Limits.pullback.fst u.left e.1
        let q : Z₀ ⟶ S_k := CategoryTheory.Limits.pullback.snd u.left e.1
        have hq_surj : Function.Surjective ⇑q := by
          intro s
          have hs : e.1 s = e.1 default := congrArg (⇑e.1) (Subsingleton.elim s default)
          obtain ⟨z, -, hz⟩ :=
            AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y₀ s (hy₀.trans hs.symm)
          exact ⟨z, hz⟩
        have hsing_mem : CategoryTheory.Presieve.singleton q ∈
            (AlgebraicGeometry.Scheme.precoverage P).coverings S_k :=
          (AlgebraicGeometry.Scheme.singleton_mem_precoverage_iff P q).mpr ⟨hq_surj, inferInstance⟩
        have hcov : CategoryTheory.Sieve.generate (CategoryTheory.Presieve.singleton q) ∈
            AlgebraicGeometry.Scheme.etaleTopology S_k :=
          CategoryTheory.Precoverage.generate_mem_toGrothendieck hsing_mem
        obtain ⟨Z, f_Z, hf_Z, z_Z, hz_Z⟩ :=
          (AlgebraicGeometry.Scheme.geometricFiber k).jointly_surjective _ hcov (𝟙 S_k)
        obtain ⟨Z', g_Z, q', hq'_sing, hfac⟩ := hf_Z
        cases hq'_sing
        change z_Z ≫ f_Z = 𝟙 S_k at hz_Z
        let σ_z : S_k ⟶ Z₀ := z_Z ≫ g_Z
        have hσ_q : σ_z ≫ q = 𝟙 S_k := by
          calc
            σ_z ≫ q = z_Z ≫ (g_Z ≫ q) := CategoryTheory.Category.assoc z_Z g_Z q
            _ = z_Z ≫ f_Z := by rw [hfac]
            _ = 𝟙 S_k := hz_Z
        let e'_mor : S_k ⟶ Y.left := σ_z ≫ p
        have he'_u : e'_mor ≫ u.left = e.1 := by
          calc
            e'_mor ≫ u.left = σ_z ≫ (p ≫ u.left) := CategoryTheory.Category.assoc σ_z p u.left
            _ = σ_z ≫ (q ≫ e.1) := by rw [CategoryTheory.Limits.pullback.condition]
            _ = (σ_z ≫ q) ≫ e.1 := (CategoryTheory.Category.assoc σ_z q e.1).symm
            _ = 𝟙 S_k ≫ e.1 := by rw [hσ_q]
            _ = e.1 := CategoryTheory.Category.id_comp e.1
        have he'_w : e'_mor ≫ Y.hom = w :=
          ((congrArg (e'_mor ≫ ·) (CategoryTheory.MorphismProperty.Over.w u).symm).trans
            ((CategoryTheory.Category.assoc e'_mor u.left E.hom).symm.trans
              (congrArg (· ≫ E.hom) he'_u))).trans e.2
        exact ⟨Y, u, huR, ⟨e'_mor, he'_w⟩, Subtype.ext he'_u⟩
      have hcof_or_empty : CategoryTheory.IsCofilteredOrEmpty fib_w.Elements := by
        refine CategoryTheory.IsCofilteredOrEmpty.mk ?_ ?_
        · intro X Y
          have : AlgebraicGeometry.Etale X.1.hom := X.1.prop
          have : AlgebraicGeometry.Etale Y.1.hom := Y.1.prop
          let fst : CategoryTheory.Limits.pullback X.1.hom Y.1.hom ⟶ X.1.left :=
            CategoryTheory.Limits.pullback.fst X.1.hom Y.1.hom
          let snd : CategoryTheory.Limits.pullback X.1.hom Y.1.hom ⟶ Y.1.left :=
            CategoryTheory.Limits.pullback.snd X.1.hom Y.1.hom
          let E₁₂ : W.Etale :=
            CategoryTheory.MorphismProperty.Over.mk ⊤ (fst ≫ X.1.hom) inferInstance
          let l : S_k ⟶ E₁₂.left :=
            CategoryTheory.Limits.pullback.lift X.2.1 Y.2.1 (X.2.2.trans Y.2.2.symm)
          have hl : l ≫ E₁₂.hom = w :=
            ((CategoryTheory.Category.assoc l fst X.1.hom).symm.trans
              (congrArg (· ≫ X.1.hom)
                (CategoryTheory.Limits.pullback.lift_fst X.2.1 Y.2.1 _))).trans X.2.2
          let Z : fib_w.Elements := CategoryTheory.Functor.elementsMk fib_w E₁₂ ⟨l, hl⟩
          let pX : E₁₂ ⟶ X.1 := CategoryTheory.MorphismProperty.Over.homMk fst rfl
          let pY : E₁₂ ⟶ Y.1 :=
            CategoryTheory.MorphismProperty.Over.homMk snd
              CategoryTheory.Limits.pullback.condition.symm
          have hpX : fib_w.map pX Z.2 = X.2 :=
            Subtype.ext (CategoryTheory.Limits.pullback.lift_fst X.2.1 Y.2.1 _)
          have hpY : fib_w.map pY Z.2 = Y.2 :=
            Subtype.ext (CategoryTheory.Limits.pullback.lift_snd X.2.1 Y.2.1 _)
          exact ⟨Z, ⟨pX, hpX⟩, ⟨pY, hpY⟩, trivial⟩
        · intro X Y u v
          have : AlgebraicGeometry.Etale X.1.hom := X.1.prop
          have : AlgebraicGeometry.Etale Y.1.hom := Y.1.prop
          let Δ := CategoryTheory.Limits.pullback.diagonal Y.1.hom
          have : AlgebraicGeometry.IsOpenImmersion Δ :=
            AlgebraicGeometry.FormallyUnramified.isOpenImmersion_diagonal Y.1.hom
          have huv_w : u.1.left ≫ Y.1.hom = v.1.left ≫ Y.1.hom :=
            (CategoryTheory.MorphismProperty.Over.w u.1).trans
              (CategoryTheory.MorphismProperty.Over.w v.1).symm
          let uv := CategoryTheory.Limits.pullback.lift u.1.left v.1.left huv_w
          let p₁ := CategoryTheory.Limits.pullback.fst Δ uv
          let j₀ : CategoryTheory.Limits.pullback Δ uv ⟶ X.1.left :=
            CategoryTheory.Limits.pullback.snd Δ uv
          let E₀ : W.Etale :=
            CategoryTheory.MorphismProperty.Over.mk ⊤ (j₀ ≫ X.1.hom) inferInstance
          have hu_pt : X.2.1 ≫ u.1.left = Y.2.1 := congrArg Subtype.val u.2
          have hv_pt : X.2.1 ≫ v.1.left = Y.2.1 := congrArg Subtype.val v.2
          let y_pt : S_k ⟶ Y.1.left := Y.2.1
          let x_pt : S_k ⟶ X.1.left := X.2.1
          have hpt_eq : y_pt ≫ Δ = x_pt ≫ uv := by
            apply CategoryTheory.Limits.pullback.hom_ext
            · exact ((CategoryTheory.Category.assoc y_pt Δ _).trans
                ((congrArg (y_pt ≫ ·) (CategoryTheory.Limits.pullback.diagonal_fst Y.1.hom)).trans
                  (CategoryTheory.Category.comp_id y_pt))).trans
                (((CategoryTheory.Category.assoc x_pt uv _).trans
                  (congrArg (x_pt ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _))).trans
                  hu_pt).symm
            · exact ((CategoryTheory.Category.assoc y_pt Δ _).trans
                ((congrArg (y_pt ≫ ·) (CategoryTheory.Limits.pullback.diagonal_snd Y.1.hom)).trans
                  (CategoryTheory.Category.comp_id y_pt))).trans
                (((CategoryTheory.Category.assoc x_pt uv _).trans
                  (congrArg (x_pt ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _))).trans
                  hv_pt).symm
          let l₀ : S_k ⟶ E₀.left := CategoryTheory.Limits.pullback.lift y_pt x_pt hpt_eq
          have hl₀ : l₀ ≫ E₀.hom = w :=
            ((CategoryTheory.Category.assoc l₀ j₀ X.1.hom).symm.trans
              (congrArg (· ≫ X.1.hom)
                (CategoryTheory.Limits.pullback.lift_snd y_pt x_pt hpt_eq))).trans X.2.2
          let Z₀ : fib_w.Elements := CategoryTheory.Functor.elementsMk fib_w E₀ ⟨l₀, hl₀⟩
          let h_mor : E₀ ⟶ X.1 := CategoryTheory.MorphismProperty.Over.homMk j₀ rfl
          have hh_pt : fib_w.map h_mor Z₀.2 = X.2 :=
            Subtype.ext (CategoryTheory.Limits.pullback.lift_snd y_pt x_pt hpt_eq)
          let h_el : Z₀ ⟶ X := ⟨h_mor, hh_pt⟩
          refine ⟨Z₀, h_el, ?_⟩
          apply CategoryTheory.Functor.Elements.hom_ext
          apply CategoryTheory.MorphismProperty.Over.Hom.ext
          change j₀ ≫ u.1.left = j₀ ≫ v.1.left
          have hcond := CategoryTheory.Limits.pullback.condition (f := Δ) (g := uv)
          have h1 : p₁ = j₀ ≫ u.1.left :=
            ((CategoryTheory.Category.comp_id p₁).symm.trans
              (congrArg (p₁ ≫ ·) (CategoryTheory.Limits.pullback.diagonal_fst Y.1.hom).symm)).trans
              (((CategoryTheory.Category.assoc p₁ Δ _).symm.trans
                (congrArg (· ≫ _) hcond)).trans
                ((CategoryTheory.Category.assoc j₀ uv _).trans
                  (congrArg (j₀ ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _))))
          have h2 : p₁ = j₀ ≫ v.1.left :=
            ((CategoryTheory.Category.comp_id p₁).symm.trans
              (congrArg (p₁ ≫ ·) (CategoryTheory.Limits.pullback.diagonal_snd Y.1.hom).symm)).trans
              (((CategoryTheory.Category.assoc p₁ Δ _).symm.trans
                (congrArg (· ≫ _) hcond)).trans
                ((CategoryTheory.Category.assoc j₀ uv _).trans
                  (congrArg (j₀ ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _))))
          exact h1.symm.trans h2
      have hne : Nonempty fib_w.Elements :=
        ⟨CategoryTheory.Functor.elementsMk fib_w
          (AlgebraicGeometry.Scheme.Etale.mk (𝟙 W)) ⟨w, CategoryTheory.Category.comp_id w⟩⟩
      have hcof : CategoryTheory.IsCofiltered fib_w.Elements :=
        @CategoryTheory.IsCofiltered.mk _ _ hcof_or_empty hne
      have hism : CategoryTheory.InitiallySmall.{u} fib_w.Elements := by
        let ι_aff : CategoryTheory.Functor W.AffineEtale W.Etale :=
          AlgebraicGeometry.Scheme.AffineEtale.Spec W
        let M : Type u := CategoryTheory.SmallModel.{u} W.AffineEtale
        let e_M := CategoryTheory.equivSmallModel.{u} W.AffineEtale
        let Idx : Type u := Sigma fun (m : M) => fib_w.obj (ι_aff.obj (e_M.inverse.obj m))
        let φ : Idx → fib_w.Elements := fun p =>
          CategoryTheory.Functor.elementsMk fib_w (ι_aff.obj (e_M.inverse.obj p.1)) p.2
        have : Small.{u} ↑(Set.range φ) := small_range φ
        refine @CategoryTheory.initiallySmall_of_small_weakly_initial_set _ _ hcof_or_empty
          (Set.range φ) _ ?_
        intro X
        have hcov_aff : CategoryTheory.Sieve.coverByImage ι_aff X.1 ∈ W.smallEtaleTopology X.1 :=
          CategoryTheory.Functor.is_cover_of_isCoverDense ι_aff W.smallEtaleTopology X.1
        obtain ⟨Y, u, hu_cov, e_Y, he_Y⟩ := hJoint _ hcov_aff X.2
        obtain ⟨A, f₁, f₂, hf₁₂⟩ := hu_cov
        let e_A : fib_w.obj (ι_aff.obj A) := fib_w.map f₁ e_Y
        have he_A : fib_w.map f₂ e_A = X.2 := by
          dsimp [e_A]
          have hmap_comp := congrArg (fun k => k e_Y) (fib_w.map_comp f₁ f₂)
          dsimp at hmap_comp
          rw [← hmap_comp, hf₁₂, he_Y]
        let m : M := e_M.functor.obj A
        let θ : ι_aff.obj (e_M.inverse.obj m) ≅ ι_aff.obj A :=
          ι_aff.mapIso (e_M.unitIso.app A).symm
        let e_m : fib_w.obj (ι_aff.obj (e_M.inverse.obj m)) := fib_w.map θ.inv e_A
        have he_m : fib_w.map (θ.hom ≫ f₂) e_m = X.2 := by
          dsimp [e_m]
          have h1 := congrArg (fun k => k e_A) (fib_w.map_comp θ.inv (θ.hom ≫ f₂))
          dsimp at h1
          rw [← h1, ← CategoryTheory.Category.assoc, θ.inv_hom_id,
            CategoryTheory.Category.id_comp, he_A]
        exact ⟨φ ⟨m, e_m⟩, ⟨⟨m, e_m⟩, rfl⟩, ⟨⟨θ.hom ≫ f₂, he_m⟩⟩⟩
      exact CategoryTheory.GrothendieckTopology.Point.mk fib_w hcof hism hJoint

  let Φ₀ := pt S_k (𝟙 S_k)
  let Ev_Tk : CategoryTheory.Functor
      (CategoryTheory.Sheaf S_k.smallEtaleTopology AddCommGrpCat.{u}) AddCommGrpCat.{u} :=
    CategoryTheory.sheafToPresheaf S_k.smallEtaleTopology AddCommGrpCat.{u} ⋙
      (CategoryTheory.evaluation (S_k.Etale)ᵒᵖ AddCommGrpCat.{u}).obj (Opposite.op T_k)
  let Sky : CategoryTheory.Functor AddCommGrpCat.{u}
      (CategoryTheory.Sheaf S_k.smallEtaleTopology AddCommGrpCat.{u}) :=
    Φ₀.skyscraperSheafFunctor (A := AddCommGrpCat.{u})
  let Idx_of : (S_k.Etale)ᵒᵖ → Type u := fun j => Opposite.unop (Φ₀.fiber.op.obj j)
  let homOfFib : ∀ (E : S_k.Etale), Φ₀.fiber.obj E → (T_k ⟶ E) :=
    fun _ s => CategoryTheory.MorphismProperty.Over.homMk s.1 s.2
  let id₀ : Idx_of (Opposite.op T_k) := ⟨𝟙 S_k, CategoryTheory.Category.id_comp (𝟙 S_k)⟩
  have h_homOfFib_id₀ : homOfFib T_k id₀ = 𝟙 T_k :=
    CategoryTheory.MorphismProperty.Over.Hom.ext rfl
  have h_homOfFib_map : ∀ {E₁ E₂ : S_k.Etale} (u : E₁ ⟶ E₂) (s : Φ₀.fiber.obj E₁),
      homOfFib E₂ (Φ₀.fiber.map u s) = homOfFib E₁ s ≫ u :=
    fun _ _ => CategoryTheory.MorphismProperty.Over.Hom.ext rfl
  have h_fib_homOfFib : ∀ (E : S_k.Etale) (s : Φ₀.fiber.obj E),
      Φ₀.fiber.map (homOfFib E s) id₀ = s :=
    fun _ s => Subtype.ext (CategoryTheory.Category.id_comp s.1)
  have hPi_lift_π : ∀ {X M : AddCommGrpCat.{u}} (I : Type u) (g : I → (X ⟶ M)) (i : I),
      CategoryTheory.Limits.Pi.lift g ≫ CategoryTheory.Limits.Pi.π (fun _ : I => M) i = g i := by
    intro X M I g i
    simp
  have hEv_nat : ∀ {X₁ X₂ M : AddCommGrpCat.{u}} (u_map : X₁ ⟶ X₂)
      (I₁ I₂ : Type u) (g₁ : I₁ → (X₁ ⟶ M)) (g₂ : I₂ → (X₂ ⟶ M)) (b : I₂ → I₁),
      (∀ s₂ : I₂, u_map ≫ g₂ s₂ = g₁ (b s₂)) →
      u_map ≫ CategoryTheory.Limits.Pi.lift g₂ =
        CategoryTheory.Limits.Pi.lift g₁ ≫ CategoryTheory.Limits.Pi.map' b (fun _ => 𝟙 M) := by
    intro X₁ X₂ M u_map I₁ I₂ g₁ g₂ b hcomm
    apply CategoryTheory.Limits.Pi.hom_ext
    intro s₂
    simp [CategoryTheory.Category.assoc, hcomm s₂]
  have hEv_right_inv : ∀ {X Y M : AddCommGrpCat.{u}} (I J : Type u)
      (a_j : X ⟶ (∏ᶜ fun _ : I => M)) (a_0 : Y ⟶ (∏ᶜ fun _ : J => M))
      (u_map : I → (X ⟶ Y)) (b : I → (J → I)) (i₀ : J),
      (∀ s : I, u_map s ≫ a_0 = a_j ≫ CategoryTheory.Limits.Pi.map' (b s) (fun _ => 𝟙 M)) →
      (∀ s : I, b s i₀ = s) →
      CategoryTheory.Limits.Pi.lift (fun s : I =>
        u_map s ≫ (a_0 ≫ CategoryTheory.Limits.Pi.π (fun _ : J => M) i₀)) = a_j := by
    intro X Y M I J a_j a_0 u_map b i₀ hnat hb
    apply CategoryTheory.Limits.Pi.hom_ext
    intro s
    have h1 := congrArg (· ≫ CategoryTheory.Limits.Pi.π (fun _ : J => M) i₀) (hnat s)
    simpa [CategoryTheory.Category.assoc, hb s] using h1
  have hEv_nat_right : ∀ {X M M' : AddCommGrpCat.{u}} (I : Type u)
      (g : I → (X ⟶ M)) (h : M ⟶ M'),
      CategoryTheory.Limits.Pi.lift (fun s : I => g s ≫ h) =
        CategoryTheory.Limits.Pi.lift g ≫ CategoryTheory.Limits.Pi.map (fun _ : I => h) := by
    intro X M M' I g h
    apply CategoryTheory.Limits.Pi.hom_ext
    intro s
    simp [CategoryTheory.Category.assoc]

  let adj_ev : CategoryTheory.Adjunction Ev_Tk Sky :=
    CategoryTheory.Adjunction.mkOfHomEquiv
      { homEquiv := fun F M =>
          { toFun := fun f =>
              { hom :=
                  { app := fun j =>
                      CategoryTheory.Limits.Pi.lift fun (s : Idx_of j) =>
                        F.obj.map (homOfFib j.unop s).op ≫ f
                    naturality := fun {j₁ j₂} u => by
                      change F.obj.map u ≫ _ =
                        _ ≫ (Φ₀.skyscraperPresheafFunctor.obj M).map u
                      rw [CategoryTheory.GrothendieckTopology.Point.skyscraperPresheafFunctor_obj_map]
                      refine hEv_nat (F.obj.map u) (Idx_of j₁) (Idx_of j₂)
                        (fun s => F.obj.map (homOfFib j₁.unop s).op ≫ f)
                        (fun s => F.obj.map (homOfFib j₂.unop s).op ≫ f)
                        (Φ₀.fiber.map u.unop) (fun s₂ => ?_)
                      exact ((CategoryTheory.Category.assoc _ _ _).symm.trans
                        (congrArg (· ≫ f)
                          (F.obj.map_comp u (homOfFib j₂.unop s₂).op).symm)).trans
                        (congrArg (fun m : T_k ⟶ j₁.unop => F.obj.map m.op ≫ f)
                          (h_homOfFib_map u.unop s₂).symm) } }
            invFun := fun α =>
              α.hom.app (Opposite.op T_k) ≫
                CategoryTheory.Limits.Pi.π (fun _ : Idx_of (Opposite.op T_k) => M) id₀
            left_inv := fun f =>
              (hPi_lift_π (Idx_of (Opposite.op T_k))
                (fun s => F.obj.map (homOfFib T_k s).op ≫ f) id₀).trans
                (((congrArg (fun m : T_k ⟶ T_k => F.obj.map m.op ≫ f) h_homOfFib_id₀).trans
                  (congrArg (· ≫ f) (F.obj.map_id (Opposite.op T_k)))).trans
                  (CategoryTheory.Category.id_comp f))
            right_inv := fun α => by
              apply CategoryTheory.Sheaf.hom_ext
              ext j : 2
              exact hEv_right_inv (Idx_of j) (Idx_of (Opposite.op T_k))
                (α.hom.app j) (α.hom.app (Opposite.op T_k))
                (fun s => F.obj.map (homOfFib j.unop s).op)
                (fun s => Φ₀.fiber.map (homOfFib j.unop s)) id₀
                (fun s => (α.hom.naturality (homOfFib j.unop s).op).trans
                  (congrArg (α.hom.app j ≫ ·)
                    (Φ₀.skyscraperPresheafFunctor_obj_map M (homOfFib j.unop s).op)))
                (fun s => h_fib_homOfFib j.unop s) }
        homEquiv_naturality_left_symm := fun {F' F M} g α =>
          CategoryTheory.Category.assoc
            (g.hom.app (Opposite.op T_k)) (α.hom.app (Opposite.op T_k)) _
        homEquiv_naturality_right := fun {F M M'} f h => by
          apply CategoryTheory.Sheaf.hom_ext
          ext j : 2
          change CategoryTheory.Limits.Pi.lift _ =
            CategoryTheory.Limits.Pi.lift _ ≫ (Φ₀.skyscraperPresheafFunctor.map h).app j
          rw [CategoryTheory.GrothendieckTopology.Point.skyscraperPresheafFunctor_map_app]
          exact hEv_nat_right (Idx_of j)
            (fun s => F.obj.map (homOfFib j.unop s).op ≫ f) h }

  have hPi_id : ∀ (M : AddCommGrpCat.{u}) (I₁ I₂ : Type u) (f : I₂ → I₁) (g : I₁ → I₂),
      (∀ i : I₁, f (g i) = i) →
      CategoryTheory.Limits.Pi.lift (fun s : I₂ => CategoryTheory.Limits.Pi.π (fun _ : I₁ => M) (f s)) ≫
        CategoryTheory.Limits.Pi.lift (fun t : I₁ => CategoryTheory.Limits.Pi.π (fun _ : I₂ => M) (g t)) =
        𝟙 (∏ᶜ fun _ : I₁ => M) := by
    intro M I₁ I₂ f g hfg
    apply CategoryTheory.Limits.Pi.hom_ext
    intro t
    simp [hfg t]
  have hPi_map' : ∀ (M : AddCommGrpCat.{u}) (I₁ I₂ J₁ J₂ : Type u)
      (a₁ : J₁ → I₁) (a₂ : J₂ → I₂) (b₁ : I₂ → I₁) (b₂ : J₂ → J₁),
      (∀ s : J₂, a₁ (b₂ s) = b₁ (a₂ s)) →
      CategoryTheory.Limits.Pi.lift (fun s : J₁ => CategoryTheory.Limits.Pi.π (fun _ : I₁ => M) (a₁ s)) ≫
        CategoryTheory.Limits.Pi.map' b₂ (fun _ => 𝟙 M) =
      CategoryTheory.Limits.Pi.map' b₁ (fun _ => 𝟙 M) ≫
        CategoryTheory.Limits.Pi.lift (fun s : J₂ => CategoryTheory.Limits.Pi.π (fun _ : I₂ => M) (a₂ s)) := by
    intro M I₁ I₂ J₁ J₂ a₁ a₂ b₁ b₂ hcomm
    apply CategoryTheory.Limits.Pi.hom_ext
    intro s
    simp [hcomm s]
  have hPi_map : ∀ {M M' : AddCommGrpCat.{u}} (φ : M ⟶ M') (I₁ I₂ : Type u) (a : I₂ → I₁),
      CategoryTheory.Limits.Pi.lift (fun s : I₂ => CategoryTheory.Limits.Pi.π (fun _ : I₁ => M) (a s)) ≫
        CategoryTheory.Limits.Pi.map (fun _ : I₂ => φ) =
      CategoryTheory.Limits.Pi.map (fun _ : I₁ => φ) ≫
        CategoryTheory.Limits.Pi.lift (fun s : I₂ => CategoryTheory.Limits.Pi.π (fun _ : I₁ => M') (a s)) := by
    intro M M' φ I₁ I₂ a
    apply CategoryTheory.Limits.Pi.hom_ext
    intro s
    simp

  have hStalkZero : ∀ (G : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
      (σ : Quiver.Hom S_k S),
      Subsingleton ↑(((pb_of σ).obj G).obj.obj (Opposite.op T_k)) →
