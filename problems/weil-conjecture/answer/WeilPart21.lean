    have hSub_B₂ : Subsingleton (B₂.H (2 * δ + 1)) :=
      hCD_M B₂ (2 * δ + 1) hTor_B₂ (Nat.lt_succ_self (2 * δ))
    refine ⟨?_, ?_⟩
    · intro w
      have hw0 : w.comp hSE_B.extClass (rfl : (2 * δ) + 1 = 2 * δ + 1) = 0 :=
