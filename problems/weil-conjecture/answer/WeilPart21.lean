  have hsh_ev : ((Θ_tilde.hom.app (Opposite.op T₀)).hom (η_sh₀_hom c_Y_pre)) α₀ =
      ((θ_σ.app (Opposite.op T₀)).hom c_Y_pre) α₀ :=
    congrFun (congrArg (fun g => g.hom c_Y_pre) hΘ_sh) α₀
  refine ((congrFun (congrArg (Θ_tilde.hom.app (Opposite.op T₀)).hom hPin₀) α₀).trans
