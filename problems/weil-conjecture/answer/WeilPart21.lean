          CategoryTheory.Limits.IsZero ℋ) ∧
        (∀ {ℱ₁ ℱ₂ : CategoryTheory.Sheaf B.left.smallEtaleTopology AddCommGrpCat.{u}}
            (ψ : ℱ₁ ⟶ ℱ₂),
          (∀ (s : S_k ⟶ B.left), s ≫ B.hom = CategoryTheory.CategoryStruct.id S_k →
            let B_s : CategoryTheory.Functor B.left.Etale S_k.Etale :=
              CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ s
            ∀ [_hc_s : B_s.IsContinuous B.left.smallEtaleTopology S_k.smallEtaleTopology]
              [_hr_s : (B_s.sheafPushforwardContinuous AddCommGrpCat.{u}
                B.left.smallEtaleTopology S_k.smallEtaleTopology).IsRightAdjoint],
              let pb_s := B_s.sheafPullback AddCommGrpCat.{u}
                B.left.smallEtaleTopology S_k.smallEtaleTopology
              Function.Bijective
                ((CategoryTheory.Abelian.Ext.mk₀ (pb_s.map ψ)).postcomp Fℤ_Sk
                  (Nat.add_zero 0))) →
          CategoryTheory.IsIso ψ)) :=
by
  let _ : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
      CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  let _ : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
  let J_k := S_k.smallEtaleTopology
  let T_k := weilEtaleIdTerminal.{u} S_k
  let hT_k := weilEtaleIdTerminalIsTerminal.{u} S_k
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let Fℤ_Sk := (CategoryTheory.constantSheaf J_k AddCommGrpCat.{u}).obj Aℤ

  
  
  let evOne : ∀ (A : AddCommGrpCat.{u}), (Aℤ ⟶ A) ≃+ ↥A := fun A =>
    { toFun := fun f => f.hom (ULift.up (1 : ℤ))
      invFun := fun a => AddCommGrpCat.ofHom
        { toFun := fun n => n.down • a
          map_zero' := zero_zsmul a
          map_add' := fun m n => add_zsmul a m.down n.down }
      left_inv := fun f => by
        ext ⟨n⟩
        change n • f.hom (ULift.up (1 : ℤ)) = f.hom (ULift.up n)
        have hn : n • (ULift.up (1 : ℤ) : ULift.{u} ℤ) = ULift.up n :=
          ULift.ext _ _ (zsmul_one n)
        rw [← hn, f.hom.map_zsmul]
      right_inv := fun a => one_zsmul a
      map_add' := fun _ _ => rfl }

  have hDegZero :
      ∃ (e_H0 : ∀ (ℳ : CategoryTheory.Sheaf J_k AddCommGrpCat.{u}),
          ℳ.H 0 ≃+ ↥(ℳ.obj.obj (Opposite.op T_k))),
        ∀ {ℳ₁ ℳ₂ : CategoryTheory.Sheaf J_k AddCommGrpCat.{u}}
          (φ : ℳ₁ ⟶ ℳ₂) (z : ℳ₁.H 0),
          e_H0 ℳ₂ (((CategoryTheory.Abelian.Ext.mk₀ φ).postcomp Fℤ_Sk (Nat.add_zero 0)) z) =
            (φ.hom.app (Opposite.op T_k)) (e_H0 ℳ₁ z) := by
    let C_k := CategoryTheory.constantSheaf J_k AddCommGrpCat.{u}
    let adj_k := CategoryTheory.constantSheafAdj J_k AddCommGrpCat.{u} hT_k
    let _ : ((CategoryTheory.sheafSections J_k AddCommGrpCat.{u}).obj (Opposite.op T_k)).Additive :=
      { map_add := fun {_ _ _ _} => rfl }
    let _ : C_k.Additive := adj_k.left_adjoint_additive
    let e_H0 : ∀ (ℳ : CategoryTheory.Sheaf J_k AddCommGrpCat.{u}),
        ℳ.H 0 ≃+ ↥(ℳ.obj.obj (Opposite.op T_k)) :=
      fun ℳ =>
        (CategoryTheory.Abelian.Ext.addEquiv₀ (X := Fℤ_Sk) (Y := ℳ)).trans
          ((adj_k.homAddEquiv (X := Aℤ) (Y := ℳ)).trans
            (evOne (ℳ.obj.obj (Opposite.op T_k))))
    refine ⟨e_H0, ?_⟩
    intro ℳ₁ ℳ₂ φ z
    let f_z : Fℤ_Sk ⟶ ℳ₁ := CategoryTheory.Abelian.Ext.addEquiv₀ z
    have hz : CategoryTheory.Abelian.Ext.mk₀ f_z = z :=
      CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply z
    have hpost : ((CategoryTheory.Abelian.Ext.mk₀ φ).postcomp Fℤ_Sk (Nat.add_zero 0)) z =
        CategoryTheory.Abelian.Ext.mk₀ (f_z ≫ φ) := by
      change z.comp (CategoryTheory.Abelian.Ext.mk₀ φ) (Nat.add_zero 0) = _
      rw [← hz, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
    have hadd0 : CategoryTheory.Abelian.Ext.addEquiv₀ (CategoryTheory.Abelian.Ext.mk₀ (f_z ≫ φ)) =
        f_z ≫ φ := by
      rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply]
    have hnat := adj_k.homEquiv_naturality_right f_z φ
    change evOne _ (adj_k.homEquiv Aℤ ℳ₂
        (CategoryTheory.Abelian.Ext.addEquiv₀
          (((CategoryTheory.Abelian.Ext.mk₀ φ).postcomp Fℤ_Sk (Nat.add_zero 0)) z))) =
      (φ.hom.app (Opposite.op T_k)) (evOne _ (adj_k.homEquiv Aℤ ℳ₁ f_z))
    rw [hpost, hadd0, hnat]
    rfl

  have hTermPresheaf : ∀ (Y : AlgebraicGeometry.Scheme.{u}) (V : Y.Etale),
      CategoryTheory.IsIso V.hom →
      ∀ (M : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ),
        Nonempty (↥((M.cohomologyPresheaf q).obj (Opposite.op V)) ≃+ M.H q) := by
    intro Y V hIso M q
    let _ : CategoryTheory.IsIso V.hom := hIso
    let J_Y := Y.smallEtaleTopology
    let hV : CategoryTheory.Limits.IsTerminal V :=
      CategoryTheory.Limits.IsTerminal.ofUniqueHom
        (fun W =>
          let _ : AlgebraicGeometry.Etale W.hom := W.prop
          CategoryTheory.MorphismProperty.Over.homMk (W.hom ≫ CategoryTheory.inv V.hom)
            (by rw [CategoryTheory.Category.assoc, CategoryTheory.IsIso.inv_hom_id,
              CategoryTheory.Category.comp_id]) trivial)
        (fun W m => by
          apply CategoryTheory.MorphismProperty.Over.Hom.ext
          change m.left = W.hom ≫ CategoryTheory.inv V.hom
          apply (CategoryTheory.cancel_mono V.hom).mp
          rw [CategoryTheory.MorphismProperty.Over.w m, CategoryTheory.Category.assoc,
            CategoryTheory.IsIso.inv_hom_id, CategoryTheory.Category.comp_id])
    let Fℤ_Y := (CategoryTheory.constantSheaf J_Y AddCommGrpCat.{u}).obj Aℤ
    let P_V := (CategoryTheory.yoneda.obj V).comp AddCommGrpCat.free
    let L_V := (CategoryTheory.presheafToSheaf J_Y AddCommGrpCat.{u}).obj P_V
    let adj_sh := CategoryTheory.sheafificationAdjunction J_Y AddCommGrpCat.{u}
    let adj_free := AddCommGrpCat.adj.whiskerRight (Opposite Y.Etale)
    let adj_c := CategoryTheory.constantSheafAdj J_Y AddCommGrpCat.{u} hV
    let θ_L : ∀ (𝒩 : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}),
        (L_V ⟶ 𝒩) ≃ ↥(𝒩.obj.obj (Opposite.op V)) :=
      fun 𝒩 =>
        (adj_sh.homEquiv P_V 𝒩).trans
          ((adj_free.homEquiv (CategoryTheory.yoneda.obj V) 𝒩.obj).trans
            CategoryTheory.yonedaEquiv)
    let θ_C : ∀ (𝒩 : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}),
        (Fℤ_Y ⟶ 𝒩) ≃ ↥(𝒩.obj.obj (Opposite.op V)) :=
      fun 𝒩 =>
        (adj_c.homEquiv Aℤ 𝒩).trans (evOne (𝒩.obj.obj (Opposite.op V))).toEquiv
    have hθ_L_nat : ∀ {𝒩₁ 𝒩₂ : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}}
        (g : L_V ⟶ 𝒩₁) (ψ : 𝒩₁ ⟶ 𝒩₂),
        θ_L 𝒩₂ (g ≫ ψ) = (ψ.hom.app (Opposite.op V)) (θ_L 𝒩₁ g) := by
      intro 𝒩₁ 𝒩₂ g ψ
      refine (@CategoryTheory.yonedaEquiv Y.Etale _ V
        (𝒩₂.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u})).symm.injective ?_
      change (@CategoryTheory.yonedaEquiv Y.Etale _ V
          (𝒩₂.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u})).symm
          (CategoryTheory.yonedaEquiv
            (adj_free.homEquiv _ _ (adj_sh.homEquiv P_V 𝒩₂ (g ≫ ψ)))) =
        (@CategoryTheory.yonedaEquiv Y.Etale _ V
          (𝒩₂.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u})).symm
          ((ψ.hom.app (Opposite.op V)) (θ_L 𝒩₁ g))
      rw [Equiv.symm_apply_apply, adj_sh.homEquiv_naturality_right,
        adj_free.homEquiv_naturality_right]
      have hy := CategoryTheory.yonedaEquiv_symm_naturality_right V
        ((CategoryTheory.Functor.whiskeringRight (Opposite Y.Etale) AddCommGrpCat.{u} (Type u)).obj
          (CategoryTheory.forget AddCommGrpCat.{u}) |>.map ψ.hom)
        (θ_L 𝒩₁ g)
      dsimp [θ_L] at hy
      rw [Equiv.symm_apply_apply] at hy
      exact hy
    have hθ_C_nat : ∀ {𝒩₁ 𝒩₂ : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}}
        (g : Fℤ_Y ⟶ 𝒩₁) (ψ : 𝒩₁ ⟶ 𝒩₂),
        θ_C 𝒩₂ (g ≫ ψ) = (ψ.hom.app (Opposite.op V)) (θ_C 𝒩₁ g) := by
      intro 𝒩₁ 𝒩₂ g ψ
      change evOne _ (adj_c.homEquiv Aℤ 𝒩₂ (g ≫ ψ)) =
        (ψ.hom.app (Opposite.op V)) (evOne _ (adj_c.homEquiv Aℤ 𝒩₁ g))
      rw [adj_c.homEquiv_naturality_right]
      rfl
    let α : Fℤ_Y ⟶ L_V := (θ_C L_V).symm (θ_L L_V (𝟙 L_V))
    let β : L_V ⟶ Fℤ_Y := (θ_L Fℤ_Y).symm (θ_C Fℤ_Y (𝟙 Fℤ_Y))
    have hαβ : α ≫ β = 𝟙 Fℤ_Y := by
      apply (θ_C Fℤ_Y).injective
      rw [hθ_C_nat α β]
      dsimp [α]
      rw [(θ_C L_V).apply_symm_apply, ← hθ_L_nat (𝟙 L_V) β, CategoryTheory.Category.id_comp]
      exact (θ_L Fℤ_Y).apply_symm_apply _
    have hβα : β ≫ α = 𝟙 L_V := by
      apply (θ_L L_V).injective
      rw [hθ_L_nat β α]
      dsimp [β]
      rw [(θ_L Fℤ_Y).apply_symm_apply, ← hθ_C_nat (𝟙 Fℤ_Y) α, CategoryTheory.Category.id_comp]
      exact (θ_C L_V).apply_symm_apply _
    let p_α : CategoryTheory.Abelian.Ext L_V M q →+ M.H q :=
      (CategoryTheory.Abelian.Ext.mk₀ α).precomp M (Nat.zero_add q)
    let p_β : M.H q →+ CategoryTheory.Abelian.Ext L_V M q :=
      (CategoryTheory.Abelian.Ext.mk₀ β).precomp M (Nat.zero_add q)
    have h_left : ∀ ξ : CategoryTheory.Abelian.Ext L_V M q, p_β (p_α ξ) = ξ := by
      intro ξ
      change (CategoryTheory.Abelian.Ext.mk₀ β).comp
        ((CategoryTheory.Abelian.Ext.mk₀ α).comp ξ (Nat.zero_add q)) (Nat.zero_add q) = ξ
      rw [← CategoryTheory.Abelian.Ext.comp_assoc _ _ _
          (Nat.add_zero 0) (Nat.zero_add q) (Nat.zero_add q),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hβα]
      exact CategoryTheory.Abelian.Ext.mk₀_id_comp ξ
    have h_right : ∀ η : M.H q, p_α (p_β η) = η := by
      intro η
      change (CategoryTheory.Abelian.Ext.mk₀ α).comp
        ((CategoryTheory.Abelian.Ext.mk₀ β).comp η (Nat.zero_add q)) (Nat.zero_add q) = η
      rw [← CategoryTheory.Abelian.Ext.comp_assoc _ _ _
          (Nat.add_zero 0) (Nat.zero_add q) (Nat.zero_add q),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hαβ]
      exact CategoryTheory.Abelian.Ext.mk₀_id_comp η
    exact ⟨AddEquiv.ofBijective p_α
      ⟨Function.HasLeftInverse.injective ⟨p_β, h_left⟩,
       Function.HasRightInverse.surjective ⟨p_β, h_right⟩⟩⟩

  
  
  let Ev_pre := (CategoryTheory.evaluation (Opposite S_k.Etale) AddCommGrpCat.{u}).obj
    (Opposite.op T_k)
  let Ev_sh : CategoryTheory.Functor (CategoryTheory.Sheaf J_k AddCommGrpCat.{u}) AddCommGrpCat.{u} :=
    CategoryTheory.Functor.comp (CategoryTheory.sheafToPresheaf J_k AddCommGrpCat.{u}) Ev_pre

  have hTriv : ∀ (R : CategoryTheory.Sieve T_k), R ∈ J_k T_k → R.arrows (𝟙 T_k) := by
    intro R hR
    let _ : Unique ↥S_k := PrimeSpectrum.instUnique
    have _ : IsSepClosed k := inferInstance
    let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
      @AlgebraicGeometry.Etale
    have hR' : R ∈ (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck T_k := by
      rwa [← AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) S_k (le_refl P_et)]
    let pt_k : ↥T_k.left := (default : ↥S_k)
    obtain ⟨U, f, u₀, huR, huEt, -⟩ :=
      (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) (S := S_k) T_k R).mp hR' pt_k
    let U_left : AlgebraicGeometry.Scheme.{u} := U.left
    let U_hom : U_left ⟶ S_k := U.hom
    let f_left : U_left ⟶ S_k := f.left
    have _ : AlgebraicGeometry.Etale f_left := huEt
    have hf_surj : Function.Surjective ⇑f_left := fun s =>
      ⟨u₀, @Subsingleton.elim ↥S_k inferInstance (f_left u₀) s⟩
    have hsing : CategoryTheory.Presieve.singleton f_left ∈
        (AlgebraicGeometry.Scheme.precoverage P_et).coverings S_k :=
      (AlgebraicGeometry.Scheme.singleton_mem_precoverage_iff P_et f_left).mpr
        ⟨hf_surj, inferInstance⟩
    have hcov : CategoryTheory.Sieve.generate (CategoryTheory.Presieve.singleton f_left) ∈
        AlgebraicGeometry.Scheme.etaleTopology S_k :=
      CategoryTheory.Precoverage.generate_mem_toGrothendieck hsing
    obtain ⟨Z, f_Z, hf_Z, z_Z, hz_Z⟩ :=
      (AlgebraicGeometry.Scheme.geometricFiber k).jointly_surjective _ hcov (𝟙 S_k)
    obtain ⟨Z', g_Z, f', hf'_sing, hfac⟩ := hf_Z
    cases hf'_sing
    let z_mor : S_k ⟶ Z := z_Z
    change z_mor ≫ f_Z = 𝟙 S_k at hz_Z
    change g_Z ≫ f_left = f_Z at hfac
    let s_U : S_k ⟶ U_left := z_mor ≫ g_Z
    have hs_f : s_U ≫ f_left = 𝟙 S_k :=
      (CategoryTheory.Category.assoc z_mor g_Z f_left).trans
        ((congrArg (z_mor ≫ ·) hfac).trans hz_Z)
    have hf_hom : f_left = U_hom := by
      have hw : f_left ≫ 𝟙 S_k = U_hom := CategoryTheory.MorphismProperty.Over.w f
      exact (CategoryTheory.Category.comp_id f_left).symm.trans hw
    have hs_U : s_U ≫ U_hom = 𝟙 S_k := hf_hom ▸ hs_f
    have _ : AlgebraicGeometry.Etale U_hom := U.prop
    let Δ : U_left ⟶ CategoryTheory.Limits.pullback U_hom U_hom :=
      CategoryTheory.Limits.pullback.diagonal U_hom
    have _ : AlgebraicGeometry.IsOpenImmersion Δ :=
      AlgebraicGeometry.FormallyUnramified.isOpenImmersion_diagonal U_hom
    have hg_eq : 𝟙 U_left ≫ U_hom = (U_hom ≫ s_U) ≫ U_hom := by
      rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc, hs_U,
        CategoryTheory.Category.comp_id]
    let g_U : U_left ⟶ CategoryTheory.Limits.pullback U_hom U_hom :=
      CategoryTheory.Limits.pullback.lift (𝟙 U_left) (U_hom ≫ s_U) hg_eq
    have hΔ_fst : Δ ≫ CategoryTheory.Limits.pullback.fst U_hom U_hom = 𝟙 U_left :=
      CategoryTheory.Limits.pullback.diagonal_fst U_hom
    have hΔ_snd : Δ ≫ CategoryTheory.Limits.pullback.snd U_hom U_hom = 𝟙 U_left :=
      CategoryTheory.Limits.pullback.diagonal_snd U_hom
    have hg_fst : g_U ≫ CategoryTheory.Limits.pullback.fst U_hom U_hom = 𝟙 U_left :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hg_snd : g_U ≫ CategoryTheory.Limits.pullback.snd U_hom U_hom = U_hom ≫ s_U :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hpb_sU : CategoryTheory.IsPullback s_U s_U Δ g_U := by
      have hcomm : s_U ≫ Δ = s_U ≫ g_U := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · rw [CategoryTheory.Category.assoc s_U Δ, hΔ_fst,
            CategoryTheory.Category.assoc s_U g_U, hg_fst]
        · rw [CategoryTheory.Category.assoc s_U Δ, hΔ_snd, CategoryTheory.Category.comp_id,
            CategoryTheory.Category.assoc s_U g_U, hg_snd,
            ← CategoryTheory.Category.assoc s_U U_hom s_U,
            hs_U, CategoryTheory.Category.id_comp]
      refine { toCommSq := ⟨hcomm⟩, isLimit' := ⟨?_⟩ }
      refine CategoryTheory.Limits.PullbackCone.IsLimit.mk hcomm
        (fun cone => cone.snd ≫ U_hom)
        (fun cone => ?_) (fun cone => ?_) (fun cone m _ hm₂ => ?_)
      · have h2 := congrArg (· ≫ CategoryTheory.Limits.pullback.snd U_hom U_hom) cone.condition
        rw [CategoryTheory.Category.assoc, hΔ_snd, CategoryTheory.Category.comp_id,
          CategoryTheory.Category.assoc, hg_snd, ← CategoryTheory.Category.assoc] at h2
        exact h2.symm
      · have h1 := congrArg (· ≫ CategoryTheory.Limits.pullback.fst U_hom U_hom) cone.condition
        rw [CategoryTheory.Category.assoc, hΔ_fst, CategoryTheory.Category.comp_id,
          CategoryTheory.Category.assoc, hg_fst, CategoryTheory.Category.comp_id] at h1
        have h2 := congrArg (· ≫ CategoryTheory.Limits.pullback.snd U_hom U_hom) cone.condition
        rw [CategoryTheory.Category.assoc, hΔ_snd, CategoryTheory.Category.comp_id,
          CategoryTheory.Category.assoc, hg_snd, ← CategoryTheory.Category.assoc] at h2
        exact h2.symm.trans h1
      · calc
          m = m ≫ 𝟙 S_k := (CategoryTheory.Category.comp_id m).symm
          _ = m ≫ (s_U ≫ U_hom) := by rw [hs_U]
          _ = (m ≫ s_U) ≫ U_hom := (CategoryTheory.Category.assoc m s_U U_hom).symm
          _ = cone.snd ≫ U_hom := by rw [hm₂]
    have _ : AlgebraicGeometry.IsOpenImmersion s_U :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (P := @AlgebraicGeometry.IsOpenImmersion) hpb_sU inferInstance
    let γ : T_k ⟶ U := CategoryTheory.MorphismProperty.Over.homMk s_U hs_U trivial
    have hγf : γ ≫ f = 𝟙 T_k := hT_k.hom_ext (γ ≫ f) (𝟙 T_k)
    have h_arr := R.downward_closed huR γ
    rwa [hγf] at h_arr

  let Sky_pre : CategoryTheory.Functor AddCommGrpCat.{u}
      (CategoryTheory.Functor (Opposite S_k.Etale) AddCommGrpCat.{u}) :=
    { obj := fun A =>
        { obj := fun W => AddCommGrpCat.of ((T_k ⟶ Opposite.unop W) → ↥A)
          map := fun {W₁ W₂} g => AddCommGrpCat.ofHom
            { toFun := fun φ τ => φ (τ ≫ g.unop)
              map_zero' := rfl
              map_add' := fun _ _ => rfl }
          map_id := fun W => AddCommGrpCat.ext fun φ => funext fun τ =>
            congrArg φ (CategoryTheory.Category.comp_id τ)
          map_comp := fun f g => AddCommGrpCat.ext fun φ => funext fun τ =>
            congrArg φ (CategoryTheory.Category.assoc τ g.unop f.unop) }
      map := fun {A A'} h =>
        { app := fun W => AddCommGrpCat.ofHom
            { toFun := fun φ τ => h.hom (φ τ)
              map_zero' := funext fun _ => h.hom.map_zero
              map_add' := fun φ₁ φ₂ => funext fun τ => h.hom.map_add (φ₁ τ) (φ₂ τ) }
          naturality := fun _ _ _ => AddCommGrpCat.ext fun _ => rfl }
      map_id := fun _ => by ext; rfl
      map_comp := fun _ _ => by ext; rfl }

  have hSheaf : ∀ (A : AddCommGrpCat.{u}),
      CategoryTheory.Presheaf.IsSheaf J_k (Sky_pre.obj A) := by
    intro A E U S_U hS_U x hx
    have hMem : ∀ (α : T_k ⟶ U), S_U.arrows α := by
      intro α
      have hp : (S_U.pullback α).arrows (𝟙 T_k) := hTriv (S_U.pullback α) (J_k.pullback_stable α hS_U)
      change S_U.arrows (𝟙 T_k ≫ α) at hp
      rwa [CategoryTheory.Category.id_comp] at hp
    let xHom : ∀ {Y : S_k.Etale} (g : Y ⟶ U), S_U.arrows g →
        (E ⟶ (Sky_pre.obj A).obj (Opposite.op Y)) :=
      fun g hg => x g hg
    let t : E ⟶ (Sky_pre.obj A).obj (Opposite.op U) := AddCommGrpCat.ofHom
      { toFun := fun e α => (xHom α (hMem α)).hom e (𝟙 T_k)
        map_zero' := funext fun α =>
          congrFun ((xHom α (hMem α)).hom.map_zero) (𝟙 T_k)
        map_add' := fun e₁ e₂ => funext fun α =>
          congrFun ((xHom α (hMem α)).hom.map_add e₁ e₂) (𝟙 T_k) }
    refine ⟨t, ?_, ?_⟩
    · intro Y g hg
