    have hLocSurj_push : CategoryTheory.Sheaf.IsLocallySurjective (P_push.map g) := by
      refine ⟨fun {U} y => (hTopMem E₁ U
        (CategoryTheory.Presheaf.imageSieve (P_push.map g).hom y)).mpr ?_⟩
      intro p
      obtain ⟨W, h, q_W, x, hComap, hx⟩ := hLift g hAntecedent U y p
      exact ⟨W, h, q_W, ⟨x, hx⟩, hComap⟩
