theorem weil_rel_projLine_bockstein_higherDirectImage_iso_and_vanishing (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    {Y S : AlgebraicGeometry.Scheme.{u}} (f : Y ⟶ S)
    (c_Y : ∀ r : ℕ, weilEtaleTorsionH Y (ℓ ^ r) 2)
    (_hTrans_c : ∀ r : ℕ, weilEtaleTorsionTransition Y ℓ r 2 (c_Y (r + 1)) = c_Y r)
    (γ : ∀ r : ℕ,
      weilEtaleTorsionSheaf S (ℓ ^ r) ⟶
        weilEtaleHigherDirectImage f 2 (weilEtaleTorsionSheaf Y (ℓ ^ r)))
    (_hCoeff : ∀ (r₁ r₂ : ℕ) (φ : ZMod (ℓ ^ r₁) →+ ZMod (ℓ ^ r₂)),
      let Aℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
      let φ_Y := (CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).map
        (AddCommGrpCat.uliftFunctor.{u, 0}.map (AddCommGrpCat.ofHom φ))
      let φ_S := (CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).map
        (AddCommGrpCat.uliftFunctor.{u, 0}.map (AddCommGrpCat.ofHom φ))
      (CategoryTheory.Abelian.Ext.mk₀ φ_Y).postcomp
        ((CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ)
        (Nat.add_zero 2) (c_Y r₁) = (φ 1).val • c_Y r₂ →
      φ_S ≫ γ r₂ = γ r₁ ≫ weilPolyP1HigherDirectImageMap f 2 φ_Y)
    (_hZ1 : CategoryTheory.Limits.IsZero
      (weilEtaleHigherDirectImage f 1 (weilEtaleTorsionSheaf Y (ℓ ^ 1))))
    (_hZ_ge3 : ∀ b : ℕ, 3 ≤ b → CategoryTheory.Limits.IsZero
      (weilEtaleHigherDirectImage f b (weilEtaleTorsionSheaf Y (ℓ ^ 1))))
    (_hIso1 : CategoryTheory.IsIso (γ 1)) :
    (∀ (r b : ℕ), 3 ≤ b → CategoryTheory.Limits.IsZero
      (weilEtaleHigherDirectImage f b (weilEtaleTorsionSheaf Y (ℓ ^ r)))) ∧
    (∀ r : ℕ, CategoryTheory.IsIso (γ r)) :=
by
  let B_f : CategoryTheory.Functor S.Etale Y.Etale := weilEtaleSitePullback f
  let P_sh := CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}
  let P_sh_Y := CategoryTheory.presheafToSheaf Y.smallEtaleTopology AddCommGrpCat.{u}
  let C_S := CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}
  let C_Y := CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}
  let Aℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
  let Fℤ_Y := C_Y.obj Aℤ

  
  let AM₁ : AddCommGrpCat.{u} :=
    AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod 1))
  have h_id_AM₁ : 𝟙 AM₁ = 0 := by
    ext ⟨x⟩
    exact congrArg ULift.up (Subsingleton.elim x 0)
  have h_id_S0 : 𝟙 (weilEtaleTorsionSheaf S (ℓ ^ 0)) = 0 := by
    change 𝟙 (C_S.obj AM₁) = 0
    rw [← C_S.map_id, h_id_AM₁, C_S.map_zero]
  have hZS₀ : CategoryTheory.Limits.IsZero (weilEtaleTorsionSheaf S (ℓ ^ 0)) :=
    (CategoryTheory.Limits.IsZero.iff_id_eq_zero _).mpr h_id_S0
  have h_id_Y0 : 𝟙 (weilEtaleTorsionSheaf Y (ℓ ^ 0)) = 0 := by
    change 𝟙 (C_Y.obj AM₁) = 0
    rw [← C_Y.map_id, h_id_AM₁, C_Y.map_zero]
  have h_id_P0 : ∀ b : ℕ,
      𝟙 (CategoryTheory.Functor.comp B_f.op
        (CategoryTheory.Sheaf.cohomologyPresheaf (weilEtaleTorsionSheaf Y (ℓ ^ 0)) b)) = 0 := by
    intro b
    apply CategoryTheory.NatTrans.ext
    funext opV
    apply AddCommGrpCat.ext
    intro (x : CategoryTheory.Abelian.Ext.{u}
      (weilPolyP1CohomologyRepSheaf Y (B_f.obj opV.unop))
      (weilEtaleTorsionSheaf Y (ℓ ^ 0)) b)
    change x = 0
    rw [← CategoryTheory.Abelian.Ext.comp_mk₀_id x, h_id_Y0,
      CategoryTheory.Abelian.Ext.mk₀_zero, CategoryTheory.Abelian.Ext.comp_zero]
  have hZR₀ : ∀ b : ℕ,
      CategoryTheory.Limits.IsZero
        (weilEtaleHigherDirectImage f b (weilEtaleTorsionSheaf Y (ℓ ^ 0))) := by
    intro b
    rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
    change 𝟙 (P_sh.obj (CategoryTheory.Functor.comp B_f.op
      (CategoryTheory.Sheaf.cohomologyPresheaf (weilEtaleTorsionSheaf Y (ℓ ^ 0)) b))) = 0
    rw [← P_sh.map_id, h_id_P0 b, P_sh.map_zero]
  have hIso₀ : CategoryTheory.IsIso (γ 0) :=
    ⟨⟨0, hZS₀.eq_of_src _ _, (hZR₀ 2).eq_of_tgt _ _⟩⟩

  
  let ev_S : Opposite S.Etale →
      CategoryTheory.Functor
        (CategoryTheory.Functor (Opposite S.Etale) AddCommGrpCat.{u}) AddCommGrpCat.{u} :=
    fun opV => (CategoryTheory.evaluation (Opposite S.Etale) AddCommGrpCat.{u}).obj opV
  have hJRI : CategoryTheory.JointlyReflectIsomorphisms ev_S :=
    ⟨fun _ h => (CategoryTheory.NatTrans.isIso_iff_isIso_app _).mpr h⟩
  have hSheafExact :
      ∀ (SC_pre : CategoryTheory.ShortComplex
          (CategoryTheory.Functor (Opposite S.Etale) AddCommGrpCat.{u})),
        (∀ opV : Opposite S.Etale, (SC_pre.map (ev_S opV)).Exact) →
        (SC_pre.map P_sh).Exact := by
    intro SC_pre hObj
    exact ((CategoryTheory.JointlyReflectIsomorphisms.exact_iff hJRI SC_pre).mpr hObj).map P_sh

  
  have hPrime : Nat.Prime ℓ := Fact.out
  have h1_lt_ℓ : 1 < ℓ := hPrime.one_lt
  have h1_lt_ℓ1 : 1 < ℓ ^ 1 := by simpa [pow_one] using h1_lt_ℓ
  have : Fact (1 < ℓ ^ 1) := ⟨h1_lt_ℓ1⟩
  have : NeZero (ℓ ^ 1) := ⟨by omega⟩

  let castTo1 : ∀ d : ℕ, ZMod (ℓ ^ (d + 1)) →+ ZMod (ℓ ^ 1) :=
    fun d => (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_add_left 1 d)) (ZMod (ℓ ^ 1))).toAddMonoidHom
  let castTo1_Y : ∀ d : ℕ,
      weilEtaleTorsionSheaf Y (ℓ ^ (d + 1)) ⟶ weilEtaleTorsionSheaf Y (ℓ ^ 1) :=
    fun d => C_Y.map (AddCommGrpCat.uliftFunctor.{u, 0}.map (AddCommGrpCat.ofHom (castTo1 d)))
  have hCast_to_1 : ∀ d : ℕ,
      (CategoryTheory.Abelian.Ext.mk₀ (castTo1_Y d)).postcomp Fℤ_Y (Nat.add_zero 2)
        (c_Y (d + 1)) = c_Y 1 := by
    intro d
    induction d with
    | zero =>
      have hcast0_id : AddCommGrpCat.ofHom (castTo1 0) =
          𝟙 (AddCommGrpCat.of (ZMod (ℓ ^ 1))) := by
        ext x
        simp [castTo1]
      have hcast0Y_id : castTo1_Y 0 = 𝟙 (weilEtaleTorsionSheaf Y (ℓ ^ 1)) := by
        dsimp [castTo1_Y]
        rw [hcast0_id, CategoryTheory.Functor.map_id, CategoryTheory.Functor.map_id]
      change (c_Y 1).comp (CategoryTheory.Abelian.Ext.mk₀ (castTo1_Y 0)) (Nat.add_zero 2) = c_Y 1
      rw [hcast0Y_id, CategoryTheory.Abelian.Ext.comp_mk₀_id]
    | succ d ih =>
      let c_step : ZMod (ℓ ^ (d + 2)) →+ ZMod (ℓ ^ (d + 1)) :=
        (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (d + 1))) (ZMod (ℓ ^ (d + 1)))).toAddMonoidHom
      let c_step_Y : weilEtaleTorsionSheaf Y (ℓ ^ (d + 2)) ⟶
          weilEtaleTorsionSheaf Y (ℓ ^ (d + 1)) :=
        C_Y.map (AddCommGrpCat.uliftFunctor.{u, 0}.map (AddCommGrpCat.ofHom c_step))
      have hcomp_hom : AddCommGrpCat.ofHom (castTo1 (d + 1)) =
          AddCommGrpCat.ofHom c_step ≫ AddCommGrpCat.ofHom (castTo1 d) := by
        ext x
        change (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_add_left 1 (d + 1))) (ZMod (ℓ ^ 1))) x =
          (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_add_left 1 d)) (ZMod (ℓ ^ 1)))
            ((ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (d + 1))) (ZMod (ℓ ^ (d + 1)))) x)
        rw [← RingHom.comp_apply, ZMod.castHom_comp]
      have hcomp_Y : castTo1_Y (d + 1) = c_step_Y ≫ castTo1_Y d := by
        dsimp [castTo1_Y, c_step_Y]
        rw [hcomp_hom, CategoryTheory.Functor.map_comp, CategoryTheory.Functor.map_comp]
      change (c_Y (d + 2)).comp (CategoryTheory.Abelian.Ext.mk₀ (castTo1_Y (d + 1)))
        (Nat.add_zero 2) = c_Y 1
      rw [hcomp_Y, ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ (Nat.add_zero 2)]
      have hstep_eq :
          (c_Y (d + 2)).comp (CategoryTheory.Abelian.Ext.mk₀ c_step_Y) (Nat.add_zero 2) =
            c_Y (d + 1) := _hTrans_c (d + 1)
      rw [hstep_eq]
      exact ih

  
  have hInd : ∀ s : ℕ,
      CategoryTheory.Limits.IsZero
        (weilEtaleHigherDirectImage f 1 (weilEtaleTorsionSheaf Y (ℓ ^ (s + 1)))) ∧
      (∀ b : ℕ, 3 ≤ b → CategoryTheory.Limits.IsZero
        (weilEtaleHigherDirectImage f b (weilEtaleTorsionSheaf Y (ℓ ^ (s + 1))))) ∧
      CategoryTheory.IsIso (γ (s + 1)) := by
    intro s
    induction s with
    | zero => exact ⟨_hZ1, _hZ_ge3, _hIso1⟩
    | succ s ih =>
      set r : ℕ := s + 1
      have hr_pos : 1 ≤ r := Nat.succ_le_succ (Nat.zero_le s)
      have hr_ne : r ≠ 0 := by omega
      have h1_lt_ℓr : 1 < ℓ ^ r := lt_of_lt_of_le h1_lt_ℓ (Nat.le_self_pow hr_ne ℓ)
      have hℓr_lt_succ : ℓ ^ r < ℓ ^ (r + 1) :=
        Nat.pow_lt_pow_right h1_lt_ℓ (Nat.lt_succ_self r)
      have h1_lt_succ : 1 < ℓ ^ (r + 1) := lt_trans h1_lt_ℓr hℓr_lt_succ
      have : Fact (1 < ℓ ^ r) := ⟨h1_lt_ℓr⟩
      have : Fact (1 < ℓ ^ (r + 1)) := ⟨h1_lt_succ⟩
      have : NeZero (ℓ ^ r) := ⟨by omega⟩
      have : NeZero (ℓ ^ (r + 1)) := ⟨by omega⟩
      have hmul_pow : ℓ ^ r * (ℓ ^ 1) = ℓ ^ (r + 1) := (pow_add ℓ r 1).symm

      
      let ι_bock : ZMod (ℓ ^ 1) →+ ZMod (ℓ ^ (r + 1)) :=
        { toFun := fun a => ((ℓ ^ r * a.val : ℕ) : ZMod (ℓ ^ (r + 1)))
          map_zero' := by simp
          map_add' := fun a b => by
            rw [ZMod.val_add]
            have hdiv := Nat.div_add_mod (a.val + b.val) (ℓ ^ 1)
            have hmul : ℓ ^ (r + 1) * ((a.val + b.val) / (ℓ ^ 1)) +
                ℓ ^ r * ((a.val + b.val) % (ℓ ^ 1)) =
                ℓ ^ r * a.val + ℓ ^ r * b.val := by
              calc
                ℓ ^ (r + 1) * ((a.val + b.val) / (ℓ ^ 1)) +
                    ℓ ^ r * ((a.val + b.val) % (ℓ ^ 1))
                  = (ℓ ^ r * (ℓ ^ 1)) * ((a.val + b.val) / (ℓ ^ 1)) +
                      ℓ ^ r * ((a.val + b.val) % (ℓ ^ 1)) := by rw [hmul_pow]
                _ = ℓ ^ r * (ℓ ^ 1 * ((a.val + b.val) / (ℓ ^ 1)) +
                      (a.val + b.val) % (ℓ ^ 1)) := by ring
                _ = ℓ ^ r * (a.val + b.val) := by rw [hdiv]
                _ = ℓ ^ r * a.val + ℓ ^ r * b.val := by ring
            have hcast := congrArg (fun n : ℕ => (n : ZMod (ℓ ^ (r + 1)))) hmul
            have hzero : ((ℓ ^ (r + 1) : ℕ) : ZMod (ℓ ^ (r + 1))) = 0 :=
              CharP.cast_eq_zero (ZMod (ℓ ^ (r + 1))) (ℓ ^ (r + 1))
            rw [Nat.cast_add, Nat.cast_mul, hzero, zero_mul, zero_add, Nat.cast_add] at hcast
            exact hcast }
      let π_bock : ZMod (ℓ ^ (r + 1)) →+ ZMod (ℓ ^ r) :=
        (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r))).toAddMonoidHom
      have h_comp0 : AddCommGrpCat.ofHom ι_bock ≫ AddCommGrpCat.ofHom π_bock = 0 := by
        ext a
        change (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r)))
          ((ℓ ^ r * a.val : ℕ) : ZMod (ℓ ^ (r + 1))) = 0
        rw [map_natCast, Nat.cast_mul, CharP.cast_eq_zero, zero_mul]
      let SC₀ := CategoryTheory.ShortComplex.mk
        (AddCommGrpCat.ofHom ι_bock) (AddCommGrpCat.ofHom π_bock) h_comp0
      have hMono₀ : CategoryTheory.Mono SC₀.f := by
        rw [AddCommGrpCat.mono_iff_injective]
        change Function.Injective ι_bock
        rw [injective_iff_map_eq_zero]
        intro a ha
        change ((ℓ ^ r * a.val : ℕ) : ZMod (ℓ ^ (r + 1))) = 0 at ha
        rw [ZMod.natCast_eq_zero_iff, ← hmul_pow] at ha
        have hdvd : ℓ ^ 1 ∣ a.val :=
          (Nat.mul_dvd_mul_iff_left (pow_pos hPrime.pos r)).mp ha
        have hval0 : a.val = 0 := Nat.eq_zero_of_dvd_of_lt hdvd (ZMod.val_lt a)
        exact (ZMod.val_eq_zero a).mp hval0
      have hEpi₀ : CategoryTheory.Epi SC₀.g := by
        rw [AddCommGrpCat.epi_iff_surjective]
        intro y
        refine ⟨(y.val : ZMod (ℓ ^ (r + 1))), ?_⟩
        change (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r)))
          (y.val : ZMod (ℓ ^ (r + 1))) = y
        rw [map_natCast, ZMod.natCast_zmod_val]
      have hExact₀ : SC₀.Exact := by
        rw [CategoryTheory.ShortComplex.ab_exact_iff]
        intro z hz
        have hz' : ((z.val : ℕ) : ZMod (ℓ ^ r)) = 0 := by
          calc
            ((z.val : ℕ) : ZMod (ℓ ^ r))
              = (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r)))
                  ((z.val : ℕ) : ZMod (ℓ ^ (r + 1))) := (map_natCast _ z.val).symm
            _ = π_bock z := by rw [ZMod.natCast_zmod_val]; rfl
            _ = 0 := hz
        rw [ZMod.natCast_eq_zero_iff] at hz'
        obtain ⟨q_div, hq_div⟩ := hz'
        have hlt_mul : ℓ ^ r * q_div < ℓ ^ r * (ℓ ^ 1) := by
          rw [← hq_div, hmul_pow]
          exact ZMod.val_lt z
        have hq_lt : q_div < ℓ ^ 1 := Nat.lt_of_mul_lt_mul_left hlt_mul
        refine ⟨(q_div : ZMod (ℓ ^ 1)), ?_⟩
        change ((ℓ ^ r * (q_div : ZMod (ℓ ^ 1)).val : ℕ) : ZMod (ℓ ^ (r + 1))) = z
        rw [ZMod.val_natCast, Nat.mod_eq_of_lt hq_lt, ← hq_div, ZMod.natCast_zmod_val]
      have hSE₀ : SC₀.ShortExact :=
        CategoryTheory.ShortComplex.ShortExact.mk' hExact₀ hMono₀ hEpi₀

      let SC_u := SC₀.map AddCommGrpCat.uliftFunctor.{u, 0}
      have hSE_u : SC_u.ShortExact := hSE₀.map_of_exact AddCommGrpCat.uliftFunctor.{u, 0}
      let F_const_S : CategoryTheory.Functor AddCommGrpCat.{u}
          (CategoryTheory.Functor (Opposite S.Etale) AddCommGrpCat.{u}) :=
        CategoryTheory.Functor.const (Opposite S.Etale)
      let F_const_Y : CategoryTheory.Functor AddCommGrpCat.{u}
          (CategoryTheory.Functor (Opposite Y.Etale) AddCommGrpCat.{u}) :=
        CategoryTheory.Functor.const (Opposite Y.Etale)
      have := CategoryTheory.Limits.PreservesLimitsOfSize.preservesFiniteLimits.{0, 0} F_const_S
      have := CategoryTheory.Limits.PreservesColimitsOfSize.preservesFiniteColimits.{0, 0} F_const_S
      have := CategoryTheory.Limits.PreservesLimitsOfSize.preservesFiniteLimits.{0, 0} F_const_Y
      have := CategoryTheory.Limits.PreservesColimitsOfSize.preservesFiniteColimits.{0, 0} F_const_Y
      let SC_S := (SC_u.map F_const_S).map P_sh
      have hSE_S : SC_S.ShortExact := (hSE_u.map_of_exact F_const_S).map_of_exact P_sh
      let ι_Y : weilEtaleTorsionSheaf Y (ℓ ^ 1) ⟶ weilEtaleTorsionSheaf Y (ℓ ^ (r + 1)) :=
        C_Y.map (AddCommGrpCat.uliftFunctor.{u, 0}.map (AddCommGrpCat.ofHom ι_bock))
      let π_Y : weilEtaleTorsionSheaf Y (ℓ ^ (r + 1)) ⟶ weilEtaleTorsionSheaf Y (ℓ ^ r) :=
        C_Y.map (AddCommGrpCat.uliftFunctor.{u, 0}.map (AddCommGrpCat.ofHom π_bock))
      have h_zero_Y : ι_Y ≫ π_Y = 0 := ((SC_u.map F_const_Y).map P_sh_Y).zero
      have hSE_Y : (CategoryTheory.ShortComplex.mk ι_Y π_Y h_zero_Y).ShortExact :=
        (hSE_u.map_of_exact F_const_Y).map_of_exact P_sh_Y

      
      let P_pre : ℕ → ℕ → CategoryTheory.Functor (Opposite S.Etale) AddCommGrpCat.{u} :=
        fun m_idx q_deg =>
          CategoryTheory.Functor.comp B_f.op
            (CategoryTheory.Sheaf.cohomologyPresheaf (weilEtaleTorsionSheaf Y m_idx) q_deg)
      let ι_pre : ∀ q_deg : ℕ, P_pre (ℓ ^ 1) q_deg ⟶ P_pre (ℓ ^ (r + 1)) q_deg :=
        fun q_deg =>
          CategoryTheory.Functor.whiskerLeft B_f.op
            ((CategoryTheory.Sheaf.cohomologyPresheafFunctor Y.smallEtaleTopology q_deg).map ι_Y)
      let π_pre : ∀ q_deg : ℕ, P_pre (ℓ ^ (r + 1)) q_deg ⟶ P_pre (ℓ ^ r) q_deg :=
        fun q_deg =>
          CategoryTheory.Functor.whiskerLeft B_f.op
            ((CategoryTheory.Sheaf.cohomologyPresheafFunctor Y.smallEtaleTopology q_deg).map π_Y)
      let δ_pre : ∀ q_deg : ℕ, P_pre (ℓ ^ r) q_deg ⟶ P_pre (ℓ ^ 1) (q_deg + 1) :=
        fun q_deg =>
          { app := fun opV =>
              AddCommGrpCat.ofHom
                (hSE_Y.extClass.postcomp
                  (weilPolyP1CohomologyRepSheaf Y (B_f.obj opV.unop))
                  (rfl : q_deg + 1 = q_deg + 1))
            naturality := fun {opV₁ opV₂} u_op => by
              apply AddCommGrpCat.ext
              intro (x_ext : CategoryTheory.Abelian.Ext.{u}
                (weilPolyP1CohomologyRepSheaf Y (B_f.obj opV₁.unop))
                (weilEtaleTorsionSheaf Y (ℓ ^ r)) q_deg)
              let r_u : weilPolyP1CohomologyRepSheaf Y (B_f.obj opV₂.unop) ⟶
                  weilPolyP1CohomologyRepSheaf Y (B_f.obj opV₁.unop) :=
                P_sh_Y.map
                  (CategoryTheory.Functor.whiskerRight
                    (CategoryTheory.yoneda.map (B_f.map u_op.unop)) AddCommGrpCat.free)
              change ((CategoryTheory.Abelian.Ext.mk₀ r_u).comp x_ext (Nat.zero_add q_deg)).comp
                  hSE_Y.extClass (rfl : q_deg + 1 = q_deg + 1) =
                (CategoryTheory.Abelian.Ext.mk₀ r_u).comp
                  (x_ext.comp hSE_Y.extClass (rfl : q_deg + 1 = q_deg + 1))
                  (Nat.zero_add (q_deg + 1))
              exact CategoryTheory.Abelian.Ext.comp_assoc
                (CategoryTheory.Abelian.Ext.mk₀ r_u) x_ext hSE_Y.extClass
                (Nat.zero_add q_deg) (rfl : q_deg + 1 = q_deg + 1)
                (Nat.zero_add (q_deg + 1)) }
      have h_ιπ_zero : ∀ q_deg : ℕ, ι_pre q_deg ≫ π_pre q_deg = 0 := by
        intro q_deg
        apply CategoryTheory.NatTrans.ext
        funext opV
        apply AddCommGrpCat.ext
        intro (x_ext : CategoryTheory.Abelian.Ext.{u}
          (weilPolyP1CohomologyRepSheaf Y (B_f.obj opV.unop))
          (weilEtaleTorsionSheaf Y (ℓ ^ 1)) q_deg)
        change (x_ext.comp (CategoryTheory.Abelian.Ext.mk₀ ι_Y) (Nat.add_zero q_deg)).comp
          (CategoryTheory.Abelian.Ext.mk₀ π_Y) (Nat.add_zero q_deg) = 0
        rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ (Nat.add_zero q_deg),
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, h_zero_Y,
          CategoryTheory.Abelian.Ext.mk₀_zero, CategoryTheory.Abelian.Ext.comp_zero]
      have h_πδ_zero : ∀ q_deg : ℕ, π_pre q_deg ≫ δ_pre q_deg = 0 := by
        intro q_deg
        apply CategoryTheory.NatTrans.ext
        funext opV
        apply AddCommGrpCat.ext
        intro (x_ext : CategoryTheory.Abelian.Ext.{u}
          (weilPolyP1CohomologyRepSheaf Y (B_f.obj opV.unop))
          (weilEtaleTorsionSheaf Y (ℓ ^ (r + 1))) q_deg)
        change (x_ext.comp (CategoryTheory.Abelian.Ext.mk₀ π_Y) (Nat.add_zero q_deg)).comp
          hSE_Y.extClass (rfl : q_deg + 1 = q_deg + 1) = 0
        rw [CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero _ _ _
            (rfl : q_deg + 1 = q_deg + 1),
          hSE_Y.comp_extClass, CategoryTheory.Abelian.Ext.comp_zero]
      have h_δι_zero : ∀ q_deg : ℕ, δ_pre q_deg ≫ ι_pre (q_deg + 1) = 0 := by
        intro q_deg
        apply CategoryTheory.NatTrans.ext
        funext opV
        apply AddCommGrpCat.ext
        intro (x_ext : CategoryTheory.Abelian.Ext.{u}
          (weilPolyP1CohomologyRepSheaf Y (B_f.obj opV.unop))
          (weilEtaleTorsionSheaf Y (ℓ ^ r)) q_deg)
        change (x_ext.comp hSE_Y.extClass (rfl : q_deg + 1 = q_deg + 1)).comp
          (CategoryTheory.Abelian.Ext.mk₀ ι_Y) (Nat.add_zero (q_deg + 1)) = 0
        rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _
            (rfl : q_deg + 1 = q_deg + 1),
          hSE_Y.extClass_comp, CategoryTheory.Abelian.Ext.comp_zero]

      have hEx_mid : ∀ q_deg : ℕ,
          ((CategoryTheory.ShortComplex.mk (ι_pre q_deg) (π_pre q_deg)
            (h_ιπ_zero q_deg)).map P_sh).Exact := by
        intro q_deg
        apply hSheafExact
        intro opV
        exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₂'
          (weilPolyP1CohomologyRepSheaf Y (B_f.obj opV.unop)) hSE_Y q_deg

      have hPropZero : ∀ q_deg : ℕ,
          CategoryTheory.Limits.IsZero
            (weilEtaleHigherDirectImage f q_deg (weilEtaleTorsionSheaf Y (ℓ ^ 1))) →
          CategoryTheory.Limits.IsZero
            (weilEtaleHigherDirectImage f q_deg (weilEtaleTorsionSheaf Y (ℓ ^ r))) →
          CategoryTheory.Limits.IsZero
            (weilEtaleHigherDirectImage f q_deg (weilEtaleTorsionSheaf Y (ℓ ^ (r + 1)))) := by
        intro q_deg hL hR
        exact (hEx_mid q_deg).isZero_X₂ (hL.eq_of_src _ _) (hR.eq_of_tgt _ _)

      have hZ1_succ : CategoryTheory.Limits.IsZero
          (weilEtaleHigherDirectImage f 1 (weilEtaleTorsionSheaf Y (ℓ ^ (r + 1)))) :=
        hPropZero 1 _hZ1 ih.1
      have hZge3_succ : ∀ b : ℕ, 3 ≤ b → CategoryTheory.Limits.IsZero
          (weilEtaleHigherDirectImage f b (weilEtaleTorsionSheaf Y (ℓ ^ (r + 1)))) :=
        fun b hb => hPropZero b (_hZ_ge3 b hb) (ih.2.1 b hb)

      let SC_R2 := (CategoryTheory.ShortComplex.mk (ι_pre 2) (π_pre 2) (h_ιπ_zero 2)).map P_sh
      have hEx_left2 :
          ((CategoryTheory.ShortComplex.mk (δ_pre 1) (ι_pre 2)
            (h_δι_zero 1)).map P_sh).Exact := by
        apply hSheafExact
        intro opV
        exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₁'
          (weilPolyP1CohomologyRepSheaf Y (B_f.obj opV.unop)) hSE_Y 1 2 rfl
      have hEx_right2 :
          ((CategoryTheory.ShortComplex.mk (π_pre 2) (δ_pre 2)
            (h_πδ_zero 2)).map P_sh).Exact := by
        apply hSheafExact
        intro opV
        exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₃'
          (weilPolyP1CohomologyRepSheaf Y (B_f.obj opV.unop)) hSE_Y 2 3 rfl
      have hMono_R2 : CategoryTheory.Mono SC_R2.f :=
        hEx_left2.mono_g (ih.1.eq_of_src _ _)
      have hEpi_R2 : CategoryTheory.Epi SC_R2.g :=
        hEx_right2.epi_f ((_hZ_ge3 3 le_rfl).eq_of_tgt _ _)
      have hSE_R2 : SC_R2.ShortExact :=
        CategoryTheory.ShortComplex.ShortExact.mk' (hEx_mid 2) hMono_R2 hEpi_R2

      
      have hSq_right : SC_S.g ≫ γ r = γ (r + 1) ≫ SC_R2.g := by
        apply _hCoeff (r + 1) r π_bock
        have hval_π1 : (π_bock 1).val = 1 := by
          change ((ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r))) 1).val = 1
          rw [map_one, ZMod.val_one]
        rw [hval_π1, one_nsmul]
        exact _hTrans_c r

      have hSq_left : SC_S.f ≫ γ (r + 1) = γ 1 ≫ SC_R2.f := by
        apply _hCoeff 1 (r + 1) ι_bock
        have hval_ι1 : (ι_bock 1).val = ℓ ^ r := by
          change (((ℓ ^ r * (1 : ZMod (ℓ ^ 1)).val : ℕ) : ZMod (ℓ ^ (r + 1)))).val = ℓ ^ r
          rw [ZMod.val_one, mul_one, ZMod.val_natCast, Nat.mod_eq_of_lt hℓr_lt_succ]
        have h_euclid :
            AddCommGrpCat.ofHom (castTo1 r) ≫ AddCommGrpCat.ofHom ι_bock =
              (ℓ ^ r) • 𝟙 (AddCommGrpCat.of (ZMod (ℓ ^ (r + 1)))) := by
          ext z
          change ((ℓ ^ r * (castTo1 r z).val : ℕ) : ZMod (ℓ ^ (r + 1))) = (ℓ ^ r) • z
          have hcast_z : castTo1 r z = (z.val : ZMod (ℓ ^ 1)) := by
            calc
              castTo1 r z
                = (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_add_left 1 r)) (ZMod (ℓ ^ 1)))
                    ((z.val : ℕ) : ZMod (ℓ ^ (r + 1))) := by
                  rw [ZMod.natCast_zmod_val]; rfl
              _ = (z.val : ZMod (ℓ ^ 1)) := map_natCast _ z.val
          rw [hcast_z, ZMod.val_natCast]
          have hdiv := Nat.div_add_mod z.val (ℓ ^ 1)
          have hmul : ℓ ^ (r + 1) * (z.val / (ℓ ^ 1)) + ℓ ^ r * (z.val % (ℓ ^ 1)) =
              ℓ ^ r * z.val := by
            calc
              ℓ ^ (r + 1) * (z.val / (ℓ ^ 1)) + ℓ ^ r * (z.val % (ℓ ^ 1))
                = (ℓ ^ r * (ℓ ^ 1)) * (z.val / (ℓ ^ 1)) + ℓ ^ r * (z.val % (ℓ ^ 1)) := by
                    rw [hmul_pow]
              _ = ℓ ^ r * (ℓ ^ 1 * (z.val / (ℓ ^ 1)) + z.val % (ℓ ^ 1)) := by ring
              _ = ℓ ^ r * z.val := by rw [hdiv]
          have hcast_mul := congrArg (fun n : ℕ => (n : ZMod (ℓ ^ (r + 1)))) hmul
          have hzero : ((ℓ ^ (r + 1) : ℕ) : ZMod (ℓ ^ (r + 1))) = 0 :=
            CharP.cast_eq_zero (ZMod (ℓ ^ (r + 1))) (ℓ ^ (r + 1))
          rw [Nat.cast_add, Nat.cast_mul, hzero, zero_mul, zero_add] at hcast_mul
          rw [hcast_mul, Nat.cast_mul, ZMod.natCast_zmod_val, ← nsmul_eq_mul]
        have h_euclid_Y :
            castTo1_Y r ≫ ι_Y = (ℓ ^ r) • 𝟙 (weilEtaleTorsionSheaf Y (ℓ ^ (r + 1))) := by
          dsimp [castTo1_Y, ι_Y]
          rw [← C_Y.map_comp, ← AddCommGrpCat.uliftFunctor.{u, 0}.map_comp, h_euclid,
            CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id,
            CategoryTheory.Functor.map_nsmul, C_Y.map_id]
        have h_nsmul_ext : ∀ k : ℕ,
            (c_Y (r + 1)).comp
              (CategoryTheory.Abelian.Ext.mk₀
                (k • 𝟙 (weilEtaleTorsionSheaf Y (ℓ ^ (r + 1)))))
              (Nat.add_zero 2) = k • c_Y (r + 1) := by
          intro k
          induction k with
          | zero =>
            rw [zero_nsmul, zero_nsmul, CategoryTheory.Abelian.Ext.mk₀_zero,
              CategoryTheory.Abelian.Ext.comp_zero]
          | succ k ih_k =>
            rw [succ_nsmul, succ_nsmul, CategoryTheory.Abelian.Ext.mk₀_add,
              CategoryTheory.Abelian.Ext.comp_add, ih_k,
              CategoryTheory.Abelian.Ext.comp_mk₀_id]
        rw [hval_ι1, ← hCast_to_1 r]
        change ((c_Y (r + 1)).comp (CategoryTheory.Abelian.Ext.mk₀ (castTo1_Y r))
            (Nat.add_zero 2)).comp
          (CategoryTheory.Abelian.Ext.mk₀ ι_Y) (Nat.add_zero 2) = (ℓ ^ r) • c_Y (r + 1)
        rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ (Nat.add_zero 2),
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, h_euclid_Y, h_nsmul_ext (ℓ ^ r)]

      
      let Φ_sc : SC_S ⟶ SC_R2 :=
        { τ₁ := γ 1
          τ₂ := γ (r + 1)
          τ₃ := γ r
          comm₁₂ := hSq_left.symm
          comm₂₃ := hSq_right.symm }
      have : CategoryTheory.IsIso Φ_sc.τ₁ := _hIso1
      have : CategoryTheory.IsIso Φ_sc.τ₃ := ih.2.2
      have : CategoryTheory.Mono (γ (r + 1)) :=
        CategoryTheory.ShortComplex.mono_of_mono_of_mono_of_mono Φ_sc
          hSE_S.exact hSE_R2.mono_f inferInstance inferInstance
      have : CategoryTheory.Epi (γ (r + 1)) :=
        CategoryTheory.ShortComplex.epi_of_epi_of_epi_of_epi Φ_sc
          hSE_R2.exact hSE_S.epi_g inferInstance inferInstance
      have hIso_succ : CategoryTheory.IsIso (γ (r + 1)) :=
        CategoryTheory.isIso_of_mono_of_epi (γ (r + 1))
      exact ⟨hZ1_succ, hZge3_succ, hIso_succ⟩

  refine ⟨?_, ?_⟩
  · intro r b hb
    cases r with
    | zero => exact hZR₀ b
    | succ s => exact (hInd s).2.1 b hb
  · intro r
    cases r with
    | zero => exact hIso₀
    | succ s => exact (hInd s).2.2

theorem weil_polyP1_rel_projLine_direct_image_iso_and_vanishing (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar k)
    (hProp_Pd : ∀ δ : ℕ, AlgebraicGeometry.IsProper (weilPolyP1Over k δ).hom)
    (hProp_P1 : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver k 1).hom)
    (hH1_P1 : Subsingleton (weilEtaleTorsionH (weilProjectiveSpaceOver k 1).left ℓ 1))
    (hH_gt2_P1 : ∀ b : ℕ, 3 ≤ b → Subsingleton (weilEtaleTorsionH (weilProjectiveSpaceOver k 1).left ℓ b))
    (η : ∀ r : ℕ, weilEtaleTorsionH (weilProjectiveSpaceOver k 1).left (ℓ ^ r) 2)
    (hBij_η : ∀ r : ℕ, Function.Bijective (fun c : ZMod (ℓ ^ r) => c.val • η r))
    (hTrans_η : ∀ r : ℕ, weilEtaleTorsionTransition (weilProjectiveSpaceOver k 1).left ℓ r 2 (η (r + 1)) = η r)
    (p_ρ : ∀ (δ r : ℕ),
      weilEtaleTorsionH (weilProjectiveSpaceOver k 1).left (ℓ ^ r) 2 →+
        weilEtaleTorsionH (weilPolyP1Over k (δ + 1)).left (ℓ ^ r) 2)
    (hp_ρ : ∀ (δ r : ℕ),
      WeilIsTorsionEtalePullback
        (CategoryTheory.Limits.pullback.snd (weilPolyP1Over k δ).hom (weilProjectiveSpaceOver k 1).hom)
        (ℓ ^ r) 2 (p_ρ δ r)) :
    ∃ (γ_rel : WeilRelOrientationFamily k ℓ) (Tr_rel : WeilRelTraceFamily k ℓ),
      WeilIsRelProjLineTraceSystem k ℓ η p_ρ γ_rel Tr_rel :=
by
  classical
  have hPrime : Nat.Prime ℓ := Fact.out
  have hm_pow : ∀ r : ℕ, 1 ≤ ℓ ^ r := fun r => Nat.one_le_pow r ℓ hPrime.pos
  have hℓ_k : (ℓ : k) ≠ 0 := by
    intro h0
    have hdvd : ringChar k ∣ ℓ := (CharP.cast_eq_zero_iff k (ringChar k) ℓ).mp h0
    rcases CharP.char_is_prime_or_zero k (ringChar k) with hp | hz
    · rcases (Nat.dvd_prime hPrime).mp hdvd with h1 | heq
      · exact hp.ne_one h1
      · exact hℓ heq.symm
    · rw [hz, zero_dvd_iff] at hdvd
      exact hPrime.ne_zero hdvd
  let Aℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
  let AM : ℕ → AddCommGrpCat.{u} :=
    fun m => AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))

  
  have hTor_sheaf : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (m : ℕ),
      m • CategoryTheory.CategoryStruct.id (weilEtaleTorsionSheaf Z m) = 0 := by
    intro Z m
    have hAM : m • CategoryTheory.CategoryStruct.id (AM m) = 0 := by
      ext ⟨x⟩
      change ULift.up (m • x) = ULift.up 0
      simp [nsmul_eq_mul, CharP.cast_eq_zero]
    calc
      m • CategoryTheory.CategoryStruct.id (weilEtaleTorsionSheaf Z m)
        = (CategoryTheory.constantSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).map
            (m • CategoryTheory.CategoryStruct.id (AM m)) := by
            rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id]
      _ = (CategoryTheory.constantSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).map 0 := by
            rw [hAM]
      _ = 0 := CategoryTheory.Functor.map_zero _ _ _

  let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
  let T_k : S_k.Etale := weilEtaleIdTerminal.{u} S_k
  let hT_k : CategoryTheory.Limits.IsTerminal T_k := weilEtaleIdTerminalIsTerminal.{u} S_k
  let C_k := CategoryTheory.constantSheaf S_k.smallEtaleTopology AddCommGrpCat.{u}
  let Fℤ_Sk := C_k.obj Aℤ

  
  
  
  obtain ⟨hPull_ex, hPull_id, hPull_comp, hPull_trans, _⟩ :=
