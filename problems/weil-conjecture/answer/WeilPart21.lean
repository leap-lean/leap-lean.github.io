        (CategoryTheory.Adjunction.homEquiv_unit adj_S (pf_f.obj G)
          (pf_f.obj (pb_Y.obj G)) (bc₀ G)).symm.trans (Equiv.apply_symm_apply _ _)
      have h_epf_eq : e_pf.hom.app (pb_Y.obj G) ≫ e_pf₂.inv.app (pb_Y.obj G) =
          e_pf₁.inv.app (pb_Y.obj G) ≫ e_pf_c.hom.app (pb_Y.obj G) := by
