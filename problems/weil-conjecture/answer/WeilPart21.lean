            (CategoryTheory.Abelian.Ext.mk₀ e_ker.inv) (Nat.add_zero q) = u := by
        intro u
        rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, e_ker.hom_inv_id,
          CategoryTheory.Abelian.Ext.comp_mk₀_id]
      rw [← h_cancel x, ← h_cancel y, hxy]
    refine ⟨fun q hq => ?_, fun q hq => ?_⟩
