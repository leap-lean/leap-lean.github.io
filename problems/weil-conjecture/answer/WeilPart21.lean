    refine ⟨?_, ?_⟩
    · intro hSubGm₂ hNorm ξ hξ
      have hSubPush₁ := hPushSub E₁ E₂ Gm₂ 1 hSubGm₂
      have hSubJ₁ : Subsingleton (𝒥.H 1) := by
        refine subsingleton_of_forall_eq 0 (fun u => ?_)
        have hu_i₂ : u.comp (CategoryTheory.Abelian.Ext.mk₀ i₂) (Nat.add_zero 1) = 0 :=
