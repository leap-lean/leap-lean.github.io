  have hiso_V_inv : ∀ a : Fin m, G_L.map (iso_V a).inv = (e_V' a).inv :=
    fun a => G_L.map_preimage (X := Y_B a) (Y := V a) (e_V' a).inv
  have hiso_VV_hom : ∀ a b : Fin m, G_L.map (iso_VV a b).hom = (e_VV' a b).hom :=
    fun a b => G_L.map_preimage
      (X := CategoryTheory.Limits.pullback (p a) (p b)) (Y := Y_C a b) (e_VV' a b).hom

  have hp_iso : ∀ a : Fin m,
      p a = (iso_V a).hom ≫ u_φ a ≫ iso_Y.inv := by
    intro a
    apply G_L.map_injective
    rw [G_L.map_comp, G_L.map_comp, hiso_V_hom a, hu_φ a, hiso_Y_inv,
      ← CategoryTheory.Category.assoc, ← he_p' a,
      CategoryTheory.Category.assoc, e_Y'.hom_inv_id, CategoryTheory.Category.comp_id]

  have hpb_iso : ∀ a b : Fin m,
      CategoryTheory.Limits.pullback.fst (p a) (p b) =
        (iso_VV a b).hom ≫ u_fst a b ≫ (iso_V a).inv ∧
      CategoryTheory.Limits.pullback.snd (p a) (p b) =
        (iso_VV a b).hom ≫ u_snd a b ≫ (iso_V b).inv := by
    intro a b
    refine ⟨?_, ?_⟩
    · apply G_L.map_injective
      rw [G_L.map_comp, G_L.map_comp, hiso_VV_hom a b, hu_fst a b, hiso_V_inv a,
        ← CategoryTheory.Category.assoc, ← (he_pb' a b).1,
        CategoryTheory.Category.assoc, (e_V' a).hom_inv_id, CategoryTheory.Category.comp_id]
    · apply G_L.map_injective
      rw [G_L.map_comp, G_L.map_comp, hiso_VV_hom a b, hu_snd a b, hiso_V_inv b,
        ← CategoryTheory.Category.assoc, ← (he_pb' a b).2,
        CategoryTheory.Category.assoc, (e_V' b).hom_inv_id, CategoryTheory.Category.comp_id]

  refine ⟨m, V, p, Y_A, Y_B, Y_C, u_φ, u_fst, u_snd, iso_Y, iso_V, iso_VV,
    hSR, hS_mem, hp_iso, hpb_iso, ?_⟩

  
  let I : Type u := { M : IntermediateField F₀ L_inf // FiniteDimensional F₀ ↥M ∧ M₁ ≤ M }
  let _ : Preorder I := Subtype.preorder _
  let _ : Nonempty I := ⟨⟨M₁, hFD₁, le_rfl⟩⟩
  have hDir : ∀ i j : I, ∃ k : I, i ≤ k ∧ j ≤ k := by
    intro i j
    refine ⟨⟨i.1 ⊔ j.1,
      @IntermediateField.finiteDimensional_sup F₀ L_inf _ _ _ i.1 j.1 i.2.1 j.2.1,
      le_trans i.2.2 le_sup_left⟩,
      (le_sup_left : i.1 ≤ i.1 ⊔ j.1), (le_sup_right : j.1 ≤ i.1 ⊔ j.1)⟩

  let mkW_K : ∀ (R₀ : Type u) [CommRing R₀] [Algebra ↥M₁ R₀] [Algebra.Etale ↥M₁ R₀]
      (i : I), S_K.Etale := fun R₀ _ _ _ i =>
    letI : Algebra K ↥i.1 := RingHom.toAlgebra ((algebraMap F₀ ↥i.1).comp (algebraMap K F₀))
    letI : Algebra.Etale K ↥i.1 := hEtM i.1 i.2.1
    letI : Algebra ↥M₁ ↥i.1 := (IntermediateField.inclusion i.2.2).toRingHom.toAlgebra
    let hEtSpec : AlgebraicGeometry.Etale
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K ↥i.1))) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
        (RingHom.etale_algebraMap.mpr inferInstance)
    (weilAltCdFieldEtaleMap hEtSpec).obj (weilAltCdSpecEtaleObj ↥i.1 (TensorProduct ↥M₁ ↥i.1 R₀))

  let mkMap_K : ∀ {R₀ S₀ : Type u} [CommRing R₀] [CommRing S₀]
      [Algebra ↥M₁ R₀] [Algebra ↥M₁ S₀] [Algebra.Etale ↥M₁ R₀] [Algebra.Etale ↥M₁ S₀]
      (ψ₀ : R₀ →ₐ[↥M₁] S₀) (i : I),
      mkW_K S₀ i ⟶ mkW_K R₀ i := fun {R₀ S₀} _ _ _ _ _ _ ψ₀ i =>
    letI : Algebra K ↥i.1 := RingHom.toAlgebra ((algebraMap F₀ ↥i.1).comp (algebraMap K F₀))
    letI : Algebra.Etale K ↥i.1 := hEtM i.1 i.2.1
    letI : Algebra ↥M₁ ↥i.1 := (IntermediateField.inclusion i.2.2).toRingHom.toAlgebra
    let hEtSpec : AlgebraicGeometry.Etale
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K ↥i.1))) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
        (RingHom.etale_algebraMap.mpr inferInstance)
    (weilAltCdFieldEtaleMap hEtSpec).map
      (weilAltCdSpecEtaleMap ↥i.1 (Algebra.TensorProduct.map (AlgHom.id ↥i.1 ↥i.1) ψ₀))

  let mkStage_K : ∀ (R₀ : Type u) [CommRing R₀] [Algebra ↥M₁ R₀] [Algebra.Etale ↥M₁ R₀]
      {i j : I} (hij : i ≤ j),
      mkW_K R₀ j ⟶ mkW_K R₀ i := by
    intro R₀ _ _ _ i j hij
    letI : Algebra K ↥i.1 := RingHom.toAlgebra ((algebraMap F₀ ↥i.1).comp (algebraMap K F₀))
    letI : Algebra K ↥j.1 := RingHom.toAlgebra ((algebraMap F₀ ↥j.1).comp (algebraMap K F₀))
    letI : Algebra.Etale K ↥i.1 := hEtM i.1 i.2.1
    letI : Algebra.Etale K ↥j.1 := hEtM j.1 j.2.1
    letI : Algebra ↥M₁ ↥i.1 := (IntermediateField.inclusion i.2.2).toRingHom.toAlgebra
    letI : Algebra ↥M₁ ↥j.1 := (IntermediateField.inclusion j.2.2).toRingHom.toAlgebra
    letI : Algebra ↥i.1 ↥j.1 := (IntermediateField.inclusion hij).toRingHom.toAlgebra
    letI : IsScalarTower ↥M₁ ↥i.1 ↥j.1 := IsScalarTower.of_algebraMap_eq' rfl
    let ι_ij : CommRingCat.of (TensorProduct ↥M₁ ↥i.1 R₀) ⟶
        CommRingCat.of (TensorProduct ↥M₁ ↥j.1 R₀) :=
      CommRingCat.ofHom
        (Algebra.TensorProduct.map
          (IsScalarTower.toAlgHom ↥M₁ ↥i.1 ↥j.1) (AlgHom.id ↥M₁ R₀)).toRingHom
    have hring : CategoryTheory.CategoryStruct.comp
        (CategoryTheory.CategoryStruct.comp
          (CommRingCat.ofHom (algebraMap K ↥i.1))
          (CommRingCat.ofHom (algebraMap ↥i.1 (TensorProduct ↥M₁ ↥i.1 R₀))))
        ι_ij =
      CategoryTheory.CategoryStruct.comp
        (CommRingCat.ofHom (algebraMap K ↥j.1))
        (CommRingCat.ofHom (algebraMap ↥j.1 (TensorProduct ↥M₁ ↥j.1 R₀))) := by
      apply CommRingCat.hom_ext
      ext k
      change (Algebra.TensorProduct.map
          (IsScalarTower.toAlgHom ↥M₁ ↥i.1 ↥j.1) (AlgHom.id ↥M₁ R₀))
          ((algebraMap F₀ ↥i.1 (algebraMap K F₀ k)) ⊗ₜ[↥M₁] (1 : R₀)) =
        (algebraMap F₀ ↥j.1 (algebraMap K F₀ k)) ⊗ₜ[↥M₁] (1 : R₀)
      rw [Algebra.TensorProduct.map_tmul, AlgHom.id_apply]
      rfl
    refine @CategoryTheory.MorphismProperty.Over.homMk _ _ (@AlgebraicGeometry.Etale) ⊤
      S_K _ (mkW_K R₀ j) (mkW_K R₀ i) (AlgebraicGeometry.Spec.map ι_ij) ?_ trivial
    change CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map ι_ij)
        (CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap ↥i.1 (TensorProduct ↥M₁ ↥i.1 R₀))))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K ↥i.1)))) =
      CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap ↥j.1 (TensorProduct ↥M₁ ↥j.1 R₀))))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K ↥j.1)))
    rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
      ← AlgebraicGeometry.Spec.map_comp, hring]

  have hStage_comp : ∀ (R₀ : Type u) [CommRing R₀] [Algebra ↥M₁ R₀] [Algebra.Etale ↥M₁ R₀]
      {i j k : I} (hij : i ≤ j) (hjk : j ≤ k),
      mkStage_K R₀ (le_trans hij hjk) = mkStage_K R₀ hjk ≫ mkStage_K R₀ hij := by
    intro R₀ _ _ _ i j k hij hjk
    let _ : Algebra ↥M₁ ↥i.1 := (IntermediateField.inclusion i.2.2).toRingHom.toAlgebra
    let _ : Algebra ↥M₁ ↥j.1 := (IntermediateField.inclusion j.2.2).toRingHom.toAlgebra
    let _ : Algebra ↥M₁ ↥k.1 := (IntermediateField.inclusion k.2.2).toRingHom.toAlgebra
    let _ : Algebra ↥i.1 ↥j.1 := (IntermediateField.inclusion hij).toRingHom.toAlgebra
    let _ : Algebra ↥j.1 ↥k.1 := (IntermediateField.inclusion hjk).toRingHom.toAlgebra
    let _ : Algebra ↥i.1 ↥k.1 := (IntermediateField.inclusion (le_trans hij hjk)).toRingHom.toAlgebra
    let _ : IsScalarTower ↥M₁ ↥i.1 ↥j.1 := IsScalarTower.of_algebraMap_eq' rfl
    let _ : IsScalarTower ↥M₁ ↥j.1 ↥k.1 := IsScalarTower.of_algebraMap_eq' rfl
    let _ : IsScalarTower ↥M₁ ↥i.1 ↥k.1 := IsScalarTower.of_algebraMap_eq' rfl
    apply CategoryTheory.MorphismProperty.Comma.Hom.ext
    · change AlgebraicGeometry.Spec.map _ =
        AlgebraicGeometry.Spec.map _ ≫ AlgebraicGeometry.Spec.map _
      rw [← AlgebraicGeometry.Spec.map_comp]
      congr 1
      apply CommRingCat.hom_ext
      have halg :
          Algebra.TensorProduct.map (IsScalarTower.toAlgHom ↥M₁ ↥i.1 ↥k.1) (AlgHom.id ↥M₁ R₀) =
          (Algebra.TensorProduct.map
            (IsScalarTower.toAlgHom ↥M₁ ↥j.1 ↥k.1) (AlgHom.id ↥M₁ R₀)).comp
          (Algebra.TensorProduct.map
            (IsScalarTower.toAlgHom ↥M₁ ↥i.1 ↥j.1) (AlgHom.id ↥M₁ R₀)) :=
        Algebra.TensorProduct.ext' (fun _ _ => rfl)
      exact congrArg AlgHom.toRingHom halg
    · exact Subsingleton.elim _ _

  have hStage_nat : ∀ {R₀ S₀ : Type u} [CommRing R₀] [CommRing S₀]
      [Algebra ↥M₁ R₀] [Algebra ↥M₁ S₀] [Algebra.Etale ↥M₁ R₀] [Algebra.Etale ↥M₁ S₀]
      (ψ₀ : R₀ →ₐ[↥M₁] S₀) {i j : I} (hij : i ≤ j),
      mkStage_K S₀ hij ≫ mkMap_K ψ₀ i = mkMap_K ψ₀ j ≫ mkStage_K R₀ hij := by
    intro R₀ S₀ _ _ _ _ _ _ ψ₀ i j hij
    let _ : Algebra ↥M₁ ↥i.1 := (IntermediateField.inclusion i.2.2).toRingHom.toAlgebra
    let _ : Algebra ↥M₁ ↥j.1 := (IntermediateField.inclusion j.2.2).toRingHom.toAlgebra
    let _ : Algebra ↥i.1 ↥j.1 := (IntermediateField.inclusion hij).toRingHom.toAlgebra
    let _ : IsScalarTower ↥M₁ ↥i.1 ↥j.1 := IsScalarTower.of_algebraMap_eq' rfl
    apply CategoryTheory.MorphismProperty.Comma.Hom.ext
    · change AlgebraicGeometry.Spec.map _ ≫ AlgebraicGeometry.Spec.map _ =
        AlgebraicGeometry.Spec.map _ ≫ AlgebraicGeometry.Spec.map _
      rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
      congr 1
      apply CommRingCat.hom_ext
      have halg :
          (Algebra.TensorProduct.map
            (IsScalarTower.toAlgHom ↥M₁ ↥i.1 ↥j.1) (AlgHom.id ↥M₁ S₀)).comp
          ((Algebra.TensorProduct.map (AlgHom.id ↥i.1 ↥i.1) ψ₀).restrictScalars ↥M₁) =
          ((Algebra.TensorProduct.map (AlgHom.id ↥j.1 ↥j.1) ψ₀).restrictScalars ↥M₁).comp
          (Algebra.TensorProduct.map
            (IsScalarTower.toAlgHom ↥M₁ ↥i.1 ↥j.1) (AlgHom.id ↥M₁ R₀)) :=
        Algebra.TensorProduct.ext' (fun _ _ => rfl)
      exact congrArg AlgHom.toRingHom halg
    · exact Subsingleton.elim _ _

  have h𝒢_comp : ∀ {X Y Z : S_K.Etale} (f : X ⟶ Y) (g : Y ⟶ Z)
      (z : ↥(𝒢.obj.obj (Opposite.op Z))),
      (𝒢.obj.map (f ≫ g).op).hom z =
        (𝒢.obj.map f.op).hom ((𝒢.obj.map g.op).hom z) :=
    fun f g z => congrArg (fun m => m.hom z) (𝒢.obj.map_comp g.op f.op)

  have hStage_exact : ∀ i : I,
      (∀ (x_sec : ∀ a : Fin m, ↥(𝒢.obj.obj (Opposite.op (mkW_K (B₁ a) i)))),
        (∀ a b : Fin m,
          (𝒢.obj.map (mkMap_K (π₁_fst a b) i).op).hom (x_sec a) =
          (𝒢.obj.map (mkMap_K (π₁_snd a b) i).op).hom (x_sec b)) →
        ∃ z : ↥(𝒢.obj.obj (Opposite.op (mkW_K A₁ i))),
          ∀ a : Fin m, (𝒢.obj.map (mkMap_K (φ₁ a) i).op).hom z = x_sec a) ∧
      (∀ z₁ z₂ : ↥(𝒢.obj.obj (Opposite.op (mkW_K A₁ i))),
        (∀ a : Fin m,
          (𝒢.obj.map (mkMap_K (φ₁ a) i).op).hom z₁ =
          (𝒢.obj.map (mkMap_K (φ₁ a) i).op).hom z₂) →
        z₁ = z₂) := by
    intro i
    let _ : Algebra K ↥i.1 := RingHom.toAlgebra ((algebraMap F₀ ↥i.1).comp (algebraMap K F₀))
    let _ : Algebra.Etale K ↥i.1 := hEtM i.1 i.2.1
    let _ : Algebra ↥M₁ ↥i.1 := (IntermediateField.inclusion i.2.2).toRingHom.toAlgebra
    let hEtSpec : AlgebraicGeometry.Etale
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K ↥i.1))) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
        (RingHom.etale_algebraMap.mpr inferInstance)
    exact hS3 ↥i.1 hEtSpec 𝒢 m
      (TensorProduct ↥M₁ ↥i.1 A₁)
      (fun a => TensorProduct ↥M₁ ↥i.1 (B₁ a))
      (fun a b => TensorProduct ↥M₁ ↥i.1 (C₁ a b))
      (fun a => Algebra.TensorProduct.map (AlgHom.id ↥i.1 ↥i.1) (φ₁ a))
      (fun a b => Algebra.TensorProduct.map (AlgHom.id ↥i.1 ↥i.1) (π₁_fst a b))
      (fun a b => Algebra.TensorProduct.map (AlgHom.id ↥i.1 ↥i.1) (π₁_snd a b))
      (hStageM i.1 i.2.2).1
      (hStageM i.1 i.2.2).2

  exact hS4 hDir m
    (fun i => ↥(𝒢.obj.obj (Opposite.op (mkW_K A₁ i))))
    (fun a i => ↥(𝒢.obj.obj (Opposite.op (mkW_K (B₁ a) i))))
    (fun a b i => ↥(𝒢.obj.obj (Opposite.op (mkW_K (C₁ a b) i))))
    (fun {i j} hij => (𝒢.obj.map (mkStage_K A₁ hij).op).hom)
    (fun a {i j} hij => (𝒢.obj.map (mkStage_K (B₁ a) hij).op).hom)
    (fun a b {i j} hij => (𝒢.obj.map (mkStage_K (C₁ a b) hij).op).hom)
    (fun a i => (𝒢.obj.map (mkMap_K (φ₁ a) i).op).hom)
    (fun a b i => (𝒢.obj.map (mkMap_K (π₁_fst a b) i).op).hom)
    (fun a b i => (𝒢.obj.map (mkMap_K (π₁_snd a b) i).op).hom)
    ↥(Q.obj (Opposite.op Y_A))
    (fun a => ↥(Q.obj (Opposite.op (Y_B a))))
    (fun a b => ↥(Q.obj (Opposite.op (Y_C a b))))
    (fun a => (Q.map (u_φ a).op).hom)
    (fun a b => (Q.map (u_fst a b).op).hom)
    (fun a b => (Q.map (u_snd a b).op).hom)
    (fun i => κ M₁ hFD₁ A₁ i.1 i.2.1 i.2.2)
    (fun a i => κ M₁ hFD₁ (B₁ a) i.1 i.2.1 i.2.2)
    (fun a b i => κ M₁ hFD₁ (C₁ a b) i.1 i.2.1 i.2.2)
    (fun a {i j k} hij hjk x => by
      rw [← h𝒢_comp (mkStage_K (B₁ a) hjk) (mkStage_K (B₁ a) hij) x,
        ← hStage_comp (B₁ a) hij hjk])
    (fun a b {i j k} hij hjk x => by
      rw [← h𝒢_comp (mkStage_K (C₁ a b) hjk) (mkStage_K (C₁ a b) hij) x,
        ← hStage_comp (C₁ a b) hij hjk])
    (fun a {i j} hij z => by
      rw [← h𝒢_comp (mkMap_K (φ₁ a) j) (mkStage_K A₁ hij) z,
        ← hStage_nat (φ₁ a) hij,
        h𝒢_comp (mkStage_K (B₁ a) hij) (mkMap_K (φ₁ a) i) z])
    (fun a b {i j} hij x => by
      rw [← h𝒢_comp (mkMap_K (π₁_fst a b) j) (mkStage_K (B₁ a) hij) x,
        ← hStage_nat (π₁_fst a b) hij,
        h𝒢_comp (mkStage_K (C₁ a b) hij) (mkMap_K (π₁_fst a b) i) x])
    (fun a b {i j} hij x => by
      rw [← h𝒢_comp (mkMap_K (π₁_snd a b) j) (mkStage_K (B₁ b) hij) x,
        ← hStage_nat (π₁_snd a b) hij,
        h𝒢_comp (mkStage_K (C₁ a b) hij) (mkMap_K (π₁_snd a b) i) x])
    (fun {i j} hij z =>
      hκ_compat M₁ hFD₁ A₁ i.1 j.1 i.2.1 j.2.1 i.2.2 hij (mkStage_K A₁ hij) rfl z)
    (fun a {i j} hij x =>
      hκ_compat M₁ hFD₁ (B₁ a) i.1 j.1 i.2.1 j.2.1 i.2.2 hij (mkStage_K (B₁ a) hij) rfl x)
    (fun a i z =>
      hκ_nat M₁ hFD₁ A₁ (B₁ a) (φ₁ a) i.1 i.2.1 i.2.2 (u_φ a)
        (G_L.map_preimage (X := Y_B a) (Y := Y_A) (map_φ_L a)) z)
    (fun a b i x =>
      hκ_nat M₁ hFD₁ (B₁ a) (C₁ a b) (π₁_fst a b) i.1 i.2.1 i.2.2 (u_fst a b)
        (G_L.map_preimage (X := Y_C a b) (Y := Y_B a) (map_fst_L a b)) x)
    (fun a b i x =>
      hκ_nat M₁ hFD₁ (B₁ b) (C₁ a b) (π₁_snd a b) i.1 i.2.1 i.2.2 (u_snd a b)
        (G_L.map_preimage (X := Y_C a b) (Y := Y_B b) (map_snd_L a b)) x)
    (fun s => by
      rcases (hκ_colim M₁ hFD₁ A₁).1 s with ⟨M, hFD, hle, z, hz⟩
      exact ⟨⟨M, hFD, hle⟩, z, hz⟩)
    (fun a y => by
      rcases (hκ_colim M₁ hFD₁ (B₁ a)).1 y with ⟨M, hFD, hle, x, hx⟩
      exact ⟨⟨M, hFD, hle⟩, x, hx⟩)
    (fun a i x hx => by
      rcases (hκ_colim M₁ hFD₁ (B₁ a)).2 i.1 i.2.1 i.2.2 x hx with
        ⟨M₂, hFD₂, hle₁₂, p₁₂, hp₁₂_left, hkill⟩
      let j : I := ⟨M₂, hFD₂, le_trans i.2.2 hle₁₂⟩
      have hp_eq : p₁₂ = mkStage_K (B₁ a) (j := j) hle₁₂ :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext hp₁₂_left (Subsingleton.elim _ _)
      rw [hp_eq] at hkill
      exact ⟨j, hle₁₂, hkill⟩)
    (fun a b i w hw => by
      rcases (hκ_colim M₁ hFD₁ (C₁ a b)).2 i.1 i.2.1 i.2.2 w hw with
        ⟨M₂, hFD₂, hle₁₂, p₁₂, hp₁₂_left, hkill⟩
      let j : I := ⟨M₂, hFD₂, le_trans i.2.2 hle₁₂⟩
      have hp_eq : p₁₂ = mkStage_K (C₁ a b) (j := j) hle₁₂ :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext hp₁₂_left (Subsingleton.elim _ _)
      rw [hp_eq] at hkill
      exact ⟨j, hle₁₂, hkill⟩)
    (fun i => (hStage_exact i).1)
    (fun i => (hStage_exact i).2)

theorem weil_alt_cd_affine_lan_sheaf_leftAdjoint_iso {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (h : S₁ ⟶ S₂)
    [(weilAltCdSitePullback h).IsContinuous S₂.smallEtaleTopology S₁.smallEtaleTopology] :
    let G₁ := AlgebraicGeometry.Scheme.AffineEtale.Spec S₁
    let G₂ := AlgebraicGeometry.Scheme.AffineEtale.Spec S₂
    let B_site := weilAltCdSitePullback h
    let P_push := B_site.sheafPushforwardContinuous AddCommGrpCat.{u}
      S₂.smallEtaleTopology S₁.smallEtaleTopology
    ∀ (F_BC : CategoryTheory.Functor S₂.AffineEtale S₁.AffineEtale)
      (_ : CategoryTheory.Functor.comp F_BC G₁ ≅ CategoryTheory.Functor.comp G₂ B_site)
      (L_aff : CategoryTheory.Functor
        (CategoryTheory.Functor (S₂.AffineEtale)ᵒᵖ AddCommGrpCat.{u})
        (CategoryTheory.Functor (S₁.AffineEtale)ᵒᵖ AddCommGrpCat.{u}))
      (_ : L_aff ⊣
        (CategoryTheory.Functor.whiskeringLeft
          (S₂.AffineEtale)ᵒᵖ (S₁.AffineEtale)ᵒᵖ AddCommGrpCat.{u}).obj F_BC.op)
      (_ : ∀ 𝒢 : CategoryTheory.Sheaf S₂.smallEtaleTopology AddCommGrpCat.{u},
        CategoryTheory.Presheaf.IsSheaf
          (AlgebraicGeometry.Scheme.AffineEtale.topology S₁)
          (L_aff.obj (CategoryTheory.Functor.comp G₂.op 𝒢.obj)))
      (P_inf : CategoryTheory.Functor
        (CategoryTheory.Sheaf S₂.smallEtaleTopology AddCommGrpCat.{u})
        (CategoryTheory.Sheaf S₁.smallEtaleTopology AddCommGrpCat.{u}))
      (_ : P_inf ⊣ P_push),
      ∃ (Θ : ∀ (𝒢 : CategoryTheory.Sheaf S₂.smallEtaleTopology AddCommGrpCat.{u})
          (Y : S₁.AffineEtale),
        (L_aff.obj (CategoryTheory.Functor.comp G₂.op 𝒢.obj)).obj (Opposite.op Y) ≅
          (P_inf.obj 𝒢).obj.obj (Opposite.op (G₁.obj Y))),
        (∀ {𝒢₁ 𝒢₂ : CategoryTheory.Sheaf S₂.smallEtaleTopology AddCommGrpCat.{u}}
            (φ : 𝒢₁ ⟶ 𝒢₂) (Y : S₁.AffineEtale),
          CategoryTheory.CategoryStruct.comp
            ((L_aff.map (CategoryTheory.Functor.whiskerLeft G₂.op φ.hom)).app (Opposite.op Y))
            (Θ 𝒢₂ Y).hom =
          CategoryTheory.CategoryStruct.comp
            (Θ 𝒢₁ Y).hom
            ((P_inf.map φ).hom.app (Opposite.op (G₁.obj Y)))) ∧
        (∀ (𝒢 : CategoryTheory.Sheaf S₂.smallEtaleTopology AddCommGrpCat.{u})
            {Y' Y : S₁.AffineEtale} (u : Y' ⟶ Y),
          CategoryTheory.CategoryStruct.comp
            ((L_aff.obj (CategoryTheory.Functor.comp G₂.op 𝒢.obj)).map u.op)
