    have hunit_inv : u_M.op ≫ (eq_K.unitIso.app X_MB).inv.op =
        (eq_K.unitIso.app X_MA).inv.op ≫ (eq_K.inverse.map (eq_K.functor.map u_M)).op := by
      apply Opposite.unop_injective
      change (eq_K.unitIso.app X_MB).inv ≫ u_M =
