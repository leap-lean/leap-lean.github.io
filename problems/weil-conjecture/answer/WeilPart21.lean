      let a : Fℤ_X' ⟶ pb_g.obj (pb_π.obj Fℤ_Z) := ιℤ_gπ ≫ η_hom Fℤ_Z
      have h1 : (a ≫ pb_g.map πℤ_π) ≫ πℤ_g = 𝟙 Fℤ_X' := by
        dsimp [a]
        rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, ← hπℤ_fac]
        exact hιgπ1
      have h2 : a ≫ pb_g.map πℤ_π = ιℤ_g := by
        calc
