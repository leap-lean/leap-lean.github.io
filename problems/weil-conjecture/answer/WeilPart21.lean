    intro δ M S hCD_M X₁ X₂ X₃ X₄ g₁ g₂ g₃ h₁₂ h₂₃ hTor₁ hTor₂ hMono₁ hEx₁₂ hEx₂₃ hEpi₃ Fℤ_S
    have : CategoryTheory.Mono g₁ := hMono₁
    have : CategoryTheory.Epi g₃ := hEpi₃
    let B₂ := CategoryTheory.Limits.cokernel g₁
    let p_A : X₂ ⟶ B₂ := CategoryTheory.Limits.cokernel.π g₁
    let ι_B : B₂ ⟶ X₃ := CategoryTheory.Limits.cokernel.desc g₁ g₂ h₁₂
