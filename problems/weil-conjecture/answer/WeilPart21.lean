  let p_can : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Z₁ ⟶ Z₂) (i : ℕ),
      weilEtaleTorsionH Z₂ M i →+ weilEtaleTorsionH Z₁ M i :=
    fun {Z₁ Z₂} h i =>
      let pb_h := (weilEtaleSitePullback h).sheafPullback AddCommGrpCat.{u}
        Z₂.smallEtaleTopology Z₁.smallEtaleTopology
      let Fℤ₁ := (CategoryTheory.constantSheaf Z₁.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
      let Fℤ₂ := (CategoryTheory.constantSheaf Z₂.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
