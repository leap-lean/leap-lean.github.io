    have hA_S_range : ∀ i : ι, ∃ p : MvPolynomial ↥(S : Set L) F₀,
        MvPolynomial.aeval x_val p = a i := by
      intro i
      have hmem : a i ∈ Algebra.adjoin F₀ (S : Set L) := ha_mem i
      rw [Algebra.adjoin_eq_range] at hmem
      exact hmem
    let P : ι → MvPolynomial ↥(S : Set L) F₀ := fun i => Classical.choose (hA_S_range i)
    have hP_eval : ∀ i : ι, MvPolynomial.aeval x_val (P i) = a i :=
