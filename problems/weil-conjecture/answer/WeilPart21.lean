      (∀ (a b : Fin m) {i j k : I} (hij : i ≤ j) (hjk : j ≤ k) (x : G_C a b i),
        τ_C a b hjk (τ_C a b hij x) = τ_C a b (le_trans hij hjk) x) →
      (∀ (a : Fin m) {i j : I} (hij : i ≤ j) (z : G_A i),
        res_φ a j (τ_A hij z) = τ_B a hij (res_φ a i z)) →
