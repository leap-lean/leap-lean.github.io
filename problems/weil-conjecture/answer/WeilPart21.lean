          ((R₁.mapExtAddHom L₁ G q) ((CategoryTheory.Abelian.Ext.mk₀ lam_g).comp z (Nat.zero_add q)))
          (Nat.zero_add q)).comp (CategoryTheory.Abelian.Ext.mk₀ (ρ_M W₁)) (Nat.add_zero q) =
        ((CategoryTheory.Abelian.Ext.mk₀ (σ_h_ℤ ≫ R_h.map (u_W W₂) ≫ e_g.hom.app L₂)).comp
          ((R₁.mapExtAddHom L₂ G q) z) (Nat.zero_add q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (e_g.inv.app G ≫ R_h.map (ρ_M W₂) ≫ ρ'_h_M))
          (Nat.add_zero q) :=
      (congrArg (fun t => t.comp (CategoryTheory.Abelian.Ext.mk₀ (ρ_M W₁)) (Nat.add_zero q))
        (hExtPreMapLeft R₁ (u_W W₁) lam_g z)).trans
        (congrArg₂ (fun u r =>
          ((CategoryTheory.Abelian.Ext.mk₀ u).comp ((R₁.mapExtAddHom L₂ G q) z) (Nat.zero_add q)).comp
            (CategoryTheory.Abelian.Ext.mk₀ r) (Nat.add_zero q))
          hLeftId.symm hRightId.symm)
    have hR_step : (R_h.mapExtAddHom (C₂.obj Aℤ) (C₂.obj AM) q)
        (((CategoryTheory.Abelian.Ext.mk₀ (u_W W₂)).comp
          ((R₂.mapExtAddHom L₂ G q) z) (Nat.zero_add q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (ρ_M W₂)) (Nat.add_zero q)) =
        ((CategoryTheory.Abelian.Ext.mk₀ (R_h.map (u_W W₂))).comp
          ((R_h.mapExtAddHom (R₂.obj L₂) (R₂.obj G) q) ((R₂.mapExtAddHom L₂ G q) z))
          (Nat.zero_add q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (R_h.map (ρ_M W₂))) (Nat.add_zero q) := by
      rw [CategoryTheory.Functor.mapExtAddHom_apply R_h,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        ← CategoryTheory.Functor.mapExtAddHom_apply R_h]
    have hCompIso : (R_h.mapExtAddHom (R₂.obj L₂) (R₂.obj G) q) ((R₂.mapExtAddHom L₂ G q) z) =
        (CategoryTheory.Abelian.Ext.mk₀ (e_g.hom.app L₂)).comp
          (((R₁.mapExtAddHom L₂ G q) z).comp
            (CategoryTheory.Abelian.Ext.mk₀ (e_g.inv.app G)) (Nat.add_zero q))
          (Nat.zero_add q) :=
      (hExtComp R₂ R_h q L₂ G z).symm.trans (hExtNatIso R₁ (R₂.comp R_h) e_g.symm q L₂ G z)
    have hRHS_1 : p_g (Θ W₂ z) =
        ((CategoryTheory.Abelian.Ext.mk₀ σ_h_ℤ).comp
          (((CategoryTheory.Abelian.Ext.mk₀ (R_h.map (u_W W₂))).comp
            ((CategoryTheory.Abelian.Ext.mk₀ (e_g.hom.app L₂)).comp
              (((R₁.mapExtAddHom L₂ G q) z).comp
                (CategoryTheory.Abelian.Ext.mk₀ (e_g.inv.app G)) (Nat.add_zero q))
              (Nat.zero_add q))
            (Nat.zero_add q)).comp
            (CategoryTheory.Abelian.Ext.mk₀ (R_h.map (ρ_M W₂))) (Nat.add_zero q))
          (Nat.zero_add q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ ρ'_h_M) (Nat.add_zero q) :=
      (hp_Rh (Θ W₂ z)).trans
        ((congrArg (fun w =>
            ((CategoryTheory.Abelian.Ext.mk₀ σ_h_ℤ).comp w (Nat.zero_add q)).comp
              (CategoryTheory.Abelian.Ext.mk₀ ρ'_h_M) (Nat.add_zero q))
          ((congrArg (R_h.mapExtAddHom (C₂.obj Aℤ) (C₂.obj AM) q) (hΘ_eq W₂ z)).trans
            (hR_step.trans
              (congrArg (fun t =>
                  ((CategoryTheory.Abelian.Ext.mk₀ (R_h.map (u_W W₂))).comp t (Nat.zero_add q)).comp
                    (CategoryTheory.Abelian.Ext.mk₀ (R_h.map (ρ_M W₂))) (Nat.add_zero q))
                hCompIso)))))
    exact hLHS_1.trans
      (hLHS_2.trans
        ((hExtSixWayAssoc σ_h_ℤ (R_h.map (u_W W₂)) (e_g.hom.app L₂)
          ((R₁.mapExtAddHom L₂ G q) z)
          (e_g.inv.app G) (R_h.map (ρ_M W₂)) ρ'_h_M).trans hRHS_1.symm))

  refine ⟨hConj1, fun n m q R _ w hProj => ?_⟩
  let R_prod := ∀ i : Fin n, R i
  let S_prod := AlgebraicGeometry.Spec (CommRingCat.of R_prod)
  let G := weilEtaleTorsionSheaf S_prod m
  let T := weilEtaleIdTerminal.{u} S_prod
  let hT := weilEtaleIdTerminalIsTerminal.{u} S_prod
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let π_ev : ∀ j : Fin n, R_prod →+* R j := fun j => Pi.evalRingHom R j
  let e_idemp : ∀ j : Fin n, R_prod := fun j => Pi.single j (1 : R j)
  let ι_spec : ∀ j : Fin n, AlgebraicGeometry.Spec (CommRingCat.of (R j)) ⟶ S_prod :=
    fun j => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (π_ev j))

  have hSurj_π : ∀ j : Fin n, Function.Surjective (π_ev j) :=
    fun j y => ⟨Pi.single j y, Pi.single_eq_same j y⟩

  have hEt_ι : ∀ j : Fin n, AlgebraicGeometry.Etale (ι_spec j) := by
    intro j
    let _ : Algebra R_prod (R j) := (π_ev j).toAlgebra
    have hAlgEq : algebraMap R_prod (R j) = π_ev j := rfl
    have : IsLocalization.Away (e_idemp j) (R j) :=
      { map_units := by
          rintro ⟨_, k, rfl⟩
          rw [hAlgEq, map_pow]
          change IsUnit ((Pi.single j (1 : R j) j) ^ k)
          rw [Pi.single_eq_same, one_pow]
          exact isUnit_one
        surj := fun z =>
          ⟨⟨Pi.single j z, ⟨1, 0, pow_zero _⟩⟩, by
            rw [hAlgEq, map_one, mul_one]
            exact (Pi.single_eq_same j z).symm⟩
        exists_of_eq := fun {x₁ x₂} hx => by
          refine ⟨⟨e_idemp j, 1, pow_one _⟩, ?_⟩
          funext i
          change e_idemp j i * x₁ i = e_idemp j i * x₂ i
          by_cases hi : i = j
          · subst hi
            have hx' : x₁ i = x₂ i := hx
            simp [e_idemp, hx']
          · simp [e_idemp, Pi.single_eq_of_ne hi] }
    have : Algebra.Etale R_prod (R j) := Algebra.Etale.of_isLocalizationAway (e_idemp j)
    exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := P_et)).mpr
      (RingHom.etale_algebraMap.mpr inferInstance)

  let W_j : Fin n → S_prod.Etale :=
    fun j => CategoryTheory.MorphismProperty.Over.mk ⊤ (ι_spec j) (hEt_ι j)
  let ι_over : ∀ j : Fin n, W_j j ⟶ T := fun j => hT.from (W_j j)
  have hι_over_left : ∀ j : Fin n, (ι_over j).left = ι_spec j := fun j =>
    (CategoryTheory.Category.comp_id (ι_over j).left).symm.trans
      (CategoryTheory.MorphismProperty.Over.w (ι_over j))

  have hMono_ι : ∀ j : Fin n, CategoryTheory.Mono (ι_over j) := by
    intro j
    refine ⟨fun {Y} g₁ g₂ hg => ?_⟩
    have hg_left : g₁.left ≫ ι_spec j = g₂.left ≫ ι_spec j := by
      have h1 : g₁.left ≫ (ι_over j).left = g₂.left ≫ (ι_over j).left :=
        congrArg (fun k => k.left) hg
      rwa [hι_over_left j] at h1
    apply CategoryTheory.MorphismProperty.Comma.Hom.ext _ (Subsingleton.elim _ _)
    apply (AlgebraicGeometry.ΓSpec.adjunction.homEquiv Y.left
      (Opposite.op (CommRingCat.of (R j)))).symm.injective
    have hnat₁ := AlgebraicGeometry.ΓSpec.adjunction.homEquiv_naturality_right_symm
      g₁.left (CommRingCat.ofHom (π_ev j)).op
    have hnat₂ := AlgebraicGeometry.ΓSpec.adjunction.homEquiv_naturality_right_symm
      g₂.left (CommRingCat.ofHom (π_ev j)).op
    have heq_comp : (AlgebraicGeometry.ΓSpec.adjunction.homEquiv Y.left _).symm g₁.left ≫
        (CommRingCat.ofHom (π_ev j)).op =
        (AlgebraicGeometry.ΓSpec.adjunction.homEquiv Y.left _).symm g₂.left ≫
        (CommRingCat.ofHom (π_ev j)).op := by
      rw [← hnat₁, ← hnat₂]
      exact congrArg (AlgebraicGeometry.ΓSpec.adjunction.homEquiv Y.left _).symm hg_left
    have hunop := congrArg Quiver.Hom.unop heq_comp
    apply Quiver.Hom.unop_inj
    ext y
    obtain ⟨x, rfl⟩ := hSurj_π j y
    exact congrArg (fun φ : CommRingCat.of R_prod ⟶ _ => φ.hom x) hunop

  have hJointSurj : ∀ p : ↥S_prod,
      ∃ (j : Fin n) (q_j : ↥(W_j j).left), (ι_over j).left.base q_j = p := by
    intro p
    change PrimeSpectrum R_prod at p
    have hprod_zero : (∏ i : Fin n, (1 - e_idemp i : R_prod)) = 0 := by
      funext k
      rw [Finset.prod_apply, Pi.zero_apply]
      refine Finset.prod_eq_zero (Finset.mem_univ k) ?_
      change 1 - Pi.single k (1 : R k) k = 0
      rw [Pi.single_eq_same, sub_self]
    have hprod_mem : (∏ i ∈ Finset.univ, (1 - e_idemp i : R_prod)) ∈ p.asIdeal := by
      rw [hprod_zero]
      exact p.asIdeal.zero_mem
    obtain ⟨j, _, hj_mem⟩ := p.isPrime.prod_mem_iff.mp hprod_mem
    have hker_le : RingHom.ker (π_ev j) ≤ p.asIdeal := by
      intro x hx
      have hx_eq : x = x * (1 - e_idemp j) := by
        funext i
        change x i = x i * (1 - Pi.single j (1 : R j) i)
        by_cases hi : i = j
        · subst hi
          have hx0 : x i = 0 := hx
          rw [Pi.single_eq_same, sub_self, mul_zero, hx0]
        · rw [Pi.single_eq_of_ne hi, sub_zero, mul_one]
      rw [hx_eq]
      exact p.asIdeal.mul_mem_left x hj_mem
    have hPrime_map : (Ideal.map (π_ev j) p.asIdeal).IsPrime :=
      Ideal.map_isPrime_of_surjective (hSurj_π j) hker_le
    let q_j : PrimeSpectrum (R j) := ⟨Ideal.map (π_ev j) p.asIdeal, hPrime_map⟩
    refine ⟨j, q_j, ?_⟩
    rw [hι_over_left j]
    apply PrimeSpectrum.ext
    change Ideal.comap (π_ev j) (Ideal.map (π_ev j) p.asIdeal) = p.asIdeal
    rw [Ideal.comap_map_of_surjective (π_ev j) (hSurj_π j)]
    exact sup_eq_left.mpr hker_le

  have hOverlapEmpty : ∀ {j₁ j₂ : Fin n} (hne : j₁ ≠ j₂) (Y : S_prod.Etale)
      (g₁ : Y ⟶ W_j j₁) (g₂ : Y ⟶ W_j j₂),
      g₁ ≫ ι_over j₁ = g₂ ≫ ι_over j₂ → IsEmpty ↥Y.left := by
    intro j₁ j₂ hne Y g₁ g₂ hcomm
    refine ⟨fun y => ?_⟩
    have hbase : (g₁.left ≫ ι_spec j₁).base y = (g₂.left ≫ ι_spec j₂).base y := by
      rw [← hι_over_left j₁, ← hι_over_left j₂]
      exact congrArg (fun k : Y ⟶ T => k.left.base y) hcomm
    let q₁ : PrimeSpectrum (R j₁) := g₁.left.base y
    let q₂ : PrimeSpectrum (R j₂) := g₂.left.base y
    have hideal : Ideal.comap (π_ev j₁) q₁.asIdeal = Ideal.comap (π_ev j₂) q₂.asIdeal :=
      congrArg PrimeSpectrum.asIdeal hbase
    have he_rhs : e_idemp j₁ ∈ Ideal.comap (π_ev j₂) q₂.asIdeal := by
      change Pi.single j₁ (1 : R j₁) j₂ ∈ q₂.asIdeal
      rw [Pi.single_eq_of_ne hne.symm]
      exact q₂.asIdeal.zero_mem
    rw [← hideal] at he_rhs
    change Pi.single j₁ (1 : R j₁) j₁ ∈ q₁.asIdeal at he_rhs
    rw [Pi.single_eq_same] at he_rhs
    exact q₁.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ he_rhs isUnit_one)

  have hEmptySubsingleton : ∀ (Y : S_prod.Etale), IsEmpty ↥Y.left →
      ∀ (ℱ : CategoryTheory.Sheaf S_prod.smallEtaleTopology AddCommGrpCat.{u}),
        Subsingleton ↥(ℱ.obj.obj (Opposite.op Y)) := by
    intro Y hEmp ℱ
    let V_emp : PEmpty.{u + 1} → S_prod.Etale := fun i => i.elim
    let v_emp : ∀ i : PEmpty.{u + 1}, V_emp i ⟶ Y := fun i => i.elim
    have hCovEmp : CategoryTheory.Sieve.ofArrows V_emp v_emp ∈ S_prod.smallEtaleTopology Y :=
      hCoverMem S_prod Y PEmpty.{u + 1} V_emp v_emp (fun y => IsEmpty.elim hEmp y)
    have hSep := CategoryTheory.Sheaf.isSeparated ℱ
    refine ⟨fun s₁ s₂ => hSep Y _ hCovEmp s₁ s₂ (fun W g hg => ?_)⟩
    rcases hg with ⟨_, _, _, ⟨⟨⟩⟩, _⟩

  have hCov_Wj : CategoryTheory.Sieve.ofArrows W_j ι_over ∈ S_prod.smallEtaleTopology T := by
    let V_u : ULift.{u} (Fin n) → S_prod.Etale := fun j => W_j j.down
    let v_u : ∀ j : ULift.{u} (Fin n), V_u j ⟶ T := fun j => ι_over j.down
    have hCovU : CategoryTheory.Sieve.ofArrows V_u v_u ∈ S_prod.smallEtaleTopology T :=
      hCoverMem S_prod T (ULift.{u} (Fin n)) V_u v_u (fun p => by
        obtain ⟨j, q_j, hq⟩ := hJointSurj p
        exact ⟨ULift.up j, q_j, hq⟩)
    refine S_prod.smallEtaleTopology.superset_covering ?_ hCovU
    rintro Z g ⟨Z₀, hZ₀, _, ⟨j⟩, rfl⟩
    exact ⟨W_j j.down, hZ₀, ι_over j.down, CategoryTheory.Presieve.ofArrows.mk j.down, rfl⟩

  have hSheafProdBij : ∀ (ℱ : CategoryTheory.Sheaf S_prod.smallEtaleTopology AddCommGrpCat.{u}),
      Function.Bijective
        (fun x : ↥(ℱ.obj.obj (Opposite.op T)) =>
          fun j : Fin n => (ℱ.obj.map (ι_over j).op).hom x) := by
    intro ℱ
    let P_set := ℱ.obj.comp (CategoryTheory.coyoneda.obj (Opposite.op Aℤ))
    have hSheafFor : CategoryTheory.Presieve.IsSheafFor P_set
        (CategoryTheory.Presieve.ofArrows W_j ι_over) :=
      (ℱ.property Aℤ).isSheafFor (CategoryTheory.Presieve.ofArrows W_j ι_over) hCov_Wj
    rw [CategoryTheory.Presieve.isSheafFor_arrows_iff] at hSheafFor
    constructor
    · intro x₁ x₂ hx
      have h12 : zsmulHom _ x₁ = zsmulHom _ x₂ := by
        have hfam : ∀ j : Fin n,
            (CategoryTheory.ConcreteCategory.hom (P_set.map (ι_over j).op)) (zsmulHom _ x₁) =
              zsmulHom _ ((ℱ.obj.map (ι_over j).op).hom x₁) := by
          intro j
          apply hzsmul_ext
          change (ℱ.obj.map (ι_over j).op).hom ((zsmulHom _ x₁).hom (ULift.up (1 : ℤ))) = _
          rw [hzsmul_eval, hzsmul_eval]
        have hfam₂ : ∀ j : Fin n,
            (CategoryTheory.ConcreteCategory.hom (P_set.map (ι_over j).op)) (zsmulHom _ x₂) =
              zsmulHom _ ((ℱ.obj.map (ι_over j).op).hom x₁) := by
          intro j
          have hxj : (ℱ.obj.map (ι_over j).op).hom x₁ = (ℱ.obj.map (ι_over j).op).hom x₂ :=
            congrFun hx j
          rw [hxj]
          apply hzsmul_ext
          change (ℱ.obj.map (ι_over j).op).hom ((zsmulHom _ x₂).hom (ULift.up (1 : ℤ))) = _
          rw [hzsmul_eval, hzsmul_eval]
        have hCompat : CategoryTheory.Presieve.Arrows.Compatible P_set ι_over
            (fun j => zsmulHom _ ((ℱ.obj.map (ι_over j).op).hom x₁)) := by
          intro j₁ j₂ Y g₁ g₂ hcomm
          dsimp only
          rw [← hfam j₁, ← hfam j₂]
          change zsmulHom _ x₁ ≫ ℱ.obj.map (ι_over j₁).op ≫ ℱ.obj.map g₁.op =
            zsmulHom _ x₁ ≫ ℱ.obj.map (ι_over j₂).op ≫ ℱ.obj.map g₂.op
          rw [← ℱ.obj.map_comp, ← ℱ.obj.map_comp, ← hop_comp, ← hop_comp, hcomm]
        obtain ⟨_, _, huniq⟩ := hSheafFor _ hCompat
        exact (huniq _ hfam).trans (huniq _ hfam₂).symm
      have h12_ev := congrArg (fun φ : Aℤ ⟶ _ => φ.hom (ULift.up (1 : ℤ))) h12
      rwa [hzsmul_eval, hzsmul_eval] at h12_ev
    · intro s
      have hCompat : CategoryTheory.Presieve.Arrows.Compatible P_set ι_over
          (fun j => zsmulHom _ (s j)) := by
        intro j₁ j₂ Y g₁ g₂ hcomm
        by_cases hij : j₁ = j₂
        · subst hij
          have : CategoryTheory.Mono (ι_over j₁) := hMono_ι j₁
          have hg_eq : g₁ = g₂ := (CategoryTheory.cancel_mono (ι_over j₁)).mp hcomm
          subst hg_eq
          rfl
        · have : Subsingleton ↥(ℱ.obj.obj (Opposite.op Y)) :=
            hEmptySubsingleton Y (hOverlapEmpty hij Y g₁ g₂ hcomm) ℱ
          apply hzsmul_ext
          exact Subsingleton.elim _ _
      obtain ⟨t, ht, _⟩ := hSheafFor _ hCompat
      refine ⟨t.hom (ULift.up (1 : ℤ)), ?_⟩
      funext j
      have htj := congrArg (fun φ : Aℤ ⟶ _ => φ.hom (ULift.up (1 : ℤ))) (ht j)
      change (ℱ.obj.map (ι_over j).op).hom (t.hom (ULift.up (1 : ℤ))) =
        (zsmulHom _ (s j)).hom (ULift.up (1 : ℤ)) at htj
      rwa [hzsmul_eval] at htj

  have : CategoryTheory.Limits.HasFiniteBiproducts
      (CategoryTheory.Sheaf S_prod.smallEtaleTopology AddCommGrpCat.{u}) :=
    CategoryTheory.Abelian.hasFiniteBiproducts
  let L_rep : S_prod.Etale → CategoryTheory.Sheaf S_prod.smallEtaleTopology AddCommGrpCat.{u} :=
    weilPolyP1CohomologyRepSheaf S_prod
  let L_map : ∀ {U₁ U₂ : S_prod.Etale}, (U₁ ⟶ U₂) → (L_rep U₁ ⟶ L_rep U₂) :=
    fun u => (CategoryTheory.presheafToSheaf S_prod.smallEtaleTopology AddCommGrpCat.{u}).map
      (CategoryTheory.Functor.whiskerRight (CategoryTheory.yoneda.map u) AddCommGrpCat.free)
  let B_sum : CategoryTheory.Sheaf S_prod.smallEtaleTopology AddCommGrpCat.{u} :=
    ⨁ (fun j : Fin n => L_rep (W_j j))
  let sigma_ι : B_sum ⟶ L_rep T :=
    CategoryTheory.Limits.biproduct.desc (fun j : Fin n => L_map (ι_over j))

  have hRepNat : ∀ (ℱ : CategoryTheory.Sheaf S_prod.smallEtaleTopology AddCommGrpCat.{u})
      (j : Fin n) (f : L_rep T ⟶ ℱ),
      weilPolyP1CohomologyRepHomEquiv S_prod (W_j j) ℱ (L_map (ι_over j) ≫ f) =
        (ℱ.obj.map (ι_over j).op).hom (weilPolyP1CohomologyRepHomEquiv S_prod T ℱ f) := by
    intro ℱ j f
    let shAdj_prod := CategoryTheory.sheafificationAdjunction S_prod.smallEtaleTopology AddCommGrpCat.{u}
    let P_T := (CategoryTheory.yoneda.obj T).comp AddCommGrpCat.free
    let P_Wj := (CategoryTheory.yoneda.obj (W_j j)).comp AddCommGrpCat.free
    let α_j : P_Wj ⟶ P_T :=
      CategoryTheory.Functor.whiskerRight (CategoryTheory.yoneda.map (ι_over j)) AddCommGrpCat.free
    have hEval : ∀ (U : S_prod.Etale) (φ : L_rep U ⟶ ℱ),
        weilPolyP1CohomologyRepHomEquiv S_prod U ℱ φ =
          (φ.hom.app (Opposite.op U)).hom
            (((shAdj_prod.unit.app ((CategoryTheory.yoneda.obj U).comp AddCommGrpCat.free)).app
              (Opposite.op U)).hom (FreeAbelianGroup.of (𝟙 U))) := by
      intro U φ
      dsimp [weilPolyP1CohomologyRepHomEquiv, CategoryTheory.yonedaEquiv]
      rw [shAdj_prod.homEquiv_unit]
      rfl
    rw [hEval (W_j j) (L_map (ι_over j) ≫ f), hEval T f]
    have hunit_nat : ((L_map (ι_over j) ≫ f).hom.app (Opposite.op (W_j j))).hom
          (((shAdj_prod.unit.app P_Wj).app (Opposite.op (W_j j))).hom
            (FreeAbelianGroup.of (𝟙 (W_j j)))) =
        (f.hom.app (Opposite.op (W_j j))).hom
          (((shAdj_prod.unit.app P_T).app (Opposite.op (W_j j))).hom
            ((α_j.app (Opposite.op (W_j j))).hom (FreeAbelianGroup.of (𝟙 (W_j j))))) :=
      congrArg (fun φ : P_Wj.obj (Opposite.op (W_j j)) ⟶ (L_rep T).obj.obj (Opposite.op (W_j j)) =>
        (f.hom.app (Opposite.op (W_j j))).hom (φ.hom (FreeAbelianGroup.of (𝟙 (W_j j)))))
        (congrArg (fun τ : P_Wj ⟶ (L_rep T).obj => τ.app (Opposite.op (W_j j)))
          (shAdj_prod.unit.naturality α_j).symm)
    have hα_one : (α_j.app (Opposite.op (W_j j))).hom (FreeAbelianGroup.of (𝟙 (W_j j))) =
        (P_T.map (ι_over j).op).hom (FreeAbelianGroup.of (𝟙 T)) := by
      change (FreeAbelianGroup.map fun g => g ≫ ι_over j) (FreeAbelianGroup.of (𝟙 (W_j j))) =
        (FreeAbelianGroup.map fun g => ι_over j ≫ g) (FreeAbelianGroup.of (𝟙 T))
      rw [FreeAbelianGroup.map_of_apply, FreeAbelianGroup.map_of_apply,
        CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]
    have hnat := congrArg (fun φ : P_T.obj (Opposite.op T) ⟶ ℱ.obj.obj (Opposite.op (W_j j)) =>
        φ.hom (FreeAbelianGroup.of (𝟙 T)))
      ((shAdj_prod.unit.app P_T ≫ f.hom).naturality (ι_over j).op)
    exact hunit_nat.trans
      ((congrArg (fun x =>
          (f.hom.app (Opposite.op (W_j j))).hom
            (((shAdj_prod.unit.app P_T).app (Opposite.op (W_j j))).hom x)) hα_one).trans hnat)

  have hPrecompBij : ∀ (ℱ : CategoryTheory.Sheaf S_prod.smallEtaleTopology AddCommGrpCat.{u}),
      Function.Bijective (fun f : L_rep T ⟶ ℱ => sigma_ι ≫ f) := by
    intro ℱ
    let e_B : (B_sum ⟶ ℱ) ≃ (∀ j : Fin n, L_rep (W_j j) ⟶ ℱ) :=
      { toFun := fun g j => CategoryTheory.Limits.biproduct.ι (fun i => L_rep (W_j i)) j ≫ g
        invFun := CategoryTheory.Limits.biproduct.desc
        left_inv := fun g => by
          calc
            CategoryTheory.Limits.biproduct.desc
                (fun j => CategoryTheory.Limits.biproduct.ι (fun i => L_rep (W_j i)) j ≫ g)
              = 𝟙 B_sum ≫ CategoryTheory.Limits.biproduct.desc
                  (fun j => CategoryTheory.Limits.biproduct.ι (fun i => L_rep (W_j i)) j ≫ g) :=
                (CategoryTheory.Category.id_comp _).symm
            _ = (∑ j : Fin n, CategoryTheory.Limits.biproduct.π (fun i => L_rep (W_j i)) j ≫
                  CategoryTheory.Limits.biproduct.ι (fun i => L_rep (W_j i)) j) ≫
                CategoryTheory.Limits.biproduct.desc
                  (fun j => CategoryTheory.Limits.biproduct.ι (fun i => L_rep (W_j i)) j ≫ g) := by
                rw [← CategoryTheory.Limits.biproduct.total]
            _ = (∑ j : Fin n, CategoryTheory.Limits.biproduct.π (fun i => L_rep (W_j i)) j ≫
                  CategoryTheory.Limits.biproduct.ι (fun i => L_rep (W_j i)) j) ≫ g := by
                rw [CategoryTheory.Preadditive.sum_comp, CategoryTheory.Preadditive.sum_comp]
                refine Finset.sum_congr rfl fun j _ => ?_
                rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
                  CategoryTheory.Limits.biproduct.ι_desc]
            _ = 𝟙 B_sum ≫ g := by rw [CategoryTheory.Limits.biproduct.total]
            _ = g := CategoryTheory.Category.id_comp g
        right_inv := fun p => funext fun j => by
          dsimp only
          rw [CategoryTheory.Limits.biproduct.ι_desc] }
    let e_J : (∀ j : Fin n, L_rep (W_j j) ⟶ ℱ) ≃ ∀ j : Fin n, ↥(ℱ.obj.obj (Opposite.op (W_j j))) :=
      Equiv.piCongrRight (fun j => weilPolyP1CohomologyRepHomEquiv S_prod (W_j j) ℱ)
    let e_JB := e_B.trans e_J
    let e_T : (L_rep T ⟶ ℱ) ≃ ↥(ℱ.obj.obj (Opposite.op T)) :=
      weilPolyP1CohomologyRepHomEquiv S_prod T ℱ
    let res_ℱ : ↥(ℱ.obj.obj (Opposite.op T)) → ∀ j : Fin n, ↥(ℱ.obj.obj (Opposite.op (W_j j))) :=
      fun x j => (ℱ.obj.map (ι_over j).op).hom x
    have hEq : ∀ f : L_rep T ⟶ ℱ, e_JB (sigma_ι ≫ f) = res_ℱ (e_T f) := by
      intro f
      funext j
      change weilPolyP1CohomologyRepHomEquiv S_prod (W_j j) ℱ
        (CategoryTheory.Limits.biproduct.ι (fun i => L_rep (W_j i)) j ≫ (sigma_ι ≫ f)) = _
      rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.biproduct.ι_desc]
      exact hRepNat ℱ j f
    have hFunEq : (fun f : L_rep T ⟶ ℱ => sigma_ι ≫ f) = e_JB.symm ∘ res_ℱ ∘ e_T := by
      funext f
      exact e_JB.injective (by rw [Function.comp_apply, Function.comp_apply,
        Equiv.apply_symm_apply, hEq f])
    rw [hFunEq]
    exact e_JB.symm.bijective.comp ((hSheafProdBij ℱ).comp e_T.bijective)

  obtain ⟨sigma_inv, hsigma_left⟩ := (hPrecompBij B_sum).2 (𝟙 B_sum)
  have hsigma_left' : sigma_ι ≫ sigma_inv = 𝟙 B_sum := hsigma_left
  have hsigma_right : sigma_inv ≫ sigma_ι = 𝟙 (L_rep T) :=
    (hPrecompBij (L_rep T)).1 (by
      change sigma_ι ≫ (sigma_inv ≫ sigma_ι) = sigma_ι ≫ 𝟙 (L_rep T)
      rw [← CategoryTheory.Category.assoc, hsigma_left', CategoryTheory.Category.id_comp,
        CategoryTheory.Category.comp_id])

  have hIdDecomp : 𝟙 (L_rep T) =
      ∑ j : Fin n, (sigma_inv ≫ CategoryTheory.Limits.biproduct.π (fun i => L_rep (W_j i)) j) ≫
        L_map (ι_over j) := by
    calc
      𝟙 (L_rep T) = sigma_inv ≫ 𝟙 B_sum ≫ sigma_ι := by
        rw [CategoryTheory.Category.id_comp, hsigma_right]
      _ = sigma_inv ≫ (∑ j : Fin n, CategoryTheory.Limits.biproduct.π (fun i => L_rep (W_j i)) j ≫
            CategoryTheory.Limits.biproduct.ι (fun i => L_rep (W_j i)) j) ≫ sigma_ι := by
        rw [← CategoryTheory.Limits.biproduct.total]
      _ = ∑ j : Fin n, (sigma_inv ≫ CategoryTheory.Limits.biproduct.π (fun i => L_rep (W_j i)) j) ≫
            L_map (ι_over j) := by
        rw [CategoryTheory.Preadditive.sum_comp, CategoryTheory.Preadditive.comp_sum]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
          CategoryTheory.Limits.biproduct.ι_desc]

  obtain ⟨Θ, hΘ⟩ := hConj1 S_prod m q
  let z : ↥((G.cohomologyPresheaf q).obj (Opposite.op T)) := (Θ T).symm w
  have hz_j : ∀ j : Fin n, ((G.cohomologyPresheaf q).map (ι_over j).op).hom z = 0 := by
    intro j
    obtain ⟨p_j, hp_j, hw_j⟩ := hProj j
    have hp_j' : WeilIsTorsionEtalePullback
        ((AlgebraicGeometry.Scheme.Etale.forget S_prod).map (ι_over j)).left m q p_j :=
      Eq.ndrec (motive := fun f => WeilIsTorsionEtalePullback f m q p_j)
        hp_j (hι_over_left j).symm
    have hΘ_j := hΘ (ι_over j) p_j hp_j' z
    have hpz : p_j (Θ T z) = 0 :=
      (congrArg p_j (AddEquiv.apply_symm_apply (Θ T) w)).trans hw_j
    exact (Θ (W_j j)).injective ((hΘ_j.trans hpz).trans (map_zero _).symm)

  have hz_zero : z = 0 :=
    hExtEndSumZero (fun j => L_rep (W_j j))
      (fun j => sigma_inv ≫ CategoryTheory.Limits.biproduct.π (fun i => L_rep (W_j i)) j)
      (fun j => L_map (ι_over j)) z hIdDecomp hz_j

  have hw_eq : w = Θ T z := (AddEquiv.apply_symm_apply (Θ T) w).symm
  exact hw_eq.trans ((congrArg (Θ T) hz_zero).trans (map_zero (Θ T)))

theorem weil_alt_cd_etale_pullback_adjunction_and_H0 {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom S₁ S₂) :
    ∃ (_ : (weilAltCdSitePullback h).IsContinuous S₂.smallEtaleTopology S₁.smallEtaleTopology),
      let P_push := (weilAltCdSitePullback h).sheafPushforwardContinuous AddCommGrpCat.{u}
        S₂.smallEtaleTopology S₁.smallEtaleTopology
      ∃ (P_pull : CategoryTheory.Functor
            (CategoryTheory.Sheaf S₂.smallEtaleTopology AddCommGrpCat.{u})
            (CategoryTheory.Sheaf S₁.smallEtaleTopology AddCommGrpCat.{u}))
        (_ : P_pull ⊣ P_push)
        (_ : P_pull.Additive)
        (_ : P_push.Additive)
        (_ : CategoryTheory.Limits.PreservesFiniteLimits P_pull)
        (_ : CategoryTheory.Limits.PreservesFiniteColimits P_pull),
        (∀ (I : CategoryTheory.Sheaf S₁.smallEtaleTopology AddCommGrpCat.{u}),
          CategoryTheory.Injective I → CategoryTheory.Injective (P_push.obj I)) ∧
        ∃ (e₀ : ∀ (M : CategoryTheory.Sheaf S₁.smallEtaleTopology AddCommGrpCat.{u}),
            (P_push.obj M).H 0 ≃+ M.H 0),
          ∀ {M₁ M₂ : CategoryTheory.Sheaf S₁.smallEtaleTopology AddCommGrpCat.{u}}
            (φ : Quiver.Hom M₁ M₂) (z : (P_push.obj M₁).H 0),
            e₀ M₂ (z.comp (CategoryTheory.Abelian.Ext.mk₀ (P_push.map φ)) (Nat.add_zero 0)) =
              (e₀ M₁ z).comp (CategoryTheory.Abelian.Ext.mk₀ φ) (Nat.add_zero 0) :=
by
  let B := weilAltCdSitePullback h
  let J₁ := S₁.smallEtaleTopology
  let J₂ := S₂.smallEtaleTopology
  let Fgt₁ := AlgebraicGeometry.Scheme.Etale.forget S₁
  let Fgt₂ := AlgebraicGeometry.Scheme.Etale.forget S₂

  have : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
    ⟨fun _ _ hf hg => by have := hf; have := hg; infer_instance⟩

  
  have hLimOverPb : CategoryTheory.Limits.PreservesFiniteLimits (CategoryTheory.Over.pullback h) :=
    ((CategoryTheory.Over.mapPullbackAdj h).rightAdjoint_preservesLimits.{0, 0}).preservesFiniteLimits
  have hLimComp : CategoryTheory.Limits.PreservesFiniteLimits
      (Fgt₂.comp (CategoryTheory.Over.pullback h)) :=
    @CategoryTheory.Limits.comp_preservesFiniteLimits _ _ _ _ _ _ Fgt₂
      (CategoryTheory.Over.pullback h) inferInstance hLimOverPb
  have hEqComp : B.comp Fgt₁ = Fgt₂.comp (CategoryTheory.Over.pullback h) := rfl
  have hLimComp' : CategoryTheory.Limits.PreservesFiniteLimits (B.comp Fgt₁) := by
    rw [hEqComp]
    exact hLimComp
  have hLimB : CategoryTheory.Limits.PreservesFiniteLimits B :=
    @CategoryTheory.Limits.preservesFiniteLimits_of_reflects_of_preserves _ _ _ _ _ _
      B Fgt₁ hLimComp' inferInstance

  let T₂ : S₂.Etale := weilEtaleIdTerminal.{u} S₂
  let hT₂ : CategoryTheory.Limits.IsTerminal T₂ := weilEtaleIdTerminalIsTerminal.{u} S₂
  let hT₁ : CategoryTheory.Limits.IsTerminal (B.obj T₂) :=
    CategoryTheory.Limits.IsTerminal.isTerminalObj B T₂ hT₂
  have : CategoryTheory.Limits.HasTerminal S₂.Etale := hT₂.hasTerminal
  have : CategoryTheory.Limits.HasFiniteLimits S₂.Etale :=
    CategoryTheory.Limits.hasFiniteLimits_of_hasTerminal_and_pullbacks
  have : CategoryTheory.RepresentablyFlat B := CategoryTheory.flat_of_preservesFiniteLimits B

  have hCompat : CategoryTheory.CompatiblePreserving J₁ B :=
    CategoryTheory.compatiblePreservingOfFlat J₁ B
  have hCov : CategoryTheory.CoverPreserving J₂ J₁ B := by
    refine ⟨fun {U R} hR => ?_⟩
    have hJ₂ :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) S₂ le_rfl
    have hJ₁ :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) S₁ le_rfl
    change R ∈ AlgebraicGeometry.Scheme.smallGrothendieckTopology (@AlgebraicGeometry.Etale) S₂ U at hR
    rw [hJ₂] at hR
    change CategoryTheory.Sieve.functorPushforward B R ∈
      AlgebraicGeometry.Scheme.smallGrothendieckTopology (@AlgebraicGeometry.Etale) S₁ (B.obj U)
    rw [hJ₁]
    refine (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology (B.obj U) _).mpr (fun x => ?_)
    let u_hom : Quiver.Hom U.left S₂ := U.hom
    let pr₁ : Quiver.Hom (CategoryTheory.Limits.pullback u_hom h) U.left :=
      CategoryTheory.Limits.pullback.fst u_hom h
    let pr₂ : Quiver.Hom (CategoryTheory.Limits.pullback u_hom h) S₁ :=
      CategoryTheory.Limits.pullback.snd u_hom h
    obtain ⟨(Y : S₂.Etale), (f : Y ⟶ U), w, hfR, _, hfw⟩ :=
      (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology U R).mp hR (pr₁ x)
    let y_hom : Quiver.Hom Y.left S₂ := Y.hom
    let f_left : Quiver.Hom Y.left U.left := f.left
    have hfw' : f_left w = pr₁ x := hfw
    obtain ⟨z, _, hz₂⟩ := AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback w x hfw'
    have hψ_comm : CategoryTheory.Limits.pullback.fst f_left pr₁ ≫ y_hom =
        (CategoryTheory.Limits.pullback.snd f_left pr₁ ≫ pr₂) ≫ h := by
      have hYw : f_left ≫ u_hom = y_hom := CategoryTheory.MorphismProperty.Over.w f
      rw [← hYw, ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
        CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
        CategoryTheory.Category.assoc]
    let ψ : CategoryTheory.Limits.pullback f_left pr₁ ⟶ CategoryTheory.Limits.pullback y_hom h :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst f_left pr₁)
        (CategoryTheory.Limits.pullback.snd f_left pr₁ ≫ pr₂) hψ_comm
    let bf_left : CategoryTheory.Limits.pullback y_hom h ⟶
        CategoryTheory.Limits.pullback u_hom h := (B.map f).left
    have hψ_comp : ψ ≫ bf_left = CategoryTheory.Limits.pullback.snd f_left pr₁ := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · have hmap_fst : bf_left ≫ pr₁ =
            CategoryTheory.Limits.pullback.fst y_hom h ≫ f_left :=
          CategoryTheory.Limits.pullback.lift_fst _ _ _
        rw [CategoryTheory.Category.assoc, hmap_fst, ← CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Limits.pullback.condition]
      · have hmap_snd : bf_left ≫ pr₂ =
            CategoryTheory.Limits.pullback.snd y_hom h :=
          CategoryTheory.Limits.pullback.lift_snd _ _ _
        rw [CategoryTheory.Category.assoc, hmap_snd, CategoryTheory.Limits.pullback.lift_snd]
    have hEtBf : AlgebraicGeometry.Etale (B.map f).left :=
      CategoryTheory.MorphismProperty.of_postcomp
        (W := @AlgebraicGeometry.Etale) (W' := @AlgebraicGeometry.Etale)
        (f := (B.map f).left) (B.obj U).hom (B.obj U).prop
        (by rw [CategoryTheory.MorphismProperty.Over.w (B.map f)]; exact (B.obj Y).prop)
    have h_pt : bf_left (ψ z) = x := by
      rw [← AlgebraicGeometry.Scheme.Hom.comp_apply ψ bf_left z, hψ_comp]
      exact hz₂
    exact ⟨B.obj Y, B.map f, ψ z,
      CategoryTheory.Sieve.image_mem_functorPushforward B R hfR, hEtBf, h_pt⟩
  have hCont : B.IsContinuous J₂ J₁ :=
    CategoryTheory.Functor.isContinuous_of_coverPreserving hCompat hCov

  
  let M_aff : Type u := CategoryTheory.SmallModel S₂.AffineEtale
  let eq_aff := CategoryTheory.equivSmallModel S₂.AffineEtale
  let emb₀ : M_aff → S₂.Etale := fun m =>
    let X := eq_aff.inverse.obj m
    CategoryTheory.MorphismProperty.Over.mk ⊤ X.hom X.prop
  let StagePair : ℕ → Σ (α : Type u), α → S₂.Etale :=
    Nat.rec
      ⟨ULift.{u} Unit ⊕ M_aff, Sum.elim (fun _ => T₂) emb₀⟩
      (fun _ ih =>
        let α := ih.1
        let ev_n := ih.2
        let Cospan : Type u :=
          Σ (a : α) (b : α) (c : α) (_ : ev_n a ⟶ ev_n c) (_ : ev_n b ⟶ ev_n c), PUnit.{1}
        ⟨α ⊕ Cospan,
          Sum.elim ev_n (fun s => CategoryTheory.Limits.pullback s.2.2.2.1 s.2.2.2.2.1)⟩)
  let Stage : ℕ → Type u := fun n => (StagePair n).1
  let ev : ∀ n : ℕ, Stage n → S₂.Etale := fun n => (StagePair n).2
  let shiftStage : ∀ (n k : ℕ) (x : Stage n), { y : Stage (n + k) // ev (n + k) y = ev n x } :=
    fun n k =>
      Nat.rec
        (motive := fun k => ∀ x : Stage n, { y : Stage (n + k) // ev (n + k) y = ev n x })
        (fun x => ⟨x, rfl⟩)
        (fun _ ih x =>
          let ⟨y, hy⟩ := ih x
          ⟨Sum.inl y, hy⟩)
        k
  let RawD : Type u := Σ n : ℕ, Stage n
  let evalD : RawD → S₂.Etale := fun p => ev p.1 p.2
  let D : Type u := CategoryTheory.InducedCategory S₂.Etale evalD
  let G : CategoryTheory.Functor D S₂.Etale := CategoryTheory.inducedFunctor evalD

  let d_top : D := ⟨0, Sum.inl ⟨()⟩⟩
  have hTd : CategoryTheory.Limits.IsTerminal d_top :=
    CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun d => CategoryTheory.InducedCategory.homMk (hT₂.from (G.obj d)))
      (fun d m => G.map_injective (hT₂.hom_ext _ _))
  have : CategoryTheory.Limits.HasTerminal D := hTd.hasTerminal
  let isoGTop : G.obj (⊤_ D) ≅ ⊤_ S₂.Etale :=
    (G.mapIso (CategoryTheory.Limits.terminalIsTerminal.uniqueUpToIso hTd)).trans
      (hT₂.uniqueUpToIso CategoryTheory.Limits.terminalIsTerminal)
  have : CategoryTheory.Limits.PreservesLimit (CategoryTheory.Functor.empty D) G :=
    CategoryTheory.Limits.preservesTerminal_of_iso G isoGTop
  have : CategoryTheory.Limits.PreservesLimitsOfShape (CategoryTheory.Discrete PEmpty.{1}) G :=
    CategoryTheory.Limits.preservesLimitsOfShape_pempty_of_preservesTerminal G

  
  have hClosedPb : ∀ {d₁ d₂ d₃ : D} (p₁ : d₁ ⟶ d₃) (p₂ : d₂ ⟶ d₃),
      ∃ d_pb : D,
        Nonempty (G.obj d_pb ≅ CategoryTheory.Limits.pullback (G.map p₁) (G.map p₂)) := by
    intro d₁ d₂ d₃ p₁ p₂
    obtain ⟨N, k₁, k₂, k₃, hk₁, hk₂, hk₃⟩ :
        ∃ N k₁ k₂ k₃ : ℕ, d₁.1 + k₁ = N ∧ d₂.1 + k₂ = N ∧ d₃.1 + k₃ = N :=
      ⟨d₁.1 + d₂.1 + d₃.1, d₂.1 + d₃.1, d₁.1 + d₃.1, d₁.1 + d₂.1, by omega, by omega, by omega⟩
    have hLift₁ : { y : Stage N // ev N y = G.obj d₁ } := hk₁ ▸ shiftStage d₁.1 k₁ d₁.2
    have hLift₂ : { y : Stage N // ev N y = G.obj d₂ } := hk₂ ▸ shiftStage d₂.1 k₂ d₂.2
    have hLift₃ : { y : Stage N // ev N y = G.obj d₃ } := hk₃ ▸ shiftStage d₃.1 k₃ d₃.2
    let y₁ : Stage N := hLift₁.1
    let y₂ : Stage N := hLift₂.1
    let y₃ : Stage N := hLift₃.1
    let e₁ : ev N y₁ ≅ G.obj d₁ := CategoryTheory.eqToIso hLift₁.2
    let e₂ : ev N y₂ ≅ G.obj d₂ := CategoryTheory.eqToIso hLift₂.2
    let e₃ : ev N y₃ ≅ G.obj d₃ := CategoryTheory.eqToIso hLift₃.2
    let f₁ : ev N y₁ ⟶ ev N y₃ := e₁.hom ≫ G.map p₁ ≫ e₃.inv
    let f₂ : ev N y₂ ⟶ ev N y₃ := e₂.hom ≫ G.map p₂ ≫ e₃.inv
    let d_pb : D := ⟨N + 1, Sum.inr ⟨y₁, y₂, y₃, f₁, f₂, PUnit.unit⟩⟩
    have hd_pb : G.obj d_pb = CategoryTheory.Limits.pullback f₁ f₂ := rfl
    refine ⟨d_pb, ?_⟩
    rw [hd_pb]
    have hf₁ : e₁.hom ≫ G.map p₁ = f₁ ≫ e₃.hom := by
      dsimp [f₁]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, e₃.inv_hom_id,
        CategoryTheory.Category.comp_id]
    have hf₂ : e₂.hom ≫ G.map p₂ = f₂ ≫ e₃.hom := by
      dsimp [f₂]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, e₃.inv_hom_id,
        CategoryTheory.Category.comp_id]
    let φ_hom : CategoryTheory.Limits.pullback f₁ f₂ ⟶
        CategoryTheory.Limits.pullback (G.map p₁) (G.map p₂) :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst f₁ f₂ ≫ e₁.hom)
        (CategoryTheory.Limits.pullback.snd f₁ f₂ ≫ e₂.hom)
        (by
          rw [CategoryTheory.Category.assoc, hf₁, ← CategoryTheory.Category.assoc,
            CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc,
            CategoryTheory.Category.assoc (CategoryTheory.Limits.pullback.snd f₁ f₂), hf₂,
            CategoryTheory.Category.assoc])
    let φ_inv : CategoryTheory.Limits.pullback (G.map p₁) (G.map p₂) ⟶
        CategoryTheory.Limits.pullback f₁ f₂ :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst (G.map p₁) (G.map p₂) ≫ e₁.inv)
        (CategoryTheory.Limits.pullback.snd (G.map p₁) (G.map p₂) ≫ e₂.inv)
        (by
          dsimp [f₁, f₂]
          rw [CategoryTheory.Category.assoc, e₁.inv_hom_id_assoc,
            CategoryTheory.Category.assoc, e₂.inv_hom_id_assoc,
            ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
            CategoryTheory.Category.assoc])
    refine ⟨{ hom := φ_hom, inv := φ_inv, hom_inv_id := ?_, inv_hom_id := ?_ }⟩
    · apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          CategoryTheory.Category.assoc, e₁.hom_inv_id, CategoryTheory.Category.comp_id,
          CategoryTheory.Category.id_comp]
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          CategoryTheory.Category.assoc, e₂.hom_inv_id, CategoryTheory.Category.comp_id,
          CategoryTheory.Category.id_comp]
    · apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          CategoryTheory.Category.assoc, e₁.inv_hom_id, CategoryTheory.Category.comp_id,
          CategoryTheory.Category.id_comp]
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          CategoryTheory.Category.assoc, e₂.inv_hom_id, CategoryTheory.Category.comp_id,
          CategoryTheory.Category.id_comp]

  have hCospanD : ∀ {d₁ d₂ d₃ : D} (p₁ : d₁ ⟶ d₃) (p₂ : d₂ ⟶ d₃),
      ∃ (c_D : CategoryTheory.Limits.PullbackCone p₁ p₂)
        (_ : CategoryTheory.Limits.IsLimit c_D),
        Nonempty (CategoryTheory.Limits.IsLimit (G.mapCone c_D)) := by
    intro d₁ d₂ d₃ p₁ p₂
    obtain ⟨d_pb, ⟨e_pb⟩⟩ := hClosedPb p₁ p₂
    let g₁ := G.map p₁
    let g₂ := G.map p₂
    let π₁ : d_pb ⟶ d₁ :=
      CategoryTheory.InducedCategory.homMk (e_pb.hom ≫ CategoryTheory.Limits.pullback.fst g₁ g₂)
    let π₂ : d_pb ⟶ d₂ :=
      CategoryTheory.InducedCategory.homMk (e_pb.hom ≫ CategoryTheory.Limits.pullback.snd g₁ g₂)
    have hcommG : G.map π₁ ≫ g₁ = G.map π₂ ≫ g₂ := by
      change (e_pb.hom ≫ CategoryTheory.Limits.pullback.fst g₁ g₂) ≫ g₁ =
        (e_pb.hom ≫ CategoryTheory.Limits.pullback.snd g₁ g₂) ≫ g₂
      rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
        CategoryTheory.Category.assoc]
    have hcomm : π₁ ≫ p₁ = π₂ ≫ p₂ := G.map_injective (by rw [G.map_comp, G.map_comp]; exact hcommG)
    let c_D : CategoryTheory.Limits.PullbackCone p₁ p₂ :=
      CategoryTheory.Limits.PullbackCone.mk π₁ π₂ hcomm
    let hc_D : CategoryTheory.Limits.IsLimit c_D :=
      CategoryTheory.Limits.PullbackCone.IsLimit.mk hcomm
        (fun s => CategoryTheory.InducedCategory.homMk
          (CategoryTheory.Limits.pullback.lift (G.map s.fst) (G.map s.snd)
            (by rw [← G.map_comp, s.condition, G.map_comp]) ≫ e_pb.inv))
        (fun s => G.map_injective (by
          change (CategoryTheory.Limits.pullback.lift _ _ _ ≫ e_pb.inv) ≫
              (e_pb.hom ≫ CategoryTheory.Limits.pullback.fst g₁ g₂) = G.map s.fst
          rw [CategoryTheory.Category.assoc, e_pb.inv_hom_id_assoc,
            CategoryTheory.Limits.pullback.lift_fst]))
        (fun s => G.map_injective (by
          change (CategoryTheory.Limits.pullback.lift _ _ _ ≫ e_pb.inv) ≫
              (e_pb.hom ≫ CategoryTheory.Limits.pullback.snd g₁ g₂) = G.map s.snd
          rw [CategoryTheory.Category.assoc, e_pb.inv_hom_id_assoc,
            CategoryTheory.Limits.pullback.lift_snd]))
        (fun s m hm₁ hm₂ => G.map_injective (by
          rw [← CategoryTheory.cancel_mono e_pb.hom]
          change G.map m ≫ e_pb.hom =
            (CategoryTheory.Limits.pullback.lift (G.map s.fst) (G.map s.snd) _ ≫ e_pb.inv) ≫
              e_pb.hom
          rw [CategoryTheory.Category.assoc, e_pb.inv_hom_id, CategoryTheory.Category.comp_id]
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.assoc]
            exact congrArg G.map hm₁
          · rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.assoc]
            exact congrArg G.map hm₂))
    let hc_S₂ : CategoryTheory.Limits.IsLimit
        (CategoryTheory.Limits.PullbackCone.mk (G.map π₁) (G.map π₂) hcommG) :=
      CategoryTheory.Limits.PullbackCone.IsLimit.mk hcommG
        (fun s => CategoryTheory.Limits.pullback.lift s.fst s.snd s.condition ≫ e_pb.inv)
        (fun s => by
          change (CategoryTheory.Limits.pullback.lift _ _ _ ≫ e_pb.inv) ≫
              (e_pb.hom ≫ CategoryTheory.Limits.pullback.fst g₁ g₂) = s.fst
          rw [CategoryTheory.Category.assoc, e_pb.inv_hom_id_assoc,
            CategoryTheory.Limits.pullback.lift_fst])
        (fun s => by
          change (CategoryTheory.Limits.pullback.lift _ _ _ ≫ e_pb.inv) ≫
              (e_pb.hom ≫ CategoryTheory.Limits.pullback.snd g₁ g₂) = s.snd
          rw [CategoryTheory.Category.assoc, e_pb.inv_hom_id_assoc,
            CategoryTheory.Limits.pullback.lift_snd])
        (fun s m hm₁ hm₂ => by
          rw [← CategoryTheory.cancel_mono e_pb.hom, CategoryTheory.Category.assoc,
            e_pb.inv_hom_id, CategoryTheory.Category.comp_id]
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.assoc]
            exact hm₁
          · rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.assoc]
            exact hm₂)
    have hc_map : CategoryTheory.Limits.IsLimit (G.mapCone c_D) := by
      refine CategoryTheory.Limits.IsLimit.postcomposeHomEquiv
        (CategoryTheory.Limits.cospanCompIso G p₁ p₂) (G.mapCone c_D) ?_
      refine CategoryTheory.Limits.IsLimit.ofIsoLimit hc_S₂ ?_
      refine CategoryTheory.Limits.PullbackCone.ext (CategoryTheory.Iso.refl _) ?_ ?_
      · change G.map π₁ = CategoryTheory.CategoryStruct.id (G.obj d_pb) ≫
          (G.map π₁ ≫ CategoryTheory.CategoryStruct.id (G.obj d₁))
        rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
      · change G.map π₂ = CategoryTheory.CategoryStruct.id (G.obj d_pb) ≫
          (G.map π₂ ≫ CategoryTheory.CategoryStruct.id (G.obj d₂))
        rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
    exact ⟨c_D, hc_D, ⟨hc_map⟩⟩

  have hHasCospanD : ∀ {X Y Z : D} (f : X ⟶ Z) (g : Y ⟶ Z),
      CategoryTheory.Limits.HasLimit (CategoryTheory.Limits.cospan f g) := by
    intro X Y Z f g
    obtain ⟨c_D, hc_D, _⟩ := hCospanD f g
    exact ⟨⟨⟨c_D, hc_D⟩⟩⟩
  have : ∀ {X Y Z : D} {f : X ⟶ Z} {g : Y ⟶ Z},
      CategoryTheory.Limits.HasLimit (CategoryTheory.Limits.cospan f g) :=
    fun {X Y Z f g} => hHasCospanD f g
  have : CategoryTheory.Limits.HasPullbacks D :=
    CategoryTheory.Limits.hasPullbacks_of_hasLimit_cospan D
  have : CategoryTheory.Limits.HasFiniteLimits D :=
