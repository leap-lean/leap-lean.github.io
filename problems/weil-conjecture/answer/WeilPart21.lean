by
  let topObj : ∀ (F : Type u) [Field F],
      (AlgebraicGeometry.Spec (CommRingCat.of F)).AffineEtale :=
    fun F _ => AlgebraicGeometry.Scheme.AffineEtale.mk
      (CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of F)))
