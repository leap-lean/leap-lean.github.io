    obtain ⟨tr, _, hEtaTr, _⟩ :=
      weil_c1_affEt_gm_norm_trace_and_degree_annihilation hGm E₁ E₂ (hCont₂ E₁ E₂)
        (η_Gm E₁ E₂) (hEta E₁ E₂)
    have h0 : ξ.comp (CategoryTheory.Abelian.Ext.mk₀ (η_Gm E₁ E₂)) (Nat.add_zero q) = 0 :=
      hResZeroCompEta E₁ E₂ q ξ hξ
    have h1 := congrArg
      (fun w => w.comp (CategoryTheory.Abelian.Ext.mk₀ tr) (Nat.add_zero q)) h0
    simp only [CategoryTheory.Abelian.Ext.zero_comp] at h1
    rw [CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero q) (Nat.add_zero 0)
          (Nat.add_zero q),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hEtaTr] at h1
    have hnsmul : ∀ c : ℕ,
        ξ.comp (CategoryTheory.Abelian.Ext.mk₀
          (c • CategoryTheory.CategoryStruct.id (weilC1AffEtGmSheaf E₁ (hGm E₁))))
          (Nat.add_zero q) = c • ξ := by
      intro c
      induction c with
      | zero =>
        rw [zero_nsmul, zero_nsmul, CategoryTheory.Abelian.Ext.mk₀_zero,
          CategoryTheory.Abelian.Ext.comp_zero]
      | succ c ih =>
        rw [succ_nsmul, succ_nsmul, CategoryTheory.Abelian.Ext.mk₀_add,
          CategoryTheory.Abelian.Ext.comp_add, ih, CategoryTheory.Abelian.Ext.comp_mk₀_id]
    rwa [hnsmul] at h1
  · intro E _ q hq ξ
    obtain ⟨L, hFL, hAlgL, hFinL, hGalL, hMapZero⟩ :=
      weil_c1_affEt_local_galois_cohomology_effacement hCont₁ hAdd₁ hLim₁ hColim₁ E q hq
        (weilC1AffEtGmSheaf E (hGm E)) ξ
    letI : Field L := hFL
    letI : Algebra E L := hAlgL
    letI : FiniteDimensional E L := hFinL
    letI : IsGalois E L := hGalL
    letI : Algebra.IsSeparable E L := IsGalois.to_isSeparable
    exact ⟨L, hFL, hAlgL, hFinL, hGalL,
      hResOfPullZero E L (hAdd₁ E L) (hLim₁ E L) (hColim₁ E L) q ξ hMapZero⟩
  · intro E₁ E₂ _ _ _ _ _ p hp hdeg
    letI : Algebra.IsSeparable E₁ E₂ := IsGalois.to_isSeparable
    let Gm₁ := weilC1AffEtGmSheaf E₁ (hGm E₁)
    let Gm₂ := weilC1AffEtGmSheaf E₂ (hGm E₂)
