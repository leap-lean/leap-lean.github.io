theorem weil_alt_cd_sepClosed_in_tensor_isField_and_trdeg (F₀ K M L : Type u) [Field F₀] [Field K] [Field M] [Field L]
    [Algebra F₀ K] [Algebra K L] [Algebra F₀ L] [IsScalarTower F₀ K L]
    [Algebra F₀ M] [Algebra M L] [IsScalarTower F₀ M L]
    [Module.Finite K L] [Algebra.IsSeparable K L]
    (hSepCl : ∀ x : L, IsSeparable M x → x ∈ (algebraMap M L).range) :
    (∀ (E : Type u) [Field E] [Algebra M E] [Algebra.IsSeparable M E],
      IsField (TensorProduct M L E)) ∧
    (∀ (E : Type u) [Field E] [Algebra M E] [FiniteDimensional M E] [Algebra.IsSeparable M E]
      (hF : IsField (TensorProduct M L E)),
      letI : Field (TensorProduct M L E) := hF.toField
      letI : Algebra K (TensorProduct M L E) :=
        RingHom.toAlgebra
          ((Algebra.TensorProduct.includeLeft : L →ₐ[M] TensorProduct M L E).toRingHom.comp
            (algebraMap K L))
      Algebra.Etale K (TensorProduct M L E)) ∧
    (∀ (E₁ E₂ : Type u) [Field E₁] [Field E₂] [Algebra M E₁] [Algebra M E₂]
      [Algebra E₁ E₂] [IsScalarTower M E₁ E₂]
      [Algebra.IsSeparable M E₁] [Algebra.IsSeparable M E₂]
      (hF₁ : IsField (TensorProduct M L E₁)) (hF₂ : IsField (TensorProduct M L E₂)),
      letI : Field (TensorProduct M L E₁) := hF₁.toField
      letI : Field (TensorProduct M L E₂) := hF₂.toField
      letI : Algebra (TensorProduct M L E₁) (TensorProduct M L E₂) :=
        RingHom.toAlgebra
          (Algebra.TensorProduct.map (AlgHom.id M L) (IsScalarTower.toAlgHom M E₁ E₂)).toRingHom
      Algebra.IsSeparable (TensorProduct M L E₁) (TensorProduct M L E₂)) ∧
    (∀ (E : Type u) [Field E] [Algebra F₀ E] [Algebra M E] [IsScalarTower F₀ M E]
      [Algebra.IsSeparable M E] (e : ℕ) (hF : IsField (TensorProduct M L E)),
      (∃ (S : Finset L), S.card ≤ e ∧
        Algebra.IsAlgebraic ↥(Algebra.adjoin F₀ (S : Set L)) L) →
      letI : Field (TensorProduct M L E) := hF.toField
      letI : Algebra E (TensorProduct M L E) :=
        RingHom.toAlgebra
          (Algebra.TensorProduct.includeRight : E →ₐ[M] TensorProduct M L E).toRingHom
      Algebra.trdeg E (TensorProduct M L E) ≤ (e : Cardinal.{u})) :=
by
  have hPart1 : ∀ (M L : Type u) [Field M] [Field L] [Algebra M L],
      (∀ x : L, IsSeparable M x → x ∈ (algebraMap M L).range) →
      ∀ (f : Polynomial M), f.Monic → Irreducible f → f.Separable →
        Irreducible (f.map (algebraMap M L)) := by
    clear! F₀ K M L
    intro M L _ _ _ hSepCl f hf_monic hf_irr hf_sep
    let φ : M →+* L := algebraMap M L
    have hφ_inj : Function.Injective φ := RingHom.injective φ
    set f_L : Polynomial L := f.map φ
    have hfL_monic : f_L.Monic := hf_monic.map φ
    have hfL_not_unit : ¬ IsUnit f_L := by
      intro hu
      have hdeg0 : f_L.natDegree = 0 := Polynomial.natDegree_eq_zero_of_isUnit hu
      rw [hf_monic.natDegree_map φ] at hdeg0
      have hf1 : f = 1 := Polynomial.eq_one_of_monic_natDegree_zero hf_monic hdeg0
      exact hf_irr.not_isUnit (hf1 ▸ isUnit_one)
    have hMonicDescend : ∀ (q : Polynomial L), q.Monic → q ∣ f_L →
        ∃ q₀ : Polynomial M, q₀.map φ = q := by
      intro q hq_monic hq_dvd
      let Ω : Type u := AlgebraicClosure L
      let ι_Ω : L →+* Ω := algebraMap L Ω
      have hι_inj : Function.Injective ι_Ω := RingHom.injective ι_Ω
      let q_Ω : Polynomial Ω := q.map ι_Ω
      have hqΩ_monic : q_Ω.Monic := hq_monic.map ι_Ω
      obtain ⟨m, hm_eq⟩ := Polynomial.splits_iff_exists_multiset.mp (IsAlgClosed.splits q_Ω)
      rw [hqΩ_monic.leadingCoeff, map_one, one_mul] at hm_eq
      let S_sep := separableClosure M Ω
      have hr_mem : ∀ r ∈ m, r ∈ S_sep := by
        intro r hr
        have hlin_mem : Polynomial.X - Polynomial.C r ∈
            m.map (fun a : Ω => Polynomial.X - Polynomial.C a) :=
          Multiset.mem_map_of_mem _ hr
        have hdvd_qΩ : Polynomial.X - Polynomial.C r ∣ q_Ω :=
          hm_eq.symm ▸ Multiset.dvd_prod hlin_mem
        have hdvd_fΩ : q_Ω ∣ f.map (algebraMap M Ω) := by
          have h1 : q_Ω ∣ f_L.map ι_Ω := Polynomial.map_dvd ι_Ω hq_dvd
          rw [Polynomial.map_map, ← IsScalarTower.algebraMap_eq M L Ω] at h1
          exact h1
        have hroot : Polynomial.IsRoot (f.map (algebraMap M Ω)) r :=
          Polynomial.dvd_iff_isRoot.mp (dvd_trans hdvd_qΩ hdvd_fΩ)
        have haeval : (Polynomial.aeval r) f = 0 := by
          rw [Polynomial.aeval_def, ← Polynomial.eval_map]
          exact hroot
        have hmin_dvd : minpoly M r ∣ f := minpoly.dvd M r haeval
        exact mem_separableClosure_iff.mpr (hf_sep.of_dvd hmin_dvd)
      let j : ↥S_sep →+* Ω := S_sep.val.toRingHom
      have h_prod_lift : ∀ (m' : Multiset Ω), (∀ r ∈ m', r ∈ S_sep) →
          ∃ P : Polynomial ↥S_sep,
            P.map j = (m'.map (fun a : Ω => Polynomial.X - Polynomial.C a)).prod := by
        intro m'
        induction m' using Multiset.induction_on with
        | empty =>
          intro _
          exact ⟨1, by simp⟩
        | cons a s ih =>
          intro hall
          have ha : a ∈ S_sep := hall a (Multiset.mem_cons_self a s)
          obtain ⟨P', hP'⟩ := ih (fun x hx => hall x (Multiset.mem_cons_of_mem hx))
          refine ⟨(Polynomial.X - Polynomial.C (⟨a, ha⟩ : ↥S_sep)) * P', ?_⟩
          rw [Polynomial.map_mul, Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C,
            hP', Multiset.map_cons, Multiset.prod_cons]
          rfl
      obtain ⟨P_sep, hP_sep⟩ := h_prod_lift m hr_mem
      have hqΩ_P : q_Ω = P_sep.map j := hm_eq.trans hP_sep.symm
      have h_coeff : ∀ k : ℕ, ∃ c : M, φ c = q.coeff k := by
        intro k
        have hk_eq : ι_Ω (q.coeff k) = j (P_sep.coeff k) := by
          have h1 := congrArg (fun p : Polynomial Ω => p.coeff k) hqΩ_P
          simpa [q_Ω, Polynomial.coeff_map] using h1
        have hk_mem : ι_Ω (q.coeff k) ∈ S_sep := by
          rw [hk_eq]
          exact (P_sep.coeff k).2
        have hk_sep_Ω : IsSeparable M ((IsScalarTower.toAlgHom M L Ω) (q.coeff k)) :=
          mem_separableClosure_iff.mp hk_mem
        have hk_sep_L : IsSeparable M (q.coeff k) :=
          (isSeparable_map_iff (IsScalarTower.toAlgHom M L Ω) hι_inj).mp hk_sep_Ω
        exact hSepCl (q.coeff k) hk_sep_L
      let c : ℕ → M := fun k => Classical.choose (h_coeff k)
      have hc : ∀ k : ℕ, φ (c k) = q.coeff k := fun k => Classical.choose_spec (h_coeff k)
      let q₀ : Polynomial M := ∑ k ∈ q.support, Polynomial.monomial k (c k)
      refine ⟨q₀, ?_⟩
      ext n
      rw [Polynomial.coeff_map, Polynomial.finsetSum_coeff]
      simp only [Polynomial.coeff_monomial]
      by_cases hn : n ∈ q.support
      · simp [hn, hc n]
      · simp [hn, Polynomial.notMem_support_iff.mp hn]
    refine ⟨hfL_not_unit, ?_⟩
    intro g h hgh
    have hfL_ne : f_L ≠ 0 := hfL_monic.ne_zero
    have hg_ne : g ≠ 0 := fun hg0 => hfL_ne (by rw [hgh, hg0, zero_mul])
    let u : L := g.leadingCoeff
    have hu_ne : u ≠ 0 := Polynomial.leadingCoeff_ne_zero.mpr hg_ne
    let g₁ : Polynomial L := Polynomial.C u⁻¹ * g
    let h₁ : Polynomial L := Polynomial.C u * h
    have hg₁h₁ : f_L = g₁ * h₁ := by
      calc
        f_L = Polynomial.C (u⁻¹ * u) * (g * h) := by
          rw [inv_mul_cancel₀ hu_ne, map_one, one_mul, hgh]
        _ = g₁ * h₁ := by
          dsimp [g₁, h₁]
          rw [Polynomial.C_mul]
          ring
    have hg₁_monic : g₁.Monic := by
      change g₁.leadingCoeff = 1
      dsimp [g₁]
      rw [Polynomial.leadingCoeff_mul, Polynomial.leadingCoeff_C]
      exact inv_mul_cancel₀ hu_ne
    have hh₁_monic : h₁.Monic := by
      change h₁.leadingCoeff = 1
      have hlead : f_L.leadingCoeff = (g₁ * h₁).leadingCoeff := congrArg Polynomial.leadingCoeff hg₁h₁
      rw [hfL_monic.leadingCoeff, Polynomial.leadingCoeff_mul, hg₁_monic.leadingCoeff, one_mul] at hlead
      exact hlead.symm
    obtain ⟨g₀, hg₀⟩ := hMonicDescend g₁ hg₁_monic ⟨h₁, hg₁h₁⟩
    obtain ⟨h₀, hh₀⟩ := hMonicDescend h₁ hh₁_monic ⟨g₁, hg₁h₁.trans (mul_comm g₁ h₁)⟩
    have hf_eq : f = g₀ * h₀ := by
      apply Polynomial.map_injective φ hφ_inj
      rw [Polynomial.map_mul, hg₀, hh₀, ← hg₁h₁]
    have hg_eq : g = Polynomial.C u * g₁ := by
      dsimp [g₁]
      rw [← mul_assoc, ← Polynomial.C_mul, mul_inv_cancel₀ hu_ne, map_one, one_mul]
    have hh_eq : h = Polynomial.C u⁻¹ * h₁ := by
      dsimp [h₁]
      rw [← mul_assoc, ← Polynomial.C_mul, inv_mul_cancel₀ hu_ne, map_one, one_mul]
    have hu_unit : IsUnit (Polynomial.C u) := (IsUnit.mk0 u hu_ne).map Polynomial.C
    have hu_inv_unit : IsUnit (Polynomial.C u⁻¹) :=
      (IsUnit.mk0 u⁻¹ (inv_ne_zero hu_ne)).map Polynomial.C
    rcases hf_irr.isUnit_or_isUnit hf_eq with hg₀_u | hh₀_u
    · left
      have hg₁_u : IsUnit g₁ := by
        rw [← hg₀]
        exact hg₀_u.map (Polynomial.mapRingHom φ)
      rw [hg_eq]
      exact hu_unit.mul hg₁_u
    · right
      have hh₁_u : IsUnit h₁ := by
        rw [← hh₀]
        exact hh₀_u.map (Polynomial.mapRingHom φ)
      rw [hh_eq]
      exact hu_inv_unit.mul hh₁_u

  have hPart2 : ∀ (M L E : Type u) [Field M] [Field L] [Field E] [Algebra M L] [Algebra M E]
      [Algebra.IsSeparable M E],
      (∀ (f : Polynomial M), f.Monic → Irreducible f → f.Separable →
        Irreducible (f.map (algebraMap M L))) →
      IsField (TensorProduct M L E) := by
    clear! F₀ K M L hPart1
    intro M L E _ _ _ _ _ _ hMapIrr
    have hPBIsField : ∀ (E₀ : Type u) [Field E₀] [Algebra M E₀]
        (pb : PowerBasis M E₀) (f_L : Polynomial L),
        f_L = (minpoly M pb.gen).map (algebraMap M L) →
        Irreducible f_L →
        IsField (TensorProduct M L E₀) := by
      intro E₀ _ _ pb f_L hf_L hfL_irr
      have : Fact (Irreducible f_L) := ⟨hfL_irr⟩
      have h_root : (Polynomial.aeval (AdjoinRoot.root f_L)) (minpoly M pb.gen) = 0 := by
        rw [Polynomial.aeval_def, IsScalarTower.algebraMap_eq M L (AdjoinRoot f_L),
          ← Polynomial.eval₂_map, ← hf_L]
        exact AdjoinRoot.eval₂_root f_L
      let ψ_E : E₀ →ₐ[M] AdjoinRoot f_L := pb.lift (AdjoinRoot.root f_L) h_root
      let Φ : TensorProduct M L E₀ →ₐ[M] AdjoinRoot f_L :=
        Algebra.TensorProduct.lift (IsScalarTower.toAlgHom M L (AdjoinRoot f_L)) ψ_E
          (fun _ _ => Commute.all _ _)
      let ι_L0 : L →ₐ[M] TensorProduct M L E₀ := Algebra.TensorProduct.includeLeft
      let ι_E0 : E₀ →ₐ[M] TensorProduct M L E₀ := Algebra.TensorProduct.includeRight
      let w₀ : TensorProduct M L E₀ := ι_E0 pb.gen
      have h_comp_M : ι_L0.toRingHom.comp (algebraMap M L) = ι_E0.toRingHom.comp (algebraMap M E₀) :=
        RingHom.ext fun m => (ι_L0.commutes m).trans (ι_E0.commutes m).symm
      have h_eval_w0 : Polynomial.eval₂ ι_L0.toRingHom w₀ f_L = 0 := by
        calc
          Polynomial.eval₂ ι_L0.toRingHom w₀ f_L
            = Polynomial.eval₂ ι_L0.toRingHom w₀ ((minpoly M pb.gen).map (algebraMap M L)) := by
              rw [hf_L]
          _ = Polynomial.eval₂ (ι_L0.toRingHom.comp (algebraMap M L)) w₀ (minpoly M pb.gen) :=
              Polynomial.eval₂_map (algebraMap M L) ι_L0.toRingHom w₀
          _ = Polynomial.eval₂ (ι_E0.toRingHom.comp (algebraMap M E₀)) (ι_E0 pb.gen)
                (minpoly M pb.gen) := by rw [h_comp_M]
          _ = ι_E0 (Polynomial.eval₂ (algebraMap M E₀) pb.gen (minpoly M pb.gen)) :=
              (Polynomial.hom_eval₂ (minpoly M pb.gen) (algebraMap M E₀) ι_E0.toRingHom pb.gen).symm
          _ = ι_E0 ((Polynomial.aeval pb.gen) (minpoly M pb.gen)) := rfl
          _ = ι_E0 0 := by rw [minpoly.aeval M pb.gen]
          _ = 0 := map_zero ι_E0
      let Ψ : AdjoinRoot f_L →ₐ[M] TensorProduct M L E₀ :=
        AdjoinRoot.liftAlgHom f_L ι_L0 w₀ h_eval_w0
      have hΦ_ιL : ∀ y : L, Φ (ι_L0 y) = AdjoinRoot.of f_L y := by
        intro y
        change Φ (y ⊗ₜ[M] 1) = AdjoinRoot.of f_L y
        dsimp only [Φ]
        rw [Algebra.TensorProduct.lift_tmul, map_one, mul_one]
        rfl
      have hΦ_w0 : Φ w₀ = AdjoinRoot.root f_L := by
        change Φ (1 ⊗ₜ[M] pb.gen) = AdjoinRoot.root f_L
        dsimp only [Φ]
        rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
        exact pb.lift_gen (AdjoinRoot.root f_L) h_root
      have hΨ_of : ∀ y : L, Ψ (AdjoinRoot.of f_L y) = ι_L0 y :=
        fun y => AdjoinRoot.liftAlgHom_of f_L ι_L0 w₀ h_eval_w0 y
      have hΨ_root : Ψ (AdjoinRoot.root f_L) = w₀ :=
        AdjoinRoot.liftAlgHom_root f_L ι_L0 w₀ h_eval_w0
      have h_ΨΦ : Ψ.comp Φ = AlgHom.id M (TensorProduct M L E₀) := by
        apply Algebra.TensorProduct.ext
        · ext y
        
          change Ψ (Φ (ι_L0 y)) = ι_L0 y
          rw [hΦ_ιL y, hΨ_of y]
        · apply pb.algHom_ext
          change Ψ (Φ w₀) = w₀
          rw [hΦ_w0, hΨ_root]
      have h_ΦΨ : Φ.comp Ψ = AlgHom.id M (AdjoinRoot f_L) := by
        let compL : AdjoinRoot f_L →ₐ[L] AdjoinRoot f_L :=
          { (Φ.comp Ψ).toRingHom with
            commutes' := fun y => by
              change Φ (Ψ (AdjoinRoot.of f_L y)) = AdjoinRoot.of f_L y
              rw [hΨ_of y, hΦ_ιL y] }
        have hcompL : compL = AlgHom.id L (AdjoinRoot f_L) := by
          apply AdjoinRoot.algHom_ext
          change Φ (Ψ (AdjoinRoot.root f_L)) = AdjoinRoot.root f_L
          rw [hΨ_root, hΦ_w0]
        exact AlgHom.ext (fun x => AlgHom.congr_fun hcompL x)
      let e₀ : TensorProduct M L E₀ ≃ₐ[M] AdjoinRoot f_L :=
        AlgEquiv.ofAlgHom Φ Ψ h_ΦΨ h_ΨΦ
      exact MulEquiv.isField (Field.toIsField (AdjoinRoot f_L)) e₀.toRingEquiv.toMulEquiv

    have hFinIsField : ∀ (E₀ : Type u) [Field E₀] [Algebra M E₀]
        [FiniteDimensional M E₀] [Algebra.IsSeparable M E₀],
        IsField (TensorProduct M L E₀) := by
      intro E₀ _ _ _ _
      obtain ⟨γ, hγ⟩ := Field.exists_primitive_element M E₀
      have hInt_γ : IsIntegral M γ := Algebra.IsIntegral.isIntegral γ
      let pb : PowerBasis M E₀ :=
        (IntermediateField.adjoin.powerBasis hInt_γ).map
          ((IntermediateField.equivOfEq hγ).trans IntermediateField.topEquiv)
      have hInt_gen : IsIntegral M pb.gen := Algebra.IsIntegral.isIntegral pb.gen
      have hfL_irr : Irreducible ((minpoly M pb.gen).map (algebraMap M L)) :=
        hMapIrr (minpoly M pb.gen) (minpoly.monic hInt_gen) (minpoly.irreducible hInt_gen)
          (Algebra.IsSeparable.isSeparable M pb.gen)
      exact hPBIsField E₀ pb ((minpoly M pb.gen).map (algebraMap M L)) rfl hfL_irr

    let T : Type u := TensorProduct M L E
    have hInjSub : ∀ (E₀ : IntermediateField M E),
        Function.Injective (Algebra.TensorProduct.map (AlgHom.id M L) E₀.val) := by
      intro E₀
      have hFlatInj : Function.Injective (LinearMap.lTensor L E₀.val.toLinearMap) :=
        Module.Flat.lTensor_preserves_injective_linearMap E₀.val.toLinearMap Subtype.val_injective
      have hEq : ∀ x : TensorProduct M L ↥E₀,
          Algebra.TensorProduct.map (AlgHom.id M L) E₀.val x =
            LinearMap.lTensor L E₀.val.toLinearMap x := by
        intro x
        induction x using TensorProduct.induction_on with
        | zero => simp
        | tmul y c =>
          rw [Algebra.TensorProduct.map_tmul, LinearMap.lTensor_tmul]
          rfl
        | add u v ihu ihv => rw [map_add, map_add, ihu, ihv]
      intro x₁ x₂ hx
      apply hFlatInj
      rw [← hEq x₁, ← hEq x₂, hx]
    have h01 : (0 : T) ≠ 1 := by
      let E_bot : IntermediateField M E := ⊥
      have : Algebra.IsSeparable M ↥E_bot :=
        Algebra.isSeparable_tower_bot_of_isSeparable M ↥E_bot E
      have hF_bot : IsField (TensorProduct M L ↥E_bot) := hFinIsField ↥E_bot
      obtain ⟨x, y, hxy⟩ := hF_bot.exists_pair_ne
      have : Nontrivial (TensorProduct M L ↥E_bot) := ⟨⟨x, y, hxy⟩⟩
      have h01_bot : (0 : TensorProduct M L ↥E_bot) ≠ 1 := zero_ne_one
      intro h_eq
      apply h01_bot
      apply hInjSub E_bot
      rw [map_zero, map_one, h_eq]
    let _ : DecidableEq E := Classical.decEq E
    have hExhaust : ∀ z : T, ∃ (S : Finset E)
        (z₀ : TensorProduct M L ↥(IntermediateField.adjoin M (S : Set E))),
        Algebra.TensorProduct.map (AlgHom.id M L)
          (IntermediateField.adjoin M (S : Set E)).val z₀ = z := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero =>
        exact ⟨∅, 0, map_zero _⟩
      | tmul y c =>
        have hc_mem : c ∈ IntermediateField.adjoin M (({c} : Finset E) : Set E) :=
          IntermediateField.subset_adjoin M (({c} : Finset E) : Set E)
            (Finset.mem_coe.mpr (Finset.mem_singleton_self c))
        refine ⟨{c}, y ⊗ₜ[M] ⟨c, hc_mem⟩, ?_⟩
        rw [Algebra.TensorProduct.map_tmul, AlgHom.id_apply]
        rfl
      | add w₁ w₂ ih₁ ih₂ =>
        obtain ⟨S₁, u₁, hu₁⟩ := ih₁
        obtain ⟨S₂, u₂, hu₂⟩ := ih₂
        let S : Finset E := S₁ ∪ S₂
        have hle₁ : IntermediateField.adjoin M (S₁ : Set E) ≤
            IntermediateField.adjoin M (S : Set E) :=
          IntermediateField.adjoin_le_iff.mpr
            (Set.Subset.trans (Finset.coe_subset.mpr Finset.subset_union_left)
              (IntermediateField.subset_adjoin M (S : Set E)))
        have hle₂ : IntermediateField.adjoin M (S₂ : Set E) ≤
            IntermediateField.adjoin M (S : Set E) :=
          IntermediateField.adjoin_le_iff.mpr
            (Set.Subset.trans (Finset.coe_subset.mpr Finset.subset_union_right)
              (IntermediateField.subset_adjoin M (S : Set E)))
        let j₁ := Algebra.TensorProduct.map (AlgHom.id M L) (IntermediateField.inclusion hle₁)
        let j₂ := Algebra.TensorProduct.map (AlgHom.id M L) (IntermediateField.inclusion hle₂)
        let ι_S := Algebra.TensorProduct.map (AlgHom.id M L)
          (IntermediateField.adjoin M (S : Set E)).val
        have hcomp₁ : ∀ x : TensorProduct M L ↥(IntermediateField.adjoin M (S₁ : Set E)),
            ι_S (j₁ x) = Algebra.TensorProduct.map (AlgHom.id M L)
              (IntermediateField.adjoin M (S₁ : Set E)).val x := by
          intro x
          induction x using TensorProduct.induction_on with
          | zero => simp
          | tmul y c =>
            dsimp only [ι_S, j₁]
            rw [Algebra.TensorProduct.map_tmul, Algebra.TensorProduct.map_tmul,
              Algebra.TensorProduct.map_tmul]
            rfl
          | add a b iha ihb => rw [map_add, map_add, map_add, iha, ihb]
        have hcomp₂ : ∀ x : TensorProduct M L ↥(IntermediateField.adjoin M (S₂ : Set E)),
            ι_S (j₂ x) = Algebra.TensorProduct.map (AlgHom.id M L)
              (IntermediateField.adjoin M (S₂ : Set E)).val x := by
          intro x
          induction x using TensorProduct.induction_on with
          | zero => simp
          | tmul y c =>
            dsimp only [ι_S, j₂]
            rw [Algebra.TensorProduct.map_tmul, Algebra.TensorProduct.map_tmul,
              Algebra.TensorProduct.map_tmul]
            rfl
          | add a b iha ihb => rw [map_add, map_add, map_add, iha, ihb]
        refine ⟨S, j₁ u₁ + j₂ u₂, ?_⟩
        rw [map_add, hcomp₁ u₁, hcomp₂ u₂, hu₁, hu₂]
    refine
      { exists_pair_ne := ⟨0, 1, h01⟩
        mul_comm := mul_comm
        mul_inv_cancel := ?_ }
    intro z hz
    obtain ⟨S, z₀, hz₀⟩ := hExhaust z
    let E₀ : IntermediateField M E := IntermediateField.adjoin M (S : Set E)
    let ι₀ := Algebra.TensorProduct.map (AlgHom.id M L) E₀.val
    have hz₀_ne : z₀ ≠ 0 := fun h0 => hz (by rw [← hz₀, h0, map_zero])
    have : FiniteDimensional M ↥E₀ :=
      IntermediateField.finiteDimensional_adjoin (fun x _ => Algebra.IsIntegral.isIntegral x)
    have : Algebra.IsSeparable M ↥E₀ :=
      Algebra.isSeparable_tower_bot_of_isSeparable M ↥E₀ E
    have hF₀ : IsField (TensorProduct M L ↥E₀) := hFinIsField ↥E₀
    obtain ⟨w₀, hw₀⟩ := hF₀.mul_inv_cancel hz₀_ne
    refine ⟨ι₀ w₀, ?_⟩
    calc
      z * ι₀ w₀ = ι₀ z₀ * ι₀ w₀ := by rw [hz₀]
      _ = ι₀ (z₀ * w₀) := (map_mul ι₀ z₀ w₀).symm
      _ = ι₀ 1 := by rw [hw₀]
      _ = 1 := map_one ι₀

  have hPart3 : ∀ (K M L : Type u) [Field K] [Field M] [Field L]
      [Algebra K L] [Algebra M L] [Module.Finite K L] [Algebra.IsSeparable K L],
      (∀ (E : Type u) [Field E] [Algebra M E] [FiniteDimensional M E] [Algebra.IsSeparable M E]
        (hF : IsField (TensorProduct M L E)),
        letI : Field (TensorProduct M L E) := hF.toField
        letI : Algebra K (TensorProduct M L E) :=
          RingHom.toAlgebra
            ((Algebra.TensorProduct.includeLeft : L →ₐ[M] TensorProduct M L E).toRingHom.comp
              (algebraMap K L))
        Algebra.Etale K (TensorProduct M L E)) ∧
      (∀ (E₁ E₂ : Type u) [Field E₁] [Field E₂] [Algebra M E₁] [Algebra M E₂]
        [Algebra E₁ E₂] [IsScalarTower M E₁ E₂]
        [Algebra.IsSeparable M E₁] [Algebra.IsSeparable M E₂]
        (hF₁ : IsField (TensorProduct M L E₁)) (hF₂ : IsField (TensorProduct M L E₂)),
        letI : Field (TensorProduct M L E₁) := hF₁.toField
        letI : Field (TensorProduct M L E₂) := hF₂.toField
        letI : Algebra (TensorProduct M L E₁) (TensorProduct M L E₂) :=
          RingHom.toAlgebra
            (Algebra.TensorProduct.map (AlgHom.id M L) (IsScalarTower.toAlgHom M E₁ E₂)).toRingHom
        Algebra.IsSeparable (TensorProduct M L E₁) (TensorProduct M L E₂)) := by
    clear! F₀ K M L hPart1 hPart2
    intro K M L _ _ _ _ _ _ _
    refine ⟨?_, ?_⟩
    · intro E _ _ _ _ hF
      letI : Field (TensorProduct M L E) := hF.toField
      let ι_L : L →+* TensorProduct M L E :=
        (Algebra.TensorProduct.includeLeft : L →ₐ[M] TensorProduct M L E).toRingHom
      letI : Algebra K (TensorProduct M L E) := RingHom.toAlgebra (ι_L.comp (algebraMap K L))
      let F' : Type u := ↥(⊤ : Subfield (TensorProduct M L E))
      let e_top : F' ≃+* TensorProduct M L E :=
        { toFun := Subtype.val
          invFun := fun z => ⟨z, by simp⟩
          left_inv := fun _ => rfl
          right_inv := fun _ => rfl
          map_mul' := fun _ _ => rfl
          map_add' := fun _ _ => rfl }
      let ι_L' : L →+* F' := e_top.symm.toRingHom.comp ι_L
      let ι_E' : E →+* F' :=
        e_top.symm.toRingHom.comp
          (Algebra.TensorProduct.includeRight : E →ₐ[M] TensorProduct M L E).toRingHom
      letI : Algebra L F' := RingHom.toAlgebra ι_L'
      letI : Algebra K F' := RingHom.toAlgebra (ι_L'.comp (algebraMap K L))
      have : IsScalarTower K L F' := IsScalarTower.of_algebraMap_eq' rfl
      have hM_comm : (algebraMap L F').comp (algebraMap M L) = ι_E'.comp (algebraMap M E) := by
        ext m
        exact ((Algebra.TensorProduct.includeLeft : L →ₐ[M] TensorProduct M L E).commutes m).trans
          ((Algebra.TensorProduct.includeRight : E →ₐ[M] TensorProduct M L E).commutes m).symm
      let S_L : IntermediateField L F' := separableClosure L F'
      have hE'_sep : ∀ c : E, ι_E' c ∈ S_L := by
        intro c
        let p : Polynomial M := minpoly M c
        have hp_sep : p.Separable := Algebra.IsSeparable.isSeparable M c
        have hp_map_sep : (p.map (algebraMap M L)).Separable :=
          (Polynomial.separable_map (algebraMap M L)).mpr hp_sep
        have haeval : (Polynomial.aeval (ι_E' c)) (p.map (algebraMap M L)) = 0 := by
          calc
            (Polynomial.aeval (ι_E' c)) (p.map (algebraMap M L))
              = Polynomial.eval₂ ((algebraMap L F').comp (algebraMap M L)) (ι_E' c) p :=
                Polynomial.eval₂_map (algebraMap M L) (algebraMap L F') (ι_E' c)
            _ = Polynomial.eval₂ (ι_E'.comp (algebraMap M E)) (ι_E' c) p := by rw [hM_comm]
            _ = ι_E' (Polynomial.eval₂ (algebraMap M E) c p) :=
                (Polynomial.hom_eval₂ p (algebraMap M E) ι_E' c).symm
            _ = ι_E' ((Polynomial.aeval c) p) := rfl
            _ = ι_E' 0 := by rw [minpoly.aeval M c]
            _ = 0 := map_zero ι_E'
        have hdvd : minpoly L (ι_E' c) ∣ p.map (algebraMap M L) :=
          minpoly.dvd L (ι_E' c) haeval
        exact mem_separableClosure_iff.mpr (hp_map_sep.of_dvd hdvd)
      have hSymm_sep : ∀ z : TensorProduct M L E, e_top.symm z ∈ S_L := by
        intro z
        induction z using TensorProduct.induction_on with
        | zero =>
          rw [map_zero]
          exact S_L.zero_mem
        | tmul y c =>
          have hmul : (y ⊗ₜ[M] (1 : E)) * ((1 : L) ⊗ₜ[M] c) = y ⊗ₜ[M] c := by
            rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
          rw [← hmul, map_mul]
          exact S_L.mul_mem (S_L.algebraMap_mem y) (hE'_sep c)
        | add u v ihu ihv =>
          rw [map_add]
          exact S_L.add_mem ihu ihv
      have : Algebra.IsSeparable L F' :=
        ⟨fun x => mem_separableClosure_iff.mp (by
          have hx : e_top.symm (e_top x) = x := e_top.symm_apply_apply x
          rw [← hx]
          exact hSymm_sep (e_top x))⟩
      have : Algebra.IsSeparable K F' := Algebra.IsSeparable.trans K L F'
      let ι_idx := Module.Basis.ofVectorSpaceIndex M E
      let b := Module.Basis.ofVectorSpace M E
      letI : Fintype ι_idx := Fintype.ofFinite ι_idx
      let φ_span : (ι_idx → L) →ₗ[L] F' :=
        { toFun := fun f => ∑ i : ι_idx, algebraMap L F' (f i) * ι_E' (b i)
          map_add' := fun f g => by
            simp only [Pi.add_apply, map_add, add_mul, Finset.sum_add_distrib]
          map_smul' := fun c f => by
            simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply, Algebra.smul_def,
              Finset.mul_sum, map_mul, mul_assoc] }
      have h_surj_z : ∀ z : TensorProduct M L E, ∃ f : ι_idx → L, e_top (φ_span f) = z := by
        intro z
        induction z using TensorProduct.induction_on with
        | zero =>
          refine ⟨0, ?_⟩
          change e_top (∑ i : ι_idx, algebraMap L F' 0 * ι_E' (b i)) = 0
          simp
        | tmul y e =>
          refine ⟨fun i => (b.repr e i) • y, ?_⟩
          change e_top (∑ i : ι_idx, algebraMap L F' ((b.repr e i) • y) * ι_E' (b i)) = y ⊗ₜ[M] e
          rw [map_sum]
          have hsum_e : y ⊗ₜ[M] e = ∑ i : ι_idx, y ⊗ₜ[M] ((b.repr e i) • (b i)) := by
            conv_lhs => rw [← b.sum_repr e]
            rw [TensorProduct.tmul_sum]
          rw [hsum_e]
          refine Finset.sum_congr rfl (fun i _ => ?_)
          rw [map_mul]
          change (((b.repr e i) • y) ⊗ₜ[M] (1 : E)) * ((1 : L) ⊗ₜ[M] (b i)) =
            y ⊗ₜ[M] ((b.repr e i) • (b i))
          rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul, TensorProduct.smul_tmul]
        | add z₁ z₂ ih₁ ih₂ =>
          obtain ⟨f₁, hf₁⟩ := ih₁
          obtain ⟨f₂, hf₂⟩ := ih₂
          exact ⟨f₁ + f₂, by rw [map_add, map_add, hf₁, hf₂]⟩
      have h_surj : Function.Surjective φ_span := by
        intro x
        obtain ⟨f, hf⟩ := h_surj_z (e_top x)
        exact ⟨f, e_top.injective hf⟩
      have : Module.Finite L F' := Module.Finite.of_surjective φ_span h_surj
      have : Module.Finite K F' := Module.Finite.trans L F'
      have : Module.FinitePresentation K F' :=
        (Module.finitePresentation_iff_finite K F').mpr inferInstance
      have : Algebra.FinitePresentation K F' :=
        (Module.FinitePresentation.iff_finitePresentation_of_finite K F').mp inferInstance
      have : Algebra.FormallyEtale K F' := Algebra.FormallyEtale.of_isSeparable K F'
      have : Algebra.Etale K F' := Algebra.Etale.mk
      let e_K : F' ≃ₐ[K] TensorProduct M L E :=
        { e_top with
          commutes' := fun _ => rfl }
      exact Algebra.Etale.of_equiv e_K
    · intro E₁ E₂ _ _ _ _ _ _ _ _ hF₁ hF₂
      letI : Field (TensorProduct M L E₁) := hF₁.toField
      letI : Field (TensorProduct M L E₂) := hF₂.toField
      letI : Algebra (TensorProduct M L E₁) (TensorProduct M L E₂) :=
        RingHom.toAlgebra
          (Algebra.TensorProduct.map (AlgHom.id M L) (IsScalarTower.toAlgHom M E₁ E₂)).toRingHom
      let F₁ : Type u := TensorProduct M L E₁
      let F₂ : Type u := TensorProduct M L E₂
      let S_sep : IntermediateField F₁ F₂ := separableClosure F₁ F₂
      let j_M : M →+* F₁ :=
        (Algebra.TensorProduct.includeRight : E₁ →ₐ[M] F₁).toRingHom.comp (algebraMap M E₁)
      let ι_E₂ : E₂ →+* F₂ :=
        (Algebra.TensorProduct.includeRight : E₂ →ₐ[M] F₂).toRingHom
      have hj_comm : (algebraMap F₁ F₂).comp j_M = ι_E₂.comp (algebraMap M E₂) := by
        ext m
        change Algebra.TensorProduct.map (AlgHom.id M L) (IsScalarTower.toAlgHom M E₁ E₂)
          ((1 : L) ⊗ₜ[M] algebraMap M E₁ m) = (1 : L) ⊗ₜ[M] algebraMap M E₂ m
        rw [Algebra.TensorProduct.map_tmul, AlgHom.id_apply, IsScalarTower.toAlgHom_apply,
          IsScalarTower.algebraMap_apply M E₁ E₂ m]
      have hL_mem : ∀ y : L, y ⊗ₜ[M] (1 : E₂) ∈ S_sep := by
        intro y
        have hy : algebraMap F₁ F₂ (y ⊗ₜ[M] (1 : E₁)) = y ⊗ₜ[M] (1 : E₂) := by
          change Algebra.TensorProduct.map (AlgHom.id M L) (IsScalarTower.toAlgHom M E₁ E₂)
            (y ⊗ₜ[M] (1 : E₁)) = y ⊗ₜ[M] (1 : E₂)
          rw [Algebra.TensorProduct.map_tmul, AlgHom.id_apply, map_one]
        rw [← hy]
        exact S_sep.algebraMap_mem (y ⊗ₜ[M] (1 : E₁))
      have hE₂_mem : ∀ c : E₂, (1 : L) ⊗ₜ[M] c ∈ S_sep := by
        intro c
        let p : Polynomial M := minpoly M c
        have hp_sep : p.Separable := Algebra.IsSeparable.isSeparable M c
        have hp_map_sep : (p.map j_M).Separable := (Polynomial.separable_map j_M).mpr hp_sep
        have haeval : (Polynomial.aeval ((1 : L) ⊗ₜ[M] c)) (p.map j_M) = 0 := by
          calc
            (Polynomial.aeval ((1 : L) ⊗ₜ[M] c)) (p.map j_M)
              = Polynomial.eval₂ ((algebraMap F₁ F₂).comp j_M) (ι_E₂ c) p :=
                Polynomial.eval₂_map j_M (algebraMap F₁ F₂) (ι_E₂ c)
            _ = Polynomial.eval₂ (ι_E₂.comp (algebraMap M E₂)) (ι_E₂ c) p := by rw [hj_comm]
            _ = ι_E₂ (Polynomial.eval₂ (algebraMap M E₂) c p) :=
                (Polynomial.hom_eval₂ p (algebraMap M E₂) ι_E₂ c).symm
            _ = ι_E₂ ((Polynomial.aeval c) p) := rfl
            _ = ι_E₂ 0 := by rw [minpoly.aeval M c]
            _ = 0 := map_zero ι_E₂
        have hdvd : minpoly F₁ ((1 : L) ⊗ₜ[M] c) ∣ p.map j_M :=
          minpoly.dvd F₁ ((1 : L) ⊗ₜ[M] c) haeval
        exact mem_separableClosure_iff.mpr (hp_map_sep.of_dvd hdvd)
      have hAll : ∀ z : F₂, z ∈ S_sep := by
        intro z
        induction z using TensorProduct.induction_on with
        | zero => exact S_sep.zero_mem
        | tmul y c =>
          have hmul : (y ⊗ₜ[M] (1 : E₂)) * ((1 : L) ⊗ₜ[M] c) = y ⊗ₜ[M] c := by
            rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
          rw [← hmul]
          exact S_sep.mul_mem (hL_mem y) (hE₂_mem c)
        | add u v ihu ihv => exact S_sep.add_mem ihu ihv
      exact ⟨fun z => mem_separableClosure_iff.mp (hAll z)⟩

  have hPart4 : ∀ (F₀ M L E : Type u) [Field F₀] [Field M] [Field L] [Field E]
      [Algebra F₀ M] [Algebra M L] [Algebra F₀ L] [IsScalarTower F₀ M L]
      [Algebra F₀ E] [Algebra M E] [IsScalarTower F₀ M E]
      (e : ℕ) (hF : IsField (TensorProduct M L E)),
      (∃ (S : Finset L), S.card ≤ e ∧
        Algebra.IsAlgebraic ↥(Algebra.adjoin F₀ (S : Set L)) L) →
      letI : Field (TensorProduct M L E) := hF.toField
      letI : Algebra E (TensorProduct M L E) :=
        RingHom.toAlgebra
          (Algebra.TensorProduct.includeRight : E →ₐ[M] TensorProduct M L E).toRingHom
      Algebra.trdeg E (TensorProduct M L E) ≤ (e : Cardinal.{u}) := by
    clear! F₀ K M L hPart1 hPart2 hPart3
    intro F₀ M L E _ _ _ _ _ _ _ _ _ _ _ e hF ⟨S, hScard, hAlgL⟩
    let F_E : Type u := TensorProduct M L E
    let ι_L : L →+* F_E := (Algebra.TensorProduct.includeLeft : L →ₐ[M] F_E).toRingHom
    obtain ⟨z₁, z₂, hz₁₂⟩ := hF.exists_pair_ne
    have h10_FE : (1 : F_E) ≠ 0 := by
      have : Nontrivial F_E := ⟨⟨z₁, z₂, hz₁₂⟩⟩
      exact one_ne_zero
    have hι_inj : Function.Injective ι_L := by
      intro x y hxy
      by_contra hne
      apply h10_FE
      calc
        (1 : F_E) = ι_L 1 := (map_one ι_L).symm
        _ = ι_L ((x - y) * (x - y)⁻¹) := by rw [mul_inv_cancel₀ (sub_ne_zero.mpr hne)]
        _ = (ι_L x - ι_L y) * ι_L (x - y)⁻¹ := by rw [map_mul, map_sub]
        _ = 0 := by rw [hxy, sub_self, zero_mul]
    letI : Field (TensorProduct M L E) := hF.toField
    letI : Algebra E (TensorProduct M L E) :=
      RingHom.toAlgebra
        (Algebra.TensorProduct.includeRight : E →ₐ[M] TensorProduct M L E).toRingHom
    let S' : Set F_E := ι_L '' (S : Set L)
    let R₀ : Subalgebra F₀ L := Algebra.adjoin F₀ (S : Set L)
    let R' : Subalgebra E F_E := Algebra.adjoin E S'
    have hF₀_mem : ∀ a : F₀, ι_L (algebraMap F₀ L a) ∈ R' := by
      intro a
      have heq : ι_L (algebraMap F₀ L a) = algebraMap E F_E (algebraMap F₀ E a) := by
        rw [IsScalarTower.algebraMap_apply F₀ M L a, IsScalarTower.algebraMap_apply F₀ M E a]
        exact ((Algebra.TensorProduct.includeLeft : L →ₐ[M] F_E).commutes (algebraMap F₀ M a)).trans
          ((Algebra.TensorProduct.includeRight : E →ₐ[M] F_E).commutes (algebraMap F₀ M a)).symm
      rw [heq]
      exact R'.algebraMap_mem (algebraMap F₀ E a)
    let A_pre : Subalgebra F₀ L :=
      { R'.toSubring.comap ι_L with
        algebraMap_mem' := hF₀_mem }
    have hR₀_le : R₀ ≤ A_pre := by
      apply Algebra.adjoin_le
      intro s hs
      exact Algebra.subset_adjoin ⟨s, hs, rfl⟩
    let ψ : ↥R₀ →+* ↥R' :=
      { toFun := fun x => ⟨ι_L x.1, hR₀_le x.2⟩
        map_one' := Subtype.ext (map_one ι_L)
        map_mul' := fun x y => Subtype.ext (map_mul ι_L x.1 y.1)
        map_zero' := Subtype.ext (map_zero ι_L)
        map_add' := fun x y => Subtype.ext (map_add ι_L x.1 y.1) }
    have hψ_inj : Function.Injective ψ :=
      fun x y h => Subtype.ext (hι_inj (congrArg Subtype.val h))
    have hAlg_L : ∀ y : L, IsAlgebraic ↥R' (y ⊗ₜ[M] (1 : E)) := by
      intro y
      obtain ⟨p, hp_ne, hp_aeval⟩ := Algebra.IsAlgebraic.isAlgebraic (R := ↥R₀) y
      let q : Polynomial ↥R' := p.map ψ
      have hq_ne : q ≠ 0 := fun h0 =>
        hp_ne (Polynomial.map_injective ψ hψ_inj (h0.trans (Polynomial.map_zero ψ).symm))
      have hcomm_ψ : (algebraMap ↥R' F_E).comp ψ = ι_L.comp (algebraMap ↥R₀ L) :=
        RingHom.ext (fun _ => rfl)
      have hq_aeval : (Polynomial.aeval (ι_L y)) q = 0 := by
        calc
          (Polynomial.aeval (ι_L y)) q
            = Polynomial.eval₂ ((algebraMap ↥R' F_E).comp ψ) (ι_L y) p :=
              Polynomial.eval₂_map ψ (algebraMap ↥R' F_E) (ι_L y)
          _ = Polynomial.eval₂ (ι_L.comp (algebraMap ↥R₀ L)) (ι_L y) p := by rw [hcomm_ψ]
          _ = ι_L (Polynomial.eval₂ (algebraMap ↥R₀ L) y p) :=
              (Polynomial.hom_eval₂ p (algebraMap ↥R₀ L) ι_L y).symm
          _ = ι_L ((Polynomial.aeval y) p) := rfl
          _ = ι_L 0 := by rw [hp_aeval]
          _ = 0 := map_zero ι_L
      exact ⟨q, hq_ne, hq_aeval⟩
    have hAlg_E : ∀ c : E, IsAlgebraic ↥R' ((1 : L) ⊗ₜ[M] c) := by
      intro c
      exact isAlgebraic_algebraMap (⟨(1 : L) ⊗ₜ[M] c, R'.algebraMap_mem c⟩ : ↥R')
    have hAlg_all : ∀ z : F_E, IsAlgebraic ↥R' z := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => exact isAlgebraic_zero
      | tmul y c =>
        have hmul : (y ⊗ₜ[M] (1 : E)) * ((1 : L) ⊗ₜ[M] c) = y ⊗ₜ[M] c := by
          rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
        rw [← hmul]
        exact (hAlg_L y).mul (hAlg_E c)
      | add u v ihu ihv => exact ihu.add ihv
    have : Algebra.IsAlgebraic ↥R' F_E := ⟨hAlg_all⟩
    calc
      Algebra.trdeg E F_E ≤ Cardinal.mk ↥S' :=
        Algebra.IsAlgebraic.trdeg_le_cardinalMk E S'
      _ ≤ Cardinal.mk ↥(S : Set L) := Cardinal.mk_image_le
      _ = (S.card : Cardinal.{u}) := Cardinal.mk_coe_finset
      _ ≤ (e : Cardinal.{u}) := Nat.cast_le.mpr hScard

  have hIrr := hPart1 M L hSepCl
  exact ⟨fun E _ _ _ => hPart2 M L E hIrr, (hPart3 K M L).1, (hPart3 K M L).2,
    fun E _ _ _ _ _ e hF hAlg => hPart4 F₀ M L E e hF hAlg⟩

theorem weil_alt_cd_vandermonde_sep_split_and_coord_descent : (∀ (F₀ K κ_sep : Type u) [Field F₀] [Field K] [Field κ_sep] [IsSepClosed κ_sep]
      [Algebra F₀ K] [Algebra F₀ κ_sep]
      (r : ℕ) (L M : Fin r → Type u)
      [∀ i, Field (L i)] [∀ i, Algebra K (L i)] [∀ i, Algebra F₀ (L i)]
      [∀ i, IsScalarTower F₀ K (L i)]
      [∀ i, Field (M i)] [∀ i, Algebra F₀ (M i)] [∀ i, Algebra (M i) (L i)]
      [∀ i, IsScalarTower F₀ (M i) (L i)]
      [∀ i, FiniteDimensional F₀ (M i)] [∀ i, Algebra.IsSeparable F₀ (M i)],
      ∃ (E_init : IntermediateField F₀ κ_sep),
        FiniteDimensional F₀ ↥E_init ∧
        ∃ (N : ℕ) (idx : Fin N → Fin r) (σ : ∀ a : Fin N, M (idx a) →ₐ[F₀] ↥E_init),
          ∀ (E : IntermediateField F₀ κ_sep) (hle : E_init ≤ E),
            letI : ∀ a : Fin N, Algebra (M (idx a)) ↥E := fun a =>
              RingHom.toAlgebra (((IntermediateField.inclusion hle).comp (σ a)).toRingHom)
            letI : ∀ a : Fin N, Algebra K (TensorProduct (M (idx a)) (L (idx a)) ↥E) := fun a =>
              RingHom.toAlgebra
                ((Algebra.TensorProduct.includeLeft :
                    L (idx a) →ₐ[M (idx a)] TensorProduct (M (idx a)) (L (idx a)) ↥E).toRingHom.comp
                  (algebraMap K (L (idx a))))
            ∃ (e_E : TensorProduct F₀ (∀ i : Fin r, L i) ↥E ≃ₐ[K]
                (∀ a : Fin N, TensorProduct (M (idx a)) (L (idx a)) ↥E)),
              ∀ (f : ∀ i : Fin r, L i) (c : ↥E) (a : Fin N),
                e_E (f ⊗ₜ[F₀] c) a = (f (idx a)) ⊗ₜ[M (idx a)] c) ∧
    (∀ (N : ℕ) (R A : Fin N → Type u) (B : Type u)
      [∀ a, CommSemiring (R a)] [∀ a, CommSemiring (A a)] [CommSemiring B]
      [∀ a, Algebra (R a) (A a)] [∀ a, Algebra (R a) B]
      (G : ∀ a : Fin N, Finset (TensorProduct (R a) (A a) B)),
      ∃ (S_B : Finset B),
        ∀ (a : Fin N) (w : TensorProduct (R a) (A a) B), w ∈ G a →
          ∃ (m : ℕ) (y : Fin m → A a) (c : Fin m → B),
            (∀ k : Fin m, c k ∈ S_B) ∧
            w = ∑ k : Fin m, (y k) ⊗ₜ[R a] (c k)) :=
by
  refine ⟨?_, ?_⟩
  · intro F₀ K κ_sep _ _ _ _ _ _ r L M _ _ _ _ _ _ _ _ _ _
    letI : DecidableEq κ_sep := Classical.decEq κ_sep
    let pb : ∀ i : Fin r, PowerBasis F₀ (M i) := fun i =>
      Field.powerBasisOfFiniteOfSeparable F₀ (M i)
    let d : Fin r → ℕ := fun i => (pb i).dim
    let P : Fin r → Polynomial F₀ := fun i => minpoly F₀ (pb i).gen
    have hMonic : ∀ i : Fin r, (P i).Monic := fun i =>
      minpoly.monic (Algebra.IsIntegral.isIntegral (pb i).gen)
    have hSep : ∀ i : Fin r, (P i).Separable := fun i =>
      Algebra.IsSeparable.isSeparable F₀ (pb i).gen
    have hDeg : ∀ i : Fin r, (P i).natDegree = d i := fun i =>
      (pb i).natDegree_minpoly
    let P_κ : Fin r → Polynomial κ_sep := fun i => (P i).map (algebraMap F₀ κ_sep)
    have hMonic_κ : ∀ i : Fin r, (P_κ i).Monic := fun i =>
      (hMonic i).map (algebraMap F₀ κ_sep)
    have hNeZero_κ : ∀ i : Fin r, P_κ i ≠ 0 := fun i =>
      (hMonic_κ i).ne_zero
    have hDeg_κ : ∀ i : Fin r, (P_κ i).natDegree = d i := fun i =>
      ((hMonic i).natDegree_map (algebraMap F₀ κ_sep)).trans (hDeg i)
    have hSep_κ : ∀ i : Fin r, (P_κ i).Separable := fun i => (hSep i).map
    have hSplits_κ : ∀ i : Fin r, (P_κ i).Splits := fun i =>
      IsSepClosed.splits_of_separable (P_κ i) (hSep_κ i)
    let S_i : Fin r → Finset κ_sep := fun i => (P_κ i).roots.toFinset
    have hCardSi : ∀ i : Fin r, (S_i i).card = d i := fun i =>
      (Multiset.toFinset_card_of_nodup (Polynomial.nodup_roots (hSep_κ i))).trans
        (((Polynomial.Splits.natDegree_eq_card_roots (hSplits_κ i)).symm).trans (hDeg_κ i))
    have hAeval_κ : ∀ (i : Fin r) (x : κ_sep), x ∈ S_i i → Polynomial.aeval x (P i) = 0 := by
      intro i x hx
      have hroot : Polynomial.IsRoot (P_κ i) x :=
        (Polynomial.mem_roots (hNeZero_κ i)).mp (Multiset.mem_toFinset.mp hx)
      rw [Polynomial.aeval_def, Polynomial.eval₂_eq_eval_map]
      exact hroot
    let S_all : Finset κ_sep := Finset.univ.biUnion S_i
    let E_init : IntermediateField F₀ κ_sep := IntermediateField.adjoin F₀ (S_all : Set κ_sep)
    have hFD_init : FiniteDimensional F₀ ↥E_init := by
      haveI : Finite ↥(S_all : Set κ_sep) := S_all.finite_toSet
      refine IntermediateField.finiteDimensional_adjoin (fun x hx => ?_)
      rcases Finset.mem_biUnion.mp hx with ⟨i, _, hxi⟩
      exact ⟨P i, hMonic i, hAeval_κ i x hxi⟩
    let e_Si : ∀ i : Fin r, Fin (d i) ≃ ↥(S_i i) := fun i =>
      (Finset.equivFinOfCardEq (hCardSi i)).symm
    let ρ_init : ∀ i : Fin r, Fin (d i) → ↥E_init := fun i j =>
      ⟨(e_Si i j).1, IntermediateField.subset_adjoin F₀ (S_all : Set κ_sep)
        (Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ i, (e_Si i j).2⟩)⟩
    have hρ_inj : ∀ i : Fin r, Function.Injective (ρ_init i) := by
      intro i j₁ j₂ h
      apply (e_Si i).injective
      apply Subtype.ext
      exact congrArg (Subtype.val : ↥E_init → κ_sep) h
    have hRoot_init : ∀ (i : Fin r) (j : Fin (d i)), Polynomial.aeval (ρ_init i j) (P i) = 0 := by
      intro i j
      apply Subtype.ext
      change E_init.val (Polynomial.aeval (ρ_init i j) (P i)) = 0
      rw [← Polynomial.aeval_algHom_apply E_init.val (ρ_init i j) (P i)]
      exact hAeval_κ i (e_Si i j).1 (e_Si i j).2
    let τ_init : ∀ (i : Fin r), Fin (d i) → (M i →ₐ[F₀] ↥E_init) := fun i j =>
      (pb i).lift (ρ_init i j) (hRoot_init i j)
    let IdxSigma : Type := Σ i : Fin r, Fin (d i)
    let N : ℕ := Fintype.card IdxSigma
    let eqN : IdxSigma ≃ Fin N := Fintype.equivFin IdxSigma
    let idx : Fin N → Fin r := fun a => (eqN.symm a).1
    let σ : ∀ a : Fin N, M (idx a) →ₐ[F₀] ↥E_init := fun a =>
      τ_init (eqN.symm a).1 (eqN.symm a).2
    refine ⟨E_init, hFD_init, N, idx, σ, ?_⟩
    intro E hle
    let τ_E : ∀ (i : Fin r), Fin (d i) → (M i →ₐ[F₀] ↥E) := fun i j =>
      (IntermediateField.inclusion hle).comp (τ_init i j)
    let v_E : ∀ (i : Fin r), Fin (d i) → ↥E := fun i j =>
      IntermediateField.inclusion hle (ρ_init i j)
    have hv_inj : ∀ i : Fin r, Function.Injective (v_E i) := by
      intro i j₁ j₂ h
      apply hρ_inj i
      apply Subtype.ext
      exact congrArg (Subtype.val : ↥E → κ_sep) h
    have hτ_gen : ∀ (i : Fin r) (j : Fin (d i)), τ_E i j (pb i).gen = v_E i j := by
      intro i j
      change IntermediateField.inclusion hle (τ_init i j (pb i).gen) = v_E i j
      rw [(pb i).lift_gen]
    let algM_sub : ∀ (i : Fin r) (j : Fin (d i)),
        Algebra (M i) ({ x : Fin (d i) // x = j } → ↥E) := fun i j =>
      (Pi.ringHom fun _ : { x : Fin (d i) // x = j } => (τ_E i j).toRingHom).toAlgebra
    let T_sub : ∀ (i : Fin r) (j : Fin (d i)), Type u := fun i j =>
      letI : Algebra (M i) ({ x : Fin (d i) // x = j } → ↥E) := algM_sub i j
      TensorProduct (M i) (L i) ({ x : Fin (d i) // x = j } → ↥E)
    letI instCR_Tsub : ∀ (i : Fin r) (j : Fin (d i)), CommRing (T_sub i j) := fun i j => by
      dsimp [T_sub]
      letI : Algebra (M i) ({ x : Fin (d i) // x = j } → ↥E) := algM_sub i j
      infer_instance
    have hFactor : ∀ i : Fin r,
        ∃ (r_i : TensorProduct F₀ ↥E (L i) ≃+* (∀ j : Fin (d i), T_sub i j)),
          ∀ (c : ↥E) (y : L i) (j : Fin (d i)),
            r_i (c ⊗ₜ[F₀] y) j =
              (letI : Algebra (M i) ({ x : Fin (d i) // x = j } → ↥E) := algM_sub i j
               y ⊗ₜ[M i] (fun _ => c)) := by
      intro i
      letI : ∀ j : Fin (d i), Algebra (M i) ({ x : Fin (d i) // x = j } → ↥E) := algM_sub i
      let ψ_E : TensorProduct F₀ ↥E (M i) →ₐ[↥E] (Fin (d i) → ↥E) :=
        Algebra.TensorProduct.lift
          (Algebra.ofId ↥E (Fin (d i) → ↥E))
          (Pi.algHom F₀ (fun _ : Fin (d i) => ↥E) (τ_E i))
          (fun _ _ => Commute.all _ _)
      let b_dom : Module.Basis (Fin (d i)) ↥E (TensorProduct F₀ ↥E (M i)) :=
        (pb i).basis.baseChange ↥E
      let b_cod : Module.Basis (Fin (d i)) ↥E (Fin (d i) → ↥E) :=
        Pi.basisFun ↥E (Fin (d i))
      have hMat : LinearMap.toMatrix b_dom b_cod ψ_E.toLinearMap = Matrix.vandermonde (v_E i) := by
        apply Matrix.ext
        intro j k
        rw [LinearMap.toMatrix_apply, Pi.basisFun_repr, Module.Basis.baseChange_apply,
          PowerBasis.basis_eq_pow]
        change ψ_E ((1 : ↥E) ⊗ₜ[F₀] ((pb i).gen ^ (k : ℕ))) j = Matrix.vandermonde (v_E i) j k
        rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul,
          Pi.algHom_apply, map_pow, hτ_gen, Matrix.vandermonde_apply]
      have hDet_ne : (LinearMap.toMatrix b_dom b_cod ψ_E.toLinearMap).det ≠ 0 := by
        rw [hMat]
        exact Matrix.det_vandermonde_ne_zero_iff.mpr (hv_inj i)
      have hBij_ψ : Function.Bijective ψ_E := by
        let e_lin := LinearEquiv.ofIsUnitDet (Ne.isUnit hDet_ne)
        have he_lin : (⇑e_lin : TensorProduct F₀ ↥E (M i) → (Fin (d i) → ↥E)) = ⇑ψ_E := by
          funext z
          exact LinearEquiv.ofIsUnitDet_apply _ z
        rw [← he_lin]
        exact e_lin.bijective
      let e_pi_sub : (Fin (d i) → ↥E) ≃+* (∀ j : Fin (d i), ({ x : Fin (d i) // x = j } → ↥E)) :=
        { toFun := fun u j _ => u j
          invFun := fun g j => g j ⟨j, rfl⟩
          left_inv := fun _ => rfl
          right_inv := fun g => funext fun j => funext fun x =>
            congrArg (g j) (Subtype.ext x.2.symm)
          map_mul' := fun _ _ => rfl
          map_add' := fun _ _ => rfl }
      let θ_ring : TensorProduct F₀ (M i) ↥E →+*
          (∀ j : Fin (d i), ({ x : Fin (d i) // x = j } → ↥E)) :=
        e_pi_sub.toRingHom.comp
          (ψ_E.toRingHom.comp (Algebra.TensorProduct.comm F₀ (M i) ↥E).toRingEquiv.toRingHom)
      let θ_Mi : TensorProduct F₀ (M i) ↥E →ₐ[M i]
          (∀ j : Fin (d i), ({ x : Fin (d i) // x = j } → ↥E)) :=
        { θ_ring with
          commutes' := fun m => by
            funext j x
            change ψ_E ((1 : ↥E) ⊗ₜ[F₀] m) j = τ_E i j m
            rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul, Pi.algHom_apply] }
      have hBij_θ : Function.Bijective θ_Mi :=
        e_pi_sub.bijective.comp (hBij_ψ.comp (Algebra.TensorProduct.comm F₀ (M i) ↥E).bijective)
      let e_Mi : TensorProduct F₀ (M i) ↥E ≃ₐ[M i]
          (∀ j : Fin (d i), ({ x : Fin (d i) // x = j } → ↥E)) :=
        AlgEquiv.ofBijective θ_Mi hBij_θ
      have he_Mi_one : ∀ c : ↥E,
          e_Mi ((1 : M i) ⊗ₜ[F₀] c) = fun j _ => c := by
        intro c
        funext j x
        change ψ_E (c ⊗ₜ[F₀] (1 : M i)) j = c
        rw [Algebra.TensorProduct.lift_tmul, map_one, mul_one]
        rfl
      let c₁ : TensorProduct F₀ ↥E (L i) ≃+* TensorProduct F₀ (L i) ↥E :=
        (Algebra.TensorProduct.comm F₀ ↥E (L i)).toRingEquiv
      let c₂ : TensorProduct F₀ (L i) ↥E ≃+*
          TensorProduct (M i) (L i) (TensorProduct F₀ (M i) ↥E) :=
        (Algebra.TensorProduct.cancelBaseChange F₀ (M i) (M i) (L i) ↥E).symm.toRingEquiv
      let c₃ : TensorProduct (M i) (L i) (TensorProduct F₀ (M i) ↥E) ≃+*
          TensorProduct (M i) (L i) (∀ j : Fin (d i), ({ x : Fin (d i) // x = j } → ↥E)) :=
        (Algebra.TensorProduct.congr (AlgEquiv.refl : L i ≃ₐ[M i] L i) e_Mi).toRingEquiv
      let c₄ : TensorProduct (M i) (L i) (∀ j : Fin (d i), ({ x : Fin (d i) // x = j } → ↥E)) ≃+*
          (∀ j : Fin (d i), T_sub i j) :=
        (Algebra.TensorProduct.piRight (M i) (L i) (L i)
          (fun j : Fin (d i) => { x : Fin (d i) // x = j } → ↥E)).toRingEquiv
      refine ⟨((c₁.trans c₂).trans c₃).trans c₄, fun c y j => ?_⟩
      change c₄ (c₃ (c₂ (c₁ (c ⊗ₜ[F₀] y)))) j = y ⊗ₜ[M i] (fun _ => c)
      have hc₁ : c₁ (c ⊗ₜ[F₀] y) = y ⊗ₜ[F₀] c := rfl
      have hc₂ : c₂ (y ⊗ₜ[F₀] c) = y ⊗ₜ[M i] ((1 : M i) ⊗ₜ[F₀] c) :=
        Algebra.TensorProduct.cancelBaseChange_symm_tmul F₀ (M i) (M i) (L i) ↥E y c
      have hc₃ : c₃ (y ⊗ₜ[M i] ((1 : M i) ⊗ₜ[F₀] c)) = y ⊗ₜ[M i] (fun _ _ => c) :=
        congrArg (y ⊗ₜ[M i] ·) (he_Mi_one c)
      rw [hc₁, hc₂, hc₃]
      exact congrFun (Algebra.TensorProduct.piRight_tmul (M i) (L i) (L i)
        (fun j : Fin (d i) => { x : Fin (d i) // x = j } → ↥E) y (fun _ _ => c)) j
    let r_factor : ∀ i : Fin r, TensorProduct F₀ ↥E (L i) ≃+* (∀ j : Fin (d i), T_sub i j) :=
      fun i => Classical.choose (hFactor i)
    have hr_factor : ∀ (i : Fin r) (c : ↥E) (y : L i) (j : Fin (d i)),
        r_factor i (c ⊗ₜ[F₀] y) j =
          (letI : Algebra (M i) ({ x : Fin (d i) // x = j } → ↥E) := algM_sub i j
           y ⊗ₜ[M i] (fun _ => c)) :=
      fun i => Classical.choose_spec (hFactor i)
    letI algME_target : ∀ a : Fin N, Algebra (M (idx a)) ↥E := fun a =>
      RingHom.toAlgebra (((IntermediateField.inclusion hle).comp (σ a)).toRingHom)
    letI algKT_target : ∀ a : Fin N, Algebra K (TensorProduct (M (idx a)) (L (idx a)) ↥E) :=
      fun a =>
        RingHom.toAlgebra
          ((Algebra.TensorProduct.includeLeft :
              L (idx a) →ₐ[M (idx a)] TensorProduct (M (idx a)) (L (idx a)) ↥E).toRingHom.comp
            (algebraMap K (L (idx a))))
    let evUnique : ∀ a : Fin N,
        (letI : Algebra (M (idx a)) ({ x : Fin (d (idx a)) // x = (eqN.symm a).2 } → ↥E) :=
           algM_sub (idx a) (eqN.symm a).2
         ({ x : Fin (d (idx a)) // x = (eqN.symm a).2 } → ↥E) ≃ₐ[M (idx a)] ↥E) := fun a =>
      letI : Algebra (M (idx a)) ({ x : Fin (d (idx a)) // x = (eqN.symm a).2 } → ↥E) :=
        algM_sub (idx a) (eqN.symm a).2
      { toFun := fun u => u ⟨(eqN.symm a).2, rfl⟩
        invFun := fun c _ => c
        left_inv := fun u => funext fun x => congrArg u (Subtype.ext x.2.symm)
        right_inv := fun _ => rfl
        map_mul' := fun _ _ => rfl
        map_add' := fun _ _ => rfl
        commutes' := fun _ => rfl }
    let u_a : ∀ a : Fin N,
        T_sub (idx a) (eqN.symm a).2 ≃+* TensorProduct (M (idx a)) (L (idx a)) ↥E := fun a =>
      letI : Algebra (M (idx a)) ({ x : Fin (d (idx a)) // x = (eqN.symm a).2 } → ↥E) :=
        algM_sub (idx a) (eqN.symm a).2
      (Algebra.TensorProduct.congr
        (AlgEquiv.refl : L (idx a) ≃ₐ[M (idx a)] L (idx a)) (evUnique a)).toRingEquiv
    let g₁ : TensorProduct F₀ (∀ i : Fin r, L i) ↥E ≃+* TensorProduct F₀ ↥E (∀ i : Fin r, L i) :=
      (Algebra.TensorProduct.comm F₀ (∀ i : Fin r, L i) ↥E).toRingEquiv
    let g₂ : TensorProduct F₀ ↥E (∀ i : Fin r, L i) ≃+* (∀ i : Fin r, TensorProduct F₀ ↥E (L i)) :=
      (Algebra.TensorProduct.piRight F₀ F₀ ↥E L).toRingEquiv
    let g₃ : (∀ i : Fin r, TensorProduct F₀ ↥E (L i)) ≃+* (∀ (i : Fin r) (j : Fin (d i)), T_sub i j) :=
      RingEquiv.piCongrRight r_factor
    let g₄ : (∀ (i : Fin r) (j : Fin (d i)), T_sub i j) ≃+* (∀ p : IdxSigma, T_sub p.1 p.2) :=
      { (Equiv.piCurry (fun (i : Fin r) (j : Fin (d i)) => T_sub i j)).symm with
        map_mul' := fun _ _ => rfl
        map_add' := fun _ _ => rfl }
    let g₅ : (∀ p : IdxSigma, T_sub p.1 p.2) ≃+* (∀ a : Fin N, T_sub (idx a) (eqN.symm a).2) :=
      RingEquiv.piCongrLeft' (fun p : IdxSigma => T_sub p.1 p.2) eqN
    let g₆ : (∀ a : Fin N, T_sub (idx a) (eqN.symm a).2) ≃+*
        (∀ a : Fin N, TensorProduct (M (idx a)) (L (idx a)) ↥E) :=
      RingEquiv.piCongrRight u_a
    let e_ring : TensorProduct F₀ (∀ i : Fin r, L i) ↥E ≃+*
        (∀ a : Fin N, TensorProduct (M (idx a)) (L (idx a)) ↥E) :=
      ((((g₁.trans g₂).trans g₃).trans g₄).trans g₅).trans g₆
    have h_tmul : ∀ (f : ∀ i : Fin r, L i) (c : ↥E) (a : Fin N),
        e_ring (f ⊗ₜ[F₀] c) a = (f (idx a)) ⊗ₜ[M (idx a)] c := by
      intro f c a
      change u_a a (r_factor (idx a) ((g₂ (g₁ (f ⊗ₜ[F₀] c))) (idx a)) (eqN.symm a).2) =
        (f (idx a)) ⊗ₜ[M (idx a)] c
      have hg₁₂ : (g₂ (g₁ (f ⊗ₜ[F₀] c))) (idx a) = c ⊗ₜ[F₀] (f (idx a)) :=
        congrFun (Algebra.TensorProduct.piRight_tmul F₀ F₀ ↥E L c f) (idx a)
      rw [hg₁₂, hr_factor (idx a) c (f (idx a)) (eqN.symm a).2]
      rfl
    let e_E : TensorProduct F₀ (∀ i : Fin r, L i) ↥E ≃ₐ[K]
        (∀ a : Fin N, TensorProduct (M (idx a)) (L (idx a)) ↥E) :=
      { e_ring with
        commutes' := fun k => by
          funext a
          rw [Algebra.TensorProduct.algebraMap_apply]
          exact (h_tmul (algebraMap K (∀ i : Fin r, L i) k) 1 a).trans rfl }
    exact ⟨e_E, h_tmul⟩
  · intro N R A B _ _ _ _ _ G
    letI : DecidableEq B := Classical.decEq B
    have hSingle : ∀ (a : Fin N) (w : TensorProduct (R a) (A a) B),
        ∃ (S : Finset B) (m : ℕ) (y : Fin m → A a) (c : Fin m → B),
          (∀ k : Fin m, c k ∈ S) ∧
          w = ∑ k : Fin m, (y k) ⊗ₜ[R a] (c k) := by
      intro a w
      induction w using TensorProduct.inductionOn with
      | tmul y₀ c₀ =>
        exact ⟨{c₀}, 1, fun _ => y₀, fun _ => c₀,
          fun _ => Finset.mem_singleton_self c₀,
          (Fin.sum_univ_one (fun _ : Fin 1 => y₀ ⊗ₜ[R a] c₀)).symm⟩
      | add w₁ w₂ ih₁ ih₂ =>
        rcases ih₁ with ⟨S₁, m₁, y₁, c₁, hS₁, hw₁⟩
        rcases ih₂ with ⟨S₂, m₂, y₂, c₂, hS₂, hw₂⟩
        let y : Fin (m₁ + m₂) → A a := @Fin.addCases m₁ m₂ (fun _ => A a) y₁ y₂
        let c : Fin (m₁ + m₂) → B := @Fin.addCases m₁ m₂ (fun _ => B) c₁ c₂
        refine ⟨S₁ ∪ S₂, m₁ + m₂, y, c, ?_, ?_⟩
        · intro k
          refine @Fin.addCases m₁ m₂ (fun k => c k ∈ S₁ ∪ S₂) (fun k₁ => ?_) (fun k₂ => ?_) k
          · dsimp [c]
            rw [Fin.addCases_left]
            exact Finset.mem_union_left S₂ (hS₁ k₁)
          · dsimp [c]
            rw [Fin.addCases_right]
            exact Finset.mem_union_right S₁ (hS₂ k₂)
        · rw [Fin.sum_univ_add]
          have h₁ : (∑ i : Fin m₁, y (Fin.castAdd m₂ i) ⊗ₜ[R a] c (Fin.castAdd m₂ i)) = w₁ := by
            rw [hw₁]
            refine Finset.sum_congr rfl (fun i _ => ?_)
            dsimp [y, c]
            rw [Fin.addCases_left, Fin.addCases_left]
          have h₂ : (∑ i : Fin m₂, y (Fin.natAdd m₁ i) ⊗ₜ[R a] c (Fin.natAdd m₁ i)) = w₂ := by
            rw [hw₂]
            refine Finset.sum_congr rfl (fun i _ => ?_)
            dsimp [y, c]
            rw [Fin.addCases_right, Fin.addCases_right]
          rw [h₁, h₂]
    let S_of : ∀ a : Fin N, TensorProduct (R a) (A a) B → Finset B := fun a w =>
      Classical.choose (hSingle a w)
    let S_B : Finset B := Finset.univ.biUnion (fun a : Fin N => (G a).biUnion (S_of a))
    refine ⟨S_B, fun a w hw => ?_⟩
    rcases Classical.choose_spec (hSingle a w) with ⟨m, y, c, hc, hw_eq⟩
    refine ⟨m, y, c, fun k => ?_, hw_eq⟩
    exact Finset.mem_biUnion.mpr ⟨a, Finset.mem_univ a, Finset.mem_biUnion.mpr ⟨w, hw, hc k⟩⟩

theorem weil_alt_cd_standard_etale_bezout_chart_over_domain (P B K Ω : Type u) [CommRing P] [IsDomain P] [CommRing B] [IsDomain B]
    [Field K] [Algebra B K] [IsFractionRing B K] [Field Ω]
    [Algebra (FractionRing P) K]
    (ψ : P →+* B) (ev_x : B →+* Ω)
    (h_ev : ∀ h : P, h ≠ 0 → ev_x (ψ h) ≠ 0)
    (hi_K : ∀ h : P, algebraMap (FractionRing P) K (algebraMap P (FractionRing P) h) = algebraMap B K (ψ h))
    (κ_sep : Type u) [Field κ_sep] [Algebra (FractionRing P) κ_sep]
    [Algebra.IsSeparable (FractionRing P) κ_sep]
    (j_Ω : κ_sep →+* Ω)
    (hj_Ω : ∀ h : P, j_Ω (algebraMap (FractionRing P) κ_sep (algebraMap P (FractionRing P) h)) = ev_x (ψ h))
    (C₀ : Type u) [CommRing C₀] [Algebra B C₀] [Algebra.Etale B C₀]
    (u₀ : C₀ →+* Ω) (hu₀ : u₀.comp (algebraMap B C₀) = ev_x)
    (E_init : IntermediateField (FractionRing P) κ_sep)
    (hFD_init : FiniteDimensional (FractionRing P) ↥E_init) :
    ∃ (C_init : Type u) (_ : CommRing C_init) (_ : Algebra B C_init) (_ : Algebra C₀ C_init)
      (_ : IsScalarTower B C₀ C_init) (_ : Algebra.Etale C₀ C_init)
      (u_init : C_init →+* Ω)
      (α_init : TensorProduct B K C_init ≃ₐ[K]
          TensorProduct (FractionRing P) (TensorProduct B K C₀) ↥E_init),
      u_init.comp (algebraMap C₀ C_init) = u₀ ∧
      ∀ (E_fin : IntermediateField (FractionRing P) κ_sep) (hle : E_init ≤ E_fin),
        FiniteDimensional (FractionRing P) ↥E_fin →
        ∃ (C_fin : Type u) (_ : CommRing C_fin) (_ : Algebra B C_fin)
          (_ : Algebra C_init C_fin) (_ : IsScalarTower B C_init C_fin)
          (_ : Algebra.Etale C_init C_fin) (u_fin : C_fin →+* Ω)
          (α_fin : TensorProduct B K C_fin ≃ₐ[K]
              TensorProduct (FractionRing P) (TensorProduct B K C₀) ↥E_fin),
          u_fin.comp (algebraMap C_init C_fin) = u_init ∧
          ∀ (z : TensorProduct B K C_init),
            α_fin (Algebra.TensorProduct.map (AlgHom.id B K)
                (IsScalarTower.toAlgHom B C_init C_fin) z) =
              Algebra.TensorProduct.map
                (AlgHom.id (FractionRing P) (TensorProduct B K C₀))
                (IntermediateField.inclusion hle) (α_init z) :=
by
  let _ := h_ev
  let F₀ : Type u := FractionRing P
  have hInjPF : Function.Injective (algebraMap P F₀) := IsFractionRing.injective P F₀

  have hClearDenom : ∀ R_poly : Polynomial F₀,
      ∃ (q : Polynomial P) (h : P), h ≠ 0 ∧
        R_poly * Polynomial.C (algebraMap P F₀ h) = q.map (algebraMap P F₀) := by
    intro R_poly
    letI : Algebra (Polynomial P) (Polynomial F₀) := Polynomial.algebra P F₀
    have : IsLocalization (Submonoid.map Polynomial.C (nonZeroDivisors P)) (Polynomial F₀) :=
      Polynomial.isLocalization (nonZeroDivisors P) F₀
    obtain ⟨⟨q, s⟩, hsurj⟩ :=
      IsLocalization.surj (Submonoid.map Polynomial.C (nonZeroDivisors P)) R_poly
    rcases Submonoid.mem_map.mp s.2 with ⟨h, hh_mem, hh_eq⟩
    have hh_ne : h ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hh_mem
    refine ⟨q, h, hh_ne, ?_⟩
    have hmap : ∀ p : Polynomial P,
        algebraMap (Polynomial P) (Polynomial F₀) p = p.map (algebraMap P F₀) := by
      intro p
      rw [Polynomial.algebraMap_def]
      rfl
    have hsurj' : R_poly * s.1.map (algebraMap P F₀) = q.map (algebraMap P F₀) := by
      simpa only [hmap] using hsurj
    rw [← hh_eq, Polynomial.map_C] at hsurj'
    exact hsurj'

  have hScalePrim : ∀ (E : IntermediateField F₀ κ_sep),
      FiniteDimensional F₀ ↥E →
      ∃ (α : ↥E) (f_E : Polynomial P),
        Algebra.adjoin F₀ ({α} : Set ↥E) = ⊤ ∧
        f_E.Monic ∧
        f_E.map (algebraMap P F₀) = minpoly F₀ α := by
    intro E hFD
    have : FiniteDimensional F₀ ↥E := hFD
    have : Algebra.IsSeparable F₀ ↥E := Algebra.isSeparable_tower_bot_of_isSeparable F₀ ↥E κ_sep
    obtain ⟨α₀, hα₀_top⟩ := Field.exists_primitive_element F₀ ↥E
    have hInt_α₀ : IsIntegral F₀ α₀ := Algebra.IsIntegral.isIntegral α₀
    let Q₀ : Polynomial F₀ := minpoly F₀ α₀
    have hQ₀_monic : Q₀.Monic := minpoly.monic hInt_α₀
    let m₀ : ↥(nonZeroDivisors P) := IsLocalization.commonDenom (nonZeroDivisors P) Q₀.support Q₀.coeff
    let c₀_scale : F₀ := algebraMap P F₀ m₀.1
    have hm₀_ne : (m₀.1 : P) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp m₀.2
    have hc₀_ne : c₀_scale ≠ 0 := fun h0 => hm₀_ne (hInjPF (h0.trans (map_zero _).symm))
    have hlifts : Q₀.scaleRoots c₀_scale ∈ Polynomial.lifts (algebraMap P F₀) :=
      IsLocalization.scaleRoots_commonDenom_mem_lifts (nonZeroDivisors P) Q₀
        ⟨1, (map_one _).trans hQ₀_monic.leadingCoeff.symm⟩
    obtain ⟨f_E, hf_map⟩ := (Polynomial.mem_lifts (Q₀.scaleRoots c₀_scale)).mp hlifts
    have hf_monic : f_E.Monic := by
      change f_E.leadingCoeff = 1
      apply hInjPF
      rw [← Polynomial.leadingCoeff_map_of_injective hInjPF, hf_map,
        Polynomial.leadingCoeff_scaleRoots, hQ₀_monic.leadingCoeff, map_one]
    let α : ↥E := algebraMap F₀ ↥E c₀_scale * α₀
    have hInt_α : IsIntegral F₀ α := Algebra.IsIntegral.isIntegral α
    have hα₀_eq : α₀ = algebraMap F₀ ↥E c₀_scale⁻¹ * α := by
      dsimp only [α]
      rw [← mul_assoc, ← map_mul, inv_mul_cancel₀ hc₀_ne, map_one, one_mul]
    have hα₀_mem : α₀ ∈ IntermediateField.adjoin F₀ ({α} : Set ↥E) := by
      rw [hα₀_eq]
      exact mul_mem (IntermediateField.algebraMap_mem _ _)
        (IntermediateField.mem_adjoin_simple_self F₀ α)
    have hα_top : IntermediateField.adjoin F₀ ({α} : Set ↥E) = ⊤ := by
      apply top_unique
      rw [← hα₀_top]
      exact IntermediateField.adjoin_le_iff.mpr (Set.singleton_subset_iff.mpr hα₀_mem)
    have hadj_top : Algebra.adjoin F₀ ({α} : Set ↥E) = ⊤ :=
      (IntermediateField.adjoin_simple_eq_top_iff_of_isAlgebraic hInt_α.isAlgebraic).mp hα_top
    have haeval_zero : Polynomial.aeval α (f_E.map (algebraMap P F₀)) = 0 := by
      rw [hf_map, Polynomial.aeval_def,
        Polynomial.scaleRoots_eval₂_mul (algebraMap F₀ ↥E) α₀ c₀_scale,
        ← Polynomial.aeval_def, minpoly.aeval F₀ α₀, mul_zero]
    have hnatdeg_eq : (f_E.map (algebraMap P F₀)).natDegree = (minpoly F₀ α).natDegree := by
      rw [hf_map, Polynomial.natDegree_scaleRoots]
      change (minpoly F₀ α₀).natDegree = (minpoly F₀ α).natDegree
      rw [← IntermediateField.adjoin.finrank hInt_α₀, hα₀_top, ← hα_top,
        IntermediateField.adjoin.finrank hInt_α]
    have hf_map_monic : (f_E.map (algebraMap P F₀)).Monic := hf_monic.map (algebraMap P F₀)
    have hmin_monic : (minpoly F₀ α).Monic := minpoly.monic hInt_α
    have hdeg_le : (f_E.map (algebraMap P F₀)).degree ≤ (minpoly F₀ α).degree := by
      rw [Polynomial.degree_eq_natDegree hf_map_monic.ne_zero,
        Polynomial.degree_eq_natDegree hmin_monic.ne_zero, hnatdeg_eq]
    have hf_min : f_E.map (algebraMap P F₀) = minpoly F₀ α :=
      minpoly.unique_of_degree_le_degree_minpoly F₀ α hf_map_monic haeval_zero hdeg_le
    exact ⟨α, f_E, hadj_top, hf_monic, hf_min⟩

  have hBuildPair : ∀ (E : IntermediateField F₀ κ_sep) [FiniteDimensional F₀ ↥E]
      (α : ↥E) (f_E : Polynomial P),
      Algebra.adjoin F₀ ({α} : Set ↥E) = ⊤ →
      f_E.Monic →
      f_E.map (algebraMap P F₀) = minpoly F₀ α →
      ∀ (h_extra : P), h_extra ≠ 0 →
      letI : Algebra P ↥E := ((algebraMap F₀ ↥E).comp (algebraMap P F₀)).toAlgebra
      letI : Algebra P Ω := (ev_x.comp ψ).toAlgebra
      ∃ (H : P) (pair_E : StandardEtalePair P)
        (ι_E : pair_E.Ring →ₐ[P] ↥E)
        (Φ_E : TensorProduct P F₀ pair_E.Ring ≃ₐ[F₀] ↥E)
        (v_E : pair_E.Ring →ₐ[P] Ω),
        H ≠ 0 ∧
        (∃ h_left : P, H = h_left * h_extra) ∧
        pair_E.f = f_E ∧
        pair_E.g = Polynomial.C H ∧
        ι_E pair_E.X = α ∧
        (∀ p : pair_E.Ring, Φ_E ((1 : F₀) ⊗ₜ[P] p) = ι_E p) ∧
        (∀ p : pair_E.Ring, v_E p = j_Ω ((ι_E p : ↥E) : κ_sep)) := by
    intro E hFD α f_E hadj_top hf_monic hf_min h_extra hh_extra
    letI : Algebra P ↥E := ((algebraMap F₀ ↥E).comp (algebraMap P F₀)).toAlgebra
    letI : IsScalarTower P F₀ ↥E := IsScalarTower.of_algebraMap_eq' rfl
    letI : Algebra P Ω := (ev_x.comp ψ).toAlgebra
    have : Algebra.IsSeparable F₀ ↥E := Algebra.isSeparable_tower_bot_of_isSeparable F₀ ↥E κ_sep
    have hSep_f : (f_E.map (algebraMap P F₀)).Separable := by
      rw [hf_min]
      exact Algebra.IsSeparable.isSeparable F₀ α
    obtain ⟨a_B, b_B, hBez_F₀⟩ := (Polynomial.separable_def' _).mp hSep_f
    obtain ⟨q₁, h₁, hh₁_ne, hq₁⟩ := hClearDenom b_B
    obtain ⟨q₂, h₂, hh₂_ne, hq₂⟩ := hClearDenom a_B
    let H : P := (h₁ * h₂) * h_extra
    have hH_ne : H ≠ 0 := mul_ne_zero (mul_ne_zero hh₁_ne hh₂_ne) hh_extra
    let p₁ : Polynomial P := q₁ * Polynomial.C (h₂ * h_extra)
    let p₂ : Polynomial P := q₂ * Polynomial.C (h₁ * h_extra)
    have hBez_P : Polynomial.derivative f_E * p₁ + f_E * p₂ = (Polynomial.C H) ^ 1 := by
      apply Polynomial.map_injective (algebraMap P F₀) hInjPF
      have hcalc :
          (Polynomial.derivative f_E * p₁ + f_E * p₂).map (algebraMap P F₀) =
            (a_B * f_E.map (algebraMap P F₀) +
              b_B * (f_E.map (algebraMap P F₀)).derivative) *
              Polynomial.C (algebraMap P F₀ H) := by
        simp only [p₁, p₂, H, Polynomial.map_add, Polynomial.map_mul, Polynomial.map_C,
          ← Polynomial.derivative_map, map_mul]
        rw [← hq₁, ← hq₂]
        ring
      rw [hcalc, hBez_F₀, one_mul, pow_one, Polynomial.map_C]
    let pair_E : StandardEtalePair P :=
      StandardEtalePair.mk f_E hf_monic (Polynomial.C H) ⟨p₁, p₂, 1, hBez_P⟩
    have hMap_α : pair_E.HasMap α := by
      refine ⟨?_, ?_⟩
      · change Polynomial.aeval α f_E = 0
        rw [← Polynomial.aeval_map_algebraMap F₀ α f_E, hf_min, minpoly.aeval F₀ α]
      · change IsUnit (Polynomial.aeval α (Polynomial.C H))
        rw [Polynomial.aeval_C, IsScalarTower.algebraMap_apply P F₀ ↥E]
        have hHF₀_ne : algebraMap P F₀ H ≠ 0 :=
          fun h0 => hH_ne (hInjPF (h0.trans (map_zero _).symm))
        exact (Ne.isUnit hHF₀_ne).map (algebraMap F₀ ↥E)
    let ι_E : pair_E.Ring →ₐ[P] ↥E := pair_E.lift α hMap_α
    have hι_X : ι_E pair_E.X = α := pair_E.lift_X α hMap_α
    let Φ_hom : TensorProduct P F₀ pair_E.Ring →ₐ[F₀] ↥E :=
      Algebra.TensorProduct.lift (Algebra.ofId F₀ ↥E) ι_E (fun _ _ => Commute.all _ _)
    have hΦ_one_tmul : ∀ p : pair_E.Ring, Φ_hom ((1 : F₀) ⊗ₜ[P] p) = ι_E p := by
      intro p
      dsimp only [Φ_hom]
      rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
    have hInt_α : IsIntegral F₀ α := Algebra.IsIntegral.isIntegral α
    let pb_E : PowerBasis F₀ ↥E := PowerBasis.ofAdjoinEqTop hInt_α hadj_top
    have hpb_gen : pb_E.gen = α := PowerBasis.ofAdjoinEqTop_gen hInt_α hadj_top
    let incR : pair_E.Ring →ₐ[P] TensorProduct P F₀ pair_E.Ring :=
      Algebra.TensorProduct.includeRight
    have hRoot_X : Polynomial.aeval ((1 : F₀) ⊗ₜ[P] pair_E.X) (minpoly F₀ pb_E.gen) = 0 := by
      rw [hpb_gen, ← hf_min, Polynomial.aeval_map_algebraMap F₀ ((1 : F₀) ⊗ₜ[P] pair_E.X) f_E]
      change Polynomial.aeval (incR pair_E.X) pair_E.f = 0
      rw [Polynomial.aeval_algHom_apply incR pair_E.X pair_E.f, pair_E.hasMap_X.1, map_zero]
    let Ψ_hom : ↥E →ₐ[F₀] TensorProduct P F₀ pair_E.Ring :=
      pb_E.lift ((1 : F₀) ⊗ₜ[P] pair_E.X) hRoot_X
    have hΨ_α : Ψ_hom α = (1 : F₀) ⊗ₜ[P] pair_E.X := by
      rw [← hpb_gen]
      exact pb_E.lift_gen ((1 : F₀) ⊗ₜ[P] pair_E.X) hRoot_X
    have hΦΨ : Φ_hom.comp Ψ_hom = AlgHom.id F₀ ↥E := by
      apply pb_E.algHom_ext
      rw [AlgHom.comp_apply, AlgHom.id_apply, hpb_gen, hΨ_α, hΦ_one_tmul, hι_X]
    have hOnP : ∀ p : pair_E.Ring,
        Ψ_hom (Φ_hom ((1 : F₀) ⊗ₜ[P] p)) = (1 : F₀) ⊗ₜ[P] p := by
      have hHomEq : ((Ψ_hom.comp Φ_hom).restrictScalars P).comp incR = incR := by
        apply pair_E.homEquiv.injective
        apply Subtype.ext
        rw [pair_E.homEquiv_apply_coe, pair_E.homEquiv_apply_coe]
        change Ψ_hom (Φ_hom ((1 : F₀) ⊗ₜ[P] pair_E.X)) = (1 : F₀) ⊗ₜ[P] pair_E.X
        rw [hΦ_one_tmul, hι_X, hΨ_α]
      intro p
      exact DFunLike.congr_fun hHomEq p
    have hΨΦ : Ψ_hom.comp Φ_hom = AlgHom.id F₀ (TensorProduct P F₀ pair_E.Ring) := by
      apply AlgHom.ext
      intro z
      induction z using TensorProduct.induction_on with
      | zero => simp only [map_zero, AlgHom.id_apply]
      | tmul c p =>
        have hsmul : c ⊗ₜ[P] p = c • ((1 : F₀) ⊗ₜ[P] p) := by
          rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
        rw [hsmul, map_smul, AlgHom.comp_apply, hOnP p, AlgHom.id_apply]
      | add x y ihx ihy => simp only [map_add, AlgHom.id_apply, ihx, ihy]
    let Φ_E : TensorProduct P F₀ pair_E.Ring ≃ₐ[F₀] ↥E :=
      AlgEquiv.ofAlgHom Φ_hom Ψ_hom hΦΨ hΨΦ
    let j_E_alg : ↥E →ₐ[P] Ω :=
      { j_Ω.comp E.val.toRingHom with
        commutes' := fun h =>
          (congrArg j_Ω (E.val.commutes (algebraMap P F₀ h))).trans (hj_Ω h) }
    let v_E : pair_E.Ring →ₐ[P] Ω := j_E_alg.comp ι_E
    refine ⟨H, pair_E, ι_E, Φ_E, v_E, hH_ne, ⟨h₁ * h₂, rfl⟩, rfl, rfl, hι_X, ?_, ?_⟩
    · intro p
      exact hΦ_one_tmul p
    · intro p
      rfl

  letI : Algebra P B := ψ.toAlgebra
  letI : Algebra P C₀ := ((algebraMap B C₀).comp ψ).toAlgebra
  letI : IsScalarTower P B C₀ := IsScalarTower.of_algebraMap_eq' rfl
  letI : Algebra P K := ((algebraMap B K).comp ψ).toAlgebra
  letI : IsScalarTower P B K := IsScalarTower.of_algebraMap_eq' rfl
  letI : IsScalarTower P F₀ K := IsScalarTower.of_algebraMap_eq (fun h => (hi_K h).symm)
  letI : IsScalarTower P F₀ (TensorProduct B K C₀) :=
    IsScalarTower.to₁₂₄ P F₀ K (TensorProduct B K C₀)
  letI : Algebra P Ω := (ev_x.comp ψ).toAlgebra
  let u₀_P : C₀ →ₐ[P] Ω :=
    { u₀ with commutes' := fun h => DFunLike.congr_fun hu₀ (ψ h) }

  letI : Algebra P ↥E_init := ((algebraMap F₀ ↥E_init).comp (algebraMap P F₀)).toAlgebra
  letI : IsScalarTower P F₀ ↥E_init := IsScalarTower.of_algebraMap_eq' rfl
  obtain ⟨α_init_el, f_init, hadj_init, hf_init_monic, hf_init_min⟩ :=
    hScalePrim E_init hFD_init
  obtain ⟨H_init, pair_init, ι_init, Φ_init, v_init,
      hH_init_ne, _, hpair_init_f, hpair_init_g, hι_init_X, hΦ_init_tmul, hv_init_eq⟩ :=
    hBuildPair E_init α_init_el f_init hadj_init hf_init_monic hf_init_min 1 one_ne_zero

  let P_init : Type u := pair_init.Ring
  let C_init : Type u := TensorProduct P C₀ P_init
  have hEt_C₀_Cinit : Algebra.Etale C₀ C_init := Algebra.Etale.baseChange P P_init C₀
  let u_init : C_init →+* Ω :=
    (Algebra.TensorProduct.lift u₀_P v_init (fun _ _ => Commute.all _ _)).toRingHom
  let α_init : TensorProduct B K C_init ≃ₐ[K] TensorProduct F₀ (TensorProduct B K C₀) ↥E_init :=
    (((Algebra.TensorProduct.assoc P B K K C₀ P_init).symm.trans
      (Algebra.TensorProduct.cancelBaseChange P F₀ K (TensorProduct B K C₀) P_init).symm).trans
      (Algebra.TensorProduct.congr
        (AlgEquiv.refl : TensorProduct B K C₀ ≃ₐ[K] TensorProduct B K C₀) Φ_init))

  have hu_init_comp : u_init.comp (algebraMap C₀ C_init) = u₀ := by
    apply RingHom.ext
    intro c₀
    change (Algebra.TensorProduct.lift u₀_P v_init (fun _ _ => Commute.all _ _))
      (c₀ ⊗ₜ[P] (1 : P_init)) = u₀ c₀
    rw [Algebra.TensorProduct.lift_tmul, map_one, mul_one]
    rfl

  have hα_init_tmul : ∀ (k : K) (c₀ : C₀) (p : P_init),
      α_init (k ⊗ₜ[B] (c₀ ⊗ₜ[P] p)) = (k ⊗ₜ[B] c₀) ⊗ₜ[F₀] ι_init p := by
    intro k c₀ p
    dsimp only [α_init, AlgEquiv.trans_apply]
    rw [Algebra.TensorProduct.assoc_symm_tmul,
      Algebra.TensorProduct.cancelBaseChange_symm_tmul,
      Algebra.TensorProduct.congr_apply, AlgEquiv.refl_toAlgHom,
      Algebra.TensorProduct.map_tmul, AlgHom.id_apply, AlgEquiv.coe_toAlgHom, hΦ_init_tmul]

  refine ⟨C_init, inferInstance, inferInstance, inferInstance, inferInstance,
    hEt_C₀_Cinit, u_init, α_init, hu_init_comp, ?_⟩

  intro E_fin hle hFD_fin
  have : FiniteDimensional F₀ ↥E_fin := hFD_fin
  letI : Algebra P ↥E_fin := ((algebraMap F₀ ↥E_fin).comp (algebraMap P F₀)).toAlgebra
  letI : IsScalarTower P F₀ ↥E_fin := IsScalarTower.of_algebraMap_eq' rfl

  obtain ⟨α_fin_el, f_fin, hadj_fin, hf_fin_monic, hf_fin_min⟩ :=
    hScalePrim E_fin hFD_fin

  have h_in_range : IntermediateField.inclusion hle α_init_el ∈
