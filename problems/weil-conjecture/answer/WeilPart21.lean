    have hIso_0 : CategoryTheory.IsIso πℤ_0 := (sys h).hConstIso hT₁_0 hT₂_0 Aℤ
    let ιℤ_0 : Fℤ₁ ⟶ pb_h.obj Fℤ₂ := @CategoryTheory.inv _ _ _ _ πℤ_0 hIso_0
    have hπM_eq : weilEtaleConstPullbackHom h hT₁ hT₂ AM = πM_0 :=
      hConstPull_indep h hT₁ hT₂ AM
    have hπℤ_eq : weilEtaleConstPullbackHom h hT₁ hT₂ Aℤ = πℤ_0 :=
      hConstPull_indep h hT₁ hT₂ Aℤ
