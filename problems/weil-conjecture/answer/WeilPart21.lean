  obtain ⟨m, V, p, A_inf, hCR_Ai, hAlg_Ai, hEt_Ai, B_inf, hCR_Bi, hAlg_Bi, hEt_Bi,
    ψ_inf, hSubR, hMemAff, ⟨i_Y, i_V, hComm_inf⟩, hJoint_inf⟩ := hSubcoverRings

  
  have hStageDesc :
      letI : CommRing A_inf := hCR_Ai
      letI : Algebra L_inf A_inf := hAlg_Ai
      letI : Algebra.Etale L_inf A_inf := hEt_Ai
      letI : ∀ a, CommRing (B_inf a) := hCR_Bi
      letI : ∀ a, Algebra L_inf (B_inf a) := hAlg_Bi
      letI : ∀ a, Algebra.Etale L_inf (B_inf a) := hEt_Bi
      ∃ (M₁ : IntermediateField F₀ L_inf) (_ : FiniteDimensional F₀ ↥M₁)
        (A₁ : Type u) (_ : CommRing A₁) (_ : Algebra ↥M₁ A₁) (_ : Algebra.Etale ↥M₁ A₁)
        (B₁ : Fin m → Type u) (_ : ∀ a, CommRing (B₁ a)) (_ : ∀ a, Algebra ↥M₁ (B₁ a))
        (_ : ∀ a, Algebra.Etale ↥M₁ (B₁ a))
        (φ₁ : ∀ a : Fin m, A₁ →ₐ[↥M₁] B₁ a)
        (α_A : TensorProduct ↥M₁ L_inf A₁ ≃ₐ[L_inf] A_inf)
        (α_B : ∀ a : Fin m, TensorProduct ↥M₁ L_inf (B₁ a) ≃ₐ[L_inf] B_inf a),
        ∀ a : Fin m,
          (α_B a).toAlgHom.comp (Algebra.TensorProduct.map (AlgHom.id L_inf L_inf) (φ₁ a)) =
            (ψ_inf a).comp α_A.toAlgHom := by
    let _ : CommRing A_inf := hCR_Ai
    let _ : Algebra L_inf A_inf := hAlg_Ai
    let _ : Algebra.Etale L_inf A_inf := hEt_Ai
    let _ : ∀ a, CommRing (B_inf a) := hCR_Bi
    let _ : ∀ a, Algebra L_inf (B_inf a) := hAlg_Bi
    let _ : ∀ a, Algebra.Etale L_inf (B_inf a) := hEt_Bi
    have hFinSup : ∀ {n : ℕ} (E₀ : IntermediateField F₀ L_inf), FiniteDimensional F₀ ↥E₀ →
        ∀ (E : Fin n → IntermediateField F₀ L_inf), (∀ a : Fin n, FiniteDimensional F₀ ↥(E a)) →
        ∃ (M : IntermediateField F₀ L_inf),
          FiniteDimensional F₀ ↥M ∧ E₀ ≤ M ∧ ∀ a : Fin n, E a ≤ M := by
      intro n E₀ hE₀ E hE
      classical
      have hInd : ∀ s : Finset (Fin n), FiniteDimensional F₀ ↥(E₀ ⊔ s.sup E) := by
        intro s
        induction s using Finset.induction_on with
        | empty =>
          rw [Finset.sup_empty, sup_bot_eq]
          exact hE₀
        | @insert a s _ ih =>
          rw [Finset.sup_insert, sup_comm (E a) (s.sup E), ← sup_assoc]
          let _ : FiniteDimensional F₀ ↥(E₀ ⊔ s.sup E) := ih
          let _ : FiniteDimensional F₀ ↥(E a) := hE a
          exact IntermediateField.finiteDimensional_sup (E₀ ⊔ s.sup E) (E a)
      refine ⟨E₀ ⊔ Finset.univ.sup E, hInd Finset.univ, le_sup_left, fun a => ?_⟩
      exact le_trans (Finset.le_sup (Finset.mem_univ a)) le_sup_right
    have hObjStage :
        ∃ (M₀ : IntermediateField F₀ L_inf) (_ : FiniteDimensional F₀ ↥M₀)
          (A₀ : Type u) (_ : CommRing A₀) (_ : Algebra ↥M₀ A₀) (_ : Algebra.Etale ↥M₀ A₀)
          (B₀ : Fin m → Type u) (_ : ∀ a, CommRing (B₀ a)) (_ : ∀ a, Algebra ↥M₀ (B₀ a))
          (_ : ∀ a, Algebra.Etale ↥M₀ (B₀ a))
          (e₀_A : TensorProduct ↥M₀ L_inf A₀ ≃ₐ[L_inf] A_inf)
          (_ : ∀ a : Fin m, TensorProduct ↥M₀ L_inf (B₀ a) ≃ₐ[L_inf] B_inf a), True := by
      obtain ⟨M_Y, hFD_Y, A_init, hCR_Ainit, hAlg_Ainit, hEt_Ainit, ⟨e_AY⟩⟩ := hDescObj A_inf
      let M_B : Fin m → IntermediateField F₀ L_inf :=
        fun a => Classical.choose (hDescObj (B_inf a))
      have hFD_B : ∀ a : Fin m, FiniteDimensional F₀ ↥(M_B a) :=
        fun a => Classical.choose (Classical.choose_spec (hDescObj (B_inf a)))
      let B_init : Fin m → Type u := fun a =>
        Classical.choose (Classical.choose_spec (Classical.choose_spec (hDescObj (B_inf a))))
      have hSpec_B : ∀ a : Fin m,
          ∃ (_ : CommRing (B_init a)) (_ : Algebra ↥(M_B a) (B_init a))
            (_ : Algebra.Etale ↥(M_B a) (B_init a)),
            Nonempty (TensorProduct ↥(M_B a) L_inf (B_init a) ≃ₐ[L_inf] B_inf a) :=
        fun a => Classical.choose_spec
          (Classical.choose_spec (Classical.choose_spec (hDescObj (B_inf a))))
      obtain ⟨M₀, hFD₀, hle_Y, hle_B⟩ := hFinSup M_Y hFD_Y M_B hFD_B
      have hA₀ : ∃ (A₀ : Type u) (_ : CommRing A₀) (_ : Algebra ↥M₀ A₀)
          (_ : Algebra.Etale ↥M₀ A₀),
          Nonempty (TensorProduct ↥M₀ L_inf A₀ ≃ₐ[L_inf] A_inf) := by
        let _ : CommRing A_init := hCR_Ainit
        let _ : Algebra ↥M_Y A_init := hAlg_Ainit
        let _ : Algebra.Etale ↥M_Y A_init := hEt_Ainit
        let _ : Algebra ↥M_Y ↥M₀ := (IntermediateField.inclusion hle_Y).toRingHom.toAlgebra
        let _ : IsScalarTower ↥M_Y ↥M₀ L_inf := IsScalarTower.of_algebraMap_eq' rfl
        let A₀ := TensorProduct ↥M_Y ↥M₀ A_init
        let _ : Algebra.Etale ↥M₀ A₀ := Algebra.Etale.baseChange ↥M_Y A_init ↥M₀
        exact ⟨A₀, inferInstance, inferInstance, inferInstance,
          ⟨(Algebra.TensorProduct.cancelBaseChange ↥M_Y ↥M₀ L_inf L_inf A_init).trans e_AY⟩⟩
      have hB₀ : ∀ a : Fin m,
          ∃ (B₀a : Type u) (_ : CommRing B₀a) (_ : Algebra ↥M₀ B₀a)
            (_ : Algebra.Etale ↥M₀ B₀a),
            Nonempty (TensorProduct ↥M₀ L_inf B₀a ≃ₐ[L_inf] B_inf a) := by
        intro a
        obtain ⟨hCR_Ba, hAlg_Ba, hEt_Ba, ⟨e_Ba⟩⟩ := hSpec_B a
        let _ : CommRing (B_init a) := hCR_Ba
        let _ : Algebra ↥(M_B a) (B_init a) := hAlg_Ba
        let _ : Algebra.Etale ↥(M_B a) (B_init a) := hEt_Ba
        let _ : Algebra ↥(M_B a) ↥M₀ := (IntermediateField.inclusion (hle_B a)).toRingHom.toAlgebra
        let _ : IsScalarTower ↥(M_B a) ↥M₀ L_inf := IsScalarTower.of_algebraMap_eq' rfl
        let B₀a := TensorProduct ↥(M_B a) ↥M₀ (B_init a)
        let _ : Algebra.Etale ↥M₀ B₀a := Algebra.Etale.baseChange ↥(M_B a) (B_init a) ↥M₀
        exact ⟨B₀a, inferInstance, inferInstance, inferInstance,
          ⟨(Algebra.TensorProduct.cancelBaseChange ↥(M_B a) ↥M₀ L_inf L_inf (B_init a)).trans e_Ba⟩⟩
      obtain ⟨A₀, hCR_A₀, hAlg_A₀, hEt_A₀, ⟨e₀_A⟩⟩ := hA₀
      exact ⟨M₀, hFD₀, A₀, hCR_A₀, hAlg_A₀, hEt_A₀,
        fun a => Classical.choose (hB₀ a),
        fun a => Classical.choose (Classical.choose_spec (hB₀ a)),
        fun a => Classical.choose (Classical.choose_spec (Classical.choose_spec (hB₀ a))),
        fun a => Classical.choose
          (Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (hB₀ a)))),
        e₀_A,
        fun a => Classical.choice (Classical.choose_spec
          (Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (hB₀ a))))),
        trivial⟩
    obtain ⟨M₀, hFD₀, A₀, hCR_A₀, hAlg_A₀, hEt_A₀,
      B₀, hCR_B₀, hAlg_B₀, hEt_B₀, e₀_A, e₀_B, -⟩ := hObjStage
    let _ : CommRing A₀ := hCR_A₀
    let _ : Algebra ↥M₀ A₀ := hAlg_A₀
    let _ : Algebra.Etale ↥M₀ A₀ := hEt_A₀
    let _ : ∀ a, CommRing (B₀ a) := hCR_B₀
    let _ : ∀ a, Algebra ↥M₀ (B₀ a) := hAlg_B₀
    let _ : ∀ a, Algebra.Etale ↥M₀ (B₀ a) := hEt_B₀
    let Θ_inf : ∀ a : Fin m,
        TensorProduct ↥M₀ L_inf A₀ →ₐ[L_inf] TensorProduct ↥M₀ L_inf (B₀ a) :=
      fun a => (e₀_B a).symm.toAlgHom.comp ((ψ_inf a).comp e₀_A.toAlgHom)
    let ψ_target : ∀ a : Fin m, A₀ →+* TensorProduct ↥M₀ L_inf (B₀ a) :=
      fun a => (Θ_inf a).toRingHom.comp
        (Algebra.TensorProduct.includeRight (R := ↥M₀) (A := L_inf) (B := A₀)).toRingHom
    have hψ_target_M₀ : ∀ (a : Fin m) (m₀ : ↥M₀),
        ψ_target a (algebraMap ↥M₀ A₀ m₀) =
          algebraMap ↥M₀ (TensorProduct ↥M₀ L_inf (B₀ a)) m₀ := by
      intro a m₀
      change Θ_inf a ((1 : L_inf) ⊗ₜ[↥M₀] (algebraMap ↥M₀ A₀ m₀)) = _
      have htmul : ((1 : L_inf) ⊗ₜ[↥M₀] (algebraMap ↥M₀ A₀ m₀) : TensorProduct ↥M₀ L_inf A₀) =
          algebraMap L_inf (TensorProduct ↥M₀ L_inf A₀) (algebraMap ↥M₀ L_inf m₀) := by
        have h1 : algebraMap ↥M₀ A₀ m₀ = m₀ • (1 : A₀) := by
          rw [Algebra.smul_def, mul_one]
        rw [h1, ← TensorProduct.smul_tmul, Algebra.smul_def, mul_one]
        rfl
      rw [htmul, (Θ_inf a).commutes]
      exact (IsScalarTower.algebraMap_apply ↥M₀ L_inf (TensorProduct ↥M₀ L_inf (B₀ a)) m₀).symm
    have hRawMor : ∀ a : Fin m,
        ∃ (M_a : IntermediateField F₀ L_inf) (_ : FiniteDimensional F₀ ↥M_a) (hle : M₀ ≤ M_a),
          letI : Algebra ↥M₀ ↥M_a := (IntermediateField.inclusion hle).toRingHom.toAlgebra
          letI : IsScalarTower ↥M₀ ↥M_a L_inf := IsScalarTower.of_algebraMap_eq' rfl
          ∃ (ψ_raw : A₀ →+* TensorProduct ↥M₀ ↥M_a (B₀ a)),
            (Algebra.TensorProduct.map (IsScalarTower.toAlgHom ↥M₀ ↥M_a L_inf)
              (AlgHom.id ↥M₀ (B₀ a))).toRingHom.comp ψ_raw = ψ_target a := by
      intro a
      let _ : Algebra K ↥M₀ := RingHom.toAlgebra ((algebraMap F₀ ↥M₀).comp (algebraMap K F₀))
      let _ : Algebra.Etale K ↥M₀ := hEtM M₀ hFD₀
      let _ : Algebra K A₀ := RingHom.toAlgebra ((algebraMap ↥M₀ A₀).comp (algebraMap K ↥M₀))
      let _ : IsScalarTower K ↥M₀ A₀ := IsScalarTower.of_algebraMap_eq' rfl
      let _ : Algebra.Etale K A₀ := Algebra.Etale.comp K ↥M₀ A₀
      obtain ⟨M_a, hFD_a, hle_a, ψ_raw, -, hcomp_a⟩ :=
        (hDescHom M₀ hFD₀ (B₀ a)).2 A₀ (ψ_target a) (fun c => by
          have hEq : algebraMap K A₀ c =
              algebraMap ↥M₀ A₀ (algebraMap F₀ ↥M₀ (algebraMap K F₀ c)) := rfl
          rw [hEq, hψ_target_M₀ a])
      exact ⟨M_a, hFD_a, hle_a, ψ_raw, hcomp_a⟩
    let M_hom : Fin m → IntermediateField F₀ L_inf := fun a => Classical.choose (hRawMor a)
    have hFD_hom : ∀ a : Fin m, FiniteDimensional F₀ ↥(M_hom a) :=
      fun a => Classical.choose (Classical.choose_spec (hRawMor a))
    obtain ⟨M₁, hFD₁, hle₀₁, hle_a1⟩ := hFinSup M₀ hFD₀ M_hom hFD_hom
    let _ : Algebra ↥M₀ ↥M₁ := (IntermediateField.inclusion hle₀₁).toRingHom.toAlgebra
    let _ : IsScalarTower ↥M₀ ↥M₁ L_inf := IsScalarTower.of_algebraMap_eq' rfl
    let ι_M₁ : ∀ a : Fin m, TensorProduct ↥M₀ ↥M₁ (B₀ a) →ₐ[↥M₀] TensorProduct ↥M₀ L_inf (B₀ a) :=
      fun a => Algebra.TensorProduct.map (IsScalarTower.toAlgHom ↥M₀ ↥M₁ L_inf) (AlgHom.id ↥M₀ (B₀ a))
    have hUpgraded : ∀ a : Fin m,
        ∃ (ψ₁_alg : A₀ →ₐ[↥M₀] TensorProduct ↥M₀ ↥M₁ (B₀ a)),
          ∀ x : A₀, ι_M₁ a (ψ₁_alg x) = ψ_target a x := by
      intro a
      have hle_a : M₀ ≤ M_hom a :=
        Classical.choose (Classical.choose_spec (Classical.choose_spec (hRawMor a)))
      have hSpec_a :=
        Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (hRawMor a)))
      let _ : Algebra ↥M₀ ↥(M_hom a) := (IntermediateField.inclusion hle_a).toRingHom.toAlgebra
      let _ : Algebra ↥(M_hom a) ↥M₁ := (IntermediateField.inclusion (hle_a1 a)).toRingHom.toAlgebra
      let _ : IsScalarTower ↥M₀ ↥(M_hom a) ↥M₁ := IsScalarTower.of_algebraMap_eq' rfl
      let _ : IsScalarTower ↥M₀ ↥(M_hom a) L_inf := IsScalarTower.of_algebraMap_eq' rfl
      obtain ⟨ψ_raw, hcomp_raw⟩ := hSpec_a
      let step_a : TensorProduct ↥M₀ ↥(M_hom a) (B₀ a) →ₐ[↥M₀] TensorProduct ↥M₀ ↥M₁ (B₀ a) :=
        Algebra.TensorProduct.map (IsScalarTower.toAlgHom ↥M₀ ↥(M_hom a) ↥M₁) (AlgHom.id ↥M₀ (B₀ a))
      let ψ₁_ring : A₀ →+* TensorProduct ↥M₀ ↥M₁ (B₀ a) := step_a.toRingHom.comp ψ_raw
      have h_ι_step : (ι_M₁ a).comp step_a =
          Algebra.TensorProduct.map (IsScalarTower.toAlgHom ↥M₀ ↥(M_hom a) L_inf)
            (AlgHom.id ↥M₀ (B₀ a)) := by
        apply Algebra.TensorProduct.ext'
        intro m_a b
        rfl
      have h_ι_apply : ∀ x : A₀, ι_M₁ a (ψ₁_ring x) = ψ_target a x := by
        intro x
        change ((ι_M₁ a).comp step_a) (ψ_raw x) = ψ_target a x
        rw [h_ι_step]
        exact RingHom.congr_fun hcomp_raw x
      have hInj : Function.Injective (ι_M₁ a) := (hDescHom M₀ hFD₀ (B₀ a)).1 M₁ hle₀₁
      refine ⟨{ ψ₁_ring with
                commutes' := fun m₀ => hInj (by
                  change ι_M₁ a (ψ₁_ring (algebraMap ↥M₀ A₀ m₀)) =
                    ι_M₁ a (algebraMap ↥M₀ (TensorProduct ↥M₀ ↥M₁ (B₀ a)) m₀)
                  rw [h_ι_apply, hψ_target_M₀ a, (ι_M₁ a).commutes m₀]) },
        h_ι_apply⟩
    let ψ₁_alg : ∀ a : Fin m, A₀ →ₐ[↥M₀] TensorProduct ↥M₀ ↥M₁ (B₀ a) :=
      fun a => Classical.choose (hUpgraded a)
    have hψ₁_alg : ∀ (a : Fin m) (x : A₀), ι_M₁ a (ψ₁_alg a x) = ψ_target a x :=
      fun a => Classical.choose_spec (hUpgraded a)
    let A₁ : Type u := TensorProduct ↥M₀ ↥M₁ A₀
    let _ : Algebra.Etale ↥M₁ A₁ := Algebra.Etale.baseChange ↥M₀ A₀ ↥M₁
    let B₁ : Fin m → Type u := fun a => TensorProduct ↥M₀ ↥M₁ (B₀ a)
    let _ : ∀ a : Fin m, Algebra.Etale ↥M₁ (B₁ a) :=
      fun a => Algebra.Etale.baseChange ↥M₀ (B₀ a) ↥M₁
    let φ₁ : ∀ a : Fin m, A₁ →ₐ[↥M₁] B₁ a :=
      fun a => Algebra.TensorProduct.lift (Algebra.ofId ↥M₁ (B₁ a)) (ψ₁_alg a)
        (fun _ _ => Commute.all _ _)
    let α_A : TensorProduct ↥M₁ L_inf A₁ ≃ₐ[L_inf] A_inf :=
      (Algebra.TensorProduct.cancelBaseChange ↥M₀ ↥M₁ L_inf L_inf A₀).trans e₀_A
    let α_B : ∀ a : Fin m, TensorProduct ↥M₁ L_inf (B₁ a) ≃ₐ[L_inf] B_inf a :=
      fun a => (Algebra.TensorProduct.cancelBaseChange ↥M₀ ↥M₁ L_inf L_inf (B₀ a)).trans (e₀_B a)
    have hCancelB : ∀ (a : Fin m) (l : L_inf) (z : B₁ a),
        Algebra.TensorProduct.cancelBaseChange ↥M₀ ↥M₁ L_inf L_inf (B₀ a) (l ⊗ₜ[↥M₁] z) =
          l • ι_M₁ a z := by
      intro a l z
      refine TensorProduct.inductionOn z ?_ ?_
      · intro m₁ b
        rw [Algebra.TensorProduct.cancelBaseChange_tmul]
        change (m₁ • l) ⊗ₜ[↥M₀] b =
          l • ((Algebra.TensorProduct.map (IsScalarTower.toAlgHom ↥M₀ ↥M₁ L_inf)
            (AlgHom.id ↥M₀ (B₀ a))) (m₁ ⊗ₜ[↥M₀] b))
        rw [Algebra.TensorProduct.map_tmul, IsScalarTower.toAlgHom_apply, AlgHom.id_apply,
          TensorProduct.smul_tmul', Algebra.smul_def, smul_eq_mul, mul_comm]
      · intro z₁ z₂ ih₁ ih₂
        rw [TensorProduct.tmul_add, map_add, map_add, smul_add, ih₁, ih₂]
    refine ⟨M₁, hFD₁, A₁, inferInstance, inferInstance, inferInstance,
      B₁, inferInstance, inferInstance, inferInstance, φ₁, α_A, α_B, fun a => ?_⟩
    apply AlgHom.ext
    intro w
    refine TensorProduct.inductionOn w ?_ ?_
    · intro l z
      refine TensorProduct.inductionOn z ?_ ?_
      · intro m₁ x
        simp only [AlgHom.comp_apply, Algebra.TensorProduct.map_tmul, AlgHom.id_apply]
        have hφ_tmul : φ₁ a (m₁ ⊗ₜ[↥M₀] x) = m₁ • ψ₁_alg a x := by
          change algebraMap ↥M₁ (B₁ a) m₁ * ψ₁_alg a x = m₁ • ψ₁_alg a x
          exact (Algebra.smul_def m₁ (ψ₁_alg a x)).symm
        have htmul_smul : (l ⊗ₜ[↥M₁] (m₁ • ψ₁_alg a x) : TensorProduct ↥M₁ L_inf (B₁ a)) =
            (m₁ • l) ⊗ₜ[↥M₁] (ψ₁_alg a x) :=
          (TensorProduct.smul_tmul m₁ l (ψ₁_alg a x)).symm
        rw [hφ_tmul, htmul_smul]
        change e₀_B a (Algebra.TensorProduct.cancelBaseChange ↥M₀ ↥M₁ L_inf L_inf (B₀ a)
            ((m₁ • l) ⊗ₜ[↥M₁] ψ₁_alg a x)) =
          ψ_inf a (e₀_A (Algebra.TensorProduct.cancelBaseChange ↥M₀ ↥M₁ L_inf L_inf A₀
            (l ⊗ₜ[↥M₁] (m₁ ⊗ₜ[↥M₀] x))))
        rw [Algebra.TensorProduct.cancelBaseChange_tmul, hCancelB a, hψ₁_alg a x]
        have hTargetEq : e₀_B a (ψ_target a x) = ψ_inf a (e₀_A ((1 : L_inf) ⊗ₜ[↥M₀] x)) := by
          change e₀_B a ((e₀_B a).symm (ψ_inf a (e₀_A ((1 : L_inf) ⊗ₜ[↥M₀] x)))) = _
          exact (e₀_B a).apply_symm_apply _
        rw [map_smul, hTargetEq, ← map_smul, ← map_smul,
          TensorProduct.smul_tmul', smul_eq_mul, mul_one]
      · intro z₁ z₂ ih₁ ih₂
        rw [TensorProduct.tmul_add, map_add, map_add, ih₁, ih₂]
    · intro w₁ w₂ ih₁ ih₂
      rw [map_add, map_add, ih₁, ih₂]

  
  have hFiberProd : ∀ (k : Type u) [Field k]
      (A B_a B_b : Type u) [CommRing A] [CommRing B_a] [CommRing B_b]
      [Algebra k A] [Algebra k B_a] [Algebra k B_b]
      [Algebra.Etale k A] [Algebra.Etale k B_a] [Algebra.Etale k B_b]
      (φ_a : A →ₐ[k] B_a) (φ_b : A →ₐ[k] B_b),
      ∃ (C : Type u) (_ : CommRing C) (_ : Algebra k C) (_ : Algebra.Etale k C)
        (π_fst : B_a →ₐ[k] C) (π_snd : B_b →ₐ[k] C),
        ∀ (E : Type u) [Field E] [Algebra k E],
          let p_a : weilAltCdSpecEtaleObj E (TensorProduct k E B_a) ⟶
              weilAltCdSpecEtaleObj E (TensorProduct k E A) :=
            weilAltCdSpecEtaleMap E (Algebra.TensorProduct.map (AlgHom.id E E) φ_a)
          let p_b : weilAltCdSpecEtaleObj E (TensorProduct k E B_b) ⟶
              weilAltCdSpecEtaleObj E (TensorProduct k E A) :=
            weilAltCdSpecEtaleMap E (Algebra.TensorProduct.map (AlgHom.id E E) φ_b)
          ∃ (e_pb : CategoryTheory.Limits.pullback p_a p_b ≅
              weilAltCdSpecEtaleObj E (TensorProduct k E C)),
            CategoryTheory.Limits.pullback.fst p_a p_b =
              CategoryTheory.CategoryStruct.comp e_pb.hom
                (weilAltCdSpecEtaleMap E (Algebra.TensorProduct.map (AlgHom.id E E) π_fst)) ∧
            CategoryTheory.Limits.pullback.snd p_a p_b =
              CategoryTheory.CategoryStruct.comp e_pb.hom
                (weilAltCdSpecEtaleMap E (Algebra.TensorProduct.map (AlgHom.id E E) π_snd)) := by
    intro k _ A B_a B_b _ _ _ _ _ _ _ _ _ φ_a φ_b
    let _ : Algebra A B_a := φ_a.toRingHom.toAlgebra
    let _ : IsScalarTower k A B_a := IsScalarTower.of_algebraMap_eq (fun x => (φ_a.commutes x).symm)
    let _ : Algebra A B_b := φ_b.toRingHom.toAlgebra
    let _ : IsScalarTower k A B_b := IsScalarTower.of_algebraMap_eq (fun x => (φ_b.commutes x).symm)
    let C : Type u := TensorProduct A B_a B_b
    let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
      @AlgebraicGeometry.Etale
    have hEtABb : Algebra.Etale A B_b := by
      have hEtA : P_et (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A))) :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := P_et)).mpr
          (RingHom.etale_algebraMap.mpr inferInstance)
      have hEtBb : P_et (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k B_b))) :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := P_et)).mpr
          (RingHom.etale_algebraMap.mpr inferInstance)
      have hComp : CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_b.toRingHom))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A))) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k B_b)) := by
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        congr 2
        ext x
        exact φ_b.commutes x
      have hEtφ : P_et (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_b.toRingHom)) :=
        @CategoryTheory.MorphismProperty.of_postcomp _ _ P_et P_et _ _ _ _ _ _ hEtA
          (by rw [hComp]; exact hEtBb)
      exact RingHom.etale_algebraMap.mp
        ((AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := P_et)).mp hEtφ)
    let _ : Algebra.Etale A B_b := hEtABb
    let _ : Algebra.Etale B_a C := Algebra.Etale.baseChange A B_b B_a
    let _ : Algebra.Etale k C := Algebra.Etale.comp k B_a C
    let π_fst : B_a →ₐ[k] C := Algebra.TensorProduct.includeLeft
    let π_snd : B_b →ₐ[k] C := (Algebra.TensorProduct.includeRight : B_b →ₐ[A] C).restrictScalars k
    have hπ_comm : π_fst.comp φ_a = π_snd.comp φ_b := by
      ext x
      change (φ_a x) ⊗ₜ[A] (1 : B_b) = (1 : B_a) ⊗ₜ[A] (φ_b x)
      have h1 : φ_a x = x • (1 : B_a) := by
        rw [Algebra.smul_def, mul_one]; rfl
      have h2 : φ_b x = x • (1 : B_b) := by
        rw [Algebra.smul_def, mul_one]; rfl
      rw [h1, h2, TensorProduct.smul_tmul]
    refine ⟨C, inferInstance, inferInstance, inferInstance, π_fst, π_snd, ?_⟩
    intro E _ _
    let A_E := TensorProduct k E A
    let B_aE := TensorProduct k E B_a
    let B_bE := TensorProduct k E B_b
    let C_E := TensorProduct k E C
    let f_aE : A_E →ₐ[E] B_aE := Algebra.TensorProduct.map (AlgHom.id E E) φ_a
    let f_bE : A_E →ₐ[E] B_bE := Algebra.TensorProduct.map (AlgHom.id E E) φ_b
    let g₁ : B_aE →ₐ[E] C_E := Algebra.TensorProduct.map (AlgHom.id E E) π_fst
    let g₂ : B_bE →ₐ[E] C_E := Algebra.TensorProduct.map (AlgHom.id E E) π_snd
    have hg_comm : g₁.comp f_aE = g₂.comp f_bE := by
      rw [← Algebra.TensorProduct.map_comp, ← Algebra.TensorProduct.map_comp, hπ_comm]
    let _ : Algebra A_E B_aE := f_aE.toRingHom.toAlgebra
    let _ : IsScalarTower E A_E B_aE :=
      IsScalarTower.of_algebraMap_eq (fun x => (f_aE.commutes x).symm)
    let _ : IsScalarTower k A_E B_aE :=
      IsScalarTower.of_algebraMap_eq (fun c => by
        change algebraMap k B_aE c = f_aE (algebraMap k A_E c)
        rw [IsScalarTower.algebraMap_apply k E B_aE c,
          IsScalarTower.algebraMap_apply k E A_E c, f_aE.commutes])
    let _ : Algebra A_E B_bE := f_bE.toRingHom.toAlgebra
    let _ : IsScalarTower E A_E B_bE :=
      IsScalarTower.of_algebraMap_eq (fun x => (f_bE.commutes x).symm)
    let P_E := TensorProduct A_E B_aE B_bE
    let Θ_hom_pkg :
        { Θ_hom : P_E →ₐ[E] C_E //
          ∀ (u : B_aE) (v : B_bE), Θ_hom (u ⊗ₜ[A_E] v) = g₁ u * g₂ v } := by
      letI : Algebra A_E C_E := (g₁.comp f_aE).toRingHom.toAlgebra
      letI : IsScalarTower E A_E C_E :=
        IsScalarTower.of_algebraMap_eq (fun e => ((g₁.comp f_aE).commutes e).symm)
      let g₁_AE : B_aE →ₐ[A_E] C_E :=
        { g₁.toRingHom with commutes' := fun _ => rfl }
      let g₂_AE : B_bE →ₐ[A_E] C_E :=
        { g₂.toRingHom with commutes' := fun z => (AlgHom.congr_fun hg_comm z).symm }
      let Θ_AE : P_E →ₐ[A_E] C_E :=
        Algebra.TensorProduct.lift g₁_AE g₂_AE (fun _ _ => Commute.all _ _)
      exact ⟨Θ_AE.restrictScalars E, fun _ _ => rfl⟩
    let Θ_hom : P_E →ₐ[E] C_E := Θ_hom_pkg.1
    have hΘ_hom_tmul := Θ_hom_pkg.2
    have hΘ_hom_left : Θ_hom.comp (Algebra.TensorProduct.includeLeft : B_aE →ₐ[E] P_E) = g₁ := by
      apply AlgHom.ext
      intro u
      change Θ_hom (u ⊗ₜ[A_E] (1 : B_bE)) = g₁ u
      rw [hΘ_hom_tmul, map_one, mul_one]
    have hΘ_hom_right :
        Θ_hom.comp ((Algebra.TensorProduct.includeRight : B_bE →ₐ[A_E] P_E).restrictScalars E) =
          g₂ := by
      apply AlgHom.ext
      intro v
      change Θ_hom ((1 : B_aE) ⊗ₜ[A_E] v) = g₂ v
      rw [hΘ_hom_tmul, map_one, one_mul]
    let Θ_inv_pkg :
        { Θ_inv : C_E →ₐ[E] P_E //
          ∀ (e : E) (x : B_a) (y : B_b),
            Θ_inv (e ⊗ₜ[k] (x ⊗ₜ[A] y)) =
              (e ⊗ₜ[k] x) ⊗ₜ[A_E] ((1 : E) ⊗ₜ[k] y) } := by
      letI : IsScalarTower k E P_E :=
        IsScalarTower.of_algebraMap_eq (R := k) (S := E) (A := P_E) (fun c => by
          rw [Algebra.TensorProduct.algebraMap_apply (R := A_E) (S := k),
            Algebra.TensorProduct.algebraMap_apply (R := A_E) (S := E),
            ← IsScalarTower.algebraMap_apply k E B_aE c])
      let i_Ba_k : B_a →ₐ[k] P_E :=
        ((Algebra.TensorProduct.includeLeft : B_aE →ₐ[E] P_E).restrictScalars k).comp
          (Algebra.TensorProduct.includeRight : B_a →ₐ[k] B_aE)
      letI : Algebra A P_E := (i_Ba_k.comp φ_a).toRingHom.toAlgebra
      letI : IsScalarTower k A P_E :=
        IsScalarTower.of_algebraMap_eq (R := k) (S := A) (A := P_E)
          (fun c => ((i_Ba_k.comp φ_a).commutes c).symm)
      let i_Ba_A : B_a →ₐ[A] P_E :=
        { i_Ba_k.toRingHom with commutes' := fun _ => rfl }
      let i_Bb_A : B_b →ₐ[A] P_E :=
        { (((Algebra.TensorProduct.includeRight : B_bE →ₐ[A_E] P_E).restrictScalars E).restrictScalars k).comp
            (Algebra.TensorProduct.includeRight : B_b →ₐ[k] B_bE) with
          commutes' := fun a => by
            change (1 : B_aE) ⊗ₜ[A_E] ((1 : E) ⊗ₜ[k] φ_b a) =
              ((1 : E) ⊗ₜ[k] φ_a a) ⊗ₜ[A_E] (1 : B_bE)
            have hb : ((1 : E) ⊗ₜ[k] φ_b a : B_bE) = ((1 : E) ⊗ₜ[k] a : A_E) • (1 : B_bE) := by
              change (1 : E) ⊗ₜ[k] φ_b a = f_bE ((1 : E) ⊗ₜ[k] a) * 1
              rw [mul_one, Algebra.TensorProduct.map_tmul, AlgHom.id_apply]
            have ha : ((1 : E) ⊗ₜ[k] φ_a a : B_aE) = ((1 : E) ⊗ₜ[k] a : A_E) • (1 : B_aE) := by
              change (1 : E) ⊗ₜ[k] φ_a a = f_aE ((1 : E) ⊗ₜ[k] a) * 1
              rw [mul_one, Algebra.TensorProduct.map_tmul, AlgHom.id_apply]
            rw [hb, ha, ← TensorProduct.smul_tmul] }
      let h_C_A : C →ₐ[A] P_E :=
        Algebra.TensorProduct.lift i_Ba_A i_Bb_A (fun _ _ => Commute.all _ _)
      let h_C : C →ₐ[k] P_E := h_C_A.restrictScalars k
      let Θ_inv : C_E →ₐ[E] P_E :=
        Algebra.TensorProduct.lift (Algebra.ofId E P_E) h_C (fun _ _ => Commute.all _ _)
      refine ⟨Θ_inv, fun e x y => ?_⟩
      change algebraMap E P_E e *
          ((((1 : E) ⊗ₜ[k] x) ⊗ₜ[A_E] (1 : B_bE)) *
            ((1 : B_aE) ⊗ₜ[A_E] ((1 : E) ⊗ₜ[k] y))) = _
      rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul, ← Algebra.smul_def,
        TensorProduct.smul_tmul', TensorProduct.smul_tmul', smul_eq_mul, mul_one]
    let Θ_inv : C_E →ₐ[E] P_E := Θ_inv_pkg.1
    have hΘ_inv_tmul := Θ_inv_pkg.2
    have h_hom_inv : Θ_hom.comp Θ_inv = AlgHom.id E C_E := by
      apply AlgHom.ext
      intro w
      refine TensorProduct.inductionOn w ?_ ?_
      · intro e z
        refine TensorProduct.inductionOn z ?_ ?_
        · intro x y
          change Θ_hom (Θ_inv (e ⊗ₜ[k] (x ⊗ₜ[A] y))) = e ⊗ₜ[k] (x ⊗ₜ[A] y)
          rw [hΘ_inv_tmul, hΘ_hom_tmul]
          change (e ⊗ₜ[k] (x ⊗ₜ[A] (1 : B_b))) * ((1 : E) ⊗ₜ[k] ((1 : B_a) ⊗ₜ[A] y)) = _
          rw [Algebra.TensorProduct.tmul_mul_tmul, Algebra.TensorProduct.tmul_mul_tmul,
            mul_one, mul_one, one_mul]
        · intro z₁ z₂ ih₁ ih₂
          rw [TensorProduct.tmul_add, map_add, map_add, ih₁, ih₂]
      · intro w₁ w₂ ih₁ ih₂
        rw [map_add, map_add, ih₁, ih₂]
    have h_inv_hom : Θ_inv.comp Θ_hom = AlgHom.id E P_E := by
      apply AlgHom.ext
      intro w
      refine TensorProduct.inductionOn w ?_ ?_
      · intro u v
        refine TensorProduct.inductionOn u ?_ ?_
        · intro e₁ x
          refine TensorProduct.inductionOn v ?_ ?_
          · intro e₂ y
            change Θ_inv (Θ_hom ((e₁ ⊗ₜ[k] x) ⊗ₜ[A_E] (e₂ ⊗ₜ[k] y))) =
              (e₁ ⊗ₜ[k] x) ⊗ₜ[A_E] (e₂ ⊗ₜ[k] y)
            have hhom_xy : Θ_hom ((e₁ ⊗ₜ[k] x) ⊗ₜ[A_E] (e₂ ⊗ₜ[k] y)) =
                (e₁ * e₂) ⊗ₜ[k] (x ⊗ₜ[A] y) := by
              rw [hΘ_hom_tmul]
              change (e₁ ⊗ₜ[k] (x ⊗ₜ[A] (1 : B_b))) * (e₂ ⊗ₜ[k] ((1 : B_a) ⊗ₜ[A] y)) = _
              rw [Algebra.TensorProduct.tmul_mul_tmul, Algebra.TensorProduct.tmul_mul_tmul,
                mul_one, one_mul]
            rw [hhom_xy, hΘ_inv_tmul]
            have hv_smul : (e₂ ⊗ₜ[k] y : B_bE) =
                ((e₂ ⊗ₜ[k] (1 : A)) : A_E) • ((1 : E) ⊗ₜ[k] y) := by
              change e₂ ⊗ₜ[k] y = f_bE (e₂ ⊗ₜ[k] (1 : A)) * ((1 : E) ⊗ₜ[k] y)
              rw [Algebra.TensorProduct.map_tmul, AlgHom.id_apply, map_one,
                Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
            have hu_smul : (((e₂ ⊗ₜ[k] (1 : A)) : A_E) • (e₁ ⊗ₜ[k] x) : B_aE) =
                (e₁ * e₂) ⊗ₜ[k] x := by
              change f_aE (e₂ ⊗ₜ[k] (1 : A)) * (e₁ ⊗ₜ[k] x) = (e₁ * e₂) ⊗ₜ[k] x
              rw [Algebra.TensorProduct.map_tmul, AlgHom.id_apply, map_one,
                Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_comm]
            rw [hv_smul, ← TensorProduct.smul_tmul, hu_smul]
          · intro v₁ v₂ ih₁ ih₂
            rw [TensorProduct.tmul_add, map_add, map_add, ih₁, ih₂]
        · intro u₁ u₂ ih₁ ih₂
          rw [TensorProduct.add_tmul, map_add, map_add, ih₁, ih₂]
      · intro w₁ w₂ ih₁ ih₂
        rw [map_add, map_add, ih₁, ih₂]
    let p_a : weilAltCdSpecEtaleObj E B_aE ⟶ weilAltCdSpecEtaleObj E A_E :=
      weilAltCdSpecEtaleMap E f_aE
    let p_b : weilAltCdSpecEtaleObj E B_bE ⟶ weilAltCdSpecEtaleObj E A_E :=
      weilAltCdSpecEtaleMap E f_bE
    let q₁ : weilAltCdSpecEtaleObj E C_E ⟶ weilAltCdSpecEtaleObj E B_aE :=
      weilAltCdSpecEtaleMap E g₁
    let q₂ : weilAltCdSpecEtaleObj E C_E ⟶ weilAltCdSpecEtaleObj E B_bE :=
      weilAltCdSpecEtaleMap E g₂
    have hq_comm : CategoryTheory.CategoryStruct.comp q₁ p_a =
        CategoryTheory.CategoryStruct.comp q₂ p_b := by
      rw [← hSpecMapComp E f_aE g₁, ← hSpecMapComp E f_bE g₂, hg_comm]
    let u_lift : weilAltCdSpecEtaleObj E C_E ⟶ CategoryTheory.Limits.pullback p_a p_b :=
      CategoryTheory.Limits.pullback.lift q₁ q₂ hq_comm
    let S_E := AlgebraicGeometry.Spec (CommRingCat.of E)
    let F_fgt := AlgebraicGeometry.Scheme.Etale.forget S_E ⋙ CategoryTheory.Over.forget S_E
    let i_pres : (CategoryTheory.Limits.pullback p_a p_b).left ≅
        CategoryTheory.Limits.pullback p_a.left p_b.left :=
      CategoryTheory.Limits.PreservesPullback.iso F_fgt p_a p_b
    let i_spec : CategoryTheory.Limits.pullback p_a.left p_b.left ≅
        AlgebraicGeometry.Spec (CommRingCat.of P_E) :=
      AlgebraicGeometry.pullbackSpecIso A_E B_aE B_bE
    let i_Θ : AlgebraicGeometry.Spec (CommRingCat.of P_E) ≅
        AlgebraicGeometry.Spec (CommRingCat.of C_E) :=
      { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom Θ_inv.toRingHom)
        inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom Θ_hom.toRingHom)
        hom_inv_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          have h1 : Θ_inv.toRingHom.comp Θ_hom.toRingHom = RingHom.id P_E :=
            congrArg AlgHom.toRingHom h_inv_hom
          rw [h1]
          exact AlgebraicGeometry.Spec.map_id (CommRingCat.of P_E)
        inv_hom_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          have h1 : Θ_hom.toRingHom.comp Θ_inv.toRingHom = RingHom.id C_E :=
            congrArg AlgHom.toRingHom h_hom_inv
          rw [h1]
          exact AlgebraicGeometry.Spec.map_id (CommRingCat.of C_E) }
    let iso_sch : (CategoryTheory.Limits.pullback p_a p_b).left ≅
        (weilAltCdSpecEtaleObj E C_E).left :=
      i_pres ≪≫ i_spec ≪≫ i_Θ
    have h_inv_eq : iso_sch.inv = u_lift.left := by
      rw [← CategoryTheory.cancel_mono i_pres.hom]
      apply CategoryTheory.Limits.pullback.hom_ext
      · have hL : CategoryTheory.CategoryStruct.comp
            (CategoryTheory.CategoryStruct.comp iso_sch.inv i_pres.hom)
            (CategoryTheory.Limits.pullback.fst p_a.left p_b.left) = q₁.left := by
          change CategoryTheory.CategoryStruct.comp
              (CategoryTheory.CategoryStruct.comp i_Θ.inv
                (CategoryTheory.CategoryStruct.comp i_spec.inv i_pres.inv))
              (CategoryTheory.CategoryStruct.comp i_pres.hom
                (CategoryTheory.Limits.pullback.fst p_a.left p_b.left)) = q₁.left
          rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
            i_pres.inv_hom_id_assoc]
          have hspec_fst : CategoryTheory.CategoryStruct.comp i_spec.inv
              (CategoryTheory.Limits.pullback.fst p_a.left p_b.left) =
              AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom) :=
            AlgebraicGeometry.pullbackSpecIso_inv_fst A_E B_aE B_bE
          rw [hspec_fst]
          change CategoryTheory.CategoryStruct.comp
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom Θ_hom.toRingHom))
              (AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom)) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom g₁.toRingHom)
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          exact congrArg (fun f => AlgebraicGeometry.Spec.map (CommRingCat.ofHom f))
            (congrArg AlgHom.toRingHom hΘ_hom_left)
        have hpres_fst : CategoryTheory.CategoryStruct.comp i_pres.hom
            (CategoryTheory.Limits.pullback.fst p_a.left p_b.left) =
            (CategoryTheory.Limits.pullback.fst p_a p_b).left :=
          CategoryTheory.Limits.PreservesPullback.iso_hom_fst F_fgt p_a p_b
        have hR : CategoryTheory.CategoryStruct.comp
            (CategoryTheory.CategoryStruct.comp u_lift.left i_pres.hom)
            (CategoryTheory.Limits.pullback.fst p_a.left p_b.left) = q₁.left :=
          (CategoryTheory.Category.assoc u_lift.left i_pres.hom _).trans
            ((congrArg (CategoryTheory.CategoryStruct.comp u_lift.left) hpres_fst).trans
              (congrArg (fun m => m.left)
                (CategoryTheory.Limits.pullback.lift_fst q₁ q₂ hq_comm)))
        exact hL.trans hR.symm
      · have hL : CategoryTheory.CategoryStruct.comp
            (CategoryTheory.CategoryStruct.comp iso_sch.inv i_pres.hom)
            (CategoryTheory.Limits.pullback.snd p_a.left p_b.left) = q₂.left := by
          change CategoryTheory.CategoryStruct.comp
              (CategoryTheory.CategoryStruct.comp i_Θ.inv
                (CategoryTheory.CategoryStruct.comp i_spec.inv i_pres.inv))
              (CategoryTheory.CategoryStruct.comp i_pres.hom
                (CategoryTheory.Limits.pullback.snd p_a.left p_b.left)) = q₂.left
          rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
            i_pres.inv_hom_id_assoc]
          have hspec_snd : CategoryTheory.CategoryStruct.comp i_spec.inv
              (CategoryTheory.Limits.pullback.snd p_a.left p_b.left) =
              AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom
                  (Algebra.TensorProduct.includeRight : B_bE →ₐ[A_E] P_E).toRingHom) :=
            AlgebraicGeometry.pullbackSpecIso_inv_snd A_E B_aE B_bE
          rw [hspec_snd]
          change CategoryTheory.CategoryStruct.comp
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom Θ_hom.toRingHom))
              (AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom
                  (Algebra.TensorProduct.includeRight : B_bE →ₐ[A_E] P_E).toRingHom)) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom g₂.toRingHom)
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          exact congrArg (fun f => AlgebraicGeometry.Spec.map (CommRingCat.ofHom f))
            (congrArg AlgHom.toRingHom hΘ_hom_right)
        have hpres_snd : CategoryTheory.CategoryStruct.comp i_pres.hom
            (CategoryTheory.Limits.pullback.snd p_a.left p_b.left) =
            (CategoryTheory.Limits.pullback.snd p_a p_b).left :=
          CategoryTheory.Limits.PreservesPullback.iso_hom_snd F_fgt p_a p_b
        have hR : CategoryTheory.CategoryStruct.comp
            (CategoryTheory.CategoryStruct.comp u_lift.left i_pres.hom)
            (CategoryTheory.Limits.pullback.snd p_a.left p_b.left) = q₂.left :=
          (CategoryTheory.Category.assoc u_lift.left i_pres.hom _).trans
            ((congrArg (CategoryTheory.CategoryStruct.comp u_lift.left) hpres_snd).trans
              (congrArg (fun m => m.left)
