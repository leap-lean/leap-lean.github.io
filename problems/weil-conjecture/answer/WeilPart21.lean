            _ = adj_S.homEquiv Aℤ (pf_g.obj N) (f₁ + f₂) ≫ N.obj.map τ_g_iso.inv.op :=
                CategoryTheory.Category.id_comp _
            _ = (adj_S.homEquiv Aℤ (pf_g.obj N) f₁ + adj_S.homEquiv Aℤ (pf_g.obj N) f₂) ≫
                  N.obj.map τ_g_iso.inv.op :=
                congrArg (· ≫ N.obj.map τ_g_iso.inv.op) (hAdjS_add N f₁ f₂)
            _ = (adj_S.homEquiv Aℤ (pf_g.obj N) f₁ ≫ N.obj.map τ_g_iso.inv.op) +
