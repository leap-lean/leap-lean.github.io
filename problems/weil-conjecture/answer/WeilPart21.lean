        ((congrArg (· ≫ (β_iso ℋ).hom) h2).trans
          (CategoryTheory.Category.assoc _ _ _))
    exact (hbwd_homEq 𝒢' ℋ (Q_inf.map f ≫ u)).trans
      (hfwd.trans
        ((congrArg (CategoryTheory.Functor.whiskerLeft G₂.op f.hom ≫ ·)
          (hbwd_homEq 𝒢 ℋ u).symm).trans
          (hbwd_left f (homEq 𝒢 ℋ u)).symm))
  have h_right_nat : ∀ {𝒢 : CategoryTheory.Sheaf S₂.smallEtaleTopology A}
      {ℋ ℋ' : CategoryTheory.Sheaf S₁.smallEtaleTopology A}
      (u : Q_inf.obj 𝒢 ⟶ ℋ) (g : ℋ ⟶ ℋ'),
      homEq 𝒢 ℋ' (u ≫ g) = homEq 𝒢 ℋ u ≫ P_push.map g := by
    intro 𝒢 ℋ ℋ' u g
    apply (bwd 𝒢 ℋ').injective
    have h1 : e₁.toAdjunction.homEquiv (Q_to_aff.obj 𝒢) ℋ' (u ≫ g) =
        e₁.toAdjunction.homEquiv (Q_to_aff.obj 𝒢) ℋ u ≫ e₁.inverse.map g :=
      e₁.toAdjunction.homEquiv_naturality_right u g
    have h2 : adj_lan.homEquiv (G₂.op ⋙ 𝒢.obj) (G₁.op ⋙ ℋ'.obj)
        ((e₁.toAdjunction.homEquiv (Q_to_aff.obj 𝒢) ℋ u).hom ≫
          CategoryTheory.Functor.whiskerLeft G₁.op g.hom) =
        adj_lan.homEquiv (G₂.op ⋙ 𝒢.obj) (G₁.op ⋙ ℋ.obj)
          (e₁.toAdjunction.homEquiv (Q_to_aff.obj 𝒢) ℋ u).hom ≫
          CategoryTheory.Functor.whiskerLeft F_BC.op
            (CategoryTheory.Functor.whiskerLeft G₁.op g.hom) :=
      adj_lan.homEquiv_naturality_right _ _
    have hβ_nat : CategoryTheory.Functor.whiskerLeft F_BC.op
          (CategoryTheory.Functor.whiskerLeft G₁.op g.hom) ≫ (β_iso ℋ').hom =
        (β_iso ℋ).hom ≫ CategoryTheory.Functor.whiskerLeft G₂.op
          (CategoryTheory.Functor.whiskerLeft B_site.op g.hom) := by
      refine CategoryTheory.NatTrans.ext (funext fun X => ?_)
      exact (g.hom.naturality (η_BC.app X.unop).inv.op).symm
    have hfwd : fwd 𝒢 ℋ' (u ≫ g) =
        fwd 𝒢 ℋ u ≫ CategoryTheory.Functor.whiskerLeft G₂.op
          (CategoryTheory.Functor.whiskerLeft B_site.op g.hom) :=
      (congrArg (fun k => adj_lan.homEquiv (G₂.op ⋙ 𝒢.obj) (G₁.op ⋙ ℋ'.obj) k.hom ≫
          (β_iso ℋ').hom) h1).trans
        ((congrArg (· ≫ (β_iso ℋ').hom) h2).trans
          ((CategoryTheory.Category.assoc _ _ _).trans
            ((congrArg (_ ≫ ·) hβ_nat).trans
              (CategoryTheory.Category.assoc _ _ _).symm)))
    exact (hbwd_homEq 𝒢 ℋ' (u ≫ g)).trans
      (hfwd.trans
        ((congrArg (· ≫ CategoryTheory.Functor.whiskerLeft G₂.op
            (CategoryTheory.Functor.whiskerLeft B_site.op g.hom))
          (hbwd_homEq 𝒢 ℋ u).symm).trans
          (hbwd_right (homEq 𝒢 ℋ u) g).symm))
  let adj_Q : Q_inf ⊣ P_push :=
    CategoryTheory.Adjunction.mkOfHomEquiv
      { homEquiv := homEq
        homEquiv_naturality_left_symm := fun f g => by
          apply (homEq _ _).injective
          rw [Equiv.apply_symm_apply, h_left_nat, Equiv.apply_symm_apply]
        homEquiv_naturality_right := fun u g => h_right_nat u g }
  let α_iso : Q_inf ≅ P_inf := CategoryTheory.Adjunction.leftAdjointUniq adj_Q adj
  let Ξ : ∀ 𝒢 : CategoryTheory.Sheaf S₂.smallEtaleTopology A,
      Q_to_aff.obj 𝒢 ≅ e₁.inverse.obj (P_inf.obj 𝒢) :=
    fun 𝒢 => (e₁.unitIso.app (Q_to_aff.obj 𝒢)) ≪≫ e₁.inverse.mapIso (α_iso.app 𝒢)
  let Θ : ∀ (𝒢 : CategoryTheory.Sheaf S₂.smallEtaleTopology A) (Y : S₁.AffineEtale),
      (L_aff.obj (G₂.op ⋙ 𝒢.obj)).obj (Opposite.op Y) ≅
        (P_inf.obj 𝒢).obj.obj (Opposite.op (G₁.obj Y)) :=
    fun 𝒢 Y =>
      ((CategoryTheory.sheafToPresheaf J₁_aff A ⋙
        (CategoryTheory.evaluation (S₁.AffineEtale)ᵒᵖ A).obj (Opposite.op Y)).mapIso (Ξ 𝒢))
  refine ⟨Θ, ?_, ?_⟩
  · intro 𝒢₁ 𝒢₂ φ Y
    have hu1 : Q_to_aff.map φ ≫ (e₁.unitIso.app (Q_to_aff.obj 𝒢₂)).hom =
        (e₁.unitIso.app (Q_to_aff.obj 𝒢₁)).hom ≫ e₁.inverse.map (Q_inf.map φ) :=
      e₁.unitIso.hom.naturality (Q_to_aff.map φ)
    have hα : Q_inf.map φ ≫ (α_iso.app 𝒢₂).hom = (α_iso.app 𝒢₁).hom ≫ P_inf.map φ :=
      α_iso.hom.naturality φ
    have hΞ_nat : Q_to_aff.map φ ≫ (Ξ 𝒢₂).hom = (Ξ 𝒢₁).hom ≫ e₁.inverse.map (P_inf.map φ) := by
      dsimp only [Ξ, Iso.trans_hom, Functor.mapIso_hom]
      rw [← CategoryTheory.Category.assoc, hu1, CategoryTheory.Category.assoc,
        ← e₁.inverse.map_comp, hα, e₁.inverse.map_comp,
        CategoryTheory.Category.assoc]
    exact CategoryTheory.NatTrans.congr_app
      (congrArg (CategoryTheory.sheafToPresheaf J₁_aff A).map hΞ_nat) (Opposite.op Y)
  · intro 𝒢 Y' Y u
    exact (Ξ 𝒢).hom.hom.naturality u.op

theorem weil_alt_cd_pullback_descended_model_eval_colimit (K F₀ L_inf : Type u) [Field K] [Field F₀] [Field L_inf]
