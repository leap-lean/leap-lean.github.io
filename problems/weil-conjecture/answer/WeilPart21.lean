        let Z := s.pt
        let T_Z : Type u := ↥(Z.left.presheaf.obj (Opposite.op ⊤))
        let q_U : Z ⟶ F.obj (weilAltCdSpecEtaleObj E A_E) := s.π.app none ≫ e_UK.hom
        let q_W : Fin (a.len + 1) → (Z ⟶ F.obj (weilAltCdSpecEtaleObj E B_E)) :=
          fun i => s.π.app (some i) ≫ e_WK.hom
        let u_A : A_E →+* T_Z := toRing Z.left q_U.left
        let u_B : Fin (a.len + 1) → (B_E →+* T_Z) := fun i => toRing Z.left (q_W i).left
        have hu_compat : ∀ i : Fin (a.len + 1), (u_B i).comp φ_E.toRingHom = u_A := by
          intro i
          have hterm : (CategoryTheory.Limits.WidePullbackShape.wideCospan U_K
              (fun _ : Fin (a.len + 1) => W_K) (fun _ : Fin (a.len + 1) => f_K)).map
              (CategoryTheory.Limits.WidePullbackShape.Hom.term i) = f_K := by simp
          have hsw : s.π.app (some i) ≫ f_K = s.π.app none := by
            simpa [hterm] using s.w (CategoryTheory.Limits.WidePullbackShape.Hom.term i)
          have hq : q_W i ≫ F.map (weilAltCdSpecEtaleMap E φ_E) = q_U := by
            change (s.π.app (some i) ≫ e_WK.hom) ≫ F.map (weilAltCdSpecEtaleMap E φ_E) =
