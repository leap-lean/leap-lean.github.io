  refine ⟨R, ⟨⟨J₀, inferInstance, ⟨CategoryTheory.Iso.refl _⟩⟩,
      ⟨J₁, inferInstance, ⟨CategoryTheory.Iso.refl _⟩⟩⟩, ?_⟩
  intro F₀ R₀ φ
  obtain ⟨α₀, φ₁, comm_u₀, comm_v₀⟩ :=
    hLift R₀.u₀ R₀.v₀ R₀.h₀ R₀.hSE₀ R₀.hTor_A₀ u₀ v₀ h₀ φ
  obtain ⟨α₁, φ₂, comm_u₁, comm_v₁⟩ :=
    hLift R₀.u₁ R₀.v₁ R₀.h₁ R₀.hSE₁ R₀.hTor_A₁ u₁ v₁ h₁ φ₁
  exact ⟨{ α₀ := α₀
           φ₁ := φ₁
           α₁ := α₁
           φ₂ := φ₂
           comm_u₀ := comm_u₀
           comm_v₀ := comm_v₀
           comm_u₁ := comm_u₁
           comm_v₁ := comm_v₁ }⟩

