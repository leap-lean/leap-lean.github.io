      exact (hκ_B_compat a hle_lift2 (x₁ a)).trans (hx₁ a)
    refine ⟨s, hs, fun s' hs' => ?_⟩
    let d : Q_A := s' - s
    have hd_res : ∀ a : Fin m, q_φ a d = 0 := by
      intro a
      dsimp only [d]
      rw [map_sub, hs' a, hs a, sub_self]
    rcases hκ_A_surj d with ⟨i₀', w₀, hw₀⟩
    have hw₀_ker : ∀ a : Fin m,
        ∃ j : I, ∃ hij : i₀' ≤ j, τ_B a hij (res_φ a i₀' w₀) = 0 := by
      intro a
      apply hκ_B_ker a i₀' (res_φ a i₀' w₀)
      rw [← hκ_φ_nat a i₀' w₀, hw₀, hd_res a]
    let i'_fn : Fin m → I := fun a => Classical.choose (hw₀_ker a)
    have hle'_fn : ∀ a : Fin m, i₀' ≤ i'_fn a :=
      fun a => Classical.choose (Classical.choose_spec (hw₀_ker a))
    have hkill'_fn : ∀ a : Fin m, τ_B a (hle'_fn a) (res_φ a i₀' w₀) = 0 :=
      fun a => Classical.choose_spec (Classical.choose_spec (hw₀_ker a))
    rcases hFinUpper (Finset.univ : Finset (Fin m)) i₀' i'_fn with ⟨i₃, hle_03, h_3_all⟩
    have h_a3 : ∀ a : Fin m, i'_fn a ≤ i₃ := fun a => h_3_all a (Finset.mem_univ a)
    let w₃ : G_A i₃ := τ_A hle_03 w₀
    have hw₃_zero : w₃ = 0 := by
      apply hStage_uniq i₃ w₃ 0
      intro a
      rw [map_zero]
      dsimp only [w₃]
      have h_eq_le : hle_03 = le_trans (hle'_fn a) (h_a3 a) := rfl
      rw [hres_φ_nat a hle_03 w₀, h_eq_le,
        ← hτ_B_comp a (hle'_fn a) (h_a3 a) (res_φ a i₀' w₀), hkill'_fn a, map_zero]
    have hd_zero : d = 0 := by
      rw [← hw₀, ← hκ_A_compat hle_03 w₀]
      change κ_A i₃ w₃ = 0
      rw [hw₃_zero, map_zero]
