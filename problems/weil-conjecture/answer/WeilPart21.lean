    obtain ⟨g, hg⟩ := hΨ_surj (Fgt.obj U).left (kMap U) v hv
    refine ⟨(Φ U).symm g, ?_⟩
    exact (congrArg (Ψ (Fgt.obj U).left (kMap U)) ((Φ U).apply_symm_apply g)).trans hg
  · intro U
    refine ⟨?_, fun s₁ s₂ => ?_⟩
    · exact (congrArg (Ψ (Fgt.obj U).left (kMap U)) (map_zero (Φ U))).trans
        (hΨ_mul (Fgt.obj U).left (kMap U)).1
    · have hadd : ι U (s₁ + s₂) = Ψ (Fgt.obj U).left (kMap U) (Φ U s₁ + Φ U s₂) :=
        congrArg (Ψ (Fgt.obj U).left (kMap U)) (map_add (Φ U) s₁ s₂)
      have hmul := (hΨ_mul (Fgt.obj U).left (kMap U)).2 (Φ U s₁) (Φ U s₂)
      exact ⟨hadd.trans hmul.1, hmul.2⟩
  · intro T' hT' ι' hNat' hNorm'
    funext U s
    apply hSep_open (Fgt.obj U).left (ι' U s) (ι U s)
    intro x
    obtain ⟨W, j, y, hOpen, hy, hs_eq⟩ := hΦ_loc T' hT' U s x
    refine ⟨(Fgt.obj W).left, (Fgt.map j).left, y, hOpen, hy, ?_⟩
    let a := Φ U s x
    let uT' := ((CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT').unit.app AM)
      (ULift.up a)
    have hL₁ : (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop (Fgt.map j).left))
        (ι' U s) = ι' W (((C.obj AM).obj.map (Opposite.op j)) s) := (hNat' j s).symm
    have hL₂ : ι' W (((C.obj AM).obj.map (Opposite.op j)) s) =
        ι' W (((C.obj AM).obj.map (Opposite.op (hT'.from W))) uT') :=
      congrArg (ι' W) hs_eq
    have hL₃ : ι' W (((C.obj AM).obj.map (Opposite.op (hT'.from W))) uT') =
        (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop (Fgt.map (hT'.from W)).left))
          (ι' T' uT') := hNat' (hT'.from W) uT'
    have hL₄ : (CommRingCat.Hom.hom
        (AlgebraicGeometry.Scheme.Hom.appTop (Fgt.map (hT'.from W)).left)) (ι' T' uT') =
        (CommRingCat.Hom.hom
          (AlgebraicGeometry.Scheme.Hom.appTop (Fgt.map (hT'.from W)).left))
          ((kMap T' ((ζ : kˣ) : k)) ^ a.val) :=
      congrArg (CommRingCat.Hom.hom
        (AlgebraicGeometry.Scheme.Hom.appTop (Fgt.map (hT'.from W)).left)) (hNorm' a)
    have hR₄ : (CommRingCat.Hom.hom
        (AlgebraicGeometry.Scheme.Hom.appTop (Fgt.map (hT'.from W)).left))
        ((kMap T' ((ζ : kˣ) : k)) ^ a.val) =
        (CommRingCat.Hom.hom
          (AlgebraicGeometry.Scheme.Hom.appTop (Fgt.map (hT'.from W)).left)) (ι T' uT') :=
      congrArg (CommRingCat.Hom.hom
        (AlgebraicGeometry.Scheme.Hom.appTop (Fgt.map (hT'.from W)).left))
        (hι_norm_any T' hT' a).symm
    have hR₃ : (CommRingCat.Hom.hom
        (AlgebraicGeometry.Scheme.Hom.appTop (Fgt.map (hT'.from W)).left)) (ι T' uT') =
        ι W (((C.obj AM).obj.map (Opposite.op (hT'.from W))) uT') :=
      (hι_nat (hT'.from W) uT').symm
    have hR₂ : ι W (((C.obj AM).obj.map (Opposite.op (hT'.from W))) uT') =
        ι W (((C.obj AM).obj.map (Opposite.op j)) s) :=
      congrArg (ι W) hs_eq.symm
    have hR₁ : ι W (((C.obj AM).obj.map (Opposite.op j)) s) =
        (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop (Fgt.map j).left)) (ι U s) :=
      hι_nat j s
    exact hL₁.trans (hL₂.trans (hL₃.trans (hL₄.trans (hR₄.trans (hR₃.trans (hR₂.trans hR₁))))))

theorem weil_etale_pullback_exact_adjoint {W₁ W₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom W₁ W₂) :
    letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B : CategoryTheory.Functor W₂.Etale W₁.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h
    let J₁ := W₁.smallEtaleTopology
    let J₂ := W₂.smallEtaleTopology
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let C₁ := CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}
    let C₂ := CategoryTheory.constantSheaf J₂ AddCommGrpCat.{u}
    ∃ (hCont : B.IsContinuous J₂ J₁),
      let P_push := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _ B
        AddCommGrpCat.{u} _ J₂ J₁ hCont
      ∃ (P_pull : CategoryTheory.Functor
            (CategoryTheory.Sheaf J₂ AddCommGrpCat.{u})
            (CategoryTheory.Sheaf J₁ AddCommGrpCat.{u}))
        (adj_pull : CategoryTheory.Adjunction P_pull P_push)
        (_ : P_pull.Additive)
        (_ : CategoryTheory.Limits.PreservesFiniteLimits P_pull)
        (_ : CategoryTheory.Limits.PreservesFiniteColimits P_pull)
        (T₁ : W₁.Etale) (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
        (T₂ : W₂.Etale) (hT₂ : CategoryTheory.Limits.IsTerminal T₂)
        (ιℤ : Quiver.Hom (C₁.obj Aℤ) (P_pull.obj (C₂.obj Aℤ))),
        let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
        let adj₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
        let τ : Quiver.Hom (B.obj T₂) T₁ := hT₁.from (B.obj T₂)
        let πℤ : Quiver.Hom (P_pull.obj (C₂.obj Aℤ)) (C₁.obj Aℤ) :=
          (adj_pull.homEquiv (C₂.obj Aℤ) (C₁.obj Aℤ)).symm
            ((adj₂.homEquiv Aℤ (P_push.obj (C₁.obj Aℤ))).symm
              (CategoryTheory.CategoryStruct.comp (adj₁.unit.app Aℤ)
                ((C₁.obj Aℤ).obj.map (Opposite.op τ))))
        CategoryTheory.CategoryStruct.comp ιℤ πℤ =
          CategoryTheory.CategoryStruct.id (C₁.obj Aℤ) ∧
        CategoryTheory.CategoryStruct.comp πℤ ιℤ =
          CategoryTheory.CategoryStruct.id (P_pull.obj (C₂.obj Aℤ)) ∧
        (∀ (I : CategoryTheory.Sheaf J₁ AddCommGrpCat.{u}),
          CategoryTheory.Injective I → CategoryTheory.Injective (P_push.obj I)) ∧
        (∀ (T₂' : W₂.Etale),
          CategoryTheory.Limits.IsTerminal T₂' →
          Nonempty (CategoryTheory.Limits.IsTerminal (B.obj T₂'))) :=
by
  letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let B : CategoryTheory.Functor W₂.Etale W₁.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h
  let J₁ := W₁.smallEtaleTopology
  let J₂ := W₂.smallEtaleTopology
  let A := AddCommGrpCat.{u}
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let C₁ := CategoryTheory.constantSheaf J₁ A
  let C₂ := CategoryTheory.constantSheaf J₂ A
  let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
    @AlgebraicGeometry.Etale

  
  have mem_smallEtale_iff : ∀ (S : AlgebraicGeometry.Scheme.{u}) (U : S.Etale)
      (R : CategoryTheory.Sieve U),
      R ∈ S.smallEtaleTopology U ↔
        ∀ (x : ↥U.left), ∃ (Y : S.Etale) (f : Y ⟶ U) (y : ↥Y.left),
          R.arrows f ∧ AlgebraicGeometry.Etale f.left ∧ f.left y = x := by
    intro S U R
    have hEq :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) S (le_refl P_et)
    exact (Eq.to_iff (congrArg (fun J : CategoryTheory.GrothendieckTopology S.Etale => R ∈ J U)
      hEq)).trans
      (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) (S := S) U R)

  
  let mkTermObj : ∀ S : AlgebraicGeometry.Scheme.{u}, S.Etale :=
    fun S => CategoryTheory.MorphismProperty.Over.mk ⊤
      (CategoryTheory.CategoryStruct.id S)
      (inferInstance : AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.id S))
  let mkIsTerminal : ∀ S : AlgebraicGeometry.Scheme.{u},
      CategoryTheory.Limits.IsTerminal (mkTermObj S) :=
    fun S => CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun U => CategoryTheory.MorphismProperty.Over.homMk U.hom
        (CategoryTheory.Category.comp_id U.hom) trivial)
      (fun U g => CategoryTheory.MorphismProperty.Comma.Hom.ext
        ((CategoryTheory.Category.comp_id g.left).symm.trans
          (CategoryTheory.MorphismProperty.Over.w g))
        (Subsingleton.elim _ _))

  let Fgt₁ : CategoryTheory.Functor W₁.Etale (CategoryTheory.Over W₁) :=
    AlgebraicGeometry.Scheme.Etale.forget W₁
  let Fgt₂ : CategoryTheory.Functor W₂.Etale (CategoryTheory.Over W₂) :=
    AlgebraicGeometry.Scheme.Etale.forget W₂
  have hLimOverPb : CategoryTheory.Limits.PreservesFiniteLimits (CategoryTheory.Over.pullback h) := by
    have := (CategoryTheory.Over.mapPullbackAdj h).rightAdjoint_preservesLimits
    infer_instance
  have hLimComp : CategoryTheory.Limits.PreservesFiniteLimits (B.comp Fgt₁) := by
    have hcomp : CategoryTheory.Limits.PreservesFiniteLimits
        (Fgt₂.comp (CategoryTheory.Over.pullback h)) :=
      CategoryTheory.Limits.comp_preservesFiniteLimits Fgt₂ (CategoryTheory.Over.pullback h)
    exact hcomp
  have hLimB : CategoryTheory.Limits.PreservesFiniteLimits B :=
    CategoryTheory.Limits.preservesFiniteLimits_of_reflects_of_preserves B Fgt₁

  
  have hFlatB : CategoryTheory.RepresentablyFlat B :=
    CategoryTheory.flat_of_preservesFiniteLimits B
  have hCompPresB : CategoryTheory.CompatiblePreserving J₁ B :=
    CategoryTheory.compatiblePreservingOfFlat J₁ B
  have hCovPresB : CategoryTheory.CoverPreserving J₂ J₁ B := by
    constructor
    intro U R hR
    have hR_pts := (mem_smallEtale_iff W₂ U R).mp hR
    refine (mem_smallEtale_iff W₁ (B.obj U) (CategoryTheory.Sieve.functorPushforward B R)).mpr ?_
    intro x
    let fstU : CategoryTheory.Limits.pullback U.hom h ⟶ U.left :=
      CategoryTheory.Limits.pullback.fst U.hom h
    let sndU : CategoryTheory.Limits.pullback U.hom h ⟶ W₁ :=
      CategoryTheory.Limits.pullback.snd U.hom h
    obtain ⟨Y, f, y', hfR, _, hy'⟩ := hR_pts (fstU x)
    obtain ⟨q, hq_fst, hq_snd⟩ :=
      AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y' x hy'
    have hcomm_ψ : CategoryTheory.CategoryStruct.comp
        (CategoryTheory.Limits.pullback.fst f.left fstU) Y.hom =
        CategoryTheory.CategoryStruct.comp
          (CategoryTheory.CategoryStruct.comp
            (CategoryTheory.Limits.pullback.snd f.left fstU) sndU) h :=
      (congrArg (CategoryTheory.CategoryStruct.comp (CategoryTheory.Limits.pullback.fst f.left fstU))
        (CategoryTheory.MorphismProperty.Over.w f).symm).trans
        ((CategoryTheory.Category.assoc (CategoryTheory.Limits.pullback.fst f.left fstU)
          f.left U.hom).symm.trans
          ((congrArg (fun k => CategoryTheory.CategoryStruct.comp k U.hom)
            (CategoryTheory.Limits.pullback.condition (f := f.left) (g := fstU))).trans
            ((CategoryTheory.Category.assoc (CategoryTheory.Limits.pullback.snd f.left fstU)
              fstU U.hom).trans
              ((congrArg (CategoryTheory.CategoryStruct.comp
                  (CategoryTheory.Limits.pullback.snd f.left fstU))
                (CategoryTheory.Limits.pullback.condition (f := U.hom) (g := h))).trans
                (CategoryTheory.Category.assoc
                  (CategoryTheory.Limits.pullback.snd f.left fstU) sndU h).symm))))
    let ψ : CategoryTheory.Limits.pullback f.left fstU ⟶ CategoryTheory.Limits.pullback Y.hom h :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst f.left fstU)
        (CategoryTheory.CategoryStruct.comp
          (CategoryTheory.Limits.pullback.snd f.left fstU) sndU)
        hcomm_ψ
    let map_f : CategoryTheory.Limits.pullback Y.hom h ⟶ CategoryTheory.Limits.pullback U.hom h :=
      (B.map f).left
    have hmap_fst : CategoryTheory.CategoryStruct.comp map_f fstU =
        CategoryTheory.CategoryStruct.comp
          (CategoryTheory.Limits.pullback.fst Y.hom h) f.left :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hmap_snd : CategoryTheory.CategoryStruct.comp map_f sndU =
        CategoryTheory.CategoryStruct.comp
          (CategoryTheory.Limits.pullback.snd Y.hom h)
          (CategoryTheory.CategoryStruct.id W₁) :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hψ_comp : CategoryTheory.CategoryStruct.comp ψ map_f =
        CategoryTheory.Limits.pullback.snd f.left fstU :=
      CategoryTheory.Limits.pullback.hom_ext
        ((CategoryTheory.Category.assoc ψ map_f fstU).trans
          ((congrArg (CategoryTheory.CategoryStruct.comp ψ) hmap_fst).trans
            ((CategoryTheory.Category.assoc ψ
              (CategoryTheory.Limits.pullback.fst Y.hom h) f.left).symm.trans
              ((congrArg (fun k => CategoryTheory.CategoryStruct.comp k f.left)
                (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                (CategoryTheory.Limits.pullback.condition (f := f.left) (g := fstU))))))
        ((CategoryTheory.Category.assoc ψ map_f sndU).trans
          ((congrArg (CategoryTheory.CategoryStruct.comp ψ)
            (hmap_snd.trans (CategoryTheory.Category.comp_id _))).trans
            (CategoryTheory.Limits.pullback.lift_snd _ _ _)))
    have hEt_Bf : AlgebraicGeometry.Etale (B.map f).left :=
      CategoryTheory.MorphismProperty.of_postcomp P_et
        (B.map f).left (B.obj U).hom (B.obj U).prop
        ((CategoryTheory.MorphismProperty.Over.w (B.map f)).symm ▸ (B.obj Y).prop)
    refine ⟨B.obj Y, B.map f, ψ q,
      CategoryTheory.Sieve.image_mem_functorPushforward B R hfR, hEt_Bf, ?_⟩
    have hcomp_app : (CategoryTheory.CategoryStruct.comp ψ map_f) q = map_f (ψ q) := by
      simp
      rfl
    exact hcomp_app.symm.trans
      ((congrArg (fun k : CategoryTheory.Limits.pullback f.left fstU ⟶
          CategoryTheory.Limits.pullback U.hom h => k q) hψ_comp).trans hq_snd)
  have hCont : B.IsContinuous J₂ J₁ :=
    CategoryTheory.Functor.isContinuous_of_coverPreserving hCompPresB hCovPresB

  
  let embAff : ∀ S : AlgebraicGeometry.Scheme.{u},
      CategoryTheory.Functor S.AffineEtale S.Etale :=
    fun S =>
      { obj := fun X => CategoryTheory.MorphismProperty.Over.mk ⊤ X.hom X.prop
        map := fun α => CategoryTheory.MorphismProperty.Over.homMk
          (AlgebraicGeometry.Scheme.Spec.map α.left) α.w trivial
        map_id := fun X => CategoryTheory.MorphismProperty.Comma.Hom.ext
          (AlgebraicGeometry.Scheme.Spec.map_id X.left) (Subsingleton.elim _ _)
        map_comp := fun α β => CategoryTheory.MorphismProperty.Comma.Hom.ext
          (AlgebraicGeometry.Scheme.Spec.map_comp α.left β.left) (Subsingleton.elim _ _) }

  let mkStagePair : ∀ (S : AlgebraicGeometry.Scheme.{u}) (I₀ : Type u),
      (I₀ → S.Etale) → ℕ → Σ (α : Type u), (α → S.Etale) :=
    fun S I₀ f₀ n =>
      Nat.rec
        ⟨(ULift.{u} Unit ⊕ CategoryTheory.SmallModel.{u} S.AffineEtale) ⊕ I₀,
          Sum.elim
            (Sum.elim
              (fun _ => mkTermObj S)
              (fun m => (embAff S).obj ((CategoryTheory.equivSmallModel.{u} S.AffineEtale).inverse.obj m)))
            f₀⟩
        (fun _ P =>
          ⟨P.1 ⊕ (Σ (a : P.1) (b : P.1) (c : P.1) (_ : P.2 a ⟶ P.2 c), (P.2 b ⟶ P.2 c)),
            Sum.elim P.2 (fun s => CategoryTheory.Limits.pullback s.2.2.2.1 s.2.2.2.2)⟩)
        n

  have hSubsiteProps : ∀ (S : AlgebraicGeometry.Scheme.{u}) (I₀ : Type u) (f₀ : I₀ → S.Etale),
      let SP := mkStagePair S I₀ f₀
      let RawD : Type u := Σ n : ℕ, (SP n).1
      let evalD : RawD → S.Etale := fun p => (SP p.1).2 p.2
      let D : Type u := CategoryTheory.InducedCategory S.Etale evalD
      let G : CategoryTheory.Functor D S.Etale := CategoryTheory.inducedFunctor evalD
      CategoryTheory.Limits.HasFiniteLimits D ∧
      CategoryTheory.Limits.PreservesFiniteLimits G ∧
      G.IsCoverDense S.smallEtaleTopology := by
    intro S I₀ f₀ SP RawD evalD D G
    let d_top : D := ⟨0, Sum.inl (Sum.inl ⟨()⟩)⟩
    have hTd : CategoryTheory.Limits.IsTerminal d_top :=
      CategoryTheory.Limits.IsTerminal.ofUniqueHom
        (fun d => G.preimage ((mkIsTerminal S).from (G.obj d)))
        (fun d g => G.map_injective ((mkIsTerminal S).hom_ext (G.map g) _))
    have hHasTermD : CategoryTheory.Limits.HasTerminal D :=
      CategoryTheory.Limits.IsTerminal.hasTerminal hTd
    have hPresTermG : CategoryTheory.Limits.PreservesLimitsOfShape
        (CategoryTheory.Discrete PEmpty.{1}) G := by
      constructor
      intro K
      have hEmptyIso : K ≅ CategoryTheory.Functor.empty.{0} D :=
        CategoryTheory.Functor.emptyExt _ _
      let c_emp : CategoryTheory.Limits.Cone (CategoryTheory.Functor.empty.{0} D) :=
        CategoryTheory.Limits.asEmptyCone d_top
      have hc_emp_G : CategoryTheory.Limits.IsLimit (G.mapCone c_emp) :=
        { lift := fun s => (mkIsTerminal S).from s.pt
          fac := fun _ j => j.as.elim
          uniq := fun s m _ => (mkIsTerminal S).hom_ext m ((mkIsTerminal S).from s.pt) }
      have : CategoryTheory.Limits.PreservesLimit (CategoryTheory.Functor.empty.{0} D) G :=
        CategoryTheory.Limits.preservesLimit_of_preserves_limit_cone hTd hc_emp_G
      exact CategoryTheory.Limits.preservesLimit_of_iso_diagram G hEmptyIso.symm
    let shiftStage : ∀ (n k : ℕ), (SP n).1 → (SP (n + k)).1 :=
      fun n k =>
        Nat.rec
          (motive := fun k => (SP n).1 → (SP (n + k)).1)
          (fun x => x)
          (fun _ ih x => Sum.inl (ih x))
          k
    have ev_shiftStage : ∀ (n k : ℕ) (x : (SP n).1),
        (SP (n + k)).2 (shiftStage n k x) = (SP n).2 x := by
      intro n k
      induction k with
      | zero => intro x; rfl
      | succ k ih => intro x; exact ih x
    have liftTo : ∀ {N : ℕ} (d : D), (∃ k : ℕ, d.1 + k = N) →
        ∃ y : (SP N).1, Nonempty ((SP N).2 y ≅ G.obj d) := by
      rintro _ ⟨n, x⟩ ⟨k, rfl⟩
      exact ⟨shiftStage n k x, ⟨CategoryTheory.eqToIso (ev_shiftStage n k x)⟩⟩
    have hClosedPb : ∀ {d₁ d₂ d₃ : D} (p₁ : d₁ ⟶ d₃) (p₂ : d₂ ⟶ d₃),
        ∃ d_pb : D,
          Nonempty (G.obj d_pb ≅ CategoryTheory.Limits.pullback (G.map p₁) (G.map p₂)) := by
      intro d₁ d₂ d₃ p₁ p₂
      let N : ℕ := d₁.1 + d₂.1 + d₃.1
      obtain ⟨y₁, ⟨e₁⟩⟩ := liftTo (N := N) d₁ ⟨d₂.1 + d₃.1, by omega⟩
      obtain ⟨y₂, ⟨e₂⟩⟩ := liftTo (N := N) d₂ ⟨d₁.1 + d₃.1, by omega⟩
      obtain ⟨y₃, ⟨e₃⟩⟩ := liftTo (N := N) d₃ ⟨d₁.1 + d₂.1, by omega⟩
      let f₁ : (SP N).2 y₁ ⟶ (SP N).2 y₃ :=
        CategoryTheory.CategoryStruct.comp e₁.hom
          (CategoryTheory.CategoryStruct.comp (G.map p₁) e₃.inv)
      let f₂ : (SP N).2 y₂ ⟶ (SP N).2 y₃ :=
        CategoryTheory.CategoryStruct.comp e₂.hom
          (CategoryTheory.CategoryStruct.comp (G.map p₂) e₃.inv)
      let d_pb : D := ⟨N + 1, Sum.inr ⟨y₁, y₂, y₃, f₁, f₂⟩⟩
      have hcomm_hom : CategoryTheory.CategoryStruct.comp
          (CategoryTheory.CategoryStruct.comp (CategoryTheory.Limits.pullback.fst f₁ f₂) e₁.hom)
          (G.map p₁) =
          CategoryTheory.CategoryStruct.comp
            (CategoryTheory.CategoryStruct.comp (CategoryTheory.Limits.pullback.snd f₁ f₂) e₂.hom)
            (G.map p₂) := by
        apply (CategoryTheory.cancel_mono e₃.inv).mp
        simp only [CategoryTheory.Category.assoc]
        exact CategoryTheory.Limits.pullback.condition (f := f₁) (g := f₂)
      have hcomm_inv : CategoryTheory.CategoryStruct.comp
          (CategoryTheory.CategoryStruct.comp
            (CategoryTheory.Limits.pullback.fst (G.map p₁) (G.map p₂)) e₁.inv) f₁ =
          CategoryTheory.CategoryStruct.comp
            (CategoryTheory.CategoryStruct.comp
              (CategoryTheory.Limits.pullback.snd (G.map p₁) (G.map p₂)) e₂.inv) f₂ := by
        dsimp [f₁, f₂]
        simp only [CategoryTheory.Category.assoc]
        simp only [← CategoryTheory.Category.assoc e₁.inv e₁.hom _, e₁.inv_hom_id,
          CategoryTheory.Category.id_comp,
          ← CategoryTheory.Category.assoc e₂.inv e₂.hom _, e₂.inv_hom_id]
        rw [← CategoryTheory.Category.assoc _ (G.map p₁) e₃.inv,
          ← CategoryTheory.Category.assoc _ (G.map p₂) e₃.inv,
          CategoryTheory.Limits.pullback.condition]
      let iso_pb : CategoryTheory.Limits.pullback f₁ f₂ ≅
          CategoryTheory.Limits.pullback (G.map p₁) (G.map p₂) :=
        { hom := CategoryTheory.Limits.pullback.lift
            (CategoryTheory.CategoryStruct.comp (CategoryTheory.Limits.pullback.fst f₁ f₂) e₁.hom)
            (CategoryTheory.CategoryStruct.comp (CategoryTheory.Limits.pullback.snd f₁ f₂) e₂.hom)
            hcomm_hom
          inv := CategoryTheory.Limits.pullback.lift
            (CategoryTheory.CategoryStruct.comp
              (CategoryTheory.Limits.pullback.fst (G.map p₁) (G.map p₂)) e₁.inv)
            (CategoryTheory.CategoryStruct.comp
              (CategoryTheory.Limits.pullback.snd (G.map p₁) (G.map p₂)) e₂.inv)
            hcomm_inv
          hom_inv_id := by
            apply CategoryTheory.Limits.pullback.hom_ext
            · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
                ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
                CategoryTheory.Category.assoc, e₁.hom_inv_id]
              exact (CategoryTheory.Category.comp_id _).trans
                (CategoryTheory.Category.id_comp _).symm
            · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
                ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
                CategoryTheory.Category.assoc, e₂.hom_inv_id]
              exact (CategoryTheory.Category.comp_id _).trans
                (CategoryTheory.Category.id_comp _).symm
          inv_hom_id := by
            apply CategoryTheory.Limits.pullback.hom_ext
            · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
                ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
                CategoryTheory.Category.assoc, e₁.inv_hom_id]
              exact (CategoryTheory.Category.comp_id _).trans
                (CategoryTheory.Category.id_comp _).symm
            · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
                ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
                CategoryTheory.Category.assoc, e₂.inv_hom_id]
              exact (CategoryTheory.Category.comp_id _).trans
                (CategoryTheory.Category.id_comp _).symm }
      exact ⟨d_pb, ⟨iso_pb⟩⟩
    have hCospanBoth : ∀ {d₁ d₂ d₃ : D} (p₁ : d₁ ⟶ d₃) (p₂ : d₂ ⟶ d₃),
        CategoryTheory.Limits.HasLimit (CategoryTheory.Limits.cospan p₁ p₂) ∧
        CategoryTheory.Limits.PreservesLimit (CategoryTheory.Limits.cospan p₁ p₂) G := by
      intro d₁ d₂ d₃ p₁ p₂
      obtain ⟨d_pb, ⟨e_pb⟩⟩ := hClosedPb p₁ p₂
      let fst_D : d_pb ⟶ d₁ :=
        G.preimage (CategoryTheory.CategoryStruct.comp e_pb.hom
          (CategoryTheory.Limits.pullback.fst (G.map p₁) (G.map p₂)))
      let snd_D : d_pb ⟶ d₂ :=
        G.preimage (CategoryTheory.CategoryStruct.comp e_pb.hom
          (CategoryTheory.Limits.pullback.snd (G.map p₁) (G.map p₂)))
      have hcond_D : CategoryTheory.CategoryStruct.comp fst_D p₁ =
          CategoryTheory.CategoryStruct.comp snd_D p₂ := by
        apply G.map_injective
        simp only [G.map_comp, fst_D, snd_D, CategoryTheory.Functor.map_preimage,
          CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition]
      let cone_D : CategoryTheory.Limits.PullbackCone p₁ p₂ :=
        CategoryTheory.Limits.PullbackCone.mk fst_D snd_D hcond_D
      let lift_pb : ∀ s : CategoryTheory.Limits.Cone ((CategoryTheory.Limits.cospan p₁ p₂).comp G),
          s.pt ⟶ CategoryTheory.Limits.pullback (G.map p₁) (G.map p₂) :=
        fun s =>
          CategoryTheory.Limits.pullback.lift
            (s.π.app CategoryTheory.Limits.WalkingCospan.left)
            (s.π.app CategoryTheory.Limits.WalkingCospan.right)
            ((s.w CategoryTheory.Limits.WalkingCospan.Hom.inl).trans
              (s.w CategoryTheory.Limits.WalkingCospan.Hom.inr).symm)
      let lift_G₀ : ∀ s : CategoryTheory.Limits.Cone ((CategoryTheory.Limits.cospan p₁ p₂).comp G),
          s.pt ⟶ G.obj d_pb :=
        fun s => CategoryTheory.CategoryStruct.comp (lift_pb s) e_pb.inv
      let lift_G : ∀ s : CategoryTheory.Limits.Cone ((CategoryTheory.Limits.cospan p₁ p₂).comp G),
          s.pt ⟶ (G.mapCone cone_D).pt := lift_G₀
      have hfac_left₀ : ∀ s : CategoryTheory.Limits.Cone ((CategoryTheory.Limits.cospan p₁ p₂).comp G),
          CategoryTheory.CategoryStruct.comp (lift_G₀ s) (G.map fst_D) =
            s.π.app CategoryTheory.Limits.WalkingCospan.left :=
        fun s =>
          (congrArg (CategoryTheory.CategoryStruct.comp (lift_G₀ s))
            (G.map_preimage _)).trans
            ((CategoryTheory.Category.assoc (lift_pb s) e_pb.inv _).trans
              ((congrArg (CategoryTheory.CategoryStruct.comp (lift_pb s))
                ((CategoryTheory.Category.assoc e_pb.inv e_pb.hom _).symm.trans
                  ((congrArg (fun k => CategoryTheory.CategoryStruct.comp k _)
                    e_pb.inv_hom_id).trans
                    (CategoryTheory.Category.id_comp _)))).trans
                (CategoryTheory.Limits.pullback.lift_fst _ _ _)))
      have hfac_right₀ : ∀ s : CategoryTheory.Limits.Cone ((CategoryTheory.Limits.cospan p₁ p₂).comp G),
          CategoryTheory.CategoryStruct.comp (lift_G₀ s) (G.map snd_D) =
            s.π.app CategoryTheory.Limits.WalkingCospan.right :=
        fun s =>
          (congrArg (CategoryTheory.CategoryStruct.comp (lift_G₀ s))
            (G.map_preimage _)).trans
            ((CategoryTheory.Category.assoc (lift_pb s) e_pb.inv _).trans
              ((congrArg (CategoryTheory.CategoryStruct.comp (lift_pb s))
                ((CategoryTheory.Category.assoc e_pb.inv e_pb.hom _).symm.trans
                  ((congrArg (fun k => CategoryTheory.CategoryStruct.comp k _)
                    e_pb.inv_hom_id).trans
                    (CategoryTheory.Category.id_comp _)))).trans
                (CategoryTheory.Limits.pullback.lift_snd _ _ _)))
      have hfac_left : ∀ s : CategoryTheory.Limits.Cone ((CategoryTheory.Limits.cospan p₁ p₂).comp G),
          CategoryTheory.CategoryStruct.comp (lift_G s)
            ((G.mapCone cone_D).π.app CategoryTheory.Limits.WalkingCospan.left) =
            s.π.app CategoryTheory.Limits.WalkingCospan.left := hfac_left₀
      have hfac_right : ∀ s : CategoryTheory.Limits.Cone ((CategoryTheory.Limits.cospan p₁ p₂).comp G),
          CategoryTheory.CategoryStruct.comp (lift_G s)
            ((G.mapCone cone_D).π.app CategoryTheory.Limits.WalkingCospan.right) =
            s.π.app CategoryTheory.Limits.WalkingCospan.right := hfac_right₀
      have hLim_G : CategoryTheory.Limits.IsLimit (G.mapCone cone_D) :=
        { lift := lift_G
          fac := fun s j => by
            rcases j with _ | (_ | _)
            · exact (congrArg (CategoryTheory.CategoryStruct.comp (lift_G s))
                ((G.mapCone cone_D).w CategoryTheory.Limits.WalkingCospan.Hom.inl)).symm.trans
                ((CategoryTheory.Category.assoc (lift_G s)
                  ((G.mapCone cone_D).π.app CategoryTheory.Limits.WalkingCospan.left)
                  (((CategoryTheory.Limits.cospan p₁ p₂).comp G).map
                    CategoryTheory.Limits.WalkingCospan.Hom.inl)).symm.trans
                  ((congrArg (fun k => CategoryTheory.CategoryStruct.comp k
                      (((CategoryTheory.Limits.cospan p₁ p₂).comp G).map
                        CategoryTheory.Limits.WalkingCospan.Hom.inl))
                    (hfac_left s)).trans
                    (s.w CategoryTheory.Limits.WalkingCospan.Hom.inl)))
            · exact hfac_left s
            · exact hfac_right s
          uniq := fun s m hm => by
            let m₀ : s.pt ⟶ G.obj d_pb := m
            change m₀ = CategoryTheory.CategoryStruct.comp (lift_pb s) e_pb.inv
            apply (CategoryTheory.cancel_mono e_pb.hom).mp
            have h_rhs : CategoryTheory.CategoryStruct.comp
                (CategoryTheory.CategoryStruct.comp (lift_pb s) e_pb.inv) e_pb.hom =
                lift_pb s :=
              (CategoryTheory.Category.assoc (lift_pb s) e_pb.inv e_pb.hom).trans
                ((congrArg (CategoryTheory.CategoryStruct.comp (lift_pb s)) e_pb.inv_hom_id).trans
                  (CategoryTheory.Category.comp_id (lift_pb s)))
            have h_lhs : CategoryTheory.CategoryStruct.comp m₀ e_pb.hom = lift_pb s :=
              CategoryTheory.Limits.pullback.hom_ext
                ((CategoryTheory.Category.assoc m₀ e_pb.hom _).trans
                  ((congrArg (CategoryTheory.CategoryStruct.comp m₀)
                    (G.map_preimage _).symm).trans
                    ((hm CategoryTheory.Limits.WalkingCospan.left).trans
                      (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm)))
                ((CategoryTheory.Category.assoc m₀ e_pb.hom _).trans
                  ((congrArg (CategoryTheory.CategoryStruct.comp m₀)
                    (G.map_preimage _).symm).trans
                    ((hm CategoryTheory.Limits.WalkingCospan.right).trans
                      (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm)))
            exact h_lhs.trans h_rhs.symm }
      have hLim_D : CategoryTheory.Limits.IsLimit cone_D :=
        CategoryTheory.Limits.isLimitOfReflects G hLim_G
      exact ⟨⟨⟨⟨cone_D, hLim_D⟩⟩⟩,
        CategoryTheory.Limits.preservesLimit_of_preserves_limit_cone hLim_D hLim_G⟩
    have hHasPbD : CategoryTheory.Limits.HasPullbacks D := by
      constructor
      intro K
      have := (hCospanBoth (K.map CategoryTheory.Limits.WalkingCospan.Hom.inl)
        (K.map CategoryTheory.Limits.WalkingCospan.Hom.inr)).1
      exact CategoryTheory.Limits.hasLimit_of_iso (CategoryTheory.Limits.diagramIsoCospan K).symm
    have hPresPbG : CategoryTheory.Limits.PreservesLimitsOfShape
        CategoryTheory.Limits.WalkingCospan G := by
      constructor
      intro K
      have := (hCospanBoth (K.map CategoryTheory.Limits.WalkingCospan.Hom.inl)
        (K.map CategoryTheory.Limits.WalkingCospan.Hom.inr)).2
      exact CategoryTheory.Limits.preservesLimit_of_iso_diagram G
        (CategoryTheory.Limits.diagramIsoCospan K).symm
    have hFinLimD : CategoryTheory.Limits.HasFiniteLimits D :=
      CategoryTheory.Limits.hasFiniteLimits_of_hasTerminal_and_pullbacks
    have hPresFinLimG : CategoryTheory.Limits.PreservesFiniteLimits G :=
      CategoryTheory.Limits.preservesFiniteLimits_of_preservesTerminal_and_pullbacks G
    have hCovDenseG : G.IsCoverDense S.smallEtaleTopology := by
      constructor
      intro U
      refine (mem_smallEtale_iff S U (CategoryTheory.Sieve.coverByImage G U)).mpr ?_
      intro x
      have hx_top : x ∈ (⊤ : U.left.Opens) := trivial
      obtain ⟨V, hV_aff, hxV, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hx_top
      let φ_V : AlgebraicGeometry.Spec (U.left.presheaf.obj (Opposite.op V)) ⟶ U.left :=
        hV_aff.fromSpec
      have hx_range : x ∈ Set.range ⇑φ_V := by
        rw [hV_aff.range_fromSpec]
        exact hxV
      obtain ⟨z₀, hz₀⟩ := hx_range
      have hEt_comp : AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.comp φ_V U.hom) :=
        CategoryTheory.MorphismProperty.comp_mem P_et φ_V U.hom
          inferInstance U.prop
      let A_x : S.AffineEtale :=
        @AlgebraicGeometry.Scheme.AffineEtale.mk S _
          (CategoryTheory.CategoryStruct.comp φ_V U.hom) hEt_comp
      let e_sm := CategoryTheory.equivSmallModel.{u} S.AffineEtale
      let m_x : CategoryTheory.SmallModel.{u} S.AffineEtale := e_sm.functor.obj A_x
      let d_x : D := ⟨0, Sum.inl (Sum.inr m_x)⟩
      let iso_et : G.obj d_x ≅ (embAff S).obj A_x :=
        ((embAff S).mapIso (e_sm.unitIso.app A_x)).symm
      let FgtSch : CategoryTheory.Functor S.Etale AlgebraicGeometry.Scheme.{u} :=
        (AlgebraicGeometry.Scheme.Etale.forget S).comp (CategoryTheory.Over.forget S)
      let iso_sch : (G.obj d_x).left ≅ ((embAff S).obj A_x).left :=
        FgtSch.mapIso iso_et
      let v_V : (embAff S).obj A_x ⟶ U :=
        CategoryTheory.MorphismProperty.Over.homMk φ_V rfl trivial
      let g_x : G.obj d_x ⟶ U := CategoryTheory.CategoryStruct.comp iso_et.hom v_V
      let w₀ : ↥(G.obj d_x).left := iso_sch.inv z₀
      have hEt_gx : AlgebraicGeometry.Etale g_x.left :=
        CategoryTheory.MorphismProperty.of_postcomp P_et
          g_x.left U.hom U.prop
          ((CategoryTheory.MorphismProperty.Over.w g_x).symm ▸ (G.obj d_x).prop)
      refine ⟨G.obj d_x, g_x, w₀, CategoryTheory.Presieve.in_coverByImage G g_x, hEt_gx, ?_⟩
      have hcomp_iso : (CategoryTheory.CategoryStruct.comp iso_sch.inv iso_sch.hom) z₀ =
          iso_sch.hom w₀ := by
        dsimp [w₀]
        rfl
      have hid_z₀ : (CategoryTheory.CategoryStruct.id (((embAff S).obj A_x).left)) z₀ = z₀ := by
        simp
        rfl
      have hw₀ : iso_sch.hom w₀ = z₀ :=
        hcomp_iso.symm.trans
          ((congrArg (fun k : ((embAff S).obj A_x).left ⟶ ((embAff S).obj A_x).left => k z₀)
            iso_sch.inv_hom_id).trans hid_z₀)
      have hcomp_gx : g_x.left w₀ = φ_V (iso_sch.hom w₀) := by
        change (CategoryTheory.CategoryStruct.comp iso_sch.hom φ_V) w₀ = φ_V (iso_sch.hom w₀)
        simp
        rfl
      exact hcomp_gx.trans ((congrArg (⇑φ_V) hw₀).trans hz₀)
    exact ⟨hFinLimD, hPresFinLimG, hCovDenseG⟩

  
  let SP₂ := mkStagePair W₂ PEmpty.{u + 1} PEmpty.elim
