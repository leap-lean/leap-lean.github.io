        (L_aff.obj P).map (mkSigma M₀ B₀ M hFD hle).op) := by
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, ← (L_aff.obj P).map_comp,
        ← op_comp, hsig_comm, op_comp, (L_aff.obj P).map_comp,
        ← CategoryTheory.Category.assoc (((B_aff.op.lanUnit).app _).app _),
        hlan_nat, ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
        ← P.map_comp, ← hunit_inv, P.map_comp]
