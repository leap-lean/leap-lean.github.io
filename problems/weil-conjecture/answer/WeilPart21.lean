    let P'L := (weilAltCdSitePullback h'L).sheafPullback AddCommGrpCat.{u}
      S'.smallEtaleTopology S_L.smallEtaleTopology
    have : P₀'.Additive := hAdd₀'
    have : CategoryTheory.Limits.PreservesFiniteLimits P₀' := hLim₀'
    have : CategoryTheory.Limits.PreservesFiniteColimits P₀' := hColim₀'
    obtain ⟨η', hη', β', hβ'_eq⟩ := hLift_β
