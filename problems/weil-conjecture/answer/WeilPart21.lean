        (L_aff.obj P).map (B_aff.map (eq_K.functor.map u_M)).op =
      P.map (eq_K.inverse.map (eq_K.functor.map u_M)).op ≫
        ((B_aff.op.lanUnit).app (W_inv.obj P)).app (Opposite.op (eq_K.functor.obj X_MB)) :=
      (((B_aff.op.lanUnit).app (W_inv.obj P)).naturality (eq_K.functor.map u_M).op).symm
    have htot : (P.map (eq_K.unitIso.app X_MA).inv.op ≫
        ((B_aff.op.lanUnit).app (W_inv.obj P)).app (Opposite.op (eq_K.functor.obj X_MA)) ≫
        (L_aff.obj P).map (mkSigma M₀ A₀ M hFD hle).op) ≫ (L_aff.obj P).map u_L.op =
      P.map u_M.op ≫ (P.map (eq_K.unitIso.app X_MB).inv.op ≫
