      letI := hCont₂
      CategoryTheory.Limits.PreservesFiniteColimits
        ((weilC1AffEtBaseChangeSite E₁ E₂).sheafPushforwardContinuous
          AddCommGrpCat.{u} (weilC1AffEtTop E₁) (weilC1AffEtTop E₂)) := by
    intro hLift
    let _ := hCont₂
    let R := weilC1AffEtBaseChangeSite E₁ E₂
    let P_push := R.sheafPushforwardContinuous AddCommGrpCat.{u} (weilC1AffEtTop E₁) (weilC1AffEtTop E₂)
    let S₁ := CategoryTheory.sheafToPresheaf (weilC1AffEtTop E₁) AddCommGrpCat.{u}
    let S₂ := CategoryTheory.sheafToPresheaf (weilC1AffEtTop E₂) AddCommGrpCat.{u}
    let W_R := (CategoryTheory.Functor.whiskeringLeft _ _ AddCommGrpCat.{u}).obj R.op
    have hCompLim : CategoryTheory.Limits.PreservesFiniteLimits (P_push.comp S₁) :=
      CategoryTheory.Limits.comp_preservesFiniteLimits S₂ W_R
    have _ : CategoryTheory.Limits.PreservesFiniteLimits P_push :=
      @CategoryTheory.Limits.preservesFiniteLimits_of_reflects_of_preserves _ _ _ _ _ _
