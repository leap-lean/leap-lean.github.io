        (k.app (Opposite.op V)) a) h_unit
    have h_mate_eq : ∀ {U₁ : Z₁.Etale} (hU₁ : CategoryTheory.Limits.IsTerminal U₁)
        {U₂_et : Z₂.Etale} (hU₂ : CategoryTheory.Limits.IsTerminal U₂_et),
        let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hU₁
        let adj₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hU₂
