    let A_inf : Type u := ↥Y.left.unop
    let _ : Algebra L_inf A_inf :=
      ((AlgebraicGeometry.Scheme.Spec.preimage Y.hom).unop.hom).toAlgebra
    let _ : Algebra.Etale L_inf A_inf := (mkCoord Y).1
    let i_Y : G_L.obj Y ≅ weilAltCdSpecEtaleObj L_inf A_inf :=
      Classical.choose (mkCoord Y).2
    have hi_Y : i_Y.hom.left = CategoryTheory.CategoryStruct.id (G_L.obj Y).left :=
      Classical.choose_spec (mkCoord Y).2
    let B_inf : Fin m → Type u := fun a => ↥(V a).left.unop
    let _ : ∀ a : Fin m, Algebra L_inf (B_inf a) :=
      fun a => ((AlgebraicGeometry.Scheme.Spec.preimage (V a).hom).unop.hom).toAlgebra
    let _ : ∀ a : Fin m, Algebra.Etale L_inf (B_inf a) := fun a => (mkCoord (V a)).1
    let i_V : ∀ a : Fin m, G_L.obj (V a) ≅ weilAltCdSpecEtaleObj L_inf (B_inf a) :=
      fun a => Classical.choose (mkCoord (V a)).2
    have hi_V : ∀ a : Fin m,
        (i_V a).hom.left = CategoryTheory.CategoryStruct.id (G_L.obj (V a)).left :=
      fun a => Classical.choose_spec (mkCoord (V a)).2
    let ψ_inf : ∀ a : Fin m, A_inf →ₐ[L_inf] B_inf a := fun a =>
      { toRingHom := ((p a).left.unop).hom
        commutes' := fun c => by
          have hpre : CategoryTheory.CategoryStruct.comp (p a).left
              (AlgebraicGeometry.Scheme.Spec.preimage Y.hom) =
              AlgebraicGeometry.Scheme.Spec.preimage (V a).hom :=
            AlgebraicGeometry.Scheme.Spec.map_injective
              ((AlgebraicGeometry.Scheme.Spec.map_comp _ _).trans
                ((congrArg
                  (CategoryTheory.CategoryStruct.comp
                    (AlgebraicGeometry.Scheme.Spec.map (p a).left))
                  (AlgebraicGeometry.Scheme.Spec.map_preimage Y.hom)).trans
                  ((p a).w.trans
                    (AlgebraicGeometry.Scheme.Spec.map_preimage (V a).hom).symm)))
          exact congrArg (fun k => k.unop.hom c) hpre }
    refine ⟨m, V, p, A_inf, inferInstance, inferInstance, inferInstance,
      B_inf, inferInstance, inferInstance, inferInstance, ψ_inf,
      hSubR, hMemAff, ⟨i_Y, i_V, fun a => ?_⟩, fun x => ?_⟩
    · apply CategoryTheory.MorphismProperty.Comma.Hom.ext
      · exact (congrArg (CategoryTheory.CategoryStruct.comp (G_L.map (p a)).left) hi_Y).trans
          ((CategoryTheory.Category.comp_id _).trans
            ((CategoryTheory.Category.id_comp _).symm.trans
              (congrArg
                (fun u => CategoryTheory.CategoryStruct.comp u
                  (weilAltCdSpecEtaleMap L_inf (ψ_inf a)).left)
