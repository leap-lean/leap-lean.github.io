          (adj₁.homEquiv Aℤ 𝒢).symm)

  have hΦ_nat : ∀ {𝒢 𝒢' : CategoryTheory.Sheaf J₁ A}
      (ψ : Quiver.Hom (P_pull.obj (C₂.obj Aℤ)) 𝒢) (g : Quiver.Hom 𝒢 𝒢'),
      Φ 𝒢' (CategoryTheory.CategoryStruct.comp ψ g) =
        CategoryTheory.CategoryStruct.comp (Φ 𝒢 ψ) g := by
    intro 𝒢 𝒢' ψ g
    have h1 := adj_pull.homEquiv_naturality_right ψ g
    have h2 := adj₂.homEquiv_naturality_right
      (adj_pull.homEquiv (C₂.obj Aℤ) 𝒢 ψ) (P_push.map g)
    have h3 := adj₁.homEquiv_naturality_right_symm
      (adj₂.homEquiv Aℤ (P_push.obj 𝒢) (adj_pull.homEquiv (C₂.obj Aℤ) 𝒢 ψ)) g
    exact ((congrArg (fun x => (adj₁.homEquiv Aℤ 𝒢').symm
        (adj₂.homEquiv Aℤ (P_push.obj 𝒢') x)) h1).trans
      (congrArg (adj₁.homEquiv Aℤ 𝒢').symm h2)).trans h3

  let πℤ : Quiver.Hom (P_pull.obj (C₂.obj Aℤ)) (C₁.obj Aℤ) :=
    (adj_pull.homEquiv (C₂.obj Aℤ) (C₁.obj Aℤ)).symm
      ((adj₂.homEquiv Aℤ (P_push.obj (C₁.obj Aℤ))).symm
        (CategoryTheory.CategoryStruct.comp (adj₁.unit.app Aℤ)
          ((C₁.obj Aℤ).obj.map (Opposite.op τ))))

  have hΦ_π : Φ (C₁.obj Aℤ) πℤ = CategoryTheory.CategoryStruct.id (C₁.obj Aℤ) := by
    have hstep1 : adj₂.homEquiv Aℤ (P_push.obj (C₁.obj Aℤ))
        (adj_pull.homEquiv (C₂.obj Aℤ) (C₁.obj Aℤ) πℤ) = adj₁.unit.app Aℤ := by
      dsimp [πℤ]
      rw [Equiv.apply_symm_apply, Equiv.apply_symm_apply]
      exact h_unit_τ
    have hunit_id : adj₁.homEquiv Aℤ (C₁.obj Aℤ) (CategoryTheory.CategoryStruct.id (C₁.obj Aℤ)) =
        adj₁.unit.app Aℤ :=
      (adj₁.homEquiv_unit Aℤ (C₁.obj Aℤ) (CategoryTheory.CategoryStruct.id (C₁.obj Aℤ))).trans
        ((congrArg (CategoryTheory.CategoryStruct.comp (adj₁.unit.app Aℤ))
          (((CategoryTheory.sheafSections J₁ A).obj (Opposite.op T₁)).map_id (C₁.obj Aℤ))).trans
          (CategoryTheory.Category.comp_id (adj₁.unit.app Aℤ)))
    change (adj₁.homEquiv Aℤ (C₁.obj Aℤ)).symm
      (adj₂.homEquiv Aℤ (P_push.obj (C₁.obj Aℤ))
        (adj_pull.homEquiv (C₂.obj Aℤ) (C₁.obj Aℤ) πℤ)) = _
    rw [hstep1, ← hunit_id, Equiv.symm_apply_apply]

  let Q := P_pull.obj (C₂.obj Aℤ)
  let ιℤ : Quiver.Hom (C₁.obj Aℤ) Q := Φ Q (CategoryTheory.CategoryStruct.id Q)

  have hιπ : CategoryTheory.CategoryStruct.comp ιℤ πℤ =
      CategoryTheory.CategoryStruct.id (C₁.obj Aℤ) :=
    (hΦ_nat (CategoryTheory.CategoryStruct.id Q) πℤ).symm.trans
      ((congrArg (Φ (C₁.obj Aℤ)) (CategoryTheory.Category.id_comp πℤ)).trans hΦ_π)

  have hπι : CategoryTheory.CategoryStruct.comp πℤ ιℤ =
      CategoryTheory.CategoryStruct.id Q :=
    (Φ Q).injective
      ((hΦ_nat πℤ ιℤ).trans
        ((congrArg (fun x => CategoryTheory.CategoryStruct.comp x ιℤ) hΦ_π).trans
          (CategoryTheory.Category.id_comp ιℤ)))

  exact ⟨hCont, P_pull, adj_pull, hAdd, hLim, hColim, T₁, hT₁, T₂, hT₂, ιℤ,
    hιπ, hπι, hInj,
    fun T₂' hT₂' => ⟨CategoryTheory.Limits.IsTerminal.isTerminalObj B T₂' hT₂'⟩⟩

