    letI : Algebra.Etale K ↥M₂ := hEtM M₂ hFD₂
    letI : Algebra ↥M₀ ↥M₁ := (IntermediateField.inclusion hle₁).toRingHom.toAlgebra
    letI : Algebra ↥M₀ ↥M₂ :=
      (IntermediateField.inclusion (le_trans hle₁ hle₁₂)).toRingHom.toAlgebra
    letI : Algebra ↥M₁ ↥M₂ := (IntermediateField.inclusion hle₁₂).toRingHom.toAlgebra
    letI : IsScalarTower ↥M₀ ↥M₁ ↥M₂ := IsScalarTower.of_algebraMap_eq' rfl
    let W_M₁ := F_M₁.obj (weilAltCdSpecEtaleObj ↥M₁ (TensorProduct ↥M₀ ↥M₁ A₀))
    let W_M₂ := F_M₂.obj (weilAltCdSpecEtaleObj ↥M₂ (TensorProduct ↥M₀ ↥M₂ A₀))
