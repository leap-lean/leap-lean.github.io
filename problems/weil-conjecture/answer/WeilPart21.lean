      have hSES : S.ShortExact :=
        CategoryTheory.ShortComplex.ShortExact.mk'
          (CategoryTheory.ShortComplex.exact_cokernel i_emb) inferInstance inferInstance
      have hSES_G : (S.map P_push).ShortExact := hSES.map_of_exact P_push
      have _ : CategoryTheory.Injective (P_push.obj ℐ) := adj.map_injective ℐ inferInstance
      rcases k with _ | k'
      · refine subsingleton_of_forall_eq 0 (fun z => ?_)
        have hz_i : z.comp (CategoryTheory.Abelian.Ext.mk₀ (P_push.map i_emb))
            (Nat.add_zero 1) = 0 :=
          CategoryTheory.Abelian.Ext.eq_zero_of_injective _
        obtain ⟨q₁, hq₁⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ ℤ₁ hSES_G z hz_i
            (Nat.zero_add 1)
        have hq₁_ext : (e₀ 𝒬 q₁).comp hSES.extClass (Nat.zero_add 1) = 0 :=
          @Subsingleton.elim (ℱ.H 1) hSub_succ _ 0
        obtain ⟨y₂, hy₂⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ ℤ₂ hSES (e₀ 𝒬 q₁)
            (Nat.zero_add 1) hq₁_ext
        let y₁ : (P_push.obj ℐ).H 0 := (e₀ ℐ).symm y₂
        have hq₁_eq : q₁ = y₁.comp (CategoryTheory.Abelian.Ext.mk₀ (P_push.map p_cok))
            (Nat.add_zero 0) := by
          apply (e₀ 𝒬).injective
          rw [he₀_nat p_cok y₁, Equiv.apply_symm_apply, hy₂]
        rw [← hq₁, hq₁_eq]
        change (y₁.comp (CategoryTheory.Abelian.Ext.mk₀ (S.map P_push).g)
          (Nat.add_zero 0)).comp hSES_G.extClass (Nat.zero_add 1) = 0
        rw [CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero 0)
            (Nat.zero_add 1) (Nat.zero_add 1),
          hSES_G.comp_extClass,
          CategoryTheory.Abelian.Ext.comp_zero]
      · have hSubQ : Subsingleton (𝒬.H (k' + 1)) := by
          refine subsingleton_of_forall_eq 0 (fun u => ?_)
          have hu_ext : u.comp hSES.extClass (rfl : (k' + 1) + 1 = k' + 2) = 0 :=
            @Subsingleton.elim (ℱ.H (k' + 2)) hSub_succ _ 0
          obtain ⟨v, hv⟩ :=
            CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ ℤ₂ hSES u
              (rfl : (k' + 1) + 1 = k' + 2) hu_ext
          have hv0 : v = 0 := CategoryTheory.Abelian.Ext.eq_zero_of_injective v
          rw [← hv, hv0]
          exact CategoryTheory.Abelian.Ext.zero_comp ℤ₂ (k' + 1) _ (k' + 1)
            (Nat.add_zero (k' + 1))
        have hSubGQ : Subsingleton ((P_push.obj 𝒬).H (k' + 1)) := ih 𝒬 hSubQ
        refine subsingleton_of_forall_eq 0 (fun z => ?_)
        have hz_i : z.comp (CategoryTheory.Abelian.Ext.mk₀ (P_push.map i_emb))
            (Nat.add_zero (k' + 2)) = 0 :=
          CategoryTheory.Abelian.Ext.eq_zero_of_injective _
        obtain ⟨w, hw⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ ℤ₁ hSES_G z hz_i
            (rfl : (k' + 1) + 1 = k' + 2)
        have hw0 : w = 0 := @Subsingleton.elim _ hSubGQ w 0
        rw [← hw, hw0]
        exact CategoryTheory.Abelian.Ext.zero_comp ℤ₁ (k' + 1) _ (k' + 2)
          (rfl : (k' + 1) + 1 = k' + 2)
  exact hMain r ℋ hSub

