theorem weil_c1_affEt_kummer_short_exact (hGm : ∀ (F : Type u) [Field F],
      CategoryTheory.Presheaf.IsSheaf (weilC1AffEtTop F) (weilC1AffEtGmPresheaf F))
    (K : Type u) [Field K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hRoots : ∃ ζ : K, ζ ^ ℓ = 1 ∧ ζ ≠ 1) :
    let Gm_K := weilC1AffEtGmSheaf K (hGm K)
    let Const_ℓ : CategoryTheory.Sheaf (weilC1AffEtTop K) AddCommGrpCat.{u} :=
      (CategoryTheory.constantSheaf (weilC1AffEtTop K) AddCommGrpCat.{u}).obj
        (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ)))
    ∃ (ι_kum : Quiver.Hom Const_ℓ Gm_K)
      (h0 : CategoryTheory.CategoryStruct.comp ι_kum
        (ℓ • CategoryTheory.CategoryStruct.id Gm_K) = 0),
      (CategoryTheory.ShortComplex.mk ι_kum
        (ℓ • CategoryTheory.CategoryStruct.id Gm_K) h0).ShortExact :=
by
  intro Gm_K Const_ℓ
  have hPrime : Nat.Prime ℓ := Fact.out
  have hℓ_ne : ℓ ≠ 0 := hPrime.ne_zero
  have h1_lt : 1 < ℓ := hPrime.one_lt
  have : NeZero ℓ := ⟨hℓ_ne⟩
  obtain ⟨ζ, hζ_pow, hζ_ne1⟩ := hRoots

  
  
  
  have hℓ : (ℓ : K) ≠ 0 := by
    intro hcast0
    have hdvd : ringChar K ∣ ℓ := ringChar.dvd hcast0
    rcases CharP.char_is_prime_or_zero K (ringChar K) with hp | hz
    · rcases (Nat.dvd_prime hPrime).mp hdvd with h1 | heq
      · exact hp.ne_one h1
      · have : CharP K ℓ := ringChar.of_eq heq
        have hsub : (ζ - 1) ^ ℓ = 0 := by
          rw [sub_pow_char, hζ_pow, one_pow, sub_self]
        have hsub0 : ζ - 1 = 0 := by
          by_contra hne
          exact pow_ne_zero ℓ hne hsub
        exact hζ_ne1 (sub_eq_zero.mp hsub0)
    · rw [hz, zero_dvd_iff] at hdvd
      exact hℓ_ne hdvd

  have hζ_prim : IsPrimitiveRoot ζ ℓ := by
    rw [IsPrimitiveRoot.iff_orderOf]
    rcases (Nat.dvd_prime hPrime).mp (orderOf_dvd_of_pow_eq_one hζ_pow) with h1 | hord
    · exact False.elim (hζ_ne1 (orderOf_eq_one_iff.mp h1))
    · exact hord

  let ν : ZMod ℓ → K := fun j => ζ ^ j.val
  have hν_zero : ν 0 = 1 := by simp [ν]
  have hν_add : ∀ i j : ZMod ℓ, ν (i + j) = ν i * ν j := by
    intro i j
    have hdiv := Nat.div_add_mod (i.val + j.val) ℓ
    dsimp [ν]
    rw [ZMod.val_add]
    calc
      ζ ^ ((i.val + j.val) % ℓ)
        = (ζ ^ ℓ) ^ ((i.val + j.val) / ℓ) * ζ ^ ((i.val + j.val) % ℓ) := by
            rw [hζ_pow, one_pow, one_mul]
      _ = ζ ^ (ℓ * ((i.val + j.val) / ℓ) + (i.val + j.val) % ℓ) := by
            rw [pow_add, pow_mul]
      _ = ζ ^ (i.val + j.val) := by rw [hdiv]
      _ = ζ ^ i.val * ζ ^ j.val := pow_add _ _ _
  have hν_pow : ∀ j : ZMod ℓ, (ν j) ^ ℓ = 1 := by
    intro j
    dsimp [ν]
    rw [← pow_mul, mul_comm, pow_mul, hζ_pow, one_pow]
  have hν_inj : Function.Injective ν := by
    intro i j hij
    exact ZMod.val_injective ℓ (hζ_prim.pow_inj (ZMod.val_lt i) (ZMod.val_lt j) hij)

  have hIdem : ∀ (R : Type u) [CommRing R] (σ : K →+* R) (v : R),
      v ^ ℓ = 1 →
      ∃ e : ZMod ℓ → R,
        (∑ j : ZMod ℓ, e j = 1) ∧
        (∀ i j : ZMod ℓ, i ≠ j → e i * e j = 0) ∧
        (∀ j : ZMod ℓ, e j * e j = e j) ∧
        (∑ j : ZMod ℓ, σ (ν j) * e j = v) := by
    let S_univ : Finset (ZMod ℓ) := Finset.univ
    have hInjOn : Set.InjOn ν ↑S_univ := hν_inj.injOn
    let L : ZMod ℓ → Polynomial K := fun j => Lagrange.basis S_univ ν j
    let M : Polynomial K := ∏ m ∈ S_univ, (Polynomial.X - Polynomial.C (ν m))
    have hM_dvd : ∀ Q : Polynomial K,
        (∀ m : ZMod ℓ, Polynomial.eval (ν m) Q = 0) → M ∣ Q := by
      intro Q hQ
      have hfin : ∀ (A : Finset (ZMod ℓ)),
          (∀ m ∈ A, Polynomial.eval (ν m) Q = 0) →
          (∏ m ∈ A, (Polynomial.X - Polynomial.C (ν m))) ∣ Q := by
        intro A
        induction A using Finset.induction_on with
        | empty =>
          intro _
          rw [Finset.prod_empty]
          exact one_dvd Q
        | @insert a A ha ih =>
          intro hQA
          obtain ⟨R_Q, hRQ⟩ := ih (fun m hm => hQA m (Finset.mem_insert_of_mem hm))
          have heval_a : Polynomial.eval (ν a) Q = 0 := hQA a (Finset.mem_insert_self a A)
          rw [hRQ, Polynomial.eval_mul, Polynomial.eval_prod] at heval_a
          have hprod_ne :
              (∏ m ∈ A, Polynomial.eval (ν a) (Polynomial.X - Polynomial.C (ν m))) ≠ 0 := by
            rw [Finset.prod_ne_zero_iff]
            intro m hm
            rw [Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C, sub_ne_zero]
            intro h_eq
            exact ha (hν_inj h_eq ▸ hm)
          have hRQ_root : Polynomial.IsRoot R_Q (ν a) :=
            (mul_eq_zero.mp heval_a).resolve_left hprod_ne
          obtain ⟨S_Q, hSQ⟩ := Polynomial.dvd_iff_isRoot.mpr hRQ_root
          refine ⟨S_Q, ?_⟩
          rw [Finset.prod_insert ha, hRQ, hSQ]
          ring
      exact hfin S_univ (fun m _ => hQ m)
    have hM_eq : M = Polynomial.X ^ ℓ - 1 := by
      obtain ⟨K_poly, hK⟩ := hM_dvd (Polynomial.X ^ ℓ - 1) (fun m => by
        rw [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, Polynomial.eval_one,
          hν_pow m, sub_self])
      have hM_monic : M.Monic :=
        Polynomial.monic_prod_of_monic S_univ _ (fun m _ => Polynomial.monic_X_sub_C (ν m))
      have hX_monic : (Polynomial.X ^ ℓ - 1 : Polynomial K).Monic := by
        simpa using Polynomial.monic_X_pow_sub_C (1 : K) hℓ_ne
      have hM_deg : M.natDegree = ℓ := by
        dsimp [M]
        rw [Polynomial.natDegree_prod_of_monic S_univ _
          (fun m _ => Polynomial.monic_X_sub_C (ν m))]
        have h1 : ∀ m ∈ S_univ, (Polynomial.X - Polynomial.C (ν m)).natDegree = 1 :=
          fun m _ => Polynomial.natDegree_X_sub_C (ν m)
        rw [Finset.sum_congr rfl h1, Finset.sum_const, smul_eq_mul, mul_one]
        exact ZMod.card ℓ
      have hX_deg : (Polynomial.X ^ ℓ - 1 : Polynomial K).natDegree = ℓ := by
        simpa using (Polynomial.natDegree_X_pow_sub_C (R := K) (n := ℓ) (r := 1))
      have hK_ne : K_poly ≠ 0 := by
        intro hK0
        rw [hK0, mul_zero] at hK
        exact hX_monic.ne_zero hK
      have hdeg_sum : M.natDegree + K_poly.natDegree = ℓ := by
        rw [← Polynomial.natDegree_mul hM_monic.ne_zero hK_ne, ← hK, hX_deg]
      have hK_deg : K_poly.natDegree = 0 := by omega
      have hK_lead : K_poly.leadingCoeff = 1 := by
        have hlead := congrArg Polynomial.leadingCoeff hK
        rw [hX_monic.leadingCoeff, Polynomial.leadingCoeff_mul, hM_monic.leadingCoeff,
          one_mul] at hlead
        exact hlead.symm
      have hK_one : K_poly = 1 := by
        have hc0 : K_poly.coeff 0 = 1 := by
          rw [← hK_deg]
          exact hK_lead
        rw [Polynomial.eq_C_of_natDegree_eq_zero hK_deg, hc0, Polynomial.C_1]
      rw [hK, hK_one, mul_one]
    have hXpow_dvd : ∀ Q : Polynomial K,
        (∀ m : ZMod ℓ, Polynomial.eval (ν m) Q = 0) → (Polynomial.X ^ ℓ - 1) ∣ Q :=
      fun Q hQ => hM_eq ▸ hM_dvd Q hQ
    have heval_L_sum : ∀ m : ZMod ℓ, Polynomial.eval (ν m) (∑ j ∈ S_univ, L j) = 1 := by
      intro m
      rw [Polynomial.eval_finsetSum, Finset.sum_eq_single m]
      · exact Lagrange.eval_basis_self hInjOn (Finset.mem_univ m)
      · intro j _ hjm
        exact Lagrange.eval_basis_of_ne hjm (Finset.mem_univ m)
      · intro hm
        exact False.elim (hm (Finset.mem_univ m))
    have hdvd_sum : (Polynomial.X ^ ℓ - 1) ∣ ((∑ j ∈ S_univ, L j) - 1) := by
      apply hXpow_dvd
      intro m
      rw [Polynomial.eval_sub, heval_L_sum m, Polynomial.eval_one, sub_self]
    have hdvd_X : (Polynomial.X ^ ℓ - 1) ∣
        ((∑ j ∈ S_univ, Polynomial.C (ν j) * L j) - Polynomial.X) := by
      apply hXpow_dvd
      intro m
      rw [Polynomial.eval_sub, Polynomial.eval_finsetSum, Polynomial.eval_X,
        Finset.sum_eq_single m]
      · rw [Polynomial.eval_mul, Polynomial.eval_C,
          Lagrange.eval_basis_self hInjOn (Finset.mem_univ m), mul_one, sub_self]
      · intro j _ hjm
        rw [Polynomial.eval_mul, Polynomial.eval_C,
          Lagrange.eval_basis_of_ne hjm (Finset.mem_univ m), mul_zero]
      · intro hm
        exact False.elim (hm (Finset.mem_univ m))
    have hdvd_orth : ∀ i j : ZMod ℓ, i ≠ j → (Polynomial.X ^ ℓ - 1) ∣ (L i * L j) := by
      intro i j hij
      apply hXpow_dvd
      intro m
      rw [Polynomial.eval_mul]
      by_cases hmi : i = m
      · subst hmi
        rw [Lagrange.eval_basis_of_ne hij.symm (Finset.mem_univ i), mul_zero]
      · rw [Lagrange.eval_basis_of_ne hmi (Finset.mem_univ m), zero_mul]
    have hdvd_idem : ∀ j : ZMod ℓ, (Polynomial.X ^ ℓ - 1) ∣ (L j * L j - L j) := by
      intro j
      apply hXpow_dvd
      intro m
      rw [Polynomial.eval_sub, Polynomial.eval_mul]
      by_cases hmj : j = m
      · subst hmj
        rw [Lagrange.eval_basis_self hInjOn (Finset.mem_univ j), one_mul, sub_self]
      · rw [Lagrange.eval_basis_of_ne hmj (Finset.mem_univ m), zero_mul, sub_zero]
    intro R _ σ v hv
    let _ : Algebra K R := σ.toAlgebra
    let ev_v : Polynomial K →ₐ[K] R := Polynomial.aeval v
    have hev_Xpow : ev_v (Polynomial.X ^ ℓ - 1) = 0 := by
      dsimp [ev_v]
      rw [map_sub, map_pow, Polynomial.aeval_X, map_one, hv, sub_self]
    have hev_dvd : ∀ Q : Polynomial K, (Polynomial.X ^ ℓ - 1) ∣ Q → ev_v Q = 0 := by
      rintro Q ⟨K_Q, rfl⟩
      rw [map_mul, hev_Xpow, zero_mul]
    let e : ZMod ℓ → R := fun j => ev_v (L j)
    refine ⟨e, ?_, ?_, ?_, ?_⟩
    · have h0 := hev_dvd _ hdvd_sum
      rw [map_sub, map_sum, map_one] at h0
      exact sub_eq_zero.mp h0
    · intro i j hij
      rw [← map_mul]
      exact hev_dvd _ (hdvd_orth i j hij)
    · intro j
      have h0 := hev_dvd _ (hdvd_idem j)
      rw [map_sub, map_mul] at h0
      exact sub_eq_zero.mp h0
    · have h0 := hev_dvd _ hdvd_X
      rw [map_sub, map_sum, Polynomial.aeval_X] at h0
      have hterm : ∀ j : ZMod ℓ, ev_v (Polynomial.C (ν j) * L j) = σ (ν j) * e j := by
        intro j
        rw [map_mul, Polynomial.aeval_C]
        rfl
      simp_rw [hterm] at h0
      exact sub_eq_zero.mp h0

  
  
  
  let S_K : Scheme.{u} := Spec (CommRingCat.of K)
  let J := weilC1AffEtTop K
  let A_ℓ := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))
  let up_ℓ : ZMod ℓ → ↑A_ℓ := fun j => ULift.up j
  let p_kum : Gm_K ⟶ Gm_K := ℓ • CategoryTheory.CategoryStruct.id Gm_K
  let P_et : MorphismProperty Scheme.{u} := @AlgebraicGeometry.Etale
  have hMult : MorphismProperty.IsMultiplicative P_et := inferInstance
  have : MorphismProperty.IsStableUnderComposition P_et := hMult.toIsStableUnderComposition

  have hp_kum_app : ∀ (V : (S_K.AffineEtale)ᵒᵖ) (u : ↑(Gm_K.obj.obj V)),
      (p_kum.hom.app V).hom u = ℓ • u := by
    intro V u
    have hnsmul : ∀ (n : ℕ),
        ((n • CategoryTheory.CategoryStruct.id Gm_K).hom.app V).hom u = n • u := by
      intro n
      induction n with
      | zero => simp
      | succ n ih =>
        rw [succ_nsmul, CategoryTheory.Sheaf.Hom.add_app, AddCommGrpCat.hom_add,
          AddMonoidHom.add_apply, ih, succ_nsmul]
        rfl
    exact hnsmul ℓ

  let σ_U : ∀ U : S_K.AffineEtale, K →+* ↑U.left.unop :=
    fun U => ((Scheme.Spec.preimage U.hom).unop).hom
  have hσ_comp : ∀ {Y U : S_K.AffineEtale} (g : Y ⟶ U) (c : K),
      ((g.left.unop).hom) (σ_U U c) = σ_U Y c := by
    intro Y U g c
    have hw : Scheme.Spec.map g.left ≫ U.hom = Y.hom := g.w
    have hpre : g.left ≫ Scheme.Spec.preimage U.hom = Scheme.Spec.preimage Y.hom := by
      apply Scheme.Spec.map_injective
      rw [Scheme.Spec.map_comp, Scheme.Spec.map_preimage, Scheme.Spec.map_preimage]
      exact hw
    have hunop : (Scheme.Spec.preimage U.hom).unop ≫ g.left.unop =
        (Scheme.Spec.preimage Y.hom).unop :=
      congrArg Quiver.Hom.unop hpre
    exact congrArg (fun φ : CommRingCat.of K ⟶ Y.left.unop => φ.hom c) hunop

  have hCoverOfArrows : ∀ (U : S_K.AffineEtale) {ι : Type}
      (W : ι → S_K.AffineEtale) (g : ∀ i, W i ⟶ U),
      (∀ i, Etale (Spec.map (g i).left.unop)) →
      (∀ x : PrimeSpectrum ↑U.left.unop,
        ∃ (i : ι) (y : PrimeSpectrum ↑(W i).left.unop),
          PrimeSpectrum.comap ((g i).left.unop).hom y = x) →
      Sieve.ofArrows W g ∈ J U := by
    intro U ι W g hEt hSurj
    let F_spec := Scheme.AffineEtale.Spec S_K
    rw [← Functor.IsDenseSubsite.functorPushforward_mem_iff
      (G := F_spec) (J := J) (K := S_K.smallEtaleTopology)]
    have hJ_eq :=
      Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) S_K le_rfl
    refine ((Eq.to_iff (congrArg (fun G : GrothendieckTopology (P_et.Over ⊤ S_K) =>
      Sieve.functorPushforward F_spec (Sieve.ofArrows W g) ∈ G (F_spec.obj U)) hJ_eq)).trans
      (Scheme.mem_toGrothendieck_smallPretopology (P := P_et) (Q := P_et) (F_spec.obj U) _)).mpr ?_
    intro x
    obtain ⟨i, y, hy⟩ := hSurj x
    refine ⟨F_spec.obj (W i), F_spec.map (g i), y, ?_, hEt i, hy⟩
    exact ⟨W i, g i, 𝟙 _, Sieve.ofArrows_mk W g i, (Category.id_comp _).symm⟩

  have hOfArrows_unpack : ∀ {U Y : S_K.AffineEtale} {ι : Type}
      {W : ι → S_K.AffineEtale} {g : ∀ i, W i ⟶ U} {f : Y ⟶ U},
      (Sieve.ofArrows W g).arrows f → ∃ (i : ι) (m : Y ⟶ W i), f = m ≫ g i := by
    rintro U Y ι W g f ⟨_, m, _, ⟨i⟩, rfl⟩
    exact ⟨i, m, rfl⟩

  have hSub_of_subsingleton : ∀ (Z : S_K.AffineEtale),
      Subsingleton ↑Z.left.unop →
      ∀ (𝒢 : Sheaf J AddCommGrpCat.{u}), Subsingleton ↑(𝒢.obj.obj (Opposite.op Z)) := by
    intro Z hSubZ 𝒢
    let W_emp : Empty → S_K.AffineEtale := fun i => i.elim
    let g_emp : ∀ i : Empty, W_emp i ⟶ Z := fun i => i.elim
    have hEmp_mem : Sieve.ofArrows W_emp g_emp ∈ J Z := by
      refine hCoverOfArrows Z W_emp g_emp (fun i => i.elim) (fun x => ?_)
      exfalso
      have h10 : (1 : ↑Z.left.unop) = 0 := @Subsingleton.elim _ hSubZ 1 0
      exact x.isPrime.ne_top ((Ideal.eq_top_iff_one x.asIdeal).mpr (h10 ▸ x.asIdeal.zero_mem))
    have h𝒢_type : Presheaf.IsSheaf J (𝒢.obj ⋙ forget AddCommGrpCat.{u}) :=
      Presheaf.isSheaf_comp_of_isSheaf J 𝒢.obj (forget AddCommGrpCat.{u}) 𝒢.property
    refine ⟨fun s₁ s₂ => ?_⟩
    apply (h𝒢_type.isSheafFor _ hEmp_mem).isSeparatedFor.ext
    intro Y f hf
    obtain ⟨i, _, _⟩ := hOfArrows_unpack hf
    exact i.elim

  
  
  
  have hAff : ∀ (R₀ : Type u) [CommRing R₀] (σ₀ : K →+* R₀) (u₀ : Units R₀),
      ∃ (B₀ : Type u) (_ : CommRing B₀) (α₀ : R₀ →+* B₀) (w₀ : Units B₀),
        α₀.Etale ∧
        Function.Surjective (PrimeSpectrum.comap α₀) ∧
        w₀ ^ ℓ = Units.map α₀.toMonoidHom u₀ := by
    intro R₀ _ σ₀ u₀
    let ℓ_inv : R₀ := σ₀ ((ℓ : K)⁻¹)
    have hℓ_mul : (ℓ : R₀) * ℓ_inv = 1 := by
      have hcast : σ₀ (ℓ : K) = (ℓ : R₀) := map_natCast σ₀ ℓ
      rw [← hcast, ← map_mul, mul_inv_cancel₀ hℓ, map_one]
    let f : Polynomial R₀ := Polynomial.X ^ ℓ - Polynomial.C (u₀ : R₀)
    have hmonic : f.Monic := Polynomial.monic_X_pow_sub_C (u₀ : R₀) hℓ_ne
    let p₁ : Polynomial R₀ := Polynomial.C (ℓ_inv * ↑u₀⁻¹) * Polynomial.X
    let p₂ : Polynomial R₀ := Polynomial.C (-↑u₀⁻¹)
    have hbezout : Polynomial.derivative f * p₁ + f * p₂ = (1 : Polynomial R₀) ^ 1 := by
      have hdf : Polynomial.derivative f = Polynomial.C (ℓ : R₀) * Polynomial.X ^ (ℓ - 1) := by
        dsimp [f]
        rw [Polynomial.derivative_sub, Polynomial.derivative_X_pow, Polynomial.derivative_C,
          sub_zero, Polynomial.C_eq_natCast]
      have hXpow :
          (Polynomial.X : Polynomial R₀) ^ (ℓ - 1) * Polynomial.X = Polynomial.X ^ ℓ := by
        rw [← pow_succ, Nat.sub_add_cancel h1_lt.le]
      have hC₁ :
          Polynomial.C (ℓ : R₀) * Polynomial.C (ℓ_inv * ↑u₀⁻¹) = Polynomial.C (↑u₀⁻¹ : R₀) := by
        rw [← Polynomial.C_mul, ← mul_assoc, hℓ_mul, one_mul]
      have hC₂ : Polynomial.C (u₀ : R₀) * Polynomial.C (-↑u₀⁻¹ : R₀) = -1 := by
        rw [← Polynomial.C_mul, mul_neg, Units.mul_inv, Polynomial.C_neg, Polynomial.C_1]
      rw [hdf]
      dsimp [f, p₁, p₂]
      calc
        Polynomial.C (ℓ : R₀) * Polynomial.X ^ (ℓ - 1) *
            (Polynomial.C (ℓ_inv * ↑u₀⁻¹) * Polynomial.X) +
            (Polynomial.X ^ ℓ - Polynomial.C (u₀ : R₀)) * Polynomial.C (-↑u₀⁻¹)
          = (Polynomial.C (ℓ : R₀) * Polynomial.C (ℓ_inv * ↑u₀⁻¹)) *
              (Polynomial.X ^ (ℓ - 1) * Polynomial.X) +
              Polynomial.X ^ ℓ * Polynomial.C (-↑u₀⁻¹) -
              Polynomial.C (u₀ : R₀) * Polynomial.C (-↑u₀⁻¹) := by ring
        _ = Polynomial.C (↑u₀⁻¹ : R₀) * Polynomial.X ^ ℓ +
              Polynomial.X ^ ℓ * (-Polynomial.C (↑u₀⁻¹ : R₀)) - (-1) := by
            rw [hC₁, hXpow, hC₂, Polynomial.C_neg]
        _ = (1 : Polynomial R₀) ^ 1 := by ring
    let P : StandardEtalePair R₀ := StandardEtalePair.mk f hmonic 1 ⟨p₁, p₂, 1, hbezout⟩
    have : Algebra.Etale R₀ P.Ring := inferInstance
    let B₀ : Type u := AdjoinRoot f
    let t₀ : B₀ := AdjoinRoot.root f
    have ht₀_aeval : (Polynomial.aeval t₀) f = 0 := by
      rw [AdjoinRoot.aeval_eq, AdjoinRoot.mk_self]
    have ht₀_hasMap : P.HasMap t₀ := by
      refine ⟨?_, ?_⟩
      · simpa [P, Polynomial.aeval_def] using ht₀_aeval
      · simp [P]
    let toB₀ : P.Ring →ₐ[R₀] B₀ := (P.homEquiv (S := B₀)).symm ⟨t₀, ht₀_hasMap⟩
    have htoB₀_X : toB₀ P.X = t₀ := by
      have h := (P.homEquiv (S := B₀)).apply_symm_apply ⟨t₀, ht₀_hasMap⟩
      exact congrArg Subtype.val h
    let fromB₀ : B₀ →ₐ[R₀] P.Ring :=
      AdjoinRoot.liftAlgHom f (Algebra.ofId R₀ P.Ring) P.X P.hasMap_X.1
    have hfrom_t₀ : fromB₀ t₀ = P.X := by
      dsimp [fromB₀, t₀]
      exact AdjoinRoot.liftAlgHom_root f (Algebra.ofId R₀ P.Ring) P.X P.hasMap_X.1
    have hcomp₁ : fromB₀.comp toB₀ = AlgHom.id R₀ P.Ring := by
      apply (P.homEquiv (S := P.Ring)).injective
      apply Subtype.ext
      change fromB₀ (toB₀ P.X) = P.X
      rw [htoB₀_X, hfrom_t₀]
    have hcomp₂ : toB₀.comp fromB₀ = AlgHom.id R₀ B₀ := by
      apply AdjoinRoot.algHom_ext
      change toB₀ (fromB₀ t₀) = t₀
      rw [hfrom_t₀, htoB₀_X]
    let e_alg : P.Ring ≃ₐ[R₀] B₀ := AlgEquiv.ofAlgHom toB₀ fromB₀ hcomp₂ hcomp₁
    have : Algebra.Etale R₀ B₀ := Algebra.Etale.of_equiv e_alg
    have hα_et : (algebraMap R₀ B₀).Etale := RingHom.etale_algebraMap.mpr inferInstance
    let pb := AdjoinRoot.powerBasis' hmonic
    have : Module.Finite R₀ B₀ := pb.finite
    have : Algebra.IsIntegral R₀ B₀ := Algebra.IsIntegral.of_finite R₀ B₀
    have hint : (algebraMap R₀ B₀).IsIntegral := fun b => Algebra.IsIntegral.isIntegral b
    have hinj : Function.Injective (algebraMap R₀ B₀) := by
      by_cases hSub : Subsingleton R₀
      · intro r₁ r₂ _
        exact @Subsingleton.elim _ hSub r₁ r₂
      · have : Nontrivial R₀ := not_subsingleton_iff_nontrivial.mp hSub
        have hdim : pb.dim = ℓ := by
          dsimp [pb, f]
          rw [AdjoinRoot.powerBasis'_dim, Polynomial.natDegree_X_pow_sub_C]
        let i₀ : Fin pb.dim := ⟨0, hdim ▸ hPrime.pos⟩
        have hb₀ : pb.basis i₀ = 1 := by
          rw [pb.coe_basis]
          exact pow_zero _
        intro r₁ r₂ hr
        have hsmul : r₁ • pb.basis i₀ = r₂ • pb.basis i₀ := by
          rw [hb₀, Algebra.smul_def, Algebra.smul_def, mul_one, mul_one, hr]
        have hrepr := congrArg (fun z : B₀ => (pb.basis.repr z) i₀) hsmul
        rw [map_smul, map_smul, Module.Basis.repr_self] at hrepr
        simpa using hrepr
    have hsurj : Function.Surjective (PrimeSpectrum.comap (algebraMap R₀ B₀)) :=
      RingHom.IsIntegral.comap_surjective hint hinj
    have ht₀_pow : t₀ ^ ℓ = algebraMap R₀ B₀ (u₀ : R₀) := by
      have h0 : t₀ ^ ℓ - algebraMap R₀ B₀ (u₀ : R₀) = 0 := by
        simpa [f] using ht₀_aeval
      exact sub_eq_zero.mp h0
    let w_inv : B₀ := t₀ ^ (ℓ - 1) * algebraMap R₀ B₀ (↑u₀⁻¹ : R₀)
    have htw : t₀ * w_inv = 1 := by
      dsimp [w_inv]
      rw [← mul_assoc, ← pow_succ', Nat.sub_add_cancel h1_lt.le, ht₀_pow,
        ← map_mul, Units.mul_inv, map_one]
    have hwt : w_inv * t₀ = 1 := by
      rw [mul_comm, htw]
    let w₀ : Units B₀ := ⟨t₀, w_inv, htw, hwt⟩
    have hw₀_pow : w₀ ^ ℓ = Units.map (algebraMap R₀ B₀).toMonoidHom u₀ := by
      apply Units.ext
      exact ht₀_pow
    exact ⟨B₀, inferInstance, algebraMap R₀ B₀, w₀, hα_et, hsurj, hw₀_pow⟩

  have hEpi : CategoryTheory.Epi p_kum := by
    constructor
    intro ℱ α₁ α₂ hα₁₂
    have hℱ_type : Presheaf.IsSheaf J (ℱ.obj ⋙ forget AddCommGrpCat.{u}) :=
      Presheaf.isSheaf_comp_of_isSheaf J ℱ.obj (forget AddCommGrpCat.{u}) ℱ.property
    ext U_op : 3
    apply AddCommGrpCat.ext
    intro u_add
    let U : S_K.AffineEtale := U_op.unop
    obtain ⟨B₀, instB₀, α₀, w₀, hα_et, hα_surj, hw₀_pow⟩ :=
      hAff (↑U.left.unop) (σ_U U) (Additive.toMul u_add)
    let _ : CommRing B₀ := instB₀
    let α_cat : U.left.unop ⟶ CommRingCat.of B₀ := CommRingCat.ofHom α₀
    have hπ_et : Etale (Spec.map α_cat) :=
      (HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hα_et
    let Z : S_K.AffineEtale :=
      @Scheme.AffineEtale.mk S_K (CommRingCat.of B₀) (Spec.map α_cat ≫ U.hom)
        (MorphismProperty.comp_mem P_et _ _ hπ_et U.prop)
    let h : Z ⟶ U := MorphismProperty.CostructuredArrow.homMk α_cat.op trivial rfl
    let W_cov : PUnit → S_K.AffineEtale := fun _ => Z
    let g_cov : ∀ i : PUnit, W_cov i ⟶ U := fun _ => h
    have hCov : Sieve.ofArrows W_cov g_cov ∈ J U :=
      hCoverOfArrows U W_cov g_cov (fun _ => hπ_et) (fun x => by
        obtain ⟨y, hy⟩ := hα_surj x
        exact ⟨PUnit.unit, y, hy⟩)
    let w_add : ↑(Gm_K.obj.obj (Opposite.op Z)) := Additive.ofMul w₀
    have hw_eq : (Gm_K.obj.map h.op).hom u_add = ℓ • w_add := by
      change Additive.ofMul (Units.map α₀.toMonoidHom (Additive.toMul u_add)) =
        ℓ • Additive.ofMul w₀
      rw [← ofMul_pow, hw₀_pow]
    apply (hℱ_type.isSheafFor _ hCov).isSeparatedFor.ext
    intro Y g hg
    obtain ⟨_, m, hg_eq⟩ := hOfArrows_unpack hg
    change (ℱ.obj.map g.op).hom ((α₁.hom.app U_op).hom u_add) =
      (ℱ.obj.map g.op).hom ((α₂.hom.app U_op).hom u_add)
    let w_Y : ↑(Gm_K.obj.obj (Opposite.op Y)) := (Gm_K.obj.map m.op).hom w_add
    have hu_Y : (Gm_K.obj.map g.op).hom u_add = (p_kum.hom.app (Opposite.op Y)).hom w_Y := by
      rw [hg_eq, op_comp, Gm_K.obj.map_comp]
      change (Gm_K.obj.map m.op).hom ((Gm_K.obj.map h.op).hom u_add) =
        (p_kum.hom.app (Opposite.op Y)).hom w_Y
      rw [hw_eq, map_nsmul, hp_kum_app]
    have hα₁_nat : (ℱ.obj.map g.op).hom ((α₁.hom.app U_op).hom u_add) =
        ((p_kum ≫ α₁).hom.app (Opposite.op Y)).hom w_Y := by
      have hnat := (congrArg (fun k : Gm_K.obj.obj U_op ⟶ ℱ.obj.obj (Opposite.op Y) => k.hom u_add)
        (α₁.hom.naturality g.op)).symm
      exact hnat.trans (congrArg (α₁.hom.app (Opposite.op Y)).hom hu_Y)
    have hα₂_nat : (ℱ.obj.map g.op).hom ((α₂.hom.app U_op).hom u_add) =
        ((p_kum ≫ α₂).hom.app (Opposite.op Y)).hom w_Y := by
      have hnat := (congrArg (fun k : Gm_K.obj.obj U_op ⟶ ℱ.obj.obj (Opposite.op Y) => k.hom u_add)
        (α₂.hom.naturality g.op)).symm
      exact hnat.trans (congrArg (α₂.hom.app (Opposite.op Y)).hom hu_Y)
    exact hα₁_nat.trans
      ((congrArg (fun k : Gm_K ⟶ ℱ => (k.hom.app (Opposite.op Y)).hom w_Y) hα₁₂).trans
        hα₂_nat.symm)

  
  
  
  let kerSub : ∀ V : (S_K.AffineEtale)ᵒᵖ, AddSubgroup ↑(Gm_K.obj.obj V) :=
    fun V => AddMonoidHom.ker (p_kum.hom.app V).hom
  have hker_map : ∀ {V₁ V₂ : (S_K.AffineEtale)ᵒᵖ} (g : V₁ ⟶ V₂) (u : ↥(kerSub V₁)),
      (Gm_K.obj.map g).hom u.1 ∈ kerSub V₂ := by
    intro V₁ V₂ g u
    change (p_kum.hom.app V₂).hom ((Gm_K.obj.map g).hom u.1) = 0
    have hu : ℓ • u.1 = 0 := (hp_kum_app V₁ u.1).symm.trans u.2
    rw [hp_kum_app V₂, ← map_nsmul, hu, map_zero]
  let Mu_pre : (S_K.AffineEtale)ᵒᵖ ⥤ AddCommGrpCat.{u} :=
    { obj := fun V => AddCommGrpCat.of ↥(kerSub V)
      map := fun {_ _} g => AddCommGrpCat.ofHom
        { toFun := fun u => ⟨(Gm_K.obj.map g).hom u.1, hker_map g u⟩
          map_zero' := Subtype.ext (map_zero _)
          map_add' := fun u₁ u₂ => Subtype.ext (map_add _ u₁.1 u₂.1) }
      map_id := fun V => AddCommGrpCat.hom_ext (AddMonoidHom.ext fun u => Subtype.ext (by
        change ((Gm_K.obj.map (𝟙 V)).hom) u.1 = u.1
        rw [Gm_K.obj.map_id]
        rfl))
      map_comp := fun {_ _ _} f g => AddCommGrpCat.hom_ext (AddMonoidHom.ext fun u =>
        Subtype.ext (by
          change ((Gm_K.obj.map (f ≫ g)).hom) u.1 =
            ((Gm_K.obj.map g).hom) (((Gm_K.obj.map f).hom) u.1)
          rw [Gm_K.obj.map_comp]
          rfl)) }

  have hGm_type : Presheaf.IsSheaf J (Gm_K.obj ⋙ forget AddCommGrpCat.{u}) :=
    Presheaf.isSheaf_comp_of_isSheaf J Gm_K.obj (forget AddCommGrpCat.{u}) (hGm K)
  have hMu_sheaf : Presheaf.IsSheaf J Mu_pre := by
    apply Presheaf.isSheaf_of_isSheaf_comp J Mu_pre (forget AddCommGrpCat.{u})
    rw [CategoryTheory.isSheaf_iff_isSheaf_of_type]
    intro U S hS x hx
    let y : Presieve.FamilyOfElements (Gm_K.obj ⋙ forget AddCommGrpCat.{u}) S.arrows :=
      fun _ f hf => (x f hf).1
    have hy : y.Compatible := fun _ _ _ g₁ g₂ _ _ hf₁ hf₂ hcomm =>
      congrArg Subtype.val (hx g₁ g₂ hf₁ hf₂ hcomm)
    let hS_gm := hGm_type.isSheafFor S hS
    let u₀ : ↑(Gm_K.obj.obj (Opposite.op U)) := hS_gm.amalgamate y hy
    have hu₀_glue : ∀ ⦃Y : S_K.AffineEtale⦄ (f : Y ⟶ U) (hf : S.arrows f),
        (Gm_K.obj.map f.op).hom u₀ = (x f hf).1 :=
      fun _ f hf => hS_gm.valid_glue hy f hf
    have hu₀_ker : u₀ ∈ kerSub (Opposite.op U) := by
      change (p_kum.hom.app (Opposite.op U)).hom u₀ = 0
      rw [hp_kum_app]
      apply hS_gm.isSeparatedFor.ext
      intro Y f hf
      change (Gm_K.obj.map f.op).hom (ℓ • u₀) = (Gm_K.obj.map f.op).hom 0
      rw [map_nsmul, hu₀_glue f hf, map_zero, ← hp_kum_app (Opposite.op Y)]
      exact (x f hf).2
    refine ⟨⟨u₀, hu₀_ker⟩, ?_, ?_⟩
    · intro Y f hf
      exact Subtype.ext (hu₀_glue f hf)
    · intro z hz
      apply Subtype.ext
      apply hS_gm.isSeparatedFor.ext
      intro Y f hf
      have hz_f : (Gm_K.obj.map f.op).hom z.1 = (x f hf).1 :=
        congrArg Subtype.val (hz f hf)
      exact hz_f.trans (hu₀_glue f hf).symm

  let Mu_sh : Sheaf J AddCommGrpCat.{u} := ⟨Mu_pre, hMu_sheaf⟩
  have hMu_type : Presheaf.IsSheaf J (Mu_sh.obj ⋙ forget AddCommGrpCat.{u}) :=
    Presheaf.isSheaf_comp_of_isSheaf J Mu_sh.obj (forget AddCommGrpCat.{u}) Mu_sh.property
  have hConst_type : Presheaf.IsSheaf J (Const_ℓ.obj ⋙ forget AddCommGrpCat.{u}) :=
    Presheaf.isSheaf_comp_of_isSheaf J Const_ℓ.obj (forget AddCommGrpCat.{u}) Const_ℓ.property

  let ι_μ : Mu_sh ⟶ Gm_K :=
    { hom :=
        { app := fun V => AddCommGrpCat.ofHom (kerSub V).subtype
          naturality := fun _ _ _ => AddCommGrpCat.hom_ext (AddMonoidHom.ext fun _ => rfl) } }
  have h0_μ : ι_μ ≫ p_kum = 0 := by
    ext V : 3
    apply AddCommGrpCat.ext
    intro u
    exact u.2
  have hMono_μ : CategoryTheory.Mono ι_μ := by
    constructor
    intro ℱ α β hαβ
    ext V : 3
    apply AddCommGrpCat.ext
    intro x
    exact Subtype.ext (congrArg (fun g : ℱ ⟶ Gm_K => (g.hom.app V).hom x) hαβ)
  let SC_μ : ShortComplex (Sheaf J AddCommGrpCat.{u}) := ShortComplex.mk ι_μ p_kum h0_μ
  have hKernel_μ : Limits.IsLimit (Limits.KernelFork.ofι SC_μ.f SC_μ.zero) := by
    refine Limits.KernelFork.IsLimit.ofι SC_μ.f SC_μ.zero
      (fun {ℱ} τ hτ =>
        { hom :=
            { app := fun V => AddCommGrpCat.ofHom
                { toFun := fun x => ⟨(τ.hom.app V).hom x,
                    congrArg (fun g : ℱ ⟶ Gm_K => (g.hom.app V).hom x) hτ⟩
                  map_zero' := Subtype.ext (map_zero _)
                  map_add' := fun x₁ x₂ => Subtype.ext (map_add _ x₁ x₂) }
              naturality := fun _ _ g => AddCommGrpCat.hom_ext (AddMonoidHom.ext fun x =>
                Subtype.ext (congrArg (fun k : ℱ.obj.obj _ ⟶ Gm_K.obj.obj _ => k.hom x)
                  (τ.hom.naturality g))) } })
      (fun {_} _ _ => by
        ext V : 3
        apply AddCommGrpCat.ext
        intro _
        rfl)
      (fun {ℱ} _ _ m hm => by
        ext V : 3
        apply AddCommGrpCat.ext
        intro x
        exact Subtype.ext (congrArg (fun g : ℱ ⟶ Gm_K => (g.hom.app V).hom x) hm))
  have hExact_μ : SC_μ.Exact := ShortComplex.exact_of_f_is_kernel SC_μ hKernel_μ

  
  let T_aff : S_K.AffineEtale := Scheme.AffineEtale.mk (CategoryStruct.id S_K)
  have hT_aff : Limits.IsTerminal T_aff :=
    Limits.IsTerminal.ofUniqueHom
      (fun W => MorphismProperty.CostructuredArrow.homMk
        (Scheme.Spec.preimage W.hom) trivial
        ((Category.comp_id _).trans (Scheme.Spec.map_preimage W.hom)))
      (fun W μ => MorphismProperty.Comma.Hom.ext
        (Scheme.Spec.map_injective
          (((Category.comp_id _).symm.trans μ.w).trans
            (Scheme.Spec.map_preimage W.hom).symm))
        (Subsingleton.elim _ _))
  let adj := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT_aff
  let η : A_ℓ ⟶ Const_ℓ.obj.obj (Opposite.op T_aff) := adj.unit.app A_ℓ
  let ζ_sec : ∀ (Y : S_K.AffineEtale), ↑A_ℓ → ↑(Const_ℓ.obj.obj (Opposite.op Y)) :=
    fun Y a => (Const_ℓ.obj.map (hT_aff.from Y).op).hom (η.hom a)
  have hζ_sec_zero : ∀ Y : S_K.AffineEtale, ζ_sec Y 0 = 0 := by
    intro Y
    dsimp [ζ_sec]
    rw [map_zero, map_zero]
  have hζ_sec_add : ∀ (Y : S_K.AffineEtale) (a b : ↑A_ℓ),
      ζ_sec Y (a + b) = ζ_sec Y a + ζ_sec Y b := by
    intro Y a b
    dsimp [ζ_sec]
    rw [map_add, map_add]
  have hζ_sec_map : ∀ {Z Y : S_K.AffineEtale} (g : Z ⟶ Y) (a : ↑A_ℓ),
      (Const_ℓ.obj.map g.op).hom (ζ_sec Y a) = ζ_sec Z a := by
    intro Z Y g a
    dsimp [ζ_sec]
    have hfrom : g ≫ hT_aff.from Y = hT_aff.from Z := hT_aff.hom_ext _ _
    change ((Const_ℓ.obj.map (hT_aff.from Y).op ≫ Const_ℓ.obj.map g.op).hom) (η.hom a) =
      (Const_ℓ.obj.map (hT_aff.from Z).op).hom (η.hom a)
    rw [← Const_ℓ.obj.map_comp, ← op_comp, hfrom]
  have hζ_sec_T : ∀ a : ↑A_ℓ, ζ_sec T_aff a = η.hom a := by
    intro a
    dsimp [ζ_sec]
    have hid : hT_aff.from T_aff = 𝟙 T_aff := hT_aff.hom_ext _ _
    rw [hid, op_id, Const_ℓ.obj.map_id]
    rfl

  let μ_unit : ∀ (U : S_K.AffineEtale), ↑A_ℓ → Units ↑U.left.unop :=
    fun U a =>
      ⟨σ_U U (ν a.down), σ_U U (ν (-a.down)),
        by rw [← map_mul, ← hν_add, add_neg_cancel, hν_zero, map_one],
        by rw [← map_mul, ← hν_add, neg_add_cancel, hν_zero, map_one]⟩
  have hμ_ker : ∀ (U : S_K.AffineEtale) (a : ↑A_ℓ),
      (Additive.ofMul (μ_unit U a) : ↑(Gm_K.obj.obj (Opposite.op U))) ∈ kerSub (Opposite.op U) := by
    intro U a
    let u_add : ↑(Gm_K.obj.obj (Opposite.op U)) := Additive.ofMul (μ_unit U a)
    change (p_kum.hom.app (Opposite.op U)).hom u_add = 0
    rw [hp_kum_app]
    change ℓ • Additive.ofMul (μ_unit U a) = Additive.ofMul 1
    rw [← ofMul_pow]
    congr 1
    apply Units.ext
    change (σ_U U (ν a.down)) ^ ℓ = 1
    rw [← map_pow, hν_pow, map_one]
  let μ_const : ∀ (U : S_K.AffineEtale), ↑A_ℓ → ↑(Mu_sh.obj.obj (Opposite.op U)) :=
    fun U a => ⟨Additive.ofMul (μ_unit U a), hμ_ker U a⟩
  have hμ_const_zero : ∀ U : S_K.AffineEtale, μ_const U 0 = 0 := by
    intro U
    apply Subtype.ext
    change Additive.ofMul (μ_unit U 0) = Additive.ofMul 1
    congr 1
    apply Units.ext
    change σ_U U (ν 0) = 1
    rw [hν_zero, map_one]
  have hμ_const_add : ∀ (U : S_K.AffineEtale) (a b : ↑A_ℓ),
      μ_const U (a + b) = μ_const U a + μ_const U b := by
    intro U a b
    apply Subtype.ext
    change Additive.ofMul (μ_unit U (a + b)) = Additive.ofMul (μ_unit U a * μ_unit U b)
    congr 1
    apply Units.ext
    change σ_U U (ν (a.down + b.down)) = σ_U U (ν a.down) * σ_U U (ν b.down)
    rw [hν_add, map_mul]
  have hμ_const_map : ∀ {Z U : S_K.AffineEtale} (g : Z ⟶ U) (a : ↑A_ℓ),
      (Mu_sh.obj.map g.op).hom (μ_const U a) = μ_const Z a := by
    intro Z U g a
    apply Subtype.ext
    change Additive.ofMul (Units.map (g.left.unop).hom.toMonoidHom (μ_unit U a)) =
      Additive.ofMul (μ_unit Z a)
    congr 1
    apply Units.ext
    exact hσ_comp g (ν a.down)
  have hμ_const_inj : ∀ (U : S_K.AffineEtale) [Nontrivial ↑U.left.unop] {a b : ↑A_ℓ},
      μ_const U a = μ_const U b → a = b := by
    intro U _ a b hab
    have hval : σ_U U (ν a.down) = σ_U U (ν b.down) :=
      congrArg Units.val (congrArg Additive.toMul (congrArg Subtype.val hab))
    exact ULift.ext _ _ (hν_inj ((σ_U U).injective hval))

  let c_ζ : A_ℓ ⟶ Mu_sh.obj.obj (Opposite.op T_aff) :=
    AddCommGrpCat.ofHom
      { toFun := fun a => μ_const T_aff a
        map_zero' := hμ_const_zero T_aff
        map_add' := hμ_const_add T_aff }
  let Φ : Const_ℓ ⟶ Mu_sh := (adj.homEquiv A_ℓ Mu_sh).symm c_ζ
  have hηΦ : η ≫ Φ.hom.app (Opposite.op T_aff) = c_ζ :=
    (adj.homEquiv A_ℓ Mu_sh).apply_symm_apply c_ζ
  have hΦ_T : ∀ a : ↑A_ℓ, (Φ.hom.app (Opposite.op T_aff)).hom (η.hom a) = μ_const T_aff a :=
    fun a => congrArg (fun k : A_ℓ ⟶ Mu_sh.obj.obj (Opposite.op T_aff) => k.hom a) hηΦ
  have hΦ_ζ : ∀ (Y : S_K.AffineEtale) (a : ↑A_ℓ),
      (Φ.hom.app (Opposite.op Y)).hom (ζ_sec Y a) = μ_const Y a := by
    intro Y a
    dsimp [ζ_sec]
    have hnat := congrArg
      (fun k : Const_ℓ.obj.obj (Opposite.op T_aff) ⟶ Mu_sh.obj.obj (Opposite.op Y) =>
        k.hom (η.hom a))
      (Φ.hom.naturality (hT_aff.from Y).op)
    exact hnat.trans ((congrArg (Mu_sh.obj.map (hT_aff.from Y).op).hom (hΦ_T a)).trans
      (hμ_const_map (hT_aff.from Y) a))

  
  let α_loc : ∀ (U : S_K.AffineEtale) (r : ↑U.left.unop),
      U.left.unop ⟶ CommRingCat.of (Localization.Away r) :=
    fun U r => CommRingCat.ofHom (algebraMap (↑U.left.unop) (Localization.Away r))
  have hEt_loc : ∀ (U : S_K.AffineEtale) (r : ↑U.left.unop), Etale (Spec.map (α_loc U r)) := by
    intro U r
    have : IsOpenImmersion (Spec.map (α_loc U r)) :=
      Scheme.isOpenImmersion_SpecMap_localizationAway r
    exact inferInstance
  let W_loc : ∀ (U : S_K.AffineEtale) (r : ↑U.left.unop), S_K.AffineEtale :=
    fun U r =>
      @Scheme.AffineEtale.mk S_K (CommRingCat.of (Localization.Away r))
        (Spec.map (α_loc U r) ≫ U.hom)
        (MorphismProperty.comp_mem P_et _ _ (hEt_loc U r) U.prop)
  let ι_loc : ∀ (U : S_K.AffineEtale) (r : ↑U.left.unop), W_loc U r ⟶ U :=
    fun U r => MorphismProperty.CostructuredArrow.homMk (α_loc U r).op trivial rfl
  have hι_loc_isUnit : ∀ (U : S_K.AffineEtale) (r : ↑U.left.unop),
      IsUnit (((ι_loc U r).left.unop).hom r) :=
    fun _ r => IsLocalization.Away.algebraMap_isUnit (S := Localization.Away r) r
  have hAff_comp_apply : ∀ {X Y Z : S_K.AffineEtale} (f : X ⟶ Y) (g : Y ⟶ Z) (x : ↑Z.left.unop),
      (((f ≫ g).left.unop).hom) x = ((f.left.unop).hom) (((g.left.unop).hom) x) :=
    fun _ _ _ => rfl

  have hLoc_cover : ∀ (U : S_K.AffineEtale) {γ : Type} [Fintype γ] (d : γ → ↑U.left.unop),
      ∑ c : γ, d c = 1 →
      Sieve.ofArrows (fun c => W_loc U (d c)) (fun c => ι_loc U (d c)) ∈ J U := by
    intro U γ _ d hd_sum
    refine hCoverOfArrows U (fun c => W_loc U (d c)) (fun c => ι_loc U (d c))
      (fun c => hEt_loc U (d c)) (fun x => ?_)
    have hex_not_mem : ∃ c : γ, d c ∉ x.asIdeal := by
      by_contra hall
      have h1 : (1 : ↑U.left.unop) ∈ x.asIdeal := by
        rw [← hd_sum]
        exact Ideal.sum_mem x.asIdeal (fun c _ => not_not.mp (fun hnot => hall ⟨c, hnot⟩))
      exact x.isPrime.ne_top ((Ideal.eq_top_iff_one x.asIdeal).mpr h1)
    obtain ⟨c, hc⟩ := hex_not_mem
    have hx_basic : x ∈ (PrimeSpectrum.basicOpen (d c) : Set (PrimeSpectrum ↑U.left.unop)) :=
      (PrimeSpectrum.mem_basicOpen (d c) x).mpr hc
    rw [← PrimeSpectrum.localization_away_comap_range (Localization.Away (d c)) (d c)] at hx_basic
    obtain ⟨y, hy⟩ := hx_basic
    exact ⟨c, y, hy⟩

  have hLoc_factor : ∀ {Z U : S_K.AffineEtale} (f : Z ⟶ U) (r : ↑U.left.unop),
      ∃ m : W_loc Z (((f.left.unop).hom) r) ⟶ W_loc U r,
        m ≫ ι_loc U r = ι_loc Z (((f.left.unop).hom) r) ≫ f := by
    intro Z U f r
    let R := ↑U.left.unop
    let R_Z := ↑Z.left.unop
    let d : R_Z := ((f.left.unop).hom) r
    let g_ring : R →+* Localization.Away d :=
      (algebraMap R_Z (Localization.Away d)).comp ((f.left.unop).hom)
    have hu : IsUnit (g_ring r) := IsLocalization.Away.algebraMap_isUnit d
    let m_ring : Localization.Away r →+* Localization.Away d :=
      IsLocalization.Away.lift (S := Localization.Away r) r hu
    have hm_comp : m_ring.comp (algebraMap R (Localization.Away r)) = g_ring :=
      IsLocalization.Away.lift_comp (S := Localization.Away r) r hu
    let m_cat : CommRingCat.of (Localization.Away r) ⟶ CommRingCat.of (Localization.Away d) :=
      CommRingCat.ofHom m_ring
    have hcomm_cat : α_loc U r ≫ m_cat = f.left.unop ≫ α_loc Z d := CommRingCat.hom_ext hm_comp
    have hcomm_op : m_cat.op ≫ (α_loc U r).op = (α_loc Z d).op ≫ f.left := by
      rw [← op_comp, hcomm_cat, op_comp, Quiver.Hom.op_unop]
    have hw_m : Scheme.Spec.map m_cat.op ≫ (W_loc U r).hom = (W_loc Z d).hom := by
      change Spec.map m_cat ≫ Spec.map (α_loc U r) ≫ U.hom = Spec.map (α_loc Z d) ≫ Z.hom
      rw [← Category.assoc, ← Spec.map_comp, hcomm_cat, Spec.map_comp, Category.assoc]
      congr 1
      exact f.w
    let m : W_loc Z d ⟶ W_loc U r := MorphismProperty.CostructuredArrow.homMk m_cat.op trivial hw_m
    refine ⟨m, ?_⟩
    apply MorphismProperty.Comma.Hom.ext
    · exact hcomm_op
    · exact Subsingleton.elim _ _

  have hIdem_unit_eq_one : ∀ {R S : Type u} [CommRing R] [CommRing S] (φ : R →+* S) (e : R),
      e * e = e → IsUnit (φ e) → φ e = 1 := by
    intro R S _ _ φ e he_idem hu
    obtain ⟨w, hw⟩ := hu
    have hmul : (w : S) * φ e = (w : S) * 1 := by
      rw [hw, ← map_mul, he_idem, mul_one]
    exact Units.mul_right_inj w |>.mp hmul

  
  let toUnitVal : ∀ (U : S_K.AffineEtale), ↑(Mu_sh.obj.obj (Opposite.op U)) → ↑U.left.unop :=
    fun U u => Units.val (Additive.toMul (u.1 : Additive ((↑U.left.unop)ˣ)))
  have hu_pow : ∀ (U : S_K.AffineEtale) (u : ↑(Mu_sh.obj.obj (Opposite.op U))),
      (toUnitVal U u) ^ ℓ = 1 := by
    intro U u
    let u_add : Additive ((↑U.left.unop)ˣ) := u.1
    have h0 : ℓ • u_add = 0 := (hp_kum_app (Opposite.op U) u.1).symm.trans u.2
    have hmul : (Additive.toMul u_add) ^ ℓ = 1 := by
      apply Additive.ofMul.injective
      rw [ofMul_pow, ofMul_one]
      exact h0
    dsimp [toUnitVal, u_add]
    rw [← Units.val_pow_eq_pow_val]
    exact congrArg Units.val hmul

  let e_of : ∀ (U : S_K.AffineEtale) (u : ↑(Mu_sh.obj.obj (Opposite.op U))),
      ZMod ℓ → ↑U.left.unop :=
    fun U u => (hIdem (↑U.left.unop) (σ_U U) (toUnitVal U u) (hu_pow U u)).choose
  have he_of_spec : ∀ (U : S_K.AffineEtale) (u : ↑(Mu_sh.obj.obj (Opposite.op U))),
      (∑ j : ZMod ℓ, e_of U u j = 1) ∧
      (∀ i j : ZMod ℓ, i ≠ j → e_of U u i * e_of U u j = 0) ∧
      (∀ j : ZMod ℓ, e_of U u j * e_of U u j = e_of U u j) ∧
      (∑ j : ZMod ℓ, σ_U U (ν j) * e_of U u j = toUnitVal U u) :=
    fun U u =>
      (hIdem (↑U.left.unop) (σ_U U) (toUnitVal U u) (hu_pow U u)).choose_spec

  have he_unit_restrict : ∀ {Z U : S_K.AffineEtale} (q : Z ⟶ U)
      (u : ↑(Mu_sh.obj.obj (Opposite.op U))) (j : ZMod ℓ),
      IsUnit (((q.left.unop).hom) (e_of U u j)) →
      (Mu_sh.obj.map q.op).hom u = μ_const Z (up_ℓ j) := by
    intro Z U q u j hu_j
    obtain ⟨_, he_orth, he_idem, he_v⟩ := he_of_spec U u
    let φ := (q.left.unop).hom
    have hφ_j : φ (e_of U u j) = 1 := hIdem_unit_eq_one φ (e_of U u j) (he_idem j) hu_j
    have hφ_orth : ∀ i : ZMod ℓ, i ≠ j → φ (e_of U u i) = 0 := by
      intro i hij
      calc
        φ (e_of U u i) = φ (e_of U u i) * 1 := (mul_one _).symm
        _ = φ (e_of U u i) * φ (e_of U u j) := by rw [hφ_j]
        _ = φ (e_of U u i * e_of U u j) := (map_mul _ _ _).symm
        _ = 0 := by rw [he_orth i j hij, map_zero]
    apply Subtype.ext
    change Additive.ofMul
        (Units.map φ.toMonoidHom (Additive.toMul (u.1 : Additive ((↑U.left.unop)ˣ)))) =
      Additive.ofMul (μ_unit Z (up_ℓ j))
    congr 1
    apply Units.ext
    change φ (toUnitVal U u) = σ_U Z (ν j)
    rw [← he_v, map_sum, Finset.sum_eq_single j]
    · rw [map_mul, hφ_j, mul_one, hσ_comp q (ν j)]
    · intro i _ hij
      rw [map_mul, hφ_orth i hij, mul_zero]
    · intro hm
      exact False.elim (hm (Finset.mem_univ j))

  let S_of : ∀ (U : S_K.AffineEtale) (u : ↑(Mu_sh.obj.obj (Opposite.op U))), Sieve U :=
    fun U u => Sieve.ofArrows (fun j : ZMod ℓ => W_loc U (e_of U u j))
      (fun j : ZMod ℓ => ι_loc U (e_of U u j))
  have hS_of_mem : ∀ (U : S_K.AffineEtale) (u : ↑(Mu_sh.obj.obj (Opposite.op U))),
      S_of U u ∈ J U :=
    fun U u => hLoc_cover U (e_of U u) (he_of_spec U u).1
  have hex_S_of : ∀ {Y U : S_K.AffineEtale} {u : ↑(Mu_sh.obj.obj (Opposite.op U))} (f : Y ⟶ U),
      (S_of U u).arrows f → ∃ (j : ZMod ℓ) (m : Y ⟶ W_loc U (e_of U u j)),
        f = m ≫ ι_loc U (e_of U u j) :=
    fun _ hf => hOfArrows_unpack hf

  have hOrth_subsingleton : ∀ {Z U : S_K.AffineEtale} (u : ↑(Mu_sh.obj.obj (Opposite.op U)))
      {j₁ j₂ : ZMod ℓ} (hj : j₁ ≠ j₂)
      (m₁ : Z ⟶ W_loc U (e_of U u j₁)) (m₂ : Z ⟶ W_loc U (e_of U u j₂)),
      m₁ ≫ ι_loc U (e_of U u j₁) = m₂ ≫ ι_loc U (e_of U u j₂) →
      Subsingleton ↑Z.left.unop := by
    intro Z U u j₁ j₂ hj m₁ m₂ hcomm
    obtain ⟨_, he_orth, he_idem, _⟩ := he_of_spec U u
    let k : Z ⟶ U := m₁ ≫ ι_loc U (e_of U u j₁)
    have hk₁ : ((k.left.unop).hom) (e_of U u j₁) = 1 := by
      dsimp [k]
      rw [hAff_comp_apply,
        hIdem_unit_eq_one _ _ (he_idem j₁) (hι_loc_isUnit U (e_of U u j₁)),
        map_one]
    have hk₂ : ((k.left.unop).hom) (e_of U u j₂) = 1 := by
      have hk_eq : k = m₂ ≫ ι_loc U (e_of U u j₂) := hcomm
      rw [hk_eq, hAff_comp_apply,
        hIdem_unit_eq_one _ _ (he_idem j₂) (hι_loc_isUnit U (e_of U u j₂)),
        map_one]
    have h01 : (0 : ↑Z.left.unop) = 1 := by
      calc
        (0 : ↑Z.left.unop) = ((k.left.unop).hom) 0 := (map_zero _).symm
        _ = ((k.left.unop).hom) (e_of U u j₁ * e_of U u j₂) := by rw [he_orth j₁ j₂ hj]
        _ = ((k.left.unop).hom) (e_of U u j₁) * ((k.left.unop).hom) (e_of U u j₂) := map_mul _ _ _
        _ = 1 * 1 := by rw [hk₁, hk₂]
        _ = 1 := mul_one 1
    exact subsingleton_of_zero_eq_one h01

  let fam_of : ∀ (U : S_K.AffineEtale) (u : ↑(Mu_sh.obj.obj (Opposite.op U))),
      Presieve.FamilyOfElements (Const_ℓ.obj ⋙ forget AddCommGrpCat.{u}) (S_of U u).arrows :=
    fun U u Y f hf => ζ_sec Y (up_ℓ (hex_S_of f hf).choose)
  have hfam_of_compat : ∀ (U : S_K.AffineEtale) (u : ↑(Mu_sh.obj.obj (Opposite.op U))),
      (fam_of U u).Compatible := by
    intro U u Y₁ Y₂ Z g₁ g₂ f₁ f₂ hf₁ hf₂ hcomm
    change (Const_ℓ.obj.map g₁.op).hom (ζ_sec Y₁ (up_ℓ (hex_S_of f₁ hf₁).choose)) =
      (Const_ℓ.obj.map g₂.op).hom (ζ_sec Y₂ (up_ℓ (hex_S_of f₂ hf₂).choose))
    rw [hζ_sec_map, hζ_sec_map]
    set j₁ := (hex_S_of f₁ hf₁).choose
    set j₂ := (hex_S_of f₂ hf₂).choose
    by_cases hj : j₁ = j₂
    · rw [hj]
    · obtain ⟨m₁, hm₁⟩ := (hex_S_of f₁ hf₁).choose_spec
      obtain ⟨m₂, hm₂⟩ := (hex_S_of f₂ hf₂).choose_spec
      have hcomm' : (g₁ ≫ m₁) ≫ ι_loc U (e_of U u j₁) = (g₂ ≫ m₂) ≫ ι_loc U (e_of U u j₂) :=
        calc
          (g₁ ≫ m₁) ≫ ι_loc U (e_of U u j₁)
            = g₁ ≫ (m₁ ≫ ι_loc U (e_of U u j₁)) := Category.assoc _ _ _
          _ = g₁ ≫ f₁ := congrArg (g₁ ≫ ·) hm₁.symm
          _ = g₂ ≫ f₂ := hcomm
          _ = g₂ ≫ (m₂ ≫ ι_loc U (e_of U u j₂)) := congrArg (g₂ ≫ ·) hm₂
          _ = (g₂ ≫ m₂) ≫ ι_loc U (e_of U u j₂) := (Category.assoc _ _ _).symm
      have hSubZ : Subsingleton ↑Z.left.unop := hOrth_subsingleton u hj (g₁ ≫ m₁) (g₂ ≫ m₂) hcomm'
      exact @Subsingleton.elim _ (hSub_of_subsingleton Z hSubZ Const_ℓ) _ _

  let ψ_fun : ∀ (U : S_K.AffineEtale),
      ↑(Mu_sh.obj.obj (Opposite.op U)) → ↑(Const_ℓ.obj.obj (Opposite.op U)) :=
    fun U u => (hConst_type.isSheafFor (S_of U u) (hS_of_mem U u)).amalgamate
      (fam_of U u) (hfam_of_compat U u)

  have hψ_on_piece : ∀ (U : S_K.AffineEtale) (u : ↑(Mu_sh.obj.obj (Opposite.op U))) (j : ZMod ℓ),
      (Const_ℓ.obj.map (ι_loc U (e_of U u j)).op).hom (ψ_fun U u) =
        ζ_sec (W_loc U (e_of U u j)) (up_ℓ j) := by
    intro U u j
    have hmem : (S_of U u).arrows (ι_loc U (e_of U u j)) :=
      Sieve.ofArrows_mk (fun i : ZMod ℓ => W_loc U (e_of U u i))
        (fun i : ZMod ℓ => ι_loc U (e_of U u i)) j
    have hglue : (Const_ℓ.obj.map (ι_loc U (e_of U u j)).op).hom (ψ_fun U u) =
        fam_of U u (ι_loc U (e_of U u j)) hmem :=
      (hConst_type.isSheafFor (S_of U u) (hS_of_mem U u)).valid_glue
        (hfam_of_compat U u) (ι_loc U (e_of U u j)) hmem
    rw [hglue]
    dsimp [fam_of]
    set j' := (hex_S_of (ι_loc U (e_of U u j)) hmem).choose
    by_cases hjj : j' = j
    · rw [hjj]
    · obtain ⟨m, hm⟩ := (hex_S_of (ι_loc U (e_of U u j)) hmem).choose_spec
      have hcomm : m ≫ ι_loc U (e_of U u j') = 𝟙 _ ≫ ι_loc U (e_of U u j) := by
        rw [Category.id_comp, ← hm]
      have hSubW : Subsingleton ↑(W_loc U (e_of U u j)).left.unop :=
        hOrth_subsingleton u hjj m (𝟙 _) hcomm
      exact @Subsingleton.elim _ (hSub_of_subsingleton _ hSubW Const_ℓ) _ _

  have hMu_on_piece : ∀ (U : S_K.AffineEtale) (u : ↑(Mu_sh.obj.obj (Opposite.op U))) (j : ZMod ℓ),
      (Mu_sh.obj.map (ι_loc U (e_of U u j)).op).hom u =
        μ_const (W_loc U (e_of U u j)) (up_ℓ j) :=
    fun U u j => he_unit_restrict (ι_loc U (e_of U u j)) u j (hι_loc_isUnit U (e_of U u j))

  have hψ_spec : ∀ {Z U : S_K.AffineEtale} (g : Z ⟶ U) (u : ↑(Mu_sh.obj.obj (Opposite.op U)))
      (a : ↑A_ℓ),
      (Mu_sh.obj.map g.op).hom u = μ_const Z a →
      (Const_ℓ.obj.map g.op).hom (ψ_fun U u) = ζ_sec Z a := by
    intro Z U g u a hu_g
    let d_Z : ZMod ℓ → ↑Z.left.unop := fun k => ((g.left.unop).hom) (e_of U u k)
    have hd_Z_sum : ∑ k : ZMod ℓ, d_Z k = 1 := by
      dsimp [d_Z]
      rw [← map_sum, (he_of_spec U u).1, map_one]
    have hCov_Z : Sieve.ofArrows (fun k => W_loc Z (d_Z k)) (fun k => ι_loc Z (d_Z k)) ∈ J Z :=
      hLoc_cover Z d_Z hd_Z_sum
    apply (hConst_type.isSheafFor _ hCov_Z).isSeparatedFor.ext
    intro Y f hf
    obtain ⟨k, m₀, hf_eq⟩ := hOfArrows_unpack hf
    change (Const_ℓ.obj.map f.op).hom ((Const_ℓ.obj.map g.op).hom (ψ_fun U u)) =
      (Const_ℓ.obj.map f.op).hom (ζ_sec Z a)
    rw [hζ_sec_map]
    obtain ⟨m_k, hm_k⟩ := hLoc_factor g (e_of U u k)
    have hcomp_Y : f ≫ g = (m₀ ≫ m_k) ≫ ι_loc U (e_of U u k) := by
      rw [hf_eq, Category.assoc, ← hm_k, ← Category.assoc]
    have hLHS : (Const_ℓ.obj.map f.op).hom
        ((Const_ℓ.obj.map g.op).hom (ψ_fun U u)) = ζ_sec Y (up_ℓ k) := by
      change ((Const_ℓ.obj.map g.op ≫ Const_ℓ.obj.map f.op).hom)
        (ψ_fun U u) = ζ_sec Y (up_ℓ k)
      rw [← Const_ℓ.obj.map_comp, ← op_comp, hcomp_Y, op_comp, Const_ℓ.obj.map_comp]
      change (Const_ℓ.obj.map (m₀ ≫ m_k).op).hom
        ((Const_ℓ.obj.map (ι_loc U (e_of U u k)).op).hom (ψ_fun U u)) = ζ_sec Y (up_ℓ k)
      rw [hψ_on_piece, hζ_sec_map]
    rw [hLHS]
    have hμ_eq : μ_const Y (up_ℓ k) = μ_const Y a := by
      have h1 : (Mu_sh.obj.map ((m₀ ≫ m_k) ≫ ι_loc U (e_of U u k)).op).hom u =
          μ_const Y (up_ℓ k) := by
        rw [op_comp, Mu_sh.obj.map_comp]
        change (Mu_sh.obj.map (m₀ ≫ m_k).op).hom
          ((Mu_sh.obj.map (ι_loc U (e_of U u k)).op).hom u) = μ_const Y (up_ℓ k)
        rw [hMu_on_piece, hμ_const_map]
      have h2 : (Mu_sh.obj.map (f ≫ g).op).hom u = μ_const Y a := by
        rw [op_comp, Mu_sh.obj.map_comp]
        change (Mu_sh.obj.map f.op).hom ((Mu_sh.obj.map g.op).hom u) = μ_const Y a
        rw [hu_g, hμ_const_map]
      rw [← h1, ← hcomp_Y, h2]
    by_cases hSubY : Subsingleton ↑Y.left.unop
    · exact @Subsingleton.elim _ (hSub_of_subsingleton Y hSubY Const_ℓ) _ _
    · have : Nontrivial ↑Y.left.unop := not_subsingleton_iff_nontrivial.mp hSubY
      rw [hμ_const_inj Y hμ_eq]

  have hψ_zero : ∀ U : S_K.AffineEtale, ψ_fun U 0 = 0 := by
    intro U
    have h1 : (Const_ℓ.obj.map (𝟙 U).op).hom (ψ_fun U 0) = ζ_sec U 0 := by
      apply hψ_spec (𝟙 U) 0 0
      rw [op_id, Mu_sh.obj.map_id, hμ_const_zero]
      rfl
    rw [op_id, Const_ℓ.obj.map_id] at h1
    exact h1.trans (hζ_sec_zero U)

  have hψ_add : ∀ (U : S_K.AffineEtale) (u₁ u₂ : ↑(Mu_sh.obj.obj (Opposite.op U))),
      ψ_fun U (u₁ + u₂) = ψ_fun U u₁ + ψ_fun U u₂ := by
    intro U u₁ u₂
    let d₁₂ : ZMod ℓ × ZMod ℓ → ↑U.left.unop := fun p => e_of U u₁ p.1 * e_of U u₂ p.2
    have hd₁₂_sum : ∑ p : ZMod ℓ × ZMod ℓ, d₁₂ p = 1 := by
      dsimp [d₁₂]
      rw [Fintype.sum_prod_type, ← Finset.sum_mul_sum, (he_of_spec U u₁).1,
        (he_of_spec U u₂).1, mul_one]
    have hCov₁₂ :
        Sieve.ofArrows (fun p => W_loc U (d₁₂ p)) (fun p => ι_loc U (d₁₂ p)) ∈ J U :=
      hLoc_cover U d₁₂ hd₁₂_sum
    apply (hConst_type.isSheafFor _ hCov₁₂).isSeparatedFor.ext
    intro Y f hf
    obtain ⟨p, m₀, hf_eq⟩ := hOfArrows_unpack hf
    let q_p : W_loc U (d₁₂ p) ⟶ U := ι_loc U (d₁₂ p)
    have hu_prod : IsUnit (((q_p.left.unop).hom) (e_of U u₁ p.1) *
        ((q_p.left.unop).hom) (e_of U u₂ p.2)) := by
      rw [← map_mul]
      exact hι_loc_isUnit U (d₁₂ p)
    have hu₁_p : (Mu_sh.obj.map q_p.op).hom u₁ = μ_const (W_loc U (d₁₂ p)) (up_ℓ p.1) :=
      he_unit_restrict q_p u₁ p.1 (isUnit_of_mul_isUnit_left hu_prod)
    have hu₂_p : (Mu_sh.obj.map q_p.op).hom u₂ = μ_const (W_loc U (d₁₂ p)) (up_ℓ p.2) :=
      he_unit_restrict q_p u₂ p.2 (isUnit_of_mul_isUnit_right hu_prod)
    have hu₁₂_p : (Mu_sh.obj.map q_p.op).hom (u₁ + u₂) =
        μ_const (W_loc U (d₁₂ p)) (up_ℓ p.1 + up_ℓ p.2) := by
      rw [map_add, hu₁_p, hu₂_p, ← hμ_const_add]
    have hψ₁ : (Const_ℓ.obj.map q_p.op).hom (ψ_fun U u₁) =
        ζ_sec (W_loc U (d₁₂ p)) (up_ℓ p.1) :=
      hψ_spec q_p u₁ (up_ℓ p.1) hu₁_p
    have hψ₂ : (Const_ℓ.obj.map q_p.op).hom (ψ_fun U u₂) =
        ζ_sec (W_loc U (d₁₂ p)) (up_ℓ p.2) :=
      hψ_spec q_p u₂ (up_ℓ p.2) hu₂_p
    have hψ₁₂ : (Const_ℓ.obj.map q_p.op).hom (ψ_fun U (u₁ + u₂)) =
        ζ_sec (W_loc U (d₁₂ p)) (up_ℓ p.1 + up_ℓ p.2) :=
      hψ_spec q_p (u₁ + u₂) (up_ℓ p.1 + up_ℓ p.2) hu₁₂_p
    change (Const_ℓ.obj.map f.op).hom (ψ_fun U (u₁ + u₂)) =
      (Const_ℓ.obj.map f.op).hom (ψ_fun U u₁ + ψ_fun U u₂)
    rw [hf_eq, op_comp, Const_ℓ.obj.map_comp]
    change (Const_ℓ.obj.map m₀.op).hom ((Const_ℓ.obj.map q_p.op).hom (ψ_fun U (u₁ + u₂))) =
      (Const_ℓ.obj.map m₀.op).hom ((Const_ℓ.obj.map q_p.op).hom (ψ_fun U u₁ + ψ_fun U u₂))
    rw [hψ₁₂, map_add, hψ₁, hψ₂, ← hζ_sec_add]

  have hψ_nat : ∀ {Y U : S_K.AffineEtale} (f : Y ⟶ U) (u : ↑(Mu_sh.obj.obj (Opposite.op U))),
      (Const_ℓ.obj.map f.op).hom (ψ_fun U u) = ψ_fun Y ((Mu_sh.obj.map f.op).hom u) := by
    intro Y U f u
    let u_Y := (Mu_sh.obj.map f.op).hom u
    apply (hConst_type.isSheafFor (S_of Y u_Y) (hS_of_mem Y u_Y)).isSeparatedFor.ext
    intro Z g hg
    obtain ⟨j, m₀, hg_eq⟩ := hOfArrows_unpack hg
    let q_j : W_loc Y (e_of Y u_Y j) ⟶ Y := ι_loc Y (e_of Y u_Y j)
    have hu_qj : (Mu_sh.obj.map (q_j ≫ f).op).hom u =
        μ_const (W_loc Y (e_of Y u_Y j)) (up_ℓ j) := by
      rw [op_comp, Mu_sh.obj.map_comp]
      change (Mu_sh.obj.map q_j.op).hom u_Y = μ_const (W_loc Y (e_of Y u_Y j)) (up_ℓ j)
      exact hMu_on_piece Y u_Y j
    have hLHS_q : (Const_ℓ.obj.map q_j.op).hom ((Const_ℓ.obj.map f.op).hom (ψ_fun U u)) =
        ζ_sec (W_loc Y (e_of Y u_Y j)) (up_ℓ j) := by
      have hspec := hψ_spec (q_j ≫ f) u (up_ℓ j) hu_qj
      rw [op_comp, Const_ℓ.obj.map_comp] at hspec
      exact hspec
    change (Const_ℓ.obj.map g.op).hom ((Const_ℓ.obj.map f.op).hom (ψ_fun U u)) =
      (Const_ℓ.obj.map g.op).hom (ψ_fun Y u_Y)
    rw [hg_eq, op_comp, Const_ℓ.obj.map_comp]
    change (Const_ℓ.obj.map m₀.op).hom
        ((Const_ℓ.obj.map q_j.op).hom ((Const_ℓ.obj.map f.op).hom (ψ_fun U u))) =
      (Const_ℓ.obj.map m₀.op).hom ((Const_ℓ.obj.map q_j.op).hom (ψ_fun Y u_Y))
    rw [hLHS_q, hψ_on_piece Y u_Y j]

  let Ψ : Mu_sh ⟶ Const_ℓ :=
    { hom :=
        { app := fun V => AddCommGrpCat.ofHom
            { toFun := ψ_fun V.unop
              map_zero' := hψ_zero V.unop
              map_add' := hψ_add V.unop }
          naturality := fun _ _ g => AddCommGrpCat.hom_ext (AddMonoidHom.ext fun u =>
            (hψ_nat g.unop u).symm) } }

  have hΦΨ : Φ ≫ Ψ = 𝟙 Const_ℓ := by
    apply (adj.homEquiv A_ℓ Const_ℓ).injective
    change η ≫ (Φ ≫ Ψ).hom.app (Opposite.op T_aff) = η ≫ 𝟙 (Const_ℓ.obj.obj (Opposite.op T_aff))
    have hcomp_app : (Φ ≫ Ψ).hom.app (Opposite.op T_aff) =
        Φ.hom.app (Opposite.op T_aff) ≫ Ψ.hom.app (Opposite.op T_aff) := rfl
    rw [Category.comp_id, hcomp_app, ← Category.assoc, hηΦ]
    apply AddCommGrpCat.ext
    intro a
    change ψ_fun T_aff (μ_const T_aff a) = η.hom a
    have h1 : (Const_ℓ.obj.map (𝟙 T_aff).op).hom (ψ_fun T_aff (μ_const T_aff a)) =
        ζ_sec T_aff a := by
      apply hψ_spec (𝟙 T_aff) (μ_const T_aff a) a
      rw [op_id, Mu_sh.obj.map_id]
      rfl
    rw [op_id, Const_ℓ.obj.map_id] at h1
    exact h1.trans (hζ_sec_T a)

  have hΨΦ : Ψ ≫ Φ = 𝟙 Mu_sh := by
    ext V : 3
    apply AddCommGrpCat.ext
    intro u
    let U : S_K.AffineEtale := V.unop
    change (Φ.hom.app (Opposite.op U)).hom (ψ_fun U u) = u
    apply (hMu_type.isSheafFor (S_of U u) (hS_of_mem U u)).isSeparatedFor.ext
    intro Z g hg
    obtain ⟨j, m₀, hg_eq⟩ := hOfArrows_unpack hg
    let q_j : W_loc U (e_of U u j) ⟶ U := ι_loc U (e_of U u j)
    change (Mu_sh.obj.map g.op).hom ((Φ.hom.app (Opposite.op U)).hom (ψ_fun U u)) =
      (Mu_sh.obj.map g.op).hom u
    have hnat : (Mu_sh.obj.map g.op).hom ((Φ.hom.app (Opposite.op U)).hom (ψ_fun U u)) =
        (Φ.hom.app (Opposite.op Z)).hom ((Const_ℓ.obj.map g.op).hom (ψ_fun U u)) :=
      (congrArg
        (fun k : Const_ℓ.obj.obj (Opposite.op U) ⟶ Mu_sh.obj.obj (Opposite.op Z) =>
          k.hom (ψ_fun U u))
        (Φ.hom.naturality g.op)).symm
    rw [hnat, hg_eq, op_comp, Const_ℓ.obj.map_comp, Mu_sh.obj.map_comp]
    change (Φ.hom.app (Opposite.op Z)).hom
        ((Const_ℓ.obj.map m₀.op).hom ((Const_ℓ.obj.map q_j.op).hom (ψ_fun U u))) =
      (Mu_sh.obj.map m₀.op).hom ((Mu_sh.obj.map q_j.op).hom u)
    rw [hψ_on_piece U u j, hζ_sec_map, hΦ_ζ Z (up_ℓ j), hMu_on_piece U u j, hμ_const_map]

  
  
  
  let e_μ : Const_ℓ ≅ Mu_sh := ⟨Φ, Ψ, hΦΨ, hΨΦ⟩
  let ι_kum : Const_ℓ ⟶ Gm_K := Φ ≫ ι_μ
  have h0 : ι_kum ≫ p_kum = 0 := by
    change (Φ ≫ ι_μ) ≫ p_kum = 0
    rw [Category.assoc, h0_μ, Limits.comp_zero]
  have : CategoryTheory.Mono Φ :=
    ⟨fun {_} α β hαβ => by
      calc
        α = α ≫ 𝟙 Const_ℓ := (Category.comp_id α).symm
        _ = α ≫ (Φ ≫ Ψ) := by rw [hΦΨ]
        _ = (α ≫ Φ) ≫ Ψ := (Category.assoc α Φ Ψ).symm
        _ = (β ≫ Φ) ≫ Ψ := by rw [hαβ]
        _ = β ≫ (Φ ≫ Ψ) := Category.assoc β Φ Ψ
        _ = β ≫ 𝟙 Const_ℓ := by rw [hΦΨ]
        _ = β := Category.comp_id β⟩
  have hMono : CategoryTheory.Mono ι_kum := mono_comp Φ ι_μ
  let SC_kum : ShortComplex (Sheaf J AddCommGrpCat.{u}) := ShortComplex.mk ι_kum p_kum h0
  let isoSC : SC_μ ≅ SC_kum :=
    ShortComplex.isoMk e_μ.symm (Iso.refl Gm_K) (Iso.refl Gm_K)
      (e_μ.inv_hom_id_assoc ι_μ)
      ((Category.comp_id p_kum).trans (Category.id_comp p_kum).symm)
  have hExact : SC_kum.Exact := (ShortComplex.exact_iff_of_iso isoSC).mp hExact_μ
  exact ⟨ι_kum, h0, ShortComplex.ShortExact.mk' hExact hMono hEpi⟩

theorem weil_alt_cd_c1_kummer_gm_torsion_vanishing (K : Type u) [Field K]
    (ℓ s : ℕ) [Fact (Nat.Prime ℓ)] (hs : 2 ≤ s)
    (hRoots : ∃ ζ : K, ζ ^ ℓ = 1 ∧ ζ ≠ 1)
    (hNormSurj : ∀ (E₁ E₂ : Type u) [Field E₁] [Algebra K E₁] [FiniteDimensional K E₁]
      [Field E₂] [Algebra E₁ E₂] [FiniteDimensional E₁ E₂] (c : E₁),
      ∃ y : E₂, Algebra.norm E₁ y = c) :
    Subsingleton (weilEtaleTorsionH (AlgebraicGeometry.Spec (CommRingCat.of K)) ℓ s) :=
by
  have hGm : ∀ (F : Type u) [Field F],
      CategoryTheory.Presheaf.IsSheaf (weilC1AffEtTop F) (weilC1AffEtGmPresheaf F) :=
    fun F _ => weil_c1_affEt_gm_isSheaf F
  obtain ⟨res, hResBij, hResComp, hResNorm, hResGal, hResCyc⟩ :=
    weil_c1_affEt_gm_restriction_norm_and_cyclic_exact hGm
  have hGmVanish : ∀ (q : ℕ), 1 ≤ q →
      ∀ (E : Type u) [Field E] [Algebra K E] [FiniteDimensional K E] [Algebra.IsSeparable K E],
        Subsingleton ((weilC1AffEtGmSheaf E (hGm E)).H q) := by
    intro q
    induction q using Nat.strongRecOn with
    | ind q ih_q =>
      intro hq1
      rcases eq_or_lt_of_le hq1 with rfl | hq_gt1
      · intro E _ _ _ _
        exact weil_c1_affEt_hilbert90_gm_H1_vanishing hGm E
      · have hq2 : 2 ≤ q := hq_gt1
        have hResPrime : ∀ (E₁ E₂ : Type u) [Field E₁] [Algebra K E₁]
            [FiniteDimensional K E₁] [Algebra.IsSeparable K E₁]
            [Field E₂] [Algebra E₁ E₂] [FiniteDimensional E₁ E₂] [IsGalois E₁ E₂]
            (p : ℕ), Nat.Prime p → Module.finrank E₁ E₂ = p →
            ∀ ξ : (weilC1AffEtGmSheaf E₁ (hGm E₁)).H q,
              @res E₁ E₂ _ _ _ _ (@IsGalois.to_isSeparable E₁ _ E₂ _ _ _) q ξ = 0 → ξ = 0 := by
          intro E₁ E₂ _ _ _ _ _ _ _ _ p hp hdeg ξ hξ
          have : Algebra.IsSeparable E₁ E₂ := IsGalois.to_isSeparable
          let _ : Algebra K E₂ := RingHom.toAlgebra ((algebraMap E₁ E₂).comp (algebraMap K E₁))
          have : IsScalarTower K E₁ E₂ := IsScalarTower.of_algebraMap_eq' rfl
          have : FiniteDimensional K E₂ := Module.Finite.trans E₁ E₂
          have : Algebra.IsSeparable K E₂ := Algebra.IsSeparable.trans K E₁ E₂
          rcases eq_or_lt_of_le hq2 with rfl | hq_gt2
          · exact (hResCyc E₁ E₂ p hp hdeg).1
              (weil_c1_affEt_hilbert90_gm_H1_vanishing hGm E₂)
              (hNormSurj E₁ E₂) ξ hξ
          · have hq3 : 3 ≤ q := hq_gt2
            have hSub2 : Subsingleton ((weilC1AffEtGmSheaf E₁ (hGm E₁)).H (q - 2)) :=
              ih_q (q - 2) (by omega) (by omega) E₁
            have hSub1 : Subsingleton ((weilC1AffEtGmSheaf E₂ (hGm E₂)).H (q - 1)) :=
              ih_q (q - 1) (by omega) (by omega) E₂
            exact (hResCyc E₁ E₂ p hp hdeg).2 q hq3 hSub2 hSub1 ξ hξ
        have hPGroup : ∀ (p : ℕ), Nat.Prime p → ∀ (k : ℕ)
            (E₁ : Type u) [Field E₁] [Algebra K E₁]
            [FiniteDimensional K E₁] [Algebra.IsSeparable K E₁]
            (L : Type u) [Field L] [Algebra E₁ L] [FiniteDimensional E₁ L] [IsGalois E₁ L],
            Module.finrank E₁ L = p ^ k →
            ∀ ξ₁ : (weilC1AffEtGmSheaf E₁ (hGm E₁)).H q,
              @res E₁ L _ _ _ _ (@IsGalois.to_isSeparable E₁ _ L _ _ _) q ξ₁ = 0 → ξ₁ = 0 := by
          intro p hp k
          have : Fact (Nat.Prime p) := ⟨hp⟩
          induction k with
          | zero =>
            intro E₁ _ _ _ _ L _ _ _ _ hdeg ξ₁ hξ₁
            have : Algebra.IsSeparable E₁ L := IsGalois.to_isSeparable
            have hBij : Function.Bijective (algebraMap E₁ L) := by
              let φ : E₁ →ₗ[E₁] L := Algebra.linearMap E₁ L
              have hInj : Function.Injective φ := (algebraMap E₁ L).injective
              have hEqRank : Module.finrank E₁ E₁ = Module.finrank E₁ L := by
                rw [Module.finrank_self, hdeg, pow_zero]
              exact ⟨hInj,
