        CategoryTheory.Injective.factorThru ψ
          (M • CategoryTheory.CategoryStruct.id (weilPolyP1CohomologyRepSheaf Y V))
      have hfac : (M • CategoryTheory.CategoryStruct.id (weilPolyP1CohomologyRepSheaf Y V)) ≫ ξ = ψ :=
        CategoryTheory.Injective.comp_factorThru ψ
          (M • CategoryTheory.CategoryStruct.id (weilPolyP1CohomologyRepSheaf Y V))
      have hξα : ξ ≫ α = ψ := by
        calc
          ξ ≫ α = M • (ξ ≫ CategoryTheory.CategoryStruct.id 𝒥) :=
            CategoryTheory.Preadditive.comp_nsmul _ _ _
          _ = M • ξ := by rw [CategoryTheory.Category.comp_id]
          _ = M • (CategoryTheory.CategoryStruct.id (weilPolyP1CohomologyRepSheaf Y V) ≫ ξ) := by
            rw [CategoryTheory.Category.id_comp]
          _ = (M • CategoryTheory.CategoryStruct.id (weilPolyP1CohomologyRepSheaf Y V)) ≫ ξ :=
            (CategoryTheory.Preadditive.nsmul_comp _ _ _).symm
