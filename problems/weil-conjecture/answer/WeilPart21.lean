by
  obtain ⟨hCont₁, hCont₂, hAdd₁, hLim₁, hColim₁,
      res, η_Gm, hEta, hResBij, hResComp, hResOfPullZero, hResZeroCompEta, hPushSub⟩ :=
    weil_c1_affEt_sep_adjunction_and_pullback_cohomology hGm
