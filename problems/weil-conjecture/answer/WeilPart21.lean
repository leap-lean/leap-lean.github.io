            have hu_ry : IsUnit r_y := hGerm_isUnit q' g hg_not_q'
            have hDQ_val : D_Q ⟨ι_aff.base q'_raw, hx_R_cl⟩ = (0 : ℤ) - (0 : ℤ) := by
              simp only [D_Q, Finsupp.coe_add, Pi.add_apply,
                Finsupp.single_eq_of_ne hRQ,
                Finsupp.single_eq_of_ne hR_inf, add_zero, sub_self]
            have hspan_r : Ideal.span ({r_y} : Set R_y) = (IsLocalRing.maximalIdeal R_y) ^ 0 := by
              rw [pow_zero, Ideal.one_eq_top, Ideal.span_singleton_eq_top]
              exact hu_ry
            have hspan_1 : Ideal.span ({(1 : R_y)} : Set R_y) = (IsLocalRing.maximalIdeal R_y) ^ 0 := by
              rw [pow_zero, Ideal.one_eq_top, Ideal.span_singleton_one]
            exact ⟨r_y, 1, 0, 0, hr_y_ne, one_ne_zero, hr_y_ff, hspan_r, hspan_1, hDQ_val⟩
      have hDQ_zero : QuotientAddGroup.mk' (@weilCurvePrincipalSubgroup C.left hIntC) D_Q = 0 :=
        (QuotientAddGroup.eq_zero_iff D_Q).mpr hDQ_prin
      have hdeg0 : deg_Cl (QuotientAddGroup.mk' (@weilCurvePrincipalSubgroup C.left hIntC) D_Q) = 0 := by
        rw [hDQ_zero, map_zero]
      have hdeg_calc : deg_Cl (QuotientAddGroup.mk' (@weilCurvePrincipalSubgroup C.left hIntC) D_Q) =
          1 + m_Q := by
        dsimp only [D_Q]
        rw [map_add, map_add, hdeg_sum, hdeg_sum, Finsupp.sum_single_index rfl,
          Finsupp.sum_single_index rfl]
      have hm_Q_eq : m_Q = -1 := by linarith
      have hdiff_eq : Finsupp.single Q (1 : ℤ) - Finsupp.single P_inf (1 : ℤ) = D_Q := by
        dsimp only [D_Q]
        rw [hm_Q_eq, sub_eq_add_neg, ← Finsupp.single_neg]
      rw [← sub_eq_zero, ← map_sub, hdiff_eq, hDQ_zero]
  let c_inf : @weilCurveClGroup C.left hIntC :=
    QuotientAddGroup.mk' (@weilCurvePrincipalSubgroup C.left hIntC) (Finsupp.single P_inf 1)
  have hdeg_c_inf : deg_Cl c_inf = 1 := by
    dsimp only [c_inf]
    rw [hdeg_sum, Finsupp.sum_single_index rfl]
  have hCl_span : ∀ c : @weilCurveClGroup C.left hIntC, deg_Cl c • c_inf = c := by
    intro c
    obtain ⟨D, rfl⟩ := QuotientAddGroup.mk'_surjective _ c
    induction D using Finsupp.induction_linear with
    | zero =>
      rw [map_zero, map_zero, zero_zsmul]
    | add D₁ D₂ ih₁ ih₂ =>
      rw [map_add, map_add, add_zsmul, ih₁, ih₂]
    | single Q n =>
      have hsingle_n : Finsupp.single Q n = n • Finsupp.single Q (1 : ℤ) := by
        ext R
        by_cases h : R = Q
        · subst h; simp
        · simp [h]
      rw [hsingle_n, map_zsmul, hClass_eq_inf Q, map_zsmul, hdeg_c_inf]
      exact congrArg (· • c_inf) (mul_one n)
  have hdeg_zsmul : ∀ z : ℤ, deg_Cl (z • c_inf) = z := by
    intro z
    rw [map_zsmul, hdeg_c_inf]
    simp
  have hBij_deg : Function.Bijective deg_Cl :=
    ⟨fun c₁ c₂ h => by rw [← hCl_span c₁, ← hCl_span c₂, h],
     fun z => ⟨z • c_inf, hdeg_zsmul z⟩⟩
  
  let U₂ : C.left.Opens := ⟨({P_orig} : Set ↥C.left)ᶜ, hCl_orig.isOpen_compl⟩
  have hcov : U₁ ⊔ U₂ = ⊤ := by
    ext y
    simp only [TopologicalSpace.Opens.coe_sup, Set.mem_union, TopologicalSpace.Opens.coe_top,
      Set.mem_univ, iff_true]
    by_cases hy : y = P_orig
    · left; rw [hy]; exact hP_mem
    · right; exact hy
  let g_sec : ↑(C.left.presheaf.obj (Opposite.op U₁)) := φ_poly.hom Polynomial.X
  have hMax_orig : Ideal.span {(C.left.presheaf.germ U₁ P_orig hP_mem).hom g_sec} =
      IsLocalRing.maximalIdeal ↑(C.left.presheaf.stalk P_orig) :=
    hGerm_span_max q₀ Polynomial.X hq₀_max hq₀_ideal
  have hU₁₂_le_bo : U₁ ⊓ U₂ ≤ C.left.basicOpen g_sec := by
    intro z hz
    rcases hz with ⟨⟨q_raw, rfl⟩, hz_ne⟩
    let q : PrimeSpectrum (Polynomial k) := q_raw
    have hq_ne_q₀ : q ≠ q₀ := fun heq => hz_ne
      (congrArg (fun p : PrimeSpectrum (Polynomial k) => ι_aff.base (p : ↥A_1)) heq)
    have hX_not : Polynomial.X ∉ q.asIdeal := by
      intro hmem
      have hle : q₀.asIdeal ≤ q.asIdeal := by
        rw [hq₀_ideal, Ideal.span_singleton_le_iff_mem]
        exact hmem
      exact hq_ne_q₀ (PrimeSpectrum.ext (hq₀_max.eq_of_le q.isPrime.ne_top hle).symm)
    exact (C.left.toRingedSpace.mem_basicOpen g_sec (ι_aff.base q_raw) ⟨q_raw, rfl⟩).mpr
      (hGerm_isUnit q Polynomial.X hX_not)
  have hUnit_bo : IsUnit
      ((C.left.presheaf.map
        (CategoryTheory.homOfLE (C.left.basicOpen_le g_sec)).op).hom g_sec) :=
    C.left.toRingedSpace.isUnit_res_basicOpen g_sec
  have hUnit_U₁₂ : IsUnit
      ((C.left.presheaf.map
        (CategoryTheory.homOfLE (inf_le_left : U₁ ⊓ U₂ ≤ U₁)).op).hom g_sec) := by
    have hcomp : CategoryTheory.homOfLE (inf_le_left : U₁ ⊓ U₂ ≤ U₁) =
        CategoryTheory.homOfLE hU₁₂_le_bo ≫
          CategoryTheory.homOfLE (C.left.basicOpen_le g_sec) := rfl
    rw [hcomp, op_comp, C.left.presheaf.map_comp]
    exact hUnit_bo.map ((C.left.presheaf.map (CategoryTheory.homOfLE hU₁₂_le_bo).op).hom).toMonoidHom
  let u₁₂ : Units ↑(C.left.presheaf.obj (Opposite.op (U₁ ⊓ U₂))) := hUnit_U₁₂.unit
  refine ⟨hBij_deg, ?_, U₁, U₂, hcov, P_orig, hCl_orig, hP_mem, g_sec, u₁₂,
    rfl, rfl, hMax_orig, ?_⟩
  · intro s hs
    have hCl_s : IsClosed ({s.base pt₀} : Set ↥C.left) := hClosed_sec s hs
    refine ⟨pt₀, hCl_s, ?_⟩
    have h_eq_c : QuotientAddGroup.mk' (@weilCurvePrincipalSubgroup C.left hIntC)
        (Finsupp.single ⟨s.base pt₀, hCl_s⟩ 1) = c_inf :=
      hClass_eq_inf ⟨s.base pt₀, hCl_s⟩
    rw [h_eq_c]
    exact ⟨hdeg_c_inf,
           fun z₁ z₂ hz => by
             rw [← hdeg_zsmul z₁, ← hdeg_zsmul z₂]
             exact congrArg deg_Cl hz,
           fun c => ⟨deg_Cl c, hCl_span c⟩⟩
  · intro ν
    let U'₁ : C.left.Opens := (TopologicalSpace.Opens.map ν.hom.base).obj U₁
    let U'₂ : C.left.Opens := (TopologicalSpace.Opens.map ν.hom.base).obj U₂
    let P'_orig : ↥C.left := ν.inv.base P_orig
    let g'_sec : ↑(C.left.presheaf.obj (Opposite.op U'₁)) := (ν.hom.app U₁).hom g_sec
    let u'₁₂ : Units ↑(C.left.presheaf.obj (Opposite.op (U'₁ ⊓ U'₂))) :=
      Units.map ((C.left.presheaf.map (CategoryTheory.eqToHom
        (rfl : U'₁ ⊓ U'₂ = (TopologicalSpace.Opens.map ν.hom.base).obj (U₁ ⊓ U₂))).op).hom.comp
          (ν.hom.app (U₁ ⊓ U₂)).hom).toMonoidHom u₁₂
    have h_hom_inv : ∀ y : ↥C.left, ν.inv.base (ν.hom.base y) = y := fun y =>
      congrFun (congrArg (fun f : C.left ⟶ C.left => ⇑f.base) ν.hom_inv_id) y
    have h_inv_hom : ∀ y : ↥C.left, ν.hom.base (ν.inv.base y) = y := fun y =>
      congrFun (congrArg (fun f : C.left ⟶ C.left => ⇑f.base) ν.inv_hom_id) y
    have hcov' : U'₁ ⊔ U'₂ = ⊤ := by
      ext y
      simp only [TopologicalSpace.Opens.coe_sup, Set.mem_union, TopologicalSpace.Opens.coe_top,
        Set.mem_univ, iff_true]
      have hy : ν.hom.base y ∈ (U₁ ⊔ U₂ : C.left.Opens) := by rw [hcov]; trivial
      exact hy
    have hP'_mem : P'_orig ∈ U'₁ := by
      change ν.hom.base P'_orig ∈ U₁
      rw [h_inv_hom P_orig]
      exact hP_mem
    have hU'₂_compl : (U'₂ : Set ↥C.left) = ({P'_orig} : Set ↥C.left)ᶜ := by
      ext y
      change ν.hom.base y ≠ P_orig ↔ y ≠ P'_orig
      exact ⟨fun hne hy => hne (by rw [hy, h_inv_hom]),
             fun hne h => hne (by rw [← h_hom_inv y, h])⟩
    have hCl'_orig : IsClosed ({P'_orig} : Set ↥C.left) := by
      rw [← compl_compl ({P'_orig} : Set ↥C.left), ← hU'₂_compl]
      exact U'₂.isOpen.isClosed_compl
    have hg'_u :
        (C.left.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U'₁ ⊓ U'₂ ≤ U'₁)).op).hom g'_sec =
          (u'₁₂ : ↑(C.left.presheaf.obj (Opposite.op (U'₁ ⊓ U'₂)))) := by
      have hnat := ConcreteCategory.congr_hom
        (ν.hom.naturality (CategoryTheory.homOfLE (inf_le_left : U₁ ⊓ U₂ ≤ U₁)).op) g_sec
      exact hnat.symm.trans (by
        dsimp only [u'₁₂]
        rw [CategoryTheory.eqToHom_refl, op_id, C.left.presheaf.map_id]
        rfl)
    have hMax'_orig :
        Ideal.span {(C.left.presheaf.germ U'₁ P'_orig hP'_mem).hom g'_sec} =
          IsLocalRing.maximalIdeal ↑(C.left.presheaf.stalk P'_orig) := by
      have hP_eq : ν.hom.base P'_orig = P_orig := h_inv_hom P_orig
      haveI : AlgebraicGeometry.IsOpenImmersion ν.hom := inferInstance
      let iso_ν : C.left.presheaf.stalk P_orig ≅ C.left.presheaf.stalk P'_orig :=
        (C.left.presheaf.stalkCongr (Inseparable.of_eq hP_eq.symm)).trans
          (asIso (ν.hom.stalkMap P'_orig))
      let e_ν : ↑(C.left.presheaf.stalk P_orig) ≃+* ↑(C.left.presheaf.stalk P'_orig) :=
        CategoryTheory.Iso.commRingCatIsoToRingEquiv iso_ν
      have he_ν_germ :
          e_ν ((C.left.presheaf.germ U₁ P_orig hP_mem).hom g_sec) =
            (C.left.presheaf.germ U'₁ P'_orig hP'_mem).hom g'_sec := by
        have hg_sp :
            C.left.presheaf.germ U₁ P_orig hP_mem ≫
              (C.left.presheaf.stalkCongr (Inseparable.of_eq hP_eq.symm)).hom =
              C.left.presheaf.germ U₁ (ν.hom.base P'_orig) hP'_mem := by
          rw [TopCat.Presheaf.stalkCongr_hom]
          exact C.left.presheaf.germ_stalkSpecializes hP_mem (specializes_of_eq hP_eq)
        have hcomp_ν :
            C.left.presheaf.germ U₁ P_orig hP_mem ≫ iso_ν.hom =
              ν.hom.app U₁ ≫ C.left.presheaf.germ U'₁ P'_orig hP'_mem := by
          dsimp only [iso_ν, Iso.trans_hom, asIso_hom]
          rw [← CategoryTheory.Category.assoc, hg_sp]
          exact AlgebraicGeometry.Scheme.Hom.germ_stalkMap ν.hom U₁ P'_orig hP'_mem
        exact ConcreteCategory.congr_hom hcomp_ν g_sec
      have hmap_span : Ideal.map e_ν
          (Ideal.span {(C.left.presheaf.germ U₁ P_orig hP_mem).hom g_sec}) =
          Ideal.span {(C.left.presheaf.germ U'₁ P'_orig hP'_mem).hom g'_sec} := by
        rw [Ideal.map_span, Set.image_singleton]
        exact congrArg (fun x => Ideal.span {x}) he_ν_germ
      have hmax_ν : (Ideal.map e_ν
          (IsLocalRing.maximalIdeal ↑(C.left.presheaf.stalk P_orig))).IsMaximal :=
        Ideal.map_isMaximal_of_equiv e_ν
      rw [IsLocalRing.isMaximal_iff] at hmax_ν
      rw [← hmap_span, hMax_orig, hmax_ν]
    exact ⟨hcov', hCl'_orig, hP'_mem, hU'₂_compl, hg'_u, hMax'_orig⟩

theorem weil_etale_two_open_gm_class_pullback_and_pinned_kummer_nat (k : Type u) [CommRing k]
    (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hGm : ∀ Z : AlgebraicGeometry.Scheme.{u},
      CategoryTheory.Presheaf.IsSheaf Z.smallEtaleTopology (weilEtaleGmPresheaf Z)) :
    ∃ (Ξ_Y : ∀ (U₁ U₂ : Y.left.Opens),
        U₁ ⊔ U₂ = ⊤ →
        Units ↑(Y.left.presheaf.obj (Opposite.op (U₁ ⊓ U₂))) →
        (weilEtaleGmSheaf Y.left).H 1),
      (∀ (U₁ U₂ : Y.left.Opens) (hcov : U₁ ⊔ U₂ = ⊤)
        (u₁₂ : Units ↑(Y.left.presheaf.obj (Opposite.op (U₁ ⊓ U₂))))
        (K_sh Q_sh : CategoryTheory.Sheaf Y.left.smallEtaleTopology AddCommGrpCat.{u})
        (ι_0 : weilEtaleGmSheaf Y.left ⟶ K_sh)
        (π_0 : K_sh ⟶ Q_sh)
        (h0_0 : ι_0 ≫ π_0 = 0)
        (hSE_0 : (CategoryTheory.ShortComplex.mk ι_0 π_0 h0_0).ShortExact),
        let U₁₂ : Y.left.Opens := U₁ ⊓ U₂
        let V₁ : Y.left.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ U₁.ι
          (inferInstance : AlgebraicGeometry.Etale U₁.ι)
        let V₂ : Y.left.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ U₂.ι
          (inferInstance : AlgebraicGeometry.Etale U₂.ι)
        let V₁₂ : Y.left.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ U₁₂.ι
          (inferInstance : AlgebraicGeometry.Etale U₁₂.ι)
        let j₁₂_₁ : V₁₂ ⟶ V₁ :=
          CategoryTheory.MorphismProperty.Over.homMk
            (Y.left.homOfLE inf_le_left) (Y.left.homOfLE_ι inf_le_left)
        let shAdj_Y := CategoryTheory.sheafificationAdjunction
          Y.left.smallEtaleTopology AddCommGrpCat.{u}
        let Fℤ_Y := (CategoryTheory.constantSheaf
          Y.left.smallEtaleTopology AddCommGrpCat.{u}).obj
          (AddCommGrpCat.of (ULift.{u} ℤ))
        let u₁_Fℤ := fun (V : Y.left.Etale) =>
          (((shAdj_Y.unit.app
            ((CategoryTheory.Functor.const (Opposite Y.left.Etale)).obj
              (AddCommGrpCat.of (ULift.{u} ℤ)))).app
            (Opposite.op V)).hom (ULift.up (1 : ℤ)))
        let u_Y_sh : ↥((weilEtaleGmSheaf Y.left).obj.obj (Opposite.op V₁₂)) :=
          (((shAdj_Y.unit.app (weilEtaleGmPresheaf Y.left)).app (Opposite.op V₁₂)).hom
            (Additive.ofMul (Units.map U₁₂.topIso.inv.hom.toMonoidHom u₁₂)))
        ∀ (s₁ : ↥(K_sh.obj.obj (Opposite.op V₁)))
          (f_q : Fℤ_Y ⟶ Q_sh),
          (K_sh.obj.map j₁₂_₁.op).hom s₁ = (ι_0.hom.app (Opposite.op V₁₂)).hom u_Y_sh →
          (f_q.hom.app (Opposite.op V₁)).hom (u₁_Fℤ V₁) =
            (π_0.hom.app (Opposite.op V₁)).hom s₁ →
          (f_q.hom.app (Opposite.op V₂)).hom (u₁_Fℤ V₂) = 0 →
          Ξ_Y U₁ U₂ hcov u₁₂ =
            (CategoryTheory.Abelian.Ext.mk₀ f_q).comp hSE_0.extClass (Nat.zero_add 1)) ∧
      (∀ (g : Quiver.Hom Y.left Y.left) (m : ℕ)
        (p_g : weilEtaleTorsionH Y.left m 2 →+ weilEtaleTorsionH Y.left m 2),
        CategoryTheory.CategoryStruct.comp g Y.hom = Y.hom →
        WeilIsTorsionEtalePullback g m 2 p_g →
        ∃ pull_Gm : (weilEtaleGmSheaf Y.left).H 1 →+ (weilEtaleGmSheaf Y.left).H 1,
          (∀ (U₁ U₂ : Y.left.Opens) (hcov : U₁ ⊔ U₂ = ⊤)
            (u₁₂ : Units ↑(Y.left.presheaf.obj (Opposite.op (U₁ ⊓ U₂))))
            (hcov' : (TopologicalSpace.Opens.map g.base).obj U₁ ⊔
              (TopologicalSpace.Opens.map g.base).obj U₂ = ⊤),
            let U'₁ : Y.left.Opens := (TopologicalSpace.Opens.map g.base).obj U₁
            let U'₂ : Y.left.Opens := (TopologicalSpace.Opens.map g.base).obj U₂
            let u'₁₂ : Units ↑(Y.left.presheaf.obj (Opposite.op (U'₁ ⊓ U'₂))) :=
              Units.map ((Y.left.presheaf.map
                (CategoryTheory.eqToHom
                  (rfl : U'₁ ⊓ U'₂ = (TopologicalSpace.Opens.map g.base).obj (U₁ ⊓ U₂))).op).hom.comp
                (g.app (U₁ ⊓ U₂)).hom).toMonoidHom u₁₂
            pull_Gm (Ξ_Y U₁ U₂ hcov u₁₂) = Ξ_Y U'₁ U'₂ hcov' u'₁₂) ∧
          (∀ (ζ₀ : kˣ) (T_Y : Y.left.Etale) (hT_Y : CategoryTheory.Limits.IsTerminal T_Y)
            (ι_kum : Quiver.Hom (weilEtaleTorsionSheaf Y.left m) (weilEtaleGmSheaf Y.left))
            (p_kum : Quiver.Hom (weilEtaleGmSheaf Y.left) (weilEtaleGmSheaf Y.left))
            (h0_kum : CategoryTheory.CategoryStruct.comp ι_kum p_kum = 0)
            (hEx_kum : (CategoryTheory.ShortComplex.mk ι_kum p_kum h0_kum).ShortExact),
            p_kum = m • CategoryTheory.CategoryStruct.id (weilEtaleGmSheaf Y.left) →
            (∀ a : ZMod m,
              let adj_Y := CategoryTheory.constantSheafAdj Y.left.smallEtaleTopology
                AddCommGrpCat.{u} hT_Y
              let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
              let u_sec := (CategoryTheory.CategoryStruct.comp
                (adj_Y.unit.app AM)
                (ι_kum.hom.app (Opposite.op T_Y))) (ULift.up a)
              let η_gm := (CategoryTheory.sheafificationAdjunction Y.left.smallEtaleTopology
                AddCommGrpCat.{u}).unit.app (weilEtaleGmPresheaf Y.left)
              ∃ u_pre : ↑((weilEtaleGmPresheaf Y.left).obj (Opposite.op T_Y)),
                (η_gm.app (Opposite.op T_Y)) u_pre = u_sec ∧
                ((Additive.toMul u_pre : Units _) :
                  ↑(((AlgebraicGeometry.Scheme.Etale.forget Y.left).obj T_Y).left.presheaf.obj
                    (Opposite.op ⊤))) =
                  (CommRingCat.Hom.hom (CategoryTheory.CategoryStruct.comp
                    (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
                    (AlgebraicGeometry.Scheme.Hom.appTop
                      (CategoryTheory.CategoryStruct.comp
                        ((AlgebraicGeometry.Scheme.Etale.forget Y.left).obj T_Y).hom
                        Y.hom))) ((ζ₀ : kˣ) : k)) ^ a.val) →
            ∀ ξ : (weilEtaleGmSheaf Y.left).H 1,
              p_g (weilKummerPointClass ξ hEx_kum) =
                weilKummerPointClass (pull_Gm ξ) hEx_kum)) :=
by
  classical
  let Z := Y.left
  let J := Z.smallEtaleTopology
  let shAdj := CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let Pℤ := (CategoryTheory.Functor.const (Opposite Z.Etale)).obj Aℤ
  let C := CategoryTheory.constantSheaf J AddCommGrpCat.{u}
  let Fℤ := C.obj Aℤ
  let G_gm := weilEtaleGmSheaf Z
  let L : Z.Etale → CategoryTheory.Sheaf J AddCommGrpCat.{u} := fun V =>
    (CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).obj
      ((CategoryTheory.yoneda.obj V).comp AddCommGrpCat.free)
  let L_map : ∀ {V' V : Z.Etale}, (V' ⟶ V) → (L V' ⟶ L V) := fun f =>
    (CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).map
      (CategoryTheory.Functor.whiskerRight (CategoryTheory.yoneda.map f) AddCommGrpCat.free)
  let u₁_Fℤ : ∀ (V : Z.Etale), ↥(Fℤ.obj.obj (Opposite.op V)) := fun V =>
    (((shAdj.unit.app Pℤ).app (Opposite.op V)).hom (ULift.up (1 : ℤ)))
  let evalEquiv : ∀ (V : Z.Etale) (F : CategoryTheory.Sheaf J AddCommGrpCat.{u}),
      (L V ⟶ F) ≃ ↥(F.obj.obj (Opposite.op V)) := fun V F =>
    ((shAdj.homEquiv ((CategoryTheory.yoneda.obj V).comp AddCommGrpCat.free) F).trans
      (((CategoryTheory.Adjunction.whiskerRight (Opposite Z.Etale) AddCommGrpCat.adj).homEquiv
        (CategoryTheory.yoneda.obj V) F.obj).trans CategoryTheory.yonedaEquiv))
  have eval_post : ∀ (V : Z.Etale) {F G : CategoryTheory.Sheaf J AddCommGrpCat.{u}}
      (ψ : L V ⟶ F) (α : F ⟶ G),
      evalEquiv V G (ψ ≫ α) = (α.hom.app (Opposite.op V)).hom (evalEquiv V F ψ) := by
    intro V F G ψ α
    dsimp only [evalEquiv, Equiv.trans_apply]
    rw [shAdj.homEquiv_naturality_right ψ α,
      (CategoryTheory.Adjunction.whiskerRight (Opposite Z.Etale)
        AddCommGrpCat.adj).homEquiv_naturality_right _ _,
      CategoryTheory.yonedaEquiv_comp]
    rfl
  have eval_pre : ∀ {V' V : Z.Etale} (f : V' ⟶ V)
      {F : CategoryTheory.Sheaf J AddCommGrpCat.{u}} (ψ : L V ⟶ F),
