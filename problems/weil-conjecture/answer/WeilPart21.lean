      CategoryTheory.Functor.additive_of_preserves_binary_products P_push
    have _ : (weilC1AffEtTop E₂).WEqualsLocallyBijective AddCommGrpCat.{u} :=
      CategoryTheory.GrothendieckTopology.WEqualsLocallyBijective.ofEssentiallySmall.{u}
        (weilC1AffEtTop E₂)
    change CategoryTheory.Limits.PreservesFiniteColimits P_push
    rw [CategoryTheory.Functor.preservesFiniteColimits_iff_forall_exact_map_and_epi]
    intro S hS
    have hExactMap : (S.map P_push).Exact :=
      ((CategoryTheory.Functor.preservesFiniteLimits_iff_forall_exact_map_and_mono P_push).mp
        inferInstance S hS).1
