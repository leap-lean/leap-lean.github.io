            ((C.obj AM).obj.map f.op).hom s = (η_sh.app (Opposite.op V)).hom (ULift.up a) := by
      intro U g
      let σ : ∀ ⦃V : S.Etale⦄ (f : V ⟶ U), (S_lvl U g).arrows f →
