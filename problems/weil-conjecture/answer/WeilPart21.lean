                ι_E a.len i₀ (φ_E (algebraMap E A_E (algebraMap K_base E k))) := by
              rw [φ_E.commutes, (ι_E a.len i₀).commutes]
            change u (algebraMap E (R_E a.len) (algebraMap K_base E k)) =
              u_A (algebraMap E A_E (algebraMap K_base E k))
            rw [halg]
            have hc1 := RingHom.congr_fun (hu i₀) (φ_E (algebraMap E A_E (algebraMap K_base E k)))
            have hc2 := RingHom.congr_fun (hu_compat i₀) (algebraMap E A_E (algebraMap K_base E k))
            exact hc1.trans hc2
