            ↑W.left.unop →ₐ[E₁] TensorProduct E₁ E₂ ↑W.left.unop).toRingHom.toMonoidHom b₁) =
          Additive.ofMul (Units.map
          (Algebra.TensorProduct.includeRight :
            ↑W.left.unop →ₐ[E₁] TensorProduct E₁ E₂ ↑W.left.unop).toRingHom.toMonoidHom b₂) :=
        (hEta W b₁).symm.trans (ha.trans (hEta W b₂))
      exact congrArg Additive.ofMul (hInj_B (Additive.ofMul.injective ha'))
    · intro x
      let u : (TensorProduct E₁ E₂ ↑W.left.unop)ˣ := Additive.toMul x
      constructor
      · intro hx0
        have h1 : Units.map (Algebra.TensorProduct.map σ.toAlgHom
            (AlgHom.id E₁ ↑W.left.unop)).toRingHom.toMonoidHom u * u⁻¹ = 1 :=
          congrArg Additive.toMul ((hDelta W u).symm.trans hx0)
        obtain ⟨b, hb⟩ := (hKerσ_B u).mp h1
        exact ⟨Additive.ofMul b, (hEta W b).trans (congrArg Additive.ofMul hb)⟩
      · rintro ⟨a, ha⟩
        let b : (↑W.left.unop)ˣ := Additive.toMul a
        have hb : Units.map (Algebra.TensorProduct.includeRight :
            ↑W.left.unop →ₐ[E₁] TensorProduct E₁ E₂ ↑W.left.unop).toRingHom.toMonoidHom b = u :=
          Additive.ofMul.injective ((hEta W b).symm.trans ha)
        exact (hDelta W u).trans (congrArg Additive.ofMul ((hKerσ_B u).mpr ⟨b, hb⟩))
    · intro y
      let v : (TensorProduct E₁ E₂ ↑W.left.unop)ˣ := Additive.toMul y
      constructor
      · intro hy0
        have h1 : Units.map ((Algebra.norm ↑W.left.unop).comp
            (Algebra.TensorProduct.comm E₁ E₂ ↑W.left.unop).toRingHom.toMonoidHom) v = 1 :=
          congrArg Additive.toMul ((hTr W v).symm.trans hy0)
        obtain ⟨u, hu⟩ := (hKerν_B v).mp h1
        exact ⟨Additive.ofMul u, (hDelta W u).trans (congrArg Additive.ofMul hu)⟩
      · rintro ⟨x, hx⟩
        let u : (TensorProduct E₁ E₂ ↑W.left.unop)ˣ := Additive.toMul x
        have hu : Units.map (Algebra.TensorProduct.map σ.toAlgHom
            (AlgHom.id E₁ ↑W.left.unop)).toRingHom.toMonoidHom u * u⁻¹ = v :=
          Additive.ofMul.injective ((hDelta W u).symm.trans hx)
        exact (hTr W v).trans (congrArg Additive.ofMul ((hKerν_B v).mpr ⟨u, hu⟩))
    · intro z
      let w : (↑W.left.unop)ˣ := Additive.toMul z
      obtain ⟨u, hu⟩ := hSurj_B w
      exact ⟨Additive.ofMul u, (hTr W u).trans (congrArg Additive.ofMul hu)⟩

  
  have hSheafSplit : ∀ (ℱ 𝒢 : CategoryTheory.Sheaf (weilC1AffEtTop E₁) AddCommGrpCat.{u})
      (η : ℱ ⟶ 𝒢) (δ : 𝒢 ⟶ 𝒢) (π : 𝒢 ⟶ ℱ),
      (∀ U : (AlgebraicGeometry.Spec (CommRingCat.of E₁)).AffineEtale,
        Function.Injective (η.hom.app (Opposite.op (V U))).hom ∧
        (∀ x : ↑(𝒢.obj.obj (Opposite.op (V U))),
          (δ.hom.app (Opposite.op (V U))).hom x = 0 ↔
            ∃ a : ↑(ℱ.obj.obj (Opposite.op (V U))),
              (η.hom.app (Opposite.op (V U))).hom a = x) ∧
        (∀ y : ↑(𝒢.obj.obj (Opposite.op (V U))),
          (π.hom.app (Opposite.op (V U))).hom y = 0 ↔
            ∃ x : ↑(𝒢.obj.obj (Opposite.op (V U))),
              (δ.hom.app (Opposite.op (V U))).hom x = y) ∧
        Function.Surjective (π.hom.app (Opposite.op (V U))).hom) →
      ∃ (𝒥 : CategoryTheory.Sheaf (weilC1AffEtTop E₁) AddCommGrpCat.{u})
        (q₁ : 𝒢 ⟶ 𝒥)
        (i₂ : 𝒥 ⟶ 𝒢)
        (h0₁ : CategoryTheory.CategoryStruct.comp η q₁ = 0)
        (h0₂ : CategoryTheory.CategoryStruct.comp i₂ π = 0),
        (CategoryTheory.ShortComplex.mk η q₁ h0₁).ShortExact ∧
        (CategoryTheory.ShortComplex.mk i₂ π h0₂).ShortExact := by
    intro ℱ 𝒢 η δ π hLoc
    have hSheafFor : ∀ (ℋ : CategoryTheory.Sheaf (weilC1AffEtTop E₁) AddCommGrpCat.{u})
        (U : (AlgebraicGeometry.Spec (CommRingCat.of E₁)).AffineEtale),
        CategoryTheory.Presieve.IsSheafFor
          (ℋ.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u})
          (CategoryTheory.Presieve.singleton (f U)) :=
      fun ℋ U =>
        ((CategoryTheory.isSheaf_iff_isSheaf_of_type (weilC1AffEtTop E₁)
          (ℋ.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u})).mp
          ((CategoryTheory.sheafForget (weilC1AffEtTop E₁)).obj ℋ).property).isSheafFor
          (CategoryTheory.Presieve.singleton (f U)) (hCov U)
    have restrict_inj : ∀ (ℋ : CategoryTheory.Sheaf (weilC1AffEtTop E₁) AddCommGrpCat.{u})
        (U : (AlgebraicGeometry.Spec (CommRingCat.of E₁)).AffineEtale),
        Function.Injective (ℋ.obj.map (f U).op).hom := by
      intro ℋ U s₁ s₂ hs
      refine (hSheafFor ℋ U).isSeparatedFor.ext fun Y g hg => ?_
      cases hg
      exact hs
    have eta_inj_all : ∀ Z : (AlgebraicGeometry.Spec (CommRingCat.of E₁)).AffineEtale,
        Function.Injective (η.hom.app (Opposite.op Z)).hom := by
      intro Z a₁ a₂ ha
      apply restrict_inj ℱ Z
      apply (hLoc Z).1
      have h1 : (η.hom.app (Opposite.op (V Z))).hom ((ℱ.obj.map (f Z).op).hom a₁) =
          (𝒢.obj.map (f Z).op).hom ((η.hom.app (Opposite.op Z)).hom a₁) :=
        congrArg (fun φ => φ.hom a₁) (η.hom.naturality (f Z).op)
      have h2 : (η.hom.app (Opposite.op (V Z))).hom ((ℱ.obj.map (f Z).op).hom a₂) =
          (𝒢.obj.map (f Z).op).hom ((η.hom.app (Opposite.op Z)).hom a₂) :=
        congrArg (fun φ => φ.hom a₂) (η.hom.naturality (f Z).op)
      exact h1.trans ((congrArg (𝒢.obj.map (f Z).op).hom ha).trans h2.symm)
    haveI : CategoryTheory.Mono η :=
      CategoryTheory.Sheaf.mono_of_injective η (fun X => eta_inj_all X.unop)
    have h_η_δ : CategoryTheory.CategoryStruct.comp η δ = 0 := by
      apply CategoryTheory.ObjectProperty.hom_ext
      apply CategoryTheory.NatTrans.ext
      funext X
      rcases X with ⟨U⟩
      apply AddCommGrpCat.hom_ext
      apply AddMonoidHom.ext
      intro a
      apply restrict_inj 𝒢 U
      have hnat₁ : (η.hom.app (Opposite.op (V U))).hom ((ℱ.obj.map (f U).op).hom a) =
          (𝒢.obj.map (f U).op).hom ((η.hom.app (Opposite.op U)).hom a) :=
        congrArg (fun φ => φ.hom a) (η.hom.naturality (f U).op)
      have hnat₂ : (δ.hom.app (Opposite.op (V U))).hom
          ((𝒢.obj.map (f U).op).hom ((η.hom.app (Opposite.op U)).hom a)) =
          (𝒢.obj.map (f U).op).hom
            ((δ.hom.app (Opposite.op U)).hom ((η.hom.app (Opposite.op U)).hom a)) :=
        congrArg (fun φ => φ.hom ((η.hom.app (Opposite.op U)).hom a))
          (δ.hom.naturality (f U).op)
      have hker : (δ.hom.app (Opposite.op (V U))).hom
          ((η.hom.app (Opposite.op (V U))).hom ((ℱ.obj.map (f U).op).hom a)) = 0 :=
        ((hLoc U).2.1 _).mpr ⟨_, rfl⟩
      exact hnat₂.symm.trans
        ((congrArg (δ.hom.app (Opposite.op (V U))).hom hnat₁.symm).trans
          (hker.trans ((𝒢.obj.map (f U).op).hom.map_zero).symm))
    have h_δ_π : CategoryTheory.CategoryStruct.comp δ π = 0 := by
      apply CategoryTheory.ObjectProperty.hom_ext
      apply CategoryTheory.NatTrans.ext
      funext X
      rcases X with ⟨U⟩
      apply AddCommGrpCat.hom_ext
      apply AddMonoidHom.ext
      intro x
      apply restrict_inj ℱ U
      have hnat₁ : (δ.hom.app (Opposite.op (V U))).hom ((𝒢.obj.map (f U).op).hom x) =
          (𝒢.obj.map (f U).op).hom ((δ.hom.app (Opposite.op U)).hom x) :=
        congrArg (fun φ => φ.hom x) (δ.hom.naturality (f U).op)
      have hnat₂ : (π.hom.app (Opposite.op (V U))).hom
          ((𝒢.obj.map (f U).op).hom ((δ.hom.app (Opposite.op U)).hom x)) =
          (ℱ.obj.map (f U).op).hom
            ((π.hom.app (Opposite.op U)).hom ((δ.hom.app (Opposite.op U)).hom x)) :=
        congrArg (fun φ => φ.hom ((δ.hom.app (Opposite.op U)).hom x))
          (π.hom.naturality (f U).op)
      have hker : (π.hom.app (Opposite.op (V U))).hom
          ((δ.hom.app (Opposite.op (V U))).hom ((𝒢.obj.map (f U).op).hom x)) = 0 :=
        ((hLoc U).2.2.1 _).mpr ⟨_, rfl⟩
      exact hnat₂.symm.trans
        ((congrArg (π.hom.app (Opposite.op (V U))).hom hnat₁.symm).trans
          (hker.trans ((ℱ.obj.map (f U).op).hom.map_zero).symm))

    let 𝒥 : CategoryTheory.Sheaf (weilC1AffEtTop E₁) AddCommGrpCat.{u} :=
      CategoryTheory.Limits.kernel π
    let i₂ : 𝒥 ⟶ 𝒢 := CategoryTheory.Limits.kernel.ι π
    have h0₂ : CategoryTheory.CategoryStruct.comp i₂ π = 0 :=
      CategoryTheory.Limits.kernel.condition π
    let q₁ : 𝒢 ⟶ 𝒥 := CategoryTheory.Limits.kernel.lift π δ h_δ_π
    have hq₁_i₂ : CategoryTheory.CategoryStruct.comp q₁ i₂ = δ :=
      CategoryTheory.Limits.kernel.lift_ι π δ h_δ_π
    have h0₁ : CategoryTheory.CategoryStruct.comp η q₁ = 0 := by
      apply (CategoryTheory.cancel_mono i₂).mp
      exact (CategoryTheory.Category.assoc η q₁ i₂).trans
        ((congrArg (CategoryTheory.CategoryStruct.comp η) hq₁_i₂).trans
          (h_η_δ.trans (CategoryTheory.Limits.zero_comp).symm))

    have hEpi_π : CategoryTheory.Epi π := by
      haveI : CategoryTheory.Sheaf.IsLocallySurjective π :=
        CategoryTheory.Presheaf.IsLocallySurjective.mk fun {U} b => by
          have hmem_f : (CategoryTheory.Presheaf.imageSieve π.hom b).arrows (f U) := by
            obtain ⟨y, hy⟩ := (hLoc U).2.2.2 ((ℱ.obj.map (f U).op).hom b)
            exact ⟨y, hy⟩
          refine (weilC1AffEtTop E₁).superset_covering ?_ (hCov U)
          intro Z h hh
          rcases hh with ⟨_, p_arr, _, ⟨⟩, rfl⟩
          exact (CategoryTheory.Presheaf.imageSieve π.hom b).downward_closed hmem_f p_arr
      exact CategoryTheory.Sheaf.epi_of_isLocallySurjective π
    have hSES₂ : (CategoryTheory.ShortComplex.mk i₂ π h0₂).ShortExact :=
      CategoryTheory.ShortComplex.ShortExact.mk'
        (CategoryTheory.ShortComplex.exact_kernel π) inferInstance hEpi_π

    have i₂_inj : ∀ X : ((AlgebraicGeometry.Spec (CommRingCat.of E₁)).AffineEtale)ᵒᵖ,
        Function.Injective (i₂.hom.app X).hom := by
      let F_sp := CategoryTheory.sheafToPresheaf (weilC1AffEtTop E₁) AddCommGrpCat.{u}
      have hMonoPre : CategoryTheory.Mono i₂.hom := F_sp.map_mono i₂
      intro X
      exact (AddCommGrpCat.mono_iff_injective (i₂.hom.app X)).mp
        ((CategoryTheory.NatTrans.mono_iff_mono_app i₂.hom).mp hMonoPre X)
    have hEpi_q₁ : CategoryTheory.Epi q₁ := by
      haveI : CategoryTheory.Sheaf.IsLocallySurjective q₁ :=
        CategoryTheory.Presheaf.IsLocallySurjective.mk fun {U} z => by
          have hmem_f : (CategoryTheory.Presheaf.imageSieve q₁.hom z).arrows (f U) := by
            let y : ↑(𝒢.obj.obj (Opposite.op (V U))) :=
              (i₂.hom.app (Opposite.op (V U))).hom ((𝒥.obj.map (f U).op).hom z)
            have hy_π : (π.hom.app (Opposite.op (V U))).hom y = 0 :=
              congrArg (fun φ => (φ.hom.app (Opposite.op (V U))).hom
                ((𝒥.obj.map (f U).op).hom z)) h0₂
            obtain ⟨x, hx⟩ := ((hLoc U).2.2.1 y).mp hy_π
            refine ⟨x, i₂_inj (Opposite.op (V U)) ?_⟩
            have hqi : (i₂.hom.app (Opposite.op (V U))).hom
                ((q₁.hom.app (Opposite.op (V U))).hom x) =
                (δ.hom.app (Opposite.op (V U))).hom x :=
              congrArg (fun φ => (φ.hom.app (Opposite.op (V U))).hom x) hq₁_i₂
            exact hqi.trans hx
          refine (weilC1AffEtTop E₁).superset_covering ?_ (hCov U)
          intro Z h hh
          rcases hh with ⟨_, p_arr, _, ⟨⟩, rfl⟩
          exact (CategoryTheory.Presheaf.imageSieve q₁.hom z).downward_closed hmem_f p_arr
      exact CategoryTheory.Sheaf.epi_of_isLocallySurjective q₁

    have ker_q₁_lift : ∀ (U : (AlgebraicGeometry.Spec (CommRingCat.of E₁)).AffineEtale)
        (x : ↑(𝒢.obj.obj (Opposite.op U))),
        (q₁.hom.app (Opposite.op U)).hom x = 0 →
        ∃ a₀ : ↑(ℱ.obj.obj (Opposite.op U)), (η.hom.app (Opposite.op U)).hom a₀ = x := by
      intro U x hqx
      have hqi : (δ.hom.app (Opposite.op U)).hom x =
          (i₂.hom.app (Opposite.op U)).hom ((q₁.hom.app (Opposite.op U)).hom x) :=
        congrArg (fun φ => (φ.hom.app (Opposite.op U)).hom x) hq₁_i₂.symm
      have hδx : (δ.hom.app (Opposite.op U)).hom x = 0 :=
        hqi.trans ((congrArg (i₂.hom.app (Opposite.op U)).hom hqx).trans
          (i₂.hom.app (Opposite.op U)).hom.map_zero)
      have hnat_δ : (δ.hom.app (Opposite.op (V U))).hom ((𝒢.obj.map (f U).op).hom x) =
          (𝒢.obj.map (f U).op).hom ((δ.hom.app (Opposite.op U)).hom x) :=
        congrArg (fun φ => φ.hom x) (δ.hom.naturality (f U).op)
      have hδ_res : (δ.hom.app (Opposite.op (V U))).hom ((𝒢.obj.map (f U).op).hom x) = 0 :=
        hnat_δ.trans ((congrArg (𝒢.obj.map (f U).op).hom hδx).trans
          (𝒢.obj.map (f U).op).hom.map_zero)
      obtain ⟨a₁, ha₁⟩ := ((hLoc U).2.1 _).mp hδ_res
      have hcompat : ∀ {Z : (AlgebraicGeometry.Spec (CommRingCat.of E₁)).AffineEtale}
          (p₁ p₂ : Z ⟶ V U),
          CategoryTheory.CategoryStruct.comp p₁ (f U) =
            CategoryTheory.CategoryStruct.comp p₂ (f U) →
          (ℱ.obj.map p₁.op).hom a₁ = (ℱ.obj.map p₂.op).hom a₁ := by
        intro Z p₁ p₂ hp
        apply eta_inj_all Z
        have hnat₁ : (η.hom.app (Opposite.op Z)).hom ((ℱ.obj.map p₁.op).hom a₁) =
            (𝒢.obj.map p₁.op).hom ((η.hom.app (Opposite.op (V U))).hom a₁) :=
          congrArg (fun φ => φ.hom a₁) (η.hom.naturality p₁.op)
        have hnat₂ : (η.hom.app (Opposite.op Z)).hom ((ℱ.obj.map p₂.op).hom a₁) =
            (𝒢.obj.map p₂.op).hom ((η.hom.app (Opposite.op (V U))).hom a₁) :=
          congrArg (fun φ => φ.hom a₁) (η.hom.naturality p₂.op)
        have hcomp₁ : (𝒢.obj.map p₁.op).hom ((𝒢.obj.map (f U).op).hom x) =
            (𝒢.obj.map (CategoryTheory.CategoryStruct.comp p₁ (f U)).op).hom x :=
          congrArg (fun φ => φ.hom x)
            ((𝒢.obj.map_comp (f U).op p₁.op).symm.trans
              (congrArg 𝒢.obj.map (CategoryTheory.op_comp (f := p₁) (g := f U)).symm))
        have hcomp₂ : (𝒢.obj.map p₂.op).hom ((𝒢.obj.map (f U).op).hom x) =
            (𝒢.obj.map (CategoryTheory.CategoryStruct.comp p₂ (f U)).op).hom x :=
          congrArg (fun φ => φ.hom x)
            ((𝒢.obj.map_comp (f U).op p₂.op).symm.trans
              (congrArg 𝒢.obj.map (CategoryTheory.op_comp (f := p₂) (g := f U)).symm))
        exact hnat₁.trans
          ((congrArg (𝒢.obj.map p₁.op).hom ha₁).trans
            (hcomp₁.trans
              ((congrArg (fun g => (𝒢.obj.map g.op).hom x) hp).trans
                (hcomp₂.symm.trans
                  ((congrArg (𝒢.obj.map p₂.op).hom ha₁.symm).trans hnat₂.symm)))))
      obtain ⟨a₀, ha₀, -⟩ :=
        (CategoryTheory.Presieve.isSheafFor_singleton.mp (hSheafFor ℱ U)) a₁ hcompat
      have ha₀' : (ℱ.obj.map (f U).op).hom a₀ = a₁ := ha₀
      have hnat_η : (η.hom.app (Opposite.op (V U))).hom ((ℱ.obj.map (f U).op).hom a₀) =
          (𝒢.obj.map (f U).op).hom ((η.hom.app (Opposite.op U)).hom a₀) :=
        congrArg (fun φ => φ.hom a₀) (η.hom.naturality (f U).op)
      exact ⟨a₀, restrict_inj 𝒢 U
        (hnat_η.symm.trans ((congrArg (η.hom.app (Opposite.op (V U))).hom ha₀').trans ha₁))⟩

    have hIsKernel : CategoryTheory.Limits.IsLimit
        (CategoryTheory.Limits.KernelFork.ofι η h0₁) :=
      CategoryTheory.Limits.KernelFork.IsLimit.ofι η h0₁
        (fun {𝒲} k hk =>
          let l_fun : ∀ U : (AlgebraicGeometry.Spec (CommRingCat.of E₁)).AffineEtale,
              ↑(𝒲.obj.obj (Opposite.op U)) → ↑(ℱ.obj.obj (Opposite.op U)) :=
            fun U w =>
              Classical.choose (ker_q₁_lift U ((k.hom.app (Opposite.op U)).hom w)
                (congrArg (fun φ => (φ.hom.app (Opposite.op U)).hom w) hk))
          have hl_spec : ∀ (U : (AlgebraicGeometry.Spec (CommRingCat.of E₁)).AffineEtale)
              (w : ↑(𝒲.obj.obj (Opposite.op U))),
              (η.hom.app (Opposite.op U)).hom (l_fun U w) =
                (k.hom.app (Opposite.op U)).hom w :=
            fun U w =>
              Classical.choose_spec (ker_q₁_lift U ((k.hom.app (Opposite.op U)).hom w)
                (congrArg (fun φ => (φ.hom.app (Opposite.op U)).hom w) hk))
          CategoryTheory.ObjectProperty.homMk
            { app := fun X => AddCommGrpCat.ofHom
                { toFun := l_fun X.unop
                  map_zero' := eta_inj_all X.unop
                    ((hl_spec X.unop 0).trans
                      (((k.hom.app (Opposite.op X.unop)).hom.map_zero).trans
                        ((η.hom.app (Opposite.op X.unop)).hom.map_zero).symm))
                  map_add' := fun w₁ w₂ => eta_inj_all X.unop
                    ((hl_spec X.unop (w₁ + w₂)).trans
                      (((k.hom.app (Opposite.op X.unop)).hom.map_add w₁ w₂).trans
                        ((congrArg₂ (· + ·)
                          (hl_spec X.unop w₁).symm (hl_spec X.unop w₂).symm).trans
                          ((η.hom.app (Opposite.op X.unop)).hom.map_add _ _).symm))) }
              naturality := fun {X Y} g_op => by
                rcases X with ⟨U₂⟩
                rcases Y with ⟨U₁⟩
                apply AddCommGrpCat.hom_ext
                apply AddMonoidHom.ext
                intro w
                apply eta_inj_all U₁
                have hnat_η : (η.hom.app (Opposite.op U₁)).hom
                    ((ℱ.obj.map g_op).hom (l_fun U₂ w)) =
                    (𝒢.obj.map g_op).hom
                      ((η.hom.app (Opposite.op U₂)).hom (l_fun U₂ w)) :=
                  congrArg (fun φ => φ.hom (l_fun U₂ w)) (η.hom.naturality g_op)
                have hnat_k : (k.hom.app (Opposite.op U₁)).hom
                    ((𝒲.obj.map g_op).hom w) =
                    (𝒢.obj.map g_op).hom ((k.hom.app (Opposite.op U₂)).hom w) :=
                  congrArg (fun φ => φ.hom w) (k.hom.naturality g_op)
                exact (hnat_η.trans
                  ((congrArg (𝒢.obj.map g_op).hom (hl_spec U₂ w)).trans
                    (hnat_k.symm.trans (hl_spec U₁ ((𝒲.obj.map g_op).hom w)).symm))).symm })
        (fun {𝒲} k hk => by
          apply CategoryTheory.ObjectProperty.hom_ext
          apply CategoryTheory.NatTrans.ext
          funext X
          rcases X with ⟨U⟩
          apply AddCommGrpCat.hom_ext
          apply AddMonoidHom.ext
          intro w
          exact Classical.choose_spec (ker_q₁_lift U ((k.hom.app (Opposite.op U)).hom w)
            (congrArg (fun φ => (φ.hom.app (Opposite.op U)).hom w) hk)))
        (fun {𝒲} k hk m hm => (CategoryTheory.cancel_mono η).mp (hm.trans (by
          apply CategoryTheory.ObjectProperty.hom_ext
          apply CategoryTheory.NatTrans.ext
          funext X
          rcases X with ⟨U⟩
          apply AddCommGrpCat.hom_ext
          apply AddMonoidHom.ext
          intro w
          exact (Classical.choose_spec (ker_q₁_lift U ((k.hom.app (Opposite.op U)).hom w)
            (congrArg (fun φ => (φ.hom.app (Opposite.op U)).hom w) hk))).symm)))
    have hSES₁ : (CategoryTheory.ShortComplex.mk η q₁ h0₁).ShortExact :=
      CategoryTheory.ShortComplex.ShortExact.mk'
        (CategoryTheory.ShortComplex.exact_of_f_is_kernel _ hIsKernel) inferInstance hEpi_q₁
    exact ⟨𝒥, q₁, i₂, h0₁, h0₂, hSES₁, hSES₂⟩

  exact hSheafSplit Gm₁ (P_push.obj Gm₂) η_Gm δ_σ tr hLocalExact

