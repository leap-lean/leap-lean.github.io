      (CategoryTheory.Functor.IsDenseSubsite.functorPushforward_mem_iff
        (J := weilC1AffEtTop E) (K := S_E.smallEtaleTopology) (G := Φ_E)).mpr hS
    have hNeE : Nonempty (PrimeSpectrum E) := inferInstance
    let pt₀ : ↥(Φ_E.obj (topObj E)).left := Classical.choice hNeE
    obtain ⟨Y, f, y₀, hf_push, _, _⟩ :=
      (hMemSmallEtale E (Φ_E.obj (topObj E)) _).mp hPush pt₀
    rcases hf_push with ⟨U₀, g₀, h, hg₀, _⟩
    let A₀ : Type u := ↑U₀.left.unop
    have hNonemptySpec : Nonempty (PrimeSpectrum A₀) := ⟨h.left.base y₀⟩
    have : Nontrivial A₀ := (PrimeSpectrum.nonempty_iff_nontrivial (R := A₀)).mp hNonemptySpec
    let _ : Algebra E A₀ := weilC1AffEtAlg E U₀
    have hEqHom₀ :
        AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.Spec.preimage U₀.hom).unop = U₀.hom :=
      AlgebraicGeometry.Scheme.Spec.map_preimage U₀.hom
    have : Algebra.Etale E A₀ :=
      RingHom.etale_algebraMap.mp
        ((AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
          (hEqHom₀.symm ▸ U₀.prop))
    obtain ⟨Idx, hFinIdx, F_fam, hFieldFam, hAlgFam, e_A, hFinSepFam⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod E A₀).mp inferInstance
    let _ := hFinIdx
    let _ := hFieldFam
    let _ := hAlgFam
