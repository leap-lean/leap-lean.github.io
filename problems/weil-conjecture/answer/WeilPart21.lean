      · obtain ⟨y₀⟩ := not_isEmpty_iff.mp hEmp
        have heq : a₁ = a₂ := (ha₁ y₀).symm.trans (ha₂ y₀)
        rw [heq]
    have hη_nat_apply : ∀ {V₁ V₂ : S.Etale} (h : V₁ ⟶ V₂) (a : ZMod m),
