  have hLanLim : CategoryTheory.Limits.PreservesFiniteLimits (F₀.op.lan (H := A)) := by
    refine CategoryTheory.Limits.preservesFiniteLimits_of_preservesFiniteLimitsOfSize
      (F₀.op.lan (H := A)) (fun (J : Type) {𝒥} hFin => ?_)
    refine CategoryTheory.Limits.preservesLimitsOfShape_of_evaluation
      (F₀.op.lan (H := A)) J (fun K => ?_)
    let Idx := CategoryTheory.CostructuredArrow F₀.op K
    let W_proj := (CategoryTheory.Functor.whiskeringLeft Idx Dᵒᵖ A).obj
      (CategoryTheory.CostructuredArrow.proj F₀.op K)
    have : CategoryTheory.Limits.PreservesLimitsOfShape J
