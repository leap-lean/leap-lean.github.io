  let L₂ := CategoryTheory.Functor.comp pb_f pb_g
  let R₂ := CategoryTheory.Functor.comp pf_g pf_f
  let adj₂ : L₂ ⊣ R₂ := adj_f.comp adj_g
  let e_pb : pb_Wf ≅ L₂ :=
    { hom :=
        { app := fun A =>
            (adj_Wf.homEquiv A (L₂.obj A)).symm
              (adj₂.unit.app A ≫ e_pf.hom.app (L₂.obj A))
          naturality := fun {A A'} u => by
            apply (adj_Wf.homEquiv A (L₂.obj A')).injective
            have h_un : u ≫ adj₂.unit.app A' = adj₂.unit.app A ≫ R₂.map (L₂.map u) :=
              adj₂.unit.naturality u
            rw [CategoryTheory.Adjunction.homEquiv_naturality_left,
              CategoryTheory.Adjunction.homEquiv_naturality_right,
              Equiv.apply_symm_apply, Equiv.apply_symm_apply, CategoryTheory.Category.assoc,
              ← e_pf.hom.naturality (L₂.map u), ← CategoryTheory.Category.assoc,
              ← CategoryTheory.Category.assoc, h_un] }
      inv :=
        { app := fun A =>
            (adj₂.homEquiv A (pb_Wf.obj A)).symm
              (adj_Wf.unit.app A ≫ e_pf.inv.app (pb_Wf.obj A))
          naturality := fun {A A'} u => by
            apply (adj₂.homEquiv A (pb_Wf.obj A')).injective
            have h_un : u ≫ adj_Wf.unit.app A' = adj_Wf.unit.app A ≫ pf_Wf.map (pb_Wf.map u) :=
              adj_Wf.unit.naturality u
            rw [CategoryTheory.Adjunction.homEquiv_naturality_left,
              CategoryTheory.Adjunction.homEquiv_naturality_right,
              Equiv.apply_symm_apply, Equiv.apply_symm_apply, CategoryTheory.Category.assoc,
              ← e_pf.inv.naturality (pb_Wf.map u), ← CategoryTheory.Category.assoc,
              ← CategoryTheory.Category.assoc, h_un] }
      hom_inv_id := by
        apply CategoryTheory.NatTrans.ext
        funext A
        apply (adj_Wf.homEquiv A (pb_Wf.obj A)).injective
        change adj_Wf.homEquiv A (pb_Wf.obj A) (_ ≫ _) =
          adj_Wf.homEquiv A (pb_Wf.obj A) (CategoryTheory.CategoryStruct.id _)
        rw [CategoryTheory.Adjunction.homEquiv_naturality_right, Equiv.apply_symm_apply,
          CategoryTheory.Category.assoc, ← e_pf.hom.naturality]
        have h_adj₂ : adj₂.unit.app A ≫
            (CategoryTheory.Functor.comp
              ((weilEtaleSitePullback g).sheafPushforwardContinuous
                AddCommGrpCat.{u} Y.smallEtaleTopology W_top.smallEtaleTopology)
              ((weilEtaleSitePullback f).sheafPushforwardContinuous
                AddCommGrpCat.{u} S.smallEtaleTopology Y.smallEtaleTopology)).map
              ((adj₂.homEquiv A (pb_Wf.obj A)).symm (adj_Wf.unit.app A ≫ e_pf.inv.app (pb_Wf.obj A))) =
            adj_Wf.unit.app A ≫ e_pf.inv.app (pb_Wf.obj A) :=
          Equiv.apply_symm_apply (adj₂.homEquiv A (pb_Wf.obj A)) _
        rw [← CategoryTheory.Category.assoc, h_adj₂,
          CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Functor.map_id]
        exact congrArg (adj_Wf.unit.app A ≫ ·) (e_pf.inv_hom_id_app (pb_Wf.obj A))
      inv_hom_id := by
        apply CategoryTheory.NatTrans.ext
        funext A
        apply (adj₂.homEquiv A (L₂.obj A)).injective
        change adj₂.homEquiv A _ (_ ≫ _) =
          adj₂.homEquiv A _ (CategoryTheory.CategoryStruct.id _)
        rw [CategoryTheory.Adjunction.homEquiv_naturality_right, Equiv.apply_symm_apply,
          CategoryTheory.Category.assoc, ← e_pf.inv.naturality]
        have h_adj₁ : adj_Wf.unit.app A ≫
            ((weilEtaleSitePullback h_Wf).sheafPushforwardContinuous
              AddCommGrpCat.{u} S.smallEtaleTopology W_top.smallEtaleTopology).map
              ((adj_Wf.homEquiv A _).symm (adj₂.unit.app A ≫ e_pf.hom.app _)) =
            adj₂.unit.app A ≫ e_pf.hom.app _ :=
          Equiv.apply_symm_apply (adj_Wf.homEquiv A _) _
        rw [← CategoryTheory.Category.assoc, h_adj₁,
          CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Functor.map_id]
        exact congrArg (adj₂.unit.app A ≫ ·) (e_pf.hom_inv_id_app (L₂.obj A)) }

  have : L₂.Additive := inferInstance
  have : CategoryTheory.Limits.PreservesFiniteLimits L₂ :=
    CategoryTheory.Limits.comp_preservesFiniteLimits pb_f pb_g
  have : CategoryTheory.Limits.PreservesFiniteColimits L₂ :=
    CategoryTheory.Limits.comp_preservesFiniteColimits pb_f pb_g

  have hMapExtComp : ∀ (q : ℕ)
      {X₀ Y₀ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
      (w : CategoryTheory.Abelian.Ext.{u} X₀ Y₀ q),
      CategoryTheory.Abelian.Ext.mapExactFunctor L₂ w =
        CategoryTheory.Abelian.Ext.mapExactFunctor pb_g
          (CategoryTheory.Abelian.Ext.mapExactFunctor pb_f w) := by
    intro q
    induction q with
    | zero =>
      intro X₀ Y₀ w
      let φ : X₀ ⟶ Y₀ := CategoryTheory.Abelian.Ext.homEquiv₀ w
      have hw : w = CategoryTheory.Abelian.Ext.mk₀ φ :=
        (CategoryTheory.Abelian.Ext.homEquiv₀.symm_apply_apply w).symm
      rw [hw, CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀]
      rfl
    | succ p ih =>
      intro X₀ Y₀ w
      let J_S := CategoryTheory.Injective.under Y₀
      let ι_S : Y₀ ⟶ J_S := CategoryTheory.Injective.ι Y₀
      let SC_S := CategoryTheory.ShortComplex.mk ι_S (CategoryTheory.Limits.cokernel.π ι_S)
        (CategoryTheory.Limits.cokernel.condition ι_S)
      have hSE_S : SC_S.ShortExact :=
        { exact := CategoryTheory.ShortComplex.exact_cokernel ι_S
          mono_f := inferInstance
          epi_g := inferInstance }
      have hw_f : w.comp (CategoryTheory.Abelian.Ext.mk₀ SC_S.f) (Nat.add_zero (p + 1)) = 0 :=
        CategoryTheory.Abelian.Ext.eq_zero_of_injective _
      obtain ⟨u, rfl⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ X₀ hSE_S w hw_f
        (rfl : p + 1 = p + 1)
      rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass, ih u]

  have hMapExtIso : ∀ (q : ℕ)
      {X₀ Y₀ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
      (w : CategoryTheory.Abelian.Ext.{u} X₀ Y₀ q),
      CategoryTheory.Abelian.Ext.mapExactFunctor L₂ w =
        (CategoryTheory.Abelian.Ext.mk₀ (e_pb.inv.app X₀)).comp
          ((CategoryTheory.Abelian.Ext.mapExactFunctor pb_Wf w).comp
            (CategoryTheory.Abelian.Ext.mk₀ (e_pb.hom.app Y₀)) (Nat.add_zero q))
          (Nat.zero_add q) := by
    intro q
    induction q with
    | zero =>
      intro X₀ Y₀ w
      let φ : X₀ ⟶ Y₀ := CategoryTheory.Abelian.Ext.homEquiv₀ w
      have hw : w = CategoryTheory.Abelian.Ext.mk₀ φ :=
        (CategoryTheory.Abelian.Ext.homEquiv₀.symm_apply_apply w).symm
      rw [hw, CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
      congr 1
      rw [e_pb.hom.naturality φ, ← CategoryTheory.Category.assoc, e_pb.inv_hom_id_app X₀,
        CategoryTheory.Category.id_comp]
    | succ p ih =>
      intro X₀ Y₀ w
      let J_S := CategoryTheory.Injective.under Y₀
      let ι_S : Y₀ ⟶ J_S := CategoryTheory.Injective.ι Y₀
      let SC_S := CategoryTheory.ShortComplex.mk ι_S (CategoryTheory.Limits.cokernel.π ι_S)
        (CategoryTheory.Limits.cokernel.condition ι_S)
      have hSE_S : SC_S.ShortExact :=
        { exact := CategoryTheory.ShortComplex.exact_cokernel ι_S
          mono_f := inferInstance
          epi_g := inferInstance }
      have hw_f : w.comp (CategoryTheory.Abelian.Ext.mk₀ SC_S.f) (Nat.add_zero (p + 1)) = 0 :=
        CategoryTheory.Abelian.Ext.eq_zero_of_injective _
      obtain ⟨u, rfl⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ X₀ hSE_S w hw_f
        (rfl : p + 1 = p + 1)
      let mor_pb : SC_S.map pb_Wf ⟶ SC_S.map L₂ :=
        { τ₁ := e_pb.hom.app SC_S.X₁
          τ₂ := e_pb.hom.app SC_S.X₂
          τ₃ := e_pb.hom.app SC_S.X₃
          comm₁₂ := (e_pb.hom.naturality SC_S.f).symm
          comm₂₃ := (e_pb.hom.naturality SC_S.g).symm }
      have h_nat := CategoryTheory.ShortComplex.ShortExact.extClass_naturality
        (hSE_S.map_of_exact pb_Wf) (hSE_S.map_of_exact L₂) mor_pb
      rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass, ih u,
        CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ (e_pb.inv.app X₀)) _
          (hSE_S.map_of_exact L₂).extClass
          (Nat.zero_add p) (rfl : p + 1 = p + 1) (Nat.zero_add (p + 1)),
        CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mapExactFunctor pb_Wf u)
          (CategoryTheory.Abelian.Ext.mk₀ (e_pb.hom.app SC_S.X₃))
          (hSE_S.map_of_exact L₂).extClass
          (Nat.add_zero p) (Nat.zero_add 1) (rfl : p + 1 = p + 1),
        ← h_nat,
        ← CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mapExactFunctor pb_Wf u)
          (hSE_S.map_of_exact pb_Wf).extClass (CategoryTheory.Abelian.Ext.mk₀ (e_pb.hom.app Y₀))
          (rfl : p + 1 = p + 1) (Nat.add_zero 1) (by omega),
        ← CategoryTheory.Abelian.Ext.mapExactFunctor_extClass,
        ← CategoryTheory.Abelian.Ext.mapExactFunctor_comp]

  have hRightCounit : ∀ (Q : CategoryTheory.Sheaf W_top.smallEtaleTopology AddCommGrpCat.{u}),
      e_pb.hom.app (pf_f.obj (pf_g.obj Q)) ≫
        (pb_g.map (adj_f.counit.app (pf_g.obj Q)) ≫ adj_g.counit.app Q) =
      pb_Wf.map (e_pf.hom.app Q) ≫ adj_Wf.counit.app Q := by
    intro Q
    apply (adj_Wf.homEquiv (R₂.obj Q) Q).injective
    let counit_Q : L₂.obj (R₂.obj Q) ⟶ Q := adj₂.counit.app Q
    change adj_Wf.homEquiv (R₂.obj Q) Q (e_pb.hom.app (R₂.obj Q) ≫ counit_Q) =
      adj_Wf.homEquiv (R₂.obj Q) Q (pb_Wf.map (e_pf.hom.app Q) ≫ adj_Wf.counit.app Q)
    have he_app : adj_Wf.homEquiv (R₂.obj Q) (L₂.obj (R₂.obj Q)) (e_pb.hom.app (R₂.obj Q)) =
        adj₂.unit.app (R₂.obj Q) ≫ e_pf.hom.app (L₂.obj (R₂.obj Q)) :=
      Equiv.apply_symm_apply _ _
    have h_rhs : adj_Wf.homEquiv (R₂.obj Q) Q (pb_Wf.map (e_pf.hom.app Q) ≫ adj_Wf.counit.app Q) =
        e_pf.hom.app Q := by
      let pf_Wf_std := (weilEtaleSitePullback h_Wf).sheafPushforwardContinuous
        AddCommGrpCat.{u} S.smallEtaleTopology W_top.smallEtaleTopology
      have h_un_epf : adj_Wf.unit.app (R₂.obj Q) ≫ pf_Wf_std.map (pb_Wf.map (e_pf.hom.app Q)) =
          e_pf.hom.app Q ≫ adj_Wf.unit.app (pf_Wf_std.obj Q) :=
        (adj_Wf.unit.naturality (e_pf.hom.app Q)).symm
      rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Functor.map_comp,
        ← CategoryTheory.Category.assoc, h_un_epf,
        CategoryTheory.Category.assoc, adj_Wf.right_triangle_components Q,
        CategoryTheory.Category.comp_id]
    rw [h_rhs, CategoryTheory.Adjunction.homEquiv_naturality_right, he_app,
      CategoryTheory.Category.assoc, ← e_pf.hom.naturality counit_Q,
      ← CategoryTheory.Category.assoc]
    have h_tri : adj₂.unit.app (R₂.obj Q) ≫
        (CategoryTheory.Functor.comp
          ((weilEtaleSitePullback g).sheafPushforwardContinuous
            AddCommGrpCat.{u} Y.smallEtaleTopology W_top.smallEtaleTopology)
          ((weilEtaleSitePullback f).sheafPushforwardContinuous
            AddCommGrpCat.{u} S.smallEtaleTopology Y.smallEtaleTopology)).map counit_Q =
        CategoryTheory.CategoryStruct.id _ :=
      adj₂.right_triangle_components Q
    rw [h_tri]
    exact CategoryTheory.Category.id_comp (e_pf.hom.app Q)

  have hConstAdj : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂)
      {T₁ : Z₁.Etale} (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
      {T₂ : Z₂.Etale} (hT₂ : CategoryTheory.Limits.IsTerminal T₂)
      (V : Z₂.Etale) (x : ↑Aℤ),
      let B_h := weilEtaleSitePullback h
      let pf_h := B_h.sheafPushforwardContinuous AddCommGrpCat.{u}
        Z₂.smallEtaleTopology Z₁.smallEtaleTopology
      let adj_h := B_h.sheafAdjunctionContinuous AddCommGrpCat.{u}
        Z₂.smallEtaleTopology Z₁.smallEtaleTopology
      let Fℤ₁ := (CategoryTheory.constantSheaf Z₁.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
      let Fℤ₂ := (CategoryTheory.constantSheaf Z₂.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
      let P_c₁ := (CategoryTheory.Functor.const (Opposite Z₁.Etale)).obj Aℤ
      let P_c₂ := (CategoryTheory.Functor.const (Opposite Z₂.Etale)).obj Aℤ
      let η_sh₁ := (CategoryTheory.sheafificationAdjunction Z₁.smallEtaleTopology
        AddCommGrpCat.{u}).unit.app P_c₁
      (((CategoryTheory.sheafificationAdjunction Z₂.smallEtaleTopology
          AddCommGrpCat.{u}).homEquiv P_c₂ (pf_h.obj Fℤ₁)
          (adj_h.homEquiv Fℤ₂ Fℤ₁ (weilEtaleConstPullbackHom h hT₁ hT₂ Aℤ))).app
          (Opposite.op V)) x =
        (η_sh₁.app (Opposite.op (B_h.obj V))) x := by
    intro Z₁ Z₂ h T₁ hT₁ T₂ hT₂ V x B_h pf_h adj_h Fℤ₁ Fℤ₂ P_c₁ P_c₂ η_sh₁
    dsimp only [weilEtaleConstPullbackHom]
    rw [Equiv.apply_symm_apply]
    let adj₁ := CategoryTheory.constantSheafAdj Z₁.smallEtaleTopology AddCommGrpCat.{u} hT₁
    let adj₂ := CategoryTheory.constantSheafAdj Z₂.smallEtaleTopology AddCommGrpCat.{u} hT₂
    let adj_sh₂ := CategoryTheory.sheafificationAdjunction Z₂.smallEtaleTopology AddCommGrpCat.{u}
    let φ₀ : Aℤ ⟶ (pf_h.obj Fℤ₁).obj.obj (Opposite.op T₂) :=
      adj₁.unit.app Aℤ ≫ Fℤ₁.obj.map (Opposite.op (hT₁.from (B_h.obj T₂)))
    let θ₀ : Fℤ₂ ⟶ pf_h.obj Fℤ₁ := (adj₂.homEquiv Aℤ (pf_h.obj Fℤ₁)).symm φ₀
    change ((adj_sh₂.homEquiv P_c₂ (pf_h.obj Fℤ₁) θ₀).app (Opposite.op V)) x = _
    let ψ_pull : P_c₂ ⟶ (pf_h.obj Fℤ₁).obj :=
      { app := fun W => η_sh₁.app (Opposite.op (B_h.obj W.unop))
        naturality := fun {W₁ W₂} ω => by
          ext y
          exact congrArg (fun τ => τ y) (η_sh₁.naturality (Opposite.op (B_h.map ω.unop))) }
    let θ_sh : Fℤ₂ ⟶ pf_h.obj Fℤ₁ := (adj_sh₂.homEquiv P_c₂ (pf_h.obj Fℤ₁)).symm ψ_pull
    have h_θ₀_eq : θ₀ = θ_sh := by
      apply (adj₂.homEquiv Aℤ (pf_h.obj Fℤ₁)).injective
      dsimp only [θ₀]
      rw [Equiv.apply_symm_apply]
      have h_u₁ : adj₁.unit.app Aℤ = η_sh₁.app (Opposite.op T₁) :=
        CategoryTheory.Category.id_comp (η_sh₁.app (Opposite.op T₁))
      have h_he₂ : adj₂.homEquiv Aℤ (pf_h.obj Fℤ₁) θ_sh =
          ((adj_sh₂.homEquiv P_c₂ (pf_h.obj Fℤ₁) θ_sh).app (Opposite.op T₂)) :=
        CategoryTheory.Category.id_comp
          ((adj_sh₂.homEquiv P_c₂ (pf_h.obj Fℤ₁) θ_sh).app (Opposite.op T₂))
      have h_nat : η_sh₁.app (Opposite.op T₁) ≫
          Fℤ₁.obj.map (Opposite.op (hT₁.from (B_h.obj T₂))) =
          η_sh₁.app (Opposite.op (B_h.obj T₂)) := by
        ext y
        exact (congrArg (fun τ => τ y)
          (η_sh₁.naturality (Opposite.op (hT₁.from (B_h.obj T₂))))).symm
      change φ₀ = adj₂.homEquiv Aℤ (pf_h.obj Fℤ₁) θ_sh
      rw [h_he₂]
      have h_app : (adj_sh₂.homEquiv P_c₂ (pf_h.obj Fℤ₁) θ_sh) = ψ_pull :=
        Equiv.apply_symm_apply _ _
      rw [h_app]
      dsimp only [φ₀, ψ_pull]
      rw [h_u₁]
      exact h_nat
    have h_θ_eq : adj_sh₂.homEquiv P_c₂ (pf_h.obj Fℤ₁) θ₀ = ψ_pull := by
      have h_congr := congrArg
        (fun (φ : Fℤ₂ ⟶ pf_h.obj Fℤ₁) => adj_sh₂.homEquiv P_c₂ (pf_h.obj Fℤ₁) φ) h_θ₀_eq
      exact h_congr.trans (Equiv.apply_symm_apply _ _)
    exact congrArg (fun τ : P_c₂ ⟶ (pf_h.obj Fℤ₁).obj => (τ.app (Opposite.op V)) x) h_θ_eq

  let hT_W_std := weilEtaleIdTerminalIsTerminal.{u} W_top
  let hT_Y_std := weilEtaleIdTerminalIsTerminal.{u} Y
  let hT_S_std := weilEtaleIdTerminalIsTerminal.{u} S
  let πℤ_g := weilEtaleConstPullbackHom g hT_W hT_Y Aℤ
  let πℤ_f_std := weilEtaleConstPullbackHom f hT_Y_std hT_S_std Aℤ
  let πℤ_Wf_std := weilEtaleConstPullbackHom h_Wf hT_W_std hT_S_std Aℤ
  have : CategoryTheory.IsIso πℤ_f_std := (sys f).hConstIso hT_Y_std hT_S_std Aℤ
  have : CategoryTheory.IsIso πℤ_Wf_std := (sys h_Wf).hConstIso hT_W_std hT_S_std Aℤ
  let ιℤ_f_std : Fℤ_Y ⟶ pb_f.obj Fℤ_S := CategoryTheory.inv πℤ_f_std
  let ιℤ_Wf_std : Fℤ_W ⟶ pb_Wf.obj Fℤ_S := CategoryTheory.inv πℤ_Wf_std

  have hLeftConst : ιℤ_g ≫ pb_g.map ιℤ_f_std ≫ e_pb.inv.app Fℤ_S = ιℤ_Wf_std := by
    have h_π : e_pb.hom.app Fℤ_S ≫ (pb_g.map πℤ_f_std ≫ πℤ_g) = πℤ_Wf_std := by
      apply (adj_Wf.homEquiv Fℤ_S Fℤ_W).injective
      let π_comp : L₂.obj Fℤ_S ⟶ Fℤ_W := pb_g.map πℤ_f_std ≫ πℤ_g
      change adj_Wf.homEquiv Fℤ_S Fℤ_W (e_pb.hom.app Fℤ_S ≫ π_comp) =
        adj_Wf.homEquiv Fℤ_S Fℤ_W πℤ_Wf_std
      have he_S : adj_Wf.homEquiv Fℤ_S (L₂.obj Fℤ_S) (e_pb.hom.app Fℤ_S) =
          adj₂.unit.app Fℤ_S ≫ e_pf.hom.app (L₂.obj Fℤ_S) :=
        Equiv.apply_symm_apply _ _
      rw [CategoryTheory.Adjunction.homEquiv_naturality_right, he_S,
        CategoryTheory.Category.assoc, ← e_pf.hom.naturality π_comp,
        ← CategoryTheory.Category.assoc]
      have h_adj₂ : adj₂.unit.app Fℤ_S ≫
          (CategoryTheory.Functor.comp
            ((weilEtaleSitePullback g).sheafPushforwardContinuous
              AddCommGrpCat.{u} Y.smallEtaleTopology W_top.smallEtaleTopology)
            ((weilEtaleSitePullback f).sheafPushforwardContinuous
              AddCommGrpCat.{u} S.smallEtaleTopology Y.smallEtaleTopology)).map π_comp =
          (adj_f.homEquiv Fℤ_S Fℤ_Y πℤ_f_std) ≫
            pf_f.map (adj_g.homEquiv Fℤ_Y Fℤ_W πℤ_g) := by
        have h_un_g : adj_g.unit.app (pb_f.obj Fℤ_S) ≫ pf_g.map (pb_g.map πℤ_f_std) =
            πℤ_f_std ≫ adj_g.unit.app Fℤ_Y :=
          (adj_g.unit.naturality πℤ_f_std).symm
        change (adj_f.unit.app Fℤ_S ≫ pf_f.map (adj_g.unit.app (pb_f.obj Fℤ_S))) ≫
            pf_f.map (pf_g.map (pb_g.map πℤ_f_std) ≫ pf_g.map πℤ_g) = _
        rw [CategoryTheory.Category.assoc, ← pf_f.map_comp,
          ← CategoryTheory.Category.assoc (adj_g.unit.app _), h_un_g,
          CategoryTheory.Category.assoc, pf_f.map_comp, ← CategoryTheory.Category.assoc]
        rfl
      rw [h_adj₂]
      let P_cW := (CategoryTheory.Functor.const (Opposite W_top.Etale)).obj Aℤ
      let P_cY := (CategoryTheory.Functor.const (Opposite Y.Etale)).obj Aℤ
