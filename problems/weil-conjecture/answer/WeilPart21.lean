        (shAdj_X.homEquiv_unit P_A_X F_AX (𝟙 F_AX)).trans (CategoryTheory.Category.comp_id _)
      refine hL_eq.trans (Eq.trans ?_ hR_eq.symm)
      refine CategoryTheory.NatTrans.ext (funext fun V => ?_)
      change ν_S.app (Opposite.op (j_w.obj V.unop)) ≫ ρ_A.hom.app V = ν_X.app V
      let β_S : C_S.obj A ⟶ P_push.obj (C_X.obj A) :=
        (adj_S.homEquiv A (P_push.obj (C_X.obj A))).symm
          (adj_X.unit.app A ≫ (C_X.obj A).obj.map τ_w.op)
      have hρ_def : ρ_A = R_w.map β_S ≫ adj_w.counit.app (C_X.obj A) :=
        adj_w.homEquiv_counit (C_S.obj A) (C_X.obj A) β_S
      have hβ_top : ν_S.app (Opposite.op T_S) ≫ β_S.hom.app (Opposite.op T_S) =
          adj_X.unit.app A ≫ (C_X.obj A).obj.map τ_w.op := by
        rw [← h_unit_S]
        exact (adj_S.homEquiv_unit A _ β_S).symm.trans (Equiv.apply_symm_apply _ _)
      let u_V : j_w.obj V.unop ⟶ T_S := hT_S.from (j_w.obj V.unop)
      have hνS_nat : ν_S.app (Opposite.op T_S) ≫ (C_S.obj A).obj.map u_V.op =
          ν_S.app (Opposite.op (j_w.obj V.unop)) := by
        have hn := ν_S.naturality u_V.op
        dsimp [P_A_S] at hn
        rw [CategoryTheory.Category.id_comp] at hn
        exact hn.symm
      have hβ_nat : (C_S.obj A).obj.map u_V.op ≫ β_S.hom.app (Opposite.op (j_w.obj V.unop)) =
          β_S.hom.app (Opposite.op T_S) ≫ (C_X.obj A).obj.map (B_w.map u_V).op :=
        β_S.hom.naturality u_V.op
      have hρ_app : ρ_A.hom.app V =
          β_S.hom.app (Opposite.op (j_w.obj V.unop)) ≫
            (C_X.obj A).obj.map (adj_site.unit.app V.unop).op :=
        congrArg (fun φ => φ.hom.app V) hρ_def
      have hs1 : ν_S.app (Opposite.op (j_w.obj V.unop)) ≫ ρ_A.hom.app V =
          (ν_S.app (Opposite.op T_S) ≫ (C_S.obj A).obj.map u_V.op) ≫
            (β_S.hom.app (Opposite.op (j_w.obj V.unop)) ≫
              (C_X.obj A).obj.map (adj_site.unit.app V.unop).op) :=
        (congrArg (ν_S.app (Opposite.op (j_w.obj V.unop)) ≫ ·) hρ_app).trans
          (congrArg (· ≫ (β_S.hom.app (Opposite.op (j_w.obj V.unop)) ≫
            (C_X.obj A).obj.map (adj_site.unit.app V.unop).op)) hνS_nat.symm)
      have hs2 : (ν_S.app (Opposite.op T_S) ≫ (C_S.obj A).obj.map u_V.op) ≫
            (β_S.hom.app (Opposite.op (j_w.obj V.unop)) ≫
              (C_X.obj A).obj.map (adj_site.unit.app V.unop).op) =
          (ν_S.app (Opposite.op T_S) ≫ β_S.hom.app (Opposite.op T_S)) ≫
            ((C_X.obj A).obj.map (B_w.map u_V).op ≫
              (C_X.obj A).obj.map (adj_site.unit.app V.unop).op) :=
        (CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg (ν_S.app (Opposite.op T_S) ≫ ·)
              ((CategoryTheory.Category.assoc _ _ _).symm.trans
                ((congrArg (· ≫ (C_X.obj A).obj.map (adj_site.unit.app V.unop).op) hβ_nat).trans
                  (CategoryTheory.Category.assoc _ _ _)))).trans
            (CategoryTheory.Category.assoc _ _ _).symm)
      have hs3 : (ν_S.app (Opposite.op T_S) ≫ β_S.hom.app (Opposite.op T_S)) ≫
            ((C_X.obj A).obj.map (B_w.map u_V).op ≫
              (C_X.obj A).obj.map (adj_site.unit.app V.unop).op) =
          ν_X.app (Opposite.op T_X) ≫ (C_X.obj A).obj.map (hT_X.from V.unop).op :=
        (congrArg (· ≫ ((C_X.obj A).obj.map (B_w.map u_V).op ≫
            (C_X.obj A).obj.map (adj_site.unit.app V.unop).op))
          (hβ_top.trans (congrArg (· ≫ (C_X.obj A).obj.map τ_w.op) h_unit_X))).trans
          ((CategoryTheory.Category.assoc _ _ _).trans
            (congrArg (ν_X.app (Opposite.op T_X) ≫ ·)
              (((CategoryTheory.Category.assoc _ _ _).symm.trans
                  (congrArg (· ≫ (C_X.obj A).obj.map (adj_site.unit.app V.unop).op)
                    ((C_X.obj A).obj.map_comp τ_w.op (B_w.map u_V).op).symm)).trans
                (((C_X.obj A).obj.map_comp (B_w.map u_V ≫ τ_w).op
                    (adj_site.unit.app V.unop).op).symm.trans
                  (congrArg (fun k => (C_X.obj A).obj.map k.op)
                    (hT_X.hom_ext (adj_site.unit.app V.unop ≫ (B_w.map u_V ≫ τ_w))
                      (hT_X.from V.unop)))))))
      have hs4 : ν_X.app (Opposite.op T_X) ≫ (C_X.obj A).obj.map (hT_X.from V.unop).op =
          ν_X.app V :=
        ((CategoryTheory.Category.id_comp _).symm.trans
          (ν_X.naturality (hT_X.from V.unop).op)).symm
      exact hs1.trans (hs2.trans (hs3.trans hs4))
    have hρσ : ρ_A ≫ σ_A = 𝟙 (R_w.obj (C_S.obj A)) := by
      rw [← CategoryTheory.cancel_mono ρ_A, CategoryTheory.Category.assoc, hσρ,
        CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
    exact ⟨hσρ, hρσ⟩

  let zsmulHom : ∀ (M : AddCommGrpCat.{u}), ↥M → (AddCommGrpCat.of (ULift.{u} ℤ) ⟶ M) :=
    fun M m => AddCommGrpCat.ofHom
      { toFun := fun z => z.down • m
        map_zero' := zero_zsmul m
        map_add' := fun a b => add_zsmul m a.down b.down }

  have hzsmul_eval : ∀ {M : AddCommGrpCat.{u}} (m : ↥M),
      (zsmulHom M m).hom (ULift.up (1 : ℤ)) = m :=
    fun m => one_zsmul m

  have hzsmul_ext : ∀ {M : AddCommGrpCat.{u}}
      (f₁ f₂ : AddCommGrpCat.of (ULift.{u} ℤ) ⟶ M),
      f₁.hom (ULift.up (1 : ℤ)) = f₂.hom (ULift.up (1 : ℤ)) → f₁ = f₂ := by
    intro M f₁ f₂ h1
    apply AddCommGrpCat.hom_ext
    refine AddMonoidHom.ext fun z => ?_
    have hz : z = z.down • ULift.up (1 : ℤ) :=
      ULift.ext _ _ (mul_one z.down).symm
    rw [hz, map_zsmul, map_zsmul, h1]

  have hSliceCohom : ∀ (S : AlgebraicGeometry.Scheme.{u}) (W : S.Etale),
      let X := ((AlgebraicGeometry.Scheme.Etale.forget S).obj W).left
      let w := ((AlgebraicGeometry.Scheme.Etale.forget S).obj W).hom
      letI : (sliceMap w W.prop).IsContinuous X.smallEtaleTopology S.smallEtaleTopology :=
        hSliceCont w W.prop
      let j_w := sliceMap w W.prop
      let R_w := j_w.sheafPushforwardContinuous
        AddCommGrpCat.{u} X.smallEtaleTopology S.smallEtaleTopology
      ∀ (_ : R_w.Additive)
        (_ : CategoryTheory.Limits.PreservesFiniteLimits R_w)
        (_ : CategoryTheory.Limits.PreservesFiniteColimits R_w),
        (∀ (I : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}),
          CategoryTheory.Injective I → CategoryTheory.Injective (R_w.obj I)) →
        let T_X := weilEtaleIdTerminal.{u} X
        let hT_X := weilEtaleIdTerminalIsTerminal.{u} X
        let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
        let C_X := CategoryTheory.constantSheaf X.smallEtaleTopology AddCommGrpCat.{u}
        let adj_X := CategoryTheory.constantSheafAdj X.smallEtaleTopology AddCommGrpCat.{u} hT_X
        let shAdj_S := CategoryTheory.sheafificationAdjunction S.smallEtaleTopology AddCommGrpCat.{u}
        let P_W := (CategoryTheory.yoneda.obj W).comp AddCommGrpCat.free
        let L_W := weilPolyP1CohomologyRepSheaf S W
        let ι_W : Quiver.Hom (j_w.obj T_X) W :=
          CategoryTheory.MorphismProperty.Over.homMk
            (CategoryTheory.CategoryStruct.id X : (j_w.obj T_X).left ⟶ W.left)
            (CategoryTheory.Category.id_comp w) trivial
        ∃ (u_W : Quiver.Hom (C_X.obj Aℤ) (R_w.obj L_W)),
          ((adj_X.homEquiv Aℤ (R_w.obj L_W) u_W).hom) (ULift.up (1 : ℤ)) =
            ((shAdj_S.unit.app P_W).app (Opposite.op (j_w.obj T_X))).hom
              (FreeAbelianGroup.of ι_W) ∧
          ∀ (ℱ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ),
            Function.Bijective
              (fun z : ↥((ℱ.cohomologyPresheaf q).obj (Opposite.op W)) =>
                ((CategoryTheory.Abelian.Ext.mk₀ u_W).comp
                  ((R_w.mapExtAddHom L_W ℱ q) z) (Nat.zero_add q) : (R_w.obj ℱ).H q)) := by
    intro S W X w j_w R_w hAdd hLim hColim hInj T_X hT_X Aℤ C_X adj_X shAdj_S P_W L_W ι_W
    let s₀ : ↥((R_w.obj L_W).obj.obj (Opposite.op T_X)) :=
      ((shAdj_S.unit.app P_W).app (Opposite.op (j_w.obj T_X))).hom (FreeAbelianGroup.of ι_W)
    let u_W : C_X.obj Aℤ ⟶ R_w.obj L_W :=
      (adj_X.homEquiv Aℤ (R_w.obj L_W)).symm (zsmulHom _ s₀)
    have hu_W_one : ((adj_X.homEquiv Aℤ (R_w.obj L_W) u_W).hom) (ULift.up (1 : ℤ)) = s₀ := by
      rw [Equiv.apply_symm_apply, hzsmul_eval]
    refine ⟨u_W, hu_W_one, ?_⟩
    let Φ : ∀ (ℱ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ),
        CategoryTheory.Abelian.Ext.{u} L_W ℱ q →+ (R_w.obj ℱ).H q :=
      fun ℱ q => ((CategoryTheory.Abelian.Ext.mk₀ u_W).precomp (R_w.obj ℱ) (Nat.zero_add q)).comp
        (R_w.mapExtAddHom L_W ℱ q)
    suffices hAll : ∀ (q : ℕ) (ℱ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}),
        Function.Bijective (Φ ℱ q) by
      intro ℱ q
      exact hAll q ℱ
    intro q
    induction q with
    | zero =>
      intro ℱ
      let ι_W_inv : W ⟶ j_w.obj T_X :=
        CategoryTheory.MorphismProperty.Over.homMk
          (𝟙 X : W.left ⟶ (j_w.obj T_X).left)
          (CategoryTheory.Category.id_comp w).symm trivial
      have hι_id₁ : ι_W ≫ ι_W_inv = 𝟙 (j_w.obj T_X) :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext
          (CategoryTheory.Category.id_comp _) (Subsingleton.elim _ _)
      have hι_id₂ : ι_W_inv ≫ ι_W = 𝟙 W :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext
          (CategoryTheory.Category.id_comp _) (Subsingleton.elim _ _)
      let e_LHS : CategoryTheory.Abelian.Ext.{u} L_W ℱ 0 ≃ ↥(ℱ.obj.obj (Opposite.op W)) :=
        (CategoryTheory.Abelian.Ext.addEquiv₀.toEquiv).trans (weilPolyP1CohomologyRepHomEquiv S W ℱ)
      let evalOne : ∀ M : AddCommGrpCat.{u}, (Aℤ ⟶ M) ≃ ↥M :=
        fun M =>
          { toFun := fun g => g.hom (ULift.up (1 : ℤ))
            invFun := zsmulHom M
            left_inv := fun g => hzsmul_ext _ _ (hzsmul_eval _)
            right_inv := hzsmul_eval }
      let e_RHS : (R_w.obj ℱ).H 0 ≃ ↥(ℱ.obj.obj (Opposite.op (j_w.obj T_X))) :=
        (CategoryTheory.Abelian.Ext.addEquiv₀.toEquiv).trans
          ((adj_X.homEquiv Aℤ (R_w.obj ℱ)).trans (evalOne _))
      let e_mid : ↥(ℱ.obj.obj (Opposite.op W)) ≃ ↥(ℱ.obj.obj (Opposite.op (j_w.obj T_X))) :=
        { toFun := (ℱ.obj.map ι_W.op).hom
          invFun := (ℱ.obj.map ι_W_inv.op).hom
          left_inv := fun s => by
            change ((ℱ.obj.map ι_W.op ≫ ℱ.obj.map ι_W_inv.op).hom) s = s
            rw [← ℱ.obj.map_comp, ← hop_comp, hι_id₂, hop_id, ℱ.obj.map_id]
            rfl
          right_inv := fun s => by
            change ((ℱ.obj.map ι_W_inv.op ≫ ℱ.obj.map ι_W.op).hom) s = s
            rw [← ℱ.obj.map_comp, ← hop_comp, hι_id₁, hop_id, ℱ.obj.map_id]
            rfl }
      have hComm : ∀ z : CategoryTheory.Abelian.Ext.{u} L_W ℱ 0,
          e_RHS (Φ ℱ 0 z) = e_mid (e_LHS z) := by
        intro z
        let f : L_W ⟶ ℱ := CategoryTheory.Abelian.Ext.addEquiv₀ z
        have hz_f : z = CategoryTheory.Abelian.Ext.mk₀ f :=
          (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply z).symm
        have hRepEval : weilPolyP1CohomologyRepHomEquiv S W ℱ f =
            (f.hom.app (Opposite.op W)).hom
              (((shAdj_S.unit.app P_W).app (Opposite.op W)).hom
                (FreeAbelianGroup.of (𝟙 W))) := by
          dsimp [weilPolyP1CohomologyRepHomEquiv, CategoryTheory.yonedaEquiv]
          rw [shAdj_S.homEquiv_unit]
          rfl
        have hPW_map : (P_W.map ι_W.op).hom (FreeAbelianGroup.of (𝟙 W)) =
            FreeAbelianGroup.of ι_W := by
