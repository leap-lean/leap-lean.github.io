      Algebra.TensorProduct.congr_apply, AlgEquiv.refl_toAlgHom,
      Algebra.TensorProduct.map_tmul, AlgHom.id_apply, AlgEquiv.coe_toAlgHom, hΦ_fin_tmul]

  refine ⟨C_fin, inferInstance, inferInstance, inferInstance, hTower_B_Cinit_Cfin,
    hEt_Cinit_Cfin, u_fin, α_fin, ?_, ?_⟩
  · apply RingHom.ext
