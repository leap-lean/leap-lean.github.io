                CategoryTheory.Preadditive.add_comp _ _ _ _ _ _
            _ = (𝟙 Aℤ ≫ adj_S.homEquiv Aℤ (pf_g.obj N) f₁ ≫ N.obj.map τ_g_iso.inv.op) +
                  (𝟙 Aℤ ≫ adj_S.homEquiv Aℤ (pf_g.obj N) f₂ ≫ N.obj.map τ_g_iso.inv.op) := by
                rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.id_comp]
            _ = adj_P.homEquiv Aℤ N (homEquivN N f₁) +
                  adj_P.homEquiv Aℤ N (homEquivN N f₂) :=
                congrArg₂ (· + ·) hR1.symm hR2.symm
