          (fun {K : CategoryTheory.ShortComplex AddCommGrpCat.{u}} (_ : K.Exact) => K.zero) hex
        have hzx : (AddCommGrpCat.ofHom (hSE.extClass.postcomp (Z_obj W) rfl) ≫
            AddCommGrpCat.ofHom
              ((CategoryTheory.Abelian.Ext.mk₀ SC.f).postcomp (Z_obj W) (Nat.add_zero (q + 1)))) x = 0 :=
          congrArg (fun φ => φ x) hz₀
        rw [CategoryTheory.NatTrans.comp_app, CategoryTheory.NatTrans.app_zero, hf_app W]
        exact hzx
      let A_pre := CategoryTheory.ShortComplex.mk
        ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_Y q).map SC.g) δ_pre hcomp₁_pre
      let B_pre := CategoryTheory.ShortComplex.mk
        δ_pre ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_Y (q + 1)).map SC.f) hcomp₂_pre
      have hA_pre_ex : A_pre.Exact := by
        apply hPresheafExact A_pre
        intro W
        let evW := (CategoryTheory.evaluation (Opposite Y.Etale) AddCommGrpCat.{u}).obj W
        have hex := CategoryTheory.Abelian.Ext.covariant_sequence_exact₃' (Z_obj W) hSE q (q + 1) rfl
        let eW : A_pre.map evW ≅ _ :=
          CategoryTheory.ShortComplex.isoMk
            (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
            (by dsimp [A_pre, evW]; rw [hg_app W]; ext x; rfl)
            (by dsimp [A_pre, evW, δ_pre, mkDeltaPre]; ext x; rfl)
        exact (CategoryTheory.ShortComplex.exact_iff_of_iso eW).mpr hex
      have hB_pre_ex : B_pre.Exact := by
        apply hPresheafExact B_pre
        intro W
        let evW := (CategoryTheory.evaluation (Opposite Y.Etale) AddCommGrpCat.{u}).obj W
        have hex := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁' (Z_obj W) hSE q (q + 1) rfl
        let eW : B_pre.map evW ≅ _ :=
          CategoryTheory.ShortComplex.isoMk
            (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
            (by dsimp [B_pre, evW, δ_pre, mkDeltaPre]; ext x; rfl)
            (by dsimp [B_pre, evW]; rw [hf_app W]; ext x; rfl)
        exact (CategoryTheory.ShortComplex.exact_iff_of_iso eW).mpr hex
      have hcomp₁ : (Φ q).map SC.g ≫ Δ = 0 := by
        change E_S.map ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_Y q).map SC.g) ≫
          E_S.map δ_pre = 0
        rw [← E_S.map_comp, hcomp₁_pre, E_S.map_zero]
      have hcomp₂ : Δ ≫ (Φ (q + 1)).map SC.f = 0 := by
        change E_S.map δ_pre ≫
          E_S.map ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_Y (q + 1)).map SC.f) = 0
        rw [← E_S.map_comp, hcomp₂_pre, E_S.map_zero]
      exact ⟨hcomp₁, hcomp₂, (hA_pre_ex.map W_B).map Sh_S, (hB_pre_ex.map W_B).map Sh_S⟩

    have hShiftZero : ∀ (SC : CategoryTheory.ShortComplex (CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}))
        (q : ℕ),
        SC.ShortExact →
        CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f q SC.X₂) →
        CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f (q + 1) SC.X₁) →
        CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f q SC.X₃) := by
      intro SC q hSE hZ₂ hZ₁_succ
      obtain ⟨hcomp₁, _, hEx₁, _⟩ := hConn SC hSE q
      let Δ := E_S.map (mkDeltaPre hSE q)
      have hZ₂' : CategoryTheory.Limits.IsZero ((Φ q).obj SC.X₂) := hZ₂
      have hZ₁_succ' : CategoryTheory.Limits.IsZero ((Φ (q + 1)).obj SC.X₁) := hZ₁_succ
      have hg0 : (Φ q).map SC.g = 0 := hZ₂'.eq_of_src ((Φ q).map SC.g) 0
      have hΔ0 : Δ = 0 := hZ₁_succ'.eq_of_tgt Δ 0
      have : CategoryTheory.Mono Δ := hEx₁.mono_g hg0
      rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
      change CategoryTheory.CategoryStruct.id ((Φ q).obj SC.X₃) = 0
      apply (CategoryTheory.cancel_mono Δ).mp
      rw [CategoryTheory.Category.id_comp, CategoryTheory.Limits.zero_comp, hΔ0]

    have hInjZero : ∀ (I : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u})
        [CategoryTheory.Injective I] (p : ℕ),
        1 ≤ p → CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f p I) := by
      intro I _ p hp
      obtain ⟨k, rfl⟩ : ∃ k, p = k + 1 := ⟨p - 1, (Nat.sub_add_cancel hp).symm⟩
      have hZero_cohom : CategoryTheory.Limits.IsZero (I.cohomologyPresheaf (k + 1)) := by
        apply CategoryTheory.Functor.isZero
        intro W
        rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
        ext x
        exact CategoryTheory.Abelian.Ext.eq_zero_of_injective x
      dsimp [weilEtaleHigherDirectImage]
      apply Sh_S.map_isZero
      apply CategoryTheory.Functor.isZero
      intro W
      exact (CategoryTheory.Functor.isZero_iff _).mp hZero_cohom _

    have hPushSE : ∀ (SC : CategoryTheory.ShortComplex (CategoryTheory.Sheaf J_Y AddCommGrpCat.{u})),
        SC.ShortExact →
        CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f 1 SC.X₁) →
        (SC.map pf_f).ShortExact := by
      intro SC hSE hZ₁
      obtain ⟨hSC_ex, hSC_mono⟩ :=
        (CategoryTheory.Functor.preservesFiniteLimits_iff_forall_exact_map_and_mono pf_f).mp
          inferInstance SC hSE
      obtain ⟨hcomp₁_0, _, hEx₁_0, _⟩ := hConn SC hSE 0
      let Δ₀ := E_S.map (mkDeltaPre hSE 0)
      let δ₀ : pf_f.obj SC.X₃ ⟶ (Φ 1).obj SC.X₁ := (c₀_iso SC.X₃).hom ≫ Δ₀
      have hcomp₀ : pf_f.map SC.g ≫ δ₀ = 0 := by
        dsimp only [δ₀]
        rw [← CategoryTheory.Category.assoc, hc₀_nat SC.g,
          CategoryTheory.Category.assoc, hcomp₁_0, CategoryTheory.Limits.comp_zero]
      let e_SC : CategoryTheory.ShortComplex.mk ((Φ 0).map SC.g) Δ₀ hcomp₁_0 ≅
          CategoryTheory.ShortComplex.mk (pf_f.map SC.g) δ₀ hcomp₀ :=
        CategoryTheory.ShortComplex.isoMk
          (c₀_iso SC.X₂).symm
          (c₀_iso SC.X₃).symm
          (CategoryTheory.Iso.refl _)
          (by
            calc
              (c₀_iso SC.X₂).inv ≫ pf_f.map SC.g
                = (c₀_iso SC.X₂).inv ≫ (pf_f.map SC.g ≫ (c₀_iso SC.X₃).hom) ≫
                    (c₀_iso SC.X₃).inv := by
                    simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id,
                      CategoryTheory.Category.comp_id]
              _ = (c₀_iso SC.X₂).inv ≫ ((c₀_iso SC.X₂).hom ≫ (Φ 0).map SC.g) ≫
                    (c₀_iso SC.X₃).inv := by
                    rw [hc₀_nat SC.g]
              _ = (Φ 0).map SC.g ≫ (c₀_iso SC.X₃).inv := by
                    simp only [← CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id,
                      CategoryTheory.Category.id_comp])
          (by
            change (c₀_iso SC.X₃).inv ≫ ((c₀_iso SC.X₃).hom ≫ Δ₀) = Δ₀ ≫ 𝟙 _
            simp only [← CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id,
              CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id])
      have hEx_pf : (CategoryTheory.ShortComplex.mk (pf_f.map SC.g) δ₀ hcomp₀).Exact :=
        (CategoryTheory.ShortComplex.exact_iff_of_iso e_SC).mp hEx₁_0
      have hZ₁' : CategoryTheory.Limits.IsZero ((Φ 1).obj SC.X₁) := hZ₁
      have hδ₀_zero : δ₀ = 0 := hZ₁'.eq_of_tgt δ₀ 0
      exact CategoryTheory.ShortComplex.ShortExact.mk' hSC_ex hSC_mono (hEx_pf.epi_f hδ₀_zero)

    
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let Fℤ_Y := (CategoryTheory.constantSheaf J_Y AddCommGrpCat.{u}).obj Aℤ
    let Fℤ_S := (CategoryTheory.constantSheaf J_S AddCommGrpCat.{u}).obj Aℤ
    let hT_Y := weilEtaleIdTerminalIsTerminal.{u} Y
    let hT_S := weilEtaleIdTerminalIsTerminal.{u} S
    let πℤ_f := weilEtaleConstPullbackHom f hT_Y hT_S Aℤ
    have hIso_πℤ : CategoryTheory.IsIso πℤ_f := (sys f).hConstIso hT_Y hT_S Aℤ
    let ιℤ_f : Quiver.Hom Fℤ_Y (pb_f.obj Fℤ_S) :=
      @CategoryTheory.inv _ _ _ _ πℤ_f hIso_πℤ
    have hι1 : ιℤ_f ≫ πℤ_f = 𝟙 Fℤ_Y := CategoryTheory.IsIso.inv_hom_id πℤ_f
    have hι2 : πℤ_f ≫ ιℤ_f = 𝟙 (pb_f.obj Fℤ_S) := CategoryTheory.IsIso.hom_inv_id πℤ_f
    let leray_f : ∀ (G : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}) (q : ℕ),
        (pf_f.obj G).H q →+ G.H q :=
      fun G q =>
        ((CategoryTheory.Abelian.Ext.mk₀ (adj_f.counit.app G)).postcomp Fℤ_Y
            (Nat.add_zero q)).comp
          (((CategoryTheory.Abelian.Ext.mk₀ ιℤ_f).precomp (pb_f.obj (pf_f.obj G))
              (Nat.zero_add q)).comp
            (@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ pb_f _ _ _ _ _
              Fℤ_S (pf_f.obj G) q))
    have hLeray_bij : ∀ (q : ℕ) (G : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}),
        (∀ p : ℕ, 1 ≤ p → CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f p G)) →
        Function.Bijective (leray_f G q) := by
      intro q
      induction q with
      | zero =>
        intro G _
        let inv₀ : G.H 0 → (pf_f.obj G).H 0 := fun u =>
          CategoryTheory.Abelian.Ext.mk₀
            ((adj_f.homEquiv Fℤ_S G) (πℤ_f ≫ CategoryTheory.Abelian.Ext.addEquiv₀ u))
        have h_eval : ∀ w : (pf_f.obj G).H 0,
            leray_f G 0 w =
              CategoryTheory.Abelian.Ext.mk₀
                (ιℤ_f ≫ (adj_f.homEquiv Fℤ_S G).symm (CategoryTheory.Abelian.Ext.addEquiv₀ w)) := by
          intro w
          let g_w : Fℤ_S ⟶ pf_f.obj G := CategoryTheory.Abelian.Ext.addEquiv₀ w
          have hw : CategoryTheory.Abelian.Ext.mk₀ g_w = w :=
            CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply w
          change ((CategoryTheory.Abelian.Ext.mk₀ ιℤ_f).comp
              (CategoryTheory.Abelian.Ext.mapExactFunctor pb_f w) (Nat.zero_add 0)).comp
              (CategoryTheory.Abelian.Ext.mk₀ (adj_f.counit.app G)) (Nat.add_zero 0) =
            CategoryTheory.Abelian.Ext.mk₀ (ιℤ_f ≫ (adj_f.homEquiv Fℤ_S G).symm g_w)
          rw [← hw, CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
            CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
            CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
            CategoryTheory.Category.assoc,
            CategoryTheory.Adjunction.homEquiv_counit]
        refine Function.bijective_iff_has_inverse.mpr ⟨inv₀, ?_, ?_⟩
        · intro w
          rw [h_eval w]
          dsimp [inv₀]
          have h_mk : CategoryTheory.Abelian.Ext.addEquiv₀
              (CategoryTheory.Abelian.Ext.mk₀
                (ιℤ_f ≫ (adj_f.homEquiv Fℤ_S G).symm (CategoryTheory.Abelian.Ext.addEquiv₀ w))) =
              ιℤ_f ≫ (adj_f.homEquiv Fℤ_S G).symm (CategoryTheory.Abelian.Ext.addEquiv₀ w) := by
            rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply]
          rw [h_mk, ← CategoryTheory.Category.assoc, hι2, CategoryTheory.Category.id_comp,
            Equiv.apply_symm_apply, CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply]
        · intro u
          rw [h_eval (inv₀ u)]
          dsimp [inv₀]
          have h_mk : CategoryTheory.Abelian.Ext.addEquiv₀
              (CategoryTheory.Abelian.Ext.mk₀
                ((adj_f.homEquiv Fℤ_S G) (πℤ_f ≫ CategoryTheory.Abelian.Ext.addEquiv₀ u))) =
              (adj_f.homEquiv Fℤ_S G) (πℤ_f ≫ CategoryTheory.Abelian.Ext.addEquiv₀ u) := by
            rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply]
          rw [h_mk, Equiv.symm_apply_apply, ← CategoryTheory.Category.assoc, hι1,
            CategoryTheory.Category.id_comp, CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply]
      | succ q ih =>
        intro G hAcyc_G
        let I := CategoryTheory.Injective.under G
        let ι_G : G ⟶ I := CategoryTheory.Injective.ι G
        let Q := CategoryTheory.Limits.cokernel ι_G
        let SC : CategoryTheory.ShortComplex (CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}) :=
          CategoryTheory.ShortComplex.mk ι_G (CategoryTheory.Limits.cokernel.π ι_G)
            (CategoryTheory.Limits.cokernel.condition ι_G)
        have hSE : SC.ShortExact := { exact := CategoryTheory.ShortComplex.exact_cokernel ι_G }
        have hAcyc_I : ∀ p : ℕ, 1 ≤ p →
            CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f p I) :=
          fun p hp => hInjZero I p hp
        have : CategoryTheory.Injective (pf_f.obj I) :=
          CategoryTheory.Injective.injective_of_adjoint adj_f I
        have hSE_pf : (SC.map pf_f).ShortExact := hPushSE SC hSE (hAcyc_G 1 le_rfl)
        have hAcyc_Q : ∀ p : ℕ, 1 ≤ p →
            CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f p Q) :=
          fun p hp => hShiftZero SC p hSE (hAcyc_I p hp) (hAcyc_G (p + 1) (Nat.le_add_left 1 p))
        have hBij_I : Function.Bijective (leray_f I q) := ih I hAcyc_I
        have hBij_Q : Function.Bijective (leray_f Q q) := ih Q hAcyc_Q
        let hSE_pb_pf : ((SC.map pf_f).map pb_f).ShortExact := hSE_pf.map_of_exact pb_f
        let Φ_c : (SC.map pf_f).map pb_f ⟶ SC :=
          { τ₁ := adj_f.counit.app G
            τ₂ := adj_f.counit.app I
            τ₃ := adj_f.counit.app Q
            comm₁₂ := (adj_f.counit.naturality SC.f).symm
            comm₂₃ := (adj_f.counit.naturality SC.g).symm }
        have h_counit_ext :
            hSE_pb_pf.extClass.comp (CategoryTheory.Abelian.Ext.mk₀ (adj_f.counit.app G))
                (Nat.add_zero 1) =
              (CategoryTheory.Abelian.Ext.mk₀ (adj_f.counit.app Q)).comp hSE.extClass
                (Nat.zero_add 1) :=
          CategoryTheory.ShortComplex.ShortExact.extClass_naturality hSE_pb_pf hSE Φ_c
        have hLeray_δ : ∀ w : (pf_f.obj Q).H q,
            leray_f G (q + 1) (w.comp hSE_pf.extClass rfl) =
              (leray_f Q q w).comp hSE.extClass rfl := by
          intro w
          change ((CategoryTheory.Abelian.Ext.mk₀ ιℤ_f).comp
              (CategoryTheory.Abelian.Ext.mapExactFunctor pb_f (w.comp hSE_pf.extClass rfl))
              (Nat.zero_add (q + 1))).comp
              (CategoryTheory.Abelian.Ext.mk₀ (adj_f.counit.app G)) (Nat.add_zero (q + 1)) =
            (((CategoryTheory.Abelian.Ext.mk₀ ιℤ_f).comp
              (CategoryTheory.Abelian.Ext.mapExactFunctor pb_f w) (Nat.zero_add q)).comp
              (CategoryTheory.Abelian.Ext.mk₀ (adj_f.counit.app Q)) (Nat.add_zero q)).comp
              hSE.extClass rfl
          rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
            CategoryTheory.Abelian.Ext.mapExactFunctor_extClass,
            ← CategoryTheory.Abelian.Ext.comp_assoc
              (CategoryTheory.Abelian.Ext.mk₀ ιℤ_f)
              (CategoryTheory.Abelian.Ext.mapExactFunctor pb_f w)
              hSE_pb_pf.extClass (Nat.zero_add q) rfl (Nat.zero_add (q + 1)),
            CategoryTheory.Abelian.Ext.comp_assoc _
              hSE_pb_pf.extClass
              (CategoryTheory.Abelian.Ext.mk₀ (adj_f.counit.app G))
              rfl (Nat.add_zero 1) (Nat.add_zero (q + 1)),
            h_counit_ext,
            ← CategoryTheory.Abelian.Ext.comp_assoc _
              (CategoryTheory.Abelian.Ext.mk₀ (adj_f.counit.app Q))
              hSE.extClass (Nat.add_zero q) (Nat.zero_add 1) rfl]
        refine ⟨?_, ?_⟩
        · rw [injective_iff_map_eq_zero]
          intro y hy
          have hy0 : y.comp (CategoryTheory.Abelian.Ext.mk₀ (pf_f.map SC.f))
              (Nat.add_zero (q + 1)) = 0 :=
            CategoryTheory.Abelian.Ext.eq_zero_of_injective _
          obtain ⟨w, rfl⟩ :=
            CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ_S hSE_pf y hy0 rfl
          have hw0 : (leray_f Q q w).comp hSE.extClass rfl = 0 := by
            rw [← hLeray_δ w, hy]
          obtain ⟨v, hv⟩ :=
            CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ Fℤ_Y hSE (leray_f Q q w) rfl hw0
          obtain ⟨z, rfl⟩ := hBij_I.2 v
          have hw_eq : w = z.comp (CategoryTheory.Abelian.Ext.mk₀ (SC.map pf_f).g)
              (Nat.add_zero q) :=
            hBij_Q.1 ((hLerayNat f SC.g q z).trans hv).symm
          rw [hw_eq, CategoryTheory.Abelian.Ext.comp_assoc z
            (CategoryTheory.Abelian.Ext.mk₀ (SC.map pf_f).g) hSE_pf.extClass
            (Nat.add_zero q) (Nat.zero_add 1) rfl,
            hSE_pf.comp_extClass, CategoryTheory.Abelian.Ext.comp_zero]
        · intro x
          have hx0 : x.comp (CategoryTheory.Abelian.Ext.mk₀ SC.f) (Nat.add_zero (q + 1)) = 0 :=
            CategoryTheory.Abelian.Ext.eq_zero_of_injective _
          obtain ⟨u, rfl⟩ :=
            CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ_Y hSE x hx0 rfl
          obtain ⟨w, rfl⟩ := hBij_Q.2 u
          exact ⟨w.comp hSE_pf.extClass rfl, hLeray_δ w⟩

    
    let SC₀ := CategoryTheory.ShortComplex.mk R.u₀ R.v₀ R.h₀
    let SC₁ := CategoryTheory.ShortComplex.mk R.u₁ R.v₁ R.h₁
    obtain ⟨hEx_u, hMono_u⟩ :=
      (CategoryTheory.Functor.preservesFiniteLimits_iff_forall_exact_map_and_mono pf_f).mp
        inferInstance SC₁ R.hSE₁
    have hcomp_u : pf_f.map R.u₁ ≫ pf_f.map R.v₁ = 0 := by
      rw [← pf_f.map_comp, R.h₁, pf_f.map_zero]
    let δ₁_pre := mkDeltaPre R.hSE₁ 0
    let δ₀_pre := mkDeltaPre R.hSE₀ 1
    let Δ₁ : (Φ 0).obj R.Q₂ ⟶ (Φ 1).obj R.Q₁ := E_S.map δ₁_pre
    let Δ₀ : (Φ 1).obj R.Q₁ ⟶ (Φ 2).obj F := E_S.map δ₀_pre
    obtain ⟨hcomp₁_Δ₁, hcomp₂_Δ₁, hEx₁_Δ₁, hEx₂_Δ₁⟩ := hConn SC₁ R.hSE₁ 0
    obtain ⟨hcomp₁_Δ₀, hcomp₂_Δ₀, hEx₁_Δ₀, hEx₂_Δ₀⟩ := hConn SC₀ R.hSE₀ 1
    have hZ_A₁_1 : CategoryTheory.Limits.IsZero ((Φ 1).obj R.A₁) := R.hDir_A₁ 1 le_rfl
    have hEpi_Δ₁ : CategoryTheory.Epi Δ₁ :=
      hEx₂_Δ₁.epi_f (hZ_A₁_1.eq_of_tgt ((Φ 1).map R.u₁) 0)
    have hZ_A₀_1 : CategoryTheory.Limits.IsZero ((Φ 1).obj R.A₀) := R.hDir_A₀ 1 le_rfl
    have hZ_A₀_2 : CategoryTheory.Limits.IsZero ((Φ 2).obj R.A₀) := R.hDir_A₀ 2 (by omega)
    have : CategoryTheory.Mono Δ₀ :=
      hEx₁_Δ₀.mono_g (hZ_A₀_1.eq_of_src ((Φ 1).map R.v₀) 0)
    have : CategoryTheory.Epi Δ₀ :=
      hEx₂_Δ₀.epi_f (hZ_A₀_2.eq_of_tgt ((Φ 2).map R.u₀) 0)
    have hIso_Δ₀ : CategoryTheory.IsIso Δ₀ := CategoryTheory.isIso_of_mono_of_epi Δ₀
    let δ_bar_Φ : pf_f.obj R.Q₂ ⟶ (Φ 2).obj F :=
      (c₀_iso R.Q₂).hom ≫ Δ₁ ≫ Δ₀
    have hEpi_δ_Φ : CategoryTheory.Epi δ_bar_Φ := by
      dsimp only [δ_bar_Φ]
      exact CategoryTheory.epi_comp (c₀_iso R.Q₂).hom (Δ₁ ≫ Δ₀)
    have hcomp_δ_Φ : pf_f.map R.v₁ ≫ δ_bar_Φ = 0 := by
      dsimp only [δ_bar_Φ]
      rw [← CategoryTheory.Category.assoc, hc₀_nat R.v₁,
        CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc ((Φ 0).map R.v₁) Δ₁ Δ₀,
        hcomp₁_Δ₁, CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.comp_zero]
    have hEx_δ_Φ : (CategoryTheory.ShortComplex.mk (pf_f.map R.v₁) δ_bar_Φ hcomp_δ_Φ).Exact := by
      let e_SC_δ : CategoryTheory.ShortComplex.mk ((Φ 0).map R.v₁) Δ₁ hcomp₁_Δ₁ ≅
          CategoryTheory.ShortComplex.mk (pf_f.map R.v₁) δ_bar_Φ hcomp_δ_Φ :=
        CategoryTheory.ShortComplex.isoMk
          (c₀_iso R.A₁).symm
          (c₀_iso R.Q₂).symm
