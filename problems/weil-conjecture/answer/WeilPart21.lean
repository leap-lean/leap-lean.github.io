              (weilPolyP1Over k δ).hom (weilProjectiveSpaceOver k 1).hom) =
            CategoryTheory.CategoryStruct.id (weilProjectiveSpaceOver k 1).left :=
          CategoryTheory.Limits.pullback.lift_snd _ _ _
        obtain ⟨p_id, hp_id⟩ :=
          hPull_ex (CategoryTheory.CategoryStruct.id (weilProjectiveSpaceOver k 1).left) (ℓ ^ r) 2
        have hid_eq : p_id = AddMonoidHom.id _ := hPull_id (ℓ ^ r) 2 p_id hp_id
        have hp_id' : WeilIsTorsionEtalePullback
            (CategoryTheory.CategoryStruct.comp ι_σ
              (CategoryTheory.Limits.pullback.snd
                (weilPolyP1Over k δ).hom (weilProjectiveSpaceOver k 1).hom))
            (ℓ ^ r) 2 p_id := by
          rwa [h_sec]
        have hcomp_eq : p_id = p_ισ.comp p_ρ :=
          hPull_comp ι_σ _ (ℓ ^ r) 2 p_ισ p_ρ p_id hp_ισ hp_ρ hp_id'
        calc
          p_ισ (p_ρ (η r)) = (p_ισ.comp p_ρ) (η r) := rfl
          _ = p_id (η r) := by rw [← hcomp_eq]
          _ = η r := by rw [hid_eq]; rfl
      · subst hp_eq
        exact hTerm_rel δ r
    · intro δ r β₀ β₁ hβ_fst hβ_snd p₀ p₁ hp₀ hp₁ h_inv₀ w
      obtain ⟨p_c, hp_c⟩ := hPull_ex β₁.hom (ℓ ^ r) 2
      have hp_ρ' : WeilIsTorsionEtalePullback
          (CategoryTheory.CategoryStruct.comp β₁.hom
            (CategoryTheory.Limits.pullback.snd
              (weilPolyP1Over k δ).hom (weilProjectiveSpaceOver k 1).hom))
          (ℓ ^ r) 2 (p_ρ_std δ r) := by
        rw [hβ_snd]
        exact hp_ρ_std δ r
      have hcomp_c : p_ρ_std δ r = p_c.comp (p_ρ_std δ r) :=
        hPull_comp β₁.hom _ (ℓ ^ r) 2 p_c (p_ρ_std δ r) (p_ρ_std δ r)
          hp_c (hp_ρ_std δ r) hp_ρ'
      have hc_inv : p_c (p_ρ_std δ r (η r)) = p_ρ_std δ r (η r) := by
        calc
          p_c (p_ρ_std δ r (η r)) = (p_c.comp (p_ρ_std δ r)) (η r) := rfl
          _ = p_ρ_std δ r (η r) := by rw [← hcomp_c]
      have hEq_step : step_fn δ r (p₁ w) = p₀ (step_fn δ r w) := by
        rw [hstep_eq]
        exact hIso_E δ r (weilPolyP1Over k (δ + 1)).left
          (CategoryTheory.Limits.pullback.fst
            (weilPolyP1Over k δ).hom (weilProjectiveSpaceOver k 1).hom)
          β₀ β₁ hβ_fst (p_ρ_std δ r (η r)) p_c p₀ p₁ (γ_rel δ r) (Tr_rel δ r)
          (hTor_std δ r) (hz_std δ r) hp_c hc_inv hp₀ hp₁
          (hInv_rel δ r).1 (hInv_rel δ r).2 (hTerm_rel δ r) w
      rw [htrS δ r, AddMonoidHom.comp_apply, AddMonoidHom.comp_apply, hEq_step, h_inv₀]
    · intro δ r
      refine ⟨E_edge δ r, hNat_E δ r r, hPush_E δ r, hTor_std δ r, hz_std δ r, fun w => ?_⟩
      rw [htrS δ r, AddMonoidHom.comp_apply, hstep_eq]
      rfl

theorem weil_top_deg_lagrange_locConst_mu_orientation (k : Type u) [Field k]
    (n : ℕ) (hn : 2 ≤ n)
    (ζ : kˣ) (hζ : IsPrimitiveRoot ((ζ : kˣ) : k) n)
    (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (T : Y.left.Etale) (hT : CategoryTheory.Limits.IsTerminal T) :
    let Fgt := AlgebraicGeometry.Scheme.Etale.forget Y.left
    let J := Y.left.smallEtaleTopology
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod n))
    let C := CategoryTheory.constantSheaf J AddCommGrpCat.{u}
    let adj := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT
    let kMap : ∀ U : Y.left.Etale,
        k →+* ↑(((Fgt.obj U).left).presheaf.obj (Opposite.op ⊤)) :=
      fun U => CommRingCat.Hom.hom
        (CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
          (AlgebraicGeometry.Scheme.Hom.appTop
            (CategoryTheory.CategoryStruct.comp (Fgt.obj U).hom Y.hom)))
    ∃ ι : ∀ U : Y.left.Etale,
        ↑((C.obj AM).obj.obj (Opposite.op U)) →
          ↑(((Fgt.obj U).left).presheaf.obj (Opposite.op ⊤)),
      (∀ U : Y.left.Etale, Function.Injective (ι U)) ∧
      (∀ (U : Y.left.Etale)
          (v : ↑(((Fgt.obj U).left).presheaf.obj (Opposite.op ⊤))),
        v ^ n = 1 →
        ∃ s : ↑((C.obj AM).obj.obj (Opposite.op U)), ι U s = v) ∧
      (∀ U : Y.left.Etale,
        ι U 0 = 1 ∧
        ∀ s₁ s₂ : ↑((C.obj AM).obj.obj (Opposite.op U)),
          ι U (s₁ + s₂) = ι U s₁ * ι U s₂ ∧ (ι U s₁) ^ n = 1) ∧
      (∀ {U' U : Y.left.Etale} (u : Quiver.Hom U' U)
          (s : ↑((C.obj AM).obj.obj (Opposite.op U))),
        ι U' (((C.obj AM).obj.map (Opposite.op u)) s) =
          (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop (Fgt.map u).left))
            (ι U s)) ∧
      (∀ a : ZMod n,
        ι T ((adj.unit.app AM) (ULift.up a)) = (kMap T ((ζ : kˣ) : k)) ^ a.val) ∧
      (∀ (T' : Y.left.Etale) (hT' : CategoryTheory.Limits.IsTerminal T')
          (ι' : ∀ U : Y.left.Etale,
            ↑((C.obj AM).obj.obj (Opposite.op U)) →
              ↑(((Fgt.obj U).left).presheaf.obj (Opposite.op ⊤))),
        (∀ {U' U : Y.left.Etale} (u : Quiver.Hom U' U)
            (s : ↑((C.obj AM).obj.obj (Opposite.op U))),
          ι' U' (((C.obj AM).obj.map (Opposite.op u)) s) =
            (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop (Fgt.map u).left))
              (ι' U s)) →
        (∀ a : ZMod n,
          ι' T' (((CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT').unit.app AM)
            (ULift.up a)) = (kMap T' ((ζ : kˣ) : k)) ^ a.val) →
        ι' = ι) :=
by
  have _ : NeZero n := ⟨by omega⟩
  intro Fgt J AM C adj kMap
  have hPart1 :
      let ν : ZMod n → k := fun a => ((ζ : kˣ) : k) ^ a.val
      Function.Injective ν ∧
      ν 0 = 1 ∧
      (∀ a b : ZMod n, ν (a + b) = ν a * ν b) ∧
      (∀ a : ZMod n, (ν a) ^ n = 1) ∧
      (∀ (R : Type u) [CommRing R] (φ : k →+* R) (v : R),
        v ^ n = 1 →
        ∃ e : ZMod n → R,
          (Finset.univ : Finset (ZMod n)).sum e = 1 ∧
          (∀ a b : ZMod n, a ≠ b → e a * e b = 0) ∧
          (∀ a : ZMod n, v * e a = φ (ν a) * e a)) := by
    clear Y T hT Fgt J AM C adj kMap
    intro ν
    set z : k := ((ζ : kˣ) : k)
    have hz_pow : z ^ n = 1 := hζ.pow_eq_one
    have hν_inj : Function.Injective ν := by
      intro a b hab
      exact ZMod.val_injective n (hζ.pow_inj (ZMod.val_lt a) (ZMod.val_lt b) hab)
    have hν_0 : ν 0 = 1 := by
      simp [ν, ZMod.val_zero]
    have hν_add : ∀ a b : ZMod n, ν (a + b) = ν a * ν b := by
      intro a b
      calc
        ν (a + b) = z ^ ((a.val + b.val) % n) := by
          dsimp [ν]
          rw [ZMod.val_add]
        _ = (z ^ n) ^ ((a.val + b.val) / n) * z ^ ((a.val + b.val) % n) := by
          rw [hz_pow, one_pow, one_mul]
        _ = z ^ (n * ((a.val + b.val) / n) + (a.val + b.val) % n) := by
          rw [pow_add, pow_mul]
        _ = z ^ (a.val + b.val) := by
          rw [Nat.div_add_mod]
        _ = ν a * ν b := pow_add z a.val b.val
    have hν_pow : ∀ a : ZMod n, (ν a) ^ n = 1 := by
      intro a
      dsimp [ν]
      rw [← pow_mul, mul_comm, pow_mul, hz_pow, one_pow]
    refine ⟨hν_inj, hν_0, hν_add, hν_pow, ?_⟩
    let P : Polynomial k :=
      (Finset.univ : Finset (ZMod n)).prod (fun b => Polynomial.X - Polynomial.C (ν b))
    have hcop : Set.Pairwise (↑(Finset.univ : Finset (ZMod n)))
        (fun a b => IsCoprime (Polynomial.X - Polynomial.C (ν a))
          (Polynomial.X - Polynomial.C (ν b))) :=
      fun _ _ _ _ hab => Polynomial.pairwise_coprime_X_sub_C hν_inj hab
    have hP_dvd_of_eval : ∀ F : Polynomial k,
        (∀ m : ZMod n, Polynomial.eval (ν m) F = 0) → P ∣ F := by
      intro F hF
      apply Finset.prod_dvd_of_coprime hcop
      intro m _
      exact Polynomial.dvd_iff_isRoot.mpr (hF m)
    have hP_dvd_Q : P ∣ (Polynomial.X ^ n - 1 : Polynomial k) := by
      apply hP_dvd_of_eval
      intro m
      simp [hν_pow m]
    have hP_monic : P.Monic :=
      Polynomial.monic_prod_of_monic _ _ (fun b _ => Polynomial.monic_X_sub_C (ν b))
    have hP_deg : P.natDegree = n := by
      rw [Polynomial.natDegree_prod_of_monic _ _ (fun b _ => Polynomial.monic_X_sub_C (ν b))]
      simp [ZMod.card]
    have hQ_monic : (Polynomial.X ^ n - (1 : Polynomial k)).Monic := by
      rw [← map_one Polynomial.C]
      exact Polynomial.monic_X_pow_sub_C (1 : k) (by omega)
    have hQ_deg : (Polynomial.X ^ n - (1 : Polynomial k)).natDegree = n := by
      rw [← map_one Polynomial.C]
      exact Polynomial.natDegree_X_pow_sub_C
    have hP_eq : P = Polynomial.X ^ n - 1 := by
      obtain ⟨C_quot, hC_quot⟩ := hP_dvd_Q
      have hC_ne : C_quot ≠ 0 := by
        rintro rfl
        rw [mul_zero] at hC_quot
        exact hQ_monic.ne_zero hC_quot
      have hdeg_sum : n = n + C_quot.natDegree := by
        have h1 := congrArg Polynomial.natDegree hC_quot
        rwa [hQ_deg, Polynomial.natDegree_mul hP_monic.ne_zero hC_ne, hP_deg] at h1
      have hC_deg0 : C_quot.natDegree = 0 := by omega
      have hC_const : C_quot = Polynomial.C (C_quot.coeff 0) :=
        Polynomial.eq_C_of_natDegree_eq_zero hC_deg0
      have hc0 : C_quot.coeff 0 = 1 := by
        have hlc := congrArg Polynomial.leadingCoeff hC_quot
        rw [hQ_monic.leadingCoeff, hC_const, Polynomial.leadingCoeff_mul,
          hP_monic.leadingCoeff, one_mul, Polynomial.leadingCoeff_C] at hlc
        exact hlc.symm
      rw [hC_quot, hC_const, hc0, map_one, mul_one]
    let L : ZMod n → Polynomial k := fun a => Lagrange.basis Finset.univ ν a
    have hL_sum : (Finset.univ : Finset (ZMod n)).sum L = 1 :=
      Lagrange.sum_basis hν_inj.injOn Finset.univ_nonempty
    have hL_orth : ∀ a b : ZMod n, a ≠ b → (Polynomial.X ^ n - 1) ∣ L a * L b := by
      intro a b hab
      rw [← hP_eq]
      apply hP_dvd_of_eval
      intro m
      rw [Polynomial.eval_mul]
      by_cases hma : m = a
      · subst hma
        rw [Lagrange.eval_basis_of_ne hab.symm (Finset.mem_univ m), mul_zero]
      · rw [Lagrange.eval_basis_of_ne (Ne.symm hma) (Finset.mem_univ m), zero_mul]
    have hL_eigen : ∀ a : ZMod n,
        (Polynomial.X ^ n - 1) ∣ (Polynomial.X - Polynomial.C (ν a)) * L a := by
      intro a
      rw [← hP_eq]
      apply hP_dvd_of_eval
      intro m
      rw [Polynomial.eval_mul, Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C]
      by_cases hma : m = a
      · subst hma
        rw [sub_self, zero_mul]
      · rw [Lagrange.eval_basis_of_ne (Ne.symm hma) (Finset.mem_univ m), mul_zero]
    intro R _ φ v hv
    let ψ : Polynomial k →+* R := Polynomial.eval₂RingHom φ v
    have hψ_kill : ∀ F : Polynomial k, (Polynomial.X ^ n - 1) ∣ F → ψ F = 0 := by
      rintro F ⟨G, rfl⟩
      simp [ψ, hv]
    refine ⟨fun a => ψ (L a), ?_, ?_, ?_⟩
    · rw [← map_sum ψ, hL_sum, map_one]
    · intro a b hab
      rw [← map_mul]
      exact hψ_kill _ (hL_orth a b hab)
    · intro a
      have h0 := hψ_kill _ (hL_eigen a)
      rw [map_mul, map_sub] at h0
      have hX : ψ Polynomial.X = v := Polynomial.eval₂_X φ v
      have hC : ψ (Polynomial.C (ν a)) = φ (ν a) := Polynomial.eval₂_C φ v
      rw [hX, hC, sub_mul] at h0
      exact sub_eq_zero.mp h0
  obtain ⟨hν_inj, hν_0, hν_add, hν_pow, hIdemp⟩ := hPart1
  have hPart2 :
      ∀ (ν : ZMod n → k),
        Function.Injective ν →
        ν 0 = 1 →
        (∀ a b : ZMod n, ν (a + b) = ν a * ν b) →
        (∀ a : ZMod n, (ν a) ^ n = 1) →
        (∀ (R : Type u) [CommRing R] (φ : k →+* R) (v : R),
          v ^ n = 1 →
          ∃ e : ZMod n → R,
            (Finset.univ : Finset (ZMod n)).sum e = 1 ∧
            (∀ a b : ZMod n, a ≠ b → e a * e b = 0) ∧
            (∀ a : ZMod n, v * e a = φ (ν a) * e a)) →
        (∃ Ψ : ∀ (X : AlgebraicGeometry.Scheme.{u})
            (_ : k →+* ↑(X.presheaf.obj (Opposite.op ⊤))),
            LocallyConstant ↥X (ZMod n) → ↑(X.presheaf.obj (Opposite.op ⊤)),
          (∀ (X : AlgebraicGeometry.Scheme.{u}) (κ : k →+* ↑(X.presheaf.obj (Opposite.op ⊤))),
            Function.Injective (Ψ X κ)) ∧
          (∀ (X : AlgebraicGeometry.Scheme.{u}) (κ : k →+* ↑(X.presheaf.obj (Opposite.op ⊤)))
              (v : ↑(X.presheaf.obj (Opposite.op ⊤))),
            v ^ n = 1 → ∃ g : LocallyConstant ↥X (ZMod n), Ψ X κ g = v) ∧
          (∀ (X : AlgebraicGeometry.Scheme.{u}) (κ : k →+* ↑(X.presheaf.obj (Opposite.op ⊤))),
            Ψ X κ 0 = 1 ∧
            ∀ g₁ g₂ : LocallyConstant ↥X (ZMod n),
              Ψ X κ (g₁ + g₂) = Ψ X κ g₁ * Ψ X κ g₂ ∧ (Ψ X κ g₁) ^ n = 1) ∧
          (∀ {X' X : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X' X)
              (κ' : k →+* ↑(X'.presheaf.obj (Opposite.op ⊤)))
              (κ : k →+* ↑(X.presheaf.obj (Opposite.op ⊤))),
            (∀ c : k, (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop f)) (κ c) = κ' c) →
            ∀ (g : LocallyConstant ↥X (ZMod n)) (g' : LocallyConstant ↥X' (ZMod n)),
              (∀ x : ↥X', g' x = g (f.base x)) →
              Ψ X' κ' g' = (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop f)) (Ψ X κ g)) ∧
          (∀ (X : AlgebraicGeometry.Scheme.{u}) (κ : k →+* ↑(X.presheaf.obj (Opposite.op ⊤)))
              (a : ZMod n),
            Ψ X κ (LocallyConstant.const ↥X a) = κ (ν a))) ∧
        (∀ (X : AlgebraicGeometry.Scheme.{u})
            (r₁ r₂ : ↑(X.presheaf.obj (Opposite.op ⊤))),
          (∀ x : ↥X, ∃ (W : AlgebraicGeometry.Scheme.{u}) (f : Quiver.Hom W X) (y : ↥W),
            AlgebraicGeometry.IsOpenImmersion f ∧ f.base y = x ∧
            (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop f)) r₁ =
              (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop f)) r₂) →
          r₁ = r₂) := by
    clear hn ζ hζ Y T hT Fgt J AM C adj kMap hν_inj hν_0 hν_add hν_pow hIdemp
    intro ν hInj h0 hAdd hPow hIdemp
    have hSecExt : ∀ (X : AlgebraicGeometry.Scheme.{u})
        (r₁ r₂ : ↑(X.presheaf.obj (Opposite.op ⊤))),
        (∀ x : ↥X, (X.presheaf.Γgerm x).hom r₁ = (X.presheaf.Γgerm x).hom r₂) → r₁ = r₂ := by
      intro X r₁ r₂ h
      exact TopCat.Presheaf.section_ext X.sheaf ⊤ r₁ r₂ (fun x _ => h x)
    have hAppTopGerm : ∀ {X' X : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X' X)
        (y : ↥X') (r : ↑(X.presheaf.obj (Opposite.op ⊤))),
        (X'.presheaf.Γgerm y).hom ((AlgebraicGeometry.Scheme.Hom.appTop f).hom r) =
          (AlgebraicGeometry.Scheme.Hom.stalkMap f y).hom
            ((X.presheaf.Γgerm (f.base y)).hom r) := by
      intro X' X f y r
      exact (AlgebraicGeometry.Scheme.Hom.germ_stalkMap_apply f ⊤ y trivial r).symm
    have hGlueEx : ∀ (X : AlgebraicGeometry.Scheme.{u})
        (κ : k →+* ↑(X.presheaf.obj (Opposite.op ⊤)))
        (g : LocallyConstant ↥X (ZMod n)),
        ∃ s : ↑(X.presheaf.obj (Opposite.op ⊤)),
          ∀ x : ↥X, (X.presheaf.Γgerm x).hom s = (X.presheaf.Γgerm x).hom (κ (ν (g x))) := by
      intro X κ g
      let O_g : ZMod n → X.Opens := fun a => ⟨g ⁻¹' {a}, g.isLocallyConstant {a}⟩
      let sf : ∀ a : ZMod n, ↑(X.presheaf.obj (Opposite.op (O_g a))) :=
        fun a => (X.presheaf.map (CategoryTheory.homOfLE (le_top : O_g a ≤ ⊤)).op).hom (κ (ν a))
      have hcov : (⊤ : X.Opens) ≤ ⨆ a : ZMod n, O_g a := by
        intro x _
        rw [TopologicalSpace.Opens.mem_iSup]
        exact ⟨g x, rfl⟩
      obtain ⟨s, hs, _⟩ := X.sheaf.existsUnique_gluing' O_g ⊤
        (fun a => CategoryTheory.homOfLE (le_top : O_g a ≤ ⊤)) hcov sf (by
          intro a b
          by_cases hab : a = b
          · subst hab; rfl
          · have hbot : O_g a ⊓ O_g b = ⊥ := by
              ext x
              simp only [TopologicalSpace.Opens.coe_inf, TopologicalSpace.Opens.coe_bot,
                Set.mem_inter_iff, Set.mem_empty_iff_false, iff_false, not_and]
              intro ha hb
              exact hab (ha.symm.trans hb)
            have hSub : Subsingleton ↑(X.presheaf.obj (Opposite.op (O_g a ⊓ O_g b))) := by
              rw [hbot]
              infer_instance
            exact @Subsingleton.elim _ hSub _ _)
      refine ⟨s, fun x => ?_⟩
      have hx : x ∈ O_g (g x) := rfl
      have hres := congrArg ((X.presheaf.germ (O_g (g x)) x hx).hom) (hs (g x))
      have hcomp : X.presheaf.map (CategoryTheory.homOfLE (le_top : O_g (g x) ≤ ⊤)).op ≫
          X.presheaf.germ (O_g (g x)) x hx = X.presheaf.Γgerm x :=
        TopCat.Presheaf.germ_res X.presheaf (CategoryTheory.homOfLE (le_top : O_g (g x) ≤ ⊤)) x hx
      have hL : (X.presheaf.germ (O_g (g x)) x hx).hom
          ((X.presheaf.map (CategoryTheory.homOfLE (le_top : O_g (g x) ≤ ⊤)).op).hom s) =
          (X.presheaf.Γgerm x).hom s :=
        congrArg (fun ψ => ψ.hom s) hcomp
      have hR : (X.presheaf.germ (O_g (g x)) x hx).hom (sf (g x)) =
          (X.presheaf.Γgerm x).hom (κ (ν (g x))) :=
        congrArg (fun ψ => ψ.hom (κ (ν (g x)))) hcomp
      exact hL.symm.trans (hres.trans hR)
    let Ψ : ∀ (X : AlgebraicGeometry.Scheme.{u})
        (_ : k →+* ↑(X.presheaf.obj (Opposite.op ⊤))),
        LocallyConstant ↥X (ZMod n) → ↑(X.presheaf.obj (Opposite.op ⊤)) :=
      fun X κ g => Classical.choose (hGlueEx X κ g)
    have hΨ_germ : ∀ (X : AlgebraicGeometry.Scheme.{u})
        (κ : k →+* ↑(X.presheaf.obj (Opposite.op ⊤)))
        (g : LocallyConstant ↥X (ZMod n)) (x : ↥X),
        (X.presheaf.Γgerm x).hom (Ψ X κ g) = (X.presheaf.Γgerm x).hom (κ (ν (g x))) :=
      fun X κ g => Classical.choose_spec (hGlueEx X κ g)
    refine ⟨⟨Ψ, ?_, ?_, ?_, ?_, ?_⟩, ?_⟩
    · intro X κ g₁ g₂ heq
      ext x
      let γx : k →+* ↑(X.presheaf.stalk x) := (X.presheaf.Γgerm x).hom.comp κ
      have hγ_inj : Function.Injective γx := RingHom.injective γx
      apply hInj
      apply hγ_inj
      change (X.presheaf.Γgerm x).hom (κ (ν (g₁ x))) = (X.presheaf.Γgerm x).hom (κ (ν (g₂ x)))
      rw [← hΨ_germ X κ g₁ x, ← hΨ_germ X κ g₂ x, heq]
    · intro X κ v hv
      obtain ⟨e, hsum, horth, heigen⟩ :=
        hIdemp ↑(X.presheaf.obj (Opposite.op ⊤)) κ v hv
      have hExUnit : ∀ x : ↥X, ∃ a : ZMod n, IsUnit ((X.presheaf.Γgerm x).hom (e a)) := by
        intro x
        by_contra hall
        have hmem_all : ∀ a : ZMod n,
            (X.presheaf.Γgerm x).hom (e a) ∈
              IsLocalRing.maximalIdeal ↑(X.presheaf.stalk x) := by
          intro a
          by_contra hnot
          exact hall ⟨a, IsLocalRing.notMem_maximalIdeal.mp hnot⟩
