    let P_A_X := (CategoryTheory.Functor.const (X.Etale)ᵒᵖ).obj A
    let P_A_S := (CategoryTheory.Functor.const (S.Etale)ᵒᵖ).obj A
    let F_AX : CategoryTheory.Sheaf J_X AddCommGrpCat.{u} :=
      (CategoryTheory.presheafToSheaf J_X AddCommGrpCat.{u}).obj P_A_X
    let ν_X := shAdj_X.unit.app P_A_X
    let ν_S := shAdj_S.unit.app P_A_S
    let σ_A : C_X.obj A ⟶ R_w.obj (C_S.obj A) :=
