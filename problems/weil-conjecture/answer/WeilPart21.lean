      exact ⟨PrimeSpectrum.comap (Pi.evalRingHom B i₀) q₀, (PrimeSpectrum.ext rfl).trans hq₀⟩
    have : Module.FaithfullyFlat A P_prod := Module.FaithfullyFlat.of_comap_surjective hComapSurj
    have hSumSingle : ∀ v : P_prod, (∑ i : ι, LinearMap.single A B i (v i)) = v := by
      intro v
      ext j
      simp [LinearMap.single_apply]
    have hModInj : ∀ (M : Type u) [AddCommGroup M] [Module A M] (m₁ m₂ : M),
        (∀ i : ι, (1 : B i) ⊗ₜ[A] m₁ = (1 : B i) ⊗ₜ[A] m₂) → m₁ = m₂ := by
      intro M _ _ m₁ m₂ hm
      apply Module.FaithfullyFlat.tensorProduct_mk_injective (A := A) (B := P_prod) M
      change (1 : P_prod) ⊗ₜ[A] m₁ = (1 : P_prod) ⊗ₜ[A] m₂
      rw [← hSumSingle (1 : P_prod), TensorProduct.sum_tmul, TensorProduct.sum_tmul]
      refine Finset.sum_congr rfl fun i _ => ?_
      change (LinearMap.single A B i (1 : B i)) ⊗ₜ[A] m₁ =
        (LinearMap.single A B i (1 : B i)) ⊗ₜ[A] m₂
      simpa only [LinearMap.rTensor_tmul] using
        congrArg (LinearMap.rTensor M (LinearMap.single A B i)) (hm i)
    have hElemDesc : ∀ b : P_prod,
        (∀ i j : ι, (b i) ⊗ₜ[A] (1 : B j) = (1 : B i) ⊗ₜ[A] (b j)) →
        ∃ a : A, ∀ i : ι, algebraMap A (B i) a = b i := by
      intro b hb
      have hbP : b ⊗ₜ[A] (1 : P_prod) = (1 : P_prod) ⊗ₜ[A] b := by
        conv_lhs => rw [← hSumSingle b, ← hSumSingle (1 : P_prod)]
        conv_rhs => rw [← hSumSingle (1 : P_prod), ← hSumSingle b]
        rw [TensorProduct.sum_tmul, TensorProduct.sum_tmul]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [TensorProduct.tmul_sum, TensorProduct.tmul_sum]
        refine Finset.sum_congr rfl fun j _ => ?_
        change (LinearMap.single A B i (b i)) ⊗ₜ[A] (LinearMap.single A B j (1 : B j)) =
          (LinearMap.single A B i (1 : B i)) ⊗ₜ[A] (LinearMap.single A B j (b j))
        simpa only [TensorProduct.map_tmul] using
          congrArg (TensorProduct.map (LinearMap.single A B i) (LinearMap.single A B j)) (hb i j)
      let I_sub : Submodule A P_prod := LinearMap.range (Algebra.linearMap A P_prod)
      let Q : Type u := P_prod ⧸ I_sub
      let π_Q : P_prod →ₗ[A] Q := I_sub.mkQ
      have hπ1 : π_Q (1 : P_prod) = 0 := by
        rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
        exact ⟨1, (Algebra.linearMap_apply A P_prod 1).trans (map_one (algebraMap A P_prod))⟩
      have hTensorQ : (1 : P_prod) ⊗ₜ[A] (π_Q b) = (1 : P_prod) ⊗ₜ[A] (0 : Q) := by
        have h1 := congrArg (LinearMap.lTensor P_prod π_Q) hbP.symm
        simpa [LinearMap.lTensor_tmul, hπ1] using h1
      have hπb : π_Q b = 0 :=
        Module.FaithfullyFlat.tensorProduct_mk_injective (A := A) (B := P_prod) Q hTensorQ
      rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] at hπb
      obtain ⟨a, ha⟩ := hπb
      exact ⟨a, fun i => congr_fun ha i⟩
    refine ⟨hModInj, fun u hu => ?_⟩
    have hu_inv : ∀ i j : ι,
        (((u i)⁻¹ : (B i)ˣ) : B i) ⊗ₜ[A] (1 : B j) =
          (1 : B i) ⊗ₜ[A] (((u j)⁻¹ : (B j)ˣ) : B j) := by
      intro i j
      let inl : B i →+* TensorProduct A (B i) (B j) := Algebra.TensorProduct.includeLeftRingHom
      let inr : B j →+* TensorProduct A (B i) (B j) :=
        (Algebra.TensorProduct.includeRight : B j →ₐ[A] TensorProduct A (B i) (B j)).toRingHom
      have hUnitsEq : Units.map inl.toMonoidHom (u i) = Units.map inr.toMonoidHom (u j) :=
        Units.ext (hu i j)
      have hInvEq : (Units.map inl.toMonoidHom (u i))⁻¹ = (Units.map inr.toMonoidHom (u j))⁻¹ :=
        congrArg Inv.inv hUnitsEq
      rw [← map_inv, ← map_inv] at hInvEq
      exact congrArg Units.val hInvEq
    obtain ⟨a, ha⟩ := hElemDesc (fun i => (u i : B i)) hu
    obtain ⟨a_inv, ha_inv⟩ := hElemDesc (fun i => (((u i)⁻¹ : (B i)ˣ) : B i)) hu_inv
    have h_mul : a * a_inv = 1 := by
      refine hModInj A (a * a_inv) 1 (fun i => ?_)
      have hsmul1 : (1 : B i) ⊗ₜ[A] (a * a_inv) = ((a * a_inv) • (1 : B i)) ⊗ₜ[A] (1 : A) := by
        simpa using (TensorProduct.smul_tmul (a * a_inv) (1 : B i) (1 : A)).symm
      rw [hsmul1, Algebra.smul_def, mul_one, map_mul, ha i, ha_inv i, Units.mul_inv]
    refine ⟨⟨a, a_inv, h_mul, mul_comm a_inv a ▸ h_mul⟩, fun i => Units.ext (ha i)⟩

  
