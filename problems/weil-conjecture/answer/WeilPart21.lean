    have hPath1 := hCompCoh g_Y f (pf_f.obj G) G (pb_Y.obj G)
      (𝟙 (pf_f.obj G)) (adj_Y.unit.app G) α₁ rfl q z
    have hPath2 := hCompCoh f g_S (pf_f.obj G) (pb_S.obj (pf_f.obj G)) (pb_Y.obj G)
      (adj_S.unit.app (pf_f.obj G)) (bc₀ G) α₂ rfl q z
    have hα_rel : α₂ = α₁ ≫ e_pf_c.hom.app (pb_Y.obj G) := by
      have h_bc_unit : adj_S.unit.app (pf_f.obj G) ≫ pf_S.map (bc₀ G) =
