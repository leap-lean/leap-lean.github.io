      calc
        ιℤ = ιℤ ≫ 𝟙 (pb_h.obj Fℤ₂) := (CategoryTheory.Category.comp_id _).symm
        _ = ιℤ ≫ (πℤ_0 ≫ ιℤ_0) := by rw [CategoryTheory.IsIso.hom_inv_id πℤ_0]
