          have he0 : e_free (W_M M₂ hFD₂) 𝒢 0 = 0 := by
            have hadj0 :
                adj_sh.homEquiv
                  (CategoryTheory.Functor.comp
                    (CategoryTheory.yoneda.obj (W_M M₂ hFD₂)) AddCommGrpCat.free)
                  𝒢 0 = 0 := by
              dsimp [CategoryTheory.Adjunction.homEquiv]
              simp
            exact congrArg (pshEquiv (W_M M₂ hFD₂) 𝒢.obj) hadj0
          rw [hhom0, he0]
          obtain ⟨ψ, hψ⟩ := CategoryTheory.Abelian.Ext.homEquiv₀.symm.surjective x
          rw [← hψ, CategoryTheory.Abelian.Ext.homEquiv₀_symm_apply,
            CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
            ← CategoryTheory.Abelian.Ext.homEquiv₀_symm_apply,
            Equiv.apply_symm_apply, he_free_map_left]
          rw [← hψ, Equiv.apply_symm_apply] at hkill
          exact hkill
      | succ q ih =>
        intro 𝒢
        let ℐ_K : CategoryTheory.Sheaf J_K AddCommGrpCat.{u} := CategoryTheory.Injective.under 𝒢
        let ι : 𝒢 ⟶ ℐ_K := CategoryTheory.Injective.ι 𝒢
        let 𝒬 : CategoryTheory.Sheaf J_K AddCommGrpCat.{u} := CategoryTheory.Limits.cokernel ι
        let π : ℐ_K ⟶ 𝒬 := CategoryTheory.Limits.cokernel.π ι
        let S := CategoryTheory.ShortComplex.mk ι π (CategoryTheory.Limits.cokernel.condition ι)
        have hExact : S.Exact :=
          CategoryTheory.ShortComplex.exact_of_g_is_cokernel S
            (CategoryTheory.Limits.cokernelIsCokernel ι)
        have hS : S.ShortExact :=
          CategoryTheory.ShortComplex.ShortExact.mk' hExact inferInstance inferInstance
        let hS_L : (S.map P_inf).ShortExact := hS.map_of_exact P_inf
        refine ⟨?_, ?_⟩
        · intro w
          have hw_zero : w.comp (CategoryTheory.Abelian.Ext.mk₀ (S.map P_inf).f)
              (Nat.add_zero (q + 1)) = 0 :=
            @Subsingleton.elim ((P_inf.obj ℐ_K).H (q + 1))
              (hInjAcyclic ℐ_K (q + 1) (Nat.le_add_left 1 q)) _ 0
          obtain ⟨y_L, hy_L⟩ :=
            CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ ℤ_L hS_L w hw_zero rfl
          obtain ⟨M, hFD, y_M, hy_M⟩ := (ih 𝒬).1 y_L
          refine ⟨M, hFD, y_M.comp hS.extClass rfl, ?_⟩
          rw [hθ_extClass q hS M hFD y_M, hy_M]
          exact hy_L
        · intro M₁ hFD₁ x₁ hx₁
          have hx₁_ι : x₁.comp (CategoryTheory.Abelian.Ext.mk₀ S.f) (Nat.add_zero (q + 1)) = 0 :=
            CategoryTheory.Abelian.Ext.eq_zero_of_injective _
          obtain ⟨y₁, hy₁⟩ :=
            CategoryTheory.Abelian.Ext.covariant_sequence_exact₁
              (F_free.obj (W_M M₁ hFD₁)) hS x₁ hx₁_ι rfl
          have hy₁_L : (θ q 𝒬 M₁ hFD₁ y₁).comp hS_L.extClass rfl = 0 := by
            rw [← hθ_extClass q hS M₁ hFD₁ y₁, hy₁]
            exact hx₁
          obtain ⟨z_L, hz_L⟩ :=
            CategoryTheory.Abelian.Ext.covariant_sequence_exact₃
              ℤ_L hS_L (θ q 𝒬 M₁ hFD₁ y₁) rfl hy₁_L
          obtain ⟨M_a, hFD_a, z_a, hz_a⟩ := (ih ℐ_K).1 z_L
          let M_b : IntermediateField F₀ L_inf := M₁ ⊔ M_a
          have hFD_b : FiniteDimensional F₀ ↥M_b :=
            IntermediateField.finiteDimensional_sup M₁ M_a
          have hle₁ : M₁ ≤ M_b := le_sup_left
          have hle_a : M_a ≤ M_b := le_sup_right
          let y_b := (CategoryTheory.Abelian.Ext.mk₀ (F_free.map (p_M hFD₁ hFD_b hle₁))).comp
            y₁ (Nat.zero_add q)
          let z_b := (CategoryTheory.Abelian.Ext.mk₀ (F_free.map (p_M hFD_a hFD_b hle_a))).comp
            z_a (Nat.zero_add q)
          have hdiff_zero : θ q 𝒬 M_b hFD_b
              (z_b.comp (CategoryTheory.Abelian.Ext.mk₀ S.g) (Nat.add_zero q) - y_b) = 0 := by
            rw [map_sub, hθ_nat q S.g M_b hFD_b z_b,
              hθ_compat q ℐ_K hFD_a hFD_b hle_a z_a,
              hθ_compat q 𝒬 hFD₁ hFD_b hle₁ y₁,
              hz_a]
            exact sub_eq_zero.mpr hz_L
          obtain ⟨M₂, hFD₂, hle_b2, hkill_diff⟩ := (ih 𝒬).2 M_b hFD_b _ hdiff_zero
          have hle₁₂ : M₁ ≤ M₂ := le_trans hle₁ hle_b2
          refine ⟨M₂, hFD₂, hle₁₂, ?_⟩
          rw [hp_M_comp hFD₁ hFD_b hFD₂ hle₁ hle_b2, F_free.map_comp,
            ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
            CategoryTheory.Abelian.Ext.comp_assoc _ _ _
              (Nat.zero_add 0) (Nat.zero_add (q + 1)) (Nat.zero_add (q + 1)),
            ← hy₁,
            ← CategoryTheory.Abelian.Ext.comp_assoc _ _ _
              (Nat.zero_add q) rfl (Nat.zero_add (q + 1))]
          change (CategoryTheory.Abelian.Ext.mk₀ (F_free.map (p_M hFD_b hFD₂ hle_b2))).comp
              (y_b.comp hS.extClass rfl) (Nat.zero_add (q + 1)) = 0
          rw [← CategoryTheory.Abelian.Ext.comp_assoc _ _ _
            (Nat.zero_add q) rfl (Nat.zero_add (q + 1))]
          have hy₂_eq :
              (CategoryTheory.Abelian.Ext.mk₀ (F_free.map (p_M hFD_b hFD₂ hle_b2))).comp
                y_b (Nat.zero_add q) =
              (CategoryTheory.Abelian.Ext.mk₀ (F_free.map (p_M hFD_b hFD₂ hle_b2))).comp
                (z_b.comp (CategoryTheory.Abelian.Ext.mk₀ S.g) (Nat.add_zero q))
                (Nat.zero_add q) := by
            have hsub : (F_free.map (p_M hFD_b hFD₂ hle_b2) |> CategoryTheory.Abelian.Ext.mk₀).precomp
                𝒬 (Nat.zero_add q)
                (z_b.comp (CategoryTheory.Abelian.Ext.mk₀ S.g) (Nat.add_zero q) - y_b) = 0 :=
              hkill_diff
            rw [map_sub, sub_eq_zero] at hsub
            exact hsub.symm
          rw [hy₂_eq,
            CategoryTheory.Abelian.Ext.comp_assoc _ _ _
              (Nat.zero_add q) rfl (Nat.zero_add (q + 1)),
            CategoryTheory.Abelian.Ext.comp_assoc _ _ _
              (Nat.add_zero q) (Nat.zero_add 1) rfl,
            hS.comp_extClass,
            CategoryTheory.Abelian.Ext.comp_zero,
            CategoryTheory.Abelian.Ext.comp_zero]
    let M_bot : IntermediateField F₀ L_inf := ⊥
    have hFD_bot : FiniteDimensional F₀ ↥M_bot := inferInstance
    let _ : Algebra K ↥M_bot := algKM M_bot
    have _ : IsScalarTower K F₀ ↥M_bot := IsScalarTower.of_algebraMap_eq' rfl
    have _ : Algebra.Etale K ↥M_bot := hEtM M_bot hFD_bot
    let ξ_bot : CategoryTheory.Abelian.Ext (F_free.obj (W_M M_bot hFD_bot)) G s :=
      (G.cohomologyPresheaf s).map
        (weilAltCdSpecEtaleMap K (IsScalarTower.toAlgHom K F₀ ↥M_bot)).op ξ
    have hθ_bot : θ s G M_bot hFD_bot ξ_bot = 0 := Subsingleton.elim _ 0
    obtain ⟨M, hFD, hle_bot, hkill_M⟩ := (hSurjInj s G).2 M_bot hFD_bot ξ_bot hθ_bot
    refine ⟨M, hFD, fun E _ _ _ _ _ ⟨ι_E⟩ => ?_⟩
    let _ : Algebra K ↥M := algKM M
    have _ : IsScalarTower K F₀ ↥M := IsScalarTower.of_algebraMap_eq' rfl
    have _ : Algebra.Etale K ↥M := hEtM M hFD
    let ι_K : ↥M →ₐ[K] E :=
      { ι_E.toRingHom with
        commutes' := fun k => by
          change ι_E (algebraMap F₀ ↥M (algebraMap K F₀ k)) = algebraMap K E k
          rw [ι_E.commutes, ← IsScalarTower.algebraMap_apply K F₀ E] }
    let ι_bot_M : ↥M_bot →ₐ[K] ↥M :=
      { (IntermediateField.inclusion hle_bot).toRingHom with commutes' := fun _ => rfl }
    have hAlgEq : (ι_K.comp ι_bot_M).comp (IsScalarTower.toAlgHom K F₀ ↥M_bot) =
        IsScalarTower.toAlgHom K F₀ E := by
      ext x
      change ι_E (algebraMap F₀ ↥M x) = algebraMap F₀ E x
      exact ι_E.commutes x
    have hKillM_coh :
        (G.cohomologyPresheaf s).map (weilAltCdSpecEtaleMap K ι_bot_M).op
          ((G.cohomologyPresheaf s).map
            (weilAltCdSpecEtaleMap K (IsScalarTower.toAlgHom K F₀ ↥M_bot)).op ξ) = 0 :=
      hkill_M
    rw [← hAlgEq, hMapComp (IsScalarTower.toAlgHom K F₀ ↥M_bot) (ι_K.comp ι_bot_M),
      hMapComp ι_bot_M ι_K]
    change ((G.cohomologyPresheaf s).map
      (CategoryTheory.CategoryStruct.comp
        (weilAltCdSpecEtaleMap K (IsScalarTower.toAlgHom K F₀ ↥M_bot)).op
        (CategoryTheory.CategoryStruct.comp
          (weilAltCdSpecEtaleMap K ι_bot_M).op
          (weilAltCdSpecEtaleMap K ι_K).op))) ξ = 0
    rw [(G.cohomologyPresheaf s).map_comp, (G.cohomologyPresheaf s).map_comp]
    change (G.cohomologyPresheaf s).map (weilAltCdSpecEtaleMap K ι_K).op
      ((G.cohomologyPresheaf s).map (weilAltCdSpecEtaleMap K ι_bot_M).op
        ((G.cohomologyPresheaf s).map
          (weilAltCdSpecEtaleMap K (IsScalarTower.toAlgHom K F₀ ↥M_bot)).op ξ)) = 0
    rw [hKillM_coh, map_zero]

theorem weil_alt_cd_generic_pushforward_stalk_support (k : Type u) [Field k] [IsAlgClosed k]
    (m ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (hFieldCd : ∀ (κ K : Type u) [Field κ] [IsSepClosed κ] [Field K] [Algebra κ K] (e s : ℕ),
      (ℓ : κ) ≠ 0 → Algebra.trdeg κ K ≤ (e : Cardinal.{u}) → e < s →
      ∀ (G₀ : CategoryTheory.Sheaf
        (AlgebraicGeometry.Spec (CommRingCat.of K)).smallEtaleTopology AddCommGrpCat.{u}),
        ℓ • CategoryTheory.CategoryStruct.id G₀ = 0 →
        Subsingleton (G₀.H s))
    (V : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsProper V.hom] [AlgebraicGeometry.IsIntegral V.left]
    (hDimV : topologicalKrullDim V.left = (m : WithBot ℕ∞)) :
    let η : ↥V.left := genericPoint ↥V.left
    let g : Quiver.Hom (AlgebraicGeometry.Spec (V.left.presheaf.stalk η)) V.left :=
      V.left.fromSpecStalk η
    ∀ (G : CategoryTheory.Sheaf
        (AlgebraicGeometry.Spec (V.left.presheaf.stalk η)).smallEtaleTopology AddCommGrpCat.{u}),
      ℓ • CategoryTheory.CategoryStruct.id G = 0 →
      (∀ n : ℕ, m < n → Subsingleton (G.H n)) ∧
      (∀ s : ℕ, 1 ≤ s →
        (m < s → ∀ x : ↥V.left,
          WeilAltCdStalkZeroAt V.left (weilAltCdHigherDirectImage g s G) x) ∧
        (∀ d : ℕ, d + s = m → ∀ x : ↥V.left,
          (d : WithBot ℕ∞) < topologicalKrullDim ↥(closure ({x} : Set ↥V.left)) →
          WeilAltCdStalkZeroAt V.left (weilAltCdHigherDirectImage g s G) x)) :=
by
  intro η g G hG
  let K : Type u := ↥(V.left.presheaf.stalk η)
  have hMapId : ∀ (A : Type u) [CommRing A] [Algebra K A] [Algebra.Etale K A],
      weilAltCdSpecEtaleMap K (AlgHom.id K A) =
        CategoryTheory.CategoryStruct.id (weilAltCdSpecEtaleObj K A) := by
    intro A _ _ _
    apply CategoryTheory.MorphismProperty.Comma.Hom.ext
    · change AlgebraicGeometry.Spec.map (CommRingCat.ofHom (AlgHom.id K A).toRingHom) =
        CategoryTheory.CategoryStruct.id _
      have hid : CommRingCat.ofHom (AlgHom.id K A).toRingHom =
          CategoryTheory.CategoryStruct.id (CommRingCat.of A) := rfl
      rw [hid, AlgebraicGeometry.Spec.map_id]
    · exact Subsingleton.elim _ _
  have hMapComp : ∀ {A₁ A₂ A₃ : Type u} [CommRing A₁] [CommRing A₂] [CommRing A₃]
      [Algebra K A₁] [Algebra K A₂] [Algebra K A₃]
      [Algebra.Etale K A₁] [Algebra.Etale K A₂] [Algebra.Etale K A₃]
      (f₁ : A₁ →ₐ[K] A₂) (f₂ : A₂ →ₐ[K] A₃),
      weilAltCdSpecEtaleMap K (f₂.comp f₁) =
        CategoryTheory.CategoryStruct.comp
          (weilAltCdSpecEtaleMap K f₂) (weilAltCdSpecEtaleMap K f₁) := by
    intro A₁ A₂ A₃ _ _ _ _ _ _ _ _ _ f₁ f₂
    apply CategoryTheory.MorphismProperty.Comma.Hom.ext
    · change AlgebraicGeometry.Spec.map (CommRingCat.ofHom (f₂.comp f₁).toRingHom) =
        CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₂.toRingHom))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₁.toRingHom))
      have hcomp : CommRingCat.ofHom (f₂.comp f₁).toRingHom =
          CategoryTheory.CategoryStruct.comp
            (CommRingCat.ofHom f₁.toRingHom) (CommRingCat.ofHom f₂.toRingHom) := rfl
      rw [hcomp, AlgebraicGeometry.Spec.map_comp]
    · exact Subsingleton.elim _ _
  obtain ⟨⟨i_k, hTr_k_K⟩, hLocalChart⟩ :=
    weil_alt_cd_noether_trdeg_and_artin_local_chart k m V hDimV
  obtain ⟨G_K, hTors_K, hSub_H, hLocStalk⟩ :=
    weil_alt_cd_higherDirectImage_affine_stalk_localization V.left G
  have hℓ_GK : ℓ • CategoryTheory.CategoryStruct.id G_K = 0 := hTors_K ℓ hG
  have hCohMapId : ∀ (s : ℕ) (A : Type u) [CommRing A] [Algebra K A] [Algebra.Etale K A]
      (z : ↥((G_K.cohomologyPresheaf s).obj (Opposite.op (weilAltCdSpecEtaleObj K A)))),
      (G_K.cohomologyPresheaf s).map (weilAltCdSpecEtaleMap K (AlgHom.id K A)).op z = z := by
    intro s A _ _ _ z
    rw [hMapId A]
    change ((G_K.cohomologyPresheaf s).map (CategoryTheory.CategoryStruct.id _)) z = z
    rw [(G_K.cohomologyPresheaf s).map_id]
    rfl
  have hCohMapComp : ∀ (s : ℕ) {A₁ A₂ A₃ : Type u} [CommRing A₁] [CommRing A₂] [CommRing A₃]
      [Algebra K A₁] [Algebra K A₂] [Algebra K A₃]
      [Algebra.Etale K A₁] [Algebra.Etale K A₂] [Algebra.Etale K A₃]
      (f₁ : A₁ →ₐ[K] A₂) (f₂ : A₂ →ₐ[K] A₃)
      (z : ↥((G_K.cohomologyPresheaf s).obj (Opposite.op (weilAltCdSpecEtaleObj K A₁)))),
      (G_K.cohomologyPresheaf s).map (weilAltCdSpecEtaleMap K (f₂.comp f₁)).op z =
        (G_K.cohomologyPresheaf s).map (weilAltCdSpecEtaleMap K f₂).op
          ((G_K.cohomologyPresheaf s).map (weilAltCdSpecEtaleMap K f₁).op z) := by
    intro s A₁ A₂ A₃ _ _ _ _ _ _ _ _ _ f₁ f₂ z
    rw [hMapComp f₁ f₂]
    change ((G_K.cohomologyPresheaf s).map
      (CategoryTheory.CategoryStruct.comp
        (weilAltCdSpecEtaleMap K f₁).op (weilAltCdSpecEtaleMap K f₂).op)) z = _
    rw [(G_K.cohomologyPresheaf s).map_comp]
    rfl
  have hCore : ∀ (s : ℕ) (x : ↥V.left),
      (∀ (c : ℕ),
        topologicalKrullDim ↥(closure ({x} : Set ↥V.left)) = (c : WithBot ℕ∞) →
        c ≤ m → m - c < s) →
      WeilAltCdStalkZeroAt V.left (weilAltCdHigherDirectImage g s G) x := by
    intro s x h_ineq
    obtain ⟨c, W₀, hW₀, hx, hη, ψ, i_K, hDimCx, hc_le_m, h_ev_x0, hi_K, hDimF0K⟩ :=
      hLocalChart x
    have h_mc_lt_s : m - c < s := h_ineq c hDimCx hc_le_m
    apply hLocStalk s x W₀ hW₀ hx hη
    let B : Type u := ↥(V.left.presheaf.obj (Opposite.op W₀))
    let Ω_x : Type u := AlgebraicClosure ↥(V.left.residueField x)
    let _ : Algebra B K := ((V.left.presheaf.germ W₀ η hη).hom).toAlgebra
    let ev_x : B →+* Ω_x :=
      (algebraMap ↥(V.left.residueField x) Ω_x).comp (V.left.evaluation W₀ x hx).hom
    have _ : Nonempty ↥(W₀ : AlgebraicGeometry.Scheme.{u}) := ⟨⟨x, hx⟩⟩
    have _ : IsDomain B := AlgebraicGeometry.IsIntegral.component_integral W₀
    have _ : IsFractionRing B K :=
      AlgebraicGeometry.functionField_isFractionRing_of_isAffineOpen V.left W₀ hW₀
    let P : Type u := MvPolynomial (Fin c) k
    have h_ev : ∀ h : P, h ≠ 0 → ev_x (ψ h) ≠ 0 := by
      intro h hh hzero
      apply h_ev_x0 h hh
      exact (RingHom.injective (algebraMap ↥(V.left.residueField x) Ω_x))
        (hzero.trans (map_zero _).symm)
    obtain ⟨hCofilteredProd, hCofilteredUnion⟩ :=
      weil_alt_cd_cofiltered_etale_field_union_vanishing K s ℓ G_K hℓ_GK
    intro C₀ _ _ _ u₀ hu₀
    let _ : Algebra.Etale K (TensorProduct B K C₀) := Algebra.Etale.baseChange B C₀ K
    intro ξ₀
    obtain ⟨κ_sep, hField_κ, hSepClosed_κ, hAlgP_κ, N, F_init, L_inf,
      hField_Finit, hField_Linf, hAlgK_Finit, hEtK_Finit,
      hAlg_Finit_Linf, hSep_Finit_Linf, hAlg_κ_Linf,
      C_init, hCR_Cinit, hAlgB_Cinit, hAlgC0_Cinit, hTower_BC0_Cinit, hEtC0_Cinit,
      u_init, e_init, hInj_P, hTr_L, hFinSep_init, hu_init, hCont⟩ :=
      weil_alt_cd_separable_splitting_and_standard_etale_chart
        P B K Ω_x (m - c) ψ ev_x h_ev i_K hi_K hDimF0K C₀ u₀ hu₀
    let _ : Field κ_sep := hField_κ
    let _ : IsSepClosed κ_sep := hSepClosed_κ
    let _ : Algebra P κ_sep := hAlgP_κ
    let _ : ∀ a, Field (F_init a) := hField_Finit
    let _ : ∀ a, Field (L_inf a) := hField_Linf
    let _ : ∀ a, Algebra K (F_init a) := hAlgK_Finit
    let _ : ∀ a, Algebra.Etale K (F_init a) := hEtK_Finit
    let _ : ∀ a, Algebra (F_init a) (L_inf a) := hAlg_Finit_Linf
    let _ : ∀ a, Algebra.IsSeparable (F_init a) (L_inf a) := hSep_Finit_Linf
    let _ : ∀ a, Algebra κ_sep (L_inf a) := hAlg_κ_Linf
    let _ : CommRing C_init := hCR_Cinit
    let _ : Algebra B C_init := hAlgB_Cinit
    let _ : Algebra C₀ C_init := hAlgC0_Cinit
    let _ : IsScalarTower B C₀ C_init := hTower_BC0_Cinit
    let _ : Algebra.Etale C₀ C_init := hEtC0_Cinit
    let _ : Algebra.Etale B C_init := Algebra.Etale.comp B C₀ C_init
    let _ : Algebra.Etale K (TensorProduct B K C_init) := Algebra.Etale.baseChange B C_init K
    let _ : Algebra.Etale K (∀ a : Fin N, F_init a) := Algebra.Etale.of_equiv e_init
    have hℓ_κ : (ℓ : κ_sep) ≠ 0 := by
      intro h0
      apply hℓ
      have hInj_k_κ : Function.Injective ((algebraMap P κ_sep).comp MvPolynomial.C) :=
        hInj_P.comp (MvPolynomial.C_injective (Fin c) k)
      apply hInj_k_κ
      rw [map_natCast, map_zero]
      exact h0
    let φ_0_init : TensorProduct B K C₀ →ₐ[K] TensorProduct B K C_init :=
      { (Algebra.TensorProduct.map (AlgHom.id B K)
          (IsScalarTower.toAlgHom B C₀ C_init)).toRingHom with
        commutes' := fun r => by simp [Algebra.TensorProduct.algebraMap_apply] }
    let ξ_init :=
      (G_K.cohomologyPresheaf s).map (weilAltCdSpecEtaleMap K φ_0_init).op ξ₀
    let η_init :=
      (G_K.cohomologyPresheaf s).map (weilAltCdSpecEtaleMap K e_init.toAlgHom).op ξ_init
    have hExM : ∀ a : Fin N, ∃ (M_a : IntermediateField (F_init a) (L_inf a)),
        FiniteDimensional (F_init a) ↥M_a ∧
        ∀ (E : Type u) [Field E] [Algebra K E] [Algebra (F_init a) E]
          [IsScalarTower K (F_init a) E] [Algebra.Etale K E],
          Nonempty (↥M_a →ₐ[F_init a] E) →
          (G_K.cohomologyPresheaf s).map
            (weilAltCdSpecEtaleMap K (IsScalarTower.toAlgHom K (F_init a) E)).op
            ((G_K.cohomologyPresheaf s).map
              (weilAltCdSpecEtaleMap K (Pi.evalAlgHom K F_init a)).op η_init) = 0 := by
      intro a
      have _ : FiniteDimensional K (F_init a) := (hFinSep_init a).1
      have _ : Algebra.IsSeparable K (F_init a) := (hFinSep_init a).2
      exact hCofilteredUnion (F_init a) (L_inf a)
        (fun G_inf hG_inf =>
          hFieldCd κ_sep (L_inf a) (m - c) s hℓ_κ (hTr_L a) h_mc_lt_s G_inf hG_inf)
        ((G_K.cohomologyPresheaf s).map
          (weilAltCdSpecEtaleMap K (Pi.evalAlgHom K F_init a)).op η_init)
    let M : ∀ a : Fin N, IntermediateField (F_init a) (L_inf a) :=
      fun a => Classical.choose (hExM a)
    have hFD_M : ∀ a : Fin N, FiniteDimensional (F_init a) ↥(M a) :=
      fun a => (Classical.choose_spec (hExM a)).1
    have hKill_M : ∀ (a : Fin N) (E : Type u) [Field E] [Algebra K E] [Algebra (F_init a) E]
        [IsScalarTower K (F_init a) E] [Algebra.Etale K E],
        Nonempty (↥(M a) →ₐ[F_init a] E) →
        (G_K.cohomologyPresheaf s).map
          (weilAltCdSpecEtaleMap K (IsScalarTower.toAlgHom K (F_init a) E)).op
          ((G_K.cohomologyPresheaf s).map
            (weilAltCdSpecEtaleMap K (Pi.evalAlgHom K F_init a)).op η_init) = 0 :=
      fun a => (Classical.choose_spec (hExM a)).2
    obtain ⟨C_fin, hCR_Cfin, hAlgB_Cfin, hAlgCinit_Cfin, hTower_BCinit_Cfin,
      hEtCinit_Cfin, u_fin, M', hle_M, hEt_M', e_fin, hu_fin, hComm_fin⟩ :=
      hCont M hFD_M
    let _ : CommRing C_fin := hCR_Cfin
    let _ : Algebra B C_fin := hAlgB_Cfin
    let _ : Algebra C_init C_fin := hAlgCinit_Cfin
    let _ : IsScalarTower B C_init C_fin := hTower_BCinit_Cfin
    let _ : Algebra.Etale C_init C_fin := hEtCinit_Cfin
    let alg_C0_Cfin : Algebra C₀ C_fin :=
      RingHom.toAlgebra ((algebraMap C_init C_fin).comp (algebraMap C₀ C_init))
    let _ : Algebra C₀ C_fin := alg_C0_Cfin
    have hTower_BC0_Cfin : IsScalarTower B C₀ C_fin :=
      IsScalarTower.of_algebraMap_eq (fun b => by
        change algebraMap B C_fin b =
          algebraMap C_init C_fin (algebraMap C₀ C_init (algebraMap B C₀ b))
        rw [← IsScalarTower.algebraMap_apply B C₀ C_init,
          ← IsScalarTower.algebraMap_apply B C_init C_fin])
    let _ : IsScalarTower C₀ C_init C_fin := IsScalarTower.of_algebraMap_eq' rfl
    have hEt_C0_Cfin : Algebra.Etale C₀ C_fin := Algebra.Etale.comp C₀ C_init C_fin
    refine ⟨C_fin, hCR_Cfin, hAlgB_Cfin, alg_C0_Cfin, hTower_BC0_Cfin, hEt_C0_Cfin, u_fin, ?_, ?_⟩
    · calc
        u_fin.comp (algebraMap C₀ C_fin)
          = (u_fin.comp (algebraMap C_init C_fin)).comp (algebraMap C₀ C_init) := rfl
        _ = u_init.comp (algebraMap C₀ C_init) := by rw [hu_fin]
        _ = u₀ := hu_init
    · have _ : IsScalarTower B C₀ C_fin := hTower_BC0_Cfin
      have _ : IsScalarTower B K K := IsScalarTower.right
      let _ : Algebra.Etale B C_fin := Algebra.Etale.comp B C₀ C_fin
      let _ : Algebra.Etale K (TensorProduct B K C_fin) := Algebra.Etale.baseChange B C_fin K
      let _ : ∀ a : Fin N, Algebra K ↥(M' a) := fun a =>
        RingHom.toAlgebra ((algebraMap (F_init a) ↥(M' a)).comp (algebraMap K (F_init a)))
      let _ : ∀ a : Fin N, IsScalarTower K (F_init a) ↥(M' a) :=
        fun _ => IsScalarTower.of_algebraMap_eq' rfl
      let _ : ∀ a : Fin N, Algebra.Etale K ↥(M' a) := hEt_M'
      let _ : Algebra.Etale K (∀ a : Fin N, ↥(M' a)) := Algebra.Etale.of_equiv e_fin
      let φ_init_fin : TensorProduct B K C_init →ₐ[K] TensorProduct B K C_fin :=
        { (Algebra.TensorProduct.map (AlgHom.id B K)
            (IsScalarTower.toAlgHom B C_init C_fin)).toRingHom with
          commutes' := fun r => by simp [Algebra.TensorProduct.algebraMap_apply] }
      have hφ_target_eq :
          Algebra.TensorProduct.map (AlgHom.id K K) (IsScalarTower.toAlgHom B C₀ C_fin) =
          φ_init_fin.comp φ_0_init := by
        apply Algebra.TensorProduct.ext
        · ext
        · ext c₀
          simp [φ_0_init, φ_init_fin]
          rfl
      let ξ_fin :=
        (G_K.cohomologyPresheaf s).map (weilAltCdSpecEtaleMap K φ_init_fin).op ξ_init
      let η_fin :=
        (G_K.cohomologyPresheaf s).map (weilAltCdSpecEtaleMap K e_fin.toAlgHom).op ξ_fin
      have hξ_init_symm :
          (G_K.cohomologyPresheaf s).map (weilAltCdSpecEtaleMap K e_init.symm.toAlgHom).op η_init =
            ξ_init := by
        dsimp [η_init]
        rw [← hCohMapComp s e_init.toAlgHom e_init.symm.toAlgHom ξ_init]
        have he_id : e_init.symm.toAlgHom.comp e_init.toAlgHom = AlgHom.id K _ :=
          AlgHom.ext e_init.symm_apply_apply
        rw [he_id, hCohMapId s _ ξ_init]
      have hη_fin_zero : η_fin = 0 := by
        apply hCofilteredProd N (fun a => ↥(M' a)) η_fin
        intro a
        have hAlgEq :
            ((Pi.evalAlgHom K (fun b : Fin N => ↥(M' b)) a).comp e_fin.toAlgHom).comp
              (φ_init_fin.comp e_init.symm.toAlgHom) =
            (IsScalarTower.toAlgHom K (F_init a) ↥(M' a)).comp (Pi.evalAlgHom K F_init a) := by
          ext w
          exact (hComm_fin (e_init.symm w) a).trans (by rw [e_init.apply_symm_apply]; rfl)
        calc
          (G_K.cohomologyPresheaf s).map
              (weilAltCdSpecEtaleMap K (Pi.evalAlgHom K (fun b : Fin N => ↥(M' b)) a)).op η_fin
            = (G_K.cohomologyPresheaf s).map
                (weilAltCdSpecEtaleMap K
                  ((Pi.evalAlgHom K (fun b : Fin N => ↥(M' b)) a).comp e_fin.toAlgHom)).op
                ξ_fin := by
              dsimp [η_fin]
              rw [← hCohMapComp s e_fin.toAlgHom (Pi.evalAlgHom K _ a) ξ_fin]
          _ = (G_K.cohomologyPresheaf s).map
                (weilAltCdSpecEtaleMap K
                  (((Pi.evalAlgHom K (fun b : Fin N => ↥(M' b)) a).comp e_fin.toAlgHom).comp
                    (φ_init_fin.comp e_init.symm.toAlgHom))).op η_init := by
              dsimp [ξ_fin]
              rw [← hξ_init_symm,
                ← hCohMapComp s e_init.symm.toAlgHom φ_init_fin η_init,
                ← hCohMapComp s (φ_init_fin.comp e_init.symm.toAlgHom)
                  ((Pi.evalAlgHom K _ a).comp e_fin.toAlgHom) η_init]
          _ = (G_K.cohomologyPresheaf s).map
                (weilAltCdSpecEtaleMap K (IsScalarTower.toAlgHom K (F_init a) ↥(M' a))).op
                ((G_K.cohomologyPresheaf s).map
                  (weilAltCdSpecEtaleMap K (Pi.evalAlgHom K F_init a)).op η_init) := by
              rw [hAlgEq, hCohMapComp s (Pi.evalAlgHom K F_init a)
                (IsScalarTower.toAlgHom K (F_init a) ↥(M' a)) η_init]
          _ = 0 := hKill_M a ↥(M' a) ⟨IntermediateField.inclusion (hle_M a)⟩
      have hξ_fin_zero : ξ_fin = 0 := by
        have hsymm :
            (G_K.cohomologyPresheaf s).map
                (weilAltCdSpecEtaleMap K e_fin.symm.toAlgHom).op η_fin = ξ_fin := by
          dsimp [η_fin]
          rw [← hCohMapComp s e_fin.toAlgHom e_fin.symm.toAlgHom ξ_fin]
          have he_id : e_fin.symm.toAlgHom.comp e_fin.toAlgHom = AlgHom.id K _ :=
            AlgHom.ext e_fin.symm_apply_apply
          rw [he_id, hCohMapId s _ ξ_fin]
        rw [← hsymm, hη_fin_zero, map_zero]
      rw [hφ_target_eq, hCohMapComp s φ_0_init φ_init_fin ξ₀]
      exact hξ_fin_zero
  refine ⟨?_, ?_⟩
  · intro n hn
    let _ : Algebra k K := i_k.toAlgebra
    exact hSub_H n (hFieldCd k K m n hℓ hTr_k_K hn G_K hℓ_GK)
  · intro s _hs
    refine ⟨?_, ?_⟩
    · intro hms x
      exact hCore s x (fun c _ _ => by omega)
    · intro d hds x hdx
      refine hCore s x (fun c hDimCx hc_le_m => ?_)
      rw [hDimCx] at hdx
      have hdc_enat : (d : ℕ∞) < (c : ℕ∞) := WithBot.coe_lt_coe.mp hdx
      have hdc : d < c := Nat.cast_lt.mp hdc_enat
      omega

theorem weil_alt_cd_stalk_zero_all_implies_isZero (S : AlgebraicGeometry.Scheme.{u})
    (ℋ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
    (hStalk : ∀ x : ↥S, WeilAltCdStalkZeroAt S ℋ x) :
    CategoryTheory.Limits.IsZero ℋ :=
by
  rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
  apply (CategoryTheory.sheafToPresheaf S.smallEtaleTopology AddCommGrpCat.{u}).map_injective
  change CategoryTheory.CategoryStruct.id ℋ.obj = 0
  ext ⟨U⟩ s
  simp only [CategoryTheory.NatTrans.id_app, CategoryTheory.NatTrans.app_zero,
    AddCommGrpCat.hom_id, AddCommGrpCat.hom_zero, AddMonoidHom.id_apply, AddMonoidHom.zero_apply]
  let R_U : CategoryTheory.Sieve U :=
    CategoryTheory.Sieve.mk (fun V v => ℋ.obj.map (Opposite.op v) s = 0)
      (fun {V W f} hf g => by
        change (ℋ.obj.map (CategoryTheory.CategoryStruct.comp (Opposite.op f) (Opposite.op g))) s = 0
        rw [ℋ.obj.map_comp, AddCommGrpCat.comp_apply, hf, map_zero])
  have hCov : R_U ∈ S.smallEtaleTopology U := by
    let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
      @AlgebraicGeometry.Etale
    let U' : P_et.Over ⊤ S := U
    let R_U' : CategoryTheory.Sieve U' := R_U
    have hMemPre : R_U' ∈
        (AlgebraicGeometry.Scheme.smallGrothendieckTopology P_et S) U' := by
      rw [AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology,
        AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology]
      · intro y
        let Fgt := AlgebraicGeometry.Scheme.Etale.forget S
        let y₀ : ↥U.left := y
        haveI : AlgebraicGeometry.Etale U.hom := U.prop
        let x : ↥S := U.hom.base y₀
        letI : Algebra ↑(S.presheaf.stalk x) ↑(U.left.presheaf.stalk y₀) :=
          (@AlgebraicGeometry.Scheme.Hom.stalkMap U.left S U.hom y₀).hom.toAlgebra
        haveI : IsLocalHom (algebraMap ↑(S.presheaf.stalk x) ↑(U.left.presheaf.stalk y₀)) :=
          (inferInstance : IsLocalHom (@AlgebraicGeometry.Scheme.Hom.stalkMap U.left S U.hom y₀).hom)
        haveI : Algebra.EssFiniteType ↑(S.presheaf.stalk x) ↑(U.left.presheaf.stalk y₀) :=
          RingHom.essFiniteType_algebraMap.mp
            (@AlgebraicGeometry.LocallyOfFiniteType.stalkMap U.left S U.hom inferInstance y₀)
        haveI : Algebra.FormallyUnramified ↑(S.presheaf.stalk x) ↑(U.left.presheaf.stalk y₀) :=
          RingHom.formallyUnramified_algebraMap.mp
            (AlgebraicGeometry.HasRingHomProperty.stalkMap
              (P := @AlgebraicGeometry.FormallyUnramified)
              (Q := fun {R₀ S₀ : Type u} [CommRing R₀] [CommRing S₀] =>
                @RingHom.FormallyUnramified R₀ S₀ _ _)
              (fun {R₀ S₀ : Type u} [CommRing R₀] [CommRing S₀] f hf J hJ => by
                letI : J.IsPrime := hJ
                letI : (Ideal.comap f J).IsPrime := Ideal.IsPrime.comap f
                letI : Algebra R₀ S₀ := f.toAlgebra
                haveI : Algebra.FormallyUnramified R₀ S₀ :=
                  RingHom.formallyUnramified_algebraMap.mp hf
                haveI : Subsingleton (KaehlerDifferential R₀ (Localization.AtPrime J)) :=
                  (Algebra.formallyUnramified_iff R₀ (Localization.AtPrime J)).mp inferInstance
                letI : Algebra (Localization.AtPrime (Ideal.comap f J))
                    (Localization.AtPrime J) :=
                  (Localization.localRingHom (Ideal.comap f J) J f rfl).toAlgebra
                letI : IsScalarTower R₀ (Localization.AtPrime (Ideal.comap f J))
                    (Localization.AtPrime J) :=
                  ⟨fun r x y => by
                    calc
                      (r • x) • y
                        = algebraMap (Localization.AtPrime (Ideal.comap f J))
                            (Localization.AtPrime J) (r • x) * y :=
                          Algebra.smul_def (r • x) y
                      _ = algebraMap (Localization.AtPrime (Ideal.comap f J))
                            (Localization.AtPrime J)
                            (algebraMap R₀ (Localization.AtPrime (Ideal.comap f J)) r * x) * y := by
                          rw [Algebra.smul_def r x]
                      _ = (Localization.localRingHom (Ideal.comap f J) J f rfl
                            (algebraMap R₀ (Localization.AtPrime (Ideal.comap f J)) r) *
                          algebraMap (Localization.AtPrime (Ideal.comap f J))
                            (Localization.AtPrime J) x) * y := by
                          rw [map_mul]
                          rfl
                      _ = ((algebraMap S₀ (Localization.AtPrime J)) (f r) *
                          algebraMap (Localization.AtPrime (Ideal.comap f J))
                            (Localization.AtPrime J) x) * y := by
                          rw [Localization.localRingHom_to_map (Ideal.comap f J) J f rfl r]
                      _ = (algebraMap R₀ (Localization.AtPrime J) r *
                          algebraMap (Localization.AtPrime (Ideal.comap f J))
                            (Localization.AtPrime J) x) * y :=
                          congrArg
                            (fun z =>
                              (z * algebraMap (Localization.AtPrime (Ideal.comap f J))
                                (Localization.AtPrime J) x) * y)
                            (IsScalarTower.algebraMap_apply R₀ S₀ (Localization.AtPrime J) r).symm
                      _ = algebraMap R₀ (Localization.AtPrime J) r *
                          (algebraMap (Localization.AtPrime (Ideal.comap f J))
                            (Localization.AtPrime J) x * y) :=
                          mul_assoc _ _ _
                      _ = algebraMap R₀ (Localization.AtPrime J) r * (x • y) := by
                          rw [← Algebra.smul_def x y]
                      _ = r • (x • y) :=
                          (Algebra.smul_def r (x • y)).symm⟩
                have hSubLoc : Subsingleton
                    (KaehlerDifferential (Localization.AtPrime (Ideal.comap f J))
                      (Localization.AtPrime J)) :=
                  (KaehlerDifferential.map_surjective R₀
                    (Localization.AtPrime (Ideal.comap f J))
                    (Localization.AtPrime J)).subsingleton
                have hUnramLoc : Algebra.FormallyUnramified
                    (Localization.AtPrime (Ideal.comap f J)) (Localization.AtPrime J) :=
                  (Algebra.formallyUnramified_iff
                    (Localization.AtPrime (Ideal.comap f J))
                    (Localization.AtPrime J)).mpr hSubLoc
                change (Localization.localRingHom (Ideal.comap f J) J f rfl).FormallyUnramified
                exact RingHom.formallyUnramified_algebraMap.mpr hUnramLoc)
              (inferInstance : AlgebraicGeometry.FormallyUnramified U.hom) y₀)
        haveI : Module.Finite
            (IsLocalRing.ResidueField ↑(S.presheaf.stalk x))
            (IsLocalRing.ResidueField ↑(U.left.presheaf.stalk y₀)) :=
          Algebra.instFiniteResidueFieldOfFormallyUnramified
        haveI : Algebra.IsAlgebraic
            (IsLocalRing.ResidueField ↑(S.presheaf.stalk x))
            (IsLocalRing.ResidueField ↑(U.left.presheaf.stalk y₀)) :=
          Algebra.IsAlgebraic.of_finite _ _
        let toΩ : IsLocalRing.ResidueField ↑(S.presheaf.stalk x) →+*
            AlgebraicClosure ↥(S.residueField x) :=
          algebraMap ↥(S.residueField x) (AlgebraicClosure ↥(S.residueField x))
        letI : Algebra
            (IsLocalRing.ResidueField ↑(S.presheaf.stalk x))
            (AlgebraicClosure ↥(S.residueField x)) :=
          toΩ.toAlgebra
        let ι :
            IsLocalRing.ResidueField ↑(U.left.presheaf.stalk y₀) →ₐ[
              IsLocalRing.ResidueField ↑(S.presheaf.stalk x)]
            AlgebraicClosure ↥(S.residueField x) :=
          IsAlgClosed.lift
        let ι_hom : U.left.residueField y₀ ⟶
            CommRingCat.of (AlgebraicClosure ↥(S.residueField x)) :=
          CommRingCat.ofHom ι.toRingHom
        have hcomp_res :
            CategoryTheory.CategoryStruct.comp
                (@AlgebraicGeometry.Scheme.Hom.residueFieldMap U.left S U.hom y₀) ι_hom =
              CommRingCat.ofHom
                (algebraMap ↥(S.residueField x) (AlgebraicClosure ↥(S.residueField x))) := by
          ext a
          obtain ⟨r, rfl⟩ := S.residue_surjective x a
          have hres := congrArg (fun f => f.hom r)
            (@AlgebraicGeometry.Scheme.residue_residueFieldMap U.left S U.hom y₀)
          change ι.toRingHom
              ((@AlgebraicGeometry.Scheme.Hom.residueFieldMap U.left S U.hom y₀).hom
                ((S.residue x).hom r)) =
            algebraMap ↥(S.residueField x) (AlgebraicClosure ↥(S.residueField x))
              ((S.residue x).hom r)
          have hres' :
              (@AlgebraicGeometry.Scheme.Hom.residueFieldMap U.left S U.hom y₀).hom
                  ((S.residue x).hom r) =
                (U.left.residue y₀).hom
                  ((@AlgebraicGeometry.Scheme.Hom.stalkMap U.left S U.hom y₀).hom r) := hres
          rw [hres']
          change ι ((IsLocalRing.residue ↑(U.left.presheaf.stalk y₀))
              ((algebraMap ↑(S.presheaf.stalk x) ↑(U.left.presheaf.stalk y₀)) r)) =
            algebraMap (IsLocalRing.ResidueField ↑(S.presheaf.stalk x))
              (AlgebraicClosure ↥(S.residueField x))
              ((IsLocalRing.residue ↑(S.presheaf.stalk x)) r)
          rw [← IsLocalRing.ResidueField.algebraMap_residue, ι.commutes]
        let u : AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure ↥(S.residueField x))) ⟶
            ((Fgt.obj U).left) :=
          CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Spec.map ι_hom)
            (U.left.fromSpecResidueField y₀)
        have hu_gx : CategoryTheory.CategoryStruct.comp u ((Fgt.obj U).hom) =
            CategoryTheory.CategoryStruct.comp
              (AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom
                  (algebraMap ↥(S.residueField x) (AlgebraicClosure ↥(S.residueField x)))))
              (S.fromSpecResidueField x) :=
          (CategoryTheory.Category.assoc
            (AlgebraicGeometry.Spec.map ι_hom)
            (U.left.fromSpecResidueField y₀) U.hom).trans
          ((congrArg
              (CategoryTheory.CategoryStruct.comp (AlgebraicGeometry.Spec.map ι_hom))
              (@AlgebraicGeometry.Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField
                U.left S U.hom y₀).symm).trans
          ((CategoryTheory.Category.assoc
              (AlgebraicGeometry.Spec.map ι_hom)
              (AlgebraicGeometry.Spec.map
                (@AlgebraicGeometry.Scheme.Hom.residueFieldMap U.left S U.hom y₀))
              (S.fromSpecResidueField x)).symm.trans
          ((congrArg
              (fun φ => CategoryTheory.CategoryStruct.comp φ (S.fromSpecResidueField x))
              (AlgebraicGeometry.Spec.map_comp
                (@AlgebraicGeometry.Scheme.Hom.residueFieldMap U.left S U.hom y₀)
                ι_hom).symm).trans
          (congrArg
            (fun ψ => CategoryTheory.CategoryStruct.comp
              (AlgebraicGeometry.Spec.map ψ) (S.fromSpecResidueField x))
            hcomp_res))))
        obtain ⟨V, v, w, hw, hv_zero⟩ := hStalk x U u hu_gx s
        let pt₀ :
            ↥(AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure ↥(S.residueField x)))) :=
          default
        have hpt : v.left.base (w.base pt₀) = y := by
          have hw_pt : (CategoryTheory.CategoryStruct.comp w ((Fgt.map v).left)).base pt₀ =
              u.base pt₀ := congrArg (fun φ => φ.base pt₀) hw
          have hu_pt : u.base pt₀ = y := by
            change (U.left.fromSpecResidueField y₀).base
              ((AlgebraicGeometry.Spec.map ι_hom).base pt₀) = y₀
            exact AlgebraicGeometry.Scheme.fromSpecResidueField_apply y₀ _
          exact hw_pt.trans hu_pt
        have hEt_v : AlgebraicGeometry.Etale v.left := by
          have hcomp_v : CategoryTheory.CategoryStruct.comp v.left U.hom = V.hom :=
            CategoryTheory.MorphismProperty.Over.w v
          have hEt_comp :
              AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.comp v.left U.hom) := by
            rw [hcomp_v]
            exact V.prop
          exact CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale) v.left U.hom
            U.prop hEt_comp
        exact ⟨V, v, w.base pt₀, hv_zero, hEt_v, hpt⟩
      · exact le_rfl
    exact hMemPre
  have hSepAll := CategoryTheory.Presheaf.IsSheaf.isSeparated ℋ.property
  apply hSepAll U R_U hCov s 0
  intro V v hv
  change ℋ.obj.map (Opposite.op v) s = ℋ.obj.map (Opposite.op v) 0
  rw [hv, map_zero]

theorem weil_alt_cd_generic_pushforward_fullyFaithful_and_excision (V : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsIntegral V]
    [hCont : (weilAltCdSitePullback (V.fromSpecStalk (genericPoint ↥V))).IsContinuous
      V.smallEtaleTopology
      (AlgebraicGeometry.Spec (V.presheaf.stalk (genericPoint ↥V))).smallEtaleTopology]
    (P_pull : CategoryTheory.Functor
      (CategoryTheory.Sheaf V.smallEtaleTopology AddCommGrpCat.{u})
      (CategoryTheory.Sheaf
        (AlgebraicGeometry.Spec (V.presheaf.stalk (genericPoint ↥V))).smallEtaleTopology
        AddCommGrpCat.{u}))
    [P_pull.Additive]
    [CategoryTheory.Limits.PreservesFiniteLimits P_pull]
    [CategoryTheory.Limits.PreservesFiniteColimits P_pull]
    (adj_g : P_pull ⊣
      (weilAltCdSitePullback (V.fromSpecStalk (genericPoint ↥V))).sheafPushforwardContinuous
        AddCommGrpCat.{u} V.smallEtaleTopology
        (AlgebraicGeometry.Spec (V.presheaf.stalk (genericPoint ↥V))).smallEtaleTopology)
    (ℱ : CategoryTheory.Sheaf V.smallEtaleTopology AddCommGrpCat.{u}) :
    WeilAltCdStalkZeroAt V (CategoryTheory.Limits.kernel (adj_g.unit.app ℱ)) (genericPoint ↥V) ∧
    WeilAltCdStalkZeroAt V (CategoryTheory.Limits.cokernel (adj_g.unit.app ℱ)) (genericPoint ↥V) :=
by
  let η : ↥V := genericPoint ↥V
  let K_ring : CommRingCat.{u} := V.presheaf.stalk η
  let K : Type u := ↥K_ring
  let S_η : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec K_ring
  let g : Quiver.Hom S_η V := V.fromSpecStalk η
  let B_g := weilAltCdSitePullback g
  let P_push := B_g.sheafPushforwardContinuous AddCommGrpCat.{u}
    V.smallEtaleTopology S_η.smallEtaleTopology

  have _ : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
    CategoryTheory.MorphismProperty.IsStableUnderComposition.mk
      (fun _ _ hf hg => by have _ := hf; have _ := hg; infer_instance)
  have hTopoEq := fun (S₀ : AlgebraicGeometry.Scheme.{u}) =>
    AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) S₀ le_rfl
  have hMemTopo :
      ∀ (S₀ : AlgebraicGeometry.Scheme.{u}) (X : S₀.Etale) (R : CategoryTheory.Sieve X),
        R ∈ S₀.smallEtaleTopology X ↔
          ∀ x : ↥X.left, ∃ (Y : S₀.Etale) (f : Y ⟶ X) (y : ↥Y.left),
            R.arrows f ∧ AlgebraicGeometry.Etale f.left ∧ f.left.base y = x :=
    fun S₀ X R =>
      (Eq.to_iff (congrArg (fun J => R ∈ J X) (hTopoEq S₀))).trans
        (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology X R)

  
  have hFracHelper :
      ∀ (X : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsIntegral X]
        (U : X.Opens) (hU : AlgebraicGeometry.IsAffineOpen U) (hηU : genericPoint ↥X ∈ U),
        let R_u : Type u := ↥(X.presheaf.obj (Opposite.op U))
        let F_u : Type u := ↥(X.presheaf.stalk (genericPoint ↥X))
        let _ : Algebra R_u F_u := (X.presheaf.germ U (genericPoint ↥X) hηU).hom.toAlgebra
        IsDomain R_u ∧ IsFractionRing R_u F_u := by
    intro X _ U hU hηU R_u F_u _
    have hDom : IsDomain R_u :=
      @AlgebraicGeometry.IsIntegral.component_integral X _ U ⟨⟨genericPoint ↥X, hηU⟩⟩
    have hInj : Function.Injective (algebraMap R_u F_u) :=
      AlgebraicGeometry.germ_injective_of_isIntegral X (genericPoint ↥X) hηU
    have hLoc : IsLocalization.AtPrime F_u (hU.primeIdealOf ⟨genericPoint ↥X, hηU⟩).asIdeal :=
      hU.isLocalization_stalk ⟨genericPoint ↥X, hηU⟩
    refine ⟨hDom, ?_⟩
    refine
      { map_units := fun s => ?_
        surj := fun z => ?_
        exists_of_eq := fun {x₁ x₂} hx => ⟨1, by simp [hInj hx]⟩ }
    · have hs0 : (s : R_u) ≠ 0 := nonZeroDivisors.ne_zero s.2
      have hmap0 : algebraMap R_u F_u s ≠ 0 := fun h0 =>
        hs0 (hInj (h0.trans (map_zero (algebraMap R_u F_u)).symm))
      exact IsUnit.mk0 _ hmap0
    · obtain ⟨⟨b, p⟩, hbp⟩ :=
        @IsLocalization.surj _ _ (hU.primeIdealOf ⟨genericPoint ↥X, hηU⟩).asIdeal.primeCompl
          F_u _ _ hLoc z
      have hp_unit : IsUnit (algebraMap R_u F_u p) :=
        @IsLocalization.map_units _ _
          (hU.primeIdealOf ⟨genericPoint ↥X, hηU⟩).asIdeal.primeCompl F_u _ _ hLoc p
      have hp0 : (p : R_u) ≠ 0 := fun h0 =>
        hp_unit.ne_zero (by rw [h0, map_zero])
      exact ⟨⟨b, ⟨p, mem_nonZeroDivisors_of_ne_zero hp0⟩⟩, hbp⟩

  obtain ⟨v₀⟩ : Nonempty ↥V := inferInstance
  obtain ⟨W₀, hW₀, hv₀, _⟩ :=
    AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (X := V) (x := v₀) (U := ⊤) trivial
  have hη : η ∈ W₀ := by
    by_contra hnot
    have hcl : closure ({η} : Set ↥V) ⊆ (W₀ : Set ↥V)ᶜ :=
      closure_minimal (fun x hx => by rw [Set.mem_singleton_iff.mp hx]; exact hnot)
        W₀.isOpen.isClosed_compl
    rw [(genericPoint_spec ↥V).def] at hcl
    exact hcl trivial hv₀
  let B_ring : CommRingCat.{u} := V.presheaf.obj (Opposite.op W₀)
  let B : Type u := ↥B_ring
  let _ : Algebra B K := (V.presheaf.germ W₀ η hη).hom.toAlgebra
  obtain ⟨hDomB, hFracBK⟩ := hFracHelper V W₀ hW₀ hη
  have hg_fromSpec : g = AlgebraicGeometry.Spec.map (V.presheaf.germ W₀ η hη) ≫ hW₀.fromSpec :=
    (hW₀.fromSpecStalk_eq_fromSpecStalk hη).symm

  
  have hSpreadEtaleAlg :
      ∀ (B₀_dom K₀ L₀ : Type u) [CommRing B₀_dom] [IsDomain B₀_dom]
        [Field K₀] [Algebra B₀_dom K₀] [IsFractionRing B₀_dom K₀]
        [Field L₀] [Algebra K₀ L₀] [Algebra.Etale K₀ L₀],
        ∃ (f : B₀_dom) (_ : f ≠ 0)
          (C : Type u) (_ : CommRing C) (_ : IsDomain C)
          (_ : Algebra (Localization.Away f) C) (_ : Algebra.Etale (Localization.Away f) C)
          (_ : Algebra C L₀) (_ : IsFractionRing C L₀)
          (ι_f : Localization.Away f →ₐ[B₀_dom] K₀),
          (∀ b : B₀_dom, ι_f (algebraMap B₀_dom (Localization.Away f) b) = algebraMap B₀_dom K₀ b) ∧
          (let _ : Algebra (Localization.Away f) K₀ := ι_f.toRingHom.toAlgebra
           ∃ e_CK : TensorProduct (Localization.Away f) K₀ C ≃ₐ[K₀] L₀,
             (∀ c : C, e_CK ((1 : K₀) ⊗ₜ[Localization.Away f] c) = algebraMap C L₀ c) ∧
             (∀ x : Localization.Away f,
               algebraMap C L₀ (algebraMap (Localization.Away f) C x) =
                 algebraMap K₀ L₀ (ι_f x))) := by
    intro B₀_dom K₀ L₀ _ _ _ _ _ _ _ _
    obtain ⟨A₀, D₀, _, _, hFG, hEtD₀, ⟨e_L⟩⟩ :=
      Algebra.Etale.exists_subalgebra_fg B₀_dom K₀ L₀
    obtain ⟨s, hs⟩ := hFG
    let _ := Classical.decEq K₀
    have hdiv : ∀ z : K₀, ∃ (a : B₀_dom) (d : nonZeroDivisors B₀_dom),
        z * algebraMap B₀_dom K₀ d = algebraMap B₀_dom K₀ a := by
      intro z
      obtain ⟨⟨a, d⟩, had⟩ := IsLocalization.surj (nonZeroDivisors B₀_dom) z
      exact ⟨a, d, had⟩
    let num_fn : K₀ → B₀_dom := fun z => (hdiv z).choose
    let den_fn : K₀ → nonZeroDivisors B₀_dom := fun z => (hdiv z).choose_spec.choose
    have hnum_den : ∀ z : K₀,
        z * algebraMap B₀_dom K₀ (den_fn z) = algebraMap B₀_dom K₀ (num_fn z) :=
      fun z => (hdiv z).choose_spec.choose_spec
    let f : B₀_dom := ∏ z ∈ s, (den_fn z : B₀_dom)
    have hf_ne : f ≠ 0 :=
      Finset.prod_ne_zero_iff.mpr (fun z _ => nonZeroDivisors.ne_zero (den_fn z).2)
    have hf_K_ne : algebraMap B₀_dom K₀ f ≠ 0 :=
      fun h0 => hf_ne (IsFractionRing.injective B₀_dom K₀ (h0.trans (map_zero _).symm))
    have hu_f : IsUnit (algebraMap B₀_dom K₀ f) := IsUnit.mk0 _ hf_K_ne
    let B_f := Localization.Away f
    let ι_f_ring : B_f →+* K₀ := IsLocalization.Away.lift f hu_f
    let ι_f : B_f →ₐ[B₀_dom] K₀ :=
      { toRingHom := ι_f_ring
        commutes' := fun b => IsLocalization.Away.lift_eq f hu_f b }
    have hι_f_inj : Function.Injective ι_f := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      let sec := IsLocalization.Away.sec f x
      have hsec : x * algebraMap B₀_dom B_f (f ^ sec.2) = algebraMap B₀_dom B_f sec.1 := by
        simpa [sec, mul_comm] using IsLocalization.Away.sec_spec f x
      have h1 := congrArg ι_f hsec
      rw [map_mul, hx, zero_mul, ι_f.commutes] at h1
      have hsec1 : sec.1 = 0 :=
        IsFractionRing.injective B₀_dom K₀ (h1.symm.trans (map_zero _).symm)
      rw [hsec1, map_zero] at hsec
      have hu_pow : IsUnit (algebraMap B₀_dom B_f (f ^ sec.2)) := by
        rw [map_pow]
        exact (IsLocalization.Away.algebraMap_isUnit f).pow sec.2
      exact hu_pow.mul_left_eq_zero.mp hsec
    have hs_sub : (↑s : Set K₀) ⊆ (ι_f.range : Set K₀) := by
      intro z hz
      have hprod : (den_fn z : B₀_dom) * (∏ w ∈ s.erase z, (den_fn w : B₀_dom)) = f :=
        Finset.mul_prod_erase s (fun w => (den_fn w : B₀_dom)) hz
      let rem : B₀_dom := ∏ w ∈ s.erase z, (den_fn w : B₀_dom)
      let y_z : B_f :=
        algebraMap B₀_dom B_f (num_fn z * rem) * IsLocalization.Away.invSelf (S := B_f) f
      refine ⟨y_z, ?_⟩
      apply mul_right_cancel₀ hf_K_ne
      have hinv : algebraMap B₀_dom B_f f * IsLocalization.Away.invSelf (S := B_f) f = 1 :=
        IsLocalization.Away.mul_invSelf f
      calc
        ι_f y_z * algebraMap B₀_dom K₀ f
            = ι_f (y_z * algebraMap B₀_dom B_f f) := by rw [← ι_f.commutes f, ← map_mul]
        _ = ι_f (algebraMap B₀_dom B_f (num_fn z * rem)) := by
            dsimp [y_z]
            rw [mul_assoc, mul_comm (IsLocalization.Away.invSelf f), hinv, mul_one]
        _ = algebraMap B₀_dom K₀ (num_fn z) * algebraMap B₀_dom K₀ rem := by
            rw [ι_f.commutes, map_mul]
        _ = z * (algebraMap B₀_dom K₀ (den_fn z) * algebraMap B₀_dom K₀ rem) := by
            rw [← hnum_den z, mul_assoc]
        _ = z * algebraMap B₀_dom K₀ f := by
            rw [← map_mul, hprod]
    have hA₀_le : A₀ ≤ ι_f.range := by
      rw [← hs]
      exact Algebra.adjoin_le hs_sub
    let ψ₀_fun : ↥A₀ → B_f := fun a => (hA₀_le a.2).choose
    have hψ₀_spec : ∀ a : ↥A₀, ι_f (ψ₀_fun a) = a.1 :=
      fun a => (hA₀_le a.2).choose_spec
    let ψ₀ : ↥A₀ →+* B_f :=
      { toFun := ψ₀_fun
        map_one' := hι_f_inj (by rw [hψ₀_spec, map_one]; rfl)
        map_mul' := fun a₁ a₂ => hι_f_inj (by rw [hψ₀_spec, map_mul, hψ₀_spec, hψ₀_spec]; rfl)
        map_zero' := hι_f_inj (by rw [hψ₀_spec, map_zero]; rfl)
        map_add' := fun a₁ a₂ => hι_f_inj (by rw [hψ₀_spec, map_add, hψ₀_spec, hψ₀_spec]; rfl) }
    let _ : Algebra ↥A₀ B_f := ψ₀.toAlgebra
    let _ : Algebra B_f K₀ := ι_f.toRingHom.toAlgebra
    have hTower_A₀_Bf_K₀ : IsScalarTower ↥A₀ B_f K₀ :=
      IsScalarTower.of_algebraMap_eq' (RingHom.ext fun a => (hψ₀_spec a).symm)
    let C : Type u := TensorProduct ↥A₀ B_f D₀
    have hEt_Bf_C : Algebra.Etale B_f C := Algebra.Etale.baseChange ↥A₀ D₀ B_f
    let e_CK : TensorProduct B_f K₀ C ≃ₐ[K₀] L₀ :=
      (Algebra.TensorProduct.cancelBaseChange ↥A₀ B_f K₀ K₀ D₀).trans e_L.symm
    let φ_CL : C →+* L₀ :=
      e_CK.toRingHom.comp
        (Algebra.TensorProduct.includeRight : C →ₐ[B_f] TensorProduct B_f K₀ C).toRingHom
    have hφ_CL_inj : Function.Injective φ_CL := by
      intro c₁ c₂ hc
      have htmul : (1 : K₀) ⊗ₜ[B_f] c₁ = (1 : K₀) ⊗ₜ[B_f] c₂ := e_CK.injective hc
      have hlin_inj : Function.Injective (Algebra.linearMap B_f K₀) := hι_f_inj
      have hrT_inj : Function.Injective (LinearMap.rTensor C (Algebra.linearMap B_f K₀)) :=
        Module.Flat.rTensor_preserves_injective_linearMap (Algebra.linearMap B_f K₀) hlin_inj
      have h_eq_rt :
          LinearMap.rTensor C (Algebra.linearMap B_f K₀) ((TensorProduct.lid B_f C).symm c₁) =
          LinearMap.rTensor C (Algebra.linearMap B_f K₀) ((TensorProduct.lid B_f C).symm c₂) := by
        simpa only [TensorProduct.lid_symm_apply, LinearMap.rTensor_tmul,
          Algebra.linearMap_apply, map_one] using htmul
      exact (TensorProduct.lid B_f C).symm.injective (hrT_inj h_eq_rt)
    have hDomC : IsDomain C := Function.Injective.isDomain φ_CL hφ_CL_inj
    let _ : Algebra C L₀ := φ_CL.toAlgebra
    have hBf_comm : ∀ x : B_f,
        algebraMap C L₀ (algebraMap B_f C x) = algebraMap K₀ L₀ (ι_f x) := by
      intro x
      change e_CK ((1 : K₀) ⊗ₜ[B_f] algebraMap B_f C x) = algebraMap K₀ L₀ (ι_f x)
      have h1 : (1 : K₀) ⊗ₜ[B_f] algebraMap B_f C x =
          (ι_f x) • (1 : TensorProduct B_f K₀ C) := by
        change (1 : K₀) ⊗ₜ[B_f] algebraMap B_f C x = (ι_f x) • ((1 : K₀) ⊗ₜ[B_f] (1 : C))
        rw [TensorProduct.smul_tmul', Algebra.smul_def, mul_one,
          Algebra.algebraMap_eq_smul_one (A := C), ← TensorProduct.smul_tmul]
        simp only [Algebra.smul_def, mul_one, Algebra.algebraMap_self, RingHom.id_apply]
        rfl
      rw [h1, _root_.map_smul e_CK, map_one, Algebra.smul_def, mul_one]
    have hClear : ∀ t : TensorProduct B_f K₀ C,
        ∃ (c : C) (s_c : nonZeroDivisors C), e_CK t * algebraMap C L₀ s_c = algebraMap C L₀ c := by
      intro t
      induction t using TensorProduct.induction_on with
      | zero =>
        exact ⟨0, 1, by simp⟩
      | tmul k c₀ =>
        obtain ⟨a_k, d_k, hk⟩ := hdiv k
        let a' : B_f := algebraMap B₀_dom B_f a_k
        let d' : B_f := algebraMap B₀_dom B_f d_k
        have hd'_ne_K : ι_f d' ≠ 0 := by
          rw [ι_f.commutes]
          exact fun h0 => nonZeroDivisors.ne_zero d_k.2
            (IsFractionRing.injective B₀_dom K₀ (h0.trans (map_zero _).symm))
        have hd'_C_ne : algebraMap B_f C d' ≠ 0 := by
          intro h0
          have hL0 : algebraMap C L₀ (algebraMap B_f C d') = 0 := by rw [h0, map_zero]
          rw [hBf_comm] at hL0
          exact hd'_ne_K ((algebraMap K₀ L₀).injective (hL0.trans (map_zero _).symm))
        refine ⟨algebraMap B_f C a' * c₀,
          ⟨algebraMap B_f C d', mem_nonZeroDivisors_of_ne_zero hd'_C_ne⟩, ?_⟩
        have hsplit : e_CK (k ⊗ₜ[B_f] c₀) = algebraMap K₀ L₀ k * algebraMap C L₀ c₀ := by
          have hkt : k ⊗ₜ[B_f] c₀ = k • ((1 : K₀) ⊗ₜ[B_f] c₀) := by
            rw [TensorProduct.smul_tmul', Algebra.smul_def, mul_one,
              Algebra.algebraMap_self, RingHom.id_apply]
          rw [hkt, _root_.map_smul e_CK, Algebra.smul_def]
          rfl
        rw [hsplit]
        change algebraMap K₀ L₀ k * algebraMap C L₀ c₀ *
            algebraMap C L₀ (algebraMap B_f C d') =
          algebraMap C L₀ (algebraMap B_f C a' * c₀)
        rw [hBf_comm d', map_mul, hBf_comm a', ι_f.commutes, ι_f.commutes]
        calc
          algebraMap K₀ L₀ k * algebraMap C L₀ c₀ * algebraMap K₀ L₀ (algebraMap B₀_dom K₀ d_k)
              = (algebraMap K₀ L₀ k * algebraMap K₀ L₀ (algebraMap B₀_dom K₀ d_k)) *
                  algebraMap C L₀ c₀ := by ring
          _ = algebraMap K₀ L₀ (k * algebraMap B₀_dom K₀ d_k) * algebraMap C L₀ c₀ := by
              rw [← map_mul]
          _ = algebraMap K₀ L₀ (algebraMap B₀_dom K₀ a_k) * algebraMap C L₀ c₀ := by
              rw [hk]
      | add t₁ t₂ ih₁ ih₂ =>
        obtain ⟨c₁, s₁, h₁⟩ := ih₁
        obtain ⟨c₂, s₂, h₂⟩ := ih₂
        refine ⟨c₁ * s₂ + c₂ * s₁, s₁ * s₂, ?_⟩
        have hs_mul : ((s₁ * s₂ : nonZeroDivisors C) : C) = (s₁ : C) * (s₂ : C) := rfl
        rw [hs_mul, map_add, map_add, map_mul, map_mul, map_mul]
        calc
          (e_CK t₁ + e_CK t₂) * (algebraMap C L₀ s₁ * algebraMap C L₀ s₂)
              = (e_CK t₁ * algebraMap C L₀ s₁) * algebraMap C L₀ s₂ +
                  (e_CK t₂ * algebraMap C L₀ s₂) * algebraMap C L₀ s₁ := by ring
          _ = algebraMap C L₀ c₁ * algebraMap C L₀ s₂ +
                algebraMap C L₀ c₂ * algebraMap C L₀ s₁ := by rw [h₁, h₂]
    have hFracCL : IsFractionRing C L₀ :=
      { map_units := fun s_c => by
          have hs0 : (s_c : C) ≠ 0 := nonZeroDivisors.ne_zero s_c.2
          exact IsUnit.mk0 _ (fun h0 => hs0 (hφ_CL_inj (h0.trans (map_zero φ_CL).symm)))
        surj := fun z => by
          obtain ⟨c, s_c, hc⟩ := hClear (e_CK.symm z)
          rw [e_CK.apply_symm_apply] at hc
          exact ⟨⟨c, s_c⟩, hc⟩
        exists_of_eq := fun hx => ⟨1, by simp [hφ_CL_inj hx]⟩ }
    exact ⟨f, hf_ne, C, inferInstance, hDomC, inferInstance, hEt_Bf_C, inferInstance, hFracCL,
      ι_f, ι_f.commutes, ⟨e_CK, fun _ => rfl, hBf_comm⟩⟩

  
  have hPointModel :
      ∀ (Y : S_η.Etale) (y : ↥Y.left),
        ∃ (W : V.Etale) (_ : AlgebraicGeometry.IsIntegral W.left)
          (θ : AlgebraicGeometry.Spec (W.left.presheaf.stalk (genericPoint ↥W.left)) ≅
            (B_g.obj W).left)
          (h_y : Quiver.Hom (B_g.obj W) Y)
          (z₀ : ↥(B_g.obj W).left),
          θ.hom ≫ CategoryTheory.Limits.pullback.fst W.hom g =
            W.left.fromSpecStalk (genericPoint ↥W.left) ∧
          h_y.left.base z₀ = y := by
    intro Y y
    obtain ⟨U_y, hUy, hy, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (X := Y.left) (x := y) (U := ⊤) trivial
    let A_ring : CommRingCat.{u} := Y.left.presheaf.obj (Opposite.op U_y)
    let A : Type u := ↥A_ring
    have hy_range : y ∈ Set.range hUy.fromSpec.base := by
      rw [hUy.range_fromSpec]
      exact hy
    obtain ⟨p_y, hpy⟩ := hy_range
    let p_A : PrimeSpectrum A := p_y
    let mor_AK : AlgebraicGeometry.Spec (CommRingCat.of A) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of K) :=
      hUy.fromSpec ≫ Y.hom
    have _ : AlgebraicGeometry.Etale Y.hom := Y.prop
    have hEt_morAK : AlgebraicGeometry.Etale mor_AK := by
      dsimp [mor_AK]
      infer_instance
    let ρ_KA_cat : CommRingCat.of K ⟶ CommRingCat.of A :=
      (AlgebraicGeometry.Scheme.Spec.preimage mor_AK).unop
    have hmap_ρ : AlgebraicGeometry.Spec.map ρ_KA_cat = mor_AK :=
      AlgebraicGeometry.Scheme.Spec.map_preimage mor_AK
    let _ : Algebra K A := ρ_KA_cat.hom.toAlgebra
    have hEt_KA : Algebra.Etale K A := by
      rw [← RingHom.etale_algebraMap]
      have hEt_spec : AlgebraicGeometry.Etale
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K A))) := by
        have hEq : CommRingCat.ofHom (algebraMap K A) = ρ_KA_cat := rfl
        rw [hEq, hmap_ρ]
        exact hEt_morAK
      exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
        hEt_spec
    obtain ⟨I_idx, hFinI, Ai, hFieldAi, hAlgAi, e_prod, hFinSepAi⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod K A).mp hEt_KA
    let _ := Classical.decEq I_idx
    let _ := Fintype.ofFinite I_idx
    let u_idem : I_idx → A := fun i => e_prod.symm (fun j => if j = i then 1 else 0)
    have hsum_idem : (∑ i : I_idx, u_idem i) = 1 := by
      apply e_prod.injective
      rw [map_sum, map_one]
      ext j
      simp [u_idem]
    have hex_i₀ : ∃ i₀ : I_idx, u_idem i₀ ∉ p_A.asIdeal := by
      by_contra! hall
      have h1_mem : (1 : A) ∈ p_A.asIdeal := by
        rw [← hsum_idem]
        exact Ideal.sum_mem p_A.asIdeal (fun i _ => hall i)
      exact p_A.isPrime.one_notMem h1_mem
    obtain ⟨i₀, ha₀_not_mem⟩ := hex_i₀
    let a₀ : A := u_idem i₀
    let L : Type u := Ai i₀
    let _ : Field L := hFieldAi i₀
    let _ : Algebra K L := hAlgAi i₀
    have hFinL : Module.Finite K L := (hFinSepAi i₀).1
    have hSepL : Algebra.IsSeparable K L := (hFinSepAi i₀).2
    have hEt_KL : Algebra.Etale K L :=
      @Algebra.Etale.mk K L _ _ _ (Algebra.FormallyEtale.of_isSeparable K L)
        (Algebra.FinitePresentation.of_finiteType.mp inferInstance)
    let π₀ : A →ₐ[K] L := (Pi.evalAlgHom K Ai i₀).comp e_prod.toAlgHom
    let j_L : AlgebraicGeometry.Spec (CommRingCat.of L) ⟶ Y.left :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom π₀.toRingHom) ≫ hUy.fromSpec
    have hj_L_over : j_L ≫ Y.hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K L)) := by
      calc
        j_L ≫ Y.hom
            = AlgebraicGeometry.Spec.map (CommRingCat.ofHom π₀.toRingHom) ≫ mor_AK := by
              simp [j_L, mor_AK, Category.assoc]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom π₀.toRingHom) ≫
              AlgebraicGeometry.Spec.map ρ_KA_cat := by
              rw [← hmap_ρ]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K L)) := by
              rw [← AlgebraicGeometry.Spec.map_comp]
              congr 1
              apply CommRingCat.hom_ext
              ext k
              exact π₀.commutes k
    let pt_L : ↥(AlgebraicGeometry.Spec (CommRingCat.of L)) := default
    have hj_L_pt : j_L.base pt_L = y := by
      have hpt_A : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π₀.toRingHom)).base pt_L = p_A := by
        apply PrimeSpectrum.ext
        ext a
        change π₀ a ∈ pt_L.asIdeal ↔ a ∈ p_A.asIdeal
        have hpt_zero : π₀ a ∈ pt_L.asIdeal ↔ π₀ a = 0 := by
          constructor
          · intro hmem
            by_contra hne
            have h1_in : (1 : L) ∈ pt_L.asIdeal := by
              have hm := pt_L.asIdeal.mul_mem_right (π₀ a)⁻¹ hmem
              rwa [mul_inv_cancel₀ hne] at hm
            exact pt_L.isPrime.one_notMem h1_in
          · intro h0
            rw [h0]
            exact pt_L.asIdeal.zero_mem
        rw [hpt_zero]
        have ha₀_idem : a₀ * (1 - a₀) = 0 := by
          apply e_prod.injective
          rw [map_mul, map_sub, map_one, map_zero]
          ext j
          dsimp [a₀, u_idem]
          rw [e_prod.apply_symm_apply]
          by_cases hj : j = i₀ <;> simp [hj]
        have h1_sub_mem : 1 - a₀ ∈ p_A.asIdeal := by
          rcases p_A.isPrime.mem_or_mem (ha₀_idem ▸ p_A.asIdeal.zero_mem) with hmem | hmem
          · exact False.elim (ha₀_not_mem hmem)
          · exact hmem
        constructor
        · intro hπ0
          have ha_mul0 : a * a₀ = 0 := by
            apply e_prod.injective
            rw [map_mul, map_zero]
            ext j
            dsimp [a₀, u_idem]
            rw [e_prod.apply_symm_apply]
            by_cases hj : j = i₀
            · subst hj
              simpa [π₀] using hπ0
            · simp [hj]
          have heq_a : a = a * (1 - a₀) := by
            calc
              a = a * a₀ + a * (1 - a₀) := by ring
              _ = 0 + a * (1 - a₀) := by rw [ha_mul0]
              _ = a * (1 - a₀) := zero_add _
          rw [heq_a]
          exact p_A.asIdeal.mul_mem_left a h1_sub_mem
        · intro ha_mem
          by_contra hπ_ne
          let b_inv : A := e_prod.symm (fun j => if h : j = i₀ then h ▸ (π₀ a)⁻¹ else 0)
          have hab : a * b_inv = a₀ := by
            apply e_prod.injective
            rw [map_mul]
            ext j
            dsimp [b_inv, a₀, u_idem]
            rw [e_prod.apply_symm_apply, e_prod.apply_symm_apply]
            by_cases hj : j = i₀
            · subst hj
              simp only [↓reduceDIte]
              exact mul_inv_cancel₀ hπ_ne
            · simp [hj]
          have hmem_a₀ : a₀ ∈ p_A.asIdeal := by
            have hm := p_A.asIdeal.mul_mem_right b_inv ha_mem
            rwa [hab] at hm
          exact ha₀_not_mem hmem_a₀
      calc
        j_L.base pt_L
            = hUy.fromSpec.base
                ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom π₀.toRingHom)).base pt_L) := rfl
        _ = hUy.fromSpec.base p_y := by rw [hpt_A]
        _ = y := hpy

    
    obtain ⟨f, _hf_ne, C, _, _, _, hEt_Bf_C, _, hFracCL, ι_f, hι_f_B, ⟨e_CK, he_CK_C, _he_CK_Bf⟩⟩ :=
      hSpreadEtaleAlg B K L
    let B_f := Localization.Away f
    let _ : Algebra B_f K := ι_f.toRingHom.toAlgebra
    let X_Bf := AlgebraicGeometry.Spec (CommRingCat.of B_f)
    let X_K := AlgebraicGeometry.Spec (CommRingCat.of K)
    let X_C := AlgebraicGeometry.Spec (CommRingCat.of C)
    let X_L := AlgebraicGeometry.Spec (CommRingCat.of L)
    have _ : AlgebraicGeometry.IsOpenImmersion
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B B_f))) :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization f
    let j_Bf : X_Bf ⟶ V :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B B_f)) ≫ hW₀.fromSpec
    have _ : AlgebraicGeometry.IsOpenImmersion j_Bf := by
      dsimp [j_Bf]
      infer_instance
    let p_KBf : X_K ⟶ X_Bf :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B_f K))
    let p_CBf : X_C ⟶ X_Bf :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B_f C))
    have _ : AlgebraicGeometry.Etale p_CBf :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
        (RingHom.etale_algebraMap.mpr hEt_Bf_C)
    let p_C : X_C ⟶ V := p_CBf ≫ j_Bf
    have hEt_pC : AlgebraicGeometry.Etale p_C := by
      dsimp [p_C]
      infer_instance
    let W : V.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ p_C hEt_pC
    have hIntW : AlgebraicGeometry.IsIntegral W.left := by
      change AlgebraicGeometry.IsIntegral X_C
      infer_instance
    have hg_Bf : g = p_KBf ≫ j_Bf := by
      have hgerm_eq : V.presheaf.germ W₀ η hη =
          CommRingCat.ofHom (algebraMap B B_f) ≫ CommRingCat.ofHom (algebraMap B_f K) := by
        apply CommRingCat.hom_ext
        ext b
        exact (hι_f_B b).symm
      rw [hg_fromSpec, hgerm_eq, AlgebraicGeometry.Spec.map_comp, Category.assoc]
    let PB_W : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback p_C g
    let φ_fwd : CategoryTheory.Limits.pullback p_KBf p_CBf ⟶ PB_W :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.snd p_KBf p_CBf)
        (CategoryTheory.Limits.pullback.fst p_KBf p_CBf)
        (by
          calc
            CategoryTheory.Limits.pullback.snd p_KBf p_CBf ≫ p_C
                = (CategoryTheory.Limits.pullback.snd p_KBf p_CBf ≫ p_CBf) ≫ j_Bf :=
                  (Category.assoc _ _ _).symm
            _ = (CategoryTheory.Limits.pullback.fst p_KBf p_CBf ≫ p_KBf) ≫ j_Bf := by
                  rw [CategoryTheory.Limits.pullback.condition]
            _ = CategoryTheory.Limits.pullback.fst p_KBf p_CBf ≫ g := by
                  rw [Category.assoc, ← hg_Bf])
    have hcond_bwd :
        CategoryTheory.Limits.pullback.snd p_C g ≫ p_KBf =
          CategoryTheory.Limits.pullback.fst p_C g ≫ p_CBf := by
      rw [← CategoryTheory.cancel_mono j_Bf]
      calc
        (CategoryTheory.Limits.pullback.snd p_C g ≫ p_KBf) ≫ j_Bf
            = CategoryTheory.Limits.pullback.snd p_C g ≫ g := by rw [Category.assoc, ← hg_Bf]
        _ = CategoryTheory.Limits.pullback.fst p_C g ≫ p_C :=
              CategoryTheory.Limits.pullback.condition.symm
        _ = (CategoryTheory.Limits.pullback.fst p_C g ≫ p_CBf) ≫ j_Bf :=
              (Category.assoc _ _ _).symm
    let φ_bwd : PB_W ⟶ CategoryTheory.Limits.pullback p_KBf p_CBf :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.snd p_C g)
        (CategoryTheory.Limits.pullback.fst p_C g)
        hcond_bwd
    have hφ_hom_inv : φ_fwd ≫ φ_bwd = 𝟙 _ := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          CategoryTheory.Limits.pullback.lift_snd, Category.id_comp]
      · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          CategoryTheory.Limits.pullback.lift_fst, Category.id_comp]
    have hφ_inv_hom : φ_bwd ≫ φ_fwd = 𝟙 PB_W := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          CategoryTheory.Limits.pullback.lift_snd, Category.id_comp]
      · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          CategoryTheory.Limits.pullback.lift_fst, Category.id_comp]
    let iso_pb_W : CategoryTheory.Limits.pullback p_KBf p_CBf ≅ (B_g.obj W).left :=
      { hom := φ_fwd
        inv := φ_bwd
        hom_inv_id := hφ_hom_inv
        inv_hom_id := hφ_inv_hom }
    let iso_Spec_CKL : X_L ≅ AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct B_f K C)) :=
      { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_CK.toRingHom)
        inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_CK.symm.toRingHom)
        hom_inv_id := by
          rw [← AlgebraicGeometry.Spec.map_comp]
          convert AlgebraicGeometry.Spec.map_id (CommRingCat.of L)
          exact CommRingCat.hom_ext (RingHom.ext fun z => e_CK.apply_symm_apply z)
        inv_hom_id := by
          rw [← AlgebraicGeometry.Spec.map_comp]
          convert AlgebraicGeometry.Spec.map_id (CommRingCat.of (TensorProduct B_f K C))
          exact CommRingCat.hom_ext (RingHom.ext fun z => e_CK.symm_apply_apply z) }
    let ψ_L : X_L ≅ (B_g.obj W).left :=
      iso_Spec_CKL.trans ((AlgebraicGeometry.pullbackSpecIso B_f K C).symm.trans iso_pb_W)
    have hψ_fst : ψ_L.hom ≫ CategoryTheory.Limits.pullback.fst W.hom g =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap C L)) := by
      change (iso_Spec_CKL.hom ≫ ((AlgebraicGeometry.pullbackSpecIso B_f K C).inv ≫ φ_fwd)) ≫
          CategoryTheory.Limits.pullback.fst p_C g = _
      rw [Category.assoc, Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
        AlgebraicGeometry.pullbackSpecIso_inv_snd, ← AlgebraicGeometry.Spec.map_comp]
      congr 1
      exact CommRingCat.hom_ext (RingHom.ext fun c => he_CK_C c)
    have hψ_snd : ψ_L.hom ≫ CategoryTheory.Limits.pullback.snd W.hom g =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K L)) := by
      change (iso_Spec_CKL.hom ≫ ((AlgebraicGeometry.pullbackSpecIso B_f K C).inv ≫ φ_fwd)) ≫
          CategoryTheory.Limits.pullback.snd p_C g = _
      rw [Category.assoc, Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
        AlgebraicGeometry.pullbackSpecIso_inv_fst', ← AlgebraicGeometry.Spec.map_comp]
      congr 1
      exact CommRingCat.hom_ext (RingHom.ext fun k => e_CK.commutes k)

    
    let η_W : ↥X_C := genericPoint ↥X_C
    let K_W_ring : CommRingCat.{u} := X_C.presheaf.stalk η_W
    let K_W : Type u := ↥K_W_ring
    let hTopC : AlgebraicGeometry.IsAffineOpen (⊤ : X_C.Opens) :=
      AlgebraicGeometry.isAffineOpen_top X_C
    let γ_CW_cat : CommRingCat.of C ⟶ K_W_ring :=
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of C)).inv ≫
        X_C.presheaf.germ ⊤ η_W trivial
    let _ : Algebra C K_W := γ_CW_cat.hom.toAlgebra
    have hFracCKW : IsFractionRing C K_W := by
      let C_top : Type u := ↥(X_C.presheaf.obj (Opposite.op (⊤ : X_C.Opens)))
      let _ : Algebra C_top K_W := (X_C.presheaf.germ ⊤ η_W trivial).hom.toAlgebra
      obtain ⟨_, hFracTop⟩ := hFracHelper X_C ⊤ hTopC trivial
      let e_Ctop : C ≃+* C_top :=
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of C)).symm.commRingCatIsoToRingEquiv
      have hmap_eq : ∀ c : C, algebraMap C K_W c = algebraMap C_top K_W (e_Ctop c) := fun _ => rfl
      exact
        { map_units := fun s_c => by
            have hs0 : e_Ctop s_c ≠ 0 :=
              fun h0 => nonZeroDivisors.ne_zero s_c.2
                (e_Ctop.injective (h0.trans e_Ctop.map_zero.symm))
            rw [hmap_eq]
            exact @IsLocalization.map_units _ _ (nonZeroDivisors C_top) K_W _ _ hFracTop
              ⟨e_Ctop s_c, mem_nonZeroDivisors_of_ne_zero hs0⟩
          surj := fun z => by
            obtain ⟨⟨b, s_b⟩, hbs⟩ :=
              @IsLocalization.surj _ _ (nonZeroDivisors C_top) K_W _ _ hFracTop z
            have hs_pre : e_Ctop.symm s_b ≠ 0 :=
              fun h0 => nonZeroDivisors.ne_zero s_b.2
                (e_Ctop.symm.injective (h0.trans e_Ctop.symm.map_zero.symm))
            refine ⟨⟨e_Ctop.symm b, ⟨e_Ctop.symm s_b, mem_nonZeroDivisors_of_ne_zero hs_pre⟩⟩, ?_⟩
            rw [hmap_eq, hmap_eq, e_Ctop.apply_symm_apply, e_Ctop.apply_symm_apply]
            exact hbs
          exists_of_eq := fun {c₁ c₂} hc => by
            have hInj : Function.Injective (algebraMap C_top K_W) :=
              @IsFractionRing.injective C_top _ K_W _ _ hFracTop
            exact ⟨1, by simp [e_Ctop.injective (hInj hc)]⟩ }
    let e_WL : K_W ≃ₐ[C] L := IsLocalization.algEquiv (nonZeroDivisors C) K_W L
    let isoKW : K_W_ring ≅ CommRingCat.of K_W :=
      { hom := CommRingCat.ofHom (RingHom.id K_W)
        inv := CommRingCat.ofHom (RingHom.id K_W)
        hom_inv_id := rfl
        inv_hom_id := rfl }
    let iso_Spec_KW : AlgebraicGeometry.Spec K_W_ring ≅
        AlgebraicGeometry.Spec (CommRingCat.of K_W) :=
      { hom := AlgebraicGeometry.Spec.map isoKW.inv
        inv := AlgebraicGeometry.Spec.map isoKW.hom
        hom_inv_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, isoKW.hom_inv_id, AlgebraicGeometry.Spec.map_id]
        inv_hom_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, isoKW.inv_hom_id, AlgebraicGeometry.Spec.map_id] }
    let iso_Spec_KWL : AlgebraicGeometry.Spec (CommRingCat.of K_W) ≅ X_L :=
      { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_WL.symm.toRingHom)
        inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_WL.toRingHom)
        hom_inv_id := by
          rw [← AlgebraicGeometry.Spec.map_comp]
          convert AlgebraicGeometry.Spec.map_id (CommRingCat.of K_W)
          exact CommRingCat.hom_ext (RingHom.ext fun z => e_WL.symm_apply_apply z)
        inv_hom_id := by
          rw [← AlgebraicGeometry.Spec.map_comp]
          convert AlgebraicGeometry.Spec.map_id (CommRingCat.of L)
          exact CommRingCat.hom_ext (RingHom.ext fun z => e_WL.apply_symm_apply z) }
    let θ : AlgebraicGeometry.Spec K_W_ring ≅ (B_g.obj W).left :=
      iso_Spec_KW.trans (iso_Spec_KWL.trans ψ_L)
    have hθ_fst : θ.hom ≫ CategoryTheory.Limits.pullback.fst W.hom g =
        X_C.fromSpecStalk η_W := by
      have hfrom_top : X_C.fromSpecStalk η_W = AlgebraicGeometry.Spec.map γ_CW_cat := by
        rw [← hTopC.fromSpecStalk_eq_fromSpecStalk (x := η_W) trivial]
        change AlgebraicGeometry.Spec.map (X_C.presheaf.germ ⊤ η_W trivial) ≫ hTopC.fromSpec = _
        rw [AlgebraicGeometry.IsAffineOpen.fromSpec_top, AlgebraicGeometry.Scheme.isoSpec_Spec_inv,
          ← AlgebraicGeometry.Spec.map_comp]
      have h1 :
          (iso_Spec_KW.hom ≫ (iso_Spec_KWL.hom ≫ ψ_L.hom)) ≫
              CategoryTheory.Limits.pullback.fst W.hom g =
            iso_Spec_KW.hom ≫
              (iso_Spec_KWL.hom ≫ (ψ_L.hom ≫ CategoryTheory.Limits.pullback.fst W.hom g)) :=
        (Category.assoc _ _ _).trans (congrArg (fun k => iso_Spec_KW.hom ≫ k) (Category.assoc _ _ _))
      refine h1.trans ?_
      rw [hψ_fst, hfrom_top]
      change AlgebraicGeometry.Spec.map isoKW.inv ≫
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_WL.symm.toRingHom) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap C L))) =
        AlgebraicGeometry.Spec.map γ_CW_cat
      rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
      congr 1
      apply CommRingCat.hom_ext
      ext c
      change e_WL.symm (algebraMap C L c) = γ_CW_cat.hom c
      rw [e_WL.symm.commutes]
      rfl
    let h_y : Quiver.Hom (B_g.obj W) Y :=
      CategoryTheory.MorphismProperty.Over.homMk (ψ_L.inv ≫ j_L)
        (by
          refine (Category.assoc ψ_L.inv j_L Y.hom).trans ?_
          rw [hj_L_over, ← hψ_snd]
          exact (Category.assoc ψ_L.inv ψ_L.hom _).symm.trans
            ((congrArg (fun k => k ≫ _) ψ_L.inv_hom_id).trans (Category.id_comp _)))
    let z₀ : ↥(B_g.obj W).left := ψ_L.hom.base pt_L
    have hz₀ : h_y.left.base z₀ = y := by
      change (ψ_L.inv ≫ j_L).base (ψ_L.hom.base pt_L) = y
      change ((ψ_L.hom ≫ ψ_L.inv) ≫ j_L).base pt_L = y
      rw [ψ_L.hom_inv_id, Category.id_comp]
      exact hj_L_pt
    exact ⟨W, hIntW, θ, h_y, z₀, hθ_fst, hz₀⟩

  
  have hSpreadArrow :
      ∀ (W U₁ U₂ : V.Etale) [AlgebraicGeometry.IsIntegral W.left]
        (θ : AlgebraicGeometry.Spec (W.left.presheaf.stalk (genericPoint ↥W.left)) ≅
          (B_g.obj W).left),
        θ.hom ≫ CategoryTheory.Limits.pullback.fst W.hom g =
          W.left.fromSpecStalk (genericPoint ↥W.left) →
        ∀ (φ : Quiver.Hom (B_g.obj U₁) (B_g.obj U₂))
          (h_y : Quiver.Hom (B_g.obj W) (B_g.obj U₁))
          (z₀ : ↥(B_g.obj W).left),
          ∃ (O_et : V.Etale) (u : Quiver.Hom O_et U₁) (v : Quiver.Hom O_et U₂)
            (z₁ : ↥(B_g.obj O_et).left),
            B_g.map u ≫ φ = B_g.map v ∧
            (B_g.map u).left.base z₁ = h_y.left.base z₀ := by
    intro W U₁ U₂ hIntW_in θ hθ φ h_y z₀
    let W_sch : AlgebraicGeometry.Scheme.{u} := W.left
    let U₁_sch : AlgebraicGeometry.Scheme.{u} := U₁.left
    let U₂_sch : AlgebraicGeometry.Scheme.{u} := U₂.left
    let w_hom : W_sch ⟶ V := W.hom
    let u₁_hom : U₁_sch ⟶ V := U₁.hom
    let u₂_hom : U₂_sch ⟶ V := U₂.hom
    have _ : AlgebraicGeometry.IsIntegral W_sch := hIntW_in
    let η_W : ↥W_sch := genericPoint ↥W_sch
    have _ : W_sch.IsGermInjective := inferInstance
    have _ : W_sch.IsGermInjectiveAt η_W := inferInstance
    have _ : AlgebraicGeometry.Etale w_hom := W.prop
    have _ : AlgebraicGeometry.Etale u₁_hom := U₁.prop
    have _ : AlgebraicGeometry.Etale u₂_hom := U₂.prop
    let hy_left : CategoryTheory.Limits.pullback w_hom g ⟶
        CategoryTheory.Limits.pullback u₁_hom g := h_y.left
    let φ_left : CategoryTheory.Limits.pullback u₁_hom g ⟶
        CategoryTheory.Limits.pullback u₂_hom g := φ.left
    let θ_hom : AlgebraicGeometry.Spec (W_sch.presheaf.stalk η_W) ⟶
        CategoryTheory.Limits.pullback w_hom g := θ.hom
    let θ_inv : CategoryTheory.Limits.pullback w_hom g ⟶
        AlgebraicGeometry.Spec (W_sch.presheaf.stalk η_W) := θ.inv
    have hθ' : θ_hom ≫ CategoryTheory.Limits.pullback.fst w_hom g = W_sch.fromSpecStalk η_W := hθ
    have hw_hy : hy_left ≫ CategoryTheory.Limits.pullback.snd u₁_hom g =
        CategoryTheory.Limits.pullback.snd w_hom g := h_y.w
    have hw_φ : φ_left ≫ CategoryTheory.Limits.pullback.snd u₂_hom g =
        CategoryTheory.Limits.pullback.snd u₁_hom g := φ.w
    let α₁ : AlgebraicGeometry.Spec (W_sch.presheaf.stalk η_W) ⟶ U₁_sch :=
      θ_hom ≫ hy_left ≫ CategoryTheory.Limits.pullback.fst u₁_hom g
    let α₂ : AlgebraicGeometry.Spec (W_sch.presheaf.stalk η_W) ⟶ U₂_sch :=
      θ_hom ≫ hy_left ≫ φ_left ≫ CategoryTheory.Limits.pullback.fst u₂_hom g
    have hα₁_over : α₁ ≫ u₁_hom = W_sch.fromSpecStalk η_W ≫ w_hom := by
      simp only [α₁, Category.assoc, CategoryTheory.Limits.pullback.condition]
      rw [← Category.assoc hy_left, hw_hy, ← CategoryTheory.Limits.pullback.condition,
        ← Category.assoc θ_hom, hθ']
    have hα₂_over : α₂ ≫ u₂_hom = W_sch.fromSpecStalk η_W ≫ w_hom := by
      simp only [α₂, Category.assoc, CategoryTheory.Limits.pullback.condition]
      rw [← Category.assoc φ_left, hw_φ, ← Category.assoc hy_left, hw_hy,
        ← CategoryTheory.Limits.pullback.condition, ← Category.assoc θ_hom, hθ']
    obtain ⟨O₁, hη₁, f₁, hf₁_stalk, hf₁_over⟩ :=
      AlgebraicGeometry.spread_out_of_isGermInjective' w_hom u₁_hom α₁ hα₁_over
    obtain ⟨O₂, hη₂, f₂, hf₂_stalk, hf₂_over⟩ :=
      AlgebraicGeometry.spread_out_of_isGermInjective' w_hom u₂_hom α₂ hα₂_over
    let O : W_sch.Opens := O₁ ⊓ O₂
    have hη_O : η_W ∈ O := ⟨hη₁, hη₂⟩
    have hEt_O : AlgebraicGeometry.Etale (O.ι ≫ w_hom) := inferInstance
    let O_et : V.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (O.ι ≫ w_hom) hEt_O
    let ι_O : Quiver.Hom O_et W := CategoryTheory.MorphismProperty.Over.homMk O.ι rfl
    let u_mor : O.toScheme ⟶ U₁_sch := W_sch.homOfLE inf_le_left ≫ f₁
    let v_mor : O.toScheme ⟶ U₂_sch := W_sch.homOfLE inf_le_right ≫ f₂
    have hu_over : u_mor ≫ u₁_hom = O.ι ≫ w_hom := by
      dsimp [u_mor]
      rw [Category.assoc, hf₁_over, AlgebraicGeometry.Scheme.homOfLE_ι_assoc]
    have hv_over : v_mor ≫ u₂_hom = O.ι ≫ w_hom := by
      dsimp [v_mor]
      rw [Category.assoc, hf₂_over, AlgebraicGeometry.Scheme.homOfLE_ι_assoc]
    let u : Quiver.Hom O_et U₁ :=
      CategoryTheory.MorphismProperty.Over.homMk u_mor hu_over
    let v : Quiver.Hom O_et U₂ :=
      CategoryTheory.MorphismProperty.Over.homMk v_mor hv_over
    have hu_stalk : O.fromSpecStalkOfMem η_W hη_O ≫ u_mor = α₁ := by
      have hres₁ : O.fromSpecStalkOfMem η_W hη_O ≫ W_sch.homOfLE inf_le_left =
          O₁.fromSpecStalkOfMem η_W hη₁ := by
        rw [← CategoryTheory.cancel_mono O₁.ι, Category.assoc,
          AlgebraicGeometry.Scheme.homOfLE_ι, O.fromSpecStalkOfMem_ι, O₁.fromSpecStalkOfMem_ι]
      dsimp [u_mor]
      rw [← Category.assoc, hres₁, ← hf₁_stalk]
    have hv_stalk : O.fromSpecStalkOfMem η_W hη_O ≫ v_mor = α₂ := by
      have hres₂ : O.fromSpecStalkOfMem η_W hη_O ≫ W_sch.homOfLE inf_le_right =
          O₂.fromSpecStalkOfMem η_W hη₂ := by
        rw [← CategoryTheory.cancel_mono O₂.ι, Category.assoc,
          AlgebraicGeometry.Scheme.homOfLE_ι, O.fromSpecStalkOfMem_ι, O₂.fromSpecStalkOfMem_ι]
      dsimp [v_mor]
      rw [← Category.assoc, hres₂, ← hf₂_stalk]
    let PB_O : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback (O.ι ≫ w_hom) g
    let σ_O : AlgebraicGeometry.Spec (W_sch.presheaf.stalk η_W) ⟶ PB_O :=
      CategoryTheory.Limits.pullback.lift
        (O.fromSpecStalkOfMem η_W hη_O)
        (θ_hom ≫ CategoryTheory.Limits.pullback.snd w_hom g)
        (by
          rw [← Category.assoc, O.fromSpecStalkOfMem_ι, ← hθ', Category.assoc,
            CategoryTheory.Limits.pullback.condition, Category.assoc])
    let ι_O_pb : PB_O ⟶ CategoryTheory.Limits.pullback w_hom g := (B_g.map ι_O).left
    have hιO_fst : ι_O_pb ≫ CategoryTheory.Limits.pullback.fst w_hom g =
        CategoryTheory.Limits.pullback.fst (O.ι ≫ w_hom) g ≫ O.ι :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hιO_snd : ι_O_pb ≫ CategoryTheory.Limits.pullback.snd w_hom g =
        CategoryTheory.Limits.pullback.snd (O.ι ≫ w_hom) g :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    let π_W : PB_O ⟶ AlgebraicGeometry.Spec (W_sch.presheaf.stalk η_W) :=
      ι_O_pb ≫ θ_inv
    have hθ_inv_hom : θ_inv ≫ θ_hom = 𝟙 _ := θ.inv_hom_id
    have hπσ_id : π_W ≫ σ_O = 𝟙 PB_O := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [← CategoryTheory.cancel_mono O.ι]
        simp only [π_W, σ_O, Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          Category.id_comp, O.fromSpecStalkOfMem_ι, ← hθ']
        rw [← Category.assoc θ_inv, hθ_inv_hom, Category.id_comp, hιO_fst]
      · simp only [π_W, σ_O, Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          Category.id_comp]
        rw [← Category.assoc θ_inv, hθ_inv_hom, Category.id_comp, hιO_snd]
    let Bu_pb : PB_O ⟶ CategoryTheory.Limits.pullback u₁_hom g := (B_g.map u).left
    let Bv_pb : PB_O ⟶ CategoryTheory.Limits.pullback u₂_hom g := (B_g.map v).left
    have hBu_fst : Bu_pb ≫ CategoryTheory.Limits.pullback.fst u₁_hom g =
        CategoryTheory.Limits.pullback.fst (O.ι ≫ w_hom) g ≫ u_mor :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hBu_snd : Bu_pb ≫ CategoryTheory.Limits.pullback.snd u₁_hom g =
        CategoryTheory.Limits.pullback.snd (O.ι ≫ w_hom) g :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hBv_fst : Bv_pb ≫ CategoryTheory.Limits.pullback.fst u₂_hom g =
        CategoryTheory.Limits.pullback.fst (O.ι ≫ w_hom) g ≫ v_mor :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hBv_snd : Bv_pb ≫ CategoryTheory.Limits.pullback.snd u₂_hom g =
        CategoryTheory.Limits.pullback.snd (O.ι ≫ w_hom) g :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hσ_u : σ_O ≫ Bu_pb = θ_hom ≫ hy_left := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · simp only [Category.assoc, hBu_fst]
        rw [← Category.assoc σ_O, CategoryTheory.Limits.pullback.lift_fst, hu_stalk]
      · simp only [Category.assoc, hBu_snd, hw_hy]
        exact CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hσ_uv : σ_O ≫ (Bu_pb ≫ φ_left) = σ_O ≫ Bv_pb := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · simp only [Category.assoc, hBv_fst]
        rw [← Category.assoc σ_O Bu_pb, hσ_u, Category.assoc]
        change α₂ = σ_O ≫ CategoryTheory.Limits.pullback.fst (O.ι ≫ w_hom) g ≫ v_mor
        rw [← Category.assoc σ_O, CategoryTheory.Limits.pullback.lift_fst, hv_stalk]
      · simp only [Category.assoc, hw_φ, hBu_snd, hBv_snd]
    have huv : B_g.map u ≫ φ = B_g.map v := by
      apply CategoryTheory.MorphismProperty.Over.Hom.ext
      change Bu_pb ≫ φ_left = Bv_pb
      calc
        Bu_pb ≫ φ_left = 𝟙 PB_O ≫ (Bu_pb ≫ φ_left) := (Category.id_comp _).symm
        _ = π_W ≫ (σ_O ≫ (Bu_pb ≫ φ_left)) := by rw [← hπσ_id, Category.assoc]
        _ = π_W ≫ (σ_O ≫ Bv_pb) := by rw [hσ_uv]
        _ = Bv_pb := by rw [← Category.assoc, hπσ_id, Category.id_comp]
    let z₁ : ↥(B_g.obj O_et).left := σ_O.base (θ_inv.base z₀)
    have hz₁ : (B_g.map u).left.base z₁ = h_y.left.base z₀ := by
      change (σ_O ≫ Bu_pb).base (θ_inv.base z₀) = hy_left.base z₀
      rw [hσ_u]
      change ((θ_inv ≫ θ_hom) ≫ hy_left).base z₀ = hy_left.base z₀
      rw [hθ_inv_hom, Category.id_comp]
    exact ⟨O_et, u, v, z₁, huv, hz₁⟩

  
  have _ : B_g.IsCoverDense S_η.smallEtaleTopology := by
    refine CategoryTheory.Functor.IsCoverDense.mk ?_
    intro Y
    refine (hMemTopo S_η Y _).mpr ?_
    intro y
    obtain ⟨W, _, _, h_y, z₀, _, hz₀⟩ := hPointModel Y y
    have hEt_hy : AlgebraicGeometry.Etale h_y.left := by
      have hcomp : AlgebraicGeometry.Etale (h_y.left ≫ Y.hom) :=
        Eq.mpr (congrArg AlgebraicGeometry.Etale (CategoryTheory.MorphismProperty.Over.w h_y))
          (B_g.obj W).prop
      exact @CategoryTheory.MorphismProperty.of_postcomp _ _
        (@AlgebraicGeometry.Etale) (@AlgebraicGeometry.Etale) _ _ _ _ h_y.left Y.hom Y.prop hcomp
    exact ⟨B_g.obj W, h_y, z₀, ⟨W, 𝟙 (B_g.obj W), h_y, Category.id_comp h_y⟩, hEt_hy, hz₀⟩

  have _ : B_g.IsLocallyFull S_η.smallEtaleTopology := by
    refine CategoryTheory.Functor.IsLocallyFull.mk ?_
    intro U₁ U₂ φ
    refine (hMemTopo S_η (B_g.obj U₁) _).mpr ?_
    intro y
    obtain ⟨W, hIntW, θ, h_y, z₀, hθ, hz₀⟩ := hPointModel (B_g.obj U₁) y
    let _ := hIntW
    obtain ⟨O_et, u, v, z₁, huv, hz₁⟩ := hSpreadArrow W U₁ U₂ θ hθ φ h_y z₀
    have hEt_Bu : AlgebraicGeometry.Etale (B_g.map u).left := by
      have hcomp : AlgebraicGeometry.Etale ((B_g.map u).left ≫ (B_g.obj U₁).hom) :=
        Eq.mpr (congrArg AlgebraicGeometry.Etale
          (CategoryTheory.MorphismProperty.Over.w (B_g.map u))) (B_g.obj O_et).prop
      exact @CategoryTheory.MorphismProperty.of_postcomp _ _
        (@AlgebraicGeometry.Etale) (@AlgebraicGeometry.Etale) _ _ _ _
        (B_g.map u).left (B_g.obj U₁).hom (B_g.obj U₁).prop hcomp
    refine ⟨B_g.obj O_et, B_g.map u, z₁, ?_, hEt_Bu, hz₁.trans hz₀⟩
    exact CategoryTheory.Sieve.image_mem_functorPushforward B_g (B_g.imageSieve φ)
      ⟨v, by simp [huv]⟩

  let _ : P_push.Full :=
    CategoryTheory.Functor.IsCoverDense.full_sheafPushforwardContinuous
      V.smallEtaleTopology S_η.smallEtaleTopology B_g
  have _ : P_push.Faithful :=
    CategoryTheory.Functor.IsCoverDense.faithful_sheafPushforwardContinuous
      V.smallEtaleTopology S_η.smallEtaleTopology B_g
  have _ : CategoryTheory.IsIso adj_g.counit :=
    CategoryTheory.Adjunction.counit_isIso_of_R_fully_faithful adj_g
  let u_ℱ := adj_g.unit.app ℱ
  have htri : P_pull.map u_ℱ ≫ adj_g.counit.app (P_pull.obj ℱ) = 𝟙 (P_pull.obj ℱ) :=
    adj_g.left_triangle_components ℱ
  have hIso_map_u : CategoryTheory.IsIso (P_pull.map u_ℱ) := by
    have hcomp : P_pull.map u_ℱ = CategoryTheory.inv (adj_g.counit.app (P_pull.obj ℱ)) := by
      calc
        P_pull.map u_ℱ
            = P_pull.map u_ℱ ≫
                (adj_g.counit.app (P_pull.obj ℱ) ≫
                  CategoryTheory.inv (adj_g.counit.app (P_pull.obj ℱ))) := by
              rw [CategoryTheory.IsIso.hom_inv_id, Category.comp_id]
        _ = (P_pull.map u_ℱ ≫ adj_g.counit.app (P_pull.obj ℱ)) ≫
              CategoryTheory.inv (adj_g.counit.app (P_pull.obj ℱ)) :=
              (Category.assoc _ _ _).symm
        _ = CategoryTheory.inv (adj_g.counit.app (P_pull.obj ℱ)) :=
              (congrArg (fun k => k ≫ _) htri).trans (Category.id_comp _)
    rw [hcomp]
    infer_instance
  have hZero_ker : CategoryTheory.Limits.IsZero (P_pull.obj (CategoryTheory.Limits.kernel u_ℱ)) :=
    (CategoryTheory.Limits.isZero_kernel_of_mono (P_pull.map u_ℱ)).of_iso
      (CategoryTheory.Limits.PreservesKernel.iso P_pull u_ℱ)
  have hZero_coker : CategoryTheory.Limits.IsZero (P_pull.obj (CategoryTheory.Limits.cokernel u_ℱ)) :=
    (CategoryTheory.Limits.isZero_cokernel_of_epi (P_pull.map u_ℱ)).of_iso
      (CategoryTheory.Limits.PreservesCokernel.iso P_pull u_ℱ)

  
  let Ω : Type u := AlgebraicClosure ↥(V.residueField η)
  let S_Ω : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of Ω)
  let gx_η : Quiver.Hom S_Ω V :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥(V.residueField η) Ω)) ≫
      V.fromSpecResidueField η
  let f_Ω : K_ring ⟶ CommRingCat.of Ω :=
    V.residue η ≫ CommRingCat.ofHom (algebraMap ↥(V.residueField η) Ω)
  have _ : IsLocalHom f_Ω.hom :=
    { map_nonunit := fun a ha => by
        obtain ⟨u, hu⟩ := ha
        refine ⟨Units.mk0 a (fun h0 => u.ne_zero ?_), rfl⟩
        rw [hu, h0, map_zero] }
  let g_0 : Quiver.Hom S_Ω S_η := AlgebraicGeometry.Spec.map f_Ω
  have hg_0 : g_0 ≫ g = gx_η := by
    have hdesc : AlgebraicGeometry.Scheme.descResidueField f_Ω =
        CommRingCat.ofHom (algebraMap ↥(V.residueField η) Ω) := by
      have hres := AlgebraicGeometry.Scheme.residue_descResidueField (X := V) (x := η) f_Ω
      ext r
      obtain ⟨k₀, rfl⟩ := AlgebraicGeometry.Scheme.residue_surjective V η r
      exact congrArg (fun φ : K_ring ⟶ CommRingCat.of Ω => φ.hom k₀) hres
    rw [← AlgebraicGeometry.Scheme.descResidueField_fromSpecResidueField V f_Ω, hdesc]

  let fiberFun : ∀ (S : AlgebraicGeometry.Scheme.{u}),
      Quiver.Hom S_Ω S → CategoryTheory.Functor S.Etale (Type u) :=
    fun S p =>
      CategoryTheory.Functor.comp
        (CategoryTheory.MorphismProperty.Over.forget (@AlgebraicGeometry.Etale) ⊤ S)
        (CategoryTheory.coyoneda.obj (Opposite.op (CategoryTheory.Over.mk p)))

  have hLiftGeomPt :
      ∀ (S : AlgebraicGeometry.Scheme.{u}) (p : Quiver.Hom S_Ω S)
        (U : S.Etale) (R : CategoryTheory.Sieve U),
        R ∈ S.smallEtaleTopology U →
        ∀ x : (fiberFun S p).obj U,
          ∃ (Z : S.Etale) (f : Z ⟶ U) (y : (fiberFun S p).obj Z),
            R.arrows f ∧ (fiberFun S p).map f y = x := by
    intro S p U R hR x
    let pt₀ : ↥S_Ω := default
    obtain ⟨Z, f, z₀, hf_arr, hEt_f, hz₀⟩ := (hMemTopo S U R).mp hR (x.left.base pt₀)
    have _ : AlgebraicGeometry.Etale f.left := hEt_f
    let xf := (AlgebraicGeometry.Scheme.SpecToEquivOfField Ω U.left) x.left
    have hxf_symm : (AlgebraicGeometry.Scheme.SpecToEquivOfField Ω U.left).symm xf = x.left :=
      (AlgebraicGeometry.Scheme.SpecToEquivOfField Ω U.left).symm_apply_apply x.left
    rw [AlgebraicGeometry.Scheme.SpecToEquivOfField_symm_apply] at hxf_symm
    have hxf_fst : xf.1 = f.left.base z₀ := by
      have hpt := congrArg (fun φ : S_Ω ⟶ U.left => φ.base pt₀) hxf_symm
      change (U.left.fromSpecResidueField xf.1).base
        ((AlgebraicGeometry.Spec.map xf.2).base pt₀) = x.left.base pt₀ at hpt
      rw [AlgebraicGeometry.Scheme.fromSpecResidueField_apply] at hpt
      exact hpt.trans hz₀.symm
    obtain ⟨u_pt, σ₀⟩ := xf
    dsimp at hxf_fst hxf_symm
    subst hxf_fst
    let U_sch : AlgebraicGeometry.Scheme.{u} := U.left
    let Z_sch : AlgebraicGeometry.Scheme.{u} := Z.left
    let f_left : Z_sch ⟶ U_sch := f.left
    let u_hom : U_sch ⟶ S := U.hom
    let z_hom : Z_sch ⟶ S := Z.hom
    let x_left : S_Ω ⟶ U_sch := x.left
    have hf_w : f_left ≫ u_hom = z_hom := f.w
    have hx_w : x_left ≫ u_hom = p := x.w
    have _ : AlgebraicGeometry.Etale f_left := hEt_f
    let R_u := ↥(U_sch.presheaf.stalk (f_left.base z₀))
    let R_z := ↥(Z_sch.presheaf.stalk z₀)
    let φ_stalk : R_u →+* R_z := (AlgebraicGeometry.Scheme.Hom.stalkMap f_left z₀).hom
    have _ : IsLocalHom φ_stalk := inferInstance
    have hEssFT : φ_stalk.EssFiniteType :=
      AlgebraicGeometry.LocallyOfFiniteType.stalkMap f_left z₀
    have hUnram : φ_stalk.FormallyUnramified := by
      refine AlgebraicGeometry.HasRingHomProperty.stalkMap
        (P := @AlgebraicGeometry.FormallyUnramified) ?_ inferInstance z₀
      intro R₀ S₀ _ _ g₀ hg₀ J₀ _
      let _ : Algebra R₀ S₀ := g₀.toAlgebra
      have _ : Algebra.FormallyUnramified R₀ S₀ := RingHom.formallyUnramified_algebraMap.mp hg₀
      let P₀ : Ideal R₀ := Ideal.comap g₀ J₀
      have _ : P₀.IsPrime := Ideal.IsPrime.comap g₀
      let R_P := Localization.AtPrime P₀
      let S_J := Localization.AtPrime J₀
      have _ : Algebra.FormallyUnramified S₀ S_J :=
        Algebra.FormallyUnramified.of_isLocalization J₀.primeCompl
      have _ : Algebra.FormallyUnramified R₀ S_J := Algebra.FormallyUnramified.comp R₀ S₀ S_J
      let φ_loc : R_P →+* S_J := Localization.localRingHom P₀ J₀ g₀ rfl
      let _ : Algebra R_P S_J := φ_loc.toAlgebra
      have h_tower : (algebraMap R_P S_J).comp (algebraMap R₀ R_P) = algebraMap R₀ S_J := by
        ext r
        exact Localization.localRingHom_to_map P₀ J₀ g₀ rfl r
      have _ : IsScalarTower R₀ R_P S_J := IsScalarTower.of_algebraMap_eq' h_tower.symm
      change (algebraMap R_P S_J).FormallyUnramified
      rw [RingHom.formallyUnramified_algebraMap, Algebra.formallyUnramified_iff]
      exact Function.Surjective.subsingleton (KaehlerDifferential.map_surjective R₀ R_P S_J)
    let _ : Algebra R_u R_z := φ_stalk.toAlgebra
    have _ : IsLocalHom (algebraMap R_u R_z) := ‹IsLocalHom φ_stalk›
    have _ : Algebra.EssFiniteType R_u R_z := RingHom.essFiniteType_algebraMap.mp hEssFT
    have _ : Algebra.FormallyUnramified R_u R_z := RingHom.formallyUnramified_algebraMap.mp hUnram
    let κ_u := IsLocalRing.ResidueField R_u
    let κ_z := IsLocalRing.ResidueField R_z
    have _ : Module.Finite κ_u κ_z :=
      @Algebra.instFiniteResidueFieldOfFormallyUnramified R_u R_z _ _ _ _ _ _ _ _
    let _ : Algebra κ_u Ω := σ₀.hom.toAlgebra
    have _ : Algebra.IsAlgebraic κ_u κ_z := Algebra.IsAlgebraic.of_finite κ_u κ_z
    let τ₀ : κ_z →ₐ[κ_u] Ω := IsAlgClosed.lift
    let τ_cat : Z_sch.residueField z₀ ⟶ CommRingCat.of Ω := CommRingCat.ofHom τ₀.toRingHom
    let w_sch : S_Ω ⟶ Z_sch :=
      AlgebraicGeometry.Spec.map τ_cat ≫ Z_sch.fromSpecResidueField z₀
    have hw_f : w_sch ≫ f_left = x_left := by
      have hres_comm :
          AlgebraicGeometry.Scheme.Hom.residueFieldMap f_left z₀ ≫ τ_cat = σ₀ := by
        apply CommRingCat.hom_ext
        ext c
        exact τ₀.commutes c
      calc
        w_sch ≫ f_left
            = AlgebraicGeometry.Spec.map τ_cat ≫
                (Z_sch.fromSpecResidueField z₀ ≫ f_left) :=
              Category.assoc _ _ _
        _ = AlgebraicGeometry.Spec.map τ_cat ≫
              (AlgebraicGeometry.Spec.map
                (AlgebraicGeometry.Scheme.Hom.residueFieldMap f_left z₀) ≫
                U_sch.fromSpecResidueField (f_left.base z₀)) := by
              rw [← AlgebraicGeometry.Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField]
        _ = (AlgebraicGeometry.Spec.map τ_cat ≫
              AlgebraicGeometry.Spec.map
                (AlgebraicGeometry.Scheme.Hom.residueFieldMap f_left z₀)) ≫
              U_sch.fromSpecResidueField (f_left.base z₀) :=
              (Category.assoc _ _ _).symm
        _ = AlgebraicGeometry.Spec.map σ₀ ≫ U_sch.fromSpecResidueField (f_left.base z₀) := by
              rw [← AlgebraicGeometry.Spec.map_comp, hres_comm]
        _ = x_left := hxf_symm
    let y : (fiberFun S p).obj Z :=
      CategoryTheory.Over.homMk w_sch
        (by
          dsimp [fiberFun]
          change w_sch ≫ z_hom = p
          calc
            w_sch ≫ z_hom = w_sch ≫ (f_left ≫ u_hom) := by rw [← hf_w]
            _ = (w_sch ≫ f_left) ≫ u_hom := (Category.assoc _ _ _).symm
            _ = p := by rw [hw_f, hx_w])
    refine ⟨Z, f, y, hf_arr, ?_⟩
    apply CategoryTheory.Over.OverMorphism.ext
    exact hw_f

  let F_V := fiberFun V gx_η
  have hCof_FV : CategoryTheory.IsCofiltered F_V.Elements := by
    have hNonempty : Nonempty F_V.Elements :=
      ⟨CategoryTheory.Functor.elementsMk F_V
        (CategoryTheory.MorphismProperty.Over.mk ⊤ (𝟙 V) inferInstance)
        (CategoryTheory.Over.homMk gx_η (Category.comp_id gx_η))⟩
    refine
      { toIsCofilteredOrEmpty :=
          { cone_objs := fun a b => ?_
            cone_maps := fun {a b} (f₁ f₂ : a ⟶ b) => ?_ }
        nonempty := hNonempty }
    · have _ : AlgebraicGeometry.Etale a.obj.hom := a.obj.prop
      have _ : AlgebraicGeometry.Etale b.obj.hom := b.obj.prop
      have hEt_pb : AlgebraicGeometry.Etale
          (CategoryTheory.Limits.pullback.fst a.obj.hom b.obj.hom ≫ a.obj.hom) := inferInstance
      let P_et : V.Etale :=
        CategoryTheory.MorphismProperty.Over.mk ⊤
          (CategoryTheory.Limits.pullback.fst a.obj.hom b.obj.hom ≫ a.obj.hom) hEt_pb
      let π₁ : P_et ⟶ a.obj := CategoryTheory.MorphismProperty.Over.homMk
        (CategoryTheory.Limits.pullback.fst a.obj.hom b.obj.hom) rfl
      let π₂ : P_et ⟶ b.obj := CategoryTheory.MorphismProperty.Over.homMk
        (CategoryTheory.Limits.pullback.snd a.obj.hom b.obj.hom)
        CategoryTheory.Limits.pullback.condition.symm
      let u_P : F_V.obj P_et :=
        CategoryTheory.Over.homMk
          (CategoryTheory.Limits.pullback.lift a.val.left b.val.left
            (a.val.w.trans b.val.w.symm))
          (by
            dsimp [P_et, fiberFun]
            exact (Category.assoc _ _ a.obj.hom).symm.trans
              ((congrArg (fun k => k ≫ a.obj.hom)
                (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans a.val.w))
      refine ⟨CategoryTheory.Functor.elementsMk F_V P_et u_P,
        ⟨π₁, by apply CategoryTheory.Over.OverMorphism.ext; exact CategoryTheory.Limits.pullback.lift_fst _ _ _⟩,
        ⟨π₂, by apply CategoryTheory.Over.OverMorphism.ext; exact CategoryTheory.Limits.pullback.lift_snd _ _ _⟩,
        trivial⟩
    · let a_sch : AlgebraicGeometry.Scheme.{u} := a.obj.left
      let b_sch : AlgebraicGeometry.Scheme.{u} := b.obj.left
      let a_hom : a_sch ⟶ V := a.obj.hom
      let b_hom : b_sch ⟶ V := b.obj.hom
      have _ : AlgebraicGeometry.Etale a_hom := a.obj.prop
      have _ : AlgebraicGeometry.Etale b_hom := b.obj.prop
      let Δ : b_sch ⟶ CategoryTheory.Limits.pullback b_hom b_hom :=
        CategoryTheory.Limits.pullback.diagonal b_hom
      have hEt_Δ : AlgebraicGeometry.Etale Δ := by
        have hcomp : AlgebraicGeometry.Etale
            (Δ ≫ CategoryTheory.Limits.pullback.fst b_hom b_hom) := by
          rw [CategoryTheory.Limits.pullback.diagonal_fst]
          infer_instance
        exact @CategoryTheory.MorphismProperty.of_postcomp _ _
          (@AlgebraicGeometry.Etale) (@AlgebraicGeometry.Etale) _ _ _ _
          Δ (CategoryTheory.Limits.pullback.fst b_hom b_hom) inferInstance hcomp
      let f₁_left : a_sch ⟶ b_sch := f₁.1.left
      let f₂_left : a_sch ⟶ b_sch := f₂.1.left
      have hf₁_w : f₁_left ≫ b_hom = a_hom := f₁.1.w
      have hf₂_w : f₂_left ≫ b_hom = a_hom := f₂.1.w
      let γ : a_sch ⟶ CategoryTheory.Limits.pullback b_hom b_hom :=
        CategoryTheory.Limits.pullback.lift f₁_left f₂_left (hf₁_w.trans hf₂_w.symm)
      let π_E : CategoryTheory.Limits.pullback γ Δ ⟶ a_sch :=
        CategoryTheory.Limits.pullback.fst γ Δ
      have _ : AlgebraicGeometry.Etale π_E := inferInstance
      let E_et : V.Etale :=
        CategoryTheory.MorphismProperty.Over.mk ⊤ (π_E ≫ a_hom) inferInstance
      let j_E : E_et ⟶ a.obj := CategoryTheory.MorphismProperty.Over.homMk π_E rfl
      let u_a : S_Ω ⟶ a_sch := a.val.left
      let u_b : S_Ω ⟶ b_sch := b.val.left
      have hf₁_eq : u_a ≫ f₁_left = u_b :=
        congrArg CategoryTheory.CommaMorphism.left f₁.2
      have hf₂_eq : u_a ≫ f₂_left = u_b :=
        congrArg CategoryTheory.CommaMorphism.left f₂.2
      have h_eq_E : u_a ≫ γ = u_b ≫ Δ := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · rw [Category.assoc, Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
            CategoryTheory.Limits.pullback.diagonal_fst, Category.comp_id, hf₁_eq]
        · rw [Category.assoc, Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
            CategoryTheory.Limits.pullback.diagonal_snd, Category.comp_id, hf₂_eq]
      let u_E : F_V.obj E_et :=
        CategoryTheory.Over.homMk
          (CategoryTheory.Limits.pullback.lift u_a u_b h_eq_E)
          (by
            dsimp [E_et, fiberFun]
            exact (Category.assoc _ π_E a_hom).symm.trans
              ((congrArg (fun k => k ≫ a_hom)
                (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans a.val.w))
      refine ⟨CategoryTheory.Functor.elementsMk F_V E_et u_E,
        ⟨j_E, by apply CategoryTheory.Over.OverMorphism.ext; exact CategoryTheory.Limits.pullback.lift_fst _ _ _⟩,
        ?_⟩
      ext1
      apply CategoryTheory.MorphismProperty.Over.Hom.ext
      change π_E ≫ f₁_left = π_E ≫ f₂_left
      have hcond : π_E ≫ γ = CategoryTheory.Limits.pullback.snd γ Δ ≫ Δ :=
        CategoryTheory.Limits.pullback.condition
      calc
        π_E ≫ f₁_left
            = (π_E ≫ γ) ≫ CategoryTheory.Limits.pullback.fst b_hom b_hom := by
              rw [Category.assoc, CategoryTheory.Limits.pullback.lift_fst]
        _ = (CategoryTheory.Limits.pullback.snd γ Δ ≫ Δ) ≫
              CategoryTheory.Limits.pullback.fst b_hom b_hom := by rw [hcond]
        _ = CategoryTheory.Limits.pullback.snd γ Δ := by
              rw [Category.assoc, CategoryTheory.Limits.pullback.diagonal_fst, Category.comp_id]
        _ = (CategoryTheory.Limits.pullback.snd γ Δ ≫ Δ) ≫
              CategoryTheory.Limits.pullback.snd b_hom b_hom := by
              rw [Category.assoc, CategoryTheory.Limits.pullback.diagonal_snd, Category.comp_id]
        _ = (π_E ≫ γ) ≫ CategoryTheory.Limits.pullback.snd b_hom b_hom := by rw [← hcond]
        _ = π_E ≫ f₂_left := by
              rw [Category.assoc, CategoryTheory.Limits.pullback.lift_snd]

  have hSmall_FV : CategoryTheory.InitiallySmall.{u} F_V.Elements := by
    let e_aff := CategoryTheory.equivSmallModel.{u} V.AffineEtale
    let ι_aff := AlgebraicGeometry.Scheme.AffineEtale.Spec V
    let Idx₀ : Type u :=
      Σ m : CategoryTheory.SmallModel.{u} V.AffineEtale, F_V.obj (ι_aff.obj (e_aff.inverse.obj m))
    let s_set : Set F_V.Elements :=
      Set.range (fun q : Idx₀ => CategoryTheory.Functor.elementsMk F_V _ q.2)
    refine CategoryTheory.initiallySmall_of_small_weakly_initial_set s_set ?_
    intro i
    let I_sch : AlgebraicGeometry.Scheme.{u} := i.obj.left
    let u_i : S_Ω ⟶ I_sch := i.val.left
    let pt₀ : ↥S_Ω := default
    let y₀ : ↥I_sch := u_i.base pt₀
    obtain ⟨W_i, hWi, hy₀, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
        (X := I_sch) (x := y₀) (U := ⊤) trivial
    have hrange : Set.range ⇑u_i ⊆ Set.range ⇑hWi.fromSpec := by
      rintro _ ⟨pt, rfl⟩
      have hmem : y₀ ∈ Set.range hWi.fromSpec.base := by
        rw [hWi.range_fromSpec]
        exact hy₀
      obtain ⟨z_pt, hz_pt⟩ := hmem
      refine ⟨z_pt, ?_⟩
      change hWi.fromSpec.base z_pt = u_i.base pt
      rw [Subsingleton.elim pt pt₀]
      exact hz_pt
    let u_Wi : S_Ω ⟶ AlgebraicGeometry.Spec (I_sch.presheaf.obj (Opposite.op W_i)) :=
      AlgebraicGeometry.IsOpenImmersion.lift hWi.fromSpec u_i hrange
    have hu_Wi : u_Wi ≫ hWi.fromSpec = u_i :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac hWi.fromSpec u_i hrange
    have _ : AlgebraicGeometry.Etale i.obj.hom := i.obj.prop
    have _ : AlgebraicGeometry.Etale (hWi.fromSpec ≫ i.obj.hom) := inferInstance
    let A_Wi : V.AffineEtale := AlgebraicGeometry.Scheme.AffineEtale.mk (hWi.fromSpec ≫ i.obj.hom)
    let m₀ : CategoryTheory.SmallModel.{u} V.AffineEtale := e_aff.functor.obj A_Wi
    let mor_A_i : ι_aff.obj A_Wi ⟶ i.obj :=
      CategoryTheory.MorphismProperty.Over.homMk hWi.fromSpec rfl
    let u_A : F_V.obj (ι_aff.obj A_Wi) :=
      CategoryTheory.Over.homMk u_Wi
        (by
          dsimp [A_Wi, ι_aff, fiberFun]
          exact (Category.assoc u_Wi hWi.fromSpec i.obj.hom).symm.trans
            ((congrArg (fun k => k ≫ i.obj.hom) hu_Wi).trans i.val.w))
    let iso_m₀ : ι_aff.obj (e_aff.inverse.obj m₀) ≅ ι_aff.obj A_Wi :=
      ι_aff.mapIso (e_aff.unitIso.app A_Wi).symm
    let u_m₀ : F_V.obj (ι_aff.obj (e_aff.inverse.obj m₀)) := F_V.map iso_m₀.inv u_A
    refine ⟨CategoryTheory.Functor.elementsMk F_V _ u_m₀, ⟨⟨m₀, u_m₀⟩, rfl⟩, ⟨⟨iso_m₀.hom ≫ mor_A_i, ?_⟩⟩⟩
    apply CategoryTheory.Over.OverMorphism.ext
    let inv_left : (ι_aff.obj A_Wi).left ⟶ (ι_aff.obj (e_aff.inverse.obj m₀)).left :=
      iso_m₀.inv.left
    let hom_left : (ι_aff.obj (e_aff.inverse.obj m₀)).left ⟶ (ι_aff.obj A_Wi).left :=
      iso_m₀.hom.left
    have h_iso_left : inv_left ≫ hom_left = 𝟙 _ :=
      congrArg (fun φ : ι_aff.obj A_Wi ⟶ ι_aff.obj A_Wi => φ.left) iso_m₀.inv_hom_id
    change (u_Wi ≫ inv_left) ≫ (hom_left ≫ hWi.fromSpec) = u_i
    exact (Category.assoc u_Wi inv_left (hom_left ≫ hWi.fromSpec)).trans
      ((congrArg (fun k => u_Wi ≫ k) (Category.assoc inv_left hom_left hWi.fromSpec).symm).trans
        ((congrArg (fun k => u_Wi ≫ (k ≫ hWi.fromSpec)) h_iso_left).trans
          ((congrArg (fun k => u_Wi ≫ k) (Category.id_comp hWi.fromSpec)).trans hu_Wi)))

  let Φ : CategoryTheory.GrothendieckTopology.Point.{u} V.smallEtaleTopology :=
