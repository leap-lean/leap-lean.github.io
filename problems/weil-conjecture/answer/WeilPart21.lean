          (πℤ ≫ ιℤ) := by rw [hπιℤ, CategoryTheory.Category.comp_id]
    _ = ((κ_hom T₀ α₀ ≫ pb_ι.map (weilPolyP1CohomologyRepToConst Y W₀ hT₀_top)) ≫ πℤ) ≫
