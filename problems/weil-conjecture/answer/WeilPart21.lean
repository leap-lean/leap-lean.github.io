  have hCosimpColimExact : ∀ (Idx : Type u) [CategoryTheory.SmallCategory Idx]
      (F_diag : CategoryTheory.Functor Idx (CategoryTheory.CosimplicialObject AddCommGrpCat.{u}))
      (c : CategoryTheory.Limits.Cocone F_diag),
      (∀ (n : SimplexCategory) (y : ↥(c.pt.obj n)),
        ∃ (j : Idx) (x : ↥((F_diag.obj j).obj n)), ((c.ι.app j).app n).hom x = y) →
      (∀ (n : SimplexCategory) (j₁ : Idx) (x : ↥((F_diag.obj j₁).obj n)),
        ((c.ι.app j₁).app n).hom x = 0 →
        ∃ (j₂ : Idx) (u : j₁ ⟶ j₂), ((F_diag.map u).app n).hom x = 0) →
      ∀ (X_alt : Idx → CategoryTheory.CosimplicialObject AddCommGrpCat.{u})
        (_ : ∀ j : Idx, X_alt j ≅ F_diag.obj j)
        (Y_alt : CategoryTheory.CosimplicialObject AddCommGrpCat.{u})
        (_ : Y_alt ≅ c.pt)
        (p : ℕ), 1 ≤ p →
        (∀ j : Idx,
          (AlgebraicTopology.AlternatingCofaceMapComplex.obj (X_alt j)).ExactAt p) →
        (AlgebraicTopology.AlternatingCofaceMapComplex.obj Y_alt).ExactAt p := by
    intro Idx _ F_diag c hSurj hKer X_alt e_X Y_alt e_Y p hp hExact
    let A := AlgebraicTopology.alternatingCofaceMapComplex AddCommGrpCat.{u}
    obtain ⟨q, rfl⟩ : ∃ q : ℕ, p = q + 1 := ⟨p - 1, (Nat.sub_add_cancel hp).symm⟩
    have hRel₁ : (ComplexShape.up ℕ).prev (q + 1) = q := by simp
    have hRel₂ : (ComplexShape.up ℕ).next (q + 1) = q + 2 := by simp
    have hExactChar : ∀ (K : CochainComplex AddCommGrpCat.{u} ℕ),
        K.ExactAt (q + 1) ↔
          ∀ (y : ↥(K.X (q + 1))), (K.d (q + 1) (q + 2)).hom y = 0 →
            ∃ (x : ↥(K.X q)), (K.d q (q + 1)).hom x = y := by
      intro K
      rw [HomologicalComplex.exactAt_iff' K q (q + 1) (q + 2) hRel₁ hRel₂,
        CategoryTheory.ShortComplex.ab_exact_iff]
      rfl
    have hChainComm : ∀ {K L : CochainComplex AddCommGrpCat.{u} ℕ} (f : K ⟶ L)
        (i j : ℕ) (x : ↥(K.X i)),
        (L.d i j).hom ((f.f i).hom x) = (f.f j).hom ((K.d i j).hom x) :=
      fun f i j x => congrArg (fun m => m.hom x) (f.comm i j)
    have hExactIso : ∀ {K L : CochainComplex AddCommGrpCat.{u} ℕ} (e : K ≅ L),
        K.ExactAt (q + 1) → L.ExactAt (q + 1) := by
      intro K L e hK
      rw [hExactChar] at hK ⊢
      intro y hy
      have hy_inv : (K.d (q + 1) (q + 2)).hom ((e.inv.f (q + 1)).hom y) = 0 := by
        rw [hChainComm e.inv (q + 1) (q + 2) y, hy, map_zero]
      obtain ⟨x, hx⟩ := hK ((e.inv.f (q + 1)).hom y) hy_inv
      refine ⟨(e.hom.f q).hom x, ?_⟩
      rw [hChainComm e.hom q (q + 1) x, hx]
      exact CategoryTheory.ConcreteCategory.congr_hom
        (HomologicalComplex.congr_hom e.inv_hom_id (q + 1)) y
    have hExactF : ∀ j : Idx, (A.obj (F_diag.obj j)).ExactAt (q + 1) := fun j =>
      hExactIso (A.mapIso (e_X j)) (hExact j)
    refine hExactIso (A.mapIso e_Y.symm) ?_
    rw [hExactChar]
    intro y hy
    obtain ⟨j₁, x₁, hx₁⟩ := hSurj (SimplexCategory.mk (q + 1)) y
    let ι₁ : A.obj (F_diag.obj j₁) ⟶ A.obj c.pt := A.map (c.ι.app j₁)
    have hdx₁_c : ((c.ι.app j₁).app (SimplexCategory.mk (q + 2))).hom
        (((A.obj (F_diag.obj j₁)).d (q + 1) (q + 2)).hom x₁) = 0 := by
      change (ι₁.f (q + 2)).hom (((A.obj (F_diag.obj j₁)).d (q + 1) (q + 2)).hom x₁) = 0
      rw [← hChainComm ι₁ (q + 1) (q + 2) x₁]
      change ((A.obj c.pt).d (q + 1) (q + 2)).hom
        (((c.ι.app j₁).app (SimplexCategory.mk (q + 1))).hom x₁) = 0
      rw [hx₁]
      exact hy
    obtain ⟨j₂, u, hu_kill⟩ := hKer (SimplexCategory.mk (q + 2)) j₁ _ hdx₁_c
    let x₂ : ↥((A.obj (F_diag.obj j₂)).X (q + 1)) :=
      ((F_diag.map u).app (SimplexCategory.mk (q + 1))).hom x₁
    have hx₂_cocycle : ((A.obj (F_diag.obj j₂)).d (q + 1) (q + 2)).hom x₂ = 0 := by
      change ((A.obj (F_diag.obj j₂)).d (q + 1) (q + 2)).hom
        (((A.map (F_diag.map u)).f (q + 1)).hom x₁) = 0
      rw [hChainComm (A.map (F_diag.map u)) (q + 1) (q + 2) x₁]
      exact hu_kill
    obtain ⟨z₂, hz₂⟩ := (hExactChar (A.obj (F_diag.obj j₂))).mp (hExactF j₂) x₂ hx₂_cocycle
    refine ⟨((c.ι.app j₂).app (SimplexCategory.mk q)).hom z₂, ?_⟩
    let ι₂ : A.obj (F_diag.obj j₂) ⟶ A.obj c.pt := A.map (c.ι.app j₂)
    change ((A.obj c.pt).d q (q + 1)).hom ((ι₂.f q).hom z₂) = y
    rw [hChainComm ι₂ q (q + 1) z₂, hz₂]
    have hcw := CategoryTheory.ConcreteCategory.congr_hom
      (CategoryTheory.NatTrans.congr_app (c.w u) (SimplexCategory.mk (q + 1))) x₁
    exact hcw.trans hx₁

