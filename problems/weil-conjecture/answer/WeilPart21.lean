            have hsimp1 : (m' ≫ π_map a.len i) ≫ e_WK.hom =
                m' ≫ F.map (weilAltCdSpecEtaleMap E (ι_E a.len i)) := by
              change (m' ≫ (F.map (weilAltCdSpecEtaleMap E (ι_E a.len i)) ≫ e_WK.inv)) ≫ e_WK.hom = _
              rw [Category.assoc, Category.assoc, Iso.inv_hom_id, Category.comp_id]
            have hsimp2 : ((mkLift s).1 ≫ π_map a.len i) ≫ e_WK.hom =
                (mkLift s).1 ≫ F.map (weilAltCdSpecEtaleMap E (ι_E a.len i)) := by
              change ((mkLift s).1 ≫ (F.map (weilAltCdSpecEtaleMap E (ι_E a.len i)) ≫ e_WK.inv)) ≫ e_WK.hom = _
              rw [Category.assoc, Category.assoc, Iso.inv_hom_id, Category.comp_id]
            rw [hsimp1, hsimp2] at hm_i
            have hleft : m'.left ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_E a.len i).toRingHom) =
              (mkLift s).1.left ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_E a.len i).toRingHom) :=
              congrArg (fun g => g.left) hm_i
            exact (hToComp Z.left m'.left (ι_E a.len i).toRingHom).symm.trans
              ((congrArg (toRing Z.left) hleft).trans
                (hToComp Z.left (mkLift s).1.left (ι_E a.len i).toRingHom)) }
    have hAbstractCechIso : ∀ {𝒞 : Type (u + 1)} [CategoryTheory.Category.{u} 𝒞]
