              (CategoryTheory.Abelian.Ext.mk₀ m) (Nat.add_zero q)) hτ_Gm.symm).trans
            (CategoryTheory.Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp ξ τ_nat)))
    change (CategoryTheory.Abelian.Ext.mk₀ (e_ℤ E₁ E₃).hom).comp
        (CategoryTheory.Abelian.Ext.mapExactFunctor (P_pull E₁ E₃) ξ) (Nat.zero_add q) =
      (CategoryTheory.Abelian.Ext.mk₀ (e_ℤ E₂ E₃).hom).comp
        (CategoryTheory.Abelian.Ext.mapExactFunctor (P_pull E₂ E₃)
          ((CategoryTheory.Abelian.Ext.mk₀ (e_ℤ E₁ E₂).hom).comp
            (CategoryTheory.Abelian.Ext.mapExactFunctor (P_pull E₁ E₂) ξ) (Nat.zero_add q)))
        (Nat.zero_add q)
    rw [← hτ_ℤ, CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
      CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
      ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc,
      ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc, hNatExt]
    rfl

  
  have hResId : ∀ (E : Type u) [Field E] (q : ℕ),
      @res E E _ _ (Algebra.id E) _ _ q = AddMonoidHom.id _ := by
    intro E _ q
    let algEE : Algebra E E := Algebra.id E
    let _ : Algebra E E := algEE
    obtain ⟨τ_id, hτ_Gm, hτ_ℤ⟩ := hIdCoh E
    let _ := hAdd₁ E E; let _ := hLim₁ E E; let _ := hColim₁ E E
    ext ξ
    let GmE := weilC1AffEtGmSheaf E (hGm E)
    have hNatExt : ξ =
        (CategoryTheory.Abelian.Ext.mk₀ (τ_id.app (ℤ_sh E))).comp
          (CategoryTheory.Abelian.Ext.mapExactFunctor (P_pull E E) ξ) (Nat.zero_add q) :=
      (CategoryTheory.Abelian.Ext.id_mapExactFunctor ξ).symm.trans
        ((CategoryTheory.Abelian.Ext.comp_mk₀_id (Y := GmE)
          (CategoryTheory.Abelian.Ext.mapExactFunctor (CategoryTheory.Functor.id _) ξ)).symm.trans
          ((congrArg (fun m : GmE ⟶ GmE =>
            (CategoryTheory.Abelian.Ext.mapExactFunctor (CategoryTheory.Functor.id _) ξ).comp
              (CategoryTheory.Abelian.Ext.mk₀ m) (Nat.add_zero q)) hτ_Gm.symm).trans
            (CategoryTheory.Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp ξ τ_id)))
    exact (congrArg (fun m => (CategoryTheory.Abelian.Ext.mk₀ m).comp
      (CategoryTheory.Abelian.Ext.mapExactFunctor (P_pull E E) ξ) (Nat.zero_add q))
      hτ_ℤ.symm).trans hNatExt.symm

  have hResBij : ∀ (E₁ E₂ : Type u) [Field E₁] [Field E₂] [Algebra E₁ E₂]
      [FiniteDimensional E₁ E₂] [Algebra.IsSeparable E₁ E₂] (q : ℕ),
      Function.Bijective (algebraMap E₁ E₂) → Function.Injective (res E₁ E₂ q) := by
    intro E₁ E₂ _ _ _ _ _ q hBij
    let e_ring : E₁ ≃+* E₂ := RingEquiv.ofBijective (algebraMap E₁ E₂) hBij
    let alg₂₁ : Algebra E₂ E₁ := e_ring.symm.toRingHom.toAlgebra
    let alg₁₁ : Algebra E₁ E₁ := Algebra.id E₁
    let _ : Algebra E₂ E₁ := alg₂₁
    have _ : @IsScalarTower E₁ E₂ E₁ _ alg₂₁.toSMul alg₁₁.toSMul :=
      @IsScalarTower.of_algebraMap_eq' E₁ E₂ E₁ _ _ _ _ alg₂₁ alg₁₁
        (RingHom.ext fun x => (e_ring.symm_apply_apply x).symm)
    let eqv_lin : E₂ ≃ₗ[E₂] E₁ :=
      { toFun := e_ring.symm
        invFun := e_ring
        left_inv := e_ring.apply_symm_apply
        right_inv := e_ring.symm_apply_apply
        map_add' := map_add e_ring.symm
        map_smul' := map_mul e_ring.symm }
    have _ : FiniteDimensional E₂ E₁ := Module.Finite.equiv eqv_lin
    have _ : Algebra.IsSeparable E₂ E₁ :=
      @Algebra.IsSeparable.of_equiv_equiv E₂ E₂ E₂ E₁ _ _ _ _
        (Algebra.id E₂) alg₂₁ (RingEquiv.refl E₂) e_ring.symm (RingHom.ext fun _ => rfl)
        (Algebra.isSeparable_self E₂)
    have hComp := @hResComp E₁ E₂ E₁ _ _ _ _ alg₂₁ alg₁₁ _ _ _ _ _ _ _ q
    rw [hResId E₁ q] at hComp
    intro ξ₁ ξ₂ hEq
    have h1 := congrArg (@res E₂ E₁ _ _ alg₂₁ _ _ q) hEq
    change ((@res E₂ E₁ _ _ alg₂₁ _ _ q).comp (res E₁ E₂ q)) ξ₁ =
      ((@res E₂ E₁ _ _ alg₂₁ _ _ q).comp (res E₁ E₂ q)) ξ₂ at h1
    rwa [← hComp] at h1

  
  have hResZeroCompEta : ∀ (E₁ E₂ : Type u) [Field E₁] [Field E₂] [Algebra E₁ E₂]
      [FiniteDimensional E₁ E₂] [Algebra.IsSeparable E₁ E₂] (q : ℕ)
      (ξ : (weilC1AffEtGmSheaf E₁ (hGm E₁)).H q),
      res E₁ E₂ q ξ = 0 →
        ξ.comp (CategoryTheory.Abelian.Ext.mk₀ (η_Gm E₁ E₂)) (Nat.add_zero q) = 0 := by
    intro E₁ E₂ _ _ _ _ _ q ξ hRes0
    let _ := hAdd₁ E₁ E₂; let _ := hLim₁ E₁ E₂; let _ := hColim₁ E₁ E₂
    let _ := hAdd₂ E₁ E₂; let _ := hLim₂ E₁ E₂; let _ := hColim₂ E₁ E₂
    have _ : CategoryTheory.Limits.PreservesFiniteLimits ((P_pull E₁ E₂).comp (P_push E₁ E₂)) :=
      CategoryTheory.Limits.comp_preservesFiniteLimits (P_pull E₁ E₂) (P_push E₁ E₂)
    have _ : CategoryTheory.Limits.PreservesFiniteColimits ((P_pull E₁ E₂).comp (P_push E₁ E₂)) :=
      CategoryTheory.Limits.comp_preservesFiniteColimits (P_pull E₁ E₂) (P_push E₁ E₂)
    have _ : ((P_pull E₁ E₂).comp (P_push E₁ E₂)).Additive :=
      CategoryTheory.Functor.additive_of_preserves_binary_products _
    have hPull0 : CategoryTheory.Abelian.Ext.mapExactFunctor (P_pull E₁ E₂) ξ = 0 := by
      have h1 := congrArg
        (fun w => (CategoryTheory.Abelian.Ext.mk₀ (e_ℤ E₁ E₂).inv).comp w (Nat.zero_add q)) hRes0
      change (CategoryTheory.Abelian.Ext.mk₀ (e_ℤ E₁ E₂).inv).comp
          ((CategoryTheory.Abelian.Ext.mk₀ (e_ℤ E₁ E₂).hom).comp
            (CategoryTheory.Abelian.Ext.mapExactFunctor (P_pull E₁ E₂) ξ) (Nat.zero_add q))
          (Nat.zero_add q) =
        (CategoryTheory.Abelian.Ext.mk₀ (e_ℤ E₁ E₂).inv).comp 0 (Nat.zero_add q) at h1
      rw [CategoryTheory.Abelian.Ext.comp_zero, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc,
        (e_ℤ E₁ E₂).inv_hom_id, CategoryTheory.Abelian.Ext.mk₀_id_comp] at h1
      exact h1
    have hComp0 : CategoryTheory.Abelian.Ext.mapExactFunctor
        ((P_pull E₁ E₂).comp (P_push E₁ E₂)) ξ = 0 := by
      rw [CategoryTheory.Abelian.Ext.comp_mapExactFunctor ξ (P_pull E₁ E₂) (P_push E₁ E₂),
        hPull0, ← CategoryTheory.Functor.mapExtAddHom_apply, map_zero]
    have hNat := CategoryTheory.Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp
      ξ (adjOf E₁ E₂).unit
    rw [CategoryTheory.Abelian.Ext.id_mapExactFunctor, hComp0,
      CategoryTheory.Abelian.Ext.comp_zero] at hNat
    exact hNat

  refine ⟨hAdd₁, hLim₁, hColim₁, res, η_Gm, hEta, hResBij, hResComp, ?_, hResZeroCompEta⟩
  
  intro E₁ E₂ _ _ _ _ _ instAdd instLim instColim q ξ hZero
  have hEqAdd : instAdd = hAdd₁ E₁ E₂ := Subsingleton.elim _ _
  have hEqLim : instLim = hLim₁ E₁ E₂ := Subsingleton.elim _ _
  have hEqColim : instColim = hColim₁ E₁ E₂ := Subsingleton.elim _ _
  subst hEqAdd; subst hEqLim; subst hEqColim
  change (CategoryTheory.Abelian.Ext.mk₀ (e_ℤ E₁ E₂).hom).comp
    (CategoryTheory.Abelian.Ext.mapExactFunctor (P_pull E₁ E₂) ξ) (Nat.zero_add q) = 0
  rw [hZero, CategoryTheory.Abelian.Ext.comp_zero]

theorem weil_c1_affEt_exact_pushforward_cohomology_subsingleton (E₁ E₂ : Type u) [Field E₁] [Field E₂] [Algebra E₁ E₂]
    [FiniteDimensional E₁ E₂] [Algebra.IsSeparable E₁ E₂]
    (hCont₁ : (weilC1AffEtForgetSite E₁ E₂).IsContinuous
      (weilC1AffEtTop E₂) (weilC1AffEtTop E₁))
    (hCont₂ : (weilC1AffEtBaseChangeSite E₁ E₂).IsContinuous
      (weilC1AffEtTop E₁) (weilC1AffEtTop E₂))
    (adjSite : weilC1AffEtForgetSite E₁ E₂ ⊣ weilC1AffEtBaseChangeSite E₁ E₂)
    (hColim₂ :
      letI := hCont₂
      CategoryTheory.Limits.PreservesFiniteColimits
        ((weilC1AffEtBaseChangeSite E₁ E₂).sheafPushforwardContinuous
          AddCommGrpCat.{u} (weilC1AffEtTop E₁) (weilC1AffEtTop E₂)))
    (ℋ : CategoryTheory.Sheaf (weilC1AffEtTop E₂) AddCommGrpCat.{u}) (r : ℕ)
    (hSub : Subsingleton (ℋ.H r)) :
    letI := hCont₂
    Subsingleton
      ((((weilC1AffEtBaseChangeSite E₁ E₂).sheafPushforwardContinuous
        AddCommGrpCat.{u} (weilC1AffEtTop E₁) (weilC1AffEtTop E₂)).obj ℋ).H r) :=
by
  have _ : (weilC1AffEtForgetSite E₁ E₂).IsContinuous
      (weilC1AffEtTop E₂) (weilC1AffEtTop E₁) := hCont₁
  have _ : (weilC1AffEtBaseChangeSite E₁ E₂).IsContinuous
      (weilC1AffEtTop E₁) (weilC1AffEtTop E₂) := hCont₂
  let J₁ := weilC1AffEtTop E₁
  let J₂ := weilC1AffEtTop E₂
  let L := weilC1AffEtForgetSite E₁ E₂
  let R := weilC1AffEtBaseChangeSite E₁ E₂
  let P_pull := L.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
  let P_push := R.sheafPushforwardContinuous AddCommGrpCat.{u} J₁ J₂
  have _ : CategoryTheory.Limits.PreservesFiniteColimits P_push := hColim₂
  
  let η_adj : CategoryTheory.Functor.id (CategoryTheory.Sheaf J₁ AddCommGrpCat.{u}) ⟶
      P_pull.comp P_push :=
    { app := fun ℱ =>
        { hom :=
            { app := fun U => ℱ.obj.map (adjSite.counit.app U.unop).op
              naturality := fun _ _ g =>
                (ℱ.obj.map_comp g (adjSite.counit.app _).op).symm.trans
                  ((congrArg (fun k => ℱ.obj.map k.op)
                    (adjSite.counit.naturality g.unop).symm).trans
                    (ℱ.obj.map_comp (adjSite.counit.app _).op
                      (L.map (R.map g.unop)).op)) } }
      naturality := fun _ _ α =>
        CategoryTheory.Sheaf.hom_ext
          (CategoryTheory.NatTrans.ext
            (funext fun U => (α.hom.naturality (adjSite.counit.app U.unop).op).symm)) }
  let ε_adj : P_push.comp P_pull ⟶
      CategoryTheory.Functor.id (CategoryTheory.Sheaf J₂ AddCommGrpCat.{u}) :=
    { app := fun 𝒢 =>
        { hom :=
            { app := fun V => 𝒢.obj.map (adjSite.unit.app V.unop).op
              naturality := fun _ _ g =>
                (𝒢.obj.map_comp (R.map (L.map g.unop)).op
                  (adjSite.unit.app _).op).symm.trans
                  ((congrArg (fun k => 𝒢.obj.map k.op)
                    (adjSite.unit.naturality g.unop).symm).trans
                    (𝒢.obj.map_comp (adjSite.unit.app _).op g)) } }
      naturality := fun _ _ β =>
        CategoryTheory.Sheaf.hom_ext
          (CategoryTheory.NatTrans.ext
            (funext fun V => (β.hom.naturality (adjSite.unit.app V.unop).op).symm)) }
  let adj : P_pull ⊣ P_push :=
    CategoryTheory.Adjunction.mkOfUnitCounit
      { unit := η_adj
        counit := ε_adj
        left_triangle :=
          CategoryTheory.NatTrans.ext (funext fun ℱ =>
            CategoryTheory.Sheaf.hom_ext (CategoryTheory.NatTrans.ext (funext fun V =>
              (CategoryTheory.Category.id_comp _).trans
                ((ℱ.obj.map_comp (adjSite.counit.app (L.obj V.unop)).op
                  (L.map (adjSite.unit.app V.unop)).op).symm.trans
                  ((congrArg (fun k => ℱ.obj.map k.op)
                    (adjSite.left_triangle_components V.unop)).trans
                    (ℱ.obj.map_id _))))))
        right_triangle :=
          CategoryTheory.NatTrans.ext (funext fun 𝒢 =>
            CategoryTheory.Sheaf.hom_ext (CategoryTheory.NatTrans.ext (funext fun U =>
              (𝒢.obj.map_comp (R.map (adjSite.counit.app U.unop)).op
                (adjSite.unit.app (R.obj U.unop)).op).symm.trans
                ((congrArg (fun k => 𝒢.obj.map k.op)
                  ((CategoryTheory.Category.id_comp _).trans
                    (adjSite.right_triangle_components U.unop))).trans
                  (𝒢.obj.map_id _))))) }
  let S₁ := CategoryTheory.sheafToPresheaf J₁ AddCommGrpCat.{u}
  let S₂ := CategoryTheory.sheafToPresheaf J₂ AddCommGrpCat.{u}
  let W_L := (CategoryTheory.Functor.whiskeringLeft _ _ AddCommGrpCat.{u}).obj L.op
  have _ : CategoryTheory.Limits.PreservesFiniteLimits (P_pull.comp S₂) :=
    CategoryTheory.Limits.comp_preservesFiniteLimits S₁ W_L
  have _ : CategoryTheory.Limits.PreservesFiniteLimits P_pull :=
    CategoryTheory.Limits.preservesFiniteLimits_of_reflects_of_preserves P_pull S₂
  have _ : CategoryTheory.Limits.PreservesFiniteLimits P_push :=
    (adj.rightAdjoint_preservesLimits :
      CategoryTheory.Limits.PreservesLimitsOfSize.{0, 0} P_push).preservesFiniteLimits
  have _ : P_push.Additive :=
    CategoryTheory.Functor.additive_of_preserves_binary_products P_push
  
  let T_obj : ∀ (F : Type u) [Field F],
      (AlgebraicGeometry.Spec (CommRingCat.of F)).AffineEtale :=
    fun F _ => AlgebraicGeometry.Scheme.AffineEtale.mk
      (CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of F)))
  have hT_obj : ∀ (F : Type u) [Field F], CategoryTheory.Limits.IsTerminal (T_obj F) :=
    fun F _ =>
      CategoryTheory.Limits.IsTerminal.ofUniqueHom
        (fun W => CategoryTheory.MorphismProperty.CostructuredArrow.homMk
          (AlgebraicGeometry.Scheme.Spec.preimage W.hom) trivial
          ((CategoryTheory.Category.comp_id _).trans
            (AlgebraicGeometry.Scheme.Spec.map_preimage W.hom)))
        (fun W μ => CategoryTheory.MorphismProperty.Comma.Hom.ext
          (AlgebraicGeometry.Scheme.Spec.map_injective
            (((CategoryTheory.Category.comp_id _).symm.trans μ.w).trans
              (AlgebraicGeometry.Scheme.Spec.map_preimage W.hom).symm))
          (Subsingleton.elim _ _))
  have hRT₁ : CategoryTheory.Limits.IsTerminal (R.obj (T_obj E₁)) :=
    CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun W => (adjSite.homEquiv W (T_obj E₁)) ((hT_obj E₁).from (L.obj W)))
      (fun W μ => (adjSite.homEquiv W (T_obj E₁)).symm.injective
        ((hT_obj E₁).hom_ext _ _))
  let β : R.obj (T_obj E₁) ≅ T_obj E₂ :=
    CategoryTheory.Limits.IsTerminal.uniqueUpToIso hRT₁ (hT_obj E₂)
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let ℤ₁ := (CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}).obj Aℤ
  let ℤ₂ := (CategoryTheory.constantSheaf J₂ AddCommGrpCat.{u}).obj Aℤ
  let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} (hT_obj E₁)
  let adj₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} (hT_obj E₂)
  let post_β : ∀ (ℳ : CategoryTheory.Sheaf J₂ AddCommGrpCat.{u}),
      (Aℤ ⟶ ℳ.obj.obj (Opposite.op (R.obj (T_obj E₁)))) ≃
        (Aℤ ⟶ ℳ.obj.obj (Opposite.op (T_obj E₂))) :=
    fun ℳ =>
      { toFun := fun u => CategoryTheory.CategoryStruct.comp u (ℳ.obj.map β.inv.op)
        invFun := fun v => CategoryTheory.CategoryStruct.comp v (ℳ.obj.map β.hom.op)
        left_inv := fun u =>
          (CategoryTheory.Category.assoc u _ _).trans
            (((congrArg (CategoryTheory.CategoryStruct.comp u)
              ((ℳ.obj.map_comp β.inv.op β.hom.op).symm.trans
                ((congrArg (fun k => ℳ.obj.map k.op) β.hom_inv_id).trans
                  (ℳ.obj.map_id _))))).trans
              (CategoryTheory.Category.comp_id u))
        right_inv := fun v =>
          (CategoryTheory.Category.assoc v _ _).trans
            (((congrArg (CategoryTheory.CategoryStruct.comp v)
              ((ℳ.obj.map_comp β.hom.op β.inv.op).symm.trans
                ((congrArg (fun k => ℳ.obj.map k.op) β.inv_hom_id).trans
                  (ℳ.obj.map_id _))))).trans
              (CategoryTheory.Category.comp_id v)) }
  let e₀ : ∀ (ℳ : CategoryTheory.Sheaf J₂ AddCommGrpCat.{u}),
      ((P_push.obj ℳ).H 0) ≃ (ℳ.H 0) :=
    fun ℳ =>
      CategoryTheory.Abelian.Ext.addEquiv₀.toEquiv.trans
        ((adj₁.homEquiv Aℤ (P_push.obj ℳ)).trans
          ((post_β ℳ).trans
            ((adj₂.homEquiv Aℤ ℳ).symm.trans
              CategoryTheory.Abelian.Ext.addEquiv₀.symm.toEquiv)))
  have he₀_nat : ∀ {ℳ₁ ℳ₂ : CategoryTheory.Sheaf J₂ AddCommGrpCat.{u}}
      (φ : ℳ₁ ⟶ ℳ₂) (z : (P_push.obj ℳ₁).H 0),
      e₀ ℳ₂ (z.comp (CategoryTheory.Abelian.Ext.mk₀ (P_push.map φ)) (Nat.add_zero 0)) =
        (e₀ ℳ₁ z).comp (CategoryTheory.Abelian.Ext.mk₀ φ) (Nat.add_zero 0) :=
    fun {ℳ₁ ℳ₂} φ z =>
      let f : ℤ₁ ⟶ P_push.obj ℳ₁ := CategoryTheory.Abelian.Ext.addEquiv₀ z
      have hz : CategoryTheory.Abelian.Ext.mk₀ f = z :=
        CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply z
      have hLHS :
          e₀ ℳ₂ (z.comp (CategoryTheory.Abelian.Ext.mk₀ (P_push.map φ)) (Nat.add_zero 0)) =
            e₀ ℳ₂ (CategoryTheory.Abelian.Ext.mk₀ (f ≫ P_push.map φ)) :=
        congrArg (e₀ ℳ₂)
          ((congrArg
              (fun w : (P_push.obj ℳ₁).H 0 =>
                w.comp (CategoryTheory.Abelian.Ext.mk₀ (P_push.map φ)) (Nat.add_zero 0))
              hz.symm).trans
            (CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ f (P_push.map φ)))
      have s₁ :
          (adj₁.homEquiv Aℤ (P_push.obj ℳ₂))
              (CategoryTheory.Abelian.Ext.addEquiv₀
                (CategoryTheory.Abelian.Ext.mk₀ (f ≫ P_push.map φ))) =
            (adj₁.homEquiv Aℤ (P_push.obj ℳ₁)) f ≫
              φ.hom.app (Opposite.op (R.obj (T_obj E₁))) :=
        (congrArg (adj₁.homEquiv Aℤ (P_push.obj ℳ₂))
          ((congrArg CategoryTheory.Abelian.Ext.addEquiv₀
            (CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply
              (f ≫ P_push.map φ)).symm).trans
            (CategoryTheory.Abelian.Ext.addEquiv₀.apply_symm_apply
              (f ≫ P_push.map φ)))).trans
          (adj₁.homEquiv_naturality_right f (P_push.map φ))
      have s₂ :
          (adj₁.homEquiv Aℤ (P_push.obj ℳ₂))
              (CategoryTheory.Abelian.Ext.addEquiv₀
                (CategoryTheory.Abelian.Ext.mk₀ (f ≫ P_push.map φ))) ≫
              ℳ₂.obj.map β.inv.op =
            ((adj₁.homEquiv Aℤ (P_push.obj ℳ₁)) f ≫ ℳ₁.obj.map β.inv.op) ≫
              ((CategoryTheory.sheafSections J₂ AddCommGrpCat.{u}).obj
                (Opposite.op (T_obj E₂))).map φ :=
        (congrArg (fun u => CategoryTheory.CategoryStruct.comp u (ℳ₂.obj.map β.inv.op)) s₁).trans
          ((CategoryTheory.Category.assoc _ _ _).trans
            ((congrArg (CategoryTheory.CategoryStruct.comp _)
              (φ.hom.naturality β.inv.op).symm).trans
              (CategoryTheory.Category.assoc _ _ _).symm))
      have s₃ :
          (adj₂.homEquiv Aℤ ℳ₂).symm
              ((adj₁.homEquiv Aℤ (P_push.obj ℳ₂))
                (CategoryTheory.Abelian.Ext.addEquiv₀
                  (CategoryTheory.Abelian.Ext.mk₀ (f ≫ P_push.map φ))) ≫
                ℳ₂.obj.map β.inv.op) =
            (adj₂.homEquiv Aℤ ℳ₁).symm
              ((adj₁.homEquiv Aℤ (P_push.obj ℳ₁)) f ≫ ℳ₁.obj.map β.inv.op) ≫ φ :=
        (congrArg (adj₂.homEquiv Aℤ ℳ₂).symm s₂).trans
          (adj₂.homEquiv_naturality_right_symm _ φ)
      have s₄ :
          CategoryTheory.Abelian.Ext.addEquiv₀.symm
              ((adj₂.homEquiv Aℤ ℳ₂).symm
                ((adj₁.homEquiv Aℤ (P_push.obj ℳ₂))
                  (CategoryTheory.Abelian.Ext.addEquiv₀
                    (CategoryTheory.Abelian.Ext.mk₀ (f ≫ P_push.map φ))) ≫
                  ℳ₂.obj.map β.inv.op)) =
            (e₀ ℳ₁ z).comp (CategoryTheory.Abelian.Ext.mk₀ φ) (Nat.add_zero 0) :=
        let g₁ : ℤ₂ ⟶ ℳ₁ :=
          (adj₂.homEquiv Aℤ ℳ₁).symm
            ((adj₁.homEquiv Aℤ (P_push.obj ℳ₁)) f ≫ ℳ₁.obj.map β.inv.op)
        (congrArg CategoryTheory.Abelian.Ext.addEquiv₀.symm s₃).trans
          ((CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply (g₁ ≫ φ)).trans
            ((CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ g₁ φ).symm.trans
              (congrArg
                (fun w : ℳ₁.H 0 => w.comp (CategoryTheory.Abelian.Ext.mk₀ φ) (Nat.add_zero 0))
                (CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply g₁).symm)))
      hLHS.trans s₄
  
  have hMain : ∀ (n : ℕ) (ℱ : CategoryTheory.Sheaf J₂ AddCommGrpCat.{u}),
      Subsingleton (ℱ.H n) → Subsingleton ((P_push.obj ℱ).H n) := by
    intro n
    induction n with
    | zero =>
      intro ℱ hSub₀
      exact @Function.Injective.subsingleton _ _ (e₀ ℱ) (e₀ ℱ).injective hSub₀
    | succ k ih =>
      intro ℱ hSub_succ
      let ℐ := CategoryTheory.Injective.under ℱ
      let i_emb : ℱ ⟶ ℐ := CategoryTheory.Injective.ι ℱ
      let 𝒬 := CategoryTheory.Limits.cokernel i_emb
      let p_cok : ℐ ⟶ 𝒬 := CategoryTheory.Limits.cokernel.π i_emb
      let S := CategoryTheory.ShortComplex.mk i_emb p_cok
