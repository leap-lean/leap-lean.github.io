    have hΘ : weilTwoStepTheta sys δ R_Y z =
        (u_z.comp R_Y.hSE₁.extClass (rfl : 2 * δ + 1 = 2 * δ + 1)).comp
          R_Y.hSE₀.extClass (rfl : (2 * δ + 1) + 1 = 2 * (δ + 1)) := rfl
    have h_deg23 : 2 * δ + 2 = 2 * (δ + 1) := by omega
    have h_deg123 : 0 + 2 * δ + 2 = 2 * (δ + 1) := by omega
    have h_deg11 : (2 * δ + 1) + 1 = 2 * (δ + 1) := by omega
    have hΘ_E : weilTwoStepTheta sys δ R_Y z = u_z.comp E_cls h_deg23 := by
      rw [hΘ]
      exact CategoryTheory.Abelian.Ext.comp_assoc u_z R_Y.hSE₁.extClass R_Y.hSE₀.extClass
        rfl (Nat.one_add 1) h_deg11
    rw [hΘ', hu'_eq, hp_Y_eq]
    change (((CategoryTheory.Abelian.Ext.mk₀ ιℤ_Y).comp
          (CategoryTheory.Abelian.Ext.mapExactFunctor pb_Y u_z)
          (Nat.zero_add (2 * δ))).comp R'_Y.hSE₁.extClass rfl).comp R'_Y.hSE₀.extClass rfl =
      ((CategoryTheory.Abelian.Ext.mk₀ ιℤ_Y).comp
        (CategoryTheory.Abelian.Ext.mapExactFunctor pb_Y (weilTwoStepTheta sys δ R_Y z))
        (Nat.zero_add (2 * (δ + 1)))).comp
        (CategoryTheory.Abelian.Ext.mk₀ πM_Y) (Nat.add_zero (2 * (δ + 1)))
    rw [CategoryTheory.Abelian.Ext.comp_assoc _ R'_Y.hSE₁.extClass R'_Y.hSE₀.extClass
        rfl (Nat.one_add 1) h_deg11]
    change ((CategoryTheory.Abelian.Ext.mk₀ ιℤ_Y).comp
        (CategoryTheory.Abelian.Ext.mapExactFunctor pb_Y u_z)
        (Nat.zero_add (2 * δ))).comp E'_cls h_deg23 = _
    rw [hE'_eq,
      ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _
        (CategoryTheory.Abelian.Ext.mapExactFunctor pb_Y E_cls)
        (CategoryTheory.Abelian.Ext.mk₀ πM_Y),
      CategoryTheory.Abelian.Ext.comp_assoc
        (CategoryTheory.Abelian.Ext.mk₀ ιℤ_Y)
        (CategoryTheory.Abelian.Ext.mapExactFunctor pb_Y u_z)
        (CategoryTheory.Abelian.Ext.mapExactFunctor pb_Y E_cls)
        (Nat.zero_add (2 * δ)) h_deg23 h_deg123,
      ← CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
      ← hΘ_E]
  · have h_mor : bc₀ R_Y.Q₂ ≫ δ_bar'_Y ≫ Tr = pb_S.map (δ_bar_Y ≫ Tr) ≫ πM_S := by
      rw [← CategoryTheory.Category.assoc, hbc_δ, CategoryTheory.Category.assoc, hθ_Tr,
        ← CategoryTheory.Category.assoc, ← pb_S.map_comp]
    rw [hp_S_eq]
    change ((((CategoryTheory.Abelian.Ext.mk₀ ιℤ_S).comp
          (CategoryTheory.Abelian.Ext.mapExactFunctor pb_S z)
          (Nat.zero_add (2 * δ))).comp
          (CategoryTheory.Abelian.Ext.mk₀ (bc₀ R_Y.Q₂)) (Nat.add_zero (2 * δ))).comp
          (CategoryTheory.Abelian.Ext.mk₀ δ_bar'_Y) (Nat.add_zero (2 * δ))).comp
          (CategoryTheory.Abelian.Ext.mk₀ Tr) (Nat.add_zero (2 * δ)) =
      ((CategoryTheory.Abelian.Ext.mk₀ ιℤ_S).comp
        (CategoryTheory.Abelian.Ext.mapExactFunctor pb_S
          ((z.comp (CategoryTheory.Abelian.Ext.mk₀ δ_bar_Y) (Nat.add_zero (2 * δ))).comp
            (CategoryTheory.Abelian.Ext.mk₀ Tr) (Nat.add_zero (2 * δ))))
        (Nat.zero_add (2 * δ))).comp
        (CategoryTheory.Abelian.Ext.mk₀ πM_S) (Nat.add_zero (2 * δ))
    rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _
        (CategoryTheory.Abelian.Ext.mk₀ δ_bar'_Y) (CategoryTheory.Abelian.Ext.mk₀ Tr),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
      CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _
        (CategoryTheory.Abelian.Ext.mk₀ (bc₀ R_Y.Q₂))
        (CategoryTheory.Abelian.Ext.mk₀ (δ_bar'_Y ≫ Tr)),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
      h_mor,
      ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ (pb_S.map (δ_bar_Y ≫ Tr)) πM_S,
      ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _
        (CategoryTheory.Abelian.Ext.mk₀ (pb_S.map (δ_bar_Y ≫ Tr)))
        (CategoryTheory.Abelian.Ext.mk₀ πM_S),
      CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
        (CategoryTheory.Abelian.Ext.mk₀ ιℤ_S)
        (CategoryTheory.Abelian.Ext.mapExactFunctor pb_S z)
        (CategoryTheory.Abelian.Ext.mk₀ (pb_S.map (δ_bar_Y ≫ Tr))),
      ← CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀ pb_S (δ_bar_Y ≫ Tr),
      ← CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
      CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero z
        (CategoryTheory.Abelian.Ext.mk₀ δ_bar_Y) (CategoryTheory.Abelian.Ext.mk₀ Tr),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]

theorem weil_polyP1_max_cycle_leray_edge_package (Pd : ℕ → AlgebraicGeometry.Scheme.{u})
    (ℓ : ℕ) (hℓ_pos : 1 ≤ ℓ)
    (hCD : ∀ (δ r : ℕ)
        (F : CategoryTheory.Sheaf (Pd δ).smallEtaleTopology AddCommGrpCat.{u})
        (q : ℕ),
      (ℓ ^ r) • CategoryTheory.CategoryStruct.id F = 0 →
      2 * δ < q →
      Subsingleton (F.H q)) :
    ∃ E_edge : WeilLerayEdgeSystem Pd ℓ, WeilIsLerayEdgePkg Pd ℓ E_edge :=
by
  classical
  
  letI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨hSite0, -⟩ := weil_etale_site_pullback_exact_and_mod_prime_resolution.{u} 2
  obtain ⟨-, hConst0, -⟩ := weil_gysin_etale_constant_pullback_and_bc_mate.{u} (@hSite0)
  have sys : WeilEtaleSitePullbackSys.{u} := by
    intro Z₁ Z₂ h
    obtain ⟨hc, hr, hLim, hAdd_pb, hAdd_pf⟩ := hSite0 h
    letI : (weilEtaleSitePullback h).IsContinuous Z₂.smallEtaleTopology Z₁.smallEtaleTopology := hc
    letI : ((weilEtaleSitePullback h).sheafPushforwardContinuous
      AddCommGrpCat.{u} Z₂.smallEtaleTopology Z₁.smallEtaleTopology).IsRightAdjoint := hr
    have hColim : CategoryTheory.Limits.PreservesFiniteColimits
        ((weilEtaleSitePullback h).sheafPullback
          AddCommGrpCat.{u} Z₂.smallEtaleTopology Z₁.smallEtaleTopology) :=
      ⟨fun _ _ _ =>
        ((weilEtaleSitePullback h).sheafAdjunctionContinuous AddCommGrpCat.{u}
          Z₂.smallEtaleTopology Z₁.smallEtaleTopology).leftAdjoint_preservesColimits.preservesColimitsOfShape⟩
    exact ⟨hc, hr, hAdd_pb, hAdd_pf, hLim, hColim,
      fun {T₁} hT₁ {T₂} hT₂ A => @hConst0 Z₁ Z₂ h hc hr T₁ hT₁ T₂ hT₂ A⟩

  have hm_pos : ∀ r : ℕ, 1 ≤ ℓ ^ r := fun r => Nat.one_le_pow r ℓ hℓ_pos

  
  have hδ_uniq : ∀ {Y S : AlgebraicGeometry.Scheme.{u}} {f : Quiver.Hom Y S}
      {M : ℕ} {F : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}}
      (R : WeilTwoStepAcyclicRes Y S f M F)
      (δ₁ δ₂ : Quiver.Hom
        (letI := (sys f).hCont
         ((weilEtaleSitePullback f).sheafPushforwardContinuous
           AddCommGrpCat.{u} S.smallEtaleTopology Y.smallEtaleTopology).obj R.Q₂)
        (weilEtaleHigherDirectImage f 2 F)),
      WeilIsTwoStepDeltaBar sys R δ₁ →
      WeilIsTwoStepDeltaBar sys R δ₂ →
      δ₁ = δ₂ := by
    intro Y S f M F R δ₁ δ₂ h₁ h₂
    apply CategoryTheory.Sheaf.hom_ext
    apply CategoryTheory.NatTrans.ext
    funext V
    apply AddCommGrpCat.ext
    intro s
    exact (h₁ (Opposite.unop V) s).trans (h₂ (Opposite.unop V) s).symm

  have hPost_id : ∀ {Z : AlgebraicGeometry.Scheme.{u}}
      (E K : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
      (q : ℕ) (u : CategoryTheory.Abelian.Ext.{u} K E q),
      (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id E)).postcomp
        K (Nat.add_zero q) u = u := by
    intro Z E K q u
    change u.comp (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id E))
      (Nat.add_zero q) = u
    exact CategoryTheory.Abelian.Ext.comp_mk₀_id u

  have hR2_id : ∀ {Y S : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Y S)
      (F : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}),
      weilPolyP1HigherDirectImageMap f 2 (CategoryTheory.CategoryStruct.id F) =
        CategoryTheory.CategoryStruct.id (weilEtaleHigherDirectImage f 2 F) := by
    intro Y S f F
    let B := weilEtaleSitePullback f
    let F_cohom := CategoryTheory.Sheaf.cohomologyPresheafFunctor Y.smallEtaleTopology 2
    let Sh := CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}
    have h1 : F_cohom.map (CategoryTheory.CategoryStruct.id F) =
        CategoryTheory.CategoryStruct.id (F_cohom.obj F) := F_cohom.map_id F
    have h2 : CategoryTheory.Functor.whiskerLeft B.op
        (CategoryTheory.CategoryStruct.id (F_cohom.obj F)) =
        CategoryTheory.CategoryStruct.id (CategoryTheory.Functor.comp B.op (F_cohom.obj F)) :=
      ((CategoryTheory.Functor.whiskeringLeft _ _ _).obj B.op).map_id (F_cohom.obj F)
    exact (congrArg (fun u => Sh.map (CategoryTheory.Functor.whiskerLeft B.op u)) h1).trans
      ((congrArg Sh.map h2).trans (Sh.map_id _))

  
  obtain ⟨R_std, hInj_std, hLift_std⟩ :
      ∃ R_std : ∀ (δ r : ℕ) (Y : AlgebraicGeometry.Scheme.{u}) (f : Quiver.Hom Y (Pd δ))
          (F : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}),
          (ℓ ^ r) • CategoryTheory.CategoryStruct.id F = 0 →
          WeilTwoStepAcyclicRes Y (Pd δ) f (ℓ ^ r) F,
        (∀ δ r Y f F h_tor, WeilHasInjKernelTerms (ℓ ^ r) (R_std δ r Y f F h_tor)) ∧
        (∀ δ r Y f F h_tor
            {F₀ : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}}
            (R₀ : WeilTwoStepAcyclicRes Y (Pd δ) f (ℓ ^ r) F₀)
            (φ : Quiver.Hom F₀ F),
          Nonempty (WeilTwoStepResHom R₀ (R_std δ r Y f F h_tor) φ)) := by
    refine ⟨fun δ r Y f F h_tor =>
      Classical.choose (weil_etale_torsion_injKernel_twoStep_resolution_and_lift
        Y (Pd δ) f (ℓ ^ r) (hm_pos r) F h_tor), ?_, ?_⟩
    · intro δ r Y f F h_tor
      exact (Classical.choose_spec (weil_etale_torsion_injKernel_twoStep_resolution_and_lift
        Y (Pd δ) f (ℓ ^ r) (hm_pos r) F h_tor)).1
    · intro δ r Y f F h_tor F₀ R₀ φ
      exact (Classical.choose_spec (weil_etale_torsion_injKernel_twoStep_resolution_and_lift
        Y (Pd δ) f (ℓ ^ r) (hm_pos r) F h_tor)).2 R₀ φ

  obtain ⟨hEdge_ex, hEdge_nat⟩ :=
    weil_etale_twoStep_acyclic_leray_edge_equiv_and_hom_naturality.{u} sys

  obtain ⟨δ_std, E_edge, hδ_std, hSurj_std, hEq_std⟩ :
      ∃ (δ_std : ∀ (δ r : ℕ) (Y : AlgebraicGeometry.Scheme.{u}) (f : Quiver.Hom Y (Pd δ))
            (F : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u})
            (h_tor : (ℓ ^ r) • CategoryTheory.CategoryStruct.id F = 0),
            (∀ b : ℕ, 3 ≤ b → CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f b F)) →
            Quiver.Hom
              (letI := (sys f).hCont
               ((weilEtaleSitePullback f).sheafPushforwardContinuous AddCommGrpCat.{u}
                 (Pd δ).smallEtaleTopology Y.smallEtaleTopology).obj
                 (R_std δ r Y f F h_tor).Q₂)
              (weilEtaleHigherDirectImage f 2 F))
        (E_edge : WeilLerayEdgeSystem Pd ℓ),
        (∀ δ r Y f F h_tor hz,
          WeilIsTwoStepDeltaBar sys (R_std δ r Y f F h_tor) (δ_std δ r Y f F h_tor hz)) ∧
        (∀ δ r Y f F h_tor,
          (∀ b : ℕ, 3 ≤ b → CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f b F)) →
          Function.Surjective (weilTwoStepTheta sys δ (R_std δ r Y f F h_tor))) ∧
        (∀ δ r Y f F h_tor hz z,
          E_edge δ r Y f F h_tor hz
            (weilTwoStepTheta sys δ (R_std δ r Y f F h_tor) z) =
          weilTwoStepDeltaBarMapH (Pd δ) δ (δ_std δ r Y f F h_tor hz) z) := by
    let spec := fun (δ r : ℕ) (Y : AlgebraicGeometry.Scheme.{u}) (f : Quiver.Hom Y (Pd δ))
        (F : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u})
        (h_tor : (ℓ ^ r) • CategoryTheory.CategoryStruct.id F = 0)
        (hz : ∀ b : ℕ, 3 ≤ b → CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f b F)) =>
      hEdge_ex δ (ℓ ^ r) Y (Pd δ) f (fun E q hE hq => hCD δ r E q hE hq) F hz
        (R_std δ r Y f F h_tor)
    refine ⟨fun δ r Y f F h_tor hz => Classical.choose (spec δ r Y f F h_tor hz),
      fun δ r Y f F h_tor hz => Classical.choose (Classical.choose_spec (spec δ r Y f F h_tor hz)),
      ?_, ?_, ?_⟩
    · intro δ r Y f F h_tor hz
      exact (Classical.choose_spec (Classical.choose_spec (spec δ r Y f F h_tor hz))).1
    · intro δ r Y f F h_tor hz
      exact (Classical.choose_spec (Classical.choose_spec (spec δ r Y f F h_tor hz))).2.1
    · intro δ r Y f F h_tor hz z
      exact (Classical.choose_spec (Classical.choose_spec (spec δ r Y f F h_tor hz))).2.2 z

  
  have hEdge_any : ∀ (δ r : ℕ) (Y : AlgebraicGeometry.Scheme.{u}) (f : Quiver.Hom Y (Pd δ))
      (F : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u})
      (h_tor : (ℓ ^ r) • CategoryTheory.CategoryStruct.id F = 0)
      (hz : ∀ b : ℕ, 3 ≤ b → CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f b F))
      (R' : WeilTwoStepAcyclicRes Y (Pd δ) f (ℓ ^ r) F)
      (δ' : Quiver.Hom
        (letI := (sys f).hCont
         ((weilEtaleSitePullback f).sheafPushforwardContinuous
           AddCommGrpCat.{u} (Pd δ).smallEtaleTopology Y.smallEtaleTopology).obj R'.Q₂)
        (weilEtaleHigherDirectImage f 2 F)),
      WeilIsTwoStepDeltaBar sys R' δ' →
      Function.Surjective (weilTwoStepTheta sys δ R') ∧
      ∀ z, E_edge δ r Y f F h_tor hz (weilTwoStepTheta sys δ R' z) =
        weilTwoStepDeltaBarMapH (Pd δ) δ δ' z := by
    intro δ r Y f F h_tor hz R' δ' hδ'
    obtain ⟨δ'', e', hδ'', hSurj', hEq'⟩ :=
      hEdge_ex δ (ℓ ^ r) Y (Pd δ) f (fun E q hE hq => hCD δ r E q hE hq) F hz R'
    have hδ_eq : δ' = δ'' := hδ_uniq R' δ' δ'' hδ' hδ''
    subst hδ_eq
    obtain ⟨Φ⟩ := hLift_std δ r Y f F h_tor R' (CategoryTheory.CategoryStruct.id F)
    refine ⟨hSurj', fun z => ?_⟩
    have hNat := hEdge_nat δ (ℓ ^ r) (ℓ ^ r) Y (Pd δ) f F F
      (CategoryTheory.CategoryStruct.id F) R' (R_std δ r Y f F h_tor) Φ
      δ' (δ_std δ r Y f F h_tor hz) e' (E_edge δ r Y f F h_tor hz)
      hδ' (hδ_std δ r Y f F h_tor hz) hSurj' hEq' (hEq_std δ r Y f F h_tor hz)
      (weilTwoStepTheta sys δ R' z)
    rw [hPost_id, hR2_id f F, hPost_id] at hNat
    exact hNat.trans (hEq' z)

  
  refine ⟨E_edge, ?_, ?_, ?_⟩
  · 
    dsimp only [WeilIsLerayEdgeNatural]
    intro δ r₁ r₂ Y f F₁ F₂ φ h₁ h₂ hz₁ hz₂ x
    let r_max := max r₁ r₂
    let M := ℓ ^ r_max
    have hTor_up : ∀ {r₀ : ℕ} (hr₀ : r₀ ≤ r_max)
        {K : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}},
        (ℓ ^ r₀) • CategoryTheory.CategoryStruct.id K = 0 →
        M • CategoryTheory.CategoryStruct.id K = 0 := by
      intro r₀ hr₀ K hK
      obtain ⟨c, hc⟩ := pow_dvd_pow ℓ hr₀
      change (ℓ ^ r_max) • CategoryTheory.CategoryStruct.id K = 0
      rw [hc, mul_nsmul, hK, nsmul_zero]
    let R₁ := R_std δ r₁ Y f F₁ h₁
    let R₂ := R_std δ r₂ Y f F₂ h₂
    let R₁_M : WeilTwoStepAcyclicRes Y (Pd δ) f M F₁ :=
      { A₀ := R₁.A₀
        Q₁ := R₁.Q₁
        A₁ := R₁.A₁
        Q₂ := R₁.Q₂
        u₀ := R₁.u₀
        v₀ := R₁.v₀
        h₀ := R₁.h₀
        hSE₀ := R₁.hSE₀
        u₁ := R₁.u₁
        v₁ := R₁.v₁
        h₁ := R₁.h₁
        hSE₁ := R₁.hSE₁
        hTor_F := hTor_up (Nat.le_max_left r₁ r₂) R₁.hTor_F
        hTor_A₀ := hTor_up (Nat.le_max_left r₁ r₂) R₁.hTor_A₀
        hTor_Q₁ := hTor_up (Nat.le_max_left r₁ r₂) R₁.hTor_Q₁
        hTor_A₁ := hTor_up (Nat.le_max_left r₁ r₂) R₁.hTor_A₁
        hTor_Q₂ := hTor_up (Nat.le_max_left r₁ r₂) R₁.hTor_Q₂
        hGlob_A₀ := R₁.hGlob_A₀
        hGlob_A₁ := R₁.hGlob_A₁
        hDir_A₀ := R₁.hDir_A₀
        hDir_A₁ := R₁.hDir_A₁ }
    let R₂_M : WeilTwoStepAcyclicRes Y (Pd δ) f M F₂ :=
      { A₀ := R₂.A₀
        Q₁ := R₂.Q₁
        A₁ := R₂.A₁
        Q₂ := R₂.Q₂
        u₀ := R₂.u₀
        v₀ := R₂.v₀
        h₀ := R₂.h₀
        hSE₀ := R₂.hSE₀
        u₁ := R₂.u₁
        v₁ := R₂.v₁
        h₁ := R₂.h₁
        hSE₁ := R₂.hSE₁
        hTor_F := hTor_up (Nat.le_max_right r₁ r₂) R₂.hTor_F
        hTor_A₀ := hTor_up (Nat.le_max_right r₁ r₂) R₂.hTor_A₀
        hTor_Q₁ := hTor_up (Nat.le_max_right r₁ r₂) R₂.hTor_Q₁
        hTor_A₁ := hTor_up (Nat.le_max_right r₁ r₂) R₂.hTor_A₁
        hTor_Q₂ := hTor_up (Nat.le_max_right r₁ r₂) R₂.hTor_Q₂
        hGlob_A₀ := R₂.hGlob_A₀
        hGlob_A₁ := R₂.hGlob_A₁
        hDir_A₀ := R₂.hDir_A₀
        hDir_A₁ := R₂.hDir_A₁ }
    obtain ⟨R_aux, -, hLift_aux⟩ :=
      weil_etale_torsion_injKernel_twoStep_resolution_and_lift
        Y (Pd δ) f M (hm_pos r_max) F₂ (hTor_up (Nat.le_max_right r₁ r₂) h₂)
    obtain ⟨δ_aux, e_aux, hδ_aux, -, hEq_aux⟩ :=
      hEdge_ex δ M Y (Pd δ) f (fun E q hE hq => hCD δ r_max E q hE hq) F₂ hz₂ R_aux
    obtain ⟨Φ_id⟩ := hLift_aux R₂_M (CategoryTheory.CategoryStruct.id F₂)
    obtain ⟨Φ_φ⟩ := hLift_aux R₁_M φ
    have hEq_e2 : ∀ y : F₂.H (2 * (δ + 1)), e_aux y = E_edge δ r₂ Y f F₂ h₂ hz₂ y := by
      intro y
      have hNat_id := hEdge_nat δ M M Y (Pd δ) f F₂ F₂
        (CategoryTheory.CategoryStruct.id F₂) R₂_M R_aux Φ_id
        (δ_std δ r₂ Y f F₂ h₂ hz₂) δ_aux (E_edge δ r₂ Y f F₂ h₂ hz₂) e_aux
        (hδ_std δ r₂ Y f F₂ h₂ hz₂) hδ_aux (hSurj_std δ r₂ Y f F₂ h₂ hz₂)
        (hEq_std δ r₂ Y f F₂ h₂ hz₂) hEq_aux y
      rw [hPost_id, hR2_id f F₂, hPost_id] at hNat_id
      exact hNat_id
    have hNat_φ := hEdge_nat δ M M Y (Pd δ) f F₁ F₂ φ R₁_M R_aux Φ_φ
      (δ_std δ r₁ Y f F₁ h₁ hz₁) δ_aux (E_edge δ r₁ Y f F₁ h₁ hz₁) e_aux
      (hδ_std δ r₁ Y f F₁ h₁ hz₁) hδ_aux (hSurj_std δ r₁ Y f F₁ h₁ hz₁)
      (hEq_std δ r₁ Y f F₁ h₁ hz₁) hEq_aux x
    rw [hEq_e2] at hNat_φ
    exact hNat_φ

  · 
    intro δ r
    dsimp only [WeilIsLerayEdgePushforwardAt]
    intro W_top Y g f h_Wf hg hCont_g hAdj_g
      _hAdd_g _hLim_g _hColim_g T_W hT_W T_Y hT_Y ιℤ_g hι₁ hι₂
      G hG_tor hpf_tor hG_acyc hz_gf hz_f
