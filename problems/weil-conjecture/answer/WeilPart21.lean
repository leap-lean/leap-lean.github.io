            ((𝒢₀.obj.map (p_KE b).op).hom z₁)
        rw [← h𝒢_comp _ (p_KE a) z₁, ← h𝒢_comp _ (p_KE b) z₁,
          CategoryTheory.Limits.pullback.condition]
      rcases h𝒢_arr x₀ hx₀ with ⟨z₀, _, hz₀_uniq⟩
      exact (hz₀_uniq z₁ (fun _ => rfl)).trans
        (hz₀_uniq z₂ (fun a => (hz_eq a).symm)).symm

  
  have hS4 : ∀ {I : Type u} [Preorder I] [Nonempty I]
      (hDir : ∀ i j : I, ∃ k : I, i ≤ k ∧ j ≤ k)
      (m : ℕ)
      (G_A : I → Type u) [∀ i, AddCommGroup (G_A i)]
      (G_B : Fin m → I → Type u) [∀ a i, AddCommGroup (G_B a i)]
      (G_C : Fin m → Fin m → I → Type u) [∀ a b i, AddCommGroup (G_C a b i)]
