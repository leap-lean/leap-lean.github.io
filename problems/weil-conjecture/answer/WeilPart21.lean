    let _ : CategoryTheory.MorphismProperty.IsStableUnderComposition P_et :=
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    have hTopEq : S_E.smallEtaleTopology =
        (AlgebraicGeometry.Scheme.smallPretopology (S := S_E) P_et P_et).toGrothendieck :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) S_E le_rfl
    rw [hTopEq]
    apply (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology B_et _).mpr
    intro x
    obtain ⟨i, y, hy⟩ := hSurj x
    exact ⟨Y_et i, g_et i, y, CategoryTheory.Sieve.ofArrows_mk Y_et g_et i, hEt i, hy⟩

  
  have hSubcoverRings :
      ∃ (m : ℕ) (V : Fin m → (AlgebraicGeometry.Spec (CommRingCat.of L_inf)).AffineEtale)
        (p : ∀ a : Fin m, V a ⟶ Y)
        (A_inf : Type u) (_ : CommRing A_inf) (_ : Algebra L_inf A_inf)
        (_ : Algebra.Etale L_inf A_inf)
        (B_inf : Fin m → Type u) (_ : ∀ a, CommRing (B_inf a))
        (_ : ∀ a, Algebra L_inf (B_inf a)) (_ : ∀ a, Algebra.Etale L_inf (B_inf a))
        (ψ_inf : ∀ a : Fin m, A_inf →ₐ[L_inf] B_inf a),
