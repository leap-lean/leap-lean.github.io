          e₂ (weilTwoStepTheta sys δ R₂ z) = weilTwoStepDeltaBarMapH S δ δ_bar₂ z) →
        ∀ x : F₁.H (2 * (δ + 1)),
          e₂ ((CategoryTheory.Abelian.Ext.mk₀ φ).postcomp Fℤ_Y
