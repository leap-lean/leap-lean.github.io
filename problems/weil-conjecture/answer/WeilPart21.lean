            = (a ≫ pb_g.map πℤ_π) ≫ (πℤ_g ≫ ιℤ_g) := by
                rw [hιg2, CategoryTheory.Category.comp_id]
          _ = ((a ≫ pb_g.map πℤ_π) ≫ πℤ_g) ≫ ιℤ_g :=
                (CategoryTheory.Category.assoc _ _ _).symm
          _ = ιℤ_g := by rw [h1, CategoryTheory.Category.id_comp]
