    have h1 : ι_model 𝒢 M₀ hFD₀ A₀ M₂ hFD₂ (le_trans hle₁ hle₁₂) ((𝒢.obj.map p₁₂.op).hom x) =
        ι_model 𝒢 M₀ hFD₀ A₀ M₂ hFD₂ (le_trans hle₁ hle₁₂)
          ((𝒢.obj.map (G_K.map q₁₂).op).hom x) :=
      congrArg (fun k : W_M₂ ⟶ W_M₁ => ι_model 𝒢 M₀ hFD₀ A₀ M₂ hFD₂ (le_trans hle₁ hle₁₂)
        ((𝒢.obj.map k.op).hom x)) hq_map.symm
    have h2 : ι_model 𝒢 M₀ hFD₀ A₀ M₂ hFD₂ (le_trans hle₁ hle₁₂)
          ((𝒢.obj.map (G_K.map q₁₂).op).hom x) =
        ι_model 𝒢 M₀ hFD₀ A₀ M₁ hFD₁ hle₁ x :=
      congrArg (Θ 𝒢 (mkY_L M₀ A₀)).hom.hom
        (hκ_compat (G_K.op ⋙ 𝒢.obj) M₀ hFD₀ A₀ M₁ M₂ hFD₁ hFD₂ hle₁ hle₁₂ q₁₂ hq_left x)
    exact h1.trans h2
  · intro 𝒢 M₀ hFD₀ A₀ _ _ _
    obtain ⟨hSurj, hKer⟩ := hκ_colim (G_K.op ⋙ 𝒢.obj) M₀ hFD₀ A₀
    let Y_L := mkY_L M₀ A₀
    refine ⟨?_, ?_⟩
    · intro y
      obtain ⟨M, hFD, hle, x, hx⟩ := hSurj ((Θ 𝒢 Y_L).inv.hom y)
