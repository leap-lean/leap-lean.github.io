    have hcard_fin : Cardinal.mk (ULift.{u} (Fin (e + 1))) = ((e + 1 : ℕ) : Cardinal.{u}) := by
      simp
    obtain ⟨e_ulift⟩ := Cardinal.eq.mp (hcard_fin.trans hcard_s.symm)
    let e_idx : Fin (e + 1) ≃ ↥s_tr := Equiv.ulift.symm.trans e_ulift
    let b : Fin (e + 1) → K := Subtype.val ∘ e_idx
    obtain ⟨hs_indep, hs_alg⟩ :=
      isTranscendenceBasis_iff_algebraicIndependent_isAlgebraic.mp hs_tr
    have hb_indep : AlgebraicIndependent κ b := hs_indep.comp e_idx e_idx.injective
    have hrange_b : Set.range b = Set.range (Subtype.val : ↥s_tr → K) := by
      rw [Set.range_comp, e_idx.range_eq_univ, Set.image_univ]
    have hb_alg : Algebra.IsAlgebraic (↥(Algebra.adjoin κ (Set.range b))) K := by
      rwa [hrange_b]

    let b₀ : Fin e → K := b ∘ Fin.castSucc
    let t_K : K := b (Fin.last e)
    let f_opt : Option (Fin e) → Fin (e + 1) := fun o => o.elim (Fin.last e) Fin.castSucc
    have hf_opt_inj : Function.Injective f_opt := by
      rintro (_ | i) (_ | j) h
      · rfl
      · exact absurd h.symm (Fin.castSucc_ne_last j)
      · exact absurd h (Fin.castSucc_ne_last i)
      · exact congrArg some (Fin.castSucc_inj.mp h)
    have hopt_indep : AlgebraicIndependent κ (fun o : Option (Fin e) => o.elim t_K b₀) := by
      have hcomp := hb_indep.comp f_opt hf_opt_inj
      convert hcomp using 1
      ext (_ | i) <;> rfl
    obtain ⟨hb₀_indep, ht_alg_tr⟩ := AlgebraicIndependent.option_iff.mp hopt_indep

    let K₀_if : IntermediateField κ K := IntermediateField.adjoin κ (Set.range b₀)
    let K₀ : Type u := ↥K₀_if
    have ht_K₀ : Transcendental K₀ t_K :=
      IntermediateField.transcendental_adjoin_iff.mpr ht_alg_tr

    have hTrK₀ : Algebra.trdeg κ K₀ ≤ (e : Cardinal.{u}) := by
      let b₀' : Fin e → K₀ := fun i =>
        ⟨b₀ i, IntermediateField.subset_adjoin κ (Set.range b₀) ⟨i, rfl⟩⟩
      have hb₀'_indep : AlgebraicIndependent κ b₀' := by
        rw [algebraicIndependent_iff] at hb₀_indep ⊢
        intro p hp
        apply hb₀_indep p
        have hcomp : K₀_if.val.comp (MvPolynomial.aeval b₀') = MvPolynomial.aeval b₀ :=
          MvPolynomial.algHom_ext fun i => by simp [b₀', b₀]
        simpa [← DFunLike.congr_fun hcomp p] using congrArg K₀_if.val hp
      let L₀_top : IntermediateField κ K₀ := IntermediateField.adjoin κ (Set.range b₀')
      have hL₀_eq_top : L₀_top = ⊤ := by
        rw [eq_top_iff]
        intro y _
        have hy_map : y.1 ∈ L₀_top.map K₀_if.val := by
          have hle : K₀_if ≤ L₀_top.map K₀_if.val := by
            rw [IntermediateField.adjoin_le_iff]
            rintro _ ⟨i, rfl⟩
            exact ⟨b₀' i, IntermediateField.subset_adjoin κ (Set.range b₀') ⟨i, rfl⟩, rfl⟩
          exact hle y.2
        rcases hy_map with ⟨z, hz, hzy⟩
        rwa [← K₀_if.val.injective hzy]
      have hAlg_if : Algebra.IsAlgebraic ↥L₀_top K₀ := by
        refine ⟨fun y => ?_⟩
        let y₀ : ↥L₀_top := ⟨y, by rw [hL₀_eq_top]; trivial⟩
        exact ⟨Polynomial.X - Polynomial.C y₀, Polynomial.X_sub_C_ne_zero y₀, by simp [y₀]⟩
      have hAlg_sub : Algebra.IsAlgebraic (↥(Algebra.adjoin κ (Set.range b₀'))) K₀ :=
        IntermediateField.isAlgebraic_adjoin_iff_top.mp hAlg_if
      have hb₀'_tb : IsTranscendenceBasis κ b₀' :=
        isTranscendenceBasis_iff_algebraicIndependent_isAlgebraic.mpr ⟨hb₀'_indep, hAlg_sub⟩
      have htr_eq := hb₀'_tb.lift_cardinalMk_eq_trdeg
      have htr_eq' : (e : Cardinal.{u}) = Algebra.trdeg κ K₀ := by
        simpa using htr_eq
      exact le_of_eq htr_eq'.symm

    let F_t_if : IntermediateField K₀ K := IntermediateField.adjoin K₀ ({t_K} : Set K)
    let F_t : Type u := ↥F_t_if
    let t : F_t :=
      ⟨t_K, IntermediateField.subset_adjoin K₀ ({t_K} : Set K) (Set.mem_singleton t_K)⟩

    have ht_tr : Transcendental K₀ t := by
      rw [transcendental_iff] at ht_K₀ ⊢
      intro p hp
      apply ht_K₀ p
      have hcomp : F_t_if.val.comp (Polynomial.aeval t) = Polynomial.aeval t_K :=
        Polynomial.algHom_ext (by simp [t])
      simpa [← DFunLike.congr_fun hcomp p] using congrArg F_t_if.val hp

    have ht_gen : IntermediateField.adjoin K₀ ({t} : Set F_t) = ⊤ := by
      rw [eq_top_iff]
      intro y _
      have hy_map : y.1 ∈ (IntermediateField.adjoin K₀ ({t} : Set F_t)).map F_t_if.val := by
        have hle : F_t_if ≤ (IntermediateField.adjoin K₀ ({t} : Set F_t)).map F_t_if.val := by
          rw [IntermediateField.adjoin_le_iff]
          rintro _ rfl
          exact ⟨t, IntermediateField.subset_adjoin K₀ ({t} : Set F_t) (Set.mem_singleton t), rfl⟩
        exact hle y.2
      rcases hy_map with ⟨z, hz, hzy⟩
      rwa [← F_t_if.val.injective hzy]

    have hFinDim_Ft_K : FiniteDimensional F_t K := by
      let K_b_if : IntermediateField κ K := IntermediateField.adjoin κ (Set.range b)
      have hb_alg_if : Algebra.IsAlgebraic ↥K_b_if K :=
        IntermediateField.isAlgebraic_adjoin_iff_top.mpr hb_alg
      let _ : Algebra κ F_t := RingHom.toAlgebra ((algebraMap K₀ F_t).comp (algebraMap κ K₀))
      have : IsScalarTower κ F_t K :=
        IsScalarTower.of_algebraMap_eq' (IsScalarTower.algebraMap_eq κ K₀ K)
      have hle_Kb_Ft : K_b_if ≤ F_t_if.restrictScalars κ := by
        rw [IntermediateField.adjoin_le_iff]
        rintro _ ⟨k, rfl⟩
        refine Fin.lastCases ?_ (fun i => ?_) k
        · exact t.2
        · change b₀ i ∈ F_t_if
          have hb₀i : b₀ i = algebraMap K₀ K
              ⟨b₀ i, IntermediateField.subset_adjoin κ (Set.range b₀) ⟨i, rfl⟩⟩ := rfl
          rw [hb₀i]
          exact F_t_if.algebraMap_mem _
      let ι_Kb_Ft : ↥K_b_if →+* F_t :=
        { toFun := fun x => ⟨x.1, hle_Kb_Ft x.2⟩
          map_one' := rfl
          map_mul' := fun _ _ => rfl
          map_zero' := rfl
          map_add' := fun _ _ => rfl }
      let _ : Algebra ↥K_b_if F_t := ι_Kb_Ft.toAlgebra
      have : IsScalarTower ↥K_b_if F_t K := IsScalarTower.of_algebraMap_eq' rfl
      have : Algebra.IsAlgebraic F_t K :=
        @Algebra.IsAlgebraic.tower_top ↥K_b_if F_t K _ _ _ _ _ _ _ hb_alg_if
      have : Algebra.IsIntegral F_t K := Algebra.IsAlgebraic.isIntegral
      obtain ⟨S_fg, hS_fg⟩ := hFG
      have hAdj_top : IntermediateField.adjoin F_t (S_fg : Set K) = ⊤ := by
        rw [eq_top_iff]
        intro x _
        have hx_top : x ∈ (⊤ : IntermediateField κ K) := IntermediateField.mem_top
        rw [← hS_fg] at hx_top
        have hle_fg : IntermediateField.adjoin κ (S_fg : Set K) ≤
            (IntermediateField.adjoin F_t (S_fg : Set K)).restrictScalars κ :=
          IntermediateField.adjoin_le_iff.mpr (IntermediateField.subset_adjoin F_t (S_fg : Set K))
        exact hle_fg hx_top
      have hFin_sub : FiniteDimensional F_t ↥(IntermediateField.adjoin F_t (S_fg : Set K)) :=
        IntermediateField.finiteDimensional_adjoin (fun x _ => Algebra.IsIntegral.isIntegral x)
      rw [hAdj_top] at hFin_sub
      exact LinearEquiv.finiteDimensional
        (IntermediateField.topEquiv (F := F_t) (E := K)).toLinearEquiv

    exact ⟨K₀, F_t, inferInstance, inferInstance, inferInstance, inferInstance,
      inferInstance, inferInstance, inferInstance, inferInstance,
      t, hTrK₀, ht_tr, ht_gen, hFinDim_Ft_K⟩

  
  
  
  have hPillar2 :
      ∀ (K₀ κ₁ F_t : Type u) [Field K₀] [Field κ₁] [Algebra K₀ κ₁] [Algebra.IsAlgebraic K₀ κ₁]
        [Field F_t] [Algebra K₀ F_t] (t : F_t),
        Transcendental K₀ t →
        IntermediateField.adjoin K₀ ({t} : Set F_t) = ⊤ →
        Algebra.trdeg κ₁ (FractionRing (Polynomial κ₁)) ≤ 1 ∧
        Nonempty (FractionRing (Polynomial κ₁) ≃ₐ[κ₁] TensorProduct K₀ κ₁ F_t) := by
    intro K₀ κ₁ F_t _ _ _ _ _ _ t ht_tr ht_gen

    have hTrB : Algebra.trdeg κ₁ (FractionRing (Polynomial κ₁)) ≤ 1 := by
      have : FaithfulSMul κ₁ (Polynomial κ₁) :=
        (faithfulSMul_iff_algebraMap_injective κ₁ (Polynomial κ₁)).mpr Polynomial.C_injective
      have : FaithfulSMul (Polynomial κ₁) (FractionRing (Polynomial κ₁)) :=
        (faithfulSMul_iff_algebraMap_injective (Polynomial κ₁) (FractionRing (Polynomial κ₁))).mpr
          (IsFractionRing.injective (Polynomial κ₁) (FractionRing (Polynomial κ₁)))
      have : Algebra.IsAlgebraic (Polynomial κ₁) (FractionRing (Polynomial κ₁)) := by
        refine ⟨fun z => ?_⟩
        refine (IsFractionRing.isAlgebraic_iff (Polynomial κ₁)
          (FractionRing (Polynomial κ₁)) (FractionRing (Polynomial κ₁))).mpr ?_
        exact ⟨Polynomial.X - Polynomial.C z, Polynomial.X_sub_C_ne_zero z, by simp⟩
      have htr_eq : Algebra.trdeg κ₁ (FractionRing (Polynomial κ₁)) = 1 := by
        rw [← _root_.trdeg_add_eq κ₁ (Polynomial κ₁) (A := FractionRing (Polynomial κ₁)),
          Polynomial.trdeg_of_isDomain,
          @_root_.trdeg_eq_zero (Polynomial κ₁) (FractionRing (Polynomial κ₁)), add_zero]
      exact le_of_eq htr_eq

    let aeval_t : Polynomial K₀ →ₐ[K₀] F_t := Polynomial.aeval t
    have haeval_ker : aeval_t.toLinearMap.ker = ⊥ := by
      rw [LinearMap.ker_eq_bot]
      intro p₁ p₂ hp
      apply sub_eq_zero.mp
      exact transcendental_iff.mp ht_tr (p₁ - p₂) (by simpa [aeval_t, map_sub, sub_eq_zero] using hp)
    obtain ⟨r_inv, hr_inv⟩ :=
      LinearMap.exists_leftInverse_of_injective aeval_t.toLinearMap haeval_ker

    have hι_inj : ∀ (M : Type u) [CommRing M] [Algebra K₀ M],
        Function.Injective
          (Polynomial.aeval ((1 : M) ⊗ₜ[K₀] t) : Polynomial M →ₐ[M] TensorProduct K₀ M F_t) := by
      intro M _ _ P₁ P₂ hP
      apply sub_eq_zero.mp
      set P := P₁ - P₂
      have hP0 : (Polynomial.aeval ((1 : M) ⊗ₜ[K₀] t) :
          Polynomial M →ₐ[M] TensorProduct K₀ M F_t) P = 0 := by
        simpa [P, map_sub, sub_eq_zero] using hP
      ext m
      rw [Polynomial.coeff_zero]
      by_cases hm : m ∈ P.support
      · let φ_m : F_t →ₗ[K₀] K₀ := (Polynomial.lcoeff K₀ m).comp r_inv
        have hφ_pow : ∀ k : ℕ, φ_m (t ^ k) = if m = k then 1 else 0 := by
          intro k
          have htk : t ^ k = aeval_t (Polynomial.X ^ k) := by simp [aeval_t]
          have hrinv : r_inv (t ^ k) = (Polynomial.X ^ k : Polynomial K₀) := by
            rw [htk]
            exact LinearMap.congr_fun hr_inv (Polynomial.X ^ k)
          change Polynomial.lcoeff K₀ m (r_inv (t ^ k)) = _
          rw [hrinv]
          exact Polynomial.coeff_X_pow k m
        let ev_m : TensorProduct K₀ M F_t →ₗ[K₀] M :=
          (TensorProduct.rid K₀ M).toLinearMap.comp (LinearMap.lTensor M φ_m)
        have hpow_tmul : ∀ k : ℕ,
            ((1 : M) ⊗ₜ[K₀] t) ^ k = (1 : M) ⊗ₜ[K₀] (t ^ k) := by
          intro k
          induction k with
          | zero =>
            rw [pow_zero, pow_zero]
            exact Algebra.TensorProduct.one_def
          | succ k ih =>
            rw [pow_succ, pow_succ, ih, Algebra.TensorProduct.tmul_mul_tmul, one_mul]
        have hP_sum : (Polynomial.aeval ((1 : M) ⊗ₜ[K₀] t) :
            Polynomial M →ₐ[M] TensorProduct K₀ M F_t) P =
            ∑ k ∈ P.support, (P.coeff k) ⊗ₜ[K₀] (t ^ k) := by
          conv_lhs => rw [Polynomial.as_sum_support_C_mul_X_pow P]
          rw [map_sum]
          refine Finset.sum_congr rfl fun k _ => ?_
          rw [map_mul, Polynomial.aeval_C, Algebra.TensorProduct.algebraMap_apply,
            Algebra.algebraMap_self, RingHom.id_apply, map_pow, Polynomial.aeval_X,
            hpow_tmul, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
        have hev0 : ev_m ((Polynomial.aeval ((1 : M) ⊗ₜ[K₀] t) :
            Polynomial M →ₐ[M] TensorProduct K₀ M F_t) P) = 0 := by
          rw [hP0, map_zero]
        rw [hP_sum, map_sum] at hev0
        have hev_eq : (∑ k ∈ P.support, ev_m ((P.coeff k) ⊗ₜ[K₀] (t ^ k))) = P.coeff m := by
          rw [Finset.sum_eq_single m]
          · change (TensorProduct.rid K₀ M) ((P.coeff m) ⊗ₜ[K₀] φ_m (t ^ m)) = P.coeff m
            rw [hφ_pow m]
            simp
          · intro k _ hkm
            change (TensorProduct.rid K₀ M) ((P.coeff k) ⊗ₜ[K₀] φ_m (t ^ k)) = 0
            rw [hφ_pow k]
            simp [Ne.symm hkm]
          · intro hm_abs
            exact absurd hm hm_abs
        exact hev_eq.symm.trans hev0
      · exact Polynomial.notMem_support_iff.mp hm

    have hFt_rat : ∀ y : F_t, ∃ p q : Polynomial K₀, q ≠ 0 ∧ aeval_t q * y = aeval_t p := by
      intro y
      have hy : y ∈ IntermediateField.adjoin K₀ ({t} : Set F_t) := by
        rw [ht_gen]; exact IntermediateField.mem_top
      obtain ⟨r, hr, s, hs, rfl⟩ := IntermediateField.mem_adjoin_iff_div.mp hy
      rw [Algebra.adjoin_singleton_eq_range_aeval] at hr hs
      rcases hr with ⟨p₀, rfl⟩
      rcases hs with ⟨q₀, rfl⟩
      by_cases hq₀ : q₀ = 0
      · refine ⟨0, 1, one_ne_zero, ?_⟩
        simp [aeval_t, hq₀]
      · have hsq_ne : aeval_t q₀ ≠ 0 := mt (transcendental_iff.mp ht_tr q₀) hq₀
        exact ⟨p₀, q₀, hq₀, mul_div_cancel₀ (aeval_t p₀) hsq_ne⟩

    have h_map_aeval : ∀ (M : Type u) [CommRing M] [Algebra K₀ M] (p : Polynomial K₀),
        (Polynomial.aeval ((1 : M) ⊗ₜ[K₀] t) : Polynomial M →ₐ[M] TensorProduct K₀ M F_t)
          (p.map (algebraMap K₀ M)) = (1 : M) ⊗ₜ[K₀] aeval_t p := by
      intro M _ _ p
      rw [Polynomial.aeval_map_algebraMap M ((1 : M) ⊗ₜ[K₀] t) p]
      have hcomp : (Algebra.TensorProduct.includeRight : F_t →ₐ[K₀] TensorProduct K₀ M F_t).comp
          aeval_t = Polynomial.aeval ((1 : M) ⊗ₜ[K₀] t) :=
        Polynomial.algHom_ext (by simp [aeval_t])
      exact (DFunLike.congr_fun hcomp p).symm

    have hClear : ∀ (M : Type u) [CommRing M] [Algebra K₀ M] (z : TensorProduct K₀ M F_t),
        ∃ (Q : Polynomial K₀), Q ≠ 0 ∧ ∃ (P : Polynomial M),
          ((1 : M) ⊗ₜ[K₀] aeval_t Q) * z =
            (Polynomial.aeval ((1 : M) ⊗ₜ[K₀] t) : Polynomial M →ₐ[M] TensorProduct K₀ M F_t) P := by
      intro M _ _ z
      induction z using TensorProduct.induction_on with
      | zero => exact ⟨1, one_ne_zero, 0, by simp⟩
      | tmul c y =>
        obtain ⟨p, q, hq, hpq⟩ := hFt_rat y
        refine ⟨q, hq, Polynomial.C c * p.map (algebraMap K₀ M), ?_⟩
        rw [map_mul, Polynomial.aeval_C, Algebra.TensorProduct.algebraMap_apply,
          Algebra.algebraMap_self, RingHom.id_apply, h_map_aeval,
          Algebra.TensorProduct.tmul_mul_tmul, Algebra.TensorProduct.tmul_mul_tmul,
          one_mul, hpq, mul_one, one_mul]
      | add z₁ z₂ ih₁ ih₂ =>
        obtain ⟨Q₁, hQ₁, P₁, h₁⟩ := ih₁
        obtain ⟨Q₂, hQ₂, P₂, h₂⟩ := ih₂
        refine ⟨Q₁ * Q₂, mul_ne_zero hQ₁ hQ₂,
          Q₂.map (algebraMap K₀ M) * P₁ + Q₁.map (algebraMap K₀ M) * P₂, ?_⟩
        simp only [map_add, map_mul, h_map_aeval]
        rw [← h₁, ← h₂]
        have hmul_tmul : ((1 : M) ⊗ₜ[K₀] (aeval_t Q₁ * aeval_t Q₂)) =
            ((1 : M) ⊗ₜ[K₀] aeval_t Q₁) * ((1 : M) ⊗ₜ[K₀] aeval_t Q₂) := by
          rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul]
        rw [hmul_tmul]
        ring

    have hUnit_fin : ∀ (E : Type u) [Field E] [Algebra K₀ E] [FiniteDimensional K₀ E]
        (z : TensorProduct K₀ E F_t), z ≠ 0 → IsUnit z := by
      intro E _ _ _ z hz
      have hNontriv_AE : Nontrivial (TensorProduct K₀ E F_t) :=
        ⟨⟨1, 0, fun h10 => one_ne_zero (hι_inj E (by rw [map_one, map_zero]; exact h10))⟩⟩
      have hNoZero_AE : NoZeroDivisors (TensorProduct K₀ E F_t) := by
        refine ⟨fun {z₁ z₂} hz12 => ?_⟩
        obtain ⟨Q₁, hQ₁, P₁, h₁⟩ := hClear E z₁
        obtain ⟨Q₂, hQ₂, P₂, h₂⟩ := hClear E z₂
        have hP12 : (Polynomial.aeval ((1 : E) ⊗ₜ[K₀] t) :
            Polynomial E →ₐ[E] TensorProduct K₀ E F_t) (P₁ * P₂) = 0 := by
          rw [map_mul, ← h₁, ← h₂]
          calc (((1 : E) ⊗ₜ[K₀] aeval_t Q₁) * z₁) * (((1 : E) ⊗ₜ[K₀] aeval_t Q₂) * z₂)
              = (((1 : E) ⊗ₜ[K₀] aeval_t Q₁) * ((1 : E) ⊗ₜ[K₀] aeval_t Q₂)) * (z₁ * z₂) := by
                  ring
            _ = 0 := by rw [hz12, mul_zero]
        have hmul0 : P₁ * P₂ = 0 := hι_inj E (by rw [hP12, map_zero])
        rcases mul_eq_zero.mp hmul0 with rfl | rfl
        · rw [map_zero] at h₁
          have hq₁_ne : aeval_t Q₁ ≠ 0 := mt (transcendental_iff.mp ht_tr Q₁) hQ₁
          refine Or.inl ?_
          calc z₁ = ((1 : E) ⊗ₜ[K₀] (1 : F_t)) * z₁ := by
                rw [← Algebra.TensorProduct.one_def, one_mul]
            _ = ((1 : E) ⊗ₜ[K₀] ((aeval_t Q₁)⁻¹ * aeval_t Q₁)) * z₁ := by
                rw [inv_mul_cancel₀ hq₁_ne]
            _ = (((1 : E) ⊗ₜ[K₀] (aeval_t Q₁)⁻¹) * ((1 : E) ⊗ₜ[K₀] aeval_t Q₁)) * z₁ := by
                rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul]
            _ = ((1 : E) ⊗ₜ[K₀] (aeval_t Q₁)⁻¹) * (((1 : E) ⊗ₜ[K₀] aeval_t Q₁) * z₁) :=
                mul_assoc _ _ _
            _ = 0 := by rw [h₁, mul_zero]
        · rw [map_zero] at h₂
          have hq₂_ne : aeval_t Q₂ ≠ 0 := mt (transcendental_iff.mp ht_tr Q₂) hQ₂
          refine Or.inr ?_
          calc z₂ = ((1 : E) ⊗ₜ[K₀] (1 : F_t)) * z₂ := by
                rw [← Algebra.TensorProduct.one_def, one_mul]
            _ = ((1 : E) ⊗ₜ[K₀] ((aeval_t Q₂)⁻¹ * aeval_t Q₂)) * z₂ := by
                rw [inv_mul_cancel₀ hq₂_ne]
            _ = (((1 : E) ⊗ₜ[K₀] (aeval_t Q₂)⁻¹) * ((1 : E) ⊗ₜ[K₀] aeval_t Q₂)) * z₂ := by
                rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul]
            _ = ((1 : E) ⊗ₜ[K₀] (aeval_t Q₂)⁻¹) * (((1 : E) ⊗ₜ[K₀] aeval_t Q₂) * z₂) :=
                mul_assoc _ _ _
            _ = 0 := by rw [h₂, mul_zero]
      have : IsDomain (TensorProduct K₀ E F_t) := by
        have := hNontriv_AE
        have := hNoZero_AE
        exact NoZeroDivisors.to_isDomain (TensorProduct K₀ E F_t)
      let algFt : Algebra F_t (TensorProduct K₀ E F_t) :=
        (Algebra.TensorProduct.includeRight : F_t →ₐ[K₀] TensorProduct K₀ E F_t).toRingHom.toAlgebra
      let b_E := Module.finBasis K₀ E
      let S_gen : Set (TensorProduct K₀ E F_t) := Set.range fun i => (b_E i) ⊗ₜ[K₀] (1 : F_t)
      have hmem : ∀ w : TensorProduct K₀ E F_t,
          w ∈ @Submodule.span F_t (TensorProduct K₀ E F_t) _ _ algFt.toModule S_gen := by
        intro w
        induction w using TensorProduct.induction_on with
        | zero => exact Submodule.zero_mem _
        | tmul e_el y_el =>
          rw [← b_E.sum_repr e_el, TensorProduct.sum_tmul]
          refine Submodule.sum_mem _ fun i _ => ?_
          have hterm : (b_E.repr e_el i • b_E i) ⊗ₜ[K₀] y_el =
              @SMul.smul F_t (TensorProduct K₀ E F_t) algFt.toSMul
                (algebraMap K₀ F_t (b_E.repr e_el i) * y_el)
                (b_E i ⊗ₜ[K₀] (1 : F_t)) := by
            change (b_E.repr e_el i • b_E i) ⊗ₜ[K₀] y_el =
              ((1 : E) ⊗ₜ[K₀] (algebraMap K₀ F_t (b_E.repr e_el i) * y_el)) *
                (b_E i ⊗ₜ[K₀] (1 : F_t))
            rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_one,
              TensorProduct.smul_tmul, Algebra.smul_def]
          rw [hterm]
          exact @Submodule.smul_mem F_t (TensorProduct K₀ E F_t) _ _ algFt.toModule _ _ _
            (Submodule.subset_span ⟨i, rfl⟩)
        | add w₁ w₂ ih₁ ih₂ => exact Submodule.add_mem _ ih₁ ih₂
      have hFin_Ft : @Module.Finite F_t (TensorProduct K₀ E F_t) _ _ algFt.toModule := by
        let _ : Algebra F_t (TensorProduct K₀ E F_t) := algFt
        exact ⟨Submodule.fg_def.mpr ⟨S_gen, Set.finite_range _,
          eq_top_iff.mpr fun w _ => hmem w⟩⟩
      obtain ⟨w, hw⟩ :=
        @FiniteDimensional.exists_mul_eq_one F_t (TensorProduct K₀ E F_t) _ _ _ algFt hFin_Ft z hz
      exact IsUnit.of_mul_eq_one w hw

    have hUnit_κ₁ : ∀ P : ↥(nonZeroDivisors (Polynomial κ₁)),
        IsUnit (((Polynomial.aeval ((1 : κ₁) ⊗ₜ[K₀] t) :
          Polynomial κ₁ →ₐ[κ₁] TensorProduct K₀ κ₁ F_t).toRingHom) (P : Polynomial κ₁)) := by
      intro P
      have hP_ne : (P : Polynomial κ₁) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp P.2
      let _ : DecidableEq κ₁ := Classical.decEq κ₁
      let S_P : Finset κ₁ := (P : Polynomial κ₁).support.image (P : Polynomial κ₁).coeff
      let E_P : IntermediateField K₀ κ₁ := IntermediateField.adjoin K₀ (S_P : Set κ₁)
      have : Algebra.IsIntegral K₀ κ₁ := Algebra.IsAlgebraic.isIntegral
      have : FiniteDimensional K₀ ↥E_P :=
        IntermediateField.finiteDimensional_adjoin (fun x _ => Algebra.IsIntegral.isIntegral x)
      let P_E : Polynomial ↥E_P :=
        ∑ k ∈ (P : Polynomial κ₁).support.attach,
          Polynomial.monomial k.1
            ⟨(P : Polynomial κ₁).coeff k.1,
              IntermediateField.subset_adjoin K₀ (S_P : Set κ₁)
                (Finset.mem_coe.mpr (Finset.mem_image_of_mem _ k.2))⟩
      have hPE_map : P_E.map E_P.val.toRingHom = (P : Polynomial κ₁) := by
        rw [Polynomial.map_sum]
        have hcongr :
            (∑ x ∈ (P : Polynomial κ₁).support.attach,
              (Polynomial.monomial x.1
                (⟨(P : Polynomial κ₁).coeff x.1,
                  IntermediateField.subset_adjoin K₀ (S_P : Set κ₁)
                    (Finset.mem_coe.mpr (Finset.mem_image_of_mem _ x.2))⟩ : ↥E_P)).map
                E_P.val.toRingHom) =
            ∑ x ∈ (P : Polynomial κ₁).support.attach,
              Polynomial.monomial x.1 ((P : Polynomial κ₁).coeff x.1) := by
          refine Finset.sum_congr rfl fun x _ => ?_
          rw [Polynomial.map_monomial]
          rfl
        rw [hcongr, Finset.sum_attach (P : Polynomial κ₁).support
          (fun k => Polynomial.monomial k ((P : Polynomial κ₁).coeff k))]
        exact (Polynomial.as_sum_support (P : Polynomial κ₁)).symm
      have hPE_ne : P_E ≠ 0 := fun h0 => hP_ne (by rw [← hPE_map, h0, Polynomial.map_zero])
      have hιPE_ne : (Polynomial.aeval ((1 : ↥E_P) ⊗ₜ[K₀] t) :
          Polynomial ↥E_P →ₐ[↥E_P] TensorProduct K₀ ↥E_P F_t) P_E ≠ 0 :=
        fun h0 => hPE_ne (hι_inj ↥E_P (by rw [h0, map_zero]))
      have hU_E := hUnit_fin ↥E_P _ hιPE_ne
      let f_EP : TensorProduct K₀ ↥E_P F_t →ₐ[K₀] TensorProduct K₀ κ₁ F_t :=
        Algebra.TensorProduct.map E_P.val (AlgHom.id K₀ F_t)
      have hf_img : f_EP ((Polynomial.aeval ((1 : ↥E_P) ⊗ₜ[K₀] t) :
          Polynomial ↥E_P →ₐ[↥E_P] TensorProduct K₀ ↥E_P F_t) P_E) =
          (Polynomial.aeval ((1 : κ₁) ⊗ₜ[K₀] t) :
            Polynomial κ₁ →ₐ[κ₁] TensorProduct K₀ κ₁ F_t) (P : Polynomial κ₁) := by
        rw [← hPE_map, Polynomial.aeval_def, Polynomial.aeval_def, Polynomial.eval₂_map]
        have hhom := Polynomial.hom_eval₂ P_E (algebraMap ↥E_P (TensorProduct K₀ ↥E_P F_t))
          f_EP.toRingHom ((1 : ↥E_P) ⊗ₜ[K₀] t)
        convert hhom using 2
        · ext x
          simp [f_EP, Algebra.TensorProduct.algebraMap_apply]
        · simp [f_EP]
      change IsUnit ((Polynomial.aeval ((1 : κ₁) ⊗ₜ[K₀] t) :
        Polynomial κ₁ →ₐ[κ₁] TensorProduct K₀ κ₁ F_t) (P : Polynomial κ₁))
      rw [← hf_img]
      exact hU_E.map f_EP.toMonoidHom

    let ψ_ring : FractionRing (Polynomial κ₁) →+* TensorProduct K₀ κ₁ F_t :=
      IsLocalization.lift (M := nonZeroDivisors (Polynomial κ₁))
        (S := FractionRing (Polynomial κ₁)) hUnit_κ₁
    let Ψ_sep : FractionRing (Polynomial κ₁) →ₐ[κ₁] TensorProduct K₀ κ₁ F_t :=
      { ψ_ring with
        commutes' := fun c => by
          change ψ_ring (algebraMap κ₁ (FractionRing (Polynomial κ₁)) c) =
            algebraMap κ₁ (TensorProduct K₀ κ₁ F_t) c
          rw [IsScalarTower.algebraMap_apply κ₁ (Polynomial κ₁)
            (FractionRing (Polynomial κ₁)) c]
          change IsLocalization.lift hUnit_κ₁
              (algebraMap (Polynomial κ₁) (FractionRing (Polynomial κ₁)) (Polynomial.C c)) = _
          rw [IsLocalization.lift_eq]
          exact Polynomial.aeval_C ((1 : κ₁) ⊗ₜ[K₀] t) c }
    have : Nontrivial (TensorProduct K₀ κ₁ F_t) :=
      ⟨⟨1, 0, fun h10 => one_ne_zero (hι_inj κ₁ (by rw [map_one, map_zero]; exact h10))⟩⟩
    have hΨ_surj : Function.Surjective Ψ_sep := by
      intro z
      obtain ⟨Q, hQ, P, hQP⟩ := hClear κ₁ z
      let Q₁ : Polynomial κ₁ := Q.map (algebraMap K₀ κ₁)
      have hQ₁_ne : Q₁ ≠ 0 :=
        fun h0 => hQ (Polynomial.map_injective _ (algebraMap K₀ κ₁).injective
          (h0.trans (Polynomial.map_zero _).symm))
      have hQ₁_B_ne : algebraMap (Polynomial κ₁) (FractionRing (Polynomial κ₁)) Q₁ ≠ 0 :=
        fun h0 => hQ₁_ne (IsFractionRing.injective (Polynomial κ₁)
          (FractionRing (Polynomial κ₁)) (by rw [h0, map_zero]))
      refine ⟨algebraMap (Polynomial κ₁) (FractionRing (Polynomial κ₁)) P *
        (algebraMap (Polynomial κ₁) (FractionRing (Polynomial κ₁)) Q₁)⁻¹, ?_⟩
      have hΨ_P : Ψ_sep (algebraMap (Polynomial κ₁) (FractionRing (Polynomial κ₁)) P) =
          ((1 : κ₁) ⊗ₜ[K₀] aeval_t Q) * z := by
        change IsLocalization.lift hUnit_κ₁
            (algebraMap (Polynomial κ₁) (FractionRing (Polynomial κ₁)) P) = _
        rw [IsLocalization.lift_eq]
        exact hQP.symm
      have hΨ_Q : Ψ_sep (algebraMap (Polynomial κ₁) (FractionRing (Polynomial κ₁)) Q₁) =
          (1 : κ₁) ⊗ₜ[K₀] aeval_t Q := by
        change IsLocalization.lift hUnit_κ₁
            (algebraMap (Polynomial κ₁) (FractionRing (Polynomial κ₁)) Q₁) = _
        rw [IsLocalization.lift_eq]
        exact h_map_aeval κ₁ Q
      have hmul_inv : ((1 : κ₁) ⊗ₜ[K₀] aeval_t Q) *
          Ψ_sep ((algebraMap (Polynomial κ₁) (FractionRing (Polynomial κ₁)) Q₁)⁻¹) = 1 := by
        rw [← hΨ_Q, ← map_mul, mul_inv_cancel₀ hQ₁_B_ne, map_one]
      rw [map_mul, hΨ_P, mul_right_comm, hmul_inv, one_mul]
    exact ⟨hTrB, ⟨AlgEquiv.ofBijective Ψ_sep ⟨Ψ_sep.toRingHom.injective, hΨ_surj⟩⟩⟩

  
  
  
  have hPillar3 :
      ∀ (K₀ κ₁ F_t K B_sep : Type u) [Field K₀] [Field κ₁] [Algebra K₀ κ₁]
        [Algebra.IsSeparable K₀ κ₁]
        [Field F_t] [Algebra K₀ F_t] [Field K] [Algebra K₀ K] [Algebra F_t K]
        [IsScalarTower K₀ F_t K] [FiniteDimensional F_t K]
        [Field B_sep] [Algebra κ₁ B_sep],
        Algebra.trdeg κ₁ B_sep ≤ 1 →
        (B_sep ≃ₐ[κ₁] TensorProduct K₀ κ₁ F_t) →
        ∃ (n : ℕ)
          (L : Fin n → Type u)
          (_ : ∀ j, Field (L j))
          (_ : ∀ j, Algebra κ₁ (L j))
          (_ : TensorProduct K₀ κ₁ K ≃+* (∀ j : Fin n, L j)),
          ∀ j : Fin n, Algebra.trdeg κ₁ (L j) ≤ 1 := by
    intro K₀ κ₁ F_t K B_sep _ _ _ _ _ _ _ _ _ _ _ _ _ hTrB e_sep
    let ι_Bt : TensorProduct K₀ κ₁ F_t →ₐ[κ₁] TensorProduct K₀ κ₁ K :=
      Algebra.TensorProduct.map (AlgHom.id κ₁ κ₁) (IsScalarTower.toAlgHom K₀ F_t K)
    let f_sep : B_sep →ₐ[κ₁] TensorProduct K₀ κ₁ K := ι_Bt.comp e_sep.toAlgHom

    have hFin_B_A :
        @Module.Finite B_sep (TensorProduct K₀ κ₁ K) _ _ f_sep.toRingHom.toModule := by
      let algBA : Algebra B_sep (TensorProduct K₀ κ₁ K) := f_sep.toRingHom.toAlgebra
      let b_K := Module.finBasis F_t K
      let S_gen : Set (TensorProduct K₀ κ₁ K) := Set.range fun m => (1 : κ₁) ⊗ₜ[K₀] (b_K m)
      have hmem : ∀ z : TensorProduct K₀ κ₁ K,
          z ∈ @Submodule.span B_sep (TensorProduct K₀ κ₁ K) _ _ algBA.toModule S_gen := by
        intro z
        induction z using TensorProduct.induction_on with
        | zero => exact Submodule.zero_mem _
        | tmul c k =>
          rw [← b_K.sum_repr k, TensorProduct.tmul_sum]
          refine Submodule.sum_mem _ fun m _ => ?_
          have hterm : c ⊗ₜ[K₀] (b_K.repr k m • b_K m) =
              @SMul.smul B_sep (TensorProduct K₀ κ₁ K) algBA.toSMul
                (e_sep.symm (c ⊗ₜ[K₀] b_K.repr k m))
                ((1 : κ₁) ⊗ₜ[K₀] b_K m) := by
            change c ⊗ₜ[K₀] (b_K.repr k m • b_K m) =
              ι_Bt (e_sep (e_sep.symm (c ⊗ₜ[K₀] b_K.repr k m))) * ((1 : κ₁) ⊗ₜ[K₀] b_K m)
            rw [e_sep.apply_symm_apply, Algebra.smul_def]
            simp [ι_Bt, Algebra.TensorProduct.tmul_mul_tmul]
          rw [hterm]
          exact @Submodule.smul_mem B_sep (TensorProduct K₀ κ₁ K) _ _ algBA.toModule _ _ _
            (Submodule.subset_span ⟨m, rfl⟩)
        | add z₁ z₂ ih₁ ih₂ => exact Submodule.add_mem _ ih₁ ih₂
      let _ : Algebra B_sep (TensorProduct K₀ κ₁ K) := algBA
      exact ⟨Submodule.fg_def.mpr ⟨S_gen, Set.finite_range _,
        eq_top_iff.mpr fun z _ => hmem z⟩⟩

    have : IsArtinianRing (TensorProduct K₀ κ₁ K) := by
      let _ : Algebra B_sep (TensorProduct K₀ κ₁ K) := f_sep.toRingHom.toAlgebra
      have : Module.Finite B_sep (TensorProduct K₀ κ₁ K) := hFin_B_A
      exact IsArtinianRing.of_finite B_sep (TensorProduct K₀ κ₁ K)

    have : IsReduced (TensorProduct K₀ κ₁ K) := by
      refine ⟨fun z ⟨m, hm⟩ => ?_⟩
      obtain ⟨S_z, hS_z⟩ := TensorProduct.exists_finset (R := K₀) z
      let _ : DecidableEq κ₁ := Classical.decEq κ₁
      let C_z : Finset κ₁ := S_z.image Prod.fst
      let E_z : IntermediateField K₀ κ₁ := IntermediateField.adjoin K₀ (C_z : Set κ₁)
      have : Algebra.IsAlgebraic K₀ κ₁ := Algebra.IsSeparable.isAlgebraic K₀ κ₁
      have : Algebra.IsIntegral K₀ κ₁ := Algebra.IsAlgebraic.isIntegral
      have : FiniteDimensional K₀ ↥E_z :=
        IntermediateField.finiteDimensional_adjoin (fun x _ => Algebra.IsIntegral.isIntegral x)
      have : Algebra.IsSeparable K₀ ↥E_z := Algebra.IsSeparable.of_algHom K₀ κ₁ E_z.val
      have : Algebra.FormallyEtale K₀ ↥E_z := Algebra.FormallyEtale.of_isSeparable K₀ ↥E_z
      have : Algebra.FiniteType K₀ ↥E_z := @Module.Finite.finiteType K₀ ↥E_z _ _ _ inferInstance
      have : Algebra.FinitePresentation K₀ ↥E_z :=
        Algebra.FinitePresentation.of_finiteType.mp inferInstance
      have : Algebra.Etale K₀ ↥E_z := {}
      have : Algebra.Etale K (TensorProduct K₀ K ↥E_z) := Algebra.Etale.baseChange K₀ ↥E_z K
      have hRed_KE : IsReduced (TensorProduct K₀ K ↥E_z) :=
        Algebra.FormallyUnramified.isReduced_of_field K (TensorProduct K₀ K ↥E_z)
      let emb_Ez : TensorProduct K₀ ↥E_z K →ₐ[K₀] TensorProduct K₀ κ₁ K :=
        Algebra.TensorProduct.map E_z.val (AlgHom.id K₀ K)
      have hemb_inj : Function.Injective emb_Ez := by
        have hlin : Function.Injective (LinearMap.rTensor K E_z.val.toLinearMap) :=
          Module.Flat.rTensor_preserves_injective_linearMap E_z.val.toLinearMap E_z.val.injective
        intro x₁ x₂ hx
        apply hlin
        have heq : ∀ x : TensorProduct K₀ ↥E_z K,
            LinearMap.rTensor K E_z.val.toLinearMap x = emb_Ez x := by
          intro x
          induction x using TensorProduct.induction_on with
          | zero => rfl
          | tmul _ _ => rfl
          | add _ _ h₁ h₂ => rw [map_add, map_add, h₁, h₂]
        rw [heq, heq, hx]
      let z_E : TensorProduct K₀ ↥E_z K :=
        ∑ p ∈ S_z.attach,
          (⟨p.1.1, IntermediateField.subset_adjoin K₀ (C_z : Set κ₁)
            (Finset.mem_coe.mpr (Finset.mem_image_of_mem _ p.2))⟩ : ↥E_z) ⊗ₜ[K₀] p.1.2
      have hz_eq : emb_Ez z_E = z := by
        rw [map_sum]
        have hcongr :
            (∑ p ∈ S_z.attach,
              emb_Ez ((⟨p.1.1, IntermediateField.subset_adjoin K₀ (C_z : Set κ₁)
                (Finset.mem_coe.mpr (Finset.mem_image_of_mem _ p.2))⟩ : ↥E_z) ⊗ₜ[K₀] p.1.2)) =
            ∑ p ∈ S_z.attach, p.1.1 ⊗ₜ[K₀] p.1.2 :=
          Finset.sum_congr rfl fun _ _ => rfl
        rw [hcongr, Finset.sum_attach S_z (fun p => p.1 ⊗ₜ[K₀] p.2), ← hS_z]
      have hzE_pow : z_E ^ m = 0 := by
        apply hemb_inj
        change emb_Ez.toRingHom (z_E ^ m) = emb_Ez.toRingHom 0
        rw [map_pow, map_zero]
        change (emb_Ez z_E) ^ m = 0
        rw [hz_eq, hm]
      let e_comm := Algebra.TensorProduct.comm K₀ ↥E_z K
      have hcomm_pow : (e_comm z_E) ^ m = 0 := by
        rw [← map_pow, hzE_pow, map_zero]
      have hcomm_zero : e_comm z_E = 0 := hRed_KE.eq_zero (e_comm z_E) ⟨m, hcomm_pow⟩
      have hzE_zero : z_E = 0 := e_comm.injective (by rw [hcomm_zero, map_zero])
      rw [← hz_eq, hzE_zero, map_zero]

    have : Finite (MaximalSpectrum (TensorProduct K₀ κ₁ K)) :=
      IsArtinianRing.instFiniteMaximalSpectrum (TensorProduct K₀ κ₁ K)
    let _ : Fintype (MaximalSpectrum (TensorProduct K₀ κ₁ K)) :=
      Fintype.ofFinite (MaximalSpectrum (TensorProduct K₀ κ₁ K))
    let n : ℕ := Fintype.card (MaximalSpectrum (TensorProduct K₀ κ₁ K))
    let e_max : Fin n ≃ MaximalSpectrum (TensorProduct K₀ κ₁ K) :=
      (Fintype.equivFin (MaximalSpectrum (TensorProduct K₀ κ₁ K))).symm
    let L : Fin n → Type u := fun j => (TensorProduct K₀ κ₁ K) ⧸ (e_max j).asIdeal
    let hFieldL : ∀ j : Fin n, Field (L j) :=
      fun j => @Ideal.Quotient.field (TensorProduct K₀ κ₁ K) _
        (e_max j).asIdeal (e_max j).isMaximal
    let _ : ∀ j : Fin n, Field (L j) := hFieldL
    let hAlgL : ∀ j : Fin n, Algebra κ₁ (L j) := fun j => Ideal.Quotient.algebra κ₁
    let _ : ∀ j : Fin n, Algebra κ₁ (L j) := hAlgL
    let Phi_inf : TensorProduct K₀ κ₁ K ≃+* (∀ j : Fin n, L j) :=
      (IsArtinianRing.equivPi (TensorProduct K₀ κ₁ K)).toRingEquiv.trans
        (RingEquiv.piCongrLeft
          (fun I : MaximalSpectrum (TensorProduct K₀ κ₁ K) =>
            (TensorProduct K₀ κ₁ K) ⧸ I.asIdeal) e_max).symm

    have hTrL : ∀ j : Fin n, Algebra.trdeg κ₁ (L j) ≤ 1 := by
      intro j
      let _ : Algebra B_sep (TensorProduct K₀ κ₁ K) := f_sep.toRingHom.toAlgebra
      have : Module.Finite B_sep (TensorProduct K₀ κ₁ K) := hFin_B_A
      have : IsScalarTower κ₁ B_sep (TensorProduct K₀ κ₁ K) :=
        IsScalarTower.of_algebraMap_eq' f_sep.comp_algebraMap.symm
      let _ : Algebra B_sep (L j) := Ideal.Quotient.algebra B_sep
      have : IsScalarTower κ₁ B_sep (L j) :=
        IsScalarTower.of_algebraMap_eq fun c =>
          congrArg (Ideal.Quotient.mk (e_max j).asIdeal)
            (IsScalarTower.algebraMap_apply κ₁ B_sep (TensorProduct K₀ κ₁ K) c)
      have : Module.Finite B_sep (L j) :=
        Module.Finite.of_surjective (Ideal.Quotient.mkₐ B_sep (e_max j).asIdeal).toLinearMap
          Ideal.Quotient.mk_surjective
      have : Algebra.IsAlgebraic B_sep (L j) := Algebra.IsAlgebraic.of_finite B_sep (L j)
      rw [← _root_.trdeg_add_eq κ₁ B_sep (A := L j), @_root_.trdeg_eq_zero B_sep (L j), add_zero]
      exact hTrB

    exact ⟨n, L, hFieldL, hAlgL, Phi_inf, hTrL⟩

  
  
  
  have hPillar4 :
      ∀ (K₀ κ₁ K : Type u) [Field K₀] [Field κ₁] [Algebra K₀ κ₁]
        [IsSepClosed κ₁] [Algebra.IsSeparable K₀ κ₁]
        [Field K] [Algebra K₀ K]
        (n : ℕ) (L : Fin n → Type u) [∀ j, Field (L j)]
        (_ : TensorProduct K₀ κ₁ K ≃+* (∀ j : Fin n, L j))
        (E_init : Type u) [Field E_init] [Algebra K₀ E_init]
        [FiniteDimensional K₀ E_init] [Algebra.IsSeparable K₀ E_init],
        ∃ (𝒟 : ∀ j : Fin n, Set (Subfield (L j)))
          (F₀ : ∀ j : Fin n, Subfield (L j))
          (E₀ : Type u) (_ : Field E₀) (_ : Algebra K₀ E₀)
          (φ₀ : E_init →ₐ[K₀] E₀)
          (e₀ : TensorProduct K₀ E₀ K ≃+* (∀ j : Fin n, ↥(F₀ j))),
          (∀ j : Fin n, (𝒟 j).Nonempty ∧ DirectedOn (· ≤ ·) (𝒟 j) ∧
            (∀ x : L j, ∃ F ∈ 𝒟 j, x ∈ F)) ∧
          (∀ j : Fin n, F₀ j ∈ 𝒟 j) ∧
          RingHom.Etale φ₀.toRingHom ∧
          ∀ (F₁ : ∀ j : Fin n, Subfield (L j)),
            (∀ j : Fin n, F₁ j ∈ 𝒟 j) →
            (hle₀₁ : ∀ j : Fin n, F₀ j ≤ F₁ j) →
            ∃ (E₁ : Type u) (_ : Field E₁) (_ : Algebra K₀ E₁)
              (φ₁ : E₀ →ₐ[K₀] E₁)
              (F₂ : ∀ j : Fin n, Subfield (L j))
              (hle₁₂ : ∀ j : Fin n, F₁ j ≤ F₂ j)
              (e₁ : TensorProduct K₀ E₁ K ≃+* (∀ j : Fin n, ↥(F₂ j))),
              RingHom.Etale φ₁.toRingHom ∧
              ∀ (x : TensorProduct K₀ E₀ K) (j : Fin n),
                e₁ (Algebra.TensorProduct.map φ₁ (AlgHom.id K₀ K) x) j =
                  Subfield.inclusion ((hle₀₁ j).trans (hle₁₂ j)) (e₀ x j) := by
    intro K₀ κ₁ K _ _ _ _ _ _ _ n L _ Phi_inf E_init _ _ _ _

    have hEtaleOfIntoSep : ∀ (E_src E_dst : Type u) [Field E_src] [Algebra K₀ E_src]
        [Field E_dst] [Algebra K₀ E_dst] [FiniteDimensional K₀ E_dst]
        (ψ_dst : E_dst →ₐ[K₀] κ₁) (φ : E_src →ₐ[K₀] E_dst),
        RingHom.Etale φ.toRingHom := by
      intro E_src E_dst _ _ _ _ _ ψ_dst φ
      let _ : Algebra E_src E_dst := φ.toRingHom.toAlgebra
      have : IsScalarTower K₀ E_src E_dst :=
        IsScalarTower.of_algebraMap_eq' φ.comp_algebraMap.symm
      have : FiniteDimensional E_src E_dst := FiniteDimensional.right K₀ E_src E_dst
      have : Algebra.IsSeparable K₀ E_dst := Algebra.IsSeparable.of_algHom K₀ κ₁ ψ_dst
      have : Algebra.IsSeparable E_src E_dst :=
        Algebra.isSeparable_tower_top_of_isSeparable K₀ E_src E_dst
      have : Algebra.FormallyEtale E_src E_dst :=
        Algebra.FormallyEtale.of_isSeparable E_src E_dst
      have : Algebra.FiniteType E_src E_dst :=
        @Module.Finite.finiteType E_src E_dst _ _ _ inferInstance
      have : Algebra.FinitePresentation E_src E_dst :=
        Algebra.FinitePresentation.of_finiteType.mp inferInstance
      have hEtAlg : Algebra.Etale E_src E_dst := {}
      exact RingHom.etale_algebraMap.mpr hEtAlg

    let ι_init : E_init →ₐ[K₀] κ₁ := IsSepClosed.lift
    let b_init := Module.finBasis K₀ E_init
    let _ : DecidableEq κ₁ := Classical.decEq κ₁
    let u_idem : Fin n → TensorProduct K₀ κ₁ K := fun j => Phi_inf.symm (Pi.single j (1 : L j))
    have hExIdem : ∀ j : Fin n, ∃ T : Finset (κ₁ × K),
        u_idem j = ∑ p ∈ T, p.1 ⊗ₜ[K₀] p.2 :=
      fun j => TensorProduct.exists_finset (R := K₀) (u_idem j)
    choose T_idem hT_idem using hExIdem

    let S_init : Finset κ₁ := Finset.univ.image (fun i => ι_init (b_init i))
    let C_idem : Finset κ₁ :=
      S_init ∪ Finset.univ.biUnion (fun j : Fin n => (T_idem j).image Prod.fst)
    let E₀_if : IntermediateField K₀ κ₁ := IntermediateField.adjoin K₀ (C_idem : Set κ₁)
    let E₀ : Type u := ↥E₀_if
    have : Algebra.IsAlgebraic K₀ κ₁ := Algebra.IsSeparable.isAlgebraic K₀ κ₁
    have : Algebra.IsIntegral K₀ κ₁ := Algebra.IsAlgebraic.isIntegral
    have hFin_E₀ : FiniteDimensional K₀ E₀ :=
      IntermediateField.finiteDimensional_adjoin (fun x _ => Algebra.IsIntegral.isIntegral x)

    have hι_mem_E₀ : ∀ x : E_init, ι_init x ∈ E₀_if := by
      intro x
      rw [← b_init.sum_repr x, map_sum]
      refine E₀_if.sum_mem fun i _ => ?_
      rw [map_smul, Algebra.smul_def]
      refine E₀_if.mul_mem (E₀_if.algebraMap_mem _) ?_
      refine IntermediateField.subset_adjoin K₀ (C_idem : Set κ₁) ?_
      exact Finset.mem_coe.mpr
        (Finset.mem_union_left _ (Finset.mem_image_of_mem _ (Finset.mem_univ i)))

    let φ₀ : E_init →ₐ[K₀] E₀ :=
      { toFun := fun x => ⟨ι_init x, hι_mem_E₀ x⟩
        map_one' := Subtype.ext (map_one ι_init)
        map_mul' := fun x y => Subtype.ext (map_mul ι_init x y)
        map_zero' := Subtype.ext (map_zero ι_init)
        map_add' := fun x y => Subtype.ext (map_add ι_init x y)
        commutes' := fun c => Subtype.ext (ι_init.commutes c) }
    have hEt_φ₀ : RingHom.Etale φ₀.toRingHom := by
      have := hFin_E₀
      exact hEtaleOfIntoSep E_init E₀ E₀_if.val φ₀

    let ℐ : Set (IntermediateField K₀ κ₁) := { M | FiniteDimensional K₀ ↥M ∧ E₀_if ≤ M }
    have hE₀_mem_ℐ : E₀_if ∈ ℐ := ⟨hFin_E₀, le_rfl⟩

    let emb_M : ∀ (M : IntermediateField K₀ κ₁),
        TensorProduct K₀ ↥M K →ₐ[K₀] TensorProduct K₀ κ₁ K :=
      fun M => Algebra.TensorProduct.map M.val (AlgHom.id K₀ K)
    let ψ_M : ∀ (M : IntermediateField K₀ κ₁) (j : Fin n), TensorProduct K₀ ↥M K →+* L j :=
      fun M j => (Pi.evalRingHom L j).comp (Phi_inf.toRingHom.comp (emb_M M).toRingHom)

    have hemb_M_inj : ∀ (M : IntermediateField K₀ κ₁), Function.Injective (emb_M M) := by
      intro M
      have hlin : Function.Injective (LinearMap.rTensor K M.val.toLinearMap) :=
        Module.Flat.rTensor_preserves_injective_linearMap M.val.toLinearMap M.val.injective
      intro x₁ x₂ hx
      apply hlin
      have heq : ∀ x : TensorProduct K₀ ↥M K,
          LinearMap.rTensor K M.val.toLinearMap x = emb_M M x := by
        intro x
        induction x using TensorProduct.induction_on with
        | zero => rfl
        | tmul _ _ => rfl
        | add _ _ h₁ h₂ => rw [map_add, map_add, h₁, h₂]
      rw [heq, heq, hx]

    have hRange_inv : ∀ (M : IntermediateField K₀ κ₁), M ∈ ℐ → ∀ (j : Fin n),
        ∀ y ∈ (ψ_M M j).range, y⁻¹ ∈ (ψ_M M j).range := by
      intro M hM j y hy
      by_cases hy0 : y = 0
      · rw [hy0, inv_zero]
        exact (ψ_M M j).range.zero_mem
      · have : FiniteDimensional K₀ ↥M := hM.1
        let algKL_hom : K →+* L j :=
          (Pi.evalRingHom L j).comp (Phi_inf.toRingHom.comp
            (Algebra.TensorProduct.includeRight :
              K →ₐ[K₀] TensorProduct K₀ κ₁ K).toRingHom)
        let algKL : Algebra K (L j) := algKL_hom.toAlgebra
        let _ : Algebra K (L j) := algKL
        let A_sub : Subalgebra K (L j) :=
          { (ψ_M M j).range with
            algebraMap_mem' := fun k =>
              ⟨(1 : ↥M) ⊗ₜ[K₀] k, by
                change (Pi.evalRingHom L j) (Phi_inf (emb_M M ((1 : ↥M) ⊗ₜ[K₀] k))) =
                  (Pi.evalRingHom L j) (Phi_inf ((1 : κ₁) ⊗ₜ[K₀] k))
                dsimp only [emb_M]
                rw [Algebra.TensorProduct.map_tmul, map_one, AlgHom.id_apply]⟩ }
        let b_M := Module.finBasis K₀ ↥M
        let g_sub := fun m =>
          (⟨ψ_M M j (b_M m ⊗ₜ[K₀] (1 : K)), ⟨b_M m ⊗ₜ[K₀] (1 : K), rfl⟩⟩ : ↥A_sub)
        have hmem_sub : ∀ z : TensorProduct K₀ ↥M K,
            (⟨ψ_M M j z, ⟨z, rfl⟩⟩ : ↥A_sub) ∈ Submodule.span K (Set.range g_sub) := by
          intro z
          induction z using TensorProduct.induction_on with
          | zero =>
            convert Submodule.zero_mem _
            ext
            exact map_zero (ψ_M M j)
          | tmul m_el k_el =>
            have h_decomp :
                (⟨ψ_M M j (m_el ⊗ₜ[K₀] k_el), ⟨m_el ⊗ₜ[K₀] k_el, rfl⟩⟩ : ↥A_sub) =
                ∑ i, (algebraMap K₀ K (b_M.repr m_el i) * k_el) • g_sub i := by
              apply Subtype.ext
              rw [AddSubmonoidClass.coe_finsetSum]
              change ψ_M M j (m_el ⊗ₜ[K₀] k_el) =
                ∑ i, algKL_hom (algebraMap K₀ K (b_M.repr m_el i) * k_el) *
                  ψ_M M j (b_M i ⊗ₜ[K₀] (1 : K))
              conv_lhs => rw [← b_M.sum_repr m_el, TensorProduct.sum_tmul]
              rw [map_sum]
              refine Finset.sum_congr rfl fun i _ => ?_
              have h_tmul : (b_M.repr m_el i • b_M i) ⊗ₜ[K₀] k_el =
                  ((1 : ↥M) ⊗ₜ[K₀] (algebraMap K₀ K (b_M.repr m_el i) * k_el)) *
                    (b_M i ⊗ₜ[K₀] (1 : K)) := by
                rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_one,
                  TensorProduct.smul_tmul, Algebra.smul_def]
              rw [h_tmul, map_mul]
              congr 1
            rw [h_decomp]
            exact Submodule.sum_mem _ fun i _ =>
              Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)
          | add z₁ z₂ ih₁ ih₂ =>
            have h_add : (⟨ψ_M M j (z₁ + z₂), ⟨z₁ + z₂, rfl⟩⟩ : ↥A_sub) =
                ⟨ψ_M M j z₁, ⟨z₁, rfl⟩⟩ + ⟨ψ_M M j z₂, ⟨z₂, rfl⟩⟩ := by
              ext; exact map_add (ψ_M M j) z₁ z₂
            rw [h_add]
            exact Submodule.add_mem _ ih₁ ih₂
        have hspan_top : Submodule.span K (Set.range g_sub) = ⊤ := by
          rw [eq_top_iff]
          rintro x_sub _
          rcases x_sub.2 with ⟨z, hyz⟩
          have h_eq : x_sub = ⟨ψ_M M j z, ⟨z, rfl⟩⟩ := Subtype.ext hyz.symm
          rw [h_eq]
          exact hmem_sub z
        have : Module.Finite K ↥A_sub :=
          ⟨Submodule.fg_def.mpr ⟨Set.range g_sub, Set.finite_range g_sub, hspan_top⟩⟩
        let y_sub : ↥A_sub := ⟨y, hy⟩
        have hy_sub_ne : y_sub ≠ 0 := fun h => hy0 (congrArg Subtype.val h)
        obtain ⟨w_sub, hw_sub⟩ :=
          @FiniteDimensional.exists_mul_eq_one K ↥A_sub _ _ _ _ _ y_sub hy_sub_ne
        have hyw : y * w_sub.1 = 1 := congrArg Subtype.val hw_sub
        rw [inv_eq_of_mul_eq_one_right hyw]
        exact w_sub.2

    let F_sub : ∀ (M : IntermediateField K₀ κ₁), M ∈ ℐ → ∀ j : Fin n, Subfield (L j) :=
      fun M hM j => Subring.toSubfield (ψ_M M j).range (hRange_inv M hM j)

    have hMem_F_sub : ∀ (M : IntermediateField K₀ κ₁) (hM : M ∈ ℐ) (j : Fin n) (y : L j),
        y ∈ F_sub M hM j ↔ ∃ x : TensorProduct K₀ ↥M K, ψ_M M j x = y :=
      fun _ _ _ _ => Iff.rfl

    have hMono_F_sub : ∀ (M₁ M₂ : IntermediateField K₀ κ₁) (hM₁ : M₁ ∈ ℐ) (hM₂ : M₂ ∈ ℐ),
        M₁ ≤ M₂ → ∀ j : Fin n, F_sub M₁ hM₁ j ≤ F_sub M₂ hM₂ j := by
      intro M₁ M₂ hM₁ hM₂ hle j y hy
      rcases (hMem_F_sub M₁ hM₁ j y).mp hy with ⟨x, rfl⟩
      refine (hMem_F_sub M₂ hM₂ j _).mpr
        ⟨Algebra.TensorProduct.map (IntermediateField.inclusion hle) (AlgHom.id K₀ K) x, ?_⟩
      have hcomp : (emb_M M₂).comp
          (Algebra.TensorProduct.map (IntermediateField.inclusion hle) (AlgHom.id K₀ K)) =
          emb_M M₁ :=
        Algebra.TensorProduct.ext (AlgHom.ext fun _ => rfl) (AlgHom.ext fun _ => rfl)
      have hcomp_x : emb_M M₂
          (Algebra.TensorProduct.map (IntermediateField.inclusion hle) (AlgHom.id K₀ K) x) =
          emb_M M₁ x :=
        DFunLike.congr_fun hcomp x
      change (Pi.evalRingHom L j) (Phi_inf (emb_M M₂ _)) =
        (Pi.evalRingHom L j) (Phi_inf (emb_M M₁ x))
      rw [hcomp_x]

    have hEquiv_M : ∀ (M : IntermediateField K₀ κ₁) (hM : M ∈ ℐ),
        ∃ e_M : TensorProduct K₀ ↥M K ≃+* (∀ j : Fin n, ↥(F_sub M hM j)),
          ∀ (x : TensorProduct K₀ ↥M K) (j : Fin n),
            (e_M x j : L j) = ψ_M M j x := by
      intro M hM
      let θ_M : TensorProduct K₀ ↥M K →+* (∀ j : Fin n, ↥(F_sub M hM j)) :=
        RingHom.pi fun j =>
          { toFun := fun x => ⟨ψ_M M j x, (hMem_F_sub M hM j _).mpr ⟨x, rfl⟩⟩
            map_one' := Subtype.ext (map_one (ψ_M M j))
            map_mul' := fun x y => Subtype.ext (map_mul (ψ_M M j) x y)
            map_zero' := Subtype.ext (map_zero (ψ_M M j))
            map_add' := fun x y => Subtype.ext (map_add (ψ_M M j) x y) }
      have hθ_inj : Function.Injective θ_M := by
        intro x₁ x₂ hx
        apply hemb_M_inj M
        apply Phi_inf.injective
        ext j
        exact congrArg Subtype.val (congrFun hx j)
      have hθ_surj : Function.Surjective θ_M := by
        intro y
        have hEx_x : ∀ j : Fin n, ∃ x : TensorProduct K₀ ↥M K, ψ_M M j x = (y j : L j) :=
          fun j => (hMem_F_sub M hM j (y j)).mp (y j).2
        choose x_fam hx_fam using hEx_x
        let u_M : Fin n → TensorProduct K₀ ↥M K := fun i =>
          ∑ p ∈ (T_idem i).attach,
            (⟨p.1.1, hM.2 (IntermediateField.subset_adjoin K₀ (C_idem : Set κ₁)
              (Finset.mem_coe.mpr (Finset.mem_union_right _
                (Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ i,
                  Finset.mem_image_of_mem _ p.2⟩))))⟩ : ↥M) ⊗ₜ[K₀] p.1.2
        have hu_M_emb : ∀ i : Fin n, emb_M M (u_M i) = u_idem i := by
          intro i
          rw [map_sum]
          have hcongr :
              (∑ p ∈ (T_idem i).attach,
                emb_M M ((⟨p.1.1, hM.2 (IntermediateField.subset_adjoin K₀ (C_idem : Set κ₁)
                  (Finset.mem_coe.mpr (Finset.mem_union_right _
                    (Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ i,
                      Finset.mem_image_of_mem _ p.2⟩))))⟩ : ↥M) ⊗ₜ[K₀] p.1.2)) =
              ∑ p ∈ (T_idem i).attach, p.1.1 ⊗ₜ[K₀] p.1.2 :=
            Finset.sum_congr rfl fun _ _ => rfl
          rw [hcongr, Finset.sum_attach (T_idem i) (fun p => p.1 ⊗ₜ[K₀] p.2), ← hT_idem i]
        refine ⟨∑ i : Fin n, x_fam i * u_M i, ?_⟩
        ext j
        change ψ_M M j (∑ i : Fin n, x_fam i * u_M i) = (y j : L j)
        rw [map_sum, Finset.sum_eq_single j]
        · rw [map_mul, hx_fam j]
          have hu_j : ψ_M M j (u_M j) = 1 := by
            change Phi_inf (emb_M M (u_M j)) j = 1
            rw [hu_M_emb j]
            simp [u_idem]
          rw [hu_j, mul_one]
        · intro i _ hij
          rw [map_mul]
          have hu_ij : ψ_M M j (u_M i) = 0 := by
            change Phi_inf (emb_M M (u_M i)) j = 0
            rw [hu_M_emb i]
            simp [u_idem, Pi.single_eq_of_ne (Ne.symm hij)]
          rw [hu_ij, mul_zero]
        · intro hj_abs
          exact absurd (Finset.mem_univ j) hj_abs
      exact ⟨RingEquiv.ofBijective θ_M ⟨hθ_inj, hθ_surj⟩, fun _ _ => rfl⟩

    let 𝒟 : ∀ j : Fin n, Set (Subfield (L j)) :=
      fun j => { F | ∃ (M : IntermediateField K₀ κ₁) (hM : M ∈ ℐ), F = F_sub M hM j }
    let F₀ : ∀ j : Fin n, Subfield (L j) := fun j => F_sub E₀_if hE₀_mem_ℐ j
    obtain ⟨e₀, he₀_apply⟩ := hEquiv_M E₀_if hE₀_mem_ℐ

    have hF₀_mem : ∀ j : Fin n, F₀ j ∈ 𝒟 j := fun j => ⟨E₀_if, hE₀_mem_ℐ, rfl⟩

    have hDir_𝒟 : ∀ j : Fin n, (𝒟 j).Nonempty ∧ DirectedOn (· ≤ ·) (𝒟 j) ∧
        (∀ x : L j, ∃ F ∈ 𝒟 j, x ∈ F) := by
      intro j
      refine ⟨⟨F₀ j, hF₀_mem j⟩, ?_, ?_⟩
      · rintro F_a ⟨M_a, hM_a, rfl⟩ F_b ⟨M_b, hM_b, rfl⟩
        have : FiniteDimensional K₀ ↥M_a := hM_a.1
        have : FiniteDimensional K₀ ↥M_b := hM_b.1
        have hM_ab : M_a ⊔ M_b ∈ ℐ :=
          ⟨IntermediateField.finiteDimensional_sup M_a M_b, hM_a.2.trans le_sup_left⟩
        exact ⟨F_sub (M_a ⊔ M_b) hM_ab j, ⟨M_a ⊔ M_b, hM_ab, rfl⟩,
          hMono_F_sub M_a (M_a ⊔ M_b) hM_a hM_ab le_sup_left j,
          hMono_F_sub M_b (M_a ⊔ M_b) hM_b hM_ab le_sup_right j⟩
      · intro x_L
        let w : TensorProduct K₀ κ₁ K := Phi_inf.symm (Pi.single j x_L)
        obtain ⟨T_w, hT_w⟩ := TensorProduct.exists_finset (R := K₀) w
        let C_w : Finset κ₁ := T_w.image Prod.fst
        let M_c : IntermediateField K₀ κ₁ := IntermediateField.adjoin K₀ (C_w : Set κ₁)
        have : FiniteDimensional K₀ ↥M_c :=
          IntermediateField.finiteDimensional_adjoin (fun x _ => Algebra.IsIntegral.isIntegral x)
        have : FiniteDimensional K₀ ↥E₀_if := hFin_E₀
        let M_w : IntermediateField K₀ κ₁ := E₀_if ⊔ M_c
        have hM_w : M_w ∈ ℐ := ⟨IntermediateField.finiteDimensional_sup E₀_if M_c, le_sup_left⟩
        have hMc_le : M_c ≤ M_w := le_sup_right
        have hp_mem : ∀ p ∈ T_w, p.1 ∈ M_w := fun p hp =>
          hMc_le (IntermediateField.subset_adjoin K₀ (C_w : Set κ₁)
            (Finset.mem_coe.mpr (Finset.mem_image_of_mem _ hp)))
        let w_M : TensorProduct K₀ ↥M_w K :=
          ∑ p ∈ T_w.attach, (⟨p.1.1, hp_mem p.1 p.2⟩ : ↥M_w) ⊗ₜ[K₀] p.1.2
        have hw_emb : emb_M M_w w_M = w := by
          rw [map_sum]
          have hcongr :
              (∑ p ∈ T_w.attach, emb_M M_w ((⟨p.1.1, hp_mem p.1 p.2⟩ : ↥M_w) ⊗ₜ[K₀] p.1.2)) =
              ∑ p ∈ T_w.attach, p.1.1 ⊗ₜ[K₀] p.1.2 :=
            Finset.sum_congr rfl fun _ _ => rfl
          rw [hcongr, Finset.sum_attach T_w (fun p => p.1 ⊗ₜ[K₀] p.2), ← hT_w]
        refine ⟨F_sub M_w hM_w j, ⟨M_w, hM_w, rfl⟩, (hMem_F_sub M_w hM_w j x_L).mpr ⟨w_M, ?_⟩⟩
        change Phi_inf (emb_M M_w w_M) j = x_L
        rw [hw_emb]
        simp [w]

    refine ⟨𝒟, F₀, E₀, inferInstance, inferInstance, φ₀, e₀,
      hDir_𝒟, hF₀_mem, hEt_φ₀, ?_⟩
    intro F₁ hF₁_mem hle₀₁
    choose M_fam hM_fam hF₁_eq using hF₁_mem
    have hFin_sup : ∀ s : Finset (Fin n), FiniteDimensional K₀ ↥(s.sup M_fam) := by
      intro s
      induction s using Finset.induction_on with
      | empty =>
        rw [Finset.sup_empty]
        exact LinearEquiv.finiteDimensional
          (IntermediateField.botEquiv K₀ κ₁).symm.toLinearEquiv
      | insert a s _ ih =>
        rw [Finset.sup_insert]
        have : FiniteDimensional K₀ ↥(M_fam a) := (hM_fam a).1
        have : FiniteDimensional K₀ ↥(s.sup M_fam) := ih
        exact IntermediateField.finiteDimensional_sup (M_fam a) (s.sup M_fam)
    let M_star : IntermediateField K₀ κ₁ := E₀_if ⊔ Finset.univ.sup M_fam
    have : FiniteDimensional K₀ ↥(Finset.univ.sup M_fam) := hFin_sup Finset.univ
    have : FiniteDimensional K₀ ↥E₀_if := hFin_E₀
    have hFin_star : FiniteDimensional K₀ ↥M_star :=
      IntermediateField.finiteDimensional_sup E₀_if (Finset.univ.sup M_fam)
    have hM_star : M_star ∈ ℐ := ⟨hFin_star, le_sup_left⟩
    let E₁ : Type u := ↥M_star
    let φ₁ : E₀ →ₐ[K₀] E₁ := IntermediateField.inclusion (le_sup_left : E₀_if ≤ M_star)
    have hEt_φ₁ : RingHom.Etale φ₁.toRingHom := by
      have := hFin_star
      exact hEtaleOfIntoSep E₀ E₁ M_star.val φ₁
    let F₂ : ∀ j : Fin n, Subfield (L j) := fun j => F_sub M_star hM_star j
    have hle₁₂ : ∀ j : Fin n, F₁ j ≤ F₂ j := by
      intro j
      rw [hF₁_eq j]
      exact hMono_F_sub (M_fam j) M_star (hM_fam j) hM_star
        ((Finset.le_sup (Finset.mem_univ j)).trans le_sup_right) j
    obtain ⟨e₁, he₁_apply⟩ := hEquiv_M M_star hM_star
    refine ⟨E₁, inferInstance, inferInstance, φ₁, F₂, hle₁₂, e₁, hEt_φ₁, ?_⟩
    intro x j
    ext
    change (e₁ (Algebra.TensorProduct.map φ₁ (AlgHom.id K₀ K) x) j : L j) = (e₀ x j : L j)
    rw [he₁_apply, he₀_apply]
    have hcomp : (emb_M M_star).comp (Algebra.TensorProduct.map φ₁ (AlgHom.id K₀ K)) =
        emb_M E₀_if :=
      Algebra.TensorProduct.ext (AlgHom.ext fun _ => rfl) (AlgHom.ext fun _ => rfl)
    have hcomp_x : emb_M M_star (Algebra.TensorProduct.map φ₁ (AlgHom.id K₀ K) x) =
        emb_M E₀_if x :=
      DFunLike.congr_fun hcomp x
    change (Pi.evalRingHom L j) (Phi_inf (emb_M M_star _)) =
      (Pi.evalRingHom L j) (Phi_inf (emb_M E₀_if x))
    rw [hcomp_x]

  
  
  
  obtain ⟨K₀, F_t, hFK₀, hFFt, hAlgκK₀, hAlgK₀Ft, hAlgK₀K, hAlgFtK,
