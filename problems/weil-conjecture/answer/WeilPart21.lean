    intro S₁ S₂ h m i p₁ p₂ hp₁ hp₂
    obtain ⟨p_id, hp_id⟩ := hPull_ex (CategoryTheory.CategoryStruct.id S₁) m i
    have hid_eq : p_id = AddMonoidHom.id _ := hPull_id m i p_id hp_id
