    let i_B : B₀ →+* TensorProduct ↥M₀ L_inf B₀ :=
      (Algebra.TensorProduct.includeRight : B₀ →ₐ[↥M₀] TensorProduct ↥M₀ L_inf B₀).toRingHom
    let Φ_L : TensorProduct ↥M₀ L_inf A₀ →+* TensorProduct ↥M₀ L_inf B₀ :=
      (Algebra.TensorProduct.map (AlgHom.id L_inf L_inf) φ₀).toRingHom
    have hSq : Φ_L.comp i_A = i_B.comp φ₀.toRingHom := by
      ext a
      simp [Φ_L, i_A, i_B]
    have hComapSq : PrimeSpectrum.comap i_A ∘ PrimeSpectrum.comap Φ_L =
        PrimeSpectrum.comap φ₀.toRingHom ∘ PrimeSpectrum.comap i_B := by
      rw [← PrimeSpectrum.comap_comp, ← PrimeSpectrum.comap_comp, hSq]
    have hSurjComp : Function.Surjective
        (PrimeSpectrum.comap φ₀.toRingHom ∘ PrimeSpectrum.comap i_B) := by
      rw [← hComapSq]
      exact hSurj_iA.comp hSurjL
    exact Function.Surjective.of_comp hSurjComp

theorem weil_alt_cd_affine_cover_etale_stage_descent (K F₀ L_inf : Type u) [Field K] [Field F₀] [Field L_inf]
    [Algebra K F₀] [FiniteDimensional K F₀] [Algebra.IsSeparable K F₀] [Algebra.Etale K F₀]
    [Algebra F₀ L_inf] [Algebra.IsSeparable F₀ L_inf]
    (hEtM : ∀ (M : IntermediateField F₀ L_inf), FiniteDimensional F₀ ↥M →
      letI : Algebra K ↥M := RingHom.toAlgebra ((algebraMap F₀ ↥M).comp (algebraMap K F₀))
      Algebra.Etale K ↥M)
    (hDescObj : ∀ (A_inf : Type u) [CommRing A_inf] [Algebra L_inf A_inf] [Algebra.Etale L_inf A_inf],
      ∃ (M₀ : IntermediateField F₀ L_inf) (_ : FiniteDimensional F₀ ↥M₀)
        (A₀ : Type u) (_ : CommRing A₀) (_ : Algebra ↥M₀ A₀) (_ : Algebra.Etale ↥M₀ A₀),
        Nonempty (TensorProduct ↥M₀ L_inf A₀ ≃ₐ[L_inf] A_inf))
    (hDescHom : ∀ (M₀ : IntermediateField F₀ L_inf), FiniteDimensional F₀ ↥M₀ →
      ∀ (A₀ : Type u) [CommRing A₀] [Algebra ↥M₀ A₀],
        (∀ (M : IntermediateField F₀ L_inf) (hle : M₀ ≤ M),
          letI : Algebra ↥M₀ ↥M := (IntermediateField.inclusion hle).toRingHom.toAlgebra
          letI : IsScalarTower ↥M₀ ↥M L_inf := IsScalarTower.of_algebraMap_eq' rfl
          Function.Injective
            (Algebra.TensorProduct.map (IsScalarTower.toAlgHom ↥M₀ ↥M L_inf)
              (AlgHom.id ↥M₀ A₀))) ∧
        (∀ (C : Type u) [CommRing C] [Algebra K C] [Algebra.FiniteType K C]
            (ψ : C →+* TensorProduct ↥M₀ L_inf A₀),
          (∀ c : K, ψ (algebraMap K C c) =
            algebraMap ↥M₀ (TensorProduct ↥M₀ L_inf A₀)
              (algebraMap F₀ ↥M₀ (algebraMap K F₀ c))) →
          ∃ (M₁ : IntermediateField F₀ L_inf) (_ : FiniteDimensional F₀ ↥M₁) (hle : M₀ ≤ M₁),
            letI : Algebra ↥M₀ ↥M₁ := (IntermediateField.inclusion hle).toRingHom.toAlgebra
            letI : IsScalarTower ↥M₀ ↥M₁ L_inf := IsScalarTower.of_algebraMap_eq' rfl
            ∃ (ψ₁ : C →+* TensorProduct ↥M₀ ↥M₁ A₀),
              (∀ c : K, ψ₁ (algebraMap K C c) =
                algebraMap ↥M₀ (TensorProduct ↥M₀ ↥M₁ A₀)
                  (algebraMap F₀ ↥M₀ (algebraMap K F₀ c))) ∧
              (Algebra.TensorProduct.map (IsScalarTower.toAlgHom ↥M₀ ↥M₁ L_inf)
                (AlgHom.id ↥M₀ A₀)).toRingHom.comp ψ₁ = ψ))
    (hDescSurj : ∀ (M₀ : IntermediateField F₀ L_inf), FiniteDimensional F₀ ↥M₀ →
      ∀ (A₀ B₀ : Type u) [CommRing A₀] [CommRing B₀] [Algebra ↥M₀ A₀] [Algebra ↥M₀ B₀]
        (φ₀ : A₀ →ₐ[↥M₀] B₀),
        Function.Surjective
          (PrimeSpectrum.comap (Algebra.TensorProduct.map (AlgHom.id L_inf L_inf) φ₀).toRingHom) →
        Function.Surjective (PrimeSpectrum.comap φ₀.toRingHom))
    (Y : (AlgebraicGeometry.Spec (CommRingCat.of L_inf)).AffineEtale)
    (R : CategoryTheory.Sieve Y)
    (hR : R ∈ (AlgebraicGeometry.Scheme.AffineEtale.topology
      (AlgebraicGeometry.Spec (CommRingCat.of L_inf))) Y) :
    ∃ (m : ℕ) (V : Fin m → (AlgebraicGeometry.Spec (CommRingCat.of L_inf)).AffineEtale)
      (p : ∀ a : Fin m, V a ⟶ Y)
      (M₁ : IntermediateField F₀ L_inf) (_ : FiniteDimensional F₀ ↥M₁)
      (A₁ : Type u) (_ : CommRing A₁) (_ : Algebra ↥M₁ A₁) (_ : Algebra.Etale ↥M₁ A₁)
      (B₁ : Fin m → Type u) (_ : ∀ a, CommRing (B₁ a)) (_ : ∀ a, Algebra ↥M₁ (B₁ a))
      (_ : ∀ a, Algebra.Etale ↥M₁ (B₁ a))
      (C₁ : Fin m → Fin m → Type u) (_ : ∀ a b, CommRing (C₁ a b))
      (_ : ∀ a b, Algebra ↥M₁ (C₁ a b)) (_ : ∀ a b, Algebra.Etale ↥M₁ (C₁ a b))
      (φ₁ : ∀ a : Fin m, A₁ →ₐ[↥M₁] B₁ a)
      (π₁_fst : ∀ a b : Fin m, B₁ a →ₐ[↥M₁] C₁ a b)
      (π₁_snd : ∀ a b : Fin m, B₁ b →ₐ[↥M₁] C₁ a b),
      CategoryTheory.Sieve.ofArrows V p ≤ R ∧
      CategoryTheory.Sieve.ofArrows V p ∈
        (AlgebraicGeometry.Scheme.AffineEtale.topology
          (AlgebraicGeometry.Spec (CommRingCat.of L_inf))) Y ∧
      (let G_L := AlgebraicGeometry.Scheme.AffineEtale.Spec
          (AlgebraicGeometry.Spec (CommRingCat.of L_inf))
       ∃ (e_Y : G_L.obj Y ≅ weilAltCdSpecEtaleObj L_inf (TensorProduct ↥M₁ L_inf A₁))
         (e_V : ∀ a : Fin m,
            G_L.obj (V a) ≅ weilAltCdSpecEtaleObj L_inf (TensorProduct ↥M₁ L_inf (B₁ a)))
         (e_VV : ∀ a b : Fin m,
            G_L.obj (CategoryTheory.Limits.pullback (p a) (p b)) ≅
              weilAltCdSpecEtaleObj L_inf (TensorProduct ↥M₁ L_inf (C₁ a b))),
         (∀ a : Fin m,
            CategoryTheory.CategoryStruct.comp (G_L.map (p a)) e_Y.hom =
              CategoryTheory.CategoryStruct.comp (e_V a).hom
                (weilAltCdSpecEtaleMap L_inf
                  (Algebra.TensorProduct.map (AlgHom.id L_inf L_inf) (φ₁ a)))) ∧
         (∀ a b : Fin m,
            CategoryTheory.CategoryStruct.comp
              (G_L.map (CategoryTheory.Limits.pullback.fst (p a) (p b))) (e_V a).hom =
              CategoryTheory.CategoryStruct.comp (e_VV a b).hom
                (weilAltCdSpecEtaleMap L_inf
                  (Algebra.TensorProduct.map (AlgHom.id L_inf L_inf) (π₁_fst a b))) ∧
            CategoryTheory.CategoryStruct.comp
              (G_L.map (CategoryTheory.Limits.pullback.snd (p a) (p b))) (e_V b).hom =
              CategoryTheory.CategoryStruct.comp (e_VV a b).hom
                (weilAltCdSpecEtaleMap L_inf
                  (Algebra.TensorProduct.map (AlgHom.id L_inf L_inf) (π₁_snd a b))))) ∧
      (∀ (M : IntermediateField F₀ L_inf) (hle : M₁ ≤ M),
        letI : Algebra ↥M₁ ↥M := (IntermediateField.inclusion hle).toRingHom.toAlgebra
        let p_M : ∀ a : Fin m,
            weilAltCdSpecEtaleObj ↥M (TensorProduct ↥M₁ ↥M (B₁ a)) ⟶
              weilAltCdSpecEtaleObj ↥M (TensorProduct ↥M₁ ↥M A₁) :=
          fun a => weilAltCdSpecEtaleMap ↥M (Algebra.TensorProduct.map (AlgHom.id ↥M ↥M) (φ₁ a))
        CategoryTheory.Sieve.ofArrows _ p_M ∈
          (AlgebraicGeometry.Spec (CommRingCat.of ↥M)).smallEtaleTopology
            (weilAltCdSpecEtaleObj ↥M (TensorProduct ↥M₁ ↥M A₁)) ∧
        ∀ a b : Fin m,
          ∃ (e_pb : CategoryTheory.Limits.pullback (p_M a) (p_M b) ≅
              weilAltCdSpecEtaleObj ↥M (TensorProduct ↥M₁ ↥M (C₁ a b))),
            CategoryTheory.Limits.pullback.fst (p_M a) (p_M b) =
              CategoryTheory.CategoryStruct.comp e_pb.hom
                (weilAltCdSpecEtaleMap ↥M
                  (Algebra.TensorProduct.map (AlgHom.id ↥M ↥M) (π₁_fst a b))) ∧
            CategoryTheory.Limits.pullback.snd (p_M a) (p_M b) =
              CategoryTheory.CategoryStruct.comp e_pb.hom
                (weilAltCdSpecEtaleMap ↥M
                  (Algebra.TensorProduct.map (AlgHom.id ↥M ↥M) (π₁_snd a b)))) :=
by
  have hSpecMapId : ∀ (E : Type u) [Field E] (A : Type u) [CommRing A] [Algebra E A]
      [Algebra.Etale E A],
      weilAltCdSpecEtaleMap E (AlgHom.id E A) =
        CategoryTheory.CategoryStruct.id (weilAltCdSpecEtaleObj E A) := by
    intro E _ A _ _ _
    apply CategoryTheory.MorphismProperty.Comma.Hom.ext
    · change AlgebraicGeometry.Spec.map (CommRingCat.ofHom (AlgHom.id E A).toRingHom) =
        CategoryTheory.CategoryStruct.id _
      have hid : CommRingCat.ofHom (AlgHom.id E A).toRingHom =
          CategoryTheory.CategoryStruct.id (CommRingCat.of A) := rfl
      rw [hid, AlgebraicGeometry.Spec.map_id]
    · exact Subsingleton.elim _ _

  have hSpecMapComp : ∀ (E : Type u) [Field E] {A₁ A₂ A₃ : Type u}
      [CommRing A₁] [CommRing A₂] [CommRing A₃]
      [Algebra E A₁] [Algebra E A₂] [Algebra E A₃]
      [Algebra.Etale E A₁] [Algebra.Etale E A₂] [Algebra.Etale E A₃]
      (f₁ : A₁ →ₐ[E] A₂) (f₂ : A₂ →ₐ[E] A₃),
      weilAltCdSpecEtaleMap E (f₂.comp f₁) =
        CategoryTheory.CategoryStruct.comp
          (weilAltCdSpecEtaleMap E f₂) (weilAltCdSpecEtaleMap E f₁) := by
    intro E _ A₁ A₂ A₃ _ _ _ _ _ _ _ _ _ f₁ f₂
    apply CategoryTheory.MorphismProperty.Comma.Hom.ext
    · change AlgebraicGeometry.Spec.map (CommRingCat.ofHom (f₂.comp f₁).toRingHom) =
        CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₂.toRingHom))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₁.toRingHom))
      have hcomp : CommRingCat.ofHom (f₂.comp f₁).toRingHom =
          CategoryTheory.CategoryStruct.comp
            (CommRingCat.ofHom f₁.toRingHom) (CommRingCat.ofHom f₂.toRingHom) := rfl
      rw [hcomp, AlgebraicGeometry.Spec.map_comp]
    · exact Subsingleton.elim _ _

  have hEtaleCoverMem : ∀ (E : Type u) [Field E]
      {B_et : (AlgebraicGeometry.Spec (CommRingCat.of E)).Etale} {ι : Type}
      (Y_et : ι → (AlgebraicGeometry.Spec (CommRingCat.of E)).Etale)
      (g_et : ∀ i : ι, Y_et i ⟶ B_et),
      (∀ x : ↥B_et.left, ∃ i : ι, x ∈ Set.range ((g_et i).left.base)) →
      (∀ i : ι, AlgebraicGeometry.Etale (g_et i).left) →
      CategoryTheory.Sieve.ofArrows Y_et g_et ∈
        (AlgebraicGeometry.Spec (CommRingCat.of E)).smallEtaleTopology B_et := by
    intro E _ B_et ι Y_et g_et hSurj hEt
    let S_E := AlgebraicGeometry.Spec (CommRingCat.of E)
    let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
