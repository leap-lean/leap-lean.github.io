            hSES₂.comp_extClass,
            CategoryTheory.Abelian.Ext.comp_zero]
      have hξ_η : ξ.comp (CategoryTheory.Abelian.Ext.mk₀ (η_Gm E₁ E₂)) (Nat.add_zero 2) = 0 :=
        hResZeroCompEta E₁ E₂ 2 ξ hξ
      obtain ⟨u, hu⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ hSES₁ ξ hξ_η (show 1 + 1 = 2 from rfl)
      have hu0 : u = 0 := @Subsingleton.elim _ hSubJ₁ u 0
      rw [← hu, hu0, CategoryTheory.Abelian.Ext.zero_comp]
    · intro q hq3 hSubGm₁ hSubGm₂ ξ hξ
      have hSubPush := hPushSub E₁ E₂ Gm₂ (q - 1) hSubGm₂
      have hSubJ : Subsingleton (𝒥.H (q - 1)) := by
        refine subsingleton_of_forall_eq 0 (fun u => ?_)
        have hu_i₂ : u.comp (CategoryTheory.Abelian.Ext.mk₀ i₂) (Nat.add_zero (q - 1)) = 0 :=
