            ∀ τ : (E₂ →ₐ[E₁] L_f), (ℋ.obj.map (Opposite.op (ι_sheet τ))).hom t = s τ) := by
    intro L_f inst_FL inst_alg_EL _ _ _ _ U_Lf
    let B_Lf : Type u := ↑U_Lf.left.unop
    let alg_UL : Algebra E₁ B_Lf := weilC1AffEtAlg E₁ U_Lf
    have hAlgEq : ∀ c : E₁, @algebraMap E₁ B_Lf _ _ alg_UL c = algebraMap E₁ L_f c := by
      intro c
