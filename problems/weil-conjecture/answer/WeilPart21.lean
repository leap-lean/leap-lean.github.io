theorem weil_rel_projLine_closed_fiber_section_eval_hom (k : Type u) [Field k] [IsAlgClosed k]
    {Y S F_fib : AlgebraicGeometry.Scheme.{u}}
    (f : Y ⟶ S) (p_fib : F_fib ⟶ AlgebraicGeometry.Spec (CommRingCat.of k))
    (σ : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ S) (ι_σ : F_fib ⟶ Y)
    (_hSq : ι_σ ≫ f = p_fib ≫ σ)
    (m : ℕ) (_hm : 2 ≤ m)
    [_hc_σ : (weilEtaleSitePullback σ).IsContinuous S.smallEtaleTopology
      (AlgebraicGeometry.Spec (CommRingCat.of k)).smallEtaleTopology]
    [_hr_σ : ((weilEtaleSitePullback σ).sheafPushforwardContinuous AddCommGrpCat.{u}
      S.smallEtaleTopology
      (AlgebraicGeometry.Spec (CommRingCat.of k)).smallEtaleTopology).IsRightAdjoint]
    (_hIsoConst_σ : CategoryTheory.IsIso
      (weilEtaleConstPullbackHom σ
        (weilEtaleIdTerminalIsTerminal.{u} (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (weilEtaleIdTerminalIsTerminal.{u} S)
        (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m)))))
    (c_Y : weilEtaleTorsionH Y m 2)
    (p_ισ : weilEtaleTorsionH Y m 2 →+ weilEtaleTorsionH F_fib m 2)
    (_hp_ισ : WeilIsTorsionEtalePullback ι_σ m 2 p_ισ)
    (γ : weilEtaleTorsionSheaf S m ⟶ weilEtaleHigherDirectImage f 2 (weilEtaleTorsionSheaf Y m))
    (_hPin : ∀ (T_S : S.Etale) (hT_S : CategoryTheory.Limits.IsTerminal T_S)
        (hT_top : CategoryTheory.Limits.IsTerminal ((weilEtaleSitePullback f).obj T_S)),
      let Q_rel := CategoryTheory.Sheaf.cohomologyPresheaf (weilEtaleTorsionSheaf Y m) 2
      let P_rel := CategoryTheory.Functor.comp (weilEtaleSitePullback f).op Q_rel
      ((CategoryTheory.constantSheafAdj S.smallEtaleTopology AddCommGrpCat.{u} hT_S).homEquiv
        (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m)))
        (weilEtaleHigherDirectImage f 2 (weilEtaleTorsionSheaf Y m)) γ) (ULift.up 1) =
      (((CategoryTheory.sheafificationAdjunction S.smallEtaleTopology AddCommGrpCat.{u}).unit.app
        P_rel).app (Opposite.op T_S))
        (weilPolyP1CohomologyTermToPresheaf Y ((weilEtaleSitePullback f).obj T_S) hT_top
          (weilEtaleTorsionSheaf Y m) 2 c_Y)) :
    let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
    let Fℤ_Sk := (CategoryTheory.constantSheaf S_k.smallEtaleTopology AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ))
    let pb_σ := (weilEtaleSitePullback σ).sheafPullback AddCommGrpCat.{u}
      S.smallEtaleTopology S_k.smallEtaleTopology
    ∃ (β_σ : ZMod m →+ (pb_σ.obj (weilEtaleTorsionSheaf S m)).H 0)
      (ev_σ : (pb_σ.obj (weilEtaleHigherDirectImage f 2 (weilEtaleTorsionSheaf Y m))).H 0 →+
        weilEtaleTorsionH F_fib m 2),
      ∀ c : ZMod m,
        ev_σ ((CategoryTheory.Abelian.Ext.mk₀ (pb_σ.map γ)).postcomp Fℤ_Sk (Nat.add_zero 0)
          (β_σ c)) = c.val • p_ισ c_Y :=
by
  classical
  intro S_k Fℤ_Sk pb_σ
  let Aℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
  let AM : ℕ → AddCommGrpCat.{u} :=
    fun n => AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod n))
  let T_k : S_k.Etale := weilEtaleIdTerminal.{u} S_k
  let hT_k : CategoryTheory.Limits.IsTerminal T_k := weilEtaleIdTerminalIsTerminal.{u} S_k
  let C_k := CategoryTheory.constantSheaf S_k.smallEtaleTopology AddCommGrpCat.{u}

  have hTor_sheaf : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (n : ℕ),
      n • CategoryTheory.CategoryStruct.id (weilEtaleTorsionSheaf Z n) = 0 := by
    intro Z n
    have hAM : n • CategoryTheory.CategoryStruct.id (AM n) = 0 := by
      ext ⟨x⟩; change ULift.up (n • x) = ULift.up 0; simp [nsmul_eq_mul, CharP.cast_eq_zero]
    calc
      n • CategoryTheory.CategoryStruct.id (weilEtaleTorsionSheaf Z n)
        = (CategoryTheory.constantSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).map
            (n • CategoryTheory.CategoryStruct.id (AM n)) := by
            rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id]
      _ = (CategoryTheory.constantSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).map 0 := by rw [hAM]
      _ = 0 := CategoryTheory.Functor.map_zero _ _ _

  have hExt_nsmul_zero : ∀ {𝒞 : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} 𝒞]
      [CategoryTheory.Abelian 𝒞] [CategoryTheory.HasExt.{u} 𝒞]
      {X₁ X₂ : 𝒞} {q : ℕ} (n : ℕ),
      n • CategoryTheory.CategoryStruct.id X₂ = 0 →
      ∀ (e : CategoryTheory.Abelian.Ext.{u} X₁ X₂ q), n • e = 0 := by
    intro 𝒞 _ _ _ X₁ X₂ q n hX₂ e
    have h_eq : ∀ d : ℕ,
        d • e = e.comp (CategoryTheory.Abelian.Ext.mk₀ (d • CategoryTheory.CategoryStruct.id X₂))
          (Nat.add_zero q) := by
      intro d; induction d with
      | zero => rw [zero_nsmul, zero_nsmul, CategoryTheory.Abelian.Ext.mk₀_zero,
          CategoryTheory.Abelian.Ext.comp_zero]
      | succ d ih => rw [succ_nsmul, succ_nsmul, ih, CategoryTheory.Abelian.Ext.mk₀_add,
          CategoryTheory.Abelian.Ext.comp_add, CategoryTheory.Abelian.Ext.comp_mk₀_id]
    rw [h_eq n, hX₂, CategoryTheory.Abelian.Ext.mk₀_zero, CategoryTheory.Abelian.Ext.comp_zero]

  have hZMod_smul_hom : ∀ (n : ℕ) (_hn : 1 ≤ n) {G : Type u} [AddCommGroup G]
      (g : G) (_hg : n • g = 0),
      ∃ μ : ZMod n →+ G, ∀ a : ZMod n, μ a = a.val • g := by
    intro n hn G _ g hg
    have : NeZero n := ⟨by omega⟩
    refine ⟨{
      toFun := fun a => a.val • g
      map_zero' := by rw [ZMod.val_zero, zero_nsmul]
      map_add' := fun a b => by
        have hdiv := Nat.div_add_mod (a.val + b.val) n
        have hval := ZMod.val_add a b
        calc
          (a + b).val • g = ((a.val + b.val) % n) • g := by rw [hval]
          _ = (n * ((a.val + b.val) / n)) • g + ((a.val + b.val) % n) • g := by
              rw [mul_nsmul, hg, nsmul_zero, zero_add]
          _ = (n * ((a.val + b.val) / n) + (a.val + b.val) % n) • g := (add_nsmul _ _ _).symm
          _ = (a.val + b.val) • g := by rw [hdiv]
          _ = a.val • g + b.val • g := add_nsmul g a.val b.val }, fun _ => rfl⟩

  have hConstUnit_map : ∀ (Z : AlgebraicGeometry.Scheme.{u}) {W₁ W₂ : Z.Etale}
      (v : W₁ ⟶ W₂) (A : AddCommGrpCat.{u}),
      (((CategoryTheory.sheafificationAdjunction Z.smallEtaleTopology AddCommGrpCat.{u}).unit.app
          ((CategoryTheory.Functor.const (Opposite Z.Etale)).obj A)).app (Opposite.op W₂)) ≫
        (((CategoryTheory.constantSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).obj A).obj.map
          (Opposite.op v)) =
      (((CategoryTheory.sheafificationAdjunction Z.smallEtaleTopology AddCommGrpCat.{u}).unit.app
          ((CategoryTheory.Functor.const (Opposite Z.Etale)).obj A)).app (Opposite.op W₁)) := by
    intro Z W₁ W₂ v A
    exact (((CategoryTheory.sheafificationAdjunction Z.smallEtaleTopology AddCommGrpCat.{u}).unit.app
      ((CategoryTheory.Functor.const (Opposite Z.Etale)).obj A)).naturality (Opposite.op v)).symm.trans
      (CategoryTheory.Category.id_comp _)

  have hRepMap_left : ∀ (Z : AlgebraicGeometry.Scheme.{u}) {V₁ V₂ : Z.Etale} (u : V₁ ⟶ V₂)
      (G : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
      (α : weilPolyP1CohomologyRepSheaf Z V₂ ⟶ G),
      weilPolyP1CohomologyRepHomEquiv Z V₁ G
        ((CategoryTheory.presheafToSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).map
          (CategoryTheory.Functor.whiskerRight (CategoryTheory.yoneda.map u) AddCommGrpCat.free) ≫ α) =
      (G.obj.map (Opposite.op u)).hom (weilPolyP1CohomologyRepHomEquiv Z V₂ G α) := by
    intro Z V₁ V₂ u G α
