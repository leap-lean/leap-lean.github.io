    let ι_sheet : ∀ τ : (E₂ →ₐ[E₁] L_f), mkSheetObj L_f τ ⟶ R.obj U_Lf := fun τ =>
      CategoryTheory.MorphismProperty.CostructuredArrow.homMk
        (Opposite.op (CommRingCat.ofHom (π_τ τ))) trivial
        (by
          let _ : Algebra E₁ B_Lf := alg_UL
          have hcomp : CategoryTheory.CategoryStruct.comp
              (CommRingCat.ofHom (algebraMap E₂ (TensorProduct E₁ E₂ B_Lf)))
              (CommRingCat.ofHom (π_τ τ)) =
              CommRingCat.ofHom τ.toRingHom := by
            apply CommRingCat.hom_ext
            apply RingHom.ext
            intro e
            simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply]
            change τ e * 1 = τ e
            exact mul_one (τ e)
          exact (AlgebraicGeometry.Spec.map_comp
              (CommRingCat.ofHom (algebraMap E₂ (TensorProduct E₁ E₂ B_Lf)))
              (CommRingCat.ofHom (π_τ τ))).symm.trans
            (congrArg AlgebraicGeometry.Spec.map hcomp))
    refine ⟨ι_sheet, fun _ _ _ => rfl, fun ℋ s => ?_⟩
    exact hClopenGlue E₂ (E₂ →ₐ[E₁] L_f) (R.obj U_Lf) (fun τ => mkSheetObj L_f τ)
      (fun _ => Field.toIsField L_f) ι_sheet hBij ℋ s

  let U_L₀ := mkFieldObj L₀
  let h_L₀ : U_L₀ ⟶ U :=
    CategoryTheory.MorphismProperty.CostructuredArrow.homMk
      (Opposite.op (CommRingCat.ofHom ψ₀.toRingHom)) trivial
      (by
        have hpre_comp : CategoryTheory.CategoryStruct.comp
            ((AlgebraicGeometry.Scheme.Spec.preimage U.hom).unop)
            (CommRingCat.ofHom ψ₀.toRingHom) =
            CommRingCat.ofHom (algebraMap E₁ L₀) :=
          CommRingCat.hom_ext ψ₀.comp_algebraMap
        exact (congrArg
            (CategoryTheory.CategoryStruct.comp
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀.toRingHom)))
            (AlgebraicGeometry.Scheme.Spec.map_preimage U.hom).symm).trans
          ((AlgebraicGeometry.Spec.map_comp
              ((AlgebraicGeometry.Scheme.Spec.preimage U.hom).unop)
              (CommRingCat.ofHom ψ₀.toRingHom)).symm.trans
            (congrArg AlgebraicGeometry.Spec.map hpre_comp)))
  obtain ⟨hCard₀, ι_sheet₀, hι_eval₀, _⟩ := hSheetPackage L₀
  let y₀ : ↑(𝒢.obj.obj (Opposite.op (R.obj U_L₀))) :=
    (𝒢.obj.map (Opposite.op (R.map h_L₀))).hom y
  have hLocSheets : ∀ τ : (E₂ →ₐ[E₁] L₀),
      ∃ (Y_τ : (AlgebraicGeometry.Spec (CommRingCat.of E₂)).AffineEtale)
        (u_τ : Y_τ ⟶ mkSheetObj L₀ τ)
        (w_τ : ↑(ℱ.obj.obj (Opposite.op Y_τ))),
        RingHom.Etale (u_τ.left.unop).hom ∧
        Nontrivial ↑Y_τ.left.unop ∧
        (g.hom.app (Opposite.op Y_τ)).hom w_τ =
          (𝒢.obj.map u_τ.op).hom ((𝒢.obj.map (Opposite.op (ι_sheet₀ τ))).hom y₀) :=
    fun τ => hLoc_g (mkSheetObj L₀ τ) ((𝒢.obj.map (Opposite.op (ι_sheet₀ τ))).hom y₀)
      (⊥ : PrimeSpectrum L₀)
  choose Y_fam u_fam w_fam hEt_u hNontriv_Y hw_eq using hLocSheets
  let D_fam : (E₂ →ₐ[E₁] L₀) → Type u := fun τ => ↑(Y_fam τ).left.unop
  let _ : ∀ τ, Nontrivial (D_fam τ) := hNontriv_Y
  let _ : ∀ τ, Algebra L₀ (D_fam τ) := fun τ => (((u_fam τ).left.unop).hom).toAlgebra
  have _ : ∀ τ, Algebra.Etale L₀ (D_fam τ) := fun τ => RingHom.etale_algebraMap.mp (hEt_u τ)
  obtain ⟨L_comp, hFL_c, hAlgL_c, hFinL_c, hSepL_c, hEmbL_c⟩ :=
    hEtaleGaloisAndComp.2 L₀ (E₂ →ₐ[E₁] L₀) D_fam
  let _ : Field L_comp := hFL_c
  let _ : Algebra L₀ L_comp := hAlgL_c
  let _ : FiniteDimensional L₀ L_comp := hFinL_c
  let _ : Algebra.IsSeparable L₀ L_comp := hSepL_c
  let ρ_fam : ∀ τ : (E₂ →ₐ[E₁] L₀), D_fam τ →ₐ[L₀] L_comp :=
    fun τ => Classical.choice (hEmbL_c τ)
  let _ : Algebra E₁ L_comp := ((algebraMap L₀ L_comp).comp (algebraMap E₁ L₀)).toAlgebra
  have _ : IsScalarTower E₁ L₀ L_comp := IsScalarTower.of_algebraMap_eq' rfl
  have _ : FiniteDimensional E₁ L_comp := Module.Finite.trans L₀ L_comp
  have _ : Algebra.IsSeparable E₁ L_comp := Algebra.IsSeparable.trans E₁ L₀ L_comp
  obtain ⟨hCardL, ι_sheetL, hι_evalL, hGlueL⟩ := hSheetPackage L_comp

  let liftEmb : (E₂ →ₐ[E₁] L₀) → (E₂ →ₐ[E₁] L_comp) :=
    fun τ => (IsScalarTower.toAlgHom E₁ L₀ L_comp).comp τ
  have hBijLift : Function.Bijective liftEmb := by
    refine (Fintype.bijective_iff_injective_and_card liftEmb).mpr ⟨?_, ?_⟩
    · intro τ₁ τ₂ heq
      apply AlgHom.ext
      intro e
      exact (algebraMap L₀ L_comp).injective (AlgHom.congr_fun heq e)
    · rw [hCard₀, hCardL]
  let eqvEmb : (E₂ →ₐ[E₁] L₀) ≃ (E₂ →ₐ[E₁] L_comp) := Equiv.ofBijective liftEmb hBijLift

  let U_L := mkFieldObj L_comp
  let μ_L : U_L ⟶ U_L₀ :=
    CategoryTheory.MorphismProperty.CostructuredArrow.homMk
      (Opposite.op (CommRingCat.ofHom (algebraMap L₀ L_comp))) trivial
      ((AlgebraicGeometry.Spec.map_comp
          (CommRingCat.ofHom (algebraMap E₁ L₀))
          (CommRingCat.ofHom (algebraMap L₀ L_comp))).symm.trans
        (congrArg AlgebraicGeometry.Spec.map (CommRingCat.hom_ext rfl)))
  let h_L : U_L ⟶ U := CategoryTheory.CategoryStruct.comp μ_L h_L₀

  let u_step_of : ∀ τ_L : (E₂ →ₐ[E₁] L_comp),
      mkSheetObj L_comp τ_L ⟶ Y_fam (eqvEmb.symm τ_L) := fun τ_L =>
    let τ := eqvEmb.symm τ_L
    let ρ_τ := ρ_fam τ
    CategoryTheory.MorphismProperty.CostructuredArrow.homMk
      (Opposite.op (CommRingCat.ofHom ρ_τ.toRingHom)) trivial
      (by
        have hRingComp : CategoryTheory.CategoryStruct.comp
            (CommRingCat.ofHom τ.toRingHom)
            (CategoryTheory.CategoryStruct.comp (u_fam τ).left.unop
              (CommRingCat.ofHom ρ_τ.toRingHom)) =
            CommRingCat.ofHom τ_L.toRingHom :=
          CommRingCat.hom_ext (RingHom.ext fun e =>
            (ρ_τ.commutes (τ e)).trans (AlgHom.congr_fun (eqvEmb.apply_symm_apply τ_L) e))
        exact (congrArg
            (CategoryTheory.CategoryStruct.comp
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_τ.toRingHom)))
            (u_fam τ).w.symm).trans
          (((CategoryTheory.Category.assoc _ _ _).symm.trans
            (congrArg (fun k => CategoryTheory.CategoryStruct.comp k _)
              (AlgebraicGeometry.Spec.map_comp _ _).symm)).trans
            ((AlgebraicGeometry.Spec.map_comp _ _).symm.trans
              (congrArg AlgebraicGeometry.Spec.map hRingComp))))

  let s_L : ∀ τ_L : (E₂ →ₐ[E₁] L_comp),
      ↑(ℱ.obj.obj (Opposite.op (mkSheetObj L_comp τ_L))) :=
    fun τ_L => (ℱ.obj.map (u_step_of τ_L).op).hom (w_fam (eqvEmb.symm τ_L))

  obtain ⟨x_glued, hx_glued, _⟩ := hGlueL ℱ s_L
  have hy_eq : (g.hom.app (Opposite.op (R.obj U_L))).hom x_glued =
      (𝒢.obj.map (R.map h_L).op).hom y := by
    let z₁ := (g.hom.app (Opposite.op (R.obj U_L))).hom x_glued
    let z₂ := (𝒢.obj.map (R.map h_L).op).hom y
    obtain ⟨_, _, hUniq₃⟩ := hGlueL 𝒢 (fun τ_L =>
      (𝒢.obj.map (ι_sheetL τ_L).op).hom z₂)
    have hz₁ : ∀ τ_L : (E₂ →ₐ[E₁] L_comp),
        (𝒢.obj.map (ι_sheetL τ_L).op).hom z₁ =
          (𝒢.obj.map (ι_sheetL τ_L).op).hom z₂ := by
      intro τ_L
      let τ := eqvEmb.symm τ_L
      let ρ_τ := ρ_fam τ
      let u_step := u_step_of τ_L
      have hSq : CategoryTheory.CategoryStruct.comp u_step
          (CategoryTheory.CategoryStruct.comp (u_fam τ) (ι_sheet₀ τ)) =
          CategoryTheory.CategoryStruct.comp (ι_sheetL τ_L) (R.map μ_L) := by
        refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
        apply Opposite.unop_injective
        apply CommRingCat.hom_ext
        let B₀ : Type u := ↑U_L₀.left.unop
        let B₁ : Type u := ↑U_L.left.unop
        let alg₀ : Algebra E₁ B₀ := weilC1AffEtAlg E₁ U_L₀
        let alg₁ : Algebra E₁ B₁ := weilC1AffEtAlg E₁ U_L
        let _ : Algebra E₁ B₀ := alg₀
        let _ : Algebra E₁ B₁ := alg₁
        let π₀_hom : TensorProduct E₁ E₂ B₀ →+* L₀ := ((ι_sheet₀ τ).left.unop).hom
        let πL_hom : TensorProduct E₁ E₂ B₁ →+* L_comp := ((ι_sheetL τ_L).left.unop).hom
        let u_hom : L₀ →+* D_fam τ := ((u_fam τ).left.unop).hom
        let μ_hom : TensorProduct E₁ E₂ B₀ →+* TensorProduct E₁ E₂ B₁ :=
          ((R.map μ_L).left.unop).hom
        apply RingHom.ext
        intro z
        change ρ_τ (u_hom (π₀_hom z)) = πL_hom (μ_hom z)
        induction z using TensorProduct.induction_on with
        | zero =>
          exact (congrArg (fun x => ρ_τ (u_hom x)) (RingHom.map_zero π₀_hom)).trans
            ((congrArg ρ_τ (RingHom.map_zero u_hom)).trans
              ((map_zero ρ_τ).trans
                ((RingHom.map_zero πL_hom).symm.trans
                  (congrArg πL_hom (RingHom.map_zero μ_hom).symm))))
        | tmul e l₀ =>
          let l₀' : L₀ := l₀
          have hL_side : ρ_τ (u_hom (π₀_hom (e ⊗ₜ[E₁] l₀))) =
              τ_L e * algebraMap L₀ L_comp l₀' :=
            (congrArg (fun x => ρ_τ (u_hom x)) (hι_eval₀ τ e l₀')).trans
              ((ρ_τ.commutes (τ e * l₀')).trans
                ((map_mul (algebraMap L₀ L_comp) (τ e) l₀').trans
                  (congrArg (· * algebraMap L₀ L_comp l₀')
                    (AlgHom.congr_fun (eqvEmb.apply_symm_apply τ_L) e))))
          have hR_side : πL_hom (μ_hom (e ⊗ₜ[E₁] l₀)) =
              τ_L e * algebraMap L₀ L_comp l₀' :=
            hι_evalL τ_L e (algebraMap L₀ L_comp l₀')
          exact hL_side.trans hR_side.symm
        | add a b iha ihb =>
          exact (congrArg (fun x => ρ_τ (u_hom x)) (RingHom.map_add π₀_hom a b)).trans
            ((congrArg ρ_τ (RingHom.map_add u_hom _ _)).trans
              ((map_add ρ_τ _ _).trans
                ((congrArg₂ (· + ·) iha ihb).trans
                  ((RingHom.map_add πL_hom _ _).symm.trans
                    (congrArg πL_hom (RingHom.map_add μ_hom a b).symm)))))
      have h1 : (𝒢.obj.map (ι_sheetL τ_L).op).hom z₁ =
          (g.hom.app _).hom ((ℱ.obj.map (ι_sheetL τ_L).op).hom x_glued) :=
        (ConcreteCategory.congr_hom (g.hom.naturality (ι_sheetL τ_L).op) x_glued).symm
      have h2 : (g.hom.app _).hom ((ℱ.obj.map (ι_sheetL τ_L).op).hom x_glued) =
          (g.hom.app _).hom (s_L τ_L) :=
        congrArg (g.hom.app _).hom (hx_glued τ_L)
      have h3 : (g.hom.app _).hom (s_L τ_L) =
          (𝒢.obj.map u_step.op).hom ((g.hom.app _).hom (w_fam τ)) :=
        ConcreteCategory.congr_hom (g.hom.naturality u_step.op) (w_fam τ)
      have h4 : (𝒢.obj.map u_step.op).hom ((g.hom.app _).hom (w_fam τ)) =
          (𝒢.obj.map u_step.op).hom
            ((𝒢.obj.map (u_fam τ).op).hom
              ((𝒢.obj.map (ι_sheet₀ τ).op).hom y₀)) :=
        congrArg (𝒢.obj.map u_step.op).hom (hw_eq τ)
      have h5 : (𝒢.obj.map u_step.op).hom
          ((𝒢.obj.map (u_fam τ).op).hom
            ((𝒢.obj.map (ι_sheet₀ τ).op).hom y₀)) =
          (𝒢.obj.map (CategoryTheory.CategoryStruct.comp u_step
            (CategoryTheory.CategoryStruct.comp (u_fam τ) (ι_sheet₀ τ))).op).hom y₀ := by
        have hc₁ := ConcreteCategory.congr_hom
          ((𝒢.obj.map_comp (ι_sheet₀ τ).op (u_fam τ).op).symm.trans
            (congrArg 𝒢.obj.map CategoryTheory.op_comp.symm))
          y₀
        have hc₂ := ConcreteCategory.congr_hom
          ((𝒢.obj.map_comp
              (CategoryTheory.CategoryStruct.comp (u_fam τ) (ι_sheet₀ τ)).op
              u_step.op).symm.trans
            (congrArg 𝒢.obj.map CategoryTheory.op_comp.symm))
          y₀
        exact (congrArg (𝒢.obj.map u_step.op).hom hc₁).trans hc₂
      have h6 : (𝒢.obj.map (CategoryTheory.CategoryStruct.comp u_step
            (CategoryTheory.CategoryStruct.comp (u_fam τ) (ι_sheet₀ τ))).op).hom y₀ =
          (𝒢.obj.map (CategoryTheory.CategoryStruct.comp
            (ι_sheetL τ_L) (R.map μ_L)).op).hom y₀ :=
        congrArg (fun k : mkSheetObj L_comp τ_L ⟶ R.obj U_L₀ => (𝒢.obj.map k.op).hom y₀) hSq
      have h7 : (𝒢.obj.map (CategoryTheory.CategoryStruct.comp
            (ι_sheetL τ_L) (R.map μ_L)).op).hom y₀ =
          (𝒢.obj.map (ι_sheetL τ_L).op).hom z₂ := by
        have hd₁ := ConcreteCategory.congr_hom
          ((congrArg 𝒢.obj.map CategoryTheory.op_comp).trans
            (𝒢.obj.map_comp (R.map μ_L).op (ι_sheetL τ_L).op))
          y₀
        have hd₂ := ConcreteCategory.congr_hom
          ((𝒢.obj.map_comp (R.map h_L₀).op (R.map μ_L).op).symm.trans
            ((congrArg 𝒢.obj.map CategoryTheory.op_comp.symm).trans
              (congrArg (fun k : R.obj U_L ⟶ R.obj U => 𝒢.obj.map k.op)
                (R.map_comp μ_L h_L₀).symm)))
          y
        exact hd₁.trans (congrArg (𝒢.obj.map (ι_sheetL τ_L).op).hom hd₂)
      exact h1.trans (h2.trans (h3.trans (h4.trans (h5.trans (h6.trans h7)))))
    exact (hUniq₃ z₁ hz₁).trans (hUniq₃ z₂ (fun _ => rfl)).symm

  refine ⟨U_L, h_L, (⊥ : PrimeSpectrum L_comp), x_glued, ?_, hy_eq⟩
  apply PrimeSpectrum.ext
  ext a
  change algebraMap L₀ L_comp (ψ₀ a) ∈ (⊥ : Ideal L_comp) ↔ a ∈ p.asIdeal
  have hiff₁ : algebraMap L₀ L_comp (ψ₀ a) ∈ (⊥ : Ideal L_comp) ↔ ψ₀ a ∈ (⊥ : Ideal L₀) :=
    Ideal.mem_bot.trans
      ((map_eq_zero_iff (algebraMap L₀ L_comp) (algebraMap L₀ L_comp).injective).trans
        Ideal.mem_bot.symm)
  exact hiff₁.trans (iff_of_eq (congrArg (fun I : PrimeSpectrum A => a ∈ I.asIdeal) hComap_ψ₀))

theorem weil_c1_affEt_sep_gm_pullback_restriction_package (hGm : ∀ (F : Type u) [Field F],
      CategoryTheory.Presheaf.IsSheaf (weilC1AffEtTop F) (weilC1AffEtGmPresheaf F))
    (hCont₁ : ∀ (E₁ E₂ : Type u) [Field E₁] [Field E₂] [Algebra E₁ E₂]
      [FiniteDimensional E₁ E₂] [Algebra.IsSeparable E₁ E₂],
      (weilC1AffEtForgetSite E₁ E₂).IsContinuous (weilC1AffEtTop E₂) (weilC1AffEtTop E₁))
    (hCont₂ : ∀ (E₁ E₂ : Type u) [Field E₁] [Field E₂] [Algebra E₁ E₂]
      [FiniteDimensional E₁ E₂] [Algebra.IsSeparable E₁ E₂],
      (weilC1AffEtBaseChangeSite E₁ E₂).IsContinuous (weilC1AffEtTop E₁) (weilC1AffEtTop E₂))
    (hAdjSite : ∀ (E₁ E₂ : Type u) [Field E₁] [Field E₂] [Algebra E₁ E₂]
      [FiniteDimensional E₁ E₂] [Algebra.IsSeparable E₁ E₂],
      ∃ (adjSite : weilC1AffEtForgetSite E₁ E₂ ⊣ weilC1AffEtBaseChangeSite E₁ E₂),
        ∀ (U : (AlgebraicGeometry.Spec (CommRingCat.of E₁)).AffineEtale),
          letI : Algebra E₁ ↑U.left.unop := weilC1AffEtAlg E₁ U
          ((adjSite.counit.app U).left.unop).hom =
            (Algebra.TensorProduct.includeRight :
              ↑U.left.unop →ₐ[E₁] TensorProduct E₁ E₂ ↑U.left.unop).toRingHom)
    (hColim₂ : ∀ (E₁ E₂ : Type u) [Field E₁] [Field E₂] [Algebra E₁ E₂]
      [FiniteDimensional E₁ E₂] [Algebra.IsSeparable E₁ E₂],
      letI := hCont₂ E₁ E₂
      CategoryTheory.Limits.PreservesFiniteColimits
        ((weilC1AffEtBaseChangeSite E₁ E₂).sheafPushforwardContinuous
          AddCommGrpCat.{u} (weilC1AffEtTop E₁) (weilC1AffEtTop E₂))) :
    let P_pull : ∀ (E₁ E₂ : Type u) [Field E₁] [Field E₂] [Algebra E₁ E₂]
        [FiniteDimensional E₁ E₂] [Algebra.IsSeparable E₁ E₂],
        CategoryTheory.Functor
          (CategoryTheory.Sheaf (weilC1AffEtTop E₁) AddCommGrpCat.{u})
          (CategoryTheory.Sheaf (weilC1AffEtTop E₂) AddCommGrpCat.{u}) :=
      fun E₁ E₂ _ _ _ _ _ =>
        letI := hCont₁ E₁ E₂
        (weilC1AffEtForgetSite E₁ E₂).sheafPushforwardContinuous
          AddCommGrpCat.{u} (weilC1AffEtTop E₂) (weilC1AffEtTop E₁)
    let P_push : ∀ (E₁ E₂ : Type u) [Field E₁] [Field E₂] [Algebra E₁ E₂]
        [FiniteDimensional E₁ E₂] [Algebra.IsSeparable E₁ E₂],
        CategoryTheory.Functor
          (CategoryTheory.Sheaf (weilC1AffEtTop E₂) AddCommGrpCat.{u})
          (CategoryTheory.Sheaf (weilC1AffEtTop E₁) AddCommGrpCat.{u}) :=
      fun E₁ E₂ _ _ _ _ _ =>
        letI := hCont₂ E₁ E₂
        (weilC1AffEtBaseChangeSite E₁ E₂).sheafPushforwardContinuous
          AddCommGrpCat.{u} (weilC1AffEtTop E₁) (weilC1AffEtTop E₂)
    (∀ (E₁ E₂ : Type u) [Field E₁] [Field E₂] [Algebra E₁ E₂]
        [FiniteDimensional E₁ E₂] [Algebra.IsSeparable E₁ E₂],
      (P_pull E₁ E₂).Additive) ∧
    (∀ (E₁ E₂ : Type u) [Field E₁] [Field E₂] [Algebra E₁ E₂]
        [FiniteDimensional E₁ E₂] [Algebra.IsSeparable E₁ E₂],
      CategoryTheory.Limits.PreservesFiniteLimits (P_pull E₁ E₂)) ∧
    (∀ (E₁ E₂ : Type u) [Field E₁] [Field E₂] [Algebra E₁ E₂]
        [FiniteDimensional E₁ E₂] [Algebra.IsSeparable E₁ E₂],
      CategoryTheory.Limits.PreservesFiniteColimits (P_pull E₁ E₂)) ∧
    ∃ (res : ∀ (E₁ E₂ : Type u) [Field E₁] [Field E₂] [Algebra E₁ E₂]
          [FiniteDimensional E₁ E₂] [Algebra.IsSeparable E₁ E₂] (q : ℕ),
          (weilC1AffEtGmSheaf E₁ (hGm E₁)).H q →+ (weilC1AffEtGmSheaf E₂ (hGm E₂)).H q)
      (η_Gm : ∀ (E₁ E₂ : Type u) [Field E₁] [Field E₂] [Algebra E₁ E₂]
          [FiniteDimensional E₁ E₂] [Algebra.IsSeparable E₁ E₂],
          weilC1AffEtGmSheaf E₁ (hGm E₁) ⟶
            (P_push E₁ E₂).obj (weilC1AffEtGmSheaf E₂ (hGm E₂))),
      (∀ (E₁ E₂ : Type u) [Field E₁] [Field E₂] [Algebra E₁ E₂]
          [FiniteDimensional E₁ E₂] [Algebra.IsSeparable E₁ E₂]
          (U : (AlgebraicGeometry.Spec (CommRingCat.of E₁)).AffineEtale),
        letI : Algebra E₁ ↑U.left.unop := weilC1AffEtAlg E₁ U
        ∀ (a : (↑U.left.unop)ˣ),
          ((η_Gm E₁ E₂).hom.app (Opposite.op U)).hom (Additive.ofMul a) =
            Additive.ofMul (Units.map
              (Algebra.TensorProduct.includeRight :
                ↑U.left.unop →ₐ[E₁] TensorProduct E₁ E₂ ↑U.left.unop).toRingHom.toMonoidHom a)) ∧
      (∀ (E₁ E₂ : Type u) [Field E₁] [Field E₂] [Algebra E₁ E₂]
          [FiniteDimensional E₁ E₂] [Algebra.IsSeparable E₁ E₂] (q : ℕ),
        Function.Bijective (algebraMap E₁ E₂) → Function.Injective (res E₁ E₂ q)) ∧
      (∀ (E₁ E₂ E₃ : Type u) [Field E₁] [Field E₂] [Field E₃]
          [Algebra E₁ E₂] [Algebra E₂ E₃] [Algebra E₁ E₃] [IsScalarTower E₁ E₂ E₃]
          [FiniteDimensional E₁ E₂] [Algebra.IsSeparable E₁ E₂]
