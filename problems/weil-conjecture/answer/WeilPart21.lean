    induction w using TensorProduct.induction_on with
    | zero => simp only [map_zero]
    | tmul c₀ p =>
      change (Algebra.TensorProduct.lift u₀_P v_fin (fun _ _ => Commute.all _ _)) (c₀ ⊗ₜ[P] j p) =
        (Algebra.TensorProduct.lift u₀_P v_init (fun _ _ => Commute.all _ _)) (c₀ ⊗ₜ[P] p)
      rw [Algebra.TensorProduct.lift_tmul, Algebra.TensorProduct.lift_tmul, hv_j p]
    | add w₁ w₂ ih₁ ih₂ => simp only [map_add, ih₁, ih₂]
  · intro z
    induction z using TensorProduct.induction_on with
    | zero => simp only [map_zero]
    | tmul k w =>
      induction w using TensorProduct.induction_on with
      | zero => simp only [TensorProduct.tmul_zero, map_zero]
      | tmul c₀ p =>
        have hstep :
            Algebra.TensorProduct.map (AlgHom.id B K) (IsScalarTower.toAlgHom B C_init C_fin)
              (k ⊗ₜ[B] (c₀ ⊗ₜ[P] p)) = k ⊗ₜ[B] (c₀ ⊗ₜ[P] j p) := rfl
        rw [hstep, hα_fin_tmul, hα_init_tmul,
          Algebra.TensorProduct.map_tmul, AlgHom.id_apply, hι_j p]
      | add w₁ w₂ ih₁ ih₂ =>
        simp only [TensorProduct.tmul_add, map_add, ih₁, ih₂]
    | add z₁ z₂ ih₁ ih₂ => simp only [map_add, ih₁, ih₂]

theorem weil_alt_cd_separable_splitting_and_standard_etale_chart (P B K Ω : Type u) [CommRing P] [IsDomain P] [CommRing B] [IsDomain B]
    [Field K] [Algebra B K] [IsFractionRing B K] [Field Ω] [IsAlgClosed Ω]
    (e : ℕ) (ψ : P →+* B) (ev_x : B →+* Ω)
    (h_ev : ∀ h : P, h ≠ 0 → ev_x (ψ h) ≠ 0)
    (i_K : FractionRing P →+* K)
    (hi_K : ∀ h : P, i_K (algebraMap P (FractionRing P) h) = algebraMap B K (ψ h))
    (hDimK : letI : Algebra (FractionRing P) K := i_K.toAlgebra
      (⊤ : IntermediateField (FractionRing P) K).FG ∧
      Algebra.trdeg (FractionRing P) K ≤ (e : Cardinal.{u}))
    (C₀ : Type u) [CommRing C₀] [Algebra B C₀] [Algebra.Etale B C₀]
    (u₀ : C₀ →+* Ω) (hu₀ : u₀.comp (algebraMap B C₀) = ev_x) :
    ∃ (κ_sep : Type u) (_ : Field κ_sep) (_ : IsSepClosed κ_sep) (_ : Algebra P κ_sep)
      (N : ℕ) (F_init L_inf : Fin N → Type u)
      (_ : ∀ a, Field (F_init a)) (_ : ∀ a, Field (L_inf a))
      (_ : ∀ a, Algebra K (F_init a)) (_ : ∀ a, Algebra.Etale K (F_init a))
      (_ : ∀ a, Algebra (F_init a) (L_inf a)) (_ : ∀ a, Algebra.IsSeparable (F_init a) (L_inf a))
      (_ : ∀ a, Algebra κ_sep (L_inf a))
      (C_init : Type u) (_ : CommRing C_init) (_ : Algebra B C_init) (_ : Algebra C₀ C_init)
      (_ : IsScalarTower B C₀ C_init) (_ : Algebra.Etale C₀ C_init)
      (u_init : C_init →+* Ω)
      (e_init : TensorProduct B K C_init ≃ₐ[K] (∀ a : Fin N, F_init a)),
      Function.Injective (algebraMap P κ_sep) ∧
      (∀ a : Fin N, Algebra.trdeg κ_sep (L_inf a) ≤ (e : Cardinal.{u})) ∧
      (∀ a : Fin N, FiniteDimensional K (F_init a) ∧ Algebra.IsSeparable K (F_init a)) ∧
      u_init.comp (algebraMap C₀ C_init) = u₀ ∧
      (∀ (M : ∀ a : Fin N, IntermediateField (F_init a) (L_inf a)),
        (∀ a : Fin N, FiniteDimensional (F_init a) ↥(M a)) →
        ∃ (C_fin : Type u) (_ : CommRing C_fin) (_ : Algebra B C_fin)
          (_ : Algebra C_init C_fin) (_ : IsScalarTower B C_init C_fin)
          (_ : Algebra.Etale C_init C_fin) (u_fin : C_fin →+* Ω)
          (M' : ∀ a : Fin N, IntermediateField (F_init a) (L_inf a))
          (_ : ∀ a : Fin N, M a ≤ M' a)
          (_ : ∀ a : Fin N,
            letI : Algebra K ↥(M' a) :=
              RingHom.toAlgebra ((algebraMap (F_init a) ↥(M' a)).comp (algebraMap K (F_init a)))
            Algebra.Etale K ↥(M' a))
          (e_fin :
            letI : ∀ a : Fin N, Algebra K ↥(M' a) := fun a =>
              RingHom.toAlgebra ((algebraMap (F_init a) ↥(M' a)).comp (algebraMap K (F_init a)))
            TensorProduct B K C_fin ≃ₐ[K] (∀ a : Fin N, ↥(M' a))),
          u_fin.comp (algebraMap C_init C_fin) = u_init ∧
          ∀ (z : TensorProduct B K C_init) (a : Fin N),
            ((e_fin (Algebra.TensorProduct.map (AlgHom.id B K)
                (IsScalarTower.toAlgHom B C_init C_fin) z) a : ↥(M' a)) : L_inf a) =
              algebraMap (F_init a) (L_inf a) (e_init z a)) :=
by
  let F₀ : Type u := FractionRing P
  letI : Algebra F₀ K := i_K.toAlgebra
  have hDimK' : (⊤ : IntermediateField F₀ K).FG ∧ Algebra.trdeg F₀ K ≤ (e : Cardinal.{u}) :=
    hDimK
  let g_Ω : P →+* Ω := ev_x.comp ψ
  have hg_Ω_unit : ∀ y : ↥(nonZeroDivisors P), IsUnit (g_Ω y) := by
    intro y
    exact Ne.isUnit (h_ev y.1 (mem_nonZeroDivisors_iff_ne_zero.mp y.2))
  let i_Ω : F₀ →+* Ω := IsLocalization.lift (M := nonZeroDivisors P) (S := F₀) hg_Ω_unit
  letI : Algebra F₀ Ω := i_Ω.toAlgebra
  let κ_sep : Type u := ↥(separableClosure F₀ Ω)
  have hSepCl_κ : IsSepClosure F₀ κ_sep := separableClosure.isSepClosure F₀ Ω
  have : IsSepClosed κ_sep := (isSepClosure_iff.mp hSepCl_κ).1
  have : Algebra.IsSeparable F₀ κ_sep := separableClosure.isSeparable F₀ Ω
  letI algP_κ : Algebra P κ_sep :=
    RingHom.toAlgebra ((algebraMap F₀ κ_sep).comp (algebraMap P F₀))
  have hInj_P : Function.Injective (algebraMap P κ_sep) :=
    (RingHom.injective (algebraMap F₀ κ_sep)).comp (IsFractionRing.injective P F₀)
  let j_Ω : κ_sep →+* Ω := (separableClosure F₀ Ω).val.toRingHom
  have hj_Ω : ∀ h : P, j_Ω (algebraMap F₀ κ_sep (algebraMap P F₀ h)) = ev_x (ψ h) := by
    intro h
    change i_Ω (algebraMap P F₀ h) = g_Ω h
    exact IsLocalization.lift_eq hg_Ω_unit h

  let A₀ : Type u := TensorProduct B K C₀
  have hDecompA₀ : ∃ (r : ℕ) (L : Fin r → Type u)
      (_ : ∀ i, Field (L i)) (_ : ∀ i, Algebra K (L i))
      (_ : ∀ i, Module.Finite K (L i)) (_ : ∀ i, Algebra.IsSeparable K (L i)),
      Nonempty (A₀ ≃ₐ[K] (∀ i : Fin r, L i)) := by
    have hEtA₀ : Algebra.Etale K A₀ := Algebra.Etale.baseChange B C₀ K
    obtain ⟨I, hFinI, Ai, hFieldAi, hAlgKAi, e_I, hFinSepAi⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod K A₀).mp hEtA₀
    have : Finite I := hFinI
    letI : ∀ i : I, Field (Ai i) := hFieldAi
    letI : ∀ i : I, Algebra K (Ai i) := hAlgKAi
    letI : Fintype I := Fintype.ofFinite I
    let r : ℕ := Fintype.card I
    let eqI : I ≃ Fin r := Fintype.equivFin I
    refine ⟨r, fun i => Ai (eqI.symm i), fun i => hFieldAi (eqI.symm i),
      fun i => hAlgKAi (eqI.symm i), fun i => (hFinSepAi (eqI.symm i)).1,
      fun i => (hFinSepAi (eqI.symm i)).2,
      ⟨e_I.trans (AlgEquiv.piCongrLeft' K Ai eqI)⟩⟩
  obtain ⟨r, L, hFieldL, hAlgKL, hFinKL, hSepKL, ⟨e₀⟩⟩ := hDecompA₀
  letI : ∀ i : Fin r, Field (L i) := hFieldL
  letI : ∀ i : Fin r, Algebra K (L i) := hAlgKL
  have : ∀ i : Fin r, Module.Finite K (L i) := hFinKL
  have : ∀ i : Fin r, Algebra.IsSeparable K (L i) := hSepKL
  letI : ∀ i : Fin r, Algebra F₀ (L i) := fun i =>
    RingHom.toAlgebra ((algebraMap K (L i)).comp (algebraMap F₀ K))
  have : ∀ i : Fin r, IsScalarTower F₀ K (L i) := fun _ =>
    IsScalarTower.of_algebraMap_eq' rfl

  let congr_e₀ : ∀ (E : IntermediateField F₀ κ_sep),
      TensorProduct F₀ A₀ ↥E ≃ₐ[K] TensorProduct F₀ (∀ i : Fin r, L i) ↥E := fun E =>
    let eqF₀ : TensorProduct F₀ A₀ ↥E ≃ₐ[F₀] TensorProduct F₀ (∀ i : Fin r, L i) ↥E :=
      Algebra.TensorProduct.congr (e₀.restrictScalars F₀) (AlgEquiv.refl : ↥E ≃ₐ[F₀] ↥E)
    { eqF₀.toRingEquiv with
      commutes' := fun k => by
        change (e₀ (algebraMap K A₀ k)) ⊗ₜ[F₀] (1 : ↥E) =
          (algebraMap K (∀ i : Fin r, L i) k) ⊗ₜ[F₀] (1 : ↥E)
        exact congrArg (· ⊗ₜ[F₀] (1 : ↥E)) (e₀.commutes k) }

  have hFibers : ∃ (E_init : IntermediateField F₀ κ_sep),
      FiniteDimensional F₀ ↥E_init ∧
      ∃ (N : ℕ) (F_init L_inf : Fin N → Type u)
        (_ : ∀ a, Field (F_init a)) (_ : ∀ a, Field (L_inf a))
        (_ : ∀ a, Algebra K (F_init a)) (_ : ∀ a, Algebra.Etale K (F_init a))
        (_ : ∀ a, Algebra (F_init a) (L_inf a)) (_ : ∀ a, Algebra.IsSeparable (F_init a) (L_inf a))
        (_ : ∀ a, Algebra κ_sep (L_inf a))
        (e_split_init : TensorProduct F₀ (∀ i : Fin r, L i) ↥E_init ≃ₐ[K] (∀ a : Fin N, F_init a)),
        (∀ a : Fin N, Algebra.trdeg κ_sep (L_inf a) ≤ (e : Cardinal.{u})) ∧
        (∀ (G : ∀ a : Fin N, Finset (L_inf a)),
          ∃ (S_B : Finset κ_sep),
            ∀ (E_fin : IntermediateField F₀ κ_sep) (hle : E_init ≤ E_fin),
              FiniteDimensional F₀ ↥E_fin →
              (S_B : Set κ_sep) ⊆ (E_fin : Set κ_sep) →
              ∃ (F_fin : Fin N → Type u)
                (_ : ∀ a, Field (F_fin a))
                (_ : ∀ a, Algebra K (F_fin a))
                (_ : ∀ a, Algebra.Etale K (F_fin a))
                (φ_init_fin : ∀ a : Fin N, F_init a →+* F_fin a)
                (ι_fin_ring : ∀ a : Fin N, F_fin a →+* L_inf a)
                (e_split_fin : TensorProduct F₀ (∀ i : Fin r, L i) ↥E_fin ≃ₐ[K]
                  (∀ a : Fin N, F_fin a)),
                (∀ (a : Fin N) (k : K),
                  φ_init_fin a (algebraMap K (F_init a) k) = algebraMap K (F_fin a) k) ∧
                (∀ (a : Fin N) (w : F_init a),
                  ι_fin_ring a (φ_init_fin a w) = algebraMap (F_init a) (L_inf a) w) ∧
                (∀ (a : Fin N), ∀ w ∈ G a, ∃ u : F_fin a, ι_fin_ring a u = w) ∧
                (∀ (f : ∀ i : Fin r, L i) (c : ↥E_init) (a : Fin N),
                  ι_fin_ring a (e_split_fin (f ⊗ₜ[F₀] (IntermediateField.inclusion hle c)) a) =
                    algebraMap (F_init a) (L_inf a) (e_split_init (f ⊗ₜ[F₀] c) a))) := by
    let M_rel : Fin r → Type u := fun i => ↥(separableClosure F₀ (L i))
    have hS2 : ∀ i : Fin r,
        FiniteDimensional F₀ (M_rel i) ∧
        ∃ (S : Finset (L i)), S.card ≤ e ∧
          Algebra.IsAlgebraic ↥(Algebra.adjoin F₀ (S : Set (L i))) (L i) :=
      fun i => weil_alt_cd_fg_field_sepClosure_finite_and_trdeg_finset F₀ K (L i) e
        hDimK'.1 hDimK'.2
    have : ∀ i : Fin r, FiniteDimensional F₀ (M_rel i) := fun i => (hS2 i).1
    have : ∀ i : Fin r, Algebra.IsSeparable F₀ (M_rel i) := fun i =>
      separableClosure.isSeparable F₀ (L i)
    have hSepCl_M : ∀ (i : Fin r) (x : L i),
        IsSeparable (M_rel i) x → x ∈ (algebraMap (M_rel i) (L i)).range := by
      intro i x hx
      exact ⟨⟨x, mem_separableClosure_iff.mpr
        (IsSeparable.of_algebra_isSeparable_of_isSeparable F₀ hx)⟩, rfl⟩
    obtain ⟨hVand, hCoord⟩ := weil_alt_cd_vandermonde_sep_split_and_coord_descent.{u}
    obtain ⟨E_init, hFD_Einit, N, idx, σ, hSplit⟩ := hVand F₀ K κ_sep r L M_rel
    let algM_Einit : ∀ a : Fin N, Algebra (M_rel (idx a)) ↥E_init := fun a =>
      RingHom.toAlgebra (((IntermediateField.inclusion (le_refl E_init)).comp (σ a)).toRingHom)
    let algM_κ : ∀ a : Fin N, Algebra (M_rel (idx a)) κ_sep := fun a =>
      RingHom.toAlgebra ((E_init.val.comp (σ a)).toRingHom)
    let F_init_raw : Fin N → Type u := fun a =>
      letI : Algebra (M_rel (idx a)) ↥E_init := algM_Einit a
      TensorProduct (M_rel (idx a)) (L (idx a)) ↥E_init
    let L_inf_raw : Fin N → Type u := fun a =>
      letI : Algebra (M_rel (idx a)) κ_sep := algM_κ a
      TensorProduct (M_rel (idx a)) (L (idx a)) κ_sep
    have hTower_Einit : ∀ a : Fin N,
        letI : Algebra (M_rel (idx a)) ↥E_init := algM_Einit a
        IsScalarTower F₀ (M_rel (idx a)) ↥E_init := fun a =>
      letI : Algebra (M_rel (idx a)) ↥E_init := algM_Einit a
      IsScalarTower.of_algebraMap_eq (fun x =>
        (((IntermediateField.inclusion (le_refl E_init)).comp (σ a)).commutes x).symm)
    have hTower_κ : ∀ a : Fin N,
        letI : Algebra (M_rel (idx a)) κ_sep := algM_κ a
        IsScalarTower F₀ (M_rel (idx a)) κ_sep := fun a =>
      letI : Algebra (M_rel (idx a)) κ_sep := algM_κ a
      IsScalarTower.of_algebraMap_eq (fun x => ((E_init.val.comp (σ a)).commutes x).symm)
    have hSep_M_Einit : ∀ a : Fin N,
        letI : Algebra (M_rel (idx a)) ↥E_init := algM_Einit a
        Algebra.IsSeparable (M_rel (idx a)) ↥E_init := fun a => by
      letI : Algebra (M_rel (idx a)) ↥E_init := algM_Einit a
      have : IsScalarTower F₀ (M_rel (idx a)) ↥E_init := hTower_Einit a
      have : Algebra.IsSeparable F₀ ↥E_init := IntermediateField.isSeparable_tower_bot F₀ E_init
      exact Algebra.isSeparable_tower_top_of_isSeparable F₀ (M_rel (idx a)) ↥E_init
    have hSep_M_κ : ∀ a : Fin N,
        letI : Algebra (M_rel (idx a)) κ_sep := algM_κ a
        Algebra.IsSeparable (M_rel (idx a)) κ_sep := fun a => by
      letI : Algebra (M_rel (idx a)) κ_sep := algM_κ a
      have : IsScalarTower F₀ (M_rel (idx a)) κ_sep := hTower_κ a
      exact Algebra.isSeparable_tower_top_of_isSeparable F₀ (M_rel (idx a)) κ_sep
    have hS3 := fun i : Fin r =>
      weil_alt_cd_sepClosed_in_tensor_isField_and_trdeg F₀ K (M_rel i) (L i) (hSepCl_M i)
    have hIsField_Finit : ∀ a : Fin N, IsField (F_init_raw a) := fun a => by
      letI : Algebra (M_rel (idx a)) ↥E_init := algM_Einit a
      have : Algebra.IsSeparable (M_rel (idx a)) ↥E_init := hSep_M_Einit a
      exact (hS3 (idx a)).1 ↥E_init
    have hIsField_Linf : ∀ a : Fin N, IsField (L_inf_raw a) := fun a => by
      letI : Algebra (M_rel (idx a)) κ_sep := algM_κ a
      have : Algebra.IsSeparable (M_rel (idx a)) κ_sep := hSep_M_κ a
      exact (hS3 (idx a)).1 κ_sep
    let instField_Finit : ∀ a : Fin N, Field (F_init_raw a) := fun a => (hIsField_Finit a).toField
    let instField_Linf : ∀ a : Fin N, Field (L_inf_raw a) := fun a => (hIsField_Linf a).toField
    let instAlgK_Finit : ∀ a : Fin N,
        letI : Field (F_init_raw a) := instField_Finit a
        Algebra K (F_init_raw a) := fun a =>
      letI : Algebra (M_rel (idx a)) ↥E_init := algM_Einit a
      RingHom.toAlgebra
        ((Algebra.TensorProduct.includeLeft :
            L (idx a) →ₐ[M_rel (idx a)] F_init_raw a).toRingHom.comp
          (algebraMap K (L (idx a))))
    have hEt_Finit : ∀ a : Fin N,
        letI : Field (F_init_raw a) := instField_Finit a
        letI : Algebra K (F_init_raw a) := instAlgK_Finit a
        Algebra.Etale K (F_init_raw a) := fun a => by
      letI : Algebra (M_rel (idx a)) ↥E_init := algM_Einit a
      have : IsScalarTower F₀ (M_rel (idx a)) ↥E_init := hTower_Einit a
      have : FiniteDimensional F₀ ↥E_init := hFD_Einit
      have : FiniteDimensional (M_rel (idx a)) ↥E_init :=
        Module.Finite.of_restrictScalars_finite F₀ (M_rel (idx a)) ↥E_init
      have : Algebra.IsSeparable (M_rel (idx a)) ↥E_init := hSep_M_Einit a
      exact (hS3 (idx a)).2.1 ↥E_init (hIsField_Finit a)
    let map_init_inf : ∀ a : Fin N, F_init_raw a →+* L_inf_raw a := fun a =>
      letI : Algebra (M_rel (idx a)) ↥E_init := algM_Einit a
      letI : Algebra (M_rel (idx a)) κ_sep := algM_κ a
      letI : IsScalarTower (M_rel (idx a)) ↥E_init κ_sep := IsScalarTower.of_algebraMap_eq' rfl
      (Algebra.TensorProduct.map (AlgHom.id (M_rel (idx a)) (L (idx a)))
        (IsScalarTower.toAlgHom (M_rel (idx a)) ↥E_init κ_sep)).toRingHom
    let instAlg_Finit_Linf : ∀ a : Fin N,
        letI : Field (F_init_raw a) := instField_Finit a
        letI : Field (L_inf_raw a) := instField_Linf a
        Algebra (F_init_raw a) (L_inf_raw a) := fun a =>
      letI : Field (F_init_raw a) := instField_Finit a
      letI : Field (L_inf_raw a) := instField_Linf a
      RingHom.toAlgebra (map_init_inf a)
    have hSep_Finit_Linf : ∀ a : Fin N,
        letI : Field (F_init_raw a) := instField_Finit a
        letI : Field (L_inf_raw a) := instField_Linf a
        letI : Algebra (F_init_raw a) (L_inf_raw a) := instAlg_Finit_Linf a
        Algebra.IsSeparable (F_init_raw a) (L_inf_raw a) := fun a => by
      letI : Algebra (M_rel (idx a)) ↥E_init := algM_Einit a
      letI : Algebra (M_rel (idx a)) κ_sep := algM_κ a
      have : IsScalarTower (M_rel (idx a)) ↥E_init κ_sep := IsScalarTower.of_algebraMap_eq' rfl
      have : Algebra.IsSeparable (M_rel (idx a)) ↥E_init := hSep_M_Einit a
      have : Algebra.IsSeparable (M_rel (idx a)) κ_sep := hSep_M_κ a
      exact (hS3 (idx a)).2.2.1 ↥E_init κ_sep (hIsField_Finit a) (hIsField_Linf a)
    let instAlg_κ_Linf : ∀ a : Fin N,
        letI : Field (L_inf_raw a) := instField_Linf a
        Algebra κ_sep (L_inf_raw a) := fun a =>
      letI : Algebra (M_rel (idx a)) κ_sep := algM_κ a
      RingHom.toAlgebra
        (Algebra.TensorProduct.includeRight : κ_sep →ₐ[M_rel (idx a)] L_inf_raw a).toRingHom
    have hTrdeg_Linf : ∀ a : Fin N,
        letI : Field (L_inf_raw a) := instField_Linf a
        letI : Algebra κ_sep (L_inf_raw a) := instAlg_κ_Linf a
        Algebra.trdeg κ_sep (L_inf_raw a) ≤ (e : Cardinal.{u}) := fun a => by
      letI : Algebra (M_rel (idx a)) κ_sep := algM_κ a
      have : IsScalarTower F₀ (M_rel (idx a)) κ_sep := hTower_κ a
      have : Algebra.IsSeparable (M_rel (idx a)) κ_sep := hSep_M_κ a
      exact (hS3 (idx a)).2.2.2 κ_sep e (hIsField_Linf a) (hS2 (idx a)).2
    obtain ⟨e_split_init, he_split_init⟩ := hSplit E_init (le_refl E_init)
    refine ⟨E_init, hFD_Einit, N, F_init_raw, L_inf_raw,
      instField_Finit, instField_Linf, instAlgK_Finit, hEt_Finit,
      instAlg_Finit_Linf, hSep_Finit_Linf, instAlg_κ_Linf, e_split_init,
      hTrdeg_Linf, ?_⟩
    intro G
    obtain ⟨S_B, hS_B⟩ :=
      letI : ∀ a : Fin N, Algebra (M_rel (idx a)) κ_sep := algM_κ
      hCoord N (fun a => M_rel (idx a)) (fun a => L (idx a)) κ_sep G
    refine ⟨S_B, fun E_fin hle hFD_Efin hSB_sub => ?_⟩
    obtain ⟨e_split_fin, he_split_fin⟩ := hSplit E_fin hle
    let algM_Efin : ∀ a : Fin N, Algebra (M_rel (idx a)) ↥E_fin := fun a =>
      RingHom.toAlgebra (((IntermediateField.inclusion hle).comp (σ a)).toRingHom)
    let F_fin_raw : Fin N → Type u := fun a =>
      letI : Algebra (M_rel (idx a)) ↥E_fin := algM_Efin a
      TensorProduct (M_rel (idx a)) (L (idx a)) ↥E_fin
    have hTower_Efin : ∀ a : Fin N,
        letI : Algebra (M_rel (idx a)) ↥E_fin := algM_Efin a
        IsScalarTower F₀ (M_rel (idx a)) ↥E_fin := fun a =>
      letI : Algebra (M_rel (idx a)) ↥E_fin := algM_Efin a
      IsScalarTower.of_algebraMap_eq (fun x =>
        (((IntermediateField.inclusion hle).comp (σ a)).commutes x).symm)
    have hSep_M_Efin : ∀ a : Fin N,
        letI : Algebra (M_rel (idx a)) ↥E_fin := algM_Efin a
        Algebra.IsSeparable (M_rel (idx a)) ↥E_fin := fun a => by
      letI : Algebra (M_rel (idx a)) ↥E_fin := algM_Efin a
      have : IsScalarTower F₀ (M_rel (idx a)) ↥E_fin := hTower_Efin a
      have : Algebra.IsSeparable F₀ ↥E_fin := IntermediateField.isSeparable_tower_bot F₀ E_fin
      exact Algebra.isSeparable_tower_top_of_isSeparable F₀ (M_rel (idx a)) ↥E_fin
    have hIsField_Ffin : ∀ a : Fin N, IsField (F_fin_raw a) := fun a => by
      letI : Algebra (M_rel (idx a)) ↥E_fin := algM_Efin a
      have : Algebra.IsSeparable (M_rel (idx a)) ↥E_fin := hSep_M_Efin a
      exact (hS3 (idx a)).1 ↥E_fin
    let instField_Ffin : ∀ a : Fin N, Field (F_fin_raw a) := fun a => (hIsField_Ffin a).toField
    let instAlgK_Ffin : ∀ a : Fin N,
        letI : Field (F_fin_raw a) := instField_Ffin a
        Algebra K (F_fin_raw a) := fun a =>
      letI : Algebra (M_rel (idx a)) ↥E_fin := algM_Efin a
      RingHom.toAlgebra
        ((Algebra.TensorProduct.includeLeft :
            L (idx a) →ₐ[M_rel (idx a)] F_fin_raw a).toRingHom.comp
          (algebraMap K (L (idx a))))
    have hEt_Ffin : ∀ a : Fin N,
        letI : Field (F_fin_raw a) := instField_Ffin a
        letI : Algebra K (F_fin_raw a) := instAlgK_Ffin a
        Algebra.Etale K (F_fin_raw a) := fun a => by
      letI : Algebra (M_rel (idx a)) ↥E_fin := algM_Efin a
      have : IsScalarTower F₀ (M_rel (idx a)) ↥E_fin := hTower_Efin a
      have : FiniteDimensional F₀ ↥E_fin := hFD_Efin
      have : FiniteDimensional (M_rel (idx a)) ↥E_fin :=
        Module.Finite.of_restrictScalars_finite F₀ (M_rel (idx a)) ↥E_fin
      have : Algebra.IsSeparable (M_rel (idx a)) ↥E_fin := hSep_M_Efin a
      exact (hS3 (idx a)).2.1 ↥E_fin (hIsField_Ffin a)
    let φ_init_fin : ∀ a : Fin N,
        letI : Field (F_init_raw a) := instField_Finit a
        letI : Field (F_fin_raw a) := instField_Ffin a
        F_init_raw a →+* F_fin_raw a := fun a =>
      letI : Algebra (M_rel (idx a)) ↥E_init := algM_Einit a
      letI : Algebra (M_rel (idx a)) ↥E_fin := algM_Efin a
      let incl_M : ↥E_init →ₐ[M_rel (idx a)] ↥E_fin :=
        { (IntermediateField.inclusion hle).toRingHom with commutes' := fun _ => rfl }
      (Algebra.TensorProduct.map (AlgHom.id (M_rel (idx a)) (L (idx a))) incl_M).toRingHom
    let ι_fin_ring : ∀ a : Fin N,
        letI : Field (F_fin_raw a) := instField_Ffin a
        letI : Field (L_inf_raw a) := instField_Linf a
        F_fin_raw a →+* L_inf_raw a := fun a =>
      letI : Algebra (M_rel (idx a)) ↥E_fin := algM_Efin a
      letI : Algebra (M_rel (idx a)) κ_sep := algM_κ a
      let val_M : ↥E_fin →ₐ[M_rel (idx a)] κ_sep :=
        { E_fin.val.toRingHom with commutes' := fun _ => rfl }
      (Algebra.TensorProduct.map (AlgHom.id (M_rel (idx a)) (L (idx a))) val_M).toRingHom
    refine ⟨F_fin_raw, instField_Ffin, instAlgK_Ffin, hEt_Ffin, φ_init_fin, ι_fin_ring,
      e_split_fin, ?_, ?_, ?_, ?_⟩
    · intro a k
      rfl
    · intro a w
      letI : Algebra (M_rel (idx a)) ↥E_init := algM_Einit a
      letI : Algebra (M_rel (idx a)) ↥E_fin := algM_Efin a
      letI : Algebra (M_rel (idx a)) κ_sep := algM_κ a
      change ι_fin_ring a (φ_init_fin a w) = map_init_inf a w
      induction w using TensorProduct.induction_on with
      | zero =>
        exact (congrArg (ι_fin_ring a) (φ_init_fin a).map_zero).trans
          ((ι_fin_ring a).map_zero.trans (map_init_inf a).map_zero.symm)
      | tmul y c => rfl
      | add x₁ x₂ ih₁ ih₂ =>
        exact (congrArg (ι_fin_ring a) ((φ_init_fin a).map_add x₁ x₂)).trans
          (((ι_fin_ring a).map_add _ _).trans
            ((congrArg₂ (· + ·) ih₁ ih₂).trans ((map_init_inf a).map_add x₁ x₂).symm))
    · intro a w hw
      letI : Algebra (M_rel (idx a)) ↥E_fin := algM_Efin a
      letI : Algebra (M_rel (idx a)) κ_sep := algM_κ a
      obtain ⟨m_w, y_w, c_w, hc_w, rfl⟩ := hS_B a w hw
      have hc_mem : ∀ k : Fin m_w, c_w k ∈ E_fin := fun k => hSB_sub (hc_w k)
      refine ⟨∑ k : Fin m_w, (y_w k) ⊗ₜ[M_rel (idx a)] (⟨c_w k, hc_mem k⟩ : ↥E_fin), ?_⟩
      have h_map_sum : ∀ (s : Finset (Fin m_w)),
          ι_fin_ring a (∑ k ∈ s, (y_w k) ⊗ₜ[M_rel (idx a)] (⟨c_w k, hc_mem k⟩ : ↥E_fin)) =
            ∑ k ∈ s, (y_w k) ⊗ₜ[M_rel (idx a)] (c_w k) := by
        intro s
        induction s using Finset.induction_on with
        | empty => exact (ι_fin_ring a).map_zero
        | @insert k₀ s₀ hk₀ ih =>
          rw [Finset.sum_insert hk₀, Finset.sum_insert hk₀]
          exact ((ι_fin_ring a).map_add _ _).trans (congrArg _ ih)
      exact h_map_sum Finset.univ
    · intro f c a
      change ι_fin_ring a (e_split_fin (f ⊗ₜ[F₀] (IntermediateField.inclusion hle c)) a) =
        map_init_inf a (e_split_init (f ⊗ₜ[F₀] c) a)
      rw [he_split_fin, he_split_init]
      rfl

  obtain ⟨E_init, hFD_Einit, N, F_init, L_inf,
    instField_Finit, instField_Linf, instAlgK_Finit, hEt_Finit,
    instAlg_Finit_Linf, hSep_Finit_Linf, instAlg_κ_Linf, e_split_init,
    hTrdeg_Linf, hFinStage⟩ := hFibers
  letI : ∀ a : Fin N, Field (F_init a) := instField_Finit
  letI : ∀ a : Fin N, Field (L_inf a) := instField_Linf
  letI : ∀ a : Fin N, Algebra K (F_init a) := instAlgK_Finit
  have : ∀ a : Fin N, Algebra.Etale K (F_init a) := hEt_Finit
  letI : ∀ a : Fin N, Algebra (F_init a) (L_inf a) := instAlg_Finit_Linf
  have : ∀ a : Fin N, Algebra.IsSeparable (F_init a) (L_inf a) := hSep_Finit_Linf
  letI : ∀ a : Fin N, Algebra κ_sep (L_inf a) := instAlg_κ_Linf

  have hFinSep_Finit : ∀ a : Fin N,
      FiniteDimensional K (F_init a) ∧ Algebra.IsSeparable K (F_init a) := by
    intro a
    obtain ⟨I_a, hFin_Ia, Ai_a, hField_Aia, hAlg_Aia, e_Ia, hFS_Ia⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod K (F_init a)).mp (hEt_Finit a)
    have : Finite I_a := hFin_Ia
    letI : ∀ j : I_a, Field (Ai_a j) := hField_Aia
    letI : ∀ j : I_a, Algebra K (Ai_a j) := hAlg_Aia
    have : ∀ j : I_a, Module.Finite K (Ai_a j) := fun j => (hFS_Ia j).1
    have hFD_a : FiniteDimensional K (F_init a) :=
      Module.Finite.equiv e_Ia.symm.toLinearEquiv
    have hSep_a : Algebra.IsSeparable K (F_init a) :=
      (Algebra.FormallyEtale.iff_isSeparable K (F_init a)).mp inferInstance
    exact ⟨hFD_a, hSep_a⟩

  obtain ⟨C_init, hCR_Cinit, hAlgB_Cinit, hAlgC0_Cinit, hTower_BC0_Cinit, hEtC0_Cinit,
    u_init, α_init, hu_init, hFinChart⟩ :=
    weil_alt_cd_standard_etale_bezout_chart_over_domain P B K Ω ψ ev_x h_ev hi_K
      κ_sep j_Ω hj_Ω C₀ u₀ hu₀ E_init hFD_Einit
  letI : CommRing C_init := hCR_Cinit
  letI : Algebra B C_init := hAlgB_Cinit
  letI : Algebra C₀ C_init := hAlgC0_Cinit
  have : IsScalarTower B C₀ C_init := hTower_BC0_Cinit
  have : Algebra.Etale C₀ C_init := hEtC0_Cinit

  let e_init : TensorProduct B K C_init ≃ₐ[K] (∀ a : Fin N, F_init a) :=
    (α_init.trans (congr_e₀ E_init)).trans e_split_init

  refine ⟨κ_sep, inferInstance, inferInstance, algP_κ, N, F_init, L_inf,
    instField_Finit, instField_Linf, instAlgK_Finit, hEt_Finit,
    instAlg_Finit_Linf, hSep_Finit_Linf, instAlg_κ_Linf,
    C_init, hCR_Cinit, hAlgB_Cinit, hAlgC0_Cinit, hTower_BC0_Cinit, hEtC0_Cinit,
    u_init, e_init, hInj_P, hTrdeg_Linf, hFinSep_Finit, hu_init, ?_⟩

  intro M_sub hFD_Msub
  have : ∀ a : Fin N, FiniteDimensional (F_init a) ↥(M_sub a) := hFD_Msub
  let b_M : ∀ a : Fin N,
      Module.Basis ↥(Module.Basis.ofVectorSpaceIndex (F_init a) ↥(M_sub a)) (F_init a) ↥(M_sub a) :=
    fun a => Module.Basis.ofVectorSpace (F_init a) ↥(M_sub a)
  letI fintype_idx : ∀ a : Fin N,
      Fintype ↥(Module.Basis.ofVectorSpaceIndex (F_init a) ↥(M_sub a)) := fun a =>
    Fintype.ofFinite ↥(Module.Basis.ofVectorSpaceIndex (F_init a) ↥(M_sub a))
  letI : ∀ a : Fin N, DecidableEq (L_inf a) := fun a => Classical.decEq (L_inf a)
  let G : ∀ a : Fin N, Finset (L_inf a) := fun a =>
    Finset.univ.image (fun j => ((b_M a j : ↥(M_sub a)) : L_inf a))

  obtain ⟨S_B, hS_B_stage⟩ := hFinStage G

  let E_adjoin : IntermediateField F₀ κ_sep := IntermediateField.adjoin F₀ (S_B : Set κ_sep)
  have hFD_adjoin : FiniteDimensional F₀ ↥E_adjoin :=
    IntermediateField.finiteDimensional_adjoin (fun x _ => Algebra.IsIntegral.isIntegral x)
  have : FiniteDimensional F₀ ↥E_init := hFD_Einit
  have : FiniteDimensional F₀ ↥E_adjoin := hFD_adjoin
  let E_fin : IntermediateField F₀ κ_sep := E_init ⊔ E_adjoin
  have hle : E_init ≤ E_fin := le_sup_left
  have hFD_Efin : FiniteDimensional F₀ ↥E_fin :=
    IntermediateField.finiteDimensional_sup E_init E_adjoin
  have hSB_sub : (S_B : Set κ_sep) ⊆ (E_fin : Set κ_sep) := by
    intro x hx
    exact (le_sup_right : E_adjoin ≤ E_fin) (IntermediateField.subset_adjoin F₀ (S_B : Set κ_sep) hx)

  obtain ⟨C_fin, hCR_Cfin, hAlgB_Cfin, hAlgCinit_Cfin, hTower_BCinit_Cfin, hEtCinit_Cfin,
    u_fin, α_fin, hu_fin, hComm_α⟩ := hFinChart E_fin hle hFD_Efin
  letI : CommRing C_fin := hCR_Cfin
  letI : Algebra B C_fin := hAlgB_Cfin
  letI : Algebra C_init C_fin := hAlgCinit_Cfin
  have : IsScalarTower B C_init C_fin := hTower_BCinit_Cfin
  have : Algebra.Etale C_init C_fin := hEtCinit_Cfin

  obtain ⟨F_fin, instField_Ffin, instAlgK_Ffin, hEt_Ffin, φ_init_fin, ι_fin_ring,
    e_split_fin, hφ_K, hι_comm, hG_range, hSplit_compat⟩ :=
    hS_B_stage E_fin hle hFD_Efin hSB_sub
  letI : ∀ a : Fin N, Field (F_fin a) := instField_Ffin
  letI : ∀ a : Fin N, Algebra K (F_fin a) := instAlgK_Ffin
  letI : ∀ a : Fin N, Algebra (F_init a) (F_fin a) := fun a => RingHom.toAlgebra (φ_init_fin a)

  let ι_fin : ∀ a : Fin N, F_fin a →ₐ[F_init a] L_inf a := fun a =>
    { ι_fin_ring a with commutes' := hι_comm a }

  let M' : ∀ a : Fin N, IntermediateField (F_init a) (L_inf a) := fun a =>
    (ι_fin a).fieldRange

  have hle_M' : ∀ a : Fin N, M_sub a ≤ M' a := by
    intro a v hv
    have hG_sub : ∀ w ∈ G a, w ∈ M' a := by
      intro w hw
      obtain ⟨u, hu⟩ := hG_range a w hw
      exact ⟨u, hu⟩
    have hv_repr : ((⟨v, hv⟩ : ↥(M_sub a)) : L_inf a) =
        ∑ j : ↥(Module.Basis.ofVectorSpaceIndex (F_init a) ↥(M_sub a)),
          ((b_M a).repr ⟨v, hv⟩ j) • ((b_M a j : ↥(M_sub a)) : L_inf a) := by
      have h1 := (congrArg (Subtype.val : ↥(M_sub a) → L_inf a) ((b_M a).sum_repr ⟨v, hv⟩)).symm
      rw [AddSubmonoidClass.coe_finset_sum] at h1
      exact h1
    change ((⟨v, hv⟩ : ↥(M_sub a)) : L_inf a) ∈ M' a
    rw [hv_repr]
    refine Subalgebra.sum_mem (M' a).toSubalgebra (fun j _ => ?_)
    exact Subalgebra.smul_mem (M' a).toSubalgebra
      (hG_sub _ (Finset.mem_image_of_mem _ (Finset.mem_univ j))) _

  letI algK_M' : ∀ a : Fin N, Algebra K ↥(M' a) := fun a =>
    RingHom.toAlgebra ((algebraMap (F_init a) ↥(M' a)).comp (algebraMap K (F_init a)))

  let β'_hom : ∀ a : Fin N, F_fin a →ₐ[K] ↥(M' a) := fun a =>
    { toFun := fun u => ⟨ι_fin a u, u, rfl⟩
      map_one' := Subtype.ext (map_one (ι_fin a))
      map_mul' := fun x y => Subtype.ext (map_mul (ι_fin a) x y)
      map_zero' := Subtype.ext (map_zero (ι_fin a))
      map_add' := fun x y => Subtype.ext (map_add (ι_fin a) x y)
      commutes' := fun k => by
        apply Subtype.ext
        change ι_fin_ring a (algebraMap K (F_fin a) k) =
          algebraMap (F_init a) (L_inf a) (algebraMap K (F_init a) k)
        rw [← hφ_K a k]
        exact hι_comm a (algebraMap K (F_init a) k) }

  let β' : ∀ a : Fin N, F_fin a ≃ₐ[K] ↥(M' a) := fun a =>
    AlgEquiv.ofBijective (β'_hom a) ⟨
      fun x y hxy => (RingHom.injective (ι_fin a).toRingHom) (congrArg Subtype.val hxy),
      fun y => by
        rcases y.2 with ⟨x, hx⟩
        exact ⟨x, Subtype.ext hx⟩⟩

  have hEt_M' : ∀ a : Fin N,
      letI : Algebra K ↥(M' a) :=
        RingHom.toAlgebra ((algebraMap (F_init a) ↥(M' a)).comp (algebraMap K (F_init a)))
      Algebra.Etale K ↥(M' a) := fun a => by
    have : Algebra.Etale K (F_fin a) := hEt_Ffin a
    exact Algebra.Etale.of_equiv (β' a)

  let e_fin :
      letI : ∀ a : Fin N, Algebra K ↥(M' a) := fun a =>
        RingHom.toAlgebra ((algebraMap (F_init a) ↥(M' a)).comp (algebraMap K (F_init a)))
      TensorProduct B K C_fin ≃ₐ[K] (∀ a : Fin N, ↥(M' a)) :=
    ((α_fin.trans (congr_e₀ E_fin)).trans e_split_fin).trans (AlgEquiv.piCongrRight β')

  refine ⟨C_fin, hCR_Cfin, hAlgB_Cfin, hAlgCinit_Cfin, hTower_BCinit_Cfin, hEtCinit_Cfin,
    u_fin, M', hle_M', hEt_M', e_fin, hu_fin, ?_⟩

  intro z a
  change ι_fin_ring a (e_split_fin (congr_e₀ E_fin (α_fin
      (Algebra.TensorProduct.map (AlgHom.id B K)
        (IsScalarTower.toAlgHom B C_init C_fin) z))) a) =
    algebraMap (F_init a) (L_inf a) (e_split_init (congr_e₀ E_init (α_init z)) a)
  rw [hComm_α z]
  generalize α_init z = t
  induction t using TensorProduct.induction_on with
  | zero =>
    rw [map_zero, map_zero, map_zero, Pi.zero_apply, map_zero,
      map_zero, map_zero, Pi.zero_apply, map_zero]
  | tmul w₀ c₀ =>
    have hmap_tmul :
        Algebra.TensorProduct.map (AlgHom.id F₀ A₀) (IntermediateField.inclusion hle)
          (w₀ ⊗ₜ[F₀] c₀) = w₀ ⊗ₜ[F₀] (IntermediateField.inclusion hle c₀) := rfl
    have hcongr_fin :
        congr_e₀ E_fin (w₀ ⊗ₜ[F₀] (IntermediateField.inclusion hle c₀)) =
          (e₀ w₀) ⊗ₜ[F₀] (IntermediateField.inclusion hle c₀) := rfl
    have hcongr_init :
        congr_e₀ E_init (w₀ ⊗ₜ[F₀] c₀) = (e₀ w₀) ⊗ₜ[F₀] c₀ := rfl
    rw [hmap_tmul, hcongr_fin, hcongr_init]
    exact hSplit_compat (e₀ w₀) c₀ a
  | add t₁ t₂ ih₁ ih₂ =>
    rw [map_add, map_add, map_add, Pi.add_apply, map_add,
      map_add, map_add, Pi.add_apply, map_add, ih₁, ih₂]

theorem weil_alt_cd_separable_union_etale_algebra_descent (K F₀ L_inf : Type u) [Field K] [Field F₀] [Field L_inf]
    [Algebra K F₀] [FiniteDimensional K F₀] [Algebra.IsSeparable K F₀]
    [Algebra F₀ L_inf] [Algebra.IsSeparable F₀ L_inf] :
    (∀ (M : IntermediateField F₀ L_inf), FiniteDimensional F₀ ↥M →
      letI : Algebra K ↥M := RingHom.toAlgebra ((algebraMap F₀ ↥M).comp (algebraMap K F₀))
      Algebra.Etale K ↥M) ∧
    (∀ (A_inf : Type u) [CommRing A_inf] [Algebra L_inf A_inf] [Algebra.Etale L_inf A_inf],
      ∃ (M₀ : IntermediateField F₀ L_inf) (_ : FiniteDimensional F₀ ↥M₀)
        (A₀ : Type u) (_ : CommRing A₀) (_ : Algebra ↥M₀ A₀) (_ : Algebra.Etale ↥M₀ A₀),
        Nonempty (TensorProduct ↥M₀ L_inf A₀ ≃ₐ[L_inf] A_inf)) ∧
    (∀ (M₀ : IntermediateField F₀ L_inf), FiniteDimensional F₀ ↥M₀ →
      ∀ (A₀ : Type u) [CommRing A₀] [Algebra ↥M₀ A₀],
        (∀ (M : IntermediateField F₀ L_inf) (hle : M₀ ≤ M),
          letI : Algebra ↥M₀ ↥M := (IntermediateField.inclusion hle).toRingHom.toAlgebra
          letI : IsScalarTower ↥M₀ ↥M L_inf := IsScalarTower.of_algebraMap_eq' rfl
          Function.Injective
            (Algebra.TensorProduct.map (IsScalarTower.toAlgHom ↥M₀ ↥M L_inf)
              (AlgHom.id ↥M₀ A₀))) ∧
        (∀ (C : Type u) [CommRing C] [Algebra K C] [Algebra.FiniteType K C]
            (ψ : C →+* TensorProduct ↥M₀ L_inf A₀),
          (∀ c : K, ψ (algebraMap K C c) =
            algebraMap ↥M₀ (TensorProduct ↥M₀ L_inf A₀)
              (algebraMap F₀ ↥M₀ (algebraMap K F₀ c))) →
          ∃ (M₁ : IntermediateField F₀ L_inf) (_ : FiniteDimensional F₀ ↥M₁) (hle : M₀ ≤ M₁),
            letI : Algebra ↥M₀ ↥M₁ := (IntermediateField.inclusion hle).toRingHom.toAlgebra
            letI : IsScalarTower ↥M₀ ↥M₁ L_inf := IsScalarTower.of_algebraMap_eq' rfl
            ∃ (ψ₁ : C →+* TensorProduct ↥M₀ ↥M₁ A₀),
              (∀ c : K, ψ₁ (algebraMap K C c) =
                algebraMap ↥M₀ (TensorProduct ↥M₀ ↥M₁ A₀)
                  (algebraMap F₀ ↥M₀ (algebraMap K F₀ c))) ∧
              (Algebra.TensorProduct.map (IsScalarTower.toAlgHom ↥M₀ ↥M₁ L_inf)
                (AlgHom.id ↥M₀ A₀)).toRingHom.comp ψ₁ = ψ)) ∧
    (∀ (M₀ : IntermediateField F₀ L_inf), FiniteDimensional F₀ ↥M₀ →
      ∀ (A₀ B₀ : Type u) [CommRing A₀] [CommRing B₀] [Algebra ↥M₀ A₀] [Algebra ↥M₀ B₀]
        (φ₀ : A₀ →ₐ[↥M₀] B₀),
        Function.Surjective
          (PrimeSpectrum.comap (Algebra.TensorProduct.map (AlgHom.id L_inf L_inf) φ₀).toRingHom) →
        Function.Surjective (PrimeSpectrum.comap φ₀.toRingHom)) :=
by
  refine ⟨?_, ?_, ?_, ?_⟩
  · 
    intro M hFD
    have : FiniteDimensional F₀ ↥M := hFD
    let _ : Algebra K ↥M := RingHom.toAlgebra ((algebraMap F₀ ↥M).comp (algebraMap K F₀))
    have : IsScalarTower K F₀ ↥M := IsScalarTower.of_algebraMap_eq' rfl
    have : Algebra.IsSeparable F₀ ↥M := IntermediateField.isSeparable_tower_bot F₀ M
    have : Algebra.IsSeparable K ↥M := Algebra.IsSeparable.trans K F₀ ↥M
    have : Algebra.FormallyEtale K ↥M := Algebra.FormallyEtale.of_isSeparable K ↥M
    have : Module.Finite K ↥M := Module.Finite.trans F₀ ↥M
    have : Algebra.FiniteType K ↥M := Module.Finite.finiteType (R := K) ↥M
    have : Algebra.FinitePresentation K ↥M :=
      (Algebra.FinitePresentation.of_finiteType (R := K) (A := ↥M)).mp inferInstance
    exact Algebra.Etale.mk
  · 
    intro A_inf _ _ _
    have : Algebra.IsAlgebraic F₀ L_inf := Algebra.IsSeparable.isAlgebraic F₀ L_inf
    have : Algebra.IsIntegral F₀ L_inf := Algebra.IsAlgebraic.isIntegral
    rcases (Algebra.Etale.iff_exists_algEquiv_prod L_inf A_inf).mp inferInstance with
      ⟨I, hFinI, Ai, hFieldAi, hAlgAi, e_raw, hFinSepAi⟩
    have : Finite I := hFinI
    let _ : ∀ i, Field (Ai i) := hFieldAi
    let _ : ∀ i, Algebra L_inf (Ai i) := hAlgAi
    let e_prod_orig : ((i : I) → Ai i) ≃ₐ[L_inf] A_inf := e_raw.symm
    let _ : Fintype I := Fintype.ofFinite I
    let n : ℕ := Fintype.card I
    let e_idx : I ≃ Fin n := Fintype.equivFin I
    let E : Fin n → Type u := fun b => Ai (e_idx.symm b)
    let _ : ∀ b : Fin n, Field (E b) := fun b => hFieldAi (e_idx.symm b)
    let _ : ∀ b : Fin n, Algebra L_inf (E b) := fun b => hAlgAi (e_idx.symm b)
    have hFinE : ∀ b : Fin n, FiniteDimensional L_inf (E b) :=
      fun b => (hFinSepAi (e_idx.symm b)).1
    have hSepE : ∀ b : Fin n, Algebra.IsSeparable L_inf (E b) :=
      fun b => (hFinSepAi (e_idx.symm b)).2
    let e_prod : ((b : Fin n) → E b) ≃ₐ[L_inf] A_inf :=
      (AlgEquiv.piCongrLeft' L_inf Ai e_idx).symm.trans e_prod_orig
    have hPrim := fun b : Fin n =>
