      rw [hExtNat, ← CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero q)
        (Nat.zero_add 1) rfl]
      have hγ₁_eval :
          (p'₁L_𝒞 γ₁).comp (CategoryTheory.Abelian.Ext.mk₀ mor_sc.τ₃) (Nat.add_zero q) = γ_L :=
        hγ₁_eq p'₁L_𝒞 hp'₁L_𝒞
      rw [hγ₁_eval, hγ_L]
    let η_tot : CategoryTheory.Iso (P₁.comp P₁L) P_L :=
      (CategoryTheory.Functor.isoWhiskerRight η₀₁ P₁L).symm ≪≫
        CategoryTheory.Functor.associator P₀' P'₁ P₁L ≪≫
        CategoryTheory.Functor.isoWhiskerLeft P₀' η₁ ≪≫ η₀
    let ξ₁ : (P₁.obj ℱ₀).H (q + 1) :=
      ((CategoryTheory.Abelian.Ext.mk₀ (η₀₁.hom.app ℱ₀)).postcomp (Z_S S₁)
        (Nat.add_zero (q + 1))) ξ'₁
    refine ⟨η_tot, ?_, ξ₁, fun p₁L hp₁L => ?_⟩
    · intro T_L hT_L T₁ hT₁ T₀ hT₀
      let T' := weilEtaleIdTerminal.{u} S'
      let hT' := weilEtaleIdTerminalIsTerminal.{u} S'
      have h₀ := hη₀ hT_L hT' hT₀
      have h₁_iso := hη₁ hT_L hT₁ hT'
      have h₀₁ := hη₀₁ hT₁ hT' hT₀
      have h₀₁_hom :
          CategoryTheory.CategoryStruct.comp (η₀₁.hom.app (Z_S S₀))
            (CategoryTheory.CategoryStruct.comp (η₀₁.inv.app (Z_S S₀)) _) =
          CategoryTheory.CategoryStruct.comp (η₀₁.hom.app (Z_S S₀)) _ :=
        congrArg (CategoryTheory.CategoryStruct.comp (η₀₁.hom.app (Z_S S₀))) h₀₁
      rw [← CategoryTheory.Category.assoc, η₀₁.hom_inv_id_app,
        CategoryTheory.Category.id_comp] at h₀₁_hom
      have htot_inv : η_tot.inv.app (Z_S S₀) =
          CategoryTheory.CategoryStruct.comp (η₀.inv.app (Z_S S₀))
            (CategoryTheory.CategoryStruct.comp (η₁.inv.app (P₀'.obj (Z_S S₀)))
              (P₁L.map (η₀₁.hom.app (Z_S S₀)))) := by
        dsimp [η_tot]
        simp only [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc]
      change CategoryTheory.CategoryStruct.comp (η_tot.inv.app (Z_S S₀)) _ = _
      rw [htot_inv]
      simp only [CategoryTheory.Category.assoc]
      rw [← CategoryTheory.Category.assoc (P₁L.map (η₀₁.hom.app (Z_S S₀))),
        ← CategoryTheory.Functor.map_comp, ← h₀₁_hom, CategoryTheory.Functor.map_comp]
      let π₀' : Quiver.Hom (P₀'.obj (Z_S S₀)) (Z_S S') :=
        (((weilAltCdSitePullback h₀').sheafAdjunctionContinuous AddCommGrpCat.{u}
          S₀.smallEtaleTopology S'.smallEtaleTopology).homEquiv (Z_S S₀) (Z_S S')).symm
          (((CategoryTheory.constantSheafAdj S₀.smallEtaleTopology AddCommGrpCat.{u} hT₀).homEquiv
            Aℤ _).symm
            (CategoryTheory.CategoryStruct.comp
              ((CategoryTheory.constantSheafAdj S'.smallEtaleTopology AddCommGrpCat.{u}
                hT').unit.app Aℤ)
              ((Z_S S').obj.map (hT'.from ((weilAltCdSitePullback h₀').obj T₀)).op)))
      have hnat_η₁ : CategoryTheory.CategoryStruct.comp (η₁.inv.app (P₀'.obj (Z_S S₀)))
          (P₁L.map (P'₁.map π₀')) =
          CategoryTheory.CategoryStruct.comp (P'L.map π₀') (η₁.inv.app (Z_S S')) :=
        (η₁.inv.naturality π₀').symm
      simp only [CategoryTheory.Category.assoc]
      rw [← CategoryTheory.Category.assoc (η₁.inv.app (P₀'.obj (Z_S S₀)))
        (P₁L.map (P'₁.map π₀')), hnat_η₁]
      simp only [CategoryTheory.Category.assoc]
      change CategoryTheory.CategoryStruct.comp (η₀.inv.app (Z_S S₀))
        (CategoryTheory.CategoryStruct.comp (P'L.map π₀')
          (CategoryTheory.CategoryStruct.comp (η₁.inv.app (Z_S S'))
            (CategoryTheory.CategoryStruct.comp _ _))) = _
      rw [h₁_iso]
      exact h₀
    · have hm := hPullMap h₁L (η₀₁.hom.app ℱ₀) (q + 1) p'₁L_ℱ p₁L hp'₁L_ℱ hp₁L ξ'₁
      change p₁L ξ₁ =
        ((CategoryTheory.Abelian.Ext.mk₀ (P₁L.map (η₀₁.hom.app ℱ₀))).postcomp (Z_S S_L)
          (Nat.add_zero (q + 1))) (p'₁L_ℱ ξ'₁) at hm
      have htot_hom : η_tot.hom.app ℱ₀ =
          CategoryTheory.CategoryStruct.comp (P₁L.map (η₀₁.inv.app ℱ₀))
            (CategoryTheory.CategoryStruct.comp (η₁.hom.app ℱ') (η₀.hom.app ℱ₀)) := by
        change CategoryTheory.CategoryStruct.comp (P₁L.map (η₀₁.inv.app ℱ₀))
          (CategoryTheory.CategoryStruct.comp (CategoryTheory.CategoryStruct.id _)
            (CategoryTheory.CategoryStruct.comp (η₁.hom.app ℱ') (η₀.hom.app ℱ₀))) = _
        rw [CategoryTheory.Category.id_comp]
      change ((CategoryTheory.Abelian.Ext.mk₀ (η_tot.hom.app ℱ₀)).postcomp (Z_S S_L)
        (Nat.add_zero (q + 1))) (p₁L ξ₁) = ζ
      rw [hm, htot_hom, ← hPostComp _ _ (q + 1), ← hPostComp _ _ (q + 1)]
      have hinv₁ : CategoryTheory.CategoryStruct.comp
          (P₁L.map (η₀₁.hom.app ℱ₀)) (P₁L.map (η₀₁.inv.app ℱ₀)) =
          CategoryTheory.CategoryStruct.id _ := by
        rw [← CategoryTheory.Functor.map_comp, η₀₁.hom_inv_id_app, CategoryTheory.Functor.map_id]
      rw [hPostInv _ _ (q + 1) hinv₁]
      exact (congrArg
        (((CategoryTheory.Abelian.Ext.mk₀ (η₀.hom.app ℱ₀)).postcomp (Z_S S_L)
          (Nat.add_zero (q + 1)))) hξ'₁_L).trans
        (hPostInv (η₀.inv.app ℱ₀) (η₀.hom.app ℱ₀) (q + 1) (η₀.inv_hom_id_app ℱ₀) ζ)

theorem weil_alt_cd_purely_insep_torsion_invariance (K K' : Type u) [Field K] [Field K'] [Algebra K K'] [IsPurelyInseparable K K']
    (m s : ℕ)
    (hSub : Subsingleton (weilEtaleTorsionH (AlgebraicGeometry.Spec (CommRingCat.of K')) m s)) :
    Subsingleton (weilEtaleTorsionH (AlgebraicGeometry.Spec (CommRingCat.of K)) m s) :=
by
  
  have hIncludeRightInj : ∀ (F₁ F₂ A : Type u) [Field F₁] [Field F₂] [Algebra F₁ F₂]
      [CommRing A] [Algebra F₁ A],
      Function.Injective (Algebra.TensorProduct.includeRight : A →ₐ[F₁] TensorProduct F₁ F₂ A) := by
    intro F₁ F₂ A _ _ _ _ _
    have hf_ker : (Algebra.linearMap F₁ F₂).ker = ⊥ :=
      LinearMap.ker_eq_bot.mpr (algebraMap F₁ F₂).injective
    obtain ⟨r, hr⟩ := LinearMap.exists_leftInverse_of_injective (Algebra.linearMap F₁ F₂) hf_ker
    have hr1 : r 1 = 1 := by
      simpa [Algebra.linearMap_apply] using LinearMap.congr_fun hr (1 : F₁)
    let ρ : TensorProduct F₁ F₂ A →ₗ[F₁] A :=
      (TensorProduct.lid F₁ A).toLinearMap.comp (LinearMap.rTensor A r)
    have hρ : ∀ a : A, ρ ((1 : F₂) ⊗ₜ[F₁] a) = a := fun a => by simp [ρ, hr1]
    intro a₁ a₂ h
    have h' : ρ ((1 : F₂) ⊗ₜ[F₁] a₁) = ρ ((1 : F₂) ⊗ₜ[F₁] a₂) := congrArg ρ h
    rwa [hρ, hρ] at h'

  
  have hSepBaseField : ∀ (F₁ F₂ E : Type u) [Field F₁] [Field F₂] [Algebra F₁ F₂]
      [IsPurelyInseparable F₁ F₂] [Field E] [Algebra F₁ E] [Module.Finite F₁ E]
      [Algebra.IsSeparable F₁ E],
      IsField (TensorProduct F₁ F₂ E) ∧
      @IsPurelyInseparable E (TensorProduct F₁ F₂ E) _ _
        (Algebra.TensorProduct.includeRight : E →ₐ[F₁] TensorProduct F₁ F₂ E).toRingHom.toAlgebra := by
    intro F₁ F₂ E _ _ _ _ _ _ _ _
    let E' := TensorProduct F₁ F₂ E
    have hInj : Function.Injective (Algebra.TensorProduct.includeRight : E →ₐ[F₁] E') :=
      hIncludeRightInj F₁ F₂ E
    have : Nontrivial E' :=
      ⟨0, 1, fun h01 => zero_ne_one (α := E) (hInj (by simp at h01))⟩
    let e_unit : E ≃ₐ[F₁] (PUnit.{u + 1} → E) :=
      { toFun := fun e _ => e
        invFun := fun f => f PUnit.unit
        left_inv := fun _ => rfl
        right_inv := fun f => funext fun ⟨⟩ => rfl
        map_mul' := fun _ _ => rfl
        map_add' := fun _ _ => rfl
        commutes' := fun _ => rfl }
    have : Algebra.Etale F₁ E :=
      (Algebra.Etale.iff_exists_algEquiv_prod F₁ E).mpr
        ⟨PUnit.{u + 1}, inferInstance, fun _ => E, fun _ => inferInstance,
         fun _ => inferInstance, e_unit, fun _ => ⟨inferInstance, inferInstance⟩⟩
    have : Algebra.Etale F₂ E' := Algebra.Etale.baseChange F₁ E F₂
    have : IsReduced E' := Algebra.FormallyUnramified.isReduced_of_field F₂ E'
    let q := ringExpChar F₁
    have hq_pos : 0 < q := expChar_pos F₁ q
    have hPow : ∀ z : E', ∃ (n : ℕ) (e : E), (1 : F₂) ⊗ₜ[F₁] e = z ^ q ^ n := by
      intro z
      obtain ⟨n, e, he⟩ :=
        IsPurelyInseparable.exists_pow_pow_mem_range_tensorProduct_of_expChar (k := F₁) (K := F₂)
          (R := E) q ((Algebra.TensorProduct.comm F₁ F₂ E) z)
      refine ⟨n, e, ?_⟩
      have h1 := congrArg (Algebra.TensorProduct.comm F₁ E F₂) he
      rw [← map_pow] at h1
      have h2 : (Algebra.TensorProduct.comm F₁ E F₂) ((Algebra.TensorProduct.comm F₁ F₂ E) (z ^ q ^ n)) =
          z ^ q ^ n :=
        AlgEquiv.symm_apply_apply (Algebra.TensorProduct.comm F₁ F₂ E) (z ^ q ^ n)
      have h3 : (Algebra.TensorProduct.comm F₁ E F₂) (algebraMap E (TensorProduct F₁ E F₂) e) =
          (1 : F₂) ⊗ₜ[F₁] e := by
        change (Algebra.TensorProduct.comm F₁ E F₂) (e ⊗ₜ[F₁] (1 : F₂)) = (1 : F₂) ⊗ₜ[F₁] e
        simp
      rw [h3, h2] at h1
      exact h1
    have hIsField : IsField E' := by
      refine ⟨exists_pair_ne E', mul_comm, fun {z} hz => ?_⟩
      obtain ⟨n, e, he⟩ := hPow z
      have hqn_ne : z ^ q ^ n ≠ 0 := fun h0 => hz (IsReduced.eq_zero z ⟨q ^ n, h0⟩)
      have he_ne : e ≠ 0 := by
        rintro rfl
        rw [TensorProduct.tmul_zero] at he
        exact hqn_ne he.symm
      have hqn_pos : 1 ≤ q ^ n := Nat.one_le_pow n q hq_pos
      refine ⟨z ^ (q ^ n - 1) * ((1 : F₂) ⊗ₜ[F₁] e⁻¹), ?_⟩
      have hmul : (z ^ q ^ n) * ((1 : F₂) ⊗ₜ[F₁] e⁻¹) = 1 := by
        rw [← he]
        change (Algebra.TensorProduct.includeRight : E →ₐ[F₁] E') e *
            (Algebra.TensorProduct.includeRight : E →ₐ[F₁] E') e⁻¹ = 1
        rw [← map_mul, mul_inv_cancel₀ he_ne, map_one]
      have hpow_split : z * z ^ (q ^ n - 1) = z ^ q ^ n := by
        rw [← pow_succ', Nat.sub_add_cancel hqn_pos]
      rw [← mul_assoc, hpow_split, hmul]
    refine ⟨hIsField, ?_⟩
    letI : Algebra E E' := (Algebra.TensorProduct.includeRight : E →ₐ[F₁] E').toRingHom.toAlgebra
    have : IsDomain E' := hIsField.isDomain
    have : ExpChar E q := expChar_of_injective_ringHom (algebraMap F₁ E).injective q
    rw [isPurelyInseparable_iff_pow_mem E q]
    intro z
    obtain ⟨n, e, he⟩ := hPow z
    exact ⟨n, e, he⟩

  
  have hHomBij : ∀ (A₁ A₂ : Type u) [CommRing A₁] [Algebra K A₁] [Algebra.Etale K A₁]
      [CommRing A₂] [Algebra K A₂] [Algebra.Etale K A₂],
      Function.Bijective (fun f : A₁ →ₐ[K] A₂ =>
        Algebra.TensorProduct.map (AlgHom.id K' K') f) := by
    intro A₁ A₂ _ _ _ _ _ _
    constructor
    · intro f₁ f₂ hfg
      have hInj₂ := hIncludeRightInj K K' A₂
      ext a
      apply hInj₂
      have ha := AlgHom.congr_fun hfg ((1 : K') ⊗ₜ[K] a)
      simpa using ha
    · intro g'
      obtain ⟨I, hFinI, F, hFieldF, hAlgF, e₁, hPropF⟩ :=
        (Algebra.Etale.iff_exists_algEquiv_prod K A₁).mp inferInstance
      obtain ⟨J, hFinJ, E, hFieldE, hAlgE, e₂, hPropE⟩ :=
        (Algebra.Etale.iff_exists_algEquiv_prod K A₂).mp inferInstance
      letI : ∀ i : I, Field (F i) := hFieldF
      letI : ∀ i : I, Algebra K (F i) := hAlgF
      have : ∀ i : I, Module.Finite K (F i) := fun i => (hPropF i).1
      have : ∀ i : I, Algebra.IsSeparable K (F i) := fun i => (hPropF i).2
      letI : ∀ j : J, Field (E j) := hFieldE
      letI : ∀ j : J, Algebra K (E j) := hAlgE
      have : ∀ j : J, Module.Finite K (E j) := fun j => (hPropE j).1
      have : ∀ j : J, Algebra.IsSeparable K (E j) := fun j => (hPropE j).2
      letI : Fintype I := @Fintype.ofFinite I hFinI
      letI : Fintype J := @Fintype.ofFinite J hFinJ
      letI : DecidableEq I := Classical.decEq I
      letI : DecidableEq J := Classical.decEq J
      let α₁ : TensorProduct K K' A₁ ≃ₐ[K'] (∀ i : I, TensorProduct K K' (F i)) :=
        (Algebra.TensorProduct.congr (AlgEquiv.refl : K' ≃ₐ[K'] K') e₁).trans
          (Algebra.TensorProduct.piRight K K' K' F)
      let α₂ : TensorProduct K K' A₂ ≃ₐ[K'] (∀ j : J, TensorProduct K K' (E j)) :=
        (Algebra.TensorProduct.congr (AlgEquiv.refl : K' ≃ₐ[K'] K') e₂).trans
          (Algebra.TensorProduct.piRight K K' K' E)
      let Ψ : (∀ i : I, TensorProduct K K' (F i)) →ₐ[K'] (∀ j : J, TensorProduct K K' (E j)) :=
        α₂.toAlgHom.comp (g'.comp α₁.symm.toAlgHom)
      have hCompJ : ∀ j : J, ∃ (i₀ : I) (σ_j : F i₀ →ₐ[K] E j),
          ∀ x : (∀ i : I, TensorProduct K K' (F i)),
            Ψ x j = Algebra.TensorProduct.map (AlgHom.id K' K') σ_j (x i₀) := by
        intro j
        let E'_j := TensorProduct K K' (E j)
        obtain ⟨hFieldEj, hInsepEj⟩ := hSepBaseField K K' (E j)
        have : IsDomain E'_j := hFieldEj.isDomain
        let φ_j : (∀ i : I, TensorProduct K K' (F i)) →ₐ[K'] E'_j :=
          (Pi.evalAlgHom K' (fun k => TensorProduct K K' (E k)) j).comp Ψ
        let ε : I → (∀ i : I, TensorProduct K K' (F i)) := fun i => Pi.single i 1
        have hε_idem : ∀ i : I, φ_j (ε i) = 0 ∨ φ_j (ε i) = 1 := by
          intro i
          apply IsIdempotentElem.iff_eq_zero_or_one.mp
          change φ_j (ε i) * φ_j (ε i) = φ_j (ε i)
          rw [← map_mul]
          congr 1
          ext k
          by_cases hik : k = i
          · subst hik; simp [ε]
          · simp [ε, hik]
        have hε_sum : ∑ i : I, ε i = 1 := by ext k; simp [ε]
        have hφ_sum : ∑ i : I, φ_j (ε i) = 1 := by rw [← map_sum, hε_sum, map_one]
        have hex_i₀ : ∃ i₀ : I, φ_j (ε i₀) ≠ 0 := by
          by_contra! hall
          have h0 : ∑ i : I, φ_j (ε i) = 0 := Finset.sum_eq_zero (fun i _ => hall i)
          rw [hφ_sum] at h0
          exact one_ne_zero h0
        obtain ⟨i₀, hi₀_ne⟩ := hex_i₀
        have hi₀_one : φ_j (ε i₀) = 1 := (hε_idem i₀).resolve_left hi₀_ne
        have hi_zero : ∀ i : I, i ≠ i₀ → φ_j (ε i) = 0 := by
          intro i hi
          have hmul0 : ε i * ε i₀ = 0 := by
            ext k
            by_cases hki : k = i
            · subst hki; simp [ε, hi]
            · simp [ε, hki]
          have h1 : φ_j (ε i) * φ_j (ε i₀) = 0 := by rw [← map_mul, hmul0, map_zero]
          rwa [hi₀_one, mul_one] at h1
        let ψ_j : TensorProduct K K' (F i₀) →ₐ[K'] E'_j :=
          { toFun := fun z => φ_j (Pi.single i₀ z)
            map_one' := hi₀_one
            map_mul' := fun z₁ z₂ => by
              have : Pi.single (M := fun k => TensorProduct K K' (F k)) i₀ (z₁ * z₂) =
                  Pi.single i₀ z₁ * Pi.single i₀ z₂ := by
                ext k
                by_cases hk : k = i₀
                · subst hk; simp
                · simp [hk]
              rw [this, map_mul]
            map_zero' := by simp
            map_add' := fun z₁ z₂ => by rw [Pi.single_add, map_add]
            commutes' := fun c => by
              have : Pi.single (M := fun k => TensorProduct K K' (F k)) i₀
                  (algebraMap K' (TensorProduct K K' (F i₀)) c) =
                  ε i₀ * algebraMap K' (∀ k : I, TensorProduct K K' (F k)) c := by
                ext k
                by_cases hk : k = i₀
                · subst hk; simp [ε]
                · simp [ε, hk]
              rw [this, map_mul, hi₀_one, one_mul, AlgHom.commutes] }
        have hφ_eq_ψ : ∀ x : (∀ i : I, TensorProduct K K' (F i)), φ_j x = ψ_j (x i₀) := by
          intro x
          have hx_sum : x = ∑ i : I, Pi.single i (x i) := by ext k; simp
          conv_lhs => rw [hx_sum, map_sum]
          rw [Finset.sum_eq_single i₀]
          · rfl
          · intro i _ hi
            have hsingle : Pi.single i (x i) = ε i * Pi.single i (x i) := by
              ext k
              by_cases hk : k = i
              · subst hk; simp [ε]
              · simp [ε, hk]
            rw [hsingle, map_mul, hi_zero i hi, zero_mul]
          · intro hmem
            exact absurd (Finset.mem_univ i₀) hmem
        let ψ_tilde : F i₀ →ₐ[K] E'_j :=
          (ψ_j.restrictScalars K).comp Algebra.TensorProduct.includeRight
        letI : Algebra (E j) E'_j :=
          (Algebra.TensorProduct.includeRight : E j →ₐ[K] E'_j).toRingHom.toAlgebra
        have : IsScalarTower K (E j) E'_j := IsScalarTower.of_algebraMap_eq fun c => by
          change (algebraMap K K' c) ⊗ₜ[K] (1 : E j) = (1 : K') ⊗ₜ[K] (algebraMap K (E j) c)
          rw [Algebra.algebraMap_eq_smul_one, Algebra.algebraMap_eq_smul_one]
          exact TensorProduct.smul_tmul c (1 : K') (1 : E j)
        have hRange : ∀ y : F i₀,
            ∃ e : E j, (Algebra.TensorProduct.includeRight : E j →ₐ[K] E'_j) e = ψ_tilde y := by
          intro y
          have hy_sep : IsSeparable K y := Algebra.IsSeparable.isSeparable K y
          have haeval : Polynomial.aeval (ψ_tilde y) (minpoly K y) = 0 := by
            rw [Polynomial.aeval_algHom_apply, minpoly.aeval, map_zero]
          have hdvd : minpoly K (ψ_tilde y) ∣ minpoly K y := minpoly.dvd K (ψ_tilde y) haeval
          have hsepK : IsSeparable K (ψ_tilde y) := Polynomial.Separable.of_dvd hy_sep hdvd
          have hsepEj : IsSeparable (E j) (ψ_tilde y) := IsSeparable.tower_top (E j) hsepK
          exact ((isPurelyInseparable_iff.mp hInsepEj) (ψ_tilde y)).2 hsepEj
        have hInjEj : Function.Injective (Algebra.TensorProduct.includeRight : E j →ₐ[K] E'_j) :=
          hIncludeRightInj K K' (E j)
        let s_fun : F i₀ → E j := fun y => Classical.choose (hRange y)
        have hs_fun : ∀ y : F i₀,
            (Algebra.TensorProduct.includeRight : E j →ₐ[K] E'_j) (s_fun y) = ψ_tilde y :=
          fun y => Classical.choose_spec (hRange y)
        let σ_j : F i₀ →ₐ[K] E j :=
          { toFun := s_fun
            map_one' := hInjEj (by rw [hs_fun, map_one, map_one])
            map_mul' := fun x y => hInjEj (by rw [hs_fun, map_mul, map_mul, hs_fun, hs_fun])
            map_zero' := hInjEj (by rw [hs_fun, map_zero, map_zero])
            map_add' := fun x y => hInjEj (by rw [hs_fun, map_add, map_add, hs_fun, hs_fun])
            commutes' := fun c => hInjEj (by rw [hs_fun, AlgHom.commutes, AlgHom.commutes]) }
        have hψ_eq_map : ψ_j = Algebra.TensorProduct.map (AlgHom.id K' K') σ_j := by
          apply Algebra.TensorProduct.ext
          · ext
          · ext y
            change ψ_tilde y = (1 : K') ⊗ₜ[K] (σ_j y)
            exact (hs_fun y).symm
        refine ⟨i₀, σ_j, fun x => ?_⟩
        change φ_j x = _
        rw [hφ_eq_ψ x, hψ_eq_map]
      choose i₀ σ hσ using hCompJ
      let g₀ : (∀ i : I, F i) →ₐ[K] (∀ j : J, E j) :=
        AlgHom.pi (fun j => (σ j).comp (Pi.evalAlgHom K F (i₀ j)))
      let f : A₁ →ₐ[K] A₂ := e₂.symm.toAlgHom.comp (g₀.comp e₁.toAlgHom)
      refine ⟨f, ?_⟩
      apply Algebra.TensorProduct.ext
      · ext
      · ext a
        apply α₂.injective
        ext j
        change α₂ ((Algebra.TensorProduct.map (AlgHom.id K' K') f) ((1 : K') ⊗ₜ[K] a)) j =
          α₂ (g' ((1 : K') ⊗ₜ[K] a)) j
        have hRHS : α₂ (g' ((1 : K') ⊗ₜ[K] a)) j =
            Algebra.TensorProduct.map (AlgHom.id K' K') (σ j) (α₁ ((1 : K') ⊗ₜ[K] a) (i₀ j)) := by
          have h1 : α₂ (g' ((1 : K') ⊗ₜ[K] a)) = Ψ (α₁ ((1 : K') ⊗ₜ[K] a)) := by simp [Ψ]
          rw [h1, hσ j]
        have hα₁ : α₁ ((1 : K') ⊗ₜ[K] a) (i₀ j) = (1 : K') ⊗ₜ[K] (e₁ a (i₀ j)) := by simp [α₁]
        have hLHS : α₂ ((Algebra.TensorProduct.map (AlgHom.id K' K') f) ((1 : K') ⊗ₜ[K] a)) j =
            (1 : K') ⊗ₜ[K] (σ j (e₁ a (i₀ j))) := by simp [α₂, f, g₀]
        rw [hLHS, hRHS, hα₁]
        simp

  
  have hAlgDesc : ∀ (L₁ L₂ B : Type u) [Field L₁] [Field L₂] [Algebra L₁ L₂]
      [IsPurelyInseparable L₁ L₂] [CommRing B] [Algebra L₂ B] [Algebra.Etale L₂ B],
      ∃ (n : ℕ) (g : Fin n → Polynomial L₁),
        (∀ i : Fin n, (g i).Monic ∧ Irreducible (g i) ∧ (g i).Separable) ∧
        Nonempty (TensorProduct L₁ L₂ (∀ i : Fin n, AdjoinRoot (g i)) ≃ₐ[L₂] B) := by
    intro L₁ L₂ B _ _ _ _ _ _ _
    obtain ⟨I, hFinI, L, hFieldL, hAlgL, e_B, hPropL⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod L₂ B).mp inferInstance
    letI : ∀ j : I, Field (L j) := hFieldL
    letI : ∀ j : I, Algebra L₂ (L j) := hAlgL
    have : ∀ j : I, Module.Finite L₂ (L j) := fun j => (hPropL j).1
    have : ∀ j : I, Algebra.IsSeparable L₂ (L j) := fun j => (hPropL j).2
    obtain ⟨n, ⟨e_fin⟩⟩ := @Finite.exists_equiv_fin I hFinI
    let e_prod : B ≃ₐ[L₂] (∀ i : Fin n, L (e_fin.symm i)) :=
      e_B.trans (AlgEquiv.piCongrLeft' L₂ L e_fin)
    have hFactor : ∀ j : I, ∃ p : Polynomial L₁,
        (p.Monic ∧ Irreducible p ∧ p.Separable) ∧
        Nonempty (TensorProduct L₁ L₂ (AdjoinRoot p) ≃ₐ[L₂] L j) := by
      intro j
      letI : Algebra L₁ (L j) := RingHom.toAlgebra ((algebraMap L₂ (L j)).comp (algebraMap L₁ L₂))
      have : IsScalarTower L₁ L₂ (L j) := IsScalarTower.of_algebraMap_eq' rfl
      have : Algebra.IsAlgebraic L₁ L₂ := IsPurelyInseparable.isAlgebraic L₁ L₂
      have : Algebra.IsAlgebraic L₂ (L j) := Algebra.IsAlgebraic.of_finite L₂ (L j)
      have : Algebra.IsAlgebraic L₁ (L j) := Algebra.IsAlgebraic.trans L₁ L₂ (L j)
      let E₀ : IntermediateField L₁ (L j) := separableClosure L₁ (L j)
      have : Algebra.IsSeparable L₁ ↥E₀ := separableClosure.isSeparable L₁ (L j)
      have : IsPurelyInseparable ↥E₀ (L j) := separableClosure.isPurelyInseparable L₁ (L j)
      let b₀ := Module.Basis.ofVectorSpace L₁ ↥E₀
      let w : Module.Basis.ofVectorSpaceIndex L₁ ↥E₀ → L j := fun k => (b₀ k : L j)
      have hw_linK : LinearIndependent L₁ w :=
        b₀.linearIndependent.map' E₀.val.toLinearMap
          (LinearMap.ker_eq_bot.mpr E₀.val.injective)
      have hw_sep : ∀ k, IsSeparable L₁ (w k) :=
        fun k => IntermediateField.isSeparable_of_mem_isSeparable L₁ (L j) (b₀ k).2
      have hw_linK' : LinearIndependent L₂ w :=
        LinearIndependent.map_of_isPurelyInseparable_of_isSeparable L₂ hw_sep hw_linK
      have : Finite (Module.Basis.ofVectorSpaceIndex L₁ ↥E₀) := hw_linK'.finite
      have : Module.Finite L₁ ↥E₀ := Module.Finite.of_basis b₀
      obtain ⟨hIsFieldT, _⟩ := hSepBaseField L₁ L₂ ↥E₀
      let μ : TensorProduct L₁ L₂ ↥E₀ →ₐ[L₂] L j :=
        Algebra.TensorProduct.lift (Algebra.ofId L₂ (L j))
          ⟨E₀.val.toRingHom, fun _ => rfl⟩ (fun _ _ => mul_comm _ _)
      have hμ_inj : Function.Injective μ := by
        intro z₁ z₂ h
        by_contra hne
        have hsub : z₁ - z₂ ≠ 0 := sub_ne_zero.mpr hne
        obtain ⟨u, hu⟩ := hIsFieldT.mul_inv_cancel hsub
        have h1 : μ.toRingHom ((z₁ - z₂) * u) = 1 := by rw [hu, RingHom.map_one]
        rw [RingHom.map_mul, RingHom.map_sub, show μ.toRingHom z₁ = μ.toRingHom z₂ from h,
          sub_self, zero_mul] at h1
        exact zero_ne_one h1
      let M_if : IntermediateField L₂ (L j) :=
        μ.range.toIntermediateField (by
          rintro _ ⟨z, rfl⟩
          by_cases hz : z = 0
          · subst hz; simp
          · obtain ⟨u, hu⟩ := hIsFieldT.mul_inv_cancel hz
            refine ⟨u, ?_⟩
            have hmul1 : μ z * μ u = 1 := by
              change μ.toRingHom z * μ.toRingHom u = 1
              rw [← RingHom.map_mul, hu, RingHom.map_one]
            exact (inv_eq_of_mul_eq_one_right hmul1).symm)
      let q₀ := ringExpChar L₁
      have : ExpChar ↥E₀ q₀ := expChar_of_injective_ringHom (algebraMap L₁ ↥E₀).injective q₀
      have : ExpChar L₂ q₀ := expChar_of_injective_ringHom (algebraMap L₁ L₂).injective q₀
      have : ExpChar ↥M_if q₀ := expChar_of_injective_ringHom (algebraMap L₂ ↥M_if).injective q₀
      have : IsPurelyInseparable ↥M_if (L j) := by
        rw [isPurelyInseparable_iff_pow_mem ↥M_if q₀]
        intro z
        obtain ⟨m₀, e₀, he₀⟩ := IsPurelyInseparable.pow_mem ↥E₀ q₀ z
        have he₀_mem : (e₀ : L j) ∈ M_if := by
          change (e₀ : L j) ∈ μ.range
          exact ⟨(1 : L₂) ⊗ₜ[L₁] e₀, by simp [μ]⟩
        exact ⟨m₀, ⟨(e₀ : L j), he₀_mem⟩, he₀⟩
      have : Algebra.IsSeparable ↥M_if (L j) :=
        Algebra.isSeparable_tower_top_of_isSeparable L₂ ↥M_if (L j)
      have hBijM : Function.Bijective (algebraMap ↥M_if (L j)) :=
        IsPurelyInseparable.bijective_algebraMap_of_isSeparable ↥M_if (L j)
      have hμ_surj : Function.Surjective μ := by
        intro y
        obtain ⟨⟨_, hz_mem⟩, rfl⟩ := hBijM.2 y
        change _ ∈ μ.range at hz_mem
        exact hz_mem
      let e_tens : TensorProduct L₁ L₂ ↥E₀ ≃ₐ[L₂] L j :=
        AlgEquiv.ofBijective μ ⟨hμ_inj, hμ_surj⟩
      obtain ⟨α, hα_top⟩ := Field.exists_primitive_element L₁ ↥E₀
      have hα_int : IsIntegral L₁ α := Algebra.IsIntegral.isIntegral α
      let p := minpoly L₁ α
      have hp_mon : p.Monic := minpoly.monic hα_int
      have hp_irr : Irreducible p := minpoly.irreducible hα_int
      have hp_sep : p.Separable := Algebra.IsSeparable.isSeparable L₁ α
      let e_root : AdjoinRoot p ≃ₐ[L₁] ↥E₀ :=
        (IntermediateField.adjoinRootEquivAdjoin L₁ hα_int).trans
          ((IntermediateField.equivOfEq hα_top).trans IntermediateField.topEquiv)
      let e_tot : TensorProduct L₁ L₂ (AdjoinRoot p) ≃ₐ[L₂] L j :=
        (Algebra.TensorProduct.congr (AlgEquiv.refl : L₂ ≃ₐ[L₂] L₂) e_root).trans e_tens
      exact ⟨p, ⟨hp_mon, hp_irr, hp_sep⟩, ⟨e_tot⟩⟩
    choose g_I hg_prop hg_equiv using hFactor
    let g : Fin n → Polynomial L₁ := fun i => g_I (e_fin.symm i)
    refine ⟨n, g, fun i => hg_prop (e_fin.symm i), ?_⟩
    let e_comp : ∀ i : Fin n, TensorProduct L₁ L₂ (AdjoinRoot (g i)) ≃ₐ[L₂] L (e_fin.symm i) :=
      fun i => Classical.choice (hg_equiv (e_fin.symm i))
    let e_all : TensorProduct L₁ L₂ (∀ i : Fin n, AdjoinRoot (g i)) ≃ₐ[L₂] B :=
      ((Algebra.TensorProduct.piRight L₁ L₂ L₂ (fun i : Fin n => AdjoinRoot (g i))).trans
        (AlgEquiv.piCongrRight e_comp)).trans e_prod.symm
    exact ⟨e_all⟩

  
  have hExtInj : ∀ {𝒞 𝒟 : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} 𝒞]
      [CategoryTheory.Category.{u + 1, u + 1} 𝒟]
      [CategoryTheory.Abelian 𝒞] [CategoryTheory.Abelian 𝒟]
      [CategoryTheory.EnoughInjectives 𝒞]
      [CategoryTheory.HasExt.{u} 𝒞] [CategoryTheory.HasExt.{u} 𝒟]
      (F : CategoryTheory.Functor 𝒞 𝒟) [F.Additive]
      [CategoryTheory.Limits.PreservesFiniteLimits F]
      [CategoryTheory.Limits.PreservesFiniteColimits F]
      [F.IsEquivalence]
      (X Y : 𝒞) (q : ℕ),
      Function.Injective (F.mapExtAddHom X Y q) := by
    intro 𝒞 𝒟 _ _ _ _ _ _ _ F _ _ _ _ X Y q
    let e := F.asEquivalence
    let G : CategoryTheory.Functor 𝒟 𝒞 := e.inverse
    let η : CategoryTheory.Functor.id 𝒞 ≅ F.comp G := e.unitIso
    have : CategoryTheory.Limits.PreservesFiniteLimits G := inferInstance
    have : CategoryTheory.Limits.PreservesFiniteColimits G := inferInstance
    have : e.functor.Additive := ‹F.Additive›
    have : G.Additive := inferInstanceAs e.inverse.Additive
    have hRound : ∀ (n : ℕ) (A B : 𝒞) (x : CategoryTheory.Abelian.Ext.{u} A B n),
        CategoryTheory.Abelian.Ext.mapExactFunctor G
          (CategoryTheory.Abelian.Ext.mapExactFunctor F x) =
        ((CategoryTheory.Abelian.Ext.mk₀ (η.inv.app A)).comp x (Nat.zero_add n)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app B)) (Nat.add_zero n) := by
      intro n
      induction n with
      | zero =>
        intro A B x
        obtain ⟨f, rfl⟩ := (CategoryTheory.Abelian.Ext.mk₀_bijective A B).2 x
        rw [CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
          CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
        congr 1
        have hnat : f ≫ η.hom.app B = η.hom.app A ≫ G.map (F.map f) := η.hom.naturality f
        rw [CategoryTheory.Category.assoc, hnat, ← CategoryTheory.Category.assoc,
          η.inv_hom_id_app A, CategoryTheory.Category.id_comp]
      | succ n ih =>
        intro A B x
        let I : 𝒞 := CategoryTheory.Injective.under B
        let ι : B ⟶ I := CategoryTheory.Injective.ι B
        let Q : 𝒞 := CategoryTheory.Limits.cokernel ι
        let π : I ⟶ Q := CategoryTheory.Limits.cokernel.π ι
        let S : CategoryTheory.ShortComplex 𝒞 :=
          CategoryTheory.ShortComplex.mk ι π (CategoryTheory.Limits.cokernel.condition ι)
        have hExact : S.Exact :=
          CategoryTheory.ShortComplex.exact_of_g_is_cokernel S
            (CategoryTheory.Limits.cokernelIsCokernel ι)
        have hS : S.ShortExact :=
          CategoryTheory.ShortComplex.ShortExact.mk' hExact inferInstance inferInstance
        have hx_ι : x.comp (CategoryTheory.Abelian.Ext.mk₀ S.f) (Nat.add_zero (n + 1)) = 0 :=
          CategoryTheory.Abelian.Ext.eq_zero_of_injective _
        obtain ⟨z, rfl⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ A hS x hx_ι (rfl : n + 1 = n + 1)
        rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
          CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
          CategoryTheory.Abelian.Ext.mapExactFunctor_extClass,
          CategoryTheory.Abelian.Ext.mapExactFunctor_extClass,
          ih A Q z]
        let hS_GF : ((S.map F).map G).ShortExact := (hS.map_of_exact F).map_of_exact G
        let φ_S : S ⟶ (S.map F).map G :=
          { τ₁ := η.hom.app B
            τ₂ := η.hom.app I
            τ₃ := η.hom.app Q
            comm₁₂ := (η.hom.naturality ι).symm
            comm₂₃ := (η.hom.naturality π).symm }
        have hNatExt :
            hS.extClass.comp (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app B)) (Nat.add_zero 1) =
            (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app Q)).comp hS_GF.extClass (Nat.zero_add 1) :=
          CategoryTheory.ShortComplex.ShortExact.extClass_naturality hS hS_GF φ_S
        rw [CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero n) (Nat.zero_add 1) (by omega),
          ← hNatExt,
          ← CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (rfl : n + 1 = n + 1)
            (Nat.add_zero 1) (by omega),
          ← CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ (η.inv.app A))
            z hS.extClass (Nat.zero_add n) (rfl : n + 1 = n + 1) (by omega)]
    rw [injective_iff_map_eq_zero]
    intro x hx
    have hGF0 : CategoryTheory.Abelian.Ext.mapExactFunctor G
        (CategoryTheory.Abelian.Ext.mapExactFunctor F x) = 0 := by
      change (G.mapExtAddHom (F.obj X) (F.obj Y) q) ((F.mapExtAddHom X Y q) x) = 0
      rw [hx, map_zero]
    rw [hRound q X Y x] at hGF0
    have h1 := congrArg
      (fun w => w.comp (CategoryTheory.Abelian.Ext.mk₀ (η.inv.app Y)) (Nat.add_zero q)) hGF0
    simp only [CategoryTheory.Abelian.Ext.zero_comp] at h1
    rw [CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero q) (Nat.add_zero 0) (by omega),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, η.hom_inv_id_app Y] at h1
    change ((CategoryTheory.Abelian.Ext.mk₀ (η.inv.app X)).comp x (Nat.zero_add q)).comp
      (CategoryTheory.Abelian.Ext.mk₀ (𝟙 Y)) (Nat.add_zero q) = 0 at h1
    rw [CategoryTheory.Abelian.Ext.comp_mk₀_id] at h1
    have h2 := congrArg
      (fun w => (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app X)).comp w (Nat.zero_add q)) h1
    simp only [CategoryTheory.Abelian.Ext.comp_zero] at h2
    rw [← CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app X))
      (CategoryTheory.Abelian.Ext.mk₀ (η.inv.app X)) x (Nat.zero_add 0) (Nat.zero_add q) (by omega),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, η.hom_inv_id_app X] at h2
    change (CategoryTheory.Abelian.Ext.mk₀ (𝟙 X)).comp x (Nat.zero_add q) = 0 at h2
    rwa [CategoryTheory.Abelian.Ext.mk₀_id_comp] at h2

  
  let S_K := AlgebraicGeometry.Spec (CommRingCat.of K)
  let S_K' := AlgebraicGeometry.Spec (CommRingCat.of K')
  let h : S_K' ⟶ S_K := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K K'))
  let B_h := weilAltCdSitePullback h
  let J_K := S_K.smallEtaleTopology
  let J_K' := S_K'.smallEtaleTopology
  let Idx_K : Type u :=
    Σ (n : ℕ), Fin n → { f : Polynomial K // f.Monic ∧ Irreducible f ∧ f.Separable }
  let A_K : Idx_K → Type u := fun c => ∀ i : Fin c.1, AdjoinRoot (c.2 i).1
  have hEt_AK : ∀ c : Idx_K, Algebra.Etale K (A_K c) := by
    intro ⟨n, f⟩
    have : ∀ i : Fin n, Fact (Irreducible (f i).1) := fun i => ⟨(f i).2.2.1⟩
    have hFin_i : ∀ i : Fin n, Module.Finite K (AdjoinRoot (f i).1) := fun i =>
      (AdjoinRoot.powerBasis (f i).2.2.1.ne_zero).finite
    have hSep_i : ∀ i : Fin n, Algebra.IsSeparable K (AdjoinRoot (f i).1) := by
      intro i
      let p := (f i).1
      have : Fact (Irreducible p) := ⟨(f i).2.2.1⟩
      let r : AdjoinRoot p := AdjoinRoot.root p
      have haeval_r : Polynomial.aeval r p = 0 := by
        rw [AdjoinRoot.aeval_eq, AdjoinRoot.mk_self]
      have hmin_r : p = minpoly K r :=
        minpoly.eq_of_irreducible_of_monic (f i).2.2.1 haeval_r (f i).2.1
      have hsep_r : IsSeparable K r := by
        unfold IsSeparable
        rw [← hmin_r]
        exact (f i).2.2.2
      let L_r : IntermediateField K (AdjoinRoot p) :=
        IntermediateField.adjoin K ({r} : Set (AdjoinRoot p))
      have : Algebra.IsSeparable K ↥L_r :=
        (IntermediateField.isSeparable_adjoin_simple_iff_isSeparable K (AdjoinRoot p)).mpr hsep_r
      refine ⟨fun x => ?_⟩
      obtain ⟨q, rfl⟩ := AdjoinRoot.mk_surjective x
      rw [← AdjoinRoot.aeval_eq]
      have hmem : Polynomial.aeval r q ∈ L_r := by
        induction q using Polynomial.induction_on' with
        | add p₁ p₂ h₁ h₂ =>
          rw [map_add]
          exact L_r.add_mem h₁ h₂
        | monomial k_exp a =>
          rw [Polynomial.aeval_monomial, ← Algebra.smul_def]
          change a • r ^ k_exp ∈ L_r.toSubalgebra
          exact L_r.toSubalgebra.smul_mem
            (L_r.toSubalgebra.pow_mem (IntermediateField.mem_adjoin_simple_self K r) k_exp) a
      exact IntermediateField.isSeparable_of_mem_isSeparable K (AdjoinRoot p) hmem
    let e_ulift : (∀ i : Fin n, AdjoinRoot (f i).1) ≃ₐ[K]
        (∀ j : ULift.{u} (Fin n), AdjoinRoot (f j.down).1) :=
      { toFun := fun x j => x j.down
        invFun := fun y i => y (ULift.up i)
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl
        map_mul' := fun _ _ => rfl
        map_add' := fun _ _ => rfl
        commutes' := fun _ => rfl }
    exact (Algebra.Etale.iff_exists_algEquiv_prod K (∀ i : Fin n, AdjoinRoot (f i).1)).mpr
      ⟨ULift.{u} (Fin n), inferInstance, fun j => AdjoinRoot (f j.down).1, fun _ => inferInstance,
       fun _ => inferInstance, e_ulift, fun j => ⟨hFin_i j.down, hSep_i j.down⟩⟩
  have : ∀ c : Idx_K, Algebra.Etale K (A_K c) := hEt_AK
  have : ∀ c : Idx_K, Algebra.Etale K' (TensorProduct K K' (A_K c)) :=
    fun c => Algebra.Etale.baseChange K (A_K c) K'
  let obj_K : Idx_K → S_K.Etale := fun c => weilAltCdSpecEtaleObj K (A_K c)
  let D_K : Type u := CategoryTheory.InducedCategory S_K.Etale obj_K
  let G_K : D_K ⥤ S_K.Etale := CategoryTheory.inducedFunctor obj_K
  let F₀ : D_K ⥤ S_K'.Etale := G_K.comp B_h
  have hSpecHomBij : ∀ (E R₁ R₂ : Type u) [Field E] [CommRing R₁] [Algebra E R₁] [Algebra.Etale E R₁]
      [CommRing R₂] [Algebra E R₂] [Algebra.Etale E R₂],
      Function.Bijective (@weilAltCdSpecEtaleMap E _ R₁ R₂ _ _ _ _ _ _) := by
    intro E R₁ R₂ _ _ _ _ _ _ _
    constructor
    · intro f₁ f₂ hf
      have hleft : (weilAltCdSpecEtaleMap E f₁).left = (weilAltCdSpecEtaleMap E f₂).left := by
        rw [hf]
      have hhom := AlgebraicGeometry.Spec.map_injective hleft
      ext x
      exact congrArg (fun m => m.hom x) hhom
    · intro u
      let φ : CommRingCat.of R₁ ⟶ CommRingCat.of R₂ :=
        AlgebraicGeometry.Spec.preimage u.left
      have hcomm : CategoryTheory.CategoryStruct.comp
          (CommRingCat.ofHom (algebraMap E R₁)) φ =
          CommRingCat.ofHom (algebraMap E R₂) :=
        AlgebraicGeometry.Spec.map_injective
          ((AlgebraicGeometry.Spec.map_comp (CommRingCat.ofHom (algebraMap E R₁)) φ).trans
            ((congrArg (· ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E R₁)))
              (AlgebraicGeometry.Spec.map_preimage u.left)).trans
              (CategoryTheory.MorphismProperty.Over.w u)))
      let f_alg : R₁ →ₐ[E] R₂ :=
        { φ.hom with
          commutes' := fun c => congrArg (fun m => m.hom c) hcomm }
      refine ⟨f_alg, ?_⟩
      apply CategoryTheory.MorphismProperty.Over.Hom.ext
      change AlgebraicGeometry.Spec.map φ = u.left
      exact AlgebraicGeometry.Spec.map_preimage u.left
  let τ_comm : ∀ c : D_K,
      CommRingCat.of (TensorProduct K K' (A_K c)) ≅
        CommRingCat.of (TensorProduct K (A_K c) K') :=
    fun c => (Algebra.TensorProduct.comm K K' (A_K c)).toRingEquiv.toCommRingCatIso
  let spec_τ_iso : ∀ c : D_K,
      AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct K (A_K c) K')) ≅
        AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct K K' (A_K c))) :=
    fun c =>
      { hom := AlgebraicGeometry.Spec.map (τ_comm c).hom
        inv := AlgebraicGeometry.Spec.map (τ_comm c).inv
        hom_inv_id := by
