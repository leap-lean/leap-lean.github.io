        dsimp only [mkSigma, B_aff, CategoryTheory.Functor.comp_map]
        exact (CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg (mkTau M₀ B₀ M hFD hle ≫ ·)
            ((F_BC.map_comp _ _).symm.trans
              ((congrArg F_BC.map (hUnitNat u_M)).trans (F_BC.map_comp _ _)))).trans
            (CategoryTheory.Category.assoc _ _ _).symm)
      refine (CategoryTheory.Category.assoc u_L (mkTau M₀ A₀ M hFD hle) _).symm.trans
        ((congrArg (· ≫ F_BC.map (eq_K.unitIso.app X_MA).hom) ?_).trans h_rhs.symm)
      apply (homEquiv Y_LB X_MA).injective
      apply Subtype.ext
      rw [hhom_left, hhom_right, hTauRing M₀ B₀ M hFD hle, hTauRing M₀ A₀ M hFD hle,
        hu_L_ring, hu_M_ring]
      apply CommRingCat.hom_ext
      refine RingHom.ext fun z => ?_
      induction z using TensorProduct.induction_on with
      | zero => exact (RingHom.map_zero _).trans (RingHom.map_zero _).symm
      | tmul a b => rfl
      | add x₁ x₂ ih₁ ih₂ =>
        exact (RingHom.map_add _ x₁ x₂).trans ((congrArg₂ (· + ·) ih₁ ih₂).trans
