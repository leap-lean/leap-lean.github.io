theorem weil_alt_cd_affine_cech_nerve_cosimplicial_descent (K F₀ L_inf : Type u) [Field K] [Field F₀] [Field L_inf]
    [Algebra K F₀] [FiniteDimensional K F₀] [Algebra.IsSeparable K F₀] [Algebra.Etale K F₀]
    [Algebra F₀ L_inf] [Algebra.IsSeparable F₀ L_inf]
    (hEtM : ∀ (M : IntermediateField F₀ L_inf), FiniteDimensional F₀ ↥M →
      letI : Algebra K ↥M := RingHom.toAlgebra ((algebraMap F₀ ↥M).comp (algebraMap K F₀))
      Algebra.Etale K ↥M)
    (hDescObj : ∀ (A_inf : Type u) [CommRing A_inf] [Algebra L_inf A_inf] [Algebra.Etale L_inf A_inf],
      ∃ (M₀ : IntermediateField F₀ L_inf) (_ : FiniteDimensional F₀ ↥M₀)
        (A₀ : Type u) (_ : CommRing A₀) (_ : Algebra ↥M₀ A₀) (_ : Algebra.Etale ↥M₀ A₀),
        Nonempty (TensorProduct ↥M₀ L_inf A₀ ≃ₐ[L_inf] A_inf))
    (hDescHom : ∀ (M₀ : IntermediateField F₀ L_inf), FiniteDimensional F₀ ↥M₀ →
      ∀ (A₀ : Type u) [CommRing A₀] [Algebra ↥M₀ A₀],
        (∀ (M : IntermediateField F₀ L_inf) (hle : M₀ ≤ M),
          letI : Algebra ↥M₀ ↥M := (IntermediateField.inclusion hle).toRingHom.toAlgebra
          letI : IsScalarTower ↥M₀ ↥M L_inf := IsScalarTower.of_algebraMap_eq' rfl
          Function.Injective
            (Algebra.TensorProduct.map (IsScalarTower.toAlgHom ↥M₀ ↥M L_inf)
              (AlgHom.id ↥M₀ A₀))) ∧
        (∀ (C : Type u) [CommRing C] [Algebra K C] [Algebra.FiniteType K C]
            (ψ : C →+* TensorProduct ↥M₀ L_inf A₀),
          (∀ c : K, ψ (algebraMap K C c) =
            algebraMap ↥M₀ (TensorProduct ↥M₀ L_inf A₀)
              (algebraMap F₀ ↥M₀ (algebraMap K F₀ c))) →
          ∃ (M₁ : IntermediateField F₀ L_inf) (_ : FiniteDimensional F₀ ↥M₁) (hle : M₀ ≤ M₁),
            letI : Algebra ↥M₀ ↥M₁ := (IntermediateField.inclusion hle).toRingHom.toAlgebra
            letI : IsScalarTower ↥M₀ ↥M₁ L_inf := IsScalarTower.of_algebraMap_eq' rfl
            ∃ (ψ₁ : C →+* TensorProduct ↥M₀ ↥M₁ A₀),
              (∀ c : K, ψ₁ (algebraMap K C c) =
                algebraMap ↥M₀ (TensorProduct ↥M₀ ↥M₁ A₀)
                  (algebraMap F₀ ↥M₀ (algebraMap K F₀ c))) ∧
              (Algebra.TensorProduct.map (IsScalarTower.toAlgHom ↥M₀ ↥M₁ L_inf)
                (AlgHom.id ↥M₀ A₀)).toRingHom.comp ψ₁ = ψ))
    (U W : (AlgebraicGeometry.Spec (CommRingCat.of L_inf)).Etale)
    [AlgebraicGeometry.IsAffine U.left] [AlgebraicGeometry.IsAffine W.left]
    (f : W ⟶ U) :
    ∃ (M₀ : IntermediateField F₀ L_inf) (_ : FiniteDimensional F₀ ↥M₀)
      (R₀ : ℕ → Type u) (_ : ∀ k, CommRing (R₀ k)) (_ : ∀ k, Algebra ↥M₀ (R₀ k))
      (_ : ∀ k, Algebra.Etale ↥M₀ (R₀ k))
      (δ₀ : ∀ {a b : SimplexCategory}, (a ⟶ b) → (R₀ a.len →ₐ[↥M₀] R₀ b.len)),
      (∀ a : SimplexCategory, δ₀ (CategoryTheory.CategoryStruct.id a) = AlgHom.id ↥M₀ (R₀ a.len)) ∧
      (∀ {a b c : SimplexCategory} (g₁ : a ⟶ b) (g₂ : b ⟶ c),
        δ₀ (CategoryTheory.CategoryStruct.comp g₁ g₂) = (δ₀ g₂).comp (δ₀ g₁)) ∧
      (∃ (e_L : ∀ a : SimplexCategory,
          ((CategoryTheory.Arrow.mk f).cechNerve.obj (Opposite.op a)) ≅
            weilAltCdSpecEtaleObj L_inf (TensorProduct ↥M₀ L_inf (R₀ a.len))),
        ∀ {a b : SimplexCategory} (g : a ⟶ b),
          CategoryTheory.CategoryStruct.comp
            ((CategoryTheory.Arrow.mk f).cechNerve.map g.op) (e_L a).hom =
          CategoryTheory.CategoryStruct.comp (e_L b).hom
            (weilAltCdSpecEtaleMap L_inf
              (Algebra.TensorProduct.map (AlgHom.id L_inf L_inf) (δ₀ g)))) ∧
      (∀ (M : IntermediateField F₀ L_inf) (hFD : FiniteDimensional F₀ ↥M) (hle : M₀ ≤ M),
        letI : Algebra K ↥M := RingHom.toAlgebra ((algebraMap F₀ ↥M).comp (algebraMap K F₀))
        letI : Algebra.Etale K ↥M := hEtM M hFD
        letI : Algebra ↥M₀ ↥M := (IntermediateField.inclusion hle).toRingHom.toAlgebra
        let hEtSpec : AlgebraicGeometry.Etale
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K ↥M))) :=
          (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
            (RingHom.etale_algebraMap.mpr inferInstance)
        let F_M := weilAltCdFieldEtaleMap hEtSpec
        ∃ (f_M : CategoryTheory.Arrow (AlgebraicGeometry.Spec (CommRingCat.of K)).Etale)
          (e_M : ∀ a : SimplexCategory,
            (f_M.cechNerve.obj (Opposite.op a)) ≅
              F_M.obj (weilAltCdSpecEtaleObj ↥M (TensorProduct ↥M₀ ↥M (R₀ a.len)))),
          ∀ {a b : SimplexCategory} (g : a ⟶ b),
            CategoryTheory.CategoryStruct.comp (f_M.cechNerve.map g.op) (e_M a).hom =
            CategoryTheory.CategoryStruct.comp (e_M b).hom
              (F_M.map (weilAltCdSpecEtaleMap ↥M
                (Algebra.TensorProduct.map (AlgHom.id ↥M ↥M) (δ₀ g))))) :=
by
  have hSpecMapId : ∀ (E : Type u) [Field E] (A : Type u) [CommRing A] [Algebra E A]
      [Algebra.Etale E A],
      weilAltCdSpecEtaleMap E (AlgHom.id E A) =
        CategoryTheory.CategoryStruct.id (weilAltCdSpecEtaleObj E A) := by
    intro E _ A _ _ _
    apply CategoryTheory.MorphismProperty.Comma.Hom.ext
    · change AlgebraicGeometry.Spec.map (CommRingCat.ofHom (AlgHom.id E A).toRingHom) =
        CategoryTheory.CategoryStruct.id _
      have hid : CommRingCat.ofHom (AlgHom.id E A).toRingHom =
          CategoryTheory.CategoryStruct.id (CommRingCat.of A) := rfl
      rw [hid, AlgebraicGeometry.Spec.map_id]
    · exact Subsingleton.elim _ _

  have hSpecMapComp : ∀ (E : Type u) [Field E] {A₁ A₂ A₃ : Type u}
      [CommRing A₁] [CommRing A₂] [CommRing A₃]
      [Algebra E A₁] [Algebra E A₂] [Algebra E A₃]
      [Algebra.Etale E A₁] [Algebra.Etale E A₂] [Algebra.Etale E A₃]
      (f₁ : A₁ →ₐ[E] A₂) (f₂ : A₂ →ₐ[E] A₃),
      weilAltCdSpecEtaleMap E (f₂.comp f₁) =
        CategoryTheory.CategoryStruct.comp
          (weilAltCdSpecEtaleMap E f₂) (weilAltCdSpecEtaleMap E f₁) := by
    intro E _ A₁ A₂ A₃ _ _ _ _ _ _ _ _ _ f₁ f₂
    apply CategoryTheory.MorphismProperty.Comma.Hom.ext
    · change AlgebraicGeometry.Spec.map (CommRingCat.ofHom (f₂.comp f₁).toRingHom) =
        CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₂.toRingHom))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₁.toRingHom))
      have hcomp : CommRingCat.ofHom (f₂.comp f₁).toRingHom =
          CategoryTheory.CategoryStruct.comp
            (CommRingCat.ofHom f₁.toRingHom) (CommRingCat.ofHom f₂.toRingHom) := rfl
      rw [hcomp, AlgebraicGeometry.Spec.map_comp]
    · exact Subsingleton.elim _ _

  have hSpecEquivIso : ∀ (E : Type u) [Field E] {A₁ A₂ : Type u}
      [CommRing A₁] [CommRing A₂] [Algebra E A₁] [Algebra E A₂]
      [Algebra.Etale E A₁] [Algebra.Etale E A₂]
      (e : A₁ ≃ₐ[E] A₂),
      ∃ (iso : weilAltCdSpecEtaleObj E A₂ ≅ weilAltCdSpecEtaleObj E A₁),
        iso.hom = weilAltCdSpecEtaleMap E e.toAlgHom := by
    intro E _ A₁ A₂ _ _ _ _ _ _ e
    refine ⟨{
      hom := weilAltCdSpecEtaleMap E e.toAlgHom
      inv := weilAltCdSpecEtaleMap E e.symm.toAlgHom
      hom_inv_id := by
        rw [← hSpecMapComp E e.symm.toAlgHom e.toAlgHom]
        have heq : e.toAlgHom.comp e.symm.toAlgHom = AlgHom.id E A₂ :=
          AlgHom.ext e.apply_symm_apply
        rw [heq, hSpecMapId]
      inv_hom_id := by
        rw [← hSpecMapComp E e.toAlgHom e.symm.toAlgHom]
        have heq : e.symm.toAlgHom.comp e.toAlgHom = AlgHom.id E A₁ :=
          AlgHom.ext e.symm_apply_apply
        rw [heq, hSpecMapId] }, rfl⟩

  
  have hStepArrow :
      ∃ (M₀ : IntermediateField F₀ L_inf) (_ : FiniteDimensional F₀ ↥M₀)
        (A₀ B₀ : Type u) (_ : CommRing A₀) (_ : CommRing B₀)
        (_ : Algebra ↥M₀ A₀) (_ : Algebra ↥M₀ B₀)
        (_ : Algebra.Etale ↥M₀ A₀) (_ : Algebra.Etale ↥M₀ B₀)
        (φ₀ : A₀ →ₐ[↥M₀] B₀)
        (e_U : U ≅ weilAltCdSpecEtaleObj L_inf (TensorProduct ↥M₀ L_inf A₀))
        (e_W : W ≅ weilAltCdSpecEtaleObj L_inf (TensorProduct ↥M₀ L_inf B₀)),
        CategoryTheory.CategoryStruct.comp f e_U.hom =
          CategoryTheory.CategoryStruct.comp e_W.hom
            (weilAltCdSpecEtaleMap L_inf
              (Algebra.TensorProduct.map (AlgHom.id L_inf L_inf) φ₀)) := by
    have hCoord : ∃ (A_inf B_inf : Type u) (_ : CommRing A_inf) (_ : CommRing B_inf)
        (_ : Algebra L_inf A_inf) (_ : Algebra L_inf B_inf)
        (_ : Algebra.Etale L_inf A_inf) (_ : Algebra.Etale L_inf B_inf)
        (φ_inf : A_inf →ₐ[L_inf] B_inf)
        (i_U : U ≅ weilAltCdSpecEtaleObj L_inf A_inf)
        (i_W : W ≅ weilAltCdSpecEtaleObj L_inf B_inf),
        CategoryTheory.CategoryStruct.comp f i_U.hom =
          CategoryTheory.CategoryStruct.comp i_W.hom (weilAltCdSpecEtaleMap L_inf φ_inf) := by
      let A_cat : CommRingCat.{u} := U.left.presheaf.obj (Opposite.op ⊤)
      let B_cat : CommRingCat.{u} := W.left.presheaf.obj (Opposite.op ⊤)
      let A_inf : Type u := ↥A_cat
      let B_inf : Type u := ↥B_cat
      let s_U : CommRingCat.of L_inf ⟶ CommRingCat.of A_inf :=
        AlgebraicGeometry.Spec.preimage (U.left.isoSpec.inv ≫ U.hom)
      let s_W : CommRingCat.of L_inf ⟶ CommRingCat.of B_inf :=
        AlgebraicGeometry.Spec.preimage (W.left.isoSpec.inv ≫ W.hom)
      have hs_U : AlgebraicGeometry.Spec.map s_U = U.left.isoSpec.inv ≫ U.hom :=
        AlgebraicGeometry.Spec.map_preimage _
      have hs_W : AlgebraicGeometry.Spec.map s_W = W.left.isoSpec.inv ≫ W.hom :=
        AlgebraicGeometry.Spec.map_preimage _
      let algA : Algebra L_inf A_inf := s_U.hom.toAlgebra
      let algB : Algebra L_inf B_inf := s_W.hom.toAlgebra
      let _ : Algebra L_inf A_inf := algA
      let _ : Algebra L_inf B_inf := algB
      have hEt_Ainf : Algebra.Etale L_inf A_inf := by
        have : AlgebraicGeometry.Etale U.hom := U.prop
        have hEt_comp : AlgebraicGeometry.Etale (U.left.isoSpec.inv ≫ U.hom) := inferInstance
        have hEt_spec : AlgebraicGeometry.Etale
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap L_inf A_inf))) := by
          change AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map s_U)
          rwa [hs_U]
        exact RingHom.etale_algebraMap.mp
          ((AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hEt_spec)
      have hEt_Binf : Algebra.Etale L_inf B_inf := by
        have : AlgebraicGeometry.Etale W.hom := W.prop
        have hEt_comp : AlgebraicGeometry.Etale (W.left.isoSpec.inv ≫ W.hom) := inferInstance
        have hEt_spec : AlgebraicGeometry.Etale
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap L_inf B_inf))) := by
          change AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map s_W)
          rwa [hs_W]
        exact RingHom.etale_algebraMap.mp
          ((AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hEt_spec)
      let i_U : U ≅ weilAltCdSpecEtaleObj L_inf A_inf :=
        CategoryTheory.MorphismProperty.Over.isoMk U.left.isoSpec
          ((congrArg (U.left.isoSpec.hom ≫ ·) hs_U).trans (Iso.hom_inv_id_assoc U.left.isoSpec U.hom))
      let i_W : W ≅ weilAltCdSpecEtaleObj L_inf B_inf :=
        CategoryTheory.MorphismProperty.Over.isoMk W.left.isoSpec
          ((congrArg (W.left.isoSpec.hom ≫ ·) hs_W).trans (Iso.hom_inv_id_assoc W.left.isoSpec W.hom))
      let φ_inf_cat : CommRingCat.of A_inf ⟶ CommRingCat.of B_inf :=
        AlgebraicGeometry.Spec.preimage (W.left.isoSpec.inv ≫ f.left ≫ U.left.isoSpec.hom)
      have h_sUW : s_U ≫ φ_inf_cat = s_W := by
        apply AlgebraicGeometry.Spec.map_injective
        rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage, hs_U, hs_W,
          Category.assoc, Category.assoc, Iso.hom_inv_id_assoc,
          CategoryTheory.MorphismProperty.Over.w f]
      let φ_inf : A_inf →ₐ[L_inf] B_inf :=
        { φ_inf_cat.hom with
          commutes' := fun l =>
            congrArg (fun g : CommRingCat.of L_inf ⟶ CommRingCat.of B_inf => g.hom l) h_sUW }
      refine ⟨A_inf, B_inf, inferInstance, inferInstance, algA, algB, hEt_Ainf, hEt_Binf,
        φ_inf, i_U, i_W, ?_⟩
      apply CategoryTheory.MorphismProperty.Over.Hom.ext
      change f.left ≫ U.left.isoSpec.hom =
        W.left.isoSpec.hom ≫ AlgebraicGeometry.Spec.map φ_inf_cat
      rw [AlgebraicGeometry.Spec.map_preimage, Iso.hom_inv_id_assoc]
    obtain ⟨A_inf, B_inf, hCR_Ainf, hCR_Binf, hAlg_Ainf, hAlg_Binf,
      hEt_Ainf, hEt_Binf, φ_inf, i_U, i_W, hf_inf⟩ := hCoord
    let _ : CommRing A_inf := hCR_Ainf
    let _ : CommRing B_inf := hCR_Binf
    let _ : Algebra L_inf A_inf := hAlg_Ainf
    let _ : Algebra L_inf B_inf := hAlg_Binf
    let _ : Algebra.Etale L_inf A_inf := hEt_Ainf
    let _ : Algebra.Etale L_inf B_inf := hEt_Binf
    have hAlgDesc :
        ∃ (M₀ : IntermediateField F₀ L_inf) (_ : FiniteDimensional F₀ ↥M₀)
          (A₀ B₀ : Type u) (_ : CommRing A₀) (_ : CommRing B₀)
          (_ : Algebra ↥M₀ A₀) (_ : Algebra ↥M₀ B₀)
          (_ : Algebra.Etale ↥M₀ A₀) (_ : Algebra.Etale ↥M₀ B₀)
          (φ₀ : A₀ →ₐ[↥M₀] B₀)
          (α_A : TensorProduct ↥M₀ L_inf A₀ ≃ₐ[L_inf] A_inf)
          (α_B : TensorProduct ↥M₀ L_inf B₀ ≃ₐ[L_inf] B_inf),
          α_B.toAlgHom.comp (Algebra.TensorProduct.map (AlgHom.id L_inf L_inf) φ₀) =
            φ_inf.comp α_A.toAlgHom := by
      have hBaseStep : ∀ {R₁ R₂ C_inf : Type u} [CommRing R₁] [CommRing R₂] [CommRing C_inf]
          [Algebra R₁ R₂] [Algebra R₁ L_inf] [Algebra R₂ L_inf] [IsScalarTower R₁ R₂ L_inf]
          [Algebra L_inf C_inf]
          (A₁ : Type u) [CommRing A₁] [Algebra R₁ A₁] [Algebra.Etale R₁ A₁]
          (e₁ : TensorProduct R₁ L_inf A₁ ≃ₐ[L_inf] C_inf),
          ∃ (A₂ : Type u) (_ : CommRing A₂) (_ : Algebra R₂ A₂) (_ : Algebra.Etale R₂ A₂),
            Nonempty (TensorProduct R₂ L_inf A₂ ≃ₐ[L_inf] C_inf) := by
        intro R₁ R₂ C_inf _ _ _ _ _ _ _ _ A₁ _ _ _ e₁
        exact ⟨TensorProduct R₁ R₂ A₁, inferInstance, inferInstance,
          Algebra.Etale.baseChange R₁ A₁ R₂,
          ⟨(Algebra.TensorProduct.cancelBaseChange R₁ R₂ L_inf L_inf A₁).trans e₁⟩⟩
      have hJoin : ∃ (M_join : IntermediateField F₀ L_inf) (_ : FiniteDimensional F₀ ↥M_join)
          (A_join B_join : Type u) (_ : CommRing A_join) (_ : CommRing B_join)
          (_ : Algebra ↥M_join A_join) (_ : Algebra ↥M_join B_join)
          (_ : Algebra.Etale ↥M_join A_join) (_ : Algebra.Etale ↥M_join B_join),
          Nonempty (TensorProduct ↥M_join L_inf A_join ≃ₐ[L_inf] A_inf) ∧
          Nonempty (TensorProduct ↥M_join L_inf B_join ≃ₐ[L_inf] B_inf) := by
        obtain ⟨M_A, hFD_A, A_init, hCR_Ai, hAlg_Ai, hEt_Ai, ⟨e_A⟩⟩ := hDescObj A_inf
        obtain ⟨M_B, hFD_B, B_init, hCR_Bi, hAlg_Bi, hEt_Bi, ⟨e_B⟩⟩ := hDescObj B_inf
        let _ : CommRing A_init := hCR_Ai
        let _ : Algebra ↥M_A A_init := hAlg_Ai
        let _ : Algebra.Etale ↥M_A A_init := hEt_Ai
        let _ : CommRing B_init := hCR_Bi
        let _ : Algebra ↥M_B B_init := hAlg_Bi
        let _ : Algebra.Etale ↥M_B B_init := hEt_Bi
        let M_join : IntermediateField F₀ L_inf := M_A ⊔ M_B
        have hFD_join : FiniteDimensional F₀ ↥M_join := IntermediateField.finiteDimensional_sup M_A M_B
        have hA : ∃ (A_join : Type u) (_ : CommRing A_join) (_ : Algebra ↥M_join A_join)
            (_ : Algebra.Etale ↥M_join A_join),
            Nonempty (TensorProduct ↥M_join L_inf A_join ≃ₐ[L_inf] A_inf) := by
          let _ : Algebra ↥M_A ↥M_join :=
            (IntermediateField.inclusion (le_sup_left : M_A ≤ M_join)).toRingHom.toAlgebra
          have _ : IsScalarTower ↥M_A ↥M_join L_inf := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
          exact hBaseStep A_init e_A
        have hB : ∃ (B_join : Type u) (_ : CommRing B_join) (_ : Algebra ↥M_join B_join)
            (_ : Algebra.Etale ↥M_join B_join),
            Nonempty (TensorProduct ↥M_join L_inf B_join ≃ₐ[L_inf] B_inf) := by
          let _ : Algebra ↥M_B ↥M_join :=
            (IntermediateField.inclusion (le_sup_right : M_B ≤ M_join)).toRingHom.toAlgebra
          have _ : IsScalarTower ↥M_B ↥M_join L_inf := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
          exact hBaseStep B_init e_B
        obtain ⟨A_join, hCR_Aj, hAlg_Aj, hEt_Aj, heA⟩ := hA
        obtain ⟨B_join, hCR_Bj, hAlg_Bj, hEt_Bj, heB⟩ := hB
        exact ⟨M_join, hFD_join, A_join, B_join, hCR_Aj, hCR_Bj, hAlg_Aj, hAlg_Bj,
          hEt_Aj, hEt_Bj, heA, heB⟩
      obtain ⟨M_join, hFD_join, A_join, B_join, hCR_Aj, hCR_Bj, hAlg_Aj, hAlg_Bj,
        hEt_Aj, hEt_Bj, ⟨e'_A⟩, ⟨e'_B⟩⟩ := hJoin
      let _ : CommRing A_join := hCR_Aj
      let _ : CommRing B_join := hCR_Bj
      let _ : Algebra ↥M_join A_join := hAlg_Aj
      let _ : Algebra ↥M_join B_join := hAlg_Bj
      let _ : Algebra.Etale ↥M_join A_join := hEt_Aj
      let _ : Algebra.Etale ↥M_join B_join := hEt_Bj
      let θ_inf : TensorProduct ↥M_join L_inf A_join →ₐ[L_inf] TensorProduct ↥M_join L_inf B_join :=
        e'_B.symm.toAlgHom.comp (φ_inf.comp e'_A.toAlgHom)
      let ψ : A_join →+* TensorProduct ↥M_join L_inf B_join :=
        θ_inf.toRingHom.comp
          (Algebra.TensorProduct.includeRight (R := ↥M_join) (A := L_inf) (B := A_join)).toRingHom
      have hψ_Mj : ∀ m : ↥M_join, ψ (algebraMap ↥M_join A_join m) =
          algebraMap ↥M_join (TensorProduct ↥M_join L_inf B_join) m := by
        intro m
        change θ_inf ((1 : L_inf) ⊗ₜ[↥M_join] algebraMap ↥M_join A_join m) =
          (algebraMap ↥M_join L_inf m) ⊗ₜ[↥M_join] (1 : B_join)
        have htmul : ((1 : L_inf) ⊗ₜ[↥M_join] algebraMap ↥M_join A_join m) =
            algebraMap L_inf (TensorProduct ↥M_join L_inf A_join) (algebraMap ↥M_join L_inf m) := by
          rw [Algebra.algebraMap_eq_smul_one m, ← TensorProduct.smul_tmul,
            ← Algebra.algebraMap_eq_smul_one m]
          rfl
        rw [htmul, θ_inf.commutes]
        rfl
      have hExM₀ : ∃ (M₀ : IntermediateField F₀ L_inf) (_ : FiniteDimensional F₀ ↥M₀)
          (hle : M_join ≤ M₀),
          letI : Algebra ↥M_join ↥M₀ := (IntermediateField.inclusion hle).toRingHom.toAlgebra
          letI : IsScalarTower ↥M_join ↥M₀ L_inf := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
          ∃ (ψ₁ : A_join →+* TensorProduct ↥M_join ↥M₀ B_join),
            (Algebra.TensorProduct.map (IsScalarTower.toAlgHom ↥M_join ↥M₀ L_inf)
              (AlgHom.id ↥M_join B_join)).toRingHom.comp ψ₁ = ψ := by
        have hEtFT : ∀ {R A : Type u} [CommRing R] [CommRing A] [Algebra R A] [Algebra.Etale R A],
            Algebra.FiniteType R A := fun {_ _ _ _ _ _} => inferInstance
        let _ : Algebra K ↥M_join :=
          RingHom.toAlgebra ((algebraMap F₀ ↥M_join).comp (algebraMap K F₀))
        have _ : Algebra.Etale K ↥M_join := hEtM M_join hFD_join
        let _ : Algebra K A_join :=
          RingHom.toAlgebra ((algebraMap ↥M_join A_join).comp (algebraMap K ↥M_join))
        have _ : IsScalarTower K ↥M_join A_join :=
          IsScalarTower.of_algebraMap_eq (fun _ => rfl)
        have _ : Algebra.Etale K A_join := Algebra.Etale.comp K ↥M_join A_join
        have _ : Algebra.FiniteType K A_join := hEtFT
        obtain ⟨M₀, hFD₀, hle₀, ψ₁, _, hcomp₁⟩ :=
          (@hDescHom M_join hFD_join B_join _ _).2 A_join ψ (fun c => hψ_Mj _)
        exact ⟨M₀, hFD₀, hle₀, ψ₁, hcomp₁⟩
      obtain ⟨M₀, hFD₀, hle₀, ψ₁, hcomp₁⟩ := hExM₀
      let _ : Algebra ↥M_join ↥M₀ := (IntermediateField.inclusion hle₀).toRingHom.toAlgebra
      have _ : IsScalarTower ↥M_join ↥M₀ L_inf := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
      have hInj₀ : Function.Injective
          (Algebra.TensorProduct.map (IsScalarTower.toAlgHom ↥M_join ↥M₀ L_inf)
            (AlgHom.id ↥M_join B_join)) :=
        (hDescHom M_join hFD_join B_join).1 M₀ hle₀
      let ψ₁_alg : A_join →ₐ[↥M_join] TensorProduct ↥M_join ↥M₀ B_join :=
        { ψ₁ with
          commutes' := fun m => by
            apply hInj₀
            have h1 : (Algebra.TensorProduct.map (IsScalarTower.toAlgHom ↥M_join ↥M₀ L_inf)
                (AlgHom.id ↥M_join B_join)) (ψ₁ (algebraMap ↥M_join A_join m)) =
                ψ (algebraMap ↥M_join A_join m) :=
              RingHom.congr_fun hcomp₁ (algebraMap ↥M_join A_join m)
            have h2 : (Algebra.TensorProduct.map (IsScalarTower.toAlgHom ↥M_join ↥M₀ L_inf)
                (AlgHom.id ↥M_join B_join))
                (algebraMap ↥M_join (TensorProduct ↥M_join ↥M₀ B_join) m) =
                algebraMap ↥M_join (TensorProduct ↥M_join L_inf B_join) m := by
              change (Algebra.TensorProduct.map (IsScalarTower.toAlgHom ↥M_join ↥M₀ L_inf)
                  (AlgHom.id ↥M_join B_join)) ((algebraMap ↥M_join ↥M₀ m) ⊗ₜ[↥M_join] (1 : B_join)) =
                (algebraMap ↥M_join L_inf m) ⊗ₜ[↥M_join] (1 : B_join)
              rw [Algebra.TensorProduct.map_tmul]
              rfl
            exact h1.trans ((hψ_Mj m).trans h2.symm) }
      have hFinalLift : ∀ {R₁ R₂ : Type u} [CommRing R₁] [CommRing R₂]
          [Algebra R₁ R₂] [Algebra R₁ L_inf] [Algebra R₂ L_inf] [IsScalarTower R₁ R₂ L_inf]
          (AJ BJ : Type u) [CommRing AJ] [CommRing BJ]
          [Algebra R₁ AJ] [Algebra R₁ BJ] [Algebra.Etale R₁ AJ] [Algebra.Etale R₁ BJ]
          (f_alg : AJ →ₐ[R₁] TensorProduct R₁ R₂ BJ)
          (ea : TensorProduct R₁ L_inf AJ ≃ₐ[L_inf] A_inf)
          (eb : TensorProduct R₁ L_inf BJ ≃ₐ[L_inf] B_inf),
          (∀ a : AJ,
            Algebra.TensorProduct.map (IsScalarTower.toAlgHom R₁ R₂ L_inf) (AlgHom.id R₁ BJ)
              (f_alg a) = eb.symm (φ_inf (ea ((1 : L_inf) ⊗ₜ[R₁] a)))) →
          ∃ (A₀ B₀ : Type u) (_ : CommRing A₀) (_ : CommRing B₀)
            (_ : Algebra R₂ A₀) (_ : Algebra R₂ B₀)
            (_ : Algebra.Etale R₂ A₀) (_ : Algebra.Etale R₂ B₀)
            (φ₀ : A₀ →ₐ[R₂] B₀)
            (α_A : TensorProduct R₂ L_inf A₀ ≃ₐ[L_inf] A_inf)
            (α_B : TensorProduct R₂ L_inf B₀ ≃ₐ[L_inf] B_inf),
            α_B.toAlgHom.comp (Algebra.TensorProduct.map (AlgHom.id L_inf L_inf) φ₀) =
              φ_inf.comp α_A.toAlgHom := by
        intro R₁ R₂ _ _ _ _ _ _ AJ BJ _ _ _ _ _ _ f_alg ea eb hf_alg
        let A₀ : Type u := TensorProduct R₁ R₂ AJ
        let B₀ : Type u := TensorProduct R₁ R₂ BJ
        have hEtA₀ : Algebra.Etale R₂ A₀ := Algebra.Etale.baseChange R₁ AJ R₂
        have hEtB₀ : Algebra.Etale R₂ B₀ := Algebra.Etale.baseChange R₁ BJ R₂
        let φ₀ : A₀ →ₐ[R₂] B₀ :=
          Algebra.TensorProduct.lift (Algebra.ofId R₂ B₀) f_alg (fun _ _ => Commute.all _ _)
        let cA := Algebra.TensorProduct.cancelBaseChange R₁ R₂ L_inf L_inf AJ
        let cB := Algebra.TensorProduct.cancelBaseChange R₁ R₂ L_inf L_inf BJ
        have hcB_one : ∀ y : B₀, cB ((1 : L_inf) ⊗ₜ[R₂] y) =
            Algebra.TensorProduct.map (IsScalarTower.toAlgHom R₁ R₂ L_inf) (AlgHom.id R₁ BJ) y := by
          intro y
          induction y using TensorProduct.induction_on with
          | zero => rw [TensorProduct.tmul_zero, map_zero, map_zero]
          | tmul r₂ b =>
            dsimp [cB]
            rw [Algebra.TensorProduct.cancelBaseChange_tmul R₁ R₂ L_inf L_inf BJ]
            congr 1
            exact (Algebra.algebraMap_eq_smul_one r₂).symm
          | add x y ihx ihy => rw [TensorProduct.tmul_add, map_add, map_add, ihx, ihy]
        refine ⟨A₀, B₀, inferInstance, inferInstance, inferInstance, inferInstance,
          hEtA₀, hEtB₀, φ₀, cA.trans ea, cB.trans eb, ?_⟩
        apply AlgHom.ext
        intro w
        induction w using TensorProduct.induction_on with
        | zero => rw [map_zero, map_zero]
        | add x y ihx ihy => rw [map_add, map_add, ihx, ihy]
        | tmul l z =>
          induction z using TensorProduct.induction_on with
          | zero => rw [TensorProduct.tmul_zero, map_zero, map_zero]
          | add x y ihx ihy => rw [TensorProduct.tmul_add, map_add, map_add, ihx, ihy]
          | tmul r₂ a =>
            have hdecomp : (l ⊗ₜ[R₂] (r₂ ⊗ₜ[R₁] a) : TensorProduct R₂ L_inf A₀) =
                algebraMap L_inf (TensorProduct R₂ L_inf A₀) (r₂ • l) *
                  ((1 : L_inf) ⊗ₜ[R₂] ((1 : R₂) ⊗ₜ[R₁] a)) := by
              have hm : (r₂ ⊗ₜ[R₁] a : A₀) = r₂ • ((1 : R₂) ⊗ₜ[R₁] a) := by
                rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
              rw [hm, ← TensorProduct.smul_tmul]
              change ((r₂ • l) ⊗ₜ[R₂] ((1 : R₂) ⊗ₜ[R₁] a)) =
                ((r₂ • l) ⊗ₜ[R₂] (1 : A₀)) * ((1 : L_inf) ⊗ₜ[R₂] ((1 : R₂) ⊗ₜ[R₁] a))
              rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
            rw [hdecomp, map_mul, map_mul, AlgHom.commutes, AlgHom.commutes]
            congr 1
            change eb (cB ((1 : L_inf) ⊗ₜ[R₂] φ₀ ((1 : R₂) ⊗ₜ[R₁] a))) =
              φ_inf (ea (cA ((1 : L_inf) ⊗ₜ[R₂] ((1 : R₂) ⊗ₜ[R₁] a))))
            have hφ₀_tmul : φ₀ ((1 : R₂) ⊗ₜ[R₁] a) = f_alg a := by
              dsimp [φ₀]
              rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
            rw [hφ₀_tmul, hcB_one (f_alg a), hf_alg a, eb.apply_symm_apply]
            dsimp [cA]
            rw [Algebra.TensorProduct.cancelBaseChange_tmul R₁ R₂ L_inf L_inf AJ, one_smul]
      exact ⟨M₀, hFD₀, @hFinalLift ↥M_join ↥M₀ _ _ _ _ _ _ A_join B_join _ _ _ _ _ _ ψ₁_alg e'_A e'_B
        (fun a => RingHom.congr_fun hcomp₁ a)⟩
    have hFinishArrow : ∀ (R₀_base : Type u) [CommRing R₀_base] [Algebra R₀_base L_inf]
        (A₀ B₀ : Type u) [CommRing A₀] [CommRing B₀]
        [Algebra R₀_base A₀] [Algebra R₀_base B₀]
        [Algebra.Etale R₀_base A₀] [Algebra.Etale R₀_base B₀]
        (φ₀ : A₀ →ₐ[R₀_base] B₀)
        (α_A : TensorProduct R₀_base L_inf A₀ ≃ₐ[L_inf] A_inf)
        (α_B : TensorProduct R₀_base L_inf B₀ ≃ₐ[L_inf] B_inf),
        α_B.toAlgHom.comp (Algebra.TensorProduct.map (AlgHom.id L_inf L_inf) φ₀) =
          φ_inf.comp α_A.toAlgHom →
        letI : Algebra.Etale L_inf (TensorProduct R₀_base L_inf A₀) :=
          Algebra.Etale.baseChange R₀_base A₀ L_inf
        letI : Algebra.Etale L_inf (TensorProduct R₀_base L_inf B₀) :=
          Algebra.Etale.baseChange R₀_base B₀ L_inf
        ∃ (e_U : U ≅ weilAltCdSpecEtaleObj L_inf (TensorProduct R₀_base L_inf A₀))
          (e_W : W ≅ weilAltCdSpecEtaleObj L_inf (TensorProduct R₀_base L_inf B₀)),
          CategoryTheory.CategoryStruct.comp f e_U.hom =
            CategoryTheory.CategoryStruct.comp e_W.hom
              (weilAltCdSpecEtaleMap L_inf
                (Algebra.TensorProduct.map (AlgHom.id L_inf L_inf) φ₀)) := by
      intro R₀_base _ _ A₀ B₀ _ _ _ _ _ _ φ₀ α_A α_B hAlgIntertwine
      let _ : Algebra.Etale L_inf (TensorProduct R₀_base L_inf A₀) :=
        Algebra.Etale.baseChange R₀_base A₀ L_inf
      let _ : Algebra.Etale L_inf (TensorProduct R₀_base L_inf B₀) :=
        Algebra.Etale.baseChange R₀_base B₀ L_inf
      obtain ⟨iso_αA, hiso_αA⟩ := hSpecEquivIso L_inf α_A
      obtain ⟨iso_αB, hiso_αB⟩ := hSpecEquivIso L_inf α_B
      have hArrowGlue : ∀ {𝒞 : Type (u + 1)} [CategoryTheory.Category.{u} 𝒞]
          {X₁ X₂ Y₁ Y₂ Z₁ Z₂ : 𝒞}
          (m : X₂ ⟶ X₁) (i₁ : X₁ ≅ Y₁) (i₂ : X₂ ≅ Y₂)
          (j₁ : Y₁ ≅ Z₁) (j₂ : Y₂ ≅ Z₂)
          (u₁ : Y₁ ⟶ Z₁) (u₂ : Y₂ ⟶ Z₂)
          (mY : Y₂ ⟶ Y₁) (mZ : Z₂ ⟶ Z₁),
          m ≫ i₁.hom = i₂.hom ≫ mY →
          j₁.hom = u₁ →
          j₂.hom = u₂ →
          mY ≫ u₁ = u₂ ≫ mZ →
          m ≫ (i₁.trans j₁).hom = (i₂.trans j₂).hom ≫ mZ := by
        intro 𝒞 _ X₁ X₂ Y₁ Y₂ Z₁ Z₂ m i₁ i₂ j₁ j₂ u₁ u₂ mY mZ hm hj₁ hj₂ hcomm
        rw [Iso.trans_hom, Iso.trans_hom, hj₁, hj₂, ← Category.assoc, hm,
          Category.assoc, hcomm, Category.assoc]
      refine ⟨i_U.trans iso_αA, i_W.trans iso_αB,
        hArrowGlue f i_U i_W iso_αA iso_αB
          (weilAltCdSpecEtaleMap L_inf α_A.toAlgHom) (weilAltCdSpecEtaleMap L_inf α_B.toAlgHom)
          (weilAltCdSpecEtaleMap L_inf φ_inf)
          (weilAltCdSpecEtaleMap L_inf (Algebra.TensorProduct.map (AlgHom.id L_inf L_inf) φ₀))
          hf_inf hiso_αA hiso_αB ?_⟩
      exact (hSpecMapComp L_inf α_A.toAlgHom φ_inf).symm.trans
        ((congrArg (weilAltCdSpecEtaleMap L_inf) hAlgIntertwine.symm).trans
          (hSpecMapComp L_inf (Algebra.TensorProduct.map (AlgHom.id L_inf L_inf) φ₀) α_B.toAlgHom))
    obtain ⟨M₀, hFD₀, A₀, B₀, hCR_A₀, hCR_B₀, hAlg_A₀, hAlg_B₀, hEt_A₀, hEt_B₀,
      φ₀, α_A, α_B, hAlgIntertwine⟩ := hAlgDesc
    let _ : CommRing A₀ := hCR_A₀
    let _ : CommRing B₀ := hCR_B₀
    let _ : Algebra ↥M₀ A₀ := hAlg_A₀
    let _ : Algebra ↥M₀ B₀ := hAlg_B₀
    let _ : Algebra.Etale ↥M₀ A₀ := hEt_A₀
    let _ : Algebra.Etale ↥M₀ B₀ := hEt_B₀
    obtain ⟨e_U, e_W, hf⟩ := hFinishArrow ↥M₀ A₀ B₀ φ₀ α_A α_B hAlgIntertwine
    exact ⟨M₀, hFD₀, A₀, B₀, hCR_A₀, hCR_B₀, hAlg_A₀, hAlg_B₀,
      hEt_A₀, hEt_B₀, φ₀, e_U, e_W, hf⟩

  
  have hStepCopower : ∀ (M₀ A₀ B₀ : Type u) [CommRing M₀] [CommRing A₀] [CommRing B₀]
      [Algebra M₀ A₀] [Algebra M₀ B₀] [Algebra.Etale M₀ A₀] [Algebra.Etale M₀ B₀]
      (φ₀ : A₀ →ₐ[M₀] B₀),
      ∃ (R₀ : ℕ → Type u) (_ : ∀ k, CommRing (R₀ k)) (_ : ∀ k, Algebra M₀ (R₀ k))
        (_ : ∀ k, Algebra.Etale M₀ (R₀ k))
        (δ₀ : ∀ {a b : SimplexCategory}, (a ⟶ b) → (R₀ a.len →ₐ[M₀] R₀ b.len))
        (ι₀ : ∀ (k : ℕ), Fin (k + 1) → (B₀ →ₐ[M₀] R₀ k))
        (α₀ : ∀ (k : ℕ), A₀ →ₐ[M₀] R₀ k),
        (∀ a : SimplexCategory, δ₀ (CategoryTheory.CategoryStruct.id a) = AlgHom.id M₀ (R₀ a.len)) ∧
        (∀ {a b c : SimplexCategory} (g₁ : a ⟶ b) (g₂ : b ⟶ c),
          δ₀ (CategoryTheory.CategoryStruct.comp g₁ g₂) = (δ₀ g₂).comp (δ₀ g₁)) ∧
        (∀ (k : ℕ) (i : Fin (k + 1)), (ι₀ k i).comp φ₀ = α₀ k) ∧
        (∀ {a b : SimplexCategory} (g : a ⟶ b) (i : Fin (a.len + 1)),
          (δ₀ g).comp (ι₀ a.len i) = ι₀ b.len (g.toOrderHom i)) ∧
        (∀ (E : Type u) [CommRing E] [Algebra M₀ E] (k : ℕ) (T : Type u) [CommRing T],
          (∀ (u_A : TensorProduct M₀ E A₀ →+* T)
             (u_B : Fin (k + 1) → (TensorProduct M₀ E B₀ →+* T)),
            (∀ i : Fin (k + 1),
              (u_B i).comp (Algebra.TensorProduct.map (AlgHom.id E E) φ₀).toRingHom = u_A) →
            ∃ (u : TensorProduct M₀ E (R₀ k) →+* T),
              ∀ i : Fin (k + 1),
                u.comp (Algebra.TensorProduct.map (AlgHom.id E E) (ι₀ k i)).toRingHom = u_B i) ∧
          (∀ (u₁ u₂ : TensorProduct M₀ E (R₀ k) →+* T),
            (∀ i : Fin (k + 1),
              u₁.comp (Algebra.TensorProduct.map (AlgHom.id E E) (ι₀ k i)).toRingHom =
                u₂.comp (Algebra.TensorProduct.map (AlgHom.id E E) (ι₀ k i)).toRingHom) →
            u₁ = u₂)) := by
    intro M₀ A₀ B₀ _ _ _ _ _ _ _ φ₀
    let algAB : Algebra A₀ B₀ := φ₀.toRingHom.toAlgebra
    let _ : Algebra A₀ B₀ := algAB
    have _ : IsScalarTower M₀ A₀ B₀ := IsScalarTower.of_algebraMap_eq (fun m => (φ₀.commutes m).symm)
    have hEtAB : Algebra.Etale A₀ B₀ := by
      have hMA : AlgebraicGeometry.Etale
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap M₀ A₀))) :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
          (RingHom.etale_algebraMap.mpr inferInstance)
      have hMB : AlgebraicGeometry.Etale
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap M₀ B₀))) :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
          (RingHom.etale_algebraMap.mpr inferInstance)
      have hcomp : CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A₀ B₀)))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap M₀ A₀))) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap M₀ B₀)) := by
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        exact congrArg (fun g => AlgebraicGeometry.Spec.map (CommRingCat.ofHom g)) φ₀.comp_algebraMap
      have hAB : AlgebraicGeometry.Etale
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A₀ B₀))) :=
        CategoryTheory.MorphismProperty.of_postcomp (W := @AlgebraicGeometry.Etale)
          (W' := @AlgebraicGeometry.Etale)
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A₀ B₀)))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap M₀ A₀)))
          hMA (by rwa [hcomp])
      exact RingHom.etale_algebraMap.mp
        ((AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hAB)
    let pack : ∀ k : ℕ,
        Σ (R : Type u) (instCR : CommRing R) (instAlgA : Algebra A₀ R),
          Fin (k + 1) → @AlgHom A₀ B₀ R _ _ instCR.toSemiring algAB instAlgA :=
      Nat.rec
        ⟨B₀, inferInstance, algAB, fun _ => AlgHom.id A₀ B₀⟩
        (fun k ih =>
          letI : CommRing ih.1 := ih.2.1
          letI : Algebra A₀ ih.1 := ih.2.2.1
          ⟨TensorProduct A₀ B₀ ih.1, inferInstance, Algebra.TensorProduct.leftAlgebra,
            Fin.cases Algebra.TensorProduct.includeLeft
              (fun j => Algebra.TensorProduct.includeRight.comp (ih.2.2.2 j))⟩)
    let R₀ : ℕ → Type u := fun k => (pack k).1
    let instCR : ∀ k : ℕ, CommRing (R₀ k) := fun k => (pack k).2.1
    let instAlgA : ∀ k : ℕ, Algebra A₀ (R₀ k) := fun k => (pack k).2.2.1
    let _ : ∀ k : ℕ, CommRing (R₀ k) := instCR
    let _ : ∀ k : ℕ, Algebra A₀ (R₀ k) := instAlgA
    let ι₀_A : ∀ (k : ℕ), Fin (k + 1) → (B₀ →ₐ[A₀] R₀ k) := fun k => (pack k).2.2.2
    let instAlgM : ∀ k : ℕ, Algebra M₀ (R₀ k) := fun k =>
      RingHom.toAlgebra ((algebraMap A₀ (R₀ k)).comp (algebraMap M₀ A₀))
    let _ : ∀ k : ℕ, Algebra M₀ (R₀ k) := instAlgM
    have _ : ∀ k : ℕ, IsScalarTower M₀ A₀ (R₀ k) :=
      fun _ => IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    have hEtA : ∀ k : ℕ, Algebra.Etale A₀ (R₀ k) := by
      intro k
      induction k with
      | zero => exact hEtAB
      | succ k ih =>
        have _ : Algebra.Etale A₀ (R₀ k) := ih
        have _ : Algebra.Etale B₀ (TensorProduct A₀ B₀ (R₀ k)) :=
          Algebra.Etale.baseChange A₀ (R₀ k) B₀
        exact Algebra.Etale.comp A₀ B₀ (TensorProduct A₀ B₀ (R₀ k))
    have hEtM₀ : ∀ k : ℕ, Algebra.Etale M₀ (R₀ k) := fun k =>
      letI : Algebra.Etale A₀ (R₀ k) := hEtA k
      Algebra.Etale.comp M₀ A₀ (R₀ k)
    let copowerLift : ∀ (k : ℕ) {S : Type u} [CommRing S] [Algebra A₀ S],
        (Fin (k + 1) → (B₀ →ₐ[A₀] S)) → (R₀ k →ₐ[A₀] S) :=
      Nat.rec
        (fun {_} _ _ v => v 0)
        (fun _ ih {_} _ _ v =>
          Algebra.TensorProduct.lift (v 0) (ih (fun j => v j.succ)) (fun _ _ => Commute.all _ _))
    have hLiftSpec : ∀ (k : ℕ) {S : Type u} [CommRing S] [Algebra A₀ S]
        (v : Fin (k + 1) → (B₀ →ₐ[A₀] S)) (i : Fin (k + 1)),
        (copowerLift k v).comp (ι₀_A k i) = v i := by
      intro k
      induction k with
      | zero =>
        intro S _ _ v i
        have hi : i = 0 := Fin.eq_zero i
        subst hi
        exact AlgHom.comp_id (v 0)
      | succ k ih =>
        intro S _ _ v i
        refine Fin.cases ?_ ?_ i
        · exact Algebra.TensorProduct.lift_comp_includeLeft _ _ _
        · intro j
          change (copowerLift (k + 1) v).comp
              (Algebra.TensorProduct.includeRight.comp (ι₀_A k j)) = v j.succ
          rw [← AlgHom.comp_assoc]
          have hright : (copowerLift (k + 1) v).comp Algebra.TensorProduct.includeRight =
              copowerLift k (fun j => v j.succ) :=
            Algebra.TensorProduct.lift_comp_includeRight _ _ (fun _ _ => Commute.all _ _)
          rw [hright, ih]
    have hCopowerUniq : ∀ (k : ℕ) {S : Type u} [CommRing S] [Algebra A₀ S]
        (w₁ w₂ : R₀ k →ₐ[A₀] S),
        (∀ i : Fin (k + 1), w₁.comp (ι₀_A k i) = w₂.comp (ι₀_A k i)) → w₁ = w₂ := by
      intro k
      induction k with
      | zero =>
        intro S _ _ w₁ w₂ hw
        exact (AlgHom.comp_id w₁).symm.trans ((hw 0).trans (AlgHom.comp_id w₂))
      | succ k ih =>
        intro S _ _ w₁ w₂ hw
        apply Algebra.TensorProduct.ext
        · exact hw 0
        · change w₁.comp Algebra.TensorProduct.includeRight =
            w₂.comp Algebra.TensorProduct.includeRight
          exact ih _ _ (fun j => hw j.succ)
    let ι₀ : ∀ (k : ℕ), Fin (k + 1) → (B₀ →ₐ[M₀] R₀ k) :=
      fun k i => (ι₀_A k i).restrictScalars M₀
    let α₀ : ∀ (k : ℕ), A₀ →ₐ[M₀] R₀ k :=
      fun k => IsScalarTower.toAlgHom M₀ A₀ (R₀ k)
    let δ₀_A : ∀ {a b : SimplexCategory}, (a ⟶ b) → (R₀ a.len →ₐ[A₀] R₀ b.len) :=
      fun {a b} g => copowerLift a.len (fun i => ι₀_A b.len (g.toOrderHom i))
    let δ₀ : ∀ {a b : SimplexCategory}, (a ⟶ b) → (R₀ a.len →ₐ[M₀] R₀ b.len) :=
      fun g => (δ₀_A g).restrictScalars M₀
    refine ⟨R₀, instCR, instAlgM, hEtM₀, δ₀, ι₀, α₀, ?_, ?_, ?_, ?_, ?_⟩
    · intro a
      suffices h : δ₀_A (CategoryTheory.CategoryStruct.id a) = AlgHom.id A₀ (R₀ a.len) from
        congrArg (AlgHom.restrictScalars M₀) h
      apply hCopowerUniq a.len
      intro i
      rw [hLiftSpec, AlgHom.id_comp]
      rfl
    · intro a b c g₁ g₂
      suffices h : δ₀_A (CategoryTheory.CategoryStruct.comp g₁ g₂) =
          (δ₀_A g₂).comp (δ₀_A g₁) from
        congrArg (AlgHom.restrictScalars M₀) h
      apply hCopowerUniq a.len
      intro i
      rw [hLiftSpec, AlgHom.comp_assoc, hLiftSpec, hLiftSpec]
      rfl
    · intro k i
      ext a
      exact (ι₀_A k i).commutes a
    · intro a b g i
      exact congrArg (AlgHom.restrictScalars M₀) (hLiftSpec a.len _ i)
    · intro E _ _ k T _
      refine ⟨?_, ?_⟩
      · intro u_A u_B hu_compat
        let algAT : Algebra A₀ T :=
          (u_A.comp (Algebra.TensorProduct.includeRight
            (R := M₀) (A := E) (B := A₀)).toRingHom).toAlgebra
        let algMT : Algebra M₀ T :=
          RingHom.toAlgebra ((@algebraMap A₀ T _ _ algAT).comp (algebraMap M₀ A₀))
        let _ : Algebra A₀ T := algAT
        let _ : Algebra M₀ T := algMT
        have _ : IsScalarTower M₀ A₀ T := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
        let u_E : E →ₐ[M₀] T :=
          { (u_A.comp (Algebra.TensorProduct.includeLeftRingHom
              (R := M₀) (A := E) (B := A₀))) with
            commutes' := fun m => by
              change u_A ((algebraMap M₀ E m) ⊗ₜ[M₀] (1 : A₀)) =
                u_A ((1 : E) ⊗ₜ[M₀] (algebraMap M₀ A₀ m))
              rw [Algebra.algebraMap_eq_smul_one m, TensorProduct.smul_tmul,
                ← Algebra.algebraMap_eq_smul_one m] }
        let v_B : Fin (k + 1) → (B₀ →ₐ[A₀] T) := fun i =>
          { ((u_B i).comp (Algebra.TensorProduct.includeRight
              (R := M₀) (A := E) (B := B₀)).toRingHom) with
            commutes' := fun a => by
              change u_B i ((1 : E) ⊗ₜ[M₀] φ₀ a) = u_A ((1 : E) ⊗ₜ[M₀] a)
              exact RingHom.congr_fun (hu_compat i) ((1 : E) ⊗ₜ[M₀] a) }
        let v_R : R₀ k →ₐ[A₀] T := copowerLift k v_B
        let u : TensorProduct M₀ E (R₀ k) →+* T :=
          (Algebra.TensorProduct.lift u_E (v_R.restrictScalars M₀)
            (fun _ _ => Commute.all _ _)).toRingHom
        refine ⟨u, fun i => ?_⟩
        apply RingHom.ext
        intro z
        induction z using TensorProduct.induction_on with
        | zero => simp only [map_zero]
        | add x y ihx ihy => simp only [RingHom.comp_apply, map_add] at ihx ihy ⊢; rw [ihx, ihy]
        | tmul e b =>
          change (Algebra.TensorProduct.lift u_E (v_R.restrictScalars M₀)
              (fun _ _ => Commute.all _ _)) (e ⊗ₜ[M₀] (ι₀ k i b)) = u_B i (e ⊗ₜ[M₀] b)
          rw [Algebra.TensorProduct.lift_tmul]
          have hv : (v_R.restrictScalars M₀) (ι₀ k i b) = u_B i ((1 : E) ⊗ₜ[M₀] b) :=
            AlgHom.congr_fun (hLiftSpec k v_B i) b
          have he : u_E e = u_B i (e ⊗ₜ[M₀] (1 : B₀)) := by
            have h1 := (RingHom.congr_fun (hu_compat i) (e ⊗ₜ[M₀] (1 : A₀))).symm
            have h2 : (Algebra.TensorProduct.map (AlgHom.id E E) φ₀) (e ⊗ₜ[M₀] (1 : A₀)) =
                e ⊗ₜ[M₀] (1 : B₀) := by
              rw [Algebra.TensorProduct.map_tmul, AlgHom.id_apply, map_one]
            exact h1.trans (congrArg (u_B i) h2)
          rw [hv, he, ← map_mul, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      · intro u₁ u₂ hu
        have he_eq : ∀ e : E, u₁ (e ⊗ₜ[M₀] (1 : R₀ k)) = u₂ (e ⊗ₜ[M₀] (1 : R₀ k)) := by
          intro e
          have h0 := RingHom.congr_fun (hu 0) (e ⊗ₜ[M₀] (1 : B₀))
          simpa using h0
        have ha_eq : ∀ a : A₀, u₁ ((1 : E) ⊗ₜ[M₀] (α₀ k a)) = u₂ ((1 : E) ⊗ₜ[M₀] (α₀ k a)) := by
          intro a
          have h0 := RingHom.congr_fun (hu 0) ((1 : E) ⊗ₜ[M₀] (φ₀ a))
          have hanc : ι₀ k 0 (φ₀ a) = α₀ k a := (ι₀_A k 0).commutes a
          simpa [hanc] using h0
        let algAT₁ : Algebra A₀ T :=
          (u₁.comp ((Algebra.TensorProduct.includeRight
            (R := M₀) (A := E) (B := R₀ k)).toRingHom.comp (α₀ k).toRingHom)).toAlgebra
        let _ : Algebra A₀ T := algAT₁
        let w₁ : R₀ k →ₐ[A₀] T :=
          { (u₁.comp (Algebra.TensorProduct.includeRight
              (R := M₀) (A := E) (B := R₀ k)).toRingHom) with
            commutes' := fun _ => rfl }
        let w₂ : R₀ k →ₐ[A₀] T :=
          { (u₂.comp (Algebra.TensorProduct.includeRight
              (R := M₀) (A := E) (B := R₀ k)).toRingHom) with
            commutes' := fun a => (ha_eq a).symm }
        have hw_eq : w₁ = w₂ := by
          apply hCopowerUniq k w₁ w₂
          intro i
          ext b
          exact RingHom.congr_fun (hu i) ((1 : E) ⊗ₜ[M₀] b)
        apply RingHom.ext
        intro z
        induction z using TensorProduct.induction_on with
        | zero => simp only [map_zero]
        | add x y ihx ihy => simp only [map_add, ihx, ihy]
        | tmul e r =>
          have hmul : (e ⊗ₜ[M₀] r : TensorProduct M₀ E (R₀ k)) =
              (e ⊗ₜ[M₀] (1 : R₀ k)) * ((1 : E) ⊗ₜ[M₀] r) := by
            rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
          rw [hmul, map_mul, map_mul, he_eq e]
          congr 1
          exact AlgHom.congr_fun hw_eq r

  
  have hToRingPkg :
      ∃ (toRing : ∀ (Y : AlgebraicGeometry.Scheme.{u}) {R : Type u} [CommRing R],
          (Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of R)) →
            (R →+* ↥(Y.presheaf.obj (Opposite.op ⊤))))
        (ofRing : ∀ (Y : AlgebraicGeometry.Scheme.{u}) {R : Type u} [CommRing R],
          (R →+* ↥(Y.presheaf.obj (Opposite.op ⊤))) →
            (Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))),
        (∀ (Y : AlgebraicGeometry.Scheme.{u}) {R : Type u} [CommRing R]
          (φ : R →+* ↥(Y.presheaf.obj (Opposite.op ⊤))),
          toRing Y (ofRing Y φ) = φ) ∧
        (∀ (Y : AlgebraicGeometry.Scheme.{u}) {R : Type u} [CommRing R]
          {m₁ m₂ : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of R)},
          toRing Y m₁ = toRing Y m₂ → m₁ = m₂) ∧
        (∀ (Y : AlgebraicGeometry.Scheme.{u}) {R R' : Type u} [CommRing R] [CommRing R']
          (m : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
          (ψ : R' →+* R),
          toRing Y (m ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) =
            (toRing Y m).comp ψ) := by
    let toRing : ∀ (Y : AlgebraicGeometry.Scheme.{u}) {R : Type u} [CommRing R],
        (Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of R)) →
          (R →+* ↥(Y.presheaf.obj (Opposite.op ⊤))) :=
      fun Y {R} _ m =>
        (((AlgebraicGeometry.ΓSpec.adjunction.homEquiv Y
          (Opposite.op (CommRingCat.of R))).symm m).unop).hom
    let ofRing : ∀ (Y : AlgebraicGeometry.Scheme.{u}) {R : Type u} [CommRing R],
        (R →+* ↥(Y.presheaf.obj (Opposite.op ⊤))) →
          (Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of R)) :=
      fun Y {R} _ φ =>
        (AlgebraicGeometry.ΓSpec.adjunction.homEquiv Y
          (Opposite.op (CommRingCat.of R))) (Opposite.op (CommRingCat.ofHom φ))
    refine ⟨toRing, ofRing, ?_, ?_, ?_⟩
    · intro Y R _ φ
      exact congrArg (fun u => u.unop.hom)
        ((AlgebraicGeometry.ΓSpec.adjunction.homEquiv Y
          (Opposite.op (CommRingCat.of R))).symm_apply_apply (Opposite.op (CommRingCat.ofHom φ)))
    · intro Y R _ m₁ m₂ h
      apply (AlgebraicGeometry.ΓSpec.adjunction.homEquiv Y
        (Opposite.op (CommRingCat.of R))).symm.injective
      apply Opposite.unop_injective
      exact CommRingCat.hom_ext h
    · intro Y R R' _ _ m ψ
      exact congrArg (fun u => u.unop.hom)
        (AlgebraicGeometry.ΓSpec.adjunction.homEquiv_naturality_right_symm
          m (CommRingCat.ofHom ψ).op)
  obtain ⟨toRing, ofRing, hToOf, hToInj, hToComp⟩ := hToRingPkg

  have hStepNerve : ∀ (K_base E : Type u) [Field K_base] [Field E] [Algebra K_base E]
      (hEtSpec : AlgebraicGeometry.Etale
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K_base E))))
      (A_E B_E : Type u) [CommRing A_E] [CommRing B_E] [Algebra E A_E] [Algebra E B_E]
      [Algebra.Etale E A_E] [Algebra.Etale E B_E]
      (φ_E : A_E →ₐ[E] B_E)
      (R_E : ℕ → Type u) [∀ k, CommRing (R_E k)] [∀ k, Algebra E (R_E k)]
      [∀ k, Algebra.Etale E (R_E k)]
      (δ_E : ∀ {a b : SimplexCategory}, (a ⟶ b) → (R_E a.len →ₐ[E] R_E b.len))
      (ι_E : ∀ (k : ℕ), Fin (k + 1) → (B_E →ₐ[E] R_E k))
      (α_E : ∀ (k : ℕ), A_E →ₐ[E] R_E k),
      (∀ (k : ℕ) (i : Fin (k + 1)), (ι_E k i).comp φ_E = α_E k) →
      (∀ {a b : SimplexCategory} (g : a ⟶ b) (i : Fin (a.len + 1)),
        (δ_E g).comp (ι_E a.len i) = ι_E b.len (g.toOrderHom i)) →
      (∀ (k : ℕ) (T : Type u) [CommRing T],
        (∀ (u_A : A_E →+* T) (u_B : Fin (k + 1) → (B_E →+* T)),
          (∀ i : Fin (k + 1), (u_B i).comp φ_E.toRingHom = u_A) →
          ∃ (u : R_E k →+* T), ∀ i : Fin (k + 1), u.comp (ι_E k i).toRingHom = u_B i) ∧
        (∀ (u₁ u₂ : R_E k →+* T),
          (∀ i : Fin (k + 1), u₁.comp (ι_E k i).toRingHom = u₂.comp (ι_E k i).toRingHom) →
          u₁ = u₂)) →
      ∀ (U_K W_K : (AlgebraicGeometry.Spec (CommRingCat.of K_base)).Etale)
        (f_K : W_K ⟶ U_K)
        (e_UK : U_K ≅ (weilAltCdFieldEtaleMap hEtSpec).obj (weilAltCdSpecEtaleObj E A_E))
        (e_WK : W_K ≅ (weilAltCdFieldEtaleMap hEtSpec).obj (weilAltCdSpecEtaleObj E B_E)),
        CategoryTheory.CategoryStruct.comp f_K e_UK.hom =
          CategoryTheory.CategoryStruct.comp e_WK.hom
            ((weilAltCdFieldEtaleMap hEtSpec).map (weilAltCdSpecEtaleMap E φ_E)) →
        ∃ (e : ∀ a : SimplexCategory,
            ((CategoryTheory.Arrow.mk f_K).cechNerve.obj (Opposite.op a)) ≅
              (weilAltCdFieldEtaleMap hEtSpec).obj (weilAltCdSpecEtaleObj E (R_E a.len))),
          ∀ {a b : SimplexCategory} (g : a ⟶ b),
            CategoryTheory.CategoryStruct.comp
              ((CategoryTheory.Arrow.mk f_K).cechNerve.map g.op) (e a).hom =
            CategoryTheory.CategoryStruct.comp (e b).hom
              ((weilAltCdFieldEtaleMap hEtSpec).map (weilAltCdSpecEtaleMap E (δ_E g))) := by
    intro K_base E _ _ _ hEtSpec A_E B_E _ _ _ _ _ _ φ_E R_E _ _ _ δ_E ι_E α_E
      hAnchor hSimp hUniv U_K W_K f_K e_UK e_WK hf_K
    let F := weilAltCdFieldEtaleMap hEtSpec
    have hf_inv : e_WK.inv ≫ f_K =
        F.map (weilAltCdSpecEtaleMap E φ_E) ≫ e_UK.inv := by
      rw [Iso.inv_comp_eq, ← Category.assoc, Iso.eq_comp_inv]
