      (q_snd : ∀ a b : Fin m, Q_B b →+ Q_C a b)
      (κ_A : ∀ i : I, G_A i →+ Q_A)
      (κ_B : ∀ (a : Fin m) (i : I), G_B a i →+ Q_B a)
      (κ_C : ∀ (a b : Fin m) (i : I), G_C a b i →+ Q_C a b),
