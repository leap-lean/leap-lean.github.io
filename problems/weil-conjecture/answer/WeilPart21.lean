      obtain ⟨z, rfl⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ X₀ hS_Y x hx0 rfl
      let hSFG : (S_Y.map FG).ShortExact := hS_Y.map_of_exact FG
      let hSF : (S_Y.map F).ShortExact := hS_Y.map_of_exact F
      let hSGF : ((S_Y.map F).map G).ShortExact := hSF.map_of_exact G
      let φ_S : (S_Y.map F).map G ⟶ S_Y.map FG :=
        { τ₁ := e_inv Y₀
          τ₂ := e_inv S_Y.X₂
          τ₃ := e_inv S_Y.X₃
          comm₁₂ := (he_inv_nat S_Y.f).symm
          comm₂₃ := (he_inv_nat S_Y.g).symm }
      have h_nat : hSGF.extClass.comp (CategoryTheory.Abelian.Ext.mk₀ (e_inv Y₀))
            (Nat.add_zero 1) =
          (CategoryTheory.Abelian.Ext.mk₀ (e_inv S_Y.X₃)).comp hSFG.extClass
            (Nat.zero_add 1) :=
        CategoryTheory.ShortComplex.ShortExact.extClass_naturality hSGF hSFG φ_S
      rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass, ih z,
        CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ (e_hom X₀)) _
          hSFG.extClass (Nat.zero_add n) rfl (Nat.zero_add (n + 1)),
        CategoryTheory.Abelian.Ext.comp_assoc
          (CategoryTheory.Abelian.Ext.mapExactFunctor G
            (CategoryTheory.Abelian.Ext.mapExactFunctor F z))
          (CategoryTheory.Abelian.Ext.mk₀ (e_inv S_Y.X₃)) hSFG.extClass
          (Nat.add_zero n) (Nat.zero_add 1) rfl,
        ← h_nat,
        ← CategoryTheory.Abelian.Ext.comp_assoc
          (CategoryTheory.Abelian.Ext.mapExactFunctor G
            (CategoryTheory.Abelian.Ext.mapExactFunctor F z))
          hSGF.extClass (CategoryTheory.Abelian.Ext.mk₀ (e_inv Y₀))
          rfl (Nat.add_zero 1) (Nat.add_zero (n + 1)),
