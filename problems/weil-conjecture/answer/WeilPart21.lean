                  (fun _ : Fin (a.len + 1) => W_K) (fun _ : Fin (a.len + 1) => f_K)).map
                  (CategoryTheory.Limits.WidePullbackShape.Hom.term i₀) = f_K := by simp
              have hsw : s.π.app (some i₀) ≫ f_K = s.π.app none := by
                simpa [hterm] using s.w (CategoryTheory.Limits.WidePullbackShape.Hom.term i₀)
