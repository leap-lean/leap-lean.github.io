        dY ≫ η₁.hom = η₂.hom ≫ dZ →
        m ≫ (e₁.trans η₁).hom = (e₂.trans η₂).hom ≫ dZ := by
      intro 𝒞 _ X₁ X₂ Y₁ Y₂ Z₁ Z₂ m e₁ e₂ η₁ η₂ dY dZ hm hd
      rw [Iso.trans_hom, Iso.trans_hom, ← Category.assoc, hm,
        Category.assoc, hd, Category.assoc]
    have hCompIso : ∀ {𝒞 : Type (u + 1)} [CategoryTheory.Category.{u} 𝒞]
        {X₁ X₂ Y₁ Y₂ Z₁ Z₂ : 𝒞}
        (m : X₂ ⟶ X₁) (e₁ : X₁ ≅ Y₁) (e₂ : X₂ ≅ Y₂)
        (η₁ : Z₁ ≅ Y₁) (η₂ : Z₂ ≅ Y₂)
        (dY : Y₂ ⟶ Y₁) (dZ : Z₂ ⟶ Z₁),
        m ≫ e₁.hom = e₂.hom ≫ dY →
        dY ≫ η₁.inv = η₂.inv ≫ dZ →
        m ≫ (e₁.trans η₁.symm).hom = (e₂.trans η₂.symm).hom ≫ dZ := by
      intro 𝒞 _ X₁ X₂ Y₁ Y₂ Z₁ Z₂ m e₁ e₂ η₁ η₂ dY dZ hm hd
      rw [Iso.trans_hom, Iso.trans_hom, Iso.symm_hom, Iso.symm_hom,
        ← Category.assoc, hm, Category.assoc, hd, Category.assoc]
    have hEtSpec_L : AlgebraicGeometry.Etale
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap L L))) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
        (RingHom.etale_algebraMap.mpr inferInstance)
    let F_L := weilAltCdFieldEtaleMap hEtSpec_L
    have hid_L : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap L L)) =
        CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of L)) := by
      have h1 : CommRingCat.ofHom (algebraMap L L) =
          CategoryTheory.CategoryStruct.id (CommRingCat.of L) := rfl
      rw [h1, AlgebraicGeometry.Spec.map_id]
    obtain ⟨η_FL, hη_hom, hη_inv⟩ := hIdFieldMap hEtSpec_L hid_L
    let φ_L := Algebra.TensorProduct.map (AlgHom.id L L) φ₀
    let δ_L : ∀ {a b : SimplexCategory}, (a ⟶ b) →
        (TensorProduct M_base L (R₀ a.len) →ₐ[L] TensorProduct M_base L (R₀ b.len)) :=
      fun g => Algebra.TensorProduct.map (AlgHom.id L L) (δ₀ g)
    let ι_L : ∀ (k : ℕ), Fin (k + 1) →
        (TensorProduct M_base L B₀ →ₐ[L] TensorProduct M_base L (R₀ k)) :=
      fun k i => Algebra.TensorProduct.map (AlgHom.id L L) (ι₀ k i)
    let α_L : ∀ (k : ℕ),
        TensorProduct M_base L A₀ →ₐ[L] TensorProduct M_base L (R₀ k) :=
      fun k => Algebra.TensorProduct.map (AlgHom.id L L) (α₀ k)
    have hf_FL : CategoryTheory.CategoryStruct.comp f_L (e_UL.trans (η_FL _)).hom =
        CategoryTheory.CategoryStruct.comp (e_WL.trans (η_FL _)).hom
          (F_L.map (weilAltCdSpecEtaleMap L φ_L)) :=
      hPreIso f_L e_UL e_WL (η_FL _) (η_FL _)
        (weilAltCdSpecEtaleMap L φ_L) (F_L.map (weilAltCdSpecEtaleMap L φ_L))
        hf_L (hη_hom (weilAltCdSpecEtaleMap L φ_L))
    obtain ⟨e'_L, he'_L⟩ := hStepNerve L L hEtSpec_L
      (TensorProduct M_base L A₀) (TensorProduct M_base L B₀) φ_L
      (fun k => TensorProduct M_base L (R₀ k)) δ_L ι_L α_L
      hBaseAnchorL hBaseSimpL hUnivL
      U_L W_L f_L (e_UL.trans (η_FL _)) (e_WL.trans (η_FL _)) hf_FL
    refine ⟨fun a => (e'_L a).trans (η_FL _).symm, fun {a b} g => ?_⟩
    exact hCompIso ((CategoryTheory.Arrow.mk f_L).cechNerve.map g.op)
      (e'_L a) (e'_L b) (η_FL _) (η_FL _)
      (F_L.map (weilAltCdSpecEtaleMap L (δ_L g))) (weilAltCdSpecEtaleMap L (δ_L g))
      (he'_L g) (hη_inv (weilAltCdSpecEtaleMap L (δ_L g)))

  have hStageGen : ∀ (M_base K_base E : Type u) [Field M_base] [Field K_base] [Field E]
      [Algebra M_base E] [Algebra K_base E]
      (hEtSpec : AlgebraicGeometry.Etale
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K_base E))))
      (A_b B_b : Type u) [CommRing A_b] [CommRing B_b]
      [Algebra M_base A_b] [Algebra M_base B_b]
      [Algebra.Etale M_base A_b] [Algebra.Etale M_base B_b]
      (φ_b : A_b →ₐ[M_base] B_b)
      (R_b : ℕ → Type u) [∀ k, CommRing (R_b k)] [∀ k, Algebra M_base (R_b k)]
      [∀ k, Algebra.Etale M_base (R_b k)]
      (δ_b : ∀ {a b : SimplexCategory}, (a ⟶ b) → (R_b a.len →ₐ[M_base] R_b b.len))
      (ι_b : ∀ (k : ℕ), Fin (k + 1) → (B_b →ₐ[M_base] R_b k))
      (α_b : ∀ (k : ℕ), A_b →ₐ[M_base] R_b k),
      (∀ (k : ℕ) (i : Fin (k + 1)),
        (Algebra.TensorProduct.map (AlgHom.id E E) (ι_b k i)).comp
          (Algebra.TensorProduct.map (AlgHom.id E E) φ_b) =
        Algebra.TensorProduct.map (AlgHom.id E E) (α_b k)) →
      (∀ {a b : SimplexCategory} (g : a ⟶ b) (i : Fin (a.len + 1)),
        (Algebra.TensorProduct.map (AlgHom.id E E) (δ_b g)).comp
          (Algebra.TensorProduct.map (AlgHom.id E E) (ι_b a.len i)) =
        Algebra.TensorProduct.map (AlgHom.id E E) (ι_b b.len (g.toOrderHom i))) →
      (∀ (k : ℕ) (T : Type u) [CommRing T],
        (∀ (u_A : TensorProduct M_base E A_b →+* T)
           (u_B : Fin (k + 1) → (TensorProduct M_base E B_b →+* T)),
          (∀ i : Fin (k + 1),
            (u_B i).comp (Algebra.TensorProduct.map (AlgHom.id E E) φ_b).toRingHom = u_A) →
          ∃ (u : TensorProduct M_base E (R_b k) →+* T),
            ∀ i : Fin (k + 1),
              u.comp (Algebra.TensorProduct.map (AlgHom.id E E) (ι_b k i)).toRingHom = u_B i) ∧
        (∀ (u₁ u₂ : TensorProduct M_base E (R_b k) →+* T),
          (∀ i : Fin (k + 1),
            u₁.comp (Algebra.TensorProduct.map (AlgHom.id E E) (ι_b k i)).toRingHom =
              u₂.comp (Algebra.TensorProduct.map (AlgHom.id E E) (ι_b k i)).toRingHom) →
          u₁ = u₂)) →
      ∃ (f_E : CategoryTheory.Arrow (AlgebraicGeometry.Spec (CommRingCat.of K_base)).Etale)
        (e_E : ∀ a : SimplexCategory,
          (f_E.cechNerve.obj (Opposite.op a)) ≅
            (weilAltCdFieldEtaleMap hEtSpec).obj
              (weilAltCdSpecEtaleObj E (TensorProduct M_base E (R_b a.len)))),
        ∀ {a b : SimplexCategory} (g : a ⟶ b),
          CategoryTheory.CategoryStruct.comp (f_E.cechNerve.map g.op) (e_E a).hom =
          CategoryTheory.CategoryStruct.comp (e_E b).hom
            ((weilAltCdFieldEtaleMap hEtSpec).map (weilAltCdSpecEtaleMap E
              (Algebra.TensorProduct.map (AlgHom.id E E) (δ_b g)))) := by
    intro M_base K_base E _ _ _ _ _ hEtSpec A_b B_b _ _ _ _ _ _ φ_b R_b _ _ _ δ_b ι_b α_b
      hAnc_E hSimp_E hUniv_E
    let F_E := weilAltCdFieldEtaleMap hEtSpec
    let φ_E := Algebra.TensorProduct.map (AlgHom.id E E) φ_b
    let U_KE := F_E.obj (weilAltCdSpecEtaleObj E (TensorProduct M_base E A_b))
    let W_KE := F_E.obj (weilAltCdSpecEtaleObj E (TensorProduct M_base E B_b))
    let f_KE : W_KE ⟶ U_KE := F_E.map (weilAltCdSpecEtaleMap E φ_E)
    obtain ⟨e_E, he_E⟩ := hStepNerve K_base E hEtSpec
      (TensorProduct M_base E A_b) (TensorProduct M_base E B_b) φ_E
      (fun k => TensorProduct M_base E (R_b k))
      (fun g => Algebra.TensorProduct.map (AlgHom.id E E) (δ_b g))
      (fun k i => Algebra.TensorProduct.map (AlgHom.id E E) (ι_b k i))
      (fun k => Algebra.TensorProduct.map (AlgHom.id E E) (α_b k))
      hAnc_E hSimp_E hUniv_E
      U_KE W_KE f_KE (Iso.refl U_KE) (Iso.refl W_KE)
      ((Category.comp_id f_KE).trans (Category.id_comp f_KE).symm)
    exact ⟨CategoryTheory.Arrow.mk f_KE, e_E, he_E⟩

  obtain ⟨M₀, hFD₀, A₀, B₀, hCR_A₀, hCR_B₀, hAlg_A₀, hAlg_B₀, hEt_A₀, hEt_B₀,
    φ₀, e_U, e_W, hf⟩ := hStepArrow
  let _ : CommRing A₀ := hCR_A₀
  let _ : CommRing B₀ := hCR_B₀
  let _ : Algebra ↥M₀ A₀ := hAlg_A₀
  let _ : Algebra ↥M₀ B₀ := hAlg_B₀
  let _ : Algebra.Etale ↥M₀ A₀ := hEt_A₀
  let _ : Algebra.Etale ↥M₀ B₀ := hEt_B₀
  obtain ⟨R₀, hCR_R₀, hAlg_R₀, hEt_R₀, δ₀, ι₀, α₀,
    hδ_id, hδ_comp, hAnchor₀, hSimp₀, hUniv₀⟩ := hStepCopower ↥M₀ A₀ B₀ φ₀
  let _ : ∀ k, CommRing (R₀ k) := hCR_R₀
  let _ : ∀ k, Algebra ↥M₀ (R₀ k) := hAlg_R₀
  let _ : ∀ k, Algebra.Etale ↥M₀ (R₀ k) := hEt_R₀
  have hBaseAnchor : ∀ (E : Type u) [CommRing E] [Algebra ↥M₀ E] (k : ℕ) (i : Fin (k + 1)),
      (Algebra.TensorProduct.map (AlgHom.id E E) (ι₀ k i)).comp
        (Algebra.TensorProduct.map (AlgHom.id E E) φ₀) =
      Algebra.TensorProduct.map (AlgHom.id E E) (α₀ k) := by
    intro E _ _ k i
    rw [← Algebra.TensorProduct.map_comp, AlgHom.id_comp, hAnchor₀ k i]
  have hBaseSimp : ∀ (E : Type u) [CommRing E] [Algebra ↥M₀ E]
      {a b : SimplexCategory} (g : a ⟶ b) (i : Fin (a.len + 1)),
      (Algebra.TensorProduct.map (AlgHom.id E E) (δ₀ g)).comp
        (Algebra.TensorProduct.map (AlgHom.id E E) (ι₀ a.len i)) =
      Algebra.TensorProduct.map (AlgHom.id E E) (ι₀ b.len (g.toOrderHom i)) := by
    intro E _ _ a b g i
    rw [← Algebra.TensorProduct.map_comp, AlgHom.id_comp, hSimp₀ g i]
  refine ⟨M₀, hFD₀, R₀, hCR_R₀, hAlg_R₀, hEt_R₀, δ₀, hδ_id, hδ_comp, ?_, ?_⟩
  · exact hStageL ↥M₀ L_inf A₀ B₀ φ₀ R₀ δ₀ ι₀ α₀
      (fun k i => hBaseAnchor L_inf k i)
      (fun g i => hBaseSimp L_inf g i)
      (fun k T _ => hUniv₀ L_inf k T)
      U W f e_U e_W hf
  · intro M hFD hle
    let _ : Algebra K ↥M := RingHom.toAlgebra ((algebraMap F₀ ↥M).comp (algebraMap K F₀))
    let _ : Algebra.Etale K ↥M := hEtM M hFD
    let _ : Algebra ↥M₀ ↥M := (IntermediateField.inclusion hle).toRingHom.toAlgebra
    let hEtSpec : AlgebraicGeometry.Etale
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K ↥M))) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
        (RingHom.etale_algebraMap.mpr inferInstance)
    exact hStageGen ↥M₀ K ↥M hEtSpec A₀ B₀ φ₀ R₀ δ₀ ι₀ α₀
      (fun k i => hBaseAnchor ↥M k i)
      (fun g i => hBaseSimp ↥M g i)
      (fun k T _ => hUniv₀ ↥M k T)

theorem weil_alt_cd_separable_union_pullback_eval_colimit (K F₀ L_inf : Type u) [Field K] [Field F₀] [Field L_inf]
    [Algebra K F₀] [FiniteDimensional K F₀] [Algebra.IsSeparable K F₀] [Algebra.Etale K F₀]
    [Algebra F₀ L_inf] [Algebra.IsSeparable F₀ L_inf]
    (hEtM : ∀ (M : IntermediateField F₀ L_inf), FiniteDimensional F₀ ↥M →
      letI : Algebra K ↥M := RingHom.toAlgebra ((algebraMap F₀ ↥M).comp (algebraMap K F₀))
      Algebra.Etale K ↥M)
    (hDescObj : ∀ (A_inf : Type u) [CommRing A_inf] [Algebra L_inf A_inf] [Algebra.Etale L_inf A_inf],
      ∃ (M₀ : IntermediateField F₀ L_inf) (_ : FiniteDimensional F₀ ↥M₀)
        (A₀ : Type u) (_ : CommRing A₀) (_ : Algebra ↥M₀ A₀) (_ : Algebra.Etale ↥M₀ A₀),
        Nonempty (TensorProduct ↥M₀ L_inf A₀ ≃ₐ[L_inf] A_inf))
    (hDescHom : ∀ (M₀ : IntermediateField F₀ L_inf), FiniteDimensional F₀ ↥M₀ →
      ∀ (A₀ : Type u) [CommRing A₀] [Algebra ↥M₀ A₀],
        (∀ (M : IntermediateField F₀ L_inf) (hle : M₀ ≤ M),
          letI : Algebra ↥M₀ ↥M := (IntermediateField.inclusion hle).toRingHom.toAlgebra
          letI : IsScalarTower ↥M₀ ↥M L_inf := IsScalarTower.of_algebraMap_eq' rfl
          Function.Injective
            (Algebra.TensorProduct.map (IsScalarTower.toAlgHom ↥M₀ ↥M L_inf)
              (AlgHom.id ↥M₀ A₀))) ∧
        (∀ (C : Type u) [CommRing C] [Algebra K C] [Algebra.FiniteType K C]
            (ψ : C →+* TensorProduct ↥M₀ L_inf A₀),
          (∀ c : K, ψ (algebraMap K C c) =
            algebraMap ↥M₀ (TensorProduct ↥M₀ L_inf A₀)
              (algebraMap F₀ ↥M₀ (algebraMap K F₀ c))) →
          ∃ (M₁ : IntermediateField F₀ L_inf) (_ : FiniteDimensional F₀ ↥M₁) (hle : M₀ ≤ M₁),
            letI : Algebra ↥M₀ ↥M₁ := (IntermediateField.inclusion hle).toRingHom.toAlgebra
            letI : IsScalarTower ↥M₀ ↥M₁ L_inf := IsScalarTower.of_algebraMap_eq' rfl
            ∃ (ψ₁ : C →+* TensorProduct ↥M₀ ↥M₁ A₀),
              (∀ c : K, ψ₁ (algebraMap K C c) =
                algebraMap ↥M₀ (TensorProduct ↥M₀ ↥M₁ A₀)
                  (algebraMap F₀ ↥M₀ (algebraMap K F₀ c))) ∧
              (Algebra.TensorProduct.map (IsScalarTower.toAlgHom ↥M₀ ↥M₁ L_inf)
                (AlgHom.id ↥M₀ A₀)).toRingHom.comp ψ₁ = ψ))
    (hDescSurj : ∀ (M₀ : IntermediateField F₀ L_inf), FiniteDimensional F₀ ↥M₀ →
      ∀ (A₀ B₀ : Type u) [CommRing A₀] [CommRing B₀] [Algebra ↥M₀ A₀] [Algebra ↥M₀ B₀]
        (φ₀ : A₀ →ₐ[↥M₀] B₀),
        Function.Surjective
          (PrimeSpectrum.comap (Algebra.TensorProduct.map (AlgHom.id L_inf L_inf) φ₀).toRingHom) →
        Function.Surjective (PrimeSpectrum.comap φ₀.toRingHom))
    (hInjCech : ∀ (X : AlgebraicGeometry.Scheme.{u})
        (ℐ : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u})
        [CategoryTheory.Injective ℐ]
        (f : CategoryTheory.Arrow X.Etale) (p : ℕ),
      1 ≤ p →
      (AlgebraicTopology.AlternatingCofaceMapComplex.obj
        (CategoryTheory.Functor.comp (CategoryTheory.opOp SimplexCategory)
          (CategoryTheory.Functor.comp f.cechNerve.op ℐ.obj))).ExactAt p) :
    ∃ (P_inf : CategoryTheory.Functor
          (CategoryTheory.Sheaf
            (AlgebraicGeometry.Spec (CommRingCat.of K)).smallEtaleTopology AddCommGrpCat.{u})
          (CategoryTheory.Sheaf
            (AlgebraicGeometry.Spec (CommRingCat.of L_inf)).smallEtaleTopology AddCommGrpCat.{u}))
      (_ : P_inf.Additive)
      (_ : CategoryTheory.Limits.PreservesFiniteLimits P_inf)
      (_ : CategoryTheory.Limits.PreservesFiniteColimits P_inf)
      (ι_glob : ∀ (𝒢 : CategoryTheory.Sheaf
            (AlgebraicGeometry.Spec (CommRingCat.of K)).smallEtaleTopology AddCommGrpCat.{u})
          (M : IntermediateField F₀ L_inf) (hFD : FiniteDimensional F₀ ↥M),
        letI : Algebra K ↥M := RingHom.toAlgebra ((algebraMap F₀ ↥M).comp (algebraMap K F₀))
        letI : Algebra.Etale K ↥M := hEtM M hFD
        ↥(𝒢.obj.obj (Opposite.op (weilAltCdSpecEtaleObj K ↥M))) →+
          ↥((P_inf.obj 𝒢).obj.obj (Opposite.op (weilAltCdSpecEtaleObj L_inf L_inf)))),
      (∀ {𝒢₁ 𝒢₂ : CategoryTheory.Sheaf
            (AlgebraicGeometry.Spec (CommRingCat.of K)).smallEtaleTopology AddCommGrpCat.{u}}
          (φ : 𝒢₁ ⟶ 𝒢₂)
          (M : IntermediateField F₀ L_inf) (hFD : FiniteDimensional F₀ ↥M),
        letI : Algebra K ↥M := RingHom.toAlgebra ((algebraMap F₀ ↥M).comp (algebraMap K F₀))
        letI : Algebra.Etale K ↥M := hEtM M hFD
        ∀ (x : ↥(𝒢₁.obj.obj (Opposite.op (weilAltCdSpecEtaleObj K ↥M)))),
          ι_glob 𝒢₂ M hFD ((φ.hom.app (Opposite.op (weilAltCdSpecEtaleObj K ↥M))).hom x) =
            (((P_inf.map φ).hom.app (Opposite.op (weilAltCdSpecEtaleObj L_inf L_inf))).hom
              (ι_glob 𝒢₁ M hFD x))) ∧
      (∀ (𝒢 : CategoryTheory.Sheaf
            (AlgebraicGeometry.Spec (CommRingCat.of K)).smallEtaleTopology AddCommGrpCat.{u})
          (M₁ M₂ : IntermediateField F₀ L_inf)
          (hFD₁ : FiniteDimensional F₀ ↥M₁) (hFD₂ : FiniteDimensional F₀ ↥M₂)
          (hle : M₁ ≤ M₂),
        letI : Algebra K ↥M₁ := RingHom.toAlgebra ((algebraMap F₀ ↥M₁).comp (algebraMap K F₀))
        letI : Algebra K ↥M₂ := RingHom.toAlgebra ((algebraMap F₀ ↥M₂).comp (algebraMap K F₀))
        letI : Algebra.Etale K ↥M₁ := hEtM M₁ hFD₁
        letI : Algebra.Etale K ↥M₂ := hEtM M₂ hFD₂
        let ι₁₂ : ↥M₁ →ₐ[K] ↥M₂ :=
          { (IntermediateField.inclusion hle).toRingHom with commutes' := fun _ => rfl }
        ∀ (x : ↥(𝒢.obj.obj (Opposite.op (weilAltCdSpecEtaleObj K ↥M₁)))),
          ι_glob 𝒢 M₂ hFD₂ ((𝒢.obj.map (weilAltCdSpecEtaleMap K ι₁₂).op).hom x) =
            ι_glob 𝒢 M₁ hFD₁ x) ∧
