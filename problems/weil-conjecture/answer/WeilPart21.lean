            (congrArg (toRing Z.left) hq_left)
        let u : R_E a.len →+* T_Z :=
          Classical.choose ((hUniv a.len T_Z).1 u_A u_B hu_compat)
        have hu : ∀ i : Fin (a.len + 1), u.comp (ι_E a.len i).toRingHom = u_B i :=
          Classical.choose_spec ((hUniv a.len T_Z).1 u_A u_B hu_compat)
        have h_tri : ofRing Z.left u ≫ (X a.len).hom = Z.hom := by
          apply hToInj Z.left
          have h1 : toRing Z.left (ofRing Z.left u ≫
