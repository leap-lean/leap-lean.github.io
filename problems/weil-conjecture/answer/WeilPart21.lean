      adj_S.comp adj_w
    let adj₂ : C_X ⊣ (P_push.comp
        ((CategoryTheory.sheafSections J_S AddCommGrpCat.{u}).obj (Opposite.op T_S))) :=
      adj_X.ofNatIsoRight α_R
    let ρ_A : R_w.obj (C_S.obj A) ⟶ C_X.obj A :=
      (adj_w.homEquiv (C_S.obj A) (C_X.obj A)).symm
        ((adj_S.homEquiv A (P_push.obj (C_X.obj A))).symm
          (adj_X.unit.app A ≫ (C_X.obj A).obj.map τ_w.op))
    have hρ_eq_uniq : ρ_A = (CategoryTheory.Adjunction.leftAdjointUniq adj₁ adj₂).hom.app A := by
      apply (adj₁.homEquiv A (C_X.obj A)).injective
      have h1 : adj₁.homEquiv A (C_X.obj A)
          ((CategoryTheory.Adjunction.leftAdjointUniq adj₁ adj₂).hom.app A) = adj₂.unit.app A :=
        CategoryTheory.Adjunction.unit_leftAdjointUniq_hom_app adj₁ adj₂ A
      have h2 : adj₁.homEquiv A (C_X.obj A) ρ_A =
