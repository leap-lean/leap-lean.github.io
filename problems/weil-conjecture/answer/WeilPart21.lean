          h𝒢_comp e_pb_K.hom (map_snd a b) (x_sec b), hx_sec a b]
      rcases h𝒢_arr x_sec h_compat with ⟨z, hz, _⟩
      exact ⟨z, hz⟩
    · intro z₁ z₂ hz_eq
      let x₀ : ∀ a : Fin m, 𝒢_type.obj (Opposite.op (W_B a)) :=
        fun a => (𝒢₀.obj.map (p_KE a).op).hom z₁
      have hx₀ : CategoryTheory.Presieve.Arrows.PullbackCompatible 𝒢_type p_KE x₀ := by
        intro a b
        change (𝒢₀.obj.map (CategoryTheory.Limits.pullback.fst (p_KE a) (p_KE b)).op).hom
            ((𝒢₀.obj.map (p_KE a).op).hom z₁) =
