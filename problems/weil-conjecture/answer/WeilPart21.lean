        a = a ≫ pb_g.map (πℤ_π ≫ ιℤ_π) := by
              rw [hιπ2, pb_g.map_id, CategoryTheory.Category.comp_id]
        _ = (a ≫ pb_g.map πℤ_π) ≫ pb_g.map ιℤ_π := by
              rw [pb_g.map_comp, ← CategoryTheory.Category.assoc]
