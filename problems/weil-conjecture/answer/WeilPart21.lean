        rw [hδ₂ V (((pf_f.map _Φ.φ₂).hom.app (Opposite.op V)) s), hRep_comm,
          ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ ψ₁ _Φ.φ₂]
        exact congrArg ((adj_sh_S.unit.app P_F₂).app (Opposite.op V))
          (hUpstairs_comm (Nat.zero_add 1) (Nat.one_add 1) (CategoryTheory.Abelian.Ext.mk₀ ψ₁))
      have hβ_app : (β_pre.app (Opposite.op V)) t₁ =
          t₁.comp (CategoryTheory.Abelian.Ext.mk₀ φ) (Nat.add_zero 2) := by
        have hmap_φ := CategoryTheory.Abelian.extFunctorObj_map
          (weilPolyP1CohomologyRepSheaf Y U_V) 2 φ
        exact congrArg (fun γ => γ t₁) hmap_φ
      have hUnit_nat := congrArg
        (fun (γ : P_F₁ ⟶ U_S.obj (Sh_S.obj P_F₂)) => (γ.app (Opposite.op V)) t₁)
        (adj_sh_S.unit.naturality β_pre)
      have hRHS : ((δ_bar₁ ≫ weilPolyP1HigherDirectImageMap f 2 φ).hom.app (Opposite.op V)) s =
          ((adj_sh_S.unit.app P_F₂).app (Opposite.op V))
            (t₁.comp (CategoryTheory.Abelian.Ext.mk₀ φ) (Nat.add_zero 2)) := by
        change ((weilPolyP1HigherDirectImageMap f 2 φ).hom.app (Opposite.op V))
            ((δ_bar₁.hom.app (Opposite.op V)) s) = _
        rw [hδ₁ V s]
        exact hUnit_nat.symm.trans (congrArg ((adj_sh_S.unit.app P_F₂).app (Opposite.op V)) hβ_app)
      exact hLHS.trans hRHS.symm

    
    obtain ⟨z, rfl⟩ := hSurj₁ x
    let z₂ : (pf_f.obj R₂.Q₂).H (2 * δ) :=
      z.comp (CategoryTheory.Abelian.Ext.mk₀ (pf_f.map _Φ.φ₂)) (Nat.add_zero (2 * δ))
    have hΘ_comm :
        weilTwoStepTheta sys δ R₂ z₂ =
          ((CategoryTheory.Abelian.Ext.mk₀ φ).postcomp Fℤ_Y (Nat.add_zero (2 * (δ + 1))))
            (weilTwoStepTheta sys δ R₁ z) := by
      have hΛ := hLerayNat f _Φ.φ₂ (2 * δ) z
      let pb_f := (weilEtaleSitePullback f).sheafPullback
        AddCommGrpCat.{u} S.smallEtaleTopology Y.smallEtaleTopology
      let adj_f := (weilEtaleSitePullback f).sheafAdjunctionContinuous
        AddCommGrpCat.{u} S.smallEtaleTopology Y.smallEtaleTopology
      let hT_Y := weilEtaleIdTerminalIsTerminal.{u} Y
      let hT_S := weilEtaleIdTerminalIsTerminal.{u} S
      let ιℤ_f : Quiver.Hom Fℤ_Y (pb_f.obj Fℤ_S) :=
        @CategoryTheory.inv _ _ _ _ (weilEtaleConstPullbackHom f hT_Y hT_S Aℤ)
          ((sys f).hConstIso hT_Y hT_S Aℤ)
      let w₁ : R₁.Q₂.H (2 * δ) :=
        (((CategoryTheory.Abelian.Ext.mk₀ (adj_f.counit.app R₁.Q₂)).postcomp Fℤ_Y
            (Nat.add_zero (2 * δ))).comp
          (((CategoryTheory.Abelian.Ext.mk₀ ιℤ_f).precomp (pb_f.obj (pf_f.obj R₁.Q₂))
              (Nat.zero_add (2 * δ))).comp
            (@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ pb_f _ _ _ _ _
              Fℤ_S (pf_f.obj R₁.Q₂) (2 * δ)))) z
      let w₂ : R₂.Q₂.H (2 * δ) :=
        (((CategoryTheory.Abelian.Ext.mk₀ (adj_f.counit.app R₂.Q₂)).postcomp Fℤ_Y
            (Nat.add_zero (2 * δ))).comp
          (((CategoryTheory.Abelian.Ext.mk₀ ιℤ_f).precomp (pb_f.obj (pf_f.obj R₂.Q₂))
              (Nat.zero_add (2 * δ))).comp
            (@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ pb_f _ _ _ _ _
              Fℤ_S (pf_f.obj R₂.Q₂) (2 * δ)))) z₂
      change (w₂.comp R₂.hSE₁.extClass rfl).comp R₂.hSE₀.extClass rfl =
        ((w₁.comp R₁.hSE₁.extClass rfl).comp R₁.hSE₀.extClass rfl).comp
          (CategoryTheory.Abelian.Ext.mk₀ φ) (Nat.add_zero (2 * (δ + 1)))
      have hw₂ : w₂ = w₁.comp (CategoryTheory.Abelian.Ext.mk₀ _Φ.φ₂) (Nat.add_zero (2 * δ)) := hΛ
      rw [hw₂]
      exact hUpstairs_comm rfl rfl w₁
    have hδ_comm :
        weilTwoStepDeltaBarMapH S δ δ_bar₂ z₂ =
          (CategoryTheory.Abelian.Ext.mk₀ (weilPolyP1HigherDirectImageMap f 2 φ)).postcomp
            Fℤ_S (Nat.add_zero (2 * δ)) (weilTwoStepDeltaBarMapH S δ δ_bar₁ z) := by
      change (z.comp (CategoryTheory.Abelian.Ext.mk₀ (pf_f.map _Φ.φ₂))
          (Nat.add_zero (2 * δ))).comp (CategoryTheory.Abelian.Ext.mk₀ δ_bar₂)
          (Nat.add_zero (2 * δ)) =
        (z.comp (CategoryTheory.Abelian.Ext.mk₀ δ_bar₁) (Nat.add_zero (2 * δ))).comp
          (CategoryTheory.Abelian.Ext.mk₀ (weilPolyP1HigherDirectImageMap f 2 φ))
          (Nat.add_zero (2 * δ))
      rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hDownstairs_comm,
        ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero]
    rw [← hΘ_comm, he₂ z₂, hδ_comm, ← he₁ z]

theorem weil_etale_injKernel_global_and_higherDirectImage_acyclic (Z B : AlgebraicGeometry.Scheme.{u}) (h : Quiver.Hom Z B)
    (M : ℕ) (hM : 1 ≤ M)
    (J : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
    [CategoryTheory.Injective J]
    (A : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
    (hIso : Nonempty (CategoryTheory.Iso A
      (CategoryTheory.Limits.kernel (M • CategoryTheory.CategoryStruct.id J)))) :
    (∀ q : ℕ, 1 ≤ q → Subsingleton (A.H q)) ∧
    (∀ q : ℕ, 1 ≤ q → CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage h q A)) :=
by
  have hM0 : M ≠ 0 := by omega
  rcases hIso with ⟨e_A⟩
  let J_top := Z.smallEtaleTopology
  let Sh := CategoryTheory.presheafToSheaf J_top AddCommGrpCat.{u}
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let P_c := (CategoryTheory.Functor.const (Opposite Z.Etale)).obj Aℤ
  let P_rep : Z.Etale → CategoryTheory.Functor (Opposite Z.Etale) AddCommGrpCat.{u} :=
    fun V => CategoryTheory.Functor.comp (CategoryTheory.yoneda.obj V) AddCommGrpCat.free
  have hMono_ℤ : CategoryTheory.Mono
      (M • CategoryTheory.CategoryStruct.id
        ((CategoryTheory.constantSheaf J_top AddCommGrpCat.{u}).obj Aℤ)) := by
    have : ∀ W : Opposite Z.Etale,
        CategoryTheory.Mono ((M • CategoryTheory.CategoryStruct.id P_c).app W) := by
      intro W
      rw [CategoryTheory.NatTrans.app_nsmul, CategoryTheory.NatTrans.id_app,
        AddCommGrpCat.mono_iff_injective]
      intro (a : ULift.{u} ℤ) (b : ULift.{u} ℤ) hab
      have h_down : M • a.down = M • b.down := congrArg ULift.down hab
      exact ULift.ext _ _ (nsmul_right_injective hM0 h_down)
    have : CategoryTheory.Mono (M • CategoryTheory.CategoryStruct.id P_c) :=
      CategoryTheory.NatTrans.mono_of_mono_app (M • CategoryTheory.CategoryStruct.id P_c)
    change CategoryTheory.Mono (M • CategoryTheory.CategoryStruct.id (Sh.obj P_c))
    have h_map : Sh.map (M • CategoryTheory.CategoryStruct.id P_c) =
        M • CategoryTheory.CategoryStruct.id (Sh.obj P_c) := by
      rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id]
    rw [← h_map]
    exact inferInstance
  have hMono_Rep : ∀ V : Z.Etale,
      CategoryTheory.Mono (M • CategoryTheory.CategoryStruct.id (Sh.obj (P_rep V))) := by
    intro V
    have : ∀ W : Opposite Z.Etale,
        CategoryTheory.Mono ((M • CategoryTheory.CategoryStruct.id (P_rep V)).app W) := by
      intro W
      rw [CategoryTheory.NatTrans.app_nsmul, CategoryTheory.NatTrans.id_app,
        AddCommGrpCat.mono_iff_injective]
      intro (a : FreeAbelianGroup (Opposite.unop W ⟶ V))
        (b : FreeAbelianGroup (Opposite.unop W ⟶ V)) hab
      have h_ab : M • a = M • b := hab
      let e_fa := FreeAbelianGroup.equivFinsupp (Opposite.unop W ⟶ V)
      apply e_fa.injective
      ext u
      apply nsmul_right_injective hM0
      have h_ev : (e_fa (M • a)) u = (e_fa (M • b)) u :=
        congrArg (fun x => e_fa x u) h_ab
      simpa only [map_nsmul, Finsupp.nsmul_apply] using h_ev
    have : CategoryTheory.Mono (M • CategoryTheory.CategoryStruct.id (P_rep V)) :=
      CategoryTheory.NatTrans.mono_of_mono_app (M • CategoryTheory.CategoryStruct.id (P_rep V))
    have h_map : Sh.map (M • CategoryTheory.CategoryStruct.id (P_rep V)) =
        M • CategoryTheory.CategoryStruct.id (Sh.obj (P_rep V)) := by
      rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id]
    rw [← h_map]
    exact inferInstance
  let μ : J ⟶ J := M • CategoryTheory.CategoryStruct.id J
  have hEpi_μ : CategoryTheory.Epi μ := by
    let adj_sh := CategoryTheory.sheafificationAdjunction J_top AddCommGrpCat.{u}
    let adj_fr := AddCommGrpCat.adj.whiskerRight (Opposite Z.Etale)
    have : ∀ W : Opposite Z.Etale, CategoryTheory.Epi (μ.hom.app W) := by
      intro ⟨V⟩
      rw [AddCommGrpCat.epi_iff_surjective]
      intro y
      let ev_V : (Sh.obj (P_rep V) ⟶ J) ≃ ↑(J.obj.obj (Opposite.op V)) :=
        (adj_sh.homEquiv (P_rep V) J).trans
          ((adj_fr.homEquiv (CategoryTheory.yoneda.obj V) J.obj).trans CategoryTheory.yonedaEquiv)
      have h_ev_nat : ∀ (ξ : Sh.obj (P_rep V) ⟶ J) (φ : J ⟶ J),
          ev_V (ξ ≫ φ) = (φ.hom.app (Opposite.op V)) (ev_V ξ) := by
        intro ξ φ
        dsimp only [ev_V, Equiv.trans_apply]
        rw [CategoryTheory.Adjunction.homEquiv_naturality_right adj_sh ξ φ]
        change CategoryTheory.yonedaEquiv
            ((adj_fr.homEquiv (CategoryTheory.yoneda.obj V) J.obj)
              ((adj_sh.homEquiv (P_rep V) J ξ) ≫ φ.hom)) = _
        rw [CategoryTheory.Adjunction.homEquiv_naturality_right adj_fr _ φ.hom,
          CategoryTheory.yonedaEquiv_comp]
        rfl
      let ψ : Sh.obj (P_rep V) ⟶ J := ev_V.symm y
      have : CategoryTheory.Mono (M • CategoryTheory.CategoryStruct.id (Sh.obj (P_rep V))) :=
        hMono_Rep V
      let ξ : Sh.obj (P_rep V) ⟶ J :=
        CategoryTheory.Injective.factorThru ψ
          (M • CategoryTheory.CategoryStruct.id (Sh.obj (P_rep V)))
      have hξμ : ξ ≫ μ = ψ := by
        calc
          ξ ≫ μ = ξ ≫ (M • CategoryTheory.CategoryStruct.id J) := rfl
          _ = M • (ξ ≫ CategoryTheory.CategoryStruct.id J) :=
              CategoryTheory.Preadditive.comp_nsmul _ _ _
          _ = M • ξ := by rw [CategoryTheory.Category.comp_id]
          _ = M • (CategoryTheory.CategoryStruct.id (Sh.obj (P_rep V)) ≫ ξ) := by
              rw [CategoryTheory.Category.id_comp]
          _ = (M • CategoryTheory.CategoryStruct.id (Sh.obj (P_rep V))) ≫ ξ :=
              (CategoryTheory.Preadditive.nsmul_comp _ _ _).symm
          _ = ψ := CategoryTheory.Injective.comp_factorThru ψ _
      refine ⟨ev_V ξ, ?_⟩
      rw [← h_ev_nat ξ μ, hξμ]
      exact ev_V.apply_symm_apply y
    have : CategoryTheory.Epi μ.hom := CategoryTheory.NatTrans.epi_of_epi_app μ.hom
    have : CategoryTheory.Epi (Sh.map μ.hom) := inferInstance
    let c : Sh.obj J.obj ⟶ J := adj_sh.counit.app J
    have : CategoryTheory.IsIso c := CategoryTheory.isIso_sheafificationAdjunction_counit J
    have h_nat : Sh.map μ.hom ≫ c = c ≫ μ := adj_sh.counit.naturality μ
    have h_eq : μ = CategoryTheory.inv c ≫ Sh.map μ.hom ≫ c := by
      rw [h_nat, CategoryTheory.IsIso.inv_hom_id_assoc]
    rw [h_eq]
    exact CategoryTheory.epi_comp (CategoryTheory.inv c) (Sh.map μ.hom ≫ c)
  let H := CategoryTheory.Limits.kernel μ
  let ι : H ⟶ J := CategoryTheory.Limits.kernel.ι μ
  let SC_H := CategoryTheory.ShortComplex.mk ι μ (CategoryTheory.Limits.kernel.condition μ)
  have hEx_H : SC_H.Exact :=
    CategoryTheory.ShortComplex.exact_of_f_is_kernel SC_H (CategoryTheory.Limits.kernelIsKernel μ)
  have hSE_H : SC_H.ShortExact :=
    CategoryTheory.ShortComplex.ShortExact.mk' hEx_H inferInstance hEpi_μ
  have hExt_sub : ∀ (K : CategoryTheory.Sheaf J_top AddCommGrpCat.{u})
      [CategoryTheory.Mono (M • CategoryTheory.CategoryStruct.id K)]
      (q : ℕ), 1 ≤ q → Subsingleton (CategoryTheory.Abelian.Ext.{u} K A q) := by
    intro K _ q hq
    cases q with
    | zero => omega
    | succ p =>
      have hH_zero : ∀ x : CategoryTheory.Abelian.Ext.{u} K H (p + 1), x = 0 := by
        intro x
        have hx_f : x.comp (CategoryTheory.Abelian.Ext.mk₀ SC_H.f) (Nat.add_zero (p + 1)) = 0 :=
          CategoryTheory.Abelian.Ext.eq_zero_of_injective _
        obtain ⟨w, hw⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ K hSE_H x hx_f (rfl : p + 1 = p + 1)
        cases p with
        | zero =>
          let ψ : K ⟶ J := CategoryTheory.Abelian.Ext.homEquiv₀ w
          have hw_eq : w = CategoryTheory.Abelian.Ext.mk₀ ψ :=
            (CategoryTheory.Abelian.Ext.homEquiv₀.symm_apply_apply w).symm
          let ξ : K ⟶ J :=
            CategoryTheory.Injective.factorThru ψ (M • CategoryTheory.CategoryStruct.id K)
          have hξ : ξ ≫ SC_H.g = ψ := by
            calc
              ξ ≫ SC_H.g = ξ ≫ (M • CategoryTheory.CategoryStruct.id J) := rfl
              _ = M • (ξ ≫ CategoryTheory.CategoryStruct.id J) :=
                  CategoryTheory.Preadditive.comp_nsmul _ _ _
              _ = M • ξ := by rw [CategoryTheory.Category.comp_id]
              _ = M • (CategoryTheory.CategoryStruct.id K ≫ ξ) := by
                  rw [CategoryTheory.Category.id_comp]
              _ = (M • CategoryTheory.CategoryStruct.id K) ≫ ξ :=
                  (CategoryTheory.Preadditive.nsmul_comp _ _ _).symm
              _ = ψ := CategoryTheory.Injective.comp_factorThru ψ _
          rw [← hw, hw_eq, ← hξ, ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ ξ SC_H.g,
            CategoryTheory.Abelian.Ext.comp_assoc _ _ _
              (Nat.zero_add 0) (Nat.zero_add 1) (Nat.zero_add 1),
            hSE_H.comp_extClass, CategoryTheory.Abelian.Ext.comp_zero]
        | succ p' =>
          have hw0 : w = 0 := CategoryTheory.Abelian.Ext.eq_zero_of_injective w
          rw [← hw, hw0, CategoryTheory.Abelian.Ext.zero_comp]
      rw [subsingleton_iff_forall_eq 0]
      intro y
      have hyH : y.comp (CategoryTheory.Abelian.Ext.mk₀ e_A.hom) (Nat.add_zero (p + 1)) = 0 :=
        hH_zero _
      calc
        y = y.comp (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id A))
              (Nat.add_zero (p + 1)) :=
            (CategoryTheory.Abelian.Ext.comp_mk₀_id y).symm
        _ = y.comp (CategoryTheory.Abelian.Ext.mk₀ (e_A.hom ≫ e_A.inv))
              (Nat.add_zero (p + 1)) := by
            rw [e_A.hom_inv_id]
        _ = (y.comp (CategoryTheory.Abelian.Ext.mk₀ e_A.hom) (Nat.add_zero (p + 1))).comp
              (CategoryTheory.Abelian.Ext.mk₀ e_A.inv) (Nat.add_zero (p + 1)) := by
            rw [← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ e_A.hom e_A.inv,
              CategoryTheory.Abelian.Ext.comp_assoc _ _ _
                (Nat.add_zero (p + 1)) (Nat.zero_add 0) (by omega)]
        _ = 0 := by
            rw [hyH, CategoryTheory.Abelian.Ext.zero_comp]
  refine ⟨?_, ?_⟩
  · intro q hq
    exact @hExt_sub ((CategoryTheory.constantSheaf J_top AddCommGrpCat.{u}).obj Aℤ) hMono_ℤ q hq
  · intro q hq
    have hPreZero : CategoryTheory.Limits.IsZero (CategoryTheory.Sheaf.cohomologyPresheaf A q) := by
      rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
      ext ⟨V⟩ x
      have hSub : Subsingleton (CategoryTheory.Abelian.Ext.{u} (Sh.obj (P_rep V)) A q) :=
        @hExt_sub (Sh.obj (P_rep V)) (hMono_Rep V) q hq
      exact @Subsingleton.elim (CategoryTheory.Abelian.Ext.{u} (Sh.obj (P_rep V)) A q) hSub _ _
    have : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    have : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B_h : CategoryTheory.Functor B.Etale Z.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h
    have hWhiskZero : CategoryTheory.Limits.IsZero
        (CategoryTheory.Functor.comp B_h.op (CategoryTheory.Sheaf.cohomologyPresheaf A q)) :=
      ((CategoryTheory.Functor.whiskeringLeft (Opposite B.Etale) (Opposite Z.Etale)
        AddCommGrpCat.{u}).obj B_h.op).map_isZero hPreZero
    dsimp only [weilEtaleHigherDirectImage]
    exact (CategoryTheory.presheafToSheaf B.smallEtaleTopology AddCommGrpCat.{u}).map_isZero
      hWhiskZero

theorem weil_etale_twoStep_deltaBar_exists_and_cokernel_exact (sys : WeilEtaleSitePullbackSys.{u})
    (Y₀ S₀ : AlgebraicGeometry.Scheme.{u}) (f₀ : Quiver.Hom Y₀ S₀) (M : ℕ)
    (F₀ : CategoryTheory.Sheaf Y₀.smallEtaleTopology AddCommGrpCat.{u})
    (R : WeilTwoStepAcyclicRes Y₀ S₀ f₀ M F₀) :
    letI := (sys f₀).hCont
    let pf₀ := (weilEtaleSitePullback f₀).sheafPushforwardContinuous
      AddCommGrpCat.{u} S₀.smallEtaleTopology Y₀.smallEtaleTopology
    (∃ δ_bar : Quiver.Hom (pf₀.obj R.Q₂) (weilEtaleHigherDirectImage f₀ 2 F₀),
      WeilIsTwoStepDeltaBar sys R δ_bar) ∧
    (∀ δ_bar : Quiver.Hom (pf₀.obj R.Q₂) (weilEtaleHigherDirectImage f₀ 2 F₀),
      WeilIsTwoStepDeltaBar sys R δ_bar →
      ∃ hcomp : CategoryTheory.CategoryStruct.comp (pf₀.map R.v₁) δ_bar = 0,
        CategoryTheory.Epi δ_bar ∧
        (CategoryTheory.ShortComplex.mk (pf₀.map R.v₁) δ_bar hcomp).Exact) :=
by
  have : (weilEtaleSitePullback f₀).IsContinuous S₀.smallEtaleTopology Y₀.smallEtaleTopology :=
    (sys f₀).hCont
  intro pf₀
  let J_Y := Y₀.smallEtaleTopology
  let J_S := S₀.smallEtaleTopology
  let B₀ := weilEtaleSitePullback f₀
  let Sh_Y := CategoryTheory.presheafToSheaf J_Y AddCommGrpCat.{u}
  let Sh_S := CategoryTheory.presheafToSheaf J_S AddCommGrpCat.{u}
  let U_Y := CategoryTheory.sheafToPresheaf J_Y AddCommGrpCat.{u}
  let adj_sh_Y := CategoryTheory.sheafificationAdjunction J_Y AddCommGrpCat.{u}
  let adj_sh_S := CategoryTheory.sheafificationAdjunction J_S AddCommGrpCat.{u}
  let adj_free := AddCommGrpCat.adj.whiskerRight (Opposite Y₀.Etale)
  let Free_PSh := (CategoryTheory.Functor.whiskeringRight (Opposite Y₀.Etale)
    (Type u) AddCommGrpCat.{u}).obj AddCommGrpCat.free
  let L_tot := Free_PSh ⋙ Sh_Y
  let adj_tot := adj_free.comp adj_sh_Y
  let Z_fun : CategoryTheory.Functor Y₀.Etale (CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}) :=
    CategoryTheory.yoneda ⋙ L_tot
  let Z_obj : Opposite Y₀.Etale → CategoryTheory.Sheaf J_Y AddCommGrpCat.{u} :=
    fun W => Opposite.unop (Z_fun.op.obj W)

  
  have hRep_add : ∀ (V : Y₀.Etale) (H : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u})
      (u₁ u₂ : Quiver.Hom (weilPolyP1CohomologyRepSheaf Y₀ V) H),
      weilPolyP1CohomologyRepHomEquiv Y₀ V H (u₁ + u₂) =
        weilPolyP1CohomologyRepHomEquiv Y₀ V H u₁ +
          weilPolyP1CohomologyRepHomEquiv Y₀ V H u₂ := by
    intro V H u₁ u₂
    let P_V : CategoryTheory.Functor (Opposite Y₀.Etale) AddCommGrpCat.{u} :=
      CategoryTheory.Functor.comp (CategoryTheory.yoneda.obj V) AddCommGrpCat.free
    let g₀ : ↑(P_V.obj (Opposite.op V)) :=
      ((adj_free.unit.app (CategoryTheory.yoneda.obj V)).app (Opposite.op V))
        (CategoryTheory.CategoryStruct.id V)
    have heval : ∀ u : Quiver.Hom (weilPolyP1CohomologyRepSheaf Y₀ V) H,
        weilPolyP1CohomologyRepHomEquiv Y₀ V H u =
          ((adj_sh_Y.homEquiv P_V H u).app (Opposite.op V)) g₀ := by
      intro u
      dsimp only [weilPolyP1CohomologyRepHomEquiv, Equiv.trans_apply]
      rw [CategoryTheory.yonedaEquiv_apply, CategoryTheory.Adjunction.homEquiv_unit]
      rfl
    have h_sh_add : adj_sh_Y.homEquiv P_V H (u₁ + u₂) =
        adj_sh_Y.homEquiv P_V H u₁ + adj_sh_Y.homEquiv P_V H u₂ := by
      rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Adjunction.homEquiv_unit,
        CategoryTheory.Adjunction.homEquiv_unit, U_Y.map_add, CategoryTheory.Preadditive.comp_add]
    rw [heval (u₁ + u₂), heval u₁, heval u₂, h_sh_add, CategoryTheory.NatTrans.app_add]
    rfl

  have hRep_nat_right : ∀ (V : Y₀.Etale)
      {H₁ H₂ : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}}
      (φ : Quiver.Hom H₁ H₂)
      (u : Quiver.Hom (weilPolyP1CohomologyRepSheaf Y₀ V) H₁),
      weilPolyP1CohomologyRepHomEquiv Y₀ V H₂ (CategoryTheory.CategoryStruct.comp u φ) =
        (φ.hom.app (Opposite.op V)) (weilPolyP1CohomologyRepHomEquiv Y₀ V H₁ u) := by
    intro V H₁ H₂ φ u
    dsimp only [weilPolyP1CohomologyRepHomEquiv, Equiv.trans_apply]
    rw [CategoryTheory.Adjunction.homEquiv_naturality_right]
    change CategoryTheory.yonedaEquiv
        ((adj_free.homEquiv (CategoryTheory.yoneda.obj V) H₂.obj)
          (CategoryTheory.CategoryStruct.comp
            ((adj_sh_Y.homEquiv _ H₁) u) φ.hom)) = _
    rw [CategoryTheory.Adjunction.homEquiv_naturality_right, CategoryTheory.yonedaEquiv_comp]
    rfl

  have hRep_symm_nat : ∀ (V : Y₀.Etale)
      {H₁ H₂ : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}}
      (φ : Quiver.Hom H₁ H₂)
      (s : ↑(H₁.obj.obj (Opposite.op V))),
      (weilPolyP1CohomologyRepHomEquiv Y₀ V H₂).symm ((φ.hom.app (Opposite.op V)) s) =
        CategoryTheory.CategoryStruct.comp
          ((weilPolyP1CohomologyRepHomEquiv Y₀ V H₁).symm s) φ := by
    intro V H₁ H₂ φ s
    apply (weilPolyP1CohomologyRepHomEquiv Y₀ V H₂).injective
    rw [Equiv.apply_symm_apply, hRep_nat_right, Equiv.apply_symm_apply]

  let e_rep : ∀ (V : Y₀.Etale) (H : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}),
      Quiver.Hom (weilPolyP1CohomologyRepSheaf Y₀ V) H ≃+ ↑(H.obj.obj (Opposite.op V)) :=
    fun V H => AddEquiv.mk' (weilPolyP1CohomologyRepHomEquiv Y₀ V H) (hRep_add V H)

  let e_ext : ∀ (W : Opposite Y₀.Etale) (H : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}),
      ↑((CategoryTheory.Sheaf.cohomologyPresheaf H 0).obj W) ≃+ ↑(H.obj.obj W) :=
    fun W H => CategoryTheory.Abelian.Ext.addEquiv₀.trans (e_rep (Opposite.unop W) H)

  have he_ext_nat : ∀ (H : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u})
      {W₁ W₂ : Opposite Y₀.Etale} (ω : Quiver.Hom W₁ W₂),
      CategoryTheory.CategoryStruct.comp
        ((CategoryTheory.Sheaf.cohomologyPresheaf H 0).map ω)
        (AddCommGrpCat.ofHom (e_ext W₂ H).toAddMonoidHom) =
      CategoryTheory.CategoryStruct.comp
        (AddCommGrpCat.ofHom (e_ext W₁ H).toAddMonoidHom)
        (H.obj.map ω) := by
    intro H W₁ W₂ ω
    have hmap : (CategoryTheory.Sheaf.cohomologyPresheaf H 0).map ω =
        ((CategoryTheory.Abelian.extFunctor 0).map (Z_fun.op.map ω)).app H := rfl
    rw [hmap, CategoryTheory.Abelian.extFunctor_map_app 0 (Z_fun.op.map ω) H]
    apply AddCommGrpCat.ext
    intro β
    let u : Quiver.Hom (Z_obj W₁) H := CategoryTheory.Abelian.Ext.addEquiv₀ β
    have hβ : CategoryTheory.Abelian.Ext.mk₀ u = β :=
      CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply β
    have hcomp_u : ((CategoryTheory.Abelian.Ext.mk₀ (Z_fun.op.map ω).unop).comp β
        (Nat.zero_add 0)) =
        CategoryTheory.Abelian.Ext.mk₀
          (CategoryTheory.CategoryStruct.comp (Z_fun.op.map ω).unop u) := by
      rw [← hβ, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
    change e_ext W₂ H
        ((CategoryTheory.Abelian.Ext.mk₀ (Z_fun.op.map ω).unop).comp β (Nat.zero_add 0)) =
      (H.obj.map ω) (e_ext W₁ H β)
    rw [hcomp_u]
    have h_add₀ : CategoryTheory.Abelian.Ext.addEquiv₀
        (CategoryTheory.Abelian.Ext.mk₀
          (CategoryTheory.CategoryStruct.comp (Z_fun.op.map ω).unop u)) =
        CategoryTheory.CategoryStruct.comp (Z_fun.op.map ω).unop u := by
      rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply]
      exact CategoryTheory.Abelian.Ext.addEquiv₀.apply_symm_apply _
    have h_rep_tot : ∀ (V : Y₀.Etale) (w : Quiver.Hom (weilPolyP1CohomologyRepSheaf Y₀ V) H),
        weilPolyP1CohomologyRepHomEquiv Y₀ V H w =
          CategoryTheory.yonedaEquiv ((adj_tot.homEquiv (CategoryTheory.yoneda.obj V) H) w) := by
      intro V w
      dsimp only [weilPolyP1CohomologyRepHomEquiv, adj_tot]
      rw [CategoryTheory.Adjunction.comp_homEquiv]
      rfl
    change weilPolyP1CohomologyRepHomEquiv Y₀ (Opposite.unop W₂) H
        (CategoryTheory.Abelian.Ext.addEquiv₀
          (CategoryTheory.Abelian.Ext.mk₀
            (CategoryTheory.CategoryStruct.comp (Z_fun.op.map ω).unop u))) =
      (H.obj.map ω) (weilPolyP1CohomologyRepHomEquiv Y₀ (Opposite.unop W₁) H u)
    rw [h_add₀, h_rep_tot, h_rep_tot]
    have hL : (Z_fun.op.map ω).unop = L_tot.map (CategoryTheory.yoneda.map ω.unop) := rfl
    rw [hL, adj_tot.homEquiv_naturality_left]
    exact (CategoryTheory.yonedaEquiv_naturality'
      ((adj_tot.homEquiv (CategoryTheory.yoneda.obj (Opposite.unop W₁)) H) u) ω).symm

  let α_comp : ∀ (H : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}) (W : Opposite Y₀.Etale),
      CategoryTheory.Iso ((CategoryTheory.Sheaf.cohomologyPresheaf H 0).obj W) (H.obj.obj W) :=
    fun H W =>
      { hom := AddCommGrpCat.ofHom (e_ext W H).toAddMonoidHom
        inv := AddCommGrpCat.ofHom (e_ext W H).symm.toAddMonoidHom
        hom_inv_id := AddCommGrpCat.ext fun x => (e_ext W H).symm_apply_apply x
        inv_hom_id := AddCommGrpCat.ext fun x => (e_ext W H).apply_symm_apply x }

  let α_iso : ∀ (H : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}),
      CategoryTheory.Iso H.obj (CategoryTheory.Sheaf.cohomologyPresheaf H 0) :=
    fun H => (CategoryTheory.NatIso.ofComponents (α_comp H) (fun ω => he_ext_nat H ω)).symm

  have hα_sec : ∀ (H : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u})
      (V : Y₀.Etale) (s : ↑(H.obj.obj (Opposite.op V))),
      ((α_iso H).hom.app (Opposite.op V)) s =
        CategoryTheory.Abelian.Ext.mk₀
          ((weilPolyP1CohomologyRepHomEquiv Y₀ V H).symm s) := by
    intro H V s
    change CategoryTheory.Abelian.Ext.addEquiv₀.symm
        ((weilPolyP1CohomologyRepHomEquiv Y₀ V H).symm s) = _
    exact CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply _

  have hα_nat : ∀ {H₁ H₂ : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}}
      (φ : Quiver.Hom H₁ H₂),
      CategoryTheory.CategoryStruct.comp φ.hom (α_iso H₂).hom =
        CategoryTheory.CategoryStruct.comp (α_iso H₁).hom
          ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_Y 0).map φ) := by
    intro H₁ H₂ φ
    apply CategoryTheory.NatTrans.ext
    funext W
    rcases W with ⟨V⟩
    have h_fmap : (((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_Y 0).map φ).app
        (Opposite.op V)) =
        (CategoryTheory.Abelian.extFunctorObj (weilPolyP1CohomologyRepSheaf Y₀ V) 0).map φ := rfl
    apply AddCommGrpCat.ext
    intro s
    change ((α_iso H₂).hom.app (Opposite.op V)) ((φ.hom.app (Opposite.op V)) s) =
      (((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_Y 0).map φ).app (Opposite.op V))
        (((α_iso H₁).hom.app (Opposite.op V)) s)
    rw [hα_sec H₂ V _, hRep_symm_nat V φ s, hα_sec H₁ V s, h_fmap,
      CategoryTheory.Abelian.extFunctorObj_map]
    exact (CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ _ φ).symm

  let η_sh_S : ∀ Q : CategoryTheory.Sheaf J_S AddCommGrpCat.{u},
      Quiver.Hom Q (Sh_S.obj Q.obj) :=
    fun Q => CategoryTheory.ObjectProperty.homMk (adj_sh_S.unit.app Q.obj)

  have hη_sh_iso : ∀ Q : CategoryTheory.Sheaf J_S AddCommGrpCat.{u},
      CategoryTheory.IsIso (η_sh_S Q) := by
    intro Q
    let ε_Q : Quiver.Hom (Sh_S.obj Q.obj) Q := adj_sh_S.counit.app Q
    have : CategoryTheory.IsIso ε_Q :=
      CategoryTheory.isIso_sheafificationAdjunction_counit Q
    let e_ε : CategoryTheory.Iso (Sh_S.obj Q.obj) Q := CategoryTheory.asIso ε_Q
    have h_right : CategoryTheory.CategoryStruct.comp (η_sh_S Q) e_ε.hom =
        CategoryTheory.CategoryStruct.id Q :=
      CategoryTheory.Sheaf.hom_ext (adj_sh_S.right_triangle_components Q)
    have h_left : CategoryTheory.CategoryStruct.comp e_ε.hom (η_sh_S Q) =
        CategoryTheory.CategoryStruct.id (Sh_S.obj Q.obj) := by
      calc
        CategoryTheory.CategoryStruct.comp e_ε.hom (η_sh_S Q)
          = CategoryTheory.CategoryStruct.comp
              (CategoryTheory.CategoryStruct.comp e_ε.hom (η_sh_S Q))
              (CategoryTheory.CategoryStruct.comp e_ε.hom e_ε.inv) := by
              rw [e_ε.hom_inv_id, CategoryTheory.Category.comp_id]
        _ = CategoryTheory.CategoryStruct.comp e_ε.hom
              (CategoryTheory.CategoryStruct.comp
                (CategoryTheory.CategoryStruct.comp (η_sh_S Q) e_ε.hom) e_ε.inv) := by
              simp only [CategoryTheory.Category.assoc]
        _ = CategoryTheory.CategoryStruct.id (Sh_S.obj Q.obj) := by
              rw [h_right, CategoryTheory.Category.id_comp, e_ε.hom_inv_id]
    exact ⟨⟨e_ε.hom, h_right, h_left⟩⟩

  have hη_sh_nat : ∀ {P₁ P₂ : CategoryTheory.Sheaf J_S AddCommGrpCat.{u}}
      (ψ : Quiver.Hom P₁ P₂),
      CategoryTheory.CategoryStruct.comp ψ (η_sh_S P₂) =
        CategoryTheory.CategoryStruct.comp (η_sh_S P₁) (Sh_S.map ψ.hom) := by
    intro P₁ P₂ ψ
    exact CategoryTheory.Sheaf.hom_ext (adj_sh_S.unit.naturality ψ.hom)

  
  let W_B := (CategoryTheory.Functor.whiskeringLeft
    (Opposite S₀.Etale) (Opposite Y₀.Etale) AddCommGrpCat.{u}).obj B₀.op

  have hPSh_exact : ∀ (K : CategoryTheory.ShortComplex
      (CategoryTheory.Functor (Opposite Y₀.Etale) AddCommGrpCat.{u})),
      (∀ W : Opposite Y₀.Etale,
        (K.map ((CategoryTheory.evaluation (Opposite Y₀.Etale) AddCommGrpCat.{u}).obj W)).Exact) →
      K.Exact := by
    intro K hK
    rw [CategoryTheory.ShortComplex.exact_iff_isZero_leftHomology,
      CategoryTheory.Functor.isZero_iff]
    intro W
    let evW := (CategoryTheory.evaluation (Opposite Y₀.Etale) AddCommGrpCat.{u}).obj W
    have hZ : CategoryTheory.Limits.IsZero (K.map evW).leftHomology :=
      (CategoryTheory.ShortComplex.exact_iff_isZero_leftHomology (K.map evW)).mp (hK W)
    exact hZ.of_iso (K.mapLeftHomologyIso evW).symm

  have hConn : ∀ {SC : CategoryTheory.ShortComplex
        (CategoryTheory.Sheaf J_Y AddCommGrpCat.{u})}
      (hSE : SC.ShortExact) (p : ℕ),
      ∃ δ_pre : Quiver.Hom
          (CategoryTheory.Sheaf.cohomologyPresheaf SC.X₃ p)
          (CategoryTheory.Sheaf.cohomologyPresheaf SC.X₁ (p + 1)),
        (∀ (V : Y₀.Etale)
           (x : ↑((CategoryTheory.Sheaf.cohomologyPresheaf SC.X₃ p).obj (Opposite.op V))),
          (δ_pre.app (Opposite.op V)) x =
            CategoryTheory.Abelian.Ext.comp x hSE.extClass (rfl : p + 1 = p + 1)) ∧
        (let Δ : Quiver.Hom
             (weilEtaleHigherDirectImage f₀ p SC.X₃)
             (weilEtaleHigherDirectImage f₀ (p + 1) SC.X₁) :=
           Sh_S.map (CategoryTheory.Functor.whiskerLeft B₀.op δ_pre)
         let g_map := weilPolyP1HigherDirectImageMap f₀ p SC.g
         let f_map := weilPolyP1HigherDirectImageMap f₀ (p + 1) SC.f
         ∃ (hcomp₁ : CategoryTheory.CategoryStruct.comp g_map Δ = 0)
           (hcomp₂ : CategoryTheory.CategoryStruct.comp Δ f_map = 0),
           (CategoryTheory.ShortComplex.mk g_map Δ hcomp₁).Exact ∧
           (CategoryTheory.ShortComplex.mk Δ f_map hcomp₂).Exact) := by
    intro SC hSE p
    let δ_pre : Quiver.Hom
        (CategoryTheory.Sheaf.cohomologyPresheaf SC.X₃ p)
        (CategoryTheory.Sheaf.cohomologyPresheaf SC.X₁ (p + 1)) :=
      { app := fun W =>
          AddCommGrpCat.ofHom (hSE.extClass.postcomp (Z_obj W) (rfl : p + 1 = p + 1))
        naturality := fun {W₁ W₂} ω => by
          have hL : (CategoryTheory.Sheaf.cohomologyPresheaf SC.X₃ p).map ω =
              ((CategoryTheory.Abelian.extFunctor p).map (Z_fun.op.map ω)).app SC.X₃ := rfl
          have hR : (CategoryTheory.Sheaf.cohomologyPresheaf SC.X₁ (p + 1)).map ω =
              ((CategoryTheory.Abelian.extFunctor (p + 1)).map (Z_fun.op.map ω)).app SC.X₁ := rfl
          rw [hL, hR,
            CategoryTheory.Abelian.extFunctor_map_app p (Z_fun.op.map ω) SC.X₃,
            CategoryTheory.Abelian.extFunctor_map_app (p + 1) (Z_fun.op.map ω) SC.X₁]
          apply AddCommGrpCat.ext
          intro α
          exact CategoryTheory.Abelian.Ext.comp_assoc
            (CategoryTheory.Abelian.Ext.mk₀ (Z_fun.op.map ω).unop) α hSE.extClass
            (Nat.zero_add p) (rfl : p + 1 = p + 1) (by omega) }
    let g_pre := (CategoryTheory.Sheaf.cohomologyPresheafFunctor J_Y p).map SC.g
    let f_pre := (CategoryTheory.Sheaf.cohomologyPresheafFunctor J_Y (p + 1)).map SC.f
    have hg_app : ∀ W : Opposite Y₀.Etale,
        g_pre.app W = AddCommGrpCat.ofHom
          ((CategoryTheory.Abelian.Ext.mk₀ SC.g).postcomp (Z_obj W) (Nat.add_zero p)) :=
      fun W => CategoryTheory.Abelian.extFunctorObj_map (Z_obj W) p SC.g
    have hf_app : ∀ W : Opposite Y₀.Etale,
        f_pre.app W = AddCommGrpCat.ofHom
          ((CategoryTheory.Abelian.Ext.mk₀ SC.f).postcomp (Z_obj W) (Nat.add_zero (p + 1))) :=
      fun W => CategoryTheory.Abelian.extFunctorObj_map (Z_obj W) (p + 1) SC.f
    have hcomp₁_pre : CategoryTheory.CategoryStruct.comp g_pre δ_pre = 0 := by
      apply CategoryTheory.NatTrans.ext
      funext W
      rw [CategoryTheory.NatTrans.comp_app, hg_app W]
      apply AddCommGrpCat.ext
      intro (x : CategoryTheory.Abelian.Ext (Z_obj W) SC.X₂ p)
      change (x.comp (CategoryTheory.Abelian.Ext.mk₀ SC.g) (Nat.add_zero p)).comp
        hSE.extClass (rfl : p + 1 = p + 1) = 0
      rw [CategoryTheory.Abelian.Ext.comp_assoc x (CategoryTheory.Abelian.Ext.mk₀ SC.g)
        hSE.extClass (Nat.add_zero p) (Nat.zero_add 1) (rfl : p + 1 = p + 1),
        hSE.comp_extClass, CategoryTheory.Abelian.Ext.comp_zero]
    have hcomp₂_pre : CategoryTheory.CategoryStruct.comp δ_pre f_pre = 0 := by
      apply CategoryTheory.NatTrans.ext
      funext W
      rw [CategoryTheory.NatTrans.comp_app, hf_app W]
      apply AddCommGrpCat.ext
      intro (x : CategoryTheory.Abelian.Ext (Z_obj W) SC.X₃ p)
      change (x.comp hSE.extClass (rfl : p + 1 = p + 1)).comp
        (CategoryTheory.Abelian.Ext.mk₀ SC.f) (Nat.add_zero (p + 1)) = 0
      rw [CategoryTheory.Abelian.Ext.comp_assoc x hSE.extClass
        (CategoryTheory.Abelian.Ext.mk₀ SC.f) (rfl : p + 1 = p + 1) (Nat.add_zero 1) (by omega),
        hSE.extClass_comp, CategoryTheory.Abelian.Ext.comp_zero]
    let A_pre := CategoryTheory.ShortComplex.mk g_pre δ_pre hcomp₁_pre
    let B_pre := CategoryTheory.ShortComplex.mk δ_pre f_pre hcomp₂_pre
    have hA_pre : A_pre.Exact := by
      apply hPSh_exact A_pre
      intro W
      have hex₃ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₃'
        (Z_obj W) hSE p (p + 1) (rfl : p + 1 = p + 1)
      exact (CategoryTheory.ShortComplex.exact_iff_of_iso
        (CategoryTheory.ShortComplex.isoMk
          (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
          ((CategoryTheory.Category.id_comp (g_pre.app W)).trans
            ((hg_app W).trans (CategoryTheory.Category.comp_id _).symm))
          ((CategoryTheory.Category.id_comp (δ_pre.app W)).trans
            (CategoryTheory.Category.comp_id _).symm))).mp hex₃
    have hB_pre : B_pre.Exact := by
      apply hPSh_exact B_pre
      intro W
      have hex₁ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁'
        (Z_obj W) hSE p (p + 1) (rfl : p + 1 = p + 1)
      exact (CategoryTheory.ShortComplex.exact_iff_of_iso
        (CategoryTheory.ShortComplex.isoMk
          (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
          ((CategoryTheory.Category.id_comp (δ_pre.app W)).trans
            (CategoryTheory.Category.comp_id _).symm)
          ((CategoryTheory.Category.id_comp (f_pre.app W)).trans
            ((hf_app W).trans (CategoryTheory.Category.comp_id _).symm)))).mp hex₁
    let A_sh := (A_pre.map W_B).map Sh_S
    let B_sh := (B_pre.map W_B).map Sh_S
    have hA_sh : A_sh.Exact := (hA_pre.map W_B).map Sh_S
    have hB_sh : B_sh.Exact := (hB_pre.map W_B).map Sh_S
    exact ⟨δ_pre, fun _ _ => rfl, A_sh.zero, B_sh.zero, hA_sh, hB_sh⟩

  
  obtain ⟨δ_pre₁, hδ_pre₁_sec, hcomp₁₁, hcomp₁₂, hEx₁₁, hEx₁₂⟩ := hConn R.hSE₁ 0
  obtain ⟨δ_pre₀, hδ_pre₀_sec, hcomp₀₁, hcomp₀₂, hEx₀₁, hEx₀₂⟩ := hConn R.hSE₀ 1

  let Δ₁ : Quiver.Hom
      (weilEtaleHigherDirectImage f₀ 0 R.Q₂)
      (weilEtaleHigherDirectImage f₀ 1 R.Q₁) :=
    Sh_S.map (CategoryTheory.Functor.whiskerLeft B₀.op δ_pre₁)
  let Δ₀ : Quiver.Hom
      (weilEtaleHigherDirectImage f₀ 1 R.Q₁)
      (weilEtaleHigherDirectImage f₀ 2 F₀) :=
    Sh_S.map (CategoryTheory.Functor.whiskerLeft B₀.op δ_pre₀)

  let α_A₁ := α_iso R.A₁
  let α_Q₂ := α_iso R.Q₂
  have hα_v₁ : CategoryTheory.CategoryStruct.comp R.v₁.hom α_Q₂.hom =
      CategoryTheory.CategoryStruct.comp α_A₁.hom
        ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_Y 0).map R.v₁) :=
    hα_nat R.v₁

  let P_F2 : CategoryTheory.Functor (Opposite S₀.Etale) AddCommGrpCat.{u} :=
    CategoryTheory.Functor.comp B₀.op (CategoryTheory.Sheaf.cohomologyPresheaf F₀ 2)
  let η_F2 := adj_sh_S.unit.app P_F2
  let β_pre : Quiver.Hom (pf₀.obj R.Q₂).obj P_F2 :=
    CategoryTheory.Functor.whiskerLeft B₀.op
      (CategoryTheory.CategoryStruct.comp α_Q₂.hom
        (CategoryTheory.CategoryStruct.comp δ_pre₁ δ_pre₀))
  let δ_bar_std : Quiver.Hom (pf₀.obj R.Q₂) (weilEtaleHigherDirectImage f₀ 2 F₀) :=
    CategoryTheory.ObjectProperty.homMk
      (CategoryTheory.CategoryStruct.comp β_pre η_F2)

  have hδ_std : WeilIsTwoStepDeltaBar sys R δ_bar_std := by
    intro V s
    let U_V := B₀.obj V
    have h1 : (α_Q₂.hom.app (Opposite.op U_V)) s =
        CategoryTheory.Abelian.Ext.mk₀
          ((weilPolyP1CohomologyRepHomEquiv Y₀ U_V R.Q₂).symm s) :=
      hα_sec R.Q₂ U_V s
    have h2 := hδ_pre₁_sec U_V ((α_Q₂.hom.app (Opposite.op U_V)) s)
    have h3 := hδ_pre₀_sec U_V ((δ_pre₁.app (Opposite.op U_V))
      ((α_Q₂.hom.app (Opposite.op U_V)) s))
    change (η_F2.app (Opposite.op V))
        ((δ_pre₀.app (Opposite.op U_V))
          ((δ_pre₁.app (Opposite.op U_V))
            ((α_Q₂.hom.app (Opposite.op U_V)) s))) = _
    rw [h3, h2, h1]

  refine ⟨⟨δ_bar_std, hδ_std⟩, ?_⟩
  intro δ_bar hδ_bar
  have hδ_eq : δ_bar = δ_bar_std := by
    apply CategoryTheory.Sheaf.hom_ext
    apply CategoryTheory.NatTrans.ext
    funext W
    rcases W with ⟨V⟩
    apply AddCommGrpCat.ext
    intro s
    exact (hδ_bar V s).trans (hδ_std V s).symm
  subst hδ_eq

  have : CategoryTheory.IsIso (η_sh_S (pf₀.obj R.A₁)) := hη_sh_iso (pf₀.obj R.A₁)
  have : CategoryTheory.IsIso (η_sh_S (pf₀.obj R.Q₂)) := hη_sh_iso (pf₀.obj R.Q₂)
  let e₁ : CategoryTheory.Iso (pf₀.obj R.A₁) (weilEtaleHigherDirectImage f₀ 0 R.A₁) :=
    CategoryTheory.Iso.trans
      (CategoryTheory.asIso (η_sh_S (pf₀.obj R.A₁)))
      (Sh_S.mapIso (W_B.mapIso α_A₁))
  let e₂ : CategoryTheory.Iso (pf₀.obj R.Q₂) (weilEtaleHigherDirectImage f₀ 0 R.Q₂) :=
    CategoryTheory.Iso.trans
      (CategoryTheory.asIso (η_sh_S (pf₀.obj R.Q₂)))
      (Sh_S.mapIso (W_B.mapIso α_Q₂))

  let v_R₀ := weilPolyP1HigherDirectImageMap f₀ 0 R.v₁
  have hv_comm : CategoryTheory.CategoryStruct.comp (pf₀.map R.v₁) e₂.hom =
      CategoryTheory.CategoryStruct.comp e₁.hom v_R₀ := by
    have h_unit := hη_sh_nat (pf₀.map R.v₁)
    have h_wb : CategoryTheory.CategoryStruct.comp
        (Sh_S.map (pf₀.map R.v₁).hom) (Sh_S.map (W_B.map α_Q₂.hom)) =
        CategoryTheory.CategoryStruct.comp (Sh_S.map (W_B.map α_A₁.hom)) v_R₀ := by
      change CategoryTheory.CategoryStruct.comp
          (Sh_S.map (W_B.map R.v₁.hom)) (Sh_S.map (W_B.map α_Q₂.hom)) =
        CategoryTheory.CategoryStruct.comp
          (Sh_S.map (W_B.map α_A₁.hom))
          (Sh_S.map (W_B.map ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_Y 0).map R.v₁)))
      exact (Sh_S.map_comp _ _).symm.trans
        ((congrArg Sh_S.map
          ((W_B.map_comp _ _).symm.trans
            ((congrArg W_B.map hα_v₁).trans (W_B.map_comp _ _)))).trans
          (Sh_S.map_comp _ _))
    exact (CategoryTheory.Category.assoc (pf₀.map R.v₁) (η_sh_S (pf₀.obj R.Q₂))
        (Sh_S.map (W_B.map α_Q₂.hom))).symm.trans
      ((congrArg (fun u => CategoryTheory.CategoryStruct.comp u (Sh_S.map (W_B.map α_Q₂.hom)))
          h_unit).trans
        ((CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg (CategoryTheory.CategoryStruct.comp (η_sh_S (pf₀.obj R.A₁))) h_wb).trans
            (CategoryTheory.Category.assoc _ _ _).symm)))

  have hδ_fac : δ_bar_std =
      CategoryTheory.CategoryStruct.comp e₂.hom
        (CategoryTheory.CategoryStruct.comp Δ₁ Δ₀) := by
    have h_step : δ_bar_std =
        CategoryTheory.CategoryStruct.comp (η_sh_S (pf₀.obj R.Q₂)) (Sh_S.map β_pre) :=
      CategoryTheory.Sheaf.hom_ext (adj_sh_S.unit.naturality β_pre)
    have h_β_map : Sh_S.map β_pre =
        CategoryTheory.CategoryStruct.comp (Sh_S.map (W_B.map α_Q₂.hom))
          (CategoryTheory.CategoryStruct.comp Δ₁ Δ₀) := by
      have h_w : β_pre =
          CategoryTheory.CategoryStruct.comp (W_B.map α_Q₂.hom)
            (CategoryTheory.CategoryStruct.comp
              (CategoryTheory.Functor.whiskerLeft B₀.op δ_pre₁)
              (CategoryTheory.Functor.whiskerLeft B₀.op δ_pre₀)) := by
        dsimp only [β_pre, W_B]
        rw [CategoryTheory.Functor.whiskerLeft_comp, CategoryTheory.Functor.whiskerLeft_comp]
        rfl
      exact (congrArg Sh_S.map h_w).trans
        ((Sh_S.map_comp _ _).trans
          (congrArg (CategoryTheory.CategoryStruct.comp (Sh_S.map (W_B.map α_Q₂.hom)))
            (Sh_S.map_comp _ _)))
    exact h_step.trans
      ((congrArg (CategoryTheory.CategoryStruct.comp (η_sh_S (pf₀.obj R.Q₂))) h_β_map).trans
        (CategoryTheory.Category.assoc (η_sh_S (pf₀.obj R.Q₂))
          (Sh_S.map (W_B.map α_Q₂.hom))
          (CategoryTheory.CategoryStruct.comp Δ₁ Δ₀)).symm)

  
  have hu_R₁ : weilPolyP1HigherDirectImageMap f₀ 1 R.u₁ = 0 :=
    (R.hDir_A₁ 1 (le_refl 1)).eq_of_tgt _ 0
  have : CategoryTheory.Epi Δ₁ := hEx₁₂.epi_f hu_R₁
  have hv_R₁ : weilPolyP1HigherDirectImageMap f₀ 1 R.v₀ = 0 :=
    (R.hDir_A₀ 1 (le_refl 1)).eq_of_src _ 0
  have : CategoryTheory.Mono Δ₀ := hEx₀₁.mono_g hv_R₁
  have hu_R₂ : weilPolyP1HigherDirectImageMap f₀ 2 R.u₀ = 0 :=
    (R.hDir_A₀ 2 (by omega)).eq_of_tgt _ 0
  have : CategoryTheory.Epi Δ₀ := hEx₀₂.epi_f hu_R₂
  have : CategoryTheory.IsIso Δ₀ := CategoryTheory.isIso_of_mono_of_epi Δ₀
  let e_Δ₀ := CategoryTheory.asIso Δ₀

  have hcomp : CategoryTheory.CategoryStruct.comp (pf₀.map R.v₁) δ_bar_std = 0 := by
    rw [hδ_fac, ← CategoryTheory.Category.assoc, hv_comm]
    calc
      CategoryTheory.CategoryStruct.comp
          (CategoryTheory.CategoryStruct.comp e₁.hom v_R₀)
          (CategoryTheory.CategoryStruct.comp Δ₁ Δ₀)
        = CategoryTheory.CategoryStruct.comp e₁.hom
            (CategoryTheory.CategoryStruct.comp
              (CategoryTheory.CategoryStruct.comp v_R₀ Δ₁) Δ₀) := by
            simp only [CategoryTheory.Category.assoc]
      _ = 0 := by
            rw [hcomp₁₁, CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.comp_zero]

  have hEpi_δ : CategoryTheory.Epi δ_bar_std := by
    rw [hδ_fac]
    have : CategoryTheory.Epi (CategoryTheory.CategoryStruct.comp Δ₁ Δ₀) :=
      CategoryTheory.epi_comp Δ₁ Δ₀
    exact CategoryTheory.epi_comp e₂.hom (CategoryTheory.CategoryStruct.comp Δ₁ Δ₀)

  have hEx_δ : (CategoryTheory.ShortComplex.mk (pf₀.map R.v₁) δ_bar_std hcomp).Exact := by
    refine (CategoryTheory.ShortComplex.exact_iff_of_iso ?_).mp hEx₁₁
    refine CategoryTheory.ShortComplex.isoMk e₁.symm e₂.symm e_Δ₀ ?_ ?_
    · change CategoryTheory.CategoryStruct.comp e₁.inv (pf₀.map R.v₁) =
        CategoryTheory.CategoryStruct.comp v_R₀ e₂.inv
      calc
        CategoryTheory.CategoryStruct.comp e₁.inv (pf₀.map R.v₁)
          = CategoryTheory.CategoryStruct.comp e₁.inv
              (CategoryTheory.CategoryStruct.comp (pf₀.map R.v₁)
                (CategoryTheory.CategoryStruct.comp e₂.hom e₂.inv)) := by
              rw [e₂.hom_inv_id, CategoryTheory.Category.comp_id]
        _ = CategoryTheory.CategoryStruct.comp e₁.inv
              (CategoryTheory.CategoryStruct.comp
                (CategoryTheory.CategoryStruct.comp (pf₀.map R.v₁) e₂.hom) e₂.inv) := by
              simp only [CategoryTheory.Category.assoc]
        _ = CategoryTheory.CategoryStruct.comp
              (CategoryTheory.CategoryStruct.comp e₁.inv e₁.hom)
              (CategoryTheory.CategoryStruct.comp v_R₀ e₂.inv) := by
              rw [hv_comm]
              simp only [CategoryTheory.Category.assoc]
        _ = CategoryTheory.CategoryStruct.comp v_R₀ e₂.inv := by
              rw [e₁.inv_hom_id, CategoryTheory.Category.id_comp]
    · change CategoryTheory.CategoryStruct.comp e₂.inv δ_bar_std =
        CategoryTheory.CategoryStruct.comp Δ₁ Δ₀
      rw [hδ_fac, ← CategoryTheory.Category.assoc, e₂.inv_hom_id, CategoryTheory.Category.id_comp]

  exact ⟨hcomp, hEpi_δ, hEx_δ⟩

theorem weil_etale_composable_R2_pullback_counit_hom_and_deltaBar_comm (sys : WeilEtaleSitePullbackSys.{u})
    (W_top Y S : AlgebraicGeometry.Scheme.{u})
    (g : Quiver.Hom W_top Y) (f : Quiver.Hom Y S) (h_Wf : Quiver.Hom W_top S)
    (hg : CategoryTheory.CategoryStruct.comp g f = h_Wf)
    (G : CategoryTheory.Sheaf W_top.smallEtaleTopology AddCommGrpCat.{u}) :
    letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
        CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
      fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
        CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
      fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg' => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg')
    letI := (sys g).hCont
    letI := (sys g).hAdj
    letI := (sys g).hAdd_pb
    letI := (sys g).hAdd_pf
    letI := (sys g).hLim_pb
    letI := (sys g).hColim_pb
    let pf_g := (weilEtaleSitePullback g).sheafPushforwardContinuous
      AddCommGrpCat.{u} Y.smallEtaleTopology W_top.smallEtaleTopology
    let pb_g := (weilEtaleSitePullback g).sheafPullback
      AddCommGrpCat.{u} Y.smallEtaleTopology W_top.smallEtaleTopology
    let adj_g := (weilEtaleSitePullback g).sheafAdjunctionContinuous
      AddCommGrpCat.{u} Y.smallEtaleTopology W_top.smallEtaleTopology
    letI := (sys f).hCont
    let pf_f := (weilEtaleSitePullback f).sheafPushforwardContinuous
      AddCommGrpCat.{u} S.smallEtaleTopology Y.smallEtaleTopology
    letI := (sys h_Wf).hCont
    let pf_Wf := (weilEtaleSitePullback h_Wf).sheafPushforwardContinuous
      AddCommGrpCat.{u} S.smallEtaleTopology W_top.smallEtaleTopology
    let Q₁ : CategoryTheory.Functor (Opposite Y.Etale) AddCommGrpCat.{u} :=
      CategoryTheory.Sheaf.cohomologyPresheaf (pf_g.obj G) 2
    let Q₂ : CategoryTheory.Functor (Opposite W_top.Etale) AddCommGrpCat.{u} :=
      CategoryTheory.Sheaf.cohomologyPresheaf G 2
    let P₁ : CategoryTheory.Functor (Opposite S.Etale) AddCommGrpCat.{u} :=
      CategoryTheory.Functor.comp (weilEtaleSitePullback f).op Q₁
    let P₂ : CategoryTheory.Functor (Opposite S.Etale) AddCommGrpCat.{u} :=
      CategoryTheory.Functor.comp (weilEtaleSitePullback h_Wf).op Q₂
    let η₁ := (CategoryTheory.sheafificationAdjunction S.smallEtaleTopology
      AddCommGrpCat.{u}).unit.app P₁
    let η₂ := (CategoryTheory.sheafificationAdjunction S.smallEtaleTopology
      AddCommGrpCat.{u}).unit.app P₂
    let e_B : CategoryTheory.Iso (weilEtaleSitePullback h_Wf)
        (CategoryTheory.Functor.comp (weilEtaleSitePullback f) (weilEtaleSitePullback g)) :=
      CategoryTheory.Iso.trans
        (CategoryTheory.MorphismProperty.Over.pullbackCongr hg.symm)
        (CategoryTheory.MorphismProperty.Over.pullbackComp g f)
    let e_pf := CategoryTheory.Functor.sheafPushforwardContinuousComp' e_B.symm
      AddCommGrpCat.{u} S.smallEtaleTopology Y.smallEtaleTopology W_top.smallEtaleTopology
    ∃ (e_R2_hom : Quiver.Hom
        (weilEtaleHigherDirectImage f 2 (pf_g.obj G))
        (weilEtaleHigherDirectImage h_Wf 2 G)),
      (∀ (V : S.Etale)
         (s : ↑(Q₁.obj (Opposite.op ((weilEtaleSitePullback f).obj V)))),
         let s' : ↑(Q₂.obj (Opposite.op ((weilEtaleSitePullback h_Wf).obj V))) :=
           (CategoryTheory.Abelian.Ext.mk₀ (adj_g.counit.app G)).postcomp
             (weilPolyP1CohomologyRepSheaf W_top ((weilEtaleSitePullback h_Wf).obj V))
             (Nat.add_zero 2)
             ((CategoryTheory.Abelian.Ext.mk₀
                 (weilPolyP1CohomologyRepPullHom g
                   ((weilEtaleSitePullback f).obj V)
                   ((weilEtaleSitePullback h_Wf).obj V)
                   (e_B.hom.app V))).comp
               ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ pb_g _ _ _ _ _
                 (weilPolyP1CohomologyRepSheaf Y ((weilEtaleSitePullback f).obj V))
                 (pf_g.obj G) 2) s)
               (Nat.zero_add 2))
         (e_R2_hom.hom.app (Opposite.op V)) ((η₁.app (Opposite.op V)) s) =
           (η₂.app (Opposite.op V)) s') ∧
      (∀ (M : ℕ) (R_W : WeilTwoStepAcyclicRes W_top S h_Wf M G)
         (hSE₀_Y : ((CategoryTheory.ShortComplex.mk R_W.u₀ R_W.v₀ R_W.h₀).map pf_g).ShortExact)
         (hSE₁_Y : ((CategoryTheory.ShortComplex.mk R_W.u₁ R_W.v₁ R_W.h₁).map pf_g).ShortExact)
         (δ_bar_Y : Quiver.Hom (pf_f.obj (pf_g.obj R_W.Q₂))
           (weilEtaleHigherDirectImage f 2 (pf_g.obj G)))
         (δ_bar_W : Quiver.Hom (pf_Wf.obj R_W.Q₂) (weilEtaleHigherDirectImage h_Wf 2 G)),
         (∀ (V : S.Etale) (s : ↑((pf_f.obj (pf_g.obj R_W.Q₂)).obj.obj (Opposite.op V))),
           (δ_bar_Y.hom.app (Opposite.op V)) s =
             (η₁.app (Opposite.op V))
               ((((CategoryTheory.Abelian.Ext.mk₀
                   ((weilPolyP1CohomologyRepHomEquiv Y ((weilEtaleSitePullback f).obj V)
                     (pf_g.obj R_W.Q₂)).symm s)).comp
                 hSE₁_Y.extClass (Nat.zero_add 1)).comp
                 hSE₀_Y.extClass (Nat.one_add 1)))) →
         WeilIsTwoStepDeltaBar sys R_W δ_bar_W →
         CategoryTheory.CategoryStruct.comp δ_bar_Y e_R2_hom =
           CategoryTheory.CategoryStruct.comp (e_pf.hom.app R_W.Q₂) δ_bar_W) :=
by
  classical
  intro pf_g pb_g adj_g pf_f pf_Wf Q₁ Q₂ P₁ P₂ η₁ η₂ e_B e_pf
  have : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  have : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg' => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg')
  have : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      (weilEtaleSitePullback h).IsContinuous Z₂.smallEtaleTopology Z₁.smallEtaleTopology :=
    fun h => (sys h).hCont
  have : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      ((weilEtaleSitePullback h).sheafPushforwardContinuous
        AddCommGrpCat.{u} Z₂.smallEtaleTopology Z₁.smallEtaleTopology).IsRightAdjoint :=
    fun h => (sys h).hAdj
  have : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      ((weilEtaleSitePullback h).sheafPullback
        AddCommGrpCat.{u} Z₂.smallEtaleTopology Z₁.smallEtaleTopology).Additive :=
    fun h => (sys h).hAdd_pb
  have : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      ((weilEtaleSitePullback h).sheafPushforwardContinuous
        AddCommGrpCat.{u} Z₂.smallEtaleTopology Z₁.smallEtaleTopology).Additive :=
    fun h => (sys h).hAdd_pf
  have : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      CategoryTheory.Limits.PreservesFiniteLimits
        ((weilEtaleSitePullback h).sheafPullback
          AddCommGrpCat.{u} Z₂.smallEtaleTopology Z₁.smallEtaleTopology) :=
    fun h => (sys h).hLim_pb
  have : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      CategoryTheory.Limits.PreservesFiniteColimits
        ((weilEtaleSitePullback h).sheafPullback
          AddCommGrpCat.{u} Z₂.smallEtaleTopology Z₁.smallEtaleTopology) :=
    fun h => (sys h).hColim_pb

  
  let r_map : ∀ {Z : AlgebraicGeometry.Scheme.{u}} {V₁ V₂ : Z.Etale},
      (V₁ ⟶ V₂) → (weilPolyP1CohomologyRepSheaf Z V₁ ⟶ weilPolyP1CohomologyRepSheaf Z V₂) :=
    fun {Z V₁ V₂} ω =>
      (CategoryTheory.presheafToSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).map
        (CategoryTheory.Functor.whiskerRight (CategoryTheory.yoneda.map ω) AddCommGrpCat.free)

  have hRepRight : ∀ {Z : AlgebraicGeometry.Scheme.{u}} (V : Z.Etale)
      {H₁ H₂ : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}}
      (α : weilPolyP1CohomologyRepSheaf Z V ⟶ H₁) (φ : H₁ ⟶ H₂),
      weilPolyP1CohomologyRepHomEquiv Z V H₂ (α ≫ φ) =
        (φ.hom.app (Opposite.op V)) (weilPolyP1CohomologyRepHomEquiv Z V H₁ α) := by
    intro Z V H₁ H₂ α φ
    dsimp only [weilPolyP1CohomologyRepHomEquiv, Equiv.trans_apply]
    have h1 : ((CategoryTheory.sheafificationAdjunction Z.smallEtaleTopology AddCommGrpCat.{u}).homEquiv
        (CategoryTheory.Functor.comp (CategoryTheory.yoneda.obj V) AddCommGrpCat.free) H₂) (α ≫ φ) =
        ((CategoryTheory.sheafificationAdjunction Z.smallEtaleTopology AddCommGrpCat.{u}).homEquiv
          (CategoryTheory.Functor.comp (CategoryTheory.yoneda.obj V) AddCommGrpCat.free) H₁ α) ≫
          (CategoryTheory.sheafToPresheaf Z.smallEtaleTopology AddCommGrpCat.{u}).map φ :=
      CategoryTheory.Adjunction.homEquiv_naturality_right _ α φ
    rw [h1]
    have h2 : ((AddCommGrpCat.adj.whiskerRight (Opposite Z.Etale)).homEquiv
        (CategoryTheory.yoneda.obj V) H₂.obj)
        (((CategoryTheory.sheafificationAdjunction Z.smallEtaleTopology AddCommGrpCat.{u}).homEquiv
          (CategoryTheory.Functor.comp (CategoryTheory.yoneda.obj V) AddCommGrpCat.free) H₁ α) ≫
          φ.hom) =
        ((AddCommGrpCat.adj.whiskerRight (Opposite Z.Etale)).homEquiv
          (CategoryTheory.yoneda.obj V) H₁.obj
          ((CategoryTheory.sheafificationAdjunction Z.smallEtaleTopology AddCommGrpCat.{u}).homEquiv
            (CategoryTheory.Functor.comp (CategoryTheory.yoneda.obj V) AddCommGrpCat.free) H₁ α)) ≫
          CategoryTheory.Functor.whiskerRight φ.hom (CategoryTheory.forget AddCommGrpCat.{u}) :=
      CategoryTheory.Adjunction.homEquiv_naturality_right _ _ φ.hom
    change CategoryTheory.yonedaEquiv
      (((AddCommGrpCat.adj.whiskerRight (Opposite Z.Etale)).homEquiv
        (CategoryTheory.yoneda.obj V) H₂.obj)
        (((CategoryTheory.sheafificationAdjunction Z.smallEtaleTopology AddCommGrpCat.{u}).homEquiv
          (CategoryTheory.Functor.comp (CategoryTheory.yoneda.obj V) AddCommGrpCat.free) H₁ α) ≫
          φ.hom)) = _
    rw [h2, CategoryTheory.yonedaEquiv_comp]
    rfl

  have hRepLeft : ∀ {Z : AlgebraicGeometry.Scheme.{u}} {V₁ V₂ : Z.Etale} (ω : V₁ ⟶ V₂)
      (H : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
      (α : weilPolyP1CohomologyRepSheaf Z V₂ ⟶ H),
      weilPolyP1CohomologyRepHomEquiv Z V₁ H (r_map ω ≫ α) =
        (H.obj.map (Opposite.op ω)) (weilPolyP1CohomologyRepHomEquiv Z V₂ H α) := by
    intro Z V₁ V₂ ω H α
    dsimp only [weilPolyP1CohomologyRepHomEquiv, Equiv.trans_apply, r_map]
    have h1 : ((CategoryTheory.sheafificationAdjunction Z.smallEtaleTopology AddCommGrpCat.{u}).homEquiv
        (CategoryTheory.Functor.comp (CategoryTheory.yoneda.obj V₁) AddCommGrpCat.free) H)
        ((CategoryTheory.presheafToSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).map
          (CategoryTheory.Functor.whiskerRight (CategoryTheory.yoneda.map ω) AddCommGrpCat.free) ≫ α) =
        CategoryTheory.Functor.whiskerRight (CategoryTheory.yoneda.map ω) AddCommGrpCat.free ≫
          ((CategoryTheory.sheafificationAdjunction Z.smallEtaleTopology AddCommGrpCat.{u}).homEquiv
            (CategoryTheory.Functor.comp (CategoryTheory.yoneda.obj V₂) AddCommGrpCat.free) H α) :=
      CategoryTheory.Adjunction.homEquiv_naturality_left _ _ α
    rw [h1]
    have h2 : ((AddCommGrpCat.adj.whiskerRight (Opposite Z.Etale)).homEquiv
        (CategoryTheory.yoneda.obj V₁) H.obj)
        (CategoryTheory.Functor.whiskerRight (CategoryTheory.yoneda.map ω) AddCommGrpCat.free ≫
          ((CategoryTheory.sheafificationAdjunction Z.smallEtaleTopology AddCommGrpCat.{u}).homEquiv
            (CategoryTheory.Functor.comp (CategoryTheory.yoneda.obj V₂) AddCommGrpCat.free) H α)) =
        CategoryTheory.yoneda.map ω ≫
          ((AddCommGrpCat.adj.whiskerRight (Opposite Z.Etale)).homEquiv
            (CategoryTheory.yoneda.obj V₂) H.obj
            ((CategoryTheory.sheafificationAdjunction Z.smallEtaleTopology AddCommGrpCat.{u}).homEquiv
              (CategoryTheory.Functor.comp (CategoryTheory.yoneda.obj V₂) AddCommGrpCat.free) H α)) :=
      CategoryTheory.Adjunction.homEquiv_naturality_left _ (CategoryTheory.yoneda.map ω) _
    change CategoryTheory.yonedaEquiv
      (((AddCommGrpCat.adj.whiskerRight (Opposite Z.Etale)).homEquiv
        (CategoryTheory.yoneda.obj V₁) H.obj)
        (CategoryTheory.Functor.whiskerRight (CategoryTheory.yoneda.map ω) AddCommGrpCat.free ≫
          ((CategoryTheory.sheafificationAdjunction Z.smallEtaleTopology AddCommGrpCat.{u}).homEquiv
            (CategoryTheory.Functor.comp (CategoryTheory.yoneda.obj V₂) AddCommGrpCat.free) H α))) = _
    rw [h2, ← CategoryTheory.yonedaEquiv_naturality]
    rfl

  let ρ_pull : ∀ V : S.Etale,
      weilPolyP1CohomologyRepSheaf W_top ((weilEtaleSitePullback h_Wf).obj V) ⟶
        pb_g.obj (weilPolyP1CohomologyRepSheaf Y ((weilEtaleSitePullback f).obj V)) :=
    fun V => weilPolyP1CohomologyRepPullHom g
      ((weilEtaleSitePullback f).obj V) ((weilEtaleSitePullback h_Wf).obj V) (e_B.hom.app V)

  have hρ_nat : ∀ {V' V : S.Etale} (ω : V' ⟶ V),
      r_map ((weilEtaleSitePullback h_Wf).map ω) ≫ ρ_pull V =
        ρ_pull V' ≫ pb_g.map (r_map ((weilEtaleSitePullback f).map ω)) := by
    intro V' V ω
    let U_Y := (weilEtaleSitePullback f).obj V
    let U'_Y := (weilEtaleSitePullback f).obj V'
    let U_W := (weilEtaleSitePullback h_Wf).obj V
    let U'_W := (weilEtaleSitePullback h_Wf).obj V'
    let ω_f := (weilEtaleSitePullback f).map ω
    let ω_Wf := (weilEtaleSitePullback h_Wf).map ω
    let R_UY := weilPolyP1CohomologyRepSheaf Y U_Y
    let R_U'Y := weilPolyP1CohomologyRepSheaf Y U'_Y
    let ι_UY := weilPolyP1CohomologyRepHomEquiv Y U_Y R_UY (CategoryTheory.CategoryStruct.id R_UY)
    let ι_U'Y := weilPolyP1CohomologyRepHomEquiv Y U'_Y R_U'Y (CategoryTheory.CategoryStruct.id R_U'Y)
    apply (weilPolyP1CohomologyRepHomEquiv W_top U'_W (pb_g.obj R_UY)).injective
    have hLHS : weilPolyP1CohomologyRepHomEquiv W_top U'_W (pb_g.obj R_UY)
        (r_map ω_Wf ≫ ρ_pull V) =
