    let c : ∀ a : SimplexCategory, CategoryTheory.Limits.Cone
        (CategoryTheory.Limits.WidePullbackShape.wideCospan U_K
          (fun _ : Fin (a.len + 1) => W_K) (fun _ : Fin (a.len + 1) => f_K)) :=
      fun a => CategoryTheory.Limits.WidePullbackShape.mkCone (b_map a.len)
        (fun i : Fin (a.len + 1) => π_map a.len i)
