  have hρ_nat : ∀ {V₁ V₂ : S.Etale} (v : V₂ ⟶ V₁),
      Z_fun.map (B_f.map (B_S.map v)) ≫ ρ_V V₁ =
        ρ_V V₂ ≫ pb_Y.map (Z_fun.map (B_f.map v)) := by
    intro V₁ V₂ v
    let R₁ := weilPolyP1CohomologyRepSheaf Y (B_f.obj V₁)
    let ι₁ := weilPolyP1CohomologyRepHomEquiv Y (B_f.obj V₁) R₁ (𝟙 R₁)
    let s₁ : ↑((pb_Y.obj R₁).obj.obj (Opposite.op (B_Y.obj (B_f.obj V₁)))) :=
      ((adj_Y.unit.app R₁).hom.app (Opposite.op (B_f.obj V₁))) ι₁
    apply (weilPolyP1CohomologyRepHomEquiv Y (B_f.obj (B_S.obj V₂)) (pb_Y.obj R₁)).injective
    rw [hRep_left, hRep_pullHom]
    have h_lhs : weilPolyP1CohomologyRepHomEquiv Y (B_f.obj (B_S.obj V₁)) (pb_Y.obj R₁)
