  have hRefine : ∀ (S : CategoryTheory.Sieve (topObj E)),
      S ∈ weilC1AffEtTop E (topObj E) →
      ∃ (L : Type u) (hFL : Field L) (hAlgL : Algebra E L)
        (hFinL : FiniteDimensional E L) (hGalL : IsGalois E L)
        (g_L : (@weilC1AffEtForgetSite E L _ hFL hAlgL hFinL
