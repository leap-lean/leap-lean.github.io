            (congrFun (Θ_eqv.apply_symm_apply (Pi.single (M := R_sh) τ₁ a)) τ₁).trans
              (Pi.single_eq_same (M := R_sh) τ₁ a)
          exact (congrArg (f₁.left.unop).hom hw).symm.trans
            ((RingHom.congr_fun hRingEq w).trans (congrArg (f₂.left.unop).hom hw))
        exact congrArg
          (fun k => (CategoryTheory.ConcreteCategory.hom
            ((ℱ.obj.comp (CategoryTheory.forget AddCommGrpCat.{u})).map
              (Opposite.op k))) (s τ₁))
          hf12
      · have h10 : (1 : ↑Z.left.unop) = 0 := by
          let ε := Θ_eqv.symm (Pi.single (M := R_sh) τ₁ 1)
          have hL1 : π_τ τ₁ ε = 1 :=
            (congrFun (Θ_eqv.apply_symm_apply (Pi.single (M := R_sh) τ₁ 1)) τ₁).trans
              (Pi.single_eq_same (M := R_sh) τ₁ 1)
          have hR0 : π_τ τ₂ ε = 0 :=
            (congrFun (Θ_eqv.apply_symm_apply (Pi.single (M := R_sh) τ₁ 1)) τ₂).trans
              (Pi.single_eq_of_ne (M := R_sh) (Ne.symm hτ) 1)
          have hEv : (f₁.left.unop).hom (π_τ τ₁ ε) = (f₂.left.unop).hom (π_τ τ₂ ε) :=
            RingHom.congr_fun hRingEq ε
          have hEv1 : (f₁.left.unop).hom (π_τ τ₁ ε) = 1 :=
            (congrArg (f₁.left.unop).hom hL1).trans (RingHom.map_one (f₁.left.unop).hom)
          have hEv2 : (f₂.left.unop).hom (π_τ τ₂ ε) = 0 :=
            (congrArg (f₂.left.unop).hom hR0).trans (RingHom.map_zero (f₂.left.unop).hom)
          exact hEv1.symm.trans (hEv.trans hEv2)
        have _ : Subsingleton ↑(ℱ.obj.obj (Opposite.op Z)) := hZeroRingSubsingleton Z h10
        exact Subsingleton.elim _ _
    exact (CategoryTheory.Presieve.isSheafFor_arrows_iff _ ι).mp hSheafArr s hCompatS

  
