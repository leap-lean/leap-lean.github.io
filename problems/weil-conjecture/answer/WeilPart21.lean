  have h_apply_mk₀ : ∀ {X Y : CategoryTheory.Sheaf J₂ A} (g : X ⟶ Y),
      (CategoryTheory.Abelian.Ext.addEquiv₀ : CategoryTheory.Abelian.Ext.{u} X Y 0 ≃+ (X ⟶ Y))
        (CategoryTheory.Abelian.Ext.mk₀ g) = g :=
    fun {X Y} g =>
      (CategoryTheory.Abelian.Ext.addEquiv₀ : CategoryTheory.Abelian.Ext.{u} X Y 0 ≃+ (X ⟶ Y)).apply_symm_apply g

  refine ⟨hCont, P_pull, adj, hAdd_pull, hAdd_push, hLim_pull, hColim_pull, hInjPush, e₀, ?_⟩
  intro M₁ M₂ φ z
  let f₂ : C₂.obj Aℤ ⟶ P_push.obj M₁ := e_ext₂ M₁ z
  have hz : z = CategoryTheory.Abelian.Ext.mk₀ f₂ :=
    (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply z).symm
  let u₁ : Aℤ ⟶ M₁.obj.obj (Opposite.op (B.obj T₂)) :=
    (adj₂.homEquiv Aℤ (P_push.obj M₁)) f₂
  let g₁ : C₁.obj Aℤ ⟶ M₁ := (adj₁.homEquiv Aℤ M₁).symm u₁
  have he₀_z : e₀ M₁ z = CategoryTheory.Abelian.Ext.mk₀ g₁ := by
    change e_ext₁_inv M₁ (e_adj₁_inv M₁ (e_adj₂ M₁ (e_ext₂ M₁ z))) = _
    change CategoryTheory.Abelian.Ext.addEquiv₀.symm g₁ = _
    exact h_symm_mk₀ g₁
  have hcomp_lhs : z.comp (CategoryTheory.Abelian.Ext.mk₀ (P_push.map φ)) (Nat.add_zero 0) =
      CategoryTheory.Abelian.Ext.mk₀ (f₂ ≫ P_push.map φ) := by
    rw [hz, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
  have hadj₂_nat : e_adj₂ M₂ (e_ext₂ M₂ (CategoryTheory.Abelian.Ext.mk₀ (f₂ ≫ P_push.map φ))) =
      (adj₁.homEquiv Aℤ M₂) (g₁ ≫ φ) := by
    change (adj₂.homEquiv Aℤ (P_push.obj M₂))
        (CategoryTheory.Abelian.Ext.addEquiv₀ (CategoryTheory.Abelian.Ext.mk₀ (f₂ ≫ P_push.map φ))) = _
    rw [h_apply_mk₀, adj₂.homEquiv_naturality_right f₂ (P_push.map φ)]
    have hg₁_u₁ : (adj₁.homEquiv Aℤ M₁) g₁ = u₁ := (adj₁.homEquiv Aℤ M₁).apply_symm_apply u₁
    rw [adj₁.homEquiv_naturality_right g₁ φ, hg₁_u₁]
    rfl
  rw [hcomp_lhs, he₀_z, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
  change e_ext₁_inv M₂ (e_adj₁_inv M₂ (e_adj₂ M₂ (e_ext₂ M₂
    (CategoryTheory.Abelian.Ext.mk₀ (f₂ ≫ P_push.map φ))))) = _
  rw [hadj₂_nat]
  change CategoryTheory.Abelian.Ext.addEquiv₀.symm
    ((adj₁.homEquiv Aℤ M₂).symm ((adj₁.homEquiv Aℤ M₂) (g₁ ≫ φ))) = _
  rw [(adj₁.homEquiv Aℤ M₂).symm_apply_apply, h_symm_mk₀]

theorem weil_alt_cd_higherDirectImage_injective_step {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom S₁ S₂)
    [hCont : (weilAltCdSitePullback h).IsContinuous S₂.smallEtaleTopology S₁.smallEtaleTopology]
    (W I Q : CategoryTheory.Sheaf S₁.smallEtaleTopology AddCommGrpCat.{u})
    [CategoryTheory.Injective I]
    (j : Quiver.Hom W I) (p : Quiver.Hom I Q)
    (hjp : CategoryTheory.CategoryStruct.comp j p = 0)
    (hSE : (CategoryTheory.ShortComplex.mk j p hjp).ShortExact) :
    let P_push := (weilAltCdSitePullback h).sheafPushforwardContinuous AddCommGrpCat.{u}
      S₂.smallEtaleTopology S₁.smallEtaleTopology
    (∀ (r : ℕ), 1 ≤ r →
      Nonempty (weilAltCdHigherDirectImage h r Q ≅ weilAltCdHigherDirectImage h (r + 1) W)) ∧
    ∃ (ℬ : CategoryTheory.Sheaf S₂.smallEtaleTopology AddCommGrpCat.{u})
      (π_B : Quiver.Hom (P_push.obj I) ℬ)
      (ι_B : Quiver.Hom ℬ (P_push.obj Q))
      (δ_B : Quiver.Hom (P_push.obj Q) (weilAltCdHigherDirectImage h 1 W))
      (h₁ : CategoryTheory.CategoryStruct.comp (P_push.map j) π_B = 0)
      (h₂ : CategoryTheory.CategoryStruct.comp ι_B δ_B = 0),
      CategoryTheory.CategoryStruct.comp π_B ι_B = P_push.map p ∧
      (CategoryTheory.ShortComplex.mk (P_push.map j) π_B h₁).ShortExact ∧
      (CategoryTheory.ShortComplex.mk ι_B δ_B h₂).ShortExact :=
by
  let J₁ := S₁.smallEtaleTopology
  let J₂ := S₂.smallEtaleTopology
  let B := weilAltCdSitePullback h
  let P_push := B.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
  let Shf := CategoryTheory.presheafToSheaf J₂ AddCommGrpCat.{u}
  let F_w : CategoryTheory.Functor (CategoryTheory.Functor (S₁.Etale)ᵒᵖ (Type u))
      (CategoryTheory.Functor (S₁.Etale)ᵒᵖ AddCommGrpCat.{u}) :=
    (CategoryTheory.Functor.whiskeringRight (S₁.Etale)ᵒᵖ (Type u) AddCommGrpCat.{u}).obj
      AddCommGrpCat.free
  let G_w : CategoryTheory.Functor (CategoryTheory.Functor (S₁.Etale)ᵒᵖ AddCommGrpCat.{u})
      (CategoryTheory.Functor (S₁.Etale)ᵒᵖ (Type u)) :=
    (CategoryTheory.Functor.whiskeringRight (S₁.Etale)ᵒᵖ AddCommGrpCat.{u} (Type u)).obj
      (CategoryTheory.forget AddCommGrpCat.{u})
  let adj_w : F_w ⊣ G_w := AddCommGrpCat.adj.whiskerRight (S₁.Etale)ᵒᵖ
  let F_shf := CategoryTheory.presheafToSheaf J₁ AddCommGrpCat.{u}
  let adj_shf := CategoryTheory.sheafificationAdjunction J₁ AddCommGrpCat.{u}
  let L_fun : CategoryTheory.Functor S₁.Etale (CategoryTheory.Sheaf J₁ AddCommGrpCat.{u}) :=
    CategoryTheory.yoneda.comp (F_w.comp F_shf)
  let δ_pre : ∀ (q q' : ℕ) (hq : q + 1 = q'),
      Quiver.Hom (Q.cohomologyPresheaf q) (W.cohomologyPresheaf q') :=
    fun q q' hq =>
      { app := fun X =>
          AddCommGrpCat.ofHom (hSE.extClass.postcomp (L_fun.obj X.unop) hq)
        naturality := fun {X₁ X₂} u =>
          AddCommGrpCat.ext fun x =>
            CategoryTheory.Abelian.Ext.comp_assoc
              (CategoryTheory.Abelian.Ext.mk₀ (L_fun.map u.unop)) x hSE.extClass
              (Nat.zero_add q) hq (by omega) }
  refine ⟨?_, ?_⟩
  · intro r hr
    cases r with
    | zero => omega
    | succ r₀ =>
      let δ_r := δ_pre (r₀ + 1) ((r₀ + 1) + 1) rfl
      have hIsoApp : ∀ X : (S₁.Etale)ᵒᵖ, CategoryTheory.IsIso (δ_r.app X) := by
        intro X
        rw [CategoryTheory.ConcreteCategory.isIso_iff_bijective]
        let f_hom : CategoryTheory.Abelian.Ext.{u} (L_fun.obj X.unop) Q (r₀ + 1) →+
            CategoryTheory.Abelian.Ext.{u} (L_fun.obj X.unop) W ((r₀ + 1) + 1) :=
          hSE.extClass.postcomp (L_fun.obj X.unop) rfl
        change Function.Bijective f_hom
        refine ⟨?_, ?_⟩
        · intro x₁ x₂ h12
          have hsub : f_hom (x₁ - x₂) = 0 := by rw [map_sub, h12, sub_self]
          have hcomp0 : (x₁ - x₂).comp hSE.extClass rfl = 0 := hsub
          obtain ⟨z, hz⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₃
            (L_fun.obj X.unop) hSE (x₁ - x₂) rfl hcomp0
          have hz0 : z = 0 := CategoryTheory.Abelian.Ext.eq_zero_of_injective z
          have hx0 : x₁ - x₂ = 0 := by
            rw [← hz, hz0, CategoryTheory.Abelian.Ext.zero_comp]
          exact sub_eq_zero.mp hx0
        · intro y
          have hyj : y.comp (CategoryTheory.Abelian.Ext.mk₀ j)
              (Nat.add_zero ((r₀ + 1) + 1)) = 0 :=
            CategoryTheory.Abelian.Ext.eq_zero_of_injective _
          obtain ⟨x, hx⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁
            (L_fun.obj X.unop) hSE y hyj rfl
          exact ⟨x, hx⟩
      have : CategoryTheory.IsIso δ_r := CategoryTheory.NatIso.isIso_of_isIso_app δ_r
      let iso_r : Q.cohomologyPresheaf (r₀ + 1) ≅ W.cohomologyPresheaf ((r₀ + 1) + 1) :=
        CategoryTheory.asIso δ_r
      let iso_whisk :=
        ((CategoryTheory.Functor.whiskeringLeft (S₂.Etale)ᵒᵖ (S₁.Etale)ᵒᵖ
          AddCommGrpCat.{u}).obj B.op).mapIso iso_r
      exact ⟨Shf.mapIso iso_whisk⟩
  · have h_addEquiv₀_mk₀ : ∀ {X Y : CategoryTheory.Sheaf J₁ AddCommGrpCat.{u}} (g : Quiver.Hom X Y),
        CategoryTheory.Abelian.Ext.addEquiv₀ (CategoryTheory.Abelian.Ext.mk₀ g) = g := by
      intro X Y g
      obtain ⟨x, rfl⟩ := (CategoryTheory.Abelian.Ext.addEquiv₀ (X := X) (Y := Y)).surjective g
      exact congrArg CategoryTheory.Abelian.Ext.addEquiv₀
        (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply x)
    let e₃_equiv : ∀ (F : CategoryTheory.Sheaf J₁ AddCommGrpCat.{u}) (U : S₁.Etale),
        (Quiver.Hom (F_w.obj (CategoryTheory.yoneda.obj U)) F.obj) ≃
          ↥(F.obj.obj (Opposite.op U)) :=
      fun F U =>
        (adj_w.homEquiv (CategoryTheory.yoneda.obj U) F.obj).trans CategoryTheory.yonedaEquiv
    let u₀ : ∀ U : S₁.Etale,
        ↥((F_w.obj (CategoryTheory.yoneda.obj U)).obj (Opposite.op U)) :=
      fun U =>
        (CategoryTheory.ConcreteCategory.hom
          ((adj_w.unit.app (CategoryTheory.yoneda.obj U)).app (Opposite.op U)))
          (CategoryTheory.CategoryStruct.id U)
    have he₃_eval : ∀ (F : CategoryTheory.Sheaf J₁ AddCommGrpCat.{u}) (U : S₁.Etale)
        (α : Quiver.Hom (F_w.obj (CategoryTheory.yoneda.obj U)) F.obj),
        e₃_equiv F U α = (α.app (Opposite.op U)).hom (u₀ U) := by
      intro F U α
      dsimp only [e₃_equiv]
      rw [Equiv.trans_apply, CategoryTheory.yonedaEquiv_apply, CategoryTheory.Adjunction.homEquiv_unit]
      rfl
    let e₃ : ∀ (F : CategoryTheory.Sheaf J₁ AddCommGrpCat.{u}) (U : S₁.Etale),
        (Quiver.Hom (F_w.obj (CategoryTheory.yoneda.obj U)) F.obj) ≃+
          ↥(F.obj.obj (Opposite.op U)) :=
      fun F U =>
        { toEquiv := e₃_equiv F U
          map_add' := fun α₁ α₂ => by
            change e₃_equiv F U (α₁ + α₂) = e₃_equiv F U α₁ + e₃_equiv F U α₂
            rw [he₃_eval, he₃_eval, he₃_eval]
            simp }
    let e_add : ∀ (F : CategoryTheory.Sheaf J₁ AddCommGrpCat.{u}) (U : S₁.Etale),
        CategoryTheory.Abelian.Ext.{u} (L_fun.obj U) F 0 ≃+ ↥(F.obj.obj (Opposite.op U)) :=
      fun F U =>
        (CategoryTheory.Abelian.Ext.addEquiv₀ (X := L_fun.obj U) (Y := F)).trans
          ((adj_shf.homAddEquiv (F_w.obj (CategoryTheory.yoneda.obj U)) F).trans (e₃ F U))
    have h_contra : ∀ (F : CategoryTheory.Sheaf J₁ AddCommGrpCat.{u})
        {U₁ U₂ : S₁.Etale} (f : Quiver.Hom U₁ U₂)
        (x : CategoryTheory.Abelian.Ext.{u} (L_fun.obj U₂) F 0),
        e_add F U₁ (((F.cohomologyPresheaf 0).map f.op).hom x) =
          (F.obj.map f.op).hom (e_add F U₂ x) := by
      intro F U₁ U₂ f x
      let g : Quiver.Hom (L_fun.obj U₂) F := CategoryTheory.Abelian.Ext.addEquiv₀ x
      have hx : CategoryTheory.Abelian.Ext.mk₀ g = x :=
        CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply x
      have hmap_x : ((F.cohomologyPresheaf 0).map f.op).hom x =
          CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.comp (L_fun.map f) g) := by
        change (CategoryTheory.Abelian.Ext.mk₀ (L_fun.map f)).comp x (Nat.zero_add 0) = _
        rw [← hx, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
      change e₃_equiv F U₁
          ((adj_shf.homEquiv (F_w.obj (CategoryTheory.yoneda.obj U₁)) F)
            (CategoryTheory.Abelian.Ext.addEquiv₀ (((F.cohomologyPresheaf 0).map f.op).hom x))) =
        (F.obj.map f.op).hom
          (e₃_equiv F U₂ ((adj_shf.homEquiv (F_w.obj (CategoryTheory.yoneda.obj U₂)) F) g))
      rw [hmap_x, h_addEquiv₀_mk₀]
      have hL : L_fun.map f = F_shf.map (F_w.map (CategoryTheory.yoneda.map f)) := rfl
      rw [hL, adj_shf.homEquiv_naturality_left]
      dsimp only [e₃_equiv, Equiv.trans_apply]
      rw [adj_w.homEquiv_naturality_left, ← CategoryTheory.yonedaEquiv_naturality]
      rfl
    have h_contra_symm : ∀ (F : CategoryTheory.Sheaf J₁ AddCommGrpCat.{u})
        {U₁ U₂ : S₁.Etale} (f : Quiver.Hom U₁ U₂) (z : ↥(F.obj.obj (Opposite.op U₂))),
        (e_add F U₁).symm ((F.obj.map f.op).hom z) =
          (CategoryTheory.Abelian.Ext.mk₀ (L_fun.map f)).comp
            ((e_add F U₂).symm z) (Nat.zero_add 0) := by
      intro F U₁ U₂ f z
      apply (e_add F U₁).injective
      rw [AddEquiv.apply_symm_apply]
      exact ((h_contra F f ((e_add F U₂).symm z)).trans
        (congrArg (F.obj.map f.op).hom (AddEquiv.apply_symm_apply (e_add F U₂) z))).symm
    have h_cov : ∀ {F₁ F₂ : CategoryTheory.Sheaf J₁ AddCommGrpCat.{u}}
        (φ : Quiver.Hom F₁ F₂) (U : S₁.Etale)
        (x : CategoryTheory.Abelian.Ext.{u} (L_fun.obj U) F₁ 0),
        e_add F₂ U (x.comp (CategoryTheory.Abelian.Ext.mk₀ φ) (Nat.add_zero 0)) =
          (φ.hom.app (Opposite.op U)).hom (e_add F₁ U x) := by
      intro F₁ F₂ φ U x
      let g : Quiver.Hom (L_fun.obj U) F₁ := CategoryTheory.Abelian.Ext.addEquiv₀ x
      have hx : CategoryTheory.Abelian.Ext.mk₀ g = x :=
        CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply x
      have hcomp_x : x.comp (CategoryTheory.Abelian.Ext.mk₀ φ) (Nat.add_zero 0) =
          CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.comp g φ) := by
        rw [← hx, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
      change e₃_equiv F₂ U
          ((adj_shf.homEquiv (F_w.obj (CategoryTheory.yoneda.obj U)) F₂)
            (CategoryTheory.Abelian.Ext.addEquiv₀
              (x.comp (CategoryTheory.Abelian.Ext.mk₀ φ) (Nat.add_zero 0)))) =
        (φ.hom.app (Opposite.op U)).hom
          (e₃_equiv F₁ U ((adj_shf.homEquiv (F_w.obj (CategoryTheory.yoneda.obj U)) F₁) g))
      rw [hcomp_x, h_addEquiv₀_mk₀, adj_shf.homEquiv_naturality_right, he₃_eval, he₃_eval]
      rfl
    have h_cov_symm : ∀ {F₁ F₂ : CategoryTheory.Sheaf J₁ AddCommGrpCat.{u}}
        (φ : Quiver.Hom F₁ F₂) (U : S₁.Etale) (s : ↥(F₁.obj.obj (Opposite.op U))),
        (e_add F₂ U).symm ((φ.hom.app (Opposite.op U)).hom s) =
          ((e_add F₁ U).symm s).comp (CategoryTheory.Abelian.Ext.mk₀ φ) (Nat.add_zero 0) := by
      intro F₁ F₂ φ U s
      apply (e_add F₂ U).injective
      rw [AddEquiv.apply_symm_apply, h_cov φ U ((e_add F₁ U).symm s), AddEquiv.apply_symm_apply]
    let δ₀ : Quiver.Hom Q.obj (W.cohomologyPresheaf 1) :=
      { app := fun X => AddCommGrpCat.ofHom
          ((hSE.extClass.postcomp (L_fun.obj X.unop) (Nat.zero_add 1)).comp
            (e_add Q X.unop).symm.toAddMonoidHom)
        naturality := fun {X₁ X₂} u =>
          AddCommGrpCat.ext fun z => by
            change ((e_add Q X₂.unop).symm ((Q.obj.map u).hom z)).comp hSE.extClass
                (Nat.zero_add 1) =
              (CategoryTheory.Abelian.Ext.mk₀ (L_fun.map u.unop)).comp
                (((e_add Q X₁.unop).symm z).comp hSE.extClass (Nat.zero_add 1)) (Nat.zero_add 1)
            have hsymm : (e_add Q X₂.unop).symm ((Q.obj.map u).hom z) =
                (CategoryTheory.Abelian.Ext.mk₀ (L_fun.map u.unop)).comp
                  ((e_add Q X₁.unop).symm z) (Nat.zero_add 0) :=
              h_contra_symm Q u.unop z
            rw [hsymm]
            exact CategoryTheory.Abelian.Ext.comp_assoc
              (CategoryTheory.Abelian.Ext.mk₀ (L_fun.map u.unop))
              ((e_add Q X₁.unop).symm z) hSE.extClass
              (Nat.zero_add 0) (Nat.zero_add 1) (Nat.zero_add 1) }
    have hpδ₀ : CategoryTheory.CategoryStruct.comp p.hom δ₀ = 0 := by
      ext X y
      change ((e_add Q X.unop).symm ((p.hom.app (Opposite.op X.unop)).hom y)).comp
          hSE.extClass (Nat.zero_add 1) = 0
      rw [h_cov_symm p X.unop y,
        CategoryTheory.Abelian.Ext.comp_assoc ((e_add I X.unop).symm y)
          (CategoryTheory.Abelian.Ext.mk₀ p) hSE.extClass
          (Nat.add_zero 0) (Nat.zero_add 1) (Nat.zero_add 1),
        hSE.comp_extClass, CategoryTheory.Abelian.Ext.comp_zero]
    have hInj_W : ∀ U : S₁.Etale, Function.Injective (j.hom.app (Opposite.op U)).hom := by
      have : CategoryTheory.Mono j := hSE.mono_f
      have : CategoryTheory.Mono j.hom :=
        (CategoryTheory.sheafToPresheaf J₁ AddCommGrpCat.{u}).map_mono j
      intro U
      rw [← AddCommGrpCat.mono_iff_injective]
      exact (CategoryTheory.NatTrans.mono_iff_mono_app j.hom).mp inferInstance (Opposite.op U)
    have hEx_I : ∀ (U : S₁.Etale) (y : ↥(I.obj.obj (Opposite.op U))),
        (p.hom.app (Opposite.op U)).hom y = 0 →
        ∃ w : ↥(W.obj.obj (Opposite.op U)), (j.hom.app (Opposite.op U)).hom w = y := by
      intro U y hy
      have hy_ext : ((e_add I U).symm y).comp (CategoryTheory.Abelian.Ext.mk₀ p)
          (Nat.add_zero 0) = 0 := by
        rw [← h_cov_symm p U y, hy, map_zero]
      obtain ⟨x_W, hx_W⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₂
        (L_fun.obj U) hSE ((e_add I U).symm y) hy_ext
      refine ⟨e_add W U x_W, ?_⟩
      rw [← h_cov j U x_W, hx_W, AddEquiv.apply_symm_apply]
    have hEx_Q : ∀ (U : S₁.Etale) (z : ↥(Q.obj.obj (Opposite.op U))),
        (δ₀.app (Opposite.op U)).hom z = 0 →
        ∃ y : ↥(I.obj.obj (Opposite.op U)), (p.hom.app (Opposite.op U)).hom y = z := by
      intro U z hz
      have hz_ext : ((e_add Q U).symm z).comp hSE.extClass (Nat.zero_add 1) = 0 := hz
      obtain ⟨x_I, hx_I⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₃
        (L_fun.obj U) hSE ((e_add Q U).symm z) (Nat.zero_add 1) hz_ext
      refine ⟨e_add I U x_I, ?_⟩
      rw [← h_cov p U x_I, hx_I, AddEquiv.apply_symm_apply]
    have hSurj_δ₀ : ∀ U : S₁.Etale, Function.Surjective (δ₀.app (Opposite.op U)).hom := by
      intro U w₁
      have hw₁_j : w₁.comp (CategoryTheory.Abelian.Ext.mk₀ j) (Nat.add_zero (0 + 1)) = 0 :=
        CategoryTheory.Abelian.Ext.eq_zero_of_injective _
      obtain ⟨x_Q, hx_Q⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁
        (L_fun.obj U) hSE w₁ hw₁_j (Nat.zero_add 1)
      refine ⟨e_add Q U x_Q, ?_⟩
      change ((e_add Q U).symm (e_add Q U x_Q)).comp hSE.extClass (Nat.zero_add 1) = w₁
      rw [AddEquiv.symm_apply_apply]
      exact hx_Q
    let F₁ := P_push.obj W
    let F₂ := P_push.obj I
    let F₃ := P_push.obj Q
    let f₁₂ := P_push.map j
    let f₂₃ := P_push.map p
    let P₄ : CategoryTheory.Functor (S₂.Etale)ᵒᵖ AddCommGrpCat.{u} :=
      CategoryTheory.Functor.comp B.op (W.cohomologyPresheaf 1)
    let d₃₄ : Quiver.Hom F₃.obj P₄ := B.op.whiskerLeft δ₀
    have hInj_F₁₂ : ∀ X : (S₂.Etale)ᵒᵖ, Function.Injective (f₁₂.hom.app X).hom :=
      fun X => hInj_W (B.obj X.unop)
    have hEx_F₁₂ : ∀ (X : (S₂.Etale)ᵒᵖ) (y : ↥(F₂.obj.obj X)),
        (f₂₃.hom.app X).hom y = 0 →
        ∃ v : ↥(F₁.obj.obj X), (f₁₂.hom.app X).hom v = y :=
      fun X y hy => hEx_I (B.obj X.unop) y hy
    have h₁₂₃ : CategoryTheory.CategoryStruct.comp f₁₂.hom f₂₃.hom = 0 := by
      ext X x
      have hjp_X : ((CategoryTheory.CategoryStruct.comp j p).hom.app
          (Opposite.op (B.obj X.unop))).hom x = 0 := by
        rw [hjp]; rfl
      exact hjp_X
    have h₂₃₄ : CategoryTheory.CategoryStruct.comp f₂₃.hom d₃₄ = 0 := by
      ext X y
      have hpδ_X : ((CategoryTheory.CategoryStruct.comp p.hom δ₀).app
          (Opposite.op (B.obj X.unop))).hom y = 0 := by
        rw [hpδ₀]; rfl
      exact hpδ_X
    let B_pre : CategoryTheory.Functor (S₂.Etale)ᵒᵖ AddCommGrpCat.{u} :=
      { obj := fun X => AddCommGrpCat.of ↥((f₂₃.hom.app X).hom.range)
        map := fun {X Y} u => AddCommGrpCat.ofHom
          { toFun := fun z => ⟨(F₃.obj.map u).hom z.1, by
              rcases z.2 with ⟨x, hx⟩
              refine ⟨(F₂.obj.map u).hom x, ?_⟩
              have hnat := congrArg (fun m => m.hom x) (f₂₃.hom.naturality u)
              change (f₂₃.hom.app Y).hom ((F₂.obj.map u).hom x) =
                (F₃.obj.map u).hom ((f₂₃.hom.app X).hom x) at hnat
              rw [hnat, hx]⟩
            map_zero' := Subtype.ext (map_zero _)
            map_add' := fun a b => Subtype.ext (map_add _ a.1 b.1) }
        map_id := fun X => AddCommGrpCat.ext fun z => Subtype.ext (by
          change ((F₃.obj.map (CategoryTheory.CategoryStruct.id X)).hom) z.1 = z.1
          rw [F₃.obj.map_id]
          rfl)
        map_comp := fun {X Y Z} u v => AddCommGrpCat.ext fun z => Subtype.ext (by
          change ((F₃.obj.map (CategoryTheory.CategoryStruct.comp u v)).hom) z.1 =
            (F₃.obj.map v).hom ((F₃.obj.map u).hom z.1)
          rw [F₃.obj.map_comp]
          rfl) }
    let π_pre : Quiver.Hom F₂.obj B_pre :=
      { app := fun X => AddCommGrpCat.ofHom (f₂₃.hom.app X).hom.rangeRestrict
        naturality := fun {X Y} u => AddCommGrpCat.ext fun x => Subtype.ext
          (congrArg (fun m => m.hom x) (f₂₃.hom.naturality u)) }
    let ι_pre : Quiver.Hom B_pre F₃.obj :=
      { app := fun X => AddCommGrpCat.ofHom (f₂₃.hom.app X).hom.range.subtype
        naturality := fun {_ _} _ => AddCommGrpCat.ext fun _ => rfl }
    have hfac_pre : CategoryTheory.CategoryStruct.comp π_pre ι_pre = f₂₃.hom := by
      ext X x
      rfl
    have h₁_pre : CategoryTheory.CategoryStruct.comp f₁₂.hom π_pre = 0 := by
      ext X x
      exact congrArg (fun m => (m.app X).hom x) h₁₂₃
    have h₂_pre : CategoryTheory.CategoryStruct.comp ι_pre d₃₄ = 0 := by
      ext X z
      rcases z with ⟨_, x, rfl⟩
      exact congrArg (fun m => (m.app X).hom x) h₂₃₄
    have hMono_f₁₂ : CategoryTheory.Mono f₁₂.hom := by
      rw [CategoryTheory.NatTrans.mono_iff_mono_app]
      intro X
      rw [AddCommGrpCat.mono_iff_injective]
      exact hInj_F₁₂ X
    have hEpi_π : CategoryTheory.Epi π_pre := by
      rw [CategoryTheory.NatTrans.epi_iff_epi_app]
      intro X
      rw [AddCommGrpCat.epi_iff_surjective]
      rintro ⟨_, x, rfl⟩
      exact ⟨x, rfl⟩
    have hk₁ : CategoryTheory.Limits.IsLimit
        (CategoryTheory.Limits.KernelFork.ofι f₁₂.hom h₁_pre) :=
      CategoryTheory.Limits.KernelFork.IsLimit.ofι _ _
        (fun {W'} s hs =>
          let hex : ∀ (X : (S₂.Etale)ᵒᵖ) (w : ↥(W'.obj X)),
              ∃ v : ↥(F₁.obj.obj X), (f₁₂.hom.app X).hom v = (s.app X).hom w := fun X w =>
            hEx_F₁₂ X ((s.app X).hom w)
              (congrArg (fun m => ((m.app X).hom w).1) hs)
          { app := fun X => AddCommGrpCat.ofHom
              ({ toFun := fun w => Classical.choose (hex X w)
                 map_zero' := hInj_F₁₂ X
                   ((Classical.choose_spec (hex X 0)).trans
                     ((map_zero (s.app X).hom).trans (map_zero (f₁₂.hom.app X).hom).symm))
                 map_add' := fun a b => hInj_F₁₂ X
                   ((Classical.choose_spec (hex X (a + b))).trans
                     ((map_add (s.app X).hom a b).trans
                       ((congrArg₂ (· + ·) (Classical.choose_spec (hex X a)).symm
                           (Classical.choose_spec (hex X b)).symm).trans
                         (map_add (f₁₂.hom.app X).hom _ _).symm))) } :
                ↥(W'.obj X) →+ ↥(F₁.obj.obj X))
            naturality := fun {X Y} u => AddCommGrpCat.ext fun w => by
              apply hInj_F₁₂ Y
              have h1 : (f₁₂.hom.app Y).hom ((F₁.obj.map u).hom (Classical.choose (hex X w))) =
                  (F₂.obj.map u).hom ((f₁₂.hom.app X).hom (Classical.choose (hex X w))) :=
                congrArg (fun m => m.hom (Classical.choose (hex X w))) (f₁₂.hom.naturality u)
              have h2 : (s.app Y).hom ((W'.map u).hom w) =
                  (F₂.obj.map u).hom ((s.app X).hom w) :=
                congrArg (fun m => m.hom w) (s.naturality u)
              change (f₁₂.hom.app Y).hom (Classical.choose (hex Y ((W'.map u).hom w))) =
                (f₁₂.hom.app Y).hom ((F₁.obj.map u).hom (Classical.choose (hex X w)))
              rw [Classical.choose_spec (hex Y ((W'.map u).hom w)), h1,
                Classical.choose_spec (hex X w), h2] })
        (fun {W'} s hs => by
          ext X w
          exact Classical.choose_spec
            (hEx_F₁₂ X ((s.app X).hom w)
              (congrArg (fun m => ((m.app X).hom w).1) hs)))
        (fun {W'} s hs m₀ hm₀ => by
          have : CategoryTheory.Mono f₁₂.hom := hMono_f₁₂
          rw [← CategoryTheory.cancel_mono f₁₂.hom, hm₀]
          symm
          ext X w
          exact Classical.choose_spec
            (hEx_F₁₂ X ((s.app X).hom w)
              (congrArg (fun m => ((m.app X).hom w).1) hs)))
    have hSE_pre1 : (CategoryTheory.ShortComplex.mk f₁₂.hom π_pre h₁_pre).ShortExact :=
      CategoryTheory.ShortComplex.ShortExact.mk'
        (CategoryTheory.ShortComplex.exact_of_f_is_kernel _ hk₁) hMono_f₁₂ hEpi_π
    have hMono_ι : CategoryTheory.Mono ι_pre := by
      rw [CategoryTheory.NatTrans.mono_iff_mono_app]
      intro X
      rw [AddCommGrpCat.mono_iff_injective]
      exact Subtype.val_injective
    have hEpi_d : CategoryTheory.Epi d₃₄ := by
      rw [CategoryTheory.NatTrans.epi_iff_epi_app]
      intro X
      rw [AddCommGrpCat.epi_iff_surjective]
      exact hSurj_δ₀ (B.obj X.unop)
    have hk₂ : CategoryTheory.Limits.IsLimit
        (CategoryTheory.Limits.KernelFork.ofι ι_pre h₂_pre) :=
      CategoryTheory.Limits.KernelFork.IsLimit.ofι _ _
        (fun {W'} s hs =>
          { app := fun X => AddCommGrpCat.ofHom
              { toFun := fun w => ⟨(s.app X).hom w,
                  hEx_Q (B.obj X.unop) ((s.app X).hom w)
                    (congrArg (fun m => (m.app X).hom w) hs)⟩
                map_zero' := Subtype.ext (map_zero _)
                map_add' := fun a b => Subtype.ext (map_add _ a b) }
            naturality := fun {X Y} u => AddCommGrpCat.ext fun w => Subtype.ext
              (congrArg (fun m => m.hom w) (s.naturality u)) })
        (fun {_} _ _ => by
          ext X _
          rfl)
        (fun {_} _ _ m₀ hm₀ => by
          have : CategoryTheory.Mono ι_pre := hMono_ι
          rw [← CategoryTheory.cancel_mono ι_pre, hm₀]
          ext X _
          rfl)
    have hSE_pre2 : (CategoryTheory.ShortComplex.mk ι_pre d₃₄ h₂_pre).ShortExact :=
      CategoryTheory.ShortComplex.ShortExact.mk'
        (CategoryTheory.ShortComplex.exact_of_f_is_kernel _ hk₂) hMono_ι hEpi_d
    let η := CategoryTheory.sheafificationNatIso J₂ AddCommGrpCat.{u}
    let ηF : ∀ F : CategoryTheory.Sheaf J₂ AddCommGrpCat.{u}, F ≅ Shf.obj F.obj :=
      fun F => η.app F
    let ℬ : CategoryTheory.Sheaf J₂ AddCommGrpCat.{u} := Shf.obj B_pre
    let π_B : Quiver.Hom F₂ ℬ :=
      CategoryTheory.CategoryStruct.comp (ηF F₂).hom (Shf.map π_pre)
    let ι_B : Quiver.Hom ℬ F₃ :=
      CategoryTheory.CategoryStruct.comp (Shf.map ι_pre) (ηF F₃).inv
    let δ_B : Quiver.Hom F₃ (weilAltCdHigherDirectImage h 1 W) :=
      CategoryTheory.CategoryStruct.comp (ηF F₃).hom (Shf.map d₃₄)
    have hfac : CategoryTheory.CategoryStruct.comp π_B ι_B = f₂₃ := by
      have hnat : CategoryTheory.CategoryStruct.comp f₂₃ (ηF F₃).hom =
          CategoryTheory.CategoryStruct.comp (ηF F₂).hom (Shf.map f₂₃.hom) :=
        η.hom.naturality f₂₃
      calc
        (ηF F₂).hom ≫ Shf.map π_pre ≫ Shf.map ι_pre ≫ (ηF F₃).inv
          = (ηF F₂).hom ≫ (Shf.map π_pre ≫ Shf.map ι_pre) ≫ (ηF F₃).inv := by
            simp only [CategoryTheory.Category.assoc]
        _ = ((ηF F₂).hom ≫ Shf.map f₂₃.hom) ≫ (ηF F₃).inv := by
            rw [← Shf.map_comp, hfac_pre, CategoryTheory.Category.assoc]
        _ = (f₂₃ ≫ (ηF F₃).hom) ≫ (ηF F₃).inv := by rw [← hnat]
        _ = f₂₃ ≫ ((ηF F₃).hom ≫ (ηF F₃).inv) := CategoryTheory.Category.assoc _ _ _
        _ = f₂₃ := by rw [(ηF F₃).hom_inv_id, CategoryTheory.Category.comp_id]
    have h₁ : CategoryTheory.CategoryStruct.comp f₁₂ π_B = 0 := by
      have hnat : CategoryTheory.CategoryStruct.comp f₁₂ (ηF F₂).hom =
          CategoryTheory.CategoryStruct.comp (ηF F₁).hom (Shf.map f₁₂.hom) :=
        η.hom.naturality f₁₂
      calc
        f₁₂ ≫ ((ηF F₂).hom ≫ Shf.map π_pre)
          = (f₁₂ ≫ (ηF F₂).hom) ≫ Shf.map π_pre := (CategoryTheory.Category.assoc _ _ _).symm
        _ = ((ηF F₁).hom ≫ Shf.map f₁₂.hom) ≫ Shf.map π_pre := by rw [hnat]
        _ = (ηF F₁).hom ≫ (Shf.map f₁₂.hom ≫ Shf.map π_pre) :=
            CategoryTheory.Category.assoc _ _ _
        _ = (ηF F₁).hom ≫ Shf.map (CategoryTheory.CategoryStruct.comp f₁₂.hom π_pre) := by
            rw [← Shf.map_comp]
        _ = (ηF F₁).hom ≫ Shf.map 0 := by rw [h₁_pre]
        _ = 0 := by rw [Shf.map_zero, CategoryTheory.Limits.comp_zero]
    have h₂ : CategoryTheory.CategoryStruct.comp ι_B δ_B = 0 := by
      change (Shf.map ι_pre ≫ (ηF F₃).inv) ≫ ((ηF F₃).hom ≫ Shf.map d₃₄) = 0
      calc
        (Shf.map ι_pre ≫ (ηF F₃).inv) ≫ ((ηF F₃).hom ≫ Shf.map d₃₄)
          = Shf.map ι_pre ≫ ((ηF F₃).inv ≫ (ηF F₃).hom) ≫ Shf.map d₃₄ := by
            simp only [CategoryTheory.Category.assoc]
        _ = Shf.map ι_pre ≫ Shf.map d₃₄ := by
            rw [(ηF F₃).inv_hom_id, CategoryTheory.Category.id_comp]
        _ = Shf.map (CategoryTheory.CategoryStruct.comp ι_pre d₃₄) := (Shf.map_comp _ _).symm
        _ = Shf.map 0 := by rw [h₂_pre]
        _ = 0 := Shf.map_zero _ _
    have hSE_shf1 : ((CategoryTheory.ShortComplex.mk f₁₂.hom π_pre h₁_pre).map Shf).ShortExact :=
      hSE_pre1.map_of_exact Shf
    have hSE_shf2 : ((CategoryTheory.ShortComplex.mk ι_pre d₃₄ h₂_pre).map Shf).ShortExact :=
      hSE_pre2.map_of_exact Shf
    let iso₁ : (CategoryTheory.ShortComplex.mk f₁₂.hom π_pre h₁_pre).map Shf ≅
        CategoryTheory.ShortComplex.mk f₁₂ π_B h₁ :=
      CategoryTheory.ShortComplex.isoMk ((ηF F₁).symm) ((ηF F₂).symm)
        (CategoryTheory.Iso.refl ℬ)
        (by
          have hinv : Shf.map f₁₂.hom ≫ (ηF F₂).inv = (ηF F₁).inv ≫ f₁₂ :=
            η.inv.naturality f₁₂
          exact hinv.symm)
        (by
          change (ηF F₂).inv ≫ ((ηF F₂).hom ≫ Shf.map π_pre) =
            Shf.map π_pre ≫ CategoryTheory.CategoryStruct.id ℬ
          rw [← CategoryTheory.Category.assoc, (ηF F₂).inv_hom_id,
            CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id])
    let iso₂ : (CategoryTheory.ShortComplex.mk ι_pre d₃₄ h₂_pre).map Shf ≅
        CategoryTheory.ShortComplex.mk ι_B δ_B h₂ :=
      CategoryTheory.ShortComplex.isoMk (CategoryTheory.Iso.refl ℬ) ((ηF F₃).symm)
        (CategoryTheory.Iso.refl (Shf.obj P₄))
        (by
          change CategoryTheory.CategoryStruct.id ℬ ≫ (Shf.map ι_pre ≫ (ηF F₃).inv) =
            Shf.map ι_pre ≫ (ηF F₃).inv
          rw [CategoryTheory.Category.id_comp])
        (by
          change (ηF F₃).inv ≫ ((ηF F₃).hom ≫ Shf.map d₃₄) =
            Shf.map d₃₄ ≫ CategoryTheory.CategoryStruct.id (Shf.obj P₄)
          rw [← CategoryTheory.Category.assoc, (ηF F₃).inv_hom_id,
            CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id])
    exact ⟨ℬ, π_B, ι_B, δ_B, h₁, h₂, hfac,
      CategoryTheory.ShortComplex.shortExact_of_iso iso₁ hSE_shf1,
      CategoryTheory.ShortComplex.shortExact_of_iso iso₂ hSE_shf2⟩

theorem weil_alt_cd_trdeg_step_fibration_syzygy (κ K : Type u) [Field κ] [IsAlgClosed κ]
    [Field K] [Algebra κ K] (e ℓ s : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : κ) ≠ 0) (hs : e + 1 < s)
    (hFG : ∃ S : Finset K, IntermediateField.adjoin κ (S : Set K) = ⊤)
    (hTrdeg : Algebra.trdeg κ K = ((e + 1 : ℕ) : Cardinal.{u}))
    (hSubfieldColim : ∀ (L : Type u) [Field L] (𝒟 : Set (Subfield L)),
      𝒟.Nonempty → DirectedOn (· ≤ ·) 𝒟 → (∀ x : L, ∃ E ∈ 𝒟, x ∈ E) →
      ∀ (q : ℕ) (E₀ : Subfield L), E₀ ∈ 𝒟 →
        Subsingleton (weilEtaleTorsionH (AlgebraicGeometry.Spec (CommRingCat.of L)) ℓ q) →
        ∀ (ξ : weilEtaleTorsionH (AlgebraicGeometry.Spec (CommRingCat.of ↥E₀)) ℓ q),
          ∃ (E₁ : Subfield L) (hE₁ : E₁ ∈ 𝒟) (hle : E₀ ≤ E₁),
            ∀ (p : weilEtaleTorsionH (AlgebraicGeometry.Spec (CommRingCat.of ↥E₀)) ℓ q →+
                weilEtaleTorsionH (AlgebraicGeometry.Spec (CommRingCat.of ↥E₁)) ℓ q),
              WeilIsTorsionEtalePullback
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Subfield.inclusion hle))) ℓ q p →
              p ξ = 0)
    (hBaseIH : ∀ (K₀ : Type u) [Field K₀] [Algebra κ K₀],
      Algebra.trdeg κ K₀ ≤ (e : Cardinal.{u}) →
      ∀ (r : ℕ), e < r →
        ∀ (ℋ : CategoryTheory.Sheaf
          (AlgebraicGeometry.Spec (CommRingCat.of K₀)).smallEtaleTopology AddCommGrpCat.{u}),
          ℓ • CategoryTheory.CategoryStruct.id ℋ = 0 →
          Subsingleton (ℋ.H r))
    (hFiberDimOne : ∀ (κ₁ L : Type u) [Field κ₁] [IsSepClosed κ₁] [Field L] [Algebra κ₁ L],
      (ℓ : κ₁) ≠ 0 →
      Algebra.trdeg κ₁ L ≤ 1 →
      ∀ (q : ℕ), 2 ≤ q →
        Subsingleton (weilEtaleTorsionH (AlgebraicGeometry.Spec (CommRingCat.of L)) ℓ q)) :
    Subsingleton (weilEtaleTorsionH (AlgebraicGeometry.Spec (CommRingCat.of K)) ℓ s) :=
by
  have hFieldEtale : ∀ (F₀ E : Type u) [Field F₀] [Field E] [Algebra F₀ E]
      [Module.Finite F₀ E] [Algebra.IsSeparable F₀ E], Algebra.Etale F₀ E := by
    intro F₀ E _ _ _ _ _
    have : Algebra.FormallyEtale F₀ E := Algebra.FormallyEtale.of_isSeparable F₀ E
    have : Algebra.FiniteType F₀ E := @Module.Finite.finiteType F₀ E _ _ _ inferInstance
    have : Algebra.FinitePresentation F₀ E :=
      Algebra.FinitePresentation.of_finiteType.mp inferInstance
    exact {}

  have hCoverMem : ∀ (S : AlgebraicGeometry.Scheme.{u}) (U : S.Etale) (I : Type u)
      (V : I → S.Etale) (v : ∀ i : I, V i ⟶ U),
      (∀ y : ↥U.left, ∃ (i : I) (x : ↥(V i).left), (v i).left.base x = y) →
      CategoryTheory.Sieve.ofArrows V v ∈ S.smallEtaleTopology U := by
    intro S U I V v hsurj
    let P : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
      @AlgebraicGeometry.Etale
    let U' : P.Over ⊤ S := U
    let V' : I → P.Over ⊤ S := V
    let v' : ∀ i : I, V' i ⟶ U' := v
    change CategoryTheory.Sieve.ofArrows V' v' ∈
      (AlgebraicGeometry.Scheme.smallGrothendieckTopology P S) U'
    rw [AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        S (le_rfl : P ≤ P),
      CategoryTheory.Pretopology.mem_toGrothendieck]
    refine ⟨CategoryTheory.Presieve.ofArrows V' v', ?_,
      CategoryTheory.Sieve.le_generate (CategoryTheory.Presieve.ofArrows V' v')⟩
    change CategoryTheory.Presieve.ofArrows V' v' ∈
      (CategoryTheory.Precoverage.comap (CategoryTheory.MorphismProperty.Over.forget P ⊤ S)
        (CategoryTheory.Precoverage.over S (AlgebraicGeometry.Scheme.precoverage P))).coverings U'
    rw [CategoryTheory.Precoverage.mem_comap_iff, CategoryTheory.Presieve.map_ofArrows,
      CategoryTheory.Precoverage.over, CategoryTheory.Precoverage.mem_comap_iff,
      CategoryTheory.Presieve.map_ofArrows]
    refine ⟨?_, ?_⟩
    · rw [AlgebraicGeometry.Scheme.jointlySurjectivePrecoverage,
        CategoryTheory.Precoverage.mem_comap_iff, CategoryTheory.Presieve.map_ofArrows,
        CategoryTheory.Types.mem_jointlySurjectivePrecoverage_iff]
      intro y
      obtain ⟨i, x, hx⟩ := hsurj y
      exact ⟨_, _, CategoryTheory.Presieve.ofArrows.mk i, x, hx⟩
    · rintro _ _ ⟨i⟩
      exact CategoryTheory.MorphismProperty.of_postcomp P (v' i).left U'.hom
        U'.prop (by rw [CategoryTheory.MorphismProperty.Over.w (v' i)]; exact (V' i).prop)

  have hSubExact₁_inj : ∀ {C_ab : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} C_ab]
      [CategoryTheory.Abelian C_ab] [CategoryTheory.HasExt.{u} C_ab]
      (X₀ : C_ab) {S : CategoryTheory.ShortComplex C_ab} (hS : S.ShortExact)
      (_ : CategoryTheory.Injective S.X₂) (n₀ : ℕ),
      Subsingleton (CategoryTheory.Abelian.Ext.{u} X₀ S.X₃ n₀) →
      Subsingleton (CategoryTheory.Abelian.Ext.{u} X₀ S.X₁ (n₀ + 1)) := by
    intro C_ab _ _ _ X₀ S hS hInj n₀ hSub₃
    letI : CategoryTheory.Injective S.X₂ := hInj
    refine subsingleton_of_forall_eq 0 (fun x₁ => ?_)
    have hx₂ : x₁.comp (CategoryTheory.Abelian.Ext.mk₀ S.f) (Nat.add_zero (n₀ + 1)) = 0 :=
      CategoryTheory.Abelian.Ext.eq_zero_of_injective _
    obtain ⟨x₃, hx₃⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ X₀ hS x₁ hx₂ rfl
    have hx₃_zero : x₃ = 0 := @Subsingleton.elim _ hSub₃ x₃ 0
    rw [← hx₃, hx₃_zero, CategoryTheory.Abelian.Ext.zero_comp]

  have hSubExact₂ : ∀ {C_ab : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} C_ab]
      [CategoryTheory.Abelian C_ab] [CategoryTheory.HasExt.{u} C_ab]
      (X₀ : C_ab) {S : CategoryTheory.ShortComplex C_ab} (hS : S.ShortExact) (n : ℕ),
      Subsingleton (CategoryTheory.Abelian.Ext.{u} X₀ S.X₁ n) →
      Subsingleton (CategoryTheory.Abelian.Ext.{u} X₀ S.X₃ n) →
      Subsingleton (CategoryTheory.Abelian.Ext.{u} X₀ S.X₂ n) := by
    intro C_ab _ _ _ X₀ S hS n hSub₁ hSub₃
    refine subsingleton_of_forall_eq 0 (fun x₂ => ?_)
    have hx₃ : x₂.comp (CategoryTheory.Abelian.Ext.mk₀ S.g) (Nat.add_zero n) = 0 :=
      @Subsingleton.elim _ hSub₃ _ 0
    obtain ⟨x₁, hx₁⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ X₀ hS x₂ hx₃
    have hx₁_zero : x₁ = 0 := @Subsingleton.elim _ hSub₁ x₁ 0
    rw [← hx₁, hx₁_zero, CategoryTheory.Abelian.Ext.zero_comp]

  have hSubExact₃_inj : ∀ {C_ab : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} C_ab]
      [CategoryTheory.Abelian C_ab] [CategoryTheory.HasExt.{u} C_ab]
      (X₀ : C_ab) {S : CategoryTheory.ShortComplex C_ab} (hS : S.ShortExact)
      (_ : CategoryTheory.Injective S.X₂) (r₀ : ℕ) (hr₀ : 1 ≤ r₀),
      Subsingleton (CategoryTheory.Abelian.Ext.{u} X₀ S.X₁ (r₀ + 1)) →
      Subsingleton (CategoryTheory.Abelian.Ext.{u} X₀ S.X₃ r₀) := by
    intro C_ab _ _ _ X₀ S hS hInj r₀ hr₀ hSub₁
    letI : CategoryTheory.Injective S.X₂ := hInj
    obtain ⟨r', rfl⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : r₀ ≠ 0)
    refine subsingleton_of_forall_eq 0 (fun y => ?_)
    have hy0 : y.comp hS.extClass (rfl : (r' + 1) + 1 = (r' + 1) + 1) = 0 :=
      @Subsingleton.elim _ hSub₁ _ 0
    obtain ⟨z, hz⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ X₀ hS y
      (rfl : (r' + 1) + 1 = (r' + 1) + 1) hy0
    have hz0 : z = 0 := CategoryTheory.Abelian.Ext.eq_zero_of_injective z
    rw [← hz, hz0, CategoryTheory.Abelian.Ext.zero_comp]

  obtain ⟨hPullEx, hPullId, hPullComp, -, -⟩ := weil_etale_torsion_pullback_functoriality.{u}
  have hRingPullComp : ∀ {A B C : Type u} [CommRing A] [CommRing B] [CommRing C]
      (f₁ : A →+* B) (f₂ : B →+* C) (f₁₂ : A →+* C) (hf : f₂.comp f₁ = f₁₂) (q : ℕ)
      (p₁ : weilEtaleTorsionH (AlgebraicGeometry.Spec (CommRingCat.of A)) ℓ q →+
        weilEtaleTorsionH (AlgebraicGeometry.Spec (CommRingCat.of B)) ℓ q)
      (p₂ : weilEtaleTorsionH (AlgebraicGeometry.Spec (CommRingCat.of B)) ℓ q →+
        weilEtaleTorsionH (AlgebraicGeometry.Spec (CommRingCat.of C)) ℓ q)
      (p₁₂ : weilEtaleTorsionH (AlgebraicGeometry.Spec (CommRingCat.of A)) ℓ q →+
        weilEtaleTorsionH (AlgebraicGeometry.Spec (CommRingCat.of C)) ℓ q),
      WeilIsTorsionEtalePullback (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₁)) ℓ q p₁ →
      WeilIsTorsionEtalePullback (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₂)) ℓ q p₂ →
      WeilIsTorsionEtalePullback (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₁₂)) ℓ q p₁₂ →
      p₁₂ = p₂.comp p₁ := by
    intro A B C _ _ _ f₁ f₂ f₁₂ hf q p₁ p₂ p₁₂ hp₁ hp₂ hp₁₂
    have hmap : CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₂))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₁)) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom f₁₂) := by
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hf]
    exact hPullComp _ _ ℓ q p₂ p₁ p₁₂ hp₂ hp₁ (hmap.symm ▸ hp₁₂)

  obtain ⟨K₀, hFieldK₀, hAlgκK₀, hAlgK₀K, hTower, hTrK₀, hSplit⟩ :=
    weil_alt_cd_trdeg_step_fiber_subfield_splitting κ K e hFG hTrdeg
  letI : Field K₀ := hFieldK₀
  letI : Algebra κ K₀ := hAlgκK₀
  letI : Algebra K₀ K := hAlgK₀K
  letI : IsScalarTower κ K₀ K := hTower

  let S_K := AlgebraicGeometry.Spec (CommRingCat.of K)
  let S₀ := AlgebraicGeometry.Spec (CommRingCat.of K₀)
  let f : Quiver.Hom S_K S₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K₀ K))
  let G := weilEtaleTorsionSheaf S_K ℓ

  obtain ⟨hCont, P_pull, adj_f, hAddPull, hAddPush, hLimPull, hColimPull, hInjPush, e₀, he₀_nat⟩ :=
    weil_alt_cd_etale_pullback_adjunction_and_H0 f
  letI : (weilAltCdSitePullback f).IsContinuous S₀.smallEtaleTopology S_K.smallEtaleTopology :=
    hCont
  let P_push := (weilAltCdSitePullback f).sheafPushforwardContinuous AddCommGrpCat.{u}
    S₀.smallEtaleTopology S_K.smallEtaleTopology
  letI : P_push.Additive := hAddPush

  have hℓ_G : ℓ • CategoryTheory.CategoryStruct.id G = 0 := by
    have hZMod_tors : ℓ • CategoryTheory.CategoryStruct.id (AddCommGrpCat.of (ZMod ℓ)) = 0 := by
      ext x
      simp only [AddCommGrpCat.hom_nsmul, AddCommGrpCat.hom_id, AddCommGrpCat.hom_zero,
        AddMonoidHom.nsmul_apply, AddMonoidHom.id_apply, AddMonoidHom.zero_apply,
        nsmul_eq_mul, ZMod.natCast_self, zero_mul]
    have hUlift_tors : ℓ • CategoryTheory.CategoryStruct.id
        (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))) = 0 := by
      rw [← AddCommGrpCat.uliftFunctor.{u, 0}.map_id, ← CategoryTheory.Functor.map_nsmul,
        hZMod_tors, CategoryTheory.Functor.map_zero]
    let C_const := CategoryTheory.constantSheaf S_K.smallEtaleTopology AddCommGrpCat.{u}
    change ℓ • CategoryTheory.CategoryStruct.id (C_const.obj _) = 0
    rw [← C_const.map_id, ← CategoryTheory.Functor.map_nsmul, hUlift_tors,
      CategoryTheory.Functor.map_zero]

  have hℓ_PG : ℓ • CategoryTheory.CategoryStruct.id (P_push.obj G) = 0 := by
    rw [← P_push.map_id, ← CategoryTheory.Functor.map_nsmul, hℓ_G,
      CategoryTheory.Functor.map_zero]

  have hℓ_R1 : ℓ • CategoryTheory.CategoryStruct.id (weilAltCdHigherDirectImage f 1 G) = 0 := by
    have hExtTors : ∀ {C_ab : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} C_ab]
        [CategoryTheory.Abelian C_ab] [CategoryTheory.HasExt.{u} C_ab]
        (X₀ Y₀ : C_ab) (r₀ : ℕ),
        ℓ • CategoryTheory.CategoryStruct.id Y₀ = 0 →
        ∀ z : CategoryTheory.Abelian.Ext.{u} X₀ Y₀ r₀, ℓ • z = 0 := by
      intro C_ab _ _ _ X₀ Y₀ r₀ hY z
      have hnsmul : ∀ c : ℕ,
          c • z = z.comp (CategoryTheory.Abelian.Ext.mk₀ (c • CategoryTheory.CategoryStruct.id Y₀))
            (Nat.add_zero r₀) := by
        intro c
        induction c with
        | zero =>
          rw [zero_nsmul, zero_nsmul, CategoryTheory.Abelian.Ext.mk₀_zero,
            CategoryTheory.Abelian.Ext.comp_zero]
        | succ c ih =>
          rw [succ_nsmul, succ_nsmul, ih, CategoryTheory.Abelian.Ext.mk₀_add,
            CategoryTheory.Abelian.Ext.comp_add, CategoryTheory.Abelian.Ext.comp_mk₀_id]
      rw [hnsmul ℓ, hY, CategoryTheory.Abelian.Ext.mk₀_zero, CategoryTheory.Abelian.Ext.comp_zero]
    let B := weilAltCdSitePullback f
    let P : CategoryTheory.Functor (S₀.Etale)ᵒᵖ AddCommGrpCat.{u} :=
      CategoryTheory.Functor.comp B.op (CategoryTheory.Sheaf.cohomologyPresheaf G 1)
    have hP : ℓ • CategoryTheory.CategoryStruct.id P = 0 := by
      ext U z
      simp only [CategoryTheory.NatTrans.app_nsmul, CategoryTheory.NatTrans.id_app,
        CategoryTheory.NatTrans.app_zero, AddCommGrpCat.hom_nsmul, AddCommGrpCat.hom_id,
        AddCommGrpCat.hom_zero, AddMonoidHom.nsmul_apply, AddMonoidHom.id_apply,
        AddMonoidHom.zero_apply]
      dsimp [P, CategoryTheory.Sheaf.cohomologyPresheaf,
        CategoryTheory.Sheaf.cohomologyPresheafFunctor] at z ⊢
      exact hExtTors _ G 1 hℓ_G z
    let Shf₀ := CategoryTheory.presheafToSheaf S₀.smallEtaleTopology AddCommGrpCat.{u}
    change ℓ • CategoryTheory.CategoryStruct.id (Shf₀.obj P) = 0
    rw [← Shf₀.map_id, ← CategoryTheory.Functor.map_nsmul, hP, CategoryTheory.Functor.map_zero]

  have hPushH : Subsingleton ((P_push.obj G).H s) :=
    hBaseIH K₀ hTrK₀ s (by omega) (P_push.obj G) hℓ_PG
  have hR1H : Subsingleton ((weilAltCdHigherDirectImage f 1 G).H (s - 1)) :=
    hBaseIH K₀ hTrK₀ (s - 1) (by omega) (weilAltCdHigherDirectImage f 1 G) hℓ_R1

  obtain ⟨hSliceLoc, hPiVanish⟩ := weil_alt_cd_etale_slice_torsionH_and_pi_vanishing.{u}

  have hℓ_sep : (ℓ : SeparableClosure K₀) ≠ 0 := by
    let φ_κ_sep : κ →+* SeparableClosure K₀ :=
      (algebraMap K₀ (SeparableClosure K₀)).comp (algebraMap κ K₀)
    intro h0
    apply hℓ
    exact φ_κ_sep.injective (by rw [map_natCast, h0, map_zero])

  have hKill : ∀ (q : ℕ), 2 ≤ q →
      ∀ (E_init : Type u) [Field E_init] [Algebra K₀ E_init]
        [FiniteDimensional K₀ E_init] [Algebra.IsSeparable K₀ E_init]
        (ξ_init : weilEtaleTorsionH
          (AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct K₀ E_init K))) ℓ q),
      ∃ (E_fin : Type u) (_ : Field E_fin) (_ : Algebra K₀ E_fin)
        (φ : E_init →ₐ[K₀] E_fin),
        RingHom.Etale φ.toRingHom ∧
        ∀ (p : weilEtaleTorsionH
              (AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct K₀ E_init K))) ℓ q →+
            weilEtaleTorsionH
              (AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct K₀ E_fin K))) ℓ q),
          WeilIsTorsionEtalePullback
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (Algebra.TensorProduct.map φ (AlgHom.id K₀ K)).toRingHom)) ℓ q p →
          p ξ_init = 0 := by
    intro q hq E_init _ _ _ _ ξ_init
    obtain ⟨n, L, hFieldL, hAlgL, 𝒟, F₀, E₀, hFieldE₀, hAlgE₀, φ₀, e₀_ring,
      hTrL, hDir𝒟, hF₀_mem, hEt₀, hStep⟩ := hSplit E_init
    letI : ∀ j, Field (L j) := hFieldL
    letI : ∀ j, Algebra (SeparableClosure K₀) (L j) := hAlgL
    letI : Field E₀ := hFieldE₀
    letI : Algebra K₀ E₀ := hAlgE₀
    let ψ₀ : TensorProduct K₀ E_init K →+* TensorProduct K₀ E₀ K :=
      (Algebra.TensorProduct.map φ₀ (AlgHom.id K₀ K)).toRingHom
    obtain ⟨p_ψ₀, hp_ψ₀⟩ := hPullEx (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀)) ℓ q
    obtain ⟨p_e₀, hp_e₀⟩ :=
      hPullEx (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e₀_ring.toRingHom)) ℓ q
    let w₀ := p_e₀ (p_ψ₀ ξ_init)
    let p_ev₀ : ∀ j : Fin n,
        weilEtaleTorsionH (AlgebraicGeometry.Spec (CommRingCat.of (∀ i : Fin n, ↥(F₀ i)))) ℓ q →+
          weilEtaleTorsionH (AlgebraicGeometry.Spec (CommRingCat.of ↥(F₀ j))) ℓ q :=
      fun j => Classical.choose (hPullEx
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Pi.evalRingHom (fun i => ↥(F₀ i)) j))) ℓ q)
    have hp_ev₀ : ∀ j : Fin n,
        WeilIsTorsionEtalePullback
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Pi.evalRingHom (fun i => ↥(F₀ i)) j)))
          ℓ q (p_ev₀ j) :=
      fun j => Classical.choose_spec (hPullEx
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Pi.evalRingHom (fun i => ↥(F₀ i)) j))) ℓ q)
    have hExF₁ : ∀ j : Fin n,
        ∃ (F₁_j : Subfield (L j)) (_ : F₁_j ∈ 𝒟 j) (hle : F₀ j ≤ F₁_j),
          ∀ (p : weilEtaleTorsionH (AlgebraicGeometry.Spec (CommRingCat.of ↥(F₀ j))) ℓ q →+
              weilEtaleTorsionH (AlgebraicGeometry.Spec (CommRingCat.of ↥F₁_j)) ℓ q),
            WeilIsTorsionEtalePullback
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Subfield.inclusion hle))) ℓ q p →
            p (p_ev₀ j w₀) = 0 := by
      intro j
      have hSubL : Subsingleton
          (weilEtaleTorsionH (AlgebraicGeometry.Spec (CommRingCat.of (L j))) ℓ q) :=
        hFiberDimOne (SeparableClosure K₀) (L j) hℓ_sep (hTrL j) q hq
      exact hSubfieldColim (L j) (𝒟 j) (hDir𝒟 j).1 (hDir𝒟 j).2.1 (hDir𝒟 j).2.2
        q (F₀ j) (hF₀_mem j) hSubL (p_ev₀ j w₀)
    choose F₁ hF₁_mem hle₀₁ hKill_F₁ using hExF₁
    obtain ⟨E₁, hFieldE₁, hAlgE₁, φ₁, F₂, hle₁₂, e₁_ring, hEt₁, hComm⟩ :=
      hStep F₁ hF₁_mem hle₀₁
    letI : Field E₁ := hFieldE₁
    letI : Algebra K₀ E₁ := hAlgE₁
    let φ : E_init →ₐ[K₀] E₁ := φ₁.comp φ₀
    have hEt_φ : RingHom.Etale φ.toRingHom :=
      RingHom.Etale.stableUnderComposition φ₀.toRingHom φ₁.toRingHom hEt₀ hEt₁
    refine ⟨E₁, hFieldE₁, hAlgE₁, φ, hEt_φ, fun p hp => ?_⟩
    let ι_prod : (∀ j : Fin n, ↥(F₀ j)) →+* (∀ j : Fin n, ↥(F₂ j)) :=
      Pi.ringHom (fun j =>
        (Subfield.inclusion ((hle₀₁ j).trans (hle₁₂ j))).comp
          (Pi.evalRingHom (fun i => ↥(F₀ i)) j))
    obtain ⟨p_ιprod, hp_ιprod⟩ := hPullEx (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_prod)) ℓ q
    let w₁ := p_ιprod w₀
    have hw₁_zero : w₁ = 0 := by
      refine hPiVanish n ℓ q (fun j => ↥(F₂ j)) w₁ (fun j => ?_)
      obtain ⟨p_ev₂, hp_ev₂⟩ := hPullEx
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Pi.evalRingHom (fun i => ↥(F₂ i)) j))) ℓ q
      obtain ⟨p_01, hp_01⟩ := hPullEx
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Subfield.inclusion (hle₀₁ j)))) ℓ q
      obtain ⟨p_12, hp_12⟩ := hPullEx
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Subfield.inclusion (hle₁₂ j)))) ℓ q
      obtain ⟨p_c01, hp_c01⟩ := hPullEx
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          ((Subfield.inclusion (hle₀₁ j)).comp (Pi.evalRingHom (fun i => ↥(F₀ i)) j)))) ℓ q
      obtain ⟨p_c02, hp_c02⟩ := hPullEx
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          ((Pi.evalRingHom (fun i => ↥(F₂ i)) j).comp ι_prod))) ℓ q
      have hc01_eq : p_c01 = p_01.comp (p_ev₀ j) :=
        hRingPullComp _ _ _ rfl q (p_ev₀ j) p_01 p_c01 (hp_ev₀ j) hp_01 hp_c01
      have hring_eq : (Subfield.inclusion (hle₁₂ j)).comp
          ((Subfield.inclusion (hle₀₁ j)).comp (Pi.evalRingHom (fun i => ↥(F₀ i)) j)) =
          (Pi.evalRingHom (fun i => ↥(F₂ i)) j).comp ι_prod := by
        ext x
        rfl
      have hc02_eq₁ : p_c02 = p_12.comp p_c01 :=
        hRingPullComp _ _ _ hring_eq q p_c01 p_12 p_c02 hp_c01 hp_12 hp_c02
      have hc02_eq₂ : p_c02 = p_ev₂.comp p_ιprod :=
        hRingPullComp _ _ _ rfl q p_ιprod p_ev₂ p_c02 hp_ιprod hp_ev₂ hp_c02
      refine ⟨p_ev₂, hp_ev₂, ?_⟩
      have h_app : p_ev₂ w₁ = p_12 (p_01 (p_ev₀ j w₀)) := by
        change (p_ev₂.comp p_ιprod) w₀ = _
        rw [← hc02_eq₂, hc02_eq₁, hc01_eq]
        rfl
      rw [h_app, hKill_F₁ j p_01 hp_01, map_zero]
    obtain ⟨p_e₁_inv, hp_e₁_inv⟩ :=
      hPullEx (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e₁_ring.symm.toRingHom)) ℓ q
    obtain ⟨p_m₁, hp_m₁⟩ :=
      hPullEx (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (e₀_ring.toRingHom.comp ψ₀))) ℓ q
    obtain ⟨p_m₂, hp_m₂⟩ :=
      hPullEx (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (ι_prod.comp (e₀_ring.toRingHom.comp ψ₀)))) ℓ q
    have hm₁_eq : p_m₁ = p_e₀.comp p_ψ₀ :=
      hRingPullComp _ _ _ rfl q p_ψ₀ p_e₀ p_m₁ hp_ψ₀ hp_e₀ hp_m₁
    have hm₂_eq : p_m₂ = p_ιprod.comp p_m₁ :=
      hRingPullComp _ _ _ rfl q p_m₁ p_ιprod p_m₂ hp_m₁ hp_ιprod hp_m₂
    have hfull_ring : e₁_ring.symm.toRingHom.comp (ι_prod.comp (e₀_ring.toRingHom.comp ψ₀)) =
        (Algebra.TensorProduct.map φ (AlgHom.id K₀ K)).toRingHom := by
      refine RingHom.ext (fun z => ?_)
      apply e₁_ring.injective
      funext j
      change (e₁_ring (e₁_ring.symm (ι_prod (e₀_ring (ψ₀ z))))) j =
        e₁_ring (Algebra.TensorProduct.map φ (AlgHom.id K₀ K) z) j
      rw [e₁_ring.apply_symm_apply]
      have hmap_comp : Algebra.TensorProduct.map φ₁ (AlgHom.id K₀ K) (ψ₀ z) =
          Algebra.TensorProduct.map φ (AlgHom.id K₀ K) z := by
        have h_alg : (Algebra.TensorProduct.map φ₁ (AlgHom.id K₀ K)).comp
            (Algebra.TensorProduct.map φ₀ (AlgHom.id K₀ K)) =
            Algebra.TensorProduct.map φ (AlgHom.id K₀ K) :=
          Algebra.TensorProduct.ext (AlgHom.ext fun _ => rfl) (AlgHom.ext fun _ => rfl)
        exact DFunLike.congr_fun h_alg z
      rw [← hmap_comp]
      exact (hComm (ψ₀ z) j).symm
    have hp_eq : p = p_e₁_inv.comp p_m₂ :=
      hRingPullComp _ _ _ hfull_ring q p_m₂ p_e₁_inv p hp_m₂ hp_e₁_inv hp
    calc
      p ξ_init = p_e₁_inv (p_m₂ ξ_init) := by rw [hp_eq]; rfl
      _ = p_e₁_inv (p_ιprod (p_e₀ (p_ψ₀ ξ_init))) := by rw [hm₂_eq, hm₁_eq]; rfl
      _ = p_e₁_inv w₁ := rfl
      _ = p_e₁_inv 0 := by rw [hw₁_zero]
      _ = 0 := map_zero p_e₁_inv

  have hHigherZero : ∀ (q : ℕ), 2 ≤ q →
      CategoryTheory.Limits.IsZero (weilAltCdHigherDirectImage f q G) := by
    intro q hq
    obtain ⟨Θ, hΘ⟩ := hSliceLoc S_K ℓ q
    let B := weilAltCdSitePullback f
    let P : CategoryTheory.Functor (S₀.Etale)ᵒᵖ AddCommGrpCat.{u} :=
      CategoryTheory.Functor.comp B.op (CategoryTheory.Sheaf.cohomologyPresheaf G q)
    let Shf₀ := CategoryTheory.presheafToSheaf S₀.smallEtaleTopology AddCommGrpCat.{u}
    let adj_shf := CategoryTheory.sheafificationAdjunction S₀.smallEtaleTopology AddCommGrpCat.{u}
    change CategoryTheory.Limits.IsZero (Shf₀.obj P)
    rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
    apply (adj_shf.homEquiv P (Shf₀.obj P)).injective
    have h_zero : adj_shf.homEquiv P (Shf₀.obj P) 0 = 0 := by
      rw [adj_shf.homEquiv_unit, CategoryTheory.Functor.map_zero,
        CategoryTheory.Limits.comp_zero]
    have h_unit : adj_shf.homEquiv P (Shf₀.obj P) (CategoryTheory.CategoryStruct.id (Shf₀.obj P)) =
        adj_shf.unit.app P := adj_shf.homEquiv_unit P (Shf₀.obj P) _ |>.trans (CategoryTheory.Category.comp_id _)
    rw [h_zero, h_unit]
    ext U z
    change ((adj_shf.unit.app P).app U).hom z = 0
    rcases U with ⟨U⟩
    have hLocalKill : ∀ y : ↥U.left,
        ∃ (V_y : S₀.Etale) (v_y : V_y ⟶ U),
          (∃ x : ↥V_y.left, v_y.left.base x = y) ∧
          (P.map v_y.op).hom z = 0 := by
      intro y
      obtain ⟨W_aff, hAff, hyW, -⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
          (show y ∈ (⊤ : U.left.Opens) from trivial)
      let R_aff : CommRingCat.{u} := U.left.presheaf.obj (Opposite.op W_aff)
      let A : Type u := ↥R_aff
      let j_A : AlgebraicGeometry.Spec R_aff ⟶ U.left := hAff.fromSpec
      have hy_range : y ∈ Set.range j_A.base := by
        rw [hAff.range_fromSpec]
        exact hyW
      obtain ⟨p_A, hp_A⟩ := hy_range
      have hEt_jA : AlgebraicGeometry.Etale j_A := inferInstance
      let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
        @AlgebraicGeometry.Etale
      have hEt_comp : AlgebraicGeometry.Etale (j_A ≫ U.hom) :=
        P_et.comp_mem j_A U.hom hEt_jA U.prop
      let α_A : CommRingCat.of K₀ ⟶ R_aff := AlgebraicGeometry.Spec.preimage (j_A ≫ U.hom)
      have hSpec_α : AlgebraicGeometry.Spec.map α_A = j_A ≫ U.hom :=
        AlgebraicGeometry.Spec.map_preimage (j_A ≫ U.hom)
      have hEt_α : α_A.hom.Etale :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
          (hSpec_α.symm ▸ hEt_comp)
      letI : Algebra K₀ A := α_A.hom.toAlgebra
      have hEt_K₀_A : Algebra.Etale K₀ A := RingHom.etale_algebraMap.mp hEt_α
      obtain ⟨I_A, hFinI, E_i, hFieldEi, hAlgEi, e_A, hFinSep⟩ :=
        (Algebra.Etale.iff_exists_algEquiv_prod K₀ A).mp hEt_K₀_A
      letI : Finite I_A := hFinI
      letI : ∀ i, Field (E_i i) := hFieldEi
      letI : ∀ i, Algebra K₀ (E_i i) := hAlgEi
      letI : Fintype I_A := Fintype.ofFinite I_A
      letI : DecidableEq I_A := Classical.decEq I_A
      let R_prod : Type u := ∀ i : I_A, E_i i
