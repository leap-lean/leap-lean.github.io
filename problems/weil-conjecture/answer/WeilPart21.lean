      (τ_B : ∀ (a : Fin m) {i j : I}, i ≤ j → (G_B a i →+ G_B a j))
      (τ_C : ∀ (a b : Fin m) {i j : I}, i ≤ j → (G_C a b i →+ G_C a b j))
      (res_φ : ∀ (a : Fin m) (i : I), G_A i →+ G_B a i)
      (res_fst : ∀ (a b : Fin m) (i : I), G_B a i →+ G_C a b i)
      (res_snd : ∀ (a b : Fin m) (i : I), G_B b i →+ G_C a b i)
