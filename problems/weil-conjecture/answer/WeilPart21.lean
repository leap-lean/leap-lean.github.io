        (CategoryTheory.Abelian.Ext.mk₀ (γ_rel δ r)) (Nat.add_zero (2 * δ)) = u
      rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ (Nat.add_zero (2 * δ)),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, (hInv_rel δ r).2,
        CategoryTheory.Abelian.Ext.comp_mk₀_id]
    · intro v
      change (v.comp (CategoryTheory.Abelian.Ext.mk₀ (γ_rel δ r)) (Nat.add_zero (2 * δ))).comp
        (CategoryTheory.Abelian.Ext.mk₀ (Tr_rel δ r)) (Nat.add_zero (2 * δ)) = v
      rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ (Nat.add_zero (2 * δ)),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, (hInv_rel δ r).1,
        CategoryTheory.Abelian.Ext.comp_mk₀_id]
  · 
    intro δ r u cast_succ
    let φ_cast : ZMod (ℓ ^ (r + 1)) →+ ZMod (ℓ ^ r) :=
      (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r))).toAddMonoidHom
    let cast_curr : weilEtaleTorsionSheaf (Pd δ) (ℓ ^ (r + 1)) ⟶
        weilEtaleTorsionSheaf (Pd δ) (ℓ ^ r) :=
      (CategoryTheory.constantSheaf (Pd δ).smallEtaleTopology AddCommGrpCat.{u}).map
        (AddCommGrpCat.uliftFunctor.{u, 0}.map (AddCommGrpCat.ofHom φ_cast))
    have hγ_comm : cast_curr ≫ γ_rel δ r =
        γ_rel δ (r + 1) ≫ weilPolyP1HigherDirectImageMap (π_fst δ) 2 cast_succ := by
      apply (weil_rel_projLine_orientation_terminal_and_coeff_naturality.{u}
        (Y := Pd (δ + 1)) (S := Pd δ) (π_fst δ)).2
        (ℓ ^ (r + 1)) (ℓ ^ r) (hm_pow (r + 1)) (hm_pow r) φ_cast
        (p_ρ δ (r + 1) (η (r + 1))) (p_ρ δ r (η r))
        (γ_rel δ (r + 1)) (γ_rel δ r)
        (hTerm_rel δ (r + 1)) (hTerm_rel δ r)
      have hcomm : weilEtaleTorsionTransition (Pd (δ + 1)) ℓ r 2 (p_ρ δ (r + 1) (η (r + 1))) =
          p_ρ δ r (weilEtaleTorsionTransition P1 ℓ r 2 (η (r + 1))) :=
        DFunLike.congr_fun (hPull_trans (π_snd δ) ℓ r 2 (p_ρ δ (r + 1)) (p_ρ δ r)
          (hp_ρ δ (r + 1)) (hp_ρ δ r)) (η (r + 1))
      cases r with
      | zero =>
        let cast_Y0 : weilEtaleTorsionSheaf (Pd (δ + 1)) (ℓ ^ (0 + 1)) ⟶
            weilEtaleTorsionSheaf (Pd (δ + 1)) (ℓ ^ 0) :=
          (CategoryTheory.constantSheaf (Pd (δ + 1)).smallEtaleTopology AddCommGrpCat.{u}).map
            (AddCommGrpCat.uliftFunctor.{u, 0}.map (AddCommGrpCat.ofHom φ_cast))
        have h_id1 : CategoryTheory.CategoryStruct.id
            (weilEtaleTorsionSheaf (Pd (δ + 1)) (ℓ ^ 0)) = 0 := by
          have h1 := hTor_sheaf (Pd (δ + 1)) 1
          rwa [one_nsmul] at h1
        have hcs0 : cast_Y0 = 0 := by
          rw [← CategoryTheory.Category.comp_id cast_Y0, h_id1, CategoryTheory.Limits.comp_zero]
        have hval0 : (φ_cast 1).val = 0 := by
          change ((ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ 0)) (ZMod 1)) 1).val = 0
          have : NeZero 1 := ⟨by omega⟩
          exact Nat.lt_one_iff.mp (ZMod.val_lt _)
        rw [hval0, zero_nsmul]
        change (p_ρ δ 1 (η 1)).comp (CategoryTheory.Abelian.Ext.mk₀ cast_Y0) (Nat.add_zero 2) = 0
        rw [hcs0, CategoryTheory.Abelian.Ext.mk₀_zero, CategoryTheory.Abelian.Ext.comp_zero]
      | succ s =>
        have hgt1 : 1 < ℓ ^ (s + 1) :=
          lt_of_lt_of_le hPrime.one_lt (Nat.le_self_pow (by omega) ℓ)
        have : Fact (1 < ℓ ^ (s + 1)) := ⟨hgt1⟩
        have hval1 : (φ_cast 1).val = 1 := by
          change ((ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (s + 1)))
            (ZMod (ℓ ^ (s + 1)))) 1).val = 1
          rw [map_one, ZMod.val_one]
        rw [hval1, one_nsmul]
        exact hcomm.trans (congrArg (p_ρ δ (s + 1)) (hTrans_η (s + 1)))
    have hTr_comm : weilPolyP1HigherDirectImageMap (π_fst δ) 2 cast_succ ≫ Tr_rel δ r =
        Tr_rel δ (r + 1) ≫ cast_curr := by
      calc
        weilPolyP1HigherDirectImageMap (π_fst δ) 2 cast_succ ≫ Tr_rel δ r
          = 𝟙 _ ≫ (weilPolyP1HigherDirectImageMap (π_fst δ) 2 cast_succ ≫ Tr_rel δ r) :=
              (CategoryTheory.Category.id_comp _).symm
        _ = (Tr_rel δ (r + 1) ≫ γ_rel δ (r + 1)) ≫
              (weilPolyP1HigherDirectImageMap (π_fst δ) 2 cast_succ ≫ Tr_rel δ r) := by
              rw [(hInv_rel δ (r + 1)).2]
        _ = Tr_rel δ (r + 1) ≫
              ((γ_rel δ (r + 1) ≫ weilPolyP1HigherDirectImageMap (π_fst δ) 2 cast_succ) ≫
                Tr_rel δ r) := by
              simp only [CategoryTheory.Category.assoc]
        _ = Tr_rel δ (r + 1) ≫ ((cast_curr ≫ γ_rel δ r) ≫ Tr_rel δ r) := by
              rw [← hγ_comm]
        _ = Tr_rel δ (r + 1) ≫ (cast_curr ≫ (γ_rel δ r ≫ Tr_rel δ r)) := by
              simp only [CategoryTheory.Category.assoc]
        _ = Tr_rel δ (r + 1) ≫ (cast_curr ≫ 𝟙 _) := by rw [(hInv_rel δ r).1]
        _ = Tr_rel δ (r + 1) ≫ cast_curr := by rw [CategoryTheory.Category.comp_id]
    change (u.comp (CategoryTheory.Abelian.Ext.mk₀
          (weilPolyP1HigherDirectImageMap (π_fst δ) 2 cast_succ))
          (Nat.add_zero (2 * δ))).comp
        (CategoryTheory.Abelian.Ext.mk₀ (Tr_rel δ r)) (Nat.add_zero (2 * δ)) =
      (u.comp (CategoryTheory.Abelian.Ext.mk₀ (Tr_rel δ (r + 1)))
        (Nat.add_zero (2 * δ))).comp
        (CategoryTheory.Abelian.Ext.mk₀ cast_curr) (Nat.add_zero (2 * δ))
    rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ (Nat.add_zero (2 * δ)),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hTr_comm,
      ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
      ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ (Nat.add_zero (2 * δ))]

theorem weil_etale_torsion_injKernel_twoStep_resolution_and_lift (Y S : AlgebraicGeometry.Scheme.{u}) (f : Quiver.Hom Y S)
    (M : ℕ) (hM : 1 ≤ M)
    (F : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u})
    (hTor : M • CategoryTheory.CategoryStruct.id F = 0) :
    ∃ (R : WeilTwoStepAcyclicRes Y S f M F),
      WeilHasInjKernelTerms M R ∧
      ∀ {F₀ : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}}
        (R₀ : WeilTwoStepAcyclicRes Y S f M F₀)
        (φ : Quiver.Hom F₀ F),
        Nonempty (WeilTwoStepResHom R₀ R φ) :=
by
  let J_Y := Y.smallEtaleTopology
  let J_S := S.smallEtaleTopology
  let 𝒞 := CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}
  let Sh_Y := CategoryTheory.presheafToSheaf J_Y AddCommGrpCat.{u}
  let U_Y := CategoryTheory.sheafToPresheaf J_Y AddCommGrpCat.{u}
  let Sh_S := CategoryTheory.presheafToSheaf J_S AddCommGrpCat.{u}
  have hM_int : (M : ℤ) ≠ 0 := by omega

  
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let Pℤ : CategoryTheory.Functor (Opposite Y.Etale) AddCommGrpCat.{u} :=
    (CategoryTheory.Functor.const (Opposite Y.Etale)).obj Aℤ
  have hMono_Pℤ_app : ∀ (W : Opposite Y.Etale),
      CategoryTheory.Mono ((M • CategoryTheory.CategoryStruct.id Pℤ).app W) := by
    intro W
    rw [CategoryTheory.NatTrans.app_nsmul, CategoryTheory.NatTrans.id_app]
    rw [AddCommGrpCat.mono_iff_injective]
    intro a b hab
    have h1 : M • a.down = M • b.down :=
      congrArg ULift.down (hab : M • a = M • b)
    rw [nsmul_eq_mul, nsmul_eq_mul] at h1
    exact ULift.ext _ _ (mul_left_cancel₀ hM_int h1)
  have : CategoryTheory.Mono (M • CategoryTheory.CategoryStruct.id Pℤ) :=
    @CategoryTheory.NatTrans.mono_of_mono_app _ _ _ _ _ _
      (M • CategoryTheory.CategoryStruct.id Pℤ) hMono_Pℤ_app
  have hMono_ℤ : CategoryTheory.Mono
      (M • CategoryTheory.CategoryStruct.id
        ((CategoryTheory.constantSheaf J_Y AddCommGrpCat.{u}).obj Aℤ)) := by
    change CategoryTheory.Mono (M • CategoryTheory.CategoryStruct.id (Sh_Y.obj Pℤ))
    have hmap : Sh_Y.map (M • CategoryTheory.CategoryStruct.id Pℤ) =
        M • CategoryTheory.CategoryStruct.id (Sh_Y.obj Pℤ) := by
      rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id]
    rw [← hmap]
    exact Sh_Y.map_mono (M • CategoryTheory.CategoryStruct.id Pℤ)

  
  let P_rep : Y.Etale → CategoryTheory.Functor (Opposite Y.Etale) AddCommGrpCat.{u} :=
    fun V => CategoryTheory.Functor.comp (CategoryTheory.yoneda.obj V) AddCommGrpCat.free
  let Z_rep : Y.Etale → 𝒞 := fun V => Sh_Y.obj (P_rep V)
  have hMono_Rep : ∀ (V : Y.Etale),
      CategoryTheory.Mono (M • CategoryTheory.CategoryStruct.id (Z_rep V)) := by
    intro V
    have hMono_app : ∀ (W : Opposite Y.Etale),
        CategoryTheory.Mono ((M • CategoryTheory.CategoryStruct.id (P_rep V)).app W) := by
      intro W
      rw [CategoryTheory.NatTrans.app_nsmul, CategoryTheory.NatTrans.id_app]
      rw [AddCommGrpCat.mono_iff_injective]
      intro (a : FreeAbelianGroup (Opposite.unop W ⟶ V))
        (b : FreeAbelianGroup (Opposite.unop W ⟶ V)) hab
      have h_ab : M • a = M • b := hab
      let e_F := FreeAbelianGroup.equivFinsupp (Opposite.unop W ⟶ V)
      apply e_F.injective
      ext u
      have h_eq : e_F (M • a) = e_F (M • b) := congrArg e_F h_ab
      rw [map_nsmul, map_nsmul] at h_eq
      have h_u : (M • e_F a) u = (M • e_F b) u := DFunLike.congr_fun h_eq u
      simp only [Finsupp.smul_apply, nsmul_eq_mul] at h_u
      exact mul_left_cancel₀ hM_int h_u
    have : CategoryTheory.Mono (M • CategoryTheory.CategoryStruct.id (P_rep V)) :=
      @CategoryTheory.NatTrans.mono_of_mono_app _ _ _ _ _ _
        (M • CategoryTheory.CategoryStruct.id (P_rep V)) hMono_app
    have hmap : Sh_Y.map (M • CategoryTheory.CategoryStruct.id (P_rep V)) =
        M • CategoryTheory.CategoryStruct.id (Z_rep V) := by
      dsimp [Z_rep]
      rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id]
    rw [← hmap]
    exact Sh_Y.map_mono (M • CategoryTheory.CategoryStruct.id (P_rep V))

  
  let Free_PSh := (CategoryTheory.Functor.whiskeringRight (Opposite Y.Etale)
    (Type u) AddCommGrpCat.{u}).obj AddCommGrpCat.free
  let Fgt_PSh := (CategoryTheory.Functor.whiskeringRight (Opposite Y.Etale)
    AddCommGrpCat.{u} (Type u)).obj (CategoryTheory.forget AddCommGrpCat.{u})
  let L_tot := Free_PSh ⋙ Sh_Y
  let R_tot := U_Y ⋙ Fgt_PSh
  let adj_free := CategoryTheory.Adjunction.whiskerRight (Opposite Y.Etale) AddCommGrpCat.adj
  let adj_sh := CategoryTheory.sheafificationAdjunction J_Y AddCommGrpCat.{u}
  let adj_tot : L_tot ⊣ R_tot := adj_free.comp adj_sh
  let ev_V : ∀ (V : Y.Etale) (𝒥 : 𝒞),
      (Z_rep V ⟶ 𝒥) ≃ ↑(𝒥.obj.obj (Opposite.op V)) :=
    fun V 𝒥 =>
      (adj_tot.homEquiv (CategoryTheory.yoneda.obj V) 𝒥).trans CategoryTheory.yonedaEquiv
  have hEpi_J : ∀ (𝒥 : 𝒞) [CategoryTheory.Injective 𝒥],
      CategoryTheory.Epi (M • CategoryTheory.CategoryStruct.id 𝒥) := by
    intro 𝒥 _
    let α : 𝒥 ⟶ 𝒥 := M • CategoryTheory.CategoryStruct.id 𝒥
    have hEpi_app : ∀ (W : Opposite Y.Etale), CategoryTheory.Epi (α.hom.app W) := by
      intro W
      rw [AddCommGrpCat.epi_iff_surjective]
      intro s
      let V : Y.Etale := Opposite.unop W
      have : CategoryTheory.Mono (M • CategoryTheory.CategoryStruct.id (Z_rep V)) := hMono_Rep V
      let ψ : Z_rep V ⟶ 𝒥 := (ev_V V 𝒥).symm s
      let ξ : Z_rep V ⟶ 𝒥 :=
        CategoryTheory.Injective.factorThru ψ (M • CategoryTheory.CategoryStruct.id (Z_rep V))
      have hfac : (M • CategoryTheory.CategoryStruct.id (Z_rep V)) ≫ ξ = ψ :=
        CategoryTheory.Injective.comp_factorThru ψ (M • CategoryTheory.CategoryStruct.id (Z_rep V))
      have hξα : ξ ≫ α = ψ := by
        calc
          ξ ≫ α = M • (ξ ≫ CategoryTheory.CategoryStruct.id 𝒥) :=
            CategoryTheory.Preadditive.comp_nsmul _ _ _
          _ = M • ξ := by rw [CategoryTheory.Category.comp_id]
          _ = M • (CategoryTheory.CategoryStruct.id (Z_rep V) ≫ ξ) := by
            rw [CategoryTheory.Category.id_comp]
          _ = (M • CategoryTheory.CategoryStruct.id (Z_rep V)) ≫ ξ :=
            (CategoryTheory.Preadditive.nsmul_comp _ _ _).symm
          _ = ψ := hfac
      refine ⟨ev_V V 𝒥 ξ, ?_⟩
      have hev : (α.hom.app (Opposite.op V)) (ev_V V 𝒥 ξ) = ev_V V 𝒥 (ξ ≫ α) := by
        dsimp [ev_V]
        rw [CategoryTheory.Adjunction.homEquiv_naturality_right,
          CategoryTheory.yonedaEquiv_apply, CategoryTheory.yonedaEquiv_apply]
        rfl
      change (α.hom.app (Opposite.op V)) (ev_V V 𝒥 ξ) = s
      rw [hev, hξα]
      exact (ev_V V 𝒥).apply_symm_apply s
    have : CategoryTheory.Epi α.hom :=
      @CategoryTheory.NatTrans.epi_of_epi_app _ _ _ _ _ _ α.hom hEpi_app
    have : CategoryTheory.Epi (Sh_Y.map α.hom) := inferInstance
    let c : Sh_Y.obj 𝒥.obj ⟶ 𝒥 := adj_sh.counit.app 𝒥
    have : CategoryTheory.IsIso c := inferInstance
    have hEpi_comp : CategoryTheory.Epi (Sh_Y.map α.hom ≫ c) :=
      CategoryTheory.epi_comp (Sh_Y.map α.hom) c
    have hnat : Sh_Y.map α.hom ≫ c = c ≫ α := adj_sh.counit.naturality α
    rw [hnat] at hEpi_comp
    exact @CategoryTheory.epi_of_epi _ _ _ _ _ c α hEpi_comp

  
  have hExt_sub : ∀ (𝒥 : 𝒞) [CategoryTheory.Injective 𝒥]
      (K : 𝒞) [CategoryTheory.Mono (M • CategoryTheory.CategoryStruct.id K)]
      (q : ℕ), 1 ≤ q →
      Subsingleton (CategoryTheory.Abelian.Ext.{u} K
        (CategoryTheory.Limits.kernel (M • CategoryTheory.CategoryStruct.id 𝒥)) q) := by
    intro 𝒥 _ K _ q hq
    let μ : 𝒥 ⟶ 𝒥 := M • CategoryTheory.CategoryStruct.id 𝒥
    have : CategoryTheory.Epi μ := hEpi_J 𝒥
    let ι : CategoryTheory.Limits.kernel μ ⟶ 𝒥 := CategoryTheory.Limits.kernel.ι μ
    let SC := CategoryTheory.ShortComplex.mk ι μ (CategoryTheory.Limits.kernel.condition μ)
    have hex : SC.Exact :=
      CategoryTheory.ShortComplex.exact_of_f_is_kernel SC (CategoryTheory.Limits.kernelIsKernel μ)
    have hSE : SC.ShortExact :=
      CategoryTheory.ShortComplex.ShortExact.mk' hex inferInstance inferInstance
    obtain ⟨n, rfl⟩ := Nat.exists_eq_add_of_le' hq
    rw [subsingleton_iff_forall_eq 0]
    intro (e : CategoryTheory.Abelian.Ext.{u} K SC.X₁ (n + 1))
    have h_push : e.comp (CategoryTheory.Abelian.Ext.mk₀ SC.f) (Nat.add_zero (n + 1)) = 0 :=
      CategoryTheory.Abelian.Ext.eq_zero_of_injective _
    obtain ⟨x₃, hx₃⟩ :=
      CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ K hSE e h_push (rfl : n + 1 = n + 1)
    cases n with
    | succ m =>
      have hx₃_zero : x₃ = 0 := CategoryTheory.Abelian.Ext.eq_zero_of_injective x₃
      rw [← hx₃, hx₃_zero, CategoryTheory.Abelian.Ext.zero_comp]
    | zero =>
      let ψ : K ⟶ 𝒥 := CategoryTheory.Abelian.Ext.addEquiv₀ x₃
      have hx₃_eq : x₃ = CategoryTheory.Abelian.Ext.mk₀ ψ :=
        (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply x₃).symm
      let ξ : K ⟶ 𝒥 :=
        CategoryTheory.Injective.factorThru ψ (M • CategoryTheory.CategoryStruct.id K)
      have hfac_K : (M • CategoryTheory.CategoryStruct.id K) ≫ ξ = ψ :=
        CategoryTheory.Injective.comp_factorThru ψ (M • CategoryTheory.CategoryStruct.id K)
      have hψ_eq : ψ = ξ ≫ SC.g := by
        calc
          ψ = (M • CategoryTheory.CategoryStruct.id K) ≫ ξ := hfac_K.symm
          _ = M • (CategoryTheory.CategoryStruct.id K ≫ ξ) :=
            CategoryTheory.Preadditive.nsmul_comp _ _ _
          _ = M • ξ := by rw [CategoryTheory.Category.id_comp]
          _ = M • (ξ ≫ CategoryTheory.CategoryStruct.id 𝒥) := by
            rw [CategoryTheory.Category.comp_id]
          _ = ξ ≫ (M • CategoryTheory.CategoryStruct.id 𝒥) :=
            (CategoryTheory.Preadditive.comp_nsmul _ _ _).symm
      rw [← hx₃, hx₃_eq, hψ_eq, ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ ξ SC.g,
        CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero 0) (Nat.zero_add 1)
          (Nat.zero_add 1),
        CategoryTheory.ShortComplex.ShortExact.comp_extClass hSE,
        CategoryTheory.Abelian.Ext.comp_zero]

  
  let W_B : CategoryTheory.Functor
      (CategoryTheory.Functor (Opposite Y.Etale) AddCommGrpCat.{u})
      (CategoryTheory.Functor (Opposite S.Etale) AddCommGrpCat.{u}) :=
    (CategoryTheory.Functor.whiskeringLeft (Opposite S.Etale) (Opposite Y.Etale)
      AddCommGrpCat.{u}).obj (weilEtaleSitePullback f).op
  have hGlob_ker : ∀ (𝒥 : 𝒞) [CategoryTheory.Injective 𝒥] (q : ℕ), 1 ≤ q →
      Subsingleton ((CategoryTheory.Limits.kernel (M • CategoryTheory.CategoryStruct.id 𝒥)).H q) := by
    intro 𝒥 _ q hq
    have := hMono_ℤ
    exact hExt_sub 𝒥 ((CategoryTheory.constantSheaf J_Y AddCommGrpCat.{u}).obj Aℤ) q hq
  have hDir_ker : ∀ (𝒥 : 𝒞) [CategoryTheory.Injective 𝒥] (q : ℕ), 1 ≤ q →
      CategoryTheory.Limits.IsZero
        (weilEtaleHigherDirectImage f q
          (CategoryTheory.Limits.kernel (M • CategoryTheory.CategoryStruct.id 𝒥))) := by
    intro 𝒥 _ q hq
    let ℋ := CategoryTheory.Limits.kernel (M • CategoryTheory.CategoryStruct.id 𝒥)
    have hPSh_zero : CategoryTheory.Limits.IsZero
        (CategoryTheory.Sheaf.cohomologyPresheaf ℋ q) := by
      rw [CategoryTheory.Functor.isZero_iff]
      intro W
      let V : Y.Etale := Opposite.unop W
      have := hMono_Rep V
      have hSub_V : Subsingleton (CategoryTheory.Abelian.Ext.{u} (Z_rep V) ℋ q) :=
        hExt_sub 𝒥 (Z_rep V) q hq
      rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
      apply AddCommGrpCat.ext
      intro x
      exact @Subsingleton.elim _ hSub_V x 0
    change CategoryTheory.Limits.IsZero
      (Sh_S.obj (W_B.obj (CategoryTheory.Sheaf.cohomologyPresheaf ℋ q)))
    exact Sh_S.map_isZero (W_B.map_isZero hPSh_zero)

  
  have hStep : ∀ (X : 𝒞), M • CategoryTheory.CategoryStruct.id X = 0 →
      let J := CategoryTheory.Injective.under X
      let H := CategoryTheory.Limits.kernel (M • CategoryTheory.CategoryStruct.id J)
      ∃ (Q : 𝒞) (u : Quiver.Hom X H) (v : Quiver.Hom H Q)
        (huv : CategoryTheory.CategoryStruct.comp u v = 0),
        (CategoryTheory.ShortComplex.mk u v huv).ShortExact ∧
        M • CategoryTheory.CategoryStruct.id H = 0 ∧
        M • CategoryTheory.CategoryStruct.id Q = 0 := by
    intro X hTor_X
    let J := CategoryTheory.Injective.under X
    let ι_X : X ⟶ J := CategoryTheory.Injective.ι X
    let μ : J ⟶ J := M • CategoryTheory.CategoryStruct.id J
    let H := CategoryTheory.Limits.kernel μ
    have h_cond : ι_X ≫ μ = 0 := by
      calc
        ι_X ≫ (M • CategoryTheory.CategoryStruct.id J)
          = M • (ι_X ≫ CategoryTheory.CategoryStruct.id J) :=
            CategoryTheory.Preadditive.comp_nsmul _ _ _
        _ = M • ι_X := by rw [CategoryTheory.Category.comp_id]
        _ = M • (CategoryTheory.CategoryStruct.id X ≫ ι_X) := by
            rw [CategoryTheory.Category.id_comp]
        _ = (M • CategoryTheory.CategoryStruct.id X) ≫ ι_X :=
            (CategoryTheory.Preadditive.nsmul_comp _ _ _).symm
        _ = 0 ≫ ι_X := by rw [hTor_X]
        _ = 0 := CategoryTheory.Limits.zero_comp
    let u : X ⟶ H := CategoryTheory.Limits.kernel.lift μ ι_X h_cond
    have hu_ι : u ≫ CategoryTheory.Limits.kernel.ι μ = ι_X :=
      CategoryTheory.Limits.kernel.lift_ι μ ι_X h_cond
    have hMono_u : CategoryTheory.Mono u := by
      have : CategoryTheory.Mono (u ≫ CategoryTheory.Limits.kernel.ι μ) := by
        rw [hu_ι]; infer_instance
      exact CategoryTheory.mono_of_mono u (CategoryTheory.Limits.kernel.ι μ)
    let Q := CategoryTheory.Limits.cokernel u
    let v : H ⟶ Q := CategoryTheory.Limits.cokernel.π u
    have huv : u ≫ v = 0 := CategoryTheory.Limits.cokernel.condition u
    let SC := CategoryTheory.ShortComplex.mk u v huv
    have hex_SC : SC.Exact :=
      CategoryTheory.ShortComplex.exact_of_g_is_cokernel SC
        (CategoryTheory.Limits.cokernelIsCokernel u)
    have hSE_SC : SC.ShortExact :=
      CategoryTheory.ShortComplex.ShortExact.mk' hex_SC hMono_u inferInstance
    have hTor_H : M • CategoryTheory.CategoryStruct.id H = 0 := by
      rw [← CategoryTheory.cancel_mono (CategoryTheory.Limits.kernel.ι μ),
        CategoryTheory.Limits.zero_comp]
      calc
        (M • CategoryTheory.CategoryStruct.id H) ≫ CategoryTheory.Limits.kernel.ι μ
          = M • (CategoryTheory.CategoryStruct.id H ≫ CategoryTheory.Limits.kernel.ι μ) :=
            CategoryTheory.Preadditive.nsmul_comp _ _ _
        _ = M • CategoryTheory.Limits.kernel.ι μ := by rw [CategoryTheory.Category.id_comp]
        _ = M • (CategoryTheory.Limits.kernel.ι μ ≫ CategoryTheory.CategoryStruct.id J) := by
            rw [CategoryTheory.Category.comp_id]
        _ = CategoryTheory.Limits.kernel.ι μ ≫ μ :=
            (CategoryTheory.Preadditive.comp_nsmul _ _ _).symm
        _ = 0 := CategoryTheory.Limits.kernel.condition μ
    have hTor_Q : M • CategoryTheory.CategoryStruct.id Q = 0 := by
      rw [← CategoryTheory.cancel_epi v, CategoryTheory.Limits.comp_zero]
      calc
        v ≫ (M • CategoryTheory.CategoryStruct.id Q)
          = M • (v ≫ CategoryTheory.CategoryStruct.id Q) :=
            CategoryTheory.Preadditive.comp_nsmul _ _ _
        _ = M • v := by rw [CategoryTheory.Category.comp_id]
        _ = M • (CategoryTheory.CategoryStruct.id H ≫ v) := by
            rw [CategoryTheory.Category.id_comp]
        _ = (M • CategoryTheory.CategoryStruct.id H) ≫ v :=
            (CategoryTheory.Preadditive.nsmul_comp _ _ _).symm
        _ = 0 ≫ v := by rw [hTor_H]
        _ = 0 := CategoryTheory.Limits.zero_comp
    exact ⟨Q, u, v, huv, hSE_SC, hTor_H, hTor_Q⟩

  
  have hLift : ∀ {X₀ A₀ Q₀ X Q J : 𝒞} [CategoryTheory.Injective J]
      (u₀ : Quiver.Hom X₀ A₀) (v₀ : Quiver.Hom A₀ Q₀)
      (h₀ : CategoryTheory.CategoryStruct.comp u₀ v₀ = 0),
      (CategoryTheory.ShortComplex.mk u₀ v₀ h₀).ShortExact →
      M • CategoryTheory.CategoryStruct.id A₀ = 0 →
      ∀ (u : Quiver.Hom X (CategoryTheory.Limits.kernel (M • CategoryTheory.CategoryStruct.id J)))
        (v : Quiver.Hom (CategoryTheory.Limits.kernel (M • CategoryTheory.CategoryStruct.id J)) Q),
        CategoryTheory.CategoryStruct.comp u v = 0 →
        ∀ (φ : Quiver.Hom X₀ X),
          ∃ (α : Quiver.Hom A₀
              (CategoryTheory.Limits.kernel (M • CategoryTheory.CategoryStruct.id J)))
            (ψ : Quiver.Hom Q₀ Q),
            CategoryTheory.CategoryStruct.comp u₀ α = CategoryTheory.CategoryStruct.comp φ u ∧
            CategoryTheory.CategoryStruct.comp v₀ ψ = CategoryTheory.CategoryStruct.comp α v := by
    intro X₀ A₀ Q₀ X Q J _ u₀ v₀ h₀ hSE₀ hTor_A₀ u v huv φ
    let μ : J ⟶ J := M • CategoryTheory.CategoryStruct.id J
    let H := CategoryTheory.Limits.kernel μ
    have : CategoryTheory.Mono u₀ := hSE₀.mono_f
    have : CategoryTheory.Epi v₀ := hSE₀.epi_g
    let g : A₀ ⟶ J :=
      CategoryTheory.Injective.factorThru (φ ≫ u ≫ CategoryTheory.Limits.kernel.ι μ) u₀
    have hg : u₀ ≫ g = φ ≫ u ≫ CategoryTheory.Limits.kernel.ι μ :=
      CategoryTheory.Injective.comp_factorThru (φ ≫ u ≫ CategoryTheory.Limits.kernel.ι μ) u₀
    have hg_tor : g ≫ μ = 0 := by
      calc
        g ≫ (M • CategoryTheory.CategoryStruct.id J)
          = M • (g ≫ CategoryTheory.CategoryStruct.id J) :=
            CategoryTheory.Preadditive.comp_nsmul _ _ _
        _ = M • g := by rw [CategoryTheory.Category.comp_id]
        _ = M • (CategoryTheory.CategoryStruct.id A₀ ≫ g) := by
            rw [CategoryTheory.Category.id_comp]
        _ = (M • CategoryTheory.CategoryStruct.id A₀) ≫ g :=
            (CategoryTheory.Preadditive.nsmul_comp _ _ _).symm
        _ = 0 ≫ g := by rw [hTor_A₀]
        _ = 0 := CategoryTheory.Limits.zero_comp
    let α : A₀ ⟶ H := CategoryTheory.Limits.kernel.lift μ g hg_tor
    have hα : α ≫ CategoryTheory.Limits.kernel.ι μ = g :=
      CategoryTheory.Limits.kernel.lift_ι μ g hg_tor
    have comm_u : u₀ ≫ α = φ ≫ u := by
      rw [← CategoryTheory.cancel_mono (CategoryTheory.Limits.kernel.ι μ)]
      rw [CategoryTheory.Category.assoc, hα, hg, CategoryTheory.Category.assoc]
    have hk : u₀ ≫ (α ≫ v) = 0 := by
      rw [← CategoryTheory.Category.assoc, comm_u, CategoryTheory.Category.assoc, huv,
        CategoryTheory.Limits.comp_zero]
    let ψ : Q₀ ⟶ Q := hSE₀.exact.desc (α ≫ v) hk
    have comm_v : v₀ ≫ ψ = α ≫ v := hSE₀.exact.g_desc (α ≫ v) hk
    exact ⟨α, ψ, comm_u, comm_v⟩

  
  let J₀ : 𝒞 := CategoryTheory.Injective.under F
  let A₀ : 𝒞 := CategoryTheory.Limits.kernel (M • CategoryTheory.CategoryStruct.id J₀)
  obtain ⟨Q₁, u₀, v₀, h₀, hSE₀, hTor_A₀, hTor_Q₁⟩ := hStep F hTor
  let J₁ : 𝒞 := CategoryTheory.Injective.under Q₁
  let A₁ : 𝒞 := CategoryTheory.Limits.kernel (M • CategoryTheory.CategoryStruct.id J₁)
  obtain ⟨Q₂, u₁, v₁, h₁, hSE₁, hTor_A₁, hTor_Q₂⟩ := hStep Q₁ hTor_Q₁
  let R : WeilTwoStepAcyclicRes Y S f M F :=
    { A₀ := A₀
      Q₁ := Q₁
      A₁ := A₁
      Q₂ := Q₂
      u₀ := u₀
      v₀ := v₀
      h₀ := h₀
      hSE₀ := hSE₀
      u₁ := u₁
      v₁ := v₁
      h₁ := h₁
      hSE₁ := hSE₁
      hTor_F := hTor
      hTor_A₀ := hTor_A₀
      hTor_Q₁ := hTor_Q₁
      hTor_A₁ := hTor_A₁
      hTor_Q₂ := hTor_Q₂
