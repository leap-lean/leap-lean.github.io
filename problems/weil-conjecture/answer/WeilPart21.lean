      𝟙 X = (∑ j : Fin n, a j ≫ b j) →
      (∀ j : Fin n, (CategoryTheory.Abelian.Ext.mk₀ (b j)).comp z (Nat.zero_add q) = 0) →
      z = 0 := by
    intro C_ab _ _ _ X Y q n B a b z hId hbz
    let preZ : (X ⟶ X) →+ CategoryTheory.Abelian.Ext.{u} X Y q :=
      { toFun := fun φ => (CategoryTheory.Abelian.Ext.mk₀ φ).comp z (Nat.zero_add q)
