          (((Fgt.map f₁).left).base w₀).2
        have hx₂_eq : s ((((Fgt.map f₂).left ≫ (O_lvl U s x₂).ι)).base w₀) = s x₂ :=
          (((Fgt.map f₂).left).base w₀).2
        have hs_eq : s x₁ = s x₂ := hx₁_eq.symm.trans ((congrArg s h_base).trans hx₂_eq)
        have hu₁ : f₁ ≫ hT_X.from (Y_lvl U s x₁) = hT_X.from W := hT_X.hom_ext _ _
        have hu₂ : f₂ ≫ hT_X.from (Y_lvl U s x₂) = hT_X.from W := hT_X.hom_ext _ _
        change (FM.obj.map (Opposite.op f₁)).hom (c_lvl U s x₁) =
          (FM.obj.map (Opposite.op f₂)).hom (c_lvl U s x₂)
        have hm₁ :
            ((adj_X.unit.app AM ≫ FM.obj.map (Opposite.op (hT_X.from (Y_lvl U s x₁)))) ≫
              FM.obj.map (Opposite.op f₁)) =
            adj_X.unit.app AM ≫ FM.obj.map (Opposite.op (hT_X.from W)) :=
          (CategoryTheory.Category.assoc _ _ _).trans
            (congrArg (adj_X.unit.app AM ≫ ·)
              ((hFM_map_comp f₁ _).trans (congrArg (fun k => FM.obj.map (Opposite.op k)) hu₁)))
        have hm₂ :
            ((adj_X.unit.app AM ≫ FM.obj.map (Opposite.op (hT_X.from (Y_lvl U s x₂)))) ≫
              FM.obj.map (Opposite.op f₂)) =
            adj_X.unit.app AM ≫ FM.obj.map (Opposite.op (hT_X.from W)) :=
          (CategoryTheory.Category.assoc _ _ _).trans
            (congrArg (adj_X.unit.app AM ≫ ·)
              ((hFM_map_comp f₂ _).trans (congrArg (fun k => FM.obj.map (Opposite.op k)) hu₂)))
        exact (congrArg (fun g : AM ⟶ FM.obj.obj (Opposite.op W) => g.hom (s x₁)) hm₁).trans
          ((congrArg ((adj_X.unit.app AM ≫ FM.obj.map (Opposite.op (hT_X.from W))).hom) hs_eq).trans
            (congrArg (fun g : AM ⟶ FM.obj.obj (Opposite.op W) => g.hom (s x₂)) hm₂).symm)
      · have hEmp : IsEmpty ↥(Fgt.obj W).left := not_nonempty_iff.mp hNe
        exact @Subsingleton.elim _ (hEmptySub FM W hEmp) _ _

    let glued : ∀ (U : S.Etale),
        LocallyConstant ↥(Fgt.obj U).left (ULift.{u} (ZMod m)) → ↑(FM.obj.obj (Opposite.op U)) :=
      fun U s => Classical.choose (h_sh_lvl U s)
    have h_glued_spec :
        ∀ (U : S.Etale) (s : LocallyConstant ↥(Fgt.obj U).left (ULift.{u} (ZMod m)))
          (x : ↥(Fgt.obj U).left),
          (FM.obj.map (Opposite.op (j_lvl U s x))).hom (glued U s) = c_lvl U s x :=
      fun U s => (Classical.choose_spec (h_sh_lvl U s)).1
    have h_glued_uniq :
        ∀ (U : S.Etale) (s : LocallyConstant ↥(Fgt.obj U).left (ULift.{u} (ZMod m)))
          (z : ↑(FM.obj.obj (Opposite.op U))),
          (∀ x : ↥(Fgt.obj U).left, (FM.obj.map (Opposite.op (j_lvl U s x))).hom z = c_lvl U s x) →
          z = glued U s :=
      fun U s z hz => (Classical.choose_spec (h_sh_lvl U s)).2 z hz

    have h_glued_zero : ∀ U : S.Etale, glued U 0 = 0 := by
      intro U
      symm
      apply h_glued_uniq
      intro x
      exact (map_zero (FM.obj.map (Opposite.op (j_lvl U 0 x))).hom).trans
        (map_zero ((adj_X.unit.app AM) ≫
          FM.obj.map (Opposite.op (hT_X.from (Y_lvl U 0 x)))).hom).symm
    have h_glued_add :
        ∀ (U : S.Etale) (s₁ s₂ : LocallyConstant ↥(Fgt.obj U).left (ULift.{u} (ZMod m))),
          glued U (s₁ + s₂) = glued U s₁ + glued U s₂ := by
      intro U s₁ s₂
      let O₁₂ : ↥(Fgt.obj U).left → ((Fgt.obj U).left).Opens :=
        fun x => O_lvl U s₁ x ⊓ O_lvl U s₂ x
      let Y₁₂ : ↥(Fgt.obj U).left → S.Etale :=
        fun x => CategoryTheory.MorphismProperty.Over.mk ⊤
          ((O₁₂ x).ι ≫ (Fgt.obj U).hom)
          (CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
            (O₁₂ x).ι (Fgt.obj U).hom inferInstance U.prop)
      let j₁₂ : ∀ x : ↥(Fgt.obj U).left, Y₁₂ x ⟶ U :=
        fun x => CategoryTheory.MorphismProperty.Over.homMk (O₁₂ x).ι rfl trivial
      have h_mem₁₂ : CategoryTheory.Sieve.ofArrows Y₁₂ j₁₂ ∈ J U :=
        (h_mem_etale U (CategoryTheory.Sieve.ofArrows Y₁₂ j₁₂)).mpr
          (fun x => ⟨Y₁₂ x, j₁₂ x, ⟨x, ⟨rfl, rfl⟩⟩,
            CategoryTheory.Sieve.ofArrows_mk _ _ x,
            (inferInstance : AlgebraicGeometry.Etale (O₁₂ x).ι), rfl⟩)
      have h_for₁₂ :
          CategoryTheory.Presieve.IsSheafFor (FM.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u})
            (CategoryTheory.Presieve.ofArrows Y₁₂ j₁₂) :=
        (CategoryTheory.Presieve.isSheafFor_iff_generate _).mpr (hFM_type _ h_mem₁₂)
      rw [CategoryTheory.Presieve.isSheafFor_arrows_iff] at h_for₁₂
      have h_res_eq :
          ∀ x : ↥(Fgt.obj U).left,
            (FM.obj.map (Opposite.op (j₁₂ x))).hom (glued U (s₁ + s₂)) =
              (FM.obj.map (Opposite.op (j₁₂ x))).hom (glued U s₁ + glued U s₂) := by
        intro x
        have hle₁ : O₁₂ x ≤ O_lvl U s₁ x := inf_le_left
        have hle₂ : O₁₂ x ≤ O_lvl U s₂ x := inf_le_right
        have hle_sum : O₁₂ x ≤ O_lvl U (s₁ + s₂) x := by
          intro p hp
          change s₁ p + s₂ p = s₁ x + s₂ x
          rw [hp.1, hp.2]
        let ι₁ : Y₁₂ x ⟶ Y_lvl U s₁ x :=
          CategoryTheory.MorphismProperty.Over.homMk (((Fgt.obj U).left).homOfLE hle₁)
            ((CategoryTheory.Category.assoc (((Fgt.obj U).left).homOfLE hle₁)
              (O_lvl U s₁ x).ι (Fgt.obj U).hom).symm.trans
              (congrArg (· ≫ (Fgt.obj U).hom) (((Fgt.obj U).left).homOfLE_ι hle₁)))
            trivial
        let ι₂ : Y₁₂ x ⟶ Y_lvl U s₂ x :=
          CategoryTheory.MorphismProperty.Over.homMk (((Fgt.obj U).left).homOfLE hle₂)
            ((CategoryTheory.Category.assoc (((Fgt.obj U).left).homOfLE hle₂)
              (O_lvl U s₂ x).ι (Fgt.obj U).hom).symm.trans
              (congrArg (· ≫ (Fgt.obj U).hom) (((Fgt.obj U).left).homOfLE_ι hle₂)))
            trivial
        let ι_sum : Y₁₂ x ⟶ Y_lvl U (s₁ + s₂) x :=
          CategoryTheory.MorphismProperty.Over.homMk (((Fgt.obj U).left).homOfLE hle_sum)
            ((CategoryTheory.Category.assoc (((Fgt.obj U).left).homOfLE hle_sum)
              (O_lvl U (s₁ + s₂) x).ι (Fgt.obj U).hom).symm.trans
              (congrArg (· ≫ (Fgt.obj U).hom) (((Fgt.obj U).left).homOfLE_ι hle_sum)))
            trivial
        have hj₁ : ι₁ ≫ j_lvl U s₁ x = j₁₂ x :=
          CategoryTheory.MorphismProperty.Over.Hom.ext
            (((Fgt.obj U).left).homOfLE_ι hle₁)
        have hj₂ : ι₂ ≫ j_lvl U s₂ x = j₁₂ x :=
          CategoryTheory.MorphismProperty.Over.Hom.ext
            (((Fgt.obj U).left).homOfLE_ι hle₂)
        have hj_sum : ι_sum ≫ j_lvl U (s₁ + s₂) x = j₁₂ x :=
          CategoryTheory.MorphismProperty.Over.Hom.ext
            (((Fgt.obj U).left).homOfLE_ι hle_sum)
        have hr_sum :
            (FM.obj.map (Opposite.op (j₁₂ x))).hom (glued U (s₁ + s₂)) =
              (FM.obj.map (Opposite.op ι_sum)).hom (c_lvl U (s₁ + s₂) x) :=
          (congrArg (fun g => g.hom (glued U (s₁ + s₂)))
            ((congrArg (fun k => FM.obj.map (Opposite.op k)) hj_sum.symm).trans
              (hFM_map_comp ι_sum (j_lvl U (s₁ + s₂) x)).symm)).trans
            (congrArg (FM.obj.map (Opposite.op ι_sum)).hom (h_glued_spec U (s₁ + s₂) x))
        have hr₁ :
            (FM.obj.map (Opposite.op (j₁₂ x))).hom (glued U s₁) =
              (FM.obj.map (Opposite.op ι₁)).hom (c_lvl U s₁ x) :=
          (congrArg (fun g => g.hom (glued U s₁))
            ((congrArg (fun k => FM.obj.map (Opposite.op k)) hj₁.symm).trans
              (hFM_map_comp ι₁ (j_lvl U s₁ x)).symm)).trans
            (congrArg (FM.obj.map (Opposite.op ι₁)).hom (h_glued_spec U s₁ x))
        have hr₂ :
            (FM.obj.map (Opposite.op (j₁₂ x))).hom (glued U s₂) =
              (FM.obj.map (Opposite.op ι₂)).hom (c_lvl U s₂ x) :=
          (congrArg (fun g => g.hom (glued U s₂))
            ((congrArg (fun k => FM.obj.map (Opposite.op k)) hj₂.symm).trans
              (hFM_map_comp ι₂ (j_lvl U s₂ x)).symm)).trans
            (congrArg (FM.obj.map (Opposite.op ι₂)).hom (h_glued_spec U s₂ x))
        have ht₁ : ι₁ ≫ hT_X.from (Y_lvl U s₁ x) = hT_X.from (Y₁₂ x) := hT_X.hom_ext _ _
        have ht₂ : ι₂ ≫ hT_X.from (Y_lvl U s₂ x) = hT_X.from (Y₁₂ x) := hT_X.hom_ext _ _
        have hts : ι_sum ≫ hT_X.from (Y_lvl U (s₁ + s₂) x) = hT_X.from (Y₁₂ x) := hT_X.hom_ext _ _
        let ψ₁₂ : AM ⟶ FM.obj.obj (Opposite.op (Y₁₂ x)) :=
          adj_X.unit.app AM ≫ FM.obj.map (Opposite.op (hT_X.from (Y₁₂ x)))
        have he₁ :
            (adj_X.unit.app AM ≫ FM.obj.map (Opposite.op (hT_X.from (Y_lvl U s₁ x)))) ≫
              FM.obj.map (Opposite.op ι₁) = ψ₁₂ :=
          (CategoryTheory.Category.assoc _ _ _).trans
            (congrArg (adj_X.unit.app AM ≫ ·)
              ((hFM_map_comp ι₁ _).trans (congrArg (fun k => FM.obj.map (Opposite.op k)) ht₁)))
        have he₂ :
            (adj_X.unit.app AM ≫ FM.obj.map (Opposite.op (hT_X.from (Y_lvl U s₂ x)))) ≫
              FM.obj.map (Opposite.op ι₂) = ψ₁₂ :=
          (CategoryTheory.Category.assoc _ _ _).trans
            (congrArg (adj_X.unit.app AM ≫ ·)
              ((hFM_map_comp ι₂ _).trans (congrArg (fun k => FM.obj.map (Opposite.op k)) ht₂)))
        have hes :
            (adj_X.unit.app AM ≫ FM.obj.map (Opposite.op (hT_X.from (Y_lvl U (s₁ + s₂) x)))) ≫
              FM.obj.map (Opposite.op ι_sum) = ψ₁₂ :=
          (CategoryTheory.Category.assoc _ _ _).trans
            (congrArg (adj_X.unit.app AM ≫ ·)
              ((hFM_map_comp ι_sum _).trans (congrArg (fun k => FM.obj.map (Opposite.op k)) hts)))
        have hc_sum :
            (FM.obj.map (Opposite.op ι_sum)).hom (c_lvl U (s₁ + s₂) x) =
              ψ₁₂.hom (s₁ x + s₂ x) :=
          congrArg (fun g : AM ⟶ FM.obj.obj (Opposite.op (Y₁₂ x)) => g.hom (s₁ x + s₂ x)) hes
        have hc₁ :
            (FM.obj.map (Opposite.op ι₁)).hom (c_lvl U s₁ x) = ψ₁₂.hom (s₁ x) :=
          congrArg (fun g : AM ⟶ FM.obj.obj (Opposite.op (Y₁₂ x)) => g.hom (s₁ x)) he₁
        have hc₂ :
            (FM.obj.map (Opposite.op ι₂)).hom (c_lvl U s₂ x) = ψ₁₂.hom (s₂ x) :=
          congrArg (fun g : AM ⟶ FM.obj.obj (Opposite.op (Y₁₂ x)) => g.hom (s₂ x)) he₂
        exact (hr_sum.trans (hc_sum.trans (map_add ψ₁₂.hom (s₁ x) (s₂ x)))).trans
          ((congrArg₂ (· + ·) (hr₁.trans hc₁) (hr₂.trans hc₂)).symm.trans
            (map_add (FM.obj.map (Opposite.op (j₁₂ x))).hom (glued U s₁) (glued U s₂)).symm)
      let fam₁₂ : ∀ x : ↥(Fgt.obj U).left, ↑(FM.obj.obj (Opposite.op (Y₁₂ x))) :=
        fun x => (FM.obj.map (Opposite.op (j₁₂ x))).hom (glued U (s₁ + s₂))
      have h_comp₁₂ :
          CategoryTheory.Presieve.Arrows.Compatible
            (FM.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u}) j₁₂ fam₁₂ := by
        intro x₁ x₂ W f₁ f₂ hf_eq
        change ((FM.obj.map (Opposite.op (j₁₂ x₁)) ≫ FM.obj.map (Opposite.op f₁))).hom
            (glued U (s₁ + s₂)) =
          ((FM.obj.map (Opposite.op (j₁₂ x₂)) ≫ FM.obj.map (Opposite.op f₂))).hom
            (glued U (s₁ + s₂))
        exact congrArg (fun g => g.hom (glued U (s₁ + s₂)))
          ((hFM_map_comp f₁ (j₁₂ x₁)).trans
            ((congrArg (fun k => FM.obj.map (Opposite.op k)) hf_eq).trans
              (hFM_map_comp f₂ (j₁₂ x₂)).symm))
      obtain ⟨_, _, ht_uniq⟩ := h_for₁₂ fam₁₂ h_comp₁₂
      exact (ht_uniq (glued U (s₁ + s₂)) (fun _ => rfl)).trans
        (ht_uniq (glued U s₁ + glued U s₂) (fun x => (h_res_eq x).symm)).symm

    let φ_inv : L_sh ⟶ FM :=
      { hom :=
          { app := fun U => AddCommGrpCat.ofHom
              { toFun := glued (Opposite.unop U)
                map_zero' := h_glued_zero (Opposite.unop U)
                map_add' := h_glued_add (Opposite.unop U) }
            naturality := fun {U₁ U₂} f => by
              ext (s : LocallyConstant ↥(Fgt.obj (Opposite.unop U₁)).left (ULift.{u} (ZMod m)))
              let s' : LocallyConstant ↥(Fgt.obj (Opposite.unop U₂)).left (ULift.{u} (ZMod m)) :=
                ((weilAltLocConstPresheaf S m).map f).hom s
              change glued (Opposite.unop U₂) s' = (FM.obj.map f).hom (glued (Opposite.unop U₁) s)
              symm
              apply h_glued_uniq (Opposite.unop U₂) s'
              intro x₂
              let x₁ : ↥(Fgt.obj (Opposite.unop U₁)).left := ((Fgt.map f.unop).left).base x₂
              have h_range :
                  Set.range ((O_lvl (Opposite.unop U₂) s' x₂).ι ≫ (Fgt.map f.unop).left).base ⊆
                    Set.range (O_lvl (Opposite.unop U₁) s x₁).ι.base := by
                rw [AlgebraicGeometry.Scheme.Opens.range_ι]
                rintro _ ⟨p, rfl⟩
                exact p.2
              let lift_sch : (O_lvl (Opposite.unop U₂) s' x₂).toScheme ⟶
                  (O_lvl (Opposite.unop U₁) s x₁).toScheme :=
                AlgebraicGeometry.IsOpenImmersion.lift (O_lvl (Opposite.unop U₁) s x₁).ι
                  ((O_lvl (Opposite.unop U₂) s' x₂).ι ≫ (Fgt.map f.unop).left) h_range
              have h_fac :
                  lift_sch ≫ (O_lvl (Opposite.unop U₁) s x₁).ι =
                    (O_lvl (Opposite.unop U₂) s' x₂).ι ≫ (Fgt.map f.unop).left :=
                AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ h_range
              let lift_et : Y_lvl (Opposite.unop U₂) s' x₂ ⟶ Y_lvl (Opposite.unop U₁) s x₁ :=
                CategoryTheory.MorphismProperty.Over.homMk lift_sch
                  ((CategoryTheory.Category.assoc lift_sch
                    (O_lvl (Opposite.unop U₁) s x₁).ι
                    (Fgt.obj (Opposite.unop U₁)).hom).symm.trans
                    ((congrArg (· ≫ (Fgt.obj (Opposite.unop U₁)).hom) h_fac).trans
                      ((CategoryTheory.Category.assoc
                        (O_lvl (Opposite.unop U₂) s' x₂).ι
                        ((Fgt.map f.unop).left)
                        (Fgt.obj (Opposite.unop U₁)).hom).trans
                        (congrArg ((O_lvl (Opposite.unop U₂) s' x₂).ι ≫ ·)
                          (CategoryTheory.MorphismProperty.Over.w f.unop)))))
                  trivial
              have hj_comm :
                  lift_et ≫ j_lvl (Opposite.unop U₁) s x₁ =
                    j_lvl (Opposite.unop U₂) s' x₂ ≫ f.unop :=
                CategoryTheory.MorphismProperty.Over.Hom.ext h_fac
              have hr :
                  (FM.obj.map (Opposite.op (j_lvl (Opposite.unop U₂) s' x₂))).hom
                    ((FM.obj.map f).hom (glued (Opposite.unop U₁) s)) =
                    (FM.obj.map (Opposite.op lift_et)).hom (c_lvl (Opposite.unop U₁) s x₁) :=
                (congrArg (fun g => g.hom (glued (Opposite.unop U₁) s))
                  ((hFM_map_comp (j_lvl (Opposite.unop U₂) s' x₂) f.unop).trans
                    ((congrArg (fun k => FM.obj.map (Opposite.op k)) hj_comm.symm).trans
                      (hFM_map_comp lift_et (j_lvl (Opposite.unop U₁) s x₁)).symm))).trans
                  (congrArg (FM.obj.map (Opposite.op lift_et)).hom
                    (h_glued_spec (Opposite.unop U₁) s x₁))
              have ht_eq :
                  lift_et ≫ hT_X.from (Y_lvl (Opposite.unop U₁) s x₁) =
                    hT_X.from (Y_lvl (Opposite.unop U₂) s' x₂) := hT_X.hom_ext _ _
              have hs_val : s x₁ = s' x₂ := rfl
              have hm :
                  (adj_X.unit.app AM ≫
                      FM.obj.map (Opposite.op (hT_X.from (Y_lvl (Opposite.unop U₁) s x₁)))) ≫
                    FM.obj.map (Opposite.op lift_et) =
                  adj_X.unit.app AM ≫
                    FM.obj.map (Opposite.op (hT_X.from (Y_lvl (Opposite.unop U₂) s' x₂))) :=
                (CategoryTheory.Category.assoc _ _ _).trans
                  (congrArg (adj_X.unit.app AM ≫ ·)
                    ((hFM_map_comp lift_et _).trans
                      (congrArg (fun k => FM.obj.map (Opposite.op k)) ht_eq)))
              exact hr.trans
                ((congrArg (fun g => g.hom (s x₁)) hm).trans
                  (congrArg ((adj_X.unit.app AM ≫
                    FM.obj.map (Opposite.op (hT_X.from (Y_lvl (Opposite.unop U₂) s' x₂)))).hom)
                    hs_val)) } }

    have h_hom_inv : φ_hom ≫ φ_inv = CategoryTheory.CategoryStruct.id FM := by
      apply (adj_X.homEquiv AM FM).injective
      have h_lhs :
          (adj_X.homEquiv AM FM) (φ_hom ≫ φ_inv) =
            (adj_X.unit.app AM ≫ φ_hom.hom.app (Opposite.op T_X)) ≫
              φ_inv.hom.app (Opposite.op T_X) := by
        rw [adj_X.homEquiv_unit]
        exact (CategoryTheory.Category.assoc _ _ _).symm
      have h_rhs :
          (adj_X.homEquiv AM FM) (CategoryTheory.CategoryStruct.id FM) = adj_X.unit.app AM := by
        rw [adj_X.homEquiv_unit]
        exact CategoryTheory.Category.comp_id _
      refine h_lhs.trans ((congrArg (· ≫ φ_inv.hom.app (Opposite.op T_X)) hφ_pin).trans ?_)
      refine Eq.trans ?_ h_rhs.symm
      ext a
      change glued T_X (LocallyConstant.const ↥(Fgt.obj T_X).left a) = (adj_X.unit.app AM).hom a
      symm
      apply h_glued_uniq T_X (LocallyConstant.const ↥(Fgt.obj T_X).left a)
      intro x
      have hj_T : j_lvl T_X (LocallyConstant.const ↥(Fgt.obj T_X).left a) x =
          hT_X.from (Y_lvl T_X (LocallyConstant.const ↥(Fgt.obj T_X).left a) x) :=
        hT_X.hom_ext _ _
      exact congrArg (fun k => (FM.obj.map (Opposite.op k)).hom ((adj_X.unit.app AM).hom a)) hj_T

    have h_inv_hom : φ_inv ≫ φ_hom = CategoryTheory.CategoryStruct.id L_sh := by
      apply CategoryTheory.Sheaf.hom_ext
      ext U (s : LocallyConstant ↥(Fgt.obj (Opposite.unop U)).left (ULift.{u} (ZMod m)))
      let U₀ := Opposite.unop U
      let s_out : LocallyConstant ↥(Fgt.obj U₀).left (ULift.{u} (ZMod m)) :=
        (φ_hom.hom.app (Opposite.op U₀)).hom (glued U₀ s)
      change s_out = s
      ext x
      let x_in : ↥(O_lvl U₀ s x).toScheme := ⟨x, rfl⟩
      have h_nat_j := φ_hom.hom.naturality (Opposite.op (j_lvl U₀ s x))
      have h_ev1 :
          ((L_sh.obj.map (Opposite.op (j_lvl U₀ s x))).hom s_out) =
            (φ_hom.hom.app (Opposite.op (Y_lvl U₀ s x))).hom (c_lvl U₀ s x) :=
        (congrArg (fun g => g.hom (glued U₀ s)) h_nat_j.symm).trans
          (congrArg (φ_hom.hom.app (Opposite.op (Y_lvl U₀ s x))).hom (h_glued_spec U₀ s x))
      have h_nat_u := φ_hom.hom.naturality (Opposite.op (hT_X.from (Y_lvl U₀ s x)))
      have hm :
          (adj_X.unit.app AM ≫ FM.obj.map (Opposite.op (hT_X.from (Y_lvl U₀ s x)))) ≫
            φ_hom.hom.app (Opposite.op (Y_lvl U₀ s x)) =
          weilAltLocConstConstHom S T_X m ≫
            L_sh.obj.map (Opposite.op (hT_X.from (Y_lvl U₀ s x))) :=
        (CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg (adj_X.unit.app AM ≫ ·) h_nat_u).trans
            ((CategoryTheory.Category.assoc _ _ _).symm.trans
              (congrArg (· ≫ L_sh.obj.map (Opposite.op (hT_X.from (Y_lvl U₀ s x)))) hφ_pin)))
      have h_ev2 :
          (φ_hom.hom.app (Opposite.op (Y_lvl U₀ s x))).hom (c_lvl U₀ s x) =
            ((weilAltLocConstConstHom S T_X m ≫
              L_sh.obj.map (Opposite.op (hT_X.from (Y_lvl U₀ s x)))).hom (s x)) :=
        congrArg (fun g => g.hom (s x)) hm
      exact congrArg ULift.down
        (congrArg (fun q : LocallyConstant ↥(O_lvl U₀ s x).toScheme _ => q x_in)
          (h_ev1.trans h_ev2))

    exact ⟨{ hom := φ_hom, inv := φ_inv, hom_inv_id := h_hom_inv, inv_hom_id := h_inv_hom }, hφ_pin⟩

  let e_L : ∀ r : ℕ,
      CategoryTheory.Iso (weilEtaleTorsionSheaf S (ℓ ^ r))
        ⟨weilAltLocConstPresheaf S (ℓ ^ r), hL (ℓ ^ r)⟩ :=
    fun r => Classical.choose (hLocIso (ℓ ^ r))
  have he_L : ∀ r : ℕ,
      CategoryTheory.CategoryStruct.comp
        (adj_X.unit.app (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod (ℓ ^ r)))))
        ((e_L r).hom.hom.app (Opposite.op T_X)) = weilAltLocConstConstHom S T_X (ℓ ^ r) :=
    fun r => Classical.choose_spec (hLocIso (ℓ ^ r))

  let L_sh : ℕ → CategoryTheory.Sheaf J AddCommGrpCat.{u} :=
    fun r => ⟨weilAltLocConstPresheaf S (ℓ ^ r), hL (ℓ ^ r)⟩
  let post_cast : ∀ r : ℕ, L_sh (r + 1) ⟶ L_sh r :=
    fun r =>
      let f_zmod := (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r))).toAddMonoidHom
      { hom :=
          { app := fun U => AddCommGrpCat.ofHom
              { toFun := fun (s : LocallyConstant ↥(Fgt.obj (Opposite.unop U)).left (ULift.{u} (ZMod (ℓ ^ (r + 1))))) =>
                  s.map (ULift.map f_zmod)
                map_zero' := LocallyConstant.ext (fun _ => ULift.ext _ _ f_zmod.map_zero)
                map_add' := fun s₁ s₂ => LocallyConstant.ext (fun x =>
                  ULift.ext _ _ (f_zmod.map_add (s₁ x).down (s₂ x).down)) }
            naturality := fun _ _ _ => AddCommGrpCat.ext (fun _ => LocallyConstant.ext (fun _ => rfl)) } }

  have hCast_comm :
      ∀ r : ℕ,
        let cast_sh := (CategoryTheory.constantSheaf J AddCommGrpCat.{u}).map
          (AddCommGrpCat.uliftFunctor.{u, 0}.map
            (AddCommGrpCat.ofHom
              (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r))).toAddMonoidHom))
        cast_sh ≫ (e_L r).hom = (e_L (r + 1)).hom ≫ post_cast r := by
    intro r
    let AM₁ := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod (ℓ ^ (r + 1))))
    let AM₀ := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod (ℓ ^ r)))
    let c_grp : AM₁ ⟶ AM₀ := AddCommGrpCat.uliftFunctor.{u, 0}.map
      (AddCommGrpCat.ofHom
        (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r))).toAddMonoidHom)
    let cast_sh := (CategoryTheory.constantSheaf J AddCommGrpCat.{u}).map c_grp
    apply (adj_X.homEquiv AM₁ (L_sh r)).injective
    have h_unit_nat : adj_X.unit.app AM₁ ≫ cast_sh.hom.app (Opposite.op T_X) =
        c_grp ≫ adj_X.unit.app AM₀ := (adj_X.unit.naturality c_grp).symm
    have h_lhs :
        (adj_X.homEquiv AM₁ (L_sh r)) (cast_sh ≫ (e_L r).hom) =
          c_grp ≫ weilAltLocConstConstHom S T_X (ℓ ^ r) :=
      (adj_X.homEquiv_unit AM₁ (L_sh r) (cast_sh ≫ (e_L r).hom)).trans
        ((CategoryTheory.Category.assoc _ _ _).symm.trans
          ((congrArg (· ≫ (e_L r).hom.hom.app (Opposite.op T_X)) h_unit_nat).trans
            ((CategoryTheory.Category.assoc _ _ _).trans
              (congrArg (c_grp ≫ ·) (he_L r)))))
    have h_rhs :
        (adj_X.homEquiv AM₁ (L_sh r)) ((e_L (r + 1)).hom ≫ post_cast r) =
          weilAltLocConstConstHom S T_X (ℓ ^ (r + 1)) ≫ (post_cast r).hom.app (Opposite.op T_X) :=
      (adj_X.homEquiv_unit AM₁ (L_sh r) ((e_L (r + 1)).hom ≫ post_cast r)).trans
        ((CategoryTheory.Category.assoc _ _ _).symm.trans
          (congrArg (· ≫ (post_cast r).hom.app (Opposite.op T_X)) (he_L (r + 1))))
    refine h_lhs.trans (Eq.trans ?_ h_rhs.symm)
    ext ⟨a⟩
    exact LocallyConstant.ext (fun _ => rfl)

  
  
  
  let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
  let kMap_of : ∀ (Y : AlgebraicGeometry.Scheme.{u}) (_ : Y ⟶ S_k),
      k →+* ↑(Y.presheaf.obj (Opposite.op ⊤)) :=
    fun _ π_Y => ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ π_Y.appTop).hom

  have h_sec_ext :
      ∀ (Y : AlgebraicGeometry.Scheme.{u}) (u₁ u₂ : ↑(Y.presheaf.obj (Opposite.op ⊤))),
        (∀ p : ↥Y, (Y.presheaf.germ ⊤ p trivial).hom u₁ = (Y.presheaf.germ ⊤ p trivial).hom u₂) →
        u₁ = u₂ :=
    fun Y u₁ u₂ h => TopCat.Presheaf.section_ext Y.sheaf ⊤ u₁ u₂ (fun p _ => h p)

  have hΦ_sch_pkg :
      ∃ Φ_sch : ∀ (r : ℕ) (Y : AlgebraicGeometry.Scheme.{u}) (_ : Y ⟶ S_k),
          LocallyConstant ↥Y (ULift.{u} (ZMod (ℓ ^ r))) →+
            Additive (Units ↑(Y.presheaf.obj (Opposite.op ⊤))),
        (∀ (r : ℕ) {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (f : Y₁ ⟶ Y₂) (π₂ : Y₂ ⟶ S_k)
            (s : LocallyConstant ↥Y₂ (ULift.{u} (ZMod (ℓ ^ r)))),
          Φ_sch r Y₁ (f ≫ π₂)
            ⟨fun x => s (f.base x),
             fun t => f.base.hom.continuous.isOpen_preimage _ (s.isLocallyConstant t)⟩ =
            MonoidHom.toAdditive (Units.map f.appTop.hom.toMonoidHom) (Φ_sch r Y₂ π₂ s)) ∧
        (∀ (r : ℕ) (Y : AlgebraicGeometry.Scheme.{u}) (π_Y : Y ⟶ S_k) (a : ZMod (ℓ ^ r)),
          ((Additive.toMul (Φ_sch r Y π_Y (LocallyConstant.const ↥Y (ULift.up a))) : Units _) :
            ↑(Y.presheaf.obj (Opposite.op ⊤))) =
            (kMap_of Y π_Y ((ζ r : kˣ) : k)) ^ a.val) ∧
        (∀ (r : ℕ) (Y : AlgebraicGeometry.Scheme.{u}) (π_Y : Y ⟶ S_k),
          Function.Injective (Φ_sch r Y π_Y)) ∧
        (∀ (r : ℕ) (Y : AlgebraicGeometry.Scheme.{u}) (π_Y : Y ⟶ S_k)
            (u : Additive (Units ↑(Y.presheaf.obj (Opposite.op ⊤)))),
          (ℓ ^ r) • u = 0 ↔
            ∃ s : LocallyConstant ↥Y (ULift.{u} (ZMod (ℓ ^ r))), Φ_sch r Y π_Y s = u) ∧
        (∀ (r : ℕ) (Y : AlgebraicGeometry.Scheme.{u}) (π_Y : Y ⟶ S_k)
            (s : LocallyConstant ↥Y (ULift.{u} (ZMod (ℓ ^ (r + 1))))),
          ℓ • Φ_sch (r + 1) Y π_Y s =
            Φ_sch r Y π_Y
              (s.map (ULift.map (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r)))))) := by
    have hNeZero : ∀ r : ℕ, NeZero (ℓ ^ r) :=
      fun r => ⟨Nat.ne_of_gt (pow_pos hPrime.pos r)⟩
    let V_clop : ∀ {n : ℕ} (Y : AlgebraicGeometry.Scheme.{u}),
        LocallyConstant ↥Y (ULift.{u} (ZMod n)) → ZMod n → Y.Opens :=
      fun _ s a => ⟨s ⁻¹' {ULift.up a}, s.isLocallyConstant {ULift.up a}⟩
    have h_val_glue :
        ∀ (r : ℕ) (Y : AlgebraicGeometry.Scheme.{u}) (π_Y : Y ⟶ S_k)
          (s : LocallyConstant ↥Y (ULift.{u} (ZMod (ℓ ^ r)))),
          ∃! g : ↑(Y.presheaf.obj (Opposite.op ⊤)),
            ∀ a : ZMod (ℓ ^ r),
              (Y.presheaf.map (CategoryTheory.homOfLE (le_top : V_clop Y s a ≤ ⊤)).op).hom g =
                ((Y.presheaf.map (CategoryTheory.homOfLE (le_top : V_clop Y s a ≤ ⊤)).op).hom
                  (kMap_of Y π_Y ((ζ r : kˣ) : k))) ^ a.val := by
      intro r Y π_Y s
      let sf : ∀ a : ZMod (ℓ ^ r), ↑(Y.presheaf.obj (Opposite.op (V_clop Y s a))) :=
        fun a =>
          ((Y.presheaf.map (CategoryTheory.homOfLE (le_top : V_clop Y s a ≤ ⊤)).op).hom
            (kMap_of Y π_Y ((ζ r : kˣ) : k))) ^ a.val
      have h_le : (⊤ : Y.Opens) ≤ ⨆ a : ZMod (ℓ ^ r), V_clop Y s a := by
        intro p _
        rw [TopologicalSpace.Opens.mem_iSup]
        exact ⟨(s p).down, rfl⟩
      have h_compat : TopCat.Presheaf.IsCompatible Y.presheaf (V_clop Y s) sf := by
        intro a b
        by_cases hab : a = b
        · subst hab; rfl
        · apply TopCat.Presheaf.section_ext Y.sheaf (V_clop Y s a ⊓ V_clop Y s b)
          intro p hp
          have ha : s p = ULift.up a := hp.1
          have hb : s p = ULift.up b := hp.2
          exact False.elim (hab (ULift.up.inj (ha.symm.trans hb)))
      exact TopCat.Sheaf.existsUnique_gluing' Y.sheaf (V_clop Y s) ⊤
        (fun a => CategoryTheory.homOfLE le_top) h_le sf h_compat

    let val_Φ : ∀ (r : ℕ) (Y : AlgebraicGeometry.Scheme.{u}) (_ : Y ⟶ S_k),
        LocallyConstant ↥Y (ULift.{u} (ZMod (ℓ ^ r))) → ↑(Y.presheaf.obj (Opposite.op ⊤)) :=
      fun r Y π_Y s => Classical.choose (h_val_glue r Y π_Y s)
    have h_val_res :
        ∀ (r : ℕ) (Y : AlgebraicGeometry.Scheme.{u}) (π_Y : Y ⟶ S_k)
          (s : LocallyConstant ↥Y (ULift.{u} (ZMod (ℓ ^ r)))) (a : ZMod (ℓ ^ r)),
          (Y.presheaf.map (CategoryTheory.homOfLE (le_top : V_clop Y s a ≤ ⊤)).op).hom
            (val_Φ r Y π_Y s) =
          ((Y.presheaf.map (CategoryTheory.homOfLE (le_top : V_clop Y s a ≤ ⊤)).op).hom
            (kMap_of Y π_Y ((ζ r : kˣ) : k))) ^ a.val :=
      fun r Y π_Y s => (Classical.choose_spec (h_val_glue r Y π_Y s)).1

    have h_germ_val :
        ∀ (r : ℕ) (Y : AlgebraicGeometry.Scheme.{u}) (π_Y : Y ⟶ S_k)
          (s : LocallyConstant ↥Y (ULift.{u} (ZMod (ℓ ^ r)))) (p : ↥Y),
          (Y.presheaf.germ ⊤ p trivial).hom (val_Φ r Y π_Y s) =
            ((Y.presheaf.germ ⊤ p trivial).hom (kMap_of Y π_Y ((ζ r : kˣ) : k))) ^ (s p).down.val := by
      intro r Y π_Y s p
      let a := (s p).down
      have hp_Va : p ∈ V_clop Y s a := rfl
      have hg1 := TopCat.Presheaf.germ_res_apply Y.presheaf
        (CategoryTheory.homOfLE (le_top : V_clop Y s a ≤ ⊤)) p hp_Va (val_Φ r Y π_Y s)
      have hg2 := TopCat.Presheaf.germ_res_apply Y.presheaf
        (CategoryTheory.homOfLE (le_top : V_clop Y s a ≤ ⊤)) p hp_Va (kMap_of Y π_Y ((ζ r : kˣ) : k))
      calc
        (Y.presheaf.germ ⊤ p trivial).hom (val_Φ r Y π_Y s)
          = (Y.presheaf.germ (V_clop Y s a) p hp_Va).hom
              ((Y.presheaf.map (CategoryTheory.homOfLE (le_top : V_clop Y s a ≤ ⊤)).op).hom
                (val_Φ r Y π_Y s)) := hg1.symm
        _ = (Y.presheaf.germ (V_clop Y s a) p hp_Va).hom
              (((Y.presheaf.map (CategoryTheory.homOfLE (le_top : V_clop Y s a ≤ ⊤)).op).hom
                (kMap_of Y π_Y ((ζ r : kˣ) : k))) ^ a.val) := by rw [h_val_res]
        _ = ((Y.presheaf.germ (V_clop Y s a) p hp_Va).hom
              ((Y.presheaf.map (CategoryTheory.homOfLE (le_top : V_clop Y s a ≤ ⊤)).op).hom
                (kMap_of Y π_Y ((ζ r : kˣ) : k)))) ^ a.val := map_pow _ _ _
        _ = ((Y.presheaf.germ ⊤ p trivial).hom (kMap_of Y π_Y ((ζ r : kˣ) : k))) ^ a.val := by
            rw [hg2]

    have h_val_zero :
        ∀ (r : ℕ) (Y : AlgebraicGeometry.Scheme.{u}) (π_Y : Y ⟶ S_k),
          val_Φ r Y π_Y 0 = 1 := by
      intro r Y π_Y
      have _ : NeZero (ℓ ^ r) := hNeZero r
      apply h_sec_ext Y
      intro p
      rw [h_germ_val, map_one]
      have hz : ((0 : LocallyConstant ↥Y (ULift.{u} (ZMod (ℓ ^ r)))) p).down.val = 0 :=
        ZMod.val_zero
      rw [hz, pow_zero]

    have h_val_add :
        ∀ (r : ℕ) (Y : AlgebraicGeometry.Scheme.{u}) (π_Y : Y ⟶ S_k)
          (s₁ s₂ : LocallyConstant ↥Y (ULift.{u} (ZMod (ℓ ^ r)))),
          val_Φ r Y π_Y (s₁ + s₂) = val_Φ r Y π_Y s₁ * val_Φ r Y π_Y s₂ := by
      intro r Y π_Y s₁ s₂
      have _ : NeZero (ℓ ^ r) := hNeZero r
      apply h_sec_ext Y
      intro p
      rw [map_mul, h_germ_val, h_germ_val, h_germ_val]
      let a₁ : ZMod (ℓ ^ r) := (s₁ p).down
      let a₂ : ZMod (ℓ ^ r) := (s₂ p).down
      have h_sum_down : ((s₁ + s₂) p).down = a₁ + a₂ := rfl
      rw [h_sum_down, ← pow_add]
      have h_zeta_eq :
          (((ζ r : kˣ) : k)) ^ (a₁ + a₂).val = (((ζ r : kˣ) : k)) ^ (a₁.val + a₂.val) := by
        have h_mod : (a₁ + a₂).val = (a₁.val + a₂.val) % (ℓ ^ r) := ZMod.val_add a₁ a₂
        have h_div := (Nat.mod_add_div (a₁.val + a₂.val) (ℓ ^ r)).symm
        conv_rhs => rw [h_div]
        rw [pow_add, pow_mul, (hPrim r).pow_eq_one, one_pow, mul_one, h_mod]
      let ψ_p : k →+* ↑(Y.presheaf.stalk p) :=
        (Y.presheaf.germ ⊤ p trivial).hom.comp (kMap_of Y π_Y)
      simpa [ψ_p, map_pow] using congrArg ψ_p h_zeta_eq

    let Φ_sch : ∀ (r : ℕ) (Y : AlgebraicGeometry.Scheme.{u}) (_ : Y ⟶ S_k),
        LocallyConstant ↥Y (ULift.{u} (ZMod (ℓ ^ r))) →+
          Additive (Units ↑(Y.presheaf.obj (Opposite.op ⊤))) :=
      fun r Y π_Y =>
        { toFun := fun s => Additive.ofMul
            { val := val_Φ r Y π_Y s
              inv := val_Φ r Y π_Y (-s)
              val_inv := (h_val_add r Y π_Y s (-s)).symm.trans
                ((congrArg (val_Φ r Y π_Y) (add_neg_cancel s)).trans (h_val_zero r Y π_Y))
              inv_val := (h_val_add r Y π_Y (-s) s).symm.trans
                ((congrArg (val_Φ r Y π_Y) (neg_add_cancel s)).trans (h_val_zero r Y π_Y)) }
          map_zero' := by
            rw [← ofMul_one]
            congr 1
            ext
            exact h_val_zero r Y π_Y
          map_add' := fun s₁ s₂ => by
            rw [← ofMul_mul]
            congr 1
            ext
            exact h_val_add r Y π_Y s₁ s₂ }

    have h_nsmul_unit :
        ∀ {R : Type u} [CommRing R] (n : ℕ) (u : Additive (Units R)),
          ((Additive.toMul (n • u) : Units R) : R) = ((Additive.toMul u : Units R) : R) ^ n := by
      intro R _ n u
      rw [toMul_nsmul, Units.val_pow_eq_pow_val]

    refine ⟨Φ_sch, ?_, ?_, ?_, ?_, ?_⟩
    · 
      intro r Y₁ Y₂ f π₂ s
      let s₁ : LocallyConstant ↥Y₁ (ULift.{u} (ZMod (ℓ ^ r))) :=
        ⟨fun x => s (f.base x),
         fun t => f.base.hom.continuous.isOpen_preimage _ (s.isLocallyConstant t)⟩
      change Additive.ofMul _ = Additive.ofMul _
      congr 1
      ext
      change val_Φ r Y₁ (f ≫ π₂) s₁ = f.appTop.hom (val_Φ r Y₂ π₂ s)
      symm
      apply (Classical.choose_spec (h_val_glue r Y₁ (f ≫ π₂) s₁)).2
      intro a
      have h_kmap_eq : kMap_of Y₁ (f ≫ π₂) = f.appTop.hom.comp (kMap_of Y₂ π₂) := by
        show ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ (f ≫ π₂).appTop).hom =
          f.appTop.hom.comp
            ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ π₂.appTop).hom
        rw [AlgebraicGeometry.Scheme.Hom.comp_appTop f π₂]
        rfl
      have hV_le : V_clop Y₁ s₁ a ≤ (TopologicalSpace.Opens.map f.base).obj (V_clop Y₂ s a) :=
        fun _ hp => hp
      let f_Va := f.appLE (V_clop Y₂ s a) (V_clop Y₁ s₁ a) hV_le
      have h_nat_top :
          f.appTop ≫ Y₁.presheaf.map (CategoryTheory.homOfLE (le_top : V_clop Y₁ s₁ a ≤ ⊤)).op =
            Y₂.presheaf.map (CategoryTheory.homOfLE (le_top : V_clop Y₂ s a ≤ ⊤)).op ≫ f_Va :=
        (congrArg (· ≫ Y₁.presheaf.map (CategoryTheory.homOfLE (le_top : V_clop Y₁ s₁ a ≤ ⊤)).op)
          (@AlgebraicGeometry.Scheme.Hom.app_eq_appLE Y₁ Y₂ f ⊤)).trans
          ((AlgebraicGeometry.Scheme.Hom.appLE_map f le_rfl
            (CategoryTheory.homOfLE (le_top : V_clop Y₁ s₁ a ≤ ⊤)).op).trans
            (AlgebraicGeometry.Scheme.Hom.map_appLE f hV_le
              (CategoryTheory.homOfLE (le_top : V_clop Y₂ s a ≤ ⊤)).op).symm)
      calc
        (Y₁.presheaf.map (CategoryTheory.homOfLE (le_top : V_clop Y₁ s₁ a ≤ ⊤)).op).hom
            (f.appTop.hom (val_Φ r Y₂ π₂ s))
          = (f.appTop ≫ Y₁.presheaf.map (CategoryTheory.homOfLE (le_top : V_clop Y₁ s₁ a ≤ ⊤)).op).hom
              (val_Φ r Y₂ π₂ s) := rfl
        _ = (Y₂.presheaf.map (CategoryTheory.homOfLE (le_top : V_clop Y₂ s a ≤ ⊤)).op ≫
              f_Va).hom (val_Φ r Y₂ π₂ s) :=
            congrArg (fun g => g.hom (val_Φ r Y₂ π₂ s)) h_nat_top
        _ = f_Va.hom
              ((Y₂.presheaf.map (CategoryTheory.homOfLE (le_top : V_clop Y₂ s a ≤ ⊤)).op).hom
                (val_Φ r Y₂ π₂ s)) := rfl
        _ = f_Va.hom
              (((Y₂.presheaf.map (CategoryTheory.homOfLE (le_top : V_clop Y₂ s a ≤ ⊤)).op).hom
                (kMap_of Y₂ π₂ ((ζ r : kˣ) : k))) ^ a.val) := by rw [h_val_res]
        _ = ((Y₂.presheaf.map (CategoryTheory.homOfLE (le_top : V_clop Y₂ s a ≤ ⊤)).op ≫
              f_Va).hom (kMap_of Y₂ π₂ ((ζ r : kˣ) : k))) ^ a.val :=
            map_pow _ _ _
        _ = ((f.appTop ≫
              Y₁.presheaf.map (CategoryTheory.homOfLE (le_top : V_clop Y₁ s₁ a ≤ ⊤)).op).hom
              (kMap_of Y₂ π₂ ((ζ r : kˣ) : k))) ^ a.val :=
            congrArg (fun g => (g.hom (kMap_of Y₂ π₂ ((ζ r : kˣ) : k))) ^ a.val) h_nat_top.symm
        _ = ((Y₁.presheaf.map (CategoryTheory.homOfLE (le_top : V_clop Y₁ s₁ a ≤ ⊤)).op).hom
              (kMap_of Y₁ (f ≫ π₂) ((ζ r : kˣ) : k))) ^ a.val := by rw [h_kmap_eq]; rfl

    · 
      intro r Y π_Y a
      change val_Φ r Y π_Y (LocallyConstant.const ↥Y (ULift.up a)) =
        (kMap_of Y π_Y ((ζ r : kˣ) : k)) ^ a.val
      apply h_sec_ext Y
      intro p
      rw [map_pow]
      exact h_germ_val r Y π_Y (LocallyConstant.const ↥Y (ULift.up a)) p

    · 
      intro r Y π_Y
      have _ : NeZero (ℓ ^ r) := hNeZero r
      rw [← AddMonoidHom.ker_eq_bot_iff, eq_bot_iff]
      intro s hs
      rw [AddMonoidHom.mem_ker] at hs
      have h_val_one : val_Φ r Y π_Y s = 1 :=
        congrArg (fun u : Additive (Units _) => Units.val (Additive.toMul u)) hs
      ext p
      let a : ZMod (ℓ ^ r) := (s p).down
      have hg : ((Y.presheaf.germ ⊤ p trivial).hom (kMap_of Y π_Y ((ζ r : kˣ) : k))) ^ a.val = 1 := by
        rw [← h_germ_val r Y π_Y s p, h_val_one, map_one]
      let ψ_p : k →+* ↑(Y.presheaf.stalk p) :=
        (Y.presheaf.germ ⊤ p trivial).hom.comp (kMap_of Y π_Y)
      have hψ_pow : ψ_p (((ζ r : kˣ) : k) ^ a.val) = ψ_p 1 := by
        rw [map_pow, map_one]
        exact hg
      have hz_one : ((ζ r : kˣ) : k) ^ a.val = 1 := RingHom.injective ψ_p hψ_pow
      have hdvd : ℓ ^ r ∣ a.val := ((hPrim r).pow_eq_one_iff_dvd a.val).mp hz_one
      have ha_val0 : a.val = 0 := Nat.eq_zero_of_dvd_of_lt hdvd (ZMod.val_lt a)
      exact ZMod.val_injective (ℓ ^ r) (ha_val0.trans ZMod.val_zero.symm)

    · 
      intro r Y π_Y u
      let n := ℓ ^ r
      have _ : NeZero n := hNeZero r
      constructor
      · intro hu_tor
        let R_Y := ↑(Y.presheaf.obj (Opposite.op ⊤))
        let v : R_Y := ((Additive.toMul u : Units R_Y) : R_Y)
        have hv_pow : v ^ n = 1 := by
          have h1 := congrArg (fun w : Additive (Units R_Y) => Units.val (Additive.toMul w)) hu_tor
          rw [h_nsmul_unit n u] at h1
          exact h1
        let ν : ZMod n → k := fun a => ((ζ r : kˣ) : k) ^ a.val
        have hν_inj : Function.Injective ν := by
          intro a b hab
          exact ZMod.val_injective n
            ((hPrim r).pow_inj (ZMod.val_lt a) (ZMod.val_lt b) hab)
        have hν_injOn : Set.InjOn ν ↑(Finset.univ : Finset (ZMod n)) :=
          fun _ _ _ _ h => hν_inj h

        have h_prod_dvd :
            ∀ (Q : Polynomial k) (S_fin : Finset (ZMod n)),
              (∀ a ∈ S_fin, Q.eval (ν a) = 0) →
              (∏ a ∈ S_fin, (Polynomial.X - Polynomial.C (ν a))) ∣ Q := by
          intro Q S_fin
          induction S_fin using Finset.induction_on with
          | empty =>
            intro _
            rw [Finset.prod_empty]
            exact one_dvd Q
          | @insert a S' ha_not_mem ih =>
            intro h_roots
            rw [Finset.prod_insert ha_not_mem]
            have hdvd_a : (Polynomial.X - Polynomial.C (ν a)) ∣ Q :=
              Polynomial.dvd_iff_isRoot.mpr (h_roots a (Finset.mem_insert_self a S'))
            have hdvd_S' : (∏ b ∈ S', (Polynomial.X - Polynomial.C (ν b))) ∣ Q :=
              ih (fun b hb => h_roots b (Finset.mem_insert_of_mem hb))
            let P_S' : Polynomial k := ∏ b ∈ S', (Polynomial.X - Polynomial.C (ν b))
            let c : k := P_S'.eval (ν a)
            have hc_ne : c ≠ 0 := by
              dsimp [c, P_S']
              rw [Polynomial.eval_prod]
              apply Finset.prod_ne_zero_iff.mpr
              intro b hb
              simp only [Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C, sub_ne_zero]
              exact fun h_eq => ha_not_mem (hν_inj h_eq ▸ hb)
            have h_diff_root : (P_S' - Polynomial.C c).IsRoot (ν a) := by
              simp [Polynomial.IsRoot, c]
            obtain ⟨H, hH⟩ := Polynomial.dvd_iff_isRoot.mpr h_diff_root
            have h_cop : IsCoprime (Polynomial.X - Polynomial.C (ν a)) P_S' := by
              refine ⟨-(Polynomial.C c⁻¹ * H), Polynomial.C c⁻¹, ?_⟩
              calc
                -(Polynomial.C c⁻¹ * H) * (Polynomial.X - Polynomial.C (ν a)) +
                    Polynomial.C c⁻¹ * P_S'
                  = Polynomial.C c⁻¹ * (P_S' - (Polynomial.X - Polynomial.C (ν a)) * H) := by ring
                _ = Polynomial.C c⁻¹ * Polynomial.C c := by rw [← hH]; ring
                _ = 1 := by rw [← Polynomial.C_mul, inv_mul_cancel₀ hc_ne, Polynomial.C_1]
            exact h_cop.mul_dvd hdvd_a hdvd_S'

        have h_Xn_eq_prod :
            (Polynomial.X ^ n - 1 : Polynomial k) =
              ∏ a ∈ (Finset.univ : Finset (ZMod n)), (Polynomial.X - Polynomial.C (ν a)) := by
          let P_univ : Polynomial k :=
            ∏ a ∈ (Finset.univ : Finset (ZMod n)), (Polynomial.X - Polynomial.C (ν a))
          have h_dvd : P_univ ∣ (Polynomial.X ^ n - 1 : Polynomial k) := by
            apply h_prod_dvd
            intro a _
            simp only [ν, Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X,
              Polynomial.eval_one]
            rw [← pow_mul, mul_comm, pow_mul, (hPrim r).pow_eq_one, one_pow, sub_self]
          obtain ⟨K, hK⟩ := h_dvd
          have h_monic_P : P_univ.Monic :=
            Polynomial.monic_prod_of_monic Finset.univ _
              (fun a _ => Polynomial.monic_X_sub_C (ν a))
          have h_deg_P : P_univ.natDegree = n := by
            dsimp [P_univ]
            rw [Polynomial.natDegree_prod_of_monic Finset.univ _
              (fun a _ => Polynomial.monic_X_sub_C (ν a))]
            simp [ZMod.card]
          have h_monic_Xn : (Polynomial.X ^ n - 1 : Polynomial k).Monic := by
            simpa using Polynomial.monic_X_pow_sub_C (1 : k) (NeZero.ne n)
          have h_deg_Xn : (Polynomial.X ^ n - 1 : Polynomial k).natDegree = n := by
            simpa using (Polynomial.natDegree_X_pow_sub_C (R := k) (n := n) (r := 1))
          have hK_ne : K ≠ 0 := by
            intro hK0
            rw [hK0, mul_zero] at hK
            exact h_monic_Xn.ne_zero hK
          have h_deg_mul : n = n + K.natDegree := by
            calc
              n = (Polynomial.X ^ n - 1 : Polynomial k).natDegree := h_deg_Xn.symm
              _ = (P_univ * K).natDegree := congrArg Polynomial.natDegree hK
              _ = P_univ.natDegree + K.natDegree :=
                Polynomial.natDegree_mul h_monic_P.ne_zero hK_ne
              _ = n + K.natDegree := by rw [h_deg_P]
          have hK_deg0 : K.natDegree = 0 := by omega
          have hK_eq_C : K = Polynomial.C (K.coeff 0) :=
            Polynomial.eq_C_of_natDegree_eq_zero hK_deg0
          have h_lc : (1 : k) = K.coeff 0 := by
            calc
              (1 : k) = (Polynomial.X ^ n - 1 : Polynomial k).leadingCoeff := h_monic_Xn.leadingCoeff.symm
              _ = (P_univ * K).leadingCoeff := congrArg Polynomial.leadingCoeff hK
              _ = P_univ.leadingCoeff * K.leadingCoeff := Polynomial.leadingCoeff_mul P_univ K
              _ = 1 * K.leadingCoeff := by rw [h_monic_P.leadingCoeff]
              _ = K.coeff 0 := by rw [one_mul, Polynomial.leadingCoeff, hK_deg0]
          rw [hK, hK_eq_C, ← h_lc, Polynomial.C_1, mul_one]

        have h_dvd_of_roots :
            ∀ Q : Polynomial k,
              (∀ c : ZMod n, Q.eval (ν c) = 0) → (Polynomial.X ^ n - 1 : Polynomial k) ∣ Q := by
          intro Q hQ
          rw [h_Xn_eq_prod]
          exact h_prod_dvd Q Finset.univ (fun c _ => hQ c)

        let L_poly : ZMod n → Polynomial k := Lagrange.basis Finset.univ ν
        have h_sum_L : (∑ a : ZMod n, L_poly a) = 1 :=
          Lagrange.sum_basis hν_injOn ⟨0, Finset.mem_univ 0⟩
        have h_eig_L :
            ∀ a : ZMod n,
              (Polynomial.X ^ n - 1 : Polynomial k) ∣
                ((Polynomial.X - Polynomial.C (ν a)) * L_poly a) := by
          intro a
          apply h_dvd_of_roots
          intro c
          simp only [Polynomial.eval_mul, Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C]
          by_cases hca : c = a
          · subst hca; rw [sub_self, zero_mul]
          · dsimp [L_poly]
            rw [Lagrange.eval_basis_of_ne (Ne.symm hca) (Finset.mem_univ c), mul_zero]
        have h_orth_L :
            ∀ (a b : ZMod n), a ≠ b →
              (Polynomial.X ^ n - 1 : Polynomial k) ∣ (L_poly a * L_poly b) := by
          intro a b hab
          apply h_dvd_of_roots
          intro c
          rw [Polynomial.eval_mul]
          dsimp [L_poly]
          by_cases hca : c = a
          · subst hca
            rw [Lagrange.eval_basis_of_ne hab.symm (Finset.mem_univ c), mul_zero]
          · rw [Lagrange.eval_basis_of_ne (Ne.symm hca) (Finset.mem_univ c), zero_mul]

        let ev_v : Polynomial k →+* R_Y := Polynomial.eval₂RingHom (kMap_of Y π_Y) v
        have hev_Xn : ev_v (Polynomial.X ^ n - 1) = 0 := by
          simp [ev_v, hv_pow]
        have hev_zero_of_dvd :
            ∀ P : Polynomial k, (Polynomial.X ^ n - 1 : Polynomial k) ∣ P → ev_v P = 0 := by
          rintro P ⟨Q, rfl⟩
          rw [map_mul, hev_Xn, zero_mul]

        let e_idem : ZMod n → R_Y := fun a => ev_v (L_poly a)
        have he_sum : (∑ a : ZMod n, e_idem a) = 1 := by
          dsimp [e_idem]
          rw [← map_sum, h_sum_L, map_one]
        have he_eig : ∀ a : ZMod n, (v - kMap_of Y π_Y (ν a)) * e_idem a = 0 := by
          intro a
          have h0 := hev_zero_of_dvd _ (h_eig_L a)
          simpa [ev_v, e_idem] using h0
        have he_orth : ∀ (a b : ZMod n), a ≠ b → e_idem a * e_idem b = 0 := by
          intro a b hab
          have h0 := hev_zero_of_dvd _ (h_orth_L a b hab)
          simpa [e_idem] using h0

        let W_open : ZMod n → Y.Opens := fun a => Y.basicOpen (e_idem a)
        have h_pt_mem : ∀ p : ↥Y, ∃ a : ZMod n, p ∈ W_open a := by
          intro p
          by_contra h_none
          simp only [not_exists] at h_none
          have h_in_max :
              ∀ a : ZMod n,
                (Y.presheaf.germ ⊤ p trivial).hom (e_idem a) ∈
                  IsLocalRing.maximalIdeal ↑(Y.presheaf.stalk p) := by
            intro a
            by_contra h_not_mem
            apply h_none a
            exact (AlgebraicGeometry.RingedSpace.mem_basicOpen Y.toRingedSpace
              (e_idem a) p trivial).mpr (IsLocalRing.notMem_maximalIdeal.mp h_not_mem)
          have h_sum_mem :
              (∑ a ∈ (Finset.univ : Finset (ZMod n)),
                (Y.presheaf.germ ⊤ p trivial).hom (e_idem a)) ∈
                IsLocalRing.maximalIdeal ↑(Y.presheaf.stalk p) :=
            Ideal.sum_mem _ (fun a _ => h_in_max a)
          rw [← map_sum, he_sum, map_one] at h_sum_mem
          exact (IsLocalRing.maximalIdeal.isMaximal ↑(Y.presheaf.stalk p)).ne_top
            (Ideal.eq_top_of_isUnit_mem _ h_sum_mem isUnit_one)
        have h_pt_uniq : ∀ (p : ↥Y) (a b : ZMod n), p ∈ W_open a → p ∈ W_open b → a = b := by
          intro p a b ha hb
          by_contra hab
          have hua : IsUnit ((Y.presheaf.germ ⊤ p trivial).hom (e_idem a)) :=
            (AlgebraicGeometry.RingedSpace.mem_basicOpen Y.toRingedSpace (e_idem a) p trivial).mp ha
          have hub : IsUnit ((Y.presheaf.germ ⊤ p trivial).hom (e_idem b)) :=
            (AlgebraicGeometry.RingedSpace.mem_basicOpen Y.toRingedSpace (e_idem b) p trivial).mp hb
          have h_prod_u : IsUnit ((Y.presheaf.germ ⊤ p trivial).hom (e_idem a * e_idem b)) := by
            rw [map_mul]
            exact hua.mul hub
          rw [he_orth a b hab, map_zero] at h_prod_u
          exact not_isUnit_zero h_prod_u

        let s_fn : ↥Y → ULift.{u} (ZMod n) := fun p => ULift.up (Classical.choose (h_pt_mem p))
        have hs_iff : ∀ (p : ↥Y) (c : ZMod n), s_fn p = ULift.up c ↔ p ∈ W_open c := by
          intro p c
          constructor
          · intro h_eq
            have hc : Classical.choose (h_pt_mem p) = c := ULift.up.inj h_eq
            rw [← hc]
            exact Classical.choose_spec (h_pt_mem p)
          · intro hp_c
            exact congrArg ULift.up
              (h_pt_uniq p (Classical.choose (h_pt_mem p)) c
                (Classical.choose_spec (h_pt_mem p)) hp_c)
        have hs_lc : IsLocallyConstant s_fn := by
          intro E
          have h_eq_pre :
              s_fn ⁻¹' E = ⋃ (c : ZMod n) (_ : ULift.up c ∈ E), (W_open c : Set ↥Y) := by
            ext p
            simp only [Set.mem_preimage, Set.mem_iUnion, SetLike.mem_coe]
            constructor
            · intro hp
              exact ⟨(s_fn p).down, hp, (hs_iff p (s_fn p).down).mp rfl⟩
            · rintro ⟨c, hcE, hpc⟩
              rw [(hs_iff p c).mpr hpc]
              exact hcE
          rw [h_eq_pre]
          exact isOpen_iUnion fun c => isOpen_iUnion fun _ => (W_open c).isOpen
        let s_wit : LocallyConstant ↥Y (ULift.{u} (ZMod n)) :=
          { toFun := s_fn, isLocallyConstant := hs_lc }
        refine ⟨s_wit, ?_⟩
        have h_val_eq_v : val_Φ r Y π_Y s_wit = v := by
          apply h_sec_ext Y
          intro p
          let a : ZMod n := Classical.choose (h_pt_mem p)
          have hp_Wa : p ∈ W_open a := Classical.choose_spec (h_pt_mem p)
          have hua : IsUnit ((Y.presheaf.germ ⊤ p trivial).hom (e_idem a)) :=
            (AlgebraicGeometry.RingedSpace.mem_basicOpen Y.toRingedSpace (e_idem a) p trivial).mp hp_Wa
          have h_germ_eig :
              ((Y.presheaf.germ ⊤ p trivial).hom v -
                (Y.presheaf.germ ⊤ p trivial).hom (kMap_of Y π_Y (ν a))) *
                (Y.presheaf.germ ⊤ p trivial).hom (e_idem a) = 0 := by
            rw [← map_sub, ← map_mul, he_eig a, map_zero]
          have h_sub_zero :
              (Y.presheaf.germ ⊤ p trivial).hom v -
                (Y.presheaf.germ ⊤ p trivial).hom (kMap_of Y π_Y (ν a)) = 0 :=
            hua.mul_left_eq_zero.mp h_germ_eig
          have hv_germ :
              (Y.presheaf.germ ⊤ p trivial).hom v =
                ((Y.presheaf.germ ⊤ p trivial).hom (kMap_of Y π_Y ((ζ r : kˣ) : k))) ^ a.val := by
            rw [sub_eq_zero.mp h_sub_zero]
            dsimp [ν]
            rw [map_pow, map_pow]
          rw [h_germ_val r Y π_Y s_wit p, hv_germ]
          rfl
        apply Additive.toMul.injective
        ext
        exact h_val_eq_v
      · rintro ⟨s, rfl⟩
        apply Additive.toMul.injective
        ext
        rw [h_nsmul_unit n (Φ_sch r Y π_Y s)]
        change (val_Φ r Y π_Y s) ^ n = 1
        apply h_sec_ext Y
        intro p
        rw [map_pow, map_one, h_germ_val r Y π_Y s p, ← pow_mul, mul_comm, pow_mul]
        let ψ_p : k →+* ↑(Y.presheaf.stalk p) :=
          (Y.presheaf.germ ⊤ p trivial).hom.comp (kMap_of Y π_Y)
        calc
          (ψ_p ((ζ r : kˣ) : k) ^ n) ^ (s p).down.val
            = (ψ_p (((ζ r : kˣ) : k) ^ n)) ^ (s p).down.val := by rw [map_pow]
          _ = (ψ_p 1) ^ (s p).down.val := by rw [(hPrim r).pow_eq_one]
          _ = 1 := by rw [map_one, one_pow]

    · 
      intro r Y π_Y s
      have _ : NeZero (ℓ ^ r) := hNeZero r
      have _ : NeZero (ℓ ^ (r + 1)) := hNeZero (r + 1)
      apply Additive.toMul.injective
      ext
      rw [h_nsmul_unit ℓ (Φ_sch (r + 1) Y π_Y s)]
      let s₀ := s.map (ULift.map (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r))))
      change (val_Φ (r + 1) Y π_Y s) ^ ℓ = val_Φ r Y π_Y s₀
      apply h_sec_ext Y
      intro p
      rw [map_pow, h_germ_val (r + 1) Y π_Y s p, h_germ_val r Y π_Y s₀ p]
      let a : ZMod (ℓ ^ (r + 1)) := (s p).down
      let b : ZMod (ℓ ^ r) := ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r)) a
      have hs₀_p : (s₀ p).down = b := rfl
      rw [hs₀_p]
      have h_pow_k :
          ((((ζ (r + 1) : kˣ) : k) ^ a.val) ^ ℓ) = (((ζ r : kˣ) : k) ^ b.val) := by
        have h1 : (((ζ (r + 1) : kˣ) : k) ^ a.val) ^ ℓ = (((ζ r : kˣ) : k) ^ a.val) := by
          rw [← pow_mul, mul_comm, pow_mul, ← Units.val_pow_eq_pow_val, hPow r]
        rw [h1]
        have hb_eq : b = (a.val : ZMod (ℓ ^ r)) := by
          show ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r)) a = (a.val : ZMod (ℓ ^ r))
          rw [ZMod.castHom_apply]
          exact ZMod.cast_eq_val a
        have hb_val : b.val = a.val % (ℓ ^ r) := by
          rw [hb_eq, ZMod.val_natCast]
        conv_lhs => rw [(Nat.mod_add_div a.val (ℓ ^ r)).symm]
        rw [pow_add, pow_mul, (hPrim r).pow_eq_one, one_pow, mul_one, hb_val]
      let ψ_p : k →+* ↑(Y.presheaf.stalk p) :=
        (Y.presheaf.germ ⊤ p trivial).hom.comp (kMap_of Y π_Y)
      simpa [ψ_p, map_pow] using congrArg ψ_p h_pow_k

  obtain ⟨Φ_sch, hΦ_nat, hΦ_pin, hΦ_inj, hΦ_ker, hΦ_trans⟩ := hΦ_sch_pkg

  
  
  
  refine ⟨hBaseTrace, ?_⟩
  let G_sh : CategoryTheory.Sheaf J AddCommGrpCat.{u} := ⟨weilEtaleGmPresheaf S, hGm_sh⟩
  let e_G : G_sh ≅ weilEtaleGmSheaf S := CategoryTheory.sheafificationIso G_sh
  have he_G_unit :
      e_G.hom.hom =
        (CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}).unit.app
          (weilEtaleGmPresheaf S) := by
    change (CategoryTheory.isoSheafify J hGm_sh).hom = _
    rw [CategoryTheory.isoSheafify_hom, CategoryTheory.sheafificationAdjunction_unit_app]

  let Φ_et : ∀ (r : ℕ) (U : S.Etale),
      LocallyConstant ↥(Fgt.obj U).left (ULift.{u} (ZMod (ℓ ^ r))) →+
        ↑((weilEtaleGmPresheaf S).obj (Opposite.op U)) :=
    fun r U => Φ_sch r (Fgt.obj U).left ((Fgt.obj U).hom ≫ X.hom)

  let ι_LG : ∀ r : ℕ, L_sh r ⟶ G_sh :=
    fun r =>
      { hom :=
          { app := fun U => AddCommGrpCat.ofHom (Φ_et r (Opposite.unop U))
            naturality := fun {U₁ U₂} f => by
              ext (s : LocallyConstant ↥(Fgt.obj (Opposite.unop U₁)).left (ULift.{u} (ZMod (ℓ ^ r))))
              dsimp [Φ_et, weilEtaleGmPresheaf]
              have hw : (Fgt.map f.unop).left ≫ (Fgt.obj (Opposite.unop U₁)).hom =
                  (Fgt.obj (Opposite.unop U₂)).hom :=
                CategoryTheory.MorphismProperty.Over.w f.unop
              have h_hom_eq :
                  (Fgt.obj (Opposite.unop U₂)).hom ≫ X.hom =
                    (Fgt.map f.unop).left ≫ ((Fgt.obj (Opposite.unop U₁)).hom ≫ X.hom) := by
                rw [← CategoryTheory.Category.assoc, hw]
              change Φ_sch r (Fgt.obj (Opposite.unop U₂)).left
                  ((Fgt.obj (Opposite.unop U₂)).hom ≫ X.hom) _ =
                MonoidHom.toAdditive (Units.map ((Fgt.map f.unop).left).appTop.hom.toMonoidHom)
                  (Φ_sch r (Fgt.obj (Opposite.unop U₁)).left
                    ((Fgt.obj (Opposite.unop U₁)).hom ≫ X.hom) s)
              rw [h_hom_eq]
              exact hΦ_nat r (Fgt.map f.unop).left ((Fgt.obj (Opposite.unop U₁)).hom ≫ X.hom) s } }

  let ι_kum : ∀ r : ℕ, weilEtaleTorsionSheaf S (ℓ ^ r) ⟶ weilEtaleGmSheaf S :=
    fun r => (e_L r).hom ≫ ι_LG r ≫ e_G.hom
  let p_kum : ∀ r : ℕ, weilEtaleGmSheaf S ⟶ weilEtaleGmSheaf S :=
    fun r => (ℓ ^ r) • CategoryTheory.CategoryStruct.id (weilEtaleGmSheaf S)
  let p_G : ∀ r : ℕ, G_sh ⟶ G_sh :=
    fun r => (ℓ ^ r) • CategoryTheory.CategoryStruct.id G_sh

  have hEpi_pkum : ∀ r : ℕ, CategoryTheory.Epi (p_kum r) := by
    intro r
    induction r with
    | zero =>
      dsimp [p_kum]
      rw [one_nsmul]
      infer_instance
    | succ r ih =>
      have h_fac :
          p_kum (r + 1) =
            p_kum r ≫ (ℓ • CategoryTheory.CategoryStruct.id (weilEtaleGmSheaf S)) := by
        dsimp [p_kum]
        rw [CategoryTheory.Preadditive.nsmul_comp, CategoryTheory.Category.id_comp,
          pow_succ, mul_nsmul']
      rw [h_fac]
      have _ : CategoryTheory.Epi (p_kum r) := ih
      exact CategoryTheory.epi_comp (p_kum r)
        (ℓ • CategoryTheory.CategoryStruct.id (weilEtaleGmSheaf S))

  have hEpi_pG : ∀ r : ℕ, CategoryTheory.Epi (p_G r) := by
    intro r
    have h_conj : p_G r = e_G.hom ≫ p_kum r ≫ e_G.inv := by
      dsimp [p_G, p_kum]
      rw [CategoryTheory.Preadditive.nsmul_comp, CategoryTheory.Preadditive.comp_nsmul,
        CategoryTheory.Category.id_comp, e_G.hom_inv_id]
    rw [h_conj]
    have _ : CategoryTheory.Epi (p_kum r) := hEpi_pkum r
    exact CategoryTheory.epi_comp e_G.hom (p_kum r ≫ e_G.inv)

  have h_sheaf_nsmul_app :
      ∀ {ℱ : CategoryTheory.Sheaf J AddCommGrpCat.{u}} (n : ℕ) (U : (S.Etale)ᵒᵖ)
        (x : ↑(ℱ.obj.obj U)),
        ((n • CategoryTheory.CategoryStruct.id ℱ).hom.app U).hom x = n • x := by
    intro ℱ n U x
    induction n with
    | zero =>
      rw [zero_nsmul, zero_nsmul]
      rfl
    | succ n ih =>
      rw [succ_nsmul, CategoryTheory.Sheaf.Hom.add_app, AddCommGrpCat.hom_add,
        AddMonoidHom.add_apply, ih, succ_nsmul]
      rfl

  have h0_LG : ∀ r : ℕ, ι_LG r ≫ p_G r = 0 := by
    intro r
    apply CategoryTheory.Sheaf.hom_ext
    ext U (s : LocallyConstant ↥(Fgt.obj (Opposite.unop U)).left (ULift.{u} (ZMod (ℓ ^ r))))
    change ((p_G r).hom.app U).hom (Φ_et r (Opposite.unop U) s) = 0
    rw [h_sheaf_nsmul_app (ℓ ^ r) U]
    exact (hΦ_ker r (Fgt.obj (Opposite.unop U)).left
      ((Fgt.obj (Opposite.unop U)).hom ≫ X.hom) _).mpr ⟨s, rfl⟩

  have h0_kum : ∀ r : ℕ, ι_kum r ≫ p_kum r = 0 := by
    intro r
    dsimp [ι_kum, p_kum]
    have h_comm_G : e_G.hom ≫ ((ℓ ^ r) • CategoryTheory.CategoryStruct.id (weilEtaleGmSheaf S)) =
        p_G r ≫ e_G.hom := by
      dsimp [p_G]
      rw [CategoryTheory.Preadditive.comp_nsmul, CategoryTheory.Preadditive.nsmul_comp,
        CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
    rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, h_comm_G,
      ← CategoryTheory.Category.assoc (ι_LG r), h0_LG r,
      CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.comp_zero]

  have hMono_LG : ∀ r : ℕ, CategoryTheory.Mono (ι_LG r) := by
    intro r
    refine ⟨fun {W_sh} g₁ g₂ hg => ?_⟩
    apply CategoryTheory.Sheaf.hom_ext
    ext U w
    apply hΦ_inj r (Fgt.obj (Opposite.unop U)).left ((Fgt.obj (Opposite.unop U)).hom ≫ X.hom)
    exact congrArg (fun k : W_sh ⟶ G_sh => (k.hom.app U).hom w) hg

  have hEx_LG : ∀ r : ℕ, (CategoryTheory.ShortComplex.mk (ι_LG r) (p_G r) (h0_LG r)).ShortExact := by
    intro r
    have _ : CategoryTheory.Mono (ι_LG r) := hMono_LG r
    have _ : CategoryTheory.Epi (p_G r) := hEpi_pG r
    have h_ker : CategoryTheory.Limits.IsLimit
        (CategoryTheory.Limits.KernelFork.ofι (ι_LG r) (h0_LG r)) := by
      have h_lift_ex :
          ∀ {W_sh : CategoryTheory.Sheaf J AddCommGrpCat.{u}} (k_mor : W_sh ⟶ G_sh),
            k_mor ≫ p_G r = 0 →
            ∀ (U : S.Etale) (w : ↑(W_sh.obj.obj (Opposite.op U))),
              ∃ s : LocallyConstant ↥(Fgt.obj U).left (ULift.{u} (ZMod (ℓ ^ r))),
                Φ_et r U s = (k_mor.hom.app (Opposite.op U)).hom w := by
        intro W_sh k_mor hk U w
        let u_w : Additive (Units ↑((Fgt.obj U).left.presheaf.obj (Opposite.op ⊤))) :=
          (k_mor.hom.app (Opposite.op U)).hom w
        have hu_tor : (ℓ ^ r) • u_w = 0 := by
          have h_app : ((p_G r).hom.app (Opposite.op U)).hom
              ((k_mor.hom.app (Opposite.op U)).hom w) = 0 :=
            congrArg (fun q : W_sh ⟶ G_sh => (q.hom.app (Opposite.op U)).hom w) hk
          exact (h_sheaf_nsmul_app (ℓ ^ r) (Opposite.op U)
            ((k_mor.hom.app (Opposite.op U)).hom w)).symm.trans h_app
        exact (hΦ_ker r (Fgt.obj U).left ((Fgt.obj U).hom ≫ X.hom) u_w).mp hu_tor
      let lift_mor :
          ∀ {W_sh : CategoryTheory.Sheaf J AddCommGrpCat.{u}} (k_mor : W_sh ⟶ G_sh),
            k_mor ≫ p_G r = 0 → (W_sh ⟶ L_sh r) :=
        fun {W_sh} k_mor hk =>
          let fn : ∀ (U : S.Etale),
              ↑(W_sh.obj.obj (Opposite.op U)) →
                LocallyConstant ↥(Fgt.obj U).left (ULift.{u} (ZMod (ℓ ^ r))) :=
            fun U w => Classical.choose (h_lift_ex k_mor hk U w)
          have hfn : ∀ (U : S.Etale) (w : ↑(W_sh.obj.obj (Opposite.op U))),
              Φ_et r U (fn U w) = (k_mor.hom.app (Opposite.op U)).hom w :=
            fun U w => Classical.choose_spec (h_lift_ex k_mor hk U w)
          { hom :=
              { app := fun U => AddCommGrpCat.ofHom
                  { toFun := fn (Opposite.unop U)
                    map_zero' := by
                      apply hΦ_inj r (Fgt.obj (Opposite.unop U)).left
                        ((Fgt.obj (Opposite.unop U)).hom ≫ X.hom)
                      exact (hfn (Opposite.unop U) 0).trans
                        ((map_zero (k_mor.hom.app U).hom).trans (map_zero (Φ_et r _)).symm)
                    map_add' := fun w₁ w₂ => by
                      apply hΦ_inj r (Fgt.obj (Opposite.unop U)).left
                        ((Fgt.obj (Opposite.unop U)).hom ≫ X.hom)
                      calc
                        Φ_et r (Opposite.unop U) (fn (Opposite.unop U) (w₁ + w₂))
                          = (k_mor.hom.app U).hom (w₁ + w₂) := hfn (Opposite.unop U) (w₁ + w₂)
                        _ = (k_mor.hom.app U).hom w₁ + (k_mor.hom.app U).hom w₂ :=
                            map_add (k_mor.hom.app U).hom w₁ w₂
                        _ = Φ_et r (Opposite.unop U) (fn (Opposite.unop U) w₁) +
                              Φ_et r (Opposite.unop U) (fn (Opposite.unop U) w₂) := by
                            rw [hfn (Opposite.unop U) w₁, hfn (Opposite.unop U) w₂]
                        _ = Φ_et r (Opposite.unop U)
                              (fn (Opposite.unop U) w₁ + fn (Opposite.unop U) w₂) :=
                            (map_add (Φ_et r (Opposite.unop U)) _ _).symm }
                naturality := fun {U₁ U₂} f => by
                  ext w
                  change fn (Opposite.unop U₂) ((W_sh.obj.map f).hom w) =
                    (((L_sh r).obj.map f).hom (fn (Opposite.unop U₁) w))
                  apply hΦ_inj r (Fgt.obj (Opposite.unop U₂)).left
                    ((Fgt.obj (Opposite.unop U₂)).hom ≫ X.hom)
                  have h_lhs :
                      Φ_et r (Opposite.unop U₂) (fn (Opposite.unop U₂) ((W_sh.obj.map f).hom w)) =
                        (G_sh.obj.map f).hom ((k_mor.hom.app U₁).hom w) :=
                    (hfn (Opposite.unop U₂) ((W_sh.obj.map f).hom w)).trans
                      (congrArg (fun g : W_sh.obj.obj U₁ ⟶ G_sh.obj.obj U₂ => g.hom w)
                        (k_mor.hom.naturality f))
                  have h_rhs :
                      Φ_et r (Opposite.unop U₂)
                        (((L_sh r).obj.map f).hom (fn (Opposite.unop U₁) w)) =
                      (G_sh.obj.map f).hom (Φ_et r (Opposite.unop U₁) (fn (Opposite.unop U₁) w)) :=
                    congrArg (fun g : (L_sh r).obj.obj U₁ ⟶ G_sh.obj.obj U₂ =>
                      g.hom (fn (Opposite.unop U₁) w)) ((ι_LG r).hom.naturality f)
                  exact h_lhs.trans
                    ((congrArg (G_sh.obj.map f).hom (hfn (Opposite.unop U₁) w).symm).trans
                      h_rhs.symm) } }
      have h_lift_fac :
          ∀ {W_sh : CategoryTheory.Sheaf J AddCommGrpCat.{u}} (k_mor : W_sh ⟶ G_sh)
            (hk : k_mor ≫ p_G r = 0),
            lift_mor k_mor hk ≫ ι_LG r = k_mor := by
        intro W_sh k_mor hk
        apply CategoryTheory.Sheaf.hom_ext
        ext U w
        exact Classical.choose_spec (h_lift_ex k_mor hk (Opposite.unop U) w)
      exact CategoryTheory.Limits.KernelFork.IsLimit.ofι (ι_LG r) (h0_LG r)
        (fun k_mor hk => lift_mor k_mor hk)
        (fun k_mor hk => h_lift_fac k_mor hk)
        (fun k_mor hk m_sh hm =>
          (CategoryTheory.cancel_mono (ι_LG r)).mp (hm.trans (h_lift_fac k_mor hk).symm))
    exact CategoryTheory.ShortComplex.ShortExact.mk'
      (CategoryTheory.ShortComplex.exact_of_f_is_kernel
        (CategoryTheory.ShortComplex.mk (ι_LG r) (p_G r) (h0_LG r)) h_ker)
      (hMono_LG r) (hEpi_pG r)

  have hEx_kum : ∀ r : ℕ, (CategoryTheory.ShortComplex.mk (ι_kum r) (p_kum r) (h0_kum r)).ShortExact := by
    intro r
    let iso_SC :
        CategoryTheory.ShortComplex.mk (ι_LG r) (p_G r) (h0_LG r) ≅
          CategoryTheory.ShortComplex.mk (ι_kum r) (p_kum r) (h0_kum r) :=
      CategoryTheory.ShortComplex.isoMk (e_L r).symm e_G e_G
        (by
          dsimp [ι_kum]
          rw [← CategoryTheory.Category.assoc, (e_L r).inv_hom_id,
            CategoryTheory.Category.id_comp])
        (by
          dsimp [p_G, p_kum]
          rw [CategoryTheory.Preadditive.nsmul_comp, CategoryTheory.Preadditive.comp_nsmul,
            CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id])
    exact (CategoryTheory.ShortComplex.shortExact_iff_of_iso iso_SC).mp (hEx_LG r)

  refine ⟨T_X, hT_X, ι_kum, p_kum, h0_kum, hEx_kum, fun _ => rfl, ?_, ?_⟩
  · 
    intro r a
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod (ℓ ^ r)))
    let η_gm := (CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}).unit.app
      (weilEtaleGmPresheaf S)
    let a_up : ↑AM := ULift.up a
    let u_pre : ↑((weilEtaleGmPresheaf S).obj (Opposite.op T_X)) :=
      Φ_et r T_X (LocallyConstant.const ↥(Fgt.obj T_X).left (ULift.up a))
    refine ⟨u_pre, ?_, ?_⟩
    · have h_pin_a :
          ((e_L r).hom.hom.app (Opposite.op T_X)).hom
            ((adj_X.unit.app AM).hom a_up) =
          LocallyConstant.const ↥(Fgt.obj T_X).left (ULift.up a) :=
        congrArg (fun g : AM ⟶ _ => g.hom a_up) (he_L r)
      have he_G_app :
          (η_gm.app (Opposite.op T_X)).hom u_pre =
            (e_G.hom.hom.app (Opposite.op T_X)).hom u_pre :=
        congrArg (fun η : weilEtaleGmPresheaf S ⟶ _ => (η.app (Opposite.op T_X)).hom u_pre)
          he_G_unit.symm
      show (η_gm.app (Opposite.op T_X)).hom u_pre =
        (adj_X.unit.app AM ≫ (ι_kum r).hom.app (Opposite.op T_X)).hom a_up
      rw [he_G_app]
      change (e_G.hom.hom.app (Opposite.op T_X)).hom u_pre =
        (e_G.hom.hom.app (Opposite.op T_X)).hom
          (Φ_et r T_X (((e_L r).hom.hom.app (Opposite.op T_X)).hom
            ((adj_X.unit.app AM).hom a_up)))
      rw [h_pin_a]
    · exact hΦ_pin r (Fgt.obj T_X).left ((Fgt.obj T_X).hom ≫ X.hom) a

  · 
    intro r ξ
    let cast_sh : weilEtaleTorsionSheaf S (ℓ ^ (r + 1)) ⟶ weilEtaleTorsionSheaf S (ℓ ^ r) :=
      (CategoryTheory.constantSheaf J AddCommGrpCat.{u}).map
        (AddCommGrpCat.uliftFunctor.{u, 0}.map
          (AddCommGrpCat.ofHom
            (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r))).toAddMonoidHom))
    have h_post_LG :
        post_cast r ≫ ι_LG r =
          ι_LG (r + 1) ≫ (ℓ • CategoryTheory.CategoryStruct.id G_sh) := by
      apply CategoryTheory.Sheaf.hom_ext
      ext U (s : LocallyConstant ↥(Fgt.obj (Opposite.unop U)).left (ULift.{u} (ZMod (ℓ ^ (r + 1)))))
      change Φ_et r (Opposite.unop U)
          (s.map (ULift.map (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r))))) =
        ((ℓ • CategoryTheory.CategoryStruct.id G_sh).hom.app U).hom
          (Φ_et (r + 1) (Opposite.unop U) s)
      rw [h_sheaf_nsmul_app ℓ U]
      exact (hΦ_trans r (Fgt.obj (Opposite.unop U)).left
        ((Fgt.obj (Opposite.unop U)).hom ≫ X.hom) s).symm
    have h_G_nsmul :
        (ℓ • CategoryTheory.CategoryStruct.id G_sh) ≫ e_G.hom =
          e_G.hom ≫ (ℓ • CategoryTheory.CategoryStruct.id (weilEtaleGmSheaf S)) := by
      rw [CategoryTheory.Preadditive.nsmul_comp, CategoryTheory.Preadditive.comp_nsmul,
        CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]
    have h_comm12 :
        cast_sh ≫ ι_kum r =
          ι_kum (r + 1) ≫ (ℓ • CategoryTheory.CategoryStruct.id (weilEtaleGmSheaf S)) := by
      dsimp [ι_kum]
      rw [← CategoryTheory.Category.assoc cast_sh, hCast_comm r,
        CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc (post_cast r),
        h_post_LG, CategoryTheory.Category.assoc, h_G_nsmul]
      simp only [CategoryTheory.Category.assoc]
    have h_comm23 :
        (ℓ • CategoryTheory.CategoryStruct.id (weilEtaleGmSheaf S)) ≫ p_kum r =
          p_kum (r + 1) ≫ CategoryTheory.CategoryStruct.id (weilEtaleGmSheaf S) := by
      dsimp [p_kum]
      rw [CategoryTheory.Category.comp_id, CategoryTheory.Preadditive.nsmul_comp,
        CategoryTheory.Category.id_comp, ← mul_nsmul', pow_succ']
    let φ_SC :
        CategoryTheory.ShortComplex.mk (ι_kum (r + 1)) (p_kum (r + 1)) (h0_kum (r + 1)) ⟶
          CategoryTheory.ShortComplex.mk (ι_kum r) (p_kum r) (h0_kum r) :=
      { τ₁ := cast_sh
        τ₂ := ℓ • CategoryTheory.CategoryStruct.id (weilEtaleGmSheaf S)
        τ₃ := CategoryTheory.CategoryStruct.id (weilEtaleGmSheaf S)
        comm₁₂ := h_comm12
        comm₂₃ := h_comm23 }
    have h_ext_nat :=
      CategoryTheory.ShortComplex.ShortExact.extClass_naturality (hEx_kum (r + 1)) (hEx_kum r) φ_SC
    change ((hEx_kum (r + 1)).extClass).comp (CategoryTheory.Abelian.Ext.mk₀ cast_sh)
        (Nat.add_zero 1) =
      (CategoryTheory.Abelian.Ext.mk₀
        (CategoryTheory.CategoryStruct.id (weilEtaleGmSheaf S))).comp
        (hEx_kum r).extClass (Nat.zero_add 1) at h_ext_nat
    rw [CategoryTheory.Abelian.Ext.mk₀_id_comp] at h_ext_nat
    change (ξ.comp (hEx_kum (r + 1)).extClass (Nat.one_add 1)).comp
        (CategoryTheory.Abelian.Ext.mk₀ cast_sh) (Nat.add_zero 2) =
      ξ.comp (hEx_kum r).extClass (Nat.one_add 1)
    rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero ξ (hEx_kum (r + 1)).extClass
        (CategoryTheory.Abelian.Ext.mk₀ cast_sh) (Nat.one_add 1),
      h_ext_nat]

theorem weil_p1_affine_compl_divisor_class_iso_and_origin_uniformizer (k : Type u) [Field k]
    (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsProper C.hom]
    (hIntC : AlgebraicGeometry.IsIntegral C.left)
    (ι_aff : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))) C.left)
    [AlgebraicGeometry.IsOpenImmersion ι_aff]
    (hComp_ι : CategoryTheory.CategoryStruct.comp ι_aff C.hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k)))
    (hInf_ex : ∃ s_inf : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) C.left,
      CategoryTheory.CategoryStruct.comp s_inf C.hom =
        CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)) ∧
      Disjoint (Set.range ι_aff.base) (Set.range s_inf.base) ∧
      Set.range ι_aff.base ∪ Set.range s_inf.base = Set.univ)
    (deg_Cl : @weilCurveClGroup C.left hIntC →+ ℤ)
    (hdeg_sum : ∀ D : ({ x : ↥C.left // IsClosed ({x} : Set ↥C.left) } →₀ ℤ),
      deg_Cl (QuotientAddGroup.mk' (@weilCurvePrincipalSubgroup C.left hIntC) D) =
        D.sum (fun _ n => n))
    (hDVR_stalk : ∀ x : { x : ↥C.left // IsClosed ({x} : Set ↥C.left) },
      ∃ hDom : IsDomain ↑(C.left.presheaf.stalk x.1),
        @IsDiscreteValuationRing ↑(C.left.presheaf.stalk x.1) _ hDom) :
    let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
    Function.Bijective deg_Cl ∧
    (∀ s : Quiver.Hom S_k C.left,
      CategoryTheory.CategoryStruct.comp s C.hom = CategoryTheory.CategoryStruct.id S_k →
      ∃ (pt₀ : ↥S_k) (hClosed : IsClosed ({s.base pt₀} : Set ↥C.left)),
        deg_Cl (QuotientAddGroup.mk' (@weilCurvePrincipalSubgroup C.left hIntC)
          (Finsupp.single ⟨s.base pt₀, hClosed⟩ 1)) = 1 ∧
        Function.Bijective (fun z : ℤ =>
          z • QuotientAddGroup.mk' (@weilCurvePrincipalSubgroup C.left hIntC)
            (Finsupp.single ⟨s.base pt₀, hClosed⟩ 1))) ∧
    (∃ (U₁ U₂ : C.left.Opens) (hcov : U₁ ⊔ U₂ = ⊤)
      (P_orig : ↥C.left) (hCl_orig : IsClosed ({P_orig} : Set ↥C.left)) (hP_mem : P_orig ∈ U₁)
      (g_sec : ↑(C.left.presheaf.obj (Opposite.op U₁)))
      (u₁₂ : Units ↑(C.left.presheaf.obj (Opposite.op (U₁ ⊓ U₂)))),
      (U₂ : Set ↥C.left) = ({P_orig} : Set ↥C.left)ᶜ ∧
      (C.left.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U₁ ⊓ U₂ ≤ U₁)).op).hom g_sec =
        (u₁₂ : ↑(C.left.presheaf.obj (Opposite.op (U₁ ⊓ U₂)))) ∧
      Ideal.span {(C.left.presheaf.germ U₁ P_orig hP_mem).hom g_sec} =
        IsLocalRing.maximalIdeal ↑(C.left.presheaf.stalk P_orig) ∧
      ∀ (ν : CategoryTheory.Iso C.left C.left),
        let U'₁ : C.left.Opens := (TopologicalSpace.Opens.map ν.hom.base).obj U₁
        let U'₂ : C.left.Opens := (TopologicalSpace.Opens.map ν.hom.base).obj U₂
        let P'_orig : ↥C.left := ν.inv.base P_orig
        let g'_sec : ↑(C.left.presheaf.obj (Opposite.op U'₁)) := (ν.hom.app U₁).hom g_sec
        let u'₁₂ : Units ↑(C.left.presheaf.obj (Opposite.op (U'₁ ⊓ U'₂))) :=
          Units.map ((C.left.presheaf.map (CategoryTheory.eqToHom
            (rfl : U'₁ ⊓ U'₂ = (TopologicalSpace.Opens.map ν.hom.base).obj (U₁ ⊓ U₂))).op).hom.comp
              (ν.hom.app (U₁ ⊓ U₂)).hom).toMonoidHom u₁₂
        ∃ (hcov' : U'₁ ⊔ U'₂ = ⊤)
          (hCl'_orig : IsClosed ({P'_orig} : Set ↥C.left))
          (hP'_mem : P'_orig ∈ U'₁),
          (U'₂ : Set ↥C.left) = ({P'_orig} : Set ↥C.left)ᶜ ∧
          (C.left.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U'₁ ⊓ U'₂ ≤ U'₁)).op).hom g'_sec =
            (u'₁₂ : ↑(C.left.presheaf.obj (Opposite.op (U'₁ ⊓ U'₂)))) ∧
          Ideal.span {(C.left.presheaf.germ U'₁ P'_orig hP'_mem).hom g'_sec} =
            IsLocalRing.maximalIdeal ↑(C.left.presheaf.stalk P'_orig)) :=
by
  classical
  haveI : AlgebraicGeometry.IsIntegral C.left := hIntC
  let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
  let A_1 := AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))
  let Pt := { x : ↥C.left // IsClosed ({x} : Set ↥C.left) }
  let pt₀ : ↥S_k := (⊥ : PrimeSpectrum k)
  have hSub_Sk : Subsingleton ↥S_k := by
    change Subsingleton (PrimeSpectrum k)
    infer_instance
  have hRange_sec : ∀ {Z : AlgebraicGeometry.Scheme.{u}} (s : S_k ⟶ Z),
      Set.range s.base = {s.base pt₀} := by
    intro Z s
    ext z
    simp only [Set.mem_range, Set.mem_singleton_iff]
    exact ⟨fun ⟨p, hp⟩ => by rw [← hp, hSub_Sk.elim p pt₀], fun hz => ⟨pt₀, hz.symm⟩⟩
  have hClosed_sec : ∀ (s : S_k ⟶ C.left),
      s ≫ C.hom = 𝟙 S_k → IsClosed ({s.base pt₀} : Set ↥C.left) := by
    intro s hs
    have hCI_comp : AlgebraicGeometry.IsClosedImmersion (s ≫ C.hom) := by
      rw [hs]
      infer_instance
    have hCI_s : AlgebraicGeometry.IsClosedImmersion s :=
      AlgebraicGeometry.IsClosedImmersion.of_comp s C.hom
    rw [← hRange_sec s]
    exact hCI_s.isClosedEmbedding.isClosed_range
  
  let U₁ : C.left.Opens := ι_aff.opensRange
  let e_aff : A_1 ≅ U₁.toScheme := ι_aff.isoOpensRange
  have he_aff_ι : e_aff.hom ≫ U₁.ι = ι_aff := ι_aff.isoOpensRange_hom_ι
  let φ_poly : CommRingCat.of (Polynomial k) ⟶ C.left.presheaf.obj (Opposite.op U₁) :=
    (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))).inv ≫
      e_aff.inv.appTop ≫ U₁.topIso.hom
  let φ_poly_inv : C.left.presheaf.obj (Opposite.op U₁) ⟶ CommRingCat.of (Polynomial k) :=
    U₁.topIso.inv ≫ e_aff.hom.appTop ≫
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))).hom
  have hφ_left_inv : φ_poly ≫ φ_poly_inv = 𝟙 (CommRingCat.of (Polynomial k)) := by
    dsimp only [φ_poly, φ_poly_inv]
    rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
      ← CategoryTheory.Category.assoc U₁.topIso.hom U₁.topIso.inv _,
