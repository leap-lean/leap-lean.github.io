      exact (CategoryTheory.Presieve.isSheafFor_arrows_iff_pullbacks 𝒢_type p_KE).mp h1
    have h𝒢_comp : ∀ {X Y Z : S_K.Etale} (f : X ⟶ Y) (g : Y ⟶ Z)
