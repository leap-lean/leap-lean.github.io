    have hδ_ker : ∀ p : Fin m × Fin m,
        ∃ j : I, ∃ hij : i_lift ≤ j, τ_C p.1 p.2 hij (δ p) = 0 := by
      intro p
      apply hκ_C_ker p.1 p.2 i_lift (δ p)
      dsimp only [δ]
      rw [map_sub, ← hκ_fst_nat, ← hκ_snd_nat, hx₁ p.1, hx₁ p.2, hy p.1 p.2, sub_self]
    let i_ab : Fin m × Fin m → I := fun p => Classical.choose (hδ_ker p)
    have hle_ab : ∀ p : Fin m × Fin m, i_lift ≤ i_ab p :=
      fun p => Classical.choose (Classical.choose_spec (hδ_ker p))
    have hkill_ab : ∀ p : Fin m × Fin m, τ_C p.1 p.2 (hle_ab p) (δ p) = 0 :=
      fun p => Classical.choose_spec (Classical.choose_spec (hδ_ker p))
    rcases hFinUpper (Finset.univ : Finset (Fin m × Fin m)) i_lift i_ab with
      ⟨i₂, hle_lift2, h_ab_all⟩
    have h_ab2 : ∀ a b : Fin m, i_ab (a, b) ≤ i₂ :=
      fun a b => h_ab_all (a, b) (Finset.mem_univ (a, b))
    let x₂ : ∀ a : Fin m, G_B a i₂ := fun a => τ_B a hle_lift2 (x₁ a)
    have hx₂_compat : ∀ a b : Fin m, res_fst a b i₂ (x₂ a) = res_snd a b i₂ (x₂ b) := by
      intro a b
      have h_eq_le : hle_lift2 = le_trans (hle_ab (a, b)) (h_ab2 a b) := rfl
      have h0 : τ_C a b hle_lift2 (δ (a, b)) = 0 := by
        rw [h_eq_le, ← hτ_C_comp a b (hle_ab (a, b)) (h_ab2 a b) (δ (a, b)),
