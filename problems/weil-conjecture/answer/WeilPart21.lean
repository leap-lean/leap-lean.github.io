        (CategoryTheory.Abelian.Ext.mk₀ δ_B) (Nat.add_zero 0) = 0 :=
      @Subsingleton.elim _ hSubR1_0 _ 0
    obtain ⟨b₀', hb₀'⟩ :=
      CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ Fℤ₀ hSE₂ c₀' hc₀'_δ
    have hb₀'_ext : CategoryTheory.Abelian.Ext.comp b₀' hSE₁.extClass (rfl : 0 + 1 = 1) = 0 :=
      @Subsingleton.elim _ hPush_Ws1_H1 _ 0
    obtain ⟨a₀', ha₀'⟩ :=
      CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ Fℤ₀ hSE₁ b₀' (rfl : 0 + 1 = 1) hb₀'_ext
    have ha₀'_p : CategoryTheory.Abelian.Ext.comp a₀'
        (CategoryTheory.Abelian.Ext.mk₀ (P_push.map (p_sh t)))
        (Nat.add_zero 0) = c₀' := by
      rw [← hfac, ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ π_B ι_B,
        ← CategoryTheory.Abelian.Ext.comp_assoc a₀' (CategoryTheory.Abelian.Ext.mk₀ π_B)
          (CategoryTheory.Abelian.Ext.mk₀ ι_B) (Nat.add_zero 0) (Nat.add_zero 0) (Nat.add_zero 0),
        ha₀', hb₀']
    have hc₀_lift : CategoryTheory.Abelian.Ext.comp (e₀ (I_sh t) a₀')
        (CategoryTheory.Abelian.Ext.mk₀ (p_sh t))
        (Nat.add_zero 0) = c₀ := by
      rw [← he₀_nat (p_sh t) a₀', ha₀'_p, AddEquiv.apply_symm_apply]
    rw [← hc₀, ← hc₀_lift,
      CategoryTheory.Abelian.Ext.comp_assoc (e₀ (I_sh t) a₀')
        (CategoryTheory.Abelian.Ext.mk₀ (p_sh t)) (hSE_W t).extClass
        (Nat.add_zero 0) (rfl : 0 + 1 = 1) (rfl : 0 + 0 + 1 = 1),
      (hSE_W t).comp_extClass, CategoryTheory.Abelian.Ext.comp_zero]

  have hUpLoop : ∀ m : ℕ, m ≤ s - 1 →
      Subsingleton ((W (s - 1 - m)).H (1 + m)) := by
    intro m
    induction m with
    | zero =>
      intro _
      simpa using hWs1_H1
    | succ m ih =>
      intro hm
      have hprev := ih (by omega)
      set t := s - 1 - (m + 1)
      have ht_succ : t + 1 = s - 1 - m := by omega
      have hSub_succ : Subsingleton ((W (t + 1)).H (1 + m)) := ht_succ.symm ▸ hprev
      have hStep := hSubExact₁_inj Fℤ_K (hSE_W t) (hInj_Ish t) (1 + m) hSub_succ
      have hdeg : (1 + m) + 1 = 1 + (m + 1) := by omega
      exact hdeg ▸ hStep

  have hFinal := hUpLoop (s - 1) le_rfl
  have h_idx₁ : s - 1 - (s - 1) = 0 := Nat.sub_self (s - 1)
  have h_idx₂ : 1 + (s - 1) = s := by omega
  rw [h_idx₁, h_idx₂, hW0] at hFinal
  exact hFinal

theorem weil_alt_cd_tsen_tate_field_vanishing (κ K : Type u) [Field κ] [IsSepClosed κ]
    [Field K] [Algebra κ K] (e ℓ s : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : κ) ≠ 0)
    (hTrdeg : Algebra.trdeg κ K ≤ (e : Cardinal.{u})) (hs : e < s)
    (G : CategoryTheory.Sheaf
      (AlgebraicGeometry.Spec (CommRingCat.of K)).smallEtaleTopology AddCommGrpCat.{u})
    (hℓ_G : ℓ • CategoryTheory.CategoryStruct.id G = 0) :
    Subsingleton (G.H s) :=
by
  have hPrime : Nat.Prime ℓ := Fact.out
  have hSheafTors : ∀ (S : AlgebraicGeometry.Scheme.{u}),
      ℓ • CategoryTheory.CategoryStruct.id (weilEtaleTorsionSheaf S ℓ) = 0 := by
    intro S
    have hZMod_tors : ℓ • CategoryTheory.CategoryStruct.id (AddCommGrpCat.of (ZMod ℓ)) = 0 := by
      ext x
      simp only [AddCommGrpCat.hom_nsmul, AddCommGrpCat.hom_id, AddCommGrpCat.hom_zero,
        AddMonoidHom.nsmul_apply, AddMonoidHom.id_apply, AddMonoidHom.zero_apply,
        nsmul_eq_mul, ZMod.natCast_self, zero_mul]
    have hUlift_tors : ℓ • CategoryTheory.CategoryStruct.id
        (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))) = 0 := by
      rw [← AddCommGrpCat.uliftFunctor.{u, 0}.map_id, ← CategoryTheory.Functor.map_nsmul,
        hZMod_tors, CategoryTheory.Functor.map_zero]
    let C_const := CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}
    change ℓ • CategoryTheory.CategoryStruct.id (C_const.obj _) = 0
    rw [← C_const.map_id, ← CategoryTheory.Functor.map_nsmul, hUlift_tors,
      CategoryTheory.Functor.map_zero]
  let P : ℕ → Prop := fun e₀ =>
    ∀ (κ₀ K₀ : Type u) [Field κ₀] [IsSepClosed κ₀] [Field K₀] [Algebra κ₀ K₀] (s₀ : ℕ),
      (ℓ : κ₀) ≠ 0 →
      Algebra.trdeg κ₀ K₀ ≤ (e₀ : Cardinal.{u}) →
      e₀ < s₀ →
      ∀ (G₀ : CategoryTheory.Sheaf
        (AlgebraicGeometry.Spec (CommRingCat.of K₀)).smallEtaleTopology AddCommGrpCat.{u}),
        ℓ • CategoryTheory.CategoryStruct.id G₀ = 0 →
        Subsingleton (G₀.H s₀)
  have hUpgrade : ∀ (e₀ : ℕ),
      (∀ (κ_alg F : Type u) [Field κ_alg] [IsAlgClosed κ_alg] [Field F] [Algebra κ_alg F]
        (s₀ : ℕ),
        (ℓ : κ_alg) ≠ 0 →
        (∃ S : Finset F, IntermediateField.adjoin κ_alg (S : Set F) = ⊤) →
        Algebra.trdeg κ_alg F ≤ (e₀ : Cardinal.{u}) →
        e₀ < s₀ →
        Subsingleton (weilEtaleTorsionH (AlgebraicGeometry.Spec (CommRingCat.of F)) ℓ s₀)) →
      P e₀ := by
    intro e₀ hFG_alg κ₀ K₀ _ _ _ _ s₀ hℓ₀ hTr₀ hs₀ G₀ hℓ_G₀
    refine weil_alt_cd_field_sheaf_to_constant_torsion.2 K₀ ℓ s₀ (by omega) ?_ G₀ hℓ_G₀
    intro K₁ _ _ _ _
    let _ : Algebra κ₀ K₁ := RingHom.toAlgebra ((algebraMap K₀ K₁).comp (algebraMap κ₀ K₀))
    have : IsScalarTower κ₀ K₀ K₁ := IsScalarTower.of_algebraMap_eq' rfl
    have hTrK₁ : Algebra.trdeg κ₀ K₁ ≤ (e₀ : Cardinal.{u}) := by
      rw [← _root_.trdeg_add_eq κ₀ K₀ (A := K₁), @_root_.trdeg_eq_zero K₀ K₁, add_zero]
      exact hTr₀
    exact weil_alt_cd_insep_upgrade_and_subfield_colimit.2 e₀ ℓ s₀
      (fun κ_alg F _ _ _ _ hℓ_alg hFG hTr => hFG_alg κ_alg F s₀ hℓ_alg hFG hTr hs₀)
      κ₀ K₁ hℓ₀ hTrK₁
  have hP0 : P 0 := by
    refine hUpgrade 0 ?_
    intro κ_alg F _ _ _ _ s₀ _ _ hTr hs₀
    have hTrZero : Algebra.trdeg κ_alg F = 0 := by
      simpa using hTr
    have : Algebra.IsAlgebraic κ_alg F := (_root_.trdeg_eq_zero_iff).mp hTrZero
    have : Algebra.IsIntegral κ_alg F := Algebra.IsAlgebraic.isIntegral
    have hBij : Function.Bijective (algebraMap κ_alg F) :=
      IsAlgClosed.algebraMap_bijective_of_isIntegral
    have : IsAlgClosed F :=
      IsAlgClosed.of_ringEquiv κ_alg F (RingEquiv.ofBijective (algebraMap κ_alg F) hBij)
    exact weil_alt_cd_field_sheaf_to_constant_torsion.1 F s₀ (by omega)
      (weilEtaleTorsionSheaf (AlgebraicGeometry.Spec (CommRingCat.of F)) ℓ)
  have hP1 : P 1 := by
    refine hUpgrade 1 ?_
    intro κ_alg F _ _ _ _ s₀ hℓ_alg hFG hTr hs₀
    have hRoots : ∃ ζ : F, ζ ^ ℓ = 1 ∧ ζ ≠ 1 := by
      let Φ : Polynomial κ_alg := ∑ i ∈ Finset.range ℓ, Polynomial.X ^ i
      have hCoeff : Φ.coeff (ℓ - 1) = 1 := by
        simp only [Φ, Polynomial.finsetSum_coeff, Polynomial.coeff_X_pow]
        rw [Finset.sum_eq_single (ℓ - 1)]
        · simp
        · intro b _ hb
          simp [hb.symm]
        · intro hmem
          exact absurd (Finset.mem_range.mpr (Nat.sub_lt hPrime.pos Nat.one_pos)) hmem
      have hNatDeg : 1 ≤ Φ.natDegree := by
        have hle : ℓ - 1 ≤ Φ.natDegree := by
          apply Polynomial.le_natDegree_of_ne_zero
          rw [hCoeff]
          exact one_ne_zero
        have h2 : 2 ≤ ℓ := hPrime.two_le
        omega
      have hDegNe : Φ.degree ≠ 0 :=
        Polynomial.degree_ne_of_natDegree_ne (n := 0) (by omega)
      obtain ⟨ζ₀, hζ₀⟩ := IsAlgClosed.exists_root Φ hDegNe
      have hSum : ∑ i ∈ Finset.range ℓ, ζ₀ ^ i = 0 := by
        simpa [Φ, Polynomial.IsRoot, Polynomial.eval_finsetSum] using hζ₀
      have hMul := geom_sum_mul ζ₀ ℓ
      rw [hSum, zero_mul] at hMul
      have hPow : ζ₀ ^ ℓ = 1 := sub_eq_zero.mp hMul.symm
      have hNe1 : ζ₀ ≠ 1 := by
        rintro rfl
        simp only [one_pow, Finset.sum_const, Finset.card_range, nsmul_eq_mul, mul_one] at hSum
        exact hℓ_alg hSum
      refine ⟨algebraMap κ_alg F ζ₀, ?_, ?_⟩
      · rw [← map_pow, hPow, map_one]
      · intro h1
        exact hNe1 ((algebraMap κ_alg F).injective (h1.trans (map_one _).symm))
    have hNormSurj : ∀ (E₁ E₂ : Type u) [Field E₁] [Algebra F E₁] [FiniteDimensional F E₁]
        [Field E₂] [Algebra E₁ E₂] [FiniteDimensional E₁ E₂] (c : E₁),
        ∃ y : E₂, Algebra.norm E₁ y = c := by
      intro E₁ E₂ _ _ _ _ _ _ c
      let _ : Algebra κ_alg E₁ := RingHom.toAlgebra ((algebraMap F E₁).comp (algebraMap κ_alg F))
      have : IsScalarTower κ_alg F E₁ := IsScalarTower.of_algebraMap_eq' rfl
      obtain ⟨S, hS⟩ := hFG
      let _ : DecidableEq E₁ := Classical.decEq E₁
      let b := Module.finBasis F E₁
      let S₁ : Finset E₁ := S.image (algebraMap F E₁) ∪ Finset.univ.image b
      have hFG₁ : ∃ S' : Finset E₁, IntermediateField.adjoin κ_alg (S' : Set E₁) = ⊤ := by
        refine ⟨S₁, ?_⟩
        set L₁ := IntermediateField.adjoin κ_alg (S₁ : Set E₁)
        have hSub : (S₁ : Set E₁) ⊆ (L₁ : Set E₁) :=
          IntermediateField.subset_adjoin κ_alg (S₁ : Set E₁)
        have hComap : IntermediateField.adjoin κ_alg (S : Set F) ≤
            L₁.comap (IsScalarTower.toAlgHom κ_alg F E₁) := by
          rw [IntermediateField.adjoin_le_iff]
          intro x hx
          exact hSub (Finset.mem_coe.mpr (Finset.mem_union_left _ (Finset.mem_image_of_mem _ hx)))
        rw [hS, top_le_iff] at hComap
        rw [eq_top_iff]
        intro y _
        rw [← b.sum_repr y]
        refine L₁.sum_mem fun i _ => ?_
        rw [Algebra.smul_def]
        refine L₁.mul_mem ?_ ?_
        · have hy : b.repr y i ∈ (⊤ : IntermediateField κ_alg F) := IntermediateField.mem_top
          rw [← hComap] at hy
          exact hy
        · exact hSub (Finset.mem_coe.mpr
            (Finset.mem_union_right _ (Finset.mem_image_of_mem _ (Finset.mem_univ i))))
      have hTr₁ : Algebra.trdeg κ_alg E₁ ≤ 1 := by
        rw [← _root_.trdeg_add_eq κ_alg F (A := E₁), @_root_.trdeg_eq_zero F E₁, add_zero]
        simpa using hTr
      exact weil_alt_cd_c1_tsen_norm_surjective κ_alg E₁ E₂ hFG₁ hTr₁ c
    exact weil_alt_cd_c1_kummer_gm_torsion_vanishing F ℓ s₀ (by omega) hRoots hNormSurj
  have hAll : ∀ e₀ : ℕ, P e₀ := by
    intro e₀
    induction e₀ with
    | zero => exact hP0
    | succ e₀ ih =>
      refine hUpgrade (e₀ + 1) ?_
      intro κ_alg F _ _ _ _ s₀ hℓ_alg hFG hTr hs₀
      have hlt : Algebra.trdeg κ_alg F < Cardinal.aleph0 :=
        lt_of_le_of_lt hTr (Cardinal.lt_aleph0.mpr ⟨e₀ + 1, rfl⟩)
      obtain ⟨n, hn⟩ := Cardinal.lt_aleph0.mp hlt
      have hn_le : n ≤ e₀ + 1 := Nat.cast_le.mp (hn ▸ hTr)
      rcases Nat.of_le_succ hn_le with hn_le' | rfl
      · have hTr_le : Algebra.trdeg κ_alg F ≤ (e₀ : Cardinal.{u}) :=
          hn ▸ Nat.cast_le.mpr hn_le'
        exact ih κ_alg F s₀ hℓ_alg hTr_le (by omega)
          (weilEtaleTorsionSheaf (AlgebraicGeometry.Spec (CommRingCat.of F)) ℓ)
          (hSheafTors (AlgebraicGeometry.Spec (CommRingCat.of F)))
      · exact weil_alt_cd_trdeg_step_fibration_syzygy κ_alg F e₀ ℓ s₀ hℓ_alg hs₀ hFG hn
          (fun L _ 𝒟 hne hdir hex q E₀ hE₀ hSub ξ =>
            weil_alt_cd_insep_upgrade_and_subfield_colimit.1 L 𝒟 hne hdir hex ℓ q E₀ hE₀ hSub ξ)
          (fun K₀ _ _ hTrK₀ r hr ℋ hℓ_ℋ => ih κ_alg K₀ r hℓ_alg hTrK₀ hr ℋ hℓ_ℋ)
          (fun κ₁ L _ _ _ _ hℓ₁ hTrL q hq =>
            hP1 κ₁ L q hℓ₁ (by simpa using hTrL) (by omega)
              (weilEtaleTorsionSheaf (AlgebraicGeometry.Spec (CommRingCat.of L)) ℓ)
              (hSheafTors (AlgebraicGeometry.Spec (CommRingCat.of L))))
  exact hAll e κ K s hℓ hTrdeg hs G hℓ_G

theorem weil_alt_cd_noether_trdeg_and_artin_local_chart (k : Type u) [Field k] (m : ℕ)
    (V : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.LocallyOfFiniteType V.hom] [AlgebraicGeometry.IsIntegral V.left]
    (hDimV : topologicalKrullDim V.left = (m : WithBot ℕ∞)) :
    let η : ↥V.left := genericPoint ↥V.left
    let K : Type u := ↥(V.left.presheaf.stalk η)
    (∃ (i_k : k →+* K),
      letI : Algebra k K := i_k.toAlgebra
      Algebra.trdeg k K ≤ (m : Cardinal.{u})) ∧
    (∀ x : ↥V.left,
      ∃ (c : ℕ) (W₀ : V.left.Opens) (_ : AlgebraicGeometry.IsAffineOpen W₀) (hx : x ∈ W₀)
        (hη : η ∈ W₀)
        (ψ : MvPolynomial (Fin c) k →+* ↥(V.left.presheaf.obj (Opposite.op W₀)))
        (i_K : FractionRing (MvPolynomial (Fin c) k) →+* K),
        topologicalKrullDim ↥(closure ({x} : Set ↥V.left)) = (c : WithBot ℕ∞) ∧
        c ≤ m ∧
        (∀ h : MvPolynomial (Fin c) k, h ≠ 0 →
          (V.left.evaluation W₀ x hx).hom (ψ h) ≠ 0) ∧
        (∀ h : MvPolynomial (Fin c) k,
          i_K (algebraMap (MvPolynomial (Fin c) k) (FractionRing (MvPolynomial (Fin c) k)) h) =
            (V.left.presheaf.germ W₀ η hη).hom (ψ h)) ∧
        (letI : Algebra (FractionRing (MvPolynomial (Fin c) k)) K := i_K.toAlgebra
         (⊤ : IntermediateField (FractionRing (MvPolynomial (Fin c) k)) K).FG ∧
         Algebra.trdeg (FractionRing (MvPolynomial (Fin c) k)) K ≤ ((m - c : ℕ) : Cardinal.{u}))) :=
by
  intro η K

  
  have hOpenDim : ∀ (T : Type u) [TopologicalSpace T] [Nonempty T] (d : ℕ),
      (∀ t : T, ∃ U : TopologicalSpace.Opens T,
        t ∈ U ∧ topologicalKrullDim ↥U = (d : WithBot ℕ∞)) →
      topologicalKrullDim T = (d : WithBot ℕ∞) := by
    intro T _ hNeT d hcov
    obtain ⟨t₀⟩ := hNeT
    obtain ⟨U₀, _, hU₀⟩ := hcov t₀
    have hle_low : (d : WithBot ℕ∞) ≤ topologicalKrullDim T := by
      rw [← hU₀]
      exact topologicalKrullDim_subspace_le T (U₀ : Set T)
    have : Nonempty (TopologicalSpace.IrreducibleCloseds T) :=
      ⟨⟨closure {t₀}, isIrreducible_singleton.closure, isClosed_closure⟩⟩
    have hle_up : topologicalKrullDim T ≤ (d : WithBot ℕ∞) := by
      change Order.krullDim (TopologicalSpace.IrreducibleCloseds T) ≤ ((d : ℕ∞) : WithBot ℕ∞)
      rw [Order.krullDim_eq_iSup_length]
      refine WithBot.coe_le_coe.mpr (iSup_le fun l => ?_)
      obtain ⟨t, ht₀⟩ := (l 0).isIrreducible.nonempty
      obtain ⟨U, htU, hU⟩ := hcov t
      let F : Fin (l.length + 1) → TopologicalSpace.IrreducibleCloseds ↥U := fun i =>
        { carrier := (Subtype.val : ↥U → T) ⁻¹' (l i : Set T)
          isIrreducible' :=
            ⟨⟨⟨t, htU⟩, l.strictMono.monotone (Fin.zero_le i) ht₀⟩,
              (l i).isIrreducible.isPreirreducible.preimage U.isOpen.isOpenEmbedding_subtypeVal⟩
          isClosed' := (l i).isClosed.preimage continuous_subtype_val }
      let l_U : LTSeries (TopologicalSpace.IrreducibleCloseds ↥U) :=
        { length := l.length
          toFun := F
          step := fun j => by
            have hstep : l (Fin.castSucc j) < l j.succ := l.strictMono Fin.castSucc_lt_succ
            have hmono : F (Fin.castSucc j) ≤ F j.succ := fun z hz => le_of_lt hstep hz
            refine lt_of_le_not_ge hmono (fun hge => ?_)
            have hsub : (l j.succ : Set T) ⊆ (l (Fin.castSucc j) : Set T) ∪ (U : Set T)ᶜ := by
              intro y hy
              by_cases hyU : y ∈ U
              · exact Or.inl (hge (show (⟨y, hyU⟩ : ↥U) ∈ F j.succ from hy))
              · exact Or.inr hyU
            rcases (isPreirreducible_iff_isClosed_union_isClosed.mp
                (l j.succ).isIrreducible.isPreirreducible)
              (l (Fin.castSucc j) : Set T) (U : Set T)ᶜ
              (l (Fin.castSucc j)).isClosed U.isOpen.isClosed_compl hsub with h1 | h2
            · exact not_le_of_gt hstep h1
            · exact h2 (l.strictMono.monotone (Fin.zero_le j.succ) ht₀) htU }
      have hlen_le : ((l_U.length : ℕ∞) : WithBot ℕ∞) ≤ topologicalKrullDim ↥U :=
        Order.LTSeries.length_le_krullDim l_U
      rw [hU] at hlen_le
      exact WithBot.coe_le_coe.mp hlen_le
    exact le_antisymm hle_up hle_low

  
  have hSliceDim : ∀ (X : Type u) [TopologicalSpace X] (x : X) (W : TopologicalSpace.Opens X)
      (hx : x ∈ W) (B : Type u) [CommRing B] (e : ↥W ≃ₜ PrimeSpectrum B),
      let C_x : Set X := closure ({x} : Set X)
      let U_W : TopologicalSpace.Opens ↥C_x :=
        ⟨{ z : ↥C_x | z.1 ∈ W }, W.isOpen.preimage continuous_subtype_val⟩
      topologicalKrullDim ↥U_W = ringKrullDim (B ⧸ (e ⟨x, hx⟩).asIdeal) := by
    intro X _ x W hx B _ e C_x U_W
    let xW : ↥W := ⟨x, hx⟩
    let S_W : Set ↥W := closure ({xW} : Set ↥W)
    have hmem_SW : ∀ w : ↥W, w ∈ S_W ↔ w.1 ∈ C_x := by
      intro w
      dsimp [S_W, C_x]
      rw [closure_subtype, Set.image_singleton]
    let h₁ : ↥U_W ≃ₜ ↥S_W :=
      { toFun := fun z => ⟨⟨z.1.1, z.2⟩, (hmem_SW ⟨z.1.1, z.2⟩).mpr z.1.2⟩
        invFun := fun w => ⟨⟨w.1.1, (hmem_SW w.1).mp w.2⟩, w.1.2⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl
        continuous_toFun :=
          Continuous.subtype_mk
            (Continuous.subtype_mk (continuous_subtype_val.comp continuous_subtype_val) _) _
        continuous_invFun :=
          Continuous.subtype_mk
            (Continuous.subtype_mk (continuous_subtype_val.comp continuous_subtype_val) _) _ }
    let p : PrimeSpectrum B := e xW
    have himg_SW : ⇑e '' S_W = PrimeSpectrum.zeroLocus (p.asIdeal : Set B) := by
      dsimp [S_W, p]
      rw [e.image_closure, Set.image_singleton, PrimeSpectrum.closure_singleton]
    let h₂ : ↥S_W ≃ₜ ↥(PrimeSpectrum.zeroLocus (p.asIdeal : Set B)) :=
      (e.image S_W).trans (Homeomorph.setCongr himg_SW)
    let π : B →+* B ⧸ p.asIdeal := Ideal.Quotient.mk p.asIdeal
    have hemb : Topology.IsEmbedding (PrimeSpectrum.comap π) :=
      PrimeSpectrum.isEmbedding_comap_of_surjective (B ⧸ p.asIdeal) π Ideal.Quotient.mk_surjective
    have hrng : Set.range (PrimeSpectrum.comap π) = PrimeSpectrum.zeroLocus (p.asIdeal : Set B) := by
      rw [range_comap_of_surjective (B ⧸ p.asIdeal) π Ideal.Quotient.mk_surjective, Ideal.mk_ker]
    let h₃ : PrimeSpectrum (B ⧸ p.asIdeal) ≃ₜ ↥(PrimeSpectrum.zeroLocus (p.asIdeal : Set B)) :=
      hemb.toHomeomorph.trans (Homeomorph.setCongr hrng)
    let h_tot : ↥U_W ≃ₜ PrimeSpectrum (B ⧸ p.asIdeal) := (h₁.trans h₂).trans h₃.symm
    rw [IsHomeomorph.topologicalKrullDim_eq h_tot h_tot.isHomeomorph,
      PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim]

  
  have hNoethCore : ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra k A] [Algebra.FiniteType k A],
      ∃ (d : ℕ) (g : MvPolynomial (Fin d) k →ₐ[k] A),
        Function.Injective g ∧
        ringKrullDim A = (d : WithBot ℕ∞) ∧
        Algebra.trdeg k A = (d : Cardinal.{u}) := by
    intro A _ _ _ _
    obtain ⟨d, g, hg_inj, hg_int⟩ := exists_integral_inj_algHom_of_fg k A
    let P_d : Type u := MvPolynomial (Fin d) k
    letI : Algebra P_d A := g.toRingHom.toAlgebra
    haveI : Algebra.IsIntegral P_d A := algebraMap_isIntegral_iff.mp hg_int
    haveI : IsScalarTower k P_d A := IsScalarTower.of_algebraMap_eq' g.comp_algebraMap.symm
    haveI : FaithfulSMul k P_d :=
      (faithfulSMul_iff_algebraMap_injective k P_d).mpr (RingHom.injective (algebraMap k P_d))
    haveI : FaithfulSMul P_d A :=
      (faithfulSMul_iff_algebraMap_injective P_d A).mpr hg_inj
    haveI : Algebra.IsAlgebraic P_d A := Algebra.IsIntegral.isAlgebraic
    have hTr_A : Algebra.trdeg k A = (d : Cardinal.{u}) := by
      have h_add := trdeg_add_eq k P_d (A := A)
      rw [@trdeg_eq_zero P_d A, add_zero, MvPolynomial.trdeg_of_isDomain,
        Cardinal.mk_fin, Cardinal.lift_natCast] at h_add
      exact h_add.symm
    have hDim_Pd : ringKrullDim P_d = (d : WithBot ℕ∞) := by
      change ringKrullDim (MvPolynomial (Fin d) k) = ((d : ℕ∞) : WithBot ℕ∞)
      rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field k,
        zero_add, ENat.card_eq_coe_fintype_card, Fintype.card_fin]
    have hDim_up : ringKrullDim A ≤ (d : WithBot ℕ∞) := by
      rw [← hDim_Pd]
      refine Order.krullDim_le_of_strictMono (PrimeSpectrum.comap (algebraMap P_d A)) ?_
      intro Q₁ Q₂ hlt
      obtain ⟨a, ha⟩ := Set.exists_of_ssubset (show (Q₁.asIdeal : Set A) ⊂ Q₂.asIdeal from hlt)
      haveI : Q₁.asIdeal.IsPrime := Q₁.isPrime
      exact Ideal.under_lt_under_of_integral_mem_sdiff (le_of_lt hlt) ha
        (Algebra.IsIntegral.isIntegral a)
    have hDim_low : (d : WithBot ℕ∞) ≤ ringKrullDim A := by
      have hPd_ge : (d : WithBot ℕ∞) ≤ ringKrullDim P_d := le_of_eq hDim_Pd.symm
      obtain ⟨l, hl_len⟩ := Order.le_krullDim_iff.mp hPd_ge
      have hLift : ∀ (n : ℕ) (hn : n ≤ d),
          ∃ (L : LTSeries (PrimeSpectrum A)),
            L.length = n ∧
            Ideal.under P_d L.last.asIdeal = (l ⟨n, by omega⟩).asIdeal := by
        intro n
        induction n with
        | zero =>
          intro hn
          let q₀ : PrimeSpectrum P_d := l ⟨0, Nat.zero_lt_succ l.length⟩
          have hker_le : RingHom.ker (algebraMap P_d A) ≤ q₀.asIdeal := by
            intro x hx
            have hx0 : g x = 0 := hx
            have hx_zero : x = 0 := hg_inj (hx0.trans (map_zero g).symm)
            rw [hx_zero]
            exact Ideal.zero_mem _
          haveI : q₀.asIdeal.IsPrime := q₀.isPrime
          have hex₀ := Ideal.exists_ideal_over_prime_of_isIntegral_of_isDomain
            (S := A) q₀.asIdeal hker_le
          rcases hex₀ with ⟨Q₀, hQ₀_prime, hQ₀_under⟩
          refine ⟨RelSeries.singleton _ (⟨Q₀, hQ₀_prime⟩ : PrimeSpectrum A), ?_, ?_⟩
          · exact RelSeries.singleton_length _ _
          · rw [RelSeries.last_singleton]
            exact hQ₀_under
        | succ n ih =>
          intro hn
          obtain ⟨L, hL_len, hL_under⟩ := ih (Nat.le_of_succ_le hn)
          have hn0 : n < l.length + 1 := by omega
          have hn1 : n + 1 < l.length + 1 := by omega
          let q_n : PrimeSpectrum P_d := l ⟨n, hn0⟩
          let q_succ : PrimeSpectrum P_d := l ⟨n + 1, hn1⟩
          have hlt_l : q_n < q_succ :=
            l.strictMono (Fin.mk_lt_mk.mpr (Nat.lt_succ_self n))
          have hle_under : Ideal.under P_d L.last.asIdeal ≤ q_succ.asIdeal :=
            hL_under.trans_le (le_of_lt hlt_l)
          haveI : L.last.asIdeal.IsPrime := L.last.isPrime
          haveI : q_succ.asIdeal.IsPrime := q_succ.isPrime
          have hex_succ := Ideal.exists_ideal_over_prime_of_isIntegral_of_isPrime
            q_succ.asIdeal L.last.asIdeal hle_under
          rcases hex_succ with ⟨Q', hQ'_ge, hQ'_prime, hQ'_under⟩
          let P' : PrimeSpectrum A := ⟨Q', hQ'_prime⟩
          have hlt_P : L.last < P' := by
            refine lt_of_le_not_ge hQ'_ge (fun hle => ?_)
            have heq_Q : L.last.asIdeal = Q' := le_antisymm hQ'_ge hle
            have heq_l : q_n.asIdeal = q_succ.asIdeal := by
              change (l ⟨n, hn0⟩).asIdeal = q_succ.asIdeal
              rw [← hL_under, heq_Q, hQ'_under]
            exact ne_of_lt hlt_l (PrimeSpectrum.ext heq_l)
          refine ⟨L.snoc P' hlt_P, ?_, ?_⟩
          · rw [RelSeries.snoc_length, hL_len]
          · rw [RelSeries.last_snoc]
            exact hQ'_under
      obtain ⟨L, hL_len, _⟩ := hLift d le_rfl
      exact Order.le_krullDim_iff.mpr ⟨L, hL_len⟩
    exact ⟨d, g, hg_inj, le_antisymm hDim_up hDim_low, hTr_A⟩

  have hNoethDim : ∀ (A F : Type u) [CommRing A] [IsDomain A] [Algebra k A] [Algebra.FiniteType k A]
      [Field F] [Algebra k F] [Algebra A F] [IsScalarTower k A F] [IsFractionRing A F],
      ∃ d : ℕ, ringKrullDim A = (d : WithBot ℕ∞) ∧ Algebra.trdeg k F = (d : Cardinal.{u}) := by
    intro A F _ _ _ _ _ _ _ _ _
    obtain ⟨d, _, _, hDimA, hTrA⟩ := hNoethCore A
    haveI : FaithfulSMul k A :=
      (faithfulSMul_iff_algebraMap_injective k A).mpr (RingHom.injective (algebraMap k A))
    haveI : FaithfulSMul A F :=
      (faithfulSMul_iff_algebraMap_injective A F).mpr (IsFractionRing.injective A F)
    haveI : Algebra.IsAlgebraic A F := IsLocalization.isAlgebraic F (nonZeroDivisors A)
    have hTrF : Algebra.trdeg k F = (d : Cardinal.{u}) := by
      have h_add := trdeg_add_eq k A (A := F)
      rw [@trdeg_eq_zero A F, add_zero, hTrA] at h_add
      exact h_add.symm
    exact ⟨d, hDimA, hTrF⟩

  
  have hNoethLift : ∀ (B K₀ : Type u) [CommRing B] [IsDomain B] [Algebra k B] [Algebra.FiniteType k B]
      [Field K₀] [Algebra k K₀] [Algebra B K₀] [IsScalarTower k B K₀] [IsFractionRing B K₀]
      (c : ℕ) (p : Ideal B) [p.IsPrime],
      Algebra.trdeg k K₀ = (m : Cardinal.{u}) →
      ringKrullDim (B ⧸ p) = (c : WithBot ℕ∞) →
      c ≤ m →
      ∃ (ψ : MvPolynomial (Fin c) k →ₐ[k] B)
        (i_K : FractionRing (MvPolynomial (Fin c) k) →+* K₀),
        (∀ h : MvPolynomial (Fin c) k, h ≠ 0 → ψ h ∉ p) ∧
        (∀ h : MvPolynomial (Fin c) k,
          i_K (algebraMap (MvPolynomial (Fin c) k) (FractionRing (MvPolynomial (Fin c) k)) h) =
            algebraMap B K₀ (ψ h)) ∧
        (letI : Algebra (FractionRing (MvPolynomial (Fin c) k)) K₀ := i_K.toAlgebra
         (⊤ : IntermediateField (FractionRing (MvPolynomial (Fin c) k)) K₀).FG ∧
         Algebra.trdeg (FractionRing (MvPolynomial (Fin c) k)) K₀ ≤ ((m - c : ℕ) : Cardinal.{u})) := by
    intro B K₀ _ _ _ _ _ _ _ _ _ c p _ hTrK hDimBp hc_le_m
    haveI : Algebra.FiniteType k (B ⧸ p) :=
      Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ k p) Ideal.Quotient.mk_surjective
    obtain ⟨d_bar, g_bar, hg_bar_inj, hDim_d, _⟩ := hNoethCore (B ⧸ p)
    have hd_eq : d_bar = c := by
      have heq_wb : (d_bar : WithBot ℕ∞) = (c : WithBot ℕ∞) := hDim_d.symm.trans hDimBp
      exact Nat.cast_inj.mp (WithBot.coe_inj.mp heq_wb)
    subst hd_eq
    let P : Type u := MvPolynomial (Fin d_bar) k
    let y : Fin d_bar → B := fun i =>
      Classical.choose (Ideal.Quotient.mk_surjective (g_bar (MvPolynomial.X i)))
    have hy : ∀ i : Fin d_bar, Ideal.Quotient.mk p (y i) = g_bar (MvPolynomial.X i) :=
      fun i => Classical.choose_spec (Ideal.Quotient.mk_surjective (g_bar (MvPolynomial.X i)))
    let ψ : P →ₐ[k] B := MvPolynomial.aeval y
    have hψ_comp : (Ideal.Quotient.mkₐ k p).comp ψ = g_bar := by
      apply MvPolynomial.algHom_ext
      intro i
      change Ideal.Quotient.mk p (MvPolynomial.aeval y (MvPolynomial.X i)) = g_bar (MvPolynomial.X i)
      rw [MvPolynomial.aeval_X, hy]
    have hψ_avoid : ∀ h : P, h ≠ 0 → ψ h ∉ p := by
      intro h hh hmem
      have hzero_bar : g_bar h = 0 := by
        rw [← hψ_comp]
        exact Ideal.Quotient.eq_zero_iff_mem.mpr hmem
      exact hh (hg_bar_inj (hzero_bar.trans (map_zero g_bar).symm))
    have hψ_inj : Function.Injective ψ.toRingHom := by
      rw [injective_iff_map_eq_zero]
      intro h hh0
      by_contra hh_ne
      exact hψ_avoid h hh_ne (hh0.symm ▸ p.zero_mem)
    let θ : P →+* K₀ := (algebraMap B K₀).comp ψ.toRingHom
    have hθ_inj : Function.Injective θ := (IsFractionRing.injective B K₀).comp hψ_inj
    let F₀ : Type u := FractionRing P
    let i_K : F₀ →+* K₀ := IsFractionRing.lift hθ_inj
    have hi_K : ∀ h : P, i_K (algebraMap P F₀ h) = algebraMap B K₀ (ψ h) :=
      fun h => IsFractionRing.lift_algebraMap hθ_inj h
    refine ⟨ψ, i_K, hψ_avoid, hi_K, ?_⟩
    letI : Algebra F₀ K₀ := i_K.toAlgebra
    haveI : IsScalarTower k F₀ K₀ := IsScalarTower.of_algebraMap_eq (fun a => by
      change algebraMap k K₀ a = i_K (algebraMap k F₀ a)
      rw [IsScalarTower.algebraMap_apply k P F₀, hi_K, ψ.commutes,
        ← IsScalarTower.algebraMap_apply k B K₀])
    constructor
    · 
      obtain ⟨S_B, hSB_top⟩ := Algebra.FiniteType.out (R := k) (A := B)
      classical
      let T_K : Finset K₀ := S_B.image (algebraMap B K₀)
      let L : IntermediateField F₀ K₀ := IntermediateField.adjoin F₀ (T_K : Set K₀)
      let L_sub : Subalgebra k K₀ := L.toSubalgebra.restrictScalars k
      let f_BK : B →ₐ[k] K₀ := IsScalarTower.toAlgHom k B K₀
      have hSB_le : (S_B : Set B) ⊆ (L_sub.comap f_BK : Set B) := by
        intro b hb
        have hmem_TK : algebraMap B K₀ b ∈ (T_K : Set K₀) :=
          Finset.mem_coe.mpr (Finset.mem_image_of_mem _ hb)
        exact IntermediateField.subset_adjoin F₀ (T_K : Set K₀) hmem_TK
      have hB_in_L : ∀ b : B, algebraMap B K₀ b ∈ L := by
        intro b
        have htop_mem : b ∈ (⊤ : Subalgebra k B) := Algebra.mem_top
        rw [← hSB_top] at htop_mem
        exact (Algebra.adjoin_le hSB_le) htop_mem
      have hL_top : L = ⊤ := by
        ext z
        refine ⟨fun _ => trivial, fun _ => ?_⟩
        obtain ⟨a, b, _, hdiv⟩ := IsFractionRing.div_surjective B z
        rw [← hdiv]
        exact L.div_mem (hB_in_L a) (hB_in_L b)
      rw [← hL_top]
      exact IntermediateField.fg_adjoin_finset T_K
    · 
      haveI : FaithfulSMul k P :=
        (faithfulSMul_iff_algebraMap_injective k P).mpr (RingHom.injective (algebraMap k P))
      haveI : FaithfulSMul P F₀ :=
        (faithfulSMul_iff_algebraMap_injective P F₀).mpr (IsFractionRing.injective P F₀)
      haveI : Algebra.IsAlgebraic P F₀ := IsLocalization.isAlgebraic F₀ (nonZeroDivisors P)
      have hTr_F0 : Algebra.trdeg k F₀ = (d_bar : Cardinal.{u}) := by
        have h_add := trdeg_add_eq k P (A := F₀)
        rw [@trdeg_eq_zero P F₀, add_zero, MvPolynomial.trdeg_of_isDomain,
          Cardinal.mk_fin, Cardinal.lift_natCast] at h_add
        exact h_add.symm
      haveI : FaithfulSMul k F₀ :=
        (faithfulSMul_iff_algebraMap_injective k F₀).mpr (RingHom.injective (algebraMap k F₀))
      haveI : FaithfulSMul F₀ K₀ :=
        (faithfulSMul_iff_algebraMap_injective F₀ K₀).mpr (RingHom.injective (algebraMap F₀ K₀))
      have h_add_K := trdeg_add_eq k F₀ (A := K₀)
      rw [hTr_F0, hTrK] at h_add_K
      have hlt_aleph : Algebra.trdeg F₀ K₀ < Cardinal.aleph0 :=
        lt_of_le_of_lt (le_add_self.trans_eq h_add_K) (Cardinal.lt_aleph0.mpr ⟨m, rfl⟩)
      obtain ⟨t, ht⟩ := Cardinal.lt_aleph0.mp hlt_aleph
      rw [ht] at h_add_K ⊢
      have hct_eq : d_bar + t = m := by
        have hcast : ((d_bar + t : ℕ) : Cardinal.{u}) = (m : Cardinal.{u}) := by
          push_cast
          exact h_add_K
        exact Nat.cast_injective hcast
      have ht_eq : t = m - d_bar := by omega
      rw [ht_eq]

  
  let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
  let e_iso := (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).symm
  let e_k : k →+* ↥(S_k.presheaf.obj (Opposite.op ⊤)) := e_iso.hom.hom
  have he_k_surj : Function.Surjective e_k := fun y =>
    ⟨e_iso.inv.hom y, ConcreteCategory.congr_hom e_iso.inv_hom_id y⟩
  have he_k_ft : e_k.FiniteType := RingHom.FiniteType.of_surjective e_k he_k_surj
  let g_top : k →+* ↥(V.left.presheaf.obj (Opposite.op ⊤)) :=
    (V.hom.appLE ⊤ ⊤ (fun _ _ => trivial)).hom.comp e_k
  let i_k : k →+* K := (V.left.presheaf.germ ⊤ η trivial).hom.comp g_top
  let i_res : ∀ x : ↥V.left, k →+* ↥(V.left.residueField x) :=
    fun x => (V.left.evaluation ⊤ x trivial).hom.comp g_top

  have hBridge : ∀ (W : V.left.Opens) (hW : AlgebraicGeometry.IsAffineOpen W),
      let B : Type u := ↥(V.left.presheaf.obj (Opposite.op W))
      ∃ (g_W : k →+* B),
        g_W.FiniteType ∧
        ((∃ y : ↥V.left, y ∈ W) →
          ∃ (hη : η ∈ W),
            IsDomain B ∧
            (V.left.presheaf.germ W η hη).hom.comp g_W = i_k ∧
            (letI : Algebra B K := ((V.left.presheaf.germ W η hη).hom).toAlgebra
             IsFractionRing B K) ∧
            Nonempty (↥W ≃ₜ PrimeSpectrum B)) ∧
        (∀ (x : ↥V.left) (hx : x ∈ W),
          (V.left.evaluation W x hx).hom.comp g_W = i_res x ∧
          (let p : Ideal B := RingHom.ker (V.left.evaluation W x hx).hom
           letI : Algebra (B ⧸ p) ↥(V.left.residueField x) :=
             ((V.left.evaluation W x hx).hom.kerLift).toAlgebra
           IsFractionRing (B ⧸ p) ↥(V.left.residueField x)) ∧
          (∃ e : ↥W ≃ₜ PrimeSpectrum B,
            (e ⟨x, hx⟩).asIdeal = RingHom.ker (V.left.evaluation W x hx).hom)) := by
    intro W hW B
    let g_W : k →+* B := (V.hom.appLE ⊤ W (fun _ _ => trivial)).hom.comp e_k
    have hg_W_ft : g_W.FiniteType :=
      (V.hom.finiteType_appLE (AlgebraicGeometry.isAffineOpen_top S_k) hW
        (fun _ _ => trivial)).comp he_k_ft
    have hg_W_res : ∀ a : k,
        g_W a = (V.left.presheaf.map (CategoryTheory.homOfLE (le_top : W ≤ ⊤)).op).hom (g_top a) := by
      intro a
      have hmap := AlgebraicGeometry.Scheme.Hom.appLE_map V.hom (U := ⊤) (V := ⊤) (V' := W)
        (fun _ _ => trivial) (CategoryTheory.homOfLE (le_top : W ≤ ⊤)).op
      exact (ConcreteCategory.congr_hom hmap (e_k a)).symm
    let e_W : ↥W ≃ₜ PrimeSpectrum B :=
      TopCat.homeoOfIso (AlgebraicGeometry.Scheme.forgetToTop.mapIso hW.isoSpec)
    refine ⟨g_W, hg_W_ft, ?_, ?_⟩
    · rintro ⟨y, hy⟩
      have hη : η ∈ W :=
        ((genericPoint_spec ↥V.left).mem_open_set_iff W.isOpen).mpr ⟨y, trivial, hy⟩
      haveI : Nonempty ↥(W : AlgebraicGeometry.Scheme.{u}) := ⟨⟨y, hy⟩⟩
      have hDomB : IsDomain B := AlgebraicGeometry.IsIntegral.component_integral W
      have hgerm_eq : (V.left.presheaf.germ W η hη).hom.comp g_W = i_k := by
        ext a
        change (V.left.presheaf.germ W η hη).hom (g_W a) =
          (V.left.presheaf.germ ⊤ η trivial).hom (g_top a)
        rw [hg_W_res a]
        exact TopCat.Presheaf.germ_res_apply V.left.presheaf
          (CategoryTheory.homOfLE (le_top : W ≤ ⊤)) η hη (g_top a)
      have hFracBK :
          @IsFractionRing B _ K _ ((V.left.presheaf.germ W η hη).hom).toAlgebra :=
        AlgebraicGeometry.functionField_isFractionRing_of_isAffineOpen V.left W hW
      exact ⟨hη, hDomB, hgerm_eq, hFracBK, ⟨e_W⟩⟩
    · intro x hx
      have hev_eq : (V.left.evaluation W x hx).hom.comp g_W = i_res x := by
        ext a
        have h1 : (V.left.evaluation W x hx).hom (g_W a) =
            (V.left.residue x).hom ((V.left.presheaf.germ W x hx).hom (g_W a)) := by
          rw [← AlgebraicGeometry.Scheme.germ_residue V.left (U := W) x hx]
          rfl
        have h2 : i_res x a =
            (V.left.residue x).hom ((V.left.presheaf.germ ⊤ x trivial).hom (g_top a)) := by
          change (V.left.evaluation ⊤ x trivial).hom (g_top a) = _
          rw [← AlgebraicGeometry.Scheme.germ_residue V.left (U := ⊤) x trivial]
          rfl
        change (V.left.evaluation W x hx).hom (g_W a) = i_res x a
        rw [h1, h2, hg_W_res a, TopCat.Presheaf.germ_res_apply V.left.presheaf
          (CategoryTheory.homOfLE (le_top : W ≤ ⊤)) x hx (g_top a)]
      let xW : ↥W := ⟨x, hx⟩
      have he_W_pt : e_W xW = hW.primeIdealOf xW := by
        change hW.isoSpec.hom.base xW = hW.primeIdealOf xW
        exact (hW.isoSpec_hom_apply xW).trans (hW.primeIdealOf_eq_map_closedPoint xW).symm
      let S_x := ↥(V.left.presheaf.stalk x)
      have hres_ker : RingHom.ker (V.left.residue x).hom = IsLocalRing.maximalIdeal S_x := by
        haveI : (RingHom.ker (V.left.residue x).hom).IsMaximal :=
          RingHom.ker_isMaximal_of_surjective (V.left.residue x).hom
            (V.left.residue_surjective x)
        exact IsLocalRing.eq_maximalIdeal inferInstance
      letI : Algebra B S_x := TopCat.Presheaf.algebra_section_stalk V.left.presheaf xW
      haveI : IsLocalization.AtPrime S_x (hW.primeIdealOf xW).asIdeal :=
        hW.isLocalization_stalk xW
      have hker_eq : (hW.primeIdealOf xW).asIdeal = RingHom.ker (V.left.evaluation W x hx).hom := by
        ext b
        rw [RingHom.mem_ker, ← AlgebraicGeometry.Scheme.germ_residue V.left (U := W) x hx,
          CommRingCat.hom_comp, RingHom.comp_apply, ← RingHom.mem_ker, hres_ker]
        exact (IsLocalization.AtPrime.to_map_mem_maximal_iff S_x
          (hW.primeIdealOf xW).asIdeal b).symm
      let ev_W := (V.left.evaluation W x hx).hom
      let p : Ideal B := RingHom.ker ev_W
      haveI : p.IsPrime := RingHom.ker_isPrime ev_W
      letI : Algebra (B ⧸ p) ↥(V.left.residueField x) := (ev_W.kerLift).toAlgebra
      have hFracRes : IsFractionRing (B ⧸ p) ↥(V.left.residueField x) := by
        refine (_root_.isLocalization_iff (nonZeroDivisors (B ⧸ p)) ↥(V.left.residueField x)).mpr
          ⟨?_, ?_, ?_⟩
        · intro y
          have hy_ne : (y : B ⧸ p) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp y.2
          have hmap_ne : ev_W.kerLift (y : B ⧸ p) ≠ 0 :=
            fun h0 => hy_ne (RingHom.kerLift_injective ev_W (h0.trans (map_zero _).symm))
          exact Ne.isUnit hmap_ne
        · intro z
          obtain ⟨u, rfl⟩ := V.left.residue_surjective x z
          obtain ⟨⟨a, s⟩, hus⟩ :=
            IsLocalization.surj (hW.primeIdealOf xW).asIdeal.primeCompl u
          have hs_not_p : (s : B) ∉ p := by
            change (s : B) ∉ RingHom.ker (V.left.evaluation W x hx).hom
            rw [← hker_eq]
            exact s.2
          have hs_bar_ne : Ideal.Quotient.mk p (s : B) ≠ 0 :=
            fun h0 => hs_not_p (Ideal.Quotient.eq_zero_iff_mem.mp h0)
          refine ⟨⟨Ideal.Quotient.mk p a,
            ⟨Ideal.Quotient.mk p (s : B), mem_nonZeroDivisors_iff_ne_zero.mpr hs_bar_ne⟩⟩, ?_⟩
          have h_app := congrArg (V.left.residue x).hom hus
          rw [map_mul] at h_app
          have hev_b : ∀ b : B,
              (V.left.residue x).hom (algebraMap B S_x b) =
                ev_W.kerLift (Ideal.Quotient.mk p b) := by
            intro b
            rw [RingHom.kerLift_mk]
            exact ConcreteCategory.congr_hom
              (AlgebraicGeometry.Scheme.germ_residue V.left (U := W) x hx) b
          rw [hev_b (s : B), hev_b a] at h_app
          exact h_app
        · intro y₁ y₂ h_eq
          have hy_eq : y₁ = y₂ := RingHom.kerLift_injective ev_W h_eq
          exact ⟨1, by rw [hy_eq]⟩
      refine ⟨hev_eq, hFracRes, ⟨e_W, ?_⟩⟩
      rw [he_W_pt, hker_eq]

  
  letI : Algebra k K := i_k.toAlgebra
  have hTrK_eq : Algebra.trdeg k K = (m : Cardinal.{u}) := by
    obtain ⟨W_η, hW_η, hη_mem, _⟩ :=
      @AlgebraicGeometry.exists_isAffineOpen_mem_and_subset V.left η ⊤ trivial
    obtain ⟨g_Wη, hg_Wη_ft, hGen_η, _⟩ := hBridge W_η hW_η
    obtain ⟨hη_Wη, hDom_Wη, hgerm_Wη, hFrac_Wη, _⟩ := hGen_η ⟨η, hη_mem⟩
    let B_η : Type u := ↥(V.left.presheaf.obj (Opposite.op W_η))
    letI : IsDomain B_η := hDom_Wη
    letI : Algebra k B_η := g_Wη.toAlgebra
    haveI : Algebra.FiniteType k B_η := RingHom.finiteType_algebraMap.mp hg_Wη_ft
    letI : Algebra B_η K := ((V.left.presheaf.germ W_η η hη_Wη).hom).toAlgebra
    haveI : IsScalarTower k B_η K := IsScalarTower.of_algebraMap_eq' hgerm_Wη.symm
    haveI : IsFractionRing B_η K := hFrac_Wη
    obtain ⟨e₀, _, hTr_e0⟩ := hNoethDim B_η K
    have hAllOpen : ∀ y : ↥V.left,
        ∃ W_y : V.left.Opens, y ∈ W_y ∧ topologicalKrullDim ↥W_y = (e₀ : WithBot ℕ∞) := by
      intro y
      obtain ⟨W_y, hW_y, hy_mem, _⟩ :=
        @AlgebraicGeometry.exists_isAffineOpen_mem_and_subset V.left y ⊤ trivial
      obtain ⟨g_Wy, hg_Wy_ft, hGen_y, _⟩ := hBridge W_y hW_y
      obtain ⟨hη_Wy, hDom_Wy, hgerm_Wy, hFrac_Wy, ⟨e_Wy⟩⟩ := hGen_y ⟨y, hy_mem⟩
      let B_y : Type u := ↥(V.left.presheaf.obj (Opposite.op W_y))
      letI : IsDomain B_y := hDom_Wy
      letI : Algebra k B_y := g_Wy.toAlgebra
      haveI : Algebra.FiniteType k B_y := RingHom.finiteType_algebraMap.mp hg_Wy_ft
      letI : Algebra B_y K := ((V.left.presheaf.germ W_y η hη_Wy).hom).toAlgebra
      haveI : IsScalarTower k B_y K := IsScalarTower.of_algebraMap_eq' hgerm_Wy.symm
      haveI : IsFractionRing B_y K := hFrac_Wy
      obtain ⟨d_y, hDim_By, hTr_dy⟩ := hNoethDim B_y K
      have hdy_eq : d_y = e₀ :=
        Nat.cast_injective (hTr_dy.symm.trans hTr_e0)
      refine ⟨W_y, hy_mem, ?_⟩
      rw [IsHomeomorph.topologicalKrullDim_eq e_Wy e_Wy.isHomeomorph,
        PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim, hDim_By, hdy_eq]
    haveI : Nonempty ↥V.left := ⟨η⟩
    have hDimV_e0 : topologicalKrullDim V.left = (e₀ : WithBot ℕ∞) :=
      hOpenDim ↥V.left e₀ hAllOpen
    have he0_m : e₀ = m :=
      Nat.cast_inj.mp (WithBot.coe_inj.mp (hDimV_e0.symm.trans hDimV))
    rwa [he0_m] at hTr_e0

  refine ⟨⟨i_k, le_of_eq hTrK_eq⟩, fun x => ?_⟩
  let C_x : Set ↥V.left := closure ({x} : Set ↥V.left)
  let κ_x : Type u := ↥(V.left.residueField x)
  letI : Algebra k κ_x := (i_res x).toAlgebra
  obtain ⟨W₀, hW₀, hx, _⟩ :=
    @AlgebraicGeometry.exists_isAffineOpen_mem_and_subset V.left x ⊤ trivial
  obtain ⟨g_W0, hg_W0_ft, hGen_0, hPt_0⟩ := hBridge W₀ hW₀
  obtain ⟨hη, hDom_0, hgerm_0, hFrac_0, _⟩ := hGen_0 ⟨x, hx⟩
  obtain ⟨hev_0, hFracRes_0, _⟩ := hPt_0 x hx
  let B₀ : Type u := ↥(V.left.presheaf.obj (Opposite.op W₀))
  letI : IsDomain B₀ := hDom_0
  letI : Algebra k B₀ := g_W0.toAlgebra
  haveI : Algebra.FiniteType k B₀ := RingHom.finiteType_algebraMap.mp hg_W0_ft
  letI : Algebra B₀ K := ((V.left.presheaf.germ W₀ η hη).hom).toAlgebra
  haveI : IsScalarTower k B₀ K := IsScalarTower.of_algebraMap_eq' hgerm_0.symm
  haveI : IsFractionRing B₀ K := hFrac_0
  let p₀ : Ideal B₀ := RingHom.ker (V.left.evaluation W₀ x hx).hom
  haveI : p₀.IsPrime := RingHom.ker_isPrime (V.left.evaluation W₀ x hx).hom
  haveI : Algebra.FiniteType k (B₀ ⧸ p₀) :=
    Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ k p₀) Ideal.Quotient.mk_surjective
  letI : Algebra (B₀ ⧸ p₀) κ_x := ((V.left.evaluation W₀ x hx).hom.kerLift).toAlgebra
  haveI : IsScalarTower k (B₀ ⧸ p₀) κ_x := IsScalarTower.of_algebraMap_eq (fun a => by
    change i_res x a = (V.left.evaluation W₀ x hx).hom.kerLift (Ideal.Quotient.mk p₀ (g_W0 a))
    rw [RingHom.kerLift_mk, ← hev_0]
    rfl)
  haveI : IsFractionRing (B₀ ⧸ p₀) κ_x := hFracRes_0
  obtain ⟨c, hDim_B0p0, hTr_κx⟩ := hNoethDim (B₀ ⧸ p₀) κ_x

  have hDimCx : topologicalKrullDim ↥C_x = (c : WithBot ℕ∞) := by
    haveI : Nonempty ↥C_x := ⟨⟨x, subset_closure (Set.mem_singleton x)⟩⟩
    refine hOpenDim ↥C_x c (fun z => ?_)
    obtain ⟨W_z, hW_z, hz_mem, _⟩ :=
      @AlgebraicGeometry.exists_isAffineOpen_mem_and_subset V.left z.1 ⊤ trivial
    have hx_z : x ∈ W_z := by
      obtain ⟨w, hw_W, hw_x⟩ := mem_closure_iff.mp z.2 W_z.carrier W_z.isOpen hz_mem
      rw [Set.mem_singleton_iff.mp hw_x] at hw_W
      exact hw_W
    obtain ⟨g_Wz, hg_Wz_ft, _, hPt_z⟩ := hBridge W_z hW_z
    obtain ⟨hev_z, hFracRes_z, ⟨e_z, he_z_ker⟩⟩ := hPt_z x hx_z
    let B_z : Type u := ↥(V.left.presheaf.obj (Opposite.op W_z))
    letI : Algebra k B_z := g_Wz.toAlgebra
    haveI : Algebra.FiniteType k B_z := RingHom.finiteType_algebraMap.mp hg_Wz_ft
    let p_z : Ideal B_z := RingHom.ker (V.left.evaluation W_z x hx_z).hom
    haveI : p_z.IsPrime := RingHom.ker_isPrime (V.left.evaluation W_z x hx_z).hom
    haveI : Algebra.FiniteType k (B_z ⧸ p_z) :=
      Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ k p_z) Ideal.Quotient.mk_surjective
    letI : Algebra (B_z ⧸ p_z) κ_x := ((V.left.evaluation W_z x hx_z).hom.kerLift).toAlgebra
    haveI : IsScalarTower k (B_z ⧸ p_z) κ_x := IsScalarTower.of_algebraMap_eq (fun a => by
      change i_res x a = (V.left.evaluation W_z x hx_z).hom.kerLift (Ideal.Quotient.mk p_z (g_Wz a))
      rw [RingHom.kerLift_mk, ← hev_z]
      rfl)
    haveI : IsFractionRing (B_z ⧸ p_z) κ_x := hFracRes_z
    obtain ⟨d_z, hDim_Bzpz, hTr_dz⟩ := hNoethDim (B_z ⧸ p_z) κ_x
    have hdz_eq : d_z = c := Nat.cast_injective (hTr_dz.symm.trans hTr_κx)
    let U_Wz : TopologicalSpace.Opens ↥C_x :=
      ⟨{ z' : ↥C_x | z'.1 ∈ W_z }, W_z.isOpen.preimage continuous_subtype_val⟩
    refine ⟨U_Wz, hz_mem, ?_⟩
    have hSlice := hSliceDim ↥V.left x W_z hx_z B_z e_z
    change topologicalKrullDim ↥U_Wz = _ at hSlice
    rw [hSlice, he_z_ker, hDim_Bzpz, hdz_eq]

  have hc_le_m : c ≤ m := by
    have hle_wb : (c : WithBot ℕ∞) ≤ (m : WithBot ℕ∞) := by
      rw [← hDimCx, ← hDimV]
      exact topologicalKrullDim_subspace_le ↥V.left C_x
    exact Nat.cast_le.mp (WithBot.coe_le_coe.mp hle_wb)

  obtain ⟨ψ_alg, i_K, hψ_avoid, hi_K, hFG_Tr⟩ :=
    hNoethLift B₀ K c p₀ hTrK_eq hDim_B0p0 hc_le_m
  refine ⟨c, W₀, hW₀, hx, hη, ψ_alg.toRingHom, i_K, hDimCx, hc_le_m, ?_, hi_K, hFG_Tr⟩
  intro h hh_ne h_ev0
  exact hψ_avoid h hh_ne h_ev0

theorem weil_alt_cd_higherDirectImage_affine_stalk_localization (S : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsIntegral S]
    (G : CategoryTheory.Sheaf
      (AlgebraicGeometry.Spec (S.presheaf.stalk (genericPoint ↥S))).smallEtaleTopology
      AddCommGrpCat.{u}) :
    let η : ↥S := genericPoint ↥S
    let K : Type u := ↥(S.presheaf.stalk η)
    let g : Quiver.Hom (AlgebraicGeometry.Spec (S.presheaf.stalk η)) S := S.fromSpecStalk η
    ∃ (G_K : CategoryTheory.Sheaf
        (AlgebraicGeometry.Spec (CommRingCat.of K)).smallEtaleTopology AddCommGrpCat.{u}),
      (∀ ℓ : ℕ, ℓ • CategoryTheory.CategoryStruct.id G = 0 →
        ℓ • CategoryTheory.CategoryStruct.id G_K = 0) ∧
      (∀ n : ℕ, Subsingleton (G_K.H n) → Subsingleton (G.H n)) ∧
      (∀ (s : ℕ) (x : ↥S) (W₀ : S.Opens),
        AlgebraicGeometry.IsAffineOpen W₀ →
        ∀ (hx : x ∈ W₀) (hη : η ∈ W₀),
        let B : Type u := ↥(S.presheaf.obj (Opposite.op W₀))
        let Ω_x : Type u := AlgebraicClosure ↥(S.residueField x)
        letI : Algebra B K := ((S.presheaf.germ W₀ η hη).hom).toAlgebra
        let ev_x : B →+* Ω_x :=
          (algebraMap ↥(S.residueField x) Ω_x).comp (S.evaluation W₀ x hx).hom
        (∀ (C₀ : Type u) [CommRing C₀] [Algebra B C₀] [Algebra.Etale B C₀]
            (u₀ : C₀ →+* Ω_x),
          u₀.comp (algebraMap B C₀) = ev_x →
          letI : Algebra.Etale K (TensorProduct B K C₀) := Algebra.Etale.baseChange B C₀ K
          ∀ (ξ₀ : ↥((G_K.cohomologyPresheaf s).obj
              (Opposite.op (weilAltCdSpecEtaleObj K (TensorProduct B K C₀))))),
            ∃ (C₁ : Type u) (_ : CommRing C₁) (_ : Algebra B C₁) (_ : Algebra C₀ C₁)
              (_ : IsScalarTower B C₀ C₁) (_ : Algebra.Etale C₀ C₁) (u₁ : C₁ →+* Ω_x),
              u₁.comp (algebraMap C₀ C₁) = u₀ ∧
              (letI : Algebra.Etale B C₁ := Algebra.Etale.comp B C₀ C₁
               letI : Algebra.Etale K (TensorProduct B K C₁) := Algebra.Etale.baseChange B C₁ K
               (G_K.cohomologyPresheaf s).map
                 (weilAltCdSpecEtaleMap K
                   (Algebra.TensorProduct.map (AlgHom.id K K)
                     (IsScalarTower.toAlgHom B C₀ C₁))).op ξ₀ = 0)) →
        WeilAltCdStalkZeroAt S (weilAltCdHigherDirectImage g s G) x) :=
by
  have hLiftGeomPt : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      {X_a X_U : AlgebraicGeometry.Scheme.{u}} (f : X_a ⟶ X_U) [AlgebraicGeometry.Etale f]
      (u₀ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ X_U) (z : ↥X_a),
      f z = u₀ (IsLocalRing.closedPoint Ω) →
      ∃ u_a : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ X_a,
        CategoryTheory.CategoryStruct.comp u_a f = u₀ := by
    intro Ω _ _ X_a X_U f _ u₀ z hz
    let R_y : Type u := ↥(X_U.presheaf.stalk (f z))
    let R_z : Type u := ↥(X_a.presheaf.stalk z)
    let _ : Algebra R_y R_z := (f.stalkMap z).hom.toAlgebra
    let _ : IsLocalHom (algebraMap R_y R_z) :=
      show IsLocalHom (f.stalkMap z).hom from inferInstance
    have _ : Algebra.EssFiniteType R_y R_z :=
      RingHom.essFiniteType_algebraMap.mp (AlgebraicGeometry.LocallyOfFiniteType.stalkMap f z)
    have _ : Algebra.FormallyUnramified R_y R_z :=
      RingHom.formallyUnramified_algebraMap.mp (AlgebraicGeometry.FormallyUnramified.stalkMap f z)
    have _ : Module.Finite (IsLocalRing.ResidueField R_y) (IsLocalRing.ResidueField R_z) :=
      inferInstance
    have _ : Algebra.IsAlgebraic (IsLocalRing.ResidueField R_y) (IsLocalRing.ResidueField R_z) :=
      Algebra.IsAlgebraic.of_finite
        (IsLocalRing.ResidueField R_y) (IsLocalRing.ResidueField R_z)
    have _ : IsLocalHom (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.stalkClosedPointTo u₀)) :=
      AlgebraicGeometry.Scheme.isLocalHom_stalkClosedPointTo u₀
    let ι_y := AlgebraicGeometry.Scheme.descResidueField (K := Ω)
      (AlgebraicGeometry.Scheme.stalkClosedPointTo u₀)
    have hι_y : CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map ι_y)
        (X_U.fromSpecResidueField (u₀ (IsLocalRing.closedPoint Ω))) = u₀ :=
      AlgebraicGeometry.Scheme.descResidueField_stalkClosedPointTo_fromSpecResidueField Ω X_U u₀
    let ι_fz : X_U.residueField (f z) ⟶ CommRingCat.of Ω :=
      CategoryTheory.CategoryStruct.comp
        (CategoryTheory.eqToHom (congrArg X_U.residueField hz)) ι_y
    let _ : Algebra (IsLocalRing.ResidueField R_y) Ω := ι_fz.hom.toAlgebra
    let σ : IsLocalRing.ResidueField R_z →ₐ[IsLocalRing.ResidueField R_y] Ω :=
      IsAlgClosed.lift
    have hσ_comm : CategoryTheory.CategoryStruct.comp (f.residueFieldMap z)
        (CommRingCat.ofHom σ.toRingHom) = ι_fz := by
      apply CommRingCat.hom_ext
      ext k
      obtain ⟨r, rfl⟩ := IsLocalRing.residue_surjective k
      have hres := congrArg (fun φ => φ.hom r)
        (AlgebraicGeometry.Scheme.residue_residueFieldMap f z)
      have halg : (f.residueFieldMap z).hom ((IsLocalRing.residue R_y) r) =
          (algebraMap (IsLocalRing.ResidueField R_y) (IsLocalRing.ResidueField R_z))
            ((IsLocalRing.residue R_y) r) := by
        rw [IsLocalRing.ResidueField.algebraMap_residue]
        exact hres
      change σ ((f.residueFieldMap z).hom ((IsLocalRing.residue R_y) r)) =
        ι_fz.hom ((IsLocalRing.residue R_y) r)
      rw [halg, σ.commutes]
      rfl
    have hEqResidue : ∀ (w₁ w₂ : ↥X_U) (hw : w₁ = w₂)
        (ι : X_U.residueField w₂ ⟶ CommRingCat.of Ω),
        CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map
            (CategoryTheory.CategoryStruct.comp
              (CategoryTheory.eqToHom (congrArg X_U.residueField hw)) ι))
          (X_U.fromSpecResidueField w₁) =
        CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map ι) (X_U.fromSpecResidueField w₂) := by
      rintro w _ rfl ι
      rw [CategoryTheory.eqToHom_refl, CategoryTheory.Category.id_comp]
    refine ⟨CategoryTheory.CategoryStruct.comp
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.toRingHom))
      (X_a.fromSpecResidueField z), ?_⟩
    exact (CategoryTheory.Category.assoc _ _ _).trans
      ((congrArg (CategoryTheory.CategoryStruct.comp _)
          (AlgebraicGeometry.Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField f z).symm).trans
        ((CategoryTheory.Category.assoc _ _ _).symm.trans
          ((congrArg (fun k => k ≫ X_U.fromSpecResidueField (f z))
              ((AlgebraicGeometry.Spec.map_comp (f.residueFieldMap z)
                  (CommRingCat.ofHom σ.toRingHom)).symm.trans
                (congrArg AlgebraicGeometry.Spec.map hσ_comm))).trans
            ((hEqResidue (f z) _ hz ι_y).trans hι_y))))

  intro η K g
  refine ⟨G, fun _ h => h, fun _ h => h, ?_⟩
  intro s x W₀ hW₀ hx hη
  dsimp only
  let B : Type u := ↥(S.presheaf.obj (Opposite.op W₀))
  let Ω_x : Type u := AlgebraicClosure ↥(S.residueField x)
  let _ : Algebra B K := ((S.presheaf.germ W₀ η hη).hom).toAlgebra
  let ev_x : B →+* Ω_x :=
    (algebraMap ↥(S.residueField x) Ω_x).comp (S.evaluation W₀ x hx).hom
  intro hKill
  let gx : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω_x)) S :=
    CategoryTheory.CategoryStruct.comp
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥(S.residueField x) Ω_x)))
      (S.fromSpecResidueField x)
  let _ : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) g :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  let _ : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
      (@AlgebraicGeometry.Etale) g :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let B_g : CategoryTheory.Functor S.Etale
      (AlgebraicGeometry.Spec (S.presheaf.stalk η)).Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ g
  let P : CategoryTheory.Functor (S.Etale)ᵒᵖ AddCommGrpCat.{u} :=
    CategoryTheory.Functor.comp B_g.op (CategoryTheory.Sheaf.cohomologyPresheaf G s)
  let ℱ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u} :=
    weilAltCdHigherDirectImage g s G
  let τ := CategoryTheory.toSheafify S.smallEtaleTopology P
  unfold WeilAltCdStalkZeroAt
  dsimp only
  intro U u hu ξ

  let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
    @AlgebraicGeometry.Etale
  have hMemSmallEtale : ∀ (X₀ : S.Etale) (R₀ : CategoryTheory.Sieve X₀),
      R₀ ∈ S.smallEtaleTopology X₀ ↔
      ∀ (y₀ : ↥X₀.left), ∃ (Y : S.Etale) (f : Y ⟶ X₀) (z₀ : ↥Y.left),
        R₀.arrows f ∧ AlgebraicGeometry.Etale f.left ∧ f.left z₀ = y₀ := by
    intro X₀ R₀
    let X₀' : P_et.Over ⊤ S := X₀
    let R₀' : CategoryTheory.Sieve X₀' := R₀
    change R₀' ∈ AlgebraicGeometry.Scheme.smallGrothendieckTopology P_et S X₀' ↔ _
    rw [AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      (P := P_et) (Q := P_et) S le_rfl]
    exact AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology X₀' R₀'
  let ξ' : ↥((CategoryTheory.sheafify S.smallEtaleTopology P).obj (Opposite.op U)) := ξ
  have hSieve := (hMemSmallEtale U (CategoryTheory.Presheaf.imageSieve τ ξ')).mp
    (CategoryTheory.Presheaf.IsLocallySurjective.imageSieve_mem
      (J := S.smallEtaleTopology) (f := τ) ξ')
  let pt_Ω : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω_x)) := IsLocalRing.closedPoint Ω_x
  let u_U : AlgebraicGeometry.Spec (CommRingCat.of Ω_x) ⟶ U.left := u
  obtain ⟨U_a, v_a, z, hArr, hEt_va, hz⟩ := hSieve (u_U pt_Ω)
  obtain ⟨ξ_a, hξ_a⟩ := hArr
  have _ : AlgebraicGeometry.Etale v_a.left := hEt_va
  obtain ⟨u_a, hu_a⟩ := hLiftGeomPt Ω_x v_a.left u_U z hz
  have hu_a_gx : CategoryTheory.CategoryStruct.comp u_a U_a.hom = gx :=
    (congrArg (CategoryTheory.CategoryStruct.comp u_a)
      (CategoryTheory.MorphismProperty.Over.w v_a).symm).trans
      ((CategoryTheory.Category.assoc u_a v_a.left U.hom).symm.trans
        ((congrArg (fun k => k ≫ U.hom) hu_a).trans hu))

  let z₀ : ↥U_a.left := u_a pt_Ω
  have hz₀_eq : U_a.hom z₀ = x := by
    calc
      U_a.hom z₀ = (u_a ≫ U_a.hom) pt_Ω :=
        (AlgebraicGeometry.Scheme.Hom.comp_apply u_a U_a.hom pt_Ω).symm
      _ = gx pt_Ω := congrArg (fun φ => φ pt_Ω) hu_a_gx
      _ = S.fromSpecResidueField x
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap ↥(S.residueField x) Ω_x)) pt_Ω) :=
        AlgebraicGeometry.Scheme.Hom.comp_apply _ _ pt_Ω
      _ = x := AlgebraicGeometry.Scheme.fromSpecResidueField_apply x _
  have hz₀_mem : z₀ ∈ (TopologicalSpace.Opens.map U_a.hom.base).obj W₀ := by
    change U_a.hom z₀ ∈ W₀
    rw [hz₀_eq]
    exact hx
  obtain ⟨V₀, hV₀, hz₀_V₀, hV₀_sub⟩ :=
    AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hz₀_mem
  have hV₀_le : V₀ ≤ (TopologicalSpace.Opens.map U_a.hom.base).obj W₀ := hV₀_sub
  let C₀ : Type u := ↥(U_a.left.presheaf.obj (Opposite.op V₀))
  let _ : Algebra B C₀ := (U_a.hom.appLE W₀ V₀ hV₀_le).hom.toAlgebra
  let f₀ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of C₀)) U_a.left := hV₀.fromSpec
  have hf₀_comm :
      CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B C₀))) hW₀.fromSpec =
      CategoryTheory.CategoryStruct.comp f₀ U_a.hom :=
    AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec U_a.hom hW₀ hV₀ hV₀_le
  have hEt₀ : AlgebraicGeometry.Etale
      (CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B C₀))) hW₀.fromSpec) := by
    have hEt_comp : AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.comp f₀ U_a.hom) := by
      have : AlgebraicGeometry.Etale U_a.hom := U_a.prop
      infer_instance
    exact Eq.mp (congrArg AlgebraicGeometry.Etale hf₀_comm.symm) hEt_comp
  have hEt_Spec_BC₀ : AlgebraicGeometry.Etale
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B C₀))) :=
    CategoryTheory.MorphismProperty.HasOfPostcompProperty.of_postcomp
      (W := P_et) (W' := P_et)
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B C₀)))
      hW₀.fromSpec (show P_et hW₀.fromSpec from inferInstance) hEt₀
  have _ : Algebra.Etale B C₀ :=
    RingHom.etale_algebraMap.mp
      ((AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
        hEt_Spec_BC₀)
  have hRange : Set.range ⇑u_a ⊆ Set.range ⇑f₀ := by
    rintro _ ⟨q, rfl⟩
    have hq : q = pt_Ω := Subsingleton.elim q pt_Ω
    rw [hq]
    change z₀ ∈ (f₀.opensRange : Set ↥U_a.left)
    rw [hV₀.opensRange_fromSpec]
    exact hz₀_V₀
  let u₀_sch : AlgebraicGeometry.Spec (CommRingCat.of Ω_x) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of C₀) :=
    AlgebraicGeometry.IsOpenImmersion.lift f₀ u_a hRange
  let u₀ : C₀ →+* Ω_x := (AlgebraicGeometry.Spec.preimage u₀_sch).hom
  have hu₀_lift :
      CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom u₀)) f₀ = u_a := by
    change AlgebraicGeometry.Spec.map (AlgebraicGeometry.Spec.preimage u₀_sch) ≫ f₀ = u_a
    rw [AlgebraicGeometry.Spec.map_preimage]
    exact AlgebraicGeometry.IsOpenImmersion.lift_fac f₀ u_a hRange
  have hu₀_ev : u₀.comp (algebraMap B C₀) = ev_x := by
    change (CommRingCat.ofHom (u₀.comp (algebraMap B C₀))).hom = (CommRingCat.ofHom ev_x).hom
    congr 1
    apply AlgebraicGeometry.Spec.map_injective
    rw [← cancel_mono hW₀.fromSpec]
    have hLHS :
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (u₀.comp (algebraMap B C₀))) ≫
          hW₀.fromSpec = gx :=
      (congrArg (fun k => k ≫ hW₀.fromSpec)
        (AlgebraicGeometry.Spec.map_comp
          (CommRingCat.ofHom (algebraMap B C₀)) (CommRingCat.ofHom u₀))).trans
        ((CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg (CategoryTheory.CategoryStruct.comp _) hf₀_comm).trans
            ((CategoryTheory.Category.assoc _ _ _).symm.trans
              ((congrArg (fun k => k ≫ U_a.hom) hu₀_lift).trans hu_a_gx))))
    have hRHS :
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev_x) ≫ hW₀.fromSpec = gx :=
      (congrArg (fun k => k ≫ hW₀.fromSpec)
        ((congrArg AlgebraicGeometry.Spec.map
            (congrArg
              (fun k => k ≫ CommRingCat.ofHom (algebraMap ↥(S.residueField x) Ω_x))
              (S.germ_residue x hx).symm)).trans
          ((AlgebraicGeometry.Spec.map_comp
              (S.presheaf.germ W₀ x hx ≫ S.residue x)
              (CommRingCat.ofHom (algebraMap ↥(S.residueField x) Ω_x))).trans
            (congrArg
              (CategoryTheory.CategoryStruct.comp
                (AlgebraicGeometry.Spec.map
                  (CommRingCat.ofHom (algebraMap ↥(S.residueField x) Ω_x))))
              (AlgebraicGeometry.Spec.map_comp
                (S.presheaf.germ W₀ x hx) (S.residue x)))))).trans
        ((CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg
              (CategoryTheory.CategoryStruct.comp
                (AlgebraicGeometry.Spec.map
                  (CommRingCat.ofHom (algebraMap ↥(S.residueField x) Ω_x))))
              ((CategoryTheory.Category.assoc _ _ _).trans
                (congrArg
                  (CategoryTheory.CategoryStruct.comp
                    (AlgebraicGeometry.Spec.map (S.residue x)))
                  (hW₀.fromSpecStalk_eq_fromSpecStalk hx))))))
    exact hLHS.trans hRHS.symm

  let f_K : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of B) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B K))
  have hg_eq : g = CategoryTheory.CategoryStruct.comp f_K hW₀.fromSpec :=
    (hW₀.fromSpecStalk_eq_fromSpecStalk hη).symm
  let mkEtaleObj : ∀ (C : Type u) [CommRing C] [Algebra B C],
      AlgebraicGeometry.Etale
        (CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B C))) hW₀.fromSpec) →
      S.Etale :=
    fun C _ _ hEt_C =>
      CategoryTheory.MorphismProperty.Over.mk ⊤
        (CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B C))) hW₀.fromSpec)
        hEt_C
  have hAlpha : ∀ (C : Type u) [CommRing C] [Algebra B C] [Algebra.Etale B C]
      (hEt_C : AlgebraicGeometry.Etale
        (CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B C))) hW₀.fromSpec)),
      letI : Algebra.Etale K (TensorProduct B K C) := Algebra.Etale.baseChange B C K
      let U_C : S.Etale := mkEtaleObj C hEt_C
      ∃ (α_C : weilAltCdSpecEtaleObj K (TensorProduct B K C) ≅ B_g.obj U_C),
        CategoryTheory.CategoryStruct.comp α_C.hom.left
          (CategoryTheory.Limits.pullback.fst U_C.hom g) =
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom
              (Algebra.TensorProduct.includeRight : C →ₐ[B] TensorProduct B K C).toRingHom) ∧
        CategoryTheory.CategoryStruct.comp α_C.hom.left
          (CategoryTheory.Limits.pullback.snd U_C.hom g) =
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap K (TensorProduct B K C))) := by
    intro C _ _ _ hEt_C
    let _ : Algebra.Etale K (TensorProduct B K C) := Algebra.Etale.baseChange B C K
    let f_C : AlgebraicGeometry.Spec (CommRingCat.of C) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of B) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B C))
    let h_C : AlgebraicGeometry.Spec (CommRingCat.of C) ⟶ S := f_C ≫ hW₀.fromSpec
    let π_K : AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct B K C)) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of K) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K (TensorProduct B K C)))
    let π_C : AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct B K C)) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of C) :=
      AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom
          (Algebra.TensorProduct.includeRight : C →ₐ[B] TensorProduct B K C).toRingHom)
    have hcomm_KC : π_K ≫ f_K = π_C ≫ f_C :=
      (congrArg (fun k => k ≫ f_K)
        (AlgebraicGeometry.pullbackSpecIso_inv_fst' B K C).symm).trans
        ((CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg
              (CategoryTheory.CategoryStruct.comp
                (AlgebraicGeometry.pullbackSpecIso B K C).inv)
              CategoryTheory.Limits.pullback.condition).trans
            ((CategoryTheory.Category.assoc _ _ _).symm.trans
              (congrArg (fun k => k ≫ f_C)
                (AlgebraicGeometry.pullbackSpecIso_inv_snd B K C)))))
    have hcomm_S : π_C ≫ h_C = π_K ≫ g := by
      dsimp [h_C]
      rw [hg_eq, ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc, hcomm_KC]
    let hom_C : AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct B K C)) ⟶
        CategoryTheory.Limits.pullback h_C g :=
      CategoryTheory.Limits.pullback.lift π_C π_K hcomm_S
    let p₁ : CategoryTheory.Limits.pullback h_C g ⟶ AlgebraicGeometry.Spec (CommRingCat.of C) :=
      CategoryTheory.Limits.pullback.fst h_C g
    let p₂ : CategoryTheory.Limits.pullback h_C g ⟶ AlgebraicGeometry.Spec (CommRingCat.of K) :=
      CategoryTheory.Limits.pullback.snd h_C g
    have hp_KC : p₂ ≫ f_K = p₁ ≫ f_C := by
      rw [← cancel_mono hW₀.fromSpec, CategoryTheory.Category.assoc,
        CategoryTheory.Category.assoc, ← hg_eq]
      exact CategoryTheory.Limits.pullback.condition.symm
    let inv_C : CategoryTheory.Limits.pullback h_C g ⟶
        AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct B K C)) :=
      CategoryTheory.Limits.pullback.lift p₂ p₁ hp_KC ≫
        (AlgebraicGeometry.pullbackSpecIso B K C).hom
    have h_hom_inv : hom_C ≫ inv_C = CategoryTheory.CategoryStruct.id _ := by
      rw [← cancel_mono (AlgebraicGeometry.pullbackSpecIso B K C).inv]
      dsimp [inv_C]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        (AlgebraicGeometry.pullbackSpecIso B K C).hom_inv_id,
        CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          AlgebraicGeometry.pullbackSpecIso_inv_fst' B K C]
        exact CategoryTheory.Limits.pullback.lift_snd π_C π_K hcomm_S
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          AlgebraicGeometry.pullbackSpecIso_inv_snd B K C]
        exact CategoryTheory.Limits.pullback.lift_fst π_C π_K hcomm_S
    have h_inv_hom : inv_C ≫ hom_C = CategoryTheory.CategoryStruct.id _ := by
      have hsnd : (AlgebraicGeometry.pullbackSpecIso B K C).hom ≫ π_C =
          CategoryTheory.Limits.pullback.snd f_K f_C :=
        AlgebraicGeometry.pullbackSpecIso_hom_snd B K C
      have hfst : (AlgebraicGeometry.pullbackSpecIso B K C).hom ≫ π_K =
          CategoryTheory.Limits.pullback.fst f_K f_C :=
        AlgebraicGeometry.pullbackSpecIso_hom_fst' B K C
      apply CategoryTheory.Limits.pullback.hom_ext
      · dsimp [inv_C, hom_C]
        rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          CategoryTheory.Category.assoc, hsnd,
          CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.id_comp]
      · dsimp [inv_C, hom_C]
        rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          CategoryTheory.Category.assoc, hfst,
          CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.id_comp]
    let U_C : S.Etale := mkEtaleObj C hEt_C
    let e_sch : (weilAltCdSpecEtaleObj K (TensorProduct B K C)).left ≅ (B_g.obj U_C).left :=
      { hom := hom_C, inv := inv_C, hom_inv_id := h_hom_inv, inv_hom_id := h_inv_hom }
    let α_C : weilAltCdSpecEtaleObj K (TensorProduct B K C) ≅ B_g.obj U_C :=
      CategoryTheory.MorphismProperty.Over.isoMk e_sch
        (CategoryTheory.Limits.pullback.lift_snd π_C π_K hcomm_S)
    exact ⟨α_C, CategoryTheory.Limits.pullback.lift_fst π_C π_K hcomm_S,
      CategoryTheory.Limits.pullback.lift_snd π_C π_K hcomm_S⟩

  let U₀ : S.Etale := mkEtaleObj C₀ hEt₀
  let v₀ : Quiver.Hom U₀ U_a :=
    CategoryTheory.MorphismProperty.Over.homMk f₀ hf₀_comm.symm trivial
  let ξ_B₀ : ↥(P.obj (Opposite.op U₀)) := P.map (Opposite.op v₀) ξ_a
  let _ : Algebra.Etale K (TensorProduct B K C₀) := Algebra.Etale.baseChange B C₀ K
  obtain ⟨α₀, hα₀_fst, hα₀_snd⟩ := hAlpha C₀ hEt₀
  let ξ₀ : ↥((G.cohomologyPresheaf s).obj
      (Opposite.op (weilAltCdSpecEtaleObj K (TensorProduct B K C₀)))) :=
    (G.cohomologyPresheaf s).map α₀.hom.op ξ_B₀
  obtain ⟨C₁, hCR₁, hAlgB₁, hAlgC₀₁, hTower₁, hEtC₀₁, u₁, hu₁_u₀, hKill₁⟩ :=
    hKill C₀ u₀ hu₀_ev ξ₀
  let _ : CommRing C₁ := hCR₁
  let _ : Algebra B C₁ := hAlgB₁
  let _ : Algebra C₀ C₁ := hAlgC₀₁
  let _ : IsScalarTower B C₀ C₁ := hTower₁
  let _ : Algebra.Etale C₀ C₁ := hEtC₀₁
  let _ : Algebra.Etale B C₁ := Algebra.Etale.comp B C₀ C₁
  let _ : Algebra.Etale K (TensorProduct B K C₁) := Algebra.Etale.baseChange B C₁ K
  let φ : C₀ →ₐ[B] C₁ := IsScalarTower.toAlgHom B C₀ C₁
  have hEt₁ : AlgebraicGeometry.Etale
      (CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B C₁))) hW₀.fromSpec) := by
    have : AlgebraicGeometry.Etale
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B C₁))) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
        (RingHom.etale_algebraMap.mpr inferInstance)
    infer_instance
  let U₁ : S.Etale := mkEtaleObj C₁ hEt₁
  have hm_w :
      CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ.toRingHom)) U₀.hom = U₁.hom :=
    (CategoryTheory.Category.assoc
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ.toRingHom))
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B C₀)))
      hW₀.fromSpec).symm.trans
      (congrArg (fun k => k ≫ hW₀.fromSpec)
        ((AlgebraicGeometry.Spec.map_comp
          (CommRingCat.ofHom (algebraMap B C₀))
          (CommRingCat.ofHom φ.toRingHom)).symm.trans
          (congrArg AlgebraicGeometry.Spec.map (CommRingCat.hom_ext φ.comp_algebraMap))))
  let m : Quiver.Hom U₁ U₀ :=
    CategoryTheory.MorphismProperty.Over.homMk
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ.toRingHom)) hm_w trivial
  obtain ⟨α₁, hα₁_fst, hα₁_snd⟩ := hAlpha C₁ hEt₁
  have hNatSq :
      CategoryTheory.CategoryStruct.comp α₁.hom (B_g.map m) =
      CategoryTheory.CategoryStruct.comp
        (weilAltCdSpecEtaleMap K (Algebra.TensorProduct.map (AlgHom.id K K) φ)) α₀.hom := by
    apply CategoryTheory.MorphismProperty.Comma.Hom.ext
    · change α₁.hom.left ≫ (B_g.map m).left =
        (weilAltCdSpecEtaleMap K (Algebra.TensorProduct.map (AlgHom.id K K) φ)).left ≫ α₀.hom.left
      apply CategoryTheory.Limits.pullback.hom_ext
      · exact (CategoryTheory.Category.assoc α₁.hom.left (B_g.map m).left _).trans
          ((congrArg (CategoryTheory.CategoryStruct.comp α₁.hom.left)
              (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
            ((CategoryTheory.Category.assoc _ _ _).symm.trans
              ((congrArg (fun k => k ≫ m.left) hα₁_fst).trans
                ((AlgebraicGeometry.Spec.map_comp
                    (CommRingCat.ofHom φ.toRingHom)
                    (CommRingCat.ofHom
                      (Algebra.TensorProduct.includeRight :
                        C₁ →ₐ[B] TensorProduct B K C₁).toRingHom)).symm.trans
                  ((AlgebraicGeometry.Spec.map_comp
                      (CommRingCat.ofHom
                        (Algebra.TensorProduct.includeRight :
                          C₀ →ₐ[B] TensorProduct B K C₀).toRingHom)
                      (CommRingCat.ofHom
                        (Algebra.TensorProduct.map (AlgHom.id K K) φ).toRingHom)).trans
                    ((congrArg (CategoryTheory.CategoryStruct.comp _) hα₀_fst.symm).trans
                      (CategoryTheory.Category.assoc _ _ _).symm))))))
      · exact (CategoryTheory.Category.assoc α₁.hom.left (B_g.map m).left _).trans
          ((congrArg (CategoryTheory.CategoryStruct.comp α₁.hom.left)
              (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
            (hα₁_snd.trans
              ((congrArg AlgebraicGeometry.Spec.map
                  (CommRingCat.hom_ext
                    (Algebra.TensorProduct.map (AlgHom.id K K) φ).comp_algebraMap)).symm.trans
                ((AlgebraicGeometry.Spec.map_comp
                    (CommRingCat.ofHom (algebraMap K (TensorProduct B K C₀)))
                    (CommRingCat.ofHom
                      (Algebra.TensorProduct.map (AlgHom.id K K) φ).toRingHom)).trans
                  ((congrArg (CategoryTheory.CategoryStruct.comp _) hα₀_snd.symm).trans
                    (CategoryTheory.Category.assoc _ _ _).symm)))))
    · exact Subsingleton.elim _ _
  have hm_zero : P.map (Opposite.op m) ξ_B₀ = 0 := by
    let F_coh := G.cohomologyPresheaf s
    let ψ_map := weilAltCdSpecEtaleMap K (Algebra.TensorProduct.map (AlgHom.id K K) φ)
    have hmap :
        (F_coh.map (Opposite.op (α₁.hom ≫ B_g.map m))) ξ_B₀ =
        (F_coh.map (Opposite.op (ψ_map ≫ α₀.hom))) ξ_B₀ :=
      congrArg (fun k => (F_coh.map (Opposite.op k)) ξ_B₀) hNatSq
    have hLHS_ap :
        (F_coh.map (Opposite.op (α₁.hom ≫ B_g.map m))) ξ_B₀ =
        (F_coh.map α₁.hom.op) (P.map (Opposite.op m) ξ_B₀) :=
      congrArg (fun k => k ξ_B₀) (F_coh.map_comp (B_g.map m).op α₁.hom.op)
    have hRHS_ap :
        (F_coh.map (Opposite.op (ψ_map ≫ α₀.hom))) ξ_B₀ =
        (F_coh.map ψ_map.op) ξ₀ :=
      congrArg (fun k => k ξ_B₀) (F_coh.map_comp α₀.hom.op ψ_map.op)
    have h1 : (F_coh.map α₁.hom.op) (P.map (Opposite.op m) ξ_B₀) = 0 :=
      hLHS_ap.symm.trans (hmap.trans (hRHS_ap.trans hKill₁))
    have hid :
        (F_coh.map α₁.inv.op) ((F_coh.map α₁.hom.op) (P.map (Opposite.op m) ξ_B₀)) =
        P.map (Opposite.op m) ξ_B₀ :=
      congrArg (fun k => k (P.map (Opposite.op m) ξ_B₀))
        ((F_coh.map_comp α₁.hom.op α₁.inv.op).symm.trans
          ((congrArg F_coh.map
              (congrArg Opposite.op α₁.inv_hom_id)).trans
            (F_coh.map_id _)))
    exact hid.symm.trans ((congrArg (F_coh.map α₁.inv.op) h1).trans (map_zero _))

  let v : Quiver.Hom U₁ U :=
    CategoryTheory.CategoryStruct.comp m (CategoryTheory.CategoryStruct.comp v₀ v_a)
  let w : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω_x)) U₁.left :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom u₁)
  refine ⟨U₁, v, w, ?_, ?_⟩
  · have hu10 : CategoryTheory.CategoryStruct.comp
        (CommRingCat.ofHom (algebraMap C₀ C₁)) (CommRingCat.ofHom u₁) =
        CommRingCat.ofHom u₀ :=
      CommRingCat.hom_ext hu₁_u₀
    change AlgebraicGeometry.Spec.map (CommRingCat.ofHom u₁) ≫
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap C₀ C₁)) ≫ f₀ ≫ v_a.left) = u_U
    exact (CategoryTheory.Category.assoc
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom u₁))
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap C₀ C₁)))
      (f₀ ≫ v_a.left)).symm.trans
      ((congrArg (fun k => k ≫ (f₀ ≫ v_a.left))
          ((AlgebraicGeometry.Spec.map_comp
              (CommRingCat.ofHom (algebraMap C₀ C₁))
              (CommRingCat.ofHom u₁)).symm.trans
            (congrArg AlgebraicGeometry.Spec.map hu10))).trans
        ((CategoryTheory.Category.assoc _ f₀ v_a.left).symm.trans
          ((congrArg (fun k => k ≫ v_a.left) hu₀_lift).trans hu_a)))
  · have hmap_v :
        (ℱ.obj.map v.op) ξ =
        (ℱ.obj.map m.op) ((ℱ.obj.map v₀.op) ((ℱ.obj.map v_a.op) ξ)) :=
      congrArg (fun k => k ξ)
        ((ℱ.obj.map_comp (v_a.op ≫ v₀.op) m.op).trans
          (congrArg (fun k => k ≫ ℱ.obj.map m.op)
            (ℱ.obj.map_comp v_a.op v₀.op)))
    have hnat₀ :
        (ℱ.obj.map v₀.op) ((τ.app (Opposite.op U_a)) ξ_a) =
        (τ.app (Opposite.op U₀)) ξ_B₀ :=
      congrArg (fun φ => φ ξ_a) (τ.naturality v₀.op).symm
    have hnat_m :
        (ℱ.obj.map m.op) ((τ.app (Opposite.op U₀)) ξ_B₀) =
        (τ.app (Opposite.op U₁)) (P.map m.op ξ_B₀) :=
      congrArg (fun φ => φ ξ_B₀) (τ.naturality m.op).symm
    exact hmap_v.trans
      ((congrArg (fun z => (ℱ.obj.map m.op) ((ℱ.obj.map v₀.op) z)) hξ_a.symm).trans
        ((congrArg (ℱ.obj.map m.op) hnat₀).trans
          (hnat_m.trans
            ((congrArg (τ.app (Opposite.op U₁)) hm_zero).trans (map_zero _)))))

theorem weil_alt_cd_fg_field_sepClosure_finite_and_trdeg_finset (F₀ K L : Type u) [Field F₀] [Field K] [Field L]
    [Algebra F₀ K] [Algebra K L] [Algebra F₀ L] [IsScalarTower F₀ K L]
    [Module.Finite K L] (e : ℕ)
    (hFG : (⊤ : IntermediateField F₀ K).FG)
    (hTr : Algebra.trdeg F₀ K ≤ (e : Cardinal.{u})) :
    FiniteDimensional F₀ ↥(separableClosure F₀ L) ∧
    ∃ (S : Finset L), S.card ≤ e ∧
      Algebra.IsAlgebraic ↥(Algebra.adjoin F₀ (S : Set L)) L :=
by
  
  have : Algebra.EssFiniteType F₀ K := IntermediateField.fg_top_iff.mp hFG
