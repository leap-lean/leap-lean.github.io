        (κ_lan (G_K.op ⋙ 𝒢.obj) M₀ hFD₀ A₀ M₁ hFD₁ hle₁ x)
      have hx_lan : κ_lan (G_K.op ⋙ 𝒢.obj) M₀ hFD₀ A₀ M₁ hFD₁ hle₁ x = 0 :=
        hx_id.symm.trans (hx_inv.trans (map_zero (Θ 𝒢 Y_L).inv.hom))
