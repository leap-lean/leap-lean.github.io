      exact not_subsingleton A₀ (e_A.injective.subsingleton)
    obtain ⟨k₀⟩ := hNeIdx
    let E₀ : Type u := F_fam k₀
    have : FiniteDimensional E E₀ := (hFinSepFam k₀).1
    have : Algebra.IsSeparable E E₀ := (hFinSepFam k₀).2
    let Ω : Type u := SeparableClosure E
    let ι_sep : E₀ →ₐ[E] Ω := IsSepClosed.lift
    let L_if : IntermediateField E Ω := IntermediateField.normalClosure E E₀ Ω
    have hFinL : FiniteDimensional E ↥L_if := normalClosure.is_finiteDimensional E E₀ Ω
    have hGalL : IsGalois E ↥L_if := IsGalois.normalClosure E E₀ Ω
    have : Algebra.IsSeparable E ↥L_if := IsGalois.to_isSeparable
    let j₀ : E₀ →ₐ[E] ↥L_if :=
      { toFun := fun x => ⟨ι_sep x, by
          change ι_sep x ∈ IntermediateField.normalClosure E E₀ Ω
          rw [normalClosure_def]
          exact le_iSup (fun σ : E₀ →ₐ[E] Ω => σ.fieldRange) ι_sep ⟨x, rfl⟩⟩
        map_one' := Subtype.ext (map_one ι_sep)
        map_mul' := fun x y => Subtype.ext (map_mul ι_sep x y)
        map_zero' := Subtype.ext (map_zero ι_sep)
        map_add' := fun x y => Subtype.ext (map_add ι_sep x y)
        commutes' := fun r => Subtype.ext (ι_sep.commutes r) }
    let ψ_AL : A₀ →ₐ[E] ↥L_if := j₀.comp ((Pi.evalAlgHom E F_fam k₀).comp e_A.toAlgHom)
    let φ_AL : U₀.left.unop ⟶ CommRingCat.of ↥L_if := CommRingCat.ofHom ψ_AL.toRingHom
    have hcomm_AL : CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Scheme.Spec.preimage U₀.hom).unop φ_AL =
        CommRingCat.ofHom (algebraMap E ↥L_if) :=
      CommRingCat.hom_ext ψ_AL.comp_algebraMap
    let u_LU : (weilC1AffEtForgetSite E ↥L_if).obj (topObj ↥L_if) ⟶ U₀ :=
      CategoryTheory.MorphismProperty.CostructuredArrow.homMk
        (Opposite.op φ_AL) trivial
        (calc
          CategoryTheory.CategoryStruct.comp
              (AlgebraicGeometry.Scheme.Spec.map (Opposite.op φ_AL)) U₀.hom
            = CategoryTheory.CategoryStruct.comp
                (AlgebraicGeometry.Spec.map φ_AL)
                (AlgebraicGeometry.Spec.map
                  (AlgebraicGeometry.Scheme.Spec.preimage U₀.hom).unop) :=
                congrArg (CategoryTheory.CategoryStruct.comp (AlgebraicGeometry.Spec.map φ_AL))
                  hEqHom₀.symm
          _ = AlgebraicGeometry.Spec.map
                (CategoryTheory.CategoryStruct.comp
                  (AlgebraicGeometry.Scheme.Spec.preimage U₀.hom).unop φ_AL) :=
                (AlgebraicGeometry.Spec.map_comp _ _).symm
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap E ↥L_if)) :=
                congrArg AlgebraicGeometry.Spec.map hcomm_AL
          _ = CategoryTheory.CategoryStruct.comp
                (CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of ↥L_if)))
                (weilC1AffEtSepHom E ↥L_if) :=
                (CategoryTheory.Category.id_comp _).symm)
    refine ⟨↥L_if, inferInstance, inferInstance, hFinL, hGalL,
      CategoryTheory.CategoryStruct.comp u_LU g₀, ?_⟩
    exact S.downward_closed hg₀ u_LU

  
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let J_E := weilC1AffEtTop E
  let ℤ_E := (CategoryTheory.constantSheaf J_E AddCommGrpCat.{u}).obj Aℤ
  let adj_E := CategoryTheory.constantSheafAdj J_E AddCommGrpCat.{u} (topTerm E)

  have hConstUniv : ∀ (L : Type u) [Field L] [Algebra E L]
      [FiniteDimensional E L] [Algebra.IsSeparable E L]
      (g_L : (weilC1AffEtForgetSite E L).obj (topObj L) ⟶ topObj E),
      letI := hCont₁ E L
      let J_L := weilC1AffEtTop L
      let P_L := (weilC1AffEtForgetSite E L).sheafPushforwardContinuous
        AddCommGrpCat.{u} J_L J_E
      let z_EL : ↥((P_L.obj ℤ_E).obj.obj (Opposite.op (topObj L))) :=
        (ℤ_E.obj.map g_L.op).hom ((adj_E.unit.app Aℤ).hom (ULift.up 1))
      ∀ (ℋ : CategoryTheory.Sheaf J_L AddCommGrpCat.{u}),
        (∀ y : ↥(ℋ.obj.obj (Opposite.op (topObj L))),
          ∃ ψ : P_L.obj ℤ_E ⟶ ℋ, (ψ.hom.app (Opposite.op (topObj L))).hom z_EL = y) ∧
        (∀ α₁ α₂ : P_L.obj ℤ_E ⟶ ℋ,
          (α₁.hom.app (Opposite.op (topObj L))).hom z_EL =
            (α₂.hom.app (Opposite.op (topObj L))).hom z_EL → α₁ = α₂) := by
    intro L _ _ _ _ g_L
    dsimp only
    let _ := hCont₁ E L
    let J_L := weilC1AffEtTop L
    let Fgt := weilC1AffEtForgetSite E L
    let BC := weilC1AffEtBaseChangeSite E L
    let P_L := Fgt.sheafPushforwardContinuous AddCommGrpCat.{u} J_L J_E
    let z_EL : ↥((P_L.obj ℤ_E).obj.obj (Opposite.op (topObj L))) :=
      (ℤ_E.obj.map g_L.op).hom ((adj_E.unit.app Aℤ).hom (ULift.up 1))

    have hTower : ∀ (V : (AlgebraicGeometry.Spec (CommRingCat.of L)).AffineEtale),
        letI : Algebra L ↑V.left.unop := weilC1AffEtAlg L V
        letI : Algebra E ↑V.left.unop := weilC1AffEtAlg E (Fgt.obj V)
        IsScalarTower E L ↑V.left.unop := by
      intro V
      let _ : Algebra L ↑V.left.unop := weilC1AffEtAlg L V
      let _ : Algebra E ↑V.left.unop := weilC1AffEtAlg E (Fgt.obj V)
      refine IsScalarTower.of_algebraMap_eq (fun x => ?_)
      have hpre : AlgebraicGeometry.Scheme.Spec.preimage (Fgt.obj V).hom =
          CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Scheme.Spec.preimage V.hom)
            (Opposite.op (CommRingCat.ofHom (algebraMap E L))) :=
        AlgebraicGeometry.Scheme.Spec.map_injective
          ((AlgebraicGeometry.Scheme.Spec.map_preimage (Fgt.obj V).hom).trans
            (((congrArg (fun k => CategoryTheory.CategoryStruct.comp k (weilC1AffEtSepHom E L))
              (AlgebraicGeometry.Scheme.Spec.map_preimage V.hom).symm)).trans
              (AlgebraicGeometry.Scheme.Spec.map_comp _ _).symm))
      exact congrArg (fun k => k.unop.hom x) hpre

    let homEqv : ∀ (V : (AlgebraicGeometry.Spec (CommRingCat.of L)).AffineEtale)
        (U : (AlgebraicGeometry.Spec (CommRingCat.of E)).AffineEtale),
        (Fgt.obj V ⟶ U) ≃ (V ⟶ BC.obj U) := fun V U =>
      let B : Type u := ↑V.left.unop
      let A : Type u := ↑U.left.unop
      letI : Algebra L B := weilC1AffEtAlg L V
      letI : Algebra E B := weilC1AffEtAlg E (Fgt.obj V)
      letI : IsScalarTower E L B := hTower V
      letI : Algebra E A := weilC1AffEtAlg E U
      { toFun := fun f =>
          let φ_f : A →ₐ[E] B :=
            { toRingHom := (f.left.unop).hom
              commutes' := fun r => by
                have hpre : CategoryTheory.CategoryStruct.comp f.left
                    (AlgebraicGeometry.Scheme.Spec.preimage U.hom) =
                    AlgebraicGeometry.Scheme.Spec.preimage (Fgt.obj V).hom :=
                  AlgebraicGeometry.Scheme.Spec.map_injective
                    ((AlgebraicGeometry.Scheme.Spec.map_comp _ _).trans
                      ((congrArg (CategoryTheory.CategoryStruct.comp
                        (AlgebraicGeometry.Scheme.Spec.map f.left))
                        (AlgebraicGeometry.Scheme.Spec.map_preimage U.hom)).trans
                        (f.w.trans
                          (AlgebraicGeometry.Scheme.Spec.map_preimage (Fgt.obj V).hom).symm)))
                exact congrArg (fun k => k.unop.hom r) hpre }
          let ψ_f : TensorProduct E L A →ₐ[E] B :=
            Algebra.TensorProduct.lift (IsScalarTower.toAlgHom E L B) φ_f
              (fun _ _ => mul_comm _ _)
          have hcomm_L : ψ_f.toRingHom.comp (algebraMap L (TensorProduct E L A)) =
              algebraMap L B := by
            ext l
            exact (Algebra.TensorProduct.lift_tmul (IsScalarTower.toAlgHom E L B) φ_f
              (fun _ _ => mul_comm _ _) l 1).trans
              ((congrArg (algebraMap L B l * ·) (map_one φ_f)).trans (mul_one _))
          CategoryTheory.MorphismProperty.CostructuredArrow.homMk
            (Opposite.op (CommRingCat.ofHom ψ_f.toRingHom)) trivial
            ((AlgebraicGeometry.Spec.map_comp _ _).symm.trans
              ((congrArg AlgebraicGeometry.Spec.map (CommRingCat.hom_ext hcomm_L)).trans
                (AlgebraicGeometry.Scheme.Spec.map_preimage V.hom)))
        invFun := fun g =>
          let ψ_g : TensorProduct E L A →+* B := (g.left.unop).hom
          have hψ_L : ψ_g.comp (algebraMap L (TensorProduct E L A)) = algebraMap L B := by
            have hpre : CategoryTheory.CategoryStruct.comp g.left
                (Opposite.op (CommRingCat.ofHom (algebraMap L (TensorProduct E L A)))) =
                AlgebraicGeometry.Scheme.Spec.preimage V.hom :=
              AlgebraicGeometry.Scheme.Spec.map_injective
                ((AlgebraicGeometry.Scheme.Spec.map_comp _ _).trans
                  (g.w.trans (AlgebraicGeometry.Scheme.Spec.map_preimage V.hom).symm))
            ext l
            exact congrArg (fun k => k.unop.hom l) hpre
          let incR : A →ₐ[E] TensorProduct E L A := Algebra.TensorProduct.includeRight
          let φ_g : A →+* B := ψ_g.comp incR.toRingHom
          have hcomm_E : φ_g.comp (algebraMap E A) = algebraMap E B := by
            ext e
            have htmul : (1 : L) ⊗ₜ[E] algebraMap E A e =
                algebraMap L (TensorProduct E L A) (algebraMap E L e) :=
              (congrArg ((1 : L) ⊗ₜ[E] ·) (Algebra.algebraMap_eq_smul_one e)).trans
                ((TensorProduct.smul_tmul (R := E) e (1 : L) (1 : A)).symm.trans
                  (congrArg (· ⊗ₜ[E] (1 : A)) (Algebra.algebraMap_eq_smul_one e).symm))
            exact (congrArg ψ_g htmul).trans
              ((RingHom.congr_fun hψ_L (algebraMap E L e)).trans
                (IsScalarTower.algebraMap_apply E L B e).symm)
          CategoryTheory.MorphismProperty.CostructuredArrow.homMk
            (Opposite.op (CommRingCat.ofHom φ_g)) trivial
            ((congrArg (CategoryTheory.CategoryStruct.comp
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_g)))
                (AlgebraicGeometry.Scheme.Spec.map_preimage U.hom).symm).trans
              ((AlgebraicGeometry.Spec.map_comp
                (AlgebraicGeometry.Scheme.Spec.preimage U.hom).unop
                (CommRingCat.ofHom φ_g)).symm.trans
                ((congrArg AlgebraicGeometry.Spec.map (CommRingCat.hom_ext hcomm_E)).trans
                  (AlgebraicGeometry.Scheme.Spec.map_preimage (Fgt.obj V).hom))))
        left_inv := fun f => by
          refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
          apply Opposite.unop_injective
          apply CommRingCat.hom_ext
          apply RingHom.ext
          intro a
          let fa : B := (f.left.unop).hom a
          exact (congrArg (· * fa) (map_one (algebraMap L B))).trans (one_mul fa)
        right_inv := fun g => by
          refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
          apply Opposite.unop_injective
          apply CommRingCat.hom_ext
          let ghom : TensorProduct E L A →+* B := (g.left.unop).hom
          have hψ_L : ghom.comp (algebraMap L (TensorProduct E L A)) = algebraMap L B := by
            have hpre : CategoryTheory.CategoryStruct.comp g.left
                (Opposite.op (CommRingCat.ofHom (algebraMap L (TensorProduct E L A)))) =
                AlgebraicGeometry.Scheme.Spec.preimage V.hom :=
              AlgebraicGeometry.Scheme.Spec.map_injective
                ((AlgebraicGeometry.Scheme.Spec.map_comp _ _).trans
                  (g.w.trans (AlgebraicGeometry.Scheme.Spec.map_preimage V.hom).symm))
            ext l
            exact congrArg (fun k => k.unop.hom l) hpre
          apply RingHom.ext
          intro z
          induction z using TensorProduct.induction_on with
          | zero => exact (RingHom.map_zero _).trans (RingHom.map_zero _).symm
          | tmul l a =>
            exact ((congrArg (· * ghom (1 ⊗ₜ[E] a)) (RingHom.congr_fun hψ_L l).symm).trans
              (ghom.map_mul (l ⊗ₜ[E] 1) (1 ⊗ₜ[E] a)).symm).trans
              (congrArg ghom ((Algebra.TensorProduct.tmul_mul_tmul l (1 : L) (1 : A) a).trans
                (congrArg₂ (· ⊗ₜ[E] ·) (mul_one l) (one_mul a))))
          | add x y ihx ihy =>
            exact (RingHom.map_add _ x y).trans ((congrArg₂ (· + ·) ihx ihy).trans
              (RingHom.map_add _ x y).symm) }

    let adj_site : Fgt ⊣ BC := CategoryTheory.Adjunction.mkOfHomEquiv
      { homEquiv := homEqv
        homEquiv_naturality_left_symm := fun {V' V U} h g => by
          refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
          apply Opposite.unop_injective
          apply CommRingCat.hom_ext
          apply RingHom.ext
          intro a
          rfl
        homEquiv_naturality_right := fun {V U U'} f k => by
          refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
          apply Opposite.unop_injective
          apply CommRingCat.hom_ext
          let _ : Algebra E ↑U.left.unop := weilC1AffEtAlg E U
          let _ : Algebra E ↑U'.left.unop := weilC1AffEtAlg E U'
          apply RingHom.ext
          intro z
          induction z using TensorProduct.induction_on with
          | zero => exact (RingHom.map_zero _).trans (RingHom.map_zero _).symm
          | tmul l a => rfl
          | add x y ihx ihy =>
            exact (RingHom.map_add _ x y).trans ((congrArg₂ (· + ·) ihx ihy).trans
              (RingHom.map_add _ x y).symm) }

    have : BC.IsRightAdjoint := adj_site.isRightAdjoint
    have : CategoryTheory.RepresentablyFlat BC :=
      CategoryTheory.RepresentablyFlat.of_isRightAdjoint BC
    have hCompat : CategoryTheory.CompatiblePreserving J_L BC :=
      CategoryTheory.compatiblePreservingOfFlat J_L BC

    have hCover : CategoryTheory.CoverPreserving J_E J_L BC :=
      { cover_preserve := fun {U} {S} hS => by
          let S_E := AlgebraicGeometry.Spec (CommRingCat.of E)
          let S_L := AlgebraicGeometry.Spec (CommRingCat.of L)
          let Φ_E := AlgebraicGeometry.Scheme.AffineEtale.Spec S_E
          let Φ_L := AlgebraicGeometry.Scheme.AffineEtale.Spec S_L
          refine (CategoryTheory.Functor.IsDenseSubsite.functorPushforward_mem_iff
            (J := J_L) (K := S_L.smallEtaleTopology) (G := Φ_L)).mp ?_
          refine (hMemSmallEtale L (Φ_L.obj (BC.obj U)) _).mpr (fun q_pt => ?_)
          let A : Type u := ↑U.left.unop
          letI : Algebra E A := weilC1AffEtAlg E U
          let q : PrimeSpectrum (TensorProduct E L A) := q_pt
          let incR : A →ₐ[E] TensorProduct E L A := Algebra.TensorProduct.includeRight
          let p : PrimeSpectrum A := PrimeSpectrum.comap incR.toRingHom q
          have hPushE : CategoryTheory.Sieve.functorPushforward Φ_E S ∈
              S_E.smallEtaleTopology (Φ_E.obj U) :=
            (CategoryTheory.Functor.IsDenseSubsite.functorPushforward_mem_iff
              (J := J_E) (K := S_E.smallEtaleTopology) (G := Φ_E)).mpr hS
          obtain ⟨Y, f, y₀, hf_push, _, hy₀⟩ :=
            (hMemSmallEtale E (Φ_E.obj U) _).mp hPushE p
          rcases hf_push with ⟨U', g, h, hg_S, rfl⟩
          let A' : Type u := ↑U'.left.unop
          letI : Algebra E A' := weilC1AffEtAlg E U'
          let p' : PrimeSpectrum A' := h.left.base y₀
          let ghom : A →+* A' := (g.left.unop).hom
          have hp_eq : PrimeSpectrum.comap ghom p' = p := hy₀
          have hq_comap : p.asIdeal = Ideal.comap incR.toRingHom q.asIdeal := rfl
          have hp'_comap : p.asIdeal = Ideal.comap ghom p'.asIdeal :=
            (congrArg PrimeSpectrum.asIdeal hp_eq).symm
          let κ_p := p.asIdeal.ResidueField
          let κ_q := q.asIdeal.ResidueField
          let κ_p' := p'.asIdeal.ResidueField
          let i_pq : κ_p →+* κ_q :=
            Ideal.ResidueField.map p.asIdeal q.asIdeal incR.toRingHom hq_comap
          let i_pp' : κ_p →+* κ_p' :=
            Ideal.ResidueField.map p.asIdeal p'.asIdeal ghom hp'_comap
          letI : Algebra κ_p κ_q := i_pq.toAlgebra
          letI : Algebra κ_p κ_p' := i_pp'.toAlgebra
          haveI : Module.FaithfullyFlat κ_p κ_p' :=
            Module.FaithfullyFlat.instOfNontrivialOfFree κ_p κ_p'
          let R_top := TensorProduct κ_p κ_q κ_p'
          haveI : Nontrivial R_top :=
            Module.FaithfullyFlat.rTensor_nontrivial κ_p κ_p' κ_q
          obtain ⟨𝔪, h𝔪_max⟩ := Ideal.exists_maximal R_top
          haveI : 𝔪.IsPrime := h𝔪_max.isPrime
          let f_L_ring : L →+* R_top :=
            (Algebra.TensorProduct.includeLeft : κ_q →ₐ[κ_p] R_top).toRingHom.comp
              ((algebraMap (TensorProduct E L A) κ_q).comp
                (Algebra.TensorProduct.includeLeft : L →ₐ[E] TensorProduct E L A).toRingHom)
          let f_A'_ring : A' →+* R_top :=
            (Algebra.TensorProduct.includeRight : κ_p' →ₐ[κ_p] R_top).toRingHom.comp
              (algebraMap A' κ_p')
          let algER : Algebra E R_top := (f_L_ring.comp (algebraMap E L)).toAlgebra
          letI : Algebra E R_top := algER
          haveI : @IsScalarTower E E R_top _ algER.toSMul algER.toSMul :=
            @IsScalarTower.of_algebraMap_eq' E E R_top _ _ _ (Algebra.id E) algER algER rfl
          let f_L_alg : L →ₐ[E] R_top :=
            { toRingHom := f_L_ring, commutes' := fun _ => rfl }
          have hg_alg : ∀ e : E, ghom (algebraMap E A e) = algebraMap E A' e := by
            intro e
            have hpre : CategoryTheory.CategoryStruct.comp g.left
                (AlgebraicGeometry.Scheme.Spec.preimage U.hom) =
                AlgebraicGeometry.Scheme.Spec.preimage U'.hom :=
              AlgebraicGeometry.Scheme.Spec.map_injective
                ((AlgebraicGeometry.Scheme.Spec.map_comp _ _).trans
                  ((congrArg (CategoryTheory.CategoryStruct.comp
                    (AlgebraicGeometry.Scheme.Spec.map g.left))
                    (AlgebraicGeometry.Scheme.Spec.map_preimage U.hom)).trans
                    (g.w.trans (AlgebraicGeometry.Scheme.Spec.map_preimage U'.hom).symm)))
            exact congrArg (fun k => k.unop.hom e) hpre
          let f_A'_alg : A' →ₐ[E] R_top :=
            { toRingHom := f_A'_ring
              commutes' := fun e => by
                have htmul : (algebraMap E L e : L) ⊗ₜ[E] (1 : A) = incR (algebraMap E A e) :=
                  (congrArg (· ⊗ₜ[E] (1 : A)) (Algebra.algebraMap_eq_smul_one e)).trans
                    ((TensorProduct.smul_tmul (R := E) e (1 : L) (1 : A)).trans
                      (congrArg ((1 : L) ⊗ₜ[E] ·) (Algebra.algebraMap_eq_smul_one e).symm))
                let c : κ_p := algebraMap A κ_p (algebraMap E A e)
                have h1 : algebraMap A' κ_p' (algebraMap E A' e) = c • (1 : κ_p') :=
                  (congrArg (algebraMap A' κ_p') (hg_alg e).symm).trans
                    ((Ideal.ResidueField.map_algebraMap p.asIdeal p'.asIdeal ghom hp'_comap
                      (algebraMap E A e)).symm.trans (mul_one (i_pp' c)).symm)
                have h2 : c • (1 : κ_q) =
                    algebraMap (TensorProduct E L A) κ_q (algebraMap E L e ⊗ₜ[E] 1) :=
                  (mul_one (i_pq c)).trans
                    ((Ideal.ResidueField.map_algebraMap p.asIdeal q.asIdeal incR.toRingHom hq_comap
                      (algebraMap E A e)).trans
                      (congrArg (algebraMap (TensorProduct E L A) κ_q) htmul.symm))
                exact (congrArg ((1 : κ_q) ⊗ₜ[κ_p] ·) h1).trans
                  ((TensorProduct.smul_tmul (R := κ_p) c (1 : κ_q) (1 : κ_p')).symm.trans
                    (congrArg (· ⊗ₜ[κ_p] (1 : κ_p')) h2)) }
          let ψ_top : TensorProduct E L A' →+* R_top :=
            (Algebra.TensorProduct.lift f_L_alg f_A'_alg (fun _ _ => mul_comm _ _)).toRingHom
          let bchom : TensorProduct E L A →+* TensorProduct E L A' := ((BC.map g).left.unop).hom
          have hbchom_tmul : ∀ (l : L) (a : A), bchom (l ⊗ₜ[E] a) = l ⊗ₜ[E] ghom a :=
            fun _ _ => rfl
          have hψ_map : ∀ z : TensorProduct E L A,
              ψ_top (bchom z) =
                (Algebra.TensorProduct.includeLeft : κ_q →ₐ[κ_p] R_top)
                  (algebraMap (TensorProduct E L A) κ_q z) := by
            intro z
            induction z using TensorProduct.induction_on with
            | zero =>
              exact (congrArg ψ_top (map_zero bchom)).trans
                ((map_zero ψ_top).trans
                  ((map_zero (Algebra.TensorProduct.includeLeft : κ_q →ₐ[κ_p] R_top)).symm.trans
                    (congrArg (Algebra.TensorProduct.includeLeft : κ_q →ₐ[κ_p] R_top)
                      (map_zero _).symm)))
            | tmul l a =>
              let ql : κ_q := algebraMap (TensorProduct E L A) κ_q (l ⊗ₜ[E] 1)
              let ca : κ_p := algebraMap A κ_p a
              have hstep1 : ψ_top (bchom (l ⊗ₜ[E] a)) =
                  (ql ⊗ₜ[κ_p] (1 : κ_p')) * ((1 : κ_q) ⊗ₜ[κ_p] algebraMap A' κ_p' (ghom a)) :=
                (congrArg ψ_top (hbchom_tmul l a)).trans
                  (Algebra.TensorProduct.lift_tmul f_L_alg f_A'_alg (fun _ _ => mul_comm _ _)
                    l (ghom a))
              have hstep2 : (ql ⊗ₜ[κ_p] (1 : κ_p')) *
                    ((1 : κ_q) ⊗ₜ[κ_p] algebraMap A' κ_p' (ghom a)) =
                  ql ⊗ₜ[κ_p] (ca • (1 : κ_p')) :=
                (Algebra.TensorProduct.tmul_mul_tmul ql (1 : κ_q) (1 : κ_p')
                  (algebraMap A' κ_p' (ghom a))).trans
                  (congrArg₂ (· ⊗ₜ[κ_p] ·) (mul_one ql)
                    ((one_mul _).trans
                      ((Ideal.ResidueField.map_algebraMap p.asIdeal p'.asIdeal ghom hp'_comap a).symm.trans
                        (mul_one (i_pp' ca)).symm)))
              have hstep3 : ql ⊗ₜ[κ_p] (ca • (1 : κ_p')) = (ca • ql) ⊗ₜ[κ_p] (1 : κ_p') :=
                (TensorProduct.smul_tmul (R := κ_p) ca ql (1 : κ_p')).symm
              have hstep4 : ca • ql = algebraMap (TensorProduct E L A) κ_q (l ⊗ₜ[E] a) := by
                change i_pq ca * ql = algebraMap (TensorProduct E L A) κ_q (l ⊗ₜ[E] a)
                exact (congrArg (· * ql)
                  (Ideal.ResidueField.map_algebraMap p.asIdeal q.asIdeal incR.toRingHom
                    hq_comap a)).trans
                  (((map_mul (algebraMap (TensorProduct E L A) κ_q) (1 ⊗ₜ[E] a) (l ⊗ₜ[E] 1)).symm).trans
                    (congrArg (algebraMap (TensorProduct E L A) κ_q)
                      ((Algebra.TensorProduct.tmul_mul_tmul (1 : L) l a (1 : A)).trans
                        (congrArg₂ (· ⊗ₜ[E] ·) (one_mul l) (mul_one a)))))
              exact hstep1.trans (hstep2.trans (hstep3.trans (congrArg (· ⊗ₜ[κ_p] 1) hstep4)))
            | add x y ihx ihy =>
              exact (congrArg ψ_top (map_add bchom x y)).trans
                ((map_add ψ_top _ _).trans
                  ((congrArg₂ (· + ·) ihx ihy).trans
                    ((map_add (Algebra.TensorProduct.includeLeft : κ_q →ₐ[κ_p] R_top) _ _).symm.trans
                      (congrArg (Algebra.TensorProduct.includeLeft : κ_q →ₐ[κ_p] R_top)
                        (map_add _ x y).symm))))
          let q' : PrimeSpectrum (TensorProduct E L A') :=
            ⟨Ideal.comap ψ_top 𝔪, Ideal.IsPrime.comap ψ_top⟩
          have hq'_eq : PrimeSpectrum.comap bchom q' = q := by
            apply PrimeSpectrum.ext
            ext z
            have : Field (R_top ⧸ 𝔪) := Ideal.Quotient.field 𝔪
            let θ : κ_q →+* R_top ⧸ 𝔪 :=
              (Ideal.Quotient.mk 𝔪).comp
                (Algebra.TensorProduct.includeLeft : κ_q →ₐ[κ_p] R_top).toRingHom
            change ψ_top (bchom z) ∈ 𝔪 ↔ z ∈ q.asIdeal
            exact Ideal.Quotient.eq_zero_iff_mem.symm.trans
              ((Eq.to_iff (congrArg (fun w => Ideal.Quotient.mk 𝔪 w = 0) (hψ_map z))).trans
                ((map_eq_zero θ).trans Ideal.algebraMap_residueField_eq_zero))
          let f_L_mor : Φ_L.obj (BC.obj U') ⟶ Φ_L.obj (BC.obj U) := Φ_L.map (BC.map g)
          have h_in_BC : (CategoryTheory.Sieve.functorPushforward BC S).arrows (BC.map g) :=
            ⟨U', g, CategoryTheory.CategoryStruct.id (BC.obj U'), hg_S,
              (CategoryTheory.Category.id_comp _).symm⟩
          have h_in_ΦL : (CategoryTheory.Sieve.functorPushforward Φ_L
              (CategoryTheory.Sieve.functorPushforward BC S)).arrows f_L_mor :=
            ⟨BC.obj U', BC.map g, CategoryTheory.CategoryStruct.id (Φ_L.obj (BC.obj U')), h_in_BC,
              (CategoryTheory.Category.id_comp _).symm⟩
          have hEt_fL : P_et f_L_mor.left :=
            CategoryTheory.MorphismProperty.of_postcomp
              (W := @AlgebraicGeometry.Etale) (W' := @AlgebraicGeometry.Etale)
              f_L_mor.left (Φ_L.obj (BC.obj U)).hom (Φ_L.obj (BC.obj U)).prop
              ((CategoryTheory.MorphismProperty.Over.w f_L_mor).symm ▸ (Φ_L.obj (BC.obj U')).prop)
          exact ⟨Φ_L.obj (BC.obj U'), f_L_mor, q', h_in_ΦL, hEt_fL, hq'_eq⟩ }

    haveI hCont_BC : BC.IsContinuous J_E J_L :=
      CategoryTheory.Functor.isContinuous_of_coverPreserving hCompat hCover
    let P_push := BC.sheafPushforwardContinuous AddCommGrpCat.{u} J_E J_L

    let hT_BC : CategoryTheory.Limits.IsTerminal (BC.obj (topObj E)) :=
      CategoryTheory.Limits.IsTerminal.ofUniqueHom
        (fun V => adj_site.homEquiv V (topObj E) ((topTerm E).from (Fgt.obj V)))
        (fun V μ => (adj_site.homEquiv V (topObj E)).symm.injective
          (by rw [Equiv.symm_apply_apply]; exact (topTerm E).hom_ext _ _))
    let iso_T : topObj L ≅ BC.obj (topObj E) :=
      CategoryTheory.Limits.IsTerminal.uniqueUpToIso (topTerm L) hT_BC

    intro ℋ
    let e_sheaf : (P_L.obj ℤ_E ⟶ ℋ) ≃ (ℤ_E ⟶ P_push.obj ℋ) :=
      { toFun := fun α =>
          { hom :=
              { app := fun U =>
                  CategoryTheory.CategoryStruct.comp
                    (ℤ_E.obj.map (adj_site.counit.app U.unop).op)
                    (α.hom.app (Opposite.op (BC.obj U.unop)))
                naturality := fun {U₁ U₂} u => by
                  have hmap : CategoryTheory.CategoryStruct.comp
                      (ℤ_E.obj.map u)
                      (ℤ_E.obj.map (adj_site.counit.app U₂.unop).op) =
                      CategoryTheory.CategoryStruct.comp
                        (ℤ_E.obj.map (adj_site.counit.app U₁.unop).op)
                        (ℤ_E.obj.map (Fgt.map (BC.map u.unop)).op) :=
                    (ℤ_E.obj.map_comp u (adj_site.counit.app U₂.unop).op).symm.trans
                      ((congrArg ℤ_E.obj.map
                        (congrArg Quiver.Hom.op (adj_site.counit.naturality u.unop).symm)).trans
                        (ℤ_E.obj.map_comp (adj_site.counit.app U₁.unop).op
                          (Fgt.map (BC.map u.unop)).op))
                  have hnat : CategoryTheory.CategoryStruct.comp
                      (ℤ_E.obj.map (Fgt.map (BC.map u.unop)).op)
                      (α.hom.app (Opposite.op (BC.obj U₂.unop))) =
                      CategoryTheory.CategoryStruct.comp
                        (α.hom.app (Opposite.op (BC.obj U₁.unop)))
                        (ℋ.obj.map (BC.map u.unop).op) :=
                    α.hom.naturality (BC.map u.unop).op
                  exact (CategoryTheory.Category.assoc (ℤ_E.obj.map u)
                    (ℤ_E.obj.map (adj_site.counit.app U₂.unop).op)
                    (α.hom.app (Opposite.op (BC.obj U₂.unop)))).symm.trans
                    ((congrArg (fun k => CategoryTheory.CategoryStruct.comp k
                      (α.hom.app (Opposite.op (BC.obj U₂.unop)))) hmap).trans
                      ((CategoryTheory.Category.assoc
                        (ℤ_E.obj.map (adj_site.counit.app U₁.unop).op)
                        (ℤ_E.obj.map (Fgt.map (BC.map u.unop)).op)
                        (α.hom.app (Opposite.op (BC.obj U₂.unop)))).trans
                        ((congrArg (CategoryTheory.CategoryStruct.comp
                          (ℤ_E.obj.map (adj_site.counit.app U₁.unop).op)) hnat).trans
                          (CategoryTheory.Category.assoc
                            (ℤ_E.obj.map (adj_site.counit.app U₁.unop).op)
                            (α.hom.app (Opposite.op (BC.obj U₁.unop)))
                            (ℋ.obj.map (BC.map u.unop).op)).symm))) } }
        invFun := fun β =>
          { hom :=
              { app := fun V =>
                  CategoryTheory.CategoryStruct.comp
                    (β.hom.app (Opposite.op (Fgt.obj V.unop)))
                    (ℋ.obj.map (adj_site.unit.app V.unop).op)
                naturality := fun {V₁ V₂} v => by
                  have hnat : CategoryTheory.CategoryStruct.comp
                      (ℤ_E.obj.map (Fgt.map v.unop).op)
                      (β.hom.app (Opposite.op (Fgt.obj V₂.unop))) =
                      CategoryTheory.CategoryStruct.comp
                        (β.hom.app (Opposite.op (Fgt.obj V₁.unop)))
                        (ℋ.obj.map (BC.map (Fgt.map v.unop)).op) :=
                    β.hom.naturality (Fgt.map v.unop).op
                  have hmap : CategoryTheory.CategoryStruct.comp
                      (ℋ.obj.map (BC.map (Fgt.map v.unop)).op)
                      (ℋ.obj.map (adj_site.unit.app V₂.unop).op) =
                      CategoryTheory.CategoryStruct.comp
                        (ℋ.obj.map (adj_site.unit.app V₁.unop).op)
                        (ℋ.obj.map v) :=
                    (ℋ.obj.map_comp (BC.map (Fgt.map v.unop)).op
                      (adj_site.unit.app V₂.unop).op).symm.trans
                      ((congrArg ℋ.obj.map
                        (congrArg Quiver.Hom.op (adj_site.unit.naturality v.unop).symm)).trans
                        (ℋ.obj.map_comp (adj_site.unit.app V₁.unop).op v))
                  exact (CategoryTheory.Category.assoc
                    (ℤ_E.obj.map (Fgt.map v.unop).op)
                    (β.hom.app (Opposite.op (Fgt.obj V₂.unop)))
                    (ℋ.obj.map (adj_site.unit.app V₂.unop).op)).symm.trans
                    ((congrArg (fun k => CategoryTheory.CategoryStruct.comp k
                      (ℋ.obj.map (adj_site.unit.app V₂.unop).op)) hnat).trans
                      ((CategoryTheory.Category.assoc
                        (β.hom.app (Opposite.op (Fgt.obj V₁.unop)))
                        (ℋ.obj.map (BC.map (Fgt.map v.unop)).op)
                        (ℋ.obj.map (adj_site.unit.app V₂.unop).op)).trans
                        ((congrArg (CategoryTheory.CategoryStruct.comp
                          (β.hom.app (Opposite.op (Fgt.obj V₁.unop)))) hmap).trans
                          (CategoryTheory.Category.assoc
                            (β.hom.app (Opposite.op (Fgt.obj V₁.unop)))
                            (ℋ.obj.map (adj_site.unit.app V₁.unop).op)
                            (ℋ.obj.map v)).symm))) } }
        left_inv := fun α => by
          ext V x
          have hnat : CategoryTheory.CategoryStruct.comp
              (α.hom.app (Opposite.op (BC.obj (Fgt.obj V.unop))))
              (ℋ.obj.map (adj_site.unit.app V.unop).op) =
              CategoryTheory.CategoryStruct.comp
                (ℤ_E.obj.map (Fgt.map (adj_site.unit.app V.unop)).op)
                (α.hom.app V) :=
            (α.hom.naturality (adj_site.unit.app V.unop).op).symm
          have htri : CategoryTheory.CategoryStruct.comp
              (ℤ_E.obj.map (adj_site.counit.app (Fgt.obj V.unop)).op)
              (ℤ_E.obj.map (Fgt.map (adj_site.unit.app V.unop)).op) =
              CategoryTheory.CategoryStruct.id (ℤ_E.obj.obj (Opposite.op (Fgt.obj V.unop))) :=
            (ℤ_E.obj.map_comp (adj_site.counit.app (Fgt.obj V.unop)).op
              (Fgt.map (adj_site.unit.app V.unop)).op).symm.trans
              ((congrArg ℤ_E.obj.map
                (congrArg Quiver.Hom.op (adj_site.left_triangle_components V.unop))).trans
                (ℤ_E.obj.map_id (Opposite.op (Fgt.obj V.unop))))
          have hcomp : CategoryTheory.CategoryStruct.comp
              (ℤ_E.obj.map (adj_site.counit.app (Fgt.obj V.unop)).op)
              (CategoryTheory.CategoryStruct.comp
                (α.hom.app (Opposite.op (BC.obj (Fgt.obj V.unop))))
                (ℋ.obj.map (adj_site.unit.app V.unop).op)) =
              α.hom.app V :=
            (congrArg (CategoryTheory.CategoryStruct.comp
              (ℤ_E.obj.map (adj_site.counit.app (Fgt.obj V.unop)).op)) hnat).trans
              ((CategoryTheory.Category.assoc
                (ℤ_E.obj.map (adj_site.counit.app (Fgt.obj V.unop)).op)
                (ℤ_E.obj.map (Fgt.map (adj_site.unit.app V.unop)).op)
                (α.hom.app V)).symm.trans
                ((congrArg (fun k => CategoryTheory.CategoryStruct.comp k (α.hom.app V)) htri).trans
                  (CategoryTheory.Category.id_comp (α.hom.app V))))
          exact ConcreteCategory.congr_hom hcomp x
        right_inv := fun β => by
          ext U x
          have hnat : CategoryTheory.CategoryStruct.comp
              (ℤ_E.obj.map (adj_site.counit.app U.unop).op)
              (β.hom.app (Opposite.op (Fgt.obj (BC.obj U.unop)))) =
              CategoryTheory.CategoryStruct.comp
                (β.hom.app U)
                (ℋ.obj.map (BC.map (adj_site.counit.app U.unop)).op) :=
            β.hom.naturality (adj_site.counit.app U.unop).op
          have htri : CategoryTheory.CategoryStruct.comp
              (ℋ.obj.map (BC.map (adj_site.counit.app U.unop)).op)
              (ℋ.obj.map (adj_site.unit.app (BC.obj U.unop)).op) =
              CategoryTheory.CategoryStruct.id (ℋ.obj.obj (Opposite.op (BC.obj U.unop))) :=
            (ℋ.obj.map_comp (BC.map (adj_site.counit.app U.unop)).op
              (adj_site.unit.app (BC.obj U.unop)).op).symm.trans
              ((congrArg ℋ.obj.map
                (congrArg Quiver.Hom.op (adj_site.right_triangle_components U.unop))).trans
                (ℋ.obj.map_id (Opposite.op (BC.obj U.unop))))
          have hcomp : CategoryTheory.CategoryStruct.comp
              (ℤ_E.obj.map (adj_site.counit.app U.unop).op)
              (CategoryTheory.CategoryStruct.comp
                (β.hom.app (Opposite.op (Fgt.obj (BC.obj U.unop))))
                (ℋ.obj.map (adj_site.unit.app (BC.obj U.unop)).op)) =
              β.hom.app U :=
            (CategoryTheory.Category.assoc
              (ℤ_E.obj.map (adj_site.counit.app U.unop).op)
              (β.hom.app (Opposite.op (Fgt.obj (BC.obj U.unop))))
              (ℋ.obj.map (adj_site.unit.app (BC.obj U.unop)).op)).symm.trans
              ((congrArg (fun k => CategoryTheory.CategoryStruct.comp k
                (ℋ.obj.map (adj_site.unit.app (BC.obj U.unop)).op)) hnat).trans
                ((CategoryTheory.Category.assoc (β.hom.app U)
                  (ℋ.obj.map (BC.map (adj_site.counit.app U.unop)).op)
                  (ℋ.obj.map (adj_site.unit.app (BC.obj U.unop)).op)).trans
                  ((congrArg (CategoryTheory.CategoryStruct.comp (β.hom.app U)) htri).trans
                    (CategoryTheory.Category.comp_id (β.hom.app U)))))
          exact ConcreteCategory.congr_hom hcomp x }

    let e_iso : (Aℤ ⟶ ℋ.obj.obj (Opposite.op (BC.obj (topObj E)))) ≃
        (Aℤ ⟶ ℋ.obj.obj (Opposite.op (topObj L))) :=
      { toFun := fun f => CategoryTheory.CategoryStruct.comp f (ℋ.obj.map iso_T.hom.op)
        invFun := fun f => CategoryTheory.CategoryStruct.comp f (ℋ.obj.map iso_T.inv.op)
        left_inv := fun f =>
          (CategoryTheory.Category.assoc f (ℋ.obj.map iso_T.hom.op) (ℋ.obj.map iso_T.inv.op)).trans
            ((congrArg (CategoryTheory.CategoryStruct.comp f)
              ((ℋ.obj.map_comp iso_T.hom.op iso_T.inv.op).symm.trans
                ((congrArg ℋ.obj.map (congrArg Quiver.Hom.op iso_T.inv_hom_id)).trans
                  (ℋ.obj.map_id _)))).trans
              (CategoryTheory.Category.comp_id f))
        right_inv := fun f =>
          (CategoryTheory.Category.assoc f (ℋ.obj.map iso_T.inv.op) (ℋ.obj.map iso_T.hom.op)).trans
            ((congrArg (CategoryTheory.CategoryStruct.comp f)
              ((ℋ.obj.map_comp iso_T.inv.op iso_T.hom.op).symm.trans
                ((congrArg ℋ.obj.map (congrArg Quiver.Hom.op iso_T.hom_inv_id)).trans
                  (ℋ.obj.map_id _)))).trans
              (CategoryTheory.Category.comp_id f)) }

    let M_L := ℋ.obj.obj (Opposite.op (topObj L))
    let e_eval : (Aℤ ⟶ M_L) ≃ ↥M_L :=
      { toFun := fun f => f.hom (ULift.up 1)
        invFun := fun y => AddCommGrpCat.ofHom
          { toFun := fun n => n.down • y
            map_zero' := zero_zsmul y
            map_add' := fun a b => add_zsmul y a.down b.down }
        left_inv := fun f => by
          ext ⟨k⟩
          change k • f.hom (ULift.up 1) = f.hom (ULift.up k)
          rw [← map_zsmul f.hom k (ULift.up 1)]
          congr 1
          ext
          exact zsmul_one k
        right_inv := fun y => one_zsmul y }

    let Θ : (P_L.obj ℤ_E ⟶ ℋ) ≃ ↥M_L :=
      ((e_sheaf.trans (adj_E.homEquiv Aℤ (P_push.obj ℋ))).trans e_iso).trans e_eval

    have hΘ_apply : ∀ α : P_L.obj ℤ_E ⟶ ℋ,
        Θ α = (α.hom.app (Opposite.op (topObj L))).hom z_EL := by
      intro α
      have hadj : adj_E.homEquiv Aℤ (P_push.obj ℋ) (e_sheaf α) =
          CategoryTheory.CategoryStruct.comp
            (adj_E.unit.app Aℤ)
            ((e_sheaf α).hom.app (Opposite.op (topObj E))) :=
        CategoryTheory.Adjunction.homEquiv_unit adj_E Aℤ (P_push.obj ℋ) (e_sheaf α)
      have hnat_iso : CategoryTheory.CategoryStruct.comp
          (α.hom.app (Opposite.op (BC.obj (topObj E))))
          (ℋ.obj.map iso_T.hom.op) =
          CategoryTheory.CategoryStruct.comp
            (ℤ_E.obj.map (Fgt.map iso_T.hom).op)
            (α.hom.app (Opposite.op (topObj L))) :=
        (α.hom.naturality iso_T.hom.op).symm
      have hterm : CategoryTheory.CategoryStruct.comp
          (ℤ_E.obj.map (adj_site.counit.app (topObj E)).op)
          (ℤ_E.obj.map (Fgt.map iso_T.hom).op) =
          ℤ_E.obj.map g_L.op :=
        (ℤ_E.obj.map_comp (adj_site.counit.app (topObj E)).op (Fgt.map iso_T.hom).op).symm.trans
          (congrArg ℤ_E.obj.map
            (congrArg Quiver.Hom.op
              ((topTerm E).hom_ext
                (CategoryTheory.CategoryStruct.comp (Fgt.map iso_T.hom)
                  (adj_site.counit.app (topObj E))) g_L)))
      have hinner : CategoryTheory.CategoryStruct.comp
          ((e_sheaf α).hom.app (Opposite.op (topObj E)))
          (ℋ.obj.map iso_T.hom.op) =
          CategoryTheory.CategoryStruct.comp
            (ℤ_E.obj.map g_L.op)
            (α.hom.app (Opposite.op (topObj L))) :=
        (CategoryTheory.Category.assoc
          (ℤ_E.obj.map (adj_site.counit.app (topObj E)).op)
          (α.hom.app (Opposite.op (BC.obj (topObj E))))
          (ℋ.obj.map iso_T.hom.op)).trans
          ((congrArg (CategoryTheory.CategoryStruct.comp
            (ℤ_E.obj.map (adj_site.counit.app (topObj E)).op)) hnat_iso).trans
            ((CategoryTheory.Category.assoc
              (ℤ_E.obj.map (adj_site.counit.app (topObj E)).op)
              (ℤ_E.obj.map (Fgt.map iso_T.hom).op)
              (α.hom.app (Opposite.op (topObj L)))).symm.trans
              (congrArg (fun k => CategoryTheory.CategoryStruct.comp k
                (α.hom.app (Opposite.op (topObj L)))) hterm)))
      have hmor : e_iso (adj_E.homEquiv Aℤ (P_push.obj ℋ) (e_sheaf α)) =
          CategoryTheory.CategoryStruct.comp
            (adj_E.unit.app Aℤ)
            (CategoryTheory.CategoryStruct.comp
              (ℤ_E.obj.map g_L.op)
              (α.hom.app (Opposite.op (topObj L)))) :=
        (congrArg e_iso hadj).trans
          ((CategoryTheory.Category.assoc (adj_E.unit.app Aℤ)
            ((e_sheaf α).hom.app (Opposite.op (topObj E)))
            (ℋ.obj.map iso_T.hom.op)).trans
            (congrArg (CategoryTheory.CategoryStruct.comp (adj_E.unit.app Aℤ)) hinner))
      exact congrArg (fun f : Aℤ ⟶ M_L => f.hom (ULift.up 1)) hmor

    refine ⟨fun y => ⟨Θ.symm y, ?_⟩, fun α₁ α₂ h => Θ.injective ?_⟩
    · exact (hΘ_apply (Θ.symm y)).symm.trans (Equiv.apply_symm_apply Θ y)
    · exact (hΘ_apply α₁).trans (h.trans (hΘ_apply α₂).symm)

  
  have hMain : ∀ (n : ℕ), 1 ≤ n →
      ∀ (𝒢 : CategoryTheory.Sheaf J_E AddCommGrpCat.{u}) (ω : 𝒢.H n),
      ∃ (L : Type u) (hFL : Field L) (hAlgL : Algebra E L)
        (hFinL : FiniteDimensional E L) (hGalL : IsGalois E L),
        letI : Field L := hFL
        letI : Algebra E L := hAlgL
        letI : FiniteDimensional E L := hFinL
        letI : IsGalois E L := hGalL
        letI : Algebra.IsSeparable E L := IsGalois.to_isSeparable
        letI := hCont₁ E L
        let P_L := (weilC1AffEtForgetSite E L).sheafPushforwardContinuous
          AddCommGrpCat.{u} (weilC1AffEtTop L) J_E
        letI := hAdd₁ E L
        letI := hLim₁ E L
        letI := hColim₁ E L
        CategoryTheory.Abelian.Ext.mapExactFunctor P_L ω = 0 := by
    intro n
    induction n with
    | zero =>
      intro hn
      omega
    | succ r ih =>
      intro _ 𝒢 ω
      let ℐ := CategoryTheory.Injective.under 𝒢
      let i : 𝒢 ⟶ ℐ := CategoryTheory.Injective.ι 𝒢
      let 𝒬 := CategoryTheory.Limits.cokernel i
      let p : ℐ ⟶ 𝒬 := CategoryTheory.Limits.cokernel.π i
      let S_sc := CategoryTheory.ShortComplex.mk i p (CategoryTheory.Limits.cokernel.condition i)
      have hSES : S_sc.ShortExact :=
        CategoryTheory.ShortComplex.ShortExact.mk'
          (CategoryTheory.ShortComplex.exact_cokernel i) inferInstance inferInstance
      have hI_dim : CategoryTheory.HasInjectiveDimensionLT ℐ 1 := inferInstance
      have hω_i : ω.comp (CategoryTheory.Abelian.Ext.mk₀ i) (Nat.add_zero (r + 1)) = 0 :=
        (CategoryTheory.hasInjectiveDimensionLT_iff ℐ 1).mp hI_dim (r + 1)
          (Nat.le_add_left 1 r) _
      obtain ⟨c, hc⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ ℤ_E hSES ω hω_i
          (rfl : r + 1 = r + 1)
      rcases r with _ | r'
      · 
        let φ : ℤ_E ⟶ 𝒬 := CategoryTheory.Abelian.Ext.addEquiv₀ c
        have hφ_c : CategoryTheory.Abelian.Ext.mk₀ φ = c :=
          CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply c
        let u₁ : ↥(ℤ_E.obj.obj (Opposite.op (topObj E))) :=
          (adj_E.unit.app Aℤ).hom (ULift.up 1)
        let s₀ : ↥(𝒬.obj.obj (Opposite.op (topObj E))) :=
          (φ.hom.app (Opposite.op (topObj E))).hom u₁
        let _ := CategoryTheory.GrothendieckTopology.WEqualsLocallyBijective.ofEssentiallySmall.{u}
          J_E (A := AddCommGrpCat.{u})
        have : CategoryTheory.Sheaf.IsLocallySurjective p :=
          (CategoryTheory.Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u} p).mpr inferInstance
        let S : CategoryTheory.Sieve (topObj E) :=
          CategoryTheory.Presheaf.imageSieve p.hom s₀
        have hS_mem : S ∈ J_E (topObj E) :=
          CategoryTheory.Presheaf.IsLocallySurjective.imageSieve_mem s₀
        obtain ⟨L, hFL, hAlgL, hFinL, hGalL, g_L, hg_L⟩ := hRefine S hS_mem
