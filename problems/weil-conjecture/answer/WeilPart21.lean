theorem weil_c1_affEt_gm_isSheaf (F : Type u) [Field F] :
    CategoryTheory.Presheaf.IsSheaf (weilC1AffEtTop F) (weilC1AffEtGmPresheaf F) :=
by
  let S_F := AlgebraicGeometry.Spec (CommRingCat.of F)
  let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
    @AlgebraicGeometry.Etale

  
  have hArrowEtale : ∀ {U W : S_F.AffineEtale} (f : W ⟶ U),
      RingHom.Etale (f.left.unop).hom := by
    intro U W f
    have hComp : P_et (AlgebraicGeometry.Scheme.Spec.map f.left ≫ U.hom) := by
      rw [f.w]
      exact W.prop
    have hSpecEt : P_et (AlgebraicGeometry.Spec.map f.left.unop) :=
      CategoryTheory.MorphismProperty.of_postcomp (W' := P_et) P_et
        (AlgebraicGeometry.Scheme.Spec.map f.left) U.hom U.prop hComp
    exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := P_et)).mp hSpecEt

  
  have hSubcover : ∀ (U : S_F.AffineEtale) (S : CategoryTheory.Sieve U),
      S ∈ weilC1AffEtTop F U →
      ∃ (ι : Type u) (_ : Fintype ι) (Y : ι → S_F.AffineEtale) (g : ∀ i : ι, Y i ⟶ U),
