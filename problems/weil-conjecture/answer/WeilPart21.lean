    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let Fℤ := (CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}).obj Aℤ
    let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
    intro ξ
    let g : Fℤ ⟶ Gm₁ := CategoryTheory.Abelian.Ext.addEquiv₀ ξ
    let g₀ : Aℤ ⟶ Gm₁.obj.obj (Opposite.op T₁) := adj₁.homEquiv Aℤ Gm₁ g
    obtain ⟨w₁, hw₁⟩ := hTermSurj (g₀.hom (ULift.up (1 : ℤ)))
    let h₀ : Aℤ ⟶ (P_push.obj Gm₂).obj.obj (Opposite.op T₁) :=
      AddCommGrpCat.ofHom
        { toFun := fun z : ULift.{u} ℤ => z.down • w₁
          map_zero' := zero_zsmul w₁
          map_add' := fun z₁ z₂ => add_zsmul w₁ z₁.down z₂.down }
    have hh₀_comp : CategoryTheory.CategoryStruct.comp h₀ (tr.hom.app (Opposite.op T₁)) = g₀ := by
      apply AddCommGrpCat.hom_ext
      apply AddMonoidHom.ext
      intro z
      have hz : z.down • (ULift.up (1 : ℤ) : ULift.{u} ℤ) = z :=
        ULift.ext _ _ (zsmul_one z.down)
      change (tr.hom.app (Opposite.op T₁)).hom (z.down • w₁) = g₀.hom z
      rw [map_zsmul, hw₁, ← map_zsmul, hz]
    let h : Fℤ ⟶ P_push.obj Gm₂ := (adj₁.homEquiv Aℤ (P_push.obj Gm₂)).symm h₀
    have hh_tr : CategoryTheory.CategoryStruct.comp h tr = g := by
      have hnat := adj₁.homEquiv_naturality_right_symm h₀ tr
      dsimp [h]
      rw [← hnat]
      have hsec : CategoryTheory.CategoryStruct.comp h₀
          (((CategoryTheory.sheafSections J₁ AddCommGrpCat.{u}).obj (Opposite.op T₁)).map tr) =
          g₀ := hh₀_comp
      rw [hsec]
      exact (adj₁.homEquiv Aℤ Gm₁).symm_apply_apply g
    refine ⟨CategoryTheory.Abelian.Ext.mk₀ h, ?_⟩
    change (CategoryTheory.Abelian.Ext.mk₀ h).comp (CategoryTheory.Abelian.Ext.mk₀ tr)
      (Nat.add_zero 0) = ξ
    rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hh_tr,
      ← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply]
    exact CategoryTheory.Abelian.Ext.addEquiv₀.symm_apply_apply ξ

theorem weil_c1_affEt_cyclic_prime_galois_gm_four_term_exact (hGm : ∀ (F : Type u) [Field F],
      CategoryTheory.Presheaf.IsSheaf (weilC1AffEtTop F) (weilC1AffEtGmPresheaf F))
    (E₁ E₂ : Type u) [Field E₁] [Field E₂] [Algebra E₁ E₂]
    [FiniteDimensional E₁ E₂] [IsGalois E₁ E₂]
    (p : ℕ) (hp : Nat.Prime p) (hdeg : Module.finrank E₁ E₂ = p)
    (hCont₂ : (weilC1AffEtBaseChangeSite E₁ E₂).IsContinuous
      (weilC1AffEtTop E₁) (weilC1AffEtTop E₂))
    (η_Gm : weilC1AffEtGmSheaf E₁ (hGm E₁) ⟶
      (letI := hCont₂
       (weilC1AffEtBaseChangeSite E₁ E₂).sheafPushforwardContinuous
         AddCommGrpCat.{u} (weilC1AffEtTop E₁) (weilC1AffEtTop E₂)).obj
        (weilC1AffEtGmSheaf E₂ (hGm E₂)))
    (tr : (letI := hCont₂
           (weilC1AffEtBaseChangeSite E₁ E₂).sheafPushforwardContinuous
             AddCommGrpCat.{u} (weilC1AffEtTop E₁) (weilC1AffEtTop E₂)).obj
            (weilC1AffEtGmSheaf E₂ (hGm E₂)) ⟶
          weilC1AffEtGmSheaf E₁ (hGm E₁))
    (hEta : ∀ (U : (AlgebraicGeometry.Spec (CommRingCat.of E₁)).AffineEtale),
      letI : Algebra E₁ ↑U.left.unop := weilC1AffEtAlg E₁ U
      ∀ (a : (↑U.left.unop)ˣ),
        (η_Gm.hom.app (Opposite.op U)).hom (Additive.ofMul a) =
          Additive.ofMul (Units.map
            (Algebra.TensorProduct.includeRight :
              ↑U.left.unop →ₐ[E₁] TensorProduct E₁ E₂ ↑U.left.unop).toRingHom.toMonoidHom a))
    (hTr : ∀ (U : (AlgebraicGeometry.Spec (CommRingCat.of E₁)).AffineEtale),
      letI : Algebra E₁ ↑U.left.unop := weilC1AffEtAlg E₁ U
      ∀ (u : (TensorProduct E₁ E₂ ↑U.left.unop)ˣ),
        (tr.hom.app (Opposite.op U)).hom (Additive.ofMul u) =
          Additive.ofMul (Units.map
            ((Algebra.norm ↑U.left.unop).comp
              (Algebra.TensorProduct.comm E₁ E₂ ↑U.left.unop).toRingHom.toMonoidHom) u)) :
    let P_push :=
      letI := hCont₂
      (weilC1AffEtBaseChangeSite E₁ E₂).sheafPushforwardContinuous
        AddCommGrpCat.{u} (weilC1AffEtTop E₁) (weilC1AffEtTop E₂)
    let Gm₁ := weilC1AffEtGmSheaf E₁ (hGm E₁)
    let Gm₂ := weilC1AffEtGmSheaf E₂ (hGm E₂)
    ∃ (𝒥 : CategoryTheory.Sheaf (weilC1AffEtTop E₁) AddCommGrpCat.{u})
      (q₁ : P_push.obj Gm₂ ⟶ 𝒥)
      (i₂ : 𝒥 ⟶ P_push.obj Gm₂)
      (h0₁ : CategoryTheory.CategoryStruct.comp η_Gm q₁ = 0)
      (h0₂ : CategoryTheory.CategoryStruct.comp i₂ tr = 0),
      (CategoryTheory.ShortComplex.mk η_Gm q₁ h0₁).ShortExact ∧
      (CategoryTheory.ShortComplex.mk i₂ tr h0₂).ShortExact :=
by
  intro P_push Gm₁ Gm₂
  haveI : Fact (Nat.Prime p) := ⟨hp⟩
  haveI : Algebra.IsSeparable E₁ E₂ := IsGalois.to_isSeparable
  
  have hcard_aut : Fintype.card (E₂ ≃ₐ[E₁] E₂) = p := by
    rw [← Nat.card_eq_fintype_card, IsGalois.card_aut_eq_finrank E₁ E₂, hdeg]
  obtain ⟨σ, hord⟩ := exists_prime_orderOf_dvd_card p (dvd_of_eq hcard_aut.symm)

  
  let f₀_left : E₂ →ₐ[E₁] (Fin p → E₂) :=
    Pi.algHom E₁ (fun _ : Fin p => E₂) (fun _ => AlgHom.id E₁ E₂)
  let f₀_right : E₂ →ₐ[E₁] (Fin p → E₂) :=
    Pi.algHom E₁ (fun _ : Fin p => E₂) (fun k => (σ ^ (k : ℕ)).toAlgHom)
  let ψ₀_E₁ : TensorProduct E₁ E₂ E₂ →ₐ[E₁] (Fin p → E₂) :=
    Algebra.TensorProduct.lift f₀_left f₀_right (fun _ _ => Commute.all _ _)
  let ψ₀ : TensorProduct E₁ E₂ E₂ →ₐ[E₂] (Fin p → E₂) :=
    { ψ₀_E₁.toRingHom with
      commutes' := fun x => by
        ext k
        change ψ₀_E₁ (x ⊗ₜ[E₁] (1 : E₂)) k = x
        simp [ψ₀_E₁, f₀_left, f₀_right] }
  have hψ₀_bij : Function.Bijective ψ₀ := by
    let b_E : Module.Basis (Fin p) E₁ E₂ := Module.finBasisOfFinrankEq E₁ E₂ hdeg
    let M : Matrix (Fin p) (Fin p) E₂ := Matrix.of fun k j => (σ ^ (k : ℕ)) (b_E j)
    have hPowEq : ∀ a b : ℕ, a ≤ b → b < p → σ ^ a = σ ^ b → a = b := by
      intro a b hab hbp hpow
      have hsub : σ ^ (b - a) = 1 := by
        have h1 : σ ^ (b - a) * σ ^ a = 1 * σ ^ a := by
          rw [← pow_add, Nat.sub_add_cancel hab, one_mul, hpow]
        exact mul_right_cancel h1
      have hdvd : p ∣ (b - a) := hord ▸ orderOf_dvd_iff_pow_eq_one.mpr hsub
      have hzero : b - a = 0 := Nat.eq_zero_of_dvd_of_lt hdvd (by omega)
      omega
    have hχ_inj : Function.Injective (fun k : Fin p => (σ ^ (k : ℕ)).toRingHom.toMonoidHom) := by
      intro k₁ k₂ hEq
      have hσ_eq : σ ^ (k₁ : ℕ) = σ ^ (k₂ : ℕ) :=
        AlgEquiv.ext fun y => DFunLike.congr_fun hEq y
      rcases le_total (k₁ : ℕ) (k₂ : ℕ) with hle | hle
      · exact Fin.ext (hPowEq k₁ k₂ hle k₂.isLt hσ_eq)
      · exact Fin.ext (hPowEq k₂ k₁ hle k₁.isLt hσ_eq.symm).symm
    have hVecMulInj : Function.Injective (fun w : Fin p → E₂ => Matrix.vecMul w M) := by
      intro w₁ w₂ hw
      let w : Fin p → E₂ := w₁ - w₂
      have hwM : ∀ j : Fin p, ∑ k : Fin p, w k * (σ ^ (k : ℕ)) (b_E j) = 0 := by
        intro j
        have hj := congrFun hw j
        simp only [Matrix.vecMul, dotProduct, M, Matrix.of_apply] at hj
        simp only [w, Pi.sub_apply, sub_mul, Finset.sum_sub_distrib, hj, sub_self]
      have hwAll : ∀ y : E₂, ∑ k : Fin p, w k * (σ ^ (k : ℕ)) y = 0 := by
        intro y
        conv_lhs =>
          arg 2
          ext k
          rw [← b_E.sum_repr y, map_sum]
        have hterm : ∀ (k j : Fin p),
            (σ ^ (k : ℕ)) ((b_E.repr y j) • b_E j) =
              algebraMap E₁ E₂ (b_E.repr y j) * (σ ^ (k : ℕ)) (b_E j) := by
          intro k j
          rw [Algebra.smul_def, map_mul, AlgEquiv.commutes]
        simp_rw [hterm, Finset.mul_sum]
        rw [Finset.sum_comm]
        refine Finset.sum_eq_zero fun j _ => ?_
        have hpull : (∑ k : Fin p, w k * (algebraMap E₁ E₂ (b_E.repr y j) * (σ ^ (k : ℕ)) (b_E j))) =
            algebraMap E₁ E₂ (b_E.repr y j) * ∑ k : Fin p, w k * (σ ^ (k : ℕ)) (b_E j) := by
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl fun k _ => ?_
          ring
        rw [hpull, hwM j, mul_zero]
      have hLI := (linearIndependent_monoidHom E₂ E₂).comp
        (fun k : Fin p => (σ ^ (k : ℕ)).toRingHom.toMonoidHom) hχ_inj
      have hSumFun : (∑ k : Fin p,
          w k • (⇑((σ ^ (k : ℕ)).toRingHom.toMonoidHom) : E₂ → E₂)) = 0 := by
        ext y
        simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Pi.zero_apply]
        exact hwAll y
      have hw0 : ∀ k : Fin p, w k = 0 := (Fintype.linearIndependent_iff.mp hLI) w hSumFun
      ext k
      exact sub_eq_zero.mp (hw0 k)
    have hUnitM : IsUnit M := Matrix.vecMul_injective_iff_isUnit.mp hVecMulInj
    have hMulVecBij : Function.Bijective M.mulVec := by
      refine ⟨Matrix.mulVec_injective_iff_isUnit.mpr hUnitM, fun v => ?_⟩
      let Minv : Matrix (Fin p) (Fin p) E₂ := ↑(hUnitM.unit⁻¹)
      refine ⟨Minv.mulVec v, ?_⟩
      rw [Matrix.mulVec_mulVec]
      have hMN : M * Minv = 1 :=
        congrArg (Units.val : (Matrix (Fin p) (Fin p) E₂)ˣ → Matrix (Fin p) (Fin p) E₂)
          (mul_inv_cancel hUnitM.unit)
      rw [hMN, Matrix.one_mulVec]
    let b_EE : Module.Basis (Fin p) E₂ (TensorProduct E₁ E₂ E₂) := b_E.baseChange E₂
    let e_coord : TensorProduct E₁ E₂ E₂ ≃ₗ[E₂] (Fin p → E₂) := b_EE.equivFun
    have hψ₀_eq : ∀ z : TensorProduct E₁ E₂ E₂, ψ₀ z = M.mulVec (e_coord z) := by
      intro z
      ext k
      conv_lhs => rw [← b_EE.sum_repr z]
      rw [map_sum, Finset.sum_apply]
      simp only [Matrix.mulVec, dotProduct, M, Matrix.of_apply, e_coord,
        Module.Basis.equivFun_apply]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [AlgHom.map_smul_of_tower, Pi.smul_apply, smul_eq_mul, Module.Basis.baseChange_apply]
      change b_EE.repr z j * ψ₀_E₁ ((1 : E₂) ⊗ₜ[E₁] b_E j) k =
        (σ ^ (k : ℕ)) (b_E j) * b_EE.repr z j
      simp [ψ₀_E₁, f₀_left, f₀_right, mul_comm]
    have hcomp : (ψ₀ : TensorProduct E₁ E₂ E₂ → (Fin p → E₂)) = M.mulVec ∘ e_coord :=
      funext hψ₀_eq
    rw [hcomp]
    exact hMulVecBij.comp e_coord.bijective
  let e₀ : TensorProduct E₁ E₂ E₂ ≃ₐ[E₂] (Fin p → E₂) := AlgEquiv.ofBijective ψ₀ hψ₀_bij

  
  have hAlgExact : ∀ (B : Type u) [CommRing B] [Algebra E₁ B] [Algebra E₂ B]
      [IsScalarTower E₁ E₂ B],
      let ι_B : Bˣ →* (TensorProduct E₁ E₂ B)ˣ :=
        Units.map (Algebra.TensorProduct.includeRight :
          B →ₐ[E₁] TensorProduct E₁ E₂ B).toRingHom.toMonoidHom
      let σ_B : (TensorProduct E₁ E₂ B)ˣ →* (TensorProduct E₁ E₂ B)ˣ :=
        Units.map (Algebra.TensorProduct.map σ.toAlgHom
          (AlgHom.id E₁ B)).toRingHom.toMonoidHom
      let ν_B : (TensorProduct E₁ E₂ B)ˣ →* Bˣ :=
        Units.map ((Algebra.norm B).comp
          (Algebra.TensorProduct.comm E₁ E₂ B).toRingHom.toMonoidHom)
      Function.Injective ι_B ∧
      (∀ u : (TensorProduct E₁ E₂ B)ˣ, σ_B u * u⁻¹ = 1 ↔ ∃ b : Bˣ, ι_B b = u) ∧
      (∀ v : (TensorProduct E₁ E₂ B)ˣ,
        ν_B v = 1 ↔ ∃ u : (TensorProduct E₁ E₂ B)ˣ, σ_B u * u⁻¹ = v) ∧
      Function.Surjective ν_B := by
    intro B _ _ _ _ ι_B σ_B ν_B
    let fB_left : B →ₐ[E₁] (Fin p → B) :=
      Pi.algHom E₁ (fun _ : Fin p => B) (fun _ => AlgHom.id E₁ B)
    let fB_right : E₂ →ₐ[E₁] (Fin p → B) :=
      Pi.algHom E₁ (fun _ : Fin p => B) (fun k =>
        (IsScalarTower.toAlgHom E₁ E₂ B).comp (σ ^ (k : ℕ)).toAlgHom)
    let ψB_E₁ : TensorProduct E₁ B E₂ →ₐ[E₁] (Fin p → B) :=
      Algebra.TensorProduct.lift fB_left fB_right (fun _ _ => Commute.all _ _)
    let ψ_B : TensorProduct E₁ B E₂ →ₐ[B] (Fin p → B) :=
      { ψB_E₁.toRingHom with
        commutes' := fun b => by
          ext k
          change ψB_E₁ (b ⊗ₜ[E₁] (1 : E₂)) k = b
          simp [ψB_E₁, fB_left, fB_right] }
    let ι_alg : TensorProduct E₁ E₂ E₂ →ₐ[E₁] TensorProduct E₁ B E₂ :=
      Algebra.TensorProduct.map (IsScalarTower.toAlgHom E₁ E₂ B) (AlgHom.id E₁ E₂)
    have hψB_ι : ∀ (z : TensorProduct E₁ E₂ E₂) (k : Fin p),
        ψ_B (ι_alg z) k = algebraMap E₂ B (e₀ z k) := by
      intro z k
      induction z using TensorProduct.induction_on with
      | zero => simp
      | tmul x y =>
        change ψB_E₁ ((algebraMap E₂ B x) ⊗ₜ[E₁] y) k = algebraMap E₂ B (ψ₀_E₁ (x ⊗ₜ[E₁] y) k)
        simp [ψB_E₁, fB_left, fB_right, ψ₀_E₁, f₀_left, f₀_right]
      | add z₁ z₂ ih₁ ih₂ =>
        simp only [map_add, Pi.add_apply]
        rw [ih₁, ih₂]
    let ε₀ : Fin p → TensorProduct E₁ E₂ E₂ := fun r => e₀.symm (Pi.single r (1 : E₂))
    let ε : Fin p → TensorProduct E₁ B E₂ := fun r => ι_alg (ε₀ r)
    have hψB_ε : ∀ r k : Fin p, ψ_B (ε r) k = if k = r then 1 else 0 := by
      intro r k
      rw [hψB_ι]
      have he : e₀ (ε₀ r) = Pi.single r (1 : E₂) := e₀.apply_symm_apply _
      rw [he, Pi.single_apply]
      split_ifs <;> simp
    let θ_B : (Fin p → B) →+ TensorProduct E₁ B E₂ :=
      { toFun := fun f => ∑ r : Fin p, ((f r) ⊗ₜ[E₁] (1 : E₂)) * ε r
        map_zero' := by simp
        map_add' := fun f g => by
          simp [TensorProduct.add_tmul, add_mul, Finset.sum_add_distrib] }
    have hRightInv : ∀ f : Fin p → B, ψ_B (θ_B f) = f := by
      intro f
      ext k
      change ψ_B (∑ r : Fin p, ((f r) ⊗ₜ[E₁] (1 : E₂)) * ε r) k = f k
      rw [map_sum, Finset.sum_apply]
      have hterm : ∀ r : Fin p,
          ψ_B (((f r) ⊗ₜ[E₁] (1 : E₂)) * ε r) k = if k = r then f r else 0 := by
        intro r
        rw [map_mul, Pi.mul_apply, hψB_ε]
        have hfr : ψ_B ((f r) ⊗ₜ[E₁] (1 : E₂)) k = f r := by
          change ψB_E₁ ((f r) ⊗ₜ[E₁] (1 : E₂)) k = f r
          simp [ψB_E₁, fB_left, fB_right]
        rw [hfr]
        split_ifs <;> simp
      simp_rw [hterm]
      simp
    have hLeftInv : ∀ z : TensorProduct E₁ B E₂, θ_B (ψ_B z) = z := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => simp
      | tmul b y =>
        have hy₀_fun : e₀ ((1 : E₂) ⊗ₜ[E₁] y) =
            ∑ r : Fin p, ((σ ^ (r : ℕ)) y) • Pi.single r (1 : E₂) := by
          ext k
          rw [Finset.sum_apply]
          simp only [Pi.smul_apply, smul_eq_mul, Pi.single_apply]
          have h1 : e₀ ((1 : E₂) ⊗ₜ[E₁] y) k = (σ ^ (k : ℕ)) y := by
            change ψ₀_E₁ ((1 : E₂) ⊗ₜ[E₁] y) k = (σ ^ (k : ℕ)) y
            simp [ψ₀_E₁, f₀_left, f₀_right]
          rw [h1]
          symm
          rw [Finset.sum_eq_single k]
          · simp
          · intro r _ hr
            simp [hr.symm]
          · intro hk
            exact absurd (Finset.mem_univ k) hk
        have hy₀ : (1 : E₂) ⊗ₜ[E₁] y =
            ∑ r : Fin p, (((σ ^ (r : ℕ)) y) ⊗ₜ[E₁] (1 : E₂)) * ε₀ r := by
          have h1 := congrArg e₀.symm hy₀_fun
          rw [e₀.symm_apply_apply, map_sum] at h1
          refine h1.trans (Finset.sum_congr rfl fun r _ => ?_)
          rw [map_smul, Algebra.smul_def]
          rfl
        have hy_B : (1 : B) ⊗ₜ[E₁] y =
            ∑ r : Fin p, ((algebraMap E₂ B ((σ ^ (r : ℕ)) y)) ⊗ₜ[E₁] (1 : E₂)) * ε r := by
          have h1 := congrArg ι_alg hy₀
          simp only [ι_alg, Algebra.TensorProduct.map_tmul, IsScalarTower.coe_toAlgHom',
            map_one, AlgHom.id_apply, map_sum, map_mul] at h1
          exact h1
        have hby : b ⊗ₜ[E₁] y = (b ⊗ₜ[E₁] (1 : E₂)) * ((1 : B) ⊗ₜ[E₁] y) := by
          rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
        conv_rhs => rw [hby, hy_B, Finset.mul_sum]
        change (∑ r : Fin p, ((ψ_B (b ⊗ₜ[E₁] y) r) ⊗ₜ[E₁] (1 : E₂)) * ε r) = _
        refine Finset.sum_congr rfl fun r _ => ?_
        have hψ_tmul : ψ_B (b ⊗ₜ[E₁] y) r = b * algebraMap E₂ B ((σ ^ (r : ℕ)) y) := by
          change ψB_E₁ (b ⊗ₜ[E₁] y) r = _
          simp [ψB_E₁, fB_left, fB_right]
        rw [hψ_tmul, ← mul_assoc, Algebra.TensorProduct.tmul_mul_tmul, mul_one]
      | add z₁ z₂ ih₁ ih₂ =>
        rw [map_add, map_add, ih₁, ih₂]
    let e_B : TensorProduct E₁ B E₂ ≃ₐ[B] (Fin p → B) :=
      AlgEquiv.ofBijective ψ_B
        ⟨Function.LeftInverse.injective hLeftInv, Function.RightInverse.surjective hRightInv⟩
    let comm_B := Algebra.TensorProduct.comm E₁ E₂ B
    let Φ_B : TensorProduct E₁ E₂ B ≃+* (Fin p → B) :=
      comm_B.toRingEquiv.trans e_B.toRingEquiv
    let U_B : (TensorProduct E₁ E₂ B)ˣ ≃* (Fin p → Bˣ) :=
      (Units.mapEquiv Φ_B.toMulEquiv).trans MulEquiv.piUnits
    have hUB_val : ∀ (u : (TensorProduct E₁ E₂ B)ˣ) (k : Fin p),
        ((U_B u k : Bˣ) : B) = Φ_B (u : TensorProduct E₁ E₂ B) k := fun _ _ => rfl
    let τ : Fin p ≃ Fin p :=
      { toFun := fun k => ⟨((k : ℕ) + 1) % p, Nat.mod_lt _ hp.pos⟩
        invFun := fun k => ⟨((k : ℕ) + p - 1) % p, Nat.mod_lt _ hp.pos⟩
        left_inv := fun k => by
          apply Fin.ext
          dsimp
          have hk_le : (k : ℕ) + 1 ≤ p := k.isLt
          rcases lt_or_eq_of_le hk_le with hlt | heq
          · rw [Nat.mod_eq_of_lt hlt]
            have h1 : (k : ℕ) + 1 + p - 1 = (k : ℕ) + p := by omega
            rw [h1, Nat.add_mod_right, Nat.mod_eq_of_lt k.isLt]
          · rw [heq, Nat.mod_self]
            have h1 : 0 + p - 1 = p - 1 := by omega
            rw [h1, Nat.mod_eq_of_lt (Nat.sub_lt hp.pos Nat.one_pos)]
            omega
        right_inv := fun k => by
          apply Fin.ext
          dsimp
