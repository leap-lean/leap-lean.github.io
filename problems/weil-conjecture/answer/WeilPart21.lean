        CategoryTheory.MorphismProperty.Over.isoMk e_left hw_K
      refine ⟨e_pb_K, ?_, ?_⟩
      · apply CategoryTheory.MorphismProperty.Comma.Hom.ext
        · exact h_fst_left.symm
        · exact Subsingleton.elim _ _
      · apply CategoryTheory.MorphismProperty.Comma.Hom.ext
        · exact h_snd_left.symm
        · exact Subsingleton.elim _ _
    let Fgt_ab := CategoryTheory.forget AddCommGrpCat.{u}
    let 𝒢_type : CategoryTheory.Functor (S_K.Etale)ᵒᵖ (Type u) := 𝒢₀.obj ⋙ Fgt_ab
    have h𝒢_sheaf : CategoryTheory.Presieve.IsSheaf S_K.smallEtaleTopology 𝒢_type :=
      (CategoryTheory.isSheaf_iff_isSheaf_of_type S_K.smallEtaleTopology 𝒢_type).mp
