  have hι_x_init : ι_fin x_init = IntermediateField.inclusion hle α_init_el := by
    have hunit_mul : algebraMap P ↥E_fin h_S * ι_fin (↑(hu_hS.unit⁻¹) : P_fin) = 1 := by
      have hPfin_mul : (hu_hS.unit : P_fin) * (↑(hu_hS.unit⁻¹) : P_fin) = 1 := Units.mul_inv _
      have hmap := congrArg ι_fin hPfin_mul
      rw [map_mul, map_one, IsUnit.unit_spec, AlgHom.commutes] at hmap
