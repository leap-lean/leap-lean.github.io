  · intro P M₀ hFD₀ A₀ _ _ _ M₁ M₂ hFD₁ hFD₂ hle₁ hle₁₂ _ _ _ _ _ _ _ q₁₂ hq₁₂ x
    obtain ⟨hCompat, _, _⟩ := hColimModel P M₀ hFD₀ A₀
    have hq_eq : q₁₂ = mkTrans M₀ A₀ M₁ M₂ hFD₁ hFD₂ hle₁ hle₁₂ := by
      refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
      apply Opposite.unop_injective
      exact AlgebraicGeometry.Spec.map_injective hq₁₂
    exact (congrArg (fun k => κ_lan P M₀ hFD₀ A₀ M₂ hFD₂ (le_trans hle₁ hle₁₂)
      ((P.map k.op).hom x)) hq_eq).trans (hCompat M₁ M₂ hFD₁ hFD₂ hle₁ hle₁₂ x)
  · intro P M₀ hFD₀ A₀ _ _ _ _ _
    obtain ⟨_, hSurj, hKer⟩ := hColimModel P M₀ hFD₀ A₀
    refine ⟨hSurj, ?_⟩
    intro M₁ hFD₁ hle₁ _ _ _ x hx
    obtain ⟨M₂, hFD₂, hle₁₂, hzero⟩ := hKer M₁ hFD₁ hle₁ x hx
    exact ⟨M₂, hFD₂, hle₁₂,
      mkTrans M₀ A₀ M₁ M₂ hFD₁ hFD₂ hle₁ hle₁₂, rfl, hzero⟩

theorem weil_alt_cd_descended_cover_sheaf_condition (K F₀ L_inf : Type u) [Field K] [Field F₀] [Field L_inf]
