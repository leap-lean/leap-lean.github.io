          CategoryTheory.CategoryStruct.comp
            (Θ 𝒢 Y).hom
            ((P_inf.obj 𝒢).obj.map (G₁.map u).op)) :=
by
  intro G₁ G₂ B_site P_push F_BC η_BC L_aff adj_lan hSheaf P_inf adj
  let A := AddCommGrpCat.{u}
  let J₁_aff := AlgebraicGeometry.Scheme.AffineEtale.topology S₁
  let J₂_aff := AlgebraicGeometry.Scheme.AffineEtale.topology S₂
  let e₁ := AlgebraicGeometry.Scheme.AffineEtale.sheafEquiv S₁ A
  let e₂ := AlgebraicGeometry.Scheme.AffineEtale.sheafEquiv S₂ A
  let Q_to_aff : CategoryTheory.Functor
      (CategoryTheory.Sheaf S₂.smallEtaleTopology A) (CategoryTheory.Sheaf J₁_aff A) :=
    { obj := fun 𝒢 => ⟨L_aff.obj (G₂.op ⋙ 𝒢.obj), hSheaf 𝒢⟩
      map := fun φ => ⟨L_aff.map (CategoryTheory.Functor.whiskerLeft G₂.op φ.hom)⟩
      map_id := fun 𝒢 => by
        ext1
        exact L_aff.map_id _
      map_comp := fun φ₁ φ₂ => by
        ext1
        change L_aff.map (G₂.op.whiskerLeft φ₁.hom ≫ G₂.op.whiskerLeft φ₂.hom) =
          L_aff.map (G₂.op.whiskerLeft φ₁.hom) ≫ L_aff.map (G₂.op.whiskerLeft φ₂.hom)
        exact L_aff.map_comp _ _ }
  let Q_inf : CategoryTheory.Functor
      (CategoryTheory.Sheaf S₂.smallEtaleTopology A)
      (CategoryTheory.Sheaf S₁.smallEtaleTopology A) :=
    Q_to_aff ⋙ e₁.functor
  let β_iso : ∀ ℋ : CategoryTheory.Sheaf S₁.smallEtaleTopology A,
      (F_BC.op ⋙ G₁.op ⋙ ℋ.obj) ≅ (G₂.op ⋙ B_site.op ⋙ ℋ.obj) :=
    fun ℋ => CategoryTheory.NatIso.ofComponents
      (fun X => ℋ.obj.mapIso (η_BC.app X.unop).op.symm)
      (fun {X₁ X₂} f => by
        dsimp
        rw [← ℋ.obj.map_comp, ← ℋ.obj.map_comp]
        congr 1
        apply Opposite.unop_injective
        change (η_BC.app X₂.unop).inv ≫ G₁.map (F_BC.map f.unop) =
          B_site.map (G₂.map f.unop) ≫ (η_BC.app X₁.unop).inv
        rw [Iso.inv_comp_eq, ← CategoryTheory.Category.assoc, Iso.eq_comp_inv]
        exact η_BC.hom.naturality f.unop)
  let fwd : ∀ (𝒢 : CategoryTheory.Sheaf S₂.smallEtaleTopology A)
      (ℋ : CategoryTheory.Sheaf S₁.smallEtaleTopology A),
      (Q_inf.obj 𝒢 ⟶ ℋ) ≃ (G₂.op ⋙ 𝒢.obj ⟶ G₂.op ⋙ B_site.op ⋙ ℋ.obj) := fun 𝒢 ℋ =>
    let eq1 : (Q_inf.obj 𝒢 ⟶ ℋ) ≃ (Q_to_aff.obj 𝒢 ⟶ e₁.inverse.obj ℋ) :=
      e₁.toAdjunction.homEquiv (Q_to_aff.obj 𝒢) ℋ
    let eq2 : (Q_to_aff.obj 𝒢 ⟶ e₁.inverse.obj ℋ) ≃
        (L_aff.obj (G₂.op ⋙ 𝒢.obj) ⟶ G₁.op ⋙ ℋ.obj) :=
      (CategoryTheory.fullyFaithfulSheafToPresheaf J₁_aff A).homEquiv
    let eq3 : (L_aff.obj (G₂.op ⋙ 𝒢.obj) ⟶ G₁.op ⋙ ℋ.obj) ≃
        (G₂.op ⋙ 𝒢.obj ⟶ F_BC.op ⋙ G₁.op ⋙ ℋ.obj) :=
      adj_lan.homEquiv (G₂.op ⋙ 𝒢.obj) (G₁.op ⋙ ℋ.obj)
    let eq4 : (G₂.op ⋙ 𝒢.obj ⟶ F_BC.op ⋙ G₁.op ⋙ ℋ.obj) ≃
        (G₂.op ⋙ 𝒢.obj ⟶ G₂.op ⋙ B_site.op ⋙ ℋ.obj) :=
      { toFun := fun α => α ≫ (β_iso ℋ).hom
        invFun := fun γ => γ ≫ (β_iso ℋ).inv
        left_inv := fun α =>
          (CategoryTheory.Category.assoc α (β_iso ℋ).hom (β_iso ℋ).inv).trans
            ((congrArg (α ≫ ·) (β_iso ℋ).hom_inv_id).trans (CategoryTheory.Category.comp_id α))
        right_inv := fun γ =>
          (CategoryTheory.Category.assoc γ (β_iso ℋ).inv (β_iso ℋ).hom).trans
            ((congrArg (γ ≫ ·) (β_iso ℋ).inv_hom_id).trans (CategoryTheory.Category.comp_id γ)) }
    ((eq1.trans eq2).trans eq3).trans eq4
  let bwd : ∀ (𝒢 : CategoryTheory.Sheaf S₂.smallEtaleTopology A)
      (ℋ : CategoryTheory.Sheaf S₁.smallEtaleTopology A),
      (𝒢 ⟶ P_push.obj ℋ) ≃ (G₂.op ⋙ 𝒢.obj ⟶ G₂.op ⋙ B_site.op ⋙ ℋ.obj) := fun 𝒢 ℋ =>
    e₂.fullyFaithfulInverse.homEquiv.trans
      (CategoryTheory.fullyFaithfulSheafToPresheaf J₂_aff A).homEquiv
  let homEq : ∀ (𝒢 : CategoryTheory.Sheaf S₂.smallEtaleTopology A)
      (ℋ : CategoryTheory.Sheaf S₁.smallEtaleTopology A),
      (Q_inf.obj 𝒢 ⟶ ℋ) ≃ (𝒢 ⟶ P_push.obj ℋ) := fun 𝒢 ℋ =>
    (fwd 𝒢 ℋ).trans (bwd 𝒢 ℋ).symm
  have hbwd_homEq : ∀ (𝒢 : CategoryTheory.Sheaf S₂.smallEtaleTopology A)
      (ℋ : CategoryTheory.Sheaf S₁.smallEtaleTopology A) (v : Q_inf.obj 𝒢 ⟶ ℋ),
      bwd 𝒢 ℋ (homEq 𝒢 ℋ v) = fwd 𝒢 ℋ v :=
    fun 𝒢 ℋ v => (bwd 𝒢 ℋ).apply_symm_apply (fwd 𝒢 ℋ v)
  have hbwd_left : ∀ {𝒢' 𝒢 : CategoryTheory.Sheaf S₂.smallEtaleTopology A}
      {ℋ : CategoryTheory.Sheaf S₁.smallEtaleTopology A}
      (f : 𝒢' ⟶ 𝒢) (w : 𝒢 ⟶ P_push.obj ℋ),
      bwd 𝒢' ℋ (f ≫ w) =
        CategoryTheory.Functor.whiskerLeft G₂.op f.hom ≫ bwd 𝒢 ℋ w :=
    fun f w =>
      (congrArg (CategoryTheory.sheafToPresheaf J₂_aff A).map (e₂.inverse.map_comp f w)).trans
        ((CategoryTheory.sheafToPresheaf J₂_aff A).map_comp _ _)
  have hbwd_right : ∀ {𝒢 : CategoryTheory.Sheaf S₂.smallEtaleTopology A}
      {ℋ ℋ' : CategoryTheory.Sheaf S₁.smallEtaleTopology A}
      (w : 𝒢 ⟶ P_push.obj ℋ) (g : ℋ ⟶ ℋ'),
      bwd 𝒢 ℋ' (w ≫ P_push.map g) =
        bwd 𝒢 ℋ w ≫ CategoryTheory.Functor.whiskerLeft G₂.op
          (CategoryTheory.Functor.whiskerLeft B_site.op g.hom) :=
    fun w g =>
      (congrArg (CategoryTheory.sheafToPresheaf J₂_aff A).map
        (e₂.inverse.map_comp w (P_push.map g))).trans
        ((CategoryTheory.sheafToPresheaf J₂_aff A).map_comp _ _)
  have h_left_nat : ∀ {𝒢' 𝒢 : CategoryTheory.Sheaf S₂.smallEtaleTopology A}
      {ℋ : CategoryTheory.Sheaf S₁.smallEtaleTopology A}
      (f : 𝒢' ⟶ 𝒢) (u : Q_inf.obj 𝒢 ⟶ ℋ),
      homEq 𝒢' ℋ (Q_inf.map f ≫ u) = f ≫ homEq 𝒢 ℋ u := by
    intro 𝒢' 𝒢 ℋ f u
    apply (bwd 𝒢' ℋ).injective
    have h1 : e₁.toAdjunction.homEquiv (Q_to_aff.obj 𝒢') ℋ (e₁.functor.map (Q_to_aff.map f) ≫ u) =
        Q_to_aff.map f ≫ e₁.toAdjunction.homEquiv (Q_to_aff.obj 𝒢) ℋ u :=
      e₁.toAdjunction.homEquiv_naturality_left (Q_to_aff.map f) u
    have h2 : adj_lan.homEquiv (G₂.op ⋙ 𝒢'.obj) (G₁.op ⋙ ℋ.obj)
        (L_aff.map (CategoryTheory.Functor.whiskerLeft G₂.op f.hom) ≫
          (e₁.toAdjunction.homEquiv (Q_to_aff.obj 𝒢) ℋ u).hom) =
        CategoryTheory.Functor.whiskerLeft G₂.op f.hom ≫
          adj_lan.homEquiv (G₂.op ⋙ 𝒢.obj) (G₁.op ⋙ ℋ.obj)
            (e₁.toAdjunction.homEquiv (Q_to_aff.obj 𝒢) ℋ u).hom :=
      adj_lan.homEquiv_naturality_left _ _
    have hfwd : fwd 𝒢' ℋ (Q_inf.map f ≫ u) =
        CategoryTheory.Functor.whiskerLeft G₂.op f.hom ≫ fwd 𝒢 ℋ u :=
      (congrArg (fun k => adj_lan.homEquiv (G₂.op ⋙ 𝒢'.obj) (G₁.op ⋙ ℋ.obj) k.hom ≫
