    have hLocSurj_g : CategoryTheory.Sheaf.IsLocallySurjective g :=
      (CategoryTheory.Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u} g).mpr inferInstance
    have hAntecedent : ∀ (V : (AlgebraicGeometry.Spec (CommRingCat.of E₂)).AffineEtale)
        (y' : ↑(S.X₃.obj.obj (Opposite.op V)))
        (q : PrimeSpectrum ↑V.left.unop),
        ∃ (Y : (AlgebraicGeometry.Spec (CommRingCat.of E₂)).AffineEtale)
          (u : Y ⟶ V) (w : ↑(S.X₂.obj.obj (Opposite.op Y))),
          RingHom.Etale (u.left.unop).hom ∧
          Nontrivial ↑Y.left.unop ∧
          (g.hom.app (Opposite.op Y)).hom w = (S.X₃.obj.map u.op).hom y' := by
      intro V y' q
