        Function.Surjective ((CategoryTheory.Abelian.Ext.mk₀ g₃).postcomp Fℤ_S (Nat.add_zero (2 * δ))) ∧
        (∀ z : X₃.H (2 * δ),
          ((CategoryTheory.Abelian.Ext.mk₀ g₃).postcomp Fℤ_S (Nat.add_zero (2 * δ))) z = 0 ↔
