      intro 𝒞 _ U₀ W₀ f₀ hWP c₀ hc₀ δ_cone hSimp_c
      have _ : ∀ a : SimplexCategory, CategoryTheory.Limits.HasLimit
          (CategoryTheory.Limits.WidePullbackShape.wideCospan U₀
            (fun _ : Fin (a.len + 1) => W₀) (fun _ : Fin (a.len + 1) => f₀)) :=
        fun a => hWP a.len
      let e_cone : ∀ a : SimplexCategory,
          ((CategoryTheory.Arrow.mk f₀).cechNerve.obj (Opposite.op a)) ≅ (c₀ a).pt :=
        fun a => CategoryTheory.Limits.limit.isoLimitCone ⟨c₀ a, hc₀ a⟩
      refine ⟨e_cone, fun {a b} g => ?_⟩
      apply (hc₀ a).hom_ext
      intro j
      have hsome : ∀ i : Fin (a.len + 1),
          ((CategoryTheory.Arrow.mk f₀).cechNerve.map g.op ≫ (e_cone a).hom) ≫
              (c₀ a).π.app (some i) =
            ((e_cone b).hom ≫ δ_cone g) ≫ (c₀ a).π.app (some i) := by
        intro i
        rw [Category.assoc, CategoryTheory.Limits.limit.isoLimitCone_hom_π]
        change (CategoryTheory.Arrow.mk f₀).cechNerve.map g.op ≫
            CategoryTheory.Limits.WidePullback.π
              (fun _ : Fin (a.len + 1) => (CategoryTheory.Arrow.mk f₀).hom) i =
          ((e_cone b).hom ≫ δ_cone g) ≫ (c₀ a).π.app (some i)
        rw [CategoryTheory.Arrow.cechNerve_map, CategoryTheory.Limits.WidePullback.lift_π,
          Category.assoc, hSimp_c g i]
        exact (CategoryTheory.Limits.limit.isoLimitCone_hom_π ⟨c₀ b, hc₀ b⟩
          (some (g.toOrderHom i))).symm
      cases j with
      | some i => exact hsome i
      | none =>
        let i₀ : Fin (a.len + 1) := 0
        have hterm : (CategoryTheory.Limits.WidePullbackShape.wideCospan U₀
            (fun _ : Fin (a.len + 1) => W₀) (fun _ : Fin (a.len + 1) => f₀)).map
            (CategoryTheory.Limits.WidePullbackShape.Hom.term i₀) = f₀ := by simp
        have hw_ca : (c₀ a).π.app (some i₀) ≫ f₀ = (c₀ a).π.app none := by
          simpa [hterm] using (c₀ a).w (CategoryTheory.Limits.WidePullbackShape.Hom.term i₀)
        rw [← hw_ca, ← Category.assoc, ← Category.assoc, hsome i₀]
    refine hAbstractCechIso f_K c hc
      (fun {a b} g => (F.map (weilAltCdSpecEtaleMap E (δ_E g)) : X b.len ⟶ X a.len)) ?_
    intro a b g i
    change (F.map (weilAltCdSpecEtaleMap E (δ_E g)) : X b.len ⟶ X a.len) ≫
        (F.map (weilAltCdSpecEtaleMap E (ι_E a.len i)) ≫ e_WK.inv) =
      F.map (weilAltCdSpecEtaleMap E (ι_E b.len (g.toOrderHom i))) ≫ e_WK.inv
    rw [← Category.assoc, ← F.map_comp, ← hSpecMapComp E (ι_E a.len i) (δ_E g), hSimp g i]

  
