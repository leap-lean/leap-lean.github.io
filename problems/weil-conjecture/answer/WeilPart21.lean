    let α₁ := 𝟙 (pf_f.obj G) ≫ (pf_f.map (adj_Y.unit.app G) ≫ e_pf₁.inv.app (pb_Y.obj G))
    let α₂ := adj_S.unit.app (pf_f.obj G) ≫
