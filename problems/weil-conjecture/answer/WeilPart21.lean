                have hspec : ∀ {φ_b : CommRingCat.of (TensorProduct ↥M₀ ↥j₁.1 (R₀ b.len)) ⟶
                      CommRingCat.of (TensorProduct ↥M₀ ↥j₂.1 (R₀ b.len))}
                    {φ_a : CommRingCat.of (TensorProduct ↥M₀ ↥j₁.1 (R₀ a.len)) ⟶
                      CommRingCat.of (TensorProduct ↥M₀ ↥j₂.1 (R₀ a.len))},
                    (∀ (m₁ : ↥j₁.1) (r : R₀ a.len),
                      φ_b.hom ((Algebra.TensorProduct.map (AlgHom.id ↥j₁.1 ↥j₁.1) (δ₀ g)) (m₁ ⊗ₜ[↥M₀] r)) =
                      (Algebra.TensorProduct.map (AlgHom.id ↥j₂.1 ↥j₂.1) (δ₀ g)) (φ_a.hom (m₁ ⊗ₜ[↥M₀] r))) →
                    CategoryTheory.CategoryStruct.comp
                      (AlgebraicGeometry.Spec.map φ_b)
                      (AlgebraicGeometry.Spec.map
                        (CommRingCat.ofHom
                          (Algebra.TensorProduct.map (AlgHom.id ↥j₁.1 ↥j₁.1) (δ₀ g)).toRingHom)) =
                    CategoryTheory.CategoryStruct.comp
                      (AlgebraicGeometry.Spec.map
                        (CommRingCat.ofHom
                          (Algebra.TensorProduct.map (AlgHom.id ↥j₂.1 ↥j₂.1) (δ₀ g)).toRingHom))
                      (AlgebraicGeometry.Spec.map φ_a) := by
                  intro φ_b φ_a htmul
                  rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
                  congr 1
                  apply CommRingCat.hom_ext
                  have hhom : φ_b.hom.comp
                      (Algebra.TensorProduct.map (AlgHom.id ↥j₁.1 ↥j₁.1) (δ₀ g)).toRingHom =
                    (Algebra.TensorProduct.map (AlgHom.id ↥j₂.1 ↥j₂.1) (δ₀ g)).toRingHom.comp
                      φ_a.hom := by
                    refine RingHom.ext fun z => ?_
                    induction z using TensorProduct.induction_on with
                    | zero => simp only [map_zero]
                    | tmul m₁ r => exact htmul m₁ r
                    | add x y ihx ihy =>
                      simp only [RingHom.comp_apply, map_add] at ihx ihy ⊢
                      rw [ihx, ihy]
                  exact hhom
                apply CategoryTheory.MorphismProperty.Over.Hom.ext
                exact (congrArg (fun m => CategoryTheory.CategoryStruct.comp m _) hb).trans
                  ((hspec (fun _ _ => rfl)).trans
                    (congrArg (CategoryTheory.CategoryStruct.comp _) ha.symm))
              dsimp [F_diag_obj]
              rw [← ℐ_K.obj.map_comp, ← ℐ_K.obj.map_comp]
              exact congrArg (fun m => ℐ_K.obj.map m.op) hcomm }
        map_id := fun j => by
          ext a : 1
          have hid : transK (CategoryTheory.CategoryStruct.id j) a =
              CategoryTheory.CategoryStruct.id (objK j a) := by
            let _ : Algebra K ↥j.1 :=
              RingHom.toAlgebra ((algebraMap F₀ ↥j.1).comp (algebraMap K F₀))
            let _ : Algebra.Etale K ↥j.1 := hEtM j.1 j.2.1
            let _ : Algebra ↥M₀ ↥j.1 :=
              (IntermediateField.inclusion j.2.2).toRingHom.toAlgebra
            have hp := (mkStageTransition M₀ (R₀ a.len) j.1 j.1 j.2.1 j.2.1 j.2.2 le_rfl).2
            have hspec : ∀ {φ : CommRingCat.of (TensorProduct ↥M₀ ↥j.1 (R₀ a.len)) ⟶
                  CommRingCat.of (TensorProduct ↥M₀ ↥j.1 (R₀ a.len))},
                (∀ (m : ↥j.1) (r : R₀ a.len), φ.hom (m ⊗ₜ[↥M₀] r) = m ⊗ₜ[↥M₀] r) →
                AlgebraicGeometry.Spec.map φ =
                  CategoryTheory.CategoryStruct.id
                    (AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct ↥M₀ ↥j.1 (R₀ a.len)))) := by
              intro φ htmul
              have hφ : φ = CategoryTheory.CategoryStruct.id _ := by
                apply CommRingCat.hom_ext
                refine RingHom.ext fun z => ?_
                induction z using TensorProduct.induction_on with
                | zero => exact map_zero φ.hom
                | tmul m r => exact htmul m r
                | add x y ihx ihy => exact (map_add φ.hom x y).trans (congrArg₂ (· + ·) ihx ihy)
              rw [hφ, AlgebraicGeometry.Spec.map_id]
            apply CategoryTheory.MorphismProperty.Over.Hom.ext
            exact hp.trans (hspec (fun _ _ => rfl))
          dsimp
          rw [hid]
          exact ℐ_K.obj.map_id _
        map_comp := fun {j₁ j₂ j₃} u₁ u₂ => by
          ext a : 1
          have hcomp : transK (CategoryTheory.CategoryStruct.comp u₁ u₂) a =
              CategoryTheory.CategoryStruct.comp (transK u₂ a) (transK u₁ a) := by
            let _ : Algebra K ↥j₁.1 :=
              RingHom.toAlgebra ((algebraMap F₀ ↥j₁.1).comp (algebraMap K F₀))
            let _ : Algebra K ↥j₂.1 :=
              RingHom.toAlgebra ((algebraMap F₀ ↥j₂.1).comp (algebraMap K F₀))
            let _ : Algebra K ↥j₃.1 :=
              RingHom.toAlgebra ((algebraMap F₀ ↥j₃.1).comp (algebraMap K F₀))
            let _ : Algebra.Etale K ↥j₁.1 := hEtM j₁.1 j₁.2.1
            let _ : Algebra.Etale K ↥j₂.1 := hEtM j₂.1 j₂.2.1
            let _ : Algebra.Etale K ↥j₃.1 := hEtM j₃.1 j₃.2.1
            let _ : Algebra ↥M₀ ↥j₁.1 :=
              (IntermediateField.inclusion j₁.2.2).toRingHom.toAlgebra
            let _ : Algebra ↥M₀ ↥j₂.1 :=
              (IntermediateField.inclusion j₂.2.2).toRingHom.toAlgebra
            let _ : Algebra ↥M₀ ↥j₃.1 :=
              (IntermediateField.inclusion j₃.2.2).toRingHom.toAlgebra
            have h13 := (mkStageTransition M₀ (R₀ a.len) j₁.1 j₃.1 j₁.2.1 j₃.2.1 j₁.2.2
              (leOfHom (CategoryTheory.CategoryStruct.comp u₁ u₂))).2
            have h23 := (mkStageTransition M₀ (R₀ a.len) j₂.1 j₃.1 j₂.2.1 j₃.2.1 j₂.2.2 (leOfHom u₂)).2
            have h12 := (mkStageTransition M₀ (R₀ a.len) j₁.1 j₂.1 j₁.2.1 j₂.2.1 j₁.2.2 (leOfHom u₁)).2
            have hspec : ∀ {φ₁₃ : CommRingCat.of (TensorProduct ↥M₀ ↥j₁.1 (R₀ a.len)) ⟶
                    CommRingCat.of (TensorProduct ↥M₀ ↥j₃.1 (R₀ a.len))}
                {φ₂₃ : CommRingCat.of (TensorProduct ↥M₀ ↥j₂.1 (R₀ a.len)) ⟶
                    CommRingCat.of (TensorProduct ↥M₀ ↥j₃.1 (R₀ a.len))}
                {φ₁₂ : CommRingCat.of (TensorProduct ↥M₀ ↥j₁.1 (R₀ a.len)) ⟶
                    CommRingCat.of (TensorProduct ↥M₀ ↥j₂.1 (R₀ a.len))},
                (∀ (m₁ : ↥j₁.1) (r : R₀ a.len),
                  φ₁₃.hom (m₁ ⊗ₜ[↥M₀] r) = φ₂₃.hom (φ₁₂.hom (m₁ ⊗ₜ[↥M₀] r))) →
                AlgebraicGeometry.Spec.map φ₁₃ =
                  CategoryTheory.CategoryStruct.comp
                    (AlgebraicGeometry.Spec.map φ₂₃)
                    (AlgebraicGeometry.Spec.map φ₁₂) := by
              intro φ₁₃ φ₂₃ φ₁₂ htmul
              rw [← AlgebraicGeometry.Spec.map_comp]
              congr 1
              apply CommRingCat.hom_ext
              have hhom : φ₁₃.hom = φ₂₃.hom.comp φ₁₂.hom := by
                refine RingHom.ext fun z => ?_
                induction z using TensorProduct.induction_on with
                | zero => simp only [map_zero]
                | tmul m₁ r => exact htmul m₁ r
                | add x y ihx ihy =>
                  simp only [RingHom.comp_apply, map_add] at ihx ihy ⊢
                  rw [ihx, ihy]
              exact hhom
            apply CategoryTheory.MorphismProperty.Over.Hom.ext
            exact h13.trans
              ((hspec (fun _ _ => rfl)).trans
                (congrArg₂ CategoryTheory.CategoryStruct.comp h23.symm h12.symm))
          dsimp
          rw [hcomp]
          exact ℐ_K.obj.map_comp (transK u₁ a).op (transK u₂ a).op }

    let c_pt : CategoryTheory.CosimplicialObject AddCommGrpCat.{u} :=
      { obj := fun a => (P_inf.obj ℐ_K).obj.obj
          (Opposite.op (weilAltCdSpecEtaleObj L_inf (TensorProduct ↥M₀ L_inf (R₀ a.len))))
        map := fun {a b} g => (P_inf.obj ℐ_K).obj.map
          (weilAltCdSpecEtaleMap L_inf
            (Algebra.TensorProduct.map (AlgHom.id L_inf L_inf) (δ₀ g))).op
        map_id := fun a => by
          rw [hδ_id a, Algebra.TensorProduct.map_id, hSpecMapId L_inf _]
          exact (P_inf.obj ℐ_K).obj.map_id _
        map_comp := fun {a b c} g₁ g₂ => by
          have halg : Algebra.TensorProduct.map (AlgHom.id L_inf L_inf)
              (δ₀ (CategoryTheory.CategoryStruct.comp g₁ g₂)) =
            (Algebra.TensorProduct.map (AlgHom.id L_inf L_inf) (δ₀ g₂)).comp
              (Algebra.TensorProduct.map (AlgHom.id L_inf L_inf) (δ₀ g₁)) := by
            rw [hδ_comp g₁ g₂, ← Algebra.TensorProduct.map_comp, AlgHom.id_comp]
          rw [halg, hSpecMapComp L_inf]
          exact (P_inf.obj ℐ_K).obj.map_comp _ _ }

    let c : CategoryTheory.Limits.Cocone F_diag :=
      { pt := c_pt
        ι :=
          { app := fun j =>
              { app := fun a => AddCommGrpCat.ofHom
                  (ι_model ℐ_K M₀ hFD₀ (R₀ a.len) j.1 j.2.1 j.2.2)
                naturality := fun {a b} g => by
                  ext x
                  exact (hModNatAlg ℐ_K M₀ hFD₀ (R₀ a.len) (R₀ b.len) (δ₀ g)
                    j.1 j.2.1 j.2.2 x).symm }
            naturality := fun {j₁ j₂} u => by
              ext a x
              dsimp [F_diag]
              exact hModCompat ℐ_K M₀ hFD₀ (R₀ a.len) j₁.1 j₂.1 j₁.2.1 j₂.2.1
                j₁.2.2 (leOfHom u) (transK u a)
                (mkStageTransition M₀ (R₀ a.len) j₁.1 j₂.1 j₁.2.1 j₂.2.1 j₁.2.2 (leOfHom u)).2 x } }

    have hSurj : ∀ (n : SimplexCategory) (y : ↥(c.pt.obj n)),
        ∃ (j : Idx) (x : ↥((F_diag.obj j).obj n)), ((c.ι.app j).app n).hom x = y := by
      intro n y
      obtain ⟨M, hFD, hle, x, hx⟩ := (hModColim ℐ_K M₀ hFD₀ (R₀ n.len)).1 y
      exact ⟨⟨M, hFD, hle⟩, x, hx⟩

    have hKer : ∀ (n : SimplexCategory) (j₁ : Idx) (x : ↥((F_diag.obj j₁).obj n)),
        ((c.ι.app j₁).app n).hom x = 0 →
        ∃ (j₂ : Idx) (u : j₁ ⟶ j₂), ((F_diag.map u).app n).hom x = 0 := by
      intro n j₁ x hx
      obtain ⟨M₂, hFD₂, hle₁₂, p₁₂, hp₁₂_left, hkill⟩ :=
        (hModColim ℐ_K M₀ hFD₀ (R₀ n.len)).2 j₁.1 j₁.2.1 j₁.2.2 x hx
      let j₂ : Idx := ⟨M₂, hFD₂, le_trans j₁.2.2 hle₁₂⟩
      let u : j₁ ⟶ j₂ := CategoryTheory.homOfLE hle₁₂
      have hp_eq : p₁₂ = transK u n := by
        apply CategoryTheory.MorphismProperty.Comma.Hom.ext
        · exact hp₁₂_left.trans
            (mkStageTransition M₀ (R₀ n.len) j₁.1 M₂ j₁.2.1 hFD₂ j₁.2.2 hle₁₂).2.symm
        · exact Subsingleton.elim _ _
      rw [hp_eq] at hkill
      exact ⟨j₂, u, hkill⟩

    let f_stage : Idx → CategoryTheory.Arrow S_K.Etale :=
      fun j => Classical.choose (h_fM j.1 j.2.1 j.2.2)
    let e_stage : ∀ (j : Idx) (a : SimplexCategory),
        ((f_stage j).cechNerve.obj (Opposite.op a)) ≅ objK j a :=
      fun j => Classical.choose (Classical.choose_spec (h_fM j.1 j.2.1 j.2.2))
    have he_stage : ∀ (j : Idx) {a b : SimplexCategory} (g : a ⟶ b),
        CategoryTheory.CategoryStruct.comp
          ((f_stage j).cechNerve.map g.op) (e_stage j a).hom =
        CategoryTheory.CategoryStruct.comp (e_stage j b).hom (mapK_δ j g) :=
      fun j => Classical.choose_spec (Classical.choose_spec (h_fM j.1 j.2.1 j.2.2))

    let X_alt : Idx → CategoryTheory.CosimplicialObject AddCommGrpCat.{u} := fun j =>
      CategoryTheory.Functor.comp (CategoryTheory.opOp SimplexCategory)
        (CategoryTheory.Functor.comp (f_stage j).cechNerve.op ℐ_K.obj)

    let e_X : ∀ j : Idx, X_alt j ≅ F_diag.obj j := fun j =>
      CategoryTheory.NatIso.ofComponents
        (fun a => ℐ_K.obj.mapIso (e_stage j a).op.symm)
        (fun {a b} g => by
          dsimp [X_alt, F_diag, F_diag_obj]
          have h1 : CategoryTheory.CategoryStruct.comp
              (e_stage j b).inv ((f_stage j).cechNerve.map g.op) =
            CategoryTheory.CategoryStruct.comp
              (mapK_δ j g) (e_stage j a).inv := by
            rw [Iso.inv_comp_eq, ← CategoryTheory.Category.assoc, Iso.eq_comp_inv]
            exact he_stage j g
          rw [← ℐ_K.obj.map_comp, ← ℐ_K.obj.map_comp]
          exact congrArg (fun m => ℐ_K.obj.map m.op) h1)

    let Y_alt : CategoryTheory.CosimplicialObject AddCommGrpCat.{u} :=
      CategoryTheory.Functor.comp (CategoryTheory.opOp SimplexCategory)
        (CategoryTheory.Functor.comp (CategoryTheory.Arrow.mk f).cechNerve.op
          (P_inf.obj ℐ_K).obj)

    let e_Y : Y_alt ≅ c.pt :=
      CategoryTheory.NatIso.ofComponents
        (fun a => (P_inf.obj ℐ_K).obj.mapIso (e_L a).op.symm)
        (fun {a b} g => by
          dsimp [Y_alt, c, c_pt]
          have h1 : CategoryTheory.CategoryStruct.comp
              (e_L b).inv ((CategoryTheory.Arrow.mk f).cechNerve.map g.op) =
            CategoryTheory.CategoryStruct.comp
              (weilAltCdSpecEtaleMap L_inf
                (Algebra.TensorProduct.map (AlgHom.id L_inf L_inf) (δ₀ g)))
              (e_L a).inv := by
            rw [Iso.inv_comp_eq, ← CategoryTheory.Category.assoc, Iso.eq_comp_inv]
            exact he_L g
          rw [← (P_inf.obj ℐ_K).obj.map_comp, ← (P_inf.obj ℐ_K).obj.map_comp]
          exact congrArg (fun m => (P_inf.obj ℐ_K).obj.map m.op) h1)

    exact hCosimpColimExact Idx F_diag c hSurj hKer X_alt e_X Y_alt e_Y p hp
      (fun j => hInjCech S_K ℐ_K (f_stage j) p hp)

theorem weil_alt_cd_spec_field_cech_cartan_acyclicity : (∀ (X : AlgebraicGeometry.Scheme.{u})
        (ℐ : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u})
        [CategoryTheory.Injective ℐ]
        (f : CategoryTheory.Arrow X.Etale) (p : ℕ),
      1 ≤ p →
      (AlgebraicTopology.AlternatingCofaceMapComplex.obj
        (CategoryTheory.Functor.comp (CategoryTheory.opOp SimplexCategory)
          (CategoryTheory.Functor.comp f.cechNerve.op ℐ.obj))).ExactAt p) ∧
    (∀ (L : Type u) [Field L]
        (𝒥 : CategoryTheory.Sheaf
          (AlgebraicGeometry.Spec (CommRingCat.of L)).smallEtaleTopology AddCommGrpCat.{u}),
      (∀ (U W : (AlgebraicGeometry.Spec (CommRingCat.of L)).Etale)
          [AlgebraicGeometry.IsAffine U.left] [AlgebraicGeometry.IsAffine W.left]
          (f : W ⟶ U),
        CategoryTheory.Sieve.generate (CategoryTheory.Presieve.singleton f) ∈
          (AlgebraicGeometry.Spec (CommRingCat.of L)).smallEtaleTopology U →
        ∀ (p : ℕ), 1 ≤ p →
          (AlgebraicTopology.AlternatingCofaceMapComplex.obj
            (CategoryTheory.Functor.comp (CategoryTheory.opOp SimplexCategory)
              (CategoryTheory.Functor.comp (CategoryTheory.Arrow.mk f).cechNerve.op
                𝒥.obj))).ExactAt p) →
      ∀ (r : ℕ), 1 ≤ r → Subsingleton (𝒥.H r)) :=
by
  have hAffU : ∀ (L : Type u) [Field L]
      (U : (AlgebraicGeometry.Spec (CommRingCat.of L)).Etale)
      [CompactSpace ↥U.left],
      AlgebraicGeometry.IsAffine U.left := by
    intro L _ U _
    let S_L : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of L)
    have : AlgebraicGeometry.IsLocallyArtinian U.left := by
      refine AlgebraicGeometry.IsLocallyArtinian.mk (fun V => ?_)
      let A_V : Type u := ↑(U.left.presheaf.obj (Opposite.op V.1))
      let U_top : ↑S_L.affineOpens := ⟨⊤, AlgebraicGeometry.isAffineOpen_top S_L⟩
      let g : U.left ⟶ S_L := U.hom
      have hg : AlgebraicGeometry.Etale g := U.prop
      have hle : V.1 ≤ (TopologicalSpace.Opens.map g.base).obj U_top.1 :=
        fun _ _ => trivial
      have hEt_top : RingHom.Etale (g.appLE U_top.1 V.1 hle).hom :=
        AlgebraicGeometry.HasRingHomProperty.appLE (@AlgebraicGeometry.Etale) g hg U_top V hle
      let e_L : L ≃+* ↑(S_L.presheaf.obj (Opposite.op U_top.1)) :=
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of L)).symm.commRingCatIsoToRingEquiv
      let φ : L →+* A_V := (g.appLE U_top.1 V.1 hle).hom.comp e_L.toRingHom
      have hEt_φ : RingHom.Etale φ :=
        RingHom.Etale.respectsIso.right _ e_L hEt_top
      letI : Algebra L A_V := φ.toAlgebra
      have : IsScalarTower L A_V A_V := IsScalarTower.right
      have hAlgEt : Algebra.Etale L A_V := RingHom.etale_algebraMap.mp hEt_φ
      rcases (Algebra.Etale.iff_exists_algEquiv_prod L A_V).mp hAlgEt with
        ⟨I, hFinI, E_fam, hField_fam, hAlg_fam, e_prod, hFinSep⟩
      letI := hFinI
      letI := hField_fam
      letI := hAlg_fam
      have : ∀ i : I, Module.Finite L (E_fam i) := fun i => (hFinSep i).1
      have : Module.Finite L ((i : I) → E_fam i) := inferInstance
      let e_lin : ((i : I) → E_fam i) ≃ₗ[L] A_V :=
        e_prod.symm.toEquiv.toLinearEquiv
          { map_add := e_prod.symm.map_add'
            map_smul := fun c x => by
              have hcx : c • x = (fun i => algebraMap L (E_fam i) c) * x := by
                ext i
                exact Algebra.smul_def c (x i)
              exact (congrArg e_prod.symm hcx).trans
                ((e_prod.symm.map_mul' _ x).trans
                  ((congrArg (· * e_prod.symm x) (e_prod.symm.commutes' c)).trans
                    (Algebra.smul_def c (e_prod.symm x)).symm)) }
      have : Module.Finite L A_V := Module.Finite.equiv e_lin
      exact isArtinian_of_tower L (inferInstance : IsArtinian L A_V)
    have : AlgebraicGeometry.IsArtinianScheme U.left := AlgebraicGeometry.IsArtinianScheme.mk
    exact inferInstance
  refine ⟨?_, ?_⟩
  · intro X ℐ _ f p hp
    exact weil_alt_cd_injective_sheaf_cech_exactAt X ℐ f p hp
  · intro L _ 𝒥 hCech_aff r hr
    let S_L : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of L)
    refine weil_alt_cd_cartan_cech_acyclicity_sheaf_cohomology_vanishing S_L
      (fun U _ _ => weil_alt_cd_qcsep_single_affine_etale_cover_and_nerve S_L U)
      (fun ℐ _ f p hp => weil_alt_cd_injective_sheaf_cech_exactAt S_L ℐ f p hp)
      𝒥 (fun U _ _ W _ f hf p hp => ?_) r hr
    have : AlgebraicGeometry.IsAffine U.left := hAffU L U
    exact hCech_aff U W f hf p hp

theorem weil_alt_cd_cofiltered_etale_field_union_vanishing (K : Type u) [Field K] (s ℓ : ℕ)
    (G : CategoryTheory.Sheaf
      (AlgebraicGeometry.Spec (CommRingCat.of K)).smallEtaleTopology AddCommGrpCat.{u})
    (hℓ : ℓ • CategoryTheory.CategoryStruct.id G = 0) :
    (∀ (N : ℕ) (R : Fin N → Type u) [∀ a, CommRing (R a)] [∀ a, Algebra K (R a)]
        [∀ a, Algebra.Etale K (R a)] [Algebra.Etale K (∀ a : Fin N, R a)]
        (ξ : ↥((G.cohomologyPresheaf s).obj
          (Opposite.op (weilAltCdSpecEtaleObj K (∀ a : Fin N, R a))))),
      (∀ a : Fin N,
        (G.cohomologyPresheaf s).map
          (weilAltCdSpecEtaleMap K (Pi.evalAlgHom K R a)).op ξ = 0) →
      ξ = 0) ∧
    (∀ (F₀ L_inf : Type u) [Field F₀] [Field L_inf] [Algebra K F₀]
        [FiniteDimensional K F₀] [Algebra.IsSeparable K F₀] [Algebra.Etale K F₀]
        [Algebra F₀ L_inf] [Algebra.IsSeparable F₀ L_inf],
      (∀ (G_inf : CategoryTheory.Sheaf
          (AlgebraicGeometry.Spec (CommRingCat.of L_inf)).smallEtaleTopology AddCommGrpCat.{u}),
        ℓ • CategoryTheory.CategoryStruct.id G_inf = 0 →
        Subsingleton (G_inf.H s)) →
      ∀ (ξ : ↥((G.cohomologyPresheaf s).obj (Opposite.op (weilAltCdSpecEtaleObj K F₀)))),
        ∃ (M : IntermediateField F₀ L_inf),
          FiniteDimensional F₀ ↥M ∧
          ∀ (E : Type u) [Field E] [Algebra K E] [Algebra F₀ E] [IsScalarTower K F₀ E]
            [Algebra.Etale K E],
            Nonempty (↥M →ₐ[F₀] E) →
            (G.cohomologyPresheaf s).map
              (weilAltCdSpecEtaleMap K (IsScalarTower.toAlgHom K F₀ E)).op ξ = 0) :=
by
  let S_K : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of K)
  let J_K := S_K.smallEtaleTopology
  let F_free : CategoryTheory.Functor S_K.Etale
      (CategoryTheory.Sheaf J_K AddCommGrpCat.{u}) :=
    CategoryTheory.Functor.comp CategoryTheory.yoneda
      (CategoryTheory.Functor.comp
        ((CategoryTheory.Functor.whiskeringRight (S_K.Etale)ᵒᵖ (Type u) AddCommGrpCat.{u}).obj
          AddCommGrpCat.free)
