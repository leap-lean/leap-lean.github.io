theorem weil_alt_cd_subfield_colimit_succ_step (q : ℕ)
    (ih : WeilSubfieldSheafColimitAt.{u} q) :
    WeilSubfieldSheafColimitAt.{u} (q + 1) :=
by
  obtain ⟨hSiteEx, hPullExUniq, hPullMap, hPullSES, hCompIso⟩ :=
    weil_alt_cd_general_pullH_functoriality_and_exact_nat.{u}
  have hPostInv : ∀ {𝒞 : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} 𝒞]
      [CategoryTheory.Abelian 𝒞] [CategoryTheory.HasExt.{u} 𝒞]
      {X Y Z : 𝒞} (f : Quiver.Hom Y Z) (g : Quiver.Hom Z Y) (r : ℕ),
      CategoryTheory.CategoryStruct.comp f g = CategoryTheory.CategoryStruct.id Y →
      ∀ y : CategoryTheory.Abelian.Ext.{u} X Y r,
        ((CategoryTheory.Abelian.Ext.mk₀ g).postcomp X (Nat.add_zero r))
          (((CategoryTheory.Abelian.Ext.mk₀ f).postcomp X (Nat.add_zero r)) y) = y := by
    intro 𝒞 _ _ _ X Y Z f g r hfg y
    change (y.comp (CategoryTheory.Abelian.Ext.mk₀ f) (Nat.add_zero r)).comp
      (CategoryTheory.Abelian.Ext.mk₀ g) (Nat.add_zero r) = y
    rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hfg,
      CategoryTheory.Abelian.Ext.comp_mk₀_id]
