  have hα_fin_tmul : ∀ (k : K) (c₀ : C₀) (p : P_fin),
      α_fin (k ⊗ₜ[B] (c₀ ⊗ₜ[P] p)) = (k ⊗ₜ[B] c₀) ⊗ₜ[F₀] ι_fin p := by
    intro k c₀ p
    dsimp only [α_fin, AlgEquiv.trans_apply]
    rw [Algebra.TensorProduct.assoc_symm_tmul,
