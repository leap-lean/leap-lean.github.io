          · exact hsnd_eq
        let a_u := u'_push.map (adj_hK.unit.app 𝒢')
        let b_e := e_push.hom.app Y_L
        let c_h := h'_L_push.map ((adj_MB_L.homEquiv (u_L_push.obj Y_L) ((T_τL i).obj Y_L)) π_L)
