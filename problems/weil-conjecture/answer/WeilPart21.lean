  have : G.IsCoverDense J₂ := by
    refine ⟨fun U => ?_⟩
    have hJ₂ :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) S₂ le_rfl
    change CategoryTheory.Sieve.coverByImage G U ∈
      AlgebraicGeometry.Scheme.smallGrothendieckTopology (@AlgebraicGeometry.Etale) S₂ U
    rw [hJ₂]
    refine (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology U _).mpr (fun y => ?_)
    have hy_top : y ∈ (⊤ : U.left.Opens) := trivial
    obtain ⟨V, hV, hyV, _⟩ := AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hy_top
    let R_V : CommRingCat.{u} := U.left.presheaf.obj (Opposite.op V)
    let φ_V : AlgebraicGeometry.Spec R_V ⟶ U.left := hV.fromSpec
    have hy_range : y ∈ Set.range φ_V := by
      rw [hV.range_fromSpec]
      exact hyV
    obtain ⟨z₀, hz₀⟩ := hy_range
    let u_hom : Quiver.Hom U.left S₂ := U.hom
    have : AlgebraicGeometry.Etale u_hom := U.prop
    let g_aff : AlgebraicGeometry.Scheme.Spec.obj (Opposite.op R_V) ⟶ S₂ := φ_V ≫ u_hom
    have hEt_comp : AlgebraicGeometry.Etale g_aff :=
      inferInstanceAs (AlgebraicGeometry.Etale (φ_V ≫ u_hom))
    let A_y : S₂.AffineEtale :=
      CategoryTheory.MorphismProperty.CostructuredArrow.mk
        (P := @AlgebraicGeometry.Etale) (F := AlgebraicGeometry.Scheme.Spec) ⊤ g_aff hEt_comp
    let m_y : M_aff := eq_aff.functor.obj A_y
    let e_aff : A_y ≅ eq_aff.inverse.obj m_y := eq_aff.unitIso.app A_y
    let d_y : D := ⟨0, Sum.inr m_y⟩
    let e_op : Opposite.op R_V ≅ (eq_aff.inverse.obj m_y).left :=
      { hom := e_aff.hom.left
        inv := e_aff.inv.left
        hom_inv_id := congrArg (fun u => u.left) e_aff.hom_inv_id
        inv_hom_id := congrArg (fun u => u.left) e_aff.inv_hom_id }
    let e_sch : AlgebraicGeometry.Scheme.Spec.obj (Opposite.op R_V) ≅
        AlgebraicGeometry.Scheme.Spec.obj (eq_aff.inverse.obj m_y).left :=
      AlgebraicGeometry.Scheme.Spec.mapIso e_op
    let v_left : AlgebraicGeometry.Scheme.Spec.obj (eq_aff.inverse.obj m_y).left ⟶ U.left :=
      e_sch.inv ≫ φ_V
    have hEt_v : AlgebraicGeometry.Etale v_left := inferInstance
    have hv_w : v_left ≫ u_hom = (eq_aff.inverse.obj m_y).hom :=
      (CategoryTheory.Category.assoc e_sch.inv φ_V u_hom).trans
        (e_aff.inv.w.trans (CategoryTheory.Category.comp_id _))
    let v_et : G.obj d_y ⟶ U := CategoryTheory.MorphismProperty.Over.homMk v_left hv_w trivial
    have hmem : (CategoryTheory.Sieve.coverByImage G U).arrows v_et :=
      CategoryTheory.Presieve.in_coverByImage G v_et
    have hv_comp : e_sch.hom ≫ v_left = φ_V :=
      (CategoryTheory.Category.assoc e_sch.hom e_sch.inv φ_V).symm.trans
        ((congrArg (· ≫ φ_V) e_sch.hom_inv_id).trans (CategoryTheory.Category.id_comp φ_V))
    have hv_pt : v_left (e_sch.hom z₀) = y :=
      (AlgebraicGeometry.Scheme.Hom.comp_apply e_sch.hom v_left z₀).symm.trans
        ((congrArg (fun k : AlgebraicGeometry.Spec R_V ⟶ U.left => k z₀) hv_comp).trans hz₀)
    exact ⟨G.obj d_y, v_et, e_sch.hom z₀, hmem, hEt_v, hv_pt⟩

  
  let A := AddCommGrpCat.{u}
  let K₂ := G.inducedTopology J₂
  have : CategoryTheory.Functor.IsDenseSubsite K₂ J₂ G := inferInstance
  have : G.IsContinuous K₂ J₂ := inferInstance
