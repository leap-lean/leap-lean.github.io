                  rw [natCast_zsmul, hpξ, zsmul_zero, natCast_zsmul, hd₁ξ, zsmul_zero, add_zero]
        have hGenTors : ∀ (m : ℕ), 1 ≤ m →
            ∀ (E : Type u) [Field E] [Algebra K E]
              [FiniteDimensional K E] [Algebra.IsSeparable K E]
              (L : Type u) [Field L] [Algebra E L] [FiniteDimensional E L] [IsGalois E L]
              (ξ : (weilC1AffEtGmSheaf E (hGm E)).H q),
              m • ξ = 0 →
              @res E L _ _ _ _ (@IsGalois.to_isSeparable E _ L _ _ _) q ξ = 0 →
              ξ = 0 := by
          intro m
          induction m using Nat.strongRecOn with
