              exact (ne_of_gt hBotLt) hEqBot
            let _ : Fintype ↥(Subgroup.center Γ₁) := Fintype.ofFinite ↥(Subgroup.center Γ₁)
            have hdvdZ : p ∣ Fintype.card ↥(Subgroup.center Γ₁) := by
              rw [← Nat.card_eq_fintype_card, hc]
              exact dvd_pow_self p hc_ne
            obtain ⟨z₀, hz₀⟩ := exists_prime_orderOf_dvd_card p hdvdZ
            let σ₀ : Γ₁ := z₀.1
            have hord_σ₀ : orderOf σ₀ = p := by
              rw [← Subgroup.orderOf_mk, ← hz₀]
            let C : Subgroup Γ₁ := Subgroup.zpowers σ₀
            have hC_le : C ≤ Subgroup.center Γ₁ := by
              rw [Subgroup.zpowers_le]
