    obtain ⟨e_pb_L, h_fst_L, h_snd_L⟩ := h_pb a b L_inf
    let π_L_fst := weilAltCdSpecEtaleMap L_inf
      (Algebra.TensorProduct.map (AlgHom.id L_inf L_inf) (π₁_fst a b))
    let π_L_snd := weilAltCdSpecEtaleMap L_inf
      (Algebra.TensorProduct.map (AlgHom.id L_inf L_inf) (π₁_snd a b))
    have hπ_L_comm : CategoryTheory.CategoryStruct.comp π_L_fst (p_L a) =
        CategoryTheory.CategoryStruct.comp π_L_snd (p_L b) := by
      have h1 : π_L_fst = CategoryTheory.CategoryStruct.comp e_pb_L.inv
          (CategoryTheory.Limits.pullback.fst (p_L a) (p_L b)) := by
        rw [h_fst_L, e_pb_L.inv_hom_id_assoc]
      have h2 : π_L_snd = CategoryTheory.CategoryStruct.comp e_pb_L.inv
          (CategoryTheory.Limits.pullback.snd (p_L a) (p_L b)) := by
        rw [h_snd_L, e_pb_L.inv_hom_id_assoc]
      rw [h1, h2, CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
        CategoryTheory.Category.assoc]
    let r₁ : Z_C ⟶ V a :=
      ff_G.preimage (CategoryTheory.CategoryStruct.comp i_ZC.hom
        (CategoryTheory.CategoryStruct.comp π_L_fst (e_V a).inv))
    let r₂ : Z_C ⟶ V b :=
      ff_G.preimage (CategoryTheory.CategoryStruct.comp i_ZC.hom
        (CategoryTheory.CategoryStruct.comp π_L_snd (e_V b).inv))
    have hr_comm : CategoryTheory.CategoryStruct.comp r₁ (p a) =
        CategoryTheory.CategoryStruct.comp r₂ (p b) := by
      apply ff_G.map_injective
      rw [G_L.map_comp, G_L.map_comp, ff_G.map_preimage, ff_G.map_preimage,
        ← CategoryTheory.cancel_mono e_Y.hom]
      have hc1 : CategoryTheory.CategoryStruct.comp (e_V a).inv
          (CategoryTheory.CategoryStruct.comp (G_L.map (p a)) e_Y.hom) = p_L a := by
        rw [he_comm_L a, (e_V a).inv_hom_id_assoc]
      have hc2 : CategoryTheory.CategoryStruct.comp (e_V b).inv
          (CategoryTheory.CategoryStruct.comp (G_L.map (p b)) e_Y.hom) = p_L b := by
        rw [he_comm_L b, (e_V b).inv_hom_id_assoc]
      simp only [CategoryTheory.Category.assoc]
      rw [hc1, hc2, hπ_L_comm]
    let u_to : Z_C ⟶ CategoryTheory.Limits.pullback (p a) (p b) :=
      CategoryTheory.Limits.pullback.lift r₁ r₂ hr_comm
    let q₁ := CategoryTheory.CategoryStruct.comp
      (G_L.map (CategoryTheory.Limits.pullback.fst (p a) (p b))) (e_V a).hom
    let q₂ := CategoryTheory.CategoryStruct.comp
      (G_L.map (CategoryTheory.Limits.pullback.snd (p a) (p b))) (e_V b).hom
    have hq_comm : CategoryTheory.CategoryStruct.comp q₁ (p_L a) =
        CategoryTheory.CategoryStruct.comp q₂ (p_L b) := by
      dsimp [q₁, q₂]
      rw [CategoryTheory.Category.assoc, ← he_comm_L a, ← CategoryTheory.Category.assoc,
        ← G_L.map_comp, CategoryTheory.Limits.pullback.condition, G_L.map_comp,
        CategoryTheory.Category.assoc, he_comm_L b, CategoryTheory.Category.assoc]
    let q_lift := CategoryTheory.Limits.pullback.lift q₁ q₂ hq_comm
    let u_from : CategoryTheory.Limits.pullback (p a) (p b) ⟶ Z_C :=
      ff_G.preimage (CategoryTheory.CategoryStruct.comp q_lift
        (CategoryTheory.CategoryStruct.comp e_pb_L.hom i_ZC.inv))
    have h_from_to : CategoryTheory.CategoryStruct.comp u_from u_to =
        CategoryTheory.CategoryStruct.id (CategoryTheory.Limits.pullback (p a) (p b)) := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.lift_fst]
        apply ff_G.map_injective
        rw [G_L.map_comp, ff_G.map_preimage, ff_G.map_preimage]
        simp only [CategoryTheory.Category.assoc, Iso.inv_hom_id_assoc]
        have hf : CategoryTheory.CategoryStruct.comp e_pb_L.hom
            (CategoryTheory.CategoryStruct.comp π_L_fst (e_V a).inv) =
            CategoryTheory.CategoryStruct.comp
              (CategoryTheory.Limits.pullback.fst (p_L a) (p_L b)) (e_V a).inv := by
          rw [← CategoryTheory.Category.assoc, ← h_fst_L]
        rw [hf, ← CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.lift_fst q₁ q₂ hq_comm]
        dsimp [q₁]
        rw [CategoryTheory.Category.assoc, (e_V a).hom_inv_id, CategoryTheory.Category.comp_id]
      · rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.lift_snd]
        apply ff_G.map_injective
        rw [G_L.map_comp, ff_G.map_preimage, ff_G.map_preimage]
        simp only [CategoryTheory.Category.assoc, Iso.inv_hom_id_assoc]
        have hs : CategoryTheory.CategoryStruct.comp e_pb_L.hom
            (CategoryTheory.CategoryStruct.comp π_L_snd (e_V b).inv) =
            CategoryTheory.CategoryStruct.comp
              (CategoryTheory.Limits.pullback.snd (p_L a) (p_L b)) (e_V b).inv := by
          rw [← CategoryTheory.Category.assoc, ← h_snd_L]
        rw [hs, ← CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.lift_snd q₁ q₂ hq_comm]
        dsimp [q₂]
        rw [CategoryTheory.Category.assoc, (e_V b).hom_inv_id, CategoryTheory.Category.comp_id]
    have h_to_from : CategoryTheory.CategoryStruct.comp u_to u_from =
        CategoryTheory.CategoryStruct.id Z_C := by
      apply ff_G.map_injective
      rw [G_L.map_comp, G_L.map_id, ff_G.map_preimage,
        ← CategoryTheory.cancel_mono i_ZC.hom, CategoryTheory.Category.id_comp]
      simp only [CategoryTheory.Category.assoc, Iso.inv_hom_id, CategoryTheory.Category.comp_id]
      rw [← CategoryTheory.cancel_mono e_pb_L.inv]
      simp only [CategoryTheory.Category.assoc, Iso.hom_inv_id, CategoryTheory.Category.comp_id]
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst]
        dsimp [q₁]
        rw [← CategoryTheory.Category.assoc, ← G_L.map_comp,
          CategoryTheory.Limits.pullback.lift_fst r₁ r₂ hr_comm, ff_G.map_preimage]
        simp only [CategoryTheory.Category.assoc, Iso.inv_hom_id, CategoryTheory.Category.comp_id]
        rw [h_fst_L, e_pb_L.inv_hom_id_assoc]
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd]
        dsimp [q₂]
        rw [← CategoryTheory.Category.assoc, ← G_L.map_comp,
          CategoryTheory.Limits.pullback.lift_snd r₁ r₂ hr_comm, ff_G.map_preimage]
        simp only [CategoryTheory.Category.assoc, Iso.inv_hom_id, CategoryTheory.Category.comp_id]
        rw [h_snd_L, e_pb_L.inv_hom_id_assoc]
    let iso_aff : CategoryTheory.Limits.pullback (p a) (p b) ≅ Z_C :=
      { hom := u_from, inv := u_to, hom_inv_id := h_from_to, inv_hom_id := h_to_from }
    let e_VV := G_L.mapIso iso_aff ≪≫ i_ZC
    refine ⟨e_VV, ?_, ?_⟩
    · dsimp [e_VV, iso_aff]
      rw [CategoryTheory.Category.assoc, ff_G.map_preimage]
      simp only [CategoryTheory.Category.assoc, Iso.inv_hom_id_assoc]
      rw [← h_fst_L, CategoryTheory.Limits.pullback.lift_fst]
    · dsimp [e_VV, iso_aff]
      rw [CategoryTheory.Category.assoc, ff_G.map_preimage]
      simp only [CategoryTheory.Category.assoc, Iso.inv_hom_id_assoc]
      rw [← h_snd_L, CategoryTheory.Limits.pullback.lift_snd]

  let e_VV : ∀ a b : Fin m,
      G_L.obj (CategoryTheory.Limits.pullback (p a) (p b)) ≅
        weilAltCdSpecEtaleObj L_inf (TensorProduct ↥M₁ L_inf (C₁ a b)) :=
    fun a b => Classical.choose (hVV_pkg a b)
  have he_VV : ∀ a b : Fin m,
      CategoryTheory.CategoryStruct.comp
        (G_L.map (CategoryTheory.Limits.pullback.fst (p a) (p b))) (e_V a).hom =
        CategoryTheory.CategoryStruct.comp (e_VV a b).hom
          (weilAltCdSpecEtaleMap L_inf
            (Algebra.TensorProduct.map (AlgHom.id L_inf L_inf) (π₁_fst a b))) ∧
      CategoryTheory.CategoryStruct.comp
        (G_L.map (CategoryTheory.Limits.pullback.snd (p a) (p b))) (e_V b).hom =
        CategoryTheory.CategoryStruct.comp (e_VV a b).hom
          (weilAltCdSpecEtaleMap L_inf
            (Algebra.TensorProduct.map (AlgHom.id L_inf L_inf) (π₁_snd a b))) :=
    fun a b => Classical.choose_spec (hVV_pkg a b)

  have hJointL : ∀ x : PrimeSpectrum (TensorProduct ↥M₁ L_inf A₁),
      ∃ a : Fin m,
        x ∈ Set.range
          (PrimeSpectrum.comap
            (Algebra.TensorProduct.map (AlgHom.id L_inf L_inf) (φ₁ a)).toRingHom) := by
    intro x
    obtain ⟨a, y_inf, hy_inf⟩ := hJoint_inf (PrimeSpectrum.comap α_A.symm.toRingHom x)
    refine ⟨a, PrimeSpectrum.comap (α_B a).toRingHom y_inf, ?_⟩
    have h1 := congrFun
      (PrimeSpectrum.comap_comp
        (Algebra.TensorProduct.map (AlgHom.id L_inf L_inf) (φ₁ a)).toRingHom
        (α_B a).toRingHom) y_inf
    dsimp only [Function.comp_apply] at h1
    rw [← h1]
    have hring : (α_B a).toRingHom.comp
        (Algebra.TensorProduct.map (AlgHom.id L_inf L_inf) (φ₁ a)).toRingHom =
        (ψ_inf a).toRingHom.comp α_A.toRingHom :=
      congrArg AlgHom.toRingHom (hComm_alg a)
    rw [hring]
    have h2 := congrFun
      (PrimeSpectrum.comap_comp α_A.toRingHom (ψ_inf a).toRingHom) y_inf
    dsimp only [Function.comp_apply] at h2
    rw [h2, hy_inf]
    have h3 := congrFun
      (PrimeSpectrum.comap_comp α_A.toRingHom α_A.symm.toRingHom) x
    dsimp only [Function.comp_apply] at h3
    rw [← h3]
    have hid : α_A.symm.toRingHom.comp α_A.toRingHom = RingHom.id _ :=
      RingHom.ext α_A.symm_apply_apply
    rw [hid]
    exact congrFun PrimeSpectrum.comap_id x

  refine ⟨m, V, p, M₁, hFD₁, A₁, inferInstance, inferInstance, inferInstance,
    B₁, inferInstance, inferInstance, inferInstance,
    C₁, inferInstance, inferInstance, inferInstance,
    φ₁, π₁_fst, π₁_snd,
    hSubR, hMemAff, ⟨e_Y, e_V, e_VV, he_comm_L, he_VV⟩, ?_⟩
  intro M hle
  let _ : Algebra ↥M₁ ↥M := (IntermediateField.inclusion hle).toRingHom.toAlgebra
  refine ⟨hSurjCover ↥M₁ L_inf m A₁ B₁ φ₁
      (fun B₀ _ _ φ₀ h => hDescSurj M₁ hFD₁ A₁ B₀ φ₀ h) hJointL ↥M,
    fun a b => h_pb a b ↥M⟩

theorem weil_alt_cd_affine_baseChange_hom_bijection (K L : Type u) [Field K] [Field L] (ρ : K →+* L) :
    let S_K := AlgebraicGeometry.Spec (CommRingCat.of K)
    let S_L := AlgebraicGeometry.Spec (CommRingCat.of L)
    let h : S_L ⟶ S_K := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ)
    let G_K := AlgebraicGeometry.Scheme.AffineEtale.Spec S_K
    let G_L := AlgebraicGeometry.Scheme.AffineEtale.Spec S_L
    let B_site := weilAltCdSitePullback h
    ∃ (F_BC : CategoryTheory.Functor S_K.AffineEtale S_L.AffineEtale)
      (η_BC : CategoryTheory.Functor.comp F_BC G_L ≅
        CategoryTheory.Functor.comp G_K B_site)
      (homEquiv : ∀ (Y : S_L.AffineEtale) (X : S_K.AffineEtale),
        (Y ⟶ F_BC.obj X) ≃
          { φ : X.left.unop ⟶ Y.left.unop //
            CategoryTheory.CategoryStruct.comp (AlgebraicGeometry.Spec.preimage X.hom) φ =
              CategoryTheory.CategoryStruct.comp (CommRingCat.ofHom ρ)
                (AlgebraicGeometry.Spec.preimage Y.hom) }),
      (∀ {Y' Y : S_L.AffineEtale} (g : Y' ⟶ Y) (X : S_K.AffineEtale)
          (u : Y ⟶ F_BC.obj X),
        (homEquiv Y' X (CategoryTheory.CategoryStruct.comp g u)).1 =
          CategoryTheory.CategoryStruct.comp (homEquiv Y X u).1 g.left.unop) ∧
      (∀ (Y : S_L.AffineEtale) {X X' : S_K.AffineEtale} (v : X ⟶ X')
          (u : Y ⟶ F_BC.obj X),
        (homEquiv Y X' (CategoryTheory.CategoryStruct.comp u (F_BC.map v))).1 =
          CategoryTheory.CategoryStruct.comp v.left.unop (homEquiv Y X u).1) :=
by
  intro S_K S_L h G_K G_L B_site
  let W_X : S_K.AffineEtale → S_L.Etale := fun X => B_site.obj (G_K.obj X)
  have hAff : ∀ X : S_K.AffineEtale, AlgebraicGeometry.IsAffine (W_X X).left := by
    intro X
    let f_X : AlgebraicGeometry.Spec X.left.unop ⟶ S_K := X.hom
    have hf_X : AlgebraicGeometry.IsAffineHom f_X :=
      AlgebraicGeometry.isAffineHom_of_isAffine f_X
    have hsnd : AlgebraicGeometry.IsAffineHom (CategoryTheory.Limits.pullback.snd f_X h) :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback f_X h) hf_X
    exact @AlgebraicGeometry.isAffine_of_isAffineHom _ _
      (CategoryTheory.Limits.pullback.snd f_X h) hsnd inferInstance
  let iso_X := fun X : S_K.AffineEtale => @AlgebraicGeometry.Scheme.isoSpec (W_X X).left (hAff X)
  let F_BC_obj : S_K.AffineEtale → S_L.AffineEtale := fun X =>
    letI : AlgebraicGeometry.Etale (W_X X).hom := (W_X X).prop
    CategoryTheory.MorphismProperty.CostructuredArrow.mk
      (P := @AlgebraicGeometry.Etale) (F := AlgebraicGeometry.Scheme.Spec) ⊤
      ((iso_X X).inv ≫ (W_X X).hom) inferInstance
  let η_app : ∀ X : S_K.AffineEtale, G_L.obj (F_BC_obj X) ≅ W_X X := fun X =>
    CategoryTheory.MorphismProperty.Over.isoMk (iso_X X).symm rfl
  let F_BC : CategoryTheory.Functor S_K.AffineEtale S_L.AffineEtale :=
    { obj := F_BC_obj
      map := fun {X X'} v =>
        G_L.preimage ((η_app X).hom ≫ B_site.map (G_K.map v) ≫ (η_app X').inv)
      map_id := fun X => by
        apply G_L.map_injective
        rw [G_L.map_preimage, G_K.map_id, B_site.map_id, CategoryTheory.Category.id_comp,
          (η_app X).hom_inv_id, G_L.map_id]
      map_comp := fun {X₁ X₂ X₃} v₁ v₂ => by
        apply G_L.map_injective
        rw [G_L.map_preimage, G_L.map_comp, G_L.map_preimage, G_L.map_preimage,
          G_K.map_comp, B_site.map_comp]
        simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id_assoc] }
  let η_BC : CategoryTheory.Functor.comp F_BC G_L ≅ CategoryTheory.Functor.comp G_K B_site :=
    CategoryTheory.NatIso.ofComponents η_app (fun {X X'} v => by
      dsimp only [CategoryTheory.Functor.comp_obj, CategoryTheory.Functor.comp_map, F_BC]
      rw [G_L.map_preimage]
      simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id,
        CategoryTheory.Category.comp_id])
  let homEquiv : ∀ (Y : S_L.AffineEtale) (X : S_K.AffineEtale),
      (Y ⟶ F_BC.obj X) ≃
        { φ : X.left.unop ⟶ Y.left.unop //
          CategoryTheory.CategoryStruct.comp (AlgebraicGeometry.Spec.preimage X.hom) φ =
            CategoryTheory.CategoryStruct.comp (CommRingCat.ofHom ρ)
              (AlgebraicGeometry.Spec.preimage Y.hom) } := fun Y X =>
    let e1 : (Y ⟶ F_BC.obj X) ≃ (G_L.obj Y ⟶ G_L.obj (F_BC.obj X)) :=
      { toFun := fun u => G_L.map u
        invFun := fun w => G_L.preimage w
        left_inv := fun u => G_L.preimage_map u
        right_inv := fun w => G_L.map_preimage w }
    let e2 : (G_L.obj Y ⟶ G_L.obj (F_BC.obj X)) ≃ (G_L.obj Y ⟶ W_X X) :=
      { toFun := fun w => w ≫ (η_app X).hom
        invFun := fun z => z ≫ (η_app X).inv
        left_inv := fun w => by simp
        right_inv := fun z => by simp }
    let e3 : (G_L.obj Y ⟶ W_X X) ≃
        { q : AlgebraicGeometry.Spec Y.left.unop ⟶ AlgebraicGeometry.Spec X.left.unop //
          q ≫ X.hom = Y.hom ≫ h } :=
      { toFun := fun z =>
          let z_left : AlgebraicGeometry.Spec Y.left.unop ⟶
              CategoryTheory.Limits.pullback X.hom h := z.left
          ⟨z_left ≫ CategoryTheory.Limits.pullback.fst X.hom h,
            (CategoryTheory.Category.assoc z_left _ X.hom).trans
              ((congrArg (z_left ≫ ·) CategoryTheory.Limits.pullback.condition).trans
                ((CategoryTheory.Category.assoc z_left _ h).symm.trans
                  (congrArg (· ≫ h) (CategoryTheory.MorphismProperty.Over.w z))))⟩
        invFun := fun q =>
          CategoryTheory.MorphismProperty.Over.homMk
            (CategoryTheory.Limits.pullback.lift q.1 Y.hom q.2)
            (CategoryTheory.Limits.pullback.lift_snd q.1 Y.hom q.2) trivial
        left_inv := fun z => by
          apply CategoryTheory.MorphismProperty.Comma.Hom.ext
          · apply CategoryTheory.Limits.pullback.hom_ext
            · exact CategoryTheory.Limits.pullback.lift_fst _ _ _
            · exact (CategoryTheory.Limits.pullback.lift_snd _ _ _).trans
                (CategoryTheory.MorphismProperty.Over.w z).symm
          · exact Subsingleton.elim _ _
        right_inv := fun q => Subtype.ext (CategoryTheory.Limits.pullback.lift_fst q.1 Y.hom q.2) }
    let e4 :
        { q : AlgebraicGeometry.Spec Y.left.unop ⟶ AlgebraicGeometry.Spec X.left.unop //
          q ≫ X.hom = Y.hom ≫ h } ≃
        { φ : X.left.unop ⟶ Y.left.unop //
          CategoryTheory.CategoryStruct.comp (AlgebraicGeometry.Spec.preimage X.hom) φ =
            CategoryTheory.CategoryStruct.comp (CommRingCat.ofHom ρ)
              (AlgebraicGeometry.Spec.preimage Y.hom) } :=
      { toFun := fun q =>
          ⟨AlgebraicGeometry.Spec.preimage q.1, by
            apply AlgebraicGeometry.Spec.map_injective
            rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp,
              AlgebraicGeometry.Spec.map_preimage, AlgebraicGeometry.Spec.map_preimage,
              AlgebraicGeometry.Spec.map_preimage]
            exact q.2⟩
        invFun := fun φ =>
          ⟨AlgebraicGeometry.Spec.map φ.1, by
            have hφ := congrArg AlgebraicGeometry.Spec.map φ.2
            rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp,
              AlgebraicGeometry.Spec.map_preimage, AlgebraicGeometry.Spec.map_preimage] at hφ
            exact hφ⟩
        left_inv := fun q => Subtype.ext (AlgebraicGeometry.Spec.map_preimage q.1)
        right_inv := fun φ => Subtype.ext (AlgebraicGeometry.Spec.preimage_map φ.1) }
    ((e1.trans e2).trans e3).trans e4
  refine ⟨F_BC, η_BC, homEquiv, ?_, ?_⟩
  · intro Y' Y g X u
    apply AlgebraicGeometry.Spec.map_injective
    change AlgebraicGeometry.Spec.map (AlgebraicGeometry.Spec.preimage
        ((G_L.map (g ≫ u) ≫ (η_app X).hom).left ≫ CategoryTheory.Limits.pullback.fst X.hom h)) =
      AlgebraicGeometry.Spec.map
        (AlgebraicGeometry.Spec.preimage
          ((G_L.map u ≫ (η_app X).hom).left ≫ CategoryTheory.Limits.pullback.fst X.hom h) ≫
          g.left.unop)
    rw [AlgebraicGeometry.Spec.map_preimage, AlgebraicGeometry.Spec.map_comp,
      AlgebraicGeometry.Spec.map_preimage, G_L.map_comp, CategoryTheory.Category.assoc]
    rfl
  · intro Y X X' v u
    apply AlgebraicGeometry.Spec.map_injective
    change AlgebraicGeometry.Spec.map (AlgebraicGeometry.Spec.preimage
        ((G_L.map (u ≫ F_BC.map v) ≫ (η_app X').hom).left ≫
          CategoryTheory.Limits.pullback.fst X'.hom h)) =
      AlgebraicGeometry.Spec.map
        (v.left.unop ≫
          AlgebraicGeometry.Spec.preimage
            ((G_L.map u ≫ (η_app X).hom).left ≫ CategoryTheory.Limits.pullback.fst X.hom h))
    rw [AlgebraicGeometry.Spec.map_preimage, AlgebraicGeometry.Spec.map_comp,
      AlgebraicGeometry.Spec.map_preimage]
    have h1 : G_L.map (u ≫ F_BC.map v) ≫ (η_app X').hom =
        (G_L.map u ≫ (η_app X).hom) ≫ B_site.map (G_K.map v) := by
      dsimp only [F_BC]
      rw [G_L.map_comp, G_L.map_preimage]
      simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id,
        CategoryTheory.Category.comp_id]
    rw [h1]
    have h2 : (B_site.map (G_K.map v)).left ≫ CategoryTheory.Limits.pullback.fst X'.hom h =
        CategoryTheory.Limits.pullback.fst X.hom h ≫ AlgebraicGeometry.Spec.map v.left.unop :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    let w_u : AlgebraicGeometry.Spec Y.left.unop ⟶ CategoryTheory.Limits.pullback X.hom h :=
      (G_L.map u ≫ (η_app X).hom).left
    let b_v : CategoryTheory.Limits.pullback X.hom h ⟶ CategoryTheory.Limits.pullback X'.hom h :=
      (B_site.map (G_K.map v)).left
    exact (CategoryTheory.Category.assoc w_u b_v _).trans
      ((congrArg (w_u ≫ ·) h2).trans (CategoryTheory.Category.assoc w_u _ _).symm)

theorem weil_alt_cd_affine_lan_descended_model_colimit (K F₀ L_inf : Type u) [Field K] [Field F₀] [Field L_inf]
    [Algebra K F₀] [FiniteDimensional K F₀] [Algebra.IsSeparable K F₀] [Algebra.Etale K F₀]
    [Algebra F₀ L_inf] [Algebra.IsSeparable F₀ L_inf]
    (hEtM : ∀ (M : IntermediateField F₀ L_inf), FiniteDimensional F₀ ↥M →
