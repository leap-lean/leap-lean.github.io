           ∀ a : Fin m,
             CategoryTheory.CategoryStruct.comp (G_L.map (p a)) i_Y.hom =
               CategoryTheory.CategoryStruct.comp (i_V a).hom
                 (weilAltCdSpecEtaleMap L_inf (ψ_inf a))) ∧
        (∀ x : PrimeSpectrum A_inf,
          ∃ a : Fin m, x ∈ Set.range (PrimeSpectrum.comap (ψ_inf a).toRingHom)) := by
    classical
    let S_L := AlgebraicGeometry.Spec (CommRingCat.of L_inf)
    let G_L := AlgebraicGeometry.Scheme.AffineEtale.Spec S_L
    let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
      @AlgebraicGeometry.Etale
    let _ : CategoryTheory.MorphismProperty.IsStableUnderComposition P_et :=
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    have hEtMapLeft : ∀ {W₁ W₂ : S_L.AffineEtale} (g : W₁ ⟶ W₂),
        AlgebraicGeometry.Etale (G_L.map g).left := by
      intro W₁ W₂ g
      have hW₁ : P_et (G_L.obj W₁).hom := (G_L.obj W₁).prop
      have hW₂ : P_et (G_L.obj W₂).hom := (G_L.obj W₂).prop
      exact @CategoryTheory.MorphismProperty.of_postcomp _ _ P_et P_et _ _ _ _
