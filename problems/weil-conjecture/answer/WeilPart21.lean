  have hEtaleGaloisAndComp :
      (∀ (A : Type u) [CommRing A] [Algebra E₁ A] [Algebra.Etale E₁ A] (p : PrimeSpectrum A),
        ∃ (L₀ : Type u) (hFL₀ : Field L₀) (hAlgL₀ : Algebra E₁ L₀),
          letI : Field L₀ := hFL₀
          letI : Algebra E₁ L₀ := hAlgL₀
          ∃ (_ : FiniteDimensional E₁ L₀) (_ : IsGalois E₁ L₀)
            (_ : Nonempty (E₂ →ₐ[E₁] L₀)) (ψ₀ : A →ₐ[E₁] L₀),
            PrimeSpectrum.comap ψ₀.toRingHom (⊥ : PrimeSpectrum L₀) = p) ∧
      (∀ (L₀ Idx : Type u) [Field L₀] [Fintype Idx]
         (D : Idx → Type u) [∀ τ, CommRing (D τ)] [∀ τ, Nontrivial (D τ)]
         [∀ τ, Algebra L₀ (D τ)] [∀ τ, Algebra.Etale L₀ (D τ)],
        ∃ (L : Type u) (hFL : Field L) (hAlgL : Algebra L₀ L),
          letI : Field L := hFL
          letI : Algebra L₀ L := hAlgL
          ∃ (_ : FiniteDimensional L₀ L) (_ : Algebra.IsSeparable L₀ L),
            ∀ τ : Idx, Nonempty (D τ →ₐ[L₀] L)) := by
    constructor
    · intro A _ _ _ p
      obtain ⟨I, hFinI, F_fam, hFieldF, hAlgF, e_A, hFinSep⟩ :=
        (Algebra.Etale.iff_exists_algEquiv_prod E₁ A).mp inferInstance
      let _ : Fintype I := Fintype.ofFinite I
      let _ : DecidableEq I := Classical.decEq I
      let _ : ∀ i : I, Field (F_fam i) := hFieldF
      let _ : ∀ i : I, Algebra E₁ (F_fam i) := hAlgF
      let _ : ∀ i : I, Module.Finite E₁ (F_fam i) := fun i => (hFinSep i).1
      let _ : ∀ i : I, Algebra.IsSeparable E₁ (F_fam i) := fun i => (hFinSep i).2
      have hPiOne : (∑ i ∈ Finset.univ, Pi.single i (1 : F_fam i)) = 1 := by
        ext j
        rw [Finset.sum_apply, Finset.sum_eq_single j]
        · exact Pi.single_eq_same j 1
        · intro k _ hkj
          exact Pi.single_eq_of_ne (Ne.symm hkj) 1
        · intro hj
          exact absurd (Finset.mem_univ j) hj
      have hOneSum : (∑ i ∈ Finset.univ, e_A.symm (Pi.single i (1 : F_fam i))) = (1 : A) :=
        (map_sum e_A.symm _ _).symm.trans ((congrArg e_A.symm hPiOne).trans (map_one e_A.symm))
      have hExistsI : ∃ i₀ : I, e_A.symm (Pi.single i₀ (1 : F_fam i₀)) ∉ p.asIdeal := by
        by_contra! hall
        have h1_mem : (1 : A) ∈ p.asIdeal := hOneSum ▸ p.asIdeal.sum_mem (fun i _ => hall i)
        exact p.isPrime.ne_top ((Ideal.eq_top_iff_one p.asIdeal).mpr h1_mem)
      obtain ⟨i₀, hi₀⟩ := hExistsI
      let π_i₀ : A →ₐ[E₁] F_fam i₀ := (Pi.evalAlgHom E₁ F_fam i₀).comp e_A.toAlgHom
      have hComap_i₀ : PrimeSpectrum.comap π_i₀.toRingHom (⊥ : PrimeSpectrum (F_fam i₀)) = p := by
        apply PrimeSpectrum.ext
        ext a
        change π_i₀ a ∈ (⊥ : Ideal (F_fam i₀)) ↔ a ∈ p.asIdeal
        constructor
        · intro ha0_mem
          have ha0 : π_i₀ a = 0 := Ideal.mem_bot.mp ha0_mem
          have hmul0 : a * e_A.symm (Pi.single i₀ 1) = 0 := by
            apply e_A.injective
            have hL : e_A (a * e_A.symm (Pi.single i₀ 1)) = e_A a * Pi.single i₀ 1 :=
              (map_mul e_A a _).trans (congrArg (e_A a * ·) (e_A.apply_symm_apply _))
            have hR : e_A a * Pi.single i₀ 1 = 0 := by
              ext j
              by_cases hj : j = i₀
              · subst hj
                change π_i₀ a * Pi.single j 1 j = 0
                rw [ha0, zero_mul]
              · change e_A a j * Pi.single i₀ 1 j = 0
                rw [Pi.single_eq_of_ne hj, mul_zero]
            exact hL.trans (hR.trans (map_zero e_A).symm)
          exact (p.isPrime.mul_mem_iff_mem_or_mem.mp (hmul0 ▸ p.asIdeal.zero_mem)).resolve_right hi₀
        · intro hap
          refine Ideal.mem_bot.mpr ?_
          by_contra hne
          let b : A := e_A.symm (Pi.single i₀ (π_i₀ a)⁻¹)
          have hmul1 : a * b = e_A.symm (Pi.single i₀ 1) := by
            apply e_A.injective
            have hL : e_A (a * b) = e_A a * Pi.single i₀ (π_i₀ a)⁻¹ :=
              (map_mul e_A a b).trans (congrArg (e_A a * ·) (e_A.apply_symm_apply _))
            have hR : e_A a * Pi.single i₀ (π_i₀ a)⁻¹ = Pi.single i₀ 1 := by
              ext j
              by_cases hj : j = i₀
              · subst hj
                change π_i₀ a * Pi.single j (π_i₀ a)⁻¹ j = Pi.single j 1 j
                rw [Pi.single_eq_same, Pi.single_eq_same, mul_inv_cancel₀ hne]
              · change e_A a j * Pi.single i₀ _ j = Pi.single i₀ 1 j
                rw [Pi.single_eq_of_ne hj, Pi.single_eq_of_ne hj, mul_zero]
            exact hL.trans (hR.trans (e_A.apply_symm_apply _).symm)
          exact hi₀ (hmul1 ▸ Ideal.mul_mem_right b p.asIdeal hap)
      let Ω₁ : Type u := SeparableClosure E₁
      have _ : IsGalois E₁ Ω₁ := IsSepClosure.isGalois
      let ι_F : F_fam i₀ →ₐ[E₁] Ω₁ := IsSepClosed.lift
      let ι_E₂ : E₂ →ₐ[E₁] Ω₁ := IsSepClosed.lift
      let K₁ : IntermediateField E₁ Ω₁ := ι_F.fieldRange ⊔ ι_E₂.fieldRange
      have _ : FiniteDimensional E₁ ↥ι_F.fieldRange := LinearMap.finiteDimensional_range ι_F.toLinearMap
      have _ : FiniteDimensional E₁ ↥ι_E₂.fieldRange := LinearMap.finiteDimensional_range ι_E₂.toLinearMap
      have _ : FiniteDimensional E₁ ↥K₁ :=
        IntermediateField.finiteDimensional_sup ι_F.fieldRange ι_E₂.fieldRange
      let M₀ : IntermediateField E₁ Ω₁ := IntermediateField.normalClosure E₁ ↥K₁ Ω₁
      let L₀ : Type u := ↥M₀
      have _ : FiniteDimensional E₁ L₀ := normalClosure.is_finiteDimensional E₁ ↥K₁ Ω₁
      have _ : IsGalois E₁ L₀ := IsGalois.normalClosure E₁ ↥K₁ Ω₁
      have hLeK₁ : K₁ ≤ M₀ := IntermediateField.le_normalClosure K₁
      let α₀ : F_fam i₀ →ₐ[E₁] L₀ :=
        ι_F.codRestrict M₀.toSubalgebra (fun x =>
          hLeK₁ ((@le_sup_left (IntermediateField E₁ Ω₁) _ ι_F.fieldRange ι_E₂.fieldRange)
            (ι_F.mem_fieldRange_self x)))
      let τ_base : E₂ →ₐ[E₁] L₀ :=
        ι_E₂.codRestrict M₀.toSubalgebra (fun x =>
          hLeK₁ ((@le_sup_right (IntermediateField E₁ Ω₁) _ ι_F.fieldRange ι_E₂.fieldRange)
            (ι_E₂.mem_fieldRange_self x)))
      let ψ₀ : A →ₐ[E₁] L₀ := α₀.comp π_i₀
      refine ⟨L₀, inferInstance, inferInstance, inferInstance, inferInstance, ⟨τ_base⟩, ψ₀, ?_⟩
      apply PrimeSpectrum.ext
      ext a
      change α₀ (π_i₀ a) ∈ (⊥ : Ideal L₀) ↔ a ∈ p.asIdeal
      have hiff₁ : α₀ (π_i₀ a) ∈ (⊥ : Ideal L₀) ↔ π_i₀ a ∈ (⊥ : Ideal (F_fam i₀)) :=
        Ideal.mem_bot.trans ((map_eq_zero_iff α₀ α₀.injective).trans Ideal.mem_bot.symm)
      exact hiff₁.trans (iff_of_eq (congrArg (fun I : PrimeSpectrum A => a ∈ I.asIdeal) hComap_i₀))
    · intro L₀ Idx _ _ D _ _ _ _
      have hFactorEach : ∀ τ : Idx,
          ∃ (M_τ : Type u) (hFM : Field M_τ) (hAlgM : Algebra L₀ M_τ),
            letI : Field M_τ := hFM
            letI : Algebra L₀ M_τ := hAlgM
            ∃ (_ : FiniteDimensional L₀ M_τ) (_ : Algebra.IsSeparable L₀ M_τ),
              Nonempty (D τ →ₐ[L₀] M_τ) := by
        intro τ
        obtain ⟨J_τ, _, M_fam, hFieldM, hAlgM, e_D, hFinSepM⟩ :=
          (Algebra.Etale.iff_exists_algEquiv_prod L₀ (D τ)).mp inferInstance
        let _ : ∀ j : J_τ, Field (M_fam j) := hFieldM
        let _ : ∀ j : J_τ, Algebra L₀ (M_fam j) := hAlgM
        let _ : ∀ j : J_τ, Module.Finite L₀ (M_fam j) := fun j => (hFinSepM j).1
        let _ : ∀ j : J_τ, Algebra.IsSeparable L₀ (M_fam j) := fun j => (hFinSepM j).2
        have hNeJ : Nonempty J_τ := by
          by_contra hEmp
          have _ : IsEmpty J_τ := not_nonempty_iff.mp hEmp
          exact zero_ne_one (e_D.injective (Subsingleton.elim (e_D 0) (e_D 1)))
        obtain ⟨j₀⟩ := hNeJ
        exact ⟨M_fam j₀, inferInstance, inferInstance, inferInstance, inferInstance,
          ⟨(Pi.evalAlgHom L₀ M_fam j₀).comp e_D.toAlgHom⟩⟩
      choose M_f hFM hAlgM hFinM hSepM hHomD using hFactorEach
      let _ : ∀ τ, Field (M_f τ) := hFM
      let _ : ∀ τ, Algebra L₀ (M_f τ) := hAlgM
      let _ : ∀ τ, FiniteDimensional L₀ (M_f τ) := hFinM
      let _ : ∀ τ, Algebra.IsSeparable L₀ (M_f τ) := hSepM
      let Ω_L : Type u := SeparableClosure L₀
      have _ : Algebra.IsSeparable L₀ Ω_L := IsSepClosure.separable
      let κ_f : ∀ τ : Idx, M_f τ →ₐ[L₀] Ω_L := fun _ => IsSepClosed.lift
      let N_f : Idx → IntermediateField L₀ Ω_L := fun τ => (κ_f τ).fieldRange
      have _ : ∀ τ, FiniteDimensional L₀ ↥(N_f τ) :=
        fun τ => LinearMap.finiteDimensional_range (κ_f τ).toLinearMap
      let N_sup : IntermediateField L₀ Ω_L := ⨆ τ ∈ (Finset.univ : Finset Idx), N_f τ
      have _ : FiniteDimensional L₀ ↥N_sup :=
        IntermediateField.finiteDimensional_iSup_of_finset (t := N_f) (s := Finset.univ)
      have _ : Algebra.IsSeparable L₀ ↥N_sup :=
        IntermediateField.isSeparable_tower_bot L₀ N_sup
      refine ⟨↥N_sup, inferInstance, inferInstance, inferInstance, inferInstance, fun τ => ?_⟩
      have hLe_τ : N_f τ ≤ N_sup := le_iSup₂ (f := fun j _ => N_f j) τ (Finset.mem_univ τ)
      let emb_τ : M_f τ →ₐ[L₀] ↥N_sup :=
        (κ_f τ).codRestrict N_sup.toSubalgebra (fun x => hLe_τ ((κ_f τ).mem_fieldRange_self x))
      exact ⟨emb_τ.comp (Classical.choice (hHomD τ))⟩

  
  have hSplitBij : ∀ (L B : Type u) [Field L] [Algebra E₁ L]
      (hSplits : ∀ x : E₂, Polynomial.Splits ((minpoly E₁ x).map (algebraMap E₁ L)))
      [CommRing B] [Algebra E₁ B] (φ : B ≃ₐ[E₁] L),
      Fintype.card (E₂ →ₐ[E₁] L) = Module.finrank E₁ E₂ ∧
      Function.Bijective
        (RingHom.pi (fun τ : (E₂ →ₐ[E₁] L) =>
          (Algebra.TensorProduct.lift τ φ.toAlgHom (fun _ _ => mul_comm _ _)).toRingHom) :
          TensorProduct E₁ E₂ B →+* ((E₂ →ₐ[E₁] L) → L)) := by
    intro L B _ _ hSplits _ _ φ
    set d := Module.finrank E₁ E₂
    have hCard : Fintype.card (E₂ →ₐ[E₁] L) = d := AlgHom.card_of_splits E₁ E₂ L hSplits
    refine ⟨hCard, ?_⟩
    let EmbL := (E₂ →ₐ[E₁] L)
    let Φ_ring : TensorProduct E₁ E₂ B →+* (EmbL → L) :=
      RingHom.pi (fun τ : EmbL =>
        (Algebra.TensorProduct.lift τ φ.toAlgHom (fun _ _ => mul_comm _ _)).toRingHom)
    let b : Module.Basis (Fin d) E₁ E₂ := Module.finBasis E₁ E₂
    let e_Emb : Fin d ≃ EmbL := (Fintype.equivFinOfCardEq hCard).symm
    let M : Matrix (Fin d) (Fin d) L := fun k j => (e_Emb j) (b k)
    have hDed_inj : Function.Injective (Matrix.mulVecLin M) := by
      rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
      intro v hv
      rw [LinearMap.mem_ker] at hv
      have hAllX : ∀ x : E₂, (∑ j : Fin d, v j * (e_Emb j) x) = 0 := by
        intro x
        conv_lhs => rw [← b.sum_repr x]
        simp only [map_sum, Algebra.smul_def, map_mul]
        have hcomm_e : ∀ (j : Fin d) (k : Fin d),
            (e_Emb j) ((algebraMap E₁ E₂) (b.repr x k)) = algebraMap E₁ L (b.repr x k) :=
          fun j k => (e_Emb j).commutes (b.repr x k)
        simp_rw [hcomm_e, Finset.mul_sum]
        rw [Finset.sum_comm]
        refine Finset.sum_eq_zero (fun k _ => ?_)
        have hpull : (∑ j : Fin d, v j * (algebraMap E₁ L (b.repr x k) * (e_Emb j) (b k))) =
            algebraMap E₁ L (b.repr x k) * (∑ j : Fin d, (e_Emb j) (b k) * v j) := by
          rw [Finset.mul_sum]
          exact Finset.sum_congr rfl (fun j _ => by ring)
        rw [hpull]
        have hk0 : (Matrix.mulVecLin M v) k = 0 := congrFun hv k
        change algebraMap E₁ L (b.repr x k) * (Matrix.mulVec M v k) = 0
        rw [show Matrix.mulVec M v k = (Matrix.mulVecLin M v) k from rfl, hk0, mul_zero]
      let charMap : Fin d → (E₂ˣ →* L) := fun j =>
        ((e_Emb j).toRingHom.toMonoidHom).comp (Units.coeHom E₂)
      have hCharInj : Function.Injective charMap := by
        intro j₁ j₂ hj
        apply e_Emb.injective
        ext x
        by_cases hx : x = 0
        · rw [hx, map_zero, map_zero]
        · exact DFunLike.congr_fun hj (Units.mk0 x hx)
      have hLinInd : LinearIndependent L (fun j : Fin d => (charMap j : E₂ˣ → L)) :=
        (linearIndependent_monoidHom E₂ˣ L).comp charMap hCharInj
      exact funext ((Fintype.linearIndependent_iff.mp hLinInd) v (by
        ext u
        simp only [Pi.smul_apply, smul_eq_mul, Finset.sum_apply, Pi.zero_apply]
        exact hAllX (u : E₂)))
    have hBijM : Function.Bijective (Matrix.mulVecLin M) :=
      ⟨hDed_inj, LinearMap.injective_iff_surjective.mp hDed_inj⟩
    have hInjMT : Function.Injective (Matrix.mulVecLin M.transpose) := by
      rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
      intro w hw
      rw [LinearMap.mem_ker] at hw
      ext i
      change w i = 0
      obtain ⟨v, hv_i⟩ := hBijM.2 (Pi.single i (1 : L))
      have hDotL : (∑ k : Fin d, w k * (Matrix.mulVecLin M v k)) = w i := by
        rw [hv_i, Finset.sum_eq_single i]
        · rw [Pi.single_eq_same, mul_one]
        · intro k _ hki
          rw [Pi.single_eq_of_ne hki, mul_zero]
        · intro hi_mem
          exact absurd (Finset.mem_univ i) hi_mem
      have hDotR : (∑ k : Fin d, w k * (Matrix.mulVecLin M v k)) =
          ∑ j : Fin d, (Matrix.mulVecLin M.transpose w j) * v j := by
        change (∑ k : Fin d, w k * (∑ j : Fin d, M k j * v j)) =
          ∑ j : Fin d, (∑ k : Fin d, M k j * w k) * v j
        simp_rw [Finset.mul_sum, Finset.sum_mul]
        rw [Finset.sum_comm]
        exact Finset.sum_congr rfl (fun j _ => Finset.sum_congr rfl (fun k _ => by ring))
      have hZeroR : (∑ j : Fin d, (Matrix.mulVecLin M.transpose w j) * v j) = 0 := by
        rw [hw]
        simp only [Pi.zero_apply, zero_mul, Finset.sum_const_zero]
      exact hDotL.symm.trans (hDotR.trans hZeroR)
    have hBijMT : Function.Bijective (Matrix.mulVecLin M.transpose) :=
      ⟨hInjMT, LinearMap.injective_iff_surjective.mp hInjMT⟩
    let e_tp : TensorProduct E₁ E₂ B ≃ₐ[E₁] TensorProduct E₁ L E₂ :=
      (Algebra.TensorProduct.congr (AlgEquiv.refl : E₂ ≃ₐ[E₁] E₂) φ).trans
        (Algebra.TensorProduct.comm E₁ E₂ L)
    let e_bas : TensorProduct E₁ L E₂ ≃ₗ[L] (Fin d → L) :=
      (b.baseChange L).equivFun
    let e_idx : (Fin d → L) ≃ (EmbL → L) :=
      Equiv.piCongrLeft' (fun _ => L) e_Emb
    have hCompEq : (Φ_ring : TensorProduct E₁ E₂ B → (EmbL → L)) =
        e_idx ∘ (Matrix.mulVecLin M.transpose) ∘ e_bas ∘ e_tp := by
      funext z
      induction z using TensorProduct.induction_on with
      | zero =>
        simp only [Function.comp_apply, map_zero]
        rfl
      | tmul e x =>
        simp only [Function.comp_apply]
        have htp : e_tp (e ⊗ₜ[E₁] x) = φ x ⊗ₜ[E₁] e := rfl
        rw [htp]
        ext τ
        change τ e * φ x = e_idx (Matrix.mulVecLin M.transpose (e_bas (φ x ⊗ₜ[E₁] e))) τ
        simp only [e_idx, Equiv.piCongrLeft'_apply]
        have hbas : ∀ k : Fin d,
            e_bas (φ x ⊗ₜ[E₁] e) k = φ x * algebraMap E₁ L (b.repr e k) := by
          intro k
          change (b.baseChange L).repr (φ x ⊗ₜ[E₁] e) k = _
          rw [Module.Basis.baseChange_repr_tmul, Algebra.smul_def, mul_comm]
        change τ e * φ x = ∑ k : Fin d, M.transpose (e_Emb.symm τ) k * e_bas (φ x ⊗ₜ[E₁] e) k
        simp_rw [hbas, Matrix.transpose_apply, M, e_Emb.apply_symm_apply]
        conv_lhs => rw [← b.sum_repr e]
        simp only [map_sum, Algebra.smul_def, map_mul, Finset.sum_mul]
        refine Finset.sum_congr rfl (fun k _ => ?_)
        rw [τ.commutes]
        ring
      | add x y ihx ihy =>
        have hL : Φ_ring (x + y) = Φ_ring x + Φ_ring y := map_add Φ_ring x y
        have hR : e_idx (Matrix.mulVecLin M.transpose (e_bas (e_tp (x + y)))) =
            e_idx (Matrix.mulVecLin M.transpose (e_bas (e_tp x))) +
            e_idx (Matrix.mulVecLin M.transpose (e_bas (e_tp y))) := by
          rw [map_add, map_add, map_add]
          rfl
        exact hL.trans ((congrArg₂ (· + ·) ihx ihy).trans hR.symm)
    exact hCompEq ▸ (e_idx.bijective.comp (hBijMT.comp (e_bas.bijective.comp e_tp.bijective)))

  
  have hClopenGlue : ∀ (F Idx : Type u) [Field F] [Fintype Idx]
      (V : (AlgebraicGeometry.Spec (CommRingCat.of F)).AffineEtale)
      (V_sheet : Idx → (AlgebraicGeometry.Spec (CommRingCat.of F)).AffineEtale)
      (hField : ∀ τ : Idx, IsField ↑(V_sheet τ).left.unop)
      (ι : ∀ τ : Idx, V_sheet τ ⟶ V)
      (hBij : Function.Bijective
        (RingHom.pi (fun τ : Idx => ((ι τ).left.unop).hom) :
          ↑V.left.unop →+* (∀ τ : Idx, ↑(V_sheet τ).left.unop)))
      (ℱ : CategoryTheory.Sheaf (weilC1AffEtTop F) AddCommGrpCat.{u})
      (s : ∀ τ : Idx, ↑(ℱ.obj.obj (Opposite.op (V_sheet τ)))),
      ∃! t : ↑(ℱ.obj.obj (Opposite.op V)),
        ∀ τ : Idx, (ℱ.obj.map (Opposite.op (ι τ))).hom t = s τ := by
    intro F Idx _ _ V V_sheet hField ι hBij ℱ s
    let _ : DecidableEq Idx := Classical.decEq Idx
    have hTypeℱ : CategoryTheory.Presieve.IsSheaf (weilC1AffEtTop F)
        (ℱ.obj.comp (CategoryTheory.forget AddCommGrpCat.{u})) :=
      (CategoryTheory.isSheaf_iff_isSheaf_of_type (weilC1AffEtTop F) _).mp
        (CategoryTheory.Presheaf.isSheaf_comp_of_isSheaf (weilC1AffEtTop F) ℱ.obj
          (CategoryTheory.forget AddCommGrpCat.{u}) ℱ.property)
    have hZeroRingSubsingleton : ∀ (Z : (AlgebraicGeometry.Spec (CommRingCat.of F)).AffineEtale),
        (1 : ↑Z.left.unop) = 0 → Subsingleton ↑(ℱ.obj.obj (Opposite.op Z)) := by
      intro Z h10
      have hBot : (⊥ : CategoryTheory.Sieve Z) ∈ weilC1AffEtTop F Z := by
        refine (hTopMem F Z ⊥).mpr (fun p => ?_)
        exfalso
        exact p.isPrime.ne_top ((Ideal.eq_top_iff_one p.asIdeal).mpr (h10 ▸ p.asIdeal.zero_mem))
      have hGenBot : CategoryTheory.Sieve.generate (⊥ : CategoryTheory.Sieve Z).arrows ∈
          weilC1AffEtTop F Z :=
        (CategoryTheory.Sieve.generate_sieve (⊥ : CategoryTheory.Sieve Z)).symm ▸ hBot
      have hSheafBot := hTypeℱ.isSheafFor (⊥ : CategoryTheory.Sieve Z).arrows hGenBot
      exact ⟨fun s₁ s₂ => hSheafBot.isSeparatedFor.ext (fun _ _ hf => False.elim hf)⟩
    let R_sh : Idx → Type u := fun τ => ↑(V_sheet τ).left.unop
    let π_τ : ∀ τ : Idx, ↑V.left.unop →+* R_sh τ := fun τ => ((ι τ).left.unop).hom
    let Θ_eqv : ↑V.left.unop ≃+* (∀ τ : Idx, R_sh τ) :=
      RingEquiv.ofBijective (RingHom.pi π_τ) hBij
    have hCov_sheet : CategoryTheory.Sieve.generate
        (CategoryTheory.Presieve.ofArrows V_sheet ι) ∈ weilC1AffEtTop F V := by
      refine (hTopMem F V _).mpr (fun q => ?_)
      have hPi1 : (∑ τ ∈ Finset.univ, Pi.single (M := R_sh) τ (1 : R_sh τ)) = 1 := by
        ext τ₀
        rw [Finset.sum_apply, Finset.sum_eq_single τ₀]
        · exact Pi.single_eq_same (M := R_sh) τ₀ 1
        · intro τ₁ _ hne
          exact Pi.single_eq_of_ne (M := R_sh) (Ne.symm hne) 1
        · intro hmem
          exact absurd (Finset.mem_univ τ₀) hmem
      have hSum1 : (∑ τ ∈ Finset.univ, Θ_eqv.symm (Pi.single (M := R_sh) τ 1)) =
          (1 : ↑V.left.unop) :=
        (map_sum Θ_eqv.symm _ _).symm.trans
          ((congrArg Θ_eqv.symm hPi1).trans (map_one Θ_eqv.symm))
      have hExτ : ∃ τ₀ : Idx, Θ_eqv.symm (Pi.single (M := R_sh) τ₀ 1) ∉ q.asIdeal := by
        by_contra! hall
        exact q.isPrime.ne_top ((Ideal.eq_top_iff_one q.asIdeal).mpr
          (hSum1 ▸ q.asIdeal.sum_mem (fun τ _ => hall τ)))
      obtain ⟨τ₀, hτ₀⟩ := hExτ
      have hBotPrime : (⊥ : Ideal (R_sh τ₀)).IsPrime := by
        refine Ideal.IsPrime.mk ?_ ?_
        · intro hEq
          obtain ⟨x, y, hxy⟩ := (hField τ₀).exists_pair_ne
          have hmem : x - y ∈ (⊥ : Ideal (R_sh τ₀)) :=
            hEq.symm ▸ (Submodule.mem_top : x - y ∈ (⊤ : Ideal (R_sh τ₀)))
          exact hxy (sub_eq_zero.mp (Ideal.mem_bot.mp hmem))
        · intro x y hxy0
          by_cases hx : x = 0
          · exact Or.inl (Ideal.mem_bot.mpr hx)
          · obtain ⟨c, hxc⟩ := (hField τ₀).mul_inv_cancel hx
            have hy0 : y = 0 := by
              calc
                y = 1 * y := (one_mul y).symm
                _ = (x * c) * y := congrArg (· * y) hxc.symm
                _ = c * (x * y) := by ring
                _ = c * 0 := congrArg (c * ·) (Ideal.mem_bot.mp hxy0)
                _ = 0 := mul_zero c
            exact Or.inr (Ideal.mem_bot.mpr hy0)
      let b₀ : PrimeSpectrum (R_sh τ₀) := ⟨⊥, hBotPrime⟩
      refine ⟨V_sheet τ₀, ι τ₀, b₀, ?_, ?_⟩
      · exact ⟨V_sheet τ₀, CategoryTheory.CategoryStruct.id _, ι τ₀,
          ⟨τ₀⟩, CategoryTheory.Category.id_comp _⟩
      · apply PrimeSpectrum.ext
        ext z
        change π_τ τ₀ z ∈ (⊥ : Ideal (R_sh τ₀)) ↔ z ∈ q.asIdeal
        constructor
        · intro hz0_mem
          have hz0 : π_τ τ₀ z = 0 := Ideal.mem_bot.mp hz0_mem
          have hmul0 : z * Θ_eqv.symm (Pi.single (M := R_sh) τ₀ 1) = 0 := by
            apply Θ_eqv.injective
            have hL : Θ_eqv (z * Θ_eqv.symm (Pi.single (M := R_sh) τ₀ 1)) =
                Θ_eqv z * Pi.single (M := R_sh) τ₀ 1 :=
              (map_mul Θ_eqv z _).trans (congrArg (Θ_eqv z * ·) (Θ_eqv.apply_symm_apply _))
            have hR : Θ_eqv z * Pi.single (M := R_sh) τ₀ 1 = 0 := by
              ext τ₁
              by_cases h1 : τ₁ = τ₀
              · subst h1
                change π_τ τ₁ z * Pi.single (M := R_sh) τ₁ 1 τ₁ = 0
                rw [hz0, zero_mul]
              · change π_τ τ₁ z * Pi.single (M := R_sh) τ₀ 1 τ₁ = 0
                rw [Pi.single_eq_of_ne (M := R_sh) h1, mul_zero]
            exact hL.trans (hR.trans (map_zero Θ_eqv).symm)
          exact (q.isPrime.mul_mem_iff_mem_or_mem.mp
            (hmul0 ▸ q.asIdeal.zero_mem)).resolve_right hτ₀
        · intro hzq
          refine Ideal.mem_bot.mpr ?_
          by_contra hne
          obtain ⟨u_inv, hu_inv⟩ := (hField τ₀).mul_inv_cancel hne
          let w := Θ_eqv.symm (Pi.single (M := R_sh) τ₀ u_inv)
          have hmul1 : z * w = Θ_eqv.symm (Pi.single (M := R_sh) τ₀ 1) := by
            apply Θ_eqv.injective
            have hL : Θ_eqv (z * w) = Θ_eqv z * Pi.single (M := R_sh) τ₀ u_inv :=
              (map_mul Θ_eqv z w).trans (congrArg (Θ_eqv z * ·) (Θ_eqv.apply_symm_apply _))
            have hR : Θ_eqv z * Pi.single (M := R_sh) τ₀ u_inv = Pi.single (M := R_sh) τ₀ 1 := by
              ext τ₁
              by_cases h1 : τ₁ = τ₀
              · subst h1
                change π_τ τ₁ z * Pi.single (M := R_sh) τ₁ u_inv τ₁ =
                  Pi.single (M := R_sh) τ₁ 1 τ₁
                rw [Pi.single_eq_same, Pi.single_eq_same, hu_inv]
              · change π_τ τ₁ z * Pi.single (M := R_sh) τ₀ u_inv τ₁ =
                  Pi.single (M := R_sh) τ₀ 1 τ₁
                rw [Pi.single_eq_of_ne h1, Pi.single_eq_of_ne h1, mul_zero]
            exact hL.trans (hR.trans (Θ_eqv.apply_symm_apply _).symm)
          exact hτ₀ (hmul1 ▸ Ideal.mul_mem_right w q.asIdeal hzq)
    have hSheafArr : CategoryTheory.Presieve.IsSheafFor
        (ℱ.obj.comp (CategoryTheory.forget AddCommGrpCat.{u}))
        (CategoryTheory.Presieve.ofArrows V_sheet ι) :=
      hTypeℱ.isSheafFor _ hCov_sheet
    have hCompatS : CategoryTheory.Presieve.Arrows.Compatible
        (ℱ.obj.comp (CategoryTheory.forget AddCommGrpCat.{u})) ι s := by
      intro τ₁ τ₂ Z f₁ f₂ hf_eq
      have hRingEq : ((f₁.left.unop).hom).comp (π_τ τ₁) = ((f₂.left.unop).hom).comp (π_τ τ₂) :=
        congrArg (fun m => (m.left.unop).hom) hf_eq
      by_cases hτ : τ₁ = τ₂
      · subst hτ
        have hf12 : f₁ = f₂ := by
          refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
          apply Opposite.unop_injective
          apply CommRingCat.hom_ext
          apply RingHom.ext
          intro a
          let w := Θ_eqv.symm (Pi.single (M := R_sh) τ₁ a)
