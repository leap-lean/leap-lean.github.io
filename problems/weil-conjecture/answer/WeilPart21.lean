        change (pb_Y.obj G).obj.map (Opposite.op (e_fun.inv.app V)) ≫
            (pb_Y.obj G).obj.map (Opposite.op (e_B₂.hom.app V)) =
          (pb_Y.obj G).obj.map (Opposite.op (e_B₁.hom.app V)) ≫
