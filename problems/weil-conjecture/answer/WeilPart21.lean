    have hsum_cleared : ∑ i ∈ s, ((b_M i : ↥M) : L) * a i = 0 := by
      have hmulD : (∑ i ∈ s, c i • ((b_M i : ↥M) : L)) * D = 0 := by
        rw [hsum, zero_mul]
      rw [Finset.sum_mul] at hmulD
      rw [← hmulD]
      refine Finset.sum_congr rfl (fun i hi => ?_)
      rw [Algebra.smul_def]
      change ((b_M i : ↥M) : L) * a i = (((c i : ↥F_tr) : L) * ((b_M i : ↥M) : L)) * D
      calc
