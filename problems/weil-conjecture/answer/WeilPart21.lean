    have hg_R : ∀ y : ↥(G_L.obj Y).left, R.arrows (g_y y) :=
      fun y => (Classical.choose_spec (Classical.choose_spec (hPtCov y))).1
    have hg_mem : ∀ y : ↥(G_L.obj Y).left, y ∈ Set.range ((G_L.map (g_y y)).left.base) :=
      fun y => (Classical.choose_spec (Classical.choose_spec (hPtCov y))).2
    have hOpenRange : ∀ y : ↥(G_L.obj Y).left,
        IsOpen (Set.range ((G_L.map (g_y y)).left.base)) := by
      intro y
      have _ : AlgebraicGeometry.Etale (G_L.map (g_y y)).left := hEtMapLeft (g_y y)
