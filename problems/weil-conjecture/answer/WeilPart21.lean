    intro A B D _ _ _ _ _ _ _ _ _ _ F _ _ _ G _ _ _ FG _ _ _
      e_hom e_inv he_hom_inv he_inv_hom he_nat
    have he_inv_nat : ∀ {X Y : A} (k : X ⟶ Y),
        G.map (F.map k) ≫ e_inv Y = e_inv X ≫ FG.map k := by
      intro X Y k
      calc
        G.map (F.map k) ≫ e_inv Y
          = (e_inv X ≫ e_hom X) ≫ (G.map (F.map k) ≫ e_inv Y) := by
              rw [he_inv_hom X, CategoryTheory.Category.id_comp]
        _ = e_inv X ≫ ((e_hom X ≫ G.map (F.map k)) ≫ e_inv Y) := by
              rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]
        _ = e_inv X ≫ ((FG.map k ≫ e_hom Y) ≫ e_inv Y) := by rw [← he_nat k]
        _ = e_inv X ≫ FG.map k := by
