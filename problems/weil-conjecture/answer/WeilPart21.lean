      ∀ (y : ∀ a : Fin m, Q_B a),
        (∀ a b : Fin m, q_fst a b (y a) = q_snd a b (y b)) →
        ∃! s : Q_A, ∀ a : Fin m, q_φ a s = y a := by
    intro I _ hne hDir m G_A _ G_B _ G_C _ τ_A τ_B τ_C res_φ res_fst res_snd
      Q_A _ Q_B _ Q_C _ q_φ q_fst q_snd κ_A κ_B κ_C
      hτ_B_comp hτ_C_comp hres_φ_nat hres_fst_nat hres_snd_nat
      hκ_A_compat hκ_B_compat hκ_φ_nat hκ_fst_nat hκ_snd_nat
      hκ_A_surj hκ_B_surj hκ_B_ker hκ_C_ker hStage_glue hStage_uniq y hy
    have hFinUpper : ∀ {ι : Type} (s : Finset ι) (i_base : I) (f : ι → I),
        ∃ i_top : I, i_base ≤ i_top ∧ ∀ idx ∈ s, f idx ≤ i_top := by
      intro ι s i_base f
      induction s using Finset.cons_induction with
      | empty =>
        exact ⟨i_base, le_rfl, fun _ h => False.elim (Finset.notMem_empty _ h)⟩
      | cons idx₀ s _ ih =>
        rcases ih with ⟨i_s, h_base_s, h_s⟩
        rcases hDir i_s (f idx₀) with ⟨i_top, h1, h2⟩
        refine ⟨i_top, le_trans h_base_s h1, fun idx hmem => ?_⟩
        rcases Finset.mem_cons.mp hmem with rfl | hmem_s
        · exact h2
        · exact le_trans (h_s idx hmem_s) h1
    rcases hne with ⟨i₀⟩
    let i_fn : Fin m → I := fun a => Classical.choose (hκ_B_surj a (y a))
    let x₀_fn : ∀ a : Fin m, G_B a (i_fn a) :=
      fun a => Classical.choose (Classical.choose_spec (hκ_B_surj a (y a)))
    have hx₀_fn : ∀ a : Fin m, κ_B a (i_fn a) (x₀_fn a) = y a :=
      fun a => Classical.choose_spec (Classical.choose_spec (hκ_B_surj a (y a)))
    rcases hFinUpper (Finset.univ : Finset (Fin m)) i₀ i_fn with ⟨i_lift, _, h_lift_all⟩
    have hle_lift : ∀ a : Fin m, i_fn a ≤ i_lift := fun a => h_lift_all a (Finset.mem_univ a)
    let x₁ : ∀ a : Fin m, G_B a i_lift := fun a => τ_B a (hle_lift a) (x₀_fn a)
    have hx₁ : ∀ a : Fin m, κ_B a i_lift (x₁ a) = y a := by
      intro a
      exact (hκ_B_compat a (hle_lift a) (x₀_fn a)).trans (hx₀_fn a)
    let δ : ∀ p : Fin m × Fin m, G_C p.1 p.2 i_lift :=
