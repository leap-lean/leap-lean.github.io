      fun τ =>
        (@Algebra.TensorProduct.lift E₁ E₁ E₂ B_Lf L_f _ _ (Algebra.id E₁) _ _ _
          (@IsScalarTower.of_algebraMap_eq' E₁ E₁ E₂ _ _ _ (Algebra.id E₁) _ _ rfl)
          _ alg_UL _ _ _
          (@IsScalarTower.of_algebraMap_eq' E₁ E₁ L_f _ _ _ (Algebra.id E₁) _ _ rfl)
          τ (@AlgEquiv.toAlgHom E₁ B_Lf L_f _ _ _ alg_UL inst_alg_EL φ_Lf)
