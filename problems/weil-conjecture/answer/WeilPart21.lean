    obtain ⟨V₁, v, y₁, hy₁, hs₀_v⟩ := (Φ.toPresheafFiber_eq_iff' U₀ x₀ s₀ 0).mp hgerms_eq
    rw [map_zero] at hs₀_v
    exact ⟨V₁, v, y₁.left, congrArg CategoryTheory.CommaMorphism.left hy₁, hs₀_v⟩

  exact ⟨hExtractStalkZero _ hZero_ker, hExtractStalkZero _ hZero_coker⟩

theorem weil_alt_cd_generic_excision_and_leray_syzygy (V : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsIntegral V]
    (m ℓ q : ℕ) (hm : 1 ≤ m) (hq : 2 * m < q)
    (ℱ : CategoryTheory.Sheaf V.smallEtaleTopology AddCommGrpCat.{u})
    (hℓ_ℱ : ℓ • CategoryTheory.CategoryStruct.id ℱ = 0)
    (hExcVanish : ∀ (ℋ : CategoryTheory.Sheaf V.smallEtaleTopology AddCommGrpCat.{u}),
      ℓ • CategoryTheory.CategoryStruct.id ℋ = 0 →
      WeilAltCdStalkZeroAt V ℋ (genericPoint ↥V) →
      ∀ r : ℕ, 2 * (m - 1) < r → Subsingleton (ℋ.H r))
    (hGenField : ∀ (G : CategoryTheory.Sheaf
        (AlgebraicGeometry.Spec
          (V.presheaf.stalk (genericPoint ↥V))).smallEtaleTopology AddCommGrpCat.{u}),
      ℓ • CategoryTheory.CategoryStruct.id G = 0 →
      ∀ n : ℕ, m < n → Subsingleton (G.H n))
    (hRPush : ∀ (G : CategoryTheory.Sheaf
        (AlgebraicGeometry.Spec
          (V.presheaf.stalk (genericPoint ↥V))).smallEtaleTopology AddCommGrpCat.{u}),
      ℓ • CategoryTheory.CategoryStruct.id G = 0 →
      ∀ s : ℕ, 1 ≤ s →
        (m < s → ∀ x : ↥V,
          WeilAltCdStalkZeroAt V
            (weilAltCdHigherDirectImage (V.fromSpecStalk (genericPoint ↥V)) s G) x) ∧
        (∀ d : ℕ, d + s = m → ∀ r : ℕ, 2 * d < r →
          Subsingleton
            ((weilAltCdHigherDirectImage (V.fromSpecStalk (genericPoint ↥V)) s G).H r))) :
    Subsingleton (ℱ.H q) :=
by
  have hSubOfIso : ∀ {C_ab : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} C_ab]
      [CategoryTheory.Abelian C_ab] [CategoryTheory.HasExt.{u} C_ab]
      (X₀ : C_ab) {A B : C_ab} (isoAB : A ≅ B) (r : ℕ),
      Subsingleton (CategoryTheory.Abelian.Ext.{u} X₀ B r) →
      Subsingleton (CategoryTheory.Abelian.Ext.{u} X₀ A r) := by
    intro C_ab _ _ _ X₀ A B isoAB r hSubB
    refine subsingleton_of_forall_eq 0 (fun w => ?_)
    have hwB : w.comp (CategoryTheory.Abelian.Ext.mk₀ isoAB.hom) (Nat.add_zero r) = 0 :=
      @Subsingleton.elim _ hSubB _ 0
    have hid := CategoryTheory.Abelian.Ext.comp_mk₀_id w
    rw [← isoAB.hom_inv_id, ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ isoAB.hom isoAB.inv,
      ← CategoryTheory.Abelian.Ext.comp_assoc w (CategoryTheory.Abelian.Ext.mk₀ isoAB.hom)
        (CategoryTheory.Abelian.Ext.mk₀ isoAB.inv) (Nat.add_zero r) (Nat.add_zero 0)
        (Nat.add_zero r),
      hwB, CategoryTheory.Abelian.Ext.zero_comp] at hid
    exact hid.symm

  have hExt0CancelMono : ∀ {C_ab : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} C_ab]
      [CategoryTheory.Abelian C_ab] [CategoryTheory.HasExt.{u} C_ab]
      (X₀ : C_ab) {Y Z : C_ab} (f : Y ⟶ Z) [CategoryTheory.Mono f]
      (x y : CategoryTheory.Abelian.Ext.{u} X₀ Y 0),
      x.comp (CategoryTheory.Abelian.Ext.mk₀ f) (Nat.add_zero 0) =
        y.comp (CategoryTheory.Abelian.Ext.mk₀ f) (Nat.add_zero 0) →
      x = y := by
    intro C_ab _ _ _ X₀ Y Z f _ x y hxy
    have hx := (CategoryTheory.Abelian.Ext.homEquiv₀.symm_apply_apply x).symm
    have hy := (CategoryTheory.Abelian.Ext.homEquiv₀.symm_apply_apply y).symm
    rw [hx, hy] at hxy ⊢
    change (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.Abelian.Ext.homEquiv₀ x)).comp
        (CategoryTheory.Abelian.Ext.mk₀ f) (Nat.add_zero 0) =
      (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.Abelian.Ext.homEquiv₀ y)).comp
        (CategoryTheory.Abelian.Ext.mk₀ f) (Nat.add_zero 0) at hxy
    rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀] at hxy
    have hhom : CategoryTheory.Abelian.Ext.homEquiv₀ x ≫ f =
        CategoryTheory.Abelian.Ext.homEquiv₀ y ≫ f :=
      CategoryTheory.Abelian.Ext.homEquiv₀.symm.injective hxy
    rw [CategoryTheory.cancel_mono f] at hhom
    rw [hhom]

  have hSubExact₁ : ∀ {C_ab : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} C_ab]
      [CategoryTheory.Abelian C_ab] [CategoryTheory.HasExt.{u} C_ab]
      (X₀ : C_ab) {S : CategoryTheory.ShortComplex C_ab} (hS : S.ShortExact)
      {n₀ n₁ : ℕ} (hn : n₀ + 1 = n₁),
      Subsingleton (CategoryTheory.Abelian.Ext.{u} X₀ S.X₃ n₀) →
      Subsingleton (CategoryTheory.Abelian.Ext.{u} X₀ S.X₂ n₁) →
      Subsingleton (CategoryTheory.Abelian.Ext.{u} X₀ S.X₁ n₁) := by
    intro C_ab _ _ _ X₀ S hS n₀ n₁ hn hSub₃ hSub₂
    refine subsingleton_of_forall_eq 0 (fun x₁ => ?_)
    have hx₂ : x₁.comp (CategoryTheory.Abelian.Ext.mk₀ S.f) (Nat.add_zero n₁) = 0 :=
      @Subsingleton.elim _ hSub₂ _ 0
    obtain ⟨x₃, hx₃⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ X₀ hS x₁ hx₂ hn
    have hx₃_zero : x₃ = 0 := @Subsingleton.elim _ hSub₃ x₃ 0
    rw [← hx₃, hx₃_zero, CategoryTheory.Abelian.Ext.zero_comp]

  have hSubExact₁_inj : ∀ {C_ab : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} C_ab]
      [CategoryTheory.Abelian C_ab] [CategoryTheory.HasExt.{u} C_ab]
      (X₀ : C_ab) {S : CategoryTheory.ShortComplex C_ab} (hS : S.ShortExact)
      [CategoryTheory.Injective S.X₂] (n₀ : ℕ),
      Subsingleton (CategoryTheory.Abelian.Ext.{u} X₀ S.X₃ n₀) →
      Subsingleton (CategoryTheory.Abelian.Ext.{u} X₀ S.X₁ (n₀ + 1)) := by
    intro C_ab _ _ _ X₀ S hS _ n₀ hSub₃
    refine hSubExact₁ X₀ hS rfl hSub₃ ?_
    exact subsingleton_of_forall_eq 0 (fun z => CategoryTheory.Abelian.Ext.eq_zero_of_injective z)

  have hSubExact₂ : ∀ {C_ab : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} C_ab]
      [CategoryTheory.Abelian C_ab] [CategoryTheory.HasExt.{u} C_ab]
      (X₀ : C_ab) {S : CategoryTheory.ShortComplex C_ab} (hS : S.ShortExact) (n : ℕ),
      Subsingleton (CategoryTheory.Abelian.Ext.{u} X₀ S.X₁ n) →
      Subsingleton (CategoryTheory.Abelian.Ext.{u} X₀ S.X₃ n) →
      Subsingleton (CategoryTheory.Abelian.Ext.{u} X₀ S.X₂ n) := by
    intro C_ab _ _ _ X₀ S hS n hSub₁ hSub₃
    refine subsingleton_of_forall_eq 0 (fun x₂ => ?_)
    have hx₃ : x₂.comp (CategoryTheory.Abelian.Ext.mk₀ S.g) (Nat.add_zero n) = 0 :=
      @Subsingleton.elim _ hSub₃ _ 0
    obtain ⟨x₁, hx₁⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ X₀ hS x₂ hx₃
    have hx₁_zero : x₁ = 0 := @Subsingleton.elim _ hSub₁ x₁ 0
    rw [← hx₁, hx₁_zero, CategoryTheory.Abelian.Ext.zero_comp]

  have hSubExact₃_inj : ∀ {C_ab : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} C_ab]
      [CategoryTheory.Abelian C_ab] [CategoryTheory.HasExt.{u} C_ab]
      (X₀ : C_ab) {S : CategoryTheory.ShortComplex C_ab} (hS : S.ShortExact)
      [CategoryTheory.Injective S.X₂] (r₀ : ℕ),
      Subsingleton (CategoryTheory.Abelian.Ext.{u} X₀ S.X₁ ((r₀ + 1) + 1)) →
      Subsingleton (CategoryTheory.Abelian.Ext.{u} X₀ S.X₃ (r₀ + 1)) := by
    intro C_ab _ _ _ X₀ S hS _ r₀ hSub₁
    refine subsingleton_of_forall_eq 0 (fun y => ?_)
    have hy0 : y.comp hS.extClass (rfl : (r₀ + 1) + 1 = (r₀ + 1) + 1) = 0 :=
      @Subsingleton.elim _ hSub₁ _ 0
    obtain ⟨z, hz⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ X₀ hS y
      (rfl : (r₀ + 1) + 1 = (r₀ + 1) + 1) hy0
    have hz0 : z = 0 := CategoryTheory.Abelian.Ext.eq_zero_of_injective z
    rw [← hz, hz0, CategoryTheory.Abelian.Ext.zero_comp]

  have hSplitSES : ∀ {C_ab : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} C_ab]
      [CategoryTheory.Abelian C_ab] {A B : C_ab} (u : A ⟶ B),
      ∃ (h₁ : CategoryTheory.Limits.kernel.ι u ≫ CategoryTheory.Limits.factorThruImage u = 0)
        (h₂ : CategoryTheory.Limits.image.ι u ≫ CategoryTheory.Limits.cokernel.π u = 0),
        (CategoryTheory.ShortComplex.mk
          (CategoryTheory.Limits.kernel.ι u)
          (CategoryTheory.Limits.factorThruImage u) h₁).ShortExact ∧
        (CategoryTheory.ShortComplex.mk
          (CategoryTheory.Limits.image.ι u)
          (CategoryTheory.Limits.cokernel.π u) h₂).ShortExact := by
    intro C_ab _ _ A B u
    have h₁ : CategoryTheory.Limits.kernel.ι u ≫ CategoryTheory.Limits.factorThruImage u = 0 := by
      rw [← CategoryTheory.cancel_mono (CategoryTheory.Limits.image.ι u),
        CategoryTheory.Category.assoc, CategoryTheory.Limits.image.fac,
        CategoryTheory.Limits.kernel.condition, CategoryTheory.Limits.zero_comp]
    have h₂ : CategoryTheory.Limits.image.ι u ≫ CategoryTheory.Limits.cokernel.π u = 0 := by
      rw [← CategoryTheory.cancel_epi (CategoryTheory.Limits.factorThruImage u),
        ← CategoryTheory.Category.assoc, CategoryTheory.Limits.image.fac,
        CategoryTheory.Limits.cokernel.condition, CategoryTheory.Limits.comp_zero]
    have hk : CategoryTheory.Limits.IsLimit
        (CategoryTheory.Limits.KernelFork.ofι (CategoryTheory.Limits.kernel.ι u) h₁) :=
      CategoryTheory.Limits.KernelFork.IsLimit.ofι _ _
        (fun s hs => CategoryTheory.Limits.kernel.lift u s (by
          rw [← CategoryTheory.Limits.image.fac u, ← CategoryTheory.Category.assoc,
            hs, CategoryTheory.Limits.zero_comp]))
        (fun _ _ => CategoryTheory.Limits.kernel.lift_ι _ _ _)
        (fun _ _ m₀ hm₀ => by
          rw [← CategoryTheory.cancel_mono (CategoryTheory.Limits.kernel.ι u),
            hm₀, CategoryTheory.Limits.kernel.lift_ι])
    have hc : CategoryTheory.Limits.IsColimit
        (CategoryTheory.Limits.CokernelCofork.ofπ (CategoryTheory.Limits.cokernel.π u) h₂) :=
      CategoryTheory.Limits.CokernelCofork.IsColimit.ofπ _ _
        (fun s hs => CategoryTheory.Limits.cokernel.desc u s (by
          rw [← CategoryTheory.Limits.image.fac u, CategoryTheory.Category.assoc,
            hs, CategoryTheory.Limits.comp_zero]))
        (fun _ _ => CategoryTheory.Limits.cokernel.π_desc _ _ _)
        (fun _ _ m₀ hm₀ => by
          rw [← CategoryTheory.cancel_epi (CategoryTheory.Limits.cokernel.π u),
            hm₀, CategoryTheory.Limits.cokernel.π_desc])
    exact ⟨h₁, h₂,
      CategoryTheory.ShortComplex.ShortExact.mk'
        (CategoryTheory.ShortComplex.exact_of_f_is_kernel _ hk) inferInstance inferInstance,
      CategoryTheory.ShortComplex.ShortExact.mk'
        (CategoryTheory.ShortComplex.exact_of_g_is_cokernel _ hc) inferInstance inferInstance⟩

  have hTorsionKerCoker : ∀ {C_ab : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} C_ab]
      [CategoryTheory.Abelian C_ab] {A B : C_ab} (u : A ⟶ B),
      ℓ • CategoryTheory.CategoryStruct.id A = 0 →
      ℓ • CategoryTheory.CategoryStruct.id B = 0 →
      ℓ • CategoryTheory.CategoryStruct.id (CategoryTheory.Limits.kernel u) = 0 ∧
      ℓ • CategoryTheory.CategoryStruct.id (CategoryTheory.Limits.cokernel u) = 0 := by
    intro C_ab _ _ A B u hA hB
    refine ⟨?_, ?_⟩
    · rw [← CategoryTheory.cancel_mono (CategoryTheory.Limits.kernel.ι u),
        CategoryTheory.Limits.zero_comp, CategoryTheory.Preadditive.nsmul_comp,
        CategoryTheory.Category.id_comp,
        ← CategoryTheory.Category.comp_id (CategoryTheory.Limits.kernel.ι u),
        ← CategoryTheory.Preadditive.comp_nsmul, hA, CategoryTheory.Limits.comp_zero]
    · rw [← CategoryTheory.cancel_epi (CategoryTheory.Limits.cokernel.π u),
        CategoryTheory.Limits.comp_zero, CategoryTheory.Preadditive.comp_nsmul,
        CategoryTheory.Category.comp_id,
        ← CategoryTheory.Category.id_comp (CategoryTheory.Limits.cokernel.π u),
        ← CategoryTheory.Preadditive.nsmul_comp, hB, CategoryTheory.Limits.zero_comp]

  let η : ↥V := genericPoint ↥V
  let S_η : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (V.presheaf.stalk η)
  let g : Quiver.Hom S_η V := V.fromSpecStalk η
  let Fℤ_V := (CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}).obj
    (AddCommGrpCat.of (ULift.{u} ℤ))
  let Fℤ_η := (CategoryTheory.constantSheaf S_η.smallEtaleTopology AddCommGrpCat.{u}).obj
    (AddCommGrpCat.of (ULift.{u} ℤ))

  obtain ⟨hCont, P_pull, adj_g, hAdd_pull, hAdd_push, hLim_pull, hColim_pull,
    hInjPush, e₀, he₀_nat⟩ := weil_alt_cd_etale_pullback_adjunction_and_H0 g
  have : (weilAltCdSitePullback g).IsContinuous
      V.smallEtaleTopology S_η.smallEtaleTopology := hCont
  let P_push := (weilAltCdSitePullback g).sheafPushforwardContinuous AddCommGrpCat.{u}
    V.smallEtaleTopology S_η.smallEtaleTopology
  have : P_pull.Additive := hAdd_pull
  have : P_push.Additive := hAdd_push
  have : CategoryTheory.Limits.PreservesFiniteLimits P_pull := hLim_pull
  have : CategoryTheory.Limits.PreservesFiniteColimits P_pull := hColim_pull

  let G := P_pull.obj ℱ
  let u_ℱ : ℱ ⟶ P_push.obj G := adj_g.unit.app ℱ
  have hℓ_G : ℓ • CategoryTheory.CategoryStruct.id G = 0 := by
    change ℓ • CategoryTheory.CategoryStruct.id (P_pull.obj ℱ) = 0
    rw [← P_pull.map_id, ← CategoryTheory.Functor.map_nsmul, hℓ_ℱ, CategoryTheory.Functor.map_zero]
  have hℓ_PG : ℓ • CategoryTheory.CategoryStruct.id (P_push.obj G) = 0 := by
    rw [← P_push.map_id, ← CategoryTheory.Functor.map_nsmul, hℓ_G, CategoryTheory.Functor.map_zero]
  obtain ⟨hℓ_𝒦, hℓ_𝒞⟩ := hTorsionKerCoker u_ℱ hℓ_ℱ hℓ_PG
  obtain ⟨hStalk_𝒦, hStalk_𝒞⟩ :=
    weil_alt_cd_generic_pushforward_fullyFaithful_and_excision V P_pull adj_g ℱ
  have hSub_𝒦 : Subsingleton ((CategoryTheory.Limits.kernel u_ℱ).H q) :=
    hExcVanish _ hℓ_𝒦 hStalk_𝒦 q (by omega)
  have hSub_𝒞 : Subsingleton ((CategoryTheory.Limits.cokernel u_ℱ).H (q - 1)) :=
    hExcVanish _ hℓ_𝒞 hStalk_𝒞 (q - 1) (by omega)
  obtain ⟨hu_h₁, hu_h₂, hSE_ker_im, hSE_im_coker⟩ := hSplitSES u_ℱ

  have hInjStep : ∀ M : CategoryTheory.Sheaf S_η.smallEtaleTopology AddCommGrpCat.{u},
      ∃ (Q : CategoryTheory.Sheaf S_η.smallEtaleTopology AddCommGrpCat.{u})
        (I : CategoryTheory.Sheaf S_η.smallEtaleTopology AddCommGrpCat.{u})
        (_ : CategoryTheory.Injective I)
        (j : M ⟶ I) (p : I ⟶ Q) (hjp : j ≫ p = 0),
        (CategoryTheory.ShortComplex.mk j p hjp).ShortExact := by
    intro M
    let j : M ⟶ CategoryTheory.Injective.under M := CategoryTheory.Injective.ι M
    exact ⟨CategoryTheory.Limits.cokernel j,
      CategoryTheory.Injective.under M,
      inferInstance,
      j,
      CategoryTheory.Limits.cokernel.π j,
      CategoryTheory.Limits.cokernel.condition j,
      CategoryTheory.ShortComplex.ShortExact.mk'
        (CategoryTheory.ShortComplex.exact_of_g_is_cokernel _
          (CategoryTheory.Limits.cokernelIsCokernel j))
        inferInstance inferInstance⟩

  obtain ⟨W, hW0, hW_step⟩ :
      ∃ W : ℕ → CategoryTheory.Sheaf S_η.smallEtaleTopology AddCommGrpCat.{u},
        W 0 = G ∧
        ∀ s : ℕ,
          ∃ (I : CategoryTheory.Sheaf S_η.smallEtaleTopology AddCommGrpCat.{u})
            (_ : CategoryTheory.Injective I)
            (j : W s ⟶ I) (p : I ⟶ W (s + 1)) (hjp : j ≫ p = 0),
            (CategoryTheory.ShortComplex.mk j p hjp).ShortExact :=
    ⟨Nat.rec G (fun _ Ws => (hInjStep Ws).choose),
      rfl,
      fun s => (hInjStep _).choose_spec⟩

  have hFieldShift : ∀ t : ℕ, t ≤ q - 1 → Subsingleton ((W t).H (q - t)) := by
    intro t
    induction t with
    | zero =>
      intro _
      rw [Nat.sub_zero, hW0]
      exact hGenField G hℓ_G q (by omega)
    | succ t ih =>
      intro ht1
      have hprev : Subsingleton ((W t).H (q - t)) := ih (by omega)
      set r₀ := q - (t + 1) - 1
      have hdeg1 : q - (t + 1) = r₀ + 1 := by omega
      have hdeg2 : q - t = (r₀ + 1) + 1 := by omega
      rw [hdeg2] at hprev
      rw [hdeg1]
      obtain ⟨I_t, hInj_It, j_t, p_t, hjp_t, hSE_Wt⟩ := hW_step t
      exact hSubExact₃_inj Fℤ_η hSE_Wt r₀ hprev

  have hSub_Wq1 : Subsingleton ((W (q - 1)).H 1) := by
    have h1 := hFieldShift (q - 1) (le_refl _)
    have hdeg : q - (q - 1) = 1 := by omega
    rwa [hdeg] at h1

  have hRShiftGen : ∀ (t r : ℕ), 1 ≤ r →
      Nonempty (weilAltCdHigherDirectImage g r (W t) ≅
        weilAltCdHigherDirectImage g (r + t) G) := by
    intro t
    induction t with
    | zero =>
      intro r _
      rw [hW0, Nat.add_zero]
      exact ⟨CategoryTheory.Iso.refl _⟩
    | succ t ih =>
      intro r hr
      obtain ⟨I_t, hInj_I, j_t, p_t, hjp_t, hSE_Wt⟩ := hW_step t
      obtain ⟨e₁⟩ := (weil_alt_cd_higherDirectImage_injective_step g
        (W t) I_t (W (t + 1)) j_t p_t hjp_t hSE_Wt).1 r hr
      obtain ⟨e₂⟩ := ih (r + 1) (by omega)
      have hadd : (r + 1) + t = r + (t + 1) := by omega
      exact ⟨e₁.trans (e₂.trans (CategoryTheory.eqToIso (by rw [hadd])))⟩

  have hRShift1 : ∀ t : ℕ,
      Nonempty (weilAltCdHigherDirectImage g 1 (W t) ≅
        weilAltCdHigherDirectImage g (t + 1) G) := by
    intro t
    obtain ⟨e⟩ := hRShiftGen t 1 (le_refl 1)
    exact ⟨e.trans (CategoryTheory.eqToIso (by rw [Nat.add_comm 1 t]))⟩

  have hSyzygy : ∀ k : ℕ, k ≤ q - 1 →
      Subsingleton ((P_push.obj (W (q - 1 - k))).H (k + 1)) := by
    intro k
    induction k with
    | zero =>
      intro _
      rw [Nat.sub_zero]
      obtain ⟨I₀, hInj_I₀, j₀, p₀, hjp₀, hSE_W₀⟩ := hW_step (q - 1)
      obtain ⟨ℬ, π_B, ι_B, δ_B, h₁, h₂, hfac, hSE1, hSE2⟩ :=
        (weil_alt_cd_higherDirectImage_injective_step g
          (W (q - 1)) I₀ (W ((q - 1) + 1)) j₀ p₀ hjp₀ hSE_W₀).2
      have : CategoryTheory.Injective (P_push.obj I₀) := hInjPush I₀ hInj_I₀
      have : CategoryTheory.Mono ι_B := hSE2.mono_f
      refine subsingleton_of_forall_eq 0 (fun x => ?_)
      have hx_I : x.comp (CategoryTheory.Abelian.Ext.mk₀ (P_push.map j₀))
          (Nat.add_zero 1) = 0 :=
        CategoryTheory.Abelian.Ext.eq_zero_of_injective _
      obtain ⟨b₀, hb₀⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ_V hSE1 x
        hx_I (Nat.zero_add 1)
      let c₀ : (P_push.obj (W ((q - 1) + 1))).H 0 :=
        b₀.comp (CategoryTheory.Abelian.Ext.mk₀ ι_B) (Nat.add_zero 0)
      have hc₀_ext : (e₀ (W ((q - 1) + 1)) c₀).comp hSE_W₀.extClass (Nat.zero_add 1) = 0 :=
        @Subsingleton.elim ((W (q - 1)).H 1) hSub_Wq1 _ 0
      obtain ⟨a₀', ha₀'⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ Fℤ_η
        hSE_W₀ (e₀ (W ((q - 1) + 1)) c₀) (Nat.zero_add 1) hc₀_ext
      let a₀ : (P_push.obj I₀).H 0 := (e₀ I₀).symm a₀'
      have ha₀_nat : e₀ (W ((q - 1) + 1))
          (a₀.comp (CategoryTheory.Abelian.Ext.mk₀ (P_push.map p₀)) (Nat.add_zero 0)) =
          e₀ (W ((q - 1) + 1)) c₀ := by
        rw [he₀_nat p₀ a₀, AddEquiv.apply_symm_apply, ha₀']
      have ha₀_p : a₀.comp (CategoryTheory.Abelian.Ext.mk₀ (P_push.map p₀))
          (Nat.add_zero 0) = c₀ :=
        (e₀ (W ((q - 1) + 1))).injective ha₀_nat
      have ha₀_split : (a₀.comp (CategoryTheory.Abelian.Ext.mk₀ π_B) (Nat.add_zero 0)).comp
          (CategoryTheory.Abelian.Ext.mk₀ ι_B) (Nat.add_zero 0) =
          b₀.comp (CategoryTheory.Abelian.Ext.mk₀ ι_B) (Nat.add_zero 0) := by
        rw [CategoryTheory.Abelian.Ext.comp_assoc a₀
            (CategoryTheory.Abelian.Ext.mk₀ π_B) (CategoryTheory.Abelian.Ext.mk₀ ι_B)
            (Nat.add_zero 0) (Nat.add_zero 0) (Nat.add_zero 0),
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ π_B ι_B, hfac]
        exact ha₀_p
      have hb₀_eq : b₀ = a₀.comp (CategoryTheory.Abelian.Ext.mk₀ π_B) (Nat.add_zero 0) :=
        (hExt0CancelMono Fℤ_V ι_B _ b₀ ha₀_split).symm
      rw [← hb₀, hb₀_eq,
        CategoryTheory.Abelian.Ext.comp_assoc a₀
          (CategoryTheory.Abelian.Ext.mk₀ π_B) hSE1.extClass
          (Nat.add_zero 0) (Nat.zero_add 1) (Nat.zero_add 1),
        hSE1.comp_extClass, CategoryTheory.Abelian.Ext.comp_zero]
    | succ k ih =>
      intro hk1
      set t := q - 1 - (k + 1)
      have ht_succ : t + 1 = q - 1 - k := by omega
      have ih' : Subsingleton ((P_push.obj (W (t + 1))).H (k + 1)) := by
        rw [ht_succ]
        exact ih (by omega)
      obtain ⟨I_t, hInj_It, j_t, p_t, hjp_t, hSE_Wt⟩ := hW_step t
      obtain ⟨ℬ, π_B, ι_B, δ_B, h₁, h₂, _hfac, hSE1, hSE2⟩ :=
        (weil_alt_cd_higherDirectImage_injective_step g
          (W t) I_t (W (t + 1)) j_t p_t hjp_t hSE_Wt).2
      have hSub_RG : Subsingleton ((weilAltCdHigherDirectImage g (t + 1) G).H k) := by
        by_cases hms : m < t + 1
        · have hStalkAll : ∀ x : ↥V,
              WeilAltCdStalkZeroAt V (weilAltCdHigherDirectImage g (t + 1) G) x :=
            (hRPush G hℓ_G (t + 1) (by omega)).1 hms
          have hZeroR : CategoryTheory.Limits.IsZero
              (weilAltCdHigherDirectImage g (t + 1) G) :=
            weil_alt_cd_stalk_zero_all_implies_isZero V _ hStalkAll
          exact CategoryTheory.Sheaf.subsingleton_H_of_isZero hZeroR k
        · exact (hRPush G hℓ_G (t + 1) (by omega)).2 (m - (t + 1)) (by omega) k (by omega)
      obtain ⟨isoR⟩ := hRShift1 t
      have hSub_R1 : Subsingleton ((weilAltCdHigherDirectImage g 1 (W t)).H k) :=
        hSubOfIso Fℤ_V isoR k hSub_RG
      have hSub_ℬ : Subsingleton (ℬ.H (k + 1)) :=
        hSubExact₁ Fℤ_V hSE2 rfl hSub_R1 ih'
      have : CategoryTheory.Injective (P_push.obj I_t) := hInjPush I_t hInj_It
      exact hSubExact₁_inj Fℤ_V hSE1 (k + 1) hSub_ℬ

  have hSub_PG : Subsingleton ((P_push.obj G).H q) := by
    have htop := hSyzygy (q - 1) (le_refl _)
    have h0 : q - 1 - (q - 1) = 0 := Nat.sub_self (q - 1)
    have hq_eq : (q - 1) + 1 = q := by omega
    rw [h0, hW0, hq_eq] at htop
    exact htop

  have hSub_Im : Subsingleton ((CategoryTheory.Limits.image u_ℱ).H q) :=
    hSubExact₁ Fℤ_V hSE_im_coker (by omega : (q - 1) + 1 = q) hSub_𝒞 hSub_PG
  exact hSubExact₂ Fℤ_V hSE_ker_im q hSub_𝒦 hSub_Im

theorem weil_polyP1_torsion_cohomological_dim_vanishing (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar k) :
    ∀ (δ r : ℕ),
      (∀ (F : CategoryTheory.Sheaf (weilPolyP1Over k δ).left.smallEtaleTopology AddCommGrpCat.{u})
          (q : ℕ),
        (ℓ ^ r) • CategoryTheory.CategoryStruct.id F = 0 →
        2 * δ < q →
        Subsingleton (F.H q)) ∧
      (∀ (q : ℕ) (U : (weilPolyP1Over k δ).left.Etale),
        AlgebraicGeometry.IsAffine
          ((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k δ).left).obj U).left →
        2 * δ < q →
        Subsingleton (weilEtaleLocalTorsionH (weilPolyP1Over k δ).left (ℓ ^ r) U q)) :=
by
  classical
  have hPrime : Nat.Prime ℓ := Fact.out
  have hℓ_ne : (ℓ : k) ≠ 0 := by
    intro h0
    have hdvd : ringChar k ∣ ℓ := (CharP.cast_eq_zero_iff k (ringChar k) ℓ).mp h0
    rcases CharP.char_is_prime_or_zero k (ringChar k) with hp | hz
    · rcases (Nat.dvd_prime hPrime).mp hdvd with h1 | heq
      · exact hp.ne_one h1
      · exact hℓ heq.symm
    · rw [hz, zero_dvd_iff] at hdvd
      exact hPrime.ne_zero hdvd
  have hRPushTorsion : ∀ {X S : AlgebraicGeometry.Scheme.{u}}
      (f : Quiver.Hom X S) (s : ℕ)
      (G : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}),
      ℓ • CategoryTheory.CategoryStruct.id G = 0 →
      ℓ • CategoryTheory.CategoryStruct.id (weilAltCdHigherDirectImage f s G) = 0 := by
    intro X S f s G hG
    letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) f :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
        (@AlgebraicGeometry.Etale) f :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B : CategoryTheory.Functor S.Etale X.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ f
    let P : CategoryTheory.Functor (Opposite S.Etale) AddCommGrpCat.{u} :=
      CategoryTheory.Functor.comp B.op (CategoryTheory.Sheaf.cohomologyPresheaf G s)
    let Shf := CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}
    have hP : ℓ • CategoryTheory.CategoryStruct.id P = 0 := by
      apply CategoryTheory.NatTrans.ext
      funext U
      rw [CategoryTheory.NatTrans.app_nsmul, CategoryTheory.NatTrans.id_app,
        CategoryTheory.NatTrans.app_zero]
      ext z
      let z' : CategoryTheory.Abelian.Ext.{u} _ G s := z
      have hz : ∀ c : ℕ,
          c • z' = z'.comp (CategoryTheory.Abelian.Ext.mk₀ (c • 𝟙 G)) (Nat.add_zero s) := by
        intro c
        induction c with
        | zero =>
          rw [zero_nsmul, zero_nsmul, CategoryTheory.Abelian.Ext.mk₀_zero,
            CategoryTheory.Abelian.Ext.comp_zero]
        | succ n ih =>
          rw [succ_nsmul, succ_nsmul, ih, CategoryTheory.Abelian.Ext.mk₀_add,
            CategoryTheory.Abelian.Ext.comp_add, CategoryTheory.Abelian.Ext.comp_mk₀_id]
      change ℓ • z' = 0
      rw [hz ℓ, hG, CategoryTheory.Abelian.Ext.mk₀_zero, CategoryTheory.Abelian.Ext.comp_zero]
    change ℓ • CategoryTheory.CategoryStruct.id (Shf.obj P) = 0
    rw [← Shf.map_id, ← CategoryTheory.Functor.map_nsmul, hP, CategoryTheory.Functor.map_zero]
  have hGenUnique : ∀ (V_s : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsIntegral V_s]
      (e : ℕ), 1 ≤ e → topologicalKrullDim V_s = (e : WithBot ℕ∞) →
      ∀ x : ↥V_s,
        ((e - 1 : ℕ) : WithBot ℕ∞) < topologicalKrullDim ↥(closure ({x} : Set ↥V_s)) →
        x = genericPoint ↥V_s := by
    intro V_s _ e he hDim x hx
    have hcl_univ : closure ({x} : Set ↥V_s) = Set.univ := by
      by_contra hne
      obtain ⟨v₀, hv₀⟩ : ∃ v₀ : ↥V_s, v₀ ∉ closure ({x} : Set ↥V_s) := by
        by_contra hall
        push_neg at hall
        exact hne (Set.eq_univ_of_forall hall)
      have hEmb : Topology.IsClosedEmbedding (Subtype.val : ↥(closure ({x} : Set ↥V_s)) → ↥V_s) :=
        isClosed_closure.isClosedEmbedding_subtypeVal
      let Φ : TopologicalSpace.IrreducibleCloseds ↥(closure ({x} : Set ↥V_s)) →o
          TopologicalSpace.IrreducibleCloseds ↥V_s :=
        { toFun := fun C =>
            { carrier := Subtype.val '' C.carrier
              isIrreducible' := C.isIrreducible'.image Subtype.val continuous_subtype_val.continuousOn
              isClosed' := hEmb.isClosedMap C.carrier C.isClosed' }
          monotone' := fun C₁ C₂ hle => Set.image_mono hle }
      have hΦ_strict : StrictMono Φ := by
        intro C₁ C₂ hlt
        rw [lt_iff_le_not_ge] at hlt ⊢
        refine ⟨Φ.monotone hlt.1, fun hge => hlt.2 ?_⟩
        intro y hy
        obtain ⟨z, hz, hzy⟩ := hge ⟨y, hy, rfl⟩
        cases Subtype.val_injective hzy
        exact hz
      let T_top : TopologicalSpace.IrreducibleCloseds ↥V_s :=
        { carrier := Set.univ
          isIrreducible' := IrreducibleSpace.isIrreducible_univ ↥V_s
          isClosed' := isClosed_univ }
      have hΦ_lt_top : ∀ C, Φ C < T_top := by
        intro C
        rw [lt_iff_le_not_ge]
        refine ⟨fun _ _ => trivial, fun hge => ?_⟩
        have hv_top : v₀ ∈ (T_top : Set ↥V_s) := trivial
        have hv_im : v₀ ∈ Subtype.val '' (C : Set ↥(closure ({x} : Set ↥V_s))) := hge hv_top
        obtain ⟨z, _, hzv⟩ := hv_im
        rw [← hzv] at hv₀
        exact hv₀ z.2
      let x_sub : ↥(closure ({x} : Set ↥V_s)) := ⟨x, subset_closure (Set.mem_singleton x)⟩
      haveI : Nonempty (TopologicalSpace.IrreducibleCloseds ↥(closure ({x} : Set ↥V_s))) :=
        ⟨{ carrier := closure ({x_sub} : Set _)
           isIrreducible' := isIrreducible_singleton.closure
           isClosed' := isClosed_closure }⟩
      have hle_dim : topologicalKrullDim ↥(closure ({x} : Set ↥V_s)) ≤ ((e - 1 : ℕ) : WithBot ℕ∞) := by
        change Order.krullDim (TopologicalSpace.IrreducibleCloseds ↥(closure ({x} : Set ↥V_s))) ≤ _
        rw [Order.krullDim_eq_iSup_length]
        suffices hsup :
            (⨆ p : LTSeries (TopologicalSpace.IrreducibleCloseds ↥(closure ({x} : Set ↥V_s))),
              (p.length : ℕ∞)) ≤ (e - 1 : ℕ) by
          exact WithBot.coe_le_coe.mpr hsup
        refine iSup_le fun l => ?_
        let l' : LTSeries (TopologicalSpace.IrreducibleCloseds ↥V_s) :=
          (l.map Φ hΦ_strict).snoc T_top (by
            simpa using hΦ_lt_top l.last)
        have hlen_le : (l'.length : WithBot ℕ∞) ≤ topologicalKrullDim V_s :=
          Order.LTSeries.length_le_krullDim l'
        rw [hDim] at hlen_le
        have hlen_eq : l'.length = l.length + 1 := by
          simp [l']
        rw [hlen_eq] at hlen_le
        have hnat : l.length + 1 ≤ e := by
          exact_mod_cast hlen_le
        have hnat2 : l.length ≤ e - 1 := by omega
        exact_mod_cast hnat2
      exact not_lt_of_ge hle_dim hx
    have hgen_x : IsGenericPoint x (Set.univ : Set ↥V_s) := by
      rw [IsGenericPoint, hcl_univ]
    exact hgen_x.eq (genericPoint_spec ↥V_s)
  have hProperModPrime : ∀ (m₀ : ℕ) (q₀ : ℕ), 2 * m₀ < q₀ →
      ∀ (W : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        [AlgebraicGeometry.IsProper W.hom],
        topologicalKrullDim W.left ≤ (m₀ : WithBot ℕ∞) →
        ∀ (ℱ : CategoryTheory.Sheaf W.left.smallEtaleTopology AddCommGrpCat.{u}),
          ℓ • CategoryTheory.CategoryStruct.id ℱ = 0 →
          Subsingleton (ℱ.H q₀) := by
    intro m₀
    induction m₀ using Nat.strongRecOn with
    | ind m₀ ih =>
      intro q₀ hq₀ W _ hDimW ℱ hℓ_ℱ
      refine weil_alt_cd_noetherian_closed_reduction_and_dim_zero k m₀ ℓ q₀ hq₀
        (fun e he_pos he_le V _ _ hDimV 𝒢 hℓ_𝒢 => ?_) W hDimW ℱ hℓ_ℱ
      by_cases he_lt : e < m₀
      · exact ih e he_lt q₀ (by omega) V (le_of_eq hDimV) 𝒢 hℓ_𝒢
      · have hqe : 2 * e < q₀ := by omega
        have hGen := weil_alt_cd_generic_pushforward_stalk_support k e ℓ hℓ_ne
          (fun κ K _ _ _ _ e₀ s₀ hℓ_κ hTr hs₀ G₀ hℓ_G₀ =>
            weil_alt_cd_tsen_tate_field_vanishing κ K e₀ ℓ s₀ hℓ_κ hTr hs₀ G₀ hℓ_G₀)
          V hDimV
        refine weil_alt_cd_generic_excision_and_leray_syzygy V.left e ℓ q₀ he_pos hqe 𝒢 hℓ_𝒢
          (fun ℋ hℓ_ℋ hStalk_η r₀ hr₀ => ?_)
          (fun G hℓ_G n hn => (hGen G hℓ_G).1 n hn)
          (fun G hℓ_G s hs => ⟨fun hes x => ((hGen G hℓ_G).2 s hs).1 hes x,
            fun d hds r₀ hr₀ => ?_⟩)
        · have he1_lt : e - 1 < m₀ := by omega
          refine weil_alt_cd_stalk_support_colimit_vanishing k (e - 1) ℓ r₀
            (fun Z _ hDimZ 𝒢₀ hℓ_𝒢₀ => ih (e - 1) he1_lt r₀ hr₀ Z hDimZ 𝒢₀ hℓ_𝒢₀)
            V ℋ hℓ_ℋ (fun x hx => ?_)
          have hx_eq : x = genericPoint ↥V.left := hGenUnique V.left e he_pos hDimV x hx
          rwa [hx_eq]
        · have hd_lt : d < m₀ := by omega
          let η : ↥V.left := genericPoint ↥V.left
          let g : Quiver.Hom (AlgebraicGeometry.Spec (V.left.presheaf.stalk η)) V.left :=
            V.left.fromSpecStalk η
          exact weil_alt_cd_stalk_support_colimit_vanishing k d ℓ r₀
            (fun Z _ hDimZ 𝒢₀ hℓ_𝒢₀ => ih d hd_lt r₀ hr₀ Z hDimZ 𝒢₀ hℓ_𝒢₀)
            V (weilAltCdHigherDirectImage g s G) (hRPushTorsion g s G hℓ_G)
            (((hGen G hℓ_G).2 s hs).2 d hds)
  intro δ r
  obtain ⟨hProp_δ, hInt_δ, hSm_δ⟩ := weil_polyP1_proper_smooth_integral k δ
  letI : AlgebraicGeometry.IsProper (weilPolyP1Over k δ).hom := hProp_δ
  letI : AlgebraicGeometry.IsIntegral (weilPolyP1Over k δ).left := hInt_δ
  letI : AlgebraicGeometry.SmoothOfRelativeDimension δ (weilPolyP1Over k δ).hom := hSm_δ
  have hDim_δ : topologicalKrullDim (weilPolyP1Over k δ).left = (δ : WithBot ℕ∞) :=
    weil_smooth_integral_krullDim_over_field k δ (weilPolyP1Over k δ) hInt_δ
  have hModPrime_δ :
      ∀ (F : CategoryTheory.Sheaf (weilPolyP1Over k δ).left.smallEtaleTopology AddCommGrpCat.{u})
        (q : ℕ),
        ℓ • CategoryTheory.CategoryStruct.id F = 0 →
        2 * δ < q →
        Subsingleton (F.H q) :=
    fun F q hTor hq =>
      hProperModPrime δ q hq (weilPolyP1Over k δ) (le_of_eq hDim_δ) F hTor
  have hConj1 :
      ∀ (r₀ : ℕ)
        (F : CategoryTheory.Sheaf (weilPolyP1Over k δ).left.smallEtaleTopology AddCommGrpCat.{u})
        (q : ℕ),
        (ℓ ^ r₀) • CategoryTheory.CategoryStruct.id F = 0 →
        2 * δ < q →
        Subsingleton (F.H q) := by
    intro r₀
    induction r₀ with
    | zero =>
      intro F q hTor _
      rw [pow_zero, one_nsmul] at hTor
      refine subsingleton_of_forall_eq 0 fun w => ?_
      have hw : w.comp (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id F))
          (Nat.add_zero q) = w := by
        rw [CategoryTheory.Abelian.Ext.comp_mk₀_id]
      rw [← hw, hTor, CategoryTheory.Abelian.Ext.mk₀_zero, CategoryTheory.Abelian.Ext.comp_zero]
    | succ r₀ ih_r =>
      intro F q hTor hq
      let S_δ := (weilPolyP1Over k δ).left
      let φ : F ⟶ F := ℓ • CategoryTheory.CategoryStruct.id F
      let K := CategoryTheory.Limits.kernel φ
      let ι_K : K ⟶ F := CategoryTheory.Limits.kernel.ι φ
      let C_coim := CategoryTheory.Abelian.coimage φ
      let π_coim : F ⟶ C_coim := CategoryTheory.Abelian.coimage.π φ
      let m_coim : C_coim ⟶ F := CategoryTheory.Abelian.factorThruCoimage φ
      let SC := CategoryTheory.ShortComplex.mk ι_K π_coim (CategoryTheory.Limits.cokernel.condition ι_K)
      have hSES : SC.ShortExact :=
        CategoryTheory.ShortComplex.ShortExact.mk'
          (CategoryTheory.ShortComplex.exact_of_g_is_cokernel SC
            (CategoryTheory.Limits.cokernelIsCokernel ι_K))
          inferInstance inferInstance
      have hK_tor : ℓ • CategoryTheory.CategoryStruct.id K = 0 := by
        apply (cancel_mono ι_K).mp
        calc
          (ℓ • CategoryTheory.CategoryStruct.id K) ≫ ι_K
            = ℓ • (CategoryTheory.CategoryStruct.id K ≫ ι_K) := CategoryTheory.Preadditive.nsmul_comp _ _ _
          _ = ℓ • (ι_K ≫ CategoryTheory.CategoryStruct.id F) := by
              rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]
          _ = ι_K ≫ (ℓ • CategoryTheory.CategoryStruct.id F) :=
              (CategoryTheory.Preadditive.comp_nsmul _ _ _).symm
          _ = ι_K ≫ φ := rfl
          _ = 0 := CategoryTheory.Limits.kernel.condition φ
          _ = 0 ≫ ι_K := (CategoryTheory.Limits.zero_comp).symm
      have hC_tor : (ℓ ^ r₀) • CategoryTheory.CategoryStruct.id C_coim = 0 := by
        apply (cancel_epi π_coim).mp
        rw [CategoryTheory.Limits.comp_zero]
        apply (cancel_mono m_coim).mp
        rw [CategoryTheory.Limits.zero_comp]
        calc
          (π_coim ≫ ((ℓ ^ r₀) • CategoryTheory.CategoryStruct.id C_coim)) ≫ m_coim
            = ((ℓ ^ r₀) • (π_coim ≫ CategoryTheory.CategoryStruct.id C_coim)) ≫ m_coim := by
                rw [CategoryTheory.Preadditive.comp_nsmul]
          _ = ((ℓ ^ r₀) • π_coim) ≫ m_coim := by rw [CategoryTheory.Category.comp_id]
          _ = (ℓ ^ r₀) • (π_coim ≫ m_coim) := CategoryTheory.Preadditive.nsmul_comp _ _ _
          _ = (ℓ ^ r₀) • φ := by rw [CategoryTheory.Abelian.coimage.fac φ]
          _ = (ℓ ^ r₀) • (ℓ • CategoryTheory.CategoryStruct.id F) := rfl
          _ = (ℓ ^ r₀ * ℓ) • CategoryTheory.CategoryStruct.id F :=
              (mul_nsmul' (CategoryTheory.CategoryStruct.id F) (ℓ ^ r₀) ℓ).symm
          _ = (ℓ ^ (r₀ + 1)) • CategoryTheory.CategoryStruct.id F := by rw [← pow_succ]
          _ = 0 := hTor
      have hSubK : Subsingleton (K.H q) := hModPrime_δ K q hK_tor hq
      have hSubC : Subsingleton (C_coim.H q) := ih_r C_coim q hC_tor hq
      let Fℤ := (CategoryTheory.constantSheaf S_δ.smallEtaleTopology AddCommGrpCat.{u}).obj
        (AddCommGrpCat.of (ULift.{u} ℤ))
      refine subsingleton_of_forall_eq 0 fun w => ?_
      have hw_C : w.comp (CategoryTheory.Abelian.Ext.mk₀ π_coim) (Nat.add_zero q) = 0 :=
        hSubC.elim _ 0
      obtain ⟨w_K, hw_K⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ Fℤ hSES w hw_C
      rw [← hw_K, hSubK.elim w_K 0, CategoryTheory.Abelian.Ext.zero_comp]
  refine ⟨hConj1 r, fun q U _ hq => ?_⟩
  let S_δ := (weilPolyP1Over k δ).left
  let J := S_δ.smallEtaleTopology
  let m := ℓ ^ r
  let A₀ := AddCommGrpCat.of (ZMod m)
  let A_m := AddCommGrpCat.uliftFunctor.{u, 0}.obj A₀
  have hA₀ : m • CategoryTheory.CategoryStruct.id A₀ = 0 := by
    ext x
    change m • x = 0
    rw [nsmul_eq_mul, ZMod.natCast_self, zero_mul]
  have hAm : m • CategoryTheory.CategoryStruct.id A_m = 0 := by
    change m • CategoryTheory.CategoryStruct.id (AddCommGrpCat.uliftFunctor.{u, 0}.obj A₀) = 0
    rw [← AddCommGrpCat.uliftFunctor.{u, 0}.map_id, ← CategoryTheory.Functor.map_nsmul,
      hA₀, CategoryTheory.Functor.map_zero]
  let P₀ := CategoryTheory.Presheaf.freeYoneda U A_m
  have hV : ∀ V : Opposite S_δ.Etale,
      m • CategoryTheory.CategoryStruct.id (∐ fun (_ : V.unop ⟶ U) => A_m) = 0 := by
    intro V
    apply CategoryTheory.Limits.Sigma.hom_ext
    intro g
    rw [CategoryTheory.Limits.comp_zero, CategoryTheory.Preadditive.comp_nsmul,
      CategoryTheory.Category.comp_id, ← CategoryTheory.Category.id_comp
        (CategoryTheory.Limits.Sigma.ι (fun _ => A_m) g),
      ← CategoryTheory.Preadditive.nsmul_comp, hAm, CategoryTheory.Limits.zero_comp]
  have hP₀ : m • CategoryTheory.CategoryStruct.id P₀ = 0 := by
    apply CategoryTheory.NatTrans.ext
    funext V
    rw [CategoryTheory.NatTrans.app_nsmul, CategoryTheory.NatTrans.id_app,
      CategoryTheory.NatTrans.app_zero]
    exact hV V
  let Shf := CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}
  have hLocTor : (ℓ ^ r) • CategoryTheory.CategoryStruct.id
      (weilEtaleLocalTorsionSheaf S_δ (ℓ ^ r) U) = 0 := by
    change m • CategoryTheory.CategoryStruct.id (Shf.obj P₀) = 0
    rw [← Shf.map_id, ← CategoryTheory.Functor.map_nsmul, hP₀, CategoryTheory.Functor.map_zero]
  exact hConj1 r (weilEtaleLocalTorsionSheaf S_δ (ℓ ^ r) U) q hLocTor hq

theorem weil_gysin_ab_dim_zero_field_norm_and_unit_comparison (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (K : Type u) [Field K] :
    let S_K := AlgebraicGeometry.Spec (CommRingCat.of K)
    ∃ e₀ : ∀ r : ℕ, weilEtaleTorsionH S_K (ℓ ^ r) 0 ≃+ ZMod (ℓ ^ r),
      (∀ (r : ℕ) (u : weilEtaleTorsionH S_K (ℓ ^ (r + 1)) 0),
        ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r)) (e₀ (r + 1) u) =
          e₀ r (weilEtaleTorsionTransition S_K ℓ r 0 u)) ∧
      (∀ (r : ℕ) (θ₀ : weilEtaleModuleH S_K (ℓ ^ r) 0 →+ weilEtaleTorsionH S_K (ℓ ^ r) 0),
        WeilIsModuleToTorsionComparison S_K (ℓ ^ r) 0 θ₀ →
        e₀ r (θ₀ (CategoryTheory.Abelian.Ext.mk₀
          (CategoryTheory.CategoryStruct.id (weilEtaleModuleUnit S_K (ℓ ^ r))))) = 1) :=
by
  classical
  intro S_K
  let J := S_K.smallEtaleTopology
  let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
    @AlgebraicGeometry.Etale
  let T₀ : S_K.Etale := weilEtaleIdTerminal.{u} S_K
  let hT₀ : CategoryTheory.Limits.IsTerminal T₀ := weilEtaleIdTerminalIsTerminal.{u} S_K
  let adj₀ := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT₀
  let Cℤ := CategoryTheory.constantSheaf J AddCommGrpCat.{u}
  let Aℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
  let Fℤ : CategoryTheory.Sheaf J AddCommGrpCat.{u} := Cℤ.obj Aℤ
  let AM : ℕ → AddCommGrpCat.{u} :=
    fun m => AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
  let FM : ℕ → CategoryTheory.Sheaf J AddCommGrpCat.{u} :=
    fun m => weilEtaleTorsionSheaf S_K m
  
  have hUnique_SK : Unique ↥S_K :=
    @AlgebraicGeometry.Scheme.instUniqueCarrierCarrierCommRingCatSpecOf K _
  let pt₀ : ↥S_K := hUnique_SK.default
  have hEtLeft : ∀ {U₁ U₂ : S_K.Etale} (f : U₁ ⟶ U₂), AlgebraicGeometry.Etale f.left := by
    intro U₁ U₂ f
    have hcomp : P_et (f.left ≫ U₂.hom) := by
      rw [CategoryTheory.MorphismProperty.Over.w f]
      exact U₁.prop
    exact @CategoryTheory.MorphismProperty.of_postcomp _ _ P_et P_et _ _ _ _
      f.left U₂.hom U₂.prop hcomp
  have : CategoryTheory.MorphismProperty.IsStableUnderComposition P_et :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  let K_pre : CategoryTheory.Pretopology S_K.Etale :=
    AlgebraicGeometry.Scheme.smallPretopology P_et P_et
  have hJ_eq : J = K_pre.toGrothendieck :=
    AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology S_K
      (le_refl P_et)
  have hSievePt : ∀ {U : S_K.Etale} {R : CategoryTheory.Sieve U}, R ∈ J U →
      ∀ x : ↥U.left, ∃ (Y : S_K.Etale) (f : Y ⟶ U) (y : ↥Y.left),
        R.arrows f ∧ AlgebraicGeometry.Etale f.left ∧ f.left y = x := by
    intro U R hR x
    have hR' : R ∈ K_pre.toGrothendieck U := hJ_eq ▸ hR
    obtain ⟨Y, f, y, hf'⟩ :=
      (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology ..).mp hR' x
    refine ⟨Y, f, y, ?_, hEtLeft f, ?_⟩
    · tauto
    · tauto
  have hPtSieve : ∀ {U : S_K.Etale} {R : CategoryTheory.Sieve U},
      (∀ x : ↥U.left, ∃ (Y : S_K.Etale) (f : Y ⟶ U) (y : ↥Y.left),
        R.arrows f ∧ AlgebraicGeometry.Etale f.left ∧ f.left y = x) →
      R ∈ J U := by
    intro U R h
    suffices hR' : R ∈ K_pre.toGrothendieck U from hJ_eq.symm ▸ hR'
    refine (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology ..).mpr ?_
    intro x
    obtain ⟨Y, f, y, hfR, hfEt, hfy⟩ := h x
    have hfR' : R f := hfR
    have hfEt' : P_et f.left := hfEt
    have hfy_symm : x = f.left y := hfy.symm
    exact ⟨Y, f, y, by tauto⟩
  
  have hShL : ∀ m : ℕ, CategoryTheory.Presheaf.IsSheaf J (weilAltLocConstPresheaf S_K m) := by
    intro m
    let L_pre := weilAltLocConstPresheaf S_K m
    let L_type := L_pre ⋙ CategoryTheory.forget AddCommGrpCat.{u}
    apply CategoryTheory.Presheaf.isSheaf_of_isSheaf_comp J L_pre
      (CategoryTheory.forget AddCommGrpCat.{u})
    rw [CategoryTheory.isSheaf_iff_isSheaf_of_type]
    intro U R hR sec hcompat
    let sec_lc : ∀ {Y : S_K.Etale} (f : Y ⟶ U), R.arrows f →
        LocallyConstant ↥Y.left (ULift.{u} (ZMod m)) :=
      fun f hf => sec f hf
    choose Y_x f_x y_x hf_x hEt_fx hy_x using hSievePt hR
    let t_fun : ↥U.left → ULift.{u} (ZMod m) :=
      fun x => (sec_lc (f_x x) (hf_x x)) (y_x x)
    have ht_eval : ∀ {Y : S_K.Etale} (f : Y ⟶ U) (hf : R.arrows f) (y : ↥Y.left),
        (sec_lc f hf) y = t_fun (f.left y) := by
      intro Y f hf y
      let x : ↥U.left := f.left y
      let P := CategoryTheory.Limits.pullback f.left (f_x x).left
      let pr₁ : P ⟶ Y.left := CategoryTheory.Limits.pullback.fst f.left (f_x x).left
      let pr₂ : P ⟶ (Y_x x).left := CategoryTheory.Limits.pullback.snd f.left (f_x x).left
      have : AlgebraicGeometry.Etale pr₁ :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (CategoryTheory.IsPullback.of_hasPullback f.left (f_x x).left).flip (hEt_fx x)
      have : AlgebraicGeometry.Etale Y.hom := Y.prop
      let P_et_obj : S_K.Etale := AlgebraicGeometry.Scheme.Etale.mk (pr₁ ≫ Y.hom)
      let p₁ : P_et_obj ⟶ Y := CategoryTheory.MorphismProperty.Over.homMk pr₁ rfl trivial
      have hp₂_w : pr₂ ≫ (Y_x x).hom = pr₁ ≫ Y.hom := by
        calc
          pr₂ ≫ (Y_x x).hom = pr₂ ≫ ((f_x x).left ≫ U.hom) := by
            rw [CategoryTheory.MorphismProperty.Over.w (f_x x)]
          _ = (pr₂ ≫ (f_x x).left) ≫ U.hom := (CategoryTheory.Category.assoc _ _ _).symm
          _ = (pr₁ ≫ f.left) ≫ U.hom := by rw [CategoryTheory.Limits.pullback.condition]
          _ = pr₁ ≫ (f.left ≫ U.hom) := CategoryTheory.Category.assoc _ _ _
          _ = pr₁ ≫ Y.hom := by rw [CategoryTheory.MorphismProperty.Over.w f]
      let p₂ : P_et_obj ⟶ Y_x x := CategoryTheory.MorphismProperty.Over.homMk pr₂ hp₂_w trivial
      have hp12 : p₁ ≫ f = p₂ ≫ f_x x :=
        CategoryTheory.MorphismProperty.Over.Hom.ext CategoryTheory.Limits.pullback.condition
      let lhs_lc : LocallyConstant ↥P_et_obj.left (ULift.{u} (ZMod m)) :=
        L_type.map p₁.op (sec f hf)
      let rhs_lc : LocallyConstant ↥P_et_obj.left (ULift.{u} (ZMod m)) :=
        L_type.map p₂.op (sec (f_x x) (hf_x x))
      have h_eq_sec : lhs_lc = rhs_lc :=
        hcompat p₁ p₂ hf (hf_x x) hp12
      obtain ⟨z, hz₁, hz₂⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y (y_x x) (hy_x x).symm
      have hz_eval : lhs_lc z = rhs_lc z := congrArg (fun s => s z) h_eq_sec
      change (sec_lc f hf) (pr₁ z) = (sec_lc (f_x x) (hf_x x)) (pr₂ z) at hz_eval
      rw [hz₁, hz₂] at hz_eval
      exact hz_eval
    have ht_loc : IsLocallyConstant t_fun := by
      intro E
      rw [isOpen_iff_forall_mem_open]
      intro x hx
      let V_x : Set ↥(Y_x x).left := ⇑(sec_lc (f_x x) (hf_x x)) ⁻¹' E
      have hV_open : IsOpen V_x := (sec_lc (f_x x) (hf_x x)).isLocallyConstant E
      have : AlgebraicGeometry.Etale (f_x x).left := hEt_fx x
      refine ⟨(f_x x).left '' V_x, ?_, (f_x x).left.isOpenMap V_x hV_open, ⟨y_x x, hx, hy_x x⟩⟩
      rintro x' ⟨y', hy', rfl⟩
      change t_fun ((f_x x).left y') ∈ E
      rw [← ht_eval (f_x x) (hf_x x) y']
      exact hy'
    let t_lc : LocallyConstant ↥U.left (ULift.{u} (ZMod m)) := ⟨t_fun, ht_loc⟩
    refine ⟨t_lc, ?_, ?_⟩
    · intro Y f hf
      apply LocallyConstant.ext
      intro y
      exact (ht_eval f hf y).symm
    · intro t' ht'
      let t'_lc : LocallyConstant ↥U.left (ULift.{u} (ZMod m)) := t'
      apply LocallyConstant.ext
      intro x
      let res_t' : LocallyConstant ↥(Y_x x).left (ULift.{u} (ZMod m)) :=
        L_type.map (f_x x).op t'
      have hx_eq : res_t' = sec_lc (f_x x) (hf_x x) := ht' (f_x x) (hf_x x)
      have hx_amalg : res_t' (y_x x) = (sec_lc (f_x x) (hf_x x)) (y_x x) :=
        congrArg (fun s => s (y_x x)) hx_eq
      change t'_lc ((f_x x).left (y_x x)) = t_lc x at hx_amalg
      rwa [hy_x x] at hx_amalg
  
  let ℒ : ∀ m : ℕ, CategoryTheory.Sheaf J AddCommGrpCat.{u} :=
    fun m => ⟨weilAltLocConstPresheaf S_K m, hShL m⟩
  let c₀ : ∀ m : ℕ, AM m ⟶ (ℒ m).obj.obj (Opposite.op T₀) :=
    fun m => weilAltLocConstConstHom S_K T₀ m
  let Φ_hom : ∀ m : ℕ, FM m ⟶ ℒ m :=
    fun m => (adj₀.homEquiv (AM m) (ℒ m)).symm (c₀ m)
  have hΦ_unit : ∀ m : ℕ,
      adj₀.unit.app (AM m) ≫ (Φ_hom m).hom.app (Opposite.op T₀) = c₀ m := by
    intro m
    exact (CategoryTheory.Adjunction.homEquiv_unit adj₀ (AM m) (ℒ m) (Φ_hom m)).symm.trans
      ((adj₀.homEquiv (AM m) (ℒ m)).apply_symm_apply (c₀ m))
  have hΦ_inj : ∀ m : ℕ, Function.Injective ((Φ_hom m).hom.app (Opposite.op T₀)).hom := by
    intro m
    let F_pre := (FM m).obj
    let F_type := F_pre ⋙ CategoryTheory.forget AddCommGrpCat.{u}
    let η₀ : AM m ⟶ F_pre.obj (Opposite.op T₀) := adj₀.unit.app (AM m)
    have hSh_F : CategoryTheory.Presieve.IsSheaf J F_type :=
      (CategoryTheory.isSheaf_iff_isSheaf_of_type J F_type).mp
        (CategoryTheory.Presheaf.isSheaf_comp_of_isSheaf J F_pre
          (CategoryTheory.forget AddCommGrpCat.{u}) (FM m).property)
    have hEmpty_sub : ∀ (Z₀ : S_K.Etale), IsEmpty ↥Z₀.left →
        Subsingleton ↥(F_pre.obj (Opposite.op Z₀)) := by
      intro Z₀ hEmp
      have hBot : (⊥ : CategoryTheory.Sieve Z₀) ∈ J Z₀ :=
        hPtSieve (fun z => IsEmpty.elim hEmp z)
      let emp_fam : CategoryTheory.Presieve.FamilyOfElements F_type
          (⊥ : CategoryTheory.Sieve Z₀).arrows :=
        fun {_} _ hf => False.elim hf
      obtain ⟨t₀, _, ht₀_uniq⟩ :=
        hSh_F (⊥ : CategoryTheory.Sieve Z₀) hBot emp_fam
          (fun {_ _ _} _ _ {_ _} hf₁ _ _ => False.elim hf₁)
      refine ⟨fun t₁ t₂ => ?_⟩
      have h₁ : t₁ = t₀ := ht₀_uniq t₁ (fun {_} _ hf => False.elim hf)
      have h₂ : t₂ = t₀ := ht₀_uniq t₂ (fun {_} _ hf => False.elim hf)
      exact h₁.trans h₂.symm
    have hArrows_gluing : ∀ {U : S_K.Etale} {ι : Type u} (Y : ι → S_K.Etale)
        (π : ∀ i : ι, Y i ⟶ U),
        (∀ x : ↥U.left, ∃ (i : ι) (y : ↥(Y i).left), (π i).left y = x) →
        ∀ (sec : ∀ i : ι, ↥(F_pre.obj (Opposite.op (Y i)))),
          (∀ (i₁ i₂ : ι) (Z₀ : S_K.Etale) (f₁ : Z₀ ⟶ Y i₁) (f₂ : Z₀ ⟶ Y i₂),
            f₁ ≫ π i₁ = f₂ ≫ π i₂ →
            (F_pre.map f₁.op).hom (sec i₁) = (F_pre.map f₂.op).hom (sec i₂)) →
          ∃! t : ↥(F_pre.obj (Opposite.op U)),
            ∀ i : ι, (F_pre.map (π i).op).hom t = sec i := by
      intro U ι Y π hcov sec hcompat
      have hGen : CategoryTheory.Sieve.ofArrows Y π ∈ J U := by
        apply hPtSieve
        intro x
        obtain ⟨i, y, hy⟩ := hcov x
        exact ⟨Y i, π i, y, CategoryTheory.Sieve.ofArrows_mk Y π i, hEtLeft (π i), hy⟩
      have hFor : CategoryTheory.Presieve.IsSheafFor F_type
          (CategoryTheory.Sieve.generate (CategoryTheory.Presieve.ofArrows Y π)).arrows :=
        hSh_F (CategoryTheory.Sieve.ofArrows Y π) hGen
      rw [← CategoryTheory.Presieve.isSheafFor_iff_generate,
        CategoryTheory.Presieve.isSheafFor_arrows_iff] at hFor
      exact hFor sec hcompat
    have hSh_ext : ∀ {U : S_K.Etale} {ι : Type u} (Y : ι → S_K.Etale)
        (π : ∀ i : ι, Y i ⟶ U),
        (∀ x : ↥U.left, ∃ (i : ι) (y : ↥(Y i).left), (π i).left y = x) →
        ∀ (t₁ t₂ : ↥(F_pre.obj (Opposite.op U))),
          (∀ i : ι, (F_pre.map (π i).op).hom t₁ = (F_pre.map (π i).op).hom t₂) →
          t₁ = t₂ := by
      intro U ι Y π hcov t₁ t₂ h_eq
      obtain ⟨t₀, _, ht₀_uniq⟩ := hArrows_gluing Y π hcov
        (fun i => (F_pre.map (π i).op).hom t₁)
        (fun i₁ i₂ Z₀ f₁ f₂ hf12 => by
          have hc1 : (F_pre.map f₁.op).hom ((F_pre.map (π i₁).op).hom t₁) =
              (F_pre.map (f₁ ≫ π i₁).op).hom t₁ := by
            change ((F_pre.map (π i₁).op ≫ F_pre.map f₁.op).hom) t₁ = _
            rw [← F_pre.map_comp]
            rfl
          have hc2 : (F_pre.map f₂.op).hom ((F_pre.map (π i₂).op).hom t₁) =
              (F_pre.map (f₂ ≫ π i₂).op).hom t₁ := by
            change ((F_pre.map (π i₂).op ≫ F_pre.map f₂.op).hom) t₁ = _
            rw [← F_pre.map_comp]
            rfl
          rw [hc1, hc2, hf12])
      exact (ht₀_uniq t₁ (fun _ => rfl)).trans (ht₀_uniq t₂ (fun i => (h_eq i).symm)).symm
    let O_lvl : ∀ (U : S_K.Etale)
        (_ : LocallyConstant ↥U.left (ULift.{u} (ZMod m))) (_ : ↥U.left), U.left.Opens :=
      fun U s x => ⟨s ⁻¹' {s x}, s.isLocallyConstant {s x}⟩
    let W_lvl : ∀ (U : S_K.Etale)
        (_ : LocallyConstant ↥U.left (ULift.{u} (ZMod m))) (_ : ↥U.left), S_K.Etale :=
      fun U s x =>
        have : AlgebraicGeometry.Etale U.hom := U.prop
        AlgebraicGeometry.Scheme.Etale.mk ((O_lvl U s x).ι ≫ U.hom)
    let j_lvl : ∀ (U : S_K.Etale)
        (s : LocallyConstant ↥U.left (ULift.{u} (ZMod m))) (x : ↥U.left),
        W_lvl U s x ⟶ U :=
      fun U s x => CategoryTheory.MorphismProperty.Over.homMk (O_lvl U s x).ι rfl trivial
    have hj_cov : ∀ (U : S_K.Etale) (s : LocallyConstant ↥U.left (ULift.{u} (ZMod m)))
        (x : ↥U.left), ∃ (x' : ↥U.left) (y : ↥(W_lvl U s x').left),
          (j_lvl U s x').left y = x := by
      intro U s x
      have hx_mem : x ∈ Set.range (O_lvl U s x).ι.base := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        exact rfl
      obtain ⟨y, hy⟩ := hx_mem
      exact ⟨x, y, hy⟩
    have hj_val : ∀ (U : S_K.Etale) (s : LocallyConstant ↥U.left (ULift.{u} (ZMod m)))
        (x : ↥U.left) (y : ↥(W_lvl U s x).left),
        s ((j_lvl U s x).left y) = s x := by
      intro U s x y
      have hy_mem : (j_lvl U s x).left y ∈ (O_lvl U s x : Set ↥U.left) := by
        rw [← AlgebraicGeometry.Scheme.Opens.range_ι]
        exact ⟨y, rfl⟩
      exact hy_mem
    let σ_lvl : ∀ (U : S_K.Etale)
        (s : LocallyConstant ↥U.left (ULift.{u} (ZMod m))) (x : ↥U.left),
        ↥(F_pre.obj (Opposite.op (W_lvl U s x))) :=
      fun U s x => (F_pre.map (hT₀.from (W_lvl U s x)).op).hom (η₀.hom (s x))
    have hψ_ex : ∀ (U : S_K.Etale) (s : LocallyConstant ↥U.left (ULift.{u} (ZMod m))),
        ∃! t : ↥(F_pre.obj (Opposite.op U)),
          ∀ x : ↥U.left, (F_pre.map (j_lvl U s x).op).hom t = σ_lvl U s x := by
      intro U s
      apply hArrows_gluing (W_lvl U s) (j_lvl U s) (hj_cov U s) (σ_lvl U s)
      intro x₁ x₂ Z₀ f₁ f₂ hf12
      by_cases hZ₀ : Nonempty ↥Z₀.left
      · obtain ⟨z₀⟩ := hZ₀
        have hpt : (f₁ ≫ j_lvl U s x₁).left z₀ = (f₂ ≫ j_lvl U s x₂).left z₀ :=
          congrArg (fun k : Z₀ ⟶ U => k.left z₀) hf12
        have hs1 : s ((f₁ ≫ j_lvl U s x₁).left z₀) = s x₁ :=
          hj_val U s x₁ (f₁.left z₀)
        have hs2 : s ((f₂ ≫ j_lvl U s x₂).left z₀) = s x₂ :=
          hj_val U s x₂ (f₂.left z₀)
        have hs12 : s x₁ = s x₂ := hs1.symm.trans ((congrArg s hpt).trans hs2)
        have hT12 : f₁ ≫ hT₀.from (W_lvl U s x₁) = f₂ ≫ hT₀.from (W_lvl U s x₂) :=
          hT₀.hom_ext _ _
        dsimp only [σ_lvl]
        have hc1 : (F_pre.map f₁.op).hom
            ((F_pre.map (hT₀.from (W_lvl U s x₁)).op).hom (η₀.hom (s x₁))) =
            (F_pre.map (f₁ ≫ hT₀.from (W_lvl U s x₁)).op).hom (η₀.hom (s x₁)) := by
          change ((F_pre.map (hT₀.from (W_lvl U s x₁)).op ≫ F_pre.map f₁.op).hom) _ = _
          rw [← F_pre.map_comp]
          rfl
        have hc2 : (F_pre.map f₂.op).hom
            ((F_pre.map (hT₀.from (W_lvl U s x₂)).op).hom (η₀.hom (s x₂))) =
            (F_pre.map (f₂ ≫ hT₀.from (W_lvl U s x₂)).op).hom (η₀.hom (s x₂)) := by
          change ((F_pre.map (hT₀.from (W_lvl U s x₂)).op ≫ F_pre.map f₂.op).hom) _ = _
          rw [← F_pre.map_comp]
          rfl
        rw [hc1, hc2, hT12, hs12]
      · have hSub : Subsingleton ↥(F_pre.obj (Opposite.op Z₀)) :=
          hEmpty_sub Z₀ (not_nonempty_iff.mp hZ₀)
        exact @Subsingleton.elim _ hSub _ _
    let ψ_fun : ∀ (U : S_K.Etale),
        LocallyConstant ↥U.left (ULift.{u} (ZMod m)) → ↥(F_pre.obj (Opposite.op U)) :=
      fun U s => (hψ_ex U s).choose
    have hψ_spec : ∀ (U : S_K.Etale) (s : LocallyConstant ↥U.left (ULift.{u} (ZMod m)))
        (x : ↥U.left), (F_pre.map (j_lvl U s x).op).hom (ψ_fun U s) = σ_lvl U s x :=
      fun U s => (hψ_ex U s).choose_spec.1
    have hψ_const : ∀ {U₁ U₂ : S_K.Etale} (g : U₁ ⟶ U₂)
        (s : LocallyConstant ↥U₂.left (ULift.{u} (ZMod m))) (a : ULift.{u} (ZMod m)),
        (∀ y : ↥U₁.left, s (g.left y) = a) →
        (F_pre.map g.op).hom (ψ_fun U₂ s) =
          (F_pre.map (hT₀.from U₁).op).hom (η₀.hom a) := by
      intro U₁ U₂ g s a hconst
      by_cases hU₁ : Nonempty ↥U₁.left
      · obtain ⟨y₀⟩ := hU₁
        let x₀ : ↥U₂.left := g.left y₀
        have hx₀ : s x₀ = a := hconst y₀
        have hrange : Set.range g.left.base ⊆ Set.range (O_lvl U₂ s x₀).ι.base := by
          rw [AlgebraicGeometry.Scheme.Opens.range_ι]
          rintro _ ⟨y, rfl⟩
          exact (hconst y).trans hx₀.symm
        let g_sch : U₁.left ⟶ (O_lvl U₂ s x₀).toScheme :=
          AlgebraicGeometry.IsOpenImmersion.lift (O_lvl U₂ s x₀).ι g.left hrange
        have hg_fac : g_sch ≫ (O_lvl U₂ s x₀).ι = g.left :=
          AlgebraicGeometry.IsOpenImmersion.lift_fac (O_lvl U₂ s x₀).ι g.left hrange
        have hg_w : g_sch ≫ (W_lvl U₂ s x₀).hom = U₁.hom := by
          change g_sch ≫ ((O_lvl U₂ s x₀).ι ≫ U₂.hom) = U₁.hom
          rw [← CategoryTheory.Category.assoc, hg_fac, CategoryTheory.MorphismProperty.Over.w g]
        let g_et : U₁ ⟶ W_lvl U₂ s x₀ :=
          CategoryTheory.MorphismProperty.Over.homMk g_sch hg_w trivial
        have hg_et_fac : g_et ≫ j_lvl U₂ s x₀ = g :=
          CategoryTheory.MorphismProperty.Over.Hom.ext hg_fac
        have hT_eq : g_et ≫ hT₀.from (W_lvl U₂ s x₀) = hT₀.from U₁ := hT₀.hom_ext _ _
        calc
          (F_pre.map g.op).hom (ψ_fun U₂ s)
              = (F_pre.map (g_et ≫ j_lvl U₂ s x₀).op).hom (ψ_fun U₂ s) := by rw [hg_et_fac]
          _ = (F_pre.map g_et.op).hom
                ((F_pre.map (j_lvl U₂ s x₀).op).hom (ψ_fun U₂ s)) := by
              change (F_pre.map ((j_lvl U₂ s x₀).op ≫ g_et.op)).hom _ = _
              rw [F_pre.map_comp]
              rfl
          _ = (F_pre.map g_et.op).hom (σ_lvl U₂ s x₀) := by rw [hψ_spec U₂ s x₀]
          _ = (F_pre.map (g_et ≫ hT₀.from (W_lvl U₂ s x₀)).op).hom (η₀.hom (s x₀)) := by
              dsimp only [σ_lvl]
              change ((F_pre.map (hT₀.from (W_lvl U₂ s x₀)).op ≫ F_pre.map g_et.op).hom) _ = _
              rw [← F_pre.map_comp]
              rfl
          _ = (F_pre.map (hT₀.from U₁).op).hom (η₀.hom a) := by rw [hT_eq, hx₀]
      · have hSub : Subsingleton ↥(F_pre.obj (Opposite.op U₁)) :=
          hEmpty_sub U₁ (not_nonempty_iff.mp hU₁)
        exact @Subsingleton.elim _ hSub _ _
    have hψ_zero : ∀ U : S_K.Etale, ψ_fun U 0 = 0 := by
      intro U
      have hid := hψ_const (𝟙 U) 0 0 (fun _ => rfl)
      have hid_lhs : (F_pre.map (𝟙 U : U ⟶ U).op).hom (ψ_fun U 0) = ψ_fun U 0 := by
        change (F_pre.map (𝟙 (Opposite.op U))).hom (ψ_fun U 0) = ψ_fun U 0
        rw [F_pre.map_id]
        rfl
      have hid_rhs : (F_pre.map (hT₀.from U).op).hom (η₀.hom 0) = 0 :=
        (congrArg (F_pre.map (hT₀.from U).op).hom η₀.hom.map_zero).trans
          (F_pre.map (hT₀.from U).op).hom.map_zero
      exact hid_lhs.symm.trans (hid.trans hid_rhs)
    have hψ_add : ∀ (U : S_K.Etale) (s₁ s₂ : LocallyConstant ↥U.left (ULift.{u} (ZMod m))),
        ψ_fun U (s₁ + s₂) = ψ_fun U s₁ + ψ_fun U s₂ := by
      intro U s₁ s₂
      let O₁₂ : ↥U.left → U.left.Opens := fun x => O_lvl U s₁ x ⊓ O_lvl U s₂ x
      let W₁₂ : ↥U.left → S_K.Etale := fun x =>
        have : AlgebraicGeometry.Etale U.hom := U.prop
        AlgebraicGeometry.Scheme.Etale.mk ((O₁₂ x).ι ≫ U.hom)
      let j₁₂ : ∀ x : ↥U.left, W₁₂ x ⟶ U :=
        fun x => CategoryTheory.MorphismProperty.Over.homMk (O₁₂ x).ι rfl trivial
      have hj₁₂_cov : ∀ x : ↥U.left, ∃ (x' : ↥U.left) (y : ↥(W₁₂ x').left),
          (j₁₂ x').left y = x := by
        intro x
        have hx_mem : x ∈ Set.range (O₁₂ x).ι.base := by
          rw [AlgebraicGeometry.Scheme.Opens.range_ι]
          exact ⟨rfl, rfl⟩
        obtain ⟨y, hy⟩ := hx_mem
        exact ⟨x, y, hy⟩
      apply hSh_ext W₁₂ j₁₂ hj₁₂_cov
      intro x
      have hmem₁₂ : ∀ y : ↥(W₁₂ x).left, (j₁₂ x).left y ∈ (O₁₂ x : Set ↥U.left) := by
        intro y
        rw [← AlgebraicGeometry.Scheme.Opens.range_ι]
        exact ⟨y, rfl⟩
      have hc_sum := hψ_const (j₁₂ x) (s₁ + s₂) (s₁ x + s₂ x) (fun y => by
        rw [LocallyConstant.add_apply]
        exact congrArg₂ (· + ·) (hmem₁₂ y).1 (hmem₁₂ y).2)
      have hc₁ := hψ_const (j₁₂ x) s₁ (s₁ x) (fun y => (hmem₁₂ y).1)
      have hc₂ := hψ_const (j₁₂ x) s₂ (s₂ x) (fun y => (hmem₁₂ y).2)
      calc
        (F_pre.map (j₁₂ x).op).hom (ψ_fun U (s₁ + s₂))
            = (F_pre.map (hT₀.from (W₁₂ x)).op).hom (η₀.hom (s₁ x + s₂ x)) := hc_sum
        _ = (F_pre.map (hT₀.from (W₁₂ x)).op).hom (η₀.hom (s₁ x) + η₀.hom (s₂ x)) :=
            congrArg (F_pre.map (hT₀.from (W₁₂ x)).op).hom (η₀.hom.map_add (s₁ x) (s₂ x))
        _ = (F_pre.map (hT₀.from (W₁₂ x)).op).hom (η₀.hom (s₁ x)) +
              (F_pre.map (hT₀.from (W₁₂ x)).op).hom (η₀.hom (s₂ x)) :=
            (F_pre.map (hT₀.from (W₁₂ x)).op).hom.map_add _ _
        _ = (F_pre.map (j₁₂ x).op).hom (ψ_fun U s₁) +
              (F_pre.map (j₁₂ x).op).hom (ψ_fun U s₂) := by rw [← hc₁, ← hc₂]
        _ = (F_pre.map (j₁₂ x).op).hom (ψ_fun U s₁ + ψ_fun U s₂) :=
            ((F_pre.map (j₁₂ x).op).hom.map_add _ _).symm
    let Φ_inv : ℒ m ⟶ FM m :=
      { hom :=
          { app := fun opU => AddCommGrpCat.ofHom
              { toFun := ψ_fun (Opposite.unop opU)
                map_zero' := hψ_zero (Opposite.unop opU)
                map_add' := hψ_add (Opposite.unop opU) }
            naturality := fun {opU₂ opU₁} f => by
              let U₁ := Opposite.unop opU₁
              let U₂ := Opposite.unop opU₂
              let u : U₁ ⟶ U₂ := f.unop
              apply AddCommGrpCat.ext
              intro (s : LocallyConstant ↥U₂.left (ULift.{u} (ZMod m)))
              let s' : LocallyConstant ↥U₁.left (ULift.{u} (ZMod m)) :=
                ((ℒ m).obj.map f).hom s
              change ψ_fun U₁ s' = (F_pre.map f).hom (ψ_fun U₂ s)
              apply hSh_ext (W_lvl U₁ s') (j_lvl U₁ s') (hj_cov U₁ s')
              intro y
              rw [hψ_spec U₁ s' y]
              dsimp only [σ_lvl]
              have hcomp_f : (F_pre.map (j_lvl U₁ s' y).op).hom
                  ((F_pre.map f).hom (ψ_fun U₂ s)) =
                  (F_pre.map (j_lvl U₁ s' y ≫ u).op).hom (ψ_fun U₂ s) := by
                change ((F_pre.map u.op ≫ F_pre.map (j_lvl U₁ s' y).op).hom) _ = _
                rw [← F_pre.map_comp]
                rfl
              rw [hcomp_f]
              symm
              exact hψ_const (j_lvl U₁ s' y ≫ u) s (s' y) (fun w => hj_val U₁ s' y w) } }
    have hc₀_inv : c₀ m ≫ Φ_inv.hom.app (Opposite.op T₀) = η₀ := by
      apply AddCommGrpCat.ext
      intro a
      let ca : LocallyConstant ↥T₀.left (ULift.{u} (ZMod m)) := (c₀ m).hom a
      change ψ_fun T₀ ca = η₀.hom a
      have hid := hψ_const (𝟙 T₀) ca a (fun _ => rfl)
      have hid_lhs : (F_pre.map (𝟙 T₀ : T₀ ⟶ T₀).op).hom (ψ_fun T₀ ca) = ψ_fun T₀ ca := by
        change (F_pre.map (𝟙 (Opposite.op T₀))).hom (ψ_fun T₀ ca) = ψ_fun T₀ ca
        rw [F_pre.map_id]
        rfl
      have hfrom_id : hT₀.from T₀ = 𝟙 T₀ := hT₀.hom_ext _ _
      have hid_rhs : (F_pre.map (hT₀.from T₀).op).hom (η₀.hom a) = η₀.hom a := by
        rw [hfrom_id]
        change (F_pre.map (𝟙 (Opposite.op T₀))).hom (η₀.hom a) = η₀.hom a
        rw [F_pre.map_id]
        rfl
      exact hid_lhs.symm.trans (hid.trans hid_rhs)
    have hRetr : Φ_hom m ≫ Φ_inv = 𝟙 (FM m) := by
      apply (adj₀.homEquiv (AM m) (FM m)).injective
      rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Adjunction.homEquiv_unit]
      change η₀ ≫ ((Φ_hom m).hom.app (Opposite.op T₀) ≫ Φ_inv.hom.app (Opposite.op T₀)) =
        η₀ ≫ 𝟙 (F_pre.obj (Opposite.op T₀))
      rw [← CategoryTheory.Category.assoc, hΦ_unit m, hc₀_inv, CategoryTheory.Category.comp_id]
    intro v₁ v₂ hv
    have hcomp_app : ((Φ_hom m ≫ Φ_inv).hom.app (Opposite.op T₀)).hom =
        ((𝟙 (FM m) : FM m ⟶ FM m).hom.app (Opposite.op T₀)).hom :=
      congrArg (fun k : FM m ⟶ FM m => (k.hom.app (Opposite.op T₀)).hom) hRetr
    have hv₁ : (Φ_inv.hom.app (Opposite.op T₀)).hom
        (((Φ_hom m).hom.app (Opposite.op T₀)).hom v₁) = v₁ :=
      congrArg (fun φ => φ v₁) hcomp_app
    have hv₂ : (Φ_inv.hom.app (Opposite.op T₀)).hom
        (((Φ_hom m).hom.app (Opposite.op T₀)).hom v₂) = v₂ :=
      congrArg (fun φ => φ v₂) hcomp_app
    exact hv₁.symm.trans ((congrArg ((Φ_inv.hom.app (Opposite.op T₀)).hom) hv).trans hv₂)
  
  have hExt_mk₀ : ∀ {m : ℕ} (f : Fℤ ⟶ FM m),
      CategoryTheory.Abelian.Ext.addEquiv₀ (CategoryTheory.Abelian.Ext.mk₀ f) = f := by
    intro m f
    rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply]
    exact CategoryTheory.Abelian.Ext.addEquiv₀.apply_symm_apply f
  let toLC : ∀ (m : ℕ), weilEtaleTorsionH S_K m 0 → LocallyConstant ↥S_K (ULift.{u} (ZMod m)) :=
    fun m u =>
      ((Φ_hom m).hom.app (Opposite.op T₀)).hom
        ((((CategoryTheory.Abelian.Ext.addEquiv₀ u).hom.app (Opposite.op T₀)).hom)
          ((adj₀.unit.app Aℤ).hom (ULift.up (1 : ℤ))))
  let ev_hom : ∀ m : ℕ, AddHom (weilEtaleTorsionH S_K m 0) (ZMod m) :=
    fun m =>
      { toFun := fun u => (toLC m u pt₀).down
        map_add' := fun u₁ u₂ => by
          have hLC_add : toLC m (u₁ + u₂) = toLC m u₁ + toLC m u₂ := by
            dsimp only [toLC]
            rw [map_add CategoryTheory.Abelian.Ext.addEquiv₀, CategoryTheory.Sheaf.Hom.add_app]
            exact ((Φ_hom m).hom.app (Opposite.op T₀)).hom.map_add _ _
          rw [hLC_add, LocallyConstant.add_apply]
          rfl }
  let h_hom : ∀ (m : ℕ), ZMod m → (Aℤ ⟶ AM m) :=
    fun m a => AddCommGrpCat.ofHom
      { toFun := fun z => ULift.up (z.down • a)
        map_zero' := congrArg ULift.up (zero_zsmul a)
        map_add' := fun z₁ z₂ => congrArg ULift.up (add_zsmul a z₁.down z₂.down) }
  let ψ_gen : ∀ (m : ℕ), ZMod m → weilEtaleTorsionH S_K m 0 :=
    fun m a => CategoryTheory.Abelian.Ext.mk₀ (Cℤ.map (h_hom m a))
  have hev_ψ : ∀ (m : ℕ) (a : ZMod m), ev_hom m (ψ_gen m a) = a := by
    intro m a
    have hnat : h_hom m a ≫ adj₀.unit.app (AM m) =
        adj₀.unit.app Aℤ ≫ (Cℤ.map (h_hom m a)).hom.app (Opposite.op T₀) :=
      adj₀.unit.naturality (h_hom m a)
    have hcomp_c₀ : (adj₀.unit.app Aℤ ≫ (Cℤ.map (h_hom m a)).hom.app (Opposite.op T₀)) ≫
        (Φ_hom m).hom.app (Opposite.op T₀) = h_hom m a ≫ c₀ m := by
      rw [← hnat, CategoryTheory.Category.assoc, hΦ_unit m]
    have hLC_eq : toLC m (ψ_gen m a) =
        LocallyConstant.const ↥S_K (ULift.up ((1 : ℤ) • a)) := by
      dsimp only [toLC, ψ_gen]
      rw [hExt_mk₀ (Cℤ.map (h_hom m a))]
      exact congrArg (fun φ : Aℤ ⟶ (ℒ m).obj.obj (Opposite.op T₀) => φ.hom (ULift.up (1 : ℤ)))
        hcomp_c₀
    change (toLC m (ψ_gen m a) pt₀).down = a
    rw [hLC_eq]
    exact one_zsmul a
  have hev_inj : ∀ m : ℕ, Function.Injective (ev_hom m) := by
    intro m u₁ u₂ hu
    let f₁ : Fℤ ⟶ FM m := CategoryTheory.Abelian.Ext.addEquiv₀ u₁
    let f₂ : Fℤ ⟶ FM m := CategoryTheory.Abelian.Ext.addEquiv₀ u₂
    let g₁ : Aℤ ⟶ (FM m).obj.obj (Opposite.op T₀) := (adj₀.homEquiv Aℤ (FM m)) f₁
    let g₂ : Aℤ ⟶ (FM m).obj.obj (Opposite.op T₀) := (adj₀.homEquiv Aℤ (FM m)) f₂
    have hs_pt₀ : toLC m u₁ pt₀ = toLC m u₂ pt₀ := ULift.ext _ _ hu
    have hs_eq : toLC m u₁ = toLC m u₂ := by
      apply LocallyConstant.ext
      intro x
      rw [hUnique_SK.eq_default x]
      exact hs_pt₀
    have hv_eq : g₁.hom (ULift.up (1 : ℤ)) = g₂.hom (ULift.up (1 : ℤ)) := by
      have hg₁ : g₁ = adj₀.unit.app Aℤ ≫ f₁.hom.app (Opposite.op T₀) :=
        CategoryTheory.Adjunction.homEquiv_unit adj₀ Aℤ (FM m) f₁
      have hg₂ : g₂ = adj₀.unit.app Aℤ ≫ f₂.hom.app (Opposite.op T₀) :=
        CategoryTheory.Adjunction.homEquiv_unit adj₀ Aℤ (FM m) f₂
      rw [hg₁, hg₂]
      exact hΦ_inj m hs_eq
    have hg_eq : g₁ = g₂ := by
      apply AddCommGrpCat.ext
      intro z
      have hz : z = z.down • ULift.up (1 : ℤ) := ULift.ext _ _ (zsmul_one z.down).symm
      rw [hz, map_zsmul, map_zsmul, hv_eq]
    have hf_eq : f₁ = f₂ := (adj₀.homEquiv Aℤ (FM m)).injective hg_eq
    exact CategoryTheory.Abelian.Ext.addEquiv₀.injective hf_eq
  let ev_gen : ∀ m : ℕ, weilEtaleTorsionH S_K m 0 ≃+ ZMod m :=
    fun m => AddEquiv.ofBijective (ev_hom m) ⟨hev_inj m, fun a => ⟨ψ_gen m a, hev_ψ m a⟩⟩
  have hψ_ev : ∀ (m : ℕ) (u : weilEtaleTorsionH S_K m 0),
      ψ_gen m (ev_gen m u) = u := by
    intro m u
    apply hev_inj m
    exact hev_ψ m (ev_gen m u)
  let e₀ : ∀ r : ℕ, weilEtaleTorsionH S_K (ℓ ^ r) 0 ≃+ ZMod (ℓ ^ r) :=
    fun r => ev_gen (ℓ ^ r)
  refine ⟨e₀, ?_, ?_⟩
  · 
    intro r u
    let a : ZMod (ℓ ^ (r + 1)) := e₀ (r + 1) u
    let π_r := ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r))
    let φ_cast : AM (ℓ ^ (r + 1)) ⟶ AM (ℓ ^ r) :=
      AddCommGrpCat.uliftFunctor.{u, 0}.map (AddCommGrpCat.ofHom π_r.toAddMonoidHom)
    have hu_eq : u = ψ_gen (ℓ ^ (r + 1)) a := (hψ_ev (ℓ ^ (r + 1)) u).symm
    have hcomp_cast : h_hom (ℓ ^ (r + 1)) a ≫ φ_cast = h_hom (ℓ ^ r) (π_r a) :=
      AddCommGrpCat.ext (fun z => congrArg ULift.up (map_zsmul π_r z.down a))
    have htrans_eq : weilEtaleTorsionTransition S_K ℓ r 0 u = ψ_gen (ℓ ^ r) (π_r a) := by
      rw [hu_eq]
      change (CategoryTheory.Abelian.Ext.mk₀ (Cℤ.map (h_hom (ℓ ^ (r + 1)) a))).comp
        (CategoryTheory.Abelian.Ext.mk₀ (Cℤ.map φ_cast)) (Nat.add_zero 0) = _
      rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, ← Cℤ.map_comp, hcomp_cast]
    rw [htrans_eq]
    exact (hev_ψ (ℓ ^ r) (π_r a)).symm
  · 
    intro r θ₀ hθ
    let m := ℓ ^ r
    let R := ULift.{u, 0} (ZMod m)
    let oneR := weilEtaleModuleUnit S_K m
    let FgtMod := CategoryTheory.forget₂ (ModuleCat.{u, u} R) AddCommGrpCat.{u}
    let ιM : AM m ⟶ FgtMod.obj (ModuleCat.of R R) := AddCommGrpCat.ofHom (AddMonoidHom.id R)
    let id_Z : Aℤ ⟶ AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of ℤ) :=
      AddCommGrpCat.ofHom (AddMonoidHom.id (ULift.{u} ℤ))
    let cast_Z : AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of ℤ) ⟶ AM m :=
      AddCommGrpCat.uliftFunctor.{u, 0}.map (AddCommGrpCat.ofHom (Int.castAddHom (ZMod m)))
    let z_cast : Aℤ ⟶ AM m := id_Z ≫ cast_Z
    rcases hθ with ⟨U, _, _, hAdd, hLim, hColim, T, hT, _, _, u_unit, _, βM, hαβ, _, hθ_eq⟩
    let _ := hAdd
    let _ := hLim
    let _ := hColim
    let adjℤ := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT
    let ιℤ : Aℤ ⟶ FgtMod.obj (ModuleCat.of R R) := id_Z ≫ (cast_Z ≫ ιM)
    let ηℤ : Fℤ ⟶ U.obj oneR := (adjℤ.homEquiv Aℤ (U.obj oneR)).symm (ιℤ ≫ u_unit)
    let αM : FM m ⟶ U.obj oneR := (adjℤ.homEquiv (AM m) (U.obj oneR)).symm (ιM ≫ u_unit)
    let x₀ : weilEtaleModuleH S_K m 0 :=
      CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id oneR)
    have hx₀_eval : θ₀ x₀ = CategoryTheory.Abelian.Ext.mk₀ (ηℤ ≫ βM) := by
      have h1 := hθ_eq x₀
      dsimp only [x₀] at h1
      rw [CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀] at h1
      change θ₀ x₀ =
        ((CategoryTheory.Abelian.Ext.mk₀ ηℤ).comp
          (CategoryTheory.Abelian.Ext.mk₀ (U.map (𝟙 oneR))) (Nat.zero_add 0)).comp
          (CategoryTheory.Abelian.Ext.mk₀ βM) (Nat.add_zero 0) at h1
      rw [U.map_id, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.Category.comp_id,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀] at h1
      exact h1
    have hιℤ_assoc : ιℤ ≫ u_unit = z_cast ≫ (ιM ≫ u_unit) := by
      dsimp only [ιℤ, z_cast]
      simp only [CategoryTheory.Category.assoc]
    have hηℤ_eq : ηℤ = Cℤ.map z_cast ≫ αM := by
      dsimp only [ηℤ, αM]
      rw [hιℤ_assoc]
      exact CategoryTheory.Adjunction.homEquiv_naturality_left_symm adjℤ z_cast (ιM ≫ u_unit)
    have hcancel : ηℤ ≫ βM = Cℤ.map z_cast := by
      rw [hηℤ_eq, CategoryTheory.Category.assoc]
      have hαβ' : αM ≫ βM = 𝟙 (FM m) := hαβ
      rw [hαβ', CategoryTheory.Category.comp_id]
    have hz_cast : z_cast = h_hom m 1 :=
      AddCommGrpCat.ext (fun z => congrArg ULift.up (zsmul_one z.down).symm)
    change ev_gen m (θ₀ x₀) = 1
    rw [hx₀_eval, hcancel, hz_cast]
    exact hev_ψ m 1

theorem weil_etale_pinned_kummer_power_short_exact_and_transition (k : Type u) [Field k] [IsAlgClosed k]
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar k)
    (ζ : ℕ → kˣ)
    (hPrim : ∀ r : ℕ, IsPrimitiveRoot ((ζ r : kˣ) : k) (ℓ ^ r))
    (hPow : ∀ r : ℕ, (ζ (r + 1)) ^ ℓ = ζ r) :
    (∃ tr₀ : ∀ r : ℕ, weilEtaleTorsionH (weilPolyP1Over k 0).left (ℓ ^ r) (2 * 0) →+ ZMod (ℓ ^ r),
      WeilIsSpecBaseTorsionTrace k ℓ tr₀) ∧
    WeilIsPinnedKummerPowerTower k X ℓ ζ :=
by
  classical
  have hPrime : Nat.Prime ℓ := Fact.out
  have hℓ_ne : (ℓ : k) ≠ 0 := by
    intro h0
    have hdvd : ringChar k ∣ ℓ := (CharP.cast_eq_zero_iff k (ringChar k) ℓ).mp h0
    rcases CharP.char_is_prime_or_zero k (ringChar k) with hp | hz
    · rcases (Nat.dvd_prime hPrime).mp hdvd with h1 | heq
      · exact hp.ne_one h1
