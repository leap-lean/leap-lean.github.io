    rw [CategoryTheory.Category.assoc, hΦ_bar_snd]
    infer_instance
  haveI hProp_fZ : AlgebraicGeometry.IsProper f_Z :=
    AlgebraicGeometry.IsProper.of_comp f_Z g_Pk0

  
  have hLocQF_Z :
      ∀ z : Z_sch,
        ∃ (U_X : P_k0.Opens) (_ : AlgebraicGeometry.IsAffineOpen U_X)
          (V_C : Z_sch.Opens) (_ : AlgebraicGeometry.IsAffineOpen V_C)
          (e_X : V_C ≤ (TopologicalSpace.Opens.map f_Z.base).obj U_X),
          z ∈ V_C ∧
          (f_Z.appLE U_X V_C e_X).hom.FiniteType ∧
          (f_Z.appLE U_X V_C e_X).hom.QuasiFinite := by
    intro z
    obtain ⟨a, hz_a⟩ := hMemChart (f_Z.base z)
    let U_X : P_k0.Opens := weilProjBasicOpen k₀ 1 a
    have hUX : AlgebraicGeometry.IsAffineOpen U_X := hAff k₀ 1 a
    have hz_pre : z ∈ (TopologicalSpace.Opens.map f_Z.base).obj U_X := hz_a
    obtain ⟨V_C, hVC, hz_VC, e_X⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
        (U := (TopologicalSpace.Opens.map f_Z.base).obj U_X) (x := z) hz_pre
    haveI : AlgebraicGeometry.LocallyOfFiniteType f_Z := inferInstance
    have hFT : (f_Z.appLE U_X V_C e_X).hom.FiniteType :=
      AlgebraicGeometry.LocallyOfFiniteType.finiteType_appLE f_Z hUX hVC e_X
    refine ⟨U_X, hUX, V_C, hVC, e_X, hz_VC, hFT, ?_⟩
    let A_a := ↑(P_k0.presheaf.obj (Opposite.op U_X))
    let B_Z := ↑(Z_sch.presheaf.obj (Opposite.op V_C))
    let α_a : A_a →+* B_Z := (f_Z.appLE U_X V_C e_X).hom
    have hVC_ne : Nonempty ↥V_C := ⟨⟨z, hz_VC⟩⟩
    have hUX_ne : Nonempty ↥U_X := ⟨⟨f_Z.base z, hz_a⟩⟩
    haveI hDom_BZ : IsDomain B_Z :=
      @AlgebraicGeometry.IsIntegral.component_integral Z_sch hInt_Z V_C hVC_ne
    haveI hDom_Aa : IsDomain A_a := hDom_chart a
    obtain ⟨φ_BZ, hFrac_BZ, hφ_BZ⟩ := hFunc_Z V_C hVC hVC_ne
    obtain ⟨φ_Aa, hFrac_Aa, hφ_Aa⟩ := hFunc_Pk0 U_X hUX hUX_ne
    have hφ_BZ_inj : Function.Injective φ_BZ.hom := by
      letI : Algebra B_Z K_Z := φ_BZ.hom.toAlgebra
      haveI : IsFractionRing B_Z K_Z := hFrac_BZ
      exact IsFractionRing.injective B_Z K_Z
    have hφ_Aa_inj : Function.Injective φ_Aa.hom := by
      letI : Algebra A_a K_Z := φ_Aa.hom.toAlgebra
      haveI : IsFractionRing A_a K_Z := hFrac_Aa
      exact IsFractionRing.injective A_a K_Z
    have hφ_comp : ∀ x_a : A_a, φ_BZ.hom (α_a x_a) = φ_Aa.hom x_a := by
      have hSpec_eq :
          AlgebraicGeometry.Spec.map (f_Z.appLE U_X V_C e_X ≫ φ_BZ) ≫ hUX.fromSpec =
          AlgebraicGeometry.Spec.map φ_Aa ≫ hUX.fromSpec := by
        rw [AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc,
          AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec f_Z hUX hVC e_X,
          ← CategoryTheory.Category.assoc, hφ_BZ, hφ_Aa]
      have hMap_eq := (CategoryTheory.cancel_mono hUX.fromSpec).mp hSpec_eq
      have hHom_eq := congrArg ConcreteCategory.hom (AlgebraicGeometry.Spec.map_injective hMap_eq)
      intro x_a
      exact RingHom.congr_fun hHom_eq x_a
    let ψ_a : Polynomial k₀ →+* K_Z := φ_Aa.hom.comp (e_k0 a).toRingHom
    have hψa_inj : Function.Injective ψ_a := hφ_Aa_inj.comp (e_k0 a).injective
    letI : Algebra A_a B_Z := α_a.toAlgebra
    haveI : Algebra.FiniteType A_a B_Z := hFT
    change Algebra.QuasiFinite A_a B_Z
    rw [Algebra.QuasiFinite.iff_finite_primesOver]
    intro p hp
    haveI : p.IsPrime := hp
    refine Set.Subsingleton.finite ?_
    intro q₁ hq₁ q₂ hq₂
    haveI hq₁_prime : q₁.IsPrime := hq₁.1
    haveI hq₂_prime : q₂.IsPrime := hq₂.1
    have hq₁_over : Ideal.comap α_a q₁ = p := by
      haveI : q₁.LiesOver p := hq₁.2
      exact (Ideal.LiesOver.over (P := q₁) (p := p)).symm
    have hq₂_over : Ideal.comap α_a q₂ = p := by
      haveI : q₂.LiesOver p := hq₂.2
      exact (Ideal.LiesOver.over (P := q₂) (p := p)).symm
    ext b
    obtain ⟨⟨a_num, b_den⟩, hb_frac⟩ :=
      @IsLocalization.surj A_a _ (nonZeroDivisors A_a) K_Z _ φ_Aa.hom.toAlgebra hFrac_Aa
        (φ_BZ.hom b)
    change φ_BZ.hom b * φ_Aa.hom b_den.1 = φ_Aa.hom a_num at hb_frac
    let P₁ : Polynomial k₀ := (e_k0 a).symm a_num
    let Q₁ : Polynomial k₀ := (e_k0 a).symm b_den.1
    have hQ₁_ne : Q₁ ≠ 0 := by
      have hb_ne : (b_den : A_a) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp b_den.2
      exact fun h0 => hb_ne ((e_k0 a).symm.injective (h0.trans (map_zero _).symm))
    have hb_poly : φ_BZ.hom b * ψ_a Q₁ = ψ_a P₁ := by
      dsimp only [ψ_a, P₁, Q₁, RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe]
      rw [(e_k0 a).apply_symm_apply, (e_k0 a).apply_symm_apply]
      exact hb_frac
    let d := EuclideanDomain.gcd P₁ Q₁
    have hd_ne : d ≠ 0 := by
      intro hd0
      exact hQ₁_ne ((EuclideanDomain.gcd_eq_zero_iff.mp hd0).2)
    obtain ⟨⟨P', hP₁⟩, ⟨Q', hQ₁⟩⟩ := EuclideanDomain.gcd_dvd P₁ Q₁
    have hQ'_ne : Q' ≠ 0 := fun h0 => hQ₁_ne (by rw [hQ₁, h0, mul_zero])
    have hCop : IsCoprime P' Q' := by
      apply EuclideanDomain.isCoprime_of_dvd
      · rintro ⟨_, h0⟩
        exact hQ'_ne h0
      · intro z hz_nonunit _hz_ne hzP hzQ
        rcases hzP with ⟨uP, huP⟩
        rcases hzQ with ⟨uQ, huQ⟩
        have hdzP : d * z ∣ P₁ := ⟨uP, by rw [hP₁, huP, mul_assoc]⟩
        have hdzQ : d * z ∣ Q₁ := ⟨uQ, by rw [hQ₁, huQ, mul_assoc]⟩
        rcases EuclideanDomain.dvd_gcd hdzP hdzQ with ⟨w, hw⟩
        have hzw : z * w = 1 :=
          mul_left_cancel₀ hd_ne (by
            calc
              d * (z * w) = d * z * w := (mul_assoc d z w).symm
