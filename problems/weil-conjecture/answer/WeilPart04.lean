    have hAlg_B : ∀ b : B, IsAlgebraic ↥F₀ (φ b) := by
      intro b
      have hb_mem : φ b ∈ ψ_TP.range := ⟨1 ⊗ₜ[A₀] b, by
        change (Algebra.TensorProduct.productMap ι_F₀ φ_algA₀) (1 ⊗ₜ[A₀] b) = φ b
        simp [φ_algA₀]⟩
      have hInt_sub : IsIntegral ↥F₀ (⟨φ b, hb_mem⟩ : ↥ψ_TP.range) := Algebra.IsIntegral.isIntegral _
      exact (hInt_sub.map ψ_TP.range.val).isAlgebraic
    have hAlg_F : ∀ x : F, IsAlgebraic ↥F₀ x := by
      intro x
      obtain ⟨b, s, _, rfl⟩ := @IsFractionRing.div_surjective B _ F _ φ.toAlgebra hFrac x
      rw [div_eq_mul_inv]
      exact (hAlg_B b).mul (hAlg_B s).inv
    let q₀ : Ideal A₀ := Ideal.comap α₀ p.asIdeal
    have _ : q₀.IsPrime := Ideal.IsPrime.comap α₀
    have hq₀_iff : ∀ P : A₀, P ∈ q₀ ↔ ∀ n : ℕ, P.coeff n ∈ IsLocalRing.maximalIdeal ↥R := hp_coeff
    let V₀_sub : Subring ↥F₀ :=
      { carrier := {z : ↥F₀ | ∃ P Q : A₀, Q ∉ q₀ ∧ ι₀ Q * z.1 = ι₀ P}
        mul_mem' := by
          rintro z₁ z₂ ⟨P₁, Q₁, hQ₁, h₁⟩ ⟨P₂, Q₂, hQ₂, h₂⟩
          refine ⟨P₁ * P₂, Q₁ * Q₂, q₀.primeCompl.mul_mem hQ₁ hQ₂, ?_⟩
          change ι₀ (Q₁ * Q₂) * (z₁.1 * z₂.1) = ι₀ (P₁ * P₂)
          rw [map_mul, map_mul]
          linear_combination (z₂.1 * ι₀ Q₂) * h₁ + (ι₀ P₁) * h₂
        one_mem' := ⟨1, 1, q₀.primeCompl.one_mem, by simp⟩
        add_mem' := by
          rintro z₁ z₂ ⟨P₁, Q₁, hQ₁, h₁⟩ ⟨P₂, Q₂, hQ₂, h₂⟩
          refine ⟨P₁ * Q₂ + P₂ * Q₁, Q₁ * Q₂, q₀.primeCompl.mul_mem hQ₁ hQ₂, ?_⟩
          change ι₀ (Q₁ * Q₂) * (z₁.1 + z₂.1) = ι₀ (P₁ * Q₂ + P₂ * Q₁)
          rw [map_add, map_mul, map_mul, map_mul]
          linear_combination (ι₀ Q₂) * h₁ + (ι₀ Q₁) * h₂
        zero_mem' := ⟨0, 1, q₀.primeCompl.one_mem, by simp⟩
        neg_mem' := by
          rintro z ⟨P, Q, hQ, h⟩
          refine ⟨-P, Q, hQ, ?_⟩
          change ι₀ Q * (-z.1) = ι₀ (-P)
          rw [map_neg]
          linear_combination -h }
    have hMinDvd_R : ∀ (S : Finset ↥R), S.Nonempty → ∃ c₀ ∈ S, ∀ c ∈ S, c₀ ∣ c := by
      intro S hS
      refine Finset.Nonempty.cons_induction (motive := fun s _ => ∃ c₀ ∈ s, ∀ c ∈ s, c₀ ∣ c)
        (fun a => ⟨a, Finset.mem_singleton_self a, fun c hc => by rw [Finset.mem_singleton.mp hc]⟩)
        (fun a s _ _ ⟨c₁, hc₁, hd₁⟩ => ?_) hS
      rcases ValuationRing.dvd_total a c₁ with hac | hca
      · exact ⟨a, Finset.mem_cons_self a s, fun c hc =>
          (Finset.mem_cons.mp hc).elim (fun h => h ▸ dvd_rfl) (fun h => dvd_trans hac (hd₁ c h))⟩
      · exact ⟨c₁, Finset.mem_cons.mpr (Or.inr hc₁), fun c hc =>
          (Finset.mem_cons.mp hc).elim (fun h => h ▸ hca) (fun h => hd₁ c h)⟩
    have h1_not_mR : (1 : ↥R) ∉ IsLocalRing.maximalIdeal ↥R :=
      fun h1 => (IsLocalRing.maximalIdeal.isMaximal ↥R).ne_top
        (Ideal.eq_top_of_isUnit_mem _ h1 isUnit_one)
    have hV₀_or : ∀ z : ↥F₀, z ∈ V₀_sub ∨ z⁻¹ ∈ V₀_sub := by
      intro z
      obtain ⟨P, Q, hQ_ne, hPQ⟩ := z.2
      by_cases hP_ne : P = 0
      · left
        have hz0 : z.1 = 0 := by
          rw [hP_ne, map_zero] at hPQ
          exact (mul_eq_zero.mp hPQ).resolve_left (hι₀_ne hQ_ne)
        exact ⟨0, 1, q₀.primeCompl.one_mem, by simp [hz0]⟩
      · let S_c : Finset ↥R := P.support.image P.coeff ∪ Q.support.image Q.coeff
        have hQ_supp : Q.support.Nonempty := Polynomial.support_nonempty.mpr hQ_ne
        obtain ⟨j_Q, hj_Q⟩ := hQ_supp
        have hSc_ne : S_c.Nonempty :=
          ⟨Q.coeff j_Q, Finset.mem_union_right _ (Finset.mem_image_of_mem _ hj_Q)⟩
        obtain ⟨c₀, hc₀_mem, hc₀_dvd⟩ := hMinDvd_R S_c hSc_ne
        have hc₀_ne : c₀ ≠ 0 := by
          simp only [S_c, Finset.mem_union, Finset.mem_image] at hc₀_mem
          rcases hc₀_mem with ⟨i, hi, rfl⟩ | ⟨j, hj, rfl⟩
          · exact Polynomial.mem_support_iff.mp hi
          · exact Polynomial.mem_support_iff.mp hj
        have hFactor : ∀ H : A₀, (∀ k ∈ H.support, c₀ ∣ H.coeff k) →
            ∃ H₁ : A₀, Polynomial.C c₀ * H₁ = H ∧ ∀ k : ℕ, c₀ * H₁.coeff k = H.coeff k := by
          intro H hH
          have h_all : ∀ k : ℕ, ∃ d : ↥R, H.coeff k = c₀ * d := by
            intro k
            by_cases hk : k ∈ H.support
            · exact hH k hk
            · rw [Polynomial.notMem_support_iff.mp hk]; exact ⟨0, (mul_zero c₀).symm⟩
          choose d hd using h_all
          let H₁ : A₀ := ∑ k ∈ H.support, Polynomial.monomial k (d k)
          have hH₁_fac : Polynomial.C c₀ * H₁ = H := by
            calc
              Polynomial.C c₀ * (∑ k ∈ H.support, Polynomial.monomial k (d k))
                  = ∑ k ∈ H.support, Polynomial.C c₀ * Polynomial.monomial k (d k) :=
                    Finset.mul_sum _ _ _
              _ = ∑ k ∈ H.support, Polynomial.monomial k (H.coeff k) := by
                    refine Finset.sum_congr rfl fun k _ => ?_
                    rw [Polynomial.C_mul_monomial, ← hd k]
              _ = H := H.as_sum_support.symm
          refine ⟨H₁, hH₁_fac, fun k => ?_⟩
          rw [← hH₁_fac, Polynomial.coeff_C_mul]
        obtain ⟨P₁, hP₁_fac, hP₁_c⟩ := hFactor P (fun k hk =>
          hc₀_dvd _ (Finset.mem_union_left _ (Finset.mem_image_of_mem _ hk)))
        obtain ⟨Q₁, hQ₁_fac, hQ₁_c⟩ := hFactor Q (fun k hk =>
          hc₀_dvd _ (Finset.mem_union_right _ (Finset.mem_image_of_mem _ hk)))
        have hCc₀_ne : ι₀ (Polynomial.C c₀) ≠ 0 :=
          hι₀_ne (fun h0 => hc₀_ne (Polynomial.C_eq_zero.mp h0))
        have hPQ₁ : ι₀ Q₁ * z.1 = ι₀ P₁ := by
          apply mul_left_cancel₀ hCc₀_ne
          calc
            ι₀ (Polynomial.C c₀) * (ι₀ Q₁ * z.1)
                = ι₀ (Polynomial.C c₀ * Q₁) * z.1 := by rw [map_mul, mul_assoc]
            _ = ι₀ Q * z.1 := by rw [hQ₁_fac]
            _ = ι₀ P := hPQ
            _ = ι₀ (Polynomial.C c₀ * P₁) := by rw [hP₁_fac]
            _ = ι₀ (Polynomial.C c₀) * ι₀ P₁ := map_mul _ _ _
        have hz_ne : z.1 ≠ 0 := by
          intro hz0; rw [hz0, mul_zero] at hPQ; exact hι₀_ne hP_ne hPQ.symm
        have hQP₁ : ι₀ P₁ * (z⁻¹).1 = ι₀ Q₁ := by
          change ι₀ P₁ * (z.1)⁻¹ = ι₀ Q₁
          apply mul_right_cancel₀ hz_ne
          rw [mul_assoc, inv_mul_cancel₀ hz_ne, mul_one, hPQ₁]
        simp only [S_c, Finset.mem_union, Finset.mem_image] at hc₀_mem
        rcases hc₀_mem with ⟨i, _, hi_eq⟩ | ⟨j, _, hj_eq⟩
        · right
          refine ⟨Q₁, P₁, ?_, hQP₁⟩
          rw [hq₀_iff]; push_neg
          refine ⟨i, ?_⟩
          have h1 : P₁.coeff i = 1 := mul_left_cancel₀ hc₀_ne ((hP₁_c i).trans (hi_eq.trans (mul_one c₀).symm))
          rwa [h1]
        · left
          refine ⟨P₁, Q₁, ?_, hPQ₁⟩
          rw [hq₀_iff]; push_neg
          refine ⟨j, ?_⟩
          have h1 : Q₁.coeff j = 1 := mul_left_cancel₀ hc₀_ne ((hQ₁_c j).trans (hj_eq.trans (mul_one c₀).symm))
          rwa [h1]
    let V₀ : ValuationSubring ↥F₀ := ValuationSubring.ofSubring V₀_sub hV₀_or
    have hV₀_Rloc : ∀ v : ↥V₀, (v.1 : F) ∈ R_loc := by
      intro v
      obtain ⟨P, Q, hQ, hPQ⟩ := v.2
      exact ⟨α₀ P, α₀ Q, hQ, hPQ⟩
    have hmV₀_Rloc : ∀ v : ↥V₀,
        v ∈ IsLocalRing.maximalIdeal ↥V₀ →
        (⟨(v.1 : F), hV₀_Rloc v⟩ : ↥R_loc) ∈ IsLocalRing.maximalIdeal ↥R_loc := by
      intro v hv
      obtain ⟨P, Q, hQ, hPQ⟩ := v.2
      have hP_q₀ : P ∈ q₀ := by
        by_contra hP_not
        have hv_ne : v.1 ≠ 0 := by
          intro hv0
          have hv0' : (v.1 : F) = 0 := congrArg Subtype.val hv0
          rw [hv0', mul_zero] at hPQ
          exact hP_not ((hinj_ι₀ (hPQ.symm.trans (map_zero ι₀).symm)) ▸ q₀.zero_mem)
        have hinv_V₀ : (v.1)⁻¹ ∈ V₀ := by
          refine ⟨Q, P, hP_not, ?_⟩
          change ι₀ P * (v.1 : F)⁻¹ = ι₀ Q
          have hvF_ne : (v.1 : F) ≠ 0 := fun h => hv_ne (Subtype.ext h)
          apply mul_right_cancel₀ hvF_ne
          rw [mul_assoc, inv_mul_cancel₀ hvF_ne, mul_one, hPQ]
        have hu : IsUnit v := isUnit_iff_exists_inv.mpr
          ⟨⟨(v.1)⁻¹, hinv_V₀⟩, Subtype.ext (mul_inv_cancel₀ hv_ne)⟩
        exact (IsLocalRing.mem_maximalIdeal v).mp hv hu
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      exact mt (hUnit_Rloc ⟨(v.1 : F), hV₀_Rloc v⟩ (α₀ P) (α₀ Q) hQ hPQ).mp (not_not.mpr hP_q₀)
    obtain ⟨W₀, h_le, h_loc⟩ := IsLocalRing.exists_factor_valuationRing R_loc.subtype
    let _ : IsLocalHom (R_loc.subtype.codRestrict W₀.toSubring h_le) := h_loc
    have hUnit_from_W₀ : ∀ r : ↥R_loc,
        IsUnit (R_loc.subtype.codRestrict W₀.toSubring h_le r) → IsUnit r :=
      fun r => IsLocalHom.map_nonunit r
    have h1_not_mW₀ : (1 : ↥W₀) ∉ IsLocalRing.maximalIdeal ↥W₀ :=
      fun h1 => (IsLocalRing.maximalIdeal.isMaximal ↥W₀).ne_top
        (Ideal.eq_top_of_isUnit_mem _ h1 isUnit_one)
    have hW₀_sub_Rloc : ∀ x : F, x ∈ W₀ → x ∈ R_loc := by
      intro x hxW₀
      by_cases hx0 : x = 0
      · rw [hx0]; exact R_loc.zero_mem
      · obtain ⟨P, hP_ne, hP_eval⟩ := hAlg_F x
        let n := P.natDegree
        have hP_supp : P.support.Nonempty := Polynomial.support_nonempty.mpr hP_ne
        have hMinV₀_aux : ∀ (s : Finset ℕ), s.Nonempty → (∀ j ∈ s, P.coeff j ≠ 0) →
            ∃ k₀ ∈ s, ∀ i ∈ s, P.coeff i / P.coeff k₀ ∈ V₀ := by
          intro s hs
          refine Finset.Nonempty.cons_induction
            (motive := fun s _ => (∀ j ∈ s, P.coeff j ≠ 0) →
              ∃ k₀ ∈ s, ∀ i ∈ s, P.coeff i / P.coeff k₀ ∈ V₀)
            (fun a ha_ne => ⟨a, Finset.mem_singleton_self a, fun i hi => by
              rw [Finset.mem_singleton.mp hi, div_self (ha_ne a (Finset.mem_singleton_self a))]
              exact V₀.one_mem⟩)
            (fun a s _ _ ih hne_all => ?_) hs
          have ha_ne : P.coeff a ≠ 0 := hne_all a (Finset.mem_cons_self a s)
          obtain ⟨k₁, hk₁, hd₁⟩ := ih (fun j hj => hne_all j (Finset.mem_cons.mpr (Or.inr hj)))
          have hk₁_ne : P.coeff k₁ ≠ 0 := hne_all k₁ (Finset.mem_cons.mpr (Or.inr hk₁))
          rcases ValuationSubring.mem_or_inv_mem V₀ (P.coeff a / P.coeff k₁) with hak | hka
          · refine ⟨k₁, Finset.mem_cons.mpr (Or.inr hk₁), fun i hi => ?_⟩
            rcases Finset.mem_cons.mp hi with rfl | his
            · exact hak
            · exact hd₁ i his
          · rw [inv_div] at hka
            refine ⟨a, Finset.mem_cons_self a s, fun i hi => ?_⟩
            rcases Finset.mem_cons.mp hi with rfl | his
            · rw [div_self ha_ne]; exact V₀.one_mem
            · have hmul : P.coeff i / P.coeff a =
                  (P.coeff i / P.coeff k₁) * (P.coeff k₁ / P.coeff a) :=
                (div_mul_div_cancel₀ hk₁_ne).symm
              rw [hmul]
              exact V₀.toSubring.mul_mem (hd₁ i his) hka
        obtain ⟨k₀, hk₀_supp, hk₀_div⟩ :=
          hMinV₀_aux P.support hP_supp (fun j hj => Polynomial.mem_support_iff.mp hj)
        let M_min : Finset ℕ :=
          P.support.filter (fun k => ∀ i ∈ P.support, P.coeff i / P.coeff k ∈ V₀)
        have hM_ne : M_min.Nonempty := ⟨k₀, Finset.mem_filter.mpr ⟨hk₀_supp, hk₀_div⟩⟩
        let m₀ := M_min.max' hM_ne
        have hm_mem : m₀ ∈ M_min := Finset.max'_mem M_min hM_ne
        obtain ⟨hm_supp, hm_div⟩ := Finset.mem_filter.mp hm_mem
        have hm_le_n : m₀ ≤ n := Polynomial.le_natDegree_of_mem_supp m₀ hm_supp
        have hPm_ne : P.coeff m₀ ≠ 0 := Polynomial.mem_support_iff.mp hm_supp
        have hc_V₀ : ∀ i : ℕ, P.coeff i / P.coeff m₀ ∈ V₀ := by
          intro i
          by_cases hi : i ∈ P.support
          · exact hm_div i hi
          · rw [Polynomial.notMem_support_iff.mp hi, zero_div]
            exact V₀.zero_mem
        let c : ℕ → F := fun i => ((P.coeff i / P.coeff m₀) : F)
        have hc_Rloc : ∀ i : ℕ, c i ∈ R_loc := fun i => hV₀_Rloc ⟨_, hc_V₀ i⟩
        have hc_W₀ : ∀ i : ℕ, c i ∈ W₀ := fun i => h_le ⟨c i, hc_Rloc i⟩
        have hPmF_ne : (P.coeff m₀ : F) ≠ 0 := fun h => hPm_ne (Subtype.ext h)
        have hcm_one : c m₀ = 1 := by
          change (P.coeff m₀ : F) / (P.coeff m₀ : F) = 1
          exact div_self hPmF_ne
        have hc_sum_zero : (∑ i ∈ Finset.range (n + 1), c i * x ^ i) = 0 := by
          have haev : (∑ i ∈ Finset.range (n + 1), (P.coeff i : F) * x ^ i) = 0 := by
            have h1 := hP_eval
            rw [Polynomial.aeval_eq_sum_range] at h1
            exact h1
          calc
            (∑ i ∈ Finset.range (n + 1), c i * x ^ i)
                = ((P.coeff m₀ : F))⁻¹ * (∑ i ∈ Finset.range (n + 1), (P.coeff i : F) * x ^ i) := by
                  rw [Finset.mul_sum]
                  refine Finset.sum_congr rfl fun i _ => ?_
                  change ((P.coeff i : F) / (P.coeff m₀ : F)) * x ^ i =
                    ((P.coeff m₀ : F))⁻¹ * ((P.coeff i : F) * x ^ i)
                  ring
            _ = 0 := by rw [haev, mul_zero]
        have hcj_max_W₀ : ∀ j : ℕ, m₀ < j →
            (⟨c j, hc_W₀ j⟩ : ↥W₀) ∈ IsLocalRing.maximalIdeal ↥W₀ := by
          intro j hmj
          have hcj_mV₀ : (⟨P.coeff j / P.coeff m₀, hc_V₀ j⟩ : ↥V₀) ∈ IsLocalRing.maximalIdeal ↥V₀ := by
            by_contra hnot
            have hu : IsUnit (⟨P.coeff j / P.coeff m₀, hc_V₀ j⟩ : ↥V₀) :=
              IsLocalRing.notMem_maximalIdeal.mp hnot
            obtain ⟨u_inv, hu_inv⟩ := hu.exists_right_inv
            have hu_val : (P.coeff j / P.coeff m₀) * u_inv.1 = 1 := congrArg Subtype.val hu_inv
            have hPj_ne : P.coeff j ≠ 0 := by
              intro h0; rw [h0, zero_div, zero_mul] at hu_val; exact one_ne_zero hu_val.symm
            have hj_supp : j ∈ P.support := Polynomial.mem_support_iff.mpr hPj_ne
            have hu_eq : u_inv.1 = P.coeff m₀ / P.coeff j := by
              apply mul_left_cancel₀ (div_ne_zero hPj_ne hPm_ne)
              rw [hu_val, div_mul_div_cancel₀ hPm_ne, div_self hPj_ne]
            have hmj_V₀ : P.coeff m₀ / P.coeff j ∈ V₀ := hu_eq ▸ u_inv.2
            have hj_M : j ∈ M_min := by
              refine Finset.mem_filter.mpr ⟨hj_supp, fun i hi => ?_⟩
              have hmul : P.coeff i / P.coeff j =
                  (P.coeff i / P.coeff m₀) * (P.coeff m₀ / P.coeff j) :=
                (div_mul_div_cancel₀ hPm_ne).symm
              rw [hmul]
              exact V₀.toSubring.mul_mem (hm_div i hi) hmj_V₀
            exact not_le.mpr hmj (Finset.le_max' M_min j hj_M)
          have hcj_mRloc : (⟨c j, hc_Rloc j⟩ : ↥R_loc) ∈ IsLocalRing.maximalIdeal ↥R_loc :=
            hmV₀_Rloc ⟨_, hc_V₀ j⟩ hcj_mV₀
          rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
          intro hu_W₀
          exact ((IsLocalRing.mem_maximalIdeal _).mp hcj_mRloc)
            (hUnit_from_W₀ ⟨c j, hc_Rloc j⟩ hu_W₀)
        let s : F := ∑ j ∈ Finset.Icc m₀ n, c j * x ^ (j - m₀)
        have hs_W₀ : s ∈ W₀ :=
          W₀.toSubring.sum_mem fun j _ => W₀.toSubring.mul_mem (hc_W₀ j) (W₀.toSubring.pow_mem hxW₀ (j - m₀))
        have hs_sub_one_mW₀ : (⟨s, hs_W₀⟩ - 1 : ↥W₀) ∈ IsLocalRing.maximalIdeal ↥W₀ := by
          have hIcc_eq : Finset.Icc m₀ n = insert m₀ (Finset.Ioc m₀ n) := by
            ext j
            simp only [Finset.mem_Icc, Finset.mem_insert, Finset.mem_Ioc]
            omega
          have hm_not_Ioc : m₀ ∉ Finset.Ioc m₀ n := by simp
          have hs_split : s - 1 = ∑ j ∈ Finset.Ioc m₀ n, c j * x ^ (j - m₀) := by
            dsimp only [s]
            rw [hIcc_eq, Finset.sum_insert hm_not_Ioc, Nat.sub_self, pow_zero, mul_one, hcm_one]
            ring
          let termW : ℕ → ↥W₀ := fun j => ⟨c j, hc_W₀ j⟩ * ⟨x, hxW₀⟩ ^ (j - m₀)
          have h_eq_W₀ : (⟨s, hs_W₀⟩ - 1 : ↥W₀) = ∑ j ∈ Finset.Ioc m₀ n, termW j := by
            apply Subtype.ext
            change s - 1 = (↑(∑ j ∈ Finset.Ioc m₀ n, termW j) : F)
            rw [hs_split, AddSubmonoidClass.coe_finset_sum]
            rfl
          rw [h_eq_W₀]
          refine Ideal.sum_mem _ fun j hj => ?_
          have hmj : m₀ < j := (Finset.mem_Ioc.mp hj).1
          exact Ideal.mul_mem_right _ _ (hcj_max_W₀ j hmj)
        have hs_unit_W₀ : IsUnit (⟨s, hs_W₀⟩ : ↥W₀) := by
          apply IsLocalRing.notMem_maximalIdeal.mp
          intro hs_m
          have h1_mem : (1 : ↥W₀) ∈ IsLocalRing.maximalIdeal ↥W₀ := by
            have heq : (1 : ↥W₀) = ⟨s, hs_W₀⟩ - (⟨s, hs_W₀⟩ - 1) := by ring
            rw [heq]
            exact (IsLocalRing.maximalIdeal ↥W₀).sub_mem hs_m hs_sub_one_mW₀
          exact h1_not_mW₀ h1_mem
        have hs_ne : s ≠ 0 := by
          intro hs0
          have h0_unit : IsUnit (0 : ↥W₀) := by
            have heq : (⟨s, hs_W₀⟩ : ↥W₀) = 0 := Subtype.ext hs0
            rwa [heq] at hs_unit_W₀
          exact not_isUnit_zero h0_unit
        have hRange_split : (∑ i ∈ Finset.range m₀, c i * x ^ i) + s * x ^ m₀ = 0 := by
          have h_union : Finset.range (n + 1) = Finset.range m₀ ∪ Finset.Icc m₀ n := by
            ext i
