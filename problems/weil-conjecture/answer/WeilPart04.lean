              rw [Ideal.ResidueField.lift_algebraMap, hz]
        _ = φ_K (algebraMap ↥V_P P₀.ResidueField s * z) := (map_mul φ_K _ _).symm
        _ = φ_K (algebraMap ↥V_P P₀.ResidueField c) := by rw [hmul_z]
