                  _ = ev_t g := by rw [mul_assoc, mul_inv_cancel₀ hz, mul_one] }
        have ht_mem : t ∈ K_sub := ⟨Polynomial.X, 1, one_ne_zero, by simp [ev_t]⟩
        have hK_top : K_sub = ⊤ := eq_top_iff.mpr (ht_gen ▸ IntermediateField.adjoin_le_iff.mpr
          (Set.singleton_subset_iff.mpr ht_mem))
        have hFrac_ev : @IsFractionRing (Polynomial F) _ L _ ev_t.toRingHom.toAlgebra := by
          let _ : Algebra (Polynomial F) L := ev_t.toRingHom.toAlgebra
          refine { map_units := ?_, surj := ?_, exists_of_eq := ?_ }
          · rintro ⟨g, hg⟩
            have hg0 : g ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hg
            exact IsUnit.mk0 (ev_t g) (fun h0 => hg0 (hInj_ev (h0.trans (map_zero _).symm)))
          · intro z
            have hz_mem : z ∈ K_sub := hK_top.symm ▸ IntermediateField.mem_top
            rcases hz_mem with ⟨f, g, hg, hfg⟩
            refine ⟨(f, ⟨g, mem_nonZeroDivisors_of_ne_zero hg⟩), ?_⟩
            change z * ev_t g = ev_t f
            rw [mul_comm, hfg]
          · intro f₁ f₂ h12
            exact ⟨1, by simp [hInj_ev h12]⟩
        let η_P := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev_t.toRingHom) ≫ j_a 0
        have hηP_comm : η_P ≫ π_F =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F L)) := by
          dsimp only [η_P]
          rw [CategoryTheory.Category.assoc, hj_comm 0, ← AlgebraicGeometry.Spec.map_comp,
            ← CommRingCat.ofHom_comp]
          congr 2
          ext c
          simp [ev_t]
        have : AlgebraicGeometry.IsIntegral P_F := hIntPF
        exact ⟨η_P, hηP_comm, hFuncOfOpenImm P_F (Polynomial F) L ev_t.toRingHom hFrac_ev (j_a 0)⟩

    
    obtain ⟨hPropPK', hIntPK', hNormPK', j₀_K', hj₀_open_K', hj₀_comm_K', hTwoPt_PK', _⟩ :=
      hProjLine K'
    obtain ⟨hPropPk, hIntPk, hNormPk, _, _, _, _, hFuncPk_mk⟩ := hProjLine k
    let s_ψ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k K'))
    have : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver K' 1).hom := hPropPK'
    have : AlgebraicGeometry.UniversallyClosed (CategoryTheory.Limits.pullback.snd p_X s_ψ) := by
      rw [hiso_K']; infer_instance
    have : AlgebraicGeometry.UniversallyClosed p_X :=
      @CategoryTheory.MorphismProperty.DescendsAlong.of_isPullback _ _
        (@AlgebraicGeometry.UniversallyClosed)
        (@AlgebraicGeometry.Surjective ⊓ @AlgebraicGeometry.Flat ⊓ @AlgebraicGeometry.QuasiCompact)
        AlgebraicGeometry.descendsAlong_universallyClosed_surjective_inf_flat_inf_quasicompact
        _ _ _ _ _ _ _ _ (CategoryTheory.IsPullback.of_hasPullback p_X s_ψ).flip
        ⟨⟨inferInstance, inferInstance⟩, inferInstance⟩ inferInstance
    have : AlgebraicGeometry.IsIntegral X := hIntX
    have : AlgebraicGeometry.IsSeparated p_X := hSepX
    have : AlgebraicGeometry.LocallyOfFiniteType p_X := hLftX
    have hPropX : AlgebraicGeometry.IsProper p_X := AlgebraicGeometry.IsProper.mk

    
    let X_K' := CategoryTheory.Limits.pullback p_X s_ψ
    let fst_X := CategoryTheory.Limits.pullback.fst p_X s_ψ
    let snd_X := CategoryTheory.Limits.pullback.snd p_X s_ψ
    have hSurj_fst : Function.Surjective fst_X.base :=
      (inferInstance : AlgebraicGeometry.Surjective fst_X).1
    have hInj_kK' : Function.Injective (algebraMap k K') := RingHom.injective (algebraMap k K')
    obtain ⟨ℓ, hℓ_id⟩ := LinearMap.exists_leftInverse_of_injective (Algebra.linearMap k K')
      (LinearMap.ker_eq_bot.mpr hInj_kK')
    have hℓ_one : ℓ 1 = 1 := by
      have := LinearMap.congr_fun hℓ_id (1 : k)
      simpa using this
    have hAffPullback : ∀ (U : X.Opens) (hU : AlgebraicGeometry.IsAffineOpen U),
        Nonempty ↥U →
        let A := ↑(X.presheaf.obj (Opposite.op U))
        letI : Algebra k A := (AlgebraicGeometry.Spec.preimage (hU.fromSpec ≫ p_X)).hom.toAlgebra
        IsDomain A ∧ IsIntegrallyClosed A ∧ Algebra.FiniteType k A ∧
        IsDomain (TensorProduct k A K') ∧
        ∃ (ι_U : AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct k A K')) ⟶ X_K'),
          AlgebraicGeometry.IsOpenImmersion ι_U ∧
          Nonempty ↥(AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct k A K'))) ∧
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A)) = hU.fromSpec ≫ p_X ∧
          ι_U ≫ snd_X =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom) := by
      intro U hU hUne
      let A : Type u := ↑(X.presheaf.obj (Opposite.op U))
      have : IsDomain A := @AlgebraicGeometry.IsIntegral.component_integral X hIntX U hUne
      let _ : Algebra k A := (AlgebraicGeometry.Spec.preimage (hU.fromSpec ≫ p_X)).hom.toAlgebra
      let f_A := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A))
      have hf_A : f_A = hU.fromSpec ≫ p_X :=
        AlgebraicGeometry.Spec.map_preimage (hU.fromSpec ≫ p_X)
      have hFT_A : Algebra.FiniteType k A := by
        have hLFT_fA : AlgebraicGeometry.LocallyOfFiniteType f_A := by
          rw [hf_A]; infer_instance
        exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff
          (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp hLFT_fA
      let m_U : CategoryTheory.Limits.pullback f_A s_ψ ⟶ X_K' :=
        CategoryTheory.Limits.pullback.map f_A s_ψ p_X s_ψ hU.fromSpec (𝟙 _) (𝟙 _)
          (by rw [CategoryTheory.Category.comp_id, hf_A])
          (by rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
      have : AlgebraicGeometry.IsOpenImmersion m_U :=
        AlgebraicGeometry.Scheme.pullback_map_isOpenImmersion f_A s_ψ p_X s_ψ hU.fromSpec (𝟙 _) (𝟙 _) _ _
      let ι_U : AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct k A K')) ⟶ X_K' :=
        (AlgebraicGeometry.pullbackSpecIso k A K').inv ≫ m_U
      have : AlgebraicGeometry.IsOpenImmersion ι_U := inferInstance
      have hιU_snd : ι_U ≫ snd_X =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom) := by
        dsimp only [ι_U, m_U, snd_X]
        rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          CategoryTheory.Category.comp_id, AlgebraicGeometry.pullbackSpecIso_inv_snd]
        rfl
      obtain ⟨u₀_pt⟩ := hUne
      obtain ⟨y₀, hy₀⟩ := hSurj_fst u₀_pt.1
      have hRange_mU : y₀ ∈ Set.range m_U.base := by
        rw [AlgebraicGeometry.Scheme.Pullback.range_map,
          show Set.range hU.fromSpec.base = (U : Set ↥X) from
            congrArg SetLike.coe hU.opensRange_fromSpec]
        exact ⟨by change fst_X.base y₀ ∈ U; rw [hy₀]; exact u₀_pt.2, ⟨snd_X.base y₀, rfl⟩⟩
      rcases hRange_mU with ⟨w_pb, _⟩
      let pt_B : ↥(AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct k A K'))) :=
        (AlgebraicGeometry.pullbackSpecIso k A K').hom.base w_pb
      have hSpec_ne : Nonempty ↥(AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct k A K'))) :=
        ⟨pt_B⟩
      let j_U : AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct k A K')) ⟶
          (weilProjectiveSpaceOver K' 1).left := ι_U ≫ iso_K'.hom
      have : AlgebraicGeometry.IsOpenImmersion j_U := inferInstance
      let W_U := j_U.opensRange
      have hAff_WU : AlgebraicGeometry.IsAffineOpen W_U :=
        AlgebraicGeometry.isAffineOpen_opensRange j_U
      have hWU_ne : Nonempty ↥W_U := ⟨⟨j_U.base pt_B, pt_B, rfl⟩⟩
      obtain ⟨hDom_WU, hIC_WU⟩ := hNormPK' W_U hAff_WU hWU_ne
      have hrng_WU : Set.range hAff_WU.fromSpec.base = Set.range j_U.base :=
        congrArg SetLike.coe hAff_WU.opensRange_fromSpec
      let v_fwd := AlgebraicGeometry.IsOpenImmersion.lift j_U hAff_WU.fromSpec (le_of_eq hrng_WU)
      let v_bwd := AlgebraicGeometry.IsOpenImmersion.lift hAff_WU.fromSpec j_U (le_of_eq hrng_WU.symm)
      have hv_fb : v_fwd ≫ v_bwd = 𝟙 _ := by
        apply (cancel_mono hAff_WU.fromSpec).mp
        rw [CategoryTheory.Category.assoc, AlgebraicGeometry.IsOpenImmersion.lift_fac,
          AlgebraicGeometry.IsOpenImmersion.lift_fac, CategoryTheory.Category.id_comp]
      have hv_bf : v_bwd ≫ v_fwd = 𝟙 _ := by
        apply (cancel_mono j_U).mp
        rw [CategoryTheory.Category.assoc, AlgebraicGeometry.IsOpenImmersion.lift_fac,
          AlgebraicGeometry.IsOpenImmersion.lift_fac, CategoryTheory.Category.id_comp]
      let iso_WU_cat : CommRingCat.of (TensorProduct k A K') ≅
          (weilProjectiveSpaceOver K' 1).left.presheaf.obj (Opposite.op W_U) :=
        { hom := AlgebraicGeometry.Spec.preimage v_fwd
          inv := AlgebraicGeometry.Spec.preimage v_bwd
          hom_inv_id := AlgebraicGeometry.Spec.map_injective (by
            rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
              AlgebraicGeometry.Spec.map_preimage, hv_bf, AlgebraicGeometry.Spec.map_id])
          inv_hom_id := AlgebraicGeometry.Spec.map_injective (by
            rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
              AlgebraicGeometry.Spec.map_preimage, hv_fb, AlgebraicGeometry.Spec.map_id]) }
      let e_WU := iso_WU_cat.commRingCatIsoToRingEquiv
      let B := TensorProduct k A K'
      have : IsDomain B := MulEquiv.isDomain _ e_WU.toMulEquiv
      have : IsIntegrallyClosed B := IsIntegrallyClosed.of_equiv e_WU.symm
      let retr : B →ₗ[k] A := TensorProduct.lift
        { toFun := fun a => (LinearMap.toSpanSingleton k A a).comp ℓ
          map_add' := fun a₁ a₂ => LinearMap.ext fun c => smul_add (ℓ c) a₁ a₂
          map_smul' := fun r a => LinearMap.ext fun c => smul_comm (ℓ c) r a }
      have hretr_tmul : ∀ (a : A) (c : K'), retr (a ⊗ₜ[k] c) = ℓ c • a := fun _ _ => rfl
      have hretr_one : ∀ a : A, retr (a ⊗ₜ[k] 1) = a := fun a => by
        rw [hretr_tmul, hℓ_one, one_smul]
      have hretr_mul : ∀ (b : A) (w : B), retr ((b ⊗ₜ[k] 1) * w) = b * retr w := by
        intro b w
        induction w using TensorProduct.induction_on with
        | zero => simp
        | tmul a c =>
          rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, hretr_tmul, hretr_tmul, mul_smul_comm]
        | add w₁ w₂ ih₁ ih₂ => rw [mul_add, map_add, map_add, ih₁, ih₂, mul_add]
      have hIC_A : IsIntegrallyClosed A := by
        rw [isIntegrallyClosed_iff (FractionRing A)]
        intro z hz
        obtain ⟨⟨x, b, hb⟩, hzb⟩ := IsLocalization.surj (nonZeroDivisors A) z
        let incL : A →+* B := Algebra.TensorProduct.includeLeftRingHom
        have hincL_units : ∀ s : nonZeroDivisors A,
            IsUnit (algebraMap B (FractionRing B) (incL s.1)) := by
          rintro ⟨s, hs⟩
          have hs_ne : s ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hs
          have hinc_ne : incL s ≠ 0 := by
            intro h0
            have hr0 : retr (s ⊗ₜ[k] 1) = 0 := by
              change retr (incL s) = 0; rw [h0, map_zero]
            rw [hretr_one] at hr0
            exact hs_ne hr0
          exact IsLocalization.map_units (FractionRing B) ⟨incL s, mem_nonZeroDivisors_of_ne_zero hinc_ne⟩
        let ψ_frac : FractionRing A →+* FractionRing B :=
          IsLocalization.lift (g := (algebraMap B (FractionRing B)).comp incL) hincL_units
        have hψ_comp : ψ_frac.comp (algebraMap A (FractionRing A)) =
            (algebraMap B (FractionRing B)).comp incL :=
          RingHom.ext fun a => IsLocalization.lift_eq hincL_units a
        obtain ⟨P, hP_monic, hP_eval⟩ := hz
        have hz_B : _root_.IsIntegral B (ψ_frac z) := by
          refine ⟨P.map incL, hP_monic.map incL, ?_⟩
          rw [Polynomial.eval₂_map, ← hψ_comp, ← Polynomial.hom_eval₂, hP_eval, map_zero]
        obtain ⟨w, hw⟩ := (isIntegrallyClosed_iff (FractionRing B)).mp inferInstance hz_B
        have hbw_eq : (b ⊗ₜ[k] (1 : K')) * w = x ⊗ₜ[k] (1 : K') := by
          apply IsFractionRing.injective B (FractionRing B)
          rw [map_mul, hw]
          have hb_ψ : algebraMap B (FractionRing B) (b ⊗ₜ[k] 1) =
              ψ_frac (algebraMap A (FractionRing A) b) :=
            (congrArg (fun f => f b) hψ_comp).symm
          have hx_ψ : algebraMap B (FractionRing B) (x ⊗ₜ[k] 1) =
              ψ_frac (algebraMap A (FractionRing A) x) :=
            (congrArg (fun f => f x) hψ_comp).symm
          rw [hb_ψ, hx_ψ, ← map_mul, mul_comm, hzb]
        have hx_eq : b * retr w = x := by
          have := congrArg retr hbw_eq
          rwa [hretr_mul, hretr_one] at this
        refine ⟨retr w, ?_⟩
        have hb_unit : IsUnit (algebraMap A (FractionRing A) b) :=
          IsLocalization.map_units (FractionRing A) ⟨b, hb⟩
        apply hb_unit.mul_right_inj.mp
        change algebraMap A (FractionRing A) b * algebraMap A (FractionRing A) (retr w) =
          algebraMap A (FractionRing A) b * z
        rw [← map_mul, hx_eq, ← hzb, mul_comm]
      exact ⟨inferInstance, hIC_A, hFT_A, inferInstance, ι_U, inferInstance, hSpec_ne, hf_A, hιU_snd⟩

    have hNormX : IsAffineNormalScheme X := fun U hU hUne =>
      ⟨(hAffPullback U hU hUne).1, (hAffPullback U hU hUne).2.1⟩

    obtain ⟨x₀_X⟩ := hIntX.nonempty
    obtain ⟨U₀, hU₀, hx₀_U₀, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := ⊤) (x := x₀_X) trivial
    have hU₀_ne : Nonempty ↥U₀ := ⟨⟨x₀_X, hx₀_U₀⟩⟩
    let A₀ : Type u := ↑(X.presheaf.obj (Opposite.op U₀))
    let _ : Algebra k A₀ := (AlgebraicGeometry.Spec.preimage (hU₀.fromSpec ≫ p_X)).hom.toAlgebra
    obtain ⟨hDom_A₀, _, hFT_A₀, hDom_B, ι₁, hOpen_ι₁, hSpecB_ne, hf_A₀, hι₁_snd⟩ :=
      hAffPullback U₀ hU₀ hU₀_ne
    let _ : IsDomain A₀ := hDom_A₀
    let _ : Algebra.FiniteType k A₀ := hFT_A₀
    have hNonConst : ∃ a₀ : A₀, a₀ ∉ Set.range (algebraMap k A₀) := by
      by_contra! hall
      have hSurj_kA : Function.Surjective (algebraMap k A₀) := hall
      let e_kA : k ≃ₐ[k] A₀ :=
        AlgEquiv.ofBijective (Algebra.ofId k A₀) ⟨RingHom.injective (algebraMap k A₀), hSurj_kA⟩
      let e_BK : TensorProduct k A₀ K' ≃ₐ[k] K' :=
        (Algebra.TensorProduct.congr e_kA.symm AlgEquiv.refl).trans (Algebra.TensorProduct.lid k K')
      have hSubK' : Subsingleton (PrimeSpectrum K') := inferInstance
      have hSubB : Subsingleton ↥(AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct k A₀ K'))) :=
        Function.Injective.subsingleton (f := PrimeSpectrum.comap e_BK.symm.toRingHom) fun p₁ p₂ hp =>
          PrimeSpectrum.ext (Ideal.ext fun w => by
            have h_iff := iff_of_eq (congrArg (fun q : PrimeSpectrum K' => e_BK w ∈ q.asIdeal) hp)
            change e_BK.symm (e_BK w) ∈ p₁.asIdeal ↔ e_BK.symm (e_BK w) ∈ p₂.asIdeal at h_iff
            rwa [e_BK.symm_apply_apply] at h_iff)
      have : AlgebraicGeometry.IsOpenImmersion ι₁ := hOpen_ι₁
      let j₁ := ι₁ ≫ iso_K'.hom
      have : AlgebraicGeometry.IsOpenImmersion j₁ := inferInstance
      obtain ⟨pt_B⟩ := hSpecB_ne
      obtain ⟨y₁, y₂, hy_ne⟩ := hTwoPt_PK' inferInstance j₁.opensRange ⟨⟨j₁.base pt_B, pt_B, rfl⟩⟩
      rcases y₁.2 with ⟨p₁, hp₁⟩
      rcases y₂.2 with ⟨p₂, hp₂⟩
      apply hy_ne
      apply Subtype.ext
      rw [← hp₁, ← hp₂, @Subsingleton.elim _ hSubB p₁ p₂]
    let η_X := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))) ≫ hU₀.fromSpec
    have hηX_comm : η_X ≫ p_X =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k (FractionRing A₀))) := by
      dsimp only [η_X]
      rw [CategoryTheory.Category.assoc, ← hf_A₀, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, ← IsScalarTower.algebraMap_eq k A₀ (FractionRing A₀)]
    have hFrac_A₀ :
        @IsFractionRing A₀ _ (FractionRing A₀) _ (algebraMap A₀ (FractionRing A₀)).toAlgebra := by
      have h_map := IsLocalization.map_units (M := nonZeroDivisors A₀) (FractionRing A₀)
      have h_surj := IsLocalization.surj (M := nonZeroDivisors A₀) (S := FractionRing A₀)
      have h_eq : ∀ {x y : A₀},
          algebraMap A₀ (FractionRing A₀) x = algebraMap A₀ (FractionRing A₀) y →
            ∃ c : nonZeroDivisors A₀, ↑c * x = ↑c * y :=
        fun h => (IsLocalization.eq_iff_exists (nonZeroDivisors A₀) (FractionRing A₀)).mp h
      let _ : Algebra A₀ (FractionRing A₀) := (algebraMap A₀ (FractionRing A₀)).toAlgebra
      exact { map_units := h_map, surj := h_surj, exists_of_eq := @h_eq }
    have hFuncX : IsSchemeFunctionField X (FractionRing A₀) η_X :=
      hFuncOfOpenImm X A₀ (FractionRing A₀) (algebraMap A₀ (FractionRing A₀)) hFrac_A₀ hU₀.fromSpec
    let B := TensorProduct k A₀ K'
    have : AlgebraicGeometry.IsOpenImmersion ι₁ := hOpen_ι₁
    have : AlgebraicGeometry.IsOpenImmersion j₀_K' := hj₀_open_K'
    let ι_W : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial K')) ⟶ X_K' :=
      j₀_K' ≫ iso_K'.inv
    have : AlgebraicGeometry.IsOpenImmersion ι_W := inferInstance
    have hιW_snd : ι_W ≫ snd_X = AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) := by
      dsimp only [ι_W, snd_X]
      rw [CategoryTheory.Category.assoc, hiso_K', ← CategoryTheory.Category.assoc iso_K'.inv,
        iso_K'.inv_hom_id, CategoryTheory.Category.id_comp, hj₀_comm_K']
    have hIrredPK' : IrreducibleSpace ↥(weilProjectiveSpaceOver K' 1).left :=
      @AlgebraicGeometry.irreducibleSpace_of_isIntegral _ hIntPK'
    let homeo_iso : ↥(weilProjectiveSpaceOver K' 1).left ≃ₜ ↥X_K' :=
      TopCat.homeoOfIso (AlgebraicGeometry.Scheme.forgetToTop.mapIso iso_K'.symm)
    have : IrreducibleSpace ↥X_K' :=
      { toNonempty := ⟨homeo_iso hIrredPK'.toNonempty.some⟩
        isPreirreducible_univ := by
          have hUniv : (Set.univ : Set ↥X_K') = homeo_iso '' Set.univ := by
            rw [Set.image_univ, homeo_iso.surjective.range_eq]
          rw [hUniv]
          exact hIrredPK'.isPreirreducible_univ.image homeo_iso homeo_iso.continuous.continuousOn }
    obtain ⟨pt_B₀⟩ := hSpecB_ne
    let pt_PK' : PrimeSpectrum (Polynomial K') := ⟨⊥, inferInstance⟩
    obtain ⟨z₀, ⟨p₀, hp₀_eq⟩, ⟨r₀, hr₀_eq⟩⟩ :=
      nonempty_preirreducible_inter ι₁.opensRange.isOpen ι_W.opensRange.isOpen
        ⟨ι₁.base pt_B₀, pt_B₀, rfl⟩ ⟨ι_W.base pt_PK', pt_PK', rfl⟩
    have hp₀_in : p₀ ∈ (TopologicalSpace.Opens.map ι₁.base).obj ι_W.opensRange := by
      change ι₁.base p₀ ∈ Set.range ι_W.base
      rw [hp₀_eq, ← hr₀_eq]; exact ⟨r₀, rfl⟩
    obtain ⟨_, ⟨h₁, rfl⟩, hp₀_h₁, hh₁_sub⟩ :=
      (TopologicalSpace.Opens.isBasis_iff_nbhd.mp PrimeSpectrum.isBasis_basic_opens) hp₀_in
    let loc_h₁ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B (Localization.Away h₁)))
    have : AlgebraicGeometry.IsOpenImmersion loc_h₁ :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization h₁
    have hRange_h₁ : Set.range (loc_h₁ ≫ ι₁).base ⊆ Set.range ι_W.base := by
      rintro _ ⟨p', rfl⟩
      have hp'_mem : loc_h₁.base p' ∈ (PrimeSpectrum.basicOpen h₁ : Set (PrimeSpectrum B)) := by
        rw [← PrimeSpectrum.localization_away_comap_range (Localization.Away h₁) h₁]
        exact ⟨p', rfl⟩
      exact hh₁_sub hp'_mem
    let α_sch := AlgebraicGeometry.IsOpenImmersion.lift ι_W (loc_h₁ ≫ ι₁) hRange_h₁
    have hα_fac : α_sch ≫ ι_W = loc_h₁ ≫ ι₁ :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac ι_W (loc_h₁ ≫ ι₁) hRange_h₁
    have : AlgebraicGeometry.IsOpenImmersion α_sch :=
      AlgebraicGeometry.IsOpenImmersion.of_comp α_sch ι_W
    have hp₀_loc₁ : p₀ ∈ Set.range loc_h₁.base := by
      have : (p₀ : PrimeSpectrum B) ∈
          Set.range (PrimeSpectrum.comap (algebraMap B (Localization.Away h₁))) := by
        rw [PrimeSpectrum.localization_away_comap_range (Localization.Away h₁) h₁]
        exact hp₀_h₁
      exact this
    rcases hp₀_loc₁ with ⟨p₁, hp₁_eq⟩
    have hr₀_in_α : r₀ ∈ α_sch.opensRange := by
      refine ⟨p₁, ι_W.isOpenEmbedding.injective ?_⟩
      change (α_sch ≫ ι_W).base p₁ = ι_W.base r₀
      rw [hα_fac]
      change ι₁.base (loc_h₁.base p₁) = ι_W.base r₀
      rw [hp₁_eq, hp₀_eq, hr₀_eq]
    obtain ⟨_, ⟨q, rfl⟩, hr₀_q, hq_sub⟩ :=
      (TopologicalSpace.Opens.isBasis_iff_nbhd.mp PrimeSpectrum.isBasis_basic_opens) hr₀_in_α
    let loc_q := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap (Polynomial K') (Localization.Away q)))
    have : AlgebraicGeometry.IsOpenImmersion loc_q :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization q
    have hRange_q : Set.range loc_q.base ⊆ Set.range α_sch.base := by
      rintro _ ⟨r', rfl⟩
      have hr'_mem : loc_q.base r' ∈ (PrimeSpectrum.basicOpen q : Set (PrimeSpectrum (Polynomial K'))) := by
        rw [← PrimeSpectrum.localization_away_comap_range (Localization.Away q) q]
        exact ⟨r', rfl⟩
      exact hq_sub hr'_mem
    let β_sch := AlgebraicGeometry.IsOpenImmersion.lift α_sch loc_q hRange_q
    have hβ_fac : β_sch ≫ α_sch = loc_q :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac α_sch loc_q hRange_q
    have : AlgebraicGeometry.IsOpenImmersion β_sch :=
      AlgebraicGeometry.IsOpenImmersion.of_comp β_sch α_sch
    have hr₀_locq : r₀ ∈ Set.range loc_q.base := by
      have : (r₀ : PrimeSpectrum (Polynomial K')) ∈
          Set.range (PrimeSpectrum.comap (algebraMap (Polynomial K') (Localization.Away q))) := by
        rw [PrimeSpectrum.localization_away_comap_range (Localization.Away q) q]
        exact hr₀_q
      exact this
    rcases hr₀_locq with ⟨r₁, hr₁_eq⟩
    have hp₁_eq_β : β_sch.base r₁ = p₁ := by
      apply α_sch.isOpenEmbedding.injective
      change (β_sch ≫ α_sch).base r₁ = α_sch.base p₁
      rw [hβ_fac, hr₁_eq]
      apply ι_W.isOpenEmbedding.injective
      change ι_W.base r₀ = (α_sch ≫ ι_W).base p₁
      rw [hα_fac]
      change ι_W.base r₀ = ι₁.base (loc_h₁.base p₁)
      rw [hp₁_eq, hp₀_eq, hr₀_eq]
    have hp₀_in_β : p₀ ∈ (β_sch ≫ loc_h₁).opensRange := ⟨r₁, by
      change loc_h₁.base (β_sch.base r₁) = p₀
      rw [hp₁_eq_β, hp₁_eq]⟩
    obtain ⟨_, ⟨h₂, rfl⟩, hp₀_h₂, hh₂_sub⟩ :=
      (TopologicalSpace.Opens.isBasis_iff_nbhd.mp PrimeSpectrum.isBasis_basic_opens) hp₀_in_β
    have hh₂_ne : h₂ ≠ 0 := fun h0 => hp₀_h₂ (h0 ▸ p₀.asIdeal.zero_mem)
    let loc_h₂ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B (Localization.Away h₂)))
    have : AlgebraicGeometry.IsOpenImmersion loc_h₂ :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization h₂
    have hRange_h₂ : Set.range loc_h₂.base ⊆ Set.range (β_sch ≫ loc_h₁).base := by
      rintro _ ⟨p', rfl⟩
      have hp'_mem : loc_h₂.base p' ∈ (PrimeSpectrum.basicOpen h₂ : Set (PrimeSpectrum B)) := by
        rw [← PrimeSpectrum.localization_away_comap_range (Localization.Away h₂) h₂]
        exact ⟨p', rfl⟩
      exact hh₂_sub hp'_mem
    let γ_sch := AlgebraicGeometry.IsOpenImmersion.lift (β_sch ≫ loc_h₁) loc_h₂ hRange_h₂
    have hγ_fac : γ_sch ≫ β_sch ≫ loc_h₁ = loc_h₂ :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac (β_sch ≫ loc_h₁) loc_h₂ hRange_h₂
    let φ₁ : Localization.Away h₁ →+* Localization.Away q := (AlgebraicGeometry.Spec.preimage β_sch).hom
    let φ₂ : Localization.Away q →+* Localization.Away h₂ := (AlgebraicGeometry.Spec.preimage γ_sch).hom
    have hSpec_φ₁ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁) = β_sch :=
      AlgebraicGeometry.Spec.map_preimage β_sch
    have hSpec_φ₂ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₂) = γ_sch :=
      AlgebraicGeometry.Spec.map_preimage γ_sch
    have hφ₁₂ : ∀ w : B,
        φ₂ (φ₁ (algebraMap B (Localization.Away h₁) w)) = algebraMap B (Localization.Away h₂) w := by
      have hSpec_eq : AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((φ₂.comp φ₁).comp (algebraMap B (Localization.Away h₁)))) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B (Localization.Away h₂))) := by
        calc AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom ((φ₂.comp φ₁).comp (algebraMap B (Localization.Away h₁))))
            = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₂) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁) ≫ loc_h₁ := by
              dsimp only [loc_h₁]
              rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
                ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
          _ = γ_sch ≫ β_sch ≫ loc_h₁ := by rw [hSpec_φ₂, hSpec_φ₁]
          _ = loc_h₂ := hγ_fac
      have hHom_eq := CommRingCat.hom_ext_iff.mp (AlgebraicGeometry.Spec.map_injective hSpec_eq)
      exact fun w => congrArg (fun f : B →+* Localization.Away h₂ => f w) hHom_eq
    have hφ₂_K' : ∀ c : K',
        φ₂ (algebraMap (Polynomial K') (Localization.Away q) (Polynomial.C c)) =
          algebraMap B (Localization.Away h₂) (1 ⊗ₜ[k] c) := by
      have hSpec_eq : AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((φ₂.comp (algebraMap (Polynomial K') (Localization.Away q))).comp
            Polynomial.C)) =
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((algebraMap B (Localization.Away h₂)).comp
              Algebra.TensorProduct.includeRight.toRingHom)) := by
        have lhs_eq : AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((φ₂.comp (algebraMap (Polynomial K') (Localization.Away q))).comp
              Polynomial.C)) =
            γ_sch ≫ loc_q ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) := by
          rw [← hSpec_φ₂]
          dsimp only [loc_q]
          rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
            ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
        have rhs_eq : AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((algebraMap B (Localization.Away h₂)).comp
              Algebra.TensorProduct.includeRight.toRingHom)) =
            loc_h₂ ≫ AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom) := by
          dsimp only [loc_h₂]
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        rw [lhs_eq, rhs_eq, ← hιW_snd, ← hι₁_snd]
        calc γ_sch ≫ loc_q ≫ ι_W ≫ snd_X
            = γ_sch ≫ (β_sch ≫ α_sch) ≫ ι_W ≫ snd_X := by rw [← hβ_fac]
          _ = γ_sch ≫ β_sch ≫ (α_sch ≫ ι_W) ≫ snd_X := by simp only [CategoryTheory.Category.assoc]
          _ = (γ_sch ≫ β_sch ≫ loc_h₁) ≫ ι₁ ≫ snd_X := by
              rw [hα_fac]; simp only [CategoryTheory.Category.assoc]
          _ = loc_h₂ ≫ ι₁ ≫ snd_X := by rw [hγ_fac]
      have hHom_eq := CommRingCat.hom_ext_iff.mp (AlgebraicGeometry.Spec.map_injective hSpec_eq)
      exact fun c => congrArg (fun f : K' →+* Localization.Away h₂ => f c) hHom_eq
    exact ⟨hPropX, hPropPk, hIntPk, hNormPk, hFuncPk_mk, hNormX,
      A₀, inferInstance, hDom_A₀, inferInstance, hFT_A₀, hDom_B, hNonConst,
      ⟨η_X, hηX_comm, hFuncX⟩, h₁, h₂, q, hh₂_ne, φ₁, φ₂, hφ₂_K', hφ₁₂⟩

  obtain ⟨hPropX, hPropPk, hIntPk, hNormPk, hFuncPk_mk, hNormX,
    A₀, instCR_A₀, instDom_A₀, instAlg_A₀, instFT_A₀,
    hDom_B, hNonConst, ⟨η_X, hηX_comm, hFuncX⟩, h₁, h₂, q, hh₂_ne, φ₁, φ₂, hφ₂_K', hφ₁₂⟩ :=
    hFirstHalf
  let _ : CommRing A₀ := instCR_A₀
  let _ : IsDomain A₀ := instDom_A₀
  let _ : Algebra k A₀ := instAlg_A₀
  let _ : Algebra.FiniteType k A₀ := instFT_A₀

  
  have hRatParam : ∃ t : FractionRing A₀,
      Transcendental k t ∧
      IntermediateField.adjoin k ({t} : Set (FractionRing A₀)) = ⊤ ∧
      Algebra.trdeg k (FractionRing A₀) = 1 := by
    let B := TensorProduct k A₀ K'
    have : IsDomain B := hDom_B
    obtain ⟨G_A, hG_A⟩ := (Algebra.FiniteType.out : (⊤ : Subalgebra k A₀).FG)
    let ι₁ := algebraMap B (Localization.Away h₁)
    let ι₂ := algebraMap B (Localization.Away h₂)
    let ι_q := algebraMap (Polynomial K') (Localization.Away q)
    have hpow_h₂_nzd : Submonoid.powers h₂ ≤ nonZeroDivisors B := by
      rintro _ ⟨n, rfl⟩
      exact mem_nonZeroDivisors_of_ne_zero (pow_ne_zero n hh₂_ne)
    have hInj_ι₂ : Function.Injective ι₂ :=
      IsLocalization.injective (Localization.Away h₂) hpow_h₂_nzd
    have : Nontrivial (Localization.Away h₂) :=
      ⟨⟨0, 1, fun h01 => zero_ne_one (hInj_ι₂ (by simpa using h01))⟩⟩
    let T_img : Localization.Away h₂ := φ₂ (ι_q Polynomial.X)
    obtain ⟨⟨F, s_F⟩, hFH₂⟩ := IsLocalization.surj (Submonoid.powers h₂) T_img
    rcases s_F with ⟨_, m₀, rfl⟩
    let H₂ : B := h₂ ^ m₀
    have hH₂_ne : H₂ ≠ 0 := pow_ne_zero m₀ hh₂_ne
    have hH₂_unit : IsUnit (ι₂ H₂) :=
      IsLocalization.map_units (Localization.Away h₂) (⟨H₂, m₀, rfl⟩ : Submonoid.powers h₂)
    have hFH₂' : T_img * ι₂ H₂ = ι₂ F := hFH₂
    have hSurj_g : ∀ g : ↥G_A,
        ∃ (P : Polynomial K') (d : ℕ),
          φ₁ (ι₁ (g.1 ⊗ₜ[k] 1)) * ι_q (q ^ d) = ι_q P := by
      intro g
      obtain ⟨⟨P, s_P⟩, hP⟩ :=
        IsLocalization.surj (Submonoid.powers q) (φ₁ (ι₁ (g.1 ⊗ₜ[k] 1)))
      rcases s_P with ⟨_, d, rfl⟩
      exact ⟨P, d, hP⟩
    choose P_g d_g hPQ_g using hSurj_g
    let Q_g : ↥G_A → Polynomial K' := fun g => q ^ d_g g
    have hQ_unit : ∀ g : ↥G_A, IsUnit (φ₂ (ι_q (Q_g g))) := fun g =>
      (IsLocalization.map_units (Localization.Away q)
        (⟨q ^ d_g g, d_g g, rfl⟩ : Submonoid.powers q)).map φ₂
    have hPQ_ι₂ : ∀ g : ↥G_A, ι₂ (g.1 ⊗ₜ[k] 1) * φ₂ (ι_q (Q_g g)) = φ₂ (ι_q (P_g g)) := by
      intro g
      have := congrArg φ₂ (hPQ_g g)
      rwa [map_mul, hφ₁₂ (g.1 ⊗ₜ[k] 1)] at this
    let homSum : ∀ {R_c : Type u} [CommRing R_c] [Algebra k R_c],
        ℕ → TensorProduct k A₀ R_c → TensorProduct k A₀ R_c → (ℕ → R_c) →
          TensorProduct k A₀ R_c :=
      fun D F_R H_R c =>
        ∑ j ∈ Finset.range (D + 1), ((1 : A₀) ⊗ₜ[k] c j) * F_R ^ j * H_R ^ (D - j)
    have h_homSum_K' : ∀ (D : ℕ) (G : Polynomial K'), G.natDegree ≤ D →
        ι₂ (homSum D F H₂ G.coeff) = φ₂ (ι_q G) * ι₂ H₂ ^ D := by
      intro D G hdeg
      have hG_sum : G = ∑ j ∈ Finset.range (D + 1), Polynomial.C (G.coeff j) * Polynomial.X ^ j := by
        conv_lhs => rw [Polynomial.as_sum_range' G (D + 1) (Nat.lt_succ_of_le hdeg)]
        exact Finset.sum_congr rfl fun j _ => (Polynomial.C_mul_X_pow_eq_monomial).symm
      conv_rhs => rw [hG_sum]
      rw [map_sum, map_sum, map_sum, Finset.sum_mul]
      refine Finset.sum_congr rfl fun j hj_mem => ?_
      have hj : j ≤ D := Nat.lt_succ_iff.mp (Finset.mem_range.mp hj_mem)
      rw [map_mul ι₂, map_mul ι₂, map_pow ι₂, map_pow ι₂, map_mul ι_q, map_pow ι_q,
        map_mul φ₂, map_pow φ₂, hφ₂_K']
      change ι₂ (1 ⊗ₜ[k] G.coeff j) * ι₂ F ^ j * ι₂ H₂ ^ (D - j) =
        ι₂ (1 ⊗ₜ[k] G.coeff j) * T_img ^ j * ι₂ H₂ ^ D
      rw [← hFH₂', mul_pow]
      calc ι₂ (1 ⊗ₜ[k] G.coeff j) * (T_img ^ j * ι₂ H₂ ^ j) * ι₂ H₂ ^ (D - j)
          = ι₂ (1 ⊗ₜ[k] G.coeff j) * T_img ^ j * (ι₂ H₂ ^ j * ι₂ H₂ ^ (D - j)) := by ring
        _ = ι₂ (1 ⊗ₜ[k] G.coeff j) * T_img ^ j * ι₂ H₂ ^ D := by
            rw [← pow_add, Nat.add_sub_of_le hj]
    let D_g : ↥G_A → ℕ := fun g => max (P_g g).natDegree (Q_g g).natDegree
    let Num_g : ↥G_A → B := fun g => homSum (D_g g) F H₂ (P_g g).coeff
    let Den_g : ↥G_A → B := fun g => homSum (D_g g) F H₂ (Q_g g).coeff
    have hDen_ne : ∀ g : ↥G_A, Den_g g ≠ 0 := by
      intro g h0
      have h_u : IsUnit (ι₂ (Den_g g)) := by
        rw [h_homSum_K' (D_g g) (Q_g g) (le_max_right _ _)]
        exact (hQ_unit g).mul (hH₂_unit.pow (D_g g))
      rw [h0, map_zero] at h_u
      exact h_u.ne_zero rfl
    have hRel_B : ∀ g : ↥G_A, (g.1 ⊗ₜ[k] (1 : K')) * Den_g g = Num_g g := by
      intro g
      apply hInj_ι₂
      rw [map_mul, h_homSum_K' (D_g g) (Q_g g) (le_max_right _ _),
        h_homSum_K' (D_g g) (P_g g) (le_max_left _ _), ← mul_assoc, hPQ_ι₂ g]
    have hFinSum : ∀ w : B, ∃ (n : ℕ) (f : Fin n → A₀ × K'),
        w = ∑ i : Fin n, (f i).1 ⊗ₜ[k] (f i).2 := by
      intro w
      induction w using TensorProduct.induction_on with
      | zero => exact ⟨0, Fin.elim0, by simp⟩
      | tmul a c => exact ⟨1, fun _ => (a, c), by simp⟩
      | add w₁ w₂ ih₁ ih₂ =>
        rcases ih₁ with ⟨n₁, f₁, rfl⟩
        rcases ih₂ with ⟨n₂, f₂, rfl⟩
        exact ⟨n₁ + n₂, Fin.addCases f₁ f₂, by simp [Fin.sum_univ_add]⟩
    obtain ⟨n_F, f_F, hF_eq⟩ := hFinSum F
    obtain ⟨n_H, f_H, hH_eq⟩ := hFinSum H₂
    let S_fin : Finset K' :=
      (Finset.univ.image fun i : Fin n_F => (f_F i).2) ∪
      (Finset.univ.image fun i : Fin n_H => (f_H i).2) ∪
      Finset.univ.biUnion (fun g : ↥G_A =>
        (Finset.range (D_g g + 1)).image (P_g g).coeff ∪
        (Finset.range (D_g g + 1)).image (Q_g g).coeff)
    let R₀ : Subalgebra k K' := Algebra.adjoin k (↑S_fin : Set K')
    have : IsDomain ↥R₀ := inferInstance
    have hFT_R₀ : Algebra.FiniteType k ↥R₀ := by
      let S_R₀ : Finset ↥R₀ :=
        S_fin.attach.map
          ⟨fun x => ⟨x.1, Algebra.subset_adjoin x.2⟩,
            fun _ _ h => Subtype.ext (Subtype.mk.inj h)⟩
      refine ⟨⟨S_R₀, ?_⟩⟩
      apply Subalgebra.map_injective (f := R₀.val) Subtype.val_injective
      rw [AlgHom.map_adjoin, Algebra.map_top, Subalgebra.range_val]
      have h_im : R₀.val '' (↑S_R₀ : Set ↥R₀) = (↑S_fin : Set K') := by
        ext c
        simp only [S_R₀, Finset.coe_map, Finset.coe_attach, Set.image_univ, Set.mem_image,
          Set.mem_range, Subalgebra.coe_val]
        constructor
        · rintro ⟨_, ⟨⟨x, hx⟩, rfl⟩, rfl⟩; exact hx
        · intro hc; exact ⟨⟨c, Algebra.subset_adjoin hc⟩, ⟨⟨c, hc⟩, rfl⟩, rfl⟩
      rw [h_im]
    let _ : Algebra.FiniteType k ↥R₀ := hFT_R₀
    have hfF_mem : ∀ i : Fin n_F, (f_F i).2 ∈ R₀ := fun i =>
      Algebra.subset_adjoin (Finset.mem_coe.mpr (Finset.mem_union_left _
        (Finset.mem_union_left _ (Finset.mem_image_of_mem _ (Finset.mem_univ i)))))
    have hfH_mem : ∀ i : Fin n_H, (f_H i).2 ∈ R₀ := fun i =>
      Algebra.subset_adjoin (Finset.mem_coe.mpr (Finset.mem_union_left _
        (Finset.mem_union_right _ (Finset.mem_image_of_mem _ (Finset.mem_univ i)))))
    have hp_mem : ∀ (g : ↥G_A) (j : ℕ), j ∈ Finset.range (D_g g + 1) → (P_g g).coeff j ∈ R₀ :=
      fun g j hj => Algebra.subset_adjoin (Finset.mem_coe.mpr (Finset.mem_union_right _
        (Finset.mem_biUnion.mpr ⟨g, Finset.mem_univ g,
          Finset.mem_union_left _ (Finset.mem_image_of_mem _ hj)⟩)))
    have hq_mem : ∀ (g : ↥G_A) (j : ℕ), j ∈ Finset.range (D_g g + 1) → (Q_g g).coeff j ∈ R₀ :=
      fun g j hj => Algebra.subset_adjoin (Finset.mem_coe.mpr (Finset.mem_union_right _
        (Finset.mem_biUnion.mpr ⟨g, Finset.mem_univ g,
          Finset.mem_union_right _ (Finset.mem_image_of_mem _ hj)⟩)))
    let F' : TensorProduct k A₀ ↥R₀ :=
      ∑ i : Fin n_F, (f_F i).1 ⊗ₜ[k] (⟨(f_F i).2, hfF_mem i⟩ : ↥R₀)
    let H₂' : TensorProduct k A₀ ↥R₀ :=
      ∑ i : Fin n_H, (f_H i).1 ⊗ₜ[k] (⟨(f_H i).2, hfH_mem i⟩ : ↥R₀)
    let p'_g : ↥G_A → ℕ → ↥R₀ := fun g j =>
      if hj : j ∈ Finset.range (D_g g + 1) then ⟨(P_g g).coeff j, hp_mem g j hj⟩ else 0
    let q'_g : ↥G_A → ℕ → ↥R₀ := fun g j =>
      if hj : j ∈ Finset.range (D_g g + 1) then ⟨(Q_g g).coeff j, hq_mem g j hj⟩ else 0
    let Num'_g : ↥G_A → TensorProduct k A₀ ↥R₀ := fun g => homSum (D_g g) F' H₂' (p'_g g)
    let Den'_g : ↥G_A → TensorProduct k A₀ ↥R₀ := fun g => homSum (D_g g) F' H₂' (q'_g g)
    let H_prod' : TensorProduct k A₀ ↥R₀ := H₂' * ∏ g : ↥G_A, Den'_g g
    let ι_R : TensorProduct k A₀ ↥R₀ →ₐ[k] B :=
      Algebra.TensorProduct.map (AlgHom.id k A₀) R₀.val
    have hιR_F : ι_R F' = F := by
      dsimp only [F', ι_R]
      rw [map_sum, hF_eq]
      rfl
    have hιR_H : ι_R H₂' = H₂ := by
      dsimp only [H₂', ι_R]
      rw [map_sum, hH_eq]
      rfl
    have hιR_Num : ∀ g : ↥G_A, ι_R (Num'_g g) = Num_g g := by
      intro g
      dsimp only [Num'_g, Num_g, homSum]
      rw [map_sum]
      refine Finset.sum_congr rfl fun j hj => ?_
      rw [map_mul, map_mul, map_pow, map_pow, hιR_F, hιR_H]
      have hp_j : (p'_g g j : K') = (P_g g).coeff j := by dsimp only [p'_g]; rw [dif_pos hj]
      have hι_c : ι_R (1 ⊗ₜ[k] p'_g g j) = 1 ⊗ₜ[k] (P_g g).coeff j := by
        change 1 ⊗ₜ[k] (p'_g g j : K') = _; rw [hp_j]
      rw [hι_c]
    have hιR_Den : ∀ g : ↥G_A, ι_R (Den'_g g) = Den_g g := by
      intro g
      dsimp only [Den'_g, Den_g, homSum]
      rw [map_sum]
      refine Finset.sum_congr rfl fun j hj => ?_
      rw [map_mul, map_mul, map_pow, map_pow, hιR_F, hιR_H]
      have hq_j : (q'_g g j : K') = (Q_g g).coeff j := by dsimp only [q'_g]; rw [dif_pos hj]
      have hι_c : ι_R (1 ⊗ₜ[k] q'_g g j) = 1 ⊗ₜ[k] (Q_g g).coeff j := by
        change 1 ⊗ₜ[k] (q'_g g j : K') = _; rw [hq_j]
      rw [hι_c]
    let B_A := Module.Basis.ofVectorSpace k A₀
    let e_comm_R := Algebra.TensorProduct.comm k A₀ ↥R₀
    let e_comm_K := Algebra.TensorProduct.comm k A₀ K'
    let B_R := Algebra.TensorProduct.basis ↥R₀ B_A
    let B_K := Algebra.TensorProduct.basis K' B_A
    have hRepr_ιR : ∀ (z : TensorProduct k A₀ ↥R₀) (α : Module.Basis.ofVectorSpaceIndex k A₀),
        B_K.repr (e_comm_K (ι_R z)) α = ((B_R.repr (e_comm_R z) α : ↥R₀) : K') := by
      intro z α
      induction z using TensorProduct.induction_on with
      | zero => simp
      | tmul a r =>
        change B_K.repr ((r : K') ⊗ₜ[k] a) α = ((B_R.repr (r ⊗ₜ[k] a) α : ↥R₀) : K')
        rw [Algebra.TensorProduct.basis_repr_tmul, Algebra.TensorProduct.basis_repr_tmul]
        simp [Finsupp.smul_apply, Finsupp.mapRange_apply, smul_eq_mul]
      | add z₁ z₂ ih₁ ih₂ =>
        rw [map_add, map_add, map_add, map_add, map_add, Finsupp.add_apply, Finsupp.add_apply,
          Subalgebra.coe_add, ih₁, ih₂]
    have hInj_ιR : Function.Injective ι_R := by
      rw [RingHom.injective_iff_ker_eq_bot, eq_bot_iff]
      intro z hz
      rw [RingHom.mem_ker] at hz
      rw [Ideal.mem_bot]
      apply e_comm_R.injective
      apply B_R.repr.injective
      ext α
      simp only [map_zero, Finsupp.zero_apply]
      have := hRepr_ιR z α
      rw [hz, map_zero, map_zero, Finsupp.zero_apply] at this
      exact this.symm
    have hRel_R₀ : ∀ g : ↥G_A, (g.1 ⊗ₜ[k] (1 : ↥R₀)) * Den'_g g = Num'_g g := by
      intro g
      apply hInj_ιR
      rw [map_mul, hιR_Den, hιR_Num]
      exact hRel_B g
    have hHprod_ne : H_prod' ≠ 0 := by
      intro h0
      have h_im : ι_R H_prod' = H₂ * ∏ g : ↥G_A, Den_g g := by
        dsimp only [H_prod']
        rw [map_mul, map_prod, hιR_H]
        congr 1
        exact Finset.prod_congr rfl fun g _ => hιR_Den g
      have h_ne : H₂ * ∏ g : ↥G_A, Den_g g ≠ 0 :=
        mul_ne_zero hH₂_ne (Finset.prod_ne_zero_iff.mpr fun g _ => hDen_ne g)
      rw [h0, map_zero] at h_im
      exact h_ne h_im.symm
    have hRepr_ne : B_R.repr (e_comm_R H_prod') ≠ 0 := fun h0 =>
      hHprod_ne (e_comm_R.injective (B_R.repr.injective (by simpa using h0)))
    obtain ⟨α₀, hα₀⟩ : ∃ α₀, B_R.repr (e_comm_R H_prod') α₀ ≠ 0 := by
      by_contra! hall
      exact hRepr_ne (Finsupp.ext hall)
    let r₀ : ↥R₀ := B_R.repr (e_comm_R H_prod') α₀
    have hr₀_ne : r₀ ≠ 0 := hα₀
    let L_r₀ := Localization.Away r₀
    have hpow_r₀_nzd : Submonoid.powers r₀ ≤ nonZeroDivisors ↥R₀ := by
      rintro _ ⟨n, rfl⟩
      exact mem_nonZeroDivisors_of_ne_zero (pow_ne_zero n hr₀_ne)
    have hInj_Lr₀ : Function.Injective (algebraMap ↥R₀ L_r₀) :=
      IsLocalization.injective L_r₀ hpow_r₀_nzd
    have : Nontrivial L_r₀ :=
      ⟨⟨0, 1, fun h01 => zero_ne_one (hInj_Lr₀ (by simpa using h01))⟩⟩
    have : Algebra.FiniteType k L_r₀ :=
      Algebra.FiniteType.trans (R := k) (S := ↥R₀) (A := L_r₀) inferInstance inferInstance
    obtain ⟨N_mv, π_mv, hSurj_π⟩ :=
      (Algebra.FiniteType.iff_quotient_mvPolynomial'' (R := k) (S := L_r₀)).mp inferInstance
    obtain ⟨𝔪, h𝔪_max⟩ := Ideal.exists_maximal L_r₀
    have h𝔪_mv_max : (Ideal.comap π_mv.toRingHom 𝔪).IsMaximal :=
      Ideal.comap_isMaximal_of_surjective π_mv.toRingHom hSurj_π
    obtain ⟨x₀_pt, hx₀_pt⟩ :=
      (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton).mp h𝔪_mv_max
    have hker_vanish : ∀ P : MvPolynomial (Fin N_mv) k,
        π_mv P = 0 → MvPolynomial.aeval x₀_pt P = 0 := by
      intro P hP
      have hmem : P ∈ Ideal.comap π_mv.toRingHom 𝔪 := by
        change π_mv P ∈ 𝔪; rw [hP]; exact 𝔪.zero_mem
      rw [hx₀_pt, MvPolynomial.mem_vanishingIdeal_singleton_iff] at hmem
      exact hmem
    let lift_fn : L_r₀ → MvPolynomial (Fin N_mv) k := Function.surjInv hSurj_π
    have hπ_lift : ∀ y : L_r₀, π_mv (lift_fn y) = y := Function.surjInv_eq hSurj_π
    have haeval_eq : ∀ P : MvPolynomial (Fin N_mv) k,
        MvPolynomial.aeval x₀_pt (lift_fn (π_mv P)) = MvPolynomial.aeval x₀_pt P := by
      intro P
      rw [← sub_eq_zero, ← map_sub]
      apply hker_vanish
      rw [map_sub, hπ_lift, sub_self]
    let χ_loc : L_r₀ →ₐ[k] k :=
      { toFun := fun y => MvPolynomial.aeval x₀_pt (lift_fn y)
        map_one' := by rw [← map_one π_mv, haeval_eq, map_one]
        map_mul' := fun y₁ y₂ => by
          conv_lhs => rw [← hπ_lift y₁, ← hπ_lift y₂, ← map_mul, haeval_eq, map_mul]
        map_zero' := by rw [← map_zero π_mv, haeval_eq, map_zero]
        map_add' := fun y₁ y₂ => by
          conv_lhs => rw [← hπ_lift y₁, ← hπ_lift y₂, ← map_add, haeval_eq, map_add]
        commutes' := fun c => by
          have hc_eq : algebraMap k L_r₀ c = π_mv (MvPolynomial.C c) := by
            rw [← π_mv.commutes c, MvPolynomial.algebraMap_eq]
          rw [hc_eq, haeval_eq, MvPolynomial.aeval_C] }
    let ev₀ : ↥R₀ →ₐ[k] k := χ_loc.comp (IsScalarTower.toAlgHom k ↥R₀ L_r₀)
    have hev₀_r₀ : ev₀ r₀ ≠ 0 := by
      have hu : IsUnit (algebraMap ↥R₀ L_r₀ r₀) :=
        IsLocalization.map_units L_r₀ (⟨r₀, 1, pow_one r₀⟩ : Submonoid.powers r₀)
      exact (hu.map χ_loc.toRingHom).ne_zero
    let Φ₀ : TensorProduct k A₀ ↥R₀ →ₐ[k] A₀ :=
      (Algebra.TensorProduct.rid k k A₀).toAlgHom.comp
        (Algebra.TensorProduct.map (AlgHom.id k A₀) ev₀)
    have hΦ₀_tmul : ∀ (a : A₀) (r : ↥R₀), Φ₀ (a ⊗ₜ[k] r) = ev₀ r • a := by
      intro a r
      simp [Φ₀, Algebra.TensorProduct.rid_tmul]
    have hRepr_Φ₀ : ∀ (z : TensorProduct k A₀ ↥R₀) (α : Module.Basis.ofVectorSpaceIndex k A₀),
        B_A.repr (Φ₀ z) α = ev₀ (B_R.repr (e_comm_R z) α) := by
      intro z α
      induction z using TensorProduct.induction_on with
      | zero => simp
      | tmul a r =>
        rw [hΦ₀_tmul, map_smul, Finsupp.smul_apply, smul_eq_mul]
        change ev₀ r * B_A.repr a α = ev₀ (B_R.repr (r ⊗ₜ[k] a) α)
        rw [Algebra.TensorProduct.basis_repr_tmul]
        simp [Finsupp.smul_apply, Finsupp.mapRange_apply, smul_eq_mul]
      | add z₁ z₂ ih₁ ih₂ =>
        rw [map_add, map_add, map_add, map_add, Finsupp.add_apply, Finsupp.add_apply,
          map_add, ih₁, ih₂]
    have hΦ₀_Hprod_ne : Φ₀ H_prod' ≠ 0 := by
      intro h0
      have := hRepr_Φ₀ H_prod' α₀
      rw [h0, map_zero, Finsupp.zero_apply] at this
      exact hev₀_r₀ this.symm
    have hΦ₀_prod_eq : Φ₀ H_prod' = Φ₀ H₂' * ∏ g : ↥G_A, Φ₀ (Den'_g g) := by
      dsimp only [H_prod']
      rw [map_mul, map_prod]
    rw [hΦ₀_prod_eq] at hΦ₀_Hprod_ne
    let h2_bar : A₀ := Φ₀ H₂'
    let F_bar : A₀ := Φ₀ F'
    have hh2_bar_ne : h2_bar ≠ 0 := left_ne_zero_of_mul hΦ₀_Hprod_ne
    have hD_bar_ne : ∀ g : ↥G_A, Φ₀ (Den'_g g) ≠ 0 := fun g =>
      Finset.prod_ne_zero_iff.mp (right_ne_zero_of_mul hΦ₀_Hprod_ne) g (Finset.mem_univ g)
    have hRel_A₀ : ∀ g : ↥G_A, g.1 * Φ₀ (Den'_g g) = Φ₀ (Num'_g g) := by
      intro g
      have := congrArg Φ₀ (hRel_R₀ g)
      rwa [map_mul, hΦ₀_tmul, map_one, one_smul] at this
    let F_X := FractionRing A₀
    let ι_A := algebraMap A₀ F_X
    have hInj_ιA : Function.Injective ι_A := IsFractionRing.injective A₀ F_X
    have hιh₂_ne : ι_A h2_bar ≠ 0 := fun h0 => hh2_bar_ne (hInj_ιA (h0.trans (map_zero _).symm))
    let t : F_X := ι_A F_bar * (ι_A h2_bar)⁻¹
    have ht_mul : t * ι_A h2_bar = ι_A F_bar := by
      dsimp only [t]; rw [mul_assoc, inv_mul_cancel₀ hιh₂_ne, mul_one]
    have h_homSum_FX : ∀ (D : ℕ) (c' : ℕ → ↥R₀),
        ι_A (Φ₀ (homSum D F' H₂' c')) =
          (∑ j ∈ Finset.range (D + 1), algebraMap k F_X (ev₀ (c' j)) * t ^ j) * ι_A h2_bar ^ D := by
      intro D c'
      dsimp only [homSum]
      rw [map_sum, map_sum, Finset.sum_mul]
      refine Finset.sum_congr rfl fun j hj_mem => ?_
      have hj : j ≤ D := Nat.lt_succ_iff.mp (Finset.mem_range.mp hj_mem)
      rw [map_mul Φ₀, map_mul Φ₀, map_pow Φ₀, map_pow Φ₀, hΦ₀_tmul, Algebra.smul_def, mul_one,
        map_mul ι_A, map_mul ι_A, map_pow ι_A, map_pow ι_A, ← IsScalarTower.algebraMap_apply k A₀ F_X]
      change algebraMap k F_X (ev₀ (c' j)) * ι_A F_bar ^ j * ι_A h2_bar ^ (D - j) =
        algebraMap k F_X (ev₀ (c' j)) * t ^ j * ι_A h2_bar ^ D
      rw [← ht_mul, mul_pow]
      calc algebraMap k F_X (ev₀ (c' j)) * (t ^ j * ι_A h2_bar ^ j) * ι_A h2_bar ^ (D - j)
          = algebraMap k F_X (ev₀ (c' j)) * t ^ j * (ι_A h2_bar ^ j * ι_A h2_bar ^ (D - j)) := by ring
        _ = algebraMap k F_X (ev₀ (c' j)) * t ^ j * ι_A h2_bar ^ D := by
            rw [← pow_add, Nat.add_sub_of_le hj]
    let K_t : IntermediateField k F_X := IntermediateField.adjoin k ({t} : Set F_X)
    have ht_Kt : t ∈ K_t := IntermediateField.mem_adjoin_simple_self k t
    have hsum_Kt : ∀ (D : ℕ) (c' : ℕ → ↥R₀),
        (∑ j ∈ Finset.range (D + 1), algebraMap k F_X (ev₀ (c' j)) * t ^ j) ∈ K_t := fun D c' =>
      K_t.sum_mem fun j _ => K_t.mul_mem (K_t.algebraMap_mem _) (K_t.pow_mem ht_Kt j)
    have hg_Kt : ∀ g : ↥G_A, ι_A g.1 ∈ K_t := by
      intro g
      let num_v := ∑ j ∈ Finset.range (D_g g + 1), algebraMap k F_X (ev₀ (p'_g g j)) * t ^ j
      let den_v := ∑ j ∈ Finset.range (D_g g + 1), algebraMap k F_X (ev₀ (q'_g g j)) * t ^ j
      have hnum_eq : ι_A (Φ₀ (Num'_g g)) = num_v * ι_A h2_bar ^ D_g g := h_homSum_FX _ _
      have hden_eq : ι_A (Φ₀ (Den'_g g)) = den_v * ι_A h2_bar ^ D_g g := h_homSum_FX _ _
      have hιD_ne : ι_A (Φ₀ (Den'_g g)) ≠ 0 :=
        fun h0 => hD_bar_ne g (hInj_ιA (h0.trans (map_zero _).symm))
      have hden_ne : den_v ≠ 0 := fun h0 => hιD_ne (by rw [hden_eq, h0, zero_mul])
      have hprod_eq : ι_A g.1 * den_v * ι_A h2_bar ^ D_g g = num_v * ι_A h2_bar ^ D_g g := by
        calc ι_A g.1 * den_v * ι_A h2_bar ^ D_g g
            = ι_A g.1 * (den_v * ι_A h2_bar ^ D_g g) := by ring
          _ = ι_A (g.1 * Φ₀ (Den'_g g)) := by rw [← hden_eq, map_mul]
          _ = num_v * ι_A h2_bar ^ D_g g := by rw [hRel_A₀ g, hnum_eq]
      have hmul_den : ι_A g.1 * den_v = num_v :=
        mul_right_cancel₀ (pow_ne_zero (D_g g) hιh₂_ne) hprod_eq
      have hg_eq : ι_A g.1 = num_v * den_v⁻¹ := by
        rw [← hmul_den, mul_assoc, mul_inv_cancel₀ hden_ne, mul_one]
      rw [hg_eq]
      exact K_t.mul_mem (hsum_Kt _ _) (K_t.inv_mem (hsum_Kt _ _))
    let A_sub : Subalgebra k A₀ :=
      { carrier := {a : A₀ | ι_A a ∈ K_t}
        mul_mem' := fun ha hb => by change ι_A _ ∈ K_t; rw [map_mul]; exact K_t.mul_mem ha hb
        one_mem' := by change ι_A 1 ∈ K_t; rw [map_one]; exact K_t.one_mem
        add_mem' := fun ha hb => by change ι_A _ ∈ K_t; rw [map_add]; exact K_t.add_mem ha hb
        zero_mem' := by change ι_A 0 ∈ K_t; rw [map_zero]; exact K_t.zero_mem
        algebraMap_mem' := fun c => by
          change ι_A (algebraMap k A₀ c) ∈ K_t
          rw [← IsScalarTower.algebraMap_apply k A₀ F_X]
          exact K_t.algebraMap_mem c }
    have hA_top : A_sub = ⊤ := eq_top_iff.mpr (hG_A ▸ Algebra.adjoin_le_iff.mpr
      fun a ha => hg_Kt ⟨a, ha⟩)
    have hKt_top : K_t = ⊤ := by
      rw [eq_top_iff]
      intro z _
      obtain ⟨⟨a, s_b⟩, hzb⟩ := IsLocalization.surj (nonZeroDivisors A₀) z
      rcases s_b with ⟨b, hb⟩
      have hb_ne : b ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hb
      have hιb_ne : ι_A b ≠ 0 := fun h0 => hb_ne (hInj_ιA (h0.trans (map_zero _).symm))
      have hz_eq : z = ι_A a * (ι_A b)⁻¹ := by
        have hzb' : z * ι_A b = ι_A a := hzb
        rw [← hzb', mul_assoc, mul_inv_cancel₀ hιb_ne, mul_one]
      rw [hz_eq]
      exact K_t.mul_mem (hA_top.symm ▸ Algebra.mem_top : a ∈ A_sub)
        (K_t.inv_mem (hA_top.symm ▸ Algebra.mem_top : b ∈ A_sub))
    have ht_tr : Transcendental k t := by
      intro ht_alg
      have ht_int : _root_.IsIntegral k t := isAlgebraic_iff_isIntegral.mp ht_alg
      have : FiniteDimensional k ↥K_t := IntermediateField.adjoin.finiteDimensional ht_int
      let e_Kt : ↥K_t ≃ₐ[k] F_X :=
        (IntermediateField.equivOfEq hKt_top).trans IntermediateField.topEquiv
      have : FiniteDimensional k F_X := Module.Finite.equiv e_Kt.toLinearEquiv
      have : Algebra.IsIntegral k F_X := Algebra.IsIntegral.of_finite k F_X
      have hSurj_kFX : Function.Surjective (algebraMap k F_X) :=
        (IsAlgClosed.algebraMap_bijective_of_isIntegral (k := k) (K := F_X)).2
      obtain ⟨a₀, ha₀⟩ := hNonConst
      obtain ⟨c, hc⟩ := hSurj_kFX (ι_A a₀)
      rw [IsScalarTower.algebraMap_apply k A₀ F_X] at hc
      exact ha₀ ⟨c, hInj_ιA hc⟩
    let S_mv := MvPolynomial (Fin 1) k
    let ev_poly : Polynomial k →ₐ[k] F_X := Polynomial.aeval t
    have hInj_poly : Function.Injective ev_poly := transcendental_iff_injective.mp ht_tr
    let u_eqv := MvPolynomial.uniqueAlgEquiv k (Fin 1)
    let e_mv : S_mv →ₐ[k] F_X := ev_poly.comp u_eqv.toAlgHom
    have hInj_emv : Function.Injective e_mv := hInj_poly.comp u_eqv.injective
    let _ : Algebra S_mv F_X := e_mv.toRingHom.toAlgebra
    have : IsScalarTower k S_mv F_X :=
      IsScalarTower.of_algebraMap_eq fun c => (e_mv.commutes c).symm
    have hFrac_Smv : @IsFractionRing S_mv _ F_X _ e_mv.toRingHom.toAlgebra := by
      refine { map_units := ?_, surj := ?_, exists_of_eq := ?_ }
      · rintro ⟨g, hg⟩
        have hg0 : g ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hg
        exact IsUnit.mk0 (e_mv g) (fun h0 => hg0 (hInj_emv (h0.trans (map_zero _).symm)))
      · intro z
        let Sub_poly : IntermediateField k F_X :=
          { carrier := {w : F_X | ∃ f g : Polynomial k, g ≠ 0 ∧ ev_poly g * w = ev_poly f}
            mul_mem' := by
              rintro w₁ w₂ ⟨f₁, g₁, hg₁, h₁⟩ ⟨f₂, g₂, hg₂, h₂⟩
              refine ⟨f₁ * f₂, g₁ * g₂, mul_ne_zero hg₁ hg₂, ?_⟩
              rw [map_mul, map_mul]
              calc (ev_poly g₁ * ev_poly g₂) * (w₁ * w₂)
                  = (ev_poly g₁ * w₁) * (ev_poly g₂ * w₂) := by ring
                _ = ev_poly f₁ * ev_poly f₂ := by rw [h₁, h₂]
            one_mem' := ⟨1, 1, one_ne_zero, by simp⟩
            add_mem' := by
              rintro w₁ w₂ ⟨f₁, g₁, hg₁, h₁⟩ ⟨f₂, g₂, hg₂, h₂⟩
              refine ⟨f₁ * g₂ + g₁ * f₂, g₁ * g₂, mul_ne_zero hg₁ hg₂, ?_⟩
              rw [map_add, map_mul, map_mul, map_mul]
              calc (ev_poly g₁ * ev_poly g₂) * (w₁ + w₂)
                  = (ev_poly g₁ * w₁) * ev_poly g₂ + ev_poly g₁ * (ev_poly g₂ * w₂) := by ring
                _ = ev_poly f₁ * ev_poly g₂ + ev_poly g₁ * ev_poly f₂ := by rw [h₁, h₂]
            zero_mem' := ⟨0, 1, one_ne_zero, by simp⟩
            algebraMap_mem' := fun c => ⟨Polynomial.C c, 1, one_ne_zero, by simp [ev_poly]⟩
            inv_mem' := by
              rintro w ⟨f, g, hg, h⟩
              by_cases hw : w = 0
              · subst hw; exact ⟨0, 1, one_ne_zero, by simp⟩
              · have he_g : ev_poly g ≠ 0 :=
                  fun h0 => hg (hInj_poly (h0.trans (map_zero _).symm))
                have hf : f ≠ 0 :=
                  fun hf0 => mul_ne_zero he_g hw (by rw [hf0, map_zero] at h; exact h)
                refine ⟨g, f, hf, ?_⟩
                calc ev_poly f * w⁻¹ = (ev_poly g * w) * w⁻¹ := by rw [h]
                  _ = ev_poly g := by rw [mul_assoc, mul_inv_cancel₀ hw, mul_one] }
        have ht_in : t ∈ Sub_poly :=
          ⟨Polynomial.X, 1, one_ne_zero, by simp [ev_poly]⟩
        have hSub_top : Sub_poly = ⊤ := eq_top_iff.mpr
          (hKt_top ▸ IntermediateField.adjoin_le_iff.mpr (Set.singleton_subset_iff.mpr ht_in))
        obtain ⟨f, g, hg, hfg⟩ : z ∈ Sub_poly := hSub_top.symm ▸ IntermediateField.mem_top
        have hg_mv : u_eqv.symm g ≠ 0 :=
          fun h0 => hg (u_eqv.symm.injective (h0.trans (map_zero _).symm))
        refine ⟨(u_eqv.symm f, ⟨u_eqv.symm g, mem_nonZeroDivisors_of_ne_zero hg_mv⟩), ?_⟩
        change z * ev_poly (u_eqv (u_eqv.symm g)) = ev_poly (u_eqv (u_eqv.symm f))
        rw [u_eqv.apply_symm_apply, u_eqv.apply_symm_apply, mul_comm, hfg]
      · intro f₁ f₂ h12
        exact ⟨1, by simp [hInj_emv h12]⟩
    let _ : IsLocalization (nonZeroDivisors S_mv) F_X := hFrac_Smv
    have : Algebra.IsAlgebraic S_mv F_X :=
      IsLocalization.isAlgebraic (R := S_mv) (M := nonZeroDivisors S_mv) F_X
    have : FaithfulSMul k S_mv :=
      (faithfulSMul_iff_algebraMap_injective k S_mv).mpr (RingHom.injective _)
    have : FaithfulSMul S_mv F_X :=
      (faithfulSMul_iff_algebraMap_injective S_mv F_X).mpr hInj_emv
    have htr_sum : Algebra.trdeg k S_mv + Algebra.trdeg S_mv F_X = Algebra.trdeg k F_X :=
      trdeg_add_eq k S_mv
    have htr_0 : Algebra.trdeg S_mv F_X = 0 := trdeg_eq_zero
    have htr_1 : Algebra.trdeg k S_mv = 1 := by
      rw [MvPolynomial.trdeg_of_isDomain]
      simp
    have htr_FX : Algebra.trdeg k F_X = 1 := by
      rw [← htr_sum, htr_1, htr_0, add_zero]
    exact ⟨t, ht_tr, hKt_top, htr_FX⟩

  
  obtain ⟨t, ht_tr, ht_gen, hTrdeg⟩ := hRatParam
  let L := FractionRing A₀
  let P_k := (weilProjectiveSpaceOver k 1).left
  let π_k := (weilProjectiveSpaceOver k 1).hom
  have : AlgebraicGeometry.IsIntegral X := hIntX
  have : AlgebraicGeometry.IsProper p_X := hPropX
  have : AlgebraicGeometry.IsIntegral P_k := hIntPk
  have : AlgebraicGeometry.IsProper π_k := hPropPk
  obtain ⟨η_P, hηP_comm, hFuncP⟩ := hFuncPk_mk L t ht_tr ht_gen
  let P_XY := CategoryTheory.Limits.pullback p_X π_k
  let η_prod : AlgebraicGeometry.Spec (CommRingCat.of L) ⟶ P_XY :=
    CategoryTheory.Limits.pullback.lift η_X η_P (hηX_comm.trans hηP_comm.symm)
  let Γ : AlgebraicGeometry.Scheme.{u} := η_prod.image
  let ι_Γ : Γ ⟶ P_XY := η_prod.imageι
  let η_Γ : AlgebraicGeometry.Spec (CommRingCat.of L) ⟶ Γ := η_prod.toImage
  let p₁ : Γ ⟶ X := ι_Γ ≫ CategoryTheory.Limits.pullback.fst p_X π_k
  let p₂ : Γ ⟶ P_k := ι_Γ ≫ CategoryTheory.Limits.pullback.snd p_X π_k
  have hDomΓ : AlgebraicGeometry.IsDominant η_Γ := inferInstance
  have hProp_p₁ : AlgebraicGeometry.IsProper p₁ := inferInstance
  have hProp_p₂ : AlgebraicGeometry.IsProper p₂ := inferInstance
  have hp₁₂_comm : p₁ ≫ p_X = p₂ ≫ π_k := by
    dsimp only [p₁, p₂]
    rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
      CategoryTheory.Limits.pullback.condition]
  have hη_p₁ : η_Γ ≫ p₁ = η_X := by
    dsimp only [η_Γ, p₁, ι_Γ, η_prod]
    rw [← CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.Hom.toImage_imageι,
      CategoryTheory.Limits.pullback.lift_fst]
  have hη_p₂ : η_Γ ≫ p₂ = η_P := by
    dsimp only [η_Γ, p₂, ι_Γ, η_prod]
    rw [← CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.Hom.toImage_imageι,
      CategoryTheory.Limits.pullback.lift_snd]
  let pt_L : PrimeSpectrum L := ⟨⊥, inferInstance⟩
  have hSubL : Subsingleton ↥(AlgebraicGeometry.Spec (CommRingCat.of L)) := by
    change Subsingleton (PrimeSpectrum L); infer_instance
  have hIntΓ : AlgebraicGeometry.IsIntegral Γ := by
    have hIrredSpecL : IrreducibleSpace ↥(AlgebraicGeometry.Spec (CommRingCat.of L)) :=
      inferInstance
    have hPreΓ : IsPreirreducible (Set.univ : Set ↥Γ) := by
      rw [← hDomΓ.denseRange.closure_eq, ← Set.image_univ]
      exact (hIrredSpecL.isPreirreducible_univ.image η_Γ.base
        η_Γ.continuous.continuousOn).closure
    have : IrreducibleSpace ↥Γ :=
      { isPreirreducible_univ := hPreΓ, toNonempty := ⟨η_Γ.base pt_L⟩ }
    have : ∀ w : ↥Γ, _root_.IsReduced ↑(Γ.presheaf.stalk w) := by
      intro w
      obtain ⟨U, hU, hwU, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := ι_Γ.base w) (U := ⊤) trivial
      let V_op : Γ.Opens := (TopologicalSpace.Opens.map ι_Γ.base).obj U
      have hV : AlgebraicGeometry.IsAffineOpen V_op := hU.preimage ι_Γ
      have hwV : w ∈ V_op := hwU
      let e_sub := (η_prod.ker.subschemeObjIso ⟨U, hU⟩).commRingCatIsoToRingEquiv
      let lift_hom :
          (↑(P_XY.presheaf.obj (Opposite.op U)) ⧸ η_prod.ker.ideal ⟨U, hU⟩) →+*
            ↑((AlgebraicGeometry.Spec (CommRingCat.of L)).presheaf.obj
              (Opposite.op ((TopologicalSpace.Opens.map η_prod.base).obj U))) :=
        Ideal.Quotient.lift (η_prod.ker.ideal ⟨U, hU⟩) (η_prod.app U).hom (fun r hr => by
          rw [AlgebraicGeometry.Scheme.Hom.ker_apply η_prod ⟨U, hU⟩] at hr
          exact hr)
      have hInj_lift : Function.Injective lift_hom := by
        intro q₁ q₂ hq
        induction q₁ using Quotient.inductionOn with | h r₁ =>
        induction q₂ using Quotient.inductionOn with | h r₂ =>
        apply Ideal.Quotient.eq.mpr
        rw [AlgebraicGeometry.Scheme.Hom.ker_apply η_prod ⟨U, hU⟩]
        change (η_prod.app U).hom (r₁ - r₂) = 0
        rw [map_sub, sub_eq_zero]
        exact hq
      have : _root_.IsReduced
          ↑((AlgebraicGeometry.Spec (CommRingCat.of L)).presheaf.obj
            (Opposite.op ((TopologicalSpace.Opens.map η_prod.base).obj U))) :=
        AlgebraicGeometry.IsReduced.component_reduced _
      have : _root_.IsReduced ↑(Γ.presheaf.obj (Opposite.op V_op)) :=
        isReduced_of_injective (lift_hom.comp e_sub.toRingHom) (hInj_lift.comp e_sub.injective)
      have : AlgebraicGeometry.IsReduced
          (AlgebraicGeometry.Spec (Γ.presheaf.obj (Opposite.op V_op))) :=
        (AlgebraicGeometry.affine_isReduced_iff _).mpr inferInstance
      have : AlgebraicGeometry.IsReduced V_op.toScheme :=
        AlgebraicGeometry.isReduced_of_isOpenImmersion hV.isoSpec.hom
      have : _root_.IsReduced ↑(V_op.toScheme.presheaf.stalk ⟨w, hwV⟩) :=
        AlgebraicGeometry.isReduced_stalk_of_isReduced V_op.toScheme ⟨w, hwV⟩
      exact isReduced_of_injective
        (V_op.stalkIso ⟨w, hwV⟩).symm.commRingCatIsoToRingEquiv.toRingHom
        (V_op.stalkIso ⟨w, hwV⟩).symm.commRingCatIsoToRingEquiv.injective
    have : AlgebraicGeometry.IsReduced Γ := AlgebraicGeometry.isReduced_of_isReduced_stalk Γ
    exact AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced Γ
  have : AlgebraicGeometry.IsIntegral Γ := hIntΓ
  have hηΓ_in_open : ∀ (O : Γ.Opens), Nonempty ↥O → η_Γ.base pt_L ∈ O := by
    intro O ⟨x_O⟩
    obtain ⟨_, hwO, q, rfl⟩ :=
      hDomΓ.denseRange.inter_open_nonempty (O : Set ↥Γ) O.isOpen ⟨x_O.1, x_O.2⟩
    rwa [@Subsingleton.elim _ hSubL q pt_L] at hwO
  have hFuncΓ : IsSchemeFunctionField Γ L η_Γ := by
    intro V hV hVne
    let B_V : Type u := ↑(Γ.presheaf.obj (Opposite.op V))
    have : IsDomain B_V := @AlgebraicGeometry.IsIntegral.component_integral Γ hIntΓ V hVne
    let pt_BV : PrimeSpectrum B_V := ⟨⊥, inferInstance⟩
    have hRange_V : Set.range η_Γ.base ⊆ Set.range hV.fromSpec.base := by
      rw [show Set.range hV.fromSpec.base = (V : Set ↥Γ) from
        congrArg SetLike.coe hV.opensRange_fromSpec]
      rintro _ ⟨q, rfl⟩
      rw [@Subsingleton.elim _ hSubL q pt_L]
      exact hηΓ_in_open V hVne
    let u_V := AlgebraicGeometry.IsOpenImmersion.lift hV.fromSpec η_Γ hRange_V
    have hu_V : u_V ≫ hV.fromSpec = η_Γ :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac hV.fromSpec η_Γ hRange_V
    let φ_V : Γ.presheaf.obj (Opposite.op V) ⟶ CommRingCat.of L :=
      AlgebraicGeometry.Spec.preimage u_V
    have hSpec_φV : AlgebraicGeometry.Spec.map φ_V ≫ hV.fromSpec = η_Γ := by
      rw [AlgebraicGeometry.Spec.map_preimage]; exact hu_V
    let q_V : PrimeSpectrum B_V := (AlgebraicGeometry.Spec.map φ_V).base pt_L
    have hqV_eq : hV.fromSpec.base q_V = η_Γ.base pt_L := by
      change (AlgebraicGeometry.Spec.map φ_V ≫ hV.fromSpec).base pt_L = η_Γ.base pt_L
      rw [hSpec_φV]
    have hInj_φV : Function.Injective φ_V.hom := by
      rw [RingHom.injective_iff_ker_eq_bot, eq_bot_iff]
      intro b hb
      rw [RingHom.mem_ker] at hb
      rw [Ideal.mem_bot]
      by_contra hb_ne
      have hbot_mem : pt_BV ∈ PrimeSpectrum.basicOpen b := by
        rw [PrimeSpectrum.mem_basicOpen]
        change b ∉ (⊥ : Ideal B_V)
        rw [Ideal.mem_bot]; exact hb_ne
      let O_b : Γ.Opens := hV.fromSpec ''ᵁ PrimeSpectrum.basicOpen b
      have hmem_Ob : η_Γ.base pt_L ∈ (O_b : Set ↥Γ) :=
        hηΓ_in_open O_b ⟨⟨hV.fromSpec.base pt_BV, pt_BV, hbot_mem, rfl⟩⟩
      rcases hmem_Ob with ⟨p', hp', hp'_eq⟩
      have hq_eq_p' : q_V = p' :=
        hV.fromSpec.isOpenEmbedding.injective (hqV_eq.trans hp'_eq.symm)
      rw [← hq_eq_p'] at hp'
      have hb_not : b ∉ q_V.asIdeal := hp'
      apply hb_not
      change φ_V.hom b ∈ (⊥ : Ideal L)
      rw [hb]; exact Ideal.zero_mem _
    obtain ⟨U_X, hUX, hx_UX, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
        (x := p₁.base (η_Γ.base pt_L)) (U := ⊤) trivial
    obtain ⟨φ_UX, hFrac_UX, hSpec_UX⟩ := hFuncX U_X hUX ⟨⟨_, hx_UX⟩⟩
    let A_UX : Type u := ↑(X.presheaf.obj (Opposite.op U_X))
    have : IsDomain A_UX :=
      @AlgebraicGeometry.IsIntegral.component_integral X hIntX U_X ⟨⟨_, hx_UX⟩⟩
    have hInj_φUX : Function.Injective φ_UX.hom :=
      fun _ _ h => @IsFractionRing.injective A_UX _ L _ φ_UX.hom.toAlgebra hFrac_UX _ _ h
    have hqV_in : q_V ∈ (TopologicalSpace.Opens.map (hV.fromSpec ≫ p₁).base).obj U_X := by
      change p₁.base (hV.fromSpec.base q_V) ∈ U_X
      rwa [hqV_eq]
    obtain ⟨_, ⟨g, rfl⟩, hqV_g, hg_sub⟩ :=
      (TopologicalSpace.Opens.isBasis_iff_nbhd.mp PrimeSpectrum.isBasis_basic_opens) hqV_in
    have hφg_ne : φ_V.hom g ≠ 0 := by
      intro hg0
      have hg_in : g ∈ q_V.asIdeal := by
        change φ_V.hom g ∈ (⊥ : Ideal L); rw [hg0]; exact Ideal.zero_mem _
      exact hqV_g hg_in
    let loc_g := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B_V (Localization.Away g)))
    have : AlgebraicGeometry.IsOpenImmersion loc_g :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization g
    have hRange_g : Set.range (loc_g ≫ hV.fromSpec ≫ p₁).base ⊆ Set.range hUX.fromSpec.base := by
      rw [show Set.range hUX.fromSpec.base = (U_X : Set ↥X) from
        congrArg SetLike.coe hUX.opensRange_fromSpec]
      rintro _ ⟨p_loc, rfl⟩
      have hp_basic : loc_g.base p_loc ∈ (PrimeSpectrum.basicOpen g : Set (PrimeSpectrum B_V)) := by
        rw [← PrimeSpectrum.localization_away_comap_range (Localization.Away g) g]
        exact ⟨p_loc, rfl⟩
      exact hg_sub hp_basic
    let ψ_sch := AlgebraicGeometry.IsOpenImmersion.lift hUX.fromSpec (loc_g ≫ hV.fromSpec ≫ p₁) hRange_g
    have hψ_fac : ψ_sch ≫ hUX.fromSpec = loc_g ≫ hV.fromSpec ≫ p₁ :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac hUX.fromSpec (loc_g ≫ hV.fromSpec ≫ p₁) hRange_g
    let α_A : A_UX →+* Localization.Away g := (AlgebraicGeometry.Spec.preimage ψ_sch).hom
    have hSpec_α : AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_A) = ψ_sch :=
      AlgebraicGeometry.Spec.map_preimage ψ_sch
    let _ : Algebra B_V L := φ_V.hom.toAlgebra
    let φ_loc : Localization.Away g →+* L :=
      IsLocalization.Away.lift g (IsUnit.mk0 (φ_V.hom g) hφg_ne)
    have hφ_loc_eq : ∀ x : B_V, φ_loc (algebraMap B_V (Localization.Away g) x) = φ_V.hom x :=
      fun x => IsLocalization.Away.lift_eq g (IsUnit.mk0 (φ_V.hom g) hφg_ne) x
    have hφ_loc_comp : φ_loc.comp (algebraMap B_V (Localization.Away g)) = φ_V.hom :=
      RingHom.ext hφ_loc_eq
    have hφ_α_eq : ∀ r : A_UX, φ_loc (α_A r) = φ_UX.hom r := by
      have hSpec_eq :
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_loc.comp α_A)) ≫ hUX.fromSpec =
            AlgebraicGeometry.Spec.map φ_UX ≫ hUX.fromSpec := by
        rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, hSpec_α,
          CategoryTheory.Category.assoc, hψ_fac, ← CategoryTheory.Category.assoc,
          show AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_loc) ≫ loc_g =
            AlgebraicGeometry.Spec.map φ_V by
            dsimp only [loc_g]
            rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hφ_loc_comp]
            rfl,
          ← CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map φ_V),
          hSpec_φV, hη_p₁, hSpec_UX]
      have hMap_eq := (cancel_mono hUX.fromSpec).mp hSpec_eq
      have hHom_eq := CommRingCat.hom_ext_iff.mp (AlgebraicGeometry.Spec.map_injective hMap_eq)
      exact fun r => congrArg (fun f : A_UX →+* L => f r) hHom_eq
    refine ⟨φ_V, ?_, hSpec_φV⟩
    refine { map_units := ?_, surj := ?_, exists_of_eq := ?_ }
    · rintro ⟨s, hs⟩
      have hs0 : s ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hs
      exact IsUnit.mk0 (φ_V.hom s) (fun h0 => hs0 (hInj_φV (h0.trans (map_zero _).symm)))
    · intro z
      let _ : Algebra A_UX L := φ_UX.hom.toAlgebra
      obtain ⟨⟨r₁, s_r⟩, hzr⟩ :=
        @IsLocalization.surj A_UX _ (nonZeroDivisors A_UX) L _ φ_UX.hom.toAlgebra hFrac_UX z
      rcases s_r with ⟨r₂, hr₂⟩
      have hzr' : z * φ_UX.hom r₂ = φ_UX.hom r₁ := hzr
      have hr₂_ne : r₂ ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hr₂
      have hφr₂_ne : φ_UX.hom r₂ ≠ 0 := fun h0 => hr₂_ne (hInj_φUX (h0.trans (map_zero _).symm))
      obtain ⟨⟨b₁, s₁⟩, hm₁⟩ := IsLocalization.surj (Submonoid.powers g) (α_A r₁)
      rcases s₁ with ⟨_, m₁, rfl⟩
      obtain ⟨⟨b₂, s₂⟩, hm₂⟩ := IsLocalization.surj (Submonoid.powers g) (α_A r₂)
      rcases s₂ with ⟨_, m₂, rfl⟩
      have eq₁ : φ_UX.hom r₁ * φ_V.hom (g ^ m₁) = φ_V.hom b₁ := by
        have h := congrArg φ_loc hm₁
        change φ_loc (α_A r₁ * algebraMap B_V (Localization.Away g) (g ^ m₁)) =
          φ_loc (algebraMap B_V (Localization.Away g) b₁) at h
        rwa [map_mul, hφ_α_eq r₁, hφ_loc_eq (g ^ m₁), hφ_loc_eq b₁] at h
      have eq₂ : φ_UX.hom r₂ * φ_V.hom (g ^ m₂) = φ_V.hom b₂ := by
        have h := congrArg φ_loc hm₂
        change φ_loc (α_A r₂ * algebraMap B_V (Localization.Away g) (g ^ m₂)) =
          φ_loc (algebraMap B_V (Localization.Away g) b₂) at h
        rwa [map_mul, hφ_α_eq r₂, hφ_loc_eq (g ^ m₂), hφ_loc_eq b₂] at h
      have hgm₁_ne : φ_V.hom (g ^ m₁) ≠ 0 := by rw [map_pow]; exact pow_ne_zero m₁ hφg_ne
      have hgm₂_ne : φ_V.hom (g ^ m₂) ≠ 0 := by rw [map_pow]; exact pow_ne_zero m₂ hφg_ne
      have hb₂_ne : b₂ ≠ 0 := fun hb₂0 =>
        mul_ne_zero hφr₂_ne hgm₂_ne (by rw [eq₂, hb₂0, map_zero])
      have hden_nzd : b₂ * g ^ m₁ ∈ nonZeroDivisors B_V :=
        mem_nonZeroDivisors_of_ne_zero (mul_ne_zero hb₂_ne
          (fun hg0 => hgm₁_ne (by rw [hg0, map_zero])))
      refine ⟨(b₁ * g ^ m₂, ⟨b₂ * g ^ m₁, hden_nzd⟩), ?_⟩
      change z * φ_V.hom (b₂ * g ^ m₁) = φ_V.hom (b₁ * g ^ m₂)
      rw [map_mul, map_mul, ← eq₂, ← eq₁]
      calc z * (φ_UX.hom r₂ * φ_V.hom (g ^ m₂) * φ_V.hom (g ^ m₁))
          = (z * φ_UX.hom r₂) * φ_V.hom (g ^ m₁) * φ_V.hom (g ^ m₂) := by ring
        _ = φ_UX.hom r₁ * φ_V.hom (g ^ m₁) * φ_V.hom (g ^ m₂) := by rw [hzr']
    · intro x y hxy
      exact ⟨1, by simp [hInj_φV hxy]⟩

  
  have hProjIso : ∀ (Z : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsIntegral Z]
      (p_Z : Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of k)) [AlgebraicGeometry.IsProper p_Z]
      (hNormZ : IsAffineNormalScheme Z)
      (f' : Γ ⟶ Z) [AlgebraicGeometry.IsProper f']
      (η_Z : AlgebraicGeometry.Spec (CommRingCat.of L) ⟶ Z),
      η_Z ≫ p_Z = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k L)) →
      η_Γ ≫ f' = η_Z →
      IsSchemeFunctionField Z L η_Z →
      CategoryTheory.IsIso f' := by
    intro Z _ p_Z _ hNormZ f' _ η_Z hηZ_comm hη_f' hFuncZ
    have hLocalOpen : ∀ z : ↥Γ,
        ∃ W_z : Γ.Opens, z ∈ W_z ∧ AlgebraicGeometry.IsOpenImmersion (W_z.ι ≫ f') := by
      intro z
      obtain ⟨U_Z, hUZ, hfz_UZ, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := f'.base z) (U := ⊤) trivial
      obtain ⟨V_Γ, hVΓ, hz_VΓ, hV_sub⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
          (x := z) (U := (TopologicalSpace.Opens.map f'.base).obj U_Z) hfz_UZ
      have e_Z : V_Γ ≤ (TopologicalSpace.Opens.map f'.base).obj U_Z := hV_sub
      have hUZ_ne : Nonempty ↥U_Z := ⟨⟨f'.base z, hfz_UZ⟩⟩
      have hVΓ_ne : Nonempty ↥V_Γ := ⟨⟨z, hz_VΓ⟩⟩
      let B_Z : Type u := ↑(Z.presheaf.obj (Opposite.op U_Z))
      let B_Γ : Type u := ↑(Γ.presheaf.obj (Opposite.op V_Γ))
      obtain ⟨hDom_BZ, hIC_BZ⟩ := hNormZ U_Z hUZ hUZ_ne
      have : IsDomain B_Z := hDom_BZ
      have : IsIntegrallyClosed B_Z := hIC_BZ
      have : IsDomain B_Γ := @AlgebraicGeometry.IsIntegral.component_integral Γ hIntΓ V_Γ hVΓ_ne
      let α : B_Z →+* B_Γ := (f'.appLE U_Z V_Γ e_Z).hom
      have hFT_α : α.FiniteType := f'.finiteType_appLE hUZ hVΓ e_Z
      let _ : Algebra k B_Γ :=
        (AlgebraicGeometry.Spec.preimage (hVΓ.fromSpec ≫ f' ≫ p_Z)).hom.toAlgebra
      have hf_kB : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k B_Γ)) =
          hVΓ.fromSpec ≫ f' ≫ p_Z :=
        AlgebraicGeometry.Spec.map_preimage (hVΓ.fromSpec ≫ f' ≫ p_Z)
      have : Algebra.FiniteType k B_Γ := by
        have hLFT : AlgebraicGeometry.LocallyOfFiniteType
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k B_Γ))) := by
          rw [hf_kB]; infer_instance
        exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff
          (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp hLFT
      have : IsNoetherianRing B_Γ := Algebra.FiniteType.isNoetherianRing k B_Γ
      obtain ⟨φ_Z, hFrac_Z, hSpec_Z⟩ := hFuncZ U_Z hUZ hUZ_ne
      obtain ⟨φ_Γ, hFrac_Γ, hSpec_Γ⟩ := hFuncΓ V_Γ hVΓ hVΓ_ne
      have hInj_φZ : Function.Injective φ_Z.hom :=
        fun _ _ h => @IsFractionRing.injective B_Z _ L _ φ_Z.hom.toAlgebra hFrac_Z _ _ h
      have hInj_φΓ : Function.Injective φ_Γ.hom :=
        fun _ _ h => @IsFractionRing.injective B_Γ _ L _ φ_Γ.hom.toAlgebra hFrac_Γ _ _ h
      have hφ_comp : φ_Γ.hom.comp α = φ_Z.hom := by
        have hSpec_eq :
            AlgebraicGeometry.Spec.map (f'.appLE U_Z V_Γ e_Z ≫ φ_Γ) ≫ hUZ.fromSpec =
              AlgebraicGeometry.Spec.map φ_Z ≫ hUZ.fromSpec := by
          rw [AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc,
            hUZ.SpecMap_appLE_fromSpec f' hVΓ e_Z, ← CategoryTheory.Category.assoc,
            hSpec_Γ, hη_f', hSpec_Z]
        exact CommRingCat.hom_ext_iff.mp
          (AlgebraicGeometry.Spec.map_injective ((cancel_mono hUZ.fromSpec).mp hSpec_eq))
      have hInj_α : Function.Injective α := fun a₁ a₂ h12 =>
        hInj_φZ (by rw [← hφ_comp, RingHom.comp_apply, RingHom.comp_apply, h12])
      have hφΓ_k : φ_Γ.hom.comp (algebraMap k B_Γ) = algebraMap k L := by
        have hSpec_eq :
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_Γ.hom.comp (algebraMap k B_Γ))) =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k L)) := by
          rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, hf_kB]
          change AlgebraicGeometry.Spec.map φ_Γ ≫ hVΓ.fromSpec ≫ f' ≫ p_Z = _
          rw [← CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map φ_Γ), hSpec_Γ,
            ← CategoryTheory.Category.assoc η_Γ, hη_f', hηZ_comm]
        exact CommRingCat.hom_ext_iff.mp (AlgebraicGeometry.Spec.map_injective hSpec_eq)
      let ψ_B : B_Γ →ₐ[k] L :=
        { φ_Γ.hom with commutes' := fun c => congrArg (fun g => g c) hφΓ_k }
      have hMax_of_ne_bot : ∀ (P : Ideal B_Γ), P.IsPrime → P ≠ ⊥ → P.IsMaximal := by
        intro P hP_prime hP_ne
        obtain ⟨s, g_N, hgN_inj, hgN_int⟩ :=
          exists_integral_inj_algHom_of_fg k B_Γ
        have hs_le1 : s ≤ 1 := by
          have htr_le : Algebra.trdeg k (MvPolynomial (Fin s) k) ≤ Algebra.trdeg k L :=
            trdeg_le_of_injective (ψ_B.comp g_N) (hInj_φΓ.comp hgN_inj)
          rw [MvPolynomial.trdeg_of_isDomain, hTrdeg] at htr_le
          simpa using htr_le
        have hex_x : ∃ x ∈ P, x ≠ 0 := by
          by_contra! hall0
          exact hP_ne (eq_bot_iff.mpr fun x hx => Ideal.mem_bot.mpr (hall0 x hx))
        rcases hex_x with ⟨x, hxP, hx0⟩
        let _ : Algebra (MvPolynomial (Fin s) k) B_Γ := g_N.toRingHom.toAlgebra
        have : Algebra.IsIntegral (MvPolynomial (Fin s) k) B_Γ := ⟨hgN_int⟩
        have h_under_bot : Ideal.under (MvPolynomial (Fin s) k) (⊥ : Ideal B_Γ) = ⊥ := by
          rw [eq_bot_iff]
          intro p hp
          rw [Ideal.mem_under, Ideal.mem_bot] at hp
          exact Ideal.mem_bot.mpr (hgN_inj (hp.trans (map_zero _).symm))
        have h_lt : (⊥ : Ideal (MvPolynomial (Fin s) k)) <
            Ideal.under (MvPolynomial (Fin s) k) P := by
          rw [← h_under_bot]
          exact Ideal.under_lt_under_of_integral_mem_sdiff (R := MvPolynomial (Fin s) k)
            bot_le ⟨hxP, fun hbot => hx0 (Ideal.mem_bot.mp hbot)⟩
            (Algebra.IsIntegral.isIntegral x)
        have h_under_prime : (Ideal.under (MvPolynomial (Fin s) k) P).IsPrime :=
          Ideal.IsPrime.under (MvPolynomial (Fin s) k) P
        interval_cases s
        · exfalso
          let e0 := (MvPolynomial.isEmptyAlgEquiv k (Fin 0)).toRingEquiv
          let q0 : Ideal k :=
            Ideal.comap e0.symm.toRingHom (Ideal.under (MvPolynomial (Fin 0) k) P)
          have : q0.IsPrime := Ideal.IsPrime.comap e0.symm.toRingHom
          have hq0_bot : q0 = ⊥ := Ideal.eq_bot_of_prime q0
          apply (ne_of_lt h_lt).symm
          rw [eq_bot_iff]
          intro f hf
          have hef : e0 f ∈ q0 := by
            change e0.symm (e0 f) ∈ Ideal.under (MvPolynomial (Fin 0) k) P
            rwa [e0.symm_apply_apply]
          rw [hq0_bot, Ideal.mem_bot] at hef
          exact Ideal.mem_bot.mpr (e0.injective (hef.trans (map_zero e0).symm))
        · let e1 := (MvPolynomial.uniqueAlgEquiv k (Fin 1)).toRingEquiv
          let q1 : Ideal (Polynomial k) :=
            Ideal.comap e1.symm.toRingHom (Ideal.under (MvPolynomial (Fin 1) k) P)
          have : q1.IsPrime := Ideal.IsPrime.comap e1.symm.toRingHom
          have hq1_ne : q1 ≠ ⊥ := by
            intro hbot
            apply (ne_of_lt h_lt).symm
            rw [eq_bot_iff]
            intro f hf
            have hmem : e1 f ∈ q1 := by
              change e1.symm (e1 f) ∈ Ideal.under (MvPolynomial (Fin 1) k) P
              rwa [e1.symm_apply_apply]
            rw [hbot, Ideal.mem_bot] at hmem
            exact Ideal.mem_bot.mpr (e1.injective (hmem.trans (map_zero e1).symm))
          have hq1_max : q1.IsMaximal := Ideal.IsPrime.isMaximal inferInstance hq1_ne
          have h_under_max : (Ideal.under (MvPolynomial (Fin 1) k) P).IsMaximal := by
            have heq : Ideal.comap e1.toRingHom q1 = Ideal.under (MvPolynomial (Fin 1) k) P := by
              ext f
              dsimp only [q1]
              rw [Ideal.mem_comap, Ideal.mem_comap]
              change e1.symm (e1 f) ∈ _ ↔ _
              rw [e1.symm_apply_apply]
            rw [← heq]
            exact Ideal.comap_isMaximal_of_surjective e1.toRingHom e1.surjective
          exact Ideal.isMaximal_of_mem_primesOver (p := Ideal.under (MvPolynomial (Fin 1) k) P)
            ⟨hP_prime, ⟨rfl⟩⟩
      let _ : Algebra B_Z B_Γ := α.toAlgebra
      have : Algebra.FiniteType B_Z B_Γ := hFT_α
      have : Algebra.QuasiFinite B_Z B_Γ := by
        rw [Algebra.QuasiFinite.iff_finite_primesOver]
        intro I _
        by_cases hI : I = ⊥
        · subst hI
          refine (Set.finite_singleton (⊥ : Ideal B_Γ)).subset ?_
          rintro P ⟨hP_prime, ⟨hP_over⟩⟩
          rw [Set.mem_singleton_iff, eq_bot_iff]
          intro b hb
          rw [Ideal.mem_bot]
          obtain ⟨⟨a₁, s_a⟩, hba⟩ :=
            @IsLocalization.surj B_Z _ (nonZeroDivisors B_Z) L _ φ_Z.hom.toAlgebra hFrac_Z
              (φ_Γ.hom b)
          rcases s_a with ⟨a₂, ha₂⟩
          have ha₂_ne : a₂ ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp ha₂
          have hαa₂_ne : α a₂ ≠ 0 := fun h0 => ha₂_ne (hInj_α (h0.trans (map_zero _).symm))
          have hmul_eq : b * α a₂ = α a₁ := by
            apply hInj_φΓ
            rw [map_mul, ← RingHom.comp_apply, ← RingHom.comp_apply, hφ_comp]
            exact hba
          have ha₁_in : a₁ ∈ Ideal.under B_Z P := by
            change α a₁ ∈ P
            rw [← hmul_eq]
            exact P.mul_mem_right (α a₂) hb
          rw [← hP_over, Ideal.mem_bot] at ha₁_in
          rw [ha₁_in, map_zero] at hmul_eq
          exact (mul_eq_zero.mp hmul_eq).resolve_right hαa₂_ne
        · have hex_a : ∃ a₀ ∈ I, a₀ ≠ 0 := by
            by_contra! hall0
            exact hI (eq_bot_iff.mpr fun a ha => Ideal.mem_bot.mpr (hall0 a ha))
          rcases hex_a with ⟨a₀, ha₀_I, ha₀_ne⟩
          have hαa₀_ne : α a₀ ≠ 0 := fun h0 => ha₀_ne (hInj_α (h0.trans (map_zero _).symm))
          refine (Ideal.finite_minimalPrimes_of_isNoetherianRing B_Γ (Ideal.span {α a₀})).subset ?_
          rintro P ⟨hP_prime, ⟨hP_over⟩⟩
          have hαa₀_P : α a₀ ∈ P := by
            change a₀ ∈ Ideal.under B_Z P
            rwa [← hP_over]
          refine ⟨⟨hP_prime, (Ideal.span_singleton_le_iff_mem P).mpr hαa₀_P⟩, ?_⟩
          intro P' hP'_pair hP'_le
          rcases hP'_pair with ⟨hP'_prime, hspan_P'⟩
          have hP'_ne : P' ≠ ⊥ := by
            intro hbot
            have := (Ideal.span_singleton_le_iff_mem P').mp hspan_P'
            rw [hbot, Ideal.mem_bot] at this
            exact hαa₀_ne this
          have hP'_max : P'.IsMaximal := hMax_of_ne_bot P' hP'_prime hP'_ne
          exact (hP'_max.eq_of_le hP_prime.ne_top hP'_le).symm.le
      let q_z : PrimeSpectrum B_Γ := hVΓ.primeIdealOf ⟨z, hz_VΓ⟩
      have hZMP : Algebra.ZariskisMainProperty B_Z q_z.asIdeal :=
        Algebra.ZariskisMainProperty.of_finiteType (R := B_Z) q_z.asIdeal
      obtain ⟨r, hr_not_q, hr_int_mul⟩ := Algebra.zariskisMainProperty_iff'.mp hZMP
      have hInt_in_range : ∀ y : B_Γ, _root_.IsIntegral B_Z y → ∃ a : B_Z, α a = y := by
        intro y hy
        obtain ⟨P_y, hPy_monic, hPy_eval⟩ := hy
        let _ : Algebra B_Z L := φ_Z.hom.toAlgebra
        have hy_L : _root_.IsIntegral B_Z (φ_Γ.hom y) := by
          refine ⟨P_y, hPy_monic, ?_⟩
          change Polynomial.eval₂ φ_Z.hom (φ_Γ.hom y) P_y = 0
          rw [← hφ_comp, ← Polynomial.hom_eval₂]
          exact (congrArg φ_Γ.hom hPy_eval).trans (map_zero _)
        obtain ⟨a, ha⟩ :=
          (@isIntegrallyClosed_iff B_Z _ L _ φ_Z.hom.toAlgebra hFrac_Z).mp hIC_BZ hy_L
        refine ⟨a, hInj_φΓ ?_⟩
        change (φ_Γ.hom.comp α) a = φ_Γ.hom y
        rw [hφ_comp]
        exact ha
      obtain ⟨m₁, hm₁⟩ := hr_int_mul r
      have hr_pow_int : _root_.IsIntegral B_Z (r ^ (m₁ + 1)) := by
        rwa [pow_succ]
      have hr_int : _root_.IsIntegral B_Z r :=
        IsIntegral.of_pow (Nat.succ_pos m₁) hr_pow_int
      obtain ⟨r₀, hr₀_eq⟩ := hInt_in_range r hr_int
      let W_z : Γ.Opens := Γ.basicOpen r
      have hz_Wz : z ∈ W_z := by
        dsimp only [W_z]
        rw [← hVΓ.fromSpec_image_basicOpen r]
        exact ⟨q_z, hr_not_q, hVΓ.fromSpec_primeIdealOf ⟨z, hz_VΓ⟩⟩
      have e_Wz : W_z ≤ (TopologicalSpace.Opens.map f'.base).obj U_Z :=
        le_trans (Γ.basicOpen_le r) e_Z
      let B_r : Type u := ↑(Γ.presheaf.obj (Opposite.op W_z))
      let res_r : B_Γ →+* B_r := (Γ.presheaf.map (CategoryTheory.homOfLE (Γ.basicOpen_le r)).op).hom
      let α_r : B_Z →+* B_r := (f'.appLE U_Z W_z e_Wz).hom
      have hα_r_eq : α_r = res_r.comp α := by
        have := f'.appLE_map e_Z (CategoryTheory.homOfLE (Γ.basicOpen_le r)).op
        exact congrArg CommRingCat.Hom.hom this.symm
      have hLoc_Br : @IsLocalization.Away B_Γ _ r B_r _ res_r.toAlgebra :=
        hVΓ.isLocalization_basicOpen r
      have hLoc_BZr : @IsLocalization.Away B_Z _ r₀ B_r _ α_r.toAlgebra := by
        let _ : Algebra B_Γ B_r := res_r.toAlgebra
        let _ : Algebra B_Z B_r := α_r.toAlgebra
        refine { map_units := ?_, surj := ?_, exists_of_eq := ?_ }
        · rintro ⟨_, n, rfl⟩
          change IsUnit (α_r (r₀ ^ n))
          rw [hα_r_eq, RingHom.comp_apply, map_pow, hr₀_eq, map_pow]
          exact (@IsLocalization.map_units B_Γ _ (Submonoid.powers r) B_r _ _ hLoc_Br
            (⟨r, 1, pow_one r⟩ : Submonoid.powers r)).pow n
        · intro w
          obtain ⟨⟨x, s_n⟩, hwx⟩ :=
            @IsLocalization.surj B_Γ _ (Submonoid.powers r) B_r _ _ hLoc_Br w
          rcases s_n with ⟨_, n₁, rfl⟩
          obtain ⟨m, hm⟩ := hr_int_mul x
          obtain ⟨a_x, hax⟩ := hInt_in_range (r ^ m * x) hm
          refine ⟨(a_x, ⟨r₀ ^ (n₁ + m), n₁ + m, rfl⟩), ?_⟩
          change w * α_r (r₀ ^ (n₁ + m)) = α_r a_x
          rw [hα_r_eq, RingHom.comp_apply, RingHom.comp_apply, map_pow, hr₀_eq, hax,
            pow_add, map_mul, ← mul_assoc]
          have hwx' : w * res_r (r ^ n₁) = res_r x := hwx
          rw [hwx', ← map_mul, mul_comm x (r ^ m)]
        · intro a₁ a₂ h12
          change α_r a₁ = α_r a₂ at h12
          rw [hα_r_eq, RingHom.comp_apply, RingHom.comp_apply] at h12
          obtain ⟨s_k, hk⟩ :=
            (@IsLocalization.eq_iff_exists B_Γ _ (Submonoid.powers r) B_r _ _ hLoc_Br).mp h12
          rcases s_k with ⟨_, k_exp, rfl⟩
          refine ⟨(⟨r₀ ^ k_exp, k_exp, rfl⟩ : Submonoid.powers r₀), hInj_α ?_⟩
          change α (r₀ ^ k_exp * a₁) = α (r₀ ^ k_exp * a₂)
          rw [map_mul, map_mul, map_pow, hr₀_eq]
          exact hk
      have : AlgebraicGeometry.IsOpenImmersion (AlgebraicGeometry.Spec.map (f'.appLE U_Z W_z e_Wz)) :=
        @AlgebraicGeometry.IsOpenImmersion.of_isLocalization B_Z B_r _ _ α_r.toAlgebra r₀ hLoc_BZr
      have hWz_aff : AlgebraicGeometry.IsAffineOpen W_z := hVΓ.basicOpen r
      have : AlgebraicGeometry.IsOpenImmersion (hWz_aff.fromSpec ≫ f') := by
        rw [← hUZ.SpecMap_appLE_fromSpec f' hWz_aff e_Wz]
        exact AlgebraicGeometry.IsOpenImmersion.comp _ _
      have h_iso_from : hWz_aff.isoSpec.hom ≫ hWz_aff.fromSpec = W_z.ι := by
        rw [hWz_aff.isoSpec_hom]
        exact hWz_aff.toSpecΓ_fromSpec
      have : AlgebraicGeometry.IsOpenImmersion (W_z.ι ≫ f') := by
        rw [← h_iso_from, CategoryTheory.Category.assoc]
        exact AlgebraicGeometry.IsOpenImmersion.comp hWz_aff.isoSpec.hom (hWz_aff.fromSpec ≫ f')
      exact ⟨W_z, hz_Wz, inferInstance⟩
    choose W hzW hOpenW using hLocalOpen
    have hInj_f' : Function.Injective f'.base := by
      intro z₁ z₂ hfz
      have : AlgebraicGeometry.IsOpenImmersion ((W z₂).ι ≫ f') := hOpenW z₂
      let O₁ : Γ.Opens :=
        W z₁ ⊓ (TopologicalSpace.Opens.map f'.base).obj ((W z₂).ι ≫ f').opensRange
      have hz₁_O₁ : z₁ ∈ O₁ := by
        refine ⟨hzW z₁, ?_⟩
        change f'.base z₁ ∈ Set.range ((W z₂).ι ≫ f').base
        rw [hfz]
        exact ⟨⟨z₂, hzW z₂⟩, rfl⟩
      have hRange_O₁ : Set.range (O₁.ι ≫ f').base ⊆ Set.range ((W z₂).ι ≫ f').base := by
        rintro _ ⟨u, rfl⟩
        exact u.2.2
      let τ : O₁.toScheme ⟶ (W z₂).toScheme :=
        AlgebraicGeometry.IsOpenImmersion.lift ((W z₂).ι ≫ f') (O₁.ι ≫ f') hRange_O₁
      have hτ_fac : τ ≫ ((W z₂).ι ≫ f') = O₁.ι ≫ f' :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac ((W z₂).ι ≫ f') (O₁.ι ≫ f') hRange_O₁
      have hRange_ηO₁ : Set.range η_Γ.base ⊆ Set.range O₁.ι.base := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        rintro _ ⟨q, rfl⟩
        rw [@Subsingleton.elim _ hSubL q pt_L]
        exact hηΓ_in_open O₁ ⟨⟨z₁, hz₁_O₁⟩⟩
      let η_O₁ := AlgebraicGeometry.IsOpenImmersion.lift O₁.ι η_Γ hRange_ηO₁
      have hη_O₁_fac : η_O₁ ≫ O₁.ι = η_Γ :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac O₁.ι η_Γ hRange_ηO₁
      have : AlgebraicGeometry.IsDominant η_O₁ := by
        rw [AlgebraicGeometry.isDominant_iff, denseRange_iff_closure_range, Set.eq_univ_iff_forall]
        intro u
        rw [mem_closure_iff]
        intro o ho huo
        let O_sub : Γ.Opens := ⟨O₁.ι.base '' o, O₁.ι.isOpenEmbedding.isOpenMap o ho⟩
        have hmem := hηΓ_in_open O_sub ⟨⟨O₁.ι.base u, u, huo, rfl⟩⟩
        rcases hmem with ⟨u', hu'o, hu'_eq⟩
        have h_eq_u : u' = η_O₁.base pt_L :=
          O₁.ι.isOpenEmbedding.injective (hu'_eq.trans (by
            change η_Γ.base pt_L = (η_O₁ ≫ O₁.ι).base pt_L; rw [hη_O₁_fac]))
        exact ⟨η_O₁.base pt_L, h_eq_u ▸ hu'o, pt_L, rfl⟩
      have hRange_ηW₂ : Set.range η_Γ.base ⊆ Set.range (W z₂).ι.base := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        rintro _ ⟨q, rfl⟩
        rw [@Subsingleton.elim _ hSubL q pt_L]
        exact hηΓ_in_open (W z₂) ⟨⟨z₂, hzW z₂⟩⟩
      let η_W₂ := AlgebraicGeometry.IsOpenImmersion.lift (W z₂).ι η_Γ hRange_ηW₂
      have hη_W₂_fac : η_W₂ ≫ (W z₂).ι = η_Γ :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac (W z₂).ι η_Γ hRange_ηW₂
      have hη_τ_eq : η_O₁ ≫ τ = η_W₂ := by
        apply (cancel_mono ((W z₂).ι ≫ f')).mp
        rw [CategoryTheory.Category.assoc, hτ_fac, ← CategoryTheory.Category.assoc,
          hη_O₁_fac, ← CategoryTheory.Category.assoc, hη_W₂_fac]
      have : AlgebraicGeometry.IsReduced O₁.toScheme :=
        AlgebraicGeometry.isReduced_of_isOpenImmersion O₁.ι
      have hτ_ι_eq : τ ≫ (W z₂).ι = O₁.ι :=
        AlgebraicGeometry.ext_of_isDominant_of_isSeparated f'
          (by rw [CategoryTheory.Category.assoc, hτ_fac])
          η_O₁
          (by rw [← CategoryTheory.Category.assoc, hη_τ_eq, hη_W₂_fac, hη_O₁_fac])
      let u₁ : ↥O₁.toScheme := ⟨z₁, hz₁_O₁⟩
      let u₂ : ↥(W z₂).toScheme := ⟨z₂, hzW z₂⟩
      have hτ_u₁ : τ.base u₁ = u₂ := by
        apply ((W z₂).ι ≫ f').isOpenEmbedding.injective
        calc ((W z₂).ι ≫ f').base (τ.base u₁)
            = (τ ≫ ((W z₂).ι ≫ f')).base u₁ := rfl
          _ = (O₁.ι ≫ f').base u₁ := by rw [hτ_fac]
          _ = f'.base z₁ := rfl
          _ = f'.base z₂ := hfz
          _ = ((W z₂).ι ≫ f').base u₂ := rfl
      have h_eval := congrArg (fun g : O₁.toScheme ⟶ Γ => g.base u₁) hτ_ι_eq
      change (W z₂).ι.base (τ.base u₁) = z₁ at h_eval
      rw [hτ_u₁] at h_eval
      exact h_eval.symm
    have hSup : iSup W = (⊤ : Γ.Opens) :=
      eq_top_iff.mpr fun z _ => TopologicalSpace.Opens.mem_iSup.mpr ⟨z, hzW z⟩
    have : AlgebraicGeometry.IsOpenImmersion f' :=
      AlgebraicGeometry.IsOpenImmersion.of_openCover_source f'
        (Γ.openCoverOfIsOpenCover W (TopologicalSpace.IsOpenCover.mk hSup)) hInj_f'
        fun i => hOpenW i
    have : AlgebraicGeometry.IsDominant f' := by
      rw [AlgebraicGeometry.isDominant_iff, denseRange_iff_closure_range, Set.eq_univ_iff_forall]
      intro x
      rw [mem_closure_iff]
      intro o ho hxo
      let U_op : Z.Opens := ⟨o, ho⟩
      have hxU : x ∈ U_op := hxo
      obtain ⟨U₀, hU₀_mem, hxU₀, hU₀_le⟩ :=
        (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
          (AlgebraicGeometry.Scheme.isBasis_affineOpens Z)) hxU
      have hU₀ : AlgebraicGeometry.IsAffineOpen U₀ := hU₀_mem
      obtain ⟨φ₀, _, hφ₀⟩ := hFuncZ U₀ hU₀ ⟨⟨x, hxU₀⟩⟩
      have hfx_eq : f'.base (η_Γ.base pt_L) =
          hU₀.fromSpec.base ((AlgebraicGeometry.Spec.map φ₀).base pt_L) := by
        change (η_Γ ≫ f').base pt_L = (AlgebraicGeometry.Spec.map φ₀ ≫ hU₀.fromSpec).base pt_L
        rw [hη_f', hφ₀]
      have hfx_mem : f'.base (η_Γ.base pt_L) ∈ (U₀ : Set ↥Z) := by
        rw [hfx_eq, ← show Set.range hU₀.fromSpec.base = (U₀ : Set ↥Z) from
          congrArg SetLike.coe hU₀.opensRange_fromSpec]
        exact ⟨(AlgebraicGeometry.Spec.map φ₀).base pt_L, rfl⟩
      exact ⟨f'.base (η_Γ.base pt_L), hU₀_le hfx_mem, ⟨η_Γ.base pt_L, rfl⟩⟩
    have : AlgebraicGeometry.Surjective f' :=
      AlgebraicGeometry.Surjective.of_universallyClosed_of_isDominant f'
    exact (AlgebraicGeometry.isIso_iff_isOpenImmersion_and_surjective f').mpr
      ⟨inferInstance, inferInstance⟩

  have : CategoryTheory.IsIso p₁ := hProjIso X p_X hNormX p₁ η_X hηX_comm hη_p₁ hFuncX
  have : CategoryTheory.IsIso p₂ := hProjIso P_k π_k hNormPk p₂ η_P hηP_comm hη_p₂ hFuncP
  let iso_k : X ≅ P_k := (CategoryTheory.asIso p₁).symm ≪≫ CategoryTheory.asIso p₂
  refine ⟨iso_k, ?_⟩
  dsimp only [iso_k, CategoryTheory.Iso.trans_hom, CategoryTheory.Iso.symm_hom,
    CategoryTheory.asIso_inv, CategoryTheory.asIso_hom]
  rw [CategoryTheory.Category.assoc, ← hp₁₂_comm, CategoryTheory.IsIso.inv_hom_id_assoc]

theorem weil_strictlySemistable_mod_fiber_finite_and_geom_descent (K : Type u) [Field K] [IsSepClosed K]
    (m : ℕ) (V : ValuationSubring K) (hPkg : IsValuationRingAlgPackage m V)
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (n : ℕ) (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (C' : AlgebraicGeometry.Scheme.{u})
    (g' : C' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (τ' : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C'))
    (ι' : C_K ⟶ C')
    (hMod' : IsValuationPointedCurveModel V p_K n σ_K C' g' τ' ι')
    (U' : C'.Opens)
