    have hus_ne : algebraMap (↥V_P ⧸ P₀) P₀.ResidueField (Ideal.Quotient.mk P₀ s) ≠ 0 := by
      intro h0
      have hinj : Function.Injective (algebraMap (↥V_P ⧸ P₀) P₀.ResidueField) :=
