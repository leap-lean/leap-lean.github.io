      let rx_C : ↥C := ⟨r ^ m * x, h_rx⟩
      have h_mul_eq : u_r.val ^ m * α_fib x = ρ rx_C i_0 := by
        apply Subtype.ext
        change (W.subtype u_r.val) ^ m * β_0 x = W.subtype (ρ rx_C i_0)
        rw [hu_r_val, ← hβ_on_C r_C, ← map_pow, ← map_mul, hβ_on_C rx_C]
