      rw [eq_top_iff]
      intro z _
      obtain ⟨⟨x_bar, u⟩, hzu⟩ := IsLocalization.surj S_y z
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x_bar
      rcases u with ⟨_, ⟨s, hs, rfl⟩⟩
      let c_s : P₀.ResidueField := algebraMap ↥V_P P₀.ResidueField s
      have hφ_cs : φ_K c_s = algebraMap B_y D_y (γ_bar s) :=
        Ideal.ResidueField.lift_algebraMap P₀ f_RD hf₁ hf₂ s
      have hcs_ne : c_s ≠ 0 := by
        intro h0
        have hu_unit : IsUnit (algebraMap B_y D_y (γ_bar s)) :=
          IsLocalization.map_units D_y (⟨γ_bar s, ⟨s, hs, rfl⟩⟩ : ↥S_y)
        rw [← hφ_cs, h0, map_zero] at hu_unit
        exact not_isUnit_zero hu_unit
      have hinv : φ_K c_s * φ_K c_s⁻¹ = 1 := by
        rw [← map_mul, mul_inv_cancel₀ hcs_ne, map_one]
      have hz_eq : z = ψ_BD x * φ_K c_s⁻¹ := by
        calc
          z = z * (φ_K c_s * φ_K c_s⁻¹) := by rw [hinv, mul_one]
          _ = (z * algebraMap B_y D_y (γ_bar s)) * φ_K c_s⁻¹ := by rw [hφ_cs, mul_assoc]
          _ = ψ_BD x * φ_K c_s⁻¹ := by rw [hzu]; rfl
      rw [hz_eq]
      exact A_sub.mul_mem (hB_in x) (A_sub.algebraMap_mem c_s⁻¹)
    haveI : IsJacobsonRing D_y := RingHom.FiniteType.isJacobsonRing hFT_φ
    let ι_spec : PrimeSpectrum D_y → PrimeSpectrum B₁ :=
      fun q => PrimeSpectrum.comap (Ideal.Quotient.mk y.asIdeal)
        (PrimeSpectrum.comap (algebraMap B_y D_y) q)
    have hι_inj : Function.Injective ι_spec :=
      (PrimeSpectrum.comap_injective_of_surjective (Ideal.Quotient.mk y.asIdeal)
        Ideal.Quotient.mk_surjective).comp
        (PrimeSpectrum.localization_comap_injective D_y S_y)
    have hFin_Dy : (Set.univ : Set (PrimeSpectrum D_y)).Finite := by
      refine (hSpec_fin.preimage hι_inj.injOn).subset ?_
      intro q _
      change y.asIdeal ≤ (ι_spec q).asIdeal
      intro b hb
      change algebraMap B_y D_y (Ideal.Quotient.mk y.asIdeal b) ∈ q.asIdeal
      rw [Ideal.Quotient.eq_zero_iff_mem.mpr hb, map_zero]
      exact q.asIdeal.zero_mem
    have hMaxBot : (⊥ : Ideal D_y).IsMaximal := by
      by_contra hNotMax
      classical
      obtain ⟨M, hM_max, hM_inf⟩ :=
        isJacobsonRing_iff_sInf_maximal.mp ‹IsJacobsonRing D_y› (I := (⊥ : Ideal D_y)) Ideal.isPrime_bot
      let S_M : Set (PrimeSpectrum D_y) := {q : PrimeSpectrum D_y | q.asIdeal ∈ M}
