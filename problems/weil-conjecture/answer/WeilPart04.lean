    have hEt_e₀ : AlgebraicGeometry.Etale e₀ := inferInstance
    have he₀_comm : e₀ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom C₀) = g_WB := by
      dsimp only [e₀, φ, g_WB]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hComm₁]
    have hg_WB_comm : g_WB ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_VP) =
        W_B.ι ≫ g_ss := by
      dsimp only [g_WB]
      rw [CategoryTheory.Category.assoc, hg_W₁, ← CategoryTheory.Category.assoc, hi_WB_ι]
    have he₀_ideal : ∀ w : ↥W_B.toScheme,
        (e₀.base w).asIdeal = Ideal.comap ψ₁.hom (φ.base w).asIdeal := by
      intro w
      change ((AlgebraicGeometry.Spec.map ψ₁).base (φ.base w)).asIdeal = _
      rw [AlgebraicGeometry.Spec.map_base]
      rfl
    have he₀_u₀ : e₀.base u₀_WB = (m₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of A₀))) := by
      apply PrimeSpectrum.ext
      rw [he₀_ideal u₀_WB, hφ_u₀, hp₀_m₀]
    have hZ_good : ∀ y : ↥W_B.toScheme, y ∈ W_B.ι.base ⁻¹' M_all →
