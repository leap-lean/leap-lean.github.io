      change f.base z ∈ ((W₀.ι ≫ f).opensRange : Set ↥U_ss)
      rw [(W₀.ι ≫ f).coe_opensRange]
      exact ⟨⟨z₀, hz₀_W₀⟩, hfz₀.trans hfz.symm⟩
    have hO₁_ne : Nonempty ↥O₁ := ⟨⟨z, hz_O₁⟩⟩
    have hW₀_ne : Nonempty ↥W₀ := ⟨⟨z₀, hz₀_W₀⟩⟩
    have hRange_O₁ : Set.range ⇑(O₁.ι ≫ f).base ⊆ Set.range ⇑(W₀.ι ≫ f).base := by
      rintro _ ⟨⟨w, _, hwPre⟩, rfl⟩
      change f.base w ∈ ((W₀.ι ≫ f).opensRange : Set ↥U_ss) at hwPre
      rw [(W₀.ι ≫ f).coe_opensRange] at hwPre
      exact hwPre
    let τ : O₁.toScheme ⟶ W₀.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift (W₀.ι ≫ f) (O₁.ι ≫ f) hRange_O₁
    have hτ_fac : τ ≫ (W₀.ι ≫ f) = O₁.ι ≫ f :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac (W₀.ι ≫ f) (O₁.ι ≫ f) hRange_O₁
    let η₁ : AlgebraicGeometry.Spec (CommRingCat.of F_ss) ⟶ O₁.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift O₁.ι η_C (hη_mem O₁ hO₁_ne)
    have hη₁_fac : η₁ ≫ O₁.ι = η_C :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac O₁.ι η_C (hη_mem O₁ hO₁_ne)
    let η₂ : AlgebraicGeometry.Spec (CommRingCat.of F_ss) ⟶ W₀.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift W₀.ι η_C (hη_mem W₀ hW₀_ne)
    have hη₂_fac : η₂ ≫ W₀.ι = η_C :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac W₀.ι η_C (hη_mem W₀ hW₀_ne)
    have : AlgebraicGeometry.IsDominant η₁ := by
      rw [AlgebraicGeometry.isDominant_iff, denseRange_iff_closure_range, Set.eq_univ_iff_forall]
      intro u
      rw [mem_closure_iff]
      intro V hV_open huV
      let V'_op : C.Opens := ⟨⇑O₁.ι.base '' V, O₁.ι.isOpenEmbedding.isOpenMap V hV_open⟩
      have hV'_ne : Nonempty ↥V'_op := ⟨⟨O₁.ι.base u, u, huV, rfl⟩⟩
      have hmem : η_C.base pt₀ ∈ Set.range ⇑V'_op.ι.base :=
        hη_mem V'_op hV'_ne ⟨pt₀, rfl⟩
      rw [V'_op.range_ι] at hmem
      obtain ⟨v, hvV, hv_eq⟩ := hmem
      have hv_η₁ : O₁.ι.base v = O₁.ι.base (η₁.base pt₀) := by
        rw [hv_eq, ← hη₁_fac]
        rfl
      have hv_eq' : v = η₁.base pt₀ := O₁.ι.isOpenEmbedding.injective hv_η₁
      exact ⟨η₁.base pt₀, hv_eq' ▸ hvV, pt₀, rfl⟩
    have hη_τ : η₁ ≫ τ = η₂ := by
      apply (CategoryTheory.cancel_mono (W₀.ι ≫ f)).mp
      calc
        (η₁ ≫ τ) ≫ (W₀.ι ≫ f)
          = η₁ ≫ (τ ≫ (W₀.ι ≫ f)) := CategoryTheory.Category.assoc _ _ _
        _ = η₁ ≫ (O₁.ι ≫ f) := by rw [hτ_fac]
        _ = (η₁ ≫ O₁.ι) ≫ f := (CategoryTheory.Category.assoc _ _ _).symm
        _ = η_C ≫ f := by rw [hη₁_fac]
        _ = (η₂ ≫ W₀.ι) ≫ f := by rw [hη₂_fac]
        _ = η₂ ≫ (W₀.ι ≫ f) := CategoryTheory.Category.assoc _ _ _
    have h_eq_ι : τ ≫ W₀.ι = O₁.ι :=
      AlgebraicGeometry.ext_of_isDominant_of_isSeparated f
        (by rw [CategoryTheory.Category.assoc, hτ_fac]) η₁
        (by rw [← CategoryTheory.Category.assoc, hη_τ, hη₂_fac, hη₁_fac])
    let u₁ : ↥O₁.toScheme := ⟨z, hz_O₁⟩
    let u₂ : ↥W₀.toScheme := ⟨z₀, hz₀_W₀⟩
    have hτ_u : τ.base u₁ = u₂ := by
      apply (W₀.ι ≫ f).isOpenEmbedding.injective
      calc
        (W₀.ι ≫ f).base (τ.base u₁)
          = (τ ≫ (W₀.ι ≫ f)).base u₁ := rfl
        _ = (O₁.ι ≫ f).base u₁ := by rw [hτ_fac]
        _ = f.base z := rfl
        _ = x := hfz
        _ = f.base z₀ := hfz₀.symm
        _ = (W₀.ι ≫ f).base u₂ := rfl
    have h_eval : (τ ≫ W₀.ι).base u₁ = O₁.ι.base u₁ :=
      congrArg (fun g : O₁.toScheme ⟶ C => g.base u₁) h_eq_ι
    change W₀.ι.base (τ.base u₁) = z at h_eval
    rw [hτ_u] at h_eval
    exact h_eval.symm
  let F₁ : Set ↥U_ss := ⇑f '' ((W₀ : Set ↥C)ᶜ)
  have hF₁_cl : IsClosed F₁ :=
    f.isClosedMap ((W₀ : Set ↥C)ᶜ) W₀.isOpen.isClosed_compl
  let U_x : U_ss.Opens := ⟨F₁ᶜ, hF₁_cl.isOpen_compl⟩
  have hx_Ux : x ∈ U_x := by
    rintro ⟨z, hz_not_W₀, hfz⟩
    exact hz_not_W₀ (hFibUnique z hfz ▸ hz₀_W₀)
  let V_x : C.Opens := (TopologicalSpace.Opens.map f.base).obj U_x
  have hPre_le : V_x ≤ W₀ := by
    intro w hw
    by_contra hw_not
    exact hw ⟨w, hw_not, rfl⟩
  have hComp_open : AlgebraicGeometry.IsOpenImmersion ((f ∣_ U_x) ≫ U_x.ι) := by
    have hfac : (f ∣_ U_x) ≫ U_x.ι = C.homOfLE hPre_le ≫ (W₀.ι ≫ f) := by
      calc
        (f ∣_ U_x) ≫ U_x.ι
          = V_x.ι ≫ f :=
            (AlgebraicGeometry.isPullback_morphismRestrict f U_x).w
        _ = (C.homOfLE hPre_le ≫ W₀.ι) ≫ f := by rw [← C.homOfLE_ι hPre_le]
        _ = C.homOfLE hPre_le ≫ (W₀.ι ≫ f) := CategoryTheory.Category.assoc _ _ _
    rw [hfac]
    exact AlgebraicGeometry.IsOpenImmersion.comp (C.homOfLE hPre_le) (W₀.ι ≫ f)
  have : AlgebraicGeometry.IsOpenImmersion (f ∣_ U_x) :=
    AlgebraicGeometry.IsOpenImmersion.of_comp (f ∣_ U_x) U_x.ι
  have : AlgebraicGeometry.Surjective (f ∣_ U_x) :=
    CategoryTheory.MorphismProperty.of_isPullback
      (AlgebraicGeometry.isPullback_morphismRestrict f U_x).flip inferInstance
  exact ⟨U_x, hx_Ux,
    (AlgebraicGeometry.isIso_iff_isOpenImmersion_and_surjective (f ∣_ U_x)).mpr
      ⟨inferInstance, inferInstance⟩⟩

theorem weil_strictlySemistable_modification_locus_finite (K : Type u) [Field K]
    (m : ℕ) (V : ValuationSubring K) (hPkg : IsValuationRingAlgPackage m V)
    (U_ss C_cur : AlgebraicGeometry.Scheme.{u})
    (g_ss : U_ss ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (hAff_ss : AlgebraicGeometry.IsAffine U_ss)
    (hSS : IsStrictlySemistableCurveOverValuation V g_ss)
    (hNorm_ss : IsAffineNormalScheme U_ss)
    (F_ss : Type u) [Field F_ss]
    (η_ss : AlgebraicGeometry.Spec (CommRingCat.of F_ss) ⟶ U_ss)
    (hFunc_ss : IsSchemeFunctionField U_ss F_ss η_ss)
    (g_cur : C_cur ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (hSS_cur : IsStrictlySemistableCurveOverValuation V g_cur)
    (hNorm_cur : IsAffineNormalScheme C_cur)
    (f_ss_cur : C_cur ⟶ U_ss)
    (hProp_fss : AlgebraicGeometry.IsProper f_ss_cur)
    (hComm_fss : f_ss_cur ≫ g_ss = g_cur)
    (U_gen : U_ss.Opens)
    (hU_gen_nonempty : Nonempty ↥U_gen)
    (hU_gen_bot : ∀ y : ↥U_ss, (g_ss.base y).asIdeal = ⊥ → y ∈ U_gen)
    (hIso_gen : CategoryTheory.IsIso (f_ss_cur ∣_ U_gen)) :
    ∃ (U_iso : U_ss.Opens),
      CategoryTheory.IsIso (f_ss_cur ∣_ U_iso) ∧
      ((U_iso : Set ↥U_ss)ᶜ).Finite ∧
      (∀ y ∈ (U_iso : Set ↥U_ss)ᶜ, (g_ss.base y).asIdeal ≠ ⊥) :=
by
  classical
  have _ : AlgebraicGeometry.IsAffine U_ss := hAff_ss
  have _ : AlgebraicGeometry.IsProper f_ss_cur := hProp_fss
  have _ : CategoryTheory.IsIso (f_ss_cur ∣_ U_gen) := hIso_gen
  
  have hDownFrac : ∀ {R S : Type u} [CommRing R] [IsDomain R] [CommRing S] [IsDomain S]
      [Algebra R S] (d : R), d ≠ 0 → [IsLocalization.Away d S] →
      ∀ (φ_S : S →+* F_ss), @IsFractionRing S _ F_ss _ φ_S.toAlgebra →
        @IsFractionRing R _ F_ss _ (φ_S.comp (algebraMap R S)).toAlgebra := by
    intro R S _ _ _ _ _ d hd _ φ_S hFracS
    let φ_R : R →+* F_ss := φ_S.comp (algebraMap R S)
    have hSub : Submonoid.powers d ≤ nonZeroDivisors R :=
      Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hd)
    have hInjRS : Function.Injective (algebraMap R S) := IsLocalization.injective S hSub
    have hInjS : Function.Injective φ_S := by
      let _ : Algebra S F_ss := φ_S.toAlgebra
      exact @IsFractionRing.injective S _ F_ss _ _ hFracS
    have hInjR : Function.Injective φ_R := hInjS.comp hInjRS
    let _ : Algebra R F_ss := φ_R.toAlgebra
    refine { map_units := ?_, surj := ?_, exists_of_eq := ?_ }
    · intro y
      have hy0 : y.1 ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp y.2
      exact Ne.isUnit (fun h0 => hy0 (hInjR (h0.trans (map_zero φ_R).symm)))
    · let _ : Algebra S F_ss := φ_S.toAlgebra
      intro z
      obtain ⟨⟨a, s⟩, hzs⟩ := @IsLocalization.surj S _ (nonZeroDivisors S) F_ss _ _ hFracS z
      obtain ⟨k₁, r₁, ha⟩ := IsLocalization.Away.surj d a
      obtain ⟨k₂, r₂, hs⟩ := IsLocalization.Away.surj d s.1
      have hs_ne : s.1 ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s.2
      have hdS_ne : algebraMap R S (d ^ k₂) ≠ 0 :=
        fun h0 => pow_ne_zero k₂ hd (hInjRS (h0.trans (map_zero _).symm))
      have hr₂_ne : r₂ ≠ 0 := by
        intro hr0
        apply mul_ne_zero hs_ne hdS_ne
        rw [map_pow, hs, hr0, map_zero]
      have hden_ne : r₂ * d ^ k₁ ≠ 0 := mul_ne_zero hr₂_ne (pow_ne_zero k₁ hd)
      refine ⟨⟨r₁ * d ^ k₂, ⟨r₂ * d ^ k₁, mem_nonZeroDivisors_of_ne_zero hden_ne⟩⟩, ?_⟩
      have hzs' : z * φ_S s.1 = φ_S a := hzs
      change z * φ_S (algebraMap R S (r₂ * d ^ k₁)) = φ_S (algebraMap R S (r₁ * d ^ k₂))
      calc
        z * φ_S (algebraMap R S (r₂ * d ^ k₁))
            = z * (φ_S (algebraMap R S r₂) * φ_S (algebraMap R S (d ^ k₁))) := by
              rw [map_mul, map_mul]
        _ = z * (φ_S (s.1 * algebraMap R S d ^ k₂) * φ_S (algebraMap R S d ^ k₁)) := by
              rw [← hs, map_pow]
        _ = (z * φ_S s.1) * φ_S (algebraMap R S d ^ k₁) * φ_S (algebraMap R S d ^ k₂) := by
              rw [map_mul]; ring
        _ = φ_S (a * algebraMap R S d ^ k₁) * φ_S (algebraMap R S d ^ k₂) := by
              rw [hzs', map_mul]
        _ = φ_S (algebraMap R S (r₁ * d ^ k₂)) := by
              rw [ha, ← map_pow, ← map_mul, ← map_mul]
    · intro x₁ x₂ hx
      exact ⟨1, by simp [hInjR hx]⟩
  
  let V_gen : C_cur.Opens := (TopologicalSpace.Opens.map f_ss_cur.base).obj U_gen
  let e_gen : V_gen.toScheme ≅ U_gen.toScheme := CategoryTheory.asIso (f_ss_cur ∣_ U_gen)
  have hpb_gen : (f_ss_cur ∣_ U_gen) ≫ U_gen.ι = V_gen.ι ≫ f_ss_cur :=
    (AlgebraicGeometry.isPullback_morphismRestrict f_ss_cur U_gen).w
  obtain ⟨u₀_gen, hu₀_gen⟩ := hU_gen_nonempty
  obtain ⟨W₀, hW₀_aff, hu₀_W₀, hW₀_le⟩ :=
    (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
      (AlgebraicGeometry.Scheme.isBasis_affineOpens U_ss)) hu₀_gen
  have hW₀ : AlgebraicGeometry.IsAffineOpen W₀ := hW₀_aff
  have hW₀_ne : Nonempty ↥W₀ := ⟨⟨u₀_gen, hu₀_W₀⟩⟩
  obtain ⟨φ₀, hFrac₀, hφ₀⟩ := hFunc_ss W₀ hW₀ hW₀_ne
  let R₀_cat := U_ss.presheaf.obj (Opposite.op W₀)
  let R₀ : Type u := ↑R₀_cat
  have _ : IsDomain R₀ := (hNorm_ss W₀ hW₀ hW₀_ne).1
  have hRange_W₀ : Set.range ⇑hW₀.fromSpec.base ⊆ Set.range ⇑U_gen.ι.base := by
    rw [hW₀.range_fromSpec, U_gen.range_ι]
    exact hW₀_le
  let i_W₀ : AlgebraicGeometry.Spec R₀_cat ⟶ U_gen.toScheme :=
    AlgebraicGeometry.IsOpenImmersion.lift U_gen.ι hW₀.fromSpec hRange_W₀
  have hi_W₀ : i_W₀ ≫ U_gen.ι = hW₀.fromSpec :=
    AlgebraicGeometry.IsOpenImmersion.lift_fac U_gen.ι hW₀.fromSpec hRange_W₀
  have _ : AlgebraicGeometry.IsOpenImmersion (i_W₀ ≫ U_gen.ι) := by
    rw [hi_W₀]; infer_instance
  have _ : AlgebraicGeometry.IsOpenImmersion i_W₀ :=
    AlgebraicGeometry.IsOpenImmersion.of_comp i_W₀ U_gen.ι
  let j_W₀ : AlgebraicGeometry.Spec R₀_cat ⟶ C_cur := i_W₀ ≫ e_gen.inv ≫ V_gen.ι
  have _ : AlgebraicGeometry.IsOpenImmersion j_W₀ := by
    dsimp [j_W₀]; infer_instance
  let η_cur : AlgebraicGeometry.Spec (CommRingCat.of F_ss) ⟶ C_cur :=
    AlgebraicGeometry.Spec.map φ₀ ≫ j_W₀
  have hη_cur : η_cur ≫ f_ss_cur = η_ss := by
    calc
      (AlgebraicGeometry.Spec.map φ₀ ≫ (i_W₀ ≫ e_gen.inv ≫ V_gen.ι)) ≫ f_ss_cur
          = AlgebraicGeometry.Spec.map φ₀ ≫ i_W₀ ≫ e_gen.inv ≫ (V_gen.ι ≫ f_ss_cur) := by
            simp only [CategoryTheory.Category.assoc]
      _ = AlgebraicGeometry.Spec.map φ₀ ≫ i_W₀ ≫ e_gen.inv ≫ (e_gen.hom ≫ U_gen.ι) := by
            rw [← hpb_gen]; rfl
      _ = AlgebraicGeometry.Spec.map φ₀ ≫ i_W₀ ≫ U_gen.ι := by
            rw [e_gen.inv_hom_id_assoc]
      _ = AlgebraicGeometry.Spec.map φ₀ ≫ hW₀.fromSpec := by rw [hi_W₀]
      _ = η_ss := hφ₀
  have hFunc_cur : IsSchemeFunctionField C_cur F_ss η_cur := by
    intro U hU hUne
    let R_U_cat := C_cur.presheaf.obj (Opposite.op U)
    let R_U : Type u := ↑R_U_cat
    have _ : IsDomain R_U := (hNorm_cur U hU hUne).1
    have hIrred_cur : IrreducibleSpace ↥C_cur :=
      @AlgebraicGeometry.irreducibleSpace_of_isIntegral C_cur hSS_cur.1
    let p_W₀ : ↥(AlgebraicGeometry.Spec R₀_cat) := hW₀.primeIdealOf ⟨u₀_gen, hu₀_W₀⟩
    obtain ⟨⟨u_pt, hu_pt⟩⟩ := hUne
    have hInter : (Set.univ ∩ ((U : Set ↥C_cur) ∩ (j_W₀.opensRange : Set ↥C_cur))).Nonempty :=
      (@IrreducibleSpace.isIrreducible_univ ↥C_cur _ hIrred_cur).2
        (U : Set ↥C_cur) (j_W₀.opensRange : Set ↥C_cur) U.isOpen j_W₀.opensRange.isOpen
        ⟨u_pt, trivial, hu_pt⟩ ⟨j_W₀.base p_W₀, trivial, ⟨p_W₀, rfl⟩⟩
    rw [Set.univ_inter] at hInter
    rcases hInter with ⟨z₀, hz₀_U, p₀, hp₀_z₀⟩
    obtain ⟨d, hd_le, hz₀_Ud⟩ :=
      @AlgebraicGeometry.IsAffineOpen.exists_basicOpen_le C_cur U hU j_W₀.opensRange
        ⟨z₀, ⟨p₀, hp₀_z₀⟩⟩ hz₀_U
    have hd_not_pU : d ∉ (hU.primeIdealOf ⟨z₀, hz₀_U⟩).asIdeal := by
      have hz_pre : hU.primeIdealOf ⟨z₀, hz₀_U⟩ ∈
          (TopologicalSpace.Opens.map hU.fromSpec.base).obj (C_cur.basicOpen d) := by
        change hU.fromSpec.base (hU.primeIdealOf ⟨z₀, hz₀_U⟩) ∈ C_cur.basicOpen d
        rw [hU.fromSpec_primeIdealOf]
        exact hz₀_Ud
      rwa [hU.fromSpec_preimage_basicOpen d] at hz_pre
    have hd_ne : d ≠ 0 :=
      fun hd0 => hd_not_pU (hd0 ▸ (hU.primeIdealOf ⟨z₀, hz₀_U⟩).asIdeal.zero_mem)
    let U_d : C_cur.Opens := C_cur.basicOpen d
    have hUd : AlgebraicGeometry.IsAffineOpen U_d := hU.basicOpen d
    have hUd_ne : Nonempty ↥U_d := ⟨⟨z₀, hz₀_Ud⟩⟩
    let R_Ud_cat := C_cur.presheaf.obj (Opposite.op U_d)
    let R_Ud : Type u := ↑R_Ud_cat
    have _ : IsDomain R_Ud := (hNorm_cur U_d hUd hUd_ne).1
    have _ : IsLocalization.Away d R_Ud := hU.isLocalization_basicOpen d
    let q₀ : ↥(AlgebraicGeometry.Spec R_Ud_cat) := hUd.primeIdealOf ⟨z₀, hz₀_Ud⟩
    have hRange_Ud : Set.range ⇑hUd.fromSpec.base ⊆ Set.range ⇑j_W₀.base := by
      rw [hUd.range_fromSpec, ← j_W₀.coe_opensRange]
      exact hd_le
    let k_d : AlgebraicGeometry.Spec R_Ud_cat ⟶ AlgebraicGeometry.Spec R₀_cat :=
      AlgebraicGeometry.IsOpenImmersion.lift j_W₀ hUd.fromSpec hRange_Ud
    have hk_d : k_d ≫ j_W₀ = hUd.fromSpec :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac j_W₀ hUd.fromSpec hRange_Ud
    have _ : AlgebraicGeometry.IsOpenImmersion (k_d ≫ j_W₀) := by
      rw [hk_d]; infer_instance
    have _ : AlgebraicGeometry.IsOpenImmersion k_d :=
      AlgebraicGeometry.IsOpenImmersion.of_comp k_d j_W₀
    let α_d : R₀_cat ⟶ R_Ud_cat := AlgebraicGeometry.Spec.preimage k_d
    have hSpec_αd : AlgebraicGeometry.Spec.map α_d = k_d :=
      AlgebraicGeometry.Spec.map_preimage k_d
    have hbot_mem : (⊥ : PrimeSpectrum R₀) ∈ k_d.opensRange := by
      by_contra hnot
      have hcl : IsClosed ((k_d.opensRange : Set ↥(AlgebraicGeometry.Spec R₀_cat))ᶜ) :=
        k_d.opensRange.isOpen.isClosed_compl
      have hsub : closure ({(⊥ : PrimeSpectrum R₀)} : Set ↥(AlgebraicGeometry.Spec R₀_cat)) ⊆
          (k_d.opensRange : Set ↥(AlgebraicGeometry.Spec R₀_cat))ᶜ :=
        closure_minimal (Set.singleton_subset_iff.mpr hnot) hcl
      have hle : (⊥ : PrimeSpectrum R₀) ≤ k_d.base q₀ := bot_le
      exact hsub ((PrimeSpectrum.le_iff_mem_closure (⊥ : PrimeSpectrum R₀) (k_d.base q₀)).mp hle)
        ⟨q₀, rfl⟩
    obtain ⟨B_r₀, ⟨r₀, rfl⟩, hbot_r₀, hr₀_le⟩ :=
      (TopologicalSpace.Opens.isBasis_iff_nbhd.mp PrimeSpectrum.isBasis_basic_opens) hbot_mem
    have hr₀_not_bot : r₀ ∉ (⊥ : PrimeSpectrum R₀).asIdeal := hbot_r₀
    have hr₀_ne : r₀ ≠ 0 := fun h0 => hr₀_not_bot (h0 ▸ Ideal.zero_mem ⊥)
    obtain ⟨q_bot, hq_bot⟩ :
        ∃ q_bot : ↥(AlgebraicGeometry.Spec R_Ud_cat), k_d.base q_bot = (⊥ : PrimeSpectrum R₀) :=
      hbot_mem
    let d₁ : R_Ud := α_d.hom r₀
    have hd₁_not_q : d₁ ∉ q_bot.asIdeal := by
      intro hd₁_in
      have hk_eq : (k_d.base q_bot).asIdeal = Ideal.comap α_d.hom q_bot.asIdeal := by
        rw [← hSpec_αd]; rfl
      apply hr₀_not_bot
      rw [← hq_bot, hk_eq]
      exact hd₁_in
    have hd₁_ne : d₁ ≠ 0 := fun h0 => hd₁_not_q (h0 ▸ q_bot.asIdeal.zero_mem)
    let f_d₁ : R_Ud_cat ⟶ CommRingCat.of (Localization.Away d₁) :=
      CommRingCat.ofHom (algebraMap R_Ud (Localization.Away d₁))
    let f_r₀ : R₀_cat ⟶ CommRingCat.of (Localization.Away r₀) :=
      CommRingCat.ofHom (algebraMap R₀ (Localization.Away r₀))
    have _ : AlgebraicGeometry.IsOpenImmersion (AlgebraicGeometry.Spec.map f_d₁) :=
      @AlgebraicGeometry.IsOpenImmersion.of_isLocalization R_Ud (Localization.Away d₁) _ _ _ d₁
        inferInstance
    have _ : AlgebraicGeometry.IsOpenImmersion (AlgebraicGeometry.Spec.map f_r₀) :=
      @AlgebraicGeometry.IsOpenImmersion.of_isLocalization R₀ (Localization.Away r₀) _ _ _ r₀
        inferInstance
    let ι₁ : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away d₁)) ⟶
