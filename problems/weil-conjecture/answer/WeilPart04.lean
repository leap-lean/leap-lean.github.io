            = φ_z.hom (ψ_z (Polynomial.C π_b)) *
                ((φ_z.hom b_z / φ_z.hom (ψ_z (Polynomial.C π_b))) * φ_z.hom s_z) := by
              field_simp [hπ_Fz_ne]
        _ = φ_z.hom (ψ_z (Polynomial.C π_b)) * φ_z.hom w_z := by rw [h_sz_eq_F]
    let 𝔪_z : Ideal B_z := (hVz_aff.isoSpec.hom.base ⟨j_Z.base z, hz_mem⟩).asIdeal
    have h𝔪z_prime : 𝔪_z.IsPrime := (hVz_aff.isoSpec.hom.base ⟨j_Z.base z, hz_mem⟩).isPrime
    have h𝔔z_le_𝔪z : Ideal.map (ψ_z.comp Polynomial.C) (IsLocalRing.maximalIdeal R_P) ≤ 𝔪_z := by
      rw [Ideal.map_le_iff_le_comap]
      have h_pt_g : (V_z.ι ≫ g_X0).base ⟨j_Z.base z, hz_mem⟩ = 𝔪_RP := by
        change (j_Z ≫ g_X0).base z = 𝔪_RP
        rw [hj_comm]
        apply PrimeSpectrum.ext
        have h_sub_pt : (p_Z.base z : PrimeSpectrum κ_P) = (⊥ : PrimeSpectrum κ_P) :=
          Subsingleton.elim _ _
        change Ideal.comap q_R (p_Z.base z : PrimeSpectrum κ_P).asIdeal =
          IsLocalRing.maximalIdeal R_P
        rw [h_sub_pt]
        exact hq_ker
      have h_eq : (hVz_aff.isoSpec.hom ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_z.comp Polynomial.C))).base
            ⟨j_Z.base z, hz_mem⟩ = 𝔪_RP := by
        rw [← hVz_g]
        exact h_pt_g
      exact (congrArg PrimeSpectrum.asIdeal h_eq).ge
    obtain ⟨u_z, q_z, hu_z, h_uz_bz⟩ :=
      hCrux2 B_z ψ_z hψz_etale h𝔔z_prime 𝔪_z h𝔪z_prime h𝔔z_le_𝔪z
        π_b hπ_max hπ_ne s_z b_z w_z hs_z h_sz_bz
    refine ⟨V_z, hVz_aff, hz_mem, u_z, q_z, hu_z, ?_⟩
    rw [← hψ_C_eq hVz_aff ψ_z hVz_g π_b]
    exact h_uz_bz
  exact False.elim
    (weil_p1_regular_quotient_gluing_section_contradiction R_P κ_P q_R hq_surj hq_ker
      X_0.toScheme Z_sch g_X0 p_Z hp_bij j_Z hj_comm σ_0 hσ0_sec z_0 hz0_eq
      π_b hπ_max hπ_ne b hb_σ0 V_0 hV0_aff z_η hzη_0 s_0 w_0 hs0_η hw0_η h_gen_s8 h_reg)

theorem weil_local_relative_stability_closedPoint_dichotomy (K : Type u) [Field K] [IsSepClosed K]
    (m : ℕ) (V : ValuationSubring K) (hPkg : IsValuationRingAlgPackage m V)
    (hMaxNeBot : IsLocalRing.maximalIdeal ↥V ≠ ⊥)
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (n : ℕ) (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (hIntCK : AlgebraicGeometry.IsIntegral C_K)
    (hPropCK : AlgebraicGeometry.IsProper p_K)
    (hSmCK : AlgebraicGeometry.SmoothOfRelativeDimension 1 p_K)
    (hStabCK : IsGeometricStablePointedCurve p_K n σ_K)
    (C' : AlgebraicGeometry.Scheme.{u})
    (g' : C' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (τ' : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C'))
    (ι' : C_K ⟶ C')
    (hMod' : IsValuationPointedCurveModel V p_K n σ_K C' g' τ' ι')
    (U' : C'.Opens) (hU' : Nonempty ↥U')
    (U_ss : AlgebraicGeometry.Scheme.{u})
    (g_ss : U_ss ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (hAff_ss : AlgebraicGeometry.IsAffine U_ss)
    (hSS : IsStrictlySemistableCurveOverValuation V g_ss)
    (h_mod : U'.toScheme ⟶ U_ss)
    (hProp_mod : AlgebraicGeometry.IsProper h_mod)
    (hComm_mod : h_mod ≫ g_ss = U'.ι ≫ g')
    (ι_U' : AlgebraicGeometry.Scheme.Opens.toScheme
      ((TopologicalSpace.Opens.map ι'.base).obj U') ⟶ U'.toScheme)
    (hι_comm : ι_U' ≫ U'.ι =
      AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj U') ≫ ι')
    (hPb_U' : CategoryTheory.IsPullback ι_U'
      (AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj U') ≫ p_K)
      (U'.ι ≫ g')
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (hPb_ss : CategoryTheory.IsPullback (ι_U' ≫ h_mod)
      (AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj U') ≫ p_K)
      g_ss
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (C_cur : AlgebraicGeometry.Scheme.{u})
    (g_cur : C_cur ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (f_dom_cur : C_cur ⟶ U'.toScheme)
    (τ_cur : ∀ j : Fin n,
      AlgebraicGeometry.Scheme.Opens.toScheme
        ((TopologicalSpace.Opens.map (τ' j).base).obj U') ⟶ C_cur)
    (ι_cur : AlgebraicGeometry.Scheme.Opens.toScheme
      ((TopologicalSpace.Opens.map ι'.base).obj U') ⟶ C_cur)
    (hRes_cur : IsResolvedLocalStrictlySemistableMod V p_K g' n τ' ι' U' h_mod ι_U'
      C_cur g_cur f_dom_cur τ_cur ι_cur) :
    (∀ Q : PrimeSpectrum ↥V,
      (irreducibleComponents ↥(CategoryTheory.Limits.pullback g_cur
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap ↥V Q.asIdeal.ResidueField))))).Finite) ∧
    (IsLocalRelativeStableMod V p_K g' n τ' ι' U' ι_U' C_cur g_cur f_dom_cur τ_cur ι_cur ∨
      ∃ (P : PrimeSpectrum ↥V) (x₀ : ↥U'.toScheme)
        (Z : Set ↥(CategoryTheory.Limits.pullback g_cur
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap ↥V P.asIdeal.ResidueField))))),
        IsClosedPointRelExceptionalDatum V g' n τ' U' g_cur f_dom_cur τ_cur P x₀ Z) :=
by
  obtain ⟨hFinFib, hStab | ⟨Q, x_Q, E_Q, hExc_Q⟩⟩ :=
    weil_strictlySemistable_mod_fiber_finite_and_geom_descent K m V hPkg C_K p_K n σ_K
      C' g' τ' ι' hMod' U' U_ss g_ss hAff_ss h_mod ι_U' hPb_U'
      C_cur g_cur f_dom_cur τ_cur ι_cur hRes_cur
  · exact ⟨hFinFib, Or.inl hStab⟩
  · refine ⟨hFinFib, Or.inr ?_⟩
    obtain ⟨P, x₀, k, Q_seq, x_seq, hP_ne, hx₀_cl, hx₀_P, hQ0, hx0, hQk, hxk, hStep⟩ :=
      weil_valuation_model_section_closedPoint_and_step_closure K m V hPkg C_K p_K n σ_K
        C' g' τ' ι' hMod' U' U_ss h_mod ι_U' C_cur g_cur f_dom_cur τ_cur ι_cur hRes_cur
        hFinFib Q x_Q E_Q hExc_Q
    have hChain : ∀ (ν : ℕ) (hν : ν ≤ k),
        ∃ (E_ν : Set ↥(CategoryTheory.Limits.pullback g_cur
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom
                (algebraMap ↥V (Q_seq ⟨ν, Nat.lt_succ_of_le hν⟩).asIdeal.ResidueField))))),
          IsFiberRelExceptionalP1 V g' n τ' U' g_cur f_dom_cur τ_cur
            (Q_seq ⟨ν, Nat.lt_succ_of_le hν⟩) (x_seq ⟨ν, Nat.lt_succ_of_le hν⟩) E_ν := by
      intro ν
      induction ν with
      | zero =>
        intro hν
        change ∃ E_0, IsFiberRelExceptionalP1 V g' n τ' U' g_cur f_dom_cur τ_cur
          (Q_seq 0) (x_seq 0) E_0
        rw [hQ0, hx0]
        exact ⟨E_Q, hExc_Q⟩
      | succ ν ih =>
        intro hν
        obtain ⟨E_cur, hExc_cur⟩ := ih (Nat.le_of_succ_le hν)
        let ν_fin : Fin k := ⟨ν, hν⟩
        obtain ⟨W₀, ℰ, g_ℰ, hQν_ne, hMax_W₀, hRank1_W₀, hSS_ℰ, hProp_ℰ, hGenP1,
            S_ext, hS_fin, hS_le2, hS_uniq, hLift⟩ :=
          hStep ν_fin E_cur hExc_cur
        have hAlgL : IsAlgClosed (Q_seq ν_fin.castSucc).asIdeal.ResidueField :=
          hPkg.2.2.2.2.1 (Q_seq ν_fin.castSucc).asIdeal hQν_ne
        obtain ⟨_hNe_T₀, _hFin_T₀, hAllP1_T₀, hPick⟩ :=
          @weil_rankOne_algClosed_p1_semistable_model_is_tree
            (Q_seq ν_fin.castSucc).asIdeal.ResidueField _ hAlgL
            W₀ hMax_W₀ hRank1_W₀ ℰ g_ℰ hSS_ℰ hProp_ℰ hGenP1
        obtain ⟨Z_T, hZT_mem, hΔint_fin, hDeg_ZT⟩ :=
          hPick S_ext hS_fin hS_le2 hS_uniq
        exact hLift Z_T hZT_mem (hAllP1_T₀ Z_T hZT_mem) hΔint_fin hDeg_ZT
    have hAtLast : ∃ Z, IsFiberRelExceptionalP1 V g' n τ' U' g_cur f_dom_cur τ_cur
        (Q_seq (Fin.last k)) (x_seq (Fin.last k)) Z :=
      hChain k le_rfl
    rw [hQk, hxk] at hAtLast
    obtain ⟨Z, _hP_ne', _hx₀_P', hZ_mem, hZ_P1, hZ_contr, _hΔZ_fin, hSum_Z⟩ := hAtLast
    have hOpenη : AlgebraicGeometry.IsOpenImmersion
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)) := by
      classical
      let S_nz : Finset (PrimeSpectrum ↥V) :=
        hPkg.1.toFinset.filter (fun R_p => R_p.asIdeal ≠ ⊥)
      have hex_elem : ∀ R_p ∈ S_nz, ∃ x : ↥V, x ∈ R_p.asIdeal ∧ x ≠ 0 := by
        intro R_p hRp
        have hne : R_p.asIdeal ≠ ⊥ := (Finset.mem_filter.mp hRp).2
        by_contra! hall0
        apply hne
        rw [eq_bot_iff]
        intro x hx
        rw [Ideal.mem_bot]
        exact hall0 x hx
      choose f_nz hf_nz using hex_elem
      let s₀ : ↥V := ∏ R_p ∈ S_nz.attach, f_nz R_p.1 R_p.2
      have hs₀_ne : s₀ ≠ 0 :=
        Finset.prod_ne_zero_iff.mpr (fun R_p _ => (hf_nz R_p.1 R_p.2).2)
      let _ : Algebra ↥V K := V.subtype.toAlgebra
      have hLoc : IsLocalization.Away s₀ K := by
        refine IsLocalization.Away.mk s₀ ?_ ?_ ?_
        · exact IsUnit.mk0 (V.subtype s₀) (fun h => hs₀_ne (Subtype.val_injective h))
        · intro z
          by_cases hzV : z ∈ V
          · exact ⟨0, ⟨z, hzV⟩, by simp; rfl⟩
          · have hz0 : z ≠ 0 := fun h => hzV (h ▸ V.zero_mem)
            have hz_inv : z⁻¹ ∈ V := (ValuationSubring.mem_or_inv_mem V z).resolve_left hzV
            let w : ↥V := ⟨z⁻¹, hz_inv⟩
            have hw_ne : w ≠ 0 := fun h => inv_ne_zero hz0 (congrArg Subtype.val h)
            have hs₀_rad : s₀ ∈ (Ideal.span ({w} : Set ↥V)).radical := by
              rw [Ideal.radical_eq_sInf]
              simp only [Ideal.mem_sInf, Set.mem_ofPred_eq, Ideal.span_singleton_le_iff_mem]
              rintro I ⟨hwI, hI_prime⟩
              have hI_ne : I ≠ ⊥ := by
                intro hbot
                rw [hbot, Ideal.mem_bot] at hwI
                exact hw_ne hwI
              let R_I : PrimeSpectrum ↥V := ⟨I, hI_prime⟩
              have hRI_mem : R_I ∈ S_nz := by simp [S_nz, R_I, hI_ne]
              have hdvd : f_nz R_I hRI_mem ∣ s₀ :=
                Finset.dvd_prod_of_mem _ (Finset.mem_attach _ ⟨R_I, hRI_mem⟩)
              rcases hdvd with ⟨q_mul, hq_mul⟩
              rw [hq_mul]
              exact Ideal.mul_mem_right q_mul I (hf_nz R_I hRI_mem).1
            rw [Ideal.mem_radical_iff] at hs₀_rad
            obtain ⟨r_exp, hr_exp⟩ := hs₀_rad
            rw [Ideal.mem_span_singleton] at hr_exp
            obtain ⟨c, hc⟩ := hr_exp
            refine ⟨r_exp, c, ?_⟩
            have hval : (s₀ : K) ^ r_exp = z⁻¹ * (c : K) := by
              have := congrArg Subtype.val hc
              simpa [w] using this
            calc z * V.subtype s₀ ^ r_exp
                = z * (z⁻¹ * (c : K)) := by
                  change z * (s₀ : K) ^ r_exp = z * (z⁻¹ * (c : K))
                  rw [hval]
              _ = V.subtype c := by
                  rw [← mul_assoc, mul_inv_cancel₀ hz0, one_mul]
                  rfl
        · intro x y hxy
          exact ⟨0, by simp [Subtype.val_injective hxy]⟩
      exact AlgebraicGeometry.IsOpenImmersion.of_isLocalization (S := K) s₀
    have hOpen_ι' : AlgebraicGeometry.IsOpenImmersion ι' :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        hMod'.2.2.2.2.2.2.2.1.flip hOpenη
    have hOpenRange : IsOpen (Set.range ι'.base) := by
      have := hOpen_ι'
      exact ι'.isOpenEmbedding.isOpen_range
    have hIrredCK : IrreducibleSpace ↥C_K :=
      @AlgebraicGeometry.irreducibleSpace_of_isIntegral C_K hIntCK
    obtain ⟨y₀⟩ := hIrredCK.toNonempty
    have hRange_ne : (Set.range ι'.base).Nonempty := ⟨ι'.base y₀, y₀, rfl⟩
    have hIrredC' : IrreducibleSpace ↥C' :=
      @AlgebraicGeometry.irreducibleSpace_of_isIntegral C' hMod'.1
    have : PreirreducibleSpace ↥C' := hIrredC'.toPreirreducibleSpace
    obtain ⟨u₀_pt⟩ := hU'
    have hU'_ne : (U' : Set ↥C').Nonempty := ⟨u₀_pt.1, u₀_pt.2⟩
    obtain ⟨w, hw_inter⟩ :=
      nonempty_preirreducible_inter U'.isOpen hOpenRange hU'_ne hRange_ne
    obtain ⟨hwU', z_K, rfl⟩ := hw_inter
    have hUK : Nonempty ↥((TopologicalSpace.Opens.map ι'.base).obj U') := ⟨⟨z_K, hwU'⟩⟩
    obtain ⟨f_ss_cur, hf_ss, hProp_fss⟩ := hRes_cur.2.2.2.1
    have hProp_fss' : AlgebraicGeometry.IsProper (f_dom_cur ≫ h_mod) := by
      rw [hf_ss]; exact hProp_fss
    have hComm_fss : (f_dom_cur ≫ h_mod) ≫ g_ss = g_cur := by
      rw [CategoryTheory.Category.assoc, hComm_mod]
      exact hRes_cur.2.2.1
    have hι_fss : ι_cur ≫ (f_dom_cur ≫ h_mod) = ι_U' ≫ h_mod := by
      rw [← CategoryTheory.Category.assoc, hRes_cur.2.2.2.2.1]
    have hZ_u₀ : ∀ q ∈ Z,
        (f_dom_cur ≫ h_mod).base ((CategoryTheory.Limits.pullback.fst g_cur
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap ↥V P.asIdeal.ResidueField)))).base q) =
          h_mod.base x₀ := by
      intro q hq
      change h_mod.base (f_dom_cur.base _) = h_mod.base x₀
      exact congrArg h_mod.base (hZ_contr q hq)
    have h1_le_Δ : 1 ≤ {q ∈ Z | ∃ E' ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g_cur
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap ↥V P.asIdeal.ResidueField)))),
        E' ≠ Z ∧ q ∈ E'}.ncard :=
      weil_strictlySemistable_contracted_p1_boundary_nonempty K m V hPkg C_K p_K
        ((TopologicalSpace.Opens.map ι'.base).obj U') hUK U_ss C_cur g_ss g_cur
        (f_dom_cur ≫ h_mod) (ι_U' ≫ h_mod) ι_cur hAff_ss hSS hRes_cur.1
        hProp_fss' hComm_fss hι_fss hPb_ss hRes_cur.2.2.2.2.2.1
        P hP_ne (h_mod.base x₀) (hFinFib P) Z hZ_mem hZ_P1 hZ_u₀
    refine ⟨P, x₀, Z, hP_ne, hx₀_cl, hx₀_P, hZ_mem, hZ_P1, hZ_contr, h1_le_Δ, ?_, ?_, ?_⟩
    · omega
    · intro h2 j q hq hmem
      let s_P := AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap ↥V P.asIdeal.ResidueField))
      let M_Z : Set (Fin n) :=
        {j' : Fin n | ∃ q' ∈ Z,
          (CategoryTheory.Limits.pullback.fst g_cur s_P).base q' ∈ Set.range (τ_cur j').base}
      have hj : j ∈ M_Z := ⟨q, hq, hmem⟩
      have hpos : 0 < M_Z.ncard := Set.Nonempty.ncard_pos M_Z.toFinite ⟨j, hj⟩
      change _ + M_Z.ncard ≤ 2 at hSum_Z
      omega
    · intro h1
      let s_P := AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap ↥V P.asIdeal.ResidueField))
      let M_Z : Set (Fin n) :=
        {j' : Fin n | ∃ q' ∈ Z,
          (CategoryTheory.Limits.pullback.fst g_cur s_P).base q' ∈ Set.range (τ_cur j').base}
      change _ + M_Z.ncard ≤ 2 at hSum_Z
      have hle1 : M_Z.ncard ≤ 1 := by omega
      exact Set.ncard_le_one_iff_subsingleton.mp hle1

theorem weil_normal_contraction_domination_factorization (K : Type u) [Field K]
    (m : ℕ) (V : ValuationSubring K) (hPkg : IsValuationRingAlgPackage m V)
    (hOpenη : AlgebraicGeometry.IsOpenImmersion
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (n : ℕ) (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (hIntCK : AlgebraicGeometry.IsIntegral C_K)
    (hSmCK : AlgebraicGeometry.SmoothOfRelativeDimension 1 p_K)
    (C' : AlgebraicGeometry.Scheme.{u})
    (g' : C' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (τ' : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C'))
    (ι' : C_K ⟶ C')
    (hMod' : IsValuationPointedCurveModel V p_K n σ_K C' g' τ' ι')
    (U' : C'.Opens) (hU' : Nonempty ↥U')
    (U_ss : AlgebraicGeometry.Scheme.{u})
    (g_ss : U_ss ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (hAff_ss : AlgebraicGeometry.IsAffine U_ss)
    (hSS : IsStrictlySemistableCurveOverValuation V g_ss)
    (h_mod : U'.toScheme ⟶ U_ss)
    (hProp_mod : AlgebraicGeometry.IsProper h_mod)
    (hComm_mod : h_mod ≫ g_ss = U'.ι ≫ g')
    (ι_U' : AlgebraicGeometry.Scheme.Opens.toScheme
      ((TopologicalSpace.Opens.map ι'.base).obj U') ⟶ U'.toScheme)
    (hPb_U' : CategoryTheory.IsPullback ι_U'
      (AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj U') ≫ p_K)
      (U'.ι ≫ g')
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (C_cur : AlgebraicGeometry.Scheme.{u})
    (g_cur : C_cur ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (f_dom_cur : C_cur ⟶ U'.toScheme)
    (ι_cur : AlgebraicGeometry.Scheme.Opens.toScheme
      ((TopologicalSpace.Opens.map ι'.base).obj U') ⟶ C_cur)
    (hSS_cur : IsStrictlySemistableCurveOverValuation V g_cur)
    (hNorm_cur : IsAffineNormalScheme C_cur)
    (hProp_fdom : AlgebraicGeometry.IsProper f_dom_cur)
    (hfdom_g : f_dom_cur ≫ U'.ι ≫ g' = g_cur)
    (hι_fdom : ι_cur ≫ f_dom_cur = ι_U')
    (hPb_cur : CategoryTheory.IsPullback ι_cur
      (AlgebraicGeometry.Scheme.Opens.ι ((TopologicalSpace.Opens.map ι'.base).obj U') ≫ p_K)
      g_cur
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (F_cur : Type u) [Field F_cur]
    (η_cur : AlgebraicGeometry.Spec (CommRingCat.of F_cur) ⟶ C_cur)
    (hFunc_cur : IsSchemeFunctionField C_cur F_cur η_cur)
    (C_next : AlgebraicGeometry.Scheme.{u})
    (g_next : C_next ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (f_ss_next : C_next ⟶ U_ss)
    (q_contr : C_cur ⟶ C_next)
    (M_contr : Set ↥C_next)
    (hM_cl : IsClosed M_contr)
    (hSS_next : IsStrictlySemistableCurveOverValuation V g_next)
    (hNorm_next : IsAffineNormalScheme C_next)
    (hProp_q : AlgebraicGeometry.IsProper q_contr)
    (hSurj_q : AlgebraicGeometry.Surjective q_contr)
    (hq_g : q_contr ≫ g_next = g_cur)
    (hq_fss : q_contr ≫ f_ss_next = f_dom_cur ≫ h_mod)
    (hIso_q : CategoryTheory.IsIso (q_contr ∣_ (⟨M_contrᶜ, hM_cl.isOpen_compl⟩ : C_next.Opens)))
    (hSub_fib : ∀ Q : PrimeSpectrum ↥V,
      (f_dom_cur.base '' (q_contr.base ⁻¹' M_contr ∩ g_cur.base ⁻¹' {Q})).Subsingleton) :
    ∃ f_dom_next : C_next ⟶ U'.toScheme,
      q_contr ≫ f_dom_next = f_dom_cur ∧
      AlgebraicGeometry.IsProper f_dom_next :=
by
  
