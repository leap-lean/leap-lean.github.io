      have hc_qy : C₀ c ∉ q_y := by
        intro hc_mem
        apply hs_qy
        rw [map_mul]
        exact Ideal.mul_mem_right (C₀ u) q_y hc_mem
      have hprod_u : C₀ c * (C₀ u * t - 1) ∈ q_y := by
        have heq : C₀ c * (C₀ u * t - 1) = C₀ (c * u) * t - C₀ c := by
          rw [map_mul]
          ring
        rw [heq]
        exact hrel_A
      have hut_qy : C₀ u * t - 1 ∈ q_y :=
        (‹q_y.IsPrime›.mem_or_mem hprod_u).resolve_left hc_qy
      have hut_m₀ : C₀ u * t - 1 ∈ m₀ := hq_y_le hut_qy
      have hmul_m₀ : C₀ u * t ∈ m₀ := Ideal.mul_mem_left m₀ (C₀ u) (hG₀_m₀ ht)
      have hone_m₀ : (1 : A₀) ∈ m₀ := by
        have hsub := m₀.sub_mem hmul_m₀ hut_m₀
        simpa only [sub_sub_cancel] using hsub
      exact Ideal.IsPrime.one_notMem ‹m₀.IsPrime› hone_m₀

theorem weil_henselian_etale_quotient_singleton_fiber_away (A₀ B₁ : Type u) [CommRing A₀] [CommRing B₁]
    (ψ : A₀ →+* B₁) (hEt : ψ.Etale)
    (p₀ : Ideal B₁) [p₀.IsPrime]
    (hRes_p₀ : ∀ b : B₁, ∃ a : A₀, b - ψ a ∈ p₀)
    (q : Ideal A₀) [q.IsPrime]
    (hq_le : q ≤ Ideal.comap ψ p₀)
    [HenselianLocalRing (A₀ ⧸ q)]
    (hMax_q : Ideal.comap (Ideal.Quotient.mk q) (IsLocalRing.maximalIdeal (A₀ ⧸ q)) =
      Ideal.comap ψ p₀) :
    ∃ (h : B₁), h ∉ p₀ ∧
      ∀ (g : B₁), g ∉ p₀ →
        ∀ (p₁ p₂ : PrimeSpectrum B₁),
          h * g ∉ p₁.asIdeal →
          h * g ∉ p₂.asIdeal →
          Ideal.comap ψ p₁.asIdeal = q →
          Ideal.comap ψ p₂.asIdeal = q →
          p₁ = p₂ :=
by
  classical
  have hpow_notMem : ∀ {T : Type u} [CommRing T] {J : Ideal T} (hJ : J.IsPrime) {x : T} (n : ℕ),
      x ∉ J → x ^ n ∉ J := by
    intro T _ J hJ x n hx
    induction n with
    | zero => rw [pow_zero]; exact hJ.one_notMem
    | succ n ih => rw [pow_succ]; exact hJ.mul_notMem ih hx
  have hEtQuot : ∀ {A B : Type u} [CommRing A] [CommRing B] [Algebra A B] [Algebra.Etale A B]
      (I : Ideal A),
      letI : Algebra (A ⧸ I) (B ⧸ Ideal.map (algebraMap A B) I) :=
        Ideal.Quotient.algebraQuotientOfLEComap Ideal.le_comap_map
