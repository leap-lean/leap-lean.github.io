  obtain ⟨θ₀, hEt_θ₀, hθ₀_mk⟩ := h_s2
  let J₀ : Ideal ↑B₀ := Ideal.map ψ₀.hom I_sec
  have hI_sec_pz : I_sec ≤ Ideal.comap ψ₀.hom p_z.asIdeal := by
    intro f hf
