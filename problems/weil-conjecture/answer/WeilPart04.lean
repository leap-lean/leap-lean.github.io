      let F_M : Finset (PrimeSpectrum D_y) := hFin_SM.toFinset
      have hex_ne : ∀ q : PrimeSpectrum D_y, q ∈ F_M → ∃ a : D_y, a ∈ q.asIdeal ∧ a ≠ 0 := by
        intro q hqF
        have hqM : q.asIdeal ∈ M := hFin_SM.mem_toFinset.mp hqF
        have hqMax : q.asIdeal.IsMaximal := (hM_max q.asIdeal hqM).resolve_right q.isPrime.ne_top
