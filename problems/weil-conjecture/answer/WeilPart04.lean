        rw [← mul_assoc, ← Polynomial.C_mul, hus, map_mul, map_pow,
          Polynomial.coe_mapRingHom, Polynomial.map_C, Polynomial.map_X]
  have hNoChainNodal : ∀ (a : ↥V)
      (r₀ r₁ r₂ : PrimeSpectrum (MvPolynomial (Fin 2) ↥V ⧸
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a})),
      r₀ < r₁ → r₁ < r₂ →
      PrimeSpectrum.comap ((Ideal.Quotient.mk _).comp MvPolynomial.C) r₀ = Q →
      PrimeSpectrum.comap ((Ideal.Quotient.mk _).comp MvPolynomial.C) r₁ = Q →
      PrimeSpectrum.comap ((Ideal.Quotient.mk _).comp MvPolynomial.C) r₂ = Q → False := by
    intro a
    let I_a : Ideal (MvPolynomial (Fin 2) ↥V) :=
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}
    let M₀ := MvPolynomial (Fin 2) ↥V ⧸ I_a
    let c₀ : ↥V →+* M₀ := (Ideal.Quotient.mk I_a).comp MvPolynomial.C
    let abar : k_Q := κ_Q a
