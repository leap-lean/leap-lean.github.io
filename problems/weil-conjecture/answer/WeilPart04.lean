          simp [g_mv_alg]
        have hg_X₀_unit : IsUnit (g_nod X0_bar) := by
          rw [hg_X0_eq]
          exact IsLocalization.map_units L_pol ⟨T_pol, Submonoid.mem_powers T_pol⟩
        let f_to : L_nod →+* L_pol := IsLocalization.Away.lift X0_bar hg_X₀_unit
        let h_pol : Polynomial ↥V →+* L_nod :=
          Polynomial.eval₂RingHom
            ((algebraMap (MvPolynomial (Fin 2) ↥V ⧸ I_nod) L_nod).comp
