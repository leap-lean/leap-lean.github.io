          (g_X' : X' ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
          (p_c : X_c ⟶ U_ss) (f : X' ⟶ X_c)
          (η_c : AlgebraicGeometry.Spec (CommRingCat.of F_ss) ⟶ X_c)
          (ι_c : U_K.toScheme ⟶ X_c) (U_iso : X_c.Opens),
        AlgebraicGeometry.IsProper f →
        f ≫ g_c = g_X' →
        p_c ≫ g_ss = g_c →
        η_c ≫ p_c = η_ss →
        CategoryTheory.IsPullback ι_c (U_K.ι ≫ p_K) g_c
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)) →
        CategoryTheory.IsIso (f ∣_ U_iso) →
        (∀ x : X_c, (g_c.base x).asIdeal = ⊥ → x ∈ U_iso) →
        ∃ (η_X' : AlgebraicGeometry.Spec (CommRingCat.of F_ss) ⟶ X')
          (ι_X' : U_K.toScheme ⟶ X'),
          η_X' ≫ f = η_c ∧
          ι_X' ≫ f = ι_c ∧
          CategoryTheory.IsPullback ι_X' (U_K.ι ≫ p_K) g_X'
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)) ∧
          (∀ W : ValuationSubring F_ss,
            IsValResolvedOnMod V g_ss p_c η_c W →
            IsValResolvedOnMod V g_ss (f ≫ p_c) η_X' W) ∧
          (∀ (W : ValuationSubring F_ss)
              (ψ_c : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ X_c),
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype) ≫ ψ_c = η_c →
            ∃ ψ_X' : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ X',
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype) ≫ ψ_X' = η_X' ∧
              ψ_X' ≫ f = ψ_c)) ∧
      (∀ (X' : AlgebraicGeometry.Scheme.{u}) (p_X' : X' ⟶ U_ss)
          (η_X' : AlgebraicGeometry.Spec (CommRingCat.of F_ss) ⟶ X')
          (W : ValuationSubring F_ss)
          (ψ_X' : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ X')
          (mW : AlgebraicGeometry.Spec (CommRingCat.of ↥W))
          (V_sm' : X'.Opens)
          (e' : V_sm'.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial ↥V)))
          (ψ_V : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ V_sm'.toScheme)
          (q : ↥W),
        mW.asIdeal = IsLocalRing.maximalIdeal ↥W →
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype) ≫ ψ_X' = η_X' →
        ψ_V ≫ V_sm'.ι = ψ_X' →
        (AlgebraicGeometry.Spec.preimage (ψ_V ≫ e')).hom Polynomial.X = q →
        (∀ P : Polynomial ↥V,
          (∃ i : ℕ, P.coeff i ∉ (g_ss.base ((ψ_X' ≫ p_X').base mW)).asIdeal) →
          Polynomial.eval₂ (AlgebraicGeometry.Spec.preimage (ψ_X' ≫ p_X' ≫ g_ss)).hom
            q P ∉ IsLocalRing.maximalIdeal ↥W) →
        IsValResolvedOnMod V g_ss p_X' η_X' W) := by
    have hValLift : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Y₁ ⟶ Y₂)
        [AlgebraicGeometry.IsProper h] (W : ValuationSubring F_ss)
        (η₁ : AlgebraicGeometry.Spec (CommRingCat.of F_ss) ⟶ Y₁)
        (ψ₂ : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ Y₂),
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype) ≫ ψ₂ = η₁ ≫ h →
        ∃ ψ₁ : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ Y₁,
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype) ≫ ψ₁ = η₁ ∧
          ψ₁ ≫ h = ψ₂ := by
      intro Y₁ Y₂ h _ W η₁ ψ₂ hcomm
      have hUC : (AlgebraicGeometry.topologically @IsClosedMap).universally h := by
        rw [← AlgebraicGeometry.universallyClosed_eq]
        exact AlgebraicGeometry.IsProper.toUniversallyClosed
      have hSpec : (AlgebraicGeometry.topologically @SpecializingMap).universally h := by
        intro X' Y' i₁ i₂ f' hpb
        exact (hUC i₁ i₂ f' hpb).specializingMap
      have hEx : AlgebraicGeometry.ValuativeCriterion.Existence h :=
        AlgebraicGeometry.ValuativeCriterion.Existence.of_specializingMap h hSpec
      let _ : Algebra ↥W F_ss := W.subtype.toAlgebra
      have hFrac : IsFractionRing ↥W F_ss := ValuationSubring.instIsFractionRingSubtypeMem W
      let sq : AlgebraicGeometry.ValuativeCommSq h :=
        @AlgebraicGeometry.ValuativeCommSq.mk _ _ h ↥W _ _ _ F_ss _ _ hFrac η₁ ψ₂ ⟨hcomm.symm⟩
      obtain ⟨⟨l, hl₁, hl₂⟩⟩ := (CategoryTheory.CommSq.HasLift.iff _).mp (hEx sq)
      exact ⟨l, hl₁, hl₂⟩
    have hRange_val : ∀ {Y : AlgebraicGeometry.Scheme.{u}} (W : ValuationSubring F_ss)
        (ψ : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ Y)
        (mW : AlgebraicGeometry.Spec (CommRingCat.of ↥W))
        (U : Y.Opens),
        mW.asIdeal = IsLocalRing.maximalIdeal ↥W →
        ψ.base mW ∈ U →
        Set.range ⇑ψ ⊆ (U : Set Y) := by
      intro Y W ψ mW U hmW hmem y hy
      rcases hy with ⟨pt, rfl⟩
      have hmW_eq : (IsLocalRing.closedPoint ↥W : PrimeSpectrum ↥W) = mW :=
        PrimeSpectrum.ext hmW.symm
      have hspec_pt : (pt : PrimeSpectrum ↥W) ⤳ (mW : PrimeSpectrum ↥W) := by
        rw [← hmW_eq]
        exact IsLocalRing.specializes_closedPoint pt
      have hspec_Y : ψ.base pt ⤳ ψ.base mW := hspec_pt.map ψ.continuous
      exact specializes_iff_forall_open.mp hspec_Y (U : Set Y) U.2 hmem
    have hFactor_aff : ∀ {Y : AlgebraicGeometry.Scheme.{u}} (W : ValuationSubring F_ss)
        (ψ : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ Y)
        (mW : AlgebraicGeometry.Spec (CommRingCat.of ↥W))
        (U : Y.Opens) (hU : AlgebraicGeometry.IsAffineOpen U),
        mW.asIdeal = IsLocalRing.maximalIdeal ↥W →
        ψ.base mW ∈ U →
        ∃ φ_U : Y.presheaf.obj (Opposite.op U) ⟶ CommRingCat.of ↥W,
          AlgebraicGeometry.Spec.map φ_U ≫ hU.fromSpec = ψ := by
      intro Y W ψ mW U hU hmW hmem
      have hSub : Set.range ⇑ψ ⊆ Set.range ⇑hU.fromSpec := by
        intro y hy
        have hyU : y ∈ U := hRange_val W ψ mW U hmW hmem hy
        refine ⟨hU.isoSpec.hom.base ⟨y, hyU⟩, ?_⟩
        have h_id : (hU.isoSpec.hom ≫ hU.isoSpec.inv ≫ U.ι).base ⟨y, hyU⟩ = U.ι.base ⟨y, hyU⟩ := by
          rw [hU.isoSpec.hom_inv_id_assoc]
        rw [← hU.isoSpec_inv_ι]
        exact h_id
      let j := AlgebraicGeometry.IsOpenImmersion.lift hU.fromSpec ψ hSub
      refine ⟨AlgebraicGeometry.Spec.preimage j, ?_⟩
      rw [AlgebraicGeometry.Spec.map_preimage]
      exact AlgebraicGeometry.IsOpenImmersion.lift_fac hU.fromSpec ψ hSub
    have hGeneric_bot : ∀ pt : AlgebraicGeometry.Spec (CommRingCat.of F_ss),
        (g_ss.base (η_ss.base pt)).asIdeal = ⊥ := by
      intro pt
      have _ : AlgebraicGeometry.IsIntegral U_ss := hSS.1
      have _ : AlgebraicGeometry.Flat g_ss := hSS.2.1
      have hIrred : IrreducibleSpace ↥U_ss := AlgebraicGeometry.irreducibleSpace_of_isIntegral U_ss
      obtain ⟨y₀⟩ := hIrred.toNonempty
      obtain ⟨V_ss, hV_ss, hy₀, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := ⊤) (x := y₀) trivial
      have hNonemptyV : Nonempty ↥V_ss := ⟨⟨y₀, hy₀⟩⟩
      have hNonemptyV' : Nonempty ↥(V_ss : Set U_ss) := ⟨⟨y₀, hy₀⟩⟩
      obtain ⟨φ_ss, hFrac_ss, hη_eq⟩ := hFunc_ss V_ss hV_ss hNonemptyV
      let _ : Algebra ↑(U_ss.presheaf.obj (Opposite.op V_ss)) F_ss := φ_ss.hom.toAlgebra
      have _ : IsDomain ↑(U_ss.presheaf.obj (Opposite.op V_ss)) :=
        @AlgebraicGeometry.IsIntegral.component_integral U_ss hSS.1 V_ss hNonemptyV'
      have hφ_inj : Function.Injective φ_ss.hom :=
        IsFractionRing.injective ↑(U_ss.presheaf.obj (Opposite.op V_ss)) F_ss
      have hpt_bot : ((AlgebraicGeometry.Spec.map φ_ss).base pt).asIdeal = ⊥ := by
        change Ideal.comap φ_ss.hom pt.asIdeal = ⊥
        ext a
        simp only [Ideal.mem_comap, Ideal.mem_bot]
        constructor
        · intro ha
          by_contra ha0
          have hu : IsUnit (φ_ss.hom a) := IsUnit.mk0 _ (fun h0 => ha0 (hφ_inj (by simpa using h0)))
          exact pt.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem pt.asIdeal ha hu)
        · rintro rfl
          simp [pt.asIdeal.zero_mem]
      let botV : PrimeSpectrum ↥V := ⟨⊥, Ideal.isPrime_bot⟩
      have hSpecV : botV ⤳ (g_ss.base (η_ss.base pt) : PrimeSpectrum ↥V) :=
        (PrimeSpectrum.le_iff_specializes botV (g_ss.base (η_ss.base pt))).mp bot_le
      obtain ⟨x, hx_spec, hx_eq⟩ := AlgebraicGeometry.Flat.generalizingMap g_ss hSpecV
      have hη_from : hV_ss.fromSpec.base ((AlgebraicGeometry.Spec.map φ_ss).base pt) = η_ss.base pt := by
        rw [← hη_eq]
        rfl
      have hη_mem : η_ss.base pt ∈ V_ss := by
        rw [← hη_from, ← hV_ss.isoSpec_inv_ι]
        exact (hV_ss.isoSpec.inv.base ((AlgebraicGeometry.Spec.map φ_ss).base pt)).2
      have hx_mem : x ∈ V_ss :=
        specializes_iff_forall_open.mp hx_spec (V_ss : Set U_ss) V_ss.2 hη_mem
      let q : AlgebraicGeometry.Spec (U_ss.presheaf.obj (Opposite.op V_ss)) :=
        hV_ss.isoSpec.hom.base ⟨x, hx_mem⟩
      have hq_from : hV_ss.fromSpec.base q = x := by
        rw [← hV_ss.isoSpec_inv_ι]
        have h_id : (hV_ss.isoSpec.hom ≫ hV_ss.isoSpec.inv ≫ V_ss.ι).base ⟨x, hx_mem⟩ =
            V_ss.ι.base ⟨x, hx_mem⟩ := by
          rw [hV_ss.isoSpec.hom_inv_id_assoc]
        exact h_id
      have hq_spec : (q : PrimeSpectrum ↑(U_ss.presheaf.obj (Opposite.op V_ss))) ⤳
          ((AlgebraicGeometry.Spec.map φ_ss).base pt :
            PrimeSpectrum ↑(U_ss.presheaf.obj (Opposite.op V_ss))) := by
        rw [← hq_from, ← hη_from] at hx_spec
        exact hV_ss.fromSpec.isOpenEmbedding.isInducing.specializes_iff.mp hx_spec
      have hq_le : q.asIdeal ≤ ((AlgebraicGeometry.Spec.map φ_ss).base pt).asIdeal :=
        (PrimeSpectrum.le_iff_specializes
          (q : PrimeSpectrum ↑(U_ss.presheaf.obj (Opposite.op V_ss)))
          ((AlgebraicGeometry.Spec.map φ_ss).base pt)).mpr hq_spec
      have hq_eq : q = (AlgebraicGeometry.Spec.map φ_ss).base pt := by
        apply PrimeSpectrum.ext
        rw [hpt_bot] at hq_le ⊢
        exact le_antisymm hq_le bot_le
      have hx_η : x = η_ss.base pt := by
        rw [← hq_from, hq_eq, hη_from]
      rw [← hx_η]
      exact congrArg PrimeSpectrum.asIdeal hx_eq
    refine ⟨?_, ?_, ?_⟩
    · intro X_c p_c η_c W ψ_ss hProp hη_pc hη_ψss
      exact @hValLift X_c U_ss p_c hProp W η_c ψ_ss (hη_ψss.trans hη_pc.symm)
    · intro X_c X' g_c g_X' p_c f η_c ι_c U_iso
        hProp_f hComm_f hComm_pc hη_pc hPb_c hIso_f hGen_iso
      let U'_iso : X'.Opens := (TopologicalSpace.Opens.map f.base).obj U_iso
      have hRange_η : Set.range ⇑η_c.base ⊆ Set.range ⇑U_iso.ι.base := by
        rintro _ ⟨pt, rfl⟩
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        apply hGen_iso
        have h_eq : g_c.base (η_c.base pt) = g_ss.base (η_ss.base pt) := by
          rw [← hComm_pc, ← hη_pc]
          rfl
        rw [h_eq]
        exact hGeneric_bot pt
      let j_η := AlgebraicGeometry.IsOpenImmersion.lift U_iso.ι η_c hRange_η
      have hj_η : j_η ≫ U_iso.ι = η_c :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac U_iso.ι η_c hRange_η
      let η_X' : AlgebraicGeometry.Spec (CommRingCat.of F_ss) ⟶ X' :=
        j_η ≫ @CategoryTheory.inv _ _ _ _ (f ∣_ U_iso) hIso_f ≫ U'_iso.ι
      have hη_X'_f : η_X' ≫ f = η_c := by
        dsimp [η_X', U'_iso]
        rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
          ← AlgebraicGeometry.morphismRestrict_ι f U_iso,
          ← CategoryTheory.Category.assoc (@CategoryTheory.inv _ _ _ _ (f ∣_ U_iso) hIso_f),
          @CategoryTheory.IsIso.inv_hom_id _ _ _ _ (f ∣_ U_iso) hIso_f,
          CategoryTheory.Category.id_comp, hj_η]
      have hRange_ι : Set.range ⇑ι_c.base ⊆ Set.range ⇑U_iso.ι.base := by
        rintro _ ⟨u, rfl⟩
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        apply hGen_iso
        have h_pb_u : (ι_c ≫ g_c).base u =
            ((U_K.ι ≫ p_K) ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)).base u := by
          rw [hPb_c.w]
        have h_ideal : (g_c.base (ι_c.base u)).asIdeal =
            Ideal.comap V.subtype (((U_K.ι ≫ p_K).base u).asIdeal) :=
          congrArg PrimeSpectrum.asIdeal h_pb_u
        rw [h_ideal]
        ext c
        simp only [Ideal.mem_comap, Ideal.mem_bot]
        constructor
        · intro hc
          by_contra hc0
          have hu_unit : IsUnit (V.subtype c) :=
            IsUnit.mk0 _ (fun h0 => hc0 (V.subtype_injective (by simpa using h0)))
          exact ((U_K.ι ≫ p_K).base u).isPrime.ne_top
            (Ideal.eq_top_of_isUnit_mem _ hc hu_unit)
        · rintro rfl
          simp
      let j_ι := AlgebraicGeometry.IsOpenImmersion.lift U_iso.ι ι_c hRange_ι
      have hj_ι : j_ι ≫ U_iso.ι = ι_c :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac U_iso.ι ι_c hRange_ι
      let ι_X' : U_K.toScheme ⟶ X' :=
        (j_ι ≫ @CategoryTheory.inv _ _ _ _ (f ∣_ U_iso) hIso_f) ≫ U'_iso.ι
      have hι_X'_f : ι_X' ≫ f = ι_c := by
        dsimp [ι_X', U'_iso]
        rw [CategoryTheory.Category.assoc,
          ← AlgebraicGeometry.morphismRestrict_ι f U_iso,
          ← CategoryTheory.Category.assoc, CategoryTheory.Category.assoc j_ι,
          @CategoryTheory.IsIso.inv_hom_id _ _ _ _ (f ∣_ U_iso) hIso_f,
          CategoryTheory.Category.comp_id, hj_ι]
      have hPb_left : CategoryTheory.IsPullback
          (j_ι ≫ @CategoryTheory.inv _ _ _ _ (f ∣_ U_iso) hIso_f)
          (𝟙 U_K.toScheme) (f ∣_ U_iso) j_ι := by
        refine @CategoryTheory.IsPullback.of_vert_isIso _ _ _ _ _ _ _ _ _ _ inferInstance hIso_f ⟨?_⟩
        rw [CategoryTheory.Category.assoc,
          @CategoryTheory.IsIso.inv_hom_id _ _ _ _ (f ∣_ U_iso) hIso_f,
          CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
      have hPb_top : CategoryTheory.IsPullback ι_X' (𝟙 U_K.toScheme) f ι_c := by
        simpa only [ι_X', hj_ι] using
          hPb_left.paste_horiz (AlgebraicGeometry.isPullback_morphismRestrict f U_iso).flip
      have hPb_X' : CategoryTheory.IsPullback ι_X' (U_K.ι ≫ p_K) g_X'
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)) := by
        simpa only [CategoryTheory.Category.id_comp, hComm_f] using hPb_top.paste_vert hPb_c
      have hLiftψ : ∀ (W : ValuationSubring F_ss)
          (ψ_c : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ X_c),
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype) ≫ ψ_c = η_c →
          ∃ ψ_X' : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ X',
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom W.subtype) ≫ ψ_X' = η_X' ∧
            ψ_X' ≫ f = ψ_c := by
        intro W ψ_c hη_ψc
        exact @hValLift X' X_c f hProp_f W η_X' ψ_c (hη_ψc.trans hη_X'_f.symm)
      refine ⟨η_X', ι_X', hη_X'_f, hι_X'_f, hPb_X', ?_, hLiftψ⟩
      intro W ⟨ψ_W, mW, U, hU, φ_U, f_sec, hmW, hη_ψW, hmem_U, hφ_U, hRes_W⟩
      obtain ⟨ψ'_W, hη_ψ'W, hψ'W_f⟩ := hLiftψ W ψ_W hη_ψW
      have hmem_pre : ψ'_W.base mW ∈ (TopologicalSpace.Opens.map f.base).obj U := by
        change f.base (ψ'_W.base mW) ∈ U
        have h_pt : f.base (ψ'_W.base mW) = ψ_W.base mW := by
          rw [← hψ'W_f]
          rfl
        rw [h_pt]
        exact hmem_U
      obtain ⟨U', hU', hmem_U', hU'_sub⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hmem_pre
      have hU'_le : U' ≤ (TopologicalSpace.Opens.map f.base).obj U := hU'_sub
      obtain ⟨φ_U', hφ_U'⟩ := hFactor_aff W ψ'_W mW U' hU' hmW hmem_U'
      have hSpec_eq : AlgebraicGeometry.Spec.map (f.appLE U U' hU'_le ≫ φ_U') ≫ hU.fromSpec =
          AlgebraicGeometry.Spec.map φ_U ≫ hU.fromSpec := by
        rw [AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc,
          hU.SpecMap_appLE_fromSpec f hU' hU'_le, ← CategoryTheory.Category.assoc,
          hφ_U', hψ'W_f, hφ_U]
      have hφ_comp : f.appLE U U' hU'_le ≫ φ_U' = φ_U :=
        AlgebraicGeometry.Spec.map_injective ((cancel_mono hU.fromSpec).mp hSpec_eq)
      refine ⟨ψ'_W, mW, U', hU', φ_U', (f.appLE U U' hU'_le).hom f_sec,
        hmW, hη_ψ'W, hmem_U', hφ_U', ?_⟩
      have hf_eq : φ_U'.hom ((f.appLE U U' hU'_le).hom f_sec) = φ_U.hom f_sec := by
        change (f.appLE U U' hU'_le ≫ φ_U').hom f_sec = φ_U.hom f_sec
        rw [hφ_comp]
      have hcomp_eq : ψ'_W ≫ (f ≫ p_c) = ψ_W ≫ p_c := by
        rw [← CategoryTheory.Category.assoc, hψ'W_f]
      intro P hP
      rw [hf_eq]
      have hcomp_g : ψ'_W ≫ (f ≫ p_c) ≫ g_ss = ψ_W ≫ p_c ≫ g_ss := by
        rw [← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc, hψ'W_f,
          CategoryTheory.Category.assoc]
      rw [hcomp_g]
      apply hRes_W P
      rwa [← hcomp_eq]
    · intro X' p_X' η_X' W ψ_X' mW V_sm' e' ψ_V q hmW hη_ψ' hψV_ι hX_eq hq_res
      have hmem_V : ψ_X'.base mW ∈ V_sm' := by
        rw [← hψV_ι]
        exact (ψ_V.base mW).2
      obtain ⟨U, hU, hmem_U, hU_sub⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hmem_V
      have hU_le : U ≤ V_sm' := hU_sub
      obtain ⟨φ_U, hφ_U⟩ := hFactor_aff W ψ_X' mW U hU hmW hmem_U
      let h_chart : AlgebraicGeometry.Spec (X'.presheaf.obj (Opposite.op U)) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of (Polynomial ↥V)) :=
        hU.isoSpec.inv ≫ X'.homOfLE hU_le ≫ e'
      let f_sec : ↑(X'.presheaf.obj (Opposite.op U)) :=
        (AlgebraicGeometry.Spec.preimage h_chart).hom Polynomial.X
      have hψV_eq : AlgebraicGeometry.Spec.map φ_U ≫ hU.isoSpec.inv ≫ X'.homOfLE hU_le = ψ_V := by
        apply (cancel_mono V_sm'.ι).mp
        rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
          AlgebraicGeometry.Scheme.homOfLE_ι, hU.isoSpec_inv_ι, hφ_U, hψV_ι]
      have hchart_comp : AlgebraicGeometry.Spec.map φ_U ≫ h_chart = ψ_V ≫ e' := by
        calc AlgebraicGeometry.Spec.map φ_U ≫ h_chart
            = (AlgebraicGeometry.Spec.map φ_U ≫ hU.isoSpec.inv ≫ X'.homOfLE hU_le) ≫ e' := by
                simp only [h_chart, CategoryTheory.Category.assoc]
          _ = ψ_V ≫ e' := by rw [hψV_eq]
      have hf_sec_eq : φ_U.hom f_sec = q := by
        have h_pre : AlgebraicGeometry.Spec.preimage (AlgebraicGeometry.Spec.map φ_U ≫ h_chart) =
            AlgebraicGeometry.Spec.preimage h_chart ≫ φ_U := by
          rw [AlgebraicGeometry.Spec.preimage_comp, AlgebraicGeometry.Spec.preimage_map]
        rw [hchart_comp] at h_pre
        have h_eval := congrArg (fun φ => φ.hom Polynomial.X) h_pre.symm
        exact h_eval.trans hX_eq
      refine ⟨ψ_X', mW, U, hU, φ_U, f_sec, hmW, hη_ψ', hmem_U, hφ_U, ?_⟩
      rw [hf_sec_eq]
      exact hq_res
  have h_s3 : ∀ (ψ_ss : AlgebraicGeometry.Spec (CommRingCat.of ↥W_target) ⟶ U_ss)
        (mW : AlgebraicGeometry.Spec (CommRingCat.of ↥W_target))
        (t_div : ↥W_target),
      mW.asIdeal = IsLocalRing.maximalIdeal ↥W_target →
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom W_target.subtype) ≫ ψ_ss = η_ss →
      IsClosed ({ψ_ss.base mW} : Set U_ss) →
      (g_ss.base (ψ_ss.base mW)).asIdeal ≠ ⊥ →
      (∀ P : Polynomial ↥V,
        (∃ i : ℕ, P.coeff i ∉ (g_ss.base (ψ_ss.base mW)).asIdeal) →
        Polynomial.eval₂ (AlgebraicGeometry.Spec.preimage (ψ_ss ≫ g_ss)).hom t_div P ∉
          IsLocalRing.maximalIdeal ↥W_target) →
      ∀ (X_c : AlgebraicGeometry.Scheme.{u})
        (g_c : X_c ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
        (p_c : X_c ⟶ U_ss)
        (η_c : AlgebraicGeometry.Spec (CommRingCat.of F_ss) ⟶ X_c)
        (ψ_c : AlgebraicGeometry.Spec (CommRingCat.of ↥W_target) ⟶ X_c),
        IsStrictlySemistableCurveOverValuation V g_c →
        AlgebraicGeometry.IsProper p_c →
        p_c ≫ g_ss = g_c →
        η_c ≫ p_c = η_ss →
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom W_target.subtype) ≫ ψ_c = η_c →
        ψ_c ≫ p_c = ψ_ss →
        let z : X_c := ψ_c.base mW
        let P_z : Ideal ↥V := (g_c.base z).asIdeal
        let θ_V : ↥V →+* ↥W_target := (AlgebraicGeometry.Spec.preimage (ψ_c ≫ g_c)).hom
        (P_z = (g_ss.base (ψ_ss.base mW)).asIdeal ∧
          Ideal.comap θ_V (IsLocalRing.maximalIdeal ↥W_target) = P_z ∧
          (∀ c : ↥V, c ≠ 0 → θ_V c ≠ 0)) ∧
        (IsValResolvedOnMod V g_ss p_c η_c W_target ∨ IsClosed ({z} : Set X_c)) ∧
        (∀ (W_et : X_c.Opens) (hz : z ∈ W_et)
            (e : W_et.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial ↥V))),
          AlgebraicGeometry.Etale e →
          W_et.ι ≫ g_c = e ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) →
          ∃ (ψ_W : AlgebraicGeometry.Spec (CommRingCat.of ↥W_target) ⟶ W_et.toScheme),
            ψ_W ≫ W_et.ι = ψ_c ∧
            (e.base ⟨z, hz⟩).asIdeal =
              Ideal.comap (AlgebraicGeometry.Spec.preimage (ψ_W ≫ e)).hom
                (IsLocalRing.maximalIdeal ↥W_target) ∧
            (∀ c : ↥V, (AlgebraicGeometry.Spec.preimage (ψ_W ≫ e)).hom (Polynomial.C c) = θ_V c) ∧
            let T_W : ↥W_target := (AlgebraicGeometry.Spec.preimage (ψ_W ≫ e)).hom Polynomial.X
            (∀ P : Polynomial ↥V, P ≠ 0 →
              Polynomial.eval₂ (W_target.subtype.comp θ_V) (W_target.subtype T_W) P ≠ 0) ∧
            (∃ Q : Polynomial (Polynomial ↥V), Q ≠ 0 ∧
              Polynomial.eval₂
                (Polynomial.eval₂RingHom (W_target.subtype.comp θ_V) (W_target.subtype T_W))
                (W_target.subtype t_div) Q = 0) ∧
            (¬ IsValResolvedOnMod V g_ss p_c η_c W_target →
              ¬ (∀ P : Polynomial ↥V,
                (∃ i : ℕ, P.coeff i ∉ P_z) →
                Polynomial.eval₂ θ_V T_W P ∉ IsLocalRing.maximalIdeal ↥W_target))) ∧
        ((∃ (W_et : X_c.Opens) (_ : z ∈ W_et)
            (e : W_et.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial ↥V))),
            AlgebraicGeometry.Etale e ∧
            W_et.ι ≫ g_c = e ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C)) ∨
          (∃ (W_et : X_c.Opens) (hz : z ∈ W_et) (a : ↥V)
            (e : W_et.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of
              (MvPolynomial (Fin 2) ↥V ⧸ Ideal.span
                {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a})))
            (ψ_W : AlgebraicGeometry.Spec (CommRingCat.of ↥W_target) ⟶ W_et.toScheme),
            a ≠ 0 ∧
            AlgebraicGeometry.Etale e ∧
            W_et.ι ≫ g_c = e ≫ AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) ∧
            ψ_W ≫ W_et.ι = ψ_c ∧
            (∀ i : Fin 2, Ideal.Quotient.mk _ (MvPolynomial.X i) ∈ (e.base ⟨z, hz⟩).asIdeal) ∧
            let u_W : ↥W_target :=
              (AlgebraicGeometry.Spec.preimage (ψ_W ≫ e)).hom
                (Ideal.Quotient.mk _ (MvPolynomial.X 0))
            let v_W : ↥W_target :=
              (AlgebraicGeometry.Spec.preimage (ψ_W ≫ e)).hom
                (Ideal.Quotient.mk _ (MvPolynomial.X 1))
            u_W * v_W = θ_V a ∧
            u_W ∈ IsLocalRing.maximalIdeal ↥W_target ∧
            v_W ∈ IsLocalRing.maximalIdeal ↥W_target ∧
            (∀ P : Polynomial ↥V, P ≠ 0 →
              Polynomial.eval₂ (W_target.subtype.comp θ_V) (W_target.subtype u_W) P ≠ 0) ∧
            (∃ Q : Polynomial (Polynomial ↥V), Q ≠ 0 ∧
              Polynomial.eval₂
                (Polynomial.eval₂RingHom (W_target.subtype.comp θ_V) (W_target.subtype u_W))
                (W_target.subtype t_div) Q = 0))) := by
    clear hPb_X hη_pX hComm_pX hProp_pX hSS_X ι_X η_X p_X g_X X
    let s3_fracSubfield : ∀ {A F : Type u} [CommRing A] [IsDomain A] [Field F]
        (φ : A →+* F), Function.Injective φ → Subfield F :=
      fun {A F _ _ _} φ hφ =>
        { carrier := {z : F | ∃ a b : A, b ≠ 0 ∧ z * φ b = φ a}
          mul_mem' := by
            rintro x y ⟨a₁, b₁, hb₁, hx⟩ ⟨a₂, b₂, hb₂, hy⟩
            refine ⟨a₁ * a₂, b₁ * b₂, mul_ne_zero hb₁ hb₂, ?_⟩
            rw [map_mul, map_mul]
            calc (x * y) * (φ b₁ * φ b₂) = (x * φ b₁) * (y * φ b₂) := by ring
              _ = φ a₁ * φ a₂ := by rw [hx, hy]
          one_mem' := ⟨1, 1, one_ne_zero, by simp⟩
          add_mem' := by
            rintro x y ⟨a₁, b₁, hb₁, hx⟩ ⟨a₂, b₂, hb₂, hy⟩
            refine ⟨a₁ * b₂ + a₂ * b₁, b₁ * b₂, mul_ne_zero hb₁ hb₂, ?_⟩
            rw [map_add, map_mul, map_mul, map_mul]
            calc (x + y) * (φ b₁ * φ b₂) = (x * φ b₁) * φ b₂ + (y * φ b₂) * φ b₁ := by ring
              _ = φ a₁ * φ b₂ + φ a₂ * φ b₁ := by rw [hx, hy]
          zero_mem' := ⟨0, 1, one_ne_zero, by simp⟩
          neg_mem' := by
            rintro x ⟨a, b, hb, hx⟩
            exact ⟨-a, b, hb, by rw [map_neg, neg_mul, hx]⟩
          inv_mem' := by
            rintro z ⟨a, b, hb, hz⟩
            by_cases ha : a = 0
            · have hφb : φ b ≠ 0 := fun h0 => hb (hφ (by simpa using h0))
              have hz0 : z = 0 := (mul_eq_zero.mp (by rw [hz, ha, map_zero])).resolve_right hφb
              subst hz0
              exact ⟨0, 1, one_ne_zero, by simp⟩
            · have hφa : φ a ≠ 0 := fun h0 => ha (hφ (by simpa using h0))
              have hz0 : z ≠ 0 := fun h0 => hφa (by rw [← hz, h0, zero_mul])
              refine ⟨b, a, ha, ?_⟩
              apply mul_left_cancel₀ hz0
              calc z * (z⁻¹ * φ a) = (z * z⁻¹) * φ a := by ring
                _ = φ a := by rw [mul_inv_cancel₀ hz0, one_mul]
                _ = z * φ b := hz.symm }
    have s3_clear_poly_denoms : ∀ {A F : Type u} [CommRing A] [IsDomain A] [Field F]
        (φ : A →+* F) (hφ : Function.Injective φ) (z : F),
        IsAlgebraic ↥(s3_fracSubfield φ hφ) z →
        ∃ P : Polynomial A, P ≠ 0 ∧ Polynomial.eval₂ φ z P = 0 := by
      intro A F _ _ _ φ hφ z ⟨R, hR_ne, hR_eval⟩
      classical
      have hPair : ∀ i : ℕ, ∃ p : A × A, p.2 ≠ 0 ∧
          (if i ∈ R.support then p.1 ≠ 0 else p.1 = 0) ∧
          (R.coeff i : F) * φ p.2 = φ p.1 := by
        intro i
        by_cases hi : i ∈ R.support
        · have hci : R.coeff i ≠ 0 := Polynomial.mem_support_iff.mp hi
          obtain ⟨a, b, hb, hab⟩ := (R.coeff i).2
          have ha : a ≠ 0 := by
            intro ha0
            rw [ha0, map_zero] at hab
            have hφb : φ b ≠ 0 := fun h0 => hb (hφ (by simpa using h0))
            exact hci (Subtype.ext ((mul_eq_zero.mp hab).resolve_right hφb))
          exact ⟨(a, b), hb, by simp [hi, ha], hab⟩
        · have hci : R.coeff i = 0 := Polynomial.notMem_support_iff.mp hi
          refine ⟨(0, 1), one_ne_zero, by simp [hi], ?_⟩
          rw [hci]
          simp
      choose p hp_ne hp_a hp_eq using hPair
      let c : ℕ → A := fun i => ∏ j ∈ R.support.erase i, (p j).2
      let S : A := ∏ j ∈ R.support, (p j).2
      let P : Polynomial A := ∑ i ∈ R.support, Polynomial.monomial i ((p i).1 * c i)
      refine ⟨P, ?_, ?_⟩
      · obtain ⟨i₀, hi₀⟩ := Polynomial.support_nonempty.mpr hR_ne
        intro hP0
        have hcoeff : P.coeff i₀ = 0 := by rw [hP0, Polynomial.coeff_zero]
        rw [Polynomial.finsetSum_coeff, Finset.sum_eq_single i₀
          (fun b _ hbi₀ => Polynomial.coeff_monomial_of_ne _ hbi₀.symm)
          (fun hi₀_not => absurd hi₀ hi₀_not), Polynomial.coeff_monomial_same] at hcoeff
        have ha_ne : (p i₀).1 ≠ 0 := by simpa [hi₀] using hp_a i₀
        have hc_ne : c i₀ ≠ 0 := Finset.prod_ne_zero_iff.mpr (fun j _ => hp_ne j)
        exact mul_ne_zero ha_ne hc_ne hcoeff
      · rw [Polynomial.eval₂_finsetSum]
        have hterm : ∀ i ∈ R.support,
            Polynomial.eval₂ φ z (Polynomial.monomial i ((p i).1 * c i)) =
              φ S * ((R.coeff i : F) * z ^ i) := by
          intro i hi
          rw [Polynomial.eval₂_monomial, map_mul]
          have hS_eq : (p i).2 * c i = S := Finset.mul_prod_erase R.support (fun j => (p j).2) hi
          calc (φ (p i).1 * φ (c i)) * z ^ i
              = (((R.coeff i : F) * φ (p i).2) * φ (c i)) * z ^ i := by rw [hp_eq i]
            _ = (φ (p i).2 * φ (c i)) * ((R.coeff i : F) * z ^ i) := by ring
            _ = φ S * ((R.coeff i : F) * z ^ i) := by rw [← map_mul, hS_eq]
        rw [Finset.sum_congr rfl hterm, ← Finset.mul_sum]
        have haeval : (∑ i ∈ R.support, (R.coeff i : F) * z ^ i) = Polynomial.aeval z R := by
          rw [Polynomial.aeval_def, Polynomial.eval₂_def, Polynomial.sum_def]
          rfl
        rw [haeval, hR_eval, mul_zero]
    have s3_etale_field_finite : ∀ (E₀ A : Type u) [Field E₀] [CommRing A] [Algebra E₀ A]
        [Algebra.Etale E₀ A], Module.Finite E₀ A := by
      intro E₀ A _ _ _ _
      obtain ⟨I, _, Ai, instField, instAlg, e, hModFin⟩ :=
        (Algebra.Etale.iff_exists_algEquiv_prod E₀ A).mp inferInstance
      let _ := Fintype.ofFinite I
      let _ := instField
      let _ := instAlg
      have _ : ∀ i : I, Module.Finite E₀ (Ai i) := fun i => (hModFin i).1
      exact Module.Finite.equiv e.symm.toLinearEquiv
    have s3_etale_domain_inj : ∀ {A₀ B₀ : Type u} [CommRing A₀] [IsDomain A₀]
        [CommRing B₀] [Nontrivial B₀] (ψ : A₀ →+* B₀), ψ.Etale → Function.Injective ψ := by
      intro A₀ B₀ _ _ _ _ ψ hEt
      let _ : Algebra A₀ B₀ := ψ.toAlgebra
      have _ : Algebra.Etale A₀ B₀ := hEt
      have _ : Module.Flat A₀ B₀ := inferInstance
      rw [injective_iff_map_eq_zero]
      intro a ha
      by_contra ha_ne
      have hmul_inj : Function.Injective (LinearMap.mulLeft A₀ a) := mul_right_injective₀ ha_ne
      have hlT_inj : Function.Injective (LinearMap.lTensor B₀ (LinearMap.mulLeft A₀ a)) :=
        Module.Flat.lTensor_preserves_injective_linearMap _ hmul_inj
      have h_eq : LinearMap.lTensor B₀ (LinearMap.mulLeft A₀ a) ((1 : B₀) ⊗ₜ[A₀] (1 : A₀)) = 0 := by
        rw [LinearMap.lTensor_tmul, LinearMap.mulLeft_apply, mul_one]
        have h1a : (1 : B₀) ⊗ₜ[A₀] a = (a • (1 : B₀)) ⊗ₜ[A₀] (1 : A₀) := by
          rw [TensorProduct.smul_tmul]
          simp
        rw [h1a]
        have hsmul : a • (1 : B₀) = ψ a := by
          change algebraMap A₀ B₀ a * 1 = ψ a
          rw [mul_one]
          rfl
        rw [hsmul, ha, TensorProduct.zero_tmul]
      have h11_zero : ((1 : B₀) ⊗ₜ[A₀] (1 : A₀)) = 0 :=
        hlT_inj (h_eq.trans (map_zero _).symm)
      have hrid := congrArg (TensorProduct.rid A₀ B₀) h11_zero
      simp only [TensorProduct.rid_tmul, one_smul, map_zero] at hrid
      exact one_ne_zero hrid
    have s3_etale_baseChange_alg : ∀ {A₀ B₀ F : Type u} [CommRing A₀] [CommRing B₀] [Field F]
        (ψ : A₀ →+* B₀), ψ.Etale →
        ∀ (E : Subfield F) (α_E : A₀ →+* ↥E) (φ_B : B₀ →+* F),
          φ_B.comp ψ = E.subtype.comp α_E →
          ∀ b : B₀, IsIntegral ↥E (φ_B b) := by
      intro A₀ B₀ F _ _ _ ψ hEt E α_E φ_B hcomm
      let _ : Algebra A₀ B₀ := ψ.toAlgebra
      let _ : Algebra A₀ ↥E := α_E.toAlgebra
      let _ : Algebra A₀ F := (φ_B.comp ψ).toAlgebra
      have _ : Algebra.Etale A₀ B₀ := hEt
      have _ : Algebra.Etale ↥E (TensorProduct A₀ ↥E B₀) := Algebra.Etale.baseChange A₀ B₀ ↥E
      have _ : Module.Finite ↥E (TensorProduct A₀ ↥E B₀) :=
        s3_etale_field_finite ↥E (TensorProduct A₀ ↥E B₀)
      have _ : Algebra.IsAlgebraic ↥E (TensorProduct A₀ ↥E B₀) :=
        Algebra.IsAlgebraic.of_finite ↥E (TensorProduct A₀ ↥E B₀)
      let e_hom : ↥E →ₐ[A₀] F :=
        { toRingHom := E.subtype
          commutes' := fun a => (RingHom.congr_fun hcomm a).symm }
      let b_hom : B₀ →ₐ[A₀] F :=
        { toRingHom := φ_B
          commutes' := fun _ => rfl }
      let μ_ring : TensorProduct A₀ ↥E B₀ →+* F :=
        (Algebra.TensorProduct.lift e_hom b_hom (fun _ _ => Commute.all _ _)).toRingHom
      let μ_alg : TensorProduct A₀ ↥E B₀ →ₐ[↥E] F :=
        { toRingHom := μ_ring
          commutes' := fun x => by
            change (Algebra.TensorProduct.lift e_hom b_hom (fun _ _ => Commute.all _ _))
              (x ⊗ₜ[A₀] (1 : B₀)) = E.subtype x
            rw [Algebra.TensorProduct.lift_tmul, map_one, mul_one]
            rfl }
      intro b
      have h_alg : IsAlgebraic ↥E ((1 : ↥E) ⊗ₜ[A₀] b : TensorProduct A₀ ↥E B₀) :=
        Algebra.IsAlgebraic.isAlgebraic _
      have h_int := h_alg.isIntegral.map μ_alg
      have h_eval : μ_alg ((1 : ↥E) ⊗ₜ[A₀] b) = φ_B b := by
        change (Algebra.TensorProduct.lift e_hom b_hom (fun _ _ => Commute.all _ _))
          ((1 : ↥E) ⊗ₜ[A₀] b) = φ_B b
        rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
        rfl
      rwa [h_eval] at h_int
    let s3NodalIdeal : ↥V → Ideal (MvPolynomial (Fin 2) ↥V) :=
      fun a => Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}
    have h_nodal_away_iso : ∀ {R : Type u} [CommRing R] (a : R),
        let I_a : Ideal (MvPolynomial (Fin 2) R) :=
          Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}
        let xbar₀ : (MvPolynomial (Fin 2) R ⧸ I_a) := Ideal.Quotient.mk I_a (MvPolynomial.X 0)
        ∃ iso : Localization.Away (Polynomial.X : Polynomial R) ≃+* Localization.Away xbar₀,
          (∀ c : R,
            iso (algebraMap (Polynomial R) (Localization.Away (Polynomial.X : Polynomial R))
                (Polynomial.C c)) =
              algebraMap (MvPolynomial (Fin 2) R ⧸ I_a) (Localization.Away xbar₀)
                (Ideal.Quotient.mk I_a (MvPolynomial.C c))) ∧
          iso (algebraMap (Polynomial R) (Localization.Away (Polynomial.X : Polynomial R))
              (Polynomial.X : Polynomial R)) =
            algebraMap (MvPolynomial (Fin 2) R ⧸ I_a) (Localization.Away xbar₀) xbar₀ := by
      intro R _ a I_a xbar₀
      let qmk : MvPolynomial (Fin 2) R →+* (MvPolynomial (Fin 2) R ⧸ I_a) := Ideal.Quotient.mk I_a
      let toNodalLoc : Polynomial R →+* Localization.Away xbar₀ :=
        Polynomial.eval₂RingHom
          ((algebraMap (MvPolynomial (Fin 2) R ⧸ I_a) (Localization.Away xbar₀)).comp
            (qmk.comp MvPolynomial.C))
          (algebraMap (MvPolynomial (Fin 2) R ⧸ I_a) (Localization.Away xbar₀) xbar₀)
      have hxbar_unit : IsUnit (toNodalLoc Polynomial.X) := by
        simp only [toNodalLoc, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
        exact IsLocalization.Away.algebraMap_isUnit xbar₀
      let Ψ : Localization.Away (Polynomial.X : Polynomial R) →+* Localization.Away xbar₀ :=
        IsLocalization.Away.lift Polynomial.X hxbar_unit
      let val0 : Localization.Away (Polynomial.X : Polynomial R) :=
        algebraMap (Polynomial R) (Localization.Away (Polynomial.X : Polynomial R)) Polynomial.X
      let val1 : Localization.Away (Polynomial.X : Polynomial R) :=
        algebraMap (Polynomial R) (Localization.Away (Polynomial.X : Polynomial R)) (Polynomial.C a) *
          IsLocalization.Away.invSelf
            (S := Localization.Away (Polynomial.X : Polynomial R)) (Polynomial.X : Polynomial R)
      let varMap : Fin 2 → Localization.Away (Polynomial.X : Polynomial R) :=
        fun i => if i = 0 then val0 else val1
      let mvToPolyLoc : MvPolynomial (Fin 2) R →+* Localization.Away (Polynomial.X : Polynomial R) :=
        MvPolynomial.eval₂Hom
          ((algebraMap (Polynomial R) (Localization.Away (Polynomial.X : Polynomial R))).comp
            Polynomial.C)
          varMap
      have hker_mv : I_a ≤ RingHom.ker mvToPolyLoc := by
        rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
        simp only [mvToPolyLoc, varMap, val0, val1, map_sub, map_mul, MvPolynomial.eval₂Hom_X',
          MvPolynomial.eval₂Hom_C, RingHom.comp_apply, show ¬((1 : Fin 2) = 0) by decide, ↓reduceIte]
        set X_loc := algebraMap (Polynomial R) (Localization.Away (Polynomial.X : Polynomial R))
          Polynomial.X
        set Ca_loc := algebraMap (Polynomial R) (Localization.Away (Polynomial.X : Polynomial R))
          (Polynomial.C a)
        set invX := IsLocalization.Away.invSelf
          (S := Localization.Away (Polynomial.X : Polynomial R)) (Polynomial.X : Polynomial R)
        have hmul1 : X_loc * invX = 1 :=
          IsLocalization.Away.mul_invSelf
            (S := Localization.Away (Polynomial.X : Polynomial R)) (Polynomial.X : Polynomial R)
        calc X_loc * (Ca_loc * invX) - Ca_loc
            = Ca_loc * (X_loc * invX) - Ca_loc := by ring
          _ = Ca_loc * 1 - Ca_loc := by rw [hmul1]
          _ = 0 := by ring
      let nodalToPolyLoc : (MvPolynomial (Fin 2) R ⧸ I_a) →+*
          Localization.Away (Polynomial.X : Polynomial R) :=
        Ideal.Quotient.lift I_a mvToPolyLoc
          (fun _ hf => RingHom.mem_ker.mp (hker_mv hf))
      have hX_unit : IsUnit (nodalToPolyLoc xbar₀) := by
        have heq : nodalToPolyLoc xbar₀ = val0 := by
          simp [nodalToPolyLoc, mvToPolyLoc, varMap, xbar₀]
        rw [heq]
        exact IsLocalization.Away.algebraMap_isUnit Polynomial.X
      let Φ : Localization.Away xbar₀ →+* Localization.Away (Polynomial.X : Polynomial R) :=
        IsLocalization.Away.lift xbar₀ hX_unit
      have hΦΨ : Φ.comp Ψ = RingHom.id _ := by
        apply IsLocalization.ringHom_ext (Submonoid.powers (Polynomial.X : Polynomial R))
        apply Polynomial.ringHom_ext'
        · ext c
          simp [Ψ, Φ, toNodalLoc, nodalToPolyLoc, mvToPolyLoc, varMap, val0, val1, qmk,
            IsLocalization.Away.lift_eq]
        · simp [Ψ, Φ, toNodalLoc, nodalToPolyLoc, mvToPolyLoc, varMap, val0, val1, qmk, xbar₀,
            IsLocalization.Away.lift_eq]
      have hΨΦ : Ψ.comp Φ = RingHom.id _ := by
        apply IsLocalization.ringHom_ext (Submonoid.powers xbar₀)
        apply RingHom.ext
        intro p_bar
        obtain ⟨P_mv, rfl⟩ := Ideal.Quotient.mk_surjective p_bar
        revert P_mv
        suffices hMv : ((Ψ.comp Φ).comp
