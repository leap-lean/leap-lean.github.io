    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_bot.flip hOpen_η
  haveI : AlgebraicGeometry.IsAffineHom u_gen :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_bot.flip hAff_η
  have hPb_mono : CategoryTheory.IsPullback ιE (𝟙 E_sch) u_gen (ιE ≫ u_gen) := by
    refine CategoryTheory.IsPullback.of_isLimit
      (CategoryTheory.Limits.PullbackCone.IsLimit.mk
        (by rw [CategoryTheory.Category.id_comp])
        (fun s => s.snd)
        (fun s => (CategoryTheory.cancel_mono u_gen).mp ?_)
        (fun s => CategoryTheory.Category.comp_id s.snd)
        (fun s m _ hm => by simpa using hm))
    rw [CategoryTheory.Category.assoc]
    exact s.condition.symm
  have hker_comap : (ι_ℰ.ker).comap u_gen = ιE.ker := by
    have h1 : ((ιE ≫ u_gen).ker).comap u_gen = ιE.ker := by
      rw [AlgebraicGeometry.Scheme.IdealSheafData.ext_iff]
      ext W : 1
      rw [AlgebraicGeometry.Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion,
        AlgebraicGeometry.Scheme.ker_ideal_of_isPullback_of_isOpenImmersion
          (ιE ≫ u_gen) ιE (𝟙 E_sch) u_gen hPb_mono W]
    have h2 : ι_ℰ.ker = (ιE ≫ u_gen).ker :=
      AlgebraicGeometry.Scheme.IdealSheafData.ker_subschemeι (ιE ≫ u_gen).ker
    rw [h2, h1]
  have hPb_top : CategoryTheory.IsPullback
      ιE (AlgebraicGeometry.Scheme.Hom.toImage (ιE ≫ u_gen)) u_gen ι_ℰ :=
    AlgebraicGeometry.isPullback_of_isClosedImmersion
      ιE ι_ℰ (AlgebraicGeometry.Scheme.Hom.toImage (ιE ≫ u_gen)) u_gen
      (AlgebraicGeometry.Scheme.Hom.toImage_imageι (ιE ≫ u_gen)).symm
      hker_comap
  have hPb_gen : CategoryTheory.IsPullback
      (AlgebraicGeometry.Scheme.Hom.toImage (ιE ≫ u_gen))
      (ιE ≫ CategoryTheory.Limits.pullback.snd g_cur s_b)
      g_ℰ
      η_W0 :=
    hPb_top.flip.paste_vert hPb_bot
  let isoGen : CategoryTheory.Limits.pullback g_ℰ η_W0 ≅
      (weilProjectiveSpaceOver L 1).left :=
    hPb_gen.isoPullback.symm ≪≫ isoP1
  have hisoGen_snd : CategoryTheory.Limits.pullback.snd g_ℰ η_W0 =
      isoGen.hom ≫ (weilProjectiveSpaceOver L 1).hom := by
    calc CategoryTheory.Limits.pullback.snd g_ℰ η_W0
        = hPb_gen.isoPullback.inv ≫ (ιE ≫ CategoryTheory.Limits.pullback.snd g_cur s_b) :=
          hPb_gen.isoPullback_inv_snd.symm
      _ = hPb_gen.isoPullback.inv ≫
            (isoP1.hom ≫ (weilProjectiveSpaceOver L 1).hom) :=
          congrArg (hPb_gen.isoPullback.inv ≫ ·) hIso_E
      _ = isoGen.hom ≫ (weilProjectiveSpaceOver L 1).hom := by
          simp [isoGen]
  have hGenRange : ∀ q_b : ↥(CategoryTheory.Limits.pullback g_cur s_b),
      u_gen.base q_b ∈ Set.range ι_ℰ.base ↔ q_b ∈ E_cur := by
    intro q_b
    constructor
    · rintro ⟨z, hz⟩
      obtain ⟨w, hw, _⟩ :=
        AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hPb_top q_b z hz.symm
      rw [← hRange_E]
      exact ⟨w, hw⟩
    · intro hq
      rw [← hRange_E] at hq
      rcases hq with ⟨w, rfl⟩
      refine ⟨(AlgebraicGeometry.Scheme.Hom.toImage (ιE ≫ u_gen)).base w, ?_⟩
      exact congrArg (fun φ => φ.base w)
        (AlgebraicGeometry.Scheme.Hom.toImage_imageι (ιE ≫ u_gen))
  exact ⟨hProp_g_ℰ, ⟨isoGen, hisoGen_snd⟩, hGenRange, hCl_contr⟩

theorem weil_etale_over_integrallyClosed_exists_away_isDomain (A₀ B : Type u) [CommRing A₀] [IsDomain A₀] [IsIntegrallyClosed A₀]
    [CommRing B] (φ : A₀ →+* B) (hEt : φ.Etale)
    (q : Ideal B) [q.IsPrime] :
    ∃ s : B, s ∉ q ∧ IsDomain (Localization.Away s) :=
by
  rename_i instCommA₀ instDomA₀ instICA₀ instCommB instPrimeQ
  have hICA₀ : IsIntegrallyClosed A₀ := instICA₀
  clear instICA₀
  let instAlgA₀B : Algebra A₀ B := φ.toAlgebra
  letI : Algebra A₀ B := instAlgA₀B
  have instEtA₀B : Algebra.Etale A₀ B :=
    (RingHom.etale_algebraMap (R := A₀) (S := B)).mp hEt
  haveI : Algebra.Etale A₀ B := instEtA₀B
  have h_step1 : ∀ (A₀ B : Type u) [CommRing A₀] [IsDomain A₀]
      [CommRing B] [Algebra A₀ B] [Algebra.Etale A₀ B],
      _root_.IsReduced B ∧ (minimalPrimes B).Finite := by
    clear! A₀ B
    intro A₀ B _ _ _ _ _
    let N₀ : Submonoid A₀ := nonZeroDivisors A₀
    let M₀ : Submonoid B := Algebra.algebraMapSubmonoid B N₀
    let L : Type u := FractionRing A₀
    let B_L : Type u := Localization M₀
    have hM₀_le : M₀ ≤ nonZeroDivisors B := by
      intro m hm
      rcases hm with ⟨a, ha, rfl⟩
      rw [mem_nonZeroDivisors_iff_right]
      intro x hxm
      have ha0 : a ≠ 0 := nonZeroDivisors.ne_zero ha
      have hsmul : a • x = 0 := by
        rw [Algebra.smul_def, mul_comm, hxm]
      exact (smul_eq_zero.mp hsmul).resolve_left ha0
    have hinj : Function.Injective (algebraMap B B_L) :=
      IsLocalization.injective B_L hM₀_le
    have hN₀_units : ∀ y : N₀, IsUnit (algebraMap A₀ B_L y.1) := by
      intro y
      rw [IsScalarTower.algebraMap_apply A₀ B B_L]
      let m_y : M₀ := ⟨algebraMap A₀ B y.1, ⟨y.1, y.2, rfl⟩⟩
      exact IsLocalization.map_units B_L m_y
    let φ_LB : L →+* B_L := IsLocalization.lift (M := N₀) (S := L) hN₀_units
    letI : Algebra L B_L := φ_LB.toAlgebra
    haveI : IsScalarTower A₀ L B_L := IsScalarTower.of_algebraMap_eq fun a =>
      show algebraMap A₀ B_L a = φ_LB (algebraMap A₀ L a) from
        (IsLocalization.lift_eq (M := N₀) (S := L) hN₀_units a).symm
    haveI : Algebra.FormallyEtale B B_L := Algebra.FormallyEtale.of_isLocalization M₀
    haveI : Algebra.FormallyEtale A₀ B_L := Algebra.FormallyEtale.comp A₀ B B_L
    haveI : Algebra.FormallyEtale L B_L := Algebra.FormallyEtale.localization_base N₀
    haveI : Algebra.EssFiniteType A₀ B := Algebra.EssFiniteType.of_finiteType A₀ B
    haveI : Algebra.EssFiniteType B B_L := Algebra.EssFiniteType.of_isLocalization B_L M₀
    haveI : Algebra.EssFiniteType A₀ B_L := Algebra.EssFiniteType.comp A₀ B B_L
    haveI : Algebra.EssFiniteType L B_L := by
      obtain ⟨σ, hσ⟩ := (Algebra.essFiniteType_iff A₀ B_L).mp inferInstance
      have hsub : ∀ z : B_L, z ∈ Algebra.adjoin A₀ (σ : Set B_L) →
          z ∈ Algebra.adjoin L (σ : Set B_L) := by
        intro z hz
        refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hz
        · exact fun b hb => Algebra.subset_adjoin hb
        · intro a
          rw [IsScalarTower.algebraMap_apply A₀ L B_L]
          exact Subalgebra.algebraMap_mem _ _
        · exact fun _ _ _ _ h₁ h₂ => Subalgebra.add_mem _ h₁ h₂
        · exact fun _ _ _ _ h₁ h₂ => Subalgebra.mul_mem _ h₁ h₂
      exact (Algebra.essFiniteType_iff L B_L).mpr ⟨σ, fun s => by
        obtain ⟨t, ht, hu, hst⟩ := hσ s
        exact ⟨t, hsub t ht, hu, hsub (s * t) hst⟩⟩
    obtain ⟨I, hFinI, Ai, hFieldAi, hAlgAi, ⟨e_prod⟩⟩ :=
      (Algebra.FormallyEtale.iff_exists_algEquiv_prod L B_L).mp inferInstance
    haveI : _root_.IsReduced B_L := isReduced_of_injective e_prod e_prod.injective
    have hRedB : _root_.IsReduced B := isReduced_of_injective (algebraMap B B_L) hinj
    letI : Fintype I := Fintype.ofFinite I
    letI : DecidableEq I := Classical.decEq I
    have hPrimesProd : {P : Ideal (∀ i : I, Ai i) | P.IsPrime} ⊆
        Set.range (fun i : I => RingHom.ker (Pi.evalRingHom Ai i)) := by
      intro P hP
      haveI : P.IsPrime := hP
      let u : I → (∀ j : I, Ai j) := fun i => Pi.single i 1
      have hsum : ∑ i : I, u i = 1 := by
        ext j
        simp [u, Finset.sum_apply]
      have hex : ∃ i₀ : I, u i₀ ∉ P := by
        by_contra hall
        have h1 : (1 : ∀ j : I, Ai j) ∈ P := by
          rw [← hsum]
          exact P.sum_mem fun i _ => by_contra fun hi => hall ⟨i, hi⟩
        exact hP.ne_top (P.eq_top_iff_one.mpr h1)
      obtain ⟨i₀, hi₀⟩ := hex
      refine ⟨i₀, le_antisymm ?_ ?_⟩
      · intro v hv
        have hv0 : v i₀ = 0 := hv
        have hv_mul : v * u i₀ = 0 := by
          ext j
          by_cases hj : j = i₀
          · subst hj; simp [u, Pi.single_eq_same, hv0]
          · simp [u, Pi.single_eq_of_ne hj]
        have hmem : v * u i₀ ∈ P := by rw [hv_mul]; exact P.zero_mem
        exact (hP.mem_or_mem hmem).resolve_right hi₀
      · intro v hv
        change v i₀ = 0
        by_contra hvi₀
        have hv_mul : v * Pi.single i₀ (v i₀)⁻¹ = u i₀ := by
          ext j
          by_cases hj : j = i₀
          · subst hj; simp [u, Pi.single_eq_same, mul_inv_cancel₀ hvi₀]
          · simp [u, Pi.single_eq_of_ne hj]
        exact hi₀ (hv_mul ▸ P.mul_mem_right _ hv)
    have hFinProd : {P : Ideal (∀ i : I, Ai i) | P.IsPrime}.Finite :=
      (Set.finite_range _).subset hPrimesProd
    have hSubBL : minimalPrimes B_L ⊆
        Ideal.comap e_prod.toRingHom '' {P : Ideal (∀ i : I, Ai i) | P.IsPrime} := by
      intro Q hQ
      haveI : Q.IsPrime := hQ.1.1
      refine ⟨Ideal.map e_prod.toRingHom Q, Ideal.map_isPrime_of_equiv e_prod.toRingEquiv, ?_⟩
      exact Ideal.comap_map_of_bijective e_prod.toRingHom e_prod.bijective
    have hFinBL : (minimalPrimes B_L).Finite := (hFinProd.image _).subset hSubBL
    have hcomap_bot : Ideal.comap (algebraMap B B_L) (⊥ : Ideal B_L) = (⊥ : Ideal B) := by
      ext x
      simp only [Ideal.mem_comap, Ideal.mem_bot]
      exact ⟨fun h => hinj (by simpa using h), fun h => by simp [h]⟩
    have hMinEq : minimalPrimes B = Ideal.comap (algebraMap B B_L) '' minimalPrimes B_L := by
      change (⊥ : Ideal B).minimalPrimes =
        Ideal.comap (algebraMap B B_L) '' (⊥ : Ideal B_L).minimalPrimes
      rw [← hcomap_bot]
      exact IsLocalization.minimalPrimes_comap M₀ B_L (⊥ : Ideal B_L)
    exact ⟨hRedB, hMinEq ▸ hFinBL.image _⟩
  let n : Ideal A₀ := q.under A₀
  haveI hn_prime : n.IsPrime := Ideal.comap_isPrime (algebraMap A₀ B) q
  let A₁ : Type u := Localization.AtPrime n
  let B_q : Type u := Localization.AtPrime q
  letI : q.LiesOver n := ⟨rfl⟩
  letI : Algebra A₁ B_q := Localization.AtPrime.algebraOfLiesOver n q
  have h_step2 :
      Algebra.FormallyUnramified A₁ B_q ∧
      IsLocalHom (algebraMap A₁ B_q) ∧
      Module.IsTorsionFree A₁ B_q ∧
      Algebra.IsSeparable (IsLocalRing.ResidueField A₁) (IsLocalRing.ResidueField B_q) ∧
      Ideal.map (algebraMap A₁ B_q) (IsLocalRing.maximalIdeal A₁) = IsLocalRing.maximalIdeal B_q ∧
      ∃ (R₁ : Subalgebra A₁ B_q),
        Module.Finite A₁ ↥R₁ ∧
        Algebra.IsIntegral A₁ ↥R₁ ∧
        IsLocalization (Ideal.comap (algebraMap ↥R₁ B_q) (IsLocalRing.maximalIdeal B_q)).primeCompl B_q := by
    haveI : IsScalarTower A₀ A₁ B_q := inferInstance
    have hLocHom : IsLocalHom (algebraMap A₁ B_q) := inferInstance
    haveI : Module.IsTorsionFree A₀ B_q := inferInstance
    have hTF₁ : Module.IsTorsionFree A₁ B_q := by
      rw [Module.isTorsionFree_iff_smul_eq_zero]
      intro z x hzx
      by_cases hz : z = 0
      · exact Or.inl hz
      · right
        obtain ⟨⟨a, s⟩, has⟩ := IsLocalization.surj n.primeCompl z
        have ha0 : a ≠ 0 := by
          intro ha
          have hzs : z * algebraMap A₀ A₁ s.1 = 0 := by simpa [ha] using has
          have hunit : IsUnit (algebraMap A₀ A₁ s.1) := IsLocalization.map_units A₁ s
          exact hz (hunit.mul_left_eq_zero.mp hzs)
        have hasmul : a • x = 0 := by
          rw [← IsScalarTower.algebraMap_smul A₁ a x, ← has, mul_comm, mul_smul, hzx, smul_zero]
        exact (smul_eq_zero.mp hasmul).resolve_left ha0
    haveI : Algebra.FormallyUnramified B B_q := Algebra.FormallyUnramified.of_isLocalization q.primeCompl
    haveI : Algebra.FormallyUnramified A₀ B_q := Algebra.FormallyUnramified.comp A₀ B B_q
    have hUnram : Algebra.FormallyUnramified A₁ B_q := Algebra.FormallyUnramified.localization_base n.primeCompl
    haveI : Algebra.EssFiniteType A₀ B := Algebra.EssFiniteType.of_finiteType A₀ B
    haveI : Algebra.EssFiniteType B B_q := Algebra.EssFiniteType.of_isLocalization B_q q.primeCompl
    haveI : Algebra.EssFiniteType A₀ B_q := Algebra.EssFiniteType.comp A₀ B B_q
    haveI : Algebra.EssFiniteType A₁ B_q := by
      obtain ⟨σ, hσ⟩ := (Algebra.essFiniteType_iff A₀ B_q).mp inferInstance
      have hsub : ∀ z : B_q, z ∈ Algebra.adjoin A₀ (σ : Set B_q) →
          z ∈ Algebra.adjoin A₁ (σ : Set B_q) := by
        intro z hz
        refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hz
        · exact fun b hb => Algebra.subset_adjoin hb
        · intro a
          rw [IsScalarTower.algebraMap_apply A₀ A₁ B_q]
          exact Subalgebra.algebraMap_mem _ _
        · exact fun _ _ _ _ h₁ h₂ => Subalgebra.add_mem _ h₁ h₂
        · exact fun _ _ _ _ h₁ h₂ => Subalgebra.mul_mem _ h₁ h₂
      exact (Algebra.essFiniteType_iff A₁ B_q).mpr ⟨σ, fun s => by
        obtain ⟨t, ht, hu, hst⟩ := hσ s
        exact ⟨t, hsub t ht, hu, hsub (s * t) hst⟩⟩
    have hUnramIff := (Algebra.FormallyUnramified.iff_map_maximalIdeal_eq (R := A₁) (S := B_q)).mp hUnram
    have hSep : Algebra.IsSeparable (IsLocalRing.ResidueField A₁) (IsLocalRing.ResidueField B_q) :=
      hUnramIff.1
    have hMax : Ideal.map (algebraMap A₁ B_q) (IsLocalRing.maximalIdeal A₁) = IsLocalRing.maximalIdeal B_q :=
      hUnramIff.2
    have hZMT := Algebra.ZariskisMainProperty.of_finiteType (R := A₀) q
    rw [Algebra.zariskisMainProperty_iff] at hZMT
    obtain ⟨r, hr_not_q, hr_int, hr_pow⟩ := hZMT
    obtain ⟨G, hG⟩ := (inferInstance : Algebra.FiniteType A₀ B).out
    choose k hk using hr_pow
    classical
    let ι_B : B →ₐ[A₀] B_q := IsScalarTower.toAlgHom A₀ B B_q
    let S_gen : Finset B_q := insert (ι_B r) (G.image fun b => ι_B (r ^ k b * b))
    let R₁ : Subalgebra A₁ B_q := Algebra.adjoin A₁ (S_gen : Set B_q)
    have hS_int : (S_gen : Set B_q) ⊆ integralClosure A₁ B_q := by
      intro y hy
      simp only [S_gen, Finset.coe_insert, Finset.coe_image, Set.mem_insert_iff, Set.mem_image] at hy
      rcases hy with rfl | ⟨b, _, rfl⟩
      · exact _root_.IsIntegral.tower_top (hr_int.map ι_B)
      · exact _root_.IsIntegral.tower_top ((hk b).map ι_B)
    have hR₁_le_ic : R₁ ≤ integralClosure A₁ B_q := Algebra.adjoin_le hS_int
    have hIntR₁ : Algebra.IsIntegral A₁ ↥R₁ := by
      refine ⟨fun x => ?_⟩
      have hx_bm : _root_.IsIntegral A₁ (x : B_q) := hR₁_le_ic x.2
      exact (isIntegral_algHom_iff R₁.val Subtype.val_injective).mp hx_bm
    haveI : Algebra.IsIntegral A₁ ↥R₁ := hIntR₁
    haveI : Algebra.FiniteType A₁ ↥R₁ := Algebra.FiniteType.adjoin_of_finite S_gen.finite_toSet
    have hFinR₁ : Module.Finite A₁ ↥R₁ := Algebra.IsIntegral.finite
    have hr_mem : ι_B r ∈ R₁ :=
      Algebra.subset_adjoin (Finset.mem_coe.mpr (Finset.mem_insert_self _ _))
    have hB_pow : ∀ x : B, ∃ M : ℕ, (ι_B r) ^ M * ι_B x ∈ R₁ := by
      intro x
      have hxG : x ∈ Algebra.adjoin A₀ (G : Set B) := by rw [hG]; trivial
      refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hxG
      · intro b hb
        refine ⟨k b, ?_⟩
        have hmem : ι_B (r ^ k b * b) ∈ (S_gen : Set B_q) :=
          Finset.mem_coe.mpr (Finset.mem_insert_of_mem (Finset.mem_image_of_mem _ hb))
        simpa [map_mul, map_pow] using Algebra.subset_adjoin hmem
      · intro a
        refine ⟨0, ?_⟩
        simp only [pow_zero, one_mul]
        change algebraMap A₀ B_q a ∈ R₁
        rw [IsScalarTower.algebraMap_apply A₀ A₁ B_q]
        exact R₁.algebraMap_mem (algebraMap A₀ A₁ a)
      · rintro y₁ y₂ _ _ ⟨M₁, hM₁⟩ ⟨M₂, hM₂⟩
        refine ⟨M₁ + M₂, ?_⟩
        have heq : (ι_B r) ^ (M₁ + M₂) * ι_B (y₁ + y₂) =
            (ι_B r) ^ M₂ * ((ι_B r) ^ M₁ * ι_B y₁) +
            (ι_B r) ^ M₁ * ((ι_B r) ^ M₂ * ι_B y₂) := by
          rw [map_add, pow_add]; ring
        rw [heq]
        exact R₁.add_mem (R₁.mul_mem (R₁.pow_mem hr_mem M₂) hM₁)
          (R₁.mul_mem (R₁.pow_mem hr_mem M₁) hM₂)
      · rintro y₁ y₂ _ _ ⟨M₁, hM₁⟩ ⟨M₂, hM₂⟩
        refine ⟨M₁ + M₂, ?_⟩
        have heq : (ι_B r) ^ (M₁ + M₂) * ι_B (y₁ * y₂) =
            ((ι_B r) ^ M₁ * ι_B y₁) * ((ι_B r) ^ M₂ * ι_B y₂) := by
          rw [map_mul, pow_add]; ring
        rw [heq]
        exact R₁.mul_mem hM₁ hM₂
    let q₀ : Ideal ↥R₁ := Ideal.comap (algebraMap ↥R₁ B_q) (IsLocalRing.maximalIdeal B_q)
    have hLocR₁ : IsLocalization q₀.primeCompl B_q := by
      refine ⟨?_, ?_, ?_⟩
      · intro t
        exact IsLocalRing.notMem_maximalIdeal.mp t.2
      · intro z
        obtain ⟨⟨u, v⟩, huv⟩ := IsLocalization.surj q.primeCompl z
        obtain ⟨M₁, hM₁⟩ := hB_pow u
        obtain ⟨M₂, hM₂⟩ := hB_pow v.1
        let x₀ : ↥R₁ := ⟨(ι_B r) ^ M₂ * ((ι_B r) ^ M₁ * ι_B u),
          R₁.mul_mem (R₁.pow_mem hr_mem M₂) hM₁⟩
        have ht₀_mem : (ι_B r) ^ M₁ * ((ι_B r) ^ M₂ * ι_B v.1) ∈ R₁ :=
          R₁.mul_mem (R₁.pow_mem hr_mem M₁) hM₂
        have ht₀_unit : IsUnit ((ι_B r) ^ M₁ * ((ι_B r) ^ M₂ * ι_B v.1)) := by
          have hur : IsUnit (ι_B r) := IsLocalization.map_units B_q (⟨r, hr_not_q⟩ : q.primeCompl)
          have huv_u : IsUnit (ι_B v.1) := IsLocalization.map_units B_q v
          exact (hur.pow M₁).mul ((hur.pow M₂).mul huv_u)
        let t₀ : q₀.primeCompl := ⟨⟨(ι_B r) ^ M₁ * ((ι_B r) ^ M₂ * ι_B v.1), ht₀_mem⟩,
          IsLocalRing.notMem_maximalIdeal.mpr ht₀_unit⟩
        refine ⟨⟨x₀, t₀⟩, ?_⟩
        change z * ((ι_B r) ^ M₁ * ((ι_B r) ^ M₂ * algebraMap B B_q v.1)) =
          (ι_B r) ^ M₂ * ((ι_B r) ^ M₁ * algebraMap B B_q u)
        calc
          z * ((ι_B r) ^ M₁ * ((ι_B r) ^ M₂ * algebraMap B B_q v.1)) =
              (ι_B r) ^ M₂ * ((ι_B r) ^ M₁ * (z * algebraMap B B_q v.1)) := by ring
          _ = (ι_B r) ^ M₂ * ((ι_B r) ^ M₁ * algebraMap B B_q u) := by rw [huv]
      · intro x y hxy
        exact ⟨1, by simp [Subtype.ext hxy]⟩
    exact ⟨hUnram, hLocHom, hTF₁, hSep, hMax, R₁, hFinR₁, hIntR₁, hLocR₁⟩
  have h_step3 : ∀ (A₁ B_m : Type u) [CommRing A₁] [IsLocalRing A₁]
      [CommRing B_m] [IsLocalRing B_m] [Algebra A₁ B_m] [IsLocalHom (algebraMap A₁ B_m)]
      (hSep : Algebra.IsSeparable (IsLocalRing.ResidueField A₁) (IsLocalRing.ResidueField B_m))
      (hMax : Ideal.map (algebraMap A₁ B_m) (IsLocalRing.maximalIdeal A₁) = IsLocalRing.maximalIdeal B_m)
      (R₁ : Subalgebra A₁ B_m) (hFinR₁ : Module.Finite A₁ ↥R₁) (hIntR₁ : Algebra.IsIntegral A₁ ↥R₁)
      (hLocR₁ : IsLocalization (Ideal.comap (algebraMap ↥R₁ B_m) (IsLocalRing.maximalIdeal B_m)).primeCompl B_m),
      ∃ θ : B_m, _root_.IsIntegral A₁ θ ∧
        IsLocalization
          (Ideal.comap (algebraMap ↥(Algebra.adjoin A₁ ({θ} : Set B_m)) B_m)
            (IsLocalRing.maximalIdeal B_m)).primeCompl B_m := by
    clear! A₀ B
    intro A₁ B_m _ _ _ _ _ _ hSep hMax R₁ hFinR₁ hIntR₁ hLocR₁
    haveI : Module.Finite A₁ ↥R₁ := hFinR₁
    haveI : Algebra.IsIntegral A₁ ↥R₁ := hIntR₁
    let m₁ : Ideal A₁ := IsLocalRing.maximalIdeal A₁
    let m_B : Ideal B_m := IsLocalRing.maximalIdeal B_m
    let κ : Type u := IsLocalRing.ResidueField A₁
    let κ' : Type u := IsLocalRing.ResidueField B_m
    let π : B_m →+* κ' := IsLocalRing.residue B_m
    let q₀ : Ideal ↥R₁ := Ideal.comap (algebraMap ↥R₁ B_m) m_B
    haveI : IsLocalization q₀.primeCompl B_m := hLocR₁
    have hq₀_prime : q₀.IsPrime := Ideal.comap_isPrime (algebraMap ↥R₁ B_m) m_B
    haveI : q₀.IsPrime := hq₀_prime
    have hm₁_le : m₁ ≤ Ideal.comap (algebraMap A₁ ↥R₁) q₀ := by
      intro a ha
      change algebraMap A₁ B_m a ∈ m_B
      exact (IsLocalRing.mem_maximalIdeal (algebraMap A₁ B_m a)).mpr
        (fun hu => (IsLocalRing.mem_maximalIdeal a).mp ha
          (isUnit_of_map_unit (algebraMap A₁ B_m) a hu))
    have hcomap_q₀ : Ideal.comap (algebraMap A₁ ↥R₁) q₀ = m₁ := by
      have hne_top : Ideal.comap (algebraMap A₁ ↥R₁) q₀ ≠ ⊤ :=
        (Ideal.comap_isPrime (algebraMap A₁ ↥R₁) q₀).ne_top
      exact ((IsLocalRing.maximalIdeal.isMaximal A₁).eq_of_le hne_top hm₁_le).symm
    have hq₀_max : q₀.IsMaximal := by
      refine Ideal.isMaximal_of_isIntegral_of_isMaximal_comap (algebraMap A₁ ↥R₁)
        (Algebra.isIntegral_def.mp hIntR₁) q₀ ?_
      rw [hcomap_q₀]
      exact IsLocalRing.maximalIdeal.isMaximal A₁
    have hπ_surj : Function.Surjective (π.comp (algebraMap ↥R₁ B_m)) := by
      intro y
      obtain ⟨z, rfl⟩ := IsLocalRing.residue_surjective y
      obtain ⟨⟨x, t⟩, hzt⟩ := IsLocalization.surj q₀.primeCompl z
      have hzt' : z * t.1.1 = x.1 := hzt
      have hsup : q₀ ⊔ Ideal.span {t.1} = ⊤ := by
        by_contra hne
        have hq_eq : q₀ = q₀ ⊔ Ideal.span {t.1} := hq₀_max.eq_of_le hne le_sup_left
        have ht_mem : t.1 ∈ q₀ ⊔ Ideal.span {t.1} :=
          Ideal.mem_sup_right (Ideal.mem_span_singleton_self t.1)
        rw [← hq_eq] at ht_mem
        exact t.2 ht_mem
      have h1 : (1 : ↥R₁) ∈ q₀ ⊔ Ideal.span {t.1} := hsup ▸ Submodule.mem_top
      rw [Submodule.mem_sup] at h1
      obtain ⟨q_el, hq_el, s_el, hs_el, hqs⟩ := h1
      rw [Ideal.mem_span_singleton] at hs_el
      obtain ⟨w, rfl⟩ := hs_el
      have hπq : π q_el.1 = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hq_el
      have hπtw : π (t.1.1 * w.1) = 1 := by
        have hval := congrArg (fun r : ↥R₁ => π r.1) hqs
        rw [map_mul]
        simpa [hπq] using hval
      refine ⟨x * w, ?_⟩
      change π (x.1 * w.1) = π z
      calc
        π (x.1 * w.1) = π ((z * t.1.1) * w.1) := by rw [hzt']
        _ = π z * π (t.1.1 * w.1) := by rw [mul_assoc, map_mul]
        _ = π z := by rw [hπtw, mul_one]
    let π_lin : ↥R₁ →ₗ[A₁] κ' :=
      { toFun := fun x => π x.1
        map_add' := fun x y => map_add π x.1 y.1
        map_smul' := fun a x => by
          rw [RingHom.id_apply, Algebra.smul_def, Algebra.smul_def,
            Submonoid.coe_mul, map_mul, IsScalarTower.algebraMap_apply A₁ B_m κ']
          rfl }
    haveI : Module.Finite A₁ κ' := Module.Finite.of_surjective π_lin hπ_surj
    haveI : IsScalarTower A₁ κ κ' := by
      refine IsScalarTower.of_algebraMap_eq fun a => ?_
      change π (algebraMap A₁ B_m a) =
        (IsLocalRing.ResidueField.map (algebraMap A₁ B_m)) (IsLocalRing.residue A₁ a)
      exact (IsLocalRing.ResidueField.map_residue (algebraMap A₁ B_m) a).symm
    haveI : Module.Finite κ κ' := Module.Finite.of_restrictScalars_finite A₁ κ κ'
    let I₁ : Ideal ↥R₁ := Ideal.map (algebraMap A₁ ↥R₁) m₁
    have hI₁_le_q₀ : I₁ ≤ q₀ := Ideal.map_le_iff_le_comap.mpr hm₁_le
    let F₀ : Type u := ↥R₁ ⧸ I₁
    let q_F : ↥R₁ →+* F₀ := Ideal.Quotient.mk I₁
    let qbar₀ : Ideal F₀ := Ideal.map q_F q₀
    have hcomap_qbar₀ : Ideal.comap q_F qbar₀ = q₀ := by
      rw [Ideal.comap_map_of_surjective q_F Ideal.Quotient.mk_surjective q₀]
      have hker : Ideal.comap q_F ⊥ = I₁ := Ideal.mk_ker
      rw [hker, sup_eq_left.mpr hI₁_le_q₀]
    have hqbar₀_prime : qbar₀.IsPrime := by
      refine Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective ?_
      simpa [q_F, Ideal.mk_ker] using hI₁_le_q₀
    haveI : qbar₀.IsPrime := hqbar₀_prime
    have hqbar₀_max : qbar₀.IsMaximal := by
      refine ⟨⟨hqbar₀_prime.ne_top, fun J hJ => ?_⟩⟩
      have hlt : q₀ < Ideal.comap q_F J := by
        rw [← hcomap_qbar₀]
        refine lt_of_le_of_ne (Ideal.comap_mono (le_of_lt hJ)) ?_
        intro heq
        apply ne_of_lt hJ
        ext z
        obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective z
        exact ⟨fun hr => le_of_lt hJ hr, fun hJ_mem => by
          have : r ∈ Ideal.comap q_F qbar₀ := heq ▸ hJ_mem
          rw [hcomap_qbar₀] at this
          exact Ideal.mem_map_of_mem q_F this⟩
      have htop : Ideal.comap q_F J = ⊤ := by
        by_contra hne
        exact ne_of_lt hlt (hq₀_max.eq_of_le hne (le_of_lt hlt))
      rw [Ideal.eq_top_iff_one] at htop ⊢
      exact htop
    let k₀ : Type u := A₁ ⧸ m₁
    letI : Field k₀ := Ideal.Quotient.field m₁
    let φ_kF : k₀ →+* F₀ := Ideal.Quotient.lift m₁ (q_F.comp (algebraMap A₁ ↥R₁)) (by
      intro a ha
      change Ideal.Quotient.mk I₁ (algebraMap A₁ ↥R₁ a) = 0
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem _ ha))
    letI : Algebra k₀ F₀ := φ_kF.toAlgebra
    haveI : IsScalarTower A₁ k₀ F₀ := by
      refine ⟨fun a x z => ?_⟩
      obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective x
      obtain ⟨w, rfl⟩ := Ideal.Quotient.mk_surjective z
      change q_F (algebraMap A₁ ↥R₁ (a * b)) * q_F w = q_F (a • (algebraMap A₁ ↥R₁ b * w))
      rw [← map_mul, Algebra.smul_def, map_mul (algebraMap A₁ ↥R₁), mul_assoc]
    let qF_lin : ↥R₁ →ₗ[A₁] F₀ :=
      { toFun := q_F
        map_add' := q_F.map_add
        map_smul' := fun a x => by
          change q_F (a • x) = a • q_F x
          rfl }
    haveI : Module.Finite A₁ F₀ := Module.Finite.of_surjective qF_lin Ideal.Quotient.mk_surjective
    haveI : Module.Finite k₀ F₀ := Module.Finite.of_restrictScalars_finite A₁ k₀ F₀
    have hNoeth_k₀ : IsNoetherian k₀ F₀ := inferInstance
    have hNoeth_F₀ : IsNoetherianRing F₀ := isNoetherian_of_tower k₀ hNoeth_k₀
    have hmB_ann : ∀ y ∈ Ideal.map (algebraMap A₁ B_m) m₁,
        ∃ (t : q₀.primeCompl) (u : ↥R₁), u ∈ I₁ ∧ y * t.1.1 = u.1 := by
      intro y hy
      refine Submodule.span_induction ?_ ?_ ?_ ?_ hy
      · rintro _ ⟨a, ha, rfl⟩
        exact ⟨1, algebraMap A₁ ↥R₁ a, Ideal.mem_map_of_mem _ ha, mul_one _⟩
      · exact ⟨1, 0, I₁.zero_mem, zero_mul _⟩
      · rintro y₁ y₂ _ _ ⟨t₁, u₁, hu₁, hy₁⟩ ⟨t₂, u₂, hu₂, hy₂⟩
        refine ⟨t₁ * t₂, u₁ * t₂.1 + u₂ * t₁.1,
          I₁.add_mem (I₁.mul_mem_right _ hu₁) (I₁.mul_mem_right _ hu₂), ?_⟩
        change (y₁ + y₂) * (t₁.1.1 * t₂.1.1) = u₁.1 * t₂.1.1 + u₂.1 * t₁.1.1
        calc
          (y₁ + y₂) * (t₁.1.1 * t₂.1.1) =
              (y₁ * t₁.1.1) * t₂.1.1 + (y₂ * t₂.1.1) * t₁.1.1 := by ring
          _ = u₁.1 * t₂.1.1 + u₂.1 * t₁.1.1 := by rw [hy₁, hy₂]
      · rintro c y₁ _ ⟨t₁, u₁, hu₁, hy₁⟩
        obtain ⟨⟨x_c, t_c⟩, hct⟩ := IsLocalization.surj q₀.primeCompl c
        have hct' : c * t_c.1.1 = x_c.1 := hct
        refine ⟨t_c * t₁, x_c * u₁, I₁.mul_mem_left _ hu₁, ?_⟩
        change (c * y₁) * (t_c.1.1 * t₁.1.1) = x_c.1 * u₁.1
        calc
          (c * y₁) * (t_c.1.1 * t₁.1.1) = (c * t_c.1.1) * (y₁ * t₁.1.1) := by ring
          _ = x_c.1 * u₁.1 := by rw [hct', hy₁]
    have hqbar₀_single_ann : ∀ z ∈ qbar₀, ∃ s ∉ qbar₀, s * z = 0 := by
      intro z hz
      obtain ⟨w, rfl⟩ := Ideal.Quotient.mk_surjective z
      have hw_q₀ : w ∈ q₀ := by rwa [← hcomap_qbar₀]
      have hw_mB : w.1 ∈ Ideal.map (algebraMap A₁ B_m) m₁ := by
        rw [hMax]; exact hw_q₀
      obtain ⟨t, u, hu, hwt⟩ := hmB_ann w.1 hw_mB
      have hwt_R : t.1 * w = u := Subtype.ext (by
        change t.1.1 * w.1 = u.1
        rw [mul_comm, hwt])
      refine ⟨q_F t.1, fun hmem => ?_, ?_⟩
      · let t_el : ↥R₁ := t.1
        have ht_c : t_el ∈ Ideal.comap q_F qbar₀ := hmem
        rw [hcomap_qbar₀] at ht_c
        exact t.2 ht_c
      · change q_F (t.1 * w) = 0
        rw [hwt_R]
        exact Ideal.Quotient.eq_zero_iff_mem.mpr hu
    obtain ⟨S_q, hS_q⟩ := hNoeth_F₀.noetherian qbar₀
    have hFin_ann : ∀ (S : Finset F₀), (S : Set F₀) ⊆ qbar₀ →
        ∃ s_ann ∉ qbar₀, ∀ g ∈ S, s_ann * g = 0 := by
      classical
      intro S
      refine Finset.induction_on S ?_ ?_
      · intro _
        exact ⟨1, hqbar₀_prime.ne_top ∘ qbar₀.eq_top_iff_one.mpr,
          fun _ hg => False.elim (by simp at hg)⟩
      · intro a S' haS' ih hsub
        have ha_mem : a ∈ qbar₀ := hsub (Finset.mem_insert_self a S')
        have hS'_sub : (S' : Set F₀) ⊆ qbar₀ :=
          Set.Subset.trans (Finset.subset_insert a S') hsub
        obtain ⟨s₁, hs₁_not, hs₁_a⟩ := hqbar₀_single_ann a ha_mem
        obtain ⟨s₂, hs₂_not, hs₂_S⟩ := ih hS'_sub
        refine ⟨s₁ * s₂, hqbar₀_prime.mul_notMem hs₁_not hs₂_not, ?_⟩
        intro g hg
        rcases Finset.mem_insert.mp hg with hga | hg'
        · rw [hga]
          calc
            (s₁ * s₂) * a = s₂ * (s₁ * a) := by ring
            _ = 0 := by rw [hs₁_a, mul_zero]
        · calc
            (s₁ * s₂) * g = s₁ * (s₂ * g) := by ring
            _ = 0 := by rw [hs₂_S g hg', mul_zero]
    have hSq_sub : (S_q : Set F₀) ⊆ qbar₀ := by
      rw [← hS_q]; exact Ideal.subset_span
    obtain ⟨s_ann, hs_ann_not, hs_ann_gen⟩ := hFin_ann S_q hSq_sub
    let J_ann : Ideal F₀ :=
      { carrier := {z : F₀ | s_ann * z = 0}
        add_mem' := fun {x y} hx hy => by
          change s_ann * (x + y) = 0
          rw [mul_add, hx, hy, add_zero]
        zero_mem' := mul_zero s_ann
        smul_mem' := fun c {x} hx => by
          change s_ann * (c * x) = 0
          calc
            s_ann * (c * x) = c * (s_ann * x) := by ring
            _ = 0 := by rw [hx, mul_zero] }
    have hqbar₀_le_J : qbar₀ ≤ J_ann := by
      rw [← hS_q, Ideal.span_le]
      intro g hg
      exact hs_ann_gen g hg
    have hsup_e : qbar₀ ⊔ Ideal.span {s_ann} = ⊤ := by
      by_contra hne
      have hq_eq : qbar₀ = qbar₀ ⊔ Ideal.span {s_ann} := hqbar₀_max.eq_of_le hne le_sup_left
      have hs_mem : s_ann ∈ qbar₀ ⊔ Ideal.span {s_ann} :=
        Ideal.mem_sup_right (Ideal.mem_span_singleton_self s_ann)
      exact hs_ann_not (hq_eq.symm ▸ hs_mem)
    have h1_F₀ : (1 : F₀) ∈ qbar₀ ⊔ Ideal.span {s_ann} := hsup_e ▸ Submodule.mem_top
    rw [Submodule.mem_sup] at h1_F₀
    obtain ⟨m₀, hm₀, e₀, he₀_span, hm₀_e₀⟩ := h1_F₀
    rw [Ideal.mem_span_singleton] at he₀_span
    obtain ⟨c₀, rfl⟩ := he₀_span
    let e_idem : F₀ := s_ann * c₀
    have he_ann : ∀ z ∈ qbar₀, e_idem * z = 0 := by
      intro z hz
      have hsz : s_ann * z = 0 := hqbar₀_le_J hz
      calc
        (s_ann * c₀) * z = c₀ * (s_ann * z) := by ring
        _ = 0 := by rw [hsz, mul_zero]
    have h1_sub_e : 1 - e_idem ∈ qbar₀ := by
      have : 1 - e_idem = m₀ := by
        rw [← hm₀_e₀]
        dsimp [e_idem]
        ring
      rw [this]; exact hm₀
    obtain ⟨r_e, hr_e⟩ := Ideal.Quotient.mk_surjective e_idem
    have h1_re_q₀ : 1 - r_e ∈ q₀ := by
      rw [← hcomap_qbar₀, Ideal.mem_comap, map_sub, map_one]
      simpa [q_F, hr_e] using h1_sub_e
    have hπ_re : π r_e.1 = 1 := by
      have h0 : π (1 - r_e.1) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr h1_re_q₀
      rw [map_sub, map_one, sub_eq_zero] at h0
      exact h0.symm
    haveI : Algebra.IsSeparable κ κ' := hSep
    obtain ⟨α₀, hα₀⟩ := Field.exists_primitive_element κ κ'
    classical
    let abar : κ' := if α₀ = 0 then 1 else α₀
    have habar_ne : abar ≠ 0 := by
      by_cases h0 : α₀ = 0 <;> simp [abar, h0]
    have habar_ifield : IntermediateField.adjoin κ ({abar} : Set κ') = ⊤ := by
      by_cases h0 : α₀ = 0
      · simp only [abar, h0, ↓reduceIte]
        rw [eq_top_iff, ← hα₀, h0, IntermediateField.adjoin_le_iff]
        intro x hx
        rw [Set.mem_singleton_iff] at hx
        rw [hx]
        exact (IntermediateField.adjoin κ ({(1 : κ')} : Set κ')).zero_mem
      · simpa [abar, h0] using hα₀
    have habar_alg : IsAlgebraic κ abar := (Algebra.IsAlgebraic.of_finite κ κ').isAlgebraic abar
    have habar_adjoin : Algebra.adjoin κ ({abar} : Set κ') = ⊤ := by
      rw [← IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic habar_alg, habar_ifield]
      rfl
    obtain ⟨r_α, hr_α⟩ := hπ_surj abar
    let θ₀ : ↥R₁ := r_α * r_e
    let θ : B_m := θ₀.1
    have hIntθ : _root_.IsIntegral A₁ θ := (hIntR₁.isIntegral θ₀).map R₁.val
    have hπ_θ : π θ = abar := by
      change π (r_α.1 * r_e.1) = abar
      rw [map_mul]
      change (π.comp (algebraMap ↥R₁ B_m)) r_α * π r_e.1 = abar
      rw [hr_α, hπ_re, mul_one]
    let S_θ : Subalgebra A₁ B_m := Algebra.adjoin A₁ ({θ} : Set B_m)
    have hSθ_le_R₁ : S_θ ≤ R₁ :=
      Algebra.adjoin_le (Set.singleton_subset_iff.mpr θ₀.2)
    let ι_θR : ↥S_θ →ₐ[A₁] ↥R₁ := Subalgebra.inclusion hSθ_le_R₁
    letI : Algebra ↥S_θ ↥R₁ := ι_θR.toRingHom.toAlgebra
    haveI : IsScalarTower A₁ ↥S_θ ↥R₁ := IsScalarTower.of_algebraMap_eq fun _ => rfl
    haveI : Algebra.IsIntegral ↥S_θ ↥R₁ := Algebra.IsIntegral.tower_top A₁
    let p_θ : Ideal ↥S_θ := Ideal.comap (algebraMap ↥S_θ B_m) m_B
    haveI : p_θ.IsPrime := Ideal.comap_isPrime (algebraMap ↥S_θ B_m) m_B
    let θ_S : ↥S_θ := ⟨θ, Algebra.self_mem_adjoin_singleton A₁ θ⟩
    have hθS_not_pθ : θ_S ∉ p_θ := by
      intro hmem
      have h0 : π θ = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hmem
      exact habar_ne (hπ_θ ▸ h0)
    have hGoingUpUnique : ∀ (Q' : Ideal ↥R₁) [Q'.IsPrime],
        Ideal.under ↥S_θ Q' ≤ p_θ → Q' ≤ q₀ := by
      intro Q' _ hQ'_le
      obtain ⟨Q'', hQ'_le_Q'', hQ''_prime, hQ''_under⟩ :=
        Ideal.exists_ideal_over_prime_of_isIntegral_of_isPrime p_θ Q' hQ'_le
      haveI : Q''.IsPrime := hQ''_prime
      have hI₁_le_Q'' : I₁ ≤ Q'' := by
        rw [Ideal.map_le_iff_le_comap]
        intro a ha
        have ha_pθ : algebraMap A₁ ↥S_θ a ∈ p_θ := by
          change algebraMap A₁ B_m a ∈ m_B
          exact hm₁_le ha
        rw [← hQ''_under] at ha_pθ
        exact ha_pθ
      let Qbar'' : Ideal F₀ := Ideal.map q_F Q''
      have hcomap_Qbar'' : Ideal.comap q_F Qbar'' = Q'' := by
        rw [Ideal.comap_map_of_surjective q_F Ideal.Quotient.mk_surjective Q'']
        have hker : Ideal.comap q_F ⊥ = I₁ := Ideal.mk_ker
        rw [hker, sup_eq_left.mpr hI₁_le_Q'']
      have hQbar''_prime : Qbar''.IsPrime := by
        refine Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective ?_
        simpa [q_F, Ideal.mk_ker] using hI₁_le_Q''
      haveI : Qbar''.IsPrime := hQbar''_prime
      have hqbar₀_le_Qbar'' : qbar₀ ≤ Qbar'' := by
        by_contra hnot
        rw [SetLike.not_le_iff_exists] at hnot
        obtain ⟨z, hz_q₀, hz_not⟩ := hnot
        have he_mem : e_idem ∈ Qbar'' := by
          have hmul : e_idem * z ∈ Qbar'' := by rw [he_ann z hz_q₀]; exact Qbar''.zero_mem
          exact (hQbar''_prime.mem_or_mem hmul).resolve_right hz_not
        have hθ₀_F : q_F θ₀ ∈ Qbar'' := by
          change q_F (r_α * r_e) ∈ Qbar''
          rw [map_mul, hr_e]
          exact Qbar''.mul_mem_left _ he_mem
        have hθ₀_Q'' : θ₀ ∈ Q'' := by rwa [← hcomap_Qbar'']
        have hθS_pθ : θ_S ∈ p_θ := by
          rw [← hQ''_under]
          exact hθ₀_Q''
        exact hθS_not_pθ hθS_pθ
      have hqbar₀_eq : qbar₀ = Qbar'' := hqbar₀_max.eq_of_le hQbar''_prime.ne_top hqbar₀_le_Qbar''
      have hq₀_eq : q₀ = Q'' := by
        rw [← hcomap_qbar₀, hqbar₀_eq, hcomap_Qbar'']
      exact hQ'_le_Q''.trans_eq hq₀_eq.symm
    let M_θ : Submonoid ↥R₁ := p_θ.primeCompl.map (algebraMap ↥S_θ ↥R₁)
    let T₀ : Type u := Localization M_θ
    have hClearDenom : ∀ t : q₀.primeCompl,
        ∃ (u₀ : ↥R₁) (s_θ : p_θ.primeCompl), t.1.1 * u₀.1 = s_θ.1.1 := by
      intro t
      have hunit : IsUnit (algebraMap ↥R₁ T₀ t.1) := by
        by_contra hnot
        have hne_top : Ideal.span {algebraMap ↥R₁ T₀ t.1} ≠ ⊤ :=
          mt Ideal.span_singleton_eq_top.mp hnot
        obtain ⟨M_max, hM_max, hle_M⟩ := Ideal.exists_le_maximal _ hne_top
        haveI : M_max.IsPrime := hM_max.isPrime
        let Q' : Ideal ↥R₁ := Ideal.comap (algebraMap ↥R₁ T₀) M_max
        haveI : Q'.IsPrime := Ideal.comap_isPrime _ M_max
        have ht_Q' : t.1 ∈ Q' :=
          hle_M (Ideal.mem_span_singleton_self _)
        have hQ'_under : Ideal.under ↥S_θ Q' ≤ p_θ := by
          intro s hs
          by_contra hs_not
          have hm_mem : algebraMap ↥S_θ ↥R₁ s ∈ M_θ := ⟨s, hs_not, rfl⟩
          have hs_unit : IsUnit (algebraMap ↥R₁ T₀ (algebraMap ↥S_θ ↥R₁ s)) :=
            IsLocalization.map_units T₀ ⟨_, hm_mem⟩
          exact hM_max.ne_top (M_max.eq_top_of_isUnit_mem hs hs_unit)
        exact t.2 (hGoingUpUnique Q' hQ'_under ht_Q')
      obtain ⟨u_inv, hu_inv⟩ := hunit
      let w : T₀ := ↑(u_inv⁻¹)
      have htw : algebraMap ↥R₁ T₀ t.1 * w = 1 := by
        dsimp [w]; rw [← hu_inv, Units.mul_inv]
      obtain ⟨⟨u₁, m₁_t⟩, hwm⟩ := IsLocalization.surj M_θ w
      have heq_T₀ : algebraMap ↥R₁ T₀ (t.1 * u₁) = algebraMap ↥R₁ T₀ m₁_t.1 := by
