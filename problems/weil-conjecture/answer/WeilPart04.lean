          have hh_T : h_pol T_pol = algebraMap (MvPolynomial (Fin 2) ↥V ⧸ I_nod) L_nod X0_bar := by
            simp [h_pol, T_pol]
          rw [hh_T]
          exact IsLocalization.map_units L_nod ⟨X0_bar, Submonoid.mem_powers X0_bar⟩
        let f_inv : L_pol →+* L_nod := IsLocalization.Away.lift T_pol hh_T_unit
        have hf_inv_to : f_inv.comp f_to = RingHom.id L_nod := by
          apply IsLocalization.ringHom_ext (Submonoid.powers X0_bar)
          rw [RingHom.id_comp, RingHom.comp_assoc]
          apply Ideal.Quotient.ringHom_ext
          apply MvPolynomial.ringHom_ext'
          · ext r
            have hg_Cr : g_nod (Ideal.Quotient.mk I_nod (MvPolynomial.C r)) =
                algebraMap (Polynomial ↥V) L_pol (Polynomial.C r) := by
              change g_mv_alg (MvPolynomial.C r) = _
              exact MvPolynomial.aeval_C _ r
            change f_inv (f_to (algebraMap (MvPolynomial (Fin 2) ↥V ⧸ I_nod) L_nod
                (Ideal.Quotient.mk I_nod (MvPolynomial.C r)))) =
              algebraMap (MvPolynomial (Fin 2) ↥V ⧸ I_nod) L_nod
                (Ideal.Quotient.mk I_nod (MvPolynomial.C r))
            rw [IsLocalization.Away.lift_eq, hg_Cr, IsLocalization.Away.lift_eq]
            simp only [h_pol, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
