      (ψ₁ : CommRingCat.of A₀ ⟶ R₁)
      (m₀ : PrimeSpectrum A₀),
      C₀.FiniteType →
      G₀ ⊆ m₀.asIdeal →
      Subring.closure (Set.range C₀ ∪ G₀) = ⊤ →
      ψ₁.hom.Etale →
      W₁.toSpecΓ ≫ AlgebraicGeometry.Spec.map ψ₁ ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom C₀) = g_W₁ →
