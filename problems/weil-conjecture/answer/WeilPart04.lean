    let ρ : ↥C →ₐ[↥W] (I → ↥W) :=
      { toFun := fun c i => ⟨Φ_K c i, hΦ_mem c i⟩
        map_one' := funext fun i => Subtype.ext (congrFun (map_one Φ_K) i)
        map_mul' := fun x y => funext fun i => Subtype.ext (congrFun (map_mul Φ_K x y) i)
        map_zero' := funext fun i => Subtype.ext (congrFun (map_zero Φ_K) i)
        map_add' := fun x y => funext fun i => Subtype.ext (congrFun (map_add Φ_K x y) i)
        commutes' := fun w => funext fun i => Subtype.ext (congrFun (Φ_K.commutes w) i) }
    have hρ_inj : Function.Injective ρ := by
      intro x y hxy
      apply hΦ_inj
      ext i
      exact congrArg Subtype.val (congrFun hxy i)
    let _ : Algebra ↥C (I → ↥W) := ρ.toRingHom.toAlgebra
    have _ : IsScalarTower ↥W ↥C (I → ↥W) := IsScalarTower.of_algebraMap_eq (fun w => (ρ.commutes w).symm)
    have _ : Module.Finite ↥W (I → ↥W) := Module.Finite.pi
    have _ : Algebra.IsIntegral ↥W (I → ↥W) := inferInstance
    have _ : Algebra.IsIntegral ↥C (I → ↥W) := Algebra.IsIntegral.tower_top ↥W
    let 𝔪_C : Ideal ↥C := Ideal.comap C.val.toRingHom 𝔪_fib
