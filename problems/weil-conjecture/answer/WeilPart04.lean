        change ((hW₁.fromSpec ≫ g_ss).base y).asIdeal = _
        rw [hFromSpec_gss]
        rfl
      rw [hIdeal, hbot]
      ext r
      simp only [Ideal.mem_comap, Ideal.mem_bot]
      exact map_eq_zero_iff ι_VP (Subring.inclusion_injective _)
    obtain ⟨⟨hHens_m₀, hMax_m₀⟩, hGood_hens⟩ :=
      weil_finite_closed_locus_quotient_henselian_and_maximal
        K m V_P hPkg_VP A₀ B₁ C₀ ψ₁.hom hFT_B₁ m₀.asIdeal hm₀_comap
        G₀ hG₀_m₀ hG₀_gen p₀ hp₀_m₀ M₁ hM₁_cl hM₁_fin hM₁_ne_bot
    have hRes_A₀ : ∀ b : B₁, ∃ a : A₀, b - ψ₁.hom a ∈ p₀.asIdeal := by
      intro b
      obtain ⟨r, hr⟩ := hRes_p₀ b
      exact ⟨C₀ r, hr⟩
    obtain ⟨h₀, hh₀_notMem, hh₀_uniq⟩ :=
      @weil_henselian_etale_quotient_singleton_fiber_away
        A₀ B₁ _ _ ψ₁.hom hEt p₀.asIdeal p₀.isPrime hRes_A₀ m₀.asIdeal m₀.isPrime
        hp₀_m₀.symm.le hHens_m₀ (hMax_m₀.trans hp₀_m₀.symm)
    let F_M : Finset (PrimeSpectrum B₁) := hM₁_fin.toFinset
    let F_bad : Finset (PrimeSpectrum B₁) := F_M.filter (fun z => ¬ (z.asIdeal ≤ p₀.asIdeal))
    let F_good : Finset (PrimeSpectrum B₁) := F_M.filter (fun y => y.asIdeal ≤ p₀.asIdeal)
    have hex_bad : ∀ z : PrimeSpectrum B₁, ¬ (z.asIdeal ≤ p₀.asIdeal) →
        ∃ g : B₁, g ∈ z.asIdeal ∧ g ∉ p₀.asIdeal := by
      intro z hz
      exact Set.not_subset.mp hz
    let g_bad : PrimeSpectrum B₁ → B₁ := fun z =>
      if hz : ¬ (z.asIdeal ≤ p₀.asIdeal) then (hex_bad z hz).choose else 1
    have hg_bad_mem : ∀ z ∈ F_bad, g_bad z ∈ z.asIdeal := by
      intro z hz
      have hz' : ¬ (z.asIdeal ≤ p₀.asIdeal) := (Finset.mem_filter.mp hz).2
      dsimp only [g_bad]
      rw [dite_eq_left_of_eq_true (eq_true hz')]
      exact (hex_bad z hz').choose_spec.1
    have hg_bad_notMem : ∀ z ∈ F_bad, g_bad z ∉ p₀.asIdeal := by
      intro z hz
      have hz' : ¬ (z.asIdeal ≤ p₀.asIdeal) := (Finset.mem_filter.mp hz).2
      dsimp only [g_bad]
      rw [dite_eq_left_of_eq_true (eq_true hz')]
      exact (hex_bad z hz').choose_spec.2
    have hex_good : ∀ y : PrimeSpectrum B₁, y ∈ M₁ ∧ y.asIdeal ≤ p₀.asIdeal →
        ∃ h : B₁, h ∉ p₀.asIdeal ∧
          ∀ (g : B₁), g ∉ p₀.asIdeal →
            ∀ (p₁ p₂ : PrimeSpectrum B₁),
              h * g ∉ p₁.asIdeal →
              h * g ∉ p₂.asIdeal →
              Ideal.comap ψ₁.hom p₁.asIdeal = Ideal.comap ψ₁.hom y.asIdeal →
              Ideal.comap ψ₁.hom p₂.asIdeal = Ideal.comap ψ₁.hom y.asIdeal →
              p₁ = p₂ := by
      intro y ⟨hyM, hyle⟩
      obtain ⟨hHens_y, hMax_y⟩ := hGood_hens y hyM hyle
      have hPrime_y : (Ideal.comap ψ₁.hom y.asIdeal).IsPrime := Ideal.comap_isPrime ψ₁.hom y.asIdeal
      exact @weil_henselian_etale_quotient_singleton_fiber_away
        A₀ B₁ _ _ ψ₁.hom hEt p₀.asIdeal p₀.isPrime hRes_A₀
        (Ideal.comap ψ₁.hom y.asIdeal) hPrime_y (Ideal.comap_mono hyle)
