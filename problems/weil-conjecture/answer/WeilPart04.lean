      have hpi_hat_ker : ∀ G ∈ Ibar_a, pi_hat G = 0 := by
        intro G hG
        rw [← RingHom.mem_ker]
        refine Ideal.span_le.mpr ?_ hG
        rintro _ rfl
        simp only [SetLike.mem_coe, RingHom.mem_ker, pi_hat, map_sub, map_mul,
