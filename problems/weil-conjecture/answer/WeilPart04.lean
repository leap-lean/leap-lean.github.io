by
  have hNodalDom : ∀ (R : Type u) [CommRing R] [IsDomain R] (a : R), a ≠ 0 →
      IsDomain (MvPolynomial (Fin 2) R ⧸ Ideal.span
        {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}) := by
    intro R _ _ a ha
    let I_a : Ideal (MvPolynomial (Fin 2) R) :=
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}
    let A_a := MvPolynomial (Fin 2) R ⧸ I_a
    let mk : MvPolynomial (Fin 2) R →+* A_a := Ideal.Quotient.mk I_a
    have hprod : mk (MvPolynomial.X 0) * mk (MvPolynomial.X 1) = mk (MvPolynomial.C a) := by
      rw [← map_mul, ← sub_eq_zero, ← map_sub]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
    let S_loc := Localization.Away (Polynomial.X : Polynomial R)
    have hSub : Submonoid.powers (Polynomial.X : Polynomial R) ≤ nonZeroDivisors (Polynomial R) := by
      rintro _ ⟨n, rfl⟩
      exact mem_nonZeroDivisors_iff_ne_zero.mpr (pow_ne_zero n Polynomial.X_ne_zero)
    haveI : IsDomain S_loc := IsLocalization.isDomain_of_le_nonZeroDivisors S_loc hSub
    have hInj_loc : Function.Injective (algebraMap (Polynomial R) S_loc) :=
      IsLocalization.injective S_loc hSub
    let ιP : Polynomial R →+* S_loc := algebraMap (Polynomial R) S_loc
    let uX : S_loc := ιP Polynomial.X
    let invX : S_loc := IsLocalization.Away.invSelf (S := S_loc) (Polynomial.X : Polynomial R)
    let vX : S_loc := ιP (Polynomial.C a) * invX
    have hu_inv : uX * invX = 1 :=
      IsLocalization.Away.mul_invSelf (S := S_loc) (Polynomial.X : Polynomial R)
    let θ_raw : MvPolynomial (Fin 2) R →+* S_loc :=
      MvPolynomial.eval₂Hom (ιP.comp Polynomial.C) ![uX, vX]
    have hθ_ker : ∀ p ∈ I_a, θ_raw p = 0 := by
      intro p hp
      rw [Ideal.mem_span_singleton] at hp
      rcases hp with ⟨q, rfl⟩
      have hgen : θ_raw (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a) = 0 := by
        simp only [θ_raw, map_sub, map_mul, MvPolynomial.coe_eval₂Hom,
          MvPolynomial.eval₂_X, MvPolynomial.eval₂_C, RingHom.comp_apply,
          Matrix.cons_val_zero, Matrix.cons_val_one]
        calc uX * (ιP (Polynomial.C a) * invX) - ιP (Polynomial.C a)
            = ιP (Polynomial.C a) * (uX * invX) - ιP (Polynomial.C a) := by ring
          _ = 0 := by rw [hu_inv, mul_one, sub_self]
      rw [map_mul, hgen, zero_mul]
    let θ : A_a →+* S_loc := Ideal.Quotient.lift I_a θ_raw hθ_ker
    let φ_b : ℕ → ℕ → A_a := fun N j =>
      if j < N then mk (MvPolynomial.X 1) ^ (N - j) else mk (MvPolynomial.X 0) ^ (j - N)
    have hφ_shift : ∀ (N₁ N j : ℕ), N₁ ≤ N → φ_b N (j + (N - N₁)) = φ_b N₁ j := by
      intro N₁ N j _
      dsimp [φ_b]
      split_ifs with h1 h2
      · congr 1; omega
      · omega
      · omega
      · congr 1; omega
    have hθ_φ : ∀ (N j : ℕ), j < 2 * N + 1 →
        θ (φ_b N j) * uX ^ N =
          ιP (Polynomial.C (if j < N then a ^ (N - j) else 1) * Polynomial.X ^ j) := by
      intro N j _
      dsimp [φ_b]
      split_ifs with hj
      · have hθ1 : θ (mk (MvPolynomial.X 1)) = vX := by
          change θ_raw (MvPolynomial.X 1) = vX
          simp [θ_raw]
        have hN : N = (N - j) + j := by omega
        rw [map_pow, hθ1]
        calc vX ^ (N - j) * uX ^ N
            = (ιP (Polynomial.C a) * invX) ^ (N - j) * uX ^ ((N - j) + j) := by
                rw [← hN]
          _ = ιP (Polynomial.C a) ^ (N - j) * (uX * invX) ^ (N - j) * uX ^ j := by
                rw [pow_add]; ring
          _ = ιP (Polynomial.C a) ^ (N - j) * uX ^ j := by
                rw [hu_inv, one_pow, mul_one]
          _ = ιP (Polynomial.C (a ^ (N - j)) * Polynomial.X ^ j) := by
                simp [uX, map_mul, map_pow]
      · have hθ0 : θ (mk (MvPolynomial.X 0)) = uX := by
          change θ_raw (MvPolynomial.X 0) = uX
          simp [θ_raw]
        have hjN : (j - N) + N = j := by omega
        rw [map_pow, hθ0, ← pow_add, hjN]
        simp [uX, map_pow]
    have hmon : ∀ (i j : ℕ),
        (j ≤ i ∧ mk (MvPolynomial.X 0) ^ i * mk (MvPolynomial.X 1) ^ j =
          mk (MvPolynomial.C (a ^ j)) * mk (MvPolynomial.X 0) ^ (i - j)) ∨
        (i < j ∧ mk (MvPolynomial.X 0) ^ i * mk (MvPolynomial.X 1) ^ j =
          mk (MvPolynomial.C (a ^ i)) * mk (MvPolynomial.X 1) ^ (j - i)) := by
      intro i
      induction i with
      | zero =>
        intro j
        cases j with
        | zero => left; simp
        | succ j' => right; refine ⟨Nat.zero_lt_succ j', ?_⟩; simp
      | succ i ih =>
        intro j
        cases j with
        | zero => left; simp
        | succ j' =>
          have hstep : mk (MvPolynomial.X 0) ^ (i + 1) * mk (MvPolynomial.X 1) ^ (j' + 1) =
              mk (MvPolynomial.C a) * (mk (MvPolynomial.X 0) ^ i * mk (MvPolynomial.X 1) ^ j') := by
            calc mk (MvPolynomial.X 0) ^ (i + 1) * mk (MvPolynomial.X 1) ^ (j' + 1)
                = (mk (MvPolynomial.X 0) * mk (MvPolynomial.X 1)) *
                    (mk (MvPolynomial.X 0) ^ i * mk (MvPolynomial.X 1) ^ j') := by
                      rw [pow_succ, pow_succ]; ring
              _ = mk (MvPolynomial.C a) *
                    (mk (MvPolynomial.X 0) ^ i * mk (MvPolynomial.X 1) ^ j') := by
                      rw [hprod]
          rcases ih j' with ⟨hle, heq⟩ | ⟨hlt, heq⟩
          · left
            refine ⟨Nat.succ_le_succ hle, ?_⟩
            rw [hstep, heq, ← mul_assoc, ← map_mul, ← MvPolynomial.C_mul, ← pow_succ',
              Nat.succ_sub_succ_eq_sub]
          · right
            refine ⟨Nat.succ_lt_succ hlt, ?_⟩
            rw [hstep, heq, ← mul_assoc, ← map_mul, ← MvPolynomial.C_mul, ← pow_succ',
              Nat.succ_sub_succ_eq_sub]
    have hpad : ∀ {z : A_a} (N₁ N : ℕ) (b₁ : ℕ → R),
        N₁ ≤ N →
        z = (∑ j ∈ Finset.range (2 * N₁ + 1), mk (MvPolynomial.C (b₁ j)) * φ_b N₁ j) →
        ∃ b' : ℕ → R,
          z = ∑ k ∈ Finset.range (2 * N + 1), mk (MvPolynomial.C (b' k)) * φ_b N k := by
      intro z N₁ N b₁ hle hz
      let δ := N - N₁
      let b' : ℕ → R := fun k => if δ ≤ k ∧ k < δ + (2 * N₁ + 1) then b₁ (k - δ) else 0
      refine ⟨b', ?_⟩
      let S_img : Finset ℕ :=
        (Finset.range (2 * N₁ + 1)).map ⟨fun j => j + δ, add_left_injective δ⟩
      have hsub : S_img ⊆ Finset.range (2 * N + 1) := by
        intro k hk
        rcases Finset.mem_map.mp hk with ⟨j, hj, rfl⟩
        rw [Finset.mem_range] at hj ⊢
        dsimp [δ]
        omega
      have hzero : ∀ k ∈ Finset.range (2 * N + 1), k ∉ S_img →
          mk (MvPolynomial.C (b' k)) * φ_b N k = 0 := by
        intro k _ hk_not
        have hnot_cond : ¬ (δ ≤ k ∧ k < δ + (2 * N₁ + 1)) := by
          rintro ⟨h1, h2⟩
          apply hk_not
          refine Finset.mem_map.mpr ⟨k - δ, Finset.mem_range.mpr (by omega), ?_⟩
          dsimp
          omega
        simp [b', hnot_cond]
      rw [← Finset.sum_subset hsub hzero, Finset.sum_map, hz]
      refine Finset.sum_congr rfl (fun j hj => ?_)
      rw [Finset.mem_range] at hj
      have hcond : δ ≤ j + δ ∧ j + δ < δ + (2 * N₁ + 1) := by omega
      have hb : b' (j + δ) = b₁ j := by
        dsimp [b']
        rw [ite_cond_eq_true _ _ (eq_true hcond), Nat.add_sub_cancel]
      dsimp
      rw [hb, hφ_shift N₁ N j hle]
    have hnf : ∀ z : A_a, ∃ (N : ℕ) (b : ℕ → R),
        z = ∑ k ∈ Finset.range (2 * N + 1), mk (MvPolynomial.C (b k)) * φ_b N k := by
      intro z
      refine Quotient.inductionOn' z (fun p => ?_)
      change ∃ (N : ℕ) (b : ℕ → R),
        mk p = ∑ k ∈ Finset.range (2 * N + 1), mk (MvPolynomial.C (b k)) * φ_b N k
      refine MvPolynomial.induction_on' p (fun s r => ?_) (fun p₁ p₂ ih₁ ih₂ => ?_)
      · have hmon_eq : mk (MvPolynomial.monomial s r) =
            mk (MvPolynomial.C r) * (mk (MvPolynomial.X 0) ^ (s 0) * mk (MvPolynomial.X 1) ^ (s 1)) := by
          rw [MvPolynomial.monomial_eq, Finsupp.prod_fintype _ _ (fun _ => pow_zero _),
            Fin.prod_univ_two, map_mul, map_mul, map_pow, map_pow]
        rw [hmon_eq]
        rcases hmon (s 0) (s 1) with ⟨hle, heq⟩ | ⟨hlt, heq⟩
        · let N := s 0 - s 1
          refine ⟨N, fun k => if k = 2 * N then r * a ^ (s 1) else 0, ?_⟩
          rw [Finset.sum_eq_single (2 * N)]
          · have hnot : ¬ (2 * N < N) := by omega
            have hsub_N : 2 * N - N = N := by omega
            simp only [↓reduceIte, φ_b, hnot, hsub_N]
            rw [heq, ← mul_assoc, ← map_mul, MvPolynomial.C_mul]
          · intro k _ hk_ne
            simp [hk_ne]
          · intro hnot_mem
            exfalso
            exact hnot_mem (Finset.mem_range.mpr (by omega))
        · let N := s 1 - s 0
          refine ⟨N, fun k => if k = 0 then r * a ^ (s 0) else 0, ?_⟩
          rw [Finset.sum_eq_single 0]
          · have hpos_N : 0 < N := by omega
            simp only [↓reduceIte, φ_b, hpos_N, Nat.sub_zero]
            rw [heq, ← mul_assoc, ← map_mul, MvPolynomial.C_mul]
          · intro k _ hk_ne
            simp [hk_ne]
          · intro hnot_mem
            exfalso
            exact hnot_mem (Finset.mem_range.mpr (by omega))
      · obtain ⟨N₁, b₁, hb₁⟩ := ih₁
        obtain ⟨N₂, b₂, hb₂⟩ := ih₂
        let N := max N₁ N₂
        obtain ⟨b₁', hb₁'⟩ := hpad N₁ N b₁ (le_max_left N₁ N₂) hb₁
        obtain ⟨b₂', hb₂'⟩ := hpad N₂ N b₂ (le_max_right N₁ N₂) hb₂
        refine ⟨N, fun k => b₁' k + b₂' k, ?_⟩
        rw [map_add, hb₁', hb₂', ← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl (fun k _ => ?_)
        rw [MvPolynomial.C_add, map_add, add_mul]
    have hθ_inj : Function.Injective θ := by
      rw [injective_iff_map_eq_zero]
      intro z hz
      obtain ⟨N, b, rfl⟩ := hnf z
      have hz_mul : θ (∑ k ∈ Finset.range (2 * N + 1), mk (MvPolynomial.C (b k)) * φ_b N k) *
          uX ^ N = 0 := by
        rw [hz, zero_mul]
      have hsum_P : θ (∑ k ∈ Finset.range (2 * N + 1), mk (MvPolynomial.C (b k)) * φ_b N k) *
          uX ^ N =
          ιP (∑ k ∈ Finset.range (2 * N + 1),
            Polynomial.C (b k * if k < N then a ^ (N - k) else 1) * Polynomial.X ^ k) := by
        rw [map_sum, Finset.sum_mul, map_sum]
        refine Finset.sum_congr rfl (fun k hk => ?_)
        rw [Finset.mem_range] at hk
        have hθC : θ (mk (MvPolynomial.C (b k))) = ιP (Polynomial.C (b k)) := by
          change θ_raw (MvPolynomial.C (b k)) = _
          simp [θ_raw]
        rw [map_mul, mul_assoc, hθ_φ N k hk, hθC, ← map_mul, ← mul_assoc, ← Polynomial.C_mul]
      rw [hsum_P, ← map_zero ιP] at hz_mul
      have hQ0 := hInj_loc hz_mul
      refine Finset.sum_eq_zero (fun k₀ hk₀ => ?_)
      have hcoeff : Polynomial.coeff
          (∑ k ∈ Finset.range (2 * N + 1),
            Polynomial.C (b k * if k < N then a ^ (N - k) else 1) * Polynomial.X ^ k) k₀ = 0 := by
        rw [hQ0, Polynomial.coeff_zero]
      rw [Polynomial.finset_sum_coeff, Finset.sum_eq_single k₀] at hcoeff
      · rw [Polynomial.coeff_C_mul_X_pow, ite_cond_eq_true _ _ (eq_true rfl)] at hcoeff
        have hne : (if k₀ < N then a ^ (N - k₀) else 1) ≠ 0 := by
          split_ifs
          · exact pow_ne_zero _ ha
          · exact one_ne_zero
        have hb0 : b k₀ = 0 := (mul_eq_zero.mp hcoeff).resolve_right hne
        simp [hb0]
      · intro k _ hk_ne
        rw [Polynomial.coeff_C_mul_X_pow, ite_cond_eq_false _ _ (eq_false hk_ne.symm)]
      · intro hnot
        exact absurd hk₀ hnot
    exact Function.Injective.isDomain θ hθ_inj
  have hPolyPush : ∀ (R S : Type u) [CommRing R] [CommRing S] (φ : R →+* S),
      CategoryTheory.IsPushout
        (CommRingCat.ofHom φ)
        (CommRingCat.ofHom (Polynomial.C : R →+* Polynomial R))
        (CommRingCat.ofHom (Polynomial.C : S →+* Polynomial S))
        (CommRingCat.ofHom (Polynomial.mapRingHom φ)) := by
    intro R S _ _ φ
    have hcomm : CommRingCat.ofHom φ ≫ CommRingCat.ofHom (Polynomial.C : S →+* Polynomial S) =
        CommRingCat.ofHom (Polynomial.C : R →+* Polynomial R) ≫
          CommRingCat.ofHom (Polynomial.mapRingHom φ) := by
      rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, Polynomial.mapRingHom_comp_C]
    refine ⟨⟨hcomm⟩, ⟨CategoryTheory.Limits.PushoutCocone.IsColimit.mk hcomm
      (fun c => CommRingCat.ofHom
        (Polynomial.eval₂RingHom c.inl.hom (c.inr.hom Polynomial.X)))
      (fun c => ?_) (fun c => ?_) (fun c m hm_inl hm_inr => ?_)⟩⟩
    · apply CommRingCat.hom_ext
      ext s
      simp
    · apply CommRingCat.hom_ext
      apply Polynomial.ringHom_ext'
      · ext r
        change Polynomial.eval₂ c.inl.hom (c.inr.hom Polynomial.X)
          (Polynomial.mapRingHom φ (Polynomial.C r)) = c.inr.hom (Polynomial.C r)
        rw [Polynomial.coe_mapRingHom, Polynomial.map_C, Polynomial.eval₂_C]
        exact RingHom.congr_fun (congrArg CommRingCat.Hom.hom c.condition) r
      · change Polynomial.eval₂ c.inl.hom (c.inr.hom Polynomial.X)
          (Polynomial.mapRingHom φ Polynomial.X) = c.inr.hom Polynomial.X
        rw [Polynomial.coe_mapRingHom, Polynomial.map_X, Polynomial.eval₂_X]
    · apply CommRingCat.hom_ext
      apply Polynomial.ringHom_ext'
      · ext s
        have h1 := RingHom.congr_fun (congrArg CommRingCat.Hom.hom hm_inl) s
        simpa [Polynomial.eval₂_C] using h1
      · have h2 := RingHom.congr_fun (congrArg CommRingCat.Hom.hom hm_inr) Polynomial.X
        simpa [Polynomial.coe_mapRingHom, Polynomial.map_X, Polynomial.eval₂_X] using h2
  have hNodalPush : ∀ (R S : Type u) [CommRing R] [CommRing S] (φ : R →+* S) (a : R),
      ∃ (f_A : (MvPolynomial (Fin 2) R ⧸ Ideal.span
          {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}) →+*
        (MvPolynomial (Fin 2) S ⧸ Ideal.span
          {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C (φ a)})),
        CategoryTheory.IsPushout
          (CommRingCat.ofHom φ)
          (CommRingCat.ofHom ((Ideal.Quotient.mk (Ideal.span
            {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a})).comp MvPolynomial.C))
          (CommRingCat.ofHom ((Ideal.Quotient.mk (Ideal.span
            {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C (φ a)})).comp MvPolynomial.C))
          (CommRingCat.ofHom f_A) := by
    intro R S _ _ φ a
    let I_R : Ideal (MvPolynomial (Fin 2) R) :=
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a}
    let I_S : Ideal (MvPolynomial (Fin 2) S) :=
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C (φ a)}
    have h0_R : Ideal.Quotient.mk I_R
        (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
    have h0_S : Ideal.Quotient.mk I_S
        (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C (φ a)) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
    have hmap_ker : ∀ p ∈ I_R,
        ((Ideal.Quotient.mk I_S).comp (MvPolynomial.map φ)) p = 0 := by
      intro p hp
      rw [Ideal.mem_span_singleton] at hp
      rcases hp with ⟨q, rfl⟩
      have hgen : MvPolynomial.map φ
          (MvPolynomial.X (0 : Fin 2) * MvPolynomial.X 1 - MvPolynomial.C a) =
          MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C (φ a) := by
        simp [MvPolynomial.map_X, MvPolynomial.map_C]
      change Ideal.Quotient.mk I_S
        (MvPolynomial.map φ ((MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a) * q)) = 0
      rw [map_mul, hgen, map_mul, h0_S, zero_mul]
    let f_A : (MvPolynomial (Fin 2) R ⧸ I_R) →+* (MvPolynomial (Fin 2) S ⧸ I_S) :=
      Ideal.Quotient.lift I_R ((Ideal.Quotient.mk I_S).comp (MvPolynomial.map φ)) hmap_ker
    have hcomm : CommRingCat.ofHom φ ≫
        CommRingCat.ofHom ((Ideal.Quotient.mk I_S).comp MvPolynomial.C) =
        CommRingCat.ofHom ((Ideal.Quotient.mk I_R).comp MvPolynomial.C) ≫
          CommRingCat.ofHom f_A := by
      apply CommRingCat.hom_ext
      ext r
      change Ideal.Quotient.mk I_S (MvPolynomial.C (φ r)) =
        Ideal.Quotient.mk I_S (MvPolynomial.map φ (MvPolynomial.C r))
      rw [MvPolynomial.map_C]
    have hl_ker : ∀ (c : CategoryTheory.Limits.PushoutCocone (CommRingCat.ofHom φ)
        (CommRingCat.ofHom ((Ideal.Quotient.mk I_R).comp MvPolynomial.C))),
        ∀ p ∈ I_S,
          MvPolynomial.eval₂Hom c.inl.hom
            (fun j => c.inr.hom (Ideal.Quotient.mk I_R (MvPolynomial.X j))) p = 0 := by
      intro c p hp
      rw [Ideal.mem_span_singleton] at hp
      rcases hp with ⟨q, rfl⟩
      have hcond : c.inl.hom (φ a) = c.inr.hom (Ideal.Quotient.mk I_R (MvPolynomial.C a)) :=
        RingHom.congr_fun (congrArg CommRingCat.Hom.hom c.condition) a
      have hgen : MvPolynomial.eval₂Hom c.inl.hom
          (fun j => c.inr.hom (Ideal.Quotient.mk I_R (MvPolynomial.X j)))
          (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C (φ a)) = 0 := by
